// SPDX-License-Identifier: GPL-2.0-only
// tools/pdf/pdfpng.fi -- HOST driver: page N of a PDF through the SAME code the
// viewer uses (lib/pdfread/pdfpage.fi), as raw 0xFFRRGGBB pixels.
//
//     /tmp/pdfpng file.pdf page-number scale-percent out.raw font.ttf
//
// Prints `WxH`.
import std.rt
import font.metrics
import pdfread.pdfread
import pdfread.pdfpage

fn num_arg(start: u64, i: usize) -> u64 {
    var v: u64 = 0
    let ap: u64 = rt.arg_ptr(start, i)
    var k: usize = 0
    while rt.ld8(ap, k) != (0 as u8) {
        v = v * 10 + ((rt.ld8(ap, k) - 48) as u64)
        k = k + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 6 {
        return 64
    }
    var b: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &b) {
        return 2
    }
    var fb: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 5), &fb) {
        return 3
    }
    var fs: metrics.FontSet = metrics.fontset_new()
    if !metrics.fontset_load(&fs, rt.buf_data(&fb), rt.buf_len(&fb)) {
        return 4
    }
    var d: pdfread.Doc = pdfread.doc_new()
    if !pdfread.doc_open(&d, rt.buf_ptr(&b), rt.buf_len(&b) as u64) {
        return 5
    }
    let pg: u64 = num_arg(start, 2)
    let scale: f64 = (num_arg(start, 3) as f64) / 100.0
    var px: rt.Buf = rt.buf_new()
    var w: u64 = 0
    var h: u64 = 0
    if !pdfpage.render_page(&d, pg - 1, scale, (&fs) as u64, &px, &w, &h) {
        return 6
    }
    rt.write_file(rt.arg_ptr(start, 4), rt.buf_ptr(&px), rt.buf_len(&px))
    var o: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&o, w)
    rt.buf_push(&o, 120 as u8)
    rt.buf_push_dec_u64(&o, h)
    rt.buf_push(&o, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
    return 0
}
