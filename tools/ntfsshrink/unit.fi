// SPDX-License-Identifier: GPL-2.0-only
import std.rt
import disks.bytes
import ntfsshrink.codes
import ntfsshrink.runs
import ntfsshrink.vol
import ntfsshrink.rec
import ntfsshrink.bitmap
import ntfsshrink.checks

static mut img: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut wcount: u64 = 0
static mut out: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }

fn rd(lba: u64, n: u64, dst: u64) -> u64 {
    if (lba + n) * 512 > img.len as u64 {
        return 1
    }
    bytes.copy(dst, img.ptr as u64 + lba * 512, n * 512)
    return 0
}

fn wr(lba: u64, n: u64, src: u64) -> u64 {
    if (lba + n) * 512 > img.len as u64 {
        return 1
    }
    wcount = wcount + n
    bytes.copy(img.ptr as u64 + lba * 512, src, n * 512)
    return 0
}

fn put(s: str) {
    rt.buf_push_bytes(&out, s.p as u64, s.n)
}

fn kv(k: str, v: u64) {
    put(k)
    put("=")
    rt.buf_push_dec_u64(&out, v)
    put("\n")
}

fn parse_dec(p: u64) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while rt.ld8(p, i) != 0 as u8 {
        v = v * 10 + ((rt.ld8(p, i) as u64) - 48)
        i = i + 1
    }
    return v
}

fn flush() {
    rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
}

fn same(a: u64, b: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if bytes.ld8(a, i) != bytes.ld8(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2 as i32
    }
    if !rt.read_file(rt.arg_ptr(start, 1), &img) {
        return 3 as i32
    }
    let mode: u64 = rt.arg_ptr(start, 2)
    var boot: [u8; 1024] = [0 as u8; 1024]
    var v: vol.Vol = vol.vol_new()
    let total: u64 = img.len as u64 / 512
    let code: u64 = vol.open(&v, rd, wr, 0, total, (&boot[0]) as u64)
    kv("open", code)
    if code != codes.E_OK {
        flush()
        return 0 as i32
    }
    if rt.ld8(mode, 0) == 99 as u8 {
        var work: [u8; 28672] = [0 as u8; 28672]
        let skip: u64 = if rt.arg_count(start) >= 4 { parse_dec(rt.arg_ptr(start, 3)) } else { 0 }
        kv("check", checks.check_all(&v, skip, (&work[0]) as u64))
        flush()
        return 0 as i32
    }
    kv("bps", v.bps)
    kv("spc", v.spc)
    kv("cb", v.cb)
    kv("sectors", v.sectors)
    kv("clusters", v.clusters)
    kv("mft_lcn", v.mft_lcn)
    kv("mirr_lcn", v.mirr_lcn)
    kv("rec_size", v.rec_size)
    kv("idx_size", v.idx_size)
    kv("serial", v.serial)
    var raw: [u8; 4096] = [0 as u8; 4096]
    var rc: [u8; 4096] = [0 as u8; 4096]
    var tmp: [u8; 4096] = [0 as u8; 4096]
    var rw2: [u8; 4096] = [0 as u8; 4096]
    var rc2: [u8; 4096] = [0 as u8; 4096]
    let raw_p: u64 = (&raw[0]) as u64
    let rc_p: u64 = (&rc[0]) as u64
    let tmp_p: u64 = (&tmp[0]) as u64
    let ml: u64 = rec.mft_load(&v, raw_p, rc_p)
    kv("mft_load", ml)
    if ml != codes.E_OK {
        flush()
        return 0 as i32
    }
    kv("mft_size", v.mft_size)
    kv("mft_runs_len", v.mrun_len)
    var n: u64 = 0
    while n < 16 {
        let r: u64 = rec.mft_read(&v, n, raw_p, rc_p)
        put("rec ")
        rt.buf_push_dec_u64(&out, n)
        put(" code=")
        rt.buf_push_dec_u64(&out, r)
        if r == codes.E_OK {
            put(" flags=")
            rt.buf_push_dec_u64(&out, bytes.le16(rc_p + 22))
            put(" seq=")
            rt.buf_push_dec_u64(&out, bytes.le16(rc_p + 16))
            let w: u64 = rec.mft_write(&v, n, raw_p, rc_p, tmp_p)
            put(" rewrite=")
            rt.buf_push_dec_u64(&out, w)
            let r2: u64 = rec.mft_read(&v, n, (&rw2[0]) as u64, (&rc2[0]) as u64)
            put(" reread=")
            rt.buf_push_dec_u64(&out, r2)
            put(" same=")
            rt.buf_push_dec_u64(&out, if same(rc_p, (&rc2[0]) as u64, v.rec_size) { 1 } else { 0 })
        }
        put("\n")
        n = n + 1
    }
    n = 0
    while n < 4 {
        let a: u64 = rec.rec_read(&v, rec.WHICH_MFT, n, raw_p, rc_p)
        let b: u64 = rec.rec_read(&v, rec.WHICH_MIRROR, n, (&rw2[0]) as u64, (&rc2[0]) as u64)
        put("mirror ")
        rt.buf_push_dec_u64(&out, n)
        put(" codes=")
        rt.buf_push_dec_u64(&out, a + b)
        put(" eq=")
        rt.buf_push_dec_u64(&out, if same(raw_p, (&rw2[0]) as u64, v.rec_size) { 1 } else { 0 })
        put("\n")
        n = n + 1
    }
    let r6: u64 = rec.mft_read(&v, 6, raw_p, rc_p)
    kv("rec6", r6)
    let da: u64 = rec.attr_find(rc_p, v.rec_size, rec.AT_DATA, 0)
    var re: u64 = 0
    let rp: u64 = rec.attr_runs(da, &re)
    kv("bm_runs", if rp != 0 { 1 } else { 0 })
    kv("bm_real", bytes.le64(da + 48))
    kv("bm_alloc", bytes.le64(da + 40))
    var big: [u8; 8192] = [0 as u8; 8192]
    var used: u64 = 0
    kv("bm_last_code", bitmap.last_used(&v, rp, re, v.clusters, (&big[0]) as u64, &used))
    kv("used_end", used)
    var bit: u64 = 0
    kv("bit0_code", bitmap.get_bit(&v, rp, re, 0, (&big[0]) as u64, &bit))
    kv("bit0", bit)
    kv("bytes_for_c", bitmap.bitmap_bytes(v.clusters))
    let bad: u64 = rec.mft_read(&v, 8, raw_p, rc_p)
    kv("rec8", bad)
    let ba: u64 = rec.attr_find(rc_p, v.rec_size, rec.AT_DATA, 4)
    var bre: u64 = 0
    let brp: u64 = rec.attr_runs(ba, &bre)
    var it: runs.RunIt = runs.it_new()
    runs.it_init(&it, brp, bre)
    let first: bool = runs.next(&it)
    kv("bad_first", if first { 1 } else { 0 })
    kv("bad_sparse", it.sparse)
    kv("bad_len", it.len)
    kv("bad_total", runs.total_clusters(brp, bre))
    if rt.arg_count(start) >= 5 && rt.ld8(mode, 0) == 112 as u8 {
        let newc: u64 = parse_dec(rt.arg_ptr(start, 3))
        kv("rec6_again", rec.mft_read(&v, 6, raw_p, rc_p))
        let da2: u64 = rec.attr_find(rc_p, v.rec_size, rec.AT_DATA, 0)
        let rp: u64 = rec.attr_runs(da2, &re)
        kv("pad_code", bitmap.set_padding(&v, rp, re, newc, (&big[0]) as u64))
        kv("pad_bytes", bitmap.bitmap_bytes(newc))
        rt.write_file(rt.arg_ptr(start, 4), img.ptr as u64, img.len)
    }
    if rt.ld8(mode, 0) == 116 as u8 {
        var w3: [u8; 4096] = [0 as u8; 4096]
        var c3: [u8; 4096] = [0 as u8; 4096]
        var w3m: [u8; 4096] = [0 as u8; 4096]
        var c3m: [u8; 4096] = [0 as u8; 4096]
        kv("t_read", rec.mft_read(&v, 3, (&w3[0]) as u64, (&c3[0]) as u64))
        kv("t_readm", rec.rec_read(&v, rec.WHICH_MIRROR, 3, (&w3m[0]) as u64, (&c3m[0]) as u64))
        let va: u64 = rec.attr_find((&c3[0]) as u64, v.rec_size, rec.AT_VOLINFO, 0)
        let vm: u64 = rec.attr_find((&c3m[0]) as u64, v.rec_size, rec.AT_VOLINFO, 0)
        let fl: u64 = va + bytes.le16(va + 20) + 10
        let flm: u64 = vm + bytes.le16(vm + 20) + 10
        bytes.put16(fl, bytes.le16(fl) | 1)
        bytes.put16(flm, bytes.le16(flm) | 1)
        wcount = 0
        kv("t_write", rec.mft_write(&v, 3, (&w3[0]) as u64, (&c3[0]) as u64, tmp_p))
        kv("t_writem", rec.rec_write(&v, rec.WHICH_MIRROR, 3, (&w3m[0]) as u64, (&c3m[0]) as u64, tmp_p))
        kv("t_sectors_written", wcount)
        rt.write_file(rt.arg_ptr(start, 3), img.ptr as u64, img.len)
    }
    flush()
    return 0 as i32
}
