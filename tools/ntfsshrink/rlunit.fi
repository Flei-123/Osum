import std.rt
import ntfsshrink.runs

static mut out: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }

fn put(s: str) {
    rt.buf_push_bytes(&out, s.p as u64, s.n)
}

fn num(v: u64) {
    rt.buf_push_dec_u64(&out, v)
}

fn hexval(c: u64) -> u64 {
    if c >= 97 {
        return c - 87
    }
    return c - 48
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2 as i32
    }
    let h: u64 = rt.arg_ptr(start, 1)
    let n: u64 = rt.c_length(h) as u64 / 2
    var data: [u8; 512] = [0 as u8; 512]
    var i: u64 = 0
    while i < n && i < 512 {
        data[i as usize] = ((hexval(rt.ld8(h, (i * 2) as usize) as u64) << 4) | hexval(rt.ld8(h, (i * 2 + 1) as usize) as u64)) as u8
        i = i + 1
    }
    let p: u64 = (&data[0]) as u64
    var it: runs.RunIt = runs.it_new()
    runs.it_init(&it, p, p + n)
    while runs.next(&it) {
        num(it.vcn)
        put(" ")
        num(it.lcn)
        put(" ")
        num(it.len)
        put(" ")
        num(it.sparse)
        put("\n")
    }
    put("bad=")
    num(it.bad)
    put(" total=")
    num(runs.total_clusters(p, p + n))
    put("\n")
    rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
    return 0 as i32
}
