+// DEBUG blkwlog: who writes the disk? (tools/portio/blkwlog.patch)
+fn dbg_w(state: u64, lba: u64) {
+    var s_a: [u8; 9] = "blkw: p=\0"
+    var s_b: [u8; 6] = " lba=\0"
+    var s_c: [u8; 7] = " ent=\0\0"
+    let t: u64 = sched.current(state)
+    serial.puts((&s_a[0]) as u64)
+    serial.dec(sched.tget(state, t, sched.T_PID))
+    serial.puts((&s_b[0]) as u64)
+    serial.dec(lba)
+    serial.puts((&s_c[0]) as u64)
+    serial.puts(state + kstate.EXE_OFF + t * kstate.EXE_SLOT)
+    serial.nl()
+}
+
 fn write_on(state: u64, dev: u64, lba: u64, src: u64) -> bool {
+    dbg_w(state, lba)
