// tools/tray/kcheck.fi -- compile check: fui.tray must build in `profile kernel` (no std.rt, no heap).
// Built by tools/tray/run.sh with `firnc --profile=kernel -c`; never linked, never run.
profile kernel

import fui.tray

export { probe }

static mut t_probe: [u8; 6] = "probe\0"
static mut t_open: [u8; 5] = "Open\0"
static mut kt: tray.Tray = tray.Tray { blk: 0 }

fn probe() -> u64 {
    kt = tray.tray_new()
    let id: u64 = tray.tray_register(&kt, (&t_probe[0 as usize]) as u64, 1, (&t_probe[0 as usize]) as u64, true)
    tray.tray_menu_add(&kt, id, (&t_open[0 as usize]) as u64, tray.ACT_OPEN, 0)
    tray.tray_move(&kt, id, tray.PLACE_OVERFLOW, 0)
    var ev: tray.TrayEvent = tray.TrayEvent { kind: 0, a: 0, b: 0 }
    tray.tray_click(&kt, id, tray.BTN_LEFT)
    tray.tray_event_pop(&kt, &ev)
    return tray.tray_gen(&kt) + (tray.tray_count(&kt, tray.PLACE_BAR) as u64)
}
