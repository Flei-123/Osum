import std.rt
import std.io
import fui.trayline

struct T {
    fails: i32,
    checks: i32,
}

static mut sample: [u8; 51] = "xremote|11|Viewer on|/bin/xremote||/bin/x off|A|B\n\0"

fn check(t: *mut T, ok: bool, what: str) {
    (*t).checks = (*t).checks + 1
    if ok {
        io.fmt_print(f"ok   {what}\n")
    } else {
        io.fmt_print(f"FAIL {what}\n")
        (*t).fails = (*t).fails + 1
    }
}

fn main() -> i32 {
    var t: T = T { fails: 0, checks: 0 }
    let b: u64 = (&sample[0 as usize]) as u64
    let e: u64 = trayline.line_end(b, 50, 0)
    var out: [u8; 32] = [0 as u8; 32]
    let o: u64 = (&out[0 as usize]) as u64
    check(&t, e == 49, "line ends at newline")
    trayline.field_copy(b, 0, e, trayline.F_OWNER, o, 31)
    check(&t, trayline.text_len(o) == 7, "owner length 7")
    check(&t, trayline.field_num(b, 0, e, trayline.F_ICON) == 11, "icon number 11")
    check(&t, trayline.field_len(b, 0, e, trayline.F_TIP) == 9, "tip length 9")
    check(&t, trayline.field_is_empty(b, 0, e, trayline.F_SETTINGS), "empty settings field")
    trayline.field_copy(b, 0, e, trayline.F_QUIT, o, 31)
    check(&t, trayline.text_len(o) == 10, "quit command length 10")
    check(&t, trayline.field_is_empty(b, 0, e, trayline.F_C2_LABEL), "missing field is empty")
    io.fmt_print(f"checks={t.checks} fails={t.fails}\n")
    return t.fails
}
