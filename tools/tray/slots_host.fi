// SPDX-License-Identifier: GPL-2.0-only
import std.rt
import std.io
import fui.trayslots

struct T {
    fails: i32,
    checks: i32,
}

fn check(t: *mut T, ok: bool, what: str) {
    (*t).checks = (*t).checks + 1
    if ok {
        io.fmt_print(f"ok   {what}\n")
    } else {
        io.fmt_print(f"FAIL {what}\n")
        (*t).fails = (*t).fails + 1
    }
}

fn main() -> i32 {
    var t: T = T { fails: 0, checks: 0 }
    trayslots.slots_reset()
    check(&t, trayslots.order_code() == 3214, "default order 3214")
    check(&t, trayslots.hidden_mask() == 0, "default nothing hidden")
    check(&t, trayslots.bar_count() == 4 && trayslots.over_count() == 0, "default 4 in bar, 0 in overflow")
    check(&t, trayslots.slot_move(trayslots.SLOT_NET, true, 0), "move net to overflow")
    check(&t, trayslots.slot_is_hidden(trayslots.SLOT_NET), "net hidden")
    check(&t, trayslots.bar_count() == 3 && trayslots.over_count() == 1, "3 bar 1 overflow")
    check(&t, trayslots.over_slot_at(0) == trayslots.SLOT_NET, "overflow first is net")
    check(&t, trayslots.bar_slot_at(0) == trayslots.SLOT_BAT, "bar first is battery")
    check(&t, trayslots.slot_move(trayslots.SLOT_MIC, true, 0), "move mic to overflow front")
    check(&t, trayslots.over_slot_at(0) == trayslots.SLOT_MIC && trayslots.over_slot_at(1) == trayslots.SLOT_NET, "overflow order mic, net")
    check(&t, trayslots.slot_move(trayslots.SLOT_NET, true, 0), "reorder inside overflow")
    check(&t, trayslots.over_slot_at(0) == trayslots.SLOT_NET && trayslots.over_slot_at(1) == trayslots.SLOT_MIC, "overflow order net, mic")
    check(&t, !trayslots.slot_move(trayslots.SLOT_NET, true, 0), "same move is no change")
    check(&t, trayslots.slot_move(trayslots.SLOT_MIC, false, 1), "mic back to bar at index 1")
    check(&t, !trayslots.slot_is_hidden(trayslots.SLOT_MIC), "mic visible")
    check(&t, trayslots.bar_slot_at(0) == trayslots.SLOT_BAT && trayslots.bar_slot_at(1) == trayslots.SLOT_MIC && trayslots.bar_slot_at(2) == trayslots.SLOT_SND, "bar order bat, mic, snd")
    check(&t, trayslots.slot_bar_index(trayslots.SLOT_SND) == 2, "bar index of snd is 2")
    check(&t, trayslots.slot_move(trayslots.SLOT_NET, false, 99), "net back to bar at end (clamped)")
    check(&t, trayslots.bar_slot_at(3) == trayslots.SLOT_NET && trayslots.over_count() == 0, "net last in bar")
    let code: u64 = trayslots.order_code()
    let mask: u64 = trayslots.hidden_mask()
    trayslots.slot_move(trayslots.SLOT_SND, true, 0)
    trayslots.slots_load(code, mask)
    check(&t, trayslots.order_code() == code && trayslots.hidden_mask() == mask, "load restores saved state")
    trayslots.slots_load(1122, 0)
    check(&t, trayslots.order_code() == 3214, "duplicate digits rejected, default order")
    trayslots.slots_load(1230, 0)
    check(&t, trayslots.order_code() == 3214, "digit 0 rejected")
    trayslots.slots_load(4321, 6)
    check(&t, trayslots.order_code() == 4321 && trayslots.slot_is_hidden(trayslots.SLOT_NET) && trayslots.slot_is_hidden(trayslots.SLOT_SND), "load code and mask")
    check(&t, !trayslots.slot_move(9, true, 0), "unknown slot rejected")
    io.fmt_print(f"checks={t.checks} fails={t.fails}\n")
    return t.fails
}
