// SPDX-License-Identifier: GPL-2.0-only
static mut G_CALLS: u64 = 0
static mut G_TABLE: [u64; 4] = [0, 0, 0, 0]

#[export_c]
#[no_gc]
fn vkEnumerateInstanceVersion(out: *mut u32) -> i32 {
    G_CALLS = G_CALLS + 1
    *out = 0x00402000
    return 0
}

#[export_c]
#[no_gc]
fn vkEnumerateInstanceExtensionProperties(layer: u64, count: *mut u32, props: u64) -> i32 {
    G_CALLS = G_CALLS + 1
    *count = 0
    return 0
}

#[export_c]
#[no_gc]
fn vkCreateInstance(info: u64, alloc: u64, out: *mut u64) -> i32 {
    G_CALLS = G_CALLS + 1
    G_TABLE[0] = 0xC0DE0001
    *out = 0xC0DE0001
    return 0
}

#[export_c]
#[no_gc]
fn vkDestroyInstance(inst: u64, alloc: u64) {
    G_CALLS = G_CALLS + 1
    G_TABLE[0] = 0
}

#[export_c]
#[no_gc]
fn vkEnumeratePhysicalDevices(inst: u64, count: *mut u32, devs: *mut u64) -> i32 {
    G_CALLS = G_CALLS + 1
    if inst != G_TABLE[0] {
        return -3
    }
    if devs != 0 as *mut u64 {
        *devs = 0xD0D00001
    }
    *count = 1
    return 0
}

#[export_c]
#[no_gc]
fn vkGetPhysicalDeviceQueueFamilyPropertyCount(dev: u64, count: *mut u32) {
    G_CALLS = G_CALLS + 1
    *count = 1
}

#[export_c]
#[no_gc]
fn vk_icdNegotiateLoaderICDInterfaceVersion(version: *mut u32) -> i32 {
    G_CALLS = G_CALLS + 1
    if *version > 5 {
        *version = 5
    }
    return 0
}

#[export_c]
#[no_gc]
fn vk_icdGetInstanceProcAddr(inst: u64, name: u64) -> u64 {
    G_CALLS = G_CALLS + 1
    return 0
}

#[export_c]
#[no_gc]
fn icd_calls() -> u64 {
    return G_CALLS
}

#[export_c]
#[no_gc]
fn icd_add(a: u64, b: u64) -> u64 {
    G_CALLS = G_CALLS + 1
    return a + b
}
