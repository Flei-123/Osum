import std.rt
import fui.core
import ecke

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2 as i32
    }
    var out: rt.Buf = rt.buf_new()
    var r: usize = 1
    while r <= 24 {
        var iy: usize = 0
        while iy < r {
            var ix: usize = 0
            while ix < r {
                let a: usize = core.corner_coverage(ix, iy, r, r, r)
                let b: u64 = ecke.corner_cov((r - 1 - ix) as u64, (r - 1 - iy) as u64, r as u64)
                rt.buf_push_dec_u64(&out, r as u64)
                rt.buf_push(&out, 32 as u8)
                rt.buf_push_dec_u64(&out, ix as u64)
                rt.buf_push(&out, 32 as u8)
                rt.buf_push_dec_u64(&out, iy as u64)
                rt.buf_push(&out, 32 as u8)
                rt.buf_push_dec_u64(&out, a as u64)
                rt.buf_push(&out, 32 as u8)
                rt.buf_push_dec_u64(&out, b)
                rt.buf_push(&out, 10 as u8)
                ix = ix + 1
            }
            iy = iy + 1
        }
        r = r + 1
    }
    if !rt.write_file(rt.arg_ptr(start, 1), out.ptr, out.len) {
        return 3 as i32
    }
    return 0 as i32
}
