import std.rt
import std.io
import ntp.packet
import ntp.select
import ntp.policy

fn at8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn skip_space(p: u64, n: usize, at: *mut usize) {
    var a: usize = *at
    while a < n && at8(p, a) == 32 as u8 {
        a = a + 1
    }
    *at = a
}

fn num(p: u64, n: usize, at: *mut usize) -> i64 {
    skip_space(p, n, at)
    var a: usize = *at
    var neg: bool = false
    if a < n && at8(p, a) == 45 as u8 {
        neg = true
        a = a + 1
    }
    var v: i64 = 0
    while a < n && at8(p, a) >= 48 as u8 && at8(p, a) <= 57 as u8 {
        v = v * 10 + ((at8(p, a) as i64) - 48)
        a = a + 1
    }
    *at = a
    if neg {
        return 0 - v
    }
    return v
}

fn nibble(c: u8) -> u64 {
    if c >= 97 as u8 {
        return (c as u64) - 87
    }
    return (c as u64) - 48
}

fn hex_into(p: u64, n: usize, at: *mut usize, dst: u64, max: usize) -> usize {
    skip_space(p, n, at)
    var a: usize = *at
    var k: usize = 0
    while a + 1 < n && k < max && at8(p, a) != 32 as u8 && at8(p, a) != 10 as u8 {
        let b: u64 = nibble(at8(p, a)) * 16 + nibble(at8(p, a + 1))
        *((dst + k as u64) as *mut u8) = b as u8
        k = k + 1
        a = a + 2
    }
    *at = a
    return k
}

fn put_i(out: *mut rt.Buf, v: i64) {
    rt.buf_push_dec_i64(out, v)
    rt.buf_push(out, 32 as u8)
}

fn put_u(out: *mut rt.Buf, v: u64) {
    rt.buf_push_dec_u64(out, v)
    rt.buf_push(out, 32 as u8)
}

fn cmd_parse(p: u64, n: usize, at: *mut usize, out: *mut rt.Buf) {
    let pivot: u64 = num(p, n, at) as u64
    var pkt: [u8; 128] = [0 as u8; 128]
    var nonce: [u8; 8] = [0 as u8; 8]
    let len: usize = hex_into(p, n, at, (&pkt[0 as usize]) as u64, 128)
    let _k: usize = hex_into(p, n, at, (&nonce[0 as usize]) as u64, 8)
    var r: packet.Reply = packet.reply_new()
    let st: u32 = packet.parse_reply((&pkt[0 as usize]) as u64, len,
        (&nonce[0 as usize]) as u64, pivot, &r)
    put_u(out, st as u64)
    put_u(out, r.stratum as u64)
    put_u(out, r.leap as u64)
    put_u(out, r.root_distance_ns)
    put_u(out, r.receive_ns)
    put_u(out, r.transmit_ns)
}

fn cmd_offset(p: u64, n: usize, at: *mut usize, out: *mut rt.Buf) {
    let t1: u64 = num(p, n, at) as u64
    let t2: u64 = num(p, n, at) as u64
    let t3: u64 = num(p, n, at) as u64
    let t4: u64 = num(p, n, at) as u64
    put_i(out, packet.offset_ns(t1, t2, t3, t4))
    put_i(out, packet.delay_ns(t1, t2, t3, t4))
}

fn cmd_select(p: u64, n: usize, at: *mut usize, out: *mut rt.Buf) {
    let min_agree: usize = num(p, n, at) as usize
    let tol: i64 = num(p, n, at)
    let cnt: usize = num(p, n, at) as usize
    var s: [select.Sample; 8] = [select.sample_new(); 8]
    var i: usize = 0
    while i < cnt && i < 8 {
        s[i].offset_ns = num(p, n, at)
        s[i].delay_ns = num(p, n, at)
        i = i + 1
    }
    var sel: select.Selection = select.selection_new()
    let st: u32 = select.select(&s, cnt, min_agree, tol, &sel)
    put_u(out, st as u64)
    put_i(out, sel.offset_ns)
    put_i(out, sel.delay_ns)
    put_u(out, sel.agreeing as u64)
    put_i(out, sel.spread_ns)
}

fn main() -> i32 {
    var inp: rt.Buf = rt.buf_new()
    let _r: bool = io.read_stdin(&inp)
    var out: rt.Buf = rt.buf_new()
    let p: u64 = inp.ptr
    let n: usize = inp.len
    var at: usize = 0
    while at < n {
        let c: u8 = at8(p, at)
        at = at + 1
        if c == 112 as u8 {
            cmd_parse(p, n, &at, &out)
        } else if c == 111 as u8 {
            cmd_offset(p, n, &at, &out)
        } else if c == 115 as u8 {
            cmd_select(p, n, &at, &out)
        } else if c == 100 as u8 {
            let off: i64 = num(p, n, &at)
            let synced: i64 = num(p, n, &at)
            put_u(&out, policy.decide(off, synced != 0) as u64)
        } else if c == 114 as u8 {
            put_u(&out, policy.retry_delay_s(num(p, n, &at) as u64))
        } else if c == 107 as u8 {
            put_u(&out, policy.kod_delay_s(num(p, n, &at) as u64))
        } else if c == 117 as u8 {
            let secs: u64 = num(p, n, &at) as u64
            let pivot: u64 = num(p, n, &at) as u64
            put_u(&out, packet.unix_secs_of(secs, pivot))
        }
        while at < n && at8(p, at) != 10 as u8 {
            at = at + 1
        }
        at = at + 1
        rt.buf_push(&out, 10 as u8)
    }
    io.print_bytes(out.ptr, out.len)
    return 0
}
