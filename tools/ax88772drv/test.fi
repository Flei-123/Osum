// SPDX-License-Identifier: GPL-2.0-only
// tools/ax88772drv/test.fi -- fake AX88772 on the host: control requests, device state rules, bulk framing both ways
import std.rt
import std.io
import usbnet.ax88772
import usbnet.ax88772_drv

static mut bulk: [u8; 8192] = [0; 8192]
static mut cbuf: [u8; 64] = [0; 64]
static mut rst_stage: u64 = 0
static mut rxctl: u64 = 0
static mut medium: u64 = 0

fn mac_byte(i: u64) -> u64 { return 0x02 + i * 0x11 }

fn rst_value(v: u64) {
    if v == 0x48 { rst_stage = 1 }
    else if v == 0x00 && rst_stage == 1 { rst_stage = 2 }
    else if v == 0x20 && rst_stage == 2 { rst_stage = 3 }
    else { rst_stage = 0 }
}

fn fake_ctl(state: u64, slot: u64, bm: u64, req: u64, value: u64, index: u64, len: u64, buf: u64) -> i64 {
    io.fmt_print(f"ax: ctl {bm} {req} {value} {index} {len}\n")
    if bm == 0x40 && req == 0x22 { return 0 }
    if bm == 0x40 && req == 0x20 { rst_value(value); return 0 }
    if bm == 0x40 && req == 0x10 { rxctl = value; return 0 }
    if bm == 0x40 && req == 0x1B { medium = value; return 0 }
    if bm == 0xC0 && req == 0x13 && len == 6 {
        var i: u64 = 0
        while i < 6 {
            var v: u64 = 0
            if rst_stage == 3 { v = mac_byte(i) }
            *((buf + i) as *mut u8) = v as u8
            i = i + 1
        }
        return 6
    }
    return 0 - 1
}

fn fake_delay(state: u64, us: u64) {
    io.fmt_print(f"ax: pause {us}\n")
}

fn fill(p: u64, n: usize) {
    var i: usize = 0
    while i < n { *((p + (i as u64)) as *mut u8) = ((i * 7 + 3) & 255) as u8; i = i + 1 }
}

fn sum_of(p: u64, n: usize) -> u64 {
    var s: u64 = 0
    var i: usize = 0
    while i < n {
        let b: u8 = *((p + (i as u64)) as *mut u8)
        s = (s + (b as u64) * ((i as u64) + 1)) & 65535
        i = i + 1
    }
    return s
}

fn put(o: usize, v: u64) { bulk[o] = (v & 255) as u8 }

// device side framing written independently of lib/usbnet/ax88772.fi
fn dev_send(pos: usize, n: usize) -> usize {
    let h: u64 = (n as u64) | (((0x7FF - (n as u64)) & 0x7FF) << 16)
    put(pos, h)
    put(pos + 1, h >> 8)
    put(pos + 2, h >> 16)
    put(pos + 3, h >> 24)
    let fb: u64 = (&bulk[0]) as u64 + ((pos + 4) as u64)
    fill(fb, n)
    var q: usize = pos + 4 + n
    if (n & 1) == 1 { put(q, 0); q = q + 1 }
    return q
}

fn rx_enabled() -> bool { return (rxctl & 0x80) != 0 && (medium & 0x100) != 0 }

fn scenario_rx() {
    if !rx_enabled() {
        io.print_line("ax: rx disabled")
        return
    }
    var pos: usize = 0
    pos = dev_send(pos, 60)
    pos = dev_send(pos, 100)
    pos = dev_send(pos, 1514)
    pos = dev_send(pos, 61)
    let base: u64 = (&bulk[0]) as u64
    var at: usize = 0
    var count: u64 = 0
    while at != 0 || count == 0 {
        let l: usize = ax88772.rx_frame_len(base, pos, at)
        if l == 0 { io.print_line("ax: rx stop"); return }
        let s: u64 = sum_of(base + (ax88772.rx_frame_off(at) as u64), l)
        io.fmt_print(f"ax: rx {l} {s}\n")
        count = count + 1
        at = ax88772.rx_next(base, pos, at)
        if at >= pos { at = 0 }
    }
    io.fmt_print(f"ax: rx frames {count}\n")
}

fn scenario_tx_one(n: usize, fr: u64) {
    fill(fr, n)
    let t: usize = ax88772.tx_wrap(fr, n, (&bulk[0]) as u64)
    var ok: bool = t >= 4 + n
    let h: u64 = (bulk[0] as u64) | ((bulk[1] as u64) << 8) | ((bulk[2] as u64) << 16) | ((bulk[3] as u64) << 24)
    if (h & 0xFFFF) != (n as u64) || ((h >> 16) & 0xFFFF) != ((0x7FF - (n as u64)) & 0x7FF) { ok = false }
    var pad: u64 = 0
    if t > 4 + n {
        pad = (bulk[4 + n] as u64) | ((bulk[5 + n] as u64) << 8) | ((bulk[6 + n] as u64) << 16) | ((bulk[7 + n] as u64) << 24)
    }
    let s: u64 = sum_of((&bulk[0]) as u64 + 4, n)
    var okv: u64 = 0
    if ok { okv = 1 }
    io.fmt_print(f"ax: tx {n} total {t} pad {pad} sum {s} ok {okv}\n")
}

fn main() -> i32 {
    var step: u64 = 0
    let mac: u64 = ax88772_drv.bringup(0 as u64, 7 as u64, fake_ctl, fake_delay, (&cbuf[0]) as u64, &step)
    io.fmt_print(f"ax: step {step} mac {mac & 255} {(mac >> 8) & 255} {(mac >> 16) & 255} {(mac >> 24) & 255} {(mac >> 32) & 255} {(mac >> 40) & 255}\n")
    io.fmt_print(f"ax: rxctl {rxctl} medium {medium}\n")
    scenario_rx()
    let fr: u64 = rt.heap_alloc(2048)
    scenario_tx_one(60, fr)
    scenario_tx_one(508, fr)
    scenario_tx_one(1514, fr)
    scenario_tx_one(1020, fr)
    return 0
}
