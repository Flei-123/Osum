// SPDX-License-Identifier: GPL-2.0-only
// src/main.fi -- {{NAME}} ({{ID}}), a bus service built on rpc.fi.
// Verbs: "ping" -> "pong", "echo <text>" -> <text>; anything else is
// answered with rpc.E_NOMETHOD. Clients: rpc.call / rpc.call_async.
// Build: python3 tools/sdk/osdk.py build <project> --out <dir>
profile kernel

import ulib
import actwire
import rpc

export { u_start }

fn serve(limit: u64) -> u64 {
    {{LIT:svc:{{SHORT}}}}
    {{LIT:v_ping:ping}}
    {{LIT:v_echo:echo }}
    {{LIT:r_pong:pong}}
    if !rpc.serve_open((&svc[0 as usize]) as u64, actwire.A_ANY) {
        return 1
    }
    let t1: u64 = actwire.ticks()
    while limit == 0 || actwire.ticks() - t1 < limit {
        let s: u64 = rpc.serve_next(100)
        if s != actwire.NONE {
            let b: u64 = rpc.req_buf(s)
            if rpc.req_over(s) {
                rpc.fail(s, rpc.E_TOOBIG, 0, 0)
            } else if actwire.str_eq(b, (&v_ping[0 as usize]) as u64) {
                rpc.reply(s, (&r_pong[0 as usize]) as u64, 4)
            } else if actwire.starts(b, (&v_echo[0 as usize]) as u64) {
                rpc.reply(s, b + 5, rpc.req_len(s) - 5)
            } else {
                rpc.fail(s, rpc.E_NOMETHOD, 0, 0)
            }
        }
    }
    return 0
}

fn u_start(args: u64) -> u64 {
    var lim: u64 = 0
    if ulib.arg_count(args) >= 2 {
        lim = ulib.to_num(ulib.arg_at(args, 1)) // ticks, 0 = until killed
    }
    return serve(lim)
}
