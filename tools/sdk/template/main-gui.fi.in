// SPDX-License-Identifier: GPL-2.0-only
// src/main.fi -- {{NAME}} ({{ID}}), a window on fUi's scene tree.
// Build: python3 tools/sdk/osdk.py build <project> --out <dir>
// Host loop (no VM): bash tools/preview/watch.sh <prog> --dump <a11y.tree dump>
// (docs/HOST-PREVIEW.md). Keys of nodes are numbers you choose: pump() returns the
// key of the node that was pressed.
profile app

import ulib
import wlib
import fuiapp
import fuiscene

export { u_start }

const K_COUNT: u64 = 1
const K_NAME: u64 = 2

{{SLIT:t_title:{{NAME}}}}
{{SLIT:t_head:Press the button:}}
{{SLIT:t_btn:Count!}}
{{SLIT:t_init:Hello}}
static mut t_cnt: [u8; 16] = "Count: 0\0\0\0\0\0\0\0\0"
static mut n: u64 = 0

// The tree is built once per refresh: label, text field, main button, label.
fn build() {
    let col: usize = fuiscene.root()
    let _h: usize = fuiscene.label(col, (&t_head[0 as usize]) as u64)
    let _e: usize = fuiscene.entry(col, K_NAME, 300, (&t_init[0 as usize]) as u64)
    let _b: usize = fuiscene.button_main(col, (&t_btn[0 as usize]) as u64, K_COUNT)
    let _c: usize = fuiscene.label(col, (&t_cnt[0 as usize]) as u64)
}

fn u_start(args: u64) -> u64 {
    if !fuiscene.open(80, 80, 320, 200, (&t_title[0 as usize]) as u64, build) {
        return 1
    }
    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        if key == K_COUNT {
            n = n + 1
            t_cnt[7 as usize] = (48 + n % 10) as u8
            fuiscene.refresh()
        }
    }
    return 0
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
