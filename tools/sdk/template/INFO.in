# INFO -- the app manifest v2 of {{NAME}} (docs/manifest-v2.md).
# One file, read by the launcher (name, info, keys, icon, exec, net, menu) and by
# `osdk check` (everything). Keep the launcher keys on top.
name={{NAME}}
info=A new {{PRODUCT}} app
keys={{SHORT}}
revision=1
manifest=2
id={{ID}}
version=0.1.0
author={{AUTHOR}}
license=GPL-2.0-only
kind={{KIND}}
outputs={{OUTPUTS}}
# permissions the app asks for, comma separated (catalogue: osdk.py perms, docs/manifest-v2.md):
#   net, notify, clipboard.read, clipboard.write, files.open, files.save, dialog, storage, fs.home, audio.play
perm={{PERM}}
{{EXTRA}}
