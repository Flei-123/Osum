# INFO -- the app manifest v2 of {{NAME}} (docs/SDK.md).
# One file, read by the launcher (name, info, keys, icon, net) and by
# `osdk check` (everything). Keep the launcher keys on top.
name={{NAME}}
info=A new {{PRODUCT}} app
keys={{SHORT}}
fassung=1
manifest=2
id={{ID}}
version=0.1.0
author=
license=GPL-2.0-only
# permissions the app asks for, comma separated (catalogue: docs/SDK.md):
#   net, notify, clipboard.read, clipboard.write, fs.home, audio.play
perm={{PERM}}
{{EXTRA}}
