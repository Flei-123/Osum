import std.rt
import pngfit.png
import pngfit.fit

fn parse_dec(p: u64) -> usize {
    var v: usize = 0
    var i: usize = 0
    while rt.ld8(p, i) >= 48 as u8 && rt.ld8(p, i) <= 57 as u8 {
        v = v * 10 + ((rt.ld8(p, i) - 48 as u8) as usize)
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 6 {
        return 2 as i32
    }
    let width: usize = parse_dec(rt.arg_ptr(start, 2))
    let height: usize = parse_dec(rt.arg_ptr(start, 3))
    let cap: usize = parse_dec(rt.arg_ptr(start, 4))
    let mode: u64 = rt.arg_ptr(start, 5)
    var raw: rt.Buf = rt.buf_new()
    var state: u64 = 12345
    let smooth: bool = rt.ld8(mode, 0) == 115 as u8
    var y: usize = 0
    while y < height {
        rt.buf_push(&raw, 0 as u8)
        var x: usize = 0
        while x < width * 3 {
            if smooth {
                rt.buf_push(&raw, (((x / 3) * 255 / width + y * 255 / height + x % 3 * 40) & 255) as u8)
            } else {
                state = (state * 1664525 + 1013904223) & 4294967295
                rt.buf_push(&raw, ((state >> 16) & 255) as u8)
            }
            x = x + 1
        }
        y = y + 1
    }
    var out: rt.Buf = rt.buf_new()
    var ok: bool = false
    if rt.ld8(mode, 0) == 112 as u8 || (smooth && rt.ld8(mode, 6) == 0 as u8) {
        ok = png.encode(&out, width, height, &raw)
    } else {
        ok = fit.encode_within(&out, width, height, &raw, cap)
    }
    if !ok {
        return 1 as i32
    }
    if !rt.write_file(rt.arg_ptr(start, 1), out.ptr, out.len) {
        return 3 as i32
    }
    return 0 as i32
}
