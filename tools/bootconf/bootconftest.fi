profile kernel

import ulib
import bootconf

export { u_start }

static mut src_buf: [u8; 24576] = [0 as u8; 24576]
static mut dst_buf: [u8; 28672] = [0 as u8; 28672]

fn u_start(args: u64) -> u64 {
    var s_status: [u8; 8] = "status=\0"
    var s_len: [u8; 6] = " len=\0"
    if ulib.arg_count(args) < 3 {
        return 2
    }
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, ulib.arg_at(args, 1), 0, 0)
    if ulib.bad(fd) {
        return 3
    }
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&src_buf[0 as usize]) as u64, 24000)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    let r: u64 = bootconf.arm((&src_buf[0 as usize]) as u64, n, (&dst_buf[0 as usize]) as u64, 28000)
    ulib.say((&s_status[0 as usize]) as u64)
    ulib.sayu(r)
    ulib.say((&s_len[0 as usize]) as u64)
    ulib.sayu(bootconf.new_len())
    ulib.nl()
    if r == bootconf.R_OK {
        let o: u64 = ulib.sys(ulib.SYS_OPEN, ulib.arg_at(args, 2), ulib.O_MAKE, 0)
        if ulib.bad(o) {
            return 4
        }
        var off: u64 = 0
        let total: u64 = bootconf.new_len()
        while off < total {
            var chunk: u64 = total - off
            if chunk > 2048 {
                chunk = 2048
            }
            let w: u64 = ulib.sys(ulib.SYS_WRITE, o, (&dst_buf[0 as usize]) as u64 + off, chunk)
            if ulib.bad(w) || w == 0 {
                return 5
            }
            off = off + w
        }
        ulib.sys(ulib.SYS_CLOSE, o, 0, 0)
    }
    return 0
}
