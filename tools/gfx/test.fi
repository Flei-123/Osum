// SPDX-License-Identifier: GPL-2.0-only
// tools/gfx/test.fi -- host checks for lib/gpu/swr (fill rule, depth, texture, VM == native, thread determinism)
import std.rt
import std.io
import std.math
import jobs.jobs
import gpu.swr.raster
import gpu.swr.shader
import gpu.swr.scene

static mut passed: i32 = 0
static mut failed: i32 = 0

fn check(name: str, ok: bool) {
    if ok { passed = passed + 1; io.fmt_print(f"OK    {name}\n") }
    else { failed = failed + 1; io.fmt_print(f"FAIL  {name}\n") }
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0 as u64
}

fn main() -> i32 {
    let W: i32 = 320
    let H: i32 = 200
    let f: *mut raster.Frame = raster.frame_new(W, H, 4096)
    let tex: u64 = scene.make_texture(256)
    raster.frame_set_texture(f, tex, 256, 256)
    let prog0: u64 = shader.prog_new()
    shader.prog_tex_times_colour(prog0)
    let prog1: u64 = shader.prog_new()
    shader.prog_lit(prog1)
    var j: jobs.Jobs = jobs.create(3)
    let jp: u64 = (&j) as u64

    // 1. fill rule: two full screen triangles + 300 random fan triangles cover every pixel exactly once (coverage counter)
    (*f).mode = raster.MODE_COUNT
    (*f).depth_test = false
    raster.frame_clear(f, 0 as u32, 1.0f)
    scene.scene_quads(f, 1, true)
    raster.frame_draw(f, 0 as u64)
    var bad: i32 = 0
    var y: i32 = 0
    while y < H {
        var x: i32 = 0
        while x < W {
            if raster.frame_pixel(f, x, y) != 1 as u32 { bad = bad + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check("fill rule: full screen quad covers each pixel exactly once", bad == 0)

    // 1b. shared edge on arbitrary slanted triangles: a fan of 64 triangles around the centre covers the screen once
    raster.frame_clear(f, 0 as u32, 1.0f)
    (*f).ntri = 0
    var k: i32 = 0
    while k < 64 {
        let a0: f32 = (k as f32) * 6.2831853f / 64.0f
        let a1: f32 = ((k + 1) as f32) * 6.2831853f / 64.0f
        // points on a large square-ish ring beyond the screen: clamp the circle radius to 3
        scene.add_tri(f, k as usize, 0.1f, -0.05f, 0.5f, 1.0f, 0.0f, 0.0f,
            3.0f * (math.cos(a0 as f64) as f32), 3.0f * (math.sin(a0 as f64) as f32), 0.5f, 1.0f, 0.0f, 0.0f,
            3.0f * (math.cos(a1 as f64) as f32), 3.0f * (math.sin(a1 as f64) as f32), 0.5f, 1.0f, 0.0f, 0.0f, 1.0f, 1.0f, 1.0f)
        k = k + 1
    }
    raster.frame_draw(f, 0 as u64)
    bad = 0
    y = 0
    while y < H {
        var x: i32 = 0
        while x < W {
            if raster.frame_pixel(f, x, y) != 1 as u32 { bad = bad + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check("fill rule: 64 slanted fan triangles, no gap, no double hit", bad == 0)

    // 2. depth: near quad (z 0.2) hides far quad (z 0.8) in both draw orders, colour = far/near marker
    (*f).depth_test = true
    (*f).mode = raster.MODE_NATIVE0
    raster.frame_clear(f, 0 as u32, 1.0f)
    scene.add_quad(f, 0, -1.0f, -1.0f, 1.0f, 1.0f, 0.8f, 1.0f, 0.0f, 0.0f, 0.0f)
    scene.add_quad(f, 2, -0.5f, -0.5f, 0.5f, 0.5f, 0.2f, 1.0f, 1.0f, 1.0f, 1.0f)
    (*f).ntri = 4
    raster.frame_draw(f, 0 as u64)
    let h_a: u64 = raster.frame_hash(f)
    let centre: u32 = raster.frame_pixel(f, W / 2, H / 2)
    let corner: u32 = raster.frame_pixel(f, 2, 2)
    check("depth: far quad (black) at the corner, near quad (textured) in the middle", (corner & 0xFFFFFF as u32) == 0 as u32 && (centre & 0xFFFFFF as u32) != 0 as u32)
    raster.frame_clear(f, 0 as u32, 1.0f)
    scene.add_quad(f, 0, -0.5f, -0.5f, 0.5f, 0.5f, 0.2f, 1.0f, 1.0f, 1.0f, 1.0f)
    scene.add_quad(f, 2, -1.0f, -1.0f, 1.0f, 1.0f, 0.8f, 1.0f, 0.0f, 0.0f, 0.0f)
    (*f).ntri = 4
    raster.frame_draw(f, 0 as u64)
    check("depth: draw order does not matter (hash equal)", raster.frame_hash(f) == h_a)

    // 3. texture: quad 1:1 maps texel centres (256 px wide, uv 0..1 over 256 px). White vertex colour = the texel itself
    let f2: *mut raster.Frame = raster.frame_new(256, 256, 16)
    raster.frame_set_texture(f2, tex, 256, 256)
    (*f2).mode = raster.MODE_NATIVE0
    raster.frame_clear(f2, 0 as u32, 1.0f)
    scene.add_quad(f2, 0, -1.0f, -1.0f, 1.0f, 1.0f, 0.5f, 1.0f, 1.0f, 1.0f, 1.0f)
    // add_quad: v = 0 at the top of the screen, so pixel (x, y) shows texel (x, y)
    raster.frame_draw(f2, 0 as u64)
    bad = 0
    y = 0
    while y < 256 {
        var x: i32 = 0
        while x < 256 {
            let want: u32 = rt.ld32(tex, (y as usize) * 256 + (x as usize))
            if raster.frame_pixel(f2, x, y) != want { bad = bad + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check("texture: 1:1 quad reproduces the texture bit exactly (65536 texels)", bad == 0)

    // 4. perspective: a quad with w 1 -> 2 across its height still hits every pixel once and the middle row samples v < 0.5
    //    (checked through counting: covered pixels == quad area, see test 1; here only texture continuity)
    // 5. VM == native, both programs, on a random scene
    (*f).depth_test = true
    scene.scene_random(f, 300, 0.6f, 12345 as u64)
    (*f).mode = raster.MODE_NATIVE0
    raster.frame_clear(f, 0xFF000000 as u32, 1.0f)
    raster.frame_draw(f, 0 as u64)
    let hn0: u64 = raster.frame_hash(f)
    (*f).mode = raster.MODE_VM
    raster.frame_set_program(f, prog0)
    raster.frame_clear(f, 0xFF000000 as u32, 1.0f)
    raster.frame_draw(f, 0 as u64)
    check("VM program 0 == native program 0 (bit identical, 300 random triangles)", raster.frame_hash(f) == hn0)
    (*f).mode = raster.MODE_NATIVE1
    raster.frame_clear(f, 0xFF000000 as u32, 1.0f)
    raster.frame_draw(f, 0 as u64)
    let hn1: u64 = raster.frame_hash(f)
    (*f).mode = raster.MODE_VM
    raster.frame_set_program(f, prog1)
    raster.frame_clear(f, 0xFF000000 as u32, 1.0f)
    raster.frame_draw(f, 0 as u64)
    check("VM program 1 == native program 1 (bit identical)", raster.frame_hash(f) == hn1)
    check("program 0 and 1 differ (the test scene really shades)", hn0 != hn1)

    // 6. threads: 1 thread == 4 threads (jobs) bit for bit, and the pixel statistics agree
    (*f).mode = raster.MODE_NATIVE1
    raster.frame_clear(f, 0xFF000000 as u32, 1.0f)
    raster.frame_draw(f, 0 as u64)
    let h1: u64 = raster.frame_hash(f)
    let p1: u64 = raster.frame_stat_pixels(f)
    raster.frame_clear(f, 0xFF000000 as u32, 1.0f)
    raster.frame_draw(f, jp)
    check("4 threads == 1 thread (bit identical)", raster.frame_hash(f) == h1)
    check("shaded pixel statistic equal for 1 and 4 threads", raster.frame_stat_pixels(f) == p1 && p1 > 0 as u64)

    jobs.destroy(&j)
    io.fmt_print(f"gfx: {passed} ok, {failed} fail\n")
    if failed == 0 { return 0 }
    return 1
}
