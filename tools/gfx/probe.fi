// tools/gfx/probe.fi -- lowers one .spv file (arg 1; any arg 2 = vertex stage) and prints the first error (dev tool, not a gate)
import std.rt
import std.io
import jobs.jobs
import spirv.parse
import spirv.validate
import spirv.lower
import spirv.spv

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0 as u64
}

fn main(start: u64) -> i32 {
    let argc: usize = rt.arg_count(start)
    var b: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &b) { io.fmt_print(f"read fail\n"); return 1 }
    var stage: u32 = spv.EM_FRAGMENT
    if argc > 2 { stage = spv.EM_VERTEX }
    var m: parse.Module = parse.module_zero()
    var e: u32 = parse.module_open(&m, rt.buf_ptr(&b), rt.buf_len(&b) / 4)
    var vp: u32 = 0
    if e == 0 { e = validate.validate(&m); vp = 1 }
    var info: lower.LowerInfo = lower.info_zero()
    if e == 0 { e = lower.lower_stage(&m, stage, rt.heap_alloc(65536), 3000, &info); vp = 2 }
    io.fmt_print(f"phase={vp} err={e} {parse.err_name(e)} / {lower.lower_err_name(e)} pos={m.err_pos} lpos={info.err_pos} ninstr={info.ninstr} peak={info.peak_reg}\n")
    if info.err_pos != 0 { io.fmt_print(f"op_at_lpos={parse.op_at(&m, info.err_pos)}\n") }
    if m.err_pos != 0 { io.fmt_print(f"op_at_vpos={parse.op_at(&m, m.err_pos)}\n") }
    return 0
}
