// SPDX-License-Identifier: GPL-2.0-only
// tools/gfx/test_fuiloop.fi -- the REAL fUi fragment shader kinds with loops and tables, unrolled by fuiconv.sh and lowered to the SWR VM: 6 (spot gradient: constant int[16] dither table,
// 4 unrolled iterations), 11-14 (box blur passes, 129 unrolled iterations), 15 (tint); every other loop free kind (2 3 4 8 9 10 16) must lower. Pixel compare with a native model.
// args: gpu.frag.opt.spv of kinds 6 11 12 13 14 15 2 3 4 8 9 10 16 (in this order). Shader y is bottom-up: frame row y is shader row H-1-y.
import std.rt
import std.io
import std.math
import jobs.jobs
import gpu.swr.raster
import gpu.swr.pixel
import spirv.parse
import spirv.validate
import spirv.lower
import spirv.spv

static mut passed: i32 = 0
static mut failed: i32 = 0
static mut prm: [f32; 28] = [0.0f; 28]

const MAXPC: usize = 16000
const W: i32 = 32
const H: i32 = 16

fn check(name: str, ok: bool) {
    if ok { passed = passed + 1; io.fmt_print(f"OK    {name}\n") }
    else { failed = failed + 1; io.fmt_print(f"FAIL  {name}\n") }
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0 as u64
}

fn lower_file(path: u64, prog: u64, info: *mut lower.LowerInfo) -> u32 {
    var b: rt.Buf = rt.buf_new()
    if !rt.read_file(path, &b) { return 999 }
    var m: parse.Module = parse.module_zero()
    var e: u32 = parse.module_open(&m, rt.buf_ptr(&b), rt.buf_len(&b) / 4)
    if e == 0 { e = validate.validate(&m) }
    if e == 0 { e = lower.lower_stage(&m, spv.EM_FRAGMENT, prog, MAXPC, info) }
    parse.module_close(&m)
    return e
}

fn ovl(a0: f32, a1: f32, b0: f32, b1: f32) -> f32 {
    var lo: f32 = a1
    if b1 < lo { lo = b1 }
    var hi: f32 = a0
    if b0 > hi { hi = b0 }
    var d: f32 = lo - hi
    if d < 0.0f { d = 0.0f }
    return d
}

fn fmin(a: f32, b: f32) -> f32 {
    if a < b { return a }
    return b
}

fn fmax(a: f32, b: f32) -> f32 {
    if a > b { return a }
    return b
}
fn clamp01(v: f32) -> f32 { return fmax(0.0f, fmin(1.0f, v)) }

fn pack_unit(v: f32) -> u32 {
    var x: f32 = v
    if x < 0.0f { x = 0.0f }
    if x > 1.0f { x = 1.0f }
    return (x * 255.0f + 0.5f) as u32
}

fn packf(r: f32, g: f32, b: f32, a: f32) -> u32 {
    return pack_unit(r) | (pack_unit(g) << 8 as u32) | (pack_unit(b) << 16 as u32) | (pack_unit(a) << 24 as u32)
}

fn blendf(c0: f32, c1: f32, c2: f32, ca: f32, f: f32, out: *mut u32) -> bool {
    let a: f32 = ca / 255.0f * fmin(f, 1.0f)
    if a <= 0.0f { return false }
    *out = packf(c0 / 255.0f * a, c1 / 255.0f * a, c2 / 255.0f * a, a)
    return true
}

fn texel_rgba(t: u64, tw: i32, th: i32, x: i32, y: i32) -> u32 {
    if x < 0 || y < 0 || x >= tw || y >= th { return 0 as u32 }
    return rt.ld32(t, (y as usize) * (tw as usize) + (x as usize))
}

fn chan(px: u32, c: u32) -> f32 { return ((px >> (c * 8 as u32)) & 255 as u32) as f32 * (1.0f / 255.0f) }

fn tex_make(seed: u32) -> u64 {
    let t: u64 = rt.heap_alloc(W as usize * H as usize * 4)
    var i: u32 = 0
    while i < (W * H) as u32 {
        var cov: u32 = (i * 37 as u32 + seed) & 255 as u32
        if (i % 5 as u32) == 0 as u32 { cov = 0 as u32 }
        rt.st32(t, i as usize, cov | (((i * 11 as u32 + seed) & 255 as u32) << 8 as u32) | (((i * 13 as u32 + seed * 3 as u32) & 255 as u32) << 16 as u32) | (((i * 3 as u32 + 90 as u32 + seed) & 255 as u32) << 24 as u32))
        i = i + 1
    }
    return t
}

fn set_prm(k: usize, a: f32, b: f32, c: f32, d: f32) {
    prm[k] = a; prm[k + 1] = b; prm[k + 2] = c; prm[k + 3] = d
}

fn quad(f: *mut raster.Frame) {
    raster.vtx_put(f, 0, -1.0f, 1.0f, 0.5f, 1.0f, 0.0f, 0.0f, 1.0f, 1.0f, 1.0f, 1.0f)
    raster.vtx_put(f, 1, 1.0f, 1.0f, 0.5f, 1.0f, 0.0f, 0.0f, 1.0f, 1.0f, 1.0f, 1.0f)
    raster.vtx_put(f, 2, 1.0f, -1.0f, 0.5f, 1.0f, 0.0f, 0.0f, 1.0f, 1.0f, 1.0f, 1.0f)
    raster.vtx_put(f, 3, -1.0f, 1.0f, 0.5f, 1.0f, 0.0f, 0.0f, 1.0f, 1.0f, 1.0f, 1.0f)
    raster.vtx_put(f, 4, 1.0f, -1.0f, 0.5f, 1.0f, 0.0f, 0.0f, 1.0f, 1.0f, 1.0f, 1.0f)
    raster.vtx_put(f, 5, -1.0f, -1.0f, 0.5f, 1.0f, 0.0f, 0.0f, 1.0f, 1.0f, 1.0f, 1.0f)
    var v: usize = 0
    while v < 6 {
        var q: usize = 0
        while q < 28 {
            var val: f32 = 7.0f
            if v == 0 || v == 3 { val = prm[q] }
            raster.st_f32((*f).vbuf, v * raster.VSTRIDE + raster.FLAT0 + q, val)
            q = q + 1
        }
        v = v + 1
    }
    (*f).ntri = 2
}

fn render(f: *mut raster.Frame, prog: u64, jp: u64) {
    quad(f)
    raster.frame_clear(f, 0xFF102030 as u32, 1.0f)
    raster.frame_set_program(f, prog)
    raster.frame_set_flat(f, 28)
    raster.frame_set_kills(f, true)
    raster.frame_draw(f, jp)
}

fn ch_diff(a: u32, b: u32) -> i32 {
    var md: i32 = 0
    var s: u32 = 0
    while s < 32 as u32 {
        var d: i32 = (((a >> s) & 255 as u32) as i32) - (((b >> s) & 255 as u32) as i32)
        if d < 0 { d = 0 - d }
        if d > md { md = d }
        s = s + 8 as u32
    }
    return md
}

static mut dither: [i32; 16] = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5]
static mut spots: [f32; 32] = [0.0f; 32]
static mut nspot: i32 = 0

fn src_chan(src: u64, x: i32, y: i32, c: u32) -> i32 {
    let px: u32 = texel_rgba(src, W, H, x, H - 1 - y)
    return ((px >> (c * 8 as u32)) & 255 as u32) as i32
}

fn clampi(v: i32, lo: i32, hi: i32) -> i32 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn model6(ix: i32, iy: i32, out: *mut u32) -> bool {
    let clipf: f32 = ovl(ix as f32, (ix + 1) as f32, prm[20], prm[22]) * ovl(iy as f32, (iy + 1) as f32, prm[21], prm[23])
    if clipf <= 0.0f { return false }
    let y: f32 = prm[9]
    let h: f32 = fmax(prm[11], 1.0f)
    let fy: f32 = (iy as f32) + 0.5f
    let fx: f32 = (ix as f32) + 0.5f
    let t: f32 = clamp01((fy - y) / h)
    var c0: f32 = prm[0] + (prm[4] - prm[0]) * t
    var c1: f32 = prm[1] + (prm[5] - prm[1]) * t
    var c2: f32 = prm[2] + (prm[6] - prm[2]) * t
    var k: usize = 0
    while k < 4 && (k as i32) < nspot {
        let dx: f32 = fx - spots[k * 8]
        let dy: f32 = fy - spots[k * 8 + 1]
        let d2: f32 = dx * dx * spots[k * 8 + 2] + dy * dy * spots[k * 8 + 3]
        if d2 < 1.0f {
            let uu: f32 = 1.0f - d2
            let wg: f32 = uu * uu * spots[k * 8 + 4]
            c0 = c0 + (spots[k * 8 + 5] - c0) * wg
            c1 = c1 + (spots[k * 8 + 6] - c1) * wg
            c2 = c2 + (spots[k * 8 + 7] - c2) * wg
        }
        k = k + 1
    }
    let dd: f32 = ((dither[((iy & 3) * 4 + (ix & 3)) as usize] as f32) + 0.5f) / 16.0f - 0.5f
    let r: f32 = clamp01(math.floor32(c0 + dd + 0.5f) / 255.0f)
    let g: f32 = clamp01(math.floor32(c1 + dd + 0.5f) / 255.0f)
    let b: f32 = clamp01(math.floor32(c2 + dd + 0.5f) / 255.0f)
    *out = packf(r, g, b, 1.0f)
    return true
}

fn box_sum(src: u64, ix: i32, iy: i32, rad: i32, horiz: bool, c: u32) -> i32 {
    var sum: i32 = 0
    var j: i32 = 0 - rad
    while j <= rad {
        if horiz { sum = sum + src_chan(src, clampi(ix + j, 0, W - 1), iy, c) }
        else { sum = sum + src_chan(src, ix, clampi(iy + j, 0, H - 1), c) }
        j = j + 1
    }
    return sum
}

fn model_box(kind: i32, ix: i32, iy: i32, src: u64, out: *mut u32) -> bool {
    let clipf: f32 = ovl(ix as f32, (ix + 1) as f32, prm[20], prm[22]) * ovl(iy as f32, (iy + 1) as f32, prm[21], prm[23])
    if clipf <= 0.0f { return false }
    let rad: i32 = (prm[12] + 0.5f) as i32
    let n: i32 = 2 * rad + 1
    let inv: i32 = (65536 + n / 2) / n
    var px: u32 = 0 as u32
    var c: u32 = 0 as u32
    while c < 4 as u32 {
        let sum: i32 = box_sum(src, ix, iy, rad, kind == 11 || kind == 13, c)
        var v: i32 = (sum + n / 2) / n
        if kind >= 13 { v = (sum * inv + 32768) >> 16 }
        px = px | ((v as u32) << (c * 8 as u32))
        c = c + 1 as u32
    }
    *out = px
    return true
}

fn model15(ix: i32, iy: i32, src: u64, out: *mut u32) -> bool {
    let clipf: f32 = ovl(ix as f32, (ix + 1) as f32, prm[20], prm[22]) * ovl(iy as f32, (iy + 1) as f32, prm[21], prm[23])
    if clipf <= 0.0f { return false }
    let ta: i32 = (prm[3] + 0.5f) as i32
    var px: u32 = 0 as u32
    var c: u32 = 0 as u32
    while c < 4 as u32 {
        var tk: i32 = 255 * ta
        if c < 3 as u32 { tk = ((prm[c as usize] + 0.5f) as i32) * ta }
        let x: i32 = src_chan(src, ix, iy, c) * (255 - ta) + tk + 128
        px = px | ((((x + (x >> 8)) >> 8) as u32) << (c * 8 as u32))
        c = c + 1 as u32
    }
    *out = px
    return true
}

fn model(kind: i32, ix: i32, iy: i32, src: u64, out: *mut u32) -> bool {
    if kind == 6 { return model6(ix, iy, out) }
    if kind == 15 { return model15(ix, iy, src, out) }
    return model_box(kind, ix, iy, src, out)
}

fn compare(f: *mut raster.Frame, kind: i32, src: u64, covered: *mut i32) -> i32 {
    var bad: i32 = 0
    var cov: i32 = 0
    var y: i32 = 0
    while y < H {
        var x: i32 = 0
        while x < W {
            var e: u32 = 0xFF102030 as u32
            var o: u32 = 0 as u32
            if model(kind, x, H - 1 - y, src, &o) { e = o; cov = cov + 1 }
            if ch_diff(raster.frame_pixel(f, x, y), e) > 1 { bad = bad + 1 }
            x = x + 1
        }
        y = y + 1
    }
    *covered = cov
    return bad
}

fn load_kind(path: u64, name: str) -> u64 {
    let p: u64 = rt.heap_alloc(MAXPC * 20 + 64)
    var info: lower.LowerInfo = lower.info_zero()
    let e: u32 = lower_file(path, p, &info)
    check(name, e == 0)
    if e != 0 { io.fmt_print(f"      {lower.lower_err_name(e)} at word {info.err_pos}\n"); return 0 as u64 }
    io.fmt_print(f"      {info.ninstr} instructions, {info.peak_reg} registers\n")
    return p
}

fn put_spot(k: usize, cx: f32, cy: f32, ax: f32, ay: f32, wgt: f32, r: f32, g: f32, b: f32) {
    spots[k * 8] = cx; spots[k * 8 + 1] = cy; spots[k * 8 + 2] = ax; spots[k * 8 + 3] = ay
    spots[k * 8 + 4] = wgt; spots[k * 8 + 5] = r; spots[k * 8 + 6] = g; spots[k * 8 + 7] = b
}

fn upload_spots(ubo: u64) {
    raster.st_f32(ubo, 4, nspot as f32)
    var i: usize = 0
    while i < 32 {
        raster.st_f32(ubo, 8 + i, spots[i])
        i = i + 1
    }
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 14 {
        io.fmt_print(f"SKIP  fui loop kind spv files missing (glslangValidator/spirv-opt not installed)\n")
        return 0
    }
    let p6: u64 = load_kind(rt.arg_ptr(start, 1), "real fUi shader kind 6 (spot gradient, int[16] table, unrolled spots) lowers")
    let p11: u64 = load_kind(rt.arg_ptr(start, 2), "real fUi shader kind 11 (horizontal box blur, 129 unrolled taps) lowers")
    let p12: u64 = load_kind(rt.arg_ptr(start, 3), "real fUi shader kind 12 (vertical box blur) lowers")
    let p13: u64 = load_kind(rt.arg_ptr(start, 4), "real fUi shader kind 13 (horizontal box2) lowers")
    let p14: u64 = load_kind(rt.arg_ptr(start, 5), "real fUi shader kind 14 (vertical box2) lowers")
    let p15: u64 = load_kind(rt.arg_ptr(start, 6), "real fUi shader kind 15 (tint) lowers")
    var q: usize = 7
    var names: [str; 7] = ["real fUi shader kind 2 (rrect) lowers", "real fUi shader kind 3 (shadow) lowers", "real fUi shader kind 4 (ramp) lowers", "real fUi shader kind 8 (veil/glow) lowers", "real fUi shader kind 9 lowers", "real fUi shader kind 10 (frost shrink) lowers", "real fUi shader kind 16 (photo, bilinear) lowers"]
    while q < 14 {
        var info: lower.LowerInfo = lower.info_zero()
        let prog: u64 = rt.heap_alloc(MAXPC * 20 + 64)
        let e: u32 = lower_file(rt.arg_ptr(start, q), prog, &info)
        check(names[q - 7], e == 0)
        q = q + 1
    }
    if p6 == 0 as u64 || p11 == 0 as u64 || p12 == 0 as u64 || p13 == 0 as u64 || p14 == 0 as u64 || p15 == 0 as u64 {
        io.fmt_print(f"gfx fuiloop: {passed} ok, {failed} fail\n")
        return 1
    }
    let f: *mut raster.Frame = raster.frame_new(W, H, 8)
    (*f).mode = raster.MODE_VM
    (*f).depth_test = false
    raster.frame_set_blend(f, false)
    let ubo: u64 = rt.heap_alloc(64 * 4)
    rt.mem_set(ubo, 0 as u8, 64 * 4)
    raster.st_f32(ubo, 0, W as f32); raster.st_f32(ubo, 1, H as f32); raster.st_f32(ubo, 2, W as f32); raster.st_f32(ubo, 3, H as f32)
    raster.frame_set_ubo(f, ubo)
    let src: u64 = tex_make(59 as u32)
    raster.frame_set_texture_slot(f, 3, src, W, H)
    var j: jobs.Jobs = jobs.create(3)
    var cv: i32 = 0

    set_prm(0, 230.0f, 40.0f, 20.0f, 255.0f)
    set_prm(4, 10.0f, 60.0f, 240.0f, 255.0f)
    set_prm(8, 0.0f, 1.0f, 32.0f, 14.0f)
    set_prm(20, 0.0f, 0.0f, 31.0f, 14.0f)
    set_prm(24, 6.0f, 0.0f, 0.0f, 0.0f)
    nspot = 2
    put_spot(0, 8.5f, 6.5f, 0.02f, 0.03f, 0.9f, 255.0f, 255.0f, 255.0f)
    put_spot(1, 22.5f, 9.5f, 0.05f, 0.05f, 0.6f, 0.0f, 255.0f, 0.0f)
    upload_spots(ubo)
    render(f, p6, 0 as u64)
    var bad: i32 = compare(f, 6, src, &cv)
    io.fmt_print(f"      kind 6: {bad} differing of {W * H}, {cv} written\n")
    check("kind 6 (gradient, 2 spots, ordered dither table) == native model", bad == 0 && cv > 300)
    render(f, p6, (&j) as u64)
    check("kind 6 with 4 threads == model", compare(f, 6, src, &cv) == 0)
    nspot = 1
    upload_spots(ubo)
    render(f, p6, 0 as u64)
    nspot = 2
    check("counter-proof kind 6: one spot fewer differs from the model", compare(f, 6, src, &cv) > 20)
    nspot = 0
    upload_spots(ubo)
    render(f, p6, 0 as u64)
    check("kind 6 without spots (u_nspot = 0, break at the first iteration) == model", compare(f, 6, src, &cv) == 0)
    nspot = 2
    upload_spots(ubo)
    var kk: i32 = 0
    while kk < 4 {
        set_prm(24, 11.0f + kk as f32, 0.0f, 0.0f, 0.0f)
        set_prm(12, 7.0f, 32.0f, 16.0f, 0.0f)
        set_prm(20, 0.0f, 0.0f, 32.0f, 16.0f)
        var pr: u64 = p11
        if kk == 1 { pr = p12 }
        if kk == 2 { pr = p13 }
        if kk == 3 { pr = p14 }
        render(f, pr, 0 as u64)
        bad = compare(f, 11 + kk, src, &cv)
        io.fmt_print(f"      kind {11 + kk}: {bad} differing, {cv} written\n")
        check("kinds 11-14 (box blur radius 7) == native model", bad == 0 && cv == W * H)
        kk = kk + 1
    }
    set_prm(24, 11.0f, 0.0f, 0.0f, 0.0f)
    set_prm(12, 7.0f, 32.0f, 16.0f, 0.0f)
    render(f, p11, (&j) as u64)
    check("kind 11 with 4 threads == model", compare(f, 11, src, &cv) == 0)
    set_prm(12, 5.0f, 32.0f, 16.0f, 0.0f)
    render(f, p11, 0 as u64)
    set_prm(12, 7.0f, 32.0f, 16.0f, 0.0f)
    check("counter-proof kind 11: radius 5 instead of 7 differs", compare(f, 11, src, &cv) > 100)
    set_prm(12, 0.0f, 32.0f, 16.0f, 0.0f)
    render(f, p11, 0 as u64)
    check("kind 11 with radius 0 (only the centre tap) == model", compare(f, 11, src, &cv) == 0)
    set_prm(12, 64.0f, 32.0f, 16.0f, 0.0f)
    render(f, p11, 0 as u64)
    check("kind 11 with radius 64 (all 129 taps, edge clamp) == model", compare(f, 11, src, &cv) == 0)
    set_prm(12, 7.0f, 32.0f, 16.0f, 0.0f)
    render(f, p12, 0 as u64)
    check("counter-proof kind 12: vertical pass against the horizontal model differs", compare(f, 11, src, &cv) > 100)

    set_prm(0, 40.0f, 200.0f, 90.0f, 96.0f)
    set_prm(20, 0.0f, 0.0f, 32.0f, 16.0f)
    set_prm(24, 15.0f, 0.0f, 0.0f, 0.0f)
    render(f, p15, 0 as u64)
    bad = compare(f, 15, src, &cv)
    check("kind 15 (frost tint over the band) == native model", bad == 0 && cv == W * H)
    set_prm(0, 40.0f, 200.0f, 90.0f, 32.0f)
    render(f, p15, 0 as u64)
    set_prm(0, 40.0f, 200.0f, 90.0f, 96.0f)
    check("counter-proof kind 15: other tint alpha differs", compare(f, 15, src, &cv) > 100)

    jobs.destroy(&j)
    io.fmt_print(f"gfx fuiloop: {passed} ok, {failed} fail\n")
    if failed == 0 { return 0 }
    return 1
}
