// tools/gfx/test_clip.fi -- host checks for near plane clipping in lib/gpu/swr (analytic coverage and depth, watertight shared edge, threads)
import std.rt
import std.io
import std.math
import jobs.jobs
import gpu.swr.raster
import gpu.swr.shader
import gpu.swr.scene

static mut passed: i32 = 0
static mut failed: i32 = 0

fn check(name: str, ok: bool) {
    if ok { passed = passed + 1; io.fmt_print(f"OK    {name}\n") }
    else { failed = failed + 1; io.fmt_print(f"FAIL  {name}\n") }
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0 as u64
}

fn vtx(f: *mut raster.Frame, n: usize, x: f32, y: f32, z: f32, w: f32) {
    raster.vtx_put(f, n, x, y, z, w, 0.5f, 0.5f, 1.0f, 1.0f, 1.0f, 1.0f)
}

// pixel centre in NDC
fn ndc_x(px: i32, w: i32) -> f64 {
    return ((px as f64) + 0.5) / (w as f64) * 2.0 - 1.0
}

fn ndc_y(py: i32, h: i32) -> f64 {
    return 1.0 - ((py as f64) + 0.5) / (h as f64) * 2.0
}

fn depth_at(f: *mut raster.Frame, x: i32, y: i32) -> f32 {
    return raster.ld_f32((*f).depth, (y as usize) * ((*f).w as usize) + (x as usize))
}

// 1. w = 1 triangle (-1,-1,.5) (3,-1,.5) (-1,3,-1): z = 0.5 - 1.5 (y + 1) / 4 >= 0 only for NDC y <= 1/3: rows 67.. of 200
fn test_rows(f: *mut raster.Frame, W: i32, H: i32) {
    (*f).mode = raster.MODE_COUNT
    (*f).depth_test = true
    (*f).ntri = 1
    vtx(f, 0, -1.0f, -1.0f, 0.5f, 1.0f)
    vtx(f, 1, 3.0f, -1.0f, 0.5f, 1.0f)
    vtx(f, 2, -1.0f, 3.0f, -1.0f, 1.0f)
    raster.frame_clear(f, 0 as u32, 1.0f)
    raster.frame_draw(f, 0 as u64)
    var bad: i32 = 0
    var neg: i32 = 0
    var y: i32 = 0
    while y < H {
        var x: i32 = 0
        while x < W {
            var want: u32 = 0 as u32
            if y >= 67 { want = 1 as u32 }
            if raster.frame_pixel(f, x, y) != want { bad = bad + 1 }
            if raster.frame_pixel(f, x, y) != 0 as u32 && depth_at(f, x, y) < 0.0f { neg = neg + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check("near clip: one vertex behind the plane, covered rows match the analytic line (rows 67..199 once)", bad == 0)
    check("near clip: no pixel with negative depth", neg == 0)
}

fn load_v(f: *mut raster.Frame, n: usize, k: usize) -> f64 {
    return raster.ld_f32((*f).vbuf, n * raster.VSTRIDE + k) as f64
}

// compare the drawn triangle in slot 0 against the analytic coverage and depth; returns mismatching pixels (boundary pixels are skipped)
fn check_tri(f: *mut raster.Frame, W: i32, H: i32) -> i32 {
    var sx: [f64; 3] = [0.0; 3]
    var sy: [f64; 3] = [0.0; 3]
    var zn: [f64; 3] = [0.0; 3]
    var k: usize = 0
    while k < 3 {
        let w: f64 = load_v(f, k, 3)
        sx[k] = (load_v(f, k, 0) / w * 0.5 + 0.5) * (W as f64)
        sy[k] = (0.5 - load_v(f, k, 1) / w * 0.5) * (H as f64)
        zn[k] = load_v(f, k, 2) / w
        k = k + 1
    }
    let det: f64 = (sx[1] - sx[0]) * (sy[2] - sy[0]) - (sy[1] - sy[0]) * (sx[2] - sx[0])
    let gx: f64 = ((zn[1] - zn[0]) * (sy[2] - sy[0]) - (zn[2] - zn[0]) * (sy[1] - sy[0])) / det
    let gy: f64 = ((zn[2] - zn[0]) * (sx[1] - sx[0]) - (zn[1] - zn[0]) * (sx[2] - sx[0])) / det
    let tol: f64 = 0.001 + 0.07 * (math.fabs(gx) + math.fabs(gy))
    var maxlen: f64 = 0.0
    k = 0
    while k < 3 {
        let k2: usize = (k + 1) % 3
        let l: f64 = math.sqrt((sx[k2] - sx[k]) * (sx[k2] - sx[k]) + (sy[k2] - sy[k]) * (sy[k2] - sy[k]))
        if l > maxlen { maxlen = l }
        k = k + 1
    }
    let edge_px: f64 = math.fabs(det) / maxlen
    (*f).mode = raster.MODE_COUNT
    (*f).depth_test = true
    (*f).ntri = 1
    raster.frame_clear(f, 0 as u32, 1.0f)
    raster.frame_draw(f, 0 as u64)
    var bad: i32 = 0
    var y: i32 = 0
    while y < H {
        var x: i32 = 0
        while x < W {
            let cx: f64 = (x as f64) + 0.5
            let cy: f64 = (y as f64) + 0.5
            let b1: f64 = ((cx - sx[0]) * (sy[2] - sy[0]) - (cy - sy[0]) * (sx[2] - sx[0])) / det
            let b2: f64 = ((sx[1] - sx[0]) * (cy - sy[0]) - (sy[1] - sy[0]) * (cx - sx[0])) / det
            let b0: f64 = 1.0 - b1 - b2
            let z: f64 = b0 * zn[0] + b1 * zn[1] + b2 * zn[2]
            var mn: f64 = b0
            if b1 < mn { mn = b1 }
            if b2 < mn { mn = b2 }
            if !(math.fabs(mn) * edge_px < 0.15 || math.fabs(z) < tol || math.fabs(z - 1.0) < tol) {
                var want: u32 = 0 as u32
                if mn > 0.0 && z >= 0.0 && z < 1.0 { want = 1 as u32 }
                let got: u32 = raster.frame_pixel(f, x, y)
                if got != want { bad = bad + 1 }
                else if got == 1 as u32 && math.fabs((depth_at(f, x, y) as f64) - z) > tol { bad = bad + 1 }
            }
            x = x + 1
        }
        y = y + 1
    }
    return bad
}

fn set_tri(f: *mut raster.Frame, a: u64, i: usize) {
    var k: usize = 0
    while k < 3 {
        var c: usize = 0
        while c < raster.VSTRIDE {
            raster.st_f32((*f).vbuf, k * raster.VSTRIDE + c, raster.ld_f32(a, (i * 3 + k) * raster.VSTRIDE + c))
            c = c + 1
        }
        k = k + 1
    }
}

fn test_analytic(f: *mut raster.Frame, W: i32, H: i32) {
    vtx(f, 0, -0.5f, -0.4f, -0.3f, 1.0f)
    vtx(f, 1, 0.9f, -0.5f, 1.2f, 1.5f)
    vtx(f, 2, 0.2f, 1.4f, 1.1f, 2.0f)
    check("near clip: one vertex behind (quad result), coverage and depth equal the analytic plane", check_tri(f, W, H) == 0)
    vtx(f, 0, -0.5f, -0.4f, -0.3f, 1.0f)
    vtx(f, 1, 0.9f, -0.5f, -0.9f, 1.5f)
    vtx(f, 2, 0.2f, 1.4f, 1.1f, 2.0f)
    check("near clip: two vertices behind (triangle result), coverage and depth equal the analytic plane", check_tri(f, W, H) == 0)
    let fs: *mut raster.Frame = raster.frame_new(W, H, 256)
    scene.scene_straddle(fs, 120, 4242 as u64)
    var total: i32 = 0
    var i: usize = 0
    while i < 120 {
        set_tri(f, (*fs).vbuf, i)
        total = total + check_tri(f, W, H)
        i = i + 1
    }
    check("near clip: 120 random straddling triangles, 0 mismatching pixels against the analytic plane", total == 0)
    raster.frame_free(fs)
}

fn test_behind(f: *mut raster.Frame, W: i32, H: i32) {
    (*f).mode = raster.MODE_COUNT
    (*f).depth_test = true
    (*f).ntri = 1
    vtx(f, 0, -1.0f, -1.0f, -0.2f, 1.0f)
    vtx(f, 1, 3.0f, -1.0f, -0.1f, 1.0f)
    vtx(f, 2, -1.0f, 3.0f, -0.3f, 1.0f)
    raster.frame_clear(f, 0 as u32, 1.0f)
    raster.frame_draw(f, 0 as u64)
    check("near clip: triangle entirely behind the plane draws nothing", raster.frame_stat_pixels(f) == 0 as u64)
    vtx(f, 0, -0.5f, -0.5f, 0.2f, 1.0f)
    vtx(f, 1, 0.5f, -0.5f, 0.3f, 1.0f)
    vtx(f, 2, 0.0f, 0.5f, 0.2f, -0.5f)
    raster.frame_clear(f, 0 as u32, 1.0f)
    raster.frame_draw(f, 0 as u64)
    var bad: i32 = 0
    var y: i32 = 0
    while y < H {
        var x: i32 = 0
        while x < W {
            let d: f32 = depth_at(f, x, y)
            if !(d >= 0.0f) { bad = bad + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check("near clip: vertex with w < 0 gives no NaN or negative depth", bad == 0)
}

// ground plane quad d in [0.2, 5], x in [-1, 1], clip (x, -0.2, 1.1 d - 0.55, d); visible for d >= 0.5; two triangles share a diagonal
fn ground_vtx(f: *mut raster.Frame, n: usize, x: f32, d: f32) {
    vtx(f, n, x, -0.2f, 1.1f * d - 0.55f, d)
}

fn test_edge(f: *mut raster.Frame, W: i32, H: i32) {
    ground_vtx(f, 0, -1.0f, 0.2f)
    ground_vtx(f, 1, 1.0f, 0.2f)
    ground_vtx(f, 2, 1.0f, 5.0f)
    ground_vtx(f, 3, -1.0f, 0.2f)
    ground_vtx(f, 4, 1.0f, 5.0f)
    ground_vtx(f, 5, -1.0f, 5.0f)
    (*f).ntri = 2
    (*f).mode = raster.MODE_COUNT
    (*f).depth_test = false
    raster.frame_clear(f, 0 as u32, 1.0f)
    raster.frame_draw(f, 0 as u64)
    var twice: i32 = 0
    var bad: i32 = 0
    var covered: i32 = 0
    var y: i32 = 0
    while y < H {
        var x: i32 = 0
        while x < W {
            let px: f64 = ndc_x(x, W)
            let py: f64 = ndc_y(y, H)
            let got: u32 = raster.frame_pixel(f, x, y)
            if got > 1 as u32 { twice = twice + 1 }
            if py < 0.0 {
                let d: f64 = 0.0 - 0.2 / py
                let xv: f64 = px * d
                let ax: f64 = math.fabs(xv)
                let near_edge: bool = math.fabs(d - 0.5) < 0.02 || math.fabs(d - 5.0) < 0.02 || math.fabs(ax - 1.0) < 0.02
                if !near_edge {
                    var want: u32 = 0 as u32
                    if d >= 0.5 && d <= 5.0 && ax <= 1.0 { want = 1 as u32 }
                    if got != want { bad = bad + 1 }
                    if got == 1 as u32 { covered = covered + 1 }
                }
            } else if got != 0 as u32 { bad = bad + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check("near clip: ground quad crossing the plane, shared diagonal has no double hit", twice == 0)
    check("near clip: ground quad coverage equals the analytic region, no gap along the cut", bad == 0 && covered > 1000)
}

fn test_threads(f: *mut raster.Frame, jp: u64, prog: u64) {
    (*f).ntri = 0
    scene.scene_straddle(f, 300, 99 as u64)
    (*f).depth_test = true
    (*f).mode = raster.MODE_NATIVE0
    raster.frame_clear(f, 0xFF000000 as u32, 1.0f)
    raster.frame_draw(f, 0 as u64)
    let h1: u64 = raster.frame_hash(f)
    let px: u64 = raster.frame_stat_pixels(f)
    raster.frame_clear(f, 0xFF000000 as u32, 1.0f)
    raster.frame_draw(f, jp)
    check("near clip: 4 threads == 1 thread (300 straddling triangles, bit identical)", raster.frame_hash(f) == h1 && px > 0 as u64)
    (*f).mode = raster.MODE_VM
    raster.frame_set_program(f, prog)
    raster.frame_clear(f, 0xFF000000 as u32, 1.0f)
    raster.frame_draw(f, 0 as u64)
    check("near clip: VM program == native program on straddling triangles", raster.frame_hash(f) == h1)
}

fn main() -> i32 {
    let W: i32 = 320
    let H: i32 = 200
    let f: *mut raster.Frame = raster.frame_new(W, H, 4096)
    let tex: u64 = scene.make_texture(256)
    raster.frame_set_texture(f, tex, 256, 256)
    let prog0: u64 = shader.prog_new()
    shader.prog_tex_times_colour(prog0)
    var j: jobs.Jobs = jobs.create(3)
    test_rows(f, W, H)
    test_analytic(f, W, H)
    test_behind(f, W, H)
    test_edge(f, W, H)
    test_threads(f, (&j) as u64, prog0)
    jobs.destroy(&j)
    io.fmt_print(f"gfx clip: {passed} ok, {failed} fail\n")
    if failed == 0 { return 0 }
    return 1
}
