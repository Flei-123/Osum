import std.rt
import std.io
import fui.ime
import fui.textbuf

static mut BUF: [u8; 256] = [0; 256]

fn expect(name: str, cond: bool) {
    if cond {
        io.print("OK   ")
    } else {
        io.print("FAIL ")
    }
    io.print_line(name)
}

fn text_is(t: *mut textbuf.TextBuf, want: [u8; 8], n: usize) -> bool {
    if textbuf.tb_len(t) != n {
        return false
    }
    var i: usize = 0
    while i < n {
        if *((textbuf.tb_ptr(t) + i as u64) as *mut u8) != want[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn feed_all(m: *mut ime.Ime, t: *mut textbuf.TextBuf, s: str) {
    var i: usize = 0
    while i < s.n {
        let q: *mut u8 = (s.p as u64 + i as u64) as *mut u8
        let c: u32 = (*q) as u32
        let r: bool = ime.ime_feed(m, t, c)
        i = i + 1
    }
}

fn fresh(t: *mut textbuf.TextBuf) {
    *t = textbuf.tb_new()
    textbuf.tb_init(t, (&BUF[0]) as u64, 256)
}

fn main() -> i32 {
    var t: textbuf.TextBuf = textbuf.tb_new()
    var m: ime.Ime = ime.ime_new()

    fresh(&t)
    ime.ime_set_mode(&m, &t, ime.IME_KANA)
    feed_all(&m, &t, "ka")
    ime.ime_commit(&m, &t)
    expect("romaji ka commits hiragana KA", text_is(&t, [0xE3, 0x81, 0x8B, 0, 0, 0, 0, 0], 3))

    fresh(&t)
    ime.ime_set_mode(&m, &t, ime.IME_KANA)
    feed_all(&m, &t, "shi")
    ime.ime_commit(&m, &t)
    expect("romaji shi commits hiragana SI", text_is(&t, [0xE3, 0x81, 0x97, 0, 0, 0, 0, 0], 3))

    fresh(&t)
    ime.ime_set_mode(&m, &t, ime.IME_HANGUL)
    feed_all(&m, &t, "gks")
    ime.ime_commit(&m, &t)
    expect("hangul g k s composes one syllable HAN", text_is(&t, [0xED, 0x95, 0x9C, 0, 0, 0, 0, 0], 3))

    fresh(&t)
    ime.ime_set_mode(&m, &t, ime.IME_PINYIN)
    feed_all(&m, &t, "zhong")
    expect("pinyin zhong offers candidates", ime.ime_cand_count(&m) > 0)
    let picked: bool = ime.ime_cand_pick_digit(&m, &t, 1)
    expect("pinyin candidate 1 is picked", picked)
    expect("pinyin pick leaves a CJK character", textbuf.tb_len(&t) == 3 && *(textbuf.tb_ptr(&t) as *mut u8) >= 0xE4 && *(textbuf.tb_ptr(&t) as *mut u8) <= 0xE9)

    fresh(&t)
    ime.ime_set_mode(&m, &t, ime.IME_OFF)
    feed_all(&m, &t, "ka")
    expect("counter-proof: mode off converts nothing", textbuf.tb_len(&t) == 0)
    return 0
}
