profile kernel

import fui.speaktext
import audio.speech

export { probe }

static mut k_name: [u8; 5] = "Save\0"
static mut k_out: [u8; 96] = [0 as u8; 96]
static mut k_pcm: [u8; 16384] = [0 as u8; 16384]

fn probe() -> u64 {
    let n: u64 = speaktext.describe(3, 1, (&k_name[0 as usize]) as u64, (&k_out[0 as usize]) as u64, 96)
    return n + speech.render((&k_out[0 as usize]) as u64, (&k_pcm[0 as usize]) as u64, 4096)
}
