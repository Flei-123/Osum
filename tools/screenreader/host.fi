import std.rt
import std.io
import audio.speech
import audio.speechdsp
import audio.speechphon
import audio.speechlang
import audio.phonbuf
import fui.speaktext

struct T {
    fails: i32,
    checks: i32,
}

static mut cbuf: [u8; 2048] = [0 as u8; 2048]
static mut cslot: usize = 0
static mut pcm: [u8; 262144] = [0 as u8; 262144]
static mut obuf: [u8; 256] = [0 as u8; 256]
static mut phb: [u8; 512] = [0 as u8; 512]

fn c(s: str) -> u64 {
    let base: usize = (cslot % 16) * 128
    cslot = cslot + 1
    var i: usize = 0
    while i < s.length() && i < 127 {
        cbuf[base + i] = *((s.p as u64 + i as u64) as *mut u8)
        i = i + 1
    }
    cbuf[base + i] = 0 as u8
    return ((&cbuf[0 as usize]) as u64) + base as u64
}

fn check(t: *mut T, ok: bool, what: str) {
    (*t).checks = (*t).checks + 1
    if ok {
        io.fmt_print(f"ok   {what}\n")
    } else {
        io.fmt_print(f"FAIL {what}\n")
        (*t).fails = (*t).fails + 1
    }
}

fn is_s(p: u64, s: str) -> bool {
    var i: usize = 0
    while i < s.length() {
        if rt.ld8(p, i) != rt.ld8(s.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return rt.ld8(p, i) == 0 as u8
}

fn has_sub(p: u64, s: str) -> bool {
    var i: usize = 0
    while rt.ld8(p, i) != 0 as u8 {
        var k: usize = 0
        var same: bool = true
        while k < s.length() && same {
            if rt.ld8(p, i + k) != rt.ld8(s.p as u64, k) {
                same = false
            }
            k = k + 1
        }
        if same {
            return true
        }
        i = i + 1
    }
    return false
}

fn say(role: u64, flags: u64, name: str) -> u64 {
    return speaktext.describe(role, flags, c(name), (&obuf[0 as usize]) as u64, 256)
}

fn talk(text: str) -> u64 {
    return speech.render(c(text), (&pcm[0 as usize]) as u64, 65000)
}

fn smp(i: u64) -> i64 {
    let lo: i64 = rt.ld8((&pcm[0 as usize]) as u64, (i * 4) as usize) as i64
    let hi: i64 = rt.ld8((&pcm[0 as usize]) as u64, (i * 4 + 1) as usize) as i64
    let v: i64 = lo + hi * 256
    if v >= 32768 {
        return v - 65536
    }
    return v
}

fn sum_sig(n: u64) -> u64 {
    var h: u64 = 7
    var i: u64 = 0
    while i < n * 4 {
        h = (h * 31 + rt.ld8((&pcm[0 as usize]) as u64, i as usize) as u64) % 1000000007
        i = i + 1
    }
    return h
}

fn peak(n: u64) -> i64 {
    var pk: i64 = 0
    var i: u64 = 0
    while i < n {
        var a: i64 = smp(i)
        if a < 0 {
            a = 0 - a
        }
        if a > pk {
            pk = a
        }
        i = i + 1
    }
    return pk
}

fn tone_energy(from: u64, n: u64, hz: u64) -> u64 {
    var re: i64 = 0
    var im: i64 = 0
    var i: u64 = 0
    while i < n {
        let ph: u64 = (hz * (from + i) * 16384 / 16000) % 16384
        let x: i64 = smp(from + i)
        re = re + x * speechdsp.cos_fine(ph) / 1024
        im = im + x * speechdsp.cos_fine((ph + 12288) % 16384) / 1024
        i = i + 1
    }
    let a: i64 = re / 64
    let b: i64 = im / 64
    return (a * a + b * b) as u64
}

fn band(from: u64, n: u64, lo: u64, hi: u64) -> u64 {
    var e: u64 = 0
    var f: u64 = lo
    while f <= hi {
        e = e + tone_energy(from, n, f)
        f = f + 50
    }
    return e
}

fn period_of(from: u64, n: u64) -> u64 {
    var best: u64 = 0
    var best_v: i64 = 0 - 1
    var lag: u64 = 60
    while lag < 220 {
        var s: i64 = 0
        var i: u64 = 0
        while i < n {
            s = s + smp(from + i) * smp(from + i + lag) / 256
            i = i + 1
        }
        if s > best_v {
            best_v = s
            best = lag
        }
        lag = lag + 1
    }
    return best
}

fn longest_zero_run(n: u64) -> u64 {
    var best: u64 = 0
    var run: u64 = 0
    var i: u64 = 0
    while i < n {
        if smp(i) == 0 {
            run = run + 1
            if run > best {
                best = run
            }
        } else {
            run = 0
        }
        i = i + 1
    }
    return best
}

fn phon(text: str) -> u64 {
    return speechlang.to_phonemes(c(text), (&phb[0 as usize]) as u64, 512)
}

fn pname(id: u8) -> str {
    if id == phonbuf.PH_WORD {
        return "_"
    }
    if id == phonbuf.PH_COMMA {
        return ","
    }
    if id == phonbuf.PH_STOP {
        return "."
    }
    if id == phonbuf.PH_A {
        return "a"
    }
    if id == phonbuf.PH_E {
        return "E"
    }
    if id == phonbuf.PH_I {
        return "I"
    }
    if id == phonbuf.PH_O {
        return "O"
    }
    if id == phonbuf.PH_U {
        return "U"
    }
    if id == phonbuf.PH_SCHWA {
        return "@"
    }
    if id == phonbuf.PH_M {
        return "m"
    }
    if id == phonbuf.PH_N {
        return "n"
    }
    if id == phonbuf.PH_L {
        return "l"
    }
    if id == phonbuf.PH_R {
        return "R"
    }
    if id == phonbuf.PH_W {
        return "w"
    }
    if id == phonbuf.PH_Y {
        return "j"
    }
    if id == phonbuf.PH_S {
        return "s"
    }
    if id == phonbuf.PH_SH {
        return "S"
    }
    if id == phonbuf.PH_F {
        return "f"
    }
    if id == phonbuf.PH_H {
        return "h"
    }
    if id == phonbuf.PH_TH {
        return "T"
    }
    if id == phonbuf.PH_Z {
        return "z"
    }
    if id == phonbuf.PH_V {
        return "v"
    }
    if id == phonbuf.PH_P {
        return "p"
    }
    if id == phonbuf.PH_T {
        return "t"
    }
    if id == phonbuf.PH_K {
        return "k"
    }
    if id == phonbuf.PH_B {
        return "b"
    }
    if id == phonbuf.PH_D {
        return "d"
    }
    if id == phonbuf.PH_G {
        return "g"
    }
    if id == phonbuf.PH_AL {
        return "a:"
    }
    if id == phonbuf.PH_EL {
        return "e:"
    }
    if id == phonbuf.PH_IL {
        return "i:"
    }
    if id == phonbuf.PH_OL {
        return "o:"
    }
    if id == phonbuf.PH_UL {
        return "u:"
    }
    if id == phonbuf.PH_UE {
        return "Y"
    }
    if id == phonbuf.PH_UEL {
        return "y:"
    }
    if id == phonbuf.PH_OE {
        return "9"
    }
    if id == phonbuf.PH_OEL {
        return "2:"
    }
    if id == phonbuf.PH_CI {
        return "C"
    }
    if id == phonbuf.PH_CA {
        return "x"
    }
    if id == phonbuf.PH_NG {
        return "N"
    }
    return "?"
}

static mut phs: [u8; 400] = [0 as u8; 400]

fn phseq(text: str) -> u64 {
    let n: u64 = phon(text)
    var at: usize = 0
    var i: u64 = 0
    while i < n {
        let nm: str = pname(rt.ld8((&phb[0 as usize]) as u64, i as usize))
        if i > 0 {
            phs[at] = 32 as u8
            at = at + 1
        }
        var k: usize = 0
        while k < nm.length() && at < 390 {
            phs[at] = rt.ld8(nm.p as u64, k)
            at = at + 1
            k = k + 1
        }
        i = i + 1
    }
    phs[at] = 0 as u8
    return n
}

fn de_says(t: *mut T, text: str, want: str) {
    speechlang.set(speechlang.LANG_DE)
    let n: u64 = phseq(text)
    speechlang.set(speechlang.LANG_EN)
    let ok: bool = is_s((&phs[0 as usize]) as u64, want)
    check(t, ok, text)
    if !ok {
        io.fmt_print(f"     want {want}\n     got")
        var k: u64 = 0
        while k < n {
            let nm: str = pname(rt.ld8((&phb[0 as usize]) as u64, k as usize))
            io.fmt_print(f" {nm}")
            k = k + 1
        }
        io.fmt_print(f"\n")
    }
}

fn main() -> i32 {
    var t: T = T { fails: 0, checks: 0 }

    check(&t, say(3, 3, "Save") > 0 && is_s((&obuf[0 as usize]) as u64, "Save, button"), "button: name, role")
    check(&t, say(4, 1 + 32, "Remember me") > 0 && is_s((&obuf[0 as usize]) as u64, "Remember me, check box, checked"), "check box checked")
    say(4, 1, "Remember me")
    check(&t, is_s((&obuf[0 as usize]) as u64, "Remember me, check box, not checked"), "check box not checked")
    say(3, 2, "Disabled")
    check(&t, is_s((&obuf[0 as usize]) as u64, "Disabled, button, unavailable"), "disabled button says unavailable")
    say(6, 1 + 2 + 64, "Password")
    check(&t, is_s((&obuf[0 as usize]) as u64, "Password, password field, protected"), "password field: name, role, protected")
    check(&t, say(3, 1 + 16, "Hidden") == 0 && rt.ld8((&obuf[0 as usize]) as u64, 0) == 0 as u8, "hidden node says nothing")
    say(2, 1, "Just text")
    check(&t, is_s((&obuf[0 as usize]) as u64, "Just text"), "label: name only")
    say(8, 1 + 8, "Files")
    check(&t, is_s((&obuf[0 as usize]) as u64, "Files, table, selected"), "table selected")
    say(1, 1, "Notes")
    check(&t, is_s((&obuf[0 as usize]) as u64, "Notes, window"), "window node: no 'unavailable'")
    say(5, 1, "a\tb")
    check(&t, is_s((&obuf[0 as usize]) as u64, "a b, edit field"), "control characters become spaces")
    say(3, 1, "0123456789012345678901234567890123456789ABCDEFGH")
    check(&t, !has_sub((&obuf[0 as usize]) as u64, "ABCDEFGH") && has_sub((&obuf[0 as usize]) as u64, "0123456789012345678901234567890123456789"), "name cut at 40 octets")
    var canary: [u8; 24] = [0 as u8; 24]
    canary[0 as usize] = 80 as u8
    canary[1 as usize] = 119 as u8
    canary[2 as usize] = 0 as u8
    canary[3 as usize] = 71 as u8
    canary[4 as usize] = 69 as u8
    canary[5 as usize] = 72 as u8
    canary[6 as usize] = 69 as u8
    canary[7 as usize] = 73 as u8
    canary[8 as usize] = 77 as u8
    speaktext.describe(6, 1 + 64, (&canary[0 as usize]) as u64, (&obuf[0 as usize]) as u64, 256)
    check(&t, !has_sub((&obuf[0 as usize]) as u64, "GEHEIM") && has_sub((&obuf[0 as usize]) as u64, "Pw, password field, protected"), "protected node: nothing past the name is spoken")
    speaktext.window_intro(c("Notes"), (&obuf[0 as usize]) as u64, 256)
    check(&t, is_s((&obuf[0 as usize]) as u64, "Notes, window"), "window intro")
    check(&t, speaktext.describe(3, 1, c("Long name here"), (&obuf[0 as usize]) as u64, 8) <= 7, "output capacity respected")

    check(&t, phon("save") == 3 && rt.ld8((&phb[0 as usize]) as u64, 0) == phonbuf.PH_S && rt.ld8((&phb[0 as usize]) as u64, 2) == phonbuf.PH_V, "silent final e: save = s a v")
    check(&t, phon("a b") == 3 && rt.ld8((&phb[0 as usize]) as u64, 1) == phonbuf.PH_WORD, "space between words is a word pause")
    let p1: u64 = phon("shop")
    check(&t, p1 == 3 && rt.ld8((&phb[0 as usize]) as u64, 0) == phonbuf.PH_SH, "digraph sh")
    check(&t, phon("1") > 2 && phon("Menü") == phon("Menu"), "digits are words; umlauts fold to vowels")
    check(&t, phon("a,") == 2 && rt.ld8((&phb[0 as usize]) as u64, 1) == phonbuf.PH_COMMA, "comma is a longer pause")

    check(&t, talk("") == 0, "empty text, no audio")
    let na: u64 = talk("a")
    check(&t, na >= 1800 && na < 2600, "a vowel lasts 110 to 160 ms")
    let ha: u64 = sum_sig(na)
    let nb: u64 = talk("a")
    check(&t, nb == na && sum_sig(nb) == ha, "rendering is deterministic")
    let n1: u64 = talk("hello")
    let n2: u64 = talk("hello world")
    check(&t, n2 > n1 + 1000, "longer text, longer audio")
    let np: u64 = talk("hello world")
    check(&t, np == n2 && peak(np) <= 32000 && peak(np) >= 2500, "audible and never clipped")
    let d1: u64 = talk("1")
    let dh: u64 = sum_sig(d1)
    let d2: u64 = talk("2")
    check(&t, d1 > 1500 && sum_sig(d2) != dh, "digits render and differ")
    let s1: u64 = talk("save")
    let h1: u64 = sum_sig(s1)
    let s2: u64 = talk("close")
    check(&t, sum_sig(s2) != h1, "different text, different audio")

    var cap_ok: bool = true
    var g: u64 = 0
    while g < 16 {
        pcm[(1000 * 4 + g) as usize] = 170 as u8
        g = g + 1
    }
    let nc: u64 = speech.render(c("hello world this is a long sentence"), (&pcm[0 as usize]) as u64, 1000)
    g = 0
    while g < 16 {
        if pcm[(1000 * 4 + g) as usize] != 170 as u8 {
            cap_ok = false
        }
        g = g + 1
    }
    check(&t, nc == 1000 && cap_ok, "capacity respected, nothing written past it")

    let va: u64 = talk("a")
    let mid: u64 = va / 2 - 400
    let per: u64 = period_of(mid, 800)
    check(&t, per >= 112 && per <= 140, "vowel pitch period near 125 Hz")
    let a_low: u64 = band(mid, 800, 600, 900)
    let a_high: u64 = band(mid, 800, 2100, 2600)
    check(&t, a_low > a_high * 2, "a: energy at F1 (730) beats 2.1-2.6 kHz")
    let vi: u64 = talk("i")
    let mi: u64 = vi / 2 - 400
    let i_low: u64 = band(mi, 800, 600, 900)
    let i_high: u64 = band(mi, 800, 2100, 2600)
    check(&t, i_high > i_low * 2, "i: energy at F2 (2290) beats 600-900 Hz")
    let vs: u64 = talk("s")
    let ms: u64 = vs / 2 - 400
    check(&t, band(ms, 800, 4000, 7000) > band(ms, 800, 100, 1000) * 5, "s: hiss, energy above 4 kHz")
    let vm: u64 = talk("m")
    let mm: u64 = vm / 2 - 400
    check(&t, band(mm, 800, 150, 500) > band(mm, 800, 3000, 6000) * 3, "m: low voiced hum")
    let vg: u64 = talk("a a")
    check(&t, longest_zero_run(vg) >= 1000, "word gap is real silence")


    de_says(&t, "Schule", "S u: l @")
    de_says(&t, "Straße", "S t R a: s @")
    de_says(&t, "Bach", "b a x")
    de_says(&t, "ich", "I C")
    de_says(&t, "Küche", "k Y C @")
    de_says(&t, "Fenster", "f E n s t @")
    de_says(&t, "Sprache", "S p R a x @")
    de_says(&t, "Vogel", "f o: g @ l")
    de_says(&t, "sieben", "z i: b @ n")
    de_says(&t, "Zeit", "t s a I t")
    de_says(&t, "Haus", "h a U s")
    de_says(&t, "Eule", "O I l @")
    de_says(&t, "Länge", "l E N @")
    de_says(&t, "Ding", "d I N")
    de_says(&t, "Tag", "t a: k")
    de_says(&t, "Hund", "h U n t")
    de_says(&t, "Zug", "t s u: k")
    de_says(&t, "König", "k 2: n I C")
    de_says(&t, "Wasser", "v a s @")
    de_says(&t, "Zahl", "t s a: l")
    de_says(&t, "ja", "j a:")
    de_says(&t, "Chemie", "C e: m i:")
    de_says(&t, "Wachs", "v a k s")
    de_says(&t, "Tisch", "t I S")
    de_says(&t, "Bett", "b E t")
    de_says(&t, "Mutter", "m U t @")
    de_says(&t, "Brot", "b R o: t")
    de_says(&t, "mit", "m I t")
    de_says(&t, "das", "d a s")
    de_says(&t, "weiß", "v a I s")
    de_says(&t, "groß", "g R o: s")
    de_says(&t, "zwölf", "t s v 9 l f")
    de_says(&t, "fünf", "f Y n f")
    de_says(&t, "Pfad", "p f a: t")
    de_says(&t, "Jahr", "j a: @")
    de_says(&t, "Uhr", "u: @")
    de_says(&t, "Stadt", "S t a t")
    de_says(&t, "Hilfe", "h I l f @")
    de_says(&t, "Menü", "m e: n y:")
    de_says(&t, "Datei", "d a: t a I")
    de_says(&t, "Öffnen", "9 f n @ n")
    de_says(&t, "Speichern", "S p a I C @ n")
    de_says(&t, "Passwort", "p a s v O @ t")
    de_says(&t, "Netzwerk", "n E t s v E @ k")
    de_says(&t, "Bildschirm", "b I l t S I @ m")
    de_says(&t, "Fehler", "f e: l @")
    de_says(&t, "Hallo", "h a l o:")
    de_says(&t, "gibt", "g I p t")
    de_says(&t, "Zehn", "t s e: n")
    de_says(&t, "Bank", "b a N k")
    de_says(&t, "Buch", "b u: x")
    de_says(&t, "null", "n U l")
    de_says(&t, "Datum", "d a: t U m")
    de_says(&t, "tausend", "t a U z @ n t")
    de_says(&t, "Information", "I n f O @ m a: t s j o: n")
    de_says(&t, "Verbinden", "f E @ b I n d @ n")
    de_says(&t, "geschützt", "g @ S Y t s t")
    de_says(&t, "Eingabe", "a I n g a: b @")
    de_says(&t, "Größe", "g R 2: s @")
    de_says(&t, "21", "a I n U n t t s v a n t s I C _")
    de_says(&t, "4", "f i: @ _")
    de_says(&t, "Das ist ein Test.", "d a s _ I s t _ a I n _ t E s t .")

    speechlang.set(speechlang.LANG_DE)
    say(3, 3, "Speichern")
    check(&t, is_s((&obuf[0 as usize]) as u64, "Speichern, Schaltfläche"), "de button: name, role")
    say(4, 1 + 32, "Merken")
    check(&t, is_s((&obuf[0 as usize]) as u64, "Merken, Kontrollkästchen, angehakt"), "de check box checked")
    say(3, 2, "Aus")
    check(&t, is_s((&obuf[0 as usize]) as u64, "Aus, Schaltfläche, nicht verfügbar"), "de disabled button")
    say(8, 1 + 8, "Dateien")
    check(&t, is_s((&obuf[0 as usize]) as u64, "Dateien, Tabelle, ausgewählt"), "de table selected")
    speaktext.describe(6, 1 + 64, (&canary[0 as usize]) as u64, (&obuf[0 as usize]) as u64, 256)
    check(&t, !has_sub((&obuf[0 as usize]) as u64, "GEHEIM") && has_sub((&obuf[0 as usize]) as u64, "Pw, Passwortfeld, geschützt"), "de protected node speaks nothing past the name")
    speaktext.window_intro(c("Notizen"), (&obuf[0 as usize]) as u64, 256)
    check(&t, is_s((&obuf[0 as usize]) as u64, "Notizen, Fenster"), "de window intro")
    let dn: u64 = talk("Schaltfläche")
    check(&t, dn > 5000 && peak(dn) <= 32000 && peak(dn) >= 2500, "de text audible, never clipped")
    let dlong: u64 = talk("Bahn")
    let dshort: u64 = talk("Bann")
    check(&t, dlong > dshort + 800, "de long vowel lasts longer than short vowel")
    let dy: u64 = talk("ü")
    let my: u64 = dy / 2 - 400
    check(&t, band(my, 800, 1700, 2100) > band(my, 800, 600, 1000) * 2, "de ü: energy near F2 1900 beats 600-1000 Hz")
    let dich: u64 = talk("ich")
    let ich_hi: u64 = band(dich - 1200, 800, 3000, 5000)
    let ich_lo: u64 = band(dich - 1200, 800, 300, 1200)
    let ich_sig: u64 = sum_sig(dich)
    check(&t, ich_hi > ich_lo * 2, "de ich-Laut: hiss above 3 kHz")
    let dach: u64 = talk("ach")
    check(&t, band(dach - 1200, 800, 1000, 2400) > band(dach - 1200, 800, 4500, 7000) * 3, "de ach-Laut: velar noise below 2.4 kHz")
    check(&t, sum_sig(dach) != ich_sig, "de ich and ach differ")
    let dz: u64 = talk("21")
    check(&t, dz > talk("1") + 6000, "de number 21 is a long word")
    check(&t, speechlang.select(c("de")) == 1 && speechlang.current() == 1, "select de")
    check(&t, speechlang.select(c("de_AT")) == 1, "select de_AT")
    check(&t, speechlang.select(c("deu")) == 0 && speechlang.select(c("fr")) == 0 && speechlang.select(c("en")) == 0, "other codes fall back to en")
    speechlang.set(speechlang.LANG_EN)

    io.fmt_print(f"checks={t.checks} fails={t.fails}\n")
    if t.fails > 0 {
        return 1
    }
    return 0
}
