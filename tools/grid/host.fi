// SPDX-License-Identifier: GPL-2.0-only
// tools/grid/host.fi -- dumps lib/fui/grid.fi on the build host as numeric rows
// "<group> <a> <b> <value>" (decimal); tools/grid/check.py asserts on them.
profile app
import rt.rt
import fui.grid

static mut ob: [u8; 64] = [0 as u8; 64]

fn put_num(at: u64, v: u64) -> u64 {
    var digits: u64 = 1
    var t: u64 = v
    while t >= 10 {
        t = t / 10
        digits = digits + 1
    }
    var k: u64 = 0
    var d: u64 = v
    while k < digits {
        __mmio_write8(((&ob[0 as usize]) as u64 + at + digits - 1 - k) as *mut u8, (48 + (d % 10)) as u8)
        d = d / 10
        k = k + 1
    }
    return at + digits
}

fn row(g: u64, a: u64, b: u64, v: u64) {
    var at: u64 = put_num(0, g)
    __mmio_write8(((&ob[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
    at = put_num(at + 1, a)
    __mmio_write8(((&ob[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
    at = put_num(at + 1, b)
    __mmio_write8(((&ob[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
    at = put_num(at + 1, v)
    __mmio_write8(((&ob[0 as usize]) as u64 + at) as *mut u8, 10 as u8)
    rt.write_everything(1, (&ob[0 as usize]) as u64, (at + 1) as usize)
}

fn main() -> i32 {
    var a: u64 = 0
    while a <= 1000 {
        row(1, a, 0, grid.grid_cols(a, 190, 12))
        a = a + 37
    }
    var n: u64 = 0
    while n <= 50 {
        var c: u64 = 1
        while c <= 5 {
            row(2, n, c, grid.grid_rows(n, c))
            row(3, n, c, grid.grid_content_h(n, c, 90, 12))
            c = c + 1
        }
        n = n + 1
    }
    var sc: u64 = 0
    while sc <= 600 {
        let f: u64 = grid.grid_first(sc, 3, 90, 12)
        row(4, sc, 0, f)
        row(5, sc, 200, grid.grid_count(40, f, 200, sc, 3, 90, 12))
        row(5, sc, 1, grid.grid_count(40, f, 1, sc, 3, 90, 12))
        sc = sc + 13
    }
    var i: u64 = 0
    while i < 40 {
        row(6, i, 0, grid.grid_scroll_to(i, 0, 200, 3, 90, 12))
        row(6, i, 100, grid.grid_scroll_to(i, 100, 200, 3, 90, 12))
        row(6, i, 500, grid.grid_scroll_to(i, 500, 200, 3, 90, 12))
        i = i + 1
    }
    n = 0
    while n <= 30 {
        var pp: u64 = 1
        while pp <= 7 {
            row(7, n, pp, grid.grid_pages(n, pp))
            var pg: u64 = 0
            while pg < 6 {
                row(8, n * 100 + pg, pp, grid.grid_page_count(n, pg, pp))
                pg = pg + 1
            }
            row(9, n, pp, grid.grid_page_of(n, pp) * 1000 + grid.grid_page_first(grid.grid_page_of(n, pp), pp))
            pp = pp + 1
        }
        n = n + 1
    }
    var k: u64 = 0
    while k < 4 {
        var nn: u64 = 1
        while nn <= 13 {
            var cc: u64 = 1
            while cc <= 4 {
                var j: u64 = 0
                while j < nn {
                    row(10, j * 10 + k, nn * 10 + cc, grid.grid_move(j, nn, cc, k))
                    j = j + 1
                }
                cc = cc + 1
            }
            nn = nn + 1
        }
        k = k + 1
    }
    row(11, 0, 0, grid.grid_cell_x(7, 3, 190, 12))
    row(11, 1, 0, grid.grid_cell_y(7, 3, 90, 12))
    return 0
}
