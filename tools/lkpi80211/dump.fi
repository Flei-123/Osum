import std.io
import wlan.macplan

static mut seed: u64 = 0x9E3779B97F4A7C15

fn rand() -> u64 {
    seed = seed ^ (seed << 13)
    seed = seed ^ (seed >> 7)
    seed = seed ^ (seed << 17)
    return seed
}

fn guided(phase: u64, rsn: bool) -> u64 {
    if phase == macplan.PH_DOWN { return macplan.EV_UP }
    if phase == macplan.PH_IDLE {
        if rand() % 3 == 0 { return macplan.EV_SCAN }
        if rsn { return macplan.EV_JOIN_RSN }
        return macplan.EV_JOIN_OPEN
    }
    if phase == macplan.PH_SCAN { return macplan.EV_SCAN_DONE }
    if phase == macplan.PH_JOIN { return macplan.EV_AUTH_OK }
    if phase == macplan.PH_AUTH { return macplan.EV_ASSOC_OK }
    if phase == macplan.PH_ASSOC {
        let r: u64 = rand() % 3
        if r == 0 { return macplan.EV_PTK }
        if r == 1 { return macplan.EV_GTK }
        return macplan.EV_AUTHORIZE
    }
    if rand() % 2 == 0 { return macplan.EV_LEAVE }
    return macplan.EV_DOWN
}

fn next_event(phase: u64) -> u64 {
    if rand() % 4 == 0 { return 1 + (rand() % 12) }
    return guided(phase, rand() % 2 == 0)
}

fn emit_event(p: *mut macplan.Plan, ev: u64) {
    macplan.plan_clear(p)
    let r: i64 = macplan.plan_event(p, ev)
    if r < 0 {
        io.fmt_print(f"ev {ev} -1\n")
        return
    }
    io.fmt_print(f"ev {ev} {macplan.plan_count(p)}")
    var i: usize = 0
    while i < macplan.plan_count(p) {
        let packed: u64 = macplan.plan_op(p, i) | (macplan.plan_arg(p, i) << 8)
        io.fmt_print(f" {packed}")
        i = i + 1
    }
    io.fmt_print(f"\n")
}

fn main() -> i32 {
    var plan: macplan.Plan = macplan.plan_new()
    let p: *mut macplan.Plan = &plan
    var k: u64 = 0
    while k < 6000 {
        emit_event(p, next_event(macplan.plan_phase(p)))
        k = k + 1
    }
    emit_event(p, macplan.EV_DOWN)
    return 0
}
