# tools/config -- DIE BAUKONFIGURATION VON OSUM.
#
# Bis zur Runde SERVERBUILD gab es keine. Ein Abbild entstand auf genau
# einem Weg, und dieser Weg hatte einen Bildschirm -- `grep -riE
# 'nogui|headless|console_only'` fand im ganzen Baum null Treffer.
#
# Hier steht, was fuer ALLE Baulaeufe gilt. Ein Schalter auf der
# Befehlszeile von `tools/build-kernel.sh` schlaegt diese Datei, und die
# Umgebungsvariable OSUM_GUI schlaegt sie ebenfalls -- die Reihenfolge
# ist: Befehlszeile > Umgebung > diese Datei > eingebaute Vorgabe.
#
# Leerzeilen und Zeilen mit '#' werden ueberlesen. Sonst: name=wert,
# ohne Leerzeichen um das Gleichheitszeichen.

# gui -- der Bildschirm.
#
#   on   Das Verhalten bis einschliesslich Runde MERGE-FINAL: Rahmen-
#        puffer, Fensterserver, TrueType, Kacheln, Bildmodus, Zeiger.
#        Das ist die VORGABE; kein bestehender Lauf aendert sich.
#
#   off  DER SERVERBAU. `kernel/drivers/gfx/fb.fi`, `wm.fi`, `wig.fi`, `font.fi`,
#        `ttf.fi`, `tile.fi`, `vmode.fi`, `ansi.fi`, `ps2m.fi`,
#        `kgui.fi` und `sysgui.fi` liegen dann NICHT im Uebersetzungs-
#        baum -- sie werden nicht abgeschaltet, sie werden nicht
#        uebersetzt. An der Stelle von `kernel/drivers/gfx/gfx.fi` steht
#        `kernel/drivers/gfx/gfx-aus.fi`, die dieselben 37 Symbole hat und nichts
#        tut. Die Konsole ist dann die serielle Leitung, und die ist
#        seit dieser Runde ein vollwertiges Terminal (Eingabe,
#        Zeilenbearbeitung, Steuerzeichen, `console=ttyS0`).
gui=on

# tunnel -- WireGuard und die Krypto darunter (Runde TUNNEL).
#
#   on   `kernel/wg.fi`
#   off  `kernel/wg-aus.fi` -- der Tunnel ist nicht vorhanden.
#
# Entspricht dem aelteren Schalter `--ohne-tunnel`, der weiter gilt.
tunnel=on
