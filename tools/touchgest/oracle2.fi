// SPDX-License-Identifier: GPL-2.0-only
// tools/touchgest/oracle2.fi -- host program for the TPSET options of lib/touchgest/gest.fi:
// tap switches, tap-and-drag, corner right click, scroll direction/speed/off, pinch off,
// scroll momentum, swipe action table. One "OK <name>" / "FAIL <name>" line per promise.
// Pad 1000 x 700 units: slop = 15, corner pct 25 = x >= 750 and y >= 525.

import std.rt
import std.io
import touchgest.gest

static mut a_sx: i64 = 0
static mut a_sy: i64 = 0
static mut a_nscroll: i64 = 0
static mut a_zoom: i64 = 0
static mut a_nclick: i64 = 0
static mut a_click: i64 = 0
static mut a_nmove: i64 = 0
static mut a_mx: i64 = 0
static mut a_drag_on: i64 = 0
static mut a_drag_off: i64 = 0

fn chk(name: str, cond: bool) {
    if cond {
        io.print("OK   ")
    } else {
        io.print("FAIL ")
    }
    io.print_line(name)
}

fn clear() {
    a_sx = 0
    a_sy = 0
    a_nscroll = 0
    a_zoom = 0
    a_nclick = 0
    a_click = 0
    a_nmove = 0
    a_mx = 0
    a_drag_on = 0
    a_drag_off = 0
}

fn collect() {
    var i: u64 = 0
    let n: u64 = gest.ev_count()
    while i < n {
        let k: u64 = gest.ev_kind(i)
        if k == gest.EV_MOVE {
            a_mx = a_mx + gest.ev_a(i)
            a_nmove = a_nmove + 1
        } else if k == gest.EV_SCROLL {
            a_sx = a_sx + gest.ev_a(i)
            a_sy = a_sy + gest.ev_b(i)
            a_nscroll = a_nscroll + 1
        } else if k == gest.EV_ZOOM {
            a_zoom = a_zoom + gest.ev_a(i)
        } else if k == gest.EV_CLICK {
            a_click = a_click | gest.ev_a(i)
            a_nclick = a_nclick + 1
        } else if k == gest.EV_DRAG {
            if gest.ev_a(i) == 1 {
                a_drag_on = a_drag_on + 1
            } else {
                a_drag_off = a_drag_off + 1
            }
        }
        i = i + 1
    }
}

fn fr(dev: u64, now: u64, n: u64, x0: i64, y0: i64, x1: i64, y1: i64, b: u64) {
    gest.begin(dev, now)
    if n >= 1 { gest.add_contact(1, x0, y0, 10) }
    if n >= 2 { gest.add_contact(2, x1, y1, 10) }
    gest.end(dev, b)
    collect()
}

fn tk(dev: u64, now: u64) {
    let _n: u64 = gest.tick(dev, now)
    collect()
}

fn fresh() {
    gest.reset(0)
    gest.reset(1)
    gest.configure(0, 1000, 700)
    gest.configure(1, 1000, 700)
    gest.set_edge(0, 10)
    gest.set_palm_size(0, 60)
    gest.set_tap_ms(0, 250)
    var o: u64 = 1
    while o < 11 {
        gest.set_opt(0, o, gest.get_opt(2, o))
        gest.set_opt(1, o, gest.get_opt(2, o))
        o = o + 1
    }
    clear()
}

// two fingers scrolling down by 10 units per frame for n frames from t0
fn scroll2(t0: u64, n: u64, step: i64) {
    var i: u64 = 0
    var y: i64 = 300
    fr(0, t0, 2, 400, y, 500, y, 0)
    while i < n {
        y = y + step
        fr(0, t0 + (i + 1) * 8, 2, 400, y, 500, y, 0)
        i = i + 1
    }
}

fn main() -> i32 {
    // dev 2 is never configured: it carries the defaults
    fresh()
    chk("default: tap on", gest.get_opt(0, gest.O_TAP) == 1)
    chk("default: two finger tap on", gest.get_opt(0, gest.O_TAP2) == 1)
    chk("default: tap-and-drag off", gest.get_opt(0, gest.O_DRAG) == 0)
    chk("default: scroll speed 100", gest.get_opt(0, gest.O_SCROLL_PCT) == 100)
    chk("default: drag window 300 ms", gest.get_opt(0, gest.O_DRAG_MS) == 300)
    gest.set_opt(0, gest.O_SCROLL_PCT, 9999)
    chk("scroll speed is clamped to 500", gest.get_opt(0, gest.O_SCROLL_PCT) == 500)
    gest.set_opt(0, gest.O_SCROLL_PCT, 1)
    chk("scroll speed is clamped to 10", gest.get_opt(0, gest.O_SCROLL_PCT) == 10)
    gest.set_opt(0, gest.O_CORNER, 80)
    chk("corner is clamped to 50", gest.get_opt(0, gest.O_CORNER) == 50)
    gest.set_opt(0, gest.O_TAP, 7)
    chk("a switch is 0 or 1", gest.get_opt(0, gest.O_TAP) == 1)
    gest.set_opt(9, gest.O_DRAG, 1)
    chk("an unknown device is ignored", gest.get_opt(9, gest.O_DRAG) == 0 && gest.get_opt(0, gest.O_DRAG) == 0)

    // ---- tap switches
    fresh()
    gest.set_opt(0, gest.O_TAP, 0)
    fr(0, 0, 1, 500, 300, 0, 0, 0)
    fr(0, 60, 0, 0, 0, 0, 0, 0)
    chk("tap off: a one finger tap does not click", a_nclick == 0)
    clear()
    fr(0, 200, 2, 400, 300, 500, 300, 0)
    fr(0, 260, 0, 0, 0, 0, 0, 0)
    chk("tap off: the two finger tap still right-clicks", a_nclick == 1 && a_click == 2)
    fresh()
    gest.set_opt(0, gest.O_TAP2, 0)
    fr(0, 0, 2, 400, 300, 500, 300, 0)
    fr(0, 60, 0, 0, 0, 0, 0, 0)
    chk("two finger tap off: no right click", a_nclick == 0)
    clear()
    fr(0, 200, 1, 500, 300, 0, 0, 0)
    fr(0, 240, 0, 0, 0, 0, 0, 0)
    chk("two finger tap off: the one finger tap still clicks", a_nclick == 1 && a_click == 1)

    // ---- double tap and tap-and-drag
    fresh()
    fr(0, 0, 1, 500, 300, 0, 0, 0)
    fr(0, 50, 0, 0, 0, 0, 0, 0)
    fr(0, 150, 1, 500, 300, 0, 0, 0)
    fr(0, 200, 0, 0, 0, 0, 0, 0)
    chk("double tap = two clicks", a_nclick == 2 && a_click == 1)
    chk("double tap: no drag", a_drag_on == 0)

    fresh()
    fr(0, 0, 1, 500, 300, 0, 0, 0)
    fr(0, 50, 0, 0, 0, 0, 0, 0)
    fr(0, 150, 1, 500, 300, 0, 0, 0)
    fr(0, 170, 1, 540, 300, 0, 0, 0)
    fr(0, 190, 1, 600, 300, 0, 0, 0)
    chk("drag off: the second touch is a plain move", a_drag_on == 0 && a_nmove > 0 && gest.out_buttons(0) == 0)

    fresh()
    gest.set_opt(0, gest.O_DRAG, 1)
    fr(0, 0, 1, 500, 300, 0, 0, 0)
    fr(0, 50, 0, 0, 0, 0, 0, 0)
    chk("drag on: the first tap clicks", a_nclick == 1)
    clear()
    fr(0, 150, 1, 500, 300, 0, 0, 0)
    chk("drag on: a still second touch starts nothing", a_drag_on == 0 && gest.out_buttons(0) == 0)
    fr(0, 170, 1, 540, 300, 0, 0, 0)
    chk("drag on: moving the second touch starts the drag once", a_drag_on == 1 && gest.dragging(0))
    chk("drag on: the left button is held", gest.out_buttons(0) == 1)
    fr(0, 190, 1, 600, 300, 0, 0, 0)
    fr(0, 210, 1, 660, 300, 0, 0, 0)
    chk("drag on: the pointer moves while held", a_mx > 60 && a_drag_on == 1 && gest.out_buttons(0) == 1)
    fr(0, 230, 0, 0, 0, 0, 0, 0)
    chk("drag on: lifting ends the drag", a_drag_off == 1 && !gest.dragging(0) && gest.out_buttons(0) == 0)
    chk("drag on: the drag adds no second click", a_nclick == 0)

    fresh()
    gest.set_opt(0, gest.O_DRAG, 1)
    fr(0, 0, 1, 500, 300, 0, 0, 0)
    fr(0, 50, 0, 0, 0, 0, 0, 0)
    fr(0, 500, 1, 500, 300, 0, 0, 0)
    fr(0, 520, 1, 560, 300, 0, 0, 0)
    chk("drag on: a second touch after the window is no drag", a_drag_on == 0)

    fresh()
    gest.set_opt(0, gest.O_DRAG, 1)
    fr(0, 0, 1, 500, 300, 0, 0, 0)
    fr(0, 50, 0, 0, 0, 0, 0, 0)
    fr(0, 150, 1, 500, 300, 0, 0, 0)
    fr(0, 170, 1, 540, 300, 0, 0, 0)
    fr(0, 190, 2, 540, 300, 640, 300, 0)
    chk("drag on: a second finger ends the drag", a_drag_on == 1 && a_drag_off == 1 && gest.out_buttons(0) == 0)

    fresh()
    gest.set_opt(0, gest.O_DRAG, 1)
    fr(0, 0, 1, 500, 300, 0, 0, 0)
    fr(0, 50, 0, 0, 0, 0, 0, 0)
    fr(0, 150, 1, 960, 300, 0, 0, 0)
    fr(0, 170, 1, 960, 360, 0, 0, 0)
    fr(0, 190, 1, 960, 420, 0, 0, 0)
    chk("drag on: an edge strip finger scrolls instead of dragging", a_drag_on == 0 && a_nscroll > 0)

    // ---- scroll direction and speed
    fresh()
    scroll2(0, 10, 12)
    let plain: i64 = a_sy
    chk("scroll: two fingers down gives positive y", plain > 0)
    fresh()
    gest.set_opt(0, gest.O_NATURAL, 1)
    scroll2(0, 10, 12)
    chk("natural: the scroll sum flips its sign", a_sy == 0 - plain)
    fresh()
    gest.set_opt(0, gest.O_SCROLL_PCT, 200)
    scroll2(0, 10, 12)
    chk("speed 200: twice the distance", a_sy == plain * 2)
    fresh()
    gest.set_opt(0, gest.O_SCROLL_PCT, 50)
    scroll2(0, 10, 12)
    chk("speed 50: half the distance (remainder kept)", a_sy == plain / 2 || a_sy == plain / 2 + 1 || a_sy == plain / 2 - 1)
    fresh()
    gest.set_opt(0, gest.O_SCROLL_PCT, 10)
    scroll2(0, 100, 1)
    chk("speed 10 with 1 unit steps still scrolls (no lost remainder)", a_sy > 0)
    fresh()
    gest.set_opt(0, gest.O_SCROLL, 0)
    scroll2(0, 10, 12)
    chk("scroll off: no scroll events", a_nscroll == 0)
    fresh()
    gest.set_opt(1, gest.O_NATURAL, 1)
    scroll2(0, 10, 12)
    chk("options belong to one device", a_sy == plain)

    // ---- pinch
    fresh()
    fr(0, 0, 2, 450, 300, 550, 300, 0)
    fr(0, 20, 2, 400, 300, 600, 300, 0)
    fr(0, 40, 2, 350, 300, 650, 300, 0)
    chk("pinch: spreading zooms", a_zoom > 0 && a_nscroll == 0)
    fresh()
    gest.set_opt(0, gest.O_PINCH, 0)
    fr(0, 0, 2, 450, 300, 550, 300, 0)
    fr(0, 20, 2, 400, 300, 600, 300, 0)
    fr(0, 40, 2, 350, 300, 650, 300, 0)
    chk("pinch off: no zoom and no scroll", a_zoom == 0 && a_nscroll == 0)

    // ---- corner right click
    fresh()
    gest.set_opt(0, gest.O_CORNER, 25)
    fr(0, 0, 1, 900, 650, 0, 0, 0)
    fr(0, 20, 1, 900, 650, 0, 0, 1)
    chk("corner: a press with the finger in the corner is the right button", gest.out_buttons(0) == 2)
    fr(0, 40, 1, 400, 200, 0, 0, 1)
    chk("corner: the mapping holds while the press lasts", gest.out_buttons(0) == 2)
    fr(0, 60, 1, 400, 200, 0, 0, 0)
    chk("corner: release gives no button", gest.out_buttons(0) == 0)
    fr(0, 80, 1, 400, 200, 0, 0, 1)
    chk("corner: a press elsewhere stays the left button", gest.out_buttons(0) == 1)
    fr(0, 100, 1, 900, 650, 0, 0, 1)
    chk("corner: moving into the corner during a press does not remap", gest.out_buttons(0) == 1)
    fresh()
    fr(0, 0, 1, 900, 650, 0, 0, 0)
    fr(0, 20, 1, 900, 650, 0, 0, 1)
    chk("corner off (default): the left button stays left", gest.out_buttons(0) == 1)
    fresh()
    gest.set_opt(0, gest.O_CORNER, 25)
    fr(0, 0, 2, 900, 650, 300, 200, 0)
    fr(0, 20, 2, 900, 650, 300, 200, 1)
    chk("corner: any finger in the corner counts", gest.out_buttons(0) == 2)

    // ---- momentum
    fresh()
    gest.set_opt(0, gest.O_MOMENTUM, 1)
    scroll2(0, 10, 12)
    let before: i64 = a_sy
    fr(0, 90, 0, 0, 0, 0, 0, 0)
    chk("momentum: lifting a fast scroll arms it", gest.momentum_on(0))
    clear()
    tk(0, 100)
    tk(0, 108)
    tk(0, 116)
    chk("momentum: ticks go on scrolling the same way", a_sy > 0 && a_nscroll > 0)
    var t: u64 = 124
    var tot: i64 = a_sy
    while t < 6000 && gest.momentum_on(0) {
        tk(0, t)
        t = t + 8
    }
    chk("momentum: it dies out by itself", !gest.momentum_on(0) && t < 6000)
    chk("momentum: the glide is a fraction of the touch distance", a_sy > 0 && a_sy < before * 8)
    tot = a_sy
    clear()
    tk(0, t + 8)
    chk("momentum: no events after it stopped", a_nscroll == 0 && tot > 0)

    fresh()
    gest.set_opt(0, gest.O_MOMENTUM, 1)
    scroll2(0, 10, 12)
    fr(0, 90, 0, 0, 0, 0, 0, 0)
    clear()
    fr(0, 100, 1, 300, 300, 0, 0, 0)
    chk("momentum: a new touch stops it", !gest.momentum_on(0))
    tk(0, 110)
    chk("momentum: a stopped glide gives no event", a_nscroll == 0)

    fresh()
    gest.set_opt(0, gest.O_MOMENTUM, 1)
    scroll2(0, 10, 12)
    fr(0, 400, 0, 0, 0, 0, 0, 0)
    chk("momentum: resting before the lift gives none", !gest.momentum_on(0))

    fresh()
    gest.set_opt(0, gest.O_MOMENTUM, 1)
    scroll2(0, 10, 1)
    fr(0, 90, 0, 0, 0, 0, 0, 0)
    chk("momentum: a slow scroll gives none", !gest.momentum_on(0))

    fresh()
    scroll2(0, 10, 12)
    fr(0, 90, 0, 0, 0, 0, 0, 0)
    chk("momentum off (default): nothing armed", !gest.momentum_on(0))

    fresh()
    gest.set_opt(0, gest.O_MOMENTUM, 1)
    gest.set_opt(0, gest.O_NATURAL, 1)
    scroll2(0, 10, 12)
    fr(0, 90, 0, 0, 0, 0, 0, 0)
    clear()
    tk(0, 100)
    tk(0, 108)
    tk(0, 116)
    chk("momentum follows the natural direction", a_sy < 0)

    // ---- swipe action table
    chk("apps mode: left = next window", gest.swipe_action(gest.M_APPS, 1) == gest.A_NEXT_WIN)
    chk("apps mode: right = previous window", gest.swipe_action(gest.M_APPS, 2) == gest.A_PREV_WIN)
    chk("apps mode: up = task view", gest.swipe_action(gest.M_APPS, 3) == gest.A_TASKVIEW)
    chk("apps mode: down = show desktop", gest.swipe_action(gest.M_APPS, 4) == gest.A_SHOW_DESKTOP)
    chk("desktops mode: left/right = virtual desktops", gest.swipe_action(gest.M_DESKTOPS, 1) == gest.A_DESK_NEXT && gest.swipe_action(gest.M_DESKTOPS, 2) == gest.A_DESK_PREV)
    chk("desktops mode: up/down as in apps mode", gest.swipe_action(gest.M_DESKTOPS, 3) == gest.A_TASKVIEW && gest.swipe_action(gest.M_DESKTOPS, 4) == gest.A_SHOW_DESKTOP)
    chk("off mode: nothing", gest.swipe_action(gest.M_OFF, 1) == gest.A_NONE && gest.swipe_action(gest.M_OFF, 3) == gest.A_NONE)
    chk("unknown direction: nothing", gest.swipe_action(gest.M_APPS, 9) == gest.A_NONE)
    return 0
}
