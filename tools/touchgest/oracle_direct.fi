import std.rt
import std.io
import touchgest.direct

static mut n_kind: [i64; 12] = [0; 12]
static mut s_a: [i64; 12] = [0; 12]
static mut s_b: [i64; 12] = [0; 12]
static mut l_a: [i64; 12] = [0; 12]
static mut l_b: [i64; 12] = [0; 12]
static mut l_c: [i64; 12] = [0; 12]
static mut total: i64 = 0

fn chk(name: str, cond: bool) {
    if cond {
        io.print("OK   ")
    } else {
        io.print("FAIL ")
    }
    io.print_line(name)
}

fn clear() {
    var i: usize = 0
    while i < 12 {
        n_kind[i] = 0
        s_a[i] = 0
        s_b[i] = 0
        l_a[i] = 0
        l_b[i] = 0
        l_c[i] = 0
        i = i + 1
    }
    total = 0
}

fn collect() {
    let n: u64 = direct.ev_count()
    var i: u64 = 0
    while i < n {
        let k: usize = direct.ev_kind(i) as usize
        n_kind[k] = n_kind[k] + 1
        s_a[k] = s_a[k] + direct.ev_a(i)
        s_b[k] = s_b[k] + direct.ev_b(i)
        l_a[k] = direct.ev_a(i)
        l_b[k] = direct.ev_b(i)
        l_c[k] = direct.ev_c(i)
        total = total + 1
        i = i + 1
    }
}

fn cnt(k: u64) -> i64 { return n_kind[k as usize] }
fn sum_a(k: u64) -> i64 { return s_a[k as usize] }
fn sum_b(k: u64) -> i64 { return s_b[k as usize] }
fn last_a(k: u64) -> i64 { return l_a[k as usize] }
fn last_b(k: u64) -> i64 { return l_b[k as usize] }
fn last_c(k: u64) -> i64 { return l_c[k as usize] }

fn fr(dev: u64, now: u64, n: u64, x0: i64, y0: i64, x1: i64, y1: i64, x2: i64, y2: i64) {
    direct.begin(dev, now)
    if n >= 1 { direct.add_contact(1, x0, y0, 10) }
    if n >= 2 { direct.add_contact(2, x1, y1, 10) }
    if n >= 3 { direct.add_contact(3, x2, y2, 10) }
    direct.end(dev)
    collect()
}

fn fr4(dev: u64, now: u64, x: i64, y: i64) {
    direct.begin(dev, now)
    direct.add_contact(1, x, y, 10)
    direct.add_contact(2, x + 50, y, 10)
    direct.add_contact(3, x + 100, y, 10)
    direct.add_contact(4, x + 150, y, 10)
    direct.end(dev)
    collect()
}

fn up(dev: u64, now: u64) {
    direct.begin(dev, now)
    direct.end(dev)
    collect()
}

fn set_defaults() {
    direct.set_opt(0, direct.O_ENABLED, 1)
    direct.set_opt(0, direct.O_SLOP_PX, 12)
    direct.set_opt(0, direct.O_LONG_MS, 650)
    direct.set_opt(0, direct.O_DTAP_MS, 300)
    direct.set_opt(0, direct.O_DTAP_PX, 32)
    direct.set_opt(0, direct.O_WHEEL_PX, 40)
    direct.set_opt(0, direct.O_NATURAL, 0)
    direct.set_opt(0, direct.O_PINCH, 1)
    direct.set_opt(0, direct.O_PINCH_STEP_PX, 48)
    direct.set_opt(0, direct.O_SWIPE, 1)
    direct.set_opt(0, direct.O_SWIPE_PX, 120)
    direct.set_opt(0, direct.O_HSCROLL, 1)
    direct.set_opt(0, direct.O_PALM_SIZE, 0)
    direct.set_opt(0, direct.O_LONG, 1)
}

fn begin_case() {
    direct.reset(0)
    direct.reset(1)
    set_defaults()
    clear()
}

fn main() -> i32 {
    direct.reset(0)
    chk("default enabled", direct.get_opt(0, direct.O_ENABLED) == 1)
    chk("default slop 12 px", direct.get_opt(3, direct.O_SLOP_PX) == 12)
    chk("default long press 650 ms", direct.get_opt(3, direct.O_LONG_MS) == 650)
    chk("default wheel step 40 px", direct.get_opt(3, direct.O_WHEEL_PX) == 40)
    chk("default natural off", direct.get_opt(3, direct.O_NATURAL) == 0)
    direct.set_opt(2, direct.O_SLOP_PX, 9999)
    chk("slop is clamped to its maximum", direct.get_opt(2, direct.O_SLOP_PX) == 200)
    direct.set_opt(2, direct.O_SLOP_PX, 0)
    chk("slop is clamped to its minimum", direct.get_opt(2, direct.O_SLOP_PX) == 1)
    direct.set_opt(2, direct.O_SLOP_PX, 12)
    chk("unknown option reads 0", direct.get_opt(0, 15) == 0)
    chk("device out of range reads 0", direct.get_opt(9, direct.O_SLOP_PX) == 0)

    begin_case()
    fr(0, 1000, 1, 500, 300, 0, 0, 0, 0)
    chk("first finger down: one DOWN at the point", cnt(direct.EV_DOWN) == 1 && last_a(direct.EV_DOWN) == 500 && last_b(direct.EV_DOWN) == 300)
    chk("finger on: in_touch and 1 finger", direct.in_touch(0) && direct.fingers(0) == 1 && direct.phase(0) == direct.P_DOWN)
    fr(0, 1020, 1, 500, 300, 0, 0, 0, 0)
    chk("resting finger: no new DOWN", cnt(direct.EV_DOWN) == 1)
    up(0, 1100)
    chk("short touch: one TAP", cnt(direct.EV_TAP) == 1 && last_c(direct.EV_TAP) == 1)
    chk("tap carries the last position", last_a(direct.EV_TAP) == 500 && last_b(direct.EV_TAP) == 300)
    chk("tap: no drag, no long press", cnt(direct.EV_DRAG_BEGIN) == 0 && cnt(direct.EV_LONG) == 0)
    chk("after lift: idle", !direct.in_touch(0) && direct.fingers(0) == 0)
    up(0, 1200)
    chk("a second lift frame adds nothing", cnt(direct.EV_TAP) == 1)

    begin_case()
    fr(0, 0, 1, 100, 100, 0, 0, 0, 0)
    up(0, 649)
    chk("649 ms is still a tap", cnt(direct.EV_TAP) == 1 && cnt(direct.EV_LONG) == 0)
    begin_case()
    fr(0, 0, 1, 100, 100, 0, 0, 0, 0)
    up(0, 650)
    chk("650 ms is a long press, not a tap", cnt(direct.EV_LONG) == 1 && cnt(direct.EV_TAP) == 0)
    chk("long press carries the position", last_a(direct.EV_LONG) == 100 && last_b(direct.EV_LONG) == 100)

    begin_case()
    fr(0, 0, 1, 400, 400, 0, 0, 0, 0)
    fr(0, 20, 1, 410, 405, 0, 0, 0, 0)
    fr(0, 40, 1, 396, 393, 0, 0, 0, 0)
    up(0, 100)
    chk("wobble inside the slop circle is still a tap", cnt(direct.EV_TAP) == 1 && cnt(direct.EV_DRAG_BEGIN) == 0)

    begin_case()
    fr(0, 0, 1, 400, 400, 0, 0, 0, 0)
    fr(0, 20, 1, 413, 400, 0, 0, 0, 0)
    chk("13 px away starts a drag at the START point", cnt(direct.EV_DRAG_BEGIN) == 1 && last_a(direct.EV_DRAG_BEGIN) == 400 && last_b(direct.EV_DRAG_BEGIN) == 400)
    chk("drag begin is followed by a DRAG at the current point", cnt(direct.EV_DRAG) == 1 && last_a(direct.EV_DRAG) == 413)
    chk("dragging() is true", direct.dragging(0) && direct.phase(0) == direct.P_DRAG)
    fr(0, 40, 1, 500, 420, 0, 0, 0, 0)
    fr(0, 60, 1, 600, 440, 0, 0, 0, 0)
    chk("every frame is one DRAG", cnt(direct.EV_DRAG) == 3 && last_a(direct.EV_DRAG) == 600 && last_b(direct.EV_DRAG) == 440)
    up(0, 80)
    chk("lift ends the drag once at the last point", cnt(direct.EV_DRAG_END) == 1 && last_a(direct.EV_DRAG_END) == 600 && last_b(direct.EV_DRAG_END) == 440)
    chk("a drag is no tap", cnt(direct.EV_TAP) == 0 && cnt(direct.EV_LONG) == 0)

    begin_case()
    fr(0, 0, 1, 400, 400, 0, 0, 0, 0)
    fr(0, 700, 1, 480, 400, 0, 0, 0, 0)
    chk("slow start then move: still a drag", cnt(direct.EV_DRAG_BEGIN) == 1)
    up(0, 720)
    chk("slow drag ends as a drag, never as a long press", cnt(direct.EV_DRAG_END) == 1 && cnt(direct.EV_LONG) == 0)

    begin_case()
    fr(0, 0, 1, 400, 400, 0, 0, 0, 0)
    fr(0, 20, 1, 450, 400, 0, 0, 0, 0)
    direct.begin(0, 40)
    direct.add_contact(1, 480, 400, 10)
    direct.add_contact(2, 700, 700, 10)
    direct.end(0)
    collect()
    chk("a second finger during a drag is ignored", direct.dragging(0) && cnt(direct.EV_WHEEL) == 0 && cnt(direct.EV_PINCH) == 0)
    chk("the drag follows the leading finger", last_a(direct.EV_DRAG) == 480)
    direct.begin(0, 60)
    direct.add_contact(2, 700, 700, 10)
    direct.end(0)
    collect()
    chk("when the leading finger lifts the other one leads", last_a(direct.EV_DRAG) == 700 && direct.dragging(0))

    begin_case()
    fr(0, 0, 1, 300, 300, 0, 0, 0, 0)
    chk("tick before the long press time: nothing", direct.tick(0, 600) == 0)
    chk("tick at the long press time: one LONG", direct.tick(0, 650) == 1 && direct.ev_kind(0) == direct.EV_LONG && direct.ev_a(0) == 300)
    chk("tick fires only once", direct.tick(0, 700) == 0)
    up(0, 800)
    chk("lift after a ticked long press: no tap", cnt(direct.EV_TAP) == 0 && cnt(direct.EV_LONG) == 0)
    begin_case()
    fr(0, 0, 1, 300, 300, 0, 0, 0, 0)
    direct.tick(0, 650)
    fr(0, 700, 1, 400, 300, 0, 0, 0, 0)
    chk("moving after a long press does not start a drag", cnt(direct.EV_DRAG_BEGIN) == 0)

    begin_case()
    direct.set_opt(0, direct.O_LONG, 0)
    fr(0, 0, 1, 300, 300, 0, 0, 0, 0)
    chk("long press off: tick does nothing", direct.tick(0, 5000) == 0)
    up(0, 5100)
    chk("long press off: a slow touch is a tap", cnt(direct.EV_TAP) == 1 && cnt(direct.EV_LONG) == 0)

    begin_case()
    fr(0, 0, 1, 200, 200, 0, 0, 0, 0)
    up(0, 80)
    fr(0, 200, 1, 210, 205, 0, 0, 0, 0)
    up(0, 280)
    chk("second tap close in time and place: tap count 2", cnt(direct.EV_TAP) == 2 && last_c(direct.EV_TAP) == 2)
    fr(0, 400, 1, 205, 200, 0, 0, 0, 0)
    up(0, 470)
    chk("third tap: tap count 3", last_c(direct.EV_TAP) == 3)
    fr(0, 600, 1, 205, 200, 0, 0, 0, 0)
    up(0, 660)
    chk("fourth tap wraps to 1", last_c(direct.EV_TAP) == 1)

    begin_case()
    fr(0, 0, 1, 200, 200, 0, 0, 0, 0)
    up(0, 80)
    fr(0, 500, 1, 200, 200, 0, 0, 0, 0)
    up(0, 560)
    chk("second tap too late: count 1", last_c(direct.EV_TAP) == 1)
    begin_case()
    fr(0, 0, 1, 200, 200, 0, 0, 0, 0)
    up(0, 80)
    fr(0, 200, 1, 400, 200, 0, 0, 0, 0)
    up(0, 260)
    chk("second tap far away: count 1", last_c(direct.EV_TAP) == 1)
    begin_case()
    direct.set_opt(0, direct.O_DTAP_MS, 100)
    fr(0, 0, 1, 200, 200, 0, 0, 0, 0)
    up(0, 80)
    fr(0, 200, 1, 200, 200, 0, 0, 0, 0)
    up(0, 260)
    chk("double tap window is an option", last_c(direct.EV_TAP) == 1)

    begin_case()
    fr(0, 0, 2, 1000, 800, 1200, 800, 0, 0)
    chk("two fingers landing: no event", direct.ev_count() == 0 && direct.phase(0) == direct.P_TWO && direct.fingers(0) == 2)
    fr(0, 20, 2, 1000, 870, 1200, 870, 0, 0)
    chk("70 px down: scroll locked, one notch down", direct.phase(0) == direct.P_SCROLL && cnt(direct.EV_WHEEL) == 1 && sum_b(direct.EV_WHEEL) == -1)
    chk("scroll carries the pixel delta for apps", sum_b(direct.EV_SCROLL) == 70 && sum_a(direct.EV_SCROLL) == 0)
    fr(0, 40, 2, 1000, 940, 1200, 940, 0, 0)
    fr(0, 60, 2, 1000, 1010, 1200, 1010, 0, 0)
    chk("210 px in total: five notches, remainder kept", sum_b(direct.EV_WHEEL) == -5)
    up(0, 80)
    chk("scroll ends without tap, long press or drag", cnt(direct.EV_TAP) == 0 && cnt(direct.EV_LONG) == 0 && cnt(direct.EV_DRAG_BEGIN) == 0)

    begin_case()
    fr(0, 0, 2, 1000, 800, 1200, 800, 0, 0)
    fr(0, 20, 2, 1000, 730, 1200, 730, 0, 0)
    chk("fingers up: wheel the other way", sum_b(direct.EV_WHEEL) == 1)
    begin_case()
    direct.set_opt(0, direct.O_NATURAL, 1)
    fr(0, 0, 2, 1000, 800, 1200, 800, 0, 0)
    fr(0, 20, 2, 1000, 870, 1200, 870, 0, 0)
    chk("natural option flips the wheel", sum_b(direct.EV_WHEEL) == 1)

    begin_case()
    fr(0, 0, 2, 1000, 800, 1200, 800, 0, 0)
    fr(0, 20, 2, 920, 800, 1120, 800, 0, 0)
    chk("sideways scroll: horizontal notches, none vertical", sum_a(direct.EV_WHEEL) == 2 && sum_b(direct.EV_WHEEL) == 0)
    begin_case()
    direct.set_opt(0, direct.O_HSCROLL, 0)
    fr(0, 0, 2, 1000, 800, 1200, 800, 0, 0)
    fr(0, 20, 2, 920, 800, 1120, 800, 0, 0)
    chk("sideways scroll off: no horizontal notch", sum_a(direct.EV_WHEEL) == 0)

    begin_case()
    fr(0, 0, 2, 1000, 800, 1200, 800, 0, 0)
    fr(0, 20, 2, 1000, 805, 1200, 805, 0, 0)
    chk("5 px of motion is below the slop: no lock, no event", direct.phase(0) == direct.P_TWO && cnt(direct.EV_WHEEL) == 0 && cnt(direct.EV_SCROLL) == 0)
    fr(0, 40, 2, 1000, 840, 1200, 840, 0, 0)
    chk("motion since the anchor counts once locked", sum_b(direct.EV_WHEEL) == -1 && sum_b(direct.EV_SCROLL) == 40)

    begin_case()
    fr(0, 0, 2, 1000, 800, 1200, 800, 0, 0)
    fr(0, 20, 2, 950, 800, 1250, 800, 0, 0)
    chk("spreading with a still centroid: pinch lock", direct.phase(0) == direct.P_PINCH && cnt(direct.EV_PINCH) == 1)
    chk("pinch: +100 px, two steps of 48", sum_a(direct.EV_PINCH) == 100 && sum_b(direct.EV_PINCH) == 2)
    fr(0, 40, 2, 900, 800, 1300, 800, 0, 0)
    chk("pinch accumulates the remainder: 200 px, four steps", sum_a(direct.EV_PINCH) == 200 && sum_b(direct.EV_PINCH) == 4)
    fr(0, 60, 2, 1000, 800, 1200, 800, 0, 0)
    chk("pinching in: negative steps", sum_a(direct.EV_PINCH) == 0 && sum_b(direct.EV_PINCH) < 4)
    chk("pinch never scrolls", cnt(direct.EV_WHEEL) == 0)
    up(0, 80)
    chk("pinch ends without a tap", cnt(direct.EV_TAP) == 0)

    begin_case()
    direct.set_opt(0, direct.O_PINCH, 0)
    fr(0, 0, 2, 1000, 800, 1200, 800, 0, 0)
    fr(0, 20, 2, 950, 800, 1250, 800, 0, 0)
    chk("pinch off: no pinch events", cnt(direct.EV_PINCH) == 0 && direct.phase(0) == direct.P_SCROLL)

    begin_case()
    fr(0, 0, 2, 1000, 800, 1200, 800, 0, 0)
    fr(0, 20, 2, 1000, 870, 1200, 870, 0, 0)
    direct.begin(0, 40)
    direct.add_contact(1, 1000, 900, 10)
    direct.end(0)
    collect()
    chk("one finger lifted during a scroll: gestures stop", direct.phase(0) == direct.P_DONE)
    fr(0, 60, 1, 1000, 1000, 0, 0, 0, 0)
    chk("no drag, no wheel after the stop", cnt(direct.EV_DRAG_BEGIN) == 0 && sum_b(direct.EV_WHEEL) == -1)
    up(0, 80)
    chk("no tap after a scroll", cnt(direct.EV_TAP) == 0)
    fr(0, 200, 1, 100, 100, 0, 0, 0, 0)
    up(0, 250)
    chk("a new touch after that works again", cnt(direct.EV_TAP) == 1)

    begin_case()
    fr(0, 0, 3, 500, 500, 600, 500, 700, 500)
    chk("three fingers: swipe phase, no event yet", direct.phase(0) == direct.P_SWIPE && direct.ev_count() == 0)
    fr(0, 20, 3, 400, 500, 500, 500, 600, 500)
    chk("100 px left is below the swipe length", cnt(direct.EV_SWIPE) == 0)
    fr(0, 40, 3, 370, 500, 470, 500, 570, 500)
    chk("130 px left: one SWIPE left with 3 fingers", cnt(direct.EV_SWIPE) == 1 && last_a(direct.EV_SWIPE) == 1 && last_b(direct.EV_SWIPE) == 3)
    fr(0, 60, 3, 100, 500, 200, 500, 300, 500)
    chk("a swipe fires once per touch", cnt(direct.EV_SWIPE) == 1)
    up(0, 80)

    begin_case()
    fr(0, 0, 3, 500, 500, 600, 500, 700, 500)
    fr(0, 20, 3, 650, 500, 750, 500, 850, 500)
    chk("150 px right: swipe right", last_a(direct.EV_SWIPE) == 2)
    begin_case()
    fr(0, 0, 3, 500, 500, 600, 500, 700, 500)
    fr(0, 20, 3, 500, 340, 600, 340, 700, 340)
    chk("160 px up: swipe up", last_a(direct.EV_SWIPE) == 3)
    begin_case()
    fr(0, 0, 3, 500, 500, 600, 500, 700, 500)
    fr(0, 20, 3, 500, 660, 600, 660, 700, 660)
    chk("160 px down: swipe down", last_a(direct.EV_SWIPE) == 4)
    begin_case()
    fr4(0, 0, 500, 500)
    fr4(0, 20, 300, 500)
    chk("four fingers report n=4", last_b(direct.EV_SWIPE) == 4 && last_a(direct.EV_SWIPE) == 1)
    begin_case()
    direct.set_opt(0, direct.O_SWIPE, 0)
    fr(0, 0, 3, 500, 500, 600, 500, 700, 500)
    fr(0, 20, 3, 300, 500, 400, 500, 500, 500)
    chk("swipe off: no event", cnt(direct.EV_SWIPE) == 0)
    begin_case()
    direct.set_opt(0, direct.O_SWIPE_PX, 300)
    fr(0, 0, 3, 500, 500, 600, 500, 700, 500)
    fr(0, 20, 3, 300, 500, 400, 500, 500, 500)
    chk("swipe length is an option", cnt(direct.EV_SWIPE) == 0)

    begin_case()
    direct.set_opt(0, direct.O_PALM_SIZE, 60)
    direct.begin(0, 0)
    direct.add_contact(1, 500, 500, 80)
    direct.end(0)
    collect()
    chk("a palm alone is no touch", total == 0 && direct.fingers(0) == 0)
    direct.begin(0, 20)
    direct.add_contact(1, 500, 500, 80)
    direct.add_contact(2, 100, 100, 10)
    direct.end(0)
    collect()
    chk("palm plus finger counts as one finger", direct.fingers(0) == 1 && cnt(direct.EV_DOWN) == 1 && last_a(direct.EV_DOWN) == 100)

    begin_case()
    direct.set_opt(0, direct.O_ENABLED, 0)
    fr(0, 0, 1, 100, 100, 0, 0, 0, 0)
    up(0, 50)
    chk("disabled: no events at all", total == 0)
    direct.set_opt(0, direct.O_ENABLED, 1)
    fr(0, 100, 1, 100, 100, 0, 0, 0, 0)
    up(0, 150)
    chk("enabled again: tap works", cnt(direct.EV_TAP) == 1)

    begin_case()
    fr(0, 0, 1, 100, 100, 0, 0, 0, 0)
    direct.begin(1, 5)
    direct.add_contact(1, 900, 900, 10)
    direct.end(1)
    chk("device 1 starts its own touch", direct.in_touch(1) && direct.in_touch(0) && direct.fingers(1) == 1)
    direct.begin(1, 10)
    direct.end(1)
    up(0, 60)
    chk("devices keep separate state", cnt(direct.EV_TAP) == 1 && !direct.in_touch(1))

    begin_case()
    direct.reset(0)
    chk("reset ends a running touch", !direct.in_touch(0) && direct.fingers(0) == 0)
    direct.begin(0, 0)
    direct.add_contact(1, 1, 1, 1)
    direct.add_contact(2, 1, 1, 1)
    direct.add_contact(3, 1, 1, 1)
    direct.add_contact(4, 1, 1, 1)
    direct.add_contact(5, 1, 1, 1)
    direct.add_contact(6, 1, 1, 1)
    direct.end(0)
    chk("a sixth contact is dropped", direct.fingers(0) == 5)
    direct.begin(0, 10)
    direct.end(1)
    chk("end(dev) with a different dev than begin does not run", direct.fingers(0) == 5)
    direct.reset(0)

    return 0
}
