// SPDX-License-Identifier: GPL-2.0-only
// tools/touchgest/oracle.fi -- host program that drives lib/touchgest/gest.fi
// with SYNTHETIC finger frames and prints one "OK <name>" or "FAIL <name>"
// line per promise. Built and run by tools/touchgest/run.sh.
//
// Pad 1000 x 700 units: slop = 15, swipe length = 166, edge strips start
// at x >= 900 (right) and y >= 630 (bottom), palm size threshold 60.

import std.rt
import std.io
import touchgest.gest

// accumulated events since the last clear()
static mut a_mx: i64 = 0
static mut a_my: i64 = 0
static mut a_nmove: i64 = 0
static mut a_sx: i64 = 0
static mut a_sy: i64 = 0
static mut a_zoom: i64 = 0
static mut a_click: i64 = 0      // bitmask of clicked buttons
static mut a_nclick: i64 = 0
static mut a_swipes: i64 = 0
static mut a_dir: i64 = 0
static mut a_sn: i64 = 0

fn chk(name: str, cond: bool) {
    if cond {
        io.print("OK   ")
    } else {
        io.print("FAIL ")
    }
    io.print_line(name)
}

fn clear() {
    a_mx = 0
    a_my = 0
    a_nmove = 0
    a_sx = 0
    a_sy = 0
    a_zoom = 0
    a_click = 0
    a_nclick = 0
    a_swipes = 0
    a_dir = 0
    a_sn = 0
}

fn collect() {
    var i: u64 = 0
    let n: u64 = gest.ev_count()
    while i < n {
        let k: u64 = gest.ev_kind(i)
        if k == gest.EV_MOVE {
            a_mx = a_mx + gest.ev_a(i)
            a_my = a_my + gest.ev_b(i)
            a_nmove = a_nmove + 1
        } else if k == gest.EV_SCROLL {
            a_sx = a_sx + gest.ev_a(i)
            a_sy = a_sy + gest.ev_b(i)
        } else if k == gest.EV_ZOOM {
            a_zoom = a_zoom + gest.ev_a(i)
        } else if k == gest.EV_CLICK {
            a_click = a_click | gest.ev_a(i)
            a_nclick = a_nclick + 1
        } else if k == gest.EV_SWIPE {
            a_swipes = a_swipes + 1
            a_dir = gest.ev_a(i)
            a_sn = gest.ev_b(i)
        }
        i = i + 1
    }
}

// one frame with n fingers (ids 1..3, size 10), buttons b
fn fr(dev: u64, now: u64, n: u64, x0: i64, y0: i64, x1: i64, y1: i64, x2: i64, y2: i64, b: u64) {
    gest.begin(dev, now)
    if n >= 1 { gest.add_contact(1, x0, y0, 10) }
    if n >= 2 { gest.add_contact(2, x1, y1, 10) }
    if n >= 3 { gest.add_contact(3, x2, y2, 10) }
    gest.end(dev, b)
    collect()
}

fn fresh() {
    gest.reset(0)
    gest.reset(1)
    gest.configure(0, 1000, 700)
    gest.configure(1, 1000, 700)
    gest.set_edge(0, 10)
    gest.set_palm_size(0, 60)
    gest.set_tap_ms(0, 250)
    clear()
}

fn main() -> i32 {
    // ---- geometry facts the rest relies on
    fresh()
    chk("slop of a 1000-wide pad is 15", gest.slop(0) == 15)
    chk("swipe length of a 1000-wide pad is 166", gest.swipe_len(0) == 166)

    // ---- taps
    fresh()
    fr(0, 0, 1, 500, 300, 0, 0, 0, 0, 0)
    fr(0, 20, 1, 500, 300, 0, 0, 0, 0, 0)
    fr(0, 100, 0, 0, 0, 0, 0, 0, 0, 0)
    chk("one finger tap = left click", a_nclick == 1 && a_click == 1)
    chk("one finger tap: no pointer motion", a_nmove == 0)

    fresh()
    fr(0, 0, 1, 500, 300, 0, 0, 0, 0, 0)
    fr(0, 400, 0, 0, 0, 0, 0, 0, 0, 0)
    chk("a slow touch (400 ms) is no tap", a_nclick == 0)

    fresh()
    fr(0, 0, 1, 500, 300, 0, 0, 0, 0, 0)
    fr(0, 250, 0, 0, 0, 0, 0, 0, 0, 0)
    chk("tap at exactly tap_ms still clicks", a_nclick == 1)
    fresh()
    fr(0, 0, 1, 500, 300, 0, 0, 0, 0, 0)
    fr(0, 251, 0, 0, 0, 0, 0, 0, 0, 0)
    chk("tap one ms over tap_ms does not click", a_nclick == 0)

    fresh()
    fr(0, 0, 1, 500, 300, 0, 0, 0, 0, 0)
    fr(0, 20, 1, 506, 296, 0, 0, 0, 0, 0)
    fr(0, 40, 1, 497, 304, 0, 0, 0, 0, 0)
    fr(0, 90, 0, 0, 0, 0, 0, 0, 0, 0)
    chk("wobble inside the slop circle is still a tap", a_nclick == 1 && a_nmove == 0)

    fresh()
    fr(0, 0, 2, 400, 300, 500, 300, 0, 0, 0)
    fr(0, 30, 2, 400, 300, 500, 300, 0, 0, 0)
    fr(0, 90, 0, 0, 0, 0, 0, 0, 0, 0)
    chk("two finger tap = right click", a_nclick == 1 && a_click == 2)

    fresh()
    fr(0, 0, 3, 400, 300, 500, 300, 600, 300, 0)
    fr(0, 50, 3, 400, 300, 500, 300, 600, 300, 0)
    fr(0, 100, 0, 0, 0, 0, 0, 0, 0, 0)
    chk("three finger tap = middle click", a_nclick == 1 && a_click == 4)

    fresh()
    fr(0, 0, 1, 500, 300, 0, 0, 0, 0, 0)
    fr(0, 30, 1, 500, 300, 0, 0, 0, 0, 1)
    fr(0, 80, 0, 0, 0, 0, 0, 0, 0, 0)
    chk("a physical button during the touch cancels the tap", a_nclick == 0)

    // ---- pointer
    fresh()
    var k: i64 = 1
    while k <= 10 {
        fr(0, (k * 10) as u64, 1, 500 + k * 10, 300, 0, 0, 0, 0, 0)
        k = k + 1
    }
    chk("pointer: slop swallowed, rest delivered exactly (70)", a_mx == 70 && a_my == 0)
    fr(0, 200, 0, 0, 0, 0, 0, 0, 0, 0)
    chk("a moved finger does not tap on lift", a_nclick == 0)

    fresh()
    k = 1
    while k <= 8 {
        fr(0, (k * 10) as u64, 1, 500 - k * 10, 300 + k * 5, 0, 0, 0, 0, 0)
        k = k + 1
    }
    chk("pointer: negative direction keeps its sign", a_mx < 0 && a_my > 0)

    // ---- two finger scroll
    fresh()
    k = 1
    while k <= 12 {
        fr(0, (k * 10) as u64, 2, 400, 300 + k * 10, 500, 300 + k * 10, 0, 0, 0)
        k = k + 1
    }
    chk("two finger scroll: vertical sum 70", a_sy == 70 && a_sx == 0)
    chk("two finger scroll: no zoom, no pointer", a_zoom == 0 && a_nmove == 0)
    fr(0, 200, 0, 0, 0, 0, 0, 0, 0, 0)
    chk("two finger scroll: no click on lift", a_nclick == 0)

    // ---- pinch
    fresh()
    k = 1
    while k <= 10 {
        fr(0, (k * 10) as u64, 2, 400 - k * 5, 300, 600 + k * 5, 300, 0, 0, 0)
        k = k + 1
    }
    chk("pinch out: zoom sum 50 after the lock", a_zoom == 50)
    chk("pinch out: no scroll", a_sx == 0 && a_sy == 0)
    fresh()
    k = 1
    while k <= 10 {
        fr(0, (k * 10) as u64, 2, 300 + k * 5, 300, 700 - k * 5, 300, 0, 0, 0)
        k = k + 1
    }
    chk("pinch in: negative zoom", a_zoom < 0 && a_sx == 0 && a_sy == 0)

    // ---- three finger swipe
    fresh()
    k = 1
    while k <= 8 {
        fr(0, (k * 10) as u64, 3, 600 - k * 50, 300, 700 - k * 50, 300, 800 - k * 50, 300, 0)
        k = k + 1
    }
    chk("swipe left fires once", a_swipes == 1 && a_dir == 1 && a_sn == 3)
    fresh()
    k = 1
    while k <= 8 {
        fr(0, (k * 10) as u64, 3, 200 + k * 50, 300, 300 + k * 50, 300, 400 + k * 50, 300, 0)
        k = k + 1
    }
    chk("swipe right", a_swipes == 1 && a_dir == 2)
    fresh()
    k = 1
    while k <= 8 {
        fr(0, (k * 10) as u64, 3, 400, 600 - k * 50, 500, 600 - k * 50, 600, 600 - k * 50, 0)
        k = k + 1
    }
    chk("swipe up", a_swipes == 1 && a_dir == 3)
    fresh()
    k = 1
    while k <= 8 {
        fr(0, (k * 10) as u64, 3, 400, 100 + k * 50, 500, 100 + k * 50, 600, 100 + k * 50, 0)
        k = k + 1
    }
    chk("swipe down", a_swipes == 1 && a_dir == 4)
    fr(0, 300, 0, 0, 0, 0, 0, 0, 0, 0)
    chk("a swipe is no tap", a_nclick == 0)
    fresh()
    k = 1
    while k <= 2 {
        fr(0, (k * 10) as u64, 3, 400 - k * 20, 300, 500 - k * 20, 300, 600 - k * 20, 300, 0)
        k = k + 1
    }
    chk("three fingers below the swipe length: nothing", a_swipes == 0)

    // ---- edge strips
    fresh()
    k = 1
    while k <= 10 {
        fr(0, (k * 10) as u64, 1, 950, 200 + k * 10, 0, 0, 0, 0, 0)
        k = k + 1
    }
    chk("right edge strip scrolls vertically (70)", a_sy == 70 && a_sx == 0)
    chk("right edge strip: no pointer motion", a_nmove == 0)
    fresh()
    k = 1
    while k <= 10 {
        fr(0, (k * 10) as u64, 1, 300 + k * 10, 670, 0, 0, 0, 0, 0)
        k = k + 1
    }
    chk("bottom edge strip scrolls horizontally (70)", a_sx == 70 && a_sy == 0)
    fresh()
    gest.set_edge(0, 0)
    k = 1
    while k <= 10 {
        fr(0, (k * 10) as u64, 1, 950, 200 + k * 10, 0, 0, 0, 0, 0)
        k = k + 1
    }
    chk("edge strips off: the same stroke moves the pointer", a_my == 70 && a_sy == 0)
    fresh()
    k = 1
    while k <= 10 {
        fr(0, (k * 10) as u64, 1, 800, 200 + k * 10, 0, 0, 0, 0, 0)
        k = k + 1
    }
    chk("outside the strip a stroke is the pointer", a_my == 70 && a_sy == 0)

    // ---- palm rejection
    fresh()
    gest.begin(0, 0)
    gest.add_contact(7, 100, 600, 90)
    gest.end(0, 0)
    chk("big contact is a palm, not a finger", gest.fingers(0) == 0 && gest.palms(0) == 1)
    gest.begin(0, 50)
    gest.end(0, 0)
    collect()
    chk("a lone palm never taps", a_nclick == 0)
    fresh()
    k = 1
    while k <= 10 {
        gest.begin(0, (k * 10) as u64)
        gest.add_contact(7, 100, 600, 90)
        gest.add_contact(1, 500 + k * 10, 300, 10)
        gest.end(0, 0)
        collect()
        k = k + 1
    }
    chk("palm + finger: only the finger moves the pointer (70)", a_mx == 70 && a_sx == 0 && a_sy == 0)
    chk("palm + finger count", gest.fingers(0) == 1 && gest.palms(0) == 1)
    fresh()
    gest.note_key(0, 1000)
    gest.begin(0, 1100)
    gest.add_contact(1, 500, 300, 10)
    gest.end(0, 0)
    chk("contact 100 ms after a key press is a palm", gest.fingers(0) == 0 && gest.palms(0) == 1)
    gest.begin(0, 1200)
    gest.end(0, 0)
    gest.begin(0, 1400)
    gest.add_contact(2, 500, 300, 10)
    gest.end(0, 0)
    chk("contact 400 ms after a key press is a finger", gest.fingers(0) == 1 && gest.palms(0) == 0)

    // ---- phase change: no jump when a finger lifts
    fresh()
    k = 1
    while k <= 8 {
        fr(0, (k * 10) as u64, 2, 400, 300 + k * 10, 600, 300 + k * 10, 0, 0, 0)
        k = k + 1
    }
    clear()
    fr(0, 100, 1, 600, 380, 0, 0, 0, 0, 0)
    fr(0, 110, 1, 603, 382, 0, 0, 0, 0, 0)
    chk("2 -> 1 fingers: no pointer jump", a_nmove == 0 && a_mx == 0)
    fr(0, 120, 1, 640, 382, 0, 0, 0, 0, 0)
    fr(0, 130, 1, 650, 382, 0, 0, 0, 0, 0)
    chk("2 -> 1 fingers: the remaining finger moves the pointer again", a_mx == 10)

    // ---- devices are independent
    fresh()
    k = 1
    while k <= 6 {
        fr(0, (k * 10) as u64, 2, 400, 300 + k * 10, 500, 300 + k * 10, 0, 0, 0)
        k = k + 1
    }
    gest.begin(1, 65)
    gest.add_contact(1, 500, 300, 10)
    gest.end(1, 0)
    gest.begin(1, 80)
    gest.end(1, 0)
    collect()
    chk("device 1 tap is a click while device 0 is mid-scroll", a_nclick == 1 && a_click == 1)
    chk("device 0 still in its touch", gest.in_touch(0) && !gest.in_touch(1))
    while k <= 12 {
        fr(0, (k * 10 + 20) as u64, 2, 400, 300 + k * 10, 500, 300 + k * 10, 0, 0, 0)
        k = k + 1
    }
    chk("device 0 scroll goes on undisturbed (sum 70)", a_sy == 70 && a_sx == 0)

    return 0
}
