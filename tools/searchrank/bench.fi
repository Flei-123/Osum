import std.rt
import std.io
import fui.searchrank

const ROUNDS: u64 = 4000
const APPS: u64 = 24
const QUERIES: u64 = 8

static mut cbuf: [u8; 4096] = [0 as u8; 4096]

fn c(slot: usize, s: str) -> u64 {
    let base: usize = slot * 128
    var i: usize = 0
    while i < s.length() && i < 127 {
        cbuf[base + i] = *((s.p as u64 + i as u64) as *mut u8)
        i = i + 1
    }
    cbuf[base + i] = 0 as u8
    return ((&cbuf[0 as usize]) as u64) + base as u64
}

fn main() -> i32 {
    let names: [u64; 4] = [c(0, "Remote control"), c(1, "Firefox"), c(2, "Terminal"), c(3, "Settings")]
    let infos: [u64; 4] = [c(4, "Let another device see and control this computer"), c(5, "Web browser"), c(6, "A command prompt with a shell"), c(7, "System settings")]
    let keys: [u64; 4] = [c(8, "remote,host,x-remote,fernsteuerung,fernzugriff,teamviewer"), c(9, "firefox,browser,web,internet,www,mozilla,surf"), c(10, "terminal,konsole,shell,sh,eingabe,befehl,kommando,prompt"), c(11, "settings,einstellungen,system,konfiguration")]
    let queries: [u64; 8] = [c(12, "xremote"), c(13, "x-remote"), c(14, "fernst"), c(15, "firfox"), c(16, "fire"), c(17, "term"), c(18, "einst"), c(19, "zzqqx")]
    var sum: u64 = 0
    var r: u64 = 0
    while r < ROUNDS {
        var q: u64 = 0
        while q < QUERIES {
            searchrank.set_query(queries[q as usize])
            var a: u64 = 0
            while a < APPS {
                let k: usize = (a % 4) as usize
                sum = sum + searchrank.tier_fields(names[k], infos[k], keys[k], true)
                a = a + 1
            }
            q = q + 1
        }
        r = r + 1
    }
    io.fmt_print(f"searches={ROUNDS * QUERIES} checksum={sum}\n")
    return 0
}
