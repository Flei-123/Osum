import std.rt
import std.io
import fui.searchrank
import search.learn
import search.fold
import search.typo

struct T {
    fails: i32,
    checks: i32,
}

static mut cbuf: [u8; 2048] = [0 as u8; 2048]
static mut cslot: usize = 0

fn c(s: str) -> u64 {
    let base: usize = (cslot % 32) * 64
    cslot = cslot + 1
    var i: usize = 0
    while i < s.length() && i < 63 {
        cbuf[base + i] = *((s.p as u64 + i as u64) as *mut u8)
        i = i + 1
    }
    cbuf[base + i] = 0 as u8
    return ((&cbuf[0 as usize]) as u64) + base as u64
}

fn check(t: *mut T, ok: bool, what: str) {
    (*t).checks = (*t).checks + 1
    if ok {
        io.fmt_print(f"ok   {what}\n")
    } else {
        io.fmt_print(f"FAIL {what}\n")
        (*t).fails = (*t).fails + 1
    }
}

struct Item {
    name: u64,
    key: u64,
}

static mut items: [Item; 16] = [Item { name: 0, key: 0 }; 16]

fn sort_items(n: usize) {
    var i: usize = 1
    while i < n {
        let cur: Item = items[i]
        var j: usize = i
        while j > 0 && searchrank.key_before(cur.key, cur.name, items[j - 1].key, items[j - 1].name) {
            items[j] = items[j - 1]
            j = j - 1
        }
        items[j] = cur
        i = i + 1
    }
}

fn add_app(n: usize, name: str, info: str, keys: str, q: str, uses: u64, def: bool) -> usize {
    let tier: u64 = searchrank.fields_tier(c(name), c(info), c(keys), c(q), true)
    if tier == searchrank.NO_MATCH {
        return n
    }
    items[n] = Item { name: c(name), key: searchrank.rank_key(searchrank.CAT_APP, tier, uses, def) }
    return n + 1
}

fn add_file(n: usize, name: str, q: str) -> usize {
    let tier: u64 = searchrank.name_tier(c(name), c(q))
    if tier == searchrank.NO_MATCH {
        return n
    }
    items[n] = Item { name: c(name), key: searchrank.rank_key(searchrank.CAT_FILE, tier, 0, false) }
    return n + 1
}

fn is_name(p: u64, s: str) -> bool {
    var i: usize = 0
    while i < s.length() {
        if rt.ld8(p, i) != rt.ld8(s.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return rt.ld8(p, i) == 0 as u8
}

fn main() -> i32 {
    var t: T = T { fails: 0, checks: 0 }
    let no: u64 = searchrank.NO_MATCH
    check(&t, searchrank.name_tier(c("certus"), c("certus")) == searchrank.T_EXACT, "exact name")
    check(&t, searchrank.name_tier(c("Certus"), c("CERTUS")) == searchrank.T_EXACT, "exact ignores case")
    check(&t, searchrank.name_tier(c("Certus"), c("cer")) == searchrank.T_PREFIX, "prefix")
    check(&t, searchrank.name_tier(c("Task Manager"), c("man")) == searchrank.T_WORD, "word start")
    check(&t, searchrank.name_tier(c("my-certus.txt"), c("certus")) == searchrank.T_WORD, "word start after dash")
    check(&t, searchrank.name_tier(c("Tattoo"), c("too")) == searchrank.T_SUBSTR, "substring")
    check(&t, searchrank.name_tier(c("spinatus"), c("certus")) == no, "spinatus no match for certus")
    check(&t, searchrank.name_tier(c("tattoo"), c("certus")) == no, "tattoo no match for certus")
    check(&t, searchrank.name_tier(c("ab"), c("abc")) == no, "query longer than name")
    check(&t, searchrank.name_tier(c("abc"), c("")) == no, "empty query")

    let keys: u64 = c("browser,certus,web,internet")
    check(&t, searchrank.fields_tier(c("Certus"), c("View pages"), keys, c("certus"), true) == searchrank.T_EXACT, "app exact")
    check(&t, searchrank.fields_tier(c("Certus"), c("View pages"), keys, c("brow"), true) == searchrank.T_KEYWORD, "keyword prefix")
    check(&t, searchrank.fields_tier(c("Certus"), c("View pages"), keys, c("pages"), true) == searchrank.T_INFO, "info substring")
    check(&t, searchrank.fields_tier(c("Certus"), c("View pages"), keys, c("ctz"), true) == no, "short fuzzy needs 3 letters and same first letter")
    check(&t, searchrank.fields_tier(c("Certus"), c("x"), c("x"), c("cts"), true) == searchrank.T_FUZZY, "fuzzy subsequence")
    check(&t, searchrank.fields_tier(c("Certus"), c("x"), c("x"), c("cts"), false) == no, "fuzzy off")
    check(&t, searchrank.fields_tier(c("Certus"), c("x"), c("x"), c("ets"), true) == no, "fuzzy needs first letter")

    var n: usize = 0
    n = add_file(n, "spinatus", "certus")
    n = add_file(n, "certus.txt", "certus")
    n = add_file(n, "tattoo", "certus")
    n = add_app(n, "Charmap", "Characters", "char,zeichen", "certus", 0, false)
    n = add_app(n, "Certus", "View pages", "browser,certus", "certus", 0, false)
    n = add_app(n, "Certus Helper", "Helps", "helper", "certus", 0, false)
    sort_items(n)
    check(&t, is_name(items[0].name, "Certus"), "certus: app Certus first")
    check(&t, is_name(items[1].name, "Certus Helper"), "certus: prefix app second")
    check(&t, is_name(items[2].name, "certus.txt"), "certus: matching file after apps")
    var first_file: usize = 99
    var last_app: usize = 1
    var k: usize = 0
    while k < 3 {
        if is_name(items[k].name, "certus.txt") {
            first_file = k
        }
        k = k + 1
    }
    check(&t, first_file > last_app, "files never before apps")

    n = 0
    n = add_app(n, "Notes", "Edit notes", "text", "n", 0, false)
    n = add_app(n, "Nova", "Viewer", "image", "n", 0, false)
    n = add_app(n, "Nano", "Editor", "text", "n", 0, false)
    sort_items(n)
    check(&t, is_name(items[0].name, "Nano") && is_name(items[1].name, "Notes") && is_name(items[2].name, "Nova"), "alphabet tie-break")

    n = 0
    n = add_app(n, "Notes", "Edit notes", "text", "n", 0, false)
    n = add_app(n, "Nova", "Viewer", "image", "n", 5, false)
    n = add_app(n, "Nano", "Editor", "text", "n", 0, false)
    sort_items(n)
    check(&t, is_name(items[0].name, "Nova"), "more used first")

    n = 0
    n = add_app(n, "Nano", "Editor", "text", "n", 3, false)
    n = add_app(n, "Nova", "Viewer", "image", "n", 3, true)
    sort_items(n)
    check(&t, is_name(items[0].name, "Nova"), "default app wins equal use")

    n = 0
    n = add_app(n, "Nano", "Editor", "text", "no", 255, false)
    n = add_app(n, "Nova", "Viewer", "image", "no", 0, true)
    n = add_app(n, "No", "Exact", "x", "no", 0, false)
    sort_items(n)
    check(&t, is_name(items[0].name, "No"), "tier beats usage")

    n = 0
    n = add_file(n, "readme.md", "read")
    n = add_app(n, "Zed", "Edits files to read", "z", "read", 0, false)
    sort_items(n)
    check(&t, is_name(items[0].name, "Zed"), "info-only app beats prefix file")

    check(&t, searchrank.is_default_token(c("certus"), c("/bin/certus")), "default token matches handler basename")
    check(&t, !searchrank.is_default_token(c("cert"), c("/bin/certus")), "default token needs full basename")
    check(&t, !searchrank.is_default_token(c("certus"), c("")), "default token empty handler")
    check(&t, searchrank.name_before(c("abc"), c("abd")), "alphabet before")
    check(&t, !searchrank.name_before(c("abc"), c("ABC")), "alphabet equal ignores case")


    let rkeys: u64 = c("remote,host,x-remote,fernsteuerung,fernzugriff,teamviewer")
    let rinfo: u64 = c("Let another device see and control this computer")
    check(&t, searchrank.fields_tier(c("Remote control"), rinfo, rkeys, c("xremote"), true) == searchrank.T_KEYWORD, "xremote finds X-Remote via keyword")
    check(&t, searchrank.fields_tier(c("Remote control"), rinfo, rkeys, c("x-remote"), true) == searchrank.T_KEYWORD, "x-remote finds X-Remote")
    check(&t, searchrank.fields_tier(c("Remote control"), rinfo, rkeys, c("X Remote"), true) == searchrank.T_KEYWORD, "X Remote finds X-Remote")
    check(&t, searchrank.fields_tier(c("Remote control"), rinfo, rkeys, c("fernst"), true) == searchrank.T_KEYWORD, "fernst finds X-Remote")
    check(&t, searchrank.fields_tier(c("Remote control"), rinfo, rkeys, c("teamviewer"), true) == searchrank.T_KEYWORD, "synonym teamviewer")
    check(&t, searchrank.fields_tier(c("Remote control"), rinfo, rkeys, c("remotecontrol"), true) == searchrank.T_EXACT, "separators ignored in names")
    check(&t, searchrank.fields_tier(c("Remote control"), rinfo, rkeys, c("rc"), true) == searchrank.T_ACRONYM, "acronym of the name words")
    check(&t, searchrank.fields_tier(c("Remote control"), rinfo, rkeys, c("control"), true) == searchrank.T_WORD, "word start")
    let fkeys: u64 = c("firefox,browser,web,internet,www,mozilla,surf")
    let finfo: u64 = c("Web browser")
    check(&t, searchrank.fields_tier(c("Firefox"), finfo, fkeys, c("firfox"), true) == searchrank.T_TYPO, "typo missing letter")
    check(&t, searchrank.fields_tier(c("Firefox"), finfo, fkeys, c("frefox"), true) == searchrank.T_TYPO, "typo missing letter 2")
    check(&t, searchrank.fields_tier(c("Firefox"), finfo, fkeys, c("fierfox"), true) == searchrank.T_TYPO, "typo transposition")
    check(&t, searchrank.fields_tier(c("Firefox"), finfo, fkeys, c("fire"), true) == searchrank.T_PREFIX, "prefix fire")
    check(&t, searchrank.fields_tier(c("Firefox"), finfo, fkeys, c("browser"), true) == searchrank.T_KEYWORD, "synonym browser")
    check(&t, searchrank.fields_tier(c("Firefox"), finfo, fkeys, c("zzzz"), true) == no, "no match for noise")
    check(&t, searchrank.fields_tier(c("Terminal"), c("Shell"), c("terminal,konsole"), c("treminal"), true) == searchrank.T_TYPO, "typo swap")
    check(&t, searchrank.fields_tier(c("Terminal"), c("Shell"), c("terminal,konsole"), c("konsolle"), true) == searchrank.T_TYPO, "typo in keyword")
    check(&t, searchrank.fields_tier(c("Terminal"), c("Shell"), c("terminal,konsole"), c("konsolle"), false) == no, "typo needs fuzzy on")
    check(&t, searchrank.fields_tier(c("Settings"), c("System"), c("settings,einstellungen"), c("einst"), true) == searchrank.T_KEYWORD, "keyword prefix finds settings")
    check(&t, searchrank.name_tier(c("Gr\u{f6}\u{df}e"), c("groesse")) == searchrank.T_EXACT, "umlaut and sharp s fold")
    check(&t, searchrank.name_tier(c("B\u{e4}r"), c("baer")) == searchrank.T_EXACT, "ae fold")
    check(&t, searchrank.name_tier(c("Baer"), c("b\u{e4}r")) == searchrank.T_EXACT, "ae fold reverse")
    check(&t, searchrank.name_tier(c("caf\u{e9}"), c("cafe")) == searchrank.T_EXACT, "accent fold")
    check(&t, searchrank.name_tier(c("my_file-name.txt"), c("myfile")) == searchrank.T_PREFIX, "underscore dash dot ignored")
    check(&t, searchrank.T_EXACT < searchrank.T_PREFIX && searchrank.T_PREFIX < searchrank.T_WORD && searchrank.T_WORD < searchrank.T_ACRONYM && searchrank.T_ACRONYM < searchrank.T_SUBSTR && searchrank.T_SUBSTR < searchrank.T_KEYWORD && searchrank.T_KEYWORD < searchrank.T_TYPO && searchrank.T_TYPO < searchrank.T_INFO, "tier order")
    check(&t, searchrank.learned_tier(searchrank.T_TYPO, true) == searchrank.T_LEARNED, "learned promotes a match")
    check(&t, searchrank.learned_tier(searchrank.NO_MATCH, true) == no, "learned never promotes a non-match")
    check(&t, typo.prefix_distance(c("firfox"), 6, c("firefox"), 7) == 1, "prefix distance 1")
    check(&t, typo.prefix_distance(c("fire"), 4, c("firefox"), 7) == 0, "prefix distance 0")
    check(&t, typo.max_edits(3) == 0 && typo.max_edits(5) == 1 && typo.max_edits(8) == 2, "edit budget by length")

    learn.reset()
    learn.set_enabled(true)
    let h0: u64 = 1000
    learn.record(c("te"), c("terminal"), h0)
    check(&t, learn.usage_bonus(c("terminal"), h0) > 0, "start raises the usage bonus")
    check(&t, !learn.is_pinned(c("te"), c("terminal"), h0), "one pick does not pin")
    learn.record(c("te"), c("terminal"), h0)
    check(&t, learn.is_pinned(c("te"), c("terminal"), h0), "two picks pin the query")
    check(&t, learn.is_pinned(c("ter"), c("terminal"), h0), "longer query keeps the pin")
    check(&t, !learn.is_pinned(c("t"), c("terminal"), h0), "shorter query is not pinned")
    check(&t, !learn.is_pinned(c("xe"), c("terminal"), h0), "other prefix not pinned")
    check(&t, !learn.is_pinned(c("te"), c("editor"), h0), "other token not pinned")
    check(&t, learn.query_score(c("te"), c("terminal"), h0 + 168) < learn.query_score(c("te"), c("terminal"), h0) * 6 / 10, "half life one week")
    check(&t, learn.query_score(c("te"), c("terminal"), h0 + 168 * 3) < learn.PIN_SCORE, "pin decays after weeks")
    check(&t, learn.usage_bonus(c("terminal"), h0) <= learn.BONUS_CAP, "bonus capped")
    var i: usize = 0
    while i < 40 {
        learn.record(c(""), c("terminal"), h0)
        i = i + 1
    }
    check(&t, learn.usage_bonus(c("terminal"), h0) == learn.BONUS_CAP, "bonus reaches cap and stays")
    learn.record(c("ed"), c("editor"), h0 + 1)
    var order: [u64; 4] = [0 as u64; 4]
    let top: u64 = learn.top_usage((&order[0 as usize]) as u64, 4, h0 + 1)
    check(&t, top == 2 && is_name(learn.usage_token(order[0 as usize]), "terminal"), "empty query suggests most used first")
    var file: [u8; 4096] = [0 as u8; 4096]
    let fb: u64 = (&file[0 as usize]) as u64
    let flen: u64 = learn.serialize(fb, 4096)
    learn.reset()
    check(&t, learn.usage_count() == 0, "reset clears usage")
    learn.parse(fb, flen)
    check(&t, learn.usage_count() == 2 && learn.is_pinned(c("te"), c("terminal"), h0 + 1), "file round trip")
    learn.parse(c("x\nu\nq a\nu b!d 5 5\nq te tm 99999999999999999999 5\nu good 1 2\n"), 60)
    check(&t, learn.usage_count() == 1 && learn.query_score(c("te"), c("tm"), 5) == 1000000, "broken file keeps valid lines only")
    learn.parse(c(""), 0)
    check(&t, learn.usage_count() == 0 && learn.enabled(), "empty file is a clean start")
    learn.set_enabled(false)
    learn.record(c("te"), c("terminal"), h0)
    check(&t, learn.usage_bonus(c("terminal"), h0) == 0 && learn.usage_count() == 0, "learning off records nothing")
    let off_len: u64 = learn.serialize(fb, 4096)
    learn.set_enabled(true)
    learn.parse(fb, off_len)
    check(&t, !learn.enabled(), "off state survives the file")
    learn.set_enabled(true)
    io.fmt_print(f"checks={t.checks} fails={t.fails}\n")
    if t.fails != 0 {
        return 1
    }
    return 0
}
