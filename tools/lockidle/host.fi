// SPDX-License-Identifier: GPL-2.0-only
// tools/lockidle/host.fi -- dumps lib/fui/lockidle.fi on the build host: "<group> <a> <value>" rows.
// Group 1: secs_of(level) for level 0..8; group 2: level_of(secs) for a list of stored numbers;
// group 3: LEVELS and DEFAULT_SECS. tools/lockidle/run.sh asserts on them.
profile app
import rt.rt
import fui.lockidle

static mut ob: [u8; 64] = [0 as u8; 64]

fn put_num(at: u64, v: u64) -> u64 {
    var digits: u64 = 1
    var t: u64 = v
    while t >= 10 {
        t = t / 10
        digits = digits + 1
    }
    var k: u64 = 0
    var d: u64 = v
    while k < digits {
        __mmio_write8(((&ob[0 as usize]) as u64 + at + digits - 1 - k) as *mut u8, (48 + (d % 10)) as u8)
        d = d / 10
        k = k + 1
    }
    return at + digits
}

fn row(g: u64, a: u64, v: u64) {
    var at: u64 = put_num(0, g)
    __mmio_write8(((&ob[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
    at = put_num(at + 1, a)
    __mmio_write8(((&ob[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
    at = put_num(at + 1, v)
    __mmio_write8(((&ob[0 as usize]) as u64 + at) as *mut u8, 10 as u8)
    rt.write_everything(1, (&ob[0 as usize]) as u64, (at + 1) as usize)
}

fn main() -> i32 {
    var l: u64 = 0
    while l < 9 {
        row(1, l, lockidle.secs_of(l))
        l = l + 1
    }
    var probes: [u64; 12] = [0, 1, 25, 60, 90, 119, 240, 300, 600, 1000, 1800, 86400]
    var i: u64 = 0
    while i < 12 {
        row(2, probes[i as usize], lockidle.level_of(probes[i as usize]))
        i = i + 1
    }
    row(3, 0, lockidle.LEVELS)
    row(3, 1, lockidle.DEFAULT_SECS)
    return 0
}
