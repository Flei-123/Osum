// SPDX-License-Identifier: GPL-2.0-only
// tools/fvviewer/it.fi -- test driver for lib/fv/input.fi (driven by inputtest.py).
//
//   it key <code> <mod>                              -> hex of every wire message, space separated
//   it seq <code>:<mod> ...                          -> hex of every wire message of the whole key sequence
//                                                       (decoder state is kept between the keys), one line per key
//   it retry <err> <ever_live 0|1> <ask 0|1> <attempt>   -> seconds before the next try (0 = none)
//   it backoff <attempt>                              -> seconds
//   it trim <hex>                                     -> length after utf8_trim
//   it ptr <px> <py> <bx> <by> <bw> <bh> <rw> <rh> <zoom>  -> "x y" (0..10000) or "outside"
import std.io
import std.rt
import fv.input
import fv.retry

fn put_hex(p: u64, n: u64) {
    let d: [u8; 16] = "0123456789abcdef"
    var two: [u8; 2] = [0 as u8; 2]
    var i: u64 = 0
    while i < n {
        let b: u8 = rt.ld8(p, i as usize)
        two[0] = d[(b >> 4) as usize]
        two[1] = d[(b & 15 as u8) as usize]
        io.print_bytes((&two[0]) as u64, 2)
        i = i + 1
    }
}

fn pu(v: u64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, v)
    rt.write_everything(1, b.ptr, b.len)
    rt.buf_free(&b)
}

fn num(start: u64, i: usize) -> u64 {
    let a: u64 = rt.arg_ptr(start, i)
    let n: usize = rt.c_length(a)
    var k: usize = 0
    var v: u64 = 0
    while k < n {
        v = v * 10 + ((rt.ld8(a, k) - 48 as u8) as u64)
        k = k + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        io.print("usage: it key <code> <mod> | ptr ...\n")
        return 2
    }
    let c1: u8 = rt.ld8(rt.arg_ptr(start, 1), 0)
    if c1 == 115 as u8 {
        // seq
        var out2: [u8; 256] = [0 as u8; 256]
        var lens2: [u8; 16] = [0 as u8; 16]
        var a: usize = 2
        while a < rt.arg_count(start) {
            let s: u64 = rt.arg_ptr(start, a)
            var code: u64 = 0
            var i: usize = 0
            while rt.ld8(s, i) != 58 as u8 {
                code = code * 10 + ((rt.ld8(s, i) - 48 as u8) as u64)
                i = i + 1
            }
            i = i + 1
            var md: u64 = 0
            while i < rt.c_length(s) {
                md = md * 10 + ((rt.ld8(s, i) - 48 as u8) as u64)
                i = i + 1
            }
            let n: u64 = input.key_msgs((&out2[0]) as u64, (&lens2[0]) as u64, code, md)
            var j: u64 = 0
            while j < n {
                if j > 0 {
                    io.print(" ")
                }
                put_hex((&out2[0]) as u64 + j * input.SLOT, lens2[j as usize] as u64)
                j = j + 1
            }
            io.print("\n")
            a = a + 1
        }
        return 0
    }
    if c1 == 114 as u8 {
        let ev: u64 = num(start, 5) // attempt
        let kind: u64 = retry.kind_of(num(start, 2), 0, 0)
        pu(retry.next_retry_s(kind, num(start, 3) != 0, num(start, 4) != 0, ev))
        io.print("\n")
        return 0
    }
    if c1 == 98 as u8 {
        pu(retry.backoff_s(num(start, 2)))
        io.print("\n")
        return 0
    }
    if c1 == 116 as u8 {
        // trim <hex>
        var buf: [u8; 64] = [0 as u8; 64]
        let h: u64 = rt.arg_ptr(start, 2)
        let hl: u64 = rt.c_length(h) as u64
        var k: u64 = 0
        while k + 1 < hl {
            var v: u64 = 0
            var q: u64 = 0
            while q < 2 {
                let ch: u64 = rt.ld8(h, (k + q) as usize) as u64
                var d: u64 = ch - 48
                if ch >= 97 { d = ch - 87 }
                v = v * 16 + d
                q = q + 1
            }
            buf[(k / 2) as usize] = v as u8
            k = k + 2
        }
        pu(input.utf8_trim((&buf[0]) as u64, hl / 2))
        io.print("\n")
        return 0
    }
    if c1 == 107 as u8 {
        var out: [u8; 256] = [0 as u8; 256]
        var lens: [u8; 16] = [0 as u8; 16]
        let n: u64 = input.key_msgs((&out[0]) as u64, (&lens[0]) as u64, num(start, 2), num(start, 3))
        var i: u64 = 0
        while i < n {
            if i > 0 {
                io.print(" ")
            }
            put_hex((&out[0]) as u64 + i * input.SLOT, lens[i as usize] as u64)
            i = i + 1
        }
        io.print("\n")
        return 0
    }
    var r: input.Rect = input.rect_new()
    input.view_rect(num(start, 4), num(start, 5), num(start, 6), num(start, 7),
        num(start, 8), num(start, 9), num(start, 10), &r)
    var xy: [u64; 2] = [0; 2]
    if input.map_pointer(num(start, 2), num(start, 3), &r, (&xy[0])) {
        pu(xy[0])
        io.print(" ")
        pu(xy[1])
        io.print("\n")
    } else {
        io.print("outside\n")
    }
    return 0
}
