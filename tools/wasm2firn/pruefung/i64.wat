(module
  (import "wasi_snapshot_preview1" "fd_write" (func $fw (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $ex (param i32)))
  (memory 1)
  (export "memory" (memory 0))
  (data (i32.const 500) "OK\n")
  (data (i32.const 510) "FEHLER\n")
  (func $p (param $x i32) (param $y i32)
    (if (i32.eq (local.get $x) (local.get $y))
      (then (i32.store (i32.const 100) (i32.const 500)) (i32.store (i32.const 104) (i32.const 3)))
      (else (i32.store (i32.const 100) (i32.const 510)) (i32.store (i32.const 104) (i32.const 7))))
    (drop (call $fw (i32.const 1) (i32.const 100) (i32.const 1) (i32.const 120))))
  (func $p64 (param $x i64) (param $y i64) (call $p (i64.eq (local.get $x) (local.get $y)) (i32.const 1)))
  (func (export "_start")
    (call $p64 (i64.extend_i32_s (i32.const -1)) (i64.const -1))
    (call $p64 (i64.extend_i32_u (i32.const -1)) (i64.const 4294967295))
    (call $p64 (i64.shr_s (i64.const -8) (i64.const 2)) (i64.const -2))
    (call $p64 (i64.shr_u (i64.const -1) (i64.const 32)) (i64.const 4294967295))
    (call $p64 (i64.div_s (i64.const -7) (i64.const 2)) (i64.const -3))
    (call $p64 (i64.rem_s (i64.const -7) (i64.const 2)) (i64.const -1))
    (call $p64 (i64.mul (i64.const 4294967296) (i64.const 4294967296)) (i64.const 0))
    (call $p64 (i64.sub (i64.const 0) (i64.const 1)) (i64.const -1))
    (call $p64 (i64.rotl (i64.const 1) (i64.const 63)) (i64.const -9223372036854775808))
    (call $p64 (i64.clz (i64.const 1)) (i64.const 63))
    (call $p64 (i64.ctz (i64.const 8)) (i64.const 3))
    (call $p64 (i64.popcnt (i64.const -1)) (i64.const 64))
    (call $p (i64.lt_s (i64.const -1) (i64.const 1)) (i32.const 1))
    (call $p (i64.lt_u (i64.const -1) (i64.const 1)) (i32.const 0))
    ;; i64-Speicher in allen Breiten
    (i64.store (i32.const 900) (i64.const -1))
    (call $p64 (i64.load8_s (i32.const 900)) (i64.const -1))
    (call $p64 (i64.load8_u (i32.const 900)) (i64.const 255))
    (call $p64 (i64.load32_s (i32.const 900)) (i64.const -1))
    (call $p64 (i64.load32_u (i32.const 900)) (i64.const 4294967295))
    (call $ex (i32.const 0))))
