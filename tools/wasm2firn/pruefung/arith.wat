(module
  (import "wasi_snapshot_preview1" "fd_write"
    (func $fw (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $ex (param i32)))
  (memory 1)
  (export "memory" (memory 0))
  (data (i32.const 500) "OK\n")
  (data (i32.const 510) "FEHLER\n")
  (func $pruef (param $a i32) (param $b i32)
    (if (i32.eq (local.get $a) (local.get $b))
      (then (i32.store (i32.const 100) (i32.const 500))
            (i32.store (i32.const 104) (i32.const 3)))
      (else (i32.store (i32.const 100) (i32.const 510))
            (i32.store (i32.const 104) (i32.const 7))))
    (drop (call $fw (i32.const 1) (i32.const 100) (i32.const 1) (i32.const 120))))
  (func (export "_start")
    ;; die Faelle, an denen ein Uebersetzer typischerweise stirbt
    (call $pruef (i32.shr_u (i32.const -1) (i32.const 1)) (i32.const 2147483647))
    (call $pruef (i32.shr_s (i32.const -8) (i32.const 2)) (i32.const -2))
    (call $pruef (i32.div_s (i32.const -7) (i32.const 2)) (i32.const -3))
    (call $pruef (i32.rem_s (i32.const -7) (i32.const 2)) (i32.const -1))
    (call $pruef (i32.and (i32.const -1) (i32.const 255)) (i32.const 255))
    (call $pruef (i32.wrap_i64 (i64.const 4294967296)) (i32.const 0))
    (call $pruef (i32.load8_s (i32.const 600)) (i32.const 0))
    (call $pruef (i32.lt_s (i32.const -1) (i32.const 1)) (i32.const 1))
    (call $pruef (i32.lt_u (i32.const -1) (i32.const 1)) (i32.const 0))
    (call $pruef (i32.rotl (i32.const 1) (i32.const 31)) (i32.const -2147483648))
    (call $pruef (i32.clz (i32.const 1)) (i32.const 31))
    (call $pruef (i32.ctz (i32.const 8)) (i32.const 3))
    (call $pruef (i32.popcnt (i32.const 255)) (i32.const 8))
    (call $ex (i32.const 0))))
