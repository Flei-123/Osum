// SPDX-License-Identifier: GPL-2.0-only
import std.io
import std.rt
import smb.url

fn emit(b: *mut rt.Buf) {
    rt.buf_push(b, 10 as u8)
    io.print_bytes(rt.buf_ptr(b), rt.buf_len(b))
    rt.buf_free(b)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    let cmd: u64 = rt.arg_ptr(start, 1)
    let a: u64 = rt.arg_ptr(start, 2)
    var out: [u8; 256] = [0; 256]
    let op: u64 = (&out[0]) as u64
    var b: rt.Buf = rt.buf_new()
    let c: u8 = rt.ld8(cmd, 0)
    if c == 108 as u8 {
        rt.buf_push_dec_u64(&b, url.level(a))
    } else if c == 104 as u8 {
        if url.host_of(a, op, 256) {
            rt.buf_push_bytes(&b, op, rt.c_length(op))
        } else {
            rt.buf_push_bytes(&b, op, 0)
            rt.buf_push(&b, 33 as u8)
        }
        rt.buf_push(&b, 32 as u8)
        rt.buf_push_dec_u64(&b, url.port_of(a) as u64)
    } else if c == 115 as u8 {
        if url.share_of(a, op, 256) {
            rt.buf_push_bytes(&b, op, rt.c_length(op))
        } else {
            rt.buf_push(&b, 33 as u8)
        }
    } else if c == 114 as u8 {
        if url.rest_of(a, op, 256) {
            rt.buf_push_bytes(&b, op, rt.c_length(op))
        } else {
            rt.buf_push(&b, 33 as u8)
        }
    } else if c == 112 as u8 {
        let n: usize = rt.c_length(a)
        var i: usize = 0
        while i < n {
            rt.st8(op, i, rt.ld8(a, i))
            i = i + 1
        }
        rt.st8(op, n, 0 as u8)
        if url.parent_in_place(op) {
            rt.buf_push_bytes(&b, op, rt.c_length(op))
        } else {
            rt.buf_push(&b, 33 as u8)
        }
    } else {
        var r: url.Parsed = url.Parsed { kind: 0, size: 0, name_len: 0 }
        var ok: bool = false
        if c == 76 as u8 {
            ok = url.parse_ls_line(a, rt.c_length(a), op, 256, &r)
        } else {
            ok = url.parse_share_line(a, rt.c_length(a), op, 256, &r)
        }
        if ok {
            rt.buf_push_dec_u64(&b, r.kind)
            rt.buf_push(&b, 32 as u8)
            rt.buf_push_dec_u64(&b, r.size)
            rt.buf_push(&b, 32 as u8)
            rt.buf_push_bytes(&b, op, r.name_len)
        } else {
            rt.buf_push(&b, 33 as u8)
        }
    }
    emit(&b)
    return 0
}
