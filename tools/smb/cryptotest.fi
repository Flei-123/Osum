import std.io
import std.rt
import crypto.md4
import crypto.hmac_md5

fn hex(p: u64, n: usize, out: *mut rt.Buf) {
    var i: usize = 0
    while i < n {
        rt.buf_push_hex_u64(out, rt.ld8(p, i) as u64, 2)
        i = i + 1
    }
}

fn main(start: u64) -> i32 {
    let argc: usize = rt.arg_count(start)
    if argc < 4 {
        return 2
    }
    let kind: u64 = rt.arg_ptr(start, 1)
    let a: u64 = rt.arg_ptr(start, 2)
    let b: u64 = rt.arg_ptr(start, 3)
    var d: [u8; 16] = [0; 16]
    var out: rt.Buf = rt.buf_new()
    if rt.ld8(kind, 0) == 52 as u8 {
        md4.md4(a, rt.c_length(a), (&d[0]) as u64)
    } else {
        hmac_md5.hmac_md5(a, rt.c_length(a), b, rt.c_length(b), (&d[0]) as u64)
    }
    hex((&d[0]) as u64, 16, &out)
    rt.buf_push(&out, 10 as u8)
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}
