const NOT_FOUND: u64 = 0xffff
const REG_CAP: u64 = 128
const DPCD_LEN: u64 = 272
const EDID_I2C_ADDR: u64 = 0x50
const IDLE_CTL: u64 = 0x0410023f
const SINK_DEFER_NATIVE: u64 = 0x20
const SINK_DEFER_I2C: u64 = 0x80
const SINK_NACK_NATIVE: u64 = 0x10
const SINK_NACK_I2C: u64 = 0x40
const SHORT_CHUNK: u64 = 8
const FOREVER: u64 = 99

static mut reg_off: [u64; 128] = [0; 128]
static mut reg_val: [u64; 128] = [0; 128]
static mut reg_n: u64 = 0
static mut wr_count: u64 = 0
static mut delay_total: u64 = 0
static mut delay_calls: u64 = 0
static mut aux_calls: u64 = 0
static mut bad_send: u64 = 0
static mut mot_bad: u64 = 0
static mut inj_timeout: u64 = 0
static mut inj_recv: u64 = 0
static mut inj_nack: u64 = 0
static mut inj_defer: u64 = 0
static mut inj_size0: u64 = 0
static mut inj_big: u64 = 0
static mut inj_short: u64 = 0
static mut edid_ptr: u64 = 0
static mut edid_blk: [u8; 128] = [0 as u8; 128]
static mut dpcd_blk: [u8; 272] = [0 as u8; 272]
static mut got_blk: [u8; 128] = [0 as u8; 128]
static mut got_dpcd: [u8; 32] = [0 as u8; 32]
static SKL_IDS: [u64; 25] = [0x1902, 0x1906, 0x190A, 0x190B, 0x190E, 0x1912, 0x1913, 0x1915, 0x1916, 0x1917, 0x191A,
    0x191B, 0x191D, 0x191E, 0x1921, 0x1923, 0x1926, 0x1927, 0x192A, 0x192B, 0x192D, 0x1932, 0x193A, 0x193B, 0x193D]
static KBL_IDS: [u64; 22] = [0x5902, 0x5906, 0x5908, 0x590A, 0x590B, 0x590E, 0x5912, 0x5913, 0x5915, 0x5916, 0x5917,
    0x591A, 0x591B, 0x591C, 0x591D, 0x591E, 0x5921, 0x5923, 0x5926, 0x5927, 0x593B, 0x87C0]
static EXPECT: [u8; 1378] = "pipesrc_w=1920\npipesrc_h=1080\nhactive=1920\nhsync_start=1936\nhsync_end=1952\nhtotal=2104\nvactive=1080\nvsync_start=1083\nvsync_end=1097\nvtotal=1116\npclk_khz=141000\nrefresh_mhz=60049\nlink_symbol_khz=270000\ndata_tu=64\ndata_ratio_ppm=587500\ntransconf_edp=0xc0000000\nedp_enabled=1\npipeconf_a=0x00000000\npipeconf_b=0x00000000\nddi_func_edp=0x82200002\nddi_func_enabled=1\nddi_mode=2\nddi_bpc=6\nddi_pipe=0\nddi_lanes=2\nhsync_positive=0\nvsync_positive=0\nddi_func_a=0x00030000\nddi_buf_a=0x80000003\nddi_buf_enabled=1\nddi_buf_lanes=2\ndp_tp_ctl_a=0x80040300\ndp_tp_status_a=0x00000000\ndp_mst=0\ndp_enhanced=1\ndp_pattern=3\naux_ctl_a=0x0410023f\ndpll_ctrl1=0x00000003\ndpll_ctrl2=0x00a00001\ndpll_status=0x00000011\ndpll0_locked=1\nlcpll1_ctl=0xc0000000\nlcpll1_enabled=1\nlcpll1_locked=1\ncdclk_ctl=0x0c000544\ncdclk_khz=675000\ndssm=0x00000001\ndfsm=0x20400042\ncdclk_limit_khz=675000\nfuse_status=0x8e000000\nplane_ctl_1_a=0x84000000\nplane_enabled=1\nplane_format=4\nplane_tiling=0\nplane_stride_bytes=7680\nplane_width=1920\nplane_height=1080\nplane_surf=0x00000000\npp_status=0x80000008\npanel_on=1\npp_sequence=8\npp_control=0x00000007\npp_off_delay_100us=500\nblc_pch_ctl1=0x80000000\nblc_pwm_enabled=1\nblc_period=7500\nblc_duty=7500\nblc_cpu_ctl2=0x80000000\nblc_cpu_ctl=0x00000000\npwr_well_ctl1=0xf000000f\npwr_well_ctl2=0x50000005\npwr_well_ctl3=0x40000000\npwr_well_ctl4=0x50000005\ndc_state_en=0x00000000\ngmbus2=0x00000800\n\0"

fn chk(name: str, cond: bool) {
    if cond {
        io.print("OK   ")
    } else {
        io.print("FAIL ")
    }
    io.print_line(name)
}

fn reg_find(off: u64) -> u64 {
    var i: u64 = 0
    while i < reg_n {
        if reg_off[i as usize] == off {
            return i
        }
        i = i + 1
    }
    return NOT_FOUND
}

fn reg_set(off: u64, v: u64) {
    let i: u64 = reg_find(off)
    if i != NOT_FOUND {
        reg_val[i as usize] = v
        return
    }
    reg_off[reg_n as usize] = off
    reg_val[reg_n as usize] = v
    reg_n = reg_n + 1
}

fn reg_get(off: u64) -> u64 {
    let i: u64 = reg_find(off)
    if i == NOT_FOUND {
        return 0
    }
    return reg_val[i as usize]
}

fn expected_send(size: u64) -> u64 {
    return 0xf0000000 | (3 << 26) | 0x2000000 | (size << 20) | 0x23f
}

fn sink_tx_byte(i: u64) -> u64 {
    return (reg_get(0x64014 + (i / 4) * 4) >> ((3 - (i % 4)) * 8)) & 0xff
}

fn sink_reply(rb: *mut [u8; 20], n: u64) {
    var w: u64 = 0
    while w * 4 < n {
        var v: u64 = 0
        var b: u64 = 0
        while b < 4 {
            v = v << 8
            if w * 4 + b < n {
                v = v | ((*rb)[(w * 4 + b) as usize] as u64)
            }
            b = b + 1
        }
        reg_set(0x64014 + w * 4, v)
        w = w + 1
    }
    reg_set(0x64010, 0x40000000 | (n << 20))
}

fn sink_status_only(bitmask: u64) {
    reg_set(0x64010, bitmask)
}

fn sink_native_read(rb: *mut [u8; 20], addr: u64, len: u64) -> u64 {
    var n: u64 = len
    if inj_short != 0 && n > SHORT_CHUNK {
        n = SHORT_CHUNK
    }
    var i: u64 = 0
    while i < n {
        (*rb)[(1 + i) as usize] = dpcd_blk[((addr + i) % DPCD_LEN) as usize]
        i = i + 1
    }
    (*rb)[0] = 0 as u8
    return 1 + n
}

fn sink_i2c_read(rb: *mut [u8; 20], len: u64, mot: bool) -> u64 {
    var n: u64 = len
    if inj_short != 0 && n > SHORT_CHUNK {
        n = SHORT_CHUNK
    }
    var i: u64 = 0
    while i < n {
        (*rb)[(1 + i) as usize] = edid_blk[((edid_ptr + i) % 128) as usize]
        i = i + 1
    }
    edid_ptr = edid_ptr + n
    if inj_short == 0 && (edid_ptr < 128) != mot {
        mot_bad = mot_bad + 1
    }
    (*rb)[0] = 0 as u8
    return 1 + n
}

fn reply_code(native: bool, native_code: u64, i2c_code: u64) -> u64 {
    if native {
        return native_code
    }
    return i2c_code
}

fn sink_dispatch(rb: *mut [u8; 20]) -> u64 {
    let req: u64 = sink_tx_byte(0) >> 4
    let native: bool = (req & 8) != 0
    let addr: u64 = ((sink_tx_byte(0) & 0xf) << 16) | (sink_tx_byte(1) << 8) | sink_tx_byte(2)
    let len: u64 = sink_tx_byte(3) + 1
    if inj_defer > 0 {
        inj_defer = inj_defer - 1
        (*rb)[0] = reply_code(native, SINK_DEFER_NATIVE, SINK_DEFER_I2C) as u8
        return 1
    }
    if inj_nack > 0 {
        inj_nack = inj_nack - 1
        (*rb)[0] = reply_code(native, SINK_NACK_NATIVE, SINK_NACK_I2C) as u8
        return 1
    }
    if native {
        return sink_native_read(rb, addr, len)
    }
    if (req & 3) == 0 {
        edid_ptr = sink_tx_byte(4)
        if (req & 4) == 0 {
            mot_bad = mot_bad + 1
        }
        (*rb)[0] = 0 as u8
        return 1
    }
    return sink_i2c_read(rb, len, (req & 4) != 0)
}

fn aux_start(v: u64) {
    aux_calls = aux_calls + 1
    if v != expected_send((v >> 20) & 0x1f) {
        bad_send = bad_send + 1
    }
    if inj_timeout > 0 {
        inj_timeout = inj_timeout - 1
        sink_status_only(0x10000000)
        return
    }
    if inj_recv > 0 {
        inj_recv = inj_recv - 1
        sink_status_only(0x2000000)
        return
    }
    if inj_size0 > 0 {
        inj_size0 = inj_size0 - 1
        sink_status_only(0x40000000)
        return
    }
    if inj_big > 0 {
        inj_big = inj_big - 1
        sink_status_only(0x40000000 | (21 << 20))
        return
    }
    var rb: [u8; 20] = [0 as u8; 20]
    let n: u64 = sink_dispatch(&rb)
    sink_reply(&rb, n)
}

fn m_rd(off: u64) -> u64 {
    return reg_get(off)
}

fn m_wr(off: u64, v: u64) -> u64 {
    wr_count = wr_count + 1
    if off == 0x64010 {
        if (v & 0x80000000) != 0 {
            aux_start(v)
            return 0
        }
        let cur: u64 = reg_get(off)
        let clr: u64 = v & 0x52000000
        reg_set(off, cur ^ (cur & clr))
        return 0
    }
    reg_set(off, v)
    return 0
}

fn m_us(n: u64) -> u64 {
    delay_total = delay_total + n
    delay_calls = delay_calls + 1
    return 0
}

fn fresh() {
    inj_timeout = 0
    inj_recv = 0
    inj_nack = 0
    inj_defer = 0
    inj_size0 = 0
    inj_big = 0
    inj_short = 0
    edid_ptr = 0
    aux_calls = 0
    bad_send = 0
    mot_bad = 0
    delay_total = 0
    delay_calls = 0
    reg_set(0x64010, IDLE_CTL)
}

