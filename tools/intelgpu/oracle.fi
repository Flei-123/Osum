fn put_edid(i: u64, v: u64) {
    edid_blk[i as usize] = v as u8
}

fn fix_edid_sum() {
    var sum: u64 = 0
    var i: u64 = 0
    while i < 127 {
        sum = sum + (edid_blk[i as usize] as u64)
        i = i + 1
    }
    edid_blk[127] = ((256 - (sum & 0xff)) & 0xff) as u8
}

fn build_edid() {
    var i: u64 = 0
    while i < 128 {
        edid_blk[i as usize] = 0 as u8
        i = i + 1
    }
    i = 1
    while i < 7 {
        put_edid(i, 0xff)
        i = i + 1
    }
    put_edid(8, 0x30)
    put_edid(9, 0xe4)
    put_edid(10, 0x23)
    put_edid(11, 0x01)
    put_edid(18, 1)
    put_edid(19, 4)
    put_edid(21, 31)
    put_edid(22, 17)
    put_edid(54, 0x14)
    put_edid(55, 0x37)
    put_edid(56, 0x80)
    put_edid(57, 0xb8)
    put_edid(58, 0x70)
    put_edid(59, 0x38)
    put_edid(60, 0x24)
    put_edid(61, 0x40)
    put_edid(62, 0x10)
    put_edid(63, 0x10)
    put_edid(64, 0x3e)
    put_edid(66, 0x58)
    put_edid(67, 0xc1)
    put_edid(68, 0x10)
    fix_edid_sum()
}

fn build_dpcd() {
    var i: u64 = 0
    while i < DPCD_LEN {
        dpcd_blk[i as usize] = ((i * 7 + 3) & 0xff) as u8
        i = i + 1
    }
    dpcd_blk[0] = 0x12 as u8
    dpcd_blk[1] = 0x0a as u8
    dpcd_blk[2] = 0x82 as u8
    dpcd_blk[0x100] = 0x0a as u8
    dpcd_blk[0x101] = 0x02 as u8
}

fn same_bytes(a: u64, b: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if octets.ld8(a, i) != octets.ld8(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn pe() -> u64 {
    return (&edid_blk[0]) as u64
}

fn pg() -> u64 {
    return (&got_blk[0]) as u64
}

fn pd() -> u64 {
    return (&got_dpcd[0]) as u64
}

fn read_edid() -> u64 {
    return aux.i2c_read(m_rd, m_wr, m_us, EDID_I2C_ADDR, 0, pg(), 128)
}

fn test_ids() {
    var skl: u64 = 0
    var kbl: u64 = 0
    var d: u64 = 0
    while d < 65536 {
        let g: u64 = ids.gen_x10(0x8086, d)
        if g == 90 {
            skl = skl + 1
        } else if g == 95 {
            kbl = kbl + 1
        }
        d = d + 1
    }
    chk("exactly 25 SKL ids over all device numbers", skl == 25)
    chk("exactly 22 KBL ids over all device numbers", kbl == 22)
    var ok_skl: bool = true
    var i: u64 = 0
    while i < 25 {
        if ids.gen_x10(0x8086, SKL_IDS[i as usize]) != 90 {
            ok_skl = false
        }
        i = i + 1
    }
    chk("every listed SKL id maps to gen 9.0", ok_skl)
    var ok_kbl: bool = true
    i = 0
    while i < 22 {
        if ids.gen_x10(0x8086, KBL_IDS[i as usize]) != 95 {
            ok_kbl = false
        }
        i = i + 1
    }
    chk("every listed KBL id maps to gen 9.5", ok_kbl)
    chk("5916 (HP HD 620) is gen 9.5", ids.gen_x10(0x8086, 0x5916) == 95)
    chk("other vendor with 5916 is rejected", ids.gen_x10(0x10de, 0x5916) == 0)
    chk("87C0 is gen 9.5", ids.gen_x10(0x8086, 0x87c0) == 95)
    chk("1912 is gen 9.0", ids.gen_x10(0x8086, 0x1912) == 90)
    chk("5918 is not listed", !ids.is_gen9(0x8086, 0x5918))
    chk("Coffee Lake 3E9B is not gen 9 here", !ids.is_gen9(0x8086, 0x3e9b))
    chk("5916 is_gen9", ids.is_gen9(0x8086, 0x5916))
}

fn test_timing_units() {
    chk("pixel clock 273794/524288 of 270 MHz rounds to 141000 kHz", timing.pixel_clock_khz(273794, 524288, 270000) == 141000)
    chk("pixel clock with zero N is 0", timing.pixel_clock_khz(5, 0, 270000) == 0)
    chk("DPLL0 rate field 1 is 270 MHz symbol clock", timing.link_symbol_khz(0x3, 0) == 270000)
    chk("DPLL0 rate field 0 is 540 MHz symbol clock", timing.link_symbol_khz(0x1, 0) == 540000)
    chk("DPLL1 rate field sits 6 bits higher", timing.link_symbol_khz((1 << 6) | (2 << 7), 1) == 162000)
    chk("unknown rate field gives 0", timing.link_symbol_khz(7 << 1, 0) == 0)
    chk("data M TU field 63 means TU 64", timing.data_tu(0x7e4b3333) == 64)
    chk("data M/N 0x4b3333/0x800000 is 587500 ppm", timing.data_ratio_ppm(0x7e4b3333, 0x800000) == 587500)
}

fn test_decode() {
    var s: snap.State = snap.state_new()
    let before: u64 = wr_count
    snap.snapshot(m_rd, &s)
    chk("snapshot performs zero register writes", wr_count == before)
    chk("PIPESRC_A decodes to 1920x1080", s.pipesrc_w == 1920 && s.pipesrc_h == 1080)
    chk("horizontal timing 1920/1936/1952/2104", s.mode.hactive == 1920 && s.mode.hsync_start == 1936
        && s.mode.hsync_end == 1952 && s.mode.htotal == 2104)
    chk("vertical timing 1080/1083/1097/1116", s.mode.vactive == 1080 && s.mode.vsync_start == 1083
        && s.mode.vsync_end == 1097 && s.mode.vtotal == 1116)
    chk("pixel clock from link M/N is 141000 kHz", s.mode.pclk_khz == 141000)
    chk("refresh is 60.049 Hz", mode.refresh_mhz(&s.mode) == 60049)
    chk("eDP transcoder is enabled", (s.transconf_edp & 0x80000000) != 0)
    chk("DDI function is DP SST, 6 bpc, 2 lanes", ((s.ddi_func >> 24) & 7) == 2 && snap.bpc_of(s.ddi_func) == 6
        && snap.lanes_of(s.ddi_func) == 2)
    chk("CDCLK 675 MHz, limit 675 MHz", snap.cdclk_khz_of(s.cdclk_ctl) == 675000
        && snap.cdclk_limit_khz_of(s.dfsm) == 675000)
    chk("link symbol clock 270 MHz", s.symbol_khz == 270000)
    chk("data TU 64", s.data_tu == 64)
    chk("CDCLK select table 540/450/337.5/675 MHz", snap.cdclk_khz_of(0) == 540000 && snap.cdclk_khz_of(1 << 26) == 450000
        && snap.cdclk_khz_of(2 << 26) == 337500 && snap.cdclk_khz_of(3 << 26) == 675000)
    chk("DFSM limit table 675/540/450/337.5 MHz", snap.cdclk_limit_khz_of(0) == 675000
        && snap.cdclk_limit_khz_of(1 << 23) == 540000 && snap.cdclk_limit_khz_of(2 << 23) == 450000
        && snap.cdclk_limit_khz_of(3 << 23) == 337500)
    chk("bpc table 8/10/6/12", snap.bpc_of(0) == 8 && snap.bpc_of(1 << 20) == 10 && snap.bpc_of(2 << 20) == 6
        && snap.bpc_of(3 << 20) == 12 && snap.bpc_of(5 << 20) == 0)
    var m: mode.Mode = mode.mode_new()
    timing.read_mode(m_rd, 0x60000, 270000, &m)
    chk("transcoder A (off) decodes to an empty mode", m.hactive == 1 && m.pclk_khz == 0)
}

fn test_dump() {
    var s: snap.State = snap.state_new()
    snap.snapshot(m_rd, &s)
    buf.reset_out()
    dump.dump(&s)
    let p: u64 = buf.out_ptr()
    let n: u64 = buf.out_len()
    let e: u64 = (&EXPECT[0]) as u64
    chk("dump has one line per label", buf.line_end(p, 0, n) > 0 && n > 0)
    var at: u64 = 0
    var lines: u64 = 0
    var eat: u64 = 0
    while at < n {
        let end: u64 = buf.line_end(p, at, n)
        let eend: u64 = buf.line_end(e, eat, octets.cstr_len(e))
        let ok: bool = (end - at) == (eend - eat) && same_bytes(p + at, e + eat, end - at)
        if ok {
            io.print("OK   dump: ")
        } else {
            io.print("FAIL dump: ")
        }
        io.print_bytes(e + eat, (eend - eat) as usize)
        io.new_line()
        at = end + 1
        eat = eend + 1
        lines = lines + 1
    }
    chk("dump line count equals label count", lines == 75)
    chk("dump text length equals expected text", n == octets.cstr_len(e))
}

fn test_edid() {
    build_edid()
    chk("fixture EDID passes header and checksum", edid.block_ok(pe()))
    chk("manufacturer is LGD", edid.manufacturer_letter(pe(), 0) == 76 && edid.manufacturer_letter(pe(), 1) == 71
        && edid.manufacturer_letter(pe(), 2) == 68)
    chk("product code 0x0123", edid.product_code(pe()) == 0x123)
    chk("base size 310x170 mm", edid.base_width_mm(pe()) == 310 && edid.base_height_mm(pe()) == 170)
    chk("DTD size 344x193 mm", edid.dtd_width_mm(pe()) == 344 && edid.dtd_height_mm(pe()) == 193)
    var em: mode.Mode = mode.mode_new()
    chk("native mode parses", edid.native_mode(pe(), &em))
    var hm: mode.Mode = mode.mode_new()
    timing.read_mode(m_rd, 0x6f000, 270000, &hm)
    chk("EDID native mode equals the register readback", mode.same_timing(&em, &hm) && em.pclk_khz == hm.pclk_khz)
    chk("EDID pixel clock 141000 kHz", em.pclk_khz == 141000)
    put_edid(20, 0x80)
    chk("flipped byte breaks the checksum", !edid.checksum_ok(pe()) && !edid.block_ok(pe()))
    build_edid()
    put_edid(3, 0)
    fix_edid_sum()
    chk("broken header is rejected even with a valid checksum", edid.checksum_ok(pe()) && !edid.header_ok(pe()))
    build_edid()
    put_edid(7, 1)
    fix_edid_sum()
    chk("broken trailing header byte is rejected", edid.checksum_ok(pe()) && !edid.header_ok(pe()))
    build_edid()
    put_edid(0, 1)
    fix_edid_sum()
    chk("broken leading header byte is rejected", edid.checksum_ok(pe()) && !edid.header_ok(pe()))
    build_edid()
    put_edid(54, 0)
    put_edid(55, 0)
    fix_edid_sum()
    chk("zero pixel clock gives no native mode", !edid.native_mode(pe(), &em))
    build_edid()
}

fn test_aux_reads() {
    fresh()
    var e: u64 = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 16)
    chk("DPCD read at 0 succeeds", e == aux.E_OK)
    chk("DPCD revision 1.2, max rate 0x0a, lanes 2 + enhanced", got_dpcd[0] == 0x12 && got_dpcd[1] == 0x0a
        && (got_dpcd[2] & 0x1f) == 2 && (got_dpcd[2] & 0x80) != 0)
    chk("DPCD bytes 3..15 equal the sink", same_bytes(pd() + 3, (&dpcd_blk[3]) as u64, 13))
    chk("DPCD 16 bytes took one AUX transaction", aux_calls == 1)
    e = aux.native_read(m_rd, m_wr, m_us, 0x100, pd(), 2)
    chk("DPCD current link at 0x100 reads rate 0x0a lanes 2", e == aux.E_OK && got_dpcd[0] == 0x0a && got_dpcd[1] == 2)
    fresh()
    e = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 32)
    chk("32 DPCD bytes take two transactions", e == aux.E_OK && aux_calls == 2 && same_bytes(pd(), (&dpcd_blk[0]) as u64, 32))
    fresh()
    e = read_edid()
    chk("EDID read over I2C-over-AUX succeeds", e == aux.E_OK)
    chk("EDID bytes equal the sink block", same_bytes(pg(), pe(), 128))
    chk("EDID read uses 1 offset write + 8 reads", aux_calls == 9)
    chk("every send word matches the HP pattern 0x...023f", bad_send == 0)
    chk("MOT set on all reads but the last", mot_bad == 0)
    chk("fetched EDID passes block_ok", edid.block_ok(pg()))
    fresh()
    inj_short = 1
    e = read_edid()
    chk("short replies (8 of 16 bytes) still assemble the block", e == aux.E_OK && same_bytes(pg(), pe(), 128))
    fresh()
    inj_short = 1
    e = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 32)
    chk("short native replies still assemble 32 bytes", e == aux.E_OK && same_bytes(pd(), (&dpcd_blk[0]) as u64, 32))
}

fn test_aux_faults() {
    fresh()
    inj_defer = 2
    var e: u64 = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 4)
    chk("two DEFERs then ACK succeeds", e == aux.E_OK && aux_calls == 3 && got_dpcd[0] == 0x12)
    chk("DEFER waits 400 us each", delay_total >= 800)
    fresh()
    inj_defer = FOREVER
    e = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 4)
    chk("endless DEFER ends in E_DEFER after 7 attempts", e == aux.E_DEFER && aux_calls == 7)
    fresh()
    inj_nack = 1
    e = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 4)
    chk("native NACK is E_NACK without retry", e == aux.E_NACK && aux_calls == 1)
    fresh()
    inj_nack = 1
    e = read_edid()
    chk("I2C NACK on the offset write is E_NACK", e == aux.E_NACK && aux_calls == 1)
    fresh()
    inj_defer = 1
    e = read_edid()
    chk("I2C DEFER is retried and the EDID still matches", e == aux.E_OK && same_bytes(pg(), pe(), 128))
    fresh()
    inj_timeout = 2
    e = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 4)
    chk("two timeouts then success", e == aux.E_OK && aux_calls == 3)
    fresh()
    inj_timeout = FOREVER
    e = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 4)
    chk("endless timeout ends in E_TIMEOUT after 5 sends", e == aux.E_TIMEOUT && aux_calls == 5)
    fresh()
    inj_recv = 1
    e = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 4)
    chk("one receive error then success", e == aux.E_OK && aux_calls == 2)
    chk("receive error waits 400 us before the retry", delay_total >= 400)
    fresh()
    inj_recv = FOREVER
    e = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 4)
    chk("endless receive error ends in E_RECV", e == aux.E_RECV && aux_calls == 5)
    fresh()
    inj_size0 = 1
    e = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 4)
    chk("DONE with reply size 0 is E_SIZE", e == aux.E_SIZE)
    fresh()
    var tx: [u8; 4] = [0 as u8; 4]
    var rx: [u8; 20] = [0 as u8; 20]
    var rxn: u64 = 0
    inj_size0 = 1
    e = aux.transfer(m_rd, m_wr, m_us, (&tx[0]) as u64, 4, (&rx[0]) as u64, 20, &rxn)
    chk("transfer: reply size 0 is E_SIZE", e == aux.E_SIZE)
    fresh()
    inj_big = 1
    e = aux.transfer(m_rd, m_wr, m_us, (&tx[0]) as u64, 4, (&rx[0]) as u64, 20, &rxn)
    chk("transfer: reply size 21 is E_SIZE", e == aux.E_SIZE)
    fresh()
    reg_set(0x64010, 0x80000000 | IDLE_CTL)
    e = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 4)
    chk("stuck BUSY channel is E_BUSY after 3 ms and sends nothing", e == aux.E_BUSY && aux_calls == 0 && delay_total == 3000)
    fresh()
    var got: u64 = 0
    var rb: [u8; 20] = [0 as u8; 20]
    chk("empty payload is rejected", aux.request(m_rd, m_wr, m_us, aux.REQ_NATIVE_READ, 0, 0, 0, (&rb[0]) as u64, 20, &got) == aux.E_ARG)
    chk("17-byte payload is rejected", aux.request(m_rd, m_wr, m_us, aux.REQ_NATIVE_READ, 0, 0, 17, (&rb[0]) as u64, 20, &got) == aux.E_ARG)
    chk("21-byte transfer is rejected", aux.transfer(m_rd, m_wr, m_us, (&rb[0]) as u64, 21, (&rb[0]) as u64, 20, &got) == aux.E_ARG)
    chk("rejected requests touched no register", aux_calls == 0)
    fresh()
    e = aux.native_read(m_rd, m_wr, m_us, 0, pd(), 4)
    chk("DONE bit is write-1-cleared again", (reg_get(0x64010) & 0x40000000) == 0)
    chk("status register left idle (BUSY clear)", (reg_get(0x64010) & 0x80000000) == 0)
}

fn main() -> i32 {
    load_fixtures()
    build_edid()
    build_dpcd()
    fresh()
    test_ids()
    test_timing_units()
    test_decode()
    test_dump()
    test_edid()
    test_aux_reads()
    test_aux_faults()
    return 0
}
