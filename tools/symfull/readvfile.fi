profile kernel

import ulib

export { u_start }

const WANT: u64 = 60000

static mut buf: [u8; 65536] = [0 as u8; 65536]

fn line(name: u64, v: u64) {
    var s_pre: [u8; 10] = "readone: \0"
    var s_eq: [u8; 4] = " = \0"
    ulib.say((&s_pre[0 as usize]) as u64)
    ulib.say(name)
    ulib.say((&s_eq[0 as usize]) as u64)
    ulib.sayn(v)
    ulib.nl()
}

fn u_start(args: u64) -> u64 {
    var n_bytes: [u8; 6] = "bytes\0"
    var n_sum: [u8; 4] = "sum\0"
    if ulib.arg_count(args) < 2 {
        return 1
    }
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, ulib.arg_at(args, 1), 0, 0)
    if ulib.bad(fd) {
        line((&n_bytes[0 as usize]) as u64, 0)
        return 1
    }
    let n: u64 = ulib.sys(ulib.SYS_READ, fd, (&buf[0 as usize]) as u64, WANT)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    if ulib.bad(n) {
        line((&n_bytes[0 as usize]) as u64, 0)
        return 1
    }
    var sum: u64 = 0
    var i: u64 = 0
    while i < n {
        sum = sum + (buf[i as usize] as u64)
        i = i + 1
    }
    line((&n_bytes[0 as usize]) as u64, n)
    line((&n_sum[0 as usize]) as u64, sum)
    return 0
}
