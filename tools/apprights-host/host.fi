// SPDX-License-Identifier: GPL-2.0-only
// tools/apprights-host/host.fi -- host test of lib/apprights/policy.fi (grant table + ceiling) and lib/apprights/conf.fi
// (apprights.conf parser, manifest perm= ceiling, rewrite). Built by tools/apprights-host/run.sh, which also mutates
// the libs and expects this test to go red for every mutation.
import std.rt
import std.io
import apprights.policy
import apprights.conf
import apprights.fspolicy

struct T {
    fails: i32,
    checks: i32,
}

static mut cbuf: [u8; 2048] = [0 as u8; 2048]
static mut cslot: usize = 0
static mut outb: [u8; 512] = [0 as u8; 512]

fn c(s: str) -> u64 {
    let base: usize = (cslot % 16) * 128
    cslot = cslot + 1
    var i: usize = 0
    while i < s.length() && i < 127 {
        cbuf[base + i] = *((s.p as u64 + i as u64) as *mut u8)
        i = i + 1
    }
    cbuf[base + i] = 0 as u8
    return ((&cbuf[0 as usize]) as u64) + base as u64
}

fn check(t: *mut T, ok: bool, what: str) {
    (*t).checks = (*t).checks + 1
    if ok {
        io.fmt_print(f"ok   {what}\n")
    } else {
        io.fmt_print(f"FAIL {what}\n")
        (*t).fails = (*t).fails + 1
    }
}

fn len_of(p: u64) -> u64 {
    var n: u64 = 0
    while rt.ld8(p, n as usize) != 0 as u8 {
        n = n + 1
    }
    return n
}

fn is_s(p: u64, s: str) -> bool {
    var i: usize = 0
    while i < s.length() {
        if rt.ld8(p, i) != rt.ld8(s.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return rt.ld8(p, i) == 0 as u8
}

fn main() -> i32 {
    var t: T = T { fails: 0, checks: 0 }
    policy.reset()

    // ---- grant table: default deny
    check(&t, !policy.label_allows(c("app:probe"), policy.P_MIC), "default deny: app without grant")
    check(&t, policy.label_allows(c(""), policy.P_MIC), "empty label (the person) is never gated")
    check(&t, policy.label_allows(c("jarvis"), policy.P_MIC), "non-app label is never gated")
    check(&t, policy.set_mask(c("probe"), policy.P_MIC | policy.P_NOTIFY) == policy.E_OK, "grant mic+notify")
    check(&t, policy.label_allows(c("app:probe"), policy.P_MIC), "granted right is allowed")
    check(&t, policy.label_allows(c("app:probe"), policy.P_NOTIFY), "second granted right is allowed")
    check(&t, !policy.label_allows(c("app:probe"), policy.P_NET), "ungranted right of the same app stays denied")
    check(&t, !policy.label_allows(c("app:other"), policy.P_MIC), "grants are per app")
    check(&t, policy.revoke(c("probe"), policy.P_MIC) == policy.E_OK, "revoke mic")
    check(&t, !policy.label_allows(c("app:probe"), policy.P_MIC) && policy.label_allows(c("app:probe"), policy.P_NOTIFY), "revoke takes only that bit")
    check(&t, policy.set_mask(c("bad/name"), 1) == policy.E_BADNAME, "bad app name refused")
    check(&t, policy.set_mask(c("0123456789012345678901"), 1) == policy.E_BADNAME, "too long app name refused")
    check(&t, policy.bit_of(c("clipboard.read")) == policy.P_CLIP_READ && policy.bit_of(c("nonsense")) == 0, "right names")

    // ---- the 12th right: window.float (W-WINOPTS S2)
    policy.reset()
    check(&t, policy.bit_of(c("window.float")) == policy.P_WINDOW_FLOAT && policy.P_WINDOW_FLOAT == 2048, "window.float is bit 2048")
    check(&t, (policy.P_ALL & policy.P_WINDOW_FLOAT) != 0 && policy.P_ALL == 8191, "P_ALL contains window.float")
    check(&t, (policy.P_SAFE & policy.P_WINDOW_FLOAT) == 0, "window.float is NOT in P_SAFE (never auto-granted)")
    check(&t, policy.name_of_bit(policy.P_WINDOW_FLOAT) != 0 && policy.bit_of(policy.name_of_bit(policy.P_WINDOW_FLOAT)) == policy.P_WINDOW_FLOAT, "window.float name round trip")
    check(&t, !policy.label_allows(c("app:flt"), policy.P_WINDOW_FLOAT), "window.float: default deny")
    check(&t, policy.set_mask(c("flt"), policy.P_WINDOW_FLOAT) == policy.E_OK && policy.label_allows(c("app:flt"), policy.P_WINDOW_FLOAT), "window.float: granted by the person")
    check(&t, !policy.label_allows(c("app:flt"), policy.P_MIC), "window.float grant does not imply the mic")
    check(&t, policy.revoke(c("flt"), policy.P_WINDOW_FLOAT) == policy.E_OK && !policy.label_allows(c("app:flt"), policy.P_WINDOW_FLOAT), "window.float: revoked")
    check(&t, policy.set_ceiling(c("flt2"), policy.P_NET) == policy.E_OK && policy.set_mask(c("flt2"), policy.P_WINDOW_FLOAT) == policy.E_CEIL, "window.float above the ceiling refused")
    check(&t, policy.set_ceiling(c("flt3"), policy.P_WINDOW_FLOAT) == policy.E_OK && policy.set_mask(c("flt3"), policy.P_WINDOW_FLOAT) == policy.E_OK, "window.float inside the ceiling granted")
    policy.reset()

    // ---- the 13th right: hotkey (W-S3)
    policy.reset()
    check(&t, policy.bit_of(c("hotkey")) == policy.P_HOTKEY && policy.P_HOTKEY == 4096, "hotkey is bit 4096")
    check(&t, (policy.P_ALL & policy.P_HOTKEY) != 0 && policy.P_ALL == 8191, "P_ALL contains hotkey")
    check(&t, (policy.P_SAFE & policy.P_HOTKEY) == 0, "hotkey is NOT in P_SAFE (never auto-granted)")
    check(&t, policy.name_of_bit(policy.P_HOTKEY) != 0 && policy.bit_of(policy.name_of_bit(policy.P_HOTKEY)) == policy.P_HOTKEY, "hotkey name round trip")
    check(&t, !policy.label_allows(c("app:hk"), policy.P_HOTKEY), "hotkey: default deny")
    check(&t, policy.set_mask(c("hk"), policy.P_HOTKEY) == policy.E_OK && policy.label_allows(c("app:hk"), policy.P_HOTKEY), "hotkey: granted by the person")
    check(&t, !policy.label_allows(c("app:hk"), policy.P_WINDOW_FLOAT), "hotkey grant does not imply window.float")
    check(&t, policy.set_ceiling(c("hk2"), policy.P_NET) == policy.E_OK && policy.set_mask(c("hk2"), policy.P_HOTKEY) == policy.E_CEIL, "hotkey above the ceiling refused")
    policy.reset()

    // ---- ceiling (manifest perm=)
    policy.reset()
    check(&t, policy.get_ceiling(c("mail")) == policy.CEIL_NONE && !policy.has_ceiling(c("mail")), "no ceiling registered yet")
    check(&t, policy.set_ceiling(c("mail"), policy.P_NET | policy.P_NOTIFY) == policy.E_OK, "register ceiling net+notify")
    check(&t, policy.get_ceiling(c("mail")) == (policy.P_NET | policy.P_NOTIFY), "ceiling readable")
    check(&t, policy.set_mask(c("mail"), policy.P_NET) == policy.E_OK, "grant inside the ceiling")
    check(&t, policy.set_mask(c("mail"), policy.P_NET | policy.P_MIC) == policy.E_CEIL, "grant above the ceiling refused")
    check(&t, policy.get_mask(c("mail")) == policy.P_NET, "refused grant changed nothing")
    check(&t, policy.grant(c("mail"), policy.P_CLIP_READ) == policy.E_CEIL, "grant() above the ceiling refused")
    check(&t, policy.set_ceiling(c("mail"), policy.P_NOTIFY) == policy.E_OK, "lower the ceiling")
    check(&t, policy.get_mask(c("mail")) == 0, "lowering the ceiling removes the grant at once")
    check(&t, policy.set_ceiling(c("nodecl"), 0) == policy.E_OK, "manifest without perm= -> ceiling 0")
    check(&t, policy.set_mask(c("nodecl"), policy.P_NOTIFY) == policy.E_CEIL, "ceiling 0 app can receive nothing")
    check(&t, policy.set_mask(c("nodecl"), 0) == policy.E_OK, "ceiling 0 app: empty grant is fine")
    check(&t, policy.set_mask(c("free"), policy.P_ALL) == policy.E_OK, "app without registered ceiling is only limited by default deny")

    // ---- manifest perm= parser
    let ip: u64 = c("name=Mail\ninfo=x\nperm=net, notify,clipboard.read\nnet=real\n")
    check(&t, conf.manifest_perm(ip, len_of(ip)) == (policy.P_NET | policy.P_NOTIFY | policy.P_CLIP_READ), "perm= line -> ceiling")
    let ip0: u64 = c("name=Plain\ninfo=no permission line\nnet=none\n")
    check(&t, conf.manifest_perm(ip0, len_of(ip0)) == 0, "no perm= line -> ceiling 0")
    let ip2: u64 = c("#perm=net\nxperm=net\npermfoo,net\nperm=bogus,mic\n")
    check(&t, conf.manifest_perm(ip2, len_of(ip2)) == policy.P_MIC, "comment / prefix lines ignored, unknown name ignored")

    // ---- conf parser
    let cp: u64 = c("# comment\nmail net,notify\n\nbad/name mic\nweird frobnicate\nplayer  audio.play , mic\nempty\n")
    conf.reset_bad()
    var pos: u64 = conf.conf_next(cp, len_of(cp), 0)
    check(&t, pos != conf.END && is_s(conf.cur_name(), "mail") && conf.cur_mask() == (policy.P_NET | policy.P_NOTIFY), "line 1: mail net,notify")
    pos = conf.conf_next(cp, len_of(cp), pos)
    check(&t, pos != conf.END && is_s(conf.cur_name(), "player") && conf.cur_mask() == (policy.P_AUDIO_PLAY | policy.P_MIC), "bad lines skipped, player audio.play,mic")
    pos = conf.conf_next(cp, len_of(cp), pos)
    check(&t, pos == conf.END, "end of file")
    check(&t, conf.bad_lines() == 3, "three bad lines counted (bad name, unknown right, no right)")

    // ---- rewrite
    var o: u64 = (&outb[0 as usize]) as u64
    var n: u64 = conf.update(cp, len_of(cp), c("mail"), policy.P_CLIP_WRITE, o, 512)
    check(&t, is_s(o, "player mic,audio.play\nmail clipboard.write\n"), "update replaces the line of that app, keeps the others")
    n = conf.update(o, len_of(o), c("mail"), 0, o + 256, 256)
    check(&t, is_s(o + 256, "player mic,audio.play\n"), "update with empty mask removes the line")
    n = conf.update(c(""), 0, c("new"), policy.P_NET, o, 512)
    check(&t, is_s(o, "new net\n") && n == 8, "update on an empty file")
    n = conf.update(c("x mic\n"), 6, c("x"), 0, o, 512)
    check(&t, n == 0, "removing the only line leaves an empty file")

    // ---- AR-3: auto-grant of the non-sensitive rights
    check(&t, policy.P_SAFE == (policy.P_NET | policy.P_NOTIFY | policy.P_CLIP_READ | policy.P_CLIP_WRITE | policy.P_AUDIO_PLAY), "P_SAFE = net notify clipboard.read clipboard.write audio.play")
    check(&t, (policy.P_SAFE & (policy.P_MIC | policy.P_CAMERA | policy.P_FS_HOME | policy.P_LOCATION | policy.P_CONTACTS | policy.P_PHONE)) == 0, "no sensitive right is safe")
    let all: u64 = policy.P_ALL
    check(&t, conf.auto_new(all, 0) == policy.P_SAFE, "ceiling = everything: only the safe rights are new")
    check(&t, (conf.auto_new(all, 0) & policy.P_MIC) == 0, "mic is never auto-granted")
    check(&t, conf.auto_new(policy.P_MIC | policy.P_CAMERA, 0) == 0, "only sensitive rights declared: nothing auto-granted")
    check(&t, conf.auto_new(policy.P_NET | policy.P_MIC, 0) == policy.P_NET, "net + mic declared: net only")
    check(&t, conf.auto_new(policy.P_NET | policy.P_NOTIFY, policy.P_NET | policy.P_NOTIFY) == 0, "already offered: nothing new (a revoked right stays revoked)")
    check(&t, conf.auto_new(policy.P_NET | policy.P_NOTIFY | policy.P_AUDIO_PLAY, policy.P_NET | policy.P_NOTIFY) == policy.P_AUDIO_PLAY, "an update that declares a new safe right: just that one")
    check(&t, conf.auto_new(0, 0) == 0, "no perm= line: nothing")
    let sn: u64 = c("mail net,notify\nplayer audio.play\n")
    check(&t, conf.find(sn, len_of(sn), c("mail")) == (policy.P_NET | policy.P_NOTIFY), "find: recorded offer of mail")
    check(&t, conf.find(sn, len_of(sn), c("player")) == policy.P_AUDIO_PLAY, "find: second line")
    check(&t, conf.find(sn, len_of(sn), c("mai")) == 0 && conf.find(sn, len_of(sn), c("nobody")) == 0, "find: prefix and unknown name give 0")
    let pl: u64 = c("mail\tabc123\nfvviewer\tdef456\nbad/name\t00\nnotab\nnotes\t9\n")
    var pp: u64 = conf.plan_next(pl, len_of(pl), 0)
    check(&t, pp != conf.END && is_s(conf.cur_name(), "mail"), "plan line 1: mail")
    pp = conf.plan_next(pl, len_of(pl), pp)
    check(&t, pp != conf.END && is_s(conf.cur_name(), "fvviewer"), "plan line 2: fvviewer")
    pp = conf.plan_next(pl, len_of(pl), pp)
    check(&t, pp != conf.END && is_s(conf.cur_name(), "notes"), "plan: bad name and line without tab are skipped")
    pp = conf.plan_next(pl, len_of(pl), pp)
    check(&t, pp == conf.END, "plan: end")

    // ---- AR-2b: per-app counters
    policy.reset()
    check(&t, policy.set_mask(c("clock"), 0) == policy.E_OK, "clock gets a slot")
    check(&t, policy.set_mask(c("mail"), 0) == policy.E_OK, "mail gets a slot")
    let a_cpu: u64 = policy.acct_addr(c("app:mail"), policy.A_CPU)
    check(&t, a_cpu != 0, "label app:mail -> counter address")
    check(&t, policy.acct_addr(c("jarvis"), policy.A_CPU) == 0 && policy.acct_addr(c(""), policy.A_CPU) == 0, "unlabelled / other labels have no counter")
    check(&t, policy.acct_addr(c("app:nobody"), policy.A_CPU) == 0, "app without a slot is not counted")
    check(&t, policy.acct_addr(c("app:mail"), policy.A_CPU) == policy.acct_addr(c("app:mail"), policy.A_CPU), "same label, same address")
    check(&t, policy.acct_addr(c("app:mail"), policy.A_CPU) != policy.acct_addr(c("app:clock"), policy.A_CPU), "different apps, different counters")
    check(&t, policy.acct_addr(c("app:mail"), policy.A_WAKE) != policy.acct_addr(c("app:mail"), policy.A_CPU), "different fields, different counters")
    *(a_cpu as *mut u64) = 7
    *(policy.acct_addr(c("app:mail"), policy.A_RX) as *mut u64) = 99
    let ms: u64 = policy.app_slot(c("mail"))
    check(&t, policy.acct_get(ms, policy.A_CPU) == 7 && policy.acct_get(ms, policy.A_RX) == 99 && policy.acct_get(ms, policy.A_TX) == 0, "acct_get reads what was booked, fields stay apart")
    check(&t, policy.acct_get(policy.app_slot(c("clock")), policy.A_CPU) == 0, "the other app stays at 0")
    check(&t, policy.slot_used(ms) && is_s(policy.slot_name(ms), "mail") && policy.slot_name(policy.MAX_APPS) == 0, "slot_name / slot_used")
    policy.reset()
    check(&t, policy.set_mask(c("mail"), 0) == policy.E_OK && policy.acct_get(policy.app_slot(c("mail")), policy.A_CPU) == 0, "a re-allocated slot starts at 0")

    // ---- S-010: file confinement
    policy.reset()
    check(&t, policy.set_ceiling(c("box"), 0 | policy.F_SANDBOX) == policy.E_OK, "box registered with sandbox flag")
    check(&t, policy.set_ceiling(c("free"), 0) == policy.E_OK, "free registered without sandbox flag")
    check(&t, policy.set_ceiling(c("home"), policy.P_FS_HOME | policy.F_SANDBOX) == policy.E_OK, "home registered with sandbox flag and fs.home ceiling")
    check(&t, policy.get_ceiling(c("box")) == 0, "the sandbox flag is not part of the ceiling")
    check(&t, policy.sandboxed(c("box")) && !policy.sandboxed(c("free")) && !policy.sandboxed(c("none")), "sandboxed(): only the flagged app")
    check(&t, policy.confined(c("box")) && !policy.confined(c("free")), "confined(): flagged app without fs.home")
    check(&t, policy.set_mask(c("home"), policy.P_FS_HOME) == policy.E_OK && !policy.confined(c("home")), "fs.home grant lifts the confinement")
    check(&t, policy.set_mask(c("home"), 0) == policy.E_OK && policy.confined(c("home")), "revoking fs.home confines again")
    check(&t, fspolicy.read_ok(c(""), c("/etc/shadow")) && fspolicy.write_ok(c(""), c("/etc/shadow")), "unlabelled caller is never limited")
    check(&t, fspolicy.read_ok(c("jarvis"), c("/etc/shadow")) && fspolicy.write_ok(c("system"), c("/bin/sh")), "non-app labels are never limited")
    check(&t, fspolicy.read_ok(c("app:free"), c("/etc/shadow")) && fspolicy.write_ok(c("app:free"), c("/etc/shadow")), "unconfined app is not limited")
    check(&t, fspolicy.read_ok(c("app:nobody"), c("/etc/shadow")), "app without a table slot is not limited")
    check(&t, fspolicy.read_ok(c("app:home"), c("/etc/shadow")) == false, "app:home confined again after revoke")
    check(&t, fspolicy.read_ok(c("app:box"), c("/data/box/a.txt")) && fspolicy.write_ok(c("app:box"), c("/data/box/a.txt")), "own data folder: read and write")
    check(&t, fspolicy.read_ok(c("app:box"), c("/data/box")) && fspolicy.write_ok(c("app:box"), c("/data/box")), "own data folder itself")
    check(&t, !fspolicy.read_ok(c("app:box"), c("/data/boxer/a.txt")) && !fspolicy.read_ok(c("app:box"), c("/data/bo")), "name prefix is not a folder prefix")
    check(&t, !fspolicy.read_ok(c("app:box"), c("/data/other/a.txt")) && !fspolicy.write_ok(c("app:box"), c("/data/other/a.txt")), "another app's data folder is closed")
    check(&t, !fspolicy.read_ok(c("app:box"), c("/data/xyz/a.txt")) && !fspolicy.write_ok(c("app:box"), c("/data/xyz/a.txt")), "a folder with a same-length name is closed")
    check(&t, !fspolicy.read_ok(c("app:box"), c("/data/dokumente/x.txt")) && !fspolicy.read_ok(c("app:box"), c("/data/bilder")), "the person's documents are closed")
    check(&t, !fspolicy.read_ok(c("app:box"), c("/etc/passwd")) && !fspolicy.read_ok(c("app:box"), c("/etc/apprights.conf")) && !fspolicy.read_ok(c("app:box"), c("/etc/dbgsrv.token")), "secrets under /etc are closed")
    check(&t, !fspolicy.read_ok(c("app:box"), c("/home/justin/x")) && !fspolicy.read_ok(c("app:box"), c("/root/x")) && !fspolicy.read_ok(c("app:box"), c("/mnt/disk/x")), "home, root and mounts are closed")
    check(&t, !fspolicy.read_ok(c("app:box"), c("/dev/hda")) && !fspolicy.read_ok(c("app:box"), c("/dev/nvme0n1")), "raw disks are closed")
    check(&t, fspolicy.read_ok(c("app:box"), c("/dev/null")) && fspolicy.read_ok(c("app:box"), c("/dev/urandom")) && fspolicy.read_ok(c("app:box"), c("/dev/shm/x")), "harmless devices stay open")
    check(&t, fspolicy.read_ok(c("app:box"), c("/bin/sh")) && fspolicy.read_ok(c("app:box"), c("/lib/sans.ttf")) && fspolicy.read_ok(c("app:box"), c("/usr/share/x")), "system programs and libraries are readable")
    check(&t, fspolicy.read_ok(c("app:box"), c("/apps/box.osp/INFO")) && fspolicy.read_ok(c("app:box"), c("/apps")) && fspolicy.read_ok(c("app:box"), c("/")), "bundles and the root are readable")
    check(&t, fspolicy.read_ok(c("app:box"), c("/etc/resolv.conf")) && fspolicy.read_ok(c("app:box"), c("/etc/ssl/ca.pem")), "name server and certificates are readable")
    check(&t, !fspolicy.read_ok(c("app:box"), c("/etc/resolv.conf.bak")) && !fspolicy.read_ok(c("app:box"), c("/binx/y")), "exact entries and prefix entries do not leak to look-alikes")
    check(&t, !fspolicy.read_ok(c("app:box"), c("/data/box/../other/x.txt")) && !fspolicy.read_ok(c("app:box"), c("/data/box/../../etc/secret.txt")) && !fspolicy.read_ok(c("app:box"), c("/bin/../etc/passwd")), "dot-dot escapes are folded and closed")
    check(&t, !fspolicy.write_ok(c("app:box"), c("/data/box/../other/new.txt")) && !fspolicy.write_ok(c("app:box"), c("/data/box/../../tmp/x")), "dot-dot write escapes are closed")
    check(&t, fspolicy.read_ok(c("app:box"), c("/data/other/../box/a.txt")) && fspolicy.write_ok(c("app:box"), c("/data//box/./a.txt")) && fspolicy.read_ok(c("app:box"), c("/etc/../bin/sh")), "dot, dot-dot and double slashes that stay inside are allowed")
    check(&t, !fspolicy.read_ok(c("app:box"), c("/../../etc/passwd")) && fspolicy.read_ok(c("app:box"), c("/../bin/sh")), "dot-dot above the root stays at the root")
    check(&t, !fspolicy.write_ok(c("app:box"), c("/bin/sh")) && !fspolicy.write_ok(c("app:box"), c("/tmp/x")) && !fspolicy.write_ok(c("app:box"), c("/apps/box.osp/INFO")), "system areas are read-only")
    check(&t, !fspolicy.write_ok(c("app:box"), c("/")) && !fspolicy.write_ok(c("app:box"), c("/data")), "root and /data are not writable")
    check(&t, !fspolicy.link_ok(c("app:box")) && fspolicy.link_ok(c("app:free")) && fspolicy.link_ok(c("")), "links are refused for the confined app only")
    check(&t, conf.manifest_sandbox(c("name=x\nsandbox=files\nperm=net\n"), 33) == policy.F_SANDBOX, "manifest: sandbox=files line")
    check(&t, conf.manifest_sandbox(c("name=x\nsandbox=files\r\n"), 24) == policy.F_SANDBOX, "manifest: sandbox=files with CRLF")
    check(&t, conf.manifest_sandbox(c("name=x\nperm=net\n"), 17) == 0, "manifest without the line: not sandboxed")
    check(&t, conf.manifest_sandbox(c("name=x\nsandbox=filesx\n"), 22) == 0 && conf.manifest_sandbox(c("name=x\n#sandbox=files\n"), 22) == 0, "manifest: look-alikes and comments do not count")
    policy.reset()
    check(&t, !policy.sandboxed(c("box")), "reset clears the sandbox flags")

    io.fmt_print(f"checks={t.checks} fails={t.fails}\n")
    if t.fails != 0 {
        return 1
    }
    return 0
}
