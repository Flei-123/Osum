import libc.threadprobe
import libc.syncprobe
import libc.rwprobe
import libc.pthreadprobe
import libc.pthreadxprobe

fn main() -> i32 {
    threadprobe.run_all()
    syncprobe.run_all()
    rwprobe.run_all()
    pthreadprobe.run_all()
    let failed: u64 = pthreadxprobe.run_all()
    if failed == 0 {
        return 0
    }
    return 1
}
