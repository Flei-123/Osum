import libc.octets
import libc.numeric
import libc.hexdigit
import libc.pathname
import libc.textsearch
import libc.text
import libc.locks

static mut lit_s0: [u8; 17] = "/usr/lib/libx.so\0"
static mut lit_s1: [u8; 8] = "libx.so\0"
static mut lit_s2: [u8; 3] = "/x\0"
static mut lit_s3: [u8; 2] = "x\0"
static mut lit_s4: [u8; 4] = "a/b\0"
static mut lit_s5: [u8; 3] = "so\0"
static mut lit_s6: [u8; 7] = "/a.b/c\0"
static mut lit_s7: [u8; 3] = "/a\0"
static mut lit_s8: [u8; 2] = "b\0"
static mut lit_s9: [u8; 5] = "/a/b\0"
static mut lit_s10: [u8; 4] = "/a/\0"
static mut lit_s11: [u8; 3] = "/z\0"
static mut lit_s12: [u8; 1] = "\0"
static mut lit_s13: [u8; 2] = "z\0"
static mut lit_s14: [u8; 4] = "bcd\0"
static mut lit_s15: [u8; 6] = "hello\0"
static mut lit_s16: [u8; 3] = "he\0"
static mut lit_s17: [u8; 4] = "llo\0"
static mut lit_s18: [u8; 3] = "lo\0"
static mut lit_s19: [u8; 3] = "ll\0"
static mut lit_s20: [u8; 3] = "zz\0"
static mut lit_s21: [u8; 6] = "HeLLo\0"
static mut lit_s22: [u8; 6] = "hellp\0"

static mut lit_xlo: [u8; 4] = "xlo\0"

static mut passed: u64 = 0
static mut failed_count: u64 = 0
static mut scratch: [u8; 256] = [0 as u8; 256]
static mut word: [u8; 8] = [0 as u8; 8]

fn check(ok: bool) {
    if ok {
        passed = passed + 1
    } else {
        failed_count = failed_count + 1
    }
}

fn main() -> i32 {
    let w: u64 = (&word[0]) as u64
    octets.st64(w, 0, 0x1122334455667788)
    check(octets.ld8(w, 0) == 0x88)
    check(octets.ld16(w, 0) == 0x7788)
    check(octets.ld32(w, 0) == 0x55667788)
    check(octets.ld64(w, 0) == 0x1122334455667788)
    check(octets.ld32_be(w, 0) == 0x88776655)
    octets.st32_be(w, 0, 0x01020304)
    check(octets.ld8(w, 0) == 1 && octets.ld8(w, 3) == 4)
    check(octets.ld16_be(w, 1) == 0x0203)
    octets.zero(w, 8)
    check(octets.ld64(w, 0) == 0)

    check(numeric.imin(0 - 3, 2) == 0 - 3)
    check(numeric.imax(0 - 3, 2) == 2)
    check(numeric.umin(7, 9) == 7 && numeric.umax(7, 9) == 9)
    check(numeric.iclamp(50, 0, 10) == 10 && numeric.iclamp(0 - 5, 0, 10) == 0)
    check(numeric.uclamp(5, 0, 10) == 5)
    check(numeric.iabs(0 - 9) == 9)

    check(hexdigit.char_of(10) == 97 && hexdigit.char_of(3) == 51)
    check(hexdigit.upper_char_of(11) == 66)
    check(hexdigit.value_of(102) == 15 && hexdigit.value_of(70) == 15)
    check(hexdigit.value_of(103) == hexdigit.NOT_HEX)

    let p: u64 = (&lit_s0[0 as usize]) as u64
    check(text.equal(pathname.base_name(p), (&lit_s1[0 as usize]) as u64))
    check(pathname.parent_length(p) == 8)
    check(pathname.parent_length((&lit_s2[0 as usize]) as u64) == 1)
    check(pathname.parent_length((&lit_s3[0 as usize]) as u64) == 0)
    check(pathname.is_absolute(p) && !pathname.is_absolute((&lit_s4[0 as usize]) as u64))
    check(text.equal(pathname.extension(p), (&lit_s5[0 as usize]) as u64))
    check(pathname.extension((&lit_s6[0 as usize]) as u64) == 0)
    let out: u64 = (&scratch[0]) as u64
    check(pathname.join(out, 256, (&lit_s7[0 as usize]) as u64, (&lit_s8[0 as usize]) as u64) == 4 && text.equal(out, (&lit_s9[0 as usize]) as u64))
    check(pathname.join(out, 256, (&lit_s10[0 as usize]) as u64, (&lit_s8[0 as usize]) as u64) == 4 && text.equal(out, (&lit_s9[0 as usize]) as u64))
    check(pathname.join(out, 256, (&lit_s7[0 as usize]) as u64, (&lit_s11[0 as usize]) as u64) == 2 && text.equal(out, (&lit_s11[0 as usize]) as u64))
    check(pathname.join(out, 256, (&lit_s12[0 as usize]) as u64, (&lit_s13[0 as usize]) as u64) == 1 && text.equal(out, (&lit_s13[0 as usize]) as u64))
    check(pathname.join(out, 4, (&lit_s7[0 as usize]) as u64, (&lit_s14[0 as usize]) as u64) == 0 -% 1)

    check(textsearch.starts_with((&lit_s15[0 as usize]) as u64, (&lit_s16[0 as usize]) as u64) && !textsearch.starts_with((&lit_s16[0 as usize]) as u64, (&lit_s15[0 as usize]) as u64))
    check(textsearch.ends_with((&lit_s15[0 as usize]) as u64, (&lit_s17[0 as usize]) as u64) && !textsearch.ends_with((&lit_s18[0 as usize]) as u64, (&lit_s15[0 as usize]) as u64))
    check(!textsearch.ends_with((&lit_s15[0 as usize]) as u64, (&lit_xlo[0 as usize]) as u64))
    check(textsearch.find_text((&lit_s15[0 as usize]) as u64, (&lit_s19[0 as usize]) as u64) != 0 && textsearch.find_text((&lit_s15[0 as usize]) as u64, (&lit_s20[0 as usize]) as u64) == 0)
    check(textsearch.equal_fold((&lit_s21[0 as usize]) as u64, (&lit_s15[0 as usize]) as u64) && !textsearch.equal_fold((&lit_s15[0 as usize]) as u64, (&lit_s22[0 as usize]) as u64))

    let l: u64 = (&word[0]) as u64
    octets.zero(l, 8)
    check(locks.spin_try(l) && !locks.spin_try(l))
    locks.spin_give(l)
    check(locks.load(l) == 0)
    check(locks.fetch_add(l, 5) == 0 && locks.load(l) == 5)
    check(locks.cas(l, 5, 9) == 5 && locks.load(l) == 9)

    if failed_count != 0 {
        return 1
    }
    return 0
}
