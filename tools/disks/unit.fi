// SPDX-License-Identifier: GPL-2.0-only
// tools/disks/unit.fi -- prints what lib/disks/table.fi reads from the image file `disk.img` in the current
// directory (a host test of the parser; run by tools/disks/run.sh).
import std.rt
import disks.table

static mut img: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }

fn read_sectors(lba: u64, n: u64, dst: u64) -> u64 {
    let off: u64 = lba * 512
    let want: u64 = n * 512
    if off + want > img.len as u64 {
        return 1
    }
    var i: u64 = 0
    while i < want {
        *((dst + i) as *mut u8) = *((img.ptr as u64 + off + i) as *mut u8)
        i = i + 1
    }
    return 0
}

fn add_s(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn add_c(b: *mut rt.Buf, p: u64) {
    rt.buf_push_bytes(b, p, rt.c_length(p))
}

fn add_n(b: *mut rt.Buf, v: u64) {
    rt.buf_push_dec_u64(b, v)
}

fn main() -> i32 {
    var tab: [u8; 2312] = [0 as u8; 2312]
    var scratch: [u8; 17408] = [0 as u8; 17408]
    var path: [u8; 9] = "disk.img\0"
    if !rt.read_file((&path[0]) as u64, &img) {
        return 3 as i32
    }
    let total: u64 = img.len as u64 / 512
    let t: u64 = (&tab[0]) as u64
    let sch: u64 = table.read_table(read_sectors, total, t, (&scratch[0]) as u64)
    var o: rt.Buf = rt.buf_new()
    add_s(&o, "scheme ")
    add_c(&o, table.scheme_word(sch))
    add_s(&o, " count ")
    add_n(&o, table.count(t))
    add_s(&o, " total ")
    add_n(&o, table.total_of(t))
    add_s(&o, " first ")
    add_n(&o, table.first_usable(t))
    add_s(&o, " last ")
    add_n(&o, table.last_usable(t))
    add_s(&o, " flags ")
    add_n(&o, table.flags_of(t))
    add_s(&o, "\n")
    var i: u64 = 0
    while i < table.count(t) {
        add_s(&o, "part ")
        add_n(&o, i + 1)
        add_s(&o, " start ")
        add_n(&o, table.start_of(t, i))
        add_s(&o, " sectors ")
        add_n(&o, table.sectors_of(t, i))
        add_s(&o, " kind ")
        add_c(&o, table.kind_word(table.kind_of(t, i)))
        add_s(&o, " name ")
        add_c(&o, table.name_of(t, i))
        add_s(&o, "\n")
        i = i + 1
    }
    rt.write_everything(1, o.ptr as u64, o.len)
    rt.buf_free(&o)
    return 0 as i32
}
