profile kernel

import ulib

export { u_start }

const CHUNK: u64 = 8192

fn u_start(args: u64) -> u64 {
    var usage: [u8; 26] = "usage: wbcopy <src> <dst>\0"
    var cannot: [u8; 15] = "wbcopy: failed\0"
    if ulib.arg_count(args) < 3 {
        ulib.esay_line((&usage[0 as usize]) as u64, 0)
        return 2
    }
    let src: u64 = ulib.arg_at(args, 1)
    let dst: u64 = ulib.arg_at(args, 2)
    let in_fd: u64 = ulib.sys(ulib.SYS_OPEN, src, 0, 0)
    if ulib.bad(in_fd) {
        ulib.esay_line((&cannot[0 as usize]) as u64, src)
        return 1
    }
    ulib.sys(ulib.SYS_UNLINK, dst, 0, 0)
    let out_fd: u64 = ulib.sys(ulib.SYS_OPEN, dst, ulib.O_MAKE, 0)
    if ulib.bad(out_fd) {
        ulib.esay_line((&cannot[0 as usize]) as u64, dst)
        return 1
    }
    var buf: [u8; 8192] = [0 as u8; 8192]
    var code: u64 = 0
    var going: bool = true
    while going {
        let n: u64 = ulib.sys(ulib.SYS_READ, in_fd, (&buf[0 as usize]) as u64, CHUNK)
        if n == 0 || ulib.bad(n) {
            going = false
        } else {
            let w: u64 = ulib.sys(ulib.SYS_WRITE, out_fd, (&buf[0 as usize]) as u64, n)
            if ulib.bad(w) || w != n {
                code = 1
                going = false
            }
        }
    }
    ulib.sys(ulib.SYS_CLOSE, in_fd, 0, 0)
    ulib.sys(ulib.SYS_CLOSE, out_fd, 0, 0)
    return code
}
