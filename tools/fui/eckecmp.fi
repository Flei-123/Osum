// tools/fui/eckecmp.fi -- ROUND FUI-ALL (r42): lib/ecke.corner_cov, now
// a front for fUi's core.corner_coverage, against the probe loop it had
// before (copied here verbatim), for every pixel of r = 1..48 including
// the shortcut cases just outside and inside the circle.
//
//   FIRNLIB=$(pwd)/lib vendor/firn/bin/firnc tools/fui/eckecmp.fi -o /tmp/eckecmp.bin && /tmp/eckecmp.bin
//
// Prints "pixels N differ 0" and exits 0 when both agree.
import ecke
import std.io

fn old_cov(dx: u64, dy: u64, r: u64) -> u64 {
    if r == 0 {
        return 255
    }
    let rr: u64 = r *% r
    if (dx + 1) * (dx + 1) + (dy + 1) * (dy + 1) <= rr {
        return 255
    }
    if dx * dx + dy * dy >= rr {
        return 0
    }
    var hits: u64 = 0
    var sy: u64 = 0
    while sy < 4 {
        var sx: u64 = 0
        while sx < 4 {
            let px8: u64 = dx *% 8 +% sx *% 2 +% 1
            let py8: u64 = dy *% 8 +% sy *% 2 +% 1
            if px8 *% px8 +% py8 *% py8 <= (r *% 8) *% (r *% 8) {
                hits = hits + 1
            }
            sx = sx + 1
        }
        sy = sy + 1
    }
    return hits * 255 / 16
}

fn main() -> i32 {
    var diff: u64 = 0
    var n: u64 = 0
    var r: u64 = 0
    while r <= 48 {
        var dy: u64 = 0
        while dy < r + 2 {
            var dx: u64 = 0
            while dx < r + 2 {
                if ecke.corner_cov(dx, dy, r) != old_cov(dx, dy, r) {
                    diff = diff + 1
                }
                n = n + 1
                dx = dx + 1
            }
            dy = dy + 1
        }
        r = r + 1
    }
    io.fmt_print_line(f"pixels {n} differ {diff}")
    if diff != 0 {
        return 1
    }
    return 0
}
