// SPDX-License-Identifier: GPL-2.0-only
// tools/fui/eckecmp.fi -- lib/ecke.corner_cov (8x8 probes) against a 32x32 reference
// for every pixel of r = 0..48; tolerance 12 levels of 255.
//
//   FIRNLIB=$(pwd)/lib vendor/firn/bin/firnc tools/fui/eckecmp.fi -o $TMPDIR/eckecmp.bin && $TMPDIR/eckecmp.bin
import ecke
import std.io

fn ref_cov(dx: u64, dy: u64, r: u64) -> u64 {
    if r == 0 {
        return 255
    }
    var hits: u64 = 0
    var sy: u64 = 0
    while sy < 32 {
        var sx: u64 = 0
        while sx < 32 {
            let px: u64 = dx * 64 + sx * 2 + 1
            let py: u64 = dy * 64 + sy * 2 + 1
            if px * px + py * py <= (r * 64) * (r * 64) {
                hits = hits + 1
            }
            sx = sx + 1
        }
        sy = sy + 1
    }
    return hits * 255 / 1024
}

fn main() -> i32 {
    var diff: u64 = 0
    var worst: u64 = 0
    var n: u64 = 0
    var r: u64 = 0
    while r <= 48 {
        var dy: u64 = 0
        while dy < r + 2 {
            var dx: u64 = 0
            while dx < r + 2 {
                let a: u64 = ecke.corner_cov(dx, dy, r)
                let b: u64 = ref_cov(dx, dy, r)
                var d: u64 = 0
                if a > b {
                    d = a - b
                } else {
                    d = b - a
                }
                if d > worst {
                    worst = d
                }
                if d > 12 {
                    diff = diff + 1
                }
                n = n + 1
                dx = dx + 1
            }
            dy = dy + 1
        }
        r = r + 1
    }
    io.fmt_print_line(f"pixels {n} worst {worst} over12 {diff}")
    if diff != 0 {
        return 1
    }
    return 0
}
