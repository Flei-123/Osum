// tools/haertung/nachweis.fi -- DER NACHWEIS ZU BEFUND 1.
//
// RUNDE HAERTUNG-2. Die Behauptung, die geprueft wird:
//
//   "buf_grow schweigt bei OOM: cap bleibt alt, der Aufrufer schreibt
//    danach ueber das Pufferende -- STILLER HEAP-OVERFLOW."
//
// Geprueft wird durch MESSEN, nicht durch Lesen. `heap_alloc` wird ECHT
// zum Scheitern gebracht: das Programm frisst seinen eigenen Adressraum
// auf, bis mmap nein sagt. Kein Schalter im Code, keine Nachbildung --
// dieselbe Absage, die eine erschoepfte Arena gibt.
//
// AUFRUF:  nachweis <fall> [hunger]
//
//   fall 1  buf_push          ueber die Grenze
//   fall 2  buf_push_bytes    ueber die Grenze
//   fall 3  buf_reserve + eigene Schreibschleife, MIT Pruefung
//   fall 4  dasselbe OHNE Pruefung -- die GEGENPROBE, die fallen MUSS
//
//   ohne `hunger`: die Arena ist satt (Gegenprobe, alles muss heil sein)
//   mit  `hunger`: die Arena ist leer, bevor ueber die Grenze geht
//
// AUSGABE, eine Zeile je Lauf:
//   fall=<n>  capvor=<x>  capnach=<y>  len=<l>  kanarie=<0|1>
//
// DER AUFBAU, und warum er so ist:
//
// Der Nutzpuffer bekommt eine GANZE Seite (4096), der Buf aber nur
// `cap = KAP` (128). Ein Ueberlauf bleibt damit INNERHALB einer
// zugeteilten Seite: er loest KEINEN Seitenfehler aus und faellt nur am
// ueberschriebenen Wert auf. Genau das ist die Fehlerform, um die es
// geht -- sie ist STILL. Ein Test, der auf SIGSEGV wartet, wuerde sie
// nie sehen.
//
// ZWEI SEITEN, und die Reihenfolge ist gemessen: mmap ohne feste
// Adresse waechst auf diesem Wirt NACH UNTEN (73d57c78e000, dann
// 73d57c78d000). Die zweite Zuteilung ist also die UNTERE und traegt
// den Buf; die erste liegt darueber und traegt den Kanarienvogel.
// Stimmt die Nachbarschaft nicht, bricht der Lauf mit 2 ab, statt gruen
// zu melden.
//
// Der Buf kennt die obere Seite nicht -- `buf_grow` gibt sie also nie
// frei, und der Vogel ueberlebt beide Ausgaenge. (Im ersten Anlauf lag
// er in der Seite des Buf, `buf_grow` gab sie bei Erfolg per heap_free
// zurueck, und der Lesezugriff danach war ein SIGSEGV.)
import std.rt
import kanarie

const KAP: usize = 128

fn sag(o: *mut rt.Buf, s: u64, n: usize) {
    rt.buf_push_bytes(o, s, n)
}

// Rueckgabe: 1 = Kanarienvogel heil, 0 = ueberschrieben,
//            2 = Seiten nicht benachbart, 3 = kein Speicher fuer den Aufbau.
fn lauf(fall: u64, hunger: u64, o: *mut rt.Buf) -> u64 {
    let oben: u64 = rt.heap_alloc(4096)
    if oben == 0 {
        return 3
    }
    let unten: u64 = rt.heap_alloc(4096)
    if unten == 0 {
        return 3
    }
    if oben != unten + 4096 {
        return 2
    }
    let page: u64 = unten + 4096 - KAP as u64
    kanarie.canary_set(page + KAP as u64)

    var b: rt.Buf = rt.Buf { ptr: page, len: 0, cap: KAP }

    // Bis an die Grenze fuellen -- das geht immer und ruehrt den
    // Kanarienvogel nicht an.
    var i: usize = 0
    while i < KAP {
        rt.buf_push(&b, 65 as u8)
        i = i + 1
    }
    let cap_vor: usize = b.cap

    // DIE ARENA ERSCHOEPFEN. `ulimit -v` allein reicht NICHT: der
    // Prozess hat unter dem Limit noch Luft, und `buf_grow` bekommt
    // seine 256 Oktett anstandslos (gemessen: capnach=256 bei jedem
    // Limit bis hinunter zu 4200 KiB). Also wird der Adressraum HIER
    // aufgebraucht.
    //
    // ZWEI STUFEN, und die zweite ist noetig: erst grob (64 KiB), bis
    // nichts Grosses mehr kommt -- das geht schnell. Dann FEIN (eine
    // Seite), bis auch die kleinste Zuteilung abgelehnt wird. Ohne die
    // feine Stufe bekam `buf_grow` seine 256 Oktett weiter (gemessen:
    // 509 grobe Runden, danach lieferte heap_alloc(256) immer noch eine
    // Adresse).
    if hunger != 0 {
        var frass: u64 = 1
        var runden: u64 = 0
        while frass != 0 && runden < 1000000 {
            frass = rt.heap_alloc(65536)
            runden = runden + 1
        }
        frass = 1
        runden = 0
        while frass != 0 && runden < 1000000 {
            frass = rt.heap_alloc(4096)
            runden = runden + 1
        }
    }

    if fall == 1 {
        var k: usize = 0
        while k < 64 {
            rt.buf_push(&b, 66 as u8)
            k = k + 1
        }
    }
    if fall == 2 {
        var quelle: [u8; 64] = [67 as u8; 64]
        rt.buf_push_bytes(&b, (&quelle[0]) as u64, 64)
    }
    if fall == 3 {
        // DER GEHEILTE AUFRUFER: der Rueckgabewert wird ANGESEHEN.
        // Genau das war vorher unmoeglich -- `buf_reserve` gab nichts
        // zurueck.
        if rt.buf_reserve(&b, KAP + 64) {
            var j: usize = 0
            while j < 64 {
                rt.st8(b.ptr, KAP + j, 68 as u8)
                j = j + 1
            }
            b.len = KAP + 64
        }
    }
    if fall == 4 {
        // DIE GEGENPROBE: der ALTE Aufrufer, der den Rueckgabewert
        // NICHT ansieht. Er MUSS weiter ueberlaufen -- sonst misst
        // dieser Nachweis nichts. Eine Zusage, deren Gegenprobe nicht
        // faellt, ist eine Behauptung.
        let _egal: bool = rt.buf_reserve(&b, KAP + 64)
        var j4: usize = 0
        while j4 < 64 {
            rt.st8(b.ptr, KAP + j4, 68 as u8)
            j4 = j4 + 1
        }
        b.len = KAP + 64
    }

    let heil: u64 = kanarie.canary_intact(page + KAP as u64)

    var s_fall: [u8; 6] = "fall=\0"
    var s_cv: [u8; 10] = "  capvor=\0"
    var s_cn: [u8; 11] = "  capnach=\0"
    var s_len: [u8; 7] = "  len=\0"
    var s_kan: [u8; 11] = "  kanarie=\0"
    sag(o, (&s_fall[0]) as u64, 5)
    rt.buf_push_dec_u64(o, fall)
    sag(o, (&s_cv[0]) as u64, 9)
    rt.buf_push_dec_u64(o, cap_vor as u64)
    sag(o, (&s_cn[0]) as u64, 10)
    rt.buf_push_dec_u64(o, b.cap as u64)
    sag(o, (&s_len[0]) as u64, 6)
    rt.buf_push_dec_u64(o, b.len as u64)
    sag(o, (&s_kan[0]) as u64, 10)
    rt.buf_push_dec_u64(o, heil)
    rt.buf_push(o, 10 as u8)
    // SOFORT hinaus und leeren -- aus zwei Gruenden. Erstens hat ein
    // gesammelter Ausgabepuffer den ersten Anlauf still verschluckt
    // (`heap_free` in `buf_grow` gab die Seite zurueck, in der er lag).
    // Zweitens ist nach dem Erschoepfen der Arena kein Platz mehr, um
    // ihn wachsen zu lassen.
    rt.write_everything(1, (*o).ptr, (*o).len)
    rt.buf_clear(o)
    return heil
}

fn main(start: u64) -> i32 {
    // Der Ausgabepuffer bekommt seinen Platz, BEVOR gehungert wird.
    var o: rt.Buf = rt.buf_new()
    rt.buf_reserve(&o, 4096)

    // JE LAUF EIN EIGENER PROZESS, und das ist keine Umstaendlichkeit:
    // wer die Arena einmal leergeraeumt hat, bekommt auch fuer den
    // NAECHSTEN Fall keine Seite mehr -- die Faelle 2 und 3 brachen im
    // ersten Anlauf mit 3 ab, weil Fall 1 vorher alles gefressen hatte.
    // run.sh ruft dieses Programm deshalb je Fall einmal.
    var fall: u64 = 1
    var hunger: u64 = 0
    if rt.arg_count(start) > 1 {
        let p1: u64 = rt.arg_ptr(start, 1)
        if rt.ld8(p1, 0) == 50 as u8 {
            fall = 2
        }
        if rt.ld8(p1, 0) == 51 as u8 {
            fall = 3
        }
        if rt.ld8(p1, 0) == 52 as u8 {
            fall = 4
        }
    }
    if rt.arg_count(start) > 2 {
        hunger = 1
    }

    let heil: u64 = lauf(fall, hunger, &o)
    if heil == 1 {
        return 0
    }
    if heil == 2 {
        return 4
    }
    if heil == 3 {
        return 3
    }
    return 1
}
