// tools/haertung/kanarie.fi -- DER KANARIENVOGEL HINTER DEM PUFFER.
//
// RUNDE HAERTUNG-2, Befund 1. Diese Datei liegt in tools/ und NICHT in
// vendor/firn/lib/ -- das ist kein Geschmack, sondern Erfahrung dieser
// Runde: `fetch-firnc.sh --force` raeumt vendor/firn/lib/ mit `rm -rf`
// weg und legt es aus dem festgenagelten Commit neu an. Der erste
// Anlauf lag dort, ein --force lief dazwischen, und der Nachweis war
// weg.
//
// PROTOKOLL-BEFUND, DER HIER ZAEHLT: firnc entfernt ungenutzte
// Lesezugriffe. Ein Kanarienvogel, dessen Wert niemand ansieht, wird
// wegoptimiert, und der Test laeuft gruen durch, ohne etwas geprueft zu
// haben (in Runde PROTOKOLL lief so ein Nullzeigertest durch). Deshalb
// geht sein Wert HIER in die Ausgabe -- was gedruckt wird, kann nicht
// wegfallen.
import std.rt

export { canary_set, canary_intact, BRAND }

// Ein Muster, das nicht zufaellig entsteht: kein 0, kein 0xFF.
const BRAND: u64 = 0xC0FFEE5AA5DEAD11

fn canary_set(p: u64) {
    rt.st64(p, 0, BRAND)
}

// 1 = lebt, 0 = ueberschrieben. Der Rueckgabewert wird vom Aufrufer
// GEDRUCKT -- damit bleibt der Lesezugriff stehen.
fn canary_intact(p: u64) -> u64 {
    if rt.ld64(p, 0) == BRAND {
        return 1
    }
    return 0
}
