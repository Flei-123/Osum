import std.rt
import std.io
import drv.hid.kbdlay
import keymap.kbdnames
import drv.hid.kbdcomb
import drv.hid.kbdmap
import drv.hid.kbddead
import drv.hid.kbdcompose
import drv.hid.kbdinput

fn dump_layouts() {
    var lay: u64 = 0
    while lay < kbdnames.COUNT {
        var code: u64 = 1
        while code < 128 {
            var level: u64 = 0
            while level < 8 {
                let e: u64 = kbdmap.entry(lay, code, (level & 1) != 0, (level & 2) != 0, (level & 4) != 0)
                let c: u64 = kbdmap.char_of(lay, code, (level & 1) != 0, (level & 2) != 0, (level & 4) != 0)
                io.fmt_print(f"L {lay} {code} {level} {e} {c}\n")
                level = level + 1
            }
            code = code + 1
        }
        lay = lay + 1
    }
}

fn dump_spacing() {
    var id: u64 = 0
    while id < 64 {
        if kbddead.spacing(id) != 0 {
            io.fmt_print(f"S {id} {kbddead.spacing(id)}\n")
        }
        id = id + 1
    }
}

fn dump_dead() {
    var id: u64 = 0
    while id < 64 {
        if kbddead.spacing(id) != 0 {
            kbdinput.reset()
            let ds: u64 = kbdinput.feed_entry(kbdlay.DEAD_FLAG | id)
            let dd: u64 = kbdinput.feed_entry(kbdlay.DEAD_FLAG | id)
            io.fmt_print(f"DD {id} {ds} {dd}\n")
            var other: u64 = 0
            while other < 64 {
                if kbddead.spacing(other) != 0 && other != id {
                    kbdinput.reset()
                    let x0: u64 = kbdinput.feed_entry(kbdlay.DEAD_FLAG | id)
                    let x1: u64 = kbdinput.feed_entry(kbdlay.DEAD_FLAG | other)
                    let x2: u64 = kbdinput.feed_entry(65)
                    io.fmt_print(f"DX {id} {other} {x0} {x1} {x2}\n")
                }
                other = other + 1
            }
            var base: u64 = 32
            while base < 0x2200 {
                kbdinput.reset()
                let p: u64 = kbdinput.feed_entry(kbdlay.DEAD_FLAG | id)
                let out: u64 = kbdinput.feed_entry(base)
                io.fmt_print(f"D {id} {base} {p} {kbddead.first_of(out)} {kbddead.second_of(out)}\n")
                base = base + 1
            }
        }
        id = id + 1
    }
    kbdinput.reset()
}

fn compose_chars(i: u64) -> u64 {
    if i < 95 {
        return 32 + i
    }
    return 0xA0 + (i - 95)
}

fn dump_compose() {
    var i: u64 = 0
    while i < 191 {
        var j: u64 = 0
        while j < 191 {
            let a: u64 = compose_chars(i)
            let b: u64 = compose_chars(j)
            kbdinput.reset()
            kbdinput.compose_key()
            let r0: u64 = kbdinput.feed_entry(a)
            let r1: u64 = kbdinput.feed_entry(b)
            let after: u64 = kbdinput.feed_entry(97)
            io.fmt_print(f"C {a} {b} {r0} {r1} {after}\n")
            j = j + 1
        }
        i = i + 1
    }
    kbdinput.reset()
}

fn main() -> i32 {
    io.fmt_print(f"COUNT {kbdnames.COUNT} SLOTS {kbdlay.SLOTS} DEAD_N {kbdcomb.DEAD_N} COMPOSE_N {kbdcomb.COMPOSE_N}\n")
    dump_spacing()
    dump_layouts()
    dump_dead()
    dump_compose()
    return 0
}
