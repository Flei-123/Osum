profile kernel

import ulib

export { u_start }

fn hex_digit(v: u64) -> u8 {
    if v < 10 {
        return (48 + v) as u8
    }
    return (87 + v) as u8
}

fn dump_at(fd: u64, off: u64) {
    var s_off: [u8; 5] = "off=\0"
    var s_hex: [u8; 6] = " hex=\0"
    var buf: [u8; 16] = [0 as u8; 16]
    var out: [u8; 33] = [0 as u8; 33]
    ulib.say((&s_off[0 as usize]) as u64)
    ulib.sayu(off)
    ulib.say((&s_hex[0 as usize]) as u64)
    let w: u64 = ulib.sys(ulib.SYS_SEEK, fd, off, ulib.SEEK_SET)
    var n: u64 = 0
    if !ulib.bad(w) {
        n = ulib.sys(ulib.SYS_READ, fd, (&buf[0 as usize]) as u64, 16)
    }
    if ulib.bad(n) {
        n = 0
    }
    var i: u64 = 0
    while i < n {
        let c: u64 = buf[i as usize] as u64
        out[(i * 2) as usize] = hex_digit(c >> 4)
        out[(i * 2 + 1) as usize] = hex_digit(c & 15)
        i = i + 1
    }
    out[(n * 2) as usize] = 0 as u8
    ulib.say((&out[0 as usize]) as u64)
    ulib.nl()
}

fn u_start(args: u64) -> u64 {
    var s_size: [u8; 6] = "size=\0"
    let argc: u64 = ulib.arg_count(args)
    if argc < 2 {
        return 2
    }
    let path: u64 = ulib.arg_at(args, 1)
    let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, 0, 0)
    if ulib.bad(fd) {
        return 1
    }
    ulib.say((&s_size[0 as usize]) as u64)
    ulib.sayu(ulib.size_of(path))
    ulib.nl()
    var k: u64 = 2
    while k < argc {
        dump_at(fd, ulib.to_num(ulib.arg_at(args, k)))
        k = k + 1
    }
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return 0
}
