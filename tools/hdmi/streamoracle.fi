import std.rt
import std.io
import monitors.hdmipin
import monitors.hdmistream

fn chk(name: str, cond: bool) {
    if cond {
        io.print("OK   ")
    } else {
        io.print("FAIL ")
    }
    io.print_line(name)
}

fn main() -> i32 {
    chk("format: 48000 Hz 16 bit 2 ch = 0x0011", hdmistream.format_word(48000, 16, 2) == 0x0011)
    chk("format: 44100 Hz 16 bit 2 ch = 0x4011", hdmistream.format_word(44100, 16, 2) == 0x4011)
    chk("format: 96000 Hz 24 bit 8 ch = 0x0837", hdmistream.format_word(96000, 24, 8) == 0x0837)
    chk("format: 32000 Hz = base 48k x2 / 3", hdmistream.format_word(32000, 16, 2) == ((1 << 11) | (2 << 8) | 0x11))
    chk("format: 12345 Hz is refused", hdmistream.format_word(12345, 16, 2) == hdmistream.NO_FORMAT)
    chk("format: 12 bit is refused", hdmistream.format_word(48000, 12, 2) == hdmistream.NO_FORMAT)
    chk("encode: long verb 0x706 on nid 3", hdmistream.encode(0, 3, hdmistream.V_SET_STREAM, 0x10) == 0x00370610)
    chk("encode: short verb format on nid 3", hdmistream.encode(0, 3, hdmistream.V_SET_FORMAT, 0x0011) == 0x00320011)
    hdmistream.plan_stream(0x400, 1, 0, 0x0011, 2)
    chk("stream plan: power, format, channel count, stream, digital enable", hdmipin.plan_len() == 5 && hdmipin.plan_verb(1) == hdmistream.V_SET_FORMAT && hdmipin.plan_verb(2) == hdmistream.V_SET_CHANCOUNT && hdmipin.plan_payload(2) == 1 && hdmipin.plan_verb(3) == hdmistream.V_SET_STREAM && hdmipin.plan_payload(3) == 0x10 && hdmipin.plan_verb(4) == hdmipin.V_SET_DIGI1)
    hdmistream.plan_stream(0x400, 1, 0, hdmistream.NO_FORMAT, 2)
    chk("stream plan: no format means no verbs", hdmipin.plan_len() == 0)
    hdmistream.plan_stop()
    chk("stop plan: stream tag 0", hdmipin.plan_len() == 1 && hdmipin.plan_payload(0) == 0)
    hdmistream.ai_build(2)
    chk("infoframe: header 84 01 0A, 2 channels, checksum zero-sum", hdmistream.ai_byte(0) == 0x84 && hdmistream.ai_byte(1) == 1 && hdmistream.ai_byte(2) == 10 && hdmistream.ai_byte(4) == 1 && hdmistream.ai_checksum_ok())
    chk("infoframe: 2 channels checksum byte = 0x70", hdmistream.ai_byte(3) == 0x70)
    hdmistream.ai_build(8)
    chk("infoframe: 8 channels allocation 0x13 and zero-sum", hdmistream.ai_byte(4) == 7 && hdmistream.ai_byte(7) == 0x13 && hdmistream.ai_checksum_ok())
    hdmistream.plan_infoframe(2)
    chk("infoframe plan: off, index, 14 data, best-effort transmit", hdmipin.plan_len() == 17 && hdmipin.plan_verb(0) == hdmistream.V_DIP_XMIT && hdmipin.plan_payload(0) == 0 && hdmipin.plan_verb(16) == hdmistream.V_DIP_XMIT && hdmipin.plan_payload(16) == 0xC0)
    chk("rate flags: 32k 44.1k 48k 96k 192k match the ELD bit order", hdmistream.rate_flag(32000) == 1 && hdmistream.rate_flag(44100) == 2 && hdmistream.rate_flag(48000) == 4 && hdmistream.rate_flag(96000) == 16 && hdmistream.rate_flag(192000) == 64)
    chk("rate flags: unknown rate is 0", hdmistream.rate_flag(12345) == 0)
    return 0
}
