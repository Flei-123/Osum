import std.rt
import std.io
import spirv.spv
import spirv.parse
import spirv.validate
import spirv.lower

fn probe(path: u64, stage: u32, dump: bool) -> i32 {
    var b: rt.Buf = rt.buf_new()
    if !rt.read_file(path, &b) {
        io.print("probe: cannot read file\n")
        return 2
    }
    let prog: u64 = rt.heap_alloc(40000 * 20 + 64)
    rt.mem_set(prog, 0 as u8, 40000 * 20 + 64)
    var info: lower.LowerInfo = lower.info_zero()
    var m: parse.Module = parse.module_zero()
    var e: u32 = parse.module_open(&m, rt.buf_ptr(&b), rt.buf_len(&b) / 4)
    if e == 0 { e = validate.validate(&m) }
    var le: u32 = 0
    if e == 0 { le = lower.lower_stage(&m, stage, prog, 40000, &info) }
    let vpos: usize = m.err_pos
    parse.module_close(&m)
    io.fmt_print(f"probe: parse={parse.err_name(e)} at word {vpos} lower={lower.lower_err_name(le)} at word {info.err_pos} instr={info.ninstr} regs={info.peak_reg} sample={info.nsample} kill={info.nkill} tex={info.ntex} ubo={info.nubo} flat={info.nflat}\n")
    if dump && e == 0 && le == 0 {
        var q: usize = 0
        while q < info.ninstr {
            io.fmt_print(f"{q}: op {rt.ld32(prog, q * 5)} d {rt.ld32(prog, q * 5 + 1)} a {rt.ld32(prog, q * 5 + 2)} b {rt.ld32(prog, q * 5 + 3)} c {rt.ld32(prog, q * 5 + 4)}\n")
            q = q + 1
        }
    }
    if e != 0 || le != 0 { return 1 }
    return 0
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        io.print("usage: probe vs|fs file.spv\n")
        return 2
    }
    let kind: u64 = rt.arg_ptr(start, 1)
    var stage: u32 = spv.EM_FRAGMENT
    if rt.ld8(kind, 0) == 118 as u8 { stage = spv.EM_VERTEX }
    return probe(rt.arg_ptr(start, 2), stage, rt.arg_count(start) > 3)
}
