profile kernel

import ulib

import libc.clockapi
export { u_start }

const SYS_GETEUID: u64 = 107

const SYS_SOCKET: u64 = 41
const SYS_BIND: u64 = 49
const SYS_LISTEN: u64 = 50
const SYS_ACCEPT: u64 = 43
const AF_UNIX: u64 = 1
const SOCK_STREAM: u64 = 1
const SUN_HEADER: u64 = 2

fn bind_socket(path: u64) -> u64 {
    var sa: [u8; 112] = [0 as u8; 112]
    sa[0 as usize] = AF_UNIX as u8
    var n: u64 = 0
    while n < 100 && *((path + n) as *mut u8) != 0 as u8 {
        sa[(SUN_HEADER + n) as usize] = *((path + n) as *mut u8)
        n = n + 1
    }
    let fd: u64 = ulib.sys(SYS_SOCKET, AF_UNIX, SOCK_STREAM, 0)
    if ulib.bad(fd) {
        return ulib.EOF
    }
    ulib.sys(SYS_BIND, fd, (&sa[0 as usize]) as u64, SUN_HEADER + n + 1)
    ulib.sys(SYS_LISTEN, fd, 4, 0)
    return fd
}

fn accept_forever(fd: u64) {
    while true {
        let c: u64 = ulib.sys(SYS_ACCEPT, fd, 0, 0)
        if ulib.bad(c) {
            clockapi.sleep_ms(100)
        } else {
            ulib.sys(ulib.SYS_CLOSE, c, 0, 0)
        }
    }
}

fn u_start(args: u64) -> u64 {
    var l_stub: [u8; 10] = "xfxstub: \0"
    var l_uid: [u8; 6] = " uid=\0"
    var l_home: [u8; 7] = " home=\0"
    var l_xdg: [u8; 6] = " xdg=\0"
    var l_arg: [u8; 7] = " args=\0"
    var k_home: [u8; 5] = "HOME\0"
    var k_xdg: [u8; 16] = "XDG_RUNTIME_DIR\0"
    var none: [u8; 2] = "-\0"
    let first: u64 = ulib.arg_at(args, 0)
    ulib.say((&l_stub[0 as usize]) as u64)
    ulib.say(first)
    ulib.say((&l_uid[0 as usize]) as u64)
    ulib.sayu(ulib.sys(SYS_GETEUID, 0, 0, 0))
    ulib.say((&l_home[0 as usize]) as u64)
    var h: u64 = ulib.env_get(args, (&k_home[0 as usize]) as u64)
    if h == 0 {
        h = (&none[0 as usize]) as u64
    }
    ulib.say(h)
    ulib.say((&l_xdg[0 as usize]) as u64)
    var x: u64 = ulib.env_get(args, (&k_xdg[0 as usize]) as u64)
    if x == 0 {
        x = (&none[0 as usize]) as u64
    }
    ulib.say(x)
    ulib.say((&l_arg[0 as usize]) as u64)
    ulib.sayu(ulib.arg_count(args))
    ulib.nl()
    if *(first as *mut u8) == 119 as u8 && ulib.arg_count(args) > 1 {
        let ls: u64 = bind_socket(ulib.arg_at(args, 1))
        if !ulib.bad(ls) {
            accept_forever(ls)
        }
    }
    while true {
        clockapi.sleep_ms(1000)
    }
    return 0
}
