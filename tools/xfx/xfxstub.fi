profile kernel

import ulib

export { u_start }

const SYS_GETEUID: u64 = 107

fn u_start(args: u64) -> u64 {
    var l_stub: [u8; 10] = "xfxstub: \0"
    var l_uid: [u8; 6] = " uid=\0"
    var l_home: [u8; 7] = " home=\0"
    var l_xdg: [u8; 6] = " xdg=\0"
    var l_arg: [u8; 7] = " args=\0"
    var k_home: [u8; 5] = "HOME\0"
    var k_xdg: [u8; 16] = "XDG_RUNTIME_DIR\0"
    var none: [u8; 2] = "-\0"
    var d: [u8; 2] = "x\0"
    let first: u64 = ulib.arg_at(args, 0)
    ulib.say((&l_stub[0 as usize]) as u64)
    ulib.say(first)
    ulib.say((&l_uid[0 as usize]) as u64)
    ulib.sayu(ulib.sys(SYS_GETEUID, 0, 0, 0))
    ulib.say((&l_home[0 as usize]) as u64)
    var h: u64 = ulib.env_get(args, (&k_home[0 as usize]) as u64)
    if h == 0 {
        h = (&none[0 as usize]) as u64
    }
    ulib.say(h)
    ulib.say((&l_xdg[0 as usize]) as u64)
    var x: u64 = ulib.env_get(args, (&k_xdg[0 as usize]) as u64)
    if x == 0 {
        x = (&none[0 as usize]) as u64
    }
    ulib.say(x)
    ulib.say((&l_arg[0 as usize]) as u64)
    ulib.sayu(ulib.arg_count(args))
    ulib.nl()
    if *(first as *mut u8) == 119 as u8 && ulib.arg_count(args) > 1 {
        let fd: u64 = ulib.sys(ulib.SYS_OPEN, ulib.arg_at(args, 1), ulib.O_MAKE, 420)
        if !ulib.bad(fd) {
            ulib.sys(ulib.SYS_WRITE, fd, (&d[0 as usize]) as u64, 1)
            ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
        }
    }
    while true {
        ulib.sleep_ms(1000)
    }
    return 0
}
