# Das Paket `linux-abi` -- DER INTERPRETER, UND NUR ER.
#
# Was hier drin ist: die EINE fremde Binaerdatei, ohne die kein dynamisch
# gelinktes Linux-Programm startet -- musls `ld-musl-x86_64.so.1`, die
# zugleich `libc.so` ist. Sie laeuft in RING 3 wie jedes andere Programm.
#
# WAS HIER NICHT DRIN IST, und das ist der Punkt dieses Pakets: die
# Faehigkeit des KERNS, ein Bild mit PT_INTERP zu laden (ET_DYN, der
# System-V-Startstapel mit auxv). Die steht in kernel/elf.fi und laesst
# sich nicht paketieren -- sie kostet aber auch nichts, solange niemand
# ein solches Bild startet: ein Programm ohne PT_INTERP geht denselben
# Weg wie vor der Runde DYNLADER. Die Messung dazu steht in
# docs/RUNDE-DYNLADER.md Abschnitt 8.
#
# HERKUNFT DER DATEI: musl 1.2.3-1 (Debian), MIT, Rich Felker und
# Mitwirkende, https://musl.libc.org/. UNVERAENDERT uebernommen --
# tools/dynlader/herkunft.sh rechnet die SHA-256 nach.
name=linux-abi
fassung=1.2.3
titel=Linux-ABI (musl)
info=Der dynamische Lader fuer Linux-Programme -- ld-musl-x86_64.so.1, unveraendert von musl 1.2.3 (MIT)
keys=musl,ld,linux,abi,interpreter,dynamisch,elf,libc
handle=konsole
datei=lib/ld-musl-x86_64.so.1 @LDSO@
