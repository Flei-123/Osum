# Das Paket `busybox` -- die Zielsoftware, DYNAMISCH gelinkt.
#
# Haengt an `linux-abi`: ohne den Interpreter startet diese Datei nicht.
# Das ist keine Formalie, sondern genau der Grund, aus dem die beiden
# getrennt sind -- wer nur den Interpreter will (etwa fuer eigene
# Programme), installiert `linux-abi` allein.
#
# HERKUNFT: busybox 1.36.1, GPL-2.0-only, https://busybox.net/.
# Quelle unveraendert (SHA-256 in /root/fremdquellen/SHA256SUMS.txt),
# gebaut mit musl-gcc, CONFIG_STATIC AUS.
name=busybox
fassung=1.36.1
titel=BusyBox
info=Die Standardbefehle in einer Datei -- dynamisch gegen musl gelinkt (GPL-2.0-only)
keys=busybox,shell,coreutils,unix,linux
braucht=linux-abi
handle=konsole
datei=start /root/bbdyn/busybox
