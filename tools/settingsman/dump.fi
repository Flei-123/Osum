// tools/settingsman/dump.fi -- reads a SETTINGS manifest on stdin, prints the parsed tables in a fixed text form.
// tools/settingsman/manifest.py (a second, independent reader) prints the same form; run.sh compares them.
import std.rt
import std.io
import settingsman.manifest

fn tname(t: u64) -> str {
    if t == manifest.T_BOOL {
        return "bool"
    }
    if t == manifest.T_CHOICE {
        return "choice"
    }
    if t == manifest.T_TEXT {
        return "text"
    }
    if t == manifest.T_SECRET {
        return "secret"
    }
    if t == manifest.T_ACTION {
        return "action"
    }
    if t == manifest.T_STATUS {
        return "status"
    }
    if t == manifest.T_LIST {
        return "list"
    }
    return "?"
}

fn cname(c: u64) -> str {
    if c == 1 {
        return "right"
    }
    return "left"
}

fn pc(p: u64) {
    if p == 0 {
        io.print("-")
    } else {
        io.print_c(p)
    }
}

fn main() -> i32 {
    var b: rt.Buf = rt.buf_new()
    io.read_stdin(&b)
    let n: u64 = manifest.load(b.ptr, b.len as u64)
    if n == manifest.ERR {
        let code: u64 = manifest.err_code()
        let line: u64 = manifest.err_line()
        let ti: u64 = manifest.item_count()
        let tp: u64 = manifest.page_count()
        io.fmt_print_line(f"error {code} line {line}")
        io.fmt_print_line(f"tables items={ti} pages={tp}")
        return 0
    }
    let np: u64 = manifest.page_count()
    let w: u64 = manifest.warn_count()
    io.print("ok app=")
    pc(manifest.app_name())
    io.fmt_print_line(f" items={n} pages={np} warns={w}")
    var p: u64 = 0
    while p < np {
        io.print("page ")
        pc(manifest.page_id(p))
        io.print(" ")
        pc(manifest.page_title(p))
        io.print(" ")
        pc(manifest.page_icon(p))
        io.print(" ")
        pc(manifest.page_group(p))
        let first: u64 = manifest.page_first(p)
        let len: u64 = manifest.page_len(p)
        io.fmt_print_line(f" first={first} len={len}")
        var i: u64 = first
        while i < first + len {
            let k: u64 = manifest.item_kind(i)
            let col: u64 = manifest.item_col(i)
            let cn: str = cname(col)
            if k == manifest.K_LABEL {
                io.fmt_print(f"  label {cn} ")
                pc(manifest.item_label(i))
                io.print("\n")
            } else if k == manifest.K_NOTE {
                let lines: u64 = manifest.item_num(i)
                io.fmt_print(f"  note {cn} ")
                pc(manifest.item_label(i))
                io.fmt_print_line(f" {lines}")
            } else {
                let tn: str = tname(manifest.item_type(i))
                io.fmt_print(f"  field {cn} ")
                pc(manifest.item_key(i))
                io.fmt_print(f" {tn} ")
                pc(manifest.item_label(i))
                io.print(" ")
                pc(manifest.item_def(i))
                if manifest.item_read(i) != 0 {
                    io.print(" read=")
                    io.print_c(manifest.item_read(i))
                }
                if manifest.item_write(i) != 0 {
                    io.print(" write=")
                    io.print_c(manifest.item_write(i))
                }
                io.print("\n")
            }
            i = i + 1
        }
        p = p + 1
    }
    return 0
}
