ok app=social items=20 pages=3 warns=0
page activity settings.pkg.social.title share accounts first=0 len=5
  note left settings.pkg.social.help 2
  field left share_activity bool settings.pkg.social.share - read=social.status write=social.privacy.set
  field left presence status settings.pkg.social.presence - read=social.status
  field left activity status settings.pkg.social.activity - read=social.status
  field left refresh action settings.pkg.social.refresh - write=social.refresh
page rights settings.pkg.social.rights.title share accounts first=5 len=7
  note left settings.pkg.social.rights.help 3
  field left app.1 status settings.pkg.social.app - read=social.apps.list
  field left app.2 status settings.pkg.social.app - read=social.apps.list
  field left app.3 status settings.pkg.social.app - read=social.apps.list
  field left app.4 status settings.pkg.social.app - read=social.apps.list
  field left allow text settings.pkg.social.allow - write=social.apps.allow
  field left deny text settings.pkg.social.deny - write=social.apps.deny
page privacy settings.pkg.social.privacy.title share accounts first=12 len=8
  note left settings.pkg.social.privacy.help 2
  field left invites_from status settings.pkg.social.invites - read=social.privacy.get
  field left from text settings.pkg.social.invites.set - write=social.privacy.invites
  field left hide.1 status settings.pkg.social.hidden - read=social.privacy.get
  field left hide.2 status settings.pkg.social.hidden - read=social.privacy.get
  field left hide.3 status settings.pkg.social.hidden - read=social.privacy.get
  field left entry text settings.pkg.social.hide - write=social.privacy.hide
  field left show text settings.pkg.social.show - write=social.privacy.show
