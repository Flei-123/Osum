// tools/settingsman/bind.fi -- prints, for every field key of the accounts manifest, its binding number
// (manifest.names_index over settings.d/accounts.bind) -- and for a key that is not listed, `none`.
import std.io
import settingsman.manifest

const MAN: str = __include_str("../../kernel/user/settings.d/builtin.settings")
const NAMES: str = __include_str("../../kernel/user/settings.d/accounts.bind")
static mut pgid: [u8; 9] = "accounts\0"
static mut nokey: [u8; 12] = "nosuchkey_x\0"
static mut pre: [u8; 8] = "provide\0"
static mut post: [u8; 10] = "provider2\0"

fn main() -> i32 {
    let m: str = MAN
    let nm: str = NAMES
    let n: u64 = manifest.load(m.p as u64, m.n as u64)
    let pg: u64 = manifest.page_find((&pgid[0]) as u64)
    var i: u64 = manifest.page_first(pg)
    let end: u64 = i + manifest.page_len(pg)
    while i < end {
        if manifest.item_kind(i) == manifest.K_FIELD {
            let ix: u64 = manifest.names_index(nm.p as u64, nm.n as u64, manifest.item_key(i))
            io.print_c(manifest.item_key(i))
            io.fmt_print_line(f"={ix}")
        }
        i = i + 1
    }
    let a: u64 = manifest.names_index(nm.p as u64, nm.n as u64, (&nokey[0]) as u64)
    let b: u64 = manifest.names_index(nm.p as u64, nm.n as u64, (&pre[0]) as u64)
    let c: u64 = manifest.names_index(nm.p as u64, nm.n as u64, (&post[0]) as u64)
    io.fmt_print_line(f"unknown={a} prefix={b} longer={c}")
    return 0
}
