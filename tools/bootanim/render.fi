import std.rt
import std.io
import bootanim.fx
import bootanim.canvas
import bootanim.logo
import bootanim.styles

const PROGRESS_MS: i64 = 3600
const FADE_START_MS: i64 = 3800
const FADE_MS: i64 = 1000

static mut desc: [u64; 16] = [0 as u64; 16]

fn number(p: u64) -> i64 {
    var v: i64 = 0
    var i: u64 = 0
    while *((p + i) as *mut u8) >= 48 && *((p + i) as *mut u8) <= 57 {
        v = v * 10 + ((*((p + i) as *mut u8) - 48) as i64)
        i = i + 1
    }
    return v
}

fn load(path: u64) -> u64 {
    var b: rt.Buf = rt.buf_new()
    if *(path as *mut u8) == 45 || !rt.read_file(path, &b) {
        return 0
    }
    return b.ptr
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 8 {
        io.eprint_line("usage: render <logo> <target.bgr0|-> <style> <w> <h> <frames> <fps> [first]")
        return 2
    }
    let w: i64 = number(rt.arg_ptr(start, 4))
    let h: i64 = number(rt.arg_ptr(start, 5))
    let frames: i64 = number(rt.arg_ptr(start, 6))
    let fps: i64 = fx.clamp(number(rt.arg_ptr(start, 7)), 1, 240)
    let cv: u64 = (&desc[0]) as u64
    let size: usize = (w * h * 4) as usize
    canvas.init(cv, rt.heap_alloc(size), w as u64, h as u64)
    *((cv + canvas.CV_LOGO) as *mut u64) = load(rt.arg_ptr(start, 1))
    *((cv + canvas.CV_TARGET) as *mut u64) = load(rt.arg_ptr(start, 2))
    logo.build(cv, rt.heap_alloc(logo.cache_bytes(cv) as usize + 16))
    let style: u64 = styles.parse(rt.arg_ptr(start, 3))
    var f: i64 = 0
    if rt.arg_count(start) > 8 {
        f = number(rt.arg_ptr(start, 8))
    }
    while f < frames {
        let t: i64 = f * 1000 / fps
        styles.frame(cv, style, t, fx.span(t, 0, PROGRESS_MS), fx.span(t, FADE_START_MS, FADE_MS))
        io.print_bytes(*(cv as *mut u64), size)
        f = f + 1
    }
    return 0
}
