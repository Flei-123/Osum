// SPDX-License-Identifier: GPL-2.0-only
// tools/settingsbook/fakekonto.fi -- a STUB of /bin/konto for the click test of
// Settings -> Konten -> "Sign in with code + address book" (r126).
//
// It speaks the same `konto: <key> = <value>` lines as kernel/app/account.fi but
// needs no network and no identity provider, so the click test is deterministic:
//   konto anmelden --anbieter=X --device [--exchange]      -> state device, code, url,
//                                                             the continue token; exit 11
//   konto anmelden ... --continue=<token> --exchange       -> state ok, exchange = offline
//   konto anmelden ... --continue=<token>                  -> state ok (no exchange line)
// The page under test must not care which program answers; it only reads the lines.

import std.io
import std.rt

const S_WRITE: i64 = 1

fn out(s: str) {
    syscall(S_WRITE, 1, s.p as i64, s.n as i64, 0, 0, 0)
}

fn has_word(start: u64, n: usize, w: str) -> bool {
    var i: usize = 1
    while i < n {
        let p: u64 = rt.arg_ptr(start, i)
        var j: usize = 0
        var same: bool = true
        while j < w.n {
            if rt.ld8(p, j) != rt.ld8(w.p as u64, j) {
                same = false
                j = w.n
            } else {
                j = j + 1
            }
        }
        if same && (w.n == 0 || rt.ld8(p, w.n) == 0 as u8 || rt.ld8(w.p as u64, w.n - 1) == 61 as u8) {
            return true
        }
        i = i + 1
    }
    return false
}

fn main(start: u64) -> i32 {
    let n: usize = rt.arg_count(start)
    let cont: bool = has_word(start, n, "--continue=")
    let exch: bool = has_word(start, n, "--exchange")
    if !cont {
        out("konto: stand = device\n")
        out("konto: code = ABCD-EFGH\n")
        out("konto: url = https://id.test/device\n")
        out("konto: zwischen = dc-stub-1\n")
        return 11
    }
    out("konto: stand = ok\n")
    if exch {
        out("konto: exchange = offline\n")
    }
    return 0
}
