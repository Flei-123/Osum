import std.rt
import std.io
import libc.octets
import ssam.ssamwire
import ssam.ssamlink
import ssam.ssamhid
import ssamgold.golden

static mut lk: [u8; 6144] = [0; 6144]
static mut a: [u8; 1024] = [0; 1024]
static mut b: [u8; 1024] = [0; 1024]
static mut seedbox: [u64; 1] = [0; 1]

fn chk(name: str, cond: bool) {
    if cond {
        io.print("OK   ")
    } else {
        io.print("FAIL ")
    }
    io.print_line(name)
}

fn l() -> u64 {
    return (&lk[0]) as u64
}

fn pa() -> u64 {
    return (&a[0]) as u64
}

fn pb() -> u64 {
    return (&b[0]) as u64
}

fn same(p: u64, q: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if octets.ld8(p, i) != octets.ld8(q, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn drain_matches(n: u64) -> bool {
    if ssamlink.tx_len(l()) != n {
        return false
    }
    let got: u64 = ssamlink.tx_take(l(), pb(), 1024)
    return got == n && same(pa(), pb(), n)
}

fn fresh() {
    ssamlink.init(l())
}

fn feed_golden(n: u64, now: u64) {
    ssamlink.feed_all(l(), pa(), n, now)
}

fn test_wire() {
    var crcdata: [u8; 9] = "123456789"
    chk("crc16 check value 0x29B1", ssamwire.crc16((&crcdata[0]) as u64, 9) == 0x29B1)
    chk("crc16 of nothing is 0xFFFF", ssamwire.crc16(pa(), 0) == 0xFFFF)
    var n: u64 = golden.g_ack5(pa())
    chk("ack frame length", ssamwire.put_ack(pb(), 5) == n)
    chk("ack frame bytes", same(pa(), pb(), n))
    n = golden.g_nak(pa())
    chk("nak frame bytes", ssamwire.put_nak(pb()) == n && same(pa(), pb(), n))
    n = golden.g_req_desc(pa())
    let plen: u64 = golden.g_descreq(pb() + 512)
    let m: u64 = ssamwire.put_cmd(pb(), 0, 39, ssamhid.TC_HID, ssamhid.TID_KIP, 1, ssamhid.CID_GET_DESCRIPTOR, pb() + 512, plen)
    chk("command frame bytes", m == n && same(pa(), pb(), n))
    chk("descriptor request payload", ssamhid.put_get_descriptor(pb(), ssamhid.DESC_REPORT, 0, ssamhid.SLICE_CHUNK) == 10
        && same(pb(), pb() + 512, 10))
    chk("rqid skips the event range", ssamwire.next_rqid(38) == 39 && ssamwire.next_rqid(0xFFFF) == 39 && ssamwire.next_rqid(40) == 41)
    chk("event rqid range", ssamwire.is_event_rqid(21) && !ssamwire.is_event_rqid(0) && !ssamwire.is_event_rqid(39))
}

fn test_event() {
    fresh()
    var n: u64 = golden.g_evt_kbd(pa())
    feed_golden(n, 0)
    chk("event frame produces one event", ssamlink.ev_avail(l()) == 1)
    chk("event category/instance/command", ssamlink.ev_tc(l()) == 0x15 && ssamlink.ev_iid(l()) == 1 && ssamlink.ev_cid(l()) == 0)
    chk("event source is the KIP target", ssamlink.ev_tid(l()) == 2)
    chk("event data length 8", ssamlink.ev_len(l()) == 8)
    chk("event data byte 2 is the key", octets.ld8(ssamlink.ev_data(l()), 2) == 4)
    let an: u64 = ssamwire.put_ack(pa(), 7)
    chk("sequenced event is acknowledged with its sequence", drain_matches(an))
    ssamlink.ev_drop(l())
    chk("drop empties the queue", ssamlink.ev_avail(l()) == 0)
    n = golden.g_evt_kbd(pa())
    feed_golden(n, 1)
    chk("repeated sequence number is a duplicate", ssamlink.ev_avail(l()) == 0 && ssamlink.counter(l(), ssamlink.C_DUP) == 1)
    chk("duplicate is still acknowledged", ssamlink.counter(l(), ssamlink.C_ACK_TX) == 2)
    fresh()
    n = golden.g_evt_nsq(pa())
    feed_golden(n, 0)
    chk("unsequenced event is queued without an ack", ssamlink.ev_avail(l()) == 1 && ssamlink.tx_len(l()) == 0)
    fresh()
    n = golden.g_evt_tpad(pa())
    feed_golden(n, 0)
    chk("touchpad event instance 3", ssamlink.ev_avail(l()) == 1 && ssamlink.ev_iid(l()) == 3 && ssamlink.ev_len(l()) == 4)
    fresh()
    n = golden.g_evt_big(pa())
    feed_golden(n, 0)
    chk("200 byte event kept whole", ssamlink.ev_len(l()) == 200 && octets.ld8(ssamlink.ev_data(l()), 199) == 199)
    fresh()
    n = golden.g_evt_toobig(pa())
    feed_golden(n, 0)
    chk("oversized event is dropped", ssamlink.ev_avail(l()) == 0 && ssamlink.counter(l(), ssamlink.C_DROPPED) >= 1)
}

fn test_event_queue() {
    fresh()
    var i: u64 = 0
    while i < 10 {
        let n: u64 = golden.g_evt_nsq(pa())
        feed_golden(n, i)
        i = i + 1
    }
    chk("event ring holds 8", ssamlink.ev_avail(l()) == 8)
    chk("overflow counted", ssamlink.counter(l(), ssamlink.C_DROPPED) == 2)
}

fn test_corruption() {
    fresh()
    var n: u64 = golden.g_evt_bad_payload_crc(pa())
    feed_golden(n, 0)
    chk("bad payload crc: no event", ssamlink.ev_avail(l()) == 0)
    chk("bad payload crc: nak sent", ssamlink.counter(l(), ssamlink.C_NAK_TX) == 1 && ssamlink.counter(l(), ssamlink.C_BADCRC) >= 1)
    let nn: u64 = ssamwire.put_nak(pa())
    chk("nak bytes on the wire", drain_matches(nn))
    fresh()
    n = golden.g_evt_bad_header_crc(pa())
    feed_golden(n, 0)
    chk("bad header crc: no event and no nak", ssamlink.ev_avail(l()) == 0 && ssamlink.counter(l(), ssamlink.C_NAK_TX) == 0)
    fresh()
    let g: u64 = golden.g_garbage(pa())
    feed_golden(g, 0)
    n = golden.g_evt_nsq(pa())
    feed_golden(n, 0)
    chk("garbage then frame: resync", ssamlink.ev_avail(l()) == 1 && ssamlink.counter(l(), ssamlink.C_RESYNC) >= 1)
    fresh()
    n = golden.g_huge_len_then_event(pa())
    feed_golden(n, 0)
    chk("absurd frame length is skipped, next frame found", ssamlink.ev_avail(l()) == 1)
    fresh()
    n = golden.g_evt_nsq(pa())
    var i: u64 = 0
    while i < n {
        ssamlink.feed(l(), octets.ld8(pa(), i), i)
        i = i + 1
    }
    chk("byte by byte feeding", ssamlink.ev_avail(l()) == 1)
    fresh()
    n = golden.g_evt_bad_payload_crc(pa())
    let n2: u64 = golden.g_evt_nsq(pb())
    octets.copy(pa() + n, pb(), n2)
    feed_golden(n + n2, 0)
    chk("good frame after a corrupt one is found", ssamlink.ev_avail(l()) == 1)
}

fn test_request() {
    fresh()
    let rq: u64 = ssamlink.request(l(), ssamhid.TC_HID, ssamhid.TID_KIP, 1, ssamhid.CID_GET_DESCRIPTOR, pb() + 512, golden.g_descreq(pb() + 512), 100)
    chk("first request id is 39", rq == 39)
    var n: u64 = golden.g_req_desc(pa())
    chk("request bytes on the wire", drain_matches(n))
    chk("request is waiting", ssamlink.req_state(l()) == ssamlink.REQ_WAIT)
    chk("second request refused while busy", ssamlink.request(l(), 1, 1, 0, 0, 0, 0, 100) == 0)
    n = golden.g_ack0(pa())
    feed_golden(n, 110)
    chk("ack keeps it waiting", ssamlink.req_state(l()) == ssamlink.REQ_WAIT)
    n = golden.g_rsp_wrong_rqid(pa())
    feed_golden(n, 120)
    chk("response with a foreign request id is ignored", ssamlink.req_state(l()) == ssamlink.REQ_WAIT)
    ssamlink.tx_take(l(), pb(), 1024)
    n = golden.g_rsp_desc(pa())
    feed_golden(n, 130)
    chk("response completes the request", ssamlink.req_state(l()) == ssamlink.REQ_DONE)
    chk("response payload is the slice", ssamlink.rsp_len(l()) == 13 && ssamhid.slice_end(ssamlink.rsp_ptr(l())))
    chk("slice data", octets.ld8(ssamhid.slice_data(ssamlink.rsp_ptr(l())), 2) == 3 && ssamhid.slice_ok(ssamlink.rsp_ptr(l()), ssamlink.rsp_len(l())))
    ssamlink.req_clear(l())
    ssamlink.tx_take(l(), pb(), 1024)
    chk("clear returns to idle", ssamlink.req_state(l()) == ssamlink.REQ_IDLE)
    let rq2: u64 = ssamlink.request(l(), ssamhid.TC_HID, ssamhid.TID_KIP, 1, ssamhid.CID_GET_DESCRIPTOR, pb() + 512, golden.g_descreq(pb() + 512), 200)
    chk("next request id and sequence advance", rq2 == 40)
    n = golden.g_req_desc_seq1(pa())
    chk("second request bytes", drain_matches(n))
}

fn test_retry() {
    fresh()
    let _r: u64 = ssamlink.request(l(), ssamhid.TC_HID, ssamhid.TID_KIP, 1, ssamhid.CID_GET_DESCRIPTOR, pb() + 512, golden.g_descreq(pb() + 512), 0)
    let n: u64 = golden.g_req_desc(pa())
    ssamlink.tx_take(l(), pb(), 1024)
    ssamlink.tick(l(), 100)
    chk("no retry before the ack timeout", ssamlink.tx_len(l()) == 0)
    ssamlink.tick(l(), 250)
    chk("retry after the ack timeout is the same frame", ssamlink.counter(l(), ssamlink.C_RETRY) == 1 && drain_matches(n))
    ssamlink.tick(l(), 500)
    chk("second retry", ssamlink.counter(l(), ssamlink.C_RETRY) == 2 && drain_matches(n))
    ssamlink.tick(l(), 750)
    chk("gives up after three transmissions", ssamlink.req_state(l()) == ssamlink.REQ_FAIL && ssamlink.counter(l(), ssamlink.C_TIMEOUT) == 1)
    ssamlink.tx_take(l(), pb(), 1024)
    fresh()
    let _r2: u64 = ssamlink.request(l(), ssamhid.TC_HID, ssamhid.TID_KIP, 1, ssamhid.CID_GET_DESCRIPTOR, pb() + 512, golden.g_descreq(pb() + 512), 0)
    ssamlink.tx_take(l(), pb(), 1024)
    let nk: u64 = golden.g_nak(pa())
    feed_golden(nk, 10)
    chk("nak makes the host resend", ssamlink.counter(l(), ssamlink.C_RETRY) == 1 && ssamlink.tx_len(l()) == n)
    fresh()
    let _r4: u64 = ssamlink.request(l(), ssamhid.TC_HID, ssamhid.TID_KIP, 1, ssamhid.CID_GET_DESCRIPTOR, pb() + 512, golden.g_descreq(pb() + 512), 0)
    ssamlink.tx_take(l(), pb(), 1024)
    let wa: u64 = golden.g_ack5(pa())
    feed_golden(wa, 10)
    ssamlink.tick(l(), 260)
    chk("ack for another sequence does not stop the retry", ssamlink.counter(l(), ssamlink.C_RETRY) == 1)
    fresh()
    let _r3: u64 = ssamlink.request(l(), ssamhid.TC_HID, ssamhid.TID_KIP, 1, ssamhid.CID_GET_DESCRIPTOR, pb() + 512, golden.g_descreq(pb() + 512), 0)
    ssamlink.tx_take(l(), pb(), 1024)
    let ak: u64 = golden.g_ack0(pa())
    feed_golden(ak, 10)
    ssamlink.tick(l(), 1000)
    chk("acked request survives past the ack timeout", ssamlink.req_state(l()) == ssamlink.REQ_WAIT && ssamlink.counter(l(), ssamlink.C_RETRY) == 0)
    ssamlink.tick(l(), 1600)
    chk("acked request fails after the response timeout", ssamlink.req_state(l()) == ssamlink.REQ_FAIL)
}

fn test_event_enable() {
    fresh()
    let plen: u64 = golden.g_evparams(pb() + 512)
    chk("event params bytes", ssamhid.put_event_params(pb(), ssamhid.TC_HID, 1, 0) == 5 && same(pb(), pb() + 512, plen))
    let _r: u64 = ssamlink.request(l(), ssamhid.TC_REG, ssamhid.TID_KIP, 0, ssamhid.CID_EVENT_ENABLE, pb(), 5, 0)
    let n: u64 = golden.g_req_evreg(pa())
    chk("event enable request bytes", drain_matches(n))
    let ra: u64 = golden.g_ack0(pa())
    feed_golden(ra, 1)
    let r0: u64 = golden.g_rsp_status0(pa())
    feed_golden(r0, 2)
    chk("enable status 0 is success", ssamlink.req_state(l()) == ssamlink.REQ_DONE && ssamhid.event_status_ok(ssamlink.rsp_ptr(l()), ssamlink.rsp_len(l())))
    fresh()
    let _r1: u64 = ssamlink.request(l(), ssamhid.TC_REG, ssamhid.TID_KIP, 0, ssamhid.CID_EVENT_ENABLE, pb(), 5, 0)
    ssamlink.tx_take(l(), pb(), 1024)
    let r1: u64 = golden.g_rsp_status1(pa())
    feed_golden(r1, 2)
    chk("enable status 1 is failure", !ssamhid.event_status_ok(ssamlink.rsp_ptr(l()), ssamlink.rsp_len(l())))
}

fn test_hid_descriptors() {
    var n: u64 = golden.g_hiddesc(pa())
    chk("hid descriptor accepted", ssamhid.hid_desc_ok(pa(), n) && ssamhid.hid_desc_report_len(pa()) == 0x3B)
    n = golden.g_hiddesc_bad_type(pa())
    chk("wrong descriptor type rejected", !ssamhid.hid_desc_ok(pa(), n))
    n = golden.g_hiddesc_two(pa())
    chk("two class descriptors rejected", !ssamhid.hid_desc_ok(pa(), n))
    chk("short hid descriptor rejected", !ssamhid.hid_desc_ok(pa(), 8))
    n = golden.g_attrs(pa())
    chk("attributes vendor/product/version", n == 32 && ssamhid.attrs_length(pa()) == 32 && ssamhid.attrs_vendor(pa()) == 0x045E
        && ssamhid.attrs_product(pa()) == 0x09AF && ssamhid.attrs_version(pa()) == 0x0100)
    n = golden.g_slice_ok(pa())
    chk("slice accepted", ssamhid.slice_ok(pa(), n) && ssamhid.slice_offset(pa()) == 4 && ssamhid.slice_length(pa()) == 4 && !ssamhid.slice_end(pa()))
    n = golden.g_slice_overrun(pa())
    chk("slice longer than the message rejected", !ssamhid.slice_ok(pa(), n))
    chk("input report is category 0x15 command 0", ssamhid.is_input_report(0x15, 0) && !ssamhid.is_input_report(0x15, 1) && !ssamhid.is_input_report(0x01, 0))
}

fn next_rand() -> u64 {
    seedbox[0] = seedbox[0] *% 6364136223846793005 +% 1442695040888963407
    return (seedbox[0] >> 33) & 255
}

fn test_fuzz() {
    fresh()
    seedbox[0] = 12345
    var i: u64 = 0
    var popped: u64 = 0
    while i < 200000 {
        ssamlink.feed(l(), next_rand(), i)
        if ssamlink.tx_len(l()) > 256 {
            ssamlink.tx_take(l(), pb(), 1024)
        }
        while ssamlink.ev_avail(l()) > 0 {
            popped = popped + 1
            ssamlink.ev_drop(l())
        }
        i = i + 1
    }
    chk("200000 random bytes: no crash, state intact", ssamlink.tx_len(l()) <= 1024)
    fresh()
    var k: u64 = 0
    var events: u64 = 0
    while k < 2000 {
        let n: u64 = golden.g_evt_nsq(pa())
        var j: u64 = 0
        while j < 3 {
            ssamlink.feed(l(), next_rand(), k)
            j = j + 1
        }
        ssamlink.feed_all(l(), pa(), n, k)
        while ssamlink.ev_avail(l()) > 0 {
            events = events + 1
            ssamlink.ev_drop(l())
        }
        k = k + 1
    }
    chk("2000 frames amid noise: all found", events >= 1990)
}

fn main() -> i32 {
    test_wire()
    test_event()
    test_event_queue()
    test_corruption()
    test_request()
    test_retry()
    test_event_enable()
    test_hid_descriptors()
    test_fuzz()
    return 0
}
