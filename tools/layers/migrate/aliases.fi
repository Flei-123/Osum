fn octets__ld8(p: u64, i: u64) -> u64 { let b: u8 = *((p + i) as *mut u8) return b as u64 }
fn octets__ld8(p: u64, i: u64) -> u64 { let c: u8 = *((p + i) as *mut u8) return c as u64 }
fn octets__ld8(p: u64, i: u64) -> u64 { let q: *mut u8 = (p + i) as *mut u8 let v: u8 = *q return v as u64 }
fn octets__st8(p: u64, i: u64, v: u64) { let q: *mut u8 = (p + i) as *mut u8 *q = (v & 255) as u8 }
fn regio__read8(a: u64) -> u64 { let c: u8 = __mmio_read8((a) as *mut u8) return c as u64 }
fn regio__write8(a: u64, v: u64) { __mmio_write8(a as *mut u8, (v & 255) as u8) }
fn regio__write8_at(p: u64, o: u64, v: u64) { __mmio_write8((p + o) as *mut u8, (v & 0xFF) as u8) }
fn regio__write8_at(p: u64, o: u64, v: u64) { __mmio_write8((p + o) as *mut u8, v as u8) }
fn regio__write32_at(p: u64, o: u64, v: u64) { __mmio_write32((p + o) as *mut u32, v as u32) }
fn regio__read64(a: u64) -> u64 { return __mmio_read64(a as *mut u64) }
fn clockapi__ticks() -> u64 { return ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0) }
fn octets__ld8(p: u64, i: u64) -> u64 { return actwire.ld8(p, i) }
fn octets__st8(p: u64, i: u64, v: u64) { actwire.st8(p, i, v) }
fn octets__ld8(p: u64, i: u64) -> u64 { return iwl_le.ld8(p, i) }
fn octets__st8(p: u64, i: u64, v: u64) { iwl_le.st8(p, i, v) }
fn octets__ld8_idx(p: u64, i: usize) -> u64 { let b: u8 = *((p + i as u64) as *mut u8) return b as u64 }
fn octets__ld8_idx(p: u64, i: usize) -> u64 { return (*((p + i as u64) as *mut u8)) as u64 }
fn octets__st8_idx(p: u64, i: usize, v: u64) { *((p + i as u64) as *mut u8) = (v & 255) as u8 }
fn octets__st8_idx(p: u64, i: usize, v: u64) { *((p + i as u64) as *mut u8) = (v & 0xFF) as u8 }
fn regio__read8_at(p: u64, o: u64) -> u64 { return (__mmio_read8((p + o) as *mut u8)) as u64 }
fn regio__write8(a: u64, v: u64) { __mmio_write8((a) as *mut u8, v as u8) }
