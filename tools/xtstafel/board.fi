//



//




//






import std.io
import std.rt
import crypto.xts

static mut z: u64 = 0

fn nextr() -> u64 {
    var x: u64 = z
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    z = x
    return x
}


fn mach_key(k: u64, samen: u64) {
    z = samen
    var i: usize = 0
    while i < 64 {
        *((k + i as u64) as *mut u8) = (nextr() & 255) as u8
        i = i + 1
    }
}


fn say_number(v: u64) {
    var bf: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&bf, v)
    io.print_bytes(rt.buf_ptr(&bf), rt.buf_len(&bf))
    rt.buf_free(&bf)
}

fn main() -> i32 {
    if !xts.aesni_on() {
        io.print_line("board: aesni=0 (this machine cannot do it)")
        return 0
    }
    var failure: u64 = 0

    var ka: [u8; 64] = [0 as u8; 64]
    var kb: [u8; 64] = [0 as u8; 64]
    mach_key((&ka[0]) as u64, 0x243F6A8885A308D3)
    mach_key((&kb[0]) as u64, 0x13198A2E03707344)

    var klar: [u8; 512] = [0 as u8; 512]
    var geh_a: [u8; 512] = [0 as u8; 512]
    var geh_b: [u8; 512] = [0 as u8; 512]
    var rueck: [u8; 512] = [0 as u8; 512]
    z = 0xA4093822299F31D0
    var i: usize = 0
    while i < 512 {
        klar[i] = (nextr() & 255) as u8
        i = i + 1
    }

    // ---------------------------------------------------------------



    // ---------------------------------------------------------------
    xts.forget()
    let f0: u64 = xts.fuellungen()
    xts.sector_encrypt((&ka[0]) as u64, 0, (&klar[0]) as u64,
        (&geh_a[0]) as u64, 512)
    xts.sector_encrypt((&kb[0]) as u64, 0, (&klar[0]) as u64,
        (&geh_b[0]) as u64, 512)
    let f_warm: u64 = xts.fuellungen()
    io.print("board: warm-up costs fills: ")
    say_number(f_warm - f0)
    io.new_line()

    var s: u64 = 1
    while s <= 100 {
        xts.sector_encrypt((&ka[0]) as u64, s, (&klar[0]) as u64,
            (&geh_a[0]) as u64, 512)
        xts.sector_encrypt((&kb[0]) as u64, s, (&klar[0]) as u64,
            (&geh_b[0]) as u64, 512)
        s = s + 1
    }
    let f_wechsel: u64 = xts.fuellungen() - f_warm
    io.print("board: 200 sectors alternating, fills: ")
    say_number(f_wechsel)
    io.new_line()
    if f_wechsel == 0 {
        io.print_line("board: OK no refill on switch")
    } else {
        io.print_line("board: FAIL refilled on switch")
        failure = failure + 1
    }

    // ---------------------------------------------------------------


    // ---------------------------------------------------------------
    if !xts.sector_decrypt((&ka[0]) as u64, 7, (&geh_a[0]) as u64,
            (&rueck[0]) as u64, 512) {
        io.print_line("board: FAIL decrypting A failed")
        failure = failure + 1
    }
    xts.sector_encrypt((&ka[0]) as u64, 7, (&klar[0]) as u64,
        (&geh_a[0]) as u64, 512)
    xts.sector_decrypt((&ka[0]) as u64, 7, (&geh_a[0]) as u64,
        (&rueck[0]) as u64, 512)
    var diff: u64 = 0
    i = 0
    while i < 512 {
        diff = diff | ((klar[i] as u64) ^ (rueck[i] as u64))
        i = i + 1
    }
    if diff == 0 {
        io.print_line("board: OK carrier A round trip")
    } else {
        io.print_line("board: FAIL carrier A does not come back")
        failure = failure + 1
    }
    xts.sector_encrypt((&kb[0]) as u64, 7, (&klar[0]) as u64,
        (&geh_b[0]) as u64, 512)
    xts.sector_decrypt((&kb[0]) as u64, 7, (&geh_b[0]) as u64,
        (&rueck[0]) as u64, 512)
    diff = 0
    i = 0
    while i < 512 {
        diff = diff | ((klar[i] as u64) ^ (rueck[i] as u64))
        i = i + 1
    }
    if diff == 0 {
        io.print_line("board: OK carrier B round trip")
    } else {
        io.print_line("board: FAIL carrier B does not come back")
        failure = failure + 1
    }

    diff = 0
    i = 0
    while i < 512 {
        diff = diff | ((geh_a[i] as u64) ^ (geh_b[i] as u64))
        i = i + 1
    }
    if diff != 0 {
        io.print_line("board: OK two keys, two ciphertexts")
    } else {
        io.print_line("board: FAIL both carriers give the same")
        failure = failure + 1
    }

    // ---------------------------------------------------------------



    // ---------------------------------------------------------------
    xts.forget()
    let f1: u64 = xts.fuellungen()
    xts.sector_encrypt((&ka[0]) as u64, 3, (&klar[0]) as u64,
        (&geh_a[0]) as u64, 512)
    xts.sector_encrypt((&kb[0]) as u64, 3, (&klar[0]) as u64,
        (&geh_b[0]) as u64, 512)
    let nach: u64 = xts.fuellungen() - f1
    io.print("board: fills after forget(): ")
    say_number(nach)
    io.new_line()
    if nach == 2 {
        io.print_line("board: OK forget() cleared ALL slots")
    } else {
        io.print_line("board: FAIL forget() did not clear everything")
        failure = failure + 1
    }

    // ---------------------------------------------------------------



    // ---------------------------------------------------------------
    xts.forget()
    var kx: [u8; 64] = [0 as u8; 64]
    var runde: u64 = 0
    var bad: u64 = 0
    while runde < 5 {
        mach_key((&kx[0]) as u64, 0x1000 + runde)
        if !xts.sector_encrypt((&kx[0]) as u64, runde, (&klar[0]) as u64,
                (&geh_a[0]) as u64, 512) {
            bad = bad + 1
        }
        if !xts.sector_decrypt((&kx[0]) as u64, runde, (&geh_a[0]) as u64,
                (&rueck[0]) as u64, 512) {
            bad = bad + 1
        }
        diff = 0
        i = 0
        while i < 512 {
            diff = diff | ((klar[i] as u64) ^ (rueck[i] as u64))
            i = i + 1
        }
        if diff != 0 {
            bad = bad + 1
        }
        runde = runde + 1
    }
    if bad == 0 {
        io.print_line("board: OK five keys on four slots are correct")
    } else {
        io.print_line("board: FAIL eviction miscalculates")
        failure = failure + 1
    }

    io.print("board: errors=")
    say_number(failure)
    io.new_line()
    if failure != 0 {
        return 1
    }
    return 0
}
