import std.io
import std.rt
import crypto.xts

static mut z: u64 = 0

fn nextr() -> u64 {
    var x: u64 = z
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    z = x
    return x
}

fn mach_key(k: u64, samen: u64) {
    z = samen
    var i: usize = 0
    while i < 64 {
        *((k + i as u64) as *mut u8) = (nextr() & 255) as u8
        i = i + 1
    }
}

fn say_number(v: u64) {
    var bf: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&bf, v)
    io.print_bytes(rt.buf_ptr(&bf), rt.buf_len(&bf))
    rt.buf_free(&bf)
}


fn find_name(von: u64, len: u64, muster: u64, n: u64) -> u64 {
    var treffer: u64 = 0
    var i: u64 = 0
    while i + n <= len {
        var equal: bool = true
        var j: u64 = 0
        while j < n {
            if *((von + i + j) as *mut u8) != *((muster + j) as *mut u8) {
                equal = false
            }
            j = j + 1
        }
        if equal {
            treffer = treffer + 1
        }
        i = i + 1
    }
    return treffer
}

fn main() -> i32 {
    if !xts.aesni_on() {
        io.print_line("delete: aesni=0 (this machine cannot do it)")
        return 0
    }
    var failure: u64 = 0
    var ka: [u8; 64] = [0 as u8; 64]
    mach_key((&ka[0]) as u64, 0x452821E638D01377)
    var klar: [u8; 512] = [0 as u8; 512]
    var geh: [u8; 512] = [0 as u8; 512]
    z = 0xBE5466CF34E90C6C
    var i: usize = 0
    while i < 512 {
        klar[i] = (nextr() & 255) as u8
        i = i + 1
    }



    let von: u64 = xts.table_start()
    let len: u64 = xts.table_length()
    io.print("delete: board at ")
    say_number(von)
    io.print(" over ")
    say_number(len)
    io.print_line(" Oktette")








    xts.forget()
    var fuell: [u8; 64] = [0 as u8; 64]
    var p: u64 = 0
    while p < 3 {
        mach_key((&fuell[0]) as u64, 0x7700 + p)
        xts.sector_encrypt((&fuell[0]) as u64, p, (&klar[0]) as u64,
            (&geh[0]) as u64, 512)
        p = p + 1
    }

    xts.sector_encrypt((&ka[0]) as u64, 1, (&klar[0]) as u64,
        (&geh[0]) as u64, 512)



    let inside: u64 = find_name(von, len, (&ka[0]) as u64, 64)
    io.print("delete: key in the board while open: ")
    say_number(inside)
    io.new_line()
    if inside >= 1 {
        io.print_line("delete: OK the probe looks in the right place")
    } else {
        io.print_line("delete: FAIL the key cannot be found at all -- the probe is useless")
        failure = failure + 1
    }


    xts.forget()
    let gone: u64 = find_name(von, len, (&ka[0]) as u64, 64)
    io.print("delete: key in the board after forget(): ")
    say_number(gone)
    io.new_line()
    if gone == 0 {
        io.print_line("delete: OK after forget() the key is no longer in the board")
    } else {
        io.print_line("delete: FAIL the key is still there after forget()")
        failure = failure + 1
    }



    var nichtnull: u64 = 0
    var k: u64 = 0
    while k < len {
        if *((von + k) as *mut u8) != 0 as u8 {
            nichtnull = nichtnull + 1
        }
        k = k + 1
    }
    io.print("delete: non-zero octets after forget(): ")
    say_number(nichtnull)
    io.new_line()
    if nichtnull == 0 {
        io.print_line("delete: OK the whole board is zeroed")
    } else {
        io.print_line("delete: FAIL something is still in the board")
        failure = failure + 1
    }

    io.print("delete: errors=")
    say_number(failure)
    io.new_line()
    if failure != 0 {
        return 1
    }
    return 0
}
