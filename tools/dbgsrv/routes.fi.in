export { route_find, route_count, names_ptr, names_len, target_ptr, target_len, line_span, action_find, base_find, action_target_ptr, action_target_len }

static mut NAMES: [u8; @NAMES_SIZE@] = "@NAMES@\0"
static mut TARGETS: [u8; @TARGETS_SIZE@] = "@TARGETS@\0"
static mut ACTION_NAMES: [u8; @ANAMES_SIZE@] = "@ANAMES@\0"
static mut ACTION_TARGETS: [u8; @ATARGETS_SIZE@] = "@ATARGETS@\0"
static mut ACTION_BASES: [u8; @ABASES_SIZE@] = "@ABASES@\0"

fn ld8(p: u64, i: u64) -> u64 {
    return (*((p + i) as *mut u8)) as u64
}

fn names_ptr() -> u64 {
    return (&NAMES[0 as usize]) as u64
}

fn names_len() -> u64 {
    return @NAMES_LEN@
}

fn target_ptr() -> u64 {
    return (&TARGETS[0 as usize]) as u64
}

fn target_len() -> u64 {
    return @TARGETS_LEN@
}

fn route_count() -> u64 {
    return @COUNT@
}

fn line_span(table: u64, total: u64, idx: u64) -> u64 {
    var i: u64 = 0
    var line: u64 = 0
    var start: u64 = 0
    while i < total {
        if ld8(table, i) == 10 {
            if line == idx {
                return (start << 32) | (i - start)
            }
            line = line + 1
            start = i + 1
        }
        i = i + 1
    }
    return 0
}

fn find_in(table: u64, total: u64, count: u64, key: u64, klen: u64) -> u64 {
    var idx: u64 = 0
    while idx < count {
        let s: u64 = line_span(table, total, idx)
        if (s & 0xFFFFFFFF) == klen {
            var k: u64 = 0
            var same: bool = true
            while k < klen {
                if ld8(table, (s >> 32) + k) != ld8(key, k) {
                    same = false
                }
                k = k + 1
            }
            if same {
                return idx + 1
            }
        }
        idx = idx + 1
    }
    return 0
}

fn route_find(path: u64, plen: u64) -> u64 {
    return find_in(names_ptr(), names_len(), route_count(), path, plen)
}

fn action_find(target: u64, tlen: u64) -> u64 {
    return find_in((&ACTION_NAMES[0 as usize]) as u64, @ANAMES_LEN@, @ACOUNT@, target, tlen)
}

fn base_find(path: u64, plen: u64) -> u64 {
    return find_in((&ACTION_BASES[0 as usize]) as u64, @ABASES_LEN@, @ABCOUNT@, path, plen)
}

fn action_target_ptr() -> u64 {
    return (&ACTION_TARGETS[0 as usize]) as u64
}

fn action_target_len() -> u64 {
    return @ATARGETS_LEN@
}
