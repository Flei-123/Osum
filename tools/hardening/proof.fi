
//

//


//




//
// AUFRUF:  nachweis <fall> [hunger]
//




//


//

//   fall=<n>  capvor=<x>  capnach=<y>  len=<l>  canary=<0|1>
//

//





// nie sehen.
//





// zu melden.
//




import std.rt
import canary

const KAP: usize = 128

fn say(o: *mut rt.Buf, s: u64, n: usize) {
    rt.buf_push_bytes(o, s, n)
}

// Rueckgabe: 1 = Kanarienvogel heil, 0 = ueberschrieben,

fn lauf(fall: u64, hunger: u64, o: *mut rt.Buf) -> u64 {
    let above: u64 = rt.heap_alloc(4096)
    if above == 0 {
        return 3
    }
    let below: u64 = rt.heap_alloc(4096)
    if below == 0 {
        return 3
    }
    if above != below + 4096 {
        return 2
    }
    let page: u64 = below + 4096 - KAP as u64
    canary.canary_set(page + KAP as u64)

    var b: rt.Buf = rt.Buf { ptr: page, len: 0, cap: KAP }


    // Kanarienvogel nicht an.
    var i: usize = 0
    while i < KAP {
        rt.buf_push(&b, 65 as u8)
        i = i + 1
    }
    let cap_vor: usize = b.cap



    // seine 256 Oktett anstandslos (gemessen: capnach=256 bei jedem

    // aufgebraucht.
    //



    // feine Stufe bekam `buf_grow` seine 256 Oktett weiter (gemessen:

    // Adresse).
    if hunger != 0 {
        var frass: u64 = 1
        var runden: u64 = 0
        while frass != 0 && runden < 1000000 {
            frass = rt.heap_alloc(65536)
            runden = runden + 1
        }
        frass = 1
        runden = 0
        while frass != 0 && runden < 1000000 {
            frass = rt.heap_alloc(4096)
            runden = runden + 1
        }
    }

    if fall == 1 {
        var k: usize = 0
        while k < 64 {
            rt.buf_push(&b, 66 as u8)
            k = k + 1
        }
    }
    if fall == 2 {
        var source: [u8; 64] = [67 as u8; 64]
        rt.buf_push_bytes(&b, (&source[0]) as u64, 64)
    }
    if fall == 3 {


        // zurueck.
        if rt.buf_reserve(&b, KAP + 64) {
            var j: usize = 0
            while j < 64 {
                rt.st8(b.ptr, KAP + j, 68 as u8)
                j = j + 1
            }
            b.len = KAP + 64
        }
    }
    if fall == 4 {




        let _egal: bool = rt.buf_reserve(&b, KAP + 64)
        var j4: usize = 0
        while j4 < 64 {
            rt.st8(b.ptr, KAP + j4, 68 as u8)
            j4 = j4 + 1
        }
        b.len = KAP + 64
    }

    let intact: u64 = canary.canary_intact(page + KAP as u64)

    var s_fall: [u8; 6] = "fall=\0"
    var s_cv: [u8; 10] = "  capvor=\0"
    var s_cn: [u8; 11] = "  capnach=\0"
    var s_len: [u8; 7] = "  len=\0"
    var s_kan: [u8; 11] = "  canary=\0\0"
    say(o, (&s_fall[0]) as u64, 5)
    rt.buf_push_dec_u64(o, fall)
    say(o, (&s_cv[0]) as u64, 9)
    rt.buf_push_dec_u64(o, cap_vor as u64)
    say(o, (&s_cn[0]) as u64, 10)
    rt.buf_push_dec_u64(o, b.cap as u64)
    say(o, (&s_len[0]) as u64, 6)
    rt.buf_push_dec_u64(o, b.len as u64)
    say(o, (&s_kan[0]) as u64, 10)
    rt.buf_push_dec_u64(o, intact)
    rt.buf_push(o, 10 as u8)

    // gesammelter Ausgabepuffer den ersten Anlauf still verschluckt


    // ihn wachsen zu lassen.
    rt.write_everything(1, (*o).ptr, (*o).len)
    rt.buf_clear(o)
    return intact
}

fn main(start: u64) -> i32 {

    var o: rt.Buf = rt.buf_new()
    rt.buf_reserve(&o, 4096)





    // run.sh ruft dieses Programm deshalb je Fall einmal.
    var fall: u64 = 1
    var hunger: u64 = 0
    if rt.arg_count(start) > 1 {
        let p1: u64 = rt.arg_ptr(start, 1)
        if rt.ld8(p1, 0) == 50 as u8 {
            fall = 2
        }
        if rt.ld8(p1, 0) == 51 as u8 {
            fall = 3
        }
        if rt.ld8(p1, 0) == 52 as u8 {
            fall = 4
        }
    }
    if rt.arg_count(start) > 2 {
        hunger = 1
    }

    let intact: u64 = lauf(fall, hunger, &o)
    if intact == 1 {
        return 0
    }
    if intact == 2 {
        return 4
    }
    if intact == 3 {
        return 3
    }
    return 1
}
