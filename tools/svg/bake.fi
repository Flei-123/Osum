import std.rt
import std.io
import svg.svgdoc

static mut obuf: [u8; 65548] = [0 as u8; 65548]

fn parse_dec(p: u64) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while rt.ld8(p, i) >= 48 as u8 && rt.ld8(p, i) <= 57 as u8 {
        v = v * 10 + ((rt.ld8(p, i)) as i64 - 48)
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 4 {
        return 2
    }
    var inp: rt.Buf = rt.buf_new()
    if !io.read_file(rt.arg_ptr(start, 1), &inp) {
        return 3
    }
    let size: i64 = parse_dec(rt.arg_ptr(start, 3))
    let out: u64 = (&obuf[0 as usize]) as u64
    let rc: i64 = svgdoc.render(inp.ptr, inp.len as u64, out, size, size)
    if rc != 0 {
        io.eprint_line("svg problems")
    }
    if !io.write_file(rt.arg_ptr(start, 2), out, (12 + size * size * 4) as usize) {
        return 4
    }
    if rc != 0 || svgdoc.unsupported() != 0 {
        return 5
    }
    return 0
}
