profile kernel

import ulib

export { u_start }

const BLOCK: u64 = 4096

fn u_start(args: u64) -> u64 {
    var usage: [u8; 33] = "usage: wbw <path> <byte> <count>\0"
    var failed: [u8; 12] = "wbw: failed\0"
    if ulib.arg_count(args) < 4 {
        ulib.esay_line((&usage[0 as usize]) as u64, 0)
        return 2
    }
    let path: u64 = ulib.arg_at(args, 1)
    let fill: u8 = __mmio_read8((ulib.arg_at(args, 2)) as *mut u8)
    let count: u64 = ulib.to_num(ulib.arg_at(args, 3))
    var buf: [u8; 4096] = [0 as u8; 4096]
    var i: u64 = 0
    while i < BLOCK {
        __mmio_write8(((&buf[0 as usize]) as u64 + i) as *mut u8, fill)
        i = i + 1
    }
    var round: u64 = 0
    while round < count {
        let fd: u64 = ulib.sys(ulib.SYS_OPEN, path, ulib.O_RDWR, 0)
        if ulib.bad(fd) {
            ulib.esay_line((&failed[0 as usize]) as u64, path)
            return 1
        }
        let w: u64 = ulib.sys(ulib.SYS_WRITE, fd, (&buf[0 as usize]) as u64, BLOCK)
        ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
        if ulib.bad(w) || w != BLOCK {
            ulib.esay_line((&failed[0 as usize]) as u64, path)
            return 1
        }
        round = round + 1
    }
    return 0
}
