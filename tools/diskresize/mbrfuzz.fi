import std.rt
import disks.bytes
import disks.table
import disks.gptw
import disks.mbrw
import memdisk

static mut scratch: [u8; 17408] = [0 as u8; 17408]

fn sc() -> u64 {
    return (&scratch[0]) as u64
}

fn entry(slot: u64, kind: u64, start: u64, len: u64) {
    let e: u64 = memdisk.ptr() + 446 + slot * 16
    bytes.st8(e, 0)
    bytes.st8(e + 4, kind)
    bytes.put32(e + 8, start)
    bytes.put32(e + 12, len)
    bytes.st8(e + 1, 254)
    bytes.st8(e + 2, 255)
    bytes.st8(e + 3, 255)
    bytes.st8(e + 5, 254)
    bytes.st8(e + 6, 255)
    bytes.st8(e + 7, 255)
}

fn build() {
    memdisk.wipe()
    entry(0, 131, 64, 500)
    entry(1, 11, 600, 800)
    entry(2, 5, 1500, 400)
    bytes.st8(memdisk.ptr() + 510, 85)
    bytes.st8(memdisk.ptr() + 511, 170)
    var i: u64 = 1
    while i < memdisk.TOTAL {
        *((memdisk.ptr() + i * 512 + (i % 509)) as *mut u8) = ((i % 251) + 1) as u8
        i = i + 1
    }
}

fn case(name: str, start: u64, sectors: u64, limit: u64) {
    memdisk.restore()
    memdisk.set_limit(limit)
    let rc: u64 = mbrw.resize(memdisk.read_sectors, memdisk.write_sectors, memdisk.TOTAL, start, sectors, sc())
    memdisk.name_begin(name)
    memdisk.dump()
    memdisk.say("case ")
    memdisk.say(name)
    memdisk.say(" rc=")
    memdisk.say_num(rc)
    memdisk.say(" writes=")
    memdisk.say_num(memdisk.writes())
    memdisk.say("\n")
}

fn main() -> i32 {
    memdisk.setup()
    build()
    memdisk.snapshot()
    memdisk.name_begin("mbase")
    memdisk.dump()
    case("m_shrink", 64, 300, 100)
    case("m_grow", 64, 536, 100)
    case("m_overlap", 64, 537, 100)
    case("m_same", 64, 500, 100)
    case("m_second", 600, 100, 100)
    case("m_ext", 1500, 100, 100)
    case("m_badstart", 65, 100, 100)
    case("m_range", 600, 1500, 100)
    case("m_zero", 64, 0, 100)
    case("m_crash", 64, 300, 0)
    memdisk.restore()
    memdisk.wipe()
    gptw.init(memdisk.write_sectors, memdisk.TOTAL, 7, sc())
    memdisk.set_limit(100)
    let rcg: u64 = mbrw.resize(memdisk.read_sectors, memdisk.write_sectors, memdisk.TOTAL, 64, 100, sc())
    memdisk.say("case m_gpt rc=")
    memdisk.say_num(rcg)
    memdisk.say("\n")
    memdisk.wipe()
    let rcz: u64 = mbrw.resize(memdisk.read_sectors, memdisk.write_sectors, memdisk.TOTAL, 64, 100, sc())
    memdisk.say("case m_nosig rc=")
    memdisk.say_num(rcz)
    memdisk.say("\n")
    memdisk.flush_out()
    return 0 as i32
}
