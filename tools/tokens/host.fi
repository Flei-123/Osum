// SPDX-License-Identifier: GPL-2.0-only
// tools/tokens/host.fi -- dumps lib/fui/tokens.fi on the build host as numeric rows
// "<group> <a> <b> <value>" (decimal); tools/tokens/check.py asserts on them.
// The library has no host dependency, so the very same file is what the system uses.
profile app
import rt.rt
import fui.tokens

static mut ob: [u8; 64] = [0 as u8; 64]

fn put_num(at: u64, v: u64) -> u64 {
    var digits: u64 = 1
    var t: u64 = v
    while t >= 10 {
        t = t / 10
        digits = digits + 1
    }
    var k: u64 = 0
    var d: u64 = v
    while k < digits {
        __mmio_write8(((&ob[0 as usize]) as u64 + at + digits - 1 - k) as *mut u8, (48 + (d % 10)) as u8)
        d = d / 10
        k = k + 1
    }
    return at + digits
}

fn row(g: u64, a: u64, b: u64, v: u64) {
    var at: u64 = put_num(0, g)
    __mmio_write8(((&ob[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
    at = put_num(at + 1, a)
    __mmio_write8(((&ob[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
    at = put_num(at + 1, b)
    __mmio_write8(((&ob[0 as usize]) as u64 + at) as *mut u8, 32 as u8)
    at = put_num(at + 1, v)
    __mmio_write8(((&ob[0 as usize]) as u64 + at) as *mut u8, 10 as u8)
    rt.write_everything(1, (&ob[0 as usize]) as u64, (at + 1) as usize)
}

fn b2n(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

fn main() -> i32 {
    var s: u64 = 1
    while s <= 2 {
        var i: u64 = 0
        while i < 4 {
            row(1, i, s, tokens.radius(i, s))
            row(3, i, s, tokens.elev_dy(i, s))
            row(4, i, s, tokens.elev_r(i, s))
            i = i + 1
        }
        i = 0
        while i < 7 {
            row(2, i, s, tokens.space(i, s))
            i = i + 1
        }
        i = 0
        while i < 5 {
            row(6, i, s, tokens.type_px(i, s))
            row(14, i, s, tokens.glass_blur(i, s, false))
            row(14, i + 10, s, tokens.glass_blur(i, s, true))
            i = i + 1
        }
        s = s + 1
    }
    var dk: u64 = 0
    while dk < 2 {
        let dark: bool = dk == 1
        var i: u64 = 0
        while i < 4 {
            row(5, i, dk, tokens.elev_alpha(i, dark))
            i = i + 1
        }
        i = 0
        while i < 10 {
            row(9, i, dk, tokens.neutral(i, dark))
            i = i + 1
        }
        i = 0
        while i < 5 {
            row(15, i, dk, tokens.glass_tint(i, dark))
            row(16, i, dk, tokens.glass_tint_pct(i, dark))
            i = i + 1
        }
        // accent states for three accents: the shipped blue, a pale yellow, a deep purple
        var ai: u64 = 0
        while ai < 3 {
            var acc: u64 = 0x2563EB
            if ai == 1 {
                acc = 0xFFD60A
            }
            if ai == 2 {
                acc = 0x5B21B6
            }
            row(10, ai, dk, tokens.acc_hover(acc, dark))
            row(11, ai, dk, tokens.acc_press(acc, dark))
            row(12, ai, dk, tokens.acc_ring(acc, dark))
            row(13, ai, dk, tokens.acc_disabled(acc, dark))
            row(17, ai, dk, tokens.acc_on(acc))
            row(18, ai, dk, tokens.state_fill(1, true, acc, dark))
            ai = ai + 1
        }
        row(19, 0, dk, tokens.contrast100(tokens.neutral(0, dark), tokens.neutral(5, dark)))
        row(19, 1, dk, tokens.contrast100(tokens.neutral(0, dark), tokens.neutral(6, dark)))
        row(19, 2, dk, tokens.contrast100(tokens.neutral(1, dark), tokens.neutral(6, dark)))
        dk = dk + 1
    }
    var t: u64 = 0
    while t <= 1000 {
        row(7, t, 0, tokens.ease_out(t))
        row(8, t, 0, tokens.ease_in_out(t))
        t = t + 100
    }
    row(20, 0, 0, tokens.dur(100))
    row(20, 1, 0, tokens.dur(160))
    row(20, 2, 0, tokens.dur(300))
    row(21, 0, 0, tokens.ease_at(80, 160))
    row(21, 1, 0, tokens.ease_at(200, 160))
    return 0
}
