import std.rt
import std.io
import hwinv.report
import hwinv.buf

static mut bufs: [u8; 6144] = [0 as u8; 6144]
static mut bufn: u64 = 0

fn lit(s: str) -> u64 {
    if bufn + (s.n as u64) + 1 > 6144 {
        bufn = 0
    }
    let at: u64 = (&bufs[0 as usize]) as u64 + bufn
    var i: usize = 0
    while i < s.n {
        *((at + i as u64) as *mut u8) = rt.ld8(s.p as u64, i) as u8
        i = i + 1
    }
    *((at + s.n as u64) as *mut u8) = 0 as u8
    bufn = bufn + (s.n as u64) + 1
    return at
}

fn len(p: u64) -> u64 {
    var n: u64 = 0
    while *((p + n) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    return n
}

fn chk(name: str, cond: bool) {
    if cond {
        io.print("OK   ")
    } else {
        io.print("FAIL ")
    }
    io.print_line(name)
}

fn run4(pci: str, usb: str, fw: str, acpi: str) {
    let a: u64 = lit(pci)
    let b: u64 = lit(usb)
    let c: u64 = lit(fw)
    let d: u64 = lit(acpi)
    report.build(a, len(a), b, len(b), c, len(c), d, len(d))
}

fn run(pci: str, usb: str, fw: str) {
    run4(pci, usb, fw, "")
}

fn has(s: str) -> bool {
    let p: u64 = buf.out_ptr()
    let w: u64 = lit(s)
    return buf.contains(p, buf.out_len(), w)
}

fn main() -> i32 {
    run("00:00.0 0600 8086:5904 irq=0\n00:02.0 0300 8086:5916 irq=11\n00:14.0 0c03 8086:9d2f irq=11\n00:15.0 1180 8086:9d60 irq=16\n00:15.1 1180 8086:9d61 irq=17\n00:16.0 0780 8086:9d3a irq=11\n00:1f.3 0403 8086:9d71 irq=11\n02:00.0 0280 8086:24fd irq=17\n03:00.0 0108 144d:a804 irq=16\n",
        "8087:0a2b port=1 hub=0 speed=full class=e0/01/01 if=e0/01/01 driver=none hc=xhci kind=x\n04f2:b5ab port=3 hub=0 speed=high class=ef/02/01 if=0e/01/00 driver=none hc=xhci kind=x\n",
        "boot_mode: UEFI\nsecure_boot: unknown\nframebuffer: 1920x1080 bpp=32\n")
    chk("hp profile: firmware UEFI", has("hwinv: firmware=UEFI\n"))
    chk("hp profile: nvme storage", has("hwinv: storage=nvme\n"))
    chk("hp profile: storage ok", has("hwinv: storage_verdict=ok\n"))
    chk("hp profile: gpu hd620", has("hwinv: gpu=8086:5916 intel-hd620\n"))
    chk("hp profile: wlan 8265 without driver", has("hwinv: wlan=8086:24fd intel-8265 driver=none\n"))
    chk("hp profile: audio hda id", has("hwinv: audio=8086:9d71 \n"))
    chk("hp profile: two serial io i2c", has("hwinv: serialio_i2c=2\n"))
    chk("hp profile: pointing i2c possible", has("hwinv: pointing=i2c-possible\n"))
    chk("hp profile: xhci 1", has("hwinv: xhci=1\n"))
    chk("hp profile: me 1", has("hwinv: me=1\n"))
    chk("hp profile: usb bt", has("hwinv: usb_bt=1\n"))
    chk("hp profile: usb camera", has("hwinv: usb_camera=1\n"))
    chk("hp profile: ethernet none", has("hwinv: ethernet=none\n"))
    chk("hp profile: raw pci copied", has("== pci ==\n00:00.0 0600 8086:5904"))

    run4("00:00.0 0600 8086:5904 irq=0\n00:15.0 1180 8086:9d60 irq=16\n", "", "boot_mode: UEFI\n",
        "tables: FACP APIC HPET MCFG SSDT DMAR \nacpi_ns: yes\nELAN0000 cid=PNP0C50 x1 \\_SB.PCI0.I2C0.TPD0\nPNP0C0D x1 \\_SB.LID0\nPNP0C0A x1 \\_SB.BAT0\nPNP0C09 x1 \\_SB.PCI0.LPCB.EC0\nPNP0303 x1 \\_SB.PCI0.LPCB.PS2K\n")
    chk("acpi: ns yes", has("hwinv: acpi_ns=yes\n"))
    chk("acpi: tables copied", has("hwinv: acpi_tables=FACP APIC HPET MCFG SSDT DMAR"))
    chk("acpi: i2c-hid touchpad counted", has("hwinv: acpi_i2chid=1\n"))
    chk("acpi: pointing names acpi-i2c-hid", has("hwinv: pointing=acpi-i2c-hid i2c-possible\n"))
    chk("acpi: ps2 keyboard", has("hwinv: acpi_ps2kbd=1\n"))
    chk("acpi: no ps2 mouse", has("hwinv: acpi_ps2mouse=0\n"))
    chk("acpi: ec lid battery", has("hwinv: acpi_ec=1\n") && has("hwinv: acpi_lid=1\n") && has("hwinv: acpi_battery=1\n"))
    chk("acpi: raw copy", has("== acpi ==\ntables: FACP"))
    run4("", "", "", "tables: FACP APIC DSDT \nacpi_ns: no\n")
    chk("acpi: ns no", has("hwinv: acpi_ns=no\n"))
    chk("acpi: no i2c-hid without entries", has("hwinv: acpi_i2chid=0\n"))
    run("", "", "")
    chk("acpi: missing file is unknown", has("hwinv: acpi_ns=unknown\n"))

    run("00:1f.2 0104 8086:282a irq=11\n00:02.0 0300 8086:5916 irq=11\n",
        "", "boot_mode: UEFI\n")
    chk("rst raid: storage raid", has("hwinv: storage=raid\n"))
    chk("rst raid: verdict names the BIOS fix", has("storage_verdict=raid-rst-nvme-hidden (BIOS: set SATA mode to AHCI"))
    chk("rst raid: not ok", !has("storage_verdict=ok"))

    run("00:1f.2 0106 8086:9d03 irq=11\n03:00.0 0108 144d:a804 irq=16\n", "", "boot_mode: UEFI\n")
    chk("ahci+nvme: both kinds", has("hwinv: storage=ahci+nvme\n"))

    run("00:00.0 0600 8086:1237 irq=0\n00:02.0 0300 1234:1111 irq=11\n00:03.0 0200 8086:100e irq=11\n",
        "0627:0001 port=1 hub=0 speed=full class=00/00/00 if=03/01/01 driver=keyboard hc=xhci kind=x\n",
        "boot_mode: BIOS\n")
    chk("qemu: firmware BIOS", has("hwinv: firmware=BIOS\n"))
    chk("qemu: no disk", has("hwinv: storage=none\n"))
    chk("qemu: verdict no-disk", has("storage_verdict=no-disk"))
    chk("qemu: gpu is qemu", has("hwinv: gpu=1234:1111 qemu\n"))
    chk("qemu: wlan none", has("hwinv: wlan=none\n"))
    chk("qemu: ethernet listed", has("hwinv: ethernet=8086:100e \n"))
    chk("qemu: pointing not i2c", has("hwinv: pointing=ps2-or-unlisted\n"))
    chk("qemu: usb kbd 1", has("hwinv: usb_kbd=1\n"))
    run("", "", "")
    chk("empty input: no crash, no disk", has("hwinv: storage=none\n"))
    chk("empty input: firmware unknown", has("hwinv: firmware=unknown\n"))
    chk("no /proc/cpus: no cpus key", !has("hwinv: cpus_online="))
    chk("no /proc/cpus: no raw cpus section", !has("== cpus =="))
    let cp: u64 = lit("cpus_online=3 cpus_madt=4 failed=1 kick=off kicks=7\ncpu0 apic=0 online=1 why=- esr=0x0\ncpu3 apic=3 online=0 why=nosipi esr=0x40\n")
    report.feed_cpus(cp, len(cp))
    run("", "", "")
    chk("cpus: online key", has("hwinv: cpus_online=3\n"))
    chk("cpus: madt key", has("hwinv: cpus_madt=4\n"))
    chk("cpus: failed key", has("hwinv: failed=1\n"))
    chk("cpus: kick key", has("hwinv: kick=off\n"))
    chk("cpus: kicks key", has("hwinv: kicks=7\n"))
    chk("cpus: raw section keeps the per-core why", has("== cpus ==") && has("why=nosipi"))
    chk("cpus: per-core lines are not keys", !has("hwinv: cpu3"))
    report.feed_cpus(0, 0)
    chk("no /proc/inputdevs: no i2c key", !has("hwinv: i2c_ctrls="))
    let ip: u64 = lit("i2c_ctrls=2 i2c_devs=3 i2c_hung=1 i2c_aml=0 i2c_tables=5 hid_devs=4\nctrl0 bdf=0x001500 state=ok\ndev1 ctrl=1 adr=0x10 kind=16 state=ok\n")
    report.feed_inputdevs(ip, len(ip))
    run("", "", "")
    chk("inputdevs: ctrls key", has("hwinv: i2c_ctrls=2\n"))
    chk("inputdevs: devs key", has("hwinv: i2c_devs=3\n"))
    chk("inputdevs: hung key", has("hwinv: i2c_hung=1\n"))
    chk("inputdevs: hid key", has("hwinv: hid_devs=4\n"))
    chk("inputdevs: raw section keeps the device line", has("== inputdevs ==") && has("adr=0x10 kind=16"))
    chk("inputdevs: device lines are not keys", !has("hwinv: dev1"))
    report.feed_inputdevs(0, 0)
    chk("no /proc/backlight: no backlight key", !has("hwinv: backlight."))
    let bl: u64 = lit("source 2\npercent 60\nhw.any 1\nchanges 3\next.count 2\next.last0 0x6e\n")
    report.feed_backlight(bl, len(bl))
    run("", "", "")
    chk("backlight: source key", has("hwinv: backlight.source=2\n"))
    chk("backlight: percent key", has("hwinv: backlight.percent=60\n"))
    chk("backlight: changes key", has("hwinv: backlight.changes=3\n"))
    chk("backlight: unknown ext code key", has("hwinv: backlight.ext.last0=0x6e\n"))
    chk("backlight: raw section", has("== backlight =="))
    report.feed_backlight(0, 0)
    return 0
}
