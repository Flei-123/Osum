import std.rt
import vault.vrand

export { arg, num, load_file, store_file, hex_into, det_seed }

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn num(s: str) -> usize {
    var v: usize = 0
    var i: usize = 0
    while i < s.n {
        v = v * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as usize
        i = i + 1
    }
    return v
}

fn load_file(path: str, out: *mut rt.Buf) -> bool {
    var c: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&c, path.p as u64, path.n)
    rt.buf_push(&c, 0 as u8)
    let ok: bool = rt.read_file(rt.buf_ptr(&c), out)
    rt.buf_free(&c)
    return ok
}

fn store_file(path: str, p: u64, n: usize) -> bool {
    var c: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&c, path.p as u64, path.n)
    rt.buf_push(&c, 0 as u8)
    let ok: bool = rt.write_file(rt.buf_ptr(&c), p, n)
    rt.buf_free(&c)
    return ok
}

fn hex_val(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c - 87 as u8) as i32
    }
    return 0 - 1
}

fn hex_into(s: str, out: *mut rt.Buf) -> bool {
    if s.n % 2 != 0 {
        return false
    }
    var i: usize = 0
    while i < s.n {
        let h: i32 = hex_val(rt.ld8(s.p as u64, i))
        let l: i32 = hex_val(rt.ld8(s.p as u64, i + 1))
        if h < 0 || l < 0 {
            return false
        }
        rt.buf_push(out, (h * 16 + l) as u8)
        i = i + 2
    }
    return true
}

fn det_seed(seed: str, ascii: str) {
    if num(seed) != 0 {
        vrand.det_enable(num(seed) as u64, num(ascii) != 0)
    }
}
