import std.rt
import vault.vlayout
import vault.vrand
import vault.container
import vault.recovery

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn num(s: str) -> usize {
    var v: usize = 0
    var i: usize = 0
    while i < s.n {
        v = v * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as usize
        i = i + 1
    }
    return v
}

fn load_file(path: str, out: *mut rt.Buf) -> bool {
    var c: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&c, path.p as u64, path.n)
    rt.buf_push(&c, 0 as u8)
    let ok: bool = rt.read_file(rt.buf_ptr(&c), out)
    rt.buf_free(&c)
    return ok
}

fn store_file(path: str, p: u64, n: usize) -> bool {
    var c: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&c, path.p as u64, path.n)
    rt.buf_push(&c, 0 as u8)
    let ok: bool = rt.write_file(rt.buf_ptr(&c), p, n)
    rt.buf_free(&c)
    return ok
}

fn det_from(seed: str, ascii: str) {
    if num(seed) != 0 {
        vrand.det_enable(num(seed) as u64, num(ascii) != 0)
    }
}

fn cmd_create(start: u64) -> i32 {
    var body: rt.Buf = rt.buf_new()
    if !load_file(arg(start, 4), &body) {
        return 90
    }
    let pw: str = arg(start, 3)
    det_from(arg(start, 8), arg(start, 9))
    var img: rt.Buf = rt.buf_new()
    let rc: i32 = container.create(&img, rt.buf_ptr(&body), rt.buf_len(&body),
        pw.p as u64, pw.n, num(arg(start, 5)), num(arg(start, 6)),
        num(arg(start, 7)), 0 as u8, 0)
    if rc != 0 {
        return rc
    }
    let rc2: i32 = container.file_save(arg(start, 2), &img)
    return rc2
}

fn cmd_open(start: u64, kind: u8, pwi: usize, outi: usize) -> i32 {
    var img: rt.Buf = rt.buf_new()
    let rc: i32 = container.file_load(arg(start, 2), &img)
    if rc != 0 {
        return rc
    }
    let pw: str = arg(start, pwi)
    var out: rt.Buf = rt.buf_new()
    let rc2: i32 = container.open_pw(rt.buf_ptr(&img), rt.buf_len(&img), kind,
        pw.p as u64, pw.n, &out, 0)
    if rc2 != 0 {
        return rc2
    }
    store_file(arg(start, outi), rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}

fn cmd_openrec(start: u64) -> i32 {
    var img: rt.Buf = rt.buf_new()
    let rc: i32 = container.file_load(arg(start, 2), &img)
    if rc != 0 {
        return rc
    }
    let text: str = arg(start, 3)
    var key: [u8; 32] = [0; 32]
    let rrc: i32 = recovery.decode(text.p as u64, text.n, (&key[0]) as u64)
    if rrc != 0 {
        return 80 + rrc
    }
    var out: rt.Buf = rt.buf_new()
    let rc2: i32 = container.open_key(rt.buf_ptr(&img), rt.buf_len(&img),
        vlayout.SLOT_RECOVERY, (&key[0]) as u64, &out, 0)
    if rc2 != 0 {
        return rc2
    }
    store_file(arg(start, 4), rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}

fn unlock(start: u64, img: *mut rt.Buf, vk: u64) -> i32 {
    let rc: i32 = container.file_load(arg(start, 2), img)
    if rc != 0 {
        return rc
    }
    let pw: str = arg(start, 3)
    var out: rt.Buf = rt.buf_new()
    return container.open_pw(rt.buf_ptr(img), rt.buf_len(img), vlayout.SLOT_PW,
        pw.p as u64, pw.n, &out, vk)
}

fn cmd_addrec(start: u64) -> i32 {
    var img: rt.Buf = rt.buf_new()
    var vk: [u8; 32] = [0; 32]
    let rc: i32 = unlock(start, &img, (&vk[0]) as u64)
    if rc != 0 {
        return rc
    }
    det_from(arg(start, 4), arg(start, 5))
    var key: [u8; 32] = [0; 32]
    recovery.generate((&key[0]) as u64)
    let rc2: i32 = container.slot_add_key(&img, (&vk[0]) as u64,
        vlayout.SLOT_RECOVERY, (&key[0]) as u64)
    if rc2 != 0 {
        return rc2
    }
    var text: rt.Buf = rt.buf_new()
    recovery.encode((&key[0]) as u64, &text)
    rt.buf_push(&text, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&text), rt.buf_len(&text))
    return container.file_save(arg(start, 2), &img)
}

fn cmd_addlogin(start: u64) -> i32 {
    var img: rt.Buf = rt.buf_new()
    var vk: [u8; 32] = [0; 32]
    let rc: i32 = unlock(start, &img, (&vk[0]) as u64)
    if rc != 0 {
        return rc
    }
    det_from(arg(start, 5), arg(start, 6))
    let lp: str = arg(start, 4)
    let rc2: i32 = container.slot_add_pw(&img, (&vk[0]) as u64, vlayout.SLOT_LOGIN,
        lp.p as u64, lp.n, 64, 1, 1)
    if rc2 != 0 {
        return rc2
    }
    return container.file_save(arg(start, 2), &img)
}

fn cmd_update(start: u64) -> i32 {
    var img: rt.Buf = rt.buf_new()
    var vk: [u8; 32] = [0; 32]
    let rc: i32 = unlock(start, &img, (&vk[0]) as u64)
    if rc != 0 {
        return rc
    }
    var body: rt.Buf = rt.buf_new()
    if !load_file(arg(start, 4), &body) {
        return 90
    }
    det_from(arg(start, 5), arg(start, 6))
    let rc2: i32 = container.update(&img, (&vk[0]) as u64, rt.buf_ptr(&body),
        rt.buf_len(&body))
    if rc2 != 0 {
        return rc2
    }
    return container.file_save(arg(start, 2), &img)
}

fn cmd_rmslot(start: u64) -> i32 {
    var img: rt.Buf = rt.buf_new()
    var vk: [u8; 32] = [0; 32]
    let rc: i32 = unlock(start, &img, (&vk[0]) as u64)
    if rc != 0 {
        return rc
    }
    let rc2: i32 = container.slot_remove(&img, (&vk[0]) as u64, num(arg(start, 4)) as u8)
    if rc2 != 0 {
        return rc2
    }
    return container.file_save(arg(start, 2), &img)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 99
    }
    let cmd: str = arg(start, 1)
    if cmd == "create" && rt.arg_count(start) >= 10 {
        return cmd_create(start)
    }
    if cmd == "open" && rt.arg_count(start) >= 5 {
        return cmd_open(start, vlayout.SLOT_PW, 3, 4)
    }
    if cmd == "openlogin" && rt.arg_count(start) >= 5 {
        return cmd_open(start, vlayout.SLOT_LOGIN, 3, 4)
    }
    if cmd == "openrec" && rt.arg_count(start) >= 5 {
        return cmd_openrec(start)
    }
    if cmd == "addrec" && rt.arg_count(start) >= 6 {
        return cmd_addrec(start)
    }
    if cmd == "addlogin" && rt.arg_count(start) >= 7 {
        return cmd_addlogin(start)
    }
    if cmd == "update" && rt.arg_count(start) >= 7 {
        return cmd_update(start)
    }
    if cmd == "rmslot" && rt.arg_count(start) >= 5 {
        return cmd_rmslot(start)
    }
    return 98
}
