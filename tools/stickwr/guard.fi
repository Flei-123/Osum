// SPDX-License-Identifier: GPL-2.0-only
// tools/stickwr/guard.fi -- host test of lib/stickwr/guard.fi (D7 stick writer guards).
// Prints "OK name" / "FAIL name"; exit 0 = ran through.

import std.rt
import std.io
import stickwr.guard

static mut bufs: [u8; 4096] = [0 as u8; 4096]
static mut bufn: u64 = 0

fn lit(s: str) -> u64 {
    if bufn + (s.n as u64) + 1 > 4096 {
        bufn = 0
    }
    let at: u64 = (&bufs[0 as usize]) as u64 + bufn
    var i: usize = 0
    while i < s.n {
        *((at + i as u64) as *mut u8) = rt.ld8(s.p as u64, i) as u8
        i = i + 1
    }
    *((at + s.n as u64) as *mut u8) = 0 as u8
    bufn = bufn + (s.n as u64) + 1
    return at
}

fn chk(name: str, cond: bool) {
    if cond {
        io.print("OK   ")
    } else {
        io.print("FAIL ")
    }
    io.print_line(name)
}

fn main() -> i32 {
    // target: exactly /dev/usb (whole first stick)
    chk("target /dev/usb", guard.target_ok(lit("/dev/usb")))
    chk("target index of /dev/usb is 0", guard.target_index(lit("/dev/usb")) == 0)
    chk("refuse /dev/hda", !guard.target_ok(lit("/dev/hda")))
    chk("refuse /dev/hdb", !guard.target_ok(lit("/dev/hdb")))
    chk("refuse /dev/nvme0", !guard.target_ok(lit("/dev/nvme0")))
    chk("refuse /dev/sda", !guard.target_ok(lit("/dev/sda")))
    chk("refuse /dev/ram0", !guard.target_ok(lit("/dev/ram0")))
    chk("refuse /dev/usb0 (no such node)", !guard.target_ok(lit("/dev/usb0")))
    chk("refuse /dev/usb1 (partition)", !guard.target_ok(lit("/dev/usb1")))
    chk("refuse /dev/usb3", !guard.target_ok(lit("/dev/usb3")))
    chk("refuse /dev/usb4", !guard.target_ok(lit("/dev/usb4")))
    chk("refuse /dev/usb00", !guard.target_ok(lit("/dev/usb00")))
    chk("refuse /dev/usb/", !guard.target_ok(lit("/dev/usb/")))
    chk("refuse /dev/usbx", !guard.target_ok(lit("/dev/usbx")))
    chk("refuse usb (relative)", !guard.target_ok(lit("usb")))
    chk("refuse //dev/usb", !guard.target_ok(lit("//dev/usb")))
    chk("refuse /medien/usb", !guard.target_ok(lit("/medien/usb")))
    chk("refuse /dev/../dev/usb", !guard.target_ok(lit("/dev/../dev/usb")))
    chk("refuse /tmp/x.img as target", !guard.target_ok(lit("/tmp/x.img")))
    chk("refuse empty target", !guard.target_ok(lit("")))
    chk("refuse /dev/USB (case)", !guard.target_ok(lit("/dev/USB")))
    // sources
    chk("source a.img", guard.source_ok(lit("/tmp/a.img")))
    chk("source a.iso", guard.source_ok(lit("/tmp/a.iso")))
    chk("source A.ISO (case)", guard.source_ok(lit("/tmp/A.ISO")))
    chk("source x.Img", guard.source_ok(lit("x.Img")))
    chk("refuse a.txt", !guard.source_ok(lit("/tmp/a.txt")))
    chk("refuse a.img.txt", !guard.source_ok(lit("/tmp/a.img.txt")))
    chk("refuse a.imgx", !guard.source_ok(lit("/tmp/a.imgx")))
    chk("refuse .img alone-ish (4 chars)", !guard.source_ok(lit(".img")))
    chk("refuse noext", !guard.source_ok(lit("/tmp/img")))
    chk("refuse ../a.img", !guard.source_ok(lit("../a.img")))
    chk("refuse empty source", !guard.source_ok(lit("")))
    // check(): order and codes
    chk("check ok", guard.check(lit("/tmp/a.img"), lit("/dev/usb"), true) == 0)
    chk("check no --yes", guard.check(lit("/tmp/a.img"), lit("/dev/usb"), false) == guard.E_NOYES)
    chk("check hda with --yes", guard.check(lit("/tmp/a.img"), lit("/dev/hda"), true) == guard.E_TARGET)
    chk("check hda without --yes: target first", guard.check(lit("/tmp/a.img"), lit("/dev/hda"), false) == guard.E_TARGET)
    chk("check bad source ext", guard.check(lit("/tmp/a.txt"), lit("/dev/usb"), true) == guard.E_SOURCE)
    chk("check device as source", guard.check(lit("/dev/hda"), lit("/dev/usb"), true) == guard.E_SRCDEV)
    chk("check /dev/x.img as source", guard.check(lit("/dev/x.img"), lit("/dev/usb"), true) == guard.E_SRCDEV)
    chk("check /proc/x.img as source", guard.check(lit("/proc/x.img"), lit("/dev/usb"), true) == guard.E_SRCDEV)
    // geometry
    chk("BLOCK is 64 KiB", guard.BLOCK == 65536)
    chk("chunk of 200000 at 0", guard.chunk(200000, 0) == 65536)
    chk("chunk tail", guard.chunk(200000, 196608) == 3392)
    chk("chunk at end is 0", guard.chunk(200000, 200000) == 0)
    chk("chunk exact multiple", guard.chunk(131072, 65536) == 65536)
    chk("blocks(0)", guard.blocks(0) == 0)
    chk("blocks(1)", guard.blocks(1) == 1)
    chk("blocks(65536)", guard.blocks(65536) == 1)
    chk("blocks(65537)", guard.blocks(65537) == 2)
    chk("blocks(200000)", guard.blocks(200000) == 4)
    return 0
}
