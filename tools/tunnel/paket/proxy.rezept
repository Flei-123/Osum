# Das Paket `proxy` -- SOCKS5, HTTP CONNECT und die Tor-Anbindung.
#
# TEILT MIT `vpn` KEINE EINZIGE ZEILE: lib/socks/socks5.fi hat keine
# import-Zeile, weil SOCKS5 nichts verschluesselt. Deshalb ein eigenes
# Paket und keine Abhaengigkeit in `braucht=`.
#
# Der Name im Titel verspricht nichts ueber Anonymitaet. Das Paket
# BINDET einen Tor-Klienten AN, es ist keiner -- siehe docs/TUNNEL.md.
name=proxy
fassung=1.0.0
titel=Proxy
info=Verbindungen ueber SOCKS5 oder HTTP CONNECT -- auch ueber einen Tor-Klienten
keys=proxy,socks,socks5,http,connect,tor,onion
handle=config
handle=konsole
datei=start PROXYELF
