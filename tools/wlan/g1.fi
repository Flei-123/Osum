import std.rt
import std.io
import wlan.iwl_g1
import wlan.iwl_probe
import wlan.iwl_pwr

static mut line: [u8; 64] = [0; 64]
static mut model: [u64; 2048] = [0; 2048]

fn hex(at: usize, v: u64) -> usize {
    var n: usize = at
    var s: u64 = 28
    while true {
        let d: u64 = (v >> s) & 15
        if d < 10 { line[n] = (48 + d) as u8 } else { line[n] = (87 + d) as u8 }
        n = n + 1
        if s == 0 { break }
        s = s - 4
    }
    return n - at
}

fn model_rd(ctx: u64, off: u64) -> u64 {
    if off == 0x024 { return (model[(off >> 2) as usize] | iwl_pwr.GP_CLOCK_READY) & (0xFFFFFFFF ^ iwl_pwr.GP_SLEEP) }
    return model[(off >> 2) as usize]
}

fn model_wr(ctx: u64, off: u64, v: u64) {
    model[(off >> 2) as usize] = v & 0xFFFFFFFF
}

fn put_model(g: *mut iwl_g1.Prog) {
    var p: iwl_probe.Probe = iwl_probe.probe_new()
    iwl_probe.mmio_set(&p, 0, model_rd, model_wr)
    model[1] = 0xAABBCCDD
    iwl_g1.prog_run(&p, g)
    line[0] = 82 as u8
    line[1] = 32 as u8
    let n: usize = hex(2, model[1])
    io.print_line_bytes((&line[0]) as u64, 2 + n)
}

fn put(g: *mut iwl_g1.Prog) {
    var i: usize = 0
    while i < iwl_g1.prog_len(g) {
        var n: usize = 0
        line[0] = (48 + iwl_g1.prog_kind(g, i)) as u8
        line[1] = 32 as u8
        n = 2 + hex(2, iwl_g1.prog_addr(g, i))
        line[n] = 32 as u8
        let m: usize = hex(n + 1, iwl_g1.prog_val(g, i))
        io.print_line_bytes((&line[0]) as u64, n + 1 + m)
        i = i + 1
    }
}

fn main() -> i32 {
    var a: iwl_g1.Prog = iwl_g1.prog_new()
    var b: iwl_g1.Prog = iwl_g1.prog_new()
    var c: iwl_g1.Prog = iwl_g1.prog_new()
    var d: iwl_g1.Prog = iwl_g1.prog_new()
    iwl_g1.prog_rx_init(&a, 0x12345600, 0x12346010)
    iwl_g1.prog_tx_init(&b, 0x23456000, 0x23457000, 9, 0x23458000, 10)
    iwl_g1.prog_scd_head(&c, 0x34567400)
    iwl_g1.prog_scd_tail(&c)
    iwl_g1.prog_txq_enable(&d, 0x800000, 9, 7)
    iwl_g1.prog_rx_wptr(&d, 21)
    iwl_g1.prog_tx_doorbell(&d, 9, 3)
    put(&a)
    put(&b)
    put(&c)
    put(&d)
    var e: iwl_g1.Prog = iwl_g1.prog_new()
    iwl_g1.prog_rx_init(&e, 0x12345600, 0x12346010)
    put_model(&e)
    return 0
}
