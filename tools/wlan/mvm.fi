// tools/wlan/mvm.fi -- host test for lib/wlan/iwl_mvm.fi: prints "<name> <hex>" for fixed parameters.
import std.rt
import std.io
import wlan.iwl_mvm
import wlan.iwl_mvm_ctx
import wlan.iwl_mvm_scan
import wlan.iwl_mvm_tx

static mut buf: [u8; 2048] = [0; 2048]
static mut line: [u8; 5000] = [0; 5000]
static mut mac: [u8; 6] = [0x02, 0x11, 0x22, 0x33, 0x44, 0x55]
static mut key: [u8; 16] = [0; 16]
static mut pn: [u8; 6] = [1, 0, 0, 0, 0, 0]
static mut rxp: [u8; 64] = [0; 64]
static mut bssid: [u8; 6] = [0x10, 0x20, 0x30, 0x40, 0x50, 0x60]
static mut chans: [u8; 4] = [1, 6, 11, 36]
static mut probe: [u8; 40] = [0; 40]
static mut ssid: [u8; 4] = [0x48, 0x50, 0x41, 0x50]
static mut frame: [u8; 30] = [0; 30]

fn hexd(v: u64) -> u8 {
    if v < 10 { return (48 + v) as u8 }
    return (87 + v) as u8
}

fn emit(name: u64, nlen: usize, len: u64) {
    var at: usize = 0
    var i: usize = 0
    while i < nlen {
        line[at] = rt.ld8(name, i) as u8
        at = at + 1
        i = i + 1
    }
    line[at] = 32 as u8
    at = at + 1
    var k: u64 = 0
    while k < len {
        let b: u64 = buf[k as usize] as u64
        line[at] = hexd(b >> 4)
        line[at + 1] = hexd(b & 15)
        at = at + 2
        k = k + 1
    }
    io.print_line_bytes((&line[0]) as u64, at)
}

fn clr() {
    var i: usize = 0
    while i < 2048 { buf[i] = 0 as u8
        i = i + 1 }
}

fn main() -> i32 {
    var i: usize = 0
    while i < 16 { key[i] = (0xA0 + i) as u8
        i = i + 1 }
    let b: u64 = (&buf[0]) as u64
    var n1: [u8; 4] = "nvm\0"
    var n14: [u8; 4] = "sr7\0"
    var n2: [u8; 4] = "phy\0"
    var n3: [u8; 4] = "ant\0"
    var n4: [u8; 4] = "ctx\0"
    var n5: [u8; 4] = "sta\0"
    var n6: [u8; 4] = "key\0"
    var n7: [u8; 5] = "gkey\0"
    var l: u64 = 0
    clr()
    l = iwl_mvm.mvm_nvm_read(b, 9, 3, iwl_mvm.NVM_SEC_HW, 0x120, 0x200)
    emit((&n1[0]) as u64, 3, l)
    clr()
    l = iwl_mvm.mvm_phy_cfg(b, 9, 4, 0x00330F00, 0xFFFFFFFF, 0x1)
    emit((&n2[0]) as u64, 3, l)
    clr()
    l = iwl_mvm.mvm_tx_ant(b, 9, 5, 3)
    emit((&n3[0]) as u64, 3, l)
    clr()
    l = iwl_mvm.mvm_phy_ctx(b, 0, 6, 1, 2, 1, 1, 6, 0, 0, 0x6A)
    emit((&n4[0]) as u64, 3, l)
    clr()
    l = iwl_mvm.mvm_add_sta(b, 0, 7, 0, 0x0100, (&mac[0]) as u64, 0, 0x4, 0xFF, 1, 0x10)
    emit((&n5[0]) as u64, 3, l)
    clr()
    l = iwl_mvm.mvm_sta_key_ccmp(b, 0, 8, 0, 1, 0, false, (&key[0]) as u64, (&pn[0]) as u64)
    emit((&n6[0]) as u64, 3, l)
    clr()
    l = iwl_mvm.mvm_sta_key_ccmp(b, 0, 9, 1, 2, 2, true, (&key[0]) as u64, (&pn[0]) as u64)
    emit((&n7[0]) as u64, 4, l)
    i = 0
    while i < 40 { probe[i] = (0x40 + i) as u8
        i = i + 1 }
    i = 0
    while i < 30 { frame[i] = (0x80 + i) as u8
        i = i + 1 }
    var n8: [u8; 4] = "mac\0"
    var n9: [u8; 4] = "bnd\0"
    var n10: [u8; 4] = "scf\0"
    var n11: [u8; 4] = "srq\0"
    var n12: [u8; 4] = "sab\0"
    var n13: [u8; 3] = "tx\0"
    clr()
    l = iwl_mvm_ctx.mvm_mac_ctx(b, 0, 10, iwl_mvm_ctx.mvm_id_color(1, 2), iwl_mvm_ctx.CTXT_ADD, iwl_mvm_ctx.MAC_TYPE_BSS_STA, 0, (&mac[0]) as u64, (&bssid[0]) as u64, 0xF, 0x15F, 0x3, 1, 1, 0x4C, 0x3)
    var ac: u64 = 0
    while ac < 5 {
        iwl_mvm_ctx.mvm_mac_ac(b, ac, 15 + ac, 1023 - ac, 2 + ac, 1 << (ac & 3), 47 * ac)
        ac = ac + 1
    }
    iwl_mvm_ctx.mvm_mac_sta(b, 1, 100, 0x0102030405060708, 100, 3, 1, 10, 7, 55)
    emit((&n8[0]) as u64, 3, l)
    clr()
    l = iwl_mvm_ctx.mvm_binding(b, 0, 11, iwl_mvm_ctx.mvm_id_color(2, 1), iwl_mvm_ctx.CTXT_ADD, iwl_mvm_ctx.mvm_id_color(1, 2), iwl_mvm_ctx.CTXT_INVALID, iwl_mvm_ctx.CTXT_INVALID, iwl_mvm_ctx.mvm_id_color(1, 2))
    emit((&n9[0]) as u64, 3, l)
    clr()
    l = iwl_mvm_scan.mvm_scan_cfg(b, 0, 12, iwl_mvm_scan.SCAN_CFG_ACTIVATE | iwl_mvm_scan.SCAN_CFG_SET_TX_CHAINS | iwl_mvm_scan.SCAN_CFG_SET_RX_CHAINS | iwl_mvm_scan.SCAN_CFG_SET_ALL_TIMES | iwl_mvm_scan.SCAN_CFG_SET_MAC_ADDR, 3, 3, 0xFF, 50, 120, 20, 110, 40, 0, (&mac[0]) as u64, 2, 1, (&chans[0]) as u64, 4)
    emit((&n10[0]) as u64, 3, l)
    clr()
    l = iwl_mvm_scan.mvm_scan_req(b, 0, 13, iwl_mvm_scan.SCAN_FLAG_START_NOTIF, 5, 4, iwl_mvm_scan.SCAN_GEN_ITER_COMPLETE | iwl_mvm_scan.SCAN_GEN_MULTIPLE_SSID, 0, 0, 20, 110, 40, 50, 120, 2, 1, 3)
    iwl_mvm_scan.mvm_scan_chan(b, 0, 0x40000000, 1, 1, 0)
    iwl_mvm_scan.mvm_scan_chan(b, 1, 0x40000000, 6, 1, 0)
    iwl_mvm_scan.mvm_scan_chan(b, 2, 0x80000000, 36, 1, 0)
    iwl_mvm_scan.mvm_scan_tail(b, 3, 0, 0, 1, (&probe[0]) as u64, 24, 6, 4, 6, (&ssid[0]) as u64, 4)
    emit((&n11[0]) as u64, 3, l)
    clr()
    l = iwl_mvm_scan.mvm_scan_req7(b, 0, 16, iwl_mvm_scan.SCAN_FLAG_START_NOTIF, 5, iwl_mvm_scan.SCAN_GEN_ITER_COMPLETE | iwl_mvm_scan.SCAN_GEN_MULTIPLE_SSID, 0, 10, 110, 44, 2, 10, 300, 50, 120, 6, 1, 3, 3)
    iwl_mvm_scan.mvm_scan_chan_at(b, iwl_mvm_scan.SCAN_V7_HEAD_LEN, 0, 0x40000000, 1, 1, 0)
    iwl_mvm_scan.mvm_scan_chan_at(b, iwl_mvm_scan.SCAN_V7_HEAD_LEN, 1, 0x40000000, 6, 1, 0)
    iwl_mvm_scan.mvm_scan_chan_at(b, iwl_mvm_scan.SCAN_V7_HEAD_LEN, 2, 0x80000000, 36, 1, 0)
    iwl_mvm_scan.mvm_scan_tail_at(b, iwl_mvm_scan.SCAN_V7_HEAD_LEN + 24, 0, 0, 1, (&probe[0]) as u64, 24, 6, 4, 6, (&ssid[0]) as u64, 4)
    emit((&n14[0]) as u64, 3, l)
    clr()
    l = iwl_mvm_scan.mvm_scan_abort(b, 0, 14, 5)
    emit((&n12[0]) as u64, 3, l)
    clr()
    l = iwl_mvm_tx.mvm_tx_cmd(b, 2, 15, 0, iwl_mvm_tx.TX_FLG_ACK | iwl_mvm_tx.TX_FLG_SEQ_CTL, 0x4001, 1, 0, 0, (&key[0]) as u64, 0xFFFF, 0x1234ABCD00, 15, 7, 0, (&frame[0]) as u64, 30)
    emit((&n13[0]) as u64, 2, l)
    return 0
}
