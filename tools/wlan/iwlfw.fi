// SPDX-License-Identifier: GPL-2.0-only
// tools/wlan/iwlfw.fi -- host driver for lib/wlan/iwl_fw.fi. stdin = a .ucode blob (synthetic or real).
// Prints "RC <n>" and, on success, one "SUM ..." line plus one "SEC ..." line per section; the
// harness (iwlfw.sh) compares them with an independent Python parse of the same bytes.
import std.rt
import std.io
import wlan.iwl_fw
import wlan.iwl_fwcaps

static mut txtb: [u8; 200] = [0; 200]
static mut tlen: usize = 0

fn tch(c: u64) {
    if tlen < 190 {
        txtb[tlen] = (c & 255) as u8
        tlen = tlen + 1
    }
}
fn tlit(w: str) {
    var i: usize = 0
    while i < w.n {
        tch(rt.ld8(w.p as u64, i) as u64)
        i = i + 1
    }
}
fn tnum(v: u64) {
    if v >= 10 { tnum(v / 10) }
    tch(48 + (v % 10))
}
fn temit() {
    io.print_line_bytes((&txtb[0]) as u64, tlen)
    tlen = 0
}

static mut probe_cmds: [u64; 6] = [0x0D, 0x18, 0x1C, 0x6A, 0x10D, 0x50D]

fn tver(v: i64) {
    if v < 0 {
        tlit("none")
    } else {
        tnum(v as u64)
    }
}

fn main() -> i32 {
    var inp: rt.Buf = rt.buf_new()
    rt.read_stdin(&inp)
    let blob: u64 = rt.buf_ptr(&inp)
    let blen: usize = rt.buf_len(&inp)
    var f: iwl_fw.FwInfo = iwl_fw.fwinfo_new()
    let rc: i64 = iwl_fw.fw_parse(blob, blen, &f)
    tlit("RC ")
    if rc < 0 {
        tlit("-")
        tnum((0 - rc) as u64)
    } else {
        tnum(rc as u64)
    }
    temit()
    if rc != 0 { return 0 }
    tlit("SUM ver=")
    tnum(f.ver)
    tlit(" tlv=")
    tnum(f.n_tlv)
    tlit(" flags=")
    tnum(f.flags)
    tlit(" sku=")
    tnum(f.phy_sku)
    tlit(" cpu=")
    tnum(f.num_cpu)
    tlit(" api0=")
    tnum(f.api0)
    tlit(" capa0=")
    tnum(f.capa0)
    tlit(" paging=")
    tnum(f.paging_size)
    tlit(" iml=")
    tnum(f.iml_off)
    tlit(",")
    tnum(f.iml_len)
    temit()
    tlit("CAP api1=")
    tnum(f.api1)
    tlit(" scanver=")
    tnum(iwl_fwcaps.scan_ver_of(&f))
    var k: usize = 0
    while k < 6 {
        tlit(" c")
        tnum(probe_cmds[k])
        tlit("=")
        tver(iwl_fw.fw_cmd_ver(&f, probe_cmds[k]))
        k = k + 1
    }
    temit()
    var img: usize = 0
    while img < 2 {
        var i: usize = 0
        while i < iwl_fw.fw_sec_count(&f, img) {
            tlit("SEC ")
            tnum(img as u64)
            tlit(" ")
            tnum(i as u64)
            tlit(" kind=")
            tnum(iwl_fw.fw_sec_kind(&f, img, i))
            tlit(" off=")
            tnum(iwl_fw.fw_sec_off(&f, img, i))
            tlit(" len=")
            tnum(iwl_fw.fw_sec_len(&f, img, i))
            tlit(" addr=")
            tnum(iwl_fw.fw_sec_addr(&f, img, i))
            temit()
            i = i + 1
        }
        img = img + 1
    }
    return 0
}
