// tools/wlan/pin.fi -- host test for lib/wlan/iwl_pin.fi. stdin: 32 raw digest octets; prints "<api> <family> <hex>".
import std.rt
import std.io
import wlan.iwl_pin

static mut dig: [u8; 32] = [0; 32]
static mut hx: [u8; 65] = [0; 65]
static mut line: [u8; 120] = [0; 120]

fn num(v: u64, at: usize) -> usize {
    var n: usize = at
    var t: [u8; 6] = [0 as u8; 6]
    var k: usize = 0
    var x: u64 = v
    if x == 0 { t[0] = 48 as u8; k = 1 }
    while x > 0 { t[k] = (48 + x % 10) as u8; x = x / 10; k = k + 1 }
    while k > 0 { k = k - 1; line[n] = t[k]; n = n + 1 }
    return n
}

fn main() -> i32 {
    var inp: rt.Buf = rt.buf_new()
    rt.read_stdin(&inp)
    let all: u64 = rt.buf_ptr(&inp)
    let alen: usize = rt.buf_len(&inp)
    var n: usize = 0
    while n < 32 && n < alen {
        dig[n] = rt.ld8(all, n) as u8
        n = n + 1
    }
    iwl_pin.hex_digest((&dig[0]) as u64, (&hx[0]) as u64)
    var at: usize = num(iwl_pin.pin_api((&hx[0]) as u64), 0)
    line[at] = 32 as u8
    at = num(iwl_pin.pin_family((&hx[0]) as u64), at + 1)
    line[at] = 32 as u8
    at = at + 1
    var i: usize = 0
    while i < 64 {
        line[at + i] = hx[i]
        i = i + 1
    }
    io.print_line_bytes((&line[0]) as u64, at + 64)
    return 0
}
