import std.rt
import std.io
import wlan.iwl_nvmmac

static mut sec: [u8; 16] = [0; 16]
static mut out: [u8; 6] = [0; 6]
static mut line: [u8; 64] = [0; 64]

fn hexd(v: u64) -> u8 {
    if v < 10 { return (48 + v) as u8 }
    return (87 + v) as u8
}

fn run(len: u64, b2: u64, b3: u64, b4: u64, b5: u64, b6: u64, b7: u64) {
    var i: usize = 0
    while i < 16 { sec[i] = 0 as u8
        i = i + 1 }
    sec[2] = b2 as u8
    sec[3] = b3 as u8
    sec[4] = b4 as u8
    sec[5] = b5 as u8
    sec[6] = b6 as u8
    sec[7] = b7 as u8
    i = 0
    while i < 6 { out[i] = 0 as u8
        i = i + 1 }
    var at: usize = 0
    if iwl_nvmmac.mao_mac((&sec[0]) as u64, len, (&out[0]) as u64) {
        line[0] = 49 as u8
    } else {
        line[0] = 48 as u8
    }
    at = 1
    i = 0
    while i < 6 {
        let v: u64 = out[i] as u64
        line[at] = hexd(v >> 4)
        line[at + 1] = hexd(v & 15)
        at = at + 2
        i = i + 1
    }
    io.print_line_bytes((&line[0]) as u64, at)
}

fn main() -> i32 {
    run(8, 0x06, 0x11, 0x22, 0x33, 0x44, 0x55)
    run(8, 0x02, 0xCC, 0xAA, 0xFF, 0xEE, 0x00)
    run(8, 0x01, 0x11, 0x22, 0x33, 0x44, 0x55)
    run(8, 0, 0, 0, 0, 0, 0)
    run(7, 0x06, 0x11, 0x22, 0x33, 0x44, 0x55)
    run(8, 0x02, 0xCC, 0xAA, 0xFF, 0xEE, 0x01)
    return 0
}
