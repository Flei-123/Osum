#!/bin/bash
. /usr/local/lib/stick/common.sh
tag=${1:-main}
SSH_OPTS=(-i /root/.ssh/upload_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout="$UPLOAD_TIMEOUT"
          -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/root/.ssh/known_hosts_server -o HostKeyAlias=jarvis-server
          -p "$UPLOAD_PORT")
ARCHIVE=$STICK_RUN/upload-$tag.tar.gz
tar -czf "$ARCHIVE" -C "$STICK_RUN" out 2> /dev/null
say "upload[$tag]: archive $(du -h "$ARCHIVE" | cut -f1)"
if [ -d /mnt/data/results ]; then
    cp "$ARCHIVE" "/mnt/data/results/upload-$tag.tar.gz" 2> /dev/null && sync
fi
for h in $UPLOAD_HOSTS; do
    say "upload[$tag]: trying $h:$UPLOAD_PORT"
    if res=$(ssh "${SSH_OPTS[@]}" "$UPLOAD_USER@$h" "$tag" < "$ARCHIVE" 2>&1); then
        say "upload[$tag]: OK via $h: $res"
        exit 0
    fi
    say "upload[$tag]: failed via $h: $(echo "$res" | tail -1)"
done
say "upload[$tag]: FAILED (results stay on the stick in /results and in /run/stick/out)"
exit 1
