#!/bin/bash
. /usr/local/lib/stick/common.sh
: > "$STICK_RUN/net-up"
end=$((SECONDS + NET_WAIT))
while [ $SECONDS -lt $end ]; do
    for d in /sys/class/net/*; do
        n=${d##*/}
        case $n in lo|wlan*|docker*|veth*|virbr*) continue ;; esac
        [ -e "$STICK_RUN/dhcp.$n" ] && continue
        : > "$STICK_RUN/dhcp.$n"
        ip link set "$n" up
        busybox udhcpc -b -i "$n" -s /usr/local/lib/stick/udhcpc.script -t 8 -T 3 > /dev/null 2>&1
        say "dhcp started on $n ($(cat "$d/address" 2>/dev/null))"
    done
    [ -s "$STICK_RUN/net-up" ] && break
    sleep 2
    coldplug
done
if [ -s "$STICK_RUN/net-up" ]; then
    say "network up: $(tr '\n' ' ' < "$STICK_RUN/net-up")"
else
    say "network: no lease (no ethernet / usb-ethernet / tethering found)"
fi
exit 0
