#!/bin/bash
. /usr/local/lib/stick/common.sh
hostname hp-linux-trace
ip link set lo up
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
mount -t tracefs tracefs "$TRACEFS" 2>/dev/null
mkdir -p /run/sshd /root/.ssh
chmod 700 /root/.ssh
ssh-keygen -A > /dev/null 2>&1
/usr/sbin/sshd
setsid /usr/local/sbin/stick-run > /dev/null 2>&1 < /dev/null &
exit 0
