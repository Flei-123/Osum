#!/bin/bash
. /usr/local/lib/stick/common.sh
mkdir -p "$STICK_RUN"
say "=== HP Linux trace stick: started, kernel $(uname -r) ==="
say "do not unplug the stick; this takes about 3-8 minutes"

coldplug
/usr/local/sbin/stick-net &

for i in $(seq 1 20); do
    DEV=$(blkid -L "$DATA_LABEL" 2> /dev/null) && break
    sleep 1
done
if [ -n "${DEV:-}" ] && mount -t vfat -o rw,noatime "$DEV" /mnt/data 2> /dev/null; then
    mkdir -p /mnt/data/results
    say "data partition $DEV mounted (results are kept in /results on the stick)"
else
    say "data partition not found (no local copy, no OrientOS image for the vfio part)"
fi

/usr/local/sbin/stick-iommu
say "iommu: $(cat "$STICK_RUN/vfio_verdict")"

/usr/local/sbin/stick-trace
/usr/local/sbin/stick-collect part1
wait
/usr/local/sbin/stick-upload part1
upload1=$?

/usr/local/sbin/stick-vfio
if [ -f "$OUT/vfio/orientos-serial.log" ]; then
    /usr/local/sbin/stick-collect part2
    /usr/local/sbin/stick-upload part2
    upload2=$?
fi

[ -d /mnt/data/results ] && { cp -r "$OUT" /mnt/data/results/out 2> /dev/null; sync; }
say "=== DONE: upload part1 rc=$upload1 part2 rc=${upload2:-skipped} ==="
say "ssh in with the JARVIS key (ip: $(cat "$STICK_RUN/net-up" 2> /dev/null | tr '\n' ' ')) or power off the stick when ready"
touch "$STICK_RUN/done"
exit 0
