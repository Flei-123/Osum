#!/bin/bash
. /usr/local/lib/stick/common.sh
tag=${1:-main}
D=$OUT/sys-$tag
mkdir -p "$D"
dmesg > "$D/dmesg.txt" 2>&1
uname -a > "$D/uname.txt"
cat /proc/cmdline > "$D/cmdline.txt"
lsmod > "$D/lsmod.txt" 2>&1
iw dev > "$D/iw-dev.txt" 2>&1
iw list > "$D/iw-list.txt" 2>&1
rfkill list > "$D/rfkill.txt" 2>&1
ip addr > "$D/ip-addr.txt" 2>&1
lspci -vvnn > "$D/lspci-vvnn.txt" 2>&1
lspci -tvnn > "$D/lspci-tree.txt" 2>&1
lsusb -t > "$D/lsusb-tree.txt" 2>&1
dmidecode > "$D/dmidecode.txt" 2>&1
cp /proc/iomem /proc/ioports /proc/interrupts /proc/cpuinfo "$D/" 2>/dev/null
if find_target; then
    lspci -s "$TARGET_BDF" -xxxx > "$D/lspci-target-config.txt" 2>&1
    for b in $(readlink -f "/sys/bus/pci/devices/$TARGET_BDF" | tr '/' '\n' | grep -E '^[0-9a-f]{4}:'); do
        lspci -s "$b" -vvnn >> "$D/lspci-chain.txt" 2>&1
    done
    cp "/sys/bus/pci/devices/$TARGET_BDF/resource" "$D/target-resource.txt" 2>/dev/null
fi
mkdir -p "$D/acpi"
cp /sys/firmware/acpi/tables/* "$D/acpi/" 2>/dev/null
mkdir -p "$D/dmi"
for f in /sys/class/dmi/id/*; do
    [ -f "$f" ] && cat "$f" > "$D/dmi/${f##*/}" 2>/dev/null
done
if [ -d /sys/kernel/debug/iwlwifi ]; then
    find /sys/kernel/debug/iwlwifi -type f -size -64k 2>/dev/null | while read -r f; do
        dest="$D/debugfs/${f#/sys/kernel/debug/iwlwifi/}"
        mkdir -p "$(dirname "$dest")"
        timeout 2 head -c 8192 "$f" > "$dest" 2>/dev/null
    done
fi
exit 0
