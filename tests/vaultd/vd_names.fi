import std.rt
import std.testkit
import vaultd.vdnames

fn feed(text: str, uid: u64, out: *mut rt.Buf) -> bool {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, text.p as u64, text.n)
    let ok: bool = vdnames.lookup_in(&t, uid, out)
    rt.buf_free(&t)
    return ok
}

#[test]
fn resolves_names() {
    let db: str = "root:x:0:0:root:/root:/bin/sh\njustin:x:1000:1000::/home/justin:/bin/sh\n"
    var a: rt.Buf = rt.buf_new()
    testkit.assert_true(feed(db, 1000, &a) && rt.buf_str(&a) == "justin", "uid 1000")
    var b: rt.Buf = rt.buf_new()
    testkit.assert_true(feed(db, 0, &b) && rt.buf_str(&b) == "root", "uid 0")
    var c: rt.Buf = rt.buf_new()
    testkit.assert_true(!feed(db, 7, &c) && rt.buf_len(&c) == 0, "unknown uid")
}

#[test]
fn rejects_unsafe_names() {
    var a: rt.Buf = rt.buf_new()
    testkit.assert_true(!feed("..:x:5:5::/:/bin/sh\n", 5, &a), "dots")
    testkit.assert_true(!feed("a/b:x:6:6::/:/bin/sh\n", 6, &a), "slash")
    testkit.assert_true(!feed(":x:8:8::/:/bin/sh\n", 8, &a), "empty")
    testkit.assert_true(!feed("-x:x:9:9::/:/bin/sh\n", 9, &a), "leading dash")
    testkit.assert_true(!feed("1x:x:10:10::/:/bin/sh\n", 10, &a), "leading digit")
    testkit.assert_true(!feed("bad:x:xx:1::/:/bin/sh\n", 1, &a), "bad uid field")
    testkit.assert_true(rt.buf_len(&a) == 0, "nothing written")
}
