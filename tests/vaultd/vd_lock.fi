import std.rt
import std.testkit
import vaultd.vdlock

#[test]
fn penalty_curve() {
    testkit.assert_eq_u64(vdlock.penalty(1), 0)
    testkit.assert_eq_u64(vdlock.penalty(2), 0)
    testkit.assert_eq_u64(vdlock.penalty(3), 2)
    testkit.assert_eq_u64(vdlock.penalty(4), 4)
    testkit.assert_eq_u64(vdlock.penalty(8), 64)
    testkit.assert_eq_u64(vdlock.penalty(12), 900)
    testkit.assert_eq_u64(vdlock.penalty(200), 900)
}

#[test]
fn gate_and_clock_back() {
    var st: [u8; 64] = [0; 64]
    let p: u64 = (&st[0]) as u64
    vdlock.state_new(p)
    testkit.assert_true(vdlock.state_valid(p, 64), "valid")
    testkit.assert_true(!vdlock.state_valid(p, 63), "short")
    var w: u64 = 7
    testkit.assert_eq_u64(vdlock.gate(p, 1000, &w), vdlock.G_OK)
    vdlock.mark_try(p, 1000)
    vdlock.mark_try(p, 1000)
    testkit.assert_eq_u64(vdlock.gate(p, 1000, &w), vdlock.G_OK)
    vdlock.mark_try(p, 1000)
    testkit.assert_eq_u64(vdlock.get_fails(p), 3)
    testkit.assert_eq_u64(vdlock.gate(p, 1000, &w), vdlock.G_WAIT)
    testkit.assert_eq_u64(w, 2)
    testkit.assert_eq_u64(vdlock.gate(p, 1001, &w), vdlock.G_WAIT)
    testkit.assert_eq_u64(w, 1)
    testkit.assert_eq_u64(vdlock.gate(p, 500, &w), vdlock.G_WAIT)
    testkit.assert_eq_u64(w, 2)
    testkit.assert_eq_u64(vdlock.gate(p, 1002, &w), vdlock.G_OK)
    vdlock.mark_success(p, 1002)
    testkit.assert_eq_u64(vdlock.get_fails(p), 0)
    testkit.assert_eq_u64(vdlock.get_until(p), 0)
    testkit.assert_eq_u64(vdlock.get_seen(p), 1002)
}

#[test]
fn vault_id_and_revision() {
    var st: [u8; 64] = [0; 64]
    let p: u64 = (&st[0]) as u64
    vdlock.state_new(p)
    testkit.assert_true(!vdlock.has_vid(p), "no id yet")
    var id: [u8; 16] = [7; 16]
    var other: [u8; 16] = [8; 16]
    vdlock.set_vid(p, (&id[0]) as u64)
    vdlock.set_rev(p, 41)
    testkit.assert_true(vdlock.has_vid(p), "has id")
    testkit.assert_true(vdlock.vid_matches(p, (&id[0]) as u64), "same id")
    testkit.assert_true(!vdlock.vid_matches(p, (&other[0]) as u64), "other id")
    testkit.assert_eq_u64(vdlock.get_rev(p), 41)
}
