import std.rt
import vault.vlayout
import vault.container

export { KIB, PASSES, LANES, sp, make, make_with_recovery, rec_key, flip,
    open_ok, copy_img }

const KIB: usize = 64
const PASSES: usize = 1
const LANES: usize = 1

fn sp(s: str) -> u64 {
    return s.p as u64
}

fn make(img: *mut rt.Buf, body: str, pw: str) -> i32 {
    return container.create(img, sp(body), body.n, sp(pw), pw.n, KIB, PASSES,
        LANES, 0 as u8, 0)
}

fn rec_key(out: u64, seed: u8) {
    var i: usize = 0
    while i < 32 {
        rt.st8(out, i, (seed as usize + i) as u8)
        i = i + 1
    }
}

fn make_with_recovery(img: *mut rt.Buf, body: str, pw: str, key: u64) -> i32 {
    var vk: [u8; 32] = [0; 32]
    var rc: i32 = container.create(img, sp(body), body.n, sp(pw), pw.n, KIB,
        PASSES, LANES, 0 as u8, (&vk[0]) as u64)
    if rc == 0 {
        rc = container.slot_add_key(img, (&vk[0]) as u64, vlayout.SLOT_RECOVERY, key)
    }
    vlayout.wipe((&vk[0]) as u64, 32)
    return rc
}

fn flip(img: *mut rt.Buf, i: usize, mask: u8) {
    let p: u64 = rt.buf_ptr(img)
    rt.st8(p, i, rt.ld8(p, i) ^ mask)
}

fn copy_img(src: *mut rt.Buf, dst: *mut rt.Buf) {
    rt.buf_clear(dst)
    rt.buf_push_bytes(dst, rt.buf_ptr(src), rt.buf_len(src))
}

fn open_ok(img: *mut rt.Buf, pw: str, want: str) -> bool {
    var out: rt.Buf = rt.buf_new()
    let rc: i32 = container.open_pw(rt.buf_ptr(img), rt.buf_len(img),
        vlayout.SLOT_PW, sp(pw), pw.n, &out, 0)
    let same: bool = rc == 0 && rt.buf_len(&out) == want.n
        && rt.mem_eq(rt.buf_ptr(&out), sp(want), want.n)
    rt.buf_free(&out)
    return same
}
