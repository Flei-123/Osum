import std.rt
import std.testkit
import std.cbor
import std.cborread
import std.cborcanon
import cbor_helper

const VECTORS: usize = 88

fn vec(i: usize) -> str {
    var t: [str; 88] = [
    "0:00", "0:01", "0:0a", "0:17", "0:1818", "0:1819", "0:1864", "0:1903e8",
    "0:1a000f4240", "0:1b000000e8d4a51000", "0:1bffffffffffffffff",
    "0:c249010000000000000000", "0:3bffffffffffffffff",
    "0:c349010000000000000000", "0:20", "0:29", "0:3863", "0:3903e7",
    "0:f90000", "0:f98000", "0:f93c00", "0:fb3ff199999999999a", "0:f93e00",
    "0:f97bff", "0:fa47c35000", "0:fa7f7fffff", "0:fb7e37e43c8800759c",
    "0:f90001", "0:f90400", "0:f9c400", "0:fbc010666666666666", "0:f97c00",
    "0:f97e00", "0:f9fc00", "0:fa7f800000", "0:fa7fc00000", "0:faff800000",
    "0:fb7ff0000000000000", "0:fb7ff8000000000000", "0:fbfff0000000000000",
    "0:f4", "0:f5", "0:f6", "0:f7", "8:f0", "8:f8ff",
    "0:c074323031332d30332d32315432303a30343a30305a", "0:c11a514b67b0",
    "0:c1fb41d452d9ec200000", "0:d74401020304", "0:d818456449455446",
    "0:d82076687474703a2f2f7777772e6578616d706c652e636f6d",
    "0:40", "0:4401020304", "0:60", "0:6161", "0:6449455446", "0:62225c",
    "0:62c3bc", "0:63e6b0b4", "0:64f0908591", "0:80", "0:83010203",
    "0:8301820203820405",
    "0:98190102030405060708090a0b0c0d0e0f101112131415161718181819",
    "0:a0", "0:a201020304", "0:a26161016162820203", "0:826161a161626163",
    "0:a56161614161626142616361436164614461656145",
    "5:5f42010243030405ff", "5:7f657374726561646d696e67ff", "5:9fff",
    "5:9f018202039f0405ffff", "5:9f01820203820405ff", "5:83018202039f0405ff",
    "5:83019f0203ff820405",
    "5:9f0102030405060708090a0b0c0d0e0f101112131415161718181819ff",
    "5:bf61610161629f0203ffff", "5:826161bf61626163ff",
    "5:bf6346756ef563416d7421ff",
    "4:1800", "4:1900ff", "4:5800", "1:5b", "9:0000", "1:", "8:1c"]
    return t[i]
}

fn load(i: usize, b: *mut rt.Buf) -> i32 {
    let s: str = vec(i)
    let code: i32 = cbor_helper.nibble(rt.ld8(s.p as u64, 0))
    let h: str = str { p: ((s.p as u64) + 2) as *mut u8, n: s.n - 2 }
    cbor_helper.hex_to_buf(h, b)
    return code
}

#[test]
fn appendix_a_verdicts() {
    var i: usize = 0
    while i < VECTORS {
        var b: rt.Buf = rt.buf_new()
        let want: i32 = load(i, &b)
        testkit.context(vec(i))
        let got: i32 = cborread.validate(rt.buf_ptr(&b), rt.buf_len(&b),
            cborread.CB_FLOAT | cborread.CB_TAG)
        testkit.assert_eq_i64(got as i64, want as i64)
        rt.buf_free(&b)
        i = i + 1
    }
}

#[test]
fn appendix_a_transcode_is_identity() {
    var i: usize = 0
    while i < VECTORS {
        var b: rt.Buf = rt.buf_new()
        let want: i32 = load(i, &b)
        if want == 0 {
            testkit.context(vec(i))
            var out: rt.Buf = rt.buf_new()
            var e: usize = 0
            let rc: i32 = cbor_helper.transcode(rt.buf_ptr(&b), rt.buf_len(&b), 0,
                cborread.CB_FLOAT | cborread.CB_TAG, &out, &e)
            testkit.assert_eq_i64(rc as i64, 0)
            testkit.assert_eq_i64(e as i64, rt.buf_len(&b) as i64)
            testkit.assert_true(rt.buf_len(&out) == rt.buf_len(&b)
                && rt.mem_eq(rt.buf_ptr(&out), rt.buf_ptr(&b), rt.buf_len(&b)), "differs")
            rt.buf_free(&out)
        }
        rt.buf_free(&b)
        i = i + 1
    }
}

#[test]
fn appendix_a_canonicalize_is_identity() {
    var i: usize = 0
    while i < VECTORS {
        var b: rt.Buf = rt.buf_new()
        let want: i32 = load(i, &b)
        if want == 0 {
            testkit.context(vec(i))
            var out: rt.Buf = rt.buf_new()
            let rc: i32 = cborcanon.canonicalize(rt.buf_ptr(&b), rt.buf_len(&b),
                cborread.CB_FLOAT | cborread.CB_TAG, 8, 65536, &out)
            testkit.assert_eq_i64(rc as i64, 0)
            testkit.assert_true(rt.buf_len(&out) == rt.buf_len(&b)
                && rt.mem_eq(rt.buf_ptr(&out), rt.buf_ptr(&b), rt.buf_len(&b)), "differs")
            rt.buf_free(&out)
        }
        rt.buf_free(&b)
        i = i + 1
    }
}

#[test]
fn floats_and_tags_rejected_by_default() {
    var b: rt.Buf = rt.buf_new()
    cbor_helper.hex_to_buf("f93c00", &b)
    testkit.assert_eq_i64(cborread.validate(rt.buf_ptr(&b), rt.buf_len(&b), 0) as i64,
        cborread.CB_E_TYPE as i64)
    rt.buf_clear(&b)
    cbor_helper.hex_to_buf("c11a514b67b0", &b)
    testkit.assert_eq_i64(cborread.validate(rt.buf_ptr(&b), rt.buf_len(&b), 0) as i64,
        cborread.CB_E_TYPE as i64)
    rt.buf_free(&b)
}

#[test]
fn proper_prefixes_never_validate() {
    var i: usize = 0
    while i < VECTORS {
        var b: rt.Buf = rt.buf_new()
        let want: i32 = load(i, &b)
        if want == 0 {
            testkit.context(vec(i))
            var k: usize = 0
            while k < rt.buf_len(&b) {
                let rc: i32 = cborread.validate(rt.buf_ptr(&b), k,
                    cborread.CB_FLOAT | cborread.CB_TAG)
                testkit.assert_true(rc != 0, "prefix validated")
                k = k + 1
            }
        }
        rt.buf_free(&b)
        i = i + 1
    }
}

#[test]
fn encoder_matches_appendix_a_integers() {
    var b: rt.Buf = rt.buf_new()
    cbor.put_int(&b, 0)
    cbor.put_int(&b, 24)
    cbor.put_int(&b, 1000)
    cbor.put_int(&b, 1000000)
    cbor.put_int(&b, 1000000000000)
    cbor.put_uint(&b, 18446744073709551615)
    cbor.put_int(&b, -1)
    cbor.put_int(&b, -100)
    cbor.put_int(&b, -1000)
    cbor.put_int(&b, -9223372036854775807 - 1)
    testkit.assert_true(cbor_helper.buf_hex_eq(&b,
        "00" + "1818" + "1903e8" + "1a000f4240" + "1b000000e8d4a51000"
        + "1bffffffffffffffff" + "20" + "3863" + "3903e7" + "3b7fffffffffffffff"), "ints")
    rt.buf_free(&b)
}

#[test]
fn encoder_matches_appendix_a_containers() {
    var b: rt.Buf = rt.buf_new()
    cbor.put_map(&b, 2)
    cbor.put_text(&b, "a")
    cbor.put_uint(&b, 1)
    cbor.put_text(&b, "b")
    cbor.put_array(&b, 2)
    cbor.put_uint(&b, 2)
    cbor.put_uint(&b, 3)
    cbor.put_array(&b, 2)
    var raw: [u8; 4] = [1, 2, 3, 4]
    cbor.put_bytes(&b, (&raw[0]) as u64, 4)
    cbor.put_text(&b, "IETF")
    cbor.put_bool(&b, false)
    cbor.put_null(&b)
    cbor.put_undefined(&b)
    cbor.put_tag(&b, 24)
    cbor.put_array(&b, 0)
    cbor.put_map(&b, 0)
    testkit.assert_true(cbor_helper.buf_hex_eq(&b,
        "a26161016162820203" + "82" + "4401020304" + "6449455446" + "f4f6f7"
        + "d818" + "80" + "a0"), "containers")
    rt.buf_free(&b)
}

#[test]
fn head_length_boundaries() {
    testkit.assert_eq_i64(cbor.head_len(23) as i64, 1)
    testkit.assert_eq_i64(cbor.head_len(24) as i64, 2)
    testkit.assert_eq_i64(cbor.head_len(255) as i64, 2)
    testkit.assert_eq_i64(cbor.head_len(256) as i64, 3)
    testkit.assert_eq_i64(cbor.head_len(65535) as i64, 3)
    testkit.assert_eq_i64(cbor.head_len(65536) as i64, 5)
    testkit.assert_eq_i64(cbor.head_len(4294967295) as i64, 5)
    testkit.assert_eq_i64(cbor.head_len(4294967296) as i64, 9)
}
