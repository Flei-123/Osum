import std.rt
import std.testkit
import std.cbor
import std.cborread
import std.cborcanon
import cbor_helper

const SEEDS: usize = 12

fn seed(i: usize) -> str {
    var t: [str; 12] = [
    "a56161614161626142616361436164614461656145",
    "98190102030405060708090a0b0c0d0e0f101112131415161718181819",
    "8301820203820405", "a26161016162820203",
    "a40158202bf3a50b1cbd8e6d35a1f3b5b3c6a5d1c3b4f8f1ee0d2f9f5a7b3c1d9e8f02f5036b6f6f6f6f",
    "a301020338180c2001",
    "826161a161626163", "1b000000e8d4a51000", "3bffffffffffffff00",
    "a3616102616301616200", "a2a20201010100a1010105", "a3646e616d65666a757374696e626964447465737461706b8201a0"]
    return t[i]
}

fn lcg(s: *mut u64) -> u64 {
    *s = ((*s) *% 6364136223846793005) +% 1442695040888963407
    return (*s) >> 33
}

fn same(a: *mut rt.Buf, b: *mut rt.Buf) -> bool {
    return rt.buf_len(a) == rt.buf_len(b)
        && rt.mem_eq(rt.buf_ptr(a), rt.buf_ptr(b), rt.buf_len(a))
}

fn mutate(b: *mut rt.Buf, s: *mut u64) {
    let n: usize = rt.buf_len(b)
    if n == 0 {
        return
    }
    let rounds: u64 = 1 + lcg(s) % 3
    var r: u64 = 0
    while r < rounds {
        let pos: usize = (lcg(s) % (n as u64)) as usize
        let kind: u64 = lcg(s) % 4
        if kind == 0 {
            rt.st8(rt.buf_ptr(b), pos, (lcg(s) & 255) as u8)
        }
        if kind == 1 {
            rt.st8(rt.buf_ptr(b), pos, rt.ld8(rt.buf_ptr(b), pos) ^ ((1 << (lcg(s) % 8)) as u8))
        }
        if kind == 2 {
            rt.st8(rt.buf_ptr(b), pos, (lcg(s) % 40) as u8)
        }
        if kind == 3 {
            rt.st8(rt.buf_ptr(b), pos, 255 as u8)
        }
        r = r + 1
    }
}

#[test]
fn accepted_inputs_are_canonical_and_roundtrip() {
    var s: u64 = 88172645463325252
    var accepted: usize = 0
    var rounds: usize = 0
    while rounds < 40000 {
        var b: rt.Buf = rt.buf_new()
        let si: usize = (lcg(&s) % (SEEDS as u64)) as usize
        cbor_helper.hex_to_buf(seed(si), &b)
        mutate(&b, &s)
        let cut: u64 = lcg(&s) % 5
        if cut == 0 && rt.buf_len(&b) > 1 {
            rt.buf_set_len(&b, rt.buf_len(&b) - 1)
        }
        if cut == 1 {
            rt.buf_push(&b, (lcg(&s) & 255) as u8)
        }
        let p: u64 = rt.buf_ptr(&b)
        let n: usize = rt.buf_len(&b)
        let rc: i32 = cborread.validate(p, n, cborread.CB_TAG)
        if rc == 0 {
            accepted = accepted + 1
            var out: rt.Buf = rt.buf_new()
            var e: usize = 0
            testkit.assert_eq_i64(cbor_helper.transcode(p, n, 0, cborread.CB_TAG, &out, &e) as i64, 0)
            testkit.assert_true(same(&out, &b), "transcode differs")
            var out2: rt.Buf = rt.buf_new()
            testkit.assert_eq_i64(cborcanon.canonicalize(p, n, cborread.CB_TAG, 8, 65536, &out2) as i64, 0)
            testkit.assert_true(same(&out2, &b), "canonicalize changed a valid input")
            rt.buf_free(&out)
            rt.buf_free(&out2)
        }
        var lo: i32 = 0
        if rc == 0 {
            lo = cborread.validate(p, n, cborread.CB_TAG | cborread.CB_LENIENT)
            testkit.assert_eq_i64(lo as i64, 0)
        }
        rt.buf_free(&b)
        rounds = rounds + 1
    }
    testkit.assert_true(accepted > 200, "fuzzer never produced a valid mutation")
}

#[test]
fn lenient_inputs_canonicalize_to_strict_fixpoint() {
    var s: u64 = 1234567890123
    var done: usize = 0
    var rounds: usize = 0
    while rounds < 40000 {
        var b: rt.Buf = rt.buf_new()
        let si: usize = (lcg(&s) % (SEEDS as u64)) as usize
        cbor_helper.hex_to_buf(seed(si), &b)
        mutate(&b, &s)
        let p: u64 = rt.buf_ptr(&b)
        let n: usize = rt.buf_len(&b)
        var out: rt.Buf = rt.buf_new()
        let rc: i32 = cborcanon.canonicalize(p, n, cborread.CB_TAG, 8, 65536, &out)
        if rc == 0 {
            done = done + 1
            testkit.assert_eq_i64(cborread.validate(rt.buf_ptr(&out), rt.buf_len(&out),
                cborread.CB_TAG) as i64, 0)
            var again: rt.Buf = rt.buf_new()
            testkit.assert_eq_i64(cborcanon.canonicalize(rt.buf_ptr(&out), rt.buf_len(&out),
                cborread.CB_TAG, 8, 65536, &again) as i64, 0)
            testkit.assert_true(same(&again, &out), "not idempotent")
            testkit.assert_eq_i64(rt.buf_len(&out) as i64, n as i64)
            rt.buf_free(&again)
        } else {
            testkit.assert_eq_i64(rt.buf_len(&out) as i64, 0)
        }
        rt.buf_free(&out)
        rt.buf_free(&b)
        rounds = rounds + 1
    }
    testkit.assert_true(done > 200, "fuzzer never produced a valid lenient mutation")
}

#[test]
fn random_garbage_never_crashes() {
    var s: u64 = 42
    var rounds: usize = 0
    while rounds < 30000 {
        var b: rt.Buf = rt.buf_new()
        let n: u64 = lcg(&s) % 64
        var i: u64 = 0
        while i < n {
            rt.buf_push(&b, (lcg(&s) & 255) as u8)
            i = i + 1
        }
        let flags: u64 = lcg(&s) % 8
        let rc: i32 = cborread.validate(rt.buf_ptr(&b), rt.buf_len(&b), flags)
        var it: cborread.Item = cborread.item_zero()
        let r2: i32 = cborread.map_find_int(rt.buf_ptr(&b), rt.buf_len(&b), 0, 1, &it)
        testkit.assert_true(rc >= 0 && r2 >= 0, "negative code")
        rt.buf_free(&b)
        rounds = rounds + 1
    }
}

#[test]
fn hostile_counts_do_not_allocate_or_hang() {
    var b: rt.Buf = rt.buf_new()
    cbor_helper.hex_to_buf("bb00ffffffffffffffa1", &b)
    testkit.assert_eq_i64(cborread.validate(rt.buf_ptr(&b), rt.buf_len(&b),
        cborread.CB_LENIENT) as i64, cborread.CB_E_TRUNC as i64)
    rt.buf_clear(&b)
    cbor_helper.hex_to_buf("9affffffff", &b)
    testkit.assert_eq_i64(cborread.validate(rt.buf_ptr(&b), rt.buf_len(&b), 0) as i64,
        cborread.CB_E_TRUNC as i64)
    var i: usize = 0
    rt.buf_clear(&b)
    cbor.put_map(&b, 1024)
    while i < 1024 {
        cbor.put_uint(&b, (1024 - i) as u64)
        cbor.put_null(&b)
        i = i + 1
    }
    testkit.assert_eq_i64(cborread.validate(rt.buf_ptr(&b), rt.buf_len(&b),
        cborread.CB_LENIENT) as i64, 0)
    rt.buf_free(&b)
}
