# /etc/inittab -- Beispiel MIT Wayland-Dienst.
#
# RUNDE WAYLAND, Vorgabe von Justin (14.09.2026): der Wayland-Server ist
# ein EIGENER, ABSCHALTBARER DIENST -- kein fest verdrahteter Teil des
# Systems. Diese Datei zeigt, wie er eingehaengt wird.
#
# DIE ZEILE STEHT AUF `off`, UND DAS IST DIE ENTSCHEIDUNG DIESER RUNDE:
#
#   wayd:grafik:off:/bin/wayd /tmp/wayland-0
#
# `off` heisst: die Zeile steht da, der Dienst laeuft NICHT. Ein
# `svc start wayd` startet ihn, ein `svc stop wayd` beendet ihn, und
# dazwischen aendert sich am uebrigen Schreibtisch nichts.
#
# WARUM AUS UND NICHT AN -- die Begruendung steht in
# docs/RUNDE-WAYLAND.md, Abschnitt 8, mit den gemessenen Zahlen:
# solange kein fremdes GUI-Programm installiert ist, bringt ein
# laufender Wayland-Server nur einen offenen Socket, auf dem jeder
# lokale Prozess Fenster anlegen kann, und Speicher, den niemand
# braucht. Wer ein solches Programm installiert, schaltet ihn mit EINEM
# Befehl an.
#
# `grafik` als Ziel: ohne Fensterserver hat ein Wayland-Server nichts,
# worauf er zeichnen koennte. Auf einem Server mit `/etc/ziel = konsole`
# startet die Zeile deshalb auch dann nicht, wenn jemand sie auf
# `respawn` stellt.

# name:ziele:art:befehl:optionen
login:konsole:respawn:/bin/login
leiste:grafik:respawn:/bin/taskbar
wayd:grafik:off:/bin/wayd /tmp/wayland-0
