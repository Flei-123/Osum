# /etc/wmplug.autostart -- WELCHE ERWEITERUNGEN BEIM ANMELDEN HOCHKOMMEN.
#
# Gelesen von /bin/desktop (kernel/user/desktop.fi, `autostart`), NICHT
# vom Kern: der Kern liest keine Dateien und macht keine Namenspolitik.
# Der Schreibtisch ruft fuer jede Zeile
#
#     /bin/wmplug enable <name> [weitere Woerter]
#
# auf. `wmplug enable` holt Rechte, Frist und Programm aus
# /etc/wmplug.conf, gewaehrt die Rechte (WM_PLUG_GRANT, nur root) und
# startet danach das Programm aus `prog=`. Die weiteren Woerter reicht es
# unverändert an das Plugin durch -- die Verwaltung deutet sie nicht.
#
# Eine Zeile je Erweiterung, alles hinter `#` ist Bemerkung:
#
#     uhr runden=30
#     regel demo
#
# DIESE DATEI IST IM AUSLIEFERUNGSZUSTAND LEER (nur Bemerkungen): ein
# Schreibtisch ohne Erweiterungen ist der Normalfall. Die Abnahmelaeufe
# unter tools/wmplug/ legen sich ihre eigene Fassung ins Abbild.
