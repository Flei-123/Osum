schema 1
# /etc/settings.schema -- EVERY system setting that is on the action bus
# (docs/ACTION-BUS.md section 6). One line per key:
#
#   setting <area>.<name> <type> <range> <risk> "<description>"
#     default <value>
#     store <file> <field>      (optional: kept in that key=value file)
#
# type/range: int min..max | bool - | enum a,b,c | string <max length>
# risk: harmless (a grant may allow it) | critical (ALWAYS asks the user:
# network, security, updates, privacy)
#
# Read by the broker (checks values and decides rights by the key, so a
# grant can be per area: `act grant jarvis settings.display.* write 3600`)
# and by /bin/settingsd (stores them). Wired to a real consumer today:
# lock.idle (/etc/sperre.conf, read by idlelock). The others are kept in
# /etc/settings.db until their programs read them from there (roadmap).

setting display.brightness int 0..100 harmless "Screen brightness in percent"
  default 80
setting display.scale enum 100,125,150,200 harmless "Size of the user interface in percent"
  default 100
setting display.night bool - harmless "Warmer colours in the evening"
  default false
setting display.transparency enum off,subtle,strong harmless "Transparency effects: off, subtle (clear, nearly opaque surfaces; default) or strong (frosted glass)"
  default subtle
  store /etc/theme.conf transparency
setting sound.volume int 0..100 harmless "Loudness of the system sounds in percent"
  default 60
setting sound.mute bool - harmless "All sound off"
  default false
setting lock.idle int 0..86400 harmless "Seconds without input until the screen locks; 0 = never"
  default 600
  store /etc/sperre.conf leerlauf
setting locale.language enum de,en harmless "Language of the user interface"
  default de
setting net.wifi.enabled bool - critical "Wi-Fi on or off"
  default true
setting net.dhcp bool - critical "Take the network address automatically (DHCP)"
  default true
setting net.proxy string 120 critical "Proxy for web access, host:port; empty = none"
  default
setting update.auto bool - critical "Download and stage system updates in the background (they take effect at the next restart)"
  default false
  store /etc/ota.conf auto
setting update.channel enum stable,test critical "Which updates this device receives: stable or test"
  default stable
  store /etc/ota.conf kanal
setting security.lock bool - critical "Ask for the password after the screen locks"
  default true
setting privacy.crashreports bool - critical "Send crash reports to fleitec"
  default false
setting power.lid.battery enum sleep,hibernate,nothing,shutdown harmless "What closing the lid does on battery"
  default sleep
  store /etc/power.conf lid_bat
setting power.lid.mains enum sleep,hibernate,nothing,shutdown harmless "What closing the lid does on mains"
  default sleep
  store /etc/power.conf lid_ac
setting power.screen.battery int 0..86400 harmless "Seconds without input until the screen goes dark on battery; 0 = never"
  default 300
  store /etc/power.conf screen_bat
setting power.screen.mains int 0..86400 harmless "Seconds without input until the screen goes dark on mains; 0 = never"
  default 600
  store /etc/power.conf screen_ac
setting power.standby.battery int 0..86400 harmless "Seconds without input until standby on battery; 0 = never"
  default 900
  store /etc/power.conf standby_bat
setting power.standby.mains int 0..86400 harmless "Seconds without input until standby on mains; 0 = never"
  default 0
  store /etc/power.conf standby_ac
setting power.profile.battery enum save,balanced,performance harmless "Power profile on battery"
  default save
  store /etc/power.conf profile_bat
setting power.profile.mains enum save,balanced,performance harmless "Power profile on mains"
  default balanced
  store /etc/power.conf profile_ac

# ROUND LAP1 (L-001): pointer. The kernel reads /etc/mouse.conf at start
# and again when the file changes (kernel/drv/hid/ptrcfg.fi).
setting mouse.speed int 10..400 harmless "Pointer speed in percent (100 = normal)"
  default 100
  store /etc/mouse.conf speed
setting mouse.accel int 0..5 harmless "Pointer acceleration: 0 = off, 5 = strongest"
  default 0
  store /etc/mouse.conf accel
setting mouse.natural bool - harmless "Natural scrolling: content follows the finger (wheel direction reversed)"
  default false
  store /etc/mouse.conf natural
setting mouse.gestures bool - harmless "Touchpad gestures (tap, two-finger scroll, 3-finger swipe, pinch)"
  default false
  store /etc/mouse.conf gestures
# W-TPSET2: touchpad. The kernel reads /etc/touchpad.conf at start and again when the file changes
# (kernel/drv/hid/tpcfg.fi, via ptrcfg). Only the gesture machine uses it (mouse.gestures must be on, which is
# the default in the image). Defaults = Windows 11.
setting touchpad.tap bool - harmless "Tap with one finger to click"
  default true
  store /etc/touchpad.conf tap
setting touchpad.tap2 bool - harmless "Tap with two fingers to right-click"
  default true
  store /etc/touchpad.conf tap2
setting touchpad.drag bool - harmless "Tap twice and drag to select or move"
  default true
  store /etc/touchpad.conf drag
setting touchpad.corner bool - harmless "Press the bottom right corner of the touchpad to right-click"
  default true
  store /etc/touchpad.conf corner
setting touchpad.natural bool - harmless "Touchpad scrolling direction: true = content follows the fingers, false = down motion scrolls down"
  default false
  store /etc/touchpad.conf natural
setting touchpad.scrollspeed int 10..500 harmless "Touchpad scroll speed in percent (100 = normal)"
  default 100
  store /etc/touchpad.conf scrollspeed
setting touchpad.momentum bool - harmless "Keep scrolling a moment after a flick"
  default true
  store /etc/touchpad.conf momentum
setting touchpad.scroll bool - harmless "Scroll with two fingers"
  default true
  store /etc/touchpad.conf scroll
setting touchpad.pinch bool - harmless "Pinch to zoom (Ctrl + wheel)"
  default true
  store /etc/touchpad.conf pinch
setting touchpad.swipe3 int 0..2 harmless "Three-finger swipe: 0 = nothing, 1 = switch apps and show desktop, 2 = switch desktops and show desktop"
  default 1
  store /etc/touchpad.conf swipe3
setting touchpad.swipe4 int 0..2 harmless "Four-finger swipe: 0 = nothing, 1 = switch apps and show desktop, 2 = switch desktops and show desktop"
  default 1
  store /etc/touchpad.conf swipe4
setting touchpad.typing bool - harmless "Ignore the touchpad for a moment while typing"
  default true
  store /etc/touchpad.conf typing
setting touchpad.enabled bool - harmless "Touchpad on (false = the touchpad does nothing)"
  default true
  store /etc/touchpad.conf enabled
setting debug.fps bool - harmless "FPS overlay (top right): frames per second, last/mean/max frame time of the last second, present clock; also Ctrl+Alt+F"
  default false
  store /etc/mouse.conf fps
setting debug.mon bool - harmless "Developer overlay (Ctrl+Shift+F): frame rate, frame time, CPU, memory and a sparkline in the taskbar area"
  default false
  store /etc/mouse.conf mon
