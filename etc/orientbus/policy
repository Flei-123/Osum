# /etc/orientbus/policy -- the rules of the action bus (docs/ACTION-BUS.md 5)
#
#   allow <client> <glob> <read|write>   a permanent grant (critical: never)
#   deny  <client> <glob>                refused, even reads (block)
#   adapter_uid <n>                      wrapped programs of root callers
#                                        run as this uid, never as root
#
# Clients are named by the KERNEL (AB-003): user, jarvis, app:<name>,
# compat:<name>; an unlabelled program may narrow itself (--as script).
# Timed grants: act grant <client> <glob> write <seconds>.
adapter_uid 65534
#
#   dryfirst <client>                    that client's changes need a dry
#                                        run of the same call first (AB-009)
#
# Jarvis plans in the open: every change it makes on this device was
# dry-run first -- the device enforces it, not the prompt.
dryfirst jarvis
