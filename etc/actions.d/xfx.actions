manifest 1
app xfx
title "Firefox launcher"

action xfx.start write "Start Firefox and its display server for the signed-in person; the service only does the privileged setup, the browser runs as that person"
  noask
  returns started int "1 = the start was accepted"

action xfx.result read "State of the last start: busy while it runs, rc when it is done"
  returns busy int "1 while a start runs"
  returns rc int "Exit code of the last start, 0 = running"

action xfx.stop write "Stop Firefox and its display server of the signed-in person"
  noask
