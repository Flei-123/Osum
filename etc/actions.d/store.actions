# The program store on the action bus (P-007, docs/STORE-OBERFLAECHE.md).
# Provider: /bin/stored (root). Who may install or remove is decided THERE from
# /etc/store.conf (installieren=, entfernen=, admins=); the broker's confirmation
# comes on top for every critical action.
manifest 1
app store
title "Programs (store)"

action store.list read "The catalog of the signed store: one item=name|version|size|state per program (state neu, aktuell or update), what the caller may do (can_install, can_remove), the phase and whether a job runs"
  returns count int "How many programs the catalog lists"
  returns phase string "ruhe, laedt, fertig or fehler"
  returns busy int "1 while a job runs"
  returns can_install int "1 if the caller may install and update programs"
  returns can_remove int "1 if the caller may remove programs"
  returns source string "The store the catalog comes from (the system update's source)"
  returns autoapps int "1 if installed programs are updated automatically (the global switch)"

action store.status read "State of the last job: phase (ruhe, laedt, fertig, fehler), verb, program, a short text, busy"
  returns phase string "ruhe = nothing yet, laedt = a job runs, fertig = done, fehler = it failed"
  returns verb string "refresh, install, update or remove"
  returns name string "The program the job was for"
  returns msg string "What happened, in a few words"
  returns busy int "1 while a job runs"
  returns pct int "Progress of the running job, 0..100 (stages: catalog, package, signature, install)"

action store.refresh write "Fetch the catalog (INDEX and its signature) from the configured source and check it against the trusted key; nothing is installed"
  dryrun

action store.install critical "Programm aus dem Store installieren (Signatur wird geprueft)"
  arg name string required "The program, as store.list names it"
  dryrun

action store.update critical "Installiertes Programm aktualisieren"
  arg name string required "The program, as store.list names it"
  dryrun

action store.remove critical "Programm entfernen"
  arg name string required "The program, as store.list names it"
  dryrun

action store.autoset write "Switch automatic program updates on or off: for one program (name) or, without a name, for all programs; a manual update stays possible; needs the right to install"
  arg value string required "on or off"
  arg name string optional "The program, as store.list names it; empty = the global switch"
  dryrun

action store.apps read "Catalog 2 (signed view of the apps of the store): cat=id|name per category and app=id|name|category|developer|level|kinds|version|package per app; level is works, partial, broken or untested; kinds are n (native), l (Linux), w (Windows)"
  arg lang string "de or en"
  returns apps int "How many apps are listed"

action store.app read "One app of catalog 2: name, developer, category, license, summary, description, permissions, screenshots, icon and one variant= line per platform with level, tested_on, tested_at, gate, notes and limitations"
  arg name string required "The app id as store.apps names it"
  arg lang string "de or en"
