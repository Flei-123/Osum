# The program store on the action bus (P-007, docs/STORE-OBERFLAECHE.md).
# Provider: /bin/stored (root). Who may install or remove is decided THERE from
# /etc/store.conf (installieren=, entfernen=, admins=); the broker's confirmation
# comes on top for every critical action.
manifest 1
app store
title "Programs (store)"

action store.list read "The catalog of the signed store: one item=name|version|size|state per program (state neu, aktuell or update), what the caller may do (can_install, can_remove), the phase and whether a job runs"
  returns count int "How many programs the catalog lists"
  returns phase string "ruhe, laedt, fertig or fehler"
  returns busy int "1 while a job runs"
  returns can_install int "1 if the caller may install and update programs"
  returns can_remove int "1 if the caller may remove programs"

action store.status read "State of the last job: phase (ruhe, laedt, fertig, fehler), verb, program, a short text, busy"
  returns phase string "ruhe = nothing yet, laedt = a job runs, fertig = done, fehler = it failed"
  returns verb string "refresh, install, update or remove"
  returns name string "The program the job was for"
  returns msg string "What happened, in a few words"
  returns busy int "1 while a job runs"

action store.refresh write "Fetch the catalog (INDEX and its signature) from the configured source and check it against the trusted key; nothing is installed"
  dryrun

action store.install critical "Download one program from the store, check the package signature and its hash against the signed catalog, install it as a new generation"
  arg name string required "The program, as store.list names it"
  dryrun

action store.update critical "The same for a program that is installed: the newer version from the catalog"
  arg name string required "The program, as store.list names it"
  dryrun

action store.remove critical "Take one installed program out (a new generation without it)"
  arg name string required "The program, as store.list names it"
  dryrun
