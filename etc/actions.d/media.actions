manifest 1
app media
title "Media sessions"

action media.publish write "Announce or update the media session of the caller: what plays, by whom, and its state. The session belongs to the caller (the kernel-stamped origin); nobody else can change or end it"
  noask
  arg title string required "The title that plays, at most 95 octets"
  arg state string required "playing, paused or stopped"
  arg artist string "The artist, at most 63 octets"
  arg cover string "Absolute path of a small picture file, at most 65536 octets"
  arg app string "Display name; only honoured for the person's own programs without an app label"
  arg can_prev int "1 if the player can go back, 0 if not"
  arg can_next int "1 if the player can skip ahead, 0 if not"
  returns owner string "The origin the session belongs to"

action media.end write "End the media session of the caller"
  noask
  arg app string "Display name key, only for the person's own programs without an app label"

action media.current read "The session the person sees: the newest playing one, else the newest"
  returns count int "How many sessions exist"
  returns owner string "Origin that owns the shown session"
  returns app string "Name of the player"
  returns title string "Title"
  returns artist string "Artist"
  returns cover string "Cover file path or empty"
  returns state string "playing, paused or stopped"
  returns can_prev int "1 if previous works"
  returns can_next int "1 if next works"

action media.control write "Send play, pause, toggle, next, prev or stop to the player that owns a session"
  arg cmd string required "play, pause, toggle, next, prev or stop"
  arg owner string "Origin of the session; default is the shown one"

action media.poll read "A player asks for the command waiting for its own session (empty cmd = none)"
  arg app string "Display name key, only for the person's own programs without an app label"
  returns cmd string "The command, or empty"

action media.stat read "Counters of the media service"
  returns published int "Sessions published since start"
  returns refused int "Calls refused"
  returns commands int "Commands queued"
