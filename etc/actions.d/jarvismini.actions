# JARVIS Mini on the action bus (W-S3 test target, docs/HOTKEYS.md). Provider: /bin/jarvismini serve.
# The global hotkey helper (hotkeyd) calls jarvismini.toggle when the person presses the key from /etc/hotkeys.conf.
manifest 1
app jarvismini
title "JARVIS Mini"

action jarvismini.toggle write "Show or hide the JARVIS Mini box (flips a state)"
  returns state int "1 = shown, 0 = hidden"

action jarvismini.shot write "Take a screenshot into the Pictures folder"
  returns shot int "1 = started"
