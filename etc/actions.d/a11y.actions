manifest 1
# The accessibility tree on the action bus (AB-021, docs/A11Y.md 5).
# Provider: /bin/axd. The tree is EVERYTHING on the screen -- every label,
# list row and field text of every window -- so reading it is declared at
# the WRITE level: the user reads freely, any other client (an app, Jarvis,
# a script) needs a grant (`allow jarvis a11y.tree write`) or is asked.
# Password fields never carry their content or its length (two locks,
# wlib and kernel). `a11y.status` is numbers only and stays a read.
# No action says `dryrun`: the BROKER answers a dry run (decision, level)
# and nothing reaches axd -- a dry run of a11y.tree must not be a way to
# read the screen without the decision.
app a11y
title "Accessibility tree"

action a11y.tree write "Every control on the screen: role, place, state, name and the bus action it stands for (screen content, so it needs a grant)"
  arg window string optional "Only windows whose title contains this"
  arg from int optional "Start at this node (the reply says more_from= when it did not fit)"
  returns count int "How many nodes are listed"
  returns gen int "The tree generation this listing is of"
  returns node.N string "One node: role, window, place, size, state, name, act=, value="

action a11y.find write "The controls of one role and/or whose name contains a text"
  arg role string optional "button, check, entry, password, label, list, table, tab, choice, slider, window ..."
  arg name string optional "A part of the name"
  arg window string optional "Only windows whose title contains this"
  returns count int "How many matched"
  returns node.N string "One node, as in a11y.tree"

action a11y.press write "Press a button or tick a check box of an app, found by its exact name or its bus action"
  arg name string optional "The exact name of the control"
  arg action string optional "The bus action the control stands for, e.g. notes.save"
  arg window string optional "Only in windows whose title contains this"
  returns control string "The control that was pressed"
  returns window string "Its window"

action a11y.status read "Numbers about the tree, no content: nodes, reads, refused reads, password nodes, leaks (must be 0), presses"
  returns nodes int "Nodes in the tree"
  returns leaks int "Password nodes that arrived with a value (must be 0)"
