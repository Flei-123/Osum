manifest 1
# The system settings on the action bus (AB-005, docs/ACTION-BUS.md 6).
# Provider: /bin/settingsd. Keys, types, ranges and risks are in
# /etc/settings.schema; `keyed` makes the broker check the value and decide
# the rights by settings.<key> -- critical keys always ask the user.
app settings
title "System settings"

action settings.list read "All settings of an area (or all): value, type, range, risk and description"
  arg area string optional "Area such as display, sound, net, update; empty = all"
  returns count int "How many settings were listed"

action settings.get read "Read one setting"
  keyed
  arg key string required "The setting, for example display.brightness"
  returns value string "Its current value"

action settings.set write "Change one setting; network, security, update and privacy settings always need the user's yes"
  keyed
  arg key string required "The setting, for example display.brightness"
  arg value string required "The new value; type and range are in settings.list"
  returns old string "The value before"
  returns change int "Number of this change in settings.history"
  dryrun
  undo settings.set

action settings.history read "The last changes: number, setting, old and new value, who changed it"
  returns count int "How many changes are listed"

action settings.revert write "Put back the value that one change replaced"
  keyed
  arg key string required "The setting of that change"
  arg change int required "The number of the change (settings.history)"
  dryrun

event settings.changed "Sent after every change of a setting"
  field key string "Which setting"
  field value string "Its new value"
  field client string "Who changed it"
