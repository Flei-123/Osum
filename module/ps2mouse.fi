
profile kernel

import ps2m
import modidx

extern fn k_abi() -> u64;
extern fn k_bind(state: u64, slot: u64, i: u64, adr: u64) -> u64;
extern fn k_puts(p: u64);
extern fn k_dec(v: u64);

const GEBAUT_GEGEN: u64 = 1

struct A_3b { f: fn(u64, u64, u64) -> bool }
struct A_1b { f: fn(u64) -> bool }
struct A_1v { f: fn(u64) }
struct A_1u { f: fn(u64) -> u64 }
struct A_0u { f: fn() -> u64 }
struct A_2vb { f: fn(u64, bool) }
struct A_3v { f: fn(u64, u64, u64) }
struct A_2u { f: fn(u64, u64) -> u64 }
struct A_2v { f: fn(u64, u64) }
struct A_2vi { f: fn(u64, i64) }
struct A_6u { f: fn(u64, u64, u64, u64, u64, u64) }
struct A_6v { f: fn(u64, u64, u64, u64, u64, bool) }

fn zelle(p: u64) -> u64 {
    let d: u64 = __mmio_read64(p as *mut u64)
    if d == 0 {
        return 0
    }
    return __mmio_read64(d as *mut u64)
}

fn a_3b(g: fn(u64, u64, u64) -> bool) -> u64 {
    var t: A_3b = A_3b { f: g }
    return zelle((&t) as u64)
}

fn a_1b(g: fn(u64) -> bool) -> u64 {
    var t: A_1b = A_1b { f: g }
    return zelle((&t) as u64)
}

fn a_1v(g: fn(u64)) -> u64 {
    var t: A_1v = A_1v { f: g }
    return zelle((&t) as u64)
}

fn a_1u(g: fn(u64) -> u64) -> u64 {
    var t: A_1u = A_1u { f: g }
    return zelle((&t) as u64)
}

fn a_0u(g: fn() -> u64) -> u64 {
    var t: A_0u = A_0u { f: g }
    return zelle((&t) as u64)
}

fn a_2vb(g: fn(u64, bool)) -> u64 {
    var t: A_2vb = A_2vb { f: g }
    return zelle((&t) as u64)
}

fn a_3v(g: fn(u64, u64, u64)) -> u64 {
    var t: A_3v = A_3v { f: g }
    return zelle((&t) as u64)
}

fn a_6v(g: fn(u64, u64, u64, u64, u64, bool)) -> u64 {
    var t: A_6v = A_6v { f: g }
    return zelle((&t) as u64)
}

fn a_2u(g: fn(u64, u64) -> u64) -> u64 {
    var t: A_2u = A_2u { f: g }
    return zelle((&t) as u64)
}

fn a_2v(g: fn(u64, u64)) -> u64 {
    var t: A_2v = A_2v { f: g }
    return zelle((&t) as u64)
}

fn a_2vi(g: fn(u64, i64)) -> u64 {
    var t: A_2vi = A_2vi { f: g }
    return zelle((&t) as u64)
}

fn a_6w(g: fn(u64, u64, u64, u64, u64, u64)) -> u64 {
    var t: A_6u = A_6u { f: g }
    return zelle((&t) as u64)
}

#[export_c]
fn module_init(state: u64) -> u64 {
    if k_abi() != GEBAUT_GEGEN {
        var w: [u8; 30] = "ps2mouse: bad kernel version \0"
        k_puts((&w[0]) as u64)
        k_dec(k_abi())
        return 1
    }

    var n: u64 = 0
    n = n + entry(state, modidx.P_INIT, a_3b(ps2m.init))
    n = n + entry(state, modidx.P_PRESENT, a_1b(ps2m.present))
    n = n + entry(state, modidx.P_IRQ, a_1v(ps2m.irq))
    n = n + entry(state, modidx.P_ID, a_1u(ps2m.id))
    n = n + entry(state, modidx.P_X, a_1u(ps2m.x))
    n = n + entry(state, modidx.P_Y, a_1u(ps2m.y))
    n = n + entry(state, modidx.P_BUTTONS, a_1u(ps2m.buttons))
    n = n + entry(state, modidx.P_WHEEL, a_1u(ps2m.wheel))
    n = n + entry(state, modidx.P_PACKETS, a_1u(ps2m.packets))
    n = n + entry(state, modidx.P_DROPS, a_1u(ps2m.drops))
    n = n + entry(state, modidx.P_MOVES, a_1u(ps2m.moves))
    n = n + entry(state, modidx.P_IRQS, a_1u(ps2m.irqs))
    n = n + entry(state, modidx.P_POLLS, a_1u(ps2m.polls))
    n = n + entry(state, modidx.P_SPURIOUS, a_1u(ps2m.spurious))
    n = n + entry(state, modidx.P_CLICKS, a_1u(ps2m.clicks))
    n = n + entry(state, modidx.P_STATUS, a_0u(ps2m.status))
    n = n + entry(state, modidx.P_RESET, a_1v(ps2m.reset_counters))
    n = n + entry(state, modidx.P_POLL_ONE, a_1b(ps2m.poll_one))
    n = n + entry(state, modidx.P_SET_POLL, a_2vb(ps2m.set_poll))
    n = n + entry(state, modidx.P_POLLING, a_1b(ps2m.polling))
    n = n + entry(state, modidx.P_SET_BOUNDS, a_3v(ps2m.set_bounds))
    n = n + entry(state, modidx.P_SET_POS, a_3v(ps2m.set_pos))
    n = n + entry(state, modidx.P_CHANGED, a_1b(ps2m.changed))
    n = n + entry(state, modidx.P_TAKE_CHANGE, a_1b(ps2m.take_change))
    n = n + entry(state, modidx.P_USB_PACKET, a_6v(ps2m.usb_packet))
    n = n + entry(state, modidx.P_ADOPT, a_3v(ps2m.adopt))
    n = n + entry(state, modidx.P_SELFTEST, a_1u(ps2m.selftest))
    n = n + entry(state, modidx.P_SELFTEST_MAX, a_0u(ps2m.selftest_max))
    n = n + entry(state, modidx.P_HEADS, a_1u(ps2m.heads))
    n = n + entry(state, modidx.P_HEAD_X, a_2u(ps2m.head_x))
    n = n + entry(state, modidx.P_HEAD_Y, a_2u(ps2m.head_y))
    n = n + entry(state, modidx.P_HEAD_W, a_2u(ps2m.head_w))
    n = n + entry(state, modidx.P_HEAD_H, a_2u(ps2m.head_h))
    n = n + entry(state, modidx.P_SET_HEADS, a_2v(ps2m.set_heads))
    n = n + entry(state, modidx.P_SET_HEAD, a_6w(ps2m.set_head))
    n = n + entry(state, modidx.P_HWHEEL, a_1u(ps2m.hwheel))
    n = n + entry(state, modidx.P_HWHEEL_ADD, a_2vi(ps2m.hwheel_add))

    var s: [u8; 22] = "ps2mouse: registered \0"
    k_puts((&s[0]) as u64)
    k_dec(n)
    var e: [u8; 2] = "\n\0"
    k_puts((&e[0]) as u64)

    if n != modidx.P_COUNT {
        return 2
    }
    return 0
}

fn entry(state: u64, i: u64, adr: u64) -> u64 {
    if adr == 0 {
        return 0
    }
    if k_bind(state, modidx.SLOT_MOUSE, i, adr) != 0 {
        return 0
    }
    return 1
}

#[export_c]
fn module_exit(state: u64) -> u64 {
    var s: [u8; 19] = "ps2maus: entladen\n\0"
    k_puts((&s[0]) as u64)
    return 0
}
