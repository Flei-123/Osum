profile kernel

extern fn k_abi() -> u64;
extern fn k_bind(state: u64, slot: u64, i: u64, adr: u64) -> u64;
extern fn k_puts(p: u64);
extern fn k_dec(v: u64);

const BUILT_FOR: u64 = 1
const SLOT_MOUSE: u64 = 0

struct A_1u { f: fn(u64) -> u64 }

fn cell(p: u64) -> u64 {
    let d: u64 = __mmio_read64(p as *mut u64)
    if d == 0 {
        return 0
    }
    return __mmio_read64(d as *mut u64)
}

fn a_1u(g: fn(u64) -> u64) -> u64 {
    var t: A_1u = A_1u { f: g }
    return cell((&t) as u64)
}

fn op_info(state: u64) -> u64 {
    return 0xBAD
}

#[export_c]
fn module_init(state: u64) -> u64 {
    var s_abi: [u8; 24] = "auxrogue: wrong kernel\n\0"
    var s_rej: [u8; 28] = "auxrogue: foreign bind rc=\0\0"
    var s_nl: [u8; 2] = "\n\0"
    if k_abi() != BUILT_FOR {
        k_puts((&s_abi[0]) as u64)
        return 1
    }
    let rc: u64 = k_bind(state, SLOT_MOUSE, 0, a_1u(op_info))
    k_puts((&s_rej[0]) as u64)
    k_dec(rc)
    k_puts((&s_nl[0]) as u64)
    if rc != 0 {
        return 3
    }
    return 0
}

#[export_c]
fn module_exit(state: u64) -> u64 {
    return 0
}
