profile kernel

extern fn k_abi() -> u64;
extern fn k_puts(p: u64);

const BUILT_FOR: u64 = 1

static mut counter: u64 = 0

#[export_c]
fn provdemo_add(a: u64, b: u64) -> u64 {
    return a +% b
}

#[export_c]
fn provdemo_next() -> u64 {
    counter = counter +% 1
    return counter
}

#[export_c]
fn module_init(state: u64) -> u64 {
    var s_abi: [u8; 24] = "provdemo: wrong kernel\n\0"
    var s_init: [u8; 16] = "provdemo: init\n\0"
    if k_abi() != BUILT_FOR {
        k_puts((&s_abi[0]) as u64)
        return 1
    }
    counter = 0
    k_puts((&s_init[0]) as u64)
    return 0
}

#[export_c]
fn module_exit(state: u64) -> u64 {
    var s_exit: [u8; 16] = "provdemo: exit\n\0"
    k_puts((&s_exit[0]) as u64)
    return 0
}
