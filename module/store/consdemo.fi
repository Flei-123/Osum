profile kernel

extern fn k_abi() -> u64;
extern fn k_puts(p: u64);
extern fn k_dec(v: u64);
extern fn provdemo_add(a: u64, b: u64) -> u64;
extern fn provdemo_next() -> u64;

const BUILT_FOR: u64 = 1

#[export_c]
fn module_init(state: u64) -> u64 {
    var s_abi: [u8; 24] = "consdemo: wrong kernel\n\0"
    var s_add: [u8; 15] = "consdemo: add=\0"
    var s_next: [u8; 7] = " next=\0"
    var nl: [u8; 2] = "\n\0"
    if k_abi() != BUILT_FOR {
        k_puts((&s_abi[0]) as u64)
        return 1
    }
    k_puts((&s_add[0]) as u64)
    k_dec(provdemo_add(20, 22))
    k_puts((&s_next[0]) as u64)
    k_dec(provdemo_next())
    k_puts((&s_next[0]) as u64)
    k_dec(provdemo_next())
    k_puts((&nl[0]) as u64)
    return 0
}

#[export_c]
fn module_exit(state: u64) -> u64 {
    var s_exit: [u8; 16] = "consdemo: exit\n\0"
    k_puts((&s_exit[0]) as u64)
    return 0
}
