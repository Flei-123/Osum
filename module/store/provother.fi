profile kernel

extern fn k_abi() -> u64;
extern fn k_puts(p: u64);

const BUILT_FOR: u64 = 1

#[export_c]
fn provother_noop() -> u64 {
    return 0
}

#[export_c]
fn module_init(state: u64) -> u64 {
    var s_abi: [u8; 25] = "provother: wrong kernel\n\0"
    var s_init: [u8; 17] = "provother: init\n\0"
    if k_abi() != BUILT_FOR {
        k_puts((&s_abi[0]) as u64)
        return 1
    }
    k_puts((&s_init[0]) as u64)
    return 0
}

#[export_c]
fn module_exit(state: u64) -> u64 {
    var s_exit: [u8; 17] = "provother: exit\n\0"
    k_puts((&s_exit[0]) as u64)
    return 0
}
