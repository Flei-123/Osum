profile kernel

extern fn k_abi() -> u64;
extern fn k_puts(p: u64);
extern fn k_dec(v: u64);
extern fn k_frames(n: u64) -> u64;

const BUILT_FOR: u64 = 1

#[export_c]
fn module_init(state: u64) -> u64 {
    var s_abi: [u8; 22] = "hwleak: wrong kernel\n\0"
    var s_run: [u8; 12] = "hwleak: run\0"
    var s_eq: [u8; 2] = "=\0"
    var s_nl: [u8; 2] = "\n\0"
    if k_abi() != BUILT_FOR {
        k_puts((&s_abi[0]) as u64)
        return 1
    }
    let f: u64 = k_frames(1)
    k_puts((&s_run[0]) as u64)
    k_puts((&s_eq[0]) as u64)
    if f != 0 {
        k_dec(1)
    } else {
        k_dec(0)
    }
    k_puts((&s_nl[0]) as u64)
    return 1
}

#[export_c]
fn module_exit(state: u64) -> u64 {
    return 0
}
