profile kernel

extern fn k_abi() -> u64;
extern fn k_bind(state: u64, slot: u64, i: u64, adr: u64) -> u64;
extern fn k_puts(p: u64);
extern fn k_dec(v: u64);
extern fn k_nl();

const BUILT_FOR: u64 = 1
const SLOT_MOUSE: u64 = 0
const P_INIT: u64 = 0
const P_PRESENT: u64 = 1
const P_ID: u64 = 3

struct A_1u { f: fn(u64) -> u64 }
struct A_3u { f: fn(u64, u64, u64) -> u64 }

fn cell(p: u64) -> u64 {
    let d: u64 = __mmio_read64(p as *mut u64)
    if d == 0 {
        return 0
    }
    return __mmio_read64(d as *mut u64)
}

fn a_1u(g: fn(u64) -> u64) -> u64 {
    var t: A_1u = A_1u { f: g }
    return cell((&t) as u64)
}

fn a_3u(g: fn(u64, u64, u64) -> u64) -> u64 {
    var t: A_3u = A_3u { f: g }
    return cell((&t) as u64)
}

fn op_init(state: u64, w: u64, h: u64) -> u64 {
    var s_pre: [u8; 17] = "mousedemo: init \0"
    var s_sp: [u8; 2] = " \0"
    k_puts((&s_pre[0]) as u64)
    k_dec(w)
    k_puts((&s_sp[0]) as u64)
    k_dec(h)
    k_nl()
    return 1
}

fn op_present(state: u64) -> u64 {
    return 1
}

fn op_id(state: u64) -> u64 {
    return 3
}

#[export_c]
fn module_init(state: u64) -> u64 {
    var s_abi: [u8; 24] = "mousedemo: wrong kernel\0"
    var s_up: [u8; 18] = "mousedemo: ready\n\0"
    if k_abi() != BUILT_FOR {
        k_puts((&s_abi[0]) as u64)
        return 1
    }
    var n: u64 = 0
    if k_bind(state, SLOT_MOUSE, P_INIT, a_3u(op_init)) == 0 {
        n = n + 1
    }
    if k_bind(state, SLOT_MOUSE, P_PRESENT, a_1u(op_present)) == 0 {
        n = n + 1
    }
    if k_bind(state, SLOT_MOUSE, P_ID, a_1u(op_id)) == 0 {
        n = n + 1
    }
    if n != 3 {
        return 2
    }
    k_puts((&s_up[0]) as u64)
    return 0
}

#[export_c]
fn module_exit(state: u64) -> u64 {
    return 0
}
