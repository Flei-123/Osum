profile kernel

extern fn k_abi() -> u64;
extern fn k_puts(p: u64);
extern fn k_dec(v: u64);

const BUILT_FOR: u64 = 1
const CTX: u64 = 0xAA800
const CTX_VENDOR: u64 = 16
const CTX_DEVICE: u64 = 24
const CTX_SUBSYS: u64 = 32
const CTX_BDF: u64 = 56
const CTX_BAR0: u64 = 64
const EDU_ID: u64 = 0x00
const EDU_LIVENESS: u64 = 0x04

fn ctx(state: u64, off: u64) -> u64 {
    return __mmio_read64((state + CTX + off) as *mut u64)
}

#[export_c]
fn modul_init(state: u64) -> u64 {
    var s_abi: [u8; 23] = "edudemo: wrong kernel\n\0"
    var s_bound: [u8; 14] = "edudemo: ven=\0"
    var s_dev: [u8; 6] = " dev=\0"
    var s_bdf: [u8; 6] = " bdf=\0"
    var s_id: [u8; 5] = " id=\0"
    var s_live: [u8; 7] = " live=\0"
    if k_abi() != BUILT_FOR {
        k_puts((&s_abi[0]) as u64)
        return 1
    }
    let bar: u64 = ctx(state, CTX_BAR0)
    k_puts((&s_bound[0]) as u64)
    k_dec(ctx(state, CTX_VENDOR))
    k_puts((&s_dev[0]) as u64)
    k_dec(ctx(state, CTX_DEVICE))
    k_puts((&s_bdf[0]) as u64)
    k_dec(ctx(state, CTX_BDF))
    if bar != 0 {
        let id: u64 = __mmio_read32((bar + EDU_ID) as *mut u32) as u64
        __mmio_write32((bar + EDU_LIVENESS) as *mut u32, 0x12345678)
        let live: u64 = __mmio_read32((bar + EDU_LIVENESS) as *mut u32) as u64
        k_puts((&s_id[0]) as u64)
        k_dec(id)
        k_puts((&s_live[0]) as u64)
        k_dec(live)
    }
    var nl: [u8; 2] = "\n\0"
    k_puts((&nl[0]) as u64)
    return 0
}

#[export_c]
fn modul_exit(state: u64) -> u64 {
    return 0
}
