profile kernel

extern fn k_abi() -> u64;
extern fn k_puts(p: u64);
extern fn k_dec(v: u64);
extern fn k_fwreq(name: u64, hash: u64, dst: u64, cap: u64) -> u64;

const BUILT_FOR: u64 = 1
const FW_CAP: u64 = 256

static mut fw_buf: [u8; 256] = [0 as u8; 256]

fn fw_hash(dst: u64) {
    var h: [u8; 32] = [
        0x71, 0x72, 0xbb, 0xd9, 0x98, 0x95, 0xda, 0xb7,
        0xcd, 0x86, 0xad, 0x9f, 0x77, 0x7b, 0xe3, 0xa3,
        0x23, 0xfe, 0x45, 0x4b, 0x74, 0x53, 0x82, 0x02,
        0x84, 0x9e, 0x4d, 0xe8, 0xd5, 0x3b, 0xa6, 0x41
    ]
    var i: u64 = 0
    while i < 32 {
        __mmio_write8((dst + i) as *mut u8, h[i as usize])
        i = i + 1
    }
}

#[export_c]
fn module_init(state: u64) -> u64 {
    var s_abi: [u8; 22] = "fwdemo: wrong kernel\n\0"
    var s_name: [u8; 11] = "fwdemo.bin\0"
    var s_ok: [u8; 16] = "fwdemo: fw len=\0"
    var s_b0: [u8; 5] = " b0=\0"
    var s_bad: [u8; 17] = "fwdemo: fw none\n\0"
    var nl: [u8; 2] = "\n\0"
    var hash: [u8; 32] = [0 as u8; 32]
    if k_abi() != BUILT_FOR {
        k_puts((&s_abi[0]) as u64)
        return 1
    }
    fw_hash((&hash[0]) as u64)
    let n: u64 = k_fwreq((&s_name[0]) as u64, (&hash[0]) as u64, (&fw_buf[0]) as u64, FW_CAP)
    if n == 0 {
        k_puts((&s_bad[0]) as u64)
        return 0
    }
    k_puts((&s_ok[0]) as u64)
    k_dec(n)
    k_puts((&s_b0[0]) as u64)
    k_dec(fw_buf[0] as u64)
    k_puts((&nl[0]) as u64)
    return 0
}

#[export_c]
fn module_exit(state: u64) -> u64 {
    return 0
}
