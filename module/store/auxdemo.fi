profile kernel

extern fn k_abi() -> u64;
extern fn k_bind(state: u64, slot: u64, i: u64, adr: u64) -> u64;
extern fn k_puts(p: u64);
extern fn k_dec(v: u64);

const BUILT_FOR: u64 = 1
const SLOT_AUX: u64 = 1
const A_INFO: u64 = 0
const A_CONTROL: u64 = 1
const A_STATUS: u64 = 2
const INFO_ID: u64 = 0xA0C1

struct A_1u { f: fn(u64) -> u64 }
struct A_3u { f: fn(u64, u64, u64) -> u64 }

fn cell(p: u64) -> u64 {
    let d: u64 = __mmio_read64(p as *mut u64)
    if d == 0 {
        return 0
    }
    return __mmio_read64(d as *mut u64)
}

fn a_1u(g: fn(u64) -> u64) -> u64 {
    var t: A_1u = A_1u { f: g }
    return cell((&t) as u64)
}

fn a_3u(g: fn(u64, u64, u64) -> u64) -> u64 {
    var t: A_3u = A_3u { f: g }
    return cell((&t) as u64)
}

fn op_info(state: u64) -> u64 {
    return INFO_ID
}

fn op_control(state: u64, cmd: u64, arg: u64) -> u64 {
    if cmd == 1 {
        return arg * 2
    }
    if cmd == 2 {
        return arg + 7
    }
    return 0
}

fn op_status(state: u64) -> u64 {
    return 1
}

#[export_c]
fn module_init(state: u64) -> u64 {
    var s_abi: [u8; 23] = "auxdemo: wrong kernel\n\0"
    var s_up: [u8; 16] = "auxdemo: ready\n\0"
    if k_abi() != BUILT_FOR {
        k_puts((&s_abi[0]) as u64)
        return 1
    }
    var n: u64 = 0
    if k_bind(state, SLOT_AUX, A_INFO, a_1u(op_info)) == 0 {
        n = n + 1
    }
    if k_bind(state, SLOT_AUX, A_CONTROL, a_3u(op_control)) == 0 {
        n = n + 1
    }
    if k_bind(state, SLOT_AUX, A_STATUS, a_1u(op_status)) == 0 {
        n = n + 1
    }
    if n != 3 {
        return 2
    }
    k_puts((&s_up[0]) as u64)
    return 0
}

#[export_c]
fn module_exit(state: u64) -> u64 {
    return 0
}
