-    return 0 - 1
+    var best: i32 = 0 - 1
+    var best_at: u64 = 0
+    i = 0
+    while i < MAXCONN {
+        let c: *mut Tcb = tcb(t, i)
+        if (*c).state == S_TIME_WAIT {
+            if best < 0 || (*c).tw_at < best_at {
+                best = i as i32
+                best_at = (*c).tw_at
+            }
+        }
+        i = i + 1
+    }
+    if best >= 0 {
+        clear(tcb(t, best as usize))
+        bump(t, ST_TW_REUSE)
+    }
+    return best
 }
 
