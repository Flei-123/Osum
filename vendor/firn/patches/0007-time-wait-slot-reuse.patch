+// A free slot. When all MAXCONN slots are taken, the TIME_WAIT slot
+// that is closest to running out is handed over instead (OSUM K-008).
+// Without this, eight short connections in a row -- an IPP client
+// polling a printer, `Connection: close` HTTP -- fill the table for the
+// full 60 seconds of TIME_WAIT and every further connect fails. The
+// slot belongs to nobody any more: `close` already went through, only
+// the 2*MSL guard is left. What that guard protects against is an old
+// segment of the SAME four-tuple (RFC 9293, 3.6.1); a connection that
+// takes the slot over gets a fresh ISS from `new_iss`, which is what
+// RFC 1122 4.2.2.13 and RFC 6191 rely on when they let a new
+// connection end TIME_WAIT early. Linux does the same when
+// tcp_max_tw_buckets overflows.
 fn tcp_free_slot(t: *mut Tcp) -> i32 {
     var i: usize = 0
     while i < MAXCONN {
@@ -514,7 +527,24 @@
