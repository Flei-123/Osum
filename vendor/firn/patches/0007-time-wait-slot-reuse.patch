-    ST_PAWS, ST_SACK_RX, ST_SACK_TX, ST_REXMIT_SACK, ST_MTU_DOWN,
+    ST_PAWS, ST_SACK_RX, ST_SACK_TX, ST_REXMIT_SACK, ST_MTU_DOWN, ST_TW_REUSE,
