+// PATH MTU DISCOVERY (RFC 1191), die Empfangsseite.
+//
+// Bis zu dieser Runde setzte der Stack "Don't Fragment" und WARF DIE
+// ANTWORT WEG. Auf einer Strecke mit kleinerer MTU ist das eine schwarze
+// Strecke: der Handschlag geht durch (kleine Segmente), die Daten nicht
+// (grosse), und niemand erfaehrt warum -- das Segment verschwindet, der
+// Wiederholungstimer schickt DASSELBE zu grosse Segment noch einmal, und
+// das bis zur Aufgabe. docs/OSUM-K3.md nennt das ausdruecklich.
+//
+// `tcp_icmp_toobig` wird von der IP-Schicht mit dem ZURUECKGESCHICKTEN
+// Kopf gerufen. Aus ihm kommen Adressen und Anschluesse, also die
+// Verbindung, um die es geht; ein ICMP-Paket fuer irgendeine andere darf
+// hier nichts aendern.
+//
+// DIE ZWEI FALLEN, und beide sind hier behandelt:
+//
+//   1. Ein Router, der die naechste MTU NICHT nennt (Feld 0, der alte
+//      RFC 792). Dann wird geraten, aber nach unten und in Stufen --
+//      nicht auf 68 heruntergefallen, was die Strecke unbrauchbar
+//      langsam machen wuerde.
+//   2. Eine gefaelschte Nachricht, die die MSS auf 68 druecken und die
+//      Verbindung damit lahmlegen soll. MTU_FLOOR ist die Untergrenze;
+//      unter 576 geht dieser Stack nicht, und groesser als bisher wird
+//      die MSS hier NIE -- eine ICMP-Nachricht darf nur verkleinern.
+fn tcp_icmp_toobig(t: *mut Tcp, lip: u32, lport: u16, rip: u32, rport: u16,
+    next_mtu: u32) -> bool {
+    let h: i32 = find_conn(t, lip, lport, rip, rport)
+    if h < 0 { return false }
+    let c: *mut Tcb = tcb(t, h as usize)
+    if (*c).used == 0 { return false }
+    var mtu: u32 = next_mtu
+    if mtu == 0 {
+        // Kein Wert genannt: eine Stufe unter das, was wir gerade
+        // schicken. 1500 -> 1492 -> 1006 -> 576 sind die Stufen aus
+        // RFC 1191 Tabelle 7-1, hier auf die drei gekuerzt, die auf
+        // einer IPv4-Strecke wirklich vorkommen.
+        let jetzt: u32 = (*c).mss + 40
+        if jetzt > 1492 { mtu = 1492 }
+        else if jetzt > 1006 { mtu = 1006 }
+        else { mtu = MTU_FLOOR }
+    }
+    if mtu < MTU_FLOOR { mtu = MTU_FLOOR }
+    let neu: u32 = mtu - 40
+    if neu >= (*c).mss { return false }
+    (*c).mss = neu
+    if (*c).cwnd < neu { (*c).cwnd = neu }
+    // Was zu gross hinausging, muss noch einmal -- kleiner.
+    (*c).snd_nxt = (*c).snd_una
+    (*c).fin_sent = 0
+    bump(t, ST_MTU_DOWN)
+    return true
+}
