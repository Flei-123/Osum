+// 8b. DIE OPTIONEN, DIE RUNDE K3 NOCH NICHT GELESEN HAT
+// ===================================================================
+//
+// RUNDE NETZPLUS. `tcp_mss_option` oben laeuft das Optionsfeld ab und
+// beantwortet GENAU EINE Frage. Fuer Fensterskalierung, Zeitstempel und
+// SACK waeren das drei weitere fast gleiche Schleifen -- und jede davon
+// eine eigene Gelegenheit, den Abbruch bei einem kaputten Laengenoktett
+// falsch zu schreiben. Also EINE Schleife, `tcp_opt_find`, die den
+// PLATZ einer Option liefert; die Leser darunter sind dann drei Zeilen.
+//
+// Die Abbruchbedingungen sind die von `tcp_mss_option` und aus demselben
+// Grund da: ein Laengenoktett von 0 oder 1 in einer mehroktettigen
+// Option ist der klassische Weg in eine Endlosschleife, und ein
+// Optionsfeld, das ueber das Segment hinausragt, der Weg in fremden
+// Speicher. Beides endet hier mit "nicht gefunden".
+
+const TOPT_END: u8 = 0
+const TOPT_NOP: u8 = 1
+const TOPT_MSS: u8 = 2
+const TOPT_WS: u8 = 3
+const TOPT_SACKOK: u8 = 4
+const TOPT_SACK: u8 = 5
+const TOPT_TS: u8 = 8
+
+// Sucht die Option `want` und liefert den Versatz IHRES ERSTEN
+// INHALTSOKTETTS (also hinter Art und Laenge), oder 0, wenn sie nicht da
+// ist. 0 ist als "nicht da" eindeutig: eine Option kann nie bei 0
+// anfangen, dort steht der Quellanschluss.
+//
+// `plen` nimmt die Laenge der Option entgegen, damit der Aufrufer die
+// veraenderliche Laenge von SACK erfaehrt, ohne noch einmal zu suchen.
+fn tcp_opt_find(p: *mut u8, seglen: usize, want: u8, plen: *mut usize) -> usize {
+    *plen = 0
+    let off: usize = tcp_off(p)
+    if off <= TCP_HDR { return 0 }
+    if off > seglen { return 0 }
+    var i: usize = TCP_HDR
+    while i < off {
+        let kind: u8 = ld8(p, i)
+        if kind == TOPT_END { return 0 }
+        if kind == TOPT_NOP { i = i + 1 }
+        else {
+            if i + 1 >= off { return 0 }
+            let len: usize = ld8(p, i + 1) as usize
+            if len < 2 { return 0 }
+            if i + len > off { return 0 }
+            if kind == want {
+                *plen = len
+                return i + 2
+            }
+            i = i + len
+        }
+    }
+    return 0
+}
