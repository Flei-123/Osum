+// Die SACK-Bloecke eines Segments. Liefert die ANZAHL und schreibt die
+// Paare nach lo[]/hi[]; hoechstens `max` (RFC 2018 erlaubt vier).
+fn tcp_sack_blocks(p: *mut u8, seglen: usize, lo: *mut u32, hi: *mut u32,
+    max: usize) -> usize {
+    var len: usize = 0
+    let at: usize = tcp_opt_find(p, seglen, TOPT_SACK, &len)
+    if at == 0 { return 0 }
+    // Laenge ist 2 + 8*n; alles andere ist kaputt.
+    if len < 10 { return 0 }
+    let n_opt: usize = (len - 2) / 8
+    if (len - 2) % 8 != 0 { return 0 }
+    var n: usize = n_opt
+    if n > max { n = max }
+    var k: usize = 0
+    while k < n {
+        *(((lo as u64) + (k * 4) as u64) as *mut u32) = be32(p, at + k * 8)
+        *(((hi as u64) + (k * 4) as u64) as *mut u32) = be32(p, at + k * 8 + 4)
+        k = k + 1
+    }
+    return n
+}
