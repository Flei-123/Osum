+// ist -- das ist KEIN gueltiger Faktor und damit von "Faktor 0"
+// unterscheidbar; Faktor 0 heisst "ich kann skalieren, brauche es aber
+// nicht" und ist etwas voellig anderes als "ich kann es nicht".
+//
+// RFC 7323 2.3: mehr als 14 wird auf 14 gedeckelt statt die Option zu
+// verwerfen; ein Fenster von 2^30 ist die Obergrenze, die das
+// Sequenznummernfeld noch vertraegt.
+fn tcp_wscale_option(p: *mut u8, seglen: usize) -> u8 {
+    var len: usize = 0
+    let at: usize = tcp_opt_find(p, seglen, TOPT_WS, &len)
+    if at == 0 || len != 3 { return 255 as u8 }
+    var s: u8 = ld8(p, at)
+    if s > 14 as u8 { s = 14 as u8 }
+    return s
+}
+
+// Die beiden Zeitstempel. Antwort false, wenn keine Option da ist.
+fn tcp_ts_option(p: *mut u8, seglen: usize, tsval: *mut u32, tsecr: *mut u32) -> bool {
+    var len: usize = 0
+    let at: usize = tcp_opt_find(p, seglen, TOPT_TS, &len)
+    if at == 0 || len != 10 { return false }
+    *tsval = be32(p, at)
+    *tsecr = be32(p, at + 4)
+    return true
+}
+
+fn tcp_sackok_option(p: *mut u8, seglen: usize) -> bool {
+    var len: usize = 0
+    let at: usize = tcp_opt_find(p, seglen, TOPT_SACKOK, &len)
+    return at != 0 && len == 2
+}
