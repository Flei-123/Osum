+// N-006: SO_KEEPALIVE / TCP_KEEPIDLE / TCP_KEEPINTVL / TCP_KEEPCNT of one
+// connection, in microseconds. The caller has checked the ranges.
+fn tcp_set_keepalive(t: *mut Tcp, h: i32, on: bool, idle_us: u64, intvl_us: u64,
+    cnt: u32, now: u64) {
+    if h < 0 { return }
+    let c: *mut Tcb = tcb(t, h as usize)
+    if (*c).used == 0 { return }
+    (*c).ka_idle = idle_us
+    (*c).ka_intvl = intvl_us
+    (*c).ka_cnt = cnt
+    if on {
+        if (*c).ka_on == 0 { (*c).ka_sent = 0 }
+        (*c).ka_on = 1
+        if (*c).ka_last == 0 { (*c).ka_last = now }
+    } else {
+        (*c).ka_on = 0
+        (*c).ka_sent = 0
+    }
+}
+
+// which: 0 on, 1 idle us, 2 intvl us, 3 cnt, 4 probes sent so far
+fn tcp_keepalive_get(t: *mut Tcp, h: i32, which: u32) -> u64 {
+    if h < 0 { return 0 }
+    let c: *mut Tcb = tcb(t, h as usize)
+    if which == 0 { return (*c).ka_on as u64 }
+    if which == 1 { return (*c).ka_idle }
+    if which == 2 { return (*c).ka_intvl }
+    if which == 3 { return (*c).ka_cnt as u64 }
+    return (*c).ka_sent as u64
+}
+
 fn tcp_set_time_wait(t: *mut Tcp, us: u64) { (*t).time_wait_us = us }
 fn tcp_set_rto_min(t: *mut Tcp, us: u64) { (*t).rto_min = us }
 fn tcp_set_no_rexmit(t: *mut Tcp, on: bool) {
@@ -1471,6 +1526,9 @@
     let st0: u32 = (*c).state
 
     if st0 == S_CLOSED { return }
+    // N-006: whatever arrives, even a refused probe's ACK, proves the peer lives.
+    (*c).ka_last = now
+    (*c).ka_sent = 0
     if st0 == S_SYN_SENT {
         syn_sent_step(t, c, seg, now)
         return
@@ -2193,6 +2251,33 @@
         (*c).seg_since_ack = 0
         return seg_build(t, c, buf, cap, wire.F_ACK, (*c).snd_nxt, 0, false, now)
     }
+
+    // N-006: KEEPALIVE. Only an idle connection is probed: nothing unacked
+    // (the retransmission timer already kills a dead peer then) and no
+    // zero-window probe running (it elicits an answer itself).
+    if (*c).ka_on == 1 && (st == S_ESTABLISHED || st == S_CLOSE_WAIT)
+    && (*c).rt_on == 0 && (*c).persist_on == 0 {
+        var due: u64 = (*c).ka_last + (*c).ka_idle
+        if (*c).ka_sent > 0 { due = (*c).ka_at }
+        if now >= due {
+            if (*c).ka_sent >= (*c).ka_cnt {
+                // every probe went unanswered: reset it, the owner reads E_TIMEOUT
+                let rn: usize = seg_build(t, c, buf, cap, wire.F_RST, (*c).snd_nxt, 0, false, now)
+                bump(t, ST_KA_DEAD)
+                if rn > 0 { bump(t, ST_RST_TX) }
+                dead(t, c, E_TIMEOUT)
+                return rn
+            }
+            // an empty segment one octet BEFORE snd_nxt is outside the peer's
+            // window, so it must answer with an ACK (RFC 1122 4.2.3.6)
+            let kn: usize = seg_build(t, c, buf, cap, wire.F_ACK, (*c).snd_nxt -% 1, 0, false, now)
+            if kn == 0 { return 0 }
+            (*c).ka_sent = (*c).ka_sent + 1
+            (*c).ka_at = now + (*c).ka_intvl
+            bump(t, ST_KEEPALIVE)
+            return kn
+        }
+    }
     return 0
 }
 
