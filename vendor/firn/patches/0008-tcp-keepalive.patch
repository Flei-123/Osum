# vendor/firn/patches/0008-tcp-keepalive.patch
#
# OSUM N-006 (14.10.2026) -- REAL TCP KEEPALIVE (RFC 1122 4.2.3.6).
#
# WHY. SO_KEEPALIVE was accepted and did nothing: a connection whose peer
# vanished (cable pulled, host crashed, NAT entry gone) stayed ESTABLISHED
# for ever, because an idle connection sends nothing and so nothing times out.
#
# WHAT. Per connection: ka_on, ka_idle, ka_intvl, ka_cnt, ka_last (time of
# the last segment received), ka_sent. tcp.emit sends an empty ACK with
# seq = snd_nxt - 1 after ka_idle of silence and then every ka_intvl; the peer
# must answer it with an ACK. After ka_cnt unanswered probes the connection is
# reset (RST out) and its owner reads E_TIMEOUT. Any received segment resets
# the count. Counters ST_KEEPALIVE / ST_KA_DEAD. API: tcp_set_keepalive,
# tcp_keepalive_get (stack.net_keepalive, net_keepalive_get).
#
# WHY A PATCH AND NOT FIRN: see 0006 -- the pin stays the pin.
#
--- a/net/stack.fi
+++ b/net/stack.fi
@@ -39,6 +39,7 @@
     net_size, net_init, net_input, net_output, net_poll,
     net_listen, net_accept, net_connect, net_send, net_recv, net_close,
     net_abort, net_state, net_error, net_readable, net_writable,
+    net_keepalive, net_keepalive_get,
     net_tcp, net_ip, net_mac_at, net_set_arp_ttl, net_stat,
     net_arp_find, net_arp_learn, net_arp_valid, net_pending,
     udp_bind, udp_send, udp_recv, udp_close,
@@ -652,6 +653,13 @@
     return tcp.tcp_recv(&(*s).t, h, p, n)
 }
 
+fn net_keepalive(s: *mut Stack, h: i32, on: bool, idle_us: u64, intvl_us: u64,
+    cnt: u32, now: u64) {
+    tcp.tcp_set_keepalive(&(*s).t, h, on, idle_us, intvl_us, cnt, now)
+}
+fn net_keepalive_get(s: *mut Stack, h: i32, which: u32) -> u64 {
+    return tcp.tcp_keepalive_get(&(*s).t, h, which)
+}
 fn net_close(s: *mut Stack, h: i32) { tcp.tcp_close(&(*s).t, h) }
 fn net_abort(s: *mut Stack, h: i32) { tcp.tcp_abort(&(*s).t, h) }
 fn net_state(s: *mut Stack, h: i32) -> u32 { return tcp.tcp_state(&(*s).t, h) }
