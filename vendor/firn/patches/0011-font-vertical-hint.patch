 }
 
+#[no_gc]
+fn vhint_none(f: *mut Font, px: u32, top: i32) -> u32 {
+    return 65536 as u32
+}
+
+#[no_gc]
+fn font_set_vhint(f: *mut Font, h: fn(*mut Font, u32, i32) -> u32) {
+    (*f).vhint = h
+    (*f).vhint_on = 1
+}
+
+#[no_gc]
+#[allow_fp]
+fn font_vhint(f: *mut Font, px: u32, top: i32) -> f64 {
+    if (*f).vhint_on == 0 {
+        return 1.0
+    }
+    let h: fn(*mut Font, u32, i32) -> u32 = (*f).vhint
+    return (h(f, px, top) as f64) / 65536.0
+}
+
 // Hands a face its fallback table (patches 0009, 0010): `n` faces of `stride` bytes each, contiguous from `base`; the face at
 // base + (k - 1) * stride owns ids with tag k (1..255). They must stay where they are for as long as this face is used, and they
 // must have no fallback of their own.
