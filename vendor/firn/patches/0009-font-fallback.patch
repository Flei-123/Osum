# vendor/firn/patches/0009-font-fallback.patch
#
# OSUM G-009 / r1084 (18.10.2026) -- FONT FALLBACK CHAIN IN THE fUi PAINTER.
#
# WHY. osum-sans.ttf has no Emoji, no arrows, no Latin Extended-B, no Greek/Cyrillic. The painter (lib/fui/painter.fi,
# lib/font/metrics.fi) looks glyphs up with ttf.font_glyph_for on ONE font, so every such code point came out as the
# missing box. lib/font/fallback.fi is a separate chain painter into a pixel buffer; it is not wired into the fUi painter.
#
# WHAT. A Font may carry two fallback faces and a `miss` callback. font_glyph_for asks the own cmap first; only when
# that gives 0 for a code point >= U+00A0 and a callback is set, it asks the callback, which loads the faces on the first
# miss (the processes that never miss never load them) and returns `gid | (k << 24)`. font_advance / font_lsb /
# font_glyph_bbox / outline_at answer such an id from the face k (ids < 2^24 are untouched, so a font without fallback
# behaves bit for bit as before); font_kern of an encoded id is 0. API: ttf.font_set_fallback(f, fb1, fb2, miss).
# The faces must have the same units per em as the font that asks (the callback gets it and refuses otherwise).
#
# WHY A PATCH AND NOT FIRN: see 0006 -- the pin stays the pin.
#
--- a/font/ttf.fi
+++ b/font/ttf.fi
@@ -51,7 +51,7 @@
     Font,
     font_new, font_init, font_ok,
     font_upem, font_ascent, font_descent, font_line_gap, font_num_glyphs,
-    font_glyph_for, font_advance, font_lsb, font_kern, font_has_kern,
+    font_glyph_for, font_set_fallback, font_advance, font_lsb, font_kern, font_has_kern,
     font_glyph_bbox, font_outline, font_outline_m,
     font_scratch_needed,
     font_cmap_format,
@@ -105,6 +105,14 @@
     // same `font_glyph_for`, so the answers are the same numbers.
     lat: [u32; 256],
     lat_ok: usize,
+    // OSUM FALLBACK FACES (vendor/firn/patches/0009): two more faces asked for a code point this one lacks. Their glyph ids come
+    // back as `gid | (k << 24)`, k = 1 or 2; advance, bbox and outline of such an id are answered by the face it belongs to.
+    // `miss` is called for a code point (>= U+00A0) this face has no glyph for, with this face's units per em; it loads the
+    // fallback faces on the first ask and returns the encoded id, or 0.
+    fb1: usize,
+    fb2: usize,
+    miss: fn(u32, u32) -> u32,
+    miss_on: usize,
 }
 
 // ------------------------------------------------------- Big endian reads
@@ -224,10 +232,42 @@
         line_gap: 0,
         lat: [0 as u32; 256],
         lat_ok: 0,
+        fb1: 0,
+        fb2: 0,
+        miss: miss_none,
+        miss_on: 0,
     }
 }
 
 #[no_gc]
+fn miss_none(cp: u32, upem: u32) -> u32 {
+    return 0 as u32
+}
+
+// Hands a face its fallbacks (patch 0009). `fb1`/`fb2` are the faces that ids with k = 1 / 2 belong to; they must stay where they
+// are for as long as this face is used, and they must have no fallback of their own.
+#[no_gc]
+fn font_set_fallback(f: *mut Font, fb1: *mut Font, fb2: *mut Font, miss: fn(u32, u32) -> u32) {
+    (*f).fb1 = fb1 as u64 as usize
+    (*f).fb2 = fb2 as u64 as usize
+    (*f).miss = miss
+    (*f).miss_on = 1
+}
+
+// The face an encoded glyph id belongs to (0 = none).
+#[no_gc]
+fn fb_owner(f: *mut Font, gid: u32) -> *mut Font {
+    let k: u32 = gid >> 24
+    if k == 1 as u32 {
+        return (*f).fb1 as u64 as *mut Font
+    }
+    if k == 2 as u32 {
+        return (*f).fb2 as u64 as *mut Font
+    }
+    return 0 as u64 as *mut Font
+}
+
+#[no_gc]
 fn tag_eq(f: *mut Font, off: usize, a: u32, b: u32, c: u32, d: u32) -> bool {
     return rd8(f, off) == a && rd8(f, off + 1) == b &&
     rd8(f, off + 2) == c && rd8(f, off + 3) == d
