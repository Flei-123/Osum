# vendor/firn/patches/0010-blog-no-std-io.patch
#
# ROUND FIRNC1 (OrientOS, 23.10.2026) -- plat/blog.fi without `import std.io`.
#
# Firn 9c2b0435f: lib/fui/gpu.fi imports plat.blog, which imports std.io.
# Firn allows ONE module per short name in a compilation unit, and every
# OrientOS GUI program that also imports libc.io (desktop, massren,
# widgetdemo, ...) got:  module 'io' has no element 'eprint_line'
# (vendor/firn/lib/plat/blog.fi:14). blog.log only needs a line on stderr,
# so it writes through std.rt directly. Same output bytes as before.
#
--- a/plat/blog.fi	2026-10-23 18:54:56.750622587 +0000
+++ b/plat/blog.fi	2026-10-23 18:54:56.771140260 +0000
@@ -5,13 +5,19 @@
 //     blog.log("BENCH", "ready ms=1200")
 //     blog.since_start_ms()    milliseconds since this process started (Linux/Android: /proc/self/stat + /proc/uptime), -1 if unknown
 import std.rt
-import std.io
 import std.fs
 
 export { log, since_start_ms }
 
 fn log(tag: str, text: str) {
-    io.eprint_line(tag + " " + text)
+    // written with rt directly: `import std.io` here would collide with OrientOS's own module `io` (libc.io)
+    // in every program that uses both fUi (fui.gpu pulls plat.blog) and libc.io.
+    var nl: [u8; 1] = "\n"
+    var sp: [u8; 1] = " "
+    rt.write_everything(2, tag.p as u64, tag.n)
+    rt.write_everything(2, (&sp[0]) as u64, 1)
+    rt.write_everything(2, text.p as u64, text.n)
+    rt.write_everything(2, (&nl[0]) as u64, 1)
 }
 
 // the n-th (1 based) blank separated token after the last ')' of a /proc/<pid>/stat line (token 1 = field 3, the state)
