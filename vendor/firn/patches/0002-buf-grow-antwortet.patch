-    buf_new, buf_free, buf_clear, buf_reserve, buf_push, buf_push_bytes,
+    buf_new, buf_free, buf_clear, buf_reserve, buf_reserve_or_die,
+    buf_grow, buf_push, buf_push_bytes,
