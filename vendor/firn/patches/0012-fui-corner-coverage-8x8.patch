# OSUM r2024 -- fUi corner_coverage: 8x8 probes (same sampling as lib/ecke.fi) plus near/far shortcut, so widget corners match window corners.
#
--- a/fui/core.fi
+++ b/fui/core.fi
@@ -188,10 +188,13 @@
 // ================================================= THE ROUND CORNERS
 //
 // The coverage of a pixel at a corner with radius `r`, as a number
-// 0..255. INTEGER and without a square root: it is tested with 4x4
-// probes per pixel whether the probe lies in the circle (dx*dx + dy*dy
-// <= r*r). 16 probes give 17 steps, and the difference from an exact
-// area computation is under one brightness step of 255.
+// 0..255. INTEGER and without a square root: a pixel entirely inside
+// or entirely outside the circle is decided from its near and far
+// corner, only the thin ring between is tested with 8x8 probes per
+// pixel (dx*dx + dy*dy <= r*r). 64 probes give 65 steps, the same
+// sampling as the window corners of the kernel (lib/ecke.fi), so a
+// button corner and a window corner of the same radius have the same
+// curvature.
 //
 // `cx`/`cy` is the centre of the corner circle, `px`/`py` the pixel.
 // Everything in pixels, everything `usize`.
@@ -201,40 +204,59 @@
         return 255
     }
     let rr: usize = r * r
+    var nx: usize = 0
+    var fx: usize = 0
