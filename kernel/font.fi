// kernel/font.fi -- Runde K7: der Zeichensatz der Bildschirmkonsole.
//
// Acht Bildpunkte breit, sechzehn hoch, 0x20 bis 0x7E -- 95 Zeichen zu je
// 16 Oktetten, zusammen 1520. Ein gesetztes Bit ist Vordergrundfarbe,
// Bit 7 ist die LINKE Spalte.
//
// HERKUNFT. Die Glyphen stammen aus OrientOS'
// `kernel/src/drivers/font.rs` (Rust, 221 Zeilen) und sind dort einmalig
// aus DejaVu Sans Mono (Bitstream-Vera-Lizenz, freie Weitergabe erlaubt)
// auf ein 8x16-Raster gerastert worden. Hier liegt nur das Ergebnis als
// reine Bitmaske: kein Zeichensatzleser im Kernel, 1520 Oktette Kosten.
// Portiert wurde die Zahlentabelle, Oktett fuer Oktett; `tools/gfx/run.sh`
// prueft sie gegen die Rust-Quelle nach, damit "portiert" nicht "ungefaehr
// abgeschrieben" heisst.
//
// WARUM DIE TABELLE IN DEN DATENBEREICH KOPIERT WIRD. Stufe 0 von Firn
// kennt kein `const` auf einem Feld (SPEC 14, Punkt 5 -- nur ganze Zahlen
// und Wahrheitswerte); der Uebersetzer sagt das mit
// "'const' supports only integer and bool types in stage 0". Eine Tabelle
// ist hier deshalb dasselbe wie jede andere veraenderliche Groesse des
// Kernels: sie liegt im DATENBEREICH, und dieses Modul legt sie einmal
// beim Start dorthin. Zehn Stuecke zu 152 Oktetten, weil ein einziges
// Zeichenkettenliteral von 1520 Oktetten zwar uebersetzt, aber keine
// Zeile mehr ist, die ein Mensch liest.

profile kernel

import kstate

export { load, row, GLYPH_W, GLYPH_H, FIRST, LAST, BYTES, glyphs }

const GLYPH_W: u64 = 8
const GLYPH_H: u64 = 16
const FIRST: u64 = 0x20
const LAST: u64 = 0x7E
const BYTES: u64 = 1520 // (LAST - FIRST + 1) * GLYPH_H

// Wie viele Zeichen die Tabelle traegt.
fn glyphs() -> u64 {
    return LAST - FIRST + 1
}

// Ein Stueck der Tabelle an seinen Platz. `put` bekommt die Adresse des
// Ziels und die des Stuecks auf dem Stapel; kopiert wird Oktett fuer
// Oktett, weil ein Kernel ohne Bibliothek kein memcpy hat.
fn put(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(dst + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
}

