// Legt den Zeichensatz an `base` ab. Wird einmal beim Start gerufen.
fn load(base: u64) {
    teil0(base + 0)
    teil1(base + 152)
    teil2(base + 304)
    teil3(base + 456)
    teil4(base + 608)
    teil5(base + 760)
    teil6(base + 912)
    teil7(base + 1064)
    teil8(base + 1216)
    teil9(base + 1368)
}

// Eine Zeile einer Glyphe: acht Bits, Bit 7 ist links. Alles ausserhalb
// von 0x20..0x7E wird zum Fragezeichen -- ein Kernel, der bei einem
// unbekannten Oktett nichts zeichnet, verliert Ausgabe still.
fn row(base: u64, ch: u64, r: u64) -> u64 {
    if r >= GLYPH_H {
        return 0
    }
    var c: u64 = ch
    if c < FIRST || c > LAST {
        c = 0x3F // '?'
    }
    return kstate.get8(base + (c - FIRST) * GLYPH_H + r)
}
