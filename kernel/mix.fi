// SPDX-License-Identifier: GPL-2.0-only
// kernel/mix.fi -- RUNDE HDA: der Mischer.
//
// Runde MEDIA1 hat in `audio.fi` ausdruecklich hingeschrieben, warum es
// ihn damals nicht gab, und der Satz ist zitierfaehig:
//
//     "EIN Nutzer zur Zeit -- kein Mischer in dieser Runde, und das ist
//     keine Auslassung, sondern eine Ansage: ein Software-Mischer ohne
//     Systembus (Block A3) waere ein zweiter Tonserver im Kernel, und
//     der gehoert nicht hierher."
//
// DIESE RUNDE HEBT DIE ANSAGE AUF, UND DIE BEFUERCHTUNG WAR TROTZDEM
// RICHTIG. Was hier steht, ist KEIN Tonserver: es gibt keine
// Wiedergabeliste, keine Geraetewahl, keine Sitzungen, keine Politik,
// wer wen leiser machen darf. Es gibt eine Tafel aus vier Stroemen,
// eine Additionsschleife mit Saettigung und einen Zaehler fuer die
// Faelle, in denen die Summe nicht mehr passt. Das ist der Teil, der
// wirklich in den Kern gehoert -- alles andere gehoert nach Ring 3,
// sobald der Systembus da ist.
//
// WARUM ES IHN GEBEN MUSS: ohne ihn belegt das ERSTE Programm, das Ton
// ausgibt, das Geraet, und jedes weitere bekommt -EBUSY. Ein System, in
// dem ein laufender Musikspieler die Systemklaenge, die Sprachausgabe
// und jeden Videoruf abschaltet, ist nicht benutzbar; ein System, in
// dem der erste Ton den zweiten unterbricht, ist es auch nicht.
//
// ==================================================================
// WIE ES RECHNET, UND WARUM GENAU SO
// ==================================================================
//
// EIN STROM ist ein Ringpuffer aus 4096 Rahmen (16 KiB, 85 ms bei
// 48 kHz), ein Schreibzeiger, den das Programm schiebt, ein Lesezeiger,
// den der Mischer schiebt, eine Lautstaerke und eine Rate.
//
// DER MISCHER nimmt so viele Rahmen, wie der SCHNELLSTE offene Strom
// hergibt (hoechstens einen Schub), addiert alle Stroeme an derselben
// Stelle und legt das Ergebnis in einen Kratzpuffer, den die
// Tonschicht in den DMA-Ring schreibt.
//
//   WARUM DER SCHNELLSTE UND NICHT DER LANGSAMSTE. Nimmt man das
//   Minimum ueber alle Stroeme, haelt ein Programm, das gerade nichts
//   schreibt, ALLE anderen an -- also genau das, was der Mischer
//   verhindern soll. Nimmt man das Maximum, wird ein Strom, der zu
//   spaet kommt, mit STILLE aufgefuellt: er hat eine Luecke, alle
//   anderen laufen weiter. Das ist die richtige Verteilung des
//   Schadens, und die Luecke wird ihm zugerechnet (`M_UNDER`) statt
//   dem Geraet.
//
// DIE ADDITION IST GESAETTIGT UND NICHT UMLAUFEND, und das ist der
// einzige Punkt dieser Datei, an dem eine falsche Zeile SOFORT
// hoerbar waere: zwei Stroeme mit je 20000 ergeben 40000, und in 16
// Bit passt das nicht. Laesst man es umlaufen, wird aus dem lautesten
// Moment der Musik ein Knall bei voller Aussteuerung mit umgekehrtem
// Vorzeichen -- das klingt wie ein zerrissener Lautsprecher. Gesaettigt
// wird daraus ein flacher Scheitel: hoerbar, aber es bleibt Musik.
//
// WARUM NICHT STATTDESSEN JEDEN STROM DURCH DIE ZAHL DER STROEME
// TEILEN, wie es manche Anleitungen sagen: weil die Lautstaerke dann
// springt, sobald ein zweiter Ton anfaengt oder aufhoert. Ein
// Systemklang wuerde die Musik halbieren, solange er dauert. Alle
// grossen Systeme (WASAPI, CoreAudio, PulseAudio) saettigen und
// ueberlassen die Aussteuerung den Programmen; diese hier zaehlt
// zusaetzlich mit, WIE OFT gesaettigt wurde -- damit "ohne
// Uebersteuerung" eine Messung ist und keine Hoffnung.
//
// DIE UMRECHNUNG DER RATE ist LINEAR und das absichtliche Minimum. Sie
// greift NUR, wenn ein Strom eine andere Rate hat als das Geraet --
// der Regelfall ist, dass das erste Programm die Geraeterate setzt und
// die anderen dieselbe nehmen. Fuer 44100 gegen 48000 liegt der Fehler
// einer linearen Umrechnung bei rund -30 dB in den oberen Oktaven; das
// ist hoerbar schlechter als ein anstaendiger Filter und um Groessen-
// ordnungen besser als Werteverdopplung, und der Filter waere eine
// eigene Runde. Es steht so im Bericht und nicht anders.
//
// WAS ES NICHT TUT: keine Effekte, keine gehoerrichtige Lautstaerke,
// kein Umwandeln von Kanalzahl oder Bittiefe (alles ist 16 Bit
// stereo), keine Aufnahme, keine Prioritaeten zwischen Stroemen.

profile kernel

import kstate
import serial
import mem
import time
import arch.arch

export {
    init, open, close, is_open, streams,
    write, space, mix_into, out_buf, avail_out, ended, mark_end, reap,
    set_volume, volume, set_muted, muted, rate_of,
    frames_written, frames_read, underruns, overflows,
    mixed, clips, pumps, peak, none,
    MAX_STREAMS, BUF_FRAMES, CHUNK_FRAMES, NONE
}

// VIER STROEME. Die Zahl ist eine Abwaegung und keine Rundung: jeder
// Strom kostet 16 KiB Ringpuffer aus dem Rahmenverwalter, also 64 KiB
// zusammen, und mehr als vier Programme, die GLEICHZEITIG Ton ausgeben,
// gibt es auf einem Schreibtischrechner praktisch nie (Musik, ein
// Video, ein Systemklang, ein Anruf). Wer den fuenften braucht, aendert
// die Zahl hier und den Platz in `kstate.MIX_OFF` -- die Additions-
// schleife rechnet ueber `MAX_STREAMS` und nicht ueber eine vierfach
// ausgeschriebene Zeile.
const MAX_STREAMS: u64 = 4
const NONE: u64 = 4 // "kein Platz frei" -- absichtlich MAX_STREAMS

// 16384 Rahmen je Strom = 64 KiB = 341 ms bei 48 kHz.
//
// WARUM GENAU SO GROSS -- und die Zahl ist zweimal geaendert worden,
// beide Male mit einer Messung dahinter.
//
// DER PUFFER IST DIE ZEIT, DIE EIN PROGRAMM WEGBLEIBEN DARF, ohne dass
// eine Luecke entsteht. Die erste Fassung nahm 4096 Rahmen (85 ms) mit
// der Begruendung: der Zeitgeber schlaegt alle 10 ms, bei vier
// laufenden Aufgaben kommt ein Programm rund 40 ms nicht dran, 85 ms
// sind gut das Doppelte.
//
// DIE RECHNUNG STIMMT FUER DEN SCHEDULER UND NICHT FUER DAS SYSTEM.
// Zwischen zwei Schueben eines Abspielers liegen nicht nur
// Zeitscheiben, sondern auch: ein `read` von der Platte (bei OFS ueber
// den Blockcache, bei einem Fehlschlag ueber den IDE-Regler), das
// Dekodieren eines MP3-Rahmens, und -- der teuerste Posten -- die
// Systemaufrufe selbst. GEMESSEN mit /bin/play auf einer Sekunde WAV:
// mit 85 ms Puffer 187 Aussetzer und 23819 aufgegebene Rahmen; die
// Datei war viereinhalb Sekunden lang statt einer.
//
// 341 ms sind der Wert, ab dem ein Abspieler dieses Systems unter
// diesen Bedingungen durchkommt. ER IST GROSSZUEGIG, und das ist der
// Handel: er kostet 64 KiB je Strom (vier Stroeme = 256 KiB) und er
// erhoeht die Verzoegerung zwischen "das Programm schreibt" und "man
// hoert es" auf bis zu 341 + 85 = 426 ms, WENN das Programm den Puffer
// wirklich vollschreibt. Fuer Wiedergabe ist das unauffaellig; fuer
// einen Tastenklick oder ein Spiel waere es zu viel -- und genau
// deshalb gibt es daneben den EINSTROMWEG (`audio.write`), der ohne
// diesen Puffer auskommt und bei 85 ms bleibt.
const BUF_FRAMES: u64 = 16384
const BUF_PAGES: u64 = 16

// WIE VIEL EIN DURCHGANG HOECHSTENS MISCHT. 256 Rahmen sind 5,33 ms --
// zwei Eintraege des Geraeterings.
//
// DIE ZAHL IST DURCH DEN PLATZ BESTIMMT, und der Platz durch die
// Rechenart: gemischt wird in einem ZWISCHENPUFFER MIT 64 BIT JE
// ABTASTWERT, nicht mit 16. Vier Stroeme zu je 32768 ergeben 131072,
// und das passt in 16 Bit nicht -- wer in 16 Bit addiert und erst am
// Ende begrenzt, hat schon vorher umlaufen lassen und begrenzt dann
// den falschen Wert. Ein Rahmen im Zwischenpuffer ist also 16 Oktette
// statt vier, und 256 Rahmen sind 4096 Oktette Zwischenpuffer plus
// 1024 Oktette Ausgabe -- zusammen 5 KiB in den 7 KiB, die die zweite
// kdata-Seite dafuer hergibt.
//
// KLEINER waere mehr Aufrufe fuer dieselbe Arbeit; GROESSER waere eine
// Schleife, die den Kernel laenger am Stueck beschaeftigt als eine
// Zeitscheibe dauert.
const CHUNK_FRAMES: u64 = 256
// Wie lange ein leerer Strom die anderen aufhalten darf.
const BLOCK_NS: u64 = 5000000
const FRAME_OCTETS: u64 = 4

// -------------------------------------------------- der Platz in kdata
//
//   kstate.MIX_OFF + 0x000  vier Stromsaetze zu 128 Oktetten
//   kstate.MIX_OFF + 0x200  die Zaehler des Mischers
//   kstate.MIX_OFF + 0x400  der Zwischenpuffer, 256 Rahmen zu 16
//                           Oktetten (zwei Kanaele zu 64 Bit)
//   kstate.MIX_OFF + 0x1400 der Ausgabepuffer, 256 Rahmen zu 4
//
// Die RINGPUFFER der Stroeme liegen NICHT hier: sie sind 16 KiB je
// Strom und kommen aus dem Rahmenverwalter, so wie der DMA-Ring der
// Treiber. In kdata waeren 64 KiB ein Viertel der ganzen Karte.
const ST_SPAN: u64 = 0x80
const G_OFF: u64 = 0x200
const ACC_OFF: u64 = 0x400
const OUT_OFF: u64 = 0x1400

const M_USED: u64 = 0x00
const M_PID: u64 = 0x08
const M_BUF: u64 = 0x10
const M_WPOS: u64 = 0x18
const M_RPOS: u64 = 0x20
const M_VOL: u64 = 0x28
const M_MUTE: u64 = 0x30
const M_RATE: u64 = 0x38
const M_UNDER: u64 = 0x40
const M_OVER: u64 = 0x48
const M_FRAC: u64 = 0x50 // Bruchteil der Umrechnung, Q32
const M_WRITES: u64 = 0x58
const M_ENDED: u64 = 0x60
const M_TFED: u64 = 0x68 // wann dieser Strom zuletzt gefuettert wurde

const G_OPEN: u64 = 0x00
const G_MIXED: u64 = 0x08
const G_CLIPS: u64 = 0x10
const G_UNDER: u64 = 0x18
const G_PUMPS: u64 = 0x20
const G_PEAK: u64 = 0x28 // groesster Betrag, der je in der Summe stand

fn sc(state: u64, i: u64, off: u64) -> u64 {
    return kstate.get(state + kstate.MIX_OFF, i * ST_SPAN + off)
}

fn ss(state: u64, i: u64, off: u64, v: u64) {
    kstate.set(state + kstate.MIX_OFF, i * ST_SPAN + off, v)
}

fn gg(state: u64, off: u64) -> u64 {
    return kstate.get(state + kstate.MIX_OFF, G_OFF + off)
}

fn gs(state: u64, off: u64, v: u64) {
    kstate.set(state + kstate.MIX_OFF, G_OFF + off, v)
}

fn acc(state: u64) -> u64 {
    return state + kstate.MIX_OFF + ACC_OFF
}

fn out_buf(state: u64) -> u64 {
    return state + kstate.MIX_OFF + OUT_OFF
}

// ====================================== die Rechnung in Zweierkomplement
//
// Firn kennt in diesem Kernel nur `u64`. Ein Abtastwert ist aber ein
// VORZEICHENBEHAFTETER 16-Bit-Wert, und die drei Zeilen unten sind die
// ganze Uebersetzung. Sie stehen hier zusammen und nicht verstreut,
// weil genau hier der Fehler entsteht, den man erst hoert und dann
// tagelang sucht: ein vergessenes Vorzeichen macht aus einem Sinus
// einen gleichgerichteten Sinus -- Runde MEDIA1 hat das schon einmal
// gemessen (FFT fand 880 Hz statt 440 Hz), und die Berichtigung war
// ein `& 1`.

// 16 Bit auf 64 erweitern, mit Vorzeichen.
fn sx(v: u64) -> u64 {
    if (v & 0x8000) != 0 {
        return v | 0xFFFFFFFFFFFF0000
    }
    return v & 0xFFFF
}

fn is_neg(x: u64) -> bool {
    return (x >> 63) != 0
}

fn mag(x: u64) -> u64 {
    if is_neg(x) {
        return 0 -% x
    }
    return x
}

// Lautstaerke in Prozent auf einen vorzeichenbehafteten Wert. Ueber den
// BETRAG gerechnet und dann das Vorzeichen zurueck -- eine Division
// eines negativen Zweierkomplementwertes durch 100 waere in `u64` eine
// Division einer riesigen positiven Zahl.
fn scale(x: u64, vol: u64) -> u64 {
    if vol >= 100 {
        return x
    }
    if vol == 0 {
        return 0
    }
    let m: u64 = (mag(x) * vol) / 100
    if is_neg(x) {
        return 0 -% m
    }
    return m
}

// Die Saettigung. Sie ZAEHLT, wenn sie greift -- eine Grenze, die
// niemand mitzaehlt, ist eine Grenze, von der man erst erfaehrt, wenn
// sich jemand ueber den Klang beschwert.
fn clamp16(state: u64, x: u64) -> u64 {
    let m: u64 = mag(x)
    if m > gg(state, G_PEAK) {
        gs(state, G_PEAK, m)
    }
    if is_neg(x) {
        if m > 32768 {
            gs(state, G_CLIPS, gg(state, G_CLIPS) +% 1)
            return 0x8000
        }
        return x & 0xFFFF
    }
    if x > 32767 {
        gs(state, G_CLIPS, gg(state, G_CLIPS) +% 1)
        return 0x7FFF
    }
    return x & 0xFFFF
}

// ============================================================ die Tafel

fn init(state: u64) {
    var i: u64 = 0
    while i < MAX_STREAMS {
        ss(state, i, M_USED, 0)
        ss(state, i, M_BUF, 0)
        ss(state, i, M_WPOS, 0)
        ss(state, i, M_RPOS, 0)
        ss(state, i, M_VOL, 100)
        ss(state, i, M_MUTE, 0)
        ss(state, i, M_RATE, 0)
        ss(state, i, M_UNDER, 0)
        ss(state, i, M_OVER, 0)
        ss(state, i, M_FRAC, 0)
        ss(state, i, M_WRITES, 0)
        ss(state, i, M_ENDED, 0)
        ss(state, i, M_TFED, 0)
        i = i + 1
    }
    gs(state, G_OPEN, 0)
    gs(state, G_MIXED, 0)
    gs(state, G_CLIPS, 0)
    gs(state, G_UNDER, 0)
    gs(state, G_PUMPS, 0)
    gs(state, G_PEAK, 0)
}

fn none() -> u64 {
    return NONE
}

fn is_open(state: u64, i: u64) -> bool {
    if i >= MAX_STREAMS {
        return false
    }
    return sc(state, i, M_USED) != 0
}

fn streams(state: u64) -> u64 {
    return gg(state, G_OPEN)
}

// Einen Strom aufmachen. Der Ringpuffer wird beim ERSTEN Mal geholt und
// danach behalten: der Rahmenverwalter gibt zusammenhaengende Laeufe
// heraus, und ein System, das bei jedem Programmstart vier Rahmen holt
// und wieder freigibt, zerlegt den Speicher mit der Zeit so weit, dass
// irgendwann keine vier zusammenhaengenden mehr da sind. Vier mal 16
// KiB, einmal geholt, ist der Preis dafuer, dass Ton auch nach einer
// Woche Laufzeit noch aufgeht.
fn open(state: u64, pid: u64, hz: u64) -> u64 {
    var i: u64 = 0
    var frei: u64 = NONE
    while i < MAX_STREAMS && frei == NONE {
        if sc(state, i, M_USED) == 0 {
            frei = i
        }
        i = i + 1
    }
    if frei == NONE {
        return NONE
    }
    if sc(state, frei, M_BUF) == 0 {
        let b: u64 = mem.frame_run(state, BUF_PAGES)
        if b == 0 {
            return NONE
        }
        ss(state, frei, M_BUF, b)
    }
    // Der Puffer wird beim Oeffnen genullt, nicht beim Schliessen: was
    // ein Programm hinterlaesst, geht das naechste nichts an, und beim
    // Schliessen genullt waere es einmal zu frueh -- der Mischer liest
    // die letzten Rahmen dann noch.
    let b: u64 = sc(state, frei, M_BUF)
    var k: u64 = 0
    while k < BUF_FRAMES * FRAME_OCTETS / 8 {
        kstate.set(b, k * 8, 0)
        k = k + 1
    }
    ss(state, frei, M_USED, 1)
    ss(state, frei, M_PID, pid)
    ss(state, frei, M_WPOS, 0)
    ss(state, frei, M_RPOS, 0)
    ss(state, frei, M_VOL, 100)
    ss(state, frei, M_MUTE, 0)
    ss(state, frei, M_RATE, hz)
    ss(state, frei, M_FRAC, 0)
    ss(state, frei, M_ENDED, 0)
    ss(state, frei, M_TFED, time.mono_ns(state))
    gs(state, G_OPEN, gg(state, G_OPEN) + 1)
    return frei
}

// Schliessen. SOFORT und nicht "wenn der Rest gespielt ist" -- ein
// Programm, das abstuerzt, soll sein Geraet loslassen, und ein
// Programm, das seinen Rest hoeren will, ruft vorher `mark_end`.
// Zusage (e) dieser Runde haengt genau daran: mitten im Lauf
// schliessen muss sauber abraeumen, nicht warten.
fn close(state: u64, i: u64) {
    if i >= MAX_STREAMS {
        return
    }
    if sc(state, i, M_USED) == 0 {
        return
    }
    ss(state, i, M_USED, 0)
    ss(state, i, M_ENDED, 0)
    ss(state, i, M_WPOS, 0)
    ss(state, i, M_RPOS, 0)
    ss(state, i, M_PID, 0)
    if gg(state, G_OPEN) > 0 {
        gs(state, G_OPEN, gg(state, G_OPEN) -% 1)
    }
}

// "Ich schreibe nichts mehr, spiel den Rest." Der Strom bleibt offen,
// bis der Mischer ihn leer gelesen hat.
fn mark_end(state: u64, i: u64) {
    if i >= MAX_STREAMS {
        return
    }
    ss(state, i, M_ENDED, 1)
}

fn ended(state: u64, i: u64) -> bool {
    if i >= MAX_STREAMS {
        return false
    }
    return sc(state, i, M_ENDED) != 0
}

fn set_volume(state: u64, i: u64, pct: u64) {
    if i >= MAX_STREAMS {
        return
    }
    var v: u64 = pct
    if v > 100 {
        v = 100
    }
    ss(state, i, M_VOL, v)
}

fn volume(state: u64, i: u64) -> u64 {
    if i >= MAX_STREAMS {
        return 0
    }
    return sc(state, i, M_VOL)
}

fn set_muted(state: u64, i: u64, on: bool) {
    if i >= MAX_STREAMS {
        return
    }
    if on {
        ss(state, i, M_MUTE, 1)
    } else {
        ss(state, i, M_MUTE, 0)
    }
}

fn muted(state: u64, i: u64) -> bool {
    if i >= MAX_STREAMS {
        return false
    }
    return sc(state, i, M_MUTE) != 0
}

fn rate_of(state: u64, i: u64) -> u64 {
    if i >= MAX_STREAMS {
        return 0
    }
    return sc(state, i, M_RATE)
}

fn frames_written(state: u64, i: u64) -> u64 {
    if i >= MAX_STREAMS {
        return 0
    }
    return sc(state, i, M_WPOS)
}

fn frames_read(state: u64, i: u64) -> u64 {
    if i >= MAX_STREAMS {
        return 0
    }
    return sc(state, i, M_RPOS)
}

fn underruns(state: u64, i: u64) -> u64 {
    if i >= MAX_STREAMS {
        return gg(state, G_UNDER)
    }
    return sc(state, i, M_UNDER)
}

fn overflows(state: u64, i: u64) -> u64 {
    if i >= MAX_STREAMS {
        return 0
    }
    return sc(state, i, M_OVER)
}

fn mixed(state: u64) -> u64 {
    return gg(state, G_MIXED)
}

fn clips(state: u64) -> u64 {
    return gg(state, G_CLIPS)
}

fn pumps(state: u64) -> u64 {
    return gg(state, G_PUMPS)
}

fn peak(state: u64) -> u64 {
    return gg(state, G_PEAK)
}

// ====================================================== schreiben

// Wie viele Rahmen jetzt in diesen Strom passen.
fn space(state: u64, i: u64) -> u64 {
    if !is_open(state, i) {
        return 0
    }
    let w: u64 = sc(state, i, M_WPOS)
    let r: u64 = sc(state, i, M_RPOS)
    var drin: u64 = 0
    if w > r {
        drin = w -% r
    }
    // EIN RAHMEN BLEIBT FREI, damit "voll" und "leer" unterscheidbar
    // bleiben und der Mischer beim Umrechnen der Rate einen Rahmen
    // VORAUS lesen kann (die lineare Umrechnung braucht s[i] UND
    // s[i+1]).
    if drin + 2 >= BUF_FRAMES {
        return 0
    }
    return BUF_FRAMES -% drin -% 2
}

// Rahmen in den Strom kopieren. Gibt zurueck, wie viele wirklich
// hineingingen -- der Aufrufer entscheidet, ob er wartet. Es wird NICHT
// gewartet und NICHT geschlafen: das gehoert in den Systemaufruf, wo es
// einen Prozess gibt, den man schlafen legen kann.
fn write(state: u64, i: u64, src: u64, frames: u64) -> u64 {
    if !is_open(state, i) {
        return 0
    }
    var n: u64 = frames
    let platz: u64 = space(state, i)
    if n > platz {
        ss(state, i, M_OVER, sc(state, i, M_OVER) +% (n -% platz))
        n = platz
    }
    if n == 0 {
        return 0
    }
    let b: u64 = sc(state, i, M_BUF)
    let w: u64 = sc(state, i, M_WPOS)
    var k: u64 = 0
    while k < n {
        let slot: u64 = (w + k) % BUF_FRAMES
        // Ein Rahmen sind vier Oktette. Er wird als EIN 32-Bit-Wort
        // kopiert und nicht als vier Oktette: der Puffer ist
        // seitenausgerichtet und der Quellpuffer ist der
        // Umsteigepuffer des Systemaufrufs, also ebenfalls -- beide
        // Adressen sind durch vier teilbar.
        let v: u64 = kstate.get32(src + k * FRAME_OCTETS)
        __mmio_write32((b + slot * FRAME_OCTETS) as *mut u32,
            (v & 0xFFFFFFFF) as u32)
        k = k + 1
    }
    ss(state, i, M_WPOS, w + n)
    ss(state, i, M_TFED, time.mono_ns(state))
    ss(state, i, M_WRITES, sc(state, i, M_WRITES) + 1)
    return n
}

// Wie viele Rahmen dieser Strom noch hergibt -- in RAHMEN DES GERAETS
// gerechnet, also nach der Umrechnung der Rate. Ein Strom mit 44100 Hz
// liefert fuer 44100 eigene Rahmen 48000 Geraeterahmen.
fn avail_out(state: u64, i: u64, dst_hz: u64) -> u64 {
    if !is_open(state, i) {
        return 0
    }
    let w: u64 = sc(state, i, M_WPOS)
    let r: u64 = sc(state, i, M_RPOS)
    if w <= r + 1 {
        return 0
    }
    // Ein Rahmen bleibt stehen: die lineare Umrechnung liest s[i+1].
    let drin: u64 = w -% r -% 1
    let hz: u64 = sc(state, i, M_RATE)
    if hz == 0 || hz == dst_hz {
        return drin
    }
    return (drin * dst_hz) / hz
}

// ============================================================ MISCHEN
//
// Der Kern der Datei. `mix_into` legt hoechstens `max_frames` fertige
// Rahmen in `out_buf(state)` und gibt zurueck, wie viele es waren.
//
// DREI DURCHGAENGE UND NICHT EINER, und das ist eine Entscheidung mit
// Grund:
//
//   1. den Zwischenpuffer nullen
//   2. JEDEN STROM EINZELN DARAUF ADDIEREN
//   3. den Zwischenpuffer EINMAL begrenzen und ausgeben
//
// Der zweite Durchgang ist der Punkt. Wuerde man aussen ueber die
// Rahmen und innen ueber die Stroeme laufen, muesste fuer JEDEN Rahmen
// jeder Strom neu nachgeschlagen werden -- Lesezeiger, Bruchteil,
// Lautstaerke, Puffer, alles aus kdata. So steht das je Strom einmal
// im Register und die innere Schleife rechnet nur noch.
//
// Der dritte Durchgang begrenzt EINMAL, nach der ganzen Summe. Wer
// nach jedem Strom begrenzt, hat aus 20000 + 20000 - 15000 nicht 25000
// gemacht, sondern 32767 - 15000 = 17767. Das ist kein Rundungsfehler,
// das ist ein anderer Klang.

fn lerp(a: u64, b: u64, f: u64) -> u64 {
    if f == 0 {
        return a
    }
    let d: u64 = b -% a
    let m: u64 = (mag(d) * f) >> 32
    if is_neg(d) {
        return a -% m
    }
    return a +% m
}

// Einen Strom auf den Zwischenpuffer addieren. Hier steht die
// Umrechnung der Rate, und hier wird ein zu spaeter Strom mit STILLE
// aufgefuellt statt alle anderen anzuhalten.
fn contribute(state: u64, j: u64, n: u64, dst_hz: u64) {
    let b: u64 = sc(state, j, M_BUF)
    if b == 0 {
        return
    }
    var vol: u64 = sc(state, j, M_VOL)
    if sc(state, j, M_MUTE) != 0 {
        vol = 0
    }
    let r: u64 = sc(state, j, M_RPOS)
    let w: u64 = sc(state, j, M_WPOS)
    var hz: u64 = sc(state, j, M_RATE)
    if hz == 0 {
        hz = dst_hz
    }
    // Der Schritt in Q32: wie viele QUELLrahmen ein ZIELrahmen kostet.
    // Bei gleicher Rate ist er genau 1.0 und die Umrechnung faellt
    // rechnerisch weg (f bleibt null, `lerp` gibt a zurueck).
    var step: u64 = 4294967296
    if hz != dst_hz {
        step = (hz * 4294967296) / dst_hz
    }
    var da: u64 = 0
    if w > r {
        da = w -% r
    }
    let a: u64 = acc(state)
    var pos: u64 = sc(state, j, M_FRAC) // Q32, Versatz ab r
    var k: u64 = 0
    var leer: bool = false
    while k < n && !leer {
        let idx: u64 = pos >> 32
        if idx + 1 >= da {
            // ZU SPAET. Der Rest dieses Durchgangs bleibt fuer diesen
            // Strom still; die anderen laufen weiter. Genau das ist
            // der Sinn des Mischers, und die Luecke wird DIESEM Strom
            // zugerechnet.
            if idx >= da || sc(state, j, M_ENDED) == 0 {
                leer = true
                ss(state, j, M_UNDER, sc(state, j, M_UNDER) +% (n -% k))
                gs(state, G_UNDER, gg(state, G_UNDER) + 1)
            }
        }
        if !leer {
            let p0: u64 = ((r + idx) % BUF_FRAMES) * FRAME_OCTETS
            var p1: u64 = ((r + idx + 1) % BUF_FRAMES) * FRAME_OCTETS
            if idx + 1 >= da {
                // Letzter Rahmen eines beendeten Stromes: nichts mehr
                // zum Hineininterpolieren, also der Wert selbst.
                p1 = p0
            }
            let f: u64 = pos & 0xFFFFFFFF
            let l0: u64 = sx(kstate.get16(b + p0))
            let r0: u64 = sx(kstate.get16(b + p0 + 2))
            let l1: u64 = sx(kstate.get16(b + p1))
            let r1: u64 = sx(kstate.get16(b + p1 + 2))
            let lv: u64 = scale(lerp(l0, l1, f), vol)
            let rv: u64 = scale(lerp(r0, r1, f), vol)
            kstate.set(a, k * 16, kstate.get(a, k * 16) +% lv)
            kstate.set(a, k * 16 + 8, kstate.get(a, k * 16 + 8) +% rv)
            pos = pos +% step
            k = k + 1
        }
    }
    let verbraucht: u64 = pos >> 32
    ss(state, j, M_RPOS, r + verbraucht)
    ss(state, j, M_FRAC, pos & 0xFFFFFFFF)
}

// WIE VIEL GEMISCHT WIRD, WENN DIE STROEME UNGLEICH SCHNELL SIND.
//
// DIE ERSTE FASSUNG NAHM IMMER DAS MAXIMUM -- "so viel, wie der
// schnellste hergibt, die anderen mit Stille". Die Begruendung dafuer
// klang gut (ein Programm, das gerade nichts schreibt, darf die
// anderen nicht anhalten) und war in der Messung ein Reinfall:
//
//   GEMESSEN mit zwei Stroemen zu je einer Sekunde: der Mischer wurde
//   nach JEDEM Schreibvorgang gerufen, also abwechselnd, wenn gerade
//   EIN Strom Daten hatte. Der andere bekam Stille. Ergebnis: 96000
//   geschriebene Rahmen ergaben 3,9 Sekunden Datei mit
//   34 Loechern -- beide Toene da, beide zerhackt.
//
// ALSO ZWEI POLITIKEN, und die Umschaltung ist eine Zahl:
//
//   IM REGELFALL DAS MINIMUM. Es wird nur gemischt, was ALLE offenen
//   Stroeme haben. Wer nichts hat, haelt die anderen kurz auf -- und
//   das ist richtig, solange im Geraetering noch Vorrat liegt.
//
//   IN DER NOTLAGE DAS MAXIMUM. Faellt der Vorrat im Geraetering
//   unter acht Eintraege (21 ms), ist Warten keine Option mehr: dann
//   wird gemischt, was da ist, und wer zu spaet kommt, bekommt eine
//   Luecke. Der Schaden trifft den, der ihn verursacht hat, statt
//   alle.
//
// Die Notlage entscheidet die Tonschicht (sie kennt den Ringvorrat)
// und gibt sie hier herein; `mix.fi` kennt den Ring nicht.
// AUFRAEUMEN: Stroeme schliessen, die zu Ende sind und leer gelesen
// wurden. EIGENE FUNKTION, und sie wird VON AUSSEN gerufen, bevor
// irgendetwas anderes passiert.
//
// GEMESSEN: sie stand zuerst IN `mix_into`, hinter dessen vorzeitigen
// Ruecksprungen -- und `mix_into` wird gar nicht erst gerufen, wenn im
// Geraetering kein Platz ist. Ein Abspieler, der am Ende auf "keine
// Stroeme mehr" wartet, wartete damit auf ein Aufraeumen, das nur
// stattfand, wenn er noch etwas zu schreiben hatte. Er drehte seine
// Warteschleife 4000 Mal leer -- viereinhalb Sekunden fuer eine
// Sekunde Ton, und dabei lief der Regler weiter und wiederholte den
// Ring.
fn reap(state: u64) {
    var i: u64 = 0
    while i < MAX_STREAMS {
        if is_open(state, i) && sc(state, i, M_ENDED) != 0 {
            if sc(state, i, M_RPOS) + 1 >= sc(state, i, M_WPOS) {
                close(state, i)
            }
        }
        i = i + 1
    }
}

fn mix_into(state: u64, max_frames: u64, dst_hz: u64, notlage: bool) -> u64 {
    var n: u64 = max_frames
    if n > CHUNK_FRAMES {
        n = CHUNK_FRAMES
    }
    if n == 0 || dst_hz == 0 {
        return 0
    }
    reap(state)
    // ZUERST AUFRAEUMEN, DANN RECHNEN. Stroeme, die zu Ende sind und
    // leer gelesen wurden, werden geschlossen -- und zwar HIER OBEN
    // und nicht unten hinter der Mischschleife.
    //
    // GEMESSEN, und es ist ein Fehler, den nur die Uhr verraet: unten
    // stand das Aufraeumen hinter den vorzeitigen Ruecksprungen. Ein
    // Mischer, der nichts mehr zu mischen hat, kehrt oben um -- und
    // kam damit nie zum Aufraeumen. Die Stroeme blieben offen, der
    // Aufrufer wartete auf "keine Stroeme mehr", und der Regler
    // spielte drei Sekunden lang Stille, die als 1063 Aussetzer
    // gezaehlt wurde. Der TON war einwandfrei; nur die Zahl daneben
    // war es nicht.
    var beste: u64 = 0
    var kleinste: u64 = 0xFFFFFFFFFFFFFFFF
    var offen: u64 = 0
    let jetzt: u64 = time.mono_ns(state)
    var i: u64 = 0
    while i < MAX_STREAMS {
        if is_open(state, i) {
            offen = offen + 1
            let av: u64 = avail_out(state, i, dst_hz)
            if av > beste {
                beste = av
            }
            // WER DARF DIE ANDEREN AUFHALTEN. Nur ein Strom, der
            // GERADE NOCH geschrieben hat. Das ist die dritte und
            // letzte Regel des Mischers, und sie ist teuer erkauft:
            //
            //   DIE MINIMUM-REGEL ALLEIN VERKLEMMT SICH. Sobald ein
            //   Programm fertig ist und nichts mehr schickt, ist sein
            //   Vorrat null, das Minimum ist null, und ALLE anderen
            //   stehen still -- bis der Geraetering so leer ist, dass
            //   die Notlage greift. Dann laeuft es kurz an und
            //   verklemmt sich wieder.
            //
            //   GEMESSEN: zwei Stroeme zu je einer Sekunde brauchten
            //   3,98 Sekunden. Der Mischer wurde 2,07 Millionen Mal
            //   gerufen und hat 609 Mal wirklich gemischt; 1,44
            //   Millionen Aufrufe fanden "das Minimum ist null" vor.
            //   Die Datei hatte 34 Loecher.
            //
            //   DIE FRIST ist fuenf Millisekunden. Sie liegt zwischen
            //   den beiden Zeiten, die hier zaehlen: eine Runde des
            //   Schreibers dauert Mikrosekunden, der Geraetering
            //   traegt 85 Millisekunden. Ein Programm, das laenger als
            //   fuenf Millisekunden nichts geschickt hat, ist entweder
            //   fertig oder zu langsam -- in beiden Faellen darf es
            //   die anderen nicht anhalten.
            let ruht: bool = (jetzt -% sc(state, i, M_TFED)) > BLOCK_NS
            if av < kleinste && !ruht && sc(state, i, M_ENDED) == 0 {
                kleinste = av
            }
        }
        i = i + 1
    }
    if !notlage && offen > 0 && kleinste < beste {
        beste = kleinste
    }
    if offen == 0 || beste == 0 {
        // KEIN STROM HAT ETWAS. Dann wird NICHTS gemischt. Wer hier
        // Stille schriebe, fuellte den Geraetering damit -- und der
        // naechste echte Rahmen waere danach einen ganzen Ring lang
        // (85 ms) nicht zu hoeren. Ein Mischer, der Stille erzeugt,
        // baut sich seine eigene Verzoegerung.
        return 0
    }
    if n > beste {
        n = beste
    }

    // 1. nullen
    let a: u64 = acc(state)
    var z: u64 = 0
    while z < n * 2 {
        kstate.set(a, z * 8, 0)
        z = z + 1
    }
    // 2. addieren
    var i2: u64 = 0
    while i2 < MAX_STREAMS {
        if is_open(state, i2) {
            contribute(state, i2, n, dst_hz)
        }
        i2 = i2 + 1
    }
    // 3. begrenzen und ausgeben
    let o: u64 = out_buf(state)
    var k: u64 = 0
    while k < n {
        let l: u64 = clamp16(state, kstate.get(a, k * 16))
        let rr: u64 = clamp16(state, kstate.get(a, k * 16 + 8))
        __mmio_write32((o + k * FRAME_OCTETS) as *mut u32,
            ((l & 0xFFFF) | ((rr & 0xFFFF) << 16)) as u32)
        k = k + 1
    }
    gs(state, G_MIXED, gg(state, G_MIXED) +% n)
    gs(state, G_PUMPS, gg(state, G_PUMPS) + 1)
    return n
}
