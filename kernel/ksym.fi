// SPDX-License-Identifier: GPL-2.0-only
// kernel/ksym.fi -- RUNDE MODUL: WAS DER KERN NACH AUSSEN ANBIETET.
//
// Ein nachgeladener Treiber ist eine Objektdatei mit LUECKEN darin: an
// jeder Stelle, an der er `k_puts` ruft, steht in seinem `.text` eine
// Null und daneben in `.rela.text` der Satz "hier gehoert die Adresse
// von `k_puts` hin". Wer diese Luecken fuellt, muss den Namen `k_puts`
// in eine Zahl uebersetzen koennen. Diese Datei ist die Uebersetzung.
//
// Sie ist damit GENAU das, was Linux `EXPORT_SYMBOL` nennt und was
// Windows als die feste Menge der `Ddi`-Aufrufe hat: nicht "alles, was
// der Kern hat", sondern eine ausdrueckliche, kurze, benannte Liste.
// Der Unterschied zwischen den beiden Haltungen ist genau der zwischen
// einem Kern, dessen Innereien Vertragsflaeche sind, und einem, dessen
// Innereien ihm gehoeren. Osum nimmt die zweite: hier stehen ZWOELF
// Namen, und alles andere ist von aussen unsichtbar.
//
// ======================================================= DIE FASSUNG
//
// `ABI` ist die Nummer dieses Vertrages. Sie steht im Kopf jedes Moduls
// und wird beim Laden verglichen; ein Modul mit einer anderen Zahl wird
// ABGEWIESEN und nicht etwa versucht. Erhoeht wird sie, sobald sich
// EINES dieser drei Dinge aendert:
//
//   1. ein Name in der Liste unten kommt weg oder bekommt eine andere
//      Signatur (ein Argument mehr, ein Rueckgabetyp anders),
//   2. die Platznummern in `kernel/modidx.fi` verschieben sich,
//   3. die Bedeutung des `state`-Bereichs an einer Stelle, die ein
//      Modul anfasst.
//
// Ein NEUER Name allein erhoeht sie NICHT: ein altes Modul, das ihn
// nicht kennt, laeuft weiter. Das ist dieselbe Regel wie bei WDDM, wo
// ein Treiber fuer 2.0 unter einem Windows mit 3.1 laeuft, solange die
// alten Aufrufe stehen -- und es ist der ganze Grund, warum es
// Herstellertreiber ueberhaupt geben kann.
//
// ====================================== WIE MAN IN FIRN AN EINE ADRESSE
//                                        EINER FUNKTION KOMMT
//
// Firn hat keinen Ausdruck, der eine Funktion in eine Zahl wandelt --
// `vfs.fi` sagt das in seinem Kommentar ausdruecklich, und es stimmt
// weiter. Was es hat, seit Runde 58/68, ist der FUNKTIONSWERT in einem
// Strukturfeld (`Ops { lookup: p_lookup }` in `procfs.fi`). Und ein
// Strukturfeld liegt im Speicher.
//
// Nachgesehen im erzeugten Assembler (beide Uebersetzer, `--emit=asm`):
//
//     lea rax, [rip + .L__fnv._F0.serial__puts]
//     ...
//     .section .rodata
//     .L__fnv._F0.serial__puts:
//         .quad _F0.serial__puts
//
// Ein Funktionswert ist also NICHT die Adresse der Funktion, sondern die
// Adresse einer ZELLE in `.rodata`, in der die Adresse steht. Zweimal
// auflesen gibt die Zahl. Genau das tut `zelle` unten, und deshalb steht
// hier keine Assemblerzeile und kein `--defsym` im Bauskript: derselbe
// Quelltext gilt fuer firnc0 (`_F0.`) und firnc1 (`_F1.`), weil der
// Name nirgends aufgeschrieben ist.
//
// Gemessen ist das mit `tools/modul/run.sh`, Abschnitt 2: die Zahl, die
// hier herauskommt, ist dieselbe, die `nm` im gebundenen Kernabbild fuer
// das Symbol nennt.
//
// ============================================ WAS ABSICHTLICH FEHLT
//
// Kein `kalloc`, kein `frame_alloc`, kein `fs.`-Aufruf, nichts aus
// `proc.fi` oder `sched.fi`. Ein Treibermodul, das Speicher zuteilen
// oder Prozesse anlegen kann, ist kein Treiber mehr. Was ein Treiber
// braucht, ist: etwas sagen koennen, den Zustandsbereich lesen und
// schreiben, seine Adressen eintragen -- und die Fassung erfragen, damit
// er sich SELBST abweisen kann, bevor der Lader es tut.

profile kernel

import kstate
import serial
import modtab

export { ABI, such, anzahl, name_at, adresse_at, gleich }

// Die Fassung des Vertrages. Siehe oben, wann sie steigt.
const ABI: u64 = 1

// Wie viele Namen die Liste hat. Steht getrennt, weil `tools/modul/run.sh`
// gegen die Zahl prueft, dass die Liste unten vollstaendig durchlaufen
// wird -- eine Liste, deren Ende man vergisst, faellt sonst nicht auf.
const N_SYM: u64 = 13

// -------------------------------------------------- die Adressenzelle

// Die zwei Strukturformen, die es fuer die zwoelf Namen braucht. Der
// Feldtyp muss auf die Signatur passen; sonst nimmt der Uebersetzer den
// Funktionswert nicht an -- was gut ist, denn eine falsche Signatur in
// dieser Tafel waere ein Sprung mit falschen Registern.
struct F_1v { f: fn(u64) }
struct F_1u { f: fn(u64) -> u64 }
struct F_2u { f: fn(u64, u64) -> u64 }
struct F_2v { f: fn(u64, u64) }
struct F_3v { f: fn(u64, u64, u64) }
struct F_4u { f: fn(u64, u64, u64, u64) -> u64 }
struct F_0u { f: fn() -> u64 }
struct F_0v { f: fn() }

// Zweimal auflesen: `p` zeigt auf das Feld, im Feld steht die Adresse
// der Zelle, in der Zelle steht die Funktion. Siehe den Kopf.
fn zelle(p: u64) -> u64 {
    let d: u64 = __mmio_read64(p as *mut u64)
    if d == 0 {
        return 0
    }
    return __mmio_read64(d as *mut u64)
}

// ------------------------------------------------- die zwoelf Namen
//
// Jeder Name kommt zweimal vor: einmal als Zeichenkette in `such` und
// einmal als Nummer in `adresse_at`. Das ist Absicht -- `such` ist der
// Weg beim Laden (Name -> Zahl), `adresse_at` der Weg beim Auflisten
// (Nummer -> Zahl), und beide muessen dieselbe Zahl liefern.
// `tools/modul/run.sh` Abschnitt 2 haelt sie gegeneinander.

const S_PUTS: u64 = 0
const S_PUTC: u64 = 1
const S_DEC: u64 = 2
const S_HEX: u64 = 3
const S_NL: u64 = 4
const S_TEXT: u64 = 5
const S_GET: u64 = 6
const S_SET: u64 = 7
const S_GET8: u64 = 8
const S_SET8: u64 = 9
const S_BIND: u64 = 10
const S_ABI: u64 = 11
// `kdata` ist KEIN Dienst, sondern die Adresse des Datenbereichs selbst.
// Sie steht hier, weil `kernel/arch/machine.fi` sie mit
// `asm("lea rax, [rip + kdata]")` holt und ein Modul, das diese Datei
// mituebersetzt, damit ein undefiniertes DATENSYMBOL bekommt. Ein Lader,
// der nur Funktionen aufloest, scheiterte daran -- und es ist genau der
// Fall, den Linux mit `EXPORT_SYMBOL` auf Variablen ebenfalls hat.
const S_KDATA: u64 = 12

fn anzahl() -> u64 {
    return N_SYM
}

// Die Fassung als Funktion -- das Modul ruft sie als erstes und weist
// sich selbst ab, wenn die Zahl nicht die ist, gegen die es uebersetzt
// wurde. Zwei Riegel an derselben Tuer, absichtlich: der Lader prueft
// den Kopf der Datei, das Modul prueft den laufenden Kern.
fn abi_wert() -> u64 {
    return ABI
}

// Ein u8 schreiben, aber mit der Signatur, die ein Modul erwartet
// (`fn(u64, u64)`) -- `kstate.set8` nimmt ein `u8`, und ein Funktionswert
// muss auf das Feld passen.
fn set8_u64(p: u64, v: u64) {
    kstate.set8(p, (v & 0xFF) as u8)
}

fn putc_u64(c: u64) {
    serial.put((c & 0xFF) as u8)
}

fn adresse_at(i: u64) -> u64 {
    if i == S_PUTS {
        var t: F_1v = F_1v { f: serial.puts }
        return zelle((&t) as u64)
    }
    if i == S_PUTC {
        var t: F_1v = F_1v { f: putc_u64 }
        return zelle((&t) as u64)
    }
    if i == S_DEC {
        var t: F_1v = F_1v { f: serial.dec }
        return zelle((&t) as u64)
    }
    if i == S_HEX {
        var t: F_1v = F_1v { f: serial.hex }
        return zelle((&t) as u64)
    }
    if i == S_NL {
        var t: F_0v = F_0v { f: serial.nl }
        return zelle((&t) as u64)
    }
    if i == S_TEXT {
        var t: F_2v = F_2v { f: serial.text }
        return zelle((&t) as u64)
    }
    if i == S_GET {
        var t: F_2u = F_2u { f: kstate.get }
        return zelle((&t) as u64)
    }
    if i == S_SET {
        var t: F_3v = F_3v { f: kstate.set }
        return zelle((&t) as u64)
    }
    if i == S_GET8 {
        var t: F_1u = F_1u { f: kstate.get8 }
        return zelle((&t) as u64)
    }
    if i == S_SET8 {
        var t: F_2v = F_2v { f: set8_u64 }
        return zelle((&t) as u64)
    }
    if i == S_BIND {
        var t: F_4u = F_4u { f: modtab.bind }
        return zelle((&t) as u64)
    }
    if i == S_ABI {
        var t: F_0u = F_0u { f: abi_wert }
        return zelle((&t) as u64)
    }
    if i == S_KDATA {
        return kstate_basis()
    }
    return 0
}

// Der Name des i-ten Eintrags, AUF DIE SERIELLE LEITUNG. Kein Zeiger
// zurueck: ein `var`-Feld stirbt mit seinem Rahmen, und dieser
// Uebersetzer sagt das seit Runde 79 auch (`the address of the local
// escapes through the return value`).
fn name_at(i: u64) {
    var n0: [u8; 7] = "k_puts\0"
    var n1: [u8; 7] = "k_putc\0"
    var n2: [u8; 6] = "k_dec\0"
    var n3: [u8; 6] = "k_hex\0"
    var n4: [u8; 5] = "k_nl\0"
    var n5: [u8; 7] = "k_text\0"
    var n6: [u8; 6] = "k_get\0"
    var n7: [u8; 6] = "k_set\0"
    var n8: [u8; 7] = "k_get8\0"
    var n9: [u8; 7] = "k_set8\0"
    var n10: [u8; 7] = "k_bind\0"
    var n11: [u8; 6] = "k_abi\0"
    var n12: [u8; 6] = "kdata\0"
    if i == S_KDATA { serial.puts((&n12[0]) as u64) ; return }
    if i == S_PUTS { serial.puts((&n0[0]) as u64) ; return }
    if i == S_PUTC { serial.puts((&n1[0]) as u64) ; return }
    if i == S_DEC { serial.puts((&n2[0]) as u64) ; return }
    if i == S_HEX { serial.puts((&n3[0]) as u64) ; return }
    if i == S_NL { serial.puts((&n4[0]) as u64) ; return }
    if i == S_TEXT { serial.puts((&n5[0]) as u64) ; return }
    if i == S_GET { serial.puts((&n6[0]) as u64) ; return }
    if i == S_SET { serial.puts((&n7[0]) as u64) ; return }
    if i == S_GET8 { serial.puts((&n8[0]) as u64) ; return }
    if i == S_SET8 { serial.puts((&n9[0]) as u64) ; return }
    if i == S_BIND { serial.puts((&n10[0]) as u64) ; return }
    if i == S_ABI { serial.puts((&n11[0]) as u64) ; return }
}

// Zwei nullbeendete Namen vergleichen. Die Laenge ist gedeckelt, damit
// ein Modul mit einer Zeichenkettentafel ohne Null nicht ins Nirgendwo
// liest -- ein Name laenger als 63 Oktette ist keiner.
fn gleich(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while i < 64 {
        let x: u64 = kstate.get8(a + i)
        let y: u64 = kstate.get8(b + i)
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

// DER WEG BEIM LADEN: ein Name aus der Zeichenkettentafel des Moduls,
// heraus kommt eine Adresse oder eine Null. Eine Null heisst NICHT
// "nichts tun", sondern "dieses Modul wird abgewiesen" -- `modul.fi`
// macht daraus den Grund R_SYM.
//
// `osum_panic` steht mit in der Liste, obwohl es kein Dienst ist, den
// jemand absichtlich ruft: der Uebersetzer legt es unter `profile
// kernel` bei JEDER gepruefen Rechnung selbst dazu (SPEC Abschnitt 2).
// Ein Modul ohne diesen Namen gibt es nicht, und ein Kern, der ihn nicht
// anbietet, koennte kein einziges Modul laden.
fn such(name: u64) -> u64 {
    var np: [u8; 11] = "osum_panic\0"
    if gleich(name, (&np[0]) as u64) {
        return panik_adresse()
    }
    var i: u64 = 0
    while i < N_SYM {
        if such_ist(name, i) {
            return adresse_at(i)
        }
        i = i + 1
    }
    return 0
}

fn such_ist(name: u64, i: u64) -> bool {
    var n0: [u8; 7] = "k_puts\0"
    var n1: [u8; 7] = "k_putc\0"
    var n2: [u8; 6] = "k_dec\0"
    var n3: [u8; 6] = "k_hex\0"
    var n4: [u8; 5] = "k_nl\0"
    var n5: [u8; 7] = "k_text\0"
    var n6: [u8; 6] = "k_get\0"
    var n7: [u8; 6] = "k_set\0"
    var n8: [u8; 7] = "k_get8\0"
    var n9: [u8; 7] = "k_set8\0"
    var n10: [u8; 7] = "k_bind\0"
    var n11: [u8; 6] = "k_abi\0"
    var n12: [u8; 6] = "kdata\0"
    if i == S_KDATA { return gleich(name, (&n12[0]) as u64) }
    if i == S_PUTS { return gleich(name, (&n0[0]) as u64) }
    if i == S_PUTC { return gleich(name, (&n1[0]) as u64) }
    if i == S_DEC { return gleich(name, (&n2[0]) as u64) }
    if i == S_HEX { return gleich(name, (&n3[0]) as u64) }
    if i == S_NL { return gleich(name, (&n4[0]) as u64) }
    if i == S_TEXT { return gleich(name, (&n5[0]) as u64) }
    if i == S_GET { return gleich(name, (&n6[0]) as u64) }
    if i == S_SET { return gleich(name, (&n7[0]) as u64) }
    if i == S_GET8 { return gleich(name, (&n8[0]) as u64) }
    if i == S_SET8 { return gleich(name, (&n9[0]) as u64) }
    if i == S_BIND { return gleich(name, (&n10[0]) as u64) }
    if i == S_ABI { return gleich(name, (&n11[0]) as u64) }
    return false
}

// `osum_panic` liegt in `kernel/arch/x86_64/isr.s` und ist damit KEINE
// Firn-Funktion -- der Kniff mit dem Funktionswert greift dort nicht.
// Der Weg dorthin ist der, den `msr.fi` fuer die Faengertabelle geht:
// `boot.s` legt eine Tafel von Adressen an (`vectors`), der Kern
// bekommt sie beim Start und `kstate.VECTORS` zeigt darauf.
const V_PANIC: u64 = 73

fn panik_adresse() -> u64 {
    let v: u64 = kstate.get(kstate_basis(), kstate.VECTORS)
    if v == 0 {
        return 0
    }
    return __mmio_read64((v + V_PANIC * 8) as *mut u64)
}

// Die Datenregion, ohne sie durchgereicht zu bekommen. `fb.fi` macht es
// seit Runde K7B genauso und aus demselben Grund: `such` wird aus einer
// Schleife heraus gerufen, die den Zeiger nicht hat.
fn kstate_basis() -> u64 {
    return asm("lea rax, [rip + kdata]", out("rax"))
}
