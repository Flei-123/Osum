// SPDX-License-Identifier: GPL-2.0-only
// kernel/ahci.fi -- RUNDE AHCI: die Platte, die ein ECHTER PC hat.
//
// ==================================================================
// WARUM ES DIESE DATEI GIBT
// ==================================================================
//
// Bis zu dieser Runde kannte der Kern drei Wege zu einem Blockgeraet:
//
//   * ATA PIO ueber die Ports 0x1F0..0x1F7 (`blk.fi`, DEV_ATA). Er
//     funktioniert und ist ehrlich darueber, was er kostet -- 256 mal
//     `in ax, dx` je Block. Er funktioniert aber NUR, wenn der Rechner
//     dem Betriebssystem ein IDE-Geraet vorspielt.
//   * NVMe (`nvme.fi`, DEV_NVME). Das ist die Platte von 2015 aufwaerts,
//     per M.2, und der Kern spricht sie ueber DMA an.
//   * virtio-blk (`virtio.fi`). Das gibt es nur in einer Maschine, die
//     virtio hat, also nur in QEMU.
//
// Was in dieser Liste FEHLT, ist der haeufigste Fall auf einem echten
// PC von 2010 bis heute: eine SATA-SSD oder SATA-Platte an einem
// Controller im NATIVEN AHCI-Modus. Kein PIO-Port, kein NVMe, kein
// virtio. Osum haette auf so einem Rechner keine Platte gefunden --
// kein Start, keine Installation. Das ist der Grund fuer diese Datei
// und sie ist genau so gemessen worden, wie das Projekt misst: gegen
// QEMU mit `-device ahci`, unter KVM, mit Gegenprobe.
//
// ==================================================================
// WIE AHCI ARBEITET, UND WORIN ES SICH VON NVMe UNTERSCHEIDET
// ==================================================================
//
// Beides sind DMA-Controller: der Kern legt einen Befehl in gewoehnlichen
// Speicher, klingelt an einem Register, und der Controller holt sich den
// Befehl und die Daten SELBST. Der Unterschied liegt darin, WAS in dem
// Befehl steht.
//
//   NVMe hat eine EIGENE Befehlsmenge (opcode 0x02 = read) und EINE
//   Warteschlange je Richtung.
//
//   AHCI ist ein TRANSPORT und keine Befehlsmenge. Was der Controller
//   ausliefert, ist ein FIS -- ein "Frame Information Structure", also
//   das, was frueher ueber das SATA-Kabel ging. Der Inhalt eines
//   H2D-Register-FIS ist Wort fuer Wort dasselbe ATA-Kommando, das
//   `blk.fi` seit Runde 62 ueber die Ports schreibt: 0x25 ist READ DMA
//   EXT, 0x35 ist WRITE DMA EXT, das Laufwerksregister traegt 0x40 fuer
//   LBA. Der Unterschied ist NUR, wer die Oktette bewegt.
//
// Deshalb ist dieser Treiber der zweite Beweis fuer dieselbe Zusage wie
// Runde K2, nur andersherum: dort waren es zwei Protokolle ueber
// denselben Bus, hier ist es DASSELBE Protokoll ueber zwei Buse.
//
// Die Strukturen im Speicher, die ein AHCI-Controller selbst liest:
//
//   BEFEHLSLISTE (command list), 32 Kopfsaetze zu 32 Oktetten, auf
//   1024 ausgerichtet. Ein Kopfsatz sagt: wie lang das Befehls-FIS ist,
//   ob geschrieben wird, wie viele PRDT-Eintraege folgen, und WO die
//   Befehlstafel liegt.
//   FIS-EMPFANGSBEREICH (FIS receive area), 256 Oktette, auf 256
//   ausgerichtet. Dorthin legt der Controller, was das Laufwerk
//   ZURUECKSCHICKT.
//   BEFEHLSTAFEL (command table), auf 128 ausgerichtet: die ersten 64
//   Oktette das H2D-FIS, ab Oktett 0x80 die PRDT -- die Liste der
//   Speicherbereiche, in die der Controller die Daten legen soll.
//
// ==================================================================
// WARUM DIESER TREIBER MIT ABFRAGE ARBEITET UND NICHT MIT UNTERBRECHUNG
// ==================================================================
//
// `nvme.fi` hat beide Wege und misst den Unterschied, weil das der
// Gegenstand von Runde K2 war. Hier ist der Gegenstand ein anderer: dass
// auf einem echten PC ueberhaupt eine Platte gefunden wird. Der Treiber
// wartet deshalb auf PxCI -- das Bit, das der Controller selbst
// zurueckstellt, wenn er fertig ist.
//
// Das ist keine Notloesung, sondern die richtige Wahl an dieser Stelle,
// und der Grund steht in `nvme.await`: `fs.fi` haelt ueber eine ganze
// Blockoperation die Unterbrechungen AUS (`sched.irq_save`, sechs
// Stellen). Ein Treiber, der darin auf eine Unterbrechung wartet,
// wartet auf etwas, das nicht kommen kann. NVMe braucht deshalb ohnehin
// einen Abfragepfad; AHCI hat hier nur diesen einen, und die Daten
// bewegt der Controller in beiden Faellen selbst.
//
// Was dabei NICHT behauptet wird: dass dieser Treiber die volle
// Leistung eines AHCI-Controllers holt. Er benutzt EINEN Befehlsplatz
// von 32 und wartet nach jedem Befehl. Eine Warteschlange (NCQ) waere
// der naechste Schritt und ist hier nicht gebaut.
//
// ==================================================================
// DER FALL, IN DEM DAS ALLES NICHT GILT: IDE-KOMPATIBILITAET
// ==================================================================
//
// Viele Firmware-Menues haben einen Punkt "SATA Mode" mit den Werten
// AHCI, RAID und IDE/Legacy/Compatibility. Steht er auf IDE, MELDET SICH
// DERSELBE CHIP MIT EINER ANDEREN PCI-KLASSE: 01:01 (IDE) statt 01:06:01
// (SATA/AHCI), und die AHCI-Register sind gar nicht da.
//
// Ein Treiber, der dann einfach nichts findet, laesst den Benutzer im
// Dunkeln. Dieser hier sucht in dem Fall NOCH EINMAL nach der IDE-Klasse
// und meldet `mode=ide` -- eine Aussage, aus der hervorgeht, was zu tun
// ist (Firmware auf AHCI stellen), statt stumm zu scheitern.
//
// UND IN GENAU DIESEM FALL IST OSUM NICHT VERLOREN: `blk.fi` spricht
// seit Runde 62 ATA PIO ueber 0x1F0, und ein Controller im IDE-Modus
// ist genau das. Der Rueckfallweg ist also vorhanden, ist langsam, und
// steht in `docs/REALHW.md`.

import serial
import kstate
import pci
import arch.x86_64.apic

export {
    init, present, ide_mode, read_block, write_block, read_many,
    write_many, flush, blocks, block_shift, bdf, port, mode,
    ports_seen, cmds, errs, last_tfd, buffer, ident, sig, slots, why,
    MODE_NONE, MODE_AHCI, MODE_IDE
}

// ------------------------------------------------ der Platz in `kdata`
//
// 0x7A000 aufwaerts ist der Bereich, den `kstate.fi` als frei ausweist
// (bis KDATA_SIZE 0x80000). Fuenf Seiten, und die Ausrichtungen, die der
// Controller verlangt, fallen dabei von selbst ab: eine Seitengrenze ist
// auf 1024, auf 256 und auf 128 ausgerichtet.
//
//   AHCI_OFF + 0x000  die Befehlsliste, 32 * 32 = 1024 Oktette
//   AHCI_OFF + 0x400  der FIS-Empfangsbereich, 256 Oktette
//   AHCI_OFF + 0x800  die Befehlstafel: 128 Oktette Kopf, dann die PRDT
const AHCI_OFF: u64 = 0x7A000
const AHCI_ID_OFF: u64 = 0x7B000 // was IDENTIFY DEVICE liefert
const AHCI_BUFA_OFF: u64 = 0x7C000 // Messpuffer A
const AHCI_BUFB_OFF: u64 = 0x7D000 // Messpuffer B
const AHCI_SC_OFF: u64 = 0x7E000 // die Zaehler dieser Runde

const CLB_AT: u64 = 0x000
const FB_AT: u64 = 0x400
const CT_AT: u64 = 0x800
const CT_PRDT: u64 = 0x80 // die PRDT beginnt im Befehlstafelkopf bei 0x80
const PRDT_MAX: u64 = 8 // 8 * 4 KiB = 32 KiB in einem Befehl

// Skalare, Versaetze in AHCI_SC_OFF.
const S_ABAR: u64 = 0x00
const S_BDF: u64 = 0x08
const S_IDX: u64 = 0x10
const S_PORT: u64 = 0x18
const S_READY: u64 = 0x20
const S_BLOCKS: u64 = 0x28
const S_LBASZ: u64 = 0x30
const S_MODE: u64 = 0x38
const S_PI: u64 = 0x40
const S_SEEN: u64 = 0x48
const S_SLOTS: u64 = 0x50
const S_ERRS: u64 = 0x58
const S_CMDS: u64 = 0x60
const S_TFD: u64 = 0x68
const S_S64A: u64 = 0x70
const S_SIG: u64 = 0x78
const S_WHY: u64 = 0x80 // an welcher Stelle die Inbetriebnahme aufgab
const S_QUIET: u64 = 0x88 // wie viele fremde Ports wieder stillgelegt wurden

// --------------------------------------------------- die HBA-Register

const R_CAP: u64 = 0x00
const R_GHC: u64 = 0x04
const R_IS: u64 = 0x08
const R_PI: u64 = 0x0C
const R_VS: u64 = 0x10
const R_CAP2: u64 = 0x24
const R_BOHC: u64 = 0x28

const GHC_HR: u64 = 1 // HBA reset
const GHC_IE: u64 = 2
const GHC_AE: u64 = 0x80000000 // AHCI enable

const CAP_S64A: u64 = 0x80000000
const CAP2_BOH: u64 = 1 // BIOS/OS handoff vorhanden

const BOHC_BOS: u64 = 1
const BOHC_OOS: u64 = 2
const BOHC_BB: u64 = 0x10

// Ein Port liegt bei 0x100 + n * 0x80.
const PORT_BASE: u64 = 0x100
const PORT_SIZE: u64 = 0x80

const P_CLB: u64 = 0x00
const P_CLBU: u64 = 0x04
const P_FB: u64 = 0x08
const P_FBU: u64 = 0x0C
const P_IS: u64 = 0x10
const P_IE: u64 = 0x14
const P_CMD: u64 = 0x18
const P_TFD: u64 = 0x20
const P_SIG: u64 = 0x24
const P_SSTS: u64 = 0x28
const P_SCTL: u64 = 0x2C
const P_SERR: u64 = 0x30
const P_CI: u64 = 0x38

const CMD_ST: u64 = 0x0001 // start
const CMD_SUD: u64 = 0x0002 // spin up device
const CMD_POD: u64 = 0x0004 // power on device
const CMD_FRE: u64 = 0x0010 // FIS receive enable
const CMD_FR: u64 = 0x4000 // FIS receive running
const CMD_CR: u64 = 0x8000 // command list running

const IS_TFES: u64 = 0x40000000 // task file error

const TFD_ERR: u64 = 0x01
const TFD_DRQ: u64 = 0x08
const TFD_BSY: u64 = 0x80

// Was in PxSSTS steht: DET in den unteren vier Bit, IPM in Bit 8..11.
const DET_PRESENT: u64 = 3 // Geraet da und Verbindung steht
const IPM_ACTIVE: u64 = 1

// Die Kennung, mit der sich ein Geraet meldet.
const SIG_ATA: u64 = 0x00000101
const SIG_ATAPI: u64 = 0xEB140101
const SIG_SEMB: u64 = 0xC33C0101
const SIG_PM: u64 = 0x96690101

// ATA, dieselben Zahlen wie in `blk.fi` -- das ist der ganze Punkt.
const ATA_IDENTIFY: u64 = 0xEC
const ATA_READ_DMA_EXT: u64 = 0x25
const ATA_WRITE_DMA_EXT: u64 = 0x35
const ATA_FLUSH_EXT: u64 = 0xEA

const FIS_H2D: u64 = 0x27

const SECTOR: u64 = 512
const PAGE: u64 = 4096

// Wie lange gewartet wird, bevor ein Geraet fuer tot erklaert wird.
// Absichtlich begrenzt: ein Controller, der nie antwortet, darf den Kern
// nicht anhalten. Genau dieselbe Regel wie in `nvme.fi`.
const SPIN_LIMIT: u64 = 4000000
const RESET_LIMIT: u64 = 2000000

const MODE_NONE: u64 = 0
const MODE_AHCI: u64 = 1
const MODE_IDE: u64 = 2

// ------------------------------------------------------ kleine Helfer

fn sc(off: u64) -> u64 {
    return AHCI_SC_OFF + off
}

fn abar(state: u64) -> u64 {
    return kstate.get(state, sc(S_ABAR))
}

fn bdf(state: u64) -> u64 {
    return kstate.get(state, sc(S_BDF))
}

fn port(state: u64) -> u64 {
    return kstate.get(state, sc(S_PORT))
}

fn mode(state: u64) -> u64 {
    return kstate.get(state, sc(S_MODE))
}

fn blocks(state: u64) -> u64 {
    return kstate.get(state, sc(S_BLOCKS))
}

fn block_shift(state: u64) -> u64 {
    return kstate.get(state, sc(S_LBASZ))
}

fn ports_seen(state: u64) -> u64 {
    return kstate.get(state, sc(S_SEEN))
}

fn slots(state: u64) -> u64 {
    return kstate.get(state, sc(S_SLOTS))
}

fn cmds(state: u64) -> u64 {
    return kstate.get(state, sc(S_CMDS))
}

fn errs(state: u64) -> u64 {
    return kstate.get(state, sc(S_ERRS))
}

fn last_tfd(state: u64) -> u64 {
    return kstate.get(state, sc(S_TFD))
}

fn why(state: u64) -> u64 {
    return kstate.get(state, sc(S_WHY))
}

fn sig(state: u64) -> u64 {
    return kstate.get(state, sc(S_SIG))
}

fn ready(state: u64) -> bool {
    return kstate.get(state, sc(S_READY)) != 0
}

fn ident(state: u64) -> u64 {
    return state + AHCI_ID_OFF
}

fn buffer(state: u64, which: u64) -> u64 {
    if which == 1 {
        return state + AHCI_BUFB_OFF
    }
    return state + AHCI_BUFA_OFF
}

fn rd32(b: u64, off: u64) -> u64 {
    return __mmio_read32((b + off) as *mut u32) as u64
}

fn wr32(b: u64, off: u64, v: u64) {
    __mmio_write32((b + off) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn pr(state: u64) -> u64 {
    return abar(state) + PORT_BASE + port(state) * PORT_SIZE
}

fn prd(state: u64, p: u64, off: u64) -> u64 {
    return rd32(abar(state) + PORT_BASE + p * PORT_SIZE, off)
}

fn pwr(state: u64, p: u64, off: u64, v: u64) {
    wr32(abar(state) + PORT_BASE + p * PORT_SIZE, off, v)
}

// Speicher, den der Controller liest, wird durch die fluechtigen
// Intrinsics geschrieben -- derselbe Grund wie in `nvme.fi`: er ist der
// zweite Leser dieser Oktette, und der Uebersetzer darf einen Schreibzug
// dorthin weder zusammenlegen noch verschieben noch weglassen.
fn m8(p: u64, v: u64) {
    __mmio_write8(p as *mut u8, (v & 0xFF) as u8)
}

fn m32(p: u64, v: u64) {
    __mmio_write32(p as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn r8(p: u64) -> u64 {
    return __mmio_read8(p as *mut u8) as u64
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n / 8 {
        __mmio_write64((p + i * 8) as *mut u64, 0)
        i = i + 1
    }
}

// ----------------------------------------------------- ist ueberhaupt was da

// Ein AHCI-Controller meldet sich als Klasse 01, Unterklasse 06,
// Programmierschnittstelle 01. Genau die drei Zahlen fragt `pci.fi` ab --
// und dass diese Suche nicht aus einer Tabelle im Kern kommt, sondern aus
// dem Konfigurationsraum des Geraetes, ist seit Runde K2 gemessen.
fn present(state: u64) -> bool {
    return pci.find_class(state, pci.CLASS_STORAGE, pci.SUB_SATA,
        pci.PROGIF_AHCI) < pci.MAX_DEV
}

// DER FALL, IN DEM DIE FIRMWARE AUF IDE STEHT. Dann ist der AHCI-Chip
// nicht verschwunden -- er meldet sich mit Klasse 01, Unterklasse 01.
// Diese Funktion sagt das, statt `present` einfach falsch zurueckgeben zu
// lassen; die Meldung ist der Unterschied zwischen "keine Platte" und
// "die Firmware steht falsch".
fn ide_mode(state: u64) -> bool {
    if present(state) {
        return false
    }
    return pci.find_class(state, pci.CLASS_STORAGE, pci.SUB_IDE,
        0x100) < pci.MAX_DEV
}

// ------------------------------------------------------------ Inbetriebnahme

fn init(state: u64) -> bool {
    kstate.set(state, sc(S_READY), 0)
    kstate.set(state, sc(S_MODE), MODE_NONE)
    kstate.set(state, sc(S_ERRS), 0)
    kstate.set(state, sc(S_CMDS), 0)
    kstate.set(state, sc(S_SEEN), 0)
    kstate.set(state, sc(S_WHY), 0)

    let idx: u64 = pci.find_class(state, pci.CLASS_STORAGE, pci.SUB_SATA,
        pci.PROGIF_AHCI)
    if idx >= pci.MAX_DEV {
        if ide_mode(state) {
            kstate.set(state, sc(S_MODE), MODE_IDE)
        }
        kstate.set(state, sc(S_WHY), 1)
        return false
    }

    // ABAR IST BAR5, NICHT BAR0. Das ist der Unterschied, an dem ein aus
    // `nvme.fi` abgeschriebener Treiber sofort scheitert: NVMe hat genau
    // ein Speicherfenster und es ist das erste. AHCI traegt darunter noch
    // die vier alten IDE-Portpaare und ein Busmaster-Portfenster; das
    // Register, um das es geht, ist das sechste.
    let phys: u64 = pci.bar(state, idx, 5)
    if phys == 0 || pci.bar_is_io(state, idx, 5) {
        kstate.set(state, sc(S_WHY), 2)
        return false
    }
    let b: u64 = apic.map_device(state, phys)
    if b == 0 {
        kstate.set(state, sc(S_WHY), 3)
        return false
    }
    kstate.set(state, sc(S_IDX), idx)
    kstate.set(state, sc(S_ABAR), b)
    kstate.set(state, sc(S_BDF), pci.get(state, idx, pci.E_BDF))
    kstate.set(state, sc(S_MODE), MODE_AHCI)

    let cap: u64 = rd32(b, R_CAP)
    if cap == 0 || cap == 0xFFFFFFFF {
        kstate.set(state, sc(S_WHY), 4)
        return false
    }
    kstate.set(state, sc(S_SLOTS), ((cap >> 8) & 0x1F) + 1)
    kstate.set(state, sc(S_S64A), (cap & CAP_S64A) >> 31)

    // OHNE DIESE ZEILE ANTWORTET DER CONTROLLER AUF REGISTER UND HOLT SICH
    // TROTZDEM NICHTS AUS DEM SPEICHER. Dieselbe eine Zeile wie in
    // `nvme.init`, und derselbe Fehler, wenn sie fehlt.
    pci.enable_master(bdf(state))

    if !handoff(state, b) {
        kstate.set(state, sc(S_WHY), 5)
        return false
    }

    // AE ZUERST. Ein Controller, der noch im alten Modus laeuft, nimmt
    // die AHCI-Register gar nicht an; die Norm verlangt AE = 1, bevor
    // irgendein anderes Register dieser Datei geschrieben wird.
    wr32(b, R_GHC, rd32(b, R_GHC) | GHC_AE)

    if !hba_reset(state, b) {
        kstate.set(state, sc(S_WHY), 6)
        return false
    }

    let pi: u64 = rd32(b, R_PI)
    kstate.set(state, sc(S_PI), pi)
    if pi == 0 {
        kstate.set(state, sc(S_WHY), 7)
        return false
    }

    let p: u64 = find_disk(state, pi)
    if p >= 32 {
        kstate.set(state, sc(S_WHY), 8)
        return false
    }
    kstate.set(state, sc(S_PORT), p)

    if !port_setup(state, p) {
        kstate.set(state, sc(S_WHY), 9)
        return false
    }
    if !identify(state) {
        kstate.set(state, sc(S_WHY), 10)
        return false
    }
    kstate.set(state, sc(S_READY), 1)
    return true
}

// DIE UEBERGABE VON DER FIRMWARE. Ein UEFI, das den Controller selbst
// benutzt hat (und jedes tut das, es hat von dort gebootet), haelt ihn
// unter Umstaenden noch. CAP2.BOH sagt, ob dieser Controller die
// Uebergabe ueberhaupt kennt; wo er sie nicht kennt, gibt es nichts zu
// tun und die Funktion sagt ja.
//
// Unter QEMU ist CAP2.BOH null und dieser ganze Block ist ein
// Durchlauf. Er steht hier fuer den 30.08., nicht fuer die Abnahme --
// und das ist genau die Sorte Zeile, von der man erst auf echter
// Hardware erfaehrt, dass sie gefehlt hat.
fn handoff(state: u64, b: u64) -> bool {
    let cap2: u64 = rd32(b, R_CAP2)
    if (cap2 & CAP2_BOH) == 0 {
        return true
    }
    wr32(b, R_BOHC, rd32(b, R_BOHC) | BOHC_OOS)
    var spin: u64 = 0
    while spin < RESET_LIMIT {
        let v: u64 = rd32(b, R_BOHC)
        if (v & BOHC_BOS) == 0 && (v & BOHC_BB) == 0 {
            return true
        }
        spin = spin + 1
    }
    // Die Firmware gibt nicht her. Weitermachen waere ein Griff in
    // fremden Besitz -- also nein, und der Aufrufer meldet es.
    return false
}

fn hba_reset(state: u64, b: u64) -> bool {
    wr32(b, R_GHC, rd32(b, R_GHC) | GHC_HR)
    // HR ist das einzige Bit in diesem Kern, das die HARDWARE
    // zurueckstellt und nicht der Kern. Solange es steht, laeuft der
    // Reset; bleibt es stehen, ist der Controller hin.
    var spin: u64 = 0
    while spin < RESET_LIMIT {
        if (rd32(b, R_GHC) & GHC_HR) == 0 {
            wr32(b, R_GHC, rd32(b, R_GHC) | GHC_AE)
            return true
        }
        spin = spin + 1
    }
    return false
}

// ==================================================================
// WELCHER PORT TRAEGT EINE PLATTE -- UND WARUM DAS NICHT EINE ZEILE IST
// ==================================================================
//
// PI sagt, welche Ports der Chip ueberhaupt HAT. Das ist auf echter
// Hardware fast nie 1 und fast nie zusammenhaengend: eine Platte an
// Port 2, waehrend 0 und 1 leer sind, ist der Normalfall. Wer
// stattdessen Port 0 nimmt, findet auf so einem Rechner nichts.
//
// DIE ERSTE FASSUNG DIESER FUNKTION HAT GENAU DAS GETAN, WAS NAHELIEGT:
// PxSSTS lesen, PxSIG lesen, fertig. Sie hat unter QEMU mit einer
// angehaengten Platte NICHTS gefunden (`why=8`), und der Grund ist
// lehrreich genug, um hier zu stehen:
//
//   1. NACH DEM HBA-RESET STEHT DIE VERBINDUNG NICHT SOFORT. DET in
//      PxSSTS ist erst 1 ("Geraet da, Verbindung noch nicht") und wird
//      3 ("Verbindung steht"), wenn die beiden Enden sich geeinigt
//      haben. Das dauert. Ein Blick reicht nicht, es muss gewartet
//      werden.
//   2. PxSIG IST KEIN REGISTER, DAS DER CONTROLLER VON SICH AUS FUELLT.
//      Dort steht, was das LAUFWERK in seinem ersten D2H-Register-FIS
//      geschickt hat -- und ein FIS EMPFANGEN kann der Port erst, wenn
//      der FIS-Empfangsbereich eingetragen und FRE gesetzt ist. Vorher
//      liest PxSIG 0xFFFFFFFF oder eine Null, und beide sind keine
//      Kennung.
//
// Deshalb richtet diese Funktion JEDEN in Frage kommenden Port so weit
// ein, dass er antworten KANN, bevor sie ihn fragt. Erst danach ist die
// Kennung eine Aussage.
fn find_disk(state: u64, pi: u64) -> u64 {
    let cl: u64 = state + AHCI_OFF + CLB_AT
    let fis: u64 = state + AHCI_OFF + FB_AT
    var seen: u64 = 0
    var found: u64 = 32
    var i: u64 = 0
    while i < 32 {
        if ((pi >> i) & 1) != 0 && found >= 32 {
            zero(cl, 1024)
            zero(fis, 256)
            if port_arm(state, i, cl, fis) {
                if link_up(state, i) {
                    seen = seen + 1
                    let s: u64 = prd(state, i, P_SIG)
                    kstate.set(state, sc(S_SIG), s)
                    // Nur eine PLATTE. Ein ATAPI-Laufwerk spricht SCSI
                    // in ATA-Verpackung, ein Port-Multiplier ist gar
                    // kein Geraet -- beide antworten auf READ DMA EXT
                    // nicht, und ein Treiber, der sie nimmt, laeuft in
                    // seine Zeitschranke, statt eine Platte zu finden.
                    if s == SIG_ATA {
                        found = i
                    }
                }
            }
        }
        i = i + 1
    }
    kstate.set(state, sc(S_SEEN), seen)
    return found
}

// Einen Port so weit herrichten, dass er ein FIS empfangen kann: alles
// anhalten, die beiden Speicheradressen eintragen, alte Fehler wegraeumen,
// Strom und Anlauf anfordern, FIS-Empfang an. ST bleibt AUS -- es soll
// noch kein Befehl laufen.
//
// DIE REIHENFOLGE IST NICHT GESCHMACKSSACHE: ein Port, der noch laeuft
// (CR oder FR), ignoriert jede Adresse, die man in PxCLB oder PxFB
// schreibt -- der Controller hat sie sich beim Anfahren gemerkt. Wer die
// Adressen im Laufen schreibt, sieht keinen Fehler und der Controller
// legt seine FIS weiter dorthin, wo der Vorbesitzer sie haben wollte.
fn port_arm(state: u64, p: u64, cl: u64, fis: u64) -> bool {
    if !port_stop(state, p) {
        return false
    }
    // Der Controller liest den BUS, nicht die Seitentabelle. In diesem
    // Kern sind die beiden Zahlen dieselbe, weil `boot.s` das erste
    // Gigabyte auf sich selbst abbildet; in einem Kern mit hoher Haelfte
    // waeren sie es nicht, und das ist die Zeile, an der so ein Treiber
    // bricht. Derselbe Satz steht in `nvme.command`.
    pwr(state, p, P_CLB, cl & 0xFFFFFFFF)
    pwr(state, p, P_CLBU, cl >> 32)
    pwr(state, p, P_FB, fis & 0xFFFFFFFF)
    pwr(state, p, P_FBU, fis >> 32)
    // Alte Fehler wegraeumen: SERR wird durch ZURUECKSCHREIBEN geloescht,
    // nicht durch eine Null. Wer eine Null hineinschreibt, loescht nichts
    // und bekommt beim ersten Befehl den Fehler des Vorbesitzers.
    pwr(state, p, P_SERR, prd(state, p, P_SERR))
    pwr(state, p, P_IS, prd(state, p, P_IS))
    // Keine Unterbrechungen: dieser Treiber fragt ab (siehe Kopf).
    pwr(state, p, P_IE, 0)
    pwr(state, p, P_CMD, prd(state, p, P_CMD) | CMD_SUD | CMD_POD)
    pwr(state, p, P_CMD, prd(state, p, P_CMD) | CMD_FRE)
    var spin: u64 = 0
    while spin < RESET_LIMIT {
        if (prd(state, p, P_CMD) & CMD_FR) != 0 {
            return true
        }
        spin = spin + 1
    }
    return false
}

// Warten, bis die Verbindung steht UND das Laufwerk sich gemeldet hat.
// Zwei Bedingungen, und beide werden gebraucht: DET == 3 sagt, dass die
// physikalische Verbindung ausgehandelt ist; eine gueltige Kennung sagt,
// dass darueber schon ein FIS gekommen ist. Ein Port ohne Geraet
// erreicht keine von beiden und faellt nach der Schranke durch, statt
// den Kern anzuhalten.
fn link_up(state: u64, p: u64) -> bool {
    var spin: u64 = 0
    var linked: bool = false
    while spin < RESET_LIMIT {
        let ssts: u64 = prd(state, p, P_SSTS)
        if (ssts & 0xF) == DET_PRESENT && ((ssts >> 8) & 0xF) == IPM_ACTIVE {
            linked = true
            spin = RESET_LIMIT
        } else {
            spin = spin + 1
        }
    }
    if !linked {
        return false
    }
    spin = 0
    while spin < RESET_LIMIT {
        let s: u64 = prd(state, p, P_SIG)
        if s != 0 && s != 0xFFFFFFFF {
            // Und nicht mehr beschaeftigt: solange BSY oder DRQ steht,
            // ist das Laufwerk mit seinem eigenen Anlauf befasst und
            // nimmt keinen Befehl an.
            return await_idle(state, p)
        }
        spin = spin + 1
    }
    return false
}

// Den Port anhalten, die beiden Speicherbereiche eintragen, wieder
// anfahren. DIE REIHENFOLGE IST NICHT GESCHMACKSSACHE: ein Port, der
// noch laeuft (CR oder FR), ignoriert jede Adresse, die man in PxCLB
// oder PxFB schreibt -- der Controller hat sie sich beim Anfahren
// gemerkt. Ein Treiber, der die Adressen im Laufen schreibt, sieht
// hinterher keinen Fehler und liest in fremden Speicher.
fn port_setup(state: u64, p: u64) -> bool {
    // ERST DIE ANDEREN WIEDER STILLLEGEN. `find_disk` hat jedem Port,
    // den es gefragt hat, DENSELBEN FIS-Empfangsbereich eingetragen und
    // FRE gesetzt -- anders war die Kennung nicht zu bekommen. Bliebe
    // das so, legte ein zweites Laufwerk am selben Controller seine FIS
    // in genau die 256 Oktette, aus denen dieser Treiber die Antworten
    // des ersten liest. Das ist die Sorte Fehler, die unter QEMU mit
    // einer Platte nie auftritt und auf einem PC mit zwei SATA-Geraeten
    // sofort.
    let pi: u64 = kstate.get(state, sc(S_PI))
    var quiet: u64 = 0
    var i: u64 = 0
    while i < 32 {
        if i != p && ((pi >> i) & 1) != 0 {
            if port_stop(state, i) {
                quiet = quiet + 1
            }
        }
        i = i + 1
    }
    kstate.set(state, sc(S_QUIET), quiet)

    let cl: u64 = state + AHCI_OFF + CLB_AT
    let fis: u64 = state + AHCI_OFF + FB_AT
    zero(state + AHCI_OFF + CT_AT, 1024)
    if !port_arm(state, p, cl, fis) {
        return false
    }
    // ST ZULETZT. Der Controller darf erst Befehle abarbeiten, wenn er
    // weiss, wo die Befehlsliste steht und wohin die Antwort soll.
    pwr(state, p, P_CMD, prd(state, p, P_CMD) | CMD_ST)
    return await_idle(state, p)
}

fn port_stop(state: u64, p: u64) -> bool {
    pwr(state, p, P_CMD, prd(state, p, P_CMD) & (~CMD_ST))
    var spin: u64 = 0
    while spin < RESET_LIMIT {
        if (prd(state, p, P_CMD) & CMD_CR) == 0 {
            spin = RESET_LIMIT + 1
        } else {
            spin = spin + 1
        }
    }
    if spin == RESET_LIMIT {
        return false
    }
    pwr(state, p, P_CMD, prd(state, p, P_CMD) & (~CMD_FRE))
    spin = 0
    while spin < RESET_LIMIT {
        if (prd(state, p, P_CMD) & CMD_FR) == 0 {
            return true
        }
        spin = spin + 1
    }
    return false
}

fn await_idle(state: u64, p: u64) -> bool {
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        let tfd: u64 = prd(state, p, P_TFD)
        if (tfd & (TFD_BSY | TFD_DRQ)) == 0 {
            return true
        }
        spin = spin + 1
    }
    kstate.set(state, sc(S_TFD), prd(state, p, P_TFD))
    return false
}

// -------------------------------------------------------- ein Befehl

// Das H2D-Register-FIS, Oktett fuer Oktett. Es ist DASSELBE, was
// `blk.ata_select_on` in die Ports 0x1F2..0x1F6 schreibt -- nur dass es
// hier im Speicher steht und der Controller es abholt.
//
//   0   0x27          Art: Host an Geraet
//   1   0x80          das C-Bit: dies ist ein BEFEHL, keine Registerablage
//   2   Befehl        0x25, 0x35, 0xEC, 0xEA
//   3   Features
//   4-6 LBA 0..2
//   7   Laufwerk      0x40 = LBA statt CHS
//   8-10 LBA 3..5     das, was LBA48 von LBA28 unterscheidet
//   12-13 Zahl der Sektoren
fn build_fis(ct: u64, cmd: u64, lba: u64, count: u64) {
    var i: u64 = 0
    while i < 64 {
        m8(ct + i, 0)
        i = i + 1
    }
    m8(ct + 0, FIS_H2D)
    m8(ct + 1, 0x80)
    m8(ct + 2, cmd)
    m8(ct + 3, 0)
    m8(ct + 4, lba)
    m8(ct + 5, lba >> 8)
    m8(ct + 6, lba >> 16)
    m8(ct + 7, 0x40)
    m8(ct + 8, lba >> 24)
    m8(ct + 9, lba >> 32)
    m8(ct + 10, lba >> 40)
    m8(ct + 11, 0)
    m8(ct + 12, count)
    m8(ct + 13, count >> 8)
    m8(ct + 15, 0)
}

// Ein Kopfsatz der Befehlsliste, Platz 0. Vier Woerter:
//   DW0  Laenge des FIS in DWORDs (5), W = schreiben, PRDTL oben
//   DW1  wie viele Oktette der Controller wirklich bewegt hat -- er
//        schreibt das selbst hinein, und `run` liest es zurueck
//   DW2/3 wo die Befehlstafel liegt
fn build_hdr(cl: u64, ct: u64, write: bool, prdtl: u64) {
    var dw0: u64 = 5 | (prdtl << 16)
    if write {
        dw0 = dw0 | 0x40
    }
    m32(cl + 0, dw0)
    m32(cl + 4, 0)
    m32(cl + 8, ct & 0xFFFFFFFF)
    m32(cl + 12, ct >> 32)
    m32(cl + 16, 0)
    m32(cl + 20, 0)
    m32(cl + 24, 0)
    m32(cl + 28, 0)
}

// DIE PRDT. Ein Eintrag deckt einen zusammenhaengenden Bereich ab, und
// die Laenge steht dort als LAENGE MINUS EINS -- eine Null bedeutet ein
// Oktett, nicht keines. Das ist die Stelle, an der ein Treiber genau
// einen Sektor zu wenig liest und es nicht merkt, solange er nur je
// einen Sektor liest.
//
// Aufgeteilt wird an SEITENGRENZEN, obwohl ein PRD-Eintrag bis 4 MiB
// darf: dieser Kern bildet das erste Gigabyte flach ab, aber ein Puffer
// aus dem Rahmenverwalter ist nicht zwingend zusammenhaengend. Wer die
// ganze Laenge in einen Eintrag schreibt, gewinnt nichts und verliert
// diese Zusage.
fn build_prdt(ct: u64, addr: u64, len: u64) -> u64 {
    var n: u64 = 0
    var a: u64 = addr
    var rest: u64 = len
    while rest > 0 && n < PRDT_MAX {
        var chunk: u64 = PAGE - (a & (PAGE - 1))
        if chunk > rest {
            chunk = rest
        }
        let e: u64 = ct + CT_PRDT + n * 16
        m32(e + 0, a & 0xFFFFFFFF)
        m32(e + 4, a >> 32)
        m32(e + 8, 0)
        m32(e + 12, chunk - 1) // Laenge minus eins, ohne Unterbrechungsbit
        a = a + chunk
        rest = rest - chunk
        n = n + 1
    }
    if rest > 0 {
        return 0
    }
    return n
}

fn run(state: u64, cmd: u64, lba: u64, count: u64, addr: u64, len: u64,
    write: bool) -> bool {
    if mode(state) != MODE_AHCI {
        return false
    }
    let p: u64 = port(state)
    let cl: u64 = state + AHCI_OFF + CLB_AT
    let ct: u64 = state + AHCI_OFF + CT_AT

    if !await_idle(state, p) {
        kstate.add(state, sc(S_ERRS), 1)
        return false
    }

    var prdtl: u64 = 0
    if len > 0 {
        prdtl = build_prdt(ct, addr, len)
        if prdtl == 0 {
            return false
        }
    }
    build_hdr(cl, ct, write, prdtl)
    build_fis(ct, cmd, lba, count)

    // Alte Meldungen weg, sonst liest die Schleife unten den Fehler des
    // vorigen Befehls.
    pwr(state, p, P_IS, prd(state, p, P_IS))
    pwr(state, p, P_SERR, prd(state, p, P_SERR))

    // Und das ist die Klingel: ein einziges gesetztes Bit in PxCI. Ab
    // hier holt sich der Controller den Kopfsatz, die Befehlstafel und
    // die Daten selbst -- der Prozessor bewegt kein Oktett mehr.
    pwr(state, p, P_CI, 1)
    kstate.add(state, sc(S_CMDS), 1)

    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        if (prd(state, p, P_CI) & 1) == 0 {
            let tfd: u64 = prd(state, p, P_TFD)
            kstate.set(state, sc(S_TFD), tfd)
            if (tfd & TFD_ERR) != 0 {
                kstate.add(state, sc(S_ERRS), 1)
                return false
            }
            return true
        }
        // TFES: der Controller haengt das Bit hin, wenn das LAUFWERK
        // einen Fehler gemeldet hat. PxCI bleibt dann unter Umstaenden
        // stehen, und eine Schleife, die nur PxCI liest, wartet die
        // vollen vier Millionen Runden auf etwas, das nicht mehr kommt.
        if (prd(state, p, P_IS) & IS_TFES) != 0 {
            kstate.set(state, sc(S_TFD), prd(state, p, P_TFD))
            kstate.add(state, sc(S_ERRS), 1)
            recover(state, p)
            return false
        }
        spin = spin + 1
    }
    kstate.set(state, sc(S_TFD), prd(state, p, P_TFD))
    kstate.add(state, sc(S_ERRS), 1)
    recover(state, p)
    return false
}

// Nach einem Fehler steht die Befehlsmaschine des Ports. Sie faehrt nur
// wieder an, wenn ST einmal aus und wieder ein war -- dieselbe Regel wie
// `blk.ata_recover` fuer die Portfassung, aus demselben Grund: ein
// stehen gelassener Port laesst jeden folgenden Befehl in die
// Zeitschranke laufen, und dann sieht es aus, als sei die Platte weg.
fn recover(state: u64, p: u64) {
    pwr(state, p, P_CMD, prd(state, p, P_CMD) & (~CMD_ST))
    var spin: u64 = 0
    while spin < RESET_LIMIT {
        if (prd(state, p, P_CMD) & CMD_CR) == 0 {
            spin = RESET_LIMIT
        } else {
            spin = spin + 1
        }
    }
    pwr(state, p, P_SERR, prd(state, p, P_SERR))
    pwr(state, p, P_IS, prd(state, p, P_IS))
    pwr(state, p, P_CMD, prd(state, p, P_CMD) | CMD_ST)
}

// ------------------------------------------------------------ IDENTIFY

// Wie gross die Platte ist und wie gross ein Sektor. Beides kommt aus dem
// GERAET; ein Treiber, der 512 annimmt, laeuft, bis er eine Platte mit
// 4096 trifft. Die Antwort sind 512 Oktette, also 256 Woerter, und die
// Zaehlung in der ATA-Norm ist in WOERTERN:
//
//   Wort 60/61    Sektoren in LBA28 (nur bis 128 GiB)
//   Wort 83 Bit 10 ob das Laufwerk LBA48 kann
//   Wort 100..103 Sektoren in LBA48
//   Wort 106      ob Wort 117/118 gilt
//   Wort 117/118  Oktette je logischem Sektor, in Woertern
fn identify(state: u64) -> bool {
    let buf: u64 = state + AHCI_ID_OFF
    zero(buf, 512)
    if !run(state, ATA_IDENTIFY, 0, 0, buf, 512, false) {
        return false
    }
    let w83: u64 = w(buf, 83)
    var n: u64 = 0
    if (w83 & 0x400) != 0 {
        n = w(buf, 100) | (w(buf, 101) << 16) | (w(buf, 102) << 32)
            | (w(buf, 103) << 48)
    }
    if n == 0 {
        n = w(buf, 60) | (w(buf, 61) << 16)
    }
    if n == 0 {
        return false
    }
    var shift: u64 = 9
    let w106: u64 = w(buf, 106)
    if (w106 & 0x4000) != 0 && (w106 & 0x8000) == 0 && (w106 & 0x1000) != 0 {
        let words: u64 = w(buf, 117) | (w(buf, 118) << 16)
        // Aus der Zahl der Woerter je Sektor die Verschiebung: 256
        // Woerter sind 512 Oktette, also 9.
        var sz: u64 = words * 2
        var s: u64 = 0
        while sz > 1 {
            sz = sz >> 1
            s = s + 1
        }
        if s >= 9 && s <= 16 {
            shift = s
        }
    }
    kstate.set(state, sc(S_BLOCKS), n)
    kstate.set(state, sc(S_LBASZ), shift)
    return true
}

fn w(buf: u64, i: u64) -> u64 {
    return r8(buf + i * 2) | (r8(buf + i * 2 + 1) << 8)
}

// ------------------------------------------------------- die Uebertragungen

// Genau das, was `blk.fi` verlangt: Block n, 512 Oktette, sonst nichts.
fn read_block(state: u64, lba: u64, dst: u64) -> bool {
    if !ready(state) {
        return false
    }
    return run(state, ATA_READ_DMA_EXT, lba, 1, dst, SECTOR, false)
}

fn write_block(state: u64, lba: u64, src: u64) -> bool {
    if !ready(state) {
        return false
    }
    if !run(state, ATA_WRITE_DMA_EXT, lba, 1, src, SECTOR, true) {
        return false
    }
    return flush(state)
}

// MEHRERE SEKTOREN IN EINEM BEFEHL. Das Dateisystem braucht es nicht --
// es ist die Zahl, die zeigt, was die Schnittstelle je Block kostet, und
// es ist das, was ein wirklicher Treiber tut. Bis PRDT_MAX Seiten, also
// 32 KiB; darueber gibt die Funktion nein statt still weniger zu lesen.
fn read_many(state: u64, lba: u64, count: u64, dst: u64) -> bool {
    if !ready(state) || count == 0 {
        return false
    }
    if count * SECTOR > PRDT_MAX * PAGE {
        return false
    }
    return run(state, ATA_READ_DMA_EXT, lba, count, dst, count * SECTOR,
        false)
}

fn write_many(state: u64, lba: u64, count: u64, src: u64) -> bool {
    if !ready(state) || count == 0 {
        return false
    }
    if count * SECTOR > PRDT_MAX * PAGE {
        return false
    }
    if !run(state, ATA_WRITE_DMA_EXT, lba, count, src, count * SECTOR,
        true) {
        return false
    }
    return flush(state)
}

// FLUSH CACHE EXT, und der ist hier nicht kosmetisch: eine SATA-Platte
// bestaetigt einen Schreibbefehl, sobald sie ihn in ihrem eigenen
// Zwischenspeicher hat. Ohne diesen Befehl steht nach einem
// Stromausfall auf der Platte, was vor dem Schreiben dort stand -- und
// `tools/ahci/run.sh` liest das Abbild HINTERHER auf dem Wirt, was
// genau diesen Unterschied sichtbar machen wuerde.
fn flush(state: u64) -> bool {
    if mode(state) != MODE_AHCI {
        return false
    }
    return run(state, ATA_FLUSH_EXT, 0, 0, 0, 0, false)
}
