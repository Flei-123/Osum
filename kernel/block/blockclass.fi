profile kernel

import block.blk

export { BlockOps, null_ops, CAP_FLUSH, CAP_REMOVABLE, CAP_NS }

const CAP_FLUSH: u64 = 1
const CAP_REMOVABLE: u64 = 2
const CAP_NS: u64 = 4

struct BlockOps {
    init: fn(u64, u64) -> bool,
    present: fn(u64, u64) -> bool,
    blocks: fn(u64, u64) -> u64,
    bsize: fn(u64, u64) -> u64,
    flush: fn(u64, u64) -> bool,
    dev: u64,
    caps: u64,
    tag: u64
}

fn n_bool(state: u64, i: u64) -> bool {
    return false
}

fn n_true(state: u64, i: u64) -> bool {
    return true
}

fn n_num(state: u64, i: u64) -> u64 {
    return 0
}

fn n_bsize(state: u64, i: u64) -> u64 {
    return blk.BLOCK_SIZE
}

fn null_ops() -> BlockOps {
    return BlockOps {
        init: n_bool,
        present: n_bool,
        blocks: n_num,
        bsize: n_bsize,
        flush: n_true,
        dev: blk.DEV_RAM,
        caps: 0,
        tag: 0
    }
}
