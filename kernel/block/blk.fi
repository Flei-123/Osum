// SPDX-License-Identifier: GPL-2.0-only
// kernel/blk.fi -- round 62: the block device.
//
// A file system does not talk to memory, it talks to BLOCKS. This file is
// the whole interface between the two: read block n, write block n, 512
// octets each, and nothing else. That the blocks currently lie in RAM is
// the business of this file alone -- `fs.fi` never learns it.
//
// Three devices:
//
//   0  THE RAM DISK. A run of frames out of the frame allocator, one
//      megabyte by default. Reading and writing is a copy; there is
//      nothing to wait for.
//   1  THE REAL DISK, over ATA PIO. The same 512 octets, but through four
//      ports and a status register that has to be waited on. Whoever can
//      read a block over PIO can read a disk -- and `fs.fi` does not have
//      to change a line for it, which is exactly the point of the
//      interface.
//   2  ROUND K2: THE SAME 512 OCTETS OVER DMA (`nvme.fi`). The kernel
//      writes a command into a queue in memory and rings a doorbell; the
//      controller fetches the command itself, moves the data itself and
//      says so with an interrupt. `fs.fi` does not learn that either --
//      the whole file system runs on it without a line changed, and
//      `tools/pci/run.sh` runs the same file system test on all three
//      devices to prove exactly that.
//
// The counter-check for the interface is in `tools/kernel/run.sh`: the
// SAME file system test runs once on the RAM disk and once on a real
// image that QEMU hands in as `-drive`, and afterwards the image on the
// host has the file in it. A file system that only ever wrote to memory
// would fail the second run.

import serial
import lib.kstate
import fs.mnt
import block.wlock
import diag.devwait
import diag.cmdopt
import drv.blk.nvme
import drv.blk.ahci
import block.blkguard
import block.blkperf
import block.blkstat
import block.blkindex
import arch.arch
import block.mscbind
import crypto.cryptstate
import crypto.cryptbind
import mm.mmframe
import bus.pci
import bus.drvreg

export {
    dev_flushes,
    ram_init, use_ata, use_nvme, read, write, blocks, present,
    read_raw, read_stream, read_stream_span, S_SECTORS, S_SECTORS_WIDE, write_raw, write_run, wb_begin, wb_begin_data, wb_struct, wb_struct_lazy, wb_mark_freed, wb_freed_pending, wb_set_meta, wb_due, wb_release, wb_end, wb_flush,
    BLOCK_SIZE, DEV_RAM, DEV_ATA, DEV_NVME, DEV_ATA1, DEV_USB,
    removable,
    // ---- Runde K14 ----
    read_on, read_mounted, write_on, blocks_on, present_on, probe_ata1, dev_name,
    // ---- Runde OFS3 ----
    capacity,
    // ---- RUNDE INSTALL ----
    use_at, first, identify, probe_ata0, flush, flush_on,
    // ---- RUNDE AHCI ----
    use_ahci, DEV_AHCI, ahci_up, ahci_ready, nvme_up,
    DEV_USB0, DEV_USB1, DEV_USB2, DEV_USB3, MAX_USB,
    is_usb, usb_slot, usb_dev,
    // ---- RUNDE VIELKERN 3 ----
    ata_error, ata_last_lba, ata_last_status
    ,
    // ---- RUNDE TON: der Vorauslesepuffer ----
    cache_invalidate, cache_hits, cache_misses, cache_cmds, cache_reset,
    cache_runs,
    reads, writes
}

const BLOCK_SIZE: u64 = 512
const DEV_RAM: u64 = 0
const DEV_ATA: u64 = 1
const DEV_NVME: u64 = 2
const DEV_ATA1: u64 = 3

const DEV_USB: u64 = 4

const DEV_AHCI: u64 = 5

const DEV_USB0: u64 = 4
const DEV_USB1: u64 = 6
const DEV_USB2: u64 = 7
const DEV_USB3: u64 = 8
const MAX_USB: u64 = 4

fn is_usb(dev: u64) -> bool {
    return dev == DEV_USB0 || (dev >= DEV_USB1 && dev <= DEV_USB3)
}

fn usb_slot(dev: u64) -> u64 {
    if dev == DEV_USB0 {
        return 0
    }
    if dev >= DEV_USB1 && dev <= DEV_USB3 {
        return dev - DEV_USB1 + 1
    }
    return MAX_USB
}

fn usb_dev(slot: u64) -> u64 {
    if slot == 0 {
        return DEV_USB0
    }
    if slot < MAX_USB {
        return DEV_USB1 + slot - 1
    }
    return DEV_USB0
}

// ------------------------------------------------------------- the RAM

fn ram_init(state: u64, base: u64, blocks_n: u64) {
    kstate.set(state, kstate.DISK, base)
    kstate.set(state, kstate.DISK_BLOCKS, blocks_n)
    kstate.set(state, kstate.DISK_DEV, DEV_RAM)
    wlock.set_root(DEV_RAM)
    kstate.set(state, kstate.DISK_FIRST, 0)
}

// From here on the same file system writes to a real disk. Nothing else
// changes -- that is what the interface is for.
fn use_ata(state: u64, blocks_n: u64) {
    kstate.set(state, kstate.DISK, 0)
    kstate.set(state, kstate.DISK_BLOCKS, blocks_n)
    kstate.set(state, kstate.DISK_DEV, DEV_ATA)
    wlock.set_root(DEV_ATA)
    kstate.set(state, kstate.DISK_FIRST, 0)
}

// ================================================== RUNDE INSTALL
fn use_at(state: u64, dev: u64, first_n: u64, blocks_n: u64) {
    kstate.set(state, kstate.DISK, 0)
    kstate.set(state, kstate.DISK_BLOCKS, blocks_n)
    kstate.set(state, kstate.DISK_DEV, dev)
    wlock.set_root(dev)
    kstate.set(state, kstate.DISK_FIRST, first_n)
}

fn first(state: u64) -> u64 {
    return kstate.get(state, kstate.DISK_FIRST)
}

// Round K2. The third device, and the interface does not widen by a
// single argument for it.
fn use_nvme(state: u64, blocks_n: u64) {
    kstate.set(state, kstate.DISK, 0)
    kstate.set(state, kstate.DISK_BLOCKS, blocks_n)
    kstate.set(state, kstate.DISK_DEV, DEV_NVME)
    wlock.set_root(DEV_NVME)
    kstate.set(state, kstate.DISK_FIRST, 0)
}

fn use_ahci(state: u64, blocks_n: u64) {
    kstate.set(state, kstate.DISK, 0)
    kstate.set(state, kstate.DISK_BLOCKS, blocks_n)
    kstate.set(state, kstate.DISK_DEV, DEV_AHCI)
    wlock.set_root(DEV_AHCI)
    kstate.set(state, kstate.DISK_FIRST, 0)
}

fn blocks(state: u64) -> u64 {
    return kstate.get(state, kstate.DISK_BLOCKS)
}

// Bring the AHCI disk up on demand (/dev/sda). Booted from a USB stick
// with `modfs`, nobody initialises the SATA controller -- rootsel only
// probes it when the root lives there. The installer needs it as a
// TARGET (Dell 9020: SATA in AHCI mode, nothing at the legacy 0x1F0
// ports, so /dev/hda is empty). Tried once; a controller that failed
// is not hammered with timeouts on every lookup.
fn ahci_ready(state: u64) -> bool {
    return ahci.blocks(state) != 0
}

static mut AHCI_TRIED: bool = false
fn ahci_up(state: u64) -> bool {
    if ahci.blocks(state) != 0 {
        return true
    }
    if AHCI_TRIED {
        return false
    }
    AHCI_TRIED = true
    if !ahci.present(state) {
        return false
    }
    return ahci.init(state)
}

// r343: the NVMe drive on demand, the same way (`nvme: skipped` otherwise
// without the `nvme` word on the command line). Tried once.
static mut NVME_TRIED: bool = false
fn nvme_up(state: u64) -> bool {
    if nvme.blocks(state) != 0 {
        return true
    }
    if NVME_TRIED {
        return false
    }
    NVME_TRIED = true
    if !nvme.present(state) {
        return false
    }
    return nvme.init(state, true, true)
}

fn copy(from: u64, to: u64) {
    arch.copy_words(to, from, BLOCK_SIZE / 8)
}

// --------------------------------------------------------------- ATA

// The primary bus, master drive. The ports are the ones every PC has had
// since 1986; QEMU speaks them because everything speaks them.
const ATA_DATA: u16 = 0x1F0
const ATA_ERROR: u16 = 0x1F1
const ATA_COUNT: u16 = 0x1F2
const ATA_LBA0: u16 = 0x1F3
const ATA_LBA1: u16 = 0x1F4
const ATA_LBA2: u16 = 0x1F5
const ATA_DRIVE: u16 = 0x1F6
const ATA_CMD: u16 = 0x1F7 // write: command, read: status
const ATA_CTRL: u16 = 0x3F6

const ATA_READ: u8 = 0x20
const ATA_WRITE: u8 = 0x30
const ATA_FLUSH: u8 = 0xE7
const ATA_SET_MULTIPLE: u8 = 0xC6
const ATA_WRITE_MULTIPLE: u8 = 0xC5
const ATA_IDENTIFY: u8 = 0xEC

const ST_BSY: u64 = 0x80
const ST_DRQ: u64 = 0x08
const ST_ERR: u64 = 0x01

// ROUND OSUM-ARM2: through the boundary. ATA lives in the I/O port space
// and there is no such space on AArch64 -- `arch.dev_in16` there is a `brk
// #1`, which is the honest answer. A driver for a disk this machine does not
// have should stop loudly at the instruction, not write into an address that
// happens to be 0x1F0.
fn in16(port: u16) -> u64 {
    return arch.dev_in16(port) as u64
}

fn out16(port: u16, value: u64) {
    arch.dev_out16(port, value as u16)
}

fn insw(port: u16, dst: u64, words: u64) {
    if words == 0 {
        return
    }
    asm("cld\nrep insw", in("dx") port, in("rdi") dst, in("rcx") words,
        clobber("rdi"), clobber("rcx"), clobber("memory"))
}

// Write counterpart of insw: a whole sector as ONE instruction (one VM exit
// instead of 256).
fn outsw(port: u16, src: u64, words: u64) {
    if words == 0 {
        return
    }
    asm("cld\nrep outsw", in("dx") port, in("rsi") src, in("rcx") words,
        clobber("rsi"), clobber("rcx"), clobber("memory"))
}

// Wait until the drive is no longer busy and has data. Bounded: a device
// that never answers must not hang the kernel.
fn ata_wait(want_drq: bool) -> bool {
    var spin: u64 = 0
    devwait.touch()
    while spin < 4000000 {
        if (spin & 1023) == 1023 {
            devwait.touch()
        }
        let st: u64 = serial.in8(ATA_CMD) as u64
        // FLOATING BUS: nothing answers at 0x1F0 (Dell 9020 with SATA in
        // AHCI mode). 0xFF has BSY set, so this loop waited all four
        // million turns -- per sector, twice, with the file system lock
        // held; the installer probing /dev/hda froze the machine
        // (measured, QEMU q35, 27.09.2026). No real drive reports 0xFF.
        if st == 0xFF {
            return false
        }
        if (st & ST_BSY) == 0 {
            if (st & ST_ERR) != 0 {
                return false
            }
            if !want_drq {
                return true
            }
            if (st & ST_DRQ) != 0 {
                return true
            }
        }
        spin = spin + 1
    }
    return false
}

fn ata_select_on(lba: u64, slave: bool) {
    ata_select_n(lba, slave, 1)
}

fn ata_select_n(lba: u64, slave: bool, n: u64) {
    var top: u64 = 0xE0
    if slave {
        top = 0xF0
    }
    serial.out8(ATA_DRIVE, (top | ((lba >> 24) & 0x0F)) as u8)
    serial.out8(ATA_COUNT, (n & 0xFF) as u8)
    serial.out8(ATA_LBA0, (lba & 0xFF) as u8)
    serial.out8(ATA_LBA1, ((lba >> 8) & 0xFF) as u8)
    serial.out8(ATA_LBA2, ((lba >> 16) & 0xFF) as u8)
}

// Is there a drive at all? A bus without one reads 0xFF as status.
fn present(state: u64) -> bool {
    serial.out8(ATA_DRIVE, 0xE0 as u8)
    serial.io_wait()
    let st: u64 = serial.in8(ATA_CMD) as u64
    if st == 0xFF || st == 0 {
        return false
    }
    return true
}

fn ata_recover(slave: bool) {
    serial.out8(ATA_CTRL, 0x04 as u8) // SRST
    // r1320 (W-CLICKFREEZE): the SRST hold time is 5 us (ATA/ATAPI-7), the old 1000 x `out 0x80` were ~1 ms on real hardware but
    // 1000 VM exits (50-100 us each under VirtualBox/NEM = 50-100 ms per recovery) in a guest. 64 writes stay > 60 us everywhere.
    var i: u64 = 0
    while i < 64 {
        serial.io_wait()
        i = i + 1
    }
    serial.out8(ATA_CTRL, 0x00 as u8)
    i = 0
    while i < 1000000 && (serial.in8(ATA_CMD) as u64 & ST_BSY) != 0 {
        if serial.in8(ATA_CMD) as u64 == 0xFF {
            i = 1000000
        }
        i = i + 1
    }
    var top: u64 = 0xE0
    if slave {
        top = 0xF0
    }
    serial.out8(ATA_DRIVE, top as u8)
    serial.io_wait()
}

static mut ata_error_count: u64 = 0
static mut ata_gesagt: u64 = 0
static mut ata_lba: u64 = 0
static mut ata_st: u64 = 0

fn ata_error() -> u64 {
    return ata_error_count
}

fn ata_last_lba() -> u64 {
    return ata_lba
}

fn ata_last_status() -> u64 {
    return ata_st
}

fn ata_report(lba: u64, is_write: bool) {
    let st: u64 = serial.in8(ATA_CMD) as u64
    ata_error_count = ata_error_count + 1
    ata_lba = lba
    ata_st = st
    if ata_gesagt >= 8 {
        return
    }
    ata_gesagt = ata_gesagt + 1
    var s_r: [u8; 18] = "ata: read fail b=\0"
    var s_w: [u8; 19] = "ata: write fail b=\0"
    var s_s: [u8; 7] = "  st=\0\0"
    var s_n: [u8; 5] = "  n=\0"
    if is_write {
        serial.puts((&s_w[0]) as u64)
    } else {
        serial.puts((&s_r[0]) as u64)
    }
    serial.dec(lba)
    serial.puts((&s_s[0]) as u64)
    serial.hex(st)
    serial.puts((&s_n[0]) as u64)
    serial.dec(ata_error_count)
    serial.nl()
}

fn ata_read_on(lba: u64, dst: u64, slave: bool) -> bool {
    ata_select_on(lba, slave)
    serial.out8(ATA_CMD, ATA_READ)
    if !ata_wait(true) {
        ata_report(lba, false)
        ata_recover(slave)
        return false
    }
    var i: u64 = 0
    while i < BLOCK_SIZE / 2 {
        __mmio_write16((dst + i * 2) as *mut u16, in16(ATA_DATA) as u16)
        i = i + 1
    }
    return true
}

fn ata_dev(slave: bool) -> u64 {
    if slave {
        return wlock.D_ATA1
    }
    return wlock.D_ATA
}

fn ata_write_on(lba: u64, src: u64, slave: bool) -> bool {
    if !wlock.allowed(ata_dev(slave)) {
        return false
    }
    ata_select_on(lba, slave)
    serial.out8(ATA_CMD, ATA_WRITE)
    if !ata_wait(true) {
        ata_report(lba, true)
        ata_recover(slave)
        return false
    }
    outsw(ATA_DATA, src, BLOCK_SIZE / 2)
    return ata_wait(false)
}

fn ata1_present(state: u64) -> bool {
    serial.out8(ATA_DRIVE, 0xF0 as u8)
    serial.io_wait()
    serial.io_wait()
    let st: u64 = serial.in8(ATA_CMD) as u64
    serial.out8(ATA_DRIVE, 0xE0 as u8)
    serial.io_wait()
    if st == 0xFF || st == 0 {
        return false
    }
    return true
}

fn removable(dev: u64) -> bool {
    return is_usb(dev)
}

fn present_on(state: u64, dev: u64) -> bool {
    if dev == DEV_ATA1 {
        return ata1_present(state)
    }
    if dev == DEV_ATA {
        return present(state)
    }
    if is_usb(dev) {
        return mscbind.ready_at(state, usb_slot(dev))
    }
    if dev == DEV_AHCI {
        return ahci.blocks(state) != 0
    }
    return true
}

fn capacity(state: u64) -> u64 {
    return identify(state, false)
}

fn blocks_on(state: u64, dev: u64) -> u64 {
    if dev == DEV_ATA1 {
        return kstate.get(state, kstate.DISK2_BLOCKS)
    }
    if dev == DEV_ATA {
        let n: u64 = kstate.get(state, kstate.DISK1_BLOCKS)
        if n != 0 {
            return n
        }
    }
    if is_usb(dev) {
        return mscbind.blocks_at(state, usb_slot(dev))
    }
    if dev == DEV_AHCI {
        return ahci.blocks(state)
    }
    // r315: /dev/nvme0 when the root is NOT on the NVMe drive (stick, RAM disk):
    // DISK_BLOCKS then holds the size of the ROOT image, not of the drive (the
    // installer showed a 128 MiB NVMe disk as 40 MiB). Take the namespace size
    // from IDENTIFY NAMESPACE (in 512-octet units). With the root ON the NVMe
    // drive nothing changes -- that path is measured and boots real machines.
    if dev == DEV_NVME && kstate.get(state, kstate.DISK_DEV) != DEV_NVME && nvme.blocks(state) != 0 {
        let nb: u64 = nvme.blocks(state)
        let sh: u64 = nvme.block_shift(state)
        if nb != 0 && sh >= 9 {
            return nb << (sh - 9)
        }
    }
    return kstate.get(state, kstate.DISK_BLOCKS)
}

fn identify(state: u64, slave: bool) -> u64 {
    if !present(state) {
        return 0
    }
    var sel: u64 = 0xA0
    if slave {
        sel = 0xB0
    }
    serial.out8(ATA_DRIVE, sel as u8)
    serial.io_wait()
    serial.io_wait()
    serial.out8(ATA_COUNT, 0 as u8)
    serial.out8(ATA_LBA0, 0 as u8)
    serial.out8(ATA_LBA1, 0 as u8)
    serial.out8(ATA_LBA2, 0 as u8)
    serial.out8(ATA_CMD, ATA_IDENTIFY)
    serial.io_wait()
    let st0: u64 = serial.in8(ATA_CMD) as u64
    if st0 == 0 || st0 == 0xFF {
        serial.out8(ATA_DRIVE, 0xE0 as u8)
        return 0
    }
    if !ata_wait(true) {
        ata_recover(false)
        serial.out8(ATA_DRIVE, 0xE0 as u8)
        return 0
    }
    var lba28: u64 = 0
    var lba48: u64 = 0
    var kann48: bool = false
    var i: u64 = 0
    while i < 256 {
        let w: u64 = in16(ATA_DATA)
        if i == 60 {
            lba28 = lba28 | w
        }
        if i == 61 {
            lba28 = lba28 | (w << 16)
        }
        if i == 83 {
            if (w & 0x0400) != 0 {
                kann48 = true
            }
        }
        if i == 100 {
            lba48 = lba48 | w
        }
        if i == 101 {
            lba48 = lba48 | (w << 16)
        }
        if i == 102 {
            lba48 = lba48 | (w << 32)
        }
        if i == 103 {
            lba48 = lba48 | (w << 48)
        }
        i = i + 1
    }
    serial.out8(ATA_DRIVE, 0xE0 as u8)
    var n: u64 = lba28
    if kann48 && lba48 > n {
        n = lba48
    }
    if n > 268435456 {
        n = 268435456
    }
    return n
}

fn probe_ata0(state: u64) -> u64 {
    kstate.set(state, kstate.DISK1_BLOCKS, 0)
    if !present(state) {
        return 0
    }
    let n: u64 = identify(state, false)
    kstate.set(state, kstate.DISK1_BLOCKS, n)
    return n
}

static mut v_dev_flushes: u64 = 0

fn dev_flushes() -> u64 {
    return v_dev_flushes
}

fn nocacheflush(state: u64) -> bool {
    var w: [u8; 13] = "nocacheflush\0"
    return cmdopt.has(state, (&w[0]) as u64)
}

fn flush(state: u64) -> bool {
    let g: u64 = blkguard.enter(state)
    if g == blkguard.G_REFUSE {
        return false
    }
    let ok: bool = flush_held(state)
    blkguard.leave(state, g)
    return ok
}

fn flush_held(state: u64) -> bool {
    wb_flush(state)
    // w-disklag: AHCI writes are no longer flushed one by one; the
    // barriers (journal commit, sync, shutdown) arrive here.
    if kstate.get(state, kstate.DISK_DEV) == DEV_AHCI {
        v_dev_flushes = v_dev_flushes + 1
        return ahci.flush(state)
    }
    if kstate.get(state, kstate.DISK_DEV) == DEV_NVME {
        if nocacheflush(state) {
            return true
        }
        v_dev_flushes = v_dev_flushes + 1
        return nvme.flush(state)
    }
    if is_usb(kstate.get(state, kstate.DISK_DEV)) {
        return mscbind.sync_at(state, usb_slot(kstate.get(state, kstate.DISK_DEV)))
    }
    if kstate.get(state, kstate.DISK_DEV) != DEV_ATA {
        return true
    }
    serial.out8(ATA_DRIVE, 0xE0 as u8)
    serial.io_wait()
    serial.out8(ATA_CMD, ATA_FLUSH)
    serial.io_wait()
    return ata_wait(false)
}

fn flush_on(state: u64, dev: u64) -> bool {
    let g: u64 = blkguard.enter(state)
    if g == blkguard.G_REFUSE {
        return false
    }
    let ok: bool = flush_on_held(state, dev)
    blkguard.leave(state, g)
    return ok
}

fn flush_on_held(state: u64, dev: u64) -> bool {
    if is_usb(dev) {
        return mscbind.sync_at(state, usb_slot(dev))
    }
    return flush(state)
}

fn probe_ata1(state: u64, n: u64) -> bool {
    kstate.set(state, kstate.DISK2_DEV, DEV_ATA1)
    kstate.set(state, kstate.DISK2_BLOCKS, 0)
    if !ata1_present(state) {
        return false
    }
    var probe: [u8; 512] = [0 as u8; 512]
    if !ata_read_on(0, (&probe[0]) as u64, true) {
        return false
    }
    var size: u64 = n
    let real: u64 = identify(state, true)
    if real != 0 {
        size = real
    }
    kstate.set(state, kstate.DISK2_BLOCKS, size)
    return true
}

fn dev_name(dev: u64) -> u64 {
    return dev
}

fn ata_write_twice(lba: u64, src: u64, slave: bool) -> bool {
    if !wlock.allowed(ata_dev(slave)) {
        return false
    }
    if dma_ready(src, 1) && dma_run(lba, src, 1, slave, true) {
        return true
    }
    if ata_write_on(lba, src, slave) {
        return true
    }
    ata_recover(slave)
    return ata_write_on(lba, src, slave)
}

// ================================== r742: ATA BUS-MASTER DMA (PIIX IDE)
//
// MEASURED (r728): PIO costs about 4.4 ms per sector under QEMU -- every
// 16-bit port access is a VM exit, and the sector loop was the whole cost
// (strace: the host disk was idle, 725k KVM_RUN returns). Bus-master DMA
// moves a whole run with ONE command and a handful of port writes.
//
// What is used: the PCI IDE controller (class 01:01, programming interface
// bit 7 = bus master), I/O BAR4 = bus master registers of the PRIMARY
// channel (+0 command, +2 status, +4 PRD table address), and the legacy
// ports 0x1F0 the PIO code already uses (interface bit 0 must be 0).
// The PRD table is one frame; entries never cross a 64 KiB boundary. The
// kernel maps the first GiB flat (virt == phys), so buffers below 1 GiB can
// be handed to the controller as they are. Anything else, and any failed
// transfer, falls back to PIO -- and a failed transfer switches DMA off
// for good (DMA_BM = 0), so a broken controller costs one retry, not more.
static mut DMA_BM: u64 = 0
static mut DMA_PRD: u64 = 0
static mut DMA_TRIED: bool = false
static mut DMA_ERRS: u64 = 0
static mut DMA_CMDS: u64 = 0
const ATA_READ_DMA: u8 = 0xC8
const ATA_WRITE_DMA: u8 = 0xCA
const DMA_LIMIT: u64 = 0x40000000
const DMA_MAX_SECTORS: u64 = 128

fn dma_up(state: u64) {
    if DMA_TRIED {
        return
    }
    if kstate.get(state, kstate.BITMAP) == 0 {
        return
    }
    DMA_TRIED = true
    let i: u64 = drvreg.find(state, drvreg.D_IDE, 0)
    if i >= pci.MAX_DEV {
        return
    }
    let pif: u64 = pci.get(state, i, pci.E_PROGIF)
    if (pif & 0x80) == 0 || (pif & 1) != 0 {
        return
    }
    if !pci.bar_is_io(state, i, 4) {
        return
    }
    let bm: u64 = pci.bar(state, i, 4) & 0xFFFC
    if bm == 0 {
        return
    }
    // The PRD table lives in the spare half of the read-ahead page (no frame:
    // a frame held forever would show up as a leak in the posix check). At
    // most 17 entries of 8 octets; it must not cross a 64 KiB boundary.
    let prd: u64 = state + kstate.BLKC_OFF + 0x800
    if prd >= 0x100000000 || ((prd & 0xFFFF) + 0x100) > 0x10000 {
        return
    }
    // I/O space + bus master (PCI command register: bit 0 = I/O, bit 2 = master).
    let bdf: u64 = pci.get(state, i, pci.E_BDF)
    pci.cfg_write16(bdf, 4, (pci.cfg_read16(bdf, 4) | 5) & 0xFFFF)
    DMA_PRD = prd
    DMA_BM = bm
}

fn dma_ready(addr: u64, n: u64) -> bool {
    if DMA_BM == 0 || n == 0 || n > DMA_MAX_SECTORS {
        return false
    }
    if (addr & 1) != 0 {
        return false
    }
    return addr + n * BLOCK_SIZE <= DMA_LIMIT
}

// ONE DMA command for n sectors at lba. false = nothing trusted, caller
// falls back to PIO (DMA is switched off after a failure).
fn dma_run(lba: u64, addr: u64, n: u64, slave: bool, write: bool) -> bool {
    if write && !wlock.allowed(ata_dev(slave)) {
        return false
    }
    let bm: u64 = DMA_BM
    let prd: u64 = DMA_PRD
    var k: u64 = 0
    var a: u64 = addr
    var rest: u64 = n * BLOCK_SIZE
    while rest > 0 {
        var chunk: u64 = 0x10000 - (a & 0xFFFF)
        if chunk > rest {
            chunk = rest
        }
        let e: u64 = prd + k * 8
        __mmio_write32(e as *mut u32, (a & 0xFFFFFFFF) as u32)
        __mmio_write16((e + 4) as *mut u16, (chunk & 0xFFFF) as u16)
        __mmio_write16((e + 6) as *mut u16, 0 as u16)
        a = a + chunk
        rest = rest - chunk
        k = k + 1
    }
    // end-of-table bit on the last entry
    __mmio_write16((prd + (k - 1) * 8 + 6) as *mut u16, 0x8000 as u16)

    serial.out8(bm as u16, 0 as u8)
    arch.dev_out32((bm + 4) as u16, (prd & 0xFFFFFFFF) as u32)
    // clear error + interrupt (write 1), keep the two "drive DMA capable" bits
    let st0: u64 = serial.in8((bm + 2) as u16) as u64
    serial.out8((bm + 2) as u16, ((st0 & 0x60) | 0x06) as u8)
    var dir: u64 = 8
    var cmd: u8 = ATA_READ_DMA
    if write {
        dir = 0
        cmd = ATA_WRITE_DMA
    }
    serial.out8(bm as u16, dir as u8)
    ata_select_n(lba, slave, n)
    serial.out8(ATA_CMD, cmd)
    serial.out8(bm as u16, (dir | 1) as u8)

    var done: bool = false
    var bad: bool = false
    var spin: u64 = 0
    devwait.touch()
    while spin < 1000000 {
        if (spin & 1023) == 1023 {
            devwait.touch()
        }
        let s: u64 = serial.in8((bm + 2) as u16) as u64
        if (s & 2) != 0 {
            bad = true
            spin = 1000000
        } else {
            if (s & 1) == 0 {
                if (s & 4) != 0 || (serial.in8(ATA_CTRL) as u64 & (ST_BSY | ST_DRQ)) == 0 {
                    done = true
                    spin = 1000000
                }
            }
        }
        spin = spin + 1
    }
    serial.out8(bm as u16, 0 as u8)
    let st1: u64 = serial.in8((bm + 2) as u16) as u64
    serial.out8((bm + 2) as u16, ((st1 & 0x60) | 0x06) as u8)
    var ok: bool = done && !bad
    if ok {
        // reading the ATA status also acknowledges the drive interrupt
        ok = ata_wait(false)
    }
    if ok && (serial.in8(ATA_CMD) as u64 & ST_DRQ) != 0 {
        ok = false
    }
    DMA_CMDS = DMA_CMDS + 1
    if !ok {
        DMA_ERRS = DMA_ERRS + 1
        DMA_BM = 0
        ata_recover(slave)
    }
    return ok
}

// r728: WRITE SECTORS with a sector count. ONE command carries n sectors
// (n <= 128): the drive raises DRQ again after each sector, and we wait for
// it again, exactly like ata_read_run. The command latency (about 17 ms per
// command in QEMU) is paid once per run instead of once per sector.
fn ata_write_run(lba: u64, src: u64, n: u64, slave: bool) -> bool {
    if !wlock.allowed(ata_dev(slave)) {
        return false
    }
    if dma_ready(src, n) && dma_run(lba, src, n, slave, true) {
        return true
    }
    // WRITE MULTIPLE (0xC5) after SET MULTIPLE MODE (0xC6, 16 sectors): the
    // drive takes a whole block of 16 sectors per DRQ and writes it with ONE
    // host operation. With plain WRITE SECTORS QEMU does one host write per
    // sector. If the drive refuses the mode, fall back to WRITE SECTORS.
    var per: u64 = 1
    if n > 1 {
        var top: u64 = 0xE0
        if slave {
            top = 0xF0
        }
        serial.out8(ATA_DRIVE, top as u8)
        serial.out8(ATA_COUNT, 16 as u8)
        serial.out8(ATA_CMD, ATA_SET_MULTIPLE)
        if ata_wait(false) {
            per = 16
        }
    }
    ata_select_n(lba, slave, n)
    if per == 16 {
        serial.out8(ATA_CMD, ATA_WRITE_MULTIPLE)
    } else {
        serial.out8(ATA_CMD, ATA_WRITE)
    }
    var k: u64 = 0
    while k < n {
        var c: u64 = n - k
        if c > per {
            c = per
        }
        if !ata_wait(true) {
            ata_report(lba + k, true)
            ata_recover(slave)
            return false
        }
        outsw(ATA_DATA, src + k * BLOCK_SIZE, c * (BLOCK_SIZE / 2))
        k = k + c
        if k < n {
            // 400 ns: the drive needs this long to raise BSY for the
            // block just sent (same four reads as ata_read_run).
            serial.in8(ATA_CTRL)
            serial.in8(ATA_CTRL)
            serial.in8(ATA_CTRL)
            serial.in8(ATA_CTRL)
        }
    }
    return ata_wait(false)
}

fn ata_write_run_twice(lba: u64, src: u64, n: u64, slave: bool) -> bool {
    if !wlock.allowed(ata_dev(slave)) {
        return false
    }
    if ata_write_run(lba, src, n, slave) {
        return true
    }
    ata_recover(slave)
    return ata_write_run(lba, src, n, slave)
}

fn ata_read_twice(lba: u64, dst: u64, slave: bool) -> bool {
    if ata_read_on(lba, dst, slave) {
        return true
    }
    return ata_read_on(lba, dst, slave)
}

// ================================ RUNDE TON: 32 SEKTOREN AUF EINMAL
fn ata_read_run(lba: u64, dst: u64, n: u64, slave: bool) -> bool {
    if dma_ready(dst, n) && dma_run(lba, dst, n, slave, false) {
        return true
    }
    ata_select_n(lba, slave, n)
    serial.out8(ATA_CMD, ATA_READ)
    var s: u64 = 0
    while s < n {
        if !ata_wait(true) {
            ata_report(lba + s, false)
            ata_recover(slave)
            return false
        }
        insw(ATA_DATA, dst + s * BLOCK_SIZE, BLOCK_SIZE / 2)
        // VIERHUNDERT NANOSEKUNDEN, VIERMAL DER ERSATZSTATUS.
        serial.in8(ATA_CTRL)
        serial.in8(ATA_CTRL)
        serial.in8(ATA_CTRL)
        serial.in8(ATA_CTRL)
        s = s + 1
    }
    return true
}

const C_STRIDE: u64 = 0x20 // Woerter je Weg
const C_VALID: u64 = 0x00
const C_LBA: u64 = 0x08 // erste enthaltene LBA (absolut)
const C_N: u64 = 0x10 // wie viele Sektoren
const C_DEV: u64 = 0x18
const C_BASE: u64 = 0x200
const C_HITS: u64 = 0x200
const C_MISSES: u64 = 0x208
const C_CMDS: u64 = 0x210 // wie viele ATA-Befehle daraus wurden
const C_NEXT: u64 = 0x218
const C_LAST: u64 = 0x220
const C_RUNS: u64 = 0x228
// r1181: ways 8..15 live in a lazily allocated frame run (the fixed data page of the cache, BLKD, has room for eight only).
const C_XDATA: u64 = 0x258 // address of the extra data (8 ways * 4 KiB), 0 = not (yet) there
const C_XTRIED: u64 = 0x260 // 1 once an allocation was tried (no retry storm when memory is short)
const XWAYS: u64 = 248
const INLINE_WAYS: u64 = 16
const XMETA_BYTES: u64 = 8192

fn cg(state: u64, off: u64) -> u64 {
    return __mmio_read64((state + kstate.BLKC_OFF + off) as *mut u64)
}

fn cs(state: u64, off: u64, v: u64) {
    __mmio_write64((state + kstate.BLKC_OFF + off) as *mut u64, v)
}

fn way_cell(state: u64, way: u64, off: u64) -> *mut u64 {
    if way < INLINE_WAYS {
        return (state + kstate.BLKC_OFF + way * C_STRIDE + off) as *mut u64
    }
    return (cg(state, C_XDATA) + XWAYS * kstate.BLKC_SECTORS * BLOCK_SIZE + (way - INLINE_WAYS) * C_STRIDE + off) as *mut u64
}

fn cell_at(state: u64, xbase: u64, way: u64, off: u64) -> *mut u64 {
    if way < INLINE_WAYS {
        return (state + kstate.BLKC_OFF + way * C_STRIDE + off) as *mut u64
    }
    return (xbase + XWAYS * kstate.BLKC_SECTORS * BLOCK_SIZE + (way - INLINE_WAYS) * C_STRIDE + off) as *mut u64
}

fn wgx(state: u64, xbase: u64, way: u64, off: u64) -> u64 {
    return __mmio_read64(cell_at(state, xbase, way, off))
}

fn wsx(state: u64, xbase: u64, way: u64, off: u64, v: u64) {
    __mmio_write64(cell_at(state, xbase, way, off), v)
}

fn wg(state: u64, way: u64, off: u64) -> u64 {
    return __mmio_read64(way_cell(state, way, off))
}

fn ws(state: u64, way: u64, off: u64, v: u64) {
    __mmio_write64(way_cell(state, way, off), v)
}

fn gone_data(state: u64, way: u64) -> u64 {
    if way >= kstate.BLKC_WAYS {
        return cg(state, C_XDATA) + (way - kstate.BLKC_WAYS) * kstate.BLKC_SECTORS * BLOCK_SIZE
    }
    return state + kstate.BLKD_OFF + way * kstate.BLKC_SECTORS * BLOCK_SIZE
}

// r1181: HOW MANY WAYS THE CACHE HAS RIGHT NOW. Measured in an idle desktop: the taskbar keeps re-reading ten different
// chunks (superblock, journal, root directory, ~13 config files); a round-robin cache of eight ways with ten chunks in
// a cycle misses on EVERY lookup (20-30 DMA commands/s for nothing). Sixteen ways hold the whole cycle. The second eight
// come from the frame allocator on first use; if that fails, the cache stays at eight ways exactly as before.
fn ways(state: u64) -> u64 {
    if cg(state, C_XDATA) != 0 {
        return kstate.BLKC_WAYS + XWAYS
    }
    return kstate.BLKC_WAYS
}

// LA-9: STREAM BUFFER. File data read by `fs.read_at` goes through ONE read-ahead buffer of S_SECTORS sectors (one DMA command per 16 KiB instead of one
// per 4 KiB way). Allocated lazily; any write drops it (`cache_drop`/`cache_invalidate`). ATA and AHCI only, everything else reads as before.
const S_DATA: u64 = 0x268 // address of the buffer, 0 = not (yet) there
const S_TRIED: u64 = 0x270
const S_VALID: u64 = 0x278
const S_LBA: u64 = 0x280
const S_N: u64 = 0x288
const S_DEV: u64 = 0x290
const S_SECTORS: u64 = 32
const S_SECTORS_WIDE: u64 = 128

fn stream_grow(state: u64) {
    if cg(state, S_TRIED) != 0 || kstate.get(state, kstate.BITMAP) == 0 {
        return
    }
    cs(state, S_TRIED, 1)
    let b: u64 = mmframe.frame_run(state, S_SECTORS_WIDE * BLOCK_SIZE / 4096)
    if b != 0 {
        cs(state, S_DATA, b)
    }
}

fn read_stream(state: u64, lba: u64, dst: u64) -> bool {
    return read_stream_span(state, lba, dst, S_SECTORS)
}

fn read_stream_span(state: u64, lba: u64, dst: u64, span: u64) -> bool {
    let g: u64 = blkguard.enter(state)
    if g == blkguard.G_REFUSE {
        return false
    }
    let ok: bool = read_stream_held(state, lba, dst, span)
    blkguard.leave(state, g)
    return ok
}

fn read_stream_held(state: u64, lba: u64, dst: u64, span: u64) -> bool {
    let dv: u64 = kstate.get(state, kstate.DISK_DEV)
    if cryptstate.active(state) || (dv != DEV_ATA && dv != DEV_ATA1 && dv != DEV_AHCI && !is_usb(dv) && !(dv == DEV_NVME && !kstate.mode_on(state, kstate.M_NONVMEMANY))) || lba >= blocks(state) {
        return read(state, lba, dst)
    }
    let abs: u64 = lba + kstate.get(state, kstate.DISK_FIRST)
    if cg(state, S_VALID) == 1 && cg(state, S_DEV) == dv {
        let c0: u64 = cg(state, S_LBA)
        if abs >= c0 && abs < c0 + cg(state, S_N) {
            copy(cg(state, S_DATA) + (abs - c0) * BLOCK_SIZE, dst)
            return true
        }
    }
    stream_grow(state)
    let buf: u64 = cg(state, S_DATA)
    if buf == 0 {
        return read(state, lba, dst)
    }
    dma_up(state)
    let dirty: bool = cg(state, W_DIRTY) != 0
    if dirty && cg(state, W_DEPTH) != 0 {
        return read(state, lba, dst)
    }
    let ende: u64 = kstate.get(state, kstate.DISK_FIRST) + blocks(state)
    var n: u64 = span
    if ende > abs && ende - abs < n {
        n = ende - abs
    }
    cs(state, S_VALID, 0)
    if !dev_read_run(state, dv, abs, n, buf) {
        return read(state, lba, dst)
    }
    if dirty {
        wb_overlay(state, dv, abs, n, buf)
    }
    cs(state, S_LBA, abs)
    cs(state, S_N, n)
    cs(state, S_DEV, dv)
    cs(state, S_VALID, 1)
    copy(buf, dst)
    return true
}

fn cache_grow(state: u64) {
    stream_grow(state) // allocated with the cache, early, so the frame count is stable afterwards
    if cg(state, C_XTRIED) != 0 || kstate.get(state, kstate.BITMAP) == 0 {
        return
    }
    cs(state, C_XTRIED, 1)
    let b: u64 = mmframe.frame_run(state, (XWAYS * kstate.BLKC_SECTORS * BLOCK_SIZE + XMETA_BYTES) / 4096)
    if b == 0 {
        return
    }
    cs(state, C_XDATA, b)
    var w: u64 = kstate.BLKC_WAYS
    while w < kstate.BLKC_WAYS + XWAYS {
        ws(state, w, C_VALID, 0)
        w = w + 1
    }
}

fn cache_invalidate(state: u64) {
    cs(state, S_VALID, 0)
    blkindex.reset_devs()
    let total: u64 = ways(state)
    let xb: u64 = cg(state, C_XDATA)
    var w: u64 = 0
    while w < total {
        wsx(state, xb, w, C_VALID, 0)
        w = w + 1
    }
}

// w-disklag: a write drops only the ways that contain the written sector
// (same device), not all eight. Every writer still comes through
// `write_raw` / `write_on`, the two places that call this, so the rule
// "a cache that misses one write is worse than no cache" still holds.
// Before this, each metadata write threw away the pointer/inode/bitmap
// blocks the next operation needed again (measured: 115 disk reads per
// created file instead of ~50).
fn drop_foreign_ways(state: u64, dev: u64) {
    let total: u64 = ways(state)
    let xb: u64 = cg(state, C_XDATA)
    var w: u64 = 0
    while w < total {
        if wgx(state, xb, w, C_VALID) != 0 && wgx(state, xb, w, C_DEV) != dev {
            wsx(state, xb, w, C_VALID, 0)
        }
        w = w + 1
    }
    blkindex.only_dev(dev)
}

fn cache_drop(state: u64, dev: u64, lba: u64) {
    cs(state, S_VALID, 0)
    if blkindex.foreign(dev) {
        drop_foreign_ways(state, dev)
    }
    let xb: u64 = cg(state, C_XDATA)
    var nd: u64 = blkindex.first(dev, lba)
    while nd != 0 {
        let w: u64 = blkindex.way_of(nd)
        if way_holds(state, xb, w, dev, lba) {
            wsx(state, xb, w, C_VALID, 0)
        }
        nd = blkindex.next(nd)
    }
}

fn cache_put(state: u64, dev: u64, lba: u64, src: u64) {
    if cg(state, S_VALID) != 0 {
        let s0: u64 = cg(state, S_LBA)
        if cg(state, S_DEV) == dev && lba >= s0 && lba < s0 + cg(state, S_N) {
            copy(src, cg(state, S_DATA) + (lba - s0) * BLOCK_SIZE)
        } else {
            cs(state, S_VALID, 0)
        }
    }
    if blkindex.foreign(dev) {
        drop_foreign_ways(state, dev)
    }
    let xb: u64 = cg(state, C_XDATA)
    var nd: u64 = blkindex.first(dev, lba)
    while nd != 0 {
        let w: u64 = blkindex.way_of(nd)
        if way_holds(state, xb, w, dev, lba) {
            copy(src, gone_data(state, w) + (lba - wgx(state, xb, w, C_LBA)) * BLOCK_SIZE)
        }
        nd = blkindex.next(nd)
    }
}

// ------------------------------------------------------------ r728
// WRITE-BEHIND for the ATA volume path, scoped to one file-system call.
//
// `wb_begin` .. `wb_end` bracket a bulk operation (fs.write_at). While the
// scope is open, sector writes to an ATA disk land in a direct-mapped RAM
// table (128 sectors, slot = lba & 127) instead of going to the drive one
// command per sector. Reads see the table first. Consecutive sectors sit in
// consecutive slots, so the flush sends them as multi-sector WRITE commands.
// The table is flushed when the OUTERMOST scope ends, on `flush`, when two
// sectors collide in one slot, and before any read that must go to the
// drive (so the drive never holds older data than a reader could see).
// Nothing stays dirty after the call returns: the crash window is the same
// system call as before.
const W_BASE: u64 = 0x240 // address of the region, 0 = none
const W_DEPTH: u64 = 0x248 // open scopes
const W_DIRTY: u64 = 0x250 // valid slots
const W_SINCE: u64 = 0x298 // tick of the oldest dirty slot
const W_MODE: u64 = 0x2A0 // 0 eager, 1 data-only scope, 2 structural
const W_META: u64 = 0x2B0 // first lba after the metadata sectors written before directory data, 0 = no ordering
const W_FREED: u64 = 0x2A8 // 1 while freed blocks or inodes are not yet on the drive
const WB_SLOTS: u64 = 2048
const WB_KEY_BYTES: u64 = 16384
const WB_IDLE_TICKS: u64 = 25
const WB_MAX_TICKS: u64 = 100
const WM_EAGER: u64 = 0
const WM_DATA: u64 = 1
const WM_STRUCT: u64 = 2
const WM_LAZY: u64 = 3
const WB_VALID: u64 = 0x8000000000000000
const WB_LBA_MASK: u64 = 0x0000FFFFFFFFFFFF

fn wb_meta(state: u64, slot: u64) -> u64 {
    return __mmio_read64((cg(state, W_BASE) + slot * 8) as *mut u64)
}

fn wb_meta_set(state: u64, slot: u64, v: u64) {
    __mmio_write64((cg(state, W_BASE) + slot * 8) as *mut u64, v)
}

fn wb_data(state: u64, slot: u64) -> u64 {
    return cg(state, W_BASE) + WB_KEY_BYTES + slot * BLOCK_SIZE
}

fn wb_key(dev: u64, lba: u64) -> u64 {
    return WB_VALID | (dev << 48) | lba
}

fn wb_dev(dv: u64, state: u64) -> bool {
    if dv == DEV_ATA || dv == DEV_ATA1 {
        return true
    }
    if dv == DEV_AHCI || dv == DEV_NVME {
        return !kstate.mode_on(state, kstate.M_NOWBDEV)
    }
    return false
}

const WB_AHCI_RUN: u64 = 128
const WB_NVME_PAGES: u64 = 2

static mut wb_nvme_pending: [u64; 1] = [0 as u64; 1]

fn wb_ahci_run(state: u64, lba: u64, src: u64, n: u64) -> bool {
    var done: u64 = 0
    while done < n {
        var c: u64 = n - done
        if c > WB_AHCI_RUN {
            c = WB_AHCI_RUN
        }
        if !ahci.write_many(state, lba + done, c, src + done * BLOCK_SIZE) {
            return false
        }
        done = done + c
    }
    return true
}

fn wb_nvme_run(state: u64, lba: u64, src: u64, n: u64) -> bool {
    var done: u64 = 0
    while done < n {
        let at: u64 = src + done * BLOCK_SIZE
        var c: u64 = (WB_NVME_PAGES * 4096 - (at & 4095)) / BLOCK_SIZE
        if c > n - done {
            c = n - done
        }
        wb_nvme_pending[0] = 1
        if !nvme.write_many(state, lba + done, c, at) {
            return false
        }
        done = done + c
    }
    return true
}

fn wb_dev_run(state: u64, dv: u64, lba: u64, src: u64, n: u64) -> bool {
    if dv == DEV_AHCI {
        return wb_ahci_run(state, lba, src, n)
    }
    if dv == DEV_NVME {
        return wb_nvme_run(state, lba, src, n)
    }
    return ata_write_run_twice(lba, src, n, dv == DEV_ATA1)
}

fn wb_nvme_sync(state: u64) -> bool {
    if wb_nvme_pending[0] == 0 {
        return true
    }
    wb_nvme_pending[0] = 0
    return nvme.flush(state)
}

fn wb_active(state: u64) -> bool {
    return cg(state, W_BASE) != 0 && cg(state, W_DEPTH) != 0
}

const WB_FRAMES: u64 = 260

static mut wb_last: [u64; 1] = [0 as u64; 1]

fn wb_grab(state: u64) -> u64 {
    let last: u64 = wb_last[0]
    if last != 0 && mmframe.frame_run_at(state, last, WB_FRAMES) {
        return last
    }
    let b: u64 = mmframe.frame_run(state, WB_FRAMES)
    wb_last[0] = b
    return b
}

fn wb_begin(state: u64) {
    if cg(state, W_BASE) == 0 && kstate.get(state, kstate.BITMAP) != 0 {
        // 4 frames of slot keys + 256 frames of sector data
        let b: u64 = wb_grab(state)
        if b != 0 {
            var i: u64 = 0
            while i < WB_SLOTS {
                __mmio_write64((b + i * 8) as *mut u64, 0)
                i = i + 1
            }
            cs(state, W_BASE, b)
            cs(state, W_DIRTY, 0)
        }
    }
    cs(state, W_DEPTH, cg(state, W_DEPTH) + 1)
}

fn wb_begin_data(state: u64) {
    wb_begin(state)
    if cg(state, W_DEPTH) == 1 {
        cs(state, W_MODE, WM_DATA)
    }
}

fn wb_struct(state: u64) {
    if cg(state, W_DEPTH) != 0 {
        cs(state, W_MODE, WM_STRUCT)
    }
}

fn wb_struct_lazy(state: u64) {
    if cg(state, W_DEPTH) != 0 {
        cs(state, W_MODE, WM_LAZY)
    }
}

fn wb_set_meta(state: u64, limit: u64) {
    cs(state, W_META, limit + kstate.get(state, kstate.DISK_FIRST))
}

fn wb_mark_freed(state: u64) {
    if cg(state, W_DEPTH) == 0 || cg(state, W_FREED) != 0 {
        return
    }
    if cg(state, W_DIRTY) != 0 {
        let _ok: bool = wb_flush(state)
    }
    cs(state, W_FREED, 1)
}

fn wb_freed_pending(state: u64) -> bool {
    return cg(state, W_FREED) != 0
}

fn wb_age(state: u64) -> u64 {
    return kstate.get(state, kstate.TICKS) -% cg(state, W_SINCE)
}

fn wb_keep(state: u64) -> bool {
    let mode: u64 = cg(state, W_MODE)
    if (mode != WM_DATA && mode != WM_LAZY) || cg(state, W_DIRTY) == 0 {
        return false
    }
    if kstate.mode_on(state, kstate.M_NOWBLAZY) {
        return false
    }
    return wb_age(state) < WB_MAX_TICKS
}

fn wb_due(state: u64) -> bool {
    if cg(state, W_BASE) == 0 || cg(state, W_DEPTH) != 0 {
        return false
    }
    return cg(state, W_DIRTY) == 0 || wb_age(state) >= WB_IDLE_TICKS
}

fn wb_release(state: u64) {
    let b: u64 = cg(state, W_BASE)
    if b == 0 || cg(state, W_DEPTH) != 0 || cg(state, W_DIRTY) != 0 {
        return
    }
    cs(state, W_BASE, 0)
    mmframe.frame_free_run(state, b, WB_FRAMES)
}

const WB_RUN_MAX: u64 = 128

fn wb_run_end(state: u64, sl: u64, m: u64, high: u64) -> u64 {
    let lba: u64 = m & WB_LBA_MASK
    var e: u64 = sl + 1
    while e < WB_SLOTS && e - sl < WB_RUN_MAX && wb_meta(state, e) == m + (e - sl) && lba + (e - sl) < high {
        e = e + 1
    }
    return e
}

fn wb_evict_run(state: u64, sl: u64) -> bool {
    let m: u64 = wb_meta(state, sl)
    let limit: u64 = cg(state, W_META)
    var high: u64 = WB_LBA_MASK + 1
    if limit != 0 && (m & WB_LBA_MASK) < limit {
        high = limit
    }
    let e: u64 = wb_run_end(state, sl, m, high)
    let dv: u64 = (m >> 48) & 0x7FFF
    if !wb_dev_run(state, dv, m & WB_LBA_MASK, wb_data(state, sl), e - sl) {
        return false
    }
    var j: u64 = sl
    while j < e {
        wb_meta_set(state, j, 0)
        j = j + 1
    }
    cs(state, W_DIRTY, cg(state, W_DIRTY) - (e - sl))
    return true
}

fn wb_flush_range(state: u64, low: u64, high: u64) -> bool {
    var ok: bool = true
    var sl: u64 = 0
    while sl < WB_SLOTS {
        let m: u64 = wb_meta(state, sl)
        let lba: u64 = m & WB_LBA_MASK
        if m == 0 || lba < low || lba >= high {
            sl = sl + 1
        } else {
            let e: u64 = wb_run_end(state, sl, m, high)
            let dv: u64 = (m >> 48) & 0x7FFF
            if !wb_dev_run(state, dv, lba, wb_data(state, sl), e - sl) {
                ok = false
            }
            var j: u64 = sl
            while j < e {
                wb_meta_set(state, j, 0)
                j = j + 1
            }
            cs(state, W_DIRTY, cg(state, W_DIRTY) - (e - sl))
            sl = e
        }
    }
    return ok
}

fn wb_flush(state: u64) -> bool {
    dma_up(state)
    if cg(state, W_BASE) == 0 || cg(state, W_DIRTY) == 0 {
        return wb_nvme_sync(state)
    }
    var ok: bool = true
    let limit: u64 = cg(state, W_META)
    if limit == 0 {
        ok = wb_flush_range(state, 0, WB_LBA_MASK)
    } else if cg(state, W_FREED) != 0 {
        ok = wb_flush_range(state, limit, WB_LBA_MASK)
        if !wb_flush_range(state, 0, limit) {
            ok = false
        }
    } else {
        ok = wb_flush_range(state, 0, limit)
        if !wb_flush_range(state, limit, WB_LBA_MASK) {
            ok = false
        }
    }
    cs(state, W_DIRTY, 0)
    cs(state, W_FREED, 0)
    if !wb_nvme_sync(state) {
        ok = false
    }
    return ok
}

fn wb_end(state: u64) -> bool {
    let d: u64 = cg(state, W_DEPTH)
    if d == 0 {
        return true
    }
    if d == 1 && wb_keep(state) {
        cs(state, W_MODE, WM_EAGER)
        cs(state, W_DEPTH, 0)
        return true
    }
    cs(state, W_DEPTH, d - 1)
    if d == 1 {
        cs(state, W_MODE, WM_EAGER)
        let ok: bool = wb_flush(state)
        wb_release(state)
        return ok
    }
    return true
}

// r728: does the table hold a dirty sector in [lba, lba + n)?
fn wb_overlap(state: u64, dev: u64, lba: u64, n: u64) -> bool {
    if cg(state, W_BASE) == 0 || cg(state, W_DIRTY) == 0 {
        return false
    }
    var i: u64 = 0
    while i < n {
        if wb_meta(state, (lba + i) & (WB_SLOTS - 1)) == wb_key(dev, lba + i) {
            return true
        }
        i = i + 1
    }
    return false
}

fn wb_overlay(state: u64, dev: u64, lba: u64, n: u64, data: u64) {
    var i: u64 = 0
    while i < n {
        let _hit: bool = wb_serve(state, dev, lba + i, data + i * BLOCK_SIZE)
        i = i + 1
    }
}

fn wb_serve(state: u64, dev: u64, lba: u64, dst: u64) -> bool {
    if cg(state, W_BASE) == 0 || cg(state, W_DIRTY) == 0 {
        return false
    }
    let sl: u64 = lba & (WB_SLOTS - 1)
    if wb_meta(state, sl) != wb_key(dev, lba) {
        return false
    }
    copy(wb_data(state, sl), dst)
    return true
}

fn wb_order_before_evict(state: u64, lba: u64) {
    let limit: u64 = cg(state, W_META)
    if limit == 0 {
        return
    }
    let freed: bool = cg(state, W_FREED) != 0
    if !freed && lba >= limit {
        let _ok: bool = wb_flush_range(state, 0, limit)
    } else if freed && lba < limit {
        let _ok: bool = wb_flush_range(state, limit, WB_LBA_MASK)
    }
}

fn wb_put(state: u64, dev: u64, lba: u64, src: u64) -> bool {
    dma_up(state)
    let sl: u64 = lba & (WB_SLOTS - 1)
    let key: u64 = wb_key(dev, lba)
    var old: u64 = wb_meta(state, sl)
    if old != 0 && old != key {
        wb_order_before_evict(state, old & WB_LBA_MASK)
        old = wb_meta(state, sl)
    }
    if old != 0 && old != key {
        if !wb_evict_run(state, sl) {
            return false
        }
    }
    if wb_meta(state, sl) == 0 {
        if cg(state, W_DIRTY) == 0 {
            cs(state, W_SINCE, kstate.get(state, kstate.TICKS))
        }
        cs(state, W_DIRTY, cg(state, W_DIRTY) + 1)
    }
    copy(src, wb_data(state, sl))
    wb_meta_set(state, sl, key)
    return true
}

fn cache_reset(state: u64) {
    cache_invalidate(state)
    cs(state, C_HITS, 0)
    cs(state, C_MISSES, 0)
    cs(state, C_CMDS, 0)
    cs(state, C_NEXT, 0)
    cs(state, C_LAST, 0)
    cs(state, C_RUNS, 0)
}

fn cache_hits(state: u64) -> u64 {
    return cg(state, C_HITS)
}

fn cache_misses(state: u64) -> u64 {
    return cg(state, C_MISSES)
}

fn cache_cmds(state: u64) -> u64 {
    return cg(state, C_CMDS)
}

fn cache_runs(state: u64) -> u64 {
    return cg(state, C_RUNS)
}

fn dev_read_run(state: u64, dev: u64, lba: u64, n: u64, buf: u64) -> bool {
    let t0: u64 = blkperf.now()
    let ok: bool = dev_read_run_raw(state, dev, lba, n, buf)
    if ok {
        blkstat.note_read(dev, n)
    }
    blkperf.add(blkperf.K_RUN_CMDS, 1)
    blkperf.add(blkperf.K_RUN_SECTORS, n)
    blkperf.add(blkperf.K_RUN_CYCLES, blkperf.since(t0))
    return ok
}

fn dev_read_run_raw(state: u64, dev: u64, lba: u64, n: u64, buf: u64) -> bool {
    if dev == DEV_AHCI {
        return ahci.read_many(state, lba, n, buf)
    }
    if dev == DEV_NVME {
        return nvme.read_run(state, lba, n, buf)
    }
    if is_usb(dev) {
        return mscbind.read_run_at(state, usb_slot(dev), lba, n, buf)
    }
    return ata_read_run(lba, buf, n, dev == DEV_ATA1)
}

fn dev_read_one(state: u64, dev: u64, lba: u64, dst: u64) -> bool {
    if dev == DEV_AHCI {
        return ahci.read_block(state, lba, dst)
    }
    if dev == DEV_NVME {
        return nvme.read_block(state, lba, dst)
    }
    if is_usb(dev) {
        return mscbind.read_at(state, usb_slot(dev), lba, dst)
    }
    return ata_read_twice(lba, dst, dev == DEV_ATA1)
}

fn clock_victim(state: u64) -> u64 {
    let total: u64 = ways(state)
    var tries: u64 = 0
    var hand: u64 = cg(state, C_NEXT) % total
    while tries < total * 2 {
        let v: u64 = wg(state, hand, C_VALID)
        let here: u64 = hand
        hand = (hand + 1) % total
        if v != 2 {
            cs(state, C_NEXT, hand)
            return here
        }
        ws(state, here, C_VALID, 1)
        tries = tries + 1
    }
    cs(state, C_NEXT, hand)
    return hand
}

fn way_holds(state: u64, xb: u64, w: u64, dev: u64, lba: u64) -> bool {
    if wgx(state, xb, w, C_VALID) == 0 || wgx(state, xb, w, C_DEV) != dev {
        return false
    }
    let c0: u64 = wgx(state, xb, w, C_LBA)
    return lba >= c0 && lba < c0 + wgx(state, xb, w, C_N)
}

const NO_WAY: u64 = 0xFFFFFFFFFFFFFFFF

fn find_way(state: u64, xb: u64, dev: u64, lba: u64) -> u64 {
    var nd: u64 = blkindex.first(dev, lba)
    while nd != 0 {
        let w: u64 = blkindex.way_of(nd)
        if way_holds(state, xb, w, dev, lba) {
            return w
        }
        nd = blkindex.next(nd)
    }
    return NO_WAY
}

fn cache_serve(state: u64, w: u64, lba: u64, dst: u64) {
    ws(state, w, C_VALID, 2)
    cs(state, C_HITS, cg(state, C_HITS) + 1)
    cs(state, C_LAST, lba)
    copy(gone_data(state, w) + (lba - wg(state, w, C_LBA)) * BLOCK_SIZE, dst)
}

fn ata_read_cached(state: u64, lba: u64, dst: u64, dev: u64, ende: u64) -> bool {
    dma_up(state)
    cache_grow(state)
    if cg(state, W_DIRTY) != 0 {
        let wsl: u64 = lba & (WB_SLOTS - 1)
        if wb_meta(state, wsl) == wb_key(dev, lba) {
            copy(wb_data(state, wsl), dst)
            return true
        }
    }
    let found: u64 = find_way(state, cg(state, C_XDATA), dev, lba)
    if found != NO_WAY {
        cache_serve(state, found, lba, dst)
        return true
    }
    cs(state, C_MISSES, cg(state, C_MISSES) + 1)
    // KEINE SPURERKENNUNG -- ACHT PLAETZE STATTDESSEN. GEMESSEN:
    cs(state, C_RUNS, cg(state, C_RUNS) + 1)
    let target: u64 = clock_victim(state)
    let data: u64 = gone_data(state, target)
    var n: u64 = kstate.BLKC_SECTORS
    if ende > lba && ende - lba < n {
        n = ende - lba
    }
    if n == 0 {
        n = 1
    }
    let dirty_in_run: bool = wb_overlap(state, dev, lba, n)
    ws(state, target, C_VALID, 0)
    cs(state, C_CMDS, cg(state, C_CMDS) + 1)
    // w-disklag: the same read-ahead for AHCI -- ONE DMA command for the
    // whole run instead of one command per 512-byte block.
    if !dev_read_run(state, dev, lba, n, data) {
        return dev_read_one(state, dev, lba, dst)
    }
    if dirty_in_run {
        wb_overlay(state, dev, lba, n, data)
    }
    ws(state, target, C_LBA, lba)
    ws(state, target, C_N, n)
    ws(state, target, C_DEV, dev)
    ws(state, target, C_VALID, 1)
    blkindex.link(target, dev, lba, n)
    blkindex.note_dev(dev)
    copy(data, dst)
    return true
}

fn ahci_read_cached(state: u64, lba: u64, dst: u64, ende: u64) -> bool {
    if kstate.mode_on(state, kstate.M_AHCISLOW) {
        return ahci.read_block(state, lba, dst) // control sample: old path
    }
    return ata_read_cached(state, lba, dst, DEV_AHCI, ende)
}

fn nvme_read_cached(state: u64, lba: u64, dst: u64, ende: u64) -> bool {
    if kstate.mode_on(state, kstate.M_NONVMEMANY) {
        return nvme.read_block(state, lba, dst)
    }
    return ata_read_cached(state, lba, dst, DEV_NVME, ende)
}

static mut stat_reads: u64 = 0
static mut stat_writes: u64 = 0

fn reads() -> u64 {
    return stat_reads
}

fn writes() -> u64 {
    return stat_writes
}

fn read_mounted(state: u64, m: u64, lba: u64, dst: u64) -> bool {
    return read_on(state, mnt.dev(state, m), lba, dst)
}

fn read_on(state: u64, dev: u64, lba: u64, dst: u64) -> bool {
    let g: u64 = blkguard.enter(state)
    if g == blkguard.G_REFUSE {
        return false
    }
    let ok: bool = read_on_held(state, dev, lba, dst)
    blkguard.leave(state, g)
    return ok
}

fn read_on_held(state: u64, dev: u64, lba: u64, dst: u64) -> bool {
    let ok: bool = read_on_body(state, dev, lba, dst)
    if ok {
        blkstat.note_read(dev, 1)
    }
    return ok
}

fn read_on_body(state: u64, dev: u64, lba: u64, dst: u64) -> bool {
    if lba >= blocks_on(state, dev) {
        return false
    }
    stat_reads = stat_reads + 1
    if wb_serve(state, dev, lba, dst) {
        return true
    }
    if dev == DEV_ATA || dev == DEV_ATA1 {
        return ata_read_cached(state, lba, dst, dev, blocks_on(state, dev))
    }
    if dev == DEV_NVME {
        return nvme_read_cached(state, lba, dst, blocks_on(state, dev))
    }
    if is_usb(dev) {
        return mscbind.read_at(state, usb_slot(dev), lba, dst)
    }
    if dev == DEV_AHCI {
        return ahci_read_cached(state, lba, dst, blocks_on(state, dev))
    }
    let base: u64 = kstate.get(state, kstate.DISK)
    if base == 0 {
        return false
    }
    copy(base + lba * BLOCK_SIZE, dst)
    return true
}

fn write_on(state: u64, dev: u64, lba: u64, src: u64) -> bool {
    let g: u64 = blkguard.enter(state)
    if g == blkguard.G_REFUSE {
        return false
    }
    let ok: bool = write_on_held(state, dev, lba, src)
    blkguard.leave(state, g)
    return ok
}

fn write_on_held(state: u64, dev: u64, lba: u64, src: u64) -> bool {
    if !wlock.allowed(dev) {
        return false
    }
    if lba >= blocks_on(state, dev) {
        return false
    }
    stat_writes = stat_writes + 1
    let ok: bool = write_on_store(state, dev, lba, src)
    if ok {
        blkstat.note_write(dev, 1)
    }
    if ok {
        cache_put(state, dev, lba, src)
    } else {
        cache_drop(state, dev, lba)
    }
    return ok
}

fn write_on_store(state: u64, dev: u64, lba: u64, src: u64) -> bool {
    if wb_dev(dev, state) {
        wb_flush(state)
    }
    if dev == DEV_ATA {
        return ata_write_twice(lba, src, false)
    }
    if dev == DEV_ATA1 {
        return ata_write_twice(lba, src, true)
    }
    if dev == DEV_NVME {
        return nvme.write_block(state, lba, src)
    }
    if is_usb(dev) {
        return mscbind.write_at(state, usb_slot(dev), lba, src)
    }
    if dev == DEV_AHCI {
        return ahci.write_block(state, lba, src)
    }
    let base: u64 = kstate.get(state, kstate.DISK)
    if base == 0 {
        return false
    }
    copy(src, base + lba * BLOCK_SIZE)
    return true
}

// ------------------------------------------------------- the interface

// ================================================ RUNDE KRYPTO (K-019)
fn read_crypt(state: u64, lba: u64, dst: u64) -> bool {
    let buf: u64 = state + kstate.CRY_BUF
    if !read_raw(state, lba, buf) {
        return false
    }
    return cryptbind.decrypt_sector(state, lba, buf, dst)
}

fn write_crypt(state: u64, lba: u64, src: u64) -> bool {
    let buf: u64 = state + kstate.CRY_BUF
    if !cryptbind.encrypt_sector(state, lba, src, buf) {
        return false
    }
    return write_raw(state, lba, buf)
}

fn read(state: u64, lba: u64, dst: u64) -> bool {
    if cryptstate.active(state) {
        return read_crypt(state, lba, dst)
    }
    return read_raw(state, lba, dst)
}

fn read_raw(state: u64, lba: u64, dst: u64) -> bool {
    let g: u64 = blkguard.enter(state)
    if g == blkguard.G_REFUSE {
        return false
    }
    let ok: bool = read_raw_held(state, lba, dst)
    blkguard.leave(state, g)
    return ok
}

const READ_ATTEMPTS: u64 = 8
const READ_RETRY_PAUSE_US: u64 = 2000000

fn read_retryable(state: u64, lba: u64) -> bool {
    return lba < blocks(state) && kstate.get(state, kstate.DISK_DEV) == DEV_AHCI && ahci.alive(state)
}

fn read_raw_held(state: u64, lba: u64, dst: u64) -> bool {
    var ok: bool = read_raw_body(state, lba, dst)
    var attempt: u64 = 1
    while !ok && attempt < READ_ATTEMPTS && read_retryable(state, lba) {
        ahci.pause(state, READ_RETRY_PAUSE_US)
        ok = read_raw_body(state, lba, dst)
        attempt = attempt + 1
    }
    if ok {
        blkstat.note_read(kstate.get(state, kstate.DISK_DEV), 1)
    }
    return ok
}

fn read_raw_body(state: u64, lba: u64, dst: u64) -> bool {
    if lba >= blocks(state) {
        return false
    }
    let abs: u64 = lba + kstate.get(state, kstate.DISK_FIRST)
    let dv: u64 = kstate.get(state, kstate.DISK_DEV)
    if wb_serve(state, dv, abs, dst) {
        return true
    }
    if dv == DEV_ATA || dv == DEV_ATA1 || is_usb(dv) {
        return ata_read_cached(state, abs, dst, dv,
            kstate.get(state, kstate.DISK_FIRST) + blocks(state))
    }
    if kstate.get(state, kstate.DISK_DEV) == DEV_NVME {
        return nvme_read_cached(state, abs, dst,
            kstate.get(state, kstate.DISK_FIRST) + blocks(state))
    }
    if kstate.get(state, kstate.DISK_DEV) == DEV_AHCI {
        return ahci_read_cached(state, abs, dst,
            kstate.get(state, kstate.DISK_FIRST) + blocks(state))
    }
    let base: u64 = kstate.get(state, kstate.DISK)
    if base == 0 {
        return false
    }
    copy(base + abs * BLOCK_SIZE, dst)
    return true
}

fn write(state: u64, lba: u64, src: u64) -> bool {
    if cryptstate.active(state) {
        return write_crypt(state, lba, src)
    }
    return write_raw(state, lba, src)
}

fn write_raw(state: u64, lba: u64, src: u64) -> bool {
    let g: u64 = blkguard.enter(state)
    if g == blkguard.G_REFUSE {
        return false
    }
    let ok: bool = write_raw_held(state, lba, src)
    blkguard.leave(state, g)
    return ok
}

fn write_raw_held(state: u64, lba: u64, src: u64) -> bool {
    if lba >= blocks(state) {
        return false
    }
    let abs: u64 = lba + kstate.get(state, kstate.DISK_FIRST)
    let wdv: u64 = kstate.get(state, kstate.DISK_DEV)
    let ok: bool = write_raw_store(state, wdv, abs, src)
    if ok {
        blkstat.note_write(wdv, 1)
        cache_put(state, wdv, abs, src)
    } else {
        cache_drop(state, wdv, abs)
    }
    return ok
}

fn write_raw_store(state: u64, wdv: u64, abs: u64, src: u64) -> bool {
    if wb_dev(wdv, state) && wb_active(state) {
        return wb_put(state, wdv, abs, src)
    }
    if wb_dev(wdv, state) && wb_overlap(state, wdv, abs, 1) {
        return wb_put(state, wdv, abs, src)
    }
    if kstate.get(state, kstate.DISK_DEV) == DEV_ATA {
        return ata_write_twice(abs, src, false)
    }
    if kstate.get(state, kstate.DISK_DEV) == DEV_ATA1 {
        return ata_write_twice(abs, src, true)
    }
    if kstate.get(state, kstate.DISK_DEV) == DEV_NVME {
        return nvme.write_block(state, abs, src)
    }
    if kstate.get(state, kstate.DISK_DEV) == DEV_AHCI {
        return ahci.write_block(state, abs, src)
    }
    if is_usb(wdv) {
        return mscbind.write_at(state, usb_slot(wdv), abs, src)
    }
    let base: u64 = kstate.get(state, kstate.DISK)
    if base == 0 {
        return false
    }
    copy(src, base + abs * BLOCK_SIZE)
    return true
}

// r728: write n consecutive sectors (volume-relative lba). Plain ATA and AHCI
// get multi-sector commands (the read-ahead cache is dropped for the range);
// every other path (encryption, NVMe, USB, RAM) stays sector by
// sector through `write`, so their behaviour does not change at all.
fn write_run(state: u64, lba: u64, src: u64, n: u64) -> bool {
    let g: u64 = blkguard.enter(state)
    if g == blkguard.G_REFUSE {
        return false
    }
    let ok: bool = write_run_held(state, lba, src, n)
    blkguard.leave(state, g)
    return ok
}

fn run_dev(state: u64, dv: u64) -> bool {
    if dv == DEV_ATA || dv == DEV_ATA1 {
        return true
    }
    return dv == DEV_AHCI && !kstate.mode_on(state, kstate.M_NOWBDEV)
}

fn write_run_held(state: u64, lba: u64, src: u64, n: u64) -> bool {
    dma_up(state)
    if n == 0 {
        return true
    }
    let dv: u64 = kstate.get(state, kstate.DISK_DEV)
    if wb_dev(dv, state) && cg(state, W_DEPTH) == 0 {
        wb_flush(state)
    }
    if cryptstate.active(state) || !run_dev(state, dv) {
        var k: u64 = 0
        while k < n {
            if !write(state, lba + k, src + k * BLOCK_SIZE) {
                return false
            }
            k = k + 1
        }
        return true
    }
    if lba + n > blocks(state) {
        return false
    }
    let abs: u64 = lba + kstate.get(state, kstate.DISK_FIRST)
    var done: u64 = 0
    while done < n {
        var c: u64 = n - done
        if c > 128 {
            c = 128
        }
        let wrote: bool = wb_dev_run(state, dv, abs + done, src + done * BLOCK_SIZE, c)
        if wrote {
            blkstat.note_write(dv, c)
        }
        var j: u64 = 0
        while j < c {
            if wrote {
                cache_put(state, dv, abs + done + j, src + (done + j) * BLOCK_SIZE)
            } else {
                cache_drop(state, dv, abs + done + j)
            }
            j = j + 1
        }
        if !wrote {
            return false
        }
        done = done + c
    }
    return true
}
