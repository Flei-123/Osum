
profile kernel

import serial
import lib.kstate
import bus.pci
import block.blk
import fs.fs
import block.part
import drv.blk.nvme
import drv.blk.ahci
import usb.usb
import drv.usb.ehci
import mm.mmframe
import block.blkdev
import block.bootdev
import crypto.cryptboot
import crypto.krypto

export {
    scan, report, mount_root, order_line,
    K_NONE, K_NVME, K_AHCI, K_USB, K_IDE,
    W_RAID, W_SATA_LEGACY, W_SD, W_SAS, W_SCSI, W_OTHER,
    cands, cand_kind, cand_bdf, cand_ven, cand_dev,
    warns, warn_kind, warn_bdf, warn_ven, warn_dev,
    hcs, hc_progif, hc_bdf,
    picked, picked_first, picked_blocks, tried,
    ROOT_OFF, ROOT_MAX
}

const ROOT_OFF: u64 = 0x85000
const ROOT_MAX: u64 = 0x1000

const S_SCANNED: u64 = 0x00
const S_NCAND: u64 = 0x08
const S_NWARN: u64 = 0x10
const S_NHC: u64 = 0x18
const S_PICKED: u64 = 0x20
const S_FIRST: u64 = 0x28
const S_BLOCKS: u64 = 0x30
const S_TRIED: u64 = 0x38

const MAX_CAND: u64 = 8
const MAX_WARN: u64 = 8
const MAX_HC: u64 = 8
const ENT: u64 = 40

const L_CAND: u64 = 0x100
const L_WARN: u64 = 0x300
const L_HC: u64 = 0x500

const E_KIND: u64 = 0
const E_BDF: u64 = 8
const E_VEN: u64 = 16
const E_DEV: u64 = 24
const E_EXTRA: u64 = 32

const K_NONE: u64 = bootdev.K_NONE
const K_NVME: u64 = bootdev.K_NVME
const K_AHCI: u64 = bootdev.K_AHCI
const K_USB: u64 = bootdev.K_USB
const K_IDE: u64 = bootdev.K_IDE

const W_RAID: u64 = 1
const W_SATA_LEGACY: u64 = 2
const W_SD: u64 = 3
const W_SAS: u64 = 4
const W_SCSI: u64 = 5
const W_OTHER: u64 = 6

const SUB_SCSI: u64 = 0x00
const SUB_RAID: u64 = 0x04
const SUB_SAS: u64 = 0x07
const CLASS_SERIAL: u64 = 0x0C
const SUB_USBHC: u64 = 0x03
const CLASS_BASE: u64 = 0x08
const SUB_SD: u64 = 0x05

fn sc(off: u64) -> u64 {
    return ROOT_OFF + off
}

fn ent(list: u64, i: u64, f: u64) -> u64 {
    return ROOT_OFF + list + i * ENT + f
}

fn add(state: u64, list: u64, cntoff: u64, cap: u64, kind: u64,
    bdf: u64, ven: u64, dev: u64, extra: u64) {
    let n: u64 = kstate.get(state, sc(cntoff))
    if n >= cap {
        kstate.set(state, sc(cntoff), n + 1)
        return
    }
    kstate.set(state, ent(list, n, E_KIND), kind)
    kstate.set(state, ent(list, n, E_BDF), bdf)
    kstate.set(state, ent(list, n, E_VEN), ven)
    kstate.set(state, ent(list, n, E_DEV), dev)
    kstate.set(state, ent(list, n, E_EXTRA), extra)
    kstate.set(state, sc(cntoff), n + 1)
}

fn add_cand(state: u64, kind: u64, bdf: u64, ven: u64, dev: u64) {
    let n: u64 = kstate.get(state, sc(S_NCAND))
    if n >= MAX_CAND {
        kstate.set(state, sc(S_NCAND), n + 1)
        return
    }
    var i: u64 = n
    while i > 0 {
        if kstate.get(state, ent(L_CAND, i - 1, E_KIND)) <= kind {
            break
        }
        kstate.set(state, ent(L_CAND, i, E_KIND),
            kstate.get(state, ent(L_CAND, i - 1, E_KIND)))
        kstate.set(state, ent(L_CAND, i, E_BDF),
            kstate.get(state, ent(L_CAND, i - 1, E_BDF)))
        kstate.set(state, ent(L_CAND, i, E_VEN),
            kstate.get(state, ent(L_CAND, i - 1, E_VEN)))
        kstate.set(state, ent(L_CAND, i, E_DEV),
            kstate.get(state, ent(L_CAND, i - 1, E_DEV)))
        i = i - 1
    }
    kstate.set(state, ent(L_CAND, i, E_KIND), kind)
    kstate.set(state, ent(L_CAND, i, E_BDF), bdf)
    kstate.set(state, ent(L_CAND, i, E_VEN), ven)
    kstate.set(state, ent(L_CAND, i, E_DEV), dev)
    kstate.set(state, ent(L_CAND, i, E_EXTRA), 0)
    kstate.set(state, sc(S_NCAND), n + 1)
}

fn scan(state: u64) {
    if kstate.get(state, sc(S_SCANNED)) != 0 {
        return
    }
    kstate.set(state, sc(S_SCANNED), 1)
    kstate.set(state, sc(S_NCAND), 0)
    kstate.set(state, sc(S_NWARN), 0)
    kstate.set(state, sc(S_NHC), 0)
    kstate.set(state, sc(S_PICKED), K_NONE)
    kstate.set(state, sc(S_FIRST), 0)
    kstate.set(state, sc(S_BLOCKS), 0)
    kstate.set(state, sc(S_TRIED), 0)

    let n: u64 = pci.count(state)
    var i: u64 = 0
    while i < n {
        let cls: u64 = pci.get(state, i, pci.E_CLASS)
        let sub: u64 = pci.get(state, i, pci.E_SUBCLASS)
        let pif: u64 = pci.get(state, i, pci.E_PROGIF)
        let bdf: u64 = pci.get(state, i, pci.E_BDF)
        let ven: u64 = pci.get(state, i, pci.E_VENDOR)
        let dev: u64 = pci.get(state, i, pci.E_DEVICE)
        if cls == pci.CLASS_STORAGE {
            if sub == pci.SUB_NVM && pif == pci.PROGIF_NVME {
                add_cand(state, K_NVME, bdf, ven, dev)
            } else if sub == pci.SUB_SATA && pif == pci.PROGIF_AHCI {
                add_cand(state, K_AHCI, bdf, ven, dev)
            } else if sub == pci.SUB_IDE {
                add_cand(state, K_IDE, bdf, ven, dev)
            } else if sub == SUB_RAID && ven == pci.VENDOR_INTEL {
                add_cand(state, K_AHCI, bdf, ven, dev)
            } else if sub == SUB_RAID {
                add(state, L_WARN, S_NWARN, MAX_WARN, W_RAID, bdf, ven, dev, sub)
            } else if sub == pci.SUB_SATA {
                add(state, L_WARN, S_NWARN, MAX_WARN, W_SATA_LEGACY,
                    bdf, ven, dev, pif)
            } else if sub == SUB_SAS {
                add(state, L_WARN, S_NWARN, MAX_WARN, W_SAS, bdf, ven, dev, sub)
            } else if sub == SUB_SCSI {
                add(state, L_WARN, S_NWARN, MAX_WARN, W_SCSI, bdf, ven, dev, sub)
            } else {
                add(state, L_WARN, S_NWARN, MAX_WARN, W_OTHER, bdf, ven, dev, sub)
            }
        } else if cls == CLASS_SERIAL && sub == SUB_USBHC {
            add(state, L_HC, S_NHC, MAX_HC, pif, bdf, ven, dev, sub)
        } else if cls == CLASS_BASE && sub == SUB_SD {
            add(state, L_WARN, S_NWARN, MAX_WARN, W_SD, bdf, ven, dev, sub)
        }
        i = i + 1
    }
    if kstate.get(state, sc(S_NHC)) > 0 {
        add_cand(state, K_USB, kstate.get(state, ent(L_HC, 0, E_BDF)),
            kstate.get(state, ent(L_HC, 0, E_VEN)),
            kstate.get(state, ent(L_HC, 0, E_DEV)))
    }
}

fn cands(state: u64) -> u64 {
    scan(state)
    return kstate.get(state, sc(S_NCAND))
}

fn cand_kind(state: u64, i: u64) -> u64 {
    if i >= MAX_CAND {
        return K_NONE
    }
    return kstate.get(state, ent(L_CAND, i, E_KIND))
}

fn cand_bdf(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_CAND, i, E_BDF))
}

fn cand_ven(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_CAND, i, E_VEN))
}

fn cand_dev(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_CAND, i, E_DEV))
}

fn warns(state: u64) -> u64 {
    scan(state)
    return kstate.get(state, sc(S_NWARN))
}

fn warn_kind(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_WARN, i, E_KIND))
}

fn warn_bdf(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_WARN, i, E_BDF))
}

fn warn_ven(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_WARN, i, E_VEN))
}

fn warn_dev(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_WARN, i, E_DEV))
}

fn hcs(state: u64) -> u64 {
    scan(state)
    return kstate.get(state, sc(S_NHC))
}

fn hc_progif(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_HC, i, E_KIND))
}

fn hc_bdf(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_HC, i, E_BDF))
}

fn picked(state: u64) -> u64 {
    return kstate.get(state, sc(S_PICKED))
}

fn picked_first(state: u64) -> u64 {
    return kstate.get(state, sc(S_FIRST))
}

fn picked_blocks(state: u64) -> u64 {
    return kstate.get(state, sc(S_BLOCKS))
}

fn tried(state: u64) -> u64 {
    return kstate.get(state, sc(S_TRIED))
}

fn tag() {
    var s: [u8; 10] = "rootsel: \0"
    serial.puts((&s[0]) as u64)
}

fn kind_name(k: u64) {
    var s_nv: [u8; 5] = "nvme\0"
    var s_ah: [u8; 5] = "ahci\0"
    var s_us: [u8; 4] = "usb\0"
    var s_id: [u8; 4] = "ide\0"
    var s_no: [u8; 6] = "keins\0"
    if k == K_NVME {
        serial.puts((&s_nv[0]) as u64)
        return
    }
    if k == K_AHCI {
        serial.puts((&s_ah[0]) as u64)
        return
    }
    if k == K_USB {
        serial.puts((&s_us[0]) as u64)
        return
    }
    if k == K_IDE {
        serial.puts((&s_id[0]) as u64)
        return
    }
    serial.puts((&s_no[0]) as u64)
}

fn nums(ven: u64, dev: u64) {
    pci.hexn(ven, 4)
    serial.put(58 as u8)
    pci.hexn(dev, 4)
}

fn order_line(state: u64) {
    var s_h: [u8; 12] = "reihenfolge\0"
    var s_ar: [u8; 4] = " > \0"
    var s_no: [u8; 35] = "order: EMPTY -- no disk controller\0"
    scan(state)
    let n: u64 = kstate.get(state, sc(S_NCAND))
    if n == 0 {
        tag()
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    tag()
    serial.puts((&s_h[0]) as u64)
    serial.put(58 as u8)
    serial.put(32 as u8)
    var i: u64 = 0
    var lim: u64 = n
    if lim > MAX_CAND {
        lim = MAX_CAND
    }
    while i < lim {
        if i > 0 {
            serial.puts((&s_ar[0]) as u64)
        }
        kind_name(kstate.get(state, ent(L_CAND, i, E_KIND)))
        i = i + 1
    }
    serial.nl()
}

fn warn_lines(state: u64) {
    var s_raid1: [u8; 25] = " is in RAID mode (01:04)\0"
    var s_raid2: [u8; 58] = "set BIOS \"SATA Mode\" from RAID/RST to AHCI, then reboot\0\0\0"
    var s_leg: [u8; 36] = " is SATA but not AHCI -- interface \0"
    var s_sd: [u8; 41] = " is an SD/eMMC controller -- no driver\0\0\0"
    var s_sas: [u8; 22] = " is SAS -- no driver\0\0"
    var s_scsi: [u8; 23] = " is SCSI -- no driver\0\0"
    var s_oth: [u8; 44] = " is a disk controller without driver (01:\0\0\0"
    var s_cl: [u8; 2] = ")\0"
    let n: u64 = kstate.get(state, sc(S_NWARN))
    var i: u64 = 0
    var lim: u64 = n
    if lim > MAX_WARN {
        lim = MAX_WARN
    }
    while i < lim {
        let k: u64 = kstate.get(state, ent(L_WARN, i, E_KIND))
        tag()
        nums(kstate.get(state, ent(L_WARN, i, E_VEN)),
            kstate.get(state, ent(L_WARN, i, E_DEV)))
        if k == W_RAID {
            serial.puts((&s_raid1[0]) as u64)
            serial.nl()
            tag()
            serial.puts((&s_raid2[0]) as u64)
        } else if k == W_SATA_LEGACY {
            serial.puts((&s_leg[0]) as u64)
            pci.hexn(kstate.get(state, ent(L_WARN, i, E_EXTRA)), 2)
        } else if k == W_SD {
            serial.puts((&s_sd[0]) as u64)
        } else if k == W_SAS {
            serial.puts((&s_sas[0]) as u64)
        } else if k == W_SCSI {
            serial.puts((&s_scsi[0]) as u64)
        } else {
            serial.puts((&s_oth[0]) as u64)
            pci.hexn(kstate.get(state, ent(L_WARN, i, E_EXTRA)), 2)
            serial.puts((&s_cl[0]) as u64)
        }
        serial.nl()
        i = i + 1
    }
}

fn hc_lines(state: u64) {
    var s_x: [u8; 19] = "usb xHCI    bdf=\0\0\0"
    var s_e: [u8; 19] = "usb EHCI    bdf=\0\0\0"
    var s_o: [u8; 19] = "usb OHCI    bdf=\0\0\0"
    var s_u: [u8; 19] = "usb UHCI    bdf=\0\0\0"
    var s_a: [u8; 19] = "usb andere  bdf=\0\0\0"
    var s_nd: [u8; 17] = "  (kein Treiber)\0"
    let n: u64 = kstate.get(state, sc(S_NHC))
    var i: u64 = 0
    var lim: u64 = n
    if lim > MAX_HC {
        lim = MAX_HC
    }
    while i < lim {
        let p: u64 = kstate.get(state, ent(L_HC, i, E_KIND))
        tag()
        if p == 0x30 {
            serial.puts((&s_x[0]) as u64)
        } else if p == 0x20 {
            serial.puts((&s_e[0]) as u64)
        } else if p == 0x10 {
            serial.puts((&s_o[0]) as u64)
        } else if p == 0x00 {
            serial.puts((&s_u[0]) as u64)
        } else {
            serial.puts((&s_a[0]) as u64)
        }
        serial.hex(kstate.get(state, ent(L_HC, i, E_BDF)))
        serial.put(32 as u8)
        nums(kstate.get(state, ent(L_HC, i, E_VEN)),
            kstate.get(state, ent(L_HC, i, E_DEV)))
        if p < 0x20 {
            serial.puts((&s_nd[0]) as u64)
        }
        serial.nl()
        i = i + 1
    }
}

fn report(state: u64) {
    var s_over: [u8; 37] = "more devices than slots in the list\0\0"
    scan(state)
    blkdev.print_disks(state)
    blkdev.selftest(state)
    hc_lines(state)
    if kstate.get(state, sc(S_NCAND)) > MAX_CAND
        || kstate.get(state, sc(S_NWARN)) > MAX_WARN
        || kstate.get(state, sc(S_NHC)) > MAX_HC {
        tag()
        serial.puts((&s_over[0]) as u64)
        serial.nl()
    }
}

const TRY_BLOCKS: u64 = 4096

fn blkdev_kind(k: u64) -> u64 {
    if k == blkdev.KIND_NVME {
        return K_NVME
    }
    if k == blkdev.KIND_AHCI {
        return K_AHCI
    }
    if k == blkdev.KIND_USB {
        return K_USB
    }
    if k == blkdev.KIND_ATA {
        return K_IDE
    }
    return K_NONE
}

fn try_mount_on(state: u64, dev: u64, blocks_n: u64) -> bool {
    blk.use_at(state, dev, 0, blocks_n)
    if fs.mount(state) {
        kstate.set(state, sc(S_FIRST), 0)
        kstate.set(state, sc(S_BLOCKS), blocks_n)
        return true
    }
    let n: u64 = part.scan(state, dev)
    if n == 0 {
        return false
    }
    let i: u64 = part.find_root(state, dev)
    if i >= part.MAX_PARTS {
        return false
    }
    let first: u64 = part.start(state, i)
    let cnt: u64 = part.blocks(state, i)
    let cr: u64 = cryptboot.boot_unlock(state, dev, first)
    if cr == cryptboot.R_FAIL {
        return false
    }
    if cr == cryptboot.R_PLAIN {
        blk.use_at(state, dev, first, cnt)
    }
    if !fs.mount(state) {
        return false
    }
    kstate.set(state, kstate.ROOT_PART, i)
    kstate.set(state, sc(S_FIRST), first)
    kstate.set(state, sc(S_BLOCKS), cnt)
    return true
}

const DEV_BAD: u64 = 0xFF

fn bring_up(state: u64, kind: u64) -> u64 {
    if kind == K_NVME {
        if !nvme.present(state) {
            return DEV_BAD
        }
        if nvme.blocks(state) == 0 {
            if !nvme.init(state, true, true) {
                return DEV_BAD
            }
        }
        if nvme.blocks(state) == 0 {
            return DEV_BAD
        }
        return blk.DEV_NVME
    }
    if kind == K_AHCI {
        if ahci.mode(state) != ahci.MODE_AHCI {
            if !ahci.init(state) {
                return DEV_BAD
            }
        }
        if !ahci.present(state) {
            return DEV_BAD
        }
        return blk.DEV_AHCI
    }
    if kind == K_USB {
        if ehci.ensure(state) && kstate.get(state, kstate.BITMAP) != 0 {
            ehci.bounce_set(state, mmframe.frame_run(state, ehci.BOUNCE_PAGES))
        }
        var si: u64 = 0
        while si < usb.MAX_MSC {
            if usb.msc_ready_at(state, si) {
                return blk.usb_dev(si)
            }
            si = si + 1
        }
        return DEV_BAD
    }
    if kind == K_IDE {
        if !blk.present(state) {
            return DEV_BAD
        }
        return blk.DEV_ATA
    }
    return DEV_BAD
}

fn blocks_of(state: u64, kind: u64, dev: u64) -> u64 {
    if kind == K_NVME {
        return nvme.blocks(state)
    }
    if kind == K_AHCI {
        return ahci.blocks(state)
    }
    if kind == K_USB {
        return usb.msc_blocks_at(state, blk.usb_slot(dev))
    }
    let c: u64 = blk.blocks_on(state, dev)
    if c == 0 {
        return TRY_BLOCKS
    }
    return c
}

fn kind_locked(kind: u64, skip_nvme: bool, skip_ahci: bool) -> bool {
    return (kind == K_NVME && skip_nvme) || (kind == K_AHCI && skip_ahci)
}

fn try_kind(state: u64, kind: u64, locked: bool) -> bool {
    var s_try: [u8; 9] = "versuch \0"
    var s_up: [u8; 16] = " -- kommt nicht\0"
    var s_ok: [u8; 22] = " -- WURZEL, Bloecke=\0\0"
    var s_nx: [u8; 18] = " -- no root on it\0"
    var s_fi: [u8; 10] = "  first=\0\0"
    var s_skip: [u8; 35] = " -- uebersprungen, gehoert hw.disk\0"
    kstate.set(state, sc(S_TRIED), kstate.get(state, sc(S_TRIED)) + 1)
    tag()
    serial.puts((&s_try[0]) as u64)
    kind_name(kind)
    serial.nl()
    if locked {
        tag()
        kind_name(kind)
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return false
    }
    let dev: u64 = bring_up(state, kind)
    if dev == DEV_BAD {
        tag()
        kind_name(kind)
        serial.puts((&s_up[0]) as u64)
        serial.nl()
        return false
    }
    if try_mount_on(state, dev, blocks_of(state, kind, dev)) {
        kstate.set(state, sc(S_PICKED), kind)
        tag()
        kind_name(kind)
        serial.puts((&s_ok[0]) as u64)
        serial.dec(kstate.get(state, sc(S_BLOCKS)))
        serial.puts((&s_fi[0]) as u64)
        serial.dec(kstate.get(state, sc(S_FIRST)))
        serial.nl()
        return true
    }
    tag()
    kind_name(kind)
    serial.puts((&s_nx[0]) as u64)
    serial.nl()
    return false
}

fn has_kind(state: u64, kind: u64) -> bool {
    let lim: u64 = blkdev.disks(state)
    var i: u64 = 0
    while i < lim {
        if blkdev_kind(blkdev.kind_at(state, i)) == kind {
            return true
        }
        i = i + 1
    }
    return false
}

fn mount_root(state: u64, skip_nvme: bool, skip_ahci: bool, first_kind: u64) -> bool {
    var s_none: [u8; 38] = "no device carries a root -- end here\0\0"
    scan(state)
    var tried_first: bool = false
    if first_kind != K_NONE && has_kind(state, first_kind) {
        tried_first = true
        if try_kind(state, first_kind, kind_locked(first_kind, skip_nvme, skip_ahci)) {
            return true
        }
    }
    let lim: u64 = blkdev.disks(state)
    var i: u64 = 0
    while i < lim {
        let kind: u64 = blkdev_kind(blkdev.kind_at(state, i))
        if !(tried_first && kind == first_kind) {
            if try_kind(state, kind, kind_locked(kind, skip_nvme, skip_ahci)) {
                return true
            }
        }
        i = i + 1
    }
    tag()
    serial.puts((&s_none[0]) as u64)
    serial.nl()
    return false
}
