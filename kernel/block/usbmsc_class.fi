profile kernel

import usb.usb
import block.blk
import block.blockclass

export { ops }

fn ready(state: u64, i: u64) -> bool {
    return usb.msc_ready(state)
}

fn blocks(state: u64, i: u64) -> u64 {
    return usb.msc_blocks(state)
}

fn bsize(state: u64, i: u64) -> u64 {
    return usb.msc_bsize(state)
}

fn flush(state: u64, i: u64) -> bool {
    return true
}

fn ops() -> blockclass.BlockOps {
    return blockclass.BlockOps {
        init: ready,
        present: ready,
        blocks: blocks,
        bsize: bsize,
        flush: flush,
        dev: blk.DEV_USB,
        caps: blockclass.CAP_REMOVABLE,
        tag: 0x627375
    }
}
