
profile kernel

import lib.kstate
import serial
import block.blk
import block.part
import fs.vfs
import fs.vfsops
import fs.mnt
import fs.fat
import fs.exfat
import block.fsdetect
import block.wlock
import bus.bus
import lib.errno
import lib.kutil
import libc.numeric

export {
    init, kommt, geht, eject, ready_v,
    count, carrier_dev, carrier_mnt, carrier_path, carrier_blocks,
    ereignisse, angesteckt, abgezogen, ausgeworfen, err,
    last_event, EV_NONE, EV_KOMMT, EV_GEHT, EV_AUS,
    MAX_CARRIERS, say, gesamt_sync, fs_erkennen,
    hat_dev,
    FS_UNBEKANNT, media_path
}

const MAX_CARRIERS: u64 = 8
const T_BYTES: u64 = 64
const T_BASIS: u64 = 0x100

const T_USED: u64 = 0
const T_DEV: u64 = 8
const T_MNT: u64 = 16
const T_FIRST: u64 = 24
const T_BLOCKS: u64 = 32
const T_FSTYPE: u64 = 40
const T_PATH: u64 = 48

const S_READY: u64 = 0x00
const S_N: u64 = 0x08
const S_KOMMT: u64 = 0x10
const S_GEHT: u64 = 0x18
const S_AUS: u64 = 0x20
const S_ERROR: u64 = 0x28
const S_EVENTS: u64 = 0x30
const S_LASTEV: u64 = 0x38
const S_SYNCS: u64 = 0x40

const EV_NONE: u64 = 0
const EV_KOMMT: u64 = 1
const EV_GEHT: u64 = 2
const EV_AUS: u64 = 3

const FS_UNBEKANNT: u64 = 0

fn basis(state: u64) -> u64 {
    return state + kstate.WECHSEL_OFF
}

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.WECHSEL_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.WECHSEL_OFF + off, v)
}

fn at(state: u64, i: u64) -> u64 {
    return basis(state) + T_BASIS + i * T_BYTES
}

fn tg(state: u64, i: u64, f: u64) -> u64 {
    if i >= MAX_CARRIERS {
        return 0
    }
    return kstate.get(state, kstate.WECHSEL_OFF + T_BASIS + i * T_BYTES + f)
}

fn ts(state: u64, i: u64, f: u64, v: u64) {
    if i >= MAX_CARRIERS {
        return
    }
    kstate.set(state, kstate.WECHSEL_OFF + T_BASIS + i * T_BYTES + f, v)
}

fn ready_v(state: u64) -> bool {
    return g(state, S_READY) != 0
}

fn count(state: u64) -> u64 {
    return g(state, S_N)
}

fn carrier_dev(state: u64, i: u64) -> u64 {
    return tg(state, i, T_DEV)
}

fn carrier_mnt(state: u64, i: u64) -> u64 {
    return tg(state, i, T_MNT)
}

fn carrier_blocks(state: u64, i: u64) -> u64 {
    return tg(state, i, T_BLOCKS)
}

fn carrier_path(state: u64, i: u64) -> u64 {
    if i >= MAX_CARRIERS {
        return 0
    }
    return at(state, i) + T_PATH
}

fn ereignisse(state: u64) -> u64 {
    return g(state, S_EVENTS)
}

fn angesteckt(state: u64) -> u64 {
    return g(state, S_KOMMT)
}

fn abgezogen(state: u64) -> u64 {
    return g(state, S_GEHT)
}

fn ausgeworfen(state: u64) -> u64 {
    return g(state, S_AUS)
}

fn err(state: u64) -> u64 {
    return g(state, S_ERROR)
}

fn last_event(state: u64) -> u64 {
    return g(state, S_LASTEV)
}

fn gesamt_sync(state: u64) -> u64 {
    return g(state, S_SYNCS)
}

fn init(state: u64) {
    var i: u64 = 0
    while i < MAX_CARRIERS * T_BYTES + T_BASIS {
        kstate.set8(basis(state) + i, 0 as u8)
        i = i + 1
    }
    s(state, S_READY, 1)
}

fn build_path(state: u64, i: u64) {
    let p: u64 = at(state, i) + T_PATH
    kstate.set8(p + 0, 47 as u8)
    kstate.set8(p + 1, 109 as u8)
    kstate.set8(p + 2, 101 as u8)
    kstate.set8(p + 3, 100 as u8)
    kstate.set8(p + 4, 105 as u8)
    kstate.set8(p + 5, 101 as u8)
    kstate.set8(p + 6, 110 as u8)
    kstate.set8(p + 7, 47 as u8)
    kstate.set8(p + 8, 117 as u8)
    kstate.set8(p + 9, 115 as u8)
    kstate.set8(p + 10, 98 as u8)
    kstate.set8(p + 11, (48 + (i % 10)) as u8)
    kstate.set8(p + 12, 0 as u8)
}

static mut p_medien: [u8; 8] = "/medien\0"

fn media_path() -> u64 {
    return (&p_medien[0]) as u64
}

fn fs_erkennen(state: u64, dev: u64, first: u64) -> u64 {
    let buf: u64 = basis(state) + T_BASIS + MAX_CARRIERS * T_BYTES
    var i: u64 = 0
    while i < 512 {
        kstate.set8(buf + i, 0 as u8)
        i = i + 1
    }
    if !blk.read_on(state, dev, first, buf) {
        return FS_UNBEKANNT
    }
    return fsdetect.classify(buf)
}

fn space_free(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_CARRIERS {
        if tg(state, i, T_USED) == 0 {
            return i
        }
        i = i + 1
    }
    return MAX_CARRIERS
}

fn hat_dev(state: u64, dev: u64) -> bool {
    return space_of_dev(state, dev) < MAX_CARRIERS
}

fn space_of_dev(state: u64, dev: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_CARRIERS {
        if tg(state, i, T_USED) != 0 && tg(state, i, T_DEV) == dev {
            return i
        }
        i = i + 1
    }
    return MAX_CARRIERS
}

fn report(state: u64, art: u64, i: u64) {
    var txt: [u8; 32] = [0 as u8; 32]
    txt[0] = 117 as u8
    txt[1] = 115 as u8
    txt[2] = 98 as u8
    var z: u64 = 43
    if art == EV_GEHT {
        z = 45
    } else if art == EV_AUS {
        z = 94
    }
    txt[3] = z as u8
    txt[4] = 32 as u8
    var n: u64 = 5
    if i < MAX_CARRIERS {
        let p: u64 = at(state, i) + T_PATH
        var k: u64 = 0
        while k < 16 && n < 30 {
            let c: u64 = kstate.get8(p + k)
            if c == 0 {
                k = 16
            } else {
                txt[n as usize] = c as u8
                n = n + 1
                k = k + 1
            }
        }
    }
    if art == EV_KOMMT && i < MAX_CARRIERS {
        let mib: u64 = tg(state, i, T_BLOCKS) / 2048
        if mib > 0 && n < 22 {
            txt[n as usize] = 32 as u8
            n = n + 1
            var div: u64 = 1000000
            while div > 1 && mib / div == 0 {
                div = div / 10
            }
            while div > 0 && n < 30 {
                txt[n as usize] = (48 + (mib / div) % 10) as u8
                n = n + 1
                div = div / 10
            }
        }
    }
    txt[n as usize] = 0 as u8
    s(state, S_LASTEV, art)
    s(state, S_EVENTS, g(state, S_EVENTS) + 1)
    let _r: u64 = bus.noti_post(state, 0, 1, n, (&txt[0]) as u64)
}

fn kommt(state: u64, dev: u64) -> u64 {
    var s_h: [u8; 16] = "wechsel: kommt \0"
    var s_d: [u8; 6] = "dev=\0\0"
    var s_p: [u8; 9] = "  parts=\0"
    var s_f: [u8; 9] = "  first=\0"
    var s_n: [u8; 10] = "  blocks=\0"
    var s_t: [u8; 7] = "  fs=\0\0"
    var s_m: [u8; 9] = "  mount=\0"
    var s_already: [u8; 34] = "wechsel: dev already in the table\0"
    var s_voll: [u8; 22] = "wechsel: no free slot\0"
    var s_kein: [u8; 35] = "wechsel: kein Dateisystem erkannt\0\0"

    if !ready_v(state) {
        init(state)
    }
    if !vfs.ready(state) {
        vfs.init(state)
        if !vfs.mount_root(state) {
            return MAX_CARRIERS
        }
    }
    let root: u64 = vfs.mount_for(state, (&p_medien[0]) as u64)
    if root < vfs.MAX_MNT {
        let _md: u64 = vfs.v_create(state, root,
            (&p_medien[0]) as u64, vfsops.N_DIR)
    }
    if space_of_dev(state, dev) < MAX_CARRIERS {
        serial.puts((&s_already[0]) as u64)
        serial.nl()
        return MAX_CARRIERS
    }
    let i: u64 = space_free(state)
    if i >= MAX_CARRIERS {
        serial.puts((&s_voll[0]) as u64)
        serial.nl()
        s(state, S_ERROR, g(state, S_ERROR) + 1)
        return MAX_CARRIERS
    }
    s(state, S_KOMMT, g(state, S_KOMMT) + 1)

    var first: u64 = 0
    var anz: u64 = blk.blocks_on(state, dev)
    let nparts: u64 = part.scan(state, dev)
    var fstyp: u64 = FS_UNBEKANNT
    if nparts != 0 {
        var k: u64 = 0
        while k < part.MAX_PARTS && fstyp == FS_UNBEKANNT {
            if part.dev_of(state, k) == dev && part.blocks(state, k) != 0 {
                let st: u64 = part.start(state, k)
                let t: u64 = fs_erkennen(state, dev, st)
                if t != FS_UNBEKANNT {
                    fstyp = t
                    first = st
                    anz = part.blocks(state, k)
                }
            }
            k = k + 1
        }
    }
    if fstyp == FS_UNBEKANNT {
        fstyp = fs_erkennen(state, dev, 0)
        first = 0
        anz = blk.blocks_on(state, dev)
    }

    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_d[0]) as u64)
    serial.dec(dev)
    serial.puts((&s_p[0]) as u64)
    serial.dec(nparts)
    serial.puts((&s_f[0]) as u64)
    serial.dec(first)
    serial.puts((&s_n[0]) as u64)
    serial.dec(anz)
    serial.puts((&s_t[0]) as u64)
    serial.dec(fstyp)

    if fstyp == FS_UNBEKANNT {
        serial.puts((&s_m[0]) as u64)
        serial.dec(0)
        serial.nl()
        serial.puts((&s_kein[0]) as u64)
        serial.nl()
        s(state, S_ERROR, g(state, S_ERROR) + 1)
        return MAX_CARRIERS
    }

    ts(state, i, T_USED, 1)
    ts(state, i, T_DEV, dev)
    ts(state, i, T_FIRST, first)
    ts(state, i, T_BLOCKS, anz)
    ts(state, i, T_FSTYPE, fstyp)
    build_path(state, i)

    let over: u64 = vfs.mount_for(state, at(state, i) + T_PATH)
    if over < vfs.MAX_MNT {
        let _mk: u64 = vfs.v_create(state, over,
            at(state, i) + T_PATH, vfsops.N_DIR)
    }
    let m: u64 = vfs.mount_at(state, fstyp, dev, first, anz,
        at(state, i) + T_PATH, 0)
    serial.puts((&s_m[0]) as u64)
    serial.dec(numeric.yes(m < vfs.MAX_MNT))
    serial.nl()
    if m >= vfs.MAX_MNT {
        ts(state, i, T_USED, 0)
        s(state, S_ERROR, g(state, S_ERROR) + 1)
        return MAX_CARRIERS
    }
    ts(state, i, T_MNT, m)
    wlock.unlock(dev)
    s(state, S_N, g(state, S_N) + 1)
    report(state, EV_KOMMT, i)
    return i
}

fn geht(state: u64, dev: u64) -> u64 {
    var s_h: [u8; 22] = "wechsel: geht  dev=\0\0\0"
    var s_m: [u8; 8] = "  mnt=\0\0"
    var s_o: [u8; 10] = "  opens=\0\0"
    if !ready_v(state) {
        return 0
    }
    var n: u64 = 0
    var i: u64 = 0
    while i < MAX_CARRIERS {
        if tg(state, i, T_USED) != 0 && tg(state, i, T_DEV) == dev {
            let m: u64 = tg(state, i, T_MNT)
            serial.puts((&s_h[0]) as u64)
            serial.dec(dev)
            serial.puts((&s_m[0]) as u64)
            serial.dec(m)
            serial.puts((&s_o[0]) as u64)
            serial.dec(mnt.opens(state, m))
            serial.nl()
            if mnt.used(state, m) && mnt.dev(state, m) == dev {
                if mnt.fstype(state, m) == vfsops.FS_FAT {
                    fat.release(state, m)
                } else if mnt.fstype(state, m) == vfsops.FS_EXFAT {
                    exfat.release(state, m)
                }
                mnt.free(state, m)
            }
            wlock.lock(dev)
            ts(state, i, T_USED, 0)
            ts(state, i, T_MNT, 0)
            if g(state, S_N) != 0 {
                s(state, S_N, g(state, S_N) - 1)
            }
            s(state, S_GEHT, g(state, S_GEHT) + 1)
            report(state, EV_GEHT, i)
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn eject(state: u64, i: u64) -> u64 {
    var s_h: [u8; 16] = "wechsel: eject \0"
    var s_i: [u8; 4] = "i=\0\0"
    var s_r: [u8; 8] = "  rc=\0\0\0"
    if !ready_v(state) || i >= MAX_CARRIERS {
        return errno.E_INVAL
    }
    if tg(state, i, T_USED) == 0 {
        return errno.E_INVAL
    }
    let m: u64 = tg(state, i, T_MNT)
    let dev_nr: u64 = tg(state, i, T_DEV)
    let rc: u64 = vfs.umount_index(state, m)
    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_i[0]) as u64)
    serial.dec(i)
    serial.puts((&s_r[0]) as u64)
    serial.dec(rc)
    serial.nl()
    if rc != 0 {
        s(state, S_ERROR, g(state, S_ERROR) + 1)
        return rc
    }
    let _flushed: bool = blk.flush_on(state, dev_nr)
    wlock.lock(dev_nr)
    s(state, S_SYNCS, g(state, S_SYNCS) + 1)
    ts(state, i, T_USED, 0)
    ts(state, i, T_MNT, 0)
    if g(state, S_N) != 0 {
        s(state, S_N, g(state, S_N) - 1)
    }
    s(state, S_AUS, g(state, S_AUS) + 1)
    report(state, EV_AUS, i)
    return 0
}

fn say(state: u64) {
    var s_h: [u8; 16] = "wechsel: medium\0"
    var s_n: [u8; 4] = "n=\0\0"
    var s_k: [u8; 8] = "  kom=\0\0"
    var s_g: [u8; 8] = "  geh=\0\0"
    var s_a: [u8; 8] = "  aus=\0\0"
    var s_s: [u8; 9] = "  sync=\0\0"
    var s_e: [u8; 8] = "  evt=\0\0"
    var s_f: [u8; 8] = "  err=\0\0"
    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_n[0]) as u64)
    serial.dec(g(state, S_N))
    serial.puts((&s_k[0]) as u64)
    serial.dec(g(state, S_KOMMT))
    serial.puts((&s_g[0]) as u64)
    serial.dec(g(state, S_GEHT))
    serial.puts((&s_a[0]) as u64)
    serial.dec(g(state, S_AUS))
    serial.puts((&s_s[0]) as u64)
    serial.dec(g(state, S_SYNCS))
    serial.puts((&s_e[0]) as u64)
    serial.dec(g(state, S_EVENTS))
    serial.puts((&s_f[0]) as u64)
    serial.dec(g(state, S_ERROR))
    serial.nl()
}
