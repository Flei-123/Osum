profile kernel

export { pending, holds, overlaps, hold, clear, owner, lba, source }

static mut l_on: u64 = 0
static mut l_state: u64 = 0
static mut l_lba: u64 = 0
static mut l_src: u64 = 0

fn pending() -> bool {
    return l_on != 0
}

fn holds(state: u64, block: u64, src: u64) -> bool {
    return l_on != 0 && l_state == state && l_lba == block && l_src == src
}

fn overlaps(block: u64, count: u64) -> bool {
    return l_on != 0 && block <= l_lba && l_lba < block + count
}

fn hold(state: u64, block: u64, src: u64) {
    l_state = state
    l_lba = block
    l_src = src
    l_on = 1
}

fn clear() {
    l_on = 0
}

fn owner() -> u64 {
    return l_state
}

fn lba() -> u64 {
    return l_lba
}

fn source() -> u64 {
    return l_src
}
