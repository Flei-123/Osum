profile kernel

import block.blk
import block.blockclass

export { ops }

fn present(state: u64, i: u64) -> bool {
    return blk.present(state)
}

fn blocks(state: u64, i: u64) -> u64 {
    return blk.blocks_on(state, blk.DEV_ATA)
}

fn bsize(state: u64, i: u64) -> u64 {
    return blk.BLOCK_SIZE
}

fn flush(state: u64, i: u64) -> bool {
    return true
}

fn ops() -> blockclass.BlockOps {
    return blockclass.BlockOps {
        init: present,
        present: present,
        blocks: blocks,
        bsize: bsize,
        flush: flush,
        dev: blk.DEV_ATA,
        caps: 0,
        tag: 0x617461
    }
}
