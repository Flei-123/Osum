// SPDX-License-Identifier: GPL-2.0-only
profile kernel

export { first, next, way_of, link, unlink, note_dev, foreign, only_dev, reset_devs }

const GROUP_SHIFT: u64 = 3
const BUCKETS: u64 = 1024
const BUCKET_MASK: u64 = 1023
const MAX_WAYS: u64 = 256
const NODES: u64 = 512
const DEV_MASK_BITS: u64 = 63

static mut heads: [u64; 1024] = [0 as u64; 1024]
static mut node_next: [u64; 512] = [0 as u64; 512]
static mut node_bucket: [u64; 512] = [0 as u64; 512]
static mut dev_mask: u64 = 0

fn bucket(dev: u64, group: u64) -> u64 {
    return (group ^ (group >> 10) ^ (dev * 0x9E5)) & BUCKET_MASK
}

fn push(node: u64, b: u64) {
    node_bucket[node as usize] = b + 1
    node_next[node as usize] = heads[b as usize]
    heads[b as usize] = node + 1
}

fn remove(node: u64) {
    let tag: u64 = node_bucket[node as usize]
    if tag == 0 {
        return
    }
    let b: u64 = tag - 1
    var cur: u64 = heads[b as usize]
    if cur == node + 1 {
        heads[b as usize] = node_next[node as usize]
    } else {
        while cur != 0 {
            let after: u64 = node_next[(cur - 1) as usize]
            if after == node + 1 {
                node_next[(cur - 1) as usize] = node_next[node as usize]
                break
            }
            cur = after
        }
    }
    node_bucket[node as usize] = 0
    node_next[node as usize] = 0
}

fn unlink(way: u64) {
    if way >= MAX_WAYS {
        return
    }
    remove(way * 2)
    remove(way * 2 + 1)
}

fn link(way: u64, dev: u64, lba: u64, n: u64) {
    if way >= MAX_WAYS || n == 0 {
        return
    }
    unlink(way)
    let g0: u64 = lba >> GROUP_SHIFT
    let g1: u64 = (lba + n - 1) >> GROUP_SHIFT
    push(way * 2, bucket(dev, g0))
    if g1 != g0 {
        push(way * 2 + 1, bucket(dev, g1))
    }
}

fn first(dev: u64, lba: u64) -> u64 {
    return heads[bucket(dev, lba >> GROUP_SHIFT) as usize]
}

fn next(node: u64) -> u64 {
    return node_next[(node - 1) as usize]
}

fn way_of(node: u64) -> u64 {
    return (node - 1) >> 1
}

fn dev_bit(dev: u64) -> u64 {
    return (1 as u64) << (dev & DEV_MASK_BITS)
}

fn note_dev(dev: u64) {
    dev_mask = dev_mask | dev_bit(dev)
}

fn foreign(dev: u64) -> bool {
    return (dev_mask | dev_bit(dev)) != dev_bit(dev)
}

fn only_dev(dev: u64) {
    dev_mask = dev_bit(dev)
}

fn reset_devs() {
    dev_mask = 0
}
