profile kernel

export { DEVS, note_read, note_write, read_ios, read_sectors, write_ios, write_sectors, total_read_sectors, total_write_sectors }

const DEVS: u64 = 9
const F_READ_IOS: u64 = 0
const F_READ_SECTORS: u64 = 1
const F_WRITE_IOS: u64 = 2
const F_WRITE_SECTORS: u64 = 3
const FIELDS: u64 = 4

static mut cells: [u64; 36] = [0 as u64; 36]

fn add(dev: u64, field: u64, value: u64) {
    if dev >= DEVS {
        return
    }
    let at: u64 = dev * FIELDS + field
    cells[at as usize] = cells[at as usize] +% value
}

fn get(dev: u64, field: u64) -> u64 {
    if dev >= DEVS {
        return 0
    }
    return cells[(dev * FIELDS + field) as usize]
}

fn note_read(dev: u64, sectors: u64) {
    add(dev, F_READ_IOS, 1)
    add(dev, F_READ_SECTORS, sectors)
}

fn note_write(dev: u64, sectors: u64) {
    add(dev, F_WRITE_IOS, 1)
    add(dev, F_WRITE_SECTORS, sectors)
}

fn read_ios(dev: u64) -> u64 {
    return get(dev, F_READ_IOS)
}

fn read_sectors(dev: u64) -> u64 {
    return get(dev, F_READ_SECTORS)
}

fn write_ios(dev: u64) -> u64 {
    return get(dev, F_WRITE_IOS)
}

fn write_sectors(dev: u64) -> u64 {
    return get(dev, F_WRITE_SECTORS)
}

fn total_read_sectors() -> u64 {
    var sum: u64 = 0
    var dev: u64 = 0
    while dev < DEVS {
        sum = sum + get(dev, F_READ_SECTORS)
        dev = dev + 1
    }
    return sum
}

fn total_write_sectors() -> u64 {
    var sum: u64 = 0
    var dev: u64 = 0
    while dev < DEVS {
        sum = sum + get(dev, F_WRITE_SECTORS)
        dev = dev + 1
    }
    return sum
}
