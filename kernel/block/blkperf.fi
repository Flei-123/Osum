profile kernel

import arch.x86_64.apic
import lib.tscdelta

const K_RUN_CMDS: u64 = 0
const K_RUN_SECTORS: u64 = 1
const K_RUN_CYCLES: u64 = 2
const K_AHCI_CMDS: u64 = 3
const K_AHCI_IDLE_CYCLES: u64 = 4
const K_AHCI_SETUP_CYCLES: u64 = 5
const K_AHCI_WAIT_CYCLES: u64 = 6
const K_AHCI_POLLS: u64 = 7
const CELLS: u64 = 8

static mut cells: [u64; 8] = [0 as u64; 8]

fn add(cell: u64, value: u64) {
    if cell < CELLS {
        cells[cell as usize] = cells[cell as usize] +% value
    }
}

fn get(cell: u64) -> u64 {
    if cell >= CELLS {
        return 0
    }
    return cells[cell as usize]
}

fn now() -> u64 {
    return apic.tsc()
}

fn since(start: u64) -> u64 {
    return tscdelta.between(start, apic.tsc())
}
