profile kernel

export {
    bind, ready_at, blocks_at, sync_at, read_at, read_run_at, write_at,
    H_READY_AT, H_BLOCKS_AT, H_SYNC_AT, H_READ_AT, H_READ_RUN_AT, H_WRITE_AT
}

const H_READY_AT: u64 = 0
const H_BLOCKS_AT: u64 = 1
const H_SYNC_AT: u64 = 2
const H_READ_AT: u64 = 3
const H_READ_RUN_AT: u64 = 4
const H_WRITE_AT: u64 = 5
const H_COUNT: u64 = 6

static mut table: [u64; 6] = [0 as u64; 6]

fn bind(slot: u64, handler: u64) {
    if slot >= H_COUNT {
        return
    }
    table[slot as usize] = handler
}

fn ready_at(state: u64, i: u64) -> bool {
    let handler: u64 = table[H_READY_AT as usize]
    if handler == 0 {
        return false
    }
    let call: fn(u64, u64) -> u64 = handler as fn(u64, u64) -> u64
    return call(state, i) != 0
}

fn blocks_at(state: u64, i: u64) -> u64 {
    let handler: u64 = table[H_BLOCKS_AT as usize]
    if handler == 0 {
        return 0
    }
    let call: fn(u64, u64) -> u64 = handler as fn(u64, u64) -> u64
    return call(state, i)
}

fn sync_at(state: u64, i: u64) -> bool {
    let handler: u64 = table[H_SYNC_AT as usize]
    if handler == 0 {
        return false
    }
    let call: fn(u64, u64) -> u64 = handler as fn(u64, u64) -> u64
    return call(state, i) != 0
}

fn read_at(state: u64, i: u64, lba: u64, dst: u64) -> bool {
    let handler: u64 = table[H_READ_AT as usize]
    if handler == 0 {
        return false
    }
    let call: fn(u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64) -> u64
    return call(state, i, lba, dst) != 0
}

fn read_run_at(state: u64, i: u64, lba: u64, n: u64, dst: u64) -> bool {
    let handler: u64 = table[H_READ_RUN_AT as usize]
    if handler == 0 {
        return false
    }
    let call: fn(u64, u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64, u64) -> u64
    return call(state, i, lba, n, dst) != 0
}

fn write_at(state: u64, i: u64, lba: u64, src: u64) -> bool {
    let handler: u64 = table[H_WRITE_AT as usize]
    if handler == 0 {
        return false
    }
    let call: fn(u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64) -> u64
    return call(state, i, lba, src) != 0
}
