profile kernel

import lib.kstate
import bus.drvclass
import block.blk
import block.blockclass
import block.nvme_class
import block.ahci_class
import block.usbmsc_class
import block.ata_class

export { ops_for, dev_of, KIND_NONE, KIND_NVME, KIND_AHCI, KIND_USB, KIND_ATA }

const KIND_NONE: u64 = 0
const KIND_NVME: u64 = 1
const KIND_AHCI: u64 = 2
const KIND_USB: u64 = 3
const KIND_ATA: u64 = 4

fn table_of(kind: u64) -> blockclass.BlockOps {
    if kind == KIND_NVME {
        return nvme_class.ops()
    }
    if kind == KIND_AHCI {
        return ahci_class.ops()
    }
    if kind == KIND_USB {
        return usbmsc_class.ops()
    }
    if kind == KIND_ATA {
        return ata_class.ops()
    }
    return blockclass.null_ops()
}

fn dev_of(kind: u64) -> u64 {
    let o: blockclass.BlockOps = table_of(kind)
    return o.dev
}

fn ops_for(state: u64, kind: u64) -> blockclass.BlockOps {
    if kstate.mode_on(state, kstate.M_NOCLASS) {
        return blockclass.null_ops()
    }
    if kind == KIND_NONE {
        return blockclass.null_ops()
    }
    drvclass.hit(drvclass.CLS_BLOCK)
    var o: blockclass.BlockOps = table_of(kind)
    if kstate.mode_on(state, kstate.M_BADCLASS) {
        let z: blockclass.BlockOps = blockclass.null_ops()
        o.blocks = z.blocks
    }
    return o
}
