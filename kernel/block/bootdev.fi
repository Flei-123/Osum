profile kernel

import lib.kstate
import lib.cmdword

export { first_kind, K_NONE, K_NVME, K_AHCI, K_USB, K_IDE }

const K_NONE: u64 = 0
const K_NVME: u64 = 1
const K_AHCI: u64 = 2
const K_USB: u64 = 3
const K_IDE: u64 = 4

fn value_is(at: u64, word: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get8(at + i) != kstate.get8(word + i) {
            return false
        }
        i = i + 1
    }
    let end: u64 = kstate.get8(at + n) as u64
    return end == 0 || end == 32 || end == 9
}

fn first_kind(cmd: u64) -> u64 {
    var key: [u8; 8] = "bootdev\0"
    var w_nvme: [u8; 5] = "nvme\0"
    var w_sata: [u8; 5] = "sata\0"
    var w_usb: [u8; 4] = "usb\0"
    var w_ide: [u8; 4] = "ide\0"
    let at: u64 = cmdword.find_key(cmd, (&key[0]) as u64, 7)
    if at == 0 {
        return K_NONE
    }
    let v: u64 = at + 8
    if value_is(v, (&w_nvme[0]) as u64, 4) {
        return K_NVME
    }
    if value_is(v, (&w_sata[0]) as u64, 4) {
        return K_AHCI
    }
    if value_is(v, (&w_usb[0]) as u64, 3) {
        return K_USB
    }
    if value_is(v, (&w_ide[0]) as u64, 3) {
        return K_IDE
    }
    return K_NONE
}
