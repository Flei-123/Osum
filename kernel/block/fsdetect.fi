profile kernel

import lib.kstate
import fs.vfsops

export { classify, is_fat32, is_exfat, FS_UNKNOWN }

const FS_UNKNOWN: u64 = 0

fn matches(b: u64, off: u64, pat: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get8(b + off + i) != kstate.get8(pat + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn has_boot_signature(b: u64) -> bool {
    return kstate.get8(b + 510) == 0x55 && kstate.get8(b + 511) == 0xAA
}

fn is_fat32(b: u64) -> bool {
    var tag: [u8; 6] = "FAT32\0"
    if !has_boot_signature(b) {
        return false
    }
    let bps: u64 = kstate.get8(b + 11) | (kstate.get8(b + 12) << 8)
    if bps != 512 && bps != 1024 && bps != 2048 && bps != 4096 {
        return false
    }
    return matches(b, 82, (&tag[0]) as u64, 5)
}

fn is_exfat(b: u64) -> bool {
    var tag: [u8; 9] = "EXFAT   \0"
    if !has_boot_signature(b) {
        return false
    }
    if !matches(b, 3, (&tag[0]) as u64, 8) {
        return false
    }
    if kstate.get8(b + 108) != 9 {
        return false
    }
    return kstate.get8(b + 110) == 1
}

fn classify(b: u64) -> u64 {
    if is_fat32(b) {
        return vfsops.FS_FAT
    }
    if is_exfat(b) {
        return vfsops.FS_EXFAT
    }
    return FS_UNKNOWN
}
