profile kernel

import drv.blk.nvme
import block.blk
import block.blockclass

export { ops }

fn init(state: u64, i: u64) -> bool {
    if !nvme.present(state) {
        return false
    }
    if nvme.blocks(state) == 0 {
        return nvme.init(state, true, true)
    }
    return true
}

fn present(state: u64, i: u64) -> bool {
    return nvme.present(state)
}

fn blocks(state: u64, i: u64) -> u64 {
    return nvme.blocks(state)
}

fn bsize(state: u64, i: u64) -> u64 {
    return 1 << nvme.block_shift(state)
}

fn flush(state: u64, i: u64) -> bool {
    return nvme.flush(state)
}

fn ops() -> blockclass.BlockOps {
    return blockclass.BlockOps {
        init: init,
        present: present,
        blocks: blocks,
        bsize: bsize,
        flush: flush,
        dev: blk.DEV_NVME,
        caps: blockclass.CAP_FLUSH | blockclass.CAP_NS,
        tag: 0x656d766e
    }
}
