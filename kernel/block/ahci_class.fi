profile kernel

import drv.blk.ahci
import block.blk
import block.blockclass

export { ops }

fn init(state: u64, i: u64) -> bool {
    if ahci.mode(state) == ahci.MODE_AHCI {
        return true
    }
    return ahci.init(state)
}

fn present(state: u64, i: u64) -> bool {
    return ahci.present(state)
}

fn blocks(state: u64, i: u64) -> u64 {
    return ahci.blocks(state)
}

fn bsize(state: u64, i: u64) -> u64 {
    return 1 << ahci.block_shift(state)
}

fn flush(state: u64, i: u64) -> bool {
    return ahci.flush(state)
}

fn ops() -> blockclass.BlockOps {
    return blockclass.BlockOps {
        init: init,
        present: present,
        blocks: blocks,
        bsize: bsize,
        flush: flush,
        dev: blk.DEV_AHCI,
        caps: blockclass.CAP_FLUSH,
        tag: 0x69636861
    }
}
