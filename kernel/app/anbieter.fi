// SPDX-License-Identifier: GPL-2.0-only
// kernel/app/anbieter.fi -- RUNDE KONTO: DIE ANBIETER-SCHNITTSTELLE.
//
// ================================================== WAS HIER NICHT STEHT
//
// In dieser Datei steht KEIN Anbietername, keine Adresse, kein
// Endpunkt, kein Feldname aus einer fremden API. Das ist keine
// Ordnungsliebe, das ist die Zusage dieser Runde: sobald irgendwo im
// allgemeinen Teil `wenn anbieter == "..."` steht, ist die Trennung
// kaputt und der naechste Anbieter kostet wieder eine Runde. Dieselbe
// Regel gilt in `BRANDING.md` fuer die Marken, aus demselben Grund.
//
// Bewacht wird sie nicht durch Disziplin, sondern durch
// `tools/konto/trennung.py`: das Skript liest diese Datei,
// `kernel/app/konto.fi`, `knetz.fi`, `kspeicher.fi` und `ksiegel.fi` und
// wird ROT, sobald ein Anbietername darin auftaucht -- ausser in der
// EINEN Liste, in der die Ruecken angemeldet werden. Die Gegenprobe
// baut den Verstoss absichtlich ein und muss fallen.
//
// ==================================================== DIE OPS-TAFEL
//
// Die Bauform ist die des Kernels: eine Tafel von Funktionszeigern,
// genau wie `kernel/vfsops.fi` sie fuer Dateisysteme hat. Ein Ruecken
// ist ein `Ruecken`-Wert mit vier Funktionen, und der allgemeine Teil
// ruft sie ueber die Tafel auf, ohne zu wissen, welcher es ist.
//
//     anmelden   Kennung + Geheimnis (+ zweiter Faktor) -> Sitzung
//     erneuern   Erneuerungstoken -> neues Zugriffstoken
//     abmelden   die Sitzung beim Anbieter beenden
//     pruefen    laeuft die Sitzung noch?
//
// MEHR NICHT. Alles, was mit DATEN zu tun hat -- lesen, schreiben,
// verschluesseln, abgleichen --, gehoert der Runde SYNC und steht
// ausdruecklich NICHT in dieser Tafel. Die Uebergabe an SYNC ist in
// `docs/KONTO-SYNC.md` beschrieben und besteht aus drei Fragen: wer bin
// ich, wohin gehoeren meine Daten, welches Token.
//
// ================================================ WAS EIN KONTO IST
//
// Ein Konto ist im System GENAU dies:
//
//     Anbieter    welcher Ruecken
//     Bereich     bei welchem Mandanten -- Teil der Kennung, siehe unten
//     Subjekt     die stabile Kennung des Nutzers beim Anbieter
//     Anzeige     wie es dem Menschen angezeigt wird
//     Datenort    wohin die Daten gehoeren (fuer SYNC)
//     Lokal       welchem LOKALEN Benutzer es zugeordnet ist
//
// KEIN PASSWORT. Nie. Das Geheimnis geht durch den Speicher zum Server
// und kommt nie auf die Platte; was auf die Platte kommt, ist ein
// gesiegeltes Token (`ksiegel.fi`).
//
// DER BEREICH GEHOERT IN DIE KENNUNG. Ein Anbieter darf dieselbe
// Kennung in mehreren Mandanten fuehren -- dieselbe Anschrift, zwei
// Firmen, zwei Datenbestaende. Zwei solche Konten sind ZWEI Konten und
// nicht eines mit zwei Gesichtern; wuerden sie zu einem
// zusammenfallen, waeren die Daten des einen im anderen sichtbar. Die
// Kennung eines Kontos ist deshalb SHA-256 ueber Anbieter, Bereich und
// Subjekt zusammen -- Trennung durch Rechnung und nicht durch Vorsicht.

import std.rt
import std.crypto.sha256

export {
    Zugang, Sitzung, Push,
    access_new, session_new, session_free, sitzung_leeren,
    eintragen, anzahl, waehle, name_von, board_set, empty_push,
    tu_anmelden, tu_erneuern, tu_abmelden, do_check,
    kennung,
    S_OK, S_WRONG, S_ZWEITFAKTOR, S_MEHRDEUTIG, S_KEINNETZ, S_TLS,
    S_ABGELEHNT, S_ABGELAUFEN, S_ERROR, S_GEBREMST,
    MAX_PUSH,
}

const MAX_PUSH: usize = 8

// Die Antwort eines Ruecken. Mehr Faelle als "ging / ging nicht", weil
// jeder einzelne davon eine ANDERE Reaktion der Oberflaeche verlangt.
const S_OK: u32 = 0
const S_WRONG: u32 = 1          // Kennung oder Geheimnis stimmt nicht
const S_ZWEITFAKTOR: u32 = 2     // es fehlt der zweite Faktor
const S_MEHRDEUTIG: u32 = 3      // mehrere Bereiche -- es wird GEFRAGT
const S_KEINNETZ: u32 = 4        // der Server war nicht erreichbar
const S_ABGELEHNT: u32 = 5       // die Sitzung taugt nicht als Geraetekonto
const S_ABGELAUFEN: u32 = 6      // Token oder Zwischentoken ist zu alt
const S_ERROR: u32 = 7          // alles andere, mit Hinweis
const S_GEBREMST: u32 = 8        // der Server bremst (zu viele Versuche)
// EIN ABGELEHNTES ZERTIFIKAT IST NICHT "KEIN NETZ". Beides fuehlt sich
// gleich an -- es kommt keine Antwort --, aber das eine ist ein Zug im
// Tunnel und das andere ein Server, der sich nicht ausweisen kann. Wer
// beides gleich meldet, schickt den Nutzer WLAN suchen, waehrend in
// Wahrheit jemand dazwischensitzt.
const S_TLS: u32 = 9             // der Handschlag/das Zertifikat war faul

// Was ein Ruecken zum Anmelden bekommt. Alles Zeiger auf Text, der den
// Aufruf ueberlebt; `geheim` zeigt in einen Puffer, den der Aufrufer
// hinterher ueberschreibt.
struct Zugang {
    ziel: u64,
    zielname: u64,
    wurzeln: u64,
    kennung: u64,
    geheim: u64,
    bereich: u64,
    code: u64,
    temp: u64,
    zugriff: u64,
    erneuerung: u64,
}

// Was ein Ruecken zurueckgibt.
struct Sitzung {
    stand: u32,
    subjekt: rt.Buf,
    anzeige: rt.Buf,
    bereich: rt.Buf,
    datenort: rt.Buf,
    zugriff: rt.Buf,
    erneuerung: rt.Buf,
    temp: rt.Buf,
    auswahl: rt.Buf,
    hinweis: rt.Buf,
    ablauf: u64,
}

struct Push {
    name: u64,
    anmelden: fn(*mut Zugang, *mut Sitzung) -> u32,
    erneuern: fn(*mut Zugang, *mut Sitzung) -> u32,
    abmelden: fn(*mut Zugang, *mut Sitzung) -> u32,
    pruefen: fn(*mut Zugang, *mut Sitzung) -> u32,
}

fn access_new() -> Zugang {
    return Zugang { ziel: 0, zielname: 0, wurzeln: 0, kennung: 0,
        geheim: 0, bereich: 0, code: 0, temp: 0, zugriff: 0,
        erneuerung: 0 }
}

fn session_new() -> Sitzung {
    return Sitzung { stand: S_ERROR, subjekt: rt.buf_new(),
        anzeige: rt.buf_new(), bereich: rt.buf_new(),
        datenort: rt.buf_new(), zugriff: rt.buf_new(),
        erneuerung: rt.buf_new(), temp: rt.buf_new(),
        auswahl: rt.buf_new(), hinweis: rt.buf_new(), ablauf: 0 }
}

fn sitzung_leeren(s: *mut Sitzung) {
    (*s).stand = S_ERROR
    (*s).ablauf = 0
    rt.buf_clear(&(*s).subjekt)
    rt.buf_clear(&(*s).anzeige)
    rt.buf_clear(&(*s).bereich)
    rt.buf_clear(&(*s).datenort)
    rt.buf_clear(&(*s).zugriff)
    rt.buf_clear(&(*s).erneuerung)
    rt.buf_clear(&(*s).temp)
    rt.buf_clear(&(*s).auswahl)
    rt.buf_clear(&(*s).hinweis)
}

fn session_free(s: *mut Sitzung) {
    rt.buf_free(&(*s).subjekt)
    rt.buf_free(&(*s).anzeige)
    rt.buf_free(&(*s).bereich)
    rt.buf_free(&(*s).datenort)
    rt.buf_free(&(*s).zugriff)
    rt.buf_free(&(*s).erneuerung)
    rt.buf_free(&(*s).temp)
    rt.buf_free(&(*s).auswahl)
    rt.buf_free(&(*s).hinweis)
}

// ------------------------------------------------------------ die Tafel

fn empty(z: *mut Zugang, s: *mut Sitzung) -> u32 {
    return S_ERROR
}

fn empty_push() -> Push {
    return Push { name: 0, anmelden: empty, erneuern: empty,
        abmelden: empty, pruefen: empty }
}

// SPRACHGRENZE, und sie steht hier, weil sie die Bauform bestimmt hat:
// der Anfangswert eines `static` wird IN DIE OBJEKTDATEI GESCHRIEBEN
// (SPEC 14.1.statics), und die Adresse einer Funktion ist zu diesem
// Zeitpunkt keine Konstante. Eine Tafel von Funktionszeigern kann in
// diesem Uebersetzer also kein `static` sein.
//
// Also liegt die Tafel beim AUFRUFER -- `kernel/app/konto.fi` haelt sie
// als `var` --, und diese Datei merkt sich nur, wo sie liegt. Der
// Abstand zweier Eintraege wird GEMESSEN und nicht angenommen
// (`schrittweite`), genau wie `vendor/firn/lib/std/json.fi` es fuer
// seine Knoten tut: eine ausgerechnete Groesse waere bei der naechsten
// Feldaenderung still falsch.
static mut tafel_p: u64 = 0
static mut tafel_max: usize = 0
static mut n_ruecken: usize = 0

fn schrittweite() -> usize {
    var zwei: [Push; 2] = [empty_push(); 2]
    return (((&zwei[1]) as u64) - ((&zwei[0]) as u64)) as usize
}

fn space(i: usize) -> *mut Push {
    return (tafel_p + (i * schrittweite()) as u64) as *mut Push
}

fn board_set(p: u64, max: usize) {
    tafel_p = p
    tafel_max = max
    n_ruecken = 0
}

fn eintragen(r: Push) -> bool {
    if tafel_p == 0 || n_ruecken >= tafel_max || n_ruecken >= MAX_PUSH {
        return false
    }
    *space(n_ruecken) = r
    n_ruecken = n_ruecken + 1
    return true
}

fn anzahl() -> usize {
    return n_ruecken
}

fn eq(a: u64, b: u64) -> bool {
    var i: usize = 0
    while true {
        let x: u8 = rt.ld8(a, i)
        let y: u8 = rt.ld8(b, i)
        if x != y {
            return false
        }
        if x == 0 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

// `-1` heisst: diesen Anbieter gibt es nicht. Der Aufrufer sagt dann,
// welche es GIBT -- eine Fehlermeldung, die die Antwort schon enthaelt.
fn waehle(name: u64) -> i64 {
    var i: usize = 0
    while i < n_ruecken {
        if eq((*space(i)).name, name) {
            return i as i64
        }
        i = i + 1
    }
    return -1
}

fn name_von(i: usize) -> u64 {
    if i >= n_ruecken {
        return 0
    }
    return (*space(i)).name
}

fn tu_anmelden(i: usize, z: *mut Zugang, s: *mut Sitzung) -> u32 {
    if i >= n_ruecken {
        return S_ERROR
    }
    let f: fn(*mut Zugang, *mut Sitzung) -> u32 = (*space(i)).anmelden
    return f(z, s)
}

fn tu_erneuern(i: usize, z: *mut Zugang, s: *mut Sitzung) -> u32 {
    if i >= n_ruecken {
        return S_ERROR
    }
    let f: fn(*mut Zugang, *mut Sitzung) -> u32 = (*space(i)).erneuern
    return f(z, s)
}

fn tu_abmelden(i: usize, z: *mut Zugang, s: *mut Sitzung) -> u32 {
    if i >= n_ruecken {
        return S_ERROR
    }
    let f: fn(*mut Zugang, *mut Sitzung) -> u32 = (*space(i)).abmelden
    return f(z, s)
}

fn do_check(i: usize, z: *mut Zugang, s: *mut Sitzung) -> u32 {
    if i >= n_ruecken {
        return S_ERROR
    }
    let f: fn(*mut Zugang, *mut Sitzung) -> u32 = (*space(i)).pruefen
    return f(z, s)
}

// ------------------------------------------------------------- die Kennung
//
// SHA-256 ueber Anbieter, Bereich und Subjekt, mit einem Nulloktett
// dazwischen, davon die ersten 16 Hexziffern. Das Nulloktett ist nicht
// Zierde: ohne es waeren ("ab", "c") und ("a", "bc") dieselbe Kennung,
// und zwei Mandanten mit passend gewaehlten Namen fielen zusammen.
fn kennung(anbieter: u64, bereich: u64, subjekt: u64, sl: usize,
    aus: *mut rt.Buf) {
    var m: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&m, anbieter, rt.c_length(anbieter))
    rt.buf_push(&m, 0 as u8)
    if bereich != 0 {
        rt.buf_push_bytes(&m, bereich, rt.c_length(bereich))
    }
    rt.buf_push(&m, 0 as u8)
    rt.buf_push_bytes(&m, subjekt, sl)
    var dg: [u8; 32] = [0; 32]
    sha256.sha256(m.ptr, m.len, (&dg[0]) as u64)
    var i: usize = 0
    while i < 8 {
        rt.buf_push_hex_u64(aus, dg[i] as u64, 2)
        i = i + 1
    }
    rt.buf_free(&m)
}
