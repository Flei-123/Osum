fn ctx_init(c: *mut Ctx) -> bool {
    var p: kbig.Big = kbig.big_new()
    c_p(&p)
    if !kbig.mont_init(&(*c).fc, &p) {
        return false
    }
    var l: kbig.Big = kbig.big_new()
    c_l(&l)
    if !kbig.mont_init(&(*c).sc, &l) {
        return false
    }
    var d2: kbig.Big = kbig.big_new()
    c_d2(&d2)
    kbig.mont_to(&(*c).fc, &(*c).d2, &d2)
    (*c).ok = true
    return true
}

// ------------------------------------------------------- field shorthand

fn f_mul(c: *mut Ctx, r: *mut kbig.Big, a: *mut kbig.Big, b: *mut kbig.Big) {
    kbig.mont_mul(&(*c).fc, r, a, b)
}

fn f_add(c: *mut Ctx, r: *mut kbig.Big, a: *mut kbig.Big, b: *mut kbig.Big) {
    kbig.big_add_mod(r, a, b, kbig.mont_modulus(&(*c).fc))
}

fn f_sub(c: *mut Ctx, r: *mut kbig.Big, a: *mut kbig.Big, b: *mut kbig.Big) {
    kbig.big_sub_mod(r, a, b, kbig.mont_modulus(&(*c).fc))
}

// into the Montgomery domain
fn f_in(c: *mut Ctx, r: *mut kbig.Big, a: *mut kbig.Big) {
    kbig.mont_to(&(*c).fc, r, a)
}

fn f_out(c: *mut Ctx, r: *mut kbig.Big, a: *mut kbig.Big) {
    kbig.mont_from(&(*c).fc, r, a)
}

fn f_zero(c: *mut Ctx, r: *mut kbig.Big) {
    kbig.big_zero(r)
    let ok: bool = kbig.big_set_len(r, 8)
}

fn f_one(c: *mut Ctx, r: *mut kbig.Big) {
    kbig.big_copy(r, kbig.mont_one(&(*c).fc))
}

fn f_is_zero(a: *mut kbig.Big) -> bool {
    return kbig.big_is_zero(a)
}

fn f_eq(a: *mut kbig.Big, b: *mut kbig.Big) -> bool {
    return kbig.big_cmp(a, b) == 0
}

// ------------------------------------------------------------ the group

fn pt_new() -> Pt {
    return Pt { x: kbig.big_new(), y: kbig.big_new(), z: kbig.big_new(),
        t: kbig.big_new() }
}

// The neutral element (0 : 1 : 1 : 0).
fn pt_identity(c: *mut Ctx, r: *mut Pt) {
    f_zero(c, &(*r).x)
    f_one(c, &(*r).y)
    f_one(c, &(*r).z)
    f_zero(c, &(*r).t)
}

fn pt_copy(r: *mut Pt, a: *mut Pt) {
    kbig.big_copy(&(*r).x, &(*a).x)
    kbig.big_copy(&(*r).y, &(*a).y)
    kbig.big_copy(&(*r).z, &(*a).z)
    kbig.big_copy(&(*r).t, &(*a).t)
}

// r = s when mask is all ones, r = t when it is zero. Branch-free, and it
// is the ONLY place the scalar reaches in `pt_scalarmul` (E1).
fn pt_select(r: *mut Pt, t: *mut Pt, s: *mut Pt, mask: u64) {
    kbig.select_into(&(*r).x, &(*t).x, &(*s).x, mask, 8)
    kbig.select_into(&(*r).y, &(*t).y, &(*s).y, mask, 8)
    kbig.select_into(&(*r).z, &(*t).z, &(*s).z, mask, 8)
    kbig.select_into(&(*r).t, &(*t).t, &(*s).t, mask, 8)
}

// The complete addition law, `add-2008-hwcd-3` for a = -1:
//
//   A = (Y1-X1)*(Y2-X2)   B = (Y1+X1)*(Y2+X2)
//   C = T1*2d*T2          D = Z1*2*Z2
//   E = B-A   F = D-C   G = D+C   H = B+A
//   X3 = E*F  Y3 = G*H  T3 = E*H  Z3 = F*G
//
// `r` may alias `a` or `b`: every product is computed into a local before
// anything is written back.
fn pt_add(c: *mut Ctx, r: *mut Pt, a: *mut Pt, b: *mut Pt) {
    var t0: kbig.Big = kbig.big_new()
    var t1: kbig.Big = kbig.big_new()
    var aa: kbig.Big = kbig.big_new()
    var bb: kbig.Big = kbig.big_new()
    var cc: kbig.Big = kbig.big_new()
    var dd: kbig.Big = kbig.big_new()
    var ee: kbig.Big = kbig.big_new()
    var ff: kbig.Big = kbig.big_new()
    var gg: kbig.Big = kbig.big_new()
    var hh: kbig.Big = kbig.big_new()

    f_sub(c, &t0, &(*a).y, &(*a).x)
    f_sub(c, &t1, &(*b).y, &(*b).x)
    f_mul(c, &aa, &t0, &t1)

    f_add(c, &t0, &(*a).y, &(*a).x)
    f_add(c, &t1, &(*b).y, &(*b).x)
    f_mul(c, &bb, &t0, &t1)

    f_mul(c, &t0, &(*a).t, &(*c).d2)
    f_mul(c, &cc, &t0, &(*b).t)

    f_mul(c, &t0, &(*a).z, &(*b).z)
    f_add(c, &dd, &t0, &t0)

    f_sub(c, &ee, &bb, &aa)
    f_sub(c, &ff, &dd, &cc)
    f_add(c, &gg, &dd, &cc)
    f_add(c, &hh, &bb, &aa)

    f_mul(c, &(*r).x, &ee, &ff)
    f_mul(c, &(*r).y, &gg, &hh)
    f_mul(c, &(*r).t, &ee, &hh)
    f_mul(c, &(*r).z, &ff, &gg)
}

// r = k * P, with `k` the 32 little-endian octets of the scalar. See E1:
// the loop is 256 iterations long whatever `k` is, both additions always
// run, and the bit only drives a masked select.
fn pt_scalarmul(c: *mut Ctx, r: *mut Pt, p: *mut Pt, k: u64) {
    var acc: Pt = pt_new()
    pt_identity(c, &acc)
    var dbl: Pt = pt_new()
    var sum: Pt = pt_new()
    var i: usize = 256
    while i > 0 {
        i = i - 1
        pt_add(c, &dbl, &acc, &acc)
        pt_add(c, &sum, &dbl, p)
        let bit: u64 = ((ld8(k, i / 8) as u64) >> ((i % 8) as u64)) & 1
        let mask: u64 = (0 as u64) -% bit
        pt_select(&acc, &dbl, &sum, mask)
    }
    pt_copy(r, &acc)
}

// z^-1 by Fermat: z^(p-2). The exponent is the public constant (E2).
fn f_inv(c: *mut Ctx, r: *mut kbig.Big, a: *mut kbig.Big) {
    var e: kbig.Big = kbig.big_new()
    c_pm2(&e)
    kbig.mont_pow(&(*c).fc, r, a, &e)
}

// RFC 8032 5.1.2: the y coordinate in 32 little-endian octets, with the
// low bit of x in the top bit.
fn pt_compress(c: *mut Ctx, p: *mut Pt, out: u64) {
    var zi: kbig.Big = kbig.big_new()
    f_inv(c, &zi, &(*p).z)
    var xr: kbig.Big = kbig.big_new()
    var yr: kbig.Big = kbig.big_new()
    f_mul(c, &xr, &(*p).x, &zi)
    f_mul(c, &yr, &(*p).y, &zi)
    var xp: kbig.Big = kbig.big_new()
    var yp: kbig.Big = kbig.big_new()
    f_out(c, &xp, &xr)
    f_out(c, &yp, &yr)
    to_le(&yp, out)
    let sign: u8 = (((xp.d[0] as u64) & 1) << 7) as u8
    st8(out, 31, (ld8(out, 31) as u64 | (sign as u64)) as u8)
}

// RFC 8032 5.1.3, and it REFUSES rather than guesses:
//   * y must be a canonical field element (below p),
//   * x^2 = (y^2-1)/(d*y^2+1) must have a square root,
//   * x = 0 with the sign bit set is the one encoding that is rejected
//     outright, because it is a second name for a point that already has
//     one.
fn pt_decompress(c: *mut Ctx, r: *mut Pt, inp: u64) -> bool {
    var raw: [u8; 32] = [0; 32]
    var i: usize = 0
    while i < 32 {
        raw[i] = ld8(inp, i)
        i = i + 1
    }
    let sign: u64 = ((raw[31] as u64) >> 7) & 1
    raw[31] = ((raw[31] as u64) & 127) as u8

    var y: kbig.Big = kbig.big_new()
    from_le(&y, (&raw[0]) as u64)
    var p: kbig.Big = kbig.big_new()
    c_p(&p)
    if kbig.big_cmp(&y, &p) >= 0 {
        return false // not a canonical encoding
    }

    var ym: kbig.Big = kbig.big_new()
    f_in(c, &ym, &y)
    var one: kbig.Big = kbig.big_new()
    f_one(c, &one)
    var y2: kbig.Big = kbig.big_new()
    f_mul(c, &y2, &ym, &ym)
    var u: kbig.Big = kbig.big_new()
    f_sub(c, &u, &y2, &one)          // u = y^2 - 1
    var dn: kbig.Big = kbig.big_new()
    c_d(&dn)
    var dm: kbig.Big = kbig.big_new()
    f_in(c, &dm, &dn)
    var v: kbig.Big = kbig.big_new()
    f_mul(c, &v, &dm, &y2)
    f_add(c, &v, &v, &one)           // v = d*y^2 + 1

    // x = u*v^3 * (u*v^7)^((p-5)/8)
    var v2: kbig.Big = kbig.big_new()
    f_mul(c, &v2, &v, &v)
    var v3: kbig.Big = kbig.big_new()
    f_mul(c, &v3, &v2, &v)
    var v7: kbig.Big = kbig.big_new()
    f_mul(c, &v7, &v3, &v3)
    f_mul(c, &v7, &v7, &v)
    var uv7: kbig.Big = kbig.big_new()
    f_mul(c, &uv7, &u, &v7)
    var e: kbig.Big = kbig.big_new()
    c_p58(&e)
    var pw: kbig.Big = kbig.big_new()
    kbig.mont_pow(&(*c).fc, &pw, &uv7, &e)
    var x: kbig.Big = kbig.big_new()
    f_mul(c, &x, &u, &v3)
    f_mul(c, &x, &x, &pw)

    // v*x^2 must be u; if it is -u, multiply by sqrt(-1); otherwise there
    // is no root and the encoding is not a point.
    var x2: kbig.Big = kbig.big_new()
    f_mul(c, &x2, &x, &x)
    var vx2: kbig.Big = kbig.big_new()
    f_mul(c, &vx2, &v, &x2)
    if !f_eq(&vx2, &u) {
        var nu: kbig.Big = kbig.big_new()
        var z0: kbig.Big = kbig.big_new()
        f_zero(c, &z0)
        f_sub(c, &nu, &z0, &u)
        if !f_eq(&vx2, &nu) {
            return false
        }
        var iv: kbig.Big = kbig.big_new()
        c_i(&iv)
        var im: kbig.Big = kbig.big_new()
        f_in(c, &im, &iv)
        f_mul(c, &x, &x, &im)
        f_mul(c, &x2, &x, &x)
        f_mul(c, &vx2, &v, &x2)
        if !f_eq(&vx2, &u) {
            return false
        }
    }

    var xp: kbig.Big = kbig.big_new()
    f_out(c, &xp, &x)
    if f_is_zero(&xp) && sign == 1 {
        return false
    }
    if (((xp.d[0] as u64) & 1)) != sign {
        var z0: kbig.Big = kbig.big_new()
        f_zero(c, &z0)
        f_sub(c, &x, &z0, &x)
    }

    kbig.big_copy(&(*r).x, &x)
    kbig.big_copy(&(*r).y, &ym)
    f_one(c, &(*r).z)
    f_mul(c, &(*r).t, &x, &ym)
    return true
}

fn pt_eq(c: *mut Ctx, a: *mut Pt, b: *mut Pt) -> bool {
    // X1*Z2 == X2*Z1 and Y1*Z2 == Y2*Z1
    var l0: kbig.Big = kbig.big_new()
    var r0: kbig.Big = kbig.big_new()
    f_mul(c, &l0, &(*a).x, &(*b).z)
    f_mul(c, &r0, &(*b).x, &(*a).z)
    if !f_eq(&l0, &r0) {
        return false
    }
    f_mul(c, &l0, &(*a).y, &(*b).z)
    f_mul(c, &r0, &(*b).y, &(*a).z)
    return f_eq(&l0, &r0)
}

fn pt_base(c: *mut Ctx, r: *mut Pt) {
    var bx: kbig.Big = kbig.big_new()
    var by: kbig.Big = kbig.big_new()
    c_bx(&bx)
    c_by(&by)
    f_in(c, &(*r).x, &bx)
    f_in(c, &(*r).y, &by)
    f_one(c, &(*r).z)
    f_mul(c, &(*r).t, &(*r).x, &(*r).y)
}

// ------------------------------------------------------------ scalars

// r = (the 512 bit little-endian number at `h`) mod L. See E3: bit by bit,
// no branch on the data.
fn sc_reduce_wide(c: *mut Ctx, r: *mut kbig.Big, h: u64) {
    let m: *mut kbig.Big = kbig.mont_modulus(&(*c).sc)
    kbig.big_zero(r)
    let ok: bool = kbig.big_set_len(r, 8)
    var bit: kbig.Big = kbig.big_new()
    let ok2: bool = kbig.big_set_len(&bit, 8)
    var i: usize = 512
    while i > 0 {
        i = i - 1
        kbig.big_add_mod(r, r, r, m)
        let b: u64 = ((ld8(h, i / 8) as u64) >> ((i % 8) as u64)) & 1
        bit.d[0] = b as u32
        kbig.big_add_mod(r, r, &bit, m)
    }
}

// r = (a + b*cf) mod L, all three below L on entry.
fn sc_muladd(c: *mut Ctx, r: *mut kbig.Big, a: *mut kbig.Big,
    b: *mut kbig.Big, cf: *mut kbig.Big) {
    var bm: kbig.Big = kbig.big_new()
    var cm: kbig.Big = kbig.big_new()
    kbig.mont_to(&(*c).sc, &bm, b)
    kbig.mont_to(&(*c).sc, &cm, cf)
    var pm: kbig.Big = kbig.big_new()
    kbig.mont_mul(&(*c).sc, &pm, &bm, &cm)
    var pr: kbig.Big = kbig.big_new()
    kbig.mont_from(&(*c).sc, &pr, &pm)
    kbig.big_add_mod(r, a, &pr, kbig.mont_modulus(&(*c).sc))
}

// ---------------------------------------------------------- the scheme

// h = SHA-512(seed); a = clamp(h[0..32]) as a number, prefix = h[32..64].
fn expand(seed: u64, a_out: u64, prefix: u64) {
    var h: [u8; 64] = [0; 64]
    ksha512.hash(seed, SEED_LEN, (&h[0]) as u64)
    h[0] = ((h[0] as u64) & 248) as u8
    h[31] = ((h[31] as u64) & 127) as u8
    h[31] = ((h[31] as u64) | 64) as u8
    var i: usize = 0
    while i < 32 {
        st8(a_out, i, h[i])
        st8(prefix, i, h[32 + i])
        i = i + 1
    }
}

// The public key of a 32 octet seed.
fn ed25519_public(c: *mut Ctx, seed: u64, out: u64) -> bool {
    if !(*c).ok {
        return false
    }
    var a: [u8; 32] = [0; 32]
    var pre: [u8; 32] = [0; 32]
    expand(seed, (&a[0]) as u64, (&pre[0]) as u64)
    var b: Pt = pt_new()
    pt_base(c, &b)
    var ap: Pt = pt_new()
    pt_scalarmul(c, &ap, &b, (&a[0]) as u64)
    pt_compress(c, &ap, out)
    return true
}

// RFC 8032 5.1.6. `sig` receives 64 octets: R || S.
fn ed25519_sign(c: *mut Ctx, seed: u64, msg: u64, mlen: usize,
    sig: u64) -> bool {
    if !(*c).ok {
        return false
    }
    var a: [u8; 32] = [0; 32]
    var pre: [u8; 32] = [0; 32]
    expand(seed, (&a[0]) as u64, (&pre[0]) as u64)

    var bp: Pt = pt_new()
    pt_base(c, &bp)
    var ap: Pt = pt_new()
    pt_scalarmul(c, &ap, &bp, (&a[0]) as u64)
    var apub: [u8; 32] = [0; 32]
    pt_compress(c, &ap, (&apub[0]) as u64)

    // r = SHA-512(prefix || M) mod L
    var hs: ksha512.Sha512 = ksha512.sha512_new()
    ksha512.begin(&hs)
    ksha512.update(&hs, (&pre[0]) as u64, 32)
    ksha512.update(&hs, msg, mlen)
    var hb: [u8; 64] = [0; 64]
    ksha512.finish(&hs, (&hb[0]) as u64)
    var rr: kbig.Big = kbig.big_new()
    sc_reduce_wide(c, &rr, (&hb[0]) as u64)
    var rbytes: [u8; 32] = [0; 32]
    to_le(&rr, (&rbytes[0]) as u64)

    // R = r*B
    var rp: Pt = pt_new()
    pt_scalarmul(c, &rp, &bp, (&rbytes[0]) as u64)
    var rc: [u8; 32] = [0; 32]
    pt_compress(c, &rp, (&rc[0]) as u64)

    // k = SHA-512(R || A || M) mod L
    ksha512.begin(&hs)
    ksha512.update(&hs, (&rc[0]) as u64, 32)
    ksha512.update(&hs, (&apub[0]) as u64, 32)
    ksha512.update(&hs, msg, mlen)
    ksha512.finish(&hs, (&hb[0]) as u64)
    var kk: kbig.Big = kbig.big_new()
    sc_reduce_wide(c, &kk, (&hb[0]) as u64)

    // S = (r + k*a) mod L
    var an: kbig.Big = kbig.big_new()
    from_le(&an, (&a[0]) as u64)
    var anr: kbig.Big = kbig.big_new()
    let okm: bool = kbig.big_mod(&anr, &an, kbig.mont_modulus(&(*c).sc))
    var ss: kbig.Big = kbig.big_new()
    sc_muladd(c, &ss, &rr, &kk, &anr)

    var i: usize = 0
    while i < 32 {
        st8(sig, i, rc[i])
        i = i + 1
    }
    var sb: [u8; 32] = [0; 32]
    to_le(&ss, (&sb[0]) as u64)
    i = 0
    while i < 32 {
        st8(sig, 32 + i, sb[i])
        i = i + 1
    }
    return true
}

// RFC 8032 5.1.7. `false` means DO NOT USE THIS PACKAGE -- there is no
// second, weaker answer.
fn ed25519_verify(c: *mut Ctx, pub_key: u64, msg: u64, mlen: usize,
    sig: u64) -> bool {
    if !(*c).ok {
        return false
    }
    // S must be a canonical scalar. An S >= L is a different encoding of
    // the same signature and accepting it makes signatures malleable.
    var sb: [u8; 32] = [0; 32]
    var i: usize = 0
    while i < 32 {
        sb[i] = ld8(sig, 32 + i)
        i = i + 1
    }
    var ss: kbig.Big = kbig.big_new()
    from_le(&ss, (&sb[0]) as u64)
    if kbig.big_cmp(&ss, kbig.mont_modulus(&(*c).sc)) >= 0 {
        return false
    }

    var ap: Pt = pt_new()
    if !pt_decompress(c, &ap, pub_key) {
        return false
    }
    var rp: Pt = pt_new()
    if !pt_decompress(c, &rp, sig) {
        return false
    }

    // k = SHA-512(R || A || M) mod L
    var hs: ksha512.Sha512 = ksha512.sha512_new()
    ksha512.begin(&hs)
    ksha512.update(&hs, sig, 32)
    ksha512.update(&hs, pub_key, 32)
    ksha512.update(&hs, msg, mlen)
    var hb: [u8; 64] = [0; 64]
    ksha512.finish(&hs, (&hb[0]) as u64)
    var kk: kbig.Big = kbig.big_new()
    sc_reduce_wide(c, &kk, (&hb[0]) as u64)
    var kb: [u8; 32] = [0; 32]
    to_le(&kk, (&kb[0]) as u64)

    // [S]B == R + [k]A
    var bp: Pt = pt_new()
    pt_base(c, &bp)
    var lhs: Pt = pt_new()
    pt_scalarmul(c, &lhs, &bp, (&sb[0]) as u64)
    var ka: Pt = pt_new()
    pt_scalarmul(c, &ka, &ap, (&kb[0]) as u64)
    var rhs: Pt = pt_new()
    pt_add(c, &rhs, &rp, &ka)
    return pt_eq(c, &lhs, &rhs)
}
