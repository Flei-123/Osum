        89, 241, 178, 38, 148, 155, 214, 235,
        86, 177, 131, 130, 154, 20, 224, 0,
        48, 209, 243, 238, 242, 128, 142, 25,
        231, 252, 223, 86, 220, 217, 6, 36,
