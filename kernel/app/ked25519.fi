    from_le(m, (&a[0]) as u64)
}

// d = -121665/121666 mod p
fn c_d(m: *mut kbig.Big) {
    var a: [u8; 32] = [
        163, 120, 89, 19, 202, 77, 235, 117,
        171, 216, 65, 65, 77, 10, 112, 0,
        152, 232, 121, 119, 121, 64, 199, 140,
