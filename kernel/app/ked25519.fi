    from_le(m, (&a[0]) as u64)
}

// (p-5)/8, the exponent of the square root candidate
fn c_p58(m: *mut kbig.Big) {
    var a: [u8; 32] = [
        253, 255, 255, 255, 255, 255, 255, 255,
        255, 255, 255, 255, 255, 255, 255, 255,
        255, 255, 255, 255, 255, 255, 255, 255,
        255, 255, 255, 255, 255, 255, 255, 15,
    ]
    from_le(m, (&a[0]) as u64)
}

// p-2, the exponent of the inversion
fn c_pm2(m: *mut kbig.Big) {
    var a: [u8; 32] = [
        235, 255, 255, 255, 255, 255, 255, 255,
        255, 255, 255, 255, 255, 255, 255, 255,
        255, 255, 255, 255, 255, 255, 255, 255,
        255, 255, 255, 255, 255, 255, 255, 127,
    ]
    from_le(m, (&a[0]) as u64)
}

// The base point B (RFC 8032 5.1: y = 4/5, x the even root).
fn c_bx(m: *mut kbig.Big) {
    var a: [u8; 32] = [
        26, 213, 37, 143, 96, 45, 86, 201,
        178, 167, 37, 149, 96, 199, 44, 105,
        92, 220, 214, 253, 49, 226, 164, 192,
        254, 83, 110, 205, 211, 54, 105, 33,
    ]
    from_le(m, (&a[0]) as u64)
}

fn c_by(m: *mut kbig.Big) {
    var a: [u8; 32] = [
        88, 102, 102, 102, 102, 102, 102, 102,
        102, 102, 102, 102, 102, 102, 102, 102,
        102, 102, 102, 102, 102, 102, 102, 102,
        102, 102, 102, 102, 102, 102, 102, 102,
