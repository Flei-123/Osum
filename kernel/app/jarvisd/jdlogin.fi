import std.rt
import jarvisd.jdcmd
import jarvisd.jddev

const MAX_NAME_BYTES: usize = 63

static mut P_LOGIN_REQUEST: [u8; 22] = "/var/jarvis/devlogin\0\0"

fn name_char_ok(c: u8) -> bool {
    return (c >= 97 as u8 && c <= 122 as u8) || (c >= 65 as u8 && c <= 90 as u8)
        || (c >= 48 as u8 && c <= 57 as u8) || c == 95 as u8 || c == 45 as u8 || c == 46 as u8
}

fn name_ok(p: u64, n: usize) -> bool {
    if n > MAX_NAME_BYTES {
        return false
    }
    var i: usize = 0
    while i < n {
        if !name_char_ok(rt.ld8(p, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn do_login(name: *mut rt.Buf, aus: *mut rt.Buf) -> bool {
    if !jddev.active() {
        return jdcmd.ablehnen(aus, "login needs dev mode (devmode = yes in /etc/jarvis/permissions.conf)")
    }
    if !name_ok((*name).ptr, (*name).len) {
        return jdcmd.ablehnen(aus, "login: the account name has invalid characters or is too long")
    }
    if !rt.write_file((&P_LOGIN_REQUEST[0]) as u64, (*name).ptr, (*name).len) {
        return jdcmd.ablehnen(aus, "login: the request file could not be written")
    }
    let done: str = "login requested"
    rt.buf_push_bytes(aus, done.p as u64, done.n)
    rt.buf_push(aus, 10 as u8)
    return true
}
