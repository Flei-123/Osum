import std.rt

const S_OPEN: i64 = 2

const S_CLOSE: i64 = 3

const S_SYSINFO: i64 = 1002

const I_UPTIME: i64 = 1

const BEAT_EVERY_S: i64 = 10

const TRANSITION_NONE: i64 = 0

const TRANSITION_ON: i64 = 1

const TRANSITION_OFF: i64 = 2

const MIN_OUTPUT: usize = 524288

static mut k_conf_dev: bool = false

static mut k_conf_always: bool = false

static mut k_active: bool = false

static mut k_previous: bool = false

static mut k_beat_at: i64 = -1

static mut BEAT_BODY: [u8; 24] = [0 as u8; 24]

static mut P_OFF: [u8; 20] = "/var/jarvis/dev-off\0"

static mut P_ACTIVE: [u8; 27] = "/var/jarvis/devmode-active\0"

static mut DENY_READ: [u8; 187] = "/secrets\0/device\0/state/session\0/etc/shadow*\0/etc/passwd*\0/etc/machine-id\0/etc/wlan.conf*\0/etc/dbgsrv.token\0/etc/odb.token\0/etc/social\0/config/vpn/keys\0/etc/jarvis/device.key\0/root/.ssh\0\0"
static mut DENY_WRITE: [u8; 92] = "/var/log/jarvisd.log\0/var/jarvis/dev-off\0/var/jarvis/devmode-active\0/var/jarvis/pairing-ok\0\0"
static mut READONLY_PROGS: [u8; 80] = "/bin/cat\0/bin/tail\0/bin/head\0/bin/grep\0/bin/wc\0/bin/ls\0/bin/log\0/bin/jarvisctl\0\0"
static mut BAD_WORDS: [u8; 12] = "vault\0jsig\0\0"

fn reset() {
    k_conf_dev = false
    k_conf_always = false
}

fn file_exists(path: u64) -> bool {
    let fd: i64 = syscall(S_OPEN, path as i64, 0, 0, 0, 0, 0)
    if fd < 0 {
        return false
    }
    syscall(S_CLOSE, fd, 0, 0, 0, 0, 0)
    return true
}

fn active() -> bool {
    return k_active
}

fn always_shot() -> bool {
    return k_active && k_conf_always
}

fn emergency_stop() -> bool {
    return file_exists((&P_OFF[0]) as u64)
}

fn uptime_s() -> i64 {
    return syscall(S_SYSINFO, I_UPTIME, 0, 0, 0, 0, 0) / 1000
}

fn write_marker(now: i64) {
    var digits: [u8; 20] = [0 as u8; 20]
    var n: usize = 0
    var rest: i64 = now
    if rest < 0 {
        rest = 0
    }
    if rest == 0 {
        digits[0] = 48 as u8
        n = 1
    }
    while rest > 0 {
        digits[n] = (48 + rest % 10) as u8
        rest = rest / 10
        n = n + 1
    }
    var at: usize = 0
    while at < n {
        BEAT_BODY[at] = digits[n - 1 - at]
        at = at + 1
    }
    BEAT_BODY[n] = 10 as u8
    rt.write_file((&P_ACTIVE[0]) as u64, (&BEAT_BODY[0]) as u64, n + 1)
    k_beat_at = now
}

fn beat() {
    if !k_active {
        return
    }
    let now: i64 = uptime_s()
    if now < k_beat_at || now - k_beat_at >= BEAT_EVERY_S {
        write_marker(now)
    }
}

fn settle() -> i64 {
    k_active = k_conf_dev && !emergency_stop()
    if k_active {
        if k_beat_at < 0 || !file_exists((&P_ACTIVE[0]) as u64) {
            write_marker(uptime_s())
        }
    } else if file_exists((&P_ACTIVE[0]) as u64) {
        rt.unlink_file((&P_ACTIVE[0]) as u64)
        k_beat_at = -1
    }
    var change: i64 = TRANSITION_NONE
    if k_active && !k_previous {
        change = TRANSITION_ON
    } else if !k_active && k_previous {
        change = TRANSITION_OFF
    }
    k_previous = k_active
    return change
}

fn entry_at(table: u64, index: usize) -> u64 {
    var at: usize = 0
    var seen: usize = 0
    while rt.ld8(table, at) != 0 as u8 {
        if seen == index {
            return table + at as u64
        }
        while rt.ld8(table, at) != 0 as u8 {
            at = at + 1
        }
        at = at + 1
        seen = seen + 1
    }
    return 0
}

fn entry_text_len(entry: u64) -> usize {
    var n: usize = rt.c_length(entry)
    if n > 0 && rt.ld8(entry, n - 1) == 42 as u8 {
        n = n - 1
    }
    return n
}

fn same_prefix(a: u64, b: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if rt.ld8(a, i) != rt.ld8(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn path_hits_table(table: u64, p: u64, n: usize) -> bool {
    var i: usize = 0
    while true {
        let e: u64 = entry_at(table, i)
        if e == 0 {
            return false
        }
        let el: usize = rt.c_length(e)
        let raw: bool = rt.ld8(e, el - 1) == 42 as u8
        let tl: usize = entry_text_len(e)
        if n >= tl && same_prefix(e, p, tl) {
            if raw || n == tl || rt.ld8(p, tl) == 47 as u8 {
                return true
            }
        }
        i = i + 1
    }
    return false
}

fn path_denied(p: u64, n: usize, for_write: bool) -> bool {
    if path_hits_table((&DENY_READ[0]) as u64, p, n) {
        return true
    }
    if for_write && path_hits_table((&DENY_WRITE[0]) as u64, p, n) {
        return true
    }
    return false
}

fn mentions(line: u64, n: usize, needle: u64, nl: usize) -> bool {
    if nl == 0 || n < nl {
        return false
    }
    var i: usize = 0
    while i + nl <= n {
        if same_prefix(line + i as u64, needle, nl) {
            return true
        }
        i = i + 1
    }
    return false
}

fn table_mentioned(table: u64, line: u64, n: usize) -> bool {
    var i: usize = 0
    while true {
        let e: u64 = entry_at(table, i)
        if e == 0 {
            return false
        }
        if mentions(line, n, e, entry_text_len(e)) {
            return true
        }
        i = i + 1
    }
    return false
}

fn program_readonly(prog: u64, pn: usize) -> bool {
    var i: usize = 0
    while true {
        let e: u64 = entry_at((&READONLY_PROGS[0]) as u64, i)
        if e == 0 {
            return false
        }
        if rt.c_length(e) == pn && same_prefix(e, prog, pn) {
            return true
        }
        i = i + 1
    }
    return false
}

fn has_redirect(line: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if rt.ld8(line, i) == 62 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

fn command_denied(line: u64, n: usize, prog: u64, pn: usize) -> bool {
    if table_mentioned((&BAD_WORDS[0]) as u64, prog, pn) {
        return true
    }
    if table_mentioned((&DENY_READ[0]) as u64, line, n) {
        return true
    }
    var i: usize = 0
    while true {
        let e: u64 = entry_at((&DENY_WRITE[0]) as u64, i)
        if e == 0 {
            break
        }
        if mentions(line, n, e, entry_text_len(e)) {
            var is_log: bool = true
            let want: usize = 20
            if rt.c_length(e) != want {
                is_log = false
            } else {
                var lg: [u8; 21] = "/var/log/jarvisd.log\0"
                is_log = same_prefix(e, (&lg[0]) as u64, want)
            }
            if !is_log || !program_readonly(prog, pn) || has_redirect(line, n) {
                return true
            }
        }
        i = i + 1
    }
    return false
}
