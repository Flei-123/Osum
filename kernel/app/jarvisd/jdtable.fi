import std.rt

const NEWLINE: u8 = 10 as u8
const HEADER_ROWS: u64 = 1

static mut P_TCP: [u8; 14] = "/proc/net/tcp\0"

fn tcp_rows() -> u64 {
    var b: rt.Buf = rt.buf_new()
    var rows: u64 = 0
    if rt.read_file((&P_TCP[0]) as u64, &b) {
        var i: usize = 0
        while i < b.len {
            if rt.ld8(b.ptr, i) == NEWLINE {
                rows = rows + 1
            }
            i = i + 1
        }
    }
    rt.buf_free(&b)
    if rows < HEADER_ROWS {
        return 0
    }
    return rows - HEADER_ROWS
}

fn push_state(b: *mut rt.Buf) {
    var label: [u8; 6] = " tcp=\0"
    rt.buf_push_bytes(b, (&label[0]) as u64, 5)
    rt.buf_push_dec_u64(b, tcp_rows())
}
