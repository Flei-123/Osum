import std.rt

const SYS_READ: i64 = 0
const SYS_OPEN: i64 = 2
const SYS_CLOSE: i64 = 3
const LINE_MAX: usize = 160
const NEWLINE: u8 = 10

fn push_line(aus: *mut rt.Buf) {
    var path: [u8; 26] = "/var/log/ota-rollback.log\0"
    var line: [u8; 160] = [0; 160]
    let fd: i64 = syscall(SYS_OPEN, (&path[0]) as u64 as i64, 0, 0, 0, 0, 0)
    if fd < 0 {
        return
    }
    let n: i64 = syscall(SYS_READ, fd, (&line[0]) as u64 as i64, LINE_MAX as i64, 0, 0, 0)
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    if n <= 0 {
        return
    }
    rt.buf_push_bytes(aus, (&line[0]) as u64, n as usize)
    if line[(n - 1) as usize] != NEWLINE {
        rt.buf_push(aus, NEWLINE)
    }
}
