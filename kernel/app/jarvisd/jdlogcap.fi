import std.rt

const SYS_OPEN: i64 = 2
const SYS_CLOSE: i64 = 3
const SYS_LSEEK: i64 = 8
const SYS_RENAME: i64 = 82
const O_RDONLY: i64 = 0
const SEEK_END: i64 = 2
const LOG_CAP_BYTES: i64 = 65536
const PATH_MAX: usize = 140
const OLD_SUFFIX_LEN: usize = 2

fn rotate_if_big(path: u64) {
    let n: usize = rt.c_length(path)
    if n == 0 || n + OLD_SUFFIX_LEN + 1 > PATH_MAX {
        return
    }
    let fd: i64 = syscall(SYS_OPEN, path as i64, O_RDONLY, 0, 0, 0, 0)
    if fd < 0 {
        return
    }
    let size: i64 = syscall(SYS_LSEEK, fd, 0, SEEK_END, 0, 0, 0)
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    if size < LOG_CAP_BYTES {
        return
    }
    var old: [u8; 140] = [0; 140]
    rt.mem_copy((&old[0]) as u64, path, n)
    old[n] = 46 as u8
    old[n + 1] = 49 as u8
    syscall(SYS_RENAME, path as i64, (&old[0]) as i64, 0, 0, 0, 0)
}
