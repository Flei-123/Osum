import std.io
import std.rt
import std.net
import std.crypto.sha256
import tls.tls
import tls.x509
import tls.roots
import tls.clockgate
import httpget.httpfile
import httpget.httpsink
import libc.dns

const CHUNK: usize = 4096

fn put(out: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push_bytes(out, p, n)
}

fn line(out: *mut rt.Buf) {
    rt.buf_push(out, 10 as u8)
}

fn say(out: *mut rt.Buf, s: str) {
    io.print(s)
}

fn emit(out: *mut rt.Buf) {
    rt.write_everything(1, (*out).ptr, (*out).len)
    rt.buf_clear(out)
}

fn num_line(out: *mut rt.Buf, key: str, v: u64) {
    io.print(key)
    rt.buf_clear(out)
    rt.buf_push_dec_u64(out, v)
    rt.buf_push(out, 10 as u8)
    emit(out)
}

fn hex_line(out: *mut rt.Buf, key: str, p: u64, n: usize) {
    io.print(key)
    rt.buf_clear(out)
    var i: usize = 0
    while i < n {
        rt.buf_push_hex_u64(out, rt.ld8(p, i) as u64, 2)
        i = i + 1
    }
    rt.buf_push(out, 10 as u8)
    emit(out)
}

fn text_line(out: *mut rt.Buf, key: str, p: u64, n: usize) {
    io.print(key)
    rt.buf_clear(out)
    put(out, p, n)
    rt.buf_push(out, 10 as u8)
    emit(out)
}

fn reason(out: *mut rt.Buf, r: u32) {
    if r == x509.V_OK {
        io.print("fetch: verify OK\n")
        return
    }
    if r == x509.V_PARSE {
        io.print("fetch: verify REFUSED parse\n")
        return
    }
    if r == x509.V_EXPIRED {
        io.print("fetch: verify REFUSED expired\n")
        return
    }
    if r == x509.V_NOT_YET {
        io.print("fetch: verify REFUSED not_yet_valid\n")
        return
    }
    if r == x509.V_CLOCK {
        io.print("fetch: verify REFUSED clock_not_set\n")
        return
    }
    if r == x509.V_NAME {
        io.print("fetch: verify REFUSED wrong_name\n")
        return
    }
    if r == x509.V_UNKNOWN_ISSUER {
        io.print("fetch: verify REFUSED unknown_issuer\n")
        return
    }
    if r == x509.V_BAD_SIGNATURE {
        io.print("fetch: verify REFUSED bad_signature\n")
        return
    }
    if r == x509.V_NOT_CA {
        io.print("fetch: verify REFUSED issuer_not_a_ca\n")
        return
    }
    if r == x509.V_UNSUPPORTED {
        io.print("fetch: verify REFUSED unsupported_algorithm\n")
        return
    }
    if r == x509.V_TOO_LONG {
        io.print("fetch: verify REFUSED chain_too_long\n")
        return
    }
    io.print("fetch: verify REFUSED critical_extension\n")
}


fn status_code(p: u64, n: usize) -> u64 {
    var i: usize = 0
    while i < n && rt.ld8(p, i) != 32 as u8 {
        i = i + 1
    }
    i = i + 1
    var v: u64 = 0
    var d: usize = 0
    while i < n && d < 3 {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 {
            return v
        }
        v = v * 10 + (c - 48 as u8) as u64
        i = i + 1
        d = d + 1
    }
    return v
}

fn parse_dec_u64(p: u64, n: usize) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 {
            return v
        }
        v = v * 10 + (c - 48 as u8) as u64
        i = i + 1
    }
    return v
}


fn parse_u32(p: u64, from: usize, to: usize) -> u32 {
    var v: u32 = 0
    var i: usize = from
    while i < to {
        let ch: u8 = rt.ld8(p, i)
        if ch < 48 as u8 || ch > 57 as u8 {
            return v
        }
        v = v * 10 as u32 + (ch - 48 as u8) as u32
        i = i + 1
    }
    return v
}

fn parse_ip(p: u64, from: usize, to: usize, out: *mut u32) -> bool {
    var parts: [u32; 4] = [0; 4]
    var k: usize = 0
    var v: u32 = 0
    var digits: usize = 0
    var i: usize = from
    while i < to {
        let ch: u8 = rt.ld8(p, i)
        if ch == 46 as u8 {
            if digits == 0 || k >= 3 {
                return false
            }
            parts[k] = v
            k = k + 1
            v = 0
            digits = 0
        } else {
            if ch < 48 as u8 || ch > 57 as u8 {
                return false
            }
            v = v * 10 as u32 + (ch - 48 as u8) as u32
            digits = digits + 1
            if v > 255 as u32 {
                return false
            }
        }
        i = i + 1
    }
    if k != 3 || digits == 0 {
        return false
    }
    parts[3] = v
    *out = net.ipv4(parts[0] as u8, parts[1] as u8, parts[2] as u8,
        parts[3] as u8)
    return true
}

fn starts_with(p: u64, n: usize, q: u64) -> bool {
    var i: usize = 0
    while true {
        let c: u8 = rt.ld8(q, i)
        if c == 0 as u8 {
            return true
        }
        if i >= n {
            return false
        }
        if rt.ld8(p, i) != c {
            return false
        }
        i = i + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    var out: rt.Buf = rt.buf_new()
    var name: u64 = 0
    var namelen: usize = 0
    var roots: u64 = 0
    var outfile: u64 = 0
    var quiet: bool = true
    var insecure: bool = false
    var url: u64 = 0
    var urllen: usize = 0
    var von: u64 = 0
    var anhaengen: bool = false

    let argc: usize = rt.arg_count(start)
    var i: usize = 1
    while i < argc {
        let a: u64 = rt.arg_ptr(start, i)
        let n: usize = rt.c_length(a)
        if n == 2 && rt.ld8(a, 0) == 45 as u8 {
            let c: u8 = rt.ld8(a, 1)
            if c == 110 as u8 {
                i = i + 1
                if i < argc {
                    name = rt.arg_ptr(start, i)
                    namelen = rt.c_length(name)
                }
            } else if c == 114 as u8 {
                i = i + 1
                if i < argc {
                    roots = rt.arg_ptr(start, i)
                }
            } else if c == 111 as u8 {
                i = i + 1
                if i < argc {
                    outfile = rt.arg_ptr(start, i)
                }
            } else if c == 98 as u8 {
                i = i + 1
                if i < argc {
                    let z: u64 = rt.arg_ptr(start, i)
                    von = parse_dec_u64(z, rt.c_length(z))
                }
            } else if c == 97 as u8 {
                anhaengen = true
            } else if c == 113 as u8 {
                quiet = true
            } else if c == 118 as u8 {
                quiet = false
            } else if c == 107 as u8 {
                insecure = true
            }
        } else {
            url = a
            urllen = n
        }
        i = i + 1
    }
    if url == 0 {
        io.print("usage: fetch [-n name] [-r roots] [-o file] [-b von] [-a] [-v] [-k] <url>\n")
        return 2
    }

    var secure: bool = false
    var at: usize = 0
    var s_https: [u8; 9] = "https://\0"
    var s_http: [u8; 8] = "http://\0"
    if starts_with(url, urllen, (&s_https[0]) as u64) {
        secure = true
        at = 8
    } else if starts_with(url, urllen, (&s_http[0]) as u64) {
        at = 7
    } else {
        io.print("fetch: the url has to start with http:// or https://\n")
        return 2
    }
    var hostend: usize = at
    while hostend < urllen && rt.ld8(url, hostend) != 47 as u8
        && rt.ld8(url, hostend) != 58 as u8 {
        hostend = hostend + 1
    }
    var port: u32 = 80
    if secure {
        port = 443
    }
    var pathfrom: usize = hostend
    if hostend < urllen && rt.ld8(url, hostend) == 58 as u8 {
        var pe: usize = hostend + 1
        while pe < urllen && rt.ld8(url, pe) != 47 as u8 {
            pe = pe + 1
        }
        port = parse_u32(url, hostend + 1, pe)
        pathfrom = pe
    }
    var addr: u32 = 0
    var hb: [u8; 256] = [0; 256]
    var aufgeloest: bool = false
    if !parse_ip(url, at, hostend, &addr) {
        let hl: usize = hostend - at
        if hl == 0 || hl > 254 {
            io.print("fetch: the name in the URL is not a host name\n")
            return 2
        }
        var hi: usize = 0
        while hi < hl {
            __mmio_write8((((&hb[0]) as u64) + hi as u64) as *mut u8,
                rt.ld8(url, at + hi))
            hi = hi + 1
        }
        __mmio_write8((((&hb[0]) as u64) + hl as u64) as *mut u8, 0 as u8)
        let a4: u64 = dns.resolve_a((&hb[0]) as u64)
        if a4 == 0 {
            io.print("fetch: cannot resolve the name: ")
            io.print_bytes((&hb[0]) as u64, hl)
            io.print("\n")
            return 1
        }
        addr = a4 as u32
        aufgeloest = true
    }
    if aufgeloest {
        num_line(&out, "fetch: aufgeloest ", addr as u64)
    }
    if name == 0 {
        name = url + at as u64
        namelen = hostend - at
    }
    var path: u64 = url + pathfrom as u64
    var pathlen: usize = urllen - pathfrom
    var slash: [u8; 2] = "/\0"
    if pathlen == 0 {
        path = (&slash[0]) as u64
        pathlen = 1
    }

    var bad: bool = false
    var c: net.Conn = net.connect_tcp(addr, port as u16)
    catch | e | fail_conn(&bad)
    if bad {
        io.print("fetch: no connection\n")
        return 1
    }
    let okt: bool = net.set_timeout(&c, 20000 as u64) catch false

    var dest: httpfile.Dest = httpfile.dest_new(outfile, anhaengen || von > 0)
    dest.restart_on_full = von > 0
    var status: i32 = 0
    if secure {
        status = over_tls(&c, &out, &dest, name, namelen, path, pathlen,
            roots, insecure, von)
    } else {
        status = plain(&c, &out, &dest, name, namelen, path, pathlen, von)
    }
    net.close(&c)
    let okf: bool = httpfile.dest_close(&dest)
    if status != 0 {
        return status
    }
    if outfile != 0 && httpfile.dest_rejected(&dest) {
        io.print("fetch: not written, the server did not deliver the file\n")
        return 3
    }

    num_line(&out, "fetch: octets ", dest.sink.raw_octets)
    var dg: [u8; 32] = [0; 32]
    httpsink.sink_raw_digest(&dest.sink, (&dg[0]) as u64)
    hex_line(&out, "fetch: sha256 ", (&dg[0]) as u64, 32)
    if dest.sink.phase == httpsink.PHASE_BODY {
        if dest.sink.chunked && !dest.sink.framing_bad {
            num_line(&out, "fetch: chunked ", 1)
        }
        num_line(&out, "fetch: body ", dest.sink.body_octets)
        var bd: [u8; 32] = [0; 32]
        httpsink.sink_body_digest(&dest.sink, (&bd[0]) as u64)
        hex_line(&out, "fetch: bodysha ", (&bd[0]) as u64, 32)
    }
    var e: usize = 0
    while e < dest.sink.head_len && dest.sink.head[e] != 13 as u8
        && dest.sink.head[e] != 10 as u8 {
        e = e + 1
    }
    let headp: u64 = (&dest.sink.head[0]) as u64
    text_line(&out, "fetch: status ", headp, e)
    num_line(&out, "fetch: code ", status_code(headp, e))
    if outfile != 0 {
        if okf {
            io.print("fetch: written\n")
        } else {
            io.print("fetch: the file could not be written\n")
        }
    }
    if !quiet {
        rt.write_everything(1, headp, dest.sink.head_len)
        io.print("\n")
    }
    rt.buf_free(&out)
    return 0
}


fn over_tls(c: *mut net.Conn, out: *mut rt.Buf, dest: *mut httpfile.Dest,
    name: u64, namelen: usize, path: u64, pathlen: usize, roots: u64,
    insecure: bool, von: u64) -> i32 {
    var storebuf: rt.Buf = rt.buf_new()
    var store: x509.Store = x509.store_new()
    var rootpath: [u8; 20] = "/etc/ssl/roots.pem\0\0"
    var rp: u64 = roots
    if rp == 0 {
        rp = (&rootpath[0]) as u64
    }
    if rt.read_file(rp, &storebuf) {
        let taken: usize = x509.store_load_pem(&store, storebuf.ptr,
            storebuf.len)
        num_line(out, "fetch: roots ", taken as u64)
        var rs: roots.RootStats = roots.stats_new()
        var keepb: rt.Buf = rt.buf_new()
        roots.roots_scan(storebuf.ptr, storebuf.len, clockgate.now_raw(), 2592000 as u64, &rs, &keepb)
        rt.buf_free(&keepb)
        if rs.expired > 0 {
            var wl: rt.Buf = rt.buf_new()
            roots.expired_summary(&rs, &wl, 56)
            io.print("fetch: WARNING ")
            rt.write_everything(1, wl.ptr, wl.len)
            io.print("\n")
            rt.buf_free(&wl)
        }
        if rs.soon > 0 {
            io.print("fetch: WARNING trust roots expire within 30 days\n")
        }
        roots.stats_free(&rs)
    } else {
        io.print("fetch: no trust store -- nothing is trusted\n")
        num_line(out, "fetch: roots ", 0)
    }
    if insecure {
        io.print("fetch: WARNING -k, the certificate is NOT checked\n")
    }

    var t: tls.Tls = tls.tls_new()
    let trusted_now: u64 = clockgate.now_trusted()
    if trusted_now == 0 {
        io.print("fetch: WARNING the clock is not set -- certificates cannot be checked\n")
    }
    let oki: bool = tls.tls_init(&t, c, &store, name, namelen, trusted_now)
    var failed: bool = false
    let ok: bool = tls.tls_handshake(&t)
    catch | e | tls.tls_fail_into(out, e, &failed)
    if failed && !insecure {
        io.print("fetch: handshake FAILED\n")
        reason(out, tls.tls_verify_reason(&t))
        num_line(out, "fetch: alert ", tls.tls_alert_desc(&t) as u64)
        return 1
    }
    if failed {
        io.print("fetch: handshake FAILED even with -k\n")
        return 1
    }
    reason(out, tls.tls_verify_reason(&t))
    num_line(out, "fetch: suite ", tls.tls_suite(&t) as u64)
    num_line(out, "fetch: certs ", tls.tls_peer_cert_count(&t) as u64)
    num_line(out, "fetch: depth ", tls.tls_chain_depth(&t) as u64)

    var req: rt.Buf = rt.buf_new()
    request(&req, name, namelen, path, pathlen, von)
    var werr: bool = false
    let okw: bool = tls.tls_write(&t, req.ptr, req.len)
    catch | e | tls.tls_fail_into(out, e, &werr)
    rt.buf_free(&req)
    if werr {
        io.print("fetch: the request could not be sent\n")
        return 1
    }
    var chunk: [u8; 4096] = [0; 4096]
    var rerr: bool = false
    while true {
        let n: usize = tls.tls_read(&t, (&chunk[0]) as u64, CHUNK)
        catch | e | tls.tls_fail_len(out, e, &rerr)
        if rerr || n == 0 {
            break
        }
        httpfile.dest_feed(dest, (&chunk[0]) as u64, n)
    }
    num_line(out, "fetch: records_in ", tls.tls_records_in(&t) as u64)
    num_line(out, "fetch: records_out ", tls.tls_records_out(&t) as u64)
    tls.tls_close(&t)
    tls.tls_free(&t)
    rt.buf_free(&storebuf)
    return 0
}

fn plain(c: *mut net.Conn, out: *mut rt.Buf, dest: *mut httpfile.Dest,
    name: u64, namelen: usize, path: u64, pathlen: usize, von: u64) -> i32 {
    var req: rt.Buf = rt.buf_new()
    request(&req, name, namelen, path, pathlen, von)
    var werr: bool = false
    let w: usize = net.write_all(c, req.ptr, req.len) catch fail_len(&werr)
    rt.buf_free(&req)
    if werr {
        io.print("fetch: the request could not be sent\n")
        return 1
    }
    var chunk: [u8; 4096] = [0; 4096]
    while true {
        var rerr: bool = false
        let n: usize = net.read(c, (&chunk[0]) as u64, CHUNK)
        catch fail_len(&rerr)
        if rerr || n == 0 {
            break
        }
        httpfile.dest_feed(dest, (&chunk[0]) as u64, n)
    }
    return 0
}

fn request(req: *mut rt.Buf, name: u64, namelen: usize, path: u64,
    pathlen: usize, von: u64) {
    var g: [u8; 5] = "GET \0"
    rt.buf_push_bytes(req, (&g[0]) as u64, 4)
    rt.buf_push_bytes(req, path, pathlen)
    var h: [u8; 18] = " HTTP/1.1\r\nHost: \0"
    rt.buf_push_bytes(req, (&h[0]) as u64, 17)
    rt.buf_push_bytes(req, name, namelen)
    var tail: [u8; 46] = "\r\nConnection: close\r\nUser-Agent: osum-fetch\r\n\0"
    rt.buf_push_bytes(req, (&tail[0]) as u64, 45)
    var crlf: [u8; 3] = "\r\n\0"
    if von > 0 {
        var rg: [u8; 16] = "Range: bytes=\0\0\0"
        rt.buf_push_bytes(req, (&rg[0]) as u64, 13)
        rt.buf_push_dec_u64(req, von)
        var dash: [u8; 4] = "-\r\n\0"
        rt.buf_push_bytes(req, (&dash[0]) as u64, 3)
    }
    rt.buf_push_bytes(req, (&crlf[0]) as u64, 2)
}

fn fail_conn(bad: *mut bool) -> net.Conn {
    *bad = true
    return net.Conn { fd: -1, err: 0, peer: 0 as u32, peer_port: 0 as u16 }
}

fn fail_len(bad: *mut bool) -> usize {
    *bad = true
    return 0 as usize
}

