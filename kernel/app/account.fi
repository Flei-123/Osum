import std.io
import std.rt
import knetz
import kjson
import kmsg
import ksiegel
import provider
import kspeicher
import kgegen
import prov_jarvis
import prov_xoffi
import prov_own
import prov_fleitec

const VORLAUF: u64 = 86400

const RC_OK: i32 = 0
const RC_WRONG: i32 = 1
const RC_AUFRUF: i32 = 2
const RC_MEHRDEUTIG: i32 = 3
const RC_ZWEITFAKTOR: i32 = 4
const RC_KEINNETZ: i32 = 5
const RC_ABGELEHNT: i32 = 6
const RC_ABGELAUFEN: i32 = 7
const RC_ERROR: i32 = 8
const RC_GEBREMST: i32 = 9
const RC_TLS: i32 = 10
const RC_DEVICE: i32 = 11

static mut secret: [u8; 256] = [0; 256]


fn line(name: str, value: u64, wl: usize) {
    io.print("konto: ")
    io.print(name)
    io.print(" = ")
    rt.write_everything(1, value, wl)
    io.print("\n")
}

fn line_c(name: str, value: u64) {
    line(name, value, rt.c_length(value))
}

fn line_n(name: str, v: u64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, v)
    line(name, b.ptr, b.len)
    rt.buf_free(&b)
}

fn stand_name(st: u32) -> str {
    if st == provider.S_OK { return "ok" }
    if st == provider.S_WRONG { return "falsch" }
    if st == provider.S_ZWEITFAKTOR { return "zweitfaktor" }
    if st == provider.S_MEHRDEUTIG { return "mehrdeutig" }
    if st == provider.S_KEINNETZ { return "keinnetz" }
    if st == provider.S_TLS { return "tls" }
    if st == provider.S_ABGELEHNT { return "abgelehnt" }
    if st == provider.S_ABGELAUFEN { return "abgelaufen" }
    if st == provider.S_GEBREMST { return "gebremst" }
    if st == provider.S_DEVICE { return "device" }
    return "fehler"
}

fn stand_rc(st: u32) -> i32 {
    if st == provider.S_OK { return RC_OK }
    if st == provider.S_WRONG { return RC_WRONG }
    if st == provider.S_ZWEITFAKTOR { return RC_ZWEITFAKTOR }
    if st == provider.S_MEHRDEUTIG { return RC_MEHRDEUTIG }
    if st == provider.S_KEINNETZ { return RC_KEINNETZ }
    if st == provider.S_TLS { return RC_TLS }
    if st == provider.S_DEVICE { return RC_DEVICE }
    if st == provider.S_ABGELEHNT { return RC_ABGELEHNT }
    if st == provider.S_ABGELAUFEN { return RC_ABGELAUFEN }
    if st == provider.S_GEBREMST { return RC_GEBREMST }
    return RC_ERROR
}

static mut k_ok: [u8; 17] = "konto.state.ok\0\0\0"
static mut k_fa: [u8; 21] = "konto.state.wrongpw\0\0"
static mut k_zw: [u8; 18] = "konto.state.mfa\0\0\0"
static mut k_me: [u8; 24] = "konto.state.ambiguous\0\0\0"
static mut k_kn: [u8; 22] = "konto.state.offline\0\0\0"
static mut k_tl: [u8; 18] = "konto.state.tls\0\0\0"
static mut k_ab: [u8; 23] = "konto.state.refused\0\0\0\0"
static mut k_al: [u8; 23] = "konto.state.expired\0\0\0\0"
static mut k_ge: [u8; 24] = "konto.state.throttled\0\0\0"
static mut k_fe: [u8; 20] = "konto.state.error\0\0\0"
static mut k_dv: [u8; 19] = "konto.state.device\0"

fn state_key(st: u32) -> u64 {
    if st == provider.S_OK { return (&k_ok[0]) as u64 }
    if st == provider.S_WRONG { return (&k_fa[0]) as u64 }
    if st == provider.S_ZWEITFAKTOR { return (&k_zw[0]) as u64 }
    if st == provider.S_MEHRDEUTIG { return (&k_me[0]) as u64 }
    if st == provider.S_KEINNETZ { return (&k_kn[0]) as u64 }
    if st == provider.S_TLS { return (&k_tl[0]) as u64 }
    if st == provider.S_DEVICE { return (&k_dv[0]) as u64 }
    if st == provider.S_ABGELEHNT { return (&k_ab[0]) as u64 }
    if st == provider.S_ABGELAUFEN { return (&k_al[0]) as u64 }
    if st == provider.S_GEBREMST { return (&k_ge[0]) as u64 }
    return (&k_fe[0]) as u64
}

fn say(st: u32) {
    io.print("konto: stand = ")
    io.print(stand_name(st))
    io.print("\n")
    let t: u64 = kmsg.get(state_key(st))
    line_c("text", t)
}


fn eq(a: u64, b: u64) -> bool {
    var i: usize = 0
    while true {
        let x: u8 = rt.ld8(a, i)
        let y: u8 = rt.ld8(b, i)
        if x != y {
            return false
        }
        if x == 0 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

fn anhang(word: u64, name: u64) -> u64 {
    var i: usize = 0
    while true {
        let y: u8 = rt.ld8(name, i)
        if y == 0 as u8 {
            if rt.ld8(word, i) == 61 as u8 {
                return word + (i as u64) + 1
            }
            return 0
        }
        if rt.ld8(word, i) != y {
            return 0
        }
        i = i + 1
    }
    return 0
}

fn opt(start: u64, argc: usize, name: u64) -> u64 {
    var i: usize = 1
    while i < argc {
        let w: u64 = rt.arg_ptr(start, i)
        let a: u64 = anhang(w, name)
        if a != 0 {
            return a
        }
        if i + 1 < argc && eq(w, name) {
            return rt.arg_ptr(start, i + 1)
        }
        i = i + 1
    }
    return 0
}

fn schalter(start: u64, argc: usize, name: u64) -> bool {
    var i: usize = 1
    while i < argc {
        if eq(rt.arg_ptr(start, i), name) {
            return true
        }
        i = i + 1
    }
    return false
}

fn opt_a(start: u64, argc: usize, name: u64, alias: u64) -> u64 {
    let r: u64 = opt(start, argc, name)
    if r != 0 {
        return r
    }
    return opt(start, argc, alias)
}

fn flag_a(start: u64, argc: usize, name: u64, alias: u64) -> bool {
    if schalter(start, argc, name) {
        return true
    }
    return schalter(start, argc, alias)
}

fn exchange_word(st: u32) -> str {
    if st == provider.S_OK { return "ok" }
    if st == provider.S_KEINNETZ { return "offline" }
    if st == provider.S_ABGELEHNT { return "denied" }
    return "failed"
}

fn secret_read(aufforderung: u64) -> usize {
    var t: [u8; 64] = [0; 64]
    var alt: [u8; 64] = [0; 64]
    var tty: bool = false
    if syscall(16, 0, 0x5401, (&t[0]) as i64, 0, 0, 0) >= 0 {
        tty = true
        var i: usize = 0
        while i < 60 {
            alt[i] = t[i]
            i = i + 1
        }
        let lf: u32 = rt.ld32((&t[0]) as u64, 3)
        rt.st32((&t[0]) as u64, 3, lf & 4294967287 as u32)
        syscall(16, 0, 0x5404, (&t[0]) as i64, 0, 0, 0)
        if aufforderung != 0 {
            io.eprint_bytes(aufforderung, rt.c_length(aufforderung))
        }
    }
    var n: usize = 0
    var c: [u8; 1] = [0; 1]
    while true {
        let r: i64 = syscall(0, 0, (&c[0]) as i64, 1, 0, 0, 0)
        if r <= 0 {
            break
        }
        if c[0] == 10 as u8 || c[0] == 13 as u8 {
            break
        }
        if n + 1 < 256 {
            secret[n] = c[0]
            n = n + 1
        }
    }
    secret[n] = 0 as u8
    if tty {
        syscall(16, 0, 0x5404, (&alt[0]) as i64, 0, 0, 0)
        io.eprint("\n")
    }
    return n
}

fn secret_forgotten() {
    var i: usize = 0
    while i < 256 {
        secret[i] = 0 as u8
        i = i + 1
    }
}

fn now() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 0, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] as u64
}

fn word_end(p: u64, i: usize, n: usize) -> usize {
    var k: usize = i
    while k < n {
        let c: u8 = rt.ld8(p, k)
        if c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 13 as u8 {
            return k
        }
        k = k + 1
    }
    return n
}

fn word_begin(p: u64, i: usize, n: usize) -> usize {
    var k: usize = i
    while k < n {
        let c: u8 = rt.ld8(p, k)
        if c != 32 as u8 && c != 9 as u8 {
            return k
        }
        k = k + 1
    }
    return n
}

fn conf_read(anb: u64, b: *mut rt.Buf, endpoint: *mut u64, zname: *mut u64,
    wurzeln: *mut u64) -> bool {
    var req_path: [u8; 18] = "/etc/konten.conf\0\0"
    if !rt.read_file((&req_path[0]) as u64, b) {
        return false
    }
    let p: u64 = rt.buf_ptr(b)
    let n: usize = rt.buf_len(b)
    var f_target: [u8; 5] = "ziel\0"
    var f_name: [u8; 5] = "name\0"
    var f_wu: [u8; 8] = "wurzeln\0"
    var etwas: bool = false
    var i: usize = 0
    while i < n {
        var ze: usize = i
        while ze < n && rt.ld8(p, ze) != 10 as u8 {
            ze = ze + 1
        }
        rt.st8(p, ze, 0 as u8)
        var w: usize = word_begin(p, i, ze)
        if w < ze && rt.ld8(p, w) != 35 as u8 {
            let we: usize = word_end(p, w, ze)
            let treffer: bool = we - w == rt.c_length(anb)
                && rt.mem_eq(p + w as u64, anb, we - w)
            var k: usize = we
            if we < ze {
                rt.st8(p, we, 0 as u8)
                k = we + 1
            }
            if treffer {
                while k < ze {
                    let a: usize = word_begin(p, k, ze)
                    if a >= ze {
                        k = ze
                    } else {
                        let e: usize = word_end(p, a, ze)
                        if e < ze {
                            rt.st8(p, e, 0 as u8)
                        }
                        let z1: u64 = anhang(p + a as u64, (&f_target[0]) as u64)
                        let z2: u64 = anhang(p + a as u64, (&f_name[0]) as u64)
                        let z3: u64 = anhang(p + a as u64, (&f_wu[0]) as u64)
                        if z1 != 0 && *endpoint == 0 {
                            *endpoint = z1
                            etwas = true
                        }
                        if z2 != 0 && *zname == 0 {
                            *zname = z2
                            etwas = true
                        }
                        if z3 != 0 && *wurzeln == 0 {
                            *wurzeln = z3
                            etwas = true
                        }
                        k = e + 1
                    }
                }
            }
        }
        i = ze + 1
    }
    return etwas
}

fn push_login(tab: u64) {
    provider.board_set(tab, provider.MAX_PUSH)
    let _1: bool = provider.eintragen(prov_jarvis.push())
    let _2: bool = provider.eintragen(prov_xoffi.push())
    let _3: bool = provider.eintragen(prov_own.push())
    let _4: bool = provider.eintragen(prov_fleitec.push())
}

static mut empty_text: [u8; 1] = "\0"

fn sleep_secs(n: u64) {
    var ts: [i64; 2] = [0; 2]
    ts[0] = n as i64
    syscall(35, (&ts[0]) as i64, 0, 0, 0, 0, 0)
}

fn dev_show(s: *mut provider.Session) {
    line("code", (*s).dev_code.ptr, (*s).dev_code.len)
    line("url", (*s).dev_url.ptr, (*s).dev_url.len)
    if (*s).dev_url_full.len > 0 {
        line("url_complete", (*s).dev_url_full.ptr, (*s).dev_url_full.len)
    }
    line("zwischen", (*s).temp.ptr, (*s).temp.len)
    line_n("interval", (*s).interval)
    line_n("expires_in", (*s).expires_in)
}

fn dev_wait(i: usize, z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    var dc: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&dc, (*s).temp.ptr, (*s).temp.len)
    rt.buf_push(&dc, 0 as u8)
    var iv: u64 = (*s).interval
    if iv < 1 {
        iv = 5
    }
    let ende: u64 = now() + (*s).expires_in
    var n: u64 = 0
    var st: u32 = provider.S_DEVICE
    while st == provider.S_DEVICE || st == provider.S_GEBREMST {
        if now() + iv > ende {
            st = provider.S_ABGELAUFEN
            break
        }
        sleep_secs(iv)
        (*z).temp = dc.ptr
        st = provider.do_sign_in(i, z, s)
        n = n + 1
        if st == provider.S_GEBREMST {
            iv = iv + 5
        }
    }
    line_n("polls", n)
    line_n("interval", iv)
    rt.mem_set(dc.ptr, 0 as u8, dc.len)
    rt.buf_free(&dc)
    return st
}


fn cmd_login(start: u64, argc: usize) -> i32 {
    var o_anb: [u8; 11] = "--anbieter\0"
    var o_prov: [u8; 11] = "--provider\0"
    var o_tgt: [u8; 9] = "--target\0"
    var o_target: [u8; 7] = "--ziel\0"
    var o_name: [u8; 7] = "--name\0"
    var o_wu: [u8; 10] = "--wurzeln\0"
    var o_ken: [u8; 10] = "--kennung\0"
    var o_id: [u8; 11] = "--identity\0"
    var o_ber: [u8; 10] = "--bereich\0"
    var o_code: [u8; 7] = "--code\0"
    var o_zw: [u8; 11] = "--continue\0"
    var o_zwa: [u8; 11] = "--zwischen\0"
    var o_lok: [u8; 8] = "--lokal\0"
    var o_gt: [u8; 9] = "--device\0"
    var o_gta: [u8; 9] = "--geraet\0"
    var o_wa: [u8; 7] = "--wait\0"
    var o_waa: [u8; 9] = "--warten\0"
    var o_cl: [u8; 9] = "--client\0"
    var o_au: [u8; 6] = "--aud\0"
    var o_ta: [u8; 11] = "--exchange\0"
    var o_taa: [u8; 11] = "--tauschen\0"

    let anb: u64 = opt_a(start, argc, (&o_anb[0]) as u64, (&o_prov[0]) as u64)
    var endpoint: u64 = opt_a(start, argc, (&o_target[0]) as u64, (&o_tgt[0]) as u64)
    var zname: u64 = opt(start, argc, (&o_name[0]) as u64)
    var wurzeln: u64 = opt(start, argc, (&o_wu[0]) as u64)
    var kenn: u64 = opt_a(start, argc, (&o_ken[0]) as u64, (&o_id[0]) as u64)
    let use_device: bool = flag_a(start, argc, (&o_gt[0]) as u64, (&o_gta[0]) as u64)
    let do_wait: bool = flag_a(start, argc, (&o_wa[0]) as u64, (&o_waa[0]) as u64)
    let do_exchange: bool = flag_a(start, argc, (&o_ta[0]) as u64, (&o_taa[0]) as u64)
    if use_device && kenn == 0 {
        kenn = (&empty_text[0]) as u64
    }
    var conf: rt.Buf = rt.buf_new()
    if anb != 0 {
        let _k: bool = conf_read(anb, &conf, &endpoint, &zname, &wurzeln)
    }
    if do_exchange && !use_device {
        line_c("hinweis", "--exchange needs --device\0".p as u64)
        rt.buf_free(&conf)
        return RC_AUFRUF
    }
    if anb == 0 || endpoint == 0 || kenn == 0 {
        io.eprint_line("konto: login needs --provider, --identity and a target (--target or /etc/konten.conf)")
        rt.buf_free(&conf)
        return RC_AUFRUF
    }
    let i: i64 = provider.waehle(anb)
    if i < 0 {
        io.eprint("konto: diesen Anbieter gibt es nicht. Es gibt: ")
        var k: usize = 0
        while k < provider.num_items() {
            if k > 0 {
                io.eprint(" ")
            }
            io.eprint_bytes(provider.name_von(k),
                rt.c_length(provider.name_von(k)))
            k = k + 1
        }
        io.eprint("\n")
        rt.buf_free(&conf)
        return RC_AUFRUF
    }

    var z: provider.Access = provider.access_new()
    z.endpoint = endpoint
    z.zielname = zname
    z.wurzeln = wurzeln
    z.kennung = kenn
    z.bereich = opt(start, argc, (&o_ber[0]) as u64)
    z.code = opt(start, argc, (&o_code[0]) as u64)
    z.temp = opt_a(start, argc, (&o_zw[0]) as u64, (&o_zwa[0]) as u64)
    z.klient = opt(start, argc, (&o_cl[0]) as u64)
    z.zielgruppe = opt(start, argc, (&o_au[0]) as u64)

    if use_device {
        z.modus = 1
        z.secret = (&empty_text[0]) as u64
    } else {
        var ask: [u8; 12] = "Kennwort: \0\0"
        let gl: usize = secret_read((&ask[0]) as u64)
        z.secret = (&secret[0]) as u64
    }

    var s: provider.Session = provider.session_new()
    var st: u32 = provider.do_sign_in(i as usize, &z, &s)
    secret_forgotten()

    if st == provider.S_DEVICE {
        say(st)
        dev_show(&s)
        if !do_wait {
            provider.session_free(&s)
            rt.buf_free(&conf)
            return RC_DEVICE
        }
        st = dev_wait(i as usize, &z, &s)
    }

    say(st)
    if st == provider.S_MEHRDEUTIG {
        var a: usize = 0
        while a < s.choice.len {
            var e: usize = a
            while e < s.choice.len && rt.ld8(s.choice.ptr, e)
                != 10 as u8 {
                e = e + 1
            }
            if e > a {
                line("auswahl", s.choice.ptr + a as u64, e - a)
            }
            a = e + 1
        }
        provider.session_free(&s)
        rt.buf_free(&conf)
        return RC_MEHRDEUTIG
    }
    if st == provider.S_ZWEITFAKTOR {
        line("zwischen", s.temp.ptr, s.temp.len)
        provider.session_free(&s)
        rt.buf_free(&conf)
        return RC_ZWEITFAKTOR
    }
    if st != provider.S_OK {
        if s.hinweis.len > 0 {
            var h: rt.Buf = rt.buf_new()
            rt.buf_push_bytes(&h, s.hinweis.ptr, s.hinweis.len)
            rt.buf_push(&h, 0 as u8)
            line_c("hinweis", kmsg.get(h.ptr))
            rt.buf_free(&h)
        }
        provider.session_free(&s)
        rt.buf_free(&conf)
        return stand_rc(st)
    }

    var ken: rt.Buf = rt.buf_new()
    var berc: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&berc, s.bereich.ptr, s.bereich.len)
    rt.buf_push(&berc, 0 as u8)
    provider.kennung(anb, berc.ptr, s.subjekt.ptr, s.subjekt.len, &ken)

    var ko: kspeicher.Account = kspeicher.account_new()
    rt.buf_push_bytes(&ko.kennung, ken.ptr, ken.len)
    rt.buf_push_bytes(&ko.provider, anb, rt.c_length(anb))
    rt.buf_push_bytes(&ko.bereich, s.bereich.ptr, s.bereich.len)
    rt.buf_push_bytes(&ko.subjekt, s.subjekt.ptr, s.subjekt.len)
    rt.buf_push_bytes(&ko.anzeige, s.anzeige.ptr, s.anzeige.len)
    rt.buf_push_bytes(&ko.datenort, s.datenort.ptr, s.datenort.len)
    let lok: u64 = opt(start, argc, (&o_lok[0]) as u64)
    if lok != 0 {
        rt.buf_push_bytes(&ko.local_val, lok, rt.c_length(lok))
    } else {
        var wer: rt.Buf = rt.buf_new()
        if kmsg.benutzername(&wer) {
            rt.buf_push_bytes(&ko.local_val, wer.ptr, wer.len)
        }
        rt.buf_free(&wer)
    }
    let _e: bool = kspeicher.account_set(&ko)

    var gesiegelt: bool = true
    if kgegen.an(kgegen.G_KLARTEXT) {
        var pf: rt.Buf = rt.buf_new()
        kspeicher.session_path(ken.ptr, ken.len, &pf)
        let _v: bool = ksiegel.dir(pf.ptr)
        var d1: [u8; 7] = "/state\0"
        var d2: [u8; 15] = "/state/session\0"
        var d3: [u8; 21] = "/state/session/konto\0"
        let _a: bool = ksiegel.dir((&d1[0]) as u64)
        let _b: bool = ksiegel.dir((&d2[0]) as u64)
        let _c: bool = ksiegel.dir((&d3[0]) as u64)
        let _w: bool = ksiegel.file_write_0600(pf.ptr, s.zugriff.ptr,
            s.zugriff.len)
        rt.buf_free(&pf)
        gesiegelt = false
    } else {
        if !kspeicher.session_save(ken.ptr, ken.len, &s, endpoint,
            z.zielname) {
            io.eprint_line("konto: the session could not be stored")
            provider.session_free(&s)
            rt.buf_free(&ken)
            rt.buf_free(&berc)
            rt.buf_free(&conf)
            return RC_ERROR
        }
    }

    line_c("anbieter", anb)
    line("kennung", ken.ptr, ken.len)
    line("bereich", s.bereich.ptr, s.bereich.len)
    line("subjekt", s.subjekt.ptr, s.subjekt.len)
    line("anzeige", s.anzeige.ptr, s.anzeige.len)
    line("datenort", s.datenort.ptr, s.datenort.len)
    line("lokal", ko.local_val.ptr, ko.local_val.len)
    line_n("ablauf", s.ablauf)
    if gesiegelt {
        line_n("gesiegelt", 1)
    } else {
        line_n("gesiegelt", 0)
    }
    var rc: i32 = RC_OK
    if do_exchange {
        let ust: u32 = provider.do_hand_over(i as usize, &z, &s)
        rt.mem_set(s.zugriff.ptr, 0 as u8, s.zugriff.len)
        let usn: str = exchange_word(ust)
        line("exchange", usn.p as u64, usn.n)
        if ust != provider.S_OK && s.hinweis.len > 0 {
            var uh: rt.Buf = rt.buf_new()
            rt.buf_push_bytes(&uh, s.hinweis.ptr, s.hinweis.len)
            rt.buf_push(&uh, 0 as u8)
            line_c("hinweis", kmsg.get(uh.ptr))
            rt.buf_free(&uh)
        }
        rc = stand_rc(ust)
    }
    provider.session_free(&s)
    rt.buf_free(&ken)
    rt.buf_free(&berc)
    rt.buf_free(&conf)
    return rc
}


fn cmd_list() -> i32 {
    var b: rt.Buf = rt.buf_new()
    let da: bool = kspeicher.list_read(&b)
    if !da {
        line_n("konten", 0)
        rt.buf_free(&b)
        return RC_OK
    }
    let n: usize = kspeicher.lines(&b)
    line_n("konten", n as u64)
    var ko: kspeicher.Account = kspeicher.account_new()
    var k: usize = 0
    while k < n {
        if kspeicher.account_read(&b, k, &ko) {
            io.print("konto: eintrag = ")
            rt.write_everything(1, ko.provider.ptr, ko.provider.len)
            io.print("\t")
            rt.write_everything(1, ko.bereich.ptr, ko.bereich.len)
            io.print("\t")
            rt.write_everything(1, ko.anzeige.ptr, ko.anzeige.len)
            io.print("\t")
            rt.write_everything(1, ko.kennung.ptr, ko.kennung.len)
            io.print("\t")
            rt.write_everything(1, ko.local_val.ptr, ko.local_val.len)
            io.print("\n")
        }
        k = k + 1
    }
    rt.buf_free(&b)
    return RC_OK
}

fn in_status(ko: *mut kspeicher.Account, without_net: bool) -> u32 {
    var s: provider.Session = provider.session_new()
    var endpoint: rt.Buf = rt.buf_new()
    var zielname: rt.Buf = rt.buf_new()
    let da: bool = kspeicher.session_load((*ko).kennung.ptr,
        (*ko).kennung.len, &s, &endpoint, &zielname)
    io.print("konto: eintrag = ")
    rt.write_everything(1, (*ko).provider.ptr, (*ko).provider.len)
    io.print("\t")
    rt.write_everything(1, (*ko).kennung.ptr, (*ko).kennung.len)
    io.print("\n")
    if !da {
        line_n("sitzung", 0)
        provider.session_free(&s)
        rt.buf_free(&endpoint)
        rt.buf_free(&zielname)
        return provider.S_ABGELAUFEN
    }
    line_n("sitzung", 1)
    let n: u64 = now()
    line_n("ablauf", s.ablauf)
    if s.ablauf > n {
        line_n("rest", s.ablauf - n)
    } else {
        line_n("rest", 0)
    }
    var stand: u32 = provider.S_OK
    var braucht: bool = false
    if s.ablauf > 0 && s.ablauf < n + VORLAUF {
        braucht = true
    }
    line_n("erneuern_faellig", 0)
    if braucht {
        line_n("erneuern_faellig", 1)
    }
    if braucht && !without_net {
        rt.buf_push(&endpoint, 0 as u8)
        rt.buf_set_len(&endpoint, endpoint.len - 1)
        rt.buf_push(&zielname, 0 as u8)
        rt.buf_set_len(&zielname, zielname.len - 1)
        var ken: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&ken, s.zugriff.ptr, s.zugriff.len)
        rt.buf_push(&ken, 0 as u8)
        var refb: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&refb, s.erneuerung.ptr, s.erneuerung.len)
        rt.buf_push(&refb, 0 as u8)
        var z: provider.Access = provider.access_new()
        z.endpoint = endpoint.ptr
        z.zielname = zielname.ptr
        z.zugriff = ken.ptr
        z.erneuerung = refb.ptr
        let i: i64 = provider.waehle(provider_name(ko))
        if i >= 0 {
            let r: u32 = provider.tu_erneuern(i as usize, &z, &s)
            if r == provider.S_OK {
                let _sp: bool = kspeicher.session_save(
                    (*ko).kennung.ptr, (*ko).kennung.len, &s, endpoint.ptr,
                    zielname.ptr)
                line_n("erneuert", 1)
                line_n("ablauf", s.ablauf)
            } else if r == provider.S_KEINNETZ {
                line_n("erneuert", 0)
                line("netz", (&nein[0]) as u64, 4)
                stand = provider.S_OK
            } else {
                let _l: bool = kspeicher.session_delete(
                    (*ko).kennung.ptr, (*ko).kennung.len)
                line_n("erneuert", 0)
                line_n("abgemeldet", 1)
                stand = provider.S_ABGELAUFEN
            }
        }
        rt.buf_free(&ken)
        rt.buf_free(&refb)
    }
    if s.ablauf > 0 && s.ablauf <= n && stand == provider.S_OK {
        stand = provider.S_ABGELAUFEN
    }
    provider.session_free(&s)
    rt.buf_free(&endpoint)
    rt.buf_free(&zielname)
    return stand
}

static mut nein: [u8; 5] = "nein\0"
static mut namenspuffer: [u8; 64] = [0; 64]

fn provider_name(ko: *mut kspeicher.Account) -> u64 {
    var i: usize = 0
    while i < (*ko).provider.len && i < 63 {
        namenspuffer[i] = rt.ld8((*ko).provider.ptr, i)
        i = i + 1
    }
    namenspuffer[i] = 0 as u8
    return (&namenspuffer[0]) as u64
}

fn cmd_status(start: u64, argc: usize) -> i32 {
    var o_without: [u8; 12] = "--ohne-netz\0"
    var o_ken: [u8; 10] = "--kennung\0"
    var o_id: [u8; 11] = "--identity\0"
    let without: bool = schalter(start, argc, (&o_without[0]) as u64)
    let only: u64 = opt_a(start, argc, (&o_ken[0]) as u64, (&o_id[0]) as u64)
    var b: rt.Buf = rt.buf_new()
    if !kspeicher.list_read(&b) {
        line_n("konten", 0)
        rt.buf_free(&b)
        say(provider.S_OK)
        return RC_OK
    }
    let n: usize = kspeicher.lines(&b)
    line_n("konten", n as u64)
    var ko: kspeicher.Account = kspeicher.account_new()
    var k: usize = 0
    var schlimmster: u32 = provider.S_OK
    while k < n {
        if kspeicher.account_read(&b, k, &ko) {
            var nimm: bool = true
            if only != 0 {
                nimm = ko.kennung.len == rt.c_length(only)
                if nimm {
                    nimm = rt.mem_eq(ko.kennung.ptr, only, ko.kennung.len)
                }
            }
            if nimm {
                let st: u32 = in_status(&ko, without)
                if st != provider.S_OK {
                    schlimmster = st
                }
            }
        }
        k = k + 1
    }
    rt.buf_free(&b)
    say(schlimmster)
    return stand_rc(schlimmster)
}


fn cmd_logout(start: u64, argc: usize) -> i32 {
    var o_ken: [u8; 10] = "--kennung\0"
    var o_id: [u8; 11] = "--identity\0"
    let only: u64 = opt_a(start, argc, (&o_ken[0]) as u64, (&o_id[0]) as u64)
    var b: rt.Buf = rt.buf_new()
    if !kspeicher.list_read(&b) {
        line_n("abgemeldet", 0)
        rt.buf_free(&b)
        return RC_OK
    }
    let n: usize = kspeicher.lines(&b)
    var ko: kspeicher.Account = kspeicher.account_new()
    var k: usize = 0
    var wieviele: u64 = 0
    var serverstand: u32 = provider.S_OK
    while k < n {
        if kspeicher.account_read(&b, k, &ko) {
            var nimm: bool = true
            if only != 0 {
                nimm = ko.kennung.len == rt.c_length(only)
                if nimm {
                    nimm = rt.mem_eq(ko.kennung.ptr, only, ko.kennung.len)
                }
            }
            if nimm {
                var s: provider.Session = provider.session_new()
                var endpoint: rt.Buf = rt.buf_new()
                var zielname: rt.Buf = rt.buf_new()
                if kspeicher.session_load(ko.kennung.ptr,
                    ko.kennung.len, &s, &endpoint, &zielname) {
                    rt.buf_push(&endpoint, 0 as u8)
                    rt.buf_set_len(&endpoint, endpoint.len - 1)
                    rt.buf_push(&zielname, 0 as u8)
                    rt.buf_set_len(&zielname, zielname.len - 1)
                    var tok: rt.Buf = rt.buf_new()
                    rt.buf_push_bytes(&tok, s.zugriff.ptr, s.zugriff.len)
                    rt.buf_push(&tok, 0 as u8)
                    var rtk: rt.Buf = rt.buf_new()
                    rt.buf_push_bytes(&rtk, s.erneuerung.ptr, s.erneuerung.len)
                    rt.buf_push(&rtk, 0 as u8)
                    var z: provider.Access = provider.access_new()
                    z.endpoint = endpoint.ptr
                    z.zielname = zielname.ptr
                    z.zugriff = tok.ptr
                    z.erneuerung = rtk.ptr
                    let i: i64 = provider.waehle(provider_name(&ko))
                    if i >= 0 {
                        let r: u32 = provider.do_sign_out(i as usize, &z,
                            &s)
                        if r != provider.S_OK {
                            serverstand = r
                        }
                    }
                    rt.mem_set(rtk.ptr, 0 as u8, rtk.len)
                    rt.buf_free(&rtk)
                    rt.buf_free(&tok)
                }
                let _l: bool = kspeicher.session_delete(ko.kennung.ptr,
                    ko.kennung.len)
                let _r: bool = kspeicher.remove_account(ko.kennung.ptr,
                    ko.kennung.len)
                wieviele = wieviele + 1
                provider.session_free(&s)
                rt.buf_free(&endpoint)
                rt.buf_free(&zielname)
            }
        }
        k = k + 1
    }
    rt.buf_free(&b)
    line_n("abgemeldet", wieviele)
    if serverstand != provider.S_OK {
        io.print("konto: server = ")
        io.print(stand_name(serverstand))
        io.print("\n")
        line_n("lokal_entfernt", 1)
    }
    say(provider.S_OK)
    return RC_OK
}

fn cmd_handover(start: u64, argc: usize) -> i32 {
    var o_ken: [u8; 10] = "--kennung\0"
    var o_id: [u8; 11] = "--identity\0"
    let only: u64 = opt_a(start, argc, (&o_ken[0]) as u64, (&o_id[0]) as u64)
    if only == 0 {
        io.eprint_line("konto: --identity is missing")
        return RC_AUFRUF
    }
    var b: rt.Buf = rt.buf_new()
    if !kspeicher.list_read(&b) {
        rt.buf_free(&b)
        return RC_ABGELAUFEN
    }
    let k: i64 = kspeicher.account_find(&b, only, rt.c_length(only))
    if k < 0 {
        rt.buf_free(&b)
        io.eprint_line("konto: no such account id")
        return RC_AUFRUF
    }
    var ko: kspeicher.Account = kspeicher.account_new()
    let _l: bool = kspeicher.account_read(&b, k as usize, &ko)
    var s: provider.Session = provider.session_new()
    var endpoint: rt.Buf = rt.buf_new()
    var zielname: rt.Buf = rt.buf_new()
    let da: bool = kspeicher.session_load(ko.kennung.ptr, ko.kennung.len,
        &s, &endpoint, &zielname)
    line("anbieter", ko.provider.ptr, ko.provider.len)
    line("bereich", ko.bereich.ptr, ko.bereich.len)
    line("subjekt", ko.subjekt.ptr, ko.subjekt.len)
    line("datenort", ko.datenort.ptr, ko.datenort.len)
    line("lokal", ko.local_val.ptr, ko.local_val.len)
    if da {
        line("zugriff", s.zugriff.ptr, s.zugriff.len)
        line_n("ablauf", s.ablauf)
    } else {
        line_n("ablauf", 0)
    }
    provider.session_free(&s)
    rt.buf_free(&endpoint)
    rt.buf_free(&zielname)
    rt.buf_free(&b)
    if !da {
        return RC_ABGELAUFEN
    }
    return RC_OK
}

fn cmd_providerlist() -> i32 {
    line_n("anbieter_anzahl", provider.num_items() as u64)
    var k: usize = 0
    while k < provider.num_items() {
        line_c("anbieter_name", provider.name_von(k))
        k = k + 1
    }
    return RC_OK
}

fn hilfe() {
    io.print("konto login --provider=<name> --identity=<name> [--target=<url>]\n")
    io.print("               [--name=<zertifikatsname>] [--wurzeln=<pem>]\n")
    io.print("               [--bereich=<mandant>] [--code=<faktor>]\n")
    io.print("               [--continue=<token>] [--lokal=<benutzer>]\n")
    io.print("               [--device [--wait] [--exchange]]\n")
    io.print("               (old names still valid: --anbieter --kennung --ziel --zwischen --geraet --warten --tauschen)\n")
    io.print("               ohne --ziel gilt die Zeile aus /etc/konten.conf\n")
    io.print("konto list | status [--ohne-netz] | renew | logout\n")
    io.print("konto providers | handover --identity <k> | --text <key>\n")
    io.print("(old names still valid: liste erneuern abmelden anbieter uebergabe)\n")
}

#[allow_escape]
fn main(start: u64) -> i32 {
    var tab: [provider.Push; 8] = [provider.empty_push(); 8]
    push_login((&tab[0]) as u64)

    let argc: usize = rt.arg_count(start)
    if argc < 2 {
        hilfe()
        return RC_AUFRUF
    }
    var o_broken: [u8; 9] = "--kaputt\0"
    let kw: u64 = opt(start, argc, (&o_broken[0]) as u64)
    if kw != 0 {
        if !kgegen.set(kw) {
            io.eprint_line("konto: no such counter-proof")
            return RC_AUFRUF
        }
    }
    var o_text: [u8; 7] = "--text\0"
    let tk: u64 = opt(start, argc, (&o_text[0]) as u64)
    if tk != 0 {
        let t: u64 = kmsg.get(tk)
        rt.write_everything(1, t, rt.c_length(t))
        io.print("\n")
        return RC_OK
    }

    var c_an: [u8; 9] = "anmelden\0"
    var c_li: [u8; 6] = "liste\0"
    var c_st: [u8; 7] = "status\0"
    var c_ab: [u8; 9] = "abmelden\0"
    var c_er: [u8; 9] = "erneuern\0"
    var c_ue: [u8; 10] = "uebergabe\0"
    var c_ue2: [u8; 10] = "übergabe\0"
    var c_pr: [u8; 9] = "anbieter\0"
    var c_li_en: [u8; 5] = "list\0"
    var c_er_en: [u8; 6] = "renew\0"
    var c_ab_en: [u8; 7] = "logout\0"
    var c_ue_en: [u8; 9] = "handover\0"
    var c_pr_en: [u8; 10] = "providers\0"
    var c_an_en: [u8; 6] = "login\0"
    var cmd: u64 = 0
    var ci: usize = 1
    while ci < argc && cmd == 0 {
        let w: u64 = rt.arg_ptr(start, ci)
        if eq(w, (&c_an[0]) as u64) || eq(w, (&c_li[0]) as u64)
            || eq(w, (&c_st[0]) as u64) || eq(w, (&c_ab[0]) as u64)
            || eq(w, (&c_er[0]) as u64) || eq(w, (&c_ue[0]) as u64)
            || eq(w, (&c_ue2[0]) as u64)
            || eq(w, (&c_pr[0]) as u64)
            || eq(w, (&c_li_en[0]) as u64) || eq(w, (&c_er_en[0]) as u64)
            || eq(w, (&c_ab_en[0]) as u64) || eq(w, (&c_ue_en[0]) as u64)
            || eq(w, (&c_pr_en[0]) as u64) || eq(w, (&c_an_en[0]) as u64) {
            cmd = w
        }
        ci = ci + 1
    }
    if cmd == 0 {
        cmd = rt.arg_ptr(start, 1)
    }
    if eq(cmd, (&c_an[0]) as u64) || eq(cmd, (&c_an_en[0]) as u64) {
        return cmd_login(start, argc)
    }
    if eq(cmd, (&c_li[0]) as u64) || eq(cmd, (&c_li_en[0]) as u64) {
        return cmd_list()
    }
    if eq(cmd, (&c_st[0]) as u64) {
        return cmd_status(start, argc)
    }
    if eq(cmd, (&c_er[0]) as u64) || eq(cmd, (&c_er_en[0]) as u64) {
        return cmd_status(start, argc)
    }
    if eq(cmd, (&c_ab[0]) as u64) || eq(cmd, (&c_ab_en[0]) as u64) {
        return cmd_logout(start, argc)
    }
    if eq(cmd, (&c_ue[0]) as u64) || eq(cmd, (&c_ue2[0]) as u64) || eq(cmd, (&c_ue_en[0]) as u64) {
        return cmd_handover(start, argc)
    }
    if eq(cmd, (&c_pr[0]) as u64) || eq(cmd, (&c_pr_en[0]) as u64) {
        return cmd_providerlist()
    }
    hilfe()
    return RC_AUFRUF
}
