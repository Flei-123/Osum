// SPDX-License-Identifier: GPL-2.0-only

import std.rt
import std.io

export { load, get, sprache, entfalten, benutzername }

static mut geladen: bool = false

static mut catalog: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut lang: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut output: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }

fn line_from(b: *mut rt.Buf, i: usize, e: *mut usize) -> usize {
    var k: usize = i
    while k < (*b).len && rt.ld8((*b).ptr, k) != 10 as u8 {
        k = k + 1
    }
    *e = k
    return i
}

fn lang_off_conf(path: u64, aus: *mut rt.Buf) -> bool {
    var b: rt.Buf = rt.buf_new()
    if !rt.read_file(path, &b) {
        rt.buf_free(&b)
        return false
    }
    var i: usize = 0
    var gut: bool = false
    while i < b.len {
        var e: usize = 0
        let a: usize = line_from(&b, i, &e)
        var t: usize = a
        while t < e && (rt.ld8(b.ptr, t) == 32 as u8
            || rt.ld8(b.ptr, t) == 9 as u8) {
            t = t + 1
        }
        if t < e && rt.ld8(b.ptr, t) != 35 as u8 {
            var n: [u8; 5] = "lang\0"
            if t + 4 <= e && rt.mem_eq(b.ptr + t as u64,
                (&n[0]) as u64, 4) {
                var q: usize = t + 4
                while q < e && (rt.ld8(b.ptr, q) == 32 as u8
                    || rt.ld8(b.ptr, q) == 9 as u8) {
                    q = q + 1
                }
                if q < e && rt.ld8(b.ptr, q) == 61 as u8 {
                    q = q + 1
                    while q < e && (rt.ld8(b.ptr, q) == 32 as u8
                        || rt.ld8(b.ptr, q) == 9 as u8) {
                        q = q + 1
                    }
                    var f: usize = e
                    while f > q && (rt.ld8(b.ptr, f - 1) == 13 as u8
                        || rt.ld8(b.ptr, f - 1) == 32 as u8) {
                        f = f - 1
                    }
                    if f > q {
                        rt.buf_clear(aus)
                        rt.buf_push_bytes(aus, b.ptr + q as u64, f - q)
                        gut = true
                    }
                }
            }
        }
        i = e + 1
    }
    rt.buf_free(&b)
    return gut
}

fn lang_off_file(path: u64, aus: *mut rt.Buf) -> bool {
    var b: rt.Buf = rt.buf_new()
    if !rt.read_file(path, &b) {
        rt.buf_free(&b)
        return false
    }
    var n: usize = 0
    while n < b.len {
        let c: u8 = rt.ld8(b.ptr, n)
        if c == 10 as u8 || c == 13 as u8 || c == 32 as u8 || c == 0 as u8 {
            break
        }
        n = n + 1
    }
    if n == 0 {
        rt.buf_free(&b)
        return false
    }
    rt.buf_clear(aus)
    rt.buf_push_bytes(aus, b.ptr, n)
    rt.buf_free(&b)
    return true
}

fn benutzername(aus: *mut rt.Buf) -> bool {
    let uid: i64 = syscall(102, 0, 0, 0, 0, 0, 0)
    var pw: [u8; 12] = "/etc/passwd\0"
    var b: rt.Buf = rt.buf_new()
    if !rt.read_file((&pw[0]) as u64, &b) {
        rt.buf_free(&b)
        return false
    }
    var i: usize = 0
    var gut: bool = false
    while i < b.len {
        var e: usize = 0
        let a: usize = line_from(&b, i, &e)
        var f1: usize = a
        while f1 < e && rt.ld8(b.ptr, f1) != 58 as u8 {
            f1 = f1 + 1
        }
        var f2: usize = f1 + 1
        while f2 < e && rt.ld8(b.ptr, f2) != 58 as u8 {
            f2 = f2 + 1
        }
        var f3: usize = f2 + 1
        var v: i64 = 0
        var k: usize = f3
        while k < e && rt.ld8(b.ptr, k) >= 48 as u8
            && rt.ld8(b.ptr, k) <= 57 as u8 {
            v = v * 10 + (rt.ld8(b.ptr, k) - 48 as u8) as i64
            k = k + 1
        }
        if k > f3 && v == uid && !gut {
            rt.buf_clear(aus)
            rt.buf_push_bytes(aus, b.ptr + a as u64, f1 - a)
            gut = true
        }
        i = e + 1
    }
    rt.buf_free(&b)
    return gut
}

fn sprache_waehlen() {
    rt.buf_clear(&lang)
    var wer: rt.Buf = rt.buf_new()
    if benutzername(&wer) {
        var pf: rt.Buf = rt.buf_new()
        var a: [u8; 8] = "/users/\0"
        var b: [u8; 15] = "/config/locale\0"
        rt.buf_push_bytes(&pf, (&a[0]) as u64, 7)
        rt.buf_push_bytes(&pf, wer.ptr, wer.len)
        rt.buf_push_bytes(&pf, (&b[0]) as u64, 14)
        rt.buf_push(&pf, 0 as u8)
        let da: bool = lang_off_file(pf.ptr, &lang)
        rt.buf_free(&pf)
        rt.buf_free(&wer)
        if da {
            return
        }
    } else {
        rt.buf_free(&wer)
    }
    var sc: [u8; 17] = "/etc/locale.conf\0"
    if lang_off_conf((&sc[0]) as u64, &lang) {
        return
    }
    var en: [u8; 3] = "en\0"
    rt.buf_push_bytes(&lang, (&en[0]) as u64, 2)
}

fn catalog_file(code: u64, cl: usize, aus: *mut rt.Buf) {
    var a: [u8; 19] = "/usr/share/locale/\0"
    var b: [u8; 10] = "/messages\0"
    rt.buf_push_bytes(aus, (&a[0]) as u64, 18)
    rt.buf_push_bytes(aus, code, cl)
    rt.buf_push_bytes(aus, (&b[0]) as u64, 9)
    rt.buf_push(aus, 0 as u8)
}

fn load() {
    if geladen {
        return
    }
    geladen = true
    sprache_waehlen()
    rt.buf_clear(&catalog)
    var en: [u8; 3] = "en\0"
    var pf: rt.Buf = rt.buf_new()
    catalog_file((&en[0]) as u64, 2, &pf)
    let _e: bool = rt.read_file(pf.ptr, &catalog)
    rt.buf_free(&pf)
    if lang.len > 0 && !(lang.len == 2 && rt.mem_eq(lang.ptr,
        (&en[0]) as u64, 2)) {
        var pf2: rt.Buf = rt.buf_new()
        catalog_file(lang.ptr, lang.len, &pf2)
        var zweit: rt.Buf = rt.buf_new()
        if rt.read_file(pf2.ptr, &zweit) {
            rt.buf_push(&catalog, 10 as u8)
            rt.buf_push_bytes(&catalog, zweit.ptr, zweit.len)
        }
        rt.buf_free(&zweit)
        rt.buf_free(&pf2)
    }
}

fn sprache() -> u64 {
    load()
    rt.buf_push(&lang, 0 as u8)
    rt.buf_set_len(&lang, lang.len - 1)
    return lang.ptr
}

fn entfalten(p: u64, n: usize, aus: *mut rt.Buf) {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 92 as u8 && i + 1 < n {
            let d: u8 = rt.ld8(p, i + 1)
            if d == 110 as u8 {
                rt.buf_push(aus, 10 as u8)
                i = i + 2
            } else if d == 116 as u8 {
                rt.buf_push(aus, 9 as u8)
                i = i + 2
            } else if d == 92 as u8 {
                rt.buf_push(aus, 92 as u8)
                i = i + 2
            } else {
                rt.buf_push(aus, c)
                i = i + 1
            }
        } else {
            rt.buf_push(aus, c)
            i = i + 1
        }
    }
}

fn get(key: u64) -> u64 {
    load()
    let kl: usize = rt.c_length(key)
    rt.buf_clear(&output)
    var i: usize = 0
    var treffer: usize = 0
    var trefferende: usize = 0
    var da: bool = false
    while i < catalog.len {
        var e: usize = 0
        let a: usize = line_from(&catalog, i, &e)
        var t: usize = a
        while t < e && (rt.ld8(catalog.ptr, t) == 32 as u8
            || rt.ld8(catalog.ptr, t) == 9 as u8) {
            t = t + 1
        }
        if t + kl < e && rt.ld8(catalog.ptr, t) != 35 as u8 {
            if rt.mem_eq(catalog.ptr + t as u64, key, kl) {
                var q: usize = t + kl
                while q < e && (rt.ld8(catalog.ptr, q) == 32 as u8
                    || rt.ld8(catalog.ptr, q) == 9 as u8) {
                    q = q + 1
                }
                if q < e && rt.ld8(catalog.ptr, q) == 61 as u8 {
                    q = q + 1
                    while q < e && rt.ld8(catalog.ptr, q) == 32 as u8 {
                        q = q + 1
                    }
                    var f: usize = e
                    while f > q && rt.ld8(catalog.ptr, f - 1) == 13 as u8 {
                        f = f - 1
                    }
                    treffer = q
                    trefferende = f
                    da = true
                }
            }
        }
        i = e + 1
    }
    if !da {
        rt.buf_push_bytes(&output, key, kl)
    } else {
        entfalten(catalog.ptr + treffer as u64, trefferende - treffer,
            &output)
    }
    rt.buf_push(&output, 0 as u8)
    rt.buf_set_len(&output, output.len - 1)
    return output.ptr
}
