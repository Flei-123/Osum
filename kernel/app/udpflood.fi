import std.rt
import libc.dns
import libc.dnswire
import libc.net

const FLOOD_PACKETS: u64 = 600
const FLOOD_PORT: u64 = 9
const FLOOD_BYTES: u64 = 512
const RESOLVE_ROUNDS: u64 = 4
const E_AGAIN: u64 = 11

static mut PAYLOAD: [u8; 512] = [0 as u8; 512]
static mut NAME: [u8; 12] = "example.com\0"

fn say_line(label: str, v: u64) {
    var out: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&out, label.p as u64, label.n)
    rt.buf_push_dec_u64(&out, v)
    rt.buf_push(&out, 10 as u8)
    rt.write_everything(1, out.ptr, out.len)
}

fn flood(target: u64) -> u64 {
    let fd: u64 = net.socket(net.AF_INET, net.SOCK_DGRAM | net.SOCK_NONBLOCK, 0)
    if net.failed(fd) {
        return 0
    }
    var refused: u64 = 0
    var i: u64 = 0
    while i < FLOOD_PACKETS {
        let r: u64 = net.sendto_ip(fd, (&PAYLOAD[0 as usize]) as u64, FLOOD_BYTES, target, FLOOD_PORT)
        if net.failed(r) && (0 -% r) == E_AGAIN {
            refused = refused + 1
        }
        i = i + 1
    }
    net.close(fd)
    return refused
}

fn main(start: u64) -> i32 {
    dns.conf_load()
    if dns.conf_count() == 0 {
        say_line("udpflood: no nameserver ", 0)
        return 1
    }
    var buf: [u8; 16] = [0 as u8; 16]
    var round: u64 = 0
    var failed: u64 = 0
    var refused_total: u64 = 0
    while round < RESOLVE_ROUNDS {
        refused_total = refused_total + flood(dns.conf_at(0))
        let c: u64 = dns.resolve((&NAME[0 as usize]) as u64, dnswire.T_A, (&buf[0 as usize]) as u64)
        if c != dnswire.R_OK {
            failed = failed + 1
            say_line("udpflood: resolve code ", c)
        }
        round = round + 1
    }
    say_line("udpflood: refused ", refused_total)
    say_line("udpflood: resolve failed ", failed)
    return 0
}
