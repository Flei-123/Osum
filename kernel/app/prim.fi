// kernel/app/prim.fi -- RUNDE SCHLEUSE: die native Haelfte der Messung.
//
// DERSELBE ALGORITHMUS wie in `prim.c`, das nach WASM uebersetzt wird:
// Primzahlen unter einer Grenze zaehlen, mit Probedivision. Absichtlich
// eine reine Rechenschleife ohne Systemaufrufe -- gemessen werden soll
// der DEUTER, nicht das Dateisystem.
//
// Warum Probedivision und kein Sieb: das Sieb ist speichergebunden, und
// dann misst man den Speicher des Gastes statt seine Befehle. Die
// Probedivision ist rechengebunden und besteht aus genau den Befehlen,
// die ein Deuter teuer macht: Vergleich, Rest, Sprung.
import std.io
import std.rt

fn ist_prim(n: u64) -> bool {
    if n < 2 { return false }
    if n % 2 == 0 { return n == 2 }
    var d: u64 = 3
    while d * d <= n {
        if n % d == 0 {
            return false
        }
        d = d + 2
    }
    return true
}

fn main(start: u64) -> i32 {
    var grenze: u64 = 200000
    let argc: usize = rt.arg_count(start)
    if argc > 1 {
        let a: u64 = rt.arg_ptr(start, 1)
        let n: usize = rt.c_length(a)
        var v: u64 = 0
        var i: usize = 0
        while i < n {
            let c: u8 = rt.ld8(a, i)
            if c >= 48 as u8 && c <= 57 as u8 {
                v = v * 10 + (c - 48 as u8) as u64
            }
            i = i + 1
        }
        if v > 0 { grenze = v }
    }
    var zahl: u64 = 0
    var k: u64 = 2
    while k < grenze {
        if ist_prim(k) {
            zahl = zahl + 1
        }
        k = k + 1
    }
    var b: rt.Buf = rt.buf_new()
    io.print("primzahlen unter ")
    rt.buf_clear(&b)
    rt.buf_push_dec_u64(&b, grenze)
    rt.write_everything(1, b.ptr, b.len)
    io.print(": ")
    rt.buf_clear(&b)
    rt.buf_push_dec_u64(&b, zahl)
    rt.write_everything(1, b.ptr, b.len)
    io.print("\n")
    rt.buf_free(&b)
    return 0
}
