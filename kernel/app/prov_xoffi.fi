import std.rt
import std.io
import std.str
import knetz
import kjson
import provider
import kgegen

export { push }

static mut p_login: [u8; 17] = "/api/auth/login\0\0"
static mut p_mfa: [u8; 23] = "/api/auth/mfa/verify\0\0\0"
static mut p_refresh: [u8; 19] = "/api/auth/refresh\0\0"
static mut p_logout: [u8; 18] = "/api/auth/logout\0\0"
static mut p_health: [u8; 18] = "/api/auth/health\0\0"

static mut m_post: [u8; 5] = "POST\0"
static mut m_get: [u8; 4] = "GET\0"

static mut f_login: [u8; 6] = "login\0"
static mut f_password: [u8; 9] = "password\0"
static mut f_org: [u8; 13] = "organisation\0"
static mut f_success: [u8; 8] = "success\0"
static mut f_data: [u8; 5] = "data\0"
static mut f_user: [u8; 5] = "user\0"
static mut f_token: [u8; 6] = "token\0"
static mut f_refresh: [u8; 14] = "refresh_token\0"
static mut f_temp: [u8; 11] = "temp_token\0"
static mut f_mfareq: [u8; 13] = "mfa_required\0"
static mut f_id: [u8; 3] = "id\0"
static mut f_email: [u8; 6] = "email\0"
static mut f_username: [u8; 9] = "username\0"
static mut f_name: [u8; 5] = "name\0"
static mut f_orgs: [u8; 14] = "organisations\0"
static mut f_code: [u8; 5] = "code\0"
static mut f_master: [u8; 15] = "master_session\0"
static mut f_admin: [u8; 9] = "is_admin\0"
static mut f_nexus: [u8; 18] = "nexus_core_access\0"
static mut f_exp: [u8; 4] = "exp\0"
static mut f_error: [u8; 6] = "error\0"
static mut f_detail: [u8; 7] = "detail\0"

static mut h_mandant: [u8; 22] = "konto.hint.tenant_mix\0"
static mut h_master: [u8; 20] = "konto.hint.assumed\0\0"
static mut h_form: [u8; 20] = "konto.hint.badjson\0\0"
static mut h_status: [u8; 21] = "konto.hint.badstatus\0"
static mut h_mehr: [u8; 22] = "konto.hint.many_orgs\0\0"

static mut nm: [u8; 6] = "xoffi\0"

fn push() -> provider.Push {
    return provider.Push { name: (&nm[0]) as u64, sign_in: sign_in,
        erneuern: erneuern, sign_out: sign_out,
        validate: check, hand_over: hand_over }
}


fn target_from(z: *mut provider.Access, zl: *mut knetz.Target) -> bool {
    return knetz.target_read((*z).endpoint, rt.c_length((*z).endpoint),
        (*z).zielname, (*z).wurzeln, zl)
}

fn hinweis(s: *mut provider.Session, k: u64) {
    rt.buf_clear(&(*s).hinweis)
    rt.buf_push_bytes(&(*s).hinweis, k, rt.c_length(k))
}

fn claim_read(tok: u64, tl: usize, aus: *mut rt.Buf) -> bool {
    var p1: usize = 0
    while p1 < tl && rt.ld8(tok, p1) != 46 as u8 {
        p1 = p1 + 1
    }
    if p1 >= tl {
        return false
    }
    var p2: usize = p1 + 1
    while p2 < tl && rt.ld8(tok, p2) != 46 as u8 {
        p2 = p2 + 1
    }
    return kjson.b64u_dekodieren(tok + (p1 + 1) as u64, p2 - p1 - 1, aus)
}

fn claims_check(tok: u64, tl: usize, ablauf: *mut u64) -> u32 {
    *ablauf = 0
    var roh: rt.Buf = rt.buf_new()
    if !claim_read(tok, tl, &roh) {
        rt.buf_free(&roh)
        return provider.S_OK
    }
    var d: kjson.Json = kjson.json_new()
    var broken: bool = false
    if !kjson.json_parse(&d, roh.ptr, roh.len) {
        broken = true
    }
    if broken || !kjson.json_valid(&d) {
        kjson.json_free(&d)
        rt.buf_free(&roh)
        return provider.S_OK
    }
    let w: u32 = kjson.json_root(&d)
    var da: bool = false
    let ex: i64 = kjson.int(&d, w, (&f_exp[0]) as u64, &da)
    if da && ex > 0 {
        *ablauf = ex as u64
    }
    var uebernommen: bool = false
    if kjson.hat(&d, w, (&f_master[0]) as u64) {
        if !kjson.json_is_null(&d, kjson.json_get_c(&d, w,
            (&f_master[0]) as u64)) {
            uebernommen = true
        }
    }
    let foreign_admin: bool = kjson.is_true(&d, w, (&f_admin[0]) as u64)
    let foreign_nexus: bool = kjson.is_true(&d, w, (&f_nexus[0]) as u64)
    if kgegen.an(kgegen.G_RECHTE) {
        if foreign_admin || foreign_nexus {
            var rp: [u8; 20] = "/etc/konto.rechte\0\0\0"
            var eins: [u8; 6] = "root\n\0"
            let _w: bool = rt.write_file((&rp[0]) as u64,
                (&eins[0]) as u64, 5)
        }
    }
    kjson.json_free(&d)
    rt.buf_free(&roh)
    if uebernommen && !kgegen.an(kgegen.G_CLAIM) {
        return provider.S_ABGELEHNT
    }
    return provider.S_OK
}

fn fail_bool(b: *mut bool) -> bool {
    *b = true
    return false
}


fn koerper_login(z: *mut provider.Access, aus: *mut rt.Buf) {
    var s: kjson.Writer = kjson.writer_new(aus)
    kjson.field(&s, (&f_login[0]) as u64, (*z).kennung,
        rt.c_length((*z).kennung))
    kjson.field(&s, (&f_password[0]) as u64, (*z).secret,
        rt.c_length((*z).secret))
    if (*z).bereich != 0 && rt.c_length((*z).bereich) > 0 {
        kjson.field(&s, (&f_org[0]) as u64, (*z).bereich,
            rt.c_length((*z).bereich))
    }
    kjson.field_free(&s)
}

fn koerper_mfa(z: *mut provider.Access, aus: *mut rt.Buf) {
    var s: kjson.Writer = kjson.writer_new(aus)
    kjson.field(&s, (&f_temp[0]) as u64, (*z).temp, rt.c_length((*z).temp))
    kjson.field(&s, (&f_code[0]) as u64, (*z).code, rt.c_length((*z).code))
    kjson.field_free(&s)
}

fn cookie_if_broken(z: *mut provider.Access, aus: *mut rt.Buf) -> u64 {
    if !kgegen.an(kgegen.G_COOKIE) {
        return 0
    }
    var k: [u8; 24] = "xoffi_jwt=vondersitzung\0"
    rt.buf_push_bytes(aus, (&k[0]) as u64, 23)
    return aus as u64
}

fn sign_in(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    provider.clear_session(s)
    var zl: knetz.Target = knetz.target_new()
    if !target_from(z, &zl) {
        (*s).stand = provider.S_ERROR
        hinweis(s, (&h_status[0]) as u64)
        return (*s).stand
    }
    var koerper: rt.Buf = rt.buf_new()
    var req_path: u64 = (&p_login[0]) as u64
    var pl: usize = 15
    if (*z).temp != 0 && rt.c_length((*z).temp) > 0 {
        koerper_mfa(z, &koerper)
        req_path = (&p_mfa[0]) as u64
        pl = 20
    } else {
        koerper_login(z, &koerper)
    }
    var keksbuf: rt.Buf = rt.buf_new()
    let cookie: u64 = cookie_if_broken(z, &keksbuf)
    var kekslen: usize = 0
    if cookie != 0 {
        kekslen = keksbuf.len
    }
    var a: knetz.Reply = knetz.reply_new()
    let da: bool = knetz.sende(&zl, (&m_post[0]) as u64, 4, req_path, pl,
        koerper.ptr, koerper.len, 0, 0, keksbuf.ptr, kekslen, &a)
    rt.mem_set(koerper.ptr, 0 as u8, koerper.len)
    rt.buf_free(&koerper)
    rt.buf_free(&keksbuf)
    if !da {
        (*s).stand = net_state(&a)
        knetz.reply_free(&a)
        return (*s).stand
    }
    let r: u32 = reply_read(z, s, &a)
    knetz.reply_free(&a)
    return r
}

fn net_state(a: *mut knetz.Reply) -> u32 {
    if (*a).fail_code == knetz.F_TLS {
        return provider.S_TLS
    }
    if (*a).fail_code == knetz.F_KEINNETZ || (*a).fail_code == knetz.F_READ
        || (*a).fail_code == knetz.F_DNS {
        return provider.S_KEINNETZ
    }
    return provider.S_ERROR
}

fn reply_read(z: *mut provider.Access, s: *mut provider.Session,
    a: *mut knetz.Reply) -> u32 {
    if (*a).code == 429 as u32 {
        (*s).stand = provider.S_GEBREMST
        return (*s).stand
    }
    var d: kjson.Json = kjson.json_new()
    var broken: bool = false
    if !kjson.json_parse(&d, (*a).koerper.ptr, (*a).koerper.len) {
        broken = true
    }
    if broken || !kjson.json_valid(&d) {
        kjson.json_free(&d)
        (*s).stand = provider.S_ERROR
        hinweis(s, (&h_form[0]) as u64)
        if (*a).code == 401 as u32 || (*a).code == 403 as u32 {
            (*s).stand = provider.S_WRONG
        }
        return (*s).stand
    }
    let w: u32 = kjson.json_root(&d)

    if kjson.hat(&d, w, (&f_orgs[0]) as u64) {
        let arr: u32 = kjson.json_get_c(&d, w, (&f_orgs[0]) as u64)
        if kjson.json_kind(&d, arr) == kjson.JSON_ARRAY
            && kjson.json_count(&d, arr) > 1 {
            var kind: u32 = kjson.json_child(&d, arr)
            while kind != kjson.JSON_NONE {
                if kjson.json_kind(&d, kind) == kjson.JSON_STRING {
                    let sp: str.Span = kjson.json_string(&d, kind)
                    rt.buf_push_bytes(&(*s).choice, sp.p as u64, sp.n)
                    rt.buf_push(&(*s).choice, 10 as u8)
                }
                kind = kjson.json_next(&d, kind)
            }
            kjson.json_free(&d)
            (*s).stand = provider.S_MEHRDEUTIG
            hinweis(s, (&h_mehr[0]) as u64)
            return (*s).stand
        }
    }

    if kjson.is_true(&d, w, (&f_mfareq[0]) as u64) {
        if kjson.text(&d, w, (&f_temp[0]) as u64, &(*s).temp) {
            kjson.json_free(&d)
            (*s).stand = provider.S_ZWEITFAKTOR
            return (*s).stand
        }
        let dd: u32 = kjson.json_get_c(&d, w, (&f_data[0]) as u64)
        if kjson.text(&d, dd, (&f_temp[0]) as u64, &(*s).temp) {
            kjson.json_free(&d)
            (*s).stand = provider.S_ZWEITFAKTOR
            return (*s).stand
        }
    }

    if (*a).code != 200 as u32 {
        var msg: rt.Buf = rt.buf_new()
        if !kjson.text(&d, w, (&f_error[0]) as u64, &msg) {
            let _x: bool = kjson.text(&d, w, (&f_detail[0]) as u64, &msg)
        }
        rt.buf_free(&msg)
        kjson.json_free(&d)
        if (*a).code == 401 as u32 || (*a).code == 403 as u32 {
            (*s).stand = provider.S_WRONG
        } else if (*a).code == 410 as u32 || (*a).code == 419 as u32 {
            (*s).stand = provider.S_ABGELAUFEN
        } else {
            (*s).stand = provider.S_ERROR
            hinweis(s, (&h_status[0]) as u64)
        }
        return (*s).stand
    }

    let dat: u32 = kjson.json_get_c(&d, w, (&f_data[0]) as u64)
    if !kjson.text(&d, dat, (&f_token[0]) as u64, &(*s).zugriff) {
        kjson.json_free(&d)
        (*s).stand = provider.S_ERROR
        hinweis(s, (&h_form[0]) as u64)
        return (*s).stand
    }
    let _r: bool = kjson.text(&d, dat, (&f_refresh[0]) as u64,
        &(*s).erneuerung)

    let orgk: u32 = kjson.json_get_c(&d, dat, (&f_org[0]) as u64)
    if orgk != kjson.JSON_NONE {
        if kjson.json_kind(&d, orgk) == kjson.JSON_STRING {
            let sp: str.Span = kjson.json_string(&d, orgk)
            rt.buf_push_bytes(&(*s).bereich, sp.p as u64, sp.n)
        } else {
            if !kjson.text(&d, orgk, (&f_name[0]) as u64, &(*s).bereich) {
                let _i: bool = kjson.text(&d, orgk, (&f_id[0]) as u64,
                    &(*s).bereich)
            }
        }
    }

    if !kgegen.an(kgegen.G_MANDANT) {
        if (*z).bereich != 0 && rt.c_length((*z).bereich) > 0
            && (*s).bereich.len > 0 {
            let bl: usize = rt.c_length((*z).bereich)
            var equal: bool = bl == (*s).bereich.len
            if equal {
                equal = rt.mem_eq((*z).bereich, (*s).bereich.ptr, bl)
            }
            if !equal {
                kjson.json_free(&d)
                (*s).stand = provider.S_ABGELEHNT
                hinweis(s, (&h_mandant[0]) as u64)
                return (*s).stand
            }
        }
    } else {
        rt.buf_clear(&(*s).bereich)
    }

    let usr: u32 = kjson.json_get_c(&d, dat, (&f_user[0]) as u64)
    if !kjson.text(&d, usr, (&f_id[0]) as u64, &(*s).subjekt) {
        let _e: bool = kjson.text(&d, usr, (&f_email[0]) as u64,
            &(*s).subjekt)
    }
    if !kjson.text(&d, usr, (&f_username[0]) as u64, &(*s).anzeige) {
        if !kjson.text(&d, usr, (&f_email[0]) as u64, &(*s).anzeige) {
            rt.buf_push_bytes(&(*s).anzeige, (*s).subjekt.ptr,
                (*s).subjekt.len)
        }
    }
    rt.buf_push_bytes(&(*s).datenort, (*z).endpoint, rt.c_length((*z).endpoint))
    kjson.json_free(&d)

    var ablauf: u64 = 0
    let cl: u32 = claims_check((*s).zugriff.ptr, (*s).zugriff.len,
        &ablauf)
    if cl != provider.S_OK {
        provider.clear_session(s)
        (*s).stand = cl
        hinweis(s, (&h_master[0]) as u64)
        return (*s).stand
    }
    (*s).ablauf = ablauf
    (*s).stand = provider.S_OK
    return (*s).stand
}

fn erneuern(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    var zl: knetz.Target = knetz.target_new()
    if !target_from(z, &zl) {
        (*s).stand = provider.S_ERROR
        return (*s).stand
    }
    var koerper: rt.Buf = rt.buf_new()
    var w: kjson.Writer = kjson.writer_new(&koerper)
    kjson.field(&w, (&f_refresh[0]) as u64, (*z).erneuerung,
        rt.c_length((*z).erneuerung))
    kjson.field_free(&w)
    var a: knetz.Reply = knetz.reply_new()
    let da: bool = knetz.sende(&zl, (&m_post[0]) as u64, 4,
        (&p_refresh[0]) as u64, 17, koerper.ptr, koerper.len, 0, 0, 0, 0,
        &a)
    rt.mem_set(koerper.ptr, 0 as u8, koerper.len)
    rt.buf_free(&koerper)
    if !da {
        (*s).stand = net_state(&a)
        knetz.reply_free(&a)
        return (*s).stand
    }
    if a.code != 200 as u32 {
        knetz.reply_free(&a)
        (*s).stand = provider.S_ABGELAUFEN
        return (*s).stand
    }
    var d: kjson.Json = kjson.json_new()
    var broken: bool = false
    if !kjson.json_parse(&d, a.koerper.ptr, a.koerper.len) {
        broken = true
    }
    if broken || !kjson.json_valid(&d) {
        kjson.json_free(&d)
        knetz.reply_free(&a)
        (*s).stand = provider.S_ERROR
        return (*s).stand
    }
    let wz: u32 = kjson.json_root(&d)
    let dat: u32 = kjson.json_get_c(&d, wz, (&f_data[0]) as u64)
    var fresh: rt.Buf = rt.buf_new()
    if !kjson.text(&d, dat, (&f_token[0]) as u64, &fresh) {
        rt.buf_free(&fresh)
        kjson.json_free(&d)
        knetz.reply_free(&a)
        (*s).stand = provider.S_ABGELAUFEN
        return (*s).stand
    }
    var neuref: rt.Buf = rt.buf_new()
    let hatref: bool = kjson.text(&d, dat, (&f_refresh[0]) as u64, &neuref)
    kjson.json_free(&d)
    knetz.reply_free(&a)

    var ablauf: u64 = 0
    let cl: u32 = claims_check(fresh.ptr, fresh.len, &ablauf)
    if cl != provider.S_OK {
        rt.buf_free(&fresh)
        rt.buf_free(&neuref)
        (*s).stand = cl
        return (*s).stand
    }
    rt.buf_clear(&(*s).zugriff)
    rt.buf_push_bytes(&(*s).zugriff, fresh.ptr, fresh.len)
    if hatref {
        rt.buf_clear(&(*s).erneuerung)
        rt.buf_push_bytes(&(*s).erneuerung, neuref.ptr, neuref.len)
    }
    (*s).ablauf = ablauf
    rt.buf_free(&fresh)
    rt.buf_free(&neuref)
    (*s).stand = provider.S_OK
    return (*s).stand
}


fn sign_out(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    if kgegen.an(kgegen.G_NURLOKAL) {
        (*s).stand = provider.S_OK
        return (*s).stand
    }
    var zl: knetz.Target = knetz.target_new()
    if !target_from(z, &zl) {
        (*s).stand = provider.S_ERROR
        return (*s).stand
    }
    var a: knetz.Reply = knetz.reply_new()
    let da: bool = knetz.sende(&zl, (&m_post[0]) as u64, 4,
        (&p_logout[0]) as u64, 16, 0, 0, (*z).zugriff,
        rt.c_length((*z).zugriff), 0, 0, &a)
    var stand: u32 = provider.S_OK
    if !da {
        stand = net_state(&a)
    } else if a.code != 200 as u32 {
        stand = provider.S_ERROR
    }
    knetz.reply_free(&a)
    (*s).stand = stand
    return stand
}

fn hand_over(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    return provider.S_ERROR
}

fn check(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    var zl: knetz.Target = knetz.target_new()
    if !target_from(z, &zl) {
        (*s).stand = provider.S_ERROR
        return (*s).stand
    }
    var a: knetz.Reply = knetz.reply_new()
    let da: bool = knetz.sende(&zl, (&m_get[0]) as u64, 3,
        (&p_health[0]) as u64, 16, 0, 0, (*z).zugriff,
        rt.c_length((*z).zugriff), 0, 0, &a)
    var stand: u32 = provider.S_OK
    if !da {
        stand = net_state(&a)
    } else if a.code == 401 as u32 || a.code == 403 as u32 {
        stand = provider.S_ABGELAUFEN
    } else if a.code != 200 as u32 {
        stand = provider.S_ERROR
    }
    knetz.reply_free(&a)
    (*s).stand = stand
    return stand
}
