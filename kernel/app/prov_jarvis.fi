import std.rt
import std.io
import std.str
import knetz
import kjson
import provider

export { push }

static mut p_login: [u8; 12] = "/api/login\0\0"
static mut p_logout: [u8; 13] = "/api/logout\0\0"
static mut p_me: [u8; 9] = "/api/me\0\0"

static mut m_post: [u8; 5] = "POST\0"
static mut m_get: [u8; 4] = "GET\0"

static mut f_username: [u8; 9] = "username\0"
static mut f_password: [u8; 9] = "password\0"
static mut f_token: [u8; 6] = "token\0"
static mut f_exp: [u8; 4] = "exp\0"
static mut f_uid: [u8; 4] = "uid\0"
static mut f_name: [u8; 5] = "name\0"

static mut k_cookie: [u8; 17] = "fleitec_session=\0"

static mut h_kein_erneuern: [u8; 26] = "konto.hint.no_refresh\0\0\0\0\0"
static mut h_form: [u8; 20] = "konto.hint.badjson\0\0"
static mut h_status: [u8; 21] = "konto.hint.badstatus\0"

static mut nm: [u8; 7] = "jarvis\0"

fn push() -> provider.Push {
    return provider.Push { name: (&nm[0]) as u64, sign_in: do_sign_in,
        erneuern: erneuern, sign_out: do_sign_out,
        validate: check, hand_over: hand_over }
}

fn fail_bool(b: *mut bool) -> bool {
    *b = true
    return false
}

fn target_from(z: *mut provider.Access, zl: *mut knetz.Target) -> bool {
    return knetz.target_read((*z).endpoint, rt.c_length((*z).endpoint),
        (*z).zielname, (*z).wurzeln, zl)
}

fn hinweis(s: *mut provider.Session, k: u64) {
    rt.buf_clear(&(*s).hinweis)
    rt.buf_push_bytes(&(*s).hinweis, k, rt.c_length(k))
}

fn net_state(a: *mut knetz.Reply) -> u32 {
    if (*a).fail_code == knetz.F_TLS {
        return provider.S_TLS
    }
    if (*a).fail_code == knetz.F_KEINNETZ || (*a).fail_code == knetz.F_READ
        || (*a).fail_code == knetz.F_DNS {
        return provider.S_KEINNETZ
    }
    return provider.S_ERROR
}

fn body_read(tok: u64, tl: usize, s: *mut provider.Session) {
    var p1: usize = 0
    while p1 < tl && rt.ld8(tok, p1) != 46 as u8 {
        p1 = p1 + 1
    }
    if p1 >= tl {
        return
    }
    var p2: usize = p1 + 1
    while p2 < tl && rt.ld8(tok, p2) != 46 as u8 {
        p2 = p2 + 1
    }
    var roh: rt.Buf = rt.buf_new()
    if !kjson.b64u_dekodieren(tok + (p1 + 1) as u64, p2 - p1 - 1, &roh) {
        rt.buf_free(&roh)
        return
    }
    var d: kjson.Json = kjson.json_new()
    var broken: bool = false
    if !kjson.json_parse(&d, roh.ptr, roh.len) {
        broken = true
    }
    if !broken && kjson.json_valid(&d) {
        let w: u32 = kjson.json_root(&d)
        var da: bool = false
        let ex: i64 = kjson.int(&d, w, (&f_exp[0]) as u64, &da)
        if da && ex > 0 {
            (*s).ablauf = ex as u64
        }
        if (*s).subjekt.len == 0 {
            var db: bool = false
            let uid: i64 = kjson.int(&d, w, (&f_uid[0]) as u64, &db)
            if db {
                rt.buf_push_dec_u64(&(*s).subjekt, uid as u64)
            } else {
                let _u: bool = kjson.text(&d, w, (&f_uid[0]) as u64,
                    &(*s).subjekt)
            }
        }
        if (*s).anzeige.len == 0 {
            let _n: bool = kjson.text(&d, w, (&f_name[0]) as u64,
                &(*s).anzeige)
        }
    }
    kjson.json_free(&d)
    rt.buf_free(&roh)
}

fn do_sign_in(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    provider.clear_session(s)
    var zl: knetz.Target = knetz.target_new()
    if !target_from(z, &zl) {
        (*s).stand = provider.S_ERROR
        hinweis(s, (&h_status[0]) as u64)
        return (*s).stand
    }
    var koerper: rt.Buf = rt.buf_new()
    var w: kjson.Writer = kjson.writer_new(&koerper)
    kjson.field(&w, (&f_username[0]) as u64, (*z).kennung,
        rt.c_length((*z).kennung))
    kjson.field(&w, (&f_password[0]) as u64, (*z).secret,
        rt.c_length((*z).secret))
    kjson.field_free(&w)
    var a: knetz.Reply = knetz.reply_new()
    let da: bool = knetz.sende(&zl, (&m_post[0]) as u64, 4,
        (&p_login[0]) as u64, 10, koerper.ptr, koerper.len, 0, 0, 0, 0, &a)
    rt.mem_set(koerper.ptr, 0 as u8, koerper.len)
    rt.buf_free(&koerper)
    if !da {
        (*s).stand = net_state(&a)
        knetz.reply_free(&a)
        return (*s).stand
    }
    if a.code == 429 as u32 {
        knetz.reply_free(&a)
        (*s).stand = provider.S_GEBREMST
        return (*s).stand
    }
    if a.code == 401 as u32 {
        knetz.reply_free(&a)
        (*s).stand = provider.S_WRONG
        return (*s).stand
    }
    if a.code != 200 as u32 {
        knetz.reply_free(&a)
        (*s).stand = provider.S_ERROR
        hinweis(s, (&h_status[0]) as u64)
        return (*s).stand
    }
    var d: kjson.Json = kjson.json_new()
    var broken: bool = false
    if !kjson.json_parse(&d, a.koerper.ptr, a.koerper.len) {
        broken = true
    }
    if broken || !kjson.json_valid(&d) {
        kjson.json_free(&d)
        knetz.reply_free(&a)
        (*s).stand = provider.S_ERROR
        hinweis(s, (&h_form[0]) as u64)
        return (*s).stand
    }
    let wz: u32 = kjson.json_root(&d)
    if !kjson.text(&d, wz, (&f_token[0]) as u64, &(*s).zugriff) {
        kjson.json_free(&d)
        knetz.reply_free(&a)
        (*s).stand = provider.S_ERROR
        hinweis(s, (&h_form[0]) as u64)
        return (*s).stand
    }
    let _u: bool = kjson.text(&d, wz, (&f_username[0]) as u64,
        &(*s).anzeige)
    kjson.json_free(&d)
    knetz.reply_free(&a)
    body_read((*s).zugriff.ptr, (*s).zugriff.len, s)
    if (*s).subjekt.len == 0 {
        rt.buf_push_bytes(&(*s).subjekt, (*s).anzeige.ptr,
            (*s).anzeige.len)
    }
    rt.buf_push_bytes(&(*s).datenort, (*z).endpoint, rt.c_length((*z).endpoint))
    (*s).stand = provider.S_OK
    return (*s).stand
}

fn erneuern(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    hinweis(s, (&h_kein_erneuern[0]) as u64)
    (*s).stand = provider.S_ABGELAUFEN
    return (*s).stand
}

fn build_cookie(z: *mut provider.Access, aus: *mut rt.Buf) {
    rt.buf_push_bytes(aus, (&k_cookie[0]) as u64, 16)
    rt.buf_push_bytes(aus, (*z).zugriff, rt.c_length((*z).zugriff))
}

fn do_sign_out(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    var zl: knetz.Target = knetz.target_new()
    if !target_from(z, &zl) {
        (*s).stand = provider.S_ERROR
        return (*s).stand
    }
    var cookie: rt.Buf = rt.buf_new()
    build_cookie(z, &cookie)
    var a: knetz.Reply = knetz.reply_new()
    let da: bool = knetz.sende(&zl, (&m_post[0]) as u64, 4,
        (&p_logout[0]) as u64, 11, 0, 0, (*z).zugriff,
        rt.c_length((*z).zugriff), cookie.ptr, cookie.len, &a)
    var stand: u32 = provider.S_OK
    if !da {
        stand = net_state(&a)
    } else if a.code != 200 as u32 {
        stand = provider.S_ERROR
    }
    knetz.reply_free(&a)
    rt.buf_free(&cookie)
    (*s).stand = stand
    return stand
}

fn hand_over(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    return provider.S_ERROR
}

fn check(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    var zl: knetz.Target = knetz.target_new()
    if !target_from(z, &zl) {
        (*s).stand = provider.S_ERROR
        return (*s).stand
    }
    var cookie: rt.Buf = rt.buf_new()
    build_cookie(z, &cookie)
    var a: knetz.Reply = knetz.reply_new()
    let da: bool = knetz.sende(&zl, (&m_get[0]) as u64, 3,
        (&p_me[0]) as u64, 7, 0, 0, (*z).zugriff,
        rt.c_length((*z).zugriff), cookie.ptr, cookie.len, &a)
    var stand: u32 = provider.S_OK
    if !da {
        stand = net_state(&a)
    } else if a.code == 401 as u32 {
        stand = provider.S_ABGELAUFEN
    } else if a.code != 200 as u32 {
        stand = provider.S_ERROR
    }
    knetz.reply_free(&a)
    rt.buf_free(&cookie)
    (*s).stand = stand
    return stand
}
