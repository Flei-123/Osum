fn ld8(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn st8(p: u64, i: usize, v: u8) {
    *((p + i as u64) as *mut u8) = v
}

export {
    Big, Mont, BIG_MAX,
    big_new, big_zero, big_set_u32, big_copy, big_is_zero, big_cmp,
    big_from_be, big_to_be, big_bitlen, big_bit, big_limbs, big_set_len,
    big_add, big_sub, big_shl1, big_mod, big_add_mod, big_sub_mod,
    select_into,
    big_odd, big_equal_u32,
    mont_new, mont_init, mont_mul, mont_to, mont_from, mont_pow,
    mont_one, mont_modulus, mont_len,
}

const BIG_MAX: usize = 12
const M32: u64 = 4294967295

struct Big {
    n: usize,
    d: [u32; 12],
}

struct Mont {
    m: Big,
    rr: Big,
    one: Big,
    n0: u64,
    nl: usize,
    ok: bool,
}


fn big_new() -> Big {
    return Big { n: 0, d: [0; 12] }
}

fn big_zero(a: *mut Big) {
    var i: usize = 0
    while i < BIG_MAX {
        (*a).d[i] = 0 as u32
        i = i + 1
    }
    (*a).n = 0
}

fn big_limbs(a: *mut Big) -> usize {
    return (*a).n
}

fn big_set_len(a: *mut Big, n: usize) -> bool {
    if n > BIG_MAX {
        return false
    }
    var i: usize = (*a).n
    while i < n {
        (*a).d[i] = 0 as u32
        i = i + 1
    }
    (*a).n = n
    return true
}

fn big_set_u32(a: *mut Big, v: u32) {
    big_zero(a)
    (*a).d[0] = v
    (*a).n = 1
}

fn big_copy(dst: *mut Big, src: *mut Big) {
    var i: usize = 0
    while i < BIG_MAX {
        (*dst).d[i] = (*src).d[i]
        i = i + 1
    }
    (*dst).n = (*src).n
}

fn big_is_zero(a: *mut Big) -> bool {
    var i: usize = 0
    while i < (*a).n {
        if (*a).d[i] != 0 as u32 {
            return false
        }
        i = i + 1
    }
    return true
}

fn big_odd(a: *mut Big) -> bool {
    if (*a).n == 0 {
        return false
    }
    return ((*a).d[0] & 1 as u32) == 1 as u32
}

fn big_equal_u32(a: *mut Big, v: u32) -> bool {
    if (*a).n == 0 {
        return v == 0 as u32
    }
    if (*a).d[0] != v {
        return false
    }
    var i: usize = 1
    while i < (*a).n {
        if (*a).d[i] != 0 as u32 {
            return false
        }
        i = i + 1
    }
    return true
}

fn big_cmp(a: *mut Big, b: *mut Big) -> i32 {
    var n: usize = (*a).n
    if (*b).n > n {
        n = (*b).n
    }
    var i: usize = n
    while i > 0 {
        i = i - 1
        var av: u32 = 0 as u32
        var bv: u32 = 0 as u32
        if i < (*a).n {
            av = (*a).d[i]
        }
        if i < (*b).n {
            bv = (*b).d[i]
        }
        if av != bv {
            if av > bv {
                return 1
            }
            return 0 - 1
        }
    }
    return 0
}

fn big_from_be(a: *mut Big, p: u64, n: usize) -> bool {
    if n > BIG_MAX * 4 {
        return false
    }
    big_zero(a)
    let nl: usize = (n + 3) / 4
    var i: usize = 0
    while i < n {
        let oct: u64 = ld8(p, n - 1 - i) as u64
        let limb: usize = i / 4
        let sh: u64 = ((i % 4) as u64) * 8
        (*a).d[limb] = (((*a).d[limb] as u64) | (oct << sh)) as u32
        i = i + 1
    }
    (*a).n = nl
    return true
}

fn big_to_be(a: *mut Big, out: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let idx: usize = n - 1 - i
        let limb: usize = i / 4
        var v: u64 = 0
        if limb < (*a).n {
            v = (*a).d[limb] as u64
        }
        let sh: u64 = ((i % 4) as u64) * 8
        st8(out, idx, ((v >> sh) & 255 as u64) as u8)
        i = i + 1
    }
    var j: usize = n
    while j < (*a).n * 4 {
        let limb: usize = j / 4
        let sh: u64 = ((j % 4) as u64) * 8
        if (((*a).d[limb] as u64 >> sh) & 255 as u64) != 0 as u64 {
            return false
        }
        j = j + 1
    }
    return true
}

fn big_bitlen(a: *mut Big) -> usize {
    var i: usize = (*a).n
    while i > 0 {
        i = i - 1
        if (*a).d[i] != 0 as u32 {
            var v: u64 = (*a).d[i] as u64
            var b: usize = 0
            while v != 0 as u64 {
                v = v >> 1
                b = b + 1
            }
            return i * 32 + b
        }
    }
    return 0
}

fn big_bit(a: *mut Big, i: usize) -> u32 {
    let limb: usize = i / 32
    if limb >= (*a).n {
        return 0 as u32
    }
    return (((*a).d[limb] as u64 >> ((i % 32) as u64)) & 1 as u64) as u32
}


fn big_add(r: *mut Big, a: *mut Big, b: *mut Big, nl: usize) -> u64 {
    var carry: u64 = 0
    var i: usize = 0
    while i < nl {
        var av: u64 = 0
        var bv: u64 = 0
        if i < (*a).n {
            av = (*a).d[i] as u64
        }
        if i < (*b).n {
            bv = (*b).d[i] as u64
        }
        let t: u64 = av + bv + carry
        (*r).d[i] = (t & M32) as u32
        carry = t >> 32
        i = i + 1
    }
    (*r).n = nl
    return carry
}

fn big_sub(r: *mut Big, a: *mut Big, b: *mut Big, nl: usize) -> u64 {
    var borrow: u64 = 0
    var i: usize = 0
    while i < nl {
        var av: u64 = 0
        var bv: u64 = 0
        if i < (*a).n {
            av = (*a).d[i] as u64
        }
        if i < (*b).n {
            bv = (*b).d[i] as u64
        }
        let t: u64 = av + 4294967296 as u64 - bv - borrow
        (*r).d[i] = (t & M32) as u32
        if t < 4294967296 as u64 {
            borrow = 1
        } else {
            borrow = 0
        }
        i = i + 1
    }
    (*r).n = nl
    return borrow
}

fn big_shl1(a: *mut Big, nl: usize) -> u64 {
    var carry: u64 = 0
    var i: usize = 0
    while i < nl {
        var v: u64 = 0
        if i < (*a).n {
            v = (*a).d[i] as u64
        }
        let t: u64 = (v << 1) | carry
        (*a).d[i] = (t & M32) as u32
        carry = t >> 32
        i = i + 1
    }
    (*a).n = nl
    return carry
}

fn big_mod(r: *mut Big, a: *mut Big, m: *mut Big) -> bool {
    let nl: usize = (*m).n
    if nl == 0 {
        return false
    }
    big_zero(r)
    let ok: bool = big_set_len(r, nl)
    var tmp: Big = big_new()
    let ok2: bool = big_set_len(&tmp, nl)
    var i: usize = big_bitlen(a)
    while i > 0 {
        i = i - 1
        let out: u64 = big_shl1(r, nl)
        (*r).d[0] = (((*r).d[0] as u64) | (big_bit(a, i) as u64)) as u32
        if out != 0 as u64 || big_cmp(r, m) >= 0 {
            let b: u64 = big_sub(&tmp, r, m, nl)
            big_copy(r, &tmp)
        }
    }
    return true
}

fn select_into(r: *mut Big, t: *mut Big, s: *mut Big, mask: u64,
    nl: usize) {
    var i: usize = 0
    while i < nl {
        let tv: u64 = (*t).d[i] as u64
        let sv: u64 = (*s).d[i] as u64
        (*r).d[i] = ((tv ^ (mask & (tv ^ sv)))) as u32
        i = i + 1
    }
    (*r).n = nl
}

fn big_add_mod(r: *mut Big, a: *mut Big, b: *mut Big, m: *mut Big) {
    let nl: usize = (*m).n
    var t: Big = big_new()
    let carry: u64 = big_add(&t, a, b, nl)
    var s: Big = big_new()
    let borrow: u64 = big_sub(&s, &t, m, nl)
    let need: u64 = carry | (1 as u64 -% borrow)
    let mask: u64 = (0 as u64) -% (need & 1 as u64)
    select_into(r, &t, &s, mask, nl)
}

fn big_sub_mod(r: *mut Big, a: *mut Big, b: *mut Big, m: *mut Big) {
    let nl: usize = (*m).n
    var t: Big = big_new()
    let borrow: u64 = big_sub(&t, a, b, nl)
    var s: Big = big_new()
    let c: u64 = big_add(&s, &t, m, nl)
    let mask: u64 = (0 as u64) -% borrow
    select_into(r, &t, &s, mask, nl)
}


fn mont_new() -> Mont {
    return Mont { m: big_new(), rr: big_new(), one: big_new(),
        n0: 0, nl: 0, ok: false }
}

fn mont_modulus(mc: *mut Mont) -> *mut Big {
    return &(*mc).m
}

fn mont_len(mc: *mut Mont) -> usize {
    return (*mc).nl
}

fn mont_one(mc: *mut Mont) -> *mut Big {
    return &(*mc).one
}

fn inv32(m0: u64) -> u64 {
    var x: u64 = 1
    var i: usize = 0
    while i < 6 {
        let t: u64 = (m0 * x) & M32
        let two_minus: u64 = (2 as u64 + 4294967296 as u64 - t) & M32
        x = (x * two_minus) & M32
        i = i + 1
    }
    return (4294967296 as u64 - x) & M32
}

fn mont_init(mc: *mut Mont, m: *mut Big) -> bool {
    if (*m).n == 0 || !big_odd(m) {
        (*mc).ok = false
        return false
    }
    if (*m).n + 2 > BIG_MAX {
        (*mc).ok = false
        return false
    }
    big_copy(&(*mc).m, m)
    (*mc).nl = (*m).n
    (*mc).n0 = inv32((*m).d[0] as u64)
    var x: Big = big_new()
    big_set_u32(&x, 1 as u32)
    let ok: bool = big_set_len(&x, (*mc).nl)
    var tmp: Big = big_new()
    let ok2: bool = big_set_len(&tmp, (*mc).nl)
    var i: usize = 0
    let bits: usize = 32 * (*mc).nl
    while i < bits {
        let out: u64 = big_shl1(&x, (*mc).nl)
        if out != 0 as u64 || big_cmp(&x, m) >= 0 {
            let b: u64 = big_sub(&tmp, &x, m, (*mc).nl)
            big_copy(&x, &tmp)
        }
        i = i + 1
    }
    big_copy(&(*mc).one, &x)
    while i < bits * 2 {
        let out: u64 = big_shl1(&x, (*mc).nl)
        if out != 0 as u64 || big_cmp(&x, m) >= 0 {
            let b: u64 = big_sub(&tmp, &x, m, (*mc).nl)
            big_copy(&x, &tmp)
        }
        i = i + 1
    }
    big_copy(&(*mc).rr, &x)
    (*mc).ok = true
    return true
}

fn mont_mul(mc: *mut Mont, r: *mut Big, a: *mut Big, b: *mut Big) {
    let nl: usize = (*mc).nl
    var t: [u64; 274] = [0; 274]
    var i: usize = 0
    while i < nl + 2 {
        t[i] = 0
        i = i + 1
    }
    i = 0
    while i < nl {
        var ai: u64 = 0
        if i < (*a).n {
            ai = (*a).d[i] as u64
        }
        var carry: u64 = 0
        var j: usize = 0
        while j < nl {
            var bj: u64 = 0
            if j < (*b).n {
                bj = (*b).d[j] as u64
            }
            let s: u64 = t[j] + ai * bj + carry
            t[j] = s & M32
            carry = s >> 32
            j = j + 1
        }
        let s1: u64 = t[nl] + carry
        t[nl] = s1 & M32
        t[nl + 1] = t[nl + 1] + (s1 >> 32)
        let mi: u64 = (t[0] * (*mc).n0) & M32
        let s0: u64 = t[0] + mi * ((*mc).m.d[0] as u64)
        carry = s0 >> 32
        j = 1
        while j < nl {
            let s: u64 = t[j] + mi * ((*mc).m.d[j] as u64) + carry
            t[j - 1] = s & M32
            carry = s >> 32
            j = j + 1
        }
        let s2: u64 = t[nl] + carry
        t[nl - 1] = s2 & M32
        t[nl] = (s2 >> 32) + t[nl + 1]
        t[nl + 1] = 0
        i = i + 1
    }
    var out: Big = big_new()
    i = 0
    while i < nl {
        out.d[i] = t[i] as u32
        i = i + 1
    }
    out.n = nl
    var sub: Big = big_new()
    let borrow: u64 = big_sub(&sub, &out, &(*mc).m, nl)
    var top: u64 = 0
    if t[nl] != 0 as u64 {
        top = 1
    }
    let need: u64 = top | (1 as u64 -% borrow)
    let mask: u64 = (0 as u64) -% (need & 1 as u64)
    select_into(r, &out, &sub, mask, nl)
}

fn mont_to(mc: *mut Mont, r: *mut Big, a: *mut Big) {
    mont_mul(mc, r, a, &(*mc).rr)
}

fn mont_from(mc: *mut Mont, r: *mut Big, a: *mut Big) {
    var one: Big = big_new()
    big_set_u32(&one, 1 as u32)
    mont_mul(mc, r, a, &one)
}

fn mont_pow(mc: *mut Mont, r: *mut Big, base: *mut Big, e: *mut Big) {
    var acc: Big = big_new()
    big_copy(&acc, &(*mc).one)
    var tmp: Big = big_new()
    var i: usize = big_bitlen(e)
    while i > 0 {
        i = i - 1
        mont_mul(mc, &tmp, &acc, &acc)
        big_copy(&acc, &tmp)
        if big_bit(e, i) != 0 as u32 {
            mont_mul(mc, &tmp, &acc, base)
            big_copy(&acc, &tmp)
        }
    }
    big_copy(r, &acc)
}
