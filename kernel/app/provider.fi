import std.rt
import std.crypto.sha256

export {
    Access, Session, Push,
    access_new, session_new, session_free, clear_session,
    eintragen, num_items, waehle, name_von, board_set, empty_push,
    do_sign_in, tu_erneuern, do_hand_over, do_sign_out, do_check,
    kennung,
    S_OK, S_WRONG, S_ZWEITFAKTOR, S_MEHRDEUTIG, S_KEINNETZ, S_TLS,
    S_ABGELEHNT, S_ABGELAUFEN, S_ERROR, S_GEBREMST, S_DEVICE,
    MAX_PUSH,
}

const MAX_PUSH: usize = 8

const S_OK: u32 = 0
const S_WRONG: u32 = 1
const S_ZWEITFAKTOR: u32 = 2
const S_MEHRDEUTIG: u32 = 3
const S_KEINNETZ: u32 = 4
const S_ABGELEHNT: u32 = 5
const S_ABGELAUFEN: u32 = 6
const S_ERROR: u32 = 7
const S_GEBREMST: u32 = 8
const S_TLS: u32 = 9
const S_DEVICE: u32 = 10

struct Access {
    endpoint: u64,
    zielname: u64,
    wurzeln: u64,
    kennung: u64,
    secret: u64,
    bereich: u64,
    code: u64,
    temp: u64,
    zugriff: u64,
    erneuerung: u64,
    modus: u64,
    klient: u64,
    zielgruppe: u64,
}

struct Session {
    stand: u32,
    subjekt: rt.Buf,
    anzeige: rt.Buf,
    bereich: rt.Buf,
    datenort: rt.Buf,
    zugriff: rt.Buf,
    erneuerung: rt.Buf,
    temp: rt.Buf,
    choice: rt.Buf,
    hinweis: rt.Buf,
    ablauf: u64,
    dev_code: rt.Buf,
    dev_url: rt.Buf,
    dev_url_full: rt.Buf,
    interval: u64,
    expires_in: u64,
}

struct Push {
    name: u64,
    sign_in: fn(*mut Access, *mut Session) -> u32,
    erneuern: fn(*mut Access, *mut Session) -> u32,
    sign_out: fn(*mut Access, *mut Session) -> u32,
    validate: fn(*mut Access, *mut Session) -> u32,
    hand_over: fn(*mut Access, *mut Session) -> u32,
}

fn access_new() -> Access {
    return Access { endpoint: 0, zielname: 0, wurzeln: 0, kennung: 0,
        secret: 0, bereich: 0, code: 0, temp: 0, zugriff: 0,
        erneuerung: 0, modus: 0, klient: 0, zielgruppe: 0 }
}

fn session_new() -> Session {
    return Session { stand: S_ERROR, subjekt: rt.buf_new(),
        anzeige: rt.buf_new(), bereich: rt.buf_new(),
        datenort: rt.buf_new(), zugriff: rt.buf_new(),
        erneuerung: rt.buf_new(), temp: rt.buf_new(),
        choice: rt.buf_new(), hinweis: rt.buf_new(), ablauf: 0,
        dev_code: rt.buf_new(), dev_url: rt.buf_new(), dev_url_full: rt.buf_new(),
        interval: 0, expires_in: 0 }
}

fn clear_session(s: *mut Session) {
    (*s).stand = S_ERROR
    (*s).ablauf = 0
    rt.buf_clear(&(*s).subjekt)
    rt.buf_clear(&(*s).anzeige)
    rt.buf_clear(&(*s).bereich)
    rt.buf_clear(&(*s).datenort)
    rt.buf_clear(&(*s).zugriff)
    rt.buf_clear(&(*s).erneuerung)
    rt.buf_clear(&(*s).temp)
    rt.buf_clear(&(*s).choice)
    rt.buf_clear(&(*s).hinweis)
    rt.buf_clear(&(*s).dev_code)
    rt.buf_clear(&(*s).dev_url)
    rt.buf_clear(&(*s).dev_url_full)
    (*s).interval = 0
    (*s).expires_in = 0
}

fn session_free(s: *mut Session) {
    rt.buf_free(&(*s).subjekt)
    rt.buf_free(&(*s).anzeige)
    rt.buf_free(&(*s).bereich)
    rt.buf_free(&(*s).datenort)
    rt.buf_free(&(*s).zugriff)
    rt.buf_free(&(*s).erneuerung)
    rt.buf_free(&(*s).temp)
    rt.buf_free(&(*s).choice)
    rt.buf_free(&(*s).hinweis)
    rt.buf_free(&(*s).dev_code)
    rt.buf_free(&(*s).dev_url)
    rt.buf_free(&(*s).dev_url_full)
}


fn empty(z: *mut Access, s: *mut Session) -> u32 {
    return S_ERROR
}

fn empty_push() -> Push {
    return Push { name: 0, sign_in: empty, erneuern: empty,
        sign_out: empty, validate: empty, hand_over: empty }
}

static mut table_p: u64 = 0
static mut table_max: usize = 0
static mut n_back: usize = 0

fn schrittweite() -> usize {
    var two: [Push; 2] = [empty_push(); 2]
    return (((&two[1]) as u64) - ((&two[0]) as u64)) as usize
}

fn space(i: usize) -> *mut Push {
    return (table_p + (i * schrittweite()) as u64) as *mut Push
}

fn board_set(p: u64, max: usize) {
    table_p = p
    table_max = max
    n_back = 0
}

fn eintragen(r: Push) -> bool {
    if table_p == 0 || n_back >= table_max || n_back >= MAX_PUSH {
        return false
    }
    *space(n_back) = r
    n_back = n_back + 1
    return true
}

fn num_items() -> usize {
    return n_back
}

fn eq(a: u64, b: u64) -> bool {
    var i: usize = 0
    while true {
        let x: u8 = rt.ld8(a, i)
        let y: u8 = rt.ld8(b, i)
        if x != y {
            return false
        }
        if x == 0 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

fn waehle(name: u64) -> i64 {
    var i: usize = 0
    while i < n_back {
        if eq((*space(i)).name, name) {
            return i as i64
        }
        i = i + 1
    }
    return -1
}

fn name_von(i: usize) -> u64 {
    if i >= n_back {
        return 0
    }
    return (*space(i)).name
}

fn do_sign_in(i: usize, z: *mut Access, s: *mut Session) -> u32 {
    if i >= n_back {
        return S_ERROR
    }
    let f: fn(*mut Access, *mut Session) -> u32 = (*space(i)).sign_in
    return f(z, s)
}

fn do_hand_over(i: usize, z: *mut Access, s: *mut Session) -> u32 {
    if i >= n_back {
        return S_ERROR
    }
    let f: fn(*mut Access, *mut Session) -> u32 = (*space(i)).hand_over
    return f(z, s)
}

fn tu_erneuern(i: usize, z: *mut Access, s: *mut Session) -> u32 {
    if i >= n_back {
        return S_ERROR
    }
    let f: fn(*mut Access, *mut Session) -> u32 = (*space(i)).erneuern
    return f(z, s)
}

fn do_sign_out(i: usize, z: *mut Access, s: *mut Session) -> u32 {
    if i >= n_back {
        return S_ERROR
    }
    let f: fn(*mut Access, *mut Session) -> u32 = (*space(i)).sign_out
    return f(z, s)
}

fn do_check(i: usize, z: *mut Access, s: *mut Session) -> u32 {
    if i >= n_back {
        return S_ERROR
    }
    let f: fn(*mut Access, *mut Session) -> u32 = (*space(i)).validate
    return f(z, s)
}

fn kennung(provider: u64, bereich: u64, subjekt: u64, sl: usize,
    aus: *mut rt.Buf) {
    var m: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&m, provider, rt.c_length(provider))
    rt.buf_push(&m, 0 as u8)
    if bereich != 0 {
        rt.buf_push_bytes(&m, bereich, rt.c_length(bereich))
    }
    rt.buf_push(&m, 0 as u8)
    rt.buf_push_bytes(&m, subjekt, sl)
    var dg: [u8; 32] = [0; 32]
    sha256.sha256(m.ptr, m.len, (&dg[0]) as u64)
    var i: usize = 0
    while i < 8 {
        rt.buf_push_hex_u64(aus, dg[i] as u64, 2)
        i = i + 1
    }
    rt.buf_free(&m)
}
