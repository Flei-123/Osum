import std.rt

export { write_waiting, write_confirm, write_ok, write_none }

static mut path_state: [u8; 18] = "/var/jarvis/state\0"

fn put_line(b: *mut rt.Buf) {
    rt.buf_push(b, 10 as u8)
    rt.write_file((&path_state[0]) as u64, (*b).ptr, (*b).len)
    rt.buf_free(b)
}

fn push_text(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn write_waiting(code: u64, code_n: usize, seconds_left: u64) {
    var b: rt.Buf = rt.buf_new()
    push_text(&b, "pairing: waiting ")
    rt.buf_push_bytes(&b, code, code_n)
    rt.buf_push(&b, 32 as u8)
    rt.buf_push_dec_u64(&b, seconds_left)
    put_line(&b)
}

fn write_confirm(code: u64, code_n: usize) {
    var b: rt.Buf = rt.buf_new()
    push_text(&b, "pairing: confirm ")
    rt.buf_push_bytes(&b, code, code_n)
    put_line(&b)
}

fn write_ok() {
    var b: rt.Buf = rt.buf_new()
    push_text(&b, "pairing: ok")
    put_line(&b)
}

fn write_none() {
    var b: rt.Buf = rt.buf_new()
    push_text(&b, "pairing: none")
    put_line(&b)
}
