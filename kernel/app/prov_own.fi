import std.rt
import std.io
import std.str
import std.crypto.hmac
import std.crypto.sha256
import std.crypto.random
import knetz
import kjson
import provider
import ksiegel

export { push }

const RUNDEN: u64 = 8192

static mut p_an: [u8; 17] = "/konto/anmelden\0\0"
static mut p_er: [u8; 17] = "/konto/erneuern\0\0"
static mut p_ab: [u8; 17] = "/konto/abmelden\0\0"
static mut p_pr: [u8; 16] = "/konto/pruefen\0\0"

static mut m_post: [u8; 5] = "POST\0"
static mut m_get: [u8; 4] = "GET\0"

static mut f_kennung: [u8; 8] = "kennung\0"
static mut f_secret: [u8; 7] = "geheim\0"
static mut f_code: [u8; 5] = "code\0"
static mut f_bereich_old: [u8; 8] = "bereich\0"
static mut f_scope: [u8; 6] = "scope\0"
static mut f_subjekt_old: [u8; 8] = "subjekt\0"
static mut f_subjekt: [u8; 8] = "subject\0"
static mut f_anzeige_old: [u8; 8] = "anzeige\0"
static mut f_anzeige: [u8; 13] = "display_name\0"
static mut f_zugriff_old: [u8; 8] = "zugriff\0"
static mut f_zugriff: [u8; 7] = "access\0"
static mut f_erneuerung_old: [u8; 11] = "erneuerung\0"
static mut f_erneuerung: [u8; 8] = "renewal\0"
static mut f_ablauf_old: [u8; 7] = "ablauf\0"
static mut f_ablauf: [u8; 11] = "expires_at\0"
static mut f_datenort_old: [u8; 9] = "datenort\0"
static mut f_datenort: [u8; 10] = "data_home\0"
static mut f_zweit_old: [u8; 12] = "zweitfaktor\0"
static mut f_zweit: [u8; 14] = "second_factor\0"
static mut f_between_old: [u8; 9] = "zwischen\0"
static mut f_between: [u8; 8] = "interim\0"
static mut f_bereiche_old: [u8; 9] = "bereiche\0"
static mut f_bereiche: [u8; 7] = "scopes\0"

static mut h_form: [u8; 20] = "konto.hint.badjson\0\0"
static mut h_folder: [u8; 22] = "konto.hint.no_folder\0\0"
static mut h_status: [u8; 21] = "konto.hint.badstatus\0"

static mut nm: [u8; 6] = "eigen\0"

fn push() -> provider.Push {
    return provider.Push { name: (&nm[0]) as u64, sign_in: do_sign_in,
        erneuern: erneuern, sign_out: do_sign_out,
        validate: check, hand_over: hand_over }
}

fn fail_bool(b: *mut bool) -> bool {
    *b = true
    return false
}

fn hinweis(s: *mut provider.Session, k: u64) {
    rt.buf_clear(&(*s).hinweis)
    rt.buf_push_bytes(&(*s).hinweis, k, rt.c_length(k))
}

fn is_folder(endpoint: u64) -> bool {
    var p: [u8; 9] = "datei://\0"
    var i: usize = 0
    while i < 8 {
        if rt.ld8(endpoint, i) != rt.ld8((&p[0]) as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn now() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 0, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] as u64
}

fn pbkdf2(pw: u64, pwl: usize, salz: u64, sl: usize, runden: u64,
    aus: u64) {
    var msg: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&msg, salz, sl)
    rt.buf_push(&msg, 0 as u8)
    rt.buf_push(&msg, 0 as u8)
    rt.buf_push(&msg, 0 as u8)
    rt.buf_push(&msg, 1 as u8)
    var u: [u8; 32] = [0; 32]
    var t: [u8; 32] = [0; 32]
    hmac.hmac_sha256(pw, pwl, msg.ptr, msg.len, (&u[0]) as u64)
    var i: usize = 0
    while i < 32 {
        t[i] = u[i]
        i = i + 1
    }
    var r: u64 = 1
    while r < runden {
        hmac.hmac_sha256(pw, pwl, (&u[0]) as u64, 32, (&u[0]) as u64)
        var k: usize = 0
        while k < 32 {
            t[k] = t[k] ^ u[k]
            k = k + 1
        }
        r = r + 1
    }
    rt.mem_copy(aus, (&t[0]) as u64, 32)
    rt.buf_free(&msg)
}

fn hex_an(aus: *mut rt.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        rt.buf_push_hex_u64(aus, rt.ld8(p, i) as u64, 2)
        i = i + 1
    }
}

fn hex_value(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 { return (c - 48 as u8) as i32 }
    if c >= 97 as u8 && c <= 102 as u8 { return (c - 87 as u8) as i32 }
    if c >= 65 as u8 && c <= 70 as u8 { return (c - 55 as u8) as i32 }
    return -1
}

fn hex_read(p: u64, n: usize, aus: u64, max: usize) -> usize {
    var i: usize = 0
    var k: usize = 0
    while i + 1 < n && k < max {
        let a: i32 = hex_value(rt.ld8(p, i))
        let b: i32 = hex_value(rt.ld8(p, i + 1))
        if a < 0 || b < 0 {
            return k
        }
        rt.st8(aus, k, ((a * 16 + b) as u32) as u8)
        k = k + 1
        i = i + 2
    }
    return k
}


fn path_build(endpoint: u64, part: u64, tl: usize, name: u64, nl: usize,
    aus: *mut rt.Buf) {
    let zl: usize = rt.c_length(endpoint)
    rt.buf_push_bytes(aus, endpoint + 8, zl - 8)
    rt.buf_push_bytes(aus, part, tl)
    if nl > 0 {
        rt.buf_push_bytes(aus, name, nl)
    }
    rt.buf_push(aus, 0 as u8)
}

fn line_value(b: *mut rt.Buf, name: u64, nn: usize,
    aus: *mut rt.Buf) -> bool {
    var i: usize = 0
    while i < (*b).len {
        var e: usize = i
        while e < (*b).len && rt.ld8((*b).ptr, e) != 10 as u8 {
            e = e + 1
        }
        if e - i > nn && rt.ld8((*b).ptr, i + nn) == 9 as u8 {
            if rt.mem_eq((*b).ptr + i as u64, name, nn) {
                rt.buf_push_bytes(aus, (*b).ptr + (i + nn + 1) as u64,
                    e - i - nn - 1)
                return true
            }
        }
        i = e + 1
    }
    return false
}

fn to_num(p: u64, n: usize) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 {
            return v
        }
        v = v * 10 + (c - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn folder_sign_in(z: *mut provider.Access,
    s: *mut provider.Session) -> u32 {
    var t_k: [u8; 9] = "/konten/\0"
    var pf: rt.Buf = rt.buf_new()
    path_build((*z).endpoint, (&t_k[0]) as u64, 8, (*z).kennung,
        rt.c_length((*z).kennung), &pf)
    var b: rt.Buf = rt.buf_new()
    if !rt.read_file(pf.ptr, &b) {
        rt.buf_free(&pf)
        rt.buf_free(&b)
        (*s).stand = provider.S_WRONG
        return (*s).stand
    }
    var n_salz: [u8; 5] = "salz\0"
    var n_run: [u8; 7] = "runden\0"
    var n_pr: [u8; 9] = "nachweis\0"
    var n_sub: [u8; 8] = "subjekt\0"
    var n_anz: [u8; 8] = "anzeige\0"
    var salzhex: rt.Buf = rt.buf_new()
    var runhex: rt.Buf = rt.buf_new()
    var pruefhex: rt.Buf = rt.buf_new()
    let hat_s: bool = line_value(&b, (&n_salz[0]) as u64, 4, &salzhex)
    let hat_p: bool = line_value(&b, (&n_pr[0]) as u64, 8, &pruefhex)
    let _r: bool = line_value(&b, (&n_run[0]) as u64, 6, &runhex)
    var runden: u64 = RUNDEN
    if runhex.len > 0 {
        runden = to_num(runhex.ptr, runhex.len)
        if runden == 0 {
            runden = RUNDEN
        }
    }
    if !hat_s || !hat_p {
        rt.buf_free(&pf)
        rt.buf_free(&b)
        rt.buf_free(&salzhex)
        rt.buf_free(&runhex)
        rt.buf_free(&pruefhex)
        (*s).stand = provider.S_ERROR
        hinweis(s, (&h_form[0]) as u64)
        return (*s).stand
    }
    var salz: [u8; 32] = [0; 32]
    let sl: usize = hex_read(salzhex.ptr, salzhex.len,
        (&salz[0]) as u64, 32)
    var soll: [u8; 32] = [0; 32]
    let _pl: usize = hex_read(pruefhex.ptr, pruefhex.len,
        (&soll[0]) as u64, 32)
    var ist: [u8; 32] = [0; 32]
    pbkdf2((*z).secret, rt.c_length((*z).secret), (&salz[0]) as u64, sl,
        runden, (&ist[0]) as u64)
    let fits: bool = hmac.hmac_equal((&ist[0]) as u64, (&soll[0]) as u64,
        32)
    rt.buf_free(&salzhex)
    rt.buf_free(&runhex)
    rt.buf_free(&pruefhex)
    if !fits {
        rt.buf_free(&pf)
        rt.buf_free(&b)
        (*s).stand = provider.S_WRONG
        return (*s).stand
    }
    if !line_value(&b, (&n_sub[0]) as u64, 7, &(*s).subjekt) {
        rt.buf_push_bytes(&(*s).subjekt, (*z).kennung,
            rt.c_length((*z).kennung))
    }
    if !line_value(&b, (&n_anz[0]) as u64, 7, &(*s).anzeige) {
        rt.buf_push_bytes(&(*s).anzeige, (*s).subjekt.ptr,
            (*s).subjekt.len)
    }
    var roh: [u8; 32] = [0; 32]
    if !random.random_bytes((&roh[0]) as u64, 32) {
        rt.buf_free(&pf)
        rt.buf_free(&b)
        (*s).stand = provider.S_ERROR
        return (*s).stand
    }
    hex_an(&(*s).zugriff, (&roh[0]) as u64, 32)
    let ab: u64 = now() + 604800
    (*s).ablauf = ab
    if !store_session(z, &(*s).zugriff, (*s).subjekt.ptr,
        (*s).subjekt.len, ab) {
        rt.buf_free(&pf)
        rt.buf_free(&b)
        provider.clear_session(s)
        (*s).stand = provider.S_ERROR
        hinweis(s, (&h_folder[0]) as u64)
        return (*s).stand
    }
    rt.buf_push_bytes(&(*s).datenort, (*z).endpoint, rt.c_length((*z).endpoint))
    rt.buf_free(&pf)
    rt.buf_free(&b)
    (*s).stand = provider.S_OK
    return (*s).stand
}

fn store_session(z: *mut provider.Access, tok: *mut rt.Buf,
    subjekt: u64, sl: usize, ablauf: u64) -> bool {
    var t_s: [u8; 12] = "/sitzungen/\0"
    var t_empty: [u8; 11] = "/sitzungen\0"
    var d: rt.Buf = rt.buf_new()
    path_build((*z).endpoint, (&t_empty[0]) as u64, 10, 0, 0, &d)
    let _v: bool = ksiegel.dir(d.ptr)
    rt.buf_free(&d)
    var pf: rt.Buf = rt.buf_new()
    path_build((*z).endpoint, (&t_s[0]) as u64, 11, (*tok).ptr, (*tok).len,
        &pf)
    var inhalt: rt.Buf = rt.buf_new()
    var n_ab: [u8; 7] = "ablauf\0"
    var n_sub: [u8; 8] = "subjekt\0"
    rt.buf_push_bytes(&inhalt, (&n_ab[0]) as u64, 6)
    rt.buf_push(&inhalt, 9 as u8)
    rt.buf_push_dec_u64(&inhalt, ablauf)
    rt.buf_push(&inhalt, 10 as u8)
    rt.buf_push_bytes(&inhalt, (&n_sub[0]) as u64, 7)
    rt.buf_push(&inhalt, 9 as u8)
    rt.buf_push_bytes(&inhalt, subjekt, sl)
    rt.buf_push(&inhalt, 10 as u8)
    let ok: bool = ksiegel.file_write_0600(pf.ptr, inhalt.ptr,
        inhalt.len)
    rt.buf_free(&pf)
    rt.buf_free(&inhalt)
    return ok
}

fn folder_check(z: *mut provider.Access,
    s: *mut provider.Session) -> u32 {
    var t_s: [u8; 12] = "/sitzungen/\0"
    var pf: rt.Buf = rt.buf_new()
    path_build((*z).endpoint, (&t_s[0]) as u64, 11, (*z).zugriff,
        rt.c_length((*z).zugriff), &pf)
    var b: rt.Buf = rt.buf_new()
    if !rt.read_file(pf.ptr, &b) {
        rt.buf_free(&pf)
        rt.buf_free(&b)
        (*s).stand = provider.S_ABGELAUFEN
        return (*s).stand
    }
    var n_ab: [u8; 7] = "ablauf\0"
    var w: rt.Buf = rt.buf_new()
    var stand: u32 = provider.S_OK
    if line_value(&b, (&n_ab[0]) as u64, 6, &w) {
        if to_num(w.ptr, w.len) < now() {
            stand = provider.S_ABGELAUFEN
        }
    }
    rt.buf_free(&w)
    rt.buf_free(&pf)
    rt.buf_free(&b)
    (*s).stand = stand
    return stand
}

fn folder_sign_out(z: *mut provider.Access,
    s: *mut provider.Session) -> u32 {
    var t_s: [u8; 12] = "/sitzungen/\0"
    var pf: rt.Buf = rt.buf_new()
    path_build((*z).endpoint, (&t_s[0]) as u64, 11, (*z).zugriff,
        rt.c_length((*z).zugriff), &pf)
    let _l: bool = ksiegel.secure_delete(pf.ptr)
    rt.buf_free(&pf)
    (*s).stand = provider.S_OK
    return (*s).stand
}


fn target_from(z: *mut provider.Access, zl: *mut knetz.Target) -> bool {
    return knetz.target_read((*z).endpoint, rt.c_length((*z).endpoint),
        (*z).zielname, (*z).wurzeln, zl)
}

fn net_state(a: *mut knetz.Reply) -> u32 {
    if (*a).fail_code == knetz.F_TLS {
        return provider.S_TLS
    }
    if (*a).fail_code == knetz.F_KEINNETZ || (*a).fail_code == knetz.F_READ
        || (*a).fail_code == knetz.F_DNS {
        return provider.S_KEINNETZ
    }
    return provider.S_ERROR
}

fn net_sign_in(z: *mut provider.Access,
    s: *mut provider.Session) -> u32 {
    var zl: knetz.Target = knetz.target_new()
    if !target_from(z, &zl) {
        (*s).stand = provider.S_ERROR
        hinweis(s, (&h_status[0]) as u64)
        return (*s).stand
    }
    var koerper: rt.Buf = rt.buf_new()
    var w: kjson.Writer = kjson.writer_new(&koerper)
    kjson.field(&w, (&f_kennung[0]) as u64, (*z).kennung,
        rt.c_length((*z).kennung))
    kjson.field(&w, (&f_secret[0]) as u64, (*z).secret,
        rt.c_length((*z).secret))
    if (*z).code != 0 && rt.c_length((*z).code) > 0 {
        kjson.field(&w, (&f_code[0]) as u64, (*z).code,
            rt.c_length((*z).code))
    }
    if (*z).bereich != 0 && rt.c_length((*z).bereich) > 0 {
        kjson.field(&w, (&f_bereich_old[0]) as u64, (*z).bereich,
            rt.c_length((*z).bereich))
    }
    kjson.field_free(&w)
    var a: knetz.Reply = knetz.reply_new()
    let da: bool = knetz.sende(&zl, (&m_post[0]) as u64, 4,
        (&p_an[0]) as u64, 15, koerper.ptr, koerper.len, 0, 0, 0, 0, &a)
    rt.mem_set(koerper.ptr, 0 as u8, koerper.len)
    rt.buf_free(&koerper)
    if !da {
        (*s).stand = net_state(&a)
        knetz.reply_free(&a)
        return (*s).stand
    }
    let r: u32 = net_read(z, s, &a)
    knetz.reply_free(&a)
    return r
}

fn text_either(d: *mut kjson.Json, w: u32, fresh: u64, old: u64, out: *mut rt.Buf) -> bool {
    if kjson.text(d, w, fresh, out) {
        return true
    }
    return kjson.text(d, w, old, out)
}

fn true_either(d: *mut kjson.Json, w: u32, fresh: u64, old: u64) -> bool {
    return kjson.is_true(d, w, fresh) || kjson.is_true(d, w, old)
}

fn int_either(d: *mut kjson.Json, w: u32, fresh: u64, old: u64, found: *mut bool) -> i64 {
    let v: i64 = kjson.int(d, w, fresh, found)
    if *found {
        return v
    }
    return kjson.int(d, w, old, found)
}

fn net_read(z: *mut provider.Access, s: *mut provider.Session,
    a: *mut knetz.Reply) -> u32 {
    if (*a).code == 429 as u32 {
        (*s).stand = provider.S_GEBREMST
        return (*s).stand
    }
    var d: kjson.Json = kjson.json_new()
    var broken: bool = false
    if !kjson.json_parse(&d, (*a).koerper.ptr, (*a).koerper.len) {
        broken = true
    }
    if broken || !kjson.json_valid(&d) {
        kjson.json_free(&d)
        if (*a).code == 401 as u32 {
            (*s).stand = provider.S_WRONG
        } else {
            (*s).stand = provider.S_ERROR
            hinweis(s, (&h_form[0]) as u64)
        }
        return (*s).stand
    }
    let w: u32 = kjson.json_root(&d)
    var scopes_key: u64 = (&f_bereiche[0]) as u64
    if !kjson.hat(&d, w, scopes_key) {
        scopes_key = (&f_bereiche_old[0]) as u64
    }
    if kjson.hat(&d, w, scopes_key) {
        let arr: u32 = kjson.json_get_c(&d, w, scopes_key)
        if kjson.json_kind(&d, arr) == kjson.JSON_ARRAY
            && kjson.json_count(&d, arr) > 1 {
            var kind: u32 = kjson.json_child(&d, arr)
            while kind != kjson.JSON_NONE {
                if kjson.json_kind(&d, kind) == kjson.JSON_STRING {
                    let sp: str.Span = kjson.json_string(&d, kind)
                    rt.buf_push_bytes(&(*s).choice, sp.p as u64, sp.n)
                    rt.buf_push(&(*s).choice, 10 as u8)
                }
                kind = kjson.json_next(&d, kind)
            }
            kjson.json_free(&d)
            (*s).stand = provider.S_MEHRDEUTIG
            return (*s).stand
        }
    }
    if true_either(&d, w, (&f_zweit[0]) as u64, (&f_zweit_old[0]) as u64) {
        if text_either(&d, w, (&f_between[0]) as u64, (&f_between_old[0]) as u64, &(*s).temp) {
            kjson.json_free(&d)
            (*s).stand = provider.S_ZWEITFAKTOR
            return (*s).stand
        }
    }
    if (*a).code == 401 as u32 {
        kjson.json_free(&d)
        (*s).stand = provider.S_WRONG
        return (*s).stand
    }
    if (*a).code != 200 as u32 {
        kjson.json_free(&d)
        (*s).stand = provider.S_ERROR
        hinweis(s, (&h_status[0]) as u64)
        return (*s).stand
    }
    if !text_either(&d, w, (&f_zugriff[0]) as u64, (&f_zugriff_old[0]) as u64, &(*s).zugriff) {
        kjson.json_free(&d)
        (*s).stand = provider.S_ERROR
        hinweis(s, (&h_form[0]) as u64)
        return (*s).stand
    }
    let _e: bool = text_either(&d, w, (&f_erneuerung[0]) as u64,
        (&f_erneuerung_old[0]) as u64, &(*s).erneuerung)
    let _s: bool = text_either(&d, w, (&f_subjekt[0]) as u64,
        (&f_subjekt_old[0]) as u64, &(*s).subjekt)
    let _n: bool = text_either(&d, w, (&f_anzeige[0]) as u64,
        (&f_anzeige_old[0]) as u64, &(*s).anzeige)
    let _b: bool = text_either(&d, w, (&f_scope[0]) as u64,
        (&f_bereich_old[0]) as u64, &(*s).bereich)
    if !text_either(&d, w, (&f_datenort[0]) as u64,
        (&f_datenort_old[0]) as u64, &(*s).datenort) {
        rt.buf_push_bytes(&(*s).datenort, (*z).endpoint,
            rt.c_length((*z).endpoint))
    }
    var da: bool = false
    let ab: i64 = int_either(&d, w, (&f_ablauf[0]) as u64, (&f_ablauf_old[0]) as u64, &da)
    if da && ab > 0 {
        (*s).ablauf = ab as u64
    }
    kjson.json_free(&d)
    (*s).stand = provider.S_OK
    return (*s).stand
}


fn do_sign_in(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    provider.clear_session(s)
    if is_folder((*z).endpoint) {
        return folder_sign_in(z, s)
    }
    return net_sign_in(z, s)
}

fn erneuern(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    if is_folder((*z).endpoint) {
        return folder_check(z, s)
    }
    var zl: knetz.Target = knetz.target_new()
    if !target_from(z, &zl) {
        (*s).stand = provider.S_ERROR
        return (*s).stand
    }
    var koerper: rt.Buf = rt.buf_new()
    var w: kjson.Writer = kjson.writer_new(&koerper)
    kjson.field(&w, (&f_erneuerung_old[0]) as u64, (*z).erneuerung,
        rt.c_length((*z).erneuerung))
    kjson.field_free(&w)
    var a: knetz.Reply = knetz.reply_new()
    let da: bool = knetz.sende(&zl, (&m_post[0]) as u64, 4,
        (&p_er[0]) as u64, 15, koerper.ptr, koerper.len, 0, 0, 0, 0, &a)
    rt.mem_set(koerper.ptr, 0 as u8, koerper.len)
    rt.buf_free(&koerper)
    if !da {
        (*s).stand = net_state(&a)
        knetz.reply_free(&a)
        return (*s).stand
    }
    if a.code != 200 as u32 {
        knetz.reply_free(&a)
        (*s).stand = provider.S_ABGELAUFEN
        return (*s).stand
    }
    let r: u32 = net_read(z, s, &a)
    knetz.reply_free(&a)
    return r
}

fn do_sign_out(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    if is_folder((*z).endpoint) {
        return folder_sign_out(z, s)
    }
    var zl: knetz.Target = knetz.target_new()
    if !target_from(z, &zl) {
        (*s).stand = provider.S_ERROR
        return (*s).stand
    }
    var a: knetz.Reply = knetz.reply_new()
    let da: bool = knetz.sende(&zl, (&m_post[0]) as u64, 4,
        (&p_ab[0]) as u64, 15, 0, 0, (*z).zugriff,
        rt.c_length((*z).zugriff), 0, 0, &a)
    var stand: u32 = provider.S_OK
    if !da {
        stand = net_state(&a)
    } else if a.code != 200 as u32 {
        stand = provider.S_ERROR
    }
    knetz.reply_free(&a)
    (*s).stand = stand
    return stand
}

fn hand_over(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    return provider.S_ERROR
}

fn check(z: *mut provider.Access, s: *mut provider.Session) -> u32 {
    if is_folder((*z).endpoint) {
        return folder_check(z, s)
    }
    var zl: knetz.Target = knetz.target_new()
    if !target_from(z, &zl) {
        (*s).stand = provider.S_ERROR
        return (*s).stand
    }
    var a: knetz.Reply = knetz.reply_new()
    let da: bool = knetz.sende(&zl, (&m_get[0]) as u64, 3,
        (&p_pr[0]) as u64, 14, 0, 0, (*z).zugriff,
        rt.c_length((*z).zugriff), 0, 0, &a)
    var stand: u32 = provider.S_OK
    if !da {
        stand = net_state(&a)
    } else if a.code == 401 as u32 {
        stand = provider.S_ABGELAUFEN
    } else if a.code != 200 as u32 {
        stand = provider.S_ERROR
    }
    knetz.reply_free(&a)
    (*s).stand = stand
    return stand
}
