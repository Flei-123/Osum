// SPDX-License-Identifier: GPL-2.0-only

import std.rt

export { kv_get, kv_put, kv_put_num, kv_num, starts_with, line_end }

fn starts_with(p: u64, n: usize, s: str) -> bool {
    if n < s.n {
        return false
    }
    return rt.mem_eq(p, s.p as u64, s.n)
}

fn line_end(p: u64, n: usize, from: usize) -> usize {
    var e: usize = from
    while e < n && rt.ld8(p, e) != 10 as u8 {
        e = e + 1
    }
    return e
}

fn kv_get(src: *mut rt.Buf, key: str, out: *mut rt.Buf) -> bool {
    let n: usize = (*src).len
    var i: usize = 0
    while i < n {
        let e: usize = line_end((*src).ptr, n, i)
        if e - i > key.n && starts_with((*src).ptr + i as u64, e - i, key)
            && rt.ld8((*src).ptr, i + key.n) == 61 as u8 {
            rt.buf_clear(out)
            rt.buf_push_bytes(out, (*src).ptr + (i + key.n + 1) as u64, e - i - key.n - 1)
            return true
        }
        i = e + 1
    }
    return false
}

fn kv_put(dst: *mut rt.Buf, key: str, v: *mut rt.Buf) {
    rt.buf_push_bytes(dst, key.p as u64, key.n)
    rt.buf_push(dst, 61 as u8)
    rt.buf_push_bytes(dst, (*v).ptr, (*v).len)
    rt.buf_push(dst, 10 as u8)
}

fn kv_put_num(dst: *mut rt.Buf, key: str, v: u64) {
    rt.buf_push_bytes(dst, key.p as u64, key.n)
    rt.buf_push(dst, 61 as u8)
    rt.buf_push_dec_u64(dst, v)
    rt.buf_push(dst, 10 as u8)
}

fn kv_num(src: *mut rt.Buf, key: str, dflt: u64) -> u64 {
    var t: rt.Buf = rt.buf_new()
    var v: u64 = dflt
    if kv_get(src, key, &t) && t.len > 0 {
        v = 0
        var i: usize = 0
        while i < t.len {
            let c: u8 = rt.ld8(t.ptr, i)
            if c < 48 as u8 || c > 57 as u8 {
                v = dflt
                break
            }
            v = v * 10 + ((c - 48 as u8) as u64)
            i = i + 1
        }
    }
    rt.buf_free(&t)
    return v
}
