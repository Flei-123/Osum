// SPDX-License-Identifier: GPL-2.0-only

import std.rt
import kvfile

export { Job, job_new, job_free, job_load, job_save, job_path, data_path, next_id,
    last_id, job_exists, STATE_QUEUED, STATE_PRINTING, STATE_DONE, STATE_FAILED,
    STATE_CANCELED, state_is, SPOOL_DIR }

const SPOOL_DIR: str = "/var/spool/print"
const STATE_QUEUED: str = "queued"
const STATE_PRINTING: str = "printing"
const STATE_DONE: str = "done"
const STATE_FAILED: str = "failed"
const STATE_CANCELED: str = "canceled"

struct Job {
    id: u64,
    state: rt.Buf,
    printer: rt.Buf,
    name: rt.Buf,
    args: rt.Buf,
    pid: u64,
    rc: u64,
}

fn job_new() -> Job {
    return Job { id: 0, state: rt.buf_new(), printer: rt.buf_new(), name: rt.buf_new(),
        args: rt.buf_new(), pid: 0, rc: 0 }
}

fn job_free(j: *mut Job) {
    rt.buf_free(&(*j).state)
    rt.buf_free(&(*j).printer)
    rt.buf_free(&(*j).name)
    rt.buf_free(&(*j).args)
}

fn state_is(j: *mut Job, s: str) -> bool {
    return (*j).state.len == s.n && rt.mem_eq((*j).state.ptr, s.p as u64, s.n)
}

fn spool_path(out: *mut rt.Buf, id: u64, suffix: str) {
    rt.buf_clear(out)
    rt.buf_push_bytes(out, SPOOL_DIR.p as u64, SPOOL_DIR.n)
    rt.buf_push(out, 47 as u8)
    rt.buf_push_dec_u64(out, id)
    rt.buf_push_bytes(out, suffix.p as u64, suffix.n)
    rt.buf_push(out, 0 as u8)
}

fn job_path(out: *mut rt.Buf, id: u64) {
    spool_path(out, id, ".job")
}

fn data_path(out: *mut rt.Buf, id: u64) {
    spool_path(out, id, ".dat")
}

fn job_exists(id: u64) -> bool {
    var p: rt.Buf = rt.buf_new()
    var b: rt.Buf = rt.buf_new()
    job_path(&p, id)
    let ok: bool = rt.read_file(p.ptr, &b)
    rt.buf_free(&p)
    rt.buf_free(&b)
    return ok
}

fn job_load(id: u64, j: *mut Job) -> bool {
    var p: rt.Buf = rt.buf_new()
    var b: rt.Buf = rt.buf_new()
    job_path(&p, id)
    let ok: bool = rt.read_file(p.ptr, &b)
    rt.buf_free(&p)
    if !ok {
        rt.buf_free(&b)
        return false
    }
    (*j).id = id
    kvfile.kv_get(&b, "state", &(*j).state)
    kvfile.kv_get(&b, "printer", &(*j).printer)
    kvfile.kv_get(&b, "name", &(*j).name)
    kvfile.kv_get(&b, "args", &(*j).args)
    (*j).pid = kvfile.kv_num(&b, "pid", 0)
    (*j).rc = kvfile.kv_num(&b, "rc", 0)
    rt.buf_free(&b)
    return true
}

fn job_save(j: *mut Job) -> bool {
    var b: rt.Buf = rt.buf_new()
    var p: rt.Buf = rt.buf_new()
    kvfile.kv_put(&b, "state", &(*j).state)
    kvfile.kv_put(&b, "printer", &(*j).printer)
    kvfile.kv_put(&b, "name", &(*j).name)
    kvfile.kv_put(&b, "args", &(*j).args)
    kvfile.kv_put_num(&b, "pid", (*j).pid)
    kvfile.kv_put_num(&b, "rc", (*j).rc)
    job_path(&p, (*j).id)
    let ok: bool = rt.write_file(p.ptr, b.ptr, b.len)
    rt.buf_free(&b)
    rt.buf_free(&p)
    return ok
}

fn counter_path(out: *mut rt.Buf) {
    rt.buf_push_bytes(out, SPOOL_DIR.p as u64, SPOOL_DIR.n)
    rt.buf_push_bytes(out, "/last".p as u64, 5)
    rt.buf_push(out, 0 as u8)
}

fn last_id() -> u64 {
    var p: rt.Buf = rt.buf_new()
    var b: rt.Buf = rt.buf_new()
    counter_path(&p)
    var v: u64 = 0
    if rt.read_file(p.ptr, &b) {
        var i: usize = 0
        while i < b.len {
            let c: u8 = rt.ld8(b.ptr, i)
            if c < 48 as u8 || c > 57 as u8 {
                break
            }
            v = v * 10 + ((c - 48 as u8) as u64)
            i = i + 1
        }
    }
    rt.buf_free(&p)
    rt.buf_free(&b)
    return v
}

fn next_id() -> u64 {
    let id: u64 = last_id() + 1
    var p: rt.Buf = rt.buf_new()
    var b: rt.Buf = rt.buf_new()
    counter_path(&p)
    rt.buf_push_dec_u64(&b, id)
    rt.buf_push(&b, 10 as u8)
    rt.write_file(p.ptr, b.ptr, b.len)
    rt.buf_free(&p)
    rt.buf_free(&b)
    return id
}
