import std.rt
import std.io

export { set, an, G_CLAIM, G_MANDANT, G_KLARTEXT, G_COOKIE, G_NURLOKAL,
    G_RECHTE, G_OLDKEYS }

const G_CLAIM: u32 = 1
const G_MANDANT: u32 = 2
const G_KLARTEXT: u32 = 4
const G_COOKIE: u32 = 8
const G_NURLOKAL: u32 = 16
const G_RECHTE: u32 = 32
const G_OLDKEYS: u32 = 64

static mut flags: u32 = 0

fn eq(a: u64, b: u64) -> bool {
    var i: usize = 0
    while true {
        let x: u8 = rt.ld8(a, i)
        let y: u8 = rt.ld8(b, i)
        if x != y {
            return false
        }
        if x == 0 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

fn set(word: u64) -> bool {
    var w1: [u8; 11] = "claimcheck\0"
    var w2: [u8; 12] = "einemandant\0"
    var w3: [u8; 10] = "klartext\0\0"
    var w4: [u8; 5] = "keks\0"
    var w5: [u8; 9] = "nurlokal\0"
    var w6: [u8; 7] = "rechte\0"
    var w7: [u8; 9] = "oldkeys\0"
    var f: u32 = 0
    if eq(word, (&w1[0]) as u64) { f = G_CLAIM }
    if eq(word, (&w2[0]) as u64) { f = G_MANDANT }
    if eq(word, (&w3[0]) as u64) { f = G_KLARTEXT }
    if eq(word, (&w4[0]) as u64) { f = G_COOKIE }
    if eq(word, (&w5[0]) as u64) { f = G_NURLOKAL }
    if eq(word, (&w6[0]) as u64) { f = G_RECHTE }
    if eq(word, (&w7[0]) as u64) { f = G_OLDKEYS }
    if f == 0 as u32 {
        return false
    }
    flags = flags | f
    io.eprint("account: COUNTERPROOF ")
    io.eprint_bytes(word, rt.c_length(word))
    io.eprint_line(" -- this build is DELIBERATELY broken")
    return true
}

fn an(f: u32) -> bool {
    return (flags & f) != 0 as u32
}
