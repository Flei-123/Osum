// SPDX-License-Identifier: GPL-2.0-only
// kernel/app/kgegen.fi -- RUNDE KONTO: DIE ABSICHTLICH KAPUTTEN FASSUNGEN.
//
// Hausart dieses Baums: eine Eigenschaft ohne Gegenprobe ist eine
// Behauptung. Ein Abschnitt, der prueft "das Token wird gesiegelt", sagt
// nichts, solange nicht jemand gezeigt hat, dass derselbe Abschnitt ROT
// wird, wenn es NICHT gesiegelt wird. Der Kernel macht das mit Woertern
// auf der Befehlszeile (`nowalk`, `nogen`, `noflight`); ein Programm in
// Ring 3 kann dasselbe mit einem Argument.
//
//     konto --kaputt <wort> ...
//
// Jede kaputte Fassung schreibt eine LAUTE Zeile auf die Fehlerausgabe.
// Es gibt keinen stillen Weg hierher, keine Umgebungsvariable und keine
// Voreinstellung -- wer sie benutzt, hat sie hingeschrieben.
//
//     claimcheck    die Weigerung gegen `master_session` faellt weg
//     einemandant   der Mandant faellt aus der Kontokennung heraus
//     klartext      das Token wird UNGESIEGELT auf die Platte gelegt
//     keks          es wird ein Keks angehaengt, wo keiner hingehoert
//     nurlokal      das Abmelden endet auf dem Geraet, ohne den Server
//     rechte        Verwaltungsansprueche aus dem Token werden zu einer
//                   LOKALEN Berechtigung gemacht -- die Fehlerklasse,
//                   vor der der Auftrag ausdruecklich warnt
//
// Keiner dieser Namen ist ein Anbietername; sie beschreiben den Schaden.

import std.rt
import std.io

export { setzen, an, G_CLAIM, G_MANDANT, G_KLARTEXT, G_KEKS, G_NURLOKAL,
    G_RECHTE }

const G_CLAIM: u32 = 1
const G_MANDANT: u32 = 2
const G_KLARTEXT: u32 = 4
const G_KEKS: u32 = 8
const G_NURLOKAL: u32 = 16
const G_RECHTE: u32 = 32

static mut flags: u32 = 0

fn gleich(a: u64, b: u64) -> bool {
    var i: usize = 0
    while true {
        let x: u8 = rt.ld8(a, i)
        let y: u8 = rt.ld8(b, i)
        if x != y {
            return false
        }
        if x == 0 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

fn setzen(wort: u64) -> bool {
    var w1: [u8; 11] = "claimcheck\0"
    var w2: [u8; 12] = "einemandant\0"
    var w3: [u8; 10] = "klartext\0\0"
    var w4: [u8; 5] = "keks\0"
    var w5: [u8; 9] = "nurlokal\0"
    var w6: [u8; 7] = "rechte\0"
    var f: u32 = 0
    if gleich(wort, (&w1[0]) as u64) { f = G_CLAIM }
    if gleich(wort, (&w2[0]) as u64) { f = G_MANDANT }
    if gleich(wort, (&w3[0]) as u64) { f = G_KLARTEXT }
    if gleich(wort, (&w4[0]) as u64) { f = G_KEKS }
    if gleich(wort, (&w5[0]) as u64) { f = G_NURLOKAL }
    if gleich(wort, (&w6[0]) as u64) { f = G_RECHTE }
    if f == 0 as u32 {
        return false
    }
    flags = flags | f
    io.eprint("konto: GEGENPROBE ")
    io.eprint_bytes(wort, rt.c_length(wort))
    io.eprint_line(" -- diese Fassung ist ABSICHTLICH kaputt")
    return true
}

fn an(f: u32) -> bool {
    return (flags & f) != 0 as u32
}
