
import std.rt
import pairstate
import jarvisd.jdbase
import jarvisd.jdcmd
import jarvisd.jdloop
import jarvisd.jdinput

const MAXBEFEHLE: usize = 8

const S_LSEEK: i64 = 8

const S_CHMOD: i64 = 90

const GOOD_SESSION_MS: u64 = 30000

fn main(start: u64) -> i32 {
    var p_conf: [u8; 31] = "/etc/jarvis/permissions.conf\0\0\0"
    jdcmd.hinein((&jdbase.konfpfad[0]) as u64, jdbase.MAXPFAD, (&p_conf[0]) as u64, 28)
    var einmal: bool = false
    var nurlesen: bool = false
    var deadline: u64 = 0
    var probe_target: u64 = 0
    var probe_payload: u64 = 0

    let argc: usize = rt.arg_count(start)
    var i: usize = 1
    while i < argc {
        let a: u64 = rt.arg_ptr(start, i)
        let n: usize = rt.c_length(a)
        if n == 2 && rt.ld8(a, 0) == 45 as u8 {
            let c: u8 = rt.ld8(a, 1)
            if c == 99 as u8 {
                i = i + 1
                if i < argc {
                    let q: u64 = rt.arg_ptr(start, i)
                    jdcmd.hinein((&jdbase.konfpfad[0]) as u64, jdbase.MAXPFAD, q, rt.c_length(q))
                }
            } else if c == 116 as u8 {
                i = i + 1
                if i < argc {
                    let q: u64 = rt.arg_ptr(start, i)
                    deadline = jdcmd.num_from(q, rt.c_length(q))
                }
            } else if c == 49 as u8 {
                einmal = true
            } else if c == 111 as u8 {
                jdbase.k_legacy = true
            } else if c == 118 as u8 {
                jdbase.laut = true
            } else if c == 110 as u8 {
                nurlesen = true
            } else if c == 112 as u8 {
                jdloop.mach_verzeichnisse()
                return jdloop.probe()
            } else if c == 115 as u8 {
                return jdloop.screen()
            } else if c == 100 as u8 {
                return jdloop.diagnose()
            } else if c == 102 as u8 {
                i = i + 1
                if i < argc {
                    return jdloop.photo_file(rt.arg_ptr(start, i))
                }
                jdcmd.say("jarvisd -f needs a file name\n")
                return 2
            } else if c == 98 as u8 {
                return jdcmd.bildprobe()
            } else if c == 105 as u8 {
                if i + 1 >= argc {
                    jdcmd.say("jarvisd -i needs an input command\n")
                    return 2
                }
                probe_target = rt.arg_ptr(start, i + 1)
                i = i + 1
                if i + 1 < argc && rt.ld8(rt.arg_ptr(start, i + 1), 0) != 45 as u8 {
                    probe_payload = rt.arg_ptr(start, i + 1)
                    i = i + 1
                }
            }
        }
        i = i + 1
    }

    if probe_target != 0 {
        return jdinput.probe(probe_target, probe_payload)
    }

    jdloop.mach_verzeichnisse()
    if !jdcmd.conf_read() {
        jdcmd.say("jarvisd: /etc/jarvis/permissions.conf missing -- nothing is allowed\n")
        return 2
    }
    jdcmd.say("jarvisd: permissions read ")
    jdcmd.say_num(jdbase.n_read as u64)
    jdcmd.say(" write ")
    jdcmd.say_num(jdbase.n_write as u64)
    jdcmd.say(" list ")
    jdcmd.say_num(jdbase.n_auflisten as u64)
    jdcmd.say(" commands ")
    if jdbase.k_befehle {
        jdcmd.say_num(jdbase.n_command as u64)
    } else {
        jdcmd.say("no")
    }
    jdcmd.say(" screenshot ")
    if jdbase.k_photo {
        jdcmd.say("yes")
    } else {
        jdcmd.say("no")
    }
    jdcmd.say(" sysinfo ")
    if jdbase.k_system {
        jdcmd.say("yes")
    } else {
        jdcmd.say("no")
    }
    jdcmd.say("\n")
    if nurlesen {
        return 0
    }
    if jdbase.k_https {
        if jdbase.k_namelen == 0 {
            jdcmd.say("jarvisd: `transport = https` needs `servername = ...`\n")
            return 2
        }
    } else if jdbase.k_ip == 0 as u32 {
        jdcmd.say("jarvisd: no server set in /etc/jarvis/permissions.conf (factory list: everything off).\n")
        jdcmd.say("jarvisd: add `transport = https`, `servername = store.fleitec.com`, `path = /bruecke/draht`,\n")
        jdcmd.say("jarvisd: or build the image with HP_STICK=1 / JARVIS_CONF=<file>. See `jarvisctl status`.\n")
        return 2
    }

    if argc == 1 && deadline == 0 && jdcmd.other_service_running() {
        jdcmd.say("jarvisd: already running -- not starting a second one\n")
        return 0
    }

    if jdbase.k_https && argc == 1 && deadline == 0 {
        if !jdcmd.supervise() {
            return 0
        }
    }
    jdbase.k_ok_ms = jdcmd.now_ms()
    var a_start: [u8; 8] = "service\0"
    jdcmd.notiere((&a_start[0]) as u64, 7, "started", 0, 0 as usize)
    pairstate.write_none()
    jdcmd.say("jarvisd: ready\n")

    let t0: u64 = jdcmd.now_ms()
    var wait: u64 = 250
    while true {
        if deadline > 0 && jdcmd.now_ms() - t0 > deadline {
            break
        }
        let sitz0: u64 = jdbase.z_sitzungen
        let erg: u64 = jdloop.eine_runde()
        if jdbase.z_sitzungen > sitz0 && jdcmd.now_ms() - jdbase.k_session_ms >= GOOD_SESSION_MS {
            wait = 250
        }
        if erg == 0 {
            jdcmd.say("jarvisd: the server said goodbye\n")
            if einmal {
                break
            }
            wait = 250
        } else if erg == 1 {
            if einmal {
                break
            }
            wait = 30000
        } else {
            if einmal && jdbase.z_verbindungen > 0 {
                break
            }
        }
        if deadline > 0 && jdcmd.now_ms() - t0 > deadline {
            break
        }
        jdcmd.say_if_loud("jarvisd: waiting\n")
        let a0: i64 = jdcmd.sysinfo(jdbase.I_SYSCALLS)
        jdcmd.schlafe_ms(wait)
        let a1: i64 = jdcmd.sysinfo(jdbase.I_SYSCALLS)
        if a1 > a0 {
            jdbase.z_warteaufrufe = jdbase.z_warteaufrufe + ((a1 - a0) as u64)
        }
        jdbase.z_wartems = jdbase.z_wartems + wait
        wait = wait * 2
        if wait > 30000 {
            wait = 30000
        }
    }
    jdloop.bericht()
    var a_ende: [u8; 8] = "service\0"
    jdcmd.notiere((&a_ende[0]) as u64, 7, "stopped", 0, 0 as usize)
    return 0
}
