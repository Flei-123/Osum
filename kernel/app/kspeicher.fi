import std.rt
import provider
import ksiegel
import kgegen

export {
    Account, account_new,
    list_read, lines, line_get, field_get, account_read,
    account_set, remove_account, account_find,
    session_save, session_load, session_delete, session_path,
    PATH_ACCOUNTS, F_KENNUNG, F_PROVIDER, F_BEREICH, F_SUBJEKT,
    F_ANZEIGE, F_DATENORT, F_LOCAL, FELDER,
}

const FELDER: usize = 7
const F_KENNUNG: usize = 0
const F_PROVIDER: usize = 1
const F_BEREICH: usize = 2
const F_SUBJEKT: usize = 3
const F_ANZEIGE: usize = 4
const F_DATENORT: usize = 5
const F_LOCAL: usize = 6

const PATH_ACCOUNTS: usize = 0

struct Account {
    kennung: rt.Buf,
    provider: rt.Buf,
    bereich: rt.Buf,
    subjekt: rt.Buf,
    anzeige: rt.Buf,
    datenort: rt.Buf,
    local_val: rt.Buf,
}

fn account_new() -> Account {
    return Account { kennung: rt.buf_new(), provider: rt.buf_new(),
        bereich: rt.buf_new(), subjekt: rt.buf_new(),
        anzeige: rt.buf_new(), datenort: rt.buf_new(),
        local_val: rt.buf_new() }
}


fn path_accounts(aus: *mut rt.Buf) {
    var p: [u8; 12] = "/etc/konten\0"
    rt.buf_push_bytes(aus, (&p[0]) as u64, 11)
    rt.buf_push(aus, 0 as u8)
}

fn list_read(aus: *mut rt.Buf) -> bool {
    var p: [u8; 12] = "/etc/konten\0"
    return rt.read_file((&p[0]) as u64, aus)
}

fn lines(b: *mut rt.Buf) -> usize {
    var n: usize = 0
    var i: usize = 0
    var opened: bool = false
    while i < (*b).len {
        if rt.ld8((*b).ptr, i) == 10 as u8 {
            if opened {
                n = n + 1
            }
            opened = false
        } else {
            opened = true
        }
        i = i + 1
    }
    if opened {
        n = n + 1
    }
    return n
}

fn line_get(b: *mut rt.Buf, k: usize, von: *mut usize,
    bis: *mut usize) -> bool {
    var n: usize = 0
    var i: usize = 0
    while i < (*b).len {
        var e: usize = i
        while e < (*b).len && rt.ld8((*b).ptr, e) != 10 as u8 {
            e = e + 1
        }
        if e > i {
            if n == k {
                *von = i
                *bis = e
                return true
            }
            n = n + 1
        }
        i = e + 1
    }
    return false
}

fn field_get(p: u64, von: usize, bis: usize, f: usize,
    aus: *mut rt.Buf) -> bool {
    var k: usize = 0
    var a: usize = von
    var i: usize = von
    while i <= bis {
        if i == bis || rt.ld8(p, i) == 9 as u8 {
            if k == f {
                rt.buf_push_bytes(aus, p + a as u64, i - a)
                return true
            }
            k = k + 1
            a = i + 1
        }
        i = i + 1
    }
    return false
}

fn account_read(b: *mut rt.Buf, k: usize, ko: *mut Account) -> bool {
    var von: usize = 0
    var bis: usize = 0
    if !line_get(b, k, &von, &bis) {
        return false
    }
    rt.buf_clear(&(*ko).kennung)
    rt.buf_clear(&(*ko).provider)
    rt.buf_clear(&(*ko).bereich)
    rt.buf_clear(&(*ko).subjekt)
    rt.buf_clear(&(*ko).anzeige)
    rt.buf_clear(&(*ko).datenort)
    rt.buf_clear(&(*ko).local_val)
    let p: u64 = (*b).ptr
    let _a: bool = field_get(p, von, bis, F_KENNUNG, &(*ko).kennung)
    let _b: bool = field_get(p, von, bis, F_PROVIDER, &(*ko).provider)
    let _c: bool = field_get(p, von, bis, F_BEREICH, &(*ko).bereich)
    let _d: bool = field_get(p, von, bis, F_SUBJEKT, &(*ko).subjekt)
    let _e: bool = field_get(p, von, bis, F_ANZEIGE, &(*ko).anzeige)
    let _f: bool = field_get(p, von, bis, F_DATENORT, &(*ko).datenort)
    let _g: bool = field_get(p, von, bis, F_LOCAL, &(*ko).local_val)
    return true
}

fn buffer_eq(a: *mut rt.Buf, p: u64, n: usize) -> bool {
    if (*a).len != n {
        return false
    }
    return rt.mem_eq((*a).ptr, p, n)
}

fn account_find(b: *mut rt.Buf, kennung: u64, kl: usize) -> i64 {
    var k: usize = 0
    var such: rt.Buf = rt.buf_new()
    while true {
        var von: usize = 0
        var bis: usize = 0
        if !line_get(b, k, &von, &bis) {
            rt.buf_free(&such)
            return -1
        }
        rt.buf_clear(&such)
        if field_get((*b).ptr, von, bis, F_KENNUNG, &such) {
            if buffer_eq(&such, kennung, kl) {
                rt.buf_free(&such)
                return k as i64
            }
        }
        k = k + 1
    }
    rt.buf_free(&such)
    return -1
}

fn line_build(ko: *mut Account, aus: *mut rt.Buf) {
    rt.buf_push_bytes(aus, (*ko).kennung.ptr, (*ko).kennung.len)
    rt.buf_push(aus, 9 as u8)
    rt.buf_push_bytes(aus, (*ko).provider.ptr, (*ko).provider.len)
    rt.buf_push(aus, 9 as u8)
    rt.buf_push_bytes(aus, (*ko).bereich.ptr, (*ko).bereich.len)
    rt.buf_push(aus, 9 as u8)
    rt.buf_push_bytes(aus, (*ko).subjekt.ptr, (*ko).subjekt.len)
    rt.buf_push(aus, 9 as u8)
    rt.buf_push_bytes(aus, (*ko).anzeige.ptr, (*ko).anzeige.len)
    rt.buf_push(aus, 9 as u8)
    rt.buf_push_bytes(aus, (*ko).datenort.ptr, (*ko).datenort.len)
    rt.buf_push(aus, 9 as u8)
    rt.buf_push_bytes(aus, (*ko).local_val.ptr, (*ko).local_val.len)
}

fn account_set(ko: *mut Account) -> bool {
    var alt: rt.Buf = rt.buf_new()
    let _r: bool = list_read(&alt)
    var fresh: rt.Buf = rt.buf_new()
    line_build(ko, &fresh)

    var raus: rt.Buf = rt.buf_new()
    var k: usize = 0
    var gesetzt: bool = false
    while true {
        var von: usize = 0
        var bis: usize = 0
        if !line_get(&alt, k, &von, &bis) {
            break
        }
        var kn: rt.Buf = rt.buf_new()
        let _f: bool = field_get(alt.ptr, von, bis, F_KENNUNG, &kn)
        let selbe: bool = buffer_eq(&kn, (*ko).kennung.ptr,
            (*ko).kennung.len)
        rt.buf_free(&kn)
        if !selbe {
            if !gesetzt && kleiner(fresh.ptr, fresh.len, alt.ptr + von as u64,
                bis - von) {
                rt.buf_push_bytes(&raus, fresh.ptr, fresh.len)
                rt.buf_push(&raus, 10 as u8)
                gesetzt = true
            }
            rt.buf_push_bytes(&raus, alt.ptr + von as u64, bis - von)
            rt.buf_push(&raus, 10 as u8)
        }
        k = k + 1
    }
    if !gesetzt {
        rt.buf_push_bytes(&raus, fresh.ptr, fresh.len)
        rt.buf_push(&raus, 10 as u8)
    }
    var p: [u8; 12] = "/etc/konten\0"
    let ok: bool = rt.write_file((&p[0]) as u64, raus.ptr, raus.len)
    rt.buf_free(&alt)
    rt.buf_free(&fresh)
    rt.buf_free(&raus)
    return ok
}

fn kleiner(a: u64, an: usize, b: u64, bn: usize) -> bool {
    var i: usize = 0
    while i < an && i < bn {
        let x: u8 = rt.ld8(a, i)
        let y: u8 = rt.ld8(b, i)
        if x < y {
            return true
        }
        if x > y {
            return false
        }
        i = i + 1
    }
    return an < bn
}

fn remove_account(kennung: u64, kl: usize) -> bool {
    var alt: rt.Buf = rt.buf_new()
    if !list_read(&alt) {
        rt.buf_free(&alt)
        return false
    }
    var raus: rt.Buf = rt.buf_new()
    var k: usize = 0
    var gone: bool = false
    while true {
        var von: usize = 0
        var bis: usize = 0
        if !line_get(&alt, k, &von, &bis) {
            break
        }
        var kn: rt.Buf = rt.buf_new()
        let _f: bool = field_get(alt.ptr, von, bis, F_KENNUNG, &kn)
        let selbe: bool = buffer_eq(&kn, kennung, kl)
        rt.buf_free(&kn)
        if selbe {
            gone = true
        } else {
            rt.buf_push_bytes(&raus, alt.ptr + von as u64, bis - von)
            rt.buf_push(&raus, 10 as u8)
        }
        k = k + 1
    }
    var p: [u8; 12] = "/etc/konten\0"
    let ok: bool = rt.write_file((&p[0]) as u64, raus.ptr, raus.len)
    rt.buf_free(&alt)
    rt.buf_free(&raus)
    return ok && gone
}


fn session_path(kennung: u64, kl: usize, aus: *mut rt.Buf) {
    var d: [u8; 23] = "/state/session/konto/\0\0"
    rt.buf_push_bytes(aus, (&d[0]) as u64, 21)
    rt.buf_push_bytes(aus, kennung, kl)
    rt.buf_push(aus, 0 as u8)
}

fn folder() {
    var a: [u8; 7] = "/state\0"
    var b: [u8; 15] = "/state/session\0"
    var c: [u8; 21] = "/state/session/konto\0"
    let _1: bool = ksiegel.dir((&a[0]) as u64)
    let _2: bool = ksiegel.dir((&b[0]) as u64)
    let _3: bool = ksiegel.dir((&c[0]) as u64)
}

fn kv(aus: *mut rt.Buf, k: u64, kn: usize, v: u64, vn: usize) {
    rt.buf_push_bytes(aus, k, kn)
    rt.buf_push(aus, 9 as u8)
    rt.buf_push_bytes(aus, v, vn)
    rt.buf_push(aus, 10 as u8)
}

fn pick_ptr(use_old: bool, fresh: u64, old: u64) -> u64 {
    if use_old {
        return old
    }
    return fresh
}

fn pick_len(use_old: bool, fresh: usize, old: usize) -> usize {
    if use_old {
        return old
    }
    return fresh
}

fn session_save(kennung: u64, kl: usize, s: *mut provider.Session,
    endpoint: u64, zielname: u64) -> bool {
    folder()
    var k_z: [u8; 7] = "access\0"
    var k_e: [u8; 8] = "renewal\0"
    var k_a: [u8; 7] = "expiry\0"
    var k_o: [u8; 7] = "target\0"
    var k_n: [u8; 12] = "target_name\0"
    var k_z_old: [u8; 8] = "zugriff\0"
    var k_e_old: [u8; 11] = "erneuerung\0"
    var k_a_old: [u8; 7] = "ablauf\0"
    var k_o_old: [u8; 5] = "ziel\0"
    var k_n_old: [u8; 9] = "zielname\0"
    let old: bool = kgegen.an(kgegen.G_OLDKEYS)
    var klar: rt.Buf = rt.buf_new()
    var head: [u8; 8] = "konto1\n\0"
    rt.buf_push_bytes(&klar, (&head[0]) as u64, 7)
    kv(&klar, pick_ptr(old, (&k_z[0]) as u64, (&k_z_old[0]) as u64), pick_len(old, 6, 7),
        (*s).zugriff.ptr, (*s).zugriff.len)
    kv(&klar, pick_ptr(old, (&k_e[0]) as u64, (&k_e_old[0]) as u64), pick_len(old, 7, 10),
        (*s).erneuerung.ptr, (*s).erneuerung.len)
    rt.buf_push_bytes(&klar, pick_ptr(old, (&k_a[0]) as u64, (&k_a_old[0]) as u64), 6)
    rt.buf_push(&klar, 9 as u8)
    rt.buf_push_dec_u64(&klar, (*s).ablauf)
    rt.buf_push(&klar, 10 as u8)
    if endpoint != 0 {
        kv(&klar, pick_ptr(old, (&k_o[0]) as u64, (&k_o_old[0]) as u64), pick_len(old, 6, 4),
            endpoint, rt.c_length(endpoint))
    }
    if zielname != 0 {
        kv(&klar, pick_ptr(old, (&k_n[0]) as u64, (&k_n_old[0]) as u64), pick_len(old, 11, 8),
            zielname, rt.c_length(zielname))
    }
    var gesiegelt: rt.Buf = rt.buf_new()
    if !ksiegel.siegeln(klar.ptr, klar.len, &gesiegelt) {
        rt.buf_free(&klar)
        rt.buf_free(&gesiegelt)
        return false
    }
    var pf: rt.Buf = rt.buf_new()
    session_path(kennung, kl, &pf)
    let ok: bool = ksiegel.file_write_0600(pf.ptr, gesiegelt.ptr,
        gesiegelt.len)
    rt.mem_set(klar.ptr, 0 as u8, klar.len)
    rt.buf_free(&klar)
    rt.buf_free(&gesiegelt)
    rt.buf_free(&pf)
    return ok
}

fn line_value(b: *mut rt.Buf, name: u64, nn: usize,
    aus: *mut rt.Buf) -> bool {
    var k: usize = 0
    while true {
        var von: usize = 0
        var bis: usize = 0
        if !line_get(b, k, &von, &bis) {
            return false
        }
        if bis - von > nn && rt.ld8((*b).ptr, von + nn) == 9 as u8 {
            if rt.mem_eq((*b).ptr + von as u64, name, nn) {
                rt.buf_push_bytes(aus, (*b).ptr + (von + nn + 1) as u64,
                    bis - von - nn - 1)
                return true
            }
        }
        k = k + 1
    }
    return false
}

fn line_value_any(b: *mut rt.Buf, name: u64, nn: usize, old: u64, on: usize,
    aus: *mut rt.Buf) -> bool {
    if line_value(b, name, nn, aus) {
        return true
    }
    return line_value(b, old, on, aus)
}

fn to_num(p: u64, n: usize) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 {
            return v
        }
        v = v * 10 + (c - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn session_load(kennung: u64, kl: usize, s: *mut provider.Session,
    endpoint: *mut rt.Buf, zielname: *mut rt.Buf) -> bool {
    var pf: rt.Buf = rt.buf_new()
    session_path(kennung, kl, &pf)
    var roh: rt.Buf = rt.buf_new()
    if !rt.read_file(pf.ptr, &roh) {
        rt.buf_free(&pf)
        rt.buf_free(&roh)
        return false
    }
    var klar: rt.Buf = rt.buf_new()
    if !ksiegel.open(roh.ptr, roh.len, &klar) {
        rt.buf_free(&pf)
        rt.buf_free(&roh)
        rt.buf_free(&klar)
        return false
    }
    var k_z: [u8; 7] = "access\0"
    var k_e: [u8; 8] = "renewal\0"
    var k_a: [u8; 7] = "expiry\0"
    var k_o: [u8; 7] = "target\0"
    var k_n: [u8; 12] = "target_name\0"
    var k_z_old: [u8; 8] = "zugriff\0"
    var k_e_old: [u8; 11] = "erneuerung\0"
    var k_a_old: [u8; 7] = "ablauf\0"
    var k_o_old: [u8; 5] = "ziel\0"
    var k_n_old: [u8; 9] = "zielname\0"
    let _1: bool = line_value_any(&klar, (&k_z[0]) as u64, 6, (&k_z_old[0]) as u64, 7, &(*s).zugriff)
    let _2: bool = line_value_any(&klar, (&k_e[0]) as u64, 7, (&k_e_old[0]) as u64, 10,
        &(*s).erneuerung)
    var ab: rt.Buf = rt.buf_new()
    if line_value_any(&klar, (&k_a[0]) as u64, 6, (&k_a_old[0]) as u64, 6, &ab) {
        (*s).ablauf = to_num(ab.ptr, ab.len)
    }
    rt.buf_free(&ab)
    let _3: bool = line_value_any(&klar, (&k_o[0]) as u64, 6, (&k_o_old[0]) as u64, 4, endpoint)
    let _4: bool = line_value_any(&klar, (&k_n[0]) as u64, 11, (&k_n_old[0]) as u64, 8, zielname)
    rt.mem_set(klar.ptr, 0 as u8, klar.len)
    rt.buf_free(&klar)
    rt.buf_free(&roh)
    rt.buf_free(&pf)
    return true
}

fn session_delete(kennung: u64, kl: usize) -> bool {
    var pf: rt.Buf = rt.buf_new()
    session_path(kennung, kl, &pf)
    let ok: bool = ksiegel.secure_delete(pf.ptr)
    rt.buf_free(&pf)
    return ok
}
