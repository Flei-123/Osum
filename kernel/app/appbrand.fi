// SPDX-License-Identifier: GPL-2.0-only
import std.io
import std.rt

export { product, slug, vendor, web, core_name, feed, reload }

static mut v_product: [u8; 40] = [0 as u8; 40]
static mut v_slug: [u8; 40] = [0 as u8; 40]
static mut v_vendor: [u8; 40] = [0 as u8; 40]
static mut v_web: [u8; 100] = [0 as u8; 100]
static mut v_core: [u8; 40] = [0 as u8; 40]
static mut v_feed: [u8; 100] = [0 as u8; 100]
static mut loaded: bool = false

fn key_is(p: u64, from: usize, to: usize, key: u64) -> bool {
    let n: usize = rt.c_length(key)
    if to - from != n {
        return false
    }
    var i: usize = 0
    while i < n {
        if rt.ld8(p, from + i) != rt.ld8(key, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn store(p: u64, from: usize, to: usize, dst: u64, cap: usize) {
    var n: usize = to - from
    if n + 1 > cap {
        n = cap - 1
    }
    var i: usize = 0
    while i < n {
        *((dst + i as u64) as *mut u8) = rt.ld8(p, from + i)
        i = i + 1
    }
    *((dst + n as u64) as *mut u8) = 0 as u8
}

fn assign(p: u64, k0: usize, k1: usize, v0: usize, v1: usize) {
    var n_product: [u8; 8] = "product\0"
    var n_slug: [u8; 5] = "slug\0"
    var n_vendor: [u8; 7] = "vendor\0"
    var n_web: [u8; 4] = "web\0"
    var n_core: [u8; 5] = "core\0"
    var n_feed: [u8; 5] = "feed\0"
    if key_is(p, k0, k1, (&n_product[0]) as u64) {
        store(p, v0, v1, (&v_product[0]) as u64, 40)
    } else if key_is(p, k0, k1, (&n_slug[0]) as u64) {
        store(p, v0, v1, (&v_slug[0]) as u64, 40)
    } else if key_is(p, k0, k1, (&n_vendor[0]) as u64) {
        store(p, v0, v1, (&v_vendor[0]) as u64, 40)
    } else if key_is(p, k0, k1, (&n_web[0]) as u64) {
        store(p, v0, v1, (&v_web[0]) as u64, 100)
    } else if key_is(p, k0, k1, (&n_core[0]) as u64) {
        store(p, v0, v1, (&v_core[0]) as u64, 40)
    } else if key_is(p, k0, k1, (&n_feed[0]) as u64) {
        store(p, v0, v1, (&v_feed[0]) as u64, 100)
    }
}

fn parse(p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        var e: usize = i
        while e < n && rt.ld8(p, e) != 10 as u8 {
            e = e + 1
        }
        var q: usize = i
        while q < e && rt.ld8(p, q) != 61 as u8 {
            q = q + 1
        }
        if q < e {
            assign(p, i, q, q + 1, e)
        }
        i = e + 1
    }
}

fn reload() {
    var path: [u8; 12] = "/proc/brand\0"
    var raw: rt.Buf = rt.buf_new()
    if io.read_file((&path[0]) as u64, &raw) {
        parse(raw.ptr, raw.len)
    }
    rt.buf_free(&raw)
    loaded = true
}

fn ensure() {
    if !loaded {
        reload()
    }
}

fn product() -> u64 {
    ensure()
    return (&v_product[0]) as u64
}

fn slug() -> u64 {
    ensure()
    return (&v_slug[0]) as u64
}

fn vendor() -> u64 {
    ensure()
    return (&v_vendor[0]) as u64
}

fn web() -> u64 {
    ensure()
    return (&v_web[0]) as u64
}

fn core_name() -> u64 {
    ensure()
    return (&v_core[0]) as u64
}

fn feed() -> u64 {
    ensure()
    return (&v_feed[0]) as u64
}
