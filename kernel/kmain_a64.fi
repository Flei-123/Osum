// kernel/kmain_a64.fi -- the root of the AArch64 build.
//
// The counterpart of `kernel/kmain.fi`, and for now a much smaller one. It
// exists because Firn's module search resolves `import` relative to the
// importing file and to the directory of the ROOT file
// (`compiler/src/modules.rs`): a module that sits in `kernel/arch/aarch64/`
// cannot itself be the root, or `import arch.arch` would be looked for at
// `kernel/arch/aarch64/arch/arch.fi`. So the root lives here, next to
// `kmain.fi`, and everything below it resolves the same way it does for the
// x86 kernel.
//
// WHAT IS AND IS NOT IN IT. `kmain.fi` imports fifty modules; this one
// imports one. That is not modesty, it is the measurement: `kmain.fi`
// reaches for `arch.x86_64.apic`, `idt`, `trap`, `guard`, `user`, `smp` and
// `hv`, and none of those has an AArch64 counterpart yet. Until they do,
// putting them in the import list here would only move the failure from a
// missing driver to a missing file.
//
// Built with:
//
//     ./tools/arm/build.sh out.elf
//
// which calls `firnc --target=aarch64-none` on THIS file, assembles
// `kernel/arch/aarch64/{start,vectors,switch}.S`, and links them with
// `--defsym=KERN_MAIN=_F0.amain__kmain` and
// `--defsym=KERN_TRAP=_F0.amain__kexception` -- the same `--defsym` trick
// `tools/build-kernel.sh` uses on x86-64, for the same reason: the assembly
// cannot know which compiler stage prefixed the symbol.

profile kernel

import arch.aarch64.amain

export { start }

// The one thing this file adds: a name for `start.S` to call that does not
// change when the module below it is renamed. `amain.kmain` gets the device
// tree pointer QEMU put in x0 -- which on `-M virt` with `-kernel <ELF>` is
// zero, measured in every run and the reason this port hardcodes its
// addresses instead of parsing a device tree (docs/ARCH.md 5.6).
fn start(dtb: u64) {
    amain.kmain(dtb)
}
