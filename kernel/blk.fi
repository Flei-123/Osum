// kernel/blk.fi -- round 62: the block device.
//
// A file system does not talk to memory, it talks to BLOCKS. This file is
// the whole interface between the two: read block n, write block n, 512
// octets each, and nothing else. That the blocks currently lie in RAM is
// the business of this file alone -- `fs.fi` never learns it.
//
// Three devices:
//
//   0  THE RAM DISK. A run of frames out of the frame allocator, one
//      megabyte by default. Reading and writing is a copy; there is
//      nothing to wait for.
//   1  THE REAL DISK, over ATA PIO. The same 512 octets, but through four
//      ports and a status register that has to be waited on. Whoever can
//      read a block over PIO can read a disk -- and `fs.fi` does not have
//      to change a line for it, which is exactly the point of the
//      interface.
//   2  ROUND K2: THE SAME 512 OCTETS OVER DMA (`nvme.fi`). The kernel
//      writes a command into a queue in memory and rings a doorbell; the
//      controller fetches the command itself, moves the data itself and
//      says so with an interrupt. `fs.fi` does not learn that either --
//      the whole file system runs on it without a line changed, and
//      `tools/pci/run.sh` runs the same file system test on all three
//      devices to prove exactly that.
//
// The counter-check for the interface is in `tools/kernel/run.sh`: the
// SAME file system test runs once on the RAM disk and once on a real
// image that QEMU hands in as `-drive`, and afterwards the image on the
// host has the file in it. A file system that only ever wrote to memory
// would fail the second run.

import serial
import kstate
import nvme

export {
    ram_init, use_ata, use_nvme, read, write, blocks, present,
    BLOCK_SIZE, DEV_RAM, DEV_ATA, DEV_NVME, DEV_ATA1,
    // ---- Runde K14 ----
    read_on, write_on, blocks_on, present_on, probe_ata1, dev_name
}

const BLOCK_SIZE: u64 = 512
const DEV_RAM: u64 = 0
const DEV_ATA: u64 = 1
const DEV_NVME: u64 = 2
// ROUNDE K14: DIE ZWEITE PLATTE. Derselbe Bus, dasselbe Registerpaar,
// ein einziges Bit anders -- Bit 4 des Laufwerksregisters waehlt den
// Sklaven statt des Meisters. Sie ist die Platte, auf der ein FREMDES
// Dateisystem liegt: Osum haengt seine eigene weiter unter DEV_ATA ein
// und liest daneben, was Linux geschrieben hat. Ohne ein zweites
// Geraet waere jede Messung dieser Runde ein Selbstgespraech.
const DEV_ATA1: u64 = 3

// ------------------------------------------------------------- the RAM

fn ram_init(state: u64, base: u64, blocks_n: u64) {
    kstate.set(state, kstate.DISK, base)
    kstate.set(state, kstate.DISK_BLOCKS, blocks_n)
    kstate.set(state, kstate.DISK_DEV, DEV_RAM)
}

// From here on the same file system writes to a real disk. Nothing else
// changes -- that is what the interface is for.
fn use_ata(state: u64, blocks_n: u64) {
    kstate.set(state, kstate.DISK, 0)
    kstate.set(state, kstate.DISK_BLOCKS, blocks_n)
    kstate.set(state, kstate.DISK_DEV, DEV_ATA)
}

// Round K2. The third device, and the interface does not widen by a
// single argument for it.
fn use_nvme(state: u64, blocks_n: u64) {
    kstate.set(state, kstate.DISK, 0)
    kstate.set(state, kstate.DISK_BLOCKS, blocks_n)
    kstate.set(state, kstate.DISK_DEV, DEV_NVME)
}

fn blocks(state: u64) -> u64 {
    return kstate.get(state, kstate.DISK_BLOCKS)
}

fn copy(from: u64, to: u64) {
    var i: u64 = 0
    while i < BLOCK_SIZE / 8 {
        __mmio_write64((to + i * 8) as *mut u64,
            __mmio_read64((from + i * 8) as *mut u64))
        i = i + 1
    }
}

// --------------------------------------------------------------- ATA

// The primary bus, master drive. The ports are the ones every PC has had
// since 1986; QEMU speaks them because everything speaks them.
const ATA_DATA: u16 = 0x1F0
const ATA_ERROR: u16 = 0x1F1
const ATA_COUNT: u16 = 0x1F2
const ATA_LBA0: u16 = 0x1F3
const ATA_LBA1: u16 = 0x1F4
const ATA_LBA2: u16 = 0x1F5
const ATA_DRIVE: u16 = 0x1F6
const ATA_CMD: u16 = 0x1F7 // write: command, read: status
const ATA_CTRL: u16 = 0x3F6

const ATA_READ: u8 = 0x20
const ATA_WRITE: u8 = 0x30
const ATA_FLUSH: u8 = 0xE7

const ST_BSY: u64 = 0x80
const ST_DRQ: u64 = 0x08
const ST_ERR: u64 = 0x01

fn in16(port: u16) -> u64 {
    return asm("in ax, dx", out("rax"), in("dx") port) & 0xFFFF
}

fn out16(port: u16, value: u64) {
    asm("out dx, ax", in("dx") port, in("ax") value as u16)
}

// Wait until the drive is no longer busy and has data. Bounded: a device
// that never answers must not hang the kernel.
fn ata_wait(want_drq: bool) -> bool {
    var spin: u64 = 0
    while spin < 4000000 {
        let st: u64 = serial.in8(ATA_CMD) as u64
        if (st & ST_BSY) == 0 {
            if (st & ST_ERR) != 0 {
                return false
            }
            if !want_drq {
                return true
            }
            if (st & ST_DRQ) != 0 {
                return true
            }
        }
        spin = spin + 1
    }
    return false
}

// ROUNDE K14: `slave` waehlt Bit 4. Die Zeile hiess bis dahin fest
// 0xE0 -- Meister, LBA-Modus. 0xF0 ist derselbe Modus auf dem zweiten
// Geraet desselben Busses.
fn ata_select_on(lba: u64, slave: bool) {
    var top: u64 = 0xE0
    if slave {
        top = 0xF0
    }
    serial.out8(ATA_DRIVE, (top | ((lba >> 24) & 0x0F)) as u8)
    serial.out8(ATA_COUNT, 1 as u8)
    serial.out8(ATA_LBA0, (lba & 0xFF) as u8)
    serial.out8(ATA_LBA1, ((lba >> 8) & 0xFF) as u8)
    serial.out8(ATA_LBA2, ((lba >> 16) & 0xFF) as u8)
}

fn ata_select(lba: u64) {
    serial.out8(ATA_DRIVE, (0xE0 | ((lba >> 24) & 0x0F)) as u8)
    serial.out8(ATA_COUNT, 1 as u8)
    serial.out8(ATA_LBA0, (lba & 0xFF) as u8)
    serial.out8(ATA_LBA1, ((lba >> 8) & 0xFF) as u8)
    serial.out8(ATA_LBA2, ((lba >> 16) & 0xFF) as u8)
}

// Is there a drive at all? A bus without one reads 0xFF as status.
fn present(state: u64) -> bool {
    serial.out8(ATA_DRIVE, 0xE0 as u8)
    serial.io_wait()
    let st: u64 = serial.in8(ATA_CMD) as u64
    if st == 0xFF || st == 0 {
        return false
    }
    return true
}

// ROUNDE K14: WAS NACH EINER ZEITUEBERSCHREITUNG UEBRIGBLEIBT.
//
// `ata_wait` gibt auf, wenn das Laufwerk nach vier Millionen
// Abfragen nicht antwortet -- und liess es bis zu dieser Runde in
// GENAU DEM ZUSTAND stehen, in dem es gerade war: mitten in einem
// Befehl, womoeglich mit 256 Woertern im Datenregister, die niemand
// abholt. Der NAECHSTE Befehl trifft dann auf ein Laufwerk, das noch
// den vorigen zu Ende bringen will, und schlaegt auch fehl. So wird
// aus einer einzelnen langsamen Antwort eine Platte, die fuer den
// Rest des Laufs kaputt ist.
//
// Gesehen wurde das in der Vollabnahme dieser Runde: unter Last hat
// EIN Sektorlesen die Grenze gerissen, und danach fand
// `part.scan` keine Partitionstafel mehr -- `mount` sagte -ENODEV
// auf einer Platte, die eine Sekunde vorher noch gelesen worden war.
//
// Der Ausweg ist der, den jedes ATA-Laufwerk kennt: das SRST-Bit im
// Steuerregister setzen, kurz warten, zuruecknehmen. Danach ist das
// Laufwerk wieder am Anfang. Der Rueckgabewert bleibt `false` -- der
// Lesevorgang IST fehlgeschlagen, und das soll er auch sagen.
fn ata_recover(slave: bool) {
    serial.out8(ATA_CTRL, 0x04 as u8) // SRST
    var i: u64 = 0
    while i < 1000 {
        serial.io_wait()
        i = i + 1
    }
    serial.out8(ATA_CTRL, 0x00 as u8)
    i = 0
    while i < 1000000 && (serial.in8(ATA_CMD) as u64 & ST_BSY) != 0 {
        i = i + 1
    }
    var top: u64 = 0xE0
    if slave {
        top = 0xF0
    }
    serial.out8(ATA_DRIVE, top as u8)
    serial.io_wait()
}

fn ata_read_on(lba: u64, dst: u64, slave: bool) -> bool {
    ata_select_on(lba, slave)
    serial.out8(ATA_CMD, ATA_READ)
    if !ata_wait(true) {
        ata_recover(slave)
        return false
    }
    var i: u64 = 0
    while i < BLOCK_SIZE / 2 {
        __mmio_write16((dst + i * 2) as *mut u16, in16(ATA_DATA) as u16)
        i = i + 1
    }
    return true
}

fn ata_write_on(lba: u64, src: u64, slave: bool) -> bool {
    ata_select_on(lba, slave)
    serial.out8(ATA_CMD, ATA_WRITE)
    if !ata_wait(true) {
        ata_recover(slave)
        return false
    }
    var i: u64 = 0
    while i < BLOCK_SIZE / 2 {
        out16(ATA_DATA, __mmio_read16((src + i * 2) as *mut u16) as u64)
        i = i + 1
    }
    serial.out8(ATA_CMD, ATA_FLUSH)
    return ata_wait(false)
}

fn ata_read(lba: u64, dst: u64) -> bool {
    ata_select(lba)
    serial.out8(ATA_CMD, ATA_READ)
    if !ata_wait(true) {
        return false
    }
    var i: u64 = 0
    while i < BLOCK_SIZE / 2 {
        __mmio_write16((dst + i * 2) as *mut u16, in16(ATA_DATA) as u16)
        i = i + 1
    }
    return true
}

fn ata_write(lba: u64, src: u64) -> bool {
    ata_select(lba)
    serial.out8(ATA_CMD, ATA_WRITE)
    if !ata_wait(true) {
        return false
    }
    var i: u64 = 0
    while i < BLOCK_SIZE / 2 {
        out16(ATA_DATA, __mmio_read16((src + i * 2) as *mut u16) as u64)
        i = i + 1
    }
    serial.out8(ATA_CMD, ATA_FLUSH)
    return ata_wait(false)
}

// ------------------------------------------------- Runde K14: das Geraet
//
// Bis zu dieser Runde war die Geraetenummer eine GLOBALE Zahl
// (`kstate.DISK_DEV`): es gab genau eine Platte, und `read` sah nach,
// welche es gerade war. Sobald zwei Dateisysteme gleichzeitig
// eingehaengt sind, ist das falsch -- OFS liegt auf der einen, FAT32
// auf der anderen, und ein Lesevorgang darf nicht davon abhaengen, wer
// zuletzt `use_ata` gerufen hat.
//
// Also bekommt die Schnittstelle das Geraet als ARGUMENT. `read` und
// `write` oben bleiben genau, was sie waren -- sie reichen die globale
// Zahl durch -- und `fs.fi` aendert dafuer keine Zeile. Das ist
// dieselbe Regel wie bei DEV_NVME in Runde K2: eine Platte mehr, und
// die Schicht darueber merkt nichts davon.

fn ata1_present(state: u64) -> bool {
    serial.out8(ATA_DRIVE, 0xF0 as u8)
    serial.io_wait()
    serial.io_wait()
    let st: u64 = serial.in8(ATA_CMD) as u64
    // Das Laufwerksregister zurueck auf den Meister: alles andere in
    // diesem Kernel geht von ihm aus, und ein stehengelassenes Bit 4
    // waere ein Fehler, der erst drei Bloecke spaeter auffaellt.
    serial.out8(ATA_DRIVE, 0xE0 as u8)
    serial.io_wait()
    if st == 0xFF || st == 0 {
        return false
    }
    return true
}

fn present_on(state: u64, dev: u64) -> bool {
    if dev == DEV_ATA1 {
        return ata1_present(state)
    }
    if dev == DEV_ATA {
        return present(state)
    }
    return true
}

// Wie viele Bloecke das Geraet hat. Fuer die zweite Platte steht die
// Zahl in einem eigenen Skalar; sie darf die der ersten nicht anfassen.
fn blocks_on(state: u64, dev: u64) -> u64 {
    if dev == DEV_ATA1 {
        return kstate.get(state, kstate.DISK2_BLOCKS)
    }
    return kstate.get(state, kstate.DISK_BLOCKS)
}

// Die zweite Platte anmelden. `n` ist ihre Groesse in Bloecken, wie sie
// der Aufrufer kennt -- ATA PIO sagt sie nicht von selbst, und ein
// IDENTIFY dafuer waere ein zweites Protokoll fuer eine Zahl, die der
// Wirt ohnehin vorgibt.
fn probe_ata1(state: u64, n: u64) -> bool {
    kstate.set(state, kstate.DISK2_DEV, DEV_ATA1)
    kstate.set(state, kstate.DISK2_BLOCKS, 0)
    if !ata1_present(state) {
        return false
    }
    // Ein Geraet, das antwortet, muss auch seinen ersten Block
    // hergeben. Ein Statusregister, das nicht 0xFF liest, ist noch
    // keine Platte -- QEMU laesst den Sklaven auch dann antworten, wenn
    // gar kein -drive daran haengt.
    var probe: [u8; 512] = [0 as u8; 512]
    if !ata_read_on(0, (&probe[0]) as u64, true) {
        return false
    }
    kstate.set(state, kstate.DISK2_BLOCKS, n)
    return true
}

fn dev_name(dev: u64) -> u64 {
    return dev
}

// EIN ZWEITER VERSUCH, UND NUR EINER. Nach `ata_recover` steht das
// Laufwerk wieder am Anfang; eine einzelne langsame Antwort ist dann
// kein Grund, die Platte fuer kaputt zu erklaeren. Ein DRITTER Versuch
// waere Aberglaube -- was zweimal nicht antwortet, antwortet nicht.
fn ata_read_twice(lba: u64, dst: u64, slave: bool) -> bool {
    if ata_read_on(lba, dst, slave) {
        return true
    }
    return ata_read_on(lba, dst, slave)
}

fn read_on(state: u64, dev: u64, lba: u64, dst: u64) -> bool {
    if lba >= blocks_on(state, dev) {
        return false
    }
    if dev == DEV_ATA {
        return ata_read_twice(lba, dst, false)
    }
    if dev == DEV_ATA1 {
        return ata_read_twice(lba, dst, true)
    }
    if dev == DEV_NVME {
        return nvme.read_block(state, lba, dst)
    }
    let base: u64 = kstate.get(state, kstate.DISK)
    if base == 0 {
        return false
    }
    copy(base + lba * BLOCK_SIZE, dst)
    return true
}

fn write_on(state: u64, dev: u64, lba: u64, src: u64) -> bool {
    if lba >= blocks_on(state, dev) {
        return false
    }
    if dev == DEV_ATA {
        return ata_write_on(lba, src, false)
    }
    if dev == DEV_ATA1 {
        return ata_write_on(lba, src, true)
    }
    if dev == DEV_NVME {
        return nvme.write_block(state, lba, src)
    }
    let base: u64 = kstate.get(state, kstate.DISK)
    if base == 0 {
        return false
    }
    copy(src, base + lba * BLOCK_SIZE)
    return true
}

// ------------------------------------------------------- the interface

fn read(state: u64, lba: u64, dst: u64) -> bool {
    if lba >= blocks(state) {
        return false
    }
    if kstate.get(state, kstate.DISK_DEV) == DEV_ATA {
        return ata_read(lba, dst)
    }
    if kstate.get(state, kstate.DISK_DEV) == DEV_NVME {
        return nvme.read_block(state, lba, dst)
    }
    let base: u64 = kstate.get(state, kstate.DISK)
    if base == 0 {
        return false
    }
    copy(base + lba * BLOCK_SIZE, dst)
    return true
}

fn write(state: u64, lba: u64, src: u64) -> bool {
    if lba >= blocks(state) {
        return false
    }
    if kstate.get(state, kstate.DISK_DEV) == DEV_ATA {
        return ata_write(lba, src)
    }
    if kstate.get(state, kstate.DISK_DEV) == DEV_NVME {
        return nvme.write_block(state, lba, src)
    }
    let base: u64 = kstate.get(state, kstate.DISK)
    if base == 0 {
        return false
    }
    copy(src, base + lba * BLOCK_SIZE)
    return true
}
