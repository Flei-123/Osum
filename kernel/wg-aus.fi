// kernel/wg-aus.fi -- DER KERN OHNE DEN TUNNEL.
//
// Justins Vorgabe zur Runde TUNNEL lautet: VPN, Proxy und die
// Tor-Anbindung sind OPTIONAL, und
//
//     „Ein Kernelteil, der nur fuer ein optionales Paket da ist, muss
//      sich sauber abschalten lassen und darf ohne das Paket NICHTS
//      kosten -- weder Speicher noch Rechenzeit."
//
// Das zerfaellt in drei Kosten, und sie verhalten sich verschieden.
// `docs/TUNNEL-PAKETE.md` misst alle drei; hier steht, warum es diese
// Datei ueberhaupt gibt.
//
//   RECHENZEIT. Kostet ohne Tunnel schon in `kernel/wg.fi` nichts:
//       `rx_hook`, `tx_hook` und `tick` pruefen als ERSTES `ready()`,
//       und `ready()` ist `dev(state) != 0`. Ohne `wgpriv=` wird nie
//       eine Geraeteregion angelegt, also ist das ein Vergleich gegen
//       Null je Rahmen. Diese Datei aendert daran nichts, sie
//       BEWEIST es nur: wer beide Abbilder gegeneinander misst und
//       denselben Durchsatz sieht, weiss, dass der Haken nichts kostet.
//
//   ARBEITSSPEICHER. Ohne Tunnel sind es die zwoelf Skalarworte auf
//       der K2-Seite, 96 Oktette, und die stehen ohnehin in einer
//       Seite, die es schon gibt. Die Geraeteregion und die zwei
//       Seiten fuer `scratch` und `inject` entstehen erst in
//       `init()`, und `init()` ruft nur `configure()`, und
//       `configure()` kehrt ohne `wgpriv=` in der zweiten Zeile um.
//
//   ABBILDGROESSE. Das ist die einzige Kosten, die sich NICHT zur
//       Laufzeit wegdruecken laesst: Osum hat keine nachladbaren
//       Module, ein Multiboot-Abbild ist ein Stueck. Der Code von
//       `lib/wg/proto.fi` und `lib/crypto/` liegt im Abbild, ob ein
//       Tunnel laeuft oder nicht. Dagegen hilft nur, ihn gar nicht
//       erst hineinzuuebersetzen -- und genau das ist diese Datei.
//
//       `tools/build-kernel.sh --ohne-tunnel` baut den Baum mit
//       dieser Datei anstelle von `kernel/wg.fi`. Was eine
//       Distribution ausliefert, die das Paket `vpn` nicht anbietet,
//       ist dann ein Kern, in dem der Tunnel nicht VORHANDEN ist --
//       nicht einer, in dem er abgeschaltet ist. Das ist der
//       Unterschied zwischen einem Schalter und einer Abwesenheit,
//       und nur das zweite kostet wirklich nichts.
//
// WAS DIESE DATEI NICHT IST: kein zweiter Tunnel und kein zweites
// Verhalten. Jede Funktion hier sagt „es gibt keinen Tunnel", und zwar
// in derselben Form, in der `kernel/wg.fi` es sagt, wenn keiner
// eingerichtet wurde. Ein Kern mit dieser Datei verhaelt sich fuer
// `kernel/inet.fi` und `kernel/netsvc.fi` GENAU wie einer mit
// `kernel/wg.fi` und ohne `wgpriv=` auf der Kommandozeile. Deshalb
// braucht keine der beiden Dateien eine Fallunterscheidung.
//
// DER NOTAUS FAELLT MIT WEG, und das ist richtig so: er schuetzt
// Verkehr, der durch einen Tunnel soll, der hier nicht existiert. Ein
// Notaus ohne Tunnel haette nichts zu schuetzen und waere nur ein
// Schalter, der Pakete verwirft.

profile kernel

export {
    init, ready, up, set_up, arm_kill, kill_armed, killed_octets,
    rx_hook, tx_hook, tick, dev, stat, peers, port,
    set_private, public_key, add_peer, allow, endpoint, psk, keepalive,
    set_addr, awg, clear, configure,
    handshakes, established, last_error,
    stage
}

// `kernel/inet.fi` erwartet dieselben zwei Zahlen wie von `wg.fi`.
const TX_PASS: u64 = 0
const TX_DROP: u64 = 1

fn dev(state: u64) -> u64 {
    return 0
}

fn ready(state: u64) -> bool {
    return false
}

fn up(state: u64) -> bool {
    return false
}

fn port(state: u64) -> u64 {
    return 0
}

fn kill_armed(state: u64) -> bool {
    return false
}

fn killed_octets(state: u64) -> u64 {
    return 0
}

fn last_error(state: u64) -> u64 {
    return 0
}

fn stat(state: u64, which: u64) -> u64 {
    return 0
}

fn peers(state: u64) -> u64 {
    return 0
}

fn handshakes(state: u64) -> u64 {
    return 0
}

fn established(state: u64, i: u64) -> bool {
    return false
}

fn init(state: u64) -> bool {
    return false
}

fn clear(state: u64) {
}

fn set_up(state: u64, v: u64) -> bool {
    return false
}

fn arm_kill(state: u64, v: u64) {
}

fn set_private(state: u64, src: u64) -> bool {
    return false
}

fn public_key(state: u64, dst: u64) -> bool {
    return false
}

fn add_peer(state: u64, pub32: u64) -> i64 {
    return -1
}

fn allow(state: u64, i: u64, ip: u64, prefix: u64) -> bool {
    return false
}

fn endpoint(state: u64, i: u64, ip: u64, p: u64) -> bool {
    return false
}

fn psk(state: u64, i: u64, src: u64) -> bool {
    return false
}

fn keepalive(state: u64, i: u64, s: u64) -> bool {
    return false
}

fn set_addr(state: u64, ip: u64, prefix: u64, mtu: u64) -> bool {
    return false
}

fn awg(state: u64, jc: u64, jmin: u64, jmax: u64, s1: u64, s2: u64,
    h1: u64, h2: u64, h3: u64, h4: u64) -> bool {
    return false
}

// DIE ZWEI HAKEN IM PAKETPFAD. `false` heisst „nicht meins, gib es dem
// Stapel"; `TX_PASS` heisst „lass es hinaus". Beides ist genau das,
// was `kernel/wg.fi` ohne eingerichteten Tunnel auch antwortet.
fn rx_hook(state: u64, frame: u64, n: u64) -> bool {
    return false
}

fn tx_hook(state: u64, frame: u64, n: u64) -> u64 {
    return TX_PASS
}

fn tick(state: u64) {
}

fn configure(state: u64, cmd: u64) {
}

// `kernel/netsvc.fi` ruft `stage` beim Hochlauf. Ohne Tunnel wird
// nichts gemeldet -- kein „wg: aus", denn eine Zeile ueber etwas, das
// es nicht gibt, ist auch eine Zeile zu viel.
fn stage(state: u64, cmd: u64) {
}
