const MNT_RDONLY: u64 = 1
const MNT_KNOWN: u64 = 1
// ================================================= RUNDE K16: 1900..1999
//
// Der Zahlenraum dieser Runde. Vier Runden liefen an dem Tag gleichzeitig
// und hatten sich in den 1000ern schon zweimal getroffen; deshalb ist er
// vorher verteilt worden: K13 hat 1600..1699, K14 1700..1799, K15
// 1800..1899, K16 1900..1999.
//
// Was die vier tun, steht in `kernel/ftype.fi`. Sie sind die SCHICHT
// UNTER dem Doppelklick von Runde K15: die Tabelle "Dateiart -> womit
// oeffnen" und das Starten. K15 ruft `fopen` und bekommt eine
// Prozessnummer -- oder einen negativen Fehler, und dann hat nichts
// gestartet.
// ================================================= RUNDE K18: 1750..1799
//
// Der Zahlenraum dieser Runde. Er liegt in der zweiten Haelfte des
// Hunderters, den Runde K14 bekommen hat (1700..1799) -- K14 hat davon
// genau EINE Nummer belegt (1700), und die Verteilung fuer den Tag, an
// dem mehrere Runden gleichzeitig liefen, hat K18 die 1750..1799
// zugeteilt. `tools/k18/run.sh` rechnet nach, dass keine dieser Nummern
// anderswo im Baum vorkommt.
//
// Drei Aufrufe, und die Bauart ist die von SYS_OSUM_MNTSTAT und
// SYS_OSUM_PSTAT: EINE ZAHL JE AUFRUF, kein Zeiger in den Kernel, kein
// Aufbau, der sich zwischen Ring 3 und Ring 0 einigen muesste. Das ist
// bei einem Dutzend Werten ein Dutzend Aufrufe -- und dafuer gibt es
// keine Struktur, deren Felder auseinanderlaufen koennen, und der
// Testlauf kann jeden Wert einzeln gegen die Meldung des Kernels halten.
//
//   1750  osum_pwrget(feld)          -> Wert
//   1751  osum_pwrset(feld, wert)    -> 0 oder -errno
//   1752  osum_pwrstr(welche, puffer, len) -> Laenge
// ============================================ RUNDE TILING: der Baum
//
// VIER AUFRUFE, Vorrat 1820..1829, und die Bauart ist die von
// SYS_OSUM_PWRGET aus Runde K18: EINE ZAHL JE AUFRUF, kein Zeiger in den
// Kernel ausser bei der Belegungsdatei -- und die geht durch `copy_in`
// wie jeder andere Puffer aus Ring 3.
//
// WARUM ES SIE GIBT: die Bedienung des Kachelbetriebs gehoert nach Ring
// 3. Der Kernel rechnet den Baum aus, weil der Fensterserver hier liegt;
// WELCHE Taste was tut, welches Menue es dazu gibt und wie die
// Einstellungen aussehen, ist Sache eines Programms. `/bin/tiling` ist
// dieses Programm, und diese vier Nummern sind alles, was es braucht.
// (1800..1809 gehoeren seit Runde K15 der Widget-Naht `wig.fi` -- diese
// Runde hat sie zuerst genommen und musste weiter nach oben. Der
// Kollisionspruefer `tools/kernel/memmap.py` rechnet Speicherseiten nach,
// keine Aufrufnummern; gefunden hat es ein Programm in Ring 3, das auf
// jede Frage -ENODEV bekam.)
const SYS_OSUM_TILEGET: u64 = 1820 // (feld) -> Zahl
const SYS_OSUM_TILEDO: u64 = 1821 // (handlung) -> 0 oder -EINVAL
const SYS_OSUM_TILECONF: u64 = 1822 // (text, len) -> Zahl der Eintraege
const SYS_OSUM_TILEBIND: u64 = 1823 // (nr, feld) -> Taste/Modifikator/Handlung


const SYS_OSUM_PWRGET: u64 = 1750
const SYS_OSUM_PWRSET: u64 = 1751
const SYS_OSUM_PWRSTR: u64 = 1752

// ====================================================== RUNDE I18N
//
// DIE TASTATURBELEGUNG AUS RING 3. Eine Nummer, zwei Richtungen:
//
//   1703  osum_kbd(was, wert)
//         was = KB_GET     -> die Nummer der Belegung (0 = us, 1 = de)
//         was = KB_SET     -> setzt sie, 0 oder -EINVAL
//         was = KB_COUNT   -> wie viele es gibt
//         was = KB_SWITCH  -> wie oft umgeschaltet wurde
//
// WARUM DAS IN DEN KERNEL GEHOERT und nicht in eine Bibliothek: die
// Uebersetzung von Abtastcode zu Zeichen passiert IM
// UNTERBRECHUNGSPFAD (`kbd.irq`). Ring 3 sieht die Taste nie -- es sieht
// nur, was der Kernel daraus gemacht hat. Die Belegung ist deshalb
// notwendig Kernelzustand, so wie der Bildmodus einer ist.
//
// KEINE RECHTEPRUEFUNG UEBER DAS LESEN HINAUS -- und das ist eine
// bewusste Entscheidung, die dazugesagt gehoert: die Belegung ist EINE
// je Maschine, also darf jeder Prozess sie umstellen. Auf einer
// Maschine mit mehreren angemeldeten Benutzern waere das falsch. Diese
// hat einen Bildschirm und eine Tastatur.
// ROUND MERGE: this was 1780, and 1750..1799 belongs to round K18 --
// tools/k18/run.sh measures exactly that and reported the intrusion the
// moment the two branches met. 1703 is the free slot next to this
// round's own 1701 and 1702 (USBSTAT, USBPULL), inside the half of the
// 1700 block that stayed with K14.
const SYS_OSUM_KBD: u64 = 1703
const KB_GET: u64 = 0
const KB_SET: u64 = 1
const KB_COUNT: u64 = 2
const KB_SWITCH: u64 = 3
// ================================================= ROUND POWERMON: 1830
//
// ONE NUMBER PER CALL, no pointer into the kernel, no buffer -- the
// shape round K13 settled on with `SYS_OSUM_PSTAT` and round NETMON
// repeated with `SYS_OSUM_NETMON`, and it is the right shape here for
// the same reason: a monitor asks for a hundred small numbers and never
// for a structure, and a structure would have to be versioned.
//
//     osum_pmon(kind, index, field) -> value
//
//     kind 0  the machine: the scalars of `pmon.fi`, `field` = PM_*/8
//     kind 1  a task: `field` 0..5 are `pmon.PT_*`, above that PT_PID
//             and the two answers only the scheduler has
//     kind 2  one octet of the program name of a task
//     kind 3  one entry of the sample ring: `field` 0 = rate, 1 = tick
//     kind 4  one brightness bucket: 0 = count, 1 = sum, 2 = percent
//     kind 5  set something: `index` says what, `field` is the value
//     kind 6  a PROGRAM row: `field` is `pmon.PR_*`
//     kind 7  one octet of the name of a program row
//
// READING IS ALLOWED FOR ANYBODY, exactly as with PSTAT and NETMON. A
// machine that will not tell the person which of their own programs is
// emptying their battery is not protecting anybody. WRITING (kind 5) is
// not: it moves the day mark and clears the split, and a program that
// could silently zero the accounting of every other program would make
// the display worth less than nothing.
// ================================================ RUNDE HDA: 1850..1859
//
// DER TON AUS RING 3. Fuenf Nummern, und die Bauart ist die von
// SYS_OSUM_PWRGET: EINE ZAHL JE ABFRAGE, kein Aufbau, der sich
// zwischen den Ringen einigen muesste -- ein Abspieler fragt zwei
// Dutzend kleine Zahlen ab und nie eine Struktur, und eine Struktur
// muesste versioniert werden.
//
//   1850  osum_audget(feld)              -> Wert
//   1851  osum_audset(feld, wert)        -> 0 oder -errno
//   1852  osum_audwrite(zeiger, rahmen)  -> angenommene Rahmen
//   1853  osum_audopen(rate)             -> Strom-Kennung oder -errno
//   1854  osum_audsend(id, zeiger, rahmen) -> angenommene Rahmen
//
// ZWEI SCHREIBWEGE, UND DAS IST KEIN DOPPELTES. 1852 schreibt in den
// Geraetering (EIN Programm, kleinste Verzoegerung -- der Weg aus
// Runde MEDIA1, unveraendert); 1853/1854 gehen durch den Mischer
// (MEHRERE Programme). Wer 1853 benutzt, bekommt eine Kennung und
// muss sie mitfuehren; wer 1852 benutzt, hat das Geraet allein oder
// bekommt -EBUSY.
//
// RUNDE TON: 1850..1859 UND NICHT 1840..1849. Der Zweig `hda` hatte
// sich 1840 genommen, weil das damals der naechste freie Zehnerblock
// hinter 1830 (Runde POWERMON) war; auf `merge6` liegt dort seit Runde
// WERKZEUGE `SYS_OSUM_CPUSTAT`. Zwei Zweige, unabhaengig voneinander,
// dieselbe Nummer -- genau der Fall, fuer den es
// `tools/kernel/syscalls.py` gibt (`--frei 1840 1900 --zweige` hat
// 1845 aufwaerts als frei ausgewiesen; der Zehnerblock 1850 ist der
// erste ganze). `tools/ton/run.sh` rechnet nach, dass keine dieser
// Nummern anderswo im Baum vorkommt.
const SYS_OSUM_AUDGET: u64 = 1850
const SYS_OSUM_AUDSET: u64 = 1851
const SYS_OSUM_AUDWRITE: u64 = 1852
const SYS_OSUM_AUDOPEN: u64 = 1853
const SYS_OSUM_AUDSEND: u64 = 1854

// Die Felder von `osum_audset`. Die Nummern stehen genauso in
// `kernel/user/play.fi` und in `kernel/user/ulib.fi`.
const AS_VOLUME: u64 = 0
const AS_OPEN: u64 = 1 // 1 oeffnen, 0 schliessen (Einstromweg)
const AS_MUTE: u64 = 2
const AS_DRAIN: u64 = 3 // angefangenen Eintrag auffuellen und abgeben
const AS_STOP: u64 = 4
const AS_SOUNDS: u64 = 5 // Systemklaenge an/aus
const AS_BEEP: u64 = 6 // Wert = Frequenz in Hz, 0 = der Fehlerton
const AS_RATE: u64 = 7 // die Abtastrate aushandeln
const AS_CLOSE: u64 = 8 // Wert = Strom-Kennung: Mischerstrom schliessen
const AS_END: u64 = 9 // Wert = Strom-Kennung: "ich schreibe nichts mehr"
const AS_SVOL: u64 = 10 // (Kennung << 8) | Prozent -- Lautstaerke JE STROM
const AS_PUMP: u64 = 11 // den Mischer einmal drehen
// ---- RUNDE TON ----
const AS_SOUND: u64 = 12 // Wert = Art des Systemklangs (0 Klick, 1 Hinweis, 2 Fehler), durch den Mischer
const AS_CLICKS: u64 = 13 // Klickton an/aus
const AS_SMUTE: u64 = 14 // (Kennung << 8) | 1/0 -- stumm JE STROM
// ---- RUNDE TON-2 ----
// WARTEN, STATT LEER ZU DREHEN. Wert = ((Kennung + 1) << 8) |
// gewuenschte Rahmen/16; 0 heisst "der Einstromweg", sonst der Strom
// (Kennung - 1). Rueckgabe: wie viele Rahmen jetzt Platz haben.
//
// WARUM UM EINS VERSCHOBEN: `mix.open` gibt fuer den ERSTEN Strom die
// Kennung 0 zurueck. Ohne die Verschiebung waere "Strom 0" von "kein
// Strom, sondern der Einstromweg" nicht zu unterscheiden -- und der
// erste Strom ist genau der, den ein einzelner Abspieler bekommt,
// also der Regelfall und nicht der Sonderfall.
//
// WARUM ES DIESES FELD GEBEN MUSS, und warum es nicht in Ring 3 geht.
// Ist der Ring voll, hat der Abspieler nichts zu tun, bis das Geraet
// gespielt hat. Bis Runde TON drehte er dabei leer (`A_PLAYED` +
// `SYS_YIELD`), und das war GEMESSEN kein Schoenheitsfehler: 139290
// Wartedrehungen zu je zwei Systemaufrufen sind 278580 von 418952
// Aufrufen -- ZWEI DRITTEL aller Systemaufrufe einer Sekunde Ton,
// fuer nichts.
//
// Der naheliegende Ausweg `sleep_ms(1)` ist in diesem Kernel KEINER:
// `do_nanosleep` rechnet in ganzen Zeitgeberschlaegen und rundet AUF
// (TICK_HZ = 100), also schlaeft die kuerzeste Bitte volle 10 ms. Bei
// einem Ring von 85 ms ist das ein Achtel des Vorrats, verschenkt auf
// Verdacht -- Runde TON hat das gemessen (158 Aussetzer) und deshalb
// den Spin behalten.
//
// HIER WIRD STATTDESSEN GERECHNET. Der Kern kennt den Fuellstand und
// die Abtastrate, also kennt er die Zeit bis zum naechsten freien
// Platz. Er schlaeft GENAU so lange -- nicht laenger (das gaebe einen
// Aussetzer) und nicht kuerzer (das waere wieder der Spin).
//
// DIE SPERRE WIRD VORHER ABGEGEBEN. `audio.hold` nimmt eine Drehsperre
// MIT ABGESCHALTETEN UNTERBRECHUNGEN; wer damit schlafen geht, haelt
// den ganzen Rechner an. Deshalb rechnet dieser Weg UNTER der Sperre
// und schlaeft OHNE sie.
const AS_WAITSPACE: u64 = 15

const SYS_OSUM_PMON: u64 = 1830

// ============================================= RUNDE WERKZEUGE: 1840
//
// DIE KERNE, EINZELN. Bauart wie PSTAT, NETMON und PMON: EINE ZAHL JE
// AUFRUF, kein Zeiger in den Kernel, kein Aufbau, ueber den sich Ring 0
// und Ring 3 einigen muessten.
//
//     osum_cpustat(index, feld) -> Wert
//
// WARUM NICHT `sysinfo`. Der nimmt EIN Argument, und ein Wert je Kern
// braucht zwei -- Kern und Feld. Eine zweite Bedeutung in dasselbe
// Argument zu falten (etwa `kern * 100 + feld`) ist die Art Kodierung,
// die beim ersten Rechner mit hundert Kernen bricht.
//
// WARUM ES SIE GIBT: `/bin/taskmgr` zeigt die Auslastung GESAMT UND JE
// KERN, und je Kern gab es sie in diesem Kernel nicht. `C_TICKS` stand
// seit Runde K5 im Satz jedes Kerns, `C_IDLETICKS` ist seit dieser Runde
// daneben -- die Auslastung ist die Differenz zweier Differenzen, und
// das Rechnen davon gehoert nach Ring 3, wo der Zeitpunkt der beiden
// Messungen bekannt ist.
//
// LESEN DARF JEDER, genau wie bei PSTAT, NETMON und PMON. Wie viele
// Kerne eine Maschine hat und wie beschaeftigt sie sind, ist kein
// Geheimnis, und ein Rechner, der seinem Besitzer die eigene Auslastung
// verschweigt, schuetzt niemanden. GESCHRIEBEN WIRD HIER GAR NICHTS.
// ==================================================== RUNDE PROTOKOLL
//
// 1860 -- DAS KERNPROTOKOLL, und 1861 der Testausloeser.
//
// `sys4(1860, was, arg, zeiger, laenge)`. Die Abfragen (`KL_*` unter 10)
// liefern eine Zahl und ruehren nichts an; `KL_LINE` schreibt EINE
// fertig formatierte Zeile nach `zeiger`. Das Format ist dasselbe, das
// auf der seriellen Leitung steht -- es steht EINMAL, in
// `klog.line_at`, und /bin/log, /dev/klog und /proc/klog nehmen alle
// diesen Weg.
//
// WER DARF WAS. Lesen darf jeder, wie bei PSTAT, NETMON, PMON und
// CPUSTAT: was die Treiber dieser Maschine gemeldet haben, ist kein
// Geheimnis, und ein Rechner, der seinem Besitzer die eigenen
// Fehlermeldungen verschweigt, schuetzt niemanden. Die SCHWELLEN
// aendern (`KL_SETMIN`, `KL_SETSER`) darf nur Wurzel -- eine Schwelle
// auf `error` von einem beliebigen Programm aus waere die einfachste
// Art, die Spuren einer Tat verschwinden zu lassen.
const SYS_OSUM_KLOG: u64 = 1860

const KL_SEQ: u64 = 0 // wie viele Zeilen je geschrieben wurden
const KL_FIRST: u64 = 1 // kleinste Laufnummer, die noch im Ring steht
const KL_LOST: u64 = 2 // wie viele der Ring ueberschrieben hat
const KL_FILT: u64 = 3 // weggefilterte Aufrufe
const KL_MIN: u64 = 4 // Aufzeichnungsschwelle
const KL_SER: u64 = 5 // Schwelle der seriellen Ausgabe
const KL_NENT: u64 = 6 // wie viele Eintraege der Ring fasst
const KL_LINE: u64 = 10 // arg = Laufnummer -> Zeile nach (zeiger, laenge)
const KL_SETMIN: u64 = 20 // nur Wurzel
const KL_SETSER: u64 = 21 // nur Wurzel
const KL_WRITE: u64 = 22 // arg = Stufe, (zeiger, laenge) = Text
const KL_CRASH: u64 = 30 // liegt ein Absturzbericht vom letzten Start vor?

// 1861 -- DER TESTAUSLOESER, UND WARUM ER EINEN RIEGEL HAT.
//
// Die Abnahme dieser Runde verlangt eine ERZWUNGENE Kernel-Panik: ohne
// sie liesse sich der Panik-Bildschirm nur messen, indem man auf einen
// echten Fehler wartet. Ein Systemaufruf, mit dem jedes Programm den
// Kern anhalten kann, ist aber genau die Art Tuer, die man in einem
// Betriebssystem nicht offen laesst. Also: er antwortet -EPERM, solange
// `krach` NICHT auf der Kernel-Befehlszeile steht, und ausserdem nur
// der Wurzel. Beides zusammen, nicht eines davon.
const SYS_OSUM_KRACH: u64 = 1861

const SYS_OSUM_CPUSTAT: u64 = 1840

// ===================================================== RUNDE FEEDBACK,
// in diesen Zweig geholt von RUNDE BRIDGE-2.
//
// DAS BILDSCHIRMFOTO. EIN Aufruf mit fuenf Handlungen.
//
//     osum_shot(was, a1, a2) -> Zahl
//
//     SH_INFO(feld)          eine Auskunft. DARF JEDER.
//     SH_ARM(pid, 0)         einen Einmal-Schein ausstellen. Nur die
//                            Taskleiste oder die Wurzel.
//     SH_GRAB(puffer, len)   ein Band Bildpunkte holen. Braucht einen
//                            gueltigen Schein DIESES Prozesses.
//     SH_KEY(0, 0)           sich nach einem Druck auf Super+P selbst
//                            einen Schein ausstellen -- der Kern prueft
//                            Taste, Alter, Einmaligkeit und Fokus.
//     SH_DROP(0, 0)          den eigenen Schein zurueckgeben.
//
// DIE NUMMER IST 1841 UND NICHT 1840, und das ist der Grund, aus dem
// diese Runde die Datei ueberhaupt anfassen musste: Runde FEEDBACK hat
// 1840 genommen, weil der Platz damals frei war. In `merge6` ist 1840
// seit Runde WERKZEUGE `SYS_OSUM_CPUSTAT` (eine Zeile weiter oben).
//
// DAS WAR NICHT NUR EIN SCHOENHEITSFEHLER. `kernel/app/jarvisd.fi`
// fragte mit `syscall(1840, 0, 0, ...)`, OB dieser Kern das
// Bildschirmfoto hat, und wertete "Antwort >= 0" als ja. In merge6
// beantwortet `do_cpustat` genau diesen Aufruf mit der KERNZAHL --
// einer Zahl >= 0. Der Helfer hat daraufhin JEDES Bildschirmfoto mit
// "dieser Kern hat SYS_OSUM_SHOT" abgelehnt. Gemessen, nicht vermutet.
//
// Die ganze Begruendung -- warum das Recht so und nicht anders liegt --
// steht in `kernel/shot.fi`, oben. Die Umsetzung steht in
// `kernel/sysgui.fi` (`shot_call`) und nicht hier: sie braucht den
// Fensterserver, und der haengt an `gfx`.
const SYS_OSUM_SHOT: u64 = 1841

const SH_INFO: u64 = 0
const SH_ARM: u64 = 1
const SH_GRAB: u64 = 2
const SH_KEY: u64 = 3
const SH_DROP: u64 = 4

// Die Felder von SH_INFO. ALLE frei abfragbar, und das ist Absicht: was
// gezaehlt wird, kann nicht heimlich sein.
const SI_READY: u64 = 0 // 1 = es gibt ein Bild zu holen
const SI_WIDTH: u64 = 1
const SI_HEIGHT: u64 = 2
const SI_ROWBYTES: u64 = 3 // Breite mal drei
const SI_BYTES: u64 = 4 // das ganze Bild
const SI_CHUNKROWS: u64 = 5 // wie viele Zeilen ein SH_GRAB hoechstens gibt
const SI_SHOTS: u64 = 6 // fertige Bilder seit dem Start
const SI_LASTPID: u64 = 7 // wer das letzte bekommen hat
const SI_ARMED: u64 = 8 // 1 = ein Schein ist offen
const SI_ARMPID: u64 = 9 // fuer wen
const SI_DENIED: u64 = 10 // abgelehnte Versuche
const SI_ARMS: u64 = 11 // ausgestellte Scheine
const SI_NEXT: u64 = 12 // welche Zeile als naechstes drankaeme
const SI_KEY: u64 = 13 // welche Taste als Bildschirmfoto-Taste gilt
const SI_COUNT: u64 = 14
// ============================================ RUNDE ALLTAG: DIE SPERRE
//
//   1870  osum_sperre(op, arg)
//
//     op 0  steht sie?           -> 0 oder 1
//     op 1  sperren              -> 0   (darf jeder: sich selbst
//                                        aussperren ist erlaubt)
//     op 2  aufsperren           -> 0 oder -EPERM
//     op 3  Leerlauf in ms       -> wie lange nichts eingegeben wurde
//     op 4  ich bin der Sperrer  -> 0 oder -EPERM
//     op 5  falscher Versuch     -> die neue Zahl
//     op 6  Zaehler lesen (arg: 0 Sperrungen, 1 Aufsperrungen,
//           2 Fehlversuche, 3 Neustarts des Sperrers, 4 Sperrer-PID)
//
// AUFSPERREN DARF NUR DER SPERRER, und das ist die ganze Sicherheit
// dieser Sache: das Kennwort prueft ein Programm in Ring 3
// (kernel/user/lock.fi, gegen /etc/shadow mit PBKDF2), aber WER das
// darf, entscheidet der Kern. Ein anderes Programm, das `op 2` ruft,
// bekommt -EPERM -- auch dann, wenn es das Kennwort kennt.
//
// SICH ZUM SPERRER MACHEN (op 4) geht nur, wenn es keinen gibt oder der
// eingetragene tot ist. Sonst koennte ein Programm sich waehrend der
// Sperre dazwischenschieben und danach aufsperren.
const SYS_OSUM_SPERRE: u64 = 1870

const CS_COUNT: u64 = 0 // wie viele Kerne die Firmware gemeldet hat
const CS_ONLINE: u64 = 1 // wie viele davon Firn-Code erreicht haben
const CS_UP: u64 = 2 // laeuft DIESER Kern
const CS_APICID: u64 = 3 // wie sein lokaler APIC sich nennt
const CS_TICKS: u64 = 4 // Zeitgeberschlaege, die er genommen hat
const CS_IDLE: u64 = 5 // davon im Leerlauf
const CS_SWITCHES: u64 = 6 // Aufgabenwechsel, die er gemacht hat
const CS_PICKS: u64 = 7 // Aufgaben, die er aus der Laufliste nahm
const CS_CURPID: u64 = 8 // Prozessnummer der Aufgabe, die auf ihm laeuft

// kind 1, above the six counters of `pmon.PT_*`.
const PT_PID: u64 = 6
const PT_ALIVE: u64 = 7 // 1 = the slot still holds a live task
const PT_KIND: u64 = 8 // `sched.K_*` -- which of them is the idle task
const PT_STATE: u64 = 9 // `sched.S_*`
const PT_SCHEDTICKS: u64 = 10 // what the SCHEDULER counted, unfiltered

// kind 5, what may be set.
const PS_ROLLDAY: u64 = 0 // move the day mark, after the file was written
const PS_RESET: u64 = 1 // throw the split away, keep the measured floor
const PS_EVERY: u64 = 2 // ticks between two samples
const PS_ONOFF: u64 = 3 // switch the accounting off and on again

// Die Felder von `osum_pwrget`. Die Nummern sind Teil der Schnittstelle
// nach Ring 3 und stehen genauso in `kernel/user/power.fi`.
const PG_READY: u64 = 0
const PG_PROFILE: u64 = 1
const PG_CAPS: u64 = 2
const PG_RATIOS: u64 = 3
const PG_RATIOSRC: u64 = 4
