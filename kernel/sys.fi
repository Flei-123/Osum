// ============================================================ RUNDE K14
//
// DREI LINUX-NUMMERN UND EINE EIGENE, und die Aufteilung folgt Regel 1
// der Karte oben: was Linux hat, hat Linux' Nummer.
//
//   165  mount(quelle, ziel, art, flaggen, daten)
//   166  umount2(ziel, flaggen)
//    82  rename(von, nach)
//
// Die drei GIBT es bei Linux, also waere jede andere Zahl eine
// Uebersetzungstabelle. `SYS_OSUM_MOUNT` (1401) aus Runde K11 bleibt
// daneben stehen und tut genau, was es tat -- der Auftrag dieser Runde
// sagt ausdruecklich, dass nichts entfernt wird, bevor der Ersatz
// gemessen ist.
//
// Und eine eigene, aus dem Hunderterblock, den diese Runde zugeteilt
// bekommen hat (1700..1799):
//
//   1700  osum_mntstat(index, feld) -- ein Feld eines Eintrags der
//         Einhaengetafel. Dieselbe Bauart wie SYS_OSUM_PSTAT von Runde
//         K6: eine Zahl je Aufruf, kein Puffer, kein Zeiger in den
//         Kernel. Damit kann ein Programm in Ring 3 die Tafel lesen,
//         ohne dass /proc dafuer stehen muss -- und der Testlauf kann
//         beide Wege gegeneinander halten.
// ================================================== RUNDE INSTALL
//
// ZWEI AUFRUFE, BEIDE MIT LINUX' NUMMER -- die erste Regel dieser Karte
// gilt weiter, und diese Runde braucht deshalb KEINEN eigenen
// Hunderterblock. Das ist die ehrliche Antwort auf die Frage, wo der
// naechste Block waere: unter 2000 ist keiner mehr frei, und beide
// Aufrufe gibt es bei Linux seit 1991.
//
//   `link`  ein ZWEITER NAME fuer dieselben Oktette. Ohne ihn kann ein
//           `opkg`, das AUF diesem System laeuft, `/apps` nicht bauen,
//           ohne jedes Paket ein zweites Mal auf die Platte zu legen.
//   `sync`  alles, was noch im Zwischenspeicher der Platte steht, auf
//           den Traeger. Ohne ihn ist "geschrieben" eine Aussage ueber
//           einen Zwischenspeicher, und ein Stromausfall haette recht.
const SYS_LINK: u64 = 86
const SYS_SYNC: u64 = 162
const SYS_MOUNT: u64 = 165
const SYS_UMOUNT2: u64 = 166
const SYS_RENAME: u64 = 82
const SYS_OSUM_MNTSTAT: u64 = 1700

// RUNDE K17: der USB-Baum, von Ring 3 aus. Der Vorrat dieser Runde ist
// 1700..1749; 1700 gehoert seit Runde K14 der Einhaengetafel, also faengt
// diese Runde bei 1701 an. ZWEI Nummern und keine dreissig: was Ring 3
// ueber USB wissen muss, ist eine Zahl je Frage, und was es TUN darf,
// ist genau eines -- das Abziehen nachstellen, damit die Zusage
// "abgezogen, und der Kern laeuft weiter" von aussen messbar wird.
const SYS_OSUM_USBSTAT: u64 = 1701 // (was) -> Zahl
const SYS_OSUM_USBPULL: u64 = 1702 // () -> wie oft abgezogen wurde
const USB_MINNR: u64 = 1701
const USB_MAXNR: u64 = 1702

