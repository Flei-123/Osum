// ============================================================ DIE KARTE
//
// WER WELCHEN ZAHLENBEREICH HAT. Drei Runden haben an diesem Repo
// gleichzeitig gearbeitet, und dreimal an einem Tag haben zwei von ihnen
// dieselbe Aufrufnummer genommen. Von hier an steht es aufgeschrieben,
// und die Regel ist die von Runde K4 geblieben:
//
//   * HAT LINUX DEN AUFRUF, DANN HAT ER LINUX' NUMMER. Das ist kein
//     Respekt, das ist Stufe 2 dieses Plans: ein statisch gebundenes
//     Linux-Programm legt seine Nummer in rax und fragt niemanden. Jede
//     abweichende Nummer waere eine Uebersetzungstabelle, die jemand
//     pflegen muss.
//   * HAT LINUX IHN NICHT, dann liegt die Nummer ueber 1000 -- weit ueber
//     allem, was Linux je vergeben wird -- und JEDE RUNDE HAT DORT EINEN
//     EIGENEN HUNDERTERBLOCK. Das ist die Stelle, an der sich zwei
//     Runden begegnen koennten, und deshalb ist sie geteilt:
//
//         1000..1099   Runden K1 und K6 (spawn, exec, sysinfo, pstat, kill)
//         1100..1199   RUNDE K9 -- Signale, Terminals, Zeit, Zufall
//         1200..1299   Runde K7 -- Bildschirm und Rahmenpuffer
//         1300..1399   Runde K8 -- Netz, soweit es ueber Sockets hinausgeht
//         1500..1599   RUNDE K12 -- Gastmaschinen (kernel/hv.fi). 1400 war
//                      beim Bau frei; Runde K11 hat sie parallel fuer
//                      setenv/mount genommen, der Merge hat K12 einen
//                      Hunderterblock weitergerueckt.
// ZU 1400, UND WARUM NICHT 140. Der Auftrag der Runde K12 sagte "neue
// Aufrufe fest ab Nummer 140 aufwaerts". 140 ist bei Linux
// `setpriority`, 141 `getpriority`, 158 `arch_prctl`, 186 `gettid` --
// und 186 hat Runde K9 bereits als `gettid`. Die erste Regel dieser
// Karte ist aelter als der Auftrag: was Linux hat, hat Linux' Nummer.
// Runde K12 nimmt deshalb den HUNDERTERBLOCK 1400 -- dieselbe 140, an
// der Stelle, an der dieser Kernel seine eigenen Aufrufe fuehrt.
//
//         1400..1499   RUNDE K11 -- Umgebung und Einhaengen
//         1800..1899   RUNDE K15 -- die Naht zur Widget-Bibliothek
//                      (kernel/wig.fi). Sieben Aufrufe, und keiner
//                      davon weiss, was ein Knopf ist.
//
// ZUR VORGABE "ab Nummer 120 aufwaerts" fuer Runde K11: auf DIESER Karte
// gelesen ist das der naechste freie EIGENE Hunderterblock, also 1400.
// Die 120 selbst ist Linux' `setresgid` und 121 `getpgid` -- letztere hat
// Runde K9 belegt. Eine eigene Bedeutung fuer eine Nummer, die Linux
// vergeben hat, waere genau die Uebersetzungstabelle, die Regel 1 oben
// vermeidet.
//         2000..2099   die native ABI aus OrientOS (kernel/cap.fi)
//
// WELCHE LINUX-NUMMERN RUNDE K9 BELEGT, damit K7 und K8 sie nicht noch
// einmal nehmen: 13, 14, 15, 16, 34, 37, 56, 62, 96, 109, 111, 112, 121,
// 127, 201, 202, 228, 229, 230, 234, 318. Keine davon liegt zwischen 41
// und 55 -- das ist der Block der Sockets, den Runde K8 braucht.
//
// ---------------------------------------------------------- the numbers

const SYS_READ: u64 = 0
const SYS_WRITE: u64 = 1
const SYS_OPEN: u64 = 2
const SYS_CLOSE: u64 = 3
const SYS_STAT: u64 = 4
const SYS_FSTAT: u64 = 5
// ======================================================== RUNDE OFS3
//
// VIER NUMMERN, UND ALLE VIER SIND DIE VON LINUX. Regel 1 der Karte
// oben: was Linux hat, hat Linux' Nummer -- jede eigene Zahl waere eine
// Uebersetzungstabelle, die jemand pflegen muss.
//
//     6  lstat(pfad, out)      wie `stat`, aber OHNE dem Verweis zu
//                              folgen. Ohne diesen Aufruf koennte kein
//                              Programm einen Verweis von seinem Ziel
//                              unterscheiden -- `ls -l` zeigte das
//                              Ziel, `rm` loeschte das Ziel.
//    88  symlink(ziel, wo)     einen Verweis anlegen.
//    89  readlink(pfad, buf, n) sein Ziel lesen. Gibt die Zahl der
//                              Oktette OHNE Null zurueck, wie POSIX es
//                              verlangt -- eine Null anzuhaengen ist
//                              Sache des Aufrufers.
//   280  utimensat(fd, pfad, zeiten, flaggen)  die Zeiten setzen.
//                              `touch` braucht ihn, und `tar -x` wird
//                              ihn brauchen, sobald es Zeiten aus dem
//                              Archiv zurueckspielt.
const SYS_LSTAT: u64 = 6
// ========================================================= RUNDE POLL
//
// EINE NUMMER, UND SIE IST DIE VON LINUX: 7. Regel 1 der Karte oben --
// was Linux hat, hat Linux' Nummer. Sie war frei; geprueft gegen die
// ganze Tafel dieser Datei UND gegen die von `lib/libc/kcall.fi`, und
// `tools/poll/run.sh`, Abschnitt 1, prueft es bei jedem Lauf noch
// einmal nach -- eine Nummer, die zwei Dinge bedeutet, ist ein
// Programm, das nach `poll` fragt und `lstat` bekommt. (Die 1320, die
// in einer frueheren Runde zweimal vergeben war, liegt weit weg von
// hier: sie gehoert SYS_OSUM_NETMON.)
//
//     poll(fds, nfds, timeout_ms)
//
// `fds` zeigt auf nfds mal `struct pollfd` -- acht Oktette, wie unter
// Linux: fd (i32) bei 0, events (i16) bei 4, revents (i16) bei 6.
// timeout unter null heisst: warte, bis wirklich etwas geschieht.
// Zurueck kommt die ZAHL der Deskriptoren mit einem Ereignis, 0 beim
// Zeitablauf, oder ein negativer Fehler.
const SYS_POLL: u64 = 7
// Die Bits von <poll.h>, und es sind die von Linux.
const POLLIN: u64 = 1
const POLLPRI: u64 = 2
const POLLOUT: u64 = 4
const POLLERR: u64 = 8
const POLLHUP: u64 = 16
const POLLNVAL: u64 = 32
// Wie viele Deskriptoren ein Aufruf ansehen darf. Ein Prozess hat
// hoechstens `file.MAX_FD` offene Dateien; mehr als das Doppelte davon
// zu erlauben waere eine Schleife, die ein Programm dem Kern schenken
// kann. Darueber: -EINVAL, wie Linux es bei mehr als RLIMIT_NOFILE tut.
const POLL_MAX: u64 = 32
const SYS_SYMLINK: u64 = 88
const SYS_READLINK: u64 = 89
const SYS_UTIMENSAT: u64 = 280
// Die zwei besonderen Nanosekundenwerte von `utimensat`, mit den Zahlen
// aus Linux' <sys/stat.h>.
const UTIME_NOW: u64 = 1073741823 // (1 << 30) - 1
const UTIME_OMIT: u64 = 1073741822 // (1 << 30) - 2
const SYS_LSEEK: u64 = 8
const SYS_MMAP: u64 = 9
const SYS_MUNMAP: u64 = 11
const SYS_BRK: u64 = 12
const SYS_PIPE: u64 = 22
const SYS_YIELD: u64 = 24 // sched_yield
const SYS_DUP: u64 = 32
const SYS_DUP2: u64 = 33
const SYS_NANOSLEEP: u64 = 35
const SYS_GETPID: u64 = 39
const SYS_FORK: u64 = 57
const SYS_EXECVE: u64 = 59
const SYS_EXIT: u64 = 60
const SYS_WAIT4: u64 = 61
const SYS_GETCWD: u64 = 79
// ROUND K6. Linux's number and Linux's meaning: a working directory
// per process, and `getcwd` above answers out of it now instead of
// answering "/".
const SYS_CHDIR: u64 = 80
const SYS_MKDIR: u64 = 83
const SYS_RMDIR: u64 = 84 // RUNDE ALLTAG
const SYS_UNLINK: u64 = 87
const SYS_GETPPID: u64 = 110
const SYS_GETDENTS64: u64 = 217
const SYS_EXIT_GROUP: u64 = 231

// ============================================================= RUNDE K9
//
// Die Nummern von Linux x86-64, fuer die Dinge, die jedes Unix-Programm
// stillschweigend voraussetzt und die dieser Kernel bis zu dieser Runde
// nicht hatte: Signale, ein Terminal, eine Uhr, Zufall.
const SYS_RT_SIGACTION: u64 = 13
const SYS_RT_SIGPROCMASK: u64 = 14
const SYS_RT_SIGRETURN: u64 = 15
const SYS_IOCTL: u64 = 16
const SYS_PAUSE: u64 = 34
const SYS_ALARM: u64 = 37
const SYS_CLONE: u64 = 56
const SYS_KILL: u64 = 62
const SYS_GETTIMEOFDAY: u64 = 96
const SYS_SETPGID: u64 = 109
const SYS_GETPGRP: u64 = 111
const SYS_SETSID: u64 = 112
const SYS_GETPGID: u64 = 121
const SYS_RT_SIGPENDING: u64 = 127
const SYS_TIME: u64 = 201
const SYS_FUTEX: u64 = 202
const SYS_GETTID: u64 = 186
const SYS_CLOCK_GETTIME: u64 = 228
const SYS_CLOCK_GETRES: u64 = 229
const SYS_CLOCK_NANOSLEEP: u64 = 230
const SYS_TGKILL: u64 = 234
const SYS_GETRANDOM: u64 = 318

// RUNDE LAUFZEIT: `arch_prctl`. Die eine Nummer, an der jedes gegen musl
// oder glibc gelinkte Programm haengt -- es setzt damit seinen
// Fadenzeiger, und ohne ihn ist `%fs:0x0` ein Zugriff auf die Null.
const SYS_ARCH_PRCTL: u64 = 158

// RUNDE LAUFZEIT, GEMESSEN: das sind die beiden Nummern, nach denen ein
// gegen musl gelinktes Programm fragt und die dieser Kern nicht hatte.
// Gefunden mit `fremdtrace` -- Lua rief sie, bekam -ENOSYS und schwieg
// deshalb: seine ganze Ausgabe geht durch `writev`.
const SYS_READV: u64 = 19
const SYS_WRITEV: u64 = 20
const SYS_SET_TID_ADDRESS: u64 = 218

// RUNDE LAUFZEIT, ZWEITER FUND (SQLite): ohne diese beiden kommt keine
// Datenbank auf. SQLite liest und schreibt AUSSCHLIESSLICH mit
// Positionsangabe (`pread`/`pwrite` in seinem Unix-VFS) und fragt vor
// dem ersten Zugriff mit `fcntl` nach einer Sperre.
// RUNDE FREMDLAND, GEMESSEN MIT `fremdtrace`: die beiden Nummern, nach
// denen busybox fragt, sobald es mehr tut als schreiben. `uname` steht in
// jedem zweiten Unix-Werkzeug (`uname -a`, aber auch in der Shell, die
// ihre Kennung meldet), `prctl` ruft musl beim Start JEDES Programms --
// es fragt nach PR_SET_NAME/PR_GET_DUMPABLE und kommt ohne die Antwort
// zurecht, aber die Nummer kam bis hierher bei jedem Aufruf ins
// Protokoll.
// RUNDE FREMDLAND: die beiden, ohne die musl keine Faeden macht.
// `clone` mit den Fadenflaggen ist `pthread_create`, `futex` ist die
// Sperre darunter -- musl benutzt sie AUCH BEI EINEM EINZIGEN Faden,
// sobald `libc.threaded` gesetzt ist.
const SYS_MPROTECT: u64 = 10
// Die Flaggen von `clone`, die ein Faden setzt (Linux `sched.h`).
const CLONE_VM: u64 = 0x100
const CLONE_FS: u64 = 0x200
const CLONE_FILES: u64 = 0x400
const CLONE_SIGHAND: u64 = 0x800
const CLONE_THREAD: u64 = 0x10000
const CLONE_SETTLS: u64 = 0x80000
const CLONE_PARENT_SETTID: u64 = 0x100000
const CLONE_CHILD_CLEARTID: u64 = 0x200000
const CLONE_SYSVSEM: u64 = 0x40000
// Die Unterbefehle von `futex`, die wirklich vorkommen.
const FUTEX_WAIT: u64 = 0
const FUTEX_WAKE: u64 = 1
const FUTEX_PRIVATE: u64 = 128
const FUTEX_CLOCK_RT: u64 = 256

const SYS_UNAME: u64 = 63
const SYS_PRCTL: u64 = 157

const SYS_PREAD64: u64 = 17
const SYS_PWRITE64: u64 = 18
const SYS_FCNTL: u64 = 72
// Die Unterbefehle von `fcntl`, die wirklich gebraucht werden.
const F_DUPFD: u64 = 0
const F_GETFD: u64 = 1
const F_SETFD: u64 = 2
const F_GETFL: u64 = 3
const F_SETFL: u64 = 4
const F_SETLK: u64 = 6
const F_SETLKW: u64 = 7
const F_GETLK: u64 = 5
const F_DUPFD_CLOEXEC: u64 = 1030
// RUNDE FREMDLAND: die Arten einer Sperre und der Aufbau von `struct
// flock`, so wie Linux x86-64 sie legt.
const F_RDLCK: u64 = 0
const F_WRLCK: u64 = 1
const F_UNLCK: u64 = 2
// struct flock: l_type(2) l_whence(2) [4 Fuellung] l_start(8) l_len(8)
// l_pid(4) -- 32 Oktette.
const FL_TYPE: u64 = 0
const FL_WHENCE: u64 = 2
const FL_START: u64 = 8
const FL_LEN: u64 = 16
const FL_PID: u64 = 24
const FL_BYTES: u64 = 32
// Die Felder eines Eintrags in der Sperrtafel (kstate.FLOCK_BYTES = 48).
const L_INO: u64 = 0
const L_VON: u64 = 8
const L_BIS: u64 = 16   // letztes Oktett, EINSCHLIESSLICH
const L_ART: u64 = 24
const L_PID: u64 = 32
const L_MNT: u64 = 40
const ARCH_SET_FS: u64 = 0x1002
const ARCH_GET_FS: u64 = 0x1003

// Und die drei, die Linux nicht hat, im Hunderterblock dieser Runde:
//   1100 openpty(aus)   -> legt ein Paar aus Steuer- und Nutzerseite an
//                          und schreibt zwei Deskriptoren nach `aus`
//   1101 ttyinfo(was)   -> eine Zahl ueber die Terminalschicht
//   1102 siginfo(was)   -> eine Zahl ueber die Signalschicht
// RUNDE K12. Fuenf Aufrufe fuer Gastmaschinen. Sie arbeiten auf HANDLES
// aus `cap.fi` (Art `K_VM`) und nicht auf einer Zahl, die man raten
// koennte -- und sie antworten deshalb in der Fehlersprache DER HANDLES
// (`cap.err`, negativ) und nicht in der von POSIX. Zwei ABIs, zwei
// Listen; eine gemeinsame waere eine Luege ueber beide.
const SYS_VM_CREATE: u64 = 1500 // (gast, rechte) -> Handle
const SYS_VM_RUN: u64 = 1501 // (h) -> Grund des Anhaltens, braucht R_WRITE
const SYS_VM_STAT: u64 = 1502 // (h, aus) -> 0, braucht R_INSPECT
const SYS_VM_KILL: u64 = 1503 // (h) -> 0, braucht R_MANAGE
const SYS_VM_VALUE: u64 = 1504 // (h, nr) -> gemeldeter Wert, braucht R_READ
const SYS_OSUM_PTY: u64 = 1100
const SYS_OSUM_TTYINFO: u64 = 1101
const SYS_OSUM_SIGINFO: u64 = 1102

// ROUND K8. THE SOCKET CALLS, and again Linux's numbers and Linux's
// shapes -- there is no `send` and no `recv` in the x86-64 table,
// because glibc turns both into `sendto`/`recvfrom` with a null address.
// Copying that means a Linux binary of stage 2 needs no translation, and
// it means `ping` and `wget` in `kernel/user/` are written the way they
// would be written anywhere else.
const SYS_SOCKET: u64 = 41
const SYS_CONNECT: u64 = 42
const SYS_ACCEPT: u64 = 43
const SYS_SENDTO: u64 = 44
const SYS_RECVFROM: u64 = 45
const SYS_SHUTDOWN: u64 = 48
const SYS_BIND: u64 = 49
const SYS_LISTEN: u64 = 50
const SYS_GETSOCKNAME: u64 = 51
const SYS_GETPEERNAME: u64 = 52
const SYS_SETSOCKOPT: u64 = 54
const SYS_GETSOCKOPT: u64 = 55
const SYS_ACCEPT4: u64 = 288

// `struct sockaddr_in`: sixteen octets, the family in the byte order of
// the machine, the port and the address in the byte order of the WIRE.
// That mixture is not a mistake of this kernel, it is what the interface
// has looked like since 4.2BSD, and a program that assumes anything else
// would not work on Linux either.
const AF_INET: u64 = 2
const SA_BYTES: u64 = 16
const SOCK_STREAM: u64 = 1
const SOCK_DGRAM: u64 = 2
// The two flags Linux packs into the TYPE argument (and into `accept4`).
const SOCK_NONBLOCK: u64 = 2048 // 0o4000
const SOCK_CLOEXEC: u64 = 524288 // 0o2000000
const IPPROTO_ICMP: u64 = 1
const IPPROTO_TCP: u64 = 6
const IPPROTO_UDP: u64 = 17
const SHUT_RD: u64 = 0

// How long a blocking socket call waits before it gives up with
// -EAGAIN. Bounded for the same reason `BLOCK_ROUNDS` is: a measurement
// that ends in the time limit of the shell script measures nothing, and
// a kernel that cannot say why it stopped is worse than one that stops.
// 100 Hz, so this is thirty seconds.
const NET_ROUNDS: u64 = 3000

// The two marks of round 59, alive only during the excursion of `user.fi`.
const SYS_MARK: u64 = 1
const SYS_LEAVE: u64 = 2

// What Osum has and Linux has not. Far above the Linux table on purpose:
// a number that could one day BE a Linux call would be a trap for stage 2.
//
//   1000 spawn(program, argument) -- a process out of `uprog.fi`, the
//        programs that travel in the kernel image. There is no file
//        behind them, so no `execve` can start them.
//   1001 exec(path, argv, argc) -> pid -- the `posix_spawn` of round K1.
//        `fork` + `execve` do the same thing in two calls now and the
//        shell uses those; this one stays because it is one call, and a
//        system with 16 KiB of kernel stack per task has a use for that.
const SYS_OSUM_SPAWN: u64 = 1000
const SYS_OSUM_EXEC: u64 = 1001
// ROUND K6. Three that Linux HAS NO NUMBER FOR, in the shape this
// kernel can answer them, and therefore above 1000 by the rule of
// round K4 -- round K6 itself had picked 44, 45 and 46, which are
// `semget`, `semop` and `shmdt` on Linux and would be a trap for the
// stage that runs a Linux binary.
//
//   1002 sysinfo(what) -> one number about the machine. Linux's 99
//        fills a struct with a different set of fields; this is not
//        that call and does not take its number.
//   1003 pstat(index, field) -> one field of one slot of the task
//        table. There is no `/proc` here, and `ps` may not hold a
//        pointer into the kernel.
//   1004 kill(pid, code). NOT Linux's 62: there are no signals in
//        this system, so the second argument is the exit code the
//        process is made to leave with, not a signal number. The day
//        signals exist, 62 becomes the real `kill` and this one goes.
// ---------------------------------------------- die native ABI (cap.fi)
//
// Die zweite ABI dieses Kernels, portiert aus OrientOS
// (`libs/osum-abi-native/src/syscall.rs`). Sie ist NICHT POSIX und will
// es nicht sein: kein globaler Namensraum, keine geerbten Deskriptoren,
// kein errno -- jeder Zugriff laeuft ueber ein Handle mit Rechten
// (`kernel/cap.fi`).
//
// WARUM 2000 UND NICHT 0. OrientOS zaehlt seine nativen Aufrufe ab 0, und
// 0/1/2 sind hier `read`, `write` und `open` von Linux. Beide Zaehlungen
// koennen nicht in demselben Register stehen, also bekommt die native ABI
// einen Sockel -- nach derselben Regel, die Runde K4 fuer alles
// aufgestellt hat, was Linux nicht hat (Nummern >= 1000). Die Nummer
// innerhalb der ABI bleibt damit die von OrientOS: 2000 + n.
//
// WAS ES HIER NOCH NICHT GIBT: Kanaele, Ports, Namensraeume, Spawn mit
// Handle-Liste, Speicherobjekte. Die stehen in OrientOS' Rust-Kernel und
// sind in KERNELWECHSEL.md als offener Punkt benannt. Sie geben hier
// -E_UNSUPPORTED und nicht -ENOSYS: der Aufruf EXISTIERT in dieser ABI,
// dieser Kernel bietet ihn nur nicht an.
const CAP_BASE: u64 = 2000
const CAP_VERSION: u64 = 2000 // () -> Fassung der ABI
const CAP_READ: u64 = 2001 // (h, buf, len) -> Oktette, braucht R_READ
const CAP_WRITE: u64 = 2002 // (h, buf, len) -> Oktette, braucht R_WRITE
const CAP_CLOSE: u64 = 2003 // (h) -> 0
const CAP_DUP: u64 = 2004 // (h, maske) -> Handle, braucht R_DUPLICATE
const CAP_INSPECT: u64 = 2005 // (h, aus) -> 0, braucht R_INSPECT
const CAP_TRANSFER: u64 = 2006 // (h, maske, pid) -> Handle, braucht R_TRANSFER
const CAP_COUNT: u64 = 2007 // () -> belegte Plaetze der eigenen Tabelle
const CAP_MAXNR: u64 = 2007

// ------------------------------------------------- RUNDE HANDLE: 2200
//
// DIE HANDLE-SCHICHT VON AUSSEN. Elf Aufrufe, und sie sind nicht dazu
// da, dass ein gewoehnliches Programm sie benutzt -- der Deskriptorpfad
// von POSIX laeuft seit dieser Runde von SELBST ueber Handles, ohne dass
// ein Programm etwas davon merkt. Sie sind dazu da, dass die Zusagen
// dieser Runde AUS RING 3 nachpruefbar sind, und dafuer, dass der Ring
// (Runde RING) sie spaeter als seine Einreich- und Abbruchschnittstelle
// benutzen kann.
//
// Der Sockel ist 2200 und nicht 2114: der Fensterserver hat ab 2100
// einen eigenen Block, und `native` verteilt nach GROESSER-GLEICH. Wer
// eine Nummer dazwischen nimmt, landet beim Fensterserver.
//
// HND_OBJINFO ist AUSDRUECKLICH nur im Selbsttestmodus (`handle` auf der
// Kommandozeile) da. Es gibt Innenzahlen des Kernels heraus -- wie viele
// Verweise ein Objekt hat, ob ein Eintrag der offenen Dateien noch lebt
// --, und das ist kein Wissen, das ein Programm im Regelbetrieb haben
// soll. Ohne das Wort gibt es -E_UNSUPPORTED. Ein Testfenster, das im
// Regelbetrieb offen bleibt, ist eine Hintertuer.
const HND_BASE: u64 = 2200
const HND_VERSION: u64 = 2200 // () -> Fassung dieser Schnittstelle
const HND_FDH: u64 = 2201 // (fd) -> das Handle hinter einem Deskriptor
const HND_RIGHTS: u64 = 2202 // (fd) -> dessen Rechte
const HND_BEGIN: u64 = 2203 // (h, rechte) -> Abbruch-Token
const HND_OBJECT: u64 = 2204 // (token) -> Objektnummer, oder -E_STALE
const HND_CANCEL: u64 = 2205 // (token) -> 0
const HND_END: u64 = 2206 // (token) -> 1 = dabei abgeraeumt
const HND_STATE: u64 = 2207 // (token) -> Zustand des Auftrags
const HND_DUP: u64 = 2208 // (fd, maske) -> Deskriptor mit WENIGER Rechten
const HND_PASS: u64 = 2209 // (pid, fd, maske, zielfd) -> Deskriptor im Kind
const HND_COUNT: u64 = 2210 // () -> belegte Handle-Plaetze
const HND_OBJINFO: u64 = 2211 // (was, arg) -> Innenzahl, nur mit `handle`
const HND_MAXNR: u64 = 2211

// ------------------------------------------- RUNDE ASYNC: 1980..1985
//
// DIE ASYNCHRONE AUFTRAGSSCHICHT VON AUSSEN. Sechs Aufrufe.
//
// WARUM SIE IM POSIX-ZAHLENRAUM STEHEN UND NICHT BEI DEN 2200ern. Was
// sie zurueckgeben, sind POSIX-Ergebnisse: eine Oktettzahl von `read`,
// ein Deskriptor von `open`, -EBADF, -EAGAIN. Eine Nummer im Block der
// nativen ABI wuerde versprechen, dass auch die Fehler die der nativen
// ABI sind -- und das waere eine Luege ueber beide Listen. Die Handle-
// Schicht darunter behaelt ihre eigene Zaehlung; wo ein Fehler von dort
// nach hier durchkommt, wird er UEBERSETZT (`aio_errno`) und nicht
// durchgereicht.
//
// 1980 aufwaerts war frei: der hoechste vergebene Osum-Aufruf davor ist
// SYS_OSUM_WGSET (1951), und CAP_BASE faengt bei 2000 an -- der Block
// liegt also ganz im POSIX-Teil der Weiche.
//
//     aio_submit(op, fd, buf, len, udata) -> Kennung, oder -E
//     aio_wait(aus, max, tmo_ms, mindest) -> Zahl der Meldungen
//     aio_cancel(kennung)                 -> 0, oder -E
//
// Eine Fertigmeldung sind vier Worte (32 Oktett): Kennung, die Kennzahl
// des Programms, das Ergebnis, die Art. Genau dieses Format bekommt in
// Runde RING der Completion-Ring; wer heute `aio_wait` benutzt, muss
// dafuer nichts umschreiben ausser dem Abholweg.
const AIO_BASE: u64 = 1980
const AIO_VERSION: u64 = 1980 // () -> Fassung dieser Schnittstelle
const AIO_SUBMIT: u64 = 1981 // (art, fd, puffer, laenge, kennzahl)
const AIO_WAIT: u64 = 1982 // (aus, max, tmo_ms, mindestens) -> Zahl
const AIO_CANCEL: u64 = 1983 // (kennung) -> 0
const AIO_STATE: u64 = 1984 // (kennung) -> Zustand des Auftrags
const AIO_INFO: u64 = 1985 // (was, arg) -> Innenzahl, nur mit `async`
const AIO_MAXNR: u64 = 1985

// RUNDE ASYNC, und sie ist der Massstab: `fsync` gab es bis hierher gar
// nicht. Ohne ihn haette die asynchrone Fassung nichts, wogegen sie zu
// messen waere -- und ein Dateisystem ohne `fsync` hat keine Zusage
// gegen den Stromausfall, nur eine Hoffnung.
const SYS_FSYNC: u64 = 74

// ---------------------------------------------------- Runde K10: Fenster
//
// Neun Aufrufe, und sie reichen fuer eine Anwendung mit Oberflaeche:
// eine Flaeche bekommen, darauf malen, Text setzen, Ereignisse abholen,
// sich verschieben, zumachen.  Jeder braucht ein HANDLE, und jeder
// prueft das RECHT, das zu ihm gehoert -- malen ist R_WRITE, Ereignisse
// abholen ist R_READ, verschieben und schliessen ist R_MANAGE.
const WM_BASE: u64 = 2100

// The four edges. Identical numbers in kernel/wm.fi, in wlibc.fi, in
// /bin/taskbar and in /bin/settings -- one set of numbers, no table.
const WE_BOTTOM: u64 = 0
const WE_TOP: u64 = 1
const WE_LEFT: u64 = 2


// ---------------------------------------------------- RUNDE K15
//
// DIE NAHT ZUR WIDGET-BIBLIOTHEK. Sieben Aufrufe, alle klein, und der
// Grund fuer jeden steht in `kernel/wig.fi`. Sie liegen bei 1800 und
// nicht in der nativen ABI bei 2100, weil sie KEINE Autoritaet
// verteilen: eine Glyphe, eine Unterschneidung und die Zwischenablage
// sind kein Fenster. Der einzige, der ein Handle braucht, ist der, der
// in ein Fenster schreibt -- WIG_BLIT.
const WIG_BASE: u64 = 1800
const WIG_BLIT: u64 = 1800 // (h, xy, wh, quelle, zeilenlaenge) -> Bildpunkte
const WIG_MAXNR: u64 = 1809


const SYS_OSUM_SYSINFO: u64 = 1002
const SYS_OSUM_PSTAT: u64 = 1003
const SYS_OSUM_KILL: u64 = 1004

// ---------------------------------------------------------- Runde K11
//
// `setenv(buf, len)` legt den Umgebungsblock fest: `len` Oktette, darin
// `len` Zeichenketten der Form NAME=wert, jede mit einer Null dahinter.
// Jedes Programm, das danach gestartet wird, findet ihn auf seiner
// Argumentseite (`kernel/elf.fi`, `write_env`).
//
// `mount(op, 0, 0)`: 0 fragt nach (1 = eingehaengt), 1 haengt ein,
// 2 haengt aus. Mehr gibt es nicht zu sagen -- dieses System hat EIN
// Dateisystem auf EINER Platte, und ein `mount` mit Geraetenamen und
// Typen waere eine Behauptung ueber etwas, das es nicht gibt.
// ----------------------------------------------- RUNDE DESKTOP: das Netz
//
// Der Hunderterblock 1300..1399 gehoert seit Runde K8 dem Netz "soweit
// es ueber Sockets hinausgeht" und war bis heute LEER: die Adresse
// wurde in `inet.init` festgenagelt, und kein Programm konnte sie
// lesen oder aendern. Ein DHCP-Klient in Ring 3 kann ohne diese beiden
// Aufrufe nichts tun -- er bekommt eine Adresse angeboten und hat
// keinen Weg, sie dem Kernel zu sagen.
//
// SETZEN DARF NUR DIE WURZEL. Eine Adresse, die jeder Prozess aendern
// kann, ist keine Konfiguration, sondern eine Einladung.
const SYS_OSUM_NETGET: u64 = 1300 // (was) -> Zahl
const SYS_OSUM_NETSET: u64 = 1301 // (ip, maske, gateway) -> 0

// Was NETGET beantwortet.
const NG_READY: u64 = 0 // 1 = der Stapel laeuft
const NG_IP: u64 = 1
const NG_MASK: u64 = 2
const NG_GW: u64 = 3
const NG_MAC0: u64 = 4 // die ersten vier Oktette der Hardwareadresse
const NG_MAC1: u64 = 5 // die letzten zwei
const NG_IN: u64 = 6 // Rahmen herein
const NG_OUT: u64 = 7 // Rahmen hinaus

// ======================================= RUNDE NETVIEW, NACHTRAG
//
// DER ZUSTAND DER MASCHINE, in EINER Zahl, damit die Taskleiste ein
// Symbol dafuer malen kann. Vier Stufen, und sie steigen: jede setzt
// die davor voraus.
//
//   0 kein Traeger   keine Karte, oder nichts eingesteckt
//   1 keine Adresse  der Draht ist da, eine IP nicht (DHCP laeuft noch)
//   2 kein Weg       eine IP ist da, das Gateway hat nie geantwortet --
//                    das ist Windows' "verbunden, kein Internet", eine
//                    Sprungweite frueher und ohne eigenen Suchverkehr
//   3 verbunden      IP da, und das Gateway hat auf ARP geantwortet
//
// KABEL ODER FUNK WIRD NICHT UNTERSCHIEDEN, und das ist keine
// Nachlaessigkeit: es gibt in diesem Baum keine einzige Zeile 802.11.
// Ein Funksymbol fuer etwas, das es nicht gibt, waere in einer Runde
// ueber das Nichtluegen die falscheste aller Abkuerzungen. Kommt Funk,
// kommt hier eine Zahl dazu.
const NG_STATE: u64 = 8

// ============================================ RUNDE ECHTHARDWARE-1
// WIE WEIT IST DER DHCP-KLIENT GEKOMMEN?
//
// Justins Foto vom 09.09. zeigt auf der Tafel:
//
//     22 NETZ  K3 BDF 0900 L 1 ABL 0 IP 169.254.10.1
//
// Treiber da (K3 = r8169), Kabel da (L 1), und trotzdem die feste
// Adresse von der Kommandozeile. Aus dieser Zeile laesst sich NICHT
// entscheiden, woran es lag: kein DISCOVER hinaus? Kein OFFER herein?
// Ein NAK? Der Klient meldet das alles -- auf die SERIELLE LEITUNG,
// und genau die hat sein Brett nicht (LSR FF, Runde KABEL).
//
// Also legt der Klient seinen Fortschritt ab, wo die Tafel ihn lesen
// kann. Vier Zahlen, mehr braucht es nicht:
//
//   NG_DHCPST   0 gar nicht gelaufen  1 DISCOVER gesendet
//               2 OFFER bekommen      3 REQUEST gesendet
//               4 ACK -- Adresse steht    5 aufgegeben (Zeitablauf)
//               6 NAK vom Server
//   NG_DHCPTX   wie viele Pakete wirklich hinausgingen
//   NG_DHCPRX   wie viele Antworten hereinkamen
//   NG_DHCPTRY  der wievielte Versuch gerade laeuft
//
// DAMIT IST DIE DIAGNOSE AUS EINEM FOTO MOEGLICH: TX 0 heisst, der
// Stapel liess nichts hinaus (ARP fuer den Rundruf, siehe Kopf von
// dhcp.fi). TX>0 RX 0 heisst, es ging hinaus und niemand antwortete.
// D 2 mit TX>0 heisst, das Angebot kam und der REQUEST blieb liegen.
const NG_DHCPST: u64 = 9
const NG_DHCPTX: u64 = 10
const NG_DHCPRX: u64 = 11
const NG_DHCPTRY: u64 = 12
// Und die Gegenrichtung: der Klient MELDET seinen Zustand.
const SYS_OSUM_DHCPST: u64 = 1302

// ZWEITER NACHTRAG: die vier Stufen stehen jetzt in
// `kernel/netview.fi`, weil sie dort auch gerechnet werden. Hier waeren
// sie eine zweite Fassung derselben vier Zahlen.

// ====================================================== RUNDE NETVIEW
//
// DIE NETZSICHT EINES PROZESSES. Drei Nummern aus demselben Block, den
// Runde K8 fuer das Netz ausgewiesen hat.
//
//   NETVGET(pid, was)             -> Zahl        jeder darf fragen
//   NETVSET(pid, sicht, flags)    -> 0           `netview.may_set`
//   NETVALLOW(pid, adresse, pp)   -> 0           dito
//
// `pid` 0 heisst "ich selbst". `pp` ist (port << 16) | praefix.
// FRAGEN DARF JEDER, und das ist keine Nachlaessigkeit: der Grundsatz
// dieser Runde ist, dass GETAEUSCHT WIRD DAS PROGRAMM, NIE DER MENSCH
// DAVOR -- eine Sicht, die der Benutzer nicht auslesen koennte, waere
// eine Luege an den Benutzer.
const SYS_OSUM_NETVGET: u64 = 1310
const SYS_OSUM_NETVSET: u64 = 1311
const SYS_OSUM_NETVALLOW: u64 = 1312

// Was NETVGET beantwortet.
const NV_MODE: u64 = 0 // 0 real, 1 filtered, 2 faked, 3 none
const NV_ALLOWN: u64 = 1 // wie viele Eintraege die Liste hat
const NV_ALLOW: u64 = 2 // 2..7: Eintrag 0..5, roh
const NV_DROPPED: u64 = 8 // Oktette, die vorgetaeuschte Steckdosen
                          // geschluckt haben, seit dem Start
const NV_OPENED: u64 = 9 // vorgetaeuschte Verbindungen
const NV_DENIED: u64 = 10 // Versuche mit -ENETUNREACH beantwortet
const NV_REPLIES: u64 = 11 // gebaute Antworten (204, DNS, ICMP)
const NV_PID: u64 = 12 // die pid, die NETVGET gerade gelesen hat
// ZWEITER NACHTRAG: die systemweite Voreinstellung. Drei Auskuenfte und
// nicht eine, weil `fbview` allein nicht sagt, WARUM es das sagt.
const NV_FALLBACK: u64 = 13 // 0 off, 1 when-offline, 2 always
const NV_FBVIEW: u64 = 14 // die Sicht, die ein Programm OHNE eigene
                          // Einstellung JETZT bekaeme
const NV_LINK: u64 = 15 // der Zustand der Maschine, ungefiltert

// SETZEN DARF NUR EUID 0. Es ist die einzige Einstellung dieser Runde,
// die ALLE Prozesse betrifft; ein Programm, das sie selbst umlegen
// duerfte, koennte jedem anderen sein Netz nehmen.
const SYS_OSUM_NETVFB: u64 = 1313

// ============================== RUNDE NETVIEW, DRITTER NACHTRAG
//
// EIN TASTENKUERZEL, DAS KEIN FENSTER HAT. Der Fensterserver gibt eine
// Taste dem Fenster MIT DEM EINGABEFOKUS (`wm.on_key`); die Taskleiste
// ist absichtlich nie dieses Fenster, und ein Kuerzel, das nur wirkt,
// wenn man vorher die Leiste anklickt, waere keines. Die Tastatur
// SCHREIBT den Druck deshalb auf (`kbd.fi`), und wer will, liest ihn:
//
//   HOTKEY(0) -> Zaehler   um eins hoeher als beim letzten Druck
//   HOTKEY(1) -> Zeichen   welcher Buchstabe es war
//   HOTKEY(2) -> ns        die monotone Uhr IM AUGENBLICK DES DRUCKS
//   HOTKEY(3) -> 1/0       wird die Taste gerade gehalten
//
// FRAGEN DARF JEDER. Es ist die Auskunft "es wurde Super+A gedrueckt",
// und die hat jedes Programm, das den Fokus hat, ohnehin schon.
//
// ROUND MERGE: the number was 1320 on branch `netview` and 1320 on
// branch `netmon` as well. It is 1314 here -- the free slot right after
// this round's own 1310..1313 -- because NETMON's 1320 has a userland
// ABI beside it (1321 NETMONROLL, 1322 SHARE, lib/libc/kcall.fi) and
// this one does not.
const SYS_OSUM_HOTKEY: u64 = 1314
const HK_SEQ_Q: u64 = 0
const HK_KEY_Q: u64 = 1
const HK_NS_Q: u64 = 2
const HK_DOWN_Q: u64 = 3

// ======================================================= ROUND NETMON
//
// WHO USED HOW MUCH. One number per call, the way `PSTAT` has answered
// about the task table since round K6 -- no buffer, no pointer into the
// kernel, nothing a program could be handed and misread.
//
//   NETMON(kind, index, field) -> number
//
//     kind 0  the scalars of the whole machine (index ignored)
//     kind 1  a task: the six counters, its pid, whether it is alive
//     kind 2  a socket: the live connection list `netstat` prints
//     kind 3  one octet of the program name of a task
//
// READING IS ALLOWED FOR ANYBODY, exactly as with NETVGET and for the
// same reason: a machine that will not tell the person which of their
// own programs is using the line is not protecting anybody.
const SYS_OSUM_NETMON: u64 = 1320

// kind 0 -- the machine.
const NM_ON: u64 = 0 // 1 = the counters are running
const NM_LOOKUPS: u64 = 1 // frames classified
const NM_HITS: u64 = 2 // frames placed on a process
const NM_MISSES: u64 = 3 // frames that went to the system bucket
const NM_SYSTX: u64 = 4 // octets of those, outbound
const NM_SYSRX: u64 = 5 // and inbound
const NM_TICKS: u64 = 6 // the tick counter, for rates
const NM_HZ: u64 = 7 // ticks per second
const NM_CARDTX: u64 = 8 // what the CARD counted, out
const NM_CARDRX: u64 = 9 // and in
const NM_NTASK: u64 = 10 // how many task slots there are
const NM_NSOCK: u64 = 11 // and socket slots
const NM_NPROG: u64 = 12 // and program slots

// kind 1 -- a task. 0..5 are `netmon.T_*` in that order.
const NT_PID: u64 = 6
const NT_ALIVE: u64 = 7
const NT_VIEW: u64 = 8 // the netview mode of round NETVIEW
const NT_STATE: u64 = 9

// kind 2 -- a socket. 0..11 are `netmon.S_*` in that order.
const NS_TCPSTATE: u64 = 12
const NS_AGE: u64 = 13 // ticks since the slot was taken

// kind 4 -- a PROGRAM. 0..5 are the same six counters, summed over every
// task that ever ran that program in this boot. This is the row the
// person actually reads: `wget` used this much, whether or not the wget
// that used it is still running.
const NP_USED: u64 = 6

// AND THE ONE CALL OF THIS ROUND THAT CHANGES SOMETHING.
//
//   NETMONROLL(program, field) -> what has been used since the last roll
//
// It hands out the difference and moves the watermark in the same
// breath, so that `/bin/netstat -w` can add it to today's line in
// `/var/net/usage` and nothing is counted twice or lost. ROOT ONLY, and
// that is not decoration: a program that could roll its own counters
// could empty them, and the history would then say it used nothing.
const SYS_OSUM_NETMONROLL: u64 = 1321

// ============================================ ROUND NETMON, PART TWO
//
//   SHARE(what, index) -> number
//
// Everything the sharing of `kernel/share.fi` will tell a program:
// whether it is on, what the shared side's address and pool are, and
// one row per connected device. Reading is allowed for anybody, for the
// same reason as everywhere else in this round -- the person has a
// right to know which devices are hanging off their machine.
//
// SWITCHING IT ON AND OFF IS ROOT ONLY (`SH_SET`). Anything else and
// any process could hand this machine's connection to the room.
const SYS_OSUM_SHARE: u64 = 1322

const SH_ON: u64 = 0 // 1 = the connection is being handed on
const SH_SET: u64 = 1 // (index = 0 or 1) switch it -- euid 0
const SH_IP: u64 = 2 // this machine's address on the shared side
const SH_MASK: u64 = 3
const SH_P0: u64 = 4 // the first address handed out
const SH_P1: u64 = 5 // and the last
const SH_NCLIENT: u64 = 6 // how many devices are known
const SH_CLIENT: u64 = 7 // (index) 1 = that slot is in use
const SH_CMAC: u64 = 8 // its hardware address, six octets in one word
const SH_CIP: u64 = 9 // and the address it was given
const SH_CIN: u64 = 10 // octets it sent
const SH_COUT: u64 = 11 // and octets it received
const SH_NAT: u64 = 12 // records in the NAT table right now
const SH_STAT: u64 = 13 // (index) one of `share.S_*`
const SH_UPLINK: u64 = 14
const SH_SHARED: u64 = 15

const SYS_OSUM_SETENV: u64 = 1400
const SYS_OSUM_MOUNT: u64 = 1401

