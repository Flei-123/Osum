// unmittelbar gebraucht (ein Geraet, das ein TERMINAL oder der
// RAHMENPUFFER ist, bekommt den Deskriptor, den es seit Runde K7/K9
// bekommt -- und nicht einen neuen, der dasselbe noch einmal koennte).
import vfs
import mnt
import vfsops
import devfs
import part
import blk
// RUNDE INSTALL: `sync` schreibt auch die FSInfo-Seite von FAT32.
import fat
import usb

export {
    entry, neg, STAT_BYTES, DIRENT_HEAD,
    O_WRONLY, O_RDWR, O_CREAT, O_EXCL, O_TRUNC, O_APPEND, O_DIRECTORY,
    SEEK_SET, SEEK_CUR, SEEK_END, WNOHANG,
    PROT_EXEC, MAP_PRIVATE, MAP_ANONYMOUS, BRK_BASE, MMAP_TOP,
    SYS_READ, SYS_WRITE, SYS_OPEN, SYS_CLOSE, SYS_STAT, SYS_FSTAT,
    SYS_LSEEK, SYS_MMAP, SYS_MUNMAP, SYS_BRK, SYS_PIPE, SYS_YIELD,
    SYS_DUP, SYS_DUP2, SYS_NANOSLEEP, SYS_GETPID, SYS_FORK, SYS_EXECVE,
    SYS_EXIT, SYS_WAIT4, SYS_GETCWD, SYS_MKDIR, SYS_UNLINK, SYS_GETPPID,
    SYS_GETDENTS64, SYS_EXIT_GROUP, SYS_OSUM_SPAWN, SYS_OSUM_EXEC,
    SYS_CHDIR, SYS_OSUM_SYSINFO, SYS_OSUM_PSTAT, SYS_OSUM_KILL,
    SYS_RT_SIGACTION, SYS_RT_SIGPROCMASK, SYS_RT_SIGRETURN, SYS_IOCTL,
    SYS_PAUSE, SYS_ALARM, SYS_CLONE, SYS_KILL, SYS_GETTIMEOFDAY,
    SYS_SETPGID, SYS_GETPGRP, SYS_SETSID, SYS_GETPGID, SYS_RT_SIGPENDING,
    SYS_TIME, SYS_FUTEX, SYS_GETTID, SYS_CLOCK_GETTIME, SYS_CLOCK_GETRES,
    SYS_CLOCK_NANOSLEEP, SYS_TGKILL, SYS_GETRANDOM,
    SYS_OSUM_PTY, SYS_OSUM_TTYINFO, SYS_OSUM_SIGINFO,
    SYS_VM_CREATE, SYS_VM_RUN, SYS_VM_STAT, SYS_VM_KILL, SYS_VM_VALUE,
    SYS_OSUM_SETENV, SYS_OSUM_MOUNT,
    SYS_MOUNT, SYS_UMOUNT2, SYS_RENAME, SYS_OSUM_MNTSTAT,
    SYS_LINK, SYS_SYNC,
    SYS_OSUM_FTYPE, SYS_OSUM_FOPEN, SYS_OSUM_FLIST, SYS_OSUM_FREG,
