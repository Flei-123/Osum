const O_DIRECTORY: u64 = 65536 // 0o200000

const SEEK_SET: u64 = 0
const SEEK_CUR: u64 = 1
const SEEK_END: u64 = 2

const WNOHANG: u64 = 1

// ROUNDE K7: die beiden anderen Schutzbits. `mmap` auf /dev/fb liest
// PROT_WRITE, um zu entscheiden, ob die Kachel beschreibbar wird.
const PROT_READ: u64 = 1
const PROT_WRITE: u64 = 2
const PROT_EXEC: u64 = 4
const MAP_PRIVATE: u64 = 2
const MAP_ANONYMOUS: u64 = 32

// The file kinds of `struct stat`, as Linux writes them.
const S_IFDIR: u64 = 16384 // 0o40000
const S_IFREG: u64 = 32768 // 0o100000
const S_IFCHR: u64 = 8192 // 0o20000
// ROUNDE K14: ein BLOCKGERAET. /dev/hda ist keines von den drei
// Dingen, die dieser Kernel bisher kannte, und `ls -l` unterscheidet
// sie an genau diesem Feld.
const S_IFBLK: u64 = 24576 // 0o60000
const S_IFIFO: u64 = 4096 // 0o10000
// RUNDE OFS3: der symbolische Verweis, mit der Zahl von Unix.
const S_IFLNK: u64 = 40960 // 0o120000

const DT_DIR: u64 = 4
const DT_REG: u64 = 8
// RUNDE OFS3: damit `ls -F` und `find -type l` einen Verweis erkennen,
// ohne fuer jeden Eintrag noch ein `lstat` zu rufen.
const DT_LNK: u64 = 10

// `struct stat` of x86-64 Linux is 144 octets; `struct linux_dirent64`
// has 19 octets in front of the name.
const STAT_BYTES: u64 = 144
const DIRENT_HEAD: u64 = 19

const ST_DEV: u64 = 0
const ST_INO: u64 = 8
const ST_NLINK: u64 = 16
const ST_MODE: u64 = 24 // 32 bit
const ST_UID: u64 = 28 // 32 bit
const ST_GID: u64 = 32 // 32 bit
const ST_RDEV: u64 = 40
const ST_SIZE: u64 = 48
const ST_BLKSIZE: u64 = 56
const ST_BLOCKS: u64 = 64
// RUNDE OFS3: DIE DREI ZEITEN WAREN SCHON DA -- als Nullen. `struct
// stat` von Linux x86-64 ist 144 Oktette gross, und diese Datei hat
// sie seit Runde K4 in genau dieser Groesse gefuellt; die Felder ab 72
// blieben nur leer, weil ein OFS-Inode keine Zeit trug. Es gibt also
// keine ABI-Aenderung an dieser Stelle, nur Zahlen, wo vorher Nullen
// standen. Jede libc auf der Welt liest sie an denselben Versaetzen.
const ST_ATIME: u64 = 72
const ST_ATIME_NS: u64 = 80
const ST_MTIME: u64 = 88
const ST_MTIME_NS: u64 = 96
const ST_CTIME: u64 = 104
const ST_CTIME_NS: u64 = 112

// The most a single `read` or `write` moves. The bounce buffer in the data
// area is one page, and a call that asks for more gets a SHORT answer, the
// way a Unix `read` may always give one -- not an error.
const MAX_IO: u64 = 4096
// RUNDE OFS3: 64 WAREN ES, UND DAS WAR DIE PFADGRENZE DES GANZEN
// SYSTEMS. Ein einzelner Name darf in OFS 3 schon 255 Zeichen haben --
// mit 64 waere `/tmp/<255 Zeichen>` an dieser Stelle mit
// -ENAMETOOLONG abgewiesen worden, lange bevor das Dateisystem ihn zu
// sehen bekommt. Der Kernelpuffer dahinter (`kstate.NAME_OFF`) ist
// 4096 Oktette gross und wird jetzt so aufgeteilt:
//
//     +0     ein Pfad aus Ring 3, aufgeloest         1024
//     +1024  ein zweiter (rename, mount)             1024
//     +2048  der Arbeitsbereich von `uio.resolve`    1024
//     +3072  ein Verzeichniseintrag fuer getdents     512
//     +3584  der Name einer Dateisystemart             32
//
// Die drei letzten Zahlen sind hier neu: `named` lag auf +512 und
// `kbuf` auf +1536 -- beide mitten in dem, was jetzt der zweite Pfad
// ist. Wer eine davon uebersieht, bekommt einen Kernel, in dem ein
// langer Pfad die Verzeichnisliste ueberschreibt.
const MAX_NAME: u64 = 1024
// Was ein einzelnes ARGUMENT von `exec` lang sein darf. Es ist NICHT
// MAX_NAME: acht Argumente (`proc.MAX_ARGS`) zu 1024 Oktetten waeren
// 8200 in einem Puffer von 4096 (`kstate.EARG_MAX`) -- und dahinter
// liegt die Seite, auf der der ELF-Lader arbeitet. Die Schranke unten
// prueft es zusaetzlich Argument fuer Argument.
const MAX_ARG: u64 = 448
// Wo im Namenspuffer die drei kleineren Bereiche liegen.
// ==================================================== RUNDE HAERTUNG-2
// DER PFADPUFFER DIESES KERNS.
//
// Bis hierher stand in siebenundzwanzig Funktionen dieser Datei
// woertlich `nameb(state)` -- EINE Seite fuer die GANZE
// MASCHINE. Der Ablauf ist ueberall derselbe: `fetch_path` kopiert den
// Pfad aus Ring 3 hinein, und danach wird aus dem Puffer gearbeitet.
// Zwischen beidem liegt kein Riegel; zwei Ring-3-Prozesse auf zwei
// Kernen in `open` oeffnen den Namen des jeweils anderen.
//
// Das ist der groesste Posten der dreiundvierzig Wege, die MERGE-6
// gezaehlt und als Vertrag stehen gelassen hat (docs/RUNDE-MERGE6.md
// 6.2). Runde GLYPHE hat den ersten davon geschlossen, weil er
// nachweislich zuschlug.
//
// DIE AUFLOESUNG JE KERN, nicht eine Sperre -- die Begruendung und die
// Messung stehen bei `kstate.NAMEK_OFF`. Sicher ist es, weil der
// Puffer ausschliesslich innerhalb eines Systemaufrufs angefasst wird
// und `MSR_SFMASK` IF fuer den ganzen Systemaufruf unten haelt: eine
// Aufgabe kann darin nicht verdraengt und auf einem anderen Kern
// fortgesetzt werden.
//
// `nameb(state)` ersetzt `nameb(state)` Zeichen fuer
// Zeichen. Alle Versaetze darin (+1024, +NB_ENT, +NB_FSTYPE, +2048 in
// uio.fi) bleiben gueltig -- es ist dieselbe Seitenaufteilung, nur eine
// Seite je Kern.
fn nameb(state: u64) -> u64 {
    var k: u64 = cpu.here(state)
    if k >= kstate.MAX_CPUS {
        k = 0
    }
    return state + kstate.NAMEK_OFF + k * 4096
}

const NB_ENT: u64 = 3072
const NB_FSTYPE: u64 = 3584

// How long a blocked reader or writer waits before it gives up. At 100 Hz
// this is four seconds. A pipe with nobody at the other end must not be
// able to stop the machine: a measurement that ends in a time limit
// measures nothing.
const BLOCK_ROUNDS: u64 = 400

fn neg(e: u64) -> u64 {
    return errno.neg(e)
}

fn fget(frame: u64, off: u64) -> u64 {
    return __mmio_read64((frame + off) as *mut u64)
}

fn fset(frame: u64, off: u64, v: u64) {
    __mmio_write64((frame + off) as *mut u64, v)
}

// ------------------------------------------------------------ the entry

// `KERNEL_SYSCALL` out of isr.s: rdi = the number, rsi = the saved user
// context, rdx = the kernel data area. What is returned lands in the
// user's rax -- `isr.s` writes it into the frame and the way out pops it.
// ROUND K9 SPLIT THIS IN TWO, and the reason is the whole of signal
// delivery. Ein Signal darf nicht irgendwo zugestellt werden -- es darf
// nur an EINER Stelle zugestellt werden: unmittelbar bevor der Prozess
// nach Ring 3 zurueckkehrt. Dort steht sein Zusammenhang vollstaendig und
// unbenutzt im Rahmen, und nur dort laesst er sich auf den Nutzerstapel
// retten. Also: `dispatch` beantwortet den Aufruf wie bisher, und diese
// Huelle darum sieht danach nach, ob etwas wartet.
//
// Der Rueckgabewert bleibt unberuehrt. `isr.s` schreibt ihn NACH dem
// Aufruf in den Rahmen; `check_sys` fasst rax nicht an, sondern nur rip,
// rsp und die drei Argumentregister der Behandlungsroutine.
fn entry(number: u64, frame: u64, state: u64) -> u64 {
    let r: u64 = dispatch(number, frame, state)
    // RUNDE LAUFZEIT: welche Nummer kennt dieser Kern NICHT? Ein fremdes
    // Programm legt seine Nummer in rax und bekommt -ENOSYS zurueck --
    // ohne diese Zeile sieht man davon nur, dass der Prozess starb.
    // Nur mit `fremdtrace` auf der Befehlszeile, und der Rueckgabewert
    // bleibt derselbe.
    if kstate.mode_on(state, kstate.M_FREMDTRACE) {
        if r == neg(errno.E_NOSYS) {
            var s_ns: [u8; 15] = "sys: ENOSYS nr\0"
            serial.puts((&s_ns[0]) as u64)
            serial.dec(number)
            serial.nl()
        }
    }
    // RUNDE POLL, UND ES IST EIN ECHTER FEHLER, DER HIER SEIT K9 LAG.
    // Der Satz darueber stimmte nicht: `isr.s` schreibt die Antwort
    // NACH diesem Aufruf in den Rahmen -- also stand beim Zustellen des
    // Signals in `F_RAX` noch die NUMMER des Systemaufrufs. `check_sys`
    // rettet den ganzen Rahmen auf den Nutzerstapel, und `sigreturn`
    // holt ihn von dort zurueck: der Aufruf gab damit seine eigene
    // Nummer statt seiner Antwort, sobald ein ABGEFANGENES Signal ihn
    // unterbrach. Gemessen an genau dieser Runde: ein `poll` ohne Frist,
    // von SIGUSR1 unterbrochen, lieferte 7 statt -EINTR.
    //
    // Bis hierher fiel das niemandem auf, weil die abgefangenen Signale
    // in `tools/unix/run.sh` einen Prozess treffen, der gerade RECHNET
    // (dort geht die Zustellung ueber `check_irq`) oder der danach
    // ohnehin stirbt. Ein Helfer, der in `poll` steht und ein SIGTERM
    // sauber beantworten soll, ist der erste Fall, in dem es zaehlt.
    //
    // Die Antwort gehoert also VOR die Zustellung in den Rahmen.
    // `isr.s` schreibt sie danach noch einmal an dieselbe Stelle -- das
    // ist derselbe Wert und stoert nicht, und rax ist fuer die
    // Behandlungsroutine ein Kratzregister.
    fset(frame, F_RAX, r)
    signal.check_sys(state, sched.current(state), frame)
    return r
}

fn dispatch(number: u64, frame: u64, state: u64) -> u64 {
    kstate.add(state, kstate.SYSCALLS, 1)
    let a0: u64 = fget(frame, F_RDI)
    let a1: u64 = fget(frame, F_RSI)
    let a2: u64 = fget(frame, F_RDX)
    let a3: u64 = fget(frame, F_R10)
    let a4: u64 = fget(frame, F_R8)
    let a5: u64 = fget(frame, F_R9)
    if kstate.get(state, kstate.EXCURSION) != 0 {
        if number == SYS_MARK || number == SYS_LEAVE {
            return user.handle(number, a0, state)
        }
    }
    let me: u64 = sched.current(state)
    // Die native ABI zuerst: sie hat ihren eigenen Zahlenraum, ihre
    // eigenen Fehlerwerte und ihre eigene Tabelle.
    if number >= CAP_BASE {
        return native(state, me, number, a0, a1, a2, a3, a4)
    }
    if number == SYS_WRITE {
        return do_write(state, me, a0, a1, a2)
    }
    if number == SYS_READ {
        return do_read(state, me, a0, a1, a2)
    }
    if number == SYS_OPEN {
        return do_open(state, me, a0, a1)
    }
    if number == SYS_CLOSE {
        return do_close(state, me, a0)
    }
    if number == SYS_LSEEK {
        return do_lseek(state, me, a0, a1, a2)
    }
    // RUNDE OFS3: die vier neuen. Sie stehen VOR `SYS_STAT`, weil
    // `lstat` sich nur in einem Wort davon unterscheidet und die beiden
    // nebeneinander gelesen werden sollen.
    if number == SYS_LSTAT {
        return do_lstat(state, me, a0, a1)
    }
    if number == SYS_SYMLINK {
        return do_symlink(state, me, a0, a1)
    }
    if number == SYS_READLINK {
        return do_readlink(state, me, a0, a1, a2)
    }
    if number == SYS_UTIMENSAT {
        return do_utimensat(state, me, a0, a1, a2, a3)
    }
    if number == SYS_STAT {
        return do_stat(state, me, a0, a1)
    }
    if number == SYS_FSTAT {
        return do_fstat(state, me, a0, a1)
    }
    if number == SYS_GETDENTS64 {
        return do_getdents(state, me, a0, a1, a2)
    }
    if number == SYS_MKDIR {
        return do_mkdir(state, me, a0)
    }
    if number == SYS_UNLINK {
        return do_unlink(state, me, a0)
    }
    if number == SYS_RMDIR {
        return do_rmdir(state, me, a0)
    }
    if number == SYS_GETCWD {
        return do_getcwd(state, me, a0, a1)
    }
    // ROUND K8: the sockets. They stand here, in the same table as
    // `read` and `write`, and not beside it -- a socket IS a descriptor
    // of this system, and `dup2`, `fork` and `close` reach it without
    // knowing that.
    if number == SYS_SOCKET {
        return do_socket(state, me, a0, a1, a2)
    }
    if number == SYS_BIND {
        return do_bind(state, me, a0, a1, a2)
    }
    if number == SYS_LISTEN {
        return do_listen(state, me, a0, a1)
    }
    if number == SYS_ACCEPT {
        return do_accept(state, me, a0, a1, a2, 0)
    }
    if number == SYS_ACCEPT4 {
        return do_accept(state, me, a0, a1, a2, a3)
    }
    if number == SYS_CONNECT {
        return do_connect(state, me, a0, a1, a2)
    }
    if number == SYS_SENDTO {
        return do_sendto(state, me, a0, a1, a2, a4, a5)
    }
    if number == SYS_RECVFROM {
        return do_recvfrom(state, me, a0, a1, a2, a4, a5)
    }
    if number == SYS_SHUTDOWN {
        return do_shutdown(state, me, a0, a1)
    }
    if number == SYS_GETSOCKNAME {
        return do_sockname(state, me, a0, a1, a2, false)
    }
    if number == SYS_GETPEERNAME {
        return do_sockname(state, me, a0, a1, a2, true)
    }
    if number == SYS_SETSOCKOPT {
        return do_setsockopt(state, me, a0, a1, a2)
    }
    if number == SYS_DUP {
        return do_dup(state, me, a0)
    }
    if number == SYS_DUP2 {
        return do_dup2(state, me, a0, a1)
    }
    if number == SYS_PIPE {
        return do_pipe(state, me, a0)
    }
    // RUNDE POLL: auf mehrere Deskriptoren gleichzeitig warten.
    // RUNDE ASYNC: der Block 1980..1985. Er steht VOR `SYS_POLL`, weil
    // `poll` die readiness-Seite ist und diese Runde zeigt, dass sie auf
    // die completion-Seite abbildbar ist -- nicht umgekehrt.
    if number >= AIO_BASE {
        if number <= AIO_MAXNR {
            return aio_call(state, me, number, a0, a1, a2, a3, a4)
        }
    }
    if number == SYS_FSYNC {
        return do_fsync(state, me, a0)
    }
    if number == SYS_POLL {
        return do_poll(state, me, a0, a1, a2)
    }
    if number == SYS_BRK {
        return do_brk(state, me, a0)
    }
    // RUNDE LAUFZEIT: der Fadenzeiger. Steht neben `brk`, weil beide
    // dasselbe tun -- ein Programm richtet sich seinen Adressraum ein,
    // bevor es anfaengt zu arbeiten.
    if number == SYS_ARCH_PRCTL {
        return do_arch_prctl(state, me, a0, a1)
    }
    // RUNDE LAUFZEIT: `writev`/`readv`. Der Grund, aus dem Lua auf
    // diesem Kern stumm blieb -- stdio schreibt gepuffert, und gepuffert
    // heisst bei musl `writev` und nicht `write`.
    if number == SYS_WRITEV {
        return do_writev(state, me, a0, a1, a2, true)
    }
    if number == SYS_READV {
        return do_writev(state, me, a0, a1, a2, false)
    }
    // `set_tid_address` gibt nur die eigene Kennung zurueck. Dieser Kern
    // raeumt keine Futex-Adresse beim Fadenende auf, also wird die
    // Adresse NICHT gemerkt -- was hier gelogen waere, ist ein
    // Aufraeumen zu versprechen, das nicht stattfindet. musl will von
    // dem Aufruf ohnehin nur die tid.
    if number == SYS_SET_TID_ADDRESS {
        // RUNDE FREMDLAND: JETZT WIRD SIE GEMERKT. LAUFZEIT liess das
        // ABSICHTLICH bleiben, mit der richtigen Begruendung, dass ein
        // Aufraeumversprechen ohne Aufraeumen schlimmer ist als keines.
        // Seit `clone`/`exit_task` das Wort wirklich loeschen, ist das
        // Versprechen gedeckt.
        if proc.user_ok(state, me, a0, 4) {
            sched.tset(state, me, sched.T_FUTEX, a0)
        }
        return sched.tget(state, me, sched.T_PID)
    }
    // RUNDE LAUFZEIT: Lesen und Schreiben MIT POSITION, ohne die
    // gemeinsame Schreibmarke zu bewegen. Das ist keine Bequemlichkeit
    // -- SQLite baut darauf, dass zwei Zugriffe auf dieselbe Datei sich
    // nicht gegenseitig die Position verstellen.
    if number == SYS_PREAD64 {
        return do_pio(state, me, a0, a1, a2, a3, false)
    }
    if number == SYS_PWRITE64 {
        return do_pio(state, me, a0, a1, a2, a3, true)
    }
    if number == SYS_FCNTL {
        return do_fcntl(state, me, a0, a1, a2)
    }
    // RUNDE FREMDLAND: `uname`. busybox fragt danach, und nicht nur
    // `uname -a` -- die Shell nimmt den Namen fuer ihre Kennung. Sechs
    // Felder zu je 65 Oktetten, so wie Linux sie legt.
    if number == SYS_UNAME {
        return do_uname(state, me, a0)
    }
    // RUNDE FREMDLAND: `prctl`. musl ruft es beim Start jedes Programms.
    // Dieser Kern fuehrt keinen Prozessnamen und keine Kernschreibe, also
    // ist die ehrliche Antwort fuer die setzenden Unterbefehle 0 (es ist
    // nichts zu tun) und fuer die fragenden der Wert, den dieser Kern
    // wirklich hat -- NICHT -ENOSYS, denn die Nummer gibt es.
    if number == SYS_PRCTL {
        return do_prctl(state, me, a0, a1)
    }
    // RUNDE FREMDLAND: `clone` mit den Fadenflaggen -- das ist
    // `pthread_create`. Ohne die Flaggen (also als `fork`-Ersatz) geht
    // es denselben Weg wie `fork`.
    if number == SYS_CLONE {
        return do_clone(state, me, frame, a0, a1, a2, a3, a4)
    }
    // RUNDE FREMDLAND: `futex`. musl sperrt damit, und zwar auch dann,
    // wenn nur ein Faden laeuft.
    if number == SYS_FUTEX {
        return do_futex(state, me, a0, a1, a2, a3)
    }
    // RUNDE FREMDLAND: `mprotect`. Dieser Kern gibt jede Seite eines
    // Programms mit den Rechten aus, die sein Programmkopf verlangt, und
    // kennt kein nachtraegliches Umschalten. musl ruft es beim Anlegen
    // eines Fadenstapels (Schutzseite) und kommt mit einem Ja zurecht.
    if number == SYS_MPROTECT {
        return do_mprotect(state, me, a0, a1, a2)
    }
    if number == SYS_MMAP {
        // ROUNDE K7: a4 ist der Deskriptor. Bis hierher wurde er
        // weggelassen, weil nur MAP_ANONYMOUS ging und Linux ihn dabei
        // ebenfalls nicht ansieht. Eine Geraeteabbildung braucht ihn.
        return do_map(state, me, a1, a2, a3, a4, a5)
    }
    if number == SYS_MUNMAP {
        return do_unmap(state, me, a0, a1)
    }
    if number == SYS_GETPID {
        // RUNDE FREMDLAND: DIE FADENGRUPPE, nicht die Aufgabe.
        // `getpid` muss in jedem Faden desselben Prozesses dieselbe Zahl
        // geben -- das ist der Unterschied zu `gettid` (SYS_GETTID, eine
        // Zeile weiter unten), und ohne ihn haelt sich jeder Faden fuer
        // einen eigenen Prozess. Fuer alles, was nicht mit `clone`
        // entstanden ist, IST `T_TGID` die eigene pid (`signal.init_task`),
        // also aendert sich dort nichts.
        let g: u64 = sched.tget(state, me, sched.T_TGID)
        if g != 0 {
            return g
        }
        return sched.tget(state, me, sched.T_PID)
    }
    if number == SYS_GETPPID {
        return do_getppid(state, me)
    }
    if number == SYS_YIELD {
        sched.yield_now(state)
        return 0
    }
    if number == SYS_NANOSLEEP {
        return do_nanosleep(state, me, a0)
    }
    if number == SYS_FORK {
        return do_fork(state, me, frame)
    }
    if number == SYS_EXECVE {
        return do_execve(state, me, frame, a0, a1)
    }
    if number == SYS_WAIT4 {
        return do_wait4(state, me, a0, a1, a2)
    }
    if number == SYS_EXIT || number == SYS_EXIT_GROUP {
        // RUNDE ASYNC, ZUSAGE (d), UND SIE STEHT VOR ALLEM ANDEREN.
        // Ein Prozess mit laufenden Auftraegen darf nicht sterben,
        // solange ein Arbeitsfaden in seinen Adressraum schreibt.
        // `abandon` bricht ab, WARTET auf die laufenden und gibt jedes
        // Token zurueck -- erst danach werden die Deskriptoren
        // geschlossen, denn ein Auftrag haelt seinen Eintrag der
        // offenen Dateien und `close_all` wuerde ihn sonst aufschieben
        // muessen, ohne dass ihn spaeter noch jemand holt.
        async.abandon(state, me)
        sock_close_all(state, me)
        file.close_all(state, me)
        // ROUND K9: der Elternprozess erfaehrt es. Das ist SIGCHLD, und
        // es ist der Grund, warum ein Programm ohne `wait` ueberhaupt
        // merken kann, dass sein Kind fertig ist.
        signal.exiting(state, me)
        // NOT `a0 & 255`. POSIX masks an exit status to eight bits, and
        // `wait4` below does exactly that -- but the kernel's own task
        // record keeps what the process really said, because the dumps of
        // rounds 62 and K1 read that number and a process that leaves with
        // 12345 did not leave with 57.
        // ROUND POWERMON: the last ticks of this process, before the
        // scheduler stops being able to tell anybody about them.
        // RUNDE FREMDLAND: DAS WORT, AUF DAS `pthread_join` WARTET.
        // `clone` mit CLONE_CHILD_CLEARTID (und `set_tid_address`) hat
        // seine Adresse in `T_FUTEX` gelegt; sie MUSS auf 0 gehen,
        // BEVOR die Aufgabe Zombie wird -- danach ist ihr Adressraum
        // bei einem Prozess weg, und wer wartet, wartete ewig.
        // Gemessen, bevor das hier stand: `pthread_join` kam nie zurueck.
        //
        // Steht in `sys.fi` und nicht in `sched.exit_task`, weil das
        // Schreiben durch die Seitentabellen der Aufgabe geht und
        // `sched.fi` `proc.fi` nicht kennen darf -- der Modulgraph ist
        // ein Baum, und `proc.fi` steht auf `sched.fi`.
        clear_child_tid(state, me)
        // RUNDE FREMDLAND: UND DIE SPERREN DIESES HALTERS FALLEN.
        // Ohne diese Zeile bliebe eine Datenbank fuer immer belegt,
        // sobald ein Prozess stirbt, waehrend er sie hielt -- der
        // haeufigste Weg, wie ein System mit Sperren unbrauchbar wird.
        locks_drop(state, me)
        pmon.flush(state, me)
        sched.exit_task(state, a0)
        return 0 // not reached
    }
    if number == SYS_OSUM_SPAWN {
        return do_spawn(state, me, a0, a1)
    }
    if number == SYS_OSUM_EXEC {
        return do_exec(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_SETENV {
        return do_setenv(state, me, a0, a1)
    }
    if number == SYS_OSUM_MOUNT {
        return do_mount(state, a0)
    }
    // ---------------------------------------------------- RUNDE K14
    // RUNDE INSTALL.
    if number == SYS_LINK {
        return do_link(state, me, a0, a1)
    }
    if number == SYS_SYNC {
        return do_sync(state, me)
    }
    if number == SYS_MOUNT {
        return do_vfs_mount(state, me, a0, a1, a2, a3)
    }
    if number == SYS_UMOUNT2 {
        return do_vfs_umount(state, me, a0)
    }
    if number == SYS_RENAME {
        return do_rename(state, me, a0, a1)
    }
    if number == SYS_OSUM_MNTSTAT {
        return do_mntstat(state, a0, a1)
    }
    // RUNDE K16.
    if number == SYS_OSUM_FTYPE {
        return do_ftype(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_FOPEN {
        return do_fopen(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_FLIST {
        return do_flist(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_FREG {
        return do_freg(state, me, a0, a1)
    }
    // ROUND K6.
    if number == SYS_CHDIR {
        return do_chdir(state, me, a0)
    }
    if number == SYS_OSUM_SYSINFO {
        return uio.sysinfo(state, a0)
    }
    if number == SYS_OSUM_PSTAT {
        return do_pstat(state, a0, a1)
    }
    if number == SYS_OSUM_KILL {
        if !kill_allowed(state, me, a0) {
            return neg(errno.E_PERM)
        }
        return uio.kill_pid(state, a0, a1)
    }
    // ------------------------------------------------------- ROUND K9
    if number == SYS_RT_SIGACTION {
        return signal.do_sigaction(state, me, a0, a1, a2)
    }
    if number == SYS_RT_SIGPROCMASK {
        return signal.do_sigprocmask(state, me, a0, a1, a2)
    }
    if number == SYS_RT_SIGRETURN {
        return signal.do_sigreturn(state, me, frame)
    }
    if number == SYS_RT_SIGPENDING {
        return signal.do_sigpending(state, me, a0)
    }
    if number == SYS_KILL {
        // RUNDE K13: dieselbe Funktion aus `perm.fi`, die auch ueber
        // Dateien entscheidet. Ein Benutzer darf nur Prozesse
        // abschiessen, die ihm gehoeren -- ohne diese Zeile koennte
        // jeder den Prozess 1 beenden.
        if !kill_allowed(state, me, a0) {
            return neg(errno.E_PERM)
        }
        return signal.do_kill(state, me, a0, a1)
    }
    if number == SYS_TGKILL {
        return signal.do_kill(state, me, a1, a2)
    }
    if number == SYS_PAUSE {
        return signal.do_pause(state, me)
    }
    if number == SYS_ALARM {
        return signal.do_alarm(state, me, a0)
    }
    if number == SYS_SETPGID {
        return signal.do_setpgid(state, me, a0, a1)
    }
    if number == SYS_GETPGID {
        return signal.do_getpgid(state, me, a0)
    }
    if number == SYS_GETPGRP {
        return signal.do_getpgid(state, me, 0)
    }
    if number == SYS_SETSID {
        return signal.do_setsid(state, me)
    }
    if number == SYS_GETTID {
        return sched.tget(state, me, sched.T_PID)
    }
    if number == SYS_IOCTL {
        return do_ioctl(state, me, a0, a1, a2)
    }
    if number == SYS_CLOCK_GETTIME {
        return do_clock_gettime(state, me, a0, a1)
    }
    if number == SYS_CLOCK_GETRES {
        return do_clock_getres(state, me, a0, a1)
    }
    if number == SYS_CLOCK_NANOSLEEP {
        return do_nanosleep(state, me, a2)
    }
    if number == SYS_GETTIMEOFDAY {
        return do_gettimeofday(state, me, a0)
    }
    if number == SYS_TIME {
        return do_time(state, me, a0)
    }
    if number == SYS_GETRANDOM {
        return do_getrandom(state, me, a0, a1)
    }
    if number == SYS_OSUM_PTY {
        return do_openpty(state, me, a0)
    }
    if number == SYS_OSUM_TTYINFO {
        return tty.info(state, tty_of(state, me), a0)
    }
    if number == SYS_OSUM_SIGINFO {
        return do_siginfo(state, me, a0, a1)
    }
    // RUNDE K12: die Gastmaschinen.
    if number >= SYS_VM_CREATE && number <= SYS_VM_VALUE {
        return vm_call(state, me, number, a0, a1)
    }
    // RUNDE K15: die Naht zur Widget-Bibliothek. Sie stand einmal am
    // Ende von `k13_call`, wo sie (a) toter Code war, weil `is_k13` die
    // Nummern 1800..1809 nicht aufzaehlt, und (b) ein `a4` benutzte, das
    // dort nicht im Sichtbereich liegt -- der Kernel uebersetzte nicht.
    // Danach stand sie HIER, als eigener Zweig mit acht Argumenten.
    //
    // RUNDE MERGE-2: SIE STEHT JETZT WEDER DA NOCH DA, SONDERN IN
    // `late_call`, zusammen mit den Nummern von K13. Beide Einwaende von
    // damals sind dort erledigt -- die Nummern werden ausdruecklich
    // geprueft, und `a4` kommt sauber aus `fget(frame, F_R8)`. Der Grund
    // fuer den Umzug steht bei der K13-Weiche weiter unten und ist der
    // Rahmen von `dispatch`: zwei Weichen mit acht Argumenten in EINER
    // Funktion mit ueber hundert Zweigen sind der teuerste Stapelrahmen
    // dieses Kernels.
    // RUNDE K18: die Energieschicht.
    if number >= SYS_OSUM_PWRGET && number <= SYS_OSUM_PWRSTR {
        return pwr_call(state, me, number, a0, a1, a2)
    }
    // RUNDE DISPLAY: der Bildschirm. Eigene Funktion, aus demselben
    // Grund wie oben -- der Rahmen entsteht erst, wenn wirklich eine
    // dieser Nummern kommt.
    if number >= SYS_OSUM_DISPGET && number <= SYS_OSUM_DISPSTR {
        return gfx.sys_disp(state, me, number, a0, a1, a2)
    }
    // RUNDE I18N: die Tastaturbelegung.
    if number == SYS_OSUM_KBD {
        return kbd_call(state, a0, a1)
    }
    // RUNDE NETVIEW, dritter Nachtrag: das globale Tastenkuerzel. Eine
    // eigene Zeile und nicht in `net_call` hineingeschmuggelt -- es ist
    // eine Auskunft ueber die TASTATUR, und wer sie dort suchte, wo das
    // Netz beantwortet wird, faende sie nie.
    //
    // MERGE FIX, und das war ein echter Schaden: diese Zeile stand
    // UNTER dem Bereichstest fuer das Netz. Seit die Nummer beim
    // Verschmelzen von 1320 auf 1314 gerueckt ist, liegt sie INNERHALB
    // von NETGET..SHARE -- der Bereichstest fing sie ab, `net_call`
    // kannte sie nicht, und der Rest jener Funktion ist der Pfad von
    // NETSET. Die Taskleiste fragt dieses Kuerzel in jedem Durchgang
    // ab; jede Abfrage kam als "Netz aus, Adresse 0.0.0.0" an, und die
    // Maschine verlor ihre Anschrift eine halbe Sekunde nach dem Start.
    // Der Test steht jetzt VOR dem Bereich, und `net_call` beantwortet
    // eine unbekannte Nummer nicht mehr stillschweigend als NETSET.
    if number == SYS_OSUM_HOTKEY {
        return do_hotkey(state, a0)
    }
    // RUNDE DESKTOP: das Netz jenseits der Sockets. Zwei Nummern aus
    // dem Block, den Runde K8 dafuer ausgewiesen und nie benutzt hat.
    // MERGE: die Obergrenze ist die HOECHSTE der beiden Runden. NETVIEW
    // endete bei SYS_OSUM_NETVFB, NETMON reicht bis SYS_OSUM_SHARE;
    // haette hier die kleinere gestanden, waeren die Aufrufe der
    // anderen Runde still mit -ENOSYS beantwortet worden.
    if number >= SYS_OSUM_NETGET && number <= SYS_OSUM_SHARE {
        return net_call(state, me, number, a0, a1, a2)
    }
    // RUNDE TILING: der Fensterbaum, bedient aus Ring 3.
    if number >= SYS_OSUM_TILEGET && number <= SYS_OSUM_TILEBIND {
        return gfx.sys_tile(state, me, number, a0, a1)
    }
    // ROUND POWERMON: the power accounting.
    if number == SYS_OSUM_PMON {
        return do_pmon(state, me, a0, a1, a2)
    }
    // RUNDE WERKZEUGE: die Kerne, einzeln.
    if number == SYS_OSUM_CPUSTAT {
        return do_cpustat(state, a0, a1)
    }
    // RUNDE FEEDBACK (ueber BRIDGE-2): das Bildschirmfoto. Der Weg geht
    // ueber `gfx`, weil er den Fensterserver braucht -- bei `gui=off`
    // gibt es ihn nicht, und `gfx.sys_shot` antwortet dann -ENOSYS.
    if number == SYS_OSUM_SHOT {
        return gfx.sys_shot(state, me, a0, a1, a2)
    }
    // RUNDE SYSTEMBUS: EIN Zweig fuer zweiundzwanzig Handgriffe.
    if number == SYS_OSUM_BUS {
        return do_bus(state, me, a0, a1, a2, a3, a4)
    }
    // ------------------------------------------------ RUNDE PROTOKOLL
    if number == SYS_OSUM_KLOG {
        return do_klog(state, me, a0, a1, a2, a3)
    }
    if number == SYS_OSUM_KRACH {
        return do_krach(state, me, a0)
    }
    // RUNDE HDA: der Ton. Fuenf Nummern, eine Weiche.
    if number == SYS_OSUM_AUDGET {
        return do_audget(state, a0)
    }
    if number == SYS_OSUM_AUDSET {
        return do_audset(state, a0, a1)
    }
    if number == SYS_OSUM_AUDWRITE {
        return do_audwrite(state, me, a0, a1)
    }
    if number == SYS_OSUM_AUDOPEN {
        return do_audopen(state, me, a0)
    }
    if number == SYS_OSUM_AUDSEND {
        return do_audsend(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_SPERRE {
        return do_sperre(state, me, a0, a1)
    }
    // ------------------------------------------------------ RUNDE K13
    //
    // EINE ZEILE UND NICHT FUENFUNDZWANZIG, und das ist keine
    // Kosmetik, sondern eine gemessene Notwendigkeit. `dispatch` ist
    // EINE Funktion mit ueber hundert Zweigen, und firnc gibt jedem
    // Zwischenwert jedes Zweiges einen eigenen Platz auf dem Stapel --
    // der Rahmen dieser einen Funktion war schon vor dieser Runde 5104
    // Oktette gross. Die fuenfundzwanzig Aufrufe dieser Runde als
    // Zweige hier drin haben ihn auf 6864 wachsen lassen, und der
    // tiefste Kernstapel eines Laufs stieg damit von 14224 auf 16128
    // von 16384 Oktetten -- 112 Oktette Luft, gemessen mit
    // `osum: kstack deepest=`. In einer eigenen Funktion kostet
    // dasselbe nichts, weil ihr Rahmen erst entsteht, wenn wirklich
    // eine dieser Nummern kommt. Dieselbe Ueberlegung steht seit Runde
    // K12 hinter `vm_call` und seit Runde K6 hinter `native`.
    // NACHTRAG ZUM MERGE VON K15 (Zweig k-merge2): ZWEI RUNDEN, EINE
    // WEICHE, UND DAS AUS GEMESSENEM GRUND. Der Rahmen von `dispatch`
    // ist der teuerste im Kernel -- der Kommentar darueber steht seit
    // K13 hier. Ein ZWEITER Aufruf mit acht Argumenten (`wig_call`) hat
    // ihn so weit wachsen lassen, dass der tiefste Kernstapel eines
    // Laufes 16384 von 16384 Oktetten erreichte: `cp` starb an einem
    // #PF, der wie ein Fehler im Dateisystem aussah und keiner war.
    // Deshalb geht beides durch EINEN Aufruf mit VIER Argumenten; die
    // Argumente holt sich `late_call` selbst aus dem Rahmen, und ihr
    // Platz entsteht erst dort.
    if is_k13(number) || (number >= WIG_BASE && number <= WIG_MAXNR) {
        return late_call(state, me, number, frame)
    }
    // RUNDE K17. Zwei Nummern, in einer eigenen Funktion -- aus genau
    // demselben Grund, aus dem `k13_call` eine ist: der Rahmen von
    // `dispatch` ist ohnehin der groesste dieses Kernels, und diese
    // Runde hat den tiefsten Aufruf um vier Schichten verlaengert.
    if number >= USB_MINNR && number <= USB_MAXNR {
        return usb_call(state, number, a0)
    }
    return neg(errno.E_NOSYS)
}

fn usb_call(state: u64, number: u64, a0: u64) -> u64 {
    if number == SYS_OSUM_USBSTAT {
        return usb.stat(state, a0)
    }
    if number == SYS_OSUM_USBPULL {
        usb.unplug_now(state)
        return usb.unplugs(state)
    }
    return neg(errno.E_NOSYS)
}

fn late_call(state: u64, me: u64, number: u64, frame: u64) -> u64 {
    let a0: u64 = fget(frame, F_RDI)
    let a1: u64 = fget(frame, F_RSI)
    let a2: u64 = fget(frame, F_RDX)
    let a3: u64 = fget(frame, F_R10)
    if number >= WIG_BASE && number <= WIG_MAXNR {
        // RUNDE MERGE-2: nicht mehr `wig_call`, sondern die Naht.
        // Runde SERVERBUILD hat den Rumpf nach `sysgui.fi` gezogen und
        // `gfx.sys_wig` davor gesetzt, damit bei gui=off gar nichts von
        // der Oberflaeche im Uebersetzungsbaum liegt. Die EINE Weiche
        // aus k-merge2 bleibt genau so, wie sie war -- nur der Gerufene
        // hat einen neuen Namen.
        return gfx.sys_wig(state, me, number, a0, a1, a2, a3,
            fget(frame, F_R8))
    }
    return k13_call(state, me, number, a0, a1, a2, a3)
}

// Gehoert diese Nummer der Benutzerschicht? Absichtlich eine einzige
// Funktion mit Vergleichen und kein Bereich: die Nummern von Linux
// liegen verstreut (21, 90..95, 102..108, 113..120, 169, 260..269) und
// ein Bereich wuerde fremde Nummern mitnehmen.
fn is_k13(number: u64) -> bool {
    if number == SYS_ACCESS || number == SYS_UMASK || number == SYS_REBOOT {
        return true
    }
    if number >= SYS_CHMOD && number <= SYS_LCHOWN {
        return true
    }
    if number >= SYS_GETUID && number <= SYS_GETEGID {
        return true
    }
    if number >= SYS_SETREUID && number <= SYS_GETRESGID {
        return true
    }
    if number == SYS_FCHOWNAT || number == SYS_FCHMODAT
        || number == SYS_FACCESSAT {
        return true
    }
    // RUNDE MULTIUSER: die drei dieser Runde gehen denselben Weg.
    if number == SYS_GETGROUPS || number == SYS_SETGROUPS {
        return true
    }
    if number == SYS_OSUM_MUSTAT {
        return true
    }
    return number == SYS_OSUM_USERINFO
}

fn k13_call(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64,
    a3: u64) -> u64 {
    if number == SYS_GETUID {
        return do_getid(state, me, sched.T_UID)
    }
    if number == SYS_GETEUID {
        return do_getid(state, me, sched.T_EUID)
    }
    if number == SYS_GETGID {
        return do_getid(state, me, sched.T_GID)
    }
    if number == SYS_GETEGID {
        return do_getid(state, me, sched.T_EGID)
    }
    if number == SYS_SETUID {
        return do_setuid(state, me, a0)
    }
    if number == SYS_SETGID {
        return do_setgid(state, me, a0)
    }
    if number == SYS_SETREUID {
        return do_setre(state, me, a0, a1, sched.T_UID, sched.T_EUID,
            sched.T_SUID)
    }
    if number == SYS_SETREGID {
        return do_setre(state, me, a0, a1, sched.T_GID, sched.T_EGID,
            sched.T_SGID)
    }
    if number == SYS_SETRESUID {
        return do_setres(state, me, a0, a1, a2, sched.T_UID, sched.T_EUID,
            sched.T_SUID)
    }
    if number == SYS_SETRESGID {
        return do_setres(state, me, a0, a1, a2, sched.T_GID, sched.T_EGID,
            sched.T_SGID)
    }
    if number == SYS_GETRESUID {
        return do_getres(state, me, a0, a1, a2, sched.T_UID, sched.T_EUID,
            sched.T_SUID)
    }
    if number == SYS_GETRESGID {
        return do_getres(state, me, a0, a1, a2, sched.T_GID, sched.T_EGID,
            sched.T_SGID)
    }
    if number == SYS_UMASK {
        return do_umask(state, me, a0)
    }
    if number == SYS_CHMOD {
        return do_chmod(state, me, a0, a1)
    }
    if number == SYS_FCHMOD {
        return do_fchmod(state, me, a0, a1)
    }
    // Die `*at`-Formen: dieser Kernel hat keine Verzeichnisdeskriptoren,
    // und AT_FDCWD ist der einzige Wert, den sie annehmen. Der Pfad steht
    // im ZWEITEN Argument, alles andere ist wie bei der kurzen Form.
    if number == SYS_FCHMODAT {
        return do_chmod(state, me, a1, a2)
    }
    if number == SYS_CHOWN || number == SYS_LCHOWN {
        return do_chown(state, me, a0, a1, a2)
    }
    if number == SYS_FCHOWN {
        return do_fchown(state, me, a0, a1, a2)
    }
    if number == SYS_FCHOWNAT {
        return do_chown(state, me, a1, a2, a3)
    }
    if number == SYS_ACCESS {
        return do_access(state, me, a0, a1)
    }
    if number == SYS_FACCESSAT {
        return do_access(state, me, a1, a2)
    }
    if number == SYS_REBOOT {
        return do_reboot(state, me, a0)
    }
    if number == SYS_OSUM_USERINFO {
        return do_userinfo(state, me, a0)
    }
    if number == SYS_GETGROUPS {
        return do_getgroups(state, me, a0, a1)
    }
    if number == SYS_SETGROUPS {
        return do_setgroups(state, me, a0, a1)
    }
    if number == SYS_OSUM_MUSTAT {
        return do_mustat(state, me, a0)
    }
    return neg(errno.E_NOSYS)
}

// --------------------------------------------------------- reading in

// One octet out of the address space of the process. The kernel does not
// switch to it -- it walks the tables and reads the frame through the
// identity mapping.
fn peek(state: u64, me: u64, addr: u64) -> u64 {
    let phys: u64 = proc.translate(state, me, addr)
    if phys == 0 {
        return 0
    }
    // ROUND K10: the SMAP window. The frame is reached through the
    // identity mapping, and for the pages of `.utext` that mapping
    // carries the user bit -- with CR4.SMAP a read of it out of ring 0
    // is a #PF unless AC is set. `guard.stac` is a no-op when the bit is
    // off, so this costs a compare on a machine without SMAP.
    guard.stac(state)
    let v: u64 = kstate.get8(phys)
    guard.clac(state)
    return v
}

fn poke(state: u64, me: u64, addr: u64, v: u64) -> bool {
    let phys: u64 = proc.translate(state, me, addr)
    if phys == 0 {
        return false
    }
    guard.stac(state)
    kstate.set8(phys, v as u8)
    guard.clac(state)
    return true
}

// Out of the kernel into ring 3, and the other way round. Page by page:
// `translate` is a walk of four tables, and doing it per octet is what
// made round 62's `read` the slowest thing in the system.
fn copy_out(state: u64, me: u64, dst: u64, src: u64, len: u64) -> bool {
    if !proc.user_ok(state, me, dst, len) {
        return false
    }
    var n: u64 = 0
    while n < len {
        let phys: u64 = proc.translate(state, me, dst + n)
        if phys == 0 {
            return false
        }
        var room: u64 = 4096 - ((dst + n) & 4095)
        if room > len - n {
            room = len - n
        }
        var k: u64 = 0
        // Das Fenster steht um die SEITE, nicht um das einzelne Oktett:
        // `stac`/`clac` je Oktett waeren zwei Befehle auf jeden
        // kopierten Wert, und ein Fenster, das eine Seite lang offen
        // ist, ist immer noch ein Fenster.
        guard.stac(state)
        while k < room {
            kstate.set8(phys + k, kstate.get8(src + n + k) as u8)
            k = k + 1
        }
        guard.clac(state)
        n = n + room
    }
    return true
}

fn copy_in(state: u64, me: u64, dst: u64, src: u64, len: u64) -> bool {
    if !proc.user_ok(state, me, src, len) {
        return false
    }
    var n: u64 = 0
    while n < len {
        let phys: u64 = proc.translate(state, me, src + n)
        if phys == 0 {
            return false
        }
        var room: u64 = 4096 - ((src + n) & 4095)
        if room > len - n {
            room = len - n
        }
        var k: u64 = 0
        guard.stac(state)
        while k < room {
            kstate.set8(dst + n + k, kstate.get8(phys + k) as u8)
            k = k + 1
        }
        guard.clac(state)
        n = n + room
    }
    return true
}

// A name out of ring 3 into the kernel's own buffer. Returns the length,
// or an error. Nothing is read that the process does not own.
fn fetch_name(state: u64, me: u64, addr: u64, dst: u64, max: u64) -> u64 {
    if addr == 0 {
        return neg(errno.E_FAULT)
    }
    if !proc.user_ok(state, me, addr, 1) {
        return neg(errno.E_FAULT)
    }
    var n: u64 = 0
    while n < max {
        if !proc.user_ok(state, me, addr + n, 1) {
            return neg(errno.E_FAULT)
        }
        let c: u64 = peek(state, me, addr + n)
        kstate.set8(dst + n, c as u8)
        if c == 0 {
            return n
        }
        n = n + 1
    }
    return neg(errno.E_NAMETOOLONG)
}

// Eight octets out of the caller's memory, one at a time. A pointer of
// ring 3 may straddle a page boundary, and `peek` is the only reader that
// checks every page it touches.
fn user_word(state: u64, me: u64, addr: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 8 {
        v = v | (peek(state, me, addr + i) << (i * 8))
        i = i + 1
    }
    return v
}

// ------------------------------------------------------- the descriptors

// The open file behind a descriptor, or MAX_OPEN. Everything below goes
// through this one function -- there is no second place that decides what
// a number in a register means.
fn of_of(state: u64, me: u64, fd: u64) -> u64 {
    return file.fd_of(state, me, fd)
}

fn writable(state: u64, of: u64) -> bool {
    let f: u64 = file.open_flags(state, of)
    if (f & 3) == O_WRONLY {
        return true
    }
    return (f & 3) == O_RDWR
}

fn readable(state: u64, of: u64) -> bool {
    return (file.open_flags(state, of) & 3) != O_WRONLY
}

// ------------------------------------------------------------- write

fn do_write(state: u64, me: u64, fd: u64, buf: u64, want: u64) -> u64 {
    var len: u64 = want
    if len > MAX_IO {
        len = MAX_IO
    }
    if !proc.user_ok(state, me, buf, len) {
        return neg(errno.E_FAULT)
    }
    // RUNDE HANDLE, TIEFENSTAFFELUNG, UND IN EINEM AUFRUF. Die
    // uid/gid-Frage hat `perm.may` beim OEFFNEN beantwortet und bleibt,
    // wo sie ist. Diese hier wird bei JEDEM Schreibzugriff gestellt und
    // fragt etwas anderes: traegt das HANDLE das Schreibrecht? Ein
    // weitergegebenes und dabei beschnittenes Handle faellt hier durch,
    // obwohl der Benutzer die Datei duerfte. POSIX hat dafuer nur
    // -EBADF, also gibt es -EBADF.
    //
    // `fd_check` und nicht `of_of` + `fd_may`: das waere die ganze
    // Aufloesung zweimal, und das ist gemessen der Unterschied zwischen
    // 109 und 296 Zyklen Aufschlag je Systemaufruf.
    let of: u64 = file.fd_check(state, me, fd, handle.R_WRITE)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    return write_of(state, me, of, buf, len)
}

// ==================================================== RUNDE MERGE-6
// EIN `write` AUS RING 3 BLEIBT EIN `write` -- AUCH MIT ACHT KERNEN.
//
// HIER STANDEN ZWEIMAL DIESELBEN VIER ZEILEN: Text aus Ring 3 nach
// `kstate.BLOCK_OFF` kopieren und von dort an das Terminal geben.
// `BLOCK_OFF` ist EIN Puffer von 4096 Oktetten in der Datenseite und
// gehoert der ganzen Maschine -- dieselbe Fehlerform wie `KSTACK_CUR`
// (VIELKERN 1) und `fs.buf_in` (VIELKERN 3), nur an der Stelle, an der
// dieses System seine Messwerte HERAUSGIBT.
//
// Solange Ring 3 auf Kern 0 blieb, war das richtig. Seit VIELKERN 3
// (5fe74f6, "scharf geschaltet -- die Vorgabe ist Ring 3 auf allen
// Kernen") ist es falsch, und es ist beim Zusammenfuehren mit der Runde
// WERKZEUGE aufgefallen. GEMESSEN, aus dem Mitschnitt eines Laufs mit
// vier Kernen und vier Ring-3-Programmen:
//
//     er: treffetaskmgr: start bww=7=i5=3 n2ame= [bTerhmin=al5] ...
//
// Das sind DREI Zeilen ineinander. Fuer einen Menschen ist es
// haesslich; fuer einen Pruefstand ist es das Ende der Messung. Die
// Zeile `wlib: win id=..`, aus der tools/werkzeug/klickplan.py JEDE
// Klickkoordinate holt, war in diesem Lauf ueberhaupt nicht mehr zu
// finden -- acht rote Zusagen der Runde WERKZEUGE, und keine davon
// hatte mit dem Aufgabenverwalter zu tun.
//
// DIE SPERRE IST DIE, DIE VIELKERN 3 SCHON GEBAUT HAT
// (`serial.zeile_an`/`zeile_aus`): je Kern wiedereintrittsfaehig, also
// verklemmt sie sich nicht gegen sich selbst, und BEGRENZT, also
// verschluckt ein Kern, der mit der Sperre in der Hand gestorben ist,
// die Ausgabe der anderen nicht. Sie lag bis hierher NUR um die Zeilen,
// die der KERN schreibt -- Ring 3 ging daran vorbei. Diese Funktion
// zieht sie ueber beides.
//
// SIE DECKT ZWEIERLEI AB, und beides ist noetig:
//   * den PUFFER: solange dieser Kern drin ist, kopiert kein anderer in
//     `BLOCK_OFF`, also gibt kein Kern den Text eines anderen aus;
//   * die REIHENFOLGE: ein `write` geht am Stueck auf die Leitung, statt
//     Zeichen fuer Zeichen mit einem fremden verzahnt zu werden.
//
// WAS SIE NICHT ABDECKT: die uebrigen dreiundvierzig Wege in dieser
// Datei, die `BLOCK_OFF` oder `NAME_OFF` anfassen. Sie stehen mit Zahl
// in docs/RUNDE-MERGE6.md und in tools/vielkern/einkern.py; die
// Ausgabe ist der erste, weil sie die einzige ist, deren Bruch eine
// ABNAHME zum Luegen bringt.
fn conout(state: u64, me: u64, t: u64, buf: u64, len: u64) -> u64 {
    let z: u64 = serial.zeile_an(cpu.here(state))
    let bounce: u64 = state + kstate.BLOCK_OFF
    if !copy_in(state, me, bounce, buf, len) {
        serial.zeile_aus(z)
        return neg(errno.E_FAULT)
    }
    let r: u64 = tty.write_out(state, t, bounce, len)
    serial.zeile_aus(z)
    return r
}

// Der Rumpf von `do_write`, aber auf einem EINTRAG DER OFFENEN DATEIEN
// statt auf einer Deskriptornummer. Aufgespalten fuer die native ABI: ein
// Handle zeigt auf genau diesen Eintrag, und es waere falsch, es vorher
// in eine Deskriptornummer zurueckzuuebersetzen -- die Nummer ist ja die
// Umgebungsautoritaet, die das Handle ersetzt. Laenge und Zeigerpruefung
// hat der Aufrufer schon gemacht.
fn write_of(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_CONOUT {
        // ROUND K9: durch das TERMINAL statt unmittelbar auf die
        // Leitung. Die Konsole hat `OPOST` aus (siehe `tty.init`), also
        // geht Oktett fuer Oktett unveraendert hindurch -- jede Messung
        // der Runden 62 bis K6 sieht genau dieselbe Ausgabe. Was sich
        // aendert, ist die eine Weiche in `tty.emit`: sagt Runde K7
        // dort SINK_SCREEN, geht dieselbe Ausgabe auf den Bildschirm,
        // ohne dass hier eine Zeile anders wird.
        return conout(state, me, tty_of(state, me), buf, len)
    }
    if kind == file.K_TTY {
        return conout(state, me, file.open_ino(state, of), buf, len)
    }
    if kind == file.K_PIPEW {
        return pipe_write(state, me, of, buf, len)
    }
    if kind == file.K_FB {
        return fb_write(state, me, of, buf, len)
    }
    if kind == file.K_SOCK {
        return sock_write(state, me, of, buf, len)
    }
    // ROUNDE K14: eine Datei auf einem eingehaengten Dateisystem.
    if kind == file.K_VFILE {
        return vfs_write(state, me, of, buf, len)
    }
    if kind == file.K_VDIR {
        return neg(errno.E_ISDIR)
    }
    if kind != file.K_FILE {
        return neg(errno.E_BADF)
    }
    if !writable(state, of) {
        return neg(errno.E_BADF)
    }
    // Through the data area: the file system never sees an address of a
    // process.
    let bounce: u64 = state + kstate.BLOCK_OFF
    if !copy_in(state, me, bounce, buf, len) {
        return neg(errno.E_FAULT)
    }
    let ino: u64 = file.open_ino(state, of)
    var off: u64 = file.open_off(state, of)
    if (file.open_flags(state, of) & O_APPEND) != 0 {
        off = fs.inode_size(state, ino)
    }
    let n: u64 = fs.write_at(state, ino, off, bounce, len)
    if n == 0 {
        if len != 0 {
            return neg(errno.E_NOSPC)
        }
    }
    file.open_set_off(state, of, off + n)
    return n
}

// -------------------------------------------------------------- read

fn do_read(state: u64, me: u64, fd: u64, buf: u64, want: u64) -> u64 {
    var len: u64 = want
    if len > MAX_IO {
        len = MAX_IO
    }
    if !proc.user_ok(state, me, buf, len) {
        return neg(errno.E_FAULT)
    }
    // Dieselbe zweite Frage wie in `do_write`, fuer die Leseseite --
    // und in demselben einen Aufruf.
    let of: u64 = file.fd_check(state, me, fd, handle.R_READ)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    return read_of(state, me, of, buf, len)
}

// Wie `write_of`, fuer die Leseseite.
fn read_of(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_CONIN {
        return console_read(state, me, buf, len)
    }
    if kind == file.K_TTY {
        return tty_read(state, me, file.open_ino(state, of), buf, len)
    }
    if kind == file.K_PIPER {
        return pipe_read(state, me, of, buf, len)
    }
    if kind == file.K_FB {
        return fb_read(state, me, of, buf, len)
    }
    if kind == file.K_SOCK {
        return sock_read(state, me, of, buf, len)
    }
    if kind == file.K_DIR || kind == file.K_VDIR {
        return neg(errno.E_ISDIR)
    }
    // ROUNDE K14.
    if kind == file.K_VFILE {
        return vfs_read(state, me, of, buf, len)
    }
    if kind != file.K_FILE {
        return neg(errno.E_BADF)
    }
    if !readable(state, of) {
        return neg(errno.E_BADF)
    }
    let bounce: u64 = state + kstate.BLOCK_OFF
    let ino: u64 = file.open_ino(state, of)
    let off: u64 = file.open_off(state, of)
    let n: u64 = fs.read_at(state, ino, off, bounce, len)
    if !copy_out(state, me, buf, bounce, n) {
        return neg(errno.E_FAULT)
    }
    file.open_set_off(state, of, off + n)
    return n
}

// ROUND K9 PUT A TERMINAL BETWEEN THE CONSOLE AND THE PROCESS.
//
// Bis hierher las `read` auf Deskriptor 0 unmittelbar aus zwei Quellen:
// dem Skript der Kommandozeile und dem Ring von `kbd.fi`. Der
// Rueckschritt wurde hier behandelt, ein Zeilenende hier erkannt, und ein
// STRG-C war ein Oktett wie jedes andere. Von dieser Runde an geht beides
// durch die ZEILENDISZIPLIN (`kernel/tty.fi`), und der Unterschied ist
// nicht kosmetisch:
//
//   * STRG-C ist jetzt ein SIGINT an die Vordergrund-Prozessgruppe und
//     kein Zeichen mehr, das irgendjemand liest.
//   * Der rohe Modus ist ein Schalter und keine zweite Leseschleife.
//   * Ein wartender Leser wird von einem Signal UNTERBROCHEN (-EINTR),
//     statt bis zum Ende seiner vier Sekunden zu warten. Ohne das taete
//     STRG-C in einer Shell, die auf eine Zeile wartet, gar nichts.
//
// Die beiden Quellen sind geblieben und ihre Reihenfolge auch: erst das
// Skript, dann die Tastatur. Neu ist nur, durch welche Tuer sie kommen --
// und weil es dieselbe Tuer ist, wirkt ein `^C` in einem Skript genau wie
// eines von der Tastatur. Das ist der Weg, auf dem `tools/unix/run.sh`
// STRG-C ohne einen Menschen davor messen kann.

// Welches Terminal zu dieser Aufgabe gehoert. T_TTY ist Nummer + 1, damit
// die Null "noch keines" heissen kann; wer keines hat, bekommt die
// Konsole -- das ist, was ein Prozess erbt, der nie etwas anderes
// verlangt hat.
fn tty_of(state: u64, me: u64) -> u64 {
    let t: u64 = sched.tget(state, me, sched.T_TTY)
    if t == 0 {
        return tty.console()
    }
    return t - 1
}

// Eine Zeile aus dem Skript in die Zeilendisziplin schieben. Zeilenweise
// und nicht auf einmal: der Ring des Terminals fasst 512 Oktette, die
// Kommandozeile darf 4096 haben, und ein Skript, dessen Ende still
// wegfaellt, waere ein Testlauf, der etwas anderes misst als er sagt.
fn script_feed(state: u64, t: u64) -> u64 {
    var pos: u64 = kstate.get(state, kstate.CONSOLE_POS)
    let end: u64 = kstate.get(state, kstate.CONSOLE_LEN)
    var n: u64 = 0
    var going: bool = true
    while going {
        if pos >= end {
            going = false
        } else {
            let c: u64 = kstate.get8(state + kstate.CONSOLE_OFF + pos)
            pos = pos + 1
            n = n + 1
            tty.push(state, t, c)
            if c == 10 {
                going = false
            }
        }
    }
    kstate.set(state, kstate.CONSOLE_POS, pos)
    return n
}

// Was fertig im Terminal liegt, in den Puffer des Prozesses. Hoert am
// Zeilenende auf -- das ist die Zusage des kanonischen Modus, und ein
// `read`, das zwei Zeilen auf einmal liefert, bricht jede Shell.
fn tty_drain(state: u64, me: u64, t: u64, buf: u64, len: u64) -> u64 {
    var n: u64 = 0
    var going: bool = true
    while going {
        if n >= len {
            going = false
        } else {
            let c: u64 = tty.take(state, t)
            if c == 256 {
                going = false
            } else {
                if !poke(state, me, buf + n, c) {
                    return neg(errno.E_FAULT)
                }
                n = n + 1
                if c == 10 {
                    going = false
                }
            }
        }
    }
    return n
}

// Wie lange die Konsole auf eine Taste wartet, bevor sie die Eingabe fuer
// beendet erklaert. 100 Hz, also vier Sekunden. Eine Shell, die ewig
// wartet, haette recht vor einem Menschen und unrecht in einem Testlauf:
// der Kernel koennte sich nie selbst beenden, und eine Messung, die in
// einem Zeitlimit endet, misst nichts.
const KEY_IDLE: u64 = 400

// DIE VORDERGRUNDPRUEFUNG. Wer nicht in der Vordergrundgruppe des
// Terminals steht und trotzdem lesen will, bekommt SIGTTIN -- so haelt
// ein Unix zwei Programme davon ab, sich dieselbe Tastatur zu teilen.
// Steht keine Gruppe im Terminal (bis eine Shell eine setzt), gilt die
// Pruefung nicht: dann gibt es keinen Vordergrund, gegen den zu pruefen
// waere, und jede Messung der Runden 62 bis K6 laeuft wie zuvor.
fn foreground_ok(state: u64, me: u64, t: u64) -> bool {
    let grp: u64 = tty.pgrp(state, t)
    if grp == 0 {
        return true
    }
    if sched.tget(state, me, sched.T_PGID) == grp {
        return true
    }
    signal.send_task(state, me, signal.SIGTTIN)
    return false
}

fn console_read(state: u64, me: u64, buf: u64, len: u64) -> u64 {
    return tty_read(state, me, tty_of(state, me), buf, len)
}

fn tty_read(state: u64, me: u64, t: u64, buf: u64, len: u64) -> u64 {
    if !tty.valid(state, t) {
        return neg(errno.E_NOTTY)
    }
    if !foreground_ok(state, me, t) {
        return neg(errno.E_INTR)
    }
    // Die Steuerseite eines Pseudoterminals liest, was die Nutzerseite
    // geschrieben hat -- nicht die Zeilendisziplin, sondern den rohen
    // Ausgabering.
    if tty.kind_of(state, t) == tty.K_PTY_MASTER {
        let p: u64 = tty.peer_of(state, t)
        var n: u64 = 0
        var rounds: u64 = 0
        while n == 0 && rounds < BLOCK_ROUNDS {
            while n < len && tty.out_waiting(state, p) != 0 {
                let c: u64 = tty.out_take(state, p)
                if c == 256 {
                    n = n
                } else {
                    if !poke(state, me, buf + n, c) {
                        return neg(errno.E_FAULT)
                    }
                    n = n + 1
                }
            }
            if n != 0 {
                return n
            }
            if signal.interrupted(state, me) {
                return neg(errno.E_INTR)
            }
            sched.sleep_ticks(state, 1)
            rounds = rounds + 1
        }
        return n
    }
    if tty.waiting(state, t) == 0 && t == tty.console() {
        script_feed(state, t)
    }
    var n: u64 = tty_drain(state, me, t, buf, len)
    if n != 0 {
        return n
    }
    if t == tty.console() && kstate.mode_on(state, kstate.M_NOKBD) {
        // Kein Skript mehr und keine Tastatur: das ist das ENDE DER
        // EINGABE, und null ist genau das -- kein Fehler.
        return 0
    }
    // RUNDE SERVERBUILD: WIE LANGE EINE KONSOLE WARTET, HAENGT DARAN,
    // OB EIN MENSCH DARAN SITZT.
    //
    // Die vier Sekunden oben sind richtig fuer einen Testlauf: der
    // Kernel muss sich selbst beenden koennen, und eine Messung, die
    // in einem Zeitlimit endet, misst nichts. Sie sind falsch fuer
    // einen Server, an dem jemand nachdenkt, bevor er tippt -- dort
    // waere die Shell nach vier Sekunden Stille am Ende der Eingabe
    // und faende sich in einem `exit` wieder.
    //
    // Mit `console=ttyS0` wartet die Konsole deshalb WIRKLICH: bis ein
    // Oktett kommt oder ein Signal den Leser unterbricht. Ohne das
    // Wort bleibt jede bestehende Messung auf den Tick genau, wie sie
    // war -- das ist der Grund, warum hier eine Bedingung steht und
    // nicht eine neue Zahl.
    // ===================================================== RUNDE TUERSCHLOSS
    //
    // UND DASSELBE GILT FUER DEN SCHREIBTISCH. Genau derselbe Satz wie
    // oben, nur ist der Mensch hier nicht per serieller Leitung da,
    // sondern sitzt mit Tastatur vor dem Terminalfenster.
    //
    // GEMESSEN (Runde DURCHKLICK): im Mitschnitt stehen `sh: ready, osum`
    // und `sh: bye` im Wechsel, 63 / 29 / 74 Paare je Lauf. Die Rechnung
    // dahinter: die Shell im Fenster liest die Konsole; nach KEY_IDLE
    // (400 Marken = 4 s) Stille kehrt dieses `read` mit NULL zurueck,
    // `ulib.rd_byte` macht daraus 256 = EOF, `get_line` gibt EOF, die
    // Schleife in `sh.u_start` endet -- und `wait_wm` startet sie im
    // Dauerbetrieb sofort wieder. Wer vier Sekunden lang nicht tippt,
    // verliert seine Shell. Das ist kein Terminal, das ist eine
    // Sanduhr.
    //
    // `M_WMDAUER` ist die richtige Bedingung und nicht `M_WM`: das Wort
    // steht genau auf den Eintraegen, die einen Schreibtisch FUER EINEN
    // MENSCHEN aufmachen (limine.conf), und genau dort ist das Zeitlimit
    // falsch. Jeder Testlauf ohne `wmdauer` behaelt seine 400 Marken auf
    // den Tick genau -- der Kernel muss sich selbst beenden koennen, und
    // eine Messung, die in einem Zeitlimit endet, misst nichts.
    //
    // Der Notausgang bleibt: `M_NOKBD` oben gibt weiter sofort null
    // zurueck (kein Skript, keine Tastatur = Ende der Eingabe), und
    // `signal.interrupted` unten bricht das Warten jederzeit ab.
    let endlos: bool = (sercon.active(state) && t == tty.console())
        || (kstate.mode_on(state, kstate.M_WMDAUER) && t == tty.console())
    var idle: u64 = 0
    while idle < KEY_IDLE {
        // ROUND K9: ein wartender Leser ist unterbrechbar. Das ist die
        // Zeile, an der STRG-C in einer Shell haengt, die auf eine Zeile
        // wartet -- ohne sie sitzt sie ihre vier Sekunden ab und stirbt
        // erst danach.
        if signal.interrupted(state, me) {
            return neg(errno.E_INTR)
        }
        // RUNDE SERVERBUILD: selbst nachsehen. Ohne `console=` tut das
        // nichts; mit `noserirq` ist es der einzige Weg, auf dem noch
        // etwas hereinkommt, und genau das misst die Gegenprobe.
        sercon.poll(state)
        if tty.waiting(state, t) != 0 {
            return tty_drain(state, me, t, buf, len)
        }
        sched.sleep_ticks(state, 1)
        if !endlos {
            idle = idle + 1
        }
    }
    return 0
}


// ==================================================================
// RUNDE SERVERBUILD: DIE KONSTANTEN DER OBERFLAECHE BLEIBEN HIER
// ==================================================================
//
// Die Funktionen, die diese Namen benutzen, stehen seit dieser Runde
// in `kernel/sysgui.fi` -- die NAMEN nicht. Sie sind die ABI: die
// Aufrufnummern, die ein Programm in Ring 3 schreibt, und die
// Feldnummern, die es in einen Puffer liest. `kernel/sys.fi` ist die
// Tafel, an der Ring 3 anklopft, und eine Tafel, deren Haelfte
// woanders haengt, ist keine.
//
// ES IST AUSSERDEM GEMESSEN WORDEN, DASS ES SO SEIN MUSS. Beim
// ersten Anlauf zogen die Konstanten mit, und drei Abschnitte der
// Abnahme sagten sofort, warum das nicht geht: `tools/display`
// zaehlt nach, dass GENAU DREI Nummern aus 1810..1819 in `sys.fi`
// stehen und KEINE ausserhalb; `tools/desktop` sucht
// `const WM_MAXNR: u64 = 2113` in `sys.fi`; `tools/k15` sucht
// `const WIG_MAXNR: u64 = 1809` ebenda. Alle drei haben recht.
//
// Was hier steht, stand vor dieser Runde an genau denselben Stellen
// dieser Datei und mit genau denselben Werten; nur beieinander.

const WM_CREATE: u64 = 2100 // (xy, wh, titel, art) -> Handle
const WM_FILL: u64 = 2101 // (h, xy, wh, farbe) -> 0
const WM_TEXT: u64 = 2102 // (h, xy, p, n, farbe) -> x hinter dem Text
const WM_EVENT: u64 = 2103 // (h, aus) -> 1 = eines geholt, 0 = keines
const WM_INFO: u64 = 2104 // (h, was) -> Zahl
const WM_FLUSH: u64 = 2105 // (h) -> 0
const WM_MOVE: u64 = 2106 // (h, xy) -> 0
const WM_CLOSE: u64 = 2107 // (h) -> 0
const WM_WRITE: u64 = 2108 // (h, p, n) -> Oktette (nur Terminalfenster)
// ------------------------------------------------- RUNDE DESKTOP
//
// DREI AUFRUFE, und sie stehen hier im Block des Fensterservers und
// nicht in einem eigenen Hunderterblock: sie reden ueber FENSTER, und
// eine zweite Nummernfamilie fuer dieselbe Sache waere genau die
// Uebersetzungstabelle, die die Regel oben vermeidet.
//
// WM_STATE aendert das EIGENE Fenster und braucht R_MANAGE, wie
// WM_MOVE. Ebene 0 (Schreibtisch) und Ebene 2 (Taskleiste) sind
// zusaetzlich der Wurzel vorbehalten -- wer sich selbst nach ganz vorn
// legen darf, kann jede Oberflaeche nachbauen.
//
// WM_LIST und WM_ACT reden ueber FREMDE Fenster und haben deshalb KEIN
// Handle: die Taskleiste bekommt fuer das Fenster eines anderen
// Prozesses keines, und ein Platz in der Tafel waere eine Zahl, die
// sich unter ihr aendert. Beide verlangen dafuer, dass der Rufende
// selbst ein Fenster auf Ebene L_TOP hat -- er MUSS eine Taskleiste
// sein. Eine gewoehnliche Anwendung bekommt -E_RIGHTS und sieht die
// Titel der anderen NICHT.
const WM_STATE: u64 = 2109 // (h, was, wert) -> 0, braucht R_MANAGE
const WM_LIST: u64 = 2110 // (platz, aus, max) -> 1 belegt, 0 frei
const WM_ACT: u64 = 2111 // (fensternummer, was) -> 0
// ---------------------------------------- ADDENDUM TASKBAR: the strut
//
// WM_STRUT declares that the caller's own window occupies `size` pixels
// of screen edge `edge`; the server subtracts every such reservation
// from the screen and calls the rest the work area (kernel/wm.fi). It
// needs R_MANAGE like WM_MOVE, and beyond that the window must lie on
// layer L_DESK or L_TOP -- reserving a screen edge is what a panel
// does, not what an application does, and layer L_TOP already belongs
// to root alone.
const WM_STRUT: u64 = 2112 // (h, edge, size) -> 0, braucht R_MANAGE
// WM_SIZE resizes the caller's OWN window. Until this addendum a window
// had the size it was created with, for ever: `wm.resize_win` existed
// and only the server itself called it, from the resize grip. A taskbar
// that changes from a horizontal to a vertical bar needs it, and so
// does auto-hide, which slides the bar out to a two-pixel sliver and
// back. The buffer is NOT reallocated -- a window cannot grow past the
// buffer it was created with, and `wm.resize_win` refuses instead of
// lying.
const WM_SIZE: u64 = 2113 // (h, wh) -> 0, braucht R_MANAGE
const WE_RIGHT: u64 = 3
// RUNDE THEME: DIE FARBEN DER FENSTERDEKORATION.
//
// Rahmen und Titelleiste malt der Server, weil er das Bild
// zusammensetzt -- und damit sass die einzige Stelle der Oberflaeche,
// die ihre Farbe selbst wusste, im Kernel. Dieser Aufruf dreht das um:
// der Server haelt acht Zahlen, und was hineinkommt, entscheidet Ring 3
// aus den Marken des Themas. Der Kernel bekommt keine Meinung darueber,
// wie ein Fenster aussieht, er bekommt das Ergebnis.
//
// Dasselbe Recht wie WM_ACT: der Rufende muss selbst ein Fenster auf
// Ebene L_TOP haben, also eine TASKLEISTE sein. Duerfte das jede
// Anwendung, koennte jede Anwendung jede fremde Titelleiste faerben.
// MERGE: 2112 gehoert seit dem Taskleisten-Nachtrag WM_STRUT und 2113
// WM_SIZE. Zwei Runden haben unabhaengig voneinander die naechste freie
// Nummer genommen; diese hier rueckt auf 2114.
// RUNDE THEME: DIE FARBEN DER FENSTERDEKORATION.
//
// Rahmen und Titelleiste malt der Server, weil er das Bild
// zusammensetzt -- und damit sass die einzige Stelle der Oberflaeche,
// die ihre Farbe selbst wusste, im Kernel. Dieser Aufruf dreht das um:
// der Server haelt acht Zahlen, und was hineinkommt, entscheidet Ring 3
// aus den Marken des Themas. Der Kernel bekommt keine Meinung darueber,
// wie ein Fenster aussieht, er bekommt das Ergebnis.
//
// Dasselbe Recht wie WM_ACT: der Rufende muss selbst ein Fenster auf
// Ebene L_TOP haben, also eine TASKLEISTE sein. Duerfte das jede
// Anwendung, koennte jede Anwendung jede fremde Titelleiste faerben.
// MERGE: 2112 gehoert seit dem Taskleisten-Nachtrag WM_STRUT und 2113
