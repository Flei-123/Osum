// -------------------------------------------------------------- pipes

// A reader waits for as long as somebody could still write. When the last
// writer is gone, an empty pipe is the END of the input -- 0, not an
// error, and that is what makes `cat` in a pipeline stop.
fn pipe_read(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    let p: u64 = file.open_ino(state, of)
    var waited: u64 = 0
    while file.pipe_bytes(state, p) == 0 {
        if file.pipe_writers(state, p) == 0 {
            return 0
        }
        if waited >= BLOCK_ROUNDS {
            return neg(errno.E_AGAIN)
        }
        waited = waited + 1
        sched.sleep_ticks(state, 1)
    }
    var n: u64 = 0
    var going: bool = true
    while going {
        if n >= len {
            going = false
        } else {
            let c: u64 = file.pipe_get(state, p)
            if c > 255 {
                going = false
            } else {
                if !poke(state, me, buf + n, c) {
                    return neg(errno.E_FAULT)
                }
                n = n + 1
            }
        }
    }
    // RUNDE POLL: was gelesen wurde, ist PLATZ -- ein Schreiber, der in
    // `poll` auf POLLOUT wartet, wird davon wach. Einmal je Aufruf und
    // nicht je Oktett: ein Wecker kostet einen Durchlauf ueber die
    // Aufgabentafel, und 4096 davon je `read` waeren genau die
    // Warteschleife, die diese Runde abschaffen soll.
    if n != 0 {
        sched.poll_kick(state)
    }
    return n
}

// A writer into a pipe nobody reads gets -EPIPE. On a full pipe it waits;
// what it could place before that is a SHORT write, which is what the
// interface has always allowed.
fn pipe_write(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    let p: u64 = file.open_ino(state, of)
    var n: u64 = 0
    var waited: u64 = 0
    var going: bool = true
    while going {
        if n >= len {
            going = false
        } else {
            if file.pipe_readers(state, p) == 0 {
                if n > 0 {
                    return n
                }
                return neg(errno.E_PIPE)
            }
            if file.pipe_room(state, p) == 0 {
                if waited >= BLOCK_ROUNDS {
                    going = false
                } else {
                    waited = waited + 1
                    sched.sleep_ticks(state, 1)
                }
            } else {
                if !file.pipe_put(state, p, peek(state, me, buf + n)) {
                    going = false
                } else {
                    n = n + 1
                }
            }
        }
    }
    // RUNDE POLL: JETZT ist der Leser lesbar. Ohne diese Zeile wartet
    // ein `poll` auf der anderen Seite bis zu seinem Zeitablauf, obwohl
    // die Oktette schon im Rohr liegen.
    if n != 0 {
        sched.poll_kick(state)
    }
    if n == 0 {
        if len != 0 {
            return neg(errno.E_AGAIN)
        }
    }
    return n
}

fn do_pipe(state: u64, me: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, 8) {
        return neg(errno.E_FAULT)
    }
    let p: u64 = file.pipe_new(state)
    if p >= file.MAX_PIPES {
        return neg(errno.E_NFILE)
    }
    let rd: u64 = file.open_alloc(state, file.K_PIPER, p, 0)
    if rd >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let wr: u64 = file.open_alloc(state, file.K_PIPEW, p, O_WRONLY)
    if wr >= file.MAX_OPEN {
        unref_of(state, rd)
        return neg(errno.E_NFILE)
    }
    let fd0: u64 = file.fd_alloc(state, me, 0)
    if fd0 >= file.MAX_FD {
        unref_of(state, rd)
        unref_of(state, wr)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd0, rd)
    let fd1: u64 = file.fd_alloc(state, me, 0)
    if fd1 >= file.MAX_FD {
        file.fd_free(state, me, fd0)
        unref_of(state, rd)
        unref_of(state, wr)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd1, wr)
    // Two `int`s, four octets each -- the shape Linux writes.
    if !put32(state, me, out, fd0) {
        return neg(errno.E_FAULT)
    }
    if !put32(state, me, out + 4, fd1) {
        return neg(errno.E_FAULT)
    }
    return 0
}

fn put32(state: u64, me: u64, addr: u64, v: u64) -> bool {
    var i: u64 = 0
    while i < 4 {
        if !poke(state, me, addr + i, (v >> (i * 8)) & 255) {
            return false
        }
        i = i + 1
    }
    return true
}

// ============================================== RUNDE POLL: DAS WARTEN
//
// WARUM DIESER AUFRUF DER WICHTIGSTE FEHLENDE WAR. Bis zu dieser Runde
// konnte ein Prozess dieses Systems auf GENAU EINE Sache warten: den
// Deskriptor, aus dem er gerade liest. Jeder Helfer, der ein Netz UND
// ein Kind bedient, muss auf ZWEI warten -- und ohne `poll` bleibt nur
// der Wechsel zwischen zwei nicht blockierenden Lesevorgaengen mit
// einem Schlaf dazwischen. Das ist eine Warteschleife: sie kostet
// Rechenzeit, wenn nichts los ist, und sie kostet Verzoegerung, wenn
// etwas los ist. Jede Shell braucht denselben Aufruf.
//
// WIE HIER GEWARTET WIRD, und das ist der Unterschied zu allem anderen
// in dieser Datei: `pipe_read`, `tty_read` und `sock_io` schlafen je
// eine Zeitscheibe und sehen wieder nach (`sched.sleep_ticks(state, 1)`)
// -- hundertmal je Sekunde, ob etwas da ist oder nicht. `poll` tut das
// NICHT. Es legt sich in den Zustand S_POLL und wird von der Stelle
// geweckt, an der die Daten ankommen (`sched.poll_kick`, gerufen aus
// `pipe_write`, aus dem Schliessen eines Rohres, aus `inet.pump` und aus
// der Zeilendisziplin). Ohne Ereignis und ohne Zeitablauf laeuft dabei
// KEINE Anweisung dieses Prozesses.
//
// UND DIE WETTLAUFSITUATION, an der die erste Fassung jedes `poll`
// scheitert -- zwischen `nichts ist bereit` und `ich schlafe` trifft
// das Ereignis ein und der Wecker geht an niemanden --, ist mit der
// Weckfolge geloest: der Stand VOR der Pruefung wird gemerkt, und
// `sched.poll_sleep` legt sich nur schlafen, wenn er sich nicht bewegt
// hat. Die drei Funktionen und die Begruendung stehen in
// `kernel/sched.fi`.

// Vier Oktette aus Ring 3, wie `put32` sie schreibt.
fn get32(state: u64, me: u64, addr: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 4 {
        v = v | (peek(state, me, addr + i) << (i * 8))
        i = i + 1
    }
    return v
}

fn get16(state: u64, me: u64, addr: u64) -> u64 {
    return peek(state, me, addr) | (peek(state, me, addr + 1) << 8)
}

fn put16(state: u64, me: u64, addr: u64, v: u64) -> bool {
    if !poke(state, me, addr, v & 255) {
        return false
    }
    return poke(state, me, addr + 1, (v >> 8) & 255)
}

// Was auf DIESER Steckdose gerade moeglich ist.
fn poll_sock(state: u64, of: u64) -> u64 {
    let si: u64 = file.open_ino(state, of)
    if si >= inet.SOCK_MAX {
        return POLLNVAL
    }
    var r: u64 = 0
    if inet.sock_error(state, si) != 0 {
        r = r | POLLERR
    }
    // Ein LAUSCHER ist lesbar, wenn `accept` etwas herausgeben wuerde --
    // und `inet.sock_acceptable` stellt das fest, ohne die Verbindung
    // dabei anzunehmen. Ein Lauscher hat sonst nichts zu melden.
    if inet.sock_acceptable(state, si) != 0 {
        return r | POLLIN
    }
    if inet.sock_readable(state, si) != 0 {
        r = r | POLLIN
    }
    if inet.sock_writable(state, si) != 0 {
        r = r | POLLOUT
    }
    if inet.sock_hup(state, si) != 0 {
        r = r | POLLHUP
    }
    return r
}

// Was auf DIESEM Deskriptor gerade moeglich ist -- unabhaengig davon,
// wonach gefragt wurde. Das Abgleichen mit `events` macht der Aufrufer.
fn poll_ready(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return POLLNVAL
    }
    let kind: u64 = file.open_kind(state, of)
    var r: u64 = 0
    // DIE LESESEITE EINES ROHRES. Oktette darin sind POLLIN. Kein
    // Schreiber mehr ist POLLHUP -- und POLLIN steht daneben und nicht
    // statt dessen, solange noch etwas im Rohr liegt: was geschrieben
    // wurde, bevor das Gegenende ging, darf gelesen werden.
    if kind == file.K_PIPER {
        let p: u64 = file.open_ino(state, of)
        if file.pipe_bytes(state, p) != 0 {
            r = r | POLLIN
        }
        if file.pipe_writers(state, p) == 0 {
            r = r | POLLHUP
        }
        return r
    }
    // DIE SCHREIBSEITE. Platz ist POLLOUT; kein Leser mehr ist POLLERR
    // -- ein `write` darauf gaebe -EPIPE, und das ist ein Fehler und
    // kein Dateiende.
    if kind == file.K_PIPEW {
        let p: u64 = file.open_ino(state, of)
        if file.pipe_readers(state, p) == 0 {
            return POLLERR
        }
        if file.pipe_room(state, p) != 0 {
            r = r | POLLOUT
        }
        return r
    }
    if kind == file.K_SOCK {
        return poll_sock(state, of)
    }
    // TERMINAL UND KONSOLE. Lesbar, sobald die Zeilendisziplin ein
    // fertiges Oktett hat; auf der Steuerseite eines Pseudoterminals
    // ist es der rohe Ausgabering der Nutzerseite. Schreibbar immer:
    // ein Terminal nimmt jederzeit Oktette an.
    if kind == file.K_TTY || kind == file.K_CONIN {
        var t: u64 = file.open_ino(state, of)
        if kind == file.K_CONIN {
            t = tty_of(state, me)
        }
        if !tty.valid(state, t) {
            return POLLNVAL
        }
        if tty.kind_of(state, t) == tty.K_PTY_MASTER {
            if tty.out_waiting(state, tty.peer_of(state, t)) != 0 {
                r = r | POLLIN
            }
        } else {
            if tty.waiting(state, t) != 0 {
                r = r | POLLIN
            }
        }
        return r | POLLOUT
    }
    if kind == file.K_CONOUT || kind == file.K_FB {
        return POLLOUT
    }
    if kind == file.K_FREE {
        return POLLNVAL
    }
    // EINE GEWOEHNLICHE DATEI IST IMMER BEREIT. Das ist keine Bequem-
    // lichkeit, sondern was POSIX verlangt: eine Datei laesst sich
    // jederzeit lesen und schreiben, notfalls bis zum Dateiende -- ein
    // `poll`, das darauf wartete, wartete fuer immer.
    return POLLIN | POLLOUT
}

// EIN Durchgang ueber die Liste. Schreibt `revents` zurueck und gibt die
// Zahl der Eintraege mit einem Ereignis. `bad` wird gesetzt, wenn der
// Speicher des Aufrufers nicht mitspielt.
fn poll_scan(state: u64, me: u64, fds: u64, nfds: u64, bad: *mut u64) -> u64 {
    var ready: u64 = 0
    var i: u64 = 0
    while i < nfds {
        let a: u64 = fds + i * 8
        let raw: u64 = get32(state, me, a)
        let ev: u64 = get16(state, me, a + 4)
        var re: u64 = 0
        // Ein negativer Deskriptor wird UEBERGANGEN und seine revents
        // auf null gesetzt. Das ist die Stelle, an der ein Programm
        // einen Eintrag abschaltet, ohne die Liste umzubauen.
        if (raw & 0x80000000) == 0 {
            re = poll_ready(state, me, raw)
            // POLLERR, POLLHUP und POLLNVAL kommen IMMER, auch wenn
            // niemand nach ihnen gefragt hat -- so steht es in POSIX,
            // und ein Programm, das nur POLLIN anfordert, muss von
            // einem geschlossenen Gegenende trotzdem erfahren.
            re = re & (ev | POLLERR | POLLHUP | POLLNVAL)
        }
        if !put16(state, me, a + 6, re) {
            *bad = 1
            return ready
        }
        if re != 0 {
            ready = ready + 1
        }
        i = i + 1
    }
    return ready
}

fn do_poll(state: u64, me: u64, fds: u64, nfds: u64, tmo: u64) -> u64 {
    if nfds > POLL_MAX {
        return neg(errno.E_INVAL)
    }
    if nfds != 0 && !proc.user_ok(state, me, fds, nfds * 8) {
        return neg(errno.E_FAULT)
    }
    // `timeout` ist ein `int`. Ein negativer -- vorzeichenerweitert oder
    // nicht -- heisst OHNE FRIST. Alles ab 0x80000000 als `ohne Frist`
    // zu lesen kostet nichts: 2^31 Millisekunden sind 24 Tage.
    let forever: bool = tmo >= 0x80000000
    // Der Zeitgeber laeuft mit 100 Hz, eine Marke ist 10 ms. AUFGERUNDET,
    // damit ein `poll` NIE FRUEHER zurueckkommt als verlangt -- das ist
    // die Richtung, die POSIX vorschreibt, und die einzige, die ein
    // Programm nicht selbst nachbessern kann.
    var ticks: u64 = 0
    if !forever && tmo != 0 {
        // AUFRUNDEN, UND DANN EINE MARKE MEHR. Die zweite ist nicht
        // Grosszuegigkeit: der Zaehler `kstate.TICKS` steht schon
        // MITTEN in der laufenden Marke, wenn dieser Aufruf ihn liest.
        // Ein `poll(300)`, das auf TICKS+30 wartet, wartet in
        // Wirklichkeit zwischen 290 und 300 Millisekunden -- gemessen
        // hat der erste Lauf dieser Runde 293. Zu FRUEH zurueckzukommen
        // ist das eine, was POSIX `poll` verbietet und was ein Programm
        // nicht selbst nachbessern kann; zu spaet ist erlaubt. Also die
        // angebrochene Marke mitzaehlen: die Frist liegt damit zwischen
        // `timeout` und `timeout + 10 ms`.
        ticks = (tmo + 9) / 10 + 1
    }
    let deadline: u64 = kstate.get(state, kstate.TICKS) + ticks
    var bad: u64 = 0
    var going: bool = true
    while going {
        // ZUERST die Weckfolge merken, DANN nachsehen. Andersherum
        // liefe das Ereignis, das waehrend des Nachsehens eintrifft,
        // in den Schlaf hinein und waere verloren.
        let seen: u64 = sched.poll_seq(state)
        let ready: u64 = poll_scan(state, me, fds, nfds, &bad)
        if bad != 0 {
            return neg(errno.E_FAULT)
        }
        if ready != 0 {
            return ready
        }
        // Ein Signal beendet das Warten mit -EINTR, wie jeder andere
        // blockierende Aufruf dieses Kerns seit Runde K9.
        if signal.interrupted(state, me) {
            return neg(errno.E_INTR)
        }
        if !forever && kstate.get(state, kstate.TICKS) >= deadline {
            return 0
        }
        var wake: u64 = deadline
        if forever {
            wake = sched.POLL_FOREVER
        }
        sched.poll_sleep(state, seen, wake)
    }
    return 0
}

// ------------------------------------------------------------ the files

// `open(path, flags, mode)`. The flags are Linux's: O_CREAT is 0o100, not
// a boolean second argument the way round 62 had it.
// ------------------------------------------------- ROUNDE K7: /dev/fb
//
// DIE RECHTE SIND DIE UEBLICHEN, und das ist der Punkt. Ein Programm in
// Ring 3 bekommt den Bildschirm nicht, weil es der Kernel ist -- es
// bekommt ihn ueber `open`, und danach entscheidet derselbe Deskriptor
// mit denselben Flags wie bei jeder Datei, ob es schreiben darf:
//
//   * `open("/dev/fb", O_RDONLY)` -> `write` ist -EBADF
//   * `write` hinter dem Ende des Bildes -> 0 Oktette, kein Fehler
//   * `mmap` mit PROT_WRITE auf einen nur lesbaren Deskriptor -> -EACCES
//   * `mmap` ohne MAP_ANONYMOUS auf irgendeinen ANDEREN Deskriptor
//     -> -ENODEV, wie vorher
//
// Der Kernel schreibt dabei kein einziges Oktett fuer das Programm, das
// er nicht auch fuer eine Datei schreiben wuerde: `copy_in` prueft den
// Zeiger, die Grenze des Geraets kappt die Laenge, und der Rest ist eine
// Kopie.

fn is_devfb(state: u64, buf: u64, len: u64) -> bool {
    var name: [u8; 8] = "/dev/fb\0"
    if len != 7 {
        return false
    }
    var i: u64 = 0
    while i < 7 {
        if kstate.get8(buf + i) != (name[i as usize] as u64) {
            return false
        }
        i = i + 1
    }
    return true
}

fn open_devfb(state: u64, me: u64, flags: u64) -> u64 {
    if !gfx.fb_ready(state) {
        return neg(errno.E_NODEV)
    }
    if (flags & O_DIRECTORY) != 0 {
        return neg(errno.E_NOTDIR)
    }
    let of: u64 = file.open_alloc(state, file.K_FB, 0, flags)
    if of >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    return fd
}

fn fb_write(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    if !writable(state, of) {
        return neg(errno.E_BADF)
    }
    if !gfx.fb_ready(state) {
        return neg(errno.E_NODEV)
    }
    let off: u64 = file.open_off(state, of)
    if off >= gfx.fb_bytes(state) {
        return 0 // das Ende des Geraets, wie das Ende einer Datei
    }
    var n: u64 = len
    if n > MAX_IO {
        n = MAX_IO
    }
    // Ueber den Datenbereich, wie bei einer Datei: die Karte sieht nie
    // eine Adresse eines Prozesses.
    let bounce: u64 = state + kstate.BLOCK_OFF
    if !copy_in(state, me, bounce, buf, n) {
        return neg(errno.E_FAULT)
    }
    // `fb.write_bytes` legt die Oktette auf die KARTE, nicht in den
    // Zweitpuffer der Konsole -- siehe den Absatz darueber in `fb.fi`.
    // Ein Schreibzugriff auf ein Geraet ist damit erledigt, wenn er
    // zurueckkehrt, und braucht keine Uebertragung hinterher.
    let k: u64 = gfx.fb_write_bytes(state, off, bounce, n)
    file.open_set_off(state, of, off + k)
    return k
}

fn fb_read(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    if !readable(state, of) {
        return neg(errno.E_BADF)
    }
    if !gfx.fb_ready(state) {
        return neg(errno.E_NODEV)
    }
    let off: u64 = file.open_off(state, of)
    let bounce: u64 = state + kstate.BLOCK_OFF
    let k: u64 = gfx.fb_read_bytes(state, off, bounce, len)
    if !copy_out(state, me, buf, bounce, k) {
        return neg(errno.E_FAULT)
    }
    file.open_set_off(state, of, off + k)
    return k
}

// Welche Rechte die Flaggen von `open` wirklich verlangen.
//
//     O_RDONLY (0)  -> lesen
//     O_WRONLY (1)  -> schreiben
//     O_RDWR   (2)  -> beides
//     O_TRUNC       -> schreiben, auch wenn nur gelesen wuerde
//
// Eine eigene Funktion und keine vier Zeilen in `do_open`: der Rahmen
// von `do_open` liegt auf dem tiefsten Weg dieses Kernels, und firnc
// gibt jedem Zwischenwert dort einen eigenen Platz (s. `k13_call`).
fn want_of(flags: u64) -> u64 {
    var want: u64 = perm.R_READ
    if (flags & 3) == 1 {
        want = perm.R_WRITE
    }
    if (flags & 3) == 2 {
        want = perm.R_READ | perm.R_WRITE
    }
    if (flags & O_TRUNC) != 0 {
        want = want | perm.R_WRITE
    }
    return want
}

// Darf in diesem VERZEICHNIS geoeffnet oder angelegt werden? Betreten
// muss man es immer, beschreiben nur, wenn etwas Neues entsteht. Die
// Wurzel wird uebergangen -- sie hat kein Elternverzeichnis, und
// `parent_of` gaebe dort 0 zurueck.
fn dir_allowed(state: u64, me: u64, path: u64, ino: u64) -> bool {
    if ino == fs.root(state) {
        return true
    }
    let dir: u64 = fs.parent_ino(state, path)
    if dir == 0 {
        return true // kein Verzeichnis gefunden: `fs.path` sagt es gleich
    }
    var dwant: u64 = perm.R_EXEC
    if ino == 0 {
        dwant = perm.R_EXEC | perm.R_WRITE // anlegen
    }
    return perm.may(state, me, dir, dwant)
}

// =========================================== RUNDE K14: lesen, schreiben
//
// Derselbe Weg, den `read_of` und `write_of` fuer eine OFS-Datei gehen
// -- ueber den Zwischenpuffer im Kerneldatenbereich, damit KEIN
// Dateisystem je eine Adresse eines Prozesses zu sehen bekommt. Das
// ist Regel 3 aus dem Kopf dieser Datei, und sie gilt fuer einen
// fremden Treiber erst recht: FAT32 rechnet mit Zahlen aus einem
// Bootsektor, den irgendjemand geschrieben hat.
// RUNDE K17: DAS GERAET UNTER DIESER EINHAENGUNG KANN WEG SEIN.
//
// Bis zu dieser Runde konnte es das nicht: eine ATA-Platte, ein
// NVMe-Regler und eine RAM-Platte verschwinden nicht im Betrieb. Ein
// USB-Stick tut es -- und dann steht ein Prozess mit einem offenen
// Deskriptor da, dessen Dateisystem es nicht mehr gibt.
//
// Die Antwort ist ENODEV und nicht EIO: EIO hiesse "der Lesevorgang ist
// schiefgegangen", und das laedt zum Wiederholen ein. ENODEV heisst "das
// Geraet gibt es nicht mehr", und dabei bleibt es. Die Pruefung steht an
// EINER Stelle -- am Deskriptor, nicht im Treiber -- und gilt damit fuer
// jedes Dateisystem auf jedem Geraet, das verschwinden kann.
fn mnt_gone(state: u64, m: u64) -> bool {
    if m >= vfs.MAX_MNT || !mnt.used(state, m) {
        return false
    }
    // NUR GERAETE FRAGEN, DIE VERSCHWINDEN KOENNEN. Der Grund steht in
    // `blk.removable`, und er hat eine Stunde gekostet: `present_on`
    // schreibt fuer eine ATA-Platte in das Laufwerksregister, und das
    // bei jedem Lesen und Schreiben zu tun, greift in die Uebertragung
    // ein, die gerade laeuft.
    let dev: u64 = mnt.dev(state, m)
    if !blk.removable(dev) {
        return false
    }
    return !blk.present_on(state, dev)
}

fn vfs_read(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    if !readable(state, of) {
        return neg(errno.E_BADF)
    }
    let m: u64 = file.open_mnt(state, of)
    if mnt_gone(state, m) {
        return neg(errno.E_NODEV)
    }
    let node: u64 = file.open_ino(state, of)
    let off: u64 = file.open_off(state, of)
    let bounce: u64 = state + kstate.BLOCK_OFF
    var want: u64 = len
    if want > kstate.BLOCK_MAX {
        want = kstate.BLOCK_MAX
    }
    let n: u64 = vfs.v_read(state, m, node, off, bounce, want)
    if !copy_out(state, me, buf, bounce, n) {
        return neg(errno.E_FAULT)
    }
    file.open_set_off(state, of, off + n)
    return n
}

fn vfs_write(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    if !writable(state, of) {
        return neg(errno.E_BADF)
    }
    let m: u64 = file.open_mnt(state, of)
    if mnt_gone(state, m) {
        return neg(errno.E_NODEV)
    }
    let node: u64 = file.open_ino(state, of)
    var off: u64 = file.open_off(state, of)
    if (file.open_flags(state, of) & O_APPEND) != 0 {
        off = vfs.v_attr(state, m, node, vfsops.A_SIZE)
    }
    let bounce: u64 = state + kstate.BLOCK_OFF
    var want: u64 = len
    if want > kstate.BLOCK_MAX {
        want = kstate.BLOCK_MAX
    }
    if !copy_in(state, me, bounce, buf, want) {
        return neg(errno.E_FAULT)
    }
    let n: u64 = vfs.v_write(state, m, node, off, bounce, want)
    if errno.is_error(n) {
        return n
    }
    if n == 0 && want != 0 {
        return neg(errno.E_NOSPC)
    }
    file.open_set_off(state, of, off + n)
    return n
}

// ================================================== RUNDE K14: oeffnen
//
// Ein Name auf einem eingehaengten Dateisystem. Alles, was hier
// passiert, geht ueber `vfs.*` -- der Name `fs.` kommt nicht vor, und
// das ist die Zusage: OFS ist hier kein Sonderfall, sondern der Fall
// mit der Nummer 0.
//
// ZWEI GERAETE SIND ANDERS, und zwar mit Absicht: ein Knoten von
// /dev, der ein TERMINAL oder der RAHMENPUFFER ist, wird zu genau dem
// Deskriptor, den Runde K9 und Runde K7 dafuer gebaut haben (K_TTY,
// K_FB). Ein zweiter Weg auf dasselbe Geraet waere eine zweite Stelle,
// an der die Zeilendisziplin steht -- und die zweite waere irgendwann
// die falsche.
// RUNDE MULTIUSER: die Rechtefrage fuer einen Knoten der VFS-Schicht.
//
// Sie steht HIER und nicht in `vfs.fi`, und das ist derselbe Grund, aus
// dem K13 `perm.fi` geschrieben hat: es soll EINE Regel geben. `vfs.fi`
// kennt kein Dateisystem und keine Aufgabe -- es liefert die drei
// Zahlen, und die Regel darauf ist die von `perm.may_attr`, dieselbe,
// die die Wurzel benutzt. Waere sie in `vfs.fi` noch einmal
// hingeschrieben, gaebe es zwei Stellen, an denen jemand einen Fall
// vergessen kann.
fn vfs_may(state: u64, me: u64, m: u64, node: u64, want: u64) -> bool {
    kstate.add(state, kstate.MU_OFF + kstate.MU_NODECHK, 1)
    let mode: u64 = vfs.v_attr(state, m, node, vfsops.A_MODE)
    let owner: u64 = vfs.v_attr(state, m, node, vfsops.A_UID)
    let group: u64 = vfs.v_attr(state, m, node, vfsops.A_GID)
    let ist_dir: bool = vfs.v_attr(state, m, node, vfsops.A_TYPE)
        == vfsops.N_DIR
    return perm.may_attr(state, me, mode, owner, group, want,
        perm.euid(state, me), perm.egid(state, me), ist_dir)
}

// RUNDE MULTIUSER: RECHTE UND EIGENTUEMER EINER NEU ANGELEGTEN DATEI --
// AUCH AUF DIESEM WEG.
//
// GEMESSEN, NICHT VERMUTET. Der gerade Weg ruft `perm.on_create`, seit
// K13. Der Weg ueber die Ops-Tafel rief nichts: eine Inode kommt
// GENULLT aus `fs.inode_alloc`, also bekam jede mit `vfsall` angelegte
// Datei den Modus 0 und den Eigentuemer 0. `tools/k14/run.sh`
// Abschnitt 9 laesst dieselbe Arbeit auf beiden Wegen laufen und
// vergleicht die Platte Oktett fuer Oktett -- und genau diese Zusage
// fiel, mit einem Unterschied in dem Oktett, in dem der Modus steht.
//
// Aufgefallen ist es erst, als diese Runde anfing zu FRAGEN: vorher
// hinderte ein Modus von 0 niemanden, weil niemand ihn ansah.
//
// NUR FUER OFS. Bei OFS ist der Knoten die Inodenummer, also ist
// `perm.on_create` unmittelbar anwendbar. FAT32 hat keine Rechte
// (siehe `kernel/fat.fi`), /proc und /dev legen nichts an.
fn vfs_on_create(state: u64, me: u64, m: u64, node: u64, mode: u64) {
    if node == 0 {
        return
    }
    if vfs.type_of(state, m) != vfsops.FS_OFS {
        return
    }
    perm.on_create(state, me, node, mode)
}

fn open_vfs(state: u64, me: u64, m: u64, path: u64, flags: u64) -> u64 {
    // RUNDE K17: dieselbe Frage wie beim Lesen und Schreiben, nur
    // frueher. Ohne diese drei Zeilen antwortet ein abgezogener Stick
    // mit -ENOENT ("die Datei gibt es nicht"), und das ist die falsche
    // Auskunft: die Datei gibt es sehr wohl, sie ist nur nicht mehr
    // erreichbar. Der Unterschied ist der zwischen "loesch sie aus
    // deiner Liste" und "steck ihn wieder ein".
    if mnt_gone(state, m) {
        return neg(errno.E_NODEV)
    }
    var node: u64 = vfs.node_for(state, m, path)
    if node == 0 {
        if (flags & O_CREAT) == 0 {
            return neg(errno.E_NOENT)
        }
        // ZWEI GRUENDE, EINE ANTWORT WAERE ZU WENIG. Ein Treiber
        // OHNE Anlegen (procfs, devfs) sagt -EPERM: da wird nie etwas
        // angelegt werden. Ein Treiber MIT Anlegen auf einer nur
        // lesend eingehaengten Platte sagt -EROFS: da koennte man,
        // wenn man anders eingehaengt haette. `mount -o remount,rw`
        // hilft im zweiten Fall und im ersten nie.
        if !vfs.can(state, m, vfsops.OP_CREATE) {
            if vfs.rdonly(state, m) {
                return neg(errno.E_ROFS)
            }
            return neg(errno.E_PERM)
        }
        node = vfs.v_create(state, m, path, vfsops.N_FILE)
        if node == 0 {
            return neg(errno.E_NOSPC)
        }
        // 0o666 abzueglich der Maske, und sie gehoert dem, der sie
        // anlegt -- dasselbe, was `do_open` auf dem geraden Weg tut.
        vfs_on_create(state, me, m, node, 438)
    } else {
        if (flags & O_CREAT) != 0 && (flags & O_EXCL) != 0 {
            return neg(errno.E_EXIST)
        }
    }
    // ==================================== RUNDE MULTIUSER: DAS TOR
    //
    // HIER STAND KEINE EINZIGE ZEILE. `do_open` fragt seit K13
    // `perm.may`, bevor es eine Datei der WURZEL herausgibt -- dieser
    // Weg, der Weg jeder eingehaengten Platte, jedes /proc-Eintrags und
    // jedes Geraets in /dev, fragte nicht. Eine OFS-Partition hinter
    // einem Einhaengepunkt war damit fuer jeden offen, obwohl in jedem
    // ihrer Inodes Rechte und ein Eigentuemer standen.
    //
    // Die Regel ist dieselbe -- `perm.may_attr`, dieselben sechzehn
    // Zeilen wie fuer die Wurzel. Was anders ist, ist nur, WOHER die
    // drei Zahlen kommen: aus `vfs.v_attr` statt aus `fs.inode_*`.
    // Genau dafuer hat diese Runde `A_UID` und `A_GID` in die
    // Ops-Tafel gelegt.
    if !vfs_may(state, me, m, node, want_of(flags)) {
        return neg(errno.E_ACCES)
    }
    let art: u64 = vfs.v_attr(state, m, node, vfsops.A_TYPE)
    // Die zwei Geraete, die schon einen Deskriptor haben.
    if vfs.type_of(state, m) == vfsops.FS_DEV {
        if devfs.is_fb(node) {
            return open_devfb(state, me, flags)
        }
        if devfs.is_tty(node) {
            return open_devtty(state, me, flags)
        }
    }
    var kind: u64 = file.K_VFILE
    if art == vfsops.N_DIR {
        if (flags & 3) != 0 {
            return neg(errno.E_ISDIR)
        }
        kind = file.K_VDIR
    } else {
        if (flags & O_DIRECTORY) != 0 {
            return neg(errno.E_NOTDIR)
        }
        if (flags & O_TRUNC) != 0 {
            let r: u64 = vfs.v_trunc(state, m, node)
            if r != 0 {
                return neg(r)
            }
        }
    }
    let of: u64 = file.open_alloc(state, kind, node, flags)
    if of >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    file.open_set_mnt(state, of, m)
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    // DIE ZAHL, WEGEN DER `umount` NEIN SAGEN KANN. Sie geht hier
    // hoch und in `unref_of` wieder herunter, und zwar an genau diesen
    // zwei Stellen.
    mnt.open_inc(state, m)
    return fd
}

// /dev/tty: das beherrschende Terminal DIESES Prozesses. Der Knoten
// weiss davon nichts -- er ist eine Nummer in einem Verzeichnis; wer
// gerade fragt, weiss nur diese Ebene.
fn open_devtty(state: u64, me: u64, flags: u64) -> u64 {
    let t: u64 = tty_of(state, me)
    if !tty.valid(state, t) {
        return neg(errno.E_NODEV)
    }
    let of: u64 = file.open_alloc(state, file.K_TTY, t, flags)
    if of >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    return fd
}

// WARUM `open` HIER KEINEN MODUS BEKOMMT, obwohl POSIX einen dritten
// Parameter hat: dieser Weg ist der TIEFSTE im ganzen Kernel --
// Systemaufruf, VFS, FAT32, Platte -- und der Kernstapel hat 16 KiB.
// Jeder weitere Parameter an dieser Stelle hat ihn beim Merge von K15
// ueber die Kante gehoben (16384 von 16384, `mkdir` auf FAT32 starb an
// einem Seitenfehler). Die frische Datei bekommt deshalb weiter 0o666
// abzueglich der Maske, und wer ein PROGRAMM schreibt, setzt das x-Bit
// danach selbst mit `chmod` -- so macht es `kernel/user/fas.fi`.
fn do_open(state: u64, me: u64, name: u64, flags: u64) -> u64 {
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if len == 0 {
        return neg(errno.E_NOENT)
    }
    return open_named(state, me, buf, len, flags)
}

// DER RUMPF VON `do_open`, ABER AUF EINEM NAMEN, DER SCHON IM KERN
// LIEGT. Aufgespalten fuer die Runde ASYNC: ein asynchrones `open`
// bekommt seinen Pfad als Zeiger in Ring 3, und wenn der Arbeitsfaden
// ihn erst spaeter liest, ist der Puffer laengst ueberschrieben oder der
// Prozess gar nicht mehr da. Der Pfad wird deshalb BEI DER ABGABE
// kopiert und hier uebergeben. Fuer den synchronen Weg aendert sich
// nichts: `do_open` legt ihn wie immer nach `kstate.NAME_OFF` und ruft
// diese Funktion.
fn open_named(state: u64, me: u64, buf: u64, len: u64, flags: u64) -> u64 {
    // ROUNDE K7: /dev/fb. Die Pruefung steht VOR der auf ein
    // eingehaengtes Dateisystem, und das ist Absicht: der Bildschirm
    // haengt an der Grafikkarte, nicht an einer Platte. Ein Lauf mit
    // `nofs` hat kein Dateisystem und soll trotzdem zeichnen koennen.
    //
    // Es ist AUCH kein Verzeichnis `/dev` im OFS -- der Name wird
    // abgefangen, bevor irgendetwas nachgeschlagen wird. Ein Osum mit
    // einem echten Geraeteverzeichnis waere eine eigene Runde; was hier
    // steht, ist der eine Name, den diese Runde braucht, und er steht an
    // genau einer Stelle.
    if is_devfb(state, buf, len) {
        return open_devfb(state, me, flags)
    }
    // ============ RUNDE MULTIUSER: DAS BETRETUNGSRECHT, VOR DER WEICHE
    //
    // VOR der Weiche und nicht dahinter, und das ist ein GEMESSENER
    // Befund und keine Geschmacksfrage. Zuerst stand die Zeile im
    // Wurzelzweig, unmittelbar vor `fs.path` -- und damit lief sie NUR
    // ohne `vfsall`. `tools/k14/run.sh` laesst dieselbe Arbeit auf
    // beiden Wegen laufen und vergleicht die Platte danach Oktett fuer
    // Oktett; die Zusage fiel, weil der eine Weg eine Pruefung machte,
    // die der andere nicht kannte.
    //
    // Der Fehler war nicht der Vergleich, sondern die Stelle: ein
    // Verzeichnis auf dem Weg muss betreten werden duerfen, EGAL auf
    // welchem Dateisystem der Name am Ende liegt. Ein Einhaengepunkt
    // `/mnt` mit 0o700 root:root soll auch das FAT32 darunter
    // verschliessen -- und genau das tut diese Zeile hier und dort
    // unten nicht.
    //
    // Fuer einen Namen JENSEITS des Einhaengepunkts hoert `perm.walk`
    // von selbst auf: die Teilpfade darunter gibt es im OFS nicht,
    // `fs.path` gibt 0 zurueck, und die Schleife bricht ab. Geprueft
    // wird also genau der Teil des Weges, der der Wurzel gehoert --
    // mehr kann diese Schicht ehrlich nicht beantworten, und das steht
    // als Grenze in docs/ROUNDMULTIUSER.md.
    //
    // Wer ein Verzeichnis auf dem Weg nicht betreten darf, soll nicht
    // einmal erfahren, ob der Name dahinter existiert -- deshalb VOR
    // jeder Nachschlagerei. Die Gegenprobe `nowalk` steht in
    // `kernel/perm.fi`.
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    // ============================================= RUNDE K14: die Weiche
    //
    // HIER, UND NUR HIER, ENTSCHEIDET SICH, AUF WELCHEM DATEISYSTEM EIN
    // NAME LIEGT. `vfs.mount_for` sucht den LAENGSTEN passenden
    // Einhaengepfad; kommt etwas anderes als die Wurzel heraus, geht
    // der ganze Rest dieses Aufrufs ueber die Ops-Tafel.
    //
    // Fuer die WURZEL bleibt der gerade Weg von Runde 62 stehen,
    // solange `vfsall` nicht auf der Kommandozeile steht. Das ist die
    // Vorsicht, die der Auftrag verlangt: 1486 Zusagen haengen an
    // diesen Zeilen. Mit `vfsall` geht auch sie durch die Tafel, und
    // `tools/k14/run.sh` haelt beide Laeufe Oktett fuer Oktett
    // gegeneinander -- das ist der Beweis, dass der eine Weg den
    // anderen ersetzen kann.
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                return open_vfs(state, me, m, buf, flags)
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    // ================================================== RUNDE K13
    //
    // DAS TOR. Hier -- und an den vier anderen Stellen, an denen man an
    // eine Datei kommt -- wird `perm.may` gefragt, und zwar mit dem,
    // was die Flaggen wirklich verlangen:
    //
    //     O_RDONLY (0)  -> lesen
    //     O_WRONLY (1)  -> schreiben
    //     O_RDWR   (2)  -> beides
    //     O_TRUNC       -> schreiben, auch wenn nur gelesen wuerde
    //
    // Gibt es die Datei noch nicht, gilt die Frage dem VERZEICHNIS: wer
    // etwas anlegen will, braucht dort Schreib- und Betretungsrecht. Und
    // gibt es sie, wird trotzdem zuerst das Verzeichnis gefragt --
    // sonst waere ein Verzeichnis ohne Betretungsrecht kein Hindernis,
    // sondern eine Dekoration.
    //
    // WAS HIER NICHT GEPRUEFT WIRD, und es steht auch in
    // docs/ROUNDK13.md: das Betretungsrecht auf JEDEM Glied eines
    // langen Pfades. Geprueft wird das letzte Verzeichnis und das Ziel.
    // Der Grund ist der Modulgraph -- `fs.path` loest den Pfad auf und
    // kennt keine Aufgabe, und `fs.fi` darf `perm.fi` nicht einbinden,
    // weil `perm.fi` `fs.fi` einbindet. Das ist eine echte Luecke und
    // keine Vereinfachung.
    var ino: u64 = fs.path(state, buf)
    if !dir_allowed(state, me, buf, ino) {
        return neg(errno.E_ACCES)
    }
    if ino == 0 {
        if (flags & O_CREAT) == 0 {
            return neg(errno.E_NOENT)
        }
        ino = fs.create_path(state, buf, fs.T_FILE)
        if ino == 0 {
            return neg(errno.E_NOSPC)
        }
        // Rechte und Eigentuemer der frischen Datei: 0o666 abzueglich
        // der Maske des Prozesses, und sie gehoert dem, der sie anlegt.
        perm.on_create(state, me, ino, 438)
    } else {
        if (flags & O_CREAT) != 0 {
            if (flags & O_EXCL) != 0 {
                return neg(errno.E_EXIST)
            }
        }
        if !perm.may(state, me, ino, want_of(flags)) {
            return neg(errno.E_ACCES)
        }
    }
    var kind: u64 = file.K_FILE
    if fs.inode_type(state, ino) == fs.T_DIR {
        if (flags & 3) != 0 {
            return neg(errno.E_ISDIR)
        }
        kind = file.K_DIR
    } else {
        if (flags & O_DIRECTORY) != 0 {
            return neg(errno.E_NOTDIR)
        }
        if (flags & O_TRUNC) != 0 {
            fs.file_truncate(state, ino)
        }
    }
    let of: u64 = file.open_alloc(state, kind, ino, flags)
    if of >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        unref_of(state, of)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    // RUNDE OFS3: DIE ZUGRIFFSZEIT, EINMAL JE `open` UND NICHT EINMAL JE
    // `read`. Warum an dieser Stelle und nicht in `fs.read_at`, steht bei
    // `fs.touch_atime`: `read_at` laeuft in der Schleife jedes Programms,
    // das eine Datei liest, und ein Inodeschreibvorgang je Leseaufruf
    // waere ein Schreibzugriff auf die Platte je Kilooktett. Ein
    // Verzeichnis bekommt sie auch -- `ls` ist ein Zugriff.
    fs.touch_atime(state, ino)
    return fd
}

fn do_close(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    file.fd_free(state, me, fd)
    unref_of(state, of)
    return 0
}

fn do_dup(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    let to: u64 = file.fd_alloc(state, me, 0)
    if to >= file.MAX_FD {
        return neg(errno.E_MFILE)
    }
    file.open_ref(state, of)
    file.fd_set(state, me, to, of)
    return to
}

// `dup2(from, to)` -- what a shell does between `fork` and `execve` when
// it points the output of a program somewhere else. The two descriptors
// are ONE open file afterwards, with one position, which is the whole
// reason the open file table of round K4 exists.
fn do_dup2(state: u64, me: u64, from: u64, to: u64) -> u64 {
    let of: u64 = of_of(state, me, from)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if to >= file.MAX_FD {
        return neg(errno.E_BADF)
    }
    if from == to {
        return to
    }
    let old: u64 = of_of(state, me, to)
    if old < file.MAX_OPEN {
        file.fd_free(state, me, to)
        unref_of(state, old)
    }
    file.open_ref(state, of)
    file.fd_set(state, me, to, of)
    return to
}

fn do_lseek(state: u64, me: u64, fd: u64, off: u64, whence: u64) -> u64 {
    // RUNDE HANDLE: die Position verstellen ist ein EIGENES Recht. Ein
    // Handle, das nur schreiben darf, darf nicht auch springen -- sonst
    // ist "darf ans Ende anhaengen" nicht von "darf ueberall
    // hinschreiben" zu unterscheiden.
    let of: u64 = file.fd_check(state, me, fd, handle.R_SEEK)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_PIPER || kind == file.K_PIPEW {
        return neg(errno.E_SPIPE)
    }
    if kind == file.K_CONIN || kind == file.K_CONOUT {
        return neg(errno.E_SPIPE)
    }
    var base: u64 = 0
    if whence == SEEK_CUR {
        base = file.open_off(state, of)
    } else {
        if whence == SEEK_END {
            // ROUNDE K7: /dev/fb hat keinen Inode, aber eine Groesse --
            // Zeilenlaenge mal Hoehe. `lseek(fd, 0, SEEK_END)` ist damit
            // die Art, wie ein Programm erfaehrt, wie gross das Bild ist,
            // ohne den Kernel danach zu fragen.
            if kind == file.K_FB {
                base = gfx.fb_bytes(state)
            } else if kind == file.K_VFILE || kind == file.K_VDIR {
                // ROUNDE K14: die Groesse kommt aus der Ops-Tafel. Bei
                // /dev/hdb ist das die Zahl der Bloecke mal 512 -- und
                // damit sagt `lseek(fd, 0, SEEK_END)` wirklich, wie
                // gross die Platte ist.
                base = vfs.v_attr(state, file.open_mnt(state, of),
                    file.open_ino(state, of), vfsops.A_SIZE)
            } else {
                base = fs.inode_size(state, file.open_ino(state, of))
            }
        } else {
            if whence != SEEK_SET {
                return neg(errno.E_INVAL)
            }
        }
    }
    // `off` is an i64 in a u64 register: a negative one is a big number,
    // and adding it is the wraparound `+%` says out loud. What must not
    // happen is a position that ends up before the start of the file.
    let pos: u64 = base +% off
    if (pos >> 63) != 0 {
        return neg(errno.E_INVAL)
    }
    if (off >> 63) != 0 {
        if pos > base {
            return neg(errno.E_INVAL)
        }
    }
    file.open_set_off(state, of, pos)
    return pos
}

fn do_unlink(state: u64, me: u64, name: u64) -> u64 {
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    // ROUNDE K14.
    // RUNDE MULTIUSER: DAS BETRETUNGSRECHT, VOR DER K14-WEICHE.
    // Warum vor und nicht hinter ihr, steht ausgeschrieben in `do_open`:
    // sonst prueft der eine Weg, was der andere nicht kennt, und
    // `tools/k14/run.sh` haelt beide Oktett fuer Oktett gegeneinander.
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                let node: u64 = vfs.node_for(state, m, buf)
                if node == 0 {
                    return neg(errno.E_NOENT)
                }
                if vfs.v_attr(state, m, node, vfsops.A_TYPE)
                    == vfsops.N_DIR {
                    return neg(errno.E_ISDIR)
                }
                let r: u64 = vfs.v_unlink(state, m, buf)
                if r != 0 {
                    return neg(r)
                }
                return 0
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let ino: u64 = fs.path(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    if fs.inode_type(state, ino) == fs.T_DIR {
        return neg(errno.E_ISDIR)
    }
    // RUNDE K13: geloescht wird ein NAME, und ein Name steht in einem
    // Verzeichnis. Gefragt wird deshalb nach dem Schreibrecht am
    // VERZEICHNIS und nicht an der Datei -- deshalb kann man unter Unix
    // eine schreibgeschuetzte Datei loeschen, wenn einem der Ordner
    // gehoert, und deshalb kann man eine eigene Datei NICHT loeschen,
    // wenn sie in einem fremden Ordner liegt.
    let dir: u64 = fs.parent_ino(state, buf)
    if dir != 0 {
        if !perm.may(state, me, dir, perm.R_WRITE | perm.R_EXEC) {
            return neg(errno.E_ACCES)
        }
    }
    if !fs.unlink_path(state, buf) {
        return neg(errno.E_NOENT)
    }
    return 0
}

// ================================================== RUNDE ALLTAG: rmdir
//
// EIN LEERES VERZEICHNIS ENTFERNEN -- und bis zu dieser Runde konnte
// dieses System das nicht. `/bin/rmdir` rief `unlink` auf, `do_unlink`
// antwortet jedem Verzeichnis mit EISDIR (zu Recht, so steht es in
// POSIX), und also blieb jeder je angelegte Ordner fuer immer stehen.
// GEMESSEN: `mkdir /x; rmdir /x; ls /` -- und /x ist noch da.
//
// Aufgefallen ist es dem Papierkorb: er leert einen Ordner, den jemand
// weggeworfen hat, und wird ihn danach nicht los.
//
// Also der richtige Weg statt eines aufgeweichten `unlink`: Linux'
// Nummer 84, eine eigene Funktion, und die Unterscheidung, die POSIX
// verlangt -- was KEIN Verzeichnis ist, bekommt ENOTDIR, was noch
// Eintraege hat, ENOTEMPTY. `fs.unlink_path` prueft die Leere selbst
// (mehr als `.` und `..`); es kam nur nie dorthin.
fn do_rmdir(state: u64, me: u64, name: u64) -> u64 {
    let buf: u64 = state + kstate.NAME_OFF
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                let node: u64 = vfs.node_for(state, m, buf)
                if node == 0 {
                    return neg(errno.E_NOENT)
                }
                if vfs.v_attr(state, m, node, vfsops.A_TYPE)
                    != vfsops.N_DIR {
                    return neg(errno.E_NOTDIR)
                }
                let r: u64 = vfs.v_unlink(state, m, buf)
                if r != 0 {
                    return neg(r)
                }
                return 0
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let ino: u64 = fs.path(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    if fs.inode_type(state, ino) != fs.T_DIR {
        return neg(errno.E_NOTDIR)
    }
    let dir: u64 = fs.parent_ino(state, buf)
    if dir != 0 {
        if !perm.may(state, me, dir, perm.R_WRITE | perm.R_EXEC) {
            return neg(errno.E_ACCES)
        }
    }
    if !fs.unlink_path(state, buf) {
        return neg(errno.E_NOTEMPTY)
    }
    return 0
}

fn do_mkdir(state: u64, me: u64, name: u64) -> u64 {
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    // ROUNDE K14.
    // RUNDE MULTIUSER: DAS BETRETUNGSRECHT, VOR DER K14-WEICHE.
    // Warum vor und nicht hinter ihr, steht ausgeschrieben in `do_open`:
    // sonst prueft der eine Weg, was der andere nicht kennt, und
    // `tools/k14/run.sh` haelt beide Oktett fuer Oktett gegeneinander.
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                if vfs.node_for(state, m, buf) != 0 {
                    return neg(errno.E_EXIST)
                }
                if !vfs.can(state, m, vfsops.OP_CREATE) {
                    if vfs.rdonly(state, m) {
                        return neg(errno.E_ROFS)
                    }
                    return neg(errno.E_PERM)
                }
                let neu: u64 = vfs.v_create(state, m, buf,
                    vfsops.N_DIR)
                if neu == 0 {
                    return neg(errno.E_NOSPC)
                }
                // 0o777 abzueglich der Maske -- dasselbe, was `mkdir`
                // auf dem geraden Weg tut. Ohne diese Zeile bekam ein
                // ueber die Ops-Tafel angelegtes Verzeichnis den Modus
                // 0 und war danach fuer NIEMANDEN mehr zu betreten.
                vfs_on_create(state, me, m, neu, 511)
                return 0
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if fs.path(state, buf) != 0 {
        return neg(errno.E_EXIST)
    }
    let dir: u64 = fs.parent_ino(state, buf)
    if dir != 0 {
        if !perm.may(state, me, dir, perm.R_WRITE | perm.R_EXEC) {
            return neg(errno.E_ACCES)
        }
    }
    let made: u64 = fs.create_path(state, buf, fs.T_DIR)
    if made == 0 {
        return neg(errno.E_NOSPC)
    }
    // 0o777 abzueglich der Maske -- wie bei `open`, nur mit dem anderen
    // Ausgangswert, weil ein Verzeichnis ohne Betretungsrecht nutzlos
    // waere.
    perm.on_create(state, me, made, 511)
    return 0
}

// ------------------------------------------------------------- stat

// `struct stat` as x86-64 Linux lays it out, filled in the data area and
// copied over in one go.
fn fill_stat(state: u64, ino: u64) -> bool {
    let s: u64 = state + kstate.BLOCK_OFF + 2048
    var i: u64 = 0
    while i < STAT_BYTES {
        kstate.set8(s + i, 0 as u8)
        i = i + 1
    }
    let kind: u64 = fs.inode_type(state, ino)
    // RUNDE K13: DIE RECHTE KOMMEN AUS DEM INODE. Bis zu dieser Runde
    // stand hier eine feste Zahl -- 0o644 fuer jede Datei, 0o755 fuer
    // jedes Verzeichnis -- und `ls -l` haette damit fuer alles dasselbe
    // gemeldet. Jetzt ist es das, was auf der Platte steht; bei einem
    // Abbild der Fassung 1 gibt `fs.inode_mode` genau die beiden alten
    // Zahlen zurueck, und dort aendert sich also nichts.
    var mode: u64 = S_IFREG | fs.inode_mode(state, ino)
    if kind == fs.T_DIR {
        mode = S_IFDIR | fs.inode_mode(state, ino)
    }
    // RUNDE OFS3: der dritte Fall. Ein Verweis traegt 0o777 -- seine
    // eigenen Rechtebits werden von keinem Unix ausgewertet, weil man
    // durch ihn hindurch auf das Ziel zugreift, und `ls -l` zeigt sie
    // deshalb ueberall als `lrwxrwxrwx`.
    if kind == fs.T_LINK {
        mode = S_IFLNK | 511
    }
    let size: u64 = fs.inode_size(state, ino)
    __mmio_write64((s + ST_DEV) as *mut u64, 1)
    __mmio_write64((s + ST_INO) as *mut u64, ino)
    __mmio_write64((s + ST_NLINK) as *mut u64, 1)
    __mmio_write32((s + ST_MODE) as *mut u32, mode as u32)
    __mmio_write32((s + ST_UID) as *mut u32, fs.inode_uid(state, ino) as u32)
    __mmio_write32((s + ST_GID) as *mut u32, fs.inode_gid(state, ino) as u32)
    __mmio_write64((s + ST_RDEV) as *mut u64, 0)
    __mmio_write64((s + ST_SIZE) as *mut u64, size)
    __mmio_write64((s + ST_BLKSIZE) as *mut u64, 512)
    __mmio_write64((s + ST_BLOCKS) as *mut u64, (size + 511) / 512)
    // RUNDE OFS3: DIE DREI ZEITEN AUS DEM INODE. Bei einem Abbild der
    // Fassung 1 oder 2 gibt `fs.fi` dort null zurueck, und null heisst
    // 1970 -- genau das, was `ls -l` auf so einem Abbild bis heute
    // gezeigt hat. Es aendert sich also nichts an alten Platten, und
    // alles an neuen.
    __mmio_write64((s + ST_MTIME) as *mut u64, fs.inode_mtime(state, ino))
    __mmio_write64((s + ST_CTIME) as *mut u64, fs.inode_ctime(state, ino))
    __mmio_write64((s + ST_ATIME) as *mut u64, fs.inode_atime(state, ino))
    return true
}

fn stat_out(state: u64, me: u64, out: u64) -> u64 {
    if !copy_out(state, me, out, state + kstate.BLOCK_OFF + 2048,
        STAT_BYTES) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// ROUNDE K14: `stat` fuer einen Knoten eines eingehaengten
// Dateisystems. Dieselben Felder wie `fill_stat`, nur aus der
// Ops-Tafel statt aus einer Inode -- und `st_dev` ist die Nummer der
// EINHAENGUNG plus eins, damit zwei Dateien auf zwei Dateisystemen
// nicht dasselbe Paar (dev, ino) tragen. Genau das ist die Zusage, auf
// die sich `find -xdev` und jedes `du` verlassen.
fn fill_vstat(state: u64, m: u64, node: u64) -> bool {
    let s: u64 = state + kstate.BLOCK_OFF + 2048
    var i: u64 = 0
    while i < STAT_BYTES {
        kstate.set8(s + i, 0 as u8)
        i = i + 1
    }
    let art: u64 = vfs.v_attr(state, m, node, vfsops.A_TYPE)
    let size: u64 = vfs.v_attr(state, m, node, vfsops.A_SIZE)
    var mode: u64 = vfs.v_attr(state, m, node, vfsops.A_MODE)
    if art == vfsops.N_DIR {
        mode = mode | S_IFDIR
    } else if art == vfsops.N_CHR {
        mode = mode | S_IFCHR
    } else if art == vfsops.N_BLK {
        mode = mode | S_IFBLK
    } else if art == vfsops.N_LNK {
        mode = mode | S_IFLNK
    } else {
        mode = mode | S_IFREG
    }
    let bs: u64 = vfs.v_attr(state, m, node, vfsops.A_BLKSIZE)
    __mmio_write64((s + ST_DEV) as *mut u64, m + 1)
    __mmio_write64((s + ST_INO) as *mut u64, node)
    __mmio_write64((s + ST_NLINK) as *mut u64,
        vfs.v_attr(state, m, node, vfsops.A_NLINK))
    __mmio_write32((s + ST_MODE) as *mut u32, mode as u32)
    __mmio_write64((s + ST_RDEV) as *mut u64,
        vfs.v_attr(state, m, node, vfsops.A_RDEV))
    __mmio_write64((s + ST_SIZE) as *mut u64, size)
    __mmio_write64((s + ST_BLKSIZE) as *mut u64, bs)
    if bs != 0 {
        __mmio_write64((s + ST_BLOCKS) as *mut u64, (size + 511) / 512)
    }
    // RUNDE OFS3: dieselben drei Felder wie in `fill_stat`, nur aus der
    // Ops-Tafel. Ein Treiber ohne Uhr gibt null, und das ist die
    // ehrliche Antwort -- /proc-Dateien haben keine Aenderungszeit.
    __mmio_write64((s + ST_MTIME) as *mut u64,
        vfs.v_attr(state, m, node, vfsops.A_MTIME))
    __mmio_write64((s + ST_CTIME) as *mut u64,
        vfs.v_attr(state, m, node, vfsops.A_CTIME))
    __mmio_write64((s + ST_ATIME) as *mut u64,
        vfs.v_attr(state, m, node, vfsops.A_ATIME))
    return true
}

fn do_stat(state: u64, me: u64, name: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, STAT_BYTES) {
        return neg(errno.E_FAULT)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    // RUNDE MULTIUSER: DAS BETRETUNGSRECHT, VOR DER K14-WEICHE.
    // Warum vor und nicht hinter ihr, steht ausgeschrieben in `do_open`:
    // sonst prueft der eine Weg, was der andere nicht kennt, und
    // `tools/k14/run.sh` haelt beide Oktett fuer Oktett gegeneinander.
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                let node: u64 = vfs.node_for(state, m, buf)
                if node == 0 {
                    return neg(errno.E_NOENT)
                }
                fill_vstat(state, m, node)
                return stat_out(state, me, out)
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let ino: u64 = fs.path(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    fill_stat(state, ino)
    return stat_out(state, me, out)
}

// ======================================================== RUNDE OFS3
//
// `lstat` IST `stat` OHNE DEN LETZTEN SPRUNG. Der ganze Unterschied
// steht in einem Wort: `fs.path_nofollow` statt `fs.path`. Alles
// andere -- die Weiche auf ein eingehaengtes Dateisystem, die
// Rechtepruefung, der Puffer -- ist dasselbe, und deshalb steht es
// hier auch nicht noch einmal, sondern ruft dieselben Bausteine.
//
// WARUM ES IHN GEBEN MUSS: ohne `lstat` kann kein Programm einen
// Verweis SEHEN. `ls -l` folgte ihm und zeigte die Groesse des Ziels,
// `find -type l` faende nie einen, und `rm` auf einen Verweis auf ein
// Verzeichnis waere -EISDIR. Ein Dateisystem mit Verweisen und ohne
// `lstat` ist ein Dateisystem, das luegt.
fn do_lstat(state: u64, me: u64, name: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, STAT_BYTES) {
        return neg(errno.E_FAULT)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    // RUNDE MULTIUSER: DAS BETRETUNGSRECHT, VOR DER K14-WEICHE.
    // Warum vor und nicht hinter ihr, steht ausgeschrieben in `do_open`:
    // sonst prueft der eine Weg, was der andere nicht kennt, und
    // `tools/k14/run.sh` haelt beide Oktett fuer Oktett gegeneinander.
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                let node: u64 = vfs.node_for(state, m, buf)
                if node == 0 {
                    return neg(errno.E_NOENT)
                }
                fill_vstat(state, m, node)
                return stat_out(state, me, out)
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let ino: u64 = fs.path_nofollow(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    fill_stat(state, ino)
    return stat_out(state, me, out)
}

// EINEN SYMBOLISCHEN VERWEIS ANLEGEN. Das Ziel wird NICHT geprueft --
// ein Verweis auf etwas, das es noch nicht gibt, ist erlaubt und in
// jedem Unix ueblich (er heisst dann "haengend"). Was geprueft wird,
// ist das VERZEICHNIS, in dem er entstehen soll: wer dort nicht
// schreiben darf, darf auch keinen Verweis hineinlegen.
fn do_symlink(state: u64, me: u64, ziel: u64, wo: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let zbuf: u64 = nameb(state) + 1024
    let zn: u64 = fetch_name(state, me, ziel, zbuf, MAX_NAME)
    if errno.is_error(zn) {
        return zn
    }
    if zn == 0 {
        return neg(errno.E_INVAL)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, wo, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if len == 0 {
        return neg(errno.E_INVAL)
    }
    // Ein Verweis ist ein NAME in einem Verzeichnis -- also gilt die
    // Frage dem Verzeichnis, genau wie bei `open` mit O_CREAT.
    if !dir_allowed(state, me, buf, 0) {
        return neg(errno.E_ACCES)
    }
    // RUNDE MULTIUSER: DAS BETRETUNGSRECHT AUF JEDEM GLIED DES PFADES.
    // Vor `fs.path` und nicht danach: wer ein Verzeichnis auf dem Weg
    // nicht betreten darf, soll nicht einmal erfahren, ob der Name
    // dahinter existiert. Die Begruendung und die Gegenprobe `nowalk`
    // stehen in `kernel/perm.fi`.
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if fs.path_nofollow(state, buf) != 0 {
        return neg(errno.E_EXIST)
    }
    let ino: u64 = fs.symlink_path(state, zbuf, buf)
    if ino == 0 {
        // Fassung 1 und 2 haben keinen Inodetyp dafuer. Das ist kein
        // Fehler des Aufrufers, sondern eine Eigenschaft der Platte --
        // -EPERM ist genau das, was Linux auf einem Dateisystem ohne
        // Verweise meldet.
        if fs.version(state) < fs.OFS_V3 {
            return neg(errno.E_PERM)
        }
        return neg(errno.E_NOSPC)
    }
    perm.on_create(state, me, ino, 511)
    return 0
}

// Das Ziel eines Verweises. POSIX: die Zahl der Oktette OHNE die Null,
// und ein Puffer, der zu klein ist, bekommt eine abgeschnittene Antwort
// und KEINEN Fehler -- der Aufrufer sieht es daran, dass die Zahl gleich
// der Puffergroesse ist.
fn do_readlink(state: u64, me: u64, name: u64, out: u64,
    size: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if size == 0 {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, out, size) {
        return neg(errno.E_FAULT)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    // RUNDE MULTIUSER: DAS BETRETUNGSRECHT AUF JEDEM GLIED DES PFADES.
    // Vor `fs.path` und nicht danach: wer ein Verzeichnis auf dem Weg
    // nicht betreten darf, soll nicht einmal erfahren, ob der Name
    // dahinter existiert. Die Begruendung und die Gegenprobe `nowalk`
    // stehen in `kernel/perm.fi`.
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    let ino: u64 = fs.path_nofollow(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    if fs.inode_type(state, ino) != fs.T_LINK {
        return neg(errno.E_INVAL) // POSIX: das ist kein Verweis
    }
    let ziel: u64 = nameb(state) + 1024
    var n: u64 = fs.readlink_at(state, ino, ziel, MAX_NAME)
    if n > size {
        n = size
    }
    if !copy_out(state, me, out, ziel, n) {
        return neg(errno.E_FAULT)
    }
    return n
}

// DIE ZEITEN SETZEN. `touch` braucht ihn, und er ist die einzige Stelle,
// an der ein Programm eine Zeit im Dateisystem BESTIMMT statt sie
// mitzubekommen.
//
// Die Form ist die von Linux: ein Feld aus zwei `timespec` (Sekunden,
// Nanosekunden), erst die Zugriffs-, dann die Aenderungszeit. Ein
// Nullzeiger heisst "beide auf jetzt"; UTIME_NOW und UTIME_OMIT in den
// Nanosekunden heissen "jetzt" beziehungsweise "diese lassen".
// `fd` und `flaggen` werden angenommen und nicht ausgewertet -- dieser
// Kernel hat kein `*at` mit Verzeichnisdeskriptor, und ein Aufruf mit
// AT_FDCWD (-100) und einem absoluten Pfad ist genau der Fall, den er
// beherrscht.
fn do_utimensat(state: u64, me: u64, fd: u64, name: u64, zeiten: u64,
    flaggen: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if name == 0 {
        return neg(errno.E_INVAL)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    // RUNDE MULTIUSER: DAS BETRETUNGSRECHT AUF JEDEM GLIED DES PFADES.
    // Vor `fs.path` und nicht danach: wer ein Verzeichnis auf dem Weg
    // nicht betreten darf, soll nicht einmal erfahren, ob der Name
    // dahinter existiert. Die Begruendung und die Gegenprobe `nowalk`
    // stehen in `kernel/perm.fi`.
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    let ino: u64 = fs.path(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    // Wer die Zeiten setzen will, muss schreiben duerfen. Das ist
    // strenger als POSIX (dort reicht Eigentum fuer "auf jetzt"), und
    // strenger ist an dieser Stelle die richtige Richtung.
    if !perm.may(state, me, ino, perm.R_WRITE) {
        return neg(errno.E_ACCES)
    }
    let nun: u64 = time.now_sec(state)
    var a: u64 = nun
    var m: u64 = nun
    if zeiten != 0 {
        if !proc.user_ok(state, me, zeiten, 32) {
            return neg(errno.E_FAULT)
        }
        let as_: u64 = user_word(state, me, zeiten)
        let an: u64 = user_word(state, me, zeiten + 8)
        let ms: u64 = user_word(state, me, zeiten + 16)
        let mn: u64 = user_word(state, me, zeiten + 24)
        if an == UTIME_OMIT {
            a = 0 // 0 heisst fuer `fs.set_times`: nicht anfassen
        } else if an != UTIME_NOW {
            a = as_
        }
        if mn == UTIME_OMIT {
            m = 0
        } else if mn != UTIME_NOW {
            m = ms
        }
    }
    if !fs.set_times(state, ino, 0, m, a) {
        if fs.version(state) < fs.OFS_V3 {
            return neg(errno.E_PERM) // diese Platte traegt keine Zeiten
        }
        return neg(errno.E_IO)
    }
    return 0
}

fn do_fstat(state: u64, me: u64, fd: u64, out: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if !proc.user_ok(state, me, out, STAT_BYTES) {
        return neg(errno.E_FAULT)
    }
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_FILE || kind == file.K_DIR {
        fill_stat(state, file.open_ino(state, of))
        return stat_out(state, me, out)
    }
    // ROUNDE K14.
    if kind == file.K_VFILE || kind == file.K_VDIR {
        fill_vstat(state, file.open_mnt(state, of),
            file.open_ino(state, of))
        return stat_out(state, me, out)
    }
    // A pipe and the console have no inode. They still have a KIND, and a
    // program that asks what it is holding gets an answer.
    let s: u64 = state + kstate.BLOCK_OFF + 2048
    var i: u64 = 0
    while i < STAT_BYTES {
        kstate.set8(s + i, 0 as u8)
        i = i + 1
    }
    var mode: u64 = S_IFCHR | 438 // 0o666
    if kind == file.K_PIPER || kind == file.K_PIPEW {
        mode = S_IFIFO | 438
    }
    __mmio_write32((s + ST_MODE) as *mut u32, mode as u32)
    __mmio_write64((s + ST_NLINK) as *mut u64, 1)
    __mmio_write64((s + ST_BLKSIZE) as *mut u64, 512)
    if kind == file.K_FB {
        // ROUNDE K7. Ein Programm in Ring 3 kann die GEOMETRIE des
        // Bildes sonst nirgends herbekommen -- dieser Kernel hat kein
        // `ioctl`. Es braucht zwei Zahlen, und `fstat` hat fuer beide
        // schon ein Feld:
        //
        //   st_size     Zeilenlaenge mal Hoehe -- die ganze Flaeche
        //   st_blksize  die ZEILENLAENGE
        //
        // Daraus folgt alles andere: Hoehe = Groesse / Zeilenlaenge,
        // Breite = Zeilenlaenge / 4. Und `st_blksize` heisst dabei genau
        // das, was es bei jeder Datei heisst -- die natuerliche Einheit
        // eines Zugriffs auf dieses Geraet ist EINE Bildzeile. Das ist
        // kein missbrauchtes Feld, sondern seine Bedeutung.
        __mmio_write64((s + ST_SIZE) as *mut u64, gfx.fb_bytes(state))
        __mmio_write64((s + ST_BLKSIZE) as *mut u64, gfx.fb_pitch(state))
    }
    return stat_out(state, me, out)
}

// --------------------------------------------------------- getdents64

// `struct linux_dirent64`:
//
//     +0  d_ino (8)   +8 d_off (8)   +16 d_reclen (2)   +18 d_type (1)
//     +19 the name, ended by a zero
//
// The position lives in the OPEN FILE, not in the call: reading a
// directory twice from the same descriptor goes on where it stopped, and
// that is what the interface promises. A buffer too short for even the
// first entry is -EINVAL -- the one case in which a short answer would be
// a lie.
// ROUNDE K14: dasselbe fuer ein Verzeichnis eines eingehaengten
// Dateisystems. Die Form der Eintraege ist Wort fuer Wort dieselbe --
// ein `ls` merkt nicht, aus welchem Dateisystem es liest, und genau
// das ist der Sinn der Schicht.
fn do_getdents_vfs(state: u64, me: u64, of: u64, out: u64,
    size: u64) -> u64 {
    let m: u64 = file.open_mnt(state, of)
    let dir: u64 = file.open_ino(state, of)
    let named: u64 = nameb(state) + NB_ENT
    let build: u64 = state + kstate.BLOCK_OFF + 2048
    var written: u64 = 0
    var pos: u64 = file.open_off(state, of)
    var going: bool = true
    while going {
        let node: u64 = vfs.v_readdir(state, m, dir, pos, named)
        if node == 0 {
            going = false
        } else {
            var n: u64 = 0
            while kstate.get8(named + n) != 0 {
                n = n + 1
            }
            let reclen: u64 = (DIRENT_HEAD + n + 1 + 7) & 0xFFFFFFFFFFFFFFF8
            if written + reclen > size {
                if written == 0 {
                    return neg(errno.E_INVAL)
                }
                going = false
            } else {
                var z: u64 = 0
                while z < reclen {
                    kstate.set8(build + z, 0 as u8)
                    z = z + 1
                }
                __mmio_write64(build as *mut u64, node)
                __mmio_write64((build + 8) as *mut u64, pos + 1)
                __mmio_write16((build + 16) as *mut u16, reclen as u16)
                var kind: u64 = DT_REG
                let vart: u64 = vfs.v_attr(state, m, node, vfsops.A_TYPE)
                if vart == vfsops.N_DIR {
                    kind = DT_DIR
                } else if vart == vfsops.N_LNK {
                    kind = DT_LNK
                }
                kstate.set8(build + 18, kind as u8)
                var k: u64 = 0
                while k < n {
                    kstate.set8(build + DIRENT_HEAD + k,
                        kstate.get8(named + k) as u8)
                    k = k + 1
                }
                if !copy_out(state, me, out + written, build, reclen) {
                    return neg(errno.E_FAULT)
                }
                written = written + reclen
                pos = pos + 1
                file.open_set_off(state, of, pos)
            }
        }
    }
    return written
}

fn do_getdents(state: u64, me: u64, fd: u64, out: u64, size: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if file.open_kind(state, of) == file.K_VDIR {
        if !proc.user_ok(state, me, out, size) {
            return neg(errno.E_FAULT)
        }
        return do_getdents_vfs(state, me, of, out, size)
    }
    if file.open_kind(state, of) != file.K_DIR {
        return neg(errno.E_NOTDIR)
    }
    if !proc.user_ok(state, me, out, size) {
        return neg(errno.E_FAULT)
    }
    let dir: u64 = file.open_ino(state, of)
    let named: u64 = nameb(state) + NB_ENT
    let build: u64 = state + kstate.BLOCK_OFF + 2048
    var written: u64 = 0
    var pos: u64 = file.open_off(state, of)
    var going: bool = true
    // RUNDE K15, ZWEITER NACHTRAG: DIE STELLE IM VERZEICHNIS UND NICHT
    // DIE LAUFENDE NUMMER. `fs.entry_at` zaehlt fuer JEDEN Aufruf von
    // vorn, wie viele belegte Eintraege davor lagen -- diese Schleife war
    // damit quadratisch. Unsichtbar bei acht Dateien; bei viertausend
    // lief der Baumdurchlauf zehn Minuten und war nicht fertig.
    //
    // Es MUSSTE auffallen, denn die Gegenprobe dieser Runde IST der
    // Baumdurchlauf: ein Durchlauf, den ein quadratischer Kernelaufruf
    // ausbremst, liesse den Namensindex besser aussehen, als er ist.
    //
    // `d_off` heisst in jedem Unix "wo im Verzeichnis" und nicht "der
    // wievielte" -- was jetzt drinsteht, ist also auch das richtige.
    let plaetze: u64 = fs.slot_count(state, dir)
    while going {
        if pos >= plaetze {
            going = false
        } else {
        let ino: u64 = fs.entry_slot(state, dir, pos, named)
        if ino == 0 {
            pos = pos + 1
            file.open_set_off(state, of, pos)
        } else {
            // What the file system writes is its own directory entry: the
            // inode number in the first eight octets, the name in the
            // 24 behind them (`fs.DIRENT`, `fs.NAME_LEN`).
            let text: u64 = named + 8
            var n: u64 = 0
            while kstate.get8(text + n) != 0 {
                n = n + 1
            }
            let reclen: u64 = (DIRENT_HEAD + n + 1 + 7) & 0xFFFFFFFFFFFFFFF8
            if written + reclen > size {
                if written == 0 {
                    return neg(errno.E_INVAL)
                }
                going = false
            } else {
                var z: u64 = 0
                while z < reclen {
                    kstate.set8(build + z, 0 as u8)
                    z = z + 1
                }
                __mmio_write64(build as *mut u64, ino)
                __mmio_write64((build + 8) as *mut u64, pos + 1)
                __mmio_write16((build + 16) as *mut u16, reclen as u16)
                var kind: u64 = DT_REG
                let art: u64 = fs.inode_type(state, ino)
                if art == fs.T_DIR {
                    kind = DT_DIR
                } else if art == fs.T_LINK {
                    kind = DT_LNK
                }
                kstate.set8(build + 18, kind as u8)
                var k: u64 = 0
                while k < n {
                    kstate.set8(build + DIRENT_HEAD + k,
                        kstate.get8(text + k) as u8)
                    k = k + 1
                }
                if !copy_out(state, me, out + written, build, reclen) {
                    return neg(errno.E_FAULT)
                }
                written = written + reclen
                pos = pos + 1
                file.open_set_off(state, of, pos)
            }
        }
        }
    }
    return written
}

// ------------------------------------------------------------- memory

// The private region of a process (`proc.fi`):
//
//   0x40000000  the data page
//   0x40001000  eight stack pages, the top one holds argc/argv
//   0x40020000  the BREAK grows upwards from here
//   0x400F0000  MMAP grows downwards from here
//   0x40100000  the image
//
// The two meet in the middle, and whichever gets there first is refused.
// That is the whole allocator: no free list, no coalescing -- `brk` is a
// line and `mmap` is a bump. What sits on top of it is `malloc` in the
// libc, and that is where a free list belongs.
// RUNDE K16: `brk` faengt hinter dem gewachsenen Stapel an
// (`proc.ARGS_BASE` liegt jetzt bei 0x4007F000). Der Bereich dazwischen
// ist von 851.968 auf 458.752 Oktette geschrumpft; was ihn nicht mehr
// braucht, ist die grosse Arena weiter oben -- und was `brk` misst,
// misst `tools/posix/run.sh` relativ zur eigenen Linie und nicht als
// Adresse.
const BRK_BASE: u64 = 0x40080000
const MMAP_TOP: u64 = 0x400F0000
const PAGE: u64 = 4096

fn page_up(v: u64) -> u64 {
    return (v + PAGE - 1) & 0xFFFFFFFFFFFFF000
}

fn brk_of(state: u64, me: u64) -> u64 {
    let b: u64 = sched.tget(state, me, sched.T_BRK)
    if b == 0 {
        return BRK_BASE
    }
    return b
}

fn map_bottom(state: u64, me: u64) -> u64 {
    let m: u64 = sched.tget(state, me, sched.T_MMAP)
    if m == 0 {
        return MMAP_TOP
    }
    return m
}

// `brk(0)` asks where the break is; `brk(x)` moves it. Linux answers a
// refusal with the OLD break, not with an error, and a libc reads that as
// "no". Osum does the same.
// RUNDE LAUFZEIT: `arch_prctl(code, addr)`.
//
// ZWEI der vier Unterfunktionen von Linux, und zwar die beiden, die ein
// Programm im Benutzerraum wirklich ruft:
//
//   ARCH_SET_FS (0x1002)  die FS-Basis setzen -- der Fadenzeiger.
//   ARCH_GET_FS (0x1003)  sie zurueckgeben, nach `*addr`.
//
// ARCH_SET_GS/ARCH_GET_GS gibt es NICHT und sie geben -EINVAL: `%gs`
// gehoert in diesem Kern dem Prozessorblock (`cpu.fi`, `swapgs`), und
// ein Programm, das sie umbiegen duerfte, koennte den Kern beim
// naechsten Systemaufruf auf einen Zeiger seiner Wahl schicken.
//
// DIE ADRESSE WIRD GEPRUEFT. Sie muss kanonisch sein und in der unteren
// Haelfte liegen -- eine Kernadresse in IA32_FS_BASE waere genau der
// Weg, auf dem ein Prozess den Kern dazu bringt, fuer ihn zu lesen.
// `wrmsr` mit einem nichtkanonischen Wert ist ausserdem ein #GP, also
// waere die Maschine ohne diese Zeile tot statt der Prozess.
// RUNDE LAUFZEIT: `writev(fd, iov, iovcnt)` und `readv` in EINER
// Funktion -- sie unterscheiden sich in genau einem `if`.
//
// Ein `struct iovec` ist zwei Woerter: Zeiger, Laenge. Der Vektor wird
// Eintrag fuer Eintrag abgearbeitet und auf `do_write`/`do_read`
// zurueckgefuehrt, die die Rechte, die Grenzen und das Terminal schon
// koennen. Was hier dazukommt, ist nur das Zaehlen.
//
// DIE REGELN VON POSIX, und jede hat ihren Grund:
//   * IOV_MAX ist 1024. Ein groesserer Vektor ist -EINVAL, damit
//     niemand den Kern mit einer Zahl aus dem Nutzerraum in eine lange
//     Schleife schickt.
//   * Ein TEILERFOLG ist ein Erfolg. Wer drei Stuecke schreiben will
//     und nach dem zweiten nicht mehr kann, bekommt die Summe der
//     ersten beiden -- nicht den Fehler. Der Fehler kommt erst, wenn
//     KEIN Oktett durchging.
//   * Ein Eintrag der Laenge 0 wird uebersprungen, nicht abgelehnt.
// RUNDE LAUFZEIT: `pread64`/`pwrite64`.
//
// Der Unterschied zu `read`/`write` ist EINE Eigenschaft, und SQLite
// haengt daran: DIE POSITION DER DATEI BLEIBT, WO SIE WAR. Umgesetzt
// wird das hier, indem die Marke gesichert, der gewoehnliche Weg
// gegangen und die Marke danach zurueckgeschrieben wird -- inklusive
// des Fehlerfalls, denn eine Marke, die nur bei Erfolg stimmt, ist
// schlimmer als gar keine.
fn do_pio(state: u64, me: u64, fd: u64, buf: u64, len: u64, off: u64,
    schreiben: bool) -> u64 {
    // Eine negative Position ist ein Fehler und kein grosser u64.
    if (off >> 63) != 0 {
        return neg(errno.E_INVAL)
    }
    var recht: u64 = handle.R_READ
    if schreiben {
        recht = handle.R_WRITE
    }
    let of: u64 = file.fd_check(state, me, fd, recht)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    let kind: u64 = file.open_kind(state, of)
    // Was keine Position hat, kann auch nicht an einer lesen.
    if kind == file.K_PIPER || kind == file.K_PIPEW {
        return neg(errno.E_SPIPE)
    }
    if kind == file.K_CONIN || kind == file.K_CONOUT {
        return neg(errno.E_SPIPE)
    }
    let merk: u64 = file.open_off(state, of)
    file.open_set_off(state, of, off)
    var r: u64 = 0
    if schreiben {
        r = do_write(state, me, fd, buf, len)
    } else {
        r = do_read(state, me, fd, buf, len)
    }
    file.open_set_off(state, of, merk)
    return r
}

// RUNDE LAUFZEIT: `fcntl`, und zwar EHRLICH.
//
// Was dieser Kern kann, beantwortet er; was er nicht kann, sagt er --
// mit einer Ausnahme, die begruendet gehoert:
//
// DIE SPERREN (F_SETLK/F_SETLKW/F_GETLK) MELDEN ERFOLG, OHNE ZU
// SPERREN. Das ist eine bewusste Luege, und sie ist genau so gross wie
// die von Linux auf einem Dateisystem ohne Sperren: SQLite fragt vor
// jedem Zugriff nach einer Sperre und gibt auf, wenn sie verweigert
// wird. Solange EIN Prozess auf die Datenbank sieht -- und mehr kann
// dieses System heute nicht --, ist "gewaehrt" die richtige Antwort.
// Der Tag, an dem zwei Prozesse dieselbe Datenbank oeffnen, ist der
// Tag, an dem hier echte Sperren stehen muessen; bis dahin steht es
// hier als Satz und nicht als stiller Rueckgabewert.
// RUNDE FREMDLAND: `uname`. Die Struktur von Linux ist sechs Felder zu
// je 65 Oktetten hintereinander (sysname, nodename, release, version,
// machine, domainname) -- 390 Oktette am Stueck. Sie wird HIER auf dem
// Kernstapel gebaut und in einem Zug hinausgeschrieben; ein Feld nach
// dem anderen zu kopieren hiesse, sechsmal zu pruefen, ob der Zeiger
// noch dem Prozess gehoert.
//
// Die Zeichenketten sind ABSICHTLICH keine Markenzeichenketten aus
// `marke.fi`: `uname -s` ist eine ABI-Auskunft, kein Produktname. Ein
// Programm, das seinen Weg nach der Antwort waehlt, will wissen, welche
// Systemaufrufe es hat, und die dieses Kerns sind die von Linux.
const UTS_FELD: u64 = 65
const UTS_BYTES: u64 = 390

fn uts_setz(puffer: u64, feld: u64, text: u64, laenge: u64) {
    var i: u64 = 0
    while i < laenge {
        kstate.set8(puffer + feld * UTS_FELD + i, kstate.get8(text + i) as u8)
        i = i + 1
    }
}

fn do_uname(state: u64, me: u64, aus: u64) -> u64 {
    var s_sys: [u8; 6] = "Linux\0"
    var s_node: [u8; 5] = "osum\0"
    var s_rel: [u8; 7] = "6.1.0\0\0"
    var s_ver: [u8; 5] = "Osum\0"
    var s_mach: [u8; 7] = "x86_64\0"
    var puffer: [u8; 390] = [0; 390]
    let p: u64 = (&puffer[0]) as u64
    var i: u64 = 0
    while i < UTS_BYTES {
        kstate.set8(p + i, 0)
        i = i + 1
    }
    // `sysname` ist "Linux", und das ist keine Anbiederung, sondern die
    // Wahrheit ueber die Schnittstelle: die Nummern in `rax` sind die
    // von Linux x86-64, und ein Programm, das hier "Osum" laese, wuerde
    // daraus schliessen, es kenne diesen Kern nicht -- und einen Pfad
    // waehlen, den es fuer unbekannte Systeme haelt. Der NODENAME sagt,
    // welche Maschine das ist.
    uts_setz(p, 0, (&s_sys[0]) as u64, 5)
    uts_setz(p, 1, (&s_node[0]) as u64, 4)
    uts_setz(p, 2, (&s_rel[0]) as u64, 5)
    uts_setz(p, 3, (&s_ver[0]) as u64, 4)
    uts_setz(p, 4, (&s_mach[0]) as u64, 6)
    // domainname bleibt leer, wie auf einem Rechner ohne NIS.
    if !copy_out(state, me, aus, p, UTS_BYTES) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// RUNDE FREMDLAND: `prctl`. Nur die Unterbefehle, die dieser Kern
// wahrheitsgemaess beantworten kann.
const PR_SET_NAME: u64 = 15
const PR_GET_NAME: u64 = 16
const PR_GET_DUMPABLE: u64 = 3
const PR_SET_DUMPABLE: u64 = 4

fn do_prctl(state: u64, me: u64, was: u64, arg: u64) -> u64 {
    // Einen Prozessnamen fuehrt dieser Kern nicht. `PR_SET_NAME` still
    // anzunehmen ist richtig -- der Aufrufer verlangt keine Wirkung, die
    // er nachpruefen koennte; `PR_GET_NAME` dagegen MUSS scheitern,
    // sonst laese der Aufrufer einen Puffer, den niemand gefuellt hat.
    if was == PR_SET_NAME {
        return 0
    }
    if was == PR_GET_NAME {
        return neg(errno.E_INVAL)
    }
    // Kernschreiben gibt es nicht, also ist "nicht abbildbar" die
    // Wahrheit und 0 die richtige Antwort auf die Frage.
    if was == PR_GET_DUMPABLE {
        return 0
    }
    if was == PR_SET_DUMPABLE {
        return 0
    }
    return neg(errno.E_INVAL)
}

fn do_fcntl(state: u64, me: u64, fd: u64, cmd: u64, arg: u64) -> u64 {
    let of: u64 = file.fd_check(state, me, fd, 0)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if cmd == F_GETFL {
        return file.open_flags(state, of)
    }
    if cmd == F_SETFL {
        return 0
    }
    // Kein Deskriptor dieses Kerns ueberlebt ein `execve`, und keiner
    // traegt ein Nahe-Bit. Beides sagt die Antwort auch so.
    if cmd == F_GETFD {
        return 0
    }
    if cmd == F_SETFD {
        return 0
    }
    if cmd == F_DUPFD || cmd == F_DUPFD_CLOEXEC {
        return do_dup(state, me, fd)
    }
    // RUNDE FREMDLAND: DIE SPERREN SIND ECHT.
    if cmd == F_SETLK || cmd == F_SETLKW || cmd == F_GETLK {
        return do_lock(state, me, of, cmd, arg)
    }
    return neg(errno.E_INVAL)
}

// ------------------------------------------------- RUNDE FREMDLAND: SPERREN
//
// LAUFZEIT schrieb: "`fcntl` meldet Sperren als gewaehrt, ohne zu
// sperren. Das ist eine bewusste Luege... Der Tag, an dem zwei Prozesse
// dieselbe Datenbank oeffnen, ist der Tag, an dem hier echte Sperren
// stehen muessen." Sie stehen jetzt.
//
// WAS GEBAUT IST: Bereichssperren auf der INODE, wie POSIX sie
// beschreibt. Ein Eintrag ist (Inode, Einhaengung, erstes Oktett,
// letztes Oktett, Art, Halter-pid). Eine Lesesperre vertraegt sich mit
// anderen Lesesperren, eine Schreibsperre mit nichts. Sperren desselben
// Halters stehen sich nie im Weg -- das ist POSIX und der Grund, warum
// SQLite seine eigene Sperre verschaerfen darf.
//
// WAS NICHT GEBAUT IST, und es steht hier, weil ein ungenannter Mangel
// ein Fehler ist:
//   * F_SETLKW WARTET NICHT, es antwortet wie F_SETLK. Wer wartet,
//     wartet auf einen anderen Prozess, und dieser Kern hat keinen, der
//     eine Verklemmung aufloesen koennte. SQLite fragt ohnehin mit
//     F_SETLK und behandelt die Absage selbst (SQLITE_BUSY) -- genau
//     das misst diese Runde.
//   * Sperren werden beim `close` eines Deskriptors NICHT einzeln
//     aufgeraeumt, sondern beim Prozessende als Ganzes. POSIX verlangt
//     das Erste; wer es braucht, merkt es an einer Sperre, die nach dem
//     Schliessen noch steht.

fn lock_at(state: u64, i: u64) -> u64 {
    return state + kstate.FLOCK_OFF + i * kstate.FLOCK_BYTES
}

fn lock_get(state: u64, i: u64, feld: u64) -> u64 {
    return kstate.get(state, lock_at(state, i) + feld)
}

fn lock_set(state: u64, i: u64, feld: u64, v: u64) {
    kstate.set(state, lock_at(state, i) + feld, v)
}

// Ueberschneiden sich zwei Bereiche? Beide sind einschliesslich.
fn lock_trifft(a_von: u64, a_bis: u64, b_von: u64, b_bis: u64) -> bool {
    if a_bis < b_von {
        return false
    }
    if b_bis < a_von {
        return false
    }
    return true
}

// Der Bereich aus einem `struct flock`, auf absolute Oktette gebracht.
// Rueckgabe ueber die beiden Zeiger; false heisst: unbrauchbar.
fn do_lock(state: u64, me: u64, of: u64, cmd: u64, arg: u64) -> u64 {
    if !proc.user_ok(state, me, arg, FL_BYTES) {
        return neg(errno.E_FAULT)
    }
    let art: u64 = user_half(state, me, arg + FL_TYPE)
    let whence: u64 = user_half(state, me, arg + FL_WHENCE)
    let start: u64 = user_word(state, me, arg + FL_START)
    let laenge: u64 = user_word(state, me, arg + FL_LEN)
    if art != F_RDLCK && art != F_WRLCK && art != F_UNLCK {
        return neg(errno.E_INVAL)
    }
    // Der Bezugspunkt. SEEK_END braeuchte die Groesse der Datei; SQLite
    // benutzt ausschliesslich SEEK_SET, und was dieser Kern nicht
    // richtig rechnen kann, weist er ab, statt es zu raten.
    var von: u64 = start
    if whence == SEEK_CUR {
        von = file.open_off(state, of) + start
    }
    if whence == SEEK_END {
        return neg(errno.E_INVAL)
    }
    if whence != SEEK_SET && whence != SEEK_CUR {
        return neg(errno.E_INVAL)
    }
    // l_len = 0 heisst "bis ans Ende der Datei, wie gross sie auch
    // werde". Das ist die Form, in der eine Datei als GANZES gesperrt
    // wird.
    var bis: u64 = 0xFFFFFFFFFFFFFFFF
    if laenge != 0 {
        if (laenge >> 63) != 0 {
            return neg(errno.E_INVAL)
        }
        bis = von + laenge - 1
    }
    let ino: u64 = file.open_ino(state, of)
    if ino == 0 {
        return neg(errno.E_BADF)
    }
    let mnt: u64 = file.open_mnt(state, of)
    let wer: u64 = sched.tget(state, me, sched.T_TGID)

    // ---- F_GETLK: nur fragen, nichts aendern ----------------------
    if cmd == F_GETLK {
        var k: u64 = 0
        while k < kstate.FLOCK_SLOTS {
            if lock_get(state, k, L_INO) == ino
                && lock_get(state, k, L_MNT) == mnt
                && lock_get(state, k, L_PID) != wer {
                let hart: u64 = lock_get(state, k, L_ART)
                // Eine Lesesperre stoert eine andere Lesesperre nicht.
                var stoert: bool = true
                if art == F_RDLCK && hart == F_RDLCK {
                    stoert = false
                }
                if stoert && lock_trifft(von, bis,
                    lock_get(state, k, L_VON), lock_get(state, k, L_BIS)) {
                    // Der Frager bekommt die SPERRE beschrieben, die im
                    // Weg steht -- das ist der ganze Zweck von F_GETLK.
                    put_half(state, me, arg + FL_TYPE, hart)
                    put_half(state, me, arg + FL_WHENCE, SEEK_SET)
                    put64(state, me, arg + FL_START,
                        lock_get(state, k, L_VON))
                    var l: u64 = 0
                    if lock_get(state, k, L_BIS) != 0xFFFFFFFFFFFFFFFF {
                        l = lock_get(state, k, L_BIS)
                            - lock_get(state, k, L_VON) + 1
                    }
                    put64(state, me, arg + FL_LEN, l)
                    put_word32(state, me, arg + FL_PID,
                        lock_get(state, k, L_PID))
                    return 0
                }
            }
            k = k + 1
        }
        // Niemand steht im Weg. POSIX: l_type wird F_UNLCK.
        put_half(state, me, arg + FL_TYPE, F_UNLCK)
        return 0
    }

    // ---- F_UNLCK: die eigenen Sperren in diesem Bereich raeumen ----
    if art == F_UNLCK {
        var k: u64 = 0
        while k < kstate.FLOCK_SLOTS {
            if lock_get(state, k, L_INO) == ino
                && lock_get(state, k, L_MNT) == mnt
                && lock_get(state, k, L_PID) == wer
                && lock_trifft(von, bis, lock_get(state, k, L_VON),
                    lock_get(state, k, L_BIS)) {
                lock_frei(state, k)
            }
            k = k + 1
        }
        return 0
    }

    // ---- F_SETLK / F_SETLKW: steht jemand im Weg? -----------------
    var k2: u64 = 0
    while k2 < kstate.FLOCK_SLOTS {
        if lock_get(state, k2, L_INO) == ino
            && lock_get(state, k2, L_MNT) == mnt
            && lock_get(state, k2, L_PID) != wer {
            let hart2: u64 = lock_get(state, k2, L_ART)
            var stoert2: bool = true
            if art == F_RDLCK && hart2 == F_RDLCK {
                stoert2 = false
            }
            if stoert2 && lock_trifft(von, bis, lock_get(state, k2, L_VON),
                lock_get(state, k2, L_BIS)) {
                // DIE ABSAGE, AUF DIE SQLITE WARTET. POSIX nennt
                // EACCES oder EAGAIN; Linux gibt EAGAIN, und SQLite
                // macht daraus SQLITE_BUSY.
                return neg(errno.E_AGAIN)
            }
        }
        k2 = k2 + 1
    }
    // Der Weg ist frei. Eigene Sperren im selben Bereich werden
    // ERSETZT -- eine Lesesperre, die zur Schreibsperre wird, ist eine
    // Sperre und nicht zwei.
    var k3: u64 = 0
    while k3 < kstate.FLOCK_SLOTS {
        if lock_get(state, k3, L_INO) == ino
            && lock_get(state, k3, L_MNT) == mnt
            && lock_get(state, k3, L_PID) == wer
            && lock_trifft(von, bis, lock_get(state, k3, L_VON),
                lock_get(state, k3, L_BIS)) {
            lock_frei(state, k3)
        }
        k3 = k3 + 1
    }
    var frei: u64 = kstate.FLOCK_SLOTS
    var k4: u64 = 0
    while k4 < kstate.FLOCK_SLOTS {
        if lock_get(state, k4, L_INO) == 0 && frei == kstate.FLOCK_SLOTS {
            frei = k4
        }
        k4 = k4 + 1
    }
    if frei >= kstate.FLOCK_SLOTS {
        // Die Tafel ist voll. POSIX nennt dafuer ENOLCK, und das ist
        // ehrlicher als eine Sperre zu gewaehren, die nicht eingetragen
        // ist -- genau die Luege, die diese Runde beseitigt.
        return neg(errno.E_NOLCK)
    }
    lock_set(state, frei, L_INO, ino)
    lock_set(state, frei, L_MNT, mnt)
    lock_set(state, frei, L_VON, von)
    lock_set(state, frei, L_BIS, bis)
    lock_set(state, frei, L_ART, art)
    lock_set(state, frei, L_PID, wer)
    kstate.add(state, kstate.FLOCKS, 1)
    return 0
}

fn lock_frei(state: u64, k: u64) {
    lock_set(state, k, L_INO, 0)
    lock_set(state, k, L_MNT, 0)
    lock_set(state, k, L_VON, 0)
    lock_set(state, k, L_BIS, 0)
    lock_set(state, k, L_ART, 0)
    lock_set(state, k, L_PID, 0)
}

// Beim Prozessende: alles, was dieser Halter hielt. Ohne das bliebe eine
// Datenbank fuer immer gesperrt, wenn ein Prozess stirbt, und der
// naechste Start faende sie belegt -- der haeufigste Weg, wie ein System
// mit Sperren unbrauchbar wird.
fn locks_drop(state: u64, me: u64) {
    let wer: u64 = sched.tget(state, me, sched.T_TGID)
    if wer == 0 {
        return
    }
    var k: u64 = 0
    while k < kstate.FLOCK_SLOTS {
        if lock_get(state, k, L_INO) != 0
            && lock_get(state, k, L_PID) == wer {
            lock_frei(state, k)
        }
        k = k + 1
    }
}



fn do_writev(state: u64, me: u64, fd: u64, iov: u64, n: u64, schreiben: bool) -> u64 {
    if n > 1024 {
        return neg(errno.E_INVAL)
    }
    if n == 0 {
        return 0
    }
    if !proc.user_ok(state, me, iov, n * 16) {
        return neg(errno.E_FAULT)
    }
    var total: u64 = 0
    var i: u64 = 0
    while i < n {
        let base: u64 = get_user64(state, me, iov + i * 16)
        let len: u64 = get_user64(state, me, iov + i * 16 + 8)
        if len != 0 {
            var r: u64 = 0
            if schreiben {
                r = do_write(state, me, fd, base, len)
            } else {
                r = do_read(state, me, fd, base, len)
            }
            // Ein negativer Rueckgabewert ist ein Fehler: er steht als
            // Zweierkomplement da, also ist sein oberstes Bit gesetzt.
            if (r >> 63) != 0 {
                if total == 0 {
                    return r
                }
                return total
            }
            total = total + r
            // Kurz geschrieben heisst: mehr geht gerade nicht.
            if r < len {
                return total
            }
        }
        i = i + 1
    }
    return total
}

fn do_arch_prctl(state: u64, me: u64, code: u64, addr: u64) -> u64 {
    if code == ARCH_SET_FS {
        if (addr >> 47) != 0 {
            return neg(errno.E_INVAL)
        }
        sched.tset(state, me, sched.T_FSBASE, addr)
        // Sofort wirksam: dieser Faden laeuft gerade, und der naechste
        // Wechsel legt sie aus dem Aufgabensatz erneut hin.
        sched.fsbase_apply(state, me)
        return 0
    }
    if code == ARCH_GET_FS {
        if !proc.user_ok(state, me, addr, 8) {
            return neg(errno.E_FAULT)
        }
        put64(state, me, addr, sched.tget(state, me, sched.T_FSBASE))
        return 0
    }
    return neg(errno.E_INVAL)
}

fn do_brk(state: u64, me: u64, want: u64) -> u64 {
    let cur: u64 = brk_of(state, me)
    if want == 0 {
        return cur
    }
    if want < BRK_BASE {
        return cur
    }
    if want > map_bottom(state, me) {
        return cur
    }
    var p: u64 = page_up(cur)
    if want > cur {
        while p < want {
            if proc.page_free(state, me, p) {
                // RUNDE FREMDLAND: GENULLT. Was `brk` dazunimmt, ist
                // nach POSIX mit Nullen gefuellt -- und musls Halde
                // legt genau hier ihre Verwaltung ab und prueft sie.
                if proc.map_page_zero(state, me, p, true, false) == 0 {
                    return cur
                }
                kstate.add(state, kstate.MAPS, 1)
            }
            p = p + PAGE
        }
    } else {
        var q: u64 = page_up(want)
        while q < p {
            proc.page_drop(state, me, q)
            q = q + PAGE
        }
    }
    sched.tset(state, me, sched.T_BRK, want)
    return want
}

// ============================================ RUNDE K16: DIE GROSSE ARENA
//
// Sechs MiB zwischen `proc.BIG_FLOOR` und `proc.BIG_TOP`, in drei
// 2-MiB-Kacheln des privaten Seitenverzeichnisses, die es vor dieser
// Runde nicht gab. Sie werden angelegt, wenn jemand sie braucht
// (`proc.pt_for`), und mit dem Prozess wieder freigegeben
// (`proc.free_space`).
//
// WARUM NEBEN DER ALTEN HALDE UND NICHT STATT IHRER: die alte gibt
// Adressen zurueck, die seit Runde K4 gemessen werden. Eine Runde, die
// den Uebersetzer zum Laufen bringt und dabei drei Abschnitte der Abnahme
// umschreibt, hat zwei Dinge getan und keines davon nachweisbar.
//
// DIE GEGENPROBE: `nobigmem` auf der Kernel-Befehlszeile schaltet sie ab.
// Danach MUSS der Uebersetzer an genau dieser Stelle stehenbleiben -- und
// wenn er es nicht tut, hat er sie nie gebraucht und diese Zeilen messen
// nichts.
fn big_bottom(state: u64, me: u64) -> u64 {
    let b: u64 = sched.tget(state, me, sched.T_BIG)
    if b == 0 {
        return proc.BIG_TOP
    }
    return b
}

fn big_map(state: u64, me: u64, pages: u64, prot: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_NOBIG) {
        return neg(errno.E_NOMEM)
    }
    let top: u64 = big_bottom(state, me)
    if pages * PAGE > top - proc.BIG_FLOOR {
        return neg(errno.E_NOMEM)
    }
    let base: u64 = top - pages * PAGE
    if base < proc.BIG_FLOOR {
        return neg(errno.E_NOMEM)
    }
    var p: u64 = base
    while p < top {
        // RUNDE FREMDLAND: GENULLT -- `mmap(MAP_ANONYMOUS)` liefert
        // Nullen, und was der vorige Besitzer des Rahmens dort liegen
        // liess, geht den neuen nichts an.
        if proc.map_page_zero(state, me, p, true, (prot & PROT_EXEC) != 0) == 0 {
            return neg(errno.E_NOMEM)
        }
        kstate.add(state, kstate.MAPS, 1)
        p = p + PAGE
    }
    sched.tset(state, me, sched.T_BIG, base)
    return base
}

// Anonymous memory only: a mapping backed by a FILE needs the page cache
// this system does not have, and pretending otherwise would be the kind of
// half-truth that costs a day later. MAP_ANONYMOUS missing is -ENODEV, and
// docs/ROUNDK4.md says so.
// The name is `do_map` and not `do_mmap` on purpose: section 2 of
// `tools/kernel/run.sh` proves that no host libc is linked into the kernel
// by looking for the names `malloc`, `printf`, `memcpy` and `mmap` in the
// symbol table. A kernel function that carried one of those names would
// make that proof worthless.
fn do_map(state: u64, me: u64, len: u64, prot: u64, flags: u64,
    fd: u64, off: u64) -> u64 {
    if len == 0 {
        return neg(errno.E_INVAL)
    }
    if (flags & MAP_ANONYMOUS) == 0 {
        // ROUNDE K7: der eine Deskriptor, der sich abbilden laesst.
        return map_fd(state, me, fd, len, prot, off)
    }
    // With MAP_ANONYMOUS Linux ignores the descriptor as well.
    if off != 0 {
        return neg(errno.E_INVAL)
    }
    let pages: u64 = page_up(len) / PAGE
    let top: u64 = map_bottom(state, me)
    if pages * PAGE > top {
        return big_map(state, me, pages, prot)
    }
    let base: u64 = top - pages * PAGE
    // RUNDE K16: WENN DIE ALTE HALDE NICHT MEHR REICHT, KOMMT DIE GROSSE.
    //
    // Die alte ist 851.968 Oktette zwischen `brk` und MMAP_TOP, und sie
    // bleibt Oktett fuer Oktett, wo sie seit Runde K4 liegt -- was
    // `tools/posix/run.sh` an Adressen misst, misst es weiter. Erst wenn
    // sie voll ist, geht es in `proc.BIG_TOP` abwaerts weiter. Das ist
    // additiv, und es ist der einzige Grund, warum ein Uebersetzer auf
    // diesem System laufen kann.
    if base < page_up(brk_of(state, me)) + PAGE {
        return big_map(state, me, pages, prot)
    }
    var p: u64 = base
    while p < top {
        // RUNDE FREMDLAND: GENULLT -- `mmap(MAP_ANONYMOUS)` liefert
        // Nullen, und was der vorige Besitzer des Rahmens dort liegen
        // liess, geht den neuen nichts an.
        if proc.map_page_zero(state, me, p, true, (prot & PROT_EXEC) != 0) == 0 {
            return neg(errno.E_NOMEM)
        }
        kstate.add(state, kstate.MAPS, 1)
        p = p + PAGE
    }
    sched.tset(state, me, sched.T_MMAP, base)
    return base
}

// ROUNDE K7: `mmap` auf /dev/fb. Was der Prozess bekommt, ist der
// RAHMENPUFFER DER KARTE, nicht der Zweitpuffer des Kernels -- er malt
// also unmittelbar auf den Bildschirm, ohne einen Aufruf dazwischen.
// Das ist der Sinn der Sache: `write` kostet einen Systemaufruf je
// Block, eine Abbildung kostet einen einzigen fuer das ganze Bild.
//
// WAS DAS FUER DIE KONSOLE HEISST. Laeuft der Kernel mit Zweitpuffer,
// gehoeren ihm die Bildzeilen, die er als geaendert vermerkt hat; alles
// andere bleibt so stehen, wie ein Programm es gemalt hat. Zwei Zeichner
// auf einer Flaeche vertragen sich, solange sie verschiedene Zeilen
// nehmen -- und vertragen sich nicht, wenn nicht. Ein Fenstersystem
// waere die Antwort darauf und ist nicht diese Runde.
//
// Ein `fork` erbt die Abbildung NICHT: `proc.copy_space` laeuft die
// Seitentabelle ab, und eine 2-MiB-Seite steht nicht darin. Das Kind
// muss `mmap` selbst rufen. Gewollt und nachgemessen.
fn map_fd(state: u64, me: u64, fd: u64, len: u64, prot: u64,
    off: u64) -> u64 {
    // EIN UNGUELTIGER DESKRIPTOR IST HIER -ENODEV UND NICHT -EBADF, und
    // das ist Absicht. Die Zusage der Runde K4 lautet: "ohne
    // MAP_ANONYMOUS gibt es nichts abzubilden" -- dieses System hat keine
    // Dateiabbildung. Runde K7 nimmt EINE Ausnahme davon, /dev/fb, und
    // aendert an dem Satz sonst nichts: alles, was nicht der
    // Rahmenpuffer ist, bekommt weiterhin dieselbe Antwort wie vorher,
    // ob es nun ein Deskriptor auf eine Datei, auf die Konsole oder gar
    // keiner ist. Ein `mmap` sagt damit nicht mehr aus, WELCHE
    // Deskriptoren es gibt.
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_NODEV)
    }
    if file.open_kind(state, of) != file.K_FB {
        return neg(errno.E_NODEV)
    }
    if off != 0 {
        return neg(errno.E_INVAL)
    }
    if !gfx.fb_ready(state) {
        return neg(errno.E_NODEV)
    }
    if len > gfx.fb_bytes(state) {
        return neg(errno.E_INVAL)
    }
    let schreiben: bool = (prot & PROT_WRITE) != 0
    if schreiben {
        if !writable(state, of) {
            return neg(errno.E_ACCES)
        }
    }
    if !readable(state, of) {
        if !schreiben {
            return neg(errno.E_ACCES)
        }
    }
    // Die Kachel, in der der Puffer beginnt -- und der Versatz darin,
    // damit ein Rahmenpuffer, der nicht auf 2 MiB ausgerichtet ist,
    // trotzdem eine richtige Adresse bekommt.
    if !proc.map_huge(state, me, gfx.fb_user_base(), gfx.fb_block(state), schreiben) {
        return neg(errno.E_NOMEM)
    }
    kstate.add(state, kstate.MAPS, 1)
    return gfx.fb_user_base() + gfx.fb_offset(state)
}

// The pages go back, the bump pointer does not. A hole in the middle of a
// bump allocator is a free list, and that is the libc's business, not the
// kernel's -- written down as a gap in docs/ROUNDK4.md.
fn do_unmap(state: u64, me: u64, addr: u64, len: u64) -> u64 {
    if (addr & (PAGE - 1)) != 0 {
        return neg(errno.E_INVAL)
    }
    if len == 0 {
        return neg(errno.E_INVAL)
    }
    // RUNDE K16: zwei Fenster statt einem.
    let in_alt: bool = addr >= map_bottom(state, me) && addr < MMAP_TOP
    let in_gross: bool = addr >= big_bottom(state, me) && addr < proc.BIG_TOP
    if !in_alt && !in_gross {
        return neg(errno.E_INVAL)
    }
    var p: u64 = addr
    let end: u64 = addr + page_up(len)
    while p < end {
        if p < MMAP_TOP || p < proc.BIG_TOP {
            proc.page_drop(state, me, p)
        }
        p = p + PAGE
    }
    return 0
}

// ------------------------------------------------------------ the clock

// `nanosleep(request, remainder)`, and the request is a `struct timespec`:
// eight octets of seconds, eight of nanoseconds. The timer runs at 100 Hz,
// so ten milliseconds are the grain -- anything shorter is a yield.
//
// A DELIBERATE DEVIATION: more than sixty seconds is -EINVAL. Linux would
// sleep. A kernel that can be stopped for an hour by one number cannot be
// measured, and `tools/kernel/run.sh` has been checking that refusal since
// round 62.
fn do_nanosleep(state: u64, me: u64, req: u64) -> u64 {
    if !proc.user_ok(state, me, req, 16) {
        return neg(errno.E_FAULT)
    }
    let sec: u64 = user_word(state, me, req)
    let nsec: u64 = user_word(state, me, req + 8)
    if nsec >= 1000000000 {
        return neg(errno.E_INVAL)
    }
    if sec > 60 {
        return neg(errno.E_INVAL)
    }
    let ticks: u64 = sec * 100 + (nsec + 9999999) / 10000000
    // ROUND K9. GESCHLAFEN WIRD MARKE FUER MARKE, und das ist kein
    // Umweg: ein Schlaefer muss von einem Signal UNTERBRECHBAR sein.
    // POSIX sagt dafuer -EINTR, und ein `sleep 30`, das sich von STRG-C
    // nicht stoeren laesst, ist genau das, was diese Runde beheben soll.
    // Mit `nosig` kann nichts zugestellt werden, und dann schlaeft dieser
    // Aufruf seine volle Zeit -- die Gegenprobe dazu.
    var left: u64 = ticks
    while left > 0 {
        if signal.interrupted(state, me) {
            return neg(errno.E_INTR)
        }
        sched.sleep_ticks(state, 1)
        left = left - 1
    }
    return 0
}

// ---------------------------------------------------- ROUND K9: die Uhr

// `clock_gettime(clk, tp)`. `tp` ist ein `struct timespec`: acht Oktette
// Sekunden, acht Oktette Nanosekunden.
fn do_clock_gettime(state: u64, me: u64, clk: u64, tp: u64) -> u64 {
    if clk > time.CLOCK_MAX {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, tp, 16) {
        return neg(errno.E_FAULT)
    }
    kstate.add(state, kstate.TIME_CALLS, 1)
    var ns: u64 = 0
    if clk == time.CLOCK_REALTIME || clk == time.CLOCK_REALTIME_COARSE {
        ns = time.real_ns(state)
    } else {
        ns = time.mono_ns(state)
    }
    if !put64(state, me, tp, ns / time.NS_PER_SEC) {
        return neg(errno.E_FAULT)
    }
    if !put64(state, me, tp + 8, ns % time.NS_PER_SEC) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// Die Koernung, und sie wird nicht behauptet, sondern ausgerechnet: mit
// geeichtem Zyklenzaehler ist es eine Nanosekunde, ohne ihn sind es die
// zehn Millisekunden des Zeitgebers.
fn do_clock_getres(state: u64, me: u64, clk: u64, tp: u64) -> u64 {
    if clk > time.CLOCK_MAX {
        return neg(errno.E_INVAL)
    }
    if tp == 0 {
        return 0
    }
    if !proc.user_ok(state, me, tp, 16) {
        return neg(errno.E_FAULT)
    }
    var res: u64 = time.TICK_NS
    if time.khz(state) != 0 {
        res = 1
    }
    put64(state, me, tp, 0)
    put64(state, me, tp + 8, res)
    return 0
}

// `gettimeofday(tv, tz)` -- Sekunden und MIKROsekunden. Die Zeitzone wird
// gelesen und verworfen; sie ist seit 4.4BSD nichts als ein Nullzeiger.
fn do_gettimeofday(state: u64, me: u64, tv: u64) -> u64 {
    if tv == 0 {
        return 0
    }
    if !proc.user_ok(state, me, tv, 16) {
        return neg(errno.E_FAULT)
    }
    let ns: u64 = time.real_ns(state)
    put64(state, me, tv, ns / time.NS_PER_SEC)
    put64(state, me, tv + 8, (ns % time.NS_PER_SEC) / 1000)
    return 0
}

// `time(t)` -- die Sekunden selbst, und dazu in einen Zeiger, wenn einer
// mitkommt.
fn do_time(state: u64, me: u64, out: u64) -> u64 {
    let secs: u64 = time.now_sec(state)
    if out != 0 {
        if !proc.user_ok(state, me, out, 8) {
            return neg(errno.E_FAULT)
        }
        put64(state, me, out, secs)
    }
    return secs
}

// ------------------------------------------------- ROUND K9: der Zufall

// `getrandom(buf, len, flags)`. Ueber den Zwischenpuffer des
// Datenbereichs, so wie jeder andere Weg nach Ring 3 -- der Generator
// kennt keine Adressraeume und soll keine kennen.
fn do_getrandom(state: u64, me: u64, buf: u64, want: u64) -> u64 {
    var len: u64 = want
    if len > MAX_IO {
        len = MAX_IO
    }
    if !proc.user_ok(state, me, buf, len) {
        return neg(errno.E_FAULT)
    }
    if len == 0 {
        return 0
    }
    let bounce: u64 = state + kstate.BLOCK_OFF
    rand.bytes(state, bounce, len)
    if !copy_out(state, me, buf, bounce, len) {
        return neg(errno.E_FAULT)
    }
    return len
}

// ----------------------------------------------- ROUND K9: die Terminals

// `ioctl(fd, request, arg)`. Der Kernel arbeitet auf seinem eigenen
// Puffer und kopiert ihn hin und zurueck -- die Regel von Runde K4, dass
// der Kernel nie einen Zeiger von Ring 3 haelt, gilt auch fuer eine
// Struktur, die 36 Oktette gross ist.
fn do_ioctl(state: u64, me: u64, fd: u64, req: u64, arg: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    let kind: u64 = file.open_kind(state, of)
    var t: u64 = tty.MAX_TTY
    if kind == file.K_CONIN || kind == file.K_CONOUT {
        t = tty_of(state, me)
    }
    if kind == file.K_TTY {
        t = file.open_ino(state, of)
    }
    if t >= tty.MAX_TTY {
        // Was kein Terminal ist, hat keine Terminaleigenschaften. -ENOTTY
        // ist die Antwort, an der jedes Programm merkt, dass seine
        // Ausgabe in eine Datei geht und nicht auf einen Schirm.
        return neg(errno.E_NOTTY)
    }
    let bounce: u64 = state + kstate.BLOCK_OFF
    var size: u64 = 36
    if req == tty.TIOCGWINSZ || req == tty.TIOCSWINSZ {
        size = 8
    }
    if req == tty.TIOCGPGRP || req == tty.TIOCSPGRP {
        size = 4
    }
    if arg == 0 || !proc.user_ok(state, me, arg, size) {
        return neg(errno.E_FAULT)
    }
    if !copy_in(state, me, bounce, arg, size) {
        return neg(errno.E_FAULT)
    }
    let r: u64 = tty.do_ioctl(state, t, req, bounce)
    if errno.is_error(r) {
        return r
    }
    if !copy_out(state, me, arg, bounce, size) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// `openpty(out)` -- ein Paar aus Steuer- und Nutzerseite. Zwei
// Deskriptoren, in `out[0]` und `out[1]`. Linux macht dasselbe in drei
// Schritten ueber `/dev/ptmx`, `grantpt` und `ptsname`; dieser Kernel hat
// kein Geraetedateisystem, und ein Aufruf, der beide Enden zurueckgibt,
// ist die ehrliche Form davon.
fn do_openpty(state: u64, me: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, 8) {
        return neg(errno.E_FAULT)
    }
    let sl: u64 = tty.alloc_pair(state)
    if sl >= tty.MAX_TTY {
        return neg(errno.E_NFILE)
    }
    let m: u64 = tty.peer_of(state, sl)
    let ofm: u64 = file.open_alloc(state, file.K_TTY, m, O_RDWR)
    if ofm >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let ofs: u64 = file.open_alloc(state, file.K_TTY, sl, O_RDWR)
    if ofs >= file.MAX_OPEN {
        file.open_unref(state, ofm)
        return neg(errno.E_NFILE)
    }
    let fdm: u64 = file.fd_alloc(state, me, 0)
    if fdm >= file.MAX_FD {
        file.open_unref(state, ofm)
        file.open_unref(state, ofs)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fdm, ofm)
    let fds: u64 = file.fd_alloc(state, me, 0)
    if fds >= file.MAX_FD {
        file.fd_free(state, me, fdm)
        file.open_unref(state, ofm)
        file.open_unref(state, ofs)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fds, ofs)
    kstate.add(state, kstate.OPENS, 2)
    if !put32(state, me, out, fdm) {
        return neg(errno.E_FAULT)
    }
    if !put32(state, me, out + 4, fds) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// Eine Zahl ueber die Signalschicht. Wie `sysinfo` aus Runde K6: ein
// Programm darf die Tabelle LESEN, es bekommt keinen Zeiger hinein.
const SI_PENDING: u64 = 0
const SI_MASK: u64 = 1
const SI_LAST: u64 = 2
const SI_DELIVERED: u64 = 3
const SI_SENT: u64 = 4
const SI_CAUGHT: u64 = 5
const SI_DEFAULT: u64 = 6
const SI_STOPS: u64 = 7
const SI_MYCOUNT: u64 = 8
const SI_STOPPED: u64 = 9
const SI_TTYSIGS: u64 = 10
// Die drei mit einem ZWEITEN Argument: sie fragen nach einem FREMDEN
// Prozess. Damit laesst sich von aussen messen, was ein angehaltener
// Prozess ist -- sein Zustand steht still und seine Rechenzeit auch. Ohne
// das waere "angehalten und fortgesetzt" eine Behauptung, die nur der
// Kernel selbst pruefen koennte.
const SI_STATE_OF: u64 = 20
const SI_TICKS_OF: u64 = 21
const SI_PEND_OF: u64 = 22

fn do_siginfo(state: u64, me: u64, what: u64, arg: u64) -> u64 {
    if what >= SI_STATE_OF {
        let i: u64 = sched.find_pid(state, arg)
        if i >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
        if what == SI_STATE_OF {
            return sched.tget(state, i, sched.T_STATE)
        }
        if what == SI_TICKS_OF {
            return sched.tget(state, i, sched.T_TICKS)
        }
        if what == SI_PEND_OF {
            return sched.tget(state, i, sched.T_SIGPEND)
        }
        return neg(errno.E_INVAL)
    }
    if what == SI_PENDING {
        return sched.tget(state, me, sched.T_SIGPEND)
    }
    if what == SI_MASK {
        return sched.tget(state, me, sched.T_SIGMASK)
    }
    if what == SI_LAST {
        return sched.tget(state, me, sched.T_SIGLAST)
    }
    if what == SI_DELIVERED {
        return kstate.get(state, kstate.SIG_DELIVERED)
    }
    if what == SI_SENT {
        return kstate.get(state, kstate.SIG_SENT)
    }
    if what == SI_CAUGHT {
        return kstate.get(state, kstate.SIG_CAUGHT)
    }
    if what == SI_DEFAULT {
        return kstate.get(state, kstate.SIG_DEFAULT)
    }
    if what == SI_STOPS {
        return kstate.get(state, kstate.SIG_STOPS)
    }
    if what == SI_MYCOUNT {
        return sched.tget(state, me, sched.T_SIGDEL)
    }
    if what == SI_STOPPED {
        return signal.stopped_count(state)
    }
    if what == SI_TTYSIGS {
        return kstate.get(state, kstate.TTY_SIGS)
    }
    return neg(errno.E_INVAL)
}

// Acht Oktette nach Ring 3, mit Pruefung je Seite.
// RUNDE LAUFZEIT: acht Oktette AUS dem Nutzerraum, das Gegenstueck zu
// `put64`. `writev` braucht es, um einen `struct iovec` zu lesen.
// Ueber `peek`, also durch dieselbe Uebersetzung und dasselbe
// SMAP-Fenster wie jeder andere Zugriff auf Ring-3-Speicher.
fn get_user64(state: u64, me: u64, addr: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 8 {
        v = v | (peek(state, me, addr + i) << (i * 8))
        i = i + 1
    }
    return v
}

// RUNDE FREMDLAND: zwei Oktette lesen bzw. schreiben. `struct flock`
// hat seine beiden Arten als `short`, und wer dort acht Oktette laese,
// laese die Fuellung mit.
fn user_half(state: u64, me: u64, addr: u64) -> u64 {
    let phys: u64 = proc.translate(state, me, addr)
    if phys == 0 {
        return 0
    }
    guard.stac(state)
    let v: u64 = (kstate.get8(phys) as u64)
        | ((kstate.get8(phys + 1) as u64) << 8)
    guard.clac(state)
    return v
}

fn put_half(state: u64, me: u64, addr: u64, v: u64) -> bool {
    if !poke(state, me, addr, v & 255) {
        return false
    }
    return poke(state, me, addr + 1, (v >> 8) & 255)
}

fn put_word32(state: u64, me: u64, addr: u64, v: u64) -> bool {
    var i: u64 = 0
    while i < 4 {
        if !poke(state, me, addr + i, (v >> (i * 8)) & 255) {
            return false
        }
        i = i + 1
    }
    return true
}

fn put64(state: u64, me: u64, addr: u64, v: u64) -> bool {
    var i: u64 = 0
    while i < 8 {
        if !poke(state, me, addr + i, (v >> (i * 8)) & 255) {
            return false
        }
        i = i + 1
    }
    return true
}

// ------------------------------------------------------ processes

fn do_getppid(state: u64, me: u64) -> u64 {
    let p: u64 = sched.tget(state, me, sched.T_PARENT)
    return sched.tget(state, p, sched.T_PID)
}

// THE ONE THAT WAS MISSING. `fork` gives the child everything the parent
// has: a copy of every mapped page, the same open files, the same
// registers -- and a zero in rax, which is the only thing the two of them
// see differently.
//
// The copy is EAGER: 4096 octets per mapped page, no copy-on-write. That
// is honest for this system (a page fault handler that shares frames and
// counts references is a round of its own) and it is why `fork` +
// `execve` is the expensive way to start a program here; `SYS_OSUM_EXEC`
// is the cheap one.
// RUNDE FREMDLAND: `clone`, und zwar der Fall, der zaehlt -- ein FADEN.
//
// musls `pthread_create` ruft es mit genau diesen Flaggen:
//   CLONE_VM|CLONE_FS|CLONE_FILES|CLONE_SIGHAND|CLONE_THREAD|
//   CLONE_SYSVSEM|CLONE_SETTLS|CLONE_PARENT_SETTID|CLONE_CHILD_CLEARTID
// und uebergibt in a1 den fertigen Stapel des neuen Fadens, in a4 den
// Fadenzeiger (TLS). Der Faden faengt NICHT bei einem Einsprungpunkt an,
// den der Kern kennt: musl legt die Startadresse selbst auf den Stapel
// und kehrt dorthin zurueck. Der Kern muss also nur eines richtig
// machen -- den neuen Faden mit demselben `rip` wie den Erzeuger
// starten, mit dem UEBERGEBENEN `rsp` und `rax = 0`.
//
// OHNE CLONE_VM ist `clone` in diesem Kern `fork`. Das ist keine
// Bequemlichkeit: ein Kind mit eigenem Adressraum IST ein fork, und
// alles andere waere eine zweite Umsetzung derselben Sache.
// RUNDE FREMDLAND: das Fadenkennungswort auf 0, wenn eines hinterlegt
// ist. Vier Oktette, denn es ist ein `int`.
fn clear_child_tid(state: u64, me: u64) {
    let addr: u64 = sched.tget(state, me, sched.T_FUTEX)
    if addr == 0 {
        return
    }
    sched.tset(state, me, sched.T_FUTEX, 0)
    let phys: u64 = proc.translate(state, me, addr)
    if phys == 0 {
        return
    }
    guard.stac(state)
    kstate.set8(phys, 0)
    kstate.set8(phys + 1, 0)
    kstate.set8(phys + 2, 0)
    kstate.set8(phys + 3, 0)
    guard.clac(state)
}

fn do_clone(state: u64, me: u64, frame: u64, flags: u64, stapel: u64,
    ptid: u64, ctid: u64, tls: u64) -> u64 {
    if sched.tget(state, me, sched.T_KIND) != sched.K_USER {
        return neg(errno.E_NOSYS)
    }
    // Kein gemeinsamer Adressraum: das ist ein Prozess, kein Faden.
    if (flags & CLONE_VM) == 0 {
        return do_fork(state, me, frame)
    }
    // Ein gemeinsamer Adressraum OHNE eigenen Stapel waere zwei
    // Ausfuehrungen auf demselben Stapelzeiger -- der eine schriebe dem
    // anderen den Rahmen um. Linux verlangt den Stapel hier ebenso.
    if stapel == 0 {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, stapel - 8, 8) {
        return neg(errno.E_FAULT)
    }
    let irq: u64 = sched.irq_save()
    let faden: u64 = proc.create_thread(state, me,
        sched.tget(state, me, sched.T_PRIO))
    if faden == 0 {
        sched.irq_restore(irq)
        return neg(errno.E_AGAIN)
    }
    // Die Deskriptoren: POSIX teilt sie unter Faeden, dieser Kern haelt
    // sie je Aufgabe -- also werden sie kopiert. Der Unterschied steht
    // in STATUS-FREMDLAND.md.
    file.inherit_task(state, me, faden)
    sched.fpu_inherit(state, me, faden)
    signal.inherit(state, me, faden)
    sched.tset(state, faden, sched.T_CWD,
        sched.tget(state, me, sched.T_CWD))
    uio.adopt(state, me, faden)
    // Halde und Abbildungsgrenze sind GEMEINSAM -- sie beschreiben
    // denselben Adressraum. Ein Faden mit eigener `T_BRK` liesse
    // `malloc` im einen Faden Seiten anlegen, die der andere fuer frei
    // haelt.
    sched.tset(state, faden, sched.T_BRK, brk_of(state, me))
    sched.tset(state, faden, sched.T_MMAP, map_bottom(state, me))
    sched.tset(state, faden, sched.T_BIG, sched.tget(state, me, sched.T_BIG))
    sched.tset(state, faden, sched.T_USTACK, stapel)
    netview.inherit(state, me, faden)
    // DIE FADENGRUPPE. `CLONE_THREAD` heisst: derselbe Prozess nach
    // aussen. `getpid` muss in jedem Faden dieselbe Zahl geben, `gettid`
    // verschiedene -- deshalb bleibt `T_PID` eigen und `T_TGID` wird die
    // des Erzeugers.
    if (flags & CLONE_THREAD) != 0 {
        sched.tset(state, faden, sched.T_TGID,
            sched.tget(state, me, sched.T_TGID))
    }
    // DER FADENZEIGER. Ohne ihn liest der neue Faden `%fs:0` des alten
    // -- und das ist der Fehler, den diese Runde bei `fork` schon einmal
    // gefunden hat.
    if (flags & CLONE_SETTLS) != 0 {
        sched.tset(state, faden, sched.T_FSBASE, tls)
    }
    let neue_tid: u64 = sched.tget(state, faden, sched.T_PID)
    // Die beiden Kennungsspeicher. `CHILD_SETTID` schreibt IN DEN
    // ADRESSRAUM, den beide teilen, also darf er hier stehen.
    if (flags & CLONE_PARENT_SETTID) != 0 {
        if proc.user_ok(state, me, ptid, 8) {
            put64(state, me, ptid, neue_tid)
        }
    }
    // CLONE_CHILD_CLEARTID: die Adresse, die beim Fadenende auf 0 gesetzt
    // werden MUSS. Daran haengt `pthread_join`: es wartet mit `futex` auf
    // genau dieses Wort. Ohne das Loeschen wartet es ewig -- gemessen,
    // bevor diese Zeilen standen: `th1` druckte "im faden" und blieb
    // dann stehen.
    //
    // Gemerkt wird sie in `T_FUTEX` (das Feld steht seit Langem in
    // `sched.fi` und war unbenutzt); `sched.exit_task` liest sie.
    // LAUFZEIT hatte fuer `set_tid_address` ausdruecklich entschieden,
    // NICHTS zu merken, weil kein Aufraeumen stattfand -- jetzt findet
    // es statt, also wird gemerkt.
    if (flags & CLONE_CHILD_CLEARTID) != 0 {
        if proc.user_ok(state, me, ctid, 4) {
            sched.tset(state, faden, sched.T_FUTEX, ctid)
        }
    }
    // Der Rahmen des neuen Fadens: der des Erzeugers, mit eigenem
    // Stapel und 0 als Antwort.
    let ctx: u64 = state + kstate.CTX_OFF + faden * F_BYTES
    var i: u64 = 0
    while i < F_BYTES / 8 {
        __mmio_write64((ctx + i * 8) as *mut u64,
            __mmio_read64((frame + i * 8) as *mut u64))
        i = i + 1
    }
    __mmio_write64((ctx + F_RAX) as *mut u64, 0)
    __mmio_write64((ctx + F_RSP) as *mut u64, stapel)
    sched.tset(state, faden, sched.T_ARG, proc.ARG_RESUME)
    kstate.add(state, kstate.SPAWNS, 1)
    sched.start(state, faden)
    sched.irq_restore(irq)
    return neue_tid
}

// RUNDE FREMDLAND: `futex` -- die Sperre, auf der musl steht.
//
// WAS HIER WIRKLICH GEBAUT IST, und der Satz gehoert in den Quelltext
// und nicht in eine Zusage, die niemand nachliest: dies ist ein
// WARTEN MIT NACHSEHEN, keine Warteschlange. `FUTEX_WAIT` prueft den
// Wert, und solange er steht, schlaeft der Faden eine Marke und sieht
// wieder nach. `FUTEX_WAKE` tut deshalb NICHTS ausser zu zaehlen -- es
// gibt keine Liste, aus der zu wecken waere.
//
// Warum das reicht: eine Sperre, die gehalten wird, wird von IHREM
// HALTER freigegeben, und der laeuft. Der Wartende sieht die Aenderung
// spaetestens eine Marke (10 ms) spaeter. Das kostet Zeit und keine
// Richtigkeit -- was NICHT passieren kann, ist ein verpasstes Wecken,
// denn es wird nicht auf ein Wecksignal gewartet, sondern auf den WERT.
//
// Was es nicht kann und was deshalb hier steht: eine Sperre, die
// hochfrequent gewechselt wird, kostet 10 ms je Wechsel statt Mikro-
// sekunden. Eine echte Warteschlange an `T_FUTEX`/`T_FUTEXVAL` (die
// Felder stehen seit Langem in `sched.fi`) ist der naechste Schritt.
fn do_futex(state: u64, me: u64, adresse: u64, befehl: u64, wert: u64,
    zeit: u64) -> u64 {
    // Die beiden Zusatzbits sagen nur, ob die Sperre prozesslokal ist
    // und welche Uhr gilt; fuer das Verhalten hier macht beides nichts.
    // Die Maske wird ABGEZOGEN und nicht negiert: `!` ist in dieser
    // Sprache der logische Nicht-Operator und nimmt nur bool.
    var was: u64 = befehl
    if (was & FUTEX_PRIVATE) != 0 {
        was = was - FUTEX_PRIVATE
    }
    if (was & FUTEX_CLOCK_RT) != 0 {
        was = was - FUTEX_CLOCK_RT
    }
    if (adresse & 3) != 0 {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, adresse, 4) {
        return neg(errno.E_FAULT)
    }
    if was == FUTEX_WAKE {
        // Es gibt keine Warteschlange, aus der zu wecken waere: die
        // Wartenden sehen selbst nach. Die Antwort ist die Zahl der
        // geweckten Faeden, und ehrlich ist hier 0.
        return 0
    }
    if was != FUTEX_WAIT {
        return neg(errno.E_INVAL)
    }
    // Steht der Wert nicht mehr, hat der Aufrufer die Aenderung
    // verpasst und darf sofort weiter -- das ist der ganze Sinn des
    // Wertvergleichs im Kern.
    if user_word32(state, me, adresse) != (wert & 0xFFFFFFFF) {
        return neg(errno.E_AGAIN)
    }
    // Ohne Zeitangabe wird nicht ewig gewartet, sondern hoechstens
    // FUTEX_MAX Marken. Ein Faden, der wirklich ewig wartet, ist von
    // einem verklemmten nicht zu unterscheiden, und dieser Kern hat
    // keinen, der ihn loesen koennte.
    var rest: u64 = FUTEX_MAX
    while rest > 0 {
        if signal.interrupted(state, me) {
            return neg(errno.E_INTR)
        }
        sched.sleep_ticks(state, 1)
        if user_word32(state, me, adresse) != (wert & 0xFFFFFFFF) {
            return 0
        }
        rest = rest - 1
    }
    return neg(errno.E_TIMEDOUT)
}

const FUTEX_MAX: u64 = 1000 // 10 Sekunden bei 100 Hz

// Vier Oktette aus dem Adressraum des Aufrufers. `futex` vergleicht
// einen `int`, nicht ein Wort -- wer hier 64 Bit laese, verglich vier
// Oktette Nachbarschaft mit.
fn user_word32(state: u64, me: u64, addr: u64) -> u64 {
    let phys: u64 = proc.translate(state, me, addr)
    if phys == 0 {
        return 0
    }
    guard.stac(state)
    let v: u64 = (kstate.get8(phys) as u64)
        | ((kstate.get8(phys + 1) as u64) << 8)
        | ((kstate.get8(phys + 2) as u64) << 16)
        | ((kstate.get8(phys + 3) as u64) << 24)
    guard.clac(state)
    return v
}

// RUNDE FREMDLAND: `mprotect`. Dieser Kern legt die Rechte einer Seite
// beim Abbilden fest (`elf.fi` nach dem Programmkopf, `map_page` sonst)
// und hat keinen Weg, sie danach zu aendern.
//
// musl ruft es beim Anlegen eines Fadenstapels, um eine SCHUTZSEITE
// ohne Rechte darunterzulegen. Faellt der Aufruf durch, legt musl
// keinen Faden an -- gemessen: `pthread_create` gab EAGAIN (11).
//
// Die Antwort ist deshalb 0, und was das heisst, steht hier: die
// Schutzseite ist KEINE. Ein Faden, der seinen Stapel ueberlaeuft,
// schreibt in die Nachbarseite, statt einen Seitenfehler zu bekommen.
// Das ist ein ehrlich benannter Mangel und kein Versehen -- die
// Alternative waere, gar keine Faeden zu koennen.
fn do_mprotect(state: u64, me: u64, addr: u64, len: u64, prot: u64) -> u64 {
    if (addr & 4095) != 0 {
        return neg(errno.E_INVAL)
    }
    if len == 0 {
        return 0
    }
    if !proc.user_ok(state, me, addr, 1) {
        return neg(errno.E_FAULT)
    }
    return 0
}

fn do_fork(state: u64, me: u64, frame: u64) -> u64 {
    if sched.tget(state, me, sched.T_KIND) != sched.K_USER {
        return neg(errno.E_NOSYS)
    }
    let flags: u64 = sched.irq_save()
    let child: u64 = proc.create_bare(state, sched.tget(state, me,
            sched.T_PRIO))
    if child == 0 {
        sched.irq_restore(flags)
        return neg(errno.E_AGAIN)
    }
    if proc.copy_space(state, me, child) == 0 {
        proc.discard(state, child)
        sched.irq_restore(flags)
        return neg(errno.E_NOMEM)
    }
    file.inherit_task(state, me, child)
    // RUNDE AVX: und der Vektorzustand. POSIX sagt, ein Kind faengt mit
    // der Gleitkommaumgebung seines Elternteils an -- Rundungsart,
    // Ausnahmemasken und die Register selbst.
    sched.fpu_inherit(state, me, child)
    // ROUND K9: die Routinen und die Maske erbt das Kind, die WARTENDEN
    // Signale nicht -- ein SIGINT, das dem Elternteil galt, galt nicht
    // einem Kind, das es damals noch nicht gab (POSIX).
    signal.inherit(state, me, child)
    sched.tset(state, child, sched.T_CWD, sched.tget(state, me, sched.T_CWD))
    // ROUND K6: and the working directory as TEXT, which is what `getcwd`
    // prints and what a relative path is completed with.
    uio.adopt(state, me, child)
    sched.tset(state, child, sched.T_BRK, brk_of(state, me))
    sched.tset(state, child, sched.T_MMAP, map_bottom(state, me))
    sched.tset(state, child, sched.T_BIG, sched.tget(state, me, sched.T_BIG))
    // RUNDE NETVIEW: das Kind sieht das Netz seines Elternteils, samt
    // dessen Liste erlaubter Ziele. Anders herum waere es ein Loch:
    // `fork` waere dann der Weg aus jeder Sicht heraus.
    netview.inherit(state, me, child)
    // RUNDE K16: das Kind erbt den Boden seines Stapels. Ohne diese
    // Zeile stuende dort null, und `proc.grow_stack` liesse den Stapel
    // eines `fork`-Kindes nicht wachsen -- ein Fehler, der erst beim
    // ersten tiefen Aufruf im Kind sichtbar wuerde.
    sched.tset(state, child, sched.T_USTACK, sched.tget(state, me, sched.T_USTACK))
    // RUNDE FREMDLAND, UND DAS WAR EIN ECHTER FEHLER SEIT LAUFZEIT.
    // Das Kind erbt die FS-BASIS, also seinen Fadenzeiger.
    //
    // GEMESSEN, bevor diese Zeile stand: `busybox sh -c 'seq 5 | sort'`
    // starb im ZWEITEN Glied der Roehre mit #GP auf `hlt` mitten in
    // musls `alloc_slot` -- das ist musls `a_crash()`, die Prueffrage
    // seiner Halde. Der Grund war nicht die Halde. `arch_prctl` legt die
    // Basis in `T_FSBASE`, `fork` kopierte sie nicht, das Kind bekam
    // also 0 -- und `sched.fsbase_apply` laesst bei 0 ABSICHTLICH die
    // Basis des vorigen Fadens stehen (fuer Osum-eigene Programme, die
    // %fs nie anfassen, ist das richtig). Fuer ein musl-Kind heisst es:
    // sein `%fs:0` zeigte in den Adressraum eines FREMDEN Prozesses.
    //
    // Der erste Zweig einer Roehre lief deshalb (er war ein Kind, das
    // gleich `execve` rief und dabei einen frischen Zeiger setzte), der
    // zweite starb -- er las durch den Zeiger, bevor er ihn setzte.
    sched.tset(state, child, sched.T_FSBASE,
        sched.tget(state, me, sched.T_FSBASE))
    // The context the child comes back on. `proc.resume_start` hands this
    // copy to `user_resume` in isr.s.
    let ctx: u64 = state + kstate.CTX_OFF + child * F_BYTES
    var i: u64 = 0
    while i < F_BYTES / 8 {
        __mmio_write64((ctx + i * 8) as *mut u64,
            __mmio_read64((frame + i * 8) as *mut u64))
        i = i + 1
    }
    __mmio_write64((ctx + F_RAX) as *mut u64, 0)
    sched.tset(state, child, sched.T_ARG, proc.ARG_RESUME)
    kstate.add(state, kstate.SPAWNS, 1)
    kstate.add(state, kstate.FORKS, 1)
    sched.start(state, child)
    sched.irq_restore(flags)
    return sched.tget(state, child, sched.T_PID)
}

// `execve(path, argv, envp)` -- the caller BECOMES the program. The
// environment is read and dropped: Osum has none yet, and a program that
// hands one over is not refused for it (docs/ROUNDK4.md).
//
// How the image gets in without a copy-on-write page fault handler: the
// loader builds a WHOLE NEW process for the file, the two swap address
// spaces, and the empty shell of the loader's process is discarded --
// which frees exactly the old image. Nothing else in the task changes:
// same pid, same parent, same descriptors, and that is what `execve`
// promises.
fn do_execve(state: u64, me: u64, frame: u64, path: u64, argv: u64) -> u64 {
    // ROUND K9: die Routinen des alten Abbilds zeigen in Code, den es
    // nach diesem Aufruf nicht mehr gibt. Was UEBERHOERT wurde, bleibt
    // ueberhoert (POSIX), alles andere faellt auf das Standardverhalten
    // zurueck. Frueh, damit auch ein fehlgeschlagener Aufruf nichts
    // Halbes hinterlaesst -- er kehrt vor jeder Aenderung zurueck.
    signal.exec_reset(state, me)
    // RUNDE AVX: und der Vektorzustand geht auf den Anfangswert zurueck.
    // Aus demselben Grund wie die Signalroutinen eine Zeile hoeher: was
    // das alte Abbild in MXCSR stehen hatte, geht das neue nichts an.
    sched.fpu_reset(state, me)
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if sched.tget(state, me, sched.T_KIND) != sched.K_USER {
        return neg(errno.E_NOSYS)
    }
    let name: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, path, name, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if len == 0 {
        return neg(errno.E_NOENT)
    }
    let abuf: u64 = state + kstate.EARG_OFF
    var at: u64 = 0
    var argc: u64 = 0
    if argv != 0 {
        var going: bool = true
        while going {
            if argc >= proc.MAX_ARGS {
                return neg(errno.E_2BIG)
            }
            if !proc.user_ok(state, me, argv + argc * 8, 8) {
                return neg(errno.E_FAULT)
            }
            let p: u64 = user_word(state, me, argv + argc * 8)
            if p == 0 {
                going = false
            } else {
                // RUNDE OFS3: MAX_ARG statt MAX_NAME, UND eine Schranke
                // gegen den Puffer. Ohne die zweite waere die erste nur
                // eine Rechnung, die stimmt, solange niemand
                // `proc.MAX_ARGS` erhoeht.
                if at + MAX_ARG + 1 > kstate.EARG_MAX {
                    return neg(errno.E_2BIG)
                }
                let n: u64 = fetch_name(state, me, p, abuf + at, MAX_ARG)
                if errno.is_error(n) {
                    return n
                }
                at = at + n + 1
                argc = argc + 1
            }
        }
    }
    let flags: u64 = sched.irq_save()
    let t: u64 = elf.build(state, name, abuf, argc, sched.tget(state, me,
            sched.T_PRIO))
    if t == 0 {
        sched.irq_restore(flags)
        let why: u64 = kstate.get(state, kstate.ELF_ERR)
        return neg(elf.errno_of(why))
    }
    let entry: u64 = sched.tget(state, t, sched.T_ENTRY)
    let ustack: u64 = sched.tget(state, t, sched.T_USTACK)
    let args: u64 = sched.tget(state, t, sched.T_WORK)
    // RUNDE K13: DAS setuid-BIT KOMMT HIER AN. `elf.build` hat die
    // Kennungen auf die eben gebaute Aufgabe geschrieben (sie erbt sie
    // von diesem Prozess und bekommt sie ueberschrieben, wenn die Datei
    // das Bit traegt). `execve` ist aber kein neuer Prozess -- der
    // Aufrufer WIRD das Programm -- also werden die vier Woerter
    // herueberkopiert, bevor die Huelle verworfen wird. Ohne diese vier
    // Zeilen haette ein setuid-Programm ueber `execve` keine Wirkung,
    // wohl aber ueber `spawn`, und die beiden Wege wuerden sich
    // unterscheiden.
    sched.tset(state, me, sched.T_EUID, sched.tget(state, t, sched.T_EUID))
    sched.tset(state, me, sched.T_EGID, sched.tget(state, t, sched.T_EGID))
    sched.tset(state, me, sched.T_SUID, sched.tget(state, t, sched.T_SUID))
    sched.tset(state, me, sched.T_SGID, sched.tget(state, t, sched.T_SGID))
    proc.swap_space(state, me, t)
    // The new tables FIRST, then the old ones are freed -- in that order,
    // because the processor is standing in the old ones right now.
    proc.use_space(state, me)
    proc.discard(state, t)
    sched.tset(state, me, sched.T_ENTRY, entry)
    sched.tset(state, me, sched.T_USTACK, ustack)
    // RUNDE FREMDLAND: UND DER FADENZEIGER GEHT AUF NULL.
    // Aus demselben Grund wie die Signalroutinen und MXCSR weiter oben:
    // die FS-Basis des ALTEN Abbilds zeigt in Speicher, den es nach
    // diesem Aufruf nicht mehr gibt. Das neue Abbild setzt sich seine
    // eigene mit `arch_prctl`, bevor es irgendetwas durch %fs liest --
    // bliebe die alte stehen, laese ein Programm, das (wie jedes
    // Osum-eigene) %fs nie anfasst, im Fehlerfall durch einen Zeiger
    // auf fremde Seiten.
    sched.tset(state, me, sched.T_FSBASE, 0)
    sched.tset(state, me, sched.T_BRK, 0)
    sched.tset(state, me, sched.T_MMAP, 0)
    sched.tset(state, me, sched.T_BIG, 0)
    // What ring 3 finds on the way out: a program at its entry point with
    // the argument block in rdi and nothing else left over from the
    // caller. Everything a process could have hidden in a register is gone
    // -- the image is new, and so is its state.
    var i: u64 = 0
    while i < F_BYTES / 8 {
        __mmio_write64((frame + i * 8) as *mut u64, 0)
        i = i + 1
    }
    fset(frame, F_RIP, entry)
    fset(frame, F_RSP, ustack)
    fset(frame, F_RDI, args)
    fset(frame, F_RFLAGS, 0x202)
    // ROUND POWERMON: the process is a different program from this
    // instruction on. Its power record starts again, and it starts with
    // the new name -- otherwise `sh` would carry away everything the
    // program it exec'd into ever spent, which is the plainest form of
    // the lie this round exists to avoid.
    pmon.task_clear(state, me, sched.tget(state, me, sched.T_PID))
    pmon.name_set(state, me, name)
    kstate.add(state, kstate.EXECVES, 1)
    // ROUND NETMON: THE SLOT KEPT ITS PID AND CHANGED ITS PROGRAM.
    // Everything the old image used belonged to the old image; carrying
    // it over would tell the person that `sh` downloaded a hundred
    // megabytes because it `exec`ed `wget`.
    netmon.task_clear(state, me, sched.tget(state, me, sched.T_PID))
    netmon.name_set(state, me, name)
    sched.irq_restore(flags)
    return 0
}

// `wait4(pid, status, options, rusage)`. The status is the Linux one: the
// exit code sits in bits 8..15, so `WEXITSTATUS` is a shift by eight. What
// comes back is the PID of the child, not its code -- round 62's `wait`
// returned the code, and a caller could not tell -1 from a child that
// exited with 255.
fn do_wait4(state: u64, me: u64, pid: u64, status: u64, options: u64) -> u64 {
    if status != 0 {
        if !proc.user_ok(state, me, status, 4) {
            return neg(errno.E_FAULT)
        }
    }
    // -1 means "any child" in Linux; in an unsigned register that is
    // 0xFFFFFFFFFFFFFFFF, and 0 has meant the same thing here since round
    // 62.
    var want: u64 = pid
    if want == (0 -% 1) {
        want = 0
    }
    var rounds: u64 = 0
    while rounds < 100000 {
        // ================================= RUNDE INIT: DER FEHLER VON K13
        //
        // HIER STAND `find_child`, UND DAS WAR EIN FEHLER, DER EIN
        // INIT-SYSTEM UNBRAUCHBAR MACHT. `find_child` gibt den ERSTEN
        // Prozess der Aufgabentafel zurueck, dessen Elternteil der Rufer
        // ist -- ohne nach seinem Zustand zu fragen. Lebt der noch, so
        // antwortete `wait4` mit WNOHANG hier eine 0 ("nichts Neues"),
        // und der ZOMBIE DAHINTER wurde nie abgeholt.
        //
        // Fuer eine Shell faellt das nie auf: sie wartet auf EIN Kind und
        // hat meist kein zweites. Fuer den Prozess 1 ist es toedlich --
        // er hat immer mehrere Kinder, und das langlebigste (die Konsole)
        // steht in der Tafel meist VOR den kurzlebigen Diensten. GEMESSEN
        // in dieser Runde: ein Dienst mit `respawn` blieb nach seinem
        // ZWEITEN Start fuer immer als Zombie stehen, `svc status` zeigte
        // ihn weiter als `running`, und die Aufgabentafel lief voll.
        //
        // Die Behebung ist, wonach man fragt: ZUERST nach einem Zombie,
        // und erst wenn es keinen gibt, danach, ob es ueberhaupt ein Kind
        // gibt (das unterscheidet "warte" von -ECHILD). Bei genau einem
        // Kind ist das Verhalten Zeile fuer Zeile das alte.
        //
        // GEGENPROBE: `waitfirst` auf der Kommandozeile stellt den alten
        // Weg wieder her. Damit MUSS derselbe Lauf den Zombie
        // stehenlassen.
        var child: u64 = kstate.MAX_TASKS
        if kstate.mode_on(state, kstate.M_WAITOLD) {
            child = find_child(state, me, want)
            if child >= kstate.MAX_TASKS {
                return neg(errno.E_CHILD)
            }
        } else {
            child = find_zombie_child(state, me, want)
            if child >= kstate.MAX_TASKS {
                if find_child(state, me, want) >= kstate.MAX_TASKS {
                    return neg(errno.E_CHILD)
                }
            }
        }
        if child < kstate.MAX_TASKS
            && sched.tget(state, child, sched.T_STATE) == sched.S_ZOMBIE {
            let code: u64 = sched.tget(state, child, sched.T_EXIT)
            let who: u64 = sched.tget(state, child, sched.T_PID)
            file.close_all(state, child)
            proc.reap(state, child)
            if status != 0 {
                if !put32(state, me, status, (code & 255) << 8) {
                    return neg(errno.E_FAULT)
                }
            }
            return who
        }
        if (options & WNOHANG) != 0 {
            return 0
        }
        sched.tset(state, me, sched.T_WAITPID, want)
        sched.tset(state, me, sched.T_STATE, sched.S_WAIT)
        sched.schedule(state)
        rounds = rounds + 1
    }
    return neg(errno.E_CHILD)
}

// RUNDE INIT: der Platz eines Kindes, das FERTIG IST, oder MAX_TASKS.
// Das ist die Frage, die `wait4` wirklich stellt -- "ist eines meiner
// Kinder gestorben" und nicht "habe ich Kinder". Siehe den langen
// Kommentar in `do_wait4`.
fn find_zombie_child(state: u64, me: u64, pid: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if sched.tget(state, i, sched.T_STATE) == sched.S_ZOMBIE {
            if sched.tget(state, i, sched.T_PARENT) == me {
                if pid == 0 || sched.tget(state, i, sched.T_PID) == pid {
                    return i
                }
            }
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

// The index of a child, or MAX_TASKS. `pid` 0 means: any of them.
fn find_child(state: u64, me: u64, pid: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if sched.tget(state, i, sched.T_STATE) != sched.S_FREE {
            if sched.tget(state, i, sched.T_PARENT) == me {
                if pid == 0 || sched.tget(state, i, sched.T_PID) == pid {
                    return i
                }
            }
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

// ------------------------------------------------- the two Osum calls

// RUNDE SYSTEMBUS: 61 ist `uprog.P_BUSB`, der Leser der Abnahme, und er
// steht hier EINZELN und nicht als angehobene Obergrenze. Die Grenze 16
// ist kein Zufall: alles darueber sind Programme, die der KERN startet
// (Messungen, Selbsttests), und ein Ring-3-Prozess, der sie sich selbst
// starten koennte, koennte sich damit auch die Messungen verstellen.
// Der Leser ist die eine Ausnahme, weil die Zusage a) der Runde ZWEI
// Prozesse braucht und der Schreiber der einzige ist, der weiss, wann
// der zweite da sein muss.
const P_BUSB_SPAWN: u64 = 61

fn do_spawn(state: u64, me: u64, prog: u64, arg: u64) -> u64 {
    if prog == 0 || (prog > 16 && prog != P_BUSB_SPAWN) {
        return neg(errno.E_INVAL)
    }
    let i: u64 = proc.create(state, prog, arg, 2)
    if i == 0 {
        return neg(errno.E_NOMEM)
    }
    netview.inherit(state, me, i)
    return sched.tget(state, i, sched.T_PID)
}

// `exec(path, argv, argc)` -- a program off the disk, in a process of its
// own, the way round K1 built it. Everything the process will need is
// copied into the KERNEL before a single frame is taken: the path and
// every argument. `elf.spawn` builds an address space and pours the file
// into it, and it may not be holding a pointer of ring 3 while it does
// that -- the caller could be swapped out, killed, or simply lying.
fn do_exec(state: u64, me: u64, path: u64, argv: u64, argc: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if argc > proc.MAX_ARGS {
        return neg(errno.E_2BIG)
    }
    let name: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, path, name, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if len == 0 {
        return neg(errno.E_INVAL)
    }
    let abuf: u64 = state + kstate.EARG_OFF
    var at: u64 = 0
    var k: u64 = 0
    while k < argc {
        if !proc.user_ok(state, me, argv + k * 8, 8) {
            return neg(errno.E_FAULT)
        }
        if at + MAX_ARG + 1 > kstate.EARG_MAX {
            return neg(errno.E_2BIG)
        }
        let n: u64 = fetch_name(state, me,
            user_word(state, me, argv + k * 8), abuf + at, MAX_ARG)
        if errno.is_error(n) {
            return n
        }
        at = at + n + 1
        k = k + 1
    }
    // ROUND POWERMON does not hook here: `elf.spawn` goes through
    // `elf.build`, and the naming sits there so that all six ways of
    // starting a program are covered by one line instead of five.
    let t: u64 = elf.spawn(state, name, abuf, argc, 2)
    if t == 0 {
        let why: u64 = kstate.get(state, kstate.ELF_ERR)
        elf.say_reason(why)
        return neg(elf.errno_of(why))
    }
    // RUNDE NETVIEW: `exec` ist hier kein `execve` -- es baut eine NEUE
    // Aufgabe, und eine neue Aufgabe kommt genullt, also `real`. Ohne
    // diese Zeile waere `exec` aus einem vorgetaeuschten Prozess heraus
    // der Weg an der Sicht vorbei.
    netview.inherit(state, me, t)
    // ROUND NETMON: a new task, a fresh set of counters, and the name
    // of the program they are counted under.
    netmon.task_clear(state, t, sched.tget(state, t, sched.T_PID))
    netmon.name_set(state, t, name)
    return sched.tget(state, t, sched.T_PID)
}

// ============================================================ Runde K11

// Der Umgebungsblock. Er wird in den Kernel KOPIERT, wie alles andere
// auch -- ein Zeiger von Ring 3 wird nie gehalten (Regel 3 ganz oben).
fn do_setenv(state: u64, me: u64, buf: u64, len: u64) -> u64 {
    if len > kstate.ENV_MAX {
        return neg(errno.E_2BIG)
    }
    if len != 0 && !proc.user_ok(state, me, buf, len) {
        return neg(errno.E_FAULT)
    }
    let dst: u64 = state + kstate.K11_OFF + kstate.ENV_BUF
    var i: u64 = 0
    var n: u64 = 0
    while i < len {
        let c: u64 = peek(state, me, buf + i)
        kstate.set8(dst + i, c as u8)
        if c == 0 {
            n = n + 1
        }
        i = i + 1
    }
    kstate.set(state, kstate.K11_OFF + kstate.ENV_N, n)
    kstate.set(state, kstate.K11_OFF + kstate.ENV_LEN, len)
    return n
}

// ==================================================== RUNDE K14
//
// EINHAENGEN MIT EINEM ZIEL. `mount(quelle, ziel, art, flaggen, daten)`
// ist Linux' Aufruf 165 und traegt hier Linux' Bedeutung: die QUELLE
// ist ein Geraetename, das ZIEL ein Verzeichnis, das es gibt, und die
// ART der Name eines Treibers.
//
// Was `SYS_OSUM_MOUNT` (1401, Runde K11) davon unterscheidet: jener
// hatte kein Ziel. Er konnte nur sagen "die eine Platte ist jetzt da".
// Er bleibt daneben stehen und tut genau das weiter.

fn name_is(state: u64, p: u64, lit: u64) -> bool {
    var i: u64 = 0
    while kstate.get8(p + i) != 0 && kstate.get8(lit + i) != 0 {
        if kstate.get8(p + i) != kstate.get8(lit + i) {
            return false
        }
        i = i + 1
    }
    return kstate.get8(p + i) == kstate.get8(lit + i)
}

fn fstype_of(state: u64, p: u64) -> u64 {
    var a: [u8; 4] = "ofs␀"
    var b: [u8; 5] = "proc␀"
    var c: [u8; 6] = "devfs␀"
    var d: [u8; 5] = "vfat␀"
    var e: [u8; 6] = "fat32␀"
    if name_is(state, p, (&a[0]) as u64) {
        return vfsops.FS_OFS
    }
    if name_is(state, p, (&b[0]) as u64) {
        return vfsops.FS_PROC
    }
    if name_is(state, p, (&c[0]) as u64) {
        return vfsops.FS_DEV
    }
    if name_is(state, p, (&d[0]) as u64) || name_is(state, p, (&e[0]) as u64) {
        return vfsops.FS_FAT
    }
    return vfsops.FS_NONE
}

// "/dev/hdb1" -> Geraet DEV_ATA1, Partition 1. Der Name wird von
// hinten gelesen: eine Ziffer am Ende ist eine Partitionsnummer, und
// was davor steht, ist das Geraet. Genau so liest jedes Unix diesen
// Namen, und deshalb ist "/dev/ram0" auch keine Partition 0 -- die
// Null gehoert zum Geraetenamen, und die Nummerierung faengt bei eins an.
fn source_dev(state: u64, p: u64, out_part: u64) -> u64 {
    var n_hda: [u8; 9] = "/dev/hda␀"
    var n_hdb: [u8; 9] = "/dev/hdb␀"
    var n_ram: [u8; 10] = "/dev/ram0␀"
    var n_nvme: [u8; 11] = "/dev/nvme0␀"
    var n_usb: [u8; 9] = "/dev/usb␀"
    var base: [u8; 32] = [0 as u8; 32]
    var n: u64 = 0
    while kstate.get8(p + n) != 0 && n < 31 {
        base[n as usize] = kstate.get8(p + n) as u8
        n = n + 1
    }
    base[n as usize] = 0 as u8
    __mmio_write64(out_part as *mut u64, 0)
    if name_is(state, (&base[0]) as u64, (&n_ram[0]) as u64) {
        return blk.DEV_RAM
    }
    if name_is(state, (&base[0]) as u64, (&n_nvme[0]) as u64) {
        return blk.DEV_NVME
    }
    // Eine Ziffer am Ende: Partitionsnummer.
    if n > 1 {
        let last: u64 = base[(n - 1) as usize] as u64
        if last >= 49 && last <= 57 {
            __mmio_write64(out_part as *mut u64, last - 48)
            base[(n - 1) as usize] = 0 as u8
        }
    }
    if name_is(state, (&base[0]) as u64, (&n_hda[0]) as u64) {
        return blk.DEV_ATA
    }
    if name_is(state, (&base[0]) as u64, (&n_hdb[0]) as u64) {
        return blk.DEV_ATA1
    }
    // RUNDE K17: der Stick. Er steht HIER und nicht bei /dev/ram0 oben,
    // weil sein Name KEINE Ziffer traegt -- `/dev/usb` ist der ganze
    // Traeger, `/dev/usb1` seine erste Partition, genau wie `/dev/hdb`
    // und `/dev/hdb1`. Das ist die Regel dieses Kernels, und ein Geraet,
    // das sich nicht daran haelt, waere ein Sonderfall im Namensraum.
    if name_is(state, (&base[0]) as u64, (&n_usb[0]) as u64) {
        return blk.DEV_USB
    }
    return 99
}

fn do_vfs_mount(state: u64, me: u64, src: u64, target: u64, kind: u64,
    flags: u64) -> u64 {
    if !vfs.ready(state) {
        return neg(errno.E_NOSYS)
    }
    if (flags & 0xFFFFFFFFFFFFFFFE) != 0 {
        return neg(errno.E_INVAL)
    }
    let sbuf: u64 = nameb(state) + 1024
    let tbuf: u64 = nameb(state)
    let kbuf: u64 = nameb(state) + NB_FSTYPE
    if errno.is_error(fetch_name(state, me, src, sbuf, 64)) {
        return neg(errno.E_FAULT)
    }
    let tl: u64 = fetch_path(state, me, target, tbuf, MAX_NAME)
    if errno.is_error(tl) {
        return tl
    }
    if errno.is_error(fetch_name(state, me, kind, kbuf, 32)) {
        return neg(errno.E_FAULT)
    }
    let ft: u64 = fstype_of(state, kbuf)
    if ft == vfsops.FS_NONE {
        return neg(errno.E_NODEV)
    }
    var mflags: u64 = 0
    if (flags & MNT_RDONLY) != 0 {
        mflags = mnt.F_RDONLY
    }
    var dev: u64 = 0
    var first: u64 = 0
    var count: u64 = 0
    if ft == vfsops.FS_FAT || ft == vfsops.FS_OFS {
        var pnum: u64 = 0
        dev = source_dev(state, sbuf, (&pnum) as u64)
        if dev == 99 {
            return neg(errno.E_NODEV)
        }
        if pnum == 0 {
            first = 0
            count = blk.blocks_on(state, dev)
        } else {
            // DIE PARTITIONSTAFEL. Ohne sie faengt ein Dateisystem bei
            // Block 0 an -- und dort steht auf einer partitionierten
            // Platte die Tafel selbst.
            if part.scan(state, dev) == 0 {
                return neg(errno.E_NODEV)
            }
            var found: u64 = part.MAX_PARTS
            var i: u64 = 0
            var seen: u64 = 0
            while i < part.MAX_PARTS {
                if part.index_of(state, i) != 0 {
                    if part.dev_of(state, i) == dev {
                        seen = seen + 1
                        if seen == pnum {
                            found = i
                            i = part.MAX_PARTS
                        }
                    }
                }
                if i < part.MAX_PARTS {
                    i = i + 1
                }
            }
            if found >= part.MAX_PARTS {
                return neg(errno.E_NODEV)
            }
            first = part.start(state, found)
            count = part.blocks(state, found)
        }
    }
    let m: u64 = vfs.mount_at(state, ft, dev, first, count, tbuf, mflags)
    if m >= vfs.MAX_MNT {
        return neg(errno.E_INVAL)
    }
    return 0
}

fn do_vfs_umount(state: u64, me: u64, target: u64) -> u64 {
    if !vfs.ready(state) {
        return neg(errno.E_NOSYS)
    }
    let tbuf: u64 = nameb(state)
    let tl: u64 = fetch_path(state, me, target, tbuf, MAX_NAME)
    if errno.is_error(tl) {
        return tl
    }
    let r: u64 = vfs.umount_path(state, tbuf)
    if r != 0 {
        return neg(r)
    }
    return 0
}

// `rename` -- Linux' 82. Die beiden Namen muessen auf DERSELBEN
// Einhaengung liegen; sonst -EXDEV, und `mv` weiss, was das heisst.
// ================================================== RUNDE INSTALL
//
// EIN ZWEITER NAME. Die Rechtefrage ist dieselbe wie bei `unlink`, nur
// andersherum: ein Name ENTSTEHT in einem Verzeichnis, also wird nach
// dem Schreibrecht an diesem Verzeichnis gefragt und nicht an der
// Datei. Und wie bei jedem Unix seit 1979: nur Dateien, nie
// Verzeichnisse -- `fs.link_path` sagt dazu selbst nein, hier steht es
// noch einmal, damit der Fehlerwert der richtige ist.
//
// NUR AUF DER WURZEL. Ein zweiter Name ueber eine Einhaengegrenze
// hinweg ist keine Verbindung, sondern eine Kopie mit einem falschen
// Namen; Linux sagt dazu EXDEV, und dieser Kern auch. FAT32 kennt
// ueberhaupt keine zweiten Namen.
fn do_link(state: u64, me: u64, from: u64, to: u64) -> u64 {
    let a: u64 = nameb(state)
    let b: u64 = nameb(state) + 1024
    let la: u64 = fetch_path(state, me, from, a, MAX_NAME)
    if errno.is_error(la) {
        return la
    }
    let lb: u64 = fetch_path(state, me, to, b, MAX_NAME)
    if errno.is_error(lb) {
        return lb
    }
    if vfs.ready(state) {
        let ma: u64 = vfs.mount_for(state, a)
        let mb: u64 = vfs.mount_for(state, b)
        if ma != mb {
            return neg(errno.E_XDEV)
        }
        if ma != 0 {
            return neg(errno.E_PERM)
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if fs.path(state, b) != 0 {
        return neg(errno.E_EXIST)
    }
    let dir: u64 = fs.parent_ino(state, b)
    if dir == 0 {
        return neg(errno.E_NOENT)
    }
    if !perm.may(state, me, dir, perm.R_WRITE | perm.R_EXEC) {
        return neg(errno.E_ACCES)
    }
    let r: u64 = fs.link_path(state, a, b)
    if r != 0 {
        return neg(r)
    }
    return 0
}

// ALLES AUF DEN TRAEGER. Die Zusage ist genau die von ATA FLUSH CACHE:
// der Befehl kommt zurueck, wenn nichts mehr aussteht. Fuer eine
// RAM-Platte ist er die Wahrheit ohne Arbeit, fuer FAT32 wird zusaetzlich
// die FSInfo-Seite geschrieben.
fn do_sync(state: u64, me: u64) -> u64 {
    var k: u64 = 0
    while k < vfs.MAX_MNT {
        if mnt.used(state, k) && mnt.fstype(state, k) == vfsops.FS_FAT {
            fat.sync(state, k)
        }
        k = k + 1
    }
    if !blk.flush(state) {
        return neg(errno.E_IO)
    }
    return 0
}

fn do_rename(state: u64, me: u64, from: u64, to: u64) -> u64 {
    let a: u64 = nameb(state)
    let b: u64 = nameb(state) + 1024
    let la: u64 = fetch_path(state, me, from, a, MAX_NAME)
    if errno.is_error(la) {
        return la
    }
    let lb: u64 = fetch_path(state, me, to, b, MAX_NAME)
    if errno.is_error(lb) {
        return lb
    }
    // ==================================== RUNDE MULTIUSER: DAS TOR
    //
    // `rename` hatte KEINE Rechtepruefung. Weder auf den Weg noch auf
    // die beiden Verzeichnisse -- ein gewoehnlicher Benutzer konnte
    // eine Datei aus einem fremden Verzeichnis herausbenennen, solange
    // er ihren Namen kannte. Umbenennen heisst: einen Namen aus dem
    // einen Verzeichnis nehmen und in das andere legen, und das
    // braucht in BEIDEN Schreib- und Betretungsrecht -- an der Datei
    // selbst nichts, denn ihr Inhalt wird nicht angefasst. Genau so
    // steht es in POSIX, und genau so steht es jetzt hier.
    if !perm.walk(state, me, a) {
        return neg(errno.E_ACCES)
    }
    if !perm.walk(state, me, b) {
        return neg(errno.E_ACCES)
    }
    if vfs.ready(state) {
        let ma: u64 = vfs.mount_for(state, a)
        let mb: u64 = vfs.mount_for(state, b)
        if ma >= vfs.MAX_MNT || mb >= vfs.MAX_MNT {
            return neg(errno.E_NOENT)
        }
        if ma != 0 || mb != 0 || vfs.all_mode(state) {
            let rv: u64 = vfs.v_rename(state, ma, a, mb, b)
            if rv != 0 {
                return neg(rv)
            }
            return 0
        }
    }
    // ==================================== RUNDE MULTIUSER: DIE WURZEL
    //
    // HIER STAND -ENOSYS, WENN DIE VFS-SCHICHT NICHT LAEUFT. Das war
    // seit Runde OFS3 eine Luecke mit Folgen: `passwd` will
    // /etc/shadow ueber eine Zwischendatei schreiben und danach
    // umbenennen -- die einzige Art, die Datei nicht halb
    // zurueckzulassen, wenn mitten im Schreiben der Strom ausfaellt --
    // und ohne `vfs` auf der Kommandozeile ging genau das nicht.
    //
    // Der Weg ist derselbe, den `do_open` fuer die Wurzel nimmt:
    // `fs.` unmittelbar. `vfs.v_rename` auf der Wurzel landet ohnehin
    // in derselben Funktion (`ofs.o_rename` -> `fs.rename_path`), also
    // ist das keine zweite Wahrheit, sondern derselbe Aufruf ohne den
    // Umweg ueber eine Tafel, die es gerade nicht gibt.
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let odir: u64 = fs.parent_ino(state, a)
    let ndir: u64 = fs.parent_ino(state, b)
    if odir == 0 || ndir == 0 {
        return neg(errno.E_NOENT)
    }
    if !perm.may(state, me, odir, perm.R_WRITE | perm.R_EXEC) {
        return neg(errno.E_ACCES)
    }
    if !perm.may(state, me, ndir, perm.R_WRITE | perm.R_EXEC) {
        return neg(errno.E_ACCES)
    }
    let r: u64 = fs.rename_path(state, a, b)
    if r != 0 {
        return neg(r)
    }
    return 0
}

// Ein Feld eines Eintrags der Einhaengetafel. Dieselbe Bauart wie
// SYS_OSUM_PSTAT: eine Zahl je Aufruf, kein Puffer, kein Zeiger.
// ==================================================== RUNDE K18
//
// DIE ENERGIESCHICHT AUS RING 3. Eigene Funktion und keine dreissig
// Zeilen in `dispatch`, aus demselben Grund wie bei `k13_call`,
// `vm_call` und `wig_call`: der Rahmen entsteht erst, wenn wirklich eine
// dieser Nummern kommt, und der tiefste Kernstapel eines Laufs ist
// gezaehlt (`osum: kstack deepest=`).
// ================================================== ROUND POWERMON
//
// `osum_pmon(kind, index, field)`. Its own function and not sixty
// branches in `dispatch`, for the reason written out at length above
// `k13_call`: every branch of `dispatch` costs stack whether it is taken
// or not, and this kernel has already overflowed its kernel stack once
// for exactly that reason.
// ================================================== RUNDE WERKZEUGE
//
// ZWEI FELDER VON `SYS_PSTAT`, DIE NICHT IN `uio.fi` STEHEN KOENNEN --
// und der Grund ist keine Vorliebe, sondern der Abhaengigkeitsgraph:
// `proc.fi` importiert `uio.fi` (Zeile 46 dort), also darf `uio.fi`
// nicht `proc.fi` importieren, und der Speicher eines Prozesses steht in
// seinen Seitentabellen, die `proc.fi` fuehrt. Dasselbe gilt fuer den
// Kern: den weiss der Planer.
//
// Also liegt hier die WEICHE und in `uio.pstat` alles Uebrige. Die
// Alternative waere gewesen, den Seitentabellenlauf ein zweites Mal in
// `uio.fi` zu schreiben -- zwei Stellen, die dieselbe Speicherkarte
// kennen muessen, und die eine davon merkt es nicht, wenn die andere
// sich aendert.
//
// Neue Felder werden ANGEHAENGT (8 und 9), nie eingeschoben: die alten
// Nummern stehen in `/bin/ps`, in `/bin/top` und in jedem Programm, das
// seit Runde K6 gegen diese Tafel gebaut wurde.
fn do_pstat(state: u64, index: u64, field: u64) -> u64 {
    if index >= kstate.MAX_TASKS {
        return neg(errno.E_INVAL)
    }
    if index >= kstate.get(state, kstate.TASKS) {
        return 0
    }
    if field == uio.P_CPU || field == uio.P_PAGES {
        if sched.tget(state, index, sched.T_STATE) == sched.S_FREE {
            return 0
        }
        if field == uio.P_CPU {
            // WELCHER KERN, und das ist der, auf dem die Aufgabe ZULETZT
            // lief -- `sched.cpu_of` liest genau das Feld, das der
            // Aufgabenwechsel schreibt. Fuer eine laufende Aufgabe ist
            // das der Kern, auf dem sie jetzt ist; fuer eine schlafende
            // der, auf dem sie zuletzt war. Etwas anderes gibt es nicht
            // zu wissen, und eine Aufgabe, die noch nie lief, bekommt
            // `MAX_CPUS` -- kein Kern, und nicht die Null, die wie Kern 0
            // aussaehe.
            return sched.cpu_of(state, index)
        }
        return proc.space_pages(state, index)
    }
    return uio.pstat(state, index, field)
}

// Ein Feld eines Kerns. Alles daraus steht im Satz des Kerns
// (`kernel/cpu.fi`) oder in der Aufgabe, die gerade auf ihm laeuft.
// RUNDE ALLTAG: die Sperre. Siehe die Nummer 1850 weiter oben.
fn do_sperre(state: u64, me: u64, op: u64, arg: u64) -> u64 {
    let ich: u64 = sched.tget(state, me, sched.T_PID)
    let sp: u64 = kstate.K11_OFF
    if op == 0 {
        return kstate.get(state, sp + kstate.SP_ON)
    }
    if op == 1 {
        if kstate.get(state, sp + kstate.SP_ON) == 0 {
            kstate.set(state, sp + kstate.SP_ON, 1)
            kstate.add(state, sp + kstate.SP_LOCKS, 1)
        }
        return 0
    }
    if op == 2 {
        if kstate.get(state, sp + kstate.SP_PID) != ich {
            return neg(errno.E_PERM)
        }
        kstate.set(state, sp + kstate.SP_ON, 0)
        kstate.set(state, sp + kstate.SP_PID, 0)
        kstate.set(state, sp + kstate.SP_SLOT, 0)
        kstate.add(state, sp + kstate.SP_UNLOCKS, 1)
        kstate.set(state, sp + kstate.SP_LAST, time.mono_ns(state))
        return 0
    }
    if op == 3 {
        var l: u64 = kstate.get(state, sp + kstate.SP_LAST)
        let jetzt: u64 = time.mono_ns(state)
        // NOCH NIE ETWAS EINGEGEBEN heisst nicht "kein Leerlauf",
        // sondern "der Leerlauf faengt jetzt an". Ohne diese zwei
        // Zeilen zaehlt der Waechter auf einer Maschine ohne
        // Fensterserver nie hoch -- gemessen: `lock -d` sperrte auf der
        // Konsole nie, weil `SP_LAST` dort niemand setzt.
        if l == 0 {
            kstate.set(state, sp + kstate.SP_LAST, jetzt)
            l = jetzt
        }
        if jetzt < l {
            return 0
        }
        return (jetzt - l) / 1000000
    }
    if op == 4 {
        let alt: u64 = kstate.get(state, sp + kstate.SP_PID)
        if alt != 0 && alt != ich {
            if sched.find_pid(state, alt) < kstate.MAX_TASKS {
                return neg(errno.E_PERM)
            }
        }
        kstate.set(state, sp + kstate.SP_PID, ich)
        kstate.set(state, sp + kstate.SP_SLOT, me)
        return 0
    }
    if op == 5 {
        return kstate.add(state, sp + kstate.SP_TRIES, 1)
    }
    if op == 6 {
        if arg == 0 {
            return kstate.get(state, sp + kstate.SP_LOCKS)
        }
        if arg == 1 {
            return kstate.get(state, sp + kstate.SP_UNLOCKS)
        }
        if arg == 2 {
            return kstate.get(state, sp + kstate.SP_TRIES)
        }
        if arg == 3 {
            return kstate.get(state, sp + kstate.SP_SPAWNS)
        }
        return kstate.get(state, sp + kstate.SP_PID)
    }
    return neg(errno.E_INVAL)
}

fn do_cpustat(state: u64, index: u64, field: u64) -> u64 {
    if field == CS_COUNT {
        return cpu.count(state)
    }
    if field == CS_ONLINE {
        return cpu.online_count(state)
    }
    if index >= kstate.MAX_CPUS || index >= cpu.count(state) {
        return neg(errno.E_INVAL)
    }
    if field == CS_UP {
        if cpu.online(state, index) {
            return 1
        }
        return 0
    }
    if field == CS_APICID {
        return cpu.apic_id(state, index)
    }
    if field == CS_TICKS {
        return cpu.get(state, index, cpu.C_TICKS)
    }
    if field == CS_IDLE {
        return cpu.get(state, index, cpu.C_IDLETICKS)
    }
    if field == CS_SWITCHES {
        return cpu.get(state, index, cpu.C_SWITCHES)
    }
    if field == CS_PICKS {
        return cpu.get(state, index, cpu.C_PICKS)
    }
    if field == CS_CURPID {
        let t: u64 = cpu.get(state, index, cpu.C_CUR)
        if t >= kstate.MAX_TASKS {
            return 0
        }
        return sched.tget(state, t, sched.T_PID)
    }
    return neg(errno.E_INVAL)
}

// ==================================================== RUNDE PROTOKOLL
fn do_klog(state: u64, me: u64, was: u64, arg: u64, ptr: u64,
        len: u64) -> u64 {
    if was == KL_SEQ {
        return klog.seq(state)
    }
    if was == KL_FIRST {
        return klog.first_seq(state)
    }
    if was == KL_LOST {
        return klog.lost(state)
    }
    if was == KL_FILT {
        return klog.filtered(state)
    }
    if was == KL_MIN {
        return klog.min_level(state)
    }
    if was == KL_SER {
        return klog.ser_level(state)
    }
    if was == KL_NENT {
        return klog.N_ENT
    }
    if was == KL_CRASH {
        return absturz.offen(state)
    }
    if was == KL_LINE {
        // DER PUFFER IM KERN UND NICHT IN RING 3. `klog.line_at`
        // schreibt Oktett fuer Oktett; direkt in den Adressraum des
        // Prozesses zu schreiben hiesse, das SMAP-Fenster fuer die
        // Dauer der ganzen Formatierung offen zu lassen. Also erst in
        // einen Kernpuffer, dann EIN `copy_out`.
        var b: [u8; 256] = [0 as u8; 256]
        var max: u64 = len
        if max > 256 {
            max = 256
        }
        let n: u64 = klog.line_at(state, arg, (&b[0 as usize]) as u64, max)
        if n == 0 {
            return 0
        }
        if !copy_out(state, me, ptr, (&b[0 as usize]) as u64, n) {
            return neg(errno.E_FAULT)
        }
        return n
    }
    if was == KL_SETMIN || was == KL_SETSER {
        if perm.euid(state, me) != 0 {
            return neg(errno.E_PERM)
        }
        if arg > klog.L_ERROR {
            return neg(errno.E_INVAL)
        }
        if was == KL_SETMIN {
            klog.set_min(state, arg)
        } else {
            klog.set_ser(state, arg)
        }
        return 0
    }
    if was == KL_WRITE {
        var t: [u8; 96] = [0 as u8; 96]
        var max: u64 = len
        if max > 95 {
            max = 95
        }
        if !copy_in(state, me, (&t[0 as usize]) as u64, ptr, max) {
            return neg(errno.E_FAULT)
        }
        kstate.set8((&t[0 as usize]) as u64 + max, 0 as u8)
        var q: [u8; 5] = "prog\0"
        var lv: u64 = arg
        if lv > klog.L_ERROR {
            lv = klog.L_INFO
        }
        klog.say(state, lv, (&q[0 as usize]) as u64,
            (&t[0 as usize]) as u64)
        return max
    }
    return neg(errno.E_INVAL)
}

// DER TESTAUSLOESER. Zwei Riegel (siehe oben bei SYS_OSUM_KRACH), und
// erst dahinter der Knall.
fn do_krach(state: u64, me: u64, art: u64) -> u64 {
    if !kstate.mode_on(state, kstate.M_KRACH) {
        return neg(errno.E_PERM)
    }
    if perm.euid(state, me) != 0 {
        return neg(errno.E_PERM)
    }
    absturz.knall(state, art)
    return 0
}

fn do_pmon(state: u64, me: u64, kind: u64, index: u64, field: u64) -> u64 {
    if kind == 0 {
        if field >= pmon.PM_SCALARS {
            return neg(errno.E_INVAL)
        }
        return pmon.scalar(state, field)
    }
    if kind == 1 {
        if index >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
        if field < pmon.PT_FIELDS {
            return pmon.tget(state, index, field)
        }
        if field == PT_PID {
            return pmon.task_pid(state, index)
        }
        if field == PT_ALIVE {
            if pmon.task_alive(state, index) {
                return 1
            }
            return 0
        }
        if field == PT_KIND {
            return sched.tget(state, index, sched.T_KIND)
        }
        if field == PT_STATE {
            return sched.tget(state, index, sched.T_STATE)
        }
        if field == PT_SCHEDTICKS {
            return sched.tget(state, index, sched.T_TICKS)
        }
        return neg(errno.E_INVAL)
    }
    if kind == 2 {
        if index >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
        return pmon.name_at(state, index, field)
    }
    if kind == 3 {
        if index >= pmon.NSAMPLE {
            return neg(errno.E_INVAL)
        }
        if field == 0 {
            return pmon.sample_rate(state, index)
        }
        if field == 1 {
            return pmon.sample_tick(state, index)
        }
        return neg(errno.E_INVAL)
    }
    if kind == 4 {
        if index >= pmon.NBUCKET || field > 2 {
            return neg(errno.E_INVAL)
        }
        return pmon.bucket_at(state, index, field)
    }
    if kind == 6 {
        // A PROGRAM ROW. This is the table a person is shown: a process
        // is not a program, and slot seven was `ls` a moment ago.
        if index >= pmon.NPROG || field >= pmon.PR_FIELDS {
            return neg(errno.E_INVAL)
        }
        return pmon.prog_get(state, index, field)
    }
    if kind == 7 {
        if index >= pmon.NPROG {
            return neg(errno.E_INVAL)
        }
        return pmon.prog_name_at(state, index, field)
    }
    if kind == 5 {
        // WRITING IS FOR THE OWNER OF THE MACHINE. Everything under
        // kind 5 destroys somebody else's numbers.
        if sched.tget(state, me, sched.T_EUID) != 0 {
            return neg(errno.E_PERM)
        }
        if index == PS_ROLLDAY {
            pmon.roll_day(state)
            return 0
        }
        if index == PS_RESET {
            pmon.reset_window(state)
            return 0
        }
        if index == PS_EVERY {
            if field == 0 || field > 1000 {
                return neg(errno.E_INVAL)
            }
            pmon.set_scalar(state, pmon.PM_EVERY / 8, field)
            return 0
        }
        if index == PS_ONOFF {
            pmon.set_on(state, field)
            return 0
        }
        return neg(errno.E_INVAL)
    }
    return neg(errno.E_INVAL)
}

fn pwr_call(state: u64, me: u64, number: u64, a0: u64, a1: u64,
    a2: u64) -> u64 {
    if number == SYS_OSUM_PWRGET {
        return do_pwrget(state, a0)
    }
    if number == SYS_OSUM_PWRSET {
        return do_pwrset(state, me, a0, a1)
    }
    return do_pwrstr(state, me, a0, a1, a2)
}

// ==================================================== RUNDE DISPLAY




fn do_pwrget(state: u64, field: u64) -> u64 {
    if field == PG_COUNT {
        return PG_COUNT
    }
    if field == PG_READY {
        if pwr.ready(state) {
            return 1
        }
        return 0
    }
    // OHNE ERKUNDUNG GIBT ES KEINE ZAHLEN. Das ist nicht Vorsicht,
    // sondern die Gegenprobe `nopwr`: ein Kernel, der die Schicht nicht
    // angeschaltet hat, muss auf JEDE Frage -ENODEV sagen und nicht eine
    // Null, die wie ein Messwert aussieht.
    if !pwr.ready(state) {
        return neg(errno.E_NODEV)
    }
    if field == PG_PROFILE {
        return pwr.cur_profile(state)
    }
    if field == PG_CAPS {
        return pwr.caps(state)
    }
    if field == PG_RATIOS {
        return pwr.value(state, pwr.PW_RATIOS)
    }
    if field == PG_RATIOSRC {
        return pwr.value(state, pwr.PW_RATIOSRC)
    }
    if field == PG_PERFCTL {
        return pwr.value(state, pwr.PW_PERFCTL)
    }
    if field == PG_PERFBACK {
        return pwr.value(state, pwr.PW_PERFBACK)
    }
    if field == PG_HWPREQ {
        return pwr.value(state, pwr.PW_HWPREQ)
    }
    if field == PG_HWPBACK {
        return pwr.value(state, pwr.PW_HWPBACK)
    }
    if field == PG_MISC {
        return pwr.value(state, pwr.PW_MISC)
    }
    if field == PG_MISCBACK {
        return pwr.value(state, pwr.PW_MISCBACK)
    }
    if field == PG_MISCORIG {
        return pwr.value(state, pwr.PW_MISCORIG)
    }
    if field == PG_CSTATE {
        return pwr.value(state, pwr.PW_CSTATE)
    }
    if field == PG_MWAITS {
        return pwr.value(state, pwr.PW_MWAITS)
    }
    if field == PG_HLTS {
        return pwr.value(state, pwr.PW_HLTS)
    }
    if field == PG_IDLERUNS {
        return pwr.value(state, pwr.PW_IDLERUNS)
    }
    if field == PG_TEMP {
        return pwr.temp_c(state)
    }
    if field == PG_TEMPOK {
        return pwr.value(state, pwr.PW_TEMPOK)
    }
    if field == PG_TJMAX {
        return pwr.value(state, pwr.PW_TJMAX)
    }
    if field == PG_THROTTLES {
        return pwr.value(state, pwr.PW_THROTTLES)
    }
    if field == PG_THROTTLED {
        return pwr.value(state, pwr.PW_THROTTLED)
    }
    if field == PG_APPLIES {
        return pwr.value(state, pwr.PW_APPLIES)
    }
    if field == PG_SWITCHES {
        return pwr.value(state, pwr.PW_SWITCHES)
    }
    if field == PG_MWAITHINT {
        return pwr.value(state, pwr.PW_MWAITHINT)
    }
    if field == PG_LIMIT {
        return pwr.value(state, pwr.PW_LIMIT)
    }
    if field == PG_TZRAW {
        return pwr.value(state, pwr.PW_TZRAW)
    }
    if field == PG_BRIGHT {
        return pwr.bright(state)
    }
    if field == PG_BLANKED {
        return pwr.value(state, pwr.PW_BLANKED)
    }
    if field == PG_BLANKS {
        return pwr.value(state, pwr.PW_BLANKS)
    }
    // ---- der Akku
    if field == PG_BATPRESENT {
        if batt.present(state) {
            return 1
        }
        return 0
    }
    if field == PG_BATWHY {
        return batt.why(state)
    }
    if field == PG_TABLES {
        return batt.value(state, batt.BT_TABLES)
    }
    if field == PG_ACOK {
        if batt.ac_known(state) {
            return 1
        }
        return 0
    }
    if field == PG_AC {
        if batt.ac_online(state) {
            return 1
        }
        return 0
    }
    // Ohne Akku gibt es keine Akkuzahlen -- und zwar -ENODEV und nicht
    // eine Null. Eine Null hiesse "leer", und das waere gelogen.
    if !batt.present(state) {
        return neg(errno.E_NODEV)
    }
    if field == PG_BATPERCENT {
        return batt.percent(state)
    }
    if field == PG_BATMINUTES {
        return batt.minutes(state)
    }
    if field == PG_BATSTATE {
        return batt.value(state, batt.BT_STATE)
    }
    if field == PG_BATRATE {
        return batt.value(state, batt.BT_RATE)
    }
    if field == PG_BATREMAIN {
        return batt.value(state, batt.BT_REMAIN)
    }
    if field == PG_BATFULL {
        return batt.value(state, batt.BT_FULL)
    }
    if field == PG_BATDESIGN {
        return batt.value(state, batt.BT_DESIGN)
    }
    if field == PG_BATVOLT {
        return batt.value(state, batt.BT_VOLT)
    }
    if field == PG_BATWARN {
        return batt.value(state, batt.BT_WARN)
    }
    if field == PG_BATLOW {
        return batt.value(state, batt.BT_LOW)
    }
    if field == PG_BATUNIT {
        return batt.value(state, batt.BT_UNIT)
    }
    return neg(errno.E_INVAL)
}

// DAS UMSCHALTEN. Wer das Profil aendert, aendert die Energieaufnahme der
// ganzen Maschine -- das ist eine Sache des Verwalters, wie bei jedem
// anderen System auch. `perm.is_root` gibt es seit Runde K13.
fn do_pwrset(state: u64, me: u64, field: u64, v: u64) -> u64 {
    if !pwr.ready(state) {
        return neg(errno.E_NODEV)
    }
    if sched.tget(state, me, sched.T_EUID) != 0 {
        return neg(errno.E_PERM)
    }
    if field == PS_PROFILE {
        if v >= pwr.PROF_COUNT {
            return neg(errno.E_INVAL)
        }
        if !pwr.set_profile(state, v) {
            return neg(errno.E_INVAL)
        }
        return 0
    }
    if field == PS_BRIGHT {
        if v > 100 {
            return neg(errno.E_INVAL)
        }
        if !gfx.fb_ready(state) {
            return neg(errno.E_NODEV)
        }
        pwr.set_bright(state, v)
        return 0
    }
    if field == PS_BLANK {
        if !gfx.fb_ready(state) {
            return neg(errno.E_NODEV)
        }
        if v != 0 {
            pwr.blank(state)
        } else {
            pwr.unblank(state)
        }
        return 0
    }
    return neg(errno.E_INVAL)
}

// Die vier Zeichenketten aus `_BIF`: Modell, Seriennummer, Art,
// Hersteller. Gibt die Laenge ohne die Null zurueck.
fn do_pwrstr(state: u64, me: u64, which: u64, dst: u64, len: u64) -> u64 {
    if !pwr.ready(state) {
        return neg(errno.E_NODEV)
    }
    if which > 3 {
        return neg(errno.E_INVAL)
    }
    if !batt.present(state) {
        return neg(errno.E_NODEV)
    }
    let src: u64 = batt.text_at(state, which)
    var n: u64 = 0
    while n < 63 && kstate.get8(src + n) != 0 {
        n = n + 1
    }
    if len < n + 1 {
        return neg(errno.E_INVAL)
    }
    if !copy_out(state, me, dst, src, n + 1) {
        return neg(errno.E_FAULT)
    }
    return n
}

fn do_mntstat(state: u64, index: u64, field: u64) -> u64 {
    if field == MS_COUNT {
        return mnt.count(state)
    }
    if index >= vfs.MAX_MNT {
        return neg(errno.E_INVAL)
    }
    if field == MS_USED {
        if mnt.used(state, index) {
            return 1
        }
        return 0
    }
    if !mnt.used(state, index) {
        return 0
    }
    if field == MS_TYPE {
        return mnt.fstype(state, index)
    }
    if field == MS_DEV {
        return mnt.dev(state, index)
    }
    if field == MS_FIRST {
        return mnt.first(state, index)
    }
    if field == MS_BLOCKS {
        return mnt.blocks(state, index)
    }
    if field == MS_FLAGS {
        return mnt.flags(state, index)
    }
    if field == MS_OPENS {
        return mnt.opens(state, index)
    }
    if field == MS_PATHLEN {
        return mnt.path_len(state, index)
    }
    if field >= MS_PATHCH {
        let i: u64 = field - MS_PATHCH
        if i >= mnt.path_len(state, index) {
            return 0
        }
        return kstate.get8(mnt.path_at(state, index) + i)
    }
    return neg(errno.E_INVAL)
}

// Ein- und Aushaengen. Ausgehaengt heisst: FS_READY ist null, und jeder
// Weg ins Dateisystem antwortet mit dem Fehler, den er dafuer schon
// hatte. Das ist keine Attrappe -- danach findet `ls /` wirklich nichts
// mehr, und `mount` bringt es wirklich zurueck.
fn do_mount(state: u64, op: u64) -> u64 {
    if op == 0 {
        return kstate.get(state, kstate.FS_READY)
    }
    if op == 1 {
        if fs.mount(state) {
            return 1
        }
        return neg(errno.E_NODEV)
    }
    if op == 2 {
        kstate.set(state, kstate.FS_READY, 0)
        return 0
    }
    return neg(errno.E_INVAL)
}

// ============================================================ Runde K16
//
// WOMIT MAN EINE DATEI OEFFNET -- die vier Aufrufe zu `kernel/ftype.fi`.
//
// Der Doppelklick selbst gehoert Runde K15. Was hier steht, ist die
// Schicht darunter, und sie ist so geschnitten, dass K15 sie nur RUFEN
// muss: eine Zeile fuer "was ist das", eine fuer "mach es auf".

// Ein nullbeendeter Text im Kern, kopiert. Zurueck kommt, wie viele
// Oktette einschliesslich der Null geschrieben wurden.
fn kcopy_word(dst: u64, src: u64, max: u64) -> u64 {
    var i: u64 = 0
    while i < max {
        let c: u64 = kstate.get8(src + i)
        kstate.set8(dst + i, c as u8)
        if c == 0 {
            return i + 1
        }
        i = i + 1
    }
    kstate.set8(dst + max - 1, 0 as u8)
    return max
}

// `ftype(pfad, aus, len)` -- was IST diese Datei? Zurueck kommt der Platz
// in der Tabelle, und nach `aus` (hoechstens `len` Oktette) der ganze
// Satz: Wirkung, magische Zahl, Endung, Programm, Bezeichnung. Wer nur
// die Art wissen will, gibt `aus` als 0 an.
fn do_ftype(state: u64, me: u64, path: u64, out: u64, len: u64) -> u64 {
    let name: u64 = nameb(state)
    let n: u64 = fetch_path(state, me, path, name, MAX_NAME)
    if errno.is_error(n) {
        return n
    }
    if n == 0 {
        return neg(errno.E_NOENT)
    }
    // Erst nachsehen, OB es sie gibt. Eine Datei, die nicht da ist, ist
    // -ENOENT -- nicht "eine Art, die ich nicht kenne". Der Unterschied
    // ist der zwischen "gibt es nicht" und "weiss nicht, womit".
    if kstate.get(state, kstate.FS_READY) != 0 {
    // RUNDE MULTIUSER: DAS BETRETUNGSRECHT AUF JEDEM GLIED DES PFADES.
    // Vor `fs.path` und nicht danach: wer ein Verzeichnis auf dem Weg
    // nicht betreten darf, soll nicht einmal erfahren, ob der Name
    // dahinter existiert. Die Begruendung und die Gegenprobe `nowalk`
    // stehen in `kernel/perm.fi`.
    if !perm.walk(state, me, name) {
        return neg(errno.E_ACCES)
    }
        if fs.path(state, name) == 0 {
            return neg(errno.E_NOENT)
        }
    }
    let art: u64 = ftype.classify(state, name)
    if art == ftype.T_NONE {
        return neg(errno.E_NOEXEC)
    }
    if out != 0 {
        var k: u64 = len
        if k > kstate.FT_SLOT {
            k = kstate.FT_SLOT
        }
        if !copy_out(state, me, out, ftype.record_for(state, art), k) {
            return neg(errno.E_FAULT)
        }
    }
    return art
}

// `flist(nr, aus, len)` -- die Tabelle durchgehen. Damit baut ein
// Dateiverwalter ein Menue "Oeffnen mit", ohne eine einzige Endung selbst
// zu kennen. Hinter dem letzten Eintrag: -ENOENT.
fn do_flist(state: u64, me: u64, nr: u64, out: u64, len: u64) -> u64 {
    if nr >= kstate.FT_SLOTS {
        return neg(errno.E_NOENT)
    }
    if kstate.get(state, ftype.slot_off(nr) + ftype.R_USED) == 0 {
        return neg(errno.E_NOENT)
    }
    if out != 0 {
        var k: u64 = len
        if k > kstate.FT_SLOT {
            k = kstate.FT_SLOT
        }
        if !copy_out(state, me, out, ftype.table_at(state, nr), k) {
            return neg(errno.E_FAULT)
        }
    }
    return nr
}

// `freg(satz, len)` -- einen Eintrag setzen oder ersetzen. Ring 3 darf
// das: die Tabelle ist eine Einstellung des Systems und kein Geheimnis.
// Was der Kern NICHT glaubt, sind die Laengen -- `ftype.register_from`
// setzt hinter jeden Text eine Null, egal was ankam.
fn do_freg(state: u64, me: u64, satz: u64, len: u64) -> u64 {
    if len != kstate.FT_SLOT {
        return neg(errno.E_INVAL)
    }
    let buf: u64 = state + kstate.BLOCK_OFF
    if !copy_in(state, me, buf, satz, len) {
        return neg(errno.E_FAULT)
    }
    let i: u64 = ftype.register_from(state, buf)
    if i >= kstate.FT_SLOTS {
        return neg(errno.E_NOSPC)
    }
    return i
}

// `fopen(pfad, argv, argc)` -- MACH DIESE DATEI AUF.
//
// Genau das, was ein Doppelklick heisst, und der ganze Unterschied zu
// `exec` ist die Zeile darueber: WAS gestartet wird, entscheidet die
// Tabelle und nicht der Aufrufer.
//
//   * ein Programm  -> es selbst, mit den Argumenten des Aufrufers
//   * eine `.fi`    -> `/bin/firun`, mit der Datei als erstem Argument
//   * ein `#!`      -> es selbst; den Ausleger findet `elf.build`
//   * sonst         -> -ENOEXEC, UND NICHTS IST GESTARTET
//
// Der letzte Punkt ist der wichtige: dieser Aufruf meldet keinen Erfolg,
// wenn keiner da ist. Ein Doppelklick, der nichts tut und trotzdem 0
// sagt, waere schlimmer als einer, der gar nichts tut.
fn do_fopen(state: u64, me: u64, path: u64, argv: u64, argc: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if argc > proc.MAX_ARGS {
        return neg(errno.E_2BIG)
    }
    let name: u64 = nameb(state)
    let n: u64 = fetch_path(state, me, path, name, MAX_NAME)
    if errno.is_error(n) {
        return n
    }
    if n == 0 {
        return neg(errno.E_NOENT)
    }
    // RUNDE MULTIUSER: DAS BETRETUNGSRECHT AUF JEDEM GLIED DES PFADES.
    // Vor `fs.path` und nicht danach: wer ein Verzeichnis auf dem Weg
    // nicht betreten darf, soll nicht einmal erfahren, ob der Name
    // dahinter existiert. Die Begruendung und die Gegenprobe `nowalk`
    // stehen in `kernel/perm.fi`.
    if !perm.walk(state, me, name) {
        return neg(errno.E_ACCES)
    }
    if fs.path(state, name) == 0 {
        ftype.refuse(state)
        return neg(errno.E_NOENT)
    }
    let art: u64 = ftype.classify(state, name)
    if art == ftype.T_NONE {
        ftype.refuse(state)
        return neg(errno.E_NOEXEC)
    }
    let wirkung: u64 = ftype.action_of(state, art)
    let abuf: u64 = state + kstate.EARG_OFF
    var at: u64 = 0
    var anz: u64 = 0
    var start: u64 = name
    if wirkung == ftype.A_EXEC {
        at = at + kcopy_word(abuf + at, name, MAX_NAME + 1)
        anz = 1
    } else {
        if wirkung != ftype.A_OPEN {
            ftype.refuse(state)
            return neg(errno.E_NOEXEC)
        }
        let prog: u64 = ftype.prog_of(state, art)
        if prog == 0 {
            ftype.refuse(state)
            return neg(errno.E_NOEXEC)
        }
        start = prog
        at = at + kcopy_word(abuf + at, prog, ftype.PROG_MAX)
        at = at + kcopy_word(abuf + at, name, MAX_NAME + 1)
        anz = 2
    }
    var k: u64 = 0
    while k < argc {
        if !proc.user_ok(state, me, argv + k * 8, 8) {
            return neg(errno.E_FAULT)
        }
        let m: u64 = fetch_name(state, me,
            user_word(state, me, argv + k * 8), abuf + at, MAX_NAME)
        if errno.is_error(m) {
            return m
        }
        at = at + m + 1
        anz = anz + 1
        k = k + 1
    }
    if anz > proc.MAX_ARGS {
        return neg(errno.E_2BIG)
    }
    let t: u64 = elf.spawn(state, start, abuf, anz, 2)
    if t == 0 {
        let why: u64 = kstate.get(state, kstate.ELF_ERR)
        elf.say_reason(why)
        ftype.refuse(state)
        return neg(elf.errno_of(why))
    }
    ftype.opened(state)
    // RUNDE NETVIEW: auch der Weg ueber die Dateiart baut eine NEUE
    // Aufgabe. Dieselbe Zeile wie in `do_exec` und aus demselben Grund.
    netview.inherit(state, me, t)
    return sched.tget(state, t, sched.T_PID)
}

// ============================================================ round K6
//
// A USERLAND, ON TOP OF THE POSIX LAYER OF ROUND K4. The two rounds were
// written at the same time and against different kernels, and this is
// where the difference was settled:
//
//   * ROUND K6'S DESCRIPTORS ARE GONE. It carried three standard
//      descriptors of its own with a position each, plus a `dup2` and a
//      `seek` for them, because the kernel of round K1 had no table of
//      open files. Round K4 built one, with reference counts and
//      sixteen descriptors per process (`kernel/file.fi`), and
//      `dup2` is 33 and `lseek` is 8 -- Linux's numbers, the ones every
//      program of this system already uses. K6's 40 and 41 were dropped
//      rather than kept as a second door onto the same thing.
//   * WHAT IS LEFT IS WHAT ROUND K4 DOES NOT HAVE: a working directory
//      that can be PRINTED (`sched.T_CWD` is an inode; `pwd` needs a
//      path), and three questions about the machine that `ps`, `df`,
//      `date` and `uname` may not answer by reading a kernel variable.
//
// The state is in `kernel/uio.fi`, one slot of 128 octets per task.

// A name out of ring 3 that is meant to be a PATH. The difference to
// `fetch_name` is one line and it is the whole of the working directory:
// a name that does not start with a slash is completed with it before the
// file system sees it. `exec` uses this for the program and `fetch_name`
// for the arguments -- an argument is not a path.
fn fetch_path(state: u64, me: u64, addr: u64, dst: u64, max: u64) -> u64 {
    let n: u64 = fetch_name(state, me, addr, dst, max)
    if errno.is_error(n) {
        return n
    }
    return uio.resolve(state, me, dst, n)
}

// `chdir(path)` -- Linux's number 80, and Linux's meaning. What is stored
// is the path with `.` and `..` folded away, because `getcwd` prints this
// string back and `/bin/../bin` is not a name anybody wants to read.
fn do_chdir(state: u64, me: u64, name: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    // RUNDE K13: in ein Verzeichnis wechseln heisst, es zu betreten.
    // RUNDE MULTIUSER: DAS BETRETUNGSRECHT AUF JEDEM GLIED DES PFADES.
    // Vor `fs.path` und nicht danach: wer ein Verzeichnis auf dem Weg
    // nicht betreten darf, soll nicht einmal erfahren, ob der Name
    // dahinter existiert. Die Begruendung und die Gegenprobe `nowalk`
    // stehen in `kernel/perm.fi`.
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    let ino: u64 = fs.path(state, buf)
    if ino != 0 {
        if !perm.may(state, me, ino, perm.R_EXEC) {
            return neg(errno.E_ACCES)
        }
    }
    return uio.chdir_to(state, me, buf)
}

// `getcwd(buf, size)`. ROUND K4 ANSWERED "/" HERE and wrote in its own
// comment that this was the gap: there was no working directory to
// report. There is one now. Linux returns the length INCLUDING the zero,
// and so does this.
fn do_getcwd(state: u64, me: u64, out: u64, size: u64) -> u64 {
    let n: u64 = uio.cwd_len(state, me)
    if size <= n {
        return neg(errno.E_RANGE)
    }
    if !proc.user_ok(state, me, out, n + 1) {
        return neg(errno.E_FAULT)
    }
    var i: u64 = 0
    while i < n {
        if !poke(state, me, out + i, uio.cwd_at(state, me, i)) {
            return neg(errno.E_FAULT)
        }
        i = i + 1
    }
    if !poke(state, me, out + n, 0) {
        return neg(errno.E_FAULT)
    }
    return n + 1
}

// ==================================================================
// die native ABI: Handles statt Umgebungsautoritaet
// ==================================================================
//
// Portiert aus OrientOS' `kernel/src/abi/native.rs`. Der Unterschied zur
// POSIX-Schicht darueber steht in einer Zeile: dort nennt der Aufrufer
// eine ZAHL, die der Kernel in seiner Tabelle nachschlaegt und die er
// geschenkt bekommen hat; hier nennt er ein HANDLE, das er nur besitzt,
// weil es ihm jemand gegeben hat, und das die Rechte mitfuehrt, mit denen
// es gegeben wurde.
//
// Was ein Handle in diesem Kernel bezeichnet: `cap.K_STREAM` mit der
// Nummer eines Eintrags der OFFENEN DATEIEN als Objekt. Das ist genau
// die Ebene, auf der ein Deskriptor in `file.fi` zeigt -- nur ohne die
// Deskriptornummer davor. Die uebrigen Objektarten (Kanal, Port,
// Namensraum, Prozess, Speicher) gibt es hier noch nicht; sie geben
// -E_UNSUPPORTED.

// Ein Handle beschaffen: der Kernel gibt einem Prozess ausdruecklich
// etwas. Das ist die einzige Stelle, an der Autoritaet ENTSTEHT -- alles
// andere kann sie nur weitergeben oder verkleinern.
fn grant_console(state: u64, task: u64, rights: u64) -> u64 {
    return cap.insert(state, task, cap.K_STREAM, rights, file.CON_OUT)
}

// Die Weiche. `number` ist >= CAP_BASE; `number - CAP_BASE` ist die
// Nummer INNERHALB der nativen ABI -- dieselbe wie in OrientOS.
// ===================================================== RUNDE HANDLE
//
// Die elf Aufrufe des Blocks ab 2200. Fehler kommen in der Zaehlung der
// nativen ABI zurueck (`handle.err`, negativ) und nicht in der von
// POSIX -- zwei ABIs, zwei Listen, eine gemeinsame waere eine Luege
// ueber beide.
fn handle_call(state: u64, me: u64, number: u64, a0: u64, a1: u64,
    a2: u64, a3: u64) -> u64 {
    if number > HND_MAXNR {
        return handle.err(handle.E_INVALID)
    }
    if number == HND_VERSION {
        return 1
    }
    if number == HND_COUNT {
        return handle.used(state, me)
    }
    if number == HND_FDH {
        return file.fd_handle(state, me, a0)
    }
    if number == HND_RIGHTS {
        if file.fd_handle(state, me, a0) == handle.HANDLE_NONE {
            return handle.err(handle.E_BADHANDLE)
        }
        return file.fd_rights(state, me, a0)
    }
    if number == HND_BEGIN {
        return handle.req_begin(state, me, a0, a1 & handle.R_ALL)
    }
    if number == HND_OBJECT {
        // Nur der EIGENTUEMER darf seinen Auftrag befragen. Ein Token
        // ist eine kleine Zahl mit Generation, aber es traegt keinen
        // Wuerfelwert je Prozess -- die Auftragstafel ist eine fuer das
        // ganze System, und die Eigentuemerfrage ist hier die Sperre.
        if handle.req_owner(state, a0) != me {
            return handle.err(handle.E_BADHANDLE)
        }
        return handle.req_object(state, a0)
    }
    if number == HND_STATE {
        if handle.req_owner(state, a0) != me {
            return handle.err(handle.E_BADHANDLE)
        }
        return handle.req_state(state, a0)
    }
    if number == HND_CANCEL {
        if !handle.req_cancel(state, me, a0) {
            return handle.err(handle.E_BADHANDLE)
        }
        return 0
    }
    if number == HND_END {
        if handle.req_owner(state, a0) != me {
            return handle.err(handle.E_BADHANDLE)
        }
        // DIE AUFGESCHOBENE FREIGABE. `req_end` sagt mit der
        // Objektnummer, dass mit diesem Auftrag der letzte Verweis
        // gefallen ist; dann -- und nur dann -- wird der Eintrag der
        // offenen Dateien wirklich abgeraeumt. Das ist die Stelle, an
        // der ein `close` waehrend eines Auftrags nachgeholt wird.
        let weg: u64 = handle.req_end(state, a0)
        if weg == 0 {
            return 0
        }
        file.open_settle(state, weg - 1)
        return 1
    }
    if number == HND_DUP {
        // Vervielfaeltigen mit BESCHNITTENEN Rechten, in einen zweiten
        // Deskriptor. Die Maske kann nur wegnehmen: `handle.give` an
        // sich selbst schneidet sie mit dem, was das Original hat.
        let of: u64 = of_of(state, me, a0)
        if of >= file.MAX_OPEN {
            return handle.err(handle.E_BADHANDLE)
        }
        let nfd: u64 = file.fd_alloc(state, me, 0)
        if nfd >= file.MAX_FD {
            return handle.err(handle.E_EXHAUSTED)
        }
        let got: u64 = file.fd_pass(state, me, me, a0, a1, nfd)
        if got >= file.MAX_FD {
            return handle.err(handle.E_RIGHTS)
        }
        return got
    }
    if number == HND_PASS {
        let ziel: u64 = sched.find_pid(state, a0)
        if ziel >= kstate.MAX_TASKS {
            return handle.err(handle.E_NOTFOUND)
        }
        let got: u64 = file.fd_pass(state, me, ziel, a1, a2, a3)
        if got >= file.MAX_FD {
            return handle.err(handle.E_RIGHTS)
        }
        return got
    }
    if number == HND_OBJINFO {
        // RUNDE ASYNC: auch ihr Selbsttest braucht die Innenschau --
        // "lebt das Objekt noch, waehrend der Auftrag laeuft" ist genau
        // die Frage, um die es dort geht. Der Rest bleibt, wie er war:
        // ohne eines der beiden Woerter gibt es nichts zu sehen.
        if !kstate.mode_on(state, kstate.M_HANDLE) {
            if !kstate.mode_on(state, kstate.M_ASYNC) {
                return handle.err(handle.E_UNSUPPORTED_HND)
            }
        }
        return objinfo(state, me, a0, a1)
    }
    return handle.err(handle.E_INVALID)
}

// Die Innenzahlen, die der Selbsttest braucht, um seine eigenen Zusagen
// nachzuweisen. Ohne sie koennte ein Programm in Ring 3 zwar sagen "das
// hat nicht geklappt", aber nicht "das Objekt lebt noch" -- und genau
// das ist die Zusage dieser Runde.
fn objinfo(state: u64, me: u64, was: u64, arg: u64) -> u64 {
    if was == 0 {
        return handle.objects_used(state)
    }
    if was == 1 {
        return handle.obj_refs(state, arg)
    }
    if was == 2 {
        return handle.obj_flight(state, arg)
    }
    if was == 3 {
        if handle.obj_live(state, arg) {
            return 1
        }
        return 0
    }
    if was == 4 {
        return handle.req_live(state)
    }
    if was == 5 {
        return handle.obj_gen(state, arg)
    }
    // 6: LEBT DER EINTRAG DER OFFENEN DATEIEN NOCH? Das ist die Zahl,
    // an der "kein Free waehrend in Flug" haengt.
    if was == 6 {
        if file.open_kind(state, arg) == file.K_FREE {
            return 0
        }
        return 1
    }
    if was == 7 {
        return file.open_refs(state, arg)
    }
    // 8: der Eintrag der offenen Dateien hinter einem DESKRIPTOR.
    if was == 8 {
        return of_of(state, me, arg)
    }
    if was == 9 {
        return handle.inflight_on(state, handle.OK_FILE, arg)
    }
    return handle.err(handle.E_INVALID)
}


// =================================================== RUNDE ASYNC
//
// DIE SECHS AUFRUFE, DIE ARBEITSFAEDEN UND DIE AUSFUEHRUNG.
//
// `kernel/async.fi` fuehrt Buch: Auftragstafel, Zustaende,
// Fertigmeldungsringe, Lebensdauer. WAS ein Auftrag tut, steht hier --
// weil es genau das ist, was `do_read`, `do_write` und `do_open` schon
// tun, und ein zweiter Pfad daneben waere ein zweiter Satz Fehler.
// (Roadmap KERNEL.md, Punkt 2: "POSIX-read/poll als duenne Schicht
// DARUEBER -- nicht als zweiter Pfad daneben.")

// Ein Fehler der Handle-Schicht in die Zaehlung von POSIX. Das ist die
// EINZIGE Stelle, an der die beiden Listen aufeinandertreffen; ein
// durchgereichter Wert waere eine Zahl, die in zwei Listen zwei Dinge
// bedeutet.
fn aio_errno(h: u64) -> u64 {
    let e: u64 = 0 -% h
    if e == handle.E_BADHANDLE {
        return neg(errno.E_BADF)
    }
    if e == handle.E_RIGHTS {
        return neg(errno.E_BADF)
    }
    if e == handle.E_EXHAUSTED {
        return neg(errno.E_AGAIN)
    }
    if e == handle.E_STALE {
        return neg(errno.E_STALE)
    }
    if e == handle.E_CANCELLED {
        return neg(errno.E_CANCELED)
    }
    return neg(errno.E_INVAL)
}

// Welches Recht eine Art verlangt. Es steht hier und nicht in
// `async.fi`, weil die Rechtebits der Handle-Schicht gehoeren und ein
// zweiter Ort dafuer ein zweiter Ort zum Vergessen waere.
fn aio_need(op: u64) -> u64 {
    if op == async.OP_READ {
        return handle.R_READ
    }
    if op == async.OP_WRITE {
        return handle.R_WRITE
    }
    // `fsync` verlangt KEIN Schreibrecht, und das ist nicht nachlaessig:
    // es schreibt nichts, es drueckt das schon Geschriebene auf den
    // Traeger. POSIX erlaubt ihn ausdruecklich auf einem nur lesbar
    // geoeffneten Deskriptor -- und die erste Fassung dieser Runde
    // verlangte R_WRITE, worauf ein asynchroner `fsync` auf einer mit
    // O_RDONLY geoeffneten Datei still an der Rechtepruefung haengen
    // blieb und der Test fuenf Sekunden lang auf eine Fertigmeldung
    // wartete, die nie kam.
    // `close` und `poll` verlangen kein Recht: ein Handle schliessen
    // darf, wer es hat, und nachsehen, ob etwas bereit ist, verraet
    // nichts, was ein `read` mit fehlendem Recht nicht auch verriete
    // (naemlich -EBADF).
    return handle.R_NONE
}

// ---------------------------------------------------------- die Abgabe
//
// DREI DINGE PASSIEREN HIER, UND DIE REIHENFOLGE IST DER PUNKT:
//
//   1. RUECKSTAU. Mehr als `async.CQ_CAP` offene Auftraege je Prozess
//      gibt es nicht -- dann ist die Antwort -EAGAIN und nicht eine
//      Meldung, die spaeter verlorengeht. Ein Ring, der verwirft, ist
//      schlimmer als eine Abgabe, die Nein sagt: das Nein kann das
//      Programm wiederholen, den Verlust nicht.
//   2. DER VERWEIS WIRD GENOMMEN, BEVOR DER PLATZ BELEGT WIRD.
//      `handle.req_begin` prueft Handle und Recht und zaehlt den
//      Auftrag am OBJEKT mit. Ab dieser Zeile kann der Prozess sein
//      Handle schliessen, so oft er will -- das Objekt bleibt stehen.
//   3. DER PFAD EINES `open` WIRD JETZT KOPIERT, im Zusammenhang des
//      Abgebenden. Der Arbeitsfaden liest ihn spaeter, und dann ist der
//      Puffer in Ring 3 vielleicht ueberschrieben oder der Adressraum
//      weg.
// DIE ARBEITSFAEDEN ENTSTEHEN BEI DER ERSTEN ABGABE UND NICHT BEIM
// HOCHFAHREN.
//
// Das ist keine Sparsamkeit, sondern Ruecksicht auf die Abnahme: vier
// zusaetzliche Aufgaben im Hochfahrpfad haetten in `tools/kernel/run.sh`
// und `tools/smp/run.sh` Zusagen umgeworfen, die Aufgaben ZAEHLEN und
// mit dieser Runde nichts zu tun haben. Ein Kernel, der nie einen
// asynchronen Auftrag bekommt, sieht danach genauso aus wie vorher --
// und das ist auch die richtige Aussage: eine Schicht, die niemand
// benutzt, soll nichts kosten.
fn aio_ensure(state: u64) -> bool {
    if async.ready(state) {
        return true
    }
    async.init(state)
    // GEGENPROBE `noawork`: keine Faeden. Die Auftraege werden dann vom
    // ABGEBENDEN Prozess ausgefuehrt -- dieselbe Buchfuehrung, dieselbe
    // Lebensdauer, nur ohne Nebenlaeufigkeit. Das ist der Massstab der
    // Durchsatzmessung.
    if kstate.mode_on(state, kstate.M_NOAWORK) {
        async.set_ready(state, 1)
        return true
    }
    var k: u64 = 0
    var da: u64 = 0
    while k < async.WORKERS {
        let t: u64 = sched.create(state, sched.K_AIO, 1, k, 0)
        if t != 0 {
            // EIN ARBEITSFADEN IST KEIN KIND DES ABGEBERS.
            //
            // `sched.create` traegt als Elternteil die LAUFENDE Aufgabe
            // ein -- und das ist hier der Prozess, der zufaellig als
            // erster einen Auftrag abgegeben hat. Damit stand ein
            // Kernfaden in seiner Kinderliste, und sein naechstes
            // `wait4(-1)` fand ihn statt seines wirklichen Kindes und
            // wartete fuer immer auf eine Leiche, die nie kommt.
            //
            // Der Fehler hat einen halben Testlauf gekostet und ist
            // genau die Sorte, die eine neue Schicht in eine alte
            // traegt: `wait4` ist seit Runde K4 richtig und war es
            // immer noch -- nur die Kinderliste war es nicht mehr.
            sched.tset(state, t, sched.T_PARENT, 0)
            if sched.start(state, t) {
                da = da + 1
            }
        }
        k = k + 1
    }
    if da == 0 {
        return false
    }
    async.set_ready(state, 1)
    return true
}

fn aio_submit(state: u64, me: u64, op: u64, fd: u64, buf: u64,
    len: u64, udata: u64) -> u64 {
    if op == async.OP_NONE || op > async.OP_MAX {
        return neg(errno.E_INVAL)
    }
    if !aio_ensure(state) {
        return neg(errno.E_NOSYS)
    }
    // 1. Rueckstau.
    if async.live_for(state, me) >= async.CQ_CAP {
        kstate.add(state, kstate.A_FULL, 1)
        return neg(errno.E_AGAIN)
    }
    var token: u64 = handle.TOKEN_NONE
    var laenge: u64 = len
    if op == async.OP_OPEN {
        // 3. Der Pfad in den Kern, JETZT.
        let slot: u64 = async.free_index(state)
        if slot >= async.MAX_AIO {
            kstate.add(state, kstate.A_FULL, 1)
            return neg(errno.E_AGAIN)
        }
        let ziel: u64 = state + kstate.APATH_OFF + slot * kstate.APATH_STRIDE
        let n: u64 = fetch_path(state, me, buf, ziel,
            kstate.APATH_STRIDE - 1)
        if errno.is_error(n) {
            return n
        }
        if n == 0 {
            return neg(errno.E_NOENT)
        }
        if n >= kstate.APATH_STRIDE - 1 {
            return neg(errno.E_NAMETOOLONG)
        }
        // Der Platz, dessen Pfadfeld eben beschrieben wurde, MUSS auch
        // der Platz werden, den `claim` nimmt -- sonst liest der
        // Arbeitsfaden den Pfad eines anderen Auftrags.
        let id: u64 = async.claim_at(state, slot, me,
            sched.tget(state, me, sched.T_PID), op, handle.TOKEN_NONE,
            0, laenge, udata, n)
        if id == 0 {
            return neg(errno.E_AGAIN)
        }
        return aio_kick(state, me, id)
    }
    // 2. Der Verweis.
    let h: u64 = file.fd_handle(state, me, fd)
    if h == handle.HANDLE_NONE {
        return neg(errno.E_BADF)
    }
    token = handle.req_begin(state, me, h, aio_need(op))
    if handle.is_err(token) {
        return aio_errno(token)
    }
    if op == async.OP_READ || op == async.OP_WRITE {
        if laenge > MAX_IO {
            laenge = MAX_IO
        }
        if !proc.user_ok(state, me, buf, laenge) {
            handle.req_end(state, token)
            return neg(errno.E_FAULT)
        }
    }
    let id: u64 = async.claim(state, me, sched.tget(state, me, sched.T_PID),
        op, token, buf, laenge, udata, fd)
    if id == 0 {
        // Der Verweis geht zurueck, und zwar ueber denselben Weg wie
        // sonst auch -- inklusive der aufgeschobenen Freigabe.
        let weg: u64 = handle.req_end(state, token)
        if weg != 0 {
            file.open_settle(state, weg - 1)
        }
        return neg(errno.E_AGAIN)
    }
    return aio_kick(state, me, id)
}

// Den Auftrag anstossen. Im Regelbetrieb weckt das die Arbeitsfaeden
// ueber die Weckfolge der Runde POLL; mit `noawork` gibt es keine, und
// dann fuehrt der ABGEBENDE Prozess seinen Auftrag selbst aus. Das ist
// die Gegenprobe zu der Behauptung, dass die Arbeit wirklich woanders
// geschieht -- und zugleich der Massstab der Durchsatzmessung.
fn aio_kick(state: u64, me: u64, id: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_NOAWORK) {
        let i: u64 = async.find(state, id)
        if i < async.MAX_AIO {
            if async.take_one(state, i) {
                aio_run(state, i)
            }
        }
        return id
    }
    sched.poll_kick(state)
    return id
}

// ---------------------------------------------------------- das Warten
//
// Blockierend mit Zeitgrenze, nicht blockierend, und beides mit
// DEFINIERTEM Ausgang -- das ist die Zusage (e): eine Warteschlange, die
// voll ist, und eine Frist, die ablaeuft, geben einen Fehler und keine
// Blockade.
//
//   tmo_ms > 0   warte hoechstens so lange; danach -ETIMEDOUT
//   tmo_ms == 0  sieh nach und komm zurueck; nichts da heisst 0
//   tmo_ms < 0   warte, bis etwas kommt (wie `poll`)
//
// Geweckt wird ueber `sched.poll_sleep` -- dieselbe Weckfolge, mit der
// die Runde POLL die Wettlaufsituation zwischen "nichts da" und "ich
// schlafe" aufgeloest hat. Ohne sie liefe eine Fertigmeldung, die
// waehrend des Nachsehens eingestellt wird, in den Schlaf hinein.
fn aio_wait(state: u64, me: u64, out: u64, max: u64, tmo: u64,
    min: u64) -> u64 {
    var n: u64 = max
    if n == 0 {
        return neg(errno.E_INVAL)
    }
    if n > async.CQ_CAP {
        n = async.CQ_CAP
    }
    // WIE VIELE MELDUNGEN MINDESTENS. Das ist `min_complete` von
    // io_uring, und es ist keine Bequemlichkeit: ohne es kostet ein
    // Stapel von sechzehn Auftraegen SECHZEHN Aufrufe von `aio_wait`,
    // weil jeder beim ersten Fund zurueckkommt. Gemessen war das der
    // groesste Einzelposten der ganzen Schicht.
    var mindest: u64 = min
    if mindest == 0 {
        mindest = 1
    }
    if mindest > n {
        mindest = n
    }
    if !proc.user_ok(state, me, out, n * async.C_BYTES) {
        return neg(errno.E_FAULT)
    }
    let forever: bool = tmo >= 0x80000000
    var ticks: u64 = 0
    if !forever && tmo != 0 {
        ticks = (tmo + 9) / 10 + 1
    }
    let deadline: u64 = kstate.get(state, kstate.TICKS) + ticks
    let scratch: u64 = state + kstate.ASC_OFF + 512
    var got: u64 = 0
    var going: bool = true
    while going {
        // ZUERST die Weckfolge merken, DANN nachsehen. Andersherum
        // liefe die Meldung, die waehrend des Nachsehens eingestellt
        // wird, in den Schlaf hinein und waere verloren.
        let seen: u64 = sched.poll_seq(state)
        var weiter: bool = true
        while weiter {
            if got >= n {
                weiter = false
            } else {
                if !async.reap_one(state, me, scratch) {
                    weiter = false
                } else {
                    if !copy_out(state, me, out + got * async.C_BYTES,
                        scratch, async.C_BYTES) {
                        return neg(errno.E_FAULT)
                    }
                    got = got + 1
                }
            }
        }
        if got >= mindest {
            return got
        }
        // WAS SCHON DA IST, GEHT NICHT VERLOREN. Ein Signal, eine
        // abgelaufene Frist und ein nicht blockierender Aufruf geben ab
        // der ersten Meldung DIESE zurueck und nicht den Fehler --
        // sonst haette der Aufrufer Meldungen abgeholt, von denen er
        // nichts erfaehrt, und sie waeren weg.
        if signal.interrupted(state, me) {
            if got != 0 {
                return got
            }
            return neg(errno.E_INTR)
        }
        if tmo == 0 {
            return got
        }
        if !forever {
            if kstate.get(state, kstate.TICKS) >= deadline {
                if got != 0 {
                    return got
                }
                kstate.add(state, kstate.A_TIMEOUTS, 1)
                return neg(errno.E_TIMEDOUT)
            }
        }
        var wake: u64 = deadline
        if forever {
            wake = sched.POLL_FOREVER
        }
        sched.poll_sleep(state, seen, wake)
    }
    return got
}

// -------------------------------------------------------- der Abbruch
//
// ZUSAGE (f): EIN FREMDER AUFTRAG GEHT NIEMANDEN AN. Die Kennung ist
// eine kleine Zahl mit Generation und traegt keinen Wuerfelwert je
// Prozess -- die Auftragstafel ist eine fuer das ganze System, und die
// Eigentuemerfrage ist hier die Sperre. Wer den Auftrag eines anderen
// abbrechen will, bekommt -EPERM und wird gezaehlt.
fn aio_cancel(state: u64, me: u64, id: u64) -> u64 {
    let i: u64 = async.find(state, id)
    if i >= async.MAX_AIO {
        return neg(errno.E_BADF)
    }
    if async.owner_of(state, i) != me {
        kstate.add(state, kstate.A_DENIED, 1)
        return neg(errno.E_PERM)
    }
    let wie: u64 = async.mark_cancel(state, me, i)
    if wie == 2 {
        // Schon fertig. Das ist kein Fehler des Programms: zwischen
        // seinem Entschluss und diesem Aufruf lag eine Zeitscheibe.
        return neg(errno.E_AGAIN)
    }
    if wie == 0 {
        // Er hatte noch nicht angefangen -- also meldet ihn der, der
        // ihn abgebrochen hat. GENAU EINMAL: der Arbeitsfaden hat ihn
        // nie bekommen, weil `mark_cancel` den Zustand mit einem
        // `lock cmpxchg` weggenommen hat.
        async.finish(state, i, neg(errno.E_CANCELED), async.Q_CANCEL)
        async.post(state, i)
    }
    return 0
}

// Die Innenzahlen, die der Selbsttest braucht. Wie `HND_OBJINFO` nur im
// Selbsttestmodus -- ein Testfenster, das im Regelbetrieb offen bleibt,
// ist eine Hintertuer.
fn aio_info(state: u64, me: u64, was: u64, arg: u64) -> u64 {
    if was == 0 {
        return async.used(state)
    }
    if was == 1 {
        return async.live(state)
    }
    if was == 2 {
        return async.live_for(state, me)
    }
    if was == 3 {
        return async.cq_used(state, me)
    }
    if was == 4 {
        return async.cq_lost(state, me)
    }
    if was == 5 {
        return async.bytes_per_request()
    }
    if was == 6 {
        // Der Zustand des Auftrags mit dieser Kennung, OHNE die
        // Eigentuemerfrage -- damit der Test zeigen kann, dass ein
        // fremder Auftrag zwar existiert und trotzdem nicht angefasst
        // werden darf.
        let i: u64 = async.find(state, arg)
        if i >= async.MAX_AIO {
            return 0
        }
        return async.state_of(state, i)
    }
    if was == 7 {
        return handle.objects_used(state)
    }
    if was == 8 {
        return handle.req_live(state)
    }
    if was == 9 {
        return async.CQ_CAP
    }
    if was == 10 {
        return async.MAX_AIO
    }
    if was == 20 {
        // Der Pruefstandshalt. Siehe `async.AS_HOLD`: er macht aus dem
        // Zeitfenster, in dem ein Auftrag abgegeben und noch nicht
        // ausgefuehrt ist, einen Zustand, den der Test HERSTELLEN kann.
        // Nur mit `async` auf der Kommandozeile erreichbar -- der
        // Aufruf darueber prueft es.
        async.hold(state, arg)
        // Freigeben heisst auch: die Faeden wecken, die darauf warten.
        if arg == 0 {
            sched.poll_kick(state)
        }
        return async.held(state)
    }
    if was == 21 {
        return kstate.get(state, kstate.A_ABANDONED)
    }
    if was == 22 {
        return kstate.get(state, kstate.A_POSTED)
    }
    if was == 23 {
        return kstate.get(state, kstate.A_STALED)
    }
    if was == 24 {
        return kstate.get(state, kstate.A_FULL)
    }
    if was == 25 {
        return kstate.get(state, kstate.A_COMPLETED)
    }
    if was == 26 {
        return kstate.get(state, kstate.A_TIMEOUTS)
    }
    if was == 27 {
        return kstate.get(state, kstate.A_DENIED)
    }
    if was == 28 {
        return kstate.get(state, kstate.A_CANCELLED)
    }
    return neg(errno.E_INVAL)
}

fn aio_call(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64,
    a3: u64, a4: u64) -> u64 {
    if number == AIO_VERSION {
        return 1
    }
    if number == AIO_SUBMIT {
        return aio_submit(state, me, a0, a1, a2, a3, a4)
    }
    if number == AIO_WAIT {
        return aio_wait(state, me, a0, a1, a2, a3)
    }
    if number == AIO_CANCEL {
        return aio_cancel(state, me, a0)
    }
    if number == AIO_STATE {
        let i: u64 = async.find(state, a0)
        if i >= async.MAX_AIO {
            return neg(errno.E_BADF)
        }
        if async.owner_of(state, i) != me {
            kstate.add(state, kstate.A_DENIED, 1)
            return neg(errno.E_PERM)
        }
        return async.state_of(state, i)
    }
    if number == AIO_INFO {
        // Nur im Selbsttest- oder Messmodus. Es gibt Innenzahlen des
        // Kernels heraus, und das ist kein Wissen, das ein Programm im
        // Regelbetrieb haben soll -- ein Testfenster, das im Regelbetrieb
        // offen bleibt, ist eine Hintertuer.
        if !kstate.mode_on(state, kstate.M_ASYNC) {
            if !kstate.mode_on(state, kstate.M_ABENCH) {
                return neg(errno.E_NOSYS)
            }
        }
        return aio_info(state, me, a0, a1)
    }
    return neg(errno.E_INVAL)
}

// ============================================== DIE AUSFUEHRUNG
//
// DIE FUNKTION, UM DIE ES IN DIESER RUNDE GEHT.
//
// Hier steht der Zugriff, der SPAETER geschieht als der Aufruf, der ihn
// bestellt hat. Alles, was in Linux' io_uring je schiefgegangen ist,
// geht in diesen zwanzig Zeilen schief, wenn sie falsch sind:
//
//   * `handle.req_object` fragt, ob das Handle NOCH IMMER DASSELBE
//     OBJEKT meint. Handle-Platz, Handle-Generation und
//     Objektgeneration werden verglichen; passt eines nicht, gibt es
//     -ESTALE. Die Gegenprobe `noagen` laesst die Frage weg und nimmt,
//     was gerade unter dem Deskriptor steht -- dann trifft der alte
//     Auftrag das neue Objekt. Genau das ist der Fehler, aus dem 2023
//     rund 60 % der eingereichten Linux-Kernel-Exploits kamen.
//
//   * DER EIGENTUEMER MUSS NOCH DERSELBE SEIN. Ein Aufgabenplatz wird
//     wiederverwendet; die pid nicht. Steht dort eine andere pid oder
//     eine Leiche, wird NICHTS in diesen Adressraum geschrieben -- der
//     Auftrag endet abgebrochen. Ohne diese vier Zeilen schreibt ein
//     Arbeitsfaden in Seiten, die `reap` gerade freigegeben hat.
//
//   * DIE AUSFUEHRUNGSSPERRE. `read_of` und `write_of` kopieren ueber
//     EINE Seite in `kdata` (`kstate.BLOCK_OFF`). Bis zu dieser Runde
//     konnte darin nur ein Systemaufruf stehen; mit vier Arbeitsfaeden
//     koennten es vier sein, und zwei Kopien in derselben Seite sind
//     eine kaputte Datei. Das ist der Preis dieser Runde, er ist
//     GEMESSEN und er steht in docs/ASYNC-STATUS.md: die Arbeit selbst
//     ist noch serialisiert. Was diese Schicht heute gewinnt, ist die
//     Zeit des ABGEBENDEN Prozesses, nicht die der Platte.
fn aio_exec(state: u64, i: u64) -> u64 {
    let op: u64 = async.op_of(state, i)
    let task: u64 = async.owner_of(state, i)
    let pid: u64 = async.pid_of(state, i)
    let buf: u64 = async.buf_of(state, i)
    let len: u64 = async.len_of(state, i)
    let fd: u64 = async.aux_of(state, i)
    // Lebt der Auftraggeber noch, und ist er noch derselbe?
    if pid == 0 {
        return neg(errno.E_CANCELED)
    }
    if task >= kstate.MAX_TASKS {
        return neg(errno.E_CANCELED)
    }
    if sched.tget(state, task, sched.T_PID) != pid {
        return neg(errno.E_CANCELED)
    }
    let ts: u64 = sched.tget(state, task, sched.T_STATE)
    if ts == sched.S_FREE || ts == sched.S_ZOMBIE {
        return neg(errno.E_CANCELED)
    }
    // Abgebrochen, bevor irgendetwas geschehen ist.
    if async.state_of(state, i) == async.Q_CANCEL {
        return neg(errno.E_CANCELED)
    }
    // `open` hat kein Ziel-Handle: es gibt noch nichts, worauf ein
    // Verweis zeigen koennte. Sein Pfad liegt seit der Abgabe im Kern.
    if op == async.OP_OPEN {
        async.lock_take(state, sched.current(state))
        let name: u64 = nameb(state)
        let n: u64 = kcopy_word(name, state + kstate.APATH_OFF
            + i * kstate.APATH_STRIDE, kstate.APATH_STRIDE)
        let r: u64 = open_named(state, task, name, n - 1, len)
        async.lock_give(state)
        return r
    }
    // ALLES ANDERE GEHT DURCH DIE GENERATIONSPRUEFUNG.
    var of: u64 = file.MAX_OPEN
    if kstate.mode_on(state, kstate.M_NOAGEN) {
        // GEGENPROBE: der Auftrag nimmt, was JETZT unter dem
        // Deskriptor steht. Das ist der io_uring-Fehler, absichtlich
        // wieder eingebaut.
        of = of_of(state, task, fd)
    } else {
        let got: u64 = handle.req_object(state, async.token_of(state, i))
        if handle.is_err(got) {
            kstate.add(state, kstate.A_STALED, 1)
            return aio_errno(got)
        }
        of = got
    }
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if op == async.OP_POLL {
        // DIE BRUECKE: READINESS AUF COMPLETION.
        //
        // `poll_ready` ist dieselbe Funktion, die `poll(2)` benutzt --
        // sie sagt, was auf diesem Deskriptor JETZT moeglich waere.
        // Hier wird daraus ein Auftrag, der FERTIG WIRD, sobald das
        // eintritt. Ein Programm, das nur Fertigmeldungen kennt, kann
        // damit auf Rohre, Steckdosen und Terminals warten, ohne
        // `poll` je aufzurufen.
        //
        // DIE ANDERE RICHTUNG GIBT ES NICHT, und das ist der Grund,
        // warum diese Runde vor Runde RING steht: `poll` kann sagen
        // "auf diesem Deskriptor waere jetzt etwas moeglich", aber es
        // kann nicht sagen "diese Datei ist gelesen und die Oktette
        // stehen in deinem Puffer". Eine gewoehnliche Datei ist immer
        // bereit -- readiness ist fuer sie keine Auskunft. Deshalb ist
        // completion die allgemeinere Primitive, und deshalb wird
        // readiness DARAUF abgebildet und nicht umgekehrt.
        var re: u64 = poll_ready(state, task, fd)
        re = re & (len | POLLERR | POLLHUP | POLLNVAL)
        if re == 0 {
            return 0 -% 0x1000000 // "noch nicht" -- siehe `aio_run`
        }
        return re
    }
    if op == async.OP_CLOSE {
        // Der Deskriptor geht zu -- das Objekt NICHT: dieser Auftrag
        // haelt es. `open_unref` sieht den Auftrag in Flug, schiebt die
        // Freigabe auf, und `async.finish` holt sie nach.
        return do_close(state, task, fd)
    }
    if op == async.OP_FSYNC {
        return fsync_of(state, of)
    }
    // DIE SPERRE NUR DA, WO SIE NOETIG IST.
    //
    // Die erste Fassung hat JEDE Ausfuehrung serialisiert, und damit war
    // die ganze Schicht auf vier Kernen so schnell wie auf einem. Noetig
    // ist die Sperre aber nur fuer die Wege, die ueber die EINE
    // Kopierseite `kstate.BLOCK_OFF` gehen: Dateien, eingehaengte
    // Dateisysteme, der Rahmenpuffer, Konsole und Terminal. Rohre und
    // Steckdosen kopieren unmittelbar zwischen ihrem eigenen Ring und
    // dem Adressraum des Prozesses -- sie brauchen sie nicht und
    // duerfen nebenlaeufig laufen.
    let sperre: bool = aio_braucht_sperre(state, of)
    if sperre {
        async.lock_take(state, sched.current(state))
    }
    var r: u64 = neg(errno.E_INVAL)
    if op == async.OP_READ {
        r = read_of(state, task, of, buf, len)
    }
    if op == async.OP_WRITE {
        r = write_of(state, task, of, buf, len)
    }
    if sperre {
        async.lock_give(state)
    }
    return r
}

// Braucht dieser Eintrag die eine Kopierseite von `sys.fi`? Die Antwort
// steht in `read_of`/`write_of`: dort, wo `state + kstate.BLOCK_OFF`
// vorkommt, ja -- sonst nein.
fn aio_braucht_sperre(state: u64, of: u64) -> bool {
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_PIPER {
        return false
    }
    if kind == file.K_PIPEW {
        return false
    }
    if kind == file.K_SOCK {
        return false
    }
    return true
}

// Einen uebernommenen Auftrag zu Ende bringen. GENAU EINE
// FERTIGMELDUNG: `post` steht hier ein einziges Mal, und wer hierher
// kommt, hat den Zustand mit einem `lock cmpxchg` weggenommen.
fn aio_run(state: u64, i: u64) {
    let r: u64 = aio_exec(state, i)
    // Ein `poll`-Auftrag, dessen Ereignis noch nicht eingetreten ist,
    // geht zurueck in die Warteschlange. Er ist damit KEIN halbfertiger
    // Auftrag: sein Zustand ist wieder `angelegt`, sein Verweis haelt
    // weiter, und gemeldet wird er erst, wenn er wirklich fertig ist.
    if r == 0 -% 0x1000000 {
        if async.state_of(state, i) == async.Q_RUN {
            async.set_state(state, i, async.Q_WAIT)
            return
        }
    }
    var endzustand: u64 = async.Q_DONE
    if async.state_of(state, i) == async.Q_CANCEL {
        endzustand = async.Q_CANCEL
    } else {
        if errno.is_error(r) {
            endzustand = async.Q_FAIL
        }
    }
    if endzustand == async.Q_CANCEL {
        async.finish(state, i, neg(errno.E_CANCELED), async.Q_CANCEL)
    } else {
        async.finish(state, i, r, endzustand)
    }
    async.post(state, i)
}

// DER ARBEITSFADEN. Verteilt wird er wie jeder andere Kernfaden in
// `tasks.main`; sein Rumpf steht hier, weil er `read_of` und `write_of`
// braucht und `tasks.fi` unter `sys.fi` liegt.
//
// Er DREHT NICHT. Ohne Arbeit legt er sich mit `poll_sleep` hin und
// wird von `sched.poll_kick` geweckt -- von derselben Weckfolge, mit
// der die Runde POLL ihre Wettlaufsituation geloest hat, gerufen aus
// `aio_kick` (eine Abgabe) und aus `async.post` (eine Meldung). Die
// Frist von einer Sekunde ist nur der Notausgang: ein `poll`-Auftrag,
// dessen Ereignis von einer Stelle kommt, die keinen Wecker schickt,
// wird damit hoechstens eine Sekunde spaeter bemerkt.
const AIO_IDLE_TICKS: u64 = 100

fn aio_worker(state: u64, index: u64) {
    while true {
        let seen: u64 = sched.poll_seq(state)
        let i: u64 = async.take_new(state)
        if i < async.MAX_AIO {
            aio_run(state, i)
        } else {
            sched.poll_sleep(state, seen,
                kstate.get(state, kstate.TICKS) + AIO_IDLE_TICKS)
            // GEWECKT HEISST: irgendwo ist Bereitschaft entstanden.
            // Genau dann -- und nur dann -- sehen die wartenden
            // `poll`-Auftraege wieder nach. Das ist die Bruecke von
            // readiness auf completion, und sie kostet keinen
            // Leerlaufzyklus.
            async.rearm(state)
        }
        sched.tset(state, index, sched.T_WORK,
            sched.tget(state, index, sched.T_WORK) + 1)
    }
}

// ------------------------------------------------------------- fsync
//
// ALLES, WAS DIE PLATTE NOCH IM KOPF HAT, AUF DEN TRAEGER. Es gab ihn
// bis zu dieser Runde nicht, und ohne ihn haette die asynchrone Fassung
// nichts, wogegen sie zu messen waere.
//
// Er ist ABSICHTLICH grober als POSIX: `blk.flush` leert den
// Zwischenspeicher der GANZEN Platte und nicht die Bloecke dieser einen
// Datei. Ein Dateisystem, das weiss, welche Bloecke zu welcher Datei
// gehoeren, hat dieses Repo (`fs.fi`) -- was es nicht hat, ist eine
// Liste der noch nicht geschriebenen. Solange jeder Schreibzugriff
// sofort auf die Platte geht, ist der ganze Zwischenspeicher der Platte
// die richtige Menge. Wenn das nicht mehr stimmt, stimmt diese Zeile
// nicht mehr, und dann gehoert sie geaendert und nicht ergaenzt.
fn fsync_of(state: u64, of: u64) -> u64 {
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_PIPER || kind == file.K_PIPEW {
        return neg(errno.E_INVAL)
    }
    if kind == file.K_SOCK {
        return neg(errno.E_INVAL)
    }
    if !blk.flush(state) {
        return neg(errno.E_IO)
    }
    return 0
}

fn do_fsync(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    return fsync_of(state, of)
}

fn native(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64,
    a3: u64, a4: u64) -> u64 {
    // RUNDE K10: der Fensterserver hat seinen eigenen Block ab 2100. Er
    // liegt in DIESER ABI und nicht bei den POSIX-Nummern, weil ein
    // Fenster ein HANDLE ist und kein Deskriptor: es wird nicht geerbt,
    // es hat Rechte, und wer es nicht bekommen hat, hat kein Fenster.
    // RUNDE HANDLE zuerst: ihr Block liegt UEBER dem des Fensterservers,
    // und `native` verteilt nach groesser-gleich. Andersherum landete
    // 2203 beim Fensterserver.
    if number >= HND_BASE {
        return handle_call(state, me, number, a0, a1, a2, a3)
    }
    if number >= WM_BASE {
        return gfx.sys_wm(state, me, number, a0, a1, a2, a3, a4)
    }
    if number > CAP_MAXNR {
        // Ein Aufruf, den es in dieser ABI nicht gibt. OrientOS antwortet
        // hier InvalidArgs, nicht NotSupported: die Nummer ist falsch,
        // nicht das Angebot.
        return cap.err(cap.E_INVALID)
    }
    if number == CAP_VERSION {
        return cap.ABI_VERSION
    }
    if number == CAP_COUNT {
        return cap.used(state, me)
    }
    if number == CAP_CLOSE {
        if !cap.close(state, me, a0) {
            return cap.err(cap.E_BADHANDLE)
        }
        return 0
    }
    // Alles Weitere braucht ein gueltiges Handle. GENAU HIER liegt der
    // Unterschied zu -EBADF von POSIX: ein gefaelschtes Handle und ein
    // echtes ohne das noetige Recht sind ZWEI Fehler, nicht einer.
    let i: u64 = cap.find(state, me, a0)
    if i >= cap.MAX_CAPS {
        return cap.err(cap.E_BADHANDLE)
    }
    let kind: u64 = cap.kind_at(state, me, i)
    let rights: u64 = cap.rights_at(state, me, i)
    let object: u64 = cap.object_at(state, me, i)

    if number == CAP_INSPECT {
        if !cap.rights_contains(rights, cap.R_INSPECT) {
            return cap.err(cap.E_RIGHTS)
        }
        // Art und Rechte, sonst nichts. Keine Objektnummer, kein Zeiger,
        // keine Kerneladresse -- so steht es in OrientOS' port.rs.
        if a1 != 0 {
            if !proc.user_ok(state, me, a1, 16) {
                return cap.err(cap.E_INVALID)
            }
            var k: u64 = 0
            while k < 8 {
                if !poke(state, me, a1 + k, (kind >> (k * 8)) & 255) {
                    return cap.err(cap.E_INVALID)
                }
                if !poke(state, me, a1 + 8 + k, (rights >> (k * 8)) & 255) {
                    return cap.err(cap.E_INVALID)
                }
                k = k + 1
            }
        }
        return 0
    }

    if number == CAP_DUP {
        if !cap.rights_contains(rights, cap.R_DUPLICATE) {
            return cap.err(cap.E_RIGHTS)
        }
        let h: u64 = cap.insert(state, me, kind,
            cap.rights_restrict(rights, a1), object)
        if h == cap.HANDLE_NONE {
            return cap.err(cap.E_EXHAUSTED)
        }
        return h
    }

    if number == CAP_TRANSFER {
        if !cap.rights_contains(rights, cap.R_TRANSFER) {
            return cap.err(cap.E_RIGHTS)
        }
        let ziel: u64 = sched.find_pid(state, a2)
        if ziel >= kstate.MAX_TASKS {
            return cap.err(cap.E_NOTFOUND)
        }
        let h: u64 = cap.insert(state, ziel, kind,
            cap.rights_restrict(rights, a1), object)
        if h == cap.HANDLE_NONE {
            return cap.err(cap.E_EXHAUSTED)
        }
        // Das Handle VERLAESST diese Tabelle. Ein uebertragenes Recht ist
        // kein geteiltes Recht.
        cap.close(state, me, a0)
        return h
    }

    if number == CAP_READ || number == CAP_WRITE {
        if kind != cap.K_STREAM {
            return cap.err(cap.E_WRONGTYPE)
        }
        var len: u64 = a2
        if len > MAX_IO {
            len = MAX_IO
        }
        if !proc.user_ok(state, me, a1, len) {
            return cap.err(cap.E_INVALID)
        }
        if object >= file.MAX_OPEN {
            return cap.err(cap.E_CLOSED)
        }
        if number == CAP_WRITE {
            if !cap.rights_contains(rights, cap.R_WRITE) {
                return cap.err(cap.E_RIGHTS)
            }
            let nw: u64 = write_of(state, me, object, a1, len)
            if errno.is_error(nw) {
                return cap.err(cap.E_CLOSED)
            }
            return nw
        }
        if !cap.rights_contains(rights, cap.R_READ) {
            return cap.err(cap.E_RIGHTS)
        }
        let nr: u64 = read_of(state, me, object, a1, len)
        if errno.is_error(nr) {
            return cap.err(cap.E_CLOSED)
        }
        return nr
    }
    return cap.err(cap.E_UNSUPPORTED)
}

// =====================================================================
// ROUND K8 -- THE SOCKETS
// =====================================================================
//
// Everything below keeps the three rules at the top of this file. The
// numbers are Linux's; nothing is answered silently (a domain that is
// not AF_INET gives -EAFNOSUPPORT, a descriptor that is not a socket
// gives -ENOTSOCK's nearest relative -EBADF, a pointer that is not the
// caller's gives -EFAULT, checked BEFORE it is followed); and the
// kernel never holds a pointer of ring 3 -- every buffer travels
// through the data area.
//
// A socket lives in TWO tables at once and that is on purpose:
//
//   the OPEN FILE TABLE of round K4  -- kind `file.K_SOCK`, and the
//       number of the socket in `OF_INO`. This is what makes `read`,
//       `write`, `close`, `dup2` and `fork` work on it without any of
//       them learning what a socket is.
//   the SOCKET TABLE of `inet.fi`    -- the kind (TCP/UDP/ICMP), the
//       handle in the stack of round K3, the bound port.
//
// The reference count of the first decides when the second is torn
// down: `unref_of` closes the connection only when the LAST descriptor
// pointing at it goes away. A `fork`ed child that closes its copy must
// not take the parent's connection with it.

// The socket behind a descriptor, or `inet.SOCK_MAX`.
fn sock_of(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return inet.SOCK_MAX
    }
    if file.open_kind(state, of) != file.K_SOCK {
        return inet.SOCK_MAX
    }
    return file.open_ino(state, of)
}

// One reference less on an open file, and the connection behind it torn
// down when that was the last one. Everything in this file that drops a
// descriptor goes through here.
fn unref_of(state: u64, of: u64) {
    if of < file.MAX_OPEN && file.open_kind(state, of) == file.K_SOCK {
        if file.open_refs(state, of) <= 1 {
            netview.release(state, file.open_ino(state, of))
            inet.sock_close(state, file.open_ino(state, of))
        }
    }
    // ROUNDE K14: der Zaehler der offenen Deskriptoren je Einhaengung
    // geht in `file.open_unref` herunter und nicht hier. Der Grund
    // steht dort: ein Prozess, der stirbt, kommt an dieser Funktion
    // vorbei (`file.close_all`), und ein `dup2`, das einen Deskriptor
    // ueberschreibt, ebenfalls.
    file.open_unref(state, of)
}

// The end of a process. Every socket it still holds and nobody else
// does is closed in an orderly way -- the FIN travels, and the state
// machine of round K3 walks through TIME_WAIT on its own afterwards.
fn sock_close_all(state: u64, me: u64) {
    var fd: u64 = 0
    while fd < file.MAX_FD {
        let of: u64 = of_of(state, me, fd)
        if of < file.MAX_OPEN && file.open_kind(state, of) == file.K_SOCK {
            if file.open_refs(state, of) <= 1 {
                netview.release(state, file.open_ino(state, of))
                inet.sock_close(state, file.open_ino(state, of))
            }
        }
        fd = fd + 1
    }
}

// ------------------------------------------------------ sockaddr_in

// Reads sixteen octets out of ring 3 and takes the address and the port
// out of them. The port and the address are BIG ENDIAN on the wire and
// in this structure; the family is not.
fn sa_in(state: u64, me: u64, addr: u64, len: u64, ipp: *mut u64,
    portp: *mut u64) -> u64 {
    *ipp = 0
    *portp = 0
    if addr == 0 || len < SA_BYTES {
        return neg(errno.E_INVAL)
    }
    // RUNDE NETVIEW: `inet.saddr` ist ein Rahmen, den der
    // KARTENTREIBER anlegt -- ohne Karte ist er null. Ein Prozess mit
    // vorgetaeuschtem Netz gibt trotzdem sockaddr_in herein, also gibt
    // es einen Ausweichplatz in `kdata`, den es immer gibt.
    var sa: u64 = inet.saddr(state)
    if sa == 0 {
        sa = netview.sa_scratch(state)
    }
    if !copy_in(state, me, sa, addr, SA_BYTES) {
        return neg(errno.E_FAULT)
    }
    let family: u64 = kstate.get8(sa) | (kstate.get8(sa + 1) << 8)
    if family != AF_INET {
        return neg(errno.E_AFNOSUPPORT)
    }
    *portp = (kstate.get8(sa + 2) << 8) | kstate.get8(sa + 3)
    *ipp = (kstate.get8(sa + 4) << 24) | (kstate.get8(sa + 5) << 16)
        | (kstate.get8(sa + 6) << 8) | kstate.get8(sa + 7)
    return 0
}

// And the other direction, with the `socklen_t*` the caller handed in:
// it is read AND written, exactly as `accept(2)` describes it.
fn sa_out(state: u64, me: u64, addr: u64, lenp: u64, a: u64,
    port: u64) -> u64 {
    if addr == 0 {
        return 0
    }
    var room: u64 = SA_BYTES
    if lenp != 0 {
        if !proc.user_ok(state, me, lenp, 4) {
            return neg(errno.E_FAULT)
        }
        room = 0
        var k: u64 = 0
        while k < 4 {
            room = room | (peek(state, me, lenp + k) << (k * 8))
            k = k + 1
        }
    }
    var sa: u64 = inet.saddr(state)
    if sa == 0 {
        sa = netview.sa_scratch(state)
    }
    sa = sa + 64
    var i: u64 = 0
    while i < SA_BYTES {
        kstate.set8(sa + i, 0 as u8)
        i = i + 1
    }
    kstate.set8(sa, (AF_INET & 0xFF) as u8)
    kstate.set8(sa + 1, ((AF_INET >> 8) & 0xFF) as u8)
    kstate.set8(sa + 2, ((port >> 8) & 0xFF) as u8)
    kstate.set8(sa + 3, (port & 0xFF) as u8)
    kstate.set8(sa + 4, ((a >> 24) & 0xFF) as u8)
    kstate.set8(sa + 5, ((a >> 16) & 0xFF) as u8)
    kstate.set8(sa + 6, ((a >> 8) & 0xFF) as u8)
    kstate.set8(sa + 7, (a & 0xFF) as u8)
    var n: u64 = SA_BYTES
    if room < n {
        n = room
    }
    if n > 0 {
        if !copy_out(state, me, addr, sa, n) {
            return neg(errno.E_FAULT)
        }
    }
    if lenp != 0 {
        var k: u64 = 0
        while k < 4 {
            if !poke(state, me, lenp + k, (SA_BYTES >> (k * 8)) & 0xFF) {
                return neg(errno.E_FAULT)
            }
            k = k + 1
        }
    }
    return 0
}

// -------------------------------------------------------- the calls

fn do_socket(state: u64, me: u64, domain: u64, kind: u64,
    protocol: u64) -> u64 {
    // RUNDE NETVIEW: OHNE KARTE GIBT ES KEINE STECKDOSE -- ausser fuer
    // einen Prozess, der ohnehin keine Karte sehen soll. Ein
    // vorgetaeuschtes Netz muss gerade auf der Maschine funktionieren,
    // die WIRKLICH keines hat; das ist der Fall, um den es geht.
    if !inet.ready(state) && netview.view_of(state, me) == netview.V_REAL {
        return neg(errno.E_NODEV)
    }
    if domain != AF_INET {
        return neg(errno.E_AFNOSUPPORT)
    }
    let flags: u64 = kind & (SOCK_NONBLOCK | SOCK_CLOEXEC)
    let base: u64 = kind & 0xFF
    var k: u64 = inet.SK_FREE
    if base == SOCK_STREAM {
        if protocol != 0 && protocol != IPPROTO_TCP {
            return neg(errno.E_PROTONOSUPPORT)
        }
        k = inet.SK_TCP
    } else if base == SOCK_DGRAM {
        // The ping socket Linux has had since 3.0. A `ping` that needs
        // no raw socket and no privilege is the reason it exists there,
        // and the reason it exists here.
        if protocol == IPPROTO_ICMP {
            k = inet.SK_ICMP
        } else if protocol == 0 || protocol == IPPROTO_UDP {
            k = inet.SK_UDP
        } else {
            return neg(errno.E_PROTONOSUPPORT)
        }
    } else {
        return neg(errno.E_PROTONOSUPPORT)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        return neg(errno.E_MFILE)
    }
    let si: u64 = inet.sock_new(state, k)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_NFILE)
    }
    // RUNDE NETVIEW: der Platz kommt frisch, also kommt auch die
    // Vortaeuschung frisch. Bedingungslos und nicht nur beim Schliessen
    // -- ein vergessener Platz duerfte sonst eine ECHTE Steckdose eines
    // ECHTEN Prozesses vorgetaeuscht erscheinen lassen.
    netview.reset(state, si)
    // ROUND NETMON: WHOSE SOCKET THIS IS. Written down here, in the one
    // moment the asking task and the running task are the same task. A
    // frame that arrives four milliseconds later arrives while somebody
    // else holds the processor, and asking the scheduler THEN would put
    // the octets on the wrong program.
    netmon.sock_open(state, si, me, sched.tget(state, me, sched.T_PID), k)
    if (flags & SOCK_NONBLOCK) != 0 {
        inet.sock_set_nonblock(state, si)
    }
    let of: u64 = file.open_alloc(state, file.K_SOCK, si, O_RDWR)
    if of >= file.MAX_OPEN {
        inet.sock_close(state, si)
        return neg(errno.E_NFILE)
    }
    file.fd_set(state, me, fd, of)
    return fd
}

fn do_bind(state: u64, me: u64, fd: u64, addr: u64, len: u64) -> u64 {
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    var a: u64 = 0
    var port: u64 = 0
    let r: u64 = sa_in(state, me, addr, len, &a, &port)
    if errno.is_error(r) {
        return r
    }
    // RUNDE NETVIEW: eine Sicht, die nicht `real` ist, bindet NICHTS an
    // den Stapel. Der Aufruf gelingt -- eine Anwendung, die auf einen
    // Anschluss horcht, soll nicht abstuerzen --, aber der Anschluss
    // existiert nur in ihrer eigenen Vorstellung: unter ihm liegt kein
    // Draht, also kommt dort nie etwas an (`do_accept` weiter unten).
    if netview.view_of(state, me) != netview.V_REAL {
        return 0
    }
    // An address that is neither 0.0.0.0 nor the one this machine has is
    // one nobody would ever answer for.
    if a != 0 && a != inet.ip(state) {
        return neg(errno.E_ADDRNOTAVAIL)
    }
    return inet.sock_bind(state, si, port)
}

fn do_listen(state: u64, me: u64, fd: u64, backlog: u64) -> u64 {
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    if netview.view_of(state, me) != netview.V_REAL {
        return 0
    }
    return inet.sock_listen(state, si, backlog)
}

// Waits, unless the descriptor was asked for in non-blocking mode. The
// waiting is `sleep_ticks`, so the network task goes on moving frames
// the whole time -- that is the whole reason it is a task.
fn do_accept(state: u64, me: u64, fd: u64, addr: u64, lenp: u64,
    flags: u64) -> u64 {
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    // RUNDE NETVIEW: unter diesem Anschluss liegt kein Draht. -EAGAIN
    // SOFORT und nicht nach dreissig Sekunden Schlafen: die ganze Runde
    // steht auf dem Satz, dass eine vorgetaeuschte Sicht nie haengt.
    if netview.view_of(state, me) != netview.V_REAL {
        return neg(errno.E_AGAIN)
    }
    let nb: bool = inet.sock_nonblock(state, si) || (flags & SOCK_NONBLOCK) != 0
    var waited: u64 = 0
    var got: u64 = inet.SOCK_MAX
    while got >= inet.SOCK_MAX {
        let c: u64 = inet.sock_accept(state, si)
        if !errno.is_error(c) && c < inet.SOCK_MAX {
            got = c
        } else if nb {
            return neg(errno.E_AGAIN)
        } else if waited >= NET_ROUNDS {
            return neg(errno.E_AGAIN)
        } else {
            waited = waited + 1
            sched.sleep_ticks(state, 1)
        }
    }
    let nfd: u64 = file.fd_alloc(state, me, 0)
    if nfd >= file.MAX_FD {
        inet.sock_close(state, got)
        return neg(errno.E_MFILE)
    }
    let of: u64 = file.open_alloc(state, file.K_SOCK, got, O_RDWR)
    if of >= file.MAX_OPEN {
        inet.sock_close(state, got)
        return neg(errno.E_NFILE)
    }
    file.fd_set(state, me, nfd, of)
    // ROUND NETMON: the accepted connection belongs to whoever accepted
    // it, not to whoever is listening -- with `fork` after `accept`
    // those are two different processes.
    netmon.sock_open(state, got, me, sched.tget(state, me, sched.T_PID),
        netmon.K_TCP)
    var pip: u64 = 0
    var pport: u64 = 0
    inet.sock_peer(state, got, &pip, &pport)
    let w: u64 = sa_out(state, me, addr, lenp, pip, pport)
    if errno.is_error(w) {
        return w
    }
    return nfd
}

// A blocking `connect` comes back when the handshake is done, an error
// when it was refused, and -ETIMEDOUT when nobody ever answered. State 4
// is ESTABLISHED and 0 is CLOSED in the numbering of `net.tcp`.
fn do_connect(state: u64, me: u64, fd: u64, addr: u64, len: u64) -> u64 {
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    var a: u64 = 0
    var port: u64 = 0
    let r: u64 = sa_in(state, me, addr, len, &a, &port)
    if errno.is_error(r) {
        return r
    }
    // ============================================== RUNDE NETVIEW: DIE TUER
    //
    // Hier faellt die Entscheidung, und sie faellt an EINER Stelle.
    // `real` geht weiter wie seit Runde K8. `none` scheitert SOFORT und
    // ehrlich. `faked` und ein nicht erlaubtes Ziel unter `filtered`
    // GELINGEN -- in diesem Aufruf, ohne Draht, ohne Warten.
    let d: u64 = netview.decide(state, me, a, port)
    if d == netview.D_DENY {
        return neg(errno.E_NETUNREACH)
    }
    if d == netview.D_FAKE {
        return netview.open_fake(state, si, inet.sock_kind(state, si),
            a, port)
    }
    let c: u64 = inet.sock_connect(state, si, a, port)
    if errno.is_error(c) {
        return c
    }
    if inet.sock_kind(state, si) != inet.SK_TCP {
        return 0
    }
    if inet.sock_nonblock(state, si) {
        return neg(errno.E_INPROGRESS)
    }
    var waited: u64 = 0
    while waited < NET_ROUNDS {
        let st: u64 = inet.sock_state(state, si)
        if st == 4 {
            return 0
        }
        let e: u64 = inet.sock_error(state, si)
        if e != 0 {
            return neg(e)
        }
        if st == 0 && waited > 20 {
            return neg(errno.E_CONNREFUSED)
        }
        waited = waited + 1
        sched.sleep_ticks(state, 1)
    }
    return neg(errno.E_TIMEDOUT)
}

// `send` and `recv` are these two with a null address -- that is what
// glibc does on x86-64, and copying it is what makes a Linux program
// work here without a translation table.
fn do_sendto(state: u64, me: u64, fd: u64, buf: u64, want: u64,
    addr: u64, alen: u64) -> u64 {
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    var len: u64 = want
    if len > MAX_IO {
        len = MAX_IO
    }
    var a: u64 = 0
    var port: u64 = 0
    if addr != 0 {
        let r: u64 = sa_in(state, me, addr, alen, &a, &port)
        if errno.is_error(r) {
            return r
        }
    }
    // ====================================================== RUNDE NETVIEW
    //
    // Zwei Faelle, und beide gehen an `inet.fi` VORBEI -- was hier
    // zurueckkehrt, hat den Stapel nie gesehen und kann darum keinen
    // Rahmen erzeugt haben.
    //
    // 1. Die Steckdose ist schon vorgetaeuscht (`connect` hat sie so
    //    angelegt). Dann zaehlt sie die Oktette und wirft sie weg.
    // 2. Sie ist es noch nicht und der Aufruf traegt SELBST ein Ziel --
    //    das ist ein Datagramm ohne `connect`, und ueber jedes einzelne
    //    wird neu entschieden.
    var fake: bool = netview.is_fake(state, si)
    if !fake && addr != 0 {
        let dc: u64 = netview.decide(state, me, a, port)
        if dc == netview.D_DENY {
            return neg(errno.E_NETUNREACH)
        }
        if dc == netview.D_FAKE {
            netview.open_fake(state, si, inet.sock_kind(state, si), a, port)
            fake = true
        }
    }
    if fake {
        // ES WERDEN NICHT ALLE OKTETTE HEREINKOPIERT, sondern hoechstens
        // die ersten 256: mehr sieht diese Seite sich ohnehin nicht an
        // (`netview.looks_http`, `build_dns`, `build_icmp`), und die
        // uebrigen werden GEZAEHLT und weggeworfen. Das Ergebnis ist
        // dasselbe, und der grosse Zwischenpuffer des Kartentreibers
        // wird nicht gebraucht -- der auf einer Maschine ohne Karte
        // nicht existiert.
        var peek: u64 = len
        if peek > netview.PEEK_MAX {
            peek = netview.PEEK_MAX
        }
        if peek > 0 {
            if !copy_in(state, me, netview.peek_buf(state), buf, peek) {
                return neg(errno.E_FAULT)
            }
        }
        return netview.sendto_fake(state, si, netview.peek_buf(state),
            len, a, port)
    }
    let bounce: u64 = inet.bounce(state)
    if !copy_in(state, me, bounce, buf, len) {
        return neg(errno.E_FAULT)
    }
    return sock_io(state, si, bounce, len, a, port, true)
}

fn do_recvfrom(state: u64, me: u64, fd: u64, buf: u64, want: u64,
    addr: u64, lenp: u64) -> u64 {
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    var len: u64 = want
    if len > MAX_IO {
        len = MAX_IO
    }
    if !proc.user_ok(state, me, buf, len) {
        return neg(errno.E_FAULT)
    }
    // ====================================================== RUNDE NETVIEW
    //
    // EINE Runde, kein Warten. Die Warteschleife weiter unten schlaeft
    // bis zu NET_ROUNDS Ticks -- dreissig Sekunden --, wenn nichts da
    // ist. Fuer eine vorgetaeuschte Sicht waere das genau das Haengen,
    // das diese Runde vermeiden soll: was da ist, kommt sofort, und was
    // nicht da ist, ist sofort das Ende des Stroms (TCP) oder sofort
    // -EAGAIN (Datagramm).
    if netview.is_fake(state, si) {
        var fa: u64 = 0
        var fp: u64 = 0
        var fl: u64 = len
        if fl > netview.PEEK_MAX {
            fl = netview.PEEK_MAX
        }
        let got: u64 = netview.recvfrom_fake(state, si,
            netview.peek_buf(state), fl, &fa, &fp)
        if errno.is_error(got) {
            return got
        }
        if got > 0 {
            if !copy_out(state, me, buf, netview.peek_buf(state), got) {
                return neg(errno.E_FAULT)
            }
        }
        if addr != 0 {
            let fw: u64 = sa_out(state, me, addr, lenp, fa, fp)
            if errno.is_error(fw) {
                return fw
            }
        }
        return got
    }
    let bounce: u64 = inet.bounce(state)
    var a: u64 = 0
    var port: u64 = 0
    var waited: u64 = 0
    let nb: bool = inet.sock_nonblock(state, si)
    var n: u64 = 0
    var going: bool = true
    while going {
        n = inet.sock_recvfrom(state, si, bounce, len, &a, &port)
        if !errno.is_error(n) {
            going = false
        } else if n != neg(errno.E_AGAIN) {
            return n
        } else if nb || waited >= NET_ROUNDS {
            return neg(errno.E_AGAIN)
        } else {
            waited = waited + 1
            sched.sleep_ticks(state, 1)
        }
    }
    if n > 0 {
        if !copy_out(state, me, buf, bounce, n) {
            return neg(errno.E_FAULT)
        }
    }
    if addr != 0 {
        let w: u64 = sa_out(state, me, addr, lenp, a, port)
        if errno.is_error(w) {
            return w
        }
    }
    return n
}

// The waiting half of `send`, shared with `write` on a socket. A socket
// whose send window is full is not an error; it is a reason to come back
// in a moment -- and a `write` that returns a SHORT count is what the
// interface has always allowed.
fn sock_io(state: u64, si: u64, bounce: u64, len: u64, a: u64, port: u64,
    to: bool) -> u64 {
    var waited: u64 = 0
    let nb: bool = inet.sock_nonblock(state, si)
    while waited <= NET_ROUNDS {
        var n: u64 = 0
        if to {
            n = inet.sock_sendto(state, si, bounce, len, a, port)
        } else {
            n = inet.sock_send(state, si, bounce, len)
        }
        if !errno.is_error(n) {
            return n
        }
        if n != neg(errno.E_AGAIN) {
            return n
        }
        if nb {
            return neg(errno.E_AGAIN)
        }
        waited = waited + 1
        sched.sleep_ticks(state, 1)
    }
    return neg(errno.E_AGAIN)
}

// `read` and `write` on a socket descriptor. The same two functions the
// calls above use, minus the address -- so a program can point `stdout`
// at a connection with `dup2` and never call a socket function again.
fn sock_read(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    return do_recvfrom(state, me, fd_back(state, me, of), buf, len, 0, 0)
}

fn sock_write(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    return do_sendto(state, me, fd_back(state, me, of), buf, len, 0, 0)
}

// `read_of`/`write_of` were split off a descriptor for the native ABI of
// the capability round, so they carry an OPEN FILE and not a number. The
// socket calls want the number back; the table is sixteen entries and
// the search is a loop over them.
fn fd_back(state: u64, me: u64, of: u64) -> u64 {
    var fd: u64 = 0
    while fd < file.MAX_FD {
        if of_of(state, me, fd) == of {
            return fd
        }
        fd = fd + 1
    }
    return file.MAX_FD
}

fn do_shutdown(state: u64, me: u64, fd: u64, how: u64) -> u64 {
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    // RUNDE NETVIEW: es gibt nichts abzuschalten, und das ist kein
    // Fehler. -ENOTCONN hier waere die eine Stelle, an der ein sonst
    // fehlerfreier Ablauf ploetzlich meldet, dass etwas nicht stimmt.
    if netview.is_fake(state, si) {
        return 0
    }
    return inet.sock_shutdown(state, si, how)
}

fn do_sockname(state: u64, me: u64, fd: u64, addr: u64, lenp: u64,
    peer: bool) -> u64 {
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    var a: u64 = 0
    var port: u64 = 0
    var r: u64 = 0
    // RUNDE NETVIEW: eine vorgetaeuschte Steckdose hat einen
    // vorgetaeuschten Gegenueber und eine vorgetaeuschte eigene Adresse.
    // Beide sind aus TEST-NET-2 und darum garantiert niemandes.
    if netview.is_fake(state, si) {
        if peer {
            netview.peer_of(state, si, &a, &port)
        } else {
            a = netview.FAKE_IP
            port = 0
        }
        return sa_out(state, me, addr, lenp, a, port)
    }
    if peer {
        r = inet.sock_peer(state, si, &a, &port)
    } else {
        r = inet.sock_local(state, si, &a, &port)
    }
    if errno.is_error(r) {
        return r
    }
    return sa_out(state, me, addr, lenp, a, port)
}

// There is exactly one option this kernel could act on and it is the
// default: a listening socket may be bound again after the connection
// before it went through TIME_WAIT, because the slot is held by
// `tcp.fi` and freed by it. So every option is taken and none is acted
// on -- and that is said here rather than answered with -ENOPROTOOPT,
// which would make `curl` and `nc` give up for no reason.
fn do_setsockopt(state: u64, me: u64, fd: u64, level: u64,
    name: u64) -> u64 {
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    return 0
}

// ====================================================== RUNDE DESKTOP
//
// DIE ADRESSE DES RECHNERS, LESBAR UND SETZBAR AUS RING 3.
//
// EHRLICHER AUSGANGSPUNKT, und er steht im Auftrag dieser Runde: der
// Kernel hat TCP/IP (`kernel/inet.fi`), aber die Adresse wurde in
// `inet.init` FESTGENAGELT. Es gab kein DHCP, und es gab auch keinen
// Weg, die Adresse ueberhaupt zu erfahren -- `ping` und `wget` bekamen
// sie nie zu sehen. Ein DHCP-Klient in Ring 3 braucht genau zwei
// Dinge: die Hardwareadresse der Karte (er muss sie in das Paket
// schreiben) und einen Weg, das Ergebnis dem Kernel zu sagen.
//
// SETZEN DARF NUR DIE WURZEL. Und `readdr` und nicht `configure`:
// letzteres holt sich jedes Mal neue Rahmen und verliert die alten --
// die Begruendung steht in `kernel/inet.fi`.
// ====================================================== RUNDE I18N
//
// Vier Zeilen, und sie stehen in einer eigenen Funktion aus demselben
// Grund wie `pwr_call` und `wig_call`: `dispatch` hat ueber hundert
// Zweige, und jeder Zwischenwert jedes Zweiges belegt einen Platz auf
// dem Kernstapel, ob der Zweig genommen wird oder nicht.
fn kbd_call(state: u64, was: u64, wert: u64) -> u64 {
    if was == KB_GET {
        return kbd.layout(state)
    }
    if was == KB_COUNT {
        return kbd.LAYOUTS
    }
    if was == KB_SWITCH {
        return kbd.switches(state)
    }
    if was == KB_SET {
        if kbd.set_layout(state, wert) {
            return 0
        }
        return errno.neg(errno.E_INVAL)
    }
    return errno.neg(errno.E_INVAL)
}

// ======================================================= RUNDE NETVIEW
//
// Die Aufgabe hinter einer pid, oder `me`, wenn die pid 0 ist. Es gibt
// dafuer `sched.find_pid`; die Null davor ist die Bequemlichkeit, die
// jedes dieser drei Tore braucht ("meine eigene Sicht").
fn task_of_pid(state: u64, me: u64, pid: u64) -> u64 {
    if pid == 0 {
        return me
    }
    return sched.find_pid(state, pid)
}

// LESEN DARF JEDER, UEBER JEDEN. Das ist eine Entscheidung und keine
// Vergesslichkeit: der Grundsatz der Runde steht in docs/NETVIEW.md und
// lautet, dass das PROGRAMM getaeuscht wird und nie der Mensch davor.
// Eine Netzsicht, die der Benutzer nicht auslesen kann, waere genau die
// Luege an den Benutzer, die dieses System nicht erzaehlen will -- und
// die Taskleiste, die das Merkmal ans Fenster malt, laeuft nicht als
// root.
fn do_netvget(state: u64, me: u64, pid: u64, what: u64) -> u64 {
    if what == NV_DROPPED {
        return netview.dropped(state)
    }
    if what == NV_OPENED {
        return netview.opened(state)
    }
    if what == NV_DENIED {
        return netview.denials(state)
    }
    if what == NV_REPLIES {
        return netview.replies(state)
    }
    // ZWEITER NACHTRAG. Drei Fragen ueber die MASCHINE, nicht ueber
    // einen Prozess -- darum vor dem Nachschlagen der pid und darum
    // ohne Maske je Sicht. Ein vorgetaeuschter Prozess erfaehrt hier,
    // dass vorgetaeuscht wird; das ist kein neues Leck, denn `netview
    // show` sagt ihm seine eigene Sicht seit dem Hauptauftrag. Getaeuscht
    // wird das Programm an der STECKDOSE, nicht an der Auskunft.
    if what == NV_FALLBACK {
        return netview.fallback(state)
    }
    if what == NV_FBVIEW {
        return netview.fallback_view(state)
    }
    if what == NV_LINK {
        return netview.link_state(state)
    }
    let t: u64 = task_of_pid(state, me, pid)
    if t == 0 || t >= kstate.MAX_TASKS {
        return neg(errno.E_SRCH)
    }
    if sched.tget(state, t, sched.T_STATE) == sched.S_FREE {
        return neg(errno.E_SRCH)
    }
    if what == NV_MODE {
        return netview.view_of(state, t)
    }
    if what == NV_ALLOWN {
        return netview.allow_count(state, t)
    }
    if what == NV_PID {
        return sched.tget(state, t, sched.T_PID)
    }
    if what >= NV_ALLOW && what < NV_ALLOW + sched.NETOK_MAX {
        return netview.allow_at(state, t, what - NV_ALLOW)
    }
    return neg(errno.E_INVAL)
}

// SCHREIBEN NICHT. `netview.may_set` traegt die ganze Regel, und sie
// steht dort und nicht hier, damit es sie einmal gibt: enger machen darf
// man sich selbst immer, alles andere braucht euid 0.
//
// `flags` Bit 0 leert dabei die Liste der erlaubten Ziele. Ohne das
// koennte man eine Sicht auf `filtered` stellen und die Liste eines
// frueheren Laufs erben.
fn do_netvset(state: u64, me: u64, pid: u64, want: u64) -> u64 {
    let t: u64 = task_of_pid(state, me, pid)
    if t == 0 || t >= kstate.MAX_TASKS {
        return neg(errno.E_SRCH)
    }
    if sched.tget(state, t, sched.T_STATE) == sched.S_FREE {
        return neg(errno.E_SRCH)
    }
    let v: u64 = want & 0xFF
    if !netview.may_set(state, me, t, v) {
        return neg(errno.E_PERM)
    }
    if (want & 0x100) != 0 {
        netview.allow_clear(state, t)
    }
    netview.set_view(state, t, v)
    return 0
}

// Ein erlaubtes Ziel: Adresse, dazu (port << 16) | praefix. Beides null
// leert die Liste. Dieselbe Rechtefrage wie oben, mit der Sicht, die
// gerade gilt -- eine Liste zu VERLAENGERN macht eine `filtered` Sicht
// weiter, und darum darf es nur, wer die Sicht auch setzen duerfte.
fn do_netvallow(state: u64, me: u64, pid: u64, addr: u64,
    pp: u64) -> u64 {
    let t: u64 = task_of_pid(state, me, pid)
    if t == 0 || t >= kstate.MAX_TASKS {
        return neg(errno.E_SRCH)
    }
    if sched.tget(state, t, sched.T_STATE) == sched.S_FREE {
        return neg(errno.E_SRCH)
    }
    if !netview.may_set(state, me, t, netview.view_of(state, t)) {
        return neg(errno.E_PERM)
    }
    if addr == 0 && pp == 0 {
        netview.allow_clear(state, t)
        return 0
    }
    if !netview.allow_add(state, t, addr, (pp >> 16) & 0xFFFF,
        pp & 0xFF) {
        return neg(errno.E_NOSPC)
    }
    return 0
}

// ZWEITER NACHTRAG: DIE SYSTEMWEITE VOREINSTELLUNG SETZEN.
//
// Sie aendert KEINEN LAUFENDEN PROZESS, und das ist die Entscheidung
// dieses Nachtrags: eine Sicht, die sich unter einem Programm wegdreht,
// tut es mitten in einer Verbindung. Diese Funktion schreibt eine Zahl,
// die erst der NAECHSTE Programmstart liest.
fn do_netvfb(state: u64, me: u64, want: u64) -> u64 {
    if sched.tget(state, me, sched.T_EUID) != 0 {
        return neg(errno.E_PERM)
    }
    if want > netview.FB_LAST {
        return neg(errno.E_INVAL)
    }
    netview.fallback_set(state, want)
    return 0
}

// RUNDE NETVIEW, DRITTER NACHTRAG: was die Tastatur aufgeschrieben hat.
// Vier Auskuenfte und kein Abholen: der Zaehler wird hier NICHT
// zurueckgesetzt. Ein Leser vergleicht ihn mit der Zahl, die er zuletzt
// gesehen hat -- damit kann kein zweiter Leser dem ersten den Druck
// wegnehmen, und ein Leser, der zweimal fragt, handelt trotzdem einmal.
fn do_hotkey(state: u64, what: u64) -> u64 {
    if what == HK_SEQ_Q {
        return kbd.hotkey_seq(state)
    }
    if what == HK_KEY_Q {
        return kbd.hotkey_key(state)
    }
    if what == HK_NS_Q {
        return kbd.hotkey_ns(state)
    }
    if what == HK_DOWN_Q {
        return kbd.super_down(state)
    }
    return neg(errno.E_INVAL)
}

// ======================================================= ROUND NETMON
//
// One number out of the accounting. Everything it can answer is a
// counter or a field of a record that already exists; this function
// invents nothing and rounds nothing.
fn do_netmon(state: u64, me: u64, kind: u64, index: u64,
    field: u64) -> u64 {
    if kind == 0 {
        if field == NM_ON {
            if netmon.on(state) {
                return 1
            }
            return 0
        }
        if field == NM_LOOKUPS {
            return netmon.lookups(state)
        }
        if field == NM_HITS {
            return netmon.hits(state)
        }
        if field == NM_MISSES {
            return netmon.misses(state)
        }
        if field == NM_SYSTX {
            return netmon.sys_octets(state, 0)
        }
        if field == NM_SYSRX {
            return netmon.sys_octets(state, 1)
        }
        if field == NM_TICKS {
            return kstate.get(state, kstate.TICKS)
        }
        if field == NM_HZ {
            return 100
        }
        if field == NM_CARDTX {
            return inet.card_octets(state, 0)
        }
        if field == NM_CARDRX {
            return inet.card_octets(state, 1)
        }
        if field == NM_NTASK {
            return kstate.MAX_TASKS
        }
        if field == NM_NSOCK {
            return netmon.NSOCK
        }
        if field == NM_NPROG {
            return netmon.NPROG
        }
        return neg(errno.E_INVAL)
    }
    if kind == 1 {
        if index >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
        if field < netmon.T_FIELDS {
            return netmon.tget(state, index, field)
        }
        if field == NT_PID {
            return sched.tget(state, index, sched.T_PID)
        }
        if field == NT_ALIVE {
            let st: u64 = sched.tget(state, index, sched.T_STATE)
            if st == sched.S_FREE || st == sched.S_ZOMBIE {
                return 0
            }
            return 1
        }
        if field == NT_VIEW {
            return netview.view_of(state, index)
        }
        if field == NT_STATE {
            return sched.tget(state, index, sched.T_STATE)
        }
        return neg(errno.E_INVAL)
    }
    if kind == 2 {
        if index >= netmon.NSOCK {
            return neg(errno.E_INVAL)
        }
        if field < netmon.S_FIELDS {
            return netmon.sget(state, index, field)
        }
        if field == NS_TCPSTATE {
            if netmon.sget(state, index, netmon.S_USE) == 0 {
                return 0
            }
            return inet.sock_state(state, index)
        }
        if field == NS_AGE {
            if netmon.sget(state, index, netmon.S_USE) == 0 {
                return 0
            }
            return kstate.get(state, kstate.TICKS)
                - netmon.sget(state, index, netmon.S_T0)
        }
        return neg(errno.E_INVAL)
    }
    if kind == 3 {
        if index >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
        return netmon.name_at(state, index, field)
    }
    if kind == 4 {
        if index >= netmon.NPROG {
            return neg(errno.E_INVAL)
        }
        if field < netmon.T_FIELDS {
            return netmon.pget(state, index, field)
        }
        if field == NP_USED {
            return netmon.prog_used(state, index)
        }
        return neg(errno.E_INVAL)
    }
    if kind == 5 {
        if index >= netmon.NPROG {
            return neg(errno.E_INVAL)
        }
        return netmon.prog_name_at(state, index, field)
    }
    return neg(errno.E_INVAL)
}

// ROUND NETMON PART TWO: one number about the sharing.
fn do_share(state: u64, me: u64, what: u64, index: u64) -> u64 {
    if what == SH_SET {
        if sched.tget(state, me, sched.T_EUID) != 0 {
            return neg(errno.E_PERM)
        }
        // SWITCHED ON MEANS SWITCHED ON, not brought up: the card is
        // claimed once at boot (`netsvc.stage`) because claiming a PCI
        // device out of a system call would mean a driver coming up
        // while the network task is already turning the crank on it.
        // What this does is open and close the gate.
        if index != 0 && !share.on(state) {
            if share.uplink(state) == share.shared(state) {
                return neg(errno.E_NODEV)
            }
        }
        var v: u64 = 0
        if index != 0 {
            v = 1
        }
        share.set_on(state, v)
        return 0
    }
    if what == SH_ON {
        if share.on(state) {
            return 1
        }
        return 0
    }
    if what == SH_IP {
        return share.my_ip(state)
    }
    if what == SH_MASK {
        return share.mask(state)
    }
    if what == SH_P0 {
        return share.pool_first(state)
    }
    if what == SH_P1 {
        return share.pool_last(state)
    }
    if what == SH_NCLIENT {
        return share.CLIENT_MAX
    }
    if what == SH_UPLINK {
        return share.uplink(state)
    }
    if what == SH_SHARED {
        return share.shared(state)
    }
    if what == SH_NAT {
        return share.nat_live(state)
    }
    if what == SH_STAT {
        return share.stat(state, index)
    }
    if index >= share.CLIENT_MAX {
        return neg(errno.E_INVAL)
    }
    if what == SH_CLIENT {
        if share.client_at(state, index, share.C_USE) != 0 {
            return 1
        }
        return 0
    }
    if what == SH_CMAC {
        return share.client_at(state, index, share.C_MAC)
    }
    if what == SH_CIP {
        return share.client_at(state, index, share.C_IP)
    }
    if what == SH_CIN {
        return share.client_at(state, index, share.C_IN)
    }
    if what == SH_COUT {
        return share.client_at(state, index, share.C_OUT)
    }
    return neg(errno.E_INVAL)
}

fn net_call(state: u64, me: u64, number: u64, a0: u64, a1: u64,
    a2: u64) -> u64 {
    // ======================================================= ROUND NETMON
    if number == SYS_OSUM_NETMON {
        return do_netmon(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_SHARE {
        return do_share(state, me, a0, a1)
    }
    if number == SYS_OSUM_NETMONROLL {
        if sched.tget(state, me, sched.T_EUID) != 0 {
            return neg(errno.E_PERM)
        }
        if a0 >= netmon.NPROG || a1 >= netmon.T_FIELDS {
            return neg(errno.E_INVAL)
        }
        return netmon.roll(state, a0, a1)
    }
    // ====================================================== RUNDE NETVIEW
    if number == SYS_OSUM_NETVFB {
        return do_netvfb(state, me, a0)
    }
    if number == SYS_OSUM_NETVGET {
        return do_netvget(state, me, a0, a1)
    }
    if number == SYS_OSUM_NETVSET {
        return do_netvset(state, me, a0, a1)
    }
    if number == SYS_OSUM_NETVALLOW {
        return do_netvallow(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_NETGET {
        // RUNDE NETVIEW: WAS EIN PROZESS UEBER SEIN NETZ ERFAEHRT,
        // HAENGT AN SEINER SICHT. Ein `faked` Prozess bekommt hier die
        // erfundene Anschrift aus TEST-NET-2 -- sonst faende er ueber
        // diesen Aufruf heraus, dass er getaeuscht wird, und die
        // Vortaeuschung waere an ihrer eigenen Auskunftsstelle
        // durchschaubar. Ein `none` Prozess bekommt, was eine Maschine
        // mit gezogenem Kabel meldet: nichts.
        let v: u64 = netview.view_of(state, me)
        if v == netview.V_NONE {
            if a0 == NG_READY {
                return 0
            }
            // Gezogenes Kabel, und zwar auch fuer den, der nach dem
            // Zustand fragt.
            if a0 == NG_STATE {
                return netview.NS_NOCARRIER
            }
            return errno.neg(errno.E_NODEV)
        }
        if v == netview.V_FAKED {
            if a0 == NG_READY {
                return 1
            }
            if a0 == NG_IP {
                return netview.FAKE_IP
            }
            if a0 == NG_MASK {
                return netview.FAKE_MASK
            }
            if a0 == NG_GW {
                return netview.FAKE_GW
            }
            if a0 == NG_MAC0 {
                return netview.FAKE_MAC0
            }
            if a0 == NG_MAC1 {
                return netview.FAKE_MAC1
            }
            // Rahmenzaehler eines Netzes, ueber das nie ein Rahmen ging.
            if a0 == NG_IN || a0 == NG_OUT {
                return 0
            }
            // Und der Zustand: vollstaendig verbunden. Ein Programm, das
            // hier die Wahrheit erfuehre, waere nicht getaeuscht.
            if a0 == NG_STATE {
                return netview.NS_ONLINE
            }
            return errno.neg(errno.E_INVAL)
        }
        if a0 == NG_READY {
            if inet.ready(state) {
                return 1
            }
            return 0
        }
        // Der Zustand wird AM DRAHT gemessen und nicht am Stapel. Die
        // Rechnung steht seit dem zweiten Nachtrag in
        // `netview.link_state`, weil sie inzwischen zwei Frager hat --
        // diesen hier und `netview.fallback_view`.
        if a0 == NG_STATE {
            return netview.link_state(state)
        }
        if !inet.ready(state) {
            return errno.neg(errno.E_NODEV)
        }
        if a0 == NG_IP {
            return inet.ip(state)
        }
        if a0 == NG_MASK {
            return inet.mask(state)
        }
        if a0 == NG_GW {
            return inet.gw(state)
        }
        if a0 == NG_MAC0 {
            return (inet.mac_at(state, 0) << 24) | (inet.mac_at(state, 1) << 16)
                | (inet.mac_at(state, 2) << 8) | inet.mac_at(state, 3)
        }
        if a0 == NG_MAC1 {
            return (inet.mac_at(state, 4) << 8) | inet.mac_at(state, 5)
        }
        if a0 == NG_IN {
            return inet.frames_in(state)
        }
        if a0 == NG_OUT {
            return inet.frames_out(state)
        }
        // RUNDE ECHTHARDWARE-1: der Fortschritt des DHCP-Klienten.
        if a0 >= NG_DHCPST && a0 <= NG_DHCPTRY {
            return inet.dhcp_get(a0 - NG_DHCPST)
        }
        return errno.neg(errno.E_INVAL)
    }
    // RUNDE ECHTHARDWARE-1: DER KLIENT MELDET, WIE WEIT ER IST.
    // (was, wert) -- `was` 0..3 wie NG_DHCPST..NG_DHCPTRY.
    if number == SYS_OSUM_DHCPST {
        if !perm.is_root(state, me) {
            return errno.neg(errno.E_PERM)
        }
        if a0 > 3 {
            return errno.neg(errno.E_INVAL)
        }
        inet.dhcp_set(a0, a1)
        return 0
    }
    // NETSET: (ip, maske, gateway), alle drei als eine Zahl in
    // Netzreihenfolge -- 0x0A00020F ist 10.0.2.15.
    //
    // MERGE FIX: AUSDRUECKLICH DIESE NUMMER UND KEINE ANDERE. Bis
    // hierher war der Rest dieser Funktion der NETSET-Pfad, und jede
    // Nummer aus dem Bereich NETGET..SHARE, die oben niemand erkannte,
    // fiel hinein -- eine Auskunftsfrage wurde so zu "Netz aus". Eine
    // unbekannte Nummer ist -ENOSYS und nichts anderes.
    if number != SYS_OSUM_NETSET {
        return neg(errno.E_NOSYS)
    }
    if !perm.is_root(state, me) {
        return errno.neg(errno.E_PERM)
    }
    if !inet.ready(state) {
        return errno.neg(errno.E_NODEV)
    }
    // RUNDE NETVIEW, DRITTER NACHTRAG: DIE ADRESSE WIEDER HERGEBEN.
    //
    // Bis hierher war die Null verboten, und das war richtig, solange
    // es nur "setz die Adresse" gab: 0.0.0.0 ist keine Adresse. Die
    // Schnelleinstellungen brauchen aber die Gegenrichtung -- ein
    // "Netz aus", das die Maschine wirklich adresslos macht, statt nur
    // so zu tun. Genau EINE Kombination heisst das, und sie muss
    // vollstaendig sein: Adresse, Maske und Gateway alle drei null.
    // Eine Adresse ohne Maske bleibt ein Fehler, so wie vorher.
    //
    // WAS DANACH GILT, und es ist nicht behauptet, sondern faellt aus
    // `netview.link_state` heraus: die Karte ist weiter da, der Traeger
    // ist weiter da, `inet.ip` ist 0 -- also meldet die Maschine
    // "Traeger da, keine Adresse", genau die zweite der vier Stufen,
    // und die Ecke der Taskleiste malt das Zeichen dafuer. Es gibt
    // keinen fuenften Zustand "abgeschaltet", weil es fuer den Benutzer
    // keinen Unterschied macht, ob die Adresse nie da war oder gerade
    // weggenommen wurde.
    if a0 == 0 {
        if a1 != 0 || (a2 & 0xFFFFFFFF) != 0 {
            return errno.neg(errno.E_INVAL)
        }
        if !inet.readdr(state, 0, 0, 0, 0, 0, 0) {
            return errno.neg(errno.E_IO)
        }
        return 0
    }
    // Die Praefixlaenge aus der Maske. Eine Maske mit Loechern
    // (0xFF00FF00) ist keine Maske; sie wird hier NICHT stillschweigend
    // geglaettet, sondern abgelehnt.
    var praefix: u64 = 0
    var bit: u64 = 32
    var gesehen_null: bool = false
    while bit > 0 {
        bit = bit - 1
        if ((a1 >> bit) & 1) != 0 {
            if gesehen_null {
                return errno.neg(errno.E_INVAL)
            }
            praefix = praefix + 1
        } else {
            gesehen_null = true
        }
    }
    if !inet.readdr(state, (a0 >> 24) & 255, (a0 >> 16) & 255,
        (a0 >> 8) & 255, a0 & 255, praefix, a2 & 0xFFFFFFFF) {
        return errno.neg(errno.E_IO)
    }
    return 0
}




// ==================================================================
//        RUNDE K12: GASTMASCHINEN AUS RING 3, UEBER HANDLES
// ==================================================================
//
// Ein Programm in Ring 3 legt eine Gastmaschine an, laesst sie laufen,
// fragt nach ihrem Zustand und raeumt sie ab. Es hat dafuer KEINE
// Sonderrechte und keinen zweiten Weg: es hat ein HANDLE, und was es
// damit darf, steht in den Rechtebits dieses Handles.
//
// DAS IST DER GANZE PUNKT. Eine Gastmaschine ist ein maechtiges Ding --
// sie hat eigenen physischen Speicher und einen eigenen Prozessor. Waere
// sie ueber eine kleine Zahl erreichbar, koennte jeder Prozess durch
// Raten an eine fremde geraten. Ueber ein Handle kann er es nicht: der
// Wuerfelwert der Tabelle geht in die Generation ein (`cap.fi`), und ein
// Handle aus einem anderen Prozess trifft hier nichts.
//
// UND DIE RECHTE SIND ECHT GETRENNT:
//   R_WRITE    darf sie LAUFEN LASSEN
//   R_INSPECT  darf ihren Zustand ERFRAGEN
//   R_READ     darf lesen, was der Gast gemeldet hat
//   R_MANAGE   darf sie ABRAEUMEN
// Wer eine Kopie ohne R_MANAGE weitergibt, gibt das Recht zu laufen
// weiter und das Recht zu toeten nicht. Genau das misst `u_hv` in
// `uprog.fi`.

const VM_E_BAD: u64 = 100 // Handle gibt es nicht
const VM_E_TYPE: u64 = 101 // Handle ja, aber keine Gastmaschine
const VM_E_RIGHTS: u64 = 102 // Handle ja, Art ja, Recht nein

// Loest ein Handle in einen Platz in `hv.fi` auf und prueft das
// verlangte Recht. Die drei Fehler bleiben UNTERSCHEIDBAR -- POSIX hat
// fuer alle drei nur -EBADF, und dass das zu wenig ist, ist die These
// der Runde mit den Handles.
fn vm_of(state: u64, me: u64, h: u64, need: u64) -> u64 {
    let i: u64 = cap.find(state, me, h)
    if i >= cap.MAX_CAPS {
        return VM_E_BAD
    }
    if cap.kind_at(state, me, i) != cap.K_VM {
        return VM_E_TYPE
    }
    if !cap.rights_contains(cap.rights_at(state, me, i), need) {
        return VM_E_RIGHTS
    }
    let slot: u64 = cap.object_at(state, me, i)
    if !hv.vm_valid(state, slot) {
        return VM_E_BAD
    }
    return slot
}

fn vm_fehler(r: u64) -> u64 {
    if r == VM_E_TYPE {
        return cap.err(cap.E_WRONGTYPE)
    }
    if r == VM_E_RIGHTS {
        return cap.err(cap.E_RIGHTS)
    }
    return cap.err(cap.E_BADHANDLE)
}

fn vm_call(state: u64, me: u64, number: u64, a0: u64, a1: u64) -> u64 {
    if number == SYS_VM_CREATE {
        return do_vm_create(state, me, a0, a1)
    }
    if number == SYS_VM_RUN {
        let s: u64 = vm_of(state, me, a0, cap.R_WRITE)
        if s >= hv.MAX_VMS {
            return vm_fehler(s)
        }
        return hv.vm_run(state, s)
    }
    if number == SYS_VM_STAT {
        return do_vm_stat(state, me, a0, a1)
    }
    if number == SYS_VM_KILL {
        let s: u64 = vm_of(state, me, a0, cap.R_MANAGE)
        if s >= hv.MAX_VMS {
            return vm_fehler(s)
        }
        hv.vm_destroy(state, s)
        cap.close(state, me, a0)
        return 0
    }
    if number == SYS_VM_VALUE {
        let s: u64 = vm_of(state, me, a0, cap.R_READ)
        if s >= hv.MAX_VMS {
            return vm_fehler(s)
        }
        return hv.value_of(state, a1)
    }
    return cap.err(cap.E_INVALID)
}

// Eine Gastmaschine anlegen. Die Rechte, die der Aufrufer verlangt,
// werden auf das eingeschraenkt, was es fuer diese Art ueberhaupt gibt
// -- ein Bit, das keine Bedeutung hat, ist kein Recht, sondern Muell,
// und wird beim Anlegen weggefiltert (`cap.rights_restrict`).
fn do_vm_create(state: u64, me: u64, guest: u64, want: u64) -> u64 {
    if !hv.ready(state) {
        return cap.err(cap.E_UNSUPPORTED)
    }
    if guest >= hv.G_MAX {
        return cap.err(cap.E_INVALID)
    }
    let moeglich: u64 = cap.R_READ | cap.R_WRITE | cap.R_INSPECT
        | cap.R_MANAGE | cap.R_DUPLICATE | cap.R_TRANSFER
    let slot: u64 = hv.vm_create(state, guest, me)
    if slot >= hv.MAX_VMS {
        return cap.err(cap.E_EXHAUSTED)
    }
    let h: u64 = cap.insert(state, me, cap.K_VM,
        cap.rights_restrict(moeglich, want), slot)
    if h == cap.HANDLE_NONE {
        // Kein Platz in der Handle-Tabelle: die Maschine darf dann auch
        // nicht stehenbleiben, sonst waere sie ein Rahmenleck, das
        // niemand mehr erreichen kann.
        hv.vm_destroy(state, slot)
        return cap.err(cap.E_EXHAUSTED)
    }
    return h
}

// Der Zustand einer Gastmaschine, in fuenf Woertern nach Ring 3. Wie bei
// `CAP_INSPECT`: Zahlen, und keine einzige Adresse des Kernels.
const VMSTAT_WORDS: u64 = 5

fn do_vm_stat(state: u64, me: u64, h: u64, aus: u64) -> u64 {
    let s: u64 = vm_of(state, me, h, cap.R_INSPECT)
    if s >= hv.MAX_VMS {
        return vm_fehler(s)
    }
    if aus == 0 {
        return 0
    }
    if !proc.user_ok(state, me, aus, VMSTAT_WORDS * 8) {
        return cap.err(cap.E_INVALID)
    }
    var w: [u64; 5] = [0 as u64; 5]
    w[0] = hv.vm_state(state, s)
    w[1] = hv.vm_exits(state, s)
    w[2] = hv.vm_result(state, s)
    w[3] = hv.vm_guest(state, s)
    w[4] = hv.exits_total(state)
    if !copy_out(state, me, aus, (&w[0]) as u64, VMSTAT_WORDS * 8) {
        return cap.err(cap.E_INVALID)
    }
    return 0
}

// ============================================================ RUNDE K13
//
// BENUTZER UND RECHTE, VON RING 3 AUS GESEHEN.
//
// Alles, was hier steht, faellt in eine von drei Gruppen:
//
//   1. AUSKUNFT   -- getuid, geteuid, getgid, getegid, getresuid,
//                    getresgid, umask, access. Sie koennen nicht
//                    fehlschlagen (ausser an einem falschen Zeiger).
//   2. WECHSEL    -- setuid, setgid, setreuid, setregid, setresuid,
//                    setresgid. Sie duerfen NUR das, was POSIX erlaubt,
//                    und die Regel steht in `ids_ok` an genau einer
//                    Stelle.
//   3. RECHTE     -- chmod, chown und ihre Verwandten. Sie aendern den
//                    Inode auf der Platte, und sie duerfen es nur, wenn
//                    die Datei dem Aufrufer gehoert oder er root ist.
//
// Die PRUEFUNG, ob jemand eine Datei oeffnen darf, steht NICHT hier,
// sondern in `kernel/perm.fi`. Diese Datei ruft sie auf -- fuenfmal, an
// den fuenf Toren, durch die man an eine Datei kommt (`open`, `mkdir`,
// `unlink`, `chdir`, und `execve` ueber `elf.build`). Fuenf Aufrufe EINER
// Funktion sind etwas anderes als fuenf Pruefungen.

// -------------------------------------------------------- die Auskunft

// Darf `me` dem Prozess mit dieser pid ein Signal schicken? Eine
// negative Zahl oder 0 heisst "eine ganze Gruppe" -- dann wird gegen
// JEDES Mitglied gefragt und ein einziges Nein reicht nicht aus, um den
// ganzen Aufruf abzulehnen; POSIX verlangt nur, dass mindestens einer
// getroffen werden durfte. Hier ist es einfacher und strenger: bei einer
// Gruppe entscheidet die Kennung des Aufrufers gegen die des ersten
// Treffers, und root darf immer.
fn kill_allowed(state: u64, me: u64, pid: u64) -> bool {
    if perm.is_root(state, me) {
        return true
    }
    if pid == 0 || (pid >> 63) != 0 {
        return true // Gruppen: `signal.do_kill` filtert selbst
    }
    let t: u64 = sched.find_pid(state, pid)
    if t >= kstate.MAX_TASKS {
        return true // gibt es nicht -- die Fehlernummer kommt von dort
    }
    return perm.may_signal(state, me, t)
}

fn do_getid(state: u64, me: u64, which: u64) -> u64 {
    return sched.tget(state, me, which)
}

// `getresuid(r, e, s)` -- alle drei auf einmal. Drei 32-Bit-Worte, wie
// bei Linux.
fn do_getres(state: u64, me: u64, a: u64, b: u64, c: u64,
    fr: u64, fe: u64, fs_: u64) -> u64 {
    if a != 0 {
        if !put32(state, me, a, sched.tget(state, me, fr)) {
            return neg(errno.E_FAULT)
        }
    }
    if b != 0 {
        if !put32(state, me, b, sched.tget(state, me, fe)) {
            return neg(errno.E_FAULT)
        }
    }
    if c != 0 {
        if !put32(state, me, c, sched.tget(state, me, fs_)) {
            return neg(errno.E_FAULT)
        }
    }
    return 0
}

// `umask(m)` gibt die ALTE Maske zurueck und setzt die neue -- so wie
// ueberall, und das ist der Grund, warum ein Programm sie erfragen kann,
// ohne dass es einen `getumask` gibt.
fn do_umask(state: u64, me: u64, m: u64) -> u64 {
    let old: u64 = sched.tget(state, me, sched.T_UMASK) & 4095
    sched.tset(state, me, sched.T_UMASK, m & 4095)
    return old
}

// --------------------------------------------------------- der Wechsel

// DIE EINE REGEL FUER JEDEN KENNUNGSWECHSEL. Sie steht hier einmal, und
// `setuid`, `setreuid` und `setresuid` sind drei Aufrufe darauf --
// dieselbe Ueberlegung wie bei `perm.may`.
//
// root darf jeden Wert setzen. Wer nicht root ist, darf nur zwischen
// seinen DREI EIGENEN Werten wechseln (echt, wirksam, gesichert). Das ist
// genau das, was ein setuid-Programm braucht, um seine Rechte abzulegen
// und wiederzuholen -- und genau das, was verhindert, dass es sich
// fremde nimmt.
fn ids_ok(state: u64, me: u64, want: u64, real_f: u64, eff_f: u64,
    sav_f: u64) -> bool {
    if want == (0 -% 1) {
        return true // -1: unveraendert
    }
    if perm.is_root(state, me) {
        return true
    }
    if want == sched.tget(state, me, real_f) {
        return true
    }
    if want == sched.tget(state, me, eff_f) {
        return true
    }
    return want == sched.tget(state, me, sav_f)
}

fn ids_set(state: u64, me: u64, f: u64, v: u64) {
    if v != (0 -% 1) {
        sched.tset(state, me, f, v)
    }
}

// `setresuid(r, e, s)` -- der allgemeine Fall; die drei anderen sind
// Sonderfaelle davon. ALLE DREI WERTE WERDEN GEPRUEFT, BEVOR EINER
// GESETZT WIRD: ein Aufruf, der zur Haelfte gelingt, waere ein Prozess
// mit halben Rechten, und dafuer gibt es keine Fehlernummer.
fn do_setres(state: u64, me: u64, r: u64, e: u64, sv: u64,
    real_f: u64, eff_f: u64, sav_f: u64) -> u64 {
    if !ids_ok(state, me, r, real_f, eff_f, sav_f) {
        return neg(errno.E_PERM)
    }
    if !ids_ok(state, me, e, real_f, eff_f, sav_f) {
        return neg(errno.E_PERM)
    }
    if !ids_ok(state, me, sv, real_f, eff_f, sav_f) {
        return neg(errno.E_PERM)
    }
    ids_set(state, me, real_f, r)
    ids_set(state, me, eff_f, e)
    ids_set(state, me, sav_f, sv)
    kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
    return 0
}

// `setuid(u)`. Als root setzt es ALLE DREI -- danach gibt es keinen Weg
// zurueck, und genau das ist der Sinn: `login` legt die Rechte des
// Systems endgueltig ab, bevor es die Shell des Menschen startet. Wer
// nicht root ist, setzt nur die wirksame Kennung und kann zurueck.
fn do_setuid(state: u64, me: u64, u: u64) -> u64 {
    if perm.is_root(state, me) {
        sched.tset(state, me, sched.T_UID, u)
        sched.tset(state, me, sched.T_EUID, u)
        sched.tset(state, me, sched.T_SUID, u)
        kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
        return 0
    }
    if !ids_ok(state, me, u, sched.T_UID, sched.T_EUID, sched.T_SUID) {
        return neg(errno.E_PERM)
    }
    sched.tset(state, me, sched.T_EUID, u)
    kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
    return 0
}

fn do_setgid(state: u64, me: u64, g: u64) -> u64 {
    if perm.is_root(state, me) {
        sched.tset(state, me, sched.T_GID, g)
        sched.tset(state, me, sched.T_EGID, g)
        sched.tset(state, me, sched.T_SGID, g)
        kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
        return 0
    }
    if !ids_ok(state, me, g, sched.T_GID, sched.T_EGID, sched.T_SGID) {
        return neg(errno.E_PERM)
    }
    sched.tset(state, me, sched.T_EGID, g)
    kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
    return 0
}

// `setreuid(r, e)`. Wird die echte Kennung gesetzt oder die wirksame auf
// etwas anderes als die echte, so wird die GESICHERTE nachgezogen -- das
// steht so in POSIX, und ohne diese Zeile koennte ein Prozess ueber
// mehrere Aufrufe eine Kennung behalten, die er einmal hatte.
fn do_setre(state: u64, me: u64, r: u64, e: u64,
    real_f: u64, eff_f: u64, sav_f: u64) -> u64 {
    if !ids_ok(state, me, r, real_f, eff_f, sav_f) {
        return neg(errno.E_PERM)
    }
    if !ids_ok(state, me, e, real_f, eff_f, sav_f) {
        return neg(errno.E_PERM)
    }
    let old_real: u64 = sched.tget(state, me, real_f)
    ids_set(state, me, real_f, r)
    ids_set(state, me, eff_f, e)
    if r != (0 -% 1) || (e != (0 -% 1) && e != old_real) {
        sched.tset(state, me, sav_f, sched.tget(state, me, eff_f))
    }
    kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
    return 0
}

// ------------------------------------------------------- die Rechte

// Wer darf die Rechte einer Datei aendern? Ihr Besitzer und root, und
// sonst niemand -- auch nicht, wer Schreibrecht an ihr hat. (Sonst
// koennte jeder, der eine Datei aendern darf, sie sich aneignen.)
fn owns(state: u64, me: u64, ino: u64) -> bool {
    if perm.is_root(state, me) {
        return true
    }
    return perm.euid(state, me) == fs.inode_uid(state, ino)
}

fn chmod_ino(state: u64, me: u64, ino: u64, mode: u64) -> u64 {
    if !owns(state, me, ino) {
        kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
        if !kstate.mode_on(state, kstate.M_NOPERM) {
            return neg(errno.E_PERM)
        }
    }
    if !fs.set_mode(state, ino, mode) {
        return neg(errno.E_ROFS) // ein Abbild der Fassung 1
    }
    kstate.add(state, kstate.K13_OFF + kstate.U_CHMODS, 1)
    return 0
}

// `chown`. Den BESITZER darf nur root wechseln -- ein Benutzer, der eine
// Datei verschenken kann, kann Plattenkontingente umgehen und fremde
// Programme mit seinem Namen versehen. Die GRUPPE darf auch der Besitzer
// wechseln, aber nur auf seine eigene.
//
// UND ES NIMMT DIE BEIDEN OBEREN BITS WEG. Eine Datei mit setuid-Bit, die
// den Besitzer wechselt, waere sonst ein Programm, das mit der Kennung
// des NEUEN Besitzers laeuft, ohne dass der etwas davon weiss. Das ist
// die aelteste Falle in diesem Bereich, und POSIX schreibt genau deshalb
// vor, dass sie fallen.
fn chown_ino(state: u64, me: u64, ino: u64, uid: u64, gid: u64) -> u64 {
    let root: bool = perm.is_root(state, me)
    if uid != (0 -% 1) && !root {
        kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
        if !kstate.mode_on(state, kstate.M_NOPERM) {
            return neg(errno.E_PERM)
        }
    }
    if gid != (0 -% 1) && !root {
        if !owns(state, me, ino) || gid != perm.egid(state, me) {
            kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
            if !kstate.mode_on(state, kstate.M_NOPERM) {
                return neg(errno.E_PERM)
            }
        }
    }
    if !fs.set_owner(state, ino, uid, gid) {
        return neg(errno.E_ROFS)
    }
    if !root {
        let m: u64 = fs.inode_mode(state, ino)
        if (m & (fs.S_ISUID | fs.S_ISGID)) != 0 {
            fs.set_mode(state, ino, m & (~(fs.S_ISUID | fs.S_ISGID)))
        }
    }
    kstate.add(state, kstate.K13_OFF + kstate.U_CHOWNS, 1)
    return 0
}

// Ein Pfad aus Ring 3 zu einem Inode, mit allen Pruefungen davor. Die
// vier Aufrufe darunter unterscheiden sich nur darin, was sie damit tun.
fn ino_of_path(state: u64, me: u64, name: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    // RUNDE MULTIUSER: DAS BETRETUNGSRECHT AUF JEDEM GLIED DES PFADES.
    // Vor `fs.path` und nicht danach: wer ein Verzeichnis auf dem Weg
    // nicht betreten darf, soll nicht einmal erfahren, ob der Name
    // dahinter existiert. Die Begruendung und die Gegenprobe `nowalk`
    // stehen in `kernel/perm.fi`.
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    let ino: u64 = fs.path(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    return ino
}

fn do_chmod(state: u64, me: u64, name: u64, mode: u64) -> u64 {
    let ino: u64 = ino_of_path(state, me, name)
    if errno.is_error(ino) {
        return ino
    }
    return chmod_ino(state, me, ino, mode)
}

fn do_chown(state: u64, me: u64, name: u64, uid: u64, gid: u64) -> u64 {
    let ino: u64 = ino_of_path(state, me, name)
    if errno.is_error(ino) {
        return ino
    }
    return chown_ino(state, me, ino, uid, gid)
}

fn ino_of_fd(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    let kind: u64 = file.open_kind(state, of)
    if kind != file.K_FILE && kind != file.K_DIR {
        return neg(errno.E_INVAL)
    }
    return file.open_ino(state, of)
}

fn do_fchmod(state: u64, me: u64, fd: u64, mode: u64) -> u64 {
    let ino: u64 = ino_of_fd(state, me, fd)
    if errno.is_error(ino) {
        return ino
    }
    return chmod_ino(state, me, ino, mode)
}

fn do_fchown(state: u64, me: u64, fd: u64, uid: u64, gid: u64) -> u64 {
    let ino: u64 = ino_of_fd(state, me, fd)
    if errno.is_error(ino) {
        return ino
    }
    return chown_ino(state, me, ino, uid, gid)
}

// `access(pfad, art)` -- mit der ECHTEN Kennung, so wie POSIX es sagt.
// F_OK ist 0 und fragt nur, ob es die Datei gibt.
fn do_access(state: u64, me: u64, name: u64, want: u64) -> u64 {
    let ino: u64 = ino_of_path(state, me, name)
    if errno.is_error(ino) {
        return ino
    }
    if want == 0 {
        return 0
    }
    if perm.may_real(state, me, ino, want & 7) {
        return 0
    }
    return neg(errno.E_ACCES)
}

// -------------------------------------------------- das Herunterfahren

// `reboot(befehl)`. Es ist der Aufruf, mit dem der Prozess 1 die Maschine
// beendet -- und nur er kann es, weil nur er mit der wirksamen Kennung 0
// laeuft, wenn das System richtig aufgesetzt ist.
//
// Der Weg ist ECHTES ACPI (`power.acpi_off`): FADT lesen, \_S5_ in der
// DSDT suchen, in das Steuerregister schreiben. Kommt der Aufruf zurueck,
// hat es nicht gegriffen -- dann bleibt der Ausgang des Pruefstands, und
// der Unterschied ist am Beendigungscode von QEMU zu sehen (0 gegen 21).
// `noacpi` nimmt den ersten Weg weg; das ist die Gegenprobe.
fn do_reboot(state: u64, me: u64, cmd: u64) -> u64 {
    if !perm.is_root(state, me) {
        kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
        return neg(errno.E_PERM)
    }
    var s_off: [u8; 20] = "power: init sagt ab\0"
    // DER BERICHT ZUERST. Nach der naechsten Zeile gibt es die Maschine
    // nicht mehr; was hier nicht steht, steht nirgends.
    perm.report(state)
    netview.report(state)
    serial.puts((&s_off[0]) as u64)
    serial.nl()
    if cmd == RB_POWEROFF {
        if !kstate.mode_on(state, kstate.M_NOACPI) {
            power.acpi_off(state)
        }
        power.shutdown(power.EXIT_OK)
        return 0
    }
    if cmd == RB_HALT {
        power.halt_forever()
        return 0
    }
    if cmd == RB_RESTART {
        // RUNDE INIT: EIN ECHTER NEUSTART, kein Anhalten. Bis hierher
        // fiel `RB_RESTART` in denselben Ausgang wie `RB_POWEROFF` --
        // die Maschine blieb stehen und kam nicht wieder. `acpi_reset`
        // nimmt das RESET-Register der Firmware, den Anschluss 0xCF9
        // und zuletzt den 8042; kehrt es zurueck, hat keiner davon
        // gegriffen, und dann bleibt nur der Ausgang des Pruefstands.
        if !kstate.mode_on(state, kstate.M_NOACPI) {
            power.acpi_reset(state)
        }
        power.shutdown(power.EXIT_OK)
        return 0
    }
    return neg(errno.E_INVAL)
}

// ------------------------------------------------------- die Auskunft

// ================================== RUNDE MULTIUSER: DIE ZUSATZGRUPPEN
//
// `getgroups(n, liste)` nach POSIX: mit n == 0 gibt es nur die ANZAHL
// zurueck und schreibt nichts -- so fragt ein Programm, wie gross der
// Puffer sein muss, den es gleich anlegt. Mit n > 0 und n kleiner als
// die Anzahl ist die Antwort -EINVAL und nicht eine abgeschnittene
// Liste; eine halbe Gruppenliste ist schlimmer als keine.
fn do_getgroups(state: u64, me: u64, n: u64, out: u64) -> u64 {
    let have: u64 = sched.groups_count(state, me)
    if n == 0 {
        return have
    }
    if n < have {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, out, have * 8) {
        return neg(errno.E_FAULT)
    }
    // Ueber den Zwischenpuffer in kdata, wie jeder andere Aufruf dieser
    // Datei auch: der Kernel schreibt NIE unmittelbar in einen
    // Adressraum, den er nicht selbst gebaut hat.
    let w: u64 = state + kstate.MU_OFF + 0x800
    var k: u64 = 0
    while k < have {
        kstate.set(state, kstate.MU_OFF + 0x800 + k * 8,
            sched.groups_at(state, me, k))
        k = k + 1
    }
    if have > 0 {
        if !copy_out(state, me, out, w, have * 8) {
            return neg(errno.E_FAULT)
        }
    }
    return have
}

// `setgroups(n, liste)` -- NUR FUER root, und das ist keine Strenge um
// ihrer selbst willen. Wer sich selbst eine Gruppe geben darf, hat
// keine Gruppen: ein Prozess wuerde einfach `setgroups(1, [0])` rufen
// und in jeder Gruppe sein, die er gerade braucht. Deshalb steht die
// Frage nach der WIRKSAMEN Kennung ganz vorn, und deshalb ist die
// Antwort -EPERM und nicht ein stilles Nichts.
//
// Die Liste wird VOLLSTAENDIG hereingeholt und erst dann gesetzt. Ein
// Aufruf, der zur Haelfte gelingt, waere ein Prozess mit halben Rechten
// -- dieselbe Ueberlegung wie bei `setresuid`.
fn do_setgroups(state: u64, me: u64, n: u64, src: u64) -> u64 {
    if !perm.is_root(state, me) {
        kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
        return neg(errno.E_PERM)
    }
    if n > sched.GROUPS_MAX {
        return neg(errno.E_INVAL)
    }
    if n == 0 {
        sched.groups_clear(state, me)
        kstate.add(state, kstate.MU_OFF + kstate.MU_SUPPSET, 1)
        return 0
    }
    if !proc.user_ok(state, me, src, n * 8) {
        return neg(errno.E_FAULT)
    }
    let w: u64 = state + kstate.MU_OFF + 0x800
    if !copy_in(state, me, w, src, n * 8) {
        return neg(errno.E_FAULT)
    }
    if !sched.groups_set(state, me, w, n) {
        return neg(errno.E_INVAL)
    }
    kstate.add(state, kstate.MU_OFF + kstate.MU_SUPPSET, 1)
    return 0
}

// Die Zaehler dieser Runde nach Ring 3, EINE Zahl je Aufruf. Kein
// Puffer, kein Format, nichts, was sich zwischen zwei Runden
// verschieben kann -- `SYS_OSUM_USERINFO` hat achtzehn Woerter in
// fester Reihenfolge, und genau daran haengt, dass keine Runde davor
// ein Feld einschieben darf.
fn do_mustat(state: u64, me: u64, was: u64) -> u64 {
    if was == MS_WALKS {
        return perm.walk_stat(state, kstate.MU_WALKS)
    }
    if was == MS_WALKDENY {
        return perm.walk_stat(state, kstate.MU_WALKDENY)
    }
    if was == MS_GRPHITS {
        return perm.walk_stat(state, kstate.MU_GRPHITS)
    }
    if was == MS_SUPPSET {
        return perm.walk_stat(state, kstate.MU_SUPPSET)
    }
    if was == MS_NODECHK {
        return perm.walk_stat(state, kstate.MU_NODECHK)
    }
    return neg(errno.E_INVAL)
}

// SYS_OSUM_USERINFO: die Zahlen dieser Runde nach Ring 3. Sie sind das,
// woran der Testlaeufer festmacht, dass ueberhaupt geprueft wurde -- eine
// Rechtepruefung, die niemand aufruft, ist von einer, die immer ja sagt,
// sonst nicht zu unterscheiden.
fn do_userinfo(state: u64, me: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, UI_COUNT * 8) {
        return neg(errno.E_FAULT)
    }
    // Der Puffer liegt in `kdata` und nicht auf dem Stapel: achtzehn
    // Woerter auf dem Kernstapel sind 144 Oktette, und firnc macht in
    // dieser Funktion 1984 daraus. Die ZWEITE Seite des Bereichs dieser
    // Runde (0x42000) ist genau dafuer da.
    let w: u64 = state + kstate.K13_OFF + 0x1000
    let b: u64 = kstate.K13_OFF
    kstate.set(state, kstate.K13_OFF + 0x1000 + 0 * 8,
        kstate.get(state, b + kstate.U_CHECKS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 1 * 8, kstate.get(state, b + kstate.U_DENIED))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 2 * 8, kstate.get(state, b + kstate.U_SETIDS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 3 * 8, kstate.get(state, b + kstate.U_CHMODS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 4 * 8, kstate.get(state, b + kstate.U_CHOWNS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 5 * 8, kstate.get(state, b + kstate.U_SUIDEXEC))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 6 * 8, fs.version(state))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 7 * 8, kstate.get(state, b + kstate.U_INITSLOT))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 8 * 8, kstate.get(state, b + kstate.U_ORPHANS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 9 * 8, sched.zombies(state, sched.K_USER))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 10 * 8, sched.tget(state, me, sched.T_UID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 11 * 8, sched.tget(state, me, sched.T_EUID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 12 * 8, sched.tget(state, me, sched.T_GID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 13 * 8, sched.tget(state, me, sched.T_EGID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 14 * 8, sched.tget(state, me, sched.T_SUID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 15 * 8, sched.tget(state, me, sched.T_UMASK))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 16 * 8, 0)
    if kstate.mode_on(state, kstate.M_NOPERM) {
        kstate.set(state, kstate.K13_OFF + 0x1000 + 16 * 8, 1)
    }
    kstate.set(state, kstate.K13_OFF + 0x1000 + 17 * 8,
        sched.alive_count(state))
    if !copy_out(state, me, out, w, UI_COUNT * 8) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// ----------------------------------------- RUNDE K15, ZWEITER NACHTRAG
//
// DER TABELLENLAUF UND DAS JOURNAL. Zusammen sind sie die Naht, an der
// ein Namensindex in Ring 3 haengt -- das Gegenstueck zu dem, was
// "Everything" auf NTFS aus der Master File Table und dem USN-Journal
// holt. Der INDEX selbst steht nicht hier und nicht im Kernel: er ist
// eine Liste von Namen im Speicher des suchenden Programms
// (`kernel/user/nidx.fi`). Der Kernel gibt die Tabelle heraus, mehr
// nicht.
//
// WARUM DAS UEBERHAUPT EIN SYSTEMAUFRUF IST: Ring 3 kann Verzeichnisse
// lesen (`getdents64`), aber nur EINZELN und nur ueber PFADE -- und
// genau das ist der Baumdurchlauf, gegen den der Index sich beweisen
// soll. Die Tabelle am Stueck zu lesen heisst, an den Bloecken zu sein,
// und dort ist der Kernel.
//
// Der Puffer in der Mitte ist `kstate.BLOCK_OFF`, die Seite, die
// Systemaufrufe ohnehin zum Hin- und Herkopieren nehmen: 4096 Oktette,
// also 63 Saetze je Aufruf (die ersten 64 Oktette haelt der Lauf selbst).
// Ein Aufruf je 63 Namen ist bei 4000 Dateien 64 Aufrufe -- der Grund,
// warum die Grenze hier steht und nicht bei einem Satz je Aufruf.
const SCAN_MAX: u64 = 63 // (BLOCK_MAX - 64) / nidx.REC

// RUNDE GLYPHE: die Satzseite DIESES Kerns. Siehe kstate.SCANB_OFF.
fn satzpuffer(state: u64) -> u64 {
    var k: u64 = cpu.here(state)
    if k >= kstate.MAX_CPUS {
        k = 0
    }
    return state + kstate.SCANB_OFF + k * kstate.BLOCK_MAX
}

fn do_scan(state: u64, me: u64, curp: u64, dst: u64, max: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NODEV)
    }
    var n: u64 = max
    if n == 0 {
        return 0
    }
    if n > SCAN_MAX {
        n = SCAN_MAX
    }
    if !proc.user_ok(state, me, curp, 8) {
        return neg(errno.E_FAULT)
    }
    if !proc.user_ok(state, me, dst, n * nidx.REC) {
        return neg(errno.E_FAULT)
    }
    // ================================================== RUNDE GLYPHE
    // DER UMSCHLAGPUFFER GEHOERT DER GANZEN MASCHINE, UND ER HAT HIER
    // EIN PROGRAMM UMGEBRACHT.
    //
    // `kstate.BLOCK_OFF` sind 4096 Oktett fuer den ganzen Rechner.
    // Dieser Weg legt die Saetze des Namensindex hinein und gibt sie
    // von dort an Ring 3. Mit `r3alle` laufen mehrere Ring-3-Programme
    // auf mehreren Kernen; zwei davon in `scan` oder `jrnl`
    // ueberschreiben einander die Saetze. GEMESSEN, voller
    // Schreibtisch, `-smp 4 r3alle`, 20 Laeufe:
    //
    //   panic: integer overflow casting 'u64 as u32'
    //   at kernel/user/nidx.fi:408
    //
    // Das ist `pino[] = read64(rec + R_PARENT) as u32` -- eine
    // Inodenummer, die keine mehr war.
    //
    // Es ist dieselbe Fehlerform wie die Buehne dieser Runde und wie
    // `fs.inode_get` aus VIELKERN 3, und es ist EINER der 43 Wege, die
    // MERGE-6 in dieser Datei GEZAEHLT und nicht gesperrt hat. Die
    // uebrigen 42 stehen weiter offen und werden in
    // `tools/vielkern/einkern.py` gezaehlt; dieser hier ist der, der
    // nachweislich zuschlaegt.
    //
    // `fs.enter` ist die richtige Sperre und nicht irgendeine: der
    // Puffer gehoert dem Dateisystem, `fs.scan` nimmt sie ohnehin, und
    // sie ist je Kern wiedereintrittsfaehig -- die innere `enter`
    // sieht sich selbst und verklemmt sich nicht.
    let fl: u64 = fs.enter(state)
    let cur: u64 = satzpuffer(state)
    let buf: u64 = cur + 64
    if !copy_in(state, me, cur, curp, 8) {
        fs.leave(state, fl)
        return neg(errno.E_FAULT)
    }
    let got: u64 = fs.scan(state, cur, buf, n)
    if !copy_out(state, me, curp, cur, 8) {
        fs.leave(state, fl)
        return neg(errno.E_FAULT)
    }
    if got != 0 {
        if !copy_out(state, me, dst, buf, got * nidx.REC) {
            fs.leave(state, fl)
            return neg(errno.E_FAULT)
        }
    }
    fs.leave(state, fl)
    return got
}

fn do_jrnl(state: u64, me: u64, from: u64, dst: u64, max: u64) -> u64 {
    var n: u64 = max
    if n == 0 {
        return 0
    }
    if n > nidx.MAXJ {
        n = nidx.MAXJ
    }
    if !proc.user_ok(state, me, dst, n * nidx.REC) {
        return neg(errno.E_FAULT)
    }
    // RUNDE GLYPHE: dieselbe Sperre und derselbe Puffer wie in
    // `do_scan`. UND EINE SCHRANKE, die gefehlt hat: `nidx.MAXJ` ist
    // 127, ein Satz ist 64 Oktett -- das sind 8128 Oktette in einen
    // Puffer von 4096. Bis zu dieser Runde lief der Rest davon in die
    // NAECHSTE Seite (`kstate.NAME_OFF`), und zwar still.
    if n * nidx.REC > kstate.BLOCK_MAX {
        n = kstate.BLOCK_MAX / nidx.REC
    }
    let fl: u64 = fs.enter(state)
    let buf: u64 = satzpuffer(state)
    let got: u64 = nidx.take(state, from, buf, n)
    if got != 0 {
        if !copy_out(state, me, dst, buf, got * nidx.REC) {
            fs.leave(state, fl)
            return neg(errno.E_FAULT)
        }
    }
    fs.leave(state, fl)
    return got
}


// ============================================== RUNDE TILING: der Baum





// ==================================================== RUNDE SYSTEMBUS
//
// DER EINE SYSTEMRUF DES BUSSES. Er holt aus dem Nutzerraum in einen
// Puffer AUF DEM STAPEL DIESES AUFRUFS -- nicht in einen globalen. Das
// ist die Ein-Kern-Regel dieser Runde und der Grund, warum vier Kerne
// gleichzeitig kopieren duerfen, ohne sich zu ueberschreiben
// (`STATUS-MERGE6.md`, die Befunde zu `fs.inode_get` und
// `wig.glyph_into`).
//
// DIE REIHENFOLGE, und sie ist wichtig: erst aus dem Nutzerraum holen
// (das kann einen Seitenfehler ausloesen), dann in den Bus (der nimmt
// die Sperre). Umgekehrt haette ein Seitenfehler die Bussperre in der
// Hand gehalten, und der naechste Kern haette darauf gewartet, bis die
// Zeit abgelaufen waere.
//
// pid und uid der Nachricht setzt der BUS aus der Aufgabentafel. Diese
// Funktion reicht sie nicht durch -- es gibt keinen Parameter dafuer,
// und das ist Absicht.
fn do_bus(state: u64, me: u64, op: u64, a1: u64, a2: u64, a3: u64,
    a4: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_NOBUS) {
        return neg(errno.E_NODEV)
    }
    // ---- Namen: hoechstens sechzehn Oktette, zwei Woerter.
    if op == BUS_REG || op == BUS_FIND {
        var nm: [u8; 16] = [0 as u8; 16]
        var n: u64 = a2
        if n > 16 {
            n = 16
        }
        if n > 0 {
            if !copy_in(state, me, (&nm[0]) as u64, a1, n) {
                return neg(errno.E_FAULT)
            }
        }
        let w0: u64 = bus_word((&nm[0]) as u64, 0)
        let w1: u64 = bus_word((&nm[0]) as u64, 8)
        if op == BUS_REG {
            return bus.reg(state, me, w0, w1, a3)
        }
        return bus.find(state, w0, w1)
    }
    // ---- alles, was Oktette traegt: EIN Puffer, 192 Oktette.
    if op == BUS_SEND || op == BUS_PUB || op == BUS_CLIPSET
        || op == BUS_FILL || op == BUS_DRAGSET || op == BUS_NOTIPOST {
        var buf: [u8; 192] = [0 as u8; 192]
        var n: u64 = 0
        var src: u64 = 0
        if op == BUS_SEND || op == BUS_PUB {
            src = a2
            n = a3
        }
        if op == BUS_CLIPSET || op == BUS_DRAGSET {
            src = a2
            n = a3
        }
        if op == BUS_FILL {
            src = a1
            n = a2
        }
        if op == BUS_NOTIPOST {
            src = a2
            n = a3
        }
        if n > 192 {
            n = 192
        }
        if n > 0 {
            if !copy_in(state, me, (&buf[0]) as u64, src, n) {
                return neg(errno.E_FAULT)
            }
        }
        let p: u64 = (&buf[0]) as u64
        if op == BUS_SEND {
            return bus.send(state, me, a1, a4, n, p)
        }
        if op == BUS_PUB {
            return bus.pub(state, me, a1, n, p)
        }
        if op == BUS_CLIPSET {
            return bus.clip_set(state, me, a1, n, a4, p)
        }
        if op == BUS_FILL {
            return bus.fill(state, me, n, a3, p)
        }
        if op == BUS_DRAGSET {
            return bus.drag_set(state, me, a1, n, a4, p)
        }
        return bus.noti_post(state, me, a1, n, p)
    }
    // ---- alles, was Oktette HOLT: Puffer und ein Kopf von sechs Woertern.
    if op == BUS_RECV || op == BUS_CLIPGET || op == BUS_DRAGGET
        || op == BUS_NOTIGET {
        var buf: [u8; 192] = [0 as u8; 192]
        var meta: [u8; 48] = [0 as u8; 48]
        var max: u64 = 0
        var uout: u64 = 0
        var umeta: u64 = 0
        var got: u64 = 0
        if op == BUS_RECV {
            uout = a1
            max = a2
            umeta = a3
        }
        if op == BUS_CLIPGET {
            uout = a2
            max = a3
            umeta = a4
        }
        if op == BUS_DRAGGET {
            uout = a1
            max = a2
            umeta = a3
        }
        if op == BUS_NOTIGET {
            uout = a2
            max = a3
        }
        if max > 192 {
            max = 192
        }
        let bp: u64 = (&buf[0]) as u64
        let mp: u64 = (&meta[0]) as u64
        if op == BUS_RECV {
            got = bus.recv(state, me, bp, max, mp)
        }
        if op == BUS_CLIPGET {
            got = bus.clip_get(state, me, a1, bp, max, mp)
        }
        if op == BUS_DRAGGET {
            got = bus.drag_get(state, bp, max, mp)
        }
        if op == BUS_NOTIGET {
            got = bus.noti_get(state, a1, bp, max)
        }
        if got > 0x8000000000000000 {
            return got as i64 as u64 // ein Fehler des Busses, unveraendert
        }
        if got > 0 {
            if !copy_out(state, me, uout, bp, got) {
                return neg(errno.E_FAULT)
            }
        }
        if umeta != 0 {
            if !copy_out(state, me, umeta, mp, 48) {
                return neg(errno.E_FAULT)
            }
        }
        return got
    }
    // ---- die Segmente.
    if op == BUS_SEGNEW {
        return bus.seg_new(state, me, a1)
    }
    if op == BUS_SEGMAP {
        return bus_segmap(state, me, a1)
    }
    if op == BUS_SEGDROP {
        return bus.seg_drop(state, me, a1)
    }
    // ---- die Fragen ohne Oktette.
    if op == BUS_SUB {
        return bus.sub(state, me, a1)
    }
    if op == BUS_OFFER {
        return bus.offer(state, me, a1)
    }
    if op == BUS_DRAGCLEAR {
        return bus.drag_clear(state)
    }
    if op == BUS_CLIPINFO {
        if a2 == 0 {
            return bus.clip_types(state, a1)
        }
        if a2 == 1 {
            return bus.clip_len(state, a1)
        }
        if a2 == 2 {
            return bus.clip_owner(state, a1)
        }
        if a2 == 3 {
            return bus.clip_count(state)
        }
        return bus.offer_state(state)
    }
    if op == BUS_DRAGINFO {
        if a1 == 0 {
            return bus.drag_active(state)
        }
        return bus.drag_types(state)
    }
    if op == BUS_NOTIINFO {
        if a1 == 0 {
            return bus.noti_count(state)
        }
        if a1 == 1 {
            return bus.noti_seen(state)
        }
        if a1 == 2 {
            return bus.noti_len(state, a2)
        }
        return bus.noti_prio(state, a2)
    }
    if op == BUS_STAT {
        return bus.stat(state, a1)
    }
    return neg(errno.E_INVAL)
}

// ==================================================== RUNDE HDA: DER TON
//
// Fuenf Aufrufe, und der interessanteste ist der dritte: er kopiert
// Rahmen aus Ring 3 in den DMA-Ringpuffer und gibt zurueck, wie viele
// hineingingen -- MEHR NICHT. Er wartet nicht, er legt niemanden
// schlafen, er blockiert nicht.
//
// WARUM NICHT BLOCKIEREND, wo doch jedes Unix `write` auf /dev/dsp
// blockiert: weil ein Abspieler, der auf Ton wartet, in derselben
// Schleife auch das Bild dekodieren muss. Ein blockierender Aufruf
// zwingt ihn zu einem zweiten Faden, und Faeden gibt es in diesem
// System noch nicht (Block A1 der Roadmap laeuft gerade). Ein Aufruf,
// der sagt "so viel habe ich genommen", laesst dem Programm die Wahl --
// und genau diese Wahl ist es, die spaeter Lippensynchronitaet
// ermoeglicht: Ton nachfuellen hat Vorrang, Bild wird ausgelassen.
//
// DER PUFFER geht ueber `kstate.BLOCK_OFF`, den Umsteigepuffer, den
// jeder Systemaufruf mit Daten benutzt: 4096 Oktette, also 1024 Rahmen
// je Durchgang. Ein Zeiger aus Ring 3 wird NIE direkt an den DMA
// gegeben -- der Regler wuerde eine Adresse lesen, die dem Prozess
// gehoert und die er waehrend des Spielens freigeben kann.

// ============================== RUNDE TON: DIE SPERRE UM JEDEN TONAUFRUF
//
// Fuenf Huellen, eine Regel: die Tonschicht wird NUR unter
// `audio.hold` betreten. Was die Sperre kostet, steht in A_LOCKSPIN
// (Wartedrehungen) und A_TICKSKIP (ausgelassene Zeitgeberschlaege);
// `tools/ton/run.sh` druckt beide.
fn do_audget(state: u64, field: u64) -> u64 {
    let f: u64 = audio.hold(state)
    let r: u64 = audget_locked(state, field)
    audio.drop(state, f)
    return r
}

fn do_audset(state: u64, field: u64, value: u64) -> u64 {
    // RUNDE TON-2: das eine Feld, das NICHT unter der Sperre laufen
    // darf, weil es schlaeft. Die Begruendung steht bei AS_WAITSPACE.
    if field == AS_WAITSPACE {
        return do_audwait(state, value)
    }
    let f: u64 = audio.hold(state)
    let r: u64 = audset_locked(state, field, value)
    audio.drop(state, f)
    return r
}

// RUNDE TON-2: WARTEN, BIS PLATZ IST -- gerechnet, nicht geraten.
//
// Der Ablauf ist dreimal dasselbe Muster: Sperre nehmen, RECHNEN,
// Sperre abgeben, DANN schlafen. Zwischen dem Rechnen und dem
// Schlafen kann das Geraet weiterlaufen; das macht die Wartezeit
// hoechstens zu lang, nie zu kurz, und deshalb wird nach dem Schlafen
// noch einmal nachgesehen, statt dem ersten Ergebnis zu glauben.
fn do_audwait(state: u64, value: u64) -> u64 {
    let kenn: u64 = value >> 8
    let will: u64 = (value & 0xFF) * 16
    var runden: u64 = 0
    // HOECHSTENS SO OFT. Eine Warteschleife im Kern braucht eine
    // Obergrenze, sonst haengt ein Abspieler an einem Geraet, das
    // stehengeblieben ist, fuer immer. 200 Runden zu hoechstens einem
    // Schlag sind zwei Sekunden -- weit mehr, als ein Ring je braucht.
    while runden < 200 {
        let f: u64 = audio.hold(state)
        // ERST PUMPEN. Der Platz entsteht dadurch, dass der Mischer
        // in den Geraetering nachlegt; wer nur nachsieht, ohne zu
        // pumpen, wartet auf etwas, das er selbst ausloesen muesste.
        audio.mix_pump(state)
        var platz: u64 = 0
        if kenn == 0 {
            platz = audio.space_frames(state)
        } else {
            let id: u64 = kenn -% 1
            if id >= mix.MAX_STREAMS || !mix.is_open(state, id) {
                audio.drop(state, f)
                return neg(errno.E_BADF)
            }
            platz = mix.space(state, id)
        }
        // Wie lange dauert es, bis genug frei ist? Der Ring gibt
        // Rahmen in der Geschwindigkeit der Abtastrate frei.
        let hz: u64 = audio.rate(state)
        var us: u64 = 0
        if platz < will && hz > 0 {
            us = (will -% platz) * 1000000 / hz
        }
        audio.drop(state, f)
        if platz >= will || will == 0 {
            return platz
        }
        // SCHLAFEN OHNE DIE SPERRE, UND NICHT AUF DEN LETZTEN RAHMEN
        // GENAU.
        //
        // GEMESSEN: fragt der Abspieler nur nach dem, was ihm gerade
        // fehlt (ein Schub, 1024 Rahmen), ist die gerechnete Wartezeit
        // fast immer kuerzer als ein Zeitgeberschlag. `us / 10000`
        // wird dann null, es bleibt beim `yield`, und der Aufruf kommt
        // nach durchschnittlich 724 us zurueck -- 74361 Wartedrehungen
        // in sechzig Sekunden. Das ist besser als der alte Spin (zwei
        // Systemaufrufe je Drehung), aber es ist noch kein Warten.
        //
        // DESHALB WIRD AUF EINEN GANZEN SCHLAG AUFGERUNDET, sobald
        // ueberhaupt gewartet werden muss: wer schlafen geht, soll
        // lange genug schlafen, dass es sich lohnt. Der Ring traegt
        // 85 ms Vorrat, ein Schlag sind 10 ms -- das ist ein Achtel
        // und kein Risiko, und der Deckel unten begrenzt es zusaetzlich
        // auf den halben Ring.
        var ticks: u64 = us / 10000
        if ticks == 0 && us > 0 {
            ticks = 1
        }
        if ticks == 0 {
            sched.yield_now(state)
        } else {
            var t: u64 = ticks
            // NIE LAENGER ALS DER HALBE RING. Verrechnet sich die
            // Schaetzung nach oben, ist ein zu langer Schlaf ein
            // Aussetzer -- ein zu kurzer kostet nur eine Runde mehr.
            let deckel: u64 = audio.latency_us(state) / 20000
            if deckel > 0 && t > deckel {
                t = deckel
            }
            sched.sleep_ticks(state, t)
        }
        runden = runden + 1
    }
    return 0
}

fn do_audwrite(state: u64, me: u64, src: u64, frames: u64) -> u64 {
    let f: u64 = audio.hold(state)
    let t: u64 = audio.mark_write(state)
    let r: u64 = audwrite_locked(state, me, src, frames)
    audio.mark_done(state, t)
    audio.drop(state, f)
    return r
}

fn do_audopen(state: u64, me: u64, hz: u64) -> u64 {
    let f: u64 = audio.hold(state)
    let r: u64 = audopen_locked(state, me, hz)
    audio.drop(state, f)
    return r
}

fn do_audsend(state: u64, me: u64, id: u64, src: u64, frames: u64) -> u64 {
    let f: u64 = audio.hold(state)
    let t: u64 = audio.mark_write(state)
    let r: u64 = audsend_locked(state, me, id, src, frames)
    audio.mark_done(state, t)
    audio.drop(state, f)
    return r
}

fn audget_locked(state: u64, field: u64) -> u64 {
    if field == audio.A_READY {
        if audio.ready(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_RATE {
        return audio.rate(state)
    }
    if field == audio.A_CHANNELS {
        return audio.channels(state)
    }
    if field == audio.A_BITS {
        return audio.bits(state)
    }
    if field == audio.A_VOLUME {
        return audio.volume(state)
    }
    if field == audio.A_PLAYED {
        // DIE PUMPE HAENGT HIER MIT DRAN, und das ist der Grund, warum
        // ein Abspieler nichts weiter tun muss als seine Position
        // abzufragen: er dreht damit den Mischer mit. Ohne diese Zeile
        // liefe der Mischer nur beim Schreiben, und ein Programm, das
        // gerade nichts zu schreiben hat, wuerde die anderen anhalten.
        audio.mix_pump(state)
        return audio.samples_played(state)
    }
    if field == audio.A_WRITTEN {
        return audio.frames_written(state)
    }
    if field == audio.A_UNDERRUNS {
        return audio.underruns(state)
    }
    if field == audio.A_LATENCY {
        return audio.latency_us(state)
    }
    if field == audio.A_ENTRYUS {
        return audio.entry_us(state)
    }
    if field == audio.A_RINGFRAMES {
        return audio.ring_frames(state)
    }
    if field == audio.A_RUNNING {
        if audio.backend(state) == audio.B_HDA {
            if hda.running(state) {
                return 1
            }
            return 0
        }
        if ac97.running(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_OPEN {
        if audio.is_open(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_BACKEND {
        return audio.backend(state)
    }
    if field == audio.A_WHY {
        return audio.why(state)
    }
    if field == audio.A_SOUNDS {
        if audio.sounds_on(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_BEEPS {
        return audio.beeps(state)
    }
    if field == audio.A_MUTED {
        if audio.muted(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_REMAIN {
        return audio.remaining(state)
    }
    if field == audio.A_WRITES {
        return audio.writes(state)
    }
    if field == audio.A_BACKSTEPS {
        return audio.backsteps(state)
    }
    if field == audio.A_LOST {
        return audio.lost(state)
    }
    if field == audio.A_ZEROED {
        return audio.zeroed(state)
    }
    // ---- RUNDE TON ----
    if field == audio.A_VOLGEN {
        return audio.volgen(state)
    }
    if field == audio.A_CLICKS {
        if audio.clicks_on(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_TICKSKIP {
        return audio.tick_skips(state)
    }
    if field == audio.A_LOCKSPIN {
        return audio.lock_spins(state)
    }
    if field == audio.A_MINFILL {
        return audio.min_fill(state)
    }
    if field == audio.A_SYSSOUNDS {
        return audio.sys_sounds(state)
    }
    if field == audio.A_GAPMAX {
        return audio.gap_max(state)
    }
    if field == audio.A_SYSUS {
        return audio.sys_us(state)
    }
    if field == audio.A_WALLUS {
        return audio.wall_us(state)
    }
    if field == audio.A_CALLS {
        return audio.calls(state)
    }
    if field == audio.A_STREAMS {
        return mix.streams(state)
    }
    if field == audio.A_MIXED {
        return mix.mixed(state)
    }
    if field == audio.A_CLIPS {
        return mix.clips(state)
    }
    if field == audio.A_MIXUNDER {
        return mix.underruns(state, mix.MAX_STREAMS)
    }
    if field == audio.A_DISAGREE {
        if audio.backend(state) == audio.B_HDA {
            return hda.pos_disagree(state)
        }
        return 0
    }
    if field == audio.A_CMDPATH {
        if audio.backend(state) == audio.B_HDA {
            return hda.cmd_path(state)
        }
        return 0
    }
    if field == audio.A_DAC {
        if audio.backend(state) == audio.B_HDA {
            return hda.dac_nid(state)
        }
        return 0
    }
    if field == audio.A_PIN {
        if audio.backend(state) == audio.B_HDA {
            return hda.pin_nid(state)
        }
        return 0
    }
    if field == audio.A_PATHLEN {
        if audio.backend(state) == audio.B_HDA {
            return hda.path_len(state)
        }
        return 0
    }
    if field == audio.A_WIDGETS {
        if audio.backend(state) == audio.B_HDA {
            return hda.widgets(state)
        }
        return 0
    }
    if field == audio.A_CODECADDR {
        if audio.backend(state) == audio.B_HDA {
            return hda.codec_addr(state)
        }
        return 0
    }
    return neg(errno.E_INVAL)
}

fn bus_word(p: u64, off: u64) -> u64 {
    var w: u64 = 0
    var k: u64 = 0
    while k < 8 {
        w = w | (kstate.get8(p + off + k) << (k * 8))
        k = k + 1
    }
    return w
}

// EIN MEGABYTE OHNE EIN EINZIGES KOPIERTES OKTETT.
//
// Die Seiten des Segments werden in den Adressraum des Aufrufers
// GEHAENGT, nicht hineingeschrieben. Die Adressen kommen aus demselben
// Vorrat wie `big_map` (`proc.BIG_FLOOR`..`T_BIG`), damit es genau EINEN
// Zaehler fuer den grossen Bereich gibt und nicht zwei, die sich
// ueberholen koennen.
//
// Und die Rahmen tragen `PAGE_SHARED`: `proc.free_pt` laesst sie beim
// Abraeumen des Adressraums liegen, denn sie gehoeren dem Bus. Ohne das
// Bit haette der zweite Prozess nach dem Ende des ersten in fremden,
// laengst neu vergebenen Speicher geschrieben -- still.
fn bus_segmap(state: u64, me: u64, id: u64) -> u64 {
    if bus.seg_map(state, me, id) != bus.E_OK {
        return neg(errno.E_INVAL)
    }
    let pages: u64 = bus.seg_pages(state, id)
    if pages == 0 {
        return neg(errno.E_INVAL)
    }
    let top: u64 = big_bottom(state, me)
    if pages * PAGE > top - proc.BIG_FLOOR {
        return neg(errno.E_NOMEM)
    }
    let base: u64 = top - pages * PAGE
    if base < proc.BIG_FLOOR {
        return neg(errno.E_NOMEM)
    }
    var k: u64 = 0
    while k < pages {
        let f: u64 = bus.seg_frame(state, id, k)
        if f == 0 {
            return neg(errno.E_INVAL)
        }
        if !proc.map_frame(state, me, base + k * PAGE, f, true) {
            return neg(errno.E_NOMEM)
        }
        kstate.add(state, kstate.MAPS, 1)
        k = k + 1
    }
    sched.tset(state, me, sched.T_BIG, base)
    return base
}

fn audset_locked(state: u64, field: u64, value: u64) -> u64 {
    if field == AS_VOLUME {
        if value > 100 {
            return neg(errno.E_INVAL)
        }
        audio.set_volume(state, value)
        return 0
    }
    if field == AS_MUTE {
        audio.set_muted(state, value != 0)
        return 0
    }
    if field == AS_SOUNDS {
        audio.set_sounds(state, value != 0)
        return 0
    }
    if !audio.ready(state) {
        return neg(errno.E_NODEV)
    }
    if field == AS_OPEN {
        if value != 0 {
            if audio.open(state) {
                return 0
            }
            return neg(errno.E_BUSY)
        }
        audio.close(state)
        return 0
    }
    if field == AS_DRAIN {
        audio.pad_and_submit(state)
        return 0
    }
    if field == AS_STOP {
        audio.stop(state)
        return 0
    }
    if field == AS_RATE {
        // AUSGEHANDELT UND NICHT BEFOHLEN: der Rueckgabewert sagt, ob
        // die gewuenschte Rate wirklich gestellt wurde. Was WIRKLICH
        // laeuft, liest das Programm danach mit A_RATE ab -- und ein
        // Abspieler, der das nicht tut, spielt mit falscher Tonhoehe
        // und meldet Erfolg.
        if audio.set_rate(state, value) {
            return 0
        }
        return neg(errno.E_INVAL)
    }
    if field == AS_CLOSE {
        audio.close_stream(state, value)
        return 0
    }
    if field == AS_END {
        audio.end_stream(state, value)
        return 0
    }
    if field == AS_SVOL {
        mix.set_volume(state, value >> 8, value & 0xFF)
        return 0
    }
    if field == AS_PUMP {
        audio.mix_pump(state)
        audio.zero_rest(state)
        return 0
    }
    if field == AS_SOUND {
        if value > audio.SND_ERROR {
            return neg(errno.E_INVAL)
        }
        if audio.sys_sound(state, value) {
            return 1
        }
        return 0
    }
    if field == AS_CLICKS {
        audio.set_clicks(state, value != 0)
        return 0
    }
    if field == AS_SMUTE {
        mix.set_muted_pub(state, value >> 8, (value & 0xFF) != 0)
        return 0
    }
    if field == AS_BEEP {
        var hz: u64 = value
        if hz == 0 {
            audio.error_beep(state)
            return 0
        }
        if hz < 20 || hz > 20000 {
            return neg(errno.E_INVAL)
        }
        audio.beep(state, hz, 90)
        return 0
    }
    return neg(errno.E_INVAL)
}

fn audwrite_locked(state: u64, me: u64, src: u64, frames: u64) -> u64 {
    if !audio.ready(state) {
        return neg(errno.E_NODEV)
    }
    if !audio.is_open(state) {
        return neg(errno.E_BADF)
    }
    if frames == 0 {
        return 0
    }
    let fo: u64 = audio.frame_octets(state)
    let cap: u64 = kstate.AUDB_MAX / fo
    var n: u64 = frames
    if n > cap {
        n = cap
    }
    let room: u64 = audio.space_frames(state)
    if room == 0 {
        return 0
    }
    if n > room {
        n = room
    }
    let bounce: u64 = state + kstate.AUDB_OFF
    if !copy_in(state, me, bounce, src, n * fo) {
        return neg(errno.E_FAULT)
    }
    return audio.write(state, bounce, n)
}

// DEN MISCHERWEG OEFFNEN. Der Rueckgabewert ist die Kennung des
// Stromes (0..3) -- eine Zahl und kein Handle, weil die Handle-Schicht
// (Runde HANDLE) fuer einen Tonstrom kein einziges ihrer Merkmale
// braucht: er wird nicht weitergegeben, nicht geerbt, nicht abgebrochen.
fn audopen_locked(state: u64, me: u64, hz: u64) -> u64 {
    if !audio.ready(state) {
        return neg(errno.E_NODEV)
    }
    let id: u64 = audio.open_stream(state, me, hz)
    if id >= mix.MAX_STREAMS {
        return neg(errno.E_BUSY)
    }
    return id
}

fn audsend_locked(state: u64, me: u64, id: u64, src: u64, frames: u64) -> u64 {
    if !audio.ready(state) {
        return neg(errno.E_NODEV)
    }
    if id >= mix.MAX_STREAMS {
        return neg(errno.E_INVAL)
    }
    if !mix.is_open(state, id) {
        return neg(errno.E_BADF)
    }
    if frames == 0 {
        return 0
    }
    let fo: u64 = audio.frame_octets(state)
    let cap: u64 = kstate.AUDB_MAX / fo
    var n: u64 = frames
    if n > cap {
        n = cap
    }
    let room: u64 = mix.space(state, id)
    if room == 0 {
        // KEIN PLATZ IST KEIN FEHLER. Der Aufrufer kommt wieder; ein
        // Fehlercode hier wuerde ihn abbrechen lassen, obwohl alles in
        // Ordnung ist.
        audio.mix_pump(state)
        return 0
    }
    if n > room {
        n = room
    }
    let bounce: u64 = state + kstate.AUDB_OFF
    if !copy_in(state, me, bounce, src, n * fo) {
        return neg(errno.E_FAULT)
    }
    return audio.write_stream(state, id, bounce, n)
}
