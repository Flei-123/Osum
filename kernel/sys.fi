const MS_BLOCKS: u64 = 4
const MS_FLAGS: u64 = 5
const MS_OPENS: u64 = 6
const MS_COUNT: u64 = 7
const MS_PATHLEN: u64 = 8
const MS_PATHCH: u64 = 100 // 100 + i = das i-te Oktett des Pfades

// Die Schalter von `mount`. MS_RDONLY ist Linux' Bit 0; alles andere
