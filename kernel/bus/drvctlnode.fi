profile kernel

import lib.kstate
import bus.drvstore
import ldr.auxslot
import ldr.modidx
import serial

export { command, status }

const NAME_MAX: u64 = 23
const NO_NUM: u64 = 0xFFFFFFFFFFFFFFFF
const RES_MAX: u64 = 95

static mut result: [u8; 96] = [0 as u8; 96]
static mut result_len: u64 = 0

fn put_c(c: u64) {
    if result_len < RES_MAX {
        result[result_len as usize] = c as u8
        result_len = result_len + 1
    }
}

fn put_s(s: u64) {
    var i: u64 = 0
    while kstate.get8(s + i) != 0 {
        put_c(kstate.get8(s + i))
        i = i + 1
    }
}

fn put_dec(v: u64) {
    var tmp: [u8; 20] = [0 as u8; 20]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        put_c(48)
        return
    }
    while x > 0 {
        tmp[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        put_c(tmp[n as usize] as u64)
    }
}

fn status(dst: u64) -> u64 {
    var i: u64 = 0
    while i < result_len {
        kstate.set8(dst + i, result[i as usize])
        i = i + 1
    }
    return result_len
}

fn name_char(c: u64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 95
}

fn fail_text() {
    var s_bad: [u8; 12] = "error: bad\n\0"
    result_len = 0
    put_s((&s_bad[0]) as u64)
}

fn report(name: u64, code: u64) {
    var s_pre: [u8; 8] = "unload \0"
    var s_ok: [u8; 5] = " ok\n\0"
    var s_none: [u8; 7] = " none\n\0"
    var s_idle: [u8; 7] = " idle\n\0"
    var s_busy: [u8; 12] = " busy refs=\0"
    var s_log: [u8; 21] = "drvstore: ctl unload\0"
    result_len = 0
    put_s((&s_pre[0]) as u64)
    put_s(name)
    if code == drvstore.UL_OK {
        put_s((&s_ok[0]) as u64)
    } else if code == drvstore.UL_NONE {
        put_s((&s_none[0]) as u64)
    } else if code == drvstore.UL_IDLE {
        put_s((&s_idle[0]) as u64)
    } else {
        put_s((&s_busy[0]) as u64)
        put_dec(drvstore.last_refs())
        put_c(10)
    }
    serial.puts((&s_log[0]) as u64)
    serial.put(32 as u8)
    serial.puts(name)
    serial.put(32 as u8)
    serial.dec(code)
    serial.nl()
}

fn report_load(name: u64, code: u64) {
    var s_pre: [u8; 6] = "load \0"
    var s_ok: [u8; 11] = " ok bound=\0"
    var s_none: [u8; 7] = " none\n\0"
    var s_loaded: [u8; 10] = " loaded\n\0\0"
    var s_nodev: [u8; 8] = " nodev\n\0"
    var s_log: [u8; 19] = "drvstore: ctl load\0"
    result_len = 0
    put_s((&s_pre[0]) as u64)
    put_s(name)
    if code == drvstore.UL_OK {
        put_s((&s_ok[0]) as u64)
        put_dec(drvstore.last_loaded())
        put_c(10)
    } else if code == drvstore.UL_LOADED {
        put_s((&s_loaded[0]) as u64)
    } else if code == drvstore.UL_NODEV {
        put_s((&s_nodev[0]) as u64)
    } else {
        put_s((&s_none[0]) as u64)
    }
    serial.puts((&s_log[0]) as u64)
    serial.put(32 as u8)
    serial.puts(name)
    serial.put(32 as u8)
    serial.dec(code)
    serial.nl()
}

fn word_at(buf: u64, len: u64, at: u64, word: u64) -> bool {
    var i: u64 = 0
    while kstate.get8(word + i) != 0 {
        if at + i >= len || kstate.get8(buf + at + i) != kstate.get8(word + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn parse_num(buf: u64, len: u64, at: u64, out: u64) -> u64 {
    var i: u64 = at
    var v: u64 = 0
    var digits: u64 = 0
    while i < len && kstate.get8(buf + i) >= 48 && kstate.get8(buf + i) <= 57 && digits < 12 {
        v = v * 10 + (kstate.get8(buf + i) - 48)
        digits = digits + 1
        i = i + 1
    }
    if digits == 0 {
        return NO_NUM
    }
    kstate.set(out, 0, v)
    return i
}

fn owner_or_none(slot: u64) {
    var s_none: [u8; 5] = "none\0"
    let who: u64 = drvstore.slot_owner(slot)
    if who == 0 {
        put_s((&s_none[0]) as u64)
    } else {
        put_s(who)
    }
}

fn slots_report() -> bool {
    var s_head: [u8; 13] = "slots mouse=\0"
    var s_aux: [u8; 6] = " aux=\0"
    result_len = 0
    put_s((&s_head[0]) as u64)
    owner_or_none(modidx.SLOT_MOUSE)
    put_s((&s_aux[0]) as u64)
    owner_or_none(modidx.SLOT_AUX)
    put_c(10)
    return true
}

fn aux_report(state: u64, buf: u64, len: u64, at: u64) -> bool {
    var s_pre: [u8; 5] = "aux \0"
    var s_eq: [u8; 4] = " = \0"
    var s_none: [u8; 10] = "aux none\n\0"
    var s_log: [u8; 20] = "drvstore: ctl aux \0\0"
    var vals: [u64; 2] = [0 as u64; 2]
    result_len = 0
    let a: u64 = parse_num(buf, len, at, (&vals[0]) as u64)
    if a == NO_NUM || a >= len || kstate.get8(buf + a) != 32 {
        fail_text()
        return false
    }
    let b: u64 = parse_num(buf, len, a + 1, ((&vals[0]) as u64) + 8)
    if b == NO_NUM {
        fail_text()
        return false
    }
    if !auxslot.present(state) {
        put_s((&s_none[0]) as u64)
        return true
    }
    let r: u64 = auxslot.control(state, vals[0], vals[1])
    put_s((&s_pre[0]) as u64)
    put_dec(vals[0])
    put_c(32)
    put_dec(vals[1])
    put_s((&s_eq[0]) as u64)
    put_dec(r)
    put_c(10)
    serial.puts((&s_log[0]) as u64)
    serial.dec(vals[0])
    serial.put(32 as u8)
    serial.dec(r)
    serial.nl()
    return true
}

fn command(state: u64, buf: u64, len: u64) -> bool {
    var c_slots: [u8; 6] = "slots\0"
    var c_aux: [u8; 5] = "aux \0"
    if word_at(buf, len, 0, (&c_slots[0]) as u64) {
        return slots_report()
    }
    if word_at(buf, len, 0, (&c_aux[0]) as u64) {
        return aux_report(state, buf, len, 4)
    }
    return named_command(state, buf, len)
}

fn verb_len(buf: u64, len: u64, verb: u64) -> u64 {
    var i: u64 = 0
    while kstate.get8(verb + i) != 0 {
        if i >= len || kstate.get8(buf + i) != kstate.get8(verb + i) {
            return NO_NUM
        }
        i = i + 1
    }
    return i
}

fn named_command(state: u64, buf: u64, len: u64) -> bool {
    var c_unload: [u8; 8] = "unload \0"
    var c_load: [u8; 6] = "load \0"
    var name: [u8; 24] = [0 as u8; 24]
    var is_load: bool = false
    var i: u64 = verb_len(buf, len, (&c_unload[0]) as u64)
    if i == NO_NUM {
        i = verb_len(buf, len, (&c_load[0]) as u64)
        is_load = true
    }
    if i == NO_NUM {
        fail_text()
        return false
    }
    var n: u64 = 0
    while i < len && name_char(kstate.get8(buf + i)) && n < NAME_MAX {
        name[n as usize] = kstate.get8(buf + i) as u8
        n = n + 1
        i = i + 1
    }
    var end: u64 = 10
    if i < len {
        end = kstate.get8(buf + i)
    }
    if n == 0 || (end != 10 && end != 0 && end != 13 && end != 32) {
        fail_text()
        return false
    }
    name[n as usize] = 0 as u8
    if is_load {
        report_load((&name[0]) as u64, drvstore.load_pkg(state, (&name[0]) as u64))
    } else {
        report((&name[0]) as u64, drvstore.unload_pkg(state, (&name[0]) as u64))
    }
    return true
}
