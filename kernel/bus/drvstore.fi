// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import lib.kstate
import lib.ksym
import bus.pci
import bus.drvreg
import bus.drvinf
import bus.drvfw
import arch.x86_64.apic
import fs.fs
import ldr.module
import ldr.modidx
import ldr.modtab
import serial

export {
    init, enabled, pkg_total, pkg_valid, pkg_name, pkg_dir, pkg_status, pkg_loaded,
    pkg_bound, pkg_banned, pkg_version, pkg_rank, pkg_nmatch, pkg_kind, pkg_a, pkg_b,
    pkg_rec, pkg_origin, pkg_app, bind_total, bind_pkg, bind_id, bind_result, bind_code,
    find_bind, unload_test, unload_pkg, load_pkg, last_loaded, last_refs, UL_OK, UL_NONE, UL_IDLE, UL_BUSY, UL_LOADED, UL_NODEV, best_pci, best_usb, best_acpi, bound_count, failed_count,
    CTX_OFF, ST_OK, ST_BANNED, X_SIG, X_ABI, X_NOMODULE, X_NOFILE, X_DENY,
    BR_NONE, BR_BOUND, BR_FAILED, BR_RELEASED, NONE, slot_owner, slot_of, X_DUP, X_SLOTBUSY
}

const MAXPKG: u64 = 16
const MAXBIND: u64 = 32
const NONE: u64 = 0xFFFFFFFFFFFFFFFF
const CTX_OFF: u64 = 0x1800

const M_VALID: u64 = 0
const M_STATUS: u64 = 1
const M_LOADK: u64 = 2
const M_BOUND: u64 = 3
const M_BANNED: u64 = 4
const M_LOADRC: u64 = 5
const M_ORIGIN: u64 = 6
const M_FIELDS: u64 = 7

const ST_OK: u64 = 0
const ST_BANNED: u64 = 30
const X_SIG: u64 = 20
const X_ABI: u64 = 21
const X_NOMODULE: u64 = 22
const X_NOFILE: u64 = 23
const X_DENY: u64 = 24
const X_DUP: u64 = 25
const X_SLOTBUSY: u64 = 40
const MAXAPP: u64 = 8
const APP_BYTES: u64 = 24

const BR_NONE: u64 = 0
const BR_BOUND: u64 = 1
const BR_FAILED: u64 = 2
const BR_RELEASED: u64 = 3

const UL_OK: u64 = 0
const UL_NONE: u64 = 1
const UL_IDLE: u64 = 2
const UL_BUSY: u64 = 3
const UL_LOADED: u64 = 4
const UL_NODEV: u64 = 5

const B_KIND: u64 = 0
const B_ID: u64 = 1
const B_PKG: u64 = 2
const B_RESULT: u64 = 3
const B_CODE: u64 = 4
const B_FIELDS: u64 = 5

const NO_LOAD: u64 = 99

static mut records: [u8; 6912] = [0 as u8; 6912]
static mut meta: [u64; 112] = [0 as u64; 112]
static mut app_names: [u8; 192] = [0 as u8; 192]
static mut napps: u64 = 0
static mut dirs: [u8; 384] = [0 as u8; 384]
static mut binds: [u64; 160] = [0 as u64; 160]
static mut npkg: u64 = 0
static mut nbind: u64 = 0
static mut on: u64 = 0
static mut inf_buf: [u8; 1600] = [0 as u8; 1600]
static mut sig_buf: [u8; 72] = [0 as u8; 72]
static mut deny_buf: [u8; 1032] = [0 as u8; 1032]
static mut path_buf: [u8; 112] = [0 as u8; 112]
static mut ent_buf: [u8; 64] = [0 as u8; 64]
static mut n_bound: u64 = 0
static mut n_failed: u64 = 0
static mut held_refs: u64 = 0
static mut loaded_now: u64 = 0

fn enabled() -> bool {
    return on != 0
}

fn pkg_total() -> u64 {
    return npkg
}

fn rec_at(i: u64) -> u64 {
    return ((&records[0]) as u64) + i * drvinf.REC_BYTES
}

fn pkg_rec(i: u64) -> u64 {
    return rec_at(i)
}

fn mf(i: u64, f: u64) -> u64 {
    return meta[(i * M_FIELDS + f) as usize]
}

fn mset(i: u64, f: u64, v: u64) {
    meta[(i * M_FIELDS + f) as usize] = v
}

fn pkg_valid(i: u64) -> bool {
    return i < npkg && mf(i, M_VALID) == 1
}

fn pkg_status(i: u64) -> u64 {
    return mf(i, M_STATUS)
}

fn pkg_loaded(i: u64) -> bool {
    return mf(i, M_LOADK) != NO_LOAD
}

fn pkg_bound(i: u64) -> u64 {
    return mf(i, M_BOUND)
}

fn pkg_banned(i: u64) -> bool {
    return mf(i, M_BANNED) != 0
}

fn pkg_dir(i: u64) -> u64 {
    return ((&dirs[0]) as u64) + i * 24
}

fn pkg_name(i: u64) -> u64 {
    if mf(i, M_VALID) == 1 {
        return drvinf.rec_name(rec_at(i))
    }
    return pkg_dir(i)
}

fn pkg_version(i: u64) -> u64 {
    return drvinf.rec_version(rec_at(i))
}

fn pkg_rank(i: u64) -> u64 {
    return drvinf.rec_rank(rec_at(i))
}

fn pkg_nmatch(i: u64) -> u64 {
    return drvinf.rec_nmatch(rec_at(i))
}

fn pkg_kind(i: u64, m: u64) -> u64 {
    return drvinf.rec_kind(rec_at(i), m)
}

fn pkg_a(i: u64, m: u64) -> u64 {
    return drvinf.rec_a(rec_at(i), m)
}

fn pkg_b(i: u64, m: u64) -> u64 {
    return drvinf.rec_b(rec_at(i), m)
}

fn bind_total() -> u64 {
    return nbind
}

fn bf(i: u64, f: u64) -> u64 {
    return binds[(i * B_FIELDS + f) as usize]
}

fn bind_pkg(i: u64) -> u64 { return bf(i, B_PKG) }
fn bind_id(i: u64) -> u64 { return bf(i, B_ID) }
fn bind_result(i: u64) -> u64 { return bf(i, B_RESULT) }
fn bind_code(i: u64) -> u64 { return bf(i, B_CODE) }

fn bound_count() -> u64 { return n_bound }
fn failed_count() -> u64 { return n_failed }

fn find_bind(kind: u64, id: u64) -> u64 {
    var i: u64 = 0
    while i < nbind {
        if bf(i, B_KIND) == kind && bf(i, B_ID) == id {
            return i
        }
        i = i + 1
    }
    return NONE
}

fn add_bind(kind: u64, id: u64, pkg: u64, result: u64, code: u64) {
    var i: u64 = find_bind(kind, id)
    if i != NONE {
        if bf(i, B_RESULT) == BR_BOUND {
            if n_bound > 0 {
                n_bound = n_bound - 1
            }
        } else if bf(i, B_RESULT) == BR_FAILED {
            if n_failed > 0 {
                n_failed = n_failed - 1
            }
        }
    } else {
        if nbind >= MAXBIND {
            return
        }
        i = nbind
        nbind = nbind + 1
    }
    binds[(i * B_FIELDS + B_KIND) as usize] = kind
    binds[(i * B_FIELDS + B_ID) as usize] = id
    binds[(i * B_FIELDS + B_PKG) as usize] = pkg
    binds[(i * B_FIELDS + B_RESULT) as usize] = result
    binds[(i * B_FIELDS + B_CODE) as usize] = code
    if result == BR_BOUND {
        n_bound = n_bound + 1
    } else {
        n_failed = n_failed + 1
    }
}

fn path_put(n: u64, text: u64, cap: u64) -> u64 {
    var at: u64 = n
    var i: u64 = 0
    while kstate.get8(text + i) != 0 && at < cap {
        path_buf[at as usize] = kstate.get8(text + i) as u8
        at = at + 1
        i = i + 1
    }
    return at
}

fn pkg_path(origin: u64, dir: u64, file: u64) {
    var root: [u8; 14] = "/lib/drivers/\0"
    var apps: [u8; 7] = "/apps/\0"
    var lib: [u8; 6] = "/lib/\0"
    var slash: [u8; 2] = "/\0"
    var n: u64 = 0
    if origin == 0 {
        n = path_put(n, (&root[0]) as u64, 20)
    } else {
        n = path_put(n, (&apps[0]) as u64, 20)
        n = path_put(n, app_name(origin - 1), 50)
        n = path_put(n, (&lib[0]) as u64, 60)
    }
    n = path_put(n, dir, 85)
    n = path_put(n, (&slash[0]) as u64, 90)
    n = path_put(n, file, 108)
    path_buf[n as usize] = 0 as u8
}

fn app_name(i: u64) -> u64 {
    return ((&app_names[0]) as u64) + i * APP_BYTES
}

fn pkg_origin(i: u64) -> u64 {
    return mf(i, M_ORIGIN)
}

fn pkg_app(i: u64) -> u64 {
    if mf(i, M_ORIGIN) == 0 {
        return 0
    }
    return app_name(mf(i, M_ORIGIN) - 1)
}

fn load_pkg_files(state: u64, origin: u64, dir: u64) -> u64 {
    var f_inf: [u8; 11] = "driver.inf\0"
    var f_sig: [u8; 15] = "driver.inf.sig\0"
    pkg_path(origin, dir, (&f_inf[0]) as u64)
    let ino: u64 = fs.path(state, (&path_buf[0]) as u64)
    if ino == 0 {
        return X_NOFILE
    }
    let size: u64 = fs.inode_size(state, ino)
    if size == 0 || size > 1536 {
        return drvinf.E_TOOBIG
    }
    if !drvfw.read_all(state, ino, (&inf_buf[0]) as u64, size) {
        return X_NOFILE
    }
    pkg_path(origin, dir, (&f_sig[0]) as u64)
    let sino: u64 = fs.path(state, (&path_buf[0]) as u64)
    if sino == 0 || fs.inode_size(state, sino) != 64 {
        return X_SIG
    }
    if !drvfw.read_all(state, sino, (&sig_buf[0]) as u64, 64) {
        return X_SIG
    }
    if !module.signature_valid(state, (&inf_buf[0]) as u64, size, (&sig_buf[0]) as u64) {
        return X_SIG
    }
    return size
}

fn check_module_file(state: u64, origin: u64, rec: u64, dir: u64) -> bool {
    pkg_path(origin, dir, drvinf.rec_module(rec))
    return fs.path(state, (&path_buf[0]) as u64) != 0
}

fn copy_dir(i: u64, src: u64) {
    var k: u64 = 0
    while k < 23 && kstate.get8(src + k) != 0 {
        dirs[(i * 24 + k) as usize] = kstate.get8(src + k) as u8
        k = k + 1
    }
    dirs[(i * 24 + k) as usize] = 0 as u8
}

fn name_taken(name: u64, upto: u64) -> bool {
    var p: u64 = 0
    while p < upto {
        if drvinf.text_eq(pkg_dir(p), name) {
            return true
        }
        p = p + 1
    }
    return false
}

fn scan_one(state: u64, origin: u64, name: u64) {
    if npkg >= MAXPKG {
        return
    }
    let i: u64 = npkg
    npkg = npkg + 1
    copy_dir(i, name)
    mset(i, M_VALID, 0)
    mset(i, M_LOADK, NO_LOAD)
    mset(i, M_BOUND, 0)
    mset(i, M_BANNED, 0)
    mset(i, M_LOADRC, 0)
    mset(i, M_ORIGIN, origin)
    if name_taken(name, i) {
        mset(i, M_STATUS, X_DUP)
        return
    }
    let size: u64 = load_pkg_files(state, origin, name)
    if size == X_NOFILE || size == X_SIG || size == drvinf.E_TOOBIG {
        mset(i, M_STATUS, size)
        return
    }
    let rec: u64 = rec_at(i)
    let e: u64 = drvinf.parse((&inf_buf[0]) as u64, size, name, rec)
    if e != drvinf.E_OK {
        mset(i, M_STATUS, e)
        return
    }
    if drvinf.rec_abi(rec) != ksym.ABI {
        mset(i, M_STATUS, X_ABI)
        return
    }
    if !check_module_file(state, origin, rec, name) {
        mset(i, M_STATUS, X_NOMODULE)
        return
    }
    mset(i, M_VALID, 1)
    mset(i, M_STATUS, ST_OK)
}

fn apply_deny(state: u64) {
    var f_deny: [u8; 18] = "/etc/drivers.deny\0"
    let ino: u64 = fs.path(state, (&f_deny[0]) as u64)
    if ino == 0 {
        return
    }
    var size: u64 = fs.inode_size(state, ino)
    if size == 0 {
        return
    }
    if size > 1024 {
        size = 1024
    }
    if !drvfw.read_all(state, ino, (&deny_buf[0]) as u64, size) {
        return
    }
    deny_buf[size as usize] = 10 as u8
    var at: u64 = 0
    while at < size {
        var end: u64 = at
        while end < size && deny_buf[end as usize] != 10 as u8 {
            end = end + 1
        }
        if end > at && end - at < 24 {
            var nm: [u8; 24] = [0 as u8; 24]
            var k: u64 = 0
            while k < end - at {
                nm[k as usize] = deny_buf[(at + k) as usize]
                k = k + 1
            }
            var p: u64 = 0
            while p < npkg {
                if drvinf.text_eq(pkg_name(p), (&nm[0]) as u64) {
                    mset(p, M_BANNED, 1)
                }
                p = p + 1
            }
        }
        at = end + 1
    }
}

fn dir_scan(state: u64, dir: u64, origin: u64) {
    var i: u64 = 0
    var going: bool = true
    while going {
        let ino: u64 = fs.entry_at(state, dir, i, (&ent_buf[0]) as u64)
        if ino == 0 {
            going = false
        } else {
            if ent_buf[8] != 46 as u8 {
                scan_one(state, origin, ((&ent_buf[0]) as u64) + 8)
            }
            i = i + 1
        }
    }
}

fn has_osp_suffix(name: u64) -> bool {
    var n: u64 = 0
    while kstate.get8(name + n) != 0 {
        n = n + 1
    }
    return n >= 5 && n < APP_BYTES && kstate.get8(name + n - 4) == 46 && kstate.get8(name + n - 3) == 111
        && kstate.get8(name + n - 2) == 115 && kstate.get8(name + n - 1) == 112
}

fn collect_apps(state: u64) {
    var d: [u8; 6] = "/apps\0"
    let dir: u64 = fs.path(state, (&d[0]) as u64)
    napps = 0
    if dir == 0 {
        return
    }
    var i: u64 = 0
    var going: bool = true
    while going {
        let ino: u64 = fs.entry_at(state, dir, i, (&ent_buf[0]) as u64)
        if ino == 0 {
            going = false
        } else {
            let nm: u64 = ((&ent_buf[0]) as u64) + 8
            if napps < MAXAPP && has_osp_suffix(nm) {
                var k: u64 = 0
                while kstate.get8(nm + k) != 0 {
                    app_names[(napps * APP_BYTES + k) as usize] = kstate.get8(nm + k) as u8
                    k = k + 1
                }
                app_names[(napps * APP_BYTES + k) as usize] = 0 as u8
                napps = napps + 1
            }
            i = i + 1
        }
    }
}

fn scan_apps(state: u64) {
    var a: u64 = 0
    while a < napps {
        var root: [u8; 7] = "/apps/\0"
        var lib: [u8; 5] = "/lib\0"
        var n: u64 = path_put(0, (&root[0]) as u64, 20)
        n = path_put(n, app_name(a), 50)
        n = path_put(n, (&lib[0]) as u64, 60)
        path_buf[n as usize] = 0 as u8
        let dir: u64 = fs.path(state, (&path_buf[0]) as u64)
        if dir != 0 {
            dir_scan(state, dir, a + 1)
        }
        a = a + 1
    }
}

fn scan(state: u64) {
    var d: [u8; 13] = "/lib/drivers\0"
    let dir: u64 = fs.path(state, (&d[0]) as u64)
    if dir != 0 {
        dir_scan(state, dir, 0)
    }
    collect_apps(state)
    scan_apps(state)
    apply_deny(state)
}

fn pci_sub(state: u64, idx: u64) -> u64 {
    if (pci.get(state, idx, pci.E_HDR) & 0x7F) != 0 {
        return drvinf.NO_SUB
    }
    let v: u64 = pci.cfg_read32(pci.get(state, idx, pci.E_BDF), 0x2C)
    return ((v & 0xFFFF) << 16) | ((v >> 16) & 0xFFFF)
}

fn match_score(state: u64, rec: u64, m: u64, idx: u64) -> u64 {
    let k: u64 = drvinf.rec_kind(rec, m)
    let a: u64 = drvinf.rec_a(rec, m)
    let b: u64 = drvinf.rec_b(rec, m)
    if k == drvinf.K_PCI {
        let have: u64 = (pci.get(state, idx, pci.E_VENDOR) << 16) | pci.get(state, idx, pci.E_DEVICE)
        if have != a {
            return 0
        }
        if b != drvinf.NO_SUB && b != pci_sub(state, idx) {
            return 0
        }
        return drvinf.spec_of(rec, m)
    }
    if k == drvinf.K_PCICLASS {
        let cls: u64 = (pci.get(state, idx, pci.E_CLASS) << 8) | pci.get(state, idx, pci.E_SUBCLASS)
        if cls != a {
            return 0
        }
        if b != drvinf.NO_PROG && b != pci.get(state, idx, pci.E_PROGIF) {
            return 0
        }
        return drvinf.spec_of(rec, m)
    }
    return 0
}

fn better(spec: u64, rank: u64, ver: u64, bspec: u64, brank: u64, bver: u64) -> bool {
    if spec != bspec {
        return spec > bspec
    }
    if rank != brank {
        return rank > brank
    }
    return ver > bver
}

fn best_pci(state: u64, idx: u64) -> u64 {
    var best: u64 = NONE
    var bspec: u64 = 0
    var brank: u64 = 0
    var bver: u64 = 0
    var p: u64 = 0
    while p < npkg {
        if mf(p, M_VALID) == 1 && mf(p, M_BANNED) == 0 {
            let rec: u64 = rec_at(p)
            var m: u64 = 0
            var top: u64 = 0
            while m < drvinf.rec_nmatch(rec) {
                let s: u64 = match_score(state, rec, m, idx)
                if s > top {
                    top = s
                }
                m = m + 1
            }
            if top > 0 && (best == NONE || better(top, drvinf.rec_rank(rec), drvinf.rec_version(rec), bspec, brank, bver)) {
                best = p
                bspec = top
                brank = drvinf.rec_rank(rec)
                bver = drvinf.rec_version(rec)
            }
        }
        p = p + 1
    }
    return best
}

fn best_simple(kind: u64, a: u64) -> u64 {
    var best: u64 = NONE
    var brank: u64 = 0
    var bver: u64 = 0
    var p: u64 = 0
    while p < npkg {
        if mf(p, M_VALID) == 1 && mf(p, M_BANNED) == 0 {
            let rec: u64 = rec_at(p)
            var m: u64 = 0
            var hit: bool = false
            while m < drvinf.rec_nmatch(rec) {
                if drvinf.rec_kind(rec, m) == kind && drvinf.rec_a(rec, m) == a {
                    hit = true
                }
                m = m + 1
            }
            if hit && (best == NONE || better(4, drvinf.rec_rank(rec), drvinf.rec_version(rec), 4, brank, bver)) {
                best = p
                brank = drvinf.rec_rank(rec)
                bver = drvinf.rec_version(rec)
            }
        }
        p = p + 1
    }
    return best
}

fn best_usb(vid: u64, pid: u64) -> u64 {
    return best_simple(drvinf.K_USB, (vid << 16) | pid)
}

fn best_acpi(packed: u64) -> u64 {
    return best_simple(drvinf.K_ACPI, packed)
}

fn write_ctx(state: u64, idx: u64, map_mmio: bool) {
    let c: u64 = state + kstate.MODULE_OFF + CTX_OFF
    kstate.set(c, 0, 1)
    kstate.set(c, 8, 1)
    kstate.set(c, 16, pci.get(state, idx, pci.E_VENDOR))
    kstate.set(c, 24, pci.get(state, idx, pci.E_DEVICE))
    kstate.set(c, 32, pci_sub(state, idx))
    kstate.set(c, 40, (pci.get(state, idx, pci.E_CLASS) << 8) | pci.get(state, idx, pci.E_SUBCLASS))
    kstate.set(c, 48, pci.get(state, idx, pci.E_PROGIF))
    kstate.set(c, 56, pci.get(state, idx, pci.E_BDF))
    let phys: u64 = pci.bar(state, idx, 0)
    kstate.set(c, 88, phys)
    var mapped: u64 = 0
    if map_mmio && phys != 0 && !pci.bar_is_io(state, idx, 0) {
        mapped = apic.map_device(state, phys)
    }
    kstate.set(c, 64, mapped)
    kstate.set(c, 72, pci.get(state, idx, pci.E_IRQLINE))
    kstate.set(c, 80, idx)
}

fn slot_of(rec: u64) -> u64 {
    let v: u64 = drvinf.rec_slot(rec)
    if v == 1 {
        return modidx.SLOT_MOUSE
    }
    if v == 2 {
        return modidx.SLOT_AUX
    }
    return modidx.MAX_SLOT
}

fn slot_owner(slot: u64) -> u64 {
    var p: u64 = 0
    while p < npkg {
        if mf(p, M_VALID) == 1 && mf(p, M_LOADK) != NO_LOAD && slot_of(rec_at(p)) == slot {
            return pkg_name(p)
        }
        p = p + 1
    }
    return 0
}

fn bind_pci(state: u64, p: u64, idx: u64) {
    var s_pre: [u8; 16] = "drvstore: bind \0"
    var s_arrow: [u8; 5] = " -> \0"
    var s_ok: [u8; 3] = "ok\0"
    var s_fail: [u8; 7] = "fail: \0"
    var s_busy: [u8; 10] = "slot busy\0"
    let bdf: u64 = pci.get(state, idx, pci.E_BDF)
    let wants_mmio: bool = (drvinf.rec_rights(rec_at(p)) & 2) != 0
    if wants_mmio {
        pci.cfg_write16(bdf, 4, pci.cfg_read16(bdf, 4) | 2)
    }
    write_ctx(state, idx, wants_mmio)
    drvfw.set_context(state, rec_at(p))
    var rc: u64 = 0
    var res: u64 = BR_BOUND
    let k: u64 = mf(p, M_LOADK)
    if k == NO_LOAD {
        pkg_path(mf(p, M_ORIGIN), pkg_dir(p), drvinf.rec_module(rec_at(p)))
        let slot: u64 = slot_of(rec_at(p))
        if slot < modidx.MAX_SLOT && modtab.have(state, slot) {
            rc = X_SLOTBUSY
            res = BR_FAILED
            mset(p, M_LOADRC, rc)
        } else {
            rc = module.load(state, (&path_buf[0]) as u64, slot)
            if rc == module.R_OK {
                mset(p, M_LOADK, module.last_placed(state))
            } else {
                res = BR_FAILED
                mset(p, M_LOADRC, rc)
            }
        }
    } else {
        modtab.allow(state, slot_of(rec_at(p)))
        rc = module.ruf1(module.entry_of(state, k), state)
        modtab.allow_all(state)
        if rc != 0 {
            res = BR_FAILED
        }
    }
    drvfw.clear_context()
    serial.puts((&s_pre[0]) as u64)
    serial.puts(pkg_name(p))
    serial.puts((&s_arrow[0]) as u64)
    pci.hexn(pci.bdf_bus(bdf), 2)
    serial.put(58 as u8)
    pci.hexn(pci.bdf_dev(bdf), 2)
    serial.put(46 as u8)
    pci.hexn(pci.bdf_fn(bdf), 1)
    serial.put(32 as u8)
    pci.hexn(pci.get(state, idx, pci.E_VENDOR), 4)
    serial.put(58 as u8)
    pci.hexn(pci.get(state, idx, pci.E_DEVICE), 4)
    serial.put(32 as u8)
    if res == BR_BOUND {
        serial.puts((&s_ok[0]) as u64)
        mset(p, M_BOUND, mf(p, M_BOUND) + 1)
        module.ref(state, mf(p, M_LOADK))
        if kstate.mode_on(state, kstate.M_DRVHOLD) {
            module.ref(state, mf(p, M_LOADK))
        }
    } else {
        serial.puts((&s_fail[0]) as u64)
        if rc == X_SLOTBUSY {
            serial.puts((&s_busy[0]) as u64)
        } else if mf(p, M_LOADK) == NO_LOAD {
            module.say_reason(rc)
        } else {
            serial.dec(rc)
        }
    }
    serial.nl()
    add_bind(1, idx, p, res, rc)
}

fn bind_all(state: u64) {
    var i: u64 = 0
    let total: u64 = pci.count(state)
    while i < total {
        if !drvreg.claimed(state, i) {
            let p: u64 = best_pci(state, i)
            if p != NONE {
                bind_pci(state, p, i)
            }
        }
        i = i + 1
    }
}

fn report(state: u64) {
    var s_head: [u8; 16] = "drvstore: pkgs=\0"
    var s_valid: [u8; 8] = " valid=\0"
    var s_pkg: [u8; 15] = "drvstore: pkg \0"
    var s_ok: [u8; 3] = "ok\0"
    var s_bad: [u8; 10] = "rejected \0"
    var s_ban: [u8; 8] = " banned\0"
    var s_app: [u8; 6] = " app=\0"
    var s_sum: [u8; 17] = "drvstore: bound=\0"
    var s_fl: [u8; 9] = " failed=\0"
    var valid: u64 = 0
    var p: u64 = 0
    while p < npkg {
        if mf(p, M_VALID) == 1 {
            valid = valid + 1
        }
        p = p + 1
    }
    serial.puts((&s_head[0]) as u64)
    serial.dec(npkg)
    serial.puts((&s_valid[0]) as u64)
    serial.dec(valid)
    serial.nl()
    p = 0
    while p < npkg {
        serial.puts((&s_pkg[0]) as u64)
        serial.puts(pkg_name(p))
        serial.put(32 as u8)
        if mf(p, M_VALID) == 1 {
            serial.puts((&s_ok[0]) as u64)
            if mf(p, M_BANNED) != 0 {
                serial.puts((&s_ban[0]) as u64)
            }
        } else {
            serial.puts((&s_bad[0]) as u64)
            serial.dec(mf(p, M_STATUS))
        }
        if mf(p, M_ORIGIN) != 0 {
            serial.puts((&s_app[0]) as u64)
            serial.puts(pkg_app(p))
        }
        serial.nl()
        p = p + 1
    }
    serial.puts((&s_sum[0]) as u64)
    serial.dec(n_bound)
    serial.puts((&s_fl[0]) as u64)
    serial.dec(n_failed)
    serial.nl()
}

fn last_refs() -> u64 {
    return held_refs
}

fn same_name(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while kstate.get8(a + i) == kstate.get8(b + i) {
        if kstate.get8(a + i) == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn find_pkg(name: u64) -> u64 {
    var p: u64 = 0
    while p < npkg {
        if mf(p, M_VALID) == 1 && same_name(drvinf.rec_name(rec_at(p)), name) {
            return p
        }
        p = p + 1
    }
    return NONE
}

fn release_binds(p: u64) {
    var i: u64 = 0
    while i < nbind {
        if bf(i, B_PKG) == p && bf(i, B_RESULT) == BR_BOUND {
            binds[(i * B_FIELDS + B_RESULT) as usize] = BR_RELEASED
            if n_bound > 0 {
                n_bound = n_bound - 1
            }
        }
        i = i + 1
    }
}

fn last_loaded() -> u64 {
    return loaded_now
}

fn load_pkg(state: u64, name: u64) -> u64 {
    let p: u64 = find_pkg(name)
    loaded_now = 0
    if p == NONE {
        return UL_NONE
    }
    if mf(p, M_BANNED) != 0 {
        return UL_NONE
    }
    if mf(p, M_LOADK) != NO_LOAD && mf(p, M_BOUND) > 0 {
        return UL_LOADED
    }
    var i: u64 = 0
    let total: u64 = pci.count(state)
    while i < total {
        if !drvreg.claimed(state, i) && best_pci(state, i) == p {
            let b: u64 = find_bind(1, i)
            if b == NONE || bf(b, B_RESULT) != BR_BOUND {
                bind_pci(state, p, i)
                loaded_now = loaded_now + 1
            }
        }
        i = i + 1
    }
    if loaded_now == 0 {
        return UL_NODEV
    }
    return UL_OK
}

fn unload_pkg(state: u64, name: u64) -> u64 {
    let p: u64 = find_pkg(name)
    if p == NONE {
        return UL_NONE
    }
    let k: u64 = mf(p, M_LOADK)
    if k == NO_LOAD {
        return UL_IDLE
    }
    let own: u64 = mf(p, M_BOUND)
    held_refs = module.refs_of(state, k)
    if held_refs > own {
        return UL_BUSY
    }
    var n: u64 = own
    while n > 0 {
        module.unref(state, k)
        n = n - 1
    }
    if !module.entladen(state, k) {
        held_refs = module.refs_of(state, k)
        n = own
        while n > 0 {
            module.ref(state, k)
            n = n - 1
        }
        return UL_BUSY
    }
    release_binds(p)
    mset(p, M_LOADK, NO_LOAD)
    mset(p, M_BOUND, 0)
    return UL_OK
}

fn unload_test(state: u64) {
    var s_pre: [u8; 17] = "drvstore: unload\0"
    var s_busy: [u8; 15] = " refused refs=\0"
    var s_ok: [u8; 4] = " ok\0"
    var s_gone: [u8; 6] = " gone\0"
    var p: u64 = 0
    while p < npkg {
        let k: u64 = mf(p, M_LOADK)
        if mf(p, M_VALID) == 1 && k != NO_LOAD {
            serial.puts((&s_pre[0]) as u64)
            serial.put(32 as u8)
            serial.puts(pkg_name(p))
            if module.entladen(state, k) {
                serial.puts((&s_gone[0]) as u64)
                serial.nl()
            } else {
                serial.puts((&s_busy[0]) as u64)
                serial.dec(module.refs_of(state, k))
                serial.nl()
                var n: u64 = mf(p, M_BOUND)
                while n > 0 {
                    module.unref(state, k)
                    n = n - 1
                }
                serial.puts((&s_pre[0]) as u64)
                serial.put(32 as u8)
                serial.puts(pkg_name(p))
                if module.entladen(state, k) {
                    serial.puts((&s_ok[0]) as u64)
                    mset(p, M_LOADK, NO_LOAD)
                    mset(p, M_BOUND, 0)
                } else {
                    serial.puts((&s_busy[0]) as u64)
                    serial.dec(module.refs_of(state, k))
                }
                serial.nl()
            }
        }
        p = p + 1
    }
}

fn init(state: u64) {
    on = 1
    npkg = 0
    nbind = 0
    n_bound = 0
    n_failed = 0
    if !module.ready(state) {
        module.init(state)
    }
    scan(state)
    bind_all(state)
    report(state)
}
