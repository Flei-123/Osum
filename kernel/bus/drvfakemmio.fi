profile kernel

import mm.mmframe
import drv.net.iwl_fake

export { region, rd, wr }

const SRAM_FRAMES: u64 = 2048
const BUS_WINDOW_BASE: u64 = 0
const BUS_WINDOW_SIZE: u64 = 0x100000000000
const REG_MASK: u64 = 0xFFFFFFFF
const READ_ABSENT: u64 = 0xFFFFFFFF

static mut region_addr: u64 = 0
static mut attempted: u64 = 0

fn region(state: u64) -> u64 {
    if attempted != 0 {
        return region_addr
    }
    attempted = 1
    let regs: u64 = mmframe.frame_run(state, iwl_fake.FAKE_PAGES)
    let sram: u64 = mmframe.frame_run(state, SRAM_FRAMES)
    if regs == 0 || sram == 0 {
        return 0
    }
    mmframe.fill8(mmframe.kva(regs), iwl_fake.FAKE_PAGES * mmframe.FRAME_SIZE, 0)
    mmframe.fill8(mmframe.kva(sram), SRAM_FRAMES * mmframe.FRAME_SIZE, 0)
    iwl_fake.fake_init(regs, sram, iwl_fake.FAKE_NORMAL, BUS_WINDOW_BASE, BUS_WINDOW_SIZE)
    region_addr = regs
    return regs
}

fn rd(off: u64) -> u64 {
    if region_addr == 0 {
        return READ_ABSENT
    }
    return iwl_fake.fake_rd(region_addr, off) & REG_MASK
}

fn wr(off: u64, value: u64) -> u64 {
    if region_addr != 0 {
        iwl_fake.fake_wr(region_addr, off, value & REG_MASK)
    }
    return 0
}
