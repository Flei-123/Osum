
profile kernel

import lib.kstate
import serial
import sync.atomic
import sched.sched
import mm.mmframe
import sched.proc
import sched.origin

export {
    init, forget_task,
    reg, find, send, recv, sub, pub,
    seg_new, seg_map, seg_drop, seg_pages, seg_frame, seg_owner,
    seg_adopt, seg_release, seg_span,
    take, give, b, sb, bump, seq_next, err, hist_addr, 
    noti_post, noti_get, noti_peek, noti_count, noti_total, noti_len,
    noti_prio,
    noti_seen,
    stat,
    T_TEXT, T_PATH, T_HTML, T_IMAGE, T_FILES, T_ANY,
    I_SEQ, I_PID, I_UID, I_TYPES, I_LEN, I_SEG, I_FLAGS, I_PRIO, I_DATA,
    F_LAZY, F_WANTED, F_ADOPT, WANT_SHIFT, WANT_MASK,
    HIST_BYTES, ADOPT_PID, PRIMARY, DRAG, MIMES, MIME_BYTES, MIME_MAX,
    S_HISTNEXT, S_PRIMSETS, S_SEGIO, S_ADOPTED, S_FREED, S_MIMES,
    A_ANY, A_SAMEUID, A_ROOT,
    E_OK, E_FULL, E_NOENT, E_DENIED, E_INVAL, E_EMPTY, E_AGAIN,
    S_REGS, S_SENDS, S_RECVS, S_DENIED, S_PUBS, S_DELIVERS, S_DROPS,
    S_SEGS, S_SEGPAGES, S_CLIPSETS, S_CLIPGETS, S_OFFERS, S_FILLS,
    S_DRAGS, S_NOTIS, S_LOCKED, S_HISTLEN, S_SEQ,
    NAME_MAX, SVC_MAX, MSG_MAX, SEG_MAX, HIST_MAX, NOTI_MAX,
    INLINE_MAX, SEG_PAGES_MAX
}

const SCAL: u64 = 0x0000
const SVCS: u64 = 0x0100
const SVC_BYTES: u64 = 64
const SVC_MAX: u64 = 64
const SUBS: u64 = 0x1100
const SUB_BYTES: u64 = 8
const SUB_MAX: u64 = 128
const MSGS: u64 = 0x1500
const MSG_BYTES: u64 = 128
const MSG_MAX: u64 = 128
const BOXES: u64 = 0x5500
const BOX_BYTES: u64 = 32
const SEGS: u64 = 0x5900
const SEG_BYTES: u64 = 32
const SEG_MAX: u64 = 64
const HIST: u64 = 0x6100
const HIST_BYTES: u64 = 256
const HIST_MAX: u64 = 20
const DRAG: u64 = 0x7500
const NOTIS: u64 = 0x7600
const PRIMARY: u64 = 0x7E00
const MIMES: u64 = 0x7F00
const MIME_BYTES: u64 = 32
const MIME_MAX: u64 = 8
const NOTI_BYTES: u64 = 128
const NOTI_MAX: u64 = 16

const INLINE_MAX: u64 = 192
const SEG_PAGES_MAX: u64 = 512
const NAME_MAX: u64 = 16

const S_LOCK: u64 = 0x00
const S_REGS: u64 = 0x08
const S_SENDS: u64 = 0x10
const S_RECVS: u64 = 0x18
const S_DENIED: u64 = 0x20
const S_PUBS: u64 = 0x28
const S_DELIVERS: u64 = 0x30
const S_DROPS: u64 = 0x38
const S_SEGS: u64 = 0x40
const S_SEGPAGES: u64 = 0x48
const S_CLIPSETS: u64 = 0x50
const S_CLIPGETS: u64 = 0x58
const S_OFFERS: u64 = 0x60
const S_FILLS: u64 = 0x68
const S_DRAGS: u64 = 0x70
const S_NOTIS: u64 = 0x78
const S_LOCKED: u64 = 0x80
const S_SPINS: u64 = 0x88
const S_HISTLEN: u64 = 0x90
const S_HISTNEXT: u64 = 0x98
const S_SEQ: u64 = 0xA0
const S_NOTINEXT: u64 = 0xA8
const S_NOTILEN: u64 = 0xB0
const S_READY: u64 = 0xB8
const S_PRIMSETS: u64 = 0xC0
const S_SEGIO: u64 = 0xC8
const S_ADOPTED: u64 = 0xD0
const S_FREED: u64 = 0xD8
const S_MIMES: u64 = 0xE0

const D_USED: u64 = 0
const D_NAME: u64 = 8
const D_PID: u64 = 24
const D_UID: u64 = 32
const D_TASK: u64 = 40
const D_ACCESS: u64 = 48
const D_CALLS: u64 = 56

const M_NEXT: u64 = 0
const M_USED: u64 = 8
const M_PID: u64 = 16
const M_UID: u64 = 24
const M_SVC: u64 = 32
const M_KIND: u64 = 40
const M_SEG: u64 = 48
const M_LEN: u64 = 56
const M_DATA: u64 = 64

const MSG_INLINE: u64 = 64

const B_HEAD: u64 = 0
const B_TAIL: u64 = 8
const B_COUNT: u64 = 16
const B_LOST: u64 = 24

const G_USED: u64 = 0
const G_FRAME: u64 = 8
const G_PAGES: u64 = 16
const G_OWNER: u64 = 24

const I_SEQ: u64 = 0
const I_PID: u64 = 8
const I_UID: u64 = 16
const I_TYPES: u64 = 24
const I_LEN: u64 = 32
const I_SEG: u64 = 40
const I_FLAGS: u64 = 48
const I_PRIO: u64 = 56
const I_DATA: u64 = 64

const F_LAZY: u64 = 1
const F_WANTED: u64 = 2
const F_SEEN: u64 = 2
const F_ADOPT: u64 = 4
const WANT_SHIFT: u64 = 8
const WANT_MASK: u64 = 0xFF00
const ADOPT_PID: u64 = 0xFFFFFFFF

const T_TEXT: u64 = 1
const T_PATH: u64 = 2
const T_HTML: u64 = 4
const T_IMAGE: u64 = 8
const T_FILES: u64 = 16
const T_ANY: u64 = 0xFF000000FF

const A_ANY: u64 = 0
const A_SAMEUID: u64 = 1
const A_ROOT: u64 = 2

const E_OK: u64 = 0
const E_FULL: u64 = 1
const E_NOENT: u64 = 2
const E_DENIED: u64 = 3
const E_INVAL: u64 = 4
const E_EMPTY: u64 = 5
const E_AGAIN: u64 = 6

fn b(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.BUS_OFF + off)
}

fn sb(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.BUS_OFF + off, v)
}

fn bump(state: u64, off: u64) {
    kstate.add(state, kstate.BUS_OFF + off, 1)
}

fn svc_at(state: u64, i: u64, f: u64) -> u64 {
    return b(state, SVCS + i * SVC_BYTES + f)
}

fn svc_set(state: u64, i: u64, f: u64, v: u64) {
    sb(state, SVCS + i * SVC_BYTES + f, v)
}

fn msg_at(state: u64, i: u64, f: u64) -> u64 {
    return b(state, MSGS + i * MSG_BYTES + f)
}

fn msg_set(state: u64, i: u64, f: u64, v: u64) {
    sb(state, MSGS + i * MSG_BYTES + f, v)
}

fn box_at(state: u64, t: u64, f: u64) -> u64 {
    return b(state, BOXES + t * BOX_BYTES + f)
}

fn box_set(state: u64, t: u64, f: u64, v: u64) {
    sb(state, BOXES + t * BOX_BYTES + f, v)
}

fn seg_at(state: u64, i: u64, f: u64) -> u64 {
    return b(state, SEGS + i * SEG_BYTES + f)
}

fn seg_set(state: u64, i: u64, f: u64, v: u64) {
    sb(state, SEGS + i * SEG_BYTES + f, v)
}

fn hist_addr(state: u64, i: u64) -> u64 {
    return state + kstate.BUS_OFF + HIST + i * HIST_BYTES
}

fn take(state: u64) {
    let a: u64 = state + kstate.BUS_OFF + S_LOCK
    var spins: u64 = 0
    while atomic.cas(a, 0, 1) != 0 {
        atomic.pause()
        spins = spins + 1
        if spins > 200000000 {
            say_stuck(state)
            return
        }
    }
    bump(state, S_LOCKED)
    if spins > 0 {
        kstate.add(state, kstate.BUS_OFF + S_SPINS, spins)
    }
}

fn give(state: u64) {
    atomic.store(state + kstate.BUS_OFF + S_LOCK, 0)
}

fn say_stuck(state: u64) {
    var s: [u8; 20] = "bus: Sperre haengt\n\0"
    serial.puts((&s[0]) as u64)
}

fn init(state: u64) {
    var i: u64 = 0
    while i < SVC_MAX {
        svc_set(state, i, D_USED, 0)
        i = i + 1
    }
    i = 0
    while i < MSG_MAX {
        msg_set(state, i, M_USED, 0)
        msg_set(state, i, M_NEXT, 0)
        i = i + 1
    }
    i = 0
    while i < kstate.MAX_TASKS {
        box_set(state, i, B_HEAD, 0)
        box_set(state, i, B_TAIL, 0)
        box_set(state, i, B_COUNT, 0)
        box_set(state, i, B_LOST, 0)
        i = i + 1
    }
    i = 0
    while i < SEG_MAX {
        seg_set(state, i, G_USED, 0)
        i = i + 1
    }
    i = 0
    while i < SUB_MAX {
        sb(state, SUBS + i * SUB_BYTES, 0)
        i = i + 1
    }
    i = 0
    while i < NOTI_MAX {
        kstate.set(state + kstate.BUS_OFF + NOTIS + i * NOTI_BYTES, I_SEQ, 0)
        i = i + 1
    }
    sb(state, S_LOCK, 0)
    sb(state, S_SEQ, 1)
    sb(state, S_NOTINEXT, 0)
    sb(state, S_NOTILEN, 0)
    sb(state, S_READY, 1)
    var s: [u8; 34] = "bus: 64 Dienste, 128 Nachrichten\n\0"
    serial.puts((&s[0]) as u64)
}

fn seq_next(state: u64) -> u64 {
    return kstate.add(state, kstate.BUS_OFF + S_SEQ, 1)
}

fn name_word(p: u64, off: u64, n: u64) -> u64 {
    var w: u64 = 0
    var k: u64 = 0
    while k < 8 {
        var c: u64 = 0
        if off + k < n {
            c = kstate.get8(p + off + k)
        }
        w = w | (c << (k * 8))
        k = k + 1
    }
    return w
}

fn name_out(w: u64, p: u64) {
    var k: u64 = 0
    while k < 8 {
        kstate.set8(p + k, ((w >> (k * 8)) & 0xFF) as u8)
        k = k + 1
    }
}

fn reg(state: u64, task: u64, w0: u64, w1: u64, access: u64) -> u64 {
    if access > A_ROOT {
        return err(E_INVAL)
    }
    if !name_ok(state, task, w0, w1) {
        say_reserved(state, task, w0, w1)
        return err(E_DENIED)
    }
    take(state)
    var i: u64 = 0
    while i < SVC_MAX {
        if svc_at(state, i, D_USED) != 0
            && svc_at(state, i, D_NAME) == w0
            && svc_at(state, i, D_NAME + 8) == w1 {
            give(state)
            return err(E_FULL)
        }
        i = i + 1
    }
    i = 0
    while i < SVC_MAX {
        if svc_at(state, i, D_USED) == 0 {
            svc_set(state, i, D_USED, 1)
            svc_set(state, i, D_NAME, w0)
            svc_set(state, i, D_NAME + 8, w1)
            svc_set(state, i, D_PID, sched.tget(state, task, sched.T_PID))
            svc_set(state, i, D_UID, sched.tget(state, task, sched.T_UID))
            svc_set(state, i, D_TASK, task)
            svc_set(state, i, D_ACCESS, access)
            svc_set(state, i, D_CALLS, 0)
            bump(state, S_REGS)
            give(state)
            return i
        }
        i = i + 1
    }
    give(state)
    return err(E_FULL)
}

fn name_byte(w0: u64, w1: u64, i: u64) -> u64 {
    if i < 8 {
        return (w0 >> (i * 8)) & 0xFF
    }
    if i < 16 {
        return (w1 >> ((i - 8) * 8)) & 0xFF
    }
    return 0
}

fn name_ok(state: u64, task: u64, w0: u64, w1: u64) -> bool {
    let b0: u64 = name_byte(w0, w1, 0)
    let b1: u64 = name_byte(w0, w1, 1)
    if b0 == 97 && b1 == 46 {
        var nb: [u8; 17] = [0 as u8; 17]
        var n: u64 = 0
        var going: bool = true
        while going && n < 14 {
            let c: u64 = name_byte(w0, w1, 2 + n)
            if c == 0 {
                going = false
            } else {
                nb[n as usize] = c as u8
                n = n + 1
            }
        }
        return origin.same_app(state, task, (&nb[0 as usize]) as u64, n)
    }
    if b0 == 111 && b1 == 114 && name_byte(w0, w1, 2) == 105
        && name_byte(w0, w1, 3) == 101 && name_byte(w0, w1, 4) == 110
        && name_byte(w0, w1, 5) == 116 && name_byte(w0, w1, 6) == 46 {
        return origin.is_empty(state, task)
            && sched.tget(state, task, sched.T_EUID) == 0
    }
    if b0 == 114 && b1 == 46 {
        var v: u64 = 0
        var i: u64 = 2
        var digits: u64 = 0
        var going2: bool = true
        while going2 && i < 16 {
            let c: u64 = name_byte(w0, w1, i)
            if c >= 48 && c <= 57 {
                v = v * 10 + (c - 48)
                digits = digits + 1
                i = i + 1
            } else {
                going2 = false
            }
        }
        if digits == 0 || name_byte(w0, w1, i) != 0 {
            return true
        }
        return v == sched.tget(state, task, sched.T_PID)
    }
    return true
}

fn say_reserved(state: u64, task: u64, w0: u64, w1: u64) {
    var s1: [u8; 22] = "bus: reserved name \"\0\0"
    var s2: [u8; 11] = "\" refused \0"
    var s3: [u8; 5] = "pid=\0"
    serial.puts((&s1[0]) as u64)
    var i: u64 = 0
    while i < 16 && name_byte(w0, w1, i) != 0 {
        serial.put(name_byte(w0, w1, i) as u8)
        i = i + 1
    }
    serial.puts((&s2[0]) as u64)
    serial.puts((&s3[0]) as u64)
    serial.dec(sched.tget(state, task, sched.T_PID))
    serial.nl()
}

fn find(state: u64, w0: u64, w1: u64) -> u64 {
    take(state)
    var i: u64 = 0
    while i < SVC_MAX {
        if svc_at(state, i, D_USED) != 0
            && svc_at(state, i, D_NAME) == w0
            && svc_at(state, i, D_NAME + 8) == w1 {
            give(state)
            return i
        }
        i = i + 1
    }
    give(state)
    return err(E_NOENT)
}

fn err(e: u64) -> u64 {
    return 0 -% e
}

fn may_call(state: u64, svc: u64, uid: u64) -> bool {
    let a: u64 = svc_at(state, svc, D_ACCESS)
    if a == A_ANY {
        return true
    }
    if uid == 0 {
        return true
    }
    if a == A_SAMEUID {
        return uid == svc_at(state, svc, D_UID)
    }
    return false
}

fn say_denied(state: u64, svc: u64, pid: u64, uid: u64) {
    var s1: [u8; 23] = "bus: ABGELEHNT dienst=\0"
    var s2: [u8; 6] = " pid=\0"
    var s3: [u8; 6] = " uid=\0"
    var s4: [u8; 9] = " regel=\0\0"
    serial.puts((&s1[0]) as u64)
    serial.dec(svc)
    serial.puts((&s2[0]) as u64)
    serial.dec(pid)
    serial.puts((&s3[0]) as u64)
    serial.dec(uid)
    serial.puts((&s4[0]) as u64)
    serial.dec(svc_at(state, svc, D_ACCESS))
    serial.nl()
}

fn slot_free(state: u64) -> u64 {
    var i: u64 = 0
    while i < MSG_MAX {
        if msg_at(state, i, M_USED) == 0 {
            return i
        }
        i = i + 1
    }
    return MSG_MAX
}

fn queue_put(state: u64, task: u64, m: u64) {
    let tail: u64 = box_at(state, task, B_TAIL)
    msg_set(state, m, M_NEXT, 0)
    if box_at(state, task, B_COUNT) == 0 {
        box_set(state, task, B_HEAD, m)
    } else {
        msg_set(state, tail, M_NEXT, m + 1)
    }
    box_set(state, task, B_TAIL, m)
    box_set(state, task, B_COUNT, box_at(state, task, B_COUNT) + 1)
    bump(state, S_DELIVERS)
    sched.poll_kick_one(state, task)
}

fn deliver(state: u64, task: u64, from_pid: u64, from_uid: u64, svc: u64,
    kind: u64, seg: u64, len: u64, data: u64) -> u64 {
    let m: u64 = slot_free(state)
    if m >= MSG_MAX {
        box_set(state, task, B_LOST, box_at(state, task, B_LOST) + 1)
        bump(state, S_DROPS)
        return err(E_FULL)
    }
    msg_set(state, m, M_USED, 1)
    msg_set(state, m, M_PID, from_pid)
    msg_set(state, m, M_UID, from_uid)
    msg_set(state, m, M_SVC, svc)
    msg_set(state, m, M_KIND, kind)
    msg_set(state, m, M_SEG, seg)
    msg_set(state, m, M_LEN, len)
    var k: u64 = 0
    let dst: u64 = state + kstate.BUS_OFF + MSGS + m * MSG_BYTES + M_DATA
    while k < MSG_INLINE {
        var c: u64 = 0
        if k < len && data != 0 {
            c = kstate.get8(data + k)
        }
        kstate.set8(dst + k, c as u8)
        k = k + 1
    }
    queue_put(state, task, m)
    return E_OK
}

fn send(state: u64, task: u64, svc: u64, seg: u64, len: u64,
    data: u64) -> u64 {
    if svc >= SVC_MAX {
        return err(E_INVAL)
    }
    let pid: u64 = sched.tget(state, task, sched.T_PID)
    let uid: u64 = sched.tget(state, task, sched.T_UID)
    take(state)
    if svc_at(state, svc, D_USED) == 0 {
        give(state)
        return err(E_NOENT)
    }
    if !may_call(state, svc, uid) {
        bump(state, S_DENIED)
        say_denied(state, svc, pid, uid)
        give(state)
        return err(E_DENIED)
    }
    let to: u64 = svc_at(state, svc, D_TASK)
    if sched.tget(state, to, sched.T_PID) != svc_at(state, svc, D_PID) {
        svc_set(state, svc, D_USED, 0)
        give(state)
        return err(E_NOENT)
    }
    svc_set(state, svc, D_CALLS, svc_at(state, svc, D_CALLS) + 1)
    let r: u64 = deliver(state, to, pid, uid, svc, 1, seg, len, data)
    bump(state, S_SENDS)
    give(state)
    return r
}

fn recv(state: u64, task: u64, out: u64, max: u64, meta: u64) -> u64 {
    take(state)
    if box_at(state, task, B_COUNT) == 0 {
        give(state)
        return err(E_EMPTY)
    }
    let m: u64 = box_at(state, task, B_HEAD)
    let nx: u64 = msg_at(state, m, M_NEXT)
    if nx == 0 {
        box_set(state, task, B_HEAD, 0)
        box_set(state, task, B_TAIL, 0)
    } else {
        box_set(state, task, B_HEAD, nx - 1)
    }
    box_set(state, task, B_COUNT, box_at(state, task, B_COUNT) - 1)
    var len: u64 = msg_at(state, m, M_LEN)
    if meta != 0 {
        kstate.set(meta, 0, msg_at(state, m, M_PID))
        kstate.set(meta, 8, msg_at(state, m, M_UID))
        kstate.set(meta, 16, msg_at(state, m, M_SVC))
        kstate.set(meta, 24, msg_at(state, m, M_KIND))
        kstate.set(meta, 32, msg_at(state, m, M_SEG))
        kstate.set(meta, 40, len)
    }
    var n: u64 = len
    if n > max {
        n = max
    }
    if n > MSG_INLINE {
        n = MSG_INLINE
    }
    let src: u64 = state + kstate.BUS_OFF + MSGS + m * MSG_BYTES + M_DATA
    var k: u64 = 0
    while k < n {
        kstate.set8(out + k, kstate.get8(src + k) as u8)
        k = k + 1
    }
    msg_set(state, m, M_USED, 0)
    bump(state, S_RECVS)
    give(state)
    return n
}

fn sub_pack(svc: u64, task: u64, pid: u64) -> u64 {
    return 1 | (svc << 8) | (task << 16) | (pid << 24)
}

fn sub(state: u64, task: u64, svc: u64) -> u64 {
    if svc >= SVC_MAX {
        return err(E_INVAL)
    }
    let pid: u64 = sched.tget(state, task, sched.T_PID)
    take(state)
    var i: u64 = 0
    while i < SUB_MAX {
        let w: u64 = b(state, SUBS + i * SUB_BYTES)
        if w == 0 {
            sb(state, SUBS + i * SUB_BYTES, sub_pack(svc, task, pid))
            give(state)
            return E_OK
        }
        if ((w >> 8) & 0xFF) == svc && ((w >> 16) & 0xFF) == task {
            give(state)
            return E_OK
        }
        i = i + 1
    }
    give(state)
    return err(E_FULL)
}

fn pub(state: u64, task: u64, svc: u64, len: u64, data: u64) -> u64 {
    if svc >= SVC_MAX {
        return err(E_INVAL)
    }
    let pid: u64 = sched.tget(state, task, sched.T_PID)
    let uid: u64 = sched.tget(state, task, sched.T_UID)
    take(state)
    if svc_at(state, svc, D_USED) == 0 {
        give(state)
        return err(E_NOENT)
    }
    if svc_at(state, svc, D_PID) != pid && uid != 0 {
        bump(state, S_DENIED)
        say_denied(state, svc, pid, uid)
        give(state)
        return err(E_DENIED)
    }
    var n: u64 = 0
    var i: u64 = 0
    while i < SUB_MAX {
        let w: u64 = b(state, SUBS + i * SUB_BYTES)
        if w != 0 && ((w >> 8) & 0xFF) == svc {
            let t: u64 = (w >> 16) & 0xFF
            let p: u64 = (w >> 24) & 0xFFFF
            if sched.tget(state, t, sched.T_PID) != p {
                sb(state, SUBS + i * SUB_BYTES, 0)
            } else {
                if may_call(state, svc, sched.tget(state, t, sched.T_UID)) {
                    if deliver(state, t, pid, uid, svc, 2, 0, len, data)
                        == E_OK {
                        n = n + 1
                    }
                } else {
                    bump(state, S_DENIED)
                }
            }
        }
        i = i + 1
    }
    bump(state, S_PUBS)
    give(state)
    return n
}

fn seg_new(state: u64, task: u64, pages: u64) -> u64 {
    if pages == 0 || pages > SEG_PAGES_MAX {
        return err(E_INVAL)
    }
    let frame: u64 = mmframe.frame_run(state, pages)
    if frame == 0 {
        return err(E_FULL)
    }
    take(state)
    var i: u64 = 0
    while i < SEG_MAX {
        if seg_at(state, i, G_USED) == 0 {
            seg_set(state, i, G_USED, 1)
            seg_set(state, i, G_FRAME, frame)
            seg_set(state, i, G_PAGES, pages)
            seg_set(state, i, G_OWNER, sched.tget(state, task, sched.T_PID))
            bump(state, S_SEGS)
            kstate.add(state, kstate.BUS_OFF + S_SEGPAGES, pages)
            give(state)
            return i
        }
        i = i + 1
    }
    give(state)
    mmframe.frame_free_run(state, frame, pages)
    return err(E_FULL)
}

fn seg_pages(state: u64, id: u64) -> u64 {
    if id >= SEG_MAX {
        return 0
    }
    if seg_at(state, id, G_USED) == 0 {
        return 0
    }
    return seg_at(state, id, G_PAGES)
}

fn seg_frame(state: u64, id: u64, k: u64) -> u64 {
    if id >= SEG_MAX || seg_at(state, id, G_USED) == 0 {
        return 0
    }
    if k >= seg_at(state, id, G_PAGES) {
        return 0
    }
    return seg_at(state, id, G_FRAME) + k * 4096
}

fn seg_owner(state: u64, id: u64) -> u64 {
    if id >= SEG_MAX || seg_at(state, id, G_USED) == 0 {
        return 0
    }
    return seg_at(state, id, G_OWNER)
}

fn seg_map(state: u64, task: u64, id: u64) -> u64 {
    if id >= SEG_MAX {
        return err(E_INVAL)
    }
    take(state)
    let used: u64 = seg_at(state, id, G_USED)
    give(state)
    if used == 0 {
        return err(E_NOENT)
    }
    return E_OK
}

fn seg_drop(state: u64, task: u64, id: u64) -> u64 {
    if id >= SEG_MAX {
        return err(E_INVAL)
    }
    let pid: u64 = sched.tget(state, task, sched.T_PID)
    take(state)
    if seg_at(state, id, G_USED) == 0 {
        give(state)
        return err(E_NOENT)
    }
    if seg_at(state, id, G_OWNER) != pid && sched.tget(state, task,
        sched.T_UID) != 0 {
        bump(state, S_DENIED)
        give(state)
        return err(E_DENIED)
    }
    let f: u64 = seg_at(state, id, G_FRAME)
    let n: u64 = seg_at(state, id, G_PAGES)
    seg_set(state, id, G_USED, 0)
    give(state)
    mmframe.frame_free_run(state, f, n)
    return E_OK
}

fn seg_adopt(state: u64, task: u64, id: u64) -> u64 {
    if id >= SEG_MAX {
        return err(E_INVAL)
    }
    let pid: u64 = sched.tget(state, task, sched.T_PID)
    take(state)
    if seg_at(state, id, G_USED) == 0 {
        give(state)
        return err(E_NOENT)
    }
    if seg_at(state, id, G_OWNER) != pid {
        bump(state, S_DENIED)
        give(state)
        return err(E_DENIED)
    }
    seg_set(state, id, G_OWNER, ADOPT_PID)
    bump(state, S_ADOPTED)
    give(state)
    return E_OK
}

fn seg_release(state: u64, id: u64) {
    if id >= SEG_MAX {
        return
    }
    take(state)
    if seg_at(state, id, G_USED) == 0 || seg_at(state, id, G_OWNER) != ADOPT_PID {
        give(state)
        return
    }
    let f: u64 = seg_at(state, id, G_FRAME)
    let n: u64 = seg_at(state, id, G_PAGES)
    seg_set(state, id, G_USED, 0)
    bump(state, S_FREED)
    give(state)
    mmframe.frame_free_run(state, f, n)
}

fn seg_span(state: u64, task: u64, id: u64, write: bool, off: u64, n: u64) -> u64 {
    if id >= SEG_MAX || n == 0 {
        return 0
    }
    let pid: u64 = sched.tget(state, task, sched.T_PID)
    let uid: u64 = sched.tget(state, task, sched.T_UID)
    take(state)
    if seg_at(state, id, G_USED) == 0 {
        give(state)
        return 0
    }
    let owner: u64 = seg_at(state, id, G_OWNER)
    var allowed: bool = owner == pid
    if !write && (owner == ADOPT_PID || uid == 0) {
        allowed = true
    }
    let size: u64 = seg_at(state, id, G_PAGES) * 4096
    if !allowed || off >= size || n > size - off {
        give(state)
        return 0
    }
    let base: u64 = seg_at(state, id, G_FRAME) + off
    kstate.add(state, kstate.BUS_OFF + S_SEGIO, n)
    give(state)
    return base
}

fn noti_addr(state: u64, i: u64) -> u64 {
    return state + kstate.BUS_OFF + NOTIS + i * NOTI_BYTES
}

fn noti_post(state: u64, task: u64, prio: u64, len: u64, data: u64) -> u64 {
    let pid: u64 = sched.tget(state, task, sched.T_PID)
    let uid: u64 = sched.tget(state, task, sched.T_UID)
    take(state)
    let nxt: u64 = b(state, S_NOTINEXT)
    let a: u64 = noti_addr(state, nxt)
    var l: u64 = len
    if l > NOTI_BYTES - I_DATA {
        l = NOTI_BYTES - I_DATA
    }
    kstate.set(a, I_SEQ, seq_next(state))
    kstate.set(a, I_PID, pid)
    kstate.set(a, I_UID, uid)
    kstate.set(a, I_TYPES, T_TEXT)
    kstate.set(a, I_LEN, l)
    kstate.set(a, I_SEG, 0)
    kstate.set(a, I_FLAGS, 0)
    kstate.set(a, I_PRIO, prio)
    var k: u64 = 0
    while k < NOTI_BYTES - I_DATA {
        var c: u64 = 0
        if k < l && data != 0 {
            c = kstate.get8(data + k)
        }
        kstate.set8(a + I_DATA + k, c as u8)
        k = k + 1
    }
    sb(state, S_NOTINEXT, (nxt + 1) % NOTI_MAX)
    if b(state, S_NOTILEN) < NOTI_MAX {
        sb(state, S_NOTILEN, b(state, S_NOTILEN) + 1)
    }
    bump(state, S_NOTIS)
    give(state)
    return E_OK
}

fn noti_idx(state: u64, back: u64) -> u64 {
    let len: u64 = b(state, S_NOTILEN)
    if back >= len {
        return NOTI_MAX
    }
    return (b(state, S_NOTINEXT) + NOTI_MAX - 1 - back) % NOTI_MAX
}

fn noti_get(state: u64, back: u64, out: u64, max: u64) -> u64 {
    take(state)
    let i: u64 = noti_idx(state, back)
    if i >= NOTI_MAX {
        give(state)
        return err(E_EMPTY)
    }
    let a: u64 = noti_addr(state, i)
    var n: u64 = kstate.get(a, I_LEN)
    if n > max {
        n = max
    }
    var k: u64 = 0
    while k < n {
        kstate.set8(out + k, kstate.get8(a + I_DATA + k) as u8)
        k = k + 1
    }
    kstate.set(a, I_FLAGS, kstate.get(a, I_FLAGS) | F_SEEN)
    give(state)
    return n
}

fn noti_peek(state: u64, back: u64, out: u64, max: u64) -> u64 {
    take(state)
    let i: u64 = noti_idx(state, back)
    if i >= NOTI_MAX {
        give(state)
        return err(E_EMPTY)
    }
    let a: u64 = noti_addr(state, i)
    var n: u64 = kstate.get(a, I_LEN)
    if n > max {
        n = max
    }
    var k: u64 = 0
    while k < n {
        kstate.set8(out + k, kstate.get8(a + I_DATA + k) as u8)
        k = k + 1
    }
    give(state)
    return n
}

fn noti_count(state: u64) -> u64 {
    return b(state, S_NOTILEN)
}

fn noti_total(state: u64) -> u64 {
    return b(state, S_NOTIS)
}

fn noti_len(state: u64, back: u64) -> u64 {
    let i: u64 = noti_idx(state, back)
    if i >= NOTI_MAX {
        return 0
    }
    return kstate.get(noti_addr(state, i), I_LEN)
}

fn noti_prio(state: u64, back: u64) -> u64 {
    let i: u64 = noti_idx(state, back)
    if i >= NOTI_MAX {
        return 0
    }
    return kstate.get(noti_addr(state, i), I_PRIO)
}

fn noti_seen(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < NOTI_MAX {
        let a: u64 = noti_addr(state, i)
        if kstate.get(a, I_SEQ) != 0 && (kstate.get(a, I_FLAGS) & F_SEEN) == 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn forget_task(state: u64, task: u64, pid: u64) {
    take(state)
    var i: u64 = 0
    while i < SVC_MAX {
        if svc_at(state, i, D_USED) != 0 && svc_at(state, i, D_PID) == pid {
            svc_set(state, i, D_USED, 0)
        }
        i = i + 1
    }
    i = 0
    while i < SUB_MAX {
        let w: u64 = b(state, SUBS + i * SUB_BYTES)
        if w != 0 && ((w >> 24) & 0xFFFF) == pid {
            sb(state, SUBS + i * SUB_BYTES, 0)
        }
        i = i + 1
    }
    var m: u64 = box_at(state, task, B_HEAD)
    var n: u64 = box_at(state, task, B_COUNT)
    while n > 0 {
        let nx: u64 = msg_at(state, m, M_NEXT)
        msg_set(state, m, M_USED, 0)
        if nx == 0 {
            n = 0
        } else {
            m = nx - 1
            n = n - 1
        }
    }
    box_set(state, task, B_HEAD, 0)
    box_set(state, task, B_TAIL, 0)
    box_set(state, task, B_COUNT, 0)
    i = 0
    while i < SEG_MAX {
        if seg_at(state, i, G_USED) != 0 && seg_at(state, i, G_OWNER) == pid {
            let f: u64 = seg_at(state, i, G_FRAME)
            let p: u64 = seg_at(state, i, G_PAGES)
            seg_set(state, i, G_USED, 0)
            give(state)
            mmframe.frame_free_run(state, f, p)
            take(state)
        }
        i = i + 1
    }
    give(state)
}

fn stat(state: u64, which: u64) -> u64 {
    if which == S_HISTLEN {
        return b(state, S_HISTLEN)
    }
    if which > 0xF8 {
        return 0
    }
    return b(state, which)
}
