
import serial
import lib.kstate
import bus.ecam
import libc.regio

export {
    scan, count, get, list, find_class, find_bdf,
    bar, bar_size, bar_flags, bar_is_io,
    enable_master, disable_master, master_on, cap_find, power_state, force_d0, enable_mem,
    ext_cap_find, ext_cap_offsets, ext_cap_id, ext_cap_version, has_express,
    LEGACY_CFG_SIZE, EXT_CAP_START, CAP_EXPRESS,
    cfg_read32, cfg_write32, cfg_read16, cfg_write16, cfg_read8,
    cfg_write8,
    hexn, bdf_bus, bdf_dev, bdf_fn,
    E_BDF, E_VENDOR, E_DEVICE, E_CLASS, E_SUBCLASS, E_PROGIF, E_HDR,
    E_IRQLINE, E_IRQPIN, E_MSI, E_MSIX, E_EXPRESS, E_BARS,
    K2_OFF, K2_SCALARS, TABLE_OFF, ENTRY_BYTES, MAX_DEV,
    CAP_MSI, CAP_MSIX, CAP_PM,
    CLASS_STORAGE, SUB_IDE, SUB_SATA, SUB_RAID, SUB_NVM, PROGIF_AHCI, PROGIF_NVME,
    VENDOR_INTEL, find_ahci, find_raid_ahci, is_raid_class, rst_nvme_hidden
}

const K2_OFF: u64 = 0x10000
const TABLE_OFF: u64 = 0x10000
const K2_SCALARS: u64 = 0x12000

const ENTRY_BYTES: u64 = 256
const MAX_DEV: u64 = 32

const E_BDF: u64 = 0
const E_VENDOR: u64 = 8
const E_DEVICE: u64 = 16
const E_CLASS: u64 = 24
const E_SUBCLASS: u64 = 32
const E_PROGIF: u64 = 40
const E_HDR: u64 = 48
const E_IRQLINE: u64 = 56
const E_IRQPIN: u64 = 64
const E_MSI: u64 = 72
const E_MSIX: u64 = 80
const E_EXPRESS: u64 = 88
const E_BARS: u64 = 96

const S_COUNT: u64 = 0

const ADDR_PORT: u16 = 0xCF8
const DATA_PORT: u16 = 0xCFC

const CFG_VENDOR: u64 = 0x00
const CFG_DEVICE: u64 = 0x02
const CFG_COMMAND: u64 = 0x04
const CFG_STATUS: u64 = 0x06
const CFG_PROGIF: u64 = 0x09
const CFG_SUBCLASS: u64 = 0x0A
const CFG_CLASS: u64 = 0x0B
const CFG_HDRTYPE: u64 = 0x0E
const CFG_BAR0: u64 = 0x10
const CFG_CAPPTR: u64 = 0x34
const CFG_IRQLINE: u64 = 0x3C
const CFG_IRQPIN: u64 = 0x3D
const CFG_SECBUS: u64 = 0x19

const CMD_IO: u64 = 0x1
const CMD_MEM: u64 = 0x2
const CMD_MASTER: u64 = 0x4

const CAP_PM: u64 = 0x01
const PM_CSR_OFF: u64 = 4
const PM_STATE_MASK: u64 = 3
const CAP_MSI: u64 = 0x05
const CAP_MSIX: u64 = 0x11
const CAP_EXPRESS: u64 = 0x10

const LEGACY_CFG_SIZE: u64 = 0x100
const EXT_CAP_START: u64 = 0x100
const EXT_CAP_MAX: u64 = 480
const EXT_CAP_ID_MASK: u64 = 0xFFFF
const EXT_CAP_VERSION_SHIFT: u64 = 16
const EXT_CAP_VERSION_MASK: u64 = 0xF
const EXT_CAP_NEXT_SHIFT: u64 = 20
const EXT_CAP_NEXT_MASK: u64 = 0xFFC
const CFG_DWORD_ALL_ONES: u64 = 0xFFFFFFFF

const CLASS_STORAGE: u64 = 0x01
const SUB_IDE: u64 = 0x01
const SUB_SATA: u64 = 0x06
const SUB_RAID: u64 = 0x04
const S_TESTMODE: u64 = 0x1B0
const T_AHCIRAID: u64 = 262144
const T_FAKEWLAN: u64 = 8388608
const SUB_ETH: u64 = 0x00
const SUB_NETOTHER: u64 = 0x80
const CLASS_NET: u64 = 0x02
const FAKE_WLAN_DEVICE: u64 = 0x24fd
const SUB_NVM: u64 = 0x08
const PROGIF_AHCI: u64 = 0x01
const PROGIF_NVME: u64 = 0x02
const VENDOR_INTEL: u64 = 0x8086

fn in32(port: u16) -> u64 {
    return asm("in eax, dx", out("rax"), in("dx") port) & 0xFFFFFFFF
}

fn out32(port: u16, value: u64) {
    asm("out dx, eax", in("dx") port, in("eax")(value & 0xFFFFFFFF) as u32)
}

fn addr_of(bdf: u64, off: u64) -> u64 {
    return 0x80000000 | ((bdf & 0xFFFF) << 8) | (off & 0xFC)
}

fn bdf_bus(bdf: u64) -> u64 {
    return (bdf >> 8) & 0xFF
}

fn bdf_dev(bdf: u64) -> u64 {
    return (bdf >> 3) & 0x1F
}

fn bdf_fn(bdf: u64) -> u64 {
    return bdf & 0x7
}

fn cfg_read32(bdf: u64, off: u64) -> u64 {
    if off >= LEGACY_CFG_SIZE {
        return ecam.read32(bdf, off)
    }
    out32(ADDR_PORT, addr_of(bdf, off))
    return in32(DATA_PORT)
}

fn cfg_write32(bdf: u64, off: u64, v: u64) {
    if off >= LEGACY_CFG_SIZE {
        ecam.write32(bdf, off, v)
        return
    }
    out32(ADDR_PORT, addr_of(bdf, off))
    out32(DATA_PORT, v & 0xFFFFFFFF)
}

fn cfg_read16(bdf: u64, off: u64) -> u64 {
    return (cfg_read32(bdf, off) >> ((off & 2) * 8)) & 0xFFFF
}

fn cfg_read8(bdf: u64, off: u64) -> u64 {
    return (cfg_read32(bdf, off) >> ((off & 3) * 8)) & 0xFF
}

fn cfg_write16(bdf: u64, off: u64, v: u64) {
    let shift: u64 = (off & 2) * 8
    let old: u64 = cfg_read32(bdf, off)
    let mask: u64 = (0xFFFF << shift) & 0xFFFFFFFF
    cfg_write32(bdf, off, (old & (~mask) & 0xFFFFFFFF) | ((v & 0xFFFF) << shift))
}

fn cfg_write8(bdf: u64, off: u64, v: u64) {
    let shift: u64 = (off & 3) * 8
    let old: u64 = cfg_read32(bdf, off)
    let mask: u64 = (0xFF << shift) & 0xFFFFFFFF
    cfg_write32(bdf, off, (old & (~mask) & 0xFFFFFFFF) | ((v & 0xFF) << shift))
}

fn entry(state: u64, i: u64) -> u64 {
    return state + TABLE_OFF + i * ENTRY_BYTES
}

fn count(state: u64) -> u64 {
    return kstate.get(state, K2_SCALARS + S_COUNT)
}

fn get(state: u64, i: u64, off: u64) -> u64 {
    return regio.read64_at(entry(state, i), off)
}

fn bar(state: u64, i: u64, n: u64) -> u64 {
    return regio.read64_at(entry(state, i), E_BARS + n * 24)
}

fn bar_size(state: u64, i: u64, n: u64) -> u64 {
    return regio.read64_at(entry(state, i), E_BARS + n * 24 + 8)
}

fn bar_flags(state: u64, i: u64, n: u64) -> u64 {
    return regio.read64_at(entry(state, i), E_BARS + n * 24 + 16)
}

fn bar_is_io(state: u64, i: u64, n: u64) -> bool {
    return (bar_flags(state, i, n) & 1) != 0
}

fn scan(state: u64) -> u64 {
    kstate.set(state, K2_SCALARS + S_COUNT, 0)
    scan_bus(state, 0)
    return count(state)
}

fn scan_bus(state: u64, bus: u64) {
    var dev: u64 = 0
    while dev < 32 {
        scan_dev(state, bus, dev)
        dev = dev + 1
    }
}

fn scan_dev(state: u64, bus: u64, dev: u64) {
    let bdf0: u64 = (bus << 8) | (dev << 3)
    if cfg_read16(bdf0, CFG_VENDOR) == 0xFFFF {
        return
    }
    var last: u64 = 0
    if (cfg_read8(bdf0, CFG_HDRTYPE) & 0x80) != 0 {
        last = 7
    }
    var f: u64 = 0
    while f <= last {
        let bdf: u64 = bdf0 | f
        if cfg_read16(bdf, CFG_VENDOR) != 0xFFFF {
            record(state, bdf)
            if cfg_read8(bdf, CFG_CLASS) == 0x06 && cfg_read8(bdf, CFG_SUBCLASS) == 0x04 {
                let sec: u64 = cfg_read8(bdf, CFG_SECBUS)
                if sec > bus {
                    scan_bus(state, sec)
                }
            }
        }
        f = f + 1
    }
}

fn record(state: u64, bdf: u64) {
    let n: u64 = count(state)
    if n >= MAX_DEV {
        return
    }
    let e: u64 = entry(state, n)
    let hdr: u64 = cfg_read8(bdf, CFG_HDRTYPE)
    regio.write64_at(e, E_BDF, bdf)
    regio.write64_at(e, E_VENDOR, cfg_read16(bdf, CFG_VENDOR))
    regio.write64_at(e, E_DEVICE, cfg_read16(bdf, CFG_DEVICE))
    regio.write64_at(e, E_CLASS, cfg_read8(bdf, CFG_CLASS))
    regio.write64_at(e, E_SUBCLASS, cfg_read8(bdf, CFG_SUBCLASS))
    regio.write64_at(e, E_PROGIF, cfg_read8(bdf, CFG_PROGIF))
    if (kstate.get(state, K2_SCALARS + S_TESTMODE) & T_AHCIRAID) != 0 {
        if cfg_read8(bdf, CFG_CLASS) == CLASS_STORAGE && cfg_read8(bdf, CFG_SUBCLASS) == SUB_SATA {
            regio.write64_at(e, E_SUBCLASS, SUB_RAID)
            regio.write64_at(e, E_PROGIF, 0)
        }
    }
    if (kstate.get(state, K2_SCALARS + S_TESTMODE) & T_FAKEWLAN) != 0 {
        if cfg_read8(bdf, CFG_CLASS) == CLASS_NET && cfg_read8(bdf, CFG_SUBCLASS) == SUB_ETH {
            regio.write64_at(e, E_VENDOR, VENDOR_INTEL)
            regio.write64_at(e, E_DEVICE, FAKE_WLAN_DEVICE)
            regio.write64_at(e, E_SUBCLASS, SUB_NETOTHER)
        }
    }
    regio.write64_at(e, E_HDR, hdr)
    regio.write64_at(e, E_IRQLINE, cfg_read8(bdf, CFG_IRQLINE))
    regio.write64_at(e, E_IRQPIN, cfg_read8(bdf, CFG_IRQPIN))
    regio.write64_at(e, E_MSI, cap_find(bdf, CAP_MSI))
    regio.write64_at(e, E_MSIX, cap_find(bdf, CAP_MSIX))
    regio.write64_at(e, E_EXPRESS, cap_find(bdf, CAP_EXPRESS))
    var nbars: u64 = 6
    if (hdr & 0x7F) != 0 {
        nbars = 2
    }
    size_bars(e, bdf, nbars)
    kstate.set(state, K2_SCALARS + S_COUNT, n + 1)
}

fn size_bars(e: u64, bdf: u64, nbars: u64) {
    let cmd: u64 = cfg_read16(bdf, CFG_COMMAND)
    cfg_write16(bdf, CFG_COMMAND, cmd & (~(CMD_IO | CMD_MEM)) & 0xFFFF)
    var i: u64 = 0
    while i < nbars {
        let off: u64 = CFG_BAR0 + i * 4
        let orig: u64 = cfg_read32(bdf, off)
        var addr: u64 = 0
        var size: u64 = 0
        let flags: u64 = orig & 0xF
        var wide: bool = false
        if (orig & 1) != 0 {
            cfg_write32(bdf, off, 0xFFFFFFFF)
            let probe: u64 = cfg_read32(bdf, off) & 0xFFFC & 0xFFFF
            cfg_write32(bdf, off, orig)
            addr = orig & 0xFFFC
            if probe != 0 {
                size = ((~probe) & 0xFFFF) + 1
            }
        } else {
            wide = ((orig >> 1) & 3) == 2
            if wide {
                let orig_hi: u64 = cfg_read32(bdf, off + 4)
                cfg_write32(bdf, off, 0xFFFFFFFF)
                cfg_write32(bdf, off + 4, 0xFFFFFFFF)
                let lo: u64 = cfg_read32(bdf, off) & 0xFFFFFFF0
                let hi: u64 = cfg_read32(bdf, off + 4)
                cfg_write32(bdf, off, orig)
                cfg_write32(bdf, off + 4, orig_hi)
                addr = (orig & 0xFFFFFFF0) | (orig_hi << 32)
                let probe: u64 = lo | (hi << 32)
                if probe != 0 {
                    size = (~probe) + 1
                }
            } else {
                cfg_write32(bdf, off, 0xFFFFFFFF)
                let probe: u64 = cfg_read32(bdf, off) & 0xFFFFFFF0
                cfg_write32(bdf, off, orig)
                addr = orig & 0xFFFFFFF0
                if probe != 0 {
                    size = ((~probe) & 0xFFFFFFFF) + 1
                }
            }
        }
        regio.write64_at(e, E_BARS + i * 24, addr)
        regio.write64_at(e, E_BARS + i * 24 + 8, size)
        regio.write64_at(e, E_BARS + i * 24 + 16, flags)
        if wide {
            regio.write64_at(e, E_BARS + (i + 1) * 24, 0)
            regio.write64_at(e, E_BARS + (i + 1) * 24 + 8, 0)
            regio.write64_at(e, E_BARS + (i + 1) * 24 + 16, 0)
            i = i + 1
        }
        i = i + 1
    }
    cfg_write16(bdf, CFG_COMMAND, cmd)
}

fn cap_find(bdf: u64, want: u64) -> u64 {
    if (cfg_read16(bdf, CFG_STATUS) & 0x10) == 0 {
        return 0
    }
    var off: u64 = cfg_read8(bdf, CFG_CAPPTR) & 0xFC
    var guard: u64 = 0
    while off >= 0x40 && guard < 48 {
        if cfg_read8(bdf, off) == want {
            return off
        }
        off = cfg_read8(bdf, off + 1) & 0xFC
        guard = guard + 1
    }
    return 0
}

fn ext_cap_header_ok(h: u64) -> bool {
    return h != 0 && h != CFG_DWORD_ALL_ONES
}

fn ext_cap_id(h: u64) -> u64 {
    return h & EXT_CAP_ID_MASK
}

fn ext_cap_version(h: u64) -> u64 {
    return (h >> EXT_CAP_VERSION_SHIFT) & EXT_CAP_VERSION_MASK
}

fn ext_cap_next(h: u64) -> u64 {
    return (h >> EXT_CAP_NEXT_SHIFT) & EXT_CAP_NEXT_MASK
}

fn ext_cap_offsets(bdf: u64, out: u64, max: u64) -> u64 {
    if !ecam.present() {
        return 0
    }
    var off: u64 = EXT_CAP_START
    var seen: u64 = 0
    while off >= EXT_CAP_START && seen < EXT_CAP_MAX && seen < max {
        let h: u64 = cfg_read32(bdf, off)
        if !ext_cap_header_ok(h) {
            return seen
        }
        __mmio_write64((out + seen * 8) as *mut u64, off)
        off = ext_cap_next(h)
        seen = seen + 1
    }
    return seen
}

fn has_express(bdf: u64) -> bool {
    return cap_find(bdf, CAP_EXPRESS) != 0
}

fn ext_cap_find(bdf: u64, want: u64) -> u64 {
    if !ecam.present() || !has_express(bdf) {
        return 0
    }
    var off: u64 = EXT_CAP_START
    var seen: u64 = 0
    while off >= EXT_CAP_START && seen < EXT_CAP_MAX {
        let h: u64 = cfg_read32(bdf, off)
        if !ext_cap_header_ok(h) {
            return 0
        }
        if ext_cap_id(h) == want {
            return off
        }
        off = ext_cap_next(h)
        seen = seen + 1
    }
    return 0
}

fn enable_master(bdf: u64) {
    let cmd: u64 = cfg_read16(bdf, CFG_COMMAND)
    cfg_write16(bdf, CFG_COMMAND, cmd | CMD_MEM | CMD_MASTER)
}

fn power_state(bdf: u64) -> u64 {
    let pm: u64 = cap_find(bdf, CAP_PM)
    if pm == 0 {
        return 0
    }
    return cfg_read16(bdf, pm + PM_CSR_OFF) & PM_STATE_MASK
}

fn force_d0(bdf: u64) -> bool {
    let pm: u64 = cap_find(bdf, CAP_PM)
    if pm == 0 {
        return false
    }
    let csr: u64 = cfg_read16(bdf, pm + PM_CSR_OFF)
    if (csr & PM_STATE_MASK) == 0 {
        return false
    }
    cfg_write16(bdf, pm + PM_CSR_OFF, csr & (~PM_STATE_MASK))
    return true
}

fn enable_mem(bdf: u64) {
    cfg_write16(bdf, CFG_COMMAND, cfg_read16(bdf, CFG_COMMAND) | CMD_MEM)
}

fn disable_master(bdf: u64) {
    let cmd: u64 = cfg_read16(bdf, CFG_COMMAND)
    cfg_write16(bdf, CFG_COMMAND, (cmd & (~CMD_MASTER)) | CMD_MEM)
}

fn master_on(bdf: u64) -> bool {
    return (cfg_read16(bdf, CFG_COMMAND) & CMD_MASTER) != 0
}

fn find_class(state: u64, cls: u64, sub: u64, pif: u64) -> u64 {
    let n: u64 = count(state)
    var i: u64 = 0
    while i < n {
        if get(state, i, E_CLASS) == cls && get(state, i, E_SUBCLASS) == sub {
            if pif > 0xFF || get(state, i, E_PROGIF) == pif {
                return i
            }
        }
        i = i + 1
    }
    return MAX_DEV
}

fn is_raid_class(state: u64, i: u64) -> bool {
    return get(state, i, E_CLASS) == CLASS_STORAGE && get(state, i, E_SUBCLASS) == SUB_RAID
}

fn find_raid_ahci(state: u64) -> u64 {
    let n: u64 = count(state)
    var i: u64 = 0
    while i < n {
        if is_raid_class(state, i) && get(state, i, E_VENDOR) == VENDOR_INTEL {
            return i
        }
        i = i + 1
    }
    return MAX_DEV
}

fn rst_nvme_hidden(state: u64) -> bool {
    if find_raid_ahci(state) >= MAX_DEV {
        return false
    }
    return find_class(state, CLASS_STORAGE, SUB_NVM, 0x100) >= MAX_DEV
}

fn find_ahci(state: u64) -> u64 {
    let i: u64 = find_class(state, CLASS_STORAGE, SUB_SATA, PROGIF_AHCI)
    if i < MAX_DEV {
        return i
    }
    return find_raid_ahci(state)
}

fn find_bdf(state: u64, bdf: u64) -> u64 {
    let n: u64 = count(state)
    var i: u64 = 0
    while i < n {
        if get(state, i, E_BDF) == bdf {
            return i
        }
        i = i + 1
    }
    return MAX_DEV
}

fn hexn(v: u64, n: u64) {
    var i: u64 = n
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * 4)) & 15
        if d < 10 {
            serial.put((48 + d) as u8)
        } else {
            serial.put((87 + d) as u8)
        }
    }
}

fn list(state: u64) {
    var s_pci: [u8; 6] = "pci: \0"
    var s_class: [u8; 8] = " class=\0"
    var s_bar: [u8; 6] = "  bar\0"
    var s_irq: [u8; 6] = "  irq\0"
    var s_msi: [u8; 7] = "  msi\0\0"
    var s_msix: [u8; 7] = "  msix\0"
    var s_io: [u8; 4] = "io\0\0"
    var s_total: [u8; 15] = "pci: devices=\0\0"

    let n: u64 = count(state)
    var i: u64 = 0
    while i < n {
        let bdf: u64 = get(state, i, E_BDF)
        serial.puts((&s_pci[0]) as u64)
        hexn(bdf_bus(bdf), 2)
        serial.put(58 as u8)
        hexn(bdf_dev(bdf), 2)
        serial.put(46 as u8)
        hexn(bdf_fn(bdf), 1)
        serial.put(32 as u8)
        hexn(get(state, i, E_VENDOR), 4)
        serial.put(58 as u8)
        hexn(get(state, i, E_DEVICE), 4)
        serial.puts((&s_class[0]) as u64)
        hexn(get(state, i, E_CLASS), 2)
        serial.put(58 as u8)
        hexn(get(state, i, E_SUBCLASS), 2)
        serial.put(58 as u8)
        hexn(get(state, i, E_PROGIF), 2)
        serial.put(32 as u8)
        kind(get(state, i, E_CLASS), get(state, i, E_SUBCLASS),
            get(state, i, E_PROGIF))
        var b: u64 = 0
        while b < 6 {
            let sz: u64 = bar_size(state, i, b)
            if sz != 0 {
                serial.puts((&s_bar[0]) as u64)
                serial.dec(b)
                serial.put(61 as u8)
                if bar_is_io(state, i, b) {
                    serial.puts((&s_io[0]) as u64)
                }
                serial.hex(bar(state, i, b))
                serial.put(47 as u8)
                serial.hex(sz)
            }
            b = b + 1
        }
        if get(state, i, E_IRQPIN) != 0 {
            serial.puts((&s_irq[0]) as u64)
            serial.put(61 as u8)
            serial.dec(get(state, i, E_IRQLINE))
        }
        if get(state, i, E_MSI) != 0 {
            serial.puts((&s_msi[0]) as u64)
        }
        if get(state, i, E_MSIX) != 0 {
            serial.puts((&s_msix[0]) as u64)
        }
        serial.nl()
        i = i + 1
    }
    serial.puts((&s_total[0]) as u64)
    serial.dec(n)
    serial.nl()
    if rst_nvme_hidden(state) {
        var s_rst: [u8; 76] = "pci: Intel RST (RAID) mode, NVMe may be hidden. BIOS: set SATA mode to AHCI\0"
        serial.puts((&s_rst[0]) as u64)
        serial.nl()
    }
}

fn kind(cls: u64, sub: u64, pif: u64) {
    var s_host: [u8; 12] = "host-bridge\0"
    var s_isa: [u8; 11] = "isa-bridge\0"
    var s_pci: [u8; 11] = "pci-bridge\0"
    var s_other: [u8; 7] = "bridge\0"
    var s_ide: [u8; 4] = "ide\0"
    var s_ahci: [u8; 5] = "ahci\0"
    var s_nvme: [u8; 5] = "nvme\0"
    var s_scsi: [u8; 5] = "scsi\0"
    var s_stor: [u8; 8] = "storage\0"
    var s_net: [u8; 8] = "network\0"
    var s_vga: [u8; 4] = "vga\0"
    var s_disp: [u8; 8] = "display\0"
    var s_usb: [u8; 4] = "usb\0"
    var s_ser: [u8; 11] = "serial-bus\0"
    var s_unk: [u8; 8] = "unknown\0"

    if cls == 0x06 {
        if sub == 0x00 {
            serial.puts((&s_host[0]) as u64)
            return
        }
        if sub == 0x01 {
            serial.puts((&s_isa[0]) as u64)
            return
        }
        if sub == 0x04 {
            serial.puts((&s_pci[0]) as u64)
            return
        }
        serial.puts((&s_other[0]) as u64)
        return
    }
    if cls == CLASS_STORAGE {
        if sub == SUB_IDE {
            serial.puts((&s_ide[0]) as u64)
            return
        }
        if sub == SUB_SATA && pif == PROGIF_AHCI {
            serial.puts((&s_ahci[0]) as u64)
            return
        }
        if sub == SUB_NVM && pif == PROGIF_NVME {
            serial.puts((&s_nvme[0]) as u64)
            return
        }
        if sub == 0x00 {
            serial.puts((&s_scsi[0]) as u64)
            return
        }
        serial.puts((&s_stor[0]) as u64)
        return
    }
    if cls == 0x02 {
        serial.puts((&s_net[0]) as u64)
        return
    }
    if cls == 0x03 {
        if sub == 0x00 {
            serial.puts((&s_vga[0]) as u64)
            return
        }
        serial.puts((&s_disp[0]) as u64)
        return
    }
    if cls == 0x0C {
        if sub == 0x03 {
            serial.puts((&s_usb[0]) as u64)
            return
        }
        serial.puts((&s_ser[0]) as u64)
        return
    }
    serial.puts((&s_unk[0]) as u64)
}
