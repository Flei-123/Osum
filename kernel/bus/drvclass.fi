profile kernel

export {
    CLS_NONE, CLS_NET_ETH, CLS_NET_WLAN, CLS_BLOCK, CLS_AUDIO, CLS_INPUT,
    CLS_DISPLAY, CLS_SERIAL, CLS_CAMERA, CLS_BLUETOOTH, CLS_COUNT,
    valid, tag_of, hit, hits
}

const CLS_NONE: u64 = 0
const CLS_NET_ETH: u64 = 1
const CLS_NET_WLAN: u64 = 2
const CLS_BLOCK: u64 = 3
const CLS_AUDIO: u64 = 4
const CLS_INPUT: u64 = 5
const CLS_DISPLAY: u64 = 6
const CLS_SERIAL: u64 = 7
const CLS_CAMERA: u64 = 8
const CLS_BLUETOOTH: u64 = 9
const CLS_COUNT: u64 = 10

static mut calls: [u64; 10] = [0 as u64; 10]

fn valid(cls: u64) -> bool {
    return cls < CLS_COUNT
}

fn tag_of(cls: u64) -> u64 {
    if cls == CLS_NET_ETH {
        return 0x6874652d74656e
    }
    if cls == CLS_NET_WLAN {
        return 0x6e616c772d74656e
    }
    if cls == CLS_BLOCK {
        return 0x6b636f6c62
    }
    if cls == CLS_AUDIO {
        return 0x6f69647561
    }
    if cls == CLS_INPUT {
        return 0x7475706e69
    }
    if cls == CLS_DISPLAY {
        return 0x79616c70736964
    }
    if cls == CLS_SERIAL {
        return 0x6c6169726573
    }
    if cls == CLS_CAMERA {
        return 0x6172656d6163
    }
    if cls == CLS_BLUETOOTH {
        return 0x7462
    }
    return 0x656e6f6e
}

fn hit(cls: u64) {
    if cls < CLS_COUNT {
        calls[cls as usize] = calls[cls as usize] + 1
    }
}

fn hits(cls: u64) -> u64 {
    if cls < CLS_COUNT {
        return calls[cls as usize]
    }
    return 0
}
