
import gfx.gfx
import lib.kstate
import arch.arch
import arch.cpu

export {
    out8, in8, io_wait,
    init, put, puts, text, nl, hex, hex_digits, hex_width, dec, pad_dec,
    COM1, COM2, port, set_port, rx_ready, rx_take, rx_on, rx_off,
    overrun, drain_fifo,
    probe, off, set_off, dropped, lsr_roh, scr_roh,
    line_at, line_clear, line_lost, line_stolen,
    defer_on, defer_off, pump, ring_used, ring_flushed, ring_say, wire_overlap_count,
    ring_stolen_count
}

const LINE_LIMIT: u64 = 20000000

const LINE_STALE: u64 = 300000000

static mut line_who: [u64; 1] = [0 as u64; 1]
static mut line_beside: [u64; 1] = [0 as u64; 1]
static mut entry_stamp: [u64; 1] = [0 as u64; 1]
static mut entry_auto: [u64; 1] = [0 as u64; 1]
static mut entry_open: [u64; 1] = [0 as u64; 1]
static mut entry_stolen: [u64; 1] = [0 as u64; 1]
static mut line_flags: [u64; 1] = [0 as u64; 1]

fn line_take(me: u64) -> u64 {
    if kstate.mode_on(arch.kdata_base(), kstate.M_SERWIDEN) {
        return 0
    }
    let a: u64 = (&line_who[0]) as u64
    if __mmio_read64(a as *mut u64) == me + 1 {
        if __mmio_read64((&entry_auto[0]) as u64 as *mut u64) != 0 as u64 {
            entry_auto[0] = 0
            return 2
        }
        return 0
    }
    var spins: u64 = 0
    while __atomic_swap(a as *mut u64, 0 as u64, me + 1) != 0 as u64 {
        let o: u64 = __mmio_read64(a as *mut u64)
        let now: u64 = arch.cycles()
        let st: u64 = __mmio_read64((&entry_stamp[0]) as u64 as *mut u64)
        if o != 0 as u64 && now > st && now - st > LINE_STALE {
            if __atomic_swap(a as *mut u64, o, me + 1) == o {
                entry_stolen[0] = entry_stolen[0] + 1
                entry_auto[0] = 0
                entry_stamp[0] = now
                return 1
            }
        }
        arch.pause()
        spins = spins + 1
        if spins > LINE_LIMIT {
            line_beside[0] = line_beside[0] + 1
            return 0
        }
    }
    entry_stamp[0] = arch.cycles()
    return 1
}

fn line_at() -> u64 {
    let st: u64 = arch.kdata_base()
    if kstate.mode_on(st, kstate.M_SERWIDEN) {
        return 0
    }
    let fl: u64 = arch.irq_save()
    let z: u64 = line_take(cpu.here(st))
    if z == 0 {
        arch.irq_restore(fl)
        return 0
    }
    line_flags[0] = fl
    return z
}

fn line_clear(hat: u64) {
    if hat == 0 {
        return
    }
    let fl: u64 = line_flags[0]
    let me: u64 = cpu.here(arch.kdata_base())
    let a: u64 = (&line_who[0]) as u64
    if __mmio_read64(a as *mut u64) != me + 1 {
        arch.irq_restore(fl)
        return
    }
    if __mmio_read64((&entry_open[0]) as u64 as *mut u64) != 0 as u64 {
        entry_auto[0] = 1
        arch.irq_restore(fl)
        return
    }
    entry_auto[0] = 0
    arch.atomic_store(a, 0)
    arch.irq_restore(fl)
}

fn line_lost() -> u64 {
    return line_beside[0]
}

fn line_stolen() -> u64 {
    return entry_stolen[0]
}

const COM1: u16 = 0x3F8
const COM2: u16 = 0x2F8

const R_DATA: u16 = 0
const R_IER: u16 = 1
const R_FCR: u16 = 2
const R_LCR: u16 = 3
const R_MCR: u16 = 4
const R_LSR: u16 = 5
const LSR_RX: u8 = 0x01
const LSR_OVERRUN: u8 = 0x02
const LSR_TX: u8 = 0x20
const IER_RX: u8 = 0x01
const R_SCR: u16 = 7

const PUT_LIMIT: u64 = 100000
const DROP_LIMIT: u64 = 16

static mut ser_aus: u64 = 0
static mut ser_verw: u64 = 0
static mut ser_lsr: u64 = 256
static mut ser_scr: u64 = 256

fn port() -> u16 {
    let p: u64 = kstate.get(arch.kdata_base(), kstate.SER_PORT)
    if p == 0 {
        return COM1
    }
    return p as u16
}

fn set_port(state: u64, p: u64) {
    kstate.set(state, kstate.SER_PORT, p)
}

fn out8(port: u16, value: u8) {
    arch.dev_out8(port, value)
}

fn in8(port: u16) -> u8 {
    return arch.dev_in8(port)
}

fn io_wait() {
    arch.dev_io_wait()
}

fn init() {
    let b: u16 = port()
    out8(b + R_IER, 0x00 as u8)
    out8(b + R_LCR, 0x80 as u8)
    out8(b + R_DATA, 0x03 as u8)
    out8(b + R_IER, 0x00 as u8)
    out8(b + R_LCR, 0x03 as u8)
    out8(b + R_FCR, 0xC7 as u8)
    out8(b + R_MCR, 0x0B as u8)
    if (in8(b + R_FCR) & 0xC0 as u8) == 0xC0 as u8 {
        ser_burst = 16
    } else {
        ser_burst = 1
    }
}

fn probe() -> bool {
    let b: u16 = port()
    out8(b + R_SCR, 0xA5 as u8)
    let back: u8 = in8(b + R_SCR)
    ser_scr = back as u64
    ser_lsr = in8(b + R_LSR) as u64
    if back != 0xA5 as u8 {
        ser_aus = 1
        return false
    }
    return true
}

fn off() -> u64 {
    return ser_aus
}

fn set_off(v: u64) {
    ser_aus = v
}

fn dropped() -> u64 {
    return ser_verw
}

fn lsr_roh() -> u64 {
    return ser_lsr
}

fn scr_roh() -> u64 {
    return ser_scr
}

fn ready() -> bool {
    return (in8(port() + R_LSR) & LSR_TX) != 0 as u8
}

fn rx_ready() -> bool {
    return (in8(port() + R_LSR) & LSR_RX) != 0 as u8
}

fn rx_take() -> u64 {
    if !rx_ready() {
        return 256
    }
    return in8(port() + R_DATA) as u64
}

fn overrun() -> bool {
    return (in8(port() + R_LSR) & LSR_OVERRUN) != 0 as u8
}

fn drain_fifo() {
    var n: u64 = 0
    while rx_ready() && n < 64 {
        in8(port() + R_DATA)
        n = n + 1
    }
}

fn rx_on() {
    out8(port() + R_IER, IER_RX)
}

fn rx_off() {
    out8(port() + R_IER, 0x00 as u8)
}

const RING_SIZE: u64 = 4096
const RING_LOCK_SPINS: u64 = 20000
const RING_ROOM: u64 = 16
const WIRE_LOCK_SPINS: u64 = 2000000
const RING_SLICE: u64 = 64
const WIRE_ROUNDS: u64 = 80
const RING_STALE: u64 = 300000000
static mut ring_buf: [u8; 4096] = [0 as u8; 4096]
static mut ring_head: [u64; 1] = [0 as u64; 1]
static mut ring_tail: [u64; 1] = [0 as u64; 1]
static mut ring_lock: [u64; 1] = [0 as u64; 1]
static mut ring_stamp: [u64; 1] = [0 as u64; 1]
static mut ring_stolen: [u64; 1] = [0 as u64; 1]
static mut defer_depth: [u64; 1] = [0 as u64; 1]
static mut ser_burst: u64 = 1
static mut ring_flushes: u64 = 0
static mut ring_fulls: u64 = 0
static mut ring_pumps: u64 = 0
static mut ring_octets: u64 = 0

fn defer_on() {
    __atomic_add((&defer_depth[0]) as *mut u64, 1 as u64)
}

fn defer_off() {
    if __mmio_read64((&defer_depth[0]) as u64 as *mut u64) != 0 as u64 {
        __atomic_add((&defer_depth[0]) as *mut u64, 0 -% 1)
    }
}

fn ring_used() -> u64 {
    return ring_head[0] - ring_tail[0]
}

fn ring_flushed() -> u64 {
    return ring_flushes
}

fn ring_stolen_count() -> u64 {
    return ring_stolen[0]
}

fn ring_take(spins: u64) -> bool {
    let me: u64 = cpu.here(arch.kdata_base()) + 1
    let a: u64 = (&ring_lock[0]) as u64
    var n: u64 = 0
    while __atomic_swap(a as *mut u64, 0 as u64, me) != 0 as u64 {
        let o: u64 = __mmio_read64(a as *mut u64)
        if o == me {
            return false
        }
        if o != 0 as u64 {
            let now: u64 = arch.cycles()
            let st: u64 = __mmio_read64((&ring_stamp[0]) as u64 as *mut u64)
            if now > st && now - st > RING_STALE {
                if __atomic_swap(a as *mut u64, o, me) == o {
                    ring_stolen[0] = ring_stolen[0] + 1
                    ring_stamp[0] = now
                    return true
                }
            }
        }
        n = n + 1
        if n >= spins {
            return false
        }
        arch.pause()
    }
    ring_stamp[0] = arch.cycles()
    return true
}

fn ring_give() {
    arch.atomic_store((&ring_lock[0]) as u64, 0)
}

fn ring_out_one() {
    let t: u64 = ring_tail[0]
    uart_write(ring_buf[(t % RING_SIZE) as usize])
    ring_tail[0] = t + 1
    ring_stamp[0] = arch.cycles()
}

fn ring_drain_blocking() {
    while ring_tail[0] != ring_head[0] {
        var n: u64 = 0
        while !ready() && n < PUT_LIMIT {
            n = n + 1
        }
        if n >= PUT_LIMIT {
            ser_aus = 1
            ring_tail[0] = ring_head[0]
            return
        }
        ring_out_one()
    }
}

fn ring_drain_some(n: u64) {
    var k: u64 = 0
    while k < n && ring_tail[0] != ring_head[0] {
        var w: u64 = 0
        while !ready() && w < PUT_LIMIT {
            w = w + 1
        }
        if w >= PUT_LIMIT {
            ser_aus = 1
            ring_tail[0] = ring_head[0]
            return
        }
        ring_out_one()
        k = k + 1
    }
}

fn ring_flush_before() {
    if ring_tail[0] == ring_head[0] {
        return
    }
    let fl: u64 = arch.irq_save()
    if ring_take(RING_LOCK_SPINS) {
        ring_flushes = ring_flushes + 1
        ring_drain_blocking()
        ring_give()
    }
    arch.irq_restore(fl)
}

fn ring_push(c: u8) -> bool {
    let fl: u64 = arch.irq_save()
    if !ring_take(RING_LOCK_SPINS) {
        arch.irq_restore(fl)
        return false
    }
    if ring_head[0] - ring_tail[0] >= RING_SIZE {
        ring_fulls = ring_fulls + 1
        ring_drain_some(RING_ROOM)
    }
    if ser_aus != 0 {
        ring_give()
        arch.irq_restore(fl)
        return true
    }
    let h: u64 = ring_head[0]
    ring_buf[(h % RING_SIZE) as usize] = c
    ring_head[0] = h + 1
    ring_octets = ring_octets + 1
    ring_give()
    arch.irq_restore(fl)
    return true
}

fn ring_say() {
    var a: [u8; 19] = "serial: ring used=\0"
    var b: [u8; 9] = " queued=\0"
    var c: [u8; 8] = " pumps=\0"
    var d: [u8; 7] = " full=\0"
    var e: [u8; 10] = " flushes=\0"
    var f: [u8; 8] = " burst=\0"
    puts((&a[0]) as u64)
    dec(ring_used())
    puts((&b[0]) as u64)
    dec(ring_octets)
    puts((&c[0]) as u64)
    dec(ring_pumps)
    puts((&d[0]) as u64)
    dec(ring_fulls)
    puts((&e[0]) as u64)
    dec(ring_flushes)
    puts((&f[0]) as u64)
    dec(ser_burst)
    nl()
}

fn pump() {
    if ring_tail[0] == ring_head[0] {
        return
    }
    let fl: u64 = arch.irq_save()
    if !ring_take(1) {
        arch.irq_restore(fl)
        return
    }
    if ser_aus != 0 {
        ring_tail[0] = ring_head[0]
    } else if ready() {
        ring_pumps = ring_pumps + 1
        var k: u64 = 0
        while k < ser_burst && ring_tail[0] != ring_head[0] {
            ring_out_one()
            k = k + 1
        }
    }
    ring_give()
    arch.irq_restore(fl)
}

fn put(c: u8) {
    gfx.echo(c)
    if ser_aus != 0 {
        return
    }
    let st: u64 = arch.kdata_base()
    if kstate.mode_on(st, kstate.M_NOSERLINE) {
        put_raw(c)
        return
    }
    let me: u64 = cpu.here(st)
    let z: u64 = line_take(me)
    if z != 0 {
        entry_auto[0] = 1
    }
    let a: u64 = (&line_who[0]) as u64
    if __mmio_read64(a as *mut u64) == me + 1 {
        entry_stamp[0] = arch.cycles()
    }
    put_raw(c)
    if c == 10 as u8 {
        entry_open[0] = 0
        if __mmio_read64((&entry_auto[0]) as u64 as *mut u64) != 0 as u64 && __mmio_read64(a as *mut u64) == me + 1 {
            entry_auto[0] = 0
            arch.atomic_store(a, 0)
        }
    } else {
        entry_open[0] = 1
    }
}

fn put_raw(c: u8) {
    if ser_aus != 0 {
        return
    }
    if __mmio_read64((&defer_depth[0]) as u64 as *mut u64) != 0 as u64 && !kstate.mode_on(arch.kdata_base(), kstate.M_SERWIDEN) {
        if ring_push(c) {
            return
        }
    }
    wire_put(c)
}

fn wire_put(c: u8) {
    if !kstate.mode_on(arch.kdata_base(), kstate.M_NOWIRELOCK) {
        var rounds: u64 = 0
        while rounds < WIRE_ROUNDS {
            let fl: u64 = arch.irq_save()
            if !ring_take(WIRE_LOCK_SPINS) {
                arch.irq_restore(fl)
                break
            }
            if ring_tail[0] != ring_head[0] {
                ring_flushes = ring_flushes + 1
                ring_drain_some(RING_SLICE)
                if ring_tail[0] != ring_head[0] {
                    ring_give()
                    arch.irq_restore(fl)
                    rounds = rounds + 1
                    continue
                }
            }
            wire_out(c)
            ring_give()
            arch.irq_restore(fl)
            return
        }
    }
    ring_flush_before()
    wire_out(c)
}

static mut wire_busy: [u64; 1] = [0 as u64; 1]
static mut wire_overlaps: [u64; 1] = [0 as u64; 1]

fn wire_overlap_count() -> u64 {
    return wire_overlaps[0]
}

fn uart_write(c: u8) {
    let st: u64 = arch.kdata_base()
    let a: u64 = (&wire_busy[0]) as u64
    let mine: bool = __atomic_swap(a as *mut u64, 0 as u64, 1 as u64) == 0 as u64
    if !mine {
        wire_overlaps[0] = wire_overlaps[0] + 1
        if wire_overlaps[0] == 1 {
            out8(port(), 1 as u8)
        }
    }
    if kstate.mode_on(st, kstate.M_SERWIDEN) {
        var w: u64 = 0
        while w < 3000 {
            arch.pause()
            w = w + 1
        }
    }
    out8(port(), c)
    if mine {
        arch.atomic_store(a, 0)
    }
}

fn wire_out(c: u8) {
    var n: u64 = 0
    while !ready() && n < PUT_LIMIT {
        n = n + 1
    }
    if n >= PUT_LIMIT {
        ser_verw = ser_verw + 1
        if ser_verw >= DROP_LIMIT {
            ser_aus = 1
        }
        return
    }
    uart_write(c)
}

fn nl() {
    put(10 as u8)
}

fn puts(p: u64) {
    var i: u64 = 0
    while true {
        let c: u8 = *((p + i) as *mut u8)
        if c == 0 as u8 {
            return
        }
        put(c)
        i = i + 1
    }
}

fn text(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        put(*((p + i) as *mut u8))
        i = i + 1
    }
}

fn digit(d: u64) -> u8 {
    if d < 10 {
        return (48 + d) as u8
    }
    return (87 + d) as u8
}

fn hex(v: u64) {
    hex_width(v, hex_digits(v))
}

fn hex_digits(v: u64) -> u64 {
    var w: u64 = 1
    var x: u64 = v >> 4
    while x != 0 {
        w = w + 1
        x = x >> 4
    }
    return w
}

fn hex_width(v: u64, w: u64) {
    put(48 as u8)
    put(120 as u8)
    var i: u64 = w
    while i > 0 {
        i = i - 1
        put(digit((v >> (i * 4)) & 15))
    }
}

fn dec(v: u64) {
    pad_dec(v, 0)
}

fn pad_dec(v: u64, width: u64) {
    var buf: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        buf[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        buf[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    var pad: u64 = 0
    while pad + n < width {
        put(32 as u8)
        pad = pad + 1
    }
    var i: u64 = n
    while i > 0 {
        i = i - 1
        put(buf[i as usize])
    }
}
