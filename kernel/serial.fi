// SPDX-License-Identifier: GPL-2.0-only
// kernel/serial.fi -- round 59: COM1, the kernel's only output.
//
// A kernel without output is a black box. Everything this kernel says --
// boot messages, register dumps of an exception, the tick counter, the
// keys -- goes out here, and `tools/kernel/run.sh` reads it back out of
// QEMU and holds it against expectations.
//
// Port I/O is the one thing that cannot be expressed with pointers:
// `in`/`out` are instructions of their own with an address space of their
// own. Hence inline assembly (round 52, compiler/src/core.rs).

// ROUNDE K7: der Bildschirm haengt UNTER dieser Datei, nicht darueber.
// `fb.fi` bindet weder `serial` noch `mem`, `pci` oder `apic` ein --
// sonst waere der Abhaengigkeitsgraph ein Kreis. Dafuer spiegelt `put`
// hier jedes Oktett auf den Rahmenpuffer, und damit zeigen serielle
// Konsole und Bildschirm dasselbe, ohne dass eine der rund tausend
// Aufrufstellen von `serial.puts` sich aendert.
import drivers.gfx.gfx
import kstate
import arch.arch

export {
    out8, in8, io_wait,
    init, put, puts, text, nl, hex, hex_digits, hex_width, dec, pad_dec,
    COM1, COM2, port, set_port, rx_ready, rx_take, rx_on, rx_off,
    overrun, drain_fifo
}

// 0x3F8 = COM1 on every PC that has ever existed
const COM1: u16 = 0x3F8
// RUNDE SERVERBUILD: die zweite Leitung. `console=ttyS1` nimmt sie.
const COM2: u16 = 0x2F8

// Die Register, relativ zum Torwert. Sie standen bis zu dieser Runde
// als nackte Zahlen in `init` -- mit einem Empfangsweg daneben ist das
// eine Zahl zu viel, um sie zweimal zu raten.
const R_DATA: u16 = 0 // lesen: RBR, schreiben: THR
const R_IER: u16 = 1 // welche Unterbrechungen der Baustein schickt
const R_FCR: u16 = 2 // schreiben: die FIFOs
const R_LCR: u16 = 3 // Wortlaenge, Stoppbits, DLAB
const R_MCR: u16 = 4 // DTR, RTS, OUT1, OUT2
const R_LSR: u16 = 5 // was anliegt
const LSR_RX: u8 = 0x01 // ein Oktett liegt bereit
const LSR_OVERRUN: u8 = 0x02 // eines ist verlorengegangen
const LSR_TX: u8 = 0x20 // der Sender ist leer
const IER_RX: u8 = 0x01 // "sag Bescheid, wenn etwas ankommt"

// ------------------------------------------------------- der Torwert
//
// WARUM DAS EINE FUNKTION IST UND KEINE KONSTANTE. Bis zu dieser Runde
// stand COM1 fest in jeder der sieben Zeilen, die ein Tor anfassen.
// `console=ttyS1` verlangt, dass Ausgabe UND Eingabe auf dieselbe
// andere Leitung gehen -- und wenn nur eine Haelfte umzieht, redet der
// Kernel in ein Kabel und hoert am anderen.
//
// Der Wert liegt in `kdata` und nicht in einer Modulvariablen, weil
// `put` kein `state` bekommt und keines bekommen soll (derselbe Grund,
// aus dem `ansi.echo` sich `kdata` selbst holt). Vor `sercon.parse`
// steht dort eine Null, und eine Null heisst COM1 -- damit ist die
// allererste Bootmeldung genau die, die sie seit Runde 59 ist.
fn port() -> u16 {
    let p: u64 = kstate.get(arch.kdata_base(), kstate.SER_PORT)
    if p == 0 {
        return COM1
    }
    return p as u16
}

fn set_port(state: u64, p: u64) {
    kstate.set(state, kstate.SER_PORT, p)
}

// ------------------------------------------------------------ port I/O

// ROUND ARM: these three no longer hold an instruction. They forward
// across the boundary drawn in `kernel/arch/arch.fi`, and the instruction
// lives in `kernel/arch/x86_64/machine.fi` -- the same two lines that stood
// here since round 59, moved once so that a second machine can answer them.
//
// The names and the signatures do NOT change. `serial.out8` and
// `serial.in8` are the port helpers a dozen other modules reach for; making
// them private and rewriting those call sites would have been a second
// change hiding inside the first, and step B of this round is a move with
// no change in behaviour or it is nothing.
//
// This file is the proof of the boundary rather than an example of it: every
// line the kernel says goes through `put` below, so if the forwarding were
// wrong, every one of the twenty-four sections of ./test.sh would go dark at
// once instead of one of them going yellow.

fn out8(port: u16, value: u8) {
    arch.dev_out8(port, value)
}

fn in8(port: u16) -> u8 {
    return arch.dev_in8(port)
}

fn io_wait() {
    arch.dev_io_wait()
}

// ------------------------------------------------------------- output

fn init() {
    let b: u16 = port()
    out8(b + R_IER, 0x00 as u8) // no interrupts
    out8(b + R_LCR, 0x80 as u8) // unlock the divisor
    out8(b + R_DATA, 0x03 as u8) // 38400 baud, low byte
    out8(b + R_IER, 0x00 as u8) // high byte
    out8(b + R_LCR, 0x03 as u8) // 8 bits, no parity, 1 stop bit
    out8(b + R_FCR, 0xC7 as u8) // FIFO on, cleared, 14 bytes
    // RUNDE SERVERBUILD: OUT2 war schon da und ist der Grund, warum der
    // Empfangsweg dieser Runde ueberhaupt geht -- ohne dieses Bit haelt
    // der 8250 seine Unterbrechungsleitung am PC still.
    out8(b + R_MCR, 0x0B as u8) // DTR, RTS, OUT2
}

fn ready() -> bool {
    return (in8(port() + R_LSR) & LSR_TX) != 0 as u8
}

// ------------------------------------------------------- der Rueckweg
//
// SIEBEN ZEILEN, UND SIE SIND DER UNTERSCHIED ZWISCHEN EINEM
// NOTAUSGANG UND EINER KONSOLE. Der Sendeweg steht seit Runde 59; der
// Empfangsweg fehlte, und deshalb war jede Messung dieses Projektes
// bisher entweder ein Skript auf der Befehlszeile oder ein
// Tastendruck, den der Testlaeufer in den QEMU-Monitor schob.

fn rx_ready() -> bool {
    return (in8(port() + R_LSR) & LSR_RX) != 0 as u8
}

// Ein Oktett, oder 256, wenn keines da ist. 256 und nicht 0: die Null
// ist ein gueltiges Oktett (STRG-Leertaste schickt sie).
fn rx_take() -> u64 {
    if !rx_ready() {
        return 256
    }
    return in8(port() + R_DATA) as u64
}

// Ob der Baustein ein Oktett verloren hat, weil niemand es abgeholt
// hat. Das Lesen von LSR loescht die Meldung, also wird sie hier
// gezaehlt und nicht spaeter noch einmal gesucht.
fn overrun() -> bool {
    return (in8(port() + R_LSR) & LSR_OVERRUN) != 0 as u8
}

// Alles wegwerfen, was der Baustein noch haelt. Beim Einschalten der
// Konsole: was VOR dem Start in die Leitung getippt wurde, gehoert
// nicht in die erste Zeile der Shell.
fn drain_fifo() {
    var n: u64 = 0
    while rx_ready() && n < 64 {
        in8(port() + R_DATA)
        n = n + 1
    }
}

fn rx_on() {
    out8(port() + R_IER, IER_RX)
}

fn rx_off() {
    out8(port() + R_IER, 0x00 as u8)
}

fn put(c: u8) {
    while !ready() {
    }
    out8(port(), c)
    // Der Bildschirm. RUNDE K11 HAT HIER EIN MODUL DAZWISCHENGESETZT:
    // `ansi.echo` ist `fb.echo` plus dem Fluchtfolgenautomaten (VT100),
    // ohne den ein bildschirmorientiertes Programm auf dem Schirm nur
    // seine Steuerzeichen zeigt. Es holt sich den Datenbereich ueber das
    // Bindersymbol `kdata` selbst und kehrt genauso sofort zurueck,
    // solange niemand `gfx` auf die Kommandozeile geschrieben hat -- ein
    // `lea` und ein Speicherzugriff je Oktett, auf einem Weg, der ohnehin
    // auf ein 38400-Baud-Tor wartet.
    gfx.echo(c)
}

fn nl() {
    put(10 as u8)
}

// A string in the C sense: everything up to the first zero octet. Firn
// has no string type in the kernel profile (that is in the standard
// library, and that one is barred here), so the kernel writes its texts
// as `[u8; n]` with a closing `\0`.
fn puts(p: u64) {
    var i: u64 = 0
    while true {
        let c: u8 = *((p + i) as *mut u8)
        if c == 0 as u8 {
            return
        }
        put(c)
        i = i + 1
    }
}

// n octets, zeros included -- for buffers that are not terminated.
fn text(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        put(*((p + i) as *mut u8))
        i = i + 1
    }
}

// ------------------------------------------------------------- numbers

fn digit(d: u64) -> u8 {
    if d < 10 {
        return (48 + d) as u8
    }
    return (87 + d) as u8
}

// `0x` and as many digits as the value needs (at least one).
fn hex(v: u64) {
    hex_width(v, hex_digits(v))
}

// How many hex digits the value needs (1..16).
fn hex_digits(v: u64) -> u64 {
    var w: u64 = 1
    var x: u64 = v >> 4
    while x != 0 {
        w = w + 1
        x = x >> 4
    }
    return w
}

// Exactly `w` hex digits, highest first.
fn hex_width(v: u64, w: u64) {
    put(48 as u8)
    put(120 as u8)
    var i: u64 = w
    while i > 0 {
        i = i - 1
        put(digit((v >> (i * 4)) & 15))
    }
}

fn dec(v: u64) {
    pad_dec(v, 0)
}

// Decimal, padded with blanks up to `width` (0 = no padding).
fn pad_dec(v: u64, width: u64) {
    var buf: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        buf[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        buf[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    var pad: u64 = 0
    while pad + n < width {
        put(32 as u8)
        pad = pad + 1
    }
    var i: u64 = n
    while i > 0 {
        i = i - 1
        put(buf[i as usize])
    }
}
