// SPDX-License-Identifier: GPL-2.0-only
// kernel/ntfs-aus.fi -- DER KERN OHNE NTFS.
//
// Justins Vorgabe zur Runde FREMDFS (14.09.2026):
//
//     „ext4- und NTFS-Unterstuetzung sollen einzeln abschaltbar sein.
//      Ist beides aus, muss das System unveraendert laufen und ein
//      Einhaengeversuch einen klaren Fehler geben -- nicht haengen."
//
// Diese Datei ist die Leerfassung von `kernel/ntfs.fi`: DIESELBEN
// exportierten Namen, dieselbe `ops`-Tafel, leere Rümpfe. Der Bau mit
// `--ohne-ntfs` legt sie an die Stelle der echten, und danach steht im
// Baum, aus dem firnc liest, keine Zeile NTFS mehr -- kein `#ifdef`,
// kein Schalter zur Laufzeit, keine tote Verzweigung im Abbild. Das
// ist derselbe Griff wie `wg-aus.fi` (Tunnel), `gfx-aus.fi` (Grafik)
// und `ps2m-aus.fi` (Zeigegeraet); die Begruendung dafuer steht in
// `tools/build-kernel.sh`.
//
// WAS DER BENUTZER DAVON MERKT, und das ist der Punkt: `mount ... ntfs`
// antwortet mit **-ENODEV**, also „Dateisystem nicht unterstuetzt",
// und zwar SOFORT. Es haengt nicht, es liest nichts, es raet nicht.
// `mount_probe` gibt hier 0 zurueck, und `vfs.mount_at` nimmt die
// Einhaengung daraufhin zurueck (die Stelle steht dort im Klartext:
// „Meldet der Treiber keinen Wurzelknoten, war die Platte nicht das,
// was behauptet wurde").
//
// WARUM DIE `ops`-TAFEL TROTZDEM DA IST: `vfs.ops_of` ruft sie fuer
// jede Einhaengung dieser Art, und Firn hat keinen Nullzeiger fuer
// `fn`. Eine Tafel aus Funktionen, die nichts tun, ist die ehrliche
// Fassung von „diesen Treiber gibt es hier nicht" -- und `mask` ist 0,
// also laesst `vfs.can` ohnehin keine einzige Verrichtung durch.
//
// Was das Abschalten WIRKLICH spart, steht gemessen in
// docs/RUNDE-FREMDFS.md -- nicht geschaetzt.

profile kernel

import lib.kstate
import vfsops

export { ops, mount_probe, release, node_hold, node_drop, MAX_NODES }

const MAX_NODES: u64 = 0

// KEINE PLATTE WIRD ANGENOMMEN. Null heisst fuer `vfs.mount_at`:
// dieser Treiber hat keinen Wurzelknoten -- und die Einhaengung wird
// zurueckgenommen, bevor sie steht.
fn mount_probe(state: u64, m: u64) -> u64 {
    return 0
}

fn release(state: u64, m: u64) {
}

fn node_hold(state: u64, node: u64) {
}

fn node_drop(state: u64, node: u64) {
}

fn f_lookup(state: u64, m: u64, path: u64) -> u64 {
    return 0
}

fn f_readdir(state: u64, m: u64, dir: u64, index: u64, out: u64) -> u64 {
    return 0
}

fn f_attr(state: u64, m: u64, node: u64, what: u64) -> u64 {
    return 0
}

fn f_read(state: u64, m: u64, node: u64, off: u64, dst: u64,
    len: u64) -> u64 {
    return 0
}

fn f_write(state: u64, m: u64, node: u64, off: u64, src: u64,
    len: u64) -> u64 {
    return 0
}

fn f_create(state: u64, m: u64, path: u64, art: u64) -> u64 {
    return 0
}

fn f_unlink(state: u64, m: u64, path: u64) -> u64 {
    return 9
}

fn f_rename(state: u64, m: u64, from: u64, to: u64) -> u64 {
    return 9
}

fn f_trunc(state: u64, m: u64, node: u64) -> u64 {
    return 9
}

fn ops() -> vfsops.Ops {
    return vfsops.Ops {
        lookup: f_lookup,
        readdir: f_readdir,
        attr: f_attr,
        read: f_read,
        write: f_write,
        create: f_create,
        unlink: f_unlink,
        rename: f_rename,
        trunc: f_trunc,
        // KEINE EINZIGE VERRICHTUNG. `vfs.can` prueft dieses Feld,
        // BEVOR es einen Zeiger benutzt -- damit kommt hier nichts an,
        // auch wenn eine Einhaengung wider Erwarten zustande kaeme.
        mask: 0,
        tag: 1936020590 // "ntfs"
    }
}
