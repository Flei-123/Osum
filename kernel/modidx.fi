// SPDX-License-Identifier: GPL-2.0-only
// kernel/modidx.fi -- RUNDE MODUL: DIE PLATZNUMMERN EINER TREIBERTAFEL.
//
// Diese Datei ist ABSICHTLICH die kleinste des Kerns: sie hat keine
// einzige Funktion, nur Konstanten. Der Grund ist, dass sie an ZWEI
// Stellen gebraucht wird, die nicht miteinander uebersetzt werden --
//
//   * im Kern, von `kernel/ps2m-aus.fi` (der Stummel, der die Aufrufe
//     an ein geladenes Modul weiterreicht) und von `kernel/modul.fi`
//     (der Lader, der die Tafel fuehrt), und
//   * IM MODUL, von `module/ps2maus.fi`, das seine Adressen dort
//     eintraegt.
//
// Zwischen den beiden liegt die Schnittstelle. Waeren die Nummern zweimal
// aufgeschrieben, waere die erste vertauschte Zeile ein Sprung an die
// falsche Adresse -- also einmal aufgeschrieben und zweimal eingelesen.
// Ein Modul, das gegen eine ANDERE Fassung dieser Datei uebersetzt ist,
// wird an `ksym.ABI` abgewiesen und kommt gar nicht erst zum Springen.
//
// WARUM NUMMERN UND KEINE NAMEN. Der Stummel ruft dreissigmal je
// Bildwiederholung; ein Namensvergleich je Aufruf waere Unfug. Der
// NAMENSVERGLEICH steht an der Stelle, an der er hingehoert -- einmal
// beim Laden, in `modul.bind_name`, und danach ist es eine Zahl.

profile kernel

export {
    MAX_SLOT, SLOT_SPAN, SLOT_MOUSE,
    P_INIT, P_PRESENT, P_IRQ, P_ID, P_X, P_Y, P_BUTTONS, P_WHEEL,
    P_PACKETS, P_DROPS, P_MOVES, P_IRQS, P_POLLS, P_SPURIOUS,
    P_CLICKS, P_STATUS, P_RESET, P_POLL_ONE, P_SET_POLL, P_POLLING,
    P_SET_BOUNDS, P_SET_POS, P_CHANGED, P_TAKE_CHANGE, P_USB_PACKET,
    P_ADOPT, P_SELFTEST, P_SELFTEST_MAX, P_COUNT
}

// Wie viele Steckplaetze es gibt, und wie viele Eintraege einer hat.
// Zwei Steckplaetze, weil ein zweiter (z. B. ein Tontreiber) ohne
// Aenderung dieser Datei dazukaeme; 64 Eintraege, weil das eine halbe
// Seite `kdata` ist und der groesste Treiber dieses Kerns 41 Funktionen
// hat.
const MAX_SLOT: u64 = 2
const SLOT_SPAN: u64 = 64

// Steckplatz 0 ist das Zeigegeraet.
const SLOT_MOUSE: u64 = 0

// Die achtundzwanzig Verrichtungen von `kernel/ps2m.fi`, in der
// Reihenfolge, in der sie dort im `export`-Block stehen. NEUE EINTRAEGE
// KOMMEN HINTEN DRAN, nie dazwischen -- und wer die Reihenfolge doch
// aendert, erhoeht `ksym.ABI`.
const P_INIT: u64 = 0 // (state, w, h) -> bool
const P_PRESENT: u64 = 1 // (state) -> bool
const P_IRQ: u64 = 2 // (state)
const P_ID: u64 = 3 // (state) -> u64
const P_X: u64 = 4 // (state) -> u64
const P_Y: u64 = 5 // (state) -> u64
const P_BUTTONS: u64 = 6 // (state) -> u64
const P_WHEEL: u64 = 7 // (state) -> u64
const P_PACKETS: u64 = 8 // (state) -> u64
const P_DROPS: u64 = 9 // (state) -> u64
const P_MOVES: u64 = 10 // (state) -> u64
const P_IRQS: u64 = 11 // (state) -> u64
const P_POLLS: u64 = 12 // (state) -> u64
const P_SPURIOUS: u64 = 13 // (state) -> u64
const P_CLICKS: u64 = 14 // (state) -> u64
const P_STATUS: u64 = 15 // () -> u64
const P_RESET: u64 = 16 // (state)
const P_POLL_ONE: u64 = 17 // (state) -> bool
const P_SET_POLL: u64 = 18 // (state, bool)
const P_POLLING: u64 = 19 // (state) -> bool
const P_SET_BOUNDS: u64 = 20 // (state, w, h)
const P_SET_POS: u64 = 21 // (state, x, y)
const P_CHANGED: u64 = 22 // (state) -> bool
const P_TAKE_CHANGE: u64 = 23 // (state) -> bool
const P_USB_PACKET: u64 = 24 // (state, b0, b1, b2, b3, bool)
const P_ADOPT: u64 = 25 // (state, w, h)
const P_SELFTEST: u64 = 26 // (state) -> u64
const P_SELFTEST_MAX: u64 = 27 // () -> u64

// Wie viele es sind. Der Stummel prueft beim Weiterreichen gegen diese
// Zahl, damit ein Modul, das aus Versehen an Platz 91 schreibt, keine
// fremden Oktette trifft.
const P_COUNT: u64 = 28
