// ==================================================== RUNDE SYSTEMBUS
//
// VIER PROGRAMME, und sie messen zusammen die vier Zusagen der Runde:
//
//   P_BUSA  der Schreiber. Meldet den Dienst `probe` an, legt hundertmal
//           einen Text mit bekannter Pruefsumme in die Zwischenablage
//           und sagt dem Leser jedes Mal Bescheid.
//   P_BUSB  der Leser. Liest hundertmal, rechnet die Pruefsumme selbst
//           und antwortet mit ihr. `busa: abw=0` ist Zusage a).
//   P_BUSD  der Unberechtigte. Wechselt auf uid 1000 und ruft einen
//           Dienst, der nur root gehoert. Muss -3 bekommen -- und der
//           Kern muss es auf die Leitung schreiben.
//   P_BUSS  ein Megabyte durch ein Segment, mit der Uhr daneben.
const P_BUSA: u64 = 60
const P_BUSB: u64 = 61
const P_BUSD: u64 = 62
const P_BUSS: u64 = 63
// RUNDE SCHLAF (K-018, zweite Haelfte): DER PROZESS, DER DEN SCHLAF
// UEBERLEBEN UND DANACH WEITERRECHNEN MUSS.
//
// Er ist die Zusage, die Register und Seitentabellen wirklich prueft.
// Ein Prozess, der nach dem Aufwachen nur noch EXISTIERT, beweist
// nichts -- er koennte neu angelegt worden sein. Dieser hier fuehrt
// eine LAUFENDE Rechnung in seiner privaten Seite:
//
//     summe = summe + schritt,  schritt = schritt + 1
//
// Vor dem Schlafen rechnet er bis zu einem bekannten Stand. Nach dem
// Aufwachen muss er GENAU DORT weitermachen -- nicht bei null. Das
// geht nur, wenn seine Datenseite auf demselben Rahmen wieder liegt
// UND seine Seitentabelle dorthin zeigt.
const P_SCHLAF: u64 = 64
// Die Kennung in der privaten Seite. Als Konstante und nicht als
// Literal im Vergleich: firnc liest ein nacktes Literal dieser Groesse
// als i32 und weist es ab (gemessen: "integer literal ... does not fit
// into the type i32").
const SCHLAF_TAG: u64 = 0x5343484C41465521

