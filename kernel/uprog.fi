// kernel/uprog.fi -- round 62: the programs that run in ring 3.
//
// This file is FIRN, and it is compiled into an OBJECT FILE OF ITS OWN.
// The linker script puts its code on pages of its own between
// `__user_begin` and `__user_end`, and the kernel sets the user bit for
// exactly those pages. That is the whole reason for the separate
// translation unit: a function that lay in the middle of the kernel's
// text could not be made reachable for ring 3 without handing the kernel
// over with it.
//
// Two rules follow from that, and both are checked in
// `tools/kernel/run.sh`:
//
//   1. NOTHING out of the kernel may be called here. No import, no
//      `serial.puts` -- the object file has to be free of undefined names
//      just like the kernel's, and everything it needs it does itself.
//   2. Everything the program says goes through a SYSTEM CALL. That is
//      the only door out of ring 3, and it is the door this round built.
//
// Round 59 had its user program in assembly, in `isr.s`, and the reason
// given was that a compiled function would sit in the middle of the
// kernel. That reason is gone -- what is left is a linker script with
// three lines more, and the user program is a language away from the
// kernel instead of an instruction set.

profile kernel

export { u_enter }

// The system call numbers, see sys.fi. 1 and 2 belong to the excursion of
// round 59 and stay what they were.
// ROUND K4: the numbers of Linux x86-64 (`kernel/sys.fi`). What
// round 62 called 11 is 1 now, and what it called 20 does not exist any
// more -- a directory is read with `getdents64` out of a descriptor, the
// way every Unix has read one since 1986.
const SYS_READ: u64 = 0
const SYS_WRITE: u64 = 1
const SYS_OPEN: u64 = 2
const SYS_CLOSE: u64 = 3
const SYS_GETDENTS64: u64 = 217
const SYS_MKDIR: u64 = 83
const SYS_UNLINK: u64 = 87
const SYS_GETPID: u64 = 39
const SYS_GETPPID: u64 = 110
const SYS_YIELD: u64 = 24
const SYS_NANOSLEEP: u64 = 35
const SYS_WAIT4: u64 = 61
const SYS_EXIT: u64 = 60
// The two Osum has of its own: a program that travels in the kernel image
// has no file, so no `execve` can start it.
const SYS_SPAWN: u64 = 1000

// Die native ABI (`kernel/sys.fi`, `kernel/cap.fi`) -- portiert aus
// OrientOS' `libs/osum-abi-native`. Nummern 2000 + n, Fehler NEGATIV und
// aus einer eigenen Liste (nicht errno).
const CAP_VERSION: u64 = 2000
const CAP_READ: u64 = 2001
const CAP_WRITE: u64 = 2002
const CAP_CLOSE: u64 = 2003
const CAP_DUP: u64 = 2004
const CAP_INSPECT: u64 = 2005
const CAP_TRANSFER: u64 = 2006
const CAP_COUNT: u64 = 2007

const E_BADHANDLE: u64 = 1
const E_RIGHTS: u64 = 2
const E_NOTFOUND: u64 = 3
const E_INVALID: u64 = 4
const E_EXHAUSTED: u64 = 5

const R_READ: u64 = 1
const R_WRITE: u64 = 2
const R_DUPLICATE: u64 = 8
const R_TRANSFER: u64 = 16
const R_INSPECT: u64 = 32
const R_ALL: u64 = 1023

const O_WRONLY: u64 = 1
const O_CREAT: u64 = 64
const O_DIRECTORY: u64 = 65536

const DT_DIR: u64 = 4

const OUT: u64 = 1 // the console

// The private page every process has at the same address and on a frame
// of its own (proc.fi).
const USER_DATA: u64 = 0x40000000

// The programs. The number arrives in the upper half of the first
// argument, whatever the creator wanted to say in the lower half.
const P_HELLO: u64 = 1
const P_MEMORY: u64 = 2
const P_FAULT: u64 = 3
const P_BADPTR: u64 = 4
const P_CHILD: u64 = 5
const P_PARENT: u64 = 6
const P_FILES: u64 = 7
const P_SHELL: u64 = 8
const P_STEAL: u64 = 9
const P_FORK: u64 = 10
const P_FORKCHILD: u64 = 11
const P_CAPS: u64 = 12

// ------------------------------------------------------ the system call

// rax = number, rdi/rsi/rdx = the three arguments, rax = result.
// `syscall` destroys rcx and r11 -- the processor puts the return address
// and the flags in them.
fn u_sys(number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    return asm("syscall", out("rax"), in("rax") number, in("rdi") a0,
        in("rsi") a1, in("rdx") a2, clobber("rcx"), clobber("r11"),
        clobber("memory"))
}

// ------------------------------------------------------------- output

fn u_length(p: u64) -> u64 {
    var n: u64 = 0
    while *((p + n) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    return n
}

fn u_say(p: u64) -> u64 {
    return u_sys(SYS_WRITE, OUT, p, u_length(p))
}

// A number, without a standard library: the digits are produced
// backwards and turned around. Negative results of a system call (an
// error code) are printed with a minus.
//
// THE MINUS IS A REINTERPRETATION, NOT A SUBTRACTION. What arrives is the
// bit pattern of a negative `i64` in a `u64` register (`sys.fi` builds it
// with `0 -% e` for exactly that reason), and turning it back into its
// magnitude is the two's complement negation -- which is `0 -% v`. Round 72
// made plain `-` a CHECKED subtraction, and `0 - v` underflows for every
// value this branch can ever see. `sys.fi` was moved to `-%` back then;
// this file is a translation unit of its own and was missed.
//
// What that costs here is worse than a wrong number, and it is why this
// paragraph is long: the check calls `osum_panic`, and `osum_panic` lives
// in `isr.s`, in the kernel's text, on a page WITHOUT the user bit. A
// program in ring 3 that reaches it dies of a #PF at the panic handler's
// own address -- no message, and a report that names the fault instead of
// the arithmetic that caused it.
fn u_say_num(v: u64) {
    var buf: [u8; 24] = [0 as u8; 24]
    var value: u64 = v
    var at: u64 = 0
    if (v >> 63) != 0 {
        buf[0] = 45 as u8 // '-'
        at = 1
        value = 0 -% v
    }
    var digits: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    if value == 0 {
        digits[0] = 48 as u8
        n = 1
    }
    while value > 0 {
        digits[n as usize] = (48 + value % 10) as u8
        value = value / 10
        n = n + 1
    }
    var i: u64 = n
    while i > 0 {
        i = i - 1
        buf[at as usize] = digits[i as usize]
        at = at + 1
    }
    buf[at as usize] = 0 as u8
    u_sys(SYS_WRITE, OUT, (&buf[0]) as u64, at)
}

// `nanosleep` takes a `struct timespec`: eight octets of seconds, eight of
// nanoseconds. Everything in this file used to say milliseconds, so this
// is the one place that converts -- and the one place that can hand the
// kernel an absurd number on purpose (`u_badptr`).
fn u_sleep(sec: u64, ms: u64) -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    ts[0] = sec
    ts[1] = ms * 1000000
    return u_sys(SYS_NANOSLEEP, (&ts[0]) as u64, 0, 0)
}

fn u_say_line(p: u64, v: u64) {
    var nl: [u8; 2] = "\n\0"
    u_say(p)
    u_say_num(v)
    u_say((&nl[0]) as u64)
}

// ------------------------------------------------------------- the entry

// The one entry point of every user program (`USER_MAIN` in isr.s).
// rdi = (program << 32) | argument.
fn u_enter(packed: u64) {
    let prog: u64 = packed >> 32
    let arg: u64 = packed & 0xFFFFFFFF
    if prog == P_HELLO {
        u_hello(arg)
    }
    if prog == P_MEMORY {
        u_memory(arg)
    }
    if prog == P_FAULT {
        u_fault(arg)
    }
    if prog == P_BADPTR {
        u_badptr(arg)
    }
    if prog == P_CHILD {
        u_child(arg)
    }
    if prog == P_PARENT {
        u_parent(arg)
    }
    if prog == P_STEAL {
        u_steal(arg)
    }
    if prog == P_SHELL {
        u_shell(arg)
    }
    if prog == P_FORK {
        u_fork(arg)
    }
    if prog == P_FORKCHILD {
        u_forkchild(arg)
    }
    if prog == P_CAPS {
        u_caps(arg)
    }
    u_sys(SYS_EXIT, 0, 0, 0)
    while true {
    }
}

// ------------------------------------------------------- the programs

// The smallest one that proves anything: it says who it is, and its exit
// code is its pid. The kernel reads that code back with `wait`.
fn u_hello(arg: u64) {
    var s: [u8; 15] = "user: hello #\0\0"
    var s_pid: [u8; 12] = "user: pid=\0\0"
    u_say_line((&s[0]) as u64, arg)
    let pid: u64 = u_sys(SYS_GETPID, 0, 0, 0)
    u_say_line((&s_pid[0]) as u64, pid)
    u_sys(SYS_EXIT, pid, 0, 0)
}

// THE PROOF OF POINT 2. Two processes run this at the same time, with
// different arguments. Both write to the SAME address, both read from it
// afterwards -- and each one gets its own value back. If they shared a
// frame, the second one would overwrite the first one's value, and the
// sleep in between makes sure it would have the chance to.
fn u_memory(arg: u64) {
    var s_wrote: [u8; 18] = "user: wrote here \0"
    var s_read: [u8; 17] = "user: read here \0"
    let p: *mut u64 = USER_DATA as *mut u64
    __mmio_write64(p, arg)
    u_say_line((&s_wrote[0]) as u64, arg)
    u_sleep(0, 40) // 40 ms: let the other one write
    let back: u64 = __mmio_read64(p)
    u_say_line((&s_read[0]) as u64, back)
    var ok: u64 = 1
    if back != arg {
        ok = 0
    }
    u_sys(SYS_EXIT, ok, 0, 0)
}

// THE COUNTER-CHECK to it: whatever is not mine gives a #PF. The address
// is the kernel's own text, 1 MiB, and it is mapped in every address
// space -- but without the user bit. Ring 3 must not see it.
fn u_fault(arg: u64) {
    var s: [u8; 30] = "user: touching kernel memory\n\0"
    u_say((&s[0]) as u64)
    let stolen: u64 = __mmio_read64(0x100000 as *mut u64)
    // Not reached: the process is dead by now.
    var s_bad: [u8; 30] = "user: READ THE KERNEL, bad\n\0\0\0"
    u_say((&s_bad[0]) as u64)
    u_sys(SYS_EXIT, stolen, 0, 0)
}

// The same thing one storey higher: a pointer into the kernel handed to
// a system call. The kernel must not follow it -- it has to answer with
// -EFAULT and stay alive.
fn u_badptr(arg: u64) {
    var s: [u8; 22] = "user: write(kernel)=\0\0"
    var s2: [u8; 20] = "user: write(nil)=\0\0\0"
    var s3: [u8; 20] = "user: read(badfd)=\0\0"
    var s4: [u8; 15] = "user: nosys=\0\0\0"
    var s5: [u8; 20] = "user: sleep(1000s)=\0"
    u_say_line((&s[0]) as u64, u_sys(SYS_WRITE, OUT, 0x100000, 8))
    u_say_line((&s2[0]) as u64, u_sys(SYS_WRITE, OUT, 0, 8))
    u_say_line((&s3[0]) as u64, u_sys(SYS_READ, 77, USER_DATA, 8))
    u_say_line((&s4[0]) as u64, u_sys(999, 0, 0, 0))
    u_say_line((&s5[0]) as u64, u_sleep(1000, 0))
    u_sys(SYS_EXIT, 7, 0, 0)
}

// A child that says something and ends with a code of its own.
fn u_child(arg: u64) {
    var s: [u8; 17] = "user: child arg=\0"
    u_say_line((&s[0]) as u64, arg)
    u_sleep(0, 20)
    u_sys(SYS_EXIT, 40 + arg, 0, 0)
}

// The parent: it creates two children, waits for both and passes their
// exit codes on. `spawn` and `wait` seen from ring 3.
fn u_parent(arg: u64) {
    var s_sp: [u8; 18] = "user: spawned pid\0"
    var s_w: [u8; 18] = "user: child exit=\0"
    var s_bad: [u8; 18] = "user: wait(bad)=\0\0"
    let a: u64 = u_sys(SYS_SPAWN, P_CHILD, 1, 0)
    let b: u64 = u_sys(SYS_SPAWN, P_CHILD, 2, 0)
    u_say_line((&s_sp[0]) as u64, a)
    u_say_line((&s_sp[0]) as u64, b)
    u_say_line((&s_w[0]) as u64, u_wait(a))
    u_say_line((&s_w[0]) as u64, u_wait(b))
    // A child that is not one: the answer is an error, not a hang.
    u_say_line((&s_bad[0]) as u64, u_wait(999))
    u_sys(SYS_EXIT, 3, 0, 0)
}

// ROUND K4. `wait4` hands back the PID and writes a STATUS, the way Linux
// does -- round 62's `wait` returned the exit code itself, and a caller
// could not tell -1 from a child that left with 255. The code sits in bits
// 8..15 of the status; what this function returns is what the old one
// returned, so that the measurements of round 62 go on measuring the same
// thing.
fn u_wait(pid: u64) -> u64 {
    var status: [u64; 1] = [0 as u64; 1]
    let r: u64 = u_sys(SYS_WAIT4, pid, (&status[0]) as u64, 0)
    if (r >> 63) != 0 {
        return r
    }
    return (status[0] >> 8) & 255
}

// The last counter-check of point 2: an address that lies in the private
// region but was never mapped. Between the two pages of the process and
// the end of its region there is nothing -- and nothing is not readable.
fn u_steal(arg: u64) {
    var s: [u8; 28] = "user: touching 0x40010000\n\0\0"
    u_say((&s[0]) as u64)
    let stolen: u64 = __mmio_read64(0x40010000 as *mut u64)
    u_sys(SYS_EXIT, stolen, 0, 0)
}

// THE FORK-LIKE HALF OF `spawn`: the child inherits the CONTENTS of the
// parent's data page -- on a frame of its own. Both are proved here in
// one run: the child sees the parent's value (inheritance), overwrites
// it, and afterwards the parent still reads its own (separation).
fn u_fork(arg: u64) {
    var s_wrote: [u8; 20] = "user: parent wrote \0"
    var s_still: [u8; 24] = "user: parent still has \0"
    var s_code: [u8; 23] = "user: fork child exit=\0"
    let p: *mut u64 = USER_DATA as *mut u64
    __mmio_write64(p, 12345)
    u_say_line((&s_wrote[0]) as u64, 12345)
    let pid: u64 = u_sys(SYS_SPAWN, P_FORKCHILD, 0, 0)
    let code: u64 = u_wait(pid)
    u_say_line((&s_code[0]) as u64, code)
    let mine: u64 = __mmio_read64(p)
    u_say_line((&s_still[0]) as u64, mine)
    u_sys(SYS_EXIT, mine, 0, 0)
}

fn u_forkchild(arg: u64) {
    var s_in: [u8; 23] = "user: child inherited \0"
    let p: *mut u64 = USER_DATA as *mut u64
    let got: u64 = __mmio_read64(p)
    u_say_line((&s_in[0]) as u64, got)
    __mmio_write64(p, 999) // this must NOT reach the parent
    var code: u64 = 6
    if got == 12345 {
        code = 5
    }
    u_sys(SYS_EXIT, code, 0, 0)
}

// --------------------------------------------------------------- the shell
//
// POINT 5 OF THE ROUND: a command line in ring 3. It can do nothing on
// its own -- no file, no directory, not even its own output. Every one of
// the six commands is one or more system calls, and that is the point:
// what the kernel built underneath is enough to write a program on top of
// it that is useful for something.
//
// The input comes from descriptor 0. In the test that is what the boot
// loader was given on the command line (`script=ls;cat /hello.txt`); on a
// machine with a keyboard it would be the keyboard. The shell does not
// notice the difference -- it reads a line and does what it says.

fn u_streq(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while i < 64 {
        let x: u64 = (*((a + i) as *mut u8)) as u64
        let y: u64 = (*((b + i) as *mut u8)) as u64
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return true
}

// The next word out of `line` from `at` on into `out`. Returns the
// position behind it; leading blanks are skipped.
fn u_word(line: u64, at: u64, out: u64, max: u64) -> u64 {
    var i: u64 = at
    while *((line + i) as *mut u8) == 32 as u8 {
        i = i + 1
    }
    var n: u64 = 0
    while *((line + i) as *mut u8) != 0 as u8 {
        if *((line + i) as *mut u8) == 32 as u8 {
            __mmio_write8((out + n) as *mut u8, 0 as u8)
            return i
        }
        if n + 1 < max {
            __mmio_write8((out + n) as *mut u8, *((line + i) as *mut u8))
            n = n + 1
        }
        i = i + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return i
}

fn u_shell(arg: u64) {
    var line: [u8; 128] = [0 as u8; 128]
    var word: [u8; 32] = [0 as u8; 32]
    var s_hi: [u8; 22] = "sh: ready, type away\n\0"
    var s_prompt: [u8; 6] = "sh$ \0\0"
    var s_bye: [u8; 9] = "sh: bye\n\0"
    var s_what: [u8; 17] = "sh: what is \0\0\0\0\0"
    var s_nl: [u8; 2] = "\n\0"
    var c_ls: [u8; 3] = "ls\0"
    var c_cat: [u8; 4] = "cat\0"
    var c_echo: [u8; 5] = "echo\0"
    var c_write: [u8; 6] = "write\0"
    var c_rm: [u8; 3] = "rm\0"
    var c_mkdir: [u8; 6] = "mkdir\0"
    var c_exit: [u8; 5] = "exit\0"

    u_say((&s_hi[0]) as u64)
    var commands: u64 = 0
    var running: bool = true
    while running {
        let n: u64 = u_sys(SYS_READ, 0, (&line[0]) as u64, 120)
        if n == 0 || (n >> 63) != 0 {
            running = false
        } else {
            // The newline belongs to the line, not to the command.
            var len: u64 = n
            while len > 0 && line[(len - 1) as usize] <= 32 as u8 {
                len = len - 1
            }
            line[len as usize] = 0 as u8
            u_say((&s_prompt[0]) as u64)
            u_say((&line[0]) as u64)
            u_say((&s_nl[0]) as u64)
            if len > 0 {
                commands = commands + 1
                let at: u64 = u_word((&line[0]) as u64, 0, (&word[0]) as u64, 32)
                if u_streq((&word[0]) as u64, (&c_ls[0]) as u64) {
                    u_ls((&line[0]) as u64, at)
                } else {
                    if u_streq((&word[0]) as u64, (&c_cat[0]) as u64) {
                        u_cat((&line[0]) as u64, at)
                    } else {
                        if u_streq((&word[0]) as u64, (&c_echo[0]) as u64) {
                            u_echo((&line[0]) as u64, at)
                        } else {
                            if u_streq((&word[0]) as u64, (&c_write[0]) as u64) {
                                u_write_file((&line[0]) as u64, at)
                            } else {
                                if u_streq((&word[0]) as u64, (&c_rm[0]) as u64) {
                                    u_rm((&line[0]) as u64, at)
                                } else {
                                    if u_streq((&word[0]) as u64, (&c_mkdir[0]) as u64) {
                                        u_mkdir((&line[0]) as u64, at)
                                    } else {
                                        if u_streq((&word[0]) as u64, (&c_exit[0]) as u64) {
                                            running = false
                                        } else {
                                            u_say((&s_what[0]) as u64)
                                            u_say((&word[0]) as u64)
                                            u_say((&s_nl[0]) as u64)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    u_say((&s_bye[0]) as u64)
    u_sys(SYS_EXIT, commands, 0, 0)
}

// `ls [path]` -- every entry of a directory. ROUND K4: a directory is
// OPENED and read with `getdents64`, entry after entry, out of a buffer
// that holds as many records as fit. The record is Linux's:
//
//     +0 d_ino  +8 d_off  +16 d_reclen  +18 d_type  +19 the name
//
// `d_reclen` is what walks the buffer -- a reader that counted on a fixed
// size would be wrong at the first long name.
fn u_ls(line: u64, at: u64) {
    var path: [u8; 64] = [0 as u8; 64]
    var buf: [u8; 512] = [0 as u8; 512]
    var s_slash: [u8; 2] = "/\0"
    var s_sp: [u8; 2] = " \0"
    var s_nl: [u8; 2] = "\n\0"
    var s_err: [u8; 19] = "sh: ls failed \0\0\0\0\0"
    u_word(line, at, (&path[0]) as u64, 64)
    if path[0] == 0 as u8 {
        path[0] = 47 as u8
        path[1] = 0 as u8
    }
    let fd: u64 = u_sys(SYS_OPEN, (&path[0]) as u64, O_DIRECTORY, 0)
    if (fd >> 63) != 0 {
        u_say_line((&s_err[0]) as u64, fd)
        return
    }
    var going: bool = true
    while going {
        let n: u64 = u_sys(SYS_GETDENTS64, fd, (&buf[0]) as u64, 512)
        if n == 0 || (n >> 63) != 0 {
            going = false
        } else {
            var seen: u64 = 0
            while seen < n {
                let rec: u64 = ((&buf[0]) as u64) + seen
                let reclen: u64 = __mmio_read16((rec + 16) as *mut u16) as u64
                let kind: u64 = __mmio_read8((rec + 18) as *mut u8) as u64
                u_say(rec + 19)
                if kind == DT_DIR {
                    u_say((&s_slash[0]) as u64)
                }
                u_say((&s_sp[0]) as u64)
                seen = seen + reclen
            }
        }
    }
    u_sys(SYS_CLOSE, fd, 0, 0)
    u_say((&s_nl[0]) as u64)
}

// `cat path` -- open, read in pieces, write out, close.
fn u_cat(line: u64, at: u64) {
    var path: [u8; 64] = [0 as u8; 64]
    var buf: [u8; 64] = [0 as u8; 64]
    var s_err: [u8; 18] = "sh: cat failed \0\0\0"
    u_word(line, at, (&path[0]) as u64, 64)
    let fd: u64 = u_sys(SYS_OPEN, (&path[0]) as u64, 0, 0)
    if (fd >> 63) != 0 {
        u_say_line((&s_err[0]) as u64, fd)
        return
    }
    var going: bool = true
    while going {
        let n: u64 = u_sys(SYS_READ, fd, (&buf[0]) as u64, 64)
        if n == 0 || (n >> 63) != 0 {
            going = false
        } else {
            u_sys(SYS_WRITE, OUT, (&buf[0]) as u64, n)
        }
    }
    u_sys(SYS_CLOSE, fd, 0, 0)
}

// `echo rest of the line`
fn u_echo(line: u64, at: u64) {
    var s_nl: [u8; 2] = "\n\0"
    var i: u64 = at
    while *((line + i) as *mut u8) == 32 as u8 {
        i = i + 1
    }
    u_say(line + i)
    u_say((&s_nl[0]) as u64)
}

// `write path text` -- creates the file if it is not there.
fn u_write_file(line: u64, at: u64) {
    var path: [u8; 64] = [0 as u8; 64]
    var s_err: [u8; 20] = "sh: write failed \0\0\0"
    var s_ok: [u8; 14] = "sh: written \0\0"
    var s_nl: [u8; 2] = "\n\0"
    let next: u64 = u_word(line, at, (&path[0]) as u64, 64)
    var i: u64 = next
    while *((line + i) as *mut u8) == 32 as u8 {
        i = i + 1
    }
    let fd: u64 = u_sys(SYS_OPEN, (&path[0]) as u64, O_CREAT | O_WRONLY, 0)
    if (fd >> 63) != 0 {
        u_say_line((&s_err[0]) as u64, fd)
        return
    }
    let len: u64 = u_length(line + i)
    var wrote: u64 = 0
    if len > 0 {
        wrote = u_sys(SYS_WRITE, fd, line + i, len)
        u_sys(SYS_WRITE, fd, (&s_nl[0]) as u64, 1)
    }
    u_sys(SYS_CLOSE, fd, 0, 0)
    u_say_line((&s_ok[0]) as u64, wrote)
}

fn u_rm(line: u64, at: u64) {
    var path: [u8; 64] = [0 as u8; 64]
    var s: [u8; 12] = "sh: rm \0\0\0\0\0"
    u_word(line, at, (&path[0]) as u64, 64)
    u_say_line((&s[0]) as u64, u_sys(SYS_UNLINK, (&path[0]) as u64, 0, 0))
}

fn u_mkdir(line: u64, at: u64) {
    var path: [u8; 64] = [0 as u8; 64]
    var s: [u8; 14] = "sh: mkdir \0\0\0\0"
    u_word(line, at, (&path[0]) as u64, 64)
    u_say_line((&s[0]) as u64, u_sys(SYS_MKDIR, (&path[0]) as u64, 0, 0))
}

// ------------------------------------------- Runde OSUM-CAP: Handles
//
// Das Gegenstueck zu `kernel/cap.fi` in RING 3. Es beweist nicht, dass
// eine Tabelle im Kernel richtig rechnet -- das koennte der Kernel auch
// selbst behaupten. Es beweist, dass ein UNPRIVILEGIERTES Programm
// jenseits des Schutzwalls genau so viel darf, wie in seinem Handle
// steht, und keinen Schritt mehr.
//
// Was dieses Programm bekommen hat: EIN Handle auf die Konsole, mit
// Schreib-, Vervielfaeltigungs-, Uebertragungs- und Auskunftsrecht --
// und ABSICHTLICH OHNE Leserecht. Seine Tabelle hat sonst nichts drin;
// eine frische Tabelle ist leer (`proc.create_cap`).
//
// Der Bericht selbst geht durch das Handle. Das ist Absicht: waere die
// Capability-Schicht kaputt, gaebe es keine Ausgabe statt einer
// falschen.

fn c_write(h: u64, p: u64, n: u64) -> u64 {
    return u_sys(CAP_WRITE, h, p, n)
}

fn c_say(h: u64, p: u64) {
    c_write(h, p, u_length(p))
}

// Eine Zahl durch das Handle. Negative Werte sind Fehlercodes der
// nativen ABI; `0 -% v` ist die Umdeutung des Zweierkomplements und
// nicht etwa eine Subtraktion (Runde 72).
fn c_num(h: u64, v: u64) {
    var buf: [u8; 24] = [0 as u8; 24]
    var digits: [u8; 24] = [0 as u8; 24]
    var value: u64 = v
    var at: u64 = 0
    if (v >> 63) != 0 {
        buf[0] = 45 as u8
        at = 1
        value = 0 -% v
    }
    var n: u64 = 0
    if value == 0 {
        digits[0] = 48 as u8
        n = 1
    }
    while value > 0 {
        digits[n as usize] = (48 + value % 10) as u8
        value = value / 10
        n = n + 1
    }
    var i: u64 = n
    while i > 0 {
        i = i - 1
        buf[at as usize] = digits[i as usize]
        at = at + 1
    }
    buf[at as usize] = 0 as u8
    c_write(h, (&buf[0]) as u64, at)
}

// Eine Zusage: Name, gemessener Wert, erwarteter Wert. Sie wird als
// Zeile gemeldet, damit der Testlaeufer auf dem Wirt jede EINZELN
// nachlesen kann -- eine Sammelzahl allein waere zu leicht.
fn c_claim(h: u64, name: u64, got: u64, want: u64) -> u64 {
    var s_ok: [u8; 10] = "  [ ok ] \0"
    var s_no: [u8; 10] = "  [FAIL] \0"
    var s_got: [u8; 8] = "   got=\0"
    var s_want: [u8; 7] = " want=\0"
    var s_nl: [u8; 2] = "\n\0"
    if got == want {
        c_say(h, (&s_ok[0]) as u64)
        c_say(h, name)
        c_say(h, (&s_nl[0]) as u64)
        return 1
    }
    c_say(h, (&s_no[0]) as u64)
    c_say(h, name)
    c_say(h, (&s_got[0]) as u64)
    c_num(h, got)
    c_say(h, (&s_want[0]) as u64)
    c_num(h, want)
    c_say(h, (&s_nl[0]) as u64)
    return 0
}

// Der Bericht ist in drei Funktionen geteilt, und das hat einen Grund,
// den man dem Quelltext sonst nicht ansieht: firnc1 erzeugt fuer EINE
// grosse Funktion unverhaeltnismaessig viel Code (aus 46 KiB wurden durch
// diese Teilung 20). Das ist hier keine Kosmetik -- `.utext` muss in EINE
// 2-MiB-Kachel passen, weil `proc.map_programs` genau eine geteilte
// Seitentabelle (`kstate.PT_OFF`, Platz 0) dafuer hat. Waechst der
// Abschnitt darueber hinaus, ueberschreibt die zweite Teilung die erste
// und der Kernel steht. tools/boot/run.sh misst diese Grenze.

// 1. Was das Handle KANN.
fn u_caps_kann(h: u64) -> u64 {
    var n_ver: [u8; 8] = "version\0"
    var n_one: [u8; 13] = "count-is-one\0"
    var n_write: [u8; 9] = "write-ok\0"
    var n_inspect: [u8; 8] = "inspect\0"
    var s_probe: [u8; 2] = "x\0"
    var info: [u64; 2] = [0 as u64; 2]
    var ok: u64 = 0
    ok = ok + c_claim(h, (&n_ver[0]) as u64, u_sys(CAP_VERSION, 0, 0, 0), 1)
    ok = ok + c_claim(h, (&n_one[0]) as u64, u_sys(CAP_COUNT, 0, 0, 0), 1)
    ok = ok + c_claim(h, (&n_write[0]) as u64,
        c_write(h, (&s_probe[0]) as u64, 0), 0)
    let insp: u64 = u_sys(CAP_INSPECT, h, (&info[0]) as u64, 0)
    ok = ok + c_claim(h, (&n_inspect[0]) as u64, insp | info[0], 1)
    return ok
}

// 2. Was es NICHT kann -- und dass jedes Nein seinen eigenen Grund nennt.
fn u_caps_nicht(h: u64) -> u64 {
    var n_read: [u8; 12] = "read-denied\0"
    var n_zero: [u8; 12] = "handle-zero\0"
    var n_forge: [u8; 11] = "forged-gen\0"
    var n_slot: [u8; 11] = "slot-range\0"
    var n_unknown: [u8; 11] = "unknown-nr\0"
    var n_trans: [u8; 15] = "transfer-nopid\0"
    var s_probe: [u8; 2] = "x\0"
    let p: u64 = (&s_probe[0]) as u64
    var ok: u64 = 0
    // DER KERN DER SACHE: ein GUELTIGES Handle ohne das noetige Recht ist
    // ein ANDERER Fehler als ein gefaelschtes. POSIX kennt fuer beides
    // nur -EBADF.
    ok = ok + c_claim(h, (&n_read[0]) as u64,
        u_sys(CAP_READ, h, p, 1), 0 -% E_RIGHTS)
    ok = ok + c_claim(h, (&n_zero[0]) as u64,
        u_sys(CAP_WRITE, 0, p, 1), 0 -% E_BADHANDLE)
    ok = ok + c_claim(h, (&n_forge[0]) as u64,
        u_sys(CAP_WRITE, h ^ 0x100000000, p, 1), 0 -% E_BADHANDLE)
    ok = ok + c_claim(h, (&n_slot[0]) as u64,
        u_sys(CAP_WRITE, (h & 0xFFFFFFFF00000000) | 99, p, 1),
        0 -% E_BADHANDLE)
    ok = ok + c_claim(h, (&n_unknown[0]) as u64,
        u_sys(2999, 0, 0, 0), 0 -% E_INVALID)
    ok = ok + c_claim(h, (&n_trans[0]) as u64,
        u_sys(CAP_TRANSFER, h, R_WRITE, 4242), 0 -% E_NOTFOUND)
    return ok
}

// 3. Weitergeben, schliessen, und die volle Tabelle.
fn u_caps_weiter(h: u64) -> u64 {
    var n_dup: [u8; 9] = "dup-less\0"
    var n_dupw: [u8; 10] = "dup-write\0"
    var n_dupd: [u8; 10] = "dup-nodup\0"
    var n_close: [u8; 6] = "close\0"
    var n_after: [u8; 12] = "after-close\0"
    var n_twice: [u8; 12] = "close-twice\0"
    var n_exh: [u8; 10] = "exhausted\0"
    var n_alive: [u8; 6] = "alive\0"
    var s_probe: [u8; 2] = "x\0"
    let p: u64 = (&s_probe[0]) as u64
    var ok: u64 = 0
    // Vervielfaeltigen, aber NUR mit Schreibrecht: die Kopie kann danach
    // weniger als das Original, und aus ihr laesst sich das Verlorene
    // nicht zurueckholen.
    let kopie: u64 = u_sys(CAP_DUP, h, R_WRITE, 0)
    ok = ok + c_claim(h, (&n_dup[0]) as u64, (kopie >> 63) | (kopie & 1), 1)
    ok = ok + c_claim(h, (&n_dupw[0]) as u64, c_write(kopie, p, 0), 0)
    ok = ok + c_claim(h, (&n_dupd[0]) as u64,
        u_sys(CAP_DUP, kopie, R_ALL, 0), 0 -% E_RIGHTS)
    ok = ok + c_claim(h, (&n_close[0]) as u64, u_sys(CAP_CLOSE, kopie, 0, 0), 0)
    ok = ok + c_claim(h, (&n_after[0]) as u64,
        u_sys(CAP_WRITE, kopie, p, 1), 0 -% E_BADHANDLE)
    ok = ok + c_claim(h, (&n_twice[0]) as u64,
        u_sys(CAP_CLOSE, kopie, 0, 0), 0 -% E_BADHANDLE)
    // Die Tabelle vollmachen. Sechzehn Plaetze, einer ist belegt -- die
    // siebzehnte Kopie muss scheitern, ohne dass sonst etwas passiert.
    var k: u64 = 0
    var letzte: u64 = 0
    while k < 20 {
        letzte = u_sys(CAP_DUP, h, R_ALL, 0)
        k = k + 1
    }
    ok = ok + c_claim(h, (&n_exh[0]) as u64, letzte, 0 -% E_EXHAUSTED)
    ok = ok + c_claim(h, (&n_alive[0]) as u64, u_sys(CAP_VERSION, 0, 0, 0), 1)
    return ok
}

fn u_caps(arg: u64) {
    var s_head: [u8; 20] = "caps: ring 3 begin\n\0"
    var s_tail: [u8; 7] = "caps: \0"
    var s_of: [u8; 2] = "/\0"
    var s_pr: [u8; 9] = " proofs\n\0"
    // Platz 0 ist vereinbart; die obere Haelfte kam im Argument.
    let h: u64 = (arg << 32) | 1
    let n: u64 = 18
    c_say(h, (&s_head[0]) as u64)
    var ok: u64 = u_caps_kann(h)
    ok = ok + u_caps_nicht(h)
    ok = ok + u_caps_weiter(h)
    c_say(h, (&s_tail[0]) as u64)
    c_num(h, ok)
    c_say(h, (&s_of[0]) as u64)
    c_num(h, n)
    c_say(h, (&s_pr[0]) as u64)
    u_sys(SYS_EXIT, n - ok, 0, 0)
}
