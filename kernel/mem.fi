// kernel/mem.fi -- round 59: physical memory and a kernel heap.
//
// Three layers, each one built on the one below:
//
//   1. THE MEMORY MAP. The boot loader knows what really is there;
//      guessing is not allowed. Multiboot puts a list of regions
//      somewhere in memory and names its address in the information
//      structure. Everything of type 1 is usable RAM.
//   2. THE FRAME ALLOCATOR. One bit per 4 KiB page: set means taken.
//      Everything the boot loader did not report as usable stays taken
//      forever, as does everything below `kernel_end` -- the kernel is
//      standing in it. HOW BIG THAT BITMAP IS COMES FROM THE MEMORY MAP
//      AND NOT FROM A CONSTANT; the three steps are described below.
//   3. THE HEAP. Frames are 4 KiB; a kernel needs 24 octets as well.
//      Above the frames sits an implicit free list: every block carries
//      its size and a flag, `kfree` merges neighbours again. First fit,
//      no size classes -- what a kernel needs at the start and no more.
//
// The proofs (`frame_selftest`, `heap_selftest`) run in the kernel
// itself and print what they measured; `tools/kernel/run.sh` reads the
// lines and compares. Allocating, freeing, allocating again -- and no two
// blocks that overlap.
//
// ==================================================================
// ROUND MEM: 512 MiB WAS NOT A PROPERTY OF THIS MACHINE.
// IT WAS A PROPERTY OF TWO CONSTANTS.
// ==================================================================
//
// The line above used to say: "the bitmap lies in the kernel data area,
// 16 KiB for 512 MiB of RAM". That was true, and it was the whole
// ceiling of the system. `kstate.BITMAP_BYTES` is 0x4000, and `frames`
// was `BITMAP_BYTES * 8` -- 131072 frames, 512 MiB, no matter what the
// loader reported. Measured on `main` (3389fbd), the same kernel with
// four different `-m`:
//
//   -m 512   mmap: 523775 KiB usable   frames: 131072 covered   exit 21
//   -m 2G    mmap: 2096639 KiB usable  frames: 131072 covered   exit 63
//   -m 8G    mmap: 8388095 KiB usable  frames: 131072 covered   exit 63
//   -m 64G   mmap: 67108351 KiB usable frames: 131072 covered   exit 63
//
// Read the third column: the kernel SAW every octet the loader
// reported and MANAGED 512 MiB of it. And read the fourth: 63 is an
// exception, not a shutdown. Above 512 MiB this kernel did not merely
// waste memory, IT DIED --
//
//   *** EXCEPTION 14 #PF  err=0x0  cr2=0x7ffe1adc
//
// -- err=0x0 is "page not there", and 0x7ffe1adc is just under two
// gibioctets, where QEMU puts the ACPI tables. That is the SECOND
// constant: `kernel/boot.s` builds ONE page directory, 512 entries of
// 2 MiB, and that is exactly ONE GIBIOCTET of identity mapping. A
// bigger bitmap alone would have changed nothing; the kernel could not
// have touched the frames it was handing out.
//
// THE ORDER IN WHICH IT IS UNDONE, and the order is the whole point --
// each step may only use what the step before it has already made
// usable. This is the hen and the egg, written down:
//
//   STEP 1  THE SMALL MAP, exactly as before. 16 KiB in the kernel data
//           area (`kstate.BITMAP_OFF`), 131072 frames, the first 512 MiB.
//           It needs no allocator, because it is not allocated: it is a
//           fixed part of a data area the kernel already stands in. The
//           memory map is walked, everything usable BELOW 512 MiB is
//           released, the kernel, the map, the multiboot structure and
//           the boot modules are taken back. After this step there is a
//           working frame allocator -- a small one.
//   STEP 2  THE MAP OF PAGES, grown with frames from step 1. For every
//           gibioctet above the first that the memory map reports, ONE
//           frame becomes a page directory of 512 entries of 2 MiB, and
//           the PDPT gets a pointer to it. The frames for this come out
//           of step 1, so they all lie below 512 MiB, so they are all
//           inside the one gibioctet that `boot.s` mapped -- writable
//           without a fault. The PDPT is found through CR3, not through
//           a symbol: `cr3 -> PML4 -> PML4[0] -> PDPT`. After this step
//           every octet the machine has can be READ AND WRITTEN.
//   STEP 3  THE BIG MAP, allocated from step 1 and covering everything.
//           `ceil(top / 4096 / 8)` octets, rounded up to whole frames,
//           taken as ONE contiguous run (`frame_run_inner`). Every bit
//           starts as "taken"; then the 16 KiB of step 1 are copied over
//           the front, so the first 512 MiB keep their exact state --
//           INCLUDING the run that was just handed out for the bitmap
//           itself. Only then is the memory map walked a second time and
//           everything above 512 MiB released. Whoever swaps steps 1 and
//           3 gets a kernel that allocates its own bitmap out of a
//           bitmap that does not exist yet.
//
// WHAT IT COSTS: one bit per 4 KiB frame is 32 KiB of bitmap per
// gibioctet of RAM. Sixty-four gibioctets are 2 MiB of bitmap and 64
// frames of page directories -- 2.25 MiB out of 65536, or 0.0034 %.
// The numbers of a real run are in `docs/ROUNDMEM.md`.
//
// WHERE IT STOPS, honestly: the PDPT of this kernel has 512 entries and
// one PML4 entry is used, so the identity map cannot go past 512 GiB.
// `MAX_GIB` below is the number this kernel will map, and anything the
// map reports above it is left alone rather than claimed.

import serial
import kstate
import atomic
import cpu
import arch.arch

export {
    scan, frame_alloc, frame_free, frame_run, frame_free_run, frames_free,
    // ---- round MEM ----
    bitmap_octets, mapped_gib, frames_total, stress, probe_high,
    heap_init, kalloc, kfree, heap_blocks,
    frame_selftest, heap_selftest,
    FRAME_SIZE, cmdline, mods, mod_start, mod_end
}

const FRAME_SIZE: u64 = 4096
const HEADER: u64 = 16 // size + flag per heap block

// ---------------------------------------------------------- round MEM
// One gibioctet in octets, and how many of them this kernel is willing
// to map. 512 is the hard limit of one PDPT; 64 is what has been
// measured (`tools/mem/run.sh`), and the two numbers are deliberately
// not the same one.
const GIB: u64 = 1073741824
const PD_ENTRIES: u64 = 512
const MAX_GIB: u64 = 512
// Present | writable, and for a page directory entry also "huge page".
const PTE_P_W: u64 = 0x3
const PDE_HUGE: u64 = 0x83
// The bits of a page table entry that are the physical address.
const PTE_ADDR: u64 = 0x000FFFFFFFFFF000

// ------------------------------------------------- the multiboot header

// Offsets in the multiboot information structure (specification 3.3).
const MB_FLAGS: u64 = 0
const MB_CMDLINE: u64 = 16
const MB_MMAP_LEN: u64 = 44
const MB_MMAP_ADDR: u64 = 48
// ROUND K10: the boot modules. Flag bit 3 says the two below hold.
// Behind `mods_addr` lies a table of sixteen octets per module:
// start, end, string, reserved (specification 3.3).
const MB_MODS_COUNT: u64 = 20
const MB_MODS_ADDR: u64 = 24
const MOD_ENTRY: u64 = 16

// Address of the command line, or 0. `-append` of QEMU lands here; the
// kernel reads out of it which fault it is supposed to provoke.
fn cmdline(mbi: u64) -> u64 {
    if (kstate.get32(mbi + MB_FLAGS) & 4) == 0 {
        return 0
    }
    return kstate.get32(mbi + MB_CMDLINE)
}

// How many modules the loader handed over, or 0. A loader that sets no
// flag bit 3 may have anything in those two words -- reading them
// without the bit is how a kernel ends up with a random RAM disk.
fn mods(mbi: u64) -> u64 {
    if (kstate.get32(mbi + MB_FLAGS) & 8) == 0 {
        return 0
    }
    return kstate.get32(mbi + MB_MODS_COUNT)
}

fn mod_start(mbi: u64, i: u64) -> u64 {
    if i >= mods(mbi) {
        return 0
    }
    return kstate.get32(kstate.get32(mbi + MB_MODS_ADDR) + i * MOD_ENTRY)
}

fn mod_end(mbi: u64, i: u64) -> u64 {
    if i >= mods(mbi) {
        return 0
    }
    return kstate.get32(kstate.get32(mbi + MB_MODS_ADDR)
        + i * MOD_ENTRY + 4)
}

// ------------------------------------------------------ the frame bitmap

fn bit_get(bitmap: u64, i: u64) -> bool {
    return (kstate.get8(bitmap + i / 8) & (1 << (i % 8))) != 0
}

fn bit_set(bitmap: u64, i: u64) {
    let p: u64 = bitmap + i / 8
    kstate.set8(p, (kstate.get8(p) | (1 << (i % 8))) as u8)
}

fn bit_clear(bitmap: u64, i: u64) {
    let p: u64 = bitmap + i / 8
    kstate.set8(p, (kstate.get8(p) & (255 ^ (1 << (i % 8)))) as u8)
}

// Reads the memory map, builds the bitmap, marks the kernel as taken.
// Returns the number of map entries seen.
fn scan(state: u64, mbi: u64, kernel_end: u64) -> u64 {
    let bitmap: u64 = state + kstate.BITMAP_OFF
    let frames: u64 = kstate.BITMAP_BYTES * 8
    kstate.set(state, kstate.BITMAP, bitmap)
    kstate.set(state, kstate.BITMAP_FRAMES, frames)

    // Everything is taken until the map says otherwise.
    var i: u64 = 0
    while i < kstate.BITMAP_BYTES {
        kstate.set8(bitmap + i, 0xFF as u8)
        i = i + 1
    }

    var entries: u64 = 0
    var usable: u64 = 0
    var top: u64 = 0
    if (kstate.get32(mbi + MB_FLAGS) & 64) != 0 {
        let len: u64 = kstate.get32(mbi + MB_MMAP_LEN)
        let addr: u64 = kstate.get32(mbi + MB_MMAP_ADDR)
        var p: u64 = addr
        while p < addr + len {
            let size: u64 = kstate.get32(p)
            let base: u64 = __mmio_read64((p + 4) as *mut u64)
            let length: u64 = __mmio_read64((p + 12) as *mut u64)
            let kind: u64 = kstate.get32(p + 20)
            entries = entries + 1
            if kind == 1 {
                usable = usable + length
                if base + length > top {
                    top = base + length
                }
                release(bitmap, frames, base, length)
            }
            if size == 0 {
                p = addr + len // a broken map must not loop
            } else {
                p = p + size + 4
            }
        }
    }
    kstate.set(state, kstate.MEM_USABLE, usable)
    kstate.set(state, kstate.MEM_TOP, top)

    // The kernel itself, the first megabyte and the map are taken.
    reserve(bitmap, frames, 0, kernel_end)
    if (kstate.get32(mbi + MB_FLAGS) & 64) != 0 {
        reserve(bitmap, frames, kstate.get32(mbi + MB_MMAP_ADDR),
            kstate.get32(mbi + MB_MMAP_LEN))
    }
    reserve(bitmap, frames, mbi, 4096)

    // ROUND K10: THE BOOT MODULES. The loader put them in memory the
    // map calls usable, and `release` above has just handed exactly
    // those frames to the allocator. Whoever asks for a frame next
    // gets the userland image and writes over it -- and the fault
    // shows up much later, in a program that will not load. So they
    // are taken back here, together with the table that names them.
    let mc: u64 = mods(mbi)
    if mc != 0 {
        reserve(bitmap, frames, kstate.get32(mbi + MB_MODS_ADDR),
            mc * MOD_ENTRY)
        var m: u64 = 0
        while m < mc {
            let von: u64 = mod_start(mbi, m)
            let bis: u64 = mod_end(mbi, m)
            if bis > von {
                reserve(bitmap, frames, von, bis - von)
            }
            m = m + 1
        }
    }

    kstate.set(state, kstate.FRAMES_FREE, count_free(state))

    // ---------------------------------------------------- round MEM
    // Step 1 is done: there is a frame allocator, and it manages the
    // first 512 MiB. Steps 2 and 3 use it. Both do nothing at all when
    // the machine has no more than that, so a small machine gets
    // exactly the boot it got before this round.
    idmap_grow(state, top)
    bitmap_grow(state, mbi, kernel_end, top)
    return entries
}

// ==================================================================
// ROUND MEM, STEP 2: THE IDENTITY MAP FOLLOWS THE MEMORY MAP
// ==================================================================
//
// `kernel/boot.s` builds PML4[0] -> PDPT[0] -> one page directory of
// 512 entries of 2 MiB. That is one gibioctet, and it was enough for as
// long as the frame allocator stopped at 512 MiB anyway. It is not
// enough for eight gibioctets, and the proof of that is an exception,
// not an opinion: with `-m 2G` the old kernel died reading the ACPI
// tables at 0x7ffe1adc with err=0x0.
//
// The PDPT is not a symbol here. It is found the way the processor
// finds it: CR3 holds the PML4, entry 0 of the PML4 holds the PDPT.
// That keeps the assembler file out of it and cannot go stale.
//
// One frame per gibioctet, taken from step 1 -- so it lies below
// 512 MiB, so it lies inside the gibioctet `boot.s` already mapped, so
// writing 512 entries into it cannot fault. That is the reason this is
// step 2 and not step 1.
fn idmap_grow(state: u64, top: u64) -> u64 {
    var want: u64 = (top + GIB - 1) / GIB
    if want > MAX_GIB {
        want = MAX_GIB
    }
    if want <= 1 {
        kstate.set(state, kstate.MAPPED_GIB, 1)
        return 1
    }
    let pml4: u64 = asm("mov rax, cr3", out("rax")) & PTE_ADDR
    let pdpt: u64 = __mmio_read64(pml4 as *mut u64) & PTE_ADDR
    if pdpt == 0 {
        kstate.set(state, kstate.MAPPED_GIB, 1)
        return 1
    }
    var g: u64 = 1
    while g < want {
        // Already mapped? Then leave it alone -- a second directory for
        // the same gibioctet would leak a frame per boot.
        if (__mmio_read64((pdpt + g * 8) as *mut u64) & (1 as u64)) == 0 {
            let pd: u64 = frame_alloc_inner(state)
            if pd == 0 {
                g = want // out of frames: stop, do not pretend
            } else {
                var j: u64 = 0
                while j < PD_ENTRIES {
                    __mmio_write64((pd + j * 8) as *mut u64,
                        (g * GIB + j * 2097152) | PDE_HUGE)
                    j = j + 1
                }
                __mmio_write64((pdpt + g * 8) as *mut u64, pd | PTE_P_W)
                g = g + 1
            }
        } else {
            g = g + 1
        }
    }
    // The processor may have cached the old, empty entries. Writing CR3
    // with the value it already has throws the whole TLB away, and that
    // is exactly what is wanted here -- this happens once per boot.
    let cr3: u64 = asm("mov rax, cr3", out("rax"))
    asm("mov cr3, rdi", in("rdi") cr3)
    var have: u64 = 0
    var k: u64 = 0
    while k < want {
        if (__mmio_read64((pdpt + k * 8) as *mut u64) & (1 as u64)) != 0 {
            have = have + 1
        }
        k = k + 1
    }
    kstate.set(state, kstate.MAPPED_GIB, have)
    return have
}

// ==================================================================
// ROUND MEM, STEP 3: THE BITMAP IS AS BIG AS THE MACHINE
// ==================================================================
//
// One bit per frame, so `ceil(top / 4096 / 8)` octets, rounded up to
// whole frames and taken as ONE contiguous run. Sixty-four gibioctets
// are 16777216 frames, so 2 MiB of bitmap, so 512 frames.
//
// The copy at the end is the careful part. The new map starts as all
// ones -- everything taken -- and then the 16 KiB of step 1 are written
// over its front. That carries over EVERY decision step 1 made,
// including the run that `frame_run_inner` has just marked as taken for
// this very bitmap. Only after that does the memory map get walked a
// second time, and only frames at or above the old ceiling are
// released; the low ones already have the right answer.
fn bitmap_grow(state: u64, mbi: u64, kernel_end: u64, top: u64) -> u64 {
    let old_frames: u64 = kstate.BITMAP_BYTES * 8
    var want_frames: u64 = (top + FRAME_SIZE - 1) / FRAME_SIZE
    let mapped: u64 = kstate.get(state, kstate.MAPPED_GIB)
    // Never claim a frame that step 2 could not map. A number that big
    // would be a lie the first time somebody wrote to it.
    if want_frames > mapped * (GIB / FRAME_SIZE) {
        want_frames = mapped * (GIB / FRAME_SIZE)
    }
    if want_frames <= old_frames {
        kstate.set(state, kstate.BITMAP_OCTETS, kstate.BITMAP_BYTES)
        return old_frames
    }
    let octets: u64 = (want_frames + 7) / 8
    let need: u64 = (octets + FRAME_SIZE - 1) / FRAME_SIZE
    let base: u64 = frame_run_inner(state, need)
    if base == 0 {
        // No room for the big map. The small one keeps working, and the
        // machine boots with 512 MiB instead of dying.
        kstate.set(state, kstate.BITMAP_OCTETS, kstate.BITMAP_BYTES)
        return old_frames
    }
    fill8(base, need * FRAME_SIZE, 0xFF)
    let old: u64 = state + kstate.BITMAP_OFF
    var i: u64 = 0
    while i < kstate.BITMAP_BYTES {
        kstate.set8(base + i, kstate.get8(old + i) as u8)
        i = i + 1
    }
    kstate.set(state, kstate.BITMAP, base)
    kstate.set(state, kstate.BITMAP_FRAMES, want_frames)
    kstate.set(state, kstate.BITMAP_OCTETS, octets)

    // The second walk. Only what lies at or above the old ceiling.
    if (kstate.get32(mbi + MB_FLAGS) & 64) != 0 {
        let len: u64 = kstate.get32(mbi + MB_MMAP_LEN)
        let addr: u64 = kstate.get32(mbi + MB_MMAP_ADDR)
        var p: u64 = addr
        while p < addr + len {
            let size: u64 = kstate.get32(p)
            let b: u64 = __mmio_read64((p + 4) as *mut u64)
            let l: u64 = __mmio_read64((p + 12) as *mut u64)
            if kstate.get32(p + 20) == 1 {
                release_from(base, want_frames, b, l, old_frames)
            }
            if size == 0 {
                p = addr + len
            } else {
                p = p + size + 4
            }
        }
        reserve(base, want_frames, kstate.get32(mbi + MB_MMAP_ADDR),
            kstate.get32(mbi + MB_MMAP_LEN))
    }
    reserve(base, want_frames, 0, kernel_end)
    reserve(base, want_frames, mbi, 4096)
    let mc: u64 = mods(mbi)
    if mc != 0 {
        reserve(base, want_frames, kstate.get32(mbi + MB_MODS_ADDR),
            mc * MOD_ENTRY)
        var m: u64 = 0
        while m < mc {
            let von: u64 = mod_start(mbi, m)
            let bis: u64 = mod_end(mbi, m)
            if bis > von {
                reserve(base, want_frames, von, bis - von)
            }
            m = m + 1
        }
    }
    kstate.set(state, kstate.FRAMES_FREE, count_free(state))
    return want_frames
}

// How many octets the frame bitmap really occupies, and how many
// gibioctets are identity mapped. Two numbers `kmain.fi` prints and
// `tools/mem/run.sh` reads.
fn bitmap_octets(state: u64) -> u64 {
    return kstate.get(state, kstate.BITMAP_OCTETS)
}

fn mapped_gib(state: u64) -> u64 {
    return kstate.get(state, kstate.MAPPED_GIB)
}

fn frames_total(state: u64) -> u64 {
    return kstate.get(state, kstate.BITMAP_FRAMES)
}

fn fill8(at: u64, n: u64, v: u64) {
    var i: u64 = 0
    // Eight octets at a time. At 64 GiB this loop runs over two
    // mebioctets, and one octet at a time is a measurable part of the
    // boot in TCG.
    let w: u64 = v * 0x0101010101010101
    while i + 8 <= n {
        __mmio_write64((at + i) as *mut u64, w)
        i = i + 8
    }
    while i < n {
        kstate.set8(at + i, v as u8)
        i = i + 1
    }
}

// OCTET BY OCTET WHERE IT CAN BE. A machine with 64 GiB has 16777216
// frames; counting them one bit at a time is 16 million iterations of
// interpreted code, and the boot takes visibly longer for a number
// nobody reads twice.
fn count_free(state: u64) -> u64 {
    let bitmap: u64 = kstate.get(state, kstate.BITMAP)
    let frames: u64 = kstate.get(state, kstate.BITMAP_FRAMES)
    var free: u64 = 0
    var f: u64 = 0
    while f < frames {
        if (f % 8) == 0 && f + 8 <= frames {
            let o: u64 = kstate.get8(bitmap + f / 8)
            if o == 0 {
                free = free + 8
                f = f + 8
            } else if o == 0xFF {
                f = f + 8
            } else {
                var k: u64 = 0
                while k < 8 {
                    if (o & (1 << k)) == 0 {
                        free = free + 1
                    }
                    k = k + 1
                }
                f = f + 8
            }
        } else {
            if !bit_get(bitmap, f) {
                free = free + 1
            }
            f = f + 1
        }
    }
    return free
}

// `release`, but it leaves everything below `from` alone. That is what
// makes the second walk of the memory map safe: the low frames already
// carry the answer step 1 worked out, kernel and modules included.
fn release_from(bitmap: u64, frames: u64, base: u64, length: u64,
    from: u64) {
    var f: u64 = (base + FRAME_SIZE - 1) / FRAME_SIZE
    if f < from {
        f = from
    }
    var last: u64 = (base + length) / FRAME_SIZE
    if last > frames {
        last = frames
    }
    while f < last {
        // A whole octet of eight frames at once, when the run is long
        // enough and starts on an octet boundary. On 64 GiB this is the
        // difference between a boot and a coffee break.
        if (f % 8) == 0 && f + 8 <= last {
            kstate.set8(bitmap + f / 8, 0 as u8)
            f = f + 8
        } else {
            bit_clear(bitmap, f)
            f = f + 1
        }
    }
}

// Mark a region as free -- only whole frames that lie completely in it.
fn release(bitmap: u64, frames: u64, base: u64, length: u64) {
    var f: u64 = (base + FRAME_SIZE - 1) / FRAME_SIZE
    let last: u64 = (base + length) / FRAME_SIZE
    while f < last {
        if f >= frames {
            return
        }
        bit_clear(bitmap, f)
        f = f + 1
    }
}

// Mark a region as taken -- every frame it touches at all.
fn reserve(bitmap: u64, frames: u64, base: u64, length: u64) {
    var f: u64 = base / FRAME_SIZE
    let last: u64 = (base + length + FRAME_SIZE - 1) / FRAME_SIZE
    while f < last {
        if f >= frames {
            return
        }
        bit_set(bitmap, f)
        f = f + 1
    }
}

fn frames_free(state: u64) -> u64 {
    return kstate.get(state, kstate.FRAMES_FREE)
}

// ------------------------------------------------------------ round K5
//
// THE ALLOCATOR IS SHARED AND THEREFORE LOCKED. `frame_alloc` is three
// steps -- find a free bit, set it, count the free frames down -- and two
// cores that run them at the same time both find the SAME bit and both
// come back with the same frame. Nothing reports it; two parts of the
// kernel simply write into one page from then on. `tools/kernel/run.sh`
// measures exactly this: every core takes sixteen frames, and with
// `nolock` the same frame comes back twice.
//
// Interrupts are turned off around the lock, not for the other cores --
// that is what the lock is for -- but for this core's own handlers: a
// timer interrupt that landed inside the critical section and asked for
// the same lock would wait for a lock its own core holds.
fn lock(state: u64) -> u64 {
    let flags: u64 = arch.irq_save()
    atomic.lock_take(state, atomic.L_FRAME, cpu.here(state))
    return flags
}

fn unlock(state: u64, flags: u64) {
    atomic.lock_give(state, atomic.L_FRAME)
    arch.irq_restore(flags)
}

// One frame. 0 = nothing free any more.
fn frame_alloc(state: u64) -> u64 {
    let flags: u64 = lock(state)
    let r: u64 = frame_alloc_inner(state)
    unlock(state, flags)
    return r
}

// ROUND MEM: WHERE THE SEARCH STARTS.
//
// This used to start at frame 0 every single time. With 131072 frames
// that was a quarter of a mebioctet of bitmap to walk in the worst case
// and nobody noticed. With 16777216 frames it is two mebioctets per
// call, and taking two hundred thousand frames in a row turns into
// something quadratic: measured, the stress test did not finish.
//
// The fix is the one `fs.fi` already uses for the block bitmap: keep
// the last frame that was handed out and start there, and let a free
// take the hint back down if it frees something lower. It is a hint and
// not a promise -- the search still wraps around to 0 and covers the
// whole map, so nothing can be lost, only found sooner.
fn hint_of(state: u64) -> u64 {
    let h: u64 = kstate.get(state, kstate.FRAME_HINT)
    if h >= kstate.get(state, kstate.BITMAP_FRAMES) {
        return 0
    }
    return h
}

fn frame_alloc_inner(state: u64) -> u64 {
    let r: u64 = scan_range(state, hint_of(state),
        kstate.get(state, kstate.BITMAP_FRAMES))
    if r != 0 {
        return r
    }
    return scan_range(state, 0, hint_of(state))
}

fn scan_range(state: u64, from: u64, to: u64) -> u64 {
    let bitmap: u64 = kstate.get(state, kstate.BITMAP)
    let frames: u64 = to
    var f: u64 = from
    while f < frames {
        // A full octet is skipped in one go: that is the reason for the
        // bitmap in the first place.
        if kstate.get8(bitmap + f / 8) == 0xFF {
            f = f + 8 - (f % 8)
        } else {
            if !bit_get(bitmap, f) {
                bit_set(bitmap, f)
                kstate.set(state, kstate.FRAMES_FREE, frames_free(state) - 1)
                kstate.set(state, kstate.FRAME_HINT, f)
                return f * FRAME_SIZE
            }
            f = f + 1
        }
    }
    return 0
}

fn frame_free(state: u64, addr: u64) {
    let flags: u64 = lock(state)
    frame_free_inner(state, addr)
    unlock(state, flags)
}

fn frame_free_inner(state: u64, addr: u64) {
    let bitmap: u64 = kstate.get(state, kstate.BITMAP)
    let f: u64 = addr / FRAME_SIZE
    if f >= kstate.get(state, kstate.BITMAP_FRAMES) {
        return
    }
    if bit_get(bitmap, f) {
        bit_clear(bitmap, f)
        kstate.set(state, kstate.FRAMES_FREE, frames_free(state) + 1)
        // A frame that was just given back is the best candidate there
        // is; the next search may start there.
        if f < kstate.get(state, kstate.FRAME_HINT) {
            kstate.set(state, kstate.FRAME_HINT, f)
        }
    }
}

// `n` frames in a row -- the heap wants a contiguous region.
fn frame_run(state: u64, n: u64) -> u64 {
    let flags: u64 = lock(state)
    let r: u64 = frame_run_inner(state, n)
    unlock(state, flags)
    return r
}

fn frame_run_inner(state: u64, n: u64) -> u64 {
    let bitmap: u64 = kstate.get(state, kstate.BITMAP)
    let frames: u64 = kstate.get(state, kstate.BITMAP_FRAMES)
    var start: u64 = 0
    while start + n <= frames {
        var k: u64 = 0
        var ok: bool = true
        while k < n {
            if bit_get(bitmap, start + k) {
                ok = false
                k = n
            } else {
                k = k + 1
            }
        }
        if ok {
            var j: u64 = 0
            while j < n {
                bit_set(bitmap, start + j)
                j = j + 1
            }
            kstate.set(state, kstate.FRAMES_FREE, frames_free(state) - n)
            return start * FRAME_SIZE
        }
        start = start + 1
    }
    return 0
}

// ROUND K10: give back what `frame_run` handed out. A window buffer is
// half a megabyte of CONSECUTIVE frames; closing a window without this
// would leak it, and eight windows opened and closed would be four
// megabytes gone with nothing to show for it. The counter-check for it
// is in `tools/wm/run.sh`: open and close a window a hundred times and
// the number of free frames has to be the one it started with.
fn frame_free_run(state: u64, addr: u64, n: u64) {
    if addr == 0 || n == 0 {
        return
    }
    let flags: u64 = lock(state)
    var i: u64 = 0
    while i < n {
        frame_free_inner(state, addr + i * FRAME_SIZE)
        i = i + 1
    }
    unlock(state, flags)
}

// ==================================================================
// ROUND MEM: THE STRESS TEST, AND WHY IT IS BUILT THIS WAY
// ==================================================================
//
// The claim is "many frames taken and given back, and not one lost".
// A test that only counts would pass on a kernel that hands out the
// same frame twice, so this one WRITES INTO EVERY FRAME IT GETS and
// reads it back before it lets go. Two things are proved at once: the
// bookkeeping adds up, and every frame is really there -- which is the
// part that the old kernel could not do above one gibioctet.
//
// THE LIST LIVES IN THE FRAMES THEMSELVES. Two hundred thousand
// addresses are 1.6 MiB, and a kernel that needs a table that size to
// test its allocator has a second problem. Instead each frame carries
// the address of the one before it in its first eight octets and a
// value derived from its own address in the next eight:
//
//     [0]  the previous frame, 0 at the end of the chain
//     [8]  addr XOR 0xA5A5A5A5A5A5A5A5   -- computed, not remembered
//
// A frame handed out twice breaks the chain or the check word, and both
// are noticed. A value that is merely remembered would not notice
// anything.
fn stress(state: u64, want: u64) -> bool {
    let dreh: u64 = 0xA5A5A5A5A5A5A5A5
    let before: u64 = frames_free(state)
    var head: u64 = 0
    var got: u64 = 0
    var high: u64 = 0
    var going: bool = true
    while got < want && going {
        let f: u64 = frame_alloc(state)
        if f == 0 {
            going = false
        } else {
            __mmio_write64(f as *mut u64, head)
            __mmio_write64((f + 8) as *mut u64, f ^ dreh)
            head = f
            if f > high {
                high = f
            }
            got = got + 1
        }
    }
    kstate.set(state, kstate.STRESS_GOT, got)
    kstate.set(state, kstate.STRESS_HIGH, high)
    kstate.set(state, kstate.STRESS_BEFORE, before)
    kstate.set(state, kstate.STRESS_LOW, frames_free(state))

    var bad: u64 = 0
    var seen: u64 = 0
    var f2: u64 = head
    while f2 != 0 {
        if __mmio_read64((f2 + 8) as *mut u64) != (f2 ^ dreh) {
            bad = bad + 1
        }
        let next: u64 = __mmio_read64(f2 as *mut u64)
        frame_free(state, f2)
        seen = seen + 1
        f2 = next
    }
    kstate.set(state, kstate.STRESS_BAD, bad)
    kstate.set(state, kstate.STRESS_SEEN, seen)
    kstate.set(state, kstate.STRESS_AFTER, frames_free(state))
    return bad == 0 && seen == got && frames_free(state) == before
}

// THE HIGHEST FRAME THE MACHINE HAS, touched once.
//
// The stress test above walks upwards from the bottom; to reach the top
// of a machine with 64 GiB it would have to take sixteen million
// frames. This does it in one step instead: take the second to last
// frame the memory map covers, write a pattern into it, read it back,
// give it up again. If step 2 did not map that gibioctet, this faults --
// which is exactly what the old kernel did at 0x7ffe1adc.
fn probe_high(state: u64) -> bool {
    let marke: u64 = 0xDEADBEEFCAFEBABE
    let dreh: u64 = 0x5A5A5A5A5A5A5A5A
    let bitmap: u64 = kstate.get(state, kstate.BITMAP)
    let frames: u64 = kstate.get(state, kstate.BITMAP_FRAMES)
    if frames < 2 {
        return false
    }
    var f: u64 = frames - 1
    var found: u64 = 0
    // Downwards from the top to the first frame that is really free.
    // The very last frames of a machine are often the ACPI tables.
    while f > 0 && found == 0 {
        if !bit_get(bitmap, f) {
            found = f
        }
        f = f - 1
    }
    if found == 0 {
        return false
    }
    bit_set(bitmap, found)
    let addr: u64 = found * FRAME_SIZE
    __mmio_write64(addr as *mut u64, marke)
    __mmio_write64((addr + FRAME_SIZE - 8) as *mut u64,
        addr ^ dreh)
    let ok1: bool = __mmio_read64(addr as *mut u64) == marke
    let ok2: bool = __mmio_read64((addr + FRAME_SIZE - 8) as *mut u64)
        == (addr ^ dreh)
    bit_clear(bitmap, found)
    kstate.set(state, kstate.PROBE_ADDR, addr)
    return ok1 && ok2
}

// ---------------------------------------------------------- the heap

fn block_size(h: u64) -> u64 {
    return __mmio_read64(h as *mut u64)
}

fn block_used(h: u64) -> u64 {
    return __mmio_read64((h + 8) as *mut u64)
}

fn block_write(h: u64, size: u64, used: u64) {
    __mmio_write64(h as *mut u64, size)
    __mmio_write64((h + 8) as *mut u64, used)
}

// One single free block over the whole region.
fn heap_init(state: u64, base: u64, size: u64) {
    kstate.set(state, kstate.HEAP_BASE, base)
    kstate.set(state, kstate.HEAP_END, base + size)
    kstate.set(state, kstate.HEAP_HEAD, base)
    block_write(base, size, 0)
}

// First fit. Returns the address of the payload, 0 when nothing fits.
fn kalloc(state: u64, want: u64) -> u64 {
    let flags: u64 = lock(state)
    let r: u64 = kalloc_inner(state, want)
    unlock(state, flags)
    return r
}

fn kalloc_inner(state: u64, want: u64) -> u64 {
    let base: u64 = kstate.get(state, kstate.HEAP_BASE)
    let end: u64 = kstate.get(state, kstate.HEAP_END)
    var need: u64 = (want + 15) / 16 * 16 + HEADER
    if need < HEADER + 16 {
        need = HEADER + 16
    }
    var h: u64 = base
    while h < end {
        let size: u64 = block_size(h)
        if size == 0 {
            return 0 // broken chain, do not loop
        }
        if block_used(h) == 0 && size >= need {
            if size - need >= HEADER + 16 {
                block_write(h + need, size - need, 0)
                block_write(h, need, 1)
            } else {
                block_write(h, size, 1)
            }
            return h + HEADER
        }
        h = h + size
    }
    return 0
}

// Free and merge with the following free neighbours. Merging only
// forwards is enough as long as `kfree` walks the whole chain -- and it
// costs no back pointer per block.
fn kfree(state: u64, p: u64) {
    let flags: u64 = lock(state)
    kfree_inner(state, p)
    unlock(state, flags)
}

fn kfree_inner(state: u64, p: u64) {
    if p == 0 {
        return
    }
    block_write(p - HEADER, block_size(p - HEADER), 0)
    let base: u64 = kstate.get(state, kstate.HEAP_BASE)
    let end: u64 = kstate.get(state, kstate.HEAP_END)
    var h: u64 = base
    while h < end {
        let size: u64 = block_size(h)
        if size == 0 {
            return
        }
        if block_used(h) == 0 && h + size < end && block_used(h + size) == 0 {
            block_write(h, size + block_size(h + size), 0)
        } else {
            h = h + size
        }
    }
}

// Number of blocks, and how many of them are in use.
fn heap_blocks(state: u64, used_only: bool) -> u64 {
    let end: u64 = kstate.get(state, kstate.HEAP_END)
    var h: u64 = kstate.get(state, kstate.HEAP_BASE)
    var n: u64 = 0
    while h < end {
        let size: u64 = block_size(h)
        if size == 0 {
            return n
        }
        if !used_only || block_used(h) != 0 {
            n = n + 1
        }
        h = h + size
    }
    return n
}

// --------------------------------------------------------- the proofs

// Allocate three frames, free the middle one, allocate again: the same
// frame has to come back, and no two may overlap.
fn frame_selftest(state: u64) -> bool {
    var head: [u8; 13] = "frame test: \0"
    var s_a: [u8; 3] = "a=\0"
    var s_b: [u8; 5] = "  b=\0"
    var s_c: [u8; 5] = "  c=\0"
    var s_again: [u8; 11] = "  again b=\0"
    var s_free: [u8; 8] = "  free=\0"
    let before: u64 = frames_free(state)
    let a: u64 = frame_alloc(state)
    let b: u64 = frame_alloc(state)
    let c: u64 = frame_alloc(state)
    frame_free(state, b)
    let again: u64 = frame_alloc(state)
    serial.puts((&head[0]) as u64)
    serial.puts((&s_a[0]) as u64)
    serial.hex(a)
    serial.puts((&s_b[0]) as u64)
    serial.hex(b)
    serial.puts((&s_c[0]) as u64)
    serial.hex(c)
    serial.puts((&s_again[0]) as u64)
    serial.hex(again)
    serial.puts((&s_free[0]) as u64)
    serial.dec(frames_free(state))
    serial.nl()
    var ok: bool = true
    if a == 0 || b == 0 || c == 0 || again == 0 {
        ok = false // nothing free
    }
    if a == b || b == c || a == c {
        ok = false // handed out twice
    }
    if a % FRAME_SIZE != 0 || b % FRAME_SIZE != 0 || c % FRAME_SIZE != 0 {
        ok = false // not a frame boundary
    }
    if again != b {
        ok = false // the free frame was not reused
    }
    if frames_free(state) != before - 3 {
        ok = false // the accounting does not add up
    }
    frame_free(state, a)
    frame_free(state, again)
    frame_free(state, c)
    if frames_free(state) != before {
        ok = false
    }
    return ok
}

// Allocate three blocks, write a pattern into each, free the middle one,
// allocate the same size again: it has to land in the hole, and the
// patterns of the neighbours have to be untouched.
fn heap_selftest(state: u64) -> bool {
    var head: [u8; 12] = "heap test: \0"
    var s_p1: [u8; 4] = "p1=\0"
    var s_p2: [u8; 6] = "  p2=\0"
    var s_p3: [u8; 6] = "  p3=\0"
    var s_reuse: [u8; 9] = "  reuse=\0"
    var s_blocks: [u8; 11] = "  blocks=\0\0"
    var s_refused: [u8; 14] = "  1M refused=\0"
    let p1: u64 = kalloc(state, 24)
    let p2: u64 = kalloc(state, 100)
    let p3: u64 = kalloc(state, 24)
    fill(p1, 24, 0x11)
    fill(p2, 100, 0x22)
    fill(p3, 24, 0x33)
    var ok: bool = true
    if p1 == 0 || p2 == 0 || p3 == 0 {
        ok = false
    }
    if p1 % 16 != 0 || p2 % 16 != 0 || p3 % 16 != 0 {
        ok = false
    }
    if p1 + 24 > p2 || p2 + 100 > p3 {
        ok = false // the blocks overlap
    }
    if !check(p1, 24, 0x11) || !check(p2, 100, 0x22) || !check(p3, 24, 0x33) {
        ok = false // somebody wrote across
    }
    // Counter-check: more than the heap has must be REFUSED. An
    // allocator that hands out something here would hand out memory it
    // does not own.
    let toobig: u64 = kalloc(state, 1024 * 1024)
    if toobig != 0 {
        ok = false
    }
    kfree(state, p2)
    let reuse: u64 = kalloc(state, 100)
    if reuse != p2 {
        ok = false // the hole was not used
    }
    if !check(p1, 24, 0x11) || !check(p3, 24, 0x33) {
        ok = false
    }
    serial.puts((&head[0]) as u64)
    serial.puts((&s_p1[0]) as u64)
    serial.hex(p1)
    serial.puts((&s_p2[0]) as u64)
    serial.hex(p2)
    serial.puts((&s_p3[0]) as u64)
    serial.hex(p3)
    serial.puts((&s_reuse[0]) as u64)
    serial.hex(reuse)
    serial.puts((&s_blocks[0]) as u64)
    serial.dec(heap_blocks(state, false))
    serial.puts((&s_refused[0]) as u64)
    if toobig == 0 {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()
    // Give everything back: afterwards the heap has to be ONE block
    // again, otherwise the merging is broken.
    kfree(state, p1)
    kfree(state, reuse)
    kfree(state, p3)
    if heap_blocks(state, false) != 1 {
        ok = false
    }
    if heap_blocks(state, true) != 0 {
        ok = false
    }
    return ok
}

fn fill(p: u64, n: u64, value: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, value as u8)
        i = i + 1
    }
}

fn check(p: u64, n: u64, value: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get8(p + i) != value {
            return false
        }
        i = i + 1
    }
    return true
}
