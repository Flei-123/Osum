// SPDX-License-Identifier: GPL-2.0-only
// kernel/sysgui.fi -- RUNDE SERVERBUILD: DIE AUFRUFNUMMERN DER
// OBERFLAECHE, UND NUR DIESE.
//
// `kernel/sys.fi` ist die Tafel, an der Ring 3 anklopft: 9051 Zeilen,
// weit ueber hundert Nummern. 15 davon gehoerten dem Bildschirm --
// der Fensterserver (`wm_call`, 357 Zeilen), die Widget-Naht
// (`wig_call`), der Fensterbaum (`tile_call` und die vier `do_tile*`)
// und der Bildmodus (`disp_call`, `do_dispget`, `do_dispset`,
// `do_dispstr`). Sie stehen jetzt hier.
//
// EIN UMZUG, KEINE UMSCHREIBUNG. Die Funktionen sind Zeile fuer Zeile
// dieselben. Was sich geaendert hat: was sie von `sys.fi` brauchen --
// `neg`, `copy_in`, `copy_out` und ein paar Nachbarn -- heisst jetzt
// `sys.neg` und steht drueben in der Ausfuhrliste.
//
// DASS DAS UEBERHAUPT GEHT, liegt an einer Eigenschaft von Firn, die
// eine Nachmessung gezeigt hat: Modulkreise sind ERLAUBT. `sys.fi`
// bindet `gfx.fi` ein, `gfx.fi` bindet diese Datei ein, und diese
// Datei bindet wieder `sys.fi` ein. Der Uebersetzer nimmt das an,
// solange keines der drei das WURZELMODUL ist (das ist `kmain.fi`, und
// deshalb liegt der geteilte Rest von dort in `kernel/kutil.fi`).
//
// WAS NICHT MITGEZOGEN IST, und der Grund gehoert dazu: `/dev/fb`.
// `open_devfb`, `fb_write`, `fb_read`, `do_lseek`, `do_fstat`,
// `map_fd` und `do_pwrset` sind allgemeine Wege, die den Rahmenpuffer
// als EINEN Fall unter mehreren behandeln -- ein `lseek` auf das Ende
// einer Datei ist kein Grafikaufruf. Diese sieben fragen ueber acht
// Weiterleitungen in `gfx.fi` nach (`fb_ready`, `fb_bytes`, ...), und
// ohne Bildschirm sagt die erste davon `false`: dann gibt es das
// Geraet nicht, und der Rest dieser Wege verhaelt sich wie eh und je.
//
// BEI gui=off WIRD DIESE DATEI NICHT UEBERSETZT.

profile kernel

import cap
import errno
import fb
import fs
import kstate
import netview
import nidx
import perm
import proc
import ps2m
import sched
import tile
import vmode
import wig
import wm

import sys

export { wm_call, wig_call, tile_call, disp_call }

const WM_CREATE: u64 = 2100 // (xy, wh, titel, art) -> Handle
const WM_FILL: u64 = 2101 // (h, xy, wh, farbe) -> 0
const WM_TEXT: u64 = 2102 // (h, xy, p, n, farbe) -> x hinter dem Text
const WM_EVENT: u64 = 2103 // (h, aus) -> 1 = eines geholt, 0 = keines
const WM_INFO: u64 = 2104 // (h, was) -> Zahl
const WM_FLUSH: u64 = 2105 // (h) -> 0
const WM_MOVE: u64 = 2106 // (h, xy) -> 0
const WM_CLOSE: u64 = 2107 // (h) -> 0
const WM_WRITE: u64 = 2108 // (h, p, n) -> Oktette (nur Terminalfenster)
const WM_STATE: u64 = 2109 // (h, was, wert) -> 0, braucht R_MANAGE
const WM_LIST: u64 = 2110 // (platz, aus, max) -> 1 belegt, 0 frei
const WM_ACT: u64 = 2111 // (fensternummer, was) -> 0
const WM_STRUT: u64 = 2112 // (h, edge, size) -> 0, braucht R_MANAGE
const WM_SIZE: u64 = 2113 // (h, wh) -> 0, braucht R_MANAGE
