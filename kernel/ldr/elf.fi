import libc.regio
import libc.numeric

export {
    spawn, build, STACK_ENV_MAXN, lock_enter, lock_leave, load, load_at, say_reason, errno_of,
    R_OK, R_NOFILE, R_ISDIR, R_SHORT, R_MAGIC, R_CLASS, R_ENDIAN,
    R_VERSION, R_TYPE, R_MACHINE, R_SIZES, R_PHNUM, R_PHOFF, R_SEGFILE,
    R_MEMSZ, R_RANGE, R_ALIGN, R_OVERLAP, R_NOMEM, R_ENTRY, R_READ,
    R_NOLOAD, R_ARGS,
    R_IPATH, R_INOFILE, R_ICHAIN, R_IFORM, R_STACK,
    R_NOSLOT
}

const R_OK: u64 = 0
const R_NOFILE: u64 = 1
const R_ISDIR: u64 = 2
const R_SHORT: u64 = 3
const R_MAGIC: u64 = 4
const R_CLASS: u64 = 5
const R_ENDIAN: u64 = 6
const R_VERSION: u64 = 7
const R_TYPE: u64 = 8
const R_MACHINE: u64 = 9
const R_SIZES: u64 = 10
const R_PHNUM: u64 = 11
const R_PHOFF: u64 = 12
const R_SEGFILE: u64 = 13
const R_MEMSZ: u64 = 14
const R_RANGE: u64 = 15
const R_ALIGN: u64 = 16
const R_OVERLAP: u64 = 17
const R_NOMEM: u64 = 18
const R_ENTRY: u64 = 19
const R_READ: u64 = 20
const R_NOLOAD: u64 = 21
const R_ARGS: u64 = 22
const R_PERM: u64 = 23

const R_INTERP: u64 = 24

const R_IPATH: u64 = 25
const R_INOFILE: u64 = 26
const R_ICHAIN: u64 = 27
const R_IFORM: u64 = 28
const R_STACK: u64 = 29
const R_NOSLOT: u64 = 30
const R_KEINER: u64 = 30

const PT_LOAD: u64 = 1
const PT_INTERP: u64 = 3
const PF_X: u64 = 1
const PF_W: u64 = 2

const ET_EXEC: u64 = 2
const ET_DYN: u64 = 3
const EM_X86_64: u64 = 62

const EHSIZE: u64 = 64
const PHENTSIZE: u64 = 56
const MAX_PH: u64 = 16

const E_TYPE: u64 = 16
const E_MACHINE: u64 = 18
const E_EVERSION: u64 = 20
const E_ENTRY: u64 = 24
const E_PHOFF: u64 = 32
const E_EHSIZE: u64 = 52
const E_PHENTSIZE: u64 = 54
const E_PHNUM: u64 = 56

const P_TYPE: u64 = 0
const P_FLAGS: u64 = 4
const P_OFFSET: u64 = 8
const P_VADDR: u64 = 16
const P_FILESZ: u64 = 32
const P_MEMSZ: u64 = 40

const PAGE: u64 = 4096
const PAGE_MASK: u64 = 4095

const POISON: u64 = 0xAAAAAAAAAAAAAAAA

const STR_OFF: u64 = 544

fn head(state: u64) -> u64 {
    return state + kstate.ELF_OFF
}

fn fill(p: u64, n: u64, v: u64) {
    arch.fill_words(p, v, n / 8)
}

fn copy(from: u64, to: u64, n: u64) {
    arch.copy_octets(to, from, n)
}

fn fail(state: u64, r: u64) -> u64 {
    kstate.set(state, kstate.ELF_ERR, r)
    return r
}

fn read_header(state: u64, ino: u64) -> u64 {
    let h: u64 = head(state)
    let size: u64 = fs.inode_size(state, ino)
    if size < EHSIZE {
        return R_SHORT
    }
    if fs.read_at_cached(state, ino, 0, h, EHSIZE) != EHSIZE {
        return R_READ
    }
    if kstate.get8(h) != 0x7F {
        return R_MAGIC
    }
    if kstate.get8(h + 1) != 69 {
        return R_MAGIC
    }
    if kstate.get8(h + 2) != 76 {
        return R_MAGIC
    }
    if kstate.get8(h + 3) != 70 {
        return R_MAGIC
    }
    if kstate.get8(h + 4) != 2 {
        return R_CLASS
    }
    if kstate.get8(h + 5) != 1 {
        return R_ENDIAN
    }
    if kstate.get8(h + 6) != 1 {
        return R_VERSION
    }
    let et: u64 = regio.read16(h + E_TYPE)
    if et != ET_EXEC {
        if et != ET_DYN {
            return R_TYPE
        }
    }
    if regio.read16(h + E_MACHINE) != EM_X86_64 {
        return R_MACHINE
    }
    if regio.read32(h + E_EVERSION) != 1 {
        return R_VERSION
    }
    if regio.read16(h + E_EHSIZE) != EHSIZE {
        return R_SIZES
    }
    if regio.read16(h + E_PHENTSIZE) != PHENTSIZE {
        return R_SIZES
    }
    let n: u64 = regio.read16(h + E_PHNUM)
    if n == 0 {
        return R_PHNUM
    }
    if n > MAX_PH {
        return R_PHNUM
    }
    let need: u64 = n * PHENTSIZE
    let off: u64 = regio.read64(h + E_PHOFF)
    if off < EHSIZE {
        return R_PHOFF
    }
    if off > size {
        return R_PHOFF
    }
    if size - off < need {
        return R_PHOFF
    }
    if fs.read_at_cached(state, ino, off, h + EHSIZE, need) != need {
        return R_READ
    }
    return R_OK
}

fn segment(state: u64, t: u64, ino: u64, ph: u64, size: u64,
    bias: u64) -> u64 {
    let flags: u64 = regio.read32(ph + P_FLAGS)
    let off: u64 = regio.read64(ph + P_OFFSET)
    let vraw: u64 = regio.read64(ph + P_VADDR)
    if vraw > procmap.IMAGE_END {
        return R_RANGE
    }
    if bias > procmap.IMAGE_END {
        return R_RANGE
    }
    let vaddr: u64 = vraw + bias
    let filesz: u64 = regio.read64(ph + P_FILESZ)
    let memsz: u64 = regio.read64(ph + P_MEMSZ)
    if memsz == 0 {
        return R_OK
    }
    if filesz > memsz {
        return R_MEMSZ
    }
    if off > size {
        return R_SEGFILE
    }
    if size - off < filesz {
        return R_SEGFILE
    }
    if vaddr < procmap.IMAGE_BASE {
        return R_RANGE
    }
    if vaddr >= procmap.IMAGE_END {
        return R_RANGE
    }
    if procmap.IMAGE_END - vaddr < memsz {
        return R_RANGE
    }
    let offset: u64 = vaddr & PAGE_MASK
    if offset != (off & PAGE_MASK) {
        return R_ALIGN
    }
    let first: u64 = vaddr - offset
    let span: u64 = memsz + offset
    if procmap.IMAGE_END - first < span {
        return R_RANGE
    }
    let file_first: u64 = off - (off & PAGE_MASK)
    let writable: bool = (flags & PF_W) != 0
    let runnable: bool = (flags & PF_X) != 0
    let zeroing: bool = !kstate.mode_on(state, kstate.M_NOBSS)
    let lazy_bss: bool = !kstate.mode_on(state, kstate.M_NOLAZY)
    let share_pages: bool = lazy_bss
    let data_end: u64 = filesz + offset
    var done: u64 = 0
    while done < span {
        let page: u64 = first + done
        var frame: u64 = 0
        if procmap.page_free(state, t, page) && done > 0 && done >= filesz + offset && lazy_bss
                && procmap.lazy_mark_image(state, t, page, writable, runnable) {
            done = done + PAGE
            continue
        }
        if share_pages && procmap.page_free(state, t, page) && (done > 0 || offset == 0) && data_end >= done + PAGE
                && procfault.prefill_file_page(state, t, page, writable, runnable, ino, (file_first + done) / PAGE) {
            done = done + PAGE
            continue
        }
        if procmap.page_free(state, t, page) {
            frame = procmap.map_page(state, t, page, writable, runnable)
            if frame == 0 {
                return R_NOMEM
            }
            if zeroing {
                fill_bytes(frame, PAGE, 0)
            } else {
                fill(frame, PAGE, POISON)
            }
        } else {
            if bias == 0 {
                return R_OVERLAP
            }
            if procmap.page_cached(state, t, page) {
                return R_OVERLAP
            }
            frame = procmap.translate(state, t, page)
            if frame == 0 {
                return R_OVERLAP
            }
        }
        var von: u64 = 0
        if done == 0 {
            von = offset
        }
        let data: u64 = filesz + offset
        var bis: u64 = 0
        if data > done {
            bis = data - done
            if bis > PAGE {
                bis = PAGE
            }
        }
        if bis > von {
            let nimm: u64 = bis - von
            let sc: u64 = state + kstate.LOAD_OFF
            if fs.read_at_cached(state, ino, file_first + done + von, sc,
                    nimm) != nimm {
                return R_READ
            }
            copy(sc, frame + von, nimm)
        }
        done = done + PAGE
    }
    return R_OK
}

fn high_reason(code: u64) -> u64 {
    if code == bigpie.E_SEGFILE {
        return R_SEGFILE
    }
    if code == bigpie.E_MEMSZ {
        return R_MEMSZ
    }
    if code == bigpie.E_ALIGN {
        return R_ALIGN
    }
    if code == bigpie.E_NOMEM {
        return R_NOMEM
    }
    if code == bigpie.E_READ {
        return R_READ
    }
    if code == bigpie.E_OVERLAP {
        return R_OVERLAP
    }
    return R_RANGE
}

fn place_segment(state: u64, t: u64, ino: u64, ph: u64, size: u64, bias: u64) -> u64 {
    if !bigpie.in_high(bias) {
        return segment(state, t, ino, ph, size, bias)
    }
    let code: u64 = bigpie.map_segment(state, t, ino, size, bias, regio.read64(ph + P_VADDR), regio.read64(ph + P_OFFSET),
        regio.read64(ph + P_FILESZ), regio.read64(ph + P_MEMSZ), regio.read32(ph + P_FLAGS))
    if code == bigpie.OK {
        return R_OK
    }
    return high_reason(code)
}

fn entry_runnable(state: u64, t: u64, h: u64, n: u64, bias: u64) -> bool {
    let entry: u64 = regio.read64(h + E_ENTRY)
    if !bigpie.in_high(bias) {
        return procmap.page_exec(state, t, entry + bias)
    }
    var seg: u64 = 0
    while seg < n {
        let ph: u64 = h + EHSIZE + seg * PHENTSIZE
        if regio.read32(ph + P_TYPE) == PT_LOAD && (regio.read32(ph + P_FLAGS) & PF_X) != 0 {
            let lo: u64 = regio.read64(ph + P_VADDR)
            let len: u64 = regio.read64(ph + P_FILESZ)
            if entry >= lo && entry - lo < len {
                return true
            }
        }
        seg = seg + 1
    }
    return false
}

fn image_extent(state: u64) -> u64 {
    let h: u64 = head(state)
    let n: u64 = regio.read16(h + E_PHNUM)
    var top: u64 = 0
    var seg: u64 = 0
    while seg < n {
        let ph: u64 = h + EHSIZE + seg * PHENTSIZE
        if regio.read32(ph + P_TYPE) == PT_LOAD {
            let lo: u64 = regio.read64(ph + P_VADDR)
            let len: u64 = regio.read64(ph + P_MEMSZ)
            if lo < procmap.IMAGE_END && len < procmap.IMAGE_END && lo + len > top {
                top = lo + len
            }
        }
        seg = seg + 1
    }
    return top
}

fn fill_bytes(p: u64, n: u64, v: u64) {
    arch.fill_words(p, v * 0x0101010101010101, n / 8)
}

fn load(state: u64, t: u64, ino: u64) -> u64 {
    return load_at(state, t, ino, 0)
}

fn load_at(state: u64, t: u64, ino: u64, bias: u64) -> u64 {
    let r: u64 = read_header(state, ino)
    if r != R_OK {
        return r
    }
    let h: u64 = head(state)
    let size: u64 = fs.inode_size(state, ino)
    let n: u64 = regio.read16(h + E_PHNUM)
    let phoff: u64 = regio.read64(h + E_PHOFF)
    var loads: u64 = 0
    var bytes: u64 = 0
    var pages: u64 = 0
    var phdr: u64 = 0
    var top: u64 = 0
    var seg: u64 = 0
    while seg < n {
        let ph: u64 = h + EHSIZE + seg * PHENTSIZE
        if regio.read32(ph + P_TYPE) == PT_LOAD {
            if regio.read64(ph + P_MEMSZ) > 0 {
                let bad: u64 = place_segment(state, t, ino, ph, size, bias)
                if bad != R_OK {
                    return bad
                }
                loads = loads + 1
                bytes = bytes + regio.read64(ph + P_FILESZ)
                pages = pages + (regio.read64(ph + P_MEMSZ) + PAGE_MASK) / PAGE
                let so: u64 = regio.read64(ph + P_OFFSET)
                let sf: u64 = regio.read64(ph + P_FILESZ)
                if phoff >= so {
                    if phoff - so < sf {
                        phdr = regio.read64(ph + P_VADDR) + bias + (phoff - so)
                    }
                }
                let e: u64 = regio.read64(ph + P_VADDR) + bias
                    + regio.read64(ph + P_MEMSZ)
                if e > top {
                    top = e
                }
                say_segment(state, t, ph, bias)
            }
        }
        seg = seg + 1
    }
    if loads == 0 {
        return R_NOLOAD
    }
    if !entry_runnable(state, t, h, n, bias) {
        return R_ENTRY
    }
    kstate.set(state, kstate.ELF_BYTES, bytes)
    kstate.set(state, kstate.ELF_PAGES, pages)
    kstate.set(state, kstate.ELF_LOADS, loads)
    kstate.set(state, kstate.K16_OFF + kstate.FT_SCALARS + DYN_PHDR, phdr)
    kstate.set(state, kstate.K16_OFF + kstate.FT_SCALARS + DYN_PHNUM, n)
    kstate.set(state, kstate.K16_OFF + kstate.FT_SCALARS + DYN_ENTRY,
        regio.read64(h + E_ENTRY) + bias)
    kstate.set(state, kstate.K16_OFF + kstate.FT_SCALARS + DYN_TOP, top)
    return R_OK
}

fn say_segment(state: u64, t: u64, ph: u64, bias: u64) {
    if !kstate.mode_on(state, kstate.M_EXECLOG) {
        return
    }
    var s_seg: [u8; 10] = "elf: seg \0"
    var s_v: [u8; 4] = " v=\0"
    var s_f: [u8; 4] = " f=\0"
    var s_file: [u8; 9] = " filesz=\0"
    var s_mem: [u8; 8] = " memsz=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_x: [u8; 4] = " x=\0"
    let vaddr: u64 = regio.read64(ph + P_VADDR) + bias
    let flags: u64 = regio.read32(ph + P_FLAGS)
    serial.puts((&s_seg[0]) as u64)
    serial.dec(flags)
    serial.puts((&s_v[0]) as u64)
    serial.hex(vaddr)
    serial.puts((&s_f[0]) as u64)
    serial.hex(procmap.translate(state, t, vaddr))
    serial.puts((&s_file[0]) as u64)
    serial.dec(regio.read64(ph + P_FILESZ))
    serial.puts((&s_mem[0]) as u64)
    serial.dec(regio.read64(ph + P_MEMSZ))
    serial.puts((&s_w[0]) as u64)
    serial.dec(numeric.yes((flags & PF_W) != 0))
    serial.puts((&s_x[0]) as u64)
    serial.dec(numeric.yes(procmap.page_exec(state, t, vaddr)))
    serial.nl()
}

const ENV_OFF: u64 = 2048
const ENV_MAXN: u64 = 16
const STACK_ENV_MAXN: u64 = 64
const ENV_STR: u64 = 2192

fn write_env(state: u64, frame: u64) {
    let n0: u64 = kstate.get(state, kstate.K11_OFF + kstate.ENV_N)
    var n: u64 = n0
    if n > ENV_MAXN {
        n = ENV_MAXN
    }
    regio.write64(frame + ENV_OFF, n)
    var src: u64 = state + kstate.K11_OFF + kstate.ENV_BUF
    var at: u64 = ENV_STR
    var k: u64 = 0
    while k < n {
        regio.write64(frame + ENV_OFF + 8 + k * 8, procspace.ARGS_BASE + at)
        var going: bool = true
        while going {
            if at >= PAGE - 1 {
                regio.write64(frame + ENV_OFF, k)
                return
            }
            let c: u64 = kstate.get8(src)
            kstate.set8(frame + at, c as u8)
            at = at + 1
            src = src + 1
            if c == 0 {
                going = false
            }
        }
        k = k + 1
    }
    regio.write64(frame + ENV_OFF + 8 + n * 8, 0)
}

fn write_args(state: u64, t: u64, args: u64, argc: u64) -> bool {
    if argc > procbase.MAX_ARGS {
        return false
    }
    if procmap.page_free(state, t, procspace.ARGS_BASE) {
        if procmap.map_page_zero(state, t, procspace.ARGS_BASE, true, false) == 0 {
            return false
        }
    }
    let frame: u64 = procmap.translate(state, t, procspace.ARGS_BASE)
    if frame == 0 {
        return false
    }
    fill_bytes(frame, PAGE, 0)
    regio.write64(frame, argc)
    var at: u64 = STR_OFF
    var src: u64 = args
    var k: u64 = 0
    while k < argc {
        regio.write64(frame + 8 + k * 8, procspace.ARGS_BASE + at)
        var going: bool = true
        while going {
            if at >= ENV_OFF - 1 {
                return false
            }
            let c: u64 = kstate.get8(src)
            kstate.set8(frame + at, c as u8)
            at = at + 1
            src = src + 1
            if c == 0 {
                going = false
            }
        }
        k = k + 1
    }
    regio.write64(frame + 8 + argc * 8, 0)
    write_env(state, frame)
    return true
}

const AT_NULL: u64 = 0
const AT_PHDR: u64 = 3
const AT_PHENT: u64 = 4
const AT_PHNUM: u64 = 5
const AT_PAGESZ: u64 = 6
const AT_BASE: u64 = 7
const AT_FLAGS: u64 = 8
const AT_ENTRY: u64 = 9
const AT_UID: u64 = 11
const AT_EUID: u64 = 12
const AT_GID: u64 = 13
const AT_EGID: u64 = 14
const AT_PLATFORM: u64 = 15
const AT_HWCAP: u64 = 16
const AT_CLKTCK: u64 = 17
const AT_SECURE: u64 = 23
const AT_RANDOM: u64 = 25
const AT_HWCAP2: u64 = 26
const AT_EXECFN: u64 = 31

const SP_PAGE: u64 = procspace.INIT_STACK

const AUXN: u64 = 40

fn sv_put(frame: u64, at: u64, v: u64) {
    regio.write64(frame + at, v)
}

fn build_stack(state: u64, t: u64, args: u64, argc: u64,
    phdr: u64, phnum: u64, entry: u64, ibase: u64, path: u64) -> u64 {
    if argc > procbase.MAX_ARGS {
        return 0
    }
    if procmap.page_free(state, t, SP_PAGE) {
        if procmap.map_page_zero(state, t, SP_PAGE, true, false) == 0 {
            return 0
        }
    }
    let frame: u64 = procmap.translate(state, t, SP_PAGE)
    if frame == 0 {
        return 0
    }
    fill_bytes(frame, PAGE, 0)

    let e0: u64 = kstate.get(state, kstate.K11_OFF + kstate.ENV_N)
    var envc: u64 = e0
    if envc > STACK_ENV_MAXN {
        envc = STACK_ENV_MAXN
    }

    let need: u64 = (1 + argc + 1 + envc + 1 + AUXN) * 8
    let str_at: u64 = PAGE / 2
    if need > str_at {
        return 0
    }

    var at: u64 = 0
    sv_put(frame, at, argc)
    at = at + 8

    var sp_str: u64 = str_at
    var k: u64 = 0
    var src: u64 = args
    while k < argc {
        sv_put(frame, at, SP_PAGE + sp_str)
        at = at + 8
        var going: bool = true
        while going {
            if sp_str >= PAGE - 24 {
                return 0
            }
            let c: u64 = kstate.get8(src)
            kstate.set8(frame + sp_str, c as u8)
            sp_str = sp_str + 1
            src = src + 1
            if c == 0 {
                going = false
            }
        }
        k = k + 1
    }
    sv_put(frame, at, 0)
    at = at + 8

    var esrc: u64 = state + kstate.K11_OFF + kstate.ENV_BUF
    var j: u64 = 0
    while j < envc {
        sv_put(frame, at, SP_PAGE + sp_str)
        at = at + 8
        var going2: bool = true
        while going2 {
            if sp_str >= PAGE - 24 {
                return 0
            }
            let c2: u64 = kstate.get8(esrc)
            kstate.set8(frame + sp_str, c2 as u8)
            sp_str = sp_str + 1
            esrc = esrc + 1
            if c2 == 0 {
                going2 = false
            }
        }
        j = j + 1
    }
    sv_put(frame, at, 0)
    at = at + 8

    if sp_str + 16 >= PAGE {
        return 0
    }
    let rnd: u64 = sp_str
    var b: u64 = 0
    let seed: u64 = kstate.get(state, kstate.TICKS) + t * 2654435761
    while b < 16 {
        let value: u64 = (seed >> ((b & 7) * 8)) + b * 31 + t
        kstate.set8(frame + rnd + b, (value & 255) as u8)
        b = b + 1
    }
    sp_str = sp_str + 16

    let plat: u64 = sp_str
    if sp_str + 8 >= PAGE {
        return 0
    }
    kstate.set8(frame + plat, 120)
    kstate.set8(frame + plat + 1, 56)
    kstate.set8(frame + plat + 2, 54)
    kstate.set8(frame + plat + 3, 95)
    kstate.set8(frame + plat + 4, 54)
    kstate.set8(frame + plat + 5, 52)
    kstate.set8(frame + plat + 6, 0)
    sp_str = sp_str + 8

    let execfn: u64 = sp_str
    var xi: u64 = 0
    var xgoing: bool = path != 0
    while xgoing {
        if sp_str >= PAGE - 8 || xi >= 255 {
            kstate.set8(frame + sp_str, 0)
            sp_str = sp_str + 1
            xgoing = false
        } else {
            let xc: u64 = kstate.get8(path + xi)
            kstate.set8(frame + sp_str, xc as u8)
            sp_str = sp_str + 1
            xi = xi + 1
            if xc == 0 {
                xgoing = false
            }
        }
    }
    if path == 0 {
        kstate.set8(frame + sp_str, 0)
        sp_str = sp_str + 1
    }

    sv_put(frame, at, AT_PHDR)
    at = at + 8
    sv_put(frame, at, phdr)
    at = at + 8
    sv_put(frame, at, AT_PHENT)
    at = at + 8
    sv_put(frame, at, PHENTSIZE)
    at = at + 8
    sv_put(frame, at, AT_PHNUM)
    at = at + 8
    sv_put(frame, at, phnum)
    at = at + 8
    sv_put(frame, at, AT_PAGESZ)
    at = at + 8
    sv_put(frame, at, PAGE)
    at = at + 8
    sv_put(frame, at, AT_BASE)
    at = at + 8
    sv_put(frame, at, ibase)
    at = at + 8
    sv_put(frame, at, AT_FLAGS)
    at = at + 8
    sv_put(frame, at, 0)
    at = at + 8
    sv_put(frame, at, AT_ENTRY)
    at = at + 8
    sv_put(frame, at, entry)
    at = at + 8
    sv_put(frame, at, AT_UID)
    at = at + 8
    sv_put(frame, at, taskslot.tget(state, t, taskconst.T_UID))
    at = at + 8
    sv_put(frame, at, AT_EUID)
    at = at + 8
    sv_put(frame, at, taskslot.tget(state, t, taskconst.T_EUID))
    at = at + 8
    sv_put(frame, at, AT_GID)
    at = at + 8
    sv_put(frame, at, taskslot.tget(state, t, taskconst.T_GID))
    at = at + 8
    sv_put(frame, at, AT_EGID)
    at = at + 8
    sv_put(frame, at, taskslot.tget(state, t, taskconst.T_EGID))
    at = at + 8
    sv_put(frame, at, AT_CLKTCK)
    at = at + 8
    sv_put(frame, at, 100)
    at = at + 8
    sv_put(frame, at, AT_SECURE)
    at = at + 8
    sv_put(frame, at, 0)
    at = at + 8
    sv_put(frame, at, AT_HWCAP)
    at = at + 8
    sv_put(frame, at, kstate.get(state, kstate.FPU_FEAT) & 0xFFFFFFFF)
    at = at + 8
    sv_put(frame, at, AT_HWCAP2)
    at = at + 8
    sv_put(frame, at, 0)
    at = at + 8
    sv_put(frame, at, AT_PLATFORM)
    at = at + 8
    sv_put(frame, at, SP_PAGE + plat)
    at = at + 8
    sv_put(frame, at, AT_EXECFN)
    at = at + 8
    sv_put(frame, at, SP_PAGE + execfn)
    at = at + 8
    sv_put(frame, at, AT_RANDOM)
    at = at + 8
    sv_put(frame, at, SP_PAGE + rnd)
    at = at + 8
    sv_put(frame, at, AT_NULL)
    at = at + 8
    sv_put(frame, at, 0)
    at = at + 8
    if at > str_at {
        return 0
    }
    return SP_PAGE
}

fn spawn(state: u64, path: u64, args: u64, argc: u64, prio: u64) -> u64 {
    let lk: u64 = lock_enter(state)
    let t: u64 = build(state, path, args, argc, prio)
    lock_leave(state, lk)
    if t == 0 {
        return 0
    }
    let flags: u64 = sched.irq_save()
    let par: u64 = sched.current(state)
    if file.fd_of(state, par, 1) < file.MAX_OPEN {
        file.inherit_std(state, par, t)
    }
    uio.adopt(state, par, t)
    ctr.inherit(state, par, t)
    say_start(state, t)
    sched.start(state, t)
    sched.irq_restore(flags)
    return t
}

const MAX_INTERP: u64 = 4
const IPATH_MAX: u64 = 128
const IARGS_MAX: u64 = 2048
const IWORD_MAX: u64 = 256

fn is_gap(c: u64) -> bool {
    return c == 32 || c == 9
}

fn read_shebang(state: u64, ino: u64, dst_path: u64, dst_arg: u64) -> u64 {
    let buf: u64 = state + kstate.K16_OFF + kstate.FT_SB
    var i: u64 = 0
    while i < 256 {
        kstate.set8(buf + i, 0 as u8)
        i = i + 1
    }
    let n: u64 = fs.read_at(state, ino, 0, buf, 255)
    if n < 3 {
        return 0
    }
    if kstate.get8(buf) != 35 {
        return 0
    }
    if kstate.get8(buf + 1) != 33 {
        return 0
    }
    var ende: u64 = 2
    var lookup: bool = true
    while lookup {
        if ende >= n {
            lookup = false
        } else {
            let c: u64 = kstate.get8(buf + ende)
            if c == 10 || c == 13 || c == 0 {
                lookup = false
            } else {
                ende = ende + 1
            }
        }
    }
    var p: u64 = 2
    while p < ende && is_gap(kstate.get8(buf + p)) {
        p = p + 1
    }
    if p >= ende {
        return 0 -% 1
    }
    var k: u64 = 0
    while p < ende && !is_gap(kstate.get8(buf + p)) {
        if k + 1 >= IPATH_MAX {
            return 0 -% 1
        }
        kstate.set8(dst_path + k, kstate.get8(buf + p) as u8)
        k = k + 1
        p = p + 1
    }
    kstate.set8(dst_path + k, 0 as u8)
    if k == 0 {
        return 0 -% 1
    }
    while p < ende && is_gap(kstate.get8(buf + p)) {
        p = p + 1
    }
    if p >= ende {
        return 1
    }
    var e2: u64 = ende
    while e2 > p && is_gap(kstate.get8(buf + e2 - 1)) {
        e2 = e2 - 1
    }
    k = 0
    while p < e2 {
        if k + 1 >= IPATH_MAX {
            return 0 -% 1
        }
        kstate.set8(dst_arg + k, kstate.get8(buf + p) as u8)
        k = k + 1
        p = p + 1
    }
    kstate.set8(dst_arg + k, 0 as u8)
    return 2
}

fn copy_word(dst: u64, src: u64, max: u64) -> u64 {
    var i: u64 = 0
    while i < max {
        let c: u64 = kstate.get8(src + i)
        kstate.set8(dst + i, c as u8)
        if c == 0 {
            return i + 1
        }
        i = i + 1
    }
    kstate.set8(dst + max - 1, 0 as u8)
    return max
}

fn word_at(args: u64, k: u64) -> u64 {
    var at: u64 = 0
    var i: u64 = 0
    while i < k {
        while kstate.get8(args + at) != 0 {
            at = at + 1
        }
        at = at + 1
        i = i + 1
    }
    return args + at
}

const IPATH_SLOT: u64 = 0x40
const IARGS_SLOT: u64 = 0x48

const DYN_PHDR: u64 = 0x50
const DYN_PHNUM: u64 = 0x58
const DYN_ENTRY: u64 = 0x60
const DYN_TOP: u64 = 0x68
const DYN_IBASE: u64 = 0x70

const INTERP_BASE: u64 = 0x44200000

const PIE_BASE: u64 = 0x40100000

fn read_interp(state: u64, ino: u64, dst: u64) -> u64 {
    let h: u64 = head(state)
    let size: u64 = fs.inode_size(state, ino)
    let n: u64 = regio.read16(h + E_PHNUM)
    var seg: u64 = 0
    while seg < n {
        let ph: u64 = h + EHSIZE + seg * PHENTSIZE
        if regio.read32(ph + P_TYPE) == PT_INTERP {
            let off: u64 = regio.read64(ph + P_OFFSET)
            let len: u64 = regio.read64(ph + P_FILESZ)
            if len == 0 {
                return R_IPATH
            }
            if len > IPATH_MAX {
                return R_IPATH
            }
            if off > size {
                return R_IPATH
            }
            if size - off < len {
                return R_IPATH
            }
            if fs.read_at_cached(state, ino, off, dst, len) != len {
                return R_READ
            }
            if kstate.get8(dst + len - 1) != 0 {
                return R_IPATH
            }
            return R_OK
        }
        seg = seg + 1
    }
    return R_KEINER
}

fn jail_ipath(state: u64, ip: u64) -> bool {
    let t: u64 = sched.current(state)
    if !ctr.jail_needed(state, t) {
        return true
    }
    var n: u64 = 0
    while n < IPATH_MAX && kstate.get8(ip + n) != 0 {
        n = n + 1
    }
    if n == 0 || n >= IPATH_MAX || kstate.get8(ip) != 47 {
        return false
    }
    return ctr.jail(state, t, ip, n, IPATH_MAX) != 0
}

fn aufloesen(state: u64, path: u64, args: u64, argc: u64) -> u64 {
    var p: u64 = path
    var a: u64 = args
    var n: u64 = argc
    var level: u64 = 0
    var page: u64 = 0
    var search: bool = true
    while search {
        let ino: u64 = fs.path(state, p)
        if ino == 0 {
            fail(state, R_NOFILE)
            return errno.neg(errno.E_NOENT)
        }
        if fs.inode_type(state, ino) != fs.T_FILE {
            fail(state, R_ISDIR)
            return errno.neg(errno.E_ISDIR)
        }
        let k16: u64 = state + kstate.K16_OFF
        let ip: u64 = k16 + kstate.FT_IPATH + page * IPATH_MAX
        let ia: u64 = k16 + kstate.FT_IPATH + 2 * IPATH_MAX + page * IPATH_MAX
        let w: u64 = read_shebang(state, ino, ip, ia)
        if w == 0 {
            search = false
        } else {
            if w == (0 -% 1) {
                fail(state, R_INTERP)
                return errno.neg(errno.E_LOOP)
            }
            if level >= MAX_INTERP {
                fail(state, R_INTERP)
                return errno.neg(errno.E_LOOP)
            }
            let na: u64 = k16 + kstate.FT_ARGS + page * IARGS_MAX
            var at: u64 = 0
            var fresh: u64 = 0
            at = at + copy_word(na + at, ip, IWORD_MAX)
            fresh = fresh + 1
            if w == 2 {
                at = at + copy_word(na + at, ia, IWORD_MAX)
                fresh = fresh + 1
            }
            at = at + copy_word(na + at, p + ctr.prefix_len(state, sched.current(state), p), IWORD_MAX)
            fresh = fresh + 1
            var k: u64 = 1
            while k < n {
                if at + IWORD_MAX > IARGS_MAX {
                    fail(state, R_ARGS)
                    return errno.neg(errno.E_2BIG)
                }
                at = at + copy_word(na + at, word_at(a, k), IWORD_MAX)
                fresh = fresh + 1
                k = k + 1
            }
            if fresh > procbase.MAX_ARGS {
                fail(state, R_ARGS)
                return errno.neg(errno.E_2BIG)
            }
            let z: u64 = kstate.K16_OFF + kstate.FT_SCALARS
                + kstate.FT_SHEBANGS
            kstate.set(state, z, kstate.get(state, z) + 1)
            if !jail_ipath(state, ip) {
                fail(state, R_INTERP)
                return errno.neg(errno.E_NOENT)
            }
            p = ip
            a = na
            n = fresh
            page = 1 - page
            level = level + 1
        }
    }
    kstate.set(state, kstate.K16_OFF + kstate.FT_SCALARS + IPATH_SLOT, p)
    kstate.set(state, kstate.K16_OFF + kstate.FT_SCALARS + IARGS_SLOT, a)
    return n
}

const LK_CELL: u64 = 4096 - 16
const LK_SPINS: u64 = 4096 - 8
const LK_STUCK: u64 = 400000000

fn lock_enter(state: u64) -> u64 {
    let flags: u64 = sched.irq_save()
    if kstate.mode_on(state, kstate.M_NOELFLOCK) {
        return flags
    }
    let cell: u64 = state + kstate.ELF_OFF + LK_CELL
    var spins: u64 = 0
    while atomic.cas(cell, 0, 1) != 0 {
        atomic.pause()
        spins = spins + 1
        if spins == LK_STUCK {
            say_lock_stuck()
        }
    }
    if spins > 0 {
        atomic.fetch_add(state + kstate.ELF_OFF + LK_SPINS, spins)
    }
    return flags
}

fn lock_leave(state: u64, flags: u64) {
    atomic.store(state + kstate.ELF_OFF + LK_CELL, 0)
    sched.irq_restore(flags)
}

fn say_lock_stuck() {
    var s: [u8; 17] = "elf: lock stuck\n\0"
    serial.puts((&s[0]) as u64)
}

fn build(state: u64, path: u64, args: u64, argc: u64, prio: u64) -> u64 {
    fail(state, R_OK)
    if kstate.get(state, kstate.FS_READY) == 0 {
        fail(state, R_NOFILE)
        return 0
    }
    let n: u64 = aufloesen(state, path, args, argc)
    if errno.is_error(n) {
        return 0
    }
    let p: u64 = kstate.get(state, kstate.K16_OFF + kstate.FT_SCALARS
        + IPATH_SLOT)
    let a: u64 = kstate.get(state, kstate.K16_OFF + kstate.FT_SCALARS
        + IARGS_SLOT)
    let ino: u64 = fs.path(state, p)
    if ino == 0 {
        fail(state, R_NOFILE)
        return 0
    }
    if !perm.may(state, sched.current(state), ino, perm.R_EXEC) {
        fail(state, R_PERM)
        return 0
    }
    let bundle: u64 = origin.probe(state, path)
    let flags: u64 = sched.irq_save()
    let t: u64 = procspace.create_bare(state, prio)
    if t == 0 {
        sched.irq_restore(flags)
        if sched.free_slots(state) == 0 {
            fail(state, R_NOSLOT)
        } else {
            fail(state, R_NOMEM)
        }
        return 0
    }
    var r0: u64 = read_header(state, ino)
    if r0 != R_OK {
        procswap.discard(state, t)
        sched.irq_restore(flags)
        fail(state, r0)
        return 0
    }
    let h0: u64 = head(state)
    let ist_dyn: bool = regio.read16(h0 + E_TYPE) == ET_DYN
    let ipath: u64 = state + kstate.K16_OFF + kstate.FT_IPATH
        + 3 * IPATH_MAX
    let ir: u64 = read_interp(state, ino, ipath)
    if ir != R_KEINER {
        if ir != R_OK {
            procswap.discard(state, t)
            sched.irq_restore(flags)
            fail(state, ir)
            return 0
        }
    }
    let braucht_lader: bool = ir == R_OK
    if braucht_lader {
        say_interp(state, ipath)
    }
    var bias: u64 = 0
    if ist_dyn {
        bias = PIE_BASE
        var window_end: u64 = procmap.IMAGE_END
        if braucht_lader {
            window_end = INTERP_BASE
        }
        if bigpie.needs_high(image_extent(state), PIE_BASE, window_end) {
            bias = bigpie.HIGH_BASE
        }
    }
    let r: u64 = load_at(state, t, ino, bias)
    if r != R_OK {
        procswap.discard(state, t)
        sched.irq_restore(flags)
        fail(state, r)
        return 0
    }
    let sc: u64 = state + kstate.K16_OFF + kstate.FT_SCALARS
    let at_phdr: u64 = kstate.get(state, kstate.K16_OFF
        + kstate.FT_SCALARS + DYN_PHDR)
    let at_phnum: u64 = kstate.get(state, kstate.K16_OFF
        + kstate.FT_SCALARS + DYN_PHNUM)
    let at_entry: u64 = kstate.get(state, kstate.K16_OFF
        + kstate.FT_SCALARS + DYN_ENTRY)
    var start_ip: u64 = at_entry
    var at_base: u64 = 0
    uio.interp_set(state, t, 0)
    if braucht_lader {
        var ipj: u64 = 1
        if !jail_ipath(state, ipath) {
            ipj = 0
        }
        let iino: u64 = fs.path(state, ipath)
        if ipj == 0 || iino == 0 {
            procswap.discard(state, t)
            sched.irq_restore(flags)
            fail(state, R_INOFILE)
            return 0
        }
        if fs.inode_type(state, iino) != fs.T_FILE {
            procswap.discard(state, t)
            sched.irq_restore(flags)
            fail(state, R_INOFILE)
            return 0
        }
        let ir2: u64 = read_header(state, iino)
        if ir2 != R_OK {
            procswap.discard(state, t)
            sched.irq_restore(flags)
            fail(state, R_IFORM)
            return 0
        }
        let chain: u64 = state + kstate.K16_OFF + kstate.FT_IPATH
            + 4 * IPATH_MAX
        if read_interp(state, iino, chain) != R_KEINER {
            procswap.discard(state, t)
            sched.irq_restore(flags)
            fail(state, R_ICHAIN)
            return 0
        }
        let ir3: u64 = load_at(state, t, iino, INTERP_BASE)
        if ir3 != R_OK {
            procswap.discard(state, t)
            sched.irq_restore(flags)
            fail(state, ir3)
            return 0
        }
        at_base = INTERP_BASE
        uio.interp_set(state, t, ipath)
        start_ip = kstate.get(state, kstate.K16_OFF
            + kstate.FT_SCALARS + DYN_ENTRY)
    }
    perm.apply_exec(state, t, ino)
    if !write_args(state, t, a, n) {
        procswap.discard(state, t)
        sched.irq_restore(flags)
        fail(state, R_ARGS)
        return 0
    }
    let h: u64 = head(state)
    var eentry: u64 = start_ip
    if kstate.mode_on(state, kstate.M_EINSPRUNG) {
        eentry = 0xDEAD000000000000
    }
    if eentry == 0 || (eentry >> 47) != 0 {
        say_badentry(state, eentry)
        procswap.discard(state, t)
        sched.irq_restore(flags)
        fail(state, R_ENTRY)
        return 0
    }
    taskslot.tset(state, t, taskconst.T_ENTRY, eentry)
    var ustack: u64 = procspace.ARGS_BASE
    if braucht_lader || ist_dyn {
        let sp: u64 = build_stack(state, t, a, n, at_phdr, at_phnum,
            at_entry, at_base, path)
        if sp == 0 {
            procswap.discard(state, t)
            sched.irq_restore(flags)
            fail(state, R_STACK)
            return 0
        }
        ustack = sp
    }
    taskslot.tset(state, t, taskconst.T_USTACK, ustack)
    taskslot.tset(state, t, taskconst.T_ARG, 0)
    taskslot.tset(state, t, taskconst.T_WORK, procspace.ARGS_BASE)
    kstate.add(state, kstate.SPAWNS, 1)
    kstate.add(state, kstate.EXECS, 1)
    pmon.task_clear(state, t, taskslot.tget(state, t, taskconst.T_PID))
    pmon.name_set(state, t, path)
    uio.exe_set(state, t, path)
    origin.derive(state, sched.current(state), t, path, bundle)
    ax.drop_perm(state, t)
    sched.irq_restore(flags)
    return t
}

fn say_badentry(state: u64, e: u64) {
    var s_a: [u8; 27] = "elf: entry abgelehnt e=\0\0\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.hex(e)
    serial.nl()
}

fn say_start(state: u64, t: u64) {
    if !kstate.mode_on(state, kstate.M_EXECLOG) {
        return
    }
    var s_go: [u8; 12] = "elf: start \0"
    var s_e: [u8; 8] = " entry=\0"
    var s_u: [u8; 9] = " ustack=\0"
    var s_k: [u8; 9] = " kstack=\0"
    var s_b: [u8; 8] = " bytes=\0"
    var s_p: [u8; 8] = " pages=\0"
    serial.puts((&s_go[0]) as u64)
    serial.dec(taskslot.tget(state, t, taskconst.T_PID))
    serial.puts((&s_e[0]) as u64)
    serial.hex(taskslot.tget(state, t, taskconst.T_ENTRY))
    serial.puts((&s_u[0]) as u64)
    serial.hex(taskslot.tget(state, t, taskconst.T_USTACK))
    serial.puts((&s_k[0]) as u64)
    serial.hex(taskslot.tget(state, t, taskconst.T_KSTACK))
    serial.puts((&s_b[0]) as u64)
    serial.dec(kstate.get(state, kstate.ELF_BYTES))
    serial.puts((&s_p[0]) as u64)
    serial.dec(kstate.get(state, kstate.ELF_PAGES))
    serial.nl()
}

fn errno_of(r: u64) -> u64 {
    if r == R_NOFILE {
        return errno.E_NOENT
    }
    if r == R_ISDIR {
        return errno.E_ISDIR
    }
    if r == R_NOMEM {
        return errno.E_NOMEM
    }
    if r == R_ARGS {
        return errno.E_2BIG
    }
    if r == R_PERM {
        return errno.E_ACCES
    }
    if r == R_INTERP {
        return errno.E_LOOP
    }
    if r == R_INOFILE {
        return errno.E_NOENT
    }
    if r == R_ICHAIN {
        return errno.E_LOOP
    }
    if r == R_NOSLOT {
        return errno.E_AGAIN
    }
    return errno.E_NOEXEC
}

fn say_reason(r: u64) {
    var head_t: [u8; 22] = "elf: refused, reason \0"
    var gap: [u8; 3] = "  \0"
    serial.puts((&head_t[0]) as u64)
    serial.dec(r)
    serial.puts((&gap[0]) as u64)
    say_text(r)
    serial.nl()
}

fn say_text(r: u64) {
    if r >= R_IPATH {
        say_text_f(r)
        return
    }
    if r <= 4 {
        say_text_a(r)
        return
    }
    if r <= 9 {
        say_text_b(r)
        return
    }
    if r <= 14 {
        say_text_c(r)
        return
    }
    if r <= 18 {
        say_text_d(r)
        return
    }
    say_text_e(r)
}

fn say_text_a(r: u64) {
    var t1: [u8; 13] = "no such file\0"
    var t2: [u8; 17] = "not a plain file\0"
    var t3: [u8; 22] = "shorter than a header\0"
    var t4: [u8; 13] = "no ELF magic\0"
    var tx: [u8; 8] = "unknown\0"
    if r == R_NOFILE {
        serial.puts((&t1[0]) as u64)
        return
    }
    if r == R_ISDIR {
        serial.puts((&t2[0]) as u64)
        return
    }
    if r == R_SHORT {
        serial.puts((&t3[0]) as u64)
        return
    }
    if r == R_MAGIC {
        serial.puts((&t4[0]) as u64)
        return
    }
    serial.puts((&tx[0]) as u64)
}

fn say_text_b(r: u64) {
    var t5: [u8; 15] = "not ELFCLASS64\0"
    var t6: [u8; 18] = "not little endian\0"
    var t7: [u8; 14] = "wrong version\0"
    var t8: [u8; 12] = "not ET_EXEC\0"
    var t9: [u8; 11] = "not x86-64\0"
    if r == R_CLASS {
        serial.puts((&t5[0]) as u64)
        return
    }
    if r == R_ENDIAN {
        serial.puts((&t6[0]) as u64)
        return
    }
    if r == R_VERSION {
        serial.puts((&t7[0]) as u64)
        return
    }
    if r == R_TYPE {
        serial.puts((&t8[0]) as u64)
        return
    }
    serial.puts((&t9[0]) as u64)
}

fn say_text_c(r: u64) {
    var t10: [u8; 19] = "wrong header sizes\0"
    var t11: [u8; 24] = "no or too many segments\0"
    var t12: [u8; 29] = "program headers past the end\0"
    var t13: [u8; 21] = "segment past the end\0"
    var t14: [u8; 19] = "filesz above memsz\0"
    if r == R_SIZES {
        serial.puts((&t10[0]) as u64)
        return
    }
    if r == R_PHNUM {
        serial.puts((&t11[0]) as u64)
        return
    }
    if r == R_PHOFF {
        serial.puts((&t12[0]) as u64)
        return
    }
    if r == R_SEGFILE {
        serial.puts((&t13[0]) as u64)
        return
    }
    serial.puts((&t14[0]) as u64)
}

fn say_text_d(r: u64) {
    var t15: [u8; 24] = "outside the user region\0"
    var t16: [u8; 17] = "not page aligned\0"
    var t17: [u8; 22] = "two segments one page\0"
    var t18: [u8; 14] = "out of frames\0"
    var tx: [u8; 8] = "unknown\0"
    if r == R_RANGE {
        serial.puts((&t15[0]) as u64)
        return
    }
    if r == R_ALIGN {
        serial.puts((&t16[0]) as u64)
        return
    }
    if r == R_OVERLAP {
        serial.puts((&t17[0]) as u64)
        return
    }
    if r == R_NOMEM {
        serial.puts((&t18[0]) as u64)
        return
    }
    serial.puts((&tx[0]) as u64)
}

fn say_text_e(r: u64) {
    var t19: [u8; 22] = "entry on no exec page\0"
    var t20: [u8; 16] = "short disk read\0"
    var t21: [u8; 11] = "no PT_LOAD\0"
    var t22: [u8; 19] = "arguments too long\0"
    var tx: [u8; 8] = "unknown\0"
    if r == R_ENTRY {
        serial.puts((&t19[0]) as u64)
        return
    }
    if r == R_READ {
        serial.puts((&t20[0]) as u64)
        return
    }
    if r == R_NOLOAD {
        serial.puts((&t21[0]) as u64)
        return
    }
    if r == R_ARGS {
        serial.puts((&t22[0]) as u64)
        return
    }
    serial.puts((&tx[0]) as u64)
}

fn say_text_f(r: u64) {
    var t25: [u8; 20] = "bad PT_INTERP path\0\0"
    var t26: [u8; 22] = "interpreter missing\0\0\0"
    var t27: [u8; 24] = "interpreter chained\0\0\0\0\0"
    var t28: [u8; 22] = "interpreter format\0\0\0\0"
    var t29: [u8; 20] = "start stack too big\0"
    var t30: [u8; 32] = "task table full (limit reached)\0"
    var tz: [u8; 8] = "unknown\0"
    if r == R_IPATH {
        serial.puts((&t25[0]) as u64)
        return
    }
    if r == R_INOFILE {
        serial.puts((&t26[0]) as u64)
        return
    }
    if r == R_ICHAIN {
        serial.puts((&t27[0]) as u64)
        return
    }
    if r == R_IFORM {
        serial.puts((&t28[0]) as u64)
        return
    }
    if r == R_STACK {
        serial.puts((&t29[0]) as u64)
        return
    }
    if r == R_NOSLOT {
        serial.puts((&t30[0]) as u64)
        return
    }
    serial.puts((&tz[0]) as u64)
}

fn say_interp(state: u64, p: u64) {
    if !kstate.mode_on(state, kstate.M_EXECLOG) {
        return
    }
    var s_i: [u8; 14] = "elf: interp \0\0"
    serial.puts((&s_i[0]) as u64)
    serial.puts(p)
    serial.nl()
}
