
import lib.kstate
import serial
import mm.mmboot

export {
    parse, stage, recheck, ready, base, bytes, blocks, sum, expected, want,
    crc32, crc32_start, crc32_feed, crc32_end, M_MODFS
}

const BLOCK_SIZE: u64 = 512

const M_MODFS: u64 = 1

fn parse(state: u64, cmd: u64) {
    var w_modfs: [u8; 6] = "modfs\0"
    var w_crc: [u8; 8] = "modcrc=\0"
    var m: u64 = 0
    var soll: u64 = 0
    if cmd != 0 {
        if find(cmd, (&w_modfs[0]) as u64, 5) != 0 {
            m = m | M_MODFS
        }
        let at: u64 = find(cmd, (&w_crc[0]) as u64, 7)
        if at != 0 {
            soll = hex_at(at + 7, 8)
        }
    }
    kstate.set(state, kstate.MOD_MODE, m)
    kstate.set(state, kstate.MOD_WANT, soll)
    kstate.set(state, kstate.MOD_BASE, 0)
    kstate.set(state, kstate.MOD_BYTES, 0)
    kstate.set(state, kstate.MOD_CRC, 0)
    kstate.set(state, kstate.MOD_OK, 0)
}

fn want(state: u64, bit: u64) -> bool {
    return (kstate.get(state, kstate.MOD_MODE) & bit) != 0
}

fn crc32_start() -> u64 {
    return 0xFFFFFFFF
}

static mut crc_table: [u64; 256] = [0 as u64; 256]
static mut crc_ready: [u64; 1] = [0 as u64; 1]

fn crc_build_table() {
    var n: u64 = 0
    while n < 256 {
        var c: u64 = n
        var k: u64 = 0
        while k < 8 {
            let mask: u64 = 0 -% (c & 1)
            c = (c >> 1) ^ (0xEDB88320 & mask)
            k = k + 1
        }
        crc_table[n as usize] = c
        n = n + 1
    }
    crc_ready[0 as usize] = 1
}

fn crc32_feed(seed: u64, p: u64, len: u64) -> u64 {
    if crc_ready[0 as usize] == 0 {
        crc_build_table()
    }
    var crc: u64 = seed
    var i: u64 = 0
    while i < len {
        crc = (crc >> 8) ^ crc_table[((crc ^ kstate.get8(p + i)) & 255) as usize]
        i = i + 1
    }
    return crc
}

fn crc32_end(crc: u64) -> u64 {
    return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF
}

fn crc32(p: u64, len: u64) -> u64 {
    return crc32_end(crc32_feed(crc32_start(), p, len))
}

fn stage(state: u64, mbi: u64) {
    var s_none: [u8; 11] = "mod: none\0\0"
    var s_a: [u8; 11] = "mod: base=\0"
    var s_b: [u8; 9] = "  bytes=\0"
    var s_c: [u8; 7] = "  crc=\0"
    var s_d: [u8; 8] = "  want=\0"
    var s_e: [u8; 6] = "  ok=\0"
    var s_f: [u8; 10] = "  blocks=\0"
    var s_short: [u8; 27] = "mod: shorter than a block\0\0"

    let n: u64 = mmboot.mods(mbi)
    if n == 0 {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    let von: u64 = mmboot.mod_start(mbi, 0)
    let bis: u64 = mmboot.mod_end(mbi, 0)
    if bis <= von || bis - von < BLOCK_SIZE {
        serial.puts((&s_short[0]) as u64)
        serial.nl()
        return
    }
    let len: u64 = bis - von
    let sum: u64 = crc32(von, len)
    let soll: u64 = kstate.get(state, kstate.MOD_WANT)
    var ok: u64 = 1
    if soll != 0 {
        if soll != sum {
            ok = 0
        }
    }
    kstate.set(state, kstate.MOD_BASE, von)
    kstate.set(state, kstate.MOD_BYTES, len)
    kstate.set(state, kstate.MOD_CRC, sum)
    kstate.set(state, kstate.MOD_OK, ok)

    serial.puts((&s_a[0]) as u64)
    serial.hex(von)
    serial.puts((&s_b[0]) as u64)
    serial.dec(len)
    serial.puts((&s_f[0]) as u64)
    serial.dec(len / BLOCK_SIZE)
    serial.puts((&s_c[0]) as u64)
    serial.hex(sum)
    serial.puts((&s_d[0]) as u64)
    serial.hex(soll)
    serial.puts((&s_e[0]) as u64)
    serial.dec(ok)
    serial.nl()
}

fn recheck(state: u64) {
    var s_a: [u8; 18] = "mod: recheck crc=\0"
    var s_b: [u8; 8] = "  same=\0"
    if kstate.get(state, kstate.MOD_BYTES) == 0 {
        return
    }
    let now: u64 = crc32(base(state), bytes(state))
    var same: u64 = 0
    if now == kstate.get(state, kstate.MOD_CRC) {
        same = 1
    }
    serial.puts((&s_a[0]) as u64)
    serial.hex(now)
    serial.puts((&s_b[0]) as u64)
    serial.dec(same)
    serial.nl()
}

fn ready(state: u64) -> bool {
    if !want(state, M_MODFS) {
        return false
    }
    if kstate.get(state, kstate.MOD_OK) == 0 {
        return false
    }
    return kstate.get(state, kstate.MOD_BYTES) >= BLOCK_SIZE
}

fn base(state: u64) -> u64 {
    return kstate.get(state, kstate.MOD_BASE)
}

fn bytes(state: u64) -> u64 {
    return kstate.get(state, kstate.MOD_BYTES)
}

fn blocks(state: u64) -> u64 {
    return kstate.get(state, kstate.MOD_BYTES) / BLOCK_SIZE
}

fn sum(state: u64) -> u64 {
    return kstate.get(state, kstate.MOD_CRC)
}

fn expected(state: u64) -> u64 {
    return kstate.get(state, kstate.MOD_WANT)
}

fn hex_at(p: u64, n: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < n {
        let c: u64 = kstate.get8(p + i)
        var d: u64 = 16
        if c >= 48 && c <= 57 {
            d = c - 48
        }
        if c >= 97 && c <= 102 {
            d = c - 87
        }
        if c >= 65 && c <= 70 {
            d = c - 55
        }
        if d == 16 {
            return v
        }
        v = (v << 4) | d
        i = i + 1
    }
    return v
}

fn find(heu: u64, nadel: u64, n: u64) -> u64 {
    if heu == 0 || n == 0 {
        return 0
    }
    var i: u64 = 0
    while true {
        let c: u64 = kstate.get8(heu + i)
        if c == 0 {
            return 0
        }
        var k: u64 = 0
        var same: bool = true
        while k < n {
            let a: u64 = kstate.get8(heu + i + k)
            if a == 0 || a != kstate.get8(nadel + k) {
                same = false
                k = n
            } else {
                k = k + 1
            }
        }
        if same {
            return heu + i
        }
        i = i + 1
    }
    return 0
}
