profile kernel

import gfx.fb
import drv.hid.ps2m
import ldr.modidx

export { attach, attached, DEFAULT_W, DEFAULT_H }

const DEFAULT_W: u64 = 1024
const DEFAULT_H: u64 = 768

static mut n_attached: u64 = 0

fn attached() -> u64 {
    return n_attached
}

fn screen_w(state: u64) -> u64 {
    if fb.ready(state) && fb.width(state) > 0 {
        return fb.width(state)
    }
    return DEFAULT_W
}

fn screen_h(state: u64) -> u64 {
    if fb.ready(state) && fb.height(state) > 0 {
        return fb.height(state)
    }
    return DEFAULT_H
}

fn attach_mouse(state: u64) -> bool {
    return ps2m.rebind(state, screen_w(state), screen_h(state))
}

fn attach(state: u64, slot: u64) -> bool {
    var ok: bool = false
    if slot == modidx.SLOT_MOUSE {
        ok = attach_mouse(state)
    }
    if ok {
        n_attached = n_attached + 1
    }
    return ok
}
