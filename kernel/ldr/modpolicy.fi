profile kernel

import lib.kstate
import modpolicy.policyhex

export { key_total, key_copy, floor_total, floor_hit }

const SIG_LEN: u64 = 64
const KEY_LEN: u64 = 32

fn key_total() -> u64 {
    return policyhex.key_total()
}

fn floor_total() -> u64 {
    return policyhex.floor_total()
}

fn key_copy(k: u64, dst: u64) {
    var j: u64 = 0
    while j < KEY_LEN {
        kstate.set8(dst + j, policyhex.key_byte(k, j) as u8)
        j = j + 1
    }
}

fn floor_hit(sig: u64) -> bool {
    var e: u64 = 0
    while e < policyhex.floor_total() {
        var same: bool = true
        var j: u64 = 0
        while j < SIG_LEN {
            if kstate.get8(sig + j) != policyhex.floor_byte(e, j) {
                same = false
                j = SIG_LEN
            }
            j = j + 1
        }
        if same {
            return true
        }
        e = e + 1
    }
    return false
}
