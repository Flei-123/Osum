profile kernel

import ldr.modtab
import ldr.modidx
import ldr.module

export { present, info, control, status }

fn present(state: u64) -> bool {
    return modtab.have(state, modidx.SLOT_AUX)
}

fn info(state: u64) -> u64 {
    let a: u64 = modtab.op(state, modidx.SLOT_AUX, modidx.A_INFO)
    if a == 0 {
        return 0
    }
    return module.ruf1(a, state)
}

fn control(state: u64, cmd: u64, arg: u64) -> u64 {
    let a: u64 = modtab.op(state, modidx.SLOT_AUX, modidx.A_CONTROL)
    if a == 0 {
        return 0
    }
    return module.ruf3(a, state, cmd, arg)
}

fn status(state: u64) -> u64 {
    let a: u64 = modtab.op(state, modidx.SLOT_AUX, modidx.A_STATUS)
    if a == 0 {
        return 0
    }
    return module.ruf1(a, state)
}
