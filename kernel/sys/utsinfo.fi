profile kernel

import lib.kstate

export { F_SYSNAME, F_NODENAME, F_RELEASE, F_VERSION, F_MACHINE, F_DOMAIN, FIELD_COUNT, copy_field }

const F_SYSNAME: u64 = 0
const F_NODENAME: u64 = 1
const F_RELEASE: u64 = 2
const F_VERSION: u64 = 3
const F_MACHINE: u64 = 4
const F_DOMAIN: u64 = 5
const FIELD_COUNT: u64 = 6

fn copy_text(out: u64, text: u64) -> u64 {
    var n: u64 = 0
    while kstate.get8(text + n) != 0 {
        kstate.set8(out + n, kstate.get8(text + n) as u8)
        n = n + 1
    }
    return n
}

fn copy_field(field: u64, out: u64) -> u64 {
    var sysname: [u8; 6] = "Linux\0"
    var nodename: [u8; 5] = "osum\0"
    var release: [u8; 6] = "6.1.0\0"
    var version: [u8; 5] = "Osum\0"
    var machine: [u8; 7] = "x86_64\0"
    var domain: [u8; 7] = "(none)\0"
    if field == F_SYSNAME {
        return copy_text(out, (&sysname[0]) as u64)
    }
    if field == F_NODENAME {
        return copy_text(out, (&nodename[0]) as u64)
    }
    if field == F_RELEASE {
        return copy_text(out, (&release[0]) as u64)
    }
    if field == F_VERSION {
        return copy_text(out, (&version[0]) as u64)
    }
    if field == F_MACHINE {
        return copy_text(out, (&machine[0]) as u64)
    }
    if field == F_DOMAIN {
        return copy_text(out, (&domain[0]) as u64)
    }
    return 0
}
