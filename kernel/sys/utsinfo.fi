// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import lib.kstate

export { F_SYSNAME, F_NODENAME, F_RELEASE, F_VERSION, F_MACHINE, F_DOMAIN, FIELD_COUNT, NAME_MAX, copy_field, set_field }

const F_SYSNAME: u64 = 0
const F_NODENAME: u64 = 1
const F_RELEASE: u64 = 2
const F_VERSION: u64 = 3
const F_MACHINE: u64 = 4
const F_DOMAIN: u64 = 5
const FIELD_COUNT: u64 = 6
const NAME_MAX: u64 = 64
const NAME_BYTES: u64 = 65

static mut node_buf: [u8; 65] = [0 as u8; 65]
static mut domain_buf: [u8; 65] = [0 as u8; 65]
static mut node_set: u64 = 0
static mut domain_set: u64 = 0

fn copy_set(out: u64, buf: u64) -> u64 {
    var n: u64 = 0
    while n < NAME_BYTES && kstate.get8(buf + n) != 0 {
        kstate.set8(out + n, kstate.get8(buf + n) as u8)
        n = n + 1
    }
    return n
}

fn set_field(field: u64, text: u64, len: u64) -> bool {
    if len > NAME_MAX {
        return false
    }
    var dst: u64 = (&node_buf[0]) as u64
    if field == F_DOMAIN {
        dst = (&domain_buf[0]) as u64
    } else if field != F_NODENAME {
        return false
    }
    var i: u64 = 0
    while i < NAME_BYTES {
        kstate.set8(dst + i, 0)
        i = i + 1
    }
    i = 0
    while i < len {
        kstate.set8(dst + i, kstate.get8(text + i) as u8)
        i = i + 1
    }
    if field == F_DOMAIN {
        domain_set = 1
    } else {
        node_set = 1
    }
    return true
}

fn copy_text(out: u64, text: u64) -> u64 {
    var n: u64 = 0
    while kstate.get8(text + n) != 0 {
        kstate.set8(out + n, kstate.get8(text + n) as u8)
        n = n + 1
    }
    return n
}

fn copy_field(field: u64, out: u64) -> u64 {
    var sysname: [u8; 6] = "Linux\0"
    var nodename: [u8; 5] = "osum\0"
    var release: [u8; 6] = "6.1.0\0"
    var version: [u8; 5] = "Osum\0"
    var machine: [u8; 7] = "x86_64\0"
    var domain: [u8; 7] = "(none)\0"
    if field == F_SYSNAME {
        return copy_text(out, (&sysname[0]) as u64)
    }
    if field == F_NODENAME {
        if node_set != 0 {
            return copy_set(out, (&node_buf[0]) as u64)
        }
        return copy_text(out, (&nodename[0]) as u64)
    }
    if field == F_RELEASE {
        return copy_text(out, (&release[0]) as u64)
    }
    if field == F_VERSION {
        return copy_text(out, (&version[0]) as u64)
    }
    if field == F_MACHINE {
        return copy_text(out, (&machine[0]) as u64)
    }
    if field == F_DOMAIN {
        if domain_set != 0 {
            return copy_set(out, (&domain_buf[0]) as u64)
        }
        return copy_text(out, (&domain[0]) as u64)
    }
    return 0
}
