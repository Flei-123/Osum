export {
    AF_INET, AF_UNIX, AX_BASE, AX_MAXNR, BLOCK_ROUNDS, F_R10, F_R8, F_RAX, F_RDI, F_RDX, F_RIP, F_RSI, IN_CREATE, IN_DELETE, IN_ISDIR, LC_OPENAT, LC_READLINKAT, LC_RENAMEAT2, MAP_ANONYMOUS, MAX_IO, MAX_NAME, MH_BYTES, MH_CONTROLLEN, MH_FLAGS, MH_IOV, MH_IOVLEN, MSG_DONTWAIT, MSG_MAX, NET_ROUNDS, NL_MSG_PEEK, NL_MSG_TRUNC, NL_SA_BYTES, O_APPEND, O_RDWR, PAGE, SEEK_CUR, SEEK_END, SEEK_SET, SOCK_DGRAM, SOCK_NONBLOCK, SOL_SOCKET, SYS_OSUM_CTRENTER, SYS_OSUM_EBPFLOAD, SYS_OSUM_EBPFPROG, SYS_OSUM_NETGET, SYS_OSUM_PWRGET, SYS_VM_CREATE, SYS_VM_VALUE, UB_O_NONBLOCK, WIG_BASE, WIG_MAXNR, WL_PATH, WL_SCRATCH
}

const SYS_VM_CREATE: u64 = 1500
const SYS_VM_VALUE: u64 = 1504

// `struct sockaddr_in`: sixteen octets, the family in the byte order of
// the machine, the port and the address in the byte order of the WIRE.
// That mixture is not a mistake of this kernel, it is what the interface
// has looked like since 4.2BSD, and a program that assumes anything else
// would not work on Linux either.
const AF_INET: u64 = 2
const SOCK_DGRAM: u64 = 2
// The two flags Linux packs into the TYPE argument (and into `accept4`).
const SOCK_NONBLOCK: u64 = 2048 // 0o4000

// How long a blocking socket call waits before it gives up with
// -EAGAIN. Bounded for the same reason `BLOCK_ROUNDS` is: a measurement
// that ends in the time limit of the shell script measures nothing, and
// a kernel that cannot say why it stopped is worse than one that stops.
// 100 Hz, so this is thirty seconds.
const NET_ROUNDS: u64 = 3000

// ---------------------------------------------------- RUNDE K15
// SEVEN NUMBERS, 1910..1916, FOR THE ACCESSIBILITY TREE (S-007,
// docs/A11Y.md 5). The old branch `archiv/a11y` had 1960..1965 -- today
// SYS_OSUM_BUS; `tools/kernel/syscalls.py --zweige` showed 1904..1949
// free on every branch. The bodies are in `kernel/sys/sysgui.fi`
// (`ax_call`), reached through the seam `gfx.sys_ax`: without a window
// server there is no window and so no tree (-ENOSYS).
//
// WHO MAY WHAT:
//   AX_PUSH   anyone, ONLY for itself and only for its own windows (the
//             kernel stamps task and window slot into every node)
//   AX_READ   only with the right P_READ (given by euid 0, falls at exec)
//   AX_EVENT  the same -- a focus change tells where the user types
//   AX_PERM   ask about oneself: anyone; grant / revoke: euid 0
//   AX_INFO   open -- numbers ABOUT the tree, nothing FROM it
//   AX_SET    euid 0 -- high contrast, magnifier, sticky keys are for all
//   AX_PRESS  only with the right P_ACT, and only into windows the target
//             rule allows (sysgui.ax_target)
const AX_BASE: u64 = 1910
const AX_MAXNR: u64 = 1916

const WIG_BASE: u64 = 1800
const WIG_MAXNR: u64 = 1809

// ---------------------------------------------------------- Runde K11
const SYS_OSUM_NETGET: u64 = 1300
const SYS_OSUM_CTRENTER: u64 = 1333

// ======================================================= RUNDE O-EBPF
const SYS_OSUM_EBPFLOAD: u64 = 1405
const SYS_OSUM_EBPFPROG: u64 = 1409

const SYS_OSUM_PWRGET: u64 = 1750
const F_R8: u64 = 56
const F_R10: u64 = 64
const F_RDX: u64 = 72
const F_RSI: u64 = 80
const F_RDI: u64 = 88
const F_RAX: u64 = 96
const F_RIP: u64 = 104
const O_RDWR: u64 = 2
const O_APPEND: u64 = 1024 // 0o2000

const SEEK_SET: u64 = 0
const SEEK_CUR: u64 = 1
const SEEK_END: u64 = 2
const MAP_ANONYMOUS: u64 = 32

// The most a single `read` or `write` moves. The bounce buffer in the data
// area is one page, and a call that asks for more gets a SHORT answer, the
// way a Unix `read` may always give one -- not an error.
const MAX_IO: u64 = 4096
const MAX_NAME: u64 = 1024

// How long a blocked reader or writer waits before it gives up. At 100 Hz
// this is four seconds. A pipe with nobody at the other end must not be
// able to stop the machine: a measurement that ends in a time limit
// measures nothing.
const BLOCK_ROUNDS: u64 = 400
const PAGE: u64 = 4096

// ======================================================= RUNDE WAYLAND

const AF_UNIX: u64 = 1
const SOL_SOCKET: u64 = 1
const MSG_DONTWAIT: u64 = 64

const MSG_MAX: u64 = 2048

const WL_SCRATCH: u64 = 0xFE000
const WL_PATH: u64 = 0xFF000

// --------------------------------------------------- sendmsg / recvmsg
//   struct msghdr {
//     void *msg_name; socklen_t msg_namelen;      +0  +8
//     struct iovec *msg_iov; size_t msg_iovlen;   +16 +24
//     void *msg_control; size_t msg_controllen;   +32 +40
//     int msg_flags;                              +48
//   }
//   struct iovec { void *iov_base; size_t iov_len; }
//   struct cmsghdr { size_t cmsg_len; int cmsg_level; int cmsg_type; }

const MH_IOV: u64 = 16
const MH_IOVLEN: u64 = 24
const MH_CONTROLLEN: u64 = 40
const MH_FLAGS: u64 = 48
const MH_BYTES: u64 = 56
const UB_O_NONBLOCK: u64 = 2048

// ---------------------------------------------------------------- inotify events from the file system calls

const IN_CREATE: u64 = 0x100
const IN_DELETE: u64 = 0x200
const IN_ISDIR: u64 = 0x40000000

// ==================================================================
// ROUND NETLINK (r696): AF_NETLINK / NETLINK_ROUTE. The message formats and the answers are in net/netlink.fi; this block is the system
// calls around it (user memory, blocking, descriptors). A request is answered inside the call that carries it, so a read finds the
// reply already in the ring of the socket.
// ==================================================================
const NL_MSG_PEEK: u64 = 2
const NL_MSG_TRUNC: u64 = 32
const NL_SA_BYTES: u64 = 12 // struct sockaddr_nl: family (2), pad (2), pid (4), groups (4)

// ---------------------------------------------------------------- RUNDE LC4: the `*at` family
const LC_OPENAT: u64 = 257
const LC_READLINKAT: u64 = 267
const LC_RENAMEAT2: u64 = 316
