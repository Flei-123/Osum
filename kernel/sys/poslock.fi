profile kernel

import lib.kstate

export {
    L_INO, L_VON, L_UNTIL, L_ART, L_PID, L_MNT,
    get, put, free, drop_owner, drop_file
}

const L_INO: u64 = 0
const L_VON: u64 = 8
const L_UNTIL: u64 = 16
const L_ART: u64 = 24
const L_PID: u64 = 32
const L_MNT: u64 = 40

fn slot_off(i: u64) -> u64 {
    return kstate.FLOCK_OFF + i * kstate.FLOCK_BYTES
}

fn in_table(off: u64) -> bool {
    return off >= kstate.FLOCK_OFF && off + 8 <= kstate.FLOCK_OFF + kstate.FLOCK_MAX
}

fn get(state: u64, i: u64, field: u64) -> u64 {
    let off: u64 = slot_off(i) + field
    if !in_table(off) {
        return 0
    }
    return kstate.get(state, off)
}

fn put(state: u64, i: u64, field: u64, v: u64) {
    let off: u64 = slot_off(i) + field
    if !in_table(off) {
        return
    }
    kstate.set(state, off, v)
}

fn free(state: u64, i: u64) {
    put(state, i, L_INO, 0)
    put(state, i, L_MNT, 0)
    put(state, i, L_VON, 0)
    put(state, i, L_UNTIL, 0)
    put(state, i, L_ART, 0)
    put(state, i, L_PID, 0)
}

fn drop_owner(state: u64, owner: u64) {
    if owner == 0 {
        return
    }
    var k: u64 = 0
    while k < kstate.FLOCK_SLOTS {
        if get(state, k, L_INO) != 0 && get(state, k, L_PID) == owner {
            free(state, k)
        }
        k = k + 1
    }
}

fn drop_file(state: u64, owner: u64, ino: u64, mnt: u64) {
    if owner == 0 || ino == 0 {
        return
    }
    var k: u64 = 0
    while k < kstate.FLOCK_SLOTS {
        if get(state, k, L_INO) == ino && get(state, k, L_MNT) == mnt && get(state, k, L_PID) == owner {
            free(state, k)
        }
        k = k + 1
    }
}
