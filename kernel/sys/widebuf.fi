import lib.kstate
import arch.cpu

export { buffer, WIDE_BYTES }

const WIDE_BYTES: u64 = 65536
const WIDE_CPUS: u64 = 8

static mut slabs: [u8; 524288] = [0 as u8; 524288]

fn buffer(state: u64) -> u64 {
    var k: u64 = cpu.here(state)
    if k >= WIDE_CPUS {
        k = 0
    }
    return ((&slabs[0 as usize]) as u64) + k * WIDE_BYTES
}
