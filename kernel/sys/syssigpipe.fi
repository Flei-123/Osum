profile kernel

import lib.errno
import sched.signal
import libc.regio

export { after }

const SYS_WRITE: u64 = 1
const SYS_PWRITE64: u64 = 18
const SYS_WRITEV: u64 = 20
const SYS_SENDTO: u64 = 44
const SYS_SENDMSG: u64 = 46
const SYS_SENDMMSG: u64 = 307
const SYS_PWRITEV: u64 = 296
const SYS_PWRITEV2: u64 = 328

const F_R10: u64 = 64
const F_RDX: u64 = 72
const MSG_NOSIGNAL: u64 = 0x4000

fn flags_of(number: u64, frame: u64) -> u64 {
    if number == SYS_SENDTO || number == SYS_SENDMMSG {
        return regio.read64_at(frame, F_R10)
    }
    if number == SYS_SENDMSG {
        return regio.read64_at(frame, F_RDX)
    }
    return 0
}

fn writes(number: u64) -> bool {
    return number == SYS_WRITE || number == SYS_PWRITE64 || number == SYS_WRITEV || number == SYS_PWRITEV
        || number == SYS_PWRITEV2 || number == SYS_SENDTO || number == SYS_SENDMSG || number == SYS_SENDMMSG
}

fn after(state: u64, me: u64, frame: u64, number: u64, result: u64) {
    if result != errno.neg(errno.E_PIPE) {
        return
    }
    if !writes(number) {
        return
    }
    if (flags_of(number, frame) & MSG_NOSIGNAL) != 0 {
        return
    }
    let _raised: bool = signal.send_task(state, me, signal.SIGPIPE)
}
