import lib.errno
import lib.kstate
import fs.evfd
import fs.file
import sched.sched
import sched.signal
import sched.taskconst
import sched.taskslot
import sys.sysfd
import sys.sysuser

export {
    handles, call
}

const SYS_PIDFD_SEND_SIGNAL: u64 = 424
const SYS_PIDFD_OPEN: u64 = 434
const SYS_PIDFD_GETFD: u64 = 438

const PIDFD_NONBLOCK: u64 = 2048
const FLAGS_NONE: u64 = 0
const FD_MASK: u64 = 0xFFFFFFFF

fn fail(e: u64) -> u64 {
    return sysuser.neg(e)
}

fn handles(number: u64) -> bool {
    return number == SYS_PIDFD_SEND_SIGNAL || number == SYS_PIDFD_OPEN || number == SYS_PIDFD_GETFD
}

fn call(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64, a3: u64) -> u64 {
    if number == SYS_PIDFD_OPEN {
        return do_open(state, me, a0, a1)
    }
    if number == SYS_PIDFD_SEND_SIGNAL {
        return do_send_signal(state, me, a0, a1, a2, a3)
    }
    return do_getfd(state, me, a0, a1, a2)
}

fn pidfd_of(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = sysuser.of_of(state, me, fd & FD_MASK)
    if of >= file.MAX_OPEN || file.open_kind(state, of) != file.K_PIDFD {
        return file.MAX_OPEN
    }
    return of
}

fn do_open(state: u64, me: u64, pid: u64, flags: u64) -> u64 {
    if (flags & (0xFFFFFFFF -% PIDFD_NONBLOCK)) != 0 || (pid & FD_MASK) == 0 || (pid & 0x80000000) != 0 {
        return fail(errno.E_INVAL)
    }
    if sched.find_pid(state, pid & FD_MASK) >= kstate.MAX_TASKS {
        return fail(errno.E_SRCH)
    }
    let of: u64 = evfd.pidfd_new(state, pid & FD_MASK, flags)
    if of >= file.MAX_OPEN {
        return fail(errno.E_NFILE)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        return fail(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    sysfd.cx_put(state, me, fd, true)
    return fd
}

fn do_send_signal(state: u64, me: u64, fd: u64, sig: u64, info: u64, flags: u64) -> u64 {
    if flags != FLAGS_NONE {
        return fail(errno.E_INVAL)
    }
    let of: u64 = pidfd_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return fail(errno.E_BADF)
    }
    if evfd.pidfd_gone(state, of) && sig != 0 {
        return fail(errno.E_SRCH)
    }
    return signal.do_kill(state, me, evfd.pidfd_pid(state, of), sig & FD_MASK)
}

fn may_take(state: u64, me: u64, target: u64) -> bool {
    if taskslot.tget(state, me, taskconst.T_EUID) == 0 {
        return true
    }
    return taskslot.tget(state, me, taskconst.T_EUID) == taskslot.tget(state, target, taskconst.T_UID)
}

fn do_getfd(state: u64, me: u64, fd: u64, target_fd: u64, flags: u64) -> u64 {
    if flags != FLAGS_NONE {
        return fail(errno.E_INVAL)
    }
    let of: u64 = pidfd_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return fail(errno.E_BADF)
    }
    let target: u64 = sched.find_pid(state, evfd.pidfd_pid(state, of))
    if target >= kstate.MAX_TASKS || evfd.pidfd_gone(state, of) {
        return fail(errno.E_SRCH)
    }
    if !may_take(state, me, target) {
        return fail(errno.E_PERM)
    }
    let src: u64 = sysuser.of_of(state, target, target_fd & FD_MASK)
    if src >= file.MAX_OPEN {
        return fail(errno.E_BADF)
    }
    let nfd: u64 = file.fd_alloc(state, me, 0)
    if nfd >= file.MAX_FD {
        return fail(errno.E_MFILE)
    }
    file.open_ref(state, src)
    file.fd_set(state, me, nfd, src)
    sysfd.cx_put(state, me, nfd, true)
    return nfd
}
