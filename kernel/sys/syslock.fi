import sys.fdscope
import lib.kstate
import sched.taskconst
import sched.taskslot
import sched.proc.procfault
import lib.errno
import fs.file
import fs.unixsock
import net.inet
import sys.sysconst
import sys.sysuser
import sys.sysfd
import sys.fowner
import sys.fcntllock

export {
    do_fcntl
}

const F_DUPFD: u64 = 0
const F_GETFD: u64 = 1
const F_SETFD: u64 = 2
const F_GETFL: u64 = 3
const F_SETFL: u64 = 4
const F_DUPFD_CLOEXEC: u64 = 1030
const F_SETPIPE_SZ: u64 = 1031
const F_GETPIPE_SZ: u64 = 1032

fn do_fcntl(state: u64, me: u64, fd: u64, cmd: u64, arg: u64) -> u64 {
    let of: u64 = fdscope.use(state, me, fd, 0)
    if of >= file.MAX_OPEN {
        return sysuser.neg(errno.E_BADF)
    }
    if cmd == F_GETFL {
        return file.open_flags(state, of)
    }
    if cmd == F_SETFL {
        // RUNDE UNTERBAU: the two flags that can change after open(): O_NONBLOCK and O_APPEND. Until now F_SETFL answered 0 and kept
        // nothing, so `fcntl(fd, F_SETFL, O_NONBLOCK)` -- the first thing an event loop does to a socket or a pipe -- had no effect.
        let keep: u64 = sysconst.UB_O_NONBLOCK | sysconst.O_APPEND | sysconst.UB_O_ASYNC
        file.open_set_flags(state, of, (file.open_flags(state, of) & (~keep)) | (arg & keep))
        if file.open_kind(state, of) == file.K_SOCK {
            inet.sock_put_nonblock(state, file.open_ino(state, of), (arg & sysconst.UB_O_NONBLOCK) != 0)
        }
        return 0
    }
    if cmd == F_GETFD {
        return sysfd.cx_bit(state, me, fd)
    }
    if cmd == F_SETFD {
        sysfd.cx_put(state, me, fd, (arg & 1) != 0)
        return 0
    }
    if cmd == F_DUPFD || cmd == F_DUPFD_CLOEXEC {
        let nd: u64 = sysfd.do_dup_min(state, me, fd, arg)
        if cmd == F_DUPFD_CLOEXEC && !errno.is_error(nd) {
            sysfd.cx_put(state, me, nd, true)
        }
        return nd
    }
    if fcntllock.is_lock_cmd(cmd) {
        return fcntllock.do_lock(state, me, of, cmd, arg)
    }
    if cmd == fowner.F_SETOWN {
        return fowner.set_owner(state, of, arg)
    }
    if cmd == fowner.F_GETOWN {
        return fowner.get_owner(state, of)
    }
    if cmd == fowner.F_SETOWN_EX {
        return fowner.set_owner_ex(state, me, of, arg)
    }
    if cmd == fowner.F_GETOWN_EX {
        return fowner.get_owner_ex(state, me, of, arg)
    }
    if cmd == fowner.F_SETSIG || cmd == fowner.F_GETSIG {
        return 0
    }
    if cmd == F_GETPIPE_SZ || cmd == F_SETPIPE_SZ {
        return pipe_size(state, of, cmd, arg)
    }
    if cmd == F_ADD_SEALS {
        if file.open_kind(state, of) != file.K_SHM {
            return sysuser.neg(errno.E_INVAL)
        }
        let i: u64 = file.open_ino(state, of)
        if (unixsock.shm_seals(state, i) & F_SEAL_SEAL) != 0 {
            return sysuser.neg(errno.E_PERM)
        }
        // K-07: F_SEAL_WRITE is refused (-EBUSY) while a writable mapping exists, and later writable mappings are refused (`map_shm`)
        let sr: u64 = unixsock.shm_add_seals(state, i, arg)
        if sr != 0 {
            return sysuser.neg(sr)
        }
        return 0
    }
    if cmd == F_GET_SEALS {
        if file.open_kind(state, of) != file.K_SHM {
            return sysuser.neg(errno.E_INVAL)
        }
        return unixsock.shm_seals(state, file.open_ino(state, of))
    }
    return sysuser.neg(errno.E_INVAL)
}

fn pipe_size(state: u64, of: u64, cmd: u64, arg: u64) -> u64 {
    let kind: u64 = file.open_kind(state, of)
    if kind != file.K_PIPER && kind != file.K_PIPEW {
        return sysuser.neg(errno.E_BADF)
    }
    let cap: u64 = file.pipe_cap(file.open_ino(state, of))
    if cmd == F_SETPIPE_SZ && arg > cap {
        return sysuser.neg(errno.E_PERM)
    }
    return cap
}

const F_ADD_SEALS: u64 = 1033
const F_GET_SEALS: u64 = 1034
const F_SEAL_SEAL: u64 = 1
