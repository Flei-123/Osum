const CLONE_VM: u64 = 0x100
const CLONE_FILES: u64 = 0x400
const CLONE_THREAD: u64 = 0x10000
const CLONE_SETTLS: u64 = 0x80000
const CLONE_PARENT_SETTID: u64 = 0x100000
const CLONE_CHILD_CLEARTID: u64 = 0x200000
const ARCH_SET_FS: u64 = 0x1002
const ARCH_GET_FS: u64 = 0x1003
const ARCH_SET_GS: u64 = 0x1001
const ARCH_GET_GS: u64 = 0x1004
const EXECAS_PRIV: u64 = 1

const MS_WALKS: u64 = 0
const MS_WALKDENY: u64 = 1
const MS_GRPHITS: u64 = 2
const MS_SUPPSET: u64 = 3
const MS_NODECHK: u64 = 4

const RB_POWEROFF: u64 = 0x4321FEDC
const RB_HALT: u64 = 0xCDEF0123
const RB_RESTART: u64 = 0x01234567
// K-004: Osum's own command -- suspend to RAM (ACPI S3) and come back.
// Linux has no reboot() command for this (it goes through
// /sys/power/state); the number is ours and spells S3 twice.
const RB_SUSPEND: u64 = 0x53335333
const UI_COUNT: u64 = 18
const F_RFLAGS: u64 = 112
const F_RSP: u64 = 120
const F_BYTES: u64 = 128

const WNOHANG: u64 = 1
const WUNTRACED: u64 = 2
const MAX_ARG: u64 = 448

const UTS_FIELD: u64 = 65
const UTS_BYTES: u64 = 390

fn uts_set(buffer: u64, field: u64, text: u64, length: u64) {
    var i: u64 = 0
    while i < length {
        kstate.set8(buffer + field * UTS_FIELD + i, kstate.get8(text + i) as u8)
        i = i + 1
    }
}

fn do_uname(state: u64, me: u64, aus: u64) -> u64 {
    var s_sys: [u8; 6] = "Linux\0"
    var s_node: [u8; 5] = "osum\0"
    var s_rel: [u8; 7] = "6.1.0\0\0"
    var s_ver: [u8; 5] = "Osum\0"
    var s_mach: [u8; 7] = "x86_64\0"
    var buffer: [u8; 390] = [0; 390]
    let p: u64 = (&buffer[0]) as u64
    var i: u64 = 0
    while i < UTS_BYTES {
        kstate.set8(p + i, 0)
        i = i + 1
    }
    uts_set(p, 0, (&s_sys[0]) as u64, 5)
    uts_set(p, 1, (&s_node[0]) as u64, 4)
    uts_set(p, 2, (&s_rel[0]) as u64, 5)
    uts_set(p, 3, (&s_ver[0]) as u64, 4)
    uts_set(p, 4, (&s_mach[0]) as u64, 6)
    if !sysuser.copy_out(state, me, aus, p, UTS_BYTES) {
        return sysuser.neg(errno.E_FAULT)
    }
    return 0
}

// RUNDE LC1: the process name (comm) -- 15 characters in T_COMMA (0..7) and T_COMMB (8..14); `buf` is a kernel buffer of >= 16 octets.
fn comm_store(state: u64, t: u64, buf: u64) {
    var a: u64 = 0
    var b: u64 = 0
    var i: u64 = 0
    while i < 8 {
        a = a | (kstate.get8(buf + i) << (i * 8))
        i = i + 1
    }
    i = 0
    while i < 7 {
        b = b | (kstate.get8(buf + 8 + i) << (i * 8))
        i = i + 1
    }
    sched.tset(state, t, sched.T_COMMA, a)
    sched.tset(state, t, sched.T_COMMB, b)
}

fn comm_load(state: u64, t: u64, buf: u64) {
    let a: u64 = sched.tget(state, t, sched.T_COMMA)
    let b: u64 = sched.tget(state, t, sched.T_COMMB)
    var i: u64 = 0
    while i < 8 {
        kstate.set8(buf + i, ((a >> (i * 8)) & 255) as u8)
        i = i + 1
    }
    i = 0
    while i < 7 {
        kstate.set8(buf + 8 + i, ((b >> (i * 8)) & 255) as u8)
        i = i + 1
    }
    kstate.set8(buf + 15, 0 as u8)
}

fn comm_inherit(state: u64, from: u64, to: u64) {
    sched.tset(state, to, sched.T_COMMA, sched.tget(state, from, sched.T_COMMA))
    sched.tset(state, to, sched.T_COMMB, sched.tget(state, from, sched.T_COMMB))
}

// exec: comm = the last component of the path, cut to 15 characters (what Linux does)
fn comm_from_path(state: u64, t: u64, path: u64) {
    var start: u64 = 0
    var i: u64 = 0
    while kstate.get8(path + i) != 0 {
        if kstate.get8(path + i) == 47 {
            start = i + 1
        }
        i = i + 1
    }
    var nb: [u8; 17] = [0 as u8; 17]
    let np: u64 = (&nb[0]) as u64
    var k: u64 = 0
    while k < 15 && kstate.get8(path + start + k) != 0 {
        kstate.set8(np + k, kstate.get8(path + start + k) as u8)
        k = k + 1
    }
    comm_store(state, t, np)
}

const PR_SET_NAME: u64 = 15
const PR_GET_NAME: u64 = 16
const PR_GET_DUMPABLE: u64 = 3
const PR_SET_DUMPABLE: u64 = 4

fn do_prctl(state: u64, me: u64, was: u64, arg: u64) -> u64 {
    if was == svcwatch.PR_WATCH {
        return svcwatch.watch(state, me, arg)
    }
    if was == svcwatch.PR_FAULT {
        return svcwatch.fault(state, me, arg)
    }
    if was == fszap.PR_ZAP {
        let e: u64 = fszap.zap(state, me, arg)
        if e != 0 {
            return sysuser.neg(e)
        }
        return fszap.PR_ZAP
    }
    if was == PR_SET_NAME {
        var nb: [u8; 17] = [0 as u8; 17]
        let np: u64 = (&nb[0]) as u64
        var k: u64 = 0
        var more: bool = true
        while k < 15 && more {
            if !proc.user_ok(state, me, arg + k, 1) {
                return sysuser.neg(errno.E_FAULT)
            }
            let c: u64 = sysuser.peek(state, me, arg + k)
            if c == 0 {
                more = false
            } else {
                kstate.set8(np + k, c as u8)
                k = k + 1
            }
        }
        comm_store(state, me, np)
        return 0
    }
    if was == PR_GET_NAME {
        var gb: [u8; 17] = [0 as u8; 17]
        let gp: u64 = (&gb[0]) as u64
        comm_load(state, me, gp)
        if !sysuser.copy_out(state, me, arg, gp, 16) {
            return sysuser.neg(errno.E_FAULT)
        }
        return 0
    }
    if was == PR_GET_DUMPABLE {
        return 0
    }
    if was == PR_SET_DUMPABLE {
        return 0
    }
    // RUNDE UNTERBAU: the options a sandboxing, threading program sets at start-up and ignores the failure of anyway -- accepted
    // where the request is a no-op on this kernel (there is no setuid exec to gain privileges with, no core dump, no timer slack,
    // no subreaper bookkeeping, no parent-death signal: PR_SET_PDEATHSIG is accepted WITHOUT effect, written down in
    // docs/RUNDE-UNTERBAU-FIREFOX.md). The questions answer what is true: no seccomp filter (0), no_new_privs 1.
    if was == 1 || was == 29 || was == 36 || was == 38 {
        return 0
    }
    if was == 21 {
        return 0
    }
    if was == 39 {
        return 1
    }
    return sysuser.neg(errno.E_INVAL)
}

fn do_waitid(state: u64, me: u64, idtype: u64, id: u64, info: u64, options: u64) -> u64 {
    if (options & 4) == 0 {
        return sysuser.neg(errno.E_INVAL)
    }
    if info != 0 && !proc.user_ok(state, me, info, 128) {
        return sysuser.neg(errno.E_FAULT)
    }
    var want: u64 = 0
    if idtype == 1 {
        want = id
    }
    var child: u64 = find_zombie_child(state, me, want)
    var nowait_rounds: u64 = 0
    while child >= kstate.MAX_TASKS && (options & 0x1000000) != 0 && (options & 1) == 0 && nowait_rounds < 100000 && find_child(state, me, want) < kstate.MAX_TASKS {
        sched.wait_sleep(state, want, 0)
        nowait_rounds = nowait_rounds + 1
        child = find_zombie_child(state, me, want)
    }
    if child >= kstate.MAX_TASKS {
        if find_child(state, me, want) >= kstate.MAX_TASKS {
            return sysuser.neg(errno.E_CHILD)
        }
        if info != 0 {
            var z: u64 = 0
            while z < 16 {
                sysuser.put64(state, me, info + z * 8, 0)
                z = z + 1
            }
        }
        if (options & 1) != 0 {
            return 0
        }
        if info == 0 || (options & 0x1000000) != 0 {
            return sysuser.neg(errno.E_INVAL)
        }
        var anyw: u64 = want
        if want == 0 {
            anyw = 0 -% 1
        }
        let w: u64 = do_wait4(state, me, anyw, info + 96, 0)
        if (w >> 63) != 0 {
            return w
        }
        let st: u64 = sysuser.get32(state, me, info + 96)
        sysuser.put32(state, me, info + 96, 0)
        sysuser.put32(state, me, info, 17)
        if (st & 127) != 0 {
            sysuser.put32(state, me, info + 8, 2)
            sysuser.put32(state, me, info + 24, st & 127)
        } else {
            sysuser.put32(state, me, info + 8, 1)
            sysuser.put32(state, me, info + 24, (st >> 8) & 255)
        }
        sysuser.put32(state, me, info + 16, w)
        return 0
    }
    if info != 0 {
        let code: u64 = sched.tget(state, child, sched.T_EXIT)
        let sl: u64 = sched.tget(state, child, sched.T_SIGLAST)
        var z2: u64 = 0
        while z2 < 16 {
            sysuser.put64(state, me, info + z2 * 8, 0)
            z2 = z2 + 1
        }
        sysuser.put32(state, me, info, 17)
        if (sl & 256) != 0 {
            sysuser.put32(state, me, info + 8, 2)
            sysuser.put32(state, me, info + 24, sl & 127)
        } else {
            sysuser.put32(state, me, info + 8, 1)
            sysuser.put32(state, me, info + 24, code & 255)
        }
        sysuser.put32(state, me, info + 16, sched.tget(state, child, sched.T_PID))
    }
    if (options & 0x1000000) == 0 {
        proc.reap(state, child)
    }
    return 0
}

fn do_arch_prctl(state: u64, me: u64, code: u64, addr: u64) -> u64 {
    if code == ARCH_SET_FS {
        if (addr >> 47) != 0 {
            return sysuser.neg(errno.E_INVAL)
        }
        sched.tset(state, me, sched.T_FSBASE, addr)
        sched.fsbase_apply(state, me)
        return 0
    }
    if code == ARCH_GET_FS {
        if !proc.user_ok(state, me, addr, 8) {
            return sysuser.neg(errno.E_FAULT)
        }
        sysuser.put64(state, me, addr, sched.tget(state, me, sched.T_FSBASE))
        return 0
    }
    if code == ARCH_SET_GS {
        if (addr >> 47) != 0 {
            return sysuser.neg(errno.E_INVAL)
        }
        sched.tset(state, me, sched.T_GSBASE, addr)
        sched.fsbase_apply(state, me)
        return 0
    }
    if code == ARCH_GET_GS {
        if !proc.user_ok(state, me, addr, 8) {
            return sysuser.neg(errno.E_FAULT)
        }
        sysuser.put64(state, me, addr, sched.tget(state, me, sched.T_GSBASE))
        return 0
    }
    return sysuser.neg(errno.E_INVAL)
}

// ------------------------------------------------------------ the clock

// `nanosleep(request, remainder)`, and the request is a `struct timespec`:
// eight octets of seconds, eight of nanoseconds. The timer runs at 100 Hz,
// so ten milliseconds are the grain -- anything shorter is a yield.
const MAX_SLEEP_SEC: u64 = 4294967296

const FINE_SLEEP_ROUNDS: u64 = 4096

fn sleep_until_fine(state: u64, me: u64, fine: u64) -> u64 {
    var rounds: u64 = 0
    while rounds < FINE_SLEEP_ROUNDS {
        if signal.interrupted(state, me) {
            return sysuser.neg(errno.E_INTR)
        }
        if hrt.expired(state, 0, fine) {
            return 0
        }
        sched.sleep_fine(state, fine)
        rounds = rounds + 1
    }
    return 0
}

fn do_nanosleep(state: u64, me: u64, req: u64) -> u64 {
    if !proc.user_ok(state, me, req, 16) {
        return sysuser.neg(errno.E_FAULT)
    }
    let sec: u64 = sysuser.user_word(state, me, req)
    let nsec: u64 = sysuser.user_word(state, me, req + 8)
    if nsec >= 1000000000 {
        return sysuser.neg(errno.E_INVAL)
    }
    if (sec >> 63) != 0 {
        return sysuser.neg(errno.E_INVAL)
    }
    if sec == 0 && nsec != 0 {
        let fine: u64 = hrt.deadline_after(state, nsec)
        if fine != 0 {
            return sleep_until_fine(state, me, fine)
        }
    }
    var capped: u64 = sec
    if capped > MAX_SLEEP_SEC {
        capped = MAX_SLEEP_SEC
    }
    var ticks: u64 = capped * 100 + (nsec + 9999999) / 10000000
    // RUNDE UNTERBAU: ONE TICK MORE, as `poll` does it. The counter stands in the middle of the running tick when the call reads it, so a
    // sleep of N ticks lasted between N-1 and N ticks: `usleep(30000)` measured 24.7 ms (t_misc `monotonic_advances_with_sleep`), and a sleep
    // must never return EARLY (POSIX). A request of zero stays zero.
    if ticks != 0 {
        ticks = ticks + 1
    }
    let t0: u64 = kstate.get(state, kstate.TICKS)
    var spin_left: u64 = ticks + 8
    while spin_left > 0 {
        if signal.interrupted(state, me) {
            return sysuser.neg(errno.E_INTR)
        }
        let now: u64 = kstate.get(state, kstate.TICKS)
        if now < t0 || now - t0 >= ticks {
            break
        }
        sched.sleep_ticks(state, ticks - (now - t0))
        spin_left = spin_left - 1
    }
    return 0
}

fn do_clock_settime(state: u64, me: u64, clk: u64, tp: u64) -> u64 {
    if clk != time.CLOCK_REALTIME {
        return sysuser.neg(errno.E_INVAL)
    }
    if !perm.is_root(state, me) {
        return sysuser.neg(errno.E_PERM)
    }
    if !proc.user_ok(state, me, tp, 16) {
        return sysuser.neg(errno.E_FAULT)
    }
    let sec: u64 = sysuser.user_word(state, me, tp)
    let nsec: u64 = sysuser.user_word(state, me, tp + 8)
    if nsec >= 1000000000 {
        return sysuser.neg(errno.E_INVAL)
    }
    if !time.set_utc_ns(state, sec, nsec) {
        return sysuser.neg(errno.E_INVAL)
    }
    let _w: bool = time.rtc_write(state)
    return 0
}

const NS_PER_USEC: u64 = 1000

// adjtimex(2), the part adjtime(3) needs: ADJ_OFFSET_SINGLESHOT slews the
// clock by `offset` microseconds (root only); mode 0 only reads. The rest of
// the structure is left alone.
fn do_adjtimex(state: u64, me: u64, tx: u64) -> u64 {
    if !proc.user_ok(state, me, tx, clockabi.TIMEX_BYTES) {
        return sysuser.neg(errno.E_FAULT)
    }
    let modes: u64 = sysuser.user_word32(state, me, tx + clockabi.TIMEX_MODES)
    if modes != 0 {
        if !perm.is_root(state, me) {
            return sysuser.neg(errno.E_PERM)
        }
        if modes != clockabi.ADJ_OFFSET_SINGLESHOT {
            return sysuser.neg(errno.E_INVAL)
        }
        let offset_us: u64 = sysuser.user_word(state, me, tx + clockabi.TIMEX_OFFSET)
        if !time.slew_by(state, offset_us *% NS_PER_USEC) {
            return sysuser.neg(errno.E_INVAL)
        }
    }
    let left_ns: u64 = time.slew_remaining(state)
    var left_us: u64 = left_ns / NS_PER_USEC
    if left_ns > 0x7FFFFFFFFFFFFFFF {
        left_us = 0 -% ((0 -% left_ns) / NS_PER_USEC)
    }
    let now_ns: u64 = time.real_ns(state)
    if !sysuser.put64(state, me, tx + clockabi.TIMEX_OFFSET, left_us)
        || !sysuser.put64(state, me, tx + clockabi.TIMEX_TIME_SEC, now_ns / time.NS_PER_SEC)
        || !sysuser.put64(state, me, tx + clockabi.TIMEX_TIME_USEC, (now_ns % time.NS_PER_SEC) / NS_PER_USEC) {
        return sysuser.neg(errno.E_FAULT)
    }
    if clockstate.state_of(state) == clockstate.CS_SET {
        return 0
    }
    return clockabi.TIME_ERROR
}

// DAILY-DRIVER: the zone as the display shows it. (standard offset in
// minutes, rule 0 = fixed / 1 = EU summer time). Any program may ask --
// it changes how the clock is SHOWN, never the time itself -- like the
// zone choice of the settings window, which runs as the user.
fn do_settz(state: u64, me: u64, minutes: u64, rule: u64) -> u64 {
    // N-004: `rule` = rule id (lib/tz/rules.fi) | (west << 8) | rtc flags;
    // `minutes` is the magnitude of the standard offset
    if minutes > 1440 || (rule & clockabi.SETTZ_RULE_MASK) > rules.RULE_MAX || rule > clockabi.SETTZ_ARG_MAX {
        return sysuser.neg(errno.E_INVAL)
    }
    time.set_tz(state, minutes)
    time.set_tz_rule(state, rule & (clockabi.SETTZ_RULE_MASK | clockabi.SETTZ_WEST_BIT))
    if (rule & clockabi.SETTZ_RTC_SET_BIT) != 0 {
        time.set_rtc_utc(state, (rule & clockabi.SETTZ_RTC_UTC_BIT) / clockabi.SETTZ_RTC_UTC_BIT)
    }
    // r544: a boot line without `tz=` leaves the hardware clock unconverted;
    // the first zone that arrives (sntp boot from /etc/time.conf) does it,
    // once, as long as nobody has set the clock
    time.tz_anwenden(state)
    return 0
}

fn do_clock_gettime(state: u64, me: u64, clk_arg: u64, tp: u64) -> u64 {
    var clk: u64 = clk_arg
    if clk == clockabi.CLOCK_CHECKED {
        if !clockstate.trusted(state) {
            return sysuser.neg(errno.E_NODATA)
        }
        clk = time.CLOCK_REALTIME
    }
    if clk > time.CLOCK_MAX {
        return sysuser.neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, tp, 16) {
        return sysuser.neg(errno.E_FAULT)
    }
    kstate.add(state, kstate.TIME_CALLS, 1)
    var ns: u64 = 0
    if clk == time.CLOCK_REALTIME || clk == time.CLOCK_REALTIME_COARSE {
        ns = time.real_ns(state)
    } else {
        ns = time.mono_ns(state)
    }
    if !sysuser.put64(state, me, tp, ns / time.NS_PER_SEC) {
        return sysuser.neg(errno.E_FAULT)
    }
    if !sysuser.put64(state, me, tp + 8, ns % time.NS_PER_SEC) {
        return sysuser.neg(errno.E_FAULT)
    }
    return 0
}

fn do_clock_getres(state: u64, me: u64, clk: u64, tp: u64) -> u64 {
    if clk > time.CLOCK_MAX {
        return sysuser.neg(errno.E_INVAL)
    }
    if tp == 0 {
        return 0
    }
    if !proc.user_ok(state, me, tp, 16) {
        return sysuser.neg(errno.E_FAULT)
    }
    var res: u64 = time.TICK_NS
    if time.khz(state) != 0 {
        res = 1
    }
    sysuser.put64(state, me, tp, 0)
    sysuser.put64(state, me, tp + 8, res)
    return 0
}

fn do_gettimeofday(state: u64, me: u64, tv: u64) -> u64 {
    if tv == 0 {
        return 0
    }
    if !proc.user_ok(state, me, tv, 16) {
        return sysuser.neg(errno.E_FAULT)
    }
    let ns: u64 = time.real_ns(state)
    sysuser.put64(state, me, tv, ns / time.NS_PER_SEC)
    sysuser.put64(state, me, tv + 8, (ns % time.NS_PER_SEC) / 1000)
    return 0
}

fn do_time(state: u64, me: u64, out: u64) -> u64 {
    let secs: u64 = time.now_sec(state)
    if out != 0 {
        if !proc.user_ok(state, me, out, 8) {
            return sysuser.neg(errno.E_FAULT)
        }
        sysuser.put64(state, me, out, secs)
    }
    return secs
}

const GRND_NONBLOCK: u64 = 1
const GRND_INSECURE: u64 = 4
const GRND_KNOWN: u64 = 7

fn do_getrandom(state: u64, me: u64, buf: u64, want: u64, flags: u64) -> u64 {
    if (flags & GRND_KNOWN) != flags {
        return sysuser.neg(errno.E_INVAL)
    }
    var len: u64 = want
    if len > sysconst.MAX_IO {
        len = sysconst.MAX_IO
    }
    if !proc.user_ok(state, me, buf, len) {
        return sysuser.neg(errno.E_FAULT)
    }
    if len == 0 {
        return 0
    }
    if !randwait.wait_ready(state, (flags & (GRND_NONBLOCK | GRND_INSECURE)) != 0) {
        return sysuser.neg(errno.E_AGAIN)
    }
    let bounce: u64 = sysuser.blockb(state)
    if rand.bytes(state, bounce, len) != len {
        return sysuser.neg(errno.E_AGAIN)
    }
    if !sysuser.copy_out(state, me, buf, bounce, len) {
        return sysuser.neg(errno.E_FAULT)
    }
    return len
}

const SI_PENDING: u64 = 0
const SI_MASK: u64 = 1
const SI_LAST: u64 = 2
const SI_DELIVERED: u64 = 3
const SI_SENT: u64 = 4
const SI_CAUGHT: u64 = 5
const SI_DEFAULT: u64 = 6
const SI_STOPS: u64 = 7
const SI_MYCOUNT: u64 = 8
const SI_STOPPED: u64 = 9
const SI_TTYSIGS: u64 = 10
const SI_STATE_OF: u64 = 20
const SI_TICKS_OF: u64 = 21
const SI_PEND_OF: u64 = 22

fn do_siginfo(state: u64, me: u64, what: u64, arg: u64) -> u64 {
    if what >= SI_STATE_OF {
        let i: u64 = sched.find_pid(state, arg)
        if i >= kstate.MAX_TASKS {
            return sysuser.neg(errno.E_SRCH)
        }
        if what == SI_STATE_OF {
            return sched.tget(state, i, sched.T_STATE)
        }
        if what == SI_TICKS_OF {
            return sched.tget(state, i, sched.T_TICKS)
        }
        if what == SI_PEND_OF {
            return sched.tget(state, i, sched.T_SIGPEND)
        }
        return sysuser.neg(errno.E_INVAL)
    }
    if what == SI_PENDING {
        return sched.tget(state, me, sched.T_SIGPEND)
    }
    if what == SI_MASK {
        return sched.tget(state, me, sched.T_SIGMASK)
    }
    if what == SI_LAST {
        return sched.tget(state, me, sched.T_SIGLAST)
    }
    if what == SI_DELIVERED {
        return kstate.get(state, kstate.SIG_DELIVERED)
    }
    if what == SI_SENT {
        return kstate.get(state, kstate.SIG_SENT)
    }
    if what == SI_CAUGHT {
        return kstate.get(state, kstate.SIG_CAUGHT)
    }
    if what == SI_DEFAULT {
        return kstate.get(state, kstate.SIG_DEFAULT)
    }
    if what == SI_STOPS {
        return kstate.get(state, kstate.SIG_STOPS)
    }
    if what == SI_MYCOUNT {
        return sched.tget(state, me, sched.T_SIGDEL)
    }
    if what == SI_STOPPED {
        return signal.stopped_count(state)
    }
    if what == SI_TTYSIGS {
        return kstate.get(state, kstate.TTY_SIGS)
    }
    return sysuser.neg(errno.E_INVAL)
}

// ------------------------------------------------------ processes

fn do_getppid(state: u64, me: u64) -> u64 {
    let p: u64 = sched.tget(state, me, sched.T_PARENT)
    return sched.tget(state, p, sched.T_PID)
}

fn do_clone(state: u64, me: u64, frame: u64, flags: u64, stack_top: u64,
    ptid: u64, ctid: u64, tls: u64) -> u64 {
    if sched.tget(state, me, sched.T_KIND) != sched.K_USER {
        return sysuser.neg(errno.E_NOSYS)
    }
    if (flags & CLONE_VM) == 0 || (flags & CLONE_THREAD) == 0 {
        return do_fork(state, me, frame, stack_top)
    }
    if stack_top == 0 {
        return sysuser.neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, stack_top - 8, 8) {
        return sysuser.neg(errno.E_FAULT)
    }
    // RUNDE UNTERBAU: THE FINISHED THREADS OF THIS PROCESS GO FIRST. A thread that ended stayed a corpse in the task table until
    // somebody called wait4 for it -- and nobody does, `pthread_join` waits on a futex word, not on wait4. The table has 32 slots,
    // so after about thirty threads over a process's life `pthread_create` failed with EAGAIN for good (measured: tools/unterbau,
    // t_threads `churn_64_threads`). Linux frees a non-leader thread by itself; here the next `clone` of the group does it.
    sysmem.reap_dead_threads(state, me)
    let irq: u64 = sched.irq_save()
    let faden: u64 = proc.create_thread(state, me,
        sched.tget(state, me, sched.T_PRIO))
    if faden == 0 {
        sched.irq_restore(irq)
        return sysuser.neg(errno.E_AGAIN)
    }
    if (flags & CLONE_FILES) != 0 {
        // LC-001: the thread USES the table of its group (and its close-on-exec marks) instead of a copy
        file.share_table(state, me, faden)
    } else {
        file.inherit_task(state, me, faden)
        sysfd.cx_copy(state, me, faden)
    }
    sched.fpu_inherit(state, me, faden)
    signal.inherit(state, me, faden)
    sched.tset(state, faden, sched.T_CWD,
        sched.tget(state, me, sched.T_CWD))
    uio.adopt(state, me, faden)
    sched.tset(state, faden, sched.T_BRK, sysmem.brk_of(state, me))
    sched.tset(state, faden, sched.T_MMAP, sysmem.map_bottom(state, me))
    sched.tset(state, faden, sched.T_BIG, sched.tget(state, sysmem.mem_owner(state, me), sched.T_BIG))
    sched.tset(state, faden, sched.T_USTACK, stack_top)
    netview.inherit(state, me, faden)
    ctr.inherit(state, me, faden)
    // AB-003: a thread is its process -- same origin.
    origin.inherit(state, me, faden)
    comm_inherit(state, me, faden)
    uio.exe_copy(state, me, faden)
    if (flags & CLONE_THREAD) != 0 {
        sched.tset(state, faden, sched.T_TGID,
            sched.tget(state, me, sched.T_TGID))
    }
    sched.tset(state, faden, sched.T_GSBASE, sched.tget(state, me, sched.T_GSBASE))
    if (flags & CLONE_SETTLS) != 0 {
        sched.tset(state, faden, sched.T_FSBASE, tls)
    }
    let new_tid: u64 = sched.tget(state, faden, sched.T_PID)
    if (flags & CLONE_PARENT_SETTID) != 0 {
        if proc.user_ok(state, me, ptid, 8) {
            sysuser.put64(state, me, ptid, new_tid)
        }
    }
    if (flags & CLONE_CHILD_CLEARTID) != 0 {
        if proc.user_ok(state, me, ctid, 4) {
            sched.tset(state, faden, sched.T_FUTEX, ctid)
        }
    }
    let ctx: u64 = state + kstate.CTX_OFF + faden * F_BYTES
    var i: u64 = 0
    while i < F_BYTES / 8 {
        __mmio_write64((ctx + i * 8) as *mut u64,
            __mmio_read64((frame + i * 8) as *mut u64))
        i = i + 1
    }
    __mmio_write64((ctx + sysconst.F_RAX) as *mut u64, 0)
    __mmio_write64((ctx + F_RSP) as *mut u64, stack_top)
    sched.tset(state, faden, sched.T_ARG, proc.ARG_RESUME)
    kstate.add(state, kstate.SPAWNS, 1)
    sched.start(state, faden)
    sched.irq_restore(irq)
    return new_tid
}

fn do_fork(state: u64, me: u64, frame: u64, stack_top: u64) -> u64 {
    if sched.tget(state, me, sched.T_KIND) != sched.K_USER {
        return sysuser.neg(errno.E_NOSYS)
    }
    // RUNDE UNTERBAU: the corpses of finished threads of this process leave first (a task slot is a task slot)
    sysmem.reap_dead_threads(state, me)
    let flags: u64 = sched.irq_save()
    let child: u64 = proc.create_bare(state, sched.tget(state, me,
            sched.T_PRIO))
    if child == 0 {
        sched.irq_restore(flags)
        return sysuser.neg(errno.E_AGAIN)
    }
    if proc.copy_space(state, me, child) == 0 {
        proc.discard(state, child)
        sched.irq_restore(flags)
        return sysuser.neg(errno.E_NOMEM)
    }
    file.inherit_task(state, me, child)
    sysfd.cx_copy(state, me, child)
    sched.fpu_inherit(state, me, child)
    signal.inherit(state, me, child)
    sched.tset(state, child, sched.T_CWD, sched.tget(state, me, sched.T_CWD))
    // ROUND K6: and the working directory as TEXT, which is what `getcwd`
    // prints and what a relative path is completed with.
    uio.adopt(state, me, child)
    sched.tset(state, child, sched.T_BRK, sysmem.brk_of(state, me))
    sched.tset(state, child, sched.T_MMAP, sysmem.map_bottom(state, me))
    sched.tset(state, child, sched.T_BIG, sched.tget(state, sysmem.mem_owner(state, me), sched.T_BIG))
    sched.tset(state, child, sched.T_LAZY, sched.tget(state, sysmem.mem_owner(state, me), sched.T_LAZY))
    netview.inherit(state, me, child)
    ctr.inherit(state, me, child)
    // AB-003: the origin is sticky -- a fork cannot shed it.
    origin.inherit(state, me, child)
    comm_inherit(state, me, child)
    uio.exe_copy(state, me, child)
    sched.tset(state, child, sched.T_USTACK, sched.tget(state, me, sched.T_USTACK))
    sched.tset(state, child, sched.T_FSBASE,
        sched.tget(state, me, sched.T_FSBASE))
    sched.tset(state, child, sched.T_GSBASE,
        sched.tget(state, me, sched.T_GSBASE))
    // The context the child comes back on. `proc.resume_start` hands this
    // copy to `user_resume` in isr.s.
    let ctx: u64 = state + kstate.CTX_OFF + child * F_BYTES
    var i: u64 = 0
    while i < F_BYTES / 8 {
        __mmio_write64((ctx + i * 8) as *mut u64,
            __mmio_read64((frame + i * 8) as *mut u64))
        i = i + 1
    }
    __mmio_write64((ctx + sysconst.F_RAX) as *mut u64, 0)
    if stack_top != 0 {
        __mmio_write64((ctx + F_RSP) as *mut u64, stack_top)
    }
    sched.tset(state, child, sched.T_ARG, proc.ARG_RESUME)
    kstate.add(state, kstate.SPAWNS, 1)
    kstate.add(state, kstate.FORKS, 1)
    sched.start(state, child)
    sched.irq_restore(flags)
    return sched.tget(state, child, sched.T_PID)
}

// `execve(path, argv, envp)` -- the caller BECOMES the program. The
// environment is read and dropped: Osum has none yet, and a program that
// hands one over is not refused for it (docs/ROUNDK4.md).
//
// How the image gets in without a copy-on-write page fault handler: the
// loader builds a WHOLE NEW process for the file, the two swap address
// spaces, and the empty shell of the loader's process is discarded --
// which frees exactly the old image. Nothing else in the task changes:
// same pid, same parent, same descriptors, and that is what `execve`
// promises.
fn do_execve(state: u64, me: u64, frame: u64, path: u64, argv: u64, envp: u64) -> u64 {
    signal.exec_reset(state, me)
    sched.fpu_reset(state, me)
    if kstate.get(state, kstate.FS_READY) == 0 {
        return sysuser.neg(errno.E_NOSYS)
    }
    if sched.tget(state, me, sched.T_KIND) != sched.K_USER {
        return sysuser.neg(errno.E_NOSYS)
    }
    let name: u64 = sysuser.nameb(state)
    let len: u64 = sysuser.fetch_path(state, me, path, name, sysconst.MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if len == 0 {
        return sysuser.neg(errno.E_NOENT)
    }
    let abuf: u64 = cpu.earg_buf(state)
    var at: u64 = 0
    var argc: u64 = 0
    if argv != 0 {
        var going: bool = true
        while going {
            // the terminating 0 may sit in slot MAX_ARGS: eight words
            // plus the end mark, not seven (a NULL-terminated argv)
            if argc > proc.MAX_ARGS {
                return sysuser.neg(errno.E_2BIG)
            }
            if !proc.user_ok(state, me, argv + argc * 8, 8) {
                return sysuser.neg(errno.E_FAULT)
            }
            let p: u64 = sysuser.user_word(state, me, argv + argc * 8)
            if p == 0 {
                going = false
            } else {
                if argc >= proc.MAX_ARGS {
                    return sysuser.neg(errno.E_2BIG)
                }
                if at + MAX_ARG + 1 > kstate.EARG_MAX {
                    return sysuser.neg(errno.E_2BIG)
                }
                let n: u64 = sysuser.fetch_name(state, me, p, abuf + at, MAX_ARG)
                if errno.is_error(n) {
                    return n
                }
                at = at + n + 1
                argc = argc + 1
            }
        }
    }
    // RUNDE UNTERBAU: THE ENVIRONMENT OF `execve`. The kernel holds ONE environment block (a shell fills it with SYS_OSUM_SETENV, every
    // program started afterwards finds it on its argument page) and `execve` ignored its third argument: a child started with
    // `execve(path, argv, envp)` never saw `envp` (measured: t_proc `exec_args_env_stdout`, WAYLAND_DISPLAY and XDG_RUNTIME_DIR would
    // not reach a child either). Now the block is replaced by `envp` for the one program start and put back afterwards. Limits are those
    // of the argument page: 16 strings, ENV_MAX octets together; the rest of `envp` is dropped.
    var env_saved: u64 = 0
    var old_n: u64 = 0
    var old_len: u64 = 0
    if envp != 0 {
        env_saved = mmheap.kalloc(state, kstate.ENV_MAX + 16)
        if env_saved != 0 {
            let blk: u64 = state + kstate.K11_OFF + kstate.ENV_BUF
            old_n = kstate.get(state, kstate.K11_OFF + kstate.ENV_N)
            old_len = kstate.get(state, kstate.K11_OFF + kstate.ENV_LEN)
            var ci: u64 = 0
            while ci < old_len && ci < kstate.ENV_MAX {
                kstate.set8(env_saved + ci, kstate.get8(blk + ci) as u8)
                ci = ci + 1
            }
            var eat: u64 = 0
            var ecnt: u64 = 0
            var egoing: bool = true
            while egoing && ecnt < elf.STACK_ENV_MAXN {
                if !proc.user_ok(state, me, envp + ecnt * 8, 8) {
                    egoing = false
                } else {
                    let ep: u64 = sysuser.user_word(state, me, envp + ecnt * 8)
                    if ep == 0 || eat + MAX_ARG + 1 > kstate.ENV_MAX {
                        egoing = false
                    } else {
                        let en: u64 = sysuser.fetch_name(state, me, ep, blk + eat, MAX_ARG)
                        if errno.is_error(en) {
                            egoing = false
                        } else {
                            eat = eat + en + 1
                            ecnt = ecnt + 1
                        }
                    }
                }
            }
            kstate.set(state, kstate.K11_OFF + kstate.ENV_N, ecnt)
            kstate.set(state, kstate.K11_OFF + kstate.ENV_LEN, eat)
        }
    }
    let flags: u64 = sched.irq_save()
    // r334: one program start at a time on the whole machine.
    let lk: u64 = elf.lock_enter(state)
    let t: u64 = elf.build(state, name, abuf, argc, sched.tget(state, me,
            sched.T_PRIO))
    elf.lock_leave(state, lk)
    if env_saved != 0 {
        // the new image has copied the block onto its argument page: the old block goes back
        let blk2: u64 = state + kstate.K11_OFF + kstate.ENV_BUF
        var cj: u64 = 0
        while cj < old_len && cj < kstate.ENV_MAX {
            kstate.set8(blk2 + cj, kstate.get8(env_saved + cj) as u8)
            cj = cj + 1
        }
        kstate.set(state, kstate.K11_OFF + kstate.ENV_N, old_n)
        kstate.set(state, kstate.K11_OFF + kstate.ENV_LEN, old_len)
        mmheap.kfree(state, env_saved)
    }
    if t == 0 {
        sched.irq_restore(flags)
        let why: u64 = kstate.get(state, kstate.ELF_ERR)
        return sysuser.neg(elf.errno_of(why))
    }
    let entry: u64 = sched.tget(state, t, sched.T_ENTRY)
    let ustack: u64 = sched.tget(state, t, sched.T_USTACK)
    let args: u64 = sched.tget(state, t, sched.T_WORK)
    sched.tset(state, me, sched.T_EUID, sched.tget(state, t, sched.T_EUID))
    sched.tset(state, me, sched.T_EGID, sched.tget(state, t, sched.T_EGID))
    sched.tset(state, me, sched.T_SUID, sched.tget(state, t, sched.T_SUID))
    sched.tset(state, me, sched.T_SGID, sched.tget(state, t, sched.T_SGID))
    // AB-003: `elf.build` gave the new image its origin (the caller's
    // label, or `app:<name>` for a program in an app bundle); `execve`
    // is not a new process, so it moves over like the four words above.
    origin.inherit(state, t, me)
    uio.interp_copy(state, t, me)
    sysfd.cx_close_marked(state, me)
    proc.swap_space(state, me, t)
    // The new tables FIRST, then the old ones are freed -- in that order,
    // because the processor is standing in the old ones right now.
    proc.use_space(state, me)
    proc.discard(state, t)
    sched.tset(state, me, sched.T_ENTRY, entry)
    sched.tset(state, me, sched.T_USTACK, ustack)
    sched.tset(state, me, sched.T_FSBASE, 0)
    sched.tset(state, me, sched.T_GSBASE, 0)
    sched.fsbase_apply(state, me)
    sched.tset(state, me, sched.T_BRK, 0)
    sched.tset(state, me, sched.T_MMAP, 0)
    sched.tset(state, me, sched.T_BIG, 0)
    sysmem.res_clear(state, me)
    // What ring 3 finds on the way out: a program at its entry point with
    // the argument block in rdi and nothing else left over from the
    // caller. Everything a process could have hidden in a register is gone
    // -- the image is new, and so is its state.
    var i: u64 = 0
    while i < F_BYTES / 8 {
        __mmio_write64((frame + i * 8) as *mut u64, 0)
        i = i + 1
    }
    regio.write64_at(frame, sysconst.F_RIP, entry)
    regio.write64_at(frame, F_RSP, ustack)
    regio.write64_at(frame, sysconst.F_RDI, args)
    regio.write64_at(frame, F_RFLAGS, 0x202)
    // ROUND POWERMON: the process is a different program from this
    // instruction on. Its power record starts again, and it starts with
    // the new name -- otherwise `sh` would carry away everything the
    // program it exec'd into ever spent, which is the plainest form of
    // the lie this round exists to avoid.
    pmon.task_clear(state, me, sched.tget(state, me, sched.T_PID))
    comm_from_path(state, me, name)
    uio.exe_set(state, me, name)
    pmon.name_set(state, me, name)
    kstate.add(state, kstate.EXECVES, 1)
    // ROUND NETMON: THE SLOT KEPT ITS PID AND CHANGED ITS PROGRAM.
    // Everything the old image used belonged to the old image; carrying
    // it over would tell the person that `sh` downloaded a hundred
    // megabytes because it `exec`ed `wget`.
    netmon.task_clear(state, me, sched.tget(state, me, sched.T_PID))
    netmon.name_set(state, me, name)
    // ROUND A11Y-2: the rights of the accessibility tree fall -- they
    // were given to the program that is gone (the spawn paths drop them
    // in ldr/elf.fi; execve keeps its slot and does not pass there).
    // Measured: before this line the new program still had mine=3.
    ax.drop_perm(state, me)
    sched.irq_restore(flags)
    return 0
}

// `wait4(pid, status, options, rusage)`. The status is the Linux one: the
// exit code sits in bits 8..15, so `WEXITSTATUS` is a shift by eight. What
// comes back is the PID of the child, not its code -- round 62's `wait`
// returned the code, and a caller could not tell -1 from a child that
// exited with 255.
fn do_wait4(state: u64, me: u64, pid: u64, status: u64, options: u64) -> u64 {
    if status != 0 {
        if !proc.user_ok(state, me, status, 4) {
            return sysuser.neg(errno.E_FAULT)
        }
    }
    // -1 means "any child" in Linux; in an unsigned register that is
    // 0xFFFFFFFFFFFFFFFF, and 0 has meant the same thing here since round
    // 62.
    var want: u64 = pid
    if want == (0 -% 1) {
        want = 0
    }
    var rounds: u64 = 0
    while rounds < 100000 {
        if signal.handler_of(state, me, signal.SIGCHLD) == signal.SIG_IGN {
            var zi: u64 = find_zombie_child(state, me, 0)
            var zn: u64 = 0
            while zi < kstate.MAX_TASKS && zn < 64 {
                proc.reap(state, zi)
                zn = zn + 1
                zi = find_zombie_child(state, me, 0)
            }
        }
        var child: u64 = kstate.MAX_TASKS
        if kstate.mode_on(state, kstate.M_WAITOLD) {
            child = find_child(state, me, want)
            if child >= kstate.MAX_TASKS {
                return sysuser.neg(errno.E_CHILD)
            }
        } else {
            child = find_zombie_child(state, me, want)
            if child >= kstate.MAX_TASKS {
                if find_child(state, me, want) >= kstate.MAX_TASKS {
                    return sysuser.neg(errno.E_CHILD)
                }
            }
        }
        if child < kstate.MAX_TASKS
            && sched.tget(state, child, sched.T_STATE) == sched.S_ZOMBIE {
            let code: u64 = sched.tget(state, child, sched.T_EXIT)
            let who: u64 = sched.tget(state, child, sched.T_PID)
            // (the descriptors are closed inside proc.reap, by the caller
            // that wins the claim -- DELL STABILITY)
            proc.reap(state, child)
            if status != 0 {
                // RUNDE UNTERBAU: a task that died of a signal reports it the way POSIX does -- the signal number in the low bits (WIFSIGNALED,
                // WTERMSIG) -- and not as an exit with code 128 + n. Everything else keeps `exit code << 8`.
                // ONLY for the waiter that is a libc program (it has set its thread pointer: T_FSBASE != 0). The programs of this system read
                // `(status >> 8) & 255` and have measured 128 + n there since round 62; for them nothing changes.
                var st: u64 = (code & 255) << 8
                let sl: u64 = sched.tget(state, child, sched.T_SIGLAST)
                if (sl & 256) != 0 && sched.tget(state, me, sched.T_FSBASE) != 0 {
                    st = sl & 127
                }
                if !sysuser.put32(state, me, status, st) {
                    return sysuser.neg(errno.E_FAULT)
                }
            }
            return who
        }
        if (options & WUNTRACED) != 0 {
            let stopped: u64 = sched.stopped_child(state, me, want)
            if stopped < kstate.MAX_TASKS {
                let who: u64 = sched.tget(state, stopped, sched.T_PID)
                let sig: u64 = sched.stop_claim(state, stopped)
                if sig != 0 {
                    if status != 0 {
                        if !sysuser.put32(state, me, status, (sig << 8) | 127) {
                            return sysuser.neg(errno.E_FAULT)
                        }
                    }
                    return who
                }
            }
        }
        if (options & WNOHANG) != 0 {
            return 0
        }
        // State and switch under one lock hold -- see sched.wait_sleep.
        sched.wait_sleep(state, want, options & WUNTRACED)
        rounds = rounds + 1
    }
    return sysuser.neg(errno.E_CHILD)
}

fn find_zombie_child(state: u64, me: u64, pid: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if sched.tget(state, i, sched.T_STATE) == sched.S_ZOMBIE {
            if sched.tget(state, i, sched.T_PARENT) == me {
                if (pid == 0 || sched.tget(state, i, sched.T_PID) == pid) && !sched.group_live(state, i) {
                    return i
                }
            }
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

// The index of a child, or MAX_TASKS. `pid` 0 means: any of them.
fn find_child(state: u64, me: u64, pid: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if sched.tget(state, i, sched.T_STATE) != sched.S_FREE {
            if sched.tget(state, i, sched.T_PARENT) == me {
                if pid == 0 || sched.tget(state, i, sched.T_PID) == pid {
                    return i
                }
            }
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

// ------------------------------------------------- the two Osum calls

const P_BUSB_SPAWN: u64 = 61

fn do_spawn(state: u64, me: u64, prog: u64, arg: u64) -> u64 {
    if prog == 0 || (prog > 16 && prog != P_BUSB_SPAWN) {
        return sysuser.neg(errno.E_INVAL)
    }
    let i: u64 = proc.create(state, prog, arg, 2)
    if i == 0 {
        return sysuser.neg(errno.E_NOMEM)
    }
    netview.inherit(state, me, i)
    ctr.inherit(state, me, i)
    origin.inherit(state, me, i)
    return sched.tget(state, i, sched.T_PID)
}

// `exec(path, argv, argc)` -- a program off the disk, in a process of its
// own, the way round K1 built it. Everything the process will need is
// copied into the KERNEL before a single frame is taken: the path and
// every argument. `elf.spawn` builds an address space and pours the file
// into it, and it may not be holding a pointer of ring 3 while it does
// that -- the caller could be swapped out, killed, or simply lying.
fn do_exec(state: u64, me: u64, path: u64, argv: u64, argc: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return sysuser.neg(errno.E_NOSYS)
    }
    if argc > proc.MAX_ARGS {
        return sysuser.neg(errno.E_2BIG)
    }
    let name: u64 = sysuser.nameb(state)
    let len: u64 = sysuser.fetch_path(state, me, path, name, sysconst.MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if len == 0 {
        return sysuser.neg(errno.E_INVAL)
    }
    let abuf: u64 = cpu.earg_buf(state)
    var at: u64 = 0
    var k: u64 = 0
    while k < argc {
        if !proc.user_ok(state, me, argv + k * 8, 8) {
            return sysuser.neg(errno.E_FAULT)
        }
        if at + MAX_ARG + 1 > kstate.EARG_MAX {
            return sysuser.neg(errno.E_2BIG)
        }
        let n: u64 = sysuser.fetch_name(state, me,
            sysuser.user_word(state, me, argv + k * 8), abuf + at, MAX_ARG)
        if errno.is_error(n) {
            return n
        }
        at = at + n + 1
        k = k + 1
    }
    // ROUND POWERMON does not hook here: `elf.spawn` goes through
    // `elf.build`, and the naming sits there so that all six ways of
    // starting a program are covered by one line instead of five.
    let t: u64 = elf.spawn(state, name, abuf, argc, 2)
    if t == 0 {
        let why: u64 = kstate.get(state, kstate.ELF_ERR)
        elf.say_reason(why)
        return sysuser.neg(elf.errno_of(why))
    }
    netview.inherit(state, me, t)
    ctr.inherit(state, me, t)
    // ROUND NETMON: a new task, a fresh set of counters, and the name
    // of the program they are counted under.
    netmon.task_clear(state, t, sched.tget(state, t, sched.T_PID))
    netmon.name_set(state, t, name)
    return sched.tget(state, t, sched.T_PID)
}

// ROUND SESSUID: `exec` for the session (see SYS_OSUM_EXECAS above). The
// mark lives on the caller's own task word for exactly the length of
// `do_exec`; `sched.create` turns it into the child's identity.
// Nothing here can raise a privilege: mode 0 only ever LOWERS the child
// (a non-root caller gets a plain `exec`), mode 1 refuses non-root.
fn do_exec_as(state: u64, me: u64, path: u64, argv: u64, packed: u64) -> u64 {
    let argc: u64 = packed & 0xFFFF
    let mode: u64 = (packed >> 16) & 0xFFFF
    if mode > EXECAS_PRIV {
        return sysuser.neg(errno.E_INVAL)
    }
    let euid: u64 = sched.tget(state, me, sched.T_EUID)
    if mode == EXECAS_PRIV {
        if euid != 0 {
            var s_no: [u8; 24] = "execas: priv refused\n\0\0\0"
            serial.puts((&s_no[0]) as u64)
            return sysuser.neg(errno.E_PERM)
        }
        let rp: u64 = do_exec(state, me, path, argv, argc)
        var s_pv: [u8; 18] = "execas: priv pid=\0"
        var s_pf: [u8; 19] = "execas: priv fail\n\0"
        if errno.is_error(rp) {
            serial.puts((&s_pf[0]) as u64)
        } else {
            serial.puts((&s_pv[0]) as u64)
            serial.dec(rp)
            serial.nl()
        }
        return rp
    }
    if euid != 0 || kstate.get(state, kstate.K11_OFF + kstate.SP_UID) == 0 {
        return do_exec(state, me, path, argv, argc)
    }
    sched.tset(state, me, sched.T_EXAS, 1)
    let r: u64 = do_exec(state, me, path, argv, argc)
    sched.tset(state, me, sched.T_EXAS, 0)
    // The trail (gate tools/sessuid): which identity the child really got.
    if !errno.is_error(r) {
        let sl: u64 = sched.find_pid(state, r)
        if sl < kstate.MAX_TASKS {
            var s_u: [u8; 18] = "execas: user pid=\0"
            var s_i: [u8; 6] = " uid=\0"
            serial.puts((&s_u[0]) as u64)
            serial.dec(r)
            serial.puts((&s_i[0]) as u64)
            serial.dec(sched.tget(state, sl, sched.T_UID))
            serial.nl()
        }
    }
    return r
}

// ============================================================ Runde K11

fn do_setenv(state: u64, me: u64, buf: u64, len: u64) -> u64 {
    if len > kstate.ENV_MAX {
        return sysuser.neg(errno.E_2BIG)
    }
    if len != 0 && !proc.user_ok(state, me, buf, len) {
        return sysuser.neg(errno.E_FAULT)
    }
    let dst: u64 = state + kstate.K11_OFF + kstate.ENV_BUF
    var i: u64 = 0
    var n: u64 = 0
    while i < len {
        let c: u64 = sysuser.peek(state, me, buf + i)
        kstate.set8(dst + i, c as u8)
        if c == 0 {
            n = n + 1
        }
        i = i + 1
    }
    kstate.set(state, kstate.K11_OFF + kstate.ENV_N, n)
    kstate.set(state, kstate.K11_OFF + kstate.ENV_LEN, len)
    return n
}

fn do_pstat(state: u64, me: u64, index: u64, field: u64) -> u64 {
    if index >= kstate.MAX_TASKS {
        return sysuser.neg(errno.E_INVAL)
    }
    if index >= kstate.get(state, kstate.TASKS) {
        return 0
    }
    if !ctr.visible(state, me, index) {
        return 0
    }
    if field == uio.P_CPU || field == uio.P_PAGES {
        if sched.tget(state, index, sched.T_STATE) == sched.S_FREE {
            return 0
        }
        if field == uio.P_CPU {
            return sched.cpu_of(state, index)
        }
        return proc.space_pages(state, index)
    }
    if field == uio.P_NAME0 || field == uio.P_NAME1 {
        if sched.tget(state, index, sched.T_STATE) == sched.S_FREE
            || sched.tget(state, index, sched.T_KIND) != sched.K_USER {
            return 0
        }
        guard.stac(state)
        let name: u64 = pstat_name(state, index, field == uio.P_NAME1)
        guard.clac(state)
        return name
    }
    // r146: age (ms) and command line (octets, 8 per number)
    if field == uio.P_AGE {
        if sched.tget(state, index, sched.T_STATE) == sched.S_FREE {
            return 0
        }
        let born: u64 = sched.tget(state, index, sched.T_BORN)
        let now: u64 = kstate.get(state, kstate.TICKS)
        if now < born {
            return 0
        }
        return (now - born) * 1000 / time.TICK_HZ
    }
    if field == uio.P_UID || field == uio.P_THREADS || field == uio.P_DISKR || field == uio.P_DISKW {
        return pstat_count(state, index, field)
    }
    if field >= uio.P_CMD0 && field < uio.P_CMD0 + uio.P_CMD_WORDS {
        if sched.tget(state, index, sched.T_STATE) == sched.S_FREE
            || sched.tget(state, index, sched.T_KIND) != sched.K_USER {
            return 0
        }
        guard.stac(state)
        let cmd: u64 = pstat_cmd(state, index, field - uio.P_CMD0)
        guard.clac(state)
        return cmd
    }
    return uio.pstat(state, index, field)
}

fn pstat_count(state: u64, index: u64, field: u64) -> u64 {
    if sched.tget(state, index, sched.T_STATE) == sched.S_FREE {
        return 0
    }
    if field == uio.P_UID {
        return sched.tget(state, index, sched.T_UID)
    }
    if field == uio.P_DISKR {
        return sched.tget(state, index, sched.T_DISKR)
    }
    if field == uio.P_DISKW {
        return sched.tget(state, index, sched.T_DISKW)
    }
    var group: u64 = sched.tget(state, index, sched.T_TGID)
    if group == 0 {
        group = sched.tget(state, index, sched.T_PID)
    }
    var n: u64 = 0
    var j: u64 = 0
    let top: u64 = kstate.get(state, kstate.TASKS)
    while j < top && j < kstate.MAX_TASKS {
        let st: u64 = sched.tget(state, j, sched.T_STATE)
        if st != sched.S_FREE && st != sched.S_ZOMBIE && st != sched.S_NEW {
            var g: u64 = sched.tget(state, j, sched.T_TGID)
            if g == 0 {
                g = sched.tget(state, j, sched.T_PID)
            }
            if g == group {
                n = n + 1
            }
        }
        j = j + 1
    }
    return n
}

fn do_setprio(state: u64, me: u64, pid: u64, prio: u64) -> u64 {
    if prio < 1 || prio > 3 {
        return sysuser.neg(errno.E_INVAL)
    }
    let t: u64 = sched.find_pid(state, pid)
    if t >= kstate.MAX_TASKS {
        return sysuser.neg(errno.E_SRCH)
    }
    let st: u64 = sched.tget(state, t, sched.T_STATE)
    if st == sched.S_FREE || st == sched.S_ZOMBIE || sched.tget(state, t, sched.T_KIND) != sched.K_USER {
        return sysuser.neg(errno.E_SRCH)
    }
    if !perm.may_signal(state, me, t) {
        return sysuser.neg(errno.E_PERM)
    }
    sched.tset(state, t, sched.T_PRIO, prio)
    return 0
}

// r146: eight octets of the command line, `word` = 0.. (octets 8*word .. 8*word+7). The command line is
// argv[0], argv[1] .. joined by one blank, read from the task's argument page like pstat_name. A task
// without arguments, or whose page is not mapped, has none (0).
fn pstat_cmd(state: u64, t: u64, word: u64) -> u64 {
    let frame: u64 = proc.translate(state, t, proc.ARGS_BASE)
    if frame == 0 {
        return 0
    }
    let argc: u64 = __mmio_read64(frame as *mut u64)
    if argc == 0 || argc > proc.MAX_ARGS {
        return 0
    }
    let from: u64 = word * 8
    let upto: u64 = from + 8
    let lim: u64 = frame + 4096
    var v: u64 = 0
    var pos: u64 = 0
    var a: u64 = 0
    while a < argc && pos < upto {
        let ptr: u64 = __mmio_read64((frame + 8 + a * 8) as *mut u64)
        if ptr < proc.ARGS_BASE || ptr >= proc.ARGS_BASE + 4096 {
            a = argc
        } else {
            var at: u64 = frame + (ptr - proc.ARGS_BASE)
            while at < lim && kstate.get8(at) != 0 && pos < upto {
                if pos >= from {
                    v = v | (kstate.get8(at) << ((pos - from) * 8))
                }
                pos = pos + 1
                at = at + 1
            }
            if a + 1 < argc && pos < upto {
                if pos >= from {
                    v = v | (32 << ((pos - from) * 8))
                }
                pos = pos + 1
            }
            a = a + 1
        }
    }
    return v
}

// ROADMAP-7 (r191): the basename of argv[0], eight octets of it. Read
// from the task's own argument page the way /proc/<pid>/cmdline reads it
// (procfs.make_cmdline): the page at proc.ARGS_BASE holds argc, then the
// pointers, then the strings -- all inside that one page.
fn pstat_name(state: u64, t: u64, second: bool) -> u64 {
    let frame: u64 = proc.translate(state, t, proc.ARGS_BASE)
    if frame == 0 {
        return 0
    }
    let argc: u64 = __mmio_read64(frame as *mut u64)
    if argc == 0 || argc > proc.MAX_ARGS {
        return 0
    }
    let ptr: u64 = __mmio_read64((frame + 8) as *mut u64)
    if ptr < proc.ARGS_BASE || ptr >= proc.ARGS_BASE + 4096 {
        return 0
    }
    let s0: u64 = frame + (ptr - proc.ARGS_BASE)
    let lim: u64 = frame + 4096
    // the basename: after the last '/'
    var at: u64 = s0
    var base: u64 = s0
    while at < lim && kstate.get8(at) != 0 {
        if kstate.get8(at) == 47 {
            base = at + 1
        }
        at = at + 1
    }
    var from: u64 = base
    if second {
        from = base + 8
    }
    var v: u64 = 0
    var k: u64 = 0
    var going: bool = from < at
    while going && k < 8 {
        let q: u64 = from + k
        if q >= at {
            going = false
        } else {
            v = v | (kstate.get8(q) << (k * 8))
            k = k + 1
        }
    }
    return v
}

fn do_getid(state: u64, me: u64, which: u64) -> u64 {
    return sched.tget(state, me, which)
}

fn do_getres(state: u64, me: u64, a: u64, b: u64, c: u64,
    fr: u64, fe: u64, fs_: u64) -> u64 {
    if a != 0 {
        if !sysuser.put32(state, me, a, sched.tget(state, me, fr)) {
            return sysuser.neg(errno.E_FAULT)
        }
    }
    if b != 0 {
        if !sysuser.put32(state, me, b, sched.tget(state, me, fe)) {
            return sysuser.neg(errno.E_FAULT)
        }
    }
    if c != 0 {
        if !sysuser.put32(state, me, c, sched.tget(state, me, fs_)) {
            return sysuser.neg(errno.E_FAULT)
        }
    }
    return 0
}

fn do_umask(state: u64, me: u64, m: u64) -> u64 {
    let old: u64 = sched.tget(state, me, sched.T_UMASK) & 4095
    sched.tset(state, me, sched.T_UMASK, m & 4095)
    return old
}

fn ids_ok(state: u64, me: u64, want: u64, real_f: u64, eff_f: u64,
    sav_f: u64) -> bool {
    if want == (0 -% 1) {
        return true // -1: unveraendert
    }
    if perm.is_root(state, me) {
        return true
    }
    if want == sched.tget(state, me, real_f) {
        return true
    }
    if want == sched.tget(state, me, eff_f) {
        return true
    }
    return want == sched.tget(state, me, sav_f)
}

fn ids_set(state: u64, me: u64, f: u64, v: u64) {
    if v != (0 -% 1) {
        sched.tset(state, me, f, v)
    }
}

fn do_setres(state: u64, me: u64, r: u64, e: u64, sv: u64,
    real_f: u64, eff_f: u64, sav_f: u64) -> u64 {
    if !ids_ok(state, me, r, real_f, eff_f, sav_f) {
        return sysuser.neg(errno.E_PERM)
    }
    if !ids_ok(state, me, e, real_f, eff_f, sav_f) {
        return sysuser.neg(errno.E_PERM)
    }
    if !ids_ok(state, me, sv, real_f, eff_f, sav_f) {
        return sysuser.neg(errno.E_PERM)
    }
    ids_set(state, me, real_f, r)
    ids_set(state, me, eff_f, e)
    ids_set(state, me, sav_f, sv)
    kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
    return 0
}

fn do_setuid(state: u64, me: u64, u: u64) -> u64 {
    if perm.is_root(state, me) {
        sched.tset(state, me, sched.T_UID, u)
        sched.tset(state, me, sched.T_EUID, u)
        sched.tset(state, me, sched.T_SUID, u)
        kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
        return 0
    }
    if !ids_ok(state, me, u, sched.T_UID, sched.T_EUID, sched.T_SUID) {
        return sysuser.neg(errno.E_PERM)
    }
    sched.tset(state, me, sched.T_EUID, u)
    kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
    return 0
}

fn do_setgid(state: u64, me: u64, g: u64) -> u64 {
    if perm.is_root(state, me) {
        sched.tset(state, me, sched.T_GID, g)
        sched.tset(state, me, sched.T_EGID, g)
        sched.tset(state, me, sched.T_SGID, g)
        kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
        return 0
    }
    if !ids_ok(state, me, g, sched.T_GID, sched.T_EGID, sched.T_SGID) {
        return sysuser.neg(errno.E_PERM)
    }
    sched.tset(state, me, sched.T_EGID, g)
    kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
    return 0
}

fn do_setre(state: u64, me: u64, r: u64, e: u64,
    real_f: u64, eff_f: u64, sav_f: u64) -> u64 {
    if !ids_ok(state, me, r, real_f, eff_f, sav_f) {
        return sysuser.neg(errno.E_PERM)
    }
    if !ids_ok(state, me, e, real_f, eff_f, sav_f) {
        return sysuser.neg(errno.E_PERM)
    }
    let old_real: u64 = sched.tget(state, me, real_f)
    ids_set(state, me, real_f, r)
    ids_set(state, me, eff_f, e)
    if r != (0 -% 1) || (e != (0 -% 1) && e != old_real) {
        sched.tset(state, me, sav_f, sched.tget(state, me, eff_f))
    }
    kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
    return 0
}

fn do_reboot(state: u64, me: u64, cmd: u64, wake_secs: u64) -> u64 {
    if !perm.is_root(state, me) {
        kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
        return sysuser.neg(errno.E_PERM)
    }
    if cmd == RB_SUSPEND {
        // K-004: the machine sleeps INSIDE this call and returns from it
        // when it wakes up. 0 = it slept and came back.
        let r: u64 = s3.suspend(state, wake_secs)
        if r == s3.R_OK_S3 || r == s3.R_RESUME {
            return 0
        }
        if r == s3.R_SMP || r == s3.R_PARK {
            return sysuser.neg(errno.E_BUSY)
        }
        if r == s3.R_NOMEM_S3 {
            return sysuser.neg(errno.E_NOMEM)
        }
        return sysuser.neg(errno.E_NOSYS)
    }
    var s_off: [u8; 20] = "power: init sagt ab\0"
    let _seed_saved: bool = randseed.save(state)
    perm.report(state)
    netview.report(state)
    safe.clean(state)
    wdt.mark_clean()
    serial.puts((&s_off[0]) as u64)
    serial.nl()
    if cmd == RB_POWEROFF {
        if !kstate.mode_on(state, kstate.M_NOACPI) {
            power.acpi_off(state)
        }
        power.shutdown(power.EXIT_OK)
        return 0
    }
    if cmd == RB_HALT {
        power.halt_forever()
        return 0
    }
    if cmd == RB_RESTART {
        if !kstate.mode_on(state, kstate.M_NOACPI) {
            power.acpi_reset(state)
        }
        power.shutdown(power.EXIT_OK)
        return 0
    }
    return sysuser.neg(errno.E_INVAL)
}

// ================================== RUNDE MULTIUSER: DIE ZUSATZGRUPPEN
fn do_getgroups(state: u64, me: u64, n: u64, out: u64) -> u64 {
    let have: u64 = sched.groups_count(state, me)
    if n == 0 {
        return have
    }
    if n < have {
        return sysuser.neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, out, have * 8) {
        return sysuser.neg(errno.E_FAULT)
    }
    let w: u64 = state + kstate.MU_OFF + 0x800
    var k: u64 = 0
    while k < have {
        kstate.set(state, kstate.MU_OFF + 0x800 + k * 8,
            sched.groups_at(state, me, k))
        k = k + 1
    }
    if have > 0 {
        if !sysuser.copy_out(state, me, out, w, have * 8) {
            return sysuser.neg(errno.E_FAULT)
        }
    }
    return have
}

fn do_setgroups(state: u64, me: u64, n: u64, src: u64) -> u64 {
    if !perm.is_root(state, me) {
        kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
        return sysuser.neg(errno.E_PERM)
    }
    if n > sched.GROUPS_MAX {
        return sysuser.neg(errno.E_INVAL)
    }
    if n == 0 {
        sched.groups_clear(state, me)
        kstate.add(state, kstate.MU_OFF + kstate.MU_SUPPSET, 1)
        return 0
    }
    if !proc.user_ok(state, me, src, n * 8) {
        return sysuser.neg(errno.E_FAULT)
    }
    let w: u64 = state + kstate.MU_OFF + 0x800
    if !sysuser.copy_in(state, me, w, src, n * 8) {
        return sysuser.neg(errno.E_FAULT)
    }
    if !sched.groups_set(state, me, w, n) {
        return sysuser.neg(errno.E_INVAL)
    }
    kstate.add(state, kstate.MU_OFF + kstate.MU_SUPPSET, 1)
    return 0
}

fn do_mustat(state: u64, me: u64, was: u64) -> u64 {
    if was == MS_WALKS {
        return perm.walk_stat(state, kstate.MU_WALKS)
    }
    if was == MS_WALKDENY {
        return perm.walk_stat(state, kstate.MU_WALKDENY)
    }
    if was == MS_GRPHITS {
        return perm.walk_stat(state, kstate.MU_GRPHITS)
    }
    if was == MS_SUPPSET {
        return perm.walk_stat(state, kstate.MU_SUPPSET)
    }
    if was == MS_NODECHK {
        return perm.walk_stat(state, kstate.MU_NODECHK)
    }
    return sysuser.neg(errno.E_INVAL)
}

fn do_userinfo(state: u64, me: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, UI_COUNT * 8) {
        return sysuser.neg(errno.E_FAULT)
    }
    let w: u64 = state + kstate.K13_OFF + 0x1000
    let b: u64 = kstate.K13_OFF
    kstate.set(state, kstate.K13_OFF + 0x1000 + 0 * 8,
        kstate.get(state, b + kstate.U_CHECKS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 1 * 8, kstate.get(state, b + kstate.U_DENIED))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 2 * 8, kstate.get(state, b + kstate.U_SETIDS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 3 * 8, kstate.get(state, b + kstate.U_CHMODS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 4 * 8, kstate.get(state, b + kstate.U_CHOWNS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 5 * 8, kstate.get(state, b + kstate.U_SUIDEXEC))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 6 * 8, fs.version(state))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 7 * 8, kstate.get(state, b + kstate.U_INITSLOT))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 8 * 8, kstate.get(state, b + kstate.U_ORPHANS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 9 * 8, sched.zombies(state, sched.K_USER))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 10 * 8, sched.tget(state, me, sched.T_UID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 11 * 8, sched.tget(state, me, sched.T_EUID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 12 * 8, sched.tget(state, me, sched.T_GID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 13 * 8, sched.tget(state, me, sched.T_EGID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 14 * 8, sched.tget(state, me, sched.T_SUID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 15 * 8, sched.tget(state, me, sched.T_UMASK))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 16 * 8, 0)
    if kstate.mode_on(state, kstate.M_NOPERM) {
        kstate.set(state, kstate.K13_OFF + 0x1000 + 16 * 8, 1)
    }
    kstate.set(state, kstate.K13_OFF + 0x1000 + 17 * 8,
        sched.alive_count(state))
    if !sysuser.copy_out(state, me, out, w, UI_COUNT * 8) {
        return sysuser.neg(errno.E_FAULT)
    }
    return 0
}
const UB_INF: u64 = 0xFFFFFFFFFFFFFFFF

// getrlimit / setrlimit / prlimit64. The numbers are the ones of THIS kernel where it has a limit (descriptors per process,
// processes), the ones Linux reports for "no limit" otherwise. setrlimit checks the shape (soft <= hard, a known resource) and accepts:
// nothing here enforces a limit that is not already a table size, and saying so is the answer -- a later getrlimit gives the real value.
fn rlimit_cur(res: u64) -> u64 {
    if res == 3 {
        return 8388608
    }
    if res == 4 {
        return 0
    }
    if res == 6 {
        return kstate.MAX_TASKS
    }
    if res == 7 {
        return file.MAX_FD
    }
    if res == 8 {
        return 65536
    }
    if res == 11 {
        return 1024
    }
    if res == 12 {
        return 819200
    }
    return UB_INF
}

fn rlimit_max(res: u64) -> u64 {
    if res == 4 {
        return 0
    }
    if res == 6 {
        return kstate.MAX_TASKS
    }
    if res == 7 {
        return file.MAX_FD
    }
    if res == 8 {
        return 65536
    }
    if res == 11 {
        return 1024
    }
    if res == 12 {
        return 819200
    }
    return UB_INF
}

fn do_rlimit(state: u64, me: u64, res: u64, newp: u64, oldp: u64) -> u64 {
    if res >= 16 {
        return sysuser.neg(errno.E_INVAL)
    }
    if oldp != 0 {
        if !proc.user_ok(state, me, oldp, 16) {
            return sysuser.neg(errno.E_FAULT)
        }
        let _a: bool = sysuser.put64(state, me, oldp, rlimit_cur(res))
        let _b: bool = sysuser.put64(state, me, oldp + 8, rlimit_max(res))
    }
    if newp != 0 {
        if !proc.user_ok(state, me, newp, 16) {
            return sysuser.neg(errno.E_FAULT)
        }
        let cur: u64 = sysuser.user_word(state, me, newp)
        let mx: u64 = sysuser.user_word(state, me, newp + 8)
        if cur > mx {
            return sysuser.neg(errno.E_INVAL)
        }
    }
    return 0
}

// The Linux `sysinfo`: uptime, load, memory in bytes (unit 1). The memory numbers are the frame allocator's.
fn do_sysinfo_linux(state: u64, me: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, 112) {
        return sysuser.neg(errno.E_FAULT)
    }
    var k: u64 = 0
    while k < 14 {
        let _z: bool = sysuser.put64(state, me, out + k * 8, 0)
        k = k + 1
    }
    let total: u64 = mmframe.frames_total(state) * sysconst.PAGE
    let free: u64 = mmframe.frames_free(state) * sysconst.PAGE
    let _up: bool = sysuser.put64(state, me, out, kstate.get(state, kstate.TICKS) / 100)
    let _tr: bool = sysuser.put64(state, me, out + 32, total)
    let _fr: bool = sysuser.put64(state, me, out + 40, free)
    let _pr: bool = sysuser.put32(state, me, out + 80, kstate.get(state, kstate.TASKS))
    let _mu: bool = sysuser.put32(state, me, out + 104, 1)
    return 0
}

// getrusage: the kernel keeps no per-process times of this kind; zeros are the honest "not accounted" and every field is there.
fn do_getrusage(state: u64, me: u64, who: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, 144) {
        return sysuser.neg(errno.E_FAULT)
    }
    var k: u64 = 0
    while k < 18 {
        let _z: bool = sysuser.put64(state, me, out + k * 8, 0)
        k = k + 1
    }
    return 0
}

// sched_getaffinity: one bit per processor the firmware reported (at least one), as the number of octets the caller gave
// (musl passes the size of its cpu_set_t; the kernel's answer is the number of octets it wrote).
fn do_getcpu(state: u64, me: u64, out: u64) -> u64 {
    if out != 0 {
        if !sysuser.put32(state, me, out, cpu.here(state)) {
            return sysuser.neg(errno.E_FAULT)
        }
    }
    return 0
}

fn do_getaffinity(state: u64, me: u64, pid: u64, size: u64, out: u64) -> u64 {
    if size < 8 || (size & 7) != 0 {
        return sysuser.neg(errno.E_INVAL)
    }
    var n: u64 = kstate.get(state, kstate.SMP_OFF + kstate.SMP_COUNT)
    if n == 0 {
        n = 1
    }
    if n > 64 {
        n = 64
    }
    if !proc.user_ok(state, me, out, size) {
        return sysuser.neg(errno.E_FAULT)
    }
    // (words through `put64`, which opens the SMAP window: a plain store to a user address from ring 0 is a #PF)
    var k: u64 = 0
    while k < size {
        let _z: bool = sysuser.put64(state, me, out + k, 0)
        k = k + 8
    }
    var mask: u64 = 0
    if n == 64 {
        mask = 0xFFFFFFFFFFFFFFFF
    } else {
        mask = (1 << n) - 1
    }
    let _m: bool = sysuser.put64(state, me, out, mask)
    return 8
}
