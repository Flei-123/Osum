fn pwr_call(state: u64, me: u64, number: u64, a0: u64, a1: u64,
    a2: u64) -> u64 {
    if number == SYS_OSUM_PWRGET {
        return syssvc.do_pwrget(state, a0)
    }
    if number == SYS_OSUM_PWRSET {
        return syssvc.do_pwrset(state, me, a0, a1)
    }
    return syssvc.do_pwrstr(state, me, a0, a1, a2)
}

// ==================================================================
// die native ABI: Handles statt Umgebungsautoritaet
// ==================================================================

fn grant_console(state: u64, task: u64, rights: u64) -> u64 {
    return cap.insert(state, task, cap.K_STREAM, rights, file.CON_OUT)
}

fn handle_call(state: u64, me: u64, number: u64, a0: u64, a1: u64,
    a2: u64, a3: u64) -> u64 {
    if number > HND_MAXNR {
        return handle.err(handle.E_INVALID)
    }
    if number == HND_VERSION {
        return 1
    }
    if number == HND_COUNT {
        return handle.used(state, file.owner(state, me))
    }
    if number == HND_FDH {
        return file.fd_handle(state, me, a0)
    }
    if number == HND_RIGHTS {
        if file.fd_handle(state, me, a0) == handle.HANDLE_NONE {
            return handle.err(handle.E_BADHANDLE)
        }
        return file.fd_rights(state, me, a0)
    }
    if number == HND_BEGIN {
        return handle.req_begin(state, me, a0, a1 & handle.R_ALL)
    }
    if number == HND_OBJECT {
        if handle.req_owner(state, a0) != me {
            return handle.err(handle.E_BADHANDLE)
        }
        return handle.req_object(state, a0)
    }
    if number == HND_STATE {
        if handle.req_owner(state, a0) != me {
            return handle.err(handle.E_BADHANDLE)
        }
        return handle.req_state(state, a0)
    }
    if number == HND_CANCEL {
        if !handle.req_cancel(state, me, a0) {
            return handle.err(handle.E_BADHANDLE)
        }
        return 0
    }
    if number == HND_END {
        if handle.req_owner(state, a0) != me {
            return handle.err(handle.E_BADHANDLE)
        }
        let settle_idx: u64 = handle.req_end(state, a0)
        if settle_idx == 0 {
            return 0
        }
        file.open_settle(state, settle_idx - 1)
        return 1
    }
    if number == HND_DUP {
        let of: u64 = sysuser.of_of(state, me, a0)
        if of >= file.MAX_OPEN {
            return handle.err(handle.E_BADHANDLE)
        }
        let nfd: u64 = file.fd_alloc(state, me, 0)
        if nfd >= file.MAX_FD {
            return handle.err(handle.E_EXHAUSTED)
        }
        let got: u64 = file.fd_pass(state, me, me, a0, a1, nfd)
        if got >= file.MAX_FD {
            return handle.err(handle.E_RIGHTS)
        }
        return got
    }
    if number == HND_PASS {
        let target: u64 = sched.find_pid(state, a0)
        if target >= kstate.MAX_TASKS {
            return handle.err(handle.E_NOTFOUND)
        }
        let got: u64 = file.fd_pass(state, me, target, a1, a2, a3)
        if got >= file.MAX_FD {
            return handle.err(handle.E_RIGHTS)
        }
        return got
    }
    if number == HND_OBJINFO {
        if !kstate.mode_on(state, kstate.M_HANDLE) {
            if !kstate.mode_on(state, kstate.M_ASYNC) {
                return handle.err(handle.E_UNSUPPORTED_HND)
            }
        }
        return syssvc.objinfo(state, me, a0, a1)
    }
    return handle.err(handle.E_INVALID)
}

fn aio_call(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64,
    a3: u64, a4: u64) -> u64 {
    if number == AIO_VERSION {
        return 1
    }
    if number == AIO_SUBMIT {
        return sysevent.aio_submit(state, me, a0, a1, a2, a3, a4)
    }
    if number == AIO_WAIT {
        return sysevent.aio_wait(state, me, a0, a1, a2, a3)
    }
    if number == AIO_CANCEL {
        return sysevent.aio_cancel(state, me, a0)
    }
    if number == AIO_STATE {
        let i: u64 = async.find(state, a0)
        if i >= async.MAX_AIO {
            return sysuser.neg(errno.E_BADF)
        }
        if async.owner_of(state, i) != me {
            kstate.add(state, kstate.A_DENIED, 1)
            return sysuser.neg(errno.E_PERM)
        }
        return async.state_of(state, i)
    }
    if number == AIO_INFO {
        if !kstate.mode_on(state, kstate.M_ASYNC) {
            if !kstate.mode_on(state, kstate.M_ABENCH) {
                return sysuser.neg(errno.E_NOSYS)
            }
        }
        return sysevent.aio_info(state, me, a0, a1)
    }
    return sysuser.neg(errno.E_INVAL)
}

const AIO_IDLE_TICKS: u64 = 100

fn aio_worker(state: u64, index: u64) {
    while true {
        let seen: u64 = sched.poll_seq(state)
        let i: u64 = async.take_new(state)
        if i < async.MAX_AIO {
            sysevent.aio_run(state, i)
        } else {
            sched.poll_sleep(state, seen,
                kstate.get(state, kstate.TICKS) + AIO_IDLE_TICKS)
            async.rearm(state)
        }
        sched.tset(state, index, sched.T_WORK,
            sched.tget(state, index, sched.T_WORK) + 1)
    }
}

fn native(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64,
    a3: u64, a4: u64) -> u64 {
    if number >= HND_BASE {
        return handle_call(state, me, number, a0, a1, a2, a3)
    }
    if number >= WM_BASE {
        return gfx.sys_wm(state, me, number, a0, a1, a2, a3, a4)
    }
    if number > CAP_MAXNR {
        return cap.err(cap.E_INVALID)
    }
    if number == CAP_VERSION {
        return cap.ABI_VERSION
    }
    if number == CAP_COUNT {
        return cap.used(state, me)
    }
    if number == CAP_CLOSE {
        if !cap.close(state, me, a0) {
            return cap.err(cap.E_BADHANDLE)
        }
        return 0
    }
    let i: u64 = cap.find(state, me, a0)
    if i >= cap.MAX_CAPS {
        return cap.err(cap.E_BADHANDLE)
    }
    let kind: u64 = cap.kind_at(state, me, i)
    let rights: u64 = cap.rights_at(state, me, i)
    let object: u64 = cap.object_at(state, me, i)

    if number == CAP_INSPECT {
        if !cap.rights_contains(rights, cap.R_INSPECT) {
            return cap.err(cap.E_RIGHTS)
        }
        if a1 != 0 {
            if !proc.user_ok(state, me, a1, 16) {
                return cap.err(cap.E_INVALID)
            }
            var k: u64 = 0
            while k < 8 {
                if !sysuser.poke(state, me, a1 + k, (kind >> (k * 8)) & 255) {
                    return cap.err(cap.E_INVALID)
                }
                if !sysuser.poke(state, me, a1 + 8 + k, (rights >> (k * 8)) & 255) {
                    return cap.err(cap.E_INVALID)
                }
                k = k + 1
            }
        }
        return 0
    }

    if number == CAP_DUP {
        if !cap.rights_contains(rights, cap.R_DUPLICATE) {
            return cap.err(cap.E_RIGHTS)
        }
        let h: u64 = cap.insert(state, me, kind,
            cap.rights_restrict(rights, a1), object)
        if h == cap.HANDLE_NONE {
            return cap.err(cap.E_EXHAUSTED)
        }
        return h
    }

    if number == CAP_TRANSFER {
        if !cap.rights_contains(rights, cap.R_TRANSFER) {
            return cap.err(cap.E_RIGHTS)
        }
        let target: u64 = sched.find_pid(state, a2)
        if target >= kstate.MAX_TASKS {
            return cap.err(cap.E_NOTFOUND)
        }
        let h: u64 = cap.insert(state, target, kind,
            cap.rights_restrict(rights, a1), object)
        if h == cap.HANDLE_NONE {
            return cap.err(cap.E_EXHAUSTED)
        }
        cap.close(state, me, a0)
        return h
    }

    if number == CAP_READ || number == CAP_WRITE {
        if kind != cap.K_STREAM {
            return cap.err(cap.E_WRONGTYPE)
        }
        var len: u64 = a2
        if len > sysconst.MAX_IO {
            len = sysconst.MAX_IO
        }
        if !proc.user_ok(state, me, a1, len) {
            return cap.err(cap.E_INVALID)
        }
        if object >= file.MAX_OPEN {
            return cap.err(cap.E_CLOSED)
        }
        if number == CAP_WRITE {
            if !cap.rights_contains(rights, cap.R_WRITE) {
                return cap.err(cap.E_RIGHTS)
            }
            let nw: u64 = sysfd.write_of(state, me, object, a1, len)
            if errno.is_error(nw) {
                return cap.err(cap.E_CLOSED)
            }
            return nw
        }
        if !cap.rights_contains(rights, cap.R_READ) {
            return cap.err(cap.E_RIGHTS)
        }
        let nr: u64 = sysfd.read_of(state, me, object, a1, len)
        if errno.is_error(nr) {
            return cap.err(cap.E_CLOSED)
        }
        return nr
    }
    return cap.err(cap.E_UNSUPPORTED)
}

// ====================================================== RUNDE DESKTOP
fn kbd_call(state: u64, was: u64, value: u64) -> u64 {
    if was == KB_GET {
        return kbd.layout(state)
    }
    if was == KB_COUNT {
        return kbd.LAYOUTS
    }
    if was == KB_SWITCH {
        return kbd.switches(state)
    }
    if was == KB_SET {
        if kbd.set_layout(state, value) {
            return 0
        }
        return errno.neg(errno.E_INVAL)
    }
    return errno.neg(errno.E_INVAL)
}

fn net_call(state: u64, me: u64, number: u64, a0: u64, a1: u64,
    a2: u64) -> u64 {
    // ======================================================= RUNDE O-EBPF
    if number == SYS_OSUM_EBPFLOAD {
        return sysnet.do_ebpf_load(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_EBPFATTACH {
        return sysnet.do_ebpf_attach(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_EBPFMAP {
        return sysnet.do_ebpf_map(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_EBPFSTAT {
        return sysnet.do_ebpf_stat(state, me, a0)
    }
    if number == SYS_OSUM_EBPFPROG {
        return sysnet.do_ebpf_prog(state, me, a0, a1)
    }
    // ======================================================= ROUND NETMON
    if number == SYS_OSUM_NETMON {
        return sysnet.do_netmon(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_SHARE {
        return sysnet.do_share(state, me, a0, a1)
    }
    if number == SYS_OSUM_NETMONROLL {
        if sched.tget(state, me, sched.T_EUID) != 0 {
            return sysuser.neg(errno.E_PERM)
        }
        if a0 >= netmon.NPROG || a1 >= netmon.T_FIELDS {
            return sysuser.neg(errno.E_INVAL)
        }
        return netmon.roll(state, a0, a1)
    }
    // ================================================= RUNDE O-CONTAINER
    if number == SYS_OSUM_CTRGET {
        return syssvc.do_ctrget(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_CTRSET {
        return syssvc.do_ctrset(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_CTRNEW {
        return syssvc.do_ctrnew(state, me, a0, a1)
    }
    if number == SYS_OSUM_CTRENTER {
        return syssvc.do_ctrenter(state, me, a0)
    }
    // ====================================================== RUNDE NETVIEW
    if number == SYS_OSUM_NETVFB {
        return sysnet.do_netvfb(state, me, a0)
    }
    if number == SYS_OSUM_NETVGET {
        return sysnet.do_netvget(state, me, a0, a1)
    }
    if number == SYS_OSUM_NETVSET {
        return sysnet.do_netvset(state, me, a0, a1)
    }
    if number == SYS_OSUM_NETVALLOW {
        return sysnet.do_netvallow(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_NETGET {
        let v: u64 = netview.view_of(state, me)
        if v == netview.V_NONE {
            if a0 == NG_READY {
                return 0
            }
            if a0 == NG_STATE {
                return netview.NS_NOCARRIER
            }
            return errno.neg(errno.E_NODEV)
        }
        if v == netview.V_FAKED {
            if a0 == NG_READY {
                return 1
            }
            if a0 == NG_IP {
                return netview.FAKE_IP
            }
            if a0 == NG_MASK {
                return netview.FAKE_MASK
            }
            if a0 == NG_GW {
                return netview.FAKE_GW
            }
            if a0 == NG_MAC0 {
                return netview.FAKE_MAC0
            }
            if a0 == NG_MAC1 {
                return netview.FAKE_MAC1
            }
            if a0 == NG_IN || a0 == NG_OUT {
                return 0
            }
            if a0 == NG_STATE {
                return netview.NS_ONLINE
            }
            if a0 == NG_HEALTH {
                return nethealth.H_OK
            }
            if a0 == NG_LINK {
                return 1
            }
            if a0 == NG_SPEED {
                return 0
            }
            if a0 == NG_CARDTX || a0 == NG_CARDRX {
                return 0
            }
            return errno.neg(errno.E_INVAL)
        }
        if a0 == NG_READY {
            if inet.ready(state) {
                return 1
            }
            return 0
        }
        if a0 == NG_STATE {
            return netview.link_state(state)
        }
        if a0 == NG_LINK {
            if inet.carrier(state) {
                return 1
            }
            return 0
        }
        if a0 == NG_HW {
            return inet.hwstat(state, a1)
        }
        if a0 == NG_UPGEN {
            return netdev.uplink_gen()
        }
        if a0 == NG_HEALTH {
            if netview.link_state(state) != netview.NS_ONLINE {
                return nethealth.H_UNKNOWN
            }
            return nethealth.stage(state)
        }
        if a0 == NG_HEALTH_HEALS {
            return nethealth.heals()
        }
        if a0 == NG_HEALTH_RUNG {
            return nethealth.rung()
        }
        if a0 == NG_LEASE {
            return wlan_link.lease_of(state, a1)
        }
        if a0 == NG_UPKIND {
            return netdev.kind_on(state, netdev.uplink(state))
        }
        if a0 == NG_SPEED {
            return inet.link_speed(state)
        }
        if !inet.ready(state) {
            return errno.neg(errno.E_NODEV)
        }
        if a0 == NG_IP {
            return inet.ip(state)
        }
        if a0 == NG_MASK {
            return inet.mask(state)
        }
        if a0 == NG_GW {
            return inet.gw(state)
        }
        if a0 == NG_MAC0 {
            return (inet.mac_at(state, 0) << 24) | (inet.mac_at(state, 1) << 16)
                | (inet.mac_at(state, 2) << 8) | inet.mac_at(state, 3)
        }
        if a0 == NG_MAC1 {
            return (inet.mac_at(state, 4) << 8) | inet.mac_at(state, 5)
        }
        if a0 == NG_IN {
            return inet.frames_in(state)
        }
        if a0 == NG_OUT {
            return inet.frames_out(state)
        }
        if a0 == NG_CARDTX {
            return inet.card_octets(state, 0)
        }
        if a0 == NG_CARDRX {
            return inet.card_octets(state, 1)
        }
        if a0 >= NG_DHCPST && a0 <= NG_DHCPTRY {
            return inet.dhcp_get(a0 - NG_DHCPST)
        }
        return errno.neg(errno.E_INVAL)
    }
    if number == SYS_OSUM_NETHEAL {
        if !perm.is_root(state, me) {
            return errno.neg(errno.E_PERM)
        }
        if a0 == HEAL_PUBLISH {
            if nethealth.publish(state, a1, a2 & 0xFFFFFFFF, a2 >> 32) == 0 {
                return errno.neg(errno.E_INVAL)
            }
            return 0
        }
        if a0 == HEAL_ARP_FLUSH {
            inet.arp_flush(state)
            return 0
        }
        return errno.neg(errno.E_INVAL)
    }
    if number == SYS_OSUM_DHCPST {
        if !perm.is_root(state, me) {
            return errno.neg(errno.E_PERM)
        }
        if a0 > 6 {
            return errno.neg(errno.E_INVAL)
        }
        inet.dhcp_set(a0, a1)
        return 0
    }
    if number != SYS_OSUM_NETSET {
        return sysuser.neg(errno.E_NOSYS)
    }
    if !perm.is_root(state, me) {
        return errno.neg(errno.E_PERM)
    }
    if !inet.ready(state) {
        return errno.neg(errno.E_NODEV)
    }
    if a0 == 0 {
        if a1 != 0 || (a2 & 0xFFFFFFFF) != 0 {
            return errno.neg(errno.E_INVAL)
        }
        if !inet.readdr(state, 0, 0, 0, 0, 0, 0) {
            return errno.neg(errno.E_IO)
        }
        return 0
    }
    var praefix: u64 = 0
    var bit: u64 = 32
    var seen_zero: bool = false
    while bit > 0 {
        bit = bit - 1
        if ((a1 >> bit) & 1) != 0 {
            if seen_zero {
                return errno.neg(errno.E_INVAL)
            }
            praefix = praefix + 1
        } else {
            seen_zero = true
        }
    }
    if !inet.readdr(state, (a0 >> 24) & 255, (a0 >> 16) & 255,
        (a0 >> 8) & 255, a0 & 255, praefix, a2 & 0xFFFFFFFF) {
        return errno.neg(errno.E_IO)
    }
    return 0
}

fn vm_call(state: u64, me: u64, number: u64, a0: u64, a1: u64) -> u64 {
    if number == SYS_VM_CREATE {
        return syssvc.do_vm_create(state, me, a0, a1)
    }
    if number == SYS_VM_RUN {
        let s: u64 = syssvc.vm_of(state, me, a0, cap.R_WRITE)
        if s >= hv.MAX_VMS {
            return syssvc.vm_error(s)
        }
        return hv.vm_run(state, s)
    }
    if number == SYS_VM_STAT {
        return syssvc.do_vm_stat(state, me, a0, a1)
    }
    if number == SYS_VM_KILL {
        let s: u64 = syssvc.vm_of(state, me, a0, cap.R_MANAGE)
        if s >= hv.MAX_VMS {
            return syssvc.vm_error(s)
        }
        hv.vm_destroy(state, s)
        cap.close(state, me, a0)
        return 0
    }
    if number == SYS_VM_VALUE {
        let s: u64 = syssvc.vm_of(state, me, a0, cap.R_READ)
        if s >= hv.MAX_VMS {
            return syssvc.vm_error(s)
        }
        return hv.value_of(state, a1)
    }
    return cap.err(cap.E_INVALID)
}

