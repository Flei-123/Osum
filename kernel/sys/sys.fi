// ============================================ ROUND NETMON, PART TWO
//
//   SHARE(what, index) -> number
//
// Everything the sharing of `kernel/share.fi` will tell a program:
// whether it is on, what the shared side's address and pool are, and
// one row per connected device. Reading is allowed for anybody, for the
// same reason as everywhere else in this round -- the person has a
// right to know which devices are hanging off their machine.
//
// SWITCHING IT ON AND OFF IS ROOT ONLY (`SH_SET`). Anything else and
// any process could hand this machine's connection to the room.
const SYS_OSUM_SHARE: u64 = 1322

const SH_ON: u64 = 0 // 1 = the connection is being handed on
const SH_SET: u64 = 1 // (index = 0 or 1) switch it -- euid 0
const SH_IP: u64 = 2 // this machine's address on the shared side
const SH_MASK: u64 = 3
const SH_P0: u64 = 4 // the first address handed out
const SH_P1: u64 = 5 // and the last
const SH_NCLIENT: u64 = 6 // how many devices are known
const SH_CLIENT: u64 = 7 // (index) 1 = that slot is in use
const SH_CMAC: u64 = 8 // its hardware address, six octets in one word
const SH_CIP: u64 = 9 // and the address it was given
const SH_CIN: u64 = 10 // octets it sent
const SH_COUT: u64 = 11 // and octets it received
const SH_NAT: u64 = 12 // records in the NAT table right now
const SH_STAT: u64 = 13 // (index) one of `share.S_*`
const SH_UPLINK: u64 = 14
const SH_SHARED: u64 = 15

