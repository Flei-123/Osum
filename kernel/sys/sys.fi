// The most a single `read` or `write` moves. The bounce buffer in the data
// area is one page, and a call that asks for more gets a SHORT answer, the
// way a Unix `read` may always give one -- not an error.
const MAX_IO: u64 = 4096
const MAX_NAME: u64 = 1024
const MAX_ARG: u64 = 448
fn nameb(state: u64) -> u64 {
    var k: u64 = cpu.here(state)
    if k >= kstate.MAX_CPUS {
        k = 0
    }
    return state + kstate.NAMEK_OFF + k * 4096
}

const NB_ENT: u64 = 3072
const NB_FSTYPE: u64 = 3584

// How long a blocked reader or writer waits before it gives up. At 100 Hz
// this is four seconds. A pipe with nobody at the other end must not be
// able to stop the machine: a measurement that ends in a time limit
// measures nothing.
const BLOCK_ROUNDS: u64 = 400

fn neg(e: u64) -> u64 {
    return errno.neg(e)
}

fn fget(frame: u64, off: u64) -> u64 {
    return __mmio_read64((frame + off) as *mut u64)
}

fn fset(frame: u64, off: u64, v: u64) {
    __mmio_write64((frame + off) as *mut u64, v)
}

// ------------------------------------------------------------ the entry

fn trace_fail_wanted(number: u64, e: u64) -> bool {
    if e == 11 || e == 4 {
        return false
    }
    if e == 2 && (number == 4 || number == 6 || number == 21 || number == 262 || number == 89) {
        return false
    }
    if number == 9 || number == 10 || number == 12 || number == 25 || number == 28 || number == 56 {
        return false
    }
    if e == 22 {
        return false
    }
    return true
}

fn trace_fail(frame: u64, state: u64, number: u64, r: u64) {
    if (number == 45 || number == 47 || number == 0) && r == 0 {
        var s_z: [u8; 14] = "sys: RECV0 nr\0"
        serial.puts((&s_z[0]) as u64)
        serial.dec(number)
        var s_zp: [u8; 6] = " pid \0"
        serial.puts((&s_zp[0]) as u64)
        serial.dec(sched.tget(state, sched.current(state), sched.T_PID))
        var s_z0: [u8; 5] = " a0 \0"
        serial.puts((&s_z0[0]) as u64)
        serial.dec(fget(frame, F_RDI))
        serial.nl()
        return
    }
    if r < 0xFFFFFFFFFFFFF000 {
        return
    }
    let e: u64 = 4096 - (r & 0xFFF)
    if !trace_fail_wanted(number, e) {
        return
    }
    var s_f: [u8; 13] = "sys: FAIL nr\0"
    serial.puts((&s_f[0]) as u64)
    serial.dec(number)
    var s_fe: [u8; 3] = " e\0"
    serial.puts((&s_fe[0]) as u64)
    serial.dec(e)
    var s_fp: [u8; 6] = " pid \0"
    serial.puts((&s_fp[0]) as u64)
    serial.dec(sched.tget(state, sched.current(state), sched.T_PID))
    var s_f0: [u8; 5] = " a0 \0"
    serial.puts((&s_f0[0]) as u64)
    serial.dec(fget(frame, F_RDI))
    var s_f1: [u8; 5] = " a1 \0"
    serial.puts((&s_f1[0]) as u64)
    serial.dec(fget(frame, F_RSI))
    var s_f2: [u8; 5] = " a2 \0"
    serial.puts((&s_f2[0]) as u64)
    serial.dec(fget(frame, F_RDX))
    serial.nl()
}

fn entry(number: u64, frame: u64, state: u64) -> u64 {
    if (number == 60 || number == 231 || number == 62 || number == 234) && kstate.mode_on(state, kstate.M_FREMDTRACE) {
        var s_xk: [u8; 14] = "sys: EXITK nr\0"
        serial.puts((&s_xk[0]) as u64)
        serial.dec(number)
        var s_xp: [u8; 6] = " pid \0"
        serial.puts((&s_xp[0]) as u64)
        serial.dec(sched.tget(state, sched.current(state), sched.T_PID))
        var s_x0: [u8; 5] = " a0 \0"
        serial.puts((&s_x0[0]) as u64)
        serial.dec(fget(frame, F_RDI))
        var s_x1: [u8; 5] = " a1 \0"
        serial.puts((&s_x1[0]) as u64)
        serial.dec(fget(frame, F_RSI))
        serial.nl()
    }
    let r: u64 = dispatch(number, frame, state)
    if kstate.mode_on(state, kstate.M_FREMDTRACE) {
        if r == neg(errno.E_NOSYS) && !is_tolerated_absent(number) {
            var s_ns: [u8; 15] = "sys: ENOSYS nr\0"
            serial.puts((&s_ns[0]) as u64)
            serial.dec(number)
            serial.nl()
        }
        // memory/thread calls that FAIL (mmap, mprotect, brk, mremap, madvise, clone): the number and the errno, so that a malloc
        // returning NULL in a foreign program can be traced to the call that refused (r701, foot font threads)
        if number == 9 && fget(frame, F_RSI) >= 1048576 {
            var s_eh: [u8; 13] = "sys: BIG nr9\0"
            serial.puts((&s_eh[0]) as u64)
            var s_ea2: [u8; 6] = " len \0"
            serial.puts((&s_ea2[0]) as u64)
            serial.dec(fget(frame, F_RSI))
            var s_eb2: [u8; 5] = " fl \0"
            serial.puts((&s_eb2[0]) as u64)
            serial.dec(fget(frame, F_R10))
            var s_er2: [u8; 4] = " r \0"
            serial.puts((&s_er2[0]) as u64)
            serial.dec(r)
            serial.nl()
        }
        if number == 9 && fget(frame, F_RSI) < 1048576 && (fget(frame, F_R8) & 0xFFFFFFFF) != 0xFFFFFFFF && r < 0xFFFFFFFFFFFFF000 {
            var s_fm: [u8; 14] = "sys: FMAP nr9\0"
            serial.puts((&s_fm[0]) as u64)
            var s_fa: [u8; 6] = " len \0"
            serial.puts((&s_fa[0]) as u64)
            serial.dec(fget(frame, F_RSI))
            var s_fb: [u8; 5] = " fl \0"
            serial.puts((&s_fb[0]) as u64)
            serial.dec(fget(frame, F_R10))
            var s_fo: [u8; 6] = " off \0"
            serial.puts((&s_fo[0]) as u64)
            serial.dec(fget(frame, F_R9))
            var s_fr: [u8; 4] = " r \0"
            serial.puts((&s_fr[0]) as u64)
            serial.dec(r)
            serial.nl()
        }
        if number == 7 && fget(frame, F_RSI) == 1 {
            var s_po: [u8; 14] = "sys: POLL pid\0"
            serial.puts((&s_po[0]) as u64)
            var s_pp: [u8; 2] = " \0"
            serial.puts((&s_pp[0]) as u64)
            serial.dec(sched.tget(state, sched.current(state), sched.T_PID))
            var s_pt: [u8; 6] = " tmo \0"
            serial.puts((&s_pt[0]) as u64)
            serial.dec(fget(frame, F_RDX))
            var s_pr: [u8; 4] = " r \0"
            serial.puts((&s_pr[0]) as u64)
            serial.dec(r)
            var s_pk: [u8; 7] = " tick \0"
            serial.puts((&s_pk[0]) as u64)
            serial.dec(kstate.get(state, kstate.TICKS))
            serial.nl()
        }
        if r >= 0xFFFFFFFFFFFFF000 && (4096 - (r & 0xFFF)) == 22 && number != 9 && number != 10 && number != 12 && number != 25 && number != 28 && number != 56 {
            var s_ei: [u8; 15] = "sys: EINVAL nr\0"
            serial.puts((&s_ei[0]) as u64)
            serial.dec(number)
            var s_ep2: [u8; 6] = " pid \0"
            serial.puts((&s_ep2[0]) as u64)
            serial.dec(sched.tget(state, sched.current(state), sched.T_PID))
            var s_e0: [u8; 5] = " a0 \0"
            serial.puts((&s_e0[0]) as u64)
            serial.dec(fget(frame, F_RDI))
            var s_e1: [u8; 5] = " a1 \0"
            serial.puts((&s_e1[0]) as u64)
            serial.dec(fget(frame, F_RSI))
            var s_e2: [u8; 5] = " a2 \0"
            serial.puts((&s_e2[0]) as u64)
            serial.dec(fget(frame, F_RDX))
            serial.nl()
        }
        trace_fail(frame, state, number, r)
        if r >= 0xFFFFFFFFFFFFF000 && !(number == 25 && (4096 - (r & 0xFFF)) == 12 && fget(frame, F_RSI) == 4096 && fget(frame, F_RDX) == 8192) {
            if number == 9 || number == 10 || number == 12 || number == 25 || number == 28 || number == 56 {
                var s_er: [u8; 12] = "sys: ERR nr\0"
                serial.puts((&s_er[0]) as u64)
                serial.dec(number)
                var s_ee: [u8; 3] = " e\0"
                serial.puts((&s_ee[0]) as u64)
                serial.dec(4096 - (r & 0xFFF))
                var s_ea: [u8; 6] = " len \0"
                serial.puts((&s_ea[0]) as u64)
                serial.dec(fget(frame, F_RSI))
                var s_eb: [u8; 5] = " fl \0"
                serial.puts((&s_eb[0]) as u64)
                serial.dec(fget(frame, F_R10))
                var s_ed: [u8; 7] = " addr \0"
                serial.puts((&s_ed[0]) as u64)
                serial.dec(fget(frame, F_RDI))
                var s_ec: [u8; 5] = " fd \0"
                serial.puts((&s_ec[0]) as u64)
                serial.dec(fget(frame, F_R8) & 0xFFFFFFFF)
                var s_ep: [u8; 6] = " pid \0"
                serial.puts((&s_ep[0]) as u64)
                serial.dec(sched.tget(state, sched.current(state), sched.T_PID))
                if number == 25 {
                    var s_en: [u8; 5] = " nl \0"
                    serial.puts((&s_en[0]) as u64)
                    serial.dec(fget(frame, F_RDX))
                }
                serial.nl()
            }
        }
    }
    fset(frame, F_RAX, r)
    signal.check_sys(state, sched.current(state), frame)
    return r
}

fn trace_user_word(state: u64, me: u64, addr: u64) -> u64 {
    var w: u64 = 0
    if addr < 0x1000 || (addr & 7) != 0 {
        return 0
    }
    if !copy_in(state, me, (&w) as u64, addr, 8) {
        return 0
    }
    return w
}

fn trace_site(state: u64, me: u64, frame: u64, kind: u64, len: u64) {
    let rbp: u64 = fget(frame, F_RBP)
    if rbp >= 0x00007FFFFFFFFFF0 {
        mmaptrace.note(me, kind, len, fget(frame, F_RIP), 0, 0)
        return
    }
    let c1: u64 = trace_user_word(state, me, rbp + 8)
    var c2: u64 = 0
    if c1 != 0 {
        let up: u64 = trace_user_word(state, me, rbp)
        if up > rbp && up < 0x00007FFFFFFFFFF0 {
            c2 = trace_user_word(state, me, up + 8)
        }
    }
    mmaptrace.note(me, kind, len, fget(frame, F_RIP), c1, c2)
}

fn dispatch(number: u64, frame: u64, state: u64) -> u64 {
    wdt.sys_hook(state)
    kstate.add(state, kstate.SYSCALLS, 1)
    stall.sys_note(number, sched.current(state))
    svcwatch.note(state, sched.current(state))
    let a0: u64 = fget(frame, F_RDI)
    let a1: u64 = fget(frame, F_RSI)
    let a2: u64 = fget(frame, F_RDX)
    let a3: u64 = fget(frame, F_R10)
    let a4: u64 = fget(frame, F_R8)
    let a5: u64 = fget(frame, F_R9)
    if kstate.get(state, kstate.EXCURSION) != 0 {
        if number == SYS_MARK || number == SYS_LEAVE {
            return user.handle(number, a0, state)
        }
    }
    let me: u64 = sched.current(state)
    if number >= CAP_BASE {
        return native(state, me, number, a0, a1, a2, a3, a4)
    }
    if number == SYS_WRITE {
        return file_io_loop(state, me, a0, a1, a2, true)
    }
    if number == SYS_READ {
        return file_io_loop(state, me, a0, a1, a2, false)
    }
    if number == SYS_OPEN {
        if (a1 & 64) != 0 && ev_in_any(state) {
            return ev_open_create(state, me, a0, a1, a2)
        }
        let opened: u64 = cx_result(state, me, do_open_mode(state, me, a0, a1, a2), a1)
        svcwatch.open_result(state, opened)
        return opened
    }
    if number == SYS_CLOSE {
        return do_close(state, me, a0)
    }
    if number == SYS_LSEEK {
        return do_lseek(state, me, a0, a1, a2)
    }
    if number == SYS_LSTAT {
        return do_lstat(state, me, a0, a1)
    }
    if number == SYS_SYMLINK {
        return do_symlink(state, me, a0, a1)
    }
    if number == SYS_READLINK {
        return do_readlink(state, me, a0, a1, a2)
    }
    if number == SYS_UTIMENSAT {
        let ue: u64 = at_enter1(state, me, a0, a1)
        if errno.is_error(ue) {
            return ue
        }
        let ur: u64 = do_utimensat(state, me, a0, a1, a2, a3)
        uio.set_atbase(state, me, 0)
        return ur
    }
    if number == SYS_STAT {
        return do_stat(state, me, a0, a1)
    }
    if number == SYS_FSTAT {
        return do_fstat(state, me, a0, a1)
    }
    if number == SYS_GETDENTS64 {
        return do_getdents(state, me, a0, a1, a2)
    }
    if number == SYS_MKDIR {
        let r: u64 = do_mkdir_mode(state, me, a0, a1)
        if r == 0 {
            ev_in_path(state, me, a0, IN_CREATE | IN_ISDIR, 0)
        }
        return r
    }
    if number == SYS_UNLINK {
        let r: u64 = do_unlink(state, me, a0)
        if r == 0 {
            ev_in_path(state, me, a0, IN_DELETE, 0)
        }
        return r
    }
    if number == SYS_RMDIR {
        let r: u64 = do_rmdir(state, me, a0)
        if r == 0 {
            ev_in_path(state, me, a0, IN_DELETE | IN_ISDIR, 0)
        }
        return r
    }
    if number == SYS_GETCWD {
        return do_getcwd(state, me, a0, a1)
    }
    // ROUND K8: the sockets. They stand here, in the same table as
    // `read` and `write`, and not beside it -- a socket IS a descriptor
    // of this system, and `dup2`, `fork` and `close` reach it without
    // knowing that.
    if number == SYS_SOCKET {
        return cx_result(state, me, do_socket(state, me, a0, a1, a2), a1)
    }
    if number == SYS_BIND {
        return do_bind(state, me, a0, a1, a2)
    }
    if number == SYS_LISTEN {
        return do_listen(state, me, a0, a1)
    }
    if number == SYS_ACCEPT {
        return do_accept(state, me, a0, a1, a2, 0)
    }
    if number == SYS_ACCEPT4 {
        return cx_result(state, me, do_accept(state, me, a0, a1, a2, a3), a3)
    }
    if number == SYS_CONNECT {
        return do_connect(state, me, a0, a1, a2)
    }
    if number == SYS_SENDTO {
        return do_sendto(state, me, a0, a1, a2, a4, a5)
    }
    if number == SYS_RECVFROM {
        let nlof: u64 = nl_of(state, me, a0)
        if nlof < file.MAX_OPEN {
            return nl_recv_of(state, me, nlof, a1, a2, a3, a4, a5)
        }
        return do_recvfrom(state, me, a0, a1, a2, a4, a5)
    }
    if number == SYS_SHUTDOWN {
        return do_shutdown(state, me, a0, a1)
    }
    if number == SYS_SENDMSG {
        return do_sendmsg(state, me, a0, a1, a2)
    }
    if number == SYS_RECVMSG {
        return do_recvmsg(state, me, a0, a1, a2)
    }
    if number == SYS_MEMFD_CREATE {
        return do_memfd(state, me, a0, a1)
    }
    if number == SYS_FTRUNCATE {
        return do_ftruncate(state, me, a0, a1)
    }
    if number == SYS_FALLOCATE {
        return do_fallocate(state, me, a0, a1, a2, a3)
    }
    if number == SYS_GETSOCKNAME {
        return do_sockname(state, me, a0, a1, a2, false)
    }
    if number == SYS_GETPEERNAME {
        return do_sockname(state, me, a0, a1, a2, true)
    }
    if number == SYS_SETSOCKOPT {
        return do_setsockopt(state, me, a0, a1, a2, a3, a4)
    }
    if number == SYS_GETSOCKOPT {
        return do_getsockopt(state, me, a0, a1, a2, a3, a4)
    }
    if number == SYS_DUP {
        return do_dup(state, me, a0)
    }
    if number == SYS_DUP2 {
        return do_dup2(state, me, a0, a1)
    }
    if number == SYS_PIPE {
        return do_pipe(state, me, a0)
    }
    if number >= AIO_BASE {
        if number <= AIO_MAXNR {
            return aio_call(state, me, number, a0, a1, a2, a3, a4)
        }
    }
    if number == SYS_FSYNC {
        return do_fsync(state, me, a0)
    }
    if number == SYS_POLL {
        return do_poll(state, me, a0, a1, a2)
    }
    if number == SYS_BRK {
        return do_brk(state, me, a0)
    }
    if number == SYS_ARCH_PRCTL {
        return do_arch_prctl(state, me, a0, a1)
    }
    if number == SYS_WRITEV {
        return do_writev(state, me, a0, a1, a2, true)
    }
    if number == SYS_READV {
        return do_writev(state, me, a0, a1, a2, false)
    }
    if number == 295 || number == 296 {
        return do_pvec(state, me, a0, a1, a2, a3, number == 296)
    }
    if number == 327 || number == 328 {
        if a3 == (0 -% 1) {
            return do_writev(state, me, a0, a1, a2, number == 328)
        }
        return do_pvec(state, me, a0, a1, a2, a3, number == 328)
    }
    if number == 247 {
        return do_waitid(state, me, a0, a1, a2, a3)
    }
    if is_tolerated_absent(number) {
        return neg(errno.E_NOSYS)
    }
    if number == ABS_RESTART_SYSCALL {
        return neg(errno.E_INTR)
    }
    if number == SYS_SET_TID_ADDRESS {
        if proc.user_ok(state, me, a0, 4) {
            sched.tset(state, me, sched.T_FUTEX, a0)
        }
        return sched.tget(state, me, sched.T_PID)
    }
    if number == SYS_PREAD64 {
        return do_pio(state, me, a0, a1, a2, a3, false)
    }
    if number == SYS_PWRITE64 {
        return do_pio(state, me, a0, a1, a2, a3, true)
    }
    if number == SYS_FCNTL {
        return do_fcntl(state, me, a0, a1, a2)
    }
    if number == SYS_UNAME {
        return do_uname(state, me, a0)
    }
    if number == SYS_PRCTL {
        return do_prctl(state, me, a0, a1)
    }
    if number == SYS_CLONE {
        return do_clone(state, me, frame, a0, a1, a2, a3, a4)
    }
    if number == SYS_FUTEX {
        return futex.call(state, me, a0, a1, a2, a3, a4, a5)
    }
    if number == SYS_MPROTECT {
        unixsock.vm_lock(state, me)
        let mpr: u64 = do_mprotect(state, me, a0, a1, a2)
        unixsock.vm_unlock(state, me)
        return mpr
    }
    // RUNDE UNTERBAU: the small calls a big program makes at start-up (docs/RUNDE-UNTERBAU-FIREFOX.md). Each answers with what this
    // kernel really is -- a limit that exists, a count of cores it really has, "nothing to do" where there is nothing -- and none of
    // them pretends to an effect it does not have.
    // RUNDE UNTERBAU: select / pselect6 / ppoll -- the other ways to wait for descriptors, on the same readiness test and the same wake-up as `poll`.
    // RUNDE EVENTS: epoll, eventfd, timerfd, signalfd, inotify (state in fs/evfd.fi, the calls at the end of this file).
    if ev_number(number) {
        return do_events(state, me, number, a0, a1, a2, a3, a4)
    }
    if number == UB_SOCKETPAIR {
        return cx_pair(state, me, do_socketpair(state, me, a0, a1, a2, a3), a3, a1)
    }
    if number == UB_SELECT {
        return do_select(state, me, a0, a1, a2, a3, a4, 0)
    }
    if number == UB_PSELECT6 {
        return do_select(state, me, a0, a1, a2, a3, a4, 1)
    }
    if number == UB_PPOLL {
        // timespec* -> milliseconds (rounded up); a NULL pointer is "no limit"; the signal mask (a3) is accepted and ignored
        var tmo: u64 = 0xFFFFFFFF
        if a2 != 0 {
            if !proc.user_ok(state, me, a2, 16) {
                return neg(errno.E_FAULT)
            }
            let psec: u64 = user_word(state, me, a2)
            let pns: u64 = user_word(state, me, a2 + 8)
            if pns >= 1000000000 {
                return neg(errno.E_INVAL)
            }
            if psec > 2000000 {
                tmo = 0xFFFFFFFF
            } else {
                tmo = psec * 1000 + (pns + 999999) / 1000000
            }
        }
        return do_poll(state, me, a0, a1, tmo)
    }
    if number == UB_MADVISE {
        return do_madvise(state, me, a0, a1, a2)
    }
    if number == UB_READAHEAD || number == UB_FADVISE64 {
        return 0
    }
    if number == UB_MREMAP {
        unixsock.vm_lock(state, me)
        let mrr: u64 = do_mremap(state, me, a0, a1, a2, a3)
        unixsock.vm_unlock(state, me)
        return mrr
    }
    if number == UB_MSYNC {
        // LCSH: write back the file pages of every shared file mapping that overlaps [a0, a0 + a1)
        file_shm_flush_maps(state, me, a0, a1, false)
        return 0
    }
    if number == UB_MLOCK || number == UB_MUNLOCK || number == UB_MLOCKALL || number == UB_MUNLOCKALL {
        // no swap: nothing that could be paged out -- the honest answer is "done"
        return 0
    }
    if number == UB_GETRLIMIT {
        return do_rlimit(state, me, a0, 0, a1)
    }
    if number == UB_SETRLIMIT {
        return do_rlimit(state, me, a0, a1, 0)
    }
    if number == UB_PRLIMIT64 {
        if a0 != 0 && a0 != sched.tget(state, me, sched.T_PID) {
            return neg(errno.E_PERM)
        }
        return do_rlimit(state, me, a1, a2, a3)
    }
    if number == UB_SYSINFO {
        return do_sysinfo_linux(state, me, a0)
    }
    if number == UB_GETRUSAGE {
        return do_getrusage(state, me, a0, a1)
    }
    if number == UB_SCHED_GETAFFINITY {
        return do_getaffinity(state, me, a0, a1, a2)
    }
    if number == UB_SCHED_SETAFFINITY {
        return 0
    }
    if number == UB_SCHED_GETSCHEDULER {
        return 0
    }
    if number == UB_SCHED_GETPARAM {
        if !put32(state, me, a1, 0) {
            return neg(errno.E_FAULT)
        }
        return 0
    }
    if number == UB_SCHED_SETSCHEDULER {
        // only the ordinary policy exists: SCHED_OTHER (0), SCHED_BATCH (3), SCHED_IDLE (5) are accepted as "the same", real-time is refused
        if a1 == 1 || a1 == 2 {
            return neg(errno.E_PERM)
        }
        return 0
    }
    if number == UB_SCHED_SETPARAM {
        return 0
    }
    if number == UB_SCHED_GET_PRIORITY_MAX {
        if a0 == 1 || a0 == 2 {
            return 99
        }
        return 0
    }
    if number == UB_SCHED_GET_PRIORITY_MIN {
        if a0 == 1 || a0 == 2 {
            return 1
        }
        return 0
    }
    if number == UB_SET_ROBUST_LIST {
        return 0
    }
    if number == UB_GETPRIORITY {
        return 20
    }
    if number == UB_SETPRIORITY {
        return 0
    }
    if number == UB_FDATASYNC {
        return do_fsync(state, me, a0)
    }
    if number == UB_FLOCK {
        // advisory lock, granted without locking: the same documented answer as fcntl(F_SETLK) -- one process at a time sees a file today
        if of_of(state, me, a0) >= file.MAX_OPEN {
            return neg(errno.E_BADF)
        }
        return 0
    }
    if number == UB_STATFS {
        let ino: u64 = ino_of_path(state, me, a0)
        if errno.is_error(ino) {
            return ino
        }
        return do_statfs(state, me, a1)
    }
    if number == UB_FSTATFS {
        if of_of(state, me, a0) >= file.MAX_OPEN {
            return neg(errno.E_BADF)
        }
        return do_statfs(state, me, a1)
    }
    if number == LC_CHROOT {
        return do_chroot(state, me, a0)
    }
    if number == UB_DUP3 {
        if a0 == a1 {
            return neg(errno.E_INVAL)
        }
        return cx_result(state, me, do_dup2(state, me, a0, a1), a2)
    }
    if number == UB_PIPE2 {
        // TOCTOU (docs/SECURITY-TOCTOU-KERNEL.md K-01): the flags are applied to the descriptors the kernel
        // allocated, never to numbers read back from the user's int[2] (another thread can rewrite them).
        return do_pipe_flags(state, me, a0, a1)
    }
    // RUNDE LC4 (W-LC4): the `*at` family of the x86-64 table (openat 257 ... renameat2 316). glibc, Go and newer musl use these
    // instead of open/stat/unlink/mkdir/rename/readlink. This kernel has no directory descriptors, so -- like fchmodat/faccessat above --
    // the directory argument is honoured only as AT_FDCWD or when the path is absolute; a relative path with a real dirfd answers -ENOSYS.
    if number == statxconv.SYS_STATX {
        return do_statx(state, me, a0, a1, a2, a4)
    }
    if lc_is_at(number) {
        return lc_at(state, me, number, a0, a1, a2, a3, a4)
    }
    if number == SYS_MMAP {
        if (a3 & MAP_ANONYMOUS) != 0 {
            // r721 follow-up: anonymous maps take the address-space lock; a file map may sleep (disk read) and does not
            unixsock.vm_lock(state, me)
            let mar: u64 = do_map(state, me, a0, a1, a2, a3, a4, a5)
            unixsock.vm_unlock(state, me)
            trace_site(state, me, frame, mmaptrace.KIND_MAP, a1)
            vm_oom_after(state)
            return mar
        }
        return do_map(state, me, a0, a1, a2, a3, a4, a5)
    }
    if number == SYS_MUNMAP {
        // r721 follow-up: one address-space change at a time (see `unixsock.vm_lock`)
        unixsock.vm_lock(state, me)
        let umr: u64 = do_unmap(state, me, a0, a1)
        unixsock.vm_unlock(state, me)
        trace_site(state, me, frame, mmaptrace.KIND_UNMAP, a1)
        return umr
    }
    if number == SYS_GETPID {
        let g: u64 = sched.tget(state, me, sched.T_TGID)
        if g != 0 {
            return g
        }
        return sched.tget(state, me, sched.T_PID)
    }
    if number == SYS_GETPPID {
        return do_getppid(state, me)
    }
    if number == SYS_YIELD {
        sched.yield_now(state)
        return 0
    }
    if number == SYS_NANOSLEEP {
        return do_nanosleep(state, me, a0)
    }
    if number == SYS_FORK || number == SYS_VFORK {
        return do_fork(state, me, frame, 0)
    }
    if number == SYS_EXECVE {
        return do_execve(state, me, frame, a0, a1, a2)
    }
    if number == SYS_EXECVEAT {
        // r820: execveat(dirfd, path, argv, envp, flags). A relative path is completed against the directory descriptor (or the
        // cwd); an empty path with AT_EMPTY_PATH (fexecve) needs the path of a FILE descriptor, which is not kept -> -ENOSYS
        // (musl then falls back to /proc/self/fd/N, which does not exist either: ENOENT, the same as before).
        if proc.user_ok(state, me, a1, 1) && peek(state, me, a1) == 0 {
            return neg(errno.E_NOSYS)
        }
        let xe: u64 = at_enter1(state, me, a0, a1)
        if errno.is_error(xe) {
            return xe
        }
        let xr: u64 = do_execve(state, me, frame, a1, a2, a3)
        uio.set_atbase(state, me, 0)
        return xr
    }
    if number == SYS_WAIT4 {
        return do_wait4(state, me, a0, a1, a2)
    }
    if number == SYS_EXIT || number == SYS_EXIT_GROUP {
        if number == SYS_EXIT_GROUP {
            sched.kill_group(state, me, (a0 & 255) | sched.KILL_PLAIN)
        }
        async.abandon(state, me)
        // LC-001: a thread of a group that shares its descriptor table (CLONE_FILES) only lets go of it;
        // the sockets and the descriptors go with the LAST user (the leader may end before its threads).
        let last_use: bool = file.release_use(state, me)
        sock_close_all(state, me, last_use)
        if last_use {
            file.release_table(state, file.owner(state, me))
        }
        signal.exiting(state, me)
        clear_child_tid(state, me)
        locks_drop(state, me)
        pmon.flush(state, me)
        sched.exit_task(state, a0)
        return 0 // not reached
    }
    if number == SYS_OSUM_SPAWN {
        return do_spawn(state, me, a0, a1)
    }
    if number == SYS_OSUM_EXEC {
        return do_exec(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_EXECAS {
        return do_exec_as(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_SETENV {
        return do_setenv(state, me, a0, a1)
    }
    if number == SYS_OSUM_MOUNT {
        return do_mount(state, a0)
    }
    // ---------------------------------------------------- RUNDE K14
    // RUNDE INSTALL.
    if number == SYS_LINK {
        return do_link(state, me, a0, a1)
    }
    if number == SYS_SYNC {
        return do_sync(state, me)
    }
    if number == SYS_MOUNT {
        return do_vfs_mount(state, me, a0, a1, a2, a3)
    }
    if number == SYS_UMOUNT2 {
        return do_vfs_umount(state, me, a0)
    }
    if number == SYS_RENAME {
        let r: u64 = do_rename(state, me, a0, a1)
        if r == 0 {
            ev_in_rename(state, me, a0, a1)
        }
        return r
    }
    if number == SYS_OSUM_MNTSTAT {
        return do_mntstat(state, a0, a1)
    }
    // RUNDE K16.
    if number == SYS_OSUM_FTYPE {
        return do_ftype(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_FOPEN {
        return do_fopen(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_FLIST {
        return do_flist(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_FREG {
        return do_freg(state, me, a0, a1)
    }
    // ROUND K6.
    if number == SYS_CHDIR {
        return do_chdir(state, me, a0)
    }
    if number == SYS_FCHDIR {
        return do_fchdir(state, me, a0)
    }
    if number == SYS_OSUM_SYSINFO {
        return uio.sysinfo(state, a0)
    }
    if number == SYS_OSUM_PSTAT {
        return do_pstat(state, me, a0, a1)
    }
    if number == SYS_OSUM_KILL {
        if !kill_allowed(state, me, a0) {
            return neg(errno.E_PERM)
        }
        return uio.kill_pid(state, a0, a1)
    }
    // ------------------------------------------------------- ROUND K9
    if number == SYS_RT_SIGACTION {
        return signal.do_sigaction(state, me, a0, a1, a2)
    }
    if number == SYS_RT_SIGPROCMASK {
        return signal.do_sigprocmask(state, me, a0, a1, a2)
    }
    if number == SYS_RT_SIGRETURN {
        return signal.do_sigreturn(state, me, frame)
    }
    if number == SYS_RT_SIGPENDING {
        return signal.do_sigpending(state, me, a0)
    }
    if number == SYS_KILL {
        if !kill_allowed(state, me, a0) {
            return neg(errno.E_PERM)
        }
        return signal.do_kill(state, me, a0, a1)
    }
    if number == SYS_TGKILL {
        return signal.do_kill(state, me, a1, a2)
    }
    // RUNDE UNTERBAU: `tkill(tid, sig)` -- the call musl's `raise()` and `pthread_kill()` make. It was missing, so `raise(sig)` did
    // nothing (-ENOSYS, unnoticed) while `kill(getpid(), sig)` worked. Same function as `tgkill` without the group argument.
    if number == UB_TKILL {
        return signal.do_kill(state, me, a0, a1)
    }
    if number == UB_RT_SIGQUEUEINFO {
        if !kill_allowed(state, me, a0) {
            return neg(errno.E_PERM)
        }
        return signal.do_kill(state, me, a0, a1)
    }
    if number == UB_RT_TGSIGQUEUEINFO {
        return signal.do_kill(state, me, a1, a2)
    }
    if number == SYS_PAUSE {
        return signal.do_pause(state, me)
    }
    if number == SYS_ALARM {
        return signal.do_alarm(state, me, a0)
    }
    if number == SYS_SETPGID {
        return signal.do_setpgid(state, me, a0, a1)
    }
    if number == SYS_GETPGID {
        return signal.do_getpgid(state, me, a0)
    }
    if number == SYS_GETPGRP {
        return signal.do_getpgid(state, me, 0)
    }
    if number == SYS_SETSID {
        return signal.do_setsid(state, me)
    }
    if number == SYS_GETTID {
        return sched.tget(state, me, sched.T_PID)
    }
    if number == SYS_IOCTL {
        return do_ioctl(state, me, a0, a1, a2)
    }
    if number == SYS_CLOCK_GETTIME {
        return do_clock_gettime(state, me, a0, a1)
    }
    if number == SYS_CLOCK_SETTIME {
        return do_clock_settime(state, me, a0, a1)
    }
    if number == SYS_ADJTIMEX {
        return do_adjtimex(state, me, a0)
    }
    if number == SYS_OSUM_SETTZ {
        return do_settz(state, me, a0, a1)
    }
    if number == SYS_CLOCK_GETRES {
        return do_clock_getres(state, me, a0, a1)
    }
    if number == SYS_CLOCK_NANOSLEEP {
        return do_nanosleep(state, me, a2)
    }
    if number == SYS_GETTIMEOFDAY {
        return do_gettimeofday(state, me, a0)
    }
    if number == SYS_TIME {
        return do_time(state, me, a0)
    }
    if number == SYS_GETRANDOM {
        return do_getrandom(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_PTY {
        return do_openpty(state, me, a0)
    }
    if number == SYS_OSUM_TTYINFO {
        return tty.info(state, tty_of(state, me), a0)
    }
    if number == SYS_OSUM_SIGINFO {
        return do_siginfo(state, me, a0, a1)
    }
    if number == SYS_OSUM_TERMNEW {
        return do_termnew(state, me)
    }
    // RUNDE K12: die Gastmaschinen.
    if number >= SYS_VM_CREATE && number <= SYS_VM_VALUE {
        return vm_call(state, me, number, a0, a1)
    }
    if number >= SYS_OSUM_PWRGET && number <= SYS_OSUM_PWRSTR {
        return pwr_call(state, me, number, a0, a1, a2)
    }
    if number >= SYS_OSUM_DISPGET && number <= SYS_OSUM_DISPSTR {
        return gfx.sys_disp(state, me, number, a0, a1, a2)
    }
    // RUNDE I18N: die Tastaturbelegung.
    if number == SYS_OSUM_KBD {
        return kbd_call(state, a0, a1)
    }
    if number == SYS_OSUM_HOTKEY {
        return do_hotkey(state, a0)
    }
    if number >= SYS_OSUM_NETGET && number <= SYS_OSUM_CTRENTER {
        return net_call(state, me, number, a0, a1, a2)
    }
    if number >= SYS_OSUM_EBPFLOAD && number <= SYS_OSUM_EBPFPROG {
        return net_call(state, me, number, a0, a1, a2)
    }
    // AB-003: the origin of a process. Here in `dispatch` itself and NOT
    // in `net_call`: a number that lands in a block function without a
    // window above it is -ENOSYS (the trap the two comments above describe;
    // the first test run of AB-003 fell into it -- every caller was "gone").
    if number == SYS_OSUM_SETPRIO {
        return do_setprio(state, me, a0, a1)
    }
    if number == SYS_OSUM_ORIGIN {
        return do_origin(state, me, a0, a1, a2)
    }
    if number >= SYS_OSUM_TILEGET && number <= SYS_OSUM_TILEBIND {
        return gfx.sys_tile(state, me, number, a0, a1)
    }
    // ROUND POWERMON: the power accounting.
    if number == SYS_OSUM_PMON {
        return do_pmon(state, me, a0, a1, a2)
    }
    // RUNDE WERKZEUGE: die Kerne, einzeln.
    if number == SYS_OSUM_CPUSTAT {
        return do_cpustat(state, a0, a1)
    }
    if number == SYS_OSUM_DBG {
        return do_dbg(state, me, a0, a1, a2, a3, a4)
    }
    if number == SYS_OSUM_SHOT {
        return gfx.sys_shot(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_TIPP {
        return gfx.sys_tipp(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_BUS {
        return do_bus(state, me, a0, a1, a2, a3, a4)
    }
    // ------------------------------------------------ RUNDE PROTOKOLL
    if number == SYS_OSUM_KLOG {
        return do_klog(state, me, a0, a1, a2, a3)
    }
    if number == SYS_OSUM_KRACH {
        return do_krach(state, me, a0)
    }
    if number == SYS_OSUM_AUDGET {
        return do_audget(state, a0)
    }
    if number == SYS_OSUM_AUDSET {
        return do_audset(state, a0, a1)
    }
    if number == SYS_OSUM_AUDWRITE {
        return do_audwrite(state, me, a0, a1)
    }
    if number == SYS_OSUM_AUDOPEN {
        return do_audopen(state, me, a0)
    }
    if number == SYS_OSUM_AUDSEND || number == SYS_OSUM_AUDREAD {
        if number == SYS_OSUM_AUDREAD {
            return do_audread(state, me, a0, a1)
        }
        return do_audsend(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_LOCK {
        return do_session_lock(state, me, a0, a1)
    }
    // ------------------------------------------------------ RUNDE K13
    if is_k13(number) || (number >= WIG_BASE && number <= WIG_MAXNR)
        || (number >= AX_BASE && number <= AX_MAXNR) {
        return late_call(state, me, number, frame)
    }
    if number == SYS_OSUM_WECHSEL {
        return wechsel_call(state, a0, fget(frame, F_RSI),
            fget(frame, F_RDX))
    }
    if number == SYS_OSUM_CODEC {
        return codec_call(state, a0, fget(frame, F_RSI),
            fget(frame, F_RDX), fget(frame, F_R10))
    }
    if number >= USB_MINNR && number <= USB_MAXNR {
        return usb_call(state, number, a0)
    }
    return neg(errno.E_NOSYS)
}

// ================================================ RUNDE CODEC: 1970
const SYS_OSUM_CODEC: u64 = 1970
const CDC_FRAME: u64 = 0
const CDC_REJECT: u64 = 1
const CDC_SEEN: u64 = 2
const CDC_GET: u64 = 3
const CDC_RESET: u64 = 4
const CDG_FRAMES: u64 = 0
const CDG_REJECTS: u64 = 1
const CDG_LASTERR: u64 = 2
const CDG_W: u64 = 3
const CDG_H: u64 = 4
const CDG_PROFILE: u64 = 5
const CDG_MB: u64 = 6

fn codec_call(state: u64, was: u64, a1: u64, a2: u64, a3: u64) -> u64 {
    if was == CDC_FRAME {
        codecstat.cd_frame(state)
        return 0
    }
    if was == CDC_REJECT {
        codecstat.cd_reject(state, a1)
        return 0
    }
    if was == CDC_SEEN {
        codecstat.cd_seen(state, a1, a2, a3, 0)
        return 0
    }
    if was == CDC_RESET {
        codecstat.cd_reset(state)
        return 0
    }
    if was == CDC_GET {
        if a1 == CDG_FRAMES { return codecstat.cd_frames(state) }
        if a1 == CDG_REJECTS { return codecstat.cd_rejects(state) }
        if a1 == CDG_LASTERR { return codecstat.cd_lasterr(state) }
        if a1 == CDG_W { return codecstat.cd_w(state) }
        if a1 == CDG_H { return codecstat.cd_h(state) }
        if a1 == CDG_PROFILE { return codecstat.cd_profile(state) }
        if a1 == CDG_MB { return codecstat.cd_mb(state) }
        return neg(errno.E_INVAL)
    }
    return neg(errno.E_INVAL)
}

fn usb_call(state: u64, number: u64, a0: u64) -> u64 {
    if number == SYS_OSUM_USBSTAT {
        return usb.stat(state, a0)
    }
    if number == SYS_OSUM_USBPULL {
        usb.unplug_now(state)
        return usb.unplugs(state)
    }
    return neg(errno.E_NOSYS)
}

fn wechsel_call(state: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    if a0 == WX_COUNT {
        return wechsel.anzahl(state)
    }
    if a0 == WX_EVENTS {
        return wechsel.ereignisse(state)
    }
    if a0 == WX_KOMMT {
        return wechsel.angesteckt(state)
    }
    if a0 == WX_GEHT {
        return wechsel.abgezogen(state)
    }
    if a0 == WX_AUS {
        return wechsel.ausgeworfen(state)
    }
    if a1 >= wechsel.MAX_TRAEGER {
        return neg(errno.E_INVAL)
    }
    if a0 == WX_DEV {
        return wechsel.traeger_dev(state, a1)
    }
    if a0 == WX_MNT {
        return wechsel.traeger_mnt(state, a1)
    }
    if a0 == WX_BLOCKS {
        return wechsel.traeger_bloecke(state, a1)
    }
    if a0 == WX_PATHCH {
        let p: u64 = wechsel.traeger_pfad(state, a1)
        if p == 0 || a2 >= 16 {
            return 0
        }
        return kstate.get8(p + a2)
    }
    if a0 == WX_EJECT {
        return wechsel.auswerfen(state, a1)
    }
    return neg(errno.E_INVAL)
}

fn late_call(state: u64, me: u64, number: u64, frame: u64) -> u64 {
    let a0: u64 = fget(frame, F_RDI)
    let a1: u64 = fget(frame, F_RSI)
    let a2: u64 = fget(frame, F_RDX)
    let a3: u64 = fget(frame, F_R10)
    // ROUND A11Y-2: the tree, through the same seam as the WIG calls.
    if number >= AX_BASE && number <= AX_MAXNR {
        return gfx.sys_ax(state, me, number, a0, a1, a2)
    }
    if number >= WIG_BASE && number <= WIG_MAXNR {
        return gfx.sys_wig(state, me, number, a0, a1, a2, a3,
            fget(frame, F_R8))
    }
    return k13_call(state, me, number, a0, a1, a2, a3)
}

fn is_k13(number: u64) -> bool {
    if number == SYS_ACCESS || number == SYS_UMASK || number == SYS_REBOOT {
        return true
    }
    if number >= SYS_CHMOD && number <= SYS_LCHOWN {
        return true
    }
    if number >= SYS_GETUID && number <= SYS_GETEGID {
        return true
    }
    if number >= SYS_SETREUID && number <= SYS_GETRESGID {
        return true
    }
    if number == SYS_FCHOWNAT || number == SYS_FCHMODAT
        || number == SYS_FACCESSAT {
        return true
    }
    if number == SYS_SENDFILE || number == SYS_MEMBARRIER
        || number == SYS_FACCESSAT2 {
        return true
    }
    if number == SYS_GETGROUPS || number == SYS_SETGROUPS {
        return true
    }
    if number == SYS_OSUM_MUSTAT {
        return true
    }
    if number == SYS_OSUM_DISKUP {
        return true
    }
    return number == SYS_OSUM_USERINFO
}

fn k13_call(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64,
    a3: u64) -> u64 {
    if number == SYS_GETUID {
        return do_getid(state, me, sched.T_UID)
    }
    if number == SYS_GETEUID {
        return do_getid(state, me, sched.T_EUID)
    }
    if number == SYS_GETGID {
        return do_getid(state, me, sched.T_GID)
    }
    if number == SYS_GETEGID {
        return do_getid(state, me, sched.T_EGID)
    }
    if number == SYS_SETUID {
        return do_setuid(state, me, a0)
    }
    if number == SYS_SETGID {
        return do_setgid(state, me, a0)
    }
    if number == SYS_SETREUID {
        return do_setre(state, me, a0, a1, sched.T_UID, sched.T_EUID,
            sched.T_SUID)
    }
    if number == SYS_SETREGID {
        return do_setre(state, me, a0, a1, sched.T_GID, sched.T_EGID,
            sched.T_SGID)
    }
    if number == SYS_SETRESUID {
        return do_setres(state, me, a0, a1, a2, sched.T_UID, sched.T_EUID,
            sched.T_SUID)
    }
    if number == SYS_SETRESGID {
        return do_setres(state, me, a0, a1, a2, sched.T_GID, sched.T_EGID,
            sched.T_SGID)
    }
    if number == SYS_GETRESUID {
        return do_getres(state, me, a0, a1, a2, sched.T_UID, sched.T_EUID,
            sched.T_SUID)
    }
    if number == SYS_GETRESGID {
        return do_getres(state, me, a0, a1, a2, sched.T_GID, sched.T_EGID,
            sched.T_SGID)
    }
    if number == SYS_UMASK {
        return do_umask(state, me, a0)
    }
    if number == SYS_CHMOD {
        return do_chmod(state, me, a0, a1)
    }
    if number == SYS_FCHMOD {
        return do_fchmod(state, me, a0, a1)
    }
    if number == SYS_FCHMODAT {
        let e1: u64 = at_enter1(state, me, a0, a1)
        if errno.is_error(e1) {
            return e1
        }
        let r1: u64 = do_chmod(state, me, a1, a2)
        uio.set_atbase(state, me, 0)
        return r1
    }
    if number == SYS_CHOWN || number == SYS_LCHOWN {
        return do_chown(state, me, a0, a1, a2)
    }
    if number == SYS_FCHOWN {
        return do_fchown(state, me, a0, a1, a2)
    }
    if number == SYS_FCHOWNAT {
        let e2: u64 = at_enter1(state, me, a0, a1)
        if errno.is_error(e2) {
            return e2
        }
        let r2: u64 = do_chown(state, me, a1, a2, a3)
        uio.set_atbase(state, me, 0)
        return r2
    }
    if number == SYS_ACCESS {
        return do_access(state, me, a0, a1)
    }
    if number == SYS_FACCESSAT || number == SYS_FACCESSAT2 {
        let e3: u64 = at_enter1(state, me, a0, a1)
        if errno.is_error(e3) {
            return e3
        }
        let r3: u64 = do_access(state, me, a1, a2)
        uio.set_atbase(state, me, 0)
        return r3
    }
    if number == SYS_SENDFILE {
        return neg(errno.E_INVAL)
    }
    if number == SYS_MEMBARRIER {
        if a0 == 0 {
            return 0
        }
        return neg(errno.E_INVAL)
    }
    if number == SYS_REBOOT {
        return do_reboot(state, me, a0)
    }
    if number == SYS_OSUM_USERINFO {
        return do_userinfo(state, me, a0)
    }
    if number == SYS_OSUM_DISKUP {
        return do_diskup(state, me)
    }
    if number == SYS_GETGROUPS {
        return do_getgroups(state, me, a0, a1)
    }
    if number == SYS_SETGROUPS {
        return do_setgroups(state, me, a0, a1)
    }
    if number == SYS_OSUM_MUSTAT {
        return do_mustat(state, me, a0)
    }
    return neg(errno.E_NOSYS)
}

// --------------------------------------------------------- reading in

// One octet out of the address space of the process. The kernel does not
// switch to it -- it walks the tables and reads the frame through the
// identity mapping.
fn peek(state: u64, me: u64, addr: u64) -> u64 {
    let mmfl: u64 = unixsock.mm_lock(state)
    let phys: u64 = proc.translate(state, me, addr)
    if phys == 0 {
        unixsock.mm_unlock(state, mmfl)
        return 0
    }
    // ROUND K10: the SMAP window. The frame is reached through the
    // identity mapping, and for the pages of `.utext` that mapping
    // carries the user bit -- with CR4.SMAP a read of it out of ring 0
    // is a #PF unless AC is set. `guard.stac` is a no-op when the bit is
    // off, so this costs a compare on a machine without SMAP.
    guard.stac(state)
    let v: u64 = kstate.get8(phys)
    guard.clac(state)
    unixsock.mm_unlock(state, mmfl)
    return v
}

fn poke(state: u64, me: u64, addr: u64, v: u64) -> bool {
    let mmfl: u64 = unixsock.mm_lock(state)
    let phys: u64 = proc.translate(state, me, addr)
    if phys == 0 {
        unixsock.mm_unlock(state, mmfl)
        return false
    }
    guard.stac(state)
    kstate.set8(phys, v as u8)
    guard.clac(state)
    unixsock.mm_unlock(state, mmfl)
    return true
}

// Out of the kernel into ring 3, and the other way round. Page by page:
// `translate` is a walk of four tables, and doing it per octet is what
// made round 62's `read` the slowest thing in the system.
fn copy_out(state: u64, me: u64, dst: u64, src: u64, len: u64) -> bool {
    if !proc.user_ok(state, me, dst, len) {
        return false
    }
    var n: u64 = 0
    while n < len {
        // r721: translate + copy of ONE page under the MM lock (see `unixsock.mm_lock`): `munmap` on another core cannot free the frame in between
        let mmfl: u64 = unixsock.mm_lock(state)
        let phys: u64 = proc.translate(state, me, dst + n)
        if phys == 0 {
            unixsock.mm_unlock(state, mmfl)
            return false
        }
        var room: u64 = 4096 - ((dst + n) & 4095)
        if room > len - n {
            room = len - n
        }
        var k: u64 = 0
        guard.stac(state)
        // LA-9: whole words while source and destination are 8-aligned
        if (((phys + k) | (src + n + k)) & 7) == 0 {
            while k + 8 <= room {
                __mmio_write64((phys + k) as *mut u64, __mmio_read64((src + n + k) as *mut u64))
                k = k + 8
            }
        }
        while k < room {
            kstate.set8(phys + k, kstate.get8(src + n + k) as u8)
            k = k + 1
        }
        guard.clac(state)
        unixsock.mm_unlock(state, mmfl)
        n = n + room
    }
    return true
}

fn copy_in(state: u64, me: u64, dst: u64, src: u64, len: u64) -> bool {
    if !proc.user_ok(state, me, src, len) {
        return false
    }
    var n: u64 = 0
    while n < len {
        let mmfl: u64 = unixsock.mm_lock(state)
        let phys: u64 = proc.translate(state, me, src + n)
        if phys == 0 {
            unixsock.mm_unlock(state, mmfl)
            return false
        }
        var room: u64 = 4096 - ((src + n) & 4095)
        if room > len - n {
            room = len - n
        }
        var k: u64 = 0
        guard.stac(state)
        while k < room {
            kstate.set8(dst + n + k, kstate.get8(phys + k) as u8)
            k = k + 1
        }
        guard.clac(state)
        unixsock.mm_unlock(state, mmfl)
        n = n + room
    }
    return true
}

// A name out of ring 3 into the kernel's own buffer. Returns the length,
// or an error. Nothing is read that the process does not own.
fn fetch_name(state: u64, me: u64, addr: u64, dst: u64, max: u64) -> u64 {
    if addr == 0 {
        return neg(errno.E_FAULT)
    }
    if !proc.user_ok(state, me, addr, 1) {
        return neg(errno.E_FAULT)
    }
    var n: u64 = 0
    while n < max {
        if !proc.user_ok(state, me, addr + n, 1) {
            return neg(errno.E_FAULT)
        }
        let c: u64 = peek(state, me, addr + n)
        kstate.set8(dst + n, c as u8)
        if c == 0 {
            return n
        }
        n = n + 1
    }
    return neg(errno.E_NAMETOOLONG)
}

// Eight octets out of the caller's memory, one at a time. A pointer of
// ring 3 may straddle a page boundary, and `peek` is the only reader that
// checks every page it touches.
fn user_word(state: u64, me: u64, addr: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 8 {
        v = v | (peek(state, me, addr + i) << (i * 8))
        i = i + 1
    }
    return v
}

// ------------------------------------------------------- the descriptors

// The open file behind a descriptor, or MAX_OPEN. Everything below goes
// through this one function -- there is no second place that decides what
// a number in a register means.
fn of_of(state: u64, me: u64, fd: u64) -> u64 {
    return file.fd_of(state, me, fd)
}

fn writable(state: u64, of: u64) -> bool {
    let f: u64 = file.open_flags(state, of)
    if (f & 3) == O_WRONLY {
        return true
    }
    return (f & 3) == O_RDWR
}

fn readable(state: u64, of: u64) -> bool {
    return (file.open_flags(state, of) & 3) != O_WRONLY
}

// ------------------------------------------------------------- write

fn do_write(state: u64, me: u64, fd: u64, buf: u64, want: u64) -> u64 {
    var len: u64 = want
    if len > MAX_IO {
        len = MAX_IO
    }
    if !proc.user_ok(state, me, buf, len) {
        return neg(errno.E_FAULT)
    }
    let of: u64 = file.fd_check(state, me, fd, handle.R_WRITE)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    return write_of(state, me, of, buf, len)
}

//     er: treffetaskmgr: start bww=7=i5=3 n2ame= [bTerhmin=al5] ...
fn conout(state: u64, me: u64, t: u64, buf: u64, len: u64) -> u64 {
    // The terminal window of this tty was closed: swallow the output
    // instead of drawing into whatever window took over the slot.
    if term_gone(state, t) {
        return len
    }
    let z: u64 = serial.line_at(cpu.here(state))
    let bounce: u64 = blockb(state)
    if !copy_in(state, me, bounce, buf, len) {
        serial.line_clear(z)
        return neg(errno.E_FAULT)
    }
    serial.defer_on()
    let r: u64 = tty.write_out(state, t, bounce, len)
    serial.defer_off()
    serial.line_clear(z)
    return r
}

fn shm_io(state: u64, me: u64, of: u64, buf: u64, len: u64, wr: bool) -> u64 {
    let i: u64 = file.open_ino(state, of)
    let size: u64 = unixsock.shm_size(state, i)
    if wr && (unixsock.shm_seals(state, i) & 24) != 0 {
        return neg(errno.E_PERM) // F_SEAL_WRITE | F_SEAL_FUTURE_WRITE
    }
    var off: u64 = file.open_off(state, of)
    if off >= size {
        if wr && len != 0 {
            return neg(errno.E_NOSPC)
        }
        return 0
    }
    var want: u64 = len
    if want > size - off {
        want = size - off
    }
    var done: u64 = 0
    while done < want {
        let pg: u64 = off / 4096
        let po: u64 = off & 4095
        var chunk: u64 = 4096 - po
        if chunk > want - done {
            chunk = want - done
        }
        let fr: u64 = unixsock.shm_frame_demand(state, i, pg)
        if fr == 0 {
            if done != 0 {
                file.open_set_off(state, of, off)
                return done
            }
            return neg(errno.E_NOMEM)
        }
        let bounce: u64 = blockb(state)
        if wr {
            if !copy_in(state, me, bounce, buf + done, chunk) {
                return neg(errno.E_FAULT)
            }
            var k: u64 = 0
            while k < chunk {
                kstate.set8(fr + po + k, kstate.get8(bounce + k) as u8)
                k = k + 1
            }
        } else {
            var k: u64 = 0
            while k < chunk {
                kstate.set8(bounce + k, kstate.get8(fr + po + k) as u8)
                k = k + 1
            }
            if !copy_out(state, me, buf + done, bounce, chunk) {
                return neg(errno.E_FAULT)
            }
        }
        done = done + chunk
        off = off + chunk
    }
    file.open_set_off(state, of, off)
    return done
}

fn write_of(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_SHM {
        return shm_io(state, me, of, buf, len, true)
    }
    if ev_kind(kind) {
        return ev_write(state, me, of, buf, len)
    }
    if kind == file.K_CONOUT {
        return conout(state, me, tty_of(state, me), buf, len)
    }
    if kind == file.K_TTY {
        return conout(state, me, file.open_ino(state, of), buf, len)
    }
    if kind == file.K_PIPEW {
        return pipe_write(state, me, of, buf, len)
    }
    if kind == file.K_FB {
        return fb_write(state, me, of, buf, len)
    }
    if kind == file.K_SOCK {
        return sock_write(state, me, of, buf, len)
    }
    // RUNDE UNTERBAU: `write` on a local socket (it was -EBADF: only sendmsg worked, so a program that talks to its peer with plain
    // read/write -- most IPC code -- got nothing).
    if kind == file.K_USOCK {
        return usock_rw(state, me, of, buf, len, true)
    }
    if kind == file.K_NETLINK {
        return nl_send_of(state, me, of, buf, len)
    }
    if kind == file.K_VFILE {
        return vfs_write(state, me, of, buf, len)
    }
    if kind == file.K_VDIR {
        return neg(errno.E_ISDIR)
    }
    if kind != file.K_FILE {
        return neg(errno.E_BADF)
    }
    if !writable(state, of) {
        return neg(errno.E_BADF)
    }
    // Through the data area: the file system never sees an address of a
    // process.
    let bounce: u64 = blockb(state)
    if !copy_in(state, me, bounce, buf, len) {
        return neg(errno.E_FAULT)
    }
    let ino: u64 = file.open_ino(state, of)
    var off: u64 = file.open_off(state, of)
    if (file.open_flags(state, of) & O_APPEND) != 0 {
        off = fs.inode_size(state, ino)
    }
    let n: u64 = fs.write_at(state, ino, off, bounce, len)
    if n == 0 {
        if len != 0 {
            return neg(errno.E_NOSPC)
        }
    }
    io_count(state, me, sched.T_DISKW, n)
    file.open_set_off(state, of, off + n)
    return n
}

// -------------------------------------------------------------- read

// LA-9: a regular file is read in up to MAX_FREAD per call, in MAX_IO steps inside the call (one trap instead of 16)
const MAX_FREAD: u64 = 65536

fn do_read(state: u64, me: u64, fd: u64, buf: u64, want: u64) -> u64 {
    var len: u64 = want
    if len > MAX_FREAD {
        len = MAX_FREAD
    }
    if len > MAX_IO {
        if !proc.user_ok(state, me, buf, len) {
            return neg(errno.E_FAULT)
        }
        let of2: u64 = file.fd_check(state, me, fd, handle.R_READ)
        if of2 >= file.MAX_OPEN {
            return neg(errno.E_BADF)
        }
        if file.open_kind(state, of2) != file.K_FILE {
            return do_read_one(state, me, fd, buf, MAX_IO)
        }
        var got: u64 = 0
        while got < len {
            var step: u64 = len - got
            if step > MAX_IO {
                step = MAX_IO
            }
            let r: u64 = read_of(state, me, of2, buf + got, step)
            if r >= 0xFFFFFFFFFFFFF000 {
                if got == 0 {
                    return r
                }
                return got
            }
            got = got + r
            if r < step {
                return got
            }
        }
        return got
    }
    return do_read_one(state, me, fd, buf, len)
}

fn do_read_one(state: u64, me: u64, fd: u64, buf: u64, want: u64) -> u64 {
    var len: u64 = want
    if len > MAX_IO {
        len = MAX_IO
    }
    if !proc.user_ok(state, me, buf, len) {
        return neg(errno.E_FAULT)
    }
    let of: u64 = file.fd_check(state, me, fd, handle.R_READ)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    return read_of(state, me, of, buf, len)
}

fn read_of(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_SHM {
        return shm_io(state, me, of, buf, len, false)
    }
    if ev_kind(kind) {
        return ev_read(state, me, of, buf, len)
    }
    if kind == file.K_CONIN {
        return console_read(state, me, buf, len)
    }
    if kind == file.K_TTY {
        return tty_read(state, me, file.open_ino(state, of), buf, len)
    }
    if kind == file.K_PIPER {
        return pipe_read(state, me, of, buf, len)
    }
    if kind == file.K_FB {
        return fb_read(state, me, of, buf, len)
    }
    if kind == file.K_SOCK {
        return sock_read(state, me, of, buf, len)
    }
    if kind == file.K_USOCK {
        return usock_rw(state, me, of, buf, len, false)
    }
    if kind == file.K_NETLINK {
        return nl_recv_of(state, me, of, buf, len, 0, 0, 0)
    }
    if kind == file.K_DIR || kind == file.K_VDIR {
        return neg(errno.E_ISDIR)
    }
    // ROUNDE K14.
    if kind == file.K_VFILE {
        return vfs_read(state, me, of, buf, len)
    }
    if kind != file.K_FILE {
        return neg(errno.E_BADF)
    }
    if !readable(state, of) {
        return neg(errno.E_BADF)
    }
    let bounce: u64 = blockb(state)
    let ino: u64 = file.open_ino(state, of)
    let off: u64 = file.open_off(state, of)
    let n: u64 = fs.read_at(state, ino, off, bounce, len)
    if !copy_out(state, me, buf, bounce, n) {
        return neg(errno.E_FAULT)
    }
    io_count(state, me, sched.T_DISKR, n)
    file.open_set_off(state, of, off + n)
    return n
}

// ROUND K9 PUT A TERMINAL BETWEEN THE CONSOLE AND THE PROCESS.

fn tty_of(state: u64, me: u64) -> u64 {
    let t: u64 = sched.tget(state, me, sched.T_TTY)
    if t == 0 {
        return tty.console()
    }
    return t - 1
}

fn script_feed(state: u64, t: u64) -> u64 {
    var pos: u64 = kstate.get(state, kstate.CONSOLE_POS)
    let end: u64 = kstate.get(state, kstate.CONSOLE_LEN)
    var n: u64 = 0
    var going: bool = true
    while going {
        if pos >= end {
            going = false
        } else {
            let c: u64 = kstate.get8(state + kstate.CONSOLE_OFF + pos)
            pos = pos + 1
            n = n + 1
            tty.push(state, t, c)
            if c == 10 {
                going = false
            }
        }
    }
    kstate.set(state, kstate.CONSOLE_POS, pos)
    return n
}

fn tty_drain(state: u64, me: u64, t: u64, buf: u64, len: u64) -> u64 {
    var n: u64 = 0
    var going: bool = true
    while going {
        if n >= len {
            going = false
        } else {
            let c: u64 = tty.take(state, t)
            if c == 256 {
                going = false
            } else {
                if !poke(state, me, buf + n, c) {
                    return neg(errno.E_FAULT)
                }
                n = n + 1
                if c == 10 {
                    going = false
                }
            }
        }
    }
    return n
}

const KEY_IDLE: u64 = 400

fn foreground_ok(state: u64, me: u64, t: u64) -> bool {
    if tty.kind_of(state, t) == tty.K_PTY_SLAVE && sched.tget(state, me, sched.T_TTY) != t + 1 {
        return true
    }
    let grp: u64 = tty.pgrp(state, t)
    if grp == 0 {
        return true
    }
    if sched.tget(state, me, sched.T_PGID) == grp {
        return true
    }
    signal.send_task(state, me, signal.SIGTTIN)
    return false
}

fn console_read(state: u64, me: u64, buf: u64, len: u64) -> u64 {
    return tty_read(state, me, tty_of(state, me), buf, len)
}

fn tty_read(state: u64, me: u64, t: u64, buf: u64, len: u64) -> u64 {
    if !tty.valid(state, t) {
        return neg(errno.E_NOTTY)
    }
    // Window closed = end of input; the shell leaves with "bye".
    if term_gone(state, t) {
        return 0
    }
    if !foreground_ok(state, me, t) {
        return neg(errno.E_INTR)
    }
    if tty.kind_of(state, t) == tty.K_PTY_MASTER {
        let p: u64 = tty.peer_of(state, t)
        var n: u64 = 0
        var rounds: u64 = 0
        while n == 0 && rounds < BLOCK_ROUNDS {
            while n < len && tty.out_waiting(state, p) != 0 {
                let c: u64 = tty.out_take(state, p)
                if c == 256 {
                    n = n
                } else {
                    if !poke(state, me, buf + n, c) {
                        return neg(errno.E_FAULT)
                    }
                    n = n + 1
                }
            }
            if n != 0 {
                return n
            }
            if signal.interrupted(state, me) {
                return neg(errno.E_INTR)
            }
            sched.sleep_ticks(state, 1)
            rounds = rounds + 1
        }
        return n
    }
    if tty.waiting(state, t) == 0 && t == tty.console() {
        script_feed(state, t)
    }
    var n: u64 = tty_drain(state, me, t, buf, len)
    if n != 0 {
        return n
    }
    if pty_master_gone(state, t) {
        return 0
    }
    if t == tty.console() && kstate.mode_on(state, kstate.M_NOKBD) {
        return 0
    }
    let endlos: bool = (sercon.active(state) && t == tty.console())
        || (kstate.mode_on(state, kstate.M_WMDAUER) && t == tty.console())
        || term_win_of(t) != 0
    var idle: u64 = 0
    while idle < KEY_IDLE {
        if signal.interrupted(state, me) {
            return neg(errno.E_INTR)
        }
        sercon.poll(state)
        if tty.waiting(state, t) != 0 {
            return tty_drain(state, me, t, buf, len)
        }
        if term_gone(state, t) {
            return 0
        }
        sched.sleep_ticks(state, 1)
        if !endlos {
            idle = idle + 1
        }
    }
    return 0
}

const WM_CREATE: u64 = 2100 // (xy, wh, titel, art) -> Handle
const WM_FILL: u64 = 2101 // (h, xy, wh, farbe) -> 0
const WM_TEXT: u64 = 2102
const WM_EVENT: u64 = 2103 // (h, aus) -> 1 = eines geholt, 0 = keines
const WM_INFO: u64 = 2104 // (h, was) -> Zahl
const WM_FLUSH: u64 = 2105 // (h) -> 0
const WM_MOVE: u64 = 2106 // (h, xy) -> 0
const WM_CLOSE: u64 = 2107 // (h) -> 0
const WM_WRITE: u64 = 2108
// ------------------------------------------------- RUNDE DESKTOP
const WM_STATE: u64 = 2109 // (h, was, wert) -> 0, braucht R_MANAGE
const WM_LIST: u64 = 2110
const WM_ACT: u64 = 2111 // (fensternummer, was) -> 0
// ---------------------------------------- ADDENDUM TASKBAR: the strut
//
// WM_STRUT declares that the caller's own window occupies `size` pixels
// of screen edge `edge`; the server subtracts every such reservation
// from the screen and calls the rest the work area (kernel/wm.fi). It
// needs R_MANAGE like WM_MOVE, and beyond that the window must lie on
// layer L_DESK or L_TOP -- reserving a screen edge is what a panel
// does, not what an application does, and layer L_TOP already belongs
// to root alone.
const WM_STRUT: u64 = 2112 // (h, edge, size) -> 0, braucht R_MANAGE
// WM_SIZE resizes the caller's OWN window. Until this addendum a window
// had the size it was created with, for ever: `wm.resize_win` existed
// and only the server itself called it, from the resize grip. A taskbar
// that changes from a horizontal to a vertical bar needs it, and so
// does auto-hide, which slides the bar out to a two-pixel sliver and
// back. The buffer is NOT reallocated -- a window cannot grow past the
// buffer it was created with, and `wm.resize_win` refuses instead of
// lying.
const WM_SIZE: u64 = 2113 // (h, wh) -> 0, braucht R_MANAGE
const WE_RIGHT: u64 = 3
const WM_DECO: u64 = 2114 // (steckplatz, 0xRRGGBB) -> 0
const WM_FORM: u64 = 2115 // (steckplatz, wert) -> 0
const WM_APP: u64 = 2116 // (handle, name, laenge) -> 0

const WM_PLUG_REG: u64 = 2117 // (abi, name, maske) -> Platz
const WM_PLUG_UNREG: u64 = 2118 // () -> 0
const WM_PLUG_POLL: u64 = 2119
const WM_PLUG_SUB: u64 = 2120 // (maske) -> 0
const WM_PLUG_INFO: u64 = 2121 // (platz, feld) -> Zahl
const WM_PLUG_ACT: u64 = 2122 // (handlung, id, wert) -> 0
const WM_PLUG_KEY: u64 = 2123 // (taste, mods) -> 0
const WM_PLUG_BAR: u64 = 2124 // (text, laenge) -> 0
const WM_PLUG_BARGET: u64 = 2125
const WM_PLUG_GRANT: u64 = 2126

const WM_MINRECT: u64 = 2127 // (fensternummer, xy, wh) -> 0
// ============================================ ROUND ACTION-BUS-3 (AB-008b)
// THE FOREIGN-WINDOW LAYER: a program the action bus cannot talk to (a
// Linux GUI program through wayd, one day a Wine window) is steered by
// its WINDOW -- list, key, click, close, raise. Root only: the one caller
// is the broker, and only after the rights, the confirmation and the
// write-ahead log of the bus (docs/ACTION-BUS.md 7). Events go into the
// ring of THE TARGET WINDOW and nowhere else -- not the focus, not the
// terminal, not the lock screen, not a panel (sysgui.fwin_target).
const WM_FWIN: u64 = 2128 // (op, a, b, c) -> see FW_*
const FW_LIST: u64 = 0 // (slot, out) -> 1 used / 0 free; FW_BYTES record
const FW_KEY: u64 = 1 // (window id, key code) -> 0
const FW_CLICK: u64 = 2 // (window id, x | y << 16, button 1/2) -> 0
const FW_CLOSE: u64 = 3 // (window id) -> 0: the close box, as if clicked
const FW_RAISE: u64 = 4 // (window id) -> 0: show, raise, focus
const FW_BYTES: u64 = 160 // WL_* record + the two below
const FW_OWNER: u64 = 128 // pid that created the window
const FW_KIND: u64 = 136 // 0 = the app paints, 1 = terminal grid
// ============================================ ROUND ACTION-BUS-5 (AB-004)
// THE TRUSTED CONFIRMATION DIALOG. The broker asks the window server to
// show a question; the window server paints it over everything (no
// window can draw above it) and takes the answer from the REAL keyboard
// and mouse only -- WM_FWIN, the only way to type into a window from a
// program, puts events into a window's ring, and the dialog has none.
// Root only, like WM_FWIN: the one caller is the broker.
const WM_TRUST: u64 = 2129 // (op, no, a, b) -> see TR_*
const TR_ASK: u64 = 0 // (no, text, len) -> 0; E_EXHAUSTED while one is open
const TR_POLL: u64 = 1 // (no) -> 0 open, 1 yes, 2 no, 3 no such dialog
const TR_CANCEL: u64 = 2 // (no) -> 0: take it off the screen
// ---- COMPOSITOR S3 (docs/COMPOSITOR.md): shared window buffers and the window table page
// WM_CREATE takes a fifth argument: descriptor + 1 of a memfd made with MFD_FRAMES, 0 = none. The window then paints from that memfd.
const WM_SETBUF: u64 = 2140 // (h, fd) -> 0: from now on the window paints from this MFD_FRAMES memfd (after a resize the client attaches a new one)
const WM_DAMAGE: u64 = 2141 // (h, xy, wh) -> pixels named: the client painted this rectangle of its shared buffer (no copy)
const WM_TABLE: u64 = 2142 // () -> a read-only descriptor of the window table page (map it PROT_READ); see wm.fi `tab_publish`
const WM_BUFFD: u64 = 2143 // (window id) -> a read-only descriptor of a shared window's buffer, root only, not while locked
// ---- COMPOSITOR S5: the compositor in ring 3 takes the scan-out (root only; see wm.fi `cp_*`)
const WM_COMP: u64 = 2144 // (op, a, b) -> see CP_*
const CP_ATTACH: u64 = 0 // () -> 0: this task is THE compositor; the kernel hands every finished rectangle over instead of showing it
const CP_WAIT: u64 = 1 // (seen frame, ms) -> the newest frame number: sleeps until one newer than `seen` was handed over (wake driven, not a poll of ticks)
const CP_PRESENT: u64 = 2 // () -> pixels shown (0 = nothing waited): the card gets the waiting rectangle
const CP_PAGE: u64 = 3 // () -> a read-only descriptor of the compositor page (state words + the input copy ring)
const CP_DETACH: u64 = 4 // () -> 0: back to the kernel presenting itself
const CP_STAT: u64 = 5 // (k) -> a counter (tests): 0 attaches, 1 detaches, 2 misses, 3 shown by the compositor, 4 shown by the kernel, 5 handed over, 6 events, 7 events refused
const CP_LOG: u64 = 6 // (stride, 0) -> descriptor of the present-log page (stride > 0 switches the log on: sample every stride-th word); stride 0 switches it off and returns 0. Only the attached compositor.
const WM_MAXNR: u64 = 2144
// WM_INFO: 1 when the window paints from a shared buffer, else 0
const WI_SHARED: u64 = 30

