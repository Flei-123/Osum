const HND_CANCEL: u64 = 2205 // (token) -> 0
const HND_END: u64 = 2206
const HND_STATE: u64 = 2207
const HND_DUP: u64 = 2208
const HND_PASS: u64 = 2209
const HND_COUNT: u64 = 2210
const HND_OBJINFO: u64 = 2211
const HND_MAXNR: u64 = 2211

// ------------------------------------------- RUNDE ASYNC: 1980..1985
const AIO_BASE: u64 = 1980
const AIO_VERSION: u64 = 1980
const AIO_SUBMIT: u64 = 1981
const AIO_WAIT: u64 = 1982
const AIO_CANCEL: u64 = 1983
