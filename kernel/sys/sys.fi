fn wg_call(state: u64, me: u64, number: u64, a0: u64, a1: u64,
    a2: u64) -> u64 {
    if number == SYS_OSUM_WGGET {
        return sysnet.do_wgget(state, me, a0, a1, a2)
    }
    return sysnet.do_wgset(state, me, a0, a1, a2)
}

