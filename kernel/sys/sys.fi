fn blockb(state: u64) -> u64 {
    let cur: u64 = sched.current(state)
    if sched.tget(state, cur, sched.T_KIND) != sched.K_USER {
        return state + kstate.BLOCK_OFF
    }
    var k: u64 = sched.hier(state)
    if k >= kstate.MAX_CPUS {
        return state + kstate.BLOCK_OFF
    }
    return state + kstate.BLOCKK_OFF + k * 4096
}

fn wg_call(state: u64, me: u64, number: u64, a0: u64, a1: u64,
    a2: u64) -> u64 {
    if number == SYS_OSUM_WGGET {
        return do_wgget(state, me, a0, a1, a2)
    }
    return do_wgset(state, me, a0, a1, a2)
}

fn do_wgget(state: u64, me: u64, field: u64, ptr: u64, len: u64) -> u64 {
    if field == WG_READY {
        if wg.ready(state) {
            return 1
        }
        return 0
    }
    if !wg.ready(state) {
        return neg(errno.E_NODEV)
    }
    if field == WG_UP {
        if wg.up(state) {
            return 1
        }
        return 0
    }
    if field == WG_PEERS {
        return wg.peers(state)
    }
    if field == WG_HANDSHAKES {
        return wg.handshakes(state)
    }
    if field == WG_KILLED {
        return wg.killed_octets(state)
    }
    if field == WG_KILLARMED {
        if wg.kill_armed(state) {
            return 1
        }
        return 0
    }
    if field == WG_PORT {
        return wg.port(state)
    }
    if field == WG_ERR {
        return wg.last_error(state)
    }
    if field == WG_STAT {
        return wg.stat(state, ptr)
    }
    if field == WG_ESTAB {
        if wg.established(state, ptr) {
            return 1
        }
        return 0
    }
    if field == WG_PUBLIC {
        if len < 32 {
            return neg(errno.E_INVAL)
        }
        var key: [u8; 32] = [0 as u8; 32]
        if !wg.public_key(state, (&key[0]) as u64) {
            return neg(errno.E_NODEV)
        }
        if !copy_out(state, me, ptr, (&key[0]) as u64, 32) {
            return neg(errno.E_FAULT)
        }
        return 32
    }
    return neg(errno.E_INVAL)
}

fn do_wgset(state: u64, me: u64, field: u64, ptr: u64, n: u64) -> u64 {
    if sched.tget(state, me, sched.T_EUID) != 0 {
        return neg(errno.E_PERM)
    }
    if field == WS_INIT {
        if !wg.init(state) {
            return neg(errno.E_NODEV)
        }
        return 0
    }
    if !wg.ready(state) && field != WS_CLEAR {
        return neg(errno.E_NODEV)
    }
    if field == WS_CLEAR {
        wg.clear(state)
        return 0
    }
    if field == WS_PRIVATE || field == WS_PEER {
        var key: [u8; 32] = [0 as u8; 32]
        if !copy_in(state, me, (&key[0]) as u64, ptr, 32) {
            return neg(errno.E_FAULT)
        }
        if field == WS_PRIVATE {
            if !wg.set_private(state, (&key[0]) as u64) {
                return neg(errno.E_INVAL)
            }
            return 0
        }
        let idx: i64 = wg.add_peer(state, (&key[0]) as u64)
        if idx < 0 {
            return neg(errno.E_NOSPC)
        }
        return idx as u64
    }
    if field == WS_PSK {
        var arg: [u64; 1] = [0 as u64; 1]
        var key: [u8; 32] = [0 as u8; 32]
        if !copy_in(state, me, (&arg[0]) as u64, ptr, 8) {
            return neg(errno.E_FAULT)
        }
        if !copy_in(state, me, (&key[0]) as u64, ptr + 8, 32) {
            return neg(errno.E_FAULT)
        }
        if !wg.psk(state, arg[0], (&key[0]) as u64) {
            return neg(errno.E_INVAL)
        }
        return 0
    }
    if n > 9 {
        return neg(errno.E_INVAL)
    }
    var a: [u64; 9] = [0 as u64; 9]
    if n > 0 {
        if !copy_in(state, me, (&a[0]) as u64, ptr, n * 8) {
            return neg(errno.E_FAULT)
        }
    }
    if field == WS_ALLOW {
        if n < 3 || !wg.allow(state, a[0], a[1], a[2]) {
            return neg(errno.E_INVAL)
        }
        return 0
    }
    if field == WS_ENDPOINT {
        if n < 3 || !wg.endpoint(state, a[0], a[1], a[2]) {
            return neg(errno.E_INVAL)
        }
        return 0
    }
    if field == WS_KEEPALIVE {
        if n < 2 || !wg.keepalive(state, a[0], a[1]) {
            return neg(errno.E_INVAL)
        }
        return 0
    }
    if field == WS_ADDR {
        if n < 3 || !wg.set_addr(state, a[0], a[1], a[2]) {
            return neg(errno.E_INVAL)
        }
        return 0
    }
    if field == WS_UP {
        if n < 1 || !wg.set_up(state, a[0]) {
            return neg(errno.E_INVAL)
        }
        return 0
    }
    if field == WS_KILL {
        if n < 1 {
            return neg(errno.E_INVAL)
        }
        wg.arm_kill(state, a[0])
        return 0
    }
    if field == WS_AWG {
        if n < 9 || !wg.awg(state, a[0], a[1], a[2], a[3], a[4], a[5],
            a[6], a[7], a[8]) {
            return neg(errno.E_INVAL)
        }
        return 0
    }
    return neg(errno.E_INVAL)
}

