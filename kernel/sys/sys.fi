// ======================================================= ROUND NETMON
//
// WHO USED HOW MUCH. One number per call, the way `PSTAT` has answered
// about the task table since round K6 -- no buffer, no pointer into the
// kernel, nothing a program could be handed and misread.
//
//   NETMON(kind, index, field) -> number
//
//     kind 0  the scalars of the whole machine (index ignored)
//     kind 1  a task: the six counters, its pid, whether it is alive
//     kind 2  a socket: the live connection list `netstat` prints
//     kind 3  one octet of the program name of a task
//
// READING IS ALLOWED FOR ANYBODY, exactly as with NETVGET and for the
// same reason: a machine that will not tell the person which of their
// own programs is using the line is not protecting anybody.
const SYS_OSUM_NETMON: u64 = 1320

// kind 0 -- the machine.
const NM_ON: u64 = 0 // 1 = the counters are running
const NM_LOOKUPS: u64 = 1 // frames classified
const NM_HITS: u64 = 2 // frames placed on a process
const NM_MISSES: u64 = 3 // frames that went to the system bucket
const NM_SYSTX: u64 = 4 // octets of those, outbound
const NM_SYSRX: u64 = 5 // and inbound
const NM_TICKS: u64 = 6 // the tick counter, for rates
const NM_HZ: u64 = 7 // ticks per second
const NM_CARDTX: u64 = 8 // what the CARD counted, out
const NM_CARDRX: u64 = 9 // and in
const NM_NTASK: u64 = 10 // how many task slots there are
const NM_NSOCK: u64 = 11 // and socket slots
const NM_NPROG: u64 = 12 // and program slots

// kind 1 -- a task. 0..5 are `netmon.T_*` in that order.
const NT_PID: u64 = 6
const NT_ALIVE: u64 = 7
const NT_VIEW: u64 = 8 // the netview mode of round NETVIEW
const NT_STATE: u64 = 9

// kind 2 -- a socket. 0..11 are `netmon.S_*` in that order.
const NS_TCPSTATE: u64 = 12
const NS_AGE: u64 = 13 // ticks since the slot was taken

// kind 4 -- a PROGRAM. 0..5 are the same six counters, summed over every
// task that ever ran that program in this boot. This is the row the
// person actually reads: `wget` used this much, whether or not the wget
// that used it is still running.
const NP_USED: u64 = 6

// AND THE ONE CALL OF THIS ROUND THAT CHANGES SOMETHING.
//
//   NETMONROLL(program, field) -> what has been used since the last roll
//
// It hands out the difference and moves the watermark in the same
// breath, so that `/bin/netstat -w` can add it to today's line in
// `/var/net/usage` and nothing is counted twice or lost. ROOT ONLY, and
// that is not decoration: a program that could roll its own counters
// could empty them, and the history would then say it used nothing.
const SYS_OSUM_NETMONROLL: u64 = 1321

