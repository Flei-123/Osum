// AB-003 (docs/ACTION-BUS.md 5.2): the attested ORIGIN of a process.
//   ORIGIN(0, pid, buf)      -> length of the label of `pid` (0 = self)
//                               into buf (32 octets, zero-padded);
//                               0 = no label (the system / the user)
//   ORIGIN(1, label, len)    -> 0; mark MYSELF, only while unlabelled
// Rules in kernel/sched/origin.fi. 1990: the first free number above the
// 1980..1985 block of RUNDE ASYNC.
const SYS_OSUM_ORIGIN: u64 = 1990
