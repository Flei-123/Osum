// There is NO capture path in the kernel yet (the HDA/AC97 drivers drive only the output), so
// today it answers -ENODEV for everybody; the number is reserved so that the hub (lib/audio/hub.fi)
// and programs can already be written against it.
const SYS_OSUM_AUDREAD: u64 = 1855

