const SYS_OSUM_TERMNEW: u64 = 1103

// ROUND K8. THE SOCKET CALLS, and again Linux's numbers and Linux's
// shapes -- there is no `send` and no `recv` in the x86-64 table,
// because glibc turns both into `sendto`/`recvfrom` with a null address.
// Copying that means a Linux binary of stage 2 needs no translation, and
// it means `ping` and `wget` in `kernel/user/` are written the way they
// would be written anywhere else.
const SYS_SOCKET: u64 = 41
const SYS_CONNECT: u64 = 42
const SYS_ACCEPT: u64 = 43
const SYS_SENDTO: u64 = 44
const SYS_RECVFROM: u64 = 45
const SYS_SHUTDOWN: u64 = 48
const SYS_BIND: u64 = 49
const SYS_LISTEN: u64 = 50
const SYS_GETSOCKNAME: u64 = 51
const SYS_GETPEERNAME: u64 = 52
const SYS_SETSOCKOPT: u64 = 54
const SYS_GETSOCKOPT: u64 = 55
const SYS_ACCEPT4: u64 = 288
const SHUT_RD: u64 = 0

// The two marks of round 59, alive only during the excursion of `user.fi`.
const SYS_MARK: u64 = 1
const SYS_LEAVE: u64 = 2

// What Osum has and Linux has not. Far above the Linux table on purpose:
// a number that could one day BE a Linux call would be a trap for stage 2.
//
//   1000 spawn(program, argument) -- a process out of `uprog.fi`, the
//        programs that travel in the kernel image. There is no file
//        behind them, so no `execve` can start them.
//   1001 exec(path, argv, argc) -> pid -- the `posix_spawn` of round K1.
//        `fork` + `execve` do the same thing in two calls now and the
//        shell uses those; this one stays because it is one call, and a
//        system with 16 KiB of kernel stack per task has a use for that.
const SYS_OSUM_SPAWN: u64 = 1000
const SYS_OSUM_EXEC: u64 = 1001
// ROUND SESSUID: 1005 execas(path, argv, argc | mode << 16) -> pid.
//   mode 0  "start it for the session": a ROOT caller (taskbar, start
//           menu) while somebody is signed in gets a child that runs as
//           that person, not as root. Everybody else, and a machine with
//           no session, gets what `exec` gives (the caller's identity).
//   mode 1  "start it privileged, on purpose": only a caller whose
//           effective id is 0 may ask, else -EPERM. The child is
//           root like the caller; the line `execas: priv` is the trail.
const SYS_OSUM_EXECAS: u64 = 1005
const EXECAS_USER: u64 = 0
// ROUND K6. Three that Linux HAS NO NUMBER FOR, in the shape this
// kernel can answer them, and therefore above 1000 by the rule of
// round K4 -- round K6 itself had picked 44, 45 and 46, which are
// `semget`, `semop` and `shmdt` on Linux and would be a trap for the
// stage that runs a Linux binary.
//
//   1002 sysinfo(what) -> one number about the machine. Linux's 99
//        fills a struct with a different set of fields; this is not
//        that call and does not take its number.
//   1003 pstat(index, field) -> one field of one slot of the task
//        table. There is no `/proc` here, and `ps` may not hold a
//        pointer into the kernel.
//   1004 kill(pid, code). NOT Linux's 62: there are no signals in
//        this system, so the second argument is the exit code the
//        process is made to leave with, not a signal number. The day
//        signals exist, 62 becomes the real `kill` and this one goes.
// ---------------------------------------------- die native ABI (cap.fi)
const CAP_BASE: u64 = 2000
const CAP_VERSION: u64 = 2000
const CAP_READ: u64 = 2001
const CAP_WRITE: u64 = 2002
const CAP_CLOSE: u64 = 2003 // (h) -> 0
const CAP_DUP: u64 = 2004
const CAP_INSPECT: u64 = 2005
const CAP_TRANSFER: u64 = 2006
const CAP_COUNT: u64 = 2007
const CAP_MAXNR: u64 = 2007

