// -------------------------------------------------------------- pipes

// A reader waits for as long as somebody could still write. When the last
// writer is gone, an empty pipe is the END of the input -- 0, not an
// error, and that is what makes `cat` in a pipeline stop.
fn pipe_read(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    let p: u64 = file.open_ino(state, of)
    // r1215: wait on the poll wake sequence instead of "one tick": a writer (pipe_write) and the closing of a pipe end both
    // call sched.poll_kick, so the reader runs right after the data arrives, not at the next 10 ms tick. The sequence is read
    // BEFORE the look (no lost wake-up, see sched.poll_sleep). Same bound as before: BLOCK_ROUNDS ticks in total.
    let deadline: u64 = kstate.get(state, kstate.TICKS) + BLOCK_ROUNDS
    while true {
        let seen: u64 = sched.poll_seq(state)
        if file.pipe_bytes(state, p) != 0 {
            break
        }
        if file.pipe_writers(state, p) == 0 {
            return 0
        }
        // RUNDE UNTERBAU: O_NONBLOCK (pipe2, fcntl F_SETFL) -- an empty pipe with a writer is -EAGAIN at once, not after the wait
        if (file.open_flags(state, of) & UB_O_NONBLOCK) != 0 {
            return neg(errno.E_AGAIN)
        }
        if kstate.get(state, kstate.TICKS) >= deadline {
            return neg(errno.E_AGAIN)
        }
        sched.poll_sleep(state, seen, deadline)
    }
    var n: u64 = 0
    var going: bool = true
    while going {
        if n >= len {
            going = false
        } else {
            let c: u64 = file.pipe_get(state, p)
            if c > 255 {
                going = false
            } else {
                if !poke(state, me, buf + n, c) {
                    return neg(errno.E_FAULT)
                }
                n = n + 1
            }
        }
    }
    if n != 0 {
        sched.poll_kick(state)
    }
    return n
}

// A writer into a pipe nobody reads gets -EPIPE. On a full pipe it waits;
// what it could place before that is a SHORT write, which is what the
// interface has always allowed.
fn pipe_write(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    let p: u64 = file.open_ino(state, of)
    var n: u64 = 0
    var waited: u64 = 0
    var going: bool = true
    while going {
        if n >= len {
            going = false
        } else {
            if file.pipe_readers(state, p) == 0 {
                if n > 0 {
                    return n
                }
                return neg(errno.E_PIPE)
            }
            if file.pipe_room(state, p) == 0 {
                if waited >= BLOCK_ROUNDS || (file.open_flags(state, of) & UB_O_NONBLOCK) != 0 {
                    going = false
                } else {
                    waited = waited + 1
                    sched.sleep_ticks(state, 1)
                }
            } else {
                if !file.pipe_put(state, p, peek(state, me, buf + n)) {
                    going = false
                } else {
                    n = n + 1
                }
            }
        }
    }
    if n != 0 {
        sched.poll_kick(state)
    }
    if n == 0 {
        if len != 0 {
            return neg(errno.E_AGAIN)
        }
    }
    return n
}

fn do_pipe(state: u64, me: u64, out: u64) -> u64 {
    return do_pipe_flags(state, me, out, 0)
}

fn do_pipe_flags(state: u64, me: u64, out: u64, flags: u64) -> u64 {
    if !proc.user_ok(state, me, out, 8) {
        return neg(errno.E_FAULT)
    }
    let p: u64 = file.pipe_new(state)
    if p >= file.MAX_PIPES {
        return neg(errno.E_NFILE)
    }
    let rd: u64 = file.open_alloc(state, file.K_PIPER, p, 0)
    if rd >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let wr: u64 = file.open_alloc(state, file.K_PIPEW, p, O_WRONLY)
    if wr >= file.MAX_OPEN {
        unref_of(state, rd)
        return neg(errno.E_NFILE)
    }
    let fd0: u64 = file.fd_alloc(state, me, 0)
    if fd0 >= file.MAX_FD {
        unref_of(state, rd)
        unref_of(state, wr)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd0, rd)
    let fd1: u64 = file.fd_alloc(state, me, 0)
    if fd1 >= file.MAX_FD {
        file.fd_free(state, me, fd0)
        unref_of(state, rd)
        unref_of(state, wr)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd1, wr)
    if (flags & UB_O_CLOEXEC) != 0 {
        cx_put(state, me, fd0, true)
        cx_put(state, me, fd1, true)
    }
    if (flags & UB_O_NONBLOCK) != 0 {
        file.open_set_flags(state, rd, file.open_flags(state, rd) | UB_O_NONBLOCK)
        file.open_set_flags(state, wr, file.open_flags(state, wr) | UB_O_NONBLOCK)
    }
    // Two `int`s, four octets each -- the shape Linux writes.
    if !put32(state, me, out, fd0) {
        return neg(errno.E_FAULT)
    }
    if !put32(state, me, out + 4, fd1) {
        return neg(errno.E_FAULT)
    }
    return 0
}

fn put32(state: u64, me: u64, addr: u64, v: u64) -> bool {
    var i: u64 = 0
    while i < 4 {
        if !poke(state, me, addr + i, (v >> (i * 8)) & 255) {
            return false
        }
        i = i + 1
    }
    return true
}

fn get32(state: u64, me: u64, addr: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 4 {
        v = v | (peek(state, me, addr + i) << (i * 8))
        i = i + 1
    }
    return v
}

fn get16(state: u64, me: u64, addr: u64) -> u64 {
    return peek(state, me, addr) | (peek(state, me, addr + 1) << 8)
}

fn put16(state: u64, me: u64, addr: u64, v: u64) -> bool {
    if !poke(state, me, addr, v & 255) {
        return false
    }
    return poke(state, me, addr + 1, (v >> 8) & 255)
}

fn poll_sock(state: u64, of: u64) -> u64 {
    let si: u64 = file.open_ino(state, of)
    if si >= inet.SOCK_MAX {
        return POLLNVAL
    }
    var r: u64 = 0
    if inet.sock_error(state, si) != 0 {
        r = r | POLLERR
    }
    if inet.sock_acceptable(state, si) != 0 {
        return r | POLLIN
    }
    if inet.sock_readable(state, si) != 0 {
        r = r | POLLIN
    }
    if inet.sock_writable(state, si) != 0 {
        r = r | POLLOUT
    }
    if inet.sock_hup(state, si) != 0 {
        r = r | POLLHUP
    }
    return r
}

fn poll_ready(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return POLLNVAL
    }
    return poll_of(state, me, of)
}

// The readiness of one open file (epoll asks by open file, not by descriptor number).
fn poll_of(state: u64, me: u64, of: u64) -> u64 {
    let kind: u64 = file.open_kind(state, of)
    var r: u64 = 0
    if ev_kind(kind) {
        return ev_poll(state, me, of, kind)
    }
    if kind == file.K_PIPER {
        let p: u64 = file.open_ino(state, of)
        if file.pipe_bytes(state, p) != 0 {
            r = r | POLLIN
        }
        if file.pipe_writers(state, p) == 0 {
            r = r | POLLHUP
        }
        return r
    }
    if kind == file.K_PIPEW {
        let p: u64 = file.open_ino(state, of)
        if file.pipe_readers(state, p) == 0 {
            return POLLERR
        }
        if file.pipe_room(state, p) != 0 {
            r = r | POLLOUT
        }
        return r
    }
    if kind == file.K_SOCK {
        return poll_sock(state, of)
    }
    if kind == file.K_NETLINK {
        r = r | POLLOUT
        if netlink.nl_pending(file.open_off(state, of)) {
            r = r | POLLIN
        }
        return r
    }
    if kind == file.K_USOCK {
        let us: u64 = file.open_ino(state, of)
        if unixsock.waiting(state, us) != 0 {
            r = r | POLLIN
        }
        if unixsock.sock_state(state, us) == unixsock.S_LISTEN {
            if unixsock.pending(state, us) {
                r = r | POLLIN
            }
        } else if unixsock.peer_gone(state, us) {
            r = r | POLLHUP
        } else if unixsock.room(state,
            unixsock.sock_peer(state, us)) != 0 {
            r = r | POLLOUT
        }
        return r
    }
    if kind == file.K_TTY || kind == file.K_CONIN {
        var t: u64 = file.open_ino(state, of)
        if kind == file.K_CONIN {
            t = tty_of(state, me)
        }
        if !tty.valid(state, t) {
            return POLLNVAL
        }
        if tty.kind_of(state, t) == tty.K_PTY_MASTER {
            if tty.out_waiting(state, tty.peer_of(state, t)) != 0 {
                r = r | POLLIN
            }
        } else {
            if tty.waiting(state, t) != 0 {
                r = r | POLLIN
            }
            if pty_master_gone(state, t) {
                r = r | POLLHUP
            }
        }
        return r | POLLOUT
    }
    if kind == file.K_CONOUT || kind == file.K_FB {
        return POLLOUT
    }
    if kind == file.K_FREE {
        return POLLNVAL
    }
    return POLLIN | POLLOUT
}

fn poll_scan(state: u64, me: u64, fds: u64, nfds: u64, bad: *mut u64) -> u64 {
    var ready: u64 = 0
    var i: u64 = 0
    while i < nfds {
        let a: u64 = fds + i * 8
        let raw: u64 = get32(state, me, a)
        let ev: u64 = get16(state, me, a + 4)
        var re: u64 = 0
        if (raw & 0x80000000) == 0 {
            re = poll_ready(state, me, raw)
            re = re & (ev | POLLERR | POLLHUP | POLLNVAL)
        }
        if !put16(state, me, a + 6, re) {
            *bad = 1
            return ready
        }
        if re != 0 {
            ready = ready + 1
        }
        i = i + 1
    }
    return ready
}

fn do_poll(state: u64, me: u64, fds: u64, nfds: u64, tmo: u64) -> u64 {
    if nfds > POLL_MAX {
        return neg(errno.E_INVAL)
    }
    if nfds != 0 && !proc.user_ok(state, me, fds, nfds * 8) {
        return neg(errno.E_FAULT)
    }
    let forever: bool = tmo >= 0x80000000
    var ticks: u64 = 0
    if !forever && tmo != 0 {
        ticks = (tmo + 9) / 10 + 1
    }
    let deadline: u64 = kstate.get(state, kstate.TICKS) + ticks
    var bad: u64 = 0
    var going: bool = true
    while going {
        let seen: u64 = sched.poll_seq(state)
        let ready: u64 = poll_scan(state, me, fds, nfds, &bad)
        if bad != 0 {
            return neg(errno.E_FAULT)
        }
        if ready != 0 {
            return ready
        }
        if signal.interrupted(state, me) {
            return neg(errno.E_INTR)
        }
        if !forever && kstate.get(state, kstate.TICKS) >= deadline {
            return 0
        }
        var wake: u64 = deadline
        if forever {
            wake = sched.POLL_FOREVER
        }
        sched.poll_sleep(state, seen, wake)
    }
    return 0
}

// ------------------------------------------------------------ the files

// `open(path, flags, mode)`. The flags are Linux's: O_CREAT is 0o100, not
// a boolean second argument the way round 62 had it.
// ------------------------------------------------- ROUNDE K7: /dev/fb

fn is_devfb(state: u64, buf: u64, len: u64) -> bool {
    var name: [u8; 8] = "/dev/fb\0"
    if len != 7 {
        return false
    }
    var i: u64 = 0
    while i < 7 {
        if kstate.get8(buf + i) != (name[i as usize] as u64) {
            return false
        }
        i = i + 1
    }
    return true
}

// open("/proc/self/fd/N") of a memfd: Linux re-opens the same object (Firefox makes its read-only IPC shared memory this way:
// memfd_create, open(/proc/self/fd/N, O_RDONLY), map). Returns the object index, or USHM_MAX when the path is anything else.
fn procfd_shm(state: u64, me: u64, buf: u64, len: u64) -> u64 {
    var pre: [u8; 16] = "/proc/self/fd/\0\0"
    if len < 15 || len > 24 {
        return unixsock.USHM_MAX
    }
    var i: u64 = 0
    while i < 14 {
        if kstate.get8(buf + i) != (pre[i as usize] as u64) {
            return unixsock.USHM_MAX
        }
        i = i + 1
    }
    var n: u64 = 0
    while i < len {
        let c: u64 = kstate.get8(buf + i)
        if c < 48 || c > 57 {
            return unixsock.USHM_MAX
        }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    let of: u64 = of_of(state, me, n)
    if of >= file.MAX_OPEN || file.open_kind(state, of) != file.K_SHM {
        return unixsock.USHM_MAX
    }
    return file.open_ino(state, of)
}

fn open_devfb(state: u64, me: u64, flags: u64) -> u64 {
    if !gfx.fb_ready(state) {
        return neg(errno.E_NODEV)
    }
    if (flags & O_DIRECTORY) != 0 {
        return neg(errno.E_NOTDIR)
    }
    let of: u64 = file.open_alloc(state, file.K_FB, 0, flags)
    if of >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    return fd
}

fn fb_write(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    if !writable(state, of) {
        return neg(errno.E_BADF)
    }
    if !gfx.fb_ready(state) {
        return neg(errno.E_NODEV)
    }
    let off: u64 = file.open_off(state, of)
    if off >= gfx.fb_bytes(state) {
        return 0
    }
    var n: u64 = len
    if n > MAX_IO {
        n = MAX_IO
    }
    let bounce: u64 = blockb(state)
    if !copy_in(state, me, bounce, buf, n) {
        return neg(errno.E_FAULT)
    }
    let k: u64 = gfx.fb_write_bytes(state, off, bounce, n)
    file.open_set_off(state, of, off + k)
    return k
}

fn fb_read(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    if !readable(state, of) {
        return neg(errno.E_BADF)
    }
    if !gfx.fb_ready(state) {
        return neg(errno.E_NODEV)
    }
    let off: u64 = file.open_off(state, of)
    let bounce: u64 = blockb(state)
    let k: u64 = gfx.fb_read_bytes(state, off, bounce, len)
    if !copy_out(state, me, buf, bounce, k) {
        return neg(errno.E_FAULT)
    }
    file.open_set_off(state, of, off + k)
    return k
}

fn want_of(flags: u64) -> u64 {
    var want: u64 = perm.R_READ
    if (flags & 3) == 1 {
        want = perm.R_WRITE
    }
    if (flags & 3) == 2 {
        want = perm.R_READ | perm.R_WRITE
    }
    if (flags & O_TRUNC) != 0 {
        want = want | perm.R_WRITE
    }
    return want
}

fn dir_allowed(state: u64, me: u64, path: u64, ino: u64) -> bool {
    if ino == fs.root(state) {
        return true
    }
    let dir: u64 = fs.parent_ino(state, path)
    if dir == 0 {
        return true
    }
    var dwant: u64 = perm.R_EXEC
    if ino == 0 {
        dwant = perm.R_EXEC | perm.R_WRITE // anlegen
    }
    return perm.may(state, me, dir, dwant)
}

// =========================================== RUNDE K14: lesen, schreiben
fn mnt_gone(state: u64, m: u64) -> bool {
    if m >= vfs.MAX_MNT || !mnt.used(state, m) {
        return false
    }
    let dev: u64 = mnt.dev(state, m)
    if !blk.removable(dev) {
        return false
    }
    return !blk.present_on(state, dev)
}

fn vfs_read(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    if !readable(state, of) {
        return neg(errno.E_BADF)
    }
    let m: u64 = file.open_mnt(state, of)
    if mnt_gone(state, m) {
        return neg(errno.E_NODEV)
    }
    let node: u64 = file.open_ino(state, of)
    let off: u64 = file.open_off(state, of)
    let bounce: u64 = blockb(state)
    var want: u64 = len
    if want > kstate.BLOCK_MAX {
        want = kstate.BLOCK_MAX
    }
    let n: u64 = vfs.v_read(state, m, node, off, bounce, want)
    if !copy_out(state, me, buf, bounce, n) {
        return neg(errno.E_FAULT)
    }
    io_count(state, me, sched.T_DISKR, n)
    file.open_set_off(state, of, off + n)
    return n
}

fn vfs_write(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    if !writable(state, of) {
        return neg(errno.E_BADF)
    }
    let m: u64 = file.open_mnt(state, of)
    if mnt_gone(state, m) {
        return neg(errno.E_NODEV)
    }
    let node: u64 = file.open_ino(state, of)
    var off: u64 = file.open_off(state, of)
    if (file.open_flags(state, of) & O_APPEND) != 0 {
        off = vfs.v_attr(state, m, node, vfsops.A_SIZE)
    }
    let bounce: u64 = blockb(state)
    var want: u64 = len
    if want > kstate.BLOCK_MAX {
        want = kstate.BLOCK_MAX
    }
    if !copy_in(state, me, bounce, buf, want) {
        return neg(errno.E_FAULT)
    }
    let n: u64 = vfs.v_write(state, m, node, off, bounce, want)
    if errno.is_error(n) {
        return n
    }
    if n == 0 && want != 0 {
        return neg(errno.E_NOSPC)
    }
    io_count(state, me, sched.T_DISKW, n)
    file.open_set_off(state, of, off + n)
    return n
}

// ================================================== RUNDE K14: oeffnen
fn vfs_may(state: u64, me: u64, m: u64, node: u64, want: u64) -> bool {
    kstate.add(state, kstate.MU_OFF + kstate.MU_NODECHK, 1)
    let mode: u64 = vfs.v_attr(state, m, node, vfsops.A_MODE)
    let owner: u64 = vfs.v_attr(state, m, node, vfsops.A_UID)
    let group: u64 = vfs.v_attr(state, m, node, vfsops.A_GID)
    let ist_dir: bool = vfs.v_attr(state, m, node, vfsops.A_TYPE)
        == vfsops.N_DIR
    return perm.may_attr(state, me, mode, owner, group, want,
        perm.euid(state, me), perm.egid(state, me), ist_dir)
}

fn vfs_on_create(state: u64, me: u64, m: u64, node: u64, mode: u64) {
    if node == 0 {
        return
    }
    if vfs.type_of(state, m) != vfsops.FS_OFS {
        return
    }
    perm.on_create(state, me, node, mode)
}

// open("/dev/shm/NAME"): a descriptor on the named paged shm object (like memfd, but the object outlives it by the name's reference)
fn open_devshm(state: u64, me: u64, i: u64, flags: u64) -> u64 {
    unixsock.shm_ref(state, i)
    let of: u64 = file.open_alloc(state, file.K_SHM, i, flags)
    if of >= file.MAX_OPEN {
        unixsock.shm_unref(state, i)
        return neg(errno.E_NFILE)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    if (flags & O_TRUNC) != 0 && (flags & 3) != 0 {
        do_ftruncate(state, me, fd, 0)
    }
    return fd
}

fn open_vfs(state: u64, me: u64, m: u64, path: u64, flags: u64) -> u64 {
    if mnt_gone(state, m) {
        return neg(errno.E_NODEV)
    }
    var node: u64 = vfs.node_for(state, m, path)
    if node == 0 {
        if (flags & O_CREAT) == 0 {
            return neg(errno.E_NOENT)
        }
        if !vfs.can(state, m, vfsops.OP_CREATE) {
            if vfs.rdonly(state, m) {
                return neg(errno.E_ROFS)
            }
            return neg(errno.E_PERM)
        }
        node = vfs.v_create(state, m, path, vfsops.N_FILE)
        if node == 0 {
            if vfs.type_of(state, m) == vfsops.FS_DEV && !devfs.full_path_in_shm(path) {
                return neg(errno.E_PERM)
            }
            return neg(errno.E_NOSPC)
        }
        vfs_on_create(state, me, m, node, 438)
    } else {
        if (flags & O_CREAT) != 0 && (flags & O_EXCL) != 0 {
            return neg(errno.E_EXIST)
        }
    }
    // ==================================== RUNDE MULTIUSER: DAS TOR
    if !vfs_may(state, me, m, node, want_of(flags)) {
        return neg(errno.E_ACCES)
    }
    let art: u64 = vfs.v_attr(state, m, node, vfsops.A_TYPE)
    if vfs.type_of(state, m) == vfsops.FS_DEV {
        if devfs.is_fb(node) {
            return open_devfb(state, me, flags)
        }
        if devfs.is_tty(node) {
            return open_devtty(state, me, flags)
        }
        // ROUND FOOT-1 (PTY ABI): /dev/ptmx = a new pair, the master; /dev/pts/N = the slave of pair N
        if devfs.is_ptmx(node) {
            return open_ptmx(state, me, flags)
        }
        if devfs.pts_slot(node) < tty.MAX_TTY {
            return open_pts(state, me, devfs.pts_slot(node), flags)
        }
        if devfs.shm_slot(node) < unixsock.USHM_PAGED {
            return open_devshm(state, me, devfs.shm_slot(node), flags)
        }
    }
    var kind: u64 = file.K_VFILE
    if art == vfsops.N_DIR {
        if (flags & 3) != 0 {
            return neg(errno.E_ISDIR)
        }
        kind = file.K_VDIR
    } else {
        if (flags & O_DIRECTORY) != 0 {
            return neg(errno.E_NOTDIR)
        }
        if (flags & O_TRUNC) != 0 {
            let r: u64 = vfs.v_trunc(state, m, node)
            if r != 0 {
                return neg(r)
            }
        }
    }
    let of: u64 = file.open_alloc(state, kind, node, flags)
    if of >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    file.open_set_mnt(state, of, m)
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    if kind == file.K_VDIR {
        dirpath_remember(state, me, of, path)
    }
    mnt.open_inc(state, m)
    let ot: u64 = vfs.type_of(state, m)
    if ot == vfsops.FS_EXT4 {
        ext4.node_hold(state, node)
    }
    if ot == vfsops.FS_NTFS {
        ntfs.node_hold(state, node)
    }
    if ot == vfsops.FS_EXFAT {
        exfat.node_hold(state, node)
    }
    return fd
}

fn open_devtty(state: u64, me: u64, flags: u64) -> u64 {
    let t: u64 = tty_of(state, me)
    if !tty.valid(state, t) {
        return neg(errno.E_NODEV)
    }
    let of: u64 = file.open_alloc(state, file.K_TTY, t, flags)
    if of >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    return fd
}

fn do_open(state: u64, me: u64, name: u64, flags: u64) -> u64 {
    return do_open_mode(state, me, name, flags, 0)
}

fn do_open_mode(state: u64, me: u64, name: u64, flags: u64, mode: u64) -> u64 {
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if len == 0 {
        return neg(errno.E_NOENT)
    }
    return open_named(state, me, buf, len, flags, mode)
}

fn create_mode(mode: u64) -> u64 {
    if (mode & 4095) == 0 {
        return 438
    }
    return mode & 4095
}

fn open_named(state: u64, me: u64, buf: u64, len: u64, flags: u64, mode: u64) -> u64 {
    if is_devfb(state, buf, len) {
        return open_devfb(state, me, flags)
    }
    let psh: u64 = procfd_shm(state, me, buf, len)
    if psh < unixsock.USHM_MAX {
        return open_devshm(state, me, psh, flags)
    }
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if ((flags & 3) != 0 || (flags & O_CREAT) != 0 || (flags & O_TRUNC) != 0) && !appfs.write_ok(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    // ============================================= RUNDE K14: die Weiche
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                return open_vfs(state, me, m, buf, flags)
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    // ================================================== RUNDE K13
    var ino: u64 = fs.path(state, buf)
    if !dir_allowed(state, me, buf, ino) {
        return neg(errno.E_ACCES)
    }
    if ino == 0 {
        if (flags & O_CREAT) == 0 {
            return neg(errno.E_NOENT)
        }
        ino = fs.create_path(state, buf, fs.T_FILE)
        if ino == 0 {
            // parent directory missing: ENOENT, not ENOSPC (git: open objects/xx/tmp, expect ENOENT, mkdir, retry)
            if fs.parent_ino(state, buf) == 0 {
                return neg(errno.E_NOENT)
            }
            return neg(errno.E_NOSPC)
        }
        perm.on_create(state, me, ino, create_mode(mode))
    } else {
        if (flags & O_CREAT) != 0 {
            if (flags & O_EXCL) != 0 {
                return neg(errno.E_EXIST)
            }
        }
        if !perm.may(state, me, ino, want_of(flags)) {
            return neg(errno.E_ACCES)
        }
    }
    var kind: u64 = file.K_FILE
    if fs.inode_type(state, ino) == fs.T_DIR {
        if (flags & 3) != 0 {
            return neg(errno.E_ISDIR)
        }
        kind = file.K_DIR
    } else {
        if (flags & O_DIRECTORY) != 0 {
            return neg(errno.E_NOTDIR)
        }
        if (flags & O_TRUNC) != 0 {
            fs.file_truncate(state, ino)
        }
    }
    let of: u64 = file.open_alloc(state, kind, ino, flags)
    if of >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        unref_of(state, of)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    if kind == file.K_DIR {
        dirpath_remember(state, me, of, buf)
    }
    fs.touch_atime(state, ino)
    return fd
}

fn do_close(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    file.fd_free(state, me, fd)
    unref_of(state, of)
    return 0
}

fn do_dup(state: u64, me: u64, fd: u64) -> u64 {
    return do_dup_min(state, me, fd, 0)
}

// r727: `fcntl(F_DUPFD, min)` hands out the lowest free descriptor >= min (EINVAL when min is out of range).
fn do_dup_min(state: u64, me: u64, fd: u64, min: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if min >= file.MAX_FD {
        return neg(errno.E_INVAL)
    }
    let to: u64 = file.fd_alloc(state, me, min)
    if to >= file.MAX_FD {
        return neg(errno.E_MFILE)
    }
    file.open_ref(state, of)
    file.fd_set(state, me, to, of)
    return to
}

// `dup2(from, to)` -- what a shell does between `fork` and `execve` when
// it points the output of a program somewhere else. The two descriptors
// are ONE open file afterwards, with one position, which is the whole
// reason the open file table of round K4 exists.
fn do_dup2(state: u64, me: u64, from: u64, to: u64) -> u64 {
    let of: u64 = of_of(state, me, from)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if to >= file.MAX_FD {
        return neg(errno.E_BADF)
    }
    if from == to {
        return to
    }
    let old: u64 = of_of(state, me, to)
    if old < file.MAX_OPEN {
        file.fd_free(state, me, to)
        unref_of(state, old)
    }
    file.open_ref(state, of)
    file.fd_set(state, me, to, of)
    return to
}

fn do_lseek(state: u64, me: u64, fd: u64, off: u64, whence: u64) -> u64 {
    let of: u64 = file.fd_check(state, me, fd, handle.R_SEEK)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_PIPER || kind == file.K_PIPEW {
        return neg(errno.E_SPIPE)
    }
    if kind == file.K_CONIN || kind == file.K_CONOUT {
        return neg(errno.E_SPIPE)
    }
    var base: u64 = 0
    if whence == SEEK_CUR {
        base = file.open_off(state, of)
    } else {
        if whence == SEEK_END {
            if kind == file.K_FB {
                base = gfx.fb_bytes(state)
            } else if kind == file.K_VFILE || kind == file.K_VDIR {
                base = vfs.v_attr(state, file.open_mnt(state, of),
                    file.open_ino(state, of), vfsops.A_SIZE)
            } else {
                base = fs.inode_size(state, file.open_ino(state, of))
            }
        } else {
            if whence != SEEK_SET {
                return neg(errno.E_INVAL)
            }
        }
    }
    // `off` is an i64 in a u64 register: a negative one is a big number,
    // and adding it is the wraparound `+%` says out loud. What must not
    // happen is a position that ends up before the start of the file.
    let pos: u64 = base +% off
    if (pos >> 63) != 0 {
        return neg(errno.E_INVAL)
    }
    if (off >> 63) != 0 {
        if pos > base {
            return neg(errno.E_INVAL)
        }
    }
    file.open_set_off(state, of, pos)
    return pos
}

fn do_unlink(state: u64, me: u64, name: u64) -> u64 {
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if !perm.walk_w(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                let node: u64 = vfs.node_for(state, m, buf)
                if node == 0 {
                    return neg(errno.E_NOENT)
                }
                if vfs.v_attr(state, m, node, vfsops.A_TYPE)
                    == vfsops.N_DIR {
                    return neg(errno.E_ISDIR)
                }
                let r: u64 = vfs.v_unlink(state, m, buf)
                if r != 0 {
                    return neg(r)
                }
                return 0
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let ino: u64 = fs.path(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    if fs.inode_type(state, ino) == fs.T_DIR {
        return neg(errno.E_ISDIR)
    }
    let dir: u64 = fs.parent_ino(state, buf)
    if dir != 0 {
        if !perm.may(state, me, dir, perm.R_WRITE | perm.R_EXEC) {
            return neg(errno.E_ACCES)
        }
    }
    if !fs.unlink_path(state, buf) {
        return neg(errno.E_NOENT)
    }
    return 0
}

// ================================================== RUNDE ALLTAG: rmdir
fn do_rmdir(state: u64, me: u64, name: u64) -> u64 {
    let buf: u64 = state + kstate.NAME_OFF
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if !perm.walk_w(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                let node: u64 = vfs.node_for(state, m, buf)
                if node == 0 {
                    return neg(errno.E_NOENT)
                }
                if vfs.v_attr(state, m, node, vfsops.A_TYPE)
                    != vfsops.N_DIR {
                    return neg(errno.E_NOTDIR)
                }
                let r: u64 = vfs.v_unlink(state, m, buf)
                if r != 0 {
                    return neg(r)
                }
                return 0
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let ino: u64 = fs.path(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    if fs.inode_type(state, ino) != fs.T_DIR {
        return neg(errno.E_NOTDIR)
    }
    let dir: u64 = fs.parent_ino(state, buf)
    if dir != 0 {
        if !perm.may(state, me, dir, perm.R_WRITE | perm.R_EXEC) {
            return neg(errno.E_ACCES)
        }
    }
    if !fs.unlink_path(state, buf) {
        return neg(errno.E_NOTEMPTY)
    }
    return 0
}

fn dir_create_mode(mode: u64) -> u64 {
    if (mode & 4095) == 0 {
        return 511
    }
    return mode & 4095
}

fn do_mkdir_mode(state: u64, me: u64, name: u64, mode: u64) -> u64 {
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if !perm.walk_w(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                if vfs.node_for(state, m, buf) != 0 {
                    return neg(errno.E_EXIST)
                }
                if !vfs.can(state, m, vfsops.OP_CREATE) {
                    if vfs.rdonly(state, m) {
                        return neg(errno.E_ROFS)
                    }
                    return neg(errno.E_PERM)
                }
                let created: u64 = vfs.v_create(state, m, buf,
                    vfsops.N_DIR)
                if created == 0 {
                    return neg(errno.E_NOSPC)
                }
                vfs_on_create(state, me, m, created, dir_create_mode(mode))
                return 0
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if fs.path(state, buf) != 0 {
        return neg(errno.E_EXIST)
    }
    let dir: u64 = fs.parent_ino(state, buf)
    if dir != 0 {
        if !perm.may(state, me, dir, perm.R_WRITE | perm.R_EXEC) {
            return neg(errno.E_ACCES)
        }
    }
    let made: u64 = fs.create_path(state, buf, fs.T_DIR)
    if made == 0 {
        if dir == 0 {
            return neg(errno.E_NOENT) // mkdir -p / git rely on ENOENT for a missing parent
        }
        return neg(errno.E_NOSPC)
    }
    perm.on_create(state, me, made, dir_create_mode(mode))
    return 0
}

// ------------------------------------------------------------- stat

// `struct stat` as x86-64 Linux lays it out, filled in the data area and
// copied over in one go.
fn fill_stat(state: u64, ino: u64) -> bool {
    let s: u64 = blockb(state) + 2048
    var i: u64 = 0
    while i < STAT_BYTES {
        kstate.set8(s + i, 0 as u8)
        i = i + 1
    }
    let kind: u64 = fs.inode_type(state, ino)
    var mode: u64 = S_IFREG | fs.inode_mode(state, ino)
    if kind == fs.T_DIR {
        mode = S_IFDIR | fs.inode_mode(state, ino)
    }
    if kind == fs.T_LINK {
        mode = S_IFLNK | 511
    }
    let size: u64 = fs.inode_size(state, ino)
    let uid: u64 = fs.inode_uid(state, ino)
    let gid: u64 = fs.inode_gid(state, ino)
    statsane.check(state, ino, uid, gid, size)
    __mmio_write64((s + ST_DEV) as *mut u64, 1)
    __mmio_write64((s + ST_INO) as *mut u64, ino)
    __mmio_write64((s + ST_NLINK) as *mut u64, 1)
    __mmio_write32((s + ST_MODE) as *mut u32, mode as u32)
    __mmio_write32((s + ST_UID) as *mut u32, statsane.id32(state, uid) as u32)
    __mmio_write32((s + ST_GID) as *mut u32, statsane.id32(state, gid) as u32)
    __mmio_write64((s + ST_RDEV) as *mut u64, 0)
    __mmio_write64((s + ST_SIZE) as *mut u64, size)
    __mmio_write64((s + ST_BLKSIZE) as *mut u64, 512)
    __mmio_write64((s + ST_BLOCKS) as *mut u64, statsane.blocks512(state, size))
    __mmio_write64((s + ST_MTIME) as *mut u64, fs.inode_mtime(state, ino))
    __mmio_write64((s + ST_CTIME) as *mut u64, fs.inode_ctime(state, ino))
    __mmio_write64((s + ST_ATIME) as *mut u64, fs.inode_atime(state, ino))
    return true
}

fn stat_out(state: u64, me: u64, out: u64) -> u64 {
    if !copy_out(state, me, out, blockb(state) + 2048,
        STAT_BYTES) {
        return neg(errno.E_FAULT)
    }
    return 0
}

fn fill_vstat(state: u64, m: u64, node: u64) -> bool {
    let s: u64 = blockb(state) + 2048
    var i: u64 = 0
    while i < STAT_BYTES {
        kstate.set8(s + i, 0 as u8)
        i = i + 1
    }
    let art: u64 = vfs.v_attr(state, m, node, vfsops.A_TYPE)
    let size: u64 = vfs.v_attr(state, m, node, vfsops.A_SIZE)
    var mode: u64 = vfs.v_attr(state, m, node, vfsops.A_MODE)
    if art == vfsops.N_DIR {
        mode = mode | S_IFDIR
    } else if art == vfsops.N_CHR {
        mode = mode | S_IFCHR
    } else if art == vfsops.N_BLK {
        mode = mode | S_IFBLK
    } else if art == vfsops.N_LNK {
        mode = mode | S_IFLNK
    } else {
        mode = mode | S_IFREG
    }
    let bs: u64 = vfs.v_attr(state, m, node, vfsops.A_BLKSIZE)
    __mmio_write64((s + ST_DEV) as *mut u64, m + 1)
    __mmio_write64((s + ST_INO) as *mut u64, node)
    __mmio_write64((s + ST_NLINK) as *mut u64,
        vfs.v_attr(state, m, node, vfsops.A_NLINK))
    __mmio_write32((s + ST_MODE) as *mut u32, mode as u32)
    __mmio_write64((s + ST_RDEV) as *mut u64,
        vfs.v_attr(state, m, node, vfsops.A_RDEV))
    __mmio_write64((s + ST_SIZE) as *mut u64, size)
    __mmio_write64((s + ST_BLKSIZE) as *mut u64, bs)
    if bs != 0 {
        __mmio_write64((s + ST_BLOCKS) as *mut u64, statsane.blocks512(state, size))
    }
    __mmio_write64((s + ST_MTIME) as *mut u64,
        vfs.v_attr(state, m, node, vfsops.A_MTIME))
    __mmio_write64((s + ST_CTIME) as *mut u64,
        vfs.v_attr(state, m, node, vfsops.A_CTIME))
    __mmio_write64((s + ST_ATIME) as *mut u64,
        vfs.v_attr(state, m, node, vfsops.A_ATIME))
    return true
}

fn do_stat(state: u64, me: u64, name: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, STAT_BYTES) {
        return neg(errno.E_FAULT)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                let node: u64 = vfs.node_for(state, m, buf)
                if node == 0 {
                    return neg(errno.E_NOENT)
                }
                fill_vstat(state, m, node)
                return stat_out(state, me, out)
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let ino: u64 = fs.path(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    fill_stat(state, ino)
    return stat_out(state, me, out)
}

// ======================================================== RUNDE OFS3
fn do_lstat(state: u64, me: u64, name: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, STAT_BYTES) {
        return neg(errno.E_FAULT)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                let node: u64 = vfs.node_for(state, m, buf)
                if node == 0 {
                    return neg(errno.E_NOENT)
                }
                fill_vstat(state, m, node)
                return stat_out(state, me, out)
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let ino: u64 = fs.path_nofollow(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    fill_stat(state, ino)
    return stat_out(state, me, out)
}

fn do_symlink(state: u64, me: u64, target: u64, wo: u64) -> u64 {
    if !appfs.free_ok(state, me) {
        return neg(errno.E_ACCES)
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let zbuf: u64 = nameb(state) + 1024
    let zn: u64 = fetch_name(state, me, target, zbuf, MAX_NAME)
    if errno.is_error(zn) {
        return zn
    }
    if zn == 0 {
        return neg(errno.E_INVAL)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, wo, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if len == 0 {
        return neg(errno.E_INVAL)
    }
    if !dir_allowed(state, me, buf, 0) {
        return neg(errno.E_ACCES)
    }
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    if fs.path_nofollow(state, buf) != 0 {
        return neg(errno.E_EXIST)
    }
    let ino: u64 = fs.symlink_path(state, zbuf, buf)
    if ino == 0 {
        if fs.version(state) < fs.OFS_V3 {
            return neg(errno.E_PERM)
        }
        return neg(errno.E_NOSPC)
    }
    perm.on_create(state, me, ino, 511)
    return 0
}

fn do_readlink(state: u64, me: u64, name: u64, out: u64,
    size: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if size == 0 {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, out, size) {
        return neg(errno.E_FAULT)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    // ================= RUNDE FREMDFS: DIE K14-WEICHE
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                let vnode: u64 = vfs.node_for(state, m, buf)
                if vnode == 0 {
                    return neg(errno.E_NOENT)
                }
                if vfs.v_attr(state, m, vnode, vfsops.A_TYPE)
                    != vfsops.N_LNK {
                    return neg(errno.E_INVAL)
                }
                var vn: u64 = vfs.v_attr(state, m, vnode, vfsops.A_SIZE)
                if vn > MAX_NAME {
                    vn = MAX_NAME
                }
                if vn > size {
                    vn = size
                }
                let vziel: u64 = nameb(state) + 1024
                let got: u64 = vfs.v_read(state, m, vnode, 0, vziel, vn)
                if !copy_out(state, me, out, vziel, got) {
                    return neg(errno.E_FAULT)
                }
                return got
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let ino: u64 = fs.path_nofollow(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    if fs.inode_type(state, ino) != fs.T_LINK {
        return neg(errno.E_INVAL)
    }
    let target: u64 = nameb(state) + 1024
    var n: u64 = fs.readlink_at(state, ino, target, MAX_NAME)
    if n > size {
        n = size
    }
    if !copy_out(state, me, out, target, n) {
        return neg(errno.E_FAULT)
    }
    return n
}

fn do_utimensat(state: u64, me: u64, fd: u64, name: u64, zeiten: u64,
    flaggen: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    var ino: u64 = 0
    if name == 0 {
        // r820: futimens(fd, times) = utimensat(fd, NULL, times, 0)
        let ofd: u64 = of_of(state, me, fd)
        if ofd >= file.MAX_OPEN {
            return neg(errno.E_BADF)
        }
        let kd: u64 = file.open_kind(state, ofd)
        if kd != file.K_FILE && kd != file.K_DIR {
            return neg(errno.E_PERM) // pipes, consoles and virtual files carry no times
        }
        ino = file.open_ino(state, ofd)
        if ino == 0 {
            return neg(errno.E_BADF)
        }
    } else {
        let buf: u64 = nameb(state)
        let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
        if errno.is_error(len) {
            return len
        }
        if !perm.walk_w(state, me, buf) {
            return neg(errno.E_ACCES)
        }
        ino = fs.path(state, buf)
        if ino == 0 {
            return neg(errno.E_NOENT)
        }
    }
    if !perm.may(state, me, ino, perm.R_WRITE) {
        return neg(errno.E_ACCES)
    }
    let nun: u64 = time.now_sec(state)
    var a: u64 = nun
    var m: u64 = nun
    if zeiten != 0 {
        if !proc.user_ok(state, me, zeiten, 32) {
            return neg(errno.E_FAULT)
        }
        let as_: u64 = user_word(state, me, zeiten)
        let an: u64 = user_word(state, me, zeiten + 8)
        let ms: u64 = user_word(state, me, zeiten + 16)
        let mn: u64 = user_word(state, me, zeiten + 24)
        if an == UTIME_OMIT {
            a = 0
        } else if an != UTIME_NOW {
            a = as_
        }
        if mn == UTIME_OMIT {
            m = 0
        } else if mn != UTIME_NOW {
            m = ms
        }
    }
    if !fs.set_times(state, ino, 0, m, a) {
        if fs.version(state) < fs.OFS_V3 {
            return neg(errno.E_PERM)
        }
        return neg(errno.E_IO)
    }
    return 0
}

fn do_fstat(state: u64, me: u64, fd: u64, out: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if !proc.user_ok(state, me, out, STAT_BYTES) {
        return neg(errno.E_FAULT)
    }
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_FILE || kind == file.K_DIR {
        fill_stat(state, file.open_ino(state, of))
        return stat_out(state, me, out)
    }
    // ROUNDE K14.
    if kind == file.K_VFILE || kind == file.K_VDIR {
        fill_vstat(state, file.open_mnt(state, of),
            file.open_ino(state, of))
        return stat_out(state, me, out)
    }
    // A pipe and the console have no inode. They still have a KIND, and a
    // program that asks what it is holding gets an answer.
    let s: u64 = blockb(state) + 2048
    var i: u64 = 0
    while i < STAT_BYTES {
        kstate.set8(s + i, 0 as u8)
        i = i + 1
    }
    var mode: u64 = S_IFCHR | 438 // 0o666
    if kind == file.K_PIPER || kind == file.K_PIPEW {
        mode = S_IFIFO | 438
    }
    if kind == file.K_SHM {
        // memfd / /dev/shm object: a regular file whose size is the ftruncate() size
        mode = S_IFREG | 438
        __mmio_write64((s + ST_SIZE) as *mut u64, unixsock.shm_size(state, file.open_ino(state, of)))
    }
    __mmio_write32((s + ST_MODE) as *mut u32, mode as u32)
    __mmio_write64((s + ST_NLINK) as *mut u64, 1)
    __mmio_write64((s + ST_BLKSIZE) as *mut u64, 512)
    if kind == file.K_FB {
        __mmio_write64((s + ST_SIZE) as *mut u64, gfx.fb_bytes(state))
        __mmio_write64((s + ST_BLKSIZE) as *mut u64, gfx.fb_pitch(state))
    }
    return stat_out(state, me, out)
}

// --------------------------------------------------------- getdents64

// `struct linux_dirent64`:
//
//     +0  d_ino (8)   +8 d_off (8)   +16 d_reclen (2)   +18 d_type (1)
//     +19 the name, ended by a zero
fn do_getdents_vfs(state: u64, me: u64, of: u64, out: u64,
    size: u64) -> u64 {
    let m: u64 = file.open_mnt(state, of)
    let dir: u64 = file.open_ino(state, of)
    let named: u64 = nameb(state) + NB_ENT
    let build: u64 = blockb(state) + 2048
    var written: u64 = 0
    var pos: u64 = file.open_off(state, of)
    var going: bool = true
    while going {
        let node: u64 = vfs.v_readdir(state, m, dir, pos, named)
        if node == 0 {
            going = false
        } else {
            var n: u64 = 0
            while kstate.get8(named + n) != 0 {
                n = n + 1
            }
            let reclen: u64 = (DIRENT_HEAD + n + 1 + 7) & 0xFFFFFFFFFFFFFFF8
            if written + reclen > size {
                if written == 0 {
                    return neg(errno.E_INVAL)
                }
                going = false
            } else {
                var z: u64 = 0
                while z < reclen {
                    kstate.set8(build + z, 0 as u8)
                    z = z + 1
                }
                __mmio_write64(build as *mut u64, node)
                __mmio_write64((build + 8) as *mut u64, pos + 1)
                __mmio_write16((build + 16) as *mut u16, reclen as u16)
                var kind: u64 = DT_REG
                let vart: u64 = vfs.v_attr(state, m, node, vfsops.A_TYPE)
                if vart == vfsops.N_DIR {
                    kind = DT_DIR
                } else if vart == vfsops.N_LNK {
                    kind = DT_LNK
                }
                kstate.set8(build + 18, kind as u8)
                var k: u64 = 0
                while k < n {
                    kstate.set8(build + DIRENT_HEAD + k,
                        kstate.get8(named + k) as u8)
                    k = k + 1
                }
                if !copy_out(state, me, out + written, build, reclen) {
                    return neg(errno.E_FAULT)
                }
                written = written + reclen
                pos = pos + 1
                file.open_set_off(state, of, pos)
            }
        }
    }
    return written
}

fn do_getdents(state: u64, me: u64, fd: u64, out: u64, size: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if file.open_kind(state, of) == file.K_VDIR {
        if !proc.user_ok(state, me, out, size) {
            return neg(errno.E_FAULT)
        }
        return do_getdents_vfs(state, me, of, out, size)
    }
    if file.open_kind(state, of) != file.K_DIR {
        return neg(errno.E_NOTDIR)
    }
    if !proc.user_ok(state, me, out, size) {
        return neg(errno.E_FAULT)
    }
    let dir: u64 = file.open_ino(state, of)
    let named: u64 = nameb(state) + NB_ENT
    let build: u64 = blockb(state) + 2048
    var written: u64 = 0
    var pos: u64 = file.open_off(state, of)
    var going: bool = true
    let plaetze: u64 = fs.slot_count(state, dir)
    while going {
        if pos >= plaetze {
            going = false
        } else {
        let ino: u64 = fs.entry_slot(state, dir, pos, named, NB_FSTYPE - NB_ENT)
        if ino == 0 {
            pos = pos + 1
            file.open_set_off(state, of, pos)
        } else {
            // What the file system writes is its own directory entry: the
            // inode number in the first eight octets, the name in the
            // 24 behind them (`fs.DIRENT`, `fs.NAME_LEN`).
            let text: u64 = named + 8
            var n: u64 = 0
            while kstate.get8(text + n) != 0 {
                n = n + 1
            }
            let reclen: u64 = (DIRENT_HEAD + n + 1 + 7) & 0xFFFFFFFFFFFFFFF8
            if written + reclen > size {
                if written == 0 {
                    return neg(errno.E_INVAL)
                }
                going = false
            } else {
                var z: u64 = 0
                while z < reclen {
                    kstate.set8(build + z, 0 as u8)
                    z = z + 1
                }
                __mmio_write64(build as *mut u64, ino)
                __mmio_write64((build + 8) as *mut u64, pos + 1)
                __mmio_write16((build + 16) as *mut u16, reclen as u16)
                var kind: u64 = DT_REG
                let art: u64 = fs.inode_type(state, ino)
                if art == fs.T_DIR {
                    kind = DT_DIR
                } else if art == fs.T_LINK {
                    kind = DT_LNK
                }
                kstate.set8(build + 18, kind as u8)
                var k: u64 = 0
                while k < n {
                    kstate.set8(build + DIRENT_HEAD + k,
                        kstate.get8(text + k) as u8)
                    k = k + 1
                }
                if !copy_out(state, me, out + written, build, reclen) {
                    return neg(errno.E_FAULT)
                }
                written = written + reclen
                pos = pos + 1
                file.open_set_off(state, of, pos)
            }
        }
        }
    }
    return written
}

// ------------------------------------------------------------- memory

// The private region of a process (`proc.fi`):
//
//   0x40000000  the data page
//   0x40001000  eight stack pages, the top one holds argc/argv
//   0x40020000  the BREAK grows upwards from here
//   0x400F0000  MMAP grows downwards from here
//   0x40100000  the image
const BRK_BASE: u64 = 0x40080000
const MMAP_TOP: u64 = 0x400F0000
const PAGE: u64 = 4096

fn page_up(v: u64) -> u64 {
    // wrapping add: a length near 2^64 must not reach the checked `+` (kernel panic from ring 3); it rounds to 0 and the callers reject 0 pages
    return (v +% (PAGE - 1)) & 0xFFFFFFFFFFFFF000
}

// THREAD GROUP MEMORY MARKS (r701/w-foot3): break, mmap bottom and big
// bottom describe ONE address space, so all threads of a group (clone with
// CLONE_THREAD, T_TGID = leader pid) read and write the LEADER's marks.
// Copying them at clone time made two threads hand out the same
// addresses (map_page saw "page there" -> ENOMEM, foot font threads).
// Falls back to the own slot when the leader is gone.
fn mem_owner(state: u64, me: u64) -> u64 {
    let g: u64 = sched.tget(state, me, sched.T_TGID)
    if g == 0 || g == sched.tget(state, me, sched.T_PID) {
        return me
    }
    let l: u64 = sched.find_pid(state, g)
    if l >= kstate.MAX_TASKS {
        return me
    }
    return l
}

fn brk_of(state: u64, me: u64) -> u64 {
    let b: u64 = sched.tget(state, mem_owner(state, me), sched.T_BRK)
    if b == 0 {
        return BRK_BASE
    }
    return b
}

fn map_bottom(state: u64, me: u64) -> u64 {
    let m: u64 = sched.tget(state, mem_owner(state, me), sched.T_MMAP)
    if m == 0 {
        return MMAP_TOP
    }
    return m
}

// `brk(0)` asks where the break is; `brk(x)` moves it. Linux answers a
// refusal with the OLD break, not with an error, and a libc reads that as
// "no". Osum does the same.
// RUNDE LAUFZEIT: `arch_prctl(code, addr)`.
fn do_pio(state: u64, me: u64, fd: u64, buf: u64, len: u64, off: u64,
    writing: bool) -> u64 {
    if (off >> 63) != 0 {
        return neg(errno.E_INVAL)
    }
    var recht: u64 = handle.R_READ
    if writing {
        recht = handle.R_WRITE
    }
    let of: u64 = file.fd_check(state, me, fd, recht)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_PIPER || kind == file.K_PIPEW {
        return neg(errno.E_SPIPE)
    }
    if kind == file.K_CONIN || kind == file.K_CONOUT {
        return neg(errno.E_SPIPE)
    }
    let saved_off: u64 = file.open_off(state, of)
    file.open_set_off(state, of, off)
    var r: u64 = 0
    if writing {
        r = do_write(state, me, fd, buf, len)
    } else {
        r = do_read(state, me, fd, buf, len)
        // ROUND UNTERBAU: one do_read gives at most one block-sized chunk; a regular file answers a bigger
        // pread() in full (POSIX allows a short read, but SQLite, mmap-less loaders and tar rely on the full one).
        if kind == file.K_FILE && (r >> 63) == 0 && r != 0 && r < len {
            var done: u64 = r
            var more: bool = true
            while more && done < len {
                let r2: u64 = do_read(state, me, fd, buf + done, len - done)
                if (r2 >> 63) != 0 || r2 == 0 {
                    more = false
                } else {
                    done = done + r2
                }
            }
            r = done
        }
    }
    file.open_set_off(state, of, saved_off)
    return r
}

// RUNDE LAUFZEIT: `fcntl`, und zwar EHRLICH.
const UTS_FIELD: u64 = 65
const UTS_BYTES: u64 = 390

fn uts_set(buffer: u64, field: u64, text: u64, length: u64) {
    var i: u64 = 0
    while i < length {
        kstate.set8(buffer + field * UTS_FIELD + i, kstate.get8(text + i) as u8)
        i = i + 1
    }
}

fn do_uname(state: u64, me: u64, aus: u64) -> u64 {
    var s_sys: [u8; 6] = "Linux\0"
    var s_node: [u8; 5] = "osum\0"
    var s_rel: [u8; 7] = "6.1.0\0\0"
    var s_ver: [u8; 5] = "Osum\0"
    var s_mach: [u8; 7] = "x86_64\0"
    var buffer: [u8; 390] = [0; 390]
    let p: u64 = (&buffer[0]) as u64
    var i: u64 = 0
    while i < UTS_BYTES {
        kstate.set8(p + i, 0)
        i = i + 1
    }
    uts_set(p, 0, (&s_sys[0]) as u64, 5)
    uts_set(p, 1, (&s_node[0]) as u64, 4)
    uts_set(p, 2, (&s_rel[0]) as u64, 5)
    uts_set(p, 3, (&s_ver[0]) as u64, 4)
    uts_set(p, 4, (&s_mach[0]) as u64, 6)
    if !copy_out(state, me, aus, p, UTS_BYTES) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// RUNDE LC1: the process name (comm) -- 15 characters in T_COMMA (0..7) and T_COMMB (8..14); `buf` is a kernel buffer of >= 16 octets.
fn comm_store(state: u64, t: u64, buf: u64) {
    var a: u64 = 0
    var b: u64 = 0
    var i: u64 = 0
    while i < 8 {
        a = a | (kstate.get8(buf + i) << (i * 8))
        i = i + 1
    }
    i = 0
    while i < 7 {
        b = b | (kstate.get8(buf + 8 + i) << (i * 8))
        i = i + 1
    }
    sched.tset(state, t, sched.T_COMMA, a)
    sched.tset(state, t, sched.T_COMMB, b)
}

fn comm_load(state: u64, t: u64, buf: u64) {
    let a: u64 = sched.tget(state, t, sched.T_COMMA)
    let b: u64 = sched.tget(state, t, sched.T_COMMB)
    var i: u64 = 0
    while i < 8 {
        kstate.set8(buf + i, ((a >> (i * 8)) & 255) as u8)
        i = i + 1
    }
    i = 0
    while i < 7 {
        kstate.set8(buf + 8 + i, ((b >> (i * 8)) & 255) as u8)
        i = i + 1
    }
    kstate.set8(buf + 15, 0 as u8)
}

fn comm_inherit(state: u64, from: u64, to: u64) {
    sched.tset(state, to, sched.T_COMMA, sched.tget(state, from, sched.T_COMMA))
    sched.tset(state, to, sched.T_COMMB, sched.tget(state, from, sched.T_COMMB))
}

// exec: comm = the last component of the path, cut to 15 characters (what Linux does)
fn comm_from_path(state: u64, t: u64, path: u64) {
    var start: u64 = 0
    var i: u64 = 0
    while kstate.get8(path + i) != 0 {
        if kstate.get8(path + i) == 47 {
            start = i + 1
        }
        i = i + 1
    }
    var nb: [u8; 17] = [0 as u8; 17]
    let np: u64 = (&nb[0]) as u64
    var k: u64 = 0
    while k < 15 && kstate.get8(path + start + k) != 0 {
        kstate.set8(np + k, kstate.get8(path + start + k) as u8)
        k = k + 1
    }
    comm_store(state, t, np)
}

const PR_SET_NAME: u64 = 15
const PR_GET_NAME: u64 = 16
const PR_GET_DUMPABLE: u64 = 3
const PR_SET_DUMPABLE: u64 = 4

fn do_prctl(state: u64, me: u64, was: u64, arg: u64) -> u64 {
    if was == svcwatch.PR_WATCH {
        return svcwatch.watch(state, me, arg)
    }
    if was == svcwatch.PR_FAULT {
        return svcwatch.fault(state, me, arg)
    }
    if was == fszap.PR_ZAP {
        let e: u64 = fszap.zap(state, me, arg)
        if e != 0 {
            return neg(e)
        }
        return fszap.PR_ZAP
    }
    if was == PR_SET_NAME {
        var nb: [u8; 17] = [0 as u8; 17]
        let np: u64 = (&nb[0]) as u64
        var k: u64 = 0
        var more: bool = true
        while k < 15 && more {
            if !proc.user_ok(state, me, arg + k, 1) {
                return neg(errno.E_FAULT)
            }
            let c: u64 = peek(state, me, arg + k)
            if c == 0 {
                more = false
            } else {
                kstate.set8(np + k, c as u8)
                k = k + 1
            }
        }
        comm_store(state, me, np)
        return 0
    }
    if was == PR_GET_NAME {
        var gb: [u8; 17] = [0 as u8; 17]
        let gp: u64 = (&gb[0]) as u64
        comm_load(state, me, gp)
        if !copy_out(state, me, arg, gp, 16) {
            return neg(errno.E_FAULT)
        }
        return 0
    }
    if was == PR_GET_DUMPABLE {
        return 0
    }
    if was == PR_SET_DUMPABLE {
        return 0
    }
    // RUNDE UNTERBAU: the options a sandboxing, threading program sets at start-up and ignores the failure of anyway -- accepted
    // where the request is a no-op on this kernel (there is no setuid exec to gain privileges with, no core dump, no timer slack,
    // no subreaper bookkeeping, no parent-death signal: PR_SET_PDEATHSIG is accepted WITHOUT effect, written down in
    // docs/RUNDE-UNTERBAU-FIREFOX.md). The questions answer what is true: no seccomp filter (0), no_new_privs 1.
    if was == 1 || was == 29 || was == 36 || was == 38 {
        return 0
    }
    if was == 21 {
        return 0
    }
    if was == 39 {
        return 1
    }
    return neg(errno.E_INVAL)
}

fn do_fcntl(state: u64, me: u64, fd: u64, cmd: u64, arg: u64) -> u64 {
    let of: u64 = file.fd_check(state, me, fd, 0)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if cmd == F_GETFL {
        return file.open_flags(state, of)
    }
    if cmd == F_SETFL {
        // RUNDE UNTERBAU: the two flags that can change after open(): O_NONBLOCK and O_APPEND. Until now F_SETFL answered 0 and kept
        // nothing, so `fcntl(fd, F_SETFL, O_NONBLOCK)` -- the first thing an event loop does to a socket or a pipe -- had no effect.
        let keep: u64 = UB_O_NONBLOCK | O_APPEND
        file.open_set_flags(state, of, (file.open_flags(state, of) & (~keep)) | (arg & keep))
        return 0
    }
    if cmd == F_GETFD {
        return cx_bit(state, me, fd)
    }
    if cmd == F_SETFD {
        cx_put(state, me, fd, (arg & 1) != 0)
        return 0
    }
    if cmd == F_DUPFD || cmd == F_DUPFD_CLOEXEC {
        let nd: u64 = do_dup_min(state, me, fd, arg)
        if cmd == F_DUPFD_CLOEXEC && !errno.is_error(nd) {
            cx_put(state, me, nd, true)
        }
        return nd
    }
    if cmd == F_SETLK || cmd == F_SETLKW || cmd == F_GETLK {
        return do_lock(state, me, of, cmd, arg)
    }
    if cmd == F_ADD_SEALS {
        if file.open_kind(state, of) != file.K_SHM {
            return neg(errno.E_INVAL)
        }
        let i: u64 = file.open_ino(state, of)
        if (unixsock.shm_seals(state, i) & F_SEAL_SEAL) != 0 {
            return neg(errno.E_PERM)
        }
        // K-07: F_SEAL_WRITE is refused (-EBUSY) while a writable mapping exists, and later writable mappings are refused (`map_shm`)
        let sr: u64 = unixsock.shm_add_seals(state, i, arg)
        if sr != 0 {
            return neg(sr)
        }
        return 0
    }
    if cmd == F_GET_SEALS {
        if file.open_kind(state, of) != file.K_SHM {
            return neg(errno.E_INVAL)
        }
        return unixsock.shm_seals(state, file.open_ino(state, of))
    }
    return neg(errno.E_INVAL)
}

// ------------------------------------------------- RUNDE FREMDLAND: SPERREN

fn lock_at(state: u64, i: u64) -> u64 {
    return state + kstate.FLOCK_OFF + i * kstate.FLOCK_BYTES
}

fn lock_get(state: u64, i: u64, field: u64) -> u64 {
    return kstate.get(state, lock_at(state, i) + field)
}

fn lock_set(state: u64, i: u64, field: u64, v: u64) {
    kstate.set(state, lock_at(state, i) + field, v)
}

fn lock_trifft(a_von: u64, a_bis: u64, b_von: u64, b_bis: u64) -> bool {
    if a_bis < b_von {
        return false
    }
    if b_bis < a_von {
        return false
    }
    return true
}

fn do_lock(state: u64, me: u64, of: u64, cmd: u64, arg: u64) -> u64 {
    if !proc.user_ok(state, me, arg, FL_BYTES) {
        return neg(errno.E_FAULT)
    }
    let art: u64 = user_half(state, me, arg + FL_TYPE)
    let whence: u64 = user_half(state, me, arg + FL_WHENCE)
    let start: u64 = user_word(state, me, arg + FL_START)
    let length: u64 = user_word(state, me, arg + FL_LEN)
    if art != F_RDLCK && art != F_WRLCK && art != F_UNLCK {
        return neg(errno.E_INVAL)
    }
    var von: u64 = start
    if whence == SEEK_CUR {
        von = file.open_off(state, of) + start
    }
    if whence == SEEK_END {
        return neg(errno.E_INVAL)
    }
    if whence != SEEK_SET && whence != SEEK_CUR {
        return neg(errno.E_INVAL)
    }
    var bis: u64 = 0xFFFFFFFFFFFFFFFF
    if length != 0 {
        if (length >> 63) != 0 {
            return neg(errno.E_INVAL)
        }
        bis = von + length - 1
    }
    let ino: u64 = file.open_ino(state, of)
    if ino == 0 {
        return neg(errno.E_BADF)
    }
    let mnt: u64 = file.open_mnt(state, of)
    let wer: u64 = sched.tget(state, me, sched.T_TGID)

    if cmd == F_GETLK {
        var k: u64 = 0
        while k < kstate.FLOCK_SLOTS {
            if lock_get(state, k, L_INO) == ino
                && lock_get(state, k, L_MNT) == mnt
                && lock_get(state, k, L_PID) != wer {
                let hart: u64 = lock_get(state, k, L_ART)
                var stoert: bool = true
                if art == F_RDLCK && hart == F_RDLCK {
                    stoert = false
                }
                if stoert && lock_trifft(von, bis,
                    lock_get(state, k, L_VON), lock_get(state, k, L_UNTIL)) {
                    put_half(state, me, arg + FL_TYPE, hart)
                    put_half(state, me, arg + FL_WHENCE, SEEK_SET)
                    put64(state, me, arg + FL_START,
                        lock_get(state, k, L_VON))
                    var l: u64 = 0
                    if lock_get(state, k, L_UNTIL) != 0xFFFFFFFFFFFFFFFF {
                        l = lock_get(state, k, L_UNTIL)
                            - lock_get(state, k, L_VON) + 1
                    }
                    put64(state, me, arg + FL_LEN, l)
                    put_word32(state, me, arg + FL_PID,
                        lock_get(state, k, L_PID))
                    return 0
                }
            }
            k = k + 1
        }
        put_half(state, me, arg + FL_TYPE, F_UNLCK)
        return 0
    }

    if art == F_UNLCK {
        var k: u64 = 0
        while k < kstate.FLOCK_SLOTS {
            if lock_get(state, k, L_INO) == ino
                && lock_get(state, k, L_MNT) == mnt
                && lock_get(state, k, L_PID) == wer
                && lock_trifft(von, bis, lock_get(state, k, L_VON),
                    lock_get(state, k, L_UNTIL)) {
                lock_free(state, k)
            }
            k = k + 1
        }
        return 0
    }

    var k2: u64 = 0
    while k2 < kstate.FLOCK_SLOTS {
        if lock_get(state, k2, L_INO) == ino
            && lock_get(state, k2, L_MNT) == mnt
            && lock_get(state, k2, L_PID) != wer {
            let hart2: u64 = lock_get(state, k2, L_ART)
            var stoert2: bool = true
            if art == F_RDLCK && hart2 == F_RDLCK {
                stoert2 = false
            }
            if stoert2 && lock_trifft(von, bis, lock_get(state, k2, L_VON),
                lock_get(state, k2, L_UNTIL)) {
                return neg(errno.E_AGAIN)
            }
        }
        k2 = k2 + 1
    }
    var k3: u64 = 0
    while k3 < kstate.FLOCK_SLOTS {
        if lock_get(state, k3, L_INO) == ino
            && lock_get(state, k3, L_MNT) == mnt
            && lock_get(state, k3, L_PID) == wer
            && lock_trifft(von, bis, lock_get(state, k3, L_VON),
                lock_get(state, k3, L_UNTIL)) {
            lock_free(state, k3)
        }
        k3 = k3 + 1
    }
    var free: u64 = kstate.FLOCK_SLOTS
    var k4: u64 = 0
    while k4 < kstate.FLOCK_SLOTS {
        if lock_get(state, k4, L_INO) == 0 && free == kstate.FLOCK_SLOTS {
            free = k4
        }
        k4 = k4 + 1
    }
    if free >= kstate.FLOCK_SLOTS {
        return neg(errno.E_NOLCK)
    }
    lock_set(state, free, L_INO, ino)
    lock_set(state, free, L_MNT, mnt)
    lock_set(state, free, L_VON, von)
    lock_set(state, free, L_UNTIL, bis)
    lock_set(state, free, L_ART, art)
    lock_set(state, free, L_PID, wer)
    kstate.add(state, kstate.FLOCKS, 1)
    return 0
}

fn lock_free(state: u64, k: u64) {
    lock_set(state, k, L_INO, 0)
    lock_set(state, k, L_MNT, 0)
    lock_set(state, k, L_VON, 0)
    lock_set(state, k, L_UNTIL, 0)
    lock_set(state, k, L_ART, 0)
    lock_set(state, k, L_PID, 0)
}

fn locks_drop(state: u64, me: u64) {
    let wer: u64 = sched.tget(state, me, sched.T_TGID)
    if wer == 0 {
        return
    }
    var k: u64 = 0
    while k < kstate.FLOCK_SLOTS {
        if lock_get(state, k, L_INO) != 0
            && lock_get(state, k, L_PID) == wer {
            lock_free(state, k)
        }
        k = k + 1
    }
}

fn do_writev(state: u64, me: u64, fd: u64, iov: u64, n: u64, writing: bool) -> u64 {
    if n > 1024 {
        return neg(errno.E_INVAL)
    }
    if n == 0 {
        return 0
    }
    if !proc.user_ok(state, me, iov, n * 16) {
        return neg(errno.E_FAULT)
    }
    var total: u64 = 0
    var i: u64 = 0
    while i < n {
        let base: u64 = get_user64(state, me, iov + i * 16)
        let len: u64 = get_user64(state, me, iov + i * 16 + 8)
        if len != 0 {
            var r: u64 = 0
            if writing {
                r = do_write(state, me, fd, base, len)
            } else {
                r = do_read(state, me, fd, base, len)
            }
            if (r >> 63) != 0 {
                if total == 0 {
                    return r
                }
                return total
            }
            total = total + r
            if r < len {
                return total
            }
        }
        i = i + 1
    }
    return total
}

fn do_pvec(state: u64, me: u64, fd: u64, iov: u64, n: u64, off: u64, writing: bool) -> u64 {
    if n > 1024 {
        return neg(errno.E_INVAL)
    }
    if n == 0 {
        return 0
    }
    if !proc.user_ok(state, me, iov, n * 16) {
        return neg(errno.E_FAULT)
    }
    var total: u64 = 0
    var i: u64 = 0
    while i < n {
        let base: u64 = get_user64(state, me, iov + i * 16)
        let len: u64 = get_user64(state, me, iov + i * 16 + 8)
        if len != 0 {
            let r: u64 = do_pio(state, me, fd, base, len, off + total, writing)
            if (r >> 63) != 0 {
                if total == 0 {
                    return r
                }
                return total
            }
            total = total + r
            if r < len {
                return total
            }
        }
        i = i + 1
    }
    return total
}

fn do_waitid(state: u64, me: u64, idtype: u64, id: u64, info: u64, options: u64) -> u64 {
    if (options & 4) == 0 {
        return neg(errno.E_INVAL)
    }
    if info != 0 && !proc.user_ok(state, me, info, 128) {
        return neg(errno.E_FAULT)
    }
    var want: u64 = 0
    if idtype == 1 {
        want = id
    }
    var child: u64 = find_zombie_child(state, me, want)
    var nowait_rounds: u64 = 0
    while child >= kstate.MAX_TASKS && (options & 0x1000000) != 0 && (options & 1) == 0 && nowait_rounds < 100000 && find_child(state, me, want) < kstate.MAX_TASKS {
        sched.wait_sleep(state, want, 0)
        nowait_rounds = nowait_rounds + 1
        child = find_zombie_child(state, me, want)
    }
    if child >= kstate.MAX_TASKS {
        if find_child(state, me, want) >= kstate.MAX_TASKS {
            return neg(errno.E_CHILD)
        }
        if info != 0 {
            var z: u64 = 0
            while z < 16 {
                put64(state, me, info + z * 8, 0)
                z = z + 1
            }
        }
        if (options & 1) != 0 {
            return 0
        }
        if info == 0 || (options & 0x1000000) != 0 {
            return neg(errno.E_INVAL)
        }
        var anyw: u64 = want
        if want == 0 {
            anyw = 0 -% 1
        }
        let w: u64 = do_wait4(state, me, anyw, info + 96, 0)
        if (w >> 63) != 0 {
            return w
        }
        let st: u64 = get32(state, me, info + 96)
        put32(state, me, info + 96, 0)
        put32(state, me, info, 17)
        if (st & 127) != 0 {
            put32(state, me, info + 8, 2)
            put32(state, me, info + 24, st & 127)
        } else {
            put32(state, me, info + 8, 1)
            put32(state, me, info + 24, (st >> 8) & 255)
        }
        put32(state, me, info + 16, w)
        return 0
    }
    if info != 0 {
        let code: u64 = sched.tget(state, child, sched.T_EXIT)
        let sl: u64 = sched.tget(state, child, sched.T_SIGLAST)
        var z2: u64 = 0
        while z2 < 16 {
            put64(state, me, info + z2 * 8, 0)
            z2 = z2 + 1
        }
        put32(state, me, info, 17)
        if (sl & 256) != 0 {
            put32(state, me, info + 8, 2)
            put32(state, me, info + 24, sl & 127)
        } else {
            put32(state, me, info + 8, 1)
            put32(state, me, info + 24, code & 255)
        }
        put32(state, me, info + 16, sched.tget(state, child, sched.T_PID))
    }
    if (options & 0x1000000) == 0 {
        proc.reap(state, child)
    }
    return 0
}

fn do_arch_prctl(state: u64, me: u64, code: u64, addr: u64) -> u64 {
    if code == ARCH_SET_FS {
        if (addr >> 47) != 0 {
            return neg(errno.E_INVAL)
        }
        sched.tset(state, me, sched.T_FSBASE, addr)
        sched.fsbase_apply(state, me)
        return 0
    }
    if code == ARCH_GET_FS {
        if !proc.user_ok(state, me, addr, 8) {
            return neg(errno.E_FAULT)
        }
        put64(state, me, addr, sched.tget(state, me, sched.T_FSBASE))
        return 0
    }
    if code == ARCH_SET_GS {
        if (addr >> 47) != 0 {
            return neg(errno.E_INVAL)
        }
        sched.tset(state, me, sched.T_GSBASE, addr)
        sched.fsbase_apply(state, me)
        return 0
    }
    if code == ARCH_GET_GS {
        if !proc.user_ok(state, me, addr, 8) {
            return neg(errno.E_FAULT)
        }
        put64(state, me, addr, sched.tget(state, me, sched.T_GSBASE))
        return 0
    }
    return neg(errno.E_INVAL)
}

fn do_brk(state: u64, me: u64, want: u64) -> u64 {
    let cur: u64 = brk_of(state, me)
    if want == 0 {
        return cur
    }
    if want < BRK_BASE {
        return cur
    }
    if want > map_bottom(state, me) {
        return cur
    }
    var p: u64 = page_up(cur)
    if want > cur {
        while p < want {
            if proc.page_free(state, me, p) {
                if proc.map_page_zero(state, me, p, true, false) == 0 {
                    oom_handle(state)
                    if p > cur {
                        sched.tset(state, mem_owner(state, me), sched.T_BRK, p)
                        return p
                    }
                    return cur
                }
                kstate.add(state, kstate.MAPS, 1)
            }
            p = p + PAGE
        }
    } else {
        var q: u64 = page_up(want)
        while q < p {
            proc.page_drop(state, me, q)
            q = q + PAGE
        }
    }
    sched.tset(state, mem_owner(state, me), sched.T_BRK, want)
    return want
}

// ============================================ RUNDE K16: DIE GROSSE ARENA
fn big_bottom(state: u64, me: u64) -> u64 {
    let b: u64 = sched.tget(state, mem_owner(state, me), sched.T_BIG)
    if b == 0 {
        return proc.BIG_TOP
    }
    return b
}

// The big region is used up: reuse what munmap freed there (see `hole`).
// After the address-space lock is released: run the out-of-memory handler if a locked path asked for it.
fn vm_oom_after(state: u64) {
    if unixsock.vm_oom_take(state) {
        let _o: u64 = oom_handle(state)
    }
}

fn big_hole(state: u64, me: u64, top: u64, pages: u64, prot: u64) -> u64 {
    let h: u64 = hole(state, me, top, proc.BIG_TOP, pages)
    if h != 0 && map_run(state, me, h, pages, prot) {
        return h
    }
    return neg(errno.E_NOMEM)
}

fn lazy_bottom(state: u64, me: u64) -> u64 {
    let b: u64 = sched.tget(state, mem_owner(state, me), sched.T_LAZY)
    if b == 0 {
        return proc.LAZY_ATOP
    }
    return b
}

fn lazy_undo(state: u64, me: u64, base: u64, upto: u64) {
    var k: u64 = 0
    while k < upto {
        let _d: bool = proc.page_drop(state, me, base + k * PAGE)
        k = k + 1
    }
}

fn lazy_run_f(state: u64, me: u64, base: u64, pages: u64, prot: u64, fk: u64, fpg: u64) -> bool {
    let rd: bool = (prot & PROT_READ) != 0
    let wr: bool = (prot & PROT_WRITE) != 0
    let ex: bool = (prot & PROT_EXEC) != 0
    var k: u64 = 0
    while k < pages {
        var ok: bool = false
        if fk != 0 {
            ok = proc.lazy_mark_file(state, me, base + k * PAGE, rd, wr, ex, fk - 1, fpg + k)
        } else {
            ok = proc.lazy_mark(state, me, base + k * PAGE, rd, wr, ex)
        }
        if !ok {
            lazy_undo(state, me, base, k)
            return false
        }
        k = k + 1
    }
    return true
}

fn lazy_run(state: u64, me: u64, base: u64, pages: u64, prot: u64) -> bool {
    return lazy_run_f(state, me, base, pages, prot, 0, 0)
}

fn lazy_alloc(state: u64, me: u64, pages: u64, prot: u64) -> u64 {
    return lazy_alloc_f(state, me, pages, prot, 0, 0)
}

fn lazy_alloc_f(state: u64, me: u64, pages: u64, prot: u64, fk: u64, fpg: u64) -> u64 {
    let top: u64 = lazy_bottom(state, me)
    if pages * PAGE <= top - proc.LAZY_BASE {
        let base: u64 = top - pages * PAGE
        if lazy_run_f(state, me, base, pages, prot, fk, fpg) {
            sched.tset(state, mem_owner(state, me), sched.T_LAZY, base)
            return base
        }
    }
    let h: u64 = proc.lazy_find(state, me, pages)
    if h == 0 {
        return neg(errno.E_NOMEM)
    }
    if !lazy_run_f(state, me, h, pages, prot, fk, fpg) {
        return neg(errno.E_NOMEM)
    }
    return h
}

fn big_map(state: u64, me: u64, pages: u64, prot: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_NOBIG) {
        return neg(errno.E_NOMEM)
    }
    let top: u64 = big_bottom(state, me)
    if pages * PAGE > top - proc.BIG_FLOOR {
        return big_hole(state, me, top, pages, prot)
    }
    let base: u64 = top - pages * PAGE
    if base < proc.BIG_FLOOR {
        return big_hole(state, me, top, pages, prot)
    }
    var p: u64 = base
    while p < top {
        if proc.map_page_zero(state, me, p, true, (prot & PROT_EXEC) != 0) == 0 {
            if unixsock.vm_held(state, me) {
                // the address-space lock is held: the handler can sleep (disk sync), so the caller runs it after the unlock
                unixsock.vm_oom_note(state)
            } else {
                oom_handle(state)
            }
            return neg(errno.E_NOMEM)
        }
        kstate.add(state, kstate.MAPS, 1)
        p = p + PAGE
    }
    sched.tset(state, mem_owner(state, me), sched.T_BIG, base)
    return base
}

// Anonymous memory only: a mapping backed by a FILE needs the page cache
// this system does not have, and pretending otherwise would be the kind of
// half-truth that costs a day later. MAP_ANONYMOUS missing is -ENODEV, and
// docs/ROUNDK4.md says so.
// The name is `do_map` and not `do_mmap` on purpose: section 2 of
// `tools/kernel/run.sh` proves that no host libc is linked into the kernel
// by looking for the names `malloc`, `printf`, `memcpy` and `mmap` in the
// symbol table. A kernel function that carried one of those names would
// make that proof worthless.
fn do_map(state: u64, me: u64, addr: u64, len: u64, prot: u64, flags: u64,
    fd: u64, off: u64) -> u64 {
    if len == 0 {
        return neg(errno.E_INVAL)
    }
    if (flags & MAP_ANONYMOUS) == 0 {
        // RUNDE UNTERBAU: a mapping of a REGULAR FILE (dlopen of a shared object, a mapped data file). The other descriptors that
        // can be mapped (frame buffer, shared memory objects) keep their way.
        let of: u64 = of_of(state, me, fd)
        if of < file.MAX_OPEN && file.open_kind(state, of) == file.K_FILE {
            return map_file(state, me, addr, len, prot, flags, fd, off)
        }
        return map_fd(state, me, fd, len, prot, off)
    }
    // With MAP_ANONYMOUS Linux ignores the descriptor as well.
    if off != 0 {
        return neg(errno.E_INVAL)
    }
    return map_anon(state, me, addr, len, prot, flags)
}

// RUNDE UNTERBAU: anonymous memory with the rights that were asked for. Until this round every anonymous mapping was read-write
// whatever `prot` said (PROT_NONE guard pages were readable); the pages come out RW and zeroed from `map_alloc` and are cut down
// afterwards when `prot` is anything but plain read-write.
fn map_anon(state: u64, me: u64, addr: u64, len: u64, prot: u64, flags: u64) -> u64 {
    let pages: u64 = page_up(len) / PAGE
    // TOCTOU audit K-02: a length near 2^64 rounds to 0 pages (page_up wraps); a zero-page mapping is no mapping
    if pages == 0 {
        return neg(errno.E_INVAL)
    }
    // RUNDE LIMITS3: a big PROT_NONE | MAP_NORESERVE mapping is a RESERVATION (JS engines, allocators): address space only, no frame.
    if prot == 0 && (flags & MAP_FIXED) == 0 && len >= RES_MIN && len <= RES_MAX {
        if pages <= LAZY_RESERVE_PAGES {
            let lr: u64 = lazy_alloc(state, me, pages, prot)
            if lr < 0xFFFFFFFFFFFFF000 {
                return lr
            }
        }
        return res_add(state, mem_owner(state, me), page_up(len))
    }
    if (flags & MAP_FIXED) == 0 && pages >= LAZY_MIN_PAGES && !kstate.mode_on(state, kstate.M_NOLAZY) {
        let lz: u64 = lazy_alloc(state, me, pages, prot)
        if lz < 0xFFFFFFFFFFFFF000 {
            return lz
        }
    }
    var base: u64 = 0
    if (flags & MAP_FIXED) != 0 {
        base = map_fixed(state, me, addr, pages, prot)
    } else {
        base = map_alloc(state, me, pages, prot)
        if base >= 0xFFFFFFFFFFFFF000 {
            let lf: u64 = lazy_alloc(state, me, pages, prot)
            if lf < 0xFFFFFFFFFFFFF000 {
                return lf
            }
        }
    }
    if base >= 0xFFFFFFFFFFFFF000 {
        return base
    }
    if (prot & 3) != 3 {
        let r: u64 = set_range_prot(state, me, base, pages, prot)
        if r != 0 {
            return neg(errno.E_NOMEM)
        }
    }
    return base
}

// The rights of a range of mapped pages; 0 = done. One flush at the end.
fn set_range_prot(state: u64, me: u64, base: u64, pages: u64, prot: u64) -> u64 {
    var k: u64 = 0
    while k < pages {
        let r: u64 = proc.page_protect(state, me, base + k * PAGE, (prot & PROT_READ) != 0, (prot & PROT_WRITE) != 0, (prot & PROT_EXEC) != 0)
        if r != 0 {
            proc.tlb_flush_if_current(state, me)
            return r
        }
        k = k + 1
    }
    proc.tlb_flush_if_current(state, me)
    return 0
}

// MAP_FIXED: the pages go exactly to `addr`, whatever was mapped there is replaced (and zero). Only inside the two windows that
// `mmap` hands out of and only ABOVE their bump marks -- the pages below a mark are the allocator's to give, a fixed mapping there
// would meet the next ordinary `mmap`.
fn map_fixed(state: u64, me: u64, addr: u64, pages: u64, prot: u64) -> u64 {
    return map_fixed_f(state, me, addr, pages, prot, 0, 0)
}

fn map_fixed_f(state: u64, me: u64, addr: u64, pages: u64, prot: u64, fk: u64, fpg: u64) -> u64 {
    if (addr & (PAGE - 1)) != 0 {
        return neg(errno.E_INVAL)
    }
    if pages == 0 || pages > 0x100000 {
        return neg(errno.E_INVAL)
    }
    let end: u64 = addr + pages * PAGE
    let in_alt: bool = addr >= map_bottom(state, me) && end <= MMAP_TOP
    let in_big: bool = addr >= big_bottom(state, me) && end <= proc.BIG_TOP
    let in_lazy: bool = addr >= proc.LAZY_BASE && end <= proc.LAZY_TOP
    if !in_alt && !in_big && !in_lazy {
        return neg(errno.E_NOMEM)
    }
    if addr >= RES_BASE && !res_covers(state, mem_owner(state, me), addr, pages * PAGE) {
        return neg(errno.E_NOMEM)
    }
    file_shm_flush_maps(state, me, addr, pages * PAGE, true)
    let _released: bool = unixsock.map_release(state, me, addr, pages * PAGE)
    var p: u64 = addr
    while p < end {
        let _d: bool = proc.page_drop(state, me, p)
        if in_lazy {
            var marked: bool = false
            if fk != 0 {
                marked = proc.lazy_mark_file(state, me, p, (prot & PROT_READ) != 0, (prot & PROT_WRITE) != 0, (prot & PROT_EXEC) != 0, fk - 1, fpg + (p - addr) / PAGE)
            } else {
                marked = proc.lazy_mark(state, me, p, (prot & PROT_READ) != 0, (prot & PROT_WRITE) != 0, (prot & PROT_EXEC) != 0)
            }
            if !marked {
                return neg(errno.E_NOMEM)
            }
        } else if proc.map_page_zero(state, me, p, true, (prot & PROT_EXEC) != 0) == 0 {
            return neg(errno.E_NOMEM)
        }
        kstate.add(state, kstate.MAPS, 1)
        p = p + PAGE
    }
    return addr
}

// ---------------------------------------------------------------- LCSH: mmap(MAP_SHARED + PROT_WRITE) of a regular file
//
// There is no page cache, so the "page cache" of a shared file mapping is a shared page object (the K_SHM machinery of memfd/Wayland):
// ONE object per (file, first file page), the frames belong to the object, every mapper gets the same frames -> a store of one process is
// seen by the others at once. The pages are filled from the file when the object is made (what is beyond the end of the file is zero).
// They are written BACK to the file by msync, by munmap and by the end of the process (only the pages that differ from the file, and
// never beyond the file size). NOT done (documented in docs/LINUX-COMPAT-OPEN.md #5): a write(2) to the file after the mapping is made is
// not seen by the mapping (and a changed mapped page overwrites it at the next write-back); no MAP_FIXED; at most 256 pages (1 MiB) per
// mapping; two mappings of one file that start at different offsets and overlap are two objects (not coherent with each other); the
// pages are written back only at msync/munmap/exit, not by a timer; a mapping that a fork child inherited is written back by the parent.
const FSHM_MAX_PAGES: u64 = 256

// Pages [from, to) of object `i` get the bytes of the file (page `first_pg + p`); the frames are zero already, a short read leaves the rest zero.
fn file_shm_fill(state: u64, i: u64, ino: u64, first_pg: u64, from: u64, to: u64) -> bool {
    let bounce: u64 = blockb(state)
    var p: u64 = from
    while p < to {
        let frame: u64 = unixsock.shm_frame(state, i, p)
        if frame == 0 {
            return false
        }
        var n: u64 = fs.read_at(state, ino, (first_pg + p) * PAGE, bounce, PAGE)
        if n > PAGE {
            n = 0
        }
        var o: u64 = 0
        while o + 8 <= n {
            *((frame + o) as *mut u64) = *((bounce + o) as *mut u64)
            o = o + 8
        }
        while o < n {
            *((frame + o) as *mut u8) = *((bounce + o) as *mut u8)
            o = o + 1
        }
        p = p + 1
    }
    return true
}

// Write the pages of file object `i` back to the file: only those that differ from what the file holds, clipped to the file size.
fn file_shm_flush(state: u64, i: u64) {
    let key: u64 = unixsock.shm_file_key(state, i)
    if key == 0 {
        return
    }
    let ino: u64 = (key & 0xFFFFFFFF) - 1
    let first_pg: u64 = key >> 32
    let pages: u64 = unixsock.shm_pages(state, i)
    let bounce: u64 = blockb(state)
    var p: u64 = 0
    while p < pages {
        let fo: u64 = (first_pg + p) * PAGE
        let size: u64 = fs.inode_size(state, ino)
        if fo >= size {
            return
        }
        var n: u64 = size - fo
        if n > PAGE {
            n = PAGE
        }
        let frame: u64 = unixsock.shm_frame(state, i, p)
        if frame != 0 {
            let got: u64 = fs.read_at(state, ino, fo, bounce, n)
            var same: bool = got == n
            var o: u64 = 0
            while same && o < n {
                if *((frame + o) as *mut u8) != *((bounce + o) as *mut u8) {
                    same = false
                }
                o = o + 1
            }
            if !same {
                o = 0
                while o + 8 <= n {
                    *((bounce + o) as *mut u64) = *((frame + o) as *mut u64)
                    o = o + 8
                }
                while o < n {
                    *((bounce + o) as *mut u8) = *((frame + o) as *mut u8)
                    o = o + 1
                }
                let _w: u64 = fs.write_at(state, ino, fo, bounce, n)
            }
        }
        p = p + 1
    }
}

// msync / munmap / exit: write back every file object that a mapping record of this task overlaps with [addr, addr + len)
// (len == 0xFFFFFFFFFFFFFFFF = all of the task's records, for the end of the process). `exact` = munmap: only the record that starts at addr.
fn file_shm_flush_maps(state: u64, me: u64, addr: u64, len: u64, exact: bool) {
    var k: u64 = 0
    while k < unixsock.UMAP_MAX {
        let base: u64 = unixsock.map_rec_base(state, k)
        if base != 0 {
            let w: u64 = unixsock.map_rec_word(state, k)
            let pages: u64 = (w >> 32) & unixsock.UM_PAGES_MASK
            var hit: bool = false
            if (w & 0xFFFF) == me {
                if len == 0xFFFFFFFFFFFFFFFF {
                    hit = true
                } else if exact {
                    hit = (base == addr) && (pages * PAGE <= len)
                } else {
                    hit = (base < addr + len) && (addr < base + pages * PAGE)
                }
            }
            if hit {
                file_shm_flush(state, (w >> 16) & 0xFFFF)
            }
        }
        k = k + 1
    }
}

fn map_file_shared(state: u64, me: u64, len: u64, flags: u64, fd: u64, off: u64, prot: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN || !readable(state, of) || !writable(state, of) {
        return neg(errno.E_ACCES)
    }
    if (flags & MAP_FIXED) != 0 || len > FSHM_MAX_PAGES * PAGE || off >= 0x7FFFFFFF000 {
        return neg(errno.E_NODEV)
    }
    let ino: u64 = file.open_ino(state, of)
    if ino >= 0xFFFFFFFE {
        return neg(errno.E_NODEV)
    }
    let first_pg: u64 = off / PAGE
    let npages: u64 = page_up(len) / PAGE
    var i: u64 = unixsock.shm_file_find(state, ino, first_pg)
    var made: bool = false
    if i >= unixsock.USHM_MAX {
        i = unixsock.shm_new(state)
        if i >= unixsock.USHM_PAGED {
            if i < unixsock.USHM_MAX {
                unixsock.shm_free(state, i)
            }
            return neg(errno.E_NOMEM)
        }
        made = true
    }
    let have: u64 = unixsock.shm_pages(state, i)
    if npages > have {
        let g: u64 = unixsock.shm_grow(state, i, npages)
        // the pages that exist now are filled in any case: a zero page inside the file that stays unfilled would be written over it later
        let ok: bool = file_shm_fill(state, i, ino, first_pg, have, unixsock.shm_pages(state, i))
        if g != 0 || !ok {
            if made {
                unixsock.shm_unref(state, i)
            }
            return neg(errno.E_NOMEM)
        }
    }
    if !unixsock.shm_wmap_take(state, i) {
        if made {
            unixsock.shm_unref(state, i)
        }
        return neg(errno.E_PERM)
    }
    let r: u64 = map_shm_obj(state, me, i, true, len, prot)
    if r >= 0xFFFFFFFFFFFFF000 {
        unixsock.shm_wmap_drop(state, i)
    }
    if made {
        if r < 0xFFFFFFFFFFFFF000 {
            unixsock.shm_file_mark(state, i, ino, first_pg)
        }
        // the reference of the creation goes: from here on only the mappings hold the object
        unixsock.shm_unref(state, i)
    }
    return r
}

const FLAZY_MIN_PAGES: u64 = 16

// Demand-paged private file mapping: the pages are lazy entries that carry (inode, file page); the first touch reads the file page
// into a frame of its own (proc.lazy_file_fault). 0 = not applicable (small, not a plain file, outside the lazy window): the eager path runs.
fn map_file_lazy(state: u64, me: u64, addr: u64, len: u64, prot: u64, flags: u64, of: u64, off: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_NOLAZY) || file.open_kind(state, of) != file.K_FILE {
        return 0
    }
    let ino: u64 = file.open_ino(state, of)
    let pages: u64 = page_up(len) / PAGE
    let fpg: u64 = off / PAGE
    if ino >= proc.LAZYF_MAX || pages < FLAZY_MIN_PAGES || fpg + pages >= proc.LAZYF_MAX {
        return 0
    }
    if (flags & MAP_FIXED) != 0 {
        if (addr & (PAGE - 1)) != 0 || addr < proc.LAZY_BASE || addr + pages * PAGE > proc.LAZY_TOP {
            return 0
        }
        let r: u64 = map_fixed_f(state, me, addr, pages, prot, ino + 1, fpg)
        if r >= 0xFFFFFFFFFFFFF000 {
            return 0
        }
        return r
    }
    let r: u64 = lazy_alloc_f(state, me, pages, prot, ino + 1, fpg)
    if r >= 0xFFFFFFFFFFFFF000 {
        return 0
    }
    return r
}

// RUNDE UNTERBAU: mmap of a regular file. There is no page cache and no demand paging in this kernel, so the pages are made now
// (zeroed) and filled with a read of the file -- what is beyond the end of the file stays zero. MAP_PRIVATE is exact (a copy the process
// may change). MAP_SHARED is a snapshot only: it is allowed read-only, and refused (-ENODEV, the old answer for "no file mapping") when
// it asks for write access, because a write would never reach the file or another process -- a half-truth is worse than the refusal.
fn map_file(state: u64, me: u64, addr: u64, len: u64, prot: u64, flags: u64, fd: u64, off: u64) -> u64 {
    if (off & (PAGE - 1)) != 0 || (off >> 63) != 0 {
        return neg(errno.E_INVAL)
    }
    if (flags & MAP_SHARED) != 0 && (flags & MAP_PRIVATE) == 0 && (prot & PROT_WRITE) != 0 {
        return map_file_shared(state, me, len, flags, fd, off, prot)
    }
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN || !readable(state, of) {
        return neg(errno.E_ACCES)
    }
    let lz: u64 = map_file_lazy(state, me, addr, len, prot, flags, of, off)
    if lz != 0 {
        return lz
    }
    var rw: u64 = PROT_READ | PROT_WRITE
    if (prot & PROT_EXEC) != 0 {
        rw = rw | PROT_EXEC
    }
    let base: u64 = map_anon(state, me, addr, len, rw, flags | MAP_ANONYMOUS)
    if base >= 0xFFFFFFFFFFFFF000 {
        return base
    }
    let saved_off: u64 = file.open_off(state, of)
    file.open_set_off(state, of, off)
    var done: u64 = 0
    while done < len {
        var chunk: u64 = len - done
        if chunk > 65536 {
            chunk = 65536
        }
        let r: u64 = do_read(state, me, fd, base + done, chunk)
        if r >= 0xFFFFFFFFFFFFF000 {
            file.open_set_off(state, of, saved_off)
            let _u: u64 = do_unmap(state, me, base, len)
            return r
        }
        if r == 0 {
            done = len
        } else {
            done = done + r
        }
    }
    file.open_set_off(state, of, saved_off)
    if (prot & 3) != 3 {
        let rr: u64 = set_range_prot(state, me, base, page_up(len) / PAGE, prot)
        if rr != 0 {
            return neg(errno.E_NOMEM)
        }
    }
    return base
}

// The ordinary allocation: the next free pages below the bump marks (see `do_map` before this round, which this is).
fn map_alloc(state: u64, me: u64, pages: u64, prot: u64) -> u64 {
    let top: u64 = map_bottom(state, me)
    if pages * PAGE > top {
        return big_map(state, me, pages, prot)
    }
    let base: u64 = top - pages * PAGE
    if base < page_up(brk_of(state, me)) + PAGE {
        // The bump region is used up. Before going to the big region, take
        // a hole that munmap left behind (see `hole`).
        let h: u64 = hole(state, me, top, MMAP_TOP, pages)
        if h != 0 {
            if !map_run(state, me, h, pages, prot) {
                return neg(errno.E_NOMEM)
            }
            return h
        }
        return big_map(state, me, pages, prot)
    }
    var p: u64 = base
    while p < top {
        if proc.map_page_zero(state, me, p, true, (prot & PROT_EXEC) != 0) == 0 {
            return neg(errno.E_NOMEM)
        }
        kstate.add(state, kstate.MAPS, 1)
        p = p + PAGE
    }
    sched.tset(state, mem_owner(state, me), sched.T_MMAP, base)
    return base
}

// 27.09.2026: mmap handed out addresses by moving a bottom mark down and
// never looked back -- munmap gave the FRAMES back, but not the addresses.
// A process that allocates and frees for a long time (jarvisd: a TLS
// session and a root store per bridge request) walked through the whole
// region; after ~120 requests in the VM every mmap failed, reading the root
// file failed ("no root store"), and the helper was gone for good -- the
// Dell's "clock runs, mouse moves, but offline". Only asked once the bump
// region is exhausted, so the normal path costs nothing.
fn hole(state: u64, me: u64, lo: u64, hi: u64, pages: u64) -> u64 {
    var run: u64 = 0
    var p: u64 = lo
    while p < hi {
        if proc.translate(state, me, p) == 0 {
            run = run + 1
            if run == pages {
                return p - (pages - 1) * PAGE
            }
        } else {
            run = 0
        }
        p = p + PAGE
    }
    return 0
}

fn map_run(state: u64, me: u64, base: u64, pages: u64, prot: u64) -> bool {
    var i: u64 = 0
    while i < pages {
        if proc.map_page_zero(state, me, base + i * PAGE, true,
            (prot & PROT_EXEC) != 0) == 0 {
            return false
        }
        kstate.add(state, kstate.MAPS, 1)
        i = i + 1
    }
    return true
}

// K-07: a writable mapping of a memfd takes a count on the object first (refused with -EPERM once F_SEAL_WRITE is set); the count is
// given back by `munmap` / exit (`unixsock.map_release*`, record flag UM_WRITE) or here when the mapping fails.
fn map_shm(state: u64, me: u64, of: u64, len: u64, prot: u64,
    off: u64) -> u64 {
    if (prot & PROT_WRITE) == 0 || file.open_kind(state, of) != file.K_SHM {
        return map_shm_do(state, me, of, len, prot, off)
    }
    let i: u64 = file.open_ino(state, of)
    if !unixsock.shm_wmap_take(state, i) {
        return neg(errno.E_PERM)
    }
    let r: u64 = map_shm_do(state, me, of, len, prot, off)
    if r >= 0xFFFFFFFFFFFFF000 {
        unixsock.shm_wmap_drop(state, i)
    }
    return r
}

fn map_shm_do(state: u64, me: u64, of: u64, len: u64, prot: u64,
    off: u64) -> u64 {
    if off != 0 {
        return neg(errno.E_INVAL)
    }
    return map_shm_obj(state, me, file.open_ino(state, of), writable(state, of), len, prot)
}

// The mapping of shared object `i` (a memfd, or since LCSH the shared pages of a file); `wok` = the caller may write the object.
fn map_shm_obj(state: u64, me: u64, i: u64, wok: bool, len: u64, prot: u64) -> u64 {
    if unixsock.shm_used(state, i) == 0 {
        return neg(errno.E_NODEV)
    }
    let pages: u64 = page_up(len) / PAGE
    if pages == 0 || pages > unixsock.shm_max_pages(state, i) {
        return neg(errno.E_INVAL)
    }
    // COMPOSITOR S3: a read-only object (the window table page) is never mapped writable
    if (prot & PROT_WRITE) != 0 && ((unixsock.shm_flags(state, i) & unixsock.SMF_RO) != 0 || !wok) {
        return neg(errno.E_ACCES)
    }
    // ... and the table of mappings must have room, so that the reference of this mapping can be given back
    if !unixsock.map_room(state) {
        return neg(errno.E_NOMEM)
    }
    if unixsock.shm_grow(state, i, pages) != 0 {
        return neg(errno.E_NOMEM)
    }
    let writing: bool = (prot & PROT_WRITE) != 0
    let top: u64 = map_bottom(state, me)
    var base: u64 = 0
    var is_big: bool = false
    // WP-DEMAND: an object with a sparse part is mapped in its own arena (above the main stack): only the pages that exist are mapped,
    // the rest is filled by the page-fault handler at the first touch (`unixsock.shm_fault`), so a 512 MiB memfd costs address space only.
    let lazy: bool = unixsock.shm_lazy(state, i)
    if lazy {
        base = unixsock.map_arena_find(state, me, pages, proc.SHM_ARENA_BASE, proc.SHM_ARENA_TOP)
        if base == 0 {
            return neg(errno.E_NOMEM)
        }
    } else if pages * PAGE <= top
        && top - pages * PAGE >= page_up(brk_of(state, me)) + PAGE {
        base = top - pages * PAGE
    } else {
        if kstate.mode_on(state, kstate.M_NOBIG) {
            return neg(errno.E_NOMEM)
        }
        let btop: u64 = big_bottom(state, me)
        if pages * PAGE > btop - proc.BIG_FLOOR {
            return neg(errno.E_NOMEM)
        }
        base = btop - pages * PAGE
        if base < proc.BIG_FLOOR {
            return neg(errno.E_NOMEM)
        }
        is_big = true
    }
    var p: u64 = 0
    while p < pages {
        let frame: u64 = unixsock.shm_frame(state, i, p)
        if frame == 0 && !lazy {
            return neg(errno.E_NOMEM)
        }
        if frame != 0 {
            if !proc.map_frame(state, me, base + p * PAGE, frame,
                writing) {
                return neg(errno.E_NOMEM)
            }
            kstate.add(state, kstate.MAPS, 1)
        }
        p = p + 1
    }
    unixsock.shm_ref(state, i)
    var note_flags: u64 = 0
    if lazy {
        note_flags = unixsock.UM_LAZY
    }
    if writing {
        note_flags = note_flags | unixsock.UM_WRITE
    }
    let _noted: bool = unixsock.map_note(state, me, i, base, pages, note_flags)
    if lazy {
        // the arena has no bump mark
    } else if is_big {
        sched.tset(state, mem_owner(state, me), sched.T_BIG, base)
    } else {
        sched.tset(state, mem_owner(state, me), sched.T_MMAP, base)
    }
    return base
}

fn map_fd(state: u64, me: u64, fd: u64, len: u64, prot: u64,
    off: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_NODEV)
    }
    if file.open_kind(state, of) == file.K_SHM {
        return map_shm(state, me, of, len, prot, off)
    }
    if file.open_kind(state, of) != file.K_FB {
        return neg(errno.E_NODEV)
    }
    if off != 0 {
        return neg(errno.E_INVAL)
    }
    if !gfx.fb_ready(state) {
        return neg(errno.E_NODEV)
    }
    if len > gfx.fb_bytes(state) {
        return neg(errno.E_INVAL)
    }
    let writing: bool = (prot & PROT_WRITE) != 0
    if writing {
        if !writable(state, of) {
            return neg(errno.E_ACCES)
        }
    }
    if !readable(state, of) {
        if !writing {
            return neg(errno.E_ACCES)
        }
    }
    if !proc.map_huge(state, me, gfx.fb_user_base(), gfx.fb_block(state), writing) {
        return neg(errno.E_NOMEM)
    }
    kstate.add(state, kstate.MAPS, 1)
    return gfx.fb_user_base() + gfx.fb_offset(state)
}

// ------------------------------------------------------------ RUNDE LIMITS3: PROT_NONE reservations
//
// `mmap(NULL, 256 MiB, PROT_NONE, MAP_NORESERVE)` is how JS engines and allocators reserve address space. Osum's mmap is eager (every
// page of the arena is a frame at once), so such a request would eat the arena for nothing. A reservation therefore is BOOKKEEPING only:
// a range at or above 4 GiB (RES_BASE), outside the 1 GiB window that has page tables, so every access is a #PF (the process dies, as
// on Linux for PROT_NONE); no frame, no page table. `munmap` releases (whole, head, tail or the middle of a range), `mprotect(PROT_NONE)`
// is a no-op, and `mprotect` to anything readable/writable inside a reservation is -ENOMEM: committing needs page tables above 4 GiB
// (open, roadmap). The table lives in the task record of the memory owner: T_RESV (768) holds RES_SLOTS pairs (start, length),
// T_RESNEXT (1008) the bump pointer. Adjacent new ranges are merged.
const RES_BASE: u64 = 0x200000000
const RES_TOP: u64 = 0x700000000000
const RES_MIN: u64 = 0x4000000 // 64 MiB: smaller ones stay ordinary (eager) mappings
const RES_MAX: u64 = 0x400000000 // 16 GiB per call
const RES_SLOTS: u64 = 14
const LAZY_MIN_PAGES: u64 = 256
const LAZY_RESERVE_PAGES: u64 = 524288

fn res_start(state: u64, owner: u64, k: u64) -> u64 {
    return sched.tget(state, owner, sched.T_RESV + k * 16)
}

fn res_len(state: u64, owner: u64, k: u64) -> u64 {
    return sched.tget(state, owner, sched.T_RESV + k * 16 + 8)
}

fn res_set(state: u64, owner: u64, k: u64, start: u64, len: u64) {
    sched.tset(state, owner, sched.T_RESV + k * 16, start)
    sched.tset(state, owner, sched.T_RESV + k * 16 + 8, len)
}

fn res_clear(state: u64, owner: u64) {
    var k: u64 = 0
    while k < RES_SLOTS {
        res_set(state, owner, k, 0, 0)
        k = k + 1
    }
    sched.tset(state, owner, sched.T_RESNEXT, 0)
    sched.tset(state, owner, sched.T_LAZY, 0)
}

fn res_add(state: u64, owner: u64, len: u64) -> u64 {
    var next: u64 = sched.tget(state, owner, sched.T_RESNEXT)
    if next < RES_BASE {
        next = RES_BASE
    }
    if next + len > RES_TOP {
        return neg(errno.E_NOMEM)
    }
    // merge with the range that ends exactly here
    var free_slot: u64 = RES_SLOTS
    var k: u64 = 0
    while k < RES_SLOTS {
        let l: u64 = res_len(state, owner, k)
        if l == 0 {
            if free_slot == RES_SLOTS {
                free_slot = k
            }
        } else {
            if res_start(state, owner, k) + l == next {
                res_set(state, owner, k, res_start(state, owner, k), l + len)
                sched.tset(state, owner, sched.T_RESNEXT, next + len)
                return next
            }
        }
        k = k + 1
    }
    if free_slot == RES_SLOTS {
        return neg(errno.E_NOMEM)
    }
    res_set(state, owner, free_slot, next, len)
    sched.tset(state, owner, sched.T_RESNEXT, next + len)
    return next
}

fn res_covers(state: u64, owner: u64, addr: u64, len: u64) -> bool {
    var k: u64 = 0
    while k < RES_SLOTS {
        let l: u64 = res_len(state, owner, k)
        let s: u64 = res_start(state, owner, k)
        if l != 0 && addr >= s && addr + len <= s + l {
            return true
        }
        k = k + 1
    }
    return false
}

// munmap inside the reservation area: the part that lies in a range is cut out; what is in no range is ignored (Linux: success).
fn res_remove(state: u64, owner: u64, addr: u64, len: u64) -> u64 {
    let end: u64 = addr + len
    var k: u64 = 0
    while k < RES_SLOTS {
        let l: u64 = res_len(state, owner, k)
        let s: u64 = res_start(state, owner, k)
        if l != 0 && addr < s + l && end > s {
            var cut_lo: u64 = s
            if addr > s {
                cut_lo = addr
            }
            var cut_hi: u64 = s + l
            if end < s + l {
                cut_hi = end
            }
            if cut_lo == s && cut_hi == s + l {
                res_set(state, owner, k, 0, 0)
            } else {
                if cut_lo == s {
                    res_set(state, owner, k, cut_hi, s + l - cut_hi)
                } else {
                    if cut_hi == s + l {
                        res_set(state, owner, k, s, cut_lo - s)
                    } else {
                        // middle: needs a free slot for the upper part
                        var f: u64 = RES_SLOTS
                        var j: u64 = 0
                        while j < RES_SLOTS {
                            if res_len(state, owner, j) == 0 {
                                f = j
                                j = RES_SLOTS
                            } else {
                                j = j + 1
                            }
                        }
                        if f == RES_SLOTS {
                            return neg(errno.E_NOMEM)
                        }
                        res_set(state, owner, k, s, cut_lo - s)
                        res_set(state, owner, f, cut_hi, s + l - cut_hi)
                    }
                }
            }
        }
        k = k + 1
    }
    return 0
}

// The pages go back, the bump pointer does not. A hole in the middle of a
// bump allocator is a free list, and that is the libc's business, not the
// kernel's -- written down as a gap in docs/ROUNDK4.md.
fn do_unmap(state: u64, me: u64, addr: u64, len: u64) -> u64 {
    if (addr & (PAGE - 1)) != 0 {
        return neg(errno.E_INVAL)
    }
    if len == 0 {
        return neg(errno.E_INVAL)
    }
    if addr >= RES_BASE {
        let rl: u64 = page_up(len)
        proc.range_drop(state, me, addr, addr + rl)
        let owner: u64 = mem_owner(state, me)
        let rr: u64 = res_remove(state, owner, addr, rl)
        if addr + rl == sched.tget(state, owner, sched.T_RESNEXT) {
            sched.tset(state, owner, sched.T_RESNEXT, addr)
        }
        return rr
    }
    let in_alt: bool = addr >= map_bottom(state, me) && addr < MMAP_TOP
    let in_big: bool = addr >= big_bottom(state, me) && addr < proc.BIG_TOP
    let in_arena: bool = addr >= proc.SHM_ARENA_BASE && addr < proc.SHM_ARENA_TOP
    let in_lazy: bool = addr >= proc.LAZY_BASE && addr < proc.LAZY_TOP
    if !in_alt && !in_big && !in_arena && !in_lazy {
        return neg(errno.E_INVAL)
    }
    // COMPOSITOR S3: a mapping of a shared object gives its reference back (LCSH: a file mapping writes back first)
    file_shm_flush_maps(state, me, addr, page_up(len), true)
    let _released: bool = unixsock.map_release(state, me, addr, page_up(len))
    var p: u64 = addr
    let end: u64 = addr + page_up(len)
    while p < end {
        if p < MMAP_TOP || p < proc.BIG_TOP || (p >= proc.SHM_ARENA_BASE && p < proc.SHM_ARENA_TOP) || (p >= proc.LAZY_BASE && p < proc.LAZY_TOP) {
            proc.page_drop(state, me, p)
        }
        p = p + PAGE
    }
    if in_lazy && addr == lazy_bottom(state, me) {
        var nb: u64 = end
        if nb >= proc.LAZY_ATOP {
            nb = 0
        }
        sched.tset(state, mem_owner(state, me), sched.T_LAZY, nb)
    }
    return 0
}

// ------------------------------------------------------------ the clock

// `nanosleep(request, remainder)`, and the request is a `struct timespec`:
// eight octets of seconds, eight of nanoseconds. The timer runs at 100 Hz,
// so ten milliseconds are the grain -- anything shorter is a yield.
//
// A DELIBERATE DEVIATION: more than sixty seconds is -EINVAL. Linux would
// sleep. A kernel that can be stopped for an hour by one number cannot be
// measured, and `tools/kernel/run.sh` has been checking that refusal since
// round 62.
fn do_nanosleep(state: u64, me: u64, req: u64) -> u64 {
    if !proc.user_ok(state, me, req, 16) {
        return neg(errno.E_FAULT)
    }
    let sec: u64 = user_word(state, me, req)
    let nsec: u64 = user_word(state, me, req + 8)
    if nsec >= 1000000000 {
        return neg(errno.E_INVAL)
    }
    if sec > 60 {
        return neg(errno.E_INVAL)
    }
    var ticks: u64 = sec * 100 + (nsec + 9999999) / 10000000
    // RUNDE UNTERBAU: ONE TICK MORE, as `poll` does it. The counter stands in the middle of the running tick when the call reads it, so a
    // sleep of N ticks lasted between N-1 and N ticks: `usleep(30000)` measured 24.7 ms (t_misc `monotonic_advances_with_sleep`), and a sleep
    // must never return EARLY (POSIX). A request of zero stays zero.
    if ticks != 0 {
        ticks = ticks + 1
    }
    let t0: u64 = kstate.get(state, kstate.TICKS)
    var guard: u64 = ticks + 8
    while guard > 0 {
        if signal.interrupted(state, me) {
            return neg(errno.E_INTR)
        }
        let now: u64 = kstate.get(state, kstate.TICKS)
        if now < t0 || now - t0 >= ticks {
            break
        }
        sched.sleep_ticks(state, ticks - (now - t0))
        guard = guard - 1
    }
    return 0
}

// ---------------------------------------------------- ROUND K9: die Uhr

fn do_clock_settime(state: u64, me: u64, clk: u64, tp: u64) -> u64 {
    if clk != time.CLOCK_REALTIME {
        return neg(errno.E_INVAL)
    }
    if !perm.is_root(state, me) {
        return neg(errno.E_PERM)
    }
    if !proc.user_ok(state, me, tp, 16) {
        return neg(errno.E_FAULT)
    }
    let sec: u64 = user_word(state, me, tp)
    let nsec: u64 = user_word(state, me, tp + 8)
    if nsec >= 1000000000 {
        return neg(errno.E_INVAL)
    }
    if !time.set_utc_ns(state, sec, nsec) {
        return neg(errno.E_INVAL)
    }
    let _w: bool = time.rtc_write(state)
    return 0
}

const NS_PER_USEC: u64 = 1000

// adjtimex(2), the part adjtime(3) needs: ADJ_OFFSET_SINGLESHOT slews the
// clock by `offset` microseconds (root only); mode 0 only reads. The rest of
// the structure is left alone.
fn do_adjtimex(state: u64, me: u64, tx: u64) -> u64 {
    if !proc.user_ok(state, me, tx, abi.TIMEX_BYTES) {
        return neg(errno.E_FAULT)
    }
    let modes: u64 = user_word32(state, me, tx + abi.TIMEX_MODES)
    if modes != 0 {
        if !perm.is_root(state, me) {
            return neg(errno.E_PERM)
        }
        if modes != abi.ADJ_OFFSET_SINGLESHOT {
            return neg(errno.E_INVAL)
        }
        let offset_us: u64 = user_word(state, me, tx + abi.TIMEX_OFFSET)
        if !time.slew_by(state, offset_us *% NS_PER_USEC) {
            return neg(errno.E_INVAL)
        }
    }
    let left_ns: u64 = time.slew_remaining(state)
    var left_us: u64 = left_ns / NS_PER_USEC
    if left_ns > 0x7FFFFFFFFFFFFFFF {
        left_us = 0 -% ((0 -% left_ns) / NS_PER_USEC)
    }
    let now_ns: u64 = time.real_ns(state)
    if !put64(state, me, tx + abi.TIMEX_OFFSET, left_us)
        || !put64(state, me, tx + abi.TIMEX_TIME_SEC, now_ns / time.NS_PER_SEC)
        || !put64(state, me, tx + abi.TIMEX_TIME_USEC, (now_ns % time.NS_PER_SEC) / NS_PER_USEC) {
        return neg(errno.E_FAULT)
    }
    if clockstate.state_of(state) == clockstate.CS_SET {
        return 0
    }
    return abi.TIME_ERROR
}

// DAILY-DRIVER: the zone as the display shows it. (standard offset in
// minutes, rule 0 = fixed / 1 = EU summer time). Any program may ask --
// it changes how the clock is SHOWN, never the time itself -- like the
// zone choice of the settings window, which runs as the user.
fn do_settz(state: u64, me: u64, minutes: u64, rule: u64) -> u64 {
    // N-004: `rule` = rule id (lib/tz/rules.fi) | (west << 8) | rtc flags;
    // `minutes` is the magnitude of the standard offset
    if minutes > 1440 || (rule & abi.SETTZ_RULE_MASK) > rules.RULE_MAX || rule > abi.SETTZ_ARG_MAX {
        return neg(errno.E_INVAL)
    }
    time.set_tz(state, minutes)
    time.set_tz_rule(state, rule & (abi.SETTZ_RULE_MASK | abi.SETTZ_WEST_BIT))
    if (rule & abi.SETTZ_RTC_SET_BIT) != 0 {
        time.set_rtc_utc(state, (rule & abi.SETTZ_RTC_UTC_BIT) / abi.SETTZ_RTC_UTC_BIT)
    }
    // r544: a boot line without `tz=` leaves the hardware clock unconverted;
    // the first zone that arrives (sntp boot from /etc/time.conf) does it,
    // once, as long as nobody has set the clock
    time.tz_anwenden(state)
    return 0
}

fn do_clock_gettime(state: u64, me: u64, clk_arg: u64, tp: u64) -> u64 {
    var clk: u64 = clk_arg
    if clk == abi.CLOCK_CHECKED {
        if !clockstate.trusted(state) {
            return neg(errno.E_NODATA)
        }
        clk = time.CLOCK_REALTIME
    }
    if clk > time.CLOCK_MAX {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, tp, 16) {
        return neg(errno.E_FAULT)
    }
    kstate.add(state, kstate.TIME_CALLS, 1)
    var ns: u64 = 0
    if clk == time.CLOCK_REALTIME || clk == time.CLOCK_REALTIME_COARSE {
        ns = time.real_ns(state)
    } else {
        ns = time.mono_ns(state)
    }
    if !put64(state, me, tp, ns / time.NS_PER_SEC) {
        return neg(errno.E_FAULT)
    }
    if !put64(state, me, tp + 8, ns % time.NS_PER_SEC) {
        return neg(errno.E_FAULT)
    }
    return 0
}

fn do_clock_getres(state: u64, me: u64, clk: u64, tp: u64) -> u64 {
    if clk > time.CLOCK_MAX {
        return neg(errno.E_INVAL)
    }
    if tp == 0 {
        return 0
    }
    if !proc.user_ok(state, me, tp, 16) {
        return neg(errno.E_FAULT)
    }
    var res: u64 = time.TICK_NS
    if time.khz(state) != 0 {
        res = 1
    }
    put64(state, me, tp, 0)
    put64(state, me, tp + 8, res)
    return 0
}

fn do_gettimeofday(state: u64, me: u64, tv: u64) -> u64 {
    if tv == 0 {
        return 0
    }
    if !proc.user_ok(state, me, tv, 16) {
        return neg(errno.E_FAULT)
    }
    let ns: u64 = time.real_ns(state)
    put64(state, me, tv, ns / time.NS_PER_SEC)
    put64(state, me, tv + 8, (ns % time.NS_PER_SEC) / 1000)
    return 0
}

fn do_time(state: u64, me: u64, out: u64) -> u64 {
    let secs: u64 = time.now_sec(state)
    if out != 0 {
        if !proc.user_ok(state, me, out, 8) {
            return neg(errno.E_FAULT)
        }
        put64(state, me, out, secs)
    }
    return secs
}

// ------------------------------------------------- ROUND K9: der Zufall

const GRND_NONBLOCK: u64 = 1
const GRND_RANDOM: u64 = 2
const GRND_INSECURE: u64 = 4
const GRND_KNOWN: u64 = 7

fn do_getrandom(state: u64, me: u64, buf: u64, want: u64, flags: u64) -> u64 {
    if (flags & GRND_KNOWN) != flags {
        return neg(errno.E_INVAL)
    }
    var len: u64 = want
    if len > MAX_IO {
        len = MAX_IO
    }
    if !proc.user_ok(state, me, buf, len) {
        return neg(errno.E_FAULT)
    }
    if len == 0 {
        return 0
    }
    if !randwait.wait_ready(state, (flags & (GRND_NONBLOCK | GRND_INSECURE)) != 0) {
        return neg(errno.E_AGAIN)
    }
    let bounce: u64 = blockb(state)
    if rand.bytes(state, bounce, len) != len {
        return neg(errno.E_AGAIN)
    }
    if !copy_out(state, me, buf, bounce, len) {
        return neg(errno.E_FAULT)
    }
    return len
}

// ----------------------------------------------- ROUND K9: die Terminals

fn do_ioctl(state: u64, me: u64, fd: u64, req_raw: u64, arg: u64) -> u64 {
    // the request is a 32-bit number: libc passes TIOCGPTN (0x80045430) as a negative int, sign-extended in the register
    let req: u64 = req_raw & 0xFFFFFFFF
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    // FIONBIO (0x5421): int on/off -> O_NONBLOCK on the open file. Python's settimeout() and many C libraries use it instead of fcntl;
    // without it sockets answered -ENOTTY (python create_connection: "[Errno 25] Not a tty").
    if req == 0x5421 {
        if arg == 0 || !proc.user_ok(state, me, arg, 4) {
            return neg(errno.E_FAULT)
        }
        let nb: u64 = blockb(state)
        if !copy_in(state, me, nb, arg, 4) {
            return neg(errno.E_FAULT)
        }
        var on: u64 = 0
        var k: u64 = 0
        while k < 4 {
            if (kstate.get8(nb + k) as u64) != 0 {
                on = 1
            }
            k = k + 1
        }
        if on != 0 {
            file.open_set_flags(state, of, file.open_flags(state, of) | UB_O_NONBLOCK)
        } else {
            file.open_set_flags(state, of, file.open_flags(state, of) & (~UB_O_NONBLOCK))
        }
        return 0
    }
    if req == 0x541B && (file.open_kind(state, of) == file.K_USOCK || file.open_kind(state, of) == file.K_PIPER) {
        let fk: u64 = file.open_kind(state, of)
        var avail: u64 = 0
        if fk == file.K_USOCK {
            let fus: u64 = file.open_ino(state, of)
            if unixsock.sock_kind(state, fus) == unixsock.UK_DGRAM {
                avail = unixsock.dgram_len(state, fus)
            } else {
                avail = unixsock.waiting(state, fus)
            }
        } else {
            avail = file.pipe_bytes(state, file.open_ino(state, of))
        }
        if arg == 0 || !proc.user_ok(state, me, arg, 4) {
            return neg(errno.E_FAULT)
        }
        let ab: u64 = blockb(state)
        kstate.set8(ab, (avail & 0xFF) as u8)
        kstate.set8(ab + 1, ((avail >> 8) & 0xFF) as u8)
        kstate.set8(ab + 2, ((avail >> 16) & 0xFF) as u8)
        kstate.set8(ab + 3, ((avail >> 24) & 0xFF) as u8)
        if !copy_out(state, me, arg, ab, 4) {
            return neg(errno.E_FAULT)
        }
        return 0
    }
    // ROUND STONES2: SIOCGIF* on a socket (busybox ifconfig): the one interface "eth0"
    // (musl's if_nametoindex asks on an AF_UNIX socket, so a local socket and a netlink socket answer too)
    if req >= 0x8910 && req <= 0x8950 && (file.open_kind(state, of) == file.K_SOCK || file.open_kind(state, of) == file.K_USOCK
        || file.open_kind(state, of) == file.K_NETLINK) {
        return do_ifioctl(state, me, req, arg)
    }
    let kind: u64 = file.open_kind(state, of)
    var t: u64 = tty.MAX_TTY
    if kind == file.K_CONIN || kind == file.K_CONOUT {
        t = tty_of(state, me)
    }
    if kind == file.K_TTY {
        t = file.open_ino(state, of)
    }
    // ROUND FOOT-1 (PTY ABI): requests that act on the CALLING TASK, not on the tty's data
    if t < tty.MAX_TTY && req == tty.TIOCSCTTY {
        // the caller must be a session leader (setsid first); the slave becomes its controlling terminal
        if sched.tget(state, me, sched.T_SID) != sched.tget(state, me, sched.T_PID) {
            return neg(errno.E_PERM)
        }
        sched.tset(state, me, sched.T_TTY, t + 1)
        tty.claim(state, t, sched.tget(state, me, sched.T_PGID))
        return 0
    }
    if t < tty.MAX_TTY && req == tty.TIOCNOTTY {
        sched.tset(state, me, sched.T_TTY, 0)
        return 0
    }
    if t < tty.MAX_TTY && req == tty.TIOCGSID {
        if arg == 0 || !proc.user_ok(state, me, arg, 4) {
            return neg(errno.E_FAULT)
        }
        let sb: u64 = blockb(state)
        kstate.set8(sb, (sched.tget(state, me, sched.T_SID) & 0xFF) as u8)
        kstate.set8(sb + 1, ((sched.tget(state, me, sched.T_SID) >> 8) & 0xFF) as u8)
        kstate.set8(sb + 2, ((sched.tget(state, me, sched.T_SID) >> 16) & 0xFF) as u8)
        kstate.set8(sb + 3, ((sched.tget(state, me, sched.T_SID) >> 24) & 0xFF) as u8)
        if !copy_out(state, me, arg, sb, 4) {
            return neg(errno.E_FAULT)
        }
        return 0
    }
    if t >= tty.MAX_TTY {
        return neg(errno.E_NOTTY)
    }
    let bounce: u64 = blockb(state)
    var size: u64 = 36
    if req == tty.TIOCGWINSZ || req == tty.TIOCSWINSZ {
        size = 8
    }
    if req == tty.TIOCGPGRP || req == tty.TIOCSPGRP || req == tty.TIOCGPTN || req == tty.TIOCSPTLCK || req == tty.TIOCGPTLCK {
        size = 4
    }
    if arg == 0 || !proc.user_ok(state, me, arg, size) {
        return neg(errno.E_FAULT)
    }
    if !copy_in(state, me, bounce, arg, size) {
        return neg(errno.E_FAULT)
    }
    let r: u64 = tty.do_ioctl(state, t, req, bounce)
    if errno.is_error(r) {
        return r
    }
    if !copy_out(state, me, arg, bounce, size) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// ==================================================================
// EXTRA TERMINAL WINDOWS (Dell 9020, 27.09.2026)
// ==================================================================
//
// Until now there was exactly one terminal: the kernel's console
// window. `/bin/term` calls SYS_OSUM_TERMNEW, which takes a free tty
// slot (console-like line discipline, window sink), opens a new
// terminal window bound to it and makes it the CALLER's controlling
// terminal. Its fds 0/1/2 are console descriptors that resolve through
// `tty_of`, so nothing else has to change: `term` then execs /bin/sh
// and every child inherits the tty (T_TTY is copied on fork/spawn).
//
// Closing the window: reads return 0 (the shell ends with "bye"),
// writes are swallowed, and the slot goes back once no task uses it.
static mut TERM_WIN: [u64; 24] = [0 as u64; 24] // window + 1 per tty slot (tty.MAX_TTY)

fn term_win_of(t: u64) -> u64 {
    if t >= tty.MAX_TTY {
        return 0
    }
    return TERM_WIN[t as usize]
}

fn term_gone(state: u64, t: u64) -> bool {
    let w: u64 = term_win_of(t)
    if w == 0 {
        return false
    }
    return !gfx.term_alive(state, w - 1, t)
}

// Does a task still have tty slot `t` as its controlling terminal?
fn tty_task_uses(state: u64, t: u64) -> bool {
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        if sched.tget(state, i, sched.T_STATE) != sched.S_FREE
            && sched.tget(state, i, sched.T_STATE) != sched.S_ZOMBIE
            && sched.tget(state, i, sched.T_TTY) == t + 1 {
            return true
        }
        i = i + 1
    }
    return false
}

fn pty_master_gone(state: u64, t: u64) -> bool {
    if tty.kind_of(state, t) != tty.K_PTY_SLAVE {
        return false
    }
    let m: u64 = tty.peer_of(state, t)
    return m < tty.MAX_TTY && !tty_file_uses(state, m)
}

// Does an open file entry still point at tty slot `t`?
fn tty_file_uses(state: u64, t: u64) -> bool {
    var i: u64 = 0
    while i < file.MAX_OPEN {
        if file.open_used(state, i) && file.open_kind(state, i) == file.K_TTY
            && file.open_ino(state, i) == t {
            return true
        }
        i = i + 1
    }
    return false
}

// r528: give back pty pairs (ssh sessions, openpty) once no open file and no task refers to either half. Before, a pair
// was never freed and eight openpty calls (or a few ssh logins) used up the whole tty table for the terminal windows too.
//
// A pair is only freed when it was seen unused by TWO passes in a row: `do_openpty` allocates the pair first and binds the
// open files a moment later, and a reap on another CPU must not take the fresh pair away in between.
static mut PTY_SEEN: [u64; 24] = [0 as u64; 24]

fn pty_reap(state: u64) {
    var t: u64 = 1
    while t < tty.MAX_TTY {
        if tty.valid(state, t) && tty.kind_of(state, t) == tty.K_PTY_SLAVE {
            let m: u64 = tty.peer_of(state, t)
            if m < tty.MAX_TTY
                && !tty_file_uses(state, t) && !tty_file_uses(state, m)
                && !tty_task_uses(state, t) && !tty_task_uses(state, m) {
                if PTY_SEEN[t as usize] == 0 {
                    PTY_SEEN[t as usize] = 1
                } else {
                    PTY_SEEN[t as usize] = 0
                    tty.release_pair(state, t)
                }
            } else {
                PTY_SEEN[t as usize] = 0
            }
        } else {
            PTY_SEEN[t as usize] = 0
        }
        t = t + 1
    }
}

// Give back the slots of closed windows nobody uses any more.
fn term_reap(state: u64) {
    var t: u64 = 1
    while t < tty.MAX_TTY {
        if term_gone(state, t) {
            if !tty_task_uses(state, t) {
                TERM_WIN[t as usize] = 0
                tty.release(state, t)
            }
        }
        t = t + 1
    }
    pty_reap(state)
}

fn do_termnew(state: u64, me: u64) -> u64 {
    // r5xx: no window server (headless boot) is told apart from "no free tty slot": /bin/term falls back to the console only
    // in the first case, and says so in the second (before, both ended in a silent second shell on the console).
    if !gfx.wm_ready(state) {
        return neg(errno.E_NOSYS)
    }
    term_reap(state)
    var t: u64 = tty.alloc_log(state)
    if t >= tty.MAX_TTY {
        // second pass: a pty freed only after two sightings
        term_reap(state)
        t = tty.alloc_log(state)
    }
    if t >= tty.MAX_TTY {
        return neg(errno.E_NFILE)
    }
    tty.set_sink(state, t, tty.SINK_WINDOW)
    let w: u64 = gfx.term_new(state, t)
    if w == 0xFFFFFFFF {
        tty.release(state, t)
        return neg(errno.E_NOMEM)
    }
    tty.set_window(state, t, w)
    TERM_WIN[t as usize] = w + 1
    sched.tset(state, me, sched.T_TTY, t + 1)
    return w
}

// ROUND FOOT-1 (PTY ABI): open("/dev/ptmx") -- the Linux way to a pty. One call makes a NEW pair and returns the MASTER; the slave
// is opened later by name (/dev/pts/N, N from TIOCGPTN). The pair is the same one `openpty` makes, so the reaper frees it the same way.
fn open_ptmx(state: u64, me: u64, flags: u64) -> u64 {
    pty_reap(state)
    var sl: u64 = tty.alloc_pair(state)
    if sl >= tty.MAX_TTY {
        pty_reap(state)
        sl = tty.alloc_pair(state)
    }
    if sl >= tty.MAX_TTY {
        return neg(errno.E_NFILE)
    }
    let m: u64 = tty.peer_of(state, sl)
    let ofm: u64 = file.open_alloc(state, file.K_TTY, m, flags)
    if ofm >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let fdm: u64 = file.fd_alloc(state, me, 0)
    if fdm >= file.MAX_FD {
        file.open_unref(state, ofm)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fdm, ofm)
    kstate.add(state, kstate.OPENS, 1)
    return fdm
}

// open("/dev/pts/N"): the slave half of pair N, if that pair is still there.
fn open_pts(state: u64, me: u64, slot: u64, flags: u64) -> u64 {
    if !tty.valid(state, slot) || tty.kind_of(state, slot) != tty.K_PTY_SLAVE {
        return neg(errno.E_NOENT)
    }
    let of: u64 = file.open_alloc(state, file.K_TTY, slot, flags)
    if of >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    kstate.add(state, kstate.OPENS, 1)
    return fd
}

fn do_openpty(state: u64, me: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, 8) {
        return neg(errno.E_FAULT)
    }
    pty_reap(state)
    var sl: u64 = tty.alloc_pair(state)
    if sl >= tty.MAX_TTY {
        pty_reap(state)
        sl = tty.alloc_pair(state)
    }
    if sl >= tty.MAX_TTY {
        return neg(errno.E_NFILE)
    }
    let m: u64 = tty.peer_of(state, sl)
    let ofm: u64 = file.open_alloc(state, file.K_TTY, m, O_RDWR)
    if ofm >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let ofs: u64 = file.open_alloc(state, file.K_TTY, sl, O_RDWR)
    if ofs >= file.MAX_OPEN {
        file.open_unref(state, ofm)
        return neg(errno.E_NFILE)
    }
    let fdm: u64 = file.fd_alloc(state, me, 0)
    if fdm >= file.MAX_FD {
        file.open_unref(state, ofm)
        file.open_unref(state, ofs)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fdm, ofm)
    let fds: u64 = file.fd_alloc(state, me, 0)
    if fds >= file.MAX_FD {
        file.fd_free(state, me, fdm)
        file.open_unref(state, ofm)
        file.open_unref(state, ofs)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fds, ofs)
    kstate.add(state, kstate.OPENS, 2)
    if !put32(state, me, out, fdm) {
        return neg(errno.E_FAULT)
    }
    if !put32(state, me, out + 4, fds) {
        return neg(errno.E_FAULT)
    }
    return 0
}

const SI_PENDING: u64 = 0
const SI_MASK: u64 = 1
const SI_LAST: u64 = 2
const SI_DELIVERED: u64 = 3
const SI_SENT: u64 = 4
const SI_CAUGHT: u64 = 5
const SI_DEFAULT: u64 = 6
const SI_STOPS: u64 = 7
const SI_MYCOUNT: u64 = 8
const SI_STOPPED: u64 = 9
const SI_TTYSIGS: u64 = 10
const SI_STATE_OF: u64 = 20
const SI_TICKS_OF: u64 = 21
const SI_PEND_OF: u64 = 22

fn do_siginfo(state: u64, me: u64, what: u64, arg: u64) -> u64 {
    if what >= SI_STATE_OF {
        let i: u64 = sched.find_pid(state, arg)
        if i >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
        if what == SI_STATE_OF {
            return sched.tget(state, i, sched.T_STATE)
        }
        if what == SI_TICKS_OF {
            return sched.tget(state, i, sched.T_TICKS)
        }
        if what == SI_PEND_OF {
            return sched.tget(state, i, sched.T_SIGPEND)
        }
        return neg(errno.E_INVAL)
    }
    if what == SI_PENDING {
        return sched.tget(state, me, sched.T_SIGPEND)
    }
    if what == SI_MASK {
        return sched.tget(state, me, sched.T_SIGMASK)
    }
    if what == SI_LAST {
        return sched.tget(state, me, sched.T_SIGLAST)
    }
    if what == SI_DELIVERED {
        return kstate.get(state, kstate.SIG_DELIVERED)
    }
    if what == SI_SENT {
        return kstate.get(state, kstate.SIG_SENT)
    }
    if what == SI_CAUGHT {
        return kstate.get(state, kstate.SIG_CAUGHT)
    }
    if what == SI_DEFAULT {
        return kstate.get(state, kstate.SIG_DEFAULT)
    }
    if what == SI_STOPS {
        return kstate.get(state, kstate.SIG_STOPS)
    }
    if what == SI_MYCOUNT {
        return sched.tget(state, me, sched.T_SIGDEL)
    }
    if what == SI_STOPPED {
        return signal.stopped_count(state)
    }
    if what == SI_TTYSIGS {
        return kstate.get(state, kstate.TTY_SIGS)
    }
    return neg(errno.E_INVAL)
}

fn get_user64(state: u64, me: u64, addr: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 8 {
        v = v | (peek(state, me, addr + i) << (i * 8))
        i = i + 1
    }
    return v
}

fn user_half(state: u64, me: u64, addr: u64) -> u64 {
    let phys: u64 = proc.translate(state, me, addr)
    if phys == 0 {
        return 0
    }
    guard.stac(state)
    let v: u64 = (kstate.get8(phys) as u64)
        | ((kstate.get8(phys + 1) as u64) << 8)
    guard.clac(state)
    return v
}

fn put_half(state: u64, me: u64, addr: u64, v: u64) -> bool {
    if !poke(state, me, addr, v & 255) {
        return false
    }
    return poke(state, me, addr + 1, (v >> 8) & 255)
}

fn put_word32(state: u64, me: u64, addr: u64, v: u64) -> bool {
    var i: u64 = 0
    while i < 4 {
        if !poke(state, me, addr + i, (v >> (i * 8)) & 255) {
            return false
        }
        i = i + 1
    }
    return true
}

fn put64(state: u64, me: u64, addr: u64, v: u64) -> bool {
    var i: u64 = 0
    while i < 8 {
        if !poke(state, me, addr + i, (v >> (i * 8)) & 255) {
            return false
        }
        i = i + 1
    }
    return true
}

// ------------------------------------------------------ processes

fn do_getppid(state: u64, me: u64) -> u64 {
    let p: u64 = sched.tget(state, me, sched.T_PARENT)
    return sched.tget(state, p, sched.T_PID)
}

// THE ONE THAT WAS MISSING. `fork` gives the child everything the parent
// has: a copy of every mapped page, the same open files, the same
// registers -- and a zero in rax, which is the only thing the two of them
// see differently.
fn clear_child_tid(state: u64, me: u64) {
    let addr: u64 = sched.tget(state, me, sched.T_FUTEX)
    if addr == 0 {
        return
    }
    sched.tset(state, me, sched.T_FUTEX, 0)
    let phys: u64 = proc.translate(state, me, addr)
    if phys == 0 {
        return
    }
    guard.stac(state)
    kstate.set8(phys, 0)
    kstate.set8(phys + 1, 0)
    kstate.set8(phys + 2, 0)
    kstate.set8(phys + 3, 0)
    guard.clac(state)
}

fn do_clone(state: u64, me: u64, frame: u64, flags: u64, stack_top: u64,
    ptid: u64, ctid: u64, tls: u64) -> u64 {
    if sched.tget(state, me, sched.T_KIND) != sched.K_USER {
        return neg(errno.E_NOSYS)
    }
    if (flags & CLONE_VM) == 0 || (flags & CLONE_THREAD) == 0 {
        return do_fork(state, me, frame, stack_top)
    }
    if stack_top == 0 {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, stack_top - 8, 8) {
        return neg(errno.E_FAULT)
    }
    // RUNDE UNTERBAU: THE FINISHED THREADS OF THIS PROCESS GO FIRST. A thread that ended stayed a corpse in the task table until
    // somebody called wait4 for it -- and nobody does, `pthread_join` waits on a futex word, not on wait4. The table has 32 slots,
    // so after about thirty threads over a process's life `pthread_create` failed with EAGAIN for good (measured: tools/unterbau,
    // t_threads `churn_64_threads`). Linux frees a non-leader thread by itself; here the next `clone` of the group does it.
    reap_dead_threads(state, me)
    let irq: u64 = sched.irq_save()
    let faden: u64 = proc.create_thread(state, me,
        sched.tget(state, me, sched.T_PRIO))
    if faden == 0 {
        sched.irq_restore(irq)
        return neg(errno.E_AGAIN)
    }
    if (flags & CLONE_FILES) != 0 {
        // LC-001: the thread USES the table of its group (and its close-on-exec marks) instead of a copy
        file.share_table(state, me, faden)
    } else {
        file.inherit_task(state, me, faden)
        cx_copy(state, me, faden)
    }
    sched.fpu_inherit(state, me, faden)
    signal.inherit(state, me, faden)
    sched.tset(state, faden, sched.T_CWD,
        sched.tget(state, me, sched.T_CWD))
    uio.adopt(state, me, faden)
    sched.tset(state, faden, sched.T_BRK, brk_of(state, me))
    sched.tset(state, faden, sched.T_MMAP, map_bottom(state, me))
    sched.tset(state, faden, sched.T_BIG, sched.tget(state, mem_owner(state, me), sched.T_BIG))
    sched.tset(state, faden, sched.T_USTACK, stack_top)
    netview.inherit(state, me, faden)
    ctr.inherit(state, me, faden)
    // AB-003: a thread is its process -- same origin.
    origin.inherit(state, me, faden)
    comm_inherit(state, me, faden)
    uio.exe_copy(state, me, faden)
    if (flags & CLONE_THREAD) != 0 {
        sched.tset(state, faden, sched.T_TGID,
            sched.tget(state, me, sched.T_TGID))
    }
    sched.tset(state, faden, sched.T_GSBASE, sched.tget(state, me, sched.T_GSBASE))
    if (flags & CLONE_SETTLS) != 0 {
        sched.tset(state, faden, sched.T_FSBASE, tls)
    }
    let new_tid: u64 = sched.tget(state, faden, sched.T_PID)
    if (flags & CLONE_PARENT_SETTID) != 0 {
        if proc.user_ok(state, me, ptid, 8) {
            put64(state, me, ptid, new_tid)
        }
    }
    if (flags & CLONE_CHILD_CLEARTID) != 0 {
        if proc.user_ok(state, me, ctid, 4) {
            sched.tset(state, faden, sched.T_FUTEX, ctid)
        }
    }
    let ctx: u64 = state + kstate.CTX_OFF + faden * F_BYTES
    var i: u64 = 0
    while i < F_BYTES / 8 {
        __mmio_write64((ctx + i * 8) as *mut u64,
            __mmio_read64((frame + i * 8) as *mut u64))
        i = i + 1
    }
    __mmio_write64((ctx + F_RAX) as *mut u64, 0)
    __mmio_write64((ctx + F_RSP) as *mut u64, stack_top)
    sched.tset(state, faden, sched.T_ARG, proc.ARG_RESUME)
    kstate.add(state, kstate.SPAWNS, 1)
    sched.start(state, faden)
    sched.irq_restore(irq)
    return new_tid
}

// `futex` lives in sched/futex.fi (real wait queue, r714).

fn user_word32(state: u64, me: u64, addr: u64) -> u64 {
    let phys: u64 = proc.translate(state, me, addr)
    if phys == 0 {
        return 0
    }
    guard.stac(state)
    let v: u64 = (kstate.get8(phys) as u64)
        | ((kstate.get8(phys + 1) as u64) << 8)
        | ((kstate.get8(phys + 2) as u64) << 16)
        | ((kstate.get8(phys + 3) as u64) << 24)
    guard.clac(state)
    return v
}

fn res_protect(state: u64, me: u64, addr: u64, pages: u64, prot: u64) -> u64 {
    var k: u64 = 0
    while k < pages {
        let a: u64 = addr + k * PAGE
        if proc.page_mapped(state, me, a) {
            let r: u64 = set_range_prot(state, me, a, 1, prot)
            if r == 2 {
                return neg(errno.E_ACCES)
            }
            if r != 0 {
                return neg(errno.E_NOMEM)
            }
        } else if prot != 0 {
            if !proc.lazy_mark(state, me, a, (prot & PROT_READ) != 0, (prot & PROT_WRITE) != 0, (prot & PROT_EXEC) != 0) {
                return neg(errno.E_NOMEM)
            }
        }
        k = k + 1
    }
    return 0
}

fn do_mprotect(state: u64, me: u64, addr: u64, len: u64, prot: u64) -> u64 {
    if (addr & 4095) != 0 {
        return neg(errno.E_INVAL)
    }
    if len == 0 {
        return 0
    }
    if (prot & (~7)) != 0 {
        return neg(errno.E_INVAL)
    }
    if addr >= RES_BASE {
        // a reservation has no pages: it stays PROT_NONE, committing part of it (RW) is not supported
        if !res_covers(state, mem_owner(state, me), addr, page_up(len)) {
            return neg(errno.E_NOMEM)
        }
        return res_protect(state, me, addr, page_up(len) / PAGE, prot)
    }
    if len > 0x400000000 {
        return neg(errno.E_NOMEM)
    }
    let pages: u64 = page_up(len) / PAGE
    var k: u64 = 0
    while k < pages {
        if !proc.page_mapped(state, me, addr + k * PAGE) {
            return neg(errno.E_NOMEM)
        }
        k = k + 1
    }
    let r: u64 = set_range_prot(state, me, addr, pages, prot)
    if r == 2 {
        return neg(errno.E_ACCES)
    }
    if r != 0 {
        return neg(errno.E_NOMEM)
    }
    return 0
}

fn do_fork(state: u64, me: u64, frame: u64, stack_top: u64) -> u64 {
    if sched.tget(state, me, sched.T_KIND) != sched.K_USER {
        return neg(errno.E_NOSYS)
    }
    // RUNDE UNTERBAU: the corpses of finished threads of this process leave first (a task slot is a task slot)
    reap_dead_threads(state, me)
    let flags: u64 = sched.irq_save()
    let child: u64 = proc.create_bare(state, sched.tget(state, me,
            sched.T_PRIO))
    if child == 0 {
        sched.irq_restore(flags)
        return neg(errno.E_AGAIN)
    }
    if proc.copy_space(state, me, child) == 0 {
        proc.discard(state, child)
        sched.irq_restore(flags)
        return neg(errno.E_NOMEM)
    }
    file.inherit_task(state, me, child)
    cx_copy(state, me, child)
    sched.fpu_inherit(state, me, child)
    signal.inherit(state, me, child)
    sched.tset(state, child, sched.T_CWD, sched.tget(state, me, sched.T_CWD))
    // ROUND K6: and the working directory as TEXT, which is what `getcwd`
    // prints and what a relative path is completed with.
    uio.adopt(state, me, child)
    sched.tset(state, child, sched.T_BRK, brk_of(state, me))
    sched.tset(state, child, sched.T_MMAP, map_bottom(state, me))
    sched.tset(state, child, sched.T_BIG, sched.tget(state, mem_owner(state, me), sched.T_BIG))
    sched.tset(state, child, sched.T_LAZY, sched.tget(state, mem_owner(state, me), sched.T_LAZY))
    netview.inherit(state, me, child)
    ctr.inherit(state, me, child)
    // AB-003: the origin is sticky -- a fork cannot shed it.
    origin.inherit(state, me, child)
    comm_inherit(state, me, child)
    uio.exe_copy(state, me, child)
    sched.tset(state, child, sched.T_USTACK, sched.tget(state, me, sched.T_USTACK))
    sched.tset(state, child, sched.T_FSBASE,
        sched.tget(state, me, sched.T_FSBASE))
    sched.tset(state, child, sched.T_GSBASE,
        sched.tget(state, me, sched.T_GSBASE))
    // The context the child comes back on. `proc.resume_start` hands this
    // copy to `user_resume` in isr.s.
    let ctx: u64 = state + kstate.CTX_OFF + child * F_BYTES
    var i: u64 = 0
    while i < F_BYTES / 8 {
        __mmio_write64((ctx + i * 8) as *mut u64,
            __mmio_read64((frame + i * 8) as *mut u64))
        i = i + 1
    }
    __mmio_write64((ctx + F_RAX) as *mut u64, 0)
    if stack_top != 0 {
        __mmio_write64((ctx + F_RSP) as *mut u64, stack_top)
    }
    sched.tset(state, child, sched.T_ARG, proc.ARG_RESUME)
    kstate.add(state, kstate.SPAWNS, 1)
    kstate.add(state, kstate.FORKS, 1)
    sched.start(state, child)
    sched.irq_restore(flags)
    return sched.tget(state, child, sched.T_PID)
}

// `execve(path, argv, envp)` -- the caller BECOMES the program. The
// environment is read and dropped: Osum has none yet, and a program that
// hands one over is not refused for it (docs/ROUNDK4.md).
//
// How the image gets in without a copy-on-write page fault handler: the
// loader builds a WHOLE NEW process for the file, the two swap address
// spaces, and the empty shell of the loader's process is discarded --
// which frees exactly the old image. Nothing else in the task changes:
// same pid, same parent, same descriptors, and that is what `execve`
// promises.
fn do_execve(state: u64, me: u64, frame: u64, path: u64, argv: u64, envp: u64) -> u64 {
    signal.exec_reset(state, me)
    sched.fpu_reset(state, me)
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if sched.tget(state, me, sched.T_KIND) != sched.K_USER {
        return neg(errno.E_NOSYS)
    }
    let name: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, path, name, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if len == 0 {
        return neg(errno.E_NOENT)
    }
    let abuf: u64 = cpu.earg_buf(state)
    var at: u64 = 0
    var argc: u64 = 0
    if argv != 0 {
        var going: bool = true
        while going {
            // the terminating 0 may sit in slot MAX_ARGS: eight words
            // plus the end mark, not seven (a NULL-terminated argv)
            if argc > proc.MAX_ARGS {
                return neg(errno.E_2BIG)
            }
            if !proc.user_ok(state, me, argv + argc * 8, 8) {
                return neg(errno.E_FAULT)
            }
            let p: u64 = user_word(state, me, argv + argc * 8)
            if p == 0 {
                going = false
            } else {
                if argc >= proc.MAX_ARGS {
                    return neg(errno.E_2BIG)
                }
                if at + MAX_ARG + 1 > kstate.EARG_MAX {
                    return neg(errno.E_2BIG)
                }
                let n: u64 = fetch_name(state, me, p, abuf + at, MAX_ARG)
                if errno.is_error(n) {
                    return n
                }
                at = at + n + 1
                argc = argc + 1
            }
        }
    }
    // RUNDE UNTERBAU: THE ENVIRONMENT OF `execve`. The kernel holds ONE environment block (a shell fills it with SYS_OSUM_SETENV, every
    // program started afterwards finds it on its argument page) and `execve` ignored its third argument: a child started with
    // `execve(path, argv, envp)` never saw `envp` (measured: t_proc `exec_args_env_stdout`, WAYLAND_DISPLAY and XDG_RUNTIME_DIR would
    // not reach a child either). Now the block is replaced by `envp` for the one program start and put back afterwards. Limits are those
    // of the argument page: 16 strings, ENV_MAX octets together; the rest of `envp` is dropped.
    var env_saved: u64 = 0
    var old_n: u64 = 0
    var old_len: u64 = 0
    if envp != 0 {
        env_saved = mem.kalloc(state, kstate.ENV_MAX + 16)
        if env_saved != 0 {
            let blk: u64 = state + kstate.K11_OFF + kstate.ENV_BUF
            old_n = kstate.get(state, kstate.K11_OFF + kstate.ENV_N)
            old_len = kstate.get(state, kstate.K11_OFF + kstate.ENV_LEN)
            var ci: u64 = 0
            while ci < old_len && ci < kstate.ENV_MAX {
                kstate.set8(env_saved + ci, kstate.get8(blk + ci) as u8)
                ci = ci + 1
            }
            var eat: u64 = 0
            var ecnt: u64 = 0
            var egoing: bool = true
            while egoing && ecnt < elf.STACK_ENV_MAXN {
                if !proc.user_ok(state, me, envp + ecnt * 8, 8) {
                    egoing = false
                } else {
                    let ep: u64 = user_word(state, me, envp + ecnt * 8)
                    if ep == 0 || eat + MAX_ARG + 1 > kstate.ENV_MAX {
                        egoing = false
                    } else {
                        let en: u64 = fetch_name(state, me, ep, blk + eat, MAX_ARG)
                        if errno.is_error(en) {
                            egoing = false
                        } else {
                            eat = eat + en + 1
                            ecnt = ecnt + 1
                        }
                    }
                }
            }
            kstate.set(state, kstate.K11_OFF + kstate.ENV_N, ecnt)
            kstate.set(state, kstate.K11_OFF + kstate.ENV_LEN, eat)
        }
    }
    let flags: u64 = sched.irq_save()
    // r334: one program start at a time on the whole machine.
    let lk: u64 = elf.lock_enter(state)
    let t: u64 = elf.build(state, name, abuf, argc, sched.tget(state, me,
            sched.T_PRIO))
    elf.lock_leave(state, lk)
    if env_saved != 0 {
        // the new image has copied the block onto its argument page: the old block goes back
        let blk2: u64 = state + kstate.K11_OFF + kstate.ENV_BUF
        var cj: u64 = 0
        while cj < old_len && cj < kstate.ENV_MAX {
            kstate.set8(blk2 + cj, kstate.get8(env_saved + cj) as u8)
            cj = cj + 1
        }
        kstate.set(state, kstate.K11_OFF + kstate.ENV_N, old_n)
        kstate.set(state, kstate.K11_OFF + kstate.ENV_LEN, old_len)
        mem.kfree(state, env_saved)
    }
    if t == 0 {
        sched.irq_restore(flags)
        let why: u64 = kstate.get(state, kstate.ELF_ERR)
        return neg(elf.errno_of(why))
    }
    let entry: u64 = sched.tget(state, t, sched.T_ENTRY)
    let ustack: u64 = sched.tget(state, t, sched.T_USTACK)
    let args: u64 = sched.tget(state, t, sched.T_WORK)
    sched.tset(state, me, sched.T_EUID, sched.tget(state, t, sched.T_EUID))
    sched.tset(state, me, sched.T_EGID, sched.tget(state, t, sched.T_EGID))
    sched.tset(state, me, sched.T_SUID, sched.tget(state, t, sched.T_SUID))
    sched.tset(state, me, sched.T_SGID, sched.tget(state, t, sched.T_SGID))
    // AB-003: `elf.build` gave the new image its origin (the caller's
    // label, or `app:<name>` for a program in an app bundle); `execve`
    // is not a new process, so it moves over like the four words above.
    origin.inherit(state, t, me)
    uio.interp_copy(state, t, me)
    cx_close_marked(state, me)
    proc.swap_space(state, me, t)
    // The new tables FIRST, then the old ones are freed -- in that order,
    // because the processor is standing in the old ones right now.
    proc.use_space(state, me)
    proc.discard(state, t)
    sched.tset(state, me, sched.T_ENTRY, entry)
    sched.tset(state, me, sched.T_USTACK, ustack)
    sched.tset(state, me, sched.T_FSBASE, 0)
    sched.tset(state, me, sched.T_GSBASE, 0)
    sched.fsbase_apply(state, me)
    sched.tset(state, me, sched.T_BRK, 0)
    sched.tset(state, me, sched.T_MMAP, 0)
    sched.tset(state, me, sched.T_BIG, 0)
    res_clear(state, me)
    // What ring 3 finds on the way out: a program at its entry point with
    // the argument block in rdi and nothing else left over from the
    // caller. Everything a process could have hidden in a register is gone
    // -- the image is new, and so is its state.
    var i: u64 = 0
    while i < F_BYTES / 8 {
        __mmio_write64((frame + i * 8) as *mut u64, 0)
        i = i + 1
    }
    fset(frame, F_RIP, entry)
    fset(frame, F_RSP, ustack)
    fset(frame, F_RDI, args)
    fset(frame, F_RFLAGS, 0x202)
    // ROUND POWERMON: the process is a different program from this
    // instruction on. Its power record starts again, and it starts with
    // the new name -- otherwise `sh` would carry away everything the
    // program it exec'd into ever spent, which is the plainest form of
    // the lie this round exists to avoid.
    pmon.task_clear(state, me, sched.tget(state, me, sched.T_PID))
    comm_from_path(state, me, name)
    uio.exe_set(state, me, name)
    pmon.name_set(state, me, name)
    kstate.add(state, kstate.EXECVES, 1)
    // ROUND NETMON: THE SLOT KEPT ITS PID AND CHANGED ITS PROGRAM.
    // Everything the old image used belonged to the old image; carrying
    // it over would tell the person that `sh` downloaded a hundred
    // megabytes because it `exec`ed `wget`.
    netmon.task_clear(state, me, sched.tget(state, me, sched.T_PID))
    netmon.name_set(state, me, name)
    // ROUND A11Y-2: the rights of the accessibility tree fall -- they
    // were given to the program that is gone (the spawn paths drop them
    // in ldr/elf.fi; execve keeps its slot and does not pass there).
    // Measured: before this line the new program still had mine=3.
    ax.drop_perm(state, me)
    sched.irq_restore(flags)
    return 0
}

// `wait4(pid, status, options, rusage)`. The status is the Linux one: the
// exit code sits in bits 8..15, so `WEXITSTATUS` is a shift by eight. What
// comes back is the PID of the child, not its code -- round 62's `wait`
// returned the code, and a caller could not tell -1 from a child that
// exited with 255.
fn do_wait4(state: u64, me: u64, pid: u64, status: u64, options: u64) -> u64 {
    if status != 0 {
        if !proc.user_ok(state, me, status, 4) {
            return neg(errno.E_FAULT)
        }
    }
    // -1 means "any child" in Linux; in an unsigned register that is
    // 0xFFFFFFFFFFFFFFFF, and 0 has meant the same thing here since round
    // 62.
    var want: u64 = pid
    if want == (0 -% 1) {
        want = 0
    }
    var rounds: u64 = 0
    while rounds < 100000 {
        if signal.handler_of(state, me, signal.SIGCHLD) == signal.SIG_IGN {
            var zi: u64 = find_zombie_child(state, me, 0)
            var zn: u64 = 0
            while zi < kstate.MAX_TASKS && zn < 64 {
                proc.reap(state, zi)
                zn = zn + 1
                zi = find_zombie_child(state, me, 0)
            }
        }
        var child: u64 = kstate.MAX_TASKS
        if kstate.mode_on(state, kstate.M_WAITOLD) {
            child = find_child(state, me, want)
            if child >= kstate.MAX_TASKS {
                return neg(errno.E_CHILD)
            }
        } else {
            child = find_zombie_child(state, me, want)
            if child >= kstate.MAX_TASKS {
                if find_child(state, me, want) >= kstate.MAX_TASKS {
                    return neg(errno.E_CHILD)
                }
            }
        }
        if child < kstate.MAX_TASKS
            && sched.tget(state, child, sched.T_STATE) == sched.S_ZOMBIE {
            let code: u64 = sched.tget(state, child, sched.T_EXIT)
            let who: u64 = sched.tget(state, child, sched.T_PID)
            // (the descriptors are closed inside proc.reap, by the caller
            // that wins the claim -- DELL STABILITY)
            proc.reap(state, child)
            if status != 0 {
                // RUNDE UNTERBAU: a task that died of a signal reports it the way POSIX does -- the signal number in the low bits (WIFSIGNALED,
                // WTERMSIG) -- and not as an exit with code 128 + n. Everything else keeps `exit code << 8`.
                // ONLY for the waiter that is a libc program (it has set its thread pointer: T_FSBASE != 0). The programs of this system read
                // `(status >> 8) & 255` and have measured 128 + n there since round 62; for them nothing changes.
                var st: u64 = (code & 255) << 8
                let sl: u64 = sched.tget(state, child, sched.T_SIGLAST)
                if (sl & 256) != 0 && sched.tget(state, me, sched.T_FSBASE) != 0 {
                    st = sl & 127
                }
                if !put32(state, me, status, st) {
                    return neg(errno.E_FAULT)
                }
            }
            return who
        }
        if (options & WUNTRACED) != 0 {
            let stopped: u64 = sched.stopped_child(state, me, want)
            if stopped < kstate.MAX_TASKS {
                let who: u64 = sched.tget(state, stopped, sched.T_PID)
                let sig: u64 = sched.stop_claim(state, stopped)
                if sig != 0 {
                    if status != 0 {
                        if !put32(state, me, status, (sig << 8) | 127) {
                            return neg(errno.E_FAULT)
                        }
                    }
                    return who
                }
            }
        }
        if (options & WNOHANG) != 0 {
            return 0
        }
        // State and switch under one lock hold -- see sched.wait_sleep.
        sched.wait_sleep(state, want, options & WUNTRACED)
        rounds = rounds + 1
    }
    return neg(errno.E_CHILD)
}

fn find_zombie_child(state: u64, me: u64, pid: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if sched.tget(state, i, sched.T_STATE) == sched.S_ZOMBIE {
            if sched.tget(state, i, sched.T_PARENT) == me {
                if (pid == 0 || sched.tget(state, i, sched.T_PID) == pid) && !sched.group_live(state, i) {
                    return i
                }
            }
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

// The index of a child, or MAX_TASKS. `pid` 0 means: any of them.
fn find_child(state: u64, me: u64, pid: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if sched.tget(state, i, sched.T_STATE) != sched.S_FREE {
            if sched.tget(state, i, sched.T_PARENT) == me {
                if pid == 0 || sched.tget(state, i, sched.T_PID) == pid {
                    return i
                }
            }
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

// ------------------------------------------------- the two Osum calls

const P_BUSB_SPAWN: u64 = 61

fn do_spawn(state: u64, me: u64, prog: u64, arg: u64) -> u64 {
    if prog == 0 || (prog > 16 && prog != P_BUSB_SPAWN) {
        return neg(errno.E_INVAL)
    }
    let i: u64 = proc.create(state, prog, arg, 2)
    if i == 0 {
        return neg(errno.E_NOMEM)
    }
    netview.inherit(state, me, i)
    ctr.inherit(state, me, i)
    origin.inherit(state, me, i)
    return sched.tget(state, i, sched.T_PID)
}

// `exec(path, argv, argc)` -- a program off the disk, in a process of its
// own, the way round K1 built it. Everything the process will need is
// copied into the KERNEL before a single frame is taken: the path and
// every argument. `elf.spawn` builds an address space and pours the file
// into it, and it may not be holding a pointer of ring 3 while it does
// that -- the caller could be swapped out, killed, or simply lying.
fn do_exec(state: u64, me: u64, path: u64, argv: u64, argc: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if argc > proc.MAX_ARGS {
        return neg(errno.E_2BIG)
    }
    let name: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, path, name, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if len == 0 {
        return neg(errno.E_INVAL)
    }
    let abuf: u64 = cpu.earg_buf(state)
    var at: u64 = 0
    var k: u64 = 0
    while k < argc {
        if !proc.user_ok(state, me, argv + k * 8, 8) {
            return neg(errno.E_FAULT)
        }
        if at + MAX_ARG + 1 > kstate.EARG_MAX {
            return neg(errno.E_2BIG)
        }
        let n: u64 = fetch_name(state, me,
            user_word(state, me, argv + k * 8), abuf + at, MAX_ARG)
        if errno.is_error(n) {
            return n
        }
        at = at + n + 1
        k = k + 1
    }
    // ROUND POWERMON does not hook here: `elf.spawn` goes through
    // `elf.build`, and the naming sits there so that all six ways of
    // starting a program are covered by one line instead of five.
    let t: u64 = elf.spawn(state, name, abuf, argc, 2)
    if t == 0 {
        let why: u64 = kstate.get(state, kstate.ELF_ERR)
        elf.say_reason(why)
        return neg(elf.errno_of(why))
    }
    netview.inherit(state, me, t)
    ctr.inherit(state, me, t)
    // ROUND NETMON: a new task, a fresh set of counters, and the name
    // of the program they are counted under.
    netmon.task_clear(state, t, sched.tget(state, t, sched.T_PID))
    netmon.name_set(state, t, name)
    return sched.tget(state, t, sched.T_PID)
}

// ROUND SESSUID: `exec` for the session (see SYS_OSUM_EXECAS above). The
// mark lives on the caller's own task word for exactly the length of
// `do_exec`; `sched.create` turns it into the child's identity.
// Nothing here can raise a privilege: mode 0 only ever LOWERS the child
// (a non-root caller gets a plain `exec`), mode 1 refuses non-root.
fn do_exec_as(state: u64, me: u64, path: u64, argv: u64, packed: u64) -> u64 {
    let argc: u64 = packed & 0xFFFF
    let mode: u64 = (packed >> 16) & 0xFFFF
    if mode > EXECAS_PRIV {
        return neg(errno.E_INVAL)
    }
    let euid: u64 = sched.tget(state, me, sched.T_EUID)
    if mode == EXECAS_PRIV {
        if euid != 0 {
            var s_no: [u8; 24] = "execas: priv refused\n\0\0\0"
            serial.puts((&s_no[0]) as u64)
            return neg(errno.E_PERM)
        }
        let rp: u64 = do_exec(state, me, path, argv, argc)
        var s_pv: [u8; 18] = "execas: priv pid=\0"
        var s_pf: [u8; 19] = "execas: priv fail\n\0"
        if errno.is_error(rp) {
            serial.puts((&s_pf[0]) as u64)
        } else {
            serial.puts((&s_pv[0]) as u64)
            serial.dec(rp)
            serial.nl()
        }
        return rp
    }
    if euid != 0 || kstate.get(state, kstate.K11_OFF + kstate.SP_UID) == 0 {
        return do_exec(state, me, path, argv, argc)
    }
    sched.tset(state, me, sched.T_EXAS, 1)
    let r: u64 = do_exec(state, me, path, argv, argc)
    sched.tset(state, me, sched.T_EXAS, 0)
    // The trail (gate tools/sessuid): which identity the child really got.
    if !errno.is_error(r) {
        let sl: u64 = sched.find_pid(state, r)
        if sl < kstate.MAX_TASKS {
            var s_u: [u8; 18] = "execas: user pid=\0"
            var s_i: [u8; 6] = " uid=\0"
            serial.puts((&s_u[0]) as u64)
            serial.dec(r)
            serial.puts((&s_i[0]) as u64)
            serial.dec(sched.tget(state, sl, sched.T_UID))
            serial.nl()
        }
    }
    return r
}

// ============================================================ Runde K11

fn do_setenv(state: u64, me: u64, buf: u64, len: u64) -> u64 {
    if len > kstate.ENV_MAX {
        return neg(errno.E_2BIG)
    }
    if len != 0 && !proc.user_ok(state, me, buf, len) {
        return neg(errno.E_FAULT)
    }
    let dst: u64 = state + kstate.K11_OFF + kstate.ENV_BUF
    var i: u64 = 0
    var n: u64 = 0
    while i < len {
        let c: u64 = peek(state, me, buf + i)
        kstate.set8(dst + i, c as u8)
        if c == 0 {
            n = n + 1
        }
        i = i + 1
    }
    kstate.set(state, kstate.K11_OFF + kstate.ENV_N, n)
    kstate.set(state, kstate.K11_OFF + kstate.ENV_LEN, len)
    return n
}

// ==================================================== RUNDE K14

fn name_is(state: u64, p: u64, lit: u64) -> bool {
    var i: u64 = 0
    while kstate.get8(p + i) != 0 && kstate.get8(lit + i) != 0 {
        if kstate.get8(p + i) != kstate.get8(lit + i) {
            return false
        }
        i = i + 1
    }
    return kstate.get8(p + i) == kstate.get8(lit + i)
}

fn fstype_of(state: u64, p: u64) -> u64 {
    var a: [u8; 4] = "ofs␀"
    var b: [u8; 5] = "proc␀"
    var c: [u8; 6] = "devfs␀"
    var d: [u8; 5] = "vfat␀"
    var e: [u8; 6] = "fat32␀"
    var f: [u8; 5] = "ext4␀"
    var g: [u8; 5] = "ntfs␀"
    var h: [u8; 5] = "ext2␀"
    var i: [u8; 5] = "ext3␀"
    var j: [u8; 6] = "exfat␀"
    if name_is(state, p, (&a[0]) as u64) {
        return vfsops.FS_OFS
    }
    if name_is(state, p, (&b[0]) as u64) {
        return vfsops.FS_PROC
    }
    if name_is(state, p, (&c[0]) as u64) {
        return vfsops.FS_DEV
    }
    if name_is(state, p, (&d[0]) as u64) || name_is(state, p, (&e[0]) as u64) {
        return vfsops.FS_FAT
    }
    if name_is(state, p, (&f[0]) as u64) || name_is(state, p, (&h[0]) as u64)
        || name_is(state, p, (&i[0]) as u64) {
        return vfsops.FS_EXT4
    }
    if name_is(state, p, (&g[0]) as u64) {
        return vfsops.FS_NTFS
    }
    if name_is(state, p, (&j[0]) as u64) {
        return vfsops.FS_EXFAT
    }
    return vfsops.FS_NONE
}

fn source_dev(state: u64, p: u64, out_part: u64) -> u64 {
    var n_hda: [u8; 9] = "/dev/hda␀"
    var n_hdb: [u8; 9] = "/dev/hdb␀"
    var n_ram: [u8; 10] = "/dev/ram0␀"
    var n_nvme: [u8; 11] = "/dev/nvme0␀"
    var n_usb: [u8; 9] = "/dev/usb␀"
    var n_sda: [u8; 9] = "/dev/sda␀"
    var base: [u8; 32] = [0 as u8; 32]
    var n: u64 = 0
    while kstate.get8(p + n) != 0 && n < 31 {
        base[n as usize] = kstate.get8(p + n) as u8
        n = n + 1
    }
    base[n as usize] = 0 as u8
    __mmio_write64(out_part as *mut u64, 0)
    if name_is(state, (&base[0]) as u64, (&n_ram[0]) as u64) {
        return blk.DEV_RAM
    }
    if name_is(state, (&base[0]) as u64, (&n_nvme[0]) as u64) {
        return blk.DEV_NVME
    }
    if n > 1 {
        let last: u64 = base[(n - 1) as usize] as u64
        if last >= 49 && last <= 57 {
            __mmio_write64(out_part as *mut u64, last - 48)
            base[(n - 1) as usize] = 0 as u8
        }
    }
    if name_is(state, (&base[0]) as u64, (&n_hda[0]) as u64) {
        return blk.DEV_ATA
    }
    if name_is(state, (&base[0]) as u64, (&n_hdb[0]) as u64) {
        return blk.DEV_ATA1
    }
    if name_is(state, (&base[0]) as u64, (&n_usb[0]) as u64) {
        return blk.DEV_USB
    }
    // The AHCI disk (/dev/sda, /dev/sda1 = its first partition). Same
    // naming rule as hdb/hdb1; the controller is brought up on demand.
    if name_is(state, (&base[0]) as u64, (&n_sda[0]) as u64) {
        if !blk.ahci_ready(state) {
            return 99
        }
        return blk.DEV_AHCI
    }
    return 99
}

fn do_vfs_mount(state: u64, me: u64, src: u64, target: u64, kind: u64,
    flags: u64) -> u64 {
    if !vfs.ready(state) {
        return neg(errno.E_NOSYS)
    }
    if (flags & 0xFFFFFFFFFFFFFFFE) != 0 {
        return neg(errno.E_INVAL)
    }
    let sbuf: u64 = nameb(state) + 1024
    let tbuf: u64 = nameb(state)
    let kbuf: u64 = nameb(state) + NB_FSTYPE
    if errno.is_error(fetch_name(state, me, src, sbuf, 64)) {
        return neg(errno.E_FAULT)
    }
    let tl: u64 = fetch_path(state, me, target, tbuf, MAX_NAME)
    if errno.is_error(tl) {
        return tl
    }
    if errno.is_error(fetch_name(state, me, kind, kbuf, 32)) {
        return neg(errno.E_FAULT)
    }
    let ft: u64 = fstype_of(state, kbuf)
    if ft == vfsops.FS_NONE {
        return neg(errno.E_NODEV)
    }
    var mflags: u64 = 0
    if (flags & MNT_RDONLY) != 0 {
        mflags = mnt.F_RDONLY
    }
    var dev: u64 = 0
    var first: u64 = 0
    var count: u64 = 0
    if ft == vfsops.FS_FAT || ft == vfsops.FS_OFS
        || ft == vfsops.FS_EXT4 || ft == vfsops.FS_NTFS
        || ft == vfsops.FS_EXFAT {
        var pnum: u64 = 0
        dev = source_dev(state, sbuf, (&pnum) as u64)
        if dev == 99 {
            return neg(errno.E_NODEV)
        }
        if pnum == 0 {
            first = 0
            count = blk.blocks_on(state, dev)
        } else {
            if part.scan(state, dev) == 0 {
                return neg(errno.E_NODEV)
            }
            var found: u64 = part.MAX_PARTS
            var i: u64 = 0
            var seen: u64 = 0
            while i < part.MAX_PARTS {
                if part.index_of(state, i) != 0 {
                    if part.dev_of(state, i) == dev {
                        seen = seen + 1
                        if seen == pnum {
                            found = i
                            i = part.MAX_PARTS
                        }
                    }
                }
                if i < part.MAX_PARTS {
                    i = i + 1
                }
            }
            if found >= part.MAX_PARTS {
                return neg(errno.E_NODEV)
            }
            first = part.start(state, found)
            count = part.blocks(state, found)
        }
    }
    let m: u64 = vfs.mount_at(state, ft, dev, first, count, tbuf, mflags)
    if m >= vfs.MAX_MNT {
        return neg(errno.E_INVAL)
    }
    return 0
}

fn do_vfs_umount(state: u64, me: u64, target: u64) -> u64 {
    if !vfs.ready(state) {
        return neg(errno.E_NOSYS)
    }
    let tbuf: u64 = nameb(state)
    let tl: u64 = fetch_path(state, me, target, tbuf, MAX_NAME)
    if errno.is_error(tl) {
        return tl
    }
    let r: u64 = vfs.umount_path(state, tbuf)
    if r != 0 {
        return neg(r)
    }
    return 0
}

fn do_link(state: u64, me: u64, from: u64, to: u64) -> u64 {
    if !appfs.free_ok(state, me) {
        return neg(errno.E_ACCES)
    }
    let a: u64 = nameb(state)
    let b: u64 = nameb(state) + 1024
    let la: u64 = fetch_path(state, me, from, a, MAX_NAME)
    if errno.is_error(la) {
        return la
    }
    uio.next_base(state, me) // r821: the second path may belong to another directory descriptor
    let lb: u64 = fetch_path(state, me, to, b, MAX_NAME)
    if errno.is_error(lb) {
        return lb
    }
    if vfs.ready(state) {
        let ma: u64 = vfs.mount_for(state, a)
        let mb: u64 = vfs.mount_for(state, b)
        if ma != mb {
            return neg(errno.E_XDEV)
        }
        if ma != 0 {
            return neg(errno.E_PERM)
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if fs.path(state, b) != 0 {
        return neg(errno.E_EXIST)
    }
    let dir: u64 = fs.parent_ino(state, b)
    if dir == 0 {
        return neg(errno.E_NOENT)
    }
    if !perm.may(state, me, dir, perm.R_WRITE | perm.R_EXEC) {
        return neg(errno.E_ACCES)
    }
    let r: u64 = fs.link_path(state, a, b)
    if r != 0 {
        return neg(r)
    }
    return 0
}

fn do_sync(state: u64, me: u64) -> u64 {
    if !syncall.sync_all(state) {
        return neg(errno.E_IO)
    }
    return 0
}

// ==================================================== RUNDE SPEICHERDRUCK
fn oom_pick(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var best: u64 = 0
    var best_pages: u64 = 0
    var found: u64 = 0
    var i: u64 = 0
    while i < n {
        let st: u64 = sched.tget(state, i, sched.T_STATE)
        let kind: u64 = sched.tget(state, i, sched.T_KIND)
        let pid: u64 = sched.tget(state, i, sched.T_PID)
        let safe: u64 = sched.tget(state, i, sched.T_OOMSAFE)
        var ok: u64 = 1
        if st == sched.S_FREE || st == sched.S_ZOMBIE {
            ok = 0
        }
        if kind != sched.K_USER {
            ok = 0
        }
        if pid <= 1 {
            ok = 0
        }
        if safe != 0 {
            ok = 0
        }
        if ok == 1 {
            let pg: u64 = sched.tget(state, i, sched.T_UPAGES)
            if found == 0 || pg > best_pages {
                best = i
                best_pages = pg
                found = 1
            }
        }
        i = i + 1
    }
    if found == 0 {
        return 0 -% 1
    }
    return best
}

fn oom_handle(state: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_NOOOM) {
        return 0
    }
    if mem.frames_free(state) > kstate.get(state, kstate.RESERVE_FRAMES) {
        return 0
    }
    let victim: u64 = oom_pick(state)
    if victim == 0 -% 1 {
        return 0
    }

    do_sync(state, victim)
    kstate.set(state, kstate.OOM_SYNCS,
        kstate.get(state, kstate.OOM_SYNCS) + 1)

    // 3. SAGEN, WAS PASSIERT.
    var s_oom: [u8; 11] = "oom: kill \0"
    var s_pid: [u8; 5] = "pid=\0"
    var s_pg: [u8; 9] = "  pages=\0"
    var s_free: [u8; 8] = "  frei=\0"
    let pid: u64 = sched.tget(state, victim, sched.T_PID)
    let pages: u64 = sched.tget(state, victim, sched.T_UPAGES)
    serial.puts((&s_oom[0]) as u64)
    serial.puts((&s_pid[0]) as u64)
    serial.dec(pid)
    serial.puts((&s_pg[0]) as u64)
    serial.dec(pages)
    serial.puts((&s_free[0]) as u64)
    serial.dec(mem.frames_free(state))
    serial.nl()

    kstate.set(state, kstate.OOM_KILLS,
        kstate.get(state, kstate.OOM_KILLS) + 1)
    kstate.set(state, kstate.OOM_VICTIM, pid)

    let _k: bool = signal.send_task(state, victim, signal.SIGKILL)
    return 1
}

fn do_rename(state: u64, me: u64, from: u64, to: u64) -> u64 {
    let a: u64 = nameb(state)
    let b: u64 = nameb(state) + 1024
    let la: u64 = fetch_path(state, me, from, a, MAX_NAME)
    if errno.is_error(la) {
        return la
    }
    uio.next_base(state, me) // r821: the second path may belong to another directory descriptor
    let lb: u64 = fetch_path(state, me, to, b, MAX_NAME)
    if errno.is_error(lb) {
        return lb
    }
    // ==================================== RUNDE MULTIUSER: DAS TOR
    if !perm.walk_w(state, me, a) {
        return neg(errno.E_ACCES)
    }
    if !perm.walk_w(state, me, b) {
        return neg(errno.E_ACCES)
    }
    if vfs.ready(state) {
        let ma: u64 = vfs.mount_for(state, a)
        let mb: u64 = vfs.mount_for(state, b)
        if ma >= vfs.MAX_MNT || mb >= vfs.MAX_MNT {
            return neg(errno.E_NOENT)
        }
        if ma != 0 || mb != 0 || vfs.all_mode(state) {
            let rv: u64 = vfs.v_rename(state, ma, a, mb, b)
            if rv != 0 {
                return neg(rv)
            }
            return 0
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let odir: u64 = fs.parent_ino(state, a)
    let ndir: u64 = fs.parent_ino(state, b)
    if odir == 0 || ndir == 0 {
        return neg(errno.E_NOENT)
    }
    if !perm.may(state, me, odir, perm.R_WRITE | perm.R_EXEC) {
        return neg(errno.E_ACCES)
    }
    if !perm.may(state, me, ndir, perm.R_WRITE | perm.R_EXEC) {
        return neg(errno.E_ACCES)
    }
    let r: u64 = fs.rename_path(state, a, b)
    if r != 0 {
        return neg(r)
    }
    return 0
}

// `osum_pmon(kind, index, field)`. Its own function and not sixty
// branches in `dispatch`, for the reason written out at length above
// `k13_call`: every branch of `dispatch` costs stack whether it is taken
// or not, and this kernel has already overflowed its kernel stack once
// for exactly that reason.
// ================================================== RUNDE WERKZEUGE
fn do_pstat(state: u64, me: u64, index: u64, field: u64) -> u64 {
    if index >= kstate.MAX_TASKS {
        return neg(errno.E_INVAL)
    }
    if index >= kstate.get(state, kstate.TASKS) {
        return 0
    }
    if !ctr.visible(state, me, index) {
        return 0
    }
    if field == uio.P_CPU || field == uio.P_PAGES {
        if sched.tget(state, index, sched.T_STATE) == sched.S_FREE {
            return 0
        }
        if field == uio.P_CPU {
            return sched.cpu_of(state, index)
        }
        return proc.space_pages(state, index)
    }
    if field == uio.P_NAME0 || field == uio.P_NAME1 {
        if sched.tget(state, index, sched.T_STATE) == sched.S_FREE
            || sched.tget(state, index, sched.T_KIND) != sched.K_USER {
            return 0
        }
        return pstat_name(state, index, field == uio.P_NAME1)
    }
    // r146: age (ms) and command line (octets, 8 per number)
    if field == uio.P_AGE {
        if sched.tget(state, index, sched.T_STATE) == sched.S_FREE {
            return 0
        }
        let born: u64 = sched.tget(state, index, sched.T_BORN)
        let now: u64 = kstate.get(state, kstate.TICKS)
        if now < born {
            return 0
        }
        return (now - born) * 1000 / time.TICK_HZ
    }
    if field == uio.P_UID || field == uio.P_THREADS || field == uio.P_DISKR || field == uio.P_DISKW {
        return pstat_count(state, index, field)
    }
    if field >= uio.P_CMD0 && field < uio.P_CMD0 + uio.P_CMD_WORDS {
        if sched.tget(state, index, sched.T_STATE) == sched.S_FREE
            || sched.tget(state, index, sched.T_KIND) != sched.K_USER {
            return 0
        }
        return pstat_cmd(state, index, field - uio.P_CMD0)
    }
    return uio.pstat(state, index, field)
}

fn pstat_count(state: u64, index: u64, field: u64) -> u64 {
    if sched.tget(state, index, sched.T_STATE) == sched.S_FREE {
        return 0
    }
    if field == uio.P_UID {
        return sched.tget(state, index, sched.T_UID)
    }
    if field == uio.P_DISKR {
        return sched.tget(state, index, sched.T_DISKR)
    }
    if field == uio.P_DISKW {
        return sched.tget(state, index, sched.T_DISKW)
    }
    var group: u64 = sched.tget(state, index, sched.T_TGID)
    if group == 0 {
        group = sched.tget(state, index, sched.T_PID)
    }
    var n: u64 = 0
    var j: u64 = 0
    let top: u64 = kstate.get(state, kstate.TASKS)
    while j < top && j < kstate.MAX_TASKS {
        let st: u64 = sched.tget(state, j, sched.T_STATE)
        if st != sched.S_FREE && st != sched.S_ZOMBIE && st != sched.S_NEW {
            var g: u64 = sched.tget(state, j, sched.T_TGID)
            if g == 0 {
                g = sched.tget(state, j, sched.T_PID)
            }
            if g == group {
                n = n + 1
            }
        }
        j = j + 1
    }
    return n
}

fn io_count(state: u64, me: u64, field: u64, n: u64) {
    if n == 0 || (n >> 63) != 0 {
        return
    }
    sched.tset(state, me, field, sched.tget(state, me, field) + n)
}

fn do_setprio(state: u64, me: u64, pid: u64, prio: u64) -> u64 {
    if prio < 1 || prio > 3 {
        return neg(errno.E_INVAL)
    }
    let t: u64 = sched.find_pid(state, pid)
    if t >= kstate.MAX_TASKS {
        return neg(errno.E_SRCH)
    }
    let st: u64 = sched.tget(state, t, sched.T_STATE)
    if st == sched.S_FREE || st == sched.S_ZOMBIE || sched.tget(state, t, sched.T_KIND) != sched.K_USER {
        return neg(errno.E_SRCH)
    }
    if !perm.may_signal(state, me, t) {
        return neg(errno.E_PERM)
    }
    sched.tset(state, t, sched.T_PRIO, prio)
    return 0
}

// r146: eight octets of the command line, `word` = 0.. (octets 8*word .. 8*word+7). The command line is
// argv[0], argv[1] .. joined by one blank, read from the task's argument page like pstat_name. A task
// without arguments, or whose page is not mapped, has none (0).
fn pstat_cmd(state: u64, t: u64, word: u64) -> u64 {
    let frame: u64 = proc.translate(state, t, proc.ARGS_BASE)
    if frame == 0 {
        return 0
    }
    let argc: u64 = __mmio_read64(frame as *mut u64)
    if argc == 0 || argc > proc.MAX_ARGS {
        return 0
    }
    let from: u64 = word * 8
    let upto: u64 = from + 8
    let lim: u64 = frame + 4096
    var v: u64 = 0
    var pos: u64 = 0
    var a: u64 = 0
    while a < argc && pos < upto {
        let ptr: u64 = __mmio_read64((frame + 8 + a * 8) as *mut u64)
        if ptr < proc.ARGS_BASE || ptr >= proc.ARGS_BASE + 4096 {
            a = argc
        } else {
            var at: u64 = frame + (ptr - proc.ARGS_BASE)
            while at < lim && kstate.get8(at) != 0 && pos < upto {
                if pos >= from {
                    v = v | (kstate.get8(at) << ((pos - from) * 8))
                }
                pos = pos + 1
                at = at + 1
            }
            if a + 1 < argc && pos < upto {
                if pos >= from {
                    v = v | (32 << ((pos - from) * 8))
                }
                pos = pos + 1
            }
            a = a + 1
        }
    }
    return v
}

// ROADMAP-7 (r191): the basename of argv[0], eight octets of it. Read
// from the task's own argument page the way /proc/<pid>/cmdline reads it
// (procfs.make_cmdline): the page at proc.ARGS_BASE holds argc, then the
// pointers, then the strings -- all inside that one page.
fn pstat_name(state: u64, t: u64, second: bool) -> u64 {
    let frame: u64 = proc.translate(state, t, proc.ARGS_BASE)
    if frame == 0 {
        return 0
    }
    let argc: u64 = __mmio_read64(frame as *mut u64)
    if argc == 0 || argc > proc.MAX_ARGS {
        return 0
    }
    let ptr: u64 = __mmio_read64((frame + 8) as *mut u64)
    if ptr < proc.ARGS_BASE || ptr >= proc.ARGS_BASE + 4096 {
        return 0
    }
    let s0: u64 = frame + (ptr - proc.ARGS_BASE)
    let lim: u64 = frame + 4096
    // the basename: after the last '/'
    var at: u64 = s0
    var base: u64 = s0
    while at < lim && kstate.get8(at) != 0 {
        if kstate.get8(at) == 47 {
            base = at + 1
        }
        at = at + 1
    }
    var from: u64 = base
    if second {
        from = base + 8
    }
    var v: u64 = 0
    var k: u64 = 0
    var going: bool = from < at
    while going && k < 8 {
        let q: u64 = from + k
        if q >= at {
            going = false
        } else {
            v = v | (kstate.get8(q) << (k * 8))
            k = k + 1
        }
    }
    return v
}

fn do_session_lock(state: u64, me: u64, op: u64, arg: u64) -> u64 {
    let own_pid: u64 = sched.tget(state, me, sched.T_PID)
    let sp: u64 = kstate.K11_OFF
    if op == 0 {
        return kstate.get(state, sp + kstate.SP_ON)
    }
    if op == 1 {
        if kstate.get(state, sp + kstate.SP_ON) == 0 {
            kstate.set(state, sp + kstate.SP_ON, 1)
            kstate.add(state, sp + kstate.SP_LOCKS, 1)
            // r382 LOCK SEAL: whoever turns the lock on from a program is
            // the one program that may claim it (op 4) -- nobody else can
            // step in between and become the locker.
            kstate.set(state, sp + kstate.SP_SLOT, me)
        }
        return 0
    }
    if op == 2 {
        if kstate.get(state, sp + kstate.SP_PID) != own_pid
            || kstate.get(state, sp + kstate.SP_SLOT) != me {
            return neg(errno.E_PERM)
        }
        kstate.set(state, sp + kstate.SP_ON, 0)
        kstate.set(state, sp + kstate.SP_PID, 0)
        kstate.set(state, sp + kstate.SP_SLOT, 0)
        kstate.add(state, sp + kstate.SP_UNLOCKS, 1)
        kstate.set(state, sp + kstate.SP_LAST, time.mono_ns(state))
        return 0
    }
    if op == 3 {
        var l: u64 = kstate.get(state, sp + kstate.SP_LAST)
        let now_ticks: u64 = time.mono_ns(state)
        if l == 0 {
            kstate.set(state, sp + kstate.SP_LAST, now_ticks)
            l = now_ticks
        }
        if now_ticks < l {
            return 0
        }
        return (now_ticks - l) / 1000000
    }
    if op == 4 {
        // r382 LOCK SEAL: only while the screen is locked, and only the
        // program the lock named: the one that turned it on (op 1) or the
        // one the kernel started for it (sperre_wache sets SP_SLOT). Before,
        // ANY program could call op 4 -- while unlocked (to be the locker
        // of the next lock) or while the locker was dead (before the kernel
        // restarted it) -- and then unlock with op 2 without a password.
        if kstate.get(state, sp + kstate.SP_ON) == 0
            || kstate.get(state, sp + kstate.SP_SLOT) != me {
            return neg(errno.E_PERM)
        }
        let alt: u64 = kstate.get(state, sp + kstate.SP_PID)
        if alt != 0 && alt != own_pid {
            if sched.find_pid(state, alt) < kstate.MAX_TASKS {
                return neg(errno.E_PERM)
            }
        }
        kstate.set(state, sp + kstate.SP_PID, own_pid)
        kstate.set(state, sp + kstate.SP_SLOT, me)
        return 0
    }
    if op == 5 {
        return kstate.add(state, sp + kstate.SP_TRIES, 1)
    }
    // ============================================ RUNDE ANMELDUNG
    if op == 7 {
        if sched.tget(state, me, sched.T_EUID) != 0 {
            return neg(errno.E_PERM)
        }
        kstate.set(state, sp + kstate.SP_UID, arg)
        kstate.set(state, sp + kstate.SP_LAST, time.mono_ns(state))
        return 0
    }
    if op == 8 {
        return kstate.get(state, sp + kstate.SP_UID)
    }
    // ============================================== RUNDE LOGIND
    if op == 9 {
        kstate.set(state, sp + kstate.SP_LOGOUT, 1)
        return 0
    }
    if op == 10 {
        return kstate.get(state, sp + kstate.SP_LOGOUTS)
    }
    // DAILY-DRIVER (r143): THE STANDBY WISH. Same rule as op 9: anyone who
    // sits at the keyboard may put the machine to sleep -- and for the same
    // reason it is a wish and not a deed: S3 needs the kernel's own context
    // (the window server's loop does it, `kgui.standby_wache`), not a call in
    // the middle of somebody's drawing.
    //
    //   op 11  "bitte schlafen"          -> 0   (the answer is cleared first)
    //   op 12  "was ist daraus geworden" -> SP_STANDBYRC
    //   op 13  "wie oft geschlafen"      -> number
    if op == 11 {
        kstate.set(state, sp + kstate.SP_STANDBYRC, 0)
        kstate.set(state, sp + kstate.SP_STANDBY, 1)
        return 0
    }
    if op == 12 {
        return kstate.get(state, sp + kstate.SP_STANDBYRC)
    }
    if op == 13 {
        return kstate.get(state, sp + kstate.SP_STANDBYS)
    }
    if op == 6 {
        if arg == 0 {
            return kstate.get(state, sp + kstate.SP_LOCKS)
        }
        if arg == 1 {
            return kstate.get(state, sp + kstate.SP_UNLOCKS)
        }
        if arg == 2 {
            return kstate.get(state, sp + kstate.SP_TRIES)
        }
        if arg == 3 {
            return kstate.get(state, sp + kstate.SP_SPAWNS)
        }
        return kstate.get(state, sp + kstate.SP_PID)
    }
    return neg(errno.E_INVAL)
}

fn do_cpustat(state: u64, index: u64, field: u64) -> u64 {
    if field == CS_COUNT {
        return cpu.count(state)
    }
    if field == CS_ONLINE {
        return cpu.online_count(state)
    }
    if index >= kstate.MAX_CPUS || index >= cpu.count(state) {
        return neg(errno.E_INVAL)
    }
    if field == CS_UP {
        if cpu.online(state, index) {
            return 1
        }
        return 0
    }
    if field == CS_APICID {
        return cpu.apic_id(state, index)
    }
    if field == CS_TICKS {
        return cpu.get(state, index, cpu.C_TICKS)
    }
    if field == CS_IDLE {
        return cpu.get(state, index, cpu.C_IDLETICKS)
    }
    if field == CS_SWITCHES {
        return cpu.get(state, index, cpu.C_SWITCHES)
    }
    if field == CS_PICKS {
        return cpu.get(state, index, cpu.C_PICKS)
    }
    if field == CS_CYC {
        return cpu.x_get(state, index, cpu.X_TOTCYC)
    }
    if field == CS_IDLECYC {
        return cpu.x_get(state, index, cpu.X_IDLECYC)
    }
    if field == CS_CURPID {
        let t: u64 = cpu.get(state, index, cpu.C_CUR)
        if t >= kstate.MAX_TASKS {
            return 0
        }
        return sched.tget(state, t, sched.T_PID)
    }
    return neg(errno.E_INVAL)
}

// ==================================================== RUNDE PROTOKOLL
fn do_klog(state: u64, me: u64, was: u64, arg: u64, ptr: u64,
        len: u64) -> u64 {
    if was == KL_SEQ {
        return klog.seq(state)
    }
    if was == KL_FIRST {
        return klog.first_seq(state)
    }
    if was == KL_LOST {
        return klog.lost(state)
    }
    if was == KL_FILT {
        return klog.filtered(state)
    }
    if was == KL_MIN {
        return klog.min_level(state)
    }
    if was == KL_SER {
        return klog.ser_level(state)
    }
    if was == KL_NENT {
        return klog.N_ENT
    }
    if was == KL_CRASH {
        return crash.open(state)
    }
    if was == KL_LINE {
        var b: [u8; 256] = [0 as u8; 256]
        var max: u64 = len
        if max > 256 {
            max = 256
        }
        let n: u64 = klog.line_at(state, arg, (&b[0 as usize]) as u64, max)
        if n == 0 {
            return 0
        }
        if !copy_out(state, me, ptr, (&b[0 as usize]) as u64, n) {
            return neg(errno.E_FAULT)
        }
        return n
    }
    if was == KL_SETMIN || was == KL_SETSER {
        if perm.euid(state, me) != 0 {
            return neg(errno.E_PERM)
        }
        if arg > klog.L_ERROR {
            return neg(errno.E_INVAL)
        }
        if was == KL_SETMIN {
            klog.set_min(state, arg)
        } else {
            klog.set_ser(state, arg)
        }
        return 0
    }
    if was == KL_WRITE {
        var t: [u8; 96] = [0 as u8; 96]
        var max: u64 = len
        if max > 95 {
            max = 95
        }
        if !copy_in(state, me, (&t[0 as usize]) as u64, ptr, max) {
            return neg(errno.E_FAULT)
        }
        kstate.set8((&t[0 as usize]) as u64 + max, 0 as u8)
        var q: [u8; 5] = "prog\0"
        var lv: u64 = arg
        if lv > klog.L_ERROR {
            lv = klog.L_INFO
        }
        klog.say(state, lv, (&q[0 as usize]) as u64,
            (&t[0 as usize]) as u64)
        return max
    }
    return neg(errno.E_INVAL)
}

fn do_krach(state: u64, me: u64, art: u64) -> u64 {
    if !kstate.mode_on(state, kstate.M_KRACH) {
        return neg(errno.E_PERM)
    }
    if perm.euid(state, me) != 0 {
        return neg(errno.E_PERM)
    }
    crash.knall(state, art)
    return 0
}

const DBG_LIST: u64 = 1
const DBG_INFO: u64 = 2
const DBG_CFGREAD: u64 = 3
const DBG_CFGWRITE: u64 = 4
const DBG_MMIOREAD: u64 = 5
const DBG_MMIOWRITE: u64 = 6
const DBG_DRIVER: u64 = 7
const DBG_PRPHREAD: u64 = 8
const DBG_WLAN_RELOAD: u64 = 9
const DBG_WLAN_STATE: u64 = 10
const DBG_WLAN_KNOB_NAME: u64 = 11
const DBG_WLAN_KNOB_STATE: u64 = 12
const DBG_WLAN_SCAN: u64 = 13
const DBG_WLAN_REJOIN: u64 = 14
const DBG_WLAN_RADIO_GET: u64 = 17
const DBG_WLAN_RADIO_SET: u64 = 18
const DBG_FSGROW_INFO: u64 = 15
const DBG_FSGROW_STEP: u64 = 16
const DBG_WRITE_MAGIC: u64 = 0x57524954

fn dbg_out(state: u64, me: u64, dst: u64, src: u64, len: u64) -> u64 {
    if !copy_out(state, me, dst, src, len) {
        return neg(errno.E_FAULT)
    }
    return len
}

fn do_dbg(state: u64, me: u64, op: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    var tmp: [u8; 1024] = [0 as u8; 1024]
    let t: u64 = (&tmp[0]) as u64
    let root: bool = sched.tget(state, me, sched.T_EUID) == 0
    var r: u64 = 0
    if op == DBG_LIST {
        r = pcidbg.list_devices(state, t)
        if errno.is_error(r) { return r }
        let c: u64 = dbg_out(state, me, a1, t, r * 8)
        if errno.is_error(c) { return c }
        return r
    }
    if op == DBG_INFO {
        r = pcidbg.device_info(state, a1, t)
        if r != 0 { return r }
        return dbg_out(state, me, a2, t, pcidbg.INFO_QWORDS * 8)
    }
    if op == DBG_CFGREAD {
        r = pcidbg.cfg_read(state, a1, a2, a4, t)
        if errno.is_error(r) { return r }
        let c: u64 = dbg_out(state, me, a3, t, r)
        if errno.is_error(c) { return c }
        return r
    }
    if op == DBG_DRIVER {
        r = pcidbg.driver_text(state, a1, t, 256)
        if errno.is_error(r) { return r }
        let c: u64 = dbg_out(state, me, a2, t, r + 1)
        if errno.is_error(c) { return c }
        return r
    }
    if op == DBG_WLAN_STATE {
        return wlan_reload.state_word()
    }
    if op == DBG_WLAN_RADIO_GET {
        return wlan_reload.radio_get()
    }
    if op == DBG_FSGROW_INFO {
        return fsgrow.info(state, a1)
    }
    if !root {
        return neg(errno.E_PERM)
    }
    if op == DBG_CFGWRITE {
        return pcidbg.cfg_write(state, a1, a2, a3, a4)
    }
    if op == DBG_MMIOWRITE {
        if a4 != DBG_WRITE_MAGIC { return neg(errno.E_PERM) }
        return pcidbg.mmio_write(state, a1 & 0xFFFF, a1 >> 16, a2, a3)
    }
    if op == DBG_MMIOREAD {
        r = pcidbg.mmio_read(state, a1 & 0xFFFF, a1 >> 16, a2, a4, t)
        if errno.is_error(r) { return r }
        let c: u64 = dbg_out(state, me, a3, t, r * 4)
        if errno.is_error(c) { return c }
        return r
    }
    if op == DBG_PRPHREAD {
        r = iwl_dbg.prph_read(state, a1, a2, a4, t)
        if errno.is_error(r) { return r }
        let c: u64 = dbg_out(state, me, a3, t, r * 4)
        if errno.is_error(c) { return c }
        return r
    }
    if op == DBG_FSGROW_STEP {
        return fsgrow.step(state, a1)
    }
    if op == DBG_WLAN_RELOAD {
        return wlan_reload.request(state, a1, a2)
    }
    if op == DBG_WLAN_RADIO_SET {
        return wlan_reload.radio_set(a1)
    }
    if op == DBG_WLAN_SCAN {
        return wlan_reload.scan()
    }
    if op == DBG_WLAN_REJOIN {
        return wlan_reload.rejoin()
    }
    if op == DBG_WLAN_KNOB_STATE {
        return wlan_knobs.state_of(state, a1)
    }
    if op == DBG_WLAN_KNOB_NAME {
        r = wlan_knobs.name_text(a1, t, 64)
        if errno.is_error(r) { return r }
        let c: u64 = dbg_out(state, me, a2, t, r + 1)
        if errno.is_error(c) { return c }
        return r
    }
    return neg(errno.E_INVAL)
}

fn do_pmon(state: u64, me: u64, kind: u64, index: u64, field: u64) -> u64 {
    if kind == 0 {
        if field >= pmon.PM_SCALARS {
            return neg(errno.E_INVAL)
        }
        return pmon.scalar(state, field)
    }
    if kind == 1 {
        if index >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
        if field < pmon.PT_FIELDS {
            return pmon.tget(state, index, field)
        }
        if field == PT_PID {
            return pmon.task_pid(state, index)
        }
        if field == PT_ALIVE {
            if pmon.task_alive(state, index) {
                return 1
            }
            return 0
        }
        if field == PT_KIND {
            return sched.tget(state, index, sched.T_KIND)
        }
        if field == PT_STATE {
            return sched.tget(state, index, sched.T_STATE)
        }
        if field == PT_SCHEDTICKS {
            return sched.tget(state, index, sched.T_TICKS)
        }
        return neg(errno.E_INVAL)
    }
    if kind == 2 {
        if index >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
        return pmon.name_at(state, index, field)
    }
    if kind == 3 {
        if index >= pmon.NSAMPLE {
            return neg(errno.E_INVAL)
        }
        if field == 0 {
            return pmon.sample_rate(state, index)
        }
        if field == 1 {
            return pmon.sample_tick(state, index)
        }
        return neg(errno.E_INVAL)
    }
    if kind == 4 {
        if index >= pmon.NBUCKET || field > 2 {
            return neg(errno.E_INVAL)
        }
        return pmon.bucket_at(state, index, field)
    }
    if kind == 6 {
        // A PROGRAM ROW. This is the table a person is shown: a process
        // is not a program, and slot seven was `ls` a moment ago.
        if index >= pmon.NPROG || field >= pmon.PR_FIELDS {
            return neg(errno.E_INVAL)
        }
        return pmon.prog_get(state, index, field)
    }
    if kind == 7 {
        if index >= pmon.NPROG {
            return neg(errno.E_INVAL)
        }
        return pmon.prog_name_at(state, index, field)
    }
    if kind == 5 {
        // WRITING IS FOR THE OWNER OF THE MACHINE. Everything under
        // kind 5 destroys somebody else's numbers.
        if sched.tget(state, me, sched.T_EUID) != 0 {
            return neg(errno.E_PERM)
        }
        if index == PS_ROLLDAY {
            pmon.roll_day(state)
            return 0
        }
        if index == PS_RESET {
            pmon.reset_window(state)
            return 0
        }
        if index == PS_EVERY {
            if field == 0 || field > 1000 {
                return neg(errno.E_INVAL)
            }
            pmon.set_scalar(state, pmon.PM_EVERY / 8, field)
            return 0
        }
        if index == PS_ONOFF {
            pmon.set_on(state, field)
            return 0
        }
        return neg(errno.E_INVAL)
    }
    return neg(errno.E_INVAL)
}

fn pwr_call(state: u64, me: u64, number: u64, a0: u64, a1: u64,
    a2: u64) -> u64 {
    if number == SYS_OSUM_PWRGET {
        return do_pwrget(state, a0)
    }
    if number == SYS_OSUM_PWRSET {
        return do_pwrset(state, me, a0, a1)
    }
    return do_pwrstr(state, me, a0, a1, a2)
}

// ==================================================== RUNDE DISPLAY

fn do_pwrget(state: u64, field: u64) -> u64 {
    if field == PG_COUNT {
        return PG_COUNT
    }
    if field == PG_READY {
        if pwr.ready(state) {
            return 1
        }
        return 0
    }
    if !pwr.ready(state) {
        return neg(errno.E_NODEV)
    }
    if field == PG_PROFILE {
        return pwr.cur_profile(state)
    }
    if field == PG_CAPS {
        return pwr.caps(state)
    }
    if field == PG_RATIOS {
        return pwr.value(state, pwr.PW_RATIOS)
    }
    if field == PG_RATIOSRC {
        return pwr.value(state, pwr.PW_RATIOSRC)
    }
    if field == PG_PERFCTL {
        return pwr.value(state, pwr.PW_PERFCTL)
    }
    if field == PG_PERFBACK {
        return pwr.value(state, pwr.PW_PERFBACK)
    }
    if field == PG_HWPREQ {
        return pwr.value(state, pwr.PW_HWPREQ)
    }
    if field == PG_HWPBACK {
        return pwr.value(state, pwr.PW_HWPBACK)
    }
    if field == PG_MISC {
        return pwr.value(state, pwr.PW_MISC)
    }
    if field == PG_MISCBACK {
        return pwr.value(state, pwr.PW_MISCBACK)
    }
    if field == PG_MISCORIG {
        return pwr.value(state, pwr.PW_MISCORIG)
    }
    if field == PG_CSTATE {
        return pwr.value(state, pwr.PW_CSTATE)
    }
    if field == PG_MWAITS {
        return pwr.value(state, pwr.PW_MWAITS)
    }
    if field == PG_HLTS {
        return pwr.value(state, pwr.PW_HLTS)
    }
    if field == PG_IDLERUNS {
        return pwr.value(state, pwr.PW_IDLERUNS)
    }
    if field == PG_TEMP {
        return pwr.temp_c(state)
    }
    if field == PG_TEMPOK {
        return pwr.value(state, pwr.PW_TEMPOK)
    }
    if field == PG_TJMAX {
        return pwr.value(state, pwr.PW_TJMAX)
    }
    if field == PG_THROTTLES {
        return pwr.value(state, pwr.PW_THROTTLES)
    }
    if field == PG_THROTTLED {
        return pwr.value(state, pwr.PW_THROTTLED)
    }
    if field == PG_APPLIES {
        return pwr.value(state, pwr.PW_APPLIES)
    }
    if field == PG_SWITCHES {
        return pwr.value(state, pwr.PW_SWITCHES)
    }
    if field == PG_MWAITHINT {
        return pwr.value(state, pwr.PW_MWAITHINT)
    }
    if field == PG_LIMIT {
        return pwr.value(state, pwr.PW_LIMIT)
    }
    if field == PG_TZRAW {
        return pwr.value(state, pwr.PW_TZRAW)
    }
    if field == PG_BRIGHT {
        return pwr.bright(state)
    }
    if field == PG_BLANKED {
        return pwr.value(state, pwr.PW_BLANKED)
    }
    if field == PG_BLANKS {
        return pwr.value(state, pwr.PW_BLANKS)
    }
    // ---- RUNDE ACPI-EREIGNISSE
    if field == PG_EVREADY {
        if acpiev.ready(state) {
            return 1
        }
        return 0
    }
    if field == PG_EVWHY {
        return acpiev.why(state)
    }
    if field == PG_LIDOK {
        if acpiev.lid_present(state) {
            return 1
        }
        return 0
    }
    if field == PG_LID {
        return acpiev.lid_state(state)
    }
    if field == PG_EVENTS {
        return acpiev.events(state)
    }
    if field == PG_EVWAKE {
        return acpiev.wakeups(state)
    }
    if field == PG_EVGPE {
        return acpiev.gpe_armed(state)
    }
    if field == PG_EVSCI {
        return acpiev.sci_gsi(state)
    }
    if field == PG_EVCHANGE {
        return acpiev.take_change(state)
    }
    if field == PG_BTN {
        if acpiev.button_take(state) {
            return 1
        }
        return 0
    }
    if field == PG_BLANKAFTER {
        return pwr.value(state, pwr.PW_BLANKAFTER) / 100
    }

    // ---- der Akku
    if field == PG_BATPRESENT {
        if acpiev.batt_present(state) {
            return 1
        }
        if batt.present(state) {
            return 1
        }
        return 0
    }
    if field == PG_BATVALID {
        if acpiev.batt_present(state) {
            if acpiev.batt_valid(state) {
                return 1
            }
            return 0
        }
        return 1
    }
    if field == PG_BATWHY {
        return batt.why(state)
    }
    if field == PG_TABLES {
        return batt.value(state, batt.BT_TABLES)
    }
    if field == PG_ACOK {
        if batt.ac_known(state) {
            return 1
        }
        return 0
    }
    if field == PG_AC {
        if acpiev.ready(state) && acpiev.ac_online(state) {
            return 1
        }
        if batt.ac_online(state) {
            return 1
        }
        return 0
    }
    if !batt.present(state) && !acpiev.batt_present(state) {
        return neg(errno.E_NODEV)
    }
    if field == PG_BATPERCENT {
        if acpiev.batt_present(state) {
            return acpiev.batt_percent(state)
        }
        return batt.percent(state)
    }
    if field == PG_BATMINUTES {
        return batt.minutes(state)
    }
    if field == PG_BATSTATE {
        if acpiev.batt_present(state) {
            return acpiev.batt_state(state)
        }
        return batt.value(state, batt.BT_STATE)
    }
    if field == PG_BATRATE {
        return batt.value(state, batt.BT_RATE)
    }
    if field == PG_BATREMAIN {
        return batt.value(state, batt.BT_REMAIN)
    }
    if field == PG_BATFULL {
        return batt.value(state, batt.BT_FULL)
    }
    if field == PG_BATDESIGN {
        return batt.value(state, batt.BT_DESIGN)
    }
    if field == PG_BATVOLT {
        return batt.value(state, batt.BT_VOLT)
    }
    if field == PG_BATWARN {
        return batt.value(state, batt.BT_WARN)
    }
    if field == PG_BATLOW {
        return batt.value(state, batt.BT_LOW)
    }
    if field == PG_BATUNIT {
        return batt.value(state, batt.BT_UNIT)
    }
    return neg(errno.E_INVAL)
}

fn do_pwrset(state: u64, me: u64, field: u64, v: u64) -> u64 {
    if !pwr.ready(state) {
        return neg(errno.E_NODEV)
    }
    if sched.tget(state, me, sched.T_EUID) != 0 {
        return neg(errno.E_PERM)
    }
    if field == PS_PROFILE {
        if v >= pwr.PROF_COUNT {
            return neg(errno.E_INVAL)
        }
        if !pwr.set_profile(state, v) {
            return neg(errno.E_INVAL)
        }
        return 0
    }
    if field == PS_BRIGHT {
        if v > 100 {
            return neg(errno.E_INVAL)
        }
        if !gfx.fb_ready(state) {
            return neg(errno.E_NODEV)
        }
        pwr.set_bright(state, v)
        return 0
    }
    if field == PS_INJECT {
        if !acpiev.inject(state, v & 255, (v >> 8) & 255, (v >> 16) & 255, (v >> 24) & 255) {
            return neg(errno.E_NODEV)
        }
        return 0
    }
    if field == PS_BLANKAFTER {
        // seconds -> ticks (100 per second); a day is the longest wait
        if v > 86400 {
            return neg(errno.E_INVAL)
        }
        pwr.set_blank_after(state, v * 100)
        return 0
    }
    if field == PS_BLANK {
        if !gfx.fb_ready(state) {
            return neg(errno.E_NODEV)
        }
        if v != 0 {
            pwr.blank(state)
        } else {
            pwr.unblank(state)
        }
        return 0
    }
    return neg(errno.E_INVAL)
}

fn do_pwrstr(state: u64, me: u64, which: u64, dst: u64, len: u64) -> u64 {
    if !pwr.ready(state) {
        return neg(errno.E_NODEV)
    }
    if which > 3 {
        return neg(errno.E_INVAL)
    }
    if !batt.present(state) {
        return neg(errno.E_NODEV)
    }
    let src: u64 = batt.text_at(state, which)
    var n: u64 = 0
    while n < 63 && kstate.get8(src + n) != 0 {
        n = n + 1
    }
    if len < n + 1 {
        return neg(errno.E_INVAL)
    }
    if !copy_out(state, me, dst, src, n + 1) {
        return neg(errno.E_FAULT)
    }
    return n
}

fn do_mntstat(state: u64, index: u64, field: u64) -> u64 {
    if field == MS_COUNT {
        return mnt.count(state)
    }
    if index >= vfs.MAX_MNT {
        return neg(errno.E_INVAL)
    }
    if field == MS_USED {
        if mnt.used(state, index) {
            return 1
        }
        return 0
    }
    if !mnt.used(state, index) {
        return 0
    }
    if field == MS_TYPE {
        return mnt.fstype(state, index)
    }
    if field == MS_DEV {
        return mnt.dev(state, index)
    }
    if field == MS_FIRST {
        return mnt.first(state, index)
    }
    if field == MS_BLOCKS {
        return mnt.blocks(state, index)
    }
    if field == MS_FLAGS {
        return mnt.flags(state, index)
    }
    if field == MS_OPENS {
        return mnt.opens(state, index)
    }
    if field == MS_PATHLEN {
        return mnt.path_len(state, index)
    }
    if field >= MS_PATHCH {
        let i: u64 = field - MS_PATHCH
        if i >= mnt.path_len(state, index) {
            return 0
        }
        return kstate.get8(mnt.path_at(state, index) + i)
    }
    return neg(errno.E_INVAL)
}

fn do_mount(state: u64, op: u64) -> u64 {
    if op == 0 {
        return kstate.get(state, kstate.FS_READY)
    }
    if op == 1 {
        if fs.mount(state) {
            return 1
        }
        return neg(errno.E_NODEV)
    }
    if op == 2 {
        kstate.set(state, kstate.FS_READY, 0)
        return 0
    }
    return neg(errno.E_INVAL)
}

// ============================================================ Runde K16

fn kcopy_word(dst: u64, src: u64, max: u64) -> u64 {
    var i: u64 = 0
    while i < max {
        let c: u64 = kstate.get8(src + i)
        kstate.set8(dst + i, c as u8)
        if c == 0 {
            return i + 1
        }
        i = i + 1
    }
    kstate.set8(dst + max - 1, 0 as u8)
    return max
}

fn do_ftype(state: u64, me: u64, path: u64, out: u64, len: u64) -> u64 {
    let name: u64 = nameb(state)
    let n: u64 = fetch_path(state, me, path, name, MAX_NAME)
    if errno.is_error(n) {
        return n
    }
    if n == 0 {
        return neg(errno.E_NOENT)
    }
    if kstate.get(state, kstate.FS_READY) != 0 {
    if !perm.walk(state, me, name) {
        return neg(errno.E_ACCES)
    }
        if fs.path(state, name) == 0 {
            return neg(errno.E_NOENT)
        }
    }
    let art: u64 = ftype.classify(state, name)
    if art == ftype.T_NONE {
        return neg(errno.E_NOEXEC)
    }
    if out != 0 {
        var k: u64 = len
        if k > kstate.FT_SLOT {
            k = kstate.FT_SLOT
        }
        if !copy_out(state, me, out, ftype.record_for(state, art), k) {
            return neg(errno.E_FAULT)
        }
    }
    return art
}

fn do_flist(state: u64, me: u64, nr: u64, out: u64, len: u64) -> u64 {
    if nr >= kstate.FT_SLOTS {
        return neg(errno.E_NOENT)
    }
    if kstate.get(state, ftype.slot_off(nr) + ftype.R_USED) == 0 {
        return neg(errno.E_NOENT)
    }
    if out != 0 {
        var k: u64 = len
        if k > kstate.FT_SLOT {
            k = kstate.FT_SLOT
        }
        if !copy_out(state, me, out, ftype.table_at(state, nr), k) {
            return neg(errno.E_FAULT)
        }
    }
    return nr
}

fn do_freg(state: u64, me: u64, satz: u64, len: u64) -> u64 {
    if len != kstate.FT_SLOT {
        return neg(errno.E_INVAL)
    }
    let buf: u64 = blockb(state)
    if !copy_in(state, me, buf, satz, len) {
        return neg(errno.E_FAULT)
    }
    let i: u64 = ftype.register_from(state, buf)
    if i >= kstate.FT_SLOTS {
        return neg(errno.E_NOSPC)
    }
    return i
}

fn do_fopen(state: u64, me: u64, path: u64, argv: u64, argc: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if argc > proc.MAX_ARGS {
        return neg(errno.E_2BIG)
    }
    let name: u64 = nameb(state)
    let n: u64 = fetch_path(state, me, path, name, MAX_NAME)
    if errno.is_error(n) {
        return n
    }
    if n == 0 {
        return neg(errno.E_NOENT)
    }
    if !perm.walk(state, me, name) {
        return neg(errno.E_ACCES)
    }
    if fs.path(state, name) == 0 {
        ftype.refuse(state)
        return neg(errno.E_NOENT)
    }
    let art: u64 = ftype.classify(state, name)
    if art == ftype.T_NONE {
        ftype.refuse(state)
        return neg(errno.E_NOEXEC)
    }
    let wirkung: u64 = ftype.action_of(state, art)
    let abuf: u64 = cpu.earg_buf(state)
    var at: u64 = 0
    var anz: u64 = 0
    var start: u64 = name
    if wirkung == ftype.A_EXEC {
        at = at + kcopy_word(abuf + at, name, MAX_NAME + 1)
        anz = 1
    } else {
        if wirkung != ftype.A_OPEN {
            ftype.refuse(state)
            return neg(errno.E_NOEXEC)
        }
        let prog: u64 = ftype.prog_of(state, art)
        if prog == 0 {
            ftype.refuse(state)
            return neg(errno.E_NOEXEC)
        }
        start = prog
        at = at + kcopy_word(abuf + at, prog, ftype.PROG_MAX)
        at = at + kcopy_word(abuf + at, name, MAX_NAME + 1)
        anz = 2
    }
    var k: u64 = 0
    while k < argc {
        if !proc.user_ok(state, me, argv + k * 8, 8) {
            return neg(errno.E_FAULT)
        }
        let m: u64 = fetch_name(state, me,
            user_word(state, me, argv + k * 8), abuf + at, MAX_NAME)
        if errno.is_error(m) {
            return m
        }
        at = at + m + 1
        anz = anz + 1
        k = k + 1
    }
    if anz > proc.MAX_ARGS {
        return neg(errno.E_2BIG)
    }
    let t: u64 = elf.spawn(state, start, abuf, anz, 2)
    if t == 0 {
        let why: u64 = kstate.get(state, kstate.ELF_ERR)
        elf.say_reason(why)
        ftype.refuse(state)
        return neg(elf.errno_of(why))
    }
    ftype.opened(state)
    netview.inherit(state, me, t)
    ctr.inherit(state, me, t)
    return sched.tget(state, t, sched.T_PID)
}

// ============================================================ round K6
//
// A USERLAND, ON TOP OF THE POSIX LAYER OF ROUND K4. The two rounds were
// written at the same time and against different kernels, and this is
// where the difference was settled:
//
//   * ROUND K6'S DESCRIPTORS ARE GONE. It carried three standard
//      descriptors of its own with a position each, plus a `dup2` and a
//      `seek` for them, because the kernel of round K1 had no table of
//      open files. Round K4 built one, with reference counts and
//      sixteen descriptors per process (`kernel/file.fi`), and
//      `dup2` is 33 and `lseek` is 8 -- Linux's numbers, the ones every
//      program of this system already uses. K6's 40 and 41 were dropped
//      rather than kept as a second door onto the same thing.
//   * WHAT IS LEFT IS WHAT ROUND K4 DOES NOT HAVE: a working directory
//      that can be PRINTED (`sched.T_CWD` is an inode; `pwd` needs a
//      path), and three questions about the machine that `ps`, `df`,
//      `date` and `uname` may not answer by reading a kernel variable.
//
// The state is in `kernel/uio.fi`, one slot of 128 octets per task.

// A name out of ring 3 that is meant to be a PATH. The difference to
// `fetch_name` is one line and it is the whole of the working directory:
// a name that does not start with a slash is completed with it before the
// file system sees it. `exec` uses this for the program and `fetch_name`
// for the arguments -- an argument is not a path.
fn fetch_path(state: u64, me: u64, addr: u64, dst: u64, max: u64) -> u64 {
    let n: u64 = fetch_name(state, me, addr, dst, max)
    if errno.is_error(n) {
        return n
    }
    return uio.resolve(state, me, dst, n)
}

// `chdir(path)` -- Linux's number 80, and Linux's meaning. What is stored
// is the path with `.` and `..` folded away, because `getcwd` prints this
// string back and `/bin/../bin` is not a name anybody wants to read.
fn do_chdir(state: u64, me: u64, name: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    let ino: u64 = fs.path(state, buf)
    if ino != 0 {
        if !perm.may(state, me, ino, perm.R_EXEC) {
            return neg(errno.E_ACCES)
        }
    }
    return uio.chdir_to(state, me, buf)
}

// r820: `fchdir(fd)`. The directory descriptor remembers its path (`dirpath_remember`, jail prefix cut); `uio.resolve` puts the
// jail root in front again, then the same checks as `chdir` run.
fn do_fchdir(state: u64, me: u64, fd: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let fr: u64 = at_dir_frame(state, me, fd)
    if errno.is_error(fr) {
        return fr
    }
    let buf: u64 = nameb(state)
    var n: u64 = 0
    while n < uio.PATH_MAX && kstate.get8(fr + n) != 0 {
        kstate.set8(buf + n, kstate.get8(fr + n) as u8)
        n = n + 1
    }
    kstate.set8(buf + n, 0 as u8)
    let len: u64 = uio.resolve(state, me, buf, n)
    if errno.is_error(len) {
        return len
    }
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    let ino: u64 = fs.path(state, buf)
    if ino != 0 {
        if !perm.may(state, me, ino, perm.R_EXEC) {
            return neg(errno.E_ACCES)
        }
    }
    return uio.chdir_to(state, me, buf)
}

// `getcwd(buf, size)`. ROUND K4 ANSWERED "/" HERE and wrote in its own
// comment that this was the gap: there was no working directory to
// report. There is one now. Linux returns the length INCLUDING the zero,
// and so does this.
fn do_getcwd(state: u64, me: u64, out: u64, size: u64) -> u64 {
    let n: u64 = uio.cwd_len(state, me)
    if size <= n {
        return neg(errno.E_RANGE)
    }
    if !proc.user_ok(state, me, out, n + 1) {
        return neg(errno.E_FAULT)
    }
    var i: u64 = 0
    while i < n {
        if !poke(state, me, out + i, uio.cwd_at(state, me, i)) {
            return neg(errno.E_FAULT)
        }
        i = i + 1
    }
    if !poke(state, me, out + n, 0) {
        return neg(errno.E_FAULT)
    }
    return n + 1
}

// ==================================================================
// die native ABI: Handles statt Umgebungsautoritaet
// ==================================================================

fn grant_console(state: u64, task: u64, rights: u64) -> u64 {
    return cap.insert(state, task, cap.K_STREAM, rights, file.CON_OUT)
}

fn handle_call(state: u64, me: u64, number: u64, a0: u64, a1: u64,
    a2: u64, a3: u64) -> u64 {
    if number > HND_MAXNR {
        return handle.err(handle.E_INVALID)
    }
    if number == HND_VERSION {
        return 1
    }
    if number == HND_COUNT {
        return handle.used(state, file.owner(state, me))
    }
    if number == HND_FDH {
        return file.fd_handle(state, me, a0)
    }
    if number == HND_RIGHTS {
        if file.fd_handle(state, me, a0) == handle.HANDLE_NONE {
            return handle.err(handle.E_BADHANDLE)
        }
        return file.fd_rights(state, me, a0)
    }
    if number == HND_BEGIN {
        return handle.req_begin(state, me, a0, a1 & handle.R_ALL)
    }
    if number == HND_OBJECT {
        if handle.req_owner(state, a0) != me {
            return handle.err(handle.E_BADHANDLE)
        }
        return handle.req_object(state, a0)
    }
    if number == HND_STATE {
        if handle.req_owner(state, a0) != me {
            return handle.err(handle.E_BADHANDLE)
        }
        return handle.req_state(state, a0)
    }
    if number == HND_CANCEL {
        if !handle.req_cancel(state, me, a0) {
            return handle.err(handle.E_BADHANDLE)
        }
        return 0
    }
    if number == HND_END {
        if handle.req_owner(state, a0) != me {
            return handle.err(handle.E_BADHANDLE)
        }
        let settle_idx: u64 = handle.req_end(state, a0)
        if settle_idx == 0 {
            return 0
        }
        file.open_settle(state, settle_idx - 1)
        return 1
    }
    if number == HND_DUP {
        let of: u64 = of_of(state, me, a0)
        if of >= file.MAX_OPEN {
            return handle.err(handle.E_BADHANDLE)
        }
        let nfd: u64 = file.fd_alloc(state, me, 0)
        if nfd >= file.MAX_FD {
            return handle.err(handle.E_EXHAUSTED)
        }
        let got: u64 = file.fd_pass(state, me, me, a0, a1, nfd)
        if got >= file.MAX_FD {
            return handle.err(handle.E_RIGHTS)
        }
        return got
    }
    if number == HND_PASS {
        let target: u64 = sched.find_pid(state, a0)
        if target >= kstate.MAX_TASKS {
            return handle.err(handle.E_NOTFOUND)
        }
        let got: u64 = file.fd_pass(state, me, target, a1, a2, a3)
        if got >= file.MAX_FD {
            return handle.err(handle.E_RIGHTS)
        }
        return got
    }
    if number == HND_OBJINFO {
        if !kstate.mode_on(state, kstate.M_HANDLE) {
            if !kstate.mode_on(state, kstate.M_ASYNC) {
                return handle.err(handle.E_UNSUPPORTED_HND)
            }
        }
        return objinfo(state, me, a0, a1)
    }
    return handle.err(handle.E_INVALID)
}

fn objinfo(state: u64, me: u64, was: u64, arg: u64) -> u64 {
    if was == 0 {
        return handle.objects_used(state)
    }
    if was == 1 {
        return handle.obj_refs(state, arg)
    }
    if was == 2 {
        return handle.obj_flight(state, arg)
    }
    if was == 3 {
        if handle.obj_live(state, arg) {
            return 1
        }
        return 0
    }
    if was == 4 {
        return handle.req_live(state)
    }
    if was == 5 {
        return handle.obj_gen(state, arg)
    }
    if was == 6 {
        if file.open_kind(state, arg) == file.K_FREE {
            return 0
        }
        return 1
    }
    if was == 7 {
        return file.open_refs(state, arg)
    }
    if was == 8 {
        return of_of(state, me, arg)
    }
    if was == 9 {
        return handle.inflight_on(state, handle.OK_FILE, arg)
    }
    return handle.err(handle.E_INVALID)
}

// =================================================== RUNDE ASYNC

fn aio_errno(h: u64) -> u64 {
    let e: u64 = 0 -% h
    if e == handle.E_BADHANDLE {
        return neg(errno.E_BADF)
    }
    if e == handle.E_RIGHTS {
        return neg(errno.E_BADF)
    }
    if e == handle.E_EXHAUSTED {
        return neg(errno.E_AGAIN)
    }
    if e == handle.E_STALE {
        return neg(errno.E_STALE)
    }
    if e == handle.E_CANCELLED {
        return neg(errno.E_CANCELED)
    }
    return neg(errno.E_INVAL)
}

fn aio_need(op: u64) -> u64 {
    if op == async.OP_READ {
        return handle.R_READ
    }
    if op == async.OP_WRITE {
        return handle.R_WRITE
    }
    return handle.R_NONE
}

// ---------------------------------------------------------- die Abgabe
fn aio_ensure(state: u64) -> bool {
    if async.ready(state) {
        return true
    }
    async.init(state)
    if kstate.mode_on(state, kstate.M_NOAWORK) {
        async.set_ready(state, 1)
        return true
    }
    var k: u64 = 0
    var da: u64 = 0
    while k < async.WORKERS {
        let t: u64 = sched.create(state, sched.K_AIO, 1, k, 0)
        if t != 0 {
            sched.tset(state, t, sched.T_PARENT, 0)
            if sched.start(state, t) {
                da = da + 1
            }
        }
        k = k + 1
    }
    if da == 0 {
        return false
    }
    async.set_ready(state, 1)
    return true
}

fn aio_submit(state: u64, me: u64, op: u64, fd: u64, buf: u64,
    len: u64, udata: u64) -> u64 {
    if op == async.OP_NONE || op > async.OP_MAX {
        return neg(errno.E_INVAL)
    }
    if !aio_ensure(state) {
        return neg(errno.E_NOSYS)
    }
    // 1. Rueckstau.
    if async.live_for(state, me) >= async.CQ_CAP {
        kstate.add(state, kstate.A_FULL, 1)
        return neg(errno.E_AGAIN)
    }
    var token: u64 = handle.TOKEN_NONE
    var length: u64 = len
    if op == async.OP_OPEN {
        let slot: u64 = async.free_index(state)
        if slot >= async.MAX_AIO {
            kstate.add(state, kstate.A_FULL, 1)
            return neg(errno.E_AGAIN)
        }
        let target: u64 = state + kstate.APATH_OFF + slot * kstate.APATH_STRIDE
        let n: u64 = fetch_path(state, me, buf, target,
            kstate.APATH_STRIDE - 1)
        if errno.is_error(n) {
            return n
        }
        if n == 0 {
            return neg(errno.E_NOENT)
        }
        if n >= kstate.APATH_STRIDE - 1 {
            return neg(errno.E_NAMETOOLONG)
        }
        let id: u64 = async.claim_at(state, slot, me,
            sched.tget(state, me, sched.T_PID), op, handle.TOKEN_NONE,
            0, length, udata, n)
        if id == 0 {
            return neg(errno.E_AGAIN)
        }
        return aio_kick(state, me, id)
    }
    // 2. Der Verweis.
    let h: u64 = file.fd_handle(state, me, fd)
    if h == handle.HANDLE_NONE {
        return neg(errno.E_BADF)
    }
    token = handle.req_begin(state, me, h, aio_need(op))
    if handle.is_err(token) {
        return aio_errno(token)
    }
    if op == async.OP_READ || op == async.OP_WRITE {
        if length > MAX_IO {
            length = MAX_IO
        }
        if !proc.user_ok(state, me, buf, length) {
            handle.req_end(state, token)
            return neg(errno.E_FAULT)
        }
    }
    let id: u64 = async.claim(state, me, sched.tget(state, me, sched.T_PID),
        op, token, buf, length, udata, fd)
    if id == 0 {
        let settle_idx: u64 = handle.req_end(state, token)
        if settle_idx != 0 {
            file.open_settle(state, settle_idx - 1)
        }
        return neg(errno.E_AGAIN)
    }
    return aio_kick(state, me, id)
}

fn aio_kick(state: u64, me: u64, id: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_NOAWORK) {
        let i: u64 = async.find(state, id)
        if i < async.MAX_AIO {
            if async.take_one(state, i) {
                aio_run(state, i)
            }
        }
        return id
    }
    sched.poll_kick(state)
    return id
}

// ---------------------------------------------------------- das Warten
fn aio_wait(state: u64, me: u64, out: u64, max: u64, tmo: u64,
    min: u64) -> u64 {
    var n: u64 = max
    if n == 0 {
        return neg(errno.E_INVAL)
    }
    if n > async.CQ_CAP {
        n = async.CQ_CAP
    }
    var mindest: u64 = min
    if mindest == 0 {
        mindest = 1
    }
    if mindest > n {
        mindest = n
    }
    if !proc.user_ok(state, me, out, n * async.C_BYTES) {
        return neg(errno.E_FAULT)
    }
    let forever: bool = tmo >= 0x80000000
    var ticks: u64 = 0
    if !forever && tmo != 0 {
        ticks = (tmo + 9) / 10 + 1
    }
    let deadline: u64 = kstate.get(state, kstate.TICKS) + ticks
    let scratch: u64 = state + kstate.ASC_OFF + 512
    var got: u64 = 0
    var going: bool = true
    while going {
        let seen: u64 = sched.poll_seq(state)
        var keep_going: bool = true
        while keep_going {
            if got >= n {
                keep_going = false
            } else {
                if !async.reap_one(state, me, scratch) {
                    keep_going = false
                } else {
                    if !copy_out(state, me, out + got * async.C_BYTES,
                        scratch, async.C_BYTES) {
                        return neg(errno.E_FAULT)
                    }
                    got = got + 1
                }
            }
        }
        if got >= mindest {
            return got
        }
        if signal.interrupted(state, me) {
            if got != 0 {
                return got
            }
            return neg(errno.E_INTR)
        }
        if tmo == 0 {
            return got
        }
        if !forever {
            if kstate.get(state, kstate.TICKS) >= deadline {
                if got != 0 {
                    return got
                }
                kstate.add(state, kstate.A_TIMEOUTS, 1)
                return neg(errno.E_TIMEDOUT)
            }
        }
        var wake: u64 = deadline
        if forever {
            wake = sched.POLL_FOREVER
        }
        sched.poll_sleep(state, seen, wake)
    }
    return got
}

// -------------------------------------------------------- der Abbruch
fn aio_cancel(state: u64, me: u64, id: u64) -> u64 {
    let i: u64 = async.find(state, id)
    if i >= async.MAX_AIO {
        return neg(errno.E_BADF)
    }
    if async.owner_of(state, i) != me {
        kstate.add(state, kstate.A_DENIED, 1)
        return neg(errno.E_PERM)
    }
    let wie: u64 = async.mark_cancel(state, me, i)
    if wie == 2 {
        return neg(errno.E_AGAIN)
    }
    if wie == 0 {
        async.finish(state, i, neg(errno.E_CANCELED), async.Q_CANCEL)
        async.post(state, i)
    }
    return 0
}

fn aio_info(state: u64, me: u64, was: u64, arg: u64) -> u64 {
    if was == 0 {
        return async.used(state)
    }
    if was == 1 {
        return async.live(state)
    }
    if was == 2 {
        return async.live_for(state, me)
    }
    if was == 3 {
        return async.cq_used(state, me)
    }
    if was == 4 {
        return async.cq_lost(state, me)
    }
    if was == 5 {
        return async.bytes_per_request()
    }
    if was == 6 {
        let i: u64 = async.find(state, arg)
        if i >= async.MAX_AIO {
            return 0
        }
        return async.state_of(state, i)
    }
    if was == 7 {
        return handle.objects_used(state)
    }
    if was == 8 {
        return handle.req_live(state)
    }
    if was == 9 {
        return async.CQ_CAP
    }
    if was == 10 {
        return async.MAX_AIO
    }
    if was == 20 {
        async.hold(state, arg)
        if arg == 0 {
            sched.poll_kick(state)
        }
        return async.held(state)
    }
    if was == 21 {
        return kstate.get(state, kstate.A_ABANDONED)
    }
    if was == 22 {
        return kstate.get(state, kstate.A_POSTED)
    }
    if was == 23 {
        return kstate.get(state, kstate.A_STALED)
    }
    if was == 24 {
        return kstate.get(state, kstate.A_FULL)
    }
    if was == 25 {
        return kstate.get(state, kstate.A_COMPLETED)
    }
    if was == 26 {
        return kstate.get(state, kstate.A_TIMEOUTS)
    }
    if was == 27 {
        return kstate.get(state, kstate.A_DENIED)
    }
    if was == 28 {
        return kstate.get(state, kstate.A_CANCELLED)
    }
    return neg(errno.E_INVAL)
}

fn aio_call(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64,
    a3: u64, a4: u64) -> u64 {
    if number == AIO_VERSION {
        return 1
    }
    if number == AIO_SUBMIT {
        return aio_submit(state, me, a0, a1, a2, a3, a4)
    }
    if number == AIO_WAIT {
        return aio_wait(state, me, a0, a1, a2, a3)
    }
    if number == AIO_CANCEL {
        return aio_cancel(state, me, a0)
    }
    if number == AIO_STATE {
        let i: u64 = async.find(state, a0)
        if i >= async.MAX_AIO {
            return neg(errno.E_BADF)
        }
        if async.owner_of(state, i) != me {
            kstate.add(state, kstate.A_DENIED, 1)
            return neg(errno.E_PERM)
        }
        return async.state_of(state, i)
    }
    if number == AIO_INFO {
        if !kstate.mode_on(state, kstate.M_ASYNC) {
            if !kstate.mode_on(state, kstate.M_ABENCH) {
                return neg(errno.E_NOSYS)
            }
        }
        return aio_info(state, me, a0, a1)
    }
    return neg(errno.E_INVAL)
}

// ============================================== DIE AUSFUEHRUNG
fn aio_exec(state: u64, i: u64) -> u64 {
    let op: u64 = async.op_of(state, i)
    let task: u64 = async.owner_of(state, i)
    let pid: u64 = async.pid_of(state, i)
    let buf: u64 = async.buf_of(state, i)
    let len: u64 = async.len_of(state, i)
    let fd: u64 = async.aux_of(state, i)
    if pid == 0 {
        return neg(errno.E_CANCELED)
    }
    if task >= kstate.MAX_TASKS {
        return neg(errno.E_CANCELED)
    }
    if sched.tget(state, task, sched.T_PID) != pid {
        return neg(errno.E_CANCELED)
    }
    let ts: u64 = sched.tget(state, task, sched.T_STATE)
    if ts == sched.S_FREE || ts == sched.S_ZOMBIE {
        return neg(errno.E_CANCELED)
    }
    // Abgebrochen, bevor irgendetwas geschehen ist.
    if async.state_of(state, i) == async.Q_CANCEL {
        return neg(errno.E_CANCELED)
    }
    if op == async.OP_OPEN {
        async.lock_take(state, sched.current(state))
        let name: u64 = nameb(state)
        let n: u64 = kcopy_word(name, state + kstate.APATH_OFF
            + i * kstate.APATH_STRIDE, kstate.APATH_STRIDE)
        let r: u64 = open_named(state, task, name, n - 1, len, 0)
        async.lock_give(state)
        return r
    }
    var of: u64 = file.MAX_OPEN
    if kstate.mode_on(state, kstate.M_NOAGEN) {
        of = of_of(state, task, fd)
    } else {
        let got: u64 = handle.req_object(state, async.token_of(state, i))
        if handle.is_err(got) {
            kstate.add(state, kstate.A_STALED, 1)
            return aio_errno(got)
        }
        of = got
    }
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if op == async.OP_POLL {
        var re: u64 = poll_ready(state, task, fd)
        re = re & (len | POLLERR | POLLHUP | POLLNVAL)
        if re == 0 {
            return 0 -% 0x1000000
        }
        return re
    }
    if op == async.OP_CLOSE {
        return do_close(state, task, fd)
    }
    if op == async.OP_FSYNC {
        return fsync_of(state, of)
    }
    let lock_state: bool = aio_needs_lock(state, of)
    if lock_state {
        async.lock_take(state, sched.current(state))
    }
    var r: u64 = neg(errno.E_INVAL)
    if op == async.OP_READ {
        r = read_of(state, task, of, buf, len)
    }
    if op == async.OP_WRITE {
        r = write_of(state, task, of, buf, len)
    }
    if lock_state {
        async.lock_give(state)
    }
    return r
}

fn aio_needs_lock(state: u64, of: u64) -> bool {
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_PIPER {
        return false
    }
    if kind == file.K_PIPEW {
        return false
    }
    if kind == file.K_SOCK {
        return false
    }
    return true
}

fn aio_run(state: u64, i: u64) {
    let r: u64 = aio_exec(state, i)
    if r == 0 -% 0x1000000 {
        if async.state_of(state, i) == async.Q_RUN {
            async.set_state(state, i, async.Q_WAIT)
            return
        }
    }
    var endzustand: u64 = async.Q_DONE
    if async.state_of(state, i) == async.Q_CANCEL {
        endzustand = async.Q_CANCEL
    } else {
        if errno.is_error(r) {
            endzustand = async.Q_FAIL
        }
    }
    if endzustand == async.Q_CANCEL {
        async.finish(state, i, neg(errno.E_CANCELED), async.Q_CANCEL)
    } else {
        async.finish(state, i, r, endzustand)
    }
    async.post(state, i)
}

const AIO_IDLE_TICKS: u64 = 100

fn aio_worker(state: u64, index: u64) {
    while true {
        let seen: u64 = sched.poll_seq(state)
        let i: u64 = async.take_new(state)
        if i < async.MAX_AIO {
            aio_run(state, i)
        } else {
            sched.poll_sleep(state, seen,
                kstate.get(state, kstate.TICKS) + AIO_IDLE_TICKS)
            async.rearm(state)
        }
        sched.tset(state, index, sched.T_WORK,
            sched.tget(state, index, sched.T_WORK) + 1)
    }
}

// ------------------------------------------------------------- fsync
fn fsync_of(state: u64, of: u64) -> u64 {
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_PIPER || kind == file.K_PIPEW {
        return neg(errno.E_INVAL)
    }
    if kind == file.K_SOCK {
        return neg(errno.E_INVAL)
    }
    if !blk.flush(state) {
        return neg(errno.E_IO)
    }
    return 0
}

fn do_fsync(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    return fsync_of(state, of)
}

fn native(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64,
    a3: u64, a4: u64) -> u64 {
    if number >= HND_BASE {
        return handle_call(state, me, number, a0, a1, a2, a3)
    }
    if number >= WM_BASE {
        return gfx.sys_wm(state, me, number, a0, a1, a2, a3, a4)
    }
    if number > CAP_MAXNR {
        return cap.err(cap.E_INVALID)
    }
    if number == CAP_VERSION {
        return cap.ABI_VERSION
    }
    if number == CAP_COUNT {
        return cap.used(state, me)
    }
    if number == CAP_CLOSE {
        if !cap.close(state, me, a0) {
            return cap.err(cap.E_BADHANDLE)
        }
        return 0
    }
    let i: u64 = cap.find(state, me, a0)
    if i >= cap.MAX_CAPS {
        return cap.err(cap.E_BADHANDLE)
    }
    let kind: u64 = cap.kind_at(state, me, i)
    let rights: u64 = cap.rights_at(state, me, i)
    let object: u64 = cap.object_at(state, me, i)

    if number == CAP_INSPECT {
        if !cap.rights_contains(rights, cap.R_INSPECT) {
            return cap.err(cap.E_RIGHTS)
        }
        if a1 != 0 {
            if !proc.user_ok(state, me, a1, 16) {
                return cap.err(cap.E_INVALID)
            }
            var k: u64 = 0
            while k < 8 {
                if !poke(state, me, a1 + k, (kind >> (k * 8)) & 255) {
                    return cap.err(cap.E_INVALID)
                }
                if !poke(state, me, a1 + 8 + k, (rights >> (k * 8)) & 255) {
                    return cap.err(cap.E_INVALID)
                }
                k = k + 1
            }
        }
        return 0
    }

    if number == CAP_DUP {
        if !cap.rights_contains(rights, cap.R_DUPLICATE) {
            return cap.err(cap.E_RIGHTS)
        }
        let h: u64 = cap.insert(state, me, kind,
            cap.rights_restrict(rights, a1), object)
        if h == cap.HANDLE_NONE {
            return cap.err(cap.E_EXHAUSTED)
        }
        return h
    }

    if number == CAP_TRANSFER {
        if !cap.rights_contains(rights, cap.R_TRANSFER) {
            return cap.err(cap.E_RIGHTS)
        }
        let target: u64 = sched.find_pid(state, a2)
        if target >= kstate.MAX_TASKS {
            return cap.err(cap.E_NOTFOUND)
        }
        let h: u64 = cap.insert(state, target, kind,
            cap.rights_restrict(rights, a1), object)
        if h == cap.HANDLE_NONE {
            return cap.err(cap.E_EXHAUSTED)
        }
        cap.close(state, me, a0)
        return h
    }

    if number == CAP_READ || number == CAP_WRITE {
        if kind != cap.K_STREAM {
            return cap.err(cap.E_WRONGTYPE)
        }
        var len: u64 = a2
        if len > MAX_IO {
            len = MAX_IO
        }
        if !proc.user_ok(state, me, a1, len) {
            return cap.err(cap.E_INVALID)
        }
        if object >= file.MAX_OPEN {
            return cap.err(cap.E_CLOSED)
        }
        if number == CAP_WRITE {
            if !cap.rights_contains(rights, cap.R_WRITE) {
                return cap.err(cap.E_RIGHTS)
            }
            let nw: u64 = write_of(state, me, object, a1, len)
            if errno.is_error(nw) {
                return cap.err(cap.E_CLOSED)
            }
            return nw
        }
        if !cap.rights_contains(rights, cap.R_READ) {
            return cap.err(cap.E_RIGHTS)
        }
        let nr: u64 = read_of(state, me, object, a1, len)
        if errno.is_error(nr) {
            return cap.err(cap.E_CLOSED)
        }
        return nr
    }
    return cap.err(cap.E_UNSUPPORTED)
}

// =====================================================================
// ROUND K8 -- THE SOCKETS
// =====================================================================
//
// Everything below keeps the three rules at the top of this file. The
// numbers are Linux's; nothing is answered silently (a domain that is
// not AF_INET gives -EAFNOSUPPORT, a descriptor that is not a socket
// gives -ENOTSOCK's nearest relative -EBADF, a pointer that is not the
// caller's gives -EFAULT, checked BEFORE it is followed); and the
// kernel never holds a pointer of ring 3 -- every buffer travels
// through the data area.
//
// A socket lives in TWO tables at once and that is on purpose:
//
//   the OPEN FILE TABLE of round K4  -- kind `file.K_SOCK`, and the
//       number of the socket in `OF_INO`. This is what makes `read`,
//       `write`, `close`, `dup2` and `fork` work on it without any of
//       them learning what a socket is.
//   the SOCKET TABLE of `inet.fi`    -- the kind (TCP/UDP/ICMP), the
//       handle in the stack of round K3, the bound port.
//
// The reference count of the first decides when the second is torn
// down: `unref_of` closes the connection only when the LAST descriptor
// pointing at it goes away. A `fork`ed child that closes its copy must
// not take the parent's connection with it.

// The socket behind a descriptor, or `inet.SOCK_MAX`.
fn sock_of(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return inet.SOCK_MAX
    }
    if file.open_kind(state, of) != file.K_SOCK {
        return inet.SOCK_MAX
    }
    return file.open_ino(state, of)
}

// One reference less on an open file, and the connection behind it torn
// down when that was the last one. Everything in this file that drops a
// descriptor goes through here.
fn unref_of(state: u64, of: u64) {
    if of < file.MAX_OPEN && file.open_kind(state, of) == file.K_USOCK {
        if file.open_refs(state, of) <= 1 {
            unixsock.sock_free(state, file.open_ino(state, of))
            sched.poll_kick(state)
        }
    }
    if of < file.MAX_OPEN && file.open_kind(state, of) == file.K_SHM {
        if file.open_refs(state, of) <= 1 {
            unixsock.shm_unref(state, file.open_ino(state, of))
        }
    }
    if of < file.MAX_OPEN && file.open_kind(state, of) == file.K_SOCK {
        if file.open_refs(state, of) <= 1 {
            netview.release(state, file.open_ino(state, of))
            inet.sock_close(state, file.open_ino(state, of))
        }
    }
    file.open_unref(state, of)
}

// The end of a process. Every socket it still holds and nobody else
// does is closed in an orderly way -- the FIN travels, and the state
// machine of round K3 walks through TIME_WAIT on its own afterwards.
fn sock_close_all(state: u64, me: u64, last_use: bool) {
    // COMPOSITOR S3: the end of a task gives back the references of its mappings of shared objects (before, they stayed for good)
    file_shm_flush_maps(state, me, 0, 0xFFFFFFFFFFFFFFFF, false)
    let _maps: u64 = unixsock.map_release_all(state, me)
    if !last_use {
        return
    }
    var fd: u64 = 0
    while fd < file.MAX_FD {
        let of: u64 = of_of(state, me, fd)
        if of < file.MAX_OPEN && file.open_kind(state, of) == file.K_SOCK {
            if file.open_refs(state, of) <= 1 {
                netview.release(state, file.open_ino(state, of))
                inet.sock_close(state, file.open_ino(state, of))
            }
        }
        if of < file.MAX_OPEN
            && file.open_kind(state, of) == file.K_USOCK {
            if file.open_refs(state, of) <= 1 {
                unixsock.sock_free(state, file.open_ino(state, of))
                sched.poll_kick(state)
            }
        }
        if of < file.MAX_OPEN && file.open_kind(state, of) == file.K_SHM {
            if file.open_refs(state, of) <= 1 {
                unixsock.shm_unref(state, file.open_ino(state, of))
            }
        }
        fd = fd + 1
    }
}

// ------------------------------------------------------ sockaddr_in

// Reads sixteen octets out of ring 3 and takes the address and the port
// out of them. The port and the address are BIG ENDIAN on the wire and
// in this structure; the family is not.
fn sa_in(state: u64, me: u64, addr: u64, len: u64, ipp: *mut u64,
    portp: *mut u64) -> u64 {
    *ipp = 0
    *portp = 0
    if addr == 0 || len < SA_BYTES {
        return neg(errno.E_INVAL)
    }
    var sa: u64 = inet.saddr(state)
    if sa == 0 {
        sa = netview.sa_scratch(state)
    }
    if !copy_in(state, me, sa, addr, SA_BYTES) {
        return neg(errno.E_FAULT)
    }
    let family: u64 = kstate.get8(sa) | (kstate.get8(sa + 1) << 8)
    if family != AF_INET {
        return neg(errno.E_AFNOSUPPORT)
    }
    *portp = (kstate.get8(sa + 2) << 8) | kstate.get8(sa + 3)
    *ipp = (kstate.get8(sa + 4) << 24) | (kstate.get8(sa + 5) << 16)
        | (kstate.get8(sa + 6) << 8) | kstate.get8(sa + 7)
    return 0
}

// And the other direction, with the `socklen_t*` the caller handed in:
// it is read AND written, exactly as `accept(2)` describes it.
fn sa_out(state: u64, me: u64, addr: u64, lenp: u64, a: u64,
    port: u64) -> u64 {
    if addr == 0 {
        return 0
    }
    var room: u64 = SA_BYTES
    if lenp != 0 {
        if !proc.user_ok(state, me, lenp, 4) {
            return neg(errno.E_FAULT)
        }
        room = 0
        var k: u64 = 0
        while k < 4 {
            room = room | (peek(state, me, lenp + k) << (k * 8))
            k = k + 1
        }
    }
    var sa: u64 = inet.saddr(state)
    if sa == 0 {
        sa = netview.sa_scratch(state)
    }
    sa = sa + 64
    var i: u64 = 0
    while i < SA_BYTES {
        kstate.set8(sa + i, 0 as u8)
        i = i + 1
    }
    kstate.set8(sa, (AF_INET & 0xFF) as u8)
    kstate.set8(sa + 1, ((AF_INET >> 8) & 0xFF) as u8)
    kstate.set8(sa + 2, ((port >> 8) & 0xFF) as u8)
    kstate.set8(sa + 3, (port & 0xFF) as u8)
    kstate.set8(sa + 4, ((a >> 24) & 0xFF) as u8)
    kstate.set8(sa + 5, ((a >> 16) & 0xFF) as u8)
    kstate.set8(sa + 6, ((a >> 8) & 0xFF) as u8)
    kstate.set8(sa + 7, (a & 0xFF) as u8)
    var n: u64 = SA_BYTES
    if room < n {
        n = room
    }
    if n > 0 {
        if !copy_out(state, me, addr, sa, n) {
            return neg(errno.E_FAULT)
        }
    }
    if lenp != 0 {
        var k: u64 = 0
        while k < 4 {
            if !poke(state, me, lenp + k, (SA_BYTES >> (k * 8)) & 0xFF) {
                return neg(errno.E_FAULT)
            }
            k = k + 1
        }
    }
    return 0
}

// -------------------------------------------------------- the calls

fn do_socket(state: u64, me: u64, domain: u64, kind: u64,
    protocol: u64) -> u64 {
    if domain == AF_UNIX {
        return do_usocket(state, me, kind, protocol)
    }
    // ROUND NETLINK (r696): AF_NETLINK needs no card either.
    if domain == netlink.AF_NETLINK {
        return do_nlsocket(state, me, kind, protocol)
    }
    if !inet.ready(state) && netview.view_of(state, me) == netview.V_REAL {
        return neg(errno.E_NODEV)
    }
    if domain != AF_INET {
        return neg(errno.E_AFNOSUPPORT)
    }
    let flags: u64 = kind & (SOCK_NONBLOCK | SOCK_CLOEXEC)
    let base: u64 = kind & 0xFF
    var k: u64 = inet.SK_FREE
    if base == SOCK_STREAM {
        if protocol != 0 && protocol != IPPROTO_TCP {
            return neg(errno.E_PROTONOSUPPORT)
        }
        k = inet.SK_TCP
    } else if base == SOCK_DGRAM {
        // The ping socket Linux has had since 3.0. A `ping` that needs
        // no raw socket and no privilege is the reason it exists there,
        // and the reason it exists here.
        if protocol == IPPROTO_ICMP {
            k = inet.SK_ICMP
        } else if protocol == 0 || protocol == IPPROTO_UDP {
            k = inet.SK_UDP
        } else {
            return neg(errno.E_PROTONOSUPPORT)
        }
    } else {
        return neg(errno.E_PROTONOSUPPORT)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        return neg(errno.E_MFILE)
    }
    let si: u64 = inet.sock_new(state, k)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_NFILE)
    }
    netview.reset(state, si)
    // ROUND NETMON: WHOSE SOCKET THIS IS. Written down here, in the one
    // moment the asking task and the running task are the same task. A
    // frame that arrives four milliseconds later arrives while somebody
    // else holds the processor, and asking the scheduler THEN would put
    // the octets on the wrong program.
    netmon.sock_open(state, si, me, sched.tget(state, me, sched.T_PID), k)
    if (flags & SOCK_NONBLOCK) != 0 {
        inet.sock_set_nonblock(state, si)
    }
    let of: u64 = file.open_alloc(state, file.K_SOCK, si, O_RDWR)
    if of >= file.MAX_OPEN {
        inet.sock_close(state, si)
        return neg(errno.E_NFILE)
    }
    file.fd_set(state, me, fd, of)
    return fd
}

fn do_bind(state: u64, me: u64, fd: u64, addr: u64, len: u64) -> u64 {
    let nlof: u64 = nl_of(state, me, fd)
    if nlof < file.MAX_OPEN {
        return nl_bind(state, me, nlof, addr, len)
    }
    if usock_of(state, me, fd) < unixsock.USOCK_MAX {
        return do_ubind(state, me, fd, addr, len)
    }
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    var a: u64 = 0
    var port: u64 = 0
    let r: u64 = sa_in(state, me, addr, len, &a, &port)
    if errno.is_error(r) {
        return r
    }
    if netview.view_of(state, me) != netview.V_REAL {
        return 0
    }
    // An address that is neither 0.0.0.0 nor the one this machine has is
    // one nobody would ever answer for.
    if a != 0 && a != inet.ip(state) {
        return neg(errno.E_ADDRNOTAVAIL)
    }
    return inet.sock_bind(state, si, port)
}

fn do_listen(state: u64, me: u64, fd: u64, backlog: u64) -> u64 {
    if usock_of(state, me, fd) < unixsock.USOCK_MAX {
        return do_ulisten(state, me, fd)
    }
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    if netview.view_of(state, me) != netview.V_REAL {
        return 0
    }
    return inet.sock_listen(state, si, backlog)
}

// Waits, unless the descriptor was asked for in non-blocking mode. The
// waiting is `sleep_ticks`, so the network task goes on moving frames
// the whole time -- that is the whole reason it is a task.
fn do_accept(state: u64, me: u64, fd: u64, addr: u64, lenp: u64,
    flags: u64) -> u64 {
    if usock_of(state, me, fd) < unixsock.USOCK_MAX {
        return do_uaccept(state, me, fd, flags)
    }
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    if netview.view_of(state, me) != netview.V_REAL {
        return neg(errno.E_AGAIN)
    }
    let nb: bool = inet.sock_nonblock(state, si) || (flags & SOCK_NONBLOCK) != 0
    var waited: u64 = 0
    let adl: u64 = sock_deadline(state, si, false)
    var got: u64 = inet.SOCK_MAX
    while got >= inet.SOCK_MAX {
        let c: u64 = inet.sock_accept(state, si)
        if !errno.is_error(c) && c < inet.SOCK_MAX {
            got = c
        } else if nb {
            return neg(errno.E_AGAIN)
        } else if sock_gave_up(state, adl, waited) {
            return neg(errno.E_AGAIN)
        } else {
            waited = waited + 1
            sched.sleep_ticks(state, 1)
        }
    }
    let nfd: u64 = file.fd_alloc(state, me, 0)
    if nfd >= file.MAX_FD {
        inet.sock_close(state, got)
        return neg(errno.E_MFILE)
    }
    let of: u64 = file.open_alloc(state, file.K_SOCK, got, O_RDWR)
    if of >= file.MAX_OPEN {
        inet.sock_close(state, got)
        return neg(errno.E_NFILE)
    }
    file.fd_set(state, me, nfd, of)
    // ROUND NETMON: the accepted connection belongs to whoever accepted
    // it, not to whoever is listening -- with `fork` after `accept`
    // those are two different processes.
    netmon.sock_open(state, got, me, sched.tget(state, me, sched.T_PID),
        netmon.K_TCP)
    var pip: u64 = 0
    var pport: u64 = 0
    inet.sock_peer(state, got, &pip, &pport)
    let w: u64 = sa_out(state, me, addr, lenp, pip, pport)
    if errno.is_error(w) {
        return w
    }
    return nfd
}

// A blocking `connect` comes back when the handshake is done, an error
// when it was refused, and -ETIMEDOUT when nobody ever answered. State 4
// is ESTABLISHED and 0 is CLOSED in the numbering of `net.tcp`.
fn do_connect(state: u64, me: u64, fd: u64, addr: u64, len: u64) -> u64 {
    if usock_of(state, me, fd) < unixsock.USOCK_MAX {
        return do_uconnect(state, me, fd, addr, len)
    }
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    var a: u64 = 0
    var port: u64 = 0
    let r: u64 = sa_in(state, me, addr, len, &a, &port)
    if errno.is_error(r) {
        return r
    }
    // ============================================== RUNDE NETVIEW: DIE TUER
    let d: u64 = netview.decide(state, me, a, port)
    if d == netview.D_DENY {
        return neg(errno.E_NETUNREACH)
    }
    if d == netview.D_FAKE {
        return netview.open_fake(state, si, inet.sock_kind(state, si),
            a, port)
    }
    let c: u64 = inet.sock_connect(state, si, a, port)
    if errno.is_error(c) {
        return c
    }
    if inet.sock_kind(state, si) != inet.SK_TCP {
        return 0
    }
    if inet.sock_nonblock(state, si) {
        return neg(errno.E_INPROGRESS)
    }
    var waited: u64 = 0
    while waited < NET_ROUNDS {
        let st: u64 = inet.sock_state(state, si)
        if st == 4 {
            return 0
        }
        let e: u64 = inet.sock_error(state, si)
        if e != 0 {
            return neg(e)
        }
        if st == 0 && waited > 20 {
            return neg(errno.E_CONNREFUSED)
        }
        waited = waited + 1
        sched.sleep_ticks(state, 1)
    }
    return neg(errno.E_TIMEDOUT)
}

// `send` and `recv` are these two with a null address -- that is what
// glibc does on x86-64, and copying it is what makes a Linux program
// work here without a translation table.
fn do_sendto(state: u64, me: u64, fd: u64, buf: u64, want: u64,
    addr: u64, alen: u64) -> u64 {
    // RUNDE EVENTS: send() on a local socket (socketpair, AF_UNIX) is a write
    let uof: u64 = of_of(state, me, fd)
    if uof < file.MAX_OPEN && file.open_kind(state, uof) == file.K_USOCK {
        if addr != 0 {
            return usock_sendto(state, me, uof, buf, want, addr, alen)
        }
        return write_of(state, me, uof, buf, want)
    }
    if uof < file.MAX_OPEN && file.open_kind(state, uof) == file.K_NETLINK {
        return nl_send_of(state, me, uof, buf, want)
    }
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    var len: u64 = want
    if len > MAX_IO {
        len = MAX_IO
    }
    var a: u64 = 0
    var port: u64 = 0
    if addr != 0 {
        let r: u64 = sa_in(state, me, addr, alen, &a, &port)
        if errno.is_error(r) {
            return r
        }
    }
    // ====================================================== RUNDE NETVIEW
    var fake: bool = netview.is_fake(state, si)
    if !fake && addr != 0 {
        let dc: u64 = netview.decide(state, me, a, port)
        if dc == netview.D_DENY {
            return neg(errno.E_NETUNREACH)
        }
        if dc == netview.D_FAKE {
            netview.open_fake(state, si, inet.sock_kind(state, si), a, port)
            fake = true
        }
    }
    if fake {
        var peek: u64 = len
        if peek > netview.PEEK_MAX {
            peek = netview.PEEK_MAX
        }
        if peek > 0 {
            if !copy_in(state, me, netview.peek_buf(state), buf, peek) {
                return neg(errno.E_FAULT)
            }
        }
        return netview.sendto_fake(state, si, netview.peek_buf(state),
            len, a, port)
    }
    let bounce: u64 = inet.bounce(state)
    if !copy_in(state, me, bounce, buf, len) {
        return neg(errno.E_FAULT)
    }
    return sock_io(state, si, bounce, len, a, port, true)
}

fn do_recvfrom(state: u64, me: u64, fd: u64, buf: u64, want: u64,
    addr: u64, lenp: u64) -> u64 {
    // RUNDE EVENTS: recv() on a local socket (socketpair, AF_UNIX) is a read
    let uof: u64 = of_of(state, me, fd)
    if uof < file.MAX_OPEN && file.open_kind(state, uof) == file.K_USOCK {
        return read_of(state, me, uof, buf, want)
    }
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    var len: u64 = want
    if len > MAX_IO {
        len = MAX_IO
    }
    if !proc.user_ok(state, me, buf, len) {
        return neg(errno.E_FAULT)
    }
    // ====================================================== RUNDE NETVIEW
    if netview.is_fake(state, si) {
        var fa: u64 = 0
        var fp: u64 = 0
        var fl: u64 = len
        if fl > netview.PEEK_MAX {
            fl = netview.PEEK_MAX
        }
        let got: u64 = netview.recvfrom_fake(state, si,
            netview.peek_buf(state), fl, &fa, &fp)
        if errno.is_error(got) {
            return got
        }
        if got > 0 {
            if !copy_out(state, me, buf, netview.peek_buf(state), got) {
                return neg(errno.E_FAULT)
            }
        }
        if addr != 0 {
            let fw: u64 = sa_out(state, me, addr, lenp, fa, fp)
            if errno.is_error(fw) {
                return fw
            }
        }
        return got
    }
    let bounce: u64 = inet.bounce(state)
    var a: u64 = 0
    var port: u64 = 0
    var waited: u64 = 0
    let nb: bool = inet.sock_nonblock(state, si)
    let rdl: u64 = sock_deadline(state, si, false)
    var n: u64 = 0
    var going: bool = true
    while going {
        n = inet.sock_recvfrom(state, si, bounce, len, &a, &port)
        if !errno.is_error(n) {
            going = false
        } else if n != neg(errno.E_AGAIN) {
            return n
        } else if nb || sock_gave_up(state, rdl, waited) {
            return neg(errno.E_AGAIN)
        } else {
            waited = waited + 1
            sched.sleep_ticks(state, 1)
        }
    }
    if n > 0 {
        if !copy_out(state, me, buf, bounce, n) {
            return neg(errno.E_FAULT)
        }
    }
    if addr != 0 {
        let w: u64 = sa_out(state, me, addr, lenp, a, port)
        if errno.is_error(w) {
            return w
        }
    }
    return n
}

// The waiting half of `send`, shared with `write` on a socket. A socket
// whose send window is full is not an error; it is a reason to come back
// in a moment -- and a `write` that returns a SHORT count is what the
// interface has always allowed.
fn sock_io(state: u64, si: u64, bounce: u64, len: u64, a: u64, port: u64,
    to: bool) -> u64 {
    var waited: u64 = 0
    let nb: bool = inet.sock_nonblock(state, si)
    let sdl: u64 = sock_deadline(state, si, true)
    while !sock_gave_up(state, sdl, waited) {
        if to && sdl == 0 && waited >= SENDTO_ROUNDS {
            return neg(errno.E_HOSTUNREACH)
        }
        var n: u64 = 0
        if to {
            n = inet.sock_sendto(state, si, bounce, len, a, port)
        } else {
            n = inet.sock_send(state, si, bounce, len)
        }
        if !errno.is_error(n) {
            return n
        }
        if n != neg(errno.E_AGAIN) {
            return n
        }
        if nb {
            return neg(errno.E_AGAIN)
        }
        waited = waited + 1
        sched.sleep_ticks(state, 1)
    }
    return neg(errno.E_AGAIN)
}

// `read` and `write` on a socket descriptor. The same two functions the
// calls above use, minus the address -- so a program can point `stdout`
// at a connection with `dup2` and never call a socket function again.
fn sock_read(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    return do_recvfrom(state, me, fd_back(state, me, of), buf, len, 0, 0)
}

fn sock_write(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    return do_sendto(state, me, fd_back(state, me, of), buf, len, 0, 0)
}

// `read_of`/`write_of` were split off a descriptor for the native ABI of
// the capability round, so they carry an OPEN FILE and not a number. The
// socket calls want the number back; the table is sixteen entries and
// the search is a loop over them.
fn fd_back(state: u64, me: u64, of: u64) -> u64 {
    var fd: u64 = 0
    while fd < file.MAX_FD {
        if of_of(state, me, fd) == of {
            return fd
        }
        fd = fd + 1
    }
    return file.MAX_FD
}

fn do_shutdown(state: u64, me: u64, fd: u64, how: u64) -> u64 {
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    if netview.is_fake(state, si) {
        return 0
    }
    return inet.sock_shutdown(state, si, how)
}

fn usock_sockname(state: u64, me: u64, si: u64, addr: u64, lenp: u64,
    peer: bool) -> u64 {
    var target: u64 = si
    if peer {
        target = unixsock.sock_peer(state, si)
        if target >= unixsock.USOCK_MAX
            || unixsock.sock_state(state, si) != unixsock.S_CONNECTED {
            return neg(errno.E_NOTCONN)
        }
    }
    let nmi: u64 = unixsock.name_of(state, target)
    let nlen: u64 = unixsock.name_len(state, nmi)
    var total: u64 = 2 + nlen
    if nlen > 0 && unixsock.name_byte(state, nmi, 0) != 0 {
        total = total + 1
    }
    if addr == 0 {
        return 0
    }
    if lenp == 0 || !proc.user_ok(state, me, lenp, 4) {
        return neg(errno.E_FAULT)
    }
    var room: u64 = 0
    var k: u64 = 0
    while k < 4 {
        room = room | (peek(state, me, lenp + k) << (k * 8))
        k = k + 1
    }
    var n: u64 = total
    if room < n {
        n = room
    }
    var o: u64 = 0
    while o < n {
        var b: u64 = 0
        if o == 0 {
            b = AF_UNIX & 0xFF
        } else if o >= 2 && o - 2 < nlen {
            b = unixsock.name_byte(state, nmi, o - 2)
        }
        if !poke(state, me, addr + o, b) {
            return neg(errno.E_FAULT)
        }
        o = o + 1
    }
    k = 0
    while k < 4 {
        if !poke(state, me, lenp + k, (total >> (k * 8)) & 0xFF) {
            return neg(errno.E_FAULT)
        }
        k = k + 1
    }
    return 0
}

fn do_sockname(state: u64, me: u64, fd: u64, addr: u64, lenp: u64,
    peer: bool) -> u64 {
    let nlof: u64 = nl_of(state, me, fd)
    if nlof < file.MAX_OPEN {
        return nl_sockname(state, me, nlof, addr, lenp, peer)
    }
    let usi: u64 = usock_of(state, me, fd)
    if usi < unixsock.USOCK_MAX {
        return usock_sockname(state, me, usi, addr, lenp, peer)
    }
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    var a: u64 = 0
    var port: u64 = 0
    var r: u64 = 0
    if netview.is_fake(state, si) {
        if peer {
            netview.peer_of(state, si, &a, &port)
        } else {
            a = netview.FAKE_IP
            port = 0
        }
        return sa_out(state, me, addr, lenp, a, port)
    }
    if peer {
        r = inet.sock_peer(state, si, &a, &port)
    } else {
        r = inet.sock_local(state, si, &a, &port)
    }
    if errno.is_error(r) {
        return r
    }
    return sa_out(state, me, addr, lenp, a, port)
}

// Options: SO_KEEPALIVE and TCP_KEEPIDLE/KEEPINTVL/KEEPCNT are acted on
// (N-006, see below and tcp.fi). Every other option is taken and none is
// acted on -- and that is said here rather than answered with
// -ENOPROTOOPT, which would make `curl` and `nc` give up for no reason.
//
// ROUND FV-W24: ALSO ACTED ON NOW: SO_RCVTIMEO and SO_SNDTIMEO
// (SOL_SOCKET 20 and 21, and the 64-bit "_NEW" names 66 and 67, which take
// the same `struct timeval` here). The value is kept in ticks in the flags
// word of the socket (`inet.sock_set_tmo`) and read by the waiting loops of
// recv, accept and send (`sock_deadline`). Until this round the option was
// taken and thrown away, so a "timed" read blocked until data came (up to
// NET_ROUNDS = 30 s) and every program that relied on the timeout stalled.
fn do_setsockopt(state: u64, me: u64, fd: u64, level: u64,
    name: u64, val: u64, optlen: u64) -> u64 {
    if nl_of(state, me, fd) < file.MAX_OPEN {
        return 0
    }
    let si: u64 = sock_of(state, me, fd)
    if si >= inet.SOCK_MAX {
        return neg(errno.E_BADF)
    }
    if level == 1 && (name == 20 || name == 21 || name == 66 || name == 67) {
        if optlen < 16 {
            return neg(errno.E_INVAL)
        }
        if !proc.user_ok(state, me, val, 16) {
            return neg(errno.E_FAULT)
        }
        var sec: u64 = 0
        var usec: u64 = 0
        var k: u64 = 0
        while k < 8 {
            sec = sec | (peek(state, me, val + k) << (k * 8))
            usec = usec | (peek(state, me, val + 8 + k) << (k * 8))
            k = k + 1
        }
        // a negative or out-of-range value is -EINVAL, as on Linux
        if sec >= 0x8000000000000000 || usec >= 1000000 {
            return neg(errno.E_INVAL)
        }
        var ticks: u64 = inet.TMO_MASK
        if sec < 100000 {
            // rounded UP: a timeout never fires earlier than asked
            ticks = (sec * 1000000 + usec + 9999) / 10000
        }
        inet.sock_set_tmo(state, si, name == 21 || name == 67, ticks)
        return 0
    }
    // N-006: SO_KEEPALIVE (SOL_SOCKET 9) and TCP_KEEPIDLE / TCP_KEEPINTVL /
    // TCP_KEEPCNT (IPPROTO_TCP 4 / 5 / 6) are acted on; every other option
    // stays accepted and ignored, as above.
    var which: u64 = 99
    if level == 1 && name == 9 {
        which = inet.KA_ON
    }
    if level == 6 && name >= 4 && name <= 6 {
        which = name - 3
        if inet.sock_kind(state, si) != inet.SK_TCP {
            return neg(errno.E_NOPROTOOPT)
        }
    }
    if which == 99 {
        return 0
    }
    if optlen < 4 {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, val, 4) {
        return neg(errno.E_FAULT)
    }
    var v: u64 = 0
    var k: u64 = 0
    while k < 4 {
        v = v | (peek(state, me, val + k) << (k * 8))
        k = k + 1
    }
    // the value is an int: a negative one is out of range, as on Linux
    if which == inet.KA_IDLE || which == inet.KA_INTVL {
        if v < 1 || v > 32767 {
            return neg(errno.E_INVAL)
        }
    }
    if which == inet.KA_CNT {
        if v < 1 || v > 127 {
            return neg(errno.E_INVAL)
        }
    }
    return inet.sock_ka_set(state, si, which, v)
}

// The tick at which a blocking call on socket `si` must give up, or 0 when
// no timeout is set (then the old NET_ROUNDS bound applies). Like `poll`,
// the running tick counts as one: the wait lies between `timeout` and
// `timeout + 10 ms`, never below it.
fn sock_deadline(state: u64, si: u64, snd: bool) -> u64 {
    let t: u64 = inet.sock_tmo(state, si, snd)
    if t == 0 {
        return 0
    }
    return kstate.get(state, kstate.TICKS) + t + 1
}

// True when a waiting loop has to stop: the user timeout passed, or --
// without one -- the old NET_ROUNDS bound.
fn sock_gave_up(state: u64, deadline: u64, waited: u64) -> bool {
    if deadline != 0 {
        return kstate.get(state, kstate.TICKS) >= deadline
    }
    return waited >= NET_ROUNDS
}

// SIOCGIFCONF: struct ifconf { int ifc_len; char *ifc_buf } -> one ifreq (40 bytes) for "eth0" with its address.
// With ifc_buf == 0 only the needed length is returned. `bo` holds the first 40 bytes of the user struct.
fn do_ifconf(state: u64, me: u64, arg: u64, bo: u64) -> u64 {
    if !inet.ready(state) {
        return neg(errno.E_NODEV)
    }
    var room: u64 = 0
    var buf: u64 = 0
    var k: u64 = 0
    while k < 4 {
        room = room | ((kstate.get8(bo + k) as u64) << (k * 8))
        k = k + 1
    }
    k = 0
    while k < 8 {
        buf = buf | ((kstate.get8(bo + 8 + k) as u64) << (k * 8))
        k = k + 1
    }
    if buf != 0 && room >= 40 {
        var i: u64 = 0
        while i < 40 {
            kstate.set8(bo + 16 + i, 0 as u8)
            i = i + 1
        }
        // the entry is built after the struct (bo + 16): name, then sockaddr_in
        kstate.set8(bo + 16, 101 as u8)
        kstate.set8(bo + 17, 116 as u8)
        kstate.set8(bo + 18, 104 as u8)
        kstate.set8(bo + 19, 48 as u8)
        let a: u64 = inet.ip(state)
        kstate.set8(bo + 32, (AF_INET & 0xFF) as u8)
        kstate.set8(bo + 36, ((a >> 24) & 0xFF) as u8)
        kstate.set8(bo + 37, ((a >> 16) & 0xFF) as u8)
        kstate.set8(bo + 38, ((a >> 8) & 0xFF) as u8)
        kstate.set8(bo + 39, (a & 0xFF) as u8)
        if !proc.user_ok(state, me, buf, 40) || !copy_out(state, me, buf, bo + 16, 40) {
            return neg(errno.E_FAULT)
        }
    } else if buf != 0 {
        room = 0
        if !put32(state, me, arg, 0) {
            return neg(errno.E_FAULT)
        }
        return 0
    }
    if !put32(state, me, arg, 40) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// ROUND STONES2: SIOCGIFFLAGS/ADDR/BRDADDR/NETMASK/HWADDR/MTU/METRIC for the
// one interface this kernel has, "eth0" (struct ifreq: 16 name bytes + a
// 24 byte union). Anything else is -ENOTTY as before; an unknown interface
// is -ENODEV. Nothing is invented: flags/address/mask come from the stack.
fn do_ifioctl(state: u64, me: u64, req: u64, arg: u64) -> u64 {
    if arg == 0 || !proc.user_ok(state, me, arg, 40) {
        return neg(errno.E_FAULT)
    }
    let bo: u64 = blockb(state)
    if !copy_in(state, me, bo, arg, 40) {
        return neg(errno.E_FAULT)
    }
    if req == 0x8912 {
        return do_ifconf(state, me, arg, bo)
    }
    // ROUND NETLINK (r696): SIOCGIFNAME (index -> name), the call `ip` uses to name an interface it only has the index of.
    if req == 0x8910 {
        if kstate.get8(bo + 16) != 1 || kstate.get8(bo + 17) != 0 || kstate.get8(bo + 18) != 0 || kstate.get8(bo + 19) != 0
            || !inet.ready(state) {
            return neg(errno.E_NODEV)
        }
        var z: u64 = 0
        while z < 16 {
            kstate.set8(bo + z, 0 as u8)
            z = z + 1
        }
        kstate.set8(bo, 101 as u8)
        kstate.set8(bo + 1, 116 as u8)
        kstate.set8(bo + 2, 104 as u8)
        kstate.set8(bo + 3, 48 as u8)
        if !copy_out(state, me, arg, bo, 40) {
            return neg(errno.E_FAULT)
        }
        return 0
    }
    if (kstate.get8(bo) as u64) != 101 || (kstate.get8(bo + 1) as u64) != 116
        || (kstate.get8(bo + 2) as u64) != 104 || (kstate.get8(bo + 3) as u64) != 48
        || (kstate.get8(bo + 4) as u64) != 0 || !inet.ready(state) {
        return neg(errno.E_NODEV)
    }
    var i: u64 = 16
    while i < 40 {
        kstate.set8(bo + i, 0 as u8)
        i = i + 1
    }
    var v: u64 = 0
    var is_addr: bool = false
    if req == 0x8913 {
        // IFF_UP | IFF_BROADCAST | IFF_MULTICAST, and IFF_RUNNING only with a carrier
        v = 0x1003
        if inet.carrier(state) {
            v = v | 0x40
        }
        kstate.set8(bo + 16, (v & 0xFF) as u8)
        kstate.set8(bo + 17, ((v >> 8) & 0xFF) as u8)
    } else if req == 0x8915 || req == 0x891b || req == 0x8919 {
        is_addr = true
        v = inet.ip(state)
        if req == 0x891b {
            v = inet.mask(state)
        }
        if req == 0x8919 {
            v = inet.ip(state) | ((~inet.mask(state)) & 0xFFFFFFFF)
        }
        kstate.set8(bo + 16, (AF_INET & 0xFF) as u8)
        kstate.set8(bo + 20, ((v >> 24) & 0xFF) as u8)
        kstate.set8(bo + 21, ((v >> 16) & 0xFF) as u8)
        kstate.set8(bo + 22, ((v >> 8) & 0xFF) as u8)
        kstate.set8(bo + 23, (v & 0xFF) as u8)
    } else if req == 0x8927 {
        kstate.set8(bo + 16, 1 as u8)
        var m: u64 = 0
        while m < 6 {
            kstate.set8(bo + 18 + m, (inet.mac_at(state, m) & 0xFF) as u8)
            m = m + 1
        }
    } else if req == 0x8921 {
        kstate.set8(bo + 16, 0xDC as u8)
        kstate.set8(bo + 17, 0x05 as u8)
    } else if req == 0x8933 {
        // SIOCGIFINDEX: the same index the netlink dump gives eth0
        kstate.set8(bo + 16, 1 as u8)
    } else if req == 0x8942 {
        // SIOCGIFTXQLEN: 1000, as the netlink dump says
        kstate.set8(bo + 16, 0xE8 as u8)
        kstate.set8(bo + 17, 0x03 as u8)
    } else if req == 0x891d {
        kstate.set8(bo + 16, 0 as u8)
    } else {
        return neg(errno.E_NOTTY)
    }
    if is_addr && v == 0 && req == 0x8915 {
        return neg(errno.E_ADDRNOTAVAIL)
    }
    if !copy_out(state, me, arg, bo, 40) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// ROUND STONES2: getsockopt(2). curl asks SO_ERROR after every non-blocking
// connect (poll says writable, SO_ERROR says whether it worked); without the
// call the answer was -ENOSYS and curl reported "could not connect". Values
// are the ones of a plain Linux socket: nothing is buffered beyond the
// defaults, no keep-alive, no linger. An option this kernel does not know is
// -ENOPROTOOPT, never a made-up value.
fn do_getsockopt(state: u64, me: u64, fd: u64, level: u64, name: u64,
    val: u64, lenp: u64) -> u64 {
    let nlof: u64 = nl_of(state, me, fd)
    if nlof < file.MAX_OPEN {
        return nl_getsockopt(state, me, level, name, val, lenp)
    }
    let si: u64 = sock_of(state, me, fd)
    let ui: u64 = usock_of(state, me, fd)
    if si >= inet.SOCK_MAX && ui >= unixsock.USOCK_MAX {
        return neg(errno.E_BADF)
    }
    if !proc.user_ok(state, me, lenp, 4) {
        return neg(errno.E_FAULT)
    }
    var room: u64 = 0
    var k: u64 = 0
    while k < 4 {
        room = room | (peek(state, me, lenp + k) << (k * 8))
        k = k + 1
    }
    if room < 4 {
        return neg(errno.E_INVAL)
    }
    // ROUND FV-W24: SO_RCVTIMEO / SO_SNDTIMEO read back as a `struct timeval`
    // (the stored ticks, 10 ms each).
    if level == 1 && (name == 20 || name == 21 || name == 66 || name == 67) && si < inet.SOCK_MAX {
        if room < 16 {
            return neg(errno.E_INVAL)
        }
        let tk: u64 = inet.sock_tmo(state, si, name == 21 || name == 67)
        let us: u64 = tk * 10000
        if !put64(state, me, val, us / 1000000) || !put64(state, me, val + 8, us % 1000000) || !put32(state, me, lenp, 16) {
            return neg(errno.E_FAULT)
        }
        return 0
    }
    var v: u64 = 0
    var known: bool = false
    if level == 1 {
        // SOL_SOCKET: 2 REUSEADDR, 3 TYPE, 4 ERROR, 7 SNDBUF, 8 RCVBUF, 9 KEEPALIVE, 30 ACCEPTCONN
        if name == 2 || name == 30 {
            known = true
        }
        if name == 9 {
            known = true
            if si < inet.SOCK_MAX {
                v = inet.sock_ka_get(state, si, inet.KA_ON)
            }
        }
        if name == 3 {
            known = true
            v = 1
            if si < inet.SOCK_MAX && inet.sock_kind(state, si) == inet.SK_UDP {
                v = 2
            }
        }
        if name == 4 {
            known = true
            if si < inet.SOCK_MAX {
                v = inet.sock_error(state, si)
            }
        }
        if name == 7 || name == 8 {
            known = true
            v = 65536
        }
    }
    if level == 6 && name == 1 {
        // IPPROTO_TCP, TCP_NODELAY
        known = true
    }
    if level == 6 && name >= 4 && name <= 6 && si < inet.SOCK_MAX
        && inet.sock_kind(state, si) == inet.SK_TCP {
        // N-006: TCP_KEEPIDLE (4), TCP_KEEPINTVL (5), TCP_KEEPCNT (6)
        known = true
        v = inet.sock_ka_get(state, si, name - 3)
    }
    if !known {
        return neg(errno.E_NOPROTOOPT)
    }
    if !put32(state, me, val, v) || !put32(state, me, lenp, 4) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// ====================================================== RUNDE DESKTOP
fn kbd_call(state: u64, was: u64, value: u64) -> u64 {
    if was == KB_GET {
        return kbd.layout(state)
    }
    if was == KB_COUNT {
        return kbd.LAYOUTS
    }
    if was == KB_SWITCH {
        return kbd.switches(state)
    }
    if was == KB_SET {
        if kbd.set_layout(state, value) {
            return 0
        }
        return errno.neg(errno.E_INVAL)
    }
    return errno.neg(errno.E_INVAL)
}

// ======================================================= RUNDE NETVIEW
fn task_of_pid(state: u64, me: u64, pid: u64) -> u64 {
    if pid == 0 {
        return me
    }
    return sched.find_pid(state, pid)
}

fn do_netvget(state: u64, me: u64, pid: u64, what: u64) -> u64 {
    if what == NV_DROPPED {
        return netview.dropped(state)
    }
    if what == NV_OPENED {
        return netview.opened(state)
    }
    if what == NV_DENIED {
        return netview.denials(state)
    }
    if what == NV_REPLIES {
        return netview.replies(state)
    }
    if what == NV_FALLBACK {
        return netview.fallback(state)
    }
    if what == NV_FBVIEW {
        return netview.fallback_view(state)
    }
    if what == NV_LINK {
        return netview.link_state(state)
    }
    let t: u64 = task_of_pid(state, me, pid)
    if t == 0 || t >= kstate.MAX_TASKS {
        return neg(errno.E_SRCH)
    }
    if sched.tget(state, t, sched.T_STATE) == sched.S_FREE {
        return neg(errno.E_SRCH)
    }
    if what == NV_MODE {
        return netview.view_of(state, t)
    }
    if what == NV_ALLOWN {
        return netview.allow_count(state, t)
    }
    if what == NV_PID {
        return sched.tget(state, t, sched.T_PID)
    }
    if what >= NV_ALLOW && what < NV_ALLOW + sched.NETOK_MAX {
        return netview.allow_at(state, t, what - NV_ALLOW)
    }
    return neg(errno.E_INVAL)
}

fn do_netvset(state: u64, me: u64, pid: u64, want: u64) -> u64 {
    let t: u64 = task_of_pid(state, me, pid)
    if t == 0 || t >= kstate.MAX_TASKS {
        return neg(errno.E_SRCH)
    }
    if sched.tget(state, t, sched.T_STATE) == sched.S_FREE {
        return neg(errno.E_SRCH)
    }
    let v: u64 = want & 0xFF
    if !netview.may_set(state, me, t, v) {
        return neg(errno.E_PERM)
    }
    if (want & 0x100) != 0 {
        netview.allow_clear(state, t)
    }
    netview.set_view(state, t, v)
    return 0
}

fn do_netvallow(state: u64, me: u64, pid: u64, addr: u64,
    pp: u64) -> u64 {
    let t: u64 = task_of_pid(state, me, pid)
    if t == 0 || t >= kstate.MAX_TASKS {
        return neg(errno.E_SRCH)
    }
    if sched.tget(state, t, sched.T_STATE) == sched.S_FREE {
        return neg(errno.E_SRCH)
    }
    if !netview.may_set(state, me, t, netview.view_of(state, t)) {
        return neg(errno.E_PERM)
    }
    if addr == 0 && pp == 0 {
        netview.allow_clear(state, t)
        return 0
    }
    if !netview.allow_add(state, t, addr, (pp >> 16) & 0xFFFF,
        pp & 0xFF) {
        return neg(errno.E_NOSPC)
    }
    return 0
}

fn ctr_admin(state: u64, me: u64) -> bool {
    if ctr.ctr_of(state, me) != ctr.HOST {
        return false
    }
    return sched.tget(state, me, sched.T_EUID) == 0
}

// AB-003. GET is open to everyone -- the label is not a secret, it is the
// thing a broker needs to know about its caller. SET only ever narrows
// (kernel/sched/origin.fi).
fn do_rights(state: u64, me: u64, op: u64, a1: u64, a2: u64) -> u64 {
    let buf: u64 = nameb(state)
    let n: u64 = fetch_name(state, me, a1, buf, policy.NAME_MAX + 1)
    if errno.is_error(n) {
        return n
    }
    if op == OG_RGET {
        return policy.get_mask(buf)
    }
    if op == OG_CGET {
        return policy.get_ceiling(buf)
    }
    // a labelled process (an app, or anything an app started) can never widen its own rights or its own ceiling
    if !origin.is_empty(state, me) {
        return neg(errno.E_PERM)
    }
    var r: u64 = 0
    if op == OG_CSET {
        r = policy.set_ceiling(buf, a2)
    } else {
        r = policy.set_mask(buf, a2)
    }
    if r == policy.E_FULL {
        return neg(errno.E_NOMEM)
    }
    if r == policy.E_CEIL {
        return neg(errno.E_PERM)
    }
    if r != policy.E_OK {
        return neg(errno.E_INVAL)
    }
    // W-WINOPTS S2: a float window whose owner just lost `window.float` goes back to L_NORMAL
    let _f: u64 = gfx.sys_float_check(state)
    return 0
}

fn do_origin(state: u64, me: u64, op: u64, a1: u64, a2: u64) -> u64 {
    if op == OG_RGET || op == OG_RSET || op == OG_CGET || op == OG_CSET {
        return do_rights(state, me, op, a1, a2)
    }
    if op == OG_GET {
        var t: u64 = me
        if a1 != 0 {
            t = sched.find_pid(state, a1)
            if t >= kstate.MAX_TASKS {
                return neg(errno.E_SRCH)
            }
        }
        var n: u64 = 0
        while n < origin.LEN && origin.byte_at(state, t, n) != 0 {
            n = n + 1
        }
        if a2 == 0 {
            return n
        }
        // the buffer is origin.LEN (32) octets -- the whole field goes
        // out, zero-padded, so no length has to be passed
        if !copy_out(state, me, a2, origin.at(state, t), origin.LEN) {
            return neg(errno.E_FAULT)
        }
        return n
    }
    if op == OG_SET {
        if a2 == 0 || a2 >= origin.LEN {
            return neg(errno.E_INVAL)
        }
        let buf: u64 = nameb(state)
        let n: u64 = fetch_name(state, me, a1, buf, origin.LEN)
        if errno.is_error(n) {
            return n
        }
        if n != a2 {
            return neg(errno.E_INVAL)
        }
        let r: u64 = origin.set_self(state, me, buf, n)
        if r == 1 {
            return neg(errno.E_PERM)
        }
        if r != 0 {
            return neg(errno.E_INVAL)
        }
        return 0
    }
    return neg(errno.E_INVAL)
}

fn do_ctrget(state: u64, me: u64, field: u64, nr: u64, c: u64) -> u64 {
    if field == CG_MINE {
        return ctr.ctr_of(state, me)
    }
    if field == CG_COUNT {
        return ctr.count(state)
    }
    if field == CG_CREATED {
        return ctr.created(state)
    }
    if field == CG_DESTROYED {
        return ctr.destroyed(state)
    }
    if field == CG_ESCAPES {
        return ctr.escapes(state)
    }
    if field == CG_MAXC {
        return ctr.MAX_CTR
    }
    var i: u64 = nr
    if i == 0 {
        i = ctr.ctr_of(state, me)
    }
    if i == 0 || i >= ctr.MAX_CTR {
        return neg(errno.E_INVAL)
    }
    let mein: u64 = ctr.ctr_of(state, me)
    if mein != ctr.HOST && mein != i {
        return neg(errno.E_PERM)
    }
    if field == CG_STATE {
        return ctr.state_of(state, i)
    }
    if field == CG_MEMLIM {
        return ctr.mem_limit(state, i)
    }
    if field == CG_MEMUSE {
        return ctr.mem_used(state, i)
    }
    if field == CG_MEMPEAK {
        return ctr.mem_peak(state, i)
    }
    if field == CG_MEMDENY {
        return ctr.mem_denials(state, i)
    }
    if field == CG_CPUSH {
        return ctr.cpu_share(state, i)
    }
    if field == CG_CPUTICK {
        return ctr.cpu_ticks(state, i)
    }
    if field == CG_PROCS {
        return ctr.procs_of(state, i)
    }
    if field == CG_PROCLIM {
        return ctr.procs_limit(state, i)
    }
    if field == CG_ROOTLEN {
        return ctr.root_len(state, i)
    }
    if field == CG_NETV {
        return ctr.netview_of(state, i)
    }
    if field == CG_NAMEC {
        return ctr.name_at(state, i, c)
    }
    if field == CG_ROOTC {
        return ctr.root_at(state, i, c)
    }
    return neg(errno.E_INVAL)
}

fn do_ctrnew(state: u64, me: u64, name: u64, len: u64) -> u64 {
    if !ctr_admin(state, me) {
        return neg(errno.E_PERM)
    }
    let i: u64 = ctr.alloc(state)
    if i == 0 {
        return neg(errno.E_NOSPC)
    }
    if name != 0 {
        let buf: u64 = nameb(state)
        let n: u64 = fetch_name(state, me, name, buf, ctr.NAME_MAX)
        if !errno.is_error(n) {
            ctr.name_set(state, i, buf)
        }
    }
    return i
}

fn do_ctrset(state: u64, me: u64, nr: u64, field: u64, value: u64) -> u64 {
    if !ctr_admin(state, me) {
        return neg(errno.E_PERM)
    }
    if nr == 0 || nr >= ctr.MAX_CTR {
        return neg(errno.E_INVAL)
    }
    if !ctr.exists(state, nr) {
        return neg(errno.E_SRCH)
    }
    if field == CS_MEMLIM {
        if !ctr.may_limit(state, nr, value) {
            ctr.note_escape(state)
            return neg(errno.E_PERM)
        }
        ctr.mem_limit_set(state, nr, value)
        return 0
    }
    if field == CS_CPUSH {
        if !ctr.cpu_share_set(state, nr, value) {
            return neg(errno.E_INVAL)
        }
        return 0
    }
    if field == CS_PROCLIM {
        ctr.procs_limit_set(state, nr, value)
        return 0
    }
    if field == CS_NETV {
        if value > netview.V_LAST {
            return neg(errno.E_INVAL)
        }
        ctr.netview_set(state, nr, value)
        return 0
    }
    if field == CS_STATE {
        if value > ctr.C_DEAD {
            return neg(errno.E_INVAL)
        }
        if value == ctr.C_FREE {
            if ctr.procs_of(state, nr) != 0 {
                return neg(errno.E_BUSY)
            }
            ctr.free_slot(state, nr)
            return 0
        }
        ctr.set_state(state, nr, value)
        return 0
    }
    if field == CS_ROOT {
        let buf: u64 = nameb(state)
        let n: u64 = fetch_name(state, me, value, buf, ctr.ROOT_MAX)
        if errno.is_error(n) {
            return n
        }
        if !ctr.may_reroot(state, nr, buf) {
            ctr.note_escape(state)
            return neg(errno.E_PERM)
        }
        if !ctr.root_set(state, nr, buf) {
            return neg(errno.E_INVAL)
        }
        return 0
    }
    return neg(errno.E_INVAL)
}

fn do_ctrenter(state: u64, me: u64, nr: u64) -> u64 {
    if !ctr_admin(state, me) {
        return neg(errno.E_PERM)
    }
    if nr == 0 || nr >= ctr.MAX_CTR {
        return neg(errno.E_INVAL)
    }
    if !ctr.alive(state, nr) {
        return neg(errno.E_SRCH)
    }
    if ctr.root_len(state, nr) == 0 {
        return neg(errno.E_INVAL)
    }
    let lim: u64 = ctr.procs_limit(state, nr)
    if lim != 0 {
        if ctr.procs_of(state, nr) >= lim {
            return neg(errno.E_AGAIN)
        }
    }
    ctr.set_ctr(state, me, nr)
    ctr.set_state(state, nr, ctr.C_RUN)
    let v: u64 = ctr.netview_of(state, nr)
    if v != 0 {
        netview.set_view(state, me, v)
    }
    uio.reset(state, me)
    return 0
}

fn do_netvfb(state: u64, me: u64, want: u64) -> u64 {
    if sched.tget(state, me, sched.T_EUID) != 0 {
        return neg(errno.E_PERM)
    }
    if want > netview.FB_LAST {
        return neg(errno.E_INVAL)
    }
    netview.fallback_set(state, want)
    return 0
}

fn do_hotkey(state: u64, what: u64) -> u64 {
    if what == HK_SEQ_Q {
        return kbd.hotkey_seq(state)
    }
    if what == HK_KEY_Q {
        return kbd.hotkey_key(state)
    }
    if what == HK_NS_Q {
        return kbd.hotkey_ns(state)
    }
    if what == HK_DOWN_Q {
        return kbd.super_down(state)
    }
    return neg(errno.E_INVAL)
}

// ======================================================= ROUND NETMON
//
// One number out of the accounting. Everything it can answer is a
// counter or a field of a record that already exists; this function
// invents nothing and rounds nothing.
fn do_netmon(state: u64, me: u64, kind: u64, index: u64,
    field: u64) -> u64 {
    if kind == 0 {
        if field == NM_ON {
            if netmon.on(state) {
                return 1
            }
            return 0
        }
        if field == NM_LOOKUPS {
            return netmon.lookups(state)
        }
        if field == NM_HITS {
            return netmon.hits(state)
        }
        if field == NM_MISSES {
            return netmon.misses(state)
        }
        if field == NM_SYSTX {
            return netmon.sys_octets(state, 0)
        }
        if field == NM_SYSRX {
            return netmon.sys_octets(state, 1)
        }
        if field == NM_TICKS {
            return kstate.get(state, kstate.TICKS)
        }
        if field == NM_HZ {
            return 100
        }
        if field == NM_CARDTX {
            return inet.card_octets(state, 0)
        }
        if field == NM_CARDRX {
            return inet.card_octets(state, 1)
        }
        if field == NM_NTASK {
            return kstate.MAX_TASKS
        }
        if field == NM_NSOCK {
            return netmon.NSOCK
        }
        if field == NM_NPROG {
            return netmon.NPROG
        }
        return neg(errno.E_INVAL)
    }
    if kind == 1 {
        if index >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
        if field < netmon.T_FIELDS {
            return netmon.tget(state, index, field)
        }
        if field == NT_PID {
            return sched.tget(state, index, sched.T_PID)
        }
        if field == NT_ALIVE {
            let st: u64 = sched.tget(state, index, sched.T_STATE)
            if st == sched.S_FREE || st == sched.S_ZOMBIE {
                return 0
            }
            return 1
        }
        if field == NT_VIEW {
            return netview.view_of(state, index)
        }
        if field == NT_STATE {
            return sched.tget(state, index, sched.T_STATE)
        }
        return neg(errno.E_INVAL)
    }
    if kind == 2 {
        if index >= netmon.NSOCK {
            return neg(errno.E_INVAL)
        }
        if field < netmon.S_FIELDS {
            return netmon.sget(state, index, field)
        }
        if field == NS_TCPSTATE {
            if netmon.sget(state, index, netmon.S_USE) == 0 {
                return 0
            }
            return inet.sock_state(state, index)
        }
        if field == NS_AGE {
            if netmon.sget(state, index, netmon.S_USE) == 0 {
                return 0
            }
            return kstate.get(state, kstate.TICKS)
                - netmon.sget(state, index, netmon.S_T0)
        }
        return neg(errno.E_INVAL)
    }
    if kind == 3 {
        if index >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
        return netmon.name_at(state, index, field)
    }
    if kind == 4 {
        if index >= netmon.NPROG {
            return neg(errno.E_INVAL)
        }
        if field < netmon.T_FIELDS {
            return netmon.pget(state, index, field)
        }
        if field == NP_USED {
            return netmon.prog_used(state, index)
        }
        return neg(errno.E_INVAL)
    }
    if kind == 5 {
        if index >= netmon.NPROG {
            return neg(errno.E_INVAL)
        }
        return netmon.prog_name_at(state, index, field)
    }
    return neg(errno.E_INVAL)
}

// ROUND NETMON PART TWO: one number about the sharing.
fn do_share(state: u64, me: u64, what: u64, index: u64) -> u64 {
    if what == SH_SET {
        if sched.tget(state, me, sched.T_EUID) != 0 {
            return neg(errno.E_PERM)
        }
        // SWITCHED ON MEANS SWITCHED ON, not brought up: the card is
        // claimed once at boot (`netsvc.stage`) because claiming a PCI
        // device out of a system call would mean a driver coming up
        // while the network task is already turning the crank on it.
        // What this does is open and close the gate.
        if index != 0 && !share.on(state) {
            if share.uplink(state) == share.shared(state) {
                return neg(errno.E_NODEV)
            }
        }
        var v: u64 = 0
        if index != 0 {
            v = 1
        }
        share.set_on(state, v)
        return 0
    }
    if what == SH_ON {
        if share.on(state) {
            return 1
        }
        return 0
    }
    if what == SH_IP {
        return share.my_ip(state)
    }
    if what == SH_MASK {
        return share.mask(state)
    }
    if what == SH_P0 {
        return share.pool_first(state)
    }
    if what == SH_P1 {
        return share.pool_last(state)
    }
    if what == SH_NCLIENT {
        return share.CLIENT_MAX
    }
    if what == SH_UPLINK {
        return share.uplink(state)
    }
    if what == SH_SHARED {
        return share.shared(state)
    }
    if what == SH_NAT {
        return share.nat_live(state)
    }
    if what == SH_STAT {
        return share.stat(state, index)
    }
    if index >= share.CLIENT_MAX {
        return neg(errno.E_INVAL)
    }
    if what == SH_CLIENT {
        if share.client_at(state, index, share.C_USE) != 0 {
            return 1
        }
        return 0
    }
    if what == SH_CMAC {
        return share.client_at(state, index, share.C_MAC)
    }
    if what == SH_CIP {
        return share.client_at(state, index, share.C_IP)
    }
    if what == SH_CIN {
        return share.client_at(state, index, share.C_IN)
    }
    if what == SH_COUT {
        return share.client_at(state, index, share.C_OUT)
    }
    return neg(errno.E_INVAL)
}

// ================================================== RUNDE O-EBPF
fn do_ebpf_load(state: u64, me: u64, slot: u64, uptr: u64,
    len: u64) -> u64 {
    if sched.tget(state, me, sched.T_EUID) != 0 {
        return neg(errno.E_PERM)
    }
    if slot >= ebpf.PROG_MAX {
        return neg(errno.E_INVAL)
    }
    if len == 0 || len > ebpf.MAX_INSN {
        return neg(errno.E_INVAL)
    }
    if !copy_in(state, me, ebpf.prog_at(state, slot), uptr, len * 8) {
        return neg(errno.E_FAULT)
    }
    return ebpfhook.load(state, slot, ebpfhook.K_XDP, len)
}

// `do_ebpf_attach(was, kind, slot)`:
//   was 0 = anhaengen, 1 = aushaengen, 2 = entladen
fn do_ebpf_attach(state: u64, me: u64, was: u64, kind: u64,
    slot: u64) -> u64 {
    if sched.tget(state, me, sched.T_EUID) != 0 {
        return neg(errno.E_PERM)
    }
    if was == 0 {
        if ebpfhook.attach(state, kind, slot) {
            return 0
        }
        return neg(errno.E_INVAL)
    }
    if was == 1 {
        if ebpfhook.detach(state, kind) {
            return 0
        }
        return neg(errno.E_INVAL)
    }
    if was == 2 {
        if ebpfhook.unload(state, slot) {
            return 0
        }
        return neg(errno.E_INVAL)
    }
    return neg(errno.E_INVAL)
}

fn do_ebpf_map(state: u64, me: u64, was: u64, a: u64, b: u64) -> u64 {
    if sched.tget(state, me, sched.T_EUID) != 0 {
        return neg(errno.E_PERM)
    }
    if was == 0 {
        let r: u64 = ebpfmap.create(state, a, b)
        if r >= ebpfmap.NMAPS {
            return neg(errno.E_NOSPC)
        }
        return r
    }
    if was == 1 {
        var found: u64 = 0
        return ebpfmap.lookup_value(state, a, b, &found)
    }
    if was == 2 {
        return ebpfmap.update(state, a, b,
            kstate.get(state, kstate.EBPFHOOK_OFF + 0x0E00))
    }
    if was == 3 {
        return ebpfmap.delete(state, a, b)
    }
    if was == 4 {
        return ebpfmap.entries_of(state, a)
    }
    if was == 5 {
        return ebpfmap.value_at(state, a, b)
    }
    if was == 6 {
        return ebpfmap.key_at(state, a, b)
    }
    if was == 7 {
        return ebpfmap.slot_used(state, a, b)
    }
    if was == 8 {
        return ebpfmap.kind_of(state, a)
    }
    if was == 9 {
        kstate.set(state, kstate.EBPFHOOK_OFF + 0x0E00, a)
        return 0
    }
    return neg(errno.E_INVAL)
}

fn do_ebpf_stat(state: u64, me: u64, field: u64) -> u64 {
    if field == 0 {
        if ebpfhook.on(state) {
            return 1
        }
        return 0
    }
    if field == 1 {
        return ebpfhook.seen(state)
    }
    if field == 2 {
        return ebpfhook.drops(state)
    }
    if field == 3 {
        return ebpfhook.passes(state)
    }
    if field == 4 {
        return ebpfhook.aborts(state)
    }
    if field == 5 {
        return ebpfhook.loaded(state)
    }
    if field == 6 {
        return ebpf.runs_made(state)
    }
    if field == 7 {
        return ebpf.calls_made(state)
    }
    if field == 8 {
        return ebpf.last_err(state)
    }
    if field == 9 {
        return ebpf.ticks_used(state)
    }
    if field == 10 {
        return ebpfver.why_line(state)
    }
    if field == 11 {
        return ebpfver.checked(state)
    }
    if field == 12 {
        return ebpf.PROG_MAX
    }
    if field == 13 {
        return ebpfmap.NMAPS
    }
    if field == 14 {
        return ebpf.MAX_INSN
    }
    if field == 15 {
        return ebpf.MAX_TICKS
    }
    return neg(errno.E_INVAL)
}

fn do_ebpf_prog(state: u64, me: u64, slot: u64, field: u64) -> u64 {
    if slot >= ebpf.PROG_MAX {
        return neg(errno.E_INVAL)
    }
    if field == 0 {
        return ebpfhook.attached(state, ebpfhook.K_XDP)
    }
    if field == 1 {
        return ebpfhook.attached(state, ebpfhook.K_SOCK)
    }
    return neg(errno.E_INVAL)
}

fn net_call(state: u64, me: u64, number: u64, a0: u64, a1: u64,
    a2: u64) -> u64 {
    // ======================================================= RUNDE O-EBPF
    if number == SYS_OSUM_EBPFLOAD {
        return do_ebpf_load(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_EBPFATTACH {
        return do_ebpf_attach(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_EBPFMAP {
        return do_ebpf_map(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_EBPFSTAT {
        return do_ebpf_stat(state, me, a0)
    }
    if number == SYS_OSUM_EBPFPROG {
        return do_ebpf_prog(state, me, a0, a1)
    }
    // ======================================================= ROUND NETMON
    if number == SYS_OSUM_NETMON {
        return do_netmon(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_SHARE {
        return do_share(state, me, a0, a1)
    }
    if number == SYS_OSUM_NETMONROLL {
        if sched.tget(state, me, sched.T_EUID) != 0 {
            return neg(errno.E_PERM)
        }
        if a0 >= netmon.NPROG || a1 >= netmon.T_FIELDS {
            return neg(errno.E_INVAL)
        }
        return netmon.roll(state, a0, a1)
    }
    // ================================================= RUNDE O-CONTAINER
    if number == SYS_OSUM_CTRGET {
        return do_ctrget(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_CTRSET {
        return do_ctrset(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_CTRNEW {
        return do_ctrnew(state, me, a0, a1)
    }
    if number == SYS_OSUM_CTRENTER {
        return do_ctrenter(state, me, a0)
    }
    // ====================================================== RUNDE NETVIEW
    if number == SYS_OSUM_NETVFB {
        return do_netvfb(state, me, a0)
    }
    if number == SYS_OSUM_NETVGET {
        return do_netvget(state, me, a0, a1)
    }
    if number == SYS_OSUM_NETVSET {
        return do_netvset(state, me, a0, a1)
    }
    if number == SYS_OSUM_NETVALLOW {
        return do_netvallow(state, me, a0, a1, a2)
    }
    if number == SYS_OSUM_NETGET {
        let v: u64 = netview.view_of(state, me)
        if v == netview.V_NONE {
            if a0 == NG_READY {
                return 0
            }
            if a0 == NG_STATE {
                return netview.NS_NOCARRIER
            }
            return errno.neg(errno.E_NODEV)
        }
        if v == netview.V_FAKED {
            if a0 == NG_READY {
                return 1
            }
            if a0 == NG_IP {
                return netview.FAKE_IP
            }
            if a0 == NG_MASK {
                return netview.FAKE_MASK
            }
            if a0 == NG_GW {
                return netview.FAKE_GW
            }
            if a0 == NG_MAC0 {
                return netview.FAKE_MAC0
            }
            if a0 == NG_MAC1 {
                return netview.FAKE_MAC1
            }
            if a0 == NG_IN || a0 == NG_OUT {
                return 0
            }
            if a0 == NG_STATE {
                return netview.NS_ONLINE
            }
            if a0 == NG_LINK {
                return 1
            }
            if a0 == NG_SPEED {
                return 0
            }
            if a0 == NG_CARDTX || a0 == NG_CARDRX {
                return 0
            }
            return errno.neg(errno.E_INVAL)
        }
        if a0 == NG_READY {
            if inet.ready(state) {
                return 1
            }
            return 0
        }
        if a0 == NG_STATE {
            return netview.link_state(state)
        }
        if a0 == NG_LINK {
            if inet.carrier(state) {
                return 1
            }
            return 0
        }
        if a0 == NG_HW {
            return inet.hwstat(state, a1)
        }
        if a0 == NG_SPEED {
            return inet.link_speed(state)
        }
        if !inet.ready(state) {
            return errno.neg(errno.E_NODEV)
        }
        if a0 == NG_IP {
            return inet.ip(state)
        }
        if a0 == NG_MASK {
            return inet.mask(state)
        }
        if a0 == NG_GW {
            return inet.gw(state)
        }
        if a0 == NG_MAC0 {
            return (inet.mac_at(state, 0) << 24) | (inet.mac_at(state, 1) << 16)
                | (inet.mac_at(state, 2) << 8) | inet.mac_at(state, 3)
        }
        if a0 == NG_MAC1 {
            return (inet.mac_at(state, 4) << 8) | inet.mac_at(state, 5)
        }
        if a0 == NG_IN {
            return inet.frames_in(state)
        }
        if a0 == NG_OUT {
            return inet.frames_out(state)
        }
        if a0 == NG_CARDTX {
            return inet.card_octets(state, 0)
        }
        if a0 == NG_CARDRX {
            return inet.card_octets(state, 1)
        }
        if a0 >= NG_DHCPST && a0 <= NG_DHCPTRY {
            return inet.dhcp_get(a0 - NG_DHCPST)
        }
        return errno.neg(errno.E_INVAL)
    }
    if number == SYS_OSUM_DHCPST {
        if !perm.is_root(state, me) {
            return errno.neg(errno.E_PERM)
        }
        if a0 > 6 {
            return errno.neg(errno.E_INVAL)
        }
        inet.dhcp_set(a0, a1)
        return 0
    }
    if number != SYS_OSUM_NETSET {
        return neg(errno.E_NOSYS)
    }
    if !perm.is_root(state, me) {
        return errno.neg(errno.E_PERM)
    }
    if !inet.ready(state) {
        return errno.neg(errno.E_NODEV)
    }
    if a0 == 0 {
        if a1 != 0 || (a2 & 0xFFFFFFFF) != 0 {
            return errno.neg(errno.E_INVAL)
        }
        if !inet.readdr(state, 0, 0, 0, 0, 0, 0) {
            return errno.neg(errno.E_IO)
        }
        return 0
    }
    var praefix: u64 = 0
    var bit: u64 = 32
    var seen_zero: bool = false
    while bit > 0 {
        bit = bit - 1
        if ((a1 >> bit) & 1) != 0 {
            if seen_zero {
                return errno.neg(errno.E_INVAL)
            }
            praefix = praefix + 1
        } else {
            seen_zero = true
        }
    }
    if !inet.readdr(state, (a0 >> 24) & 255, (a0 >> 16) & 255,
        (a0 >> 8) & 255, a0 & 255, praefix, a2 & 0xFFFFFFFF) {
        return errno.neg(errno.E_IO)
    }
    return 0
}

const VM_E_BAD: u64 = 100
const VM_E_TYPE: u64 = 101
const VM_E_RIGHTS: u64 = 102 // Handle ja, Art ja, Recht nein

fn vm_of(state: u64, me: u64, h: u64, need: u64) -> u64 {
    let i: u64 = cap.find(state, me, h)
    if i >= cap.MAX_CAPS {
        return VM_E_BAD
    }
    if cap.kind_at(state, me, i) != cap.K_VM {
        return VM_E_TYPE
    }
    if !cap.rights_contains(cap.rights_at(state, me, i), need) {
        return VM_E_RIGHTS
    }
    let slot: u64 = cap.object_at(state, me, i)
    if !hv.vm_valid(state, slot) {
        return VM_E_BAD
    }
    return slot
}

fn vm_error(r: u64) -> u64 {
    if r == VM_E_TYPE {
        return cap.err(cap.E_WRONGTYPE)
    }
    if r == VM_E_RIGHTS {
        return cap.err(cap.E_RIGHTS)
    }
    return cap.err(cap.E_BADHANDLE)
}

fn vm_call(state: u64, me: u64, number: u64, a0: u64, a1: u64) -> u64 {
    if number == SYS_VM_CREATE {
        return do_vm_create(state, me, a0, a1)
    }
    if number == SYS_VM_RUN {
        let s: u64 = vm_of(state, me, a0, cap.R_WRITE)
        if s >= hv.MAX_VMS {
            return vm_error(s)
        }
        return hv.vm_run(state, s)
    }
    if number == SYS_VM_STAT {
        return do_vm_stat(state, me, a0, a1)
    }
    if number == SYS_VM_KILL {
        let s: u64 = vm_of(state, me, a0, cap.R_MANAGE)
        if s >= hv.MAX_VMS {
            return vm_error(s)
        }
        hv.vm_destroy(state, s)
        cap.close(state, me, a0)
        return 0
    }
    if number == SYS_VM_VALUE {
        let s: u64 = vm_of(state, me, a0, cap.R_READ)
        if s >= hv.MAX_VMS {
            return vm_error(s)
        }
        return hv.value_of(state, a1)
    }
    return cap.err(cap.E_INVALID)
}

fn do_vm_create(state: u64, me: u64, guest: u64, want: u64) -> u64 {
    if !hv.ready(state) {
        return cap.err(cap.E_UNSUPPORTED)
    }
    if guest >= hv.G_MAX {
        return cap.err(cap.E_INVALID)
    }
    let moeglich: u64 = cap.R_READ | cap.R_WRITE | cap.R_INSPECT
        | cap.R_MANAGE | cap.R_DUPLICATE | cap.R_TRANSFER
    let slot: u64 = hv.vm_create(state, guest, me)
    if slot >= hv.MAX_VMS {
        return cap.err(cap.E_EXHAUSTED)
    }
    let h: u64 = cap.insert(state, me, cap.K_VM,
        cap.rights_restrict(moeglich, want), slot)
    if h == cap.HANDLE_NONE {
        hv.vm_destroy(state, slot)
        return cap.err(cap.E_EXHAUSTED)
    }
    return h
}

const VMSTAT_WORDS: u64 = 5

fn do_vm_stat(state: u64, me: u64, h: u64, aus: u64) -> u64 {
    let s: u64 = vm_of(state, me, h, cap.R_INSPECT)
    if s >= hv.MAX_VMS {
        return vm_error(s)
    }
    if aus == 0 {
        return 0
    }
    if !proc.user_ok(state, me, aus, VMSTAT_WORDS * 8) {
        return cap.err(cap.E_INVALID)
    }
    var w: [u64; 5] = [0 as u64; 5]
    w[0] = hv.vm_state(state, s)
    w[1] = hv.vm_exits(state, s)
    w[2] = hv.vm_result(state, s)
    w[3] = hv.vm_guest(state, s)
    w[4] = hv.exits_total(state)
    if !copy_out(state, me, aus, (&w[0]) as u64, VMSTAT_WORDS * 8) {
        return cap.err(cap.E_INVALID)
    }
    return 0
}

// ============================================================ RUNDE K13

// -------------------------------------------------------- die Auskunft

fn kill_allowed(state: u64, me: u64, pid: u64) -> bool {
    if perm.is_root(state, me) {
        return true
    }
    if pid == 0 || (pid >> 63) != 0 {
        return true // Gruppen: `signal.do_kill` filtert selbst
    }
    let t: u64 = sched.find_pid(state, pid)
    if t >= kstate.MAX_TASKS {
        return true
    }
    return perm.may_signal(state, me, t)
}

fn do_getid(state: u64, me: u64, which: u64) -> u64 {
    return sched.tget(state, me, which)
}

fn do_getres(state: u64, me: u64, a: u64, b: u64, c: u64,
    fr: u64, fe: u64, fs_: u64) -> u64 {
    if a != 0 {
        if !put32(state, me, a, sched.tget(state, me, fr)) {
            return neg(errno.E_FAULT)
        }
    }
    if b != 0 {
        if !put32(state, me, b, sched.tget(state, me, fe)) {
            return neg(errno.E_FAULT)
        }
    }
    if c != 0 {
        if !put32(state, me, c, sched.tget(state, me, fs_)) {
            return neg(errno.E_FAULT)
        }
    }
    return 0
}

fn do_umask(state: u64, me: u64, m: u64) -> u64 {
    let old: u64 = sched.tget(state, me, sched.T_UMASK) & 4095
    sched.tset(state, me, sched.T_UMASK, m & 4095)
    return old
}

// --------------------------------------------------------- der Wechsel

fn ids_ok(state: u64, me: u64, want: u64, real_f: u64, eff_f: u64,
    sav_f: u64) -> bool {
    if want == (0 -% 1) {
        return true // -1: unveraendert
    }
    if perm.is_root(state, me) {
        return true
    }
    if want == sched.tget(state, me, real_f) {
        return true
    }
    if want == sched.tget(state, me, eff_f) {
        return true
    }
    return want == sched.tget(state, me, sav_f)
}

fn ids_set(state: u64, me: u64, f: u64, v: u64) {
    if v != (0 -% 1) {
        sched.tset(state, me, f, v)
    }
}

fn do_setres(state: u64, me: u64, r: u64, e: u64, sv: u64,
    real_f: u64, eff_f: u64, sav_f: u64) -> u64 {
    if !ids_ok(state, me, r, real_f, eff_f, sav_f) {
        return neg(errno.E_PERM)
    }
    if !ids_ok(state, me, e, real_f, eff_f, sav_f) {
        return neg(errno.E_PERM)
    }
    if !ids_ok(state, me, sv, real_f, eff_f, sav_f) {
        return neg(errno.E_PERM)
    }
    ids_set(state, me, real_f, r)
    ids_set(state, me, eff_f, e)
    ids_set(state, me, sav_f, sv)
    kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
    return 0
}

fn do_setuid(state: u64, me: u64, u: u64) -> u64 {
    if perm.is_root(state, me) {
        sched.tset(state, me, sched.T_UID, u)
        sched.tset(state, me, sched.T_EUID, u)
        sched.tset(state, me, sched.T_SUID, u)
        kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
        return 0
    }
    if !ids_ok(state, me, u, sched.T_UID, sched.T_EUID, sched.T_SUID) {
        return neg(errno.E_PERM)
    }
    sched.tset(state, me, sched.T_EUID, u)
    kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
    return 0
}

fn do_setgid(state: u64, me: u64, g: u64) -> u64 {
    if perm.is_root(state, me) {
        sched.tset(state, me, sched.T_GID, g)
        sched.tset(state, me, sched.T_EGID, g)
        sched.tset(state, me, sched.T_SGID, g)
        kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
        return 0
    }
    if !ids_ok(state, me, g, sched.T_GID, sched.T_EGID, sched.T_SGID) {
        return neg(errno.E_PERM)
    }
    sched.tset(state, me, sched.T_EGID, g)
    kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
    return 0
}

fn do_setre(state: u64, me: u64, r: u64, e: u64,
    real_f: u64, eff_f: u64, sav_f: u64) -> u64 {
    if !ids_ok(state, me, r, real_f, eff_f, sav_f) {
        return neg(errno.E_PERM)
    }
    if !ids_ok(state, me, e, real_f, eff_f, sav_f) {
        return neg(errno.E_PERM)
    }
    let old_real: u64 = sched.tget(state, me, real_f)
    ids_set(state, me, real_f, r)
    ids_set(state, me, eff_f, e)
    if r != (0 -% 1) || (e != (0 -% 1) && e != old_real) {
        sched.tset(state, me, sav_f, sched.tget(state, me, eff_f))
    }
    kstate.add(state, kstate.K13_OFF + kstate.U_SETIDS, 1)
    return 0
}

// ------------------------------------------------------- die Rechte

fn owns(state: u64, me: u64, ino: u64) -> bool {
    if perm.is_root(state, me) {
        return true
    }
    return perm.euid(state, me) == fs.inode_uid(state, ino)
}

fn chmod_ino(state: u64, me: u64, ino: u64, mode: u64) -> u64 {
    if !owns(state, me, ino) {
        kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
        if !kstate.mode_on(state, kstate.M_NOPERM) {
            return neg(errno.E_PERM)
        }
    }
    if !fs.set_mode(state, ino, mode) {
        return neg(errno.E_ROFS)
    }
    kstate.add(state, kstate.K13_OFF + kstate.U_CHMODS, 1)
    return 0
}

fn chown_ino(state: u64, me: u64, ino: u64, uid: u64, gid: u64) -> u64 {
    let root: bool = perm.is_root(state, me)
    if uid != (0 -% 1) && !root {
        kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
        if !kstate.mode_on(state, kstate.M_NOPERM) {
            return neg(errno.E_PERM)
        }
    }
    if gid != (0 -% 1) && !root {
        if !owns(state, me, ino) || gid != perm.egid(state, me) {
            kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
            if !kstate.mode_on(state, kstate.M_NOPERM) {
                return neg(errno.E_PERM)
            }
        }
    }
    if !fs.set_owner(state, ino, uid, gid) {
        return neg(errno.E_ROFS)
    }
    if !root {
        let m: u64 = fs.inode_mode(state, ino)
        if (m & (fs.S_ISUID | fs.S_ISGID)) != 0 {
            fs.set_mode(state, ino, m & (~(fs.S_ISUID | fs.S_ISGID)))
        }
    }
    kstate.add(state, kstate.K13_OFF + kstate.U_CHOWNS, 1)
    return 0
}

fn ino_of_path(state: u64, me: u64, name: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    let ino: u64 = fs.path(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    return ino
}

fn do_chmod(state: u64, me: u64, name: u64, mode: u64) -> u64 {
    if !appfs.free_ok(state, me) {
        return neg(errno.E_ACCES)
    }
    let ino: u64 = ino_of_path(state, me, name)
    if errno.is_error(ino) {
        return ino
    }
    return chmod_ino(state, me, ino, mode)
}

fn do_chown(state: u64, me: u64, name: u64, uid: u64, gid: u64) -> u64 {
    if !appfs.free_ok(state, me) {
        return neg(errno.E_ACCES)
    }
    let ino: u64 = ino_of_path(state, me, name)
    if errno.is_error(ino) {
        return ino
    }
    return chown_ino(state, me, ino, uid, gid)
}

fn ino_of_fd(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    let kind: u64 = file.open_kind(state, of)
    if kind != file.K_FILE && kind != file.K_DIR {
        return neg(errno.E_INVAL)
    }
    return file.open_ino(state, of)
}

fn do_fchmod(state: u64, me: u64, fd: u64, mode: u64) -> u64 {
    let ino: u64 = ino_of_fd(state, me, fd)
    if errno.is_error(ino) {
        return ino
    }
    return chmod_ino(state, me, ino, mode)
}

fn do_fchown(state: u64, me: u64, fd: u64, uid: u64, gid: u64) -> u64 {
    let ino: u64 = ino_of_fd(state, me, fd)
    if errno.is_error(ino) {
        return ino
    }
    return chown_ino(state, me, ino, uid, gid)
}

fn do_access(state: u64, me: u64, name: u64, want: u64) -> u64 {
    let ino: u64 = ino_of_path(state, me, name)
    if errno.is_error(ino) {
        return ino
    }
    if want == 0 {
        return 0
    }
    if perm.may_real(state, me, ino, want & 7) {
        return 0
    }
    return neg(errno.E_ACCES)
}

// -------------------------------------------------- das Herunterfahren

fn do_diskup(state: u64, me: u64) -> u64 {
    // Any user: the installer of a signed-in person (uid != 0) opens the disks
    // the same way (device nodes are not checked by perm.may), and the bring-up
    // runs once per boot, so there is nothing to gain by calling it again.
    var n: u64 = 0
    if blk.ahci_up(state) {
        n = n + blk.blocks_on(state, blk.DEV_AHCI)
    }
    if blk.nvme_up(state) {
        n = n + blk.blocks_on(state, blk.DEV_NVME)
    }
    return n
}

fn do_reboot(state: u64, me: u64, cmd: u64) -> u64 {
    if !perm.is_root(state, me) {
        kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
        return neg(errno.E_PERM)
    }
    if cmd == RB_SUSPEND {
        // K-004: the machine sleeps INSIDE this call and returns from it
        // when it wakes up. 0 = it slept and came back.
        let r: u64 = s3.suspend(state)
        if r == s3.R_OK_S3 || r == s3.R_RESUME {
            return 0
        }
        if r == s3.R_SMP || r == s3.R_PARK {
            return neg(errno.E_BUSY)
        }
        if r == s3.R_NOMEM_S3 {
            return neg(errno.E_NOMEM)
        }
        return neg(errno.E_NOSYS)
    }
    var s_off: [u8; 20] = "power: init sagt ab\0"
    let _seed_saved: bool = randseed.save(state)
    perm.report(state)
    netview.report(state)
    safe.clean(state)
    wdt.mark_clean()
    serial.puts((&s_off[0]) as u64)
    serial.nl()
    if cmd == RB_POWEROFF {
        if !kstate.mode_on(state, kstate.M_NOACPI) {
            power.acpi_off(state)
        }
        power.shutdown(power.EXIT_OK)
        return 0
    }
    if cmd == RB_HALT {
        power.halt_forever()
        return 0
    }
    if cmd == RB_RESTART {
        if !kstate.mode_on(state, kstate.M_NOACPI) {
            power.acpi_reset(state)
        }
        power.shutdown(power.EXIT_OK)
        return 0
    }
    return neg(errno.E_INVAL)
}

// ------------------------------------------------------- die Auskunft

// ================================== RUNDE MULTIUSER: DIE ZUSATZGRUPPEN
fn do_getgroups(state: u64, me: u64, n: u64, out: u64) -> u64 {
    let have: u64 = sched.groups_count(state, me)
    if n == 0 {
        return have
    }
    if n < have {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, out, have * 8) {
        return neg(errno.E_FAULT)
    }
    let w: u64 = state + kstate.MU_OFF + 0x800
    var k: u64 = 0
    while k < have {
        kstate.set(state, kstate.MU_OFF + 0x800 + k * 8,
            sched.groups_at(state, me, k))
        k = k + 1
    }
    if have > 0 {
        if !copy_out(state, me, out, w, have * 8) {
            return neg(errno.E_FAULT)
        }
    }
    return have
}

fn do_setgroups(state: u64, me: u64, n: u64, src: u64) -> u64 {
    if !perm.is_root(state, me) {
        kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
        return neg(errno.E_PERM)
    }
    if n > sched.GROUPS_MAX {
        return neg(errno.E_INVAL)
    }
    if n == 0 {
        sched.groups_clear(state, me)
        kstate.add(state, kstate.MU_OFF + kstate.MU_SUPPSET, 1)
        return 0
    }
    if !proc.user_ok(state, me, src, n * 8) {
        return neg(errno.E_FAULT)
    }
    let w: u64 = state + kstate.MU_OFF + 0x800
    if !copy_in(state, me, w, src, n * 8) {
        return neg(errno.E_FAULT)
    }
    if !sched.groups_set(state, me, w, n) {
        return neg(errno.E_INVAL)
    }
    kstate.add(state, kstate.MU_OFF + kstate.MU_SUPPSET, 1)
    return 0
}

fn do_mustat(state: u64, me: u64, was: u64) -> u64 {
    if was == MS_WALKS {
        return perm.walk_stat(state, kstate.MU_WALKS)
    }
    if was == MS_WALKDENY {
        return perm.walk_stat(state, kstate.MU_WALKDENY)
    }
    if was == MS_GRPHITS {
        return perm.walk_stat(state, kstate.MU_GRPHITS)
    }
    if was == MS_SUPPSET {
        return perm.walk_stat(state, kstate.MU_SUPPSET)
    }
    if was == MS_NODECHK {
        return perm.walk_stat(state, kstate.MU_NODECHK)
    }
    return neg(errno.E_INVAL)
}

fn do_userinfo(state: u64, me: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, UI_COUNT * 8) {
        return neg(errno.E_FAULT)
    }
    let w: u64 = state + kstate.K13_OFF + 0x1000
    let b: u64 = kstate.K13_OFF
    kstate.set(state, kstate.K13_OFF + 0x1000 + 0 * 8,
        kstate.get(state, b + kstate.U_CHECKS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 1 * 8, kstate.get(state, b + kstate.U_DENIED))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 2 * 8, kstate.get(state, b + kstate.U_SETIDS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 3 * 8, kstate.get(state, b + kstate.U_CHMODS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 4 * 8, kstate.get(state, b + kstate.U_CHOWNS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 5 * 8, kstate.get(state, b + kstate.U_SUIDEXEC))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 6 * 8, fs.version(state))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 7 * 8, kstate.get(state, b + kstate.U_INITSLOT))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 8 * 8, kstate.get(state, b + kstate.U_ORPHANS))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 9 * 8, sched.zombies(state, sched.K_USER))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 10 * 8, sched.tget(state, me, sched.T_UID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 11 * 8, sched.tget(state, me, sched.T_EUID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 12 * 8, sched.tget(state, me, sched.T_GID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 13 * 8, sched.tget(state, me, sched.T_EGID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 14 * 8, sched.tget(state, me, sched.T_SUID))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 15 * 8, sched.tget(state, me, sched.T_UMASK))
    kstate.set(state, kstate.K13_OFF + 0x1000 + 16 * 8, 0)
    if kstate.mode_on(state, kstate.M_NOPERM) {
        kstate.set(state, kstate.K13_OFF + 0x1000 + 16 * 8, 1)
    }
    kstate.set(state, kstate.K13_OFF + 0x1000 + 17 * 8,
        sched.alive_count(state))
    if !copy_out(state, me, out, w, UI_COUNT * 8) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// ----------------------------------------- RUNDE K15, ZWEITER NACHTRAG
const SCAN_MAX: u64 = 63 // (BLOCK_MAX - 64) / nidx.REC

fn satzpuffer(state: u64) -> u64 {
    var k: u64 = cpu.here(state)
    if k >= kstate.MAX_CPUS {
        k = 0
    }
    return state + kstate.SCANB_OFF + k * kstate.BLOCK_MAX
}

fn do_scan(state: u64, me: u64, curp: u64, dst: u64, max: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NODEV)
    }
    var n: u64 = max
    if n == 0 {
        return 0
    }
    if n > SCAN_MAX {
        n = SCAN_MAX
    }
    if !proc.user_ok(state, me, curp, 8) {
        return neg(errno.E_FAULT)
    }
    if !proc.user_ok(state, me, dst, n * nidx.REC) {
        return neg(errno.E_FAULT)
    }
    //   panic: integer overflow casting 'u64 as u32'
    //   at kernel/user/nidx.fi:408
    let fl: u64 = fs.enter(state)
    let cur: u64 = satzpuffer(state)
    let buf: u64 = cur + 64
    if !copy_in(state, me, cur, curp, 8) {
        fs.leave(state, fl)
        return neg(errno.E_FAULT)
    }
    let got: u64 = fs.scan(state, cur, buf, n)
    if !copy_out(state, me, curp, cur, 8) {
        fs.leave(state, fl)
        return neg(errno.E_FAULT)
    }
    if got != 0 {
        if !copy_out(state, me, dst, buf, got * nidx.REC) {
            fs.leave(state, fl)
            return neg(errno.E_FAULT)
        }
    }
    fs.leave(state, fl)
    return got
}

fn do_jrnl(state: u64, me: u64, from: u64, dst: u64, max: u64) -> u64 {
    var n: u64 = max
    if n == 0 {
        return 0
    }
    if n > nidx.MAXJ {
        n = nidx.MAXJ
    }
    if !proc.user_ok(state, me, dst, n * nidx.REC) {
        return neg(errno.E_FAULT)
    }
    if n * nidx.REC > kstate.BLOCK_MAX {
        n = kstate.BLOCK_MAX / nidx.REC
    }
    let fl: u64 = fs.enter(state)
    let buf: u64 = satzpuffer(state)
    let got: u64 = nidx.take(state, from, buf, n)
    if got != 0 {
        if !copy_out(state, me, dst, buf, got * nidx.REC) {
            fs.leave(state, fl)
            return neg(errno.E_FAULT)
        }
    }
    fs.leave(state, fl)
    return got
}

// ==================================================== RUNDE SYSTEMBUS
fn do_bus(state: u64, me: u64, op: u64, a1: u64, a2: u64, a3: u64,
    a4: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_NOBUS) {
        return neg(errno.E_NODEV)
    }
    // W-APPRIGHTS AR-2: clipboard write / read and notification post need the grant for an app (label app:<name>);
    // the person's own tools and system bundles (no label) are not gated. Checked HERE, at the kernel door.
    var xsel: u64 = 0
    if op == BUS_CLIPSET {
        xsel = (a4 >> 8) & 0xFF
    }
    if op == BUS_CLIPGET || op == BUS_CLIPINFO {
        xsel = (a1 >> 8) & 0xFF
    }
    if op == BUS_OFFER {
        xsel = a2
    }
    if op == BUS_FILL {
        xsel = (a4 >> 8) & 0xFF
    }
    if (op == BUS_CLIPSET || op == BUS_OFFER) && xsel != slots.SEL_DRAG
        && !policy.label_allows(origin.at(state, me), policy.P_CLIP_WRITE) {
        return neg(errno.E_ACCES)
    }
    if op == BUS_CLIPGET && xsel != slots.SEL_DRAG
        && !policy.label_allows(origin.at(state, me), policy.P_CLIP_READ) {
        return neg(errno.E_ACCES)
    }
    if op == BUS_NOTIPOST && !policy.label_allows(origin.at(state, me), policy.P_NOTIFY) {
        return neg(errno.E_ACCES)
    }
    if op == BUS_REG || op == BUS_FIND {
        var nm: [u8; 16] = [0 as u8; 16]
        var n: u64 = a2
        if n > 16 {
            n = 16
        }
        if n > 0 {
            if !copy_in(state, me, (&nm[0]) as u64, a1, n) {
                return neg(errno.E_FAULT)
            }
        }
        let w0: u64 = bus_word((&nm[0]) as u64, 0)
        let w1: u64 = bus_word((&nm[0]) as u64, 8)
        if op == BUS_REG {
            return bus.reg(state, me, w0, w1, a3)
        }
        return bus.find(state, w0, w1)
    }
    if op == BUS_SEND || op == BUS_PUB || op == BUS_CLIPSET
        || op == BUS_FILL || op == BUS_DRAGSET || op == BUS_NOTIPOST {
        var buf: [u8; 192] = [0 as u8; 192]
        var n: u64 = 0
        var src: u64 = 0
        if op == BUS_SEND || op == BUS_PUB {
            src = a2
            n = a3
        }
        if op == BUS_CLIPSET || op == BUS_DRAGSET {
            src = a2
            n = a3
        }
        if op == BUS_FILL {
            src = a1
            n = a2
        }
        if op == BUS_NOTIPOST {
            src = a2
            n = a3
        }
        if n > 192 {
            n = 192
        }
        if n > 0 {
            if !copy_in(state, me, (&buf[0]) as u64, src, n) {
                return neg(errno.E_FAULT)
            }
        }
        let p: u64 = (&buf[0]) as u64
        if op == BUS_SEND {
            return bus.send(state, me, a1, a4, n, p)
        }
        if op == BUS_PUB {
            return bus.pub(state, me, a1, n, p)
        }
        var real: u64 = 0
        if op == BUS_CLIPSET || op == BUS_DRAGSET {
            real = a3
        }
        if op == BUS_FILL {
            real = a2
        }
        if real > 192 && (op == BUS_CLIPSET || op == BUS_DRAGSET) && (a4 & 0xFF) == 0 {
            real = 192
        }
        if op == BUS_CLIPSET {
            return slots.set(state, me, xsel, a1, real, a4 & 0xFF, p)
        }
        if op == BUS_FILL {
            return slots.fill(state, me, xsel, a4 & 0xFF, real, a3, p)
        }
        if op == BUS_DRAGSET {
            return slots.set(state, me, slots.SEL_DRAG, a1, real, a4 & 0xFF, p)
        }
        return bus.noti_post(state, me, a1, n, p)
    }
    if op == BUS_RECV || op == BUS_CLIPGET || op == BUS_DRAGGET
        || op == BUS_NOTIGET || op == BUS_NOTIPEEK {
        var buf: [u8; 192] = [0 as u8; 192]
        var meta: [u8; 48] = [0 as u8; 48]
        var max: u64 = 0
        var uout: u64 = 0
        var umeta: u64 = 0
        var got: u64 = 0
        if op == BUS_RECV {
            uout = a1
            max = a2
            umeta = a3
        }
        if op == BUS_CLIPGET {
            uout = a2
            max = a3
            umeta = a4
        }
        if op == BUS_DRAGGET {
            uout = a1
            max = a2
            umeta = a3
        }
        if op == BUS_NOTIGET {
            uout = a2
            max = a3
        }
        if op == BUS_NOTIPEEK {
            uout = a2
            max = a3
        }
        if max > 192 {
            max = 192
        }
        let bp: u64 = (&buf[0]) as u64
        let mp: u64 = (&meta[0]) as u64
        if op == BUS_RECV {
            got = bus.recv(state, me, bp, max, mp)
            // ROUND ACTION-BUS-4 (AB-002 = S-003): THE BUS CAN BLOCK.
            // a4 = how long to wait for a message, in milliseconds: 0 is
            // the old non-blocking receive (every existing caller passes
            // 0), >= 0x80000000 waits until something arrives. The wait
            // is `poll`'s: remember the wake sequence BEFORE looking,
            // sleep in S_POLL only if it has not moved, and a delivery
            // into this task's box (`bus.queue_put`) kicks exactly this
            // task. No instruction of the waiting program runs until a
            // message, a signal or the deadline -- a broker, settingsd or
            // any provider idles at zero instead of a tick-sleep loop.
            if a4 != 0 && got == (0 -% bus.E_EMPTY) {
                let forever: bool = a4 >= 0x80000000
                var ticks: u64 = 0
                if !forever {
                    ticks = (a4 + 9) / 10 + 1 // never earlier than asked
                }
                let deadline: u64 = kstate.get(state, kstate.TICKS) + ticks
                var waiting: bool = true
                while waiting {
                    let seen: u64 = sched.poll_seq(state)
                    got = bus.recv(state, me, bp, max, mp)
                    if got != (0 -% bus.E_EMPTY) {
                        waiting = false
                    } else if signal.interrupted(state, me) {
                        return neg(errno.E_INTR)
                    } else if !forever && kstate.get(state, kstate.TICKS) >= deadline {
                        waiting = false
                    } else {
                        var wake: u64 = deadline
                        if forever {
                            wake = sched.POLL_FOREVER
                        }
                        sched.poll_sleep(state, seen, wake)
                    }
                }
            }
        }
        if op == BUS_CLIPGET {
            got = slots.get(state, xsel, a1 & 0xFF, (a1 >> 16) & 0xFF, bp, max, mp)
        }
        if op == BUS_DRAGGET {
            got = slots.drag_get(state, bp, max, mp)
        }
        if op == BUS_NOTIGET {
            got = bus.noti_get(state, a1, bp, max)
        }
        if op == BUS_NOTIPEEK {
            got = bus.noti_peek(state, a1, bp, max)
        }
        if got > 0x8000000000000000 {
            return got as i64 as u64
        }
        if got > 0 {
            if !copy_out(state, me, uout, bp, got) {
                return neg(errno.E_FAULT)
            }
        }
        if umeta != 0 {
            if !copy_out(state, me, umeta, mp, 48) {
                return neg(errno.E_FAULT)
            }
        }
        return got
    }
    // ---- die Segmente.
    if op == BUS_SEGNEW {
        return bus.seg_new(state, me, a1)
    }
    if op == BUS_SEGMAP {
        return bus_segmap(state, me, a1)
    }
    if op == BUS_SEGDROP {
        return bus.seg_drop(state, me, a1)
    }
    if op == BUS_SUB {
        return bus.sub(state, me, a1)
    }
    if op == BUS_OFFER {
        return slots.offer(state, me, xsel, a1)
    }
    if op == BUS_DRAGCLEAR {
        if a1 != 0 {
            return slots.clear(state, a1 - 1)
        }
        return slots.drag_clear(state)
    }
    if op == BUS_CLIPINFO {
        let ib: u64 = a1 & 0xFF
        if a2 == 0 {
            return slots.types_of(state, xsel, ib)
        }
        if a2 == 1 {
            return slots.length_of(state, xsel, ib)
        }
        if a2 == 2 {
            return slots.owner_of(state, xsel, ib)
        }
        if a2 == 3 {
            return slots.count(state, xsel)
        }
        if a2 == 5 {
            return slots.have_of(state, xsel, ib)
        }
        if a2 == 6 {
            return slots.seq_of(state, xsel, ib)
        }
        if a2 == 7 {
            return slots.wanted_for(state, me, false)
        }
        if a2 == 8 {
            return slots.wanted_for(state, me, true)
        }
        return slots.flags_of(state, xsel, ib)
    }
    if op == BUS_DRAGINFO {
        if a1 == 0 {
            return slots.drag_active(state)
        }
        return slots.drag_types(state)
    }
    if op == BUS_PROMOTE {
        return slots.promote(state, a1)
    }
    if op == BUS_MIME || op == BUS_MIMENAME {
        var mn: [u8; 32] = [0 as u8; 32]
        let mp: u64 = (&mn[0]) as u64
        if op == BUS_MIME {
            if a2 == 0 || a2 > 31 {
                return neg(errno.E_INVAL)
            }
            if !copy_in(state, me, mp, a1, a2) {
                return neg(errno.E_FAULT)
            }
            return slots.mime_id(state, mp, a2)
        }
        var want: u64 = a3
        if want > 31 {
            want = 31
        }
        let got: u64 = slots.mime_name(state, a1, mp, want)
        if got > 0x8000000000000000 {
            return got as i64 as u64
        }
        var shown: u64 = got
        if shown > want {
            shown = want
        }
        if shown > 0 && !copy_out(state, me, a2, mp, shown) {
            return neg(errno.E_FAULT)
        }
        return got
    }
    if op == BUS_SEGIO {
        let sid: u64 = a1 & 0xFF
        let wr: bool = ((a1 >> 8) & 1) == 1
        if !wr && bus.seg_owner(state, sid) == bus.ADOPT_PID
            && !policy.label_allows(origin.at(state, me), policy.P_CLIP_READ) {
            return neg(errno.E_ACCES)
        }
        var done: u64 = 0
        while done < a4 {
            var chunk: u64 = a4 - done
            if chunk > 4096 {
                chunk = 4096
            }
            let span: u64 = bus.seg_span(state, me, sid, wr, a2 + done, chunk)
            if span == 0 {
                return neg(errno.E_INVAL)
            }
            if wr {
                if !copy_in(state, me, span, a3 + done, chunk) {
                    return neg(errno.E_FAULT)
                }
            } else {
                if !copy_out(state, me, a3 + done, span, chunk) {
                    return neg(errno.E_FAULT)
                }
            }
            done = done + chunk
        }
        return done
    }
    if op == BUS_NOTIINFO {
        if a1 == 0 {
            return bus.noti_count(state)
        }
        if a1 == 1 {
            return bus.noti_seen(state)
        }
        if a1 == 2 {
            return bus.noti_len(state, a2)
        }
        if a1 == 3 {
            return bus.noti_prio(state, a2)
        }
        if a1 == 5 {
            return bus.noti_total(state)
        }
        return bus.noti_prio(state, a2)
    }
    if op == BUS_STAT {
        return bus.stat(state, a1)
    }
    return neg(errno.E_INVAL)
}

// ==================================================== RUNDE HDA: DER TON

fn do_audget(state: u64, field: u64) -> u64 {
    let f: u64 = audio.hold(state)
    let r: u64 = audget_locked(state, field)
    audio.drop(state, f)
    return r
}

fn do_audset(state: u64, field: u64, value: u64) -> u64 {
    if field == AS_WAITSPACE {
        return do_audwait(state, value)
    }
    let f: u64 = audio.hold(state)
    let r: u64 = audset_locked(state, field, value)
    audio.drop(state, f)
    return r
}

fn do_audwait(state: u64, value: u64) -> u64 {
    let kenn: u64 = value >> 8
    let will: u64 = (value & 0xFF) * 16
    var runden: u64 = 0
    while runden < 200 {
        let f: u64 = audio.hold(state)
        audio.mix_pump(state)
        var cur_space: u64 = 0
        if kenn == 0 {
            cur_space = audio.space_frames(state)
        } else {
            let id: u64 = kenn -% 1
            if id >= mix.MAX_STREAMS || !mix.is_open(state, id) {
                audio.drop(state, f)
                return neg(errno.E_BADF)
            }
            cur_space = mix.space(state, id)
        }
        let hz: u64 = audio.rate(state)
        var us: u64 = 0
        if cur_space < will && hz > 0 {
            us = (will -% cur_space) * 1000000 / hz
        }
        audio.drop(state, f)
        if cur_space >= will || will == 0 {
            return cur_space
        }
        var ticks: u64 = us / 10000
        if ticks == 0 && us > 0 {
            ticks = 1
        }
        if ticks == 0 {
            sched.yield_now(state)
        } else {
            var t: u64 = ticks
            let deckel: u64 = audio.latency_us(state) / 20000
            if deckel > 0 && t > deckel {
                t = deckel
            }
            sched.sleep_ticks(state, t)
        }
        runden = runden + 1
    }
    return 0
}

fn do_audwrite(state: u64, me: u64, src: u64, frames: u64) -> u64 {
    // W-APPRIGHTS AR-2: playing sound needs the `audio.play` grant for an app; the person's own tools are not gated
    if !policy.label_allows(origin.at(state, me), policy.P_AUDIO_PLAY) {
        return neg(errno.E_ACCES)
    }
    let f: u64 = audio.hold(state)
    let t: u64 = audio.mark_write(state)
    let r: u64 = audwrite_locked(state, me, src, frames)
    audio.mark_done(state, t)
    audio.drop(state, f)
    return r
}

fn do_audopen(state: u64, me: u64, hz: u64) -> u64 {
    let f: u64 = audio.hold(state)
    let r: u64 = audopen_locked(state, me, hz)
    audio.drop(state, f)
    return r
}

fn do_audsend(state: u64, me: u64, id: u64, src: u64, frames: u64) -> u64 {
    let f: u64 = audio.hold(state)
    let t: u64 = audio.mark_write(state)
    let r: u64 = audsend_locked(state, me, id, src, frames)
    audio.mark_done(state, t)
    audio.drop(state, f)
    return r
}

// W-TRAY6: the microphone. dst, frames -> frames copied (0 = nothing new yet, non-blocking); -ENODEV = no
// microphone path. 48 kHz, 16 bit, 2 channels, 4 octets per frame. Policy in kernel/drv/snd/cap.fi.
fn do_audread(state: u64, me: u64, dst: u64, frames: u64) -> u64 {
    if frames == 0 {
        return 0
    }
    // W-APPRIGHTS: an app (sticky label "app:<name>") needs the `mic` grant; the person's own tools are not gated
    if !policy.label_allows(origin.at(state, me), policy.P_MIC) {
        return neg(errno.E_ACCES)
    }
    let f: u64 = audio.hold(state)
    let r: u64 = audread_locked(state, me, dst, frames)
    audio.drop(state, f)
    return r
}

fn audread_locked(state: u64, me: u64, dst: u64, frames: u64) -> u64 {
    let bounce: u64 = state + kstate.AUDB_OFF
    var n: u64 = frames
    let maxn: u64 = kstate.AUDB_MAX / 4
    if n > maxn {
        n = maxn
    }
    let got: u64 = mic.read(state, me, bounce, n)
    if got == mic.NODEV {
        return neg(errno.E_NODEV)
    }
    if got == 0 {
        return 0
    }
    if !copy_out(state, me, dst, bounce, got * 4) {
        return neg(errno.E_FAULT)
    }
    return got
}

fn audget_locked(state: u64, field: u64) -> u64 {
    if field == audio.A_CAPREADY {
        if mic.ready_for(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_CAPUSERS {
        return mic.users(state)
    }
    if field == audio.A_CAPMUTE {
        if mic.muted(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_CAPKIND {
        return hda.cap_kind(state)
    }
    if field == audio.A_CAPFRAMES {
        hda.cap_poll(state)
        return hda.cap_frames(state)
    }
    if field >= audio.A_CAPWHO0 && field < audio.A_CAPWHO0 + mic.SLOTS {
        return mic.who_live(state, field - audio.A_CAPWHO0)
    }
    if field == audio.A_CAPOVER {
        return hda.cap_overruns(state)
    }
    if field == audio.A_READY {
        if audio.ready(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_RATE {
        return audio.rate(state)
    }
    if field == audio.A_CHANNELS {
        return audio.channels(state)
    }
    if field == audio.A_BITS {
        return audio.bits(state)
    }
    if field == audio.A_VOLUME {
        return audio.volume(state)
    }
    if field == audio.A_PLAYED {
        audio.mix_pump(state)
        return audio.samples_played(state)
    }
    if field == audio.A_WRITTEN {
        return audio.frames_written(state)
    }
    if field == audio.A_UNDERRUNS {
        return audio.underruns(state)
    }
    if field == audio.A_LATENCY {
        return audio.latency_us(state)
    }
    if field == audio.A_ENTRYUS {
        return audio.entry_us(state)
    }
    if field == audio.A_RINGFRAMES {
        return audio.ring_frames(state)
    }
    if field == audio.A_RUNNING {
        if audio.backend(state) == audio.B_HDA {
            if hda.running(state) {
                return 1
            }
            return 0
        }
        if ac97.running(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_OPEN {
        if audio.is_open(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_BACKEND {
        return audio.backend(state)
    }
    if field == audio.A_WHY {
        return audio.why(state)
    }
    if field == audio.A_SOUNDS {
        if audio.sounds_on(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_BEEPS {
        return audio.beeps(state)
    }
    if field == audio.A_MUTED {
        if audio.muted(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_REMAIN {
        return audio.remaining(state)
    }
    if field == audio.A_WRITES {
        return audio.writes(state)
    }
    if field == audio.A_BACKSTEPS {
        return audio.backsteps(state)
    }
    if field == audio.A_LOST {
        return audio.lost(state)
    }
    if field == audio.A_ZEROED {
        return audio.zeroed(state)
    }
    // ---- RUNDE TON ----
    if field == audio.A_VOLGEN {
        return audio.volgen(state)
    }
    if field == audio.A_CLICKS {
        if audio.clicks_on(state) {
            return 1
        }
        return 0
    }
    if field == audio.A_TICKSKIP {
        return audio.tick_skips(state)
    }
    if field == audio.A_LOCKSPIN {
        return audio.lock_spins(state)
    }
    if field == audio.A_MINFILL {
        return audio.min_fill(state)
    }
    if field == audio.A_SYSSOUNDS {
        return audio.sys_sounds(state)
    }
    if field == audio.A_GAPMAX {
        return audio.gap_max(state)
    }
    if field == audio.A_SYSUS {
        return audio.sys_us(state)
    }
    if field == audio.A_WALLUS {
        return audio.wall_us(state)
    }
    if field == audio.A_CALLS {
        return audio.calls(state)
    }
    if field == audio.A_STREAMS {
        return mix.streams(state)
    }
    if field == audio.A_MIXED {
        return mix.mixed(state)
    }
    if field == audio.A_CLIPS {
        return mix.clips(state)
    }
    if field == audio.A_MIXUNDER {
        return mix.underruns(state, mix.MAX_STREAMS)
    }
    if field == audio.A_DISAGREE {
        if audio.backend(state) == audio.B_HDA {
            return hda.pos_disagree(state)
        }
        return 0
    }
    if field == audio.A_CMDPATH {
        if audio.backend(state) == audio.B_HDA {
            return hda.cmd_path(state)
        }
        return 0
    }
    if field == audio.A_DAC {
        if audio.backend(state) == audio.B_HDA {
            return hda.dac_nid(state)
        }
        return 0
    }
    if field == audio.A_PIN {
        if audio.backend(state) == audio.B_HDA {
            return hda.pin_nid(state)
        }
        return 0
    }
    if field == audio.A_PATHLEN {
        if audio.backend(state) == audio.B_HDA {
            return hda.path_len(state)
        }
        return 0
    }
    if field == audio.A_WIDGETS {
        if audio.backend(state) == audio.B_HDA {
            return hda.widgets(state)
        }
        return 0
    }
    if field == audio.A_CODECADDR {
        if audio.backend(state) == audio.B_HDA {
            return hda.codec_addr(state)
        }
        return 0
    }
    return neg(errno.E_INVAL)
}

fn bus_word(p: u64, off: u64) -> u64 {
    var w: u64 = 0
    var k: u64 = 0
    while k < 8 {
        w = w | (kstate.get8(p + off + k) << (k * 8))
        k = k + 1
    }
    return w
}

fn bus_segmap(state: u64, me: u64, id: u64) -> u64 {
    if bus.seg_map(state, me, id) != bus.E_OK {
        return neg(errno.E_INVAL)
    }
    let pages: u64 = bus.seg_pages(state, id)
    if pages == 0 {
        return neg(errno.E_INVAL)
    }
    let top: u64 = big_bottom(state, me)
    if pages * PAGE > top - proc.BIG_FLOOR {
        return neg(errno.E_NOMEM)
    }
    let base: u64 = top - pages * PAGE
    if base < proc.BIG_FLOOR {
        return neg(errno.E_NOMEM)
    }
    var k: u64 = 0
    while k < pages {
        let f: u64 = bus.seg_frame(state, id, k)
        if f == 0 {
            return neg(errno.E_INVAL)
        }
        if !proc.map_frame(state, me, base + k * PAGE, f, true) {
            return neg(errno.E_NOMEM)
        }
        kstate.add(state, kstate.MAPS, 1)
        k = k + 1
    }
    sched.tset(state, mem_owner(state, me), sched.T_BIG, base)
    return base
}

fn audset_locked(state: u64, field: u64, value: u64) -> u64 {
    if field == AS_VOLUME {
        if value > 100 {
            return neg(errno.E_INVAL)
        }
        audio.set_volume(state, value)
        return 0
    }
    if field == AS_MUTE {
        audio.set_muted(state, value != 0)
        return 0
    }
    if field == AS_CAPMUTE {
        mic.set_muted(state, value != 0)
        return 0
    }
    if field == AS_SOUNDS {
        audio.set_sounds(state, value != 0)
        return 0
    }
    if !audio.ready(state) {
        return neg(errno.E_NODEV)
    }
    if field == AS_OPEN {
        if value != 0 {
            if audio.open(state) {
                return 0
            }
            return neg(errno.E_BUSY)
        }
        audio.close(state)
        return 0
    }
    if field == AS_DRAIN {
        audio.pad_and_submit(state)
        return 0
    }
    if field == AS_STOP {
        audio.stop(state)
        return 0
    }
    if field == AS_RATE {
        if audio.set_rate(state, value) {
            return 0
        }
        return neg(errno.E_INVAL)
    }
    if field == AS_CLOSE {
        audio.close_stream(state, value)
        return 0
    }
    if field == AS_END {
        audio.end_stream(state, value)
        return 0
    }
    if field == AS_SVOL {
        mix.set_volume(state, value >> 8, value & 0xFF)
        return 0
    }
    if field == AS_PUMP {
        audio.mix_pump(state)
        audio.zero_rest(state)
        return 0
    }
    if field == AS_SOUND {
        if value > audio.SND_ERROR {
            return neg(errno.E_INVAL)
        }
        if audio.sys_sound(state, value) {
            return 1
        }
        return 0
    }
    if field == AS_CLICKS {
        audio.set_clicks(state, value != 0)
        return 0
    }
    if field == AS_SMUTE {
        mix.set_muted_pub(state, value >> 8, (value & 0xFF) != 0)
        return 0
    }
    if field == AS_BEEP {
        var hz: u64 = value
        if hz == 0 {
            audio.error_beep(state)
            return 0
        }
        if hz < 20 || hz > 20000 {
            return neg(errno.E_INVAL)
        }
        audio.beep(state, hz, 90)
        return 0
    }
    return neg(errno.E_INVAL)
}

fn audwrite_locked(state: u64, me: u64, src: u64, frames: u64) -> u64 {
    if !audio.ready(state) {
        return neg(errno.E_NODEV)
    }
    if !audio.is_open(state) {
        return neg(errno.E_BADF)
    }
    if frames == 0 {
        return 0
    }
    let fo: u64 = audio.frame_octets(state)
    let cap: u64 = kstate.AUDB_MAX / fo
    var n: u64 = frames
    if n > cap {
        n = cap
    }
    let room: u64 = audio.space_frames(state)
    if room == 0 {
        return 0
    }
    if n > room {
        n = room
    }
    let bounce: u64 = state + kstate.AUDB_OFF
    if !copy_in(state, me, bounce, src, n * fo) {
        return neg(errno.E_FAULT)
    }
    return audio.write(state, bounce, n)
}

fn audopen_locked(state: u64, me: u64, hz: u64) -> u64 {
    if !audio.ready(state) {
        return neg(errno.E_NODEV)
    }
    let id: u64 = audio.open_stream(state, me, hz)
    if id >= mix.MAX_STREAMS {
        return neg(errno.E_BUSY)
    }
    return id
}

fn audsend_locked(state: u64, me: u64, id: u64, src: u64, frames: u64) -> u64 {
    if !audio.ready(state) {
        return neg(errno.E_NODEV)
    }
    if id >= mix.MAX_STREAMS {
        return neg(errno.E_INVAL)
    }
    if !mix.is_open(state, id) {
        return neg(errno.E_BADF)
    }
    if frames == 0 {
        return 0
    }
    let fo: u64 = audio.frame_octets(state)
    let cap: u64 = kstate.AUDB_MAX / fo
    var n: u64 = frames
    if n > cap {
        n = cap
    }
    let room: u64 = mix.space(state, id)
    if room == 0 {
        audio.mix_pump(state)
        return 0
    }
    if n > room {
        n = room
    }
    let bounce: u64 = state + kstate.AUDB_OFF
    if !copy_in(state, me, bounce, src, n * fo) {
        return neg(errno.E_FAULT)
    }
    return audio.write_stream(state, id, bounce, n)
}

// ======================================================= RUNDE WAYLAND

const AF_UNIX: u64 = 1

const SYS_FTRUNCATE: u64 = 77
const SYS_FALLOCATE: u64 = 285
const SYS_MEMFD_CREATE: u64 = 319
const MFD_CLOEXEC: u64 = 1
const MFD_ALLOW_SEALING: u64 = 2
// COMPOSITOR S3: an OrientOS flag. The object is ONE run of frames, so the window server can compose from what the client paints into it
const MFD_FRAMES: u64 = 0x40000000
const F_ADD_SEALS: u64 = 1033
const F_GET_SEALS: u64 = 1034
const F_SEAL_SEAL: u64 = 1
const F_SEAL_SHRINK: u64 = 2
const F_SEAL_GROW: u64 = 4
const F_SEAL_WRITE: u64 = 8

const SYS_SENDMSG: u64 = 46
const SYS_RECVMSG: u64 = 47
const SOL_SOCKET: u64 = 1
const SCM_RIGHTS: u64 = 1
const MSG_DONTWAIT: u64 = 64
const MSG_NOSIGNAL: u64 = 16384
const MSG_CMSG_CLOEXEC: u64 = 1073741824

const MAP_SHARED: u64 = 1

const MSG_MAX: u64 = 2048

const WL_SCRATCH: u64 = 0xFE000
const WL_PATH: u64 = 0xFF000

// r721: the bounce buffer WL_SCRATCH is ONE page for the whole machine; two cores in sendmsg/recvmsg/read/write on sockets used it at the
// same time and mixed their octets. The pair (copy in + send) / (receive + copy out) now runs under `unixsock.scratch_lock`.
// A failed copy comes back as -EFAULT (the marker value); everything else is what `send_bytes` / `recv_bytes` said.
fn wl_send(state: u64, me: u64, si: u64, src: u64, n: u64, dg: bool) -> u64 {
    let fl: u64 = unixsock.scratch_lock(state)
    var r: u64 = neg(errno.E_FAULT)
    if copy_in(state, me, state + WL_SCRATCH, src, n) {
        if dg {
            r = unixsock.send_dgram(state, si, WL_SCRATCH, n)
        } else {
            r = unixsock.send_bytes(state, si, WL_SCRATCH, n)
        }
    }
    unixsock.scratch_unlock(state, fl)
    return r
}

fn wl_recv(state: u64, me: u64, si: u64, dst: u64, n: u64, dg: bool) -> u64 {
    let fl: u64 = unixsock.scratch_lock(state)
    var r: u64 = 0
    if dg {
        r = unixsock.recv_dgram(state, si, WL_SCRATCH, n)
    } else {
        r = unixsock.recv_bytes(state, si, WL_SCRATCH, n)
    }
    if !errno.is_error(r) && r != 0 && !copy_out(state, me, dst, state + WL_SCRATCH, r) {
        r = neg(errno.E_FAULT)
    }
    unixsock.scratch_unlock(state, fl)
    return r
}

fn get64u(state: u64, me: u64, addr: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 8 {
        v = v | (peek(state, me, addr + i) << (i * 8))
        i = i + 1
    }
    return v
}

// ---------------------------------------------------------- die Weichen

fn usock_of(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return unixsock.USOCK_MAX
    }
    if file.open_kind(state, of) != file.K_USOCK {
        return unixsock.USOCK_MAX
    }
    return file.open_ino(state, of)
}

fn shm_of(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return unixsock.USHM_MAX
    }
    if file.open_kind(state, of) != file.K_SHM {
        return unixsock.USHM_MAX
    }
    return file.open_ino(state, of)
}

//   struct sockaddr_un { u16 family; char sun_path[108]; }
fn sa_un(state: u64, me: u64, addr: u64, len: u64, lenp: *mut u64) -> u64 {
    *lenp = 0
    if addr == 0 || len < 3 || len > 2 + unixsock.USUN_MAX {
        return neg(errno.E_INVAL)
    }
    if !copy_in(state, me, state + WL_PATH, addr, len) {
        return neg(errno.E_FAULT)
    }
    let family: u64 = kstate.get8(state + WL_PATH)
        | (kstate.get8(state + WL_PATH + 1) << 8)
    if family != AF_UNIX {
        return neg(errno.E_AFNOSUPPORT)
    }
    if kstate.get8(state + WL_PATH + 2) == 0 {
        *lenp = len - 2
        return 0
    }
    let raum: u64 = len - 2
    var n: u64 = 0
    while n < raum && n < unixsock.USUN_MAX
        && kstate.get8(state + WL_PATH + 2 + n) != 0 {
        n = n + 1
    }
    if n == 0 {
        return neg(errno.E_INVAL)
    }
    *lenp = n
    return 0
}

// ------------------------------------------------------------- socket()

fn do_usocket(state: u64, me: u64, kind: u64, protocol: u64) -> u64 {
    let base: u64 = kind & 0xFF
    // r731: SOCK_DGRAM on AF_UNIX (bind/sendto/connect by path); everything else is refused honestly
    if base != SOCK_STREAM && base != SOCK_DGRAM {
        return neg(errno.E_PROTONOSUPPORT)
    }
    if protocol != 0 {
        return neg(errno.E_PROTONOSUPPORT)
    }
    var ukind: u64 = unixsock.UK_STREAM
    if base == SOCK_DGRAM {
        ukind = unixsock.UK_DGRAM
    }
    let si: u64 = unixsock.sock_new(state, ukind)
    if si >= unixsock.USOCK_MAX {
        return neg(errno.E_NFILE)
    }
    let of: u64 = file.open_alloc(state, file.K_USOCK, si, O_RDWR)
    if of >= file.MAX_OPEN {
        unixsock.sock_free(state, si)
        return neg(errno.E_NFILE)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        unixsock.sock_free(state, si)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    return fd
}

// --------------------------------------------------- bind/listen/connect

fn do_ubind(state: u64, me: u64, fd: u64, addr: u64, len: u64) -> u64 {
    let si: u64 = usock_of(state, me, fd)
    if si >= unixsock.USOCK_MAX {
        return neg(errno.E_BADF)
    }
    var plen: u64 = 0
    let pfl: u64 = unixsock.scratch_lock(state)
    let r: u64 = sa_un(state, me, addr, len, &plen)
    if errno.is_error(r) {
        unixsock.scratch_unlock(state, pfl)
        return r
    }
    var b: u64 = 0
    if unixsock.sock_kind(state, si) == unixsock.UK_DGRAM {
        b = unixsock.bind_dgram(state, si, WL_PATH + 2, plen)
    } else {
        b = unixsock.bind_path(state, si, WL_PATH + 2, plen)
    }
    unixsock.scratch_unlock(state, pfl)
    if b != 0 {
        return neg(b)
    }
    return 0
}

fn do_ulisten(state: u64, me: u64, fd: u64) -> u64 {
    let si: u64 = usock_of(state, me, fd)
    if si >= unixsock.USOCK_MAX {
        return neg(errno.E_BADF)
    }
    let r: u64 = unixsock.listen_on(state, si)
    if r != 0 {
        return neg(r)
    }
    return 0
}

fn do_uconnect(state: u64, me: u64, fd: u64, addr: u64, len: u64) -> u64 {
    let si: u64 = usock_of(state, me, fd)
    if si >= unixsock.USOCK_MAX {
        return neg(errno.E_BADF)
    }
    var plen: u64 = 0
    let pfl: u64 = unixsock.scratch_lock(state)
    let r: u64 = sa_un(state, me, addr, len, &plen)
    if errno.is_error(r) {
        unixsock.scratch_unlock(state, pfl)
        return r
    }
    if unixsock.sock_kind(state, si) == unixsock.UK_DGRAM {
        // r731: a datagram connect() just picks the default destination
        let dst: u64 = unixsock.find_dgram(state, WL_PATH + 2, plen)
        if dst >= unixsock.USOCK_MAX {
            unixsock.scratch_unlock(state, pfl)
            return neg(errno.E_CONNREFUSED)
        }
        unixsock.connect_dgram(state, si, dst)
        unixsock.scratch_unlock(state, pfl)
        return 0
    }
    let lst: u64 = unixsock.find_listener(state, WL_PATH + 2, plen)
    unixsock.scratch_unlock(state, pfl)
    if lst >= unixsock.USOCK_MAX {
        return neg(errno.E_CONNREFUSED)
    }
    let c: u64 = unixsock.connect_to(state, si, lst)
    if c != 0 {
        return neg(c)
    }
    sched.poll_kick(state)
    var waited: u64 = 0
    while waited < NET_ROUNDS {
        if unixsock.sock_state(state, si) == unixsock.S_CONNECTED {
            return 0
        }
        waited = waited + 1
        sched.sleep_ticks(state, 1)
    }
    return neg(errno.E_AGAIN)
}

fn do_uaccept(state: u64, me: u64, fd: u64, flags: u64) -> u64 {
    let si: u64 = usock_of(state, me, fd)
    if si >= unixsock.USOCK_MAX {
        return neg(errno.E_BADF)
    }
    let nb: bool = (flags & SOCK_NONBLOCK) != 0
    var waited: u64 = 0
    var got: u64 = unixsock.USOCK_MAX
    while got >= unixsock.USOCK_MAX {
        got = unixsock.accept_from(state, si)
        if got >= unixsock.USOCK_MAX {
            if nb {
                return neg(errno.E_AGAIN)
            }
            if waited >= NET_ROUNDS {
                return neg(errno.E_AGAIN)
            }
            waited = waited + 1
            sched.sleep_ticks(state, 1)
        }
    }
    let of: u64 = file.open_alloc(state, file.K_USOCK, got, O_RDWR)
    if of >= file.MAX_OPEN {
        unixsock.sock_free(state, got)
        return neg(errno.E_NFILE)
    }
    let nfd: u64 = file.fd_alloc(state, me, 0)
    if nfd >= file.MAX_FD {
        file.open_unref(state, of)
        unixsock.sock_free(state, got)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, nfd, of)
    return nfd
}

// --------------------------------------------------- sendmsg / recvmsg
//   struct msghdr {
//     void *msg_name; socklen_t msg_namelen;      +0  +8
//     struct iovec *msg_iov; size_t msg_iovlen;   +16 +24
//     void *msg_control; size_t msg_controllen;   +32 +40
//     int msg_flags;                              +48
//   }
//   struct iovec { void *iov_base; size_t iov_len; }
//   struct cmsghdr { size_t cmsg_len; int cmsg_level; int cmsg_type; }

const MH_IOV: u64 = 16
const MH_IOVLEN: u64 = 24
const MH_CONTROL: u64 = 32
const MH_CONTROLLEN: u64 = 40
const MH_FLAGS: u64 = 48
const MH_BYTES: u64 = 56

fn do_sendmsg(state: u64, me: u64, fd: u64, mh: u64, flags: u64) -> u64 {
    let nlof: u64 = nl_of(state, me, fd)
    if nlof < file.MAX_OPEN {
        return nl_sendmsg(state, me, nlof, mh)
    }
    let si: u64 = usock_of(state, me, fd)
    if si >= unixsock.USOCK_MAX {
        return neg(errno.E_BADF)
    }
    if !proc.user_ok(state, me, mh, MH_BYTES) {
        return neg(errno.E_FAULT)
    }
    if unixsock.peer_gone(state, si) {
        return neg(errno.E_PIPE)
    }
    if unixsock.sock_kind(state, si) == unixsock.UK_DGRAM {
        return sendmsg_frame(state, me, fd, si, mh, flags)
    }
    let iov: u64 = get64u(state, me, mh + MH_IOV)
    let iovlen: u64 = get64u(state, me, mh + MH_IOVLEN)
    let ctl: u64 = get64u(state, me, mh + MH_CONTROL)
    let ctllen: u64 = get64u(state, me, mh + MH_CONTROLLEN)
    var passed: u64 = 0
    if ctl != 0 && ctllen >= 16 {
        if !proc.user_ok(state, me, ctl, ctllen) {
            return neg(errno.E_FAULT)
        }
        let clen: u64 = get64u(state, me, ctl)
        let level: u64 = get32(state, me, ctl + 8)
        let ctype: u64 = get32(state, me, ctl + 12)
        if level == SOL_SOCKET && ctype == SCM_RIGHTS && clen >= 16
            && clen <= ctllen {
            let nfds: u64 = (clen - 16) / 4
            if nfds > unixsock.FDQ_MAX {
                return neg(errno.E_INVAL)
            }
            // All-or-nothing: validate every descriptor and wait for queue room BEFORE pushing the first
            // (a half-pushed message retried by the caller would duplicate descriptors).
            var chk: u64 = 0
            while chk < nfds {
                if of_of(state, me, get32(state, me, ctl + 16 + chk * 4)) >= file.MAX_OPEN {
                    return neg(errno.E_BADF)
                }
                chk = chk + 1
            }
            var qwait: u64 = 0
            while unixsock.fd_room(state, si) < nfds {
                if unixsock.peer_gone(state, si) {
                    return neg(errno.E_PIPE)
                }
                if (flags & MSG_DONTWAIT) != 0 || qwait >= NET_ROUNDS {
                    return neg(errno.E_AGAIN)
                }
                qwait = qwait + 1
                sched.sleep_ticks(state, 1)
            }
            var k: u64 = 0
            while k < nfds {
                let sfd: u64 = get32(state, me, ctl + 16 + k * 4)
                let sof: u64 = of_of(state, me, sfd)
                let pr: u64 = unixsock.push_fd(state, si, sof)
                if pr != 0 {
                    return neg(pr)
                }
                passed = passed + 1
                k = k + 1
            }
        }
    }
    var sent: u64 = 0
    var v: u64 = 0
    while v < iovlen {
        if !proc.user_ok(state, me, iov + v * 16, 16) {
            return neg(errno.E_FAULT)
        }
        let base: u64 = get64u(state, me, iov + v * 16)
        let blen: u64 = get64u(state, me, iov + v * 16 + 8)
        var off: u64 = 0
        while off < blen {
            var chunk: u64 = blen - off
            if chunk > MSG_MAX {
                chunk = MSG_MAX
            }
            let free: u64 = unixsock.room(state,
                unixsock.sock_peer(state, si))
            if free == 0 {
                if (flags & MSG_DONTWAIT) != 0 {
                    if sent != 0 {
                        return sent
                    }
                    return neg(errno.E_AGAIN)
                }
                sched.sleep_ticks(state, 1)
            } else {
                if chunk > free {
                    chunk = free
                }
                let w: u64 = wl_send(state, me, si, base + off, chunk, false)
                if w == neg(errno.E_FAULT) {
                    return w
                }
                if errno.is_error(w) {
                    return neg(w)
                }
                sent = sent + w
                off = off + w
                sched.poll_kick(state)
            }
        }
        v = v + 1
    }
    return sent
}

const FRAME_MAX: u64 = 3600
const MSG_TRUNC_FLAG: u64 = 32
const MSG_CTRUNC_FLAG: u64 = 8

fn frame_nonblock(state: u64, me: u64, fd: u64, flags: u64) -> bool {
    if (flags & MSG_DONTWAIT) != 0 {
        return true
    }
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return false
    }
    return (file.open_flags(state, of) & UB_O_NONBLOCK) != 0
}

fn sendmsg_frame(state: u64, me: u64, fd: u64, si: u64, mh: u64, flags: u64) -> u64 {
    let iov: u64 = get64u(state, me, mh + MH_IOV)
    let iovlen: u64 = get64u(state, me, mh + MH_IOVLEN)
    if iovlen > 1024 {
        return neg(errno.E_INVAL)
    }
    var total: u64 = 0
    var v: u64 = 0
    while v < iovlen {
        if !proc.user_ok(state, me, iov + v * 16, 16) {
            return neg(errno.E_FAULT)
        }
        total = total + get64u(state, me, iov + v * 16 + 8)
        if total > FRAME_MAX {
            return neg(errno.E_MSGSIZE)
        }
        v = v + 1
    }
    let ctl: u64 = get64u(state, me, mh + MH_CONTROL)
    let ctllen: u64 = get64u(state, me, mh + MH_CONTROLLEN)
    var nfds: u64 = 0
    if ctl != 0 && ctllen >= 16 {
        if !proc.user_ok(state, me, ctl, ctllen) {
            return neg(errno.E_FAULT)
        }
        let clen: u64 = get64u(state, me, ctl)
        if get32(state, me, ctl + 8) == SOL_SOCKET && get32(state, me, ctl + 12) == SCM_RIGHTS && clen >= 16 && clen <= ctllen {
            nfds = (clen - 16) / 4
            if nfds > unixsock.FDQ_MAX {
                return neg(errno.E_INVAL)
            }
            var chk: u64 = 0
            while chk < nfds {
                if of_of(state, me, get32(state, me, ctl + 16 + chk * 4)) >= file.MAX_OPEN {
                    return neg(errno.E_BADF)
                }
                chk = chk + 1
            }
        }
    }
    let nonblock: bool = frame_nonblock(state, me, fd, flags)
    var waits: u64 = 0
    while true {
        if unixsock.peer_gone(state, si) {
            return neg(errno.E_PIPE)
        }
        if unixsock.dgram_room(state, unixsock.sock_peer(state, si)) >= total && unixsock.fd_room(state, si) >= nfds {
            let fl: u64 = unixsock.scratch_lock(state)
            var ok: bool = true
            var off: u64 = 0
            v = 0
            while v < iovlen && ok {
                let blen: u64 = get64u(state, me, iov + v * 16 + 8)
                if !copy_in(state, me, state + WL_SCRATCH + off, get64u(state, me, iov + v * 16), blen) {
                    ok = false
                }
                off = off + blen
                v = v + 1
            }
            if !ok {
                unixsock.scratch_unlock(state, fl)
                return neg(errno.E_FAULT)
            }
            var k: u64 = 0
            while k < nfds {
                unixsock.push_fd(state, si, of_of(state, me, get32(state, me, ctl + 16 + k * 4)))
                k = k + 1
            }
            let w: u64 = unixsock.send_dgram(state, si, WL_SCRATCH, total)
            unixsock.scratch_unlock(state, fl)
            if errno.is_error(w) {
                return neg(w)
            }
            sched.poll_kick(state)
            return w
        }
        if nonblock || waits >= NET_ROUNDS {
            return neg(errno.E_AGAIN)
        }
        waits = waits + 1
        sched.sleep_ticks(state, 1)
    }
    return 0
}

fn recvmsg_frame(state: u64, me: u64, fd: u64, si: u64, mh: u64, flags: u64) -> u64 {
    let iov: u64 = get64u(state, me, mh + MH_IOV)
    let iovlen: u64 = get64u(state, me, mh + MH_IOVLEN)
    if iovlen > 1024 {
        return neg(errno.E_INVAL)
    }
    let nonblock: bool = frame_nonblock(state, me, fd, flags)
    var waited: u64 = 0
    while unixsock.waiting(state, si) < unixsock.DGRAM_HDR {
        if unixsock.peer_gone(state, si) {
            return 0
        }
        if nonblock || waited >= NET_ROUNDS {
            return neg(errno.E_AGAIN)
        }
        waited = waited + 1
        sched.sleep_ticks(state, 1)
    }
    var cap: u64 = 0
    var v: u64 = 0
    while v < iovlen {
        if !proc.user_ok(state, me, iov + v * 16, 16) {
            return neg(errno.E_FAULT)
        }
        cap = cap + get64u(state, me, iov + v * 16 + 8)
        v = v + 1
    }
    if cap > FRAME_MAX {
        cap = FRAME_MAX
    }
    let mlen: u64 = unixsock.dgram_len(state, si)
    let ctl: u64 = get64u(state, me, mh + MH_CONTROL)
    let ctllen: u64 = get64u(state, me, mh + MH_CONTROLLEN)
    if ctl != 0 && ctllen != 0 && !proc.user_ok(state, me, ctl, ctllen) {
        return neg(errno.E_FAULT)
    }
    var room: u64 = 0
    if ctl != 0 && ctllen >= 20 {
        room = (ctllen - 16) / 4
    }
    var rflags: u64 = 0
    var n: u64 = 0
    while unixsock.fd_at_head(state, si) {
        let sof: u64 = unixsock.pop_fd(state, si)
        if sof >= file.MAX_OPEN {
            break
        }
        var kept: bool = false
        if n < room {
            let nfd: u64 = file.fd_alloc(state, me, 0)
            if nfd < file.MAX_FD {
                file.fd_set(state, me, nfd, sof)
                if (flags & MSG_CMSG_CLOEXEC) != 0 {
                    cx_put(state, me, nfd, true)
                }
                if put32(state, me, ctl + 16 + n * 4, nfd) {
                    n = n + 1
                    kept = true
                }
            }
        }
        if !kept {
            file.open_unref(state, sof)
            rflags = rflags | MSG_CTRUNC_FLAG
        }
    }
    var ctlout: u64 = 0
    if n != 0 {
        ctlout = 16 + n * 4
        if !put64(state, me, ctl, ctlout) || !put32(state, me, ctl + 8, SOL_SOCKET) || !put32(state, me, ctl + 12, SCM_RIGHTS) {
            return neg(errno.E_FAULT)
        }
    }
    if !put64(state, me, mh + MH_CONTROLLEN, ctlout) {
        return neg(errno.E_FAULT)
    }
    if mlen > cap {
        rflags = rflags | MSG_TRUNC_FLAG
    }
    if !put32(state, me, mh + MH_FLAGS, rflags) {
        return neg(errno.E_FAULT)
    }
    let fl: u64 = unixsock.scratch_lock(state)
    let got: u64 = unixsock.recv_dgram(state, si, WL_SCRATCH, cap)
    var ok: bool = true
    var off: u64 = 0
    v = 0
    while v < iovlen && off < got && ok {
        var chunk: u64 = get64u(state, me, iov + v * 16 + 8)
        if chunk > got - off {
            chunk = got - off
        }
        if !copy_out(state, me, get64u(state, me, iov + v * 16), state + WL_SCRATCH + off, chunk) {
            ok = false
        }
        off = off + chunk
        v = v + 1
    }
    unixsock.scratch_unlock(state, fl)
    if !ok {
        return neg(errno.E_FAULT)
    }
    return got
}

fn do_recvmsg(state: u64, me: u64, fd: u64, mh: u64, flags: u64) -> u64 {
    let nlof: u64 = nl_of(state, me, fd)
    if nlof < file.MAX_OPEN {
        return nl_recvmsg(state, me, nlof, mh, flags)
    }
    let si: u64 = usock_of(state, me, fd)
    if si >= unixsock.USOCK_MAX {
        return neg(errno.E_BADF)
    }
    if !proc.user_ok(state, me, mh, MH_BYTES) {
        return neg(errno.E_FAULT)
    }
    if unixsock.sock_kind(state, si) == unixsock.UK_DGRAM {
        return recvmsg_frame(state, me, fd, si, mh, flags)
    }
    let iov: u64 = get64u(state, me, mh + MH_IOV)
    let iovlen: u64 = get64u(state, me, mh + MH_IOVLEN)
    var waited: u64 = 0
    while unixsock.waiting(state, si) == 0 {
        if unixsock.peer_gone(state, si) {
            return 0
        }
        if (flags & MSG_DONTWAIT) != 0 {
            return neg(errno.E_AGAIN)
        }
        if waited >= NET_ROUNDS {
            return neg(errno.E_AGAIN)
        }
        waited = waited + 1
        sched.sleep_ticks(state, 1)
    }
    var ctlout: u64 = 0
    let ctl: u64 = get64u(state, me, mh + MH_CONTROL)
    let ctllen: u64 = get64u(state, me, mh + MH_CONTROLLEN)
    if ctl != 0 && ctllen >= 20 && unixsock.fd_waiting(state, si) != 0 {
        if !proc.user_ok(state, me, ctl, ctllen) {
            return neg(errno.E_FAULT)
        }
        var room: u64 = (ctllen - 16) / 4
        if room > unixsock.FDQ_MAX {
            room = unixsock.FDQ_MAX
        }
        var n: u64 = 0
        while n < room && unixsock.fd_waiting(state, si) != 0 {
            let sof: u64 = unixsock.pop_fd(state, si)
            if sof >= file.MAX_OPEN {
                n = room
            } else {
                let nfd: u64 = file.fd_alloc(state, me, 0)
                if nfd >= file.MAX_FD {
                    file.open_unref(state, sof)
                    n = room
                } else {
                    file.fd_set(state, me, nfd, sof)
                    if (flags & MSG_CMSG_CLOEXEC) != 0 {
                        cx_put(state, me, nfd, true)
                    }
                    if !put32(state, me, ctl + 16 + n * 4, nfd) {
                        return neg(errno.E_FAULT)
                    }
                    n = n + 1
                }
            }
        }
        if n != 0 {
            ctlout = 16 + n * 4
            if !put64(state, me, ctl, ctlout) {
                return neg(errno.E_FAULT)
            }
            if !put32(state, me, ctl + 8, SOL_SOCKET) {
                return neg(errno.E_FAULT)
            }
            if !put32(state, me, ctl + 12, SCM_RIGHTS) {
                return neg(errno.E_FAULT)
            }
        }
    }
    if !put64(state, me, mh + MH_CONTROLLEN, ctlout) {
        return neg(errno.E_FAULT)
    }
    // MSG_CTRUNC (8): descriptors are still queued because the control buffer was too small.
    var rflags: u64 = 0
    if ctl != 0 && unixsock.fd_waiting(state, si) != 0 {
        rflags = 8
    }
    if !put32(state, me, mh + MH_FLAGS, rflags) {
        return neg(errno.E_FAULT)
    }
    var got: u64 = 0
    var v: u64 = 0
    while v < iovlen && unixsock.waiting(state, si) != 0 {
        if !proc.user_ok(state, me, iov + v * 16, 16) {
            return neg(errno.E_FAULT)
        }
        let base: u64 = get64u(state, me, iov + v * 16)
        let blen: u64 = get64u(state, me, iov + v * 16 + 8)
        var off: u64 = 0
        while off < blen && unixsock.waiting(state, si) != 0 {
            var chunk: u64 = blen - off
            if chunk > MSG_MAX {
                chunk = MSG_MAX
            }
            let r: u64 = wl_recv(state, me, si, base + off, chunk, false)
            if r == neg(errno.E_FAULT) {
                return r
            }
            if errno.is_error(r) {
                return neg(r)
            }
            if r == 0 {
                off = blen
            } else {
                got = got + r
                off = off + r
            }
        }
        v = v + 1
    }
    return got
}

// ---------------------------------------------------------- fallocate()
fn do_fallocate(state: u64, me: u64, fd: u64, mode: u64, off: u64,
    len: u64) -> u64 {
    if mode != 0 {
        return neg(errno.E_OPNOTSUPP)
    }
    if len == 0 {
        return neg(errno.E_INVAL)
    }
    if off > 0xFFFFFFFF || len > 0xFFFFFFFF {
        return neg(errno.E_FBIG)
    }
    // ROUND UNTERBAU: on a plain file the size only GROWS (never shrinks), as posix_fallocate does. The blocks are not reserved:
    // the file has a hole there and a full disk is found out when the hole is written (documented in docs/RUNDE-UNTERBAU-FIREFOX.md).
    let of: u64 = of_of(state, me, fd)
    if of < file.MAX_OPEN && file.open_kind(state, of) == file.K_FILE {
        if fs.inode_size(state, file.open_ino(state, of)) >= off + len {
            return 0
        }
    }
    return do_ftruncate(state, me, fd, off + len)
}

// ---------------------------------------------------------- ftruncate()
fn do_ftruncate(state: u64, me: u64, fd: u64, size: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if file.open_kind(state, of) == file.K_FILE {
        // ROUND UNTERBAU: a plain file of the root file system: any size (growth = hole, shrink = zeroed tail)
        if (file.open_flags(state, of) & 3) == 0 {
            return neg(errno.E_INVAL)
        }
        if size > 0xFFFFFFFF {
            return neg(errno.E_FBIG)
        }
        if !fs.set_size(state, file.open_ino(state, of), size) {
            return neg(errno.E_IO)
        }
        return 0
    }
    if file.open_kind(state, of) != file.K_SHM {
        return neg(errno.E_INVAL)
    }
    let i: u64 = file.open_ino(state, of)
    if unixsock.shm_used(state, i) == 0 {
        return neg(errno.E_BADF)
    }
    let alt: u64 = unixsock.shm_size(state, i)
    let seals: u64 = unixsock.shm_seals(state, i)
    if size < alt && (seals & F_SEAL_SHRINK) != 0 {
        return neg(errno.E_PERM)
    }
    if size > alt && (seals & F_SEAL_GROW) != 0 {
        return neg(errno.E_PERM)
    }
    let pages: u64 = page_up(size) / PAGE
    if pages > unixsock.shm_max_pages(state, i) {
        return neg(errno.E_FBIG)
    }
    if unixsock.shm_grow(state, i, pages) != 0 {
        return neg(errno.E_NOMEM)
    }
    unixsock.shm_set_size(state, i, size)
    return 0
}

// ------------------------------------------------------- memfd_create()

fn do_memfd(state: u64, me: u64, name: u64, flags: u64) -> u64 {
    if name != 0 && !proc.user_ok(state, me, name, 1) {
        return neg(errno.E_FAULT)
    }
    var i: u64 = unixsock.USHM_MAX
    if (flags & MFD_FRAMES) != 0 {
        i = unixsock.shm_new_contig(state)
    } else {
        i = unixsock.shm_new_any(state)
    }
    if i >= unixsock.USHM_MAX {
        return neg(errno.E_NFILE)
    }
    let of: u64 = file.open_alloc(state, file.K_SHM, i, O_RDWR)
    if of >= file.MAX_OPEN {
        unixsock.shm_free(state, i)
        return neg(errno.E_NFILE)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        unixsock.shm_free(state, i)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    return fd
}

// ================================================================ RUNDE UNTERBAU
const UB_SELECT: u64 = 23
const UB_SOCKETPAIR: u64 = 53
const UB_PSELECT6: u64 = 270
const UB_PPOLL: u64 = 271
const UB_MREMAP: u64 = 25
const UB_MSYNC: u64 = 26
const UB_MADVISE: u64 = 28
const UB_READAHEAD: u64 = 187
const UB_FADVISE64: u64 = 221
const UB_MLOCK: u64 = 149
const UB_MUNLOCK: u64 = 150
const UB_MLOCKALL: u64 = 151
const UB_MUNLOCKALL: u64 = 152
const UB_GETRLIMIT: u64 = 97
const UB_GETRUSAGE: u64 = 98
const UB_SYSINFO: u64 = 99
const UB_GETPRIORITY: u64 = 140
const UB_SETPRIORITY: u64 = 141
const UB_SCHED_SETPARAM: u64 = 142
const UB_SCHED_GETPARAM: u64 = 143
const UB_SCHED_SETSCHEDULER: u64 = 144
const UB_SCHED_GETSCHEDULER: u64 = 145
const UB_SCHED_GET_PRIORITY_MAX: u64 = 146
const UB_SCHED_GET_PRIORITY_MIN: u64 = 147
const UB_SETRLIMIT: u64 = 160
const UB_SCHED_SETAFFINITY: u64 = 203
const UB_SCHED_GETAFFINITY: u64 = 204
const UB_FDATASYNC: u64 = 75
const UB_DUP3: u64 = 292
const LC_CHROOT: u64 = 161

// chroot(2) (W-MG3), built on the container jail (`ctr`): the root of a jail is a STRING put in front of every absolute path
// (`uio.jailed`), so the calling task simply moves into a container slot whose root is the folded path. Same root = same slot.
// A nested chroot gets a new slot whose root is longer (the path already carries the old root), so it can only go deeper.
// The cwd becomes "/" (Linux keeps it; every user of chroot calls chdir("/") next, and a cwd outside the root must not survive).
fn do_chroot(state: u64, me: u64, name: u64) -> u64 {
    if !appfs.free_ok(state, me) {
        return neg(errno.E_ACCES)
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return neg(errno.E_NOSYS)
    }
    if sched.tget(state, me, sched.T_EUID) != 0 {
        return neg(errno.E_PERM)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if !perm.walk(state, me, buf) {
        return neg(errno.E_ACCES)
    }
    let ino: u64 = fs.path(state, buf)
    if ino == 0 {
        return neg(errno.E_NOENT)
    }
    if fs.inode_type(state, ino) != fs.T_DIR {
        return neg(errno.E_NOTDIR)
    }
    // fold `.`/`..` so that no `..` can sit inside the stored root, then drop trailing slashes
    var n: u64 = len
    if n == 0 || kstate.get8(buf) != 47 {
        return neg(errno.E_INVAL)
    }
    n = ctr.fold(buf, n)
    while n > 1 && kstate.get8(buf + n - 1) == 47 {
        n = n - 1
        kstate.set8(buf + n, 0 as u8)
    }
    if n <= 1 {
        return 0 // chroot("/") of a host task: nothing to do
    }
    if n >= ctr.ROOT_MAX - 1 {
        return neg(errno.E_NAMETOOLONG)
    }
    let old: u64 = ctr.ctr_of(state, me)
    var i: u64 = ctr.find_root(state, buf)
    if i == 0 {
        i = ctr.alloc(state)
        if i == 0 {
            return neg(errno.E_NOSPC)
        }
        if !ctr.root_set(state, i, buf) {
            ctr.free_slot(state, i)
            return neg(errno.E_INVAL)
        }
        var nm: [u8; 8] = "chroot\0\0"
        ctr.name_set(state, i, (&nm[0]) as u64)
        if old != 0 {
            ctr.netview_set(state, i, ctr.netview_of(state, old))
        }
    }
    ctr.set_ctr(state, me, i)
    ctr.set_state(state, i, ctr.C_RUN)
    // cwd = the new root: `chdir_to` stores the path relative to the (now active) jail root, i.e. "/"
    return uio.chdir_to(state, me, buf)
}
const UB_FLOCK: u64 = 73
const UB_STATFS: u64 = 137
const UB_FSTATFS: u64 = 138
const UB_PIPE2: u64 = 293
const UB_SET_ROBUST_LIST: u64 = 273
const UB_PRLIMIT64: u64 = 302
const UB_O_NONBLOCK: u64 = 2048
const UB_O_CLOEXEC: u64 = 524288
const UB_TKILL: u64 = 200
// RUNDE RTSIG (r730): sigqueue() and its per-thread twin. The queued value (si_value) is not carried yet: the signal is sent like kill/tgkill.
const UB_RT_SIGQUEUEINFO: u64 = 129
const UB_RT_TGSIGQUEUEINFO: u64 = 297
const UB_FUTEX_WAIT_BITSET: u64 = 9
const UB_FUTEX_WAKE_BITSET: u64 = 10
const UB_INF: u64 = 0xFFFFFFFFFFFFFFFF

// getrlimit / setrlimit / prlimit64. The numbers are the ones of THIS kernel where it has a limit (descriptors per process,
// processes), the ones Linux reports for "no limit" otherwise. setrlimit checks the shape (soft <= hard, a known resource) and accepts:
// nothing here enforces a limit that is not already a table size, and saying so is the answer -- a later getrlimit gives the real value.
fn rlimit_cur(res: u64) -> u64 {
    if res == 3 {
        return 8388608
    }
    if res == 4 {
        return 0
    }
    if res == 6 {
        return kstate.MAX_TASKS
    }
    if res == 7 {
        return file.MAX_FD
    }
    if res == 8 {
        return 65536
    }
    if res == 11 {
        return 1024
    }
    if res == 12 {
        return 819200
    }
    return UB_INF
}

fn rlimit_max(res: u64) -> u64 {
    if res == 4 {
        return 0
    }
    if res == 6 {
        return kstate.MAX_TASKS
    }
    if res == 7 {
        return file.MAX_FD
    }
    if res == 8 {
        return 65536
    }
    if res == 11 {
        return 1024
    }
    if res == 12 {
        return 819200
    }
    return UB_INF
}

fn do_rlimit(state: u64, me: u64, res: u64, newp: u64, oldp: u64) -> u64 {
    if res >= 16 {
        return neg(errno.E_INVAL)
    }
    if oldp != 0 {
        if !proc.user_ok(state, me, oldp, 16) {
            return neg(errno.E_FAULT)
        }
        let _a: bool = put64(state, me, oldp, rlimit_cur(res))
        let _b: bool = put64(state, me, oldp + 8, rlimit_max(res))
    }
    if newp != 0 {
        if !proc.user_ok(state, me, newp, 16) {
            return neg(errno.E_FAULT)
        }
        let cur: u64 = user_word(state, me, newp)
        let mx: u64 = user_word(state, me, newp + 8)
        if cur > mx {
            return neg(errno.E_INVAL)
        }
    }
    return 0
}

// The Linux `sysinfo`: uptime, load, memory in bytes (unit 1). The memory numbers are the frame allocator's.
fn do_sysinfo_linux(state: u64, me: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, 112) {
        return neg(errno.E_FAULT)
    }
    var k: u64 = 0
    while k < 14 {
        let _z: bool = put64(state, me, out + k * 8, 0)
        k = k + 1
    }
    let total: u64 = mem.frames_total(state) * PAGE
    let free: u64 = mem.frames_free(state) * PAGE
    let _up: bool = put64(state, me, out, kstate.get(state, kstate.TICKS) / 100)
    let _tr: bool = put64(state, me, out + 32, total)
    let _fr: bool = put64(state, me, out + 40, free)
    let _pr: bool = put32(state, me, out + 80, kstate.get(state, kstate.TASKS))
    let _mu: bool = put32(state, me, out + 104, 1)
    return 0
}

// statfs/fstatfs (struct statfs, 120 octets): the numbers of the root file system (OFS). The path/descriptor is only checked; every
// mount of this kernel except /proc, /dev answers with the root numbers. f_files/f_ffree stay 0 (not counted), f_type is the OFS tag.
fn do_statfs(state: u64, me: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, 120) {
        return neg(errno.E_FAULT)
    }
    var k: u64 = 0
    while k < 15 {
        let _z: bool = put64(state, me, out + k * 8, 0)
        k = k + 1
    }
    let total: u64 = fs.total_blocks(state)
    let free: u64 = fs.free_blocks(state)
    let _t: bool = put64(state, me, out, 0x3353464F)
    let _bs: bool = put64(state, me, out + 8, 4096)
    let _b: bool = put64(state, me, out + 16, total)
    let _f: bool = put64(state, me, out + 24, free)
    let _a: bool = put64(state, me, out + 32, free)
    let _nl: bool = put64(state, me, out + 64, fs.NAME_LEN - 1)
    let _fr: bool = put64(state, me, out + 72, 4096)
    return 0
}

// getrusage: the kernel keeps no per-process times of this kind; zeros are the honest "not accounted" and every field is there.
fn do_getrusage(state: u64, me: u64, who: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, 144) {
        return neg(errno.E_FAULT)
    }
    var k: u64 = 0
    while k < 18 {
        let _z: bool = put64(state, me, out + k * 8, 0)
        k = k + 1
    }
    return 0
}

// sched_getaffinity: one bit per processor the firmware reported (at least one), as the number of octets the caller gave
// (musl passes the size of its cpu_set_t; the kernel's answer is the number of octets it wrote).
fn do_getaffinity(state: u64, me: u64, pid: u64, size: u64, out: u64) -> u64 {
    if size < 8 || (size & 7) != 0 {
        return neg(errno.E_INVAL)
    }
    var n: u64 = kstate.get(state, kstate.SMP_OFF + kstate.SMP_COUNT)
    if n == 0 {
        n = 1
    }
    if n > 64 {
        n = 64
    }
    if !proc.user_ok(state, me, out, size) {
        return neg(errno.E_FAULT)
    }
    // (words through `put64`, which opens the SMAP window: a plain store to a user address from ring 0 is a #PF)
    var k: u64 = 0
    while k < size {
        let _z: bool = put64(state, me, out + k, 0)
        k = k + 8
    }
    var mask: u64 = 0
    if n == 64 {
        mask = 0xFFFFFFFFFFFFFFFF
    } else {
        mask = (1 << n) - 1
    }
    let _m: bool = put64(state, me, out, mask)
    return 8
}

// Corpses of non-leader threads of the caller's thread group are reaped (descriptors closed, slot given back). Returns how many.
fn reap_dead_threads(state: u64, me: u64) -> u64 {
    var g: u64 = sched.tget(state, me, sched.T_TGID)
    if g == 0 {
        g = sched.tget(state, me, sched.T_PID)
    }
    var n: u64 = 0
    var i: u64 = 1
    while i < kstate.MAX_TASKS {
        if i != me && sched.tget(state, i, sched.T_STATE) == sched.S_ZOMBIE {
            let tg: u64 = sched.tget(state, i, sched.T_TGID)
            if tg == g && sched.tget(state, i, sched.T_PID) != g {
                proc.reap(state, i)
                n = n + 1
            }
        }
        i = i + 1
    }
    return n
}

// madvise: DONTNEED zeroes private pages (what a program relies on to get fresh memory back from a region it keeps); the other known advice
// values are hints and are accepted; an unknown value is -EINVAL; a page that is not mapped is -ENOMEM.
fn do_madvise(state: u64, me: u64, addr: u64, len: u64, advice: u64) -> u64 {
    if (addr & 4095) != 0 {
        return neg(errno.E_INVAL)
    }
    let known: bool = advice <= 4 || advice == 8 || (advice >= 9 && advice <= 19)
    if !known {
        return neg(errno.E_INVAL)
    }
    if len == 0 {
        return 0
    }
    if len > 0x400000000 {
        return neg(errno.E_NOMEM)
    }
    let pages: u64 = page_up(len) / PAGE
    var k: u64 = 0
    while k < pages {
        if !proc.page_mapped(state, me, addr + k * PAGE) {
            return neg(errno.E_NOMEM)
        }
        k = k + 1
    }
    if advice == 4 {
        k = 0
        while k < pages {
            let _z: bool = proc.page_zero(state, me, addr + k * PAGE)
            k = k + 1
        }
    }
    return 0
}

// Rights bits of proc.page_rights (2 read, 4 write, 8 execute) as PROT_* bits.
fn rights_prot(rights: u64) -> u64 {
    var prot: u64 = 0
    if (rights & 2) != 0 {
        prot = PROT_READ
    }
    if (rights & 4) != 0 {
        prot = prot | PROT_WRITE
    }
    if (rights & 8) != 0 {
        prot = prot | PROT_EXEC
    }
    return prot
}

// mremap growth of a mapping in the lazy arena: first in place (the pages behind the mapping are free), else, with MREMAP_MAYMOVE, a
// new lazy run; only pages that were touched are copied, the rest stays demand-zero.
fn mremap_lazy_grow(state: u64, me: u64, old_addr: u64, oldp: u64, newp: u64, rights: u64, may_move: bool) -> u64 {
    let prot: u64 = rights_prot(rights)
    let old_end: u64 = old_addr + oldp * PAGE
    let extra: u64 = newp - oldp
    var free_after: bool = old_end + extra * PAGE <= proc.LAZY_ATOP
    var k: u64 = 0
    while free_after && k < extra {
        if proc.page_mapped(state, me, old_end + k * PAGE) {
            free_after = false
        }
        k = k + 1
    }
    if free_after {
        if lazy_run(state, me, old_end, extra, prot) {
            return old_addr
        }
    }
    if !may_move {
        return neg(errno.E_NOMEM)
    }
    let base: u64 = lazy_alloc(state, me, newp, PROT_READ | PROT_WRITE)
    if base >= 0xFFFFFFFFFFFFF000 {
        return base
    }
    k = 0
    while k < oldp {
        let _c: bool = proc.page_copy(state, me, old_addr + k * PAGE, base + k * PAGE)
        k = k + 1
    }
    if (prot & 3) != 3 {
        let _r: u64 = set_range_prot(state, me, base, newp, prot)
    }
    let _d: u64 = do_unmap(state, me, old_addr, oldp * PAGE)
    return base
}

// mremap: shrinking unmaps the tail; growing needs a new place (MREMAP_MAYMOVE): a new mapping is made, the pages are copied and the old
// ones are given back. The rights of the first page carry over. MREMAP_FIXED / DONTUNMAP and growing in place are not supported (-EINVAL / -ENOMEM).
fn do_mremap(state: u64, me: u64, old_addr: u64, old_len: u64, new_len: u64, flags: u64) -> u64 {
    if (old_addr & 4095) != 0 || old_len == 0 || new_len == 0 || (flags & 6) != 0 {
        return neg(errno.E_INVAL)
    }
    let oldp: u64 = page_up(old_len) / PAGE
    let newp: u64 = page_up(new_len) / PAGE
    var k: u64 = 0
    var virtual_only: bool = false
    while k < oldp {
        if !proc.page_mapped(state, me, old_addr + k * PAGE) {
            if !proc.stack_zone_has(state, me, old_addr + k * PAGE) {
                return neg(errno.E_FAULT)
            }
            virtual_only = true
        }
        k = k + 1
    }
    if newp == oldp {
        return old_addr
    }
    if virtual_only {
        return neg(errno.E_NOMEM)
    }
    if newp < oldp {
        let _u: u64 = do_unmap(state, me, old_addr + newp * PAGE, (oldp - newp) * PAGE)
        return old_addr
    }
    let rights: u64 = proc.page_rights(state, me, old_addr)
    if old_addr >= proc.LAZY_BASE && old_addr + oldp * PAGE <= proc.LAZY_ATOP {
        return mremap_lazy_grow(state, me, old_addr, oldp, newp, rights, (flags & 1) != 0)
    }
    if (flags & 1) == 0 {
        return neg(errno.E_NOMEM)
    }
    let base: u64 = map_alloc(state, me, newp, PROT_READ | PROT_WRITE)
    if base >= 0xFFFFFFFFFFFFF000 {
        return base
    }
    k = 0
    while k < oldp {
        let _c: bool = proc.page_copy(state, me, old_addr + k * PAGE, base + k * PAGE)
        k = k + 1
    }
    let prot: u64 = rights_prot(rights)
    if (prot & 3) != 3 {
        let _r: u64 = set_range_prot(state, me, base, newp, prot)
    }
    let _d: u64 = do_unmap(state, me, old_addr, oldp * PAGE)
    return base
}

// FD_CLOEXEC bits: one per descriptor, in word 24 of the task's entry of the TCPU table (the word nobody uses; file.fd_free clears the bit).
// K-08 (TOCTOU audit): 512 bits per task (kstate.CX_OFF), 8 words of 64 descriptors; it used to be ONE word, so descriptors >= 64 lost the flag.
fn cx_word(task: u64, w: u64) -> u64 {
    return kstate.CX_OFF + task * kstate.CX_BYTES + w * 8
}

fn cx_bit(state: u64, task0: u64, fd: u64) -> u64 {
    if fd >= file.MAX_FD || task0 >= kstate.MAX_TASKS {
        return 0
    }
    let task: u64 = file.owner(state, task0)
    return (kstate.get(state, cx_word(task, fd >> 6)) >> (fd & 63)) & 1
}

fn cx_copy(state: u64, from0: u64, to0: u64) {
    let from: u64 = file.owner(state, from0)
    let to: u64 = file.owner(state, to0)
    var w: u64 = 0
    while w < 8 {
        kstate.set(state, cx_word(to, w), kstate.get(state, cx_word(from, w)))
        w = w + 1
    }
}

fn cx_clear(state: u64, task0: u64) {
    let task: u64 = file.owner(state, task0)
    var w: u64 = 0
    while w < 8 {
        kstate.set(state, cx_word(task, w), 0)
        w = w + 1
    }
}

fn cx_put(state: u64, task0: u64, fd: u64, on: bool) {
    if fd >= file.MAX_FD || task0 >= kstate.MAX_TASKS {
        return
    }
    let task: u64 = file.owner(state, task0)
    let a: u64 = cx_word(task, fd >> 6)
    let m: u64 = kstate.get(state, a)
    if on {
        kstate.set(state, a, m | (1 << (fd & 63)))
    } else {
        kstate.set(state, a, m & (0xFFFFFFFFFFFFFFFF -% (1 << (fd & 63))))
    }
}

// `r` is the descriptor a call returned (or an error); with O_CLOEXEC / SOCK_CLOEXEC in `flags` it gets the flag. Returns `r`.
fn cx_result(state: u64, me: u64, r: u64, flags: u64) -> u64 {
    if !errno.is_error(r) && (flags & UB_O_CLOEXEC) != 0 {
        cx_put(state, me, r, true)
    }
    return r
}

// execve: the marked descriptors close.
fn cx_close_marked(state: u64, me: u64) {
    var fd: u64 = 0
    while fd < file.MAX_FD {
        if cx_bit(state, me, fd) != 0 {
            let of: u64 = of_of(state, me, fd)
            if of < file.MAX_OPEN {
                file.fd_free(state, me, fd)
                unref_of(state, of)
            }
        }
        fd = fd + 1
    }
    cx_clear(state, me)
}

// RUNDE UNTERBAU: A READ OR WRITE ON A REGULAR FILE IS NOT CUT AT 4096 OCTETS. `read`/`write` moved one block (MAX_IO) per call and
// answered the rest with a short count; POSIX allows a short count on a regular file only at its end, and a program that reads a file
// "all at once" (`read(fd, buf, st_size)` -- the way config files, fonts and the dynamic loader's headers are read) took the 4096 for the file.
// For a regular file the call now repeats until the request is done or a block comes back short. Pipes, sockets and terminals keep their
// short counts (that is their contract).
// r728: a write() larger than one block is ONE write-behind scope: the 4 KiB steps below share the sector table, so the ATA
// commands carry long runs instead of one block each. The data is on the drive when the call returns.
fn file_io_loop(state: u64, me: u64, fd: u64, buf: u64, len: u64, writing: bool) -> u64 {
    if writing && len > MAX_IO {
        blk.wb_begin(state)
        let r: u64 = file_io_loop_steps(state, me, fd, buf, len, writing)
        if !blk.wb_end(state) {
            return neg(errno.E_IO)
        }
        return r
    }
    return file_io_loop_steps(state, me, fd, buf, len, writing)
}

fn file_io_loop_steps(state: u64, me: u64, fd: u64, buf: u64, len: u64, writing: bool) -> u64 {
    var first: u64 = 0
    if writing {
        first = do_write(state, me, fd, buf, len)
    } else {
        first = do_read(state, me, fd, buf, len)
    }
    if len <= MAX_IO || first != MAX_IO {
        return first
    }
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN || file.open_kind(state, of) != file.K_FILE {
        return first
    }
    var done: u64 = first
    while done < len {
        var chunk: u64 = len - done
        if chunk > MAX_IO {
            chunk = MAX_IO
        }
        var r: u64 = 0
        if writing {
            r = do_write(state, me, fd, buf + done, chunk)
        } else {
            r = do_read(state, me, fd, buf + done, chunk)
        }
        if errno.is_error(r) {
            return done
        }
        done = done + r
        if r < chunk {
            return done
        }
    }
    return done
}

// r731: sendto(fd, buf, len, 0, &sockaddr_un, alen) on a datagram socket: the frame goes into the ring of the socket bound under that path.
// A stream socket ignores the address (Linux does too once connected).
fn usock_sendto(state: u64, me: u64, of: u64, buf: u64, len: u64, addr: u64, alen: u64) -> u64 {
    let si: u64 = file.open_ino(state, of)
    if si >= unixsock.USOCK_MAX {
        return neg(errno.E_BADF)
    }
    if unixsock.sock_kind(state, si) != unixsock.UK_DGRAM {
        return write_of(state, me, of, buf, len)
    }
    if len > MSG_MAX {
        return neg(errno.E_MSGSIZE)
    }
    if !proc.user_ok(state, me, buf, len) {
        return neg(errno.E_FAULT)
    }
    var plen: u64 = 0
    let sfl: u64 = unixsock.scratch_lock(state)
    let r: u64 = sa_un(state, me, addr, alen, &plen)
    if errno.is_error(r) {
        unixsock.scratch_unlock(state, sfl)
        return r
    }
    let dst: u64 = unixsock.find_dgram(state, WL_PATH + 2, plen)
    if dst >= unixsock.USOCK_MAX {
        unixsock.scratch_unlock(state, sfl)
        return neg(errno.E_CONNREFUSED)
    }
    if !copy_in(state, me, state + WL_SCRATCH, buf, len) {
        unixsock.scratch_unlock(state, sfl)
        return neg(errno.E_FAULT)
    }
    let w: u64 = unixsock.send_dgram_to(state, dst, WL_SCRATCH, len)
    unixsock.scratch_unlock(state, sfl)
    if errno.is_error(w) {
        return neg(w)
    }
    sched.poll_kick(state)
    return w
}

// read/write on a local (AF_UNIX) socket: the same ring as sendmsg/recvmsg, one buffer, no descriptors. O_NONBLOCK on the open file means
// MSG_DONTWAIT. A closed peer reads as end of file (0) and writes -EPIPE.
fn usock_rw(state: u64, me: u64, of: u64, buf: u64, len: u64, writing: bool) -> u64 {
    let si: u64 = file.open_ino(state, of)
    if si >= unixsock.USOCK_MAX {
        return neg(errno.E_BADF)
    }
    let nonblock: bool = (file.open_flags(state, of) & UB_O_NONBLOCK) != 0
    let dg: bool = unixsock.sock_kind(state, si) == unixsock.UK_DGRAM
    var n: u64 = len
    if n > MSG_MAX {
        if dg && writing {
            return neg(errno.E_MSGSIZE)
        }
        n = MSG_MAX
    }
    if !proc.user_ok(state, me, buf, n) {
        return neg(errno.E_FAULT)
    }
    if writing {
        if unixsock.peer_gone(state, si) {
            return neg(errno.E_PIPE)
        }
        var waitw: u64 = 0
        var free: u64 = unixsock.room(state, unixsock.sock_peer(state, si))
        if dg {
            // a datagram goes in whole: wait until the frame (4 length bytes + payload) fits, never cut it
            if n + 5 >= unixsock.RING_CAP - 64 {
                return neg(errno.E_MSGSIZE)
            }
            free = unixsock.dgram_room(state, unixsock.sock_peer(state, si))
        }
        while free == 0 || (dg && free < n) {
            if nonblock {
                return neg(errno.E_AGAIN)
            }
            if waitw >= NET_ROUNDS || unixsock.peer_gone(state, si) {
                return neg(errno.E_AGAIN)
            }
            waitw = waitw + 1
            sched.sleep_ticks(state, 1)
            free = unixsock.room(state, unixsock.sock_peer(state, si))
            if dg {
                free = unixsock.dgram_room(state, unixsock.sock_peer(state, si))
            }
        }
        if n > free {
            n = free
        }
        let w: u64 = wl_send(state, me, si, buf, n, dg)
        if w == neg(errno.E_FAULT) {
            return w
        }
        if errno.is_error(w) {
            return neg(w)
        }
        sched.poll_kick(state)
        return w
    }
    var waited: u64 = 0
    while unixsock.waiting(state, si) == 0 {
        if unixsock.peer_gone(state, si) {
            return 0
        }
        if nonblock || waited >= NET_ROUNDS {
            return neg(errno.E_AGAIN)
        }
        waited = waited + 1
        sched.sleep_ticks(state, 1)
    }
    let r: u64 = wl_recv(state, me, si, buf, n, dg)
    if r == neg(errno.E_FAULT) {
        return r
    }
    if errno.is_error(r) {
        return neg(r)
    }
    return r
}

// select / pselect6 (`wide` = 1: the timeout is a timespec, not a timeval): three bit sets of descriptors, one answer. Only descriptors below
// MAX_FD can exist, so a set bit beyond that is -EBADF. The result sets hold what is ready; the count is the number of ready bits.
fn do_select(state: u64, me: u64, nfds: u64, rp: u64, wp: u64, ep: u64, tp: u64, wide: u64) -> u64 {
    if nfds > 1024 {
        return neg(errno.E_INVAL)
    }
    let words: u64 = (nfds + 63) / 64
    if rp != 0 && !proc.user_ok(state, me, rp, words * 8) {
        return neg(errno.E_FAULT)
    }
    if wp != 0 && !proc.user_ok(state, me, wp, words * 8) {
        return neg(errno.E_FAULT)
    }
    if ep != 0 && !proc.user_ok(state, me, ep, words * 8) {
        return neg(errno.E_FAULT)
    }
    var forever: bool = true
    var ticks: u64 = 0
    if tp != 0 {
        if !proc.user_ok(state, me, tp, 16) {
            return neg(errno.E_FAULT)
        }
        let sec: u64 = user_word(state, me, tp)
        var frac: u64 = user_word(state, me, tp + 8)
        if wide != 0 {
            frac = (frac + 999) / 1000
        }
        if frac >= 1000000 {
            return neg(errno.E_INVAL)
        }
        forever = false
        if sec > 2000000 {
            forever = true
        } else {
            let ms: u64 = sec * 1000 + (frac + 999) / 1000
            if ms != 0 {
                ticks = (ms + 9) / 10 + 1
            }
        }
    }
    let deadline: u64 = kstate.get(state, kstate.TICKS) + ticks
    var inr: [u64; 16] = [0 as u64; 16]
    var inw: [u64; 16] = [0 as u64; 16]
    var k: u64 = 0
    while k < words {
        if rp != 0 {
            inr[k as usize] = user_word(state, me, rp + k * 8)
        }
        if wp != 0 {
            inw[k as usize] = user_word(state, me, wp + k * 8)
        }
        k = k + 1
    }
    var going: bool = true
    while going {
        let seen: u64 = sched.poll_seq(state)
        var outr: [u64; 16] = [0 as u64; 16]
        var outw: [u64; 16] = [0 as u64; 16]
        var ready: u64 = 0
        var fd: u64 = 0
        while fd < nfds {
            let wi: u64 = fd / 64
            let bit: u64 = 1 << (fd % 64)
            let wantr: bool = (inr[wi as usize] & bit) != 0
            let wantw: bool = (inw[wi as usize] & bit) != 0
            if wantr || wantw {
                let pr: u64 = poll_ready(state, me, fd)
                if (pr & POLLNVAL) != 0 {
                    return neg(errno.E_BADF)
                }
                if wantr && (pr & (POLLIN | POLLHUP | POLLERR)) != 0 {
                    outr[wi as usize] = outr[wi as usize] | bit
                    ready = ready + 1
                }
                if wantw && (pr & (POLLOUT | POLLERR)) != 0 {
                    outw[wi as usize] = outw[wi as usize] | bit
                    ready = ready + 1
                }
            }
            fd = fd + 1
        }
        var expired: bool = false
        if !forever && kstate.get(state, kstate.TICKS) >= deadline {
            expired = true
        }
        if ready != 0 || expired {
            k = 0
            while k < words {
                if rp != 0 {
                    let _a: bool = put64(state, me, rp + k * 8, outr[k as usize])
                }
                if wp != 0 {
                    let _b: bool = put64(state, me, wp + k * 8, outw[k as usize])
                }
                if ep != 0 {
                    let _c: bool = put64(state, me, ep + k * 8, 0)
                }
                k = k + 1
            }
            return ready
        }
        if signal.interrupted(state, me) {
            return neg(errno.E_INTR)
        }
        var wake: u64 = deadline
        if forever {
            wake = sched.POLL_FOREVER
        }
        sched.poll_sleep(state, seen, wake)
    }
    return 0
}

// socketpair(AF_UNIX, SOCK_STREAM): two connected local sockets. (SOCK_DGRAM does not exist for local sockets in this kernel.)
fn do_socketpair(state: u64, me: u64, domain: u64, kind: u64, protocol: u64, sv: u64) -> u64 {
    if domain != AF_UNIX {
        return neg(errno.E_AFNOSUPPORT)
    }
    if ((kind & 0xFF) != SOCK_STREAM && (kind & 0xFF) != SOCK_DGRAM && (kind & 0xFF) != SOCK_SEQPACKET) || protocol != 0 {
        return neg(errno.E_PROTONOSUPPORT)
    }
    if !proc.user_ok(state, me, sv, 8) {
        return neg(errno.E_FAULT)
    }
    var uk: u64 = unixsock.UK_STREAM
    if (kind & 0xFF) == SOCK_DGRAM || (kind & 0xFF) == SOCK_SEQPACKET {
        uk = unixsock.UK_DGRAM
    }
    let a: u64 = unixsock.sock_new(state, uk)
    if a >= unixsock.USOCK_MAX {
        return neg(errno.E_NFILE)
    }
    let b: u64 = unixsock.sock_new(state, uk)
    if b >= unixsock.USOCK_MAX {
        unixsock.sock_free(state, a)
        return neg(errno.E_NFILE)
    }
    let c: u64 = unixsock.connect_pair(state, a, b)
    if c != 0 {
        unixsock.sock_free(state, a)
        unixsock.sock_free(state, b)
        return neg(c)
    }
    let oa: u64 = file.open_alloc(state, file.K_USOCK, a, O_RDWR)
    if oa >= file.MAX_OPEN {
        unixsock.sock_free(state, a)
        unixsock.sock_free(state, b)
        return neg(errno.E_NFILE)
    }
    let ob: u64 = file.open_alloc(state, file.K_USOCK, b, O_RDWR)
    if ob >= file.MAX_OPEN {
        file.open_unref(state, oa)
        unixsock.sock_free(state, b)
        return neg(errno.E_NFILE)
    }
    let fa: u64 = file.fd_alloc(state, me, 0)
    if fa >= file.MAX_FD {
        file.open_unref(state, oa)
        file.open_unref(state, ob)
        unixsock.sock_free(state, a)
        unixsock.sock_free(state, b)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fa, oa)
    let fb: u64 = file.fd_alloc(state, me, 0)
    if fb >= file.MAX_FD {
        file.fd_free(state, me, fa)
        file.open_unref(state, oa)
        file.open_unref(state, ob)
        unixsock.sock_free(state, a)
        unixsock.sock_free(state, b)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fb, ob)
    if (kind & SOCK_NONBLOCK) != 0 {
        file.open_set_flags(state, oa, file.open_flags(state, oa) | UB_O_NONBLOCK)
        file.open_set_flags(state, ob, file.open_flags(state, ob) | UB_O_NONBLOCK)
    }
    if !put32(state, me, sv, fa) || !put32(state, me, sv + 4, fb) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// a successful socketpair with SOCK_CLOEXEC marks both descriptors (they were just written to `sv`)
fn cx_pair(state: u64, me: u64, r: u64, sv: u64, kind: u64) -> u64 {
    if r == 0 && (kind & UB_O_CLOEXEC) != 0 {
        let _a: u64 = cx_result(state, me, user_word32(state, me, sv), UB_O_CLOEXEC)
        let _b: u64 = cx_result(state, me, user_word32(state, me, sv + 4), UB_O_CLOEXEC)
    }
    return r
}

// ======================================================================= RUNDE EVENTS (roadmap r663 / r664)
//
// eventfd, timerfd, signalfd, epoll and inotify: the event plumbing of every GUI main loop (glib, Qt, foot, libwayland clients). The STATE
// and its arithmetic are in fs/evfd.fi; this block is the system calls around it: user memory, blocking, dispatch. Waiting is done the way
// `poll` waits: `sched.poll_seq` BEFORE the look, `sched.poll_sleep` after it, and every place that makes something ready kicks the pollers.

const EV_EPOLL_CREATE: u64 = 213
const EV_EPOLL_WAIT: u64 = 232
const EV_EPOLL_CTL: u64 = 233
const EV_INOTIFY_INIT: u64 = 253
const EV_INOTIFY_ADD: u64 = 254
const EV_INOTIFY_RM: u64 = 255
const EV_EPOLL_PWAIT: u64 = 281
const EV_SIGNALFD: u64 = 282
const EV_TIMERFD_CREATE: u64 = 283
const EV_EVENTFD: u64 = 284
const EV_TIMERFD_SETTIME: u64 = 286
const EV_TIMERFD_GETTIME: u64 = 287
const EV_SIGNALFD4: u64 = 289
const EV_EVENTFD2: u64 = 290
const EV_EPOLL_CREATE1: u64 = 291
const EV_INOTIFY_INIT1: u64 = 294
const EV_FLAGS_NONBLOCK: u64 = 2048
const EV_FLAGS_CLOEXEC: u64 = 524288
const EV_SFD_SIZE: u64 = 128
const EV_EPOLL_EVSIZE: u64 = 12

fn ev_kind(kind: u64) -> bool {
    return kind >= file.K_EVENT && kind <= file.K_INOTIFY
}

fn ev_number(n: u64) -> bool {
    // getitimer 36, setitimer 38, rt_sigtimedwait 128, rt_sigsuspend 130, sigaltstack 131 (the bodies are in sched/signal.fi)
    if n == 36 || n == 38 || n == 128 || n == 130 || n == 131 {
        return true
    }
    if n == EV_EPOLL_CREATE || n == EV_EPOLL_WAIT || n == EV_EPOLL_CTL {
        return true
    }
    if n == EV_INOTIFY_INIT || n == EV_INOTIFY_ADD || n == EV_INOTIFY_RM || n == EV_INOTIFY_INIT1 {
        return true
    }
    if n >= EV_EPOLL_PWAIT && n <= EV_EVENTFD {
        return true
    }
    if n == EV_TIMERFD_SETTIME || n == EV_TIMERFD_GETTIME {
        return true
    }
    return n == EV_SIGNALFD4 || n == EV_EVENTFD2 || n == EV_EPOLL_CREATE1
}

// Put a fresh open file into the descriptor table of the caller. `flags` may carry the close-on-exec bit.
fn ev_install(state: u64, me: u64, of: u64, flags: u64) -> u64 {
    if of >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        return neg(errno.E_MFILE)
    }
    file.fd_set(state, me, fd, of)
    return cx_result(state, me, fd, flags & EV_FLAGS_CLOEXEC)
}

// The open file behind `fd` when it is of kind `kind`; MAX_OPEN otherwise (`err` gets the errno).
fn ev_get(state: u64, me: u64, fd: u64, kind: u64, err: *mut u64) -> u64 {
    let of: u64 = of_of(state, me, fd & 0xFFFFFFFF)
    if of >= file.MAX_OPEN {
        *err = errno.E_BADF
        return file.MAX_OPEN
    }
    if file.open_kind(state, of) != kind {
        *err = errno.E_INVAL
        return file.MAX_OPEN
    }
    return of
}

// Readiness bits (POLLIN / POLLOUT ...) of the five kinds.
fn ev_poll(state: u64, me: u64, of: u64, kind: u64) -> u64 {
    if kind == file.K_EVENT {
        return evfd.efd_poll(state, of)
    }
    if kind == file.K_TIMER {
        if evfd.tfd_unread(state, of, kstate.get(state, kstate.TICKS)) != 0 {
            return POLLIN
        }
        return 0
    }
    if kind == file.K_SIGFD {
        if evfd.sfd_ready(state, me, of) != 0 {
            return POLLIN
        }
        return 0
    }
    if kind == file.K_INOTIFY {
        if evfd.in_ready(file.open_off(state, of)) {
            return POLLIN
        }
        return 0
    }
    // epoll: readable while at least one watched descriptor is ready (an epoll inside an epoll is refused at EPOLL_CTL_ADD)
    var bad: u64 = 0
    if ev_ep_scan(state, me, of, 0, 1, false, &bad) != 0 {
        return POLLIN
    }
    return 0
}

// ---------------------------------------------------------------- read / write

// Try once. 0 = nothing there yet (caller waits), else the octets read, or an errno.
fn ev_take(state: u64, me: u64, of: u64, kind: u64, buf: u64, len: u64) -> u64 {
    if kind == file.K_EVENT {
        let v: u64 = evfd.efd_take(state, of)
        if v == 0 {
            return 0
        }
        if !put64(state, me, buf, v) {
            let _r: u64 = evfd.efd_add(state, of, v)
            return neg(errno.E_FAULT)
        }
        sched.poll_kick(state)
        return 8
    }
    if kind == file.K_TIMER {
        let v: u64 = evfd.tfd_take(state, of, kstate.get(state, kstate.TICKS))
        if v == 0 {
            return 0
        }
        if !put64(state, me, buf, v) {
            return neg(errno.E_FAULT)
        }
        return 8
    }
    if kind == file.K_SIGFD {
        var cnt: u64 = len / EV_SFD_SIZE
        if cnt > 8 {
            cnt = 8
        }
        let kb: u64 = blockb(state)
        var n: u64 = 0
        while n < cnt {
            let sig: u64 = evfd.sfd_take(state, me, of)
            if sig == 0 {
                cnt = n
            } else {
                evfd.sfd_fill(kb + n * EV_SFD_SIZE, sig)
                n = n + 1
            }
        }
        if n == 0 {
            return 0
        }
        if !copy_out(state, me, buf, kb, n * EV_SFD_SIZE) {
            return neg(errno.E_FAULT)
        }
        return n * EV_SFD_SIZE
    }
    // inotify: whole events only
    let fr: u64 = file.open_off(state, of)
    let first: u64 = evfd.in_pop_size(fr)
    if first == 0 {
        return 0
    }
    if len < first {
        return neg(errno.E_INVAL)
    }
    let kb: u64 = blockb(state)
    var total: u64 = 0
    var going: bool = true
    while going {
        let sz: u64 = evfd.in_pop_size(fr)
        if sz == 0 || total + sz > len || total + sz > 2048 {
            going = false
        } else {
            let _n: u64 = evfd.in_pop(fr, kb + total)
            total = total + sz
        }
    }
    if !copy_out(state, me, buf, kb, total) {
        return neg(errno.E_FAULT)
    }
    return total
}

fn ev_read(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    let kind: u64 = file.open_kind(state, of)
    if kind == file.K_EPOLL {
        return neg(errno.E_INVAL)
    }
    var need: u64 = 8
    if kind == file.K_SIGFD {
        need = EV_SFD_SIZE
    }
    if kind == file.K_INOTIFY {
        need = 16
    }
    if len < need {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, buf, need) {
        return neg(errno.E_FAULT)
    }
    while true {
        let seen: u64 = sched.poll_seq(state)
        let r: u64 = ev_take(state, me, of, kind, buf, len)
        if r != 0 {
            return r
        }
        if (file.open_flags(state, of) & UB_O_NONBLOCK) != 0 {
            return neg(errno.E_AGAIN)
        }
        if signal.interrupted(state, me) {
            return neg(errno.E_INTR)
        }
        var wake: u64 = sched.POLL_FOREVER
        if kind == file.K_TIMER {
            let nx: u64 = evfd.tfd_next(state, of, kstate.get(state, kstate.TICKS))
            if nx != 0 {
                wake = nx
            }
        }
        sched.poll_sleep(state, seen, wake)
    }
    return neg(errno.E_AGAIN)
}

// Only an eventfd takes a write: it adds to the counter, and waits (or EAGAIN) while the sum would overflow.
fn ev_write(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    if file.open_kind(state, of) != file.K_EVENT || len < 8 {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, buf, 8) {
        return neg(errno.E_FAULT)
    }
    let v: u64 = user_word(state, me, buf)
    if v == 0xFFFFFFFFFFFFFFFF {
        return neg(errno.E_INVAL)
    }
    while true {
        let seen: u64 = sched.poll_seq(state)
        if evfd.efd_add(state, of, v) == 0 {
            return 8
        }
        if (file.open_flags(state, of) & UB_O_NONBLOCK) != 0 {
            return neg(errno.E_AGAIN)
        }
        if signal.interrupted(state, me) {
            return neg(errno.E_INTR)
        }
        sched.poll_sleep(state, seen, sched.POLL_FOREVER)
    }
    return neg(errno.E_AGAIN)
}

// ---------------------------------------------------------------- epoll

// One pass over the watch table of epoll `ofep`. With `report`, up to `max` events are written to user memory `out`
// (struct epoll_event, PACKED, 12 octets: events u32, data u64) and edge / one-shot state is advanced. Returns the number found.
// A watch whose descriptor was closed (or reused) since EPOLL_CTL_ADD is dropped here -- Linux drops it at the last close.
fn ev_ep_scan(state: u64, me: u64, ofep: u64, out: u64, max: u64, report: bool, bad: *mut u64) -> u64 {
    let fr: u64 = file.open_off(state, ofep)
    // Taken BEFORE the look at the descriptors: a kick that comes later is seen by the next scan as "something changed since the last report".
    let seq: u64 = sched.poll_seq(state) & 0xFFFFFFFF
    var n: u64 = 0
    var i: u64 = 0
    while i < evfd.EP_MAX && n < max {
        if evfd.ep_used(fr, i) {
            let w: u64 = evfd.ep_of(fr, i)
            if of_of(state, me, evfd.ep_fd(fr, i)) != w {
                evfd.ep_drop_slot(fr, i)
            } else {
                let ev: u64 = evfd.ep_events(fr, i)
                let live: u64 = ev & 0x3FFFFFFF
                if (ev & evfd.EPOLLONESHOT) != 0 && live == 0 {
                    // a one-shot watch that already fired sleeps until EPOLL_CTL_MOD
                } else {
                    let rdy: u64 = poll_of(state, me, w)
                    if (rdy & POLLNVAL) != 0 {
                        evfd.ep_drop_slot(fr, i)
                    } else {
                        var got: u64 = rdy & (live | POLLERR | POLLHUP)
                        if (live & evfd.EPOLLRDHUP) != 0 && (rdy & POLLHUP) != 0 {
                            got = got | evfd.EPOLLRDHUP
                        }
                        var fresh: u64 = got
                        if (ev & evfd.EPOLLET) != 0 && report {
                            // `last`: low 32 bits = readiness at the last report, high 32 bits = poll_seq at that scan. A descriptor that drained and
                            // refilled between two epoll_wait calls never showed "not ready" to a scan; the kick of the refill (poll_seq moved) is the edge.
                            let last: u64 = evfd.ep_last(fr, i)
                            fresh = got & (0xFFFFFFFF -% (last & 0xFFFFFFFF))
                            if (last / 4294967296) != seq {
                                fresh = got
                            }
                            evfd.ep_set_last(fr, i, got | (seq * 4294967296))
                        }
                        if fresh != 0 {
                            if report {
                                let a: u64 = out + n * EV_EPOLL_EVSIZE
                                if !put32(state, me, a, fresh) || !put64(state, me, a + 4, evfd.ep_data(fr, i)) {
                                    *bad = 1
                                    return n
                                }
                                if (ev & evfd.EPOLLONESHOT) != 0 {
                                    evfd.ep_set_events(fr, i, ev & 0xC0000000)
                                }
                            }
                            n = n + 1
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return n
}

fn do_epoll_create(state: u64, me: u64, flags: u64) -> u64 {
    let of: u64 = evfd.ep_new(state, 0)
    return ev_install(state, me, of, flags)
}

fn do_epoll_ctl(state: u64, me: u64, epfd: u64, op: u64, fd: u64, evp: u64) -> u64 {
    var err: u64 = 0
    let ofep: u64 = ev_get(state, me, epfd, file.K_EPOLL, &err)
    if ofep >= file.MAX_OPEN {
        return neg(err)
    }
    let w: u64 = of_of(state, me, fd & 0xFFFFFFFF)
    if w >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    if w == ofep {
        return neg(errno.E_INVAL)
    }
    let wk: u64 = file.open_kind(state, w)
    if wk == file.K_EPOLL {
        return neg(errno.E_INVAL)
    }
    // ordinary files and directories are always ready: epoll refuses them (EPERM), as Linux does
    if wk == file.K_FILE || wk == file.K_DIR || wk == file.K_VFILE || wk == file.K_VDIR {
        return neg(errno.E_PERM)
    }
    let fr: u64 = file.open_off(state, ofep)
    let wfd: u64 = fd & 0xFFFFFFFF
    if op == evfd.EP_DEL {
        if evfd.ep_del(fr, wfd) != 0 {
            return neg(errno.E_NOENT)
        }
        return 0
    }
    if op != evfd.EP_ADD && op != evfd.EP_MOD {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, evp, EV_EPOLL_EVSIZE) {
        return neg(errno.E_FAULT)
    }
    let events: u64 = get32(state, me, evp)
    let data: u64 = user_word(state, me, evp + 4)
    if op == evfd.EP_ADD {
        let r: u64 = evfd.ep_add(fr, wfd, w, events, data)
        if r == 1 {
            return neg(errno.E_EXIST)
        }
        if r == 2 {
            return neg(errno.E_NOSPC)
        }
    } else {
        if evfd.ep_mod(fr, wfd, events, data) != 0 {
            return neg(errno.E_NOENT)
        }
    }
    // a thread already waiting on this epoll must look again
    sched.poll_kick(state)
    return 0
}

fn do_epoll_wait(state: u64, me: u64, epfd: u64, out: u64, maxev: u64, tmo: u64) -> u64 {
    var err: u64 = 0
    let ofep: u64 = ev_get(state, me, epfd, file.K_EPOLL, &err)
    if ofep >= file.MAX_OPEN {
        return neg(err)
    }
    var max: u64 = maxev & 0xFFFFFFFF
    if max == 0 || max >= 0x80000000 {
        return neg(errno.E_INVAL)
    }
    if max > evfd.EP_MAX {
        max = evfd.EP_MAX
    }
    if !proc.user_ok(state, me, out, max * EV_EPOLL_EVSIZE) {
        return neg(errno.E_FAULT)
    }
    let t: u64 = tmo & 0xFFFFFFFF
    let forever: bool = t >= 0x80000000
    var ticks: u64 = 0
    if !forever && t != 0 {
        // same rounding as poll: never earlier than asked, one extra tick for the tick we are in
        ticks = (t + 9) / 10 + 1
    }
    let deadline: u64 = kstate.get(state, kstate.TICKS) + ticks
    var bad: u64 = 0
    while true {
        let seen: u64 = sched.poll_seq(state)
        let n: u64 = ev_ep_scan(state, me, ofep, out, max, true, &bad)
        if bad != 0 {
            return neg(errno.E_FAULT)
        }
        if n != 0 {
            return n
        }
        if signal.interrupted(state, me) {
            return neg(errno.E_INTR)
        }
        if !forever && kstate.get(state, kstate.TICKS) >= deadline {
            return 0
        }
        var wake: u64 = deadline
        if forever {
            wake = sched.POLL_FOREVER
        }
        sched.poll_sleep(state, seen, wake)
    }
    return 0
}

// ---------------------------------------------------------------- eventfd

fn do_eventfd(state: u64, me: u64, initval: u64, flags: u64) -> u64 {
    if (flags & (0xFFFFFFFF -% (1 | EV_FLAGS_NONBLOCK | EV_FLAGS_CLOEXEC))) != 0 {
        return neg(errno.E_INVAL)
    }
    let of: u64 = evfd.efd_new(state, initval & 0xFFFFFFFF, flags & 1, flags)
    return ev_install(state, me, of, flags)
}

// ---------------------------------------------------------------- timerfd

// A timespec as ticks (10 ms), rounded UP; a nonzero time never becomes zero (zero would mean "disarmed").
fn ev_ticks(sec: u64, nsec: u64) -> u64 {
    if sec == 0 && nsec == 0 {
        return 0
    }
    var s: u64 = sec
    if s > 100000000 {
        s = 100000000
    }
    let t: u64 = (s * 1000 + (nsec + 999999) / 1000000 + 9) / 10
    if t == 0 {
        return 1
    }
    return t
}

// A tick count as a timespec at `addr` (two 64-bit words).
fn ev_put_ts(state: u64, me: u64, addr: u64, ticks: u64) -> bool {
    let ms: u64 = ticks * 10
    return put64(state, me, addr, ms / 1000) && put64(state, me, addr + 8, (ms % 1000) * 1000000)
}

fn do_timerfd_create(state: u64, me: u64, clock: u64, flags: u64) -> u64 {
    // CLOCK_REALTIME 0, CLOCK_MONOTONIC 1, CLOCK_BOOTTIME 7: all run on the one tick counter here
    if clock != 0 && clock != 1 && clock != 7 {
        return neg(errno.E_INVAL)
    }
    if (flags & (0xFFFFFFFF -% (EV_FLAGS_NONBLOCK | EV_FLAGS_CLOEXEC))) != 0 {
        return neg(errno.E_INVAL)
    }
    return ev_install(state, me, evfd.tfd_new(state, flags), flags)
}

fn do_timerfd_settime(state: u64, me: u64, fd: u64, flags: u64, newp: u64, oldp: u64) -> u64 {
    var err: u64 = 0
    let of: u64 = ev_get(state, me, fd, file.K_TIMER, &err)
    if of >= file.MAX_OPEN {
        return neg(err)
    }
    if !proc.user_ok(state, me, newp, 32) {
        return neg(errno.E_FAULT)
    }
    let isec: u64 = user_word(state, me, newp)
    let insec: u64 = user_word(state, me, newp + 8)
    let vsec: u64 = user_word(state, me, newp + 16)
    let vnsec: u64 = user_word(state, me, newp + 24)
    if insec >= 1000000000 || vnsec >= 1000000000 || isec >= 0x8000000000000000 || vsec >= 0x8000000000000000 {
        return neg(errno.E_INVAL)
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if oldp != 0 {
        if !proc.user_ok(state, me, oldp, 32) {
            return neg(errno.E_FAULT)
        }
        let _a: bool = ev_put_ts(state, me, oldp, evfd.tfd_interval(state, of))
        let _b: bool = ev_put_ts(state, me, oldp + 16, evfd.tfd_left(state, of, now))
    }
    let iv: u64 = ev_ticks(isec, insec)
    let val: u64 = ev_ticks(vsec, vnsec)
    if val == 0 {
        evfd.tfd_set(state, of, 0, 0)
        return 0
    }
    var first: u64 = now + val
    if (flags & 1) != 0 {
        // TFD_TIMER_ABSTIME: the time is on the tick counter's own scale (ticks since boot)
        first = val
        if first < now {
            first = now
        }
    }
    evfd.tfd_set(state, of, first, iv)
    return 0
}

fn do_timerfd_gettime(state: u64, me: u64, fd: u64, curp: u64) -> u64 {
    var err: u64 = 0
    let of: u64 = ev_get(state, me, fd, file.K_TIMER, &err)
    if of >= file.MAX_OPEN {
        return neg(err)
    }
    if !proc.user_ok(state, me, curp, 32) {
        return neg(errno.E_FAULT)
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if !ev_put_ts(state, me, curp, evfd.tfd_interval(state, of))
        || !ev_put_ts(state, me, curp + 16, evfd.tfd_left(state, of, now)) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// ---------------------------------------------------------------- signalfd

// signalfd4(fd, mask, sizemask, flags): fd -1 makes a new descriptor, another one changes the mask of an existing signalfd.
fn do_signalfd(state: u64, me: u64, fd: u64, maskp: u64, size: u64, flags: u64) -> u64 {
    if size != 8 {
        return neg(errno.E_INVAL)
    }
    if (flags & (0xFFFFFFFF -% (EV_FLAGS_NONBLOCK | EV_FLAGS_CLOEXEC))) != 0 {
        return neg(errno.E_INVAL)
    }
    if !proc.user_ok(state, me, maskp, 8) {
        return neg(errno.E_FAULT)
    }
    // SIGKILL and SIGSTOP can not be taken
    let mask: u64 = user_word(state, me, maskp) & (0xFFFFFFFFFFFFFFFF -% ((1 << (signal.SIGKILL - 1)) | (1 << (signal.SIGSTOP - 1))))
    if (fd & 0xFFFFFFFF) == 0xFFFFFFFF {
        return ev_install(state, me, evfd.sfd_new(state, mask, flags), flags)
    }
    var err: u64 = 0
    let of: u64 = ev_get(state, me, fd, file.K_SIGFD, &err)
    if of >= file.MAX_OPEN {
        return neg(err)
    }
    evfd.sfd_set_mask(state, of, mask)
    sched.poll_kick(state)
    return fd & 0xFFFFFFFF
}

// ---------------------------------------------------------------- inotify

fn do_inotify_init(state: u64, me: u64, flags: u64) -> u64 {
    if (flags & (0xFFFFFFFF -% (EV_FLAGS_NONBLOCK | EV_FLAGS_CLOEXEC))) != 0 {
        return neg(errno.E_INVAL)
    }
    return ev_install(state, me, evfd.in_new(state, flags), flags)
}

fn do_inotify_add(state: u64, me: u64, fd: u64, path: u64, mask: u64) -> u64 {
    var err: u64 = 0
    let of: u64 = ev_get(state, me, fd, file.K_INOTIFY, &err)
    if of >= file.MAX_OPEN {
        return neg(err)
    }
    if (mask & 0xFFF) == 0 {
        return neg(errno.E_INVAL)
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, path, buf, MAX_NAME)
    if errno.is_error(len) {
        return len
    }
    if len > evfd.IN_PATHMAX {
        return neg(errno.E_NAMETOOLONG)
    }
    let wd: u64 = evfd.in_add(file.open_off(state, of), buf, len, mask)
    if wd == 0 {
        return neg(errno.E_NOSPC)
    }
    return wd
}

fn do_inotify_rm(state: u64, me: u64, fd: u64, wd: u64) -> u64 {
    var err: u64 = 0
    let of: u64 = ev_get(state, me, fd, file.K_INOTIFY, &err)
    if of >= file.MAX_OPEN {
        return neg(err)
    }
    if !evfd.in_rm(file.open_off(state, of), wd & 0xFFFFFFFF) {
        return neg(errno.E_INVAL)
    }
    return 0
}

// ---------------------------------------------------------------- inotify events from the file system calls

const IN_CREATE: u64 = 0x100
const IN_DELETE: u64 = 0x200
const IN_MOVED_FROM: u64 = 0x40
const IN_MOVED_TO: u64 = 0x80
const IN_ISDIR: u64 = 0x40000000

// Is any inotify instance open? (The hooks cost nothing else when nobody watches.)
fn ev_in_any(state: u64) -> bool {
    var i: u64 = 0
    while i < file.MAX_OPEN {
        if file.open_kind(state, i) == file.K_INOTIFY {
            return true
        }
        i = i + 1
    }
    return false
}

// Tell every inotify instance that watches the PARENT directory of `buf` (absolute path in kernel memory, `len` octets) about event `ev`.
fn ev_in_fire(state: u64, buf: u64, len: u64, ev: u64, cookie: u64) {
    var s: u64 = len
    while s > 0 {
        if rd8_ev(buf + s - 1) == 47 {
            break
        }
        s = s - 1
    }
    if s == 0 || s >= len {
        return
    }
    var dlen: u64 = s - 1
    if dlen == 0 {
        dlen = 1
    }
    let name: u64 = buf + s
    let nlen: u64 = len - s
    var o: u64 = 0
    while o < file.MAX_OPEN {
        if file.open_kind(state, o) == file.K_INOTIFY {
            let fr: u64 = file.open_off(state, o)
            var i: u64 = 0
            while i < evfd.IN_WMAX {
                let mask: u64 = evfd.in_match(fr, i, buf, dlen)
                if mask != 0 && (mask & ev & 0xFFF) != 0 {
                    evfd.in_push(state, fr, evfd.in_wd_of(fr, i), ev, cookie, name, nlen)
                }
                i = i + 1
            }
        }
        o = o + 1
    }
}

fn rd8_ev(a: u64) -> u64 {
    return kstate.get8(a)
}

// The path the user pointer names, as the file system call just saw it.
fn ev_in_path(state: u64, me: u64, addr: u64, ev: u64, cookie: u64) {
    if !ev_in_any(state) {
        return
    }
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, addr, buf, MAX_NAME)
    if errno.is_error(len) {
        return
    }
    ev_in_fire(state, buf, len, ev, cookie)
}

fn ev_in_rename(state: u64, me: u64, from: u64, to: u64) {
    if !ev_in_any(state) {
        return
    }
    let cookie: u64 = sched.poll_seq(state) + 1
    uio.next_base(state, me) // r821: do_rename left the second base current; back to the first for the source
    ev_in_path(state, me, from, IN_MOVED_FROM, cookie)
    uio.next_base(state, me)
    ev_in_path(state, me, to, IN_MOVED_TO, cookie)
}

fn ev_path_exists(state: u64, buf: u64) -> bool {
    if vfs.ready(state) {
        let m: u64 = vfs.mount_for(state, buf)
        if m < vfs.MAX_MNT {
            if m != 0 || vfs.all_mode(state) {
                return vfs.node_for(state, m, buf) != 0
            }
        }
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return true
    }
    return fs.path(state, buf) != 0
}

// open(path, O_CREAT ...): IN_CREATE only when the file was not there before.
fn ev_open_create(state: u64, me: u64, name: u64, flags: u64, mode: u64) -> u64 {
    let buf: u64 = nameb(state)
    let len: u64 = fetch_path(state, me, name, buf, MAX_NAME)
    var existed: bool = true
    if !errno.is_error(len) && len != 0 {
        existed = ev_path_exists(state, buf)
    }
    let r: u64 = do_open_mode(state, me, name, flags, mode)
    if !existed && !errno.is_error(r) {
        ev_in_path(state, me, name, IN_CREATE, 0)
    }
    return cx_result(state, me, r, flags)
}

// ---------------------------------------------------------------- dispatch

fn do_events(state: u64, me: u64, n: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    if n == 36 {
        return signal.do_getitimer(state, me, a0, a1)
    }
    if n == 38 {
        return signal.do_setitimer(state, me, a0, a1, a2)
    }
    if n == 128 {
        return signal.do_sigtimedwait(state, me, a0, a1, a2, a3)
    }
    if n == 130 {
        return signal.do_sigsuspend(state, me, a0, a1)
    }
    if n == 131 {
        return signal.do_sigaltstack(state, me, a0, a1)
    }
    if n == EV_EPOLL_CREATE {
        if (a0 & 0xFFFFFFFF) == 0 || (a0 & 0xFFFFFFFF) >= 0x80000000 {
            return neg(errno.E_INVAL)
        }
        return do_epoll_create(state, me, 0)
    }
    if n == EV_EPOLL_CREATE1 {
        if (a0 & 0xFFFFFFFF) != 0 && (a0 & 0xFFFFFFFF) != EV_FLAGS_CLOEXEC {
            return neg(errno.E_INVAL)
        }
        return do_epoll_create(state, me, a0)
    }
    if n == EV_EPOLL_CTL {
        return do_epoll_ctl(state, me, a0, a1 & 0xFFFFFFFF, a2, a3)
    }
    if n == EV_EPOLL_WAIT || n == EV_EPOLL_PWAIT {
        return do_epoll_wait(state, me, a0, a1, a2, a3)
    }
    if n == EV_EVENTFD {
        return do_eventfd(state, me, a0, 0)
    }
    if n == EV_EVENTFD2 {
        return do_eventfd(state, me, a0, a1 & 0xFFFFFFFF)
    }
    if n == EV_TIMERFD_CREATE {
        return do_timerfd_create(state, me, a0 & 0xFFFFFFFF, a1 & 0xFFFFFFFF)
    }
    if n == EV_TIMERFD_SETTIME {
        return do_timerfd_settime(state, me, a0, a1 & 0xFFFFFFFF, a2, a3)
    }
    if n == EV_TIMERFD_GETTIME {
        return do_timerfd_gettime(state, me, a0, a1)
    }
    if n == EV_SIGNALFD {
        return do_signalfd(state, me, a0, a1, a2, 0)
    }
    if n == EV_SIGNALFD4 {
        return do_signalfd(state, me, a0, a1, a2, a3 & 0xFFFFFFFF)
    }
    if n == EV_INOTIFY_INIT {
        return do_inotify_init(state, me, 0)
    }
    if n == EV_INOTIFY_INIT1 {
        return do_inotify_init(state, me, a0 & 0xFFFFFFFF)
    }
    if n == EV_INOTIFY_ADD {
        return do_inotify_add(state, me, a0, a1, a2 & 0xFFFFFFFF)
    }
    return do_inotify_rm(state, me, a0, a1)
}

// ==================================================================
// ROUND NETLINK (r696): AF_NETLINK / NETLINK_ROUTE. The message formats and the answers are in net/netlink.fi; this block is the system
// calls around it (user memory, blocking, descriptors). A request is answered inside the call that carries it, so a read finds the
// reply already in the ring of the socket.
// ==================================================================
const NL_MSG_PEEK: u64 = 2
const NL_MSG_TRUNC: u64 = 32
const NL_SA_BYTES: u64 = 12 // struct sockaddr_nl: family (2), pad (2), pid (4), groups (4)

// The open file behind `fd` when it is a netlink socket; MAX_OPEN otherwise.
fn nl_of(state: u64, me: u64, fd: u64) -> u64 {
    let of: u64 = of_of(state, me, fd)
    if of >= file.MAX_OPEN {
        return file.MAX_OPEN
    }
    if file.open_kind(state, of) != file.K_NETLINK {
        return file.MAX_OPEN
    }
    return of
}

fn do_nlsocket(state: u64, me: u64, kind: u64, protocol: u64) -> u64 {
    let base: u64 = kind & 0xFF
    if base != 3 && base != SOCK_DGRAM {
        return neg(errno.E_PROTONOSUPPORT)
    }
    if protocol != netlink.NETLINK_ROUTE {
        return neg(errno.E_PROTONOSUPPORT)
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        return neg(errno.E_MFILE)
    }
    let of: u64 = netlink.nl_new(state, kind & SOCK_NONBLOCK)
    if of >= file.MAX_OPEN {
        return neg(errno.E_NFILE)
    }
    file.fd_set(state, me, fd, of)
    return fd
}

// Hand the kernel copy of a request to the answering code. `ret` is what the call returns on success.
fn nl_run(state: u64, of: u64, kb: u64, total: u64) -> u64 {
    let r: u64 = netlink.nl_request(state, file.open_off(state, of), kb, total)
    if r != 0 {
        return neg(r)
    }
    sched.poll_kick(state)
    return total
}

fn nl_send_of(state: u64, me: u64, of: u64, buf: u64, len: u64) -> u64 {
    if len == 0 {
        return 0
    }
    if len > 4096 {
        return neg(errno.E_MSGSIZE)
    }
    let bo: u64 = blockb(state)
    if !copy_in(state, me, bo, buf, len) {
        return neg(errno.E_FAULT)
    }
    return nl_run(state, of, bo, len)
}

fn nl_sendmsg(state: u64, me: u64, of: u64, mh: u64) -> u64 {
    if !proc.user_ok(state, me, mh, MH_BYTES) {
        return neg(errno.E_FAULT)
    }
    let iov: u64 = get64u(state, me, mh + MH_IOV)
    let iovlen: u64 = get64u(state, me, mh + MH_IOVLEN)
    if iovlen > 64 {
        return neg(errno.E_MSGSIZE)
    }
    let bo: u64 = blockb(state)
    var total: u64 = 0
    var v: u64 = 0
    while v < iovlen {
        if !proc.user_ok(state, me, iov + v * 16, 16) {
            return neg(errno.E_FAULT)
        }
        let base: u64 = get64u(state, me, iov + v * 16)
        let blen: u64 = get64u(state, me, iov + v * 16 + 8)
        if blen > 4096 || total + blen > 4096 {
            return neg(errno.E_MSGSIZE)
        }
        if blen != 0 {
            if !copy_in(state, me, bo + total, base, blen) {
                return neg(errno.E_FAULT)
            }
        }
        total = total + blen
        v = v + 1
    }
    return nl_run(state, of, bo, total)
}

// Wait until a datagram is there (0), or the errno to give back.
fn nl_wait(state: u64, me: u64, of: u64, flags: u64) -> u64 {
    let fr: u64 = file.open_off(state, of)
    var waited: u64 = 0
    while !netlink.nl_pending(fr) {
        if (flags & MSG_DONTWAIT) != 0 || (file.open_flags(state, of) & UB_O_NONBLOCK) != 0 {
            return neg(errno.E_AGAIN)
        }
        if signal.interrupted(state, me) {
            return neg(errno.E_INTR)
        }
        if waited >= NET_ROUNDS {
            return neg(errno.E_AGAIN)
        }
        waited = waited + 1
        sched.sleep_ticks(state, 1)
    }
    return 0
}

// The sockaddr_nl of the kernel (pid 0, no groups) into the caller's memory, cut to `room` octets.
fn nl_name_out(state: u64, me: u64, addr: u64, room: u64, pid: u64) -> bool {
    let bo: u64 = blockb(state)
    var i: u64 = 0
    while i < NL_SA_BYTES {
        kstate.set8(bo + i, 0 as u8)
        i = i + 1
    }
    kstate.set8(bo, netlink.AF_NETLINK as u8)
    kstate.set8(bo + 4, (pid & 0xFF) as u8)
    kstate.set8(bo + 5, ((pid >> 8) & 0xFF) as u8)
    kstate.set8(bo + 6, ((pid >> 16) & 0xFF) as u8)
    kstate.set8(bo + 7, ((pid >> 24) & 0xFF) as u8)
    var n: u64 = NL_SA_BYTES
    if room < n {
        n = room
    }
    if n == 0 {
        return true
    }
    return copy_out(state, me, addr, bo, n)
}

// recv / recvfrom / read: one datagram per call; what does not fit is dropped (MSG_TRUNC says the full length), MSG_PEEK leaves it there.
fn nl_recv_of(state: u64, me: u64, of: u64, buf: u64, want: u64, flags: u64, addr: u64, lenp: u64) -> u64 {
    let w: u64 = nl_wait(state, me, of, flags)
    if w != 0 {
        return w
    }
    let fr: u64 = file.open_off(state, of)
    let rl: u64 = netlink.nl_head_len(fr)
    var n: u64 = rl
    if want < n {
        n = want
    }
    if n > 0 {
        if !copy_out(state, me, buf, netlink.nl_head_ptr(fr), n) {
            return neg(errno.E_FAULT)
        }
    }
    if addr != 0 {
        var room: u64 = NL_SA_BYTES
        if lenp != 0 {
            if !proc.user_ok(state, me, lenp, 4) {
                return neg(errno.E_FAULT)
            }
            room = get32(state, me, lenp)
        }
        if !nl_name_out(state, me, addr, room, 0) {
            return neg(errno.E_FAULT)
        }
        if lenp != 0 {
            if !put32(state, me, lenp, NL_SA_BYTES) {
                return neg(errno.E_FAULT)
            }
        }
    }
    if (flags & NL_MSG_PEEK) == 0 {
        netlink.nl_pop(fr)
    }
    if (flags & NL_MSG_TRUNC) != 0 {
        return rl
    }
    return n
}

fn nl_recvmsg(state: u64, me: u64, of: u64, mh: u64, flags: u64) -> u64 {
    if !proc.user_ok(state, me, mh, MH_BYTES) {
        return neg(errno.E_FAULT)
    }
    let w: u64 = nl_wait(state, me, of, flags)
    if w != 0 {
        return w
    }
    let iov: u64 = get64u(state, me, mh + MH_IOV)
    let iovlen: u64 = get64u(state, me, mh + MH_IOVLEN)
    if iovlen > 64 {
        return neg(errno.E_MSGSIZE)
    }
    let fr: u64 = file.open_off(state, of)
    let rl: u64 = netlink.nl_head_len(fr)
    let src: u64 = netlink.nl_head_ptr(fr)
    var got: u64 = 0
    var v: u64 = 0
    while v < iovlen && got < rl {
        if !proc.user_ok(state, me, iov + v * 16, 16) {
            return neg(errno.E_FAULT)
        }
        let base: u64 = get64u(state, me, iov + v * 16)
        let blen: u64 = get64u(state, me, iov + v * 16 + 8)
        var chunk: u64 = blen
        if chunk > rl - got {
            chunk = rl - got
        }
        if chunk != 0 {
            if !copy_out(state, me, base, src + got, chunk) {
                return neg(errno.E_FAULT)
            }
        }
        got = got + chunk
        v = v + 1
    }
    // The sender's address: the kernel (pid 0). busybox checks that msg_namelen is exactly sizeof(sockaddr_nl).
    let np: u64 = get64u(state, me, mh)
    if np != 0 {
        let room: u64 = get32(state, me, mh + 8)
        if !nl_name_out(state, me, np, room, 0) {
            return neg(errno.E_FAULT)
        }
        if !put32(state, me, mh + 8, NL_SA_BYTES) {
            return neg(errno.E_FAULT)
        }
    }
    if !put64(state, me, mh + MH_CONTROLLEN, 0) {
        return neg(errno.E_FAULT)
    }
    var mf: u64 = 0
    if got < rl {
        mf = NL_MSG_TRUNC
    }
    if !put32(state, me, mh + MH_FLAGS, mf) {
        return neg(errno.E_FAULT)
    }
    if (flags & NL_MSG_PEEK) == 0 {
        netlink.nl_pop(fr)
    }
    if (flags & NL_MSG_TRUNC) != 0 {
        return rl
    }
    return got
}

// bind: the port id. 0 means "give me one": the pid of the caller, as Linux does for the first socket of a process. Groups (multicast) are
// accepted and never delivered -- there are no events to deliver yet.
fn nl_bind(state: u64, me: u64, of: u64, addr: u64, len: u64) -> u64 {
    if addr == 0 || len < NL_SA_BYTES {
        return neg(errno.E_INVAL)
    }
    let bo: u64 = blockb(state)
    if !copy_in(state, me, bo, addr, NL_SA_BYTES) {
        return neg(errno.E_FAULT)
    }
    let fam: u64 = (kstate.get8(bo) as u64) | ((kstate.get8(bo + 1) as u64) << 8)
    if fam != netlink.AF_NETLINK {
        return neg(errno.E_INVAL)
    }
    var pid: u64 = (kstate.get8(bo + 4) as u64) | ((kstate.get8(bo + 5) as u64) << 8)
        | ((kstate.get8(bo + 6) as u64) << 16) | ((kstate.get8(bo + 7) as u64) << 24)
    if pid == 0 {
        pid = sched.tget(state, me, sched.T_PID)
    }
    netlink.nl_set_pid(file.open_off(state, of), pid)
    return 0
}

fn nl_sockname(state: u64, me: u64, of: u64, addr: u64, lenp: u64, peer: bool) -> u64 {
    if addr == 0 {
        return neg(errno.E_FAULT)
    }
    var room: u64 = NL_SA_BYTES
    if lenp != 0 {
        if !proc.user_ok(state, me, lenp, 4) {
            return neg(errno.E_FAULT)
        }
        room = get32(state, me, lenp)
    }
    var pid: u64 = 0
    if !peer {
        pid = netlink.nl_pid(file.open_off(state, of))
    }
    if !nl_name_out(state, me, addr, room, pid) {
        return neg(errno.E_FAULT)
    }
    if lenp != 0 {
        if !put32(state, me, lenp, NL_SA_BYTES) {
            return neg(errno.E_FAULT)
        }
    }
    return 0
}

// getsockopt on a netlink socket: the buffer sizes Linux starts with, no pending error; anything else is -ENOPROTOOPT.
fn nl_getsockopt(state: u64, me: u64, level: u64, name: u64, val: u64, lenp: u64) -> u64 {
    if !proc.user_ok(state, me, lenp, 4) {
        return neg(errno.E_FAULT)
    }
    if get32(state, me, lenp) < 4 {
        return neg(errno.E_INVAL)
    }
    var v: u64 = 0
    var known: bool = false
    if level == SOL_SOCKET {
        if name == 2 || name == 4 || name == 9 || name == 30 {
            known = true
        }
        if name == 3 {
            known = true
            v = 3
        }
        if name == 7 || name == 8 {
            known = true
            v = 212992
        }
    }
    if !known {
        return neg(errno.E_NOPROTOOPT)
    }
    if !put32(state, me, val, v) || !put32(state, me, lenp, 4) {
        return neg(errno.E_FAULT)
    }
    return 0
}

// ---------------------------------------------------------------- RUNDE LC4: the `*at` family
const LC_OPENAT: u64 = 257
const LC_MKDIRAT: u64 = 258
const LC_NEWFSTATAT: u64 = 262
const LC_UNLINKAT: u64 = 263
const LC_RENAMEAT: u64 = 264
const LC_LINKAT: u64 = 265
const LC_SYMLINKAT: u64 = 266
const LC_READLINKAT: u64 = 267
const LC_RENAMEAT2: u64 = 316
const LC_AT_FDCWD32: u64 = 0xFFFFFF9C // -100 as an int (a caller may or may not sign-extend it to 64 bit)
const LC_AT_SYMLINK_NOFOLLOW: u64 = 0x100
const LC_AT_REMOVEDIR: u64 = 0x200
const LC_AT_EMPTY_PATH: u64 = 0x1000

fn do_statx(state: u64, me: u64, dirfd: u64, path: u64, flags: u64, out: u64) -> u64 {
    if !proc.user_ok(state, me, out, statxconv.STATX_BYTES) {
        return neg(errno.E_FAULT)
    }
    let r: u64 = lc_at(state, me, LC_NEWFSTATAT, dirfd, path, out, flags, 0)
    if r != 0 {
        return r
    }
    let dst: u64 = blockb(state) + 3072
    statxconv.convert(blockb(state) + 2048, dst)
    if !copy_out(state, me, out, dst, statxconv.STATX_BYTES) {
        return neg(errno.E_FAULT)
    }
    return 0
}

fn lc_is_at(number: u64) -> bool {
    if number >= LC_OPENAT && number <= LC_READLINKAT {
        if number == 259 || number == 260 || number == 261 {
            return false // mknodat, fchownat (existing), futimesat
        }
        return true
    }
    return number == LC_RENAMEAT2
}

// r807: directory descriptors. An *at call whose path is relative and whose dirfd is a real descriptor is resolved against the
// path that the directory descriptor remembered at open time (`dirpath_remember`); `uio.resolve` reads it from the task slot
// (`uio.set_atbase`). The base is set before the worker function runs and cleared after it.
const AT_REL_NONE: u64 = 0 // absolute path (or a pointer the callee will reject): the directory argument is not used
const AT_REL_CWD: u64 = 1 // relative to AT_FDCWD
const AT_REL_DIR: u64 = 2 // relative to a real directory descriptor

fn at_class(state: u64, me: u64, dirfd: u64, path: u64) -> u64 {
    if !proc.user_ok(state, me, path, 1) {
        return AT_REL_NONE
    }
    if peek(state, me, path) == 47 {
        return AT_REL_NONE
    }
    if (dirfd & 0xFFFFFFFF) == LC_AT_FDCWD32 {
        return AT_REL_CWD
    }
    return AT_REL_DIR
}

// The frame with the path of a directory descriptor, or a negative errno.
fn at_dir_frame(state: u64, me: u64, dirfd: u64) -> u64 {
    let of: u64 = of_of(state, me, dirfd & 0xFFFFFFFF)
    if of >= file.MAX_OPEN {
        return neg(errno.E_BADF)
    }
    let k: u64 = file.open_kind(state, of)
    if k != file.K_DIR && k != file.K_VDIR {
        return neg(errno.E_NOTDIR)
    }
    let fr: u64 = file.open_x1(state, of)
    if fr == 0 {
        return neg(errno.E_NOSYS)
    }
    return fr
}

fn at_enter1(state: u64, me: u64, dirfd: u64, path: u64) -> u64 {
    if at_class(state, me, dirfd, path) != AT_REL_DIR {
        return 0
    }
    let fr: u64 = at_dir_frame(state, me, dirfd)
    if errno.is_error(fr) {
        return fr
    }
    uio.set_atbase(state, me, fr)
    return 0
}

fn at_same_path(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while i < uio.PATH_MAX {
        let x: u64 = kstate.get8(a + i)
        if x != kstate.get8(b + i) {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

// Two paths with a directory argument each (renameat, linkat). r821: the two directories may differ (a real descriptor next to
// the cwd, or two different descriptors). The worker function takes its first path from the first base and calls
// `uio.next_base` before the second fetch (`do_link`, `do_rename`, `ev_in_rename`).
fn at_enter2(state: u64, me: u64, d1: u64, p1: u64, d2: u64, p2: u64) -> u64 {
    let c1: u64 = at_class(state, me, d1, p1)
    let c2: u64 = at_class(state, me, d2, p2)
    if c1 != AT_REL_DIR && c2 != AT_REL_DIR {
        return 0
    }
    var f1: u64 = 0
    var f2: u64 = 0
    if c1 == AT_REL_DIR {
        f1 = at_dir_frame(state, me, d1)
        if errno.is_error(f1) {
            return f1
        }
    }
    if c2 == AT_REL_DIR {
        f2 = at_dir_frame(state, me, d2)
        if errno.is_error(f2) {
            return f2
        }
    }
    uio.set_atbase(state, me, f1)
    if f1 != f2 && !(f1 != 0 && f2 != 0 && at_same_path(f1, f2)) {
        if f2 == 0 {
            uio.set_atbase2(state, me, 1)
        } else {
            uio.set_atbase2(state, me, f2)
        }
    }
    return 0
}

// A directory descriptor remembers the absolute path it was opened with (in a frame of its own, address in OF_X1; freed by
// `file.open_teardown`). Inside a chroot / container the jail prefix is cut off, like for the working directory.
fn dirpath_remember(state: u64, me: u64, of: u64, path: u64) {
    let fr: u64 = mem.frame_alloc(state)
    if fr == 0 {
        return
    }
    var skip: u64 = ctr.prefix_len(state, me, path)
    var n: u64 = 0
    while n < uio.PATH_MAX && kstate.get8(path + skip + n) != 0 {
        kstate.set8(fr + n, kstate.get8(path + skip + n) as u8)
        n = n + 1
    }
    if n == 0 {
        kstate.set8(fr, 47 as u8)
        n = 1
    }
    kstate.set8(fr + n, 0 as u8)
    file.open_set_x1(state, of, fr)
}

fn lc_at(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    var en: u64 = 0
    if number == LC_SYMLINKAT {
        en = at_enter1(state, me, a1, a2)
    } else if number == LC_RENAMEAT || number == LC_RENAMEAT2 || number == LC_LINKAT {
        en = at_enter2(state, me, a0, a1, a2, a3)
    } else if number == LC_NEWFSTATAT && (a3 & LC_AT_EMPTY_PATH) != 0 && proc.user_ok(state, me, a1, 1)
        && peek(state, me, a1) == 0 {
        en = 0 // fstat(dirfd) itself: no base
    } else {
        en = at_enter1(state, me, a0, a1)
    }
    if errno.is_error(en) {
        return en
    }
    let r: u64 = lc_at_inner(state, me, number, a0, a1, a2, a3, a4)
    uio.set_atbase(state, me, 0)
    return r
}

fn lc_at_inner(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    if number == LC_SYMLINKAT {
        // symlinkat(target, newdirfd, linkpath)
        return do_symlink(state, me, a0, a2)
    }
    if number == LC_RENAMEAT || number == LC_RENAMEAT2 || number == LC_LINKAT {
        // (olddirfd, oldpath, newdirfd, newpath [, flags])
        if number == LC_LINKAT {
            return do_link(state, me, a1, a3)
        }
        if number == LC_RENAMEAT2 && a4 != 0 {
            return neg(errno.E_INVAL) // RENAME_NOREPLACE / EXCHANGE / WHITEOUT are not supported
        }
        let r: u64 = do_rename(state, me, a1, a3)
        if r == 0 {
            ev_in_rename(state, me, a1, a3)
        }
        return r
    }
    // the rest: (dirfd, path, ...)
    if number == LC_NEWFSTATAT && (a3 & LC_AT_EMPTY_PATH) != 0 {
        if proc.user_ok(state, me, a1, 1) && peek(state, me, a1) == 0 {
            return do_fstat(state, me, a0, a2)
        }
    }
    if number == LC_OPENAT {
        if (a2 & 64) != 0 && ev_in_any(state) {
            return ev_open_create(state, me, a1, a2, a3)
        }
        return cx_result(state, me, do_open_mode(state, me, a1, a2, a3), a2)
    }
    if number == LC_MKDIRAT {
        let r: u64 = do_mkdir_mode(state, me, a1, a2)
        if r == 0 {
            ev_in_path(state, me, a1, IN_CREATE | IN_ISDIR, 0)
        }
        return r
    }
    if number == LC_NEWFSTATAT {
        if (a3 & LC_AT_SYMLINK_NOFOLLOW) != 0 {
            return do_lstat(state, me, a1, a2)
        }
        return do_stat(state, me, a1, a2)
    }
    if number == LC_UNLINKAT {
        if (a2 & LC_AT_REMOVEDIR) != 0 {
            let rr: u64 = do_rmdir(state, me, a1)
            if rr == 0 {
                ev_in_path(state, me, a1, IN_DELETE | IN_ISDIR, 0)
            }
            return rr
        }
        let ur: u64 = do_unlink(state, me, a1)
        if ur == 0 {
            ev_in_path(state, me, a1, IN_DELETE, 0)
        }
        return ur
    }
    if number == LC_READLINKAT {
        return do_readlink(state, me, a1, a2, a3)
    }
    return neg(errno.E_NOSYS)
}
