import lib.kstate
import lib.errno
import arch.cpu
import mm.mmframe
import sched.proc.procbase
import sched.proc.procfault
import sys.sysuser
import libc.regio

export {
    fetch, fetch_n, release, buf, argc, WORDS
}

const WORDS: u64 = 3
const W_BUF: u64 = 0
const W_ARGC: u64 = 1
const W_BIG: u64 = 2
const WORD_BYTES: u64 = 8
const UNTIL_NULL: u64 = 0xFFFFFFFFFFFFFFFF
const BIG_FRAMES: u64 = procbase.EXEC_TOTAL_MAX / mmframe.FRAME_SIZE

fn buf(st: u64) -> u64 {
    return regio.read64_at(st, W_BUF * WORD_BYTES)
}

fn argc(st: u64) -> u64 {
    return regio.read64_at(st, W_ARGC * WORD_BYTES)
}

fn release(state: u64, st: u64) {
    let big: u64 = regio.read64_at(st, W_BIG * WORD_BYTES)
    if big != 0 {
        mmframe.frame_free_run(state, big, BIG_FRAMES)
        regio.write64_at(st, W_BIG * WORD_BYTES, 0)
    }
}

fn grow(state: u64, st: u64, used: u64) -> bool {
    let big: u64 = mmframe.frame_run(state, BIG_FRAMES)
    if big == 0 {
        return false
    }
    let small: u64 = buf(st)
    var i: u64 = 0
    while i < used {
        kstate.set8(big + i, kstate.get8(small + i) as u8)
        i = i + 1
    }
    regio.write64_at(st, W_BUF * WORD_BYTES, big)
    regio.write64_at(st, W_BIG * WORD_BYTES, big)
    return true
}

fn too_big(state: u64, st: u64) -> u64 {
    release(state, st)
    return sysuser.neg(errno.E_2BIG)
}

fn fail(state: u64, st: u64, e: u64) -> u64 {
    release(state, st)
    return e
}

fn arg_room(cap: u64, at: u64) -> u64 {
    let room: u64 = cap - at
    if room > procbase.EXEC_STR_MAX {
        return procbase.EXEC_STR_MAX
    }
    return room
}

fn fetch_one(state: u64, me: u64, st: u64, p: u64, at: u64) -> u64 {
    let too_long: u64 = sysuser.neg(errno.E_NAMETOOLONG)
    var cap: u64 = kstate.EARG_MAX
    if regio.read64_at(st, W_BIG * WORD_BYTES) != 0 {
        cap = procbase.EXEC_TOTAL_MAX
    }
    var n: u64 = sysuser.fetch_name(state, me, p, buf(st) + at, arg_room(cap, at))
    if n != too_long {
        return n
    }
    if cap == procbase.EXEC_TOTAL_MAX {
        return sysuser.neg(errno.E_2BIG)
    }
    if !grow(state, st, at) {
        return sysuser.neg(errno.E_NOMEM)
    }
    n = sysuser.fetch_name(state, me, p, buf(st) + at, arg_room(procbase.EXEC_TOTAL_MAX, at))
    if n == too_long {
        return sysuser.neg(errno.E_2BIG)
    }
    return n
}

fn gather(state: u64, me: u64, argv: u64, st: u64, declared: u64) -> u64 {
    regio.write64_at(st, W_BUF * WORD_BYTES, cpu.earg_buf(state))
    regio.write64_at(st, W_ARGC * WORD_BYTES, 0)
    regio.write64_at(st, W_BIG * WORD_BYTES, 0)
    if (argv == 0 && declared == UNTIL_NULL) || declared == 0 {
        return 0
    }
    var at: u64 = 0
    var count: u64 = 0
    while count <= procbase.MAX_EXEC_ARGS {
        if count == declared {
            regio.write64_at(st, W_ARGC * WORD_BYTES, count)
            return 0
        }
        if !procfault.user_ok(state, me, argv + count * WORD_BYTES, WORD_BYTES) {
            return fail(state, st, sysuser.neg(errno.E_FAULT))
        }
        let p: u64 = sysuser.user_word(state, me, argv + count * WORD_BYTES)
        if p == 0 && declared == UNTIL_NULL {
            regio.write64_at(st, W_ARGC * WORD_BYTES, count)
            return 0
        }
        if count == procbase.MAX_EXEC_ARGS {
            return too_big(state, st)
        }
        let n: u64 = fetch_one(state, me, st, p, at)
        if errno.is_error(n) {
            return fail(state, st, n)
        }
        at = at + n + 1
        count = count + 1
    }
    return too_big(state, st)
}

fn fetch(state: u64, me: u64, argv: u64, st: u64) -> u64 {
    return gather(state, me, argv, st, UNTIL_NULL)
}

fn fetch_n(state: u64, me: u64, argv: u64, declared: u64, st: u64) -> u64 {
    return gather(state, me, argv, st, declared)
}
