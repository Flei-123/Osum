profile kernel

import gfx.guihook
import sys.sysgui

export { install }

fn install(state: u64) {
    guihook.bind_sys(guihook.H_WM, sysgui.wm_call as u64)
    guihook.bind_sys(guihook.H_WIG, sysgui.wig_call as u64)
    guihook.bind_sys(guihook.H_DISP, sysgui.disp_call as u64)
    guihook.bind_sys(guihook.H_TILE, sysgui.tile_call as u64)
    guihook.bind_sys(guihook.H_FLOAT, sysgui.float_check as u64)
    guihook.bind_sys(guihook.H_AX, sysgui.ax_call as u64)
    guihook.bind_sys(guihook.H_SHOT, sysgui.shot_call as u64)
    guihook.bind_sys(guihook.H_TIPP, sysgui.tipp_call as u64)
}
