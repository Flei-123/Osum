import lib.errno
import fs.file
import sched.proc.procfault
import sys.sysuser

export {
    handles, call
}

const SYS_CACHESTAT: u64 = 451

const RANGE_BYTES: u64 = 16
const STAT_WORDS: u64 = 5
const STAT_BYTES: u64 = 40
const INT_MASK: u64 = 0xFFFFFFFF

fn fail(e: u64) -> u64 {
    return sysuser.neg(e)
}

fn handles(number: u64) -> bool {
    return number == SYS_CACHESTAT
}

fn is_regular(kind: u64) -> bool {
    return kind == file.K_FILE || kind == file.K_VFILE || kind == file.K_SHM
}

fn call(state: u64, me: u64, fd: u64, range: u64, out: u64, flags: u64) -> u64 {
    if (flags & INT_MASK) != 0 {
        return fail(errno.E_INVAL)
    }
    if !procfault.user_ok(state, me, range, RANGE_BYTES) || !procfault.user_ok(state, me, out, STAT_BYTES) {
        return fail(errno.E_FAULT)
    }
    let of: u64 = sysuser.of_of(state, me, fd & INT_MASK)
    if of >= file.MAX_OPEN || !is_regular(file.open_kind(state, of)) {
        return fail(errno.E_BADF)
    }
    var word: u64 = 0
    while word < STAT_WORDS {
        if !sysuser.put64(state, me, out + word * 8, 0) {
            return fail(errno.E_FAULT)
        }
        word = word + 1
    }
    return 0
}
