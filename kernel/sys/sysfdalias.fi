import lib.kstate

export {
    NONE, target_fd
}

const NONE: u64 = 65535
const MAX_DIGITS: u64 = 5

fn equals(buf: u64, len: u64, text: u64, n: u64) -> bool {
    if len != n {
        return false
    }
    var i: u64 = 0
    while i < n {
        if kstate.get8(buf + i) != kstate.get8(text + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn has_prefix(buf: u64, len: u64, text: u64, n: u64) -> bool {
    if len <= n {
        return false
    }
    return equals(buf, n, text, n)
}

fn number_after(buf: u64, len: u64, from: u64) -> u64 {
    if len - from > MAX_DIGITS {
        return NONE
    }
    var n: u64 = 0
    var i: u64 = from
    while i < len {
        let c: u64 = kstate.get8(buf + i)
        if c < 48 || c > 57 {
            return NONE
        }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    return n
}

fn std_name(buf: u64, len: u64) -> u64 {
    var in_t: [u8; 10] = "/dev/stdin"
    var out_t: [u8; 11] = "/dev/stdout"
    var err_t: [u8; 11] = "/dev/stderr"
    if equals(buf, len, (&in_t[0]) as u64, 10) {
        return 0
    }
    if equals(buf, len, (&out_t[0]) as u64, 11) {
        return 1
    }
    if equals(buf, len, (&err_t[0]) as u64, 11) {
        return 2
    }
    return NONE
}

fn target_fd(buf: u64, len: u64) -> u64 {
    var dev_t: [u8; 8] = "/dev/fd/"
    var proc_t: [u8; 14] = "/proc/self/fd/"
    let std: u64 = std_name(buf, len)
    if std != NONE {
        return std
    }
    if has_prefix(buf, len, (&dev_t[0]) as u64, 8) {
        return number_after(buf, len, 8)
    }
    if has_prefix(buf, len, (&proc_t[0]) as u64, 14) {
        return number_after(buf, len, 14)
    }
    return NONE
}
