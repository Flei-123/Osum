const HK_DOWN_Q: u64 = 3

const KL_SEQ: u64 = 0
const KL_FIRST: u64 = 1
const KL_LOST: u64 = 2
const KL_FILT: u64 = 3
const KL_MIN: u64 = 4
const KL_SER: u64 = 5
const KL_NENT: u64 = 6
const KL_LINE: u64 = 10
const KL_SETMIN: u64 = 20
const KL_SETSER: u64 = 21
const KL_WRITE: u64 = 22
const KL_CRASH: u64 = 30

const CS_COUNT: u64 = 0
const CS_ONLINE: u64 = 1
const CS_UP: u64 = 2
const CS_APICID: u64 = 3
const CS_TICKS: u64 = 4
const CS_IDLE: u64 = 5
const CS_SWITCHES: u64 = 6
const CS_PICKS: u64 = 7
const CS_CURPID: u64 = 8
const CS_CYC: u64 = 9
const CS_IDLECYC: u64 = 10

// kind 1, above the six counters of `pmon.PT_*`.
const PT_PID: u64 = 6
const PT_ALIVE: u64 = 7 // 1 = the slot still holds a live task
const PT_KIND: u64 = 8 // `sched.K_*` -- which of them is the idle task
const PT_STATE: u64 = 9 // `sched.S_*`
const PT_SCHEDTICKS: u64 = 10 // what the SCHEDULER counted, unfiltered

// kind 5, what may be set.
const PS_ROLLDAY: u64 = 0 // move the day mark, after the file was written
const PS_RESET: u64 = 1 // throw the split away, keep the measured floor
const PS_EVERY: u64 = 2 // ticks between two samples
const PS_ONOFF: u64 = 3 // switch the accounting off and on again

const PG_READY: u64 = 0
const PG_PROFILE: u64 = 1
const PG_CAPS: u64 = 2
const PG_RATIOS: u64 = 3
const PG_RATIOSRC: u64 = 4
const PG_PERFCTL: u64 = 5
const PG_PERFBACK: u64 = 6
const PG_HWPREQ: u64 = 7
const PG_HWPBACK: u64 = 8
const PG_MISC: u64 = 9
const PG_MISCBACK: u64 = 10
const PG_MISCORIG: u64 = 11
const PG_CSTATE: u64 = 12
const PG_MWAITS: u64 = 13
const PG_HLTS: u64 = 14
const PG_IDLERUNS: u64 = 15
const PG_TEMP: u64 = 16
const PG_TEMPOK: u64 = 17
const PG_TJMAX: u64 = 18
const PG_THROTTLES: u64 = 19
const PG_THROTTLED: u64 = 20
const PG_APPLIES: u64 = 21
const PG_SWITCHES: u64 = 22
