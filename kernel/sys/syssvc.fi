const OG_GET: u64 = 0
const OG_SET: u64 = 1
const OG_RGET: u64 = 3
const OG_RSET: u64 = 2
// W-APPRIGHTS AR-2: the CEILING of an app = what its manifest (`perm=`) declares it may ever get.
//   ORIGIN(5, name, 0)     -> ceiling mask, or policy.CEIL_NONE (4096) when none is registered (anyone may read)
//   ORIGIN(4, name, mask)  -> 0; register the ceiling (lowering it also clamps the grants). ONLY an unlabelled caller.
//   ORIGIN(2, ...) above a registered ceiling -> -EPERM
const OG_CSET: u64 = 4
const OG_CGET: u64 = 5

const CG_MINE: u64 = 0
const CG_STATE: u64 = 1 // C_FREE/C_SET/C_RUN/C_DEAD
const CG_MEMLIM: u64 = 2
const CG_MEMUSE: u64 = 3
