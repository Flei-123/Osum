// SPDX-License-Identifier: GPL-2.0-only
// kernel/usb.fi -- Runde K17: der Kern ueber dem Regler, und die drei
// Klassen, die ein Rechner wirklich braucht.
//
// `xhci.fi` weiss, was ein Steckplatz und ein Endpunkt ist. Diese Datei
// weiss, was ein GERAET ist -- und das ist etwas anderes: ein Geraet
// beschreibt sich selbst, und zwar in einer festen Reihenfolge, die man
// nicht abkuerzen kann.
//
//   1. ANSCHLUSS EINSCHALTEN UND ZURUECKSETZEN. Ein USB-2-Geraet meldet
//      sich erst nach einer Ruecksetzung; ein USB-3-Geraet richtet die
//      Verbindung selbst ein und ist danach schon freigeschaltet. Beide
//      Faelle stehen hier, weil `qemu-xhci` beide anbietet -- die
//      vorderen Anschluesse sind USB 2, die hinteren USB 3.
//   2. STECKPLATZ ANFORDERN und einen Geraetezusammenhang dafuer
//      hinterlegen.
//   3. ADRESSE VERGEBEN. Bis hierher hoert das Geraet auf Adresse 0; der
//      Befehl `Address Device` gibt ihm eine eigene.
//   4. DESKRIPTOREN LESEN, und zwar in ZWEI Schritten: erst acht Oktett
//      des Geraetedeskriptors, weil in Oktett 7 steht, wie gross ein
//      Paket auf dem Steuerungsendpunkt sein darf -- und ein
//      langsameres Geraet sagt dort acht, wo der Treiber vierundsechzig
//      angenommen hat. Dann der ganze.
//   5. KONFIGURATIONSDESKRIPTOR, auch in zwei Schritten: die ersten neun
//      Oktett sagen, wie lang das Ganze ist. Darin stehen die
//      SCHNITTSTELLEN und ihre ENDPUNKTE -- eine Kette von Bloecken
//      hintereinander, jeder mit seiner Laenge im ersten Oktett.
//   6. ENDPUNKTE EINRICHTEN (`Configure Endpoint`) und dann
//      `SET_CONFIGURATION`. In dieser Reihenfolge: der Regler muss die
//      Bandbreite kennen, bevor das Geraet zu senden anfaengt.
//   7. TREIBER ZUORDNEN, an der KLASSE der Schnittstelle und an nichts
//      sonst. Ein Treiber, der an Hersteller- und Geraetenummer haengt,
//      kennt genau die Geraete, die sein Schreiber besass.
//
// DIE TASTATUR UND DIE MAUS MUENDEN IN DEN BESTEHENDEN EINGABEWEG, und
// das ist woertlich gemeint: der Tastaturtreiber uebersetzt den
// HID-Gebrauchscode in einen PS/2-ABTASTCODE (Satz 1) und ruft damit
// `kbd.on_code` -- dieselbe Funktion, die die Unterbrechung von IRQ 1
// ruft. Es gibt keinen zweiten Weg in die Zeilendisziplin, keinen
// zweiten Fokus im Fensterserver und keine zweite Tabelle fuer
// Umschalt und Steuerung. Die Maus baut aus dem HID-Bericht ein
// PS/2-PAKET und gibt es an `ps2m.usb_packet`. Damit gilt fuer Shell,
// Fensterserver und Widgets: sie merken nicht, woher die Taste kam --
// und genau das misst `tools/k17/run.sh`, indem es DENSELBEN Testlauf
// einmal mit `-device usb-kbd` und einmal mit PS/2 faehrt und die
// Ausgaben Oktett fuer Oktett vergleicht.
//
// DER STICK IST EIN BLOCKGERAET, und auch das ist woertlich gemeint: er
// haengt als `blk.DEV_USB` an derselben Schnittstelle wie RAM-Platte,
// ATA und NVMe (`kernel/blk.fi`, Runde 62). `fs.fi`, `vfs.fi` und
// `fat.fi` aendern dafuer keine Zeile -- dieselbe Zusage wie bei NVMe in
// Runde K2, und dieselbe Art, sie zu pruefen: das Abbild wird nach dem
// Lauf VON AUSSEN gelesen.
//
// WAS DIESE DATEI NICHT TUT: sie kennt keine HID-Berichtsbeschreibung.
// Tastatur und Maus laufen im BOOT-PROTOKOLL (`SET_PROTOCOL 0`), in dem
// das Berichtsformat festgelegt ist -- acht Oktett bei der Tastatur,
// drei oder vier bei der Maus. Das ist kein Kniff: es ist der Grund,
// warum jedes BIOS eine USB-Tastatur bedienen kann, ohne einen Zerleger
// fuer Berichtsbeschreibungen zu haben. Ein Geraet ohne Boot-Protokoll
// (Schnittstellenunterklasse != 1) wird deshalb ausdruecklich ABGELEHNT
// und nicht stillschweigend falsch gelesen.

profile kernel

import serial
import kstate
import xhci
import kbd
import hidrep
import hidin
import gfx

export {
    stage, irq, service, poll, say, report, ready, count,
    msc_ready, msc_blocks, msc_bsize, msc_read, msc_write,
    unplug_check, unplug_now, keys, reports, enums, hotplugs, unplugs,
    stat,
    have_kbd, have_mouse, msc_errors, msc_ios, selftest,
    DRV_NONE, DRV_KBD, DRV_MOUSE, DRV_MSC
}

// ---------------------------------------------- der Platz dieser Runde
//
// Die zwei Kilooktett hinter dem Kommandoring von `xhci.fi` -- derselbe
// Vorrat 0x50000..0x58000, kein Byte darueber hinaus.

const USCAL_OFF: u64 = 0x51800
const UDEV_OFF: u64 = 0x51900
const DEV_BYTES: u64 = 192
const MAX_DEV: u64 = 4

// Die Puffer, die ein GERAET beschreibt. Sie liegen in `kdata`, weil der
// Regler sie ueber den Bus erreicht und der Haldenallokator nichts
// darueber verspricht, wo etwas liegt.
const DESC_OFF: u64 = 0x56000 // Deskriptoren, 512
const REPORT_OFF: u64 = 0x56200 // vier Berichte zu 64
const CBW_OFF: u64 = 0x56300 // der Befehlsblock, 64
const CSW_OFF: u64 = 0x56340 // die Quittung, 64
const BLK_OFF: u64 = 0x56400 // ein Datenblock, 512

const S_READY: u64 = 0x00
const S_NDEV: u64 = 0x08
const S_ENUMS: u64 = 0x10
const S_KBD: u64 = 0x18 // Platz + 1, 0 = keine
const S_MOUSE: u64 = 0x20
const S_MSC: u64 = 0x28
const S_BLOCKS: u64 = 0x30
const S_BSIZE: u64 = 0x38
const S_TAG: u64 = 0x40
const S_REPORTS: u64 = 0x48
const S_KEYS: u64 = 0x50
const S_MOVES: u64 = 0x58
const S_UNPLUGS: u64 = 0x60
const S_HOTPLUGS: u64 = 0x68
const S_MSCERR: u64 = 0x70
const S_MSCIO: u64 = 0x78
const S_FAILS: u64 = 0x80
const S_ATTACHED: u64 = 0x88 // Bitkarte der Anschluesse mit Geraet
const S_NOHID: u64 = 0x90
const S_NOMSC: u64 = 0x98
const S_LASTDATA: u64 = 0xA0 // Oktette im Datenteil der letzten BOT-Runde
const S_GEN: u64 = 0xA8 // 1 = der generische Weg ist erlaubt (Modus `hid`)
const S_GENDEV: u64 = 0xB0 // wie viele Geraete wirklich darueber laufen
const S_RDFAIL: u64 = 0xB8 // Beschreibung nicht zu holen/zu zerlegen
const S_RDLEN: u64 = 0xC0 // Oktette der zuletzt geholten Beschreibung

const D_USED: u64 = 0
const D_SLOT: u64 = 8
const D_PORT: u64 = 16
const D_SPEED: u64 = 24
const D_VID: u64 = 32
const D_PID: u64 = 40
const D_CLASS: u64 = 48
const D_SUB: u64 = 56
const D_PROTO: u64 = 64
const D_DRIVER: u64 = 72
const D_INTDCI: u64 = 80
const D_INDCI: u64 = 88
const D_OUTDCI: u64 = 96
const D_INTLEN: u64 = 104
const D_SEQ: u64 = 112
const D_PREV: u64 = 120
const D_IFACE: u64 = 128
const D_CONFIG: u64 = 136
const D_MPS0: u64 = 144
const D_INTMPS: u64 = 152
const D_INTIVL: u64 = 160
const D_BULKMPS: u64 = 168
// RUNDE HID: die Laenge der Berichtsbeschreibung, wie der HID-Deskriptor
// (Art 0x21) sie ansagt, und ob dieses Geraet ueber den Zerleger laeuft.
const D_RDLEN: u64 = 176
const D_GENERIC: u64 = 184

const DRV_NONE: u64 = 0
const DRV_KBD: u64 = 1
const DRV_MOUSE: u64 = 2
const DRV_MSC: u64 = 3
// RUNDE HID: eine HID-Schnittstelle OHNE Boot-Protokoll. Was sie ist --
// Tastatur, Maus, Touchpad -- steht nicht in ihrer Klasse, sondern in
// ihrer Berichtsbeschreibung; entschieden wird deshalb erst in
// `hid_start`, nachdem die geholt und zerlegt ist.
const DRV_HIDGEN: u64 = 4

// Die Standardanforderungen. Sie stehen im Kapitel 9 der Spezifikation
// und in jedem Geraet der Welt gleich.
const REQ_GET_DESCRIPTOR: u64 = 6
const REQ_SET_CONFIGURATION: u64 = 9
const REQ_CLEAR_FEATURE: u64 = 1
const D_DEVICE: u64 = 1
const D_CONFIGURATION: u64 = 2

const CLS_HID: u64 = 3
const CLS_MSC: u64 = 8

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state + USCAL_OFF, off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state + USCAL_OFF, off, v)
}

fn dev_at(state: u64, i: u64) -> u64 {
    return state + UDEV_OFF + i * DEV_BYTES
}

fn dg(state: u64, i: u64, f: u64) -> u64 {
    return __mmio_read64((dev_at(state, i) + f) as *mut u64)
}

fn ds(state: u64, i: u64, f: u64, v: u64) {
    __mmio_write64((dev_at(state, i) + f) as *mut u64, v)
}

fn ready(state: u64) -> bool {
    return g(state, S_READY) != 0
}

fn count(state: u64) -> u64 {
    return g(state, S_NDEV)
}

fn keys(state: u64) -> u64 {
    return g(state, S_KEYS)
}

fn reports(state: u64) -> u64 {
    return g(state, S_REPORTS)
}

fn enums(state: u64) -> u64 {
    return g(state, S_ENUMS)
}

fn hotplugs(state: u64) -> u64 {
    return g(state, S_HOTPLUGS)
}

fn unplugs(state: u64) -> u64 {
    return g(state, S_UNPLUGS)
}

fn have_kbd(state: u64) -> bool {
    return g(state, S_KBD) != 0
}

fn have_mouse(state: u64) -> bool {
    return g(state, S_MOUSE) != 0
}

fn msc_errors(state: u64) -> u64 {
    return g(state, S_MSCERR)
}

fn msc_ios(state: u64) -> u64 {
    return g(state, S_MSCIO)
}

fn b8(p: u64, i: u64) -> u64 {
    return kstate.get8(p + i)
}

fn b16(p: u64, i: u64) -> u64 {
    return b8(p, i) | (b8(p, i + 1) << 8)
}

fn wr32(at: u64, v: u64) {
    __mmio_write32(at as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n / 8 {
        __mmio_write64((p + i * 8) as *mut u64, 0)
        i = i + 1
    }
}

fn yes(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

// -------------------------------------------------------- der Aufbau

fn stage(state: u64) {
    var s_skip: [u8; 13] = "usb: skipped\0"
    var s_no: [u8; 19] = "usb: no controller\0"
    var s_fail: [u8; 18] = "usb: init failed\0\0"
    var s_hc: [u8; 12] = "usb: xhci \0\0"
    var s_slots: [u8; 7] = "slots=\0"
    var s_ports: [u8; 9] = "  ports=\0"
    var s_ctx: [u8; 7] = "  ctx=\0"
    var s_msix: [u8; 7] = "  irq=\0"
    var s_off: [u8; 12] = "usb: nousb\0\0"

    if !kstate.mode_on(state, kstate.M_USB) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    zero(state + USCAL_OFF, 256)
    zero(state + UDEV_OFF, MAX_DEV * DEV_BYTES)
    if kstate.mode_on(state, kstate.M_NOHID) {
        s(state, S_NOHID, 1)
    }
    // RUNDE HID: der generische Weg. `nohidrep` ist die GEGENPROBE --
    // damit laeuft alles wie vor dieser Runde, im Boot-Protokoll, und
    // ein Geraet ohne Boot-Protokoll wird wieder abgelehnt. Der
    // Unterschied zwischen den beiden Laeufen ist die ganze Runde.
    if kstate.mode_on(state, kstate.M_HID)
        && !kstate.mode_on(state, kstate.M_NOHIDREP) {
        s(state, S_GEN, 1)
    }
    hidin.stage(state)
    if kstate.mode_on(state, kstate.M_NOMSC) {
        s(state, S_NOMSC, 1)
    }
    // DIE GEGENPROBE, die alles fallen laesst: kein Regler, kein Kern,
    // keine Klasse. Jede Zusage dieser Runde MUSS damit zusammenbrechen.
    if kstate.mode_on(state, kstate.M_NOUSB) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    if !xhci.present(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    let armed: bool = !kstate.mode_on(state, kstate.M_NOUSBIRQ)
    if !xhci.init(state, armed) {
        serial.puts((&s_fail[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_hc[0]) as u64)
    serial.puts((&s_slots[0]) as u64)
    serial.dec(xhci.slots(state))
    serial.puts((&s_ports[0]) as u64)
    serial.dec(xhci.ports(state))
    serial.puts((&s_ctx[0]) as u64)
    serial.dec(xhci.ctx_size(state))
    serial.puts((&s_msix[0]) as u64)
    serial.dec(yes(armed))
    serial.nl()
    s(state, S_READY, 1)
    scan(state)
    say(state)
}

// Alle Anschluesse einschalten und dann durchsehen. In zwei Durchgaengen,
// weil ein Anschluss nach dem Einschalten der Versorgung einen
// Augenblick braucht, bevor er eine Verbindung meldet -- und ein
// Treiber, der beides in einer Schleife tut, findet das erste Geraet
// und das zweite nicht.
fn scan(state: u64) {
    let n: u64 = xhci.ports(state)
    var p: u64 = 1
    while p <= n {
        xhci.port_power(state, p)
        p = p + 1
    }
    settle(state)
    p = 1
    while p <= n {
        if xhci.port_connected(state, p) {
            mark(state, p)
            attach(state, p)
        }
        p = p + 1
    }
}

fn settle(state: u64) {
    var i: u64 = 0
    while i < 200000 {
        i = i + 1
    }
    xhci.drain(state)
}

fn mark(state: u64, p: u64) {
    s(state, S_ATTACHED, g(state, S_ATTACHED) | (1 << (p & 63)))
}

fn unmark(state: u64, p: u64) {
    s(state, S_ATTACHED, g(state, S_ATTACHED) & (~(1 << (p & 63))))
}

fn was_there(state: u64, p: u64) -> bool {
    return (g(state, S_ATTACHED) & (1 << (p & 63))) != 0
}

fn alloc_dev(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_DEV {
        if dg(state, i, D_USED) == 0 {
            zero(dev_at(state, i), DEV_BYTES)
            ds(state, i, D_USED, 1)
            return i
        }
        i = i + 1
    }
    return MAX_DEV
}

fn mps0_of(speed: u64) -> u64 {
    if speed == 3 {
        return 64 // hohe Geschwindigkeit
    }
    if speed >= 4 {
        return 512 // Super und darueber
    }
    return 8 // voll und langsam
}

// ------------------------------------------------- ein Geraet aufnehmen

fn attach(state: u64, port: u64) -> bool {
    var s_dev: [u8; 11] = "usb: port=\0"
    var s_sp: [u8; 8] = " speed=\0"
    var s_id: [u8; 5] = " id=\0"
    var s_cls: [u8; 8] = " class=\0"
    var s_drv: [u8; 9] = " driver=\0"
    var s_slot: [u8; 7] = " slot=\0"

    if !xhci.port_reset(state, port) {
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return false
    }
    let speed: u64 = xhci.port_speed(state, port)
    let slot: u64 = xhci.slot_enable(state)
    if slot == 0 {
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return false
    }
    let d: u64 = alloc_dev(state)
    if d >= MAX_DEV {
        xhci.slot_disable(state, slot)
        return false
    }
    ds(state, d, D_SLOT, slot)
    ds(state, d, D_PORT, port)
    ds(state, d, D_SPEED, speed)
    ds(state, d, D_MPS0, mps0_of(speed))

    if !address(state, d) {
        drop_dev(state, d)
        return false
    }
    if !describe(state, d) {
        drop_dev(state, d)
        return false
    }
    if !configure(state, d) {
        drop_dev(state, d)
        return false
    }
    s(state, S_ENUMS, g(state, S_ENUMS) + 1)
    s(state, S_NDEV, g(state, S_NDEV) + 1)

    serial.puts((&s_dev[0]) as u64)
    serial.dec(port)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(speed)
    serial.puts((&s_slot[0]) as u64)
    serial.dec(slot)
    serial.puts((&s_id[0]) as u64)
    hex4(dg(state, d, D_VID))
    serial.put(58 as u8)
    hex4(dg(state, d, D_PID))
    serial.puts((&s_cls[0]) as u64)
    hex2(dg(state, d, D_CLASS))
    serial.put(58 as u8)
    hex2(dg(state, d, D_SUB))
    serial.put(58 as u8)
    hex2(dg(state, d, D_PROTO))
    serial.puts((&s_drv[0]) as u64)
    drv_name(dg(state, d, D_DRIVER))
    serial.nl()
    bind(state, d)
    return true
}

fn hex2(v: u64) {
    var i: u64 = 2
    while i > 0 {
        i = i - 1
        let x: u64 = (v >> (i * 4)) & 15
        if x < 10 {
            serial.put((48 + x) as u8)
        } else {
            serial.put((87 + x) as u8)
        }
    }
}

fn hex4(v: u64) {
    hex2(v >> 8)
    hex2(v & 0xFF)
}

fn drv_name(k: u64) {
    var s_k: [u8; 4] = "kbd\0"
    var s_m: [u8; 6] = "mouse\0"
    var s_s: [u8; 4] = "msc\0"
    var s_n: [u8; 5] = "none\0"
    if k == DRV_KBD {
        serial.puts((&s_k[0]) as u64)
    } else if k == DRV_MOUSE {
        serial.puts((&s_m[0]) as u64)
    } else if k == DRV_MSC {
        serial.puts((&s_s[0]) as u64)
    } else {
        serial.puts((&s_n[0]) as u64)
    }
}

// Den Steckplatz mit einem Zusammenhang versehen und die Adresse
// vergeben. Der Eingabezusammenhang traegt zwei Bloecke: den des
// Steckplatzes und den des Steuerungsendpunkts.
fn address(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let dc: u64 = xhci.devctx(state, slot)
    zero(dc, 1024)
    xhci.dcbaa_set(state, slot, dc)
    let ep0: u64 = xhci.ep_open(state, slot, 1)
    if ep0 >= xhci.MAX_EP {
        return false
    }
    build_slot(state, d, 1)
    build_ep0(state, d, ep0)
    let ic: u64 = xhci.in_control(state)
    wr32(ic, 0) // nichts fallen lassen
    wr32(ic + 4, 3) // Steckplatz und Endpunkt 0 aufnehmen
    if xhci.address_device(state, slot, false) != xhci.CC_SUCCESS {
        return false
    }
    return true
}

fn build_slot(state: u64, d: u64, entries: u64) {
    let sc: u64 = xhci.in_slot(state)
    zero(sc, xhci.ctx_size(state))
    wr32(sc, (dg(state, d, D_SPEED) << 20) | (entries << 27))
    wr32(sc + 4, dg(state, d, D_PORT) << 16)
    wr32(sc + 8, 0)
    wr32(sc + 12, 0)
}

fn build_ep0(state: u64, d: u64, i: u64) {
    let ec: u64 = xhci.in_ep(state, 1)
    zero(ec, xhci.ctx_size(state))
    wr32(ec, 0)
    // CErr = 3, Art 4 (Steuerung), Paketgroesse oben.
    wr32(ec + 4, (3 << 1) | (4 << 3) | (dg(state, d, D_MPS0) << 16))
    __mmio_write64((ec + 8) as *mut u64, xhci.ep_ring(state, i) | 1)
    wr32(ec + 16, 8)
}

// Die Deskriptoren. Erst acht Oktett -- nur so erfaehrt der Treiber die
// wirkliche Paketgroesse des Steuerungsendpunkts, und nur mit ihr
// stimmen alle weiteren Uebertragungen.
fn describe(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let buf: u64 = state + DESC_OFF
    zero(buf, 64)
    if xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
        (D_DEVICE << 8), 0, 8, buf, true) < 8 {
        return false
    }
    let mps: u64 = b8(buf, 7)
    if mps >= 8 && mps != dg(state, d, D_MPS0) {
        ds(state, d, D_MPS0, mps)
        let ep0: u64 = xhci.ep_find(state, slot, 1)
        if ep0 < xhci.MAX_EP {
            build_ep0(state, d, ep0)
            let ic: u64 = xhci.in_control(state)
            wr32(ic, 0)
            wr32(ic + 4, 2)
            xhci.evaluate_context(state, slot)
        }
    }
    zero(buf, 64)
    if xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
        (D_DEVICE << 8), 0, 18, buf, true) < 18 {
        return false
    }
    ds(state, d, D_VID, b16(buf, 8))
    ds(state, d, D_PID, b16(buf, 10))
    return true
}

// Den Konfigurationsdeskriptor holen und die Schnittstelle waehlen, die
// dieser Kernel bedienen kann. Die Kette wird EINMAL durchgegangen; die
// erste Schnittstelle mit einer bekannten Klasse gewinnt, und alles, was
// danach an Endpunkten kommt, gehoert ihr -- bis die naechste
// Schnittstelle anfaengt.
fn configure(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let buf: u64 = state + DESC_OFF
    zero(buf, 512)
    if xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
        (D_CONFIGURATION << 8), 0, 9, buf, true) < 9 {
        return false
    }
    var total: u64 = b16(buf, 2)
    if total < 9 {
        return false
    }
    if total > 512 {
        total = 512
    }
    ds(state, d, D_CONFIG, b8(buf, 5))
    zero(buf, 512)
    if xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
        (D_CONFIGURATION << 8), 0, total, buf, true) < (total as i64) {
        return false
    }
    parse(state, d, buf, total)
    if dg(state, d, D_DRIVER) == DRV_NONE {
        return false
    }
    if !endpoints(state, d) {
        return false
    }
    if xhci.control(state, slot, 0, REQ_SET_CONFIGURATION,
        dg(state, d, D_CONFIG), 0, 0, 0, false) < 0 {
        return false
    }
    return true
}

fn parse(state: u64, d: u64, buf: u64, total: u64) {
    var at: u64 = 0
    var mine: bool = false
    var picked: bool = false
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        if len < 2 {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                // Eine Schnittstelle. Alternative Einstellungen ausser 0
                // werden uebergangen -- die Vorgabe ist das, was ohne
                // `SET_INTERFACE` gilt.
                mine = false
                if !picked && b8(buf, at + 3) == 0 {
                    let cls: u64 = b8(buf, at + 5)
                    let sub: u64 = b8(buf, at + 6)
                    let pro: u64 = b8(buf, at + 7)
                    if wanted(state, cls, sub, pro) {
                        ds(state, d, D_CLASS, cls)
                        ds(state, d, D_SUB, sub)
                        ds(state, d, D_PROTO, pro)
                        ds(state, d, D_IFACE, b8(buf, at + 2))
                        ds(state, d, D_DRIVER, driver_for(cls, sub, pro))
                        mine = true
                        picked = true
                    }
                }
            } else if kind == 0x21 && len >= 9 && mine {
                // DER HID-DESKRIPTOR. Er steht zwischen der
                // Schnittstelle und ihren Endpunkten und sagt, WIE LANG
                // die Berichtsbeschreibung ist -- ohne diese Zahl laesst
                // sie sich nicht holen, denn ein Kontrolltransfer will
                // die Laenge vorher wissen. Ab Oktett 6 stehen Paare
                // (Art, Laenge); genommen wird das erste mit Art 0x22.
                var k: u64 = 0
                let nd: u64 = b8(buf, at + 5)
                while k < nd && 6 + k * 3 + 2 < len {
                    if b8(buf, at + 6 + k * 3) == 0x22 {
                        ds(state, d, D_RDLEN, b16(buf, at + 7 + k * 3))
                        k = nd
                    } else {
                        k = k + 1
                    }
                }
            } else if kind == 5 && len >= 7 && mine {
                take_ep(state, d, buf, at)
            }
            at = at + len
        }
    }
}

// Welche Schnittstellen dieser Kernel annimmt. Eine HID-Schnittstelle
// OHNE Boot-Protokoll (Unterklasse 1) wird ABGELEHNT und nicht falsch
// gelesen: ihr Berichtsformat steht in einer Berichtsbeschreibung, und
// die zerlegt diese Runde nicht.
fn wanted(state: u64, cls: u64, sub: u64, pro: u64) -> bool {
    if cls == CLS_HID {
        if g(state, S_NOHID) != 0 {
            return false
        }
        if sub == 1 && (pro == 1 || pro == 2) {
            return true
        }
        // RUNDE HID: eine Schnittstelle OHNE Boot-Protokoll. Bis zu
        // dieser Runde stand hier `return false` mit der Begruendung
        // "ihr Berichtsformat steht in einer Berichtsbeschreibung, und
        // die zerlegt diese Runde nicht". Jetzt zerlegt sie sie.
        // DAS IST DER FALL EINES LAPTOPS: ein Praezisions-Touchpad hat
        // kein Boot-Protokoll, und `-device usb-tablet` in QEMU auch
        // nicht.
        return g(state, S_GEN) != 0
    }
    if cls == CLS_MSC {
        if g(state, S_NOMSC) != 0 {
            return false
        }
        return sub == 6 && pro == 0x50
    }
    return false
}

fn driver_for(cls: u64, sub: u64, pro: u64) -> u64 {
    if cls == CLS_HID && sub == 1 && pro == 1 {
        return DRV_KBD
    }
    if cls == CLS_HID && sub == 1 && pro == 2 {
        return DRV_MOUSE
    }
    if cls == CLS_HID {
        return DRV_HIDGEN
    }
    if cls == CLS_MSC {
        return DRV_MSC
    }
    return DRV_NONE
}

fn take_ep(state: u64, d: u64, buf: u64, at: u64) {
    let addr: u64 = b8(buf, at + 2)
    let attrs: u64 = b8(buf, at + 3) & 3
    let mps: u64 = b16(buf, at + 4) & 0x7FF
    let ivl: u64 = b8(buf, at + 6)
    let num: u64 = addr & 0xF
    var dci: u64 = num * 2
    if (addr & 0x80) != 0 {
        dci = dci + 1
    }
    if attrs == 3 && (addr & 0x80) != 0 && dg(state, d, D_INTDCI) == 0 {
        ds(state, d, D_INTDCI, dci)
        ds(state, d, D_INTMPS, mps)
        ds(state, d, D_INTIVL, ivl)
        // RUNDE HID: BIS ZU DIESER RUNDE STANDEN HIER ACHT.
        // Acht ist die Groesse eines Boot-Tastaturberichts, und
        // solange es nur die gab, war die Zahl richtig. Ein
        // Praezisions-Touchpad schickt 29 Oktett und `-device
        // usb-tablet` sechs bis acht; wer bei acht abschneidet,
        // bekommt von einem Touchpad die ersten anderthalb Finger
        // und sonst nichts. Die Grenze ist jetzt der Platz, den
        // `report_buf` je Geraet hat (64), und nicht eine Bauform.
        var want: u64 = mps
        if want > 64 {
            want = 64
        }
        ds(state, d, D_INTLEN, want)
        return
    }
    if attrs == 2 {
        // DIE PAKETGROSSE KOMMT AUS DEM DESKRIPTOR UND NICHT AUS DEM
        // KOPF DES TREIBERS. Ein Massenendpunkt hat bei voller
        // Geschwindigkeit 64, bei hoher 512 und bei Super 1024 Oktett --
        // und `qemu-xhci` haengt einen Stick an einen USB-3-Anschluss,
        // wenn einer frei ist. Eine geratene 512 waere dort schlicht
        // falsch.
        ds(state, d, D_BULKMPS, mps)
        if (addr & 0x80) != 0 {
            if dg(state, d, D_INDCI) == 0 {
                ds(state, d, D_INDCI, dci)
            }
        } else {
            if dg(state, d, D_OUTDCI) == 0 {
                ds(state, d, D_OUTDCI, dci)
            }
        }
    }
}

// Ein Endpunktzusammenhang. `art` ist die xHCI-Nummer: 2 Masse aus,
// 6 Masse ein, 7 Unterbrechung ein.
fn build_ep(state: u64, dci: u64, art: u64, mps: u64, ivl: u64, ring: u64,
    avg: u64) {
    let ec: u64 = xhci.in_ep(state, dci)
    zero(ec, xhci.ctx_size(state))
    wr32(ec, ivl << 16)
    wr32(ec + 4, (3 << 1) | (art << 3) | (mps << 16))
    __mmio_write64((ec + 8) as *mut u64, ring | 1)
    wr32(ec + 16, avg | (mps << 16))
}

// Das Zeitraster einer Unterbrechungsmeldung. Bei hoher Geschwindigkeit
// steht in `bInterval` schon ein Logarithmus, bei voller und langsamer
// stehen dort MILLISEKUNDEN -- und xHCI will in beiden Faellen einen
// Exponenten zur Basis 125 Mikrosekunden. Wer das verwechselt, bekommt
// eine Tastatur, die achtmal zu selten oder achtmal zu oft meldet.
fn interval_of(speed: u64, binterval: u64) -> u64 {
    if speed >= 3 {
        if binterval == 0 {
            return 0
        }
        var v: u64 = binterval - 1
        if v > 15 {
            v = 15
        }
        return v
    }
    var ms: u64 = binterval
    if ms == 0 {
        ms = 1
    }
    var n: u64 = 3
    while n < 10 && (1 << (n - 3)) < ms {
        n = n + 1
    }
    return n
}

fn endpoints(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    var top: u64 = 1
    var add: u64 = 1 // der Steckplatz selbst
    let ic: u64 = xhci.in_control(state)
    // Alle Endpunktbloecke des Eingabezusammenhangs leeren: was von
    // einem frueheren Geraet stehenbliebe, waere ein Endpunkt, den
    // niemand bestellt hat.
    zero(xhci.in_ep(state, 1), 31 * xhci.ctx_size(state))

    let idci: u64 = dg(state, d, D_INTDCI)
    if idci != 0 {
        let i: u64 = xhci.ep_open(state, slot, idci)
        if i >= xhci.MAX_EP {
            return false
        }
        build_ep(state, idci, 7, dg(state, d, D_INTMPS),
            interval_of(dg(state, d, D_SPEED), dg(state, d, D_INTIVL)),
            xhci.ep_ring(state, i), dg(state, d, D_INTMPS))
        add = add | (1 << idci)
        if idci > top {
            top = idci
        }
    }
    let indci: u64 = dg(state, d, D_INDCI)
    if indci != 0 {
        let i: u64 = xhci.ep_open(state, slot, indci)
        if i >= xhci.MAX_EP {
            return false
        }
        build_ep(state, indci, 6, dg(state, d, D_BULKMPS), 0,
            xhci.ep_ring(state, i), 512)
        add = add | (1 << indci)
        if indci > top {
            top = indci
        }
    }
    let outdci: u64 = dg(state, d, D_OUTDCI)
    if outdci != 0 {
        let i: u64 = xhci.ep_open(state, slot, outdci)
        if i >= xhci.MAX_EP {
            return false
        }
        build_ep(state, outdci, 2, dg(state, d, D_BULKMPS), 0,
            xhci.ep_ring(state, i), 512)
        add = add | (1 << outdci)
        if outdci > top {
            top = outdci
        }
    }
    build_slot(state, d, top)
    wr32(ic, 0)
    wr32(ic + 4, add)
    return xhci.configure_endpoint(state, slot) == xhci.CC_SUCCESS
}

fn drop_dev(state: u64, d: u64) {
    let slot: u64 = dg(state, d, D_SLOT)
    if slot != 0 {
        xhci.forget_slot(state, slot)
        xhci.slot_disable(state, slot)
        xhci.dcbaa_set(state, slot, 0)
    }
    zero(dev_at(state, d), DEV_BYTES)
}

// ------------------------------------------------------- die Zuordnung

fn bind(state: u64, d: u64) {
    let k: u64 = dg(state, d, D_DRIVER)
    if k == DRV_HIDGEN {
        hid_start(state, d)
        return
    }
    if k == DRV_KBD {
        hid_start(state, d)
        s(state, S_KBD, d + 1)
        return
    }
    if k == DRV_MOUSE {
        hid_start(state, d)
        s(state, S_MOUSE, d + 1)
        return
    }
    if k == DRV_MSC {
        if msc_start(state, d) {
            s(state, S_MSC, d + 1)
        }
        return
    }
}

// ------------------------------------------------------------ HID
//
// Boot-Protokoll einschalten, Wiederholung abschalten, und dann liegt
// dauerhaft GENAU EIN Block auf dem Unterbrechungsring. Wird er fertig,
// kommt eine Meldung; der Behandler wertet den Bericht aus und legt
// sofort den naechsten hin. Ein Ring ohne offenen Block ist eine
// Tastatur, die einmal getippt hat.

fn hid_start(state: u64, d: u64) {
    let slot: u64 = dg(state, d, D_SLOT)
    let iface: u64 = dg(state, d, D_IFACE)
    // RUNDE HID: ZUERST DIE BERICHTSBESCHREIBUNG VERSUCHEN.
    //
    // Geht sie zu holen UND zu zerlegen, laeuft dieses Geraet im
    // BERICHTSPROTOKOLL (SET_PROTOCOL 1) und seine Berichte gehen durch
    // `hidin.report` -- dann sind alle Tasten da, alle Knoepfe, das Rad
    // steht da, wo die Beschreibung es hinlegt, und ein Touchpad
    // funktioniert ueberhaupt erst.
    //
    // Geht sie NICHT, bleibt alles wie vorher: Boot-Protokoll. Das ist
    // kein Rest, sondern der Rueckfallweg, und er ist der Grund, warum
    // jedes BIOS eine USB-Tastatur bedienen kann. Ein Geraet, das man
    // nach dieser Runde NICHT mehr bedienen koennte, waere ein
    // Rueckschritt.
    var generisch: bool = false
    if g(state, S_GEN) != 0 && d < hidrep.MAX_DEV {
        generisch = hid_descriptor(state, d, slot, iface)
    }
    ds(state, d, D_GENERIC, 0)
    if generisch {
        ds(state, d, D_GENERIC, 1)
        s(state, S_GENDEV, g(state, S_GENDEV) + 1)
        // SET_PROTOCOL 1 = Berichtsprotokoll.
        xhci.control(state, slot, 0x21, 0x0B, 1, iface, 0, 0, false)
        xhci.control(state, slot, 0x21, 0x0A, 0, iface, 0, 0, false)
        hid_claim(state, d)
        ds(state, d, D_PREV, 0)
        let i2: u64 = xhci.ep_find(state, slot, dg(state, d, D_INTDCI))
        if i2 < xhci.MAX_EP {
            ds(state, d, D_SEQ, xhci.ep_seq(state, i2))
        }
        arm(state, d)
        return
    }
    if dg(state, d, D_DRIVER) == DRV_HIDGEN {
        // Kein Boot-Protokoll UND keine brauchbare Beschreibung: dieses
        // Geraet bleibt liegen. Gezaehlt, nicht geraten.
        ds(state, d, D_DRIVER, DRV_NONE)
        return
    }
    // SET_PROTOCOL 0 = Boot. Klasse, Schnittstelle, Wirt an Geraet.
    xhci.control(state, slot, 0x21, 0x0B, 0, iface, 0, 0, false)
    // SET_IDLE 0 = nur melden, wenn sich etwas aendert.
    xhci.control(state, slot, 0x21, 0x0A, 0, iface, 0, 0, false)
    ds(state, d, D_PREV, 0)
    let i: u64 = xhci.ep_find(state, slot, dg(state, d, D_INTDCI))
    if i < xhci.MAX_EP {
        ds(state, d, D_SEQ, xhci.ep_seq(state, i))
    }
    arm(state, d)
}

// DIE BERICHTSBESCHREIBUNG HOLEN UND ZERLEGEN.
//
// GET_DESCRIPTOR mit bmRequestType 0x81 -- Geraet an Wirt, STANDARD,
// Empfaenger SCHNITTSTELLE. Das letzte ist der Punkt: eine
// Berichtsbeschreibung gehoert der Schnittstelle und nicht dem Geraet,
// und wer sie mit 0x80 anfordert, bekommt von manchem Geraet einen
// Stall und von manchem etwas anderes.
//
// Die Laenge steht im HID-Deskriptor der Konfiguration (`parse`, Art
// 0x21). Ohne sie wird gar nicht erst gefragt -- eine geratene Laenge
// waere entweder zu kurz (halbe Beschreibung) oder zu lang (Stall).
fn hid_descriptor(state: u64, d: u64, slot: u64, iface: u64) -> bool {
    let n: u64 = dg(state, d, D_RDLEN)
    if n == 0 || n > hidrep.RAW_MAX {
        s(state, S_RDFAIL, g(state, S_RDFAIL) + 1)
        return false
    }
    let dst: u64 = hidrep.raw_of(state, d)
    zero(dst, n)
    if xhci.control(state, slot, 0x81, REQ_GET_DESCRIPTOR,
        (0x22 << 8), iface, n, dst, true) < (n as i64) {
        s(state, S_RDFAIL, g(state, S_RDFAIL) + 1)
        return false
    }
    s(state, S_RDLEN, n)
    if hidrep.parse(state, d, dst, n) != hidrep.E_OK {
        s(state, S_RDFAIL, g(state, S_RDFAIL) + 1)
        return false
    }
    hidrep.say(state, d)
    return true
}

// Was das Geraet IST, steht in seiner Beschreibung und nicht in seiner
// Klasse. Ein Geraet kann beides sein (viele Tastaturen melden neben
// den Tasten eine Verbrauchersteuerung); dann zaehlt es hier als
// Tastatur UND meldet die Multimediatasten mit.
fn hid_claim(state: u64, d: u64) {
    let art: u64 = hidrep.kind(state, d)
    if (art & hidrep.K_KBD) != 0 {
        ds(state, d, D_DRIVER, DRV_KBD)
        if g(state, S_KBD) == 0 {
            s(state, S_KBD, d + 1)
        }
        return
    }
    if (art & hidrep.K_MOUSE) != 0 || (art & hidrep.K_PAD) != 0 {
        ds(state, d, D_DRIVER, DRV_MOUSE)
        if g(state, S_MOUSE) == 0 {
            s(state, S_MOUSE, d + 1)
        }
        return
    }
    // Etwas anderes (reine Verbrauchersteuerung zum Beispiel). Die
    // Berichte gehen trotzdem durch den Zerleger; was `hidin` darin
    // nicht kennt, faellt weg, statt falsch gedeutet zu werden.
    ds(state, d, D_DRIVER, DRV_HIDGEN)
}

fn arm(state: u64, d: u64) {
    xhci.int_queue(state, dg(state, d, D_SLOT), dg(state, d, D_INTDCI),
        report_buf(state, d), dg(state, d, D_INTLEN))
}

fn report_buf(state: u64, d: u64) -> u64 {
    return state + REPORT_OFF + d * 64
}

// Der Unterbrechungsweg. `trap.fi` ruft das; alles darunter ist die
// Kette, die ein Tastendruck bis in die Zeilendisziplin nimmt.
fn irq(state: u64) {
    xhci.irq(state)
    service(state)
}

// Was seit dem letzten Blick fertig wurde. Wird aus der Unterbrechung
// gerufen UND aus dem Abfragebetrieb der Gegenprobe -- beide Wege enden
// hier, und deshalb misst die Gegenprobe wirklich dieselbe Auswertung.
fn service(state: u64) {
    if g(state, S_READY) == 0 {
        return
    }
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_INTDCI) != 0 {
            let i: u64 = xhci.ep_find(state, dg(state, d, D_SLOT),
                dg(state, d, D_INTDCI))
            if i < xhci.MAX_EP {
                let seq: u64 = xhci.ep_seq(state, i)
                if seq != dg(state, d, D_SEQ) {
                    ds(state, d, D_SEQ, seq)
                    if xhci.ep_code(state, i) == xhci.CC_SUCCESS
                        || xhci.ep_code(state, i) == xhci.CC_SHORT {
                        s(state, S_REPORTS, g(state, S_REPORTS) + 1)
                        deliver(state, d)
                    }
                    arm(state, d)
                }
            }
        }
        d = d + 1
    }
}

// DER ZWEITE WEG ZU DENSELBEN BERICHTEN, und er ist eine GEGENPROBE und
// kein Ersatz. Mit `usbnoirq` bleibt der Meldevektor maskiert: der
// Regler bewegt die Daten weiterhin, aber niemand sagt es dem Kernel --
// und dann kommt keine Taste an. Mit `usbpoll` sieht der Kernel selbst
// nach, und dieselben Tasten kommen an. Der Unterschied zwischen den
// beiden Laeufen ist der Beweis, dass die Meldung wirklich das ist, was
// die Eingabe traegt, und nicht eine Verzierung neben einer
// Abfrageschleife.
fn poll(state: u64) {
    if g(state, S_READY) == 0 {
        return
    }
    xhci.drain(state)
    service(state)
}

fn deliver(state: u64, d: u64) {
    // RUNDE HID: EINE WEICHE UND ZWEI WEGE, DIE BEIDE IN `hidin.fi`
    // ENDEN. Oben der generische -- der Bericht wird nach seiner
    // Beschreibung gelesen. Unten der Rueckfallweg mit dem festen
    // Format des Boot-Protokolls. Was danach kommt (Abtastcode,
    // Zeilendisziplin, Fensterfokus, PS/2-Paket), ist fuer beide
    // dasselbe und steht nur einmal da.
    if dg(state, d, D_GENERIC) == 1 {
        hidin.report(state, d, report_buf(state, d), dg(state, d, D_INTLEN))
        return
    }
    if dg(state, d, D_DRIVER) == DRV_KBD {
        kbd_report(state, d)
        return
    }
    if dg(state, d, D_DRIVER) == DRV_MOUSE {
        mouse_report(state, d)
    }
}

// Acht Oktett: ein Zusatztastenfeld, ein leeres, sechs Gebrauchscodes.
// Was NEU dabei ist, ist gedrueckt worden. Was fehlt, ist losgelassen --
// und das interessiert nur bei Umschalt und Steuerung, weil der
// PS/2-Weg fuer alles andere ohnehin nur die Druecken-Codes ansieht.
fn kbd_report(state: u64, d: u64) {
    let vor: u64 = hidin.keys(state)
    hidin.kbd_report_boot(state, d, report_buf(state, d))
    // `usb: keys=N` zaehlt seit Runde K17 die Tasten, die WIRKLICH
    // durch den USB-Weg gegangen sind, und `tools/k17/run.sh` haengt
    // daran. Die Zahl bleibt, auch wenn die Auswertung eine Etage
    // tiefer gewandert ist.
    s(state, S_KEYS, g(state, S_KEYS) + (hidin.keys(state) - vor))
}

fn press(state: u64, u: u64) {
    hidin.press(state, u)
    s(state, S_KEYS, g(state, S_KEYS) + 1)
}

fn mouse_report(state: u64, d: u64) {
    hidin.mouse_report_boot(state, d, report_buf(state, d),
        dg(state, d, D_INTLEN))
    s(state, S_MOVES, g(state, S_MOVES) + 1)
}

// ------------------------------------------------------ Massenspeicher
//
// Bulk-Only-Transport: ein Befehlsblock hin, Daten hin oder her, eine
// Quittung zurueck. Darin steckt ein SCSI-Befehl -- derselbe, den eine
// SATA-Platte auch verstuende. Das ist der Grund, warum ein Stick
// ueberhaupt an `blk.fi` passt: er spricht Bloecke.

const CBW_SIG: u64 = 0x43425355
const CSW_SIG: u64 = 0x53425355

fn msc_ready(state: u64) -> bool {
    return g(state, S_MSC) != 0
}

fn msc_blocks(state: u64) -> u64 {
    return g(state, S_BLOCKS)
}

fn msc_bsize(state: u64) -> u64 {
    return g(state, S_BSIZE)
}

fn msc_dev(state: u64) -> u64 {
    return g(state, S_MSC) - 1
}

fn set8(p: u64, i: u64, v: u64) {
    __mmio_write8((p + i) as *mut u8, (v & 0xFF) as u8)
}

fn set32le(p: u64, i: u64, v: u64) {
    set8(p, i, v)
    set8(p, i + 1, v >> 8)
    set8(p, i + 2, v >> 16)
    set8(p, i + 3, v >> 24)
}

fn be32(p: u64, i: u64) -> u64 {
    return (b8(p, i) << 24) | (b8(p, i + 1) << 16) | (b8(p, i + 2) << 8)
        | b8(p, i + 3)
}

fn set_be32(p: u64, i: u64, v: u64) {
    set8(p, i, v >> 24)
    set8(p, i + 1, v >> 16)
    set8(p, i + 2, v >> 8)
    set8(p, i + 3, v)
}

// Ein Befehl. `cdb` steht schon im Befehlsblock ab Oktett 15; hier wird
// nur der Kopf gefuellt, gesendet, Daten bewegt und die Quittung
// geprueft. Rueckgabe: true, wenn das Geraet 0 gemeldet hat.
fn bot(state: u64, d: u64, cdb_len: u64, data: u64, dlen: u64,
    dir_in: bool) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let cbw: u64 = state + CBW_OFF
    let csw: u64 = state + CSW_OFF
    s(state, S_LASTDATA, 0)
    let tag: u64 = g(state, S_TAG) + 1
    s(state, S_TAG, tag)
    set32le(cbw, 0, CBW_SIG)
    set32le(cbw, 4, tag)
    set32le(cbw, 8, dlen)
    var flags: u64 = 0
    if dir_in {
        flags = 0x80
    }
    set8(cbw, 12, flags)
    set8(cbw, 13, 0) // Einheit 0
    set8(cbw, 14, cdb_len)
    s(state, S_MSCIO, g(state, S_MSCIO) + 1)
    if xhci.bulk(state, slot, dg(state, d, D_OUTDCI), cbw, 31) != 31 {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        return false
    }
    if dlen > 0 {
        var dci: u64 = dg(state, d, D_OUTDCI)
        if dir_in {
            dci = dg(state, d, D_INDCI)
        }
        let n: i64 = xhci.bulk(state, slot, dci, data, dlen)
        if n > 0 {
            s(state, S_LASTDATA, n as u64)
        } else {
            s(state, S_LASTDATA, 0)
        }
        if n < 0 {
            // Ein STALL im Datenteil ist kein Weltuntergang -- das
            // Protokoll sieht ihn vor. Der Endpunkt wird
            // zurueckgesetzt, und die Quittung wird trotzdem geholt;
            // sie sagt, was wirklich war.
            unstall(state, d, dci)
        }
    }
    zero(csw, 16)
    if xhci.bulk(state, slot, dg(state, d, D_INDCI), csw, 13) != 13 {
        unstall(state, d, dg(state, d, D_INDCI))
        if xhci.bulk(state, slot, dg(state, d, D_INDCI), csw, 13) != 13 {
            s(state, S_MSCERR, g(state, S_MSCERR) + 1)
            return false
        }
    }
    if b8(csw, 0) != (CSW_SIG & 0xFF) || b8(csw, 1) != ((CSW_SIG >> 8) & 0xFF) {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        return false
    }
    if b8(csw, 12) != 0 {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        return false
    }
    return true
}

fn unstall(state: u64, d: u64, dci: u64) {
    let slot: u64 = dg(state, d, D_SLOT)
    let i: u64 = xhci.ep_find(state, slot, dci)
    if i >= xhci.MAX_EP {
        return
    }
    // CLEAR_FEATURE(ENDPOINT_HALT) an das GERAET und `Reset Endpoint` an
    // den REGLER: beide Seiten haben den Anschlag gemerkt, und beide
    // muessen ihn vergessen.
    var epaddr: u64 = dci / 2
    if (dci & 1) != 0 {
        epaddr = epaddr | 0x80
    }
    xhci.reset_endpoint(state, slot, dci)
    xhci.control(state, slot, 0x02, REQ_CLEAR_FEATURE, 0, epaddr, 0, 0, false)
    xhci.set_dequeue(state, slot, dci, i)
}

fn cdb(state: u64) -> u64 {
    return state + CBW_OFF + 15
}

fn msc_start(state: u64, d: u64) -> bool {
    var s_msc: [u8; 11] = "usb: msc \0\0"
    var s_blk: [u8; 8] = "blocks=\0"
    var s_bs: [u8; 9] = "  bsize=\0"
    var s_inq: [u8; 7] = "  inq=\0"
    var s_bad: [u8; 26] = "usb: msc unusable bsize=\0\0"

    if dg(state, d, D_INDCI) == 0 || dg(state, d, D_OUTDCI) == 0 {
        return false
    }
    let buf: u64 = state + DESC_OFF
    // INQUIRY: 36 Oktett, und die Oktette 8..15 sind der Hersteller --
    // die einzige Stelle, an der ein Stick sagt, wer er ist.
    zero(cdb(state), 16)
    zero(buf, 64)
    set8(cdb(state), 0, 0x12)
    set8(cdb(state), 4, 36)
    if !bot(state, d, 6, buf, 36, true) {
        return false
    }
    let inq_len: u64 = g(state, S_LASTDATA)
    // TEST UNIT READY, bis zu fuenfmal. Ein Stick, der gerade erst
    // angesteckt wurde, meldet beim ersten Mal oft "nicht bereit"; das
    // ist kein Fehler, sondern der Grund, warum es diesen Befehl gibt.
    var tries: u64 = 0
    var up: bool = false
    while tries < 5 && !up {
        zero(cdb(state), 16)
        set8(cdb(state), 0, 0x00)
        if bot(state, d, 6, 0, 0, false) {
            up = true
        } else {
            sense(state, d)
        }
        tries = tries + 1
    }
    if !up {
        return false
    }
    // Die Antwort auf READ CAPACITY kommt in einen EIGENEN Puffer.
    // Der erste Entwurf schrieb sie ueber die INQUIRY-Antwort, und
    // danach war der Herstellername in der Meldung leer -- ein Fehler,
    // der nur in der AUSGABE stand und nicht im Treiber, und der genau
    // deshalb eine Stunde gekostet haette, wenn ihn niemand gemeldet
    // haette.
    let cap: u64 = buf + 128
    zero(cdb(state), 16)
    zero(cap, 32)
    set8(cdb(state), 0, 0x25) // READ CAPACITY (10)
    if !bot(state, d, 10, cap, 8, true) {
        return false
    }
    let last: u64 = be32(cap, 0)
    let bs: u64 = be32(cap, 4)
    if bs != 512 {
        // Ehrlich statt still: `blk.fi` spricht 512 Oktett je Block,
        // und ein Stick mit 4096 waere ein anderer Treiber. Er wird
        // gemeldet und NICHT eingehaengt.
        serial.puts((&s_bad[0]) as u64)
        serial.dec(bs)
        serial.nl()
        return false
    }
    s(state, S_BLOCKS, last + 1)
    s(state, S_BSIZE, bs)
    serial.puts((&s_msc[0]) as u64)
    serial.puts((&s_blk[0]) as u64)
    serial.dec(last + 1)
    serial.puts((&s_bs[0]) as u64)
    serial.dec(bs)
    serial.puts((&s_inq[0]) as u64)
    serial.dec(inq_len)
    serial.put(32 as u8)
    var i: u64 = 8
    while i < 16 {
        let c: u64 = b8(buf, i)
        if c >= 32 && c < 127 {
            serial.put(c as u8)
        }
        i = i + 1
    }
    serial.nl()
    return true
}

fn sense(state: u64, d: u64) {
    let buf: u64 = state + DESC_OFF + 256
    zero(cdb(state), 16)
    zero(buf, 32)
    set8(cdb(state), 0, 0x03)
    set8(cdb(state), 4, 18)
    bot(state, d, 6, buf, 18, true)
}

// Die zwei Zeilen, an denen `blk.fi` haengt. Ein Block, 512 Oktett, und
// die Schicht darueber erfaehrt nicht, dass er ueber vier Endpunkte und
// drei Uebertragungen gekommen ist.
fn msc_read(state: u64, lba: u64, dst: u64) -> bool {
    if g(state, S_MSC) == 0 {
        return false
    }
    let d: u64 = msc_dev(state)
    let tmp: u64 = state + BLK_OFF
    zero(cdb(state), 16)
    set8(cdb(state), 0, 0x28) // READ (10)
    set_be32(cdb(state), 2, lba)
    set8(cdb(state), 7, 0)
    set8(cdb(state), 8, 1)
    if !bot(state, d, 10, tmp, 512, true) {
        return false
    }
    copy(tmp, dst, 512)
    return true
}

fn msc_write(state: u64, lba: u64, src: u64) -> bool {
    if g(state, S_MSC) == 0 {
        return false
    }
    let d: u64 = msc_dev(state)
    let tmp: u64 = state + BLK_OFF
    copy(src, tmp, 512)
    zero(cdb(state), 16)
    set8(cdb(state), 0, 0x2A) // WRITE (10)
    set_be32(cdb(state), 2, lba)
    set8(cdb(state), 7, 0)
    set8(cdb(state), 8, 1)
    return bot(state, d, 10, tmp, 512, false)
}

fn copy(from: u64, to: u64, n: u64) {
    var i: u64 = 0
    while i < n / 8 {
        __mmio_write64((to + i * 8) as *mut u64,
            __mmio_read64((from + i * 8) as *mut u64))
        i = i + 1
    }
}

// ------------------------------------------------------ abziehen

// Nachsehen, ob ein Geraet verschwunden ist. Wird aus dem Zeitgeber
// gerufen und aus der Gegenprobe -- und der Unterschied zwischen
// "abgezogen" und "war nie da" steht in der Bitkarte S_ATTACHED.
fn unplug_check(state: u64) {
    if g(state, S_READY) == 0 {
        return
    }
    let n: u64 = xhci.ports(state)
    var p: u64 = 1
    while p <= n {
        if xhci.port_has_change(state, p) {
            xhci.port_clear_changes(state, p)
            let now: bool = xhci.port_connected(state, p)
            if was_there(state, p) && !now {
                gone(state, p)
            } else if !was_there(state, p) && now {
                s(state, S_HOTPLUGS, g(state, S_HOTPLUGS) + 1)
                mark(state, p)
                attach(state, p)
            }
        }
        p = p + 1
    }
}

fn gone(state: u64, p: u64) {
    var s_gone: [u8; 18] = "usb: unplug port=\0"
    var s_drv: [u8; 9] = " driver=\0"
    unmark(state, p)
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_PORT) == p {
            serial.puts((&s_gone[0]) as u64)
            serial.dec(p)
            serial.puts((&s_drv[0]) as u64)
            drv_name(dg(state, d, D_DRIVER))
            serial.nl()
            if g(state, S_KBD) == d + 1 {
                s(state, S_KBD, 0)
            }
            if g(state, S_MOUSE) == d + 1 {
                s(state, S_MOUSE, 0)
            }
            if g(state, S_MSC) == d + 1 {
                s(state, S_MSC, 0)
                s(state, S_BLOCKS, 0)
            }
            drop_dev(state, d)
            s(state, S_NDEV, g(state, S_NDEV) - 1)
            s(state, S_UNPLUGS, g(state, S_UNPLUGS) + 1)
        }
        d = d + 1
    }
}

// DIE GEGENPROBE ZUM ABZIEHEN, ohne dass jemand am Stecker zieht: der
// Anschluss wird fuer weg erklaert. Genau das, was passiert, wenn eine
// Hand den Stick herauszieht -- der Regler meldet einen Anschlusswechsel
// und CCS faellt auf null. Hier wird nur der zweite Teil nachgestellt,
// und was danach geschieht (kein Panik, ENODEV auf offenen Deskriptoren)
// ist dasselbe.
fn unplug_now(state: u64) {
    if g(state, S_READY) == 0 {
        return
    }
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 {
            gone(state, dg(state, d, D_PORT))
        }
        d = d + 1
    }
}

// ------------------------------------------------------- die Auskunft

fn say(state: u64) {
    var s_h: [u8; 14] = "usb: devices=\0"
    var s_k: [u8; 6] = " kbd=\0"
    var s_m: [u8; 8] = " mouse=\0"
    var s_s: [u8; 6] = " msc=\0"
    var s_e: [u8; 8] = " enums=\0"
    var s_f: [u8; 8] = " fails=\0"
    var s_ev: [u8; 9] = " events=\0"
    var s_i: [u8; 7] = " irqs=\0"
    var s_c: [u8; 7] = " cmds=\0"
    serial.puts((&s_h[0]) as u64)
    serial.dec(g(state, S_NDEV))
    serial.puts((&s_k[0]) as u64)
    serial.dec(yes(have_kbd(state)))
    serial.puts((&s_m[0]) as u64)
    serial.dec(yes(have_mouse(state)))
    serial.puts((&s_s[0]) as u64)
    serial.dec(yes(msc_ready(state)))
    serial.puts((&s_e[0]) as u64)
    serial.dec(g(state, S_ENUMS))
    serial.puts((&s_f[0]) as u64)
    serial.dec(g(state, S_FAILS))
    serial.puts((&s_ev[0]) as u64)
    serial.dec(xhci.events(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(xhci.irqs(state))
    serial.puts((&s_c[0]) as u64)
    serial.dec(xhci.cmds(state))
    serial.nl()
}

// WAS DER BAUM IN DIESEM LAUF WIRKLICH GETAN HAT. Diese Zeile steht am
// ENDE des Laufs, nicht am Anfang -- alles darin ist eine Zahl, die
// waehrend der Arbeit entstanden ist, und `tools/k17/run.sh` liest jede
// einzelne zurueck. Eine Runde, die eine Tastatur baut und nicht sagen
// kann, wie viele Tasten ueber sie gekommen sind, hat nichts vorzuweisen.
//
// `keys` ist dabei die wichtigste: sie zaehlt NUR die Tasten, die durch
// `usb.press` gegangen sind. Steht dort null und in der Shell trotzdem
// Text, dann hat die PS/2-Tastatur getippt und nicht die USB-Tastatur --
// genau der Selbstbetrug, gegen den diese Zahl da ist.
fn report(state: u64) {
    var s_h: [u8; 11] = "usb: keys=\0"
    var s_r: [u8; 10] = " reports=\0"
    var s_m: [u8; 8] = " moves=\0"
    var s_e: [u8; 9] = " events=\0"
    var s_i: [u8; 7] = " irqs=\0"
    var s_x: [u8; 10] = " xhcierr=\0"
    var s_o: [u8; 8] = " mscio=\0"
    var s_c: [u8; 9] = " mscerr=\0"
    var s_u: [u8; 10] = " unplugs=\0"
    var s_p: [u8; 11] = " hotplugs=\0"
    var s_d: [u8; 10] = " devices=\0"
    var s_t: [u8; 11] = " selftest=\0"
    var s_mx: [u8; 5] = " mx=\0"
    var s_my: [u8; 5] = " my=\0"
    var s_mb: [u8; 7] = " mbtn=\0"
    var s_mp: [u8; 7] = " mpkt=\0"
    var s_mc: [u8; 7] = " mclk=\0"
    if g(state, S_READY) == 0 {
        return
    }
    serial.puts((&s_h[0]) as u64)
    serial.dec(g(state, S_KEYS))
    serial.puts((&s_r[0]) as u64)
    serial.dec(g(state, S_REPORTS))
    serial.puts((&s_m[0]) as u64)
    serial.dec(g(state, S_MOVES))
    serial.puts((&s_e[0]) as u64)
    serial.dec(xhci.events(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(xhci.irqs(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(xhci.errors(state))
    serial.puts((&s_o[0]) as u64)
    serial.dec(g(state, S_MSCIO))
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, S_MSCERR))
    serial.puts((&s_u[0]) as u64)
    serial.dec(g(state, S_UNPLUGS))
    serial.puts((&s_p[0]) as u64)
    serial.dec(g(state, S_HOTPLUGS))
    serial.puts((&s_d[0]) as u64)
    serial.dec(g(state, S_NDEV))
    serial.puts((&s_t[0]) as u64)
    serial.dec(selftest(state))
    // Wo der Zeiger steht, welche Taste haengt und wie viele Pakete
    // durchgegangen sind. Die drei Zahlen kommen aus `ps2m` und NICHT
    // aus diesem Treiber -- das ist der Sinn der Sache: eine USB-Maus,
    // die ihre eigene Position fuehrte, waere ein zweites Zeigegeraet
    // und kein Geraet am selben Zeiger.
    serial.puts((&s_mx[0]) as u64)
    serial.dec(gfx.mouse_x(state))
    serial.puts((&s_my[0]) as u64)
    serial.dec(gfx.mouse_y(state))
    serial.puts((&s_mb[0]) as u64)
    serial.dec(gfx.mouse_buttons(state))
    serial.puts((&s_mp[0]) as u64)
    serial.dec(gfx.mouse_packets(state))
    serial.puts((&s_mc[0]) as u64)
    serial.dec(gfx.mouse_clicks(state))
    serial.nl()
    hid_report(state)
}

// RUNDE HID: EINE EIGENE ZEILE, und das mit Absicht. Die Zeile `usb:`
// wird seit K17 von `tools/k17/run.sh` Wort fuer Wort gelesen; wer eine
// Zahl dazwischenschiebt, bricht einen Test, der mit dieser Runde
// nichts zu tun hat.
fn hid_report(state: u64) {
    var s_a: [u8; 10] = "hid: gen=\0"
    var s_b: [u8; 8] = " rdlen=\0"
    var s_c: [u8; 9] = " rdfail=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(g(state, S_GENDEV))
    serial.puts((&s_b[0]) as u64)
    serial.dec(g(state, S_RDLEN))
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, S_RDFAIL))
    serial.nl()
    hidin.say(state)
}

// WAS RING 3 UEBER DIESEN BAUM ERFAHREN DARF. Eine Zahl je Frage, ueber
// SYS_OSUM_USBSTAT (1701) -- damit `/bin/k17` jede Zusage dieser Runde
// von AUSSEN messen kann und nicht aus der seriellen Leitung des Kerns
// abschreiben muss. Dieselbe Bauart wie SYS_OSUM_MNTSTAT aus Runde K14.
fn stat(state: u64, what: u64) -> u64 {
    if what == 0 {
        return yes(ready(state))
    }
    if what == 1 {
        return g(state, S_NDEV)
    }
    if what == 2 {
        return yes(have_kbd(state))
    }
    if what == 3 {
        return yes(have_mouse(state))
    }
    if what == 4 {
        return yes(msc_ready(state))
    }
    if what == 5 {
        return g(state, S_BLOCKS)
    }
    if what == 6 {
        return g(state, S_BSIZE)
    }
    if what == 7 {
        return g(state, S_KEYS)
    }
    if what == 8 {
        return g(state, S_REPORTS)
    }
    if what == 9 {
        return g(state, S_MOVES)
    }
    if what == 10 {
        return xhci.events(state)
    }
    if what == 11 {
        return xhci.irqs(state)
    }
    if what == 12 {
        return g(state, S_ENUMS)
    }
    if what == 13 {
        return g(state, S_UNPLUGS)
    }
    if what == 14 {
        return g(state, S_HOTPLUGS)
    }
    if what == 15 {
        return g(state, S_MSCIO)
    }
    if what == 16 {
        return g(state, S_MSCERR)
    }
    if what == 17 {
        return xhci.errors(state)
    }
    if what == 18 {
        return xhci.ports(state)
    }
    if what == 19 {
        return xhci.slots(state)
    }
    if what == 20 {
        return xhci.ctx_size(state)
    }
    if what == 21 {
        return xhci.cmds(state)
    }
    if what == 22 {
        return selftest(state)
    }
    if what == 23 {
        return g(state, S_FAILS)
    }
    return 0
}

// Der Selbsttest dieser Schicht: Zusagen, die sie ueber sich selbst
// machen kann, ohne dass ein Testlaeufer sie ihr vorsagt. Rueckgabe: wie
// viele davon halten.
fn selftest(state: u64) -> u64 {
    var n: u64 = 0
    if xhci.ready(state) {
        n = n + 1
    }
    if xhci.ports(state) > 0 && xhci.ports(state) < 256 {
        n = n + 1
    }
    if xhci.slots(state) > 0 {
        n = n + 1
    }
    if xhci.ctx_size(state) == 32 || xhci.ctx_size(state) == 64 {
        n = n + 1
    }
    if xhci.cmds(state) > 0 {
        n = n + 1
    }
    if xhci.events(state) >= xhci.cmds(state) {
        n = n + 1
    }
    if g(state, S_NDEV) <= MAX_DEV {
        n = n + 1
    }
    if xhci.errors(state) == 0 {
        n = n + 1
    }
    return n
}
