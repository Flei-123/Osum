// SPDX-License-Identifier: GPL-2.0-only
// kernel/ebpftest.fi -- Runde O-EBPF: DIE KREISPROBE IM KERN.
//
// Diese Datei baut eBPF-Programme aus einzelnen Befehlen zusammen,
// laesst sie laufen und vergleicht das Ergebnis mit einer Zahl, die
// VORHER feststeht. Sie ist der Grund, aus dem im Bericht Zahlen und
// keine Adjektive stehen.
//
// WARUM DIE PROBE IM KERN LAEUFT UND NICHT AUF DEM WIRT. Ein Deuter
// laesst sich auf dem Wirt viel bequemer pruefen -- und dort rechnet er
// mit der Arithmetik des Wirts, nicht mit der des Kerns. Genau der
// Unterschied ist hier die Gefahr: Firn prueft Ueberlaeufe, und ein
// vergessenes `+%` faellt auf dem Wirt vielleicht nicht auf, im Kern
// aber als `osum_panic`. Also laeuft die Probe dort, wo der Code auch
// arbeitet.
//
// JEDE PROBE PRUEFT EINE ZUSAGE, und die Nummern hier sind dieselben,
// die `tools/ebpf/run.sh` auf der seriellen Leitung wiederfindet. Eine
// Probe, die nichts findet und trotzdem OK meldet, gilt in diesem Repo
// als Fehler -- deshalb steht bei jeder GEGENPROBE eine, die scheitern
// MUSS.

profile kernel

import kstate
import serial
import time
import ebpf
import ebpfmap
import ebpfver
import ebpfhook

export { selftest, bench, passed, failed, load_drop_icmp, drop_probe }

// Die Zaehler stehen im Messpuffer der Maschine, damit diese Datei
// keine eigene Seite braucht.
// DER RAHMEN DER PROBE liegt im Messpuffer der Maschine.
const T_FRAME: u64 = 0x5800

// DIE ZAEHLER LIEGEN IM HAKENBEREICH UND NICHT IM MASCHINENBEREICH,
// und das ist keine Laune. Zwei Fassungen sind vorher daran
// gescheitert:
//
//   1. Sie lagen auf 0x5800 -- dort faengt der Messpuffer an, und
//      `bench` schrieb beim Bauen seines Rahmens darueber.
//   2. Sie lagen auf 0x5E00, also hinter dem Rahmen -- und trotzdem
//      meldete die Probe `gut=4` statt `gut=40`. Der Grund: `t_hook`
//      ruft `ebpfhook.init`, und das ruft `ebpf.init`, und DAS loescht
//      den GANZEN Maschinenbereich, EBPF_MAX Oktette am Stueck. Die
//      Zaehler waren jedes Mal mittendrin.
//
// Eine Probe, die ihre eigenen Zaehler dorthin legt, wo das Geprueefte
// aufraeumt, misst sich selbst kaputt. Sie liegen deshalb im letzten
// Viertel des Hakenbereichs, den keine `init` dieser Runde anfasst,
// nachdem die Probe begonnen hat -- `t_hook` ruft `ebpfhook.init` als
// ERSTES und schreibt die Zaehler danach nicht mehr.
const T_PASS: u64 = 0x0F00
const T_FAIL: u64 = 0x0F08

fn tb(off: u64) -> u64 {
    return kstate.EBPF_OFF + off
}

// Die Zaehler der Probe, im Hakenbereich (siehe oben).
fn cb(off: u64) -> u64 {
    return kstate.EBPFHOOK_OFF + off
}

fn passed(state: u64) -> u64 {
    return kstate.get(state, cb(T_PASS))
}

fn failed(state: u64) -> u64 {
    return kstate.get(state, cb(T_FAIL))
}

// ------------------------------------------------------ die Meldung

fn ok(state: u64, name: u64, got: u64) {
    var s_o: [u8; 13] = "ebpf: OK    \0"
    var s_e: [u8; 3] = "=\0\0"
    serial.puts((&s_o[0]) as u64)
    serial.puts(name)
    serial.puts((&s_e[0]) as u64)
    serial.dec(got)
    serial.nl()
    kstate.add(state, cb(T_PASS), 1)
}

fn bad(state: u64, name: u64, got: u64, want: u64) {
    var s_f: [u8; 13] = "ebpf: FAIL  \0"
    var s_g: [u8; 8] = " ist=\0\0\0"
    var s_w: [u8; 8] = " soll=\0\0"
    serial.puts((&s_f[0]) as u64)
    serial.puts(name)
    serial.puts((&s_g[0]) as u64)
    serial.dec(got)
    serial.puts((&s_w[0]) as u64)
    serial.dec(want)
    serial.nl()
    kstate.add(state, cb(T_FAIL), 1)
}

fn expect(state: u64, name: u64, got: u64, want: u64) {
    if got == want {
        ok(state, name, got)
    } else {
        bad(state, name, got, want)
    }
}

// ------------------------------------------- Befehle zusammenbauen
//
// Ein Befehl als 64-Bit-Wort, in der Anordnung des Befehlssatzes.
// `off` und `imm` werden abgeschnitten, nicht geprueft -- hier werden
// absichtlich auch krumme Programme gebaut.
fn insn(op: u64, dst: u64, src: u64, off: u64, imm: u64) -> u64 {
    return (op & 0xFF)
        | ((dst & 0x0F) << 8)
        | ((src & 0x0F) << 12)
        | ((off & 0xFFFF) << 16)
        | ((imm & 0xFFFFFFFF) << 32)
}

// Ein Programm in Platz `slot` schreiben und seine Laenge setzen.
// Umgeht `ebpfhook.load` absichtlich NICHT -- die Probe soll denselben
// Weg nehmen wie ein Programm aus Ring 3.
fn put(state: u64, slot: u64, k: u64, w: u64) {
    ebpf.insn_put(ebpf.prog_at(state, slot), k, w)
}

// ================================================================
// DIE PROBEN
// ================================================================

fn selftest(state: u64) {
    kstate.set(state, cb(T_PASS), 0)
    kstate.set(state, cb(T_FAIL), 0)

    var s_head: [u8; 26] = "ebpf: Kreisprobe beginnt\0\0"
    serial.puts((&s_head[0]) as u64)
    serial.nl()

    t_alu(state)
    t_jmp(state)
    t_mem(state)
    t_ld64(state)
    t_verifier(state)
    t_maps(state)
    t_hook(state)

    var s_e: [u8; 15] = "ebpf: proben \0\0"
    var s_p: [u8; 8] = " gut=\0\0\0"
    var s_f: [u8; 9] = " boese=\0\0"
    serial.puts((&s_e[0]) as u64)
    serial.puts((&s_p[0]) as u64)
    serial.dec(passed(state))
    serial.puts((&s_f[0]) as u64)
    serial.dec(failed(state))
    serial.nl()
}

// ---------------------------------------------------------- 1. Rechnen
//
// Ein Programm, das eine Zahl ausrechnet und zurueckgibt. Wenn die
// Maschine rechnen kann, steht am Ende genau diese Zahl in r0.
fn t_alu(state: u64) {
    var n_add: [u8; 12] = "alu.add64\0\0\0"
    var n_sub: [u8; 12] = "alu.sub32\0\0\0"
    var n_mul: [u8; 12] = "alu.mul\0\0\0\0\0"
    var n_sh: [u8; 12] = "alu.arsh\0\0\0\0"
    var n_wrap: [u8; 12] = "alu.umlauf\0\0"
    var n_div0: [u8; 12] = "alu.div0\0\0\0\0"

    // r0 = 40; r0 += 2; exit   -> 42
    var i: u64 = 0
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 40)) // MOV64 r0, 40
    put(state, 0, 1, insn(0x07, 0, 0, 0, 2)) // ADD64 r0, 2
    put(state, 0, 2, insn(0x95, 0, 0, 0, 0)) // EXIT
    expect(state, (&n_add[0]) as u64, load_run(state, 0, 3, 0, 0), 42)

    // 32-Bit-Subtraktion schneidet ab: 5 - 7 = 0xFFFFFFFE (nicht -2)
    put(state, 0, 0, insn(0xB4, 0, 0, 0, 5)) // MOV32 r0, 5
    put(state, 0, 1, insn(0x14, 0, 0, 0, 7)) // SUB32 r0, 7
    put(state, 0, 2, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_sub[0]) as u64, load_run(state, 0, 3, 0, 0),
        0xFFFFFFFE)

    // r0 = 6 * 7
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 6))
    put(state, 0, 1, insn(0x27, 0, 0, 0, 7)) // MUL64 r0, 7
    put(state, 0, 2, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_mul[0]) as u64, load_run(state, 0, 3, 0, 0), 42)

    // Arithmetisches Rechtsschieben: -16 >> 2 = -4
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 0xFFFFFFF0)) // MOV64 r0, -16
    put(state, 0, 1, insn(0xC7, 0, 0, 0, 2)) // ARSH64 r0, 2
    put(state, 0, 2, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_sh[0]) as u64, load_run(state, 0, 3, 0, 0),
        0xFFFFFFFFFFFFFFFC)

    // DER UMLAUF. 0 - 1 muss 0xFFFF... ergeben und darf den Kern NICHT
    // anhalten. Genau dieser Fall ist der Grund, aus dem in `ebpf.fi`
    // ueberall `-%` steht: mit geprueftem `-` waere hier Schluss.
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 0)) // MOV64 r0, 0
    put(state, 0, 1, insn(0x17, 0, 0, 0, 1)) // SUB64 r0, 1
    put(state, 0, 2, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_wrap[0]) as u64, load_run(state, 0, 3, 0, 0),
        0xFFFFFFFFFFFFFFFF)

    // Teilung durch null ergibt null und ist KEIN Abbruch (Befehlssatz).
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 7))
    put(state, 0, 1, insn(0xB7, 1, 0, 0, 0)) // MOV64 r1, 0
    put(state, 0, 2, insn(0x3F, 0, 1, 0, 0)) // DIV64 r0, r1
    put(state, 0, 3, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_div0[0]) as u64, load_run(state, 0, 4, 0, 0), 0)
}

// ---------------------------------------------------------- 2. Spruenge
fn t_jmp(state: u64) {
    var n_eq: [u8; 12] = "jmp.jeq\0\0\0\0\0"
    var n_ne: [u8; 12] = "jmp.nichtge\0"
    var n_sgt: [u8; 12] = "jmp.jsgt\0\0\0\0"
    var n_ja: [u8; 12] = "jmp.ja\0\0\0\0\0\0"

    // r0 = 1; if r0 == 1 goto +1; r0 = 99; exit   -> 1
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 1))
    put(state, 0, 1, insn(0x15, 0, 0, 1, 1)) // JEQ r0, 1, +1
    put(state, 0, 2, insn(0xB7, 0, 0, 0, 99))
    put(state, 0, 3, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_eq[0]) as u64, load_run(state, 0, 4, 0, 0), 1)

    // Die Gegenprobe: der Sprung wird NICHT genommen -> 99
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 2))
    put(state, 0, 1, insn(0x15, 0, 0, 1, 1)) // JEQ r0, 1, +1
    put(state, 0, 2, insn(0xB7, 0, 0, 0, 99))
    put(state, 0, 3, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_ne[0]) as u64, load_run(state, 0, 4, 0, 0), 99)

    // VORZEICHENBEHAFTETER VERGLEICH. -1 > 1 ist vorzeichenlos WAHR und
    // vorzeichenbehaftet FALSCH. Ein Deuter, der das verwechselt,
    // faellt genau hier auf.
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 0xFFFFFFFF)) // r0 = -1
    put(state, 0, 1, insn(0x65, 0, 0, 1, 1)) // JSGT r0, 1, +1
    put(state, 0, 2, insn(0xB7, 0, 0, 0, 7)) // nicht gesprungen -> 7
    put(state, 0, 3, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_sgt[0]) as u64, load_run(state, 0, 4, 0, 0), 7)

    // Der unbedingte Sprung ueberspringt eine Zuweisung.
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 5))
    put(state, 0, 1, insn(0x05, 0, 0, 1, 0)) // JA +1
    put(state, 0, 2, insn(0xB7, 0, 0, 0, 99))
    put(state, 0, 3, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_ja[0]) as u64, load_run(state, 0, 4, 0, 0), 5)
}

// ------------------------------------------------------- 3. Speicher
//
// Der Stapel und der Paketpuffer, lesend und schreibend, in allen vier
// Breiten.
fn t_mem(state: u64) {
    var n_stk: [u8; 12] = "mem.stapel\0\0"
    var n_b: [u8; 12] = "mem.oktett\0\0"
    var n_pkt: [u8; 12] = "mem.paket\0\0\0"
    var n_oob: [u8; 12] = "mem.daneben\0"

    // Auf den Stapel schreiben und wieder lesen.
    // *(u64 *)(r10 - 8) = 0x1234; r0 = *(u64 *)(r10 - 8); exit
    put(state, 0, 0, insn(0xB7, 1, 0, 0, 0x1234))
    put(state, 0, 1, insn(0x7B, 10, 1, 0xFFF8, 0)) // STX64 [r10-8], r1
    put(state, 0, 2, insn(0x79, 0, 10, 0xFFF8, 0)) // LDX64 r0, [r10-8]
    put(state, 0, 3, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_stk[0]) as u64, load_run(state, 0, 4, 0, 0), 0x1234)

    // Ein OKTETT schreiben und als Oktett lesen: die oberen Bit duerfen
    // nicht mitkommen.
    put(state, 0, 0, insn(0xB7, 1, 0, 0, 0x3ACD))
    put(state, 0, 1, insn(0x73, 10, 1, 0xFFFF, 0)) // STX8 [r10-1], r1
    put(state, 0, 2, insn(0x71, 0, 10, 0xFFFF, 0)) // LDX8 r0, [r10-1]
    put(state, 0, 3, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_b[0]) as u64, load_run(state, 0, 4, 0, 0), 0xCD)

    // DAS PAKET. Ein Rahmen wird gebaut, das Programm liest das erste
    // Oktett -- nachdem es gegen r2 geprueft hat, sonst laesst der
    // Pruefer es nicht durch.
    let f: u64 = state + tb(T_FRAME)
    __mmio_write8(f as *mut u8, 0xAB)
    __mmio_write8((f + 1) as *mut u8, 0xCD)
    // r3 = r1; r3 += 2; if r3 > r2 goto ende; r0 = *(u8*)(r1+1); exit
    put(state, 0, 0, insn(0xBF, 3, 1, 0, 0)) // MOV64 r3, r1
    put(state, 0, 1, insn(0x07, 3, 0, 0, 2)) // ADD64 r3, 2
    put(state, 0, 2, insn(0x2D, 3, 2, 2, 0)) // JGT r3, r2, +2
    put(state, 0, 3, insn(0x71, 0, 1, 1, 0)) // LDX8 r0, [r1+1]
    put(state, 0, 4, insn(0x95, 0, 0, 0, 0))
    put(state, 0, 5, insn(0xB7, 0, 0, 0, 0)) // r0 = 0
    put(state, 0, 6, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_pkt[0]) as u64,
        load_run(state, 0, 7, f, f + 2), 0xCD)

    // DIE GEGENPROBE ZUR ZWEITEN SCHRANKE. Ein Zugriff weit hinter dem
    // Stapel. Der Pruefer weist das Programm ab -- also kommt es gar
    // nicht erst zum Laufen, und `load_run` gibt die Ablehnung als
    // 0xFFFF zurueck.
    put(state, 0, 0, insn(0x79, 0, 10, 0x0100, 0)) // LDX64 r0, [r10+256]
    put(state, 0, 1, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_oob[0]) as u64, load_run(state, 0, 2, 0, 0), 0xFFFF)
}

// ------------------------------------------------- 4. Der 64-Bit-Wert
fn t_ld64(state: u64) {
    var n: [u8; 12] = "ld.imm64\0\0\0\0"
    // r0 = 0x1122334455667788, in zwei Zellen.
    put(state, 0, 0, insn(0x18, 0, 0, 0, 0x55667788))
    put(state, 0, 1, insn(0x00, 0, 0, 0, 0x11223344))
    put(state, 0, 2, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n[0]) as u64, load_run(state, 0, 3, 0, 0),
        0x1122334455667788)
}

// ================================================================
// 5. DER PRUEFER -- die Gegenproben
// ================================================================
//
// Jede dieser Proben MUSS abgewiesen werden. Ein Pruefer, der nichts
// abweist, ist kein Pruefer, und ein Test, der nur das Gute probiert,
// misst nichts.
fn t_verifier(state: u64) {
    var n_back: [u8; 14] = "ver.rueckwae\0\0"
    var n_noex: [u8; 14] = "ver.kein_exit\0"
    var n_uninit: [u8; 14] = "ver.uninit\0\0\0\0"
    var n_r10: [u8; 14] = "ver.r10\0\0\0\0\0\0\0"
    var n_call: [u8; 14] = "ver.fremdruf\0\0"
    var n_targ: [u8; 15] = "ver.sprungziel\0"
    var n_half: [u8; 14] = "ver.halber_ld\0"
    var n_stk: [u8; 14] = "ver.stapel_ob\0"
    var n_pkt: [u8; 14] = "ver.paket_roh\0"
    var n_op: [u8; 14] = "ver.unbekannt\0"
    var n_good: [u8; 14] = "ver.gut\0\0\0\0\0\0\0"

    let code: u64 = ebpf.prog_at(state, 0)

    // (1) Ein Sprung nach hinten -- also eine Schleife.
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 0))
    put(state, 0, 1, insn(0x05, 0, 0, 0xFFFF, 0)) // JA -1
    put(state, 0, 2, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_back[0]) as u64, ebpfver.verify(state, code, 3),
        ebpfver.V_BACKJUMP)

    // (2) Endet nicht mit EXIT.
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 0))
    put(state, 0, 1, insn(0xB7, 0, 0, 0, 1))
    expect(state, (&n_noex[0]) as u64, ebpfver.verify(state, code, 2),
        ebpfver.V_NOEXIT)

    // (3) r3 wird gelesen, ohne je beschrieben worden zu sein.
    put(state, 0, 0, insn(0xBF, 0, 3, 0, 0)) // MOV64 r0, r3
    put(state, 0, 1, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_uninit[0]) as u64, ebpfver.verify(state, code, 2),
        ebpfver.V_UNINIT)

    // (4) r10 als Ziel -- der Stapelzeiger ist nur lesbar.
    put(state, 0, 0, insn(0xB7, 10, 0, 0, 0)) // MOV64 r10, 0
    put(state, 0, 1, insn(0xB7, 0, 0, 0, 0))
    put(state, 0, 2, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_r10[0]) as u64, ebpfver.verify(state, code, 3),
        ebpfver.V_R10)

    // (5) Eine Kernfunktion, die es nicht gibt.
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 0))
    put(state, 0, 1, insn(0x85, 0, 0, 0, 99)) // CALL 99
    put(state, 0, 2, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_call[0]) as u64, ebpfver.verify(state, code, 3),
        ebpfver.V_CALL)

    // (6) Ein Sprung ueber das Ende hinaus.
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 0))
    put(state, 0, 1, insn(0x05, 0, 0, 100, 0)) // JA +100
    put(state, 0, 2, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_targ[0]) as u64, ebpfver.verify(state, code, 3),
        ebpfver.V_TARGET)

    // (7) EIN SPRUNG IN DIE ZWEITE HAELFTE EINES LD_IMM64. Dort steht
    // ein Sofortwert; wer dorthin springt, laesst die Maschine eine
    // Zahl als Befehl lesen. Das ist die Probe, wegen der der Pruefer
    // einen eigenen ersten Durchgang hat.
    put(state, 0, 0, insn(0x05, 0, 0, 1, 0)) // JA +1  -> Stelle 2
    put(state, 0, 1, insn(0x18, 0, 0, 0, 1)) // LD_IMM64 (Stelle 1+2)
    put(state, 0, 2, insn(0x00, 0, 0, 0, 0)) // die zweite Haelfte
    put(state, 0, 3, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_half[0]) as u64, ebpfver.verify(state, code, 4),
        ebpfver.V_TARGET)

    // (8) Ein Stapelzugriff ausserhalb des Stapels.
    put(state, 0, 0, insn(0x79, 0, 10, 0x0100, 0)) // LDX64 r0, [r10+256]
    put(state, 0, 1, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_stk[0]) as u64, ebpfver.verify(state, code, 2),
        ebpfver.V_STACKOFF)

    // (9) EIN PAKETZUGRIFF OHNE SCHRANKE. Das Programm liest aus dem
    // Rahmen, ohne vorher gegen r2 geprueft zu haben. Genau das ist der
    // Fehler, mit dem sich ein Paketfilter sonst aus dem Puffer
    // hinausliest.
    put(state, 0, 0, insn(0x71, 0, 1, 0, 0)) // LDX8 r0, [r1+0]
    put(state, 0, 1, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_pkt[0]) as u64, ebpfver.verify(state, code, 2),
        ebpfver.V_MEM)

    // (10) Ein Befehlscode, den die Maschine nicht kennt.
    put(state, 0, 0, insn(0xDB, 0, 0, 0, 0)) // ATOMIC -- nicht gebaut
    put(state, 0, 1, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_op[0]) as u64, ebpfver.verify(state, code, 2),
        ebpfver.V_OP)

    // (11) UND DIE GEGENPROBE ZUR GEGENPROBE: ein gueltiges Programm
    // muss durchkommen. Ohne diese Zeile waere ein Pruefer, der ALLES
    // abweist, in den zehn Proben darueber gruen.
    put(state, 0, 0, insn(0xB7, 0, 0, 0, 1))
    put(state, 0, 1, insn(0x95, 0, 0, 0, 0))
    expect(state, (&n_good[0]) as u64, ebpfver.verify(state, code, 2),
        ebpfver.V_OK)
}

// ================================================================
// 6. DIE TAFELN
// ================================================================
fn t_maps(state: u64) {
    var n_arr: [u8; 14] = "map.feld\0\0\0\0\0\0"
    var n_hash: [u8; 14] = "map.streu\0\0\0\0\0"
    var n_del: [u8; 14] = "map.loeschen\0\0"
    var n_miss: [u8; 14] = "map.fehlt\0\0\0\0\0"
    var n_full: [u8; 14] = "map.voll\0\0\0\0\0\0"
    var n_prog: [u8; 14] = "map.ausprog\0\0\0"
    var n_chain: [u8; 14] = "map.kette\0\0\0\0\0"

    ebpfmap.init(state)

    // Ein Feld: schreiben, lesen.
    let a: u64 = ebpfmap.create(state, ebpfmap.M_ARRAY, 8)
    ebpfmap.update(state, a, 3, 1234)
    var found: u64 = 0
    expect(state, (&n_arr[0]) as u64,
        ebpfmap.lookup_value(state, a, 3, &found), 1234)

    // Eine Streutafel.
    let h: u64 = ebpfmap.create(state, ebpfmap.M_HASH, 16)
    ebpfmap.update(state, h, 0xDEADBEEF, 77)
    expect(state, (&n_hash[0]) as u64,
        ebpfmap.lookup_value(state, h, 0xDEADBEEF, &found), 77)

    // Loeschen: danach ist der Schluessel weg.
    ebpfmap.delete(state, h, 0xDEADBEEF)
    ebpfmap.lookup_value(state, h, 0xDEADBEEF, &found)
    expect(state, (&n_del[0]) as u64, found, 0)

    // Ein Schluessel, den es nie gab.
    ebpfmap.lookup_value(state, h, 0x12345678, &found)
    expect(state, (&n_miss[0]) as u64, found, 0)

    // DIE KETTE NACH DEM LOESCHEN. Drei Schluessel, die auf denselben
    // Platz streuen, der mittlere wird geloescht -- der dritte muss
    // danach noch zu finden sein. Das ist der Fehler, den lineare
    // Sondierung ohne Neueinhaengen macht, und er faellt sonst erst
    // Monate spaeter auf.
    let h2: u64 = ebpfmap.create(state, ebpfmap.M_HASH, 8)
    ebpfmap.update(state, h2, 1, 11)
    ebpfmap.update(state, h2, 9, 22) // 9 % 8 kollidiert mit 1
    ebpfmap.update(state, h2, 17, 33)
    ebpfmap.delete(state, h2, 9)
    ebpfmap.lookup_value(state, h2, 17, &found)
    expect(state, (&n_chain[0]) as u64, found, 1)

    var n_ids: [u8; 14] = "map.ids\0\0\0\0\0\0\0"
    expect(state, (&n_ids[0]) as u64, a * 1000 + h * 100 + h2 * 10, 0 * 1000 + 1 * 100 + 2 * 10)

    // Eine volle Tafel nimmt nichts mehr an und sagt das.
    let h3: u64 = ebpfmap.create(state, ebpfmap.M_HASH, 2)
    ebpfmap.update(state, h3, 100, 1)
    ebpfmap.update(state, h3, 200, 2)
    expect(state, (&n_full[0]) as u64,
        ebpfmap.update(state, h3, 300, 3), 1)

    // AUS DEM PROGRAMM HERAUS. Das ist die eigentliche Zusage von
    // Stufe 3: ein geladenes Programm schreibt in eine Tafel, und
    // hinterher steht die Zahl drin.
    //
    //   r1 = <tafel>; r2 = 5; r3 = 4242; call map_update
    //   r0 = 0; exit
    // ES GIBT NUR VIER PLAETZE, und die vier Proben darueber haben sie
    // alle verbraucht. Die erste Fassung dieser Probe legte eine
    // fuenfte Tafel an, bekam NMAPS zurueck und schrieb dann in die
    // Tafel Nummer vier -- die es nicht gibt. Der Lauf meldete
    // `map.ausprog ist=0 soll=4242`, und der Fehler lag in der PROBE
    // und nicht in der Maschine. Er steht hier, weil eine Probe, die
    // sich selbst ins Knie schiesst, sonst als Fehler des Geprueften
    // gelesen wird.
    var n_h3: [u8; 14] = "map.h3\0\0\0\0\0\0\0\0"
    expect(state, (&n_h3[0]) as u64, h3, 3)
    var n_dst: [u8; 14] = "map.destroy\0\0\0"
    var dres: u64 = 0
    if ebpfmap.destroy(state, h3) {
        dres = 1
    }
    expect(state, (&n_dst[0]) as u64, dres, 1)
    let a2: u64 = ebpfmap.create(state, ebpfmap.M_ARRAY, 8)
    var n_slot: [u8; 14] = "map.platz␀␀␀␀␀"
    expect(state, (&n_slot[0]) as u64, a2, 3)
    put(state, 0, 0, insn(0xB7, 1, 0, 0, a2))
    put(state, 0, 1, insn(0xB7, 2, 0, 0, 5))
    put(state, 0, 2, insn(0xB7, 3, 0, 0, 4242))
    put(state, 0, 3, insn(0x85, 0, 0, 0, ebpf.F_MAP_UPDATE))
    put(state, 0, 4, insn(0xB7, 0, 0, 0, 0))
    put(state, 0, 5, insn(0x95, 0, 0, 0, 0))
    load_run(state, 0, 6, 0, 0)
    expect(state, (&n_prog[0]) as u64,
        ebpfmap.lookup_value(state, a2, 5, &found), 4242)
}

// ================================================================
// 7. DER HAKEN
// ================================================================
// DIE ZAEHLER UEBER EINE `init` HINWEGRETTEN. `ebpfhook.init` loescht
// den ganzen Haken- UND den ganzen Maschinenbereich -- es gibt in
// dieser Runde keine Stelle in `kdata`, die eine Probe benutzen
// koennte und die davon verschont bliebe. Also werden die beiden
// Zahlen vor der `init` gelesen und danach zurueckgeschrieben. Das ist
// ehrlicher als eine dritte Ecke zu suchen, die heute frei ist und es
// nach der naechsten Runde nicht mehr waere.
fn t_hook(state: u64) {
    let keep_p: u64 = passed(state)
    let keep_f: u64 = failed(state)
    var n_pass: [u8; 14] = "hook.durch\0\0\0\0"
    var n_drop: [u8; 14] = "hook.verwerf\0\0"
    var n_cnt: [u8; 14] = "hook.zaehler\0\0"
    var n_off: [u8; 14] = "hook.leer\0\0\0\0\0"

    ebpfhook.init(state)
    kstate.set(state, cb(T_PASS), keep_p)
    kstate.set(state, cb(T_FAIL), keep_f)
    let f: u64 = state + tb(T_FRAME)

    // Ohne geladenes Programm laesst der Haken alles durch -- und das
    // muss er auch, sonst haette ein leerer Haken das Netz abgeschaltet.
    expect(state, (&n_off[0]) as u64,
        ebpfhook.xdp(state, f, 64), ebpfhook.PASS)

    // Ein Programm, das immer DURCHLASSEN sagt.
    put(state, 0, 0, insn(0xB7, 0, 0, 0, ebpfhook.PASS))
    put(state, 0, 1, insn(0x95, 0, 0, 0, 0))
    let r1: u64 = ebpfhook.load(state, 0, ebpfhook.K_XDP, 2)
    ebpfhook.attach(state, ebpfhook.K_XDP, 0)
    expect(state, (&n_pass[0]) as u64,
        ebpfhook.xdp(state, f, 64), ebpfhook.PASS)

    // Und eines, das immer VERWERFEN sagt.
    put(state, 0, 0, insn(0xB7, 0, 0, 0, ebpfhook.DROP))
    put(state, 0, 1, insn(0x95, 0, 0, 0, 0))
    ebpfhook.load(state, 0, ebpfhook.K_XDP, 2)
    ebpfhook.attach(state, ebpfhook.K_XDP, 0)
    let before: u64 = ebpfhook.drops(state)
    expect(state, (&n_drop[0]) as u64,
        ebpfhook.xdp(state, f, 64), ebpfhook.DROP)
    // Der Zaehler muss sich bewegt haben -- sonst zaehlt der Haken
    // etwas anderes als das, was er tut.
    expect(state, (&n_cnt[0]) as u64,
        ebpfhook.drops(state) - before, 1)

    ebpfhook.detach(state, ebpfhook.K_XDP)
}

// ---------------------------------------------------------- der Ablauf
//
// Ein Programm pruefen, laden und laufen lassen. Gibt 0xFFFF zurueck,
// wenn der Pruefer es abgewiesen hat -- so lassen sich die Gegenproben
// mit derselben Funktion schreiben wie die guten Faelle.
fn load_run(state: u64, slot: u64, len: u64, ds: u64, de: u64) -> u64 {
    let v: u64 = ebpfhook.load(state, slot, ebpfhook.K_XDP, len)
    if v != ebpfver.V_OK {
        return 0xFFFF
    }
    return ebpf.run(state, slot, ds, de)
}

// ================================================================
// WAS DER HAKEN KOSTET
// ================================================================
//
// Nicht mit einer Stoppuhr ueber eine Uebertragung -- diese Maschine
// traegt Fremdlast, und der Kopf von `netmon.fi` beschreibt, was dabei
// herauskommt (Messwerte, die sich ueberlappen und einmal das falsche
// Vorzeichen haben). Stattdessen: derselbe Rahmen, `n` mal durch den
// Haken, zwischen zwei Lesungen des Taktzaehlers. Was herauskommt, sind
// TAKTE JE RAHMEN -- eine Eigenschaft des Codes und nicht der Laune der
// Maschine.
//
// Gemessen wird dreimal:
//   leer    der Haken ist da, aber kein Programm haengt daran
//   klein   ein Programm aus zwei Befehlen (nur EXIT)
//   gross   ein Programm, das den Rahmen wirklich ansieht
fn bench(state: u64) {
    var s_h: [u8; 25] = "ebpf: bench Takte/Rahmen\0"
    var s_l: [u8; 8] = " leer=\0\0"
    var s_k: [u8; 9] = " klein=\0\0"
    var s_g: [u8; 9] = " gross=\0\0"
    var s_n: [u8; 4] = " n=\0"

    let f: u64 = state + tb(T_FRAME)
    // Einen Rahmen bauen, der wie ein IPv4/TCP-Paket aussieht.
    var i: u64 = 0
    while i < 64 {
        __mmio_write8((f + i) as *mut u8, (i & 0xFF) as u8)
        i = i + 1
    }
    __mmio_write8((f + 12) as *mut u8, 0x08)
    __mmio_write8((f + 13) as *mut u8, 0x00)

    let n: u64 = 2000

    // 1. Der leere Haken.
    ebpfhook.init(state)
    let t0: u64 = time.tsc()
    i = 0
    while i < n {
        ebpfhook.xdp(state, f, 64)
        i = i + 1
    }
    let t1: u64 = time.tsc()

    // 2. Ein Programm aus zwei Befehlen.
    put(state, 0, 0, insn(0xB7, 0, 0, 0, ebpfhook.PASS))
    put(state, 0, 1, insn(0x95, 0, 0, 0, 0))
    ebpfhook.load(state, 0, ebpfhook.K_XDP, 2)
    ebpfhook.attach(state, ebpfhook.K_XDP, 0)
    let t2: u64 = time.tsc()
    i = 0
    while i < n {
        ebpfhook.xdp(state, f, 64)
        i = i + 1
    }
    let t3: u64 = time.tsc()

    // 3. Ein Programm, das den Rahmen ansieht: Schranke pruefen,
    //    zwei Oktette lesen, vergleichen, zaehlen.
    put(state, 0, 0, insn(0xBF, 3, 1, 0, 0)) // r3 = r1
    put(state, 0, 1, insn(0x07, 3, 0, 0, 14)) // r3 += 14
    put(state, 0, 2, insn(0x2D, 3, 2, 8, 0)) // if r3 > r2 goto ende
    put(state, 0, 3, insn(0x71, 4, 1, 12, 0)) // r4 = [r1+12]
    put(state, 0, 4, insn(0x71, 5, 1, 13, 0)) // r5 = [r1+13]
    put(state, 0, 5, insn(0x55, 4, 0, 5, 0x08)) // if r4 != 8 goto ende
    put(state, 0, 6, insn(0x55, 5, 0, 4, 0x00)) // if r5 != 0 goto ende
    put(state, 0, 7, insn(0xB7, 0, 0, 0, ebpfhook.PASS))
    put(state, 0, 8, insn(0x95, 0, 0, 0, 0))
    put(state, 0, 9, insn(0xB7, 0, 0, 0, ebpfhook.PASS))
    put(state, 0, 10, insn(0x95, 0, 0, 0, 0))
    put(state, 0, 11, insn(0xB7, 0, 0, 0, ebpfhook.PASS))
    put(state, 0, 12, insn(0x95, 0, 0, 0, 0))
    ebpfhook.load(state, 0, ebpfhook.K_XDP, 13)
    ebpfhook.attach(state, ebpfhook.K_XDP, 0)
    let t4: u64 = time.tsc()
    i = 0
    while i < n {
        ebpfhook.xdp(state, f, 64)
        i = i + 1
    }
    let t5: u64 = time.tsc()

    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_n[0]) as u64)
    serial.dec(n)
    serial.puts((&s_l[0]) as u64)
    serial.dec((t1 -% t0) / n)
    serial.puts((&s_k[0]) as u64)
    serial.dec((t3 -% t2) / n)
    serial.puts((&s_g[0]) as u64)
    serial.dec((t5 -% t4) / n)
    serial.nl()

    ebpfhook.detach(state, ebpfhook.K_XDP)
}

// ================================================================
// DAS PROBEPROGRAMM DER RUNDE
// ================================================================
//
// `ebpfdrop` auf der Befehlszeile laedt dieses Programm in den Haken am
// Eingang. Es verwirft ICMP und laesst alles andere durch -- also
// verschwindet `ping`, waehrend eine Uebertragung ueber TCP im selben
// Lauf weiterlaeuft. Das ist die Zusage, die `tools/ebpf/run.sh` am
// Ende misst, und sie ist mit Absicht so gewaehlt, dass ein Fehler in
// beide Richtungen auffaellt: verwirft der Filter zuviel, bricht die
// Uebertragung ab; verwirft er zuwenig, kommt der Ping durch.
//
// EINE GEGENPROBE AM FERTIGEN FILTER, mit Rahmen, die der Kern SELBST
// baut. `ebpfdrop` haengt den Filter in den echten Netzweg, und ob dort
// in einem gegebenen Lauf ueberhaupt ein ICMP-Rahmen ankommt, haengt am
// Wirt -- das ist keine Grundlage fuer eine Zusage. Hier werden zwei
// Rahmen gebaut, einer mit ICMP und einer mit TCP, und beide durch
// GENAU DEN Haken geschickt, der auch am Geraet haengt. Was
// herauskommt, haengt nur noch am Filter.
fn drop_probe(state: u64) {
    var s_i: [u8; 26] = "ebpf: probe icmp verwerf=\0"
    var s_t: [u8; 24] = "ebpf: probe tcp  durch=\0"
    let f: u64 = state + tb(T_FRAME)
    var i: u64 = 0
    while i < 64 {
        __mmio_write8((f + i) as *mut u8, 0)
        i = i + 1
    }
    // Ein IPv4-Rahmen: Ethertype 0x0800, IHL 5, Protokoll 1 (ICMP).
    __mmio_write8((f + 12) as *mut u8, 0x08)
    __mmio_write8((f + 13) as *mut u8, 0x00)
    __mmio_write8((f + 14) as *mut u8, 0x45)
    __mmio_write8((f + 23) as *mut u8, 1)
    var a: u64 = 0
    if ebpfhook.xdp(state, f, 64) == ebpfhook.DROP {
        a = 1
    }
    serial.puts((&s_i[0]) as u64)
    serial.dec(a)
    serial.nl()
    // Derselbe Rahmen, nur Protokoll 6 (TCP): er muss durchkommen.
    __mmio_write8((f + 23) as *mut u8, 6)
    var b: u64 = 0
    if ebpfhook.xdp(state, f, 64) == ebpfhook.PASS {
        b = 1
    }
    serial.puts((&s_t[0]) as u64)
    serial.dec(b)
    serial.nl()
}

// Der Rahmen, den es ansieht:
//
//   Oktett 12..13  der Ethertype, 0x0800 fuer IPv4
//   Oktett 23      das Protokoll im IP-Kopf (1 = ICMP)
//
// Oktett 23 stimmt nur bei einem IP-Kopf ohne Zusatzfelder (IHL 5).
// Das ist bei allem der Fall, was hier ueber die Leitung geht, und der
// Pruefer erzwingt ohnehin die Schranke: das Programm liest kein Oktett,
// ohne vorher gegen das Paketende geprueft zu haben.
fn load_drop_icmp(state: u64) -> u64 {
    //  0  r3 = r1
    //  1  r3 += 24            genug fuer Ethertype UND Protokolloktett
    //  2  if r3 > r2 goto 11  zu kurz -> durchlassen
    //  3  r4 = *(u8 *)(r1+12)
    //  4  if r4 != 0x08 goto 11
    //  5  r4 = *(u8 *)(r1+13)
    //  6  if r4 != 0x00 goto 11
    //  7  r4 = *(u8 *)(r1+23)
    //  8  if r4 != 1 goto 11
    //  9  r0 = DROP
    // 10  exit
    // 11  r0 = PASS
    // 12  exit
    put(state, 1, 0, insn(0xBF, 3, 1, 0, 0))
    put(state, 1, 1, insn(0x07, 3, 0, 0, 24))
    put(state, 1, 2, insn(0x2D, 3, 2, 8, 0))
    put(state, 1, 3, insn(0x71, 4, 1, 12, 0))
    put(state, 1, 4, insn(0x55, 4, 0, 6, 0x08))
    put(state, 1, 5, insn(0x71, 4, 1, 13, 0))
    put(state, 1, 6, insn(0x55, 4, 0, 4, 0x00))
    put(state, 1, 7, insn(0x71, 4, 1, 23, 0))
    put(state, 1, 8, insn(0x55, 4, 0, 2, 1))
    put(state, 1, 9, insn(0xB7, 0, 0, 0, ebpfhook.DROP))
    put(state, 1, 10, insn(0x95, 0, 0, 0, 0))
    put(state, 1, 11, insn(0xB7, 0, 0, 0, ebpfhook.PASS))
    put(state, 1, 12, insn(0x95, 0, 0, 0, 0))
    let v: u64 = ebpfhook.load(state, 1, ebpfhook.K_XDP, 13)
    var s_l: [u8; 22] = "ebpf: drop-icmp pruef\0"
    var s_a: [u8; 9] = " haengt=\0"
    serial.puts((&s_l[0]) as u64)
    serial.dec(v)
    if v == 0 {
        ebpfhook.attach(state, ebpfhook.K_XDP, 1)
    }
    serial.puts((&s_a[0]) as u64)
    serial.dec(ebpfhook.attached(state, ebpfhook.K_XDP))
    serial.nl()
    return v
}
