// SPDX-License-Identifier: GPL-2.0-only
//
// kernel/marke.fi -- DIE MARKE AN EINEM ORT.
//
// Nachgebaut nach /root/projects/freeviewer/src/brand.rs, damit beide
// Projekte gleich funktionieren. Dort steht:
//
//   "Marke an EINEM Ort. Wer ein zweites Produkt will (z. B. 'Xoffi
//    Remote' fuer eine andere Firma), baut mit gesetzten
//    Umgebungsvariablen."
//
// WARUM ES DIESE DATEI GIBT. Bis zur Runde MARKE stand der Name
// einzeln im Text: im Bootmenue, in der Kopfzeile des
// Terminalfensters, in der Diagnoseueberschrift, im Namen des Abbilds.
// Ein Umbenennen war eine Suchen-und-Ersetzen-Aktion ueber das halbe
// Repo -- und jede solche Aktion trifft irgendwann eine Stelle, die
// KEIN Anzeigetext ist, sondern eine Formatkennung. Danach startet die
// Maschine nicht mehr.
//
// WIE DER WERT HIERHERKOMMT, und warum es nicht `option_env!` ist.
// Rust liest die Umgebung beim Uebersetzen selbst; Firn kann das
// nicht. Also tut es der Bau: `tools/build-kernel.sh` kopiert den
// Kernbaum nach /tmp und laesst dort `tools/marke-einsetzen.py` die
// Platzhalter ersetzen -- aus `marke.conf`, geschlagen von den
// Umgebungsvariablen `OSUM_MARKE_*`. Das VERHALTEN ist damit dasselbe
// wie in der Vorlage: Vorgabewerte im Baum, Umbenennen durch einen
// Bauaufruf. Nur der Ort der Vorgabe ist eine Datei statt eines
// Literals, weil ein auf 32 Elemente gepolstertes Firn-Literal nichts
// ist, was ein Mensch von Hand pflegen soll.
//
// Danach wird NACHGEPRUEFT, dass kein Fragezeichen mehr steht -- und
// wenn doch, bricht der Bau ab. Wer diese Datei direkt uebersetzt,
// bekommt Fragezeichen zu sehen, und das ist ehrlicher als ein Name,
// der aus zwei Quellen kommen koennte.
//
// WAS HIER NICHT HINEINGEHOERT: Formatkennungen (`OSUM-OFS`,
// `OSUMMOD`), Protokollkennungen (`SSH-2.0-OsumSSH`), Symbolnamen
// (`osum_panic`), Pfade, Dateiendungen, ABI-Nummern und die Trennlabel
// der Schluesselableitung. Die Vorlage sagt warum: "Protokoll, Relay
// und IDs sind bei allen Marken gleich - jeder Build kann mit jedem
// reden." Ein umbenannter Bau muss dieselben Sticks lesen und
// dieselben Pakete verstehen. Die Liste mit Begruendung je Fall steht
// in `marke.conf`.

profile kernel

import kstate
import version

export {
    produkt, produkt_n, kern, kern_n, hersteller, hersteller_n,
    short, short_n, web, web_n, feed, feed_n,
    fassung_text, fassung_n, anhaengen, MAX, MAX_URL
}

// Hoechstens 31 nutzbare Zeichen je Namensfeld, das 32. ist die Null.
// Adressen sind laenger: 95 nutzbare Zeichen.
// `tools/marke-einsetzen.py` bricht ab, wenn ein Feld nicht passt --
// eine abgeschnittene Marke waere ein Fehler, der erst auf dem
// Bildschirm auffaellt, und ein abgeschnittener Feed einer, der erst
// beim Update auffaellt.
const MAX: u64 = 32
const MAX_URL: u64 = 96

// GENAU SO VIELE FRAGEZEICHEN WIE ELEMENTE, und das ist ein Vertrag
// mit `tools/marke-einsetzen.py`. Wer hier eine Laenge aendert, muss
// dort `MAX` bzw. `MAX_URL` mit aendern; das Werkzeug prueft die Zahl
// der Elemente nach und bricht sonst ab.
static mut s_produkt: [u8; 32] = "???????????????????????????????\0"
static mut s_kern: [u8; 32] = "???????????????????????????????\0"
static mut s_hersteller: [u8; 32] = "???????????????????????????????\0"
static mut s_kurz: [u8; 32] = "???????????????????????????????\0"
static mut s_web: [u8; 96] = "???????????????????????????????????????????????????????????????????????????????????????????????\0"
static mut s_feed: [u8; 96] = "???????????????????????????????????????????????????????????????????????????????????????????????\0"

fn len_from(p: u64, grenze: u64) -> u64 {
    var n: u64 = 0
    while n < grenze && kstate.get8(p + n) != 0 {
        n = n + 1
    }
    return n
}

// (= NAME in der Vorlage) Anzeigename ueberall: Bootmenue, Fenster,
// Kopfzeilen, Diagnose.
fn produkt() -> u64 {
    return (&s_produkt[0]) as u64
}

fn produkt_n() -> u64 {
    return len_from(produkt(), MAX)
}

// Der Kern darunter. Startprotokoll, Fassungszeile, Panik. Dieses Feld
// hat die Vorlage nicht -- dort gibt es nur ein Produkt. Hier gibt es
// zwei Namen, und sie meinen nicht dasselbe.
fn kern() -> u64 {
    return (&s_kern[0]) as u64
}

fn kern_n() -> u64 {
    return len_from(kern(), MAX)
}

// (= PUBLISHER)
fn hersteller() -> u64 {
    return (&s_hersteller[0]) as u64
}

fn hersteller_n() -> u64 {
    return len_from(hersteller(), MAX)
}

// (= SLUG) Kleingeschrieben, ohne Leerzeichen -- fuer Dateinamen und
// die Fassungszeile.
fn short() -> u64 {
    return (&s_kurz[0]) as u64
}

fn short_n() -> u64 {
    return len_from(short(), MAX)
}

// (= WEB) Oeffentliche Adresse der Marke.
fn web() -> u64 {
    return (&s_web[0]) as u64
}

fn web_n() -> u64 {
    return len_from(web(), MAX_URL)
}

// (= FEED) Eigener Update-Feed pro Marke. Die zweite
// Entwurfsentscheidung der Vorlage: "Ein Xoffi-Build darf sich nie zum
// FreeViewer aktualisieren." Der Wert steht ausserdem als `quelle=` in
// /etc/ota.conf, wo `ota` ihn liest -- hier liegt er, damit der Kern
// ihn NENNEN kann, ohne die Datei zu oeffnen.
fn feed() -> u64 {
    return (&s_feed[0]) as u64
}

fn feed_n() -> u64 {
    return len_from(feed(), MAX_URL)
}

// DIE FASSUNG WIRD NICHT HIER GEHALTEN, sie wird nur DURCHGEREICHT.
// Sie steht in `fassung.fi`, weil sie beim Bauen aus git kommt und
// nicht aus `marke.conf`. Zwei Speicherorte fuer eine Zahl waeren zwei
// Zahlen, sobald einer von beiden vergessen wird.
fn fassung_text() -> u64 {
    return version.text()
}

fn fassung_n() -> u64 {
    return version.len()
}

// EIN NULLTERMINIERTER TEXT AN EINEN PUFFER. Gibt die neue Laenge
// zurueck. Die Aufrufer setzen ihre Zeilen damit zusammen, statt jede
// fuer sich eine Schleife zu schreiben -- der Name staende sonst zwar
// nur noch an einer Stelle, die Kopierschleife aber an sechs.
fn anhaengen(dst: u64, at: u64, quelle: u64, grenze: u64) -> u64 {
    var n: u64 = at
    var i: u64 = 0
    while n < grenze && kstate.get8(quelle + i) != 0 {
        kstate.set8(dst + n, kstate.get8(quelle + i) as u8)
        n = n + 1
        i = i + 1
    }
    return n
}
