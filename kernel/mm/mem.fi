
import serial
import lib.kstate
import sync.atomic
import arch.cpu
import arch.arch
import libc.regio

export {
    scan, crash_band, frame_alloc, frame_free, frame_run, frame_free_run, frames_free,
    frame_alloc_user, reserve_init, confine_to_reach, reach_frames,
    bitmap_octets, mapped_gib, frames_total, stress, probe_high,
    heap_init, kalloc, kfree, heap_blocks,
    reserve_frame,
    frame_selftest, heap_selftest,
    FRAME_SIZE, cmdline, mods, mod_start, mod_end
}

const FRAME_SIZE: u64 = 4096
const HEADER: u64 = 16

const GIB: u64 = 1073741824
const PD_ENTRIES: u64 = 512
const MAX_GIB: u64 = 512
const PTE_P_W: u64 = 0x3
const PDE_HUGE: u64 = 0x83
const PTE_ADDR: u64 = 0x000FFFFFFFFFF000

const MB_FLAGS: u64 = 0
const MB_CMDLINE: u64 = 16
const MB_MMAP_LEN: u64 = 44
const MB_MMAP_ADDR: u64 = 48
const MB_MODS_COUNT: u64 = 20
const MB_MODS_ADDR: u64 = 24
const MOD_ENTRY: u64 = 16

fn cmdline(mbi: u64) -> u64 {
    if (kstate.get32(mbi + MB_FLAGS) & 4) == 0 {
        return 0
    }
    return kstate.get32(mbi + MB_CMDLINE)
}

fn mods(mbi: u64) -> u64 {
    if (kstate.get32(mbi + MB_FLAGS) & 8) == 0 {
        return 0
    }
    return kstate.get32(mbi + MB_MODS_COUNT)
}

fn mod_start(mbi: u64, i: u64) -> u64 {
    if i >= mods(mbi) {
        return 0
    }
    return kstate.get32(kstate.get32(mbi + MB_MODS_ADDR) + i * MOD_ENTRY)
}

fn mod_end(mbi: u64, i: u64) -> u64 {
    if i >= mods(mbi) {
        return 0
    }
    return kstate.get32(kstate.get32(mbi + MB_MODS_ADDR)
        + i * MOD_ENTRY + 4)
}

fn bit_get(bitmap: u64, i: u64) -> bool {
    return (kstate.get8(bitmap + i / 8) & (1 << (i % 8))) != 0
}

fn bit_set(bitmap: u64, i: u64) {
    let p: u64 = bitmap + i / 8
    kstate.set8(p, (kstate.get8(p) | (1 << (i % 8))) as u8)
}

fn bit_clear(bitmap: u64, i: u64) {
    let p: u64 = bitmap + i / 8
    kstate.set8(p, (kstate.get8(p) & (255 ^ (1 << (i % 8)))) as u8)
}

const CRASH_BAND_LEN: u64 = 0x3000
const CRASH_BANDS: u64 = 2
static mut crash_band_ok: [u64; 2] = [0, 0]

fn crash_band_base(i: u64) -> u64 {
    if i == 0 {
        return 0x0F000000
    }
    return 0x1F000000
}

fn crash_band(i: u64) -> u64 {
    if i >= CRASH_BANDS {
        return 0
    }
    if crash_band_ok[i as usize] == 0 {
        return 0
    }
    return crash_band_base(i)
}

fn crash_band_usable(mbi: u64, b: u64) -> bool {
    let e: u64 = b + CRASH_BAND_LEN
    if (kstate.get32(mbi + MB_FLAGS) & 64) == 0 {
        return false
    }
    var inside: bool = false
    let len: u64 = kstate.get32(mbi + MB_MMAP_LEN)
    let addr: u64 = kstate.get32(mbi + MB_MMAP_ADDR)
    var p: u64 = addr
    while p < addr + len {
        let size: u64 = kstate.get32(p)
        let base: u64 = __mmio_read64((p + 4) as *mut u64)
        let length: u64 = __mmio_read64((p + 12) as *mut u64)
        if kstate.get32(p + 20) == 1 && base <= b && base + length >= e {
            inside = true
        }
        if size == 0 {
            p = addr + len
        } else {
            p = p + size + 4
        }
    }
    if !inside {
        return false
    }
    let mc: u64 = mods(mbi)
    var m: u64 = 0
    while m < mc {
        if mod_start(mbi, m) < e && mod_end(mbi, m) > b {
            return false
        }
        m = m + 1
    }
    if kstate.get32(mbi + MB_MODS_ADDR) < e && kstate.get32(mbi + MB_MODS_ADDR) + 4096 > b && mc != 0 {
        return false
    }
    return true
}

fn crash_bands_take(bitmap: u64, frames: u64, mbi: u64) {
    var i: u64 = 0
    while i < CRASH_BANDS {
        let b: u64 = crash_band_base(i)
        if crash_band_usable(mbi, b) {
            reserve(bitmap, frames, b, CRASH_BAND_LEN)
            crash_band_ok[i as usize] = 1
        }
        i = i + 1
    }
}

fn scan(state: u64, mbi: u64, kernel_end: u64) -> u64 {
    let bitmap: u64 = state + kstate.BITMAP_OFF
    let frames: u64 = kstate.BITMAP_BYTES * 8
    kstate.set(state, kstate.BITMAP, bitmap)
    kstate.set(state, kstate.BITMAP_FRAMES, frames)

    var i: u64 = 0
    while i < kstate.BITMAP_BYTES {
        kstate.set8(bitmap + i, 0xFF as u8)
        i = i + 1
    }

    var entries: u64 = 0
    var usable: u64 = 0
    var top: u64 = 0
    if (kstate.get32(mbi + MB_FLAGS) & 64) != 0 {
        let len: u64 = kstate.get32(mbi + MB_MMAP_LEN)
        let addr: u64 = kstate.get32(mbi + MB_MMAP_ADDR)
        var p: u64 = addr
        while p < addr + len {
            let size: u64 = kstate.get32(p)
            let base: u64 = __mmio_read64((p + 4) as *mut u64)
            let length: u64 = __mmio_read64((p + 12) as *mut u64)
            let kind: u64 = kstate.get32(p + 20)
            entries = entries + 1
            if kind == 1 {
                usable = usable + length
                if base + length > top {
                    top = base + length
                }
                release(bitmap, frames, base, length)
            }
            if size == 0 {
                p = addr + len
            } else {
                p = p + size + 4
            }
        }
    }
    kstate.set(state, kstate.MEM_USABLE, usable)
    kstate.set(state, kstate.MEM_TOP, top)

    reserve(bitmap, frames, 0, kernel_end)
    if (kstate.get32(mbi + MB_FLAGS) & 64) != 0 {
        reserve(bitmap, frames, kstate.get32(mbi + MB_MMAP_ADDR),
            kstate.get32(mbi + MB_MMAP_LEN))
    }
    reserve(bitmap, frames, mbi, 4096)

    let mc: u64 = mods(mbi)
    if mc != 0 {
        reserve(bitmap, frames, kstate.get32(mbi + MB_MODS_ADDR),
            mc * MOD_ENTRY)
        var m: u64 = 0
        while m < mc {
            let von: u64 = mod_start(mbi, m)
            let bis: u64 = mod_end(mbi, m)
            if bis > von {
                reserve(bitmap, frames, von, bis - von)
            }
            m = m + 1
        }
    }

    crash_bands_take(bitmap, frames, mbi)

    kstate.set(state, kstate.FRAMES_FREE, count_free(state))

    idmap_grow(state, top)
    bitmap_grow(state, mbi, kernel_end, top)
    return entries
}

fn idmap_grow(state: u64, top: u64) -> u64 {
    var want: u64 = (top + GIB - 1) / GIB
    if want > MAX_GIB {
        want = MAX_GIB
    }
    if want <= 1 {
        kstate.set(state, kstate.MAPPED_GB, 1)
        return 1
    }
    let pml4: u64 = asm("mov rax, cr3", out("rax")) & PTE_ADDR
    let pdpt: u64 = __mmio_read64(pml4 as *mut u64) & PTE_ADDR
    if pdpt == 0 {
        kstate.set(state, kstate.MAPPED_GB, 1)
        return 1
    }
    var g: u64 = 1
    while g < want {
        if (__mmio_read64((pdpt + g * 8) as *mut u64) & (1 as u64)) == 0 {
            let pd: u64 = frame_alloc_inner(state)
            if pd == 0 {
                g = want
            } else {
                var j: u64 = 0
                while j < PD_ENTRIES {
                    __mmio_write64((pd + j * 8) as *mut u64,
                        (g * GIB + j * 2097152) | PDE_HUGE)
                    j = j + 1
                }
                __mmio_write64((pdpt + g * 8) as *mut u64, pd | PTE_P_W)
                g = g + 1
            }
        } else {
            g = g + 1
        }
    }
    let cr3: u64 = asm("mov rax, cr3", out("rax"))
    asm("mov cr3, rdi", in("rdi") cr3)
    var have: u64 = 0
    var k: u64 = 0
    while k < want {
        if (__mmio_read64((pdpt + k * 8) as *mut u64) & (1 as u64)) != 0 {
            have = have + 1
        }
        k = k + 1
    }
    kstate.set(state, kstate.MAPPED_GB, have)
    return have
}

fn bitmap_grow(state: u64, mbi: u64, kernel_end: u64, top: u64) -> u64 {
    let old_frames: u64 = kstate.BITMAP_BYTES * 8
    var want_frames: u64 = (top + FRAME_SIZE - 1) / FRAME_SIZE
    let mapped: u64 = kstate.get(state, kstate.MAPPED_GB)
    if want_frames > mapped * (GIB / FRAME_SIZE) {
        want_frames = mapped * (GIB / FRAME_SIZE)
    }
    if want_frames <= old_frames {
        kstate.set(state, kstate.BITMAP_OCTETS, kstate.BITMAP_BYTES)
        return old_frames
    }
    let octets: u64 = (want_frames + 7) / 8
    let need: u64 = (octets + FRAME_SIZE - 1) / FRAME_SIZE
    let base: u64 = frame_run_inner(state, need)
    if base == 0 {
        kstate.set(state, kstate.BITMAP_OCTETS, kstate.BITMAP_BYTES)
        return old_frames
    }
    fill8(base, need * FRAME_SIZE, 0xFF)
    let old: u64 = state + kstate.BITMAP_OFF
    var i: u64 = 0
    while i < kstate.BITMAP_BYTES {
        kstate.set8(base + i, kstate.get8(old + i) as u8)
        i = i + 1
    }
    kstate.set(state, kstate.BITMAP, base)
    kstate.set(state, kstate.BITMAP_FRAMES, want_frames)
    kstate.set(state, kstate.BITMAP_OCTETS, octets)

    if (kstate.get32(mbi + MB_FLAGS) & 64) != 0 {
        let len: u64 = kstate.get32(mbi + MB_MMAP_LEN)
        let addr: u64 = kstate.get32(mbi + MB_MMAP_ADDR)
        var p: u64 = addr
        while p < addr + len {
            let size: u64 = kstate.get32(p)
            let b: u64 = __mmio_read64((p + 4) as *mut u64)
            let l: u64 = __mmio_read64((p + 12) as *mut u64)
            if kstate.get32(p + 20) == 1 {
                release_from(base, want_frames, b, l, old_frames)
            }
            if size == 0 {
                p = addr + len
            } else {
                p = p + size + 4
            }
        }
        reserve(base, want_frames, kstate.get32(mbi + MB_MMAP_ADDR),
            kstate.get32(mbi + MB_MMAP_LEN))
    }
    reserve(base, want_frames, 0, kernel_end)
    reserve(base, want_frames, mbi, 4096)
    let mc: u64 = mods(mbi)
    if mc != 0 {
        reserve(base, want_frames, kstate.get32(mbi + MB_MODS_ADDR),
            mc * MOD_ENTRY)
        var m: u64 = 0
        while m < mc {
            let von: u64 = mod_start(mbi, m)
            let bis: u64 = mod_end(mbi, m)
            if bis > von {
                reserve(base, want_frames, von, bis - von)
            }
            m = m + 1
        }
    }
    kstate.set(state, kstate.FRAMES_FREE, count_free(state))
    return want_frames
}

fn bitmap_octets(state: u64) -> u64 {
    return kstate.get(state, kstate.BITMAP_OCTETS)
}

fn mapped_gib(state: u64) -> u64 {
    return kstate.get(state, kstate.MAPPED_GB)
}

fn frames_total(state: u64) -> u64 {
    return kstate.get(state, kstate.BITMAP_FRAMES)
}

fn fill8(at: u64, n: u64, v: u64) {
    var i: u64 = 0
    let w: u64 = v * 0x0101010101010101
    while i + 8 <= n {
        __mmio_write64((at + i) as *mut u64, w)
        i = i + 8
    }
    while i < n {
        kstate.set8(at + i, v as u8)
        i = i + 1
    }
}

fn count_free(state: u64) -> u64 {
    let bitmap: u64 = kstate.get(state, kstate.BITMAP)
    let frames: u64 = kstate.get(state, kstate.BITMAP_FRAMES)
    var free: u64 = 0
    var f: u64 = 0
    while f < frames {
        if (f % 8) == 0 && f + 8 <= frames {
            let o: u64 = kstate.get8(bitmap + f / 8)
            if o == 0 {
                free = free + 8
                f = f + 8
            } else if o == 0xFF {
                f = f + 8
            } else {
                var k: u64 = 0
                while k < 8 {
                    if (o & (1 << k)) == 0 {
                        free = free + 1
                    }
                    k = k + 1
                }
                f = f + 8
            }
        } else {
            if !bit_get(bitmap, f) {
                free = free + 1
            }
            f = f + 1
        }
    }
    return free
}

fn release_from(bitmap: u64, frames: u64, base: u64, length: u64,
    from: u64) {
    var f: u64 = (base + FRAME_SIZE - 1) / FRAME_SIZE
    if f < from {
        f = from
    }
    var last: u64 = (base + length) / FRAME_SIZE
    if last > frames {
        last = frames
    }
    while f < last {
        if (f % 8) == 0 && f + 8 <= last {
            kstate.set8(bitmap + f / 8, 0 as u8)
            f = f + 8
        } else {
            bit_clear(bitmap, f)
            f = f + 1
        }
    }
}

fn release(bitmap: u64, frames: u64, base: u64, length: u64) {
    var f: u64 = (base + FRAME_SIZE - 1) / FRAME_SIZE
    let last: u64 = (base + length) / FRAME_SIZE
    while f < last {
        if f >= frames {
            return
        }
        bit_clear(bitmap, f)
        f = f + 1
    }
}

fn reserve(bitmap: u64, frames: u64, base: u64, length: u64) {
    var f: u64 = base / FRAME_SIZE
    let last: u64 = (base + length + FRAME_SIZE - 1) / FRAME_SIZE
    while f < last {
        if f >= frames {
            return
        }
        bit_set(bitmap, f)
        f = f + 1
    }
}

fn frames_free(state: u64) -> u64 {
    return kstate.get(state, kstate.FRAMES_FREE)
}

fn lock(state: u64) -> u64 {
    let flags: u64 = arch.irq_save()
    atomic.lock_take(state, atomic.L_FRAME, cpu.here(state))
    return flags
}

fn unlock(state: u64, flags: u64) {
    atomic.lock_give(state, atomic.L_FRAME)
    arch.irq_restore(flags)
}

fn frame_alloc(state: u64) -> u64 {
    let flags: u64 = lock(state)
    let r: u64 = frame_alloc_inner(state)
    unlock(state, flags)
    return r
}

fn frame_alloc_user(state: u64) -> u64 {
    let flags: u64 = lock(state)
    let res: u64 = kstate.get(state, kstate.RESERVE_FRAMES)
    if frames_free(state) <= res {
        kstate.set(state, kstate.RESERVE_HITS,
            kstate.get(state, kstate.RESERVE_HITS) + 1)
        unlock(state, flags)
        return 0
    }
    let r: u64 = frame_alloc_inner(state)
    unlock(state, flags)
    return r
}

fn reserve_init(state: u64) {
    var n: u64 = kstate.get(state, kstate.BITMAP_FRAMES) / 52
    if n < 64 {
        n = 64
    }
    if n > 512 {
        n = 512
    }
    if kstate.mode_on(state, kstate.M_NORESERVE) {
        n = 0
    }
    kstate.set(state, kstate.RESERVE_FRAMES, n)
    kstate.set(state, kstate.RESERVE_HITS, 0)
}

fn hint_of(state: u64) -> u64 {
    let h: u64 = kstate.get(state, kstate.FRAME_HINT)
    if h >= kstate.get(state, kstate.BITMAP_FRAMES) {
        return 0
    }
    return h
}

const REACH_FRAMES: u64 = 262144
static mut confined_once: u64 = 0

fn reach_frames() -> u64 {
    return REACH_FRAMES
}

fn confine_to_reach(state: u64) {
    var s_cut: [u8; 40] = "mem: process context reaches frames < \0\0"
    var s_was: [u8; 8] = " (was \0\0"
    var s_end: [u8; 3] = ")\n\0"
    let flags: u64 = lock(state)
    let have: u64 = kstate.get(state, kstate.BITMAP_FRAMES)
    if confined_once != 0 || have <= REACH_FRAMES {
        unlock(state, flags)
        return
    }
    confined_once = 1
    kstate.set(state, kstate.BITMAP_FRAMES, REACH_FRAMES)
    if kstate.get(state, kstate.FRAME_HINT) >= REACH_FRAMES {
        kstate.set(state, kstate.FRAME_HINT, 0)
    }
    kstate.set(state, kstate.FRAMES_FREE, count_free(state))
    reserve_init(state)
    unlock(state, flags)
    serial.puts((&s_cut[0]) as u64)
    serial.dec(REACH_FRAMES)
    serial.puts((&s_was[0]) as u64)
    serial.dec(have)
    serial.puts((&s_end[0]) as u64)
}

fn frame_alloc_inner(state: u64) -> u64 {
    let r: u64 = scan_range(state, hint_of(state),
        kstate.get(state, kstate.BITMAP_FRAMES))
    if r != 0 {
        return r
    }
    return scan_range(state, 0, hint_of(state))
}

fn scan_range(state: u64, from: u64, to: u64) -> u64 {
    let bitmap: u64 = kstate.get(state, kstate.BITMAP)
    let frames: u64 = to
    var f: u64 = from
    while f < frames {
        if kstate.get8(bitmap + f / 8) == 0xFF {
            f = f + 8 - (f % 8)
        } else {
            if !bit_get(bitmap, f) {
                bit_set(bitmap, f)
                kstate.set(state, kstate.FRAMES_FREE, frames_free(state) - 1)
                kstate.set(state, kstate.FRAME_HINT, f)
                return f * FRAME_SIZE
            }
            f = f + 1
        }
    }
    return 0
}

fn frame_free(state: u64, addr: u64) {
    let flags: u64 = lock(state)
    frame_free_inner(state, addr)
    unlock(state, flags)
}

fn frame_free_inner(state: u64, addr: u64) {
    let bitmap: u64 = kstate.get(state, kstate.BITMAP)
    let f: u64 = addr / FRAME_SIZE
    if f >= kstate.get(state, kstate.BITMAP_FRAMES) {
        return
    }
    if bit_get(bitmap, f) {
        bit_clear(bitmap, f)
        kstate.set(state, kstate.FRAMES_FREE, frames_free(state) + 1)
        if f < kstate.get(state, kstate.FRAME_HINT) {
            kstate.set(state, kstate.FRAME_HINT, f)
        }
    }
}

fn reserve_frame(state: u64, addr: u64) -> bool {
    let flags: u64 = lock(state)
    let r: bool = reserve_frame_inner(state, addr)
    unlock(state, flags)
    return r
}

fn reserve_frame_inner(state: u64, addr: u64) -> bool {
    let bitmap: u64 = kstate.get(state, kstate.BITMAP)
    let f: u64 = addr / FRAME_SIZE
    if f >= kstate.get(state, kstate.BITMAP_FRAMES) {
        return false
    }
    if bit_get(bitmap, f) {
        return false
    }
    bit_set(bitmap, f)
    kstate.set(state, kstate.FRAMES_FREE, frames_free(state) - 1)
    return true
}

fn frame_run(state: u64, n: u64) -> u64 {
    let flags: u64 = lock(state)
    let r: u64 = frame_run_inner(state, n)
    unlock(state, flags)
    return r
}

fn frame_run_inner(state: u64, n: u64) -> u64 {
    let bitmap: u64 = kstate.get(state, kstate.BITMAP)
    let frames: u64 = kstate.get(state, kstate.BITMAP_FRAMES)
    var start: u64 = 0
    while start + n <= frames {
        var k: u64 = 0
        var ok: bool = true
        while k < n {
            if bit_get(bitmap, start + k) {
                ok = false
                k = n
            } else {
                k = k + 1
            }
        }
        if ok {
            var j: u64 = 0
            while j < n {
                bit_set(bitmap, start + j)
                j = j + 1
            }
            kstate.set(state, kstate.FRAMES_FREE, frames_free(state) - n)
            return start * FRAME_SIZE
        }
        start = start + 1
    }
    return 0
}

fn frame_free_run(state: u64, addr: u64, n: u64) {
    if addr == 0 || n == 0 {
        return
    }
    let flags: u64 = lock(state)
    var i: u64 = 0
    while i < n {
        frame_free_inner(state, addr + i * FRAME_SIZE)
        i = i + 1
    }
    unlock(state, flags)
}

fn stress(state: u64, want: u64) -> bool {
    let rot: u64 = 0xA5A5A5A5A5A5A5A5
    let before: u64 = frames_free(state)
    var head: u64 = 0
    var got: u64 = 0
    var high: u64 = 0
    var going: bool = true
    while got < want && going {
        let f: u64 = frame_alloc(state)
        if f == 0 {
            going = false
        } else {
            __mmio_write64(f as *mut u64, head)
            __mmio_write64((f + 8) as *mut u64, f ^ rot)
            head = f
            if f > high {
                high = f
            }
            got = got + 1
        }
    }
    kstate.set(state, kstate.STRESS_GOT, got)
    kstate.set(state, kstate.STRESS_HIGH, high)
    kstate.set(state, kstate.STRESS_BEFORE, before)
    kstate.set(state, kstate.STRESS_LOW, frames_free(state))

    var bad: u64 = 0
    var seen: u64 = 0
    var f2: u64 = head
    while f2 != 0 {
        if __mmio_read64((f2 + 8) as *mut u64) != (f2 ^ rot) {
            bad = bad + 1
        }
        let next: u64 = __mmio_read64(f2 as *mut u64)
        frame_free(state, f2)
        seen = seen + 1
        f2 = next
    }
    kstate.set(state, kstate.STRESS_BAD, bad)
    kstate.set(state, kstate.STRESS_SEEN, seen)
    kstate.set(state, kstate.STRESS_AFTER, frames_free(state))
    return bad == 0 && seen == got && frames_free(state) == before
}

fn probe_high(state: u64) -> bool {
    let marker: u64 = 0xDEADBEEFCAFEBABE
    let rot: u64 = 0x5A5A5A5A5A5A5A5A
    let bitmap: u64 = kstate.get(state, kstate.BITMAP)
    let frames: u64 = kstate.get(state, kstate.BITMAP_FRAMES)
    if frames < 2 {
        return false
    }
    var f: u64 = frames - 1
    var found: u64 = 0
    while f > 0 && found == 0 {
        if !bit_get(bitmap, f) {
            found = f
        }
        f = f - 1
    }
    if found == 0 {
        return false
    }
    bit_set(bitmap, found)
    let addr: u64 = found * FRAME_SIZE
    __mmio_write64(addr as *mut u64, marker)
    __mmio_write64((addr + FRAME_SIZE - 8) as *mut u64,
        addr ^ rot)
    let ok1: bool = __mmio_read64(addr as *mut u64) == marker
    let ok2: bool = __mmio_read64((addr + FRAME_SIZE - 8) as *mut u64)
        == (addr ^ rot)
    bit_clear(bitmap, found)
    kstate.set(state, kstate.PROBE_ADDR, addr)
    return ok1 && ok2
}

fn block_used(h: u64) -> u64 {
    return __mmio_read64((h + 8) as *mut u64)
}

fn block_write(h: u64, size: u64, used: u64) {
    __mmio_write64(h as *mut u64, size)
    __mmio_write64((h + 8) as *mut u64, used)
}

fn heap_init(state: u64, base: u64, size: u64) {
    kstate.set(state, kstate.HEAP_BASE, base)
    kstate.set(state, kstate.HEAP_END, base + size)
    kstate.set(state, kstate.HEAP_HEAD, base)
    block_write(base, size, 0)
}

fn kalloc(state: u64, want: u64) -> u64 {
    let flags: u64 = lock(state)
    let r: u64 = kalloc_inner(state, want)
    unlock(state, flags)
    return r
}

fn kalloc_inner(state: u64, want: u64) -> u64 {
    let base: u64 = kstate.get(state, kstate.HEAP_BASE)
    let end: u64 = kstate.get(state, kstate.HEAP_END)
    var need: u64 = (want + 15) / 16 * 16 + HEADER
    if need < HEADER + 16 {
        need = HEADER + 16
    }
    var h: u64 = base
    while h < end {
        let size: u64 = regio.read64(h)
        if size == 0 {
            return 0
        }
        if block_used(h) == 0 && size >= need {
            if size - need >= HEADER + 16 {
                block_write(h + need, size - need, 0)
                block_write(h, need, 1)
            } else {
                block_write(h, size, 1)
            }
            return h + HEADER
        }
        h = h + size
    }
    return 0
}

fn kfree(state: u64, p: u64) {
    let flags: u64 = lock(state)
    kfree_inner(state, p)
    unlock(state, flags)
}

fn kfree_inner(state: u64, p: u64) {
    if p == 0 {
        return
    }
    block_write(p - HEADER, regio.read64(p - HEADER), 0)
    let base: u64 = kstate.get(state, kstate.HEAP_BASE)
    let end: u64 = kstate.get(state, kstate.HEAP_END)
    var h: u64 = base
    while h < end {
        let size: u64 = regio.read64(h)
        if size == 0 {
            return
        }
        if block_used(h) == 0 && h + size < end && block_used(h + size) == 0 {
            block_write(h, size + regio.read64(h + size), 0)
        } else {
            h = h + size
        }
    }
}

fn heap_blocks(state: u64, used_only: bool) -> u64 {
    let end: u64 = kstate.get(state, kstate.HEAP_END)
    var h: u64 = kstate.get(state, kstate.HEAP_BASE)
    var n: u64 = 0
    while h < end {
        let size: u64 = regio.read64(h)
        if size == 0 {
            return n
        }
        if !used_only || block_used(h) != 0 {
            n = n + 1
        }
        h = h + size
    }
    return n
}

fn frame_selftest(state: u64) -> bool {
    var head: [u8; 13] = "frame test: \0"
    var s_a: [u8; 3] = "a=\0"
    var s_b: [u8; 5] = "  b=\0"
    var s_c: [u8; 5] = "  c=\0"
    var s_again: [u8; 11] = "  again b=\0"
    var s_free: [u8; 8] = "  free=\0"
    let before: u64 = frames_free(state)
    let a: u64 = frame_alloc(state)
    let b: u64 = frame_alloc(state)
    let c: u64 = frame_alloc(state)
    frame_free(state, b)
    let again: u64 = frame_alloc(state)
    serial.puts((&head[0]) as u64)
    serial.puts((&s_a[0]) as u64)
    serial.hex(a)
    serial.puts((&s_b[0]) as u64)
    serial.hex(b)
    serial.puts((&s_c[0]) as u64)
    serial.hex(c)
    serial.puts((&s_again[0]) as u64)
    serial.hex(again)
    serial.puts((&s_free[0]) as u64)
    serial.dec(frames_free(state))
    serial.nl()
    var ok: bool = true
    if a == 0 || b == 0 || c == 0 || again == 0 {
        ok = false
    }
    if a == b || b == c || a == c {
        ok = false
    }
    if a % FRAME_SIZE != 0 || b % FRAME_SIZE != 0 || c % FRAME_SIZE != 0 {
        ok = false
    }
    if again != b {
        ok = false
    }
    if frames_free(state) != before - 3 {
        ok = false
    }
    frame_free(state, a)
    frame_free(state, again)
    frame_free(state, c)
    if frames_free(state) != before {
        ok = false
    }
    return ok
}

fn heap_selftest(state: u64) -> bool {
    var head: [u8; 12] = "heap test: \0"
    var s_p1: [u8; 4] = "p1=\0"
    var s_p2: [u8; 6] = "  p2=\0"
    var s_p3: [u8; 6] = "  p3=\0"
    var s_reuse: [u8; 9] = "  reuse=\0"
    var s_blocks: [u8; 11] = "  blocks=\0\0"
    var s_refused: [u8; 14] = "  1M refused=\0"
    let p1: u64 = kalloc(state, 24)
    let p2: u64 = kalloc(state, 100)
    let p3: u64 = kalloc(state, 24)
    fill(p1, 24, 0x11)
    fill(p2, 100, 0x22)
    fill(p3, 24, 0x33)
    var ok: bool = true
    if p1 == 0 || p2 == 0 || p3 == 0 {
        ok = false
    }
    if p1 % 16 != 0 || p2 % 16 != 0 || p3 % 16 != 0 {
        ok = false
    }
    if p1 + 24 > p2 || p2 + 100 > p3 {
        ok = false
    }
    if !check(p1, 24, 0x11) || !check(p2, 100, 0x22) || !check(p3, 24, 0x33) {
        ok = false
    }
    let toobig: u64 = kalloc(state, 1024 * 1024)
    if toobig != 0 {
        ok = false
    }
    kfree(state, p2)
    let reuse: u64 = kalloc(state, 100)
    if reuse != p2 {
        ok = false
    }
    if !check(p1, 24, 0x11) || !check(p3, 24, 0x33) {
        ok = false
    }
    serial.puts((&head[0]) as u64)
    serial.puts((&s_p1[0]) as u64)
    serial.hex(p1)
    serial.puts((&s_p2[0]) as u64)
    serial.hex(p2)
    serial.puts((&s_p3[0]) as u64)
    serial.hex(p3)
    serial.puts((&s_reuse[0]) as u64)
    serial.hex(reuse)
    serial.puts((&s_blocks[0]) as u64)
    serial.dec(heap_blocks(state, false))
    serial.puts((&s_refused[0]) as u64)
    if toobig == 0 {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()
    kfree(state, p1)
    kfree(state, reuse)
    kfree(state, p3)
    if heap_blocks(state, false) != 1 {
        ok = false
    }
    if heap_blocks(state, true) != 0 {
        ok = false
    }
    return ok
}

fn fill(p: u64, n: u64, value: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, value as u8)
        i = i + 1
    }
}

fn check(p: u64, n: u64, value: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get8(p + i) != value {
            return false
        }
        i = i + 1
    }
    return true
}
