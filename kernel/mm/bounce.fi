profile kernel

import lib.kstate
import mm.mmframe

export { take, give, usable, SLOTS }

const SLOTS: u64 = 8

static mut frames: [u64; 8] = [0 as u64; 8]
static mut busy: [u64; 8] = [0 as u64; 8]
static mut ready: u64 = 0

fn setup_locked(state: u64) {
    ready = 1
    var i: u64 = 0
    while i < SLOTS {
        frames[i as usize] = mmframe.frame_alloc_inner(state)
        i = i + 1
    }
}

fn usable(state: u64) -> bool {
    let flags: u64 = mmframe.lock(state)
    if ready == 0 {
        setup_locked(state)
    }
    var any: bool = false
    var i: u64 = 0
    while i < SLOTS {
        if frames[i as usize] != 0 {
            any = true
        }
        i = i + 1
    }
    mmframe.unlock(state, flags)
    return any
}

fn take(state: u64) -> u64 {
    let flags: u64 = mmframe.lock(state)
    if ready == 0 {
        setup_locked(state)
    }
    var i: u64 = 0
    while i < SLOTS {
        if frames[i as usize] != 0 && busy[i as usize] == 0 {
            busy[i as usize] = 1
            let f: u64 = frames[i as usize]
            mmframe.unlock(state, flags)
            return f
        }
        i = i + 1
    }
    mmframe.unlock(state, flags)
    return 0
}

fn give(state: u64, frame: u64) {
    let flags: u64 = mmframe.lock(state)
    var i: u64 = 0
    while i < SLOTS {
        if frames[i as usize] == frame {
            busy[i as usize] = 0
        }
        i = i + 1
    }
    mmframe.unlock(state, flags)
}
