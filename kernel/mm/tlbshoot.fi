import lib.kstate
import lib.tscdelta
import arch.cpu
import arch.x86_64.apic
import sync.tlbserve
import mm.tlbstat

export { flush_space, shoot, shots, timeouts }

const ICR_ASSERT: u64 = 0x4000

const SLOW_DIVISOR: u64 = 50

const GIVE_UP_DIVISOR: u64 = 1

static mut shot_count: u64 = 0
static mut timeout_count: u64 = 0

fn shots() -> u64 {
    return shot_count
}

fn timeouts() -> u64 {
    return timeout_count
}

fn flush_space(state: u64, cr3: u64, site: u64) {
    tlbstat.note(tlbstat.SPACE_CALLS)
    tlbstat.note(site)
    let now: u64 = asm("mov rax, cr3", out("rax"))
    if cr3 != 0 && cr3 == now {
        tlbstat.note(tlbstat.SPACE_LOCAL)
        asm("mov rax, cr3\nmov cr3, rax", out("rax"), clobber("memory"))
    }
    shoot(state, cr3)
}

fn targets(state: u64, cr3: u64, me: u64, nc: u64) -> u64 {
    let want: u64 = cr3 & tlbserve.CR3_ADDR_MASK
    var mask: u64 = 0
    var k: u64 = 0
    while k < nc && k < tlbserve.MAX_CPUS {
        if k != me && cpu.online(state, k) && tlbserve.loaded_cr3(k) == want {
            mask = mask | ((1 as u64) << k)
        }
        k = k + 1
    }
    return mask
}

fn shoot(state: u64, cr3: u64) {
    let nc: u64 = cpu.count(state)
    if nc <= 1 || cr3 == 0 {
        return
    }
    asm("mfence", clobber("memory"))
    let me: u64 = cpu.here(state)
    let mask: u64 = targets(state, cr3, me, nc)
    if mask == 0 {
        return
    }
    var k: u64 = 0
    while k < tlbserve.MAX_CPUS {
        if ((mask >> k) & 1) != 0 {
            tlbserve.request(k)
            apic.ipi(state, cpu.apic_id(state, k), tlbserve.VEC_TLB | ICR_ASSERT)
        }
        k = k + 1
    }
    shot_count = shot_count + 1
    tlbstat.note(tlbstat.SHOOT_ROUNDS)
    var targets_hit: u64 = 0
    var j: u64 = 0
    while j < tlbserve.MAX_CPUS {
        targets_hit = targets_hit + ((mask >> j) & 1)
        j = j + 1
    }
    var c: u64 = 0
    while c < targets_hit {
        tlbstat.note(tlbstat.SHOOT_TARGETS)
        c = c + 1
    }
    wait_all(state, mask)
}

fn wait_all(state: u64, mask: u64) {
    let t0: u64 = apic.tsc()
    let hz: u64 = apic.tsc_hz(state)
    let slow_after: u64 = hz / SLOW_DIVISOR
    let give_up_after: u64 = hz / GIVE_UP_DIVISOR
    var slow: bool = false
    var k: u64 = 0
    while k < tlbserve.MAX_CPUS {
        if ((mask >> k) & 1) != 0 {
            let gen: u64 = tlbserve.issued(k)
            while !tlbserve.acked(k, gen) {
                tlbserve.serve(state)
                asm("pause")
                if give_up_after != 0 {
                    let waited: u64 = tscdelta.between(t0, apic.tsc())
                    if !slow && waited > slow_after {
                        slow = true
                        tlbstat.note(tlbstat.SHOOT_SLOW)
                    }
                    if waited > give_up_after {
                        timeout_count = timeout_count + 1
                        tlbstat.note(tlbstat.SHOOT_TIMEOUT)
                        return
                    }
                }
            }
        }
        k = k + 1
    }
}
