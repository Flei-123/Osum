import lib.kstate
import sched.sched
import sync.atomic

export {
    demand_lock, demand_unlock, mm_lock, mm_unlock, scratch_lock, scratch_unlock, vm_lock, vm_unlock, vm_held, vm_oom_note, vm_oom_take, LOCK_BASE,
    spin_takes, spin_count, SPIN_KINDS
}

const LOCK_BASE: u64 = 0xF4000

const DEMAND_LOCK: u64 = 32

const K_DEMAND: u64 = 0
const K_MM: u64 = 1
const K_SCRATCH: u64 = 2
const K_VM: u64 = 3
const SPIN_KINDS: u64 = 4

static mut kind_takes: [u64; 4] = [0 as u64; 4]
static mut kind_spins: [u64; 4] = [0 as u64; 4]

fn spin_take(lock: u64, who: u64, kind: u64) {
    var spins: u64 = 0
    while atomic.cas(lock, 0, who) != 0 {
        atomic.pause()
        spins = spins + 1
    }
    kind_takes[kind as usize] = kind_takes[kind as usize] + 1
    kind_spins[kind as usize] = kind_spins[kind as usize] + spins
}

fn spin_takes(kind: u64) -> u64 {
    return kind_takes[kind as usize]
}

fn spin_count(kind: u64) -> u64 {
    return kind_spins[kind as usize]
}

fn demand_lock(state: u64) {
    spin_take(state + LOCK_BASE + DEMAND_LOCK, 1, K_DEMAND)
}

fn demand_unlock(state: u64) {
    atomic.store(state + LOCK_BASE + DEMAND_LOCK, 0)
}

const MM_LOCK: u64 = 40
const SCRATCH_LOCK: u64 = 48

fn spin_irq_lock(state: u64, off: u64, kind: u64) -> u64 {
    let fl: u64 = sched.irq_save()
    spin_take(state + LOCK_BASE + off, 1, kind)
    return fl
}

fn spin_irq_unlock(state: u64, off: u64, fl: u64) {
    atomic.store(state + LOCK_BASE + off, 0)
    sched.irq_restore(fl)
}

const LOCK_SKIPPED: u64 = 0x8000000000000000

fn mm_lock(state: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_NOMMLOCK) {
        return LOCK_SKIPPED
    }
    return spin_irq_lock(state, MM_LOCK, K_MM)
}

fn mm_unlock(state: u64, fl: u64) {
    if fl != LOCK_SKIPPED {
        spin_irq_unlock(state, MM_LOCK, fl)
    }
}

fn scratch_lock(state: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_NOSCRATCH) {
        return LOCK_SKIPPED
    }
    return spin_irq_lock(state, SCRATCH_LOCK, K_SCRATCH)
}

fn scratch_unlock(state: u64, fl: u64) {
    if fl != LOCK_SKIPPED {
        spin_irq_unlock(state, SCRATCH_LOCK, fl)
    }
}

const VM_LOCK: u64 = 56
const VM_OOM: u64 = 64

fn vm_lock(state: u64, task: u64) {
    if kstate.mode_on(state, kstate.M_NOVMLOCK) {
        return
    }
    spin_take(state + LOCK_BASE + VM_LOCK, task + 1, K_VM)
}

fn vm_unlock(state: u64, task: u64) {
    if kstate.mode_on(state, kstate.M_NOVMLOCK) {
        return
    }
    atomic.store(state + LOCK_BASE + VM_LOCK, 0)
}

fn vm_held(state: u64, task: u64) -> bool {
    return atomic.load(state + LOCK_BASE + VM_LOCK) == task + 1
}

fn vm_oom_note(state: u64) {
    atomic.store(state + LOCK_BASE + VM_OOM, 1)
}

fn vm_oom_take(state: u64) -> bool {
    let lock: u64 = state + LOCK_BASE + VM_OOM
    if atomic.load(lock) == 0 {
        return false
    }
    return atomic.cas(lock, 1, 0) == 1
}
