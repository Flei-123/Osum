profile kernel

import lib.kstate
import mm.mmframe

export { apply }

const LEAVE_FRAMES: u64 = 3584

fn count_low_free(bitmap: u64, limit: u64) -> u64 {
    var n: u64 = 0
    var f: u64 = 0
    while f < limit {
        if !mmframe.bit_get(bitmap, f) {
            n = n + 1
        }
        f = f + 1
    }
    return n
}

fn apply(state: u64) {
    if !kstate.mode_on(state, kstate.M_LOWHOG) {
        return
    }
    let flags: u64 = mmframe.lock(state)
    let bitmap: u64 = kstate.get(state, kstate.BITMAP)
    let limit: u64 = mmframe.low_limit(state)
    var free: u64 = count_low_free(bitmap, limit)
    var f: u64 = limit
    while f > 0 && free > LEAVE_FRAMES {
        f = f - 1
        if !mmframe.bit_get(bitmap, f) {
            mmframe.bit_set(bitmap, f)
            kstate.set(state, kstate.FRAMES_FREE, mmframe.frames_free(state) - 1)
            free = free - 1
        }
    }
    mmframe.unlock(state, flags)
}
