export {
    note, get, COUNT,
    SWITCH_LOAD, SWITCH_KEEP, FAULT_FILE, FAULT_SWAP, FAULT_ANON, FAULT_SHM, STACK_GROW, MAP_HUGE,
    SPACE_CALLS, SPACE_LOCAL, SHOOT_ROUNDS, SHOOT_TARGETS, SERVE_RUN, FAULT_LOCAL_RUN, USE_SPACE,
    SITE_RELEASE_PAGE, SITE_UNSHARE_CACHED, SITE_UNSHARE_ANON, SITE_COW_WRITE, SITE_FORK_PROTECT,
    SITE_FORK_ABORT, SITE_RANGE_DRAIN, SITE_RANGE_END, SITE_RANGE_MOVE, SITE_PROTECT_RANGE,
    SITE_PROTECT_RESERVED, SITE_SWAP_OUT, SHOOT_SLOW, SHOOT_TIMEOUT, FAULT_PRESENT_FETCH, FAULT_PRESENT_DATA
}

const COUNT: u64 = 32

const SWITCH_LOAD: u64 = 0
const SWITCH_KEEP: u64 = 1
const FAULT_FILE: u64 = 2
const FAULT_SWAP: u64 = 3
const FAULT_ANON: u64 = 4
const FAULT_SHM: u64 = 5
const STACK_GROW: u64 = 6
const MAP_HUGE: u64 = 7
const SPACE_CALLS: u64 = 8
const SPACE_LOCAL: u64 = 9
const SHOOT_ROUNDS: u64 = 10
const SHOOT_TARGETS: u64 = 11
const SERVE_RUN: u64 = 12
const FAULT_LOCAL_RUN: u64 = 13
const USE_SPACE: u64 = 14

const SITE_RELEASE_PAGE: u64 = 16
const SITE_UNSHARE_CACHED: u64 = 17
const SITE_UNSHARE_ANON: u64 = 18
const SITE_COW_WRITE: u64 = 19
const SITE_FORK_PROTECT: u64 = 20
const SITE_FORK_ABORT: u64 = 21
const SITE_RANGE_DRAIN: u64 = 22
const SITE_RANGE_END: u64 = 23
const SITE_RANGE_MOVE: u64 = 24
const SITE_PROTECT_RANGE: u64 = 25
const SITE_PROTECT_RESERVED: u64 = 26
const SITE_SWAP_OUT: u64 = 27
const SHOOT_SLOW: u64 = 28
const SHOOT_TIMEOUT: u64 = 29
const FAULT_PRESENT_FETCH: u64 = 30
const FAULT_PRESENT_DATA: u64 = 31

static mut cells: [u64; 32] = [0 as u64; 32]

fn cell(k: u64) -> u64 {
    return (&cells[0]) as u64 + k * 8
}

fn note(k: u64) {
    if k < COUNT {
        let _g: u64 = __atomic_add(cell(k) as *mut u64, 1)
    }
}

fn get(k: u64) -> u64 {
    return __mmio_read64(cell(k) as *mut u64)
}
