// SPDX-License-Identifier: GPL-2.0-only
// kernel/elf.fi -- round K1: a program comes off the disk.
//
// Everything the kernel could run until this round was LINKED INTO IT.
// `kernel/uprog.fi` is a translation unit of its own and lies on
// pages of its own, but it travels in the same image, and the number of
// programs the system knows was decided when the kernel was compiled.
// That is not an operating system; that is a demonstration with a fixed
// programme.
//
// This file closes the gap. It reads an ELF64 file out of the file system
// (`fs.fi`, on the RAM disk or on a real drive over ATA PIO), lays its
// segments into the address space of a NEW process with the rights the
// file asks for, zeroes what the file does not fill, builds an argument
// block on the top stack page and starts the thing. `/bin/sh` is loaded
// exactly like every program it starts itself -- there is no second path.
//
// THREE RULES, and every one of them has a counter-check in
// `tools/osum/run.sh` that makes the measurement collapse:
//
//   1. WHAT IS WRONG IS REFUSED, AND THE KERNEL LIVES ON. Twenty-one
//      named reasons below, from a wrong magic number to a segment that
//      claims more room than the private region has. Every one of them
//      leaves the kernel standing and the caller with an error code. The
//      run `tools/osum/run.sh` feeds the kernel eleven deliberately
//      broken files and reads the reason back off the serial port.
//   2. NOTHING IS ADDED UP THAT COULD OVERFLOW. Under `profile kernel`
//      arithmetic is CHECKED (SPEC section 13, item L9) -- `off + filesz`
//      with a hostile `off` does not wrap silently, it calls
//      `osum_panic`, and the kernel is dead. Every bound in this file is
//      therefore written as a SUBTRACTION on the side that is known to be
//      big enough: `size - off < filesz` instead of `off + filesz > size`.
//      That is not style, it is the difference between a refusal and a
//      halted machine, and `bad_huge` in the guard is the case that
//      proves it.
//   3. ONE PAGE HAS ONE SET OF RIGHTS. A page table entry cannot be read
//      only for the first half of a page and writable for the second, so
//      the loader demands page aligned segments and refuses a file whose
//      segments share a page (`R_ALIGN`, `R_OVERLAP`). A loader that
//      quietly gave the shared page the union of both rights would have
//      made the constants writable and the data executable without ever
//      saying so. `kernel/user/user.ld` produces the three
//      segments; `ld -n` produces the counter-example.
//
// THE ADDRESS SPACE the image lands in is the one `proc.fi` builds: one
// private page table over 0x40000000..0x401FFFFF. Below live the data
// page and the eight stack pages, from `proc.IMAGE_BASE` (0x40100000) on
// there is room for the image. `proc.free_space` walks that table when
// the process dies and gives every frame back -- the image frames are not
// a special case, and `tools/osum/run.sh` measures that the free frame
// count is the same before and after.

import serial
import errno
import kstate
import mem
import sched
import proc
import fs
import file
import uio
import perm
import ctr
import pmon

export {
    spawn, build, load, load_at, say_reason, errno_of,
    R_OK, R_NOFILE, R_ISDIR, R_SHORT, R_MAGIC, R_CLASS, R_ENDIAN,
    R_VERSION, R_TYPE, R_MACHINE, R_SIZES, R_PHNUM, R_PHOFF, R_SEGFILE,
    R_MEMSZ, R_RANGE, R_ALIGN, R_OVERLAP, R_NOMEM, R_ENTRY, R_READ,
    R_NOLOAD, R_ARGS,
    // RUNDE DYNLADER
    R_IPATH, R_INOFILE, R_ICHAIN, R_IFORM, R_STACK
}

// -------------------------------------------------------- the reasons

const R_OK: u64 = 0
const R_NOFILE: u64 = 1 // there is no such path
const R_ISDIR: u64 = 2 // it is not a file
const R_SHORT: u64 = 3 // shorter than an ELF header
const R_MAGIC: u64 = 4 // 0x7F E L F is missing
const R_CLASS: u64 = 5 // not ELFCLASS64
const R_ENDIAN: u64 = 6 // not little endian
const R_VERSION: u64 = 7 // not version 1
const R_TYPE: u64 = 8 // not ET_EXEC
const R_MACHINE: u64 = 9 // not x86-64
const R_SIZES: u64 = 10 // e_ehsize or e_phentsize is wrong
const R_PHNUM: u64 = 11 // no program headers, or too many
const R_PHOFF: u64 = 12 // the program headers lie outside the file
const R_SEGFILE: u64 = 13 // a segment lies outside the file
const R_MEMSZ: u64 = 14 // p_filesz is bigger than p_memsz
const R_RANGE: u64 = 15 // outside the region a process owns
const R_ALIGN: u64 = 16 // not page aligned
const R_OVERLAP: u64 = 17 // two segments want the same page
const R_NOMEM: u64 = 18 // no frame left
const R_ENTRY: u64 = 19 // the entry point is on no executable page
const R_READ: u64 = 20 // the disk gave less than was asked for
const R_NOLOAD: u64 = 21 // not a single PT_LOAD
const R_ARGS: u64 = 22 // the arguments do not fit on the page
// RUNDE K13: die Datei ist da, sie ist ein Programm -- aber dieser
// Prozess darf sie nicht starten. Das ist kein Formatfehler, und sie
// bekommt deshalb einen eigenen Grund und ihre eigene Fehlernummer
// (-EACCES statt -ENOEXEC): "du darfst nicht" und "das ist kein
// Programm" sind zwei verschiedene Auskuenfte, und ein Programm, das
// beide gleich beantwortet bekommt, kann sie nicht auseinanderhalten.
const R_PERM: u64 = 23

// RUNDE K16: `#!` zeigt auf einen Ausleger, der selbst wieder einer ist,
// vier Stufen tief -- oder im Kreis. Linux nennt das ELOOP und hoert nach
// vier Stufen auf; dieser Kern tut dasselbe.
const R_INTERP: u64 = 24

// ================================================== RUNDE DYNLADER
// Ein Bild mit `PT_INTERP` braucht einen zweiten Lader, und dabei kann
// vier Dinge schiefgehen, die mit dem Bild selbst nichts zu tun haben.
// Sie bekommen eigene Gruende, weil "der Interpreter fehlt" und "das
// Programm ist kaputt" zwei verschiedene Auskuenfte sind -- die
// Gegenprobe `badinterp` in tools/dynlader/run.sh haengt daran.
const R_IPATH: u64 = 25 // PT_INTERP ist zu lang oder nicht beendet
const R_INOFILE: u64 = 26 // den Interpreter gibt es nicht
const R_ICHAIN: u64 = 27 // der Interpreter hat selbst einen PT_INTERP
const R_IFORM: u64 = 28 // der Interpreter ist kein brauchbares ET_DYN
const R_STACK: u64 = 29 // der Startstapel passt nicht auf die Seite
// KEIN Grund, sondern die Auskunft "dieses Bild braucht gar keinen
// Lader". Muss sich von R_OK (= 0) unterscheiden, siehe `read_interp`.
const R_KEINER: u64 = 30

// ---------------------------------------------------------- the format

const PT_LOAD: u64 = 1
// RUNDE DYNLADER: der Kopf, der sagt "ich brauche einen Lader". Sein
// Inhalt ist ein Pfad als Zeichenkette, kein Zeiger.
const PT_INTERP: u64 = 3
const PF_X: u64 = 1
const PF_W: u64 = 2

const ET_EXEC: u64 = 2
// RUNDE DYNLADER: ein verschiebbares Bild. Sowohl ein PIE-Programm als
// auch JEDER Interpreter ist von diesem Typ -- seine `p_vaddr` zaehlen
// ab 0 und werden auf eine Basis addiert, die der KERN waehlt.
const ET_DYN: u64 = 3
const EM_X86_64: u64 = 62

const EHSIZE: u64 = 64 // e_ehsize, and the size of the header
const PHENTSIZE: u64 = 56 // e_phentsize
const MAX_PH: u64 = 16 // more than that is not a program of ours

// The fields, as offsets. ELF64 is little endian on this machine, which
// is why they can simply be read.
const E_TYPE: u64 = 16
const E_MACHINE: u64 = 18
const E_EVERSION: u64 = 20
const E_ENTRY: u64 = 24
const E_PHOFF: u64 = 32
const E_EHSIZE: u64 = 52
const E_PHENTSIZE: u64 = 54
const E_PHNUM: u64 = 56

const P_TYPE: u64 = 0
const P_FLAGS: u64 = 4
const P_OFFSET: u64 = 8
const P_VADDR: u64 = 16
const P_FILESZ: u64 = 32
const P_MEMSZ: u64 = 40

const PAGE: u64 = 4096
const PAGE_MASK: u64 = 4095

// What a freshly taken frame is filled with before the file goes in.
// Whatever the program reads that it did not put there itself is this
// pattern, and `nobss` on the command line leaves it standing on purpose
// -- that is the counter-check for "the loader zeroes the .bss".
const POISON: u64 = 0xAAAAAAAAAAAAAAAA

// Where the strings of the argument block start on the page. Eight
// pointers plus the closing zero is nine words, and the count is the
// tenth.
const STR_OFF: u64 = 80

// ---------------------------------------------------------- the reading

fn get64(p: u64) -> u64 {
    return __mmio_read64(p as *mut u64)
}

fn put64(p: u64, v: u64) {
    __mmio_write64(p as *mut u64, v)
}

fn head(state: u64) -> u64 {
    return state + kstate.ELF_OFF
}

fn fill(p: u64, n: u64, v: u64) {
    var i: u64 = 0
    while i < n / 8 {
        put64(p + i * 8, v)
        i = i + 1
    }
}

fn copy(from: u64, to: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(to + i, kstate.get8(from + i) as u8)
        i = i + 1
    }
}

fn fail(state: u64, r: u64) -> u64 {
    kstate.set(state, kstate.ELF_ERR, r)
    return r
}

// ------------------------------------------------------- the header

// Reads the ELF header and every program header into the data area and
// says what is wrong. R_OK = nothing.
//
// The order of the checks is the order in which a file gets less
// trustworthy: what is not even an ELF file is not looked at any
// further, and no number out of the file is used before the field that
// says how long it is has been believed.
fn read_header(state: u64, ino: u64) -> u64 {
    let h: u64 = head(state)
    let size: u64 = fs.inode_size(state, ino)
    if size < EHSIZE {
        return R_SHORT
    }
    if fs.read_at(state, ino, 0, h, EHSIZE) != EHSIZE {
        return R_READ
    }
    if kstate.get8(h) != 0x7F {
        return R_MAGIC
    }
    if kstate.get8(h + 1) != 69 {
        return R_MAGIC
    }
    if kstate.get8(h + 2) != 76 {
        return R_MAGIC
    }
    if kstate.get8(h + 3) != 70 {
        return R_MAGIC
    }
    if kstate.get8(h + 4) != 2 {
        return R_CLASS
    }
    if kstate.get8(h + 5) != 1 {
        return R_ENDIAN
    }
    if kstate.get8(h + 6) != 1 {
        return R_VERSION
    }
    // RUNDE DYNLADER: ET_DYN IST JETZT AUCH EIN PROGRAMM.
    //
    // Bis zu dieser Runde stand hier `!= ET_EXEC`, und das hat jedes
    // dynamisch gelinkte Linux-Programm mit Grund 8 abgewiesen -- und
    // JEDEN Interpreter gleich mit, denn `ld-musl-x86_64.so.1` ist
    // selbst ein ET_DYN (gemessen: "Elf file type is DYN (Shared object
    // file), Entry 0x777ee").
    //
    // Der Unterschied zwischen den beiden ist NICHT, was erlaubt ist,
    // sondern WER DIE ADRESSE WAEHLT. Ein ET_EXEC nennt seine Adressen
    // selbst und besteht darauf; ein ET_DYN zaehlt ab 0 und laesst sich
    // schieben. Die Pruefungen in `segment` gelten deshalb weiter --
    // nur werden sie ab dieser Runde auf `vaddr + bias` angewendet und
    // nicht auf `vaddr`. Ein ET_DYN mit bias 0 verhaelt sich exakt wie
    // vorher, und genau das ist der Grund, warum die 135 bestehenden
    // Programme von dieser Zeile nichts merken: sie sind ET_EXEC.
    let et: u64 = kstate.get16(h + E_TYPE)
    if et != ET_EXEC {
        if et != ET_DYN {
            return R_TYPE
        }
    }
    if kstate.get16(h + E_MACHINE) != EM_X86_64 {
        return R_MACHINE
    }
    if kstate.get32(h + E_EVERSION) != 1 {
        return R_VERSION
    }
    if kstate.get16(h + E_EHSIZE) != EHSIZE {
        return R_SIZES
    }
    if kstate.get16(h + E_PHENTSIZE) != PHENTSIZE {
        return R_SIZES
    }
    let n: u64 = kstate.get16(h + E_PHNUM)
    if n == 0 {
        return R_PHNUM
    }
    if n > MAX_PH {
        return R_PHNUM
    }
    // n <= 16, so this product cannot run away.
    let need: u64 = n * PHENTSIZE
    let off: u64 = get64(h + E_PHOFF)
    if off < EHSIZE {
        return R_PHOFF
    }
    // NOT `off + need > size`: `off` comes out of the file and may be
    // 0xFFFFFFFFFFFFFFF0. Checked addition would call `osum_panic` and
    // the kernel would be gone -- see the head of this file.
    if off > size {
        return R_PHOFF
    }
    if size - off < need {
        return R_PHOFF
    }
    if fs.read_at(state, ino, off, h + EHSIZE, need) != need {
        return R_READ
    }
    return R_OK
}

// ------------------------------------------------------- one segment

// Lays one PT_LOAD into the address space of task `t`. Every page is
// taken fresh, filled with the poison pattern, then filled from the file
// as far as `p_filesz` reaches, and the rest of the page is zeroed --
// that last step is what makes the `.bss` zero, and `nobss` leaves it
// out.
fn segment(state: u64, t: u64, ino: u64, ph: u64, size: u64,
    bias: u64) -> u64 {
    let flags: u64 = kstate.get32(ph + P_FLAGS)
    let off: u64 = get64(ph + P_OFFSET)
    // RUNDE DYNLADER: DIE BASIS KOMMT DAZU, UND ZWAR HIER UND NUR HIER.
    //
    // Fuer ein ET_EXEC ist `bias` null, und dann steht unter dieser
    // Zeile Wort fuer Wort dasselbe wie vor der Runde. Fuer ein ET_DYN
    // ist `bias` die Basis, die der Kern gewaehlt hat.
    //
    // Die Addition ist GEPRUEFT (profile kernel, SPEC 13/L9), also darf
    // sie nicht ueberlaufen -- `vaddr` kommt aus der Datei und kann
    // 0xFFFFFFFFFFFFFFF0 sein. Die Schranke steht deshalb VOR der
    // Addition und ist eine Subtraktion auf der Seite, von der bekannt
    // ist, dass sie gross genug ist. Ohne sie waere ein feindliches
    // `p_vaddr` kein abgelehntes Programm, sondern ein toter Rechner.
    let vraw: u64 = get64(ph + P_VADDR)
    if vraw > proc.IMAGE_END {
        return R_RANGE
    }
    if bias > proc.IMAGE_END {
        return R_RANGE
    }
    let vaddr: u64 = vraw + bias
    let filesz: u64 = get64(ph + P_FILESZ)
    let memsz: u64 = get64(ph + P_MEMSZ)
    if memsz == 0 {
        return R_OK // nothing to map, and nothing to complain about
    }
    if filesz > memsz {
        return R_MEMSZ
    }
    if off > size {
        return R_SEGFILE
    }
    if size - off < filesz {
        return R_SEGFILE
    }
    if vaddr < proc.IMAGE_BASE {
        return R_RANGE
    }
    if vaddr >= proc.IMAGE_END {
        return R_RANGE
    }
    if proc.IMAGE_END - vaddr < memsz {
        return R_RANGE
    }
    // ============================================ RUNDE DYNLADER
    // DER VERSATZ IN DER SEITE, UND WARUM DIE REGEL HIER WEICHER WIRD.
    //
    // Regel 3 im Kopf dieser Datei lautet: EINE SEITE HAT EINEN SATZ
    // RECHTE, und daraus folgte bis zu dieser Runde `p_vaddr` und
    // `p_offset` muessen auf 4096 aufgehen, sonst R_ALIGN. Fuer die
    // Programme dieses Systems ist das richtig und bleibt es: sie werden
    // mit `kernel/user/user.ld` gebunden, das die drei Segmente trennt.
    //
    // FUER EINEN FREMDEN INTERPRETER IST ES NICHT ZU HALTEN, und das ist
    // gemessen und nicht vermutet (tools/dynlader/messung-wirt.sh):
    //
    //   ld-musl-x86_64.so.1  LOAD3  off=0xaab20 vaddr=0xabb20  -> 2848
    //   hello_dyn (musl-gcc) LOAD3  off=0x2e00  vaddr=0x3e00   -> 3584
    //
    // Das letzte LOAD faengt bei BEIDEN mitten in einer Seite an. Der
    // Grund ist derselbe, aus dem jeder Binder das so macht: die Datei
    // wird kleiner, wenn das Datensegment direkt hinter dem Textsegment
    // liegt, statt auf die naechste Seite gerundet zu werden.
    //
    // DER STATISCHE FALL KONNTE DAS UMGEHEN, der dynamische nicht.
    // tools/foreign/osum.ld setzt `. = ALIGN(4096)` zwischen die
    // Segmente -- das ist die erste der drei Regeln aus
    // tools/foreign/README.md. Den STOCK-Interpreter des Systems kann
    // man aber nicht neu binden; er ist die Datei, die da ist. Eine
    // Runde, die ihn neu bindet, hat nicht "ein Linux-Programm zum
    // Laufen gebracht", sondern sich ein eigenes gebaut.
    //
    // WAS LINUX TUT, und was ab hier auch dieser Kern tut: das Segment
    // faengt an der SEITENGRENZE DARUNTER an, und der Versatz in der
    // Seite bleibt erhalten. `p_vaddr & ~4095` ist die erste Seite,
    // `p_vaddr & 4095` der Versatz, an dem die Dateidaten darin
    // beginnen. Beides MUSS denselben Versatz haben (`p_vaddr` und
    // `p_offset` kongruent modulo 4096) -- sonst laesst sich die Datei
    // gar nicht seitenweise abbilden, und das prueft die Zeile unten.
    //
    // WAS DAS FUER REGEL 3 HEISST, ehrlich hingeschrieben: teilen sich
    // zwei Segmente eine Seite, bekommt diese Seite die Rechte des
    // ZWEITEN -- `map_page` wird fuer sie ein zweites Mal gerufen und
    // `page_free` sagt dann nein, also bleibt sie, wie sie war. Bei
    // musl ist das genau einmal der Fall, naemlich fuer die Seite, in
    // der rodata endet und data anfaengt; sie wird dadurch nicht
    // schreibbar, sondern bleibt lesbar, und das Datensegment bekommt
    // seine eigenen Seiten ab der naechsten Grenze. Ein Programm, das
    // darauf angewiesen waere, in diese eine geteilte Seite zu
    // schreiben, liefe hier nicht -- musl ist es nicht, und das ist
    // gemessen (die Zusagen hello/busybox in tools/dynlader/run.sh).
    //
    // ET_EXEC BLEIBT STRENG. Die Lockerung gilt nur, wenn ein Bild
    // verschoben wird (`bias != 0`), also fuer ET_DYN -- und damit fuer
    // genau die Dateien, die man nicht neu binden kann. Fuer die 135
    // Programme dieses Userlands gilt R_ALIGN unveraendert weiter, und
    // die Gegenprobe in tools/osum/run.sh, die ein `ld -n`-Abbild
    // ablehnen laesst, misst weiter dasselbe.
    let versatz: u64 = vaddr & PAGE_MASK
    if bias == 0 {
        if versatz != 0 {
            return R_ALIGN
        }
        if (off & PAGE_MASK) != 0 {
            return R_ALIGN
        }
    } else {
        // Verschiebbar, aber nicht beliebig: der Versatz in der Seite
        // muss in Datei und Adressraum derselbe sein.
        if versatz != (off & PAGE_MASK) {
            return R_ALIGN
        }
    }
    // Ab hier wird SEITENWEISE gedacht: `first` ist die Seite, in der
    // das Segment anfaengt, `span` die Zahl der Oktette von dort bis zum
    // Ende des Segments. Beide Zahlen sind durch die Pruefungen oben
    // gedeckt (`versatz <= PAGE_MASK`, `memsz <= IMAGE_END - vaddr`).
    let first: u64 = vaddr - versatz
    let span: u64 = memsz + versatz
    if proc.IMAGE_END - first < span {
        return R_RANGE
    }
    let file_first: u64 = off - (off & PAGE_MASK)
    let writable: bool = (flags & PF_W) != 0
    let runnable: bool = (flags & PF_X) != 0
    let zeroing: bool = !kstate.mode_on(state, kstate.M_NOBSS)
    var done: u64 = 0
    while done < span {
        let page: u64 = first + done
        // EINE SEITE, DIE SCHON DA IST, WIRD NICHT NOCH EINMAL GELEGT.
        //
        // Bis zu dieser Runde war das R_OVERLAP und ein abgelehntes
        // Programm. Das bleibt so, solange nichts verschoben wird
        // (`bias == 0`) -- zwei Segmente eines ET_EXEC, die sich eine
        // Seite teilen, sind weiterhin ein Fehler, und die Gegenprobe
        // dafuer steht in tools/osum/run.sh.
        //
        // Bei einem verschobenen Bild ist es der NORMALFALL an genau
        // einer Naht (siehe oben), und dort wird die Seite ERGAENZT
        // statt abgelehnt: ihr Inhalt kommt dazu, ihre Rechte bleiben.
        var frame: u64 = 0
        if proc.page_free(state, t, page) {
            frame = proc.map_page(state, t, page, writable, runnable)
            if frame == 0 {
                return R_NOMEM
            }
            fill(frame, PAGE, POISON)
            if zeroing {
                fill_bytes(frame, PAGE, 0)
            }
        } else {
            if bias == 0 {
                return R_OVERLAP
            }
            frame = proc.translate(state, t, page)
            if frame == 0 {
                return R_OVERLAP
            }
        }
        // Welcher Teil DIESER Seite kommt aus der Datei? Fuer die erste
        // Seite faengt er bei `versatz` an, fuer alle anderen bei 0; er
        // endet, wo `p_filesz` endet. Alles dahinter ist .bss und schon
        // genullt.
        var von: u64 = 0
        if done == 0 {
            von = versatz
        }
        // Wie weit die Dateidaten in dieser Seite reichen.
        let daten: u64 = filesz + versatz
        var bis: u64 = 0
        if daten > done {
            bis = daten - done
            if bis > PAGE {
                bis = PAGE
            }
        }
        if bis > von {
            let nimm: u64 = bis - von
            let sc: u64 = state + kstate.LOAD_OFF
            if fs.read_at(state, ino, file_first + done + von, sc,
                    nimm) != nimm {
                return R_READ
            }
            copy(sc, frame + von, nimm)
        }
        done = done + PAGE
    }
    return R_OK
}

fn fill_bytes(p: u64, n: u64, v: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, v as u8)
        i = i + 1
    }
}

// --------------------------------------------------------- the whole file

// Reads the file into the address space of task `t`. The task must be
// built and its page table empty above `proc.IMAGE_BASE`; on a refusal
// the caller throws the whole process away, which gives every frame that
// was already mapped back with it.
fn load(state: u64, t: u64, ino: u64) -> u64 {
    return load_at(state, t, ino, 0)
}

// RUNDE DYNLADER: DASSELBE, ABER AUF EINE BASIS.
//
// `load` ist ab dieser Runde der Sonderfall `bias == 0` von `load_at`,
// und das ist Absicht: es gibt weiterhin EINEN Weg, auf dem ein Bild in
// einen Adressraum kommt. Was `load_at` zusaetzlich kann, ist, ein
// zweites Bild neben ein schon liegendes zu legen -- der Interpreter.
//
// `AT_PHDR` WIRD HIER MITGENOMMEN, und das ist der Grund, warum diese
// Funktion ueberhaupt etwas nach aussen schreibt. Der Hilfsvektor
// braucht die Adresse, an der die Programmkoepfe NACH dem Laden im
// Adressraum stehen. Die findet man nur, indem man beim Legen der
// Segmente mitliest, welches `PT_LOAD` den Bereich `e_phoff` enthaelt;
// hinterher ist die Auskunft nicht mehr zu bekommen, ohne die Datei ein
// zweites Mal zu lesen. Findet sich keines (ein Bild, das seine Koepfe
// nicht mit einblendet), bleibt der Wert 0 und der Lader kommt ohne ihn
// aus, solange AT_BASE stimmt.
fn load_at(state: u64, t: u64, ino: u64, bias: u64) -> u64 {
    let r: u64 = read_header(state, ino)
    if r != R_OK {
        return r
    }
    let h: u64 = head(state)
    let size: u64 = fs.inode_size(state, ino)
    let n: u64 = kstate.get16(h + E_PHNUM)
    let phoff: u64 = get64(h + E_PHOFF)
    var loads: u64 = 0
    var bytes: u64 = 0
    var pages: u64 = 0
    var phdr: u64 = 0
    var top: u64 = 0
    var seg: u64 = 0
    while seg < n {
        let ph: u64 = h + EHSIZE + seg * PHENTSIZE
        if kstate.get32(ph + P_TYPE) == PT_LOAD {
            if get64(ph + P_MEMSZ) > 0 {
                let bad: u64 = segment(state, t, ino, ph, size, bias)
                if bad != R_OK {
                    return bad
                }
                loads = loads + 1
                bytes = bytes + get64(ph + P_FILESZ)
                pages = pages + (get64(ph + P_MEMSZ) + PAGE_MASK) / PAGE
                // Liegt `e_phoff` in DIESEM Segment, dann stehen die
                // Programmkoepfe im Adressraum an `p_vaddr + bias +
                // (phoff - p_offset)`. Die Subtraktionen sind so
                // geschrieben, dass keine unter null geht.
                let so: u64 = get64(ph + P_OFFSET)
                let sf: u64 = get64(ph + P_FILESZ)
                if phoff >= so {
                    if phoff - so < sf {
                        phdr = get64(ph + P_VADDR) + bias + (phoff - so)
                    }
                }
                // Das obere Ende des Bildes -- was der Aufrufer
                // braucht, um ein zweites daneben zu legen.
                let e: u64 = get64(ph + P_VADDR) + bias
                    + get64(ph + P_MEMSZ)
                if e > top {
                    top = e
                }
                say_segment(state, t, ph, bias)
            }
        }
        seg = seg + 1
    }
    if loads == 0 {
        return R_NOLOAD
    }
    // The last check, and it is the one that catches a file whose header
    // and whose segments each look fine on their own: `e_entry` has to
    // land on a page that was really mapped and is really executable.
    if !proc.page_exec(state, t, get64(h + E_ENTRY) + bias) {
        return R_ENTRY
    }
    kstate.set(state, kstate.ELF_BYTES, bytes)
    kstate.set(state, kstate.ELF_PAGES, pages)
    kstate.set(state, kstate.ELF_LOADS, loads)
    // RUNDE DYNLADER: was `build` fuer den Hilfsvektor braucht.
    kstate.set(state, kstate.K16_OFF + kstate.FT_SCALARS + DYN_PHDR, phdr)
    kstate.set(state, kstate.K16_OFF + kstate.FT_SCALARS + DYN_PHNUM, n)
    kstate.set(state, kstate.K16_OFF + kstate.FT_SCALARS + DYN_ENTRY,
        get64(h + E_ENTRY) + bias)
    kstate.set(state, kstate.K16_OFF + kstate.FT_SCALARS + DYN_TOP, top)
    return R_OK
}

// One line per segment, and it is the ONLY way to see from outside what
// rights a page really got: the numbers come out of the PAGE TABLE the
// loader just wrote, not out of the file it read. `w=` and `x=` are what
// `proc.page_free`/`proc.page_exec` see, `f=` is the frame the first page
// landed on.
// RUNDE DYNLADER: DIE ZEILE MUSS DIE BASIS KENNEN.
//
// Bis zu dieser Runde druckte sie `p_vaddr` aus der Datei und fragte die
// Seitentabelle an genau dieser Adresse. Fuer ein verschobenes Bild ist
// beides falsch: die Datei sagt 0x0, im Adressraum liegt das Segment auf
// 0x40A00000, und `translate(0x0)` antwortet 0 -- also stand in der
// Zeile `v=0x0 f=0x0`, und das sah aus, als sei nichts abgebildet
// worden, waehrend in Wahrheit alles richtig lag. Eine Meldung, die beim
// Verschieben nicht mitverschiebt, misst nicht das System, sondern die
// Datei.
fn say_segment(state: u64, t: u64, ph: u64, bias: u64) {
    var s_seg: [u8; 10] = "elf: seg \0"
    var s_v: [u8; 4] = " v=\0"
    var s_f: [u8; 4] = " f=\0"
    var s_file: [u8; 9] = " filesz=\0"
    var s_mem: [u8; 8] = " memsz=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_x: [u8; 4] = " x=\0"
    let vaddr: u64 = get64(ph + P_VADDR) + bias
    let flags: u64 = kstate.get32(ph + P_FLAGS)
    serial.puts((&s_seg[0]) as u64)
    serial.dec(flags)
    serial.puts((&s_v[0]) as u64)
    serial.hex(vaddr)
    serial.puts((&s_f[0]) as u64)
    serial.hex(proc.translate(state, t, vaddr))
    serial.puts((&s_file[0]) as u64)
    serial.dec(get64(ph + P_FILESZ))
    serial.puts((&s_mem[0]) as u64)
    serial.dec(get64(ph + P_MEMSZ))
    serial.puts((&s_w[0]) as u64)
    serial.dec(yes((flags & PF_W) != 0))
    serial.puts((&s_x[0]) as u64)
    serial.dec(yes(proc.page_exec(state, t, vaddr)))
    serial.nl()
}

fn yes(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

// ------------------------------------------------------ the arguments

// The block the program finds in rdi. It lies on the TOP stack page of
// the process, and the stack pointer is set below it -- so it costs no
// frame of its own and it is gone with the process.
//
//     +0     argc
//     +8     argv[0..argc-1], then a zero
//     +80    the strings, each one ended by a zero
//
// ROUND K11 PUT THE ENVIRONMENT ON THE SAME PAGE, at a fixed offset, so
// that nothing about the first half moves:
//
//     +2048  envc
//     +2056  envp[0..envc-1], then a zero
//     +2192  those strings, each one ended by a zero
//
// Where it comes from: the kernel holds ONE environment block
// (`kstate.K11_OFF + ENV_BUF`), and a process fills it with
// SYS_OSUM_SETENV. Every program started afterwards finds it here. That
// is not a per-process `environ` -- it is the half of it that a shell
// needs, and `docs/ROUNDK11.md` says so.
const ENV_OFF: u64 = 2048
const ENV_MAXN: u64 = 16
const ENV_STR: u64 = 2192 // ENV_OFF + 8 + (ENV_MAXN + 1) * 8

fn write_env(state: u64, frame: u64) {
    let n0: u64 = kstate.get(state, kstate.K11_OFF + kstate.ENV_N)
    var n: u64 = n0
    if n > ENV_MAXN {
        n = ENV_MAXN
    }
    put64(frame + ENV_OFF, n)
    var src: u64 = state + kstate.K11_OFF + kstate.ENV_BUF
    var at: u64 = ENV_STR
    var k: u64 = 0
    while k < n {
        put64(frame + ENV_OFF + 8 + k * 8, proc.ARGS_BASE + at)
        var going: bool = true
        while going {
            if at >= PAGE - 1 {
                put64(frame + ENV_OFF, k)
                return
            }
            let c: u64 = kstate.get8(src)
            kstate.set8(frame + at, c as u8)
            at = at + 1
            src = src + 1
            if c == 0 {
                going = false
            }
        }
        k = k + 1
    }
    put64(frame + ENV_OFF + 8 + n * 8, 0)
}

fn write_args(state: u64, t: u64, args: u64, argc: u64) -> bool {
    if argc > proc.MAX_ARGS {
        return false
    }
    // RUNDE K16: DIE SEITE MUSS ERST ENTSTEHEN. Bis zu dieser Runde war
    // `ARGS_BASE` die oberste der acht Stapelseiten, die `space_build`
    // ohnehin anlegt; jetzt liegt sie 476 KiB hoeher, damit der Stapel
    // dazwischen wachsen kann (`proc.grow_stack`). EIN Rahmen mehr je
    // Prozess von der Platte -- die acht von frueher bleiben, wo sie
    // sind, und die Rahmenzaehlungen der Runden 62 bis K12 vergleichen
    // vorher gegen nachher und nicht gegen eine feste Zahl.
    if proc.page_free(state, t, proc.ARGS_BASE) {
        // RUNDE FREMDLAND: GENULLT. Der Argumentblock wird nur
        // teilweise beschrieben; der Rest ist das, was ein Programm
        // als envp/auxv-Ende liest.
        if proc.map_page_zero(state, t, proc.ARGS_BASE, true, false) == 0 {
            return false
        }
    }
    let frame: u64 = proc.translate(state, t, proc.ARGS_BASE)
    if frame == 0 {
        return false
    }
    fill_bytes(frame, PAGE, 0)
    put64(frame, argc)
    var at: u64 = STR_OFF
    var src: u64 = args
    var k: u64 = 0
    while k < argc {
        put64(frame + 8 + k * 8, proc.ARGS_BASE + at)
        var going: bool = true
        while going {
            // ROUND K11: die Argumente enden bei ENV_OFF, denn dahinter
            // liegt die Umgebung. Vorher war die Grenze die Seite.
            if at >= ENV_OFF - 1 {
                return false
            }
            let c: u64 = kstate.get8(src)
            kstate.set8(frame + at, c as u8)
            at = at + 1
            src = src + 1
            if c == 0 {
                going = false
            }
        }
        k = k + 1
    }
    put64(frame + 8 + argc * 8, 0)
    write_env(state, frame)
    return true
}

// ============================================ RUNDE DYNLADER
// DER SYSTEM-V-STARTSTAPEL. Das Kernstueck der Runde.
//
// Osum uebergibt seit Runde K1 einen EIGENEN Block in RDI, und
// `write_args` weiter oben baut ihn. Die 135 Programme dieses Userlands
// lesen ihn mit `kernel/user/crt.s`, und statische musl-Programme mit
// `tools/foreign/start.s`, das ihn umrechnet.
//
// EIN FREMDER INTERPRETER HAT KEIN start.s. `ld-musl-x86_64.so.1`
// erwartet den Stapel, den Linux legt, und er erwartet ihn genau so:
//
//     rsp ->  argc
//             argv[0] .. argv[argc-1]
//             NULL
//             envp[0] .. envp[envc-1]
//             NULL
//             auxv[0].a_type, auxv[0].a_val
//             ...
//             AT_NULL, 0
//             <die Zeichenketten, irgendwo darueber>
//
// OHNE `auxv` KOMMT ER KEINE ZEHN BEFEHLE WEIT, und das ist keine
// Vermutung, sondern folgt aus dem, was er als Erstes tut: er muss sich
// SELBST relozieren, bevor er irgendeine eigene globale Variable
// anfassen darf. Dafuer braucht er `AT_BASE` (wo liege ich?). Danach
// braucht er `AT_PHDR`/`AT_PHNUM`, um die Programmkoepfe des HAUPTBILDS
// zu finden -- dort steht das `PT_DYNAMIC`, aus dem seine ganze Arbeit
// kommt. Und `AT_ENTRY`, um am Ende zu wissen, wohin er springt.
//
// WARUM RDI TROTZDEM BLEIBT, WIE ES WAR: `build` setzt `T_WORK`
// unveraendert auf `proc.ARGS_BASE`. Ein Programm mit `crt.s` liest RDI
// und findet dort denselben Block wie vor der Runde; ein Programm mit
// System-V-`_start` liest den Stapel. Beide Angaben stehen gleichzeitig
// da und widersprechen sich nicht -- sie liegen nur an verschiedenen
// Stellen derselben Seite.
//
// WO DER STAPEL LIEGT: auf der Seite UNTER dem Argumentblock, also
// zwischen `STACK_FLOOR` und `ARGS_BASE`. Dort sind seit Runde K16 504
// KiB Luft, und die Seiten davon entstehen bei Bedarf
// (`proc.grow_stack`). Diese eine Seite wird hier ausdruecklich angelegt,
// denn der allererste Zugriff darauf ist der `pop` des Interpreters --
// und ein Seitenfehler auf einen Stapel, der noch keiner ist, waere ein
// toter Prozess vor dem ersten Befehl.

const AT_NULL: u64 = 0
const AT_PHDR: u64 = 3
const AT_PHENT: u64 = 4
const AT_PHNUM: u64 = 5
const AT_PAGESZ: u64 = 6
const AT_BASE: u64 = 7
const AT_FLAGS: u64 = 8
const AT_ENTRY: u64 = 9
const AT_UID: u64 = 11
const AT_EUID: u64 = 12
const AT_GID: u64 = 13
const AT_EGID: u64 = 14
const AT_HWCAP: u64 = 16
const AT_CLKTCK: u64 = 17
const AT_SECURE: u64 = 23
const AT_RANDOM: u64 = 25

// Die Stapelseite liegt unmittelbar unter dem Argumentblock.
const SP_PAGE: u64 = 0x4007E000

// Wie viele Woerter der Vektor hoechstens belegt: 15 Paare plus AT_NULL.
const AUXN: u64 = 32

fn sv_put(frame: u64, at: u64, v: u64) {
    put64(frame + at, v)
}

// Baut den Stapel auf der Seite `SP_PAGE` und gibt den Stapelzeiger
// zurueck -- oder 0, wenn nichts passt.
//
// DER AUFBAU IST RUECKWAERTS GEDACHT UND VORWAERTS GESCHRIEBEN: die
// Zeichenketten kommen in die obere Haelfte der Seite, die Zeigertafel in
// die untere, und `rsp` zeigt auf `argc`. So braucht keine Zahl dieser
// Funktion eine Subtraktion, die unter null gehen koennte.
fn build_stack(state: u64, t: u64, args: u64, argc: u64,
    phdr: u64, phnum: u64, entry: u64, ibase: u64) -> u64 {
    if argc > proc.MAX_ARGS {
        return 0
    }
    if proc.page_free(state, t, SP_PAGE) {
        if proc.map_page_zero(state, t, SP_PAGE, true, false) == 0 {
            return 0
        }
    }
    let frame: u64 = proc.translate(state, t, SP_PAGE)
    if frame == 0 {
        return 0
    }
    fill_bytes(frame, PAGE, 0)

    // Die Umgebung, die dieser Kern fuehrt (Runde K11).
    let e0: u64 = kstate.get(state, kstate.K11_OFF + kstate.ENV_N)
    var envc: u64 = e0
    if envc > ENV_MAXN {
        envc = ENV_MAXN
    }

    // Die Zeigertafel: argc(1) + argv + 0 + envp + 0 + auxv.
    let need: u64 = (1 + argc + 1 + envc + 1 + AUXN) * 8
    // Die Zeichenketten fangen in der oberen Haelfte an. Passt die Tafel
    // nicht einmal bis dorthin, ist der Aufruf zu gross fuer diese Seite.
    let str_at: u64 = PAGE / 2
    if need > str_at {
        return 0
    }

    var at: u64 = 0
    sv_put(frame, at, argc)
    at = at + 8

    // argv -- die Zeichenketten wandern mit.
    var sp_str: u64 = str_at
    var k: u64 = 0
    var src: u64 = args
    while k < argc {
        sv_put(frame, at, SP_PAGE + sp_str)
        at = at + 8
        var going: bool = true
        while going {
            if sp_str >= PAGE - 24 {
                return 0
            }
            let c: u64 = kstate.get8(src)
            kstate.set8(frame + sp_str, c as u8)
            sp_str = sp_str + 1
            src = src + 1
            if c == 0 {
                going = false
            }
        }
        k = k + 1
    }
    sv_put(frame, at, 0)
    at = at + 8

    // envp
    var esrc: u64 = state + kstate.K11_OFF + kstate.ENV_BUF
    var j: u64 = 0
    while j < envc {
        sv_put(frame, at, SP_PAGE + sp_str)
        at = at + 8
        var going2: bool = true
        while going2 {
            if sp_str >= PAGE - 24 {
                return 0
            }
            let c2: u64 = kstate.get8(esrc)
            kstate.set8(frame + sp_str, c2 as u8)
            sp_str = sp_str + 1
            esrc = esrc + 1
            if c2 == 0 {
                going2 = false
            }
        }
        j = j + 1
    }
    sv_put(frame, at, 0)
    at = at + 8

    // AT_RANDOM: sechzehn Oktette, auf die musl seinen Stapelwaechter und
    // den Anfangswert seiner Hashfunktionen stuetzt. Sie liegen HINTER
    // den Zeichenketten auf derselben Seite.
    if sp_str + 16 >= PAGE {
        return 0
    }
    let rnd: u64 = sp_str
    var b: u64 = 0
    // Kein Zufallszahlengeber im Lader, und das wird hier GESAGT statt
    // verschwiegen: was hier steht, ist der Zaehlerstand der Uhr, mit dem
    // Ort im Adressraum vermengt. Das ist genug, damit zwei Prozesse
    // nicht dieselben sechzehn Oktette sehen, und es ist NICHT genug fuer
    // etwas, das Zufall braucht. Wer Zufall will, ruft `getrandom` (318,
    // der Kern hat es) -- musl tut das fuer `arc4random` auch.
    // DIE MASKE IST PFLICHT, NICHT STIL. Unter `profile kernel` ist die
    // Arithmetik GEPRUEFT (SPEC 13/L9), und `as u8` auf einem Wert ueber
    // 255 ist kein stilles Abschneiden, sondern `osum_panic` -- der Kern
    // ist dann tot. Gemessen, bevor `& 255` hier stand:
    //   panic: integer overflow casting 'u64 as u8' at elf.fi:958
    // und zwar NACHDEM beide Bilder schon richtig lagen. Jede Stelle
    // dieser Datei, die ein Oktett aus einer Rechnung nimmt, maskiert
    // deshalb ausdruecklich.
    let seed: u64 = kstate.get(state, kstate.TICKS) + t * 2654435761
    while b < 16 {
        let wert: u64 = (seed >> ((b & 7) * 8)) + b * 31 + t
        kstate.set8(frame + rnd + b, (wert & 255) as u8)
        b = b + 1
    }
    sp_str = sp_str + 16

    // Und der Vektor selbst.
    sv_put(frame, at, AT_PHDR)
    at = at + 8
    sv_put(frame, at, phdr)
    at = at + 8
    sv_put(frame, at, AT_PHENT)
    at = at + 8
    sv_put(frame, at, PHENTSIZE)
    at = at + 8
    sv_put(frame, at, AT_PHNUM)
    at = at + 8
    sv_put(frame, at, phnum)
    at = at + 8
    sv_put(frame, at, AT_PAGESZ)
    at = at + 8
    sv_put(frame, at, PAGE)
    at = at + 8
    sv_put(frame, at, AT_BASE)
    at = at + 8
    sv_put(frame, at, ibase)
    at = at + 8
    sv_put(frame, at, AT_FLAGS)
    at = at + 8
    sv_put(frame, at, 0)
    at = at + 8
    sv_put(frame, at, AT_ENTRY)
    at = at + 8
    sv_put(frame, at, entry)
    at = at + 8
    sv_put(frame, at, AT_UID)
    at = at + 8
    sv_put(frame, at, sched.tget(state, t, sched.T_UID))
    at = at + 8
    sv_put(frame, at, AT_EUID)
    at = at + 8
    sv_put(frame, at, sched.tget(state, t, sched.T_EUID))
    at = at + 8
    sv_put(frame, at, AT_GID)
    at = at + 8
    sv_put(frame, at, sched.tget(state, t, sched.T_GID))
    at = at + 8
    sv_put(frame, at, AT_EGID)
    at = at + 8
    sv_put(frame, at, sched.tget(state, t, sched.T_EGID))
    at = at + 8
    sv_put(frame, at, AT_CLKTCK)
    at = at + 8
    sv_put(frame, at, 100)
    at = at + 8
    // AT_SECURE ist 0, und das ist die WAHRHEIT und keine Bequemlichkeit:
    // `perm.apply_exec` hat die Kennungen schon gesetzt, wenn das
    // setuid-Bit stand. Waere hier eine 1 ohne diesen Fall, wuerde musl
    // die Umgebung entschaerfen, obwohl nichts entschaerft werden muss.
    sv_put(frame, at, AT_SECURE)
    at = at + 8
    sv_put(frame, at, 0)
    at = at + 8
    // AT_HWCAP: dieser Kern sagt nichts ueber die Faehigkeiten des
    // Prozessors zu. musl benutzt den Wert nur fuer die Auswahl
    // schnellerer Fassungen einzelner Funktionen und kommt mit 0 aus.
    sv_put(frame, at, AT_HWCAP)
    at = at + 8
    sv_put(frame, at, 0)
    at = at + 8
    sv_put(frame, at, AT_RANDOM)
    at = at + 8
    sv_put(frame, at, SP_PAGE + rnd)
    at = at + 8
    sv_put(frame, at, AT_NULL)
    at = at + 8
    sv_put(frame, at, 0)
    at = at + 8
    if at > str_at {
        return 0
    }
    return SP_PAGE
}

// ------------------------------------------------------------- spawn

// THE CALL EVERYTHING ELSE GOES THROUGH. `path` and `args` are KERNEL
// addresses: `args` holds `argc` strings one after the other, each ended
// by a zero. Returns the task index, or 0 -- and then `kstate.ELF_ERR`
// says why.
//
// WHY THIS IS A `spawn` AND NOT A UNIX `exec`. Unix replaces the image of
// the CALLING process, and it needs `fork` in front of it to have a
// process to throw away. `fork` without copy-on-write means copying an
// image that the very next instruction discards, and copy-on-write means
// a fault handler that shares frames and counts references -- that is a
// round of its own in `mem.fi` and `proc.fi`, and none of the four things
// `fork` is really used for (a redirection between fork and exec, a
// process that goes on running as itself, a shell job, a daemon) exists
// in this system. What DOES exist is `proc.create_bare`: a task plus an
// empty address space, exactly the thing an image has to be poured into.
// So the loader fills a NEW process and hands its pid back, the way
// `posix_spawn` does, and the caller waits for it with `wait`. The old
// `spawn` of round 62 (a program compiled into the kernel, with the
// parent's data page inherited) stays where it is and keeps its meaning;
// an image off the disk gets a ZEROED data page, because there is nothing
// sensible for it to inherit.
fn spawn(state: u64, path: u64, args: u64, argc: u64, prio: u64) -> u64 {
    let t: u64 = build(state, path, args, argc, prio)
    if t == 0 {
        return 0
    }
    let flags: u64 = sched.irq_save()
    // ROUND K6, IN THE SHAPE ROUND K4 LEFT: the child gets the
    // descriptors and the working directory of whoever asked for it.
    // That, and nothing else, is what makes `ls > /out` work in a shell
    // -- the shell redirects ITSELF and the child is born into it. It
    // happens under the same lock that starts the task: one line later
    // and the child could have run before it was given its output.
    //
    // THE THREE, AND NOT ALL SIXTEEN. This is not a `fork`: what the
    // caller wants the child to have is where its output goes, and what it
    // does not want to hand over is the descriptors it keeps for itself.
    // `file.inherit_std` is the difference (`kernel/file.fi`).
    //
    // The one caller that is NOT a process is `kmain.osum`, which starts
    // the first shell out of the boot task. That task never went through
    // `proc.create`, so its descriptor table is empty -- and a child that
    // inherited an empty table would have nowhere to write. It keeps the
    // three console descriptors `proc.create_bare` gave it.
    let par: u64 = sched.current(state)
    if file.fd_of(state, par, 1) < file.MAX_OPEN {
        file.inherit_std(state, par, t)
    }
    uio.adopt(state, par, t)
    // RUNDE O-CONTAINER: auch der Ein-Aufruf-Start bleibt im Container.
    // `spawn` ist der Weg, den die Shell nimmt -- waere er offen, waere
    // der Container genau so lange dicht, bis jemand ein Programm
    // startet.
    ctr.inherit(state, par, t)
    say_start(state, t)
    sched.start(state, t)
    sched.irq_restore(flags)
    return t
}

// ================================================ RUNDE K16: DER AUSLEGER
//
// `#!/bin/sh` in der ersten Zeile. Das ist der aelteste Trick von Unix und
// der Grund, warum eine Skriptsprache dort kein Sonderfall ist: das
// Betriebssystem startet nicht die Datei, sondern das Programm, das in
// ihrer ersten Zeile steht, und reicht ihr den Pfad der Datei als
// Argument.
//
// WARUM DAS HIER STEHT UND NICHT IN DER SHELL. Eine Shell, die `#!` selbst
// auswertet, hat es fuer sich geloest. `execve` ist die Stelle, durch die
// JEDER Programmstart dieses Systems geht -- die Shell, `exec` aus Ring 3,
// der Doppelklick von Runde K15, ein Programm, das ein anderes startet.
// Steht es hier, koennen alle es, und keines von ihnen weiss davon.
//
// DIE REGEL, WORT FUER WORT WIE BEI LINUX:
//
//     Datei:   #!/bin/sh -e
//     Aufruf:  execve("/tmp/x.sh", ["x.sh", "a"])
//     wird zu: execve("/bin/sh", ["/bin/sh", "-e", "/tmp/x.sh", "a"])
//
// Das urspruengliche argv[0] FAELLT WEG -- an seine Stelle tritt der
// Ausleger. Hoechstens EIN Argument wird aus der Zeile genommen; alles
// weitere darin ist ein Wort dieses einen Arguments (auch das ist
// Linux' Regel, und sie ist der Grund, warum `#!/usr/bin/env python3`
// geht und `#!/usr/bin/env -S a b` nicht).
//
// GRENZEN, ausdruecklich:
//   * hoechstens MAX_INTERP Stufen, dann -ELOOP. Ein Skript, dessen
//     Ausleger es selbst ist, haelt den Kern damit nicht an.
//   * der Pfad des Auslegers hoechstens IPATH_MAX-1 Oktette.
//   * die Argumente zusammen hoechstens proc.MAX_ARGS Stueck -- die
//     Argumentseite eines Prozesses fasst nicht mehr, und das war vor
//     dieser Runde genauso.
const MAX_INTERP: u64 = 4
const IPATH_MAX: u64 = 128
const IARGS_MAX: u64 = 2048
const IWORD_MAX: u64 = 256 // ein Wort der Argumentliste

fn ist_luecke(c: u64) -> bool {
    return c == 32 || c == 9
}

// Liest die erste Zeile der Datei. 0 = kein `#!`, sonst die Zahl der
// Woerter (1 = nur der Ausleger, 2 = Ausleger und ein Argument),
// 0xFFFFFFFFFFFFFFFF = es IST ein `#!`, aber unbrauchbar.
fn read_shebang(state: u64, ino: u64, dst_path: u64, dst_arg: u64) -> u64 {
    let buf: u64 = state + kstate.K16_OFF + kstate.FT_SB
    var i: u64 = 0
    while i < 256 {
        kstate.set8(buf + i, 0 as u8)
        i = i + 1
    }
    let n: u64 = fs.read_at(state, ino, 0, buf, 255)
    if n < 3 {
        return 0
    }
    if kstate.get8(buf) != 35 {
        return 0 // '#'
    }
    if kstate.get8(buf + 1) != 33 {
        return 0 // '!'
    }
    // Die Zeile endet am Zeilenvorschub oder am Ende dessen, was gelesen
    // wurde. Ein Wagenruecklauf davor zaehlt als Ende -- eine Datei mit
    // CRLF ist sonst ein Ausleger namens "/bin/sh\r", den es nicht gibt.
    var ende: u64 = 2
    var suche: bool = true
    while suche {
        if ende >= n {
            suche = false
        } else {
            let c: u64 = kstate.get8(buf + ende)
            if c == 10 || c == 13 || c == 0 {
                suche = false
            } else {
                ende = ende + 1
            }
        }
    }
    var p: u64 = 2
    while p < ende && ist_luecke(kstate.get8(buf + p)) {
        p = p + 1
    }
    if p >= ende {
        return 0 -% 1 // `#!` und sonst nichts
    }
    var k: u64 = 0
    while p < ende && !ist_luecke(kstate.get8(buf + p)) {
        if k + 1 >= IPATH_MAX {
            return 0 -% 1
        }
        kstate.set8(dst_path + k, kstate.get8(buf + p) as u8)
        k = k + 1
        p = p + 1
    }
    kstate.set8(dst_path + k, 0 as u8)
    if k == 0 {
        return 0 -% 1
    }
    while p < ende && ist_luecke(kstate.get8(buf + p)) {
        p = p + 1
    }
    if p >= ende {
        return 1
    }
    // Der REST der Zeile ist EIN Argument, mitsamt seinen Leerzeichen --
    // aber ohne die am Ende, weil ein Argument, das auf ein Leerzeichen
    // endet, in keiner Datei so gemeint war.
    var e2: u64 = ende
    while e2 > p && ist_luecke(kstate.get8(buf + e2 - 1)) {
        e2 = e2 - 1
    }
    k = 0
    while p < e2 {
        if k + 1 >= IPATH_MAX {
            return 0 -% 1
        }
        kstate.set8(dst_arg + k, kstate.get8(buf + p) as u8)
        k = k + 1
        p = p + 1
    }
    kstate.set8(dst_arg + k, 0 as u8)
    return 2
}

fn copy_word(dst: u64, src: u64, max: u64) -> u64 {
    var i: u64 = 0
    while i < max {
        let c: u64 = kstate.get8(src + i)
        kstate.set8(dst + i, c as u8)
        if c == 0 {
            return i + 1
        }
        i = i + 1
    }
    kstate.set8(dst + max - 1, 0 as u8)
    return max
}

// Wie viele Oktette das k-te Wort in einer Argumentliste vorne liegt.
fn word_at(args: u64, k: u64) -> u64 {
    var at: u64 = 0
    var i: u64 = 0
    while i < k {
        while kstate.get8(args + at) != 0 {
            at = at + 1
        }
        at = at + 1
        i = i + 1
    }
    return args + at
}

// ROUND K4. `spawn` above is this plus `sched.start`, and the split is
// what `execve` needed: it does not want a second RUNNING process, it
// wants an address space with the image in it that it can take over
// (`sys.do_execve`, `proc.swap_space`). What comes back is a task that is
// complete and S_NEW -- the scheduler will not touch it until somebody
// says so, and if nobody does, `proc.discard` takes it apart again.
// Den Ausleger aufloesen. Zurueck kommt die neue Zahl der Argumente,
// oder ein Fehler; Pfad und Argumentliste stehen danach in kdata
// (IPATH_SLOT, IARGS_SLOT). Getrennt von `build`, damit die Ortsvariablen
// dieser Schleife nicht waehrend `load` auf dem Kernelstapel stehen --
// siehe den Kommentar dort.
const IPATH_SLOT: u64 = 0x40
const IARGS_SLOT: u64 = 0x48

// ================================================== RUNDE DYNLADER
// Was `load_at` ueber das eben gelegte Bild hinterlaesst, damit `build`
// den Hilfsvektor fuellen kann. Sie liegen bei den uebrigen Skalaren des
// K16-Bereichs und nicht als Rueckgabewerte, weil eine Firn-Funktion ein
// Wort zurueckgibt und hier vier gebraucht werden.
const DYN_PHDR: u64 = 0x50 // AT_PHDR: die Koepfe IM ADRESSRAUM
const DYN_PHNUM: u64 = 0x58 // AT_PHNUM
const DYN_ENTRY: u64 = 0x60 // AT_ENTRY: Einsprung des HAUPTBILDS
const DYN_TOP: u64 = 0x68 // oberes Ende des Bildes
const DYN_IBASE: u64 = 0x70 // AT_BASE: Basis des INTERPRETERS

// WO DER INTERPRETER LIEGT, und warum ausgerechnet dort.
//
// Gemessen (tools/dynlader/messung-wirt.sh): ld-musl-x86_64.so.1 spannt
// ueber alle PT_LOAD zusammen 0x0 .. 0xaef60, also 0,68 MiB. Das
// Abbildfenster dieses Systems ist 11 MiB gross
// (proc.IMAGE_BASE 0x40100000 .. proc.IMAGE_END 0x40C00000) -- der
// Interpreter passt sechzehnmal hinein.
//
// Er bekommt eine FESTE Basis am OBEREN Ende des Fensters und nicht
// irgendeine freie Stelle. Der Grund ist die Richtung, in die die beiden
// Bilder wachsen: ein PIE-Programm faengt bei bias an und waechst nach
// oben, also darf der Interpreter nicht darueber liegen, wo das Programm
// ankommen kann. Zwei MiB unter IMAGE_END lassen ihm das Dreifache
// seiner Spanne und dem Programm die uebrigen neun MiB.
//
// Die Ueberlappung wird trotzdem nicht ANGENOMMEN, sondern gemerkt:
// `segment` ruft `proc.page_free` fuer jede Seite und gibt R_OVERLAP,
// wenn das zweite Bild auf eine Seite des ersten trifft. Diese Konstante
// ist also die Wahl, nicht die Sicherung.
const INTERP_BASE: u64 = 0x40A00000

// Wo ein PIE-Hauptbild hinkommt. Es zaehlt ab 0, also ist das schlicht
// IMAGE_BASE -- dieselbe Stelle, an der ein ET_EXEC dieses Systems
// ohnehin liegt (tools/foreign/osum.ld linkt genau dorthin).
const PIE_BASE: u64 = 0x40100000

// ================================================== RUNDE DYNLADER
// LIEST `PT_INTERP` AUS EINEM BILD, DAS NOCH NICHT GELADEN IST.
//
// Der Kopf steht schon im gemeinsamen Puffer (`read_header` hat ihn
// gelesen), aber sein INHALT nicht -- `p_offset`/`p_filesz` zeigen auf
// eine Zeichenkette in der Datei. Die wird hier geholt.
//
// Rueckgabe: R_KEINER = kein PT_INTERP (das Bild braucht keinen Lader),
// R_OK = Pfad steht in `dst`, sonst ein Grund.
//
// WARUM R_KEINER UND NICHT 0, und das war ein echter Fehler dieser
// Runde: `R_OK` IST 0. Ein `return 0` fuer "kein PT_INTERP gefunden"
// ist damit buchstaeblich dasselbe Wort wie "Pfad steht bereit", und
// der Aufrufer, der auf `ir == R_OK` prueft, haelt JEDES Bild fuer
// eines mit Lader -- auch die 135 statischen. Gemessen sah das so aus:
// `elf: interp` druckte eine LEERE Zeile und der Lader suchte einen
// Interpreter namens "", den es nicht gibt (Grund 26). Zwei Zustaende,
// die sich unterscheiden muessen, brauchen zwei Zahlen.
//
// DREI DINGE WERDEN GEPRUEFT, und jedes davon ist ein Weg, auf dem eine
// feindliche Datei sonst in den Kernel kaeme:
//   * `p_filesz` gegen den Zielpuffer -- sonst schreibt eine Datei mit
//     einem 4-GiB-"Pfad" durch den K16-Bereich,
//   * `p_offset`/`p_filesz` gegen die Dateigroesse, als SUBTRAKTION
//     (siehe Regel 2 im Kopf dieser Datei),
//   * die Zeichenkette MUSS mit einer Null enden. Ein Pfad ohne Null
//     waere ab `fs.path` eine Lesung ins Offene.
fn read_interp(state: u64, ino: u64, dst: u64) -> u64 {
    let h: u64 = head(state)
    let size: u64 = fs.inode_size(state, ino)
    let n: u64 = kstate.get16(h + E_PHNUM)
    var seg: u64 = 0
    while seg < n {
        let ph: u64 = h + EHSIZE + seg * PHENTSIZE
        if kstate.get32(ph + P_TYPE) == PT_INTERP {
            let off: u64 = get64(ph + P_OFFSET)
            let len: u64 = get64(ph + P_FILESZ)
            if len == 0 {
                return R_IPATH
            }
            if len > IPATH_MAX {
                return R_IPATH
            }
            if off > size {
                return R_IPATH
            }
            if size - off < len {
                return R_IPATH
            }
            if fs.read_at(state, ino, off, dst, len) != len {
                return R_READ
            }
            // Die letzte Stelle MUSS die Null sein. Linux verlangt
            // dasselbe, und aus demselben Grund.
            if kstate.get8(dst + len - 1) != 0 {
                return R_IPATH
            }
            return R_OK
        }
        seg = seg + 1
    }
    return R_KEINER
}

fn aufloesen(state: u64, path: u64, args: u64, argc: u64) -> u64 {
    var p: u64 = path
    var a: u64 = args
    var n: u64 = argc
    var stufe: u64 = 0
    var page: u64 = 0
    var suchen: bool = true
    while suchen {
        let ino: u64 = fs.path(state, p)
        if ino == 0 {
            fail(state, R_NOFILE)
            return errno.neg(errno.E_NOENT)
        }
        if fs.inode_type(state, ino) != fs.T_FILE {
            fail(state, R_ISDIR)
            return errno.neg(errno.E_ISDIR)
        }
        let k16: u64 = state + kstate.K16_OFF
        let ip: u64 = k16 + kstate.FT_IPATH + page * IPATH_MAX
        let ia: u64 = k16 + kstate.FT_IPATH + 2 * IPATH_MAX + page * IPATH_MAX
        let w: u64 = read_shebang(state, ino, ip, ia)
        if w == 0 {
            suchen = false
        } else {
            if w == (0 -% 1) {
                fail(state, R_INTERP)
                return errno.neg(errno.E_LOOP)
            }
            if stufe >= MAX_INTERP {
                fail(state, R_INTERP)
                return errno.neg(errno.E_LOOP)
            }
            let na: u64 = k16 + kstate.FT_ARGS + page * IARGS_MAX
            var at: u64 = 0
            var neu: u64 = 0
            at = at + copy_word(na + at, ip, IWORD_MAX)
            neu = neu + 1
            if w == 2 {
                at = at + copy_word(na + at, ia, IWORD_MAX)
                neu = neu + 1
            }
            at = at + copy_word(na + at, p, IWORD_MAX)
            neu = neu + 1
            var k: u64 = 1
            while k < n {
                if at + IWORD_MAX > IARGS_MAX {
                    fail(state, R_ARGS)
                    return errno.neg(errno.E_2BIG)
                }
                at = at + copy_word(na + at, word_at(a, k), IWORD_MAX)
                neu = neu + 1
                k = k + 1
            }
            if neu > proc.MAX_ARGS {
                fail(state, R_ARGS)
                return errno.neg(errno.E_2BIG)
            }
            let z: u64 = kstate.K16_OFF + kstate.FT_SCALARS
                + kstate.FT_SHEBANGS
            kstate.set(state, z, kstate.get(state, z) + 1)
            p = ip
            a = na
            n = neu
            page = 1 - page
            stufe = stufe + 1
        }
    }
    kstate.set(state, kstate.K16_OFF + kstate.FT_SCALARS + IPATH_SLOT, p)
    kstate.set(state, kstate.K16_OFF + kstate.FT_SCALARS + IARGS_SLOT, a)
    return n
}

fn build(state: u64, path: u64, args: u64, argc: u64, prio: u64) -> u64 {
    fail(state, R_OK)
    if kstate.get(state, kstate.FS_READY) == 0 {
        fail(state, R_NOFILE)
        return 0
    }
    // RUNDE K16: DER AUSLEGER. Die Arbeit steht in `aufloesen`, und das
    // ist KEINE Geschmacksfrage: der tiefste Punkt, den der Kernelstapel
    // dieses Systems je erreicht, liegt in `load` -> `fs.read_at` -> dem
    // Plattentreiber, und er lag beim Bau dieser Runde bei 16.208 von
    // 16.384 Oktetten. Jede Ortsvariable, die hier steht, steht waehrend
    // `load` noch da. Also stehen sie in einer Funktion, die VORHER
    // fertig ist, und was sie hinterlaesst, sind zwei Zeiger in kdata.
    let n: u64 = aufloesen(state, path, args, argc)
    if errno.is_error(n) {
        return 0
    }
    let p: u64 = kstate.get(state, kstate.K16_OFF + kstate.FT_SCALARS
        + IPATH_SLOT)
    let a: u64 = kstate.get(state, kstate.K16_OFF + kstate.FT_SCALARS
        + IARGS_SLOT)
    let ino: u64 = fs.path(state, p)
    if ino == 0 {
        fail(state, R_NOFILE)
        return 0
    }
    // RUNDE K13, UND SIE STEHT HIER UND NUR HIER. Jeder Weg, auf dem in
    // diesem Kernel ein Programm von der Platte startet -- `execve`,
    // `SYS_OSUM_EXEC`, `elf.spawn` aus dem Kern heraus -- geht durch
    // diese Funktion. Eine Datei ohne Ausfuehrungsrecht ist damit an
    // JEDEM dieser Wege kein Programm, und es gibt keinen vierten.
    if !perm.may(state, sched.current(state), ino, perm.R_EXEC) {
        fail(state, R_PERM)
        return 0
    }
    // Interrupts stay down until the process is COMPLETE -- the same rule
    // as in `proc.create`, and for the same reason: a task the scheduler
    // takes while its page table is half full has an rip that points into
    // a page that is not there yet.
    let flags: u64 = sched.irq_save()
    let t: u64 = proc.create_bare(state, prio)
    if t == 0 {
        sched.irq_restore(flags)
        fail(state, R_NOMEM)
        return 0
    }
    // ============================================ RUNDE DYNLADER
    // ERST NACHSEHEN, OB DAS BILD EINEN LADER VERLANGT -- und zwar
    // BEVOR es gelegt wird, denn davon haengt ab, auf welche Basis es
    // kommt. `read_header` hat die Programmkoepfe schon im Puffer.
    var r0: u64 = read_header(state, ino)
    if r0 != R_OK {
        proc.discard(state, t)
        sched.irq_restore(flags)
        fail(state, r0)
        return 0
    }
    let h0: u64 = head(state)
    let ist_dyn: bool = kstate.get16(h0 + E_TYPE) == ET_DYN
    let ipath: u64 = state + kstate.K16_OFF + kstate.FT_IPATH
        + 3 * IPATH_MAX
    let ir: u64 = read_interp(state, ino, ipath)
    if ir != R_KEINER {
        if ir != R_OK {
            proc.discard(state, t)
            sched.irq_restore(flags)
            fail(state, ir)
            return 0
        }
    }
    let braucht_lader: bool = ir == R_OK
    // RUNDE DYNLADER: WAS FUER EIN LADER VERLANGT WIRD, WIRD GESAGT.
    // Ein Programm, das mit "interpreter missing" abgelehnt wird, ohne
    // dass irgendwo steht, WELCHER Pfad gesucht wurde, ist so schwer zu
    // finden wie ein Rechner, der stehenbleibt (derselbe Satz wie ueber
    // `say_badentry`). Die Zeile kostet nichts bei Programmen ohne
    // PT_INTERP -- die kommen hier gar nicht vorbei.
    if braucht_lader {
        say_interp(ipath)
    }
    // Ein ET_DYN wird auf PIE_BASE geschoben, ein ET_EXEC bleibt, wo es
    // sich selbst hingelegt hat. Das ist die EINZIGE Stelle, an der sich
    // die beiden unterscheiden.
    var bias: u64 = 0
    if ist_dyn {
        bias = PIE_BASE
    }
    let r: u64 = load_at(state, t, ino, bias)
    if r != R_OK {
        proc.discard(state, t)
        sched.irq_restore(flags)
        fail(state, r)
        return 0
    }
    // Was das HAUPTBILD fuer den Hilfsvektor beisteuert. Es wird hier
    // weggesichert, weil das Laden des Interpreters dieselben Slots
    // ueberschreibt -- ein gemeinsamer Puffer, wie ueberall in dieser
    // Datei.
    let sc: u64 = state + kstate.K16_OFF + kstate.FT_SCALARS
    let at_phdr: u64 = kstate.get(state, kstate.K16_OFF
        + kstate.FT_SCALARS + DYN_PHDR)
    let at_phnum: u64 = kstate.get(state, kstate.K16_OFF
        + kstate.FT_SCALARS + DYN_PHNUM)
    let at_entry: u64 = kstate.get(state, kstate.K16_OFF
        + kstate.FT_SCALARS + DYN_ENTRY)
    // Der Einsprung, den `user_start` nimmt. Ohne Lader ist das der des
    // Bildes selbst; mit Lader wird er unten ersetzt.
    var start_ip: u64 = at_entry
    var at_base: u64 = 0
    if braucht_lader {
        // Der Interpreter ist eine ganz gewoehnliche Datei dieses
        // Dateisystems, und er wird wie jede andere gesucht.
        let iino: u64 = fs.path(state, ipath)
        if iino == 0 {
            proc.discard(state, t)
            sched.irq_restore(flags)
            fail(state, R_INOFILE)
            return 0
        }
        if fs.inode_type(state, iino) != fs.T_FILE {
            proc.discard(state, t)
            sched.irq_restore(flags)
            fail(state, R_INOFILE)
            return 0
        }
        let ir2: u64 = read_header(state, iino)
        if ir2 != R_OK {
            proc.discard(state, t)
            sched.irq_restore(flags)
            fail(state, R_IFORM)
            return 0
        }
        // EIN INTERPRETER MIT EIGENEM INTERPRETER WIRD ABGEWIESEN.
        // Linux macht es genauso, und der Grund ist derselbe: die Kette
        // haette kein Ende, das der Kern garantieren koennte. Die
        // Gegenprobe `ketteninterp` in tools/dynlader/run.sh faehrt
        // genau diesen Fall.
        let kette: u64 = state + kstate.K16_OFF + kstate.FT_IPATH
            + 4 * IPATH_MAX
        if read_interp(state, iino, kette) != R_KEINER {
            proc.discard(state, t)
            sched.irq_restore(flags)
            fail(state, R_ICHAIN)
            return 0
        }
        let ir3: u64 = load_at(state, t, iino, INTERP_BASE)
        if ir3 != R_OK {
            proc.discard(state, t)
            sched.irq_restore(flags)
            fail(state, ir3)
            return 0
        }
        at_base = INTERP_BASE
        // UND HIER WECHSELT DER EINSPRUNG. Der Kern springt NICHT in
        // das Programm, sondern in den Lader; das Programm erfaehrt der
        // Lader ueber AT_ENTRY. Das ist der ganze Unterschied zwischen
        // statisch und dynamisch, auf eine Zeile gebracht.
        start_ip = kstate.get(state, kstate.K16_OFF
            + kstate.FT_SCALARS + DYN_ENTRY)
    }
    // Das setuid-Bit, auf die eben gebaute Aufgabe. `execve` traegt die
    // Kennungen von dort in den Aufrufer ein, `spawn` startet diese
    // Aufgabe unmittelbar -- beide Wege kommen hier vorbei.
    perm.apply_exec(state, t, ino)
    if !write_args(state, t, a, n) {
        proc.discard(state, t)
        sched.irq_restore(flags)
        fail(state, R_ARGS)
        return 0
    }
    let h: u64 = head(state)
    // ============================================ RUNDE STARTKNOPF
    // DER EINSPRUNG WIRD GEPRUEFT, BEVOR EIN PROZESS DARAUS ENTSTEHT.
    //
    // `h` ist EIN gemeinsamer Kopfpuffer (`kstate.ELF_OFF`). Was hier
    // gelesen wird, ist der Kopf der ZULETZT geladenen Datei -- und
    // zwischen `load` und dieser Zeile liegen `perm.apply_exec` und
    // `write_args`. Steht dort etwas Nichtkanonisches, endet es am
    // `sysretq` in `enter_user_task` als #GP(0) IN RING 0, und das
    // haelt die ganze Maschine an (genau Justins Absturz, rip
    // 0x0010049C). Ein Programm, dessen Einsprung nicht in die untere
    // Haelfte des Adressraums zeigt, wird ab hier gar nicht erst
    // gestartet.
    // RUNDE DYNLADER: der Einsprung kommt aus `start_ip` und nicht mehr
    // aus dem Kopfpuffer. Fuer ein ET_EXEC ohne Lader ist das
    // buchstaeblich derselbe Wert (bias 0, kein Interpreter) -- fuer
    // alles andere ist es der einzig richtige.
    var eentry: u64 = start_ip
    if kstate.mode_on(state, kstate.M_EINSPRUNG) {
        // Die Gegenprobe: ein Einsprung, wie ihn kein Uebersetzer je
        // erzeugt. Muss abgelehnt werden, ohne den Rechner mitzunehmen.
        eentry = 0xDEAD000000000000
    }
    if eentry == 0 || (eentry >> 47) != 0 {
        say_badentry(state, eentry)
        proc.discard(state, t)
        sched.irq_restore(flags)
        fail(state, R_ENTRY)
        return 0
    }
    sched.tset(state, t, sched.T_ENTRY, eentry)
    // RUNDE K16: DER STAPELZEIGER ZEIGT AUF DEN ARGUMENTBLOCK.
    //
    // Bis zu dieser Runde stand er 16 Oktette darunter, und der Block war
    // NUR ueber rdi zu finden. Das ging, solange jedes Programm dieses
    // Systems mit `kernel/user/crt.s` gebunden wurde -- der liest rdi.
    //
    // Ein Programm, das der UNVERAENDERTE `firnc` gebaut hat, liest ihn
    // nicht. Sein `_start` steht in `lib/firnc1/codegen.fi` und lautet
    // `xor rbp,rbp / mov rdi,rsp / and rsp,-16 / call main` -- die
    // Uebergabe von Linux, wo argc bei `_start` AUF dem Stapel liegt.
    // Und der Block, den `write_args` baut, hat genau diese Form: argc,
    // dann die Zeiger, dann eine Null (der Kommentar darueber sagt es
    // seit Runde K1, `tools/k11/hostcrt.s` nutzt es seit K11 in die
    // andere Richtung).
    //
    // Es fehlten also 16 Oktette, und die sind hier. rdi bleibt, wie es
    // war -- die 52 Programme mit crt.s merken nichts davon; was sich
    // aendert, ist eine Zahl in der Startzeile (`tools/osum/run.sh`
    // prueft sie und ist mitgezogen).
    // ============================================ RUNDE DYNLADER
    // WER EINEN LADER HAT, BEKOMMT DEN SYSTEM-V-STAPEL.
    //
    // Fuer alles andere bleibt es bei `ARGS_BASE` -- Wort fuer Wort wie
    // seit Runde K16, und die 135 Programme dieses Userlands merken von
    // dieser Runde nichts. RDI (`T_WORK`) bleibt in BEIDEN Faellen der
    // Argumentblock; der fremde Lader sieht ihn nur nie an.
    var ustack: u64 = proc.ARGS_BASE
    if braucht_lader {
        let sp: u64 = build_stack(state, t, a, n, at_phdr, at_phnum,
            at_entry, at_base)
        if sp == 0 {
            proc.discard(state, t)
            sched.irq_restore(flags)
            fail(state, R_STACK)
            return 0
        }
        ustack = sp
    }
    sched.tset(state, t, sched.T_USTACK, ustack)
    sched.tset(state, t, sched.T_ARG, 0)
    sched.tset(state, t, sched.T_WORK, proc.ARGS_BASE)
    kstate.add(state, kstate.SPAWNS, 1)
    kstate.add(state, kstate.EXECS, 1)
    // ROUND POWERMON: THE ONE SEAM WHERE A TASK GETS A PROGRAM. Every
    // path that turns a file into something running -- `SYS_OSUM_SPAWN`,
    // `SYS_OSUM_EXEC`, `execve`, round K16's opener, and `kmain.osum`
    // starting the first shell out of the boot task -- ends here. Hooking
    // the callers instead means hooking five of them and missing the
    // sixth, and the sixth was the shell: it ran the whole acceptance
    // script under the name `system`, because nobody had told the power
    // accounting what it was.
    //
    // The slot may have been somebody else's a moment ago, so it is
    // cleared before it is named.
    pmon.task_clear(state, t, sched.tget(state, t, sched.T_PID))
    pmon.name_set(state, t, path)
    sched.irq_restore(flags)
    return t
}

// Ein abgelehnter Einsprung wird GESAGT. Ein Programm, das schweigend
// nicht startet, ist so schwer zu finden wie ein Rechner, der steht.
fn say_badentry(state: u64, e: u64) {
    var s_a: [u8; 27] = "elf: entry abgelehnt e=\0\0\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.hex(e)
    serial.nl()
}

fn say_start(state: u64, t: u64) {
    var s_go: [u8; 12] = "elf: start \0"
    var s_e: [u8; 8] = " entry=\0"
    var s_u: [u8; 9] = " ustack=\0"
    var s_k: [u8; 9] = " kstack=\0"
    var s_b: [u8; 8] = " bytes=\0"
    var s_p: [u8; 8] = " pages=\0"
    serial.puts((&s_go[0]) as u64)
    serial.dec(sched.tget(state, t, sched.T_PID))
    serial.puts((&s_e[0]) as u64)
    serial.hex(sched.tget(state, t, sched.T_ENTRY))
    serial.puts((&s_u[0]) as u64)
    serial.hex(sched.tget(state, t, sched.T_USTACK))
    serial.puts((&s_k[0]) as u64)
    serial.hex(sched.tget(state, t, sched.T_KSTACK))
    serial.puts((&s_b[0]) as u64)
    serial.dec(kstate.get(state, kstate.ELF_BYTES))
    serial.puts((&s_p[0]) as u64)
    serial.dec(kstate.get(state, kstate.ELF_PAGES))
    serial.nl()
}

// ---------------------------------------------------------- the errno

// What ring 3 gets to see. Everything that is not a missing file, a
// directory or a lack of memory is the same thing to a program: the file
// is not a program of this machine.
fn errno_of(r: u64) -> u64 {
    if r == R_NOFILE {
        return errno.E_NOENT
    }
    if r == R_ISDIR {
        return errno.E_ISDIR
    }
    if r == R_NOMEM {
        return errno.E_NOMEM
    }
    if r == R_ARGS {
        return errno.E_2BIG
    }
    if r == R_PERM {
        return errno.E_ACCES
    }
    if r == R_INTERP {
        return errno.E_LOOP
    }
    // RUNDE DYNLADER. Zwei der fuenf neuen Gruende bekommen eine eigene
    // Fehlernummer, weil ein Programm sie auseinanderhalten koennen
    // muss:
    //   * den INTERPRETER gibt es nicht -> ENOENT. Das ist derselbe
    //     Befund wie bei einer fehlenden Programmdatei, und Linux
    //     antwortet hier ebenfalls ENOENT. Ohne diese Zeile bekaeme der
    //     Aufrufer ENOEXEC ("kein Programm") fuer eine Datei, die ein
    //     voellig gueltiges Programm IST -- nur eben ohne Lader.
    //   * die Kette -> ELOOP, wie beim `#!`-Ausleger einer Zeile hoeher.
    // R_IPATH, R_IFORM und R_STACK bleiben ENOEXEC: dort ist wirklich
    // die DATEI kaputt bzw. zu gross.
    if r == R_INOFILE {
        return errno.E_NOENT
    }
    if r == R_ICHAIN {
        return errno.E_LOOP
    }
    return errno.E_NOEXEC
}

// ---------------------------------------------------------- the report

// One line on the serial port for every refusal. The number is what the
// guard reads, the text is what a person reads.
//
// WHY THIS IS FIVE FUNCTIONS AND NOT ONE. Written as one function the
// twenty-two texts are twenty-two local arrays in ONE stack frame, some
// 500 octets -- and this frame sits at the DEEPEST point the kernel ever
// reaches: a refusal happens inside `sys.do_exec`, under `elf.spawn`,
// under `fs.read_at`, under the ATA driver. Round K1 measured 16240
// octets of kernel stack that way, out of the 16384 a task has; the same
// run with the texts split across five functions that are called one
// AFTER the other -- never one inside the other -- measures 9216.
//
// The obvious answer, `static` texts in `.rodata` (round 89), is not
// available here: firnc1 compiles a `static` array and reads out of it,
// but it cannot take its ADDRESS -- `(&MSG[0]) as u64` and `(&MSG) as
// u64` both make it stop, while `(&X) as u64` on a scalar `static` is
// fine. Both compilers have to build this kernel, so the texts stay
// locals. Measured on 2026-08-24 against `.firnc1`; when that gap closes,
// twenty-two `static`s and one function are the better shape.
fn say_reason(r: u64) {
    var head_t: [u8; 22] = "elf: refused, reason \0"
    var gap: [u8; 3] = "  \0"
    serial.puts((&head_t[0]) as u64)
    serial.dec(r)
    serial.puts((&gap[0]) as u64)
    say_text(r)
    serial.nl()
}

fn say_text(r: u64) {
    // RUNDE DYNLADER: die fuenf neuen Gruende zuerst, in einer eigenen
    // Funktion -- aus demselben Grund, aus dem es die fuenf anderen
    // gibt (der Kommentar ueber `say_reason` rechnet ihn vor).
    if r >= R_IPATH {
        say_text_f(r)
        return
    }
    if r <= 4 {
        say_text_a(r)
        return
    }
    if r <= 9 {
        say_text_b(r)
        return
    }
    if r <= 14 {
        say_text_c(r)
        return
    }
    if r <= 18 {
        say_text_d(r)
        return
    }
    say_text_e(r)
}

fn say_text_a(r: u64) {
    var t1: [u8; 13] = "no such file\0"
    var t2: [u8; 17] = "not a plain file\0"
    var t3: [u8; 22] = "shorter than a header\0"
    var t4: [u8; 13] = "no ELF magic\0"
    var tx: [u8; 8] = "unknown\0"
    if r == R_NOFILE {
        serial.puts((&t1[0]) as u64)
        return
    }
    if r == R_ISDIR {
        serial.puts((&t2[0]) as u64)
        return
    }
    if r == R_SHORT {
        serial.puts((&t3[0]) as u64)
        return
    }
    if r == R_MAGIC {
        serial.puts((&t4[0]) as u64)
        return
    }
    serial.puts((&tx[0]) as u64)
}

fn say_text_b(r: u64) {
    var t5: [u8; 15] = "not ELFCLASS64\0"
    var t6: [u8; 18] = "not little endian\0"
    var t7: [u8; 14] = "wrong version\0"
    var t8: [u8; 12] = "not ET_EXEC\0"
    var t9: [u8; 11] = "not x86-64\0"
    if r == R_CLASS {
        serial.puts((&t5[0]) as u64)
        return
    }
    if r == R_ENDIAN {
        serial.puts((&t6[0]) as u64)
        return
    }
    if r == R_VERSION {
        serial.puts((&t7[0]) as u64)
        return
    }
    if r == R_TYPE {
        serial.puts((&t8[0]) as u64)
        return
    }
    serial.puts((&t9[0]) as u64)
}

fn say_text_c(r: u64) {
    var t10: [u8; 19] = "wrong header sizes\0"
    var t11: [u8; 24] = "no or too many segments\0"
    var t12: [u8; 29] = "program headers past the end\0"
    var t13: [u8; 21] = "segment past the end\0"
    var t14: [u8; 19] = "filesz above memsz\0"
    if r == R_SIZES {
        serial.puts((&t10[0]) as u64)
        return
    }
    if r == R_PHNUM {
        serial.puts((&t11[0]) as u64)
        return
    }
    if r == R_PHOFF {
        serial.puts((&t12[0]) as u64)
        return
    }
    if r == R_SEGFILE {
        serial.puts((&t13[0]) as u64)
        return
    }
    serial.puts((&t14[0]) as u64)
}

fn say_text_d(r: u64) {
    var t15: [u8; 24] = "outside the user region\0"
    var t16: [u8; 17] = "not page aligned\0"
    var t17: [u8; 22] = "two segments one page\0"
    var t18: [u8; 14] = "out of frames\0"
    var tx: [u8; 8] = "unknown\0"
    if r == R_RANGE {
        serial.puts((&t15[0]) as u64)
        return
    }
    if r == R_ALIGN {
        serial.puts((&t16[0]) as u64)
        return
    }
    if r == R_OVERLAP {
        serial.puts((&t17[0]) as u64)
        return
    }
    if r == R_NOMEM {
        serial.puts((&t18[0]) as u64)
        return
    }
    serial.puts((&tx[0]) as u64)
}

fn say_text_e(r: u64) {
    var t19: [u8; 22] = "entry on no exec page\0"
    var t20: [u8; 16] = "short disk read\0"
    var t21: [u8; 11] = "no PT_LOAD\0"
    var t22: [u8; 19] = "arguments too long\0"
    var tx: [u8; 8] = "unknown\0"
    if r == R_ENTRY {
        serial.puts((&t19[0]) as u64)
        return
    }
    if r == R_READ {
        serial.puts((&t20[0]) as u64)
        return
    }
    if r == R_NOLOAD {
        serial.puts((&t21[0]) as u64)
        return
    }
    if r == R_ARGS {
        serial.puts((&t22[0]) as u64)
        return
    }
    serial.puts((&tx[0]) as u64)
}

// RUNDE DYNLADER: die Gruende, die es ohne dynamischen Lader nicht gab.
fn say_text_f(r: u64) {
    var t25: [u8; 20] = "bad PT_INTERP path\0\0"
    var t26: [u8; 22] = "interpreter missing\0\0\0"
    var t27: [u8; 24] = "interpreter chained\0\0\0\0\0"
    var t28: [u8; 22] = "interpreter format\0\0\0\0"
    var t29: [u8; 20] = "start stack too big\0"
    var tz: [u8; 8] = "unknown\0"
    if r == R_IPATH {
        serial.puts((&t25[0]) as u64)
        return
    }
    if r == R_INOFILE {
        serial.puts((&t26[0]) as u64)
        return
    }
    if r == R_ICHAIN {
        serial.puts((&t27[0]) as u64)
        return
    }
    if r == R_IFORM {
        serial.puts((&t28[0]) as u64)
        return
    }
    if r == R_STACK {
        serial.puts((&t29[0]) as u64)
        return
    }
    serial.puts((&tz[0]) as u64)
}

// RUNDE DYNLADER: der Pfad, den ein Bild als Lader verlangt.
fn say_interp(p: u64) {
    var s_i: [u8; 14] = "elf: interp \0\0"
    serial.puts((&s_i[0]) as u64)
    serial.puts(p)
    serial.nl()
}
