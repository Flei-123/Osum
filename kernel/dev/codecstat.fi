// SPDX-License-Identifier: GPL-2.0-only
// kernel/codecstat.fi -- Runde CODEC (P-022): die Zaehler des Videocodecs.
//
// WARUM DAS IM KERN STEHT, wo der Dekodierer selbst in Ring 3 laeuft.
// Die Bilder gehen den Kern nichts an -- er sieht sie nie, und das ist
// richtig so (`kernel/user/h264.fi` haelt seine Puffer selbst). Was
// den Kern angeht, ist die FRAGE, die ein Werkzeug wie `top` oder die
// Systemsteuerung stellt: laeuft hier gerade Video, wieviel, und wie
// oft ist etwas schiefgegangen? Diese Antwort muss einen Prozess
// ueberleben und gehoert deshalb in `kdata`.
//
// DER BEREICH IST DIESER RUNDE VORHER ZUGETEILT: CODEC_OFF 0x118000
// bis ausschliesslich 0x120000, acht Seiten. Belegt ist EINE; die
// uebrigen sieben bleiben zugeteilt und frei, damit ein zweiter Codec
// seine Zaehler nicht irgendwo anders suchen muss. Die Bildpuffer
// liegen hier NICHT und duerfen hier nie liegen -- ein CIF-Bild ist
// 152 KiB, vier davon der halbe kdata-Bereich.

profile kernel

import lib.kstate

export {
    cd_reset, cd_frame, cd_reject, cd_seen,
    cd_frames, cd_rejects, cd_lasterr, cd_w, cd_h, cd_profile, cd_mb
}

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.CODEC_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.CODEC_OFF + off, v)
}

fn cd_reset(state: u64) {
    s(state, kstate.CD_FRAMES, 0)
    s(state, kstate.CD_REJECT, 0)
    s(state, kstate.CD_LASTERR, 0)
    s(state, kstate.CD_W, 0)
    s(state, kstate.CD_H, 0)
    s(state, kstate.CD_PROFILE, 0)
    s(state, kstate.CD_MB, 0)
}

// Ein Bild ist fertig geworden.
fn cd_frame(state: u64) {
    s(state, kstate.CD_FRAMES, g(state, kstate.CD_FRAMES) + 1)
}

// Ein Strom wurde abgewiesen; `grund` ist der Fehlercode aus h264.fi.
fn cd_reject(state: u64, grund: u64) {
    s(state, kstate.CD_REJECT, g(state, kstate.CD_REJECT) + 1)
    s(state, kstate.CD_LASTERR, grund)
}

// Die Masse des zuletzt gesehenen Bildes.
fn cd_seen(state: u64, w: u64, h: u64, profil: u64, mb: u64) {
    s(state, kstate.CD_W, w)
    s(state, kstate.CD_H, h)
    s(state, kstate.CD_PROFILE, profil)
    s(state, kstate.CD_MB, mb)
}

fn cd_frames(state: u64) -> u64 { return g(state, kstate.CD_FRAMES) }
fn cd_rejects(state: u64) -> u64 { return g(state, kstate.CD_REJECT) }
fn cd_lasterr(state: u64) -> u64 { return g(state, kstate.CD_LASTERR) }
fn cd_w(state: u64) -> u64 { return g(state, kstate.CD_W) }
fn cd_h(state: u64) -> u64 { return g(state, kstate.CD_H) }
fn cd_profile(state: u64) -> u64 { return g(state, kstate.CD_PROFILE) }
fn cd_mb(state: u64) -> u64 { return g(state, kstate.CD_MB) }
