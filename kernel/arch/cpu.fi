
import lib.kstate
import libc.regio

export {
    set_lapic, lapic_base, register, count, here, apic_id, online,
    set_online, online_count, get, set, add, record, earg_buf,
    C_APICID, C_ONLINE, C_CUR, C_IDLE, C_TICKS, C_SWITCHES, C_STACK,
    C_GDT, C_TSS, C_WORK, C_GO, C_SUM, C_CYCLES, C_PICKS, C_STARTED,
    C_IDLERUNS, C_LAPIC, C_FPUOWNER, C_IDLETICKS, C_INDEX, gs_arm, gs_disarm,
    C_SYSRSP, C_KSTACK, C_TSSADDR,
    C_SYSCALLS, GSFAST_AT,
    C_TOTMARKE, C_TOTZEIT, C_TOTZAHL, C_TOTPER,
    C_PARKREQ, C_PARKED, C_RESUMED,
    C_WHY, C_ESR, WHY_NONE, WHY_OK, WHY_NOMEM, WHY_NOSIPI, WHY_NOONLINE, WHY_NOSMP,
    why_word, x_get, x_set, x_add,
    X_LASTTSC, X_TOTCYC, X_IDLECYC, X_HALTED, X_PEND, X_KICKTX, X_KICKRX
}

const C_APICID: u64 = 0
const C_ONLINE: u64 = 8
const C_CUR: u64 = 16
const C_IDLE: u64 = 24
const C_TICKS: u64 = 32
const C_SWITCHES: u64 = 40
const C_STACK: u64 = 48
const C_GDT: u64 = 56
const C_TSS: u64 = 64
const C_WORK: u64 = 72
const C_GO: u64 = 80
const C_SUM: u64 = 88
const C_CYCLES: u64 = 96
const C_PICKS: u64 = 104
const C_STARTED: u64 = 112
const C_IDLERUNS: u64 = 120
const C_FPUOWNER: u64 = 128
const C_SYSRSP: u64 = 136
const C_KSTACK: u64 = 144
const C_TSSADDR: u64 = 152
const C_SYSCALLS: u64 = 160
const C_IDLETICKS: u64 = 168

const C_TOTMARKE: u64 = 176
const C_TOTZEIT: u64 = 184
const C_TOTZAHL: u64 = 192
const C_PARKREQ: u64 = 200
const C_PARKED: u64 = 208
const C_RESUMED: u64 = 216
const C_WHY: u64 = 240
const C_ESR: u64 = 248
const WHY_NONE: u64 = 0
const WHY_OK: u64 = 1
const WHY_NOMEM: u64 = 2
const WHY_NOSIPI: u64 = 3
const WHY_NOONLINE: u64 = 4
const WHY_NOSMP: u64 = 5

const C_LAPIC: u64 = 0

const R_ID: u64 = 0x020

fn record(state: u64, i: u64) -> u64 {
    return state + kstate.CPU_OFF + i * kstate.CPU_BYTES
}

fn get(state: u64, i: u64, field: u64) -> u64 {
    return __mmio_read64((record(state, i) + field) as *mut u64)
}

fn set(state: u64, i: u64, field: u64, v: u64) {
    __mmio_write64((record(state, i) + field) as *mut u64, v)
}

fn add(state: u64, i: u64, field: u64, v: u64) -> u64 {
    return __atomic_add((record(state, i) + field) as *mut u64, v) + v
}

fn set_lapic(state: u64, base: u64) {
    kstate.set(state, kstate.SMP_OFF + kstate.SMP_LAPIC, base)
}

fn lapic_base(state: u64) -> u64 {
    return kstate.get(state, kstate.SMP_OFF + kstate.SMP_LAPIC)
}

fn count(state: u64) -> u64 {
    return kstate.get(state, kstate.SMP_OFF + kstate.SMP_COUNT)
}

fn register(state: u64, apid: u64) -> u64 {
    let n: u64 = count(state)
    if n >= kstate.MAX_CPUS {
        return kstate.MAX_CPUS
    }
    let k_sysrsp: u64 = get(state, n, C_SYSRSP)
    let k_kstack: u64 = get(state, n, C_KSTACK)
    let k_tss: u64 = get(state, n, C_TSSADDR)
    let k_sysc: u64 = get(state, n, C_SYSCALLS)
    var i: u64 = 0
    while i < kstate.CPU_BYTES / 8 {
        __mmio_write64((record(state, n) + i * 8) as *mut u64, 0)
        i = i + 1
    }
    set(state, n, C_SYSRSP, k_sysrsp)
    set(state, n, C_KSTACK, k_kstack)
    set(state, n, C_TSSADDR, k_tss)
    set(state, n, C_SYSCALLS, k_sysc)
    set(state, n, C_APICID, apid)
    set(state, n, C_INDEX, n)
    kstate.set(state, kstate.SMP_OFF + kstate.SMP_COUNT, n + 1)
    return n
}

fn apic_id(state: u64, i: u64) -> u64 {
    return get(state, i, C_APICID)
}

fn earg_buf(state: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_NOEARGK) {
        return state + kstate.EARG_OFF
    }
    var k: u64 = here(state)
    if k >= kstate.MAX_CPUS {
        k = 0
    }
    return state + kstate.EARGK_OFF + k * 4096
}

const C_INDEX: u64 = 224
const C_TOTPER: u64 = 232
const GSFAST_AT: u64 = 392

fn gs_arm(state: u64) {
    if online_count(state) == count(state) {
        kstate.set(state, kstate.SMP_OFF + GSFAST_AT, 1)
    }
}

fn gs_disarm(state: u64) {
    kstate.set(state, kstate.SMP_OFF + GSFAST_AT, 0)
}

fn here(state: u64) -> u64 {
    let n: u64 = *((state + kstate.SMP_OFF + kstate.SMP_COUNT) as *mut u64)
    if n <= 1 {
        return 0
    }
    if *((state + kstate.SMP_OFF + GSFAST_AT) as *mut u64) != 0 {
        let gi: u64 = asm("mov rax, qword ptr gs:[224]", out("rax"))
        if gi < n {
            return gi
        }
    }
    let base: u64 = lapic_base(state)
    if base == 0 {
        return 0
    }
    let apid: u64 = (regio.read32(base + R_ID) >> 24) & 0xFF
    var i: u64 = 0
    while i < n {
        if get(state, i, C_APICID) == apid {
            return i
        }
        i = i + 1
    }
    return 0
}

fn online(state: u64, i: u64) -> bool {
    return get(state, i, C_ONLINE) != 0
}

fn set_online(state: u64, i: u64, v: u64) {
    set(state, i, C_ONLINE, v)
}

fn online_count(state: u64) -> u64 {
    let n: u64 = count(state)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if get(state, i, C_ONLINE) != 0 {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn why_word(code: u64) -> u64 {
    if code == WHY_OK {
        return 0x6b6f
    }
    if code == WHY_NOMEM {
        return 0x6d656d6f6e
    }
    if code == WHY_NOSIPI {
        return 0x697069736f6e
    }
    if code == WHY_NOONLINE {
        return 0x656e696c6e6f6f6e
    }
    if code == WHY_NOSMP {
        return 0x706d736f6e
    }
    return 0x2D
}

const X_LASTTSC: u64 = 0
const X_TOTCYC: u64 = 8
const X_IDLECYC: u64 = 16
const X_HALTED: u64 = 24
const X_PEND: u64 = 32
const X_KICKTX: u64 = 40
const X_KICKRX: u64 = 48

fn x_get(state: u64, i: u64, field: u64) -> u64 {
    return __mmio_read64((state + kstate.CPUX_OFF + i * kstate.CPUX_BYTES + field) as *mut u64)
}

fn x_set(state: u64, i: u64, field: u64, v: u64) {
    __mmio_write64((state + kstate.CPUX_OFF + i * kstate.CPUX_BYTES + field) as *mut u64, v)
}

fn x_add(state: u64, i: u64, field: u64, v: u64) -> u64 {
    return __atomic_add((state + kstate.CPUX_OFF + i * kstate.CPUX_BYTES + field) as *mut u64, v) + v
}
