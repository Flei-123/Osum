
import lib.kstate
import serial
import mm.mmframe
import arch.cpu
import libc.numeric

export {
    parse, probe, cpuid_a, cpuid_b, cpuid_c, apply, apply_here, report, report_aps,
    enabled, lazy, area_size, mode, xcr0,
    area_new, area_free, area_init, area_copy,
    save, restore, switch, on_nm, drop_owner, adopt_now, ts_set, ts_clear,
    sync_here,
    M_NOFPU, M_NOFPUSWITCH, M_FPULAZY, M_NOXSAVE, M_NOAVX, M_VEC,
    M_FPUFORCE, M_R3SMP, M_BENCH, want, cpu_feat,
    MODE_OFF, MODE_FX, MODE_XSAVE, MODE_XSAVEOPT,
    PROBE_WORDS, PROBE_BYTES, vec_seed, vec_put, vec_take, vec_calc,
    vec_ref, vec_diff
}

const CR0_MP: u64 = 2
const CR0_EM: u64 = 4
const CR0_TS: u64 = 8
const CR0_NE: u64 = 32

const CR4_OSFXSR: u64 = 0x200
const CR4_OSXMMEXCPT: u64 = 0x400
const CR4_OSXSAVE: u64 = 0x40000

const F1_FXSR: u64 = 0x1000000
const F1_SSE: u64 = 0x2000000
const F1_XSAVE: u64 = 0x4000000
const F1_AVX: u64 = 0x10000000

const F7_AVX512F: u64 = 0x10000

const FD1_XSAVEOPT: u64 = 1

const XCR0_X87: u64 = 1
const XCR0_SSE: u64 = 2
const XCR0_AVX: u64 = 4
const XCR0_AVX512: u64 = 0xE0

const MODE_OFF: u64 = 0
const MODE_FX: u64 = 1
const MODE_XSAVE: u64 = 2
const MODE_XSAVEOPT: u64 = 3

const AREA_MAX: u64 = 4096

const INIT_FCW: u64 = 0x37F
const INIT_MXCSR: u64 = 0x1F80
const INIT_MXCSR_MASK: u64 = 0xFFFF

const M_NOFPU: u64 = 1
const M_NOFPUSWITCH: u64 = 2
const M_FPULAZY: u64 = 4
const M_NOXSAVE: u64 = 8
const M_NOAVX: u64 = 16
const M_VEC: u64 = 32
const M_FPUFORCE: u64 = 64
const M_R3SMP: u64 = 128
const M_BENCH: u64 = 256

fn parse(state: u64, cmd: u64) {
    var w_nofpu: [u8; 6] = "nofpu\0"
    var w_nosw: [u8; 12] = "nofpuswitch\0"
    var w_lazy: [u8; 8] = "fpulazy\0"
    var w_noxs: [u8; 8] = "noxsave\0"
    var w_noavx: [u8; 6] = "noavx\0"
    var w_vec: [u8; 8] = "vecproc\0"
    var w_force: [u8; 9] = "fpuforce\0"
    var w_r3: [u8; 6] = "r3smp\0"
    var w_bench: [u8; 9] = "fpubench\0"
    var m: u64 = 0
    if cmd != 0 {
        if find(cmd, (&w_nosw[0]) as u64, 11) != 0 {
            m = m | M_NOFPUSWITCH
        } else {
            if find(cmd, (&w_nofpu[0]) as u64, 5) != 0 {
                m = m | M_NOFPU
            }
        }
        if find(cmd, (&w_lazy[0]) as u64, 7) != 0 {
            m = m | M_FPULAZY
        }
        if find(cmd, (&w_noxs[0]) as u64, 7) != 0 {
            m = m | M_NOXSAVE
        }
        if find(cmd, (&w_noavx[0]) as u64, 5) != 0 {
            m = m | M_NOAVX
        }
        if find(cmd, (&w_vec[0]) as u64, 7) != 0 {
            m = m | M_VEC
        }
        if find(cmd, (&w_force[0]) as u64, 8) != 0 {
            m = m | M_FPUFORCE
        }
        if find(cmd, (&w_r3[0]) as u64, 5) != 0 {
            m = m | M_R3SMP
        }
        if find(cmd, (&w_bench[0]) as u64, 8) != 0 {
            m = m | M_BENCH
        }
    }
    kstate.set(state, kstate.FPU_WORDS, m)
    kstate.set(state, kstate.FPU_MODE, MODE_OFF)
    kstate.set(state, kstate.FPU_XCR0, 0)
    kstate.set(state, kstate.FPU_SIZE, 0)
    kstate.set(state, kstate.FPU_APS, 0)
    kstate.set(state, kstate.FPU_SAVES, 0)
    kstate.set(state, kstate.FPU_RESTORES, 0)
    kstate.set(state, kstate.FPU_NM, 0)
    kstate.set(state, kstate.FPU_AREAS, 0)
}

fn want(state: u64, bit: u64) -> bool {
    return (kstate.get(state, kstate.FPU_WORDS) & bit) != 0
}

fn cpuid_a(leaf: u64, sub: u64) -> u64 {
    return asm("push rbx\nmov eax, edi\nmov ecx, esi\ncpuid\npop rbx",
        in("rdi") leaf, in("rsi") sub, out("rax"),
        clobber("rcx"), clobber("rdx"))
}

fn cpuid_b(leaf: u64, sub: u64) -> u64 {
    return asm("push rbx\nmov eax, edi\nmov ecx, esi\ncpuid\nmov eax, ebx\npop rbx",
        in("rdi") leaf, in("rsi") sub, out("rax"),
        clobber("rcx"), clobber("rdx"))
}

fn cpuid_c(leaf: u64, sub: u64) -> u64 {
    return asm("push rbx\nmov eax, edi\nmov ecx, esi\ncpuid\nmov eax, ecx\npop rbx",
        in("rdi") leaf, in("rsi") sub, out("rax"),
        clobber("rcx"), clobber("rdx"))
}

fn cpuid_d(leaf: u64, sub: u64) -> u64 {
    return asm("push rbx\nmov eax, edi\nmov ecx, esi\ncpuid\nmov eax, edx\npop rbx",
        in("rdi") leaf, in("rsi") sub, out("rax"),
        clobber("rcx"), clobber("rdx"))
}

fn max_leaf() -> u64 {
    return cpuid_a(0, 0)
}

fn cr0() -> u64 {
    return asm("mov rax, cr0", out("rax"))
}

fn cr0_set(v: u64) {
    asm("mov cr0, rax", in("rax") v)
}

fn cr4() -> u64 {
    return asm("mov rax, cr4", out("rax"))
}

fn cr4_set(v: u64) {
    asm("mov cr4, rax", in("rax") v)
}

fn xsetbv0(v: u64) {
    asm("mov rdx, rax\nshr rdx, 32\nxor ecx, ecx\nxsetbv",
        in("rax") v, clobber("rcx"), clobber("rdx"))
}

fn xgetbv0() -> u64 {
    return asm("xor ecx, ecx\nxgetbv\nmov eax, eax\nshl rdx, 32\nor rax, rdx",
        out("rax"), clobber("rcx"), clobber("rdx"))
}

fn clts() {
    asm("clts")
}

fn ts_clear() {
    clts()
}

fn ts_set() {
    cr0_set(cr0() | CR0_TS)
}

fn fxsave_to(area: u64) {
    asm("fxsave64 [rdi]", in("rdi") area, clobber("memory"))
}

fn fxrstor_from(area: u64) {
    asm("fxrstor64 [rdi]", in("rdi") area, clobber("memory"))
}

fn xsave_to(area: u64, m: u64) {
    asm("mov rdx, rax\nshr rdx, 32\nxsave64 [rdi]",
        in("rdi") area, in("rax") m, clobber("rdx"), clobber("memory"))
}

fn xsaveopt_to(area: u64, m: u64) {
    asm("mov rdx, rax\nshr rdx, 32\nxsaveopt64 [rdi]",
        in("rdi") area, in("rax") m, clobber("rdx"), clobber("memory"))
}

fn xrstor_from(area: u64, m: u64) {
    asm("mov rdx, rax\nshr rdx, 32\nxrstor64 [rdi]",
        in("rdi") area, in("rax") m, clobber("rdx"), clobber("memory"))
}

fn probe(state: u64) {
    if want(state, M_NOFPU) {
        kstate.set(state, kstate.FPU_MODE, MODE_OFF)
        return
    }
    let mx: u64 = max_leaf()
    if mx < 1 {
        kstate.set(state, kstate.FPU_MODE, MODE_OFF)
        return
    }
    let f1d: u64 = cpuid_d(1, 0)
    let f1c: u64 = cpuid_c(1, 0)
    kstate.set(state, kstate.FPU_FEAT, (f1c << 32) | (f1d & 0xFFFFFFFF))
    if (f1d & F1_FXSR) == 0 || (f1d & F1_SSE) == 0 {
        kstate.set(state, kstate.FPU_MODE, MODE_OFF)
        return
    }
    var m: u64 = MODE_FX
    var want_xcr0: u64 = 0
    var sz: u64 = 512
    if (f1c & F1_XSAVE) != 0 && !want(state, M_NOXSAVE) && mx >= 13 {
        let sup_lo: u64 = cpuid_a(13, 0) & 0xFFFFFFFF
        var mask: u64 = XCR0_X87
        if (sup_lo & XCR0_SSE) != 0 {
            mask = mask | XCR0_SSE
        }
        if !want(state, M_NOAVX) {
            if (mask & XCR0_SSE) != 0 && (sup_lo & XCR0_AVX) != 0
            && (f1c & F1_AVX) != 0 {
                mask = mask | XCR0_AVX
            }
            if (mask & XCR0_AVX) != 0 && (sup_lo & XCR0_AVX512) == XCR0_AVX512
            && mx >= 7 {
                if (cpuid_b(7, 0) & F7_AVX512F) != 0 {
                    mask = mask | XCR0_AVX512
                }
            }
        }
        let need: u64 = cpuid_c(13, 0)
        if want(state, M_FPUFORCE) {
            mask = mask | XCR0_AVX | XCR0_AVX512
        }
        if need <= AREA_MAX && (mask & XCR0_SSE) != 0 {
            m = MODE_XSAVE
            want_xcr0 = mask
            sz = need
            if (cpuid_a(13, 1) & FD1_XSAVEOPT) != 0 {
                m = MODE_XSAVEOPT
            }
        }
    }
    kstate.set(state, kstate.FPU_MODE, m)
    kstate.set(state, kstate.FPU_XCR0, want_xcr0)
    kstate.set(state, kstate.FPU_SIZE, sz)
}

fn enable_here(state: u64) {
    var c0: u64 = cr0()
    c0 = c0 & ~CR0_EM
    c0 = c0 | CR0_MP
    c0 = c0 | CR0_NE
    c0 = c0 & ~CR0_TS
    cr0_set(c0)
    var c4: u64 = cr4()
    c4 = c4 | CR4_OSFXSR | CR4_OSXMMEXCPT
    let m: u64 = kstate.get(state, kstate.FPU_MODE)
    if m >= MODE_XSAVE {
        c4 = c4 | CR4_OSXSAVE
    }
    cr4_set(c4)
    if m >= MODE_XSAVE {
        xsetbv0(kstate.get(state, kstate.FPU_XCR0))
    }
}

fn apply(state: u64) {
    probe(state)
    if kstate.get(state, kstate.FPU_MODE) == MODE_OFF {
        return
    }
    enable_here(state)
    if kstate.get(state, kstate.FPU_MODE) >= MODE_XSAVE {
        let exact: u64 = cpuid_b(13, 0)
        if exact >= 576 && exact <= AREA_MAX {
            kstate.set(state, kstate.FPU_SIZE, exact)
        }
    }
    kstate.set(state, kstate.FPU_CR4, cr4())
}

fn apply_here(state: u64) {
    if kstate.get(state, kstate.FPU_MODE) == MODE_OFF {
        return
    }
    enable_here(state)
    var soll: u64 = CR4_OSFXSR | CR4_OSXMMEXCPT
    if kstate.get(state, kstate.FPU_MODE) >= MODE_XSAVE {
        soll = soll | CR4_OSXSAVE
    }
    if (cr4() & soll) == soll {
        kstate.add(state, kstate.FPU_APS, 1)
    }
}

fn enabled(state: u64) -> bool {
    return kstate.get(state, kstate.FPU_MODE) != MODE_OFF
}

fn lazy(state: u64) -> bool {
    return want(state, M_FPULAZY)
}

fn mode(state: u64) -> u64 {
    return kstate.get(state, kstate.FPU_MODE)
}

fn xcr0(state: u64) -> u64 {
    return kstate.get(state, kstate.FPU_XCR0)
}

fn area_size(state: u64) -> u64 {
    return kstate.get(state, kstate.FPU_SIZE)
}

fn area_init(state: u64, area: u64) {
    if area == 0 {
        return
    }
    var i: u64 = 0
    while i < AREA_MAX / 8 {
        __mmio_write64((area + i * 8) as *mut u64, 0)
        i = i + 1
    }
    __mmio_write64(area as *mut u64, INIT_FCW)
    __mmio_write64((area + 24) as *mut u64,
        INIT_MXCSR | (INIT_MXCSR_MASK << 32))
}

fn area_new(state: u64) -> u64 {
    if !enabled(state) {
        return 0
    }
    let a: u64 = mmframe.frame_alloc(state)
    if a == 0 {
        return 0
    }
    area_init(state, a)
    kstate.add(state, kstate.FPU_AREAS, 1)
    return a
}

fn area_free(state: u64, area: u64) {
    if area == 0 {
        return
    }
    mmframe.frame_free(state, area)
}

fn area_copy(state: u64, dst: u64, src: u64) {
    if dst == 0 || src == 0 {
        return
    }
    var i: u64 = 0
    while i < AREA_MAX / 8 {
        __mmio_write64((dst + i * 8) as *mut u64,
            __mmio_read64((src + i * 8) as *mut u64))
        i = i + 1
    }
}

fn save(state: u64, area: u64) {
    if area == 0 {
        return
    }
    let m: u64 = kstate.get(state, kstate.FPU_MODE)
    if m == MODE_FX {
        fxsave_to(area)
    } else {
        if m == MODE_XSAVEOPT {
            xsaveopt_to(area, kstate.get(state, kstate.FPU_XCR0))
        } else {
            if m == MODE_XSAVE {
                xsave_to(area, kstate.get(state, kstate.FPU_XCR0))
            }
        }
    }
    kstate.set(state, kstate.FPU_SAVES,
        kstate.get(state, kstate.FPU_SAVES) + 1)
}

fn restore(state: u64, area: u64) {
    if area == 0 {
        return
    }
    let m: u64 = kstate.get(state, kstate.FPU_MODE)
    if m == MODE_FX {
        fxrstor_from(area)
    } else {
        if m >= MODE_XSAVE {
            xrstor_from(area, kstate.get(state, kstate.FPU_XCR0))
        }
    }
    kstate.set(state, kstate.FPU_RESTORES,
        kstate.get(state, kstate.FPU_RESTORES) + 1)
}

fn switch(state: u64, me: u64, from_area: u64, to_area: u64) {
    if !enabled(state) {
        return
    }
    if want(state, M_NOFPUSWITCH) {
        return
    }
    if want(state, M_FPULAZY) {
        if from_area != 0 && cpu.get(state, me, cpu.C_FPUOWNER) == from_area {
            save(state, from_area)
        }
        cpu.set(state, me, cpu.C_FPUOWNER, 0)
        ts_set()
        return
    }
    save(state, from_area)
    restore(state, to_area)
    cpu.set(state, me, cpu.C_FPUOWNER, to_area)
}

fn sync_here(state: u64, area: u64) {
    if !enabled(state) || area == 0 {
        return
    }
    if cpu.get(state, cpu.here(state), cpu.C_FPUOWNER) == area {
        save(state, area)
    }
}

fn adopt_now(state: u64, area: u64) {
    if !enabled(state) || area == 0 {
        return
    }
    let me: u64 = cpu.here(state)
    if want(state, M_FPULAZY) {
        cpu.set(state, me, cpu.C_FPUOWNER, 0)
        ts_set()
        return
    }
    restore(state, area)
    cpu.set(state, me, cpu.C_FPUOWNER, area)
}

fn on_nm(state: u64, area: u64) -> bool {
    if !enabled(state) || !want(state, M_FPULAZY) {
        return false
    }
    clts()
    let me: u64 = cpu.here(state)
    let own: u64 = cpu.get(state, me, cpu.C_FPUOWNER)
    if own != 0 && own != area {
        save(state, own)
    }
    restore(state, area)
    cpu.set(state, me, cpu.C_FPUOWNER, area)
    kstate.set(state, kstate.FPU_NM, kstate.get(state, kstate.FPU_NM) + 1)
    return true
}

fn drop_owner(state: u64, area: u64) {
    if area == 0 {
        return
    }
    var i: u64 = 0
    while i < kstate.MAX_CPUS {
        if cpu.get(state, i, cpu.C_FPUOWNER) == area {
            cpu.set(state, i, cpu.C_FPUOWNER, 0)
        }
        i = i + 1
    }
}

fn report_cpu(state: u64) {
    var s_a: [u8; 11] = "fpu: f1c=\0\0"
    var s_b: [u8; 9] = "  f1d=\0\0\0"
    var s_c: [u8; 9] = "  f7b=\0\0\0"
    var s_d: [u8; 9] = "  sup=\0\0\0"
    var s_e: [u8; 10] = "  need=\0\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.hex(cpuid_c(1, 0))
    serial.puts((&s_b[0]) as u64)
    serial.hex(cpuid_d(1, 0))
    serial.puts((&s_c[0]) as u64)
    if max_leaf() >= 7 {
        serial.hex(cpuid_b(7, 0))
    } else {
        serial.hex(0)
    }
    serial.puts((&s_d[0]) as u64)
    if max_leaf() >= 13 {
        serial.hex(cpuid_a(13, 0))
    } else {
        serial.hex(0)
    }
    serial.puts((&s_e[0]) as u64)
    if max_leaf() >= 13 {
        serial.dec(cpuid_c(13, 0))
    } else {
        serial.dec(0)
    }
    serial.nl()
}

fn cpu_feat(state: u64) -> u64 {
    return kstate.get(state, kstate.FPU_FEAT)
}

fn report(state: u64) {
    var s_a: [u8; 11] = "fpu: mode=\0"
    var s_b: [u8; 8] = "  cr4=\0\0"
    var s_c: [u8; 9] = "  xcr0=\0\0"
    var s_d: [u8; 9] = "  size=\0\0"
    var s_e: [u8; 9] = "  lazy=\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(kstate.get(state, kstate.FPU_MODE))
    serial.puts((&s_b[0]) as u64)
    serial.hex(cr4())
    serial.puts((&s_c[0]) as u64)
    if kstate.get(state, kstate.FPU_MODE) >= MODE_XSAVE {
        serial.hex(xgetbv0())
    } else {
        serial.hex(0)
    }
    serial.puts((&s_d[0]) as u64)
    serial.dec(kstate.get(state, kstate.FPU_SIZE))
    serial.puts((&s_e[0]) as u64)
    serial.dec(numeric.yes(want(state, M_FPULAZY)))
    serial.nl()
    report_cpu(state)
}

fn report_aps(state: u64) {
    var s_a: [u8; 10] = "fpu: aps=\0"
    var s_b: [u8; 10] = "  saves=\0\0"
    var s_c: [u8; 13] = "  restores=\0\0"
    var s_d: [u8; 8] = "  nm=\0\0\0"
    var s_e: [u8; 10] = "  areas=\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(kstate.get(state, kstate.FPU_APS))
    serial.puts((&s_b[0]) as u64)
    serial.dec(kstate.get(state, kstate.FPU_SAVES))
    serial.puts((&s_c[0]) as u64)
    serial.dec(kstate.get(state, kstate.FPU_RESTORES))
    serial.puts((&s_d[0]) as u64)
    serial.dec(kstate.get(state, kstate.FPU_NM))
    serial.puts((&s_e[0]) as u64)
    serial.dec(kstate.get(state, kstate.FPU_AREAS))
    serial.nl()
}

fn find(heu: u64, nadel: u64, n: u64) -> u64 {
    if heu == 0 || n == 0 {
        return 0
    }
    var i: u64 = 0
    while true {
        let c: u64 = kstate.get8(heu + i)
        if c == 0 {
            return 0
        }
        var k: u64 = 0
        var same: bool = true
        while k < n {
            let a: u64 = kstate.get8(heu + i + k)
            if a == 0 || a != kstate.get8(nadel + k) {
                same = false
                k = n
            } else {
                k = k + 1
            }
        }
        if same {
            return heu + i
        }
        i = i + 1
    }
    return 0
}

const PROBE_REGS: u64 = 16
const PROBE_LANES: u64 = 2
const PROBE_WORDS: u64 = 32
const PROBE_BYTES: u64 = 256

fn vec_put(p: u64) {
    asm("movdqu xmm0,[rdi]\nmovdqu xmm1,[rdi+16]\nmovdqu xmm2,[rdi+32]\nmovdqu xmm3,[rdi+48]\nmovdqu xmm4,[rdi+64]\nmovdqu xmm5,[rdi+80]\nmovdqu xmm6,[rdi+96]\nmovdqu xmm7,[rdi+112]\nmovdqu xmm8,[rdi+128]\nmovdqu xmm9,[rdi+144]\nmovdqu xmm10,[rdi+160]\nmovdqu xmm11,[rdi+176]\nmovdqu xmm12,[rdi+192]\nmovdqu xmm13,[rdi+208]\nmovdqu xmm14,[rdi+224]\nmovdqu xmm15,[rdi+240]",
        in("rdi") p, clobber("memory"))
}

fn vec_take(p: u64) {
    asm("movdqu [rdi],xmm0\nmovdqu [rdi+16],xmm1\nmovdqu [rdi+32],xmm2\nmovdqu [rdi+48],xmm3\nmovdqu [rdi+64],xmm4\nmovdqu [rdi+80],xmm5\nmovdqu [rdi+96],xmm6\nmovdqu [rdi+112],xmm7\nmovdqu [rdi+128],xmm8\nmovdqu [rdi+144],xmm9\nmovdqu [rdi+160],xmm10\nmovdqu [rdi+176],xmm11\nmovdqu [rdi+192],xmm12\nmovdqu [rdi+208],xmm13\nmovdqu [rdi+224],xmm14\nmovdqu [rdi+240],xmm15",
        in("rdi") p, clobber("memory"))
}

fn vec_calc() {
    asm("paddq xmm0,xmm1\npaddq xmm1,xmm2\npaddq xmm2,xmm3\npaddq xmm3,xmm4\npaddq xmm4,xmm5\npaddq xmm5,xmm6\npaddq xmm6,xmm7\npaddq xmm7,xmm8\npaddq xmm8,xmm9\npaddq xmm9,xmm10\npaddq xmm10,xmm11\npaddq xmm11,xmm12\npaddq xmm12,xmm13\npaddq xmm13,xmm14\npaddq xmm14,xmm15")
}

fn vec_seed(p: u64, seed: u64) {
    var k: u64 = 0
    while k < PROBE_WORDS {
        __mmio_write64((p + k * 8) as *mut u64,
            (seed << 56) | (seed << 40) | (seed << 24) | (k << 8) | 0xA5)
        k = k + 1
    }
}

fn vec_ref(p: u64) {
    var n: u64 = 0
    while n + 1 < PROBE_REGS {
        var l: u64 = 0
        while l < PROBE_LANES {
            let a: u64 = __mmio_read64((p + (n * PROBE_LANES + l) * 8) as *mut u64)
            let b: u64 = __mmio_read64(
                (p + ((n + 1) * PROBE_LANES + l) * 8) as *mut u64)
            __mmio_write64((p + (n * PROBE_LANES + l) * 8) as *mut u64, a +% b)
            l = l + 1
        }
        n = n + 1
    }
}

fn vec_diff(a: u64, b: u64) -> u64 {
    var k: u64 = 0
    var bad: u64 = 0
    while k < PROBE_WORDS {
        if __mmio_read64((a + k * 8) as *mut u64)
        != __mmio_read64((b + k * 8) as *mut u64) {
            bad = bad + 1
        }
        k = k + 1
    }
    return bad
}
