
import lib.kstate
import serial
import mm.mmframe
import user
import libc.numeric

export {
    parse, apply, apply_here, stac, clac,
    smep_on, smap_on, windows, report, report_aps, aps, want, cr4,
    M_NOSMEP, M_NOSMAP, M_RAWREAD, M_RAWEXEC,
    raw_read, raw_exec
}

const CR4_SMEP: u64 = 0x100000
const CR4_SMAP: u64 = 0x200000

const F7_SMEP: u64 = 0x80
const F7_SMAP: u64 = 0x100000

const M_NOSMEP: u64 = 1
const M_NOSMAP: u64 = 2
const M_RAWREAD: u64 = 4
const M_RAWEXEC: u64 = 8

fn parse(state: u64, cmd: u64) {
    var w_nosmep: [u8; 7] = "nosmep\0"
    var w_nosmap: [u8; 7] = "nosmap\0"
    var w_rawr: [u8; 8] = "smapraw\0"
    var w_rawx: [u8; 8] = "smepraw\0"
    var m: u64 = 0
    if cmd != 0 {
        if find(cmd, (&w_nosmep[0]) as u64, 6) != 0 {
            m = m | M_NOSMEP
        }
        if find(cmd, (&w_nosmap[0]) as u64, 6) != 0 {
            m = m | M_NOSMAP
        }
        if find(cmd, (&w_rawr[0]) as u64, 7) != 0 {
            m = m | M_RAWREAD
        }
        if find(cmd, (&w_rawx[0]) as u64, 7) != 0 {
            m = m | M_RAWEXEC
        }
    }
    kstate.set(state, kstate.GUARD_MODE, m)
    kstate.set(state, kstate.SMEP_OK, 0)
    kstate.set(state, kstate.SMAP_OK, 0)
    kstate.set(state, kstate.SMAP_WINDOWS, 0)
}

fn want(state: u64, bit: u64) -> bool {
    return (kstate.get(state, kstate.GUARD_MODE) & bit) != 0
}

fn leaf7_ebx() -> u64 {
    var b: u64 = 0
    asm("push rbx\nmov eax, 7\nxor ecx, ecx\ncpuid\nmov rax, rbx\npop rbx",
        out("rax") & b, clobber("rcx"), clobber("rdx"))
    return b
}

fn cpu_has_smep() -> bool {
    return (leaf7_ebx() & F7_SMEP) != 0
}

fn cpu_has_smap() -> bool {
    return (leaf7_ebx() & F7_SMAP) != 0
}

fn cr4() -> u64 {
    return asm("mov rax, cr4", out("rax"))
}

fn cr4_set(v: u64) {
    asm("mov cr4, rax", in("rax") v)
}

fn apply(state: u64) {
    var v: u64 = cr4()
    var smep: u64 = 0
    var smap: u64 = 0
    if !want(state, M_NOSMEP) {
        if cpu_has_smep() {
            v = v | CR4_SMEP
            smep = 1
        }
    }
    if !want(state, M_NOSMAP) {
        if cpu_has_smap() {
            v = v | CR4_SMAP
            smap = 1
        }
    }
    cr4_set(v)
    kstate.set(state, kstate.SMEP_OK, smep)
    kstate.set(state, kstate.SMAP_OK, smap)
}

fn apply_here(state: u64) {
    var v: u64 = cr4()
    var soll: u64 = 0
    if kstate.get(state, kstate.SMEP_OK) != 0 {
        v = v | CR4_SMEP
        soll = soll | CR4_SMEP
    }
    if kstate.get(state, kstate.SMAP_OK) != 0 {
        v = v | CR4_SMAP
        soll = soll | CR4_SMAP
    }
    cr4_set(v)
    if (cr4() & soll) == soll {
        kstate.add(state, kstate.GUARD_APS, 1)
    }
}

fn smep_on(state: u64) -> bool {
    return kstate.get(state, kstate.SMEP_OK) != 0
}

fn smap_on(state: u64) -> bool {
    return kstate.get(state, kstate.SMAP_OK) != 0
}

fn windows(state: u64) -> u64 {
    return kstate.get(state, kstate.SMAP_WINDOWS)
}

fn stac(state: u64) {
    if kstate.get(state, kstate.SMAP_OK) != 0 {
        asm("stac")
        kstate.set(state, kstate.SMAP_WINDOWS,
            kstate.get(state, kstate.SMAP_WINDOWS) + 1)
    }
}

fn clac(state: u64) {
    if kstate.get(state, kstate.SMAP_OK) != 0 {
        asm("clac")
    }
}

fn open_page(state: u64, fuellung: u64) -> u64 {
    let f: u64 = mmframe.frame_alloc(state)
    if f == 0 {
        return 0
    }
    kstate.set8(f, fuellung as u8)
    let t: u64 = mmframe.frame_alloc(state)
    if t == 0 {
        return 0
    }
    if !user.map_user_pt(state, f, true, t) {
        return 0
    }
    return f
}

fn raw_read(state: u64) {
    var s_try: [u8; 18] = "smap: raw read @ \0"
    var s_got: [u8; 7] = "  got=\0"
    var s_no: [u8; 24] = "smap: raw read no page\0\0"
    if !want(state, M_RAWREAD) {
        return
    }
    let a: u64 = open_page(state, 0x5A)
    if a == 0 {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_try[0]) as u64)
    serial.hex(a)
    serial.nl()
    let v: u64 = kstate.get8(a)
    serial.puts((&s_got[0]) as u64)
    serial.hex(v)
    serial.nl()
}

fn raw_exec(state: u64) {
    var s_try: [u8; 18] = "smep: raw call @ \0"
    var s_back: [u8; 21] = "smep: came back (!)\0\0"
    var s_no: [u8; 24] = "smep: raw call no page\0\0"
    if !want(state, M_RAWEXEC) {
        return
    }
    let a: u64 = open_page(state, 0xC3)
    if a == 0 {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_try[0]) as u64)
    serial.hex(a)
    serial.nl()
    asm("call rax", in("rax") a, clobber("memory"))
    serial.puts((&s_back[0]) as u64)
    serial.nl()
}

fn report(state: u64) {
    var s_a: [u8; 12] = "guard: cr4=\0"
    var s_b: [u8; 8] = "  smep=\0"
    var s_c: [u8; 8] = "  smap=\0"
    var s_d: [u8; 8] = "  cpu=\0\0"
    var s_e: [u8; 2] = "/\0"
    serial.puts((&s_a[0]) as u64)
    serial.hex(cr4())
    serial.puts((&s_b[0]) as u64)
    serial.dec(kstate.get(state, kstate.SMEP_OK))
    serial.puts((&s_c[0]) as u64)
    serial.dec(kstate.get(state, kstate.SMAP_OK))
    serial.puts((&s_d[0]) as u64)
    serial.dec(numeric.yes(cpu_has_smep()))
    serial.puts((&s_e[0]) as u64)
    serial.dec(numeric.yes(cpu_has_smap()))
    serial.nl()
}

fn report_aps(state: u64) {
    var s_a: [u8; 12] = "guard: aps=\0"
    var s_b: [u8; 12] = "  windows=\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(kstate.get(state, kstate.GUARD_APS))
    serial.puts((&s_b[0]) as u64)
    serial.dec(kstate.get(state, kstate.SMAP_WINDOWS))
    serial.nl()
}

fn aps(state: u64) -> u64 {
    return kstate.get(state, kstate.GUARD_APS)
}

fn find(heu: u64, nadel: u64, n: u64) -> u64 {
    if heu == 0 || n == 0 {
        return 0
    }
    var i: u64 = 0
    while true {
        let c: u64 = kstate.get8(heu + i)
        if c == 0 {
            return 0
        }
        var k: u64 = 0
        var same: bool = true
        while k < n {
            let a: u64 = kstate.get8(heu + i + k)
            if a == 0 || a != kstate.get8(nadel + k) {
                same = false
                k = n
            } else {
                k = k + 1
            }
        }
        if same {
            return heu + i
        }
        i = i + 1
    }
    return 0
}
