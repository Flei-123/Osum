import lib.kstate
import sched.taskconst
import sched.taskslot
import sync.atomic

export { mirror, owner_added, owner_removed }

static mut owners: [u64; 1] = [0]

fn owner_added() {
    atomic.fetch_add((&owners[0]) as u64, 1)
}

fn owner_removed() {
    atomic.fetch_sub((&owners[0]) as u64, 1)
}

fn mirror(state: u64, idx: u64, entry: u64) {
    if atomic.load((&owners[0]) as u64) == 0 {
        return
    }
    var t: u64 = 1
    while t < kstate.MAX_TASKS {
        let low: u64 = taskslot.tget(state, t, taskconst.T_LOWPD)
        if low != 0 {
            __mmio_write64((low + idx * 8) as *mut u64, entry)
        }
        t = t + 1
    }
}
