
import serial
import lib.kstate
import mm.mmframe

export { setup, setup_here, gs_set, gs_base, run, handle,
    map_user, map_user_pt, unmap_user }

const MSR_EFER: u64 = 0xC0000080
const MSR_STAR: u64 = 0xC0000081
const MSR_LSTAR: u64 = 0xC0000082
const MSR_SFMASK: u64 = 0xC0000084
const MSR_GS_BASE: u64 = 0xC0000101

const V_SYSCALL: u64 = 48
const V_USER: u64 = 49
const V_ENTER: u64 = 50
const V_LEAVE: u64 = 51

const PAGE_PRESENT: u64 = 1
const PAGE_WRITE: u64 = 2
const PAGE_USER: u64 = 4
const PAGE_HUGE: u64 = 0x80
const ADDR_MASK: u64 = 0x000FFFFFFFFFF000

fn not(v: u64) -> u64 {
    return ~v
}

fn vector(state: u64, i: u64) -> u64 {
    return __mmio_read64((kstate.get(state, kstate.VECTORS) + i * 8) as *mut u64)
}

fn wrmsr(index: u64, value: u64) {
    asm("wrmsr", in("rcx") index, in("rax") value & 0xFFFFFFFF,
        in("rdx") value >> 32)
}

fn rdmsr(index: u64) -> u64 {
    var lo: u64 = 0
    var hi: u64 = 0
    asm("rdmsr", in("rcx") index, out("rax") & lo, out("rdx") & hi)
    return (hi << 32) | (lo & 0xFFFFFFFF)
}

fn cpu_has_nx() -> bool {
    var d: u64 = 0
    asm("push rbx\ncpuid\npop rbx", in("rax") 0x80000001, out("rdx") & d,
        clobber("rcx"), clobber("memory"))
    return (d & 0x100000) != 0
}

fn setup_here(state: u64, cpubase: u64) {
    wrmsr(MSR_STAR, (0x1B << 48) | (0x08 << 32))
    wrmsr(MSR_LSTAR, vector(state, V_SYSCALL))
    wrmsr(MSR_SFMASK, 0x200)
    var efer: u64 = rdmsr(MSR_EFER) | 1
    if cpu_has_nx() {
        efer = efer | 0x800
        kstate.set(state, kstate.NX_OK, 1)
    } else {
        kstate.set(state, kstate.NX_OK, 0)
    }
    wrmsr(MSR_EFER, efer)
    gs_set(cpubase)
}

fn setup(state: u64) {
    setup_here(state, state + kstate.CPU_OFF)
}

fn gs_set(cpubase: u64) {
    wrmsr(MSR_GS_BASE, cpubase)
}

fn gs_base() -> u64 {
    return rdmsr(MSR_GS_BASE)
}

fn map_user(state: u64, addr: u64, writable: bool, slot: u64) -> bool {
    return map_user_pt(state, addr, writable,
        state + kstate.PT_OFF + slot * 4096)
}

fn map_user_pt(state: u64, addr: u64, writable: bool, table: u64) -> bool {
    let cr3: u64 = asm("mov rax, cr3", out("rax")) & ADDR_MASK
    let i4: u64 = (addr >> 39) & 0x1FF
    let i3: u64 = (addr >> 30) & 0x1FF
    let i2: u64 = (addr >> 21) & 0x1FF
    let i1: u64 = (addr >> 12) & 0x1FF

    let e4: u64 = __mmio_read64((cr3 + i4 * 8) as *mut u64)
    __mmio_write64((cr3 + i4 * 8) as *mut u64, e4 | PAGE_USER)
    let pdpt: u64 = e4 & ADDR_MASK
    let e3: u64 = __mmio_read64((pdpt + i3 * 8) as *mut u64)
    __mmio_write64((pdpt + i3 * 8) as *mut u64, e3 | PAGE_USER)
    let pd: u64 = e3 & ADDR_MASK

    let e2: u64 = __mmio_read64((pd + i2 * 8) as *mut u64)
    var pt: u64 = 0
    if (e2 & PAGE_HUGE) != 0 {
        pt = table
        let base: u64 = e2 & not(0x1FFFFF)
        var i: u64 = 0
        while i < 512 {
            __mmio_write64((pt + i * 8) as *mut u64,
                (base + i * 4096) | PAGE_PRESENT | PAGE_WRITE)
            i = i + 1
        }
        var flags2: u64 = PAGE_PRESENT | PAGE_WRITE | PAGE_USER
        __mmio_write64((pd + i2 * 8) as *mut u64, pt | flags2)
    } else {
        pt = e2 & ADDR_MASK
    }
    if pt == 0 {
        return false
    }
    var flags: u64 = PAGE_PRESENT | PAGE_USER
    if writable {
        flags = flags | PAGE_WRITE
    }
    let old: u64 = __mmio_read64((pt + i1 * 8) as *mut u64)
    __mmio_write64((pt + i1 * 8) as *mut u64, (old & ADDR_MASK) | flags)
    asm("mov rax, cr3\nmov cr3, rax", out("rax"))
    return true
}

fn unmap_user(state: u64, addr: u64) {
    let cr3: u64 = asm("mov rax, cr3", out("rax")) & ADDR_MASK
    let i4: u64 = (addr >> 39) & 0x1FF
    let i3: u64 = (addr >> 30) & 0x1FF
    let i2: u64 = (addr >> 21) & 0x1FF
    let i1: u64 = (addr >> 12) & 0x1FF
    let e4: u64 = __mmio_read64((cr3 + i4 * 8) as *mut u64)
    if (e4 & PAGE_PRESENT) == 0 {
        return
    }
    let pdpt: u64 = e4 & ADDR_MASK
    let e3: u64 = __mmio_read64((pdpt + i3 * 8) as *mut u64)
    if (e3 & PAGE_PRESENT) == 0 {
        return
    }
    let pd: u64 = e3 & ADDR_MASK
    let e2: u64 = __mmio_read64((pd + i2 * 8) as *mut u64)
    if (e2 & PAGE_PRESENT) == 0 {
        return
    }
    if (e2 & PAGE_HUGE) != 0 {
        return
    }
    let pt: u64 = e2 & ADDR_MASK
    if pt == 0 {
        return
    }
    let old: u64 = __mmio_read64((pt + i1 * 8) as *mut u64)
    __mmio_write64((pt + i1 * 8) as *mut u64, old & not(PAGE_USER))
    asm("mov rax, cr3\nmov cr3, rax", out("rax"))
}

fn handle(number: u64, arg: u64, state: u64) -> u64 {
    var s_call: [u8; 22] = "ring3: syscall 1 arg \0"
    var s_exit: [u8; 26] = "ring3: syscall 2, back to\0"
    var s_ring0: [u8; 8] = " ring 0\0"
    if number == 1 {
        serial.puts((&s_call[0]) as u64)
        serial.dec(arg)
        serial.nl()
        if kstate.mode_on(state, kstate.M_R3FAULT) {
            return 1
        }
        return 0
    }
    if number == 2 {
        serial.puts((&s_exit[0]) as u64)
        serial.puts((&s_ring0[0]) as u64)
        serial.nl()
        asm("call rax", in("rax") vector(state, V_LEAVE), clobber("memory"))
    }
    return 0xFFFFFFFFFFFFFFFF
}

fn run(state: u64) -> bool {
    var s_go: [u8; 24] = "ring3: entering at rip=\0"
    var s_stack: [u8; 9] = "  stack=\0"
    var s_back: [u8; 25] = "ring3: back in ring 0\0\0\0\0"
    var s_fail: [u8; 26] = "ring3: no page for ring 3\0"
    setup(state)
    let rip: u64 = vector(state, V_USER)
    let stack: u64 = mmframe.frame_alloc(state)
    if stack == 0 {
        return false
    }
    if !map_user(state, rip, false, 0) {
        serial.puts((&s_fail[0]) as u64)
        return false
    }
    if !map_user(state, stack, true, 1) {
        serial.puts((&s_fail[0]) as u64)
        return false
    }
    serial.puts((&s_go[0]) as u64)
    serial.hex(rip)
    serial.puts((&s_stack[0]) as u64)
    serial.hex(stack)
    serial.nl()
    kstate.set(state, kstate.EXCURSION, 1)
    let flags: u64 = asm("pushfq\npop rax", out("rax"))
    asm("call rax", in("rax") vector(state, V_ENTER), in("rdi") rip,
        in("rsi") stack + 4096 - 16, clobber("memory"))
    if (flags & 0x200) != 0 {
        asm("sti")
    }
    kstate.set(state, kstate.EXCURSION, 0)
    serial.puts((&s_back[0]) as u64)
    serial.nl()
    unmap_user(state, stack)
    mmframe.frame_free(state, stack)
    return true
}
