// SPDX-License-Identifier: GPL-2.0-only
// kernel/hv.fi -- Runde K12: ein Wirt fuer fremde Betriebssysteme.
//
// WARUM DIESER WEG UND KEIN ANDERER. Wer fremde Systeme laufen lassen
// will, hat zwei Moeglichkeiten. Die eine ist, ihre Schnittstellen
// nachzubauen -- Linux-Systemaufrufe, Linux-Geraete, Linux-Dateisystem.
// Das ist eine Arbeit ohne Ende: es gibt ueber dreihundert Aufrufe, sie
// aendern sich, und jedes Programm, das einen benutzt, den man nicht
// nachgebaut hat, geht nicht. Die andere ist, den PROZESSOR zu
// virtualisieren. Diese Aufgabe ist endlich, sie steht vollstaendig in
// den Handbuechern von Intel und AMD, und wenn sie stimmt, stimmt sie
// fuer JEDES Gastsystem -- weil ein Gastsystem nichts anderes sieht als
// einen Prozessor.
//
// AMD-V UND NICHT INTEL VT-x, UND WARUM. Der Auftrag sagt "Intel zuerst".
// Das geht hier nicht, und das ist gemessen und nicht vermutet:
//
//   qemu-system-x86_64 -accel tcg -cpu qemu64,+vmx
//     -> "warning: TCG doesn't support requested feature: CPUID.01H:ECX.vmx"
//
// QEMUs Softwareemulation kann VMX NICHT. Sie kann SVM. Der Rechner, auf
// dem dieses Projekt gemessen wird, hat keinen /dev/kvm und ist ein AMD
// EPYC -- es gibt also weder eine Beschleunigung noch einen Intel-Kern,
// gegen den sich etwas messen liesse. Ein VMX-Wirt waere in dieser
// Umgebung NICHT MESSBAR, und dieses Projekt misst. Also AMD-V. Was hier
// steht, ist der Sache nach dasselbe: Steuerblock, Gastzustand,
// Abfangbits, Eintritt, Austritt, Austrittsgrund -- nur die Namen und
// die Zahlen sind andere.
//
// WAS DIE MASCHINE HIER KANN, UND WAS NICHT. Gemessen mit einem eigenen
// Pruefling (CPUID 0x8000000A):
//
//   nested paging     JA    (mit -cpu max, EPYC, Opteron_G5)
//   nrip save         NEIN  -> der Wirt muss RIP SELBST weiterruecken
//   decode assists    NEIN  -> bei Steuerregistern muss der Wirt den
//                             Befehl selbst aus dem Gastspeicher holen
//   vmcb clean bits   NEIN  -> jeder Eintritt laedt alles neu
//   flush by asid     NEIN  -> beim Eintritt wird alles verworfen
//
// UND EINE FALLE, DIE EINE HALBE STUNDE GEKOSTET HAT. Verschachtelte
// Seitentabellen haengen QEMU auf, wenn der WIRT kein Paging hat. Der
// Grund steht in QEMUs Quelltext (v7.2, target/i386/tcg/sysemu/
// svm_helper.c, Zeile 284):
//
//   env->nested_pg_mode = get_pg_mode(env) & PG_MODE_SVM_MASK;
//
// Diese Zeile steht VOR dem Laden des Gastzustands, liest also CR0/CR4/
// EFER DES WIRTS, und `get_pg_mode` gibt bei CR0.PG = 0 sofort 0 zurueck.
// Eine vierstufige Tabelle wird dann als zweistufige gelesen, und der
// Seitenlauf dreht sich im Kreis. Osum laeuft im langen Modus mit
// Paging; deshalb traegt es hier. Ein Wirt im geschuetzten Modus koennte
// es nicht -- und das steht hier, damit es niemand noch einmal sucht.
//
// WO DER ZUSTAND LIEGT. Wie ueberall in diesem Kernel: in der
// uebergebenen Datenregion, denn Stufe 0 von Firn hat keine globalen
// veraenderlichen Variablen. EINE Seite (`HV_OFF`) traegt die Skalare,
// die Zaehler je Austrittsgrund, die Werte, die Gaeste gemeldet haben,
// die Maschinenverzeichnisse und die Registerbloecke. Alles Grosse --
// Steuerbloecke, Seitentabellen, Bitkarten, der Speicher der Gaeste --
// kommt aus dem RAHMENVERWALTER und nicht aus `kdata`: eine Gastmaschine
// ist so gross, wie ihr Gast Speicher braucht, und das gehoert nicht in
// eine feste Seite.
//
// ARITHMETIK. Steuerblockfelder, Abfangbits, physische Adressen und
// Seitentabelleneintraege sind BITMUSTER. Dort steht `+%`, `-%`, `*%`.
// Die gepruefte Arithmetik (Runde 72) bleibt den Zaehlern -- da ist ein
// Ueberlauf wirklich ein Fehler.

import serial
import lib.kstate
import mm.mem
import arch.msr
import vmcb
import vdev
// RUNDE HV3: der Ladeweg (Stufe 4) und der Entzifferer mit
// Gast-Paging (Stufe 5). Beide stehen in eigenen Dateien, weil sie
// eigene Sachen sind -- ein Ladeweg ist keine Eigenschaft eines Wirts,
// und ein Seitenlauf ist keine Eigenschaft eines Ladewegs.
import bzload
import gwalk
import ipc.cap
import sched.sched

export {
    parse, stage, mode_of, on,
    HV_OFF, HV_MAX, VDEV_OFF, VDEV_MAX,
    M_HV, M_LOOP, M_NOSVM, M_NONPT, M_CR, M_MESS, M_FREE, M_LM, M_NOLME,
    M_DEV, M_LINUX, M_ZP, M_NOE820, M_SPUR,
    ready, rev, nasid, feat,
    vm_create, vm_create_big, vm_run, vm_destroy, vm_free_all,
    vm_big, vm_pages,
    vm_state, vm_result, vm_exits, vm_guest, vm_owner, vm_valid,
    exits_total, exits_bucket, runs, cycles_run, cycles_exit, eferw,
    npfs, killed, calls, injected, guest_out, ioports, msrs, crs,
    value_of, value_seen, vms_made,
    G_HELLO, G_PM, G_LOOP, G_FAULT, G_CRASH, G_BENCH, G_LM, G_DEV,
    G_LINUX, G_MAX,
    ST_FREE, ST_READY, ST_HALT, ST_DONE, ST_DEAD,
    R_MORE, R_HALT, R_DONE, R_SHUTDOWN, R_EXC, R_BUDGET, R_ERR, R_FAULT,
    B_CRRD, B_CRWR, B_EXC, B_INTR, B_CPUID, B_HLT, B_IOIO, B_MSR,
    B_SHUTDOWN, B_VMMCALL, B_NPF, B_ERR, B_OTHER, B_COUNT,
    MAX_VMS, GUEST_PAGES
}

// ----------------------------------------------------------- der Bereich
//
// EINE Seite in `kdata`. Sie liegt bei 0x40000, und das ist die erste
// Seite HINTER allem, was es bis zu dieser Runde gab: 0x3C000 gehoert
// dem Rahmenpuffer (`fb.fi`, Runde K7B), und die Runde K10, die neben
// dieser hier laeuft, hat 0x3D000 bis 0x40000 belegt. `kdata` war damit
// randvoll -- deshalb waechst KDATA_SIZE in dieser Runde von 0x40000 auf
// 0x50000 (`kernel/boot.s` und `kstate.fi`), und `tools/kernel/memmap.py`
// rechnet nach, dass sich nichts ueberschneidet.
const HV_OFF: u64 = 0x40000
const HV_MAX: u64 = 4096
// RUNDE HV2, STUFE 3: die Geraete brauchen eine eigene Seite. Acht
// Maschinen zu je 128 Oktetten Geraetezustand sind 1024 Oktette; sie
// haetten in die Seite oben nicht mehr gepasst (die ist bis 0xD80
// belegt).
//
// UND SIE LIEGT NICHT DA, WO DER BERICHT DER RUNDE K12 ES ERWARTEN
// LIESS. Dort steht, 0x41000 bis 0x50000 sei frei. Das stimmte im
// Augenblick jener Runde und stimmt heute nicht mehr: seither haben
// K13, K14, WIG, K16, MODE, EHCI, K17, K18, OFS3, DISP und JRNL den
// ganzen Bereich bis 0x60000 belegt. `tools/kernel/memmap.py` hat die
// Kollision beim ersten Lauf gemeldet, statt sie durchgehen zu lassen
// -- genau dafuer gibt es den Kartenpruefer, und er hat in dieser
// Runde dreimal hintereinander angeschlagen (0x41000 K13, 0x84000
// HNON/HCNT, 0x88000 TASK). Die letzten 16 KiB von `kdata` sind der
// einzige zusammenhaengende freie Block, der uebrig ist: 0x13C000.
// `kdata` ist damit bis auf Reste voll -- wer nach dieser Runde eine
// Seite braucht, muss KDATA_SIZE wachsen lassen.
const VDEV_OFF: u64 = 0x13C000
const VDEV_MAX: u64 = 4096

// Die Skalare, 0x000..0x0FF.
const S_MODE: u64 = 0x000 // die Woerter der Kommandozeile
const S_READY: u64 = 0x008 // 1 = SVM steht
const S_HSAVE: u64 = 0x010 // VM_HSAVE_PA: was VMRUN selbst rettet
const S_HOSTVMCB: u64 = 0x018 // was `vmsave`/`vmload` rettet
const S_IOPM: u64 = 0x020 // Bitkarte der Anschluesse, drei Seiten
const S_MSRPM: u64 = 0x028 // Bitkarte der MSRs, zwei Seiten
const S_REV: u64 = 0x030 // CPUID 0x8000000A eax
const S_NASID: u64 = 0x038 // ebx: wie viele Adressraumkennungen
const S_FEAT: u64 = 0x040 // edx: nested paging, nrip save, ...
const S_VMS: u64 = 0x048 // angelegte Maschinen
const S_RUNS: u64 = 0x050 // ausgefuehrte VMRUN
const S_EXITS: u64 = 0x058 // Austritte insgesamt
const S_CYC_RUN: u64 = 0x060 // Zyklen IM Gast
const S_CYC_EXIT: u64 = 0x068 // Zyklen in der Behandlung
const S_NPFS: u64 = 0x070 // Seiten auf Zuruf
const S_KILLED: u64 = 0x078 // abgeraeumte Maschinen
const S_CALLS: u64 = 0x080 // Hypercalls
const S_OUT: u64 = 0x088 // Oktette, die ein Gast ausgegeben hat
const S_INJ: u64 = 0x090 // eingeworfene Ereignisse
const S_ASID: u64 = 0x098 // naechste Adressraumkennung
const S_IOPORTS: u64 = 0x0A0
const S_MSRS: u64 = 0x0A8
const S_CRS: u64 = 0x0B0
const S_DECFAIL: u64 = 0x0B8 // Befehle, die der Wirt nicht lesen konnte
const S_LASTERR: u64 = 0x0C0
// RUNDE HV2: wie oft der Wirt ein Schreiben auf EFER wirklich
// uebernommen hat. Die GEGENPROBE `ohnelme` laesst diese Zahl auf 0.
const S_EFERW: u64 = 0x0C8
const S_LASTNPF: u64 = 0x0D0 // die Adresse, an der ein NPF nicht half
const S_VALMASK: u64 = 0x0D8 // welche der 64 Werte ein Gast gemeldet hat
// RUNDE HV3: MSR-Schreiben, die der Wirt WIRKLICH in den Steuerblock
// uebernommen hat (GS/FS/KernelGS, STAR/LSTAR/CSTAR/SFMASK) -- und die,
// die er weiter schluckt. Stirbt ein Gast an einem fehlenden MSR, sagt
// `msrign` sofort, dass hier zu suchen ist.
const S_MSRW: u64 = 0x0E0
const S_MSRIGN: u64 = 0x0E8

// Die Zaehler je Austrittsgrund, 0x100..0x1FF.
const CNT_OFF: u64 = 0x100
const B_CRRD: u64 = 0
const B_CRWR: u64 = 1
const B_EXC: u64 = 2
const B_INTR: u64 = 3
const B_CPUID: u64 = 4
const B_HLT: u64 = 5
const B_IOIO: u64 = 6
const B_MSR: u64 = 7
const B_SHUTDOWN: u64 = 8
const B_VMMCALL: u64 = 9
const B_NPF: u64 = 10
const B_ERR: u64 = 11
const B_OTHER: u64 = 12
const B_COUNT: u64 = 13

// Was Gaeste gemeldet haben, 0x200..0x2FF, plus eine Maske bei 0x300.
// RUNDE HV2: DER BRIEFKASTEN WAR ZU KLEIN, und das hat diese Stufe
// eine Stunde gekostet. Die Gaeste der Runde K12 melden die Nummern 1
// bis 9 und 31; der Gast im langen Modus nimmt 10 bis 14, der
// Geraetegast 40 bis 45. `value_put` warf alles ab 32 STILL weg --
// die Geraete lieferten die richtigen Werte (im Protokoll nachgesehen:
// 0x5A, 0x60, 0x0C, 0xFD), und die Zusagen darueber blieben trotzdem
// rot, weil die Zahlen nie ankamen.
//
// 64 Werte statt 32. Die Werte fuellen damit 0x200..0x3FF genau aus,
// und die Maske kann NICHT mehr hinter ihnen liegen -- sie zieht
// deshalb zu den Skalaren (S_VALMASK). Ein Wort fasst genau 64 Bits;
// mehr Werte gingen nicht ohne ein zweites.
const VAL_OFF: u64 = 0x200
const VAL_MAX: u64 = 64

// Die Maschinenverzeichnisse, 0x400..0x7FF.
const VM_OFF: u64 = 0x400
// RUNDE HV2: von 128 auf 192 gewachsen. Die Felder V_RUNBASE, V_RUNLEN
// und V_BIG kamen dazu, und 0x88 passt nicht mehr in 128 Oktette.
//
// ACHT MASCHINEN ZU 192 SIND 1536 OKTETTE, also 0x400..0x9FF -- der
// Bereich der Registerbloecke lag bei 0x800 und waere damit UEBERSCHRIEBEN
// worden. Das ist kein Fehler, den man sieht: die Maschine 5 haette
// dann die Register der Maschine 0 als ihren Zustand gelesen. Deshalb
// ruecken die Registerbloecke auf 0xA00 (siehe GPR_OFF), und die Karte
// darunter rechnet nach, dass beides in die Seite passt.
const VM_BYTES: u64 = 192
const MAX_VMS: u64 = 8

// Die Registerbloecke, 0x800..0xB7F. Vierzehn Woerter je Maschine --
// alles, was der Prozessor beim Weltwechsel NICHT selbst rettet.
// RUNDE HV2: von 0x800 auf 0xA00 gerueckt, weil die Maschinen laenger
// wurden (VM_BYTES 128 -> 192, also 0x400..0x9FF statt 0x400..0x7FF).
// 0xA00 + 8 * 112 = 0xD80, und HV_MAX ist 4096 -- es passt, und die
// Zusage `der bereich der maschinen und der register ueberschneidet
// sich nicht` rechnet es bei jedem Lauf nach.
const GPR_OFF: u64 = 0xA00
const GPR_BYTES: u64 = 112

const V_STATE: u64 = 0x00
const V_VMCB: u64 = 0x08
const V_NPML4: u64 = 0x10 // vier zusammenhaengende Rahmen
const V_RAM: u64 = 0x18 // der Speicher des Gasts, GUEST_PAGES Rahmen
const V_PAGES: u64 = 0x20
const V_ASID: u64 = 0x28
const V_EXITS: u64 = 0x30
const V_RESULT: u64 = 0x38
const V_DONE: u64 = 0x40
const V_OWNER: u64 = 0x48 // welche Aufgabe die Maschine besitzt
const V_GUEST: u64 = 0x50
const V_CYCLES: u64 = 0x58
const V_LAST: u64 = 0x60 // der letzte Austrittsgrund
const V_WHY: u64 = 0x68 // warum sie abgeraeumt wurde
const V_BUDGET: u64 = 0x70
// RUNDE HV2, STUFE 2. Ein Gast mit grossem Speicher bekommt einen
// AUSGERICHTETEN Lauf: `frame_run` gibt zusammenhaengende Rahmen, aber
// nicht auf 2 MiB ausgerichtete. Der Wirt fordert deshalb mehr an, als
// er braucht, und rueckt den Anfang vor. Damit er den Lauf spaeter
// vollstaendig zurueckgeben kann, merkt er sich BEIDES: den Anfang des
// wirklich angeforderten Laufs und seine Laenge.
const V_RUNBASE: u64 = 0x78 // was `frame_run` zurueckgab
const V_RUNLEN: u64 = 0x80 // wie viele Rahmen das waren
const V_BIG: u64 = 0x88 // wie viele 2-MiB-Seiten abgebildet sind
// RUNDE HV3, STUFE 5. Der Zeitgeber des Gasts. Ein echtes Linux
// wartet nach dem Hochlauf mit `hlt` auf den naechsten Takt; ohne
// eingeworfene Unterbrechung steht es dort fuer immer. Gemessen:
// 3009 Austritte mit dem Grund 0x60 an EINEM Befehlszeiger
// (0xffffffff810033cf, `native_safe_halt`).
const V_TICKS: u64 = 0x90 // wie viele Takte eingeworfen wurden
const V_TSTEP: u64 = 0x98 // wie viele Austritte bis zum naechsten

const ST_FREE: u64 = 0
const ST_READY: u64 = 1
const ST_HALT: u64 = 2
const ST_DONE: u64 = 3
const ST_DEAD: u64 = 4

const R_MORE: u64 = 0
const R_HALT: u64 = 1
const R_DONE: u64 = 2
const R_SHUTDOWN: u64 = 3
const R_EXC: u64 = 4
const R_BUDGET: u64 = 5
const R_ERR: u64 = 6
const R_FAULT: u64 = 7

// Die eingebauten Gaeste (`kernel/hv.s`).
const G_HELLO: u64 = 0
const G_PM: u64 = 1
const G_LOOP: u64 = 2
const G_FAULT: u64 = 3
const G_CRASH: u64 = 4
const G_BENCH: u64 = 5
// RUNDE HV2, STUFE 1: der Gast, der sich selbst in den langen Modus
// bringt. Er braucht mehr Speicher als die anderen (vier Tabellenseiten
// und einen Stapel oberhalb davon), siehe `pages_for`.
const G_LM: u64 = 6
// RUNDE HV2, STUFE 3: der Gast, der die Geraete PRUEFT statt sie nur
// zu benutzen -- Kratzregister, Zeilenzustand, DLAB, die vierteilige
// Anfangsfolge des Verteilers, der zweiteilige Zeitgeber.
const G_DEV: u64 = 7
// RUNDE HV3: der Linux-Gast. Er hat KEIN Abbild in `hv.s` -- sein
// Abbild ist das Boot-Modul. Die Tabelle in `hv.s` traegt trotzdem ein
// Paar fuer ihn (zwei gleiche Adressen, also Laenge 0), damit die
// Formel HV_G_FIRST + Nummer * 2 weiter aufgeht. Der Fehler (a) der
// Runde HV2 ist genau hier passiert.
const G_LINUX: u64 = 8
const G_MAX: u64 = 9

// Die Woerter der Kommandozeile. KEINES ausser dem ersten enthaelt die
// zwei Buchstaben `hv` -- sonst schaltete die Gegenprobe, die `hv`
// weglaesst, die Runde ueber ihr eigenes Argument wieder ein. Dieselbe
// Ueberlegung steht in `hw.fi` bei `nic`.
const M_HV: u64 = 1 // die Runde ueberhaupt
const M_LOOP: u64 = 2 // `gastlauf`: auch den Laeufer laufen lassen
const M_NOSVM: u64 = 4 // `nosvm`:   GEGENPROBE, SVM bleibt aus
const M_NONPT: u64 = 8 // `nonpt`:   GEGENPROBE, keine NPT
const M_CR: u64 = 16 // `gastcr`:  Steuerregister abfangen
const M_MESS: u64 = 32 // `gastmess`: den Preis eines Austritts messen
// `gastfrei`: V_INTR_MASKING AUSschalten. Das ist die GEGENPROBE zu der
// einen Zusage, die einen Wirt zum Wirt macht -- siehe `vmcb_setup`.
const M_FREE: u64 = 64
// RUNDE HV2. `gastlang`: den Gast laufen lassen, der in den langen
// Modus geht. `ohnelme`: die GEGENPROBE dazu -- der Wirt schluckt das
// Schreiben auf EFER.LME, statt es zu uebernehmen, und der Gast bleibt
// 32 Bit. Auch hier enthaelt KEIN Wort die zwei Buchstaben `hv`.
const M_LM: u64 = 128
const M_NOLME: u64 = 256
// `gastgeraet`: den Gast laufen lassen, der die Geraete prueft.
const M_DEV: u64 = 512

// ================== RUNDE HV3: DIE ZWEI NEUEN WOERTER ==================
//
// `gastlinux`: das Boot-Modul als bzImage lesen, in einen grossen Gast
// laden und starten. OHNE Modul tut das Wort nichts -- es ist dann eine
// gedruckte Zeile und kein Fehler, denn die meisten Laeufe dieses
// Kernels haben kein Linux dabei.
//
// `gastzp`: NUR die Zero-Page und den Kopf pruefen, ohne einen Gast
// anzulegen. Das ist der Teil des Ladewegs, der OHNE ein einziges
// Oktett Linux messbar ist -- der Bericht der Runde HV2 nennt ihn in
// Abschnitt 11 ausdruecklich als naechsten Schritt, und er ist die
// GEGENPROBE zu `gastlinux`: er zeigt, dass der Ladeweg auch dann
// stimmt, wenn nichts zu laden ist.
const M_LINUX: u64 = 1024
const M_ZP: u64 = 2048
// `ohnee820`: die GEGENPROBE zum Speicherbild. Linux bekommt eine
// Zero-Page OHNE E820-Eintraege -- und muss daran scheitern. Ohne diese
// Probe waere die Behauptung "das Speicherbild ist noetig" nur eine
// Behauptung.
const M_NOE820: u64 = 4096
// `gastspur`: jeden Austritt mitschreiben. Nur zur Untersuchung -- es
// macht die Ausgabe um ein Vielfaches laenger.
const M_SPUR: u64 = 8192

// Indizes in `hv_vectors` (kernel/hv.s), erreichbar ueber Platz 69 der
// Tabelle aus `isr.s`.
const V_HV: u64 = 69
const HV_VMRUN: u64 = 0
const HV_G_FIRST: u64 = 1 // je Gast ein Paar Anfang/Ende

// Der Gastspeicher: acht Seiten. Sieben davon bildet der Wirt beim
// Anlegen ab; die achte (gastphysisch 0x7000) bleibt ABSICHTLICH frei,
// damit ein Gast dagegenlaufen kann und der Wirt zeigen muss, dass er
// eine Seite auf Zuruf nachlegen kann.
const GUEST_PAGES: u64 = 8
const GUEST_MAPPED: u64 = 7
// RUNDE HV2: der Gast im langen Modus braucht mehr. Seine vierstufige
// Tabelle liegt bei 0x8000..0xB000, sein Stapel bei 0xB000 -- das sind
// zwoelf Seiten. Die Seite 0x7000 bleibt auch bei ihm ABSICHTLICH
// unabgebildet, damit die Probe "Seite auf Zuruf" ihren Sinn behaelt.
const GUEST_PAGES_LM: u64 = 12
const GUEST_LOAD: u64 = 0x1000 // wohin das Abbild kommt
const GUEST_PATTERN: u64 = 0x0800 // was der Gast dort finden soll
const PATTERN: u64 = 0x5A5A

// Seitentabelleneintraege der NPT. Vorhanden, schreibbar, Nutzer -- das
// dritte Bit ist kein Versehen: ein verschachtelter Seitenlauf laeuft
// IMMER mit Nutzerrechten (AMD APM 15.25.5), und ohne U bekaeme jeder
// Gastzugriff einen Seitenfehler.
const NPT_P: u64 = 1
const NPT_W: u64 = 2
const NPT_U: u64 = 4
const NPT_FLAGS: u64 = 7
const ADDR_MASK: u64 = 0x000FFFFFFFFFF000

const MSR_EFER: u64 = 0xC0000080
const MSR_STAR: u64 = 0xC0000081
const MSR_CSTAR: u64 = 0xC0000083
const MSR_SFMASK: u64 = 0xC0000084
const MSR_FS_BASE: u64 = 0xC0000100
const MSR_GS_BASE: u64 = 0xC0000101
const MSR_KGS_BASE: u64 = 0xC0000102
const MSR_VM_CR: u64 = 0xC0010114
const MSR_VM_HSAVE: u64 = 0xC0010117
const VM_CR_SVMDIS: u64 = 16

const BUDGET: u64 = 4096 // hoechstens so viele Austritte je Lauf
const LOOP_BUDGET: u64 = 64 // fuer den Laeufer reicht viel weniger
// Wie oft der Wirt ein Linux wieder hereinholen darf, und nach wie
// vielen stummen Laeufen er aufgibt. Beides sind Abbruchgrenzen einer
// MESSUNG, keine Eigenschaft des Gasts.
const LINUX_RUNDEN: u64 = 512
const LINUX_STILL: u64 = 32

// -------------------------------------------------------- die Zugriffe

fn get(state: u64, off: u64) -> u64 {
    return kstate.get(state, HV_OFF +% off)
}

fn set(state: u64, off: u64, v: u64) {
    kstate.set(state, HV_OFF +% off, v)
}

fn bump(state: u64, off: u64, v: u64) {
    set(state, off, get(state, off) +% v)
}

// Wo der Geraetesatz einer Maschine liegt. `vdev.fi` rechnet daraus
// selbst weiter -- es muss nicht wissen, wo in `kdata` es liegt.
fn vdev_base(state: u64) -> u64 {
    return VDEV_OFF
}

fn vm_at(state: u64, i: u64) -> u64 {
    return HV_OFF +% VM_OFF +% i *% VM_BYTES
}

fn vget(state: u64, i: u64, f: u64) -> u64 {
    return kstate.get(state, vm_at(state, i) +% f)
}

fn vset(state: u64, i: u64, f: u64, v: u64) {
    kstate.set(state, vm_at(state, i) +% f, v)
}

fn gpr_block(state: u64, i: u64) -> u64 {
    return state +% HV_OFF +% GPR_OFF +% i *% GPR_BYTES
}

fn gpr(block: u64, n: u64) -> u64 {
    return __mmio_read64((block +% n *% 8) as *mut u64)
}

fn gpr_set(block: u64, n: u64, v: u64) {
    __mmio_write64((block +% n *% 8) as *mut u64, v)
}

// Die Reihenfolge, in der `hv.s` sie hin- und hertraegt.
const G_RBX: u64 = 0
const G_RCX: u64 = 1
const G_RDX: u64 = 2
const G_RBP: u64 = 3
const G_R8: u64 = 4
const G_RDI: u64 = 12
const G_RSI: u64 = 13

fn vector(state: u64, i: u64) -> u64 {
    return __mmio_read64((kstate.get(state, kstate.VECTORS) +% i *% 8) as *mut u64)
}

fn hvv(state: u64, i: u64) -> u64 {
    return __mmio_read64((vector(state, V_HV) +% i *% 8) as *mut u64)
}

fn tsc() -> u64 {
    var lo: u64 = 0
    var hi: u64 = 0
    asm("rdtsc", out("rax") & lo, out("rdx") & hi)
    return (hi << 32) | (lo & 0xFFFFFFFF)
}

fn wrmsr(index: u64, value: u64) {
    asm("wrmsr", in("rcx") index, in("rax") value & 0xFFFFFFFF,
        in("rdx") value >> 32)
}

fn rdmsr(index: u64) -> u64 {
    var lo: u64 = 0
    var hi: u64 = 0
    asm("rdmsr", in("rcx") index, out("rax") & lo, out("rdx") & hi)
    return (hi << 32) | (lo & 0xFFFFFFFF)
}

// RUNDE KVMFIX: DIE SVM-REGISTER GIBT ES NUR AUF AMD.
//
// MSR_VM_CR (0xC0010114) und MSR_VM_HSAVE (0xC0010117) sind
// AMD-eigen. Auf einer Intel-Maschine sind beide ein #GP -- genau
// dasselbe, was IA32_TEMPERATURE_TARGET auf einem AMD ist, nur
// andersherum. Diese Runde ist dieser Kernel unter KVM auf einem AMD
// gestorben; auf einem Intel-PC waere er hier gestorben.
//
// Der Weg ueber CPUID (`cpu_has_svm`, ECX Bit 2 von 0x80000001) steht
// weiter davor und ist die richtige erste Frage. Aber er ist nur eine
// Frage, und die Antwort einer virtuellen Maschine darauf ist nicht
// bindend fuer das, was ihre MSR-Nachbildung dann wirklich annimmt.
// Also wird zusaetzlich gefangen: ein Register, das nicht antwortet,
// liest sich als Null und laesst `enable` mit einer Stufennummer
// aufgeben -- statt die Maschine anzuhalten.
fn rd_msr_safe(state: u64, index: u64) -> u64 {
    return msr.rd0(state, index)
}

fn wr_msr_safe(state: u64, index: u64, v: u64) -> bool {
    return msr.wr(state, index, v)
}

// ------------------------------------------------------------- die Woerter

// EIN WORT, UND ZWAR ALS GANZES WORT. Das ist keine Feinheit, sondern
// ein Fehler, den die Gegenprobe dieser Runde gefunden hat -- und er
// haette sonst still im Baum gelegen.
//
// QEMU stellt der Multiboot-Kommandozeile DEN PFAD DES ABBILDS VORAN:
//
//   mb: flags=0x24f  cmd=/tmp/tmp.aBhvXk12/osum0.mb osum nokbd nofs
//
// Die Testlaeufer bauen ihr Abbild in ein Verzeichnis aus `mktemp -d`,
// und dessen Name ist zufaellig. Enthaelt er die zwei Buchstaben `hv`
// -- und das passiert -- dann fand die alte Teilzeichenkettensuche das
// Wort dieser Runde IM PFAD, und der Kernel schaltete den Hypervisor
// ein, obwohl auf der Kommandozeile nichts davon stand. Genau das ist
// passiert: die Gegenprobe "ohne `hv` genau eine Zeile" wurde rot, weil
// der Kernel 20 Zusagen meldete, wo er hätte schweigen sollen.
//
// Nachgestellt, damit es kein Verdacht bleibt:
//
//   $ qemu-system-x86_64 -kernel /tmp/pfad-mit-hv-drin/k.mb \
//         -append 'osum nokbd nofs'
//   hv: proofs 20 / 20        <- ohne das Wort auf der Kommandozeile
//
// Deshalb sucht diese Runde WORTGENAU: vor dem Treffer muss der Anfang
// der Zeile oder ein Leerzeichen stehen, dahinter das Ende oder ein
// Leerzeichen. Ein Wort aus zwei Buchstaben ist sonst kein Schalter,
// sondern ein Zufall.
fn is_sep(c: u64) -> bool {
    return c == 32 || c == 9 || c == 0
}

fn find_word(hay: u64, needle: u64, n: u64) -> u64 {
    if hay == 0 {
        return 0
    }
    var i: u64 = 0
    while kstate.get8(hay +% i) != 0 {
        var k: u64 = 0
        var hit: bool = true
        while k < n {
            if kstate.get8(hay +% i +% k) != kstate.get8(needle +% k) {
                hit = false
                k = n
            } else {
                k = k + 1
            }
        }
        if hit {
            var links: bool = i == 0
            if !links {
                links = is_sep(kstate.get8(hay +% i -% 1))
            }
            let rechts: bool = is_sep(kstate.get8(hay +% i +% n))
            if links && rechts {
                return hay +% i
            }
        }
        i = i + 1
    }
    return 0
}

fn mode_of(cmd: u64) -> u64 {
    var w_hv: [u8; 3] = "hv\0"
    var w_loop: [u8; 9] = "gastlauf\0"
    var w_nosvm: [u8; 6] = "nosvm\0"
    var w_nonpt: [u8; 6] = "nonpt\0"
    var w_cr: [u8; 7] = "gastcr\0"
    var w_mess: [u8; 9] = "gastmess\0"
    var w_frei: [u8; 9] = "gastfrei\0"
    var w_lm: [u8; 9] = "gastlang\0"
    var w_nolme: [u8; 8] = "ohnelme\0"
    var w_dev: [u8; 11] = "gastgeraet\0"
    var w_lin: [u8; 10] = "gastlinux\0"
    var w_zp: [u8; 7] = "gastzp\0"
    var w_noe: [u8; 9] = "ohnee820\0"
    var w_spur: [u8; 9] = "gastspur\0"
    var m: u64 = 0
    if find_word(cmd, (&w_hv[0]) as u64, 2) != 0 {
        m = m | M_HV
    }
    if find_word(cmd, (&w_loop[0]) as u64, 8) != 0 {
        m = m | M_LOOP
    }
    if find_word(cmd, (&w_nosvm[0]) as u64, 5) != 0 {
        m = m | M_NOSVM
    }
    if find_word(cmd, (&w_nonpt[0]) as u64, 5) != 0 {
        m = m | M_NONPT
    }
    if find_word(cmd, (&w_cr[0]) as u64, 6) != 0 {
        m = m | M_CR
    }
    if find_word(cmd, (&w_mess[0]) as u64, 8) != 0 {
        m = m | M_MESS
    }
    if find_word(cmd, (&w_frei[0]) as u64, 8) != 0 {
        m = m | M_FREE
    }
    if find_word(cmd, (&w_lm[0]) as u64, 8) != 0 {
        m = m | M_LM
    }
    if find_word(cmd, (&w_nolme[0]) as u64, 7) != 0 {
        m = m | M_NOLME
    }
    if find_word(cmd, (&w_dev[0]) as u64, 10) != 0 {
        m = m | M_DEV
    }
    if find_word(cmd, (&w_lin[0]) as u64, 9) != 0 {
        m = m | M_LINUX
    }
    if find_word(cmd, (&w_zp[0]) as u64, 6) != 0 {
        m = m | M_ZP
    }
    if find_word(cmd, (&w_noe[0]) as u64, 8) != 0 {
        m = m | M_NOE820
    }
    if find_word(cmd, (&w_spur[0]) as u64, 8) != 0 {
        m = m | M_SPUR
    }
    return m
}

// Wie in `hw.fi`: die Kommandozeile wird gelesen, BEVOR der
// Rahmenverwalter den Speicher, in dem sie steht, als Halde ausgibt.
fn parse(state: u64, cmd: u64) {
    set(state, S_MODE, mode_of(cmd))
}

fn on(state: u64, bit: u64) -> bool {
    return (get(state, S_MODE) & bit) != 0
}

fn ready(state: u64) -> bool {
    return get(state, S_READY) != 0
}

fn rev(state: u64) -> u64 {
    return get(state, S_REV)
}

fn nasid(state: u64) -> u64 {
    return get(state, S_NASID)
}

fn feat(state: u64) -> u64 {
    return get(state, S_FEAT)
}

fn runs(state: u64) -> u64 {
    return get(state, S_RUNS)
}

fn exits_total(state: u64) -> u64 {
    return get(state, S_EXITS)
}

fn cycles_run(state: u64) -> u64 {
    return get(state, S_CYC_RUN)
}

fn cycles_exit(state: u64) -> u64 {
    return get(state, S_CYC_EXIT)
}

fn npfs(state: u64) -> u64 {
    return get(state, S_NPFS)
}

fn killed(state: u64) -> u64 {
    return get(state, S_KILLED)
}

fn calls(state: u64) -> u64 {
    return get(state, S_CALLS)
}

fn injected(state: u64) -> u64 {
    return get(state, S_INJ)
}

fn guest_out(state: u64) -> u64 {
    return get(state, S_OUT)
}

fn ioports(state: u64) -> u64 {
    return get(state, S_IOPORTS)
}

fn msrs(state: u64) -> u64 {
    return get(state, S_MSRS)
}

fn crs(state: u64) -> u64 {
    return get(state, S_CRS)
}

// RUNDE HV2: wie oft ein Schreiben auf EFER wirklich uebernommen wurde.
fn eferw(state: u64) -> u64 {
    return get(state, S_EFERW)
}

fn vms_made(state: u64) -> u64 {
    return get(state, S_VMS)
}

fn exits_bucket(state: u64, b: u64) -> u64 {
    if b >= B_COUNT {
        return 0
    }
    return get(state, CNT_OFF +% b *% 8)
}

fn count(state: u64, b: u64) {
    bump(state, CNT_OFF +% b *% 8, 1)
}

fn value_of(state: u64, n: u64) -> u64 {
    if n >= VAL_MAX {
        return 0
    }
    return get(state, VAL_OFF +% n *% 8)
}

fn value_seen(state: u64, n: u64) -> bool {
    if n >= VAL_MAX {
        return false
    }
    return (get(state, S_VALMASK) & (1 << n)) != 0
}

fn value_put(state: u64, n: u64, v: u64) {
    if n >= VAL_MAX {
        return
    }
    set(state, VAL_OFF +% n *% 8, v)
    set(state, S_VALMASK, get(state, S_VALMASK) | (1 << n))
}

// ------------------------------------------------------- kann der Prozessor?

// CPUID 0x80000001, ECX Bit 2. Ohne dieses Bit gibt es weder `vmrun`
// noch EFER.SVME, und jeder Versuch waere ein #UD im Kernel.
fn cpu_has_svm() -> bool {
    var c: u64 = 0
    asm("push rbx\nmov eax, 0x80000001\ncpuid\nmov rax, rcx\npop rbx",
        out("rax") & c, clobber("rcx"), clobber("rdx"))
    return (c & 4) != 0
}

fn cpu_max_ext() -> u64 {
    var a: u64 = 0
    asm("push rbx\nmov eax, 0x80000000\ncpuid\npop rbx",
        out("rax") & a, clobber("rcx"), clobber("rdx"))
    return a & 0xFFFFFFFF
}

fn svm_rev() -> u64 {
    var a: u64 = 0
    asm("push rbx\nmov eax, 0x8000000A\ncpuid\npop rbx",
        out("rax") & a, clobber("rcx"), clobber("rdx"))
    return a & 0xFFFFFFFF
}

fn svm_nasid() -> u64 {
    var b: u64 = 0
    asm("push rbx\nmov eax, 0x8000000A\ncpuid\nmov rax, rbx\npop rbx",
        out("rax") & b, clobber("rcx"), clobber("rdx"))
    return b & 0xFFFFFFFF
}

fn svm_feat() -> u64 {
    var d: u64 = 0
    asm("push rbx\nmov eax, 0x8000000A\ncpuid\npop rbx",
        out("rdx") & d, clobber("rax"), clobber("rcx"))
    return d & 0xFFFFFFFF
}

// ------------------------------------------------------------ aufsetzen
//
// Fuenf Schritte, und jeder einzelne kann fehlschlagen, ohne dass es
// auffiele -- deshalb gibt jeder eine Zahl zurueck und `stage` sagt sie.
//
//   1. Kann der Prozessor es?              CPUID 0x80000001 ECX Bit 2
//   2. Hat die Firmware es freigegeben?    VM_CR Bit 4 (SVMDIS)
//   3. EFER.SVME setzen                    sonst ist `vmrun` ein #UD
//   4. Einen Rettungsbereich hinstellen    VM_HSAVE_PA
//   5. Die beiden Bitkarten                Anschluesse und MSRs
//
// Zu Schritt 5, und das ist eine Falle, die diesen Kernel haette
// stillschweigend falsch machen lassen: QEMU liest die Bitkarten
// WIRKLICH aus dem Speicher (svm_check_intercept_param). Stuende dort
// eine 0 als Basis, wuerde die physische Adresse 0 als Bitkarte gelesen
// -- und was dort steht, entscheidet dann darueber, welche Anschluesse
// abgefangen werden. Es waere ein Wirt, dessen Verhalten davon abhaengt,
// was zufaellig im ersten Kilobyte des Rechners liegt.
fn enable(state: u64) -> u64 {
    if !cpu_has_svm() {
        return 1
    }
    if cpu_max_ext() < 0x8000000A {
        return 2
    }
    set(state, S_REV, svm_rev())
    set(state, S_NASID, svm_nasid())
    set(state, S_FEAT, svm_feat())
    if (rd_msr_safe(state, MSR_VM_CR) & VM_CR_SVMDIS) != 0 {
        return 3
    }
    if svm_nasid() < 2 {
        return 4
    }

    let hsave: u64 = mem.frame_alloc(state)
    let host: u64 = mem.frame_alloc(state)
    let iopm: u64 = mem.frame_run(state, 3)
    let msrpm: u64 = mem.frame_run(state, 2)
    if hsave == 0 || host == 0 || iopm == 0 || msrpm == 0 {
        return 5
    }
    vmcb.zero_page(hsave)
    vmcb.zero_page(host)

    // Alle Anschluesse und alle MSRs abfangen. Ein Gast hat keinen
    // einzigen Anschluss fuer sich -- was er ansprechen darf, entscheidet
    // der Wirt bei jedem Zugriff einzeln, und nicht eine Bitkarte, die
    // irgendwann einmal gesetzt wurde.
    fill(iopm, 3 *% 4096, 0xFF)
    fill(msrpm, 2 *% 4096, 0xFF)

    set(state, S_HSAVE, hsave)
    set(state, S_HOSTVMCB, host)
    set(state, S_IOPM, iopm)
    set(state, S_MSRPM, msrpm)
    set(state, S_ASID, 1)

    wr_msr_safe(state, MSR_EFER, rd_msr_safe(state, MSR_EFER) | vmcb.EFER_SVME)
    if (rd_msr_safe(state, MSR_EFER) & vmcb.EFER_SVME) == 0 {
        return 6
    }
    wr_msr_safe(state, MSR_VM_HSAVE, hsave)
    if rd_msr_safe(state, MSR_VM_HSAVE) != hsave {
        return 7
    }
    set(state, S_READY, 1)
    return 0
}

fn fill(p: u64, n: u64, v: u64) {
    var i: u64 = 0
    let word: u64 = v | (v << 8) | (v << 16) | (v << 24)
        | (v << 32) | (v << 40) | (v << 48) | (v << 56)
    while i < n {
        __mmio_write64((p +% i) as *mut u64, word)
        i = i +% 8
    }
}

fn copy(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(dst +% i, kstate.get8(src +% i) as u8)
        i = i +% 1
    }
}

// ------------------------------------------ verschachtelte Seitentabellen
//
// Der Gast bekommt einen eigenen physischen Adressraum. Was er fuer
// Adresse 0x1000 haelt, ist irgendein Rahmen, den der Rahmenverwalter
// gerade uebrig hatte -- und er kann es nicht merken, weil er die
// Uebersetzung weder sieht noch anfassen kann.
//
// VIER EBENEN, wie im langen Modus, denn das ist das Format, das die
// Hardware fuer verschachtelte Tabellen verlangt (und das QEMU aus dem
// Zustand des WIRTS ableitet -- siehe oben). Vier Rahmen am Stueck: PML4,
// PDPT, PD, PT. Eine PT deckt 2 MiB, und mehr braucht keiner dieser
// Gaeste.
// Wie viele Seiten ein Gast bekommt. Bis zur Runde K12 waren es acht
// fuer jeden; der Gast im langen Modus braucht zwoelf.
fn pages_for(guest: u64) -> u64 {
    if guest == G_LM {
        return GUEST_PAGES_LM
    }
    return GUEST_PAGES
}

// Wie viele davon der Wirt von vornherein abbildet. Immer EINE weniger
// als vorhanden, und zwar die Seite 0x7000: sie bleibt absichtlich frei,
// damit ein Gast dagegenlaufen kann. Beim Gast im langen Modus liegt
// darueber noch seine Tabelle, die abgebildet sein MUSS -- sonst
// laeuft nicht ein Zugriff gegen die Wand, sondern der Seitenlauf des
// Prozessors selbst, und das gaebe eine Endlosschleife statt eines NPF.
fn hole_page(guest: u64) -> u64 {
    return 7
}

fn npt_build(state: u64, i: u64) -> bool {
    let base: u64 = vget(state, i, V_NPML4)
    let ram: u64 = vget(state, i, V_RAM)
    let pages: u64 = vget(state, i, V_PAGES)
    let guest: u64 = vget(state, i, V_GUEST)
    if base == 0 || ram == 0 {
        return false
    }
    let pdpt: u64 = base +% 4096
    let pd: u64 = base +% 8192
    let pt: u64 = base +% 12288
    vmcb.zero_page(base)
    vmcb.zero_page(pdpt)
    vmcb.zero_page(pd)
    vmcb.zero_page(pt)
    __mmio_write64(base as *mut u64, pdpt | NPT_FLAGS)
    __mmio_write64(pdpt as *mut u64, pd | NPT_FLAGS)
    __mmio_write64(pd as *mut u64, pt | NPT_FLAGS)
    let loch: u64 = hole_page(guest)
    var p: u64 = 0
    while p < pages {
        if p != loch {
            __mmio_write64((pt +% p *% 8) as *mut u64,
                (ram +% p *% 4096) | NPT_FLAGS)
        }
        p = p +% 1
    }
    return true
}

// Eine einzelne gastphysische Seite nachtraeglich abbilden. Das ist,
// was der Wirt bei einem NPF tut, wenn die Adresse zum Gast gehoert:
// Seiten auf Zuruf, fuer eine ganze Maschine statt fuer einen Prozess.
fn npt_map(state: u64, i: u64, gpa: u64) -> bool {
    let base: u64 = vget(state, i, V_NPML4)
    let ram: u64 = vget(state, i, V_RAM)
    let pages: u64 = vget(state, i, V_PAGES)
    let page: u64 = gpa >> 12
    if base == 0 || page >= pages {
        return false
    }
    let pt: u64 = base +% 12288
    let e: u64 = __mmio_read64((pt +% page *% 8) as *mut u64)
    if (e & NPT_P) != 0 {
        return false // war schon da: das ist kein fehlender Rahmen
    }
    __mmio_write64((pt +% page *% 8) as *mut u64,
        (ram +% page *% 4096) | NPT_FLAGS)
    return true
}

// ================== RUNDE HV2, STUFE 2: EINE TABELLE, DIE WAECHST ======
//
// Die NPT der Runde K12 hat GENAU EINE Seitentabelle und deckt damit
// zwei Mebioctets. Fuer sechs Gaeste von je acht Seiten reicht das; fuer
// irgendetwas Echtes nicht -- ein Linux-Kern will heute 55 MiB allein
// fuer sich (`init_size` im Kopf eines bzImage, nachgemessen).
//
// ZWEI-MEBIOCTET-SEITEN STATT VIERTEL-KILOBYTE-SEITEN. Ein Eintrag im
// Seitenverzeichnis mit dem Bit PS deckt zwei Mebioctets auf einmal.
// Das spart nicht nur Platz -- es spart vor allem ZEIT: 64 MiB in
// Seiten zu 4 KiB waeren 16384 Eintraege in 32 Tabellen, in Seiten zu
// 2 MiB sind es 32 Eintraege in EINER. Und es spart Rahmen: die
// Tabellen selbst kosten dann nichts mehr.
//
// WARUM DAS HIER GEHT UND BEIM GAST NICHT IMMER. Der Wirt darf die
// Groesse frei waehlen, weil ER den Speicher besitzt: eine grosse Seite
// verlangt nur, dass der Rahmen 2 MiB AUSGERICHTET ist. `frame_run`
// gibt zusammenhaengende Rahmen, aber nicht ausgerichtete -- deshalb
// fordert `vm_create_big` einen Lauf, der gross genug ist, und rueckt
// den Anfang auf die naechste 2-MiB-Grenze vor.
//
// EINE PD DECKT 1 GiB. Mehr braucht diese Runde nicht, und was sie
// nicht braucht, baut sie nicht.
const BIG_PAGE: u64 = 2097152 // 2 MiB
const BIG_SHIFT: u64 = 21
const NPT_PS: u64 = 128 // Bit 7: dieser Eintrag IST die Seite

// Baut die NPT eines Gasts mit grossen Seiten: PML4 -> PDP -> PD, und
// im PD steht je Eintrag unmittelbar der Speicher. Gibt zurueck, wie
// viele grosse Seiten abgebildet wurden.
fn npt_build_big(state: u64, i: u64) -> u64 {
    let base: u64 = vget(state, i, V_NPML4)
    let ram: u64 = vget(state, i, V_RAM)
    let bytes: u64 = vget(state, i, V_PAGES) *% 4096
    if base == 0 || ram == 0 {
        return 0
    }
    let pdpt: u64 = base +% 4096
    let pd: u64 = base +% 8192
    vmcb.zero_page(base)
    vmcb.zero_page(pdpt)
    vmcb.zero_page(pd)
    __mmio_write64(base as *mut u64, pdpt | NPT_FLAGS)
    __mmio_write64(pdpt as *mut u64, pd | NPT_FLAGS)
    var n: u64 = 0
    var off: u64 = 0
    while off < bytes {
        __mmio_write64((pd +% n *% 8) as *mut u64,
            (ram +% off) | NPT_FLAGS | NPT_PS)
        n = n +% 1
        off = off +% BIG_PAGE
    }
    return n
}

// ---------------------------------------------------- eine Maschine anlegen

fn vm_valid(state: u64, i: u64) -> bool {
    if i >= MAX_VMS {
        return false
    }
    return vget(state, i, V_STATE) != ST_FREE
}

fn vm_state(state: u64, i: u64) -> u64 {
    if i >= MAX_VMS {
        return ST_FREE
    }
    return vget(state, i, V_STATE)
}

fn vm_result(state: u64, i: u64) -> u64 {
    if i >= MAX_VMS {
        return 0
    }
    return vget(state, i, V_RESULT)
}

fn vm_exits(state: u64, i: u64) -> u64 {
    if i >= MAX_VMS {
        return 0
    }
    return vget(state, i, V_EXITS)
}

// RUNDE HV2: wie viele 2-MiB-Seiten diese Maschine hat (0 = kleine).
fn vm_big(state: u64, i: u64) -> u64 {
    if i >= MAX_VMS {
        return 0
    }
    return vget(state, i, V_BIG)
}

fn vm_pages(state: u64, i: u64) -> u64 {
    if i >= MAX_VMS {
        return 0
    }
    return vget(state, i, V_PAGES)
}

fn vm_guest(state: u64, i: u64) -> u64 {
    if i >= MAX_VMS {
        return 0
    }
    return vget(state, i, V_GUEST)
}

fn vm_owner(state: u64, i: u64) -> u64 {
    if i >= MAX_VMS {
        return 0
    }
    return vget(state, i, V_OWNER)
}

fn vm_slot(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_VMS {
        if vget(state, i, V_STATE) == ST_FREE {
            return i
        }
        i = i +% 1
    }
    return MAX_VMS
}

// Legt eine Gastmaschine an: Steuerblock, Seitentabellen, Speicher,
// Gastzustand. Gibt den Platz zurueck, oder MAX_VMS.
//
// Der Gast startet im REALMODUS, und das ist Absicht: so faengt jeder
// x86-Rechner an, und ein Gast, der etwas anderes will, schaltet selbst
// um -- genau das tut der zweite Gast dieser Runde.
fn vm_create(state: u64, guest: u64, owner: u64) -> u64 {
    if !ready(state) || guest >= G_MAX {
        return MAX_VMS
    }
    let i: u64 = vm_slot(state)
    if i >= MAX_VMS {
        return MAX_VMS
    }
    let pages: u64 = pages_for(guest)
    let blk: u64 = mem.frame_alloc(state)
    let npt: u64 = mem.frame_run(state, 4)
    let ram: u64 = mem.frame_run(state, pages)
    // Bei den kleinen Gaesten ist der Lauf genau der Speicher: nichts
    // auszurichten, nichts vorzuruecken.
    vset(state, i, V_RUNBASE, ram)
    vset(state, i, V_RUNLEN, pages)
    vset(state, i, V_BIG, 0)
    if blk == 0 || npt == 0 || ram == 0 {
        if blk != 0 {
            mem.frame_free(state, blk)
        }
        return MAX_VMS
    }
    vset(state, i, V_VMCB, blk)
    vset(state, i, V_NPML4, npt)
    vset(state, i, V_RAM, ram)
    vset(state, i, V_PAGES, pages)
    vset(state, i, V_GUEST, guest)
    vset(state, i, V_OWNER, owner)
    vset(state, i, V_EXITS, 0)
    vset(state, i, V_CYCLES, 0)
    vset(state, i, V_RESULT, 0)
    vset(state, i, V_DONE, 0)
    vset(state, i, V_WHY, 0)
    vset(state, i, V_LAST, 0)
    vset(state, i, V_BUDGET, BUDGET)
    vset(state, i, V_TICKS, 0)
    vset(state, i, V_TSTEP, 0)
    if guest == G_LOOP {
        vset(state, i, V_BUDGET, LOOP_BUDGET)
    }

    // Eine eigene Adressraumkennung. Die 0 ist verboten -- der Prozessor
    // weist den Eintritt sonst zurueck, und QEMU tut es auch
    // (`if (asid == 0) cpu_vmexit(SVM_EXIT_ERR)`).
    var asid: u64 = get(state, S_ASID)
    if asid == 0 {
        asid = 1
    }
    vset(state, i, V_ASID, asid)
    set(state, S_ASID, asid +% 1)

    // Der Speicher des Gasts: erst leeren, dann das Abbild hinein.
    var p: u64 = 0
    while p < pages {
        vmcb.zero_page(ram +% p *% 4096)
        p = p +% 1
    }
    let von: u64 = hvv(state, HV_G_FIRST +% guest *% 2)
    let bis: u64 = hvv(state, HV_G_FIRST +% guest *% 2 +% 1)
    copy(ram +% GUEST_LOAD, von, bis -% von)
    // Das Muster, an dem der Gast merkt, dass er wirklich Speicher hat.
    __mmio_write16((ram +% GUEST_PATTERN) as *mut u16, PATTERN as u16)

    if !npt_build(state, i) {
        return MAX_VMS
    }
    vmcb_setup(state, i)
    var g: u64 = 0
    let block: u64 = gpr_block(state, i)
    while g < 14 {
        gpr_set(block, g, 0)
        g = g +% 1
    }
    vdev.reset(state, vdev_base(state), i)
    vset(state, i, V_STATE, ST_READY)
    bump(state, S_VMS, 1)
    return i
}

// ============ RUNDE HV2, STUFE 2: EINE MASCHINE MIT VIEL SPEICHER ====
//
// `vm_create` gibt jedem Gast acht (oder zwoelf) Seiten und eine NPT
// aus lauter kleinen Eintraegen. Das traegt die Gaeste der Runde K12
// und sonst nichts. Diese Funktion legt eine Maschine an, deren
// Speicher in MEBIOCTETS gemessen wird und deren Tabelle aus 2-MiB-
// Seiten besteht.
//
// DIE AUSRICHTUNG IST DER GANZE PUNKT. Ein Eintrag mit dem Bit PS
// verlangt, dass die Adresse auf 2 MiB ausgerichtet ist -- die unteren
// 21 Bit muessen Null sein. `frame_run` gibt zusammenhaengende Rahmen,
// aber es verspricht keine Ausrichtung. Also fordert der Wirt bis zu
// eine grosse Seite MEHR an, als er braucht, und faengt beim naechsten
// Vielfachen an. Was davor liegt, bleibt Teil des Laufs und wird beim
// Abraeumen mit zurueckgegeben -- deshalb merkt sich die Maschine
// V_RUNBASE und V_RUNLEN und nicht nur V_RAM.
//
// `mib` ist die gewuenschte Groesse in Mebioctets, aufgerundet auf ein
// Vielfaches von zwei.
fn vm_create_big(state: u64, guest: u64, owner: u64, mib: u64) -> u64 {
    if !ready(state) || guest >= G_MAX {
        return MAX_VMS
    }
    let i: u64 = vm_slot(state)
    if i >= MAX_VMS {
        return MAX_VMS
    }
    // Auf ganze grosse Seiten aufrunden, mindestens eine.
    var big: u64 = (mib +% 1) / 2
    if big == 0 {
        big = 1
    }
    let want: u64 = big *% (BIG_PAGE / 4096) // Rahmen, die der Gast sieht
    // Eine grosse Seite mehr, damit das Vorruecken auf jeden Fall passt.
    let runlen: u64 = want +% (BIG_PAGE / 4096)

    let blk: u64 = mem.frame_alloc(state)
    let npt: u64 = mem.frame_run(state, 4)
    let run: u64 = mem.frame_run(state, runlen)
    if blk == 0 || npt == 0 || run == 0 {
        if blk != 0 {
            mem.frame_free(state, blk)
        }
        return MAX_VMS
    }
    // Vorruecken auf die naechste 2-MiB-Grenze.
    var ram: u64 = run
    let rest: u64 = run & (BIG_PAGE -% 1)
    if rest != 0 {
        ram = run +% (BIG_PAGE -% rest)
    }

    vset(state, i, V_VMCB, blk)
    vset(state, i, V_NPML4, npt)
    vset(state, i, V_RAM, ram)
    vset(state, i, V_PAGES, want)
    vset(state, i, V_RUNBASE, run)
    vset(state, i, V_RUNLEN, runlen)
    vset(state, i, V_GUEST, guest)
    vset(state, i, V_OWNER, owner)
    vset(state, i, V_EXITS, 0)
    vset(state, i, V_CYCLES, 0)
    vset(state, i, V_RESULT, 0)
    vset(state, i, V_DONE, 0)
    vset(state, i, V_WHY, 0)
    vset(state, i, V_LAST, 0)
    vset(state, i, V_BUDGET, BUDGET)

    var asid: u64 = get(state, S_ASID)
    if asid == 0 {
        asid = 1
    }
    vset(state, i, V_ASID, asid)
    set(state, S_ASID, asid +% 1)

    // NUR die erste grosse Seite wird geleert und traegt das Abbild.
    // Ein Gast mit 64 MiB wuerde sonst 64 MiB Nullen schreiben, bevor
    // er ueberhaupt anfaengt -- unter QEMUs Emulation sind das Minuten.
    var p: u64 = 0
    while p < (BIG_PAGE / 4096) {
        vmcb.zero_page(ram +% p *% 4096)
        p = p +% 1
    }
    let von: u64 = hvv(state, HV_G_FIRST +% guest *% 2)
    let bis: u64 = hvv(state, HV_G_FIRST +% guest *% 2 +% 1)
    copy(ram +% GUEST_LOAD, von, bis -% von)
    __mmio_write16((ram +% GUEST_PATTERN) as *mut u16, PATTERN as u16)

    let n: u64 = npt_build_big(state, i)
    if n == 0 {
        return MAX_VMS
    }
    vset(state, i, V_BIG, n)
    vmcb_setup(state, i)
    var g: u64 = 0
    let block: u64 = gpr_block(state, i)
    while g < 14 {
        gpr_set(block, g, 0)
        g = g +% 1
    }
    vdev.reset(state, vdev_base(state), i)
    vset(state, i, V_STATE, ST_READY)
    bump(state, S_VMS, 1)
    return i
}

// Der Steuerblock. Alles, was hier NICHT gesetzt wird, ist Null -- und
// Null ist ueberall die richtige Vorgabe ausser bei den vier Feldern,
// die das Handbuch anders will.
fn vmcb_setup(state: u64, i: u64) {
    let b: u64 = vget(state, i, V_VMCB)
    let guest: u64 = vget(state, i, V_GUEST)
    vmcb.zero_page(b)

    // 1. Was abgefangen wird.
    var i3: u64 = vmcb.I3_CPUID | vmcb.I3_HLT | vmcb.I3_IOIO
        | vmcb.I3_MSR | vmcb.I3_SHUTDOWN | vmcb.I3_INTR
        | vmcb.I3_NMI | vmcb.I3_INIT
    if on(state, M_CR) {
        // Ohne Decode Assists muss der Wirt den Befehl selbst lesen --
        // deshalb ist das ein Schalter und nicht die Vorgabe. Fuer die
        // Uebersetzung braucht es dieses Abfangen nicht: mit NPT gehoert
        // dem Gast sein CR3 ganz allein.
        vmcb.wr32(b, vmcb.C_ICPT_CR, (1 << 16) | (1 << 19) | (1 << 20))
    }
    vmcb.wr32(b, vmcb.C_ICPT_1, i3)
    // VMRUN MUSS abgefangen werden, sonst weist der Prozessor den
    // Eintritt zurueck. VMMCALL ist der Weg, auf dem sich ein Gast beim
    // Wirt meldet.
    vmcb.wr32(b, vmcb.C_ICPT_2, vmcb.I4_VMRUN | vmcb.I4_VMMCALL
        | vmcb.I4_VMLOAD | vmcb.I4_VMSAVE | vmcb.I4_STGI | vmcb.I4_CLGI
        | vmcb.I4_SKINIT)
    // Ein ungueltiger Befehl im Gast soll den Wirt nichts angehen -- der
    // fuenfte Gast lebt davon, dass daraus ein Dreifachfehler wird und
    // NICHT ein Absturz des Wirts.
    vmcb.wr32(b, vmcb.C_ICPT_EXC, 0)

    vmcb.wr(b, vmcb.C_IOPM, get(state, S_IOPM))
    vmcb.wr(b, vmcb.C_MSRPM, get(state, S_MSRPM))
    vmcb.wr32(b, vmcb.C_ASID, vget(state, i, V_ASID))
    vmcb.wr8(b, vmcb.C_TLBCTL, vmcb.TLB_FLUSH_ALL)

    // 2. Verschachtelte Seitentabellen. Die GEGENPROBE `nonpt` laesst
    //    das weg -- dann steht der Gast unmittelbar im physischen
    //    Speicher des Wirts, und das MUSS sich messen lassen.
    if !on(state, M_NONPT) {
        vmcb.wr(b, vmcb.C_NPENABLE, vmcb.NP_ENABLE)
        vmcb.wr(b, vmcb.C_NCR3, vget(state, i, V_NPML4))
    }

    // 3. WEM GEHOERT DIE PHYSISCHE UNTERBRECHUNG. Das ist die eine
    //    Einstellung, die einen Wirt zum Wirt macht.
    //
    //    Mit V_INTR_MASKING entscheidet NICHT das Flag des Gasts
    //    darueber, ob der Wirt seinen Zeitgeber zurueckbekommt. Ein
    //    Gast, der `cli` sagt und dann im Kreis laeuft, haette die
    //    Maschine sonst fuer immer -- und ein "Wirt", dem sein eigener
    //    Gast den Prozessor abnehmen kann, ist keiner.
    //
    //    DAS KOSTETE EINE STUNDE, UND DER FEHLER WAR MEINER. Der Laeufer
    //    dieser Runde blieb haengen, und es sah nach einer Grenze von
    //    QEMU aus. Es war keine. QEMU nimmt die Unterbrechung im Gast
    //    genau dann, wenn (HF2_VINTR und HF2_HIF) oder (nicht HF2_VINTR
    //    und EFLAGS.IF des Gasts) gilt (cpu.c, `x86_cpu_pending_
    //    interrupt`, Zeile 6872) -- und HF2_HIF setzt `helper_vmrun` aus
    //    dem EFLAGS.IF DES WIRTS, gelesen im Augenblick des Eintritts.
    //    Der Austrittsbehandler machte damals ein `sti; nop; cli`, um
    //    die Unterbrechung hereinzulassen. Das `cli` am Ende loeschte
    //    das IF des Wirts -- und der ZWEITE Eintritt war blind. Der
    //    erste Austritt kam noch, danach nie wieder.
    //
    //    Zwei Zeilen weiter unten steht die Lehre: der Behandler dreht
    //    an IF ueberhaupt nicht mehr. `stgi` am Ende von `hv_vmrun`
    //    macht das globale Flag auf, das IF des Wirts kommt beim
    //    Austritt aus dem Rettungsbereich zurueck, und die Unterbrechung
    //    wird noch im Stumpf zugestellt.
    //
    //    GEMESSEN (`gastlauf`, QEMU 7.2, Gast mit `cli` in der Schleife):
    //      V_INTR_MASKING AN  -> 64 INTR-Austritte, der Wirt lebt
    //      V_INTR_MASKING AUS -> VMRUN kehrt NIE zurueck  (`gastfrei`)
    if on(state, M_FREE) {
        vmcb.wr32(b, vmcb.C_INTCTL, 0)
    } else {
        vmcb.wr32(b, vmcb.C_INTCTL, vmcb.INT_MASKING)
    }

    // 4. Der Gastzustand: Realmodus, so wie ein x86 anfaengt.
    let cs_base: u64 = GUEST_LOAD
    vmcb.seg(b, vmcb.S_CS, 0x0100, vmcb.ATTR_CODE16, 0xFFFF, cs_base)
    vmcb.seg(b, vmcb.S_ES, 0, vmcb.ATTR_DATA16, 0xFFFF, 0)
    vmcb.seg(b, vmcb.S_SS, 0, vmcb.ATTR_DATA16, 0xFFFF, 0)
    vmcb.seg(b, vmcb.S_DS, 0, vmcb.ATTR_DATA16, 0xFFFF, 0)
    vmcb.seg(b, vmcb.S_FS, 0, vmcb.ATTR_DATA16, 0xFFFF, 0)
    vmcb.seg(b, vmcb.S_GS, 0, vmcb.ATTR_DATA16, 0xFFFF, 0)
    vmcb.seg(b, vmcb.S_GDTR, 0, 0, 0xFFFF, 0)
    vmcb.seg(b, vmcb.S_LDTR, 0, vmcb.ATTR_LDTR, 0xFFFF, 0)
    vmcb.seg(b, vmcb.S_TR, 0, vmcb.ATTR_TR, 0xFFFF, 0)
    // Der fuenfte Gast bekommt KEINE Vektortabelle. Aus seinem
    // ungueltigen Befehl wird damit zwingend ein Dreifachfehler.
    if guest == G_CRASH {
        vmcb.seg(b, vmcb.S_IDTR, 0, 0, 0, 0)
    } else {
        vmcb.seg(b, vmcb.S_IDTR, 0, 0, 0xFFFF, 0)
    }
    vmcb.wr8(b, vmcb.S_CPL, 0)
    // EFER.SVME MUSS im Gast-EFER stehen, auch wenn der Gast nichts
    // davon weiss (AMD APM 15.5.1: sonst ist der Zustand ungueltig).
    vmcb.wr(b, vmcb.S_EFER, vmcb.EFER_SVME)
    vmcb.wr(b, vmcb.S_CR0, 0x10) // PE aus, ET an: Realmodus
    vmcb.wr(b, vmcb.S_CR3, 0)
    vmcb.wr(b, vmcb.S_CR4, 0)
    vmcb.wr(b, vmcb.S_DR6, 0xFFFF0FF0)
    vmcb.wr(b, vmcb.S_DR7, 0x400)
    // Wie ein echter Rechner anfaengt: IF aus. Dass der Wirt seinen
    // Zeitgeber trotzdem zurueckbekommt, ist NICHT die Freundlichkeit
    // des Gasts, sondern V_INTR_MASKING -- siehe Punkt 3.
    vmcb.wr(b, vmcb.S_RFLAGS, 2)
    vmcb.wr(b, vmcb.S_RIP, 0)
    vmcb.wr(b, vmcb.S_RSP, 0x0FF0)
    vmcb.wr(b, vmcb.S_RAX, 0)
    vmcb.wr(b, vmcb.S_GPAT, 0x0007040600070406)
}

// ====================================================================
//         RUNDE HV3, STUFE 4: EINEN LINUX-GAST FERTIG STARTEN
// ====================================================================
//
// Alle Gaeste bis hierher fangen im REALMODUS an und gehen ihren Weg
// selbst -- so, wie ein x86-Rechner anfaengt. Der 64-Bit-Einsprung des
// Linux-Boot-Protokolls geht genau umgekehrt: er verlangt einen Gast,
// der SCHON fertig im langen Modus steht. boot.rst sagt es woertlich:
//
//   "the CPU must be in 64-bit mode with paging enabled ... a GDT must
//    be loaded with the descriptors for selectors __BOOT_CS(0x10) and
//    __BOOT_DS(0x18) ... interrupts must be disabled ... %rsi must hold
//    the base address of the struct boot_params"
//
// DAS IST DER UMGEKEHRTE FALL ZU STUFE 1 DER RUNDE HV2, und er ist
// leichter, weil der Wirt den Zustand einfach HINSCHREIBEN darf,
// anstatt ihn erlaufen zu lassen. Die eine Falle ist dieselbe wie dort:
// wer CR0.PG und EFER.LME setzt, MUSS EFER.LMA selbst dazusetzen -- der
// Prozessor tut es nur, wenn er den Befehl wirklich ausfuehrt, und hier
// fuehrt er keinen aus. Ohne LMA ist der Gastzustand ungueltig und der
// Eintritt wird zurueckgewiesen (`err`), was aussieht wie ein kaputtes
// Abbild und keines ist.
//
// WO DIE TABELLEN LIEGEN. Der Gast braucht eine vierstufige
// Seitentabelle, die seinen eigenen Speicher identisch abbildet -- und
// zwar, BEVOR er den ersten Befehl ausfuehrt. Diese Tabelle baut der
// WIRT in den Gastspeicher; Linux baut sich spaeter seine eigene.
//
//   gastphysisch 0x13000   PML4
//   gastphysisch 0x14000   PDP  (deckt 512 GiB mit 512 Eintraegen)
//   gastphysisch 0x15000   PD   fuer 0..1 GiB, aus 2-MiB-Seiten
//   gastphysisch 0x16000   PD   fuer 1..2 GiB
//
// ZWEI GIBIOCTETS identisch abgebildet. Mehr braucht ein Gast dieser
// Runde nicht, und was nicht gebraucht wird, wird nicht gebaut.
const GL_PML4: u64 = 0x13000
const GL_PDP: u64 = 0x14000
const GL_PD0: u64 = 0x15000
const GL_PD1: u64 = 0x16000
const GL_GIB: u64 = 2 // so viele Gibioctets bildet der Wirt ab

// Die GDT, die das Protokoll verlangt. Die SELEKTOREN SIND
// VORGESCHRIEBEN und nicht frei waehlbar: 0x10 ist der Code, 0x18 sind
// die Daten. Wer sie tauscht, bekommt einen Gast, der beim ersten
// Datenzugriff stirbt -- und der Fehler sieht aus wie ein kaputter
// Kern.
//
//   0x00  Null
//   0x08  ungenutzt (das Protokoll nennt nur 0x10 und 0x18)
//   0x10  Code 64 Bit, L=1, D=0      -> __BOOT_CS
//   0x18  Daten                       -> __BOOT_DS
const GL_CS: u64 = 0x10
const GL_DS: u64 = 0x18

// Baut die Seitentabelle des Gasts IM GASTSPEICHER und gibt die
// gastphysische Wurzel zurueck.
fn linux_paging(gram: u64) -> u64 {
    vmcb.zero_page(gram +% GL_PML4)
    vmcb.zero_page(gram +% GL_PDP)
    vmcb.zero_page(gram +% GL_PD0)
    vmcb.zero_page(gram +% GL_PD1)
    // Vorhanden, schreibbar -- und OHNE das Nutzerbit. Das ist der
    // Unterschied zur NPT: ein verschachtelter Lauf braucht U (AMD APM
    // 15.25.5), die Tabelle eines Kerns darf es nicht haben.
    let flags: u64 = 3
    __mmio_write64((gram +% GL_PML4) as *mut u64, GL_PDP | flags)
    __mmio_write64((gram +% GL_PDP) as *mut u64, GL_PD0 | flags)
    __mmio_write64((gram +% GL_PDP +% 8) as *mut u64, GL_PD1 | flags)
    var g: u64 = 0
    while g < GL_GIB {
        var pd: u64 = GL_PD0
        if g == 1 {
            pd = GL_PD1
        }
        var n: u64 = 0
        while n < 512 {
            // Bit 7 (PS) macht den Eintrag SELBST zur Seite: 2 MiB.
            let phys: u64 = g *% 0x40000000 +% n *% 0x200000
            __mmio_write64((gram +% pd +% n *% 8) as *mut u64,
                phys | flags | 0x80)
            n = n +% 1
        }
        g = g +% 1
    }
    return GL_PML4
}

// Legt die GDT im Gastspeicher ab. Gibt die gastphysische Adresse
// zurueck.
fn linux_gdt(gram: u64) -> u64 {
    let p: u64 = gram +% bzload.G_GDT
    vmcb.zero_page(p)
    __mmio_write64(p as *mut u64, 0)
    __mmio_write64((p +% 8) as *mut u64, 0)
    // Code 64 Bit: L=1 (Bit 53), P/DPL0/S/Code/R (0x9A), G+L in 0xA0.
    __mmio_write64((p +% 16) as *mut u64, 0x00AF9A000000FFFF)
    // Daten: schreibbar, 32-Bit-Granularitaet.
    __mmio_write64((p +% 24) as *mut u64, 0x00CF92000000FFFF)
    return bzload.G_GDT
}

// Den Gastzustand fuer den 64-Bit-Einsprung hinschreiben. Das ist die
// Funktion, in der das Boot-Protokoll Zeile fuer Zeile steht.
fn linux_state(state: u64, i: u64, entry: u64, zp: u64) {
    let b: u64 = vget(state, i, V_VMCB)
    let gram: u64 = vget(state, i, V_RAM)
    let block: u64 = gpr_block(state, i)

    let cr3: u64 = linux_paging(gram)
    let gdt: u64 = linux_gdt(gram)

    // Die Segmente. Im langen Modus ist die Basis bedeutungslos, aber
    // die ATTRIBUTE sind es nicht: ohne L=1 im Codesegment laeuft der
    // Gast 32-bittig weiter und fuehrt den 64-Bit-Einsprung als
    // 32-Bit-Code aus.
    vmcb.seg(b, vmcb.S_CS, GL_CS, vmcb.ATTR_CODE64, 0xFFFFFFFF, 0)
    vmcb.seg(b, vmcb.S_DS, GL_DS, vmcb.ATTR_DATA32, 0xFFFFFFFF, 0)
    vmcb.seg(b, vmcb.S_ES, GL_DS, vmcb.ATTR_DATA32, 0xFFFFFFFF, 0)
    vmcb.seg(b, vmcb.S_SS, GL_DS, vmcb.ATTR_DATA32, 0xFFFFFFFF, 0)
    vmcb.seg(b, vmcb.S_FS, GL_DS, vmcb.ATTR_DATA32, 0xFFFFFFFF, 0)
    vmcb.seg(b, vmcb.S_GS, GL_DS, vmcb.ATTR_DATA32, 0xFFFFFFFF, 0)
    vmcb.seg(b, vmcb.S_GDTR, 0, 0, 4 *% 8 -% 1, gdt)
    // KEINE Vektortafel: das Protokoll verlangt ausdruecklich
    // abgeschaltete Unterbrechungen, und Linux baut seine eigene.
    vmcb.seg(b, vmcb.S_IDTR, 0, 0, 0xFFFF, 0)
    vmcb.seg(b, vmcb.S_LDTR, 0, vmcb.ATTR_LDTR, 0xFFFF, 0)
    vmcb.seg(b, vmcb.S_TR, 0, vmcb.ATTR_TR, 0xFFFF, 0)
    vmcb.wr8(b, vmcb.S_CPL, 0)

    // Der lange Modus, fertig eingeschaltet. ALLE VIER Bits gehoeren
    // zusammen, und LMA ist das, das man vergisst:
    //   CR4.PAE   -- ohne sie gibt es keine vierstufige Tabelle
    //   EFER.LME  -- der lange Modus ist gewollt
    //   EFER.LMA  -- er ist AKTIV. Nur-Lese-Bit; hier setzt es der
    //                Wirt, weil kein Befehl ausgefuehrt wird, der es
    //                setzen koennte.
    //   CR0.PG|PE -- Paging und geschuetzter Modus
    vmcb.wr(b, vmcb.S_CR4, vmcb.CR4_PAE)
    vmcb.wr(b, vmcb.S_CR3, cr3)
    vmcb.wr(b, vmcb.S_CR0, vmcb.CR0_PE | vmcb.CR0_PG | vmcb.CR0_ET
        | vmcb.CR0_NE)
    vmcb.wr(b, vmcb.S_EFER, vmcb.EFER_SVME | vmcb.EFER_LME
        | vmcb.EFER_LMA | vmcb.EFER_NXE)

    // RFLAGS: Bit 1 ist immer gesetzt, IF ist AUS. Das ist die
    // Vorschrift, nicht die Vorsicht.
    vmcb.wr(b, vmcb.S_RFLAGS, 2)
    vmcb.wr(b, vmcb.S_RIP, entry)
    vmcb.wr(b, vmcb.S_RSP, bzload.G_STACK)
    vmcb.wr(b, vmcb.S_RAX, 0)
    vmcb.wr(b, vmcb.S_GPAT, 0x0007040600070406)

    // UND DAS EINE REGISTER, AN DEM ALLES HAENGT: RSI zeigt auf die
    // Zero-Page. Steht dort etwas anderes, liest Linux seine
    // Startparameter aus zufaelligem Speicher -- und das ist der
    // Fehler, der sich als "es sagt nichts" zeigt.
    var g: u64 = 0
    while g < 14 {
        gpr_set(block, g, 0)
        g = g +% 1
    }
    gpr_set(block, G_RSI, zp)
}

fn vm_destroy(state: u64, i: u64) -> bool {
    if i >= MAX_VMS {
        return false
    }
    if vget(state, i, V_STATE) == ST_FREE {
        return false
    }
    let blk: u64 = vget(state, i, V_VMCB)
    let npt: u64 = vget(state, i, V_NPML4)
    // ZURUECKGEGEBEN WIRD DER LAUF, DEN `frame_run` HERAUSGAB -- nicht
    // der ausgerichtete Anfang, den der Gast benutzt hat. Wer nur ab
    // V_RAM freigibt, laesst bei jedem grossen Gast die Rahmen zwischen
    // Lauf-Anfang und Ausrichtung liegen, und die Zusage ueber das Leck
    // faende es. Genau dafuer gibt es V_RUNBASE und V_RUNLEN.
    let rb: u64 = vget(state, i, V_RUNBASE)
    let rl: u64 = vget(state, i, V_RUNLEN)
    if blk != 0 {
        mem.frame_free(state, blk)
    }
    var k: u64 = 0
    while k < 4 {
        mem.frame_free(state, npt +% k *% 4096)
        k = k +% 1
    }
    k = 0
    while k < rl {
        mem.frame_free(state, rb +% k *% 4096)
        k = k +% 1
    }
    vset(state, i, V_STATE, ST_FREE)
    vset(state, i, V_VMCB, 0)
    vset(state, i, V_NPML4, 0)
    vset(state, i, V_RAM, 0)
    vset(state, i, V_RUNBASE, 0)
    vset(state, i, V_RUNLEN, 0)
    return true
}

fn vm_free_all(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < MAX_VMS {
        if vget(state, i, V_STATE) != ST_FREE {
            vm_destroy(state, i)
            n = n + 1
        }
        i = i +% 1
    }
    return n
}

// ------------------------------------------------------------ der Lauf
//
// DAS HERZ DER RUNDE. Eintritt, Austritt, Grund auswerten, wieder
// hinein -- bis der Gast fertig ist, stirbt oder sein Kontingent
// aufbraucht.
//
// Warum ein Kontingent: ein Gast kann sich weigern, jemals wieder
// auszutreten. Der Laeufer dieser Runde tut genau das. Das Abfangen der
// physischen Unterbrechung holt den Wirt zurueck; das Kontingent ist der
// Guertel zum Hosentraeger, damit selbst dann Schluss ist, wenn der
// Zeitgeber schwiege.
// ------------------------------------------------- der Takt des Gasts
//
// EIN GAST BRAUCHT EINE UHR, DIE VON SELBST SCHLAEGT. Alles, was
// diese Runde vorher gebaut hat, war eine ANTWORT auf etwas, das der
// Gast tat: er liest einen Anschluss, der Wirt antwortet. Der Takt
// ist das erste, was OHNE Zutun des Gasts geschieht -- und ohne ihn
// kommt ein Linux nicht ueber den Hochlauf hinaus. Es schaltet die
// Unterbrechungen frei, legt sich mit `hlt` hin und wartet auf IRQ 0.
//
// GEMESSEN, NICHT VERMUTET: ohne diesen Einwurf standen 3009 von
// 4096 Austritten an einem einzigen Befehlszeiger, dem `hlt` in
// `native_safe_halt`. Der Gast war nicht abgestuerzt -- er wartete
// auf etwas, das nie kam.
//
// Der Takt haengt am ERSTEN Verteiler, Leitung 0, wie auf echter
// Ausstattung. Der Vektor kommt deshalb aus ICW2 und ist NICHT fest
// 0x20: ein Linux setzt die Basis selbst, und wer hier eine feste
// Zahl einwirft, trifft nach dem Umprogrammieren den falschen
// Eintrag der Tabelle.
const TICK_EVERY: u64 = 64

// Darf jetzt eine Unterbrechung hinein? Drei Dinge muessen stimmen,
// und alle drei sind echte Bedingungen, keine Vorsicht:
//   1. Der Gast muss sie zulassen (sein IF im gespeicherten RFLAGS).
//   2. Es darf nicht schon eine im Einwurffeld stehen, sonst ginge
//      die erste verloren.
//   3. Der Verteiler muss die Leitung durchlassen (seine Maske).
fn may_inject(state: u64, i: u64, b: u64) -> bool {
    if (vmcb.rd(b, vmcb.C_EVENTINJ) & 0x80000000) != 0 {
        return false
    }
    if (vmcb.rd(b, vmcb.S_RFLAGS) & 0x200) == 0 {
        return false
    }
    if (vdev.pic_imr(state, vdev_base(state), i, false) & 1) != 0 {
        return false
    }
    return true
}

// Einen Takt einwerfen, wenn es an der Zeit ist. Gibt zurueck, ob
// wirklich einer hineinging -- der Aufrufer weckt danach einen
// haltenden Gast.
fn tick_inject(state: u64, i: u64, b: u64) -> bool {
    if !may_inject(state, i, b) {
        return false
    }
    let basis: u64 = vdev.pic_base(state, vdev_base(state), i, false)
    var vektor: u64 = basis & 0xF8
    if vektor == 0 {
        // Der Verteiler ist noch nicht programmiert. 0x08 ist, was
        // ein Rechner nach dem Einschalten haette.
        vektor = 0x08
    }
    vmcb.wr(b, vmcb.C_EVENTINJ, vektor | (0 << 8) | 0x80000000)
    bump(state, S_INJ, 1)
    vset(state, i, V_TICKS, vget(state, i, V_TICKS) +% 1)
    return true
}

fn vm_run(state: u64, i: u64) -> u64 {
    if i >= MAX_VMS {
        return R_ERR
    }
    let st: u64 = vget(state, i, V_STATE)
    if st != ST_READY && st != ST_HALT {
        return R_ERR
    }
    let b: u64 = vget(state, i, V_VMCB)
    let block: u64 = gpr_block(state, i)
    let host: u64 = get(state, S_HOSTVMCB)
    vset(state, i, V_STATE, ST_READY)

    var budget: u64 = vget(state, i, V_BUDGET)
    var out: u64 = R_BUDGET
    var lauf: bool = true
    while lauf {
        if budget == 0 {
            out = R_BUDGET
            lauf = false
        } else {
            budget = budget -% 1
            // Vor JEDEM Eintritt: ist der naechste Takt faellig?
            let schritt: u64 = vget(state, i, V_TSTEP) +% 1
            if schritt >= TICK_EVERY {
                if tick_inject(state, i, b) {
                    vset(state, i, V_TSTEP, 0)
                } else {
                    // Nicht verloren, nur verschoben: der Zaehler
                    // bleibt stehen, bis der Gast wieder zulaesst.
                    vset(state, i, V_TSTEP, schritt)
                }
            } else {
                vset(state, i, V_TSTEP, schritt)
            }
            let t0: u64 = tsc()
            asm("call rax", in("rax") hvv(state, HV_VMRUN),
                in("rdi") b, in("rsi") block, in("rdx") host,
                clobber("memory"))
            let t1: u64 = tsc()
            bump(state, S_CYC_RUN, t1 -% t0)
            bump(state, S_RUNS, 1)
            bump(state, S_EXITS, 1)
            vset(state, i, V_EXITS, vget(state, i, V_EXITS) +% 1)
            let code: u64 = vmcb.rd(b, vmcb.C_EXITCODE)
            vset(state, i, V_LAST, code)
            let r: u64 = handle(state, i, b, block, code)
            let t2: u64 = tsc()
            bump(state, S_CYC_EXIT, t2 -% t1)
            if r != R_MORE {
                out = r
                lauf = false
            }
        }
    }
    vset(state, i, V_BUDGET, budget)
    if out == R_DONE {
        vset(state, i, V_STATE, ST_DONE)
    }
    if out == R_HALT {
        vset(state, i, V_STATE, ST_HALT)
    }
    if out == R_SHUTDOWN || out == R_EXC || out == R_ERR || out == R_FAULT {
        vset(state, i, V_STATE, ST_DEAD)
        vset(state, i, V_WHY, out)
        bump(state, S_KILLED, 1)
    }
    return out
}

// Den Austrittsgrund in einen Zaehler stecken. Die Gruende sind Bereiche,
// keine einzelnen Zahlen -- 0x00..0x0F ist "irgendein Steuerregister
// gelesen", 0x40..0x5F "irgendeine Ausnahme".
fn bucket(code: u64) -> u64 {
    if code == vmcb.X_ERR {
        return B_ERR
    }
    if code == vmcb.X_NPF {
        return B_NPF
    }
    if code <= 0x00F {
        return B_CRRD
    }
    if code <= 0x01F {
        return B_CRWR
    }
    if code >= 0x040 && code <= 0x05F {
        return B_EXC
    }
    if code == vmcb.X_INTR {
        return B_INTR
    }
    if code == vmcb.X_CPUID {
        return B_CPUID
    }
    if code == vmcb.X_HLT {
        return B_HLT
    }
    if code == vmcb.X_IOIO {
        return B_IOIO
    }
    if code == vmcb.X_MSR {
        return B_MSR
    }
    if code == vmcb.X_SHUTDOWN {
        return B_SHUTDOWN
    }
    if code == vmcb.X_VMMCALL {
        return B_VMMCALL
    }
    return B_OTHER
}

fn skip(b: u64, n: u64) {
    vmcb.wr(b, vmcb.S_RIP, vmcb.rd(b, vmcb.S_RIP) +% n)
}

// ----------------------------------------------------- die Austritte
//
// Gibt R_MORE zurueck, wenn der Gast weiterlaufen darf.
// RUNDE HV3: DIE AUSTRITTE EINES GASTS MITSCHREIBEN.
//
// Ein Gastsystem, das stirbt, tut das nach einer Kette von Austritten,
// und die Kette ist die Auskunft. Beim Wort `gastspur` druckt der Wirt
// jeden Austritt mit Grund und RIP -- das ist laut, deshalb ist es ein
// eigenes Wort und nicht die Vorgabe.
// Welches MSR ein Gast angefasst hat. Beim Wort `gastspur` -- die
// Nummer allein ist die Auskunft, an der ein Gastsystem haengt.
fn msr_spur(state: u64, nr: u64, write: bool) {
    var s_m: [u8; 10] = "hv: msr \0\0"
    var s_w: [u8; 3] = "wr\0"
    if !on(state, M_SPUR) {
        return
    }
    serial.puts((&s_m[0]) as u64)
    serial.hex(nr)
    serial.put(32 as u8)
    if write {
        serial.puts((&s_w[0]) as u64)
    }
    serial.nl()
}

fn spur(state: u64, b: u64, code: u64) {
    var s_p: [u8; 9] = "hv: sp \0\0"
    var s_c: [u8; 3] = "c\0\0"
    var s_r: [u8; 4] = "rip\0"
    var s_1: [u8; 3] = "i1\0"
    var s_2: [u8; 3] = "i2\0"
    if !on(state, M_SPUR) {
        return
    }
    serial.puts((&s_p[0]) as u64)
    kx((&s_c[0]) as u64, code)
    kx((&s_r[0]) as u64, vmcb.rd(b, vmcb.S_RIP))
    kx((&s_1[0]) as u64, vmcb.rd(b, vmcb.C_EXITINFO1))
    kx((&s_2[0]) as u64, vmcb.rd(b, vmcb.C_EXITINFO2))
    serial.nl()
}

fn handle(state: u64, i: u64, b: u64, block: u64, code: u64) -> u64 {
    spur(state, b, code)
    count(state, bucket(code))

    if code == vmcb.X_ERR {
        // Der Prozessor hat den Eintritt selbst zurueckgewiesen. Eine
        // Adressraumkennung von 0, ein verbotenes Bit in CR0, eine
        // Bitkarte jenseits des Speichers -- der Gast ist nie gelaufen.
        set(state, S_LASTERR, vmcb.rd(b, vmcb.C_EXITINFO1))
        return R_ERR
    }
    if code == vmcb.X_CPUID {
        do_cpuid(state, b, block)
        skip(b, 2)
        return R_MORE
    }
    if code == vmcb.X_VMMCALL {
        let r: u64 = do_hypercall(state, i, b, block)
        skip(b, 3)
        return r
    }
    if code == vmcb.X_IOIO {
        do_io(state, i, b, block)
        // Bei einem Anschlusszugriff steht der naechste RIP in
        // EXITINFO2. Das ist eine der wenigen Stellen, an denen der
        // Prozessor die Laenge des Befehls verraet, auch ohne "nrip
        // save" -- ueberall sonst muss der Wirt sie kennen.
        vmcb.wr(b, vmcb.S_RIP, vmcb.rd(b, vmcb.C_EXITINFO2))
        return R_MORE
    }
    if code == vmcb.X_MSR {
        do_msr(state, b, block)
        skip(b, 2)
        return R_MORE
    }
    if code == vmcb.X_HLT {
        skip(b, 1)
        // EIN GAST MIT UHR HAELT NICHT FUER IMMER. Wer hier immer
        // R_HALT gibt, nimmt einem echten Linux den Hochlauf: es
        // legt sich nach dem Freischalten der Unterbrechungen mit
        // `hlt` hin und wartet auf den naechsten Takt. Laesst der
        // Gast Unterbrechungen zu, laeuft er also weiter und bekommt
        // den Takt beim naechsten Eintritt. Nur ein Gast, der sie
        // ABGESCHALTET hat, meint das `hlt` endgueltig.
        if (vmcb.rd(b, vmcb.S_RFLAGS) & 0x200) != 0 {
            return R_MORE
        }
        return R_HALT
    }
    if code == vmcb.X_INTR {
        // Der Wirt hat seinen Prozessor zurueck, und mehr ist hier nicht
        // zu tun: `stgi` am Ende von `hv_vmrun` macht das globale
        // Unterbrechungsflag wieder auf, und das IF des Wirts kam beim
        // Austritt aus dem Rettungsbereich zurueck -- die Unterbrechung
        // wird also noch im Stumpf zugestellt, bevor diese Zeile laeuft.
        // Der Gast hat davon nichts gesehen und laeuft weiter.
        return R_MORE
    }
    if code == vmcb.X_NPF {
        return do_npf(state, i, b)
    }
    if code == vmcb.X_SHUTDOWN {
        return R_SHUTDOWN
    }
    if code >= 0x010 && code <= 0x01F {
        return do_crwrite(state, i, b, block, code -% 0x010)
    }
    if code >= 0x040 && code <= 0x05F {
        return R_EXC
    }
    return R_EXC
}

// ------------------------------------- was der Gast ueber die Maschine hoert
//
// Der Wirt LUEGT hier, und das ist der Zweck der Uebung: der Gast soll
// nicht erfahren, auf welchem Rechner er wirklich liegt, und er soll
// keine Faehigkeit sehen, die der Wirt ihm nicht nachbauen kann. Was er
// hoert, ist eine Maschine, die es nicht gibt -- aber eine, die in sich
// stimmt.
fn do_cpuid(state: u64, b: u64, block: u64) {
    let leaf: u64 = vmcb.rd(b, vmcb.S_RAX) & 0xFFFFFFFF
    var a: u64 = 0
    var bx: u64 = 0
    var c: u64 = 0
    var d: u64 = 0
    if leaf == 0 {
        a = 1
        bx = 0x6D75734F // "Osum"
        d = 0x65707948 // "Hype"
        c = 0x73697672 // "rvis"
    }
    if leaf == 1 {
        // Familie 6, Modell 1, Stufe 0 -- eine Zahl, die niemanden
        // ueberrascht. Bit 31 von ecx ist die eine Wahrheit, die jeder
        // Wirt sagen soll: hier laeuft etwas unter dir.
        a = 0x00000601
        c = 0x80000000
        // FPU, TSC, MSR, PAE, CX8, PGE, CMOV, FXSR -- nichts, was
        // dieser Wirt nicht durchreichen koennte.
        d = 1 | 16 | 32 | 64 | 256 | 8192 | 32768 | 16777216
    }
    if leaf == 0x40000000 {
        a = 0x40000001
        bx = 0x6D75734F
        c = 0x65707948
        d = 0x73697672
    }
    vmcb.wr(b, vmcb.S_RAX, a)
    gpr_set(block, G_RBX, bx)
    gpr_set(block, G_RCX, c)
    gpr_set(block, G_RDX, d)
}

// ----------------------------------------------------- Ein- und Ausgabe
//
// EXITINFO1 sagt alles, was man braucht, und zwar architektonisch --
// hier muss nichts geraten und nichts nachgelesen werden:
//   Bit 0     0 = hinaus, 1 = herein
//   Bit 2     Zeichenkettenbefehl
//   Bit 3     mit REP
//   Bit 4/5/6 ein, zwei oder vier Oktette
//   Bit 16..  der Anschluss
// RUNDE HV2, STUFE 3: HIER STEHEN JETZT GERAETE.
//
// Bis zur Runde K12 hatte ein Gast genau EINE Richtung: schreiben auf
// 0x3F8 wurde weitergereicht, und jedes Lesen lieferte den offenen Bus.
// Das reicht fuer einen Gast, der nur reden will. Ein Betriebssystem
// PRUEFT aber erst und benutzt dann -- und ein Geraet, das auf jede
// Frage 0xFF sagt, gilt ihm als nicht vorhanden. Beim seriellen
// Anschluss ist 0xFF sogar ausdruecklich toedlich: Linux' Treiber
// haelt den Anschluss dann fuer defekt und gibt ihn auf.
//
// Von hier an beantwortet `vdev.fi` die Anschluesse, die es kennt --
// serielle Schnittstelle, Unterbrechungsverteiler, Zeitgeber -- und
// alles Uebrige bleibt der offene Bus wie zuvor.
fn do_io(state: u64, i: u64, b: u64, block: u64) {
    let info: u64 = vmcb.rd(b, vmcb.C_EXITINFO1)
    let port: u64 = (info >> 16) & 0xFFFF
    let herein: bool = (info & 1) != 0
    bump(state, S_IOPORTS, 1)
    let vb: u64 = vdev_base(state)
    var s_pre: [u8; 7] = "gast| \0"

    if !herein {
        let wert: u64 = vmcb.rd(b, vmcb.S_RAX)
        if vdev.claims(port) {
            let vor: u64 = vdev.uart_out_count(state, vb, i)
            vdev.io_write(state, vb, i, port, wert, (&s_pre[0]) as u64)
            // Was die serielle Schnittstelle hinausgegeben hat, zaehlt
            // der Wirt weiter mit -- die Zusagen der Runde K12 haengen
            // an dieser Zahl.
            let nach: u64 = vdev.uart_out_count(state, vb, i)
            if nach > vor {
                bump(state, S_OUT, nach -% vor)
            }
            return
        }
        return
    }

    // Ein Lesen. Kennt ein Geraet den Anschluss, antwortet es; sonst
    // bleibt es beim offenen Bus -- alle Bits gesetzt ist, was ein
    // echter Rechner an einer unbestueckten Adresse liefert.
    var v: u64 = 0xFFFFFFFF
    if vdev.claims(port) {
        v = vdev.io_read(state, vb, i, port)
    }
    let alt: u64 = vmcb.rd(b, vmcb.S_RAX)
    if (info & 16) != 0 {
        vmcb.wr(b, vmcb.S_RAX, (alt & 0xFFFFFFFFFFFFFF00) | (v & 0xFF))
    } else {
        if (info & 32) != 0 {
            vmcb.wr(b, vmcb.S_RAX,
                (alt & 0xFFFFFFFFFFFF0000) | (v & 0xFFFF))
        } else {
            vmcb.wr(b, vmcb.S_RAX, v & 0xFFFFFFFF)
        }
    }
}

// Ein Zeichen des Gasts. Am Zeilenanfang steht, von wem es kommt.
fn guest_putc(state: u64, ch: u64) {
    var s_pre: [u8; 7] = "gast| \0"
    if get(state, S_OUT) == 0 {
        serial.puts((&s_pre[0]) as u64)
    }
    bump(state, S_OUT, 1)
    if ch == 10 {
        serial.nl()
        return
    }
    serial.put(ch as u8)
}

// --------------------------------------------------------------- MSR
//
// EXITINFO1 ist 0 beim Lesen und 1 beim Schreiben; die Nummer steht in
// ecx. Dieser Wirt gibt auf jedes Lesen eine Null und schluckt jedes
// Schreiben -- ausser bei denen, die ein Gast wirklich braucht.
fn do_msr(state: u64, b: u64, block: u64) {
    let write: bool = vmcb.rd(b, vmcb.C_EXITINFO1) != 0
    let nr: u64 = gpr(block, G_RCX) & 0xFFFFFFFF
    bump(state, S_MSRS, 1)
    msr_spur(state, nr, write)
    if write {
        // RUNDE HV3, STUFE 4: DIE MSR, OHNE DIE LINUX NICHT LEBT.
        //
        // Bis zur Runde HV2 nahm dieser Wirt genau EIN Schreiben an:
        // `EFER`. Fuer die kleinen Gaeste reichte das. Ein echter
        // Linux-Kern faellt damit TOT um, und die Messung dieser Runde
        // sagt auf den Befehl genau, woran:
        //
        //   hv: msr 0xc0000101 wr   <- GS_BASE, der Zeiger auf den
        //                              Bereich je Prozessor
        //   hv: msr 0xc0000080      <- EFER lesen
        //   hv: msr 0xc0000080 wr   <- EFER zurueckschreiben
        //   hv: sp c=0x7f           <- SHUTDOWN, dreifacher Fehler
        //
        // ZWEI Fehler stecken darin, und beide toeten fuer sich allein:
        //
        // ERSTENS `GS_BASE`. Linux legt seinen Bereich je Prozessor ab
        // und erreicht ihn ab da NUR ueber `gs:`. Wird das Schreiben
        // geschluckt, bleibt die Basis null, jeder Zugriff je Prozessor
        // greift nach Adresse 0, und der naechste Seitenfehler wird zum
        // dreifachen. Die Basis steht NICHT in einem eigenen Feld --
        // sie ist die Basis des Segments `GS` im Zustandsbereich.
        //
        // ZWEITENS das Lesen. Ein Wirt, der auf jedes Lesen 0 gibt,
        // luegt den Gast an: Linux liest `EFER`, aendert EIN Bit und
        // schreibt zurueck. Bekommt es 0, loescht dieses Zurueckschreiben
        // `LME` -- mitten im langen Modus. Deshalb liefert das Lesen
        // unten die WIRKLICHEN Werte aus dem Steuerblock.
        let v: u64 = (vmcb.rd(b, vmcb.S_RAX) & 0xFFFFFFFF)
            | (gpr(block, G_RDX) << 32)
        if nr == MSR_EFER {
            // GEGENPROBE `ohnelme`: das Schreiben wird geschluckt wie
            // frueher. Der Gast bleibt dann 32 Bit, und die Zusage
            // darueber MUSS zusammenbrechen.
            if !on(state, M_NOLME) {
                // `SVME` gehoert dem Wirt und muss stehen bleiben
                // (AMD APM 15.5.1). `LMA` ist NUR-LESE -- der Prozessor
                // setzt es selbst; wer es aus `v` uebernaehme, liesse
                // den Gast seinen eigenen Zustand faelschen. Beide
                // werden deshalb aus dem ALTEN Wert getragen.
                let maske: u64 = vmcb.EFER_LME | vmcb.EFER_NXE
                    | vmcb.EFER_SCE
                let alt: u64 = vmcb.rd(b, vmcb.S_EFER)
                let rest: u64 = 0xFFFFFFFFFFFFFFFF ^ maske
                vmcb.wr(b, vmcb.S_EFER,
                    (alt & rest) | (v & maske) | vmcb.EFER_SVME)
                bump(state, S_EFERW, 1)
            }
            return
        }
        // Der Bereich je Prozessor. OHNE DIESE DREI STARTET LINUX NICHT.
        if nr == MSR_GS_BASE {
            vmcb.wr(b, vmcb.S_GS +% 8, v)
            bump(state, S_MSRW, 1)
            return
        }
        if nr == MSR_FS_BASE {
            vmcb.wr(b, vmcb.S_FS +% 8, v)
            bump(state, S_MSRW, 1)
            return
        }
        if nr == MSR_KGS_BASE {
            vmcb.wr(b, vmcb.S_KGSBASE, v)
            bump(state, S_MSRW, 1)
            return
        }
        // Die vier fuer `syscall`/`sysret`. Linux setzt sie frueh; ohne
        // sie faellt der erste Systemaufruf ins Leere.
        if nr == MSR_STAR {
            vmcb.wr(b, vmcb.S_STAR, v)
            bump(state, S_MSRW, 1)
            return
        }
        if nr == MSR_LSTAR {
            vmcb.wr(b, vmcb.S_LSTAR, v)
            bump(state, S_MSRW, 1)
            return
        }
        if nr == MSR_CSTAR {
            vmcb.wr(b, vmcb.S_CSTAR, v)
            bump(state, S_MSRW, 1)
            return
        }
        if nr == MSR_SFMASK {
            vmcb.wr(b, vmcb.S_SFMASK, v)
            bump(state, S_MSRW, 1)
            return
        }
        // Alles Uebrige wird weiter geschluckt -- aber GEZAEHLT, damit
        // der naechste Gast, der an einem fehlenden MSR stirbt, nicht
        // wieder gesucht werden muss.
        bump(state, S_MSRIGN, 1)
        return
    }
    // ------------------------------------------------ das Lesen
    //
    // Was hier steht, ist das, was der Gast WIRKLICH gesetzt hat. Eine
    // 0 zurueckzugeben ist kein harmloser Platzhalter: sie zerstoert
    // jedes Lesen-Aendern-Schreiben des Gasts.
    var v: u64 = 0
    if nr == MSR_EFER {
        v = vmcb.rd(b, vmcb.S_EFER)
    }
    if nr == MSR_GS_BASE {
        v = vmcb.rd(b, vmcb.S_GS +% 8)
    }
    if nr == MSR_FS_BASE {
        v = vmcb.rd(b, vmcb.S_FS +% 8)
    }
    if nr == MSR_KGS_BASE {
        v = vmcb.rd(b, vmcb.S_KGSBASE)
    }
    if nr == MSR_STAR {
        v = vmcb.rd(b, vmcb.S_STAR)
    }
    if nr == MSR_LSTAR {
        v = vmcb.rd(b, vmcb.S_LSTAR)
    }
    if nr == MSR_CSTAR {
        v = vmcb.rd(b, vmcb.S_CSTAR)
    }
    if nr == MSR_SFMASK {
        v = vmcb.rd(b, vmcb.S_SFMASK)
    }
    if nr == 0x10 {
        v = tsc() // die Uhr des Gasts ist die des Wirts
    }
    vmcb.wr(b, vmcb.S_RAX, v & 0xFFFFFFFF)
    gpr_set(block, G_RDX, v >> 32)
}

// ------------------------------------------------- ein Seitenfehler des Gasts
//
// EXITINFO2 traegt die GASTPHYSISCHE Adresse, EXITINFO1 die Gruende
// (Bit 0: es war eine Rechteverletzung und keine fehlende Seite).
//
// Gehoert die Adresse zum Speicher der Maschine, legt der Wirt einen
// Rahmen unter und laesst weiterlaufen. Gehoert sie nicht dazu, ist der
// Gast an eine Wand gelaufen, die es fuer ihn nicht geben sollte -- und
// dann ist die Maschine hin, der Wirt aber nicht.
fn do_npf(state: u64, i: u64, b: u64) -> u64 {
    let gpa: u64 = vmcb.rd(b, vmcb.C_EXITINFO2)
    if npt_map(state, i, gpa) {
        bump(state, S_NPFS, 1)
        return R_MORE
    }
    set(state, S_LASTNPF, gpa)
    return R_FAULT
}

// ----------------------------------------------- Schreiben auf ein Steuerregister
//
// OHNE "decode assists" sagt der Prozessor NICHT, aus welchem Register
// der Wert kam. Der Wirt muss den Befehl selbst aus dem Gastspeicher
// holen und lesen. Das geht, solange der Gast noch kein eigenes Paging
// hat -- dann ist gastlinear gleich gastphysisch, und die
// verschachtelte Tabelle sagt, wo die Seite wirklich liegt. Hat der Gast
// sein Paging schon an, muesste der Wirt ausserdem SEINE Tabellen
// laufen; das tut diese Runde nicht, und sie sagt es, statt es zu
// verschweigen.
fn do_crwrite(state: u64, i: u64, b: u64, block: u64, nr: u64) -> u64 {
    bump(state, S_CRS, 1)
    let len: u64 = decode_movcr(state, i, b, block, nr)
    if len == 0 {
        bump(state, S_DECFAIL, 1)
        return R_EXC
    }
    skip(b, len)
    return R_MORE
}

// Liest bis zu vier Oktette Gastcode an RIP und deutet sie als
// `mov CRn, r32` (0F 22 /r). Gibt die Laenge zurueck, oder 0.
fn decode_movcr(state: u64, i: u64, b: u64, block: u64, nr: u64) -> u64 {
    let cr0: u64 = vmcb.rd(b, vmcb.S_CR0)
    if (cr0 & 0x80000000) != 0 {
        return 0 // der Gast hat sein eigenes Paging an: hier nicht
    }
    let lin: u64 = vmcb.seg_base(b, vmcb.S_CS) +% vmcb.rd(b, vmcb.S_RIP)
    var off: u64 = 0
    var op: u64 = 0
    // Vorsatzoktette ueberspringen. Ein `mov cr` traegt oft 0x66 oder
    // 0x67, weil der Uebersetzer im Realmodus 32-Bit-Register meint.
    var weiter: bool = true
    while weiter {
        op = guest_byte(state, i, lin +% off)
        if op == 0x66 || op == 0x67 || op == 0xF0 || op == 0x2E
            || op == 0x36 || op == 0x3E || op == 0x26 {
            off = off +% 1
            if off > 4 {
                return 0
            }
        } else {
            weiter = false
        }
    }
    if op != 0x0F {
        return 0
    }
    if guest_byte(state, i, lin +% off +% 1) != 0x22 {
        return 0
    }
    let modrm: u64 = guest_byte(state, i, lin +% off +% 2)
    if (modrm & 0xC0) != 0xC0 {
        return 0
    }
    if ((modrm >> 3) & 7) != nr {
        return 0
    }
    let reg: u64 = modrm & 7
    var v: u64 = 0
    if reg == 0 {
        v = vmcb.rd(b, vmcb.S_RAX)
    }
    if reg == 3 {
        v = gpr(block, G_RBX)
    }
    if reg == 1 {
        v = gpr(block, G_RCX)
    }
    if reg == 2 {
        v = gpr(block, G_RDX)
    }
    if reg == 5 {
        v = gpr(block, G_RBP)
    }
    if reg == 6 {
        v = gpr(block, G_RSI)
    }
    if reg == 7 {
        v = gpr(block, G_RDI)
    }
    v = v & 0xFFFFFFFF
    if nr == 0 {
        // RUNDE HV2: WER CR0 FUER DEN GAST SCHREIBT, MUSS AUCH LMA
        // NACHZIEHEN -- und das ist die Falle, die diese Stufe gekostet
        // hat.
        //
        // Fuehrt der GAST selbst `mov reg, cr0` mit PG aus und steht
        // EFER.LME, dann setzt DER PROZESSOR EFER.LMA dazu: das ist der
        // Augenblick, in dem der lange Modus aktiv wird. Faengt der
        // Wirt den Befehl aber ab und schreibt den Wert selbst in das
        // VMCB-Feld, geschieht das NICHT -- er hat nur ein Feld
        // beschrieben, und kein Prozessor hat etwas ausgefuehrt.
        //
        // Beim naechsten Eintritt steht dann CR0.PG=1, CR4.PAE=1,
        // EFER.LME=1 und EFER.LMA=0. Das ist ein UNGUELTIGER
        // GASTZUSTAND (AMD APM Band 2, 15.5.1), und der Gast stirbt --
        // gemessen als zweiter SHUTDOWN, der aussah wie ein Fehler des
        // Gasts und keiner war. Genau hier trennt sich ein Wirt, der
        // Steuerregister abfaengt, von einem, der es nur vorhat.
        let efer: u64 = vmcb.rd(b, vmcb.S_EFER)
        if (v & vmcb.CR0_PG) != 0 && (efer & vmcb.EFER_LME) != 0 {
            vmcb.wr(b, vmcb.S_EFER, efer | vmcb.EFER_LMA)
        }
        if (v & vmcb.CR0_PG) == 0 {
            // Und andersherum: faellt das Paging, faellt auch LMA.
            let rest: u64 = 0xFFFFFFFFFFFFFFFF ^ vmcb.EFER_LMA
            vmcb.wr(b, vmcb.S_EFER, efer & rest)
        }
        vmcb.wr(b, vmcb.S_CR0, v)
    }
    if nr == 3 {
        vmcb.wr(b, vmcb.S_CR3, v)
    }
    if nr == 4 {
        vmcb.wr(b, vmcb.S_CR4, v)
    }
    return off +% 3
}

// Ein Oktett aus dem Speicher des Gasts, ueber die verschachtelte
// Tabelle -- also genau so, wie der Gast es sehen wuerde.
fn guest_byte(state: u64, i: u64, gpa: u64) -> u64 {
    let ram: u64 = vget(state, i, V_RAM)
    let pages: u64 = vget(state, i, V_PAGES)
    if (gpa >> 12) >= pages {
        return 0
    }
    return kstate.get8(ram +% gpa)
}

// ------------------------------------------------------------ der Hypercall

fn do_hypercall(state: u64, i: u64, b: u64, block: u64) -> u64 {
    let cmd: u64 = vmcb.rd(b, vmcb.S_RAX) & 0xFFFFFFFF
    let arg: u64 = gpr(block, G_RBX) & 0xFFFFFFFF
    let nr: u64 = gpr(block, G_RCX) & 0xFFFFFFFF
    bump(state, S_CALLS, 1)
    if cmd == 1 {
        value_put(state, nr, arg)
        return R_MORE
    }
    if cmd == 2 {
        vset(state, i, V_RESULT, arg)
        vset(state, i, V_DONE, 1)
        return R_DONE
    }
    if cmd == 3 {
        // "Wirf mir eine Unterbrechung ein." EVENTINJ, Art 0 (eine
        // aeussere Unterbrechung), Vektor 0x20, gueltig. Der Prozessor
        // stellt sie beim naechsten Eintritt zu -- vor dem naechsten
        // Befehl des Gasts, und ohne dass der Gast sie erwarten muesste.
        vmcb.wr(b, vmcb.C_EVENTINJ, 0x20 | (0 << 8) | 0x80000000)
        bump(state, S_INJ, 1)
        return R_MORE
    }
    return R_MORE
}

// ====================================================================
//                          DIE MESSUNG
// ====================================================================
//
// Was hier ausgegeben wird, ist die Runde. `tools/hv/run.sh` liest jede
// dieser Zeilen EINZELN nach -- eine Sammelzahl allein waere zu leicht,
// und ein Gast, der "nicht abstuerzt", ist kein Beweis fuer irgendetwas.

// DIE ZUSAGE, AN DER DER WELTWECHSEL HAENGT. `vmrun` sichert MSR_LSTAR
// NICHT (AMD APM 15.5.1, und QEMU tut es genauso -- helper_vmrun laedt
// nur ES/CS/SS/DS). Wer `vmsave`/`vmload` weglaesst, gibt dem Gast die
// Systemaufruf-Einsprungadresse des Wirts und bekommt die des Gasts
// zurueck; der naechste `syscall` aus Ring 3 springt dann irgendwohin.
// Diese Zeile liest sie zurueck und vergleicht sie mit dem, was
// `user.setup` hineingeschrieben hat.
const MSR_LSTAR: u64 = 0xC0000082
const V_SYSCALL: u64 = 48 // Platz in der Tabelle aus isr.s

fn host_intact(state: u64) -> bool {
    return rdmsr(MSR_LSTAR) == vector(state, V_SYSCALL)
}

fn say(p: u64) {
    serial.puts(p)
}

fn kv(name: u64, v: u64) {
    var s_eq: [u8; 2] = "=\0"
    var s_sp: [u8; 2] = " \0"
    serial.puts(name)
    serial.puts((&s_eq[0]) as u64)
    serial.dec(v)
    serial.puts((&s_sp[0]) as u64)
}

fn kx(name: u64, v: u64) {
    var s_eq: [u8; 2] = "=\0"
    var s_sp: [u8; 2] = " \0"
    serial.puts(name)
    serial.puts((&s_eq[0]) as u64)
    serial.hex(v)
    serial.puts((&s_sp[0]) as u64)
}

fn yesno(name: u64, b: bool) {
    var s_eq: [u8; 2] = "=\0"
    var s_y: [u8; 5] = "yes \0"
    var s_n: [u8; 4] = "no \0"
    serial.puts(name)
    serial.puts((&s_eq[0]) as u64)
    if b {
        serial.puts((&s_y[0]) as u64)
    } else {
        serial.puts((&s_n[0]) as u64)
    }
}

// Eine Zahl gegen eine Erwartung. Das ist die Form, in der diese Runde
// ihre Zusagen macht: nicht "es lief", sondern "es kam GENAU das heraus".
fn zusage(name: u64, ist: u64, soll: u64) -> u64 {
    var s_ok: [u8; 9] = "hv: OK  \0"
    var s_no: [u8; 9] = "hv: BAD \0"
    var s_ist: [u8; 9] = "  ist=0x\0"
    var s_soll: [u8; 10] = "  soll=0x\0"
    if ist == soll {
        serial.puts((&s_ok[0]) as u64)
        serial.puts(name)
        serial.nl()
        return 1
    }
    serial.puts((&s_no[0]) as u64)
    serial.puts(name)
    serial.puts((&s_ist[0]) as u64)
    serial.hex(ist)
    serial.puts((&s_soll[0]) as u64)
    serial.hex(soll)
    serial.nl()
    return 0
}

fn zusage_true(name: u64, b: bool) -> u64 {
    if b {
        return zusage(name, 1, 1)
    }
    return zusage(name, 0, 1)
}

// Einen Gast anlegen, laufen lassen, und sagen, was dabei herauskam.
fn lauf(state: u64, guest: u64, name: u64) -> u64 {
    var s_run: [u8; 12] = "hv: guest \0\0"
    var s_slot: [u8; 6] = "slot\0\0"
    var s_ex: [u8; 6] = "exits\0"
    var s_out: [u8; 4] = "out\0"
    var s_res: [u8; 7] = "result\0"
    var s_st: [u8; 6] = "state\0"
    var s_cyc: [u8; 7] = "cycles\0"
    let vm: u64 = vm_create(state, guest, 0)
    if vm >= MAX_VMS {
        return MAX_VMS
    }
    let before: u64 = get(state, S_CYC_RUN)
    let r: u64 = vm_run(state, vm)
    serial.puts((&s_run[0]) as u64)
    serial.puts(name)
    serial.put(32 as u8)
    kv((&s_slot[0]) as u64, vm)
    kv((&s_ex[0]) as u64, vm_exits(state, vm))
    kv((&s_out[0]) as u64, r)
    kx((&s_res[0]) as u64, vm_result(state, vm))
    kv((&s_st[0]) as u64, vm_state(state, vm))
    kv((&s_cyc[0]) as u64, get(state, S_CYC_RUN) -% before)
    serial.nl()
    return vm
}

// ====================================================================
//         RUNDE HV3: DEN LINUX-GAST ANLEGEN, LADEN UND STARTEN
// ====================================================================
//
// Das ist die Stelle, an der die Stufen 4 und 5 zusammenkommen. Der
// Ablauf ist genau der eines Bootladers, und jeder Schritt hat eine
// Zahl, die der Laeufer nachliest:
//
//   1. Den Kopf lesen und PRUEFEN    -> `bzload.check`, 0 = in Ordnung
//   2. Ausrechnen, wie viel Speicher  -> `bzload.need_bytes`
//   3. Die Maschine anlegen           -> `vm_create_big`
//   4. Das Abbild umlagern            -> `bzload.load`
//   5. Die Zero-Page bauen            -> `bzload.zeropage`
//   6. Den Gastzustand hinschreiben   -> `linux_state`
//   7. Laufen lassen                  -> `vm_run`
//
// WARUM DAS SO VIELE ZAHLEN MELDET. Ein Linux, das nichts sagt, kann an
// sieben Stellen gescheitert sein, und ohne Zwischenzahlen sucht man an
// der falschen. Der Bericht der Runde HV2 hat genau daran eine Stunde
// verloren (Abschnitt 5b), und die Lehre steht hier als Code.

// ====================================================================
//   RUNDE HV3: DER LADEWEG, GEPRUEFT OHNE EIN OKTETT LINUX
// ====================================================================
//
// Der Bericht der Runde HV2 nennt das in Abschnitt 11 als naechsten
// Schritt, und der Grund ist gut: der Ladeweg ist eine Rechnung ueber
// einen Kopf und eine Seite Speicher. Dafuer braucht es kein Linux --
// es braucht einen KOPF, der aussieht wie der eines Linux. Den baut
// diese Funktion selbst, Feld fuer Feld, aus der Festlegung.
//
// WAS DAS WERT IST. Diese sieben Zusagen laufen auf JEDER Maschine,
// auch auf einer ohne Boot-Modul -- also in jedem Lauf von
// `tools/hv/run.sh`. Die Zusagen ueber das echte Linux laufen nur, wo
// eines danebenliegt. Wer den Ladeweg kaputtmacht, wird deshalb hier
// erwischt und nicht erst dort.
fn zp_selftest(state: u64) {
    var s_h: [u8; 9] = "hv: zp: \0"
    var s_c: [u8; 6] = "check\0"
    var s_n: [u8; 5] = "need\0"
    var s_e: [u8; 6] = "e820\0\0"
    var s_p: [u8; 4] = "ent\0"

    // Zwei Rahmen: einer fuer das Abbild, einer fuer den "Gastspeicher",
    // in dem die Zero-Page gebaut wird. Der Gastspeicher muss so gross
    // ausgegeben werden, dass `zeropage` seine Adressen darin
    // unterbringt -- also wird er nur BEHAUPTET gross und in
    // Wirklichkeit reicht die eine Seite fuer die Zero-Page. Deshalb
    // baut dieser Selbsttest die Zero-Page an ihrer ECHTEN Stelle in
    // einem Lauf von 20 Seiten.
    let img: u64 = mem.frame_alloc(state)
    let gram: u64 = mem.frame_run(state, 36) // bis 0x12000 hinein
    if img == 0 || gram == 0 {
        if img != 0 {
            mem.frame_free(state, img)
        }
        return
    }
    vmcb.zero_page(img)
    var z: u64 = 0
    while z < 36 {
        vmcb.zero_page(gram +% z *% 4096)
        z = z +% 1
    }

    // ---- EIN KOPF, WIE DIE FESTLEGUNG IHN VERLANGT -----------------
    //
    // Nur die Felder, auf die der Ladeweg schaut. Jede Zahl steht hier
    // als Zahl, damit die Probe unabhaengig von `bzload.fi` ist: wuerde
    // sie dieselben Konstanten benutzen, pruefte sie nichts.
    __mmio_write16((img +% 0x1FE) as *mut u16, 0xAA55 as u16) // boot_flag
    __mmio_write8((img +% 0x1F1) as *mut u8, 1 as u8) // setup_sects
    __mmio_write8((img +% 0x201) as *mut u8, 0x6A as u8) // jump
    // "HdrS", kleinendig
    __mmio_write8((img +% 0x202) as *mut u8, 0x48 as u8)
    __mmio_write8((img +% 0x203) as *mut u8, 0x64 as u8)
    __mmio_write8((img +% 0x204) as *mut u8, 0x72 as u8)
    __mmio_write8((img +% 0x205) as *mut u8, 0x53 as u8)
    __mmio_write16((img +% 0x206) as *mut u16, 0x020F as u16) // version
    __mmio_write8((img +% 0x211) as *mut u8, 1 as u8) // loadflags
    __mmio_write32((img +% 0x230) as *mut u32, 0x200000 as u32) // align
    __mmio_write8((img +% 0x234) as *mut u8, 1 as u8) // relocatable
    __mmio_write16((img +% 0x236) as *mut u16, 0x000F as u16) // xloadflags
    __mmio_write32((img +% 0x238) as *mut u32, 2047 as u32) // cmdline_size
    __mmio_write64((img +% 0x258) as *mut u64, 0x1000000) // pref_address
    __mmio_write32((img +% 0x260) as *mut u32, 0x400000 as u32) // init_size
    // Ein Oktett im Kopfbereich, das beim Kopieren mitkommen MUSS.
    // Hieran zeigt sich, ob der Kopf als GANZES uebernommen wurde.
    __mmio_write8((img +% 0x1F5) as *mut u8, 0xC7 as u8)

    // Das Abbild ist 1024 Oktette lang; der entpackte Teil faengt bei
    // (1 + 1) * 512 = 1024 an -- damit waere er leer. Also einen Rahmen
    // lang machen, dann sind es 4096 - 1024 = 3072 Oktette.
    let ilen: u64 = 4096

    let chk: u64 = bzload.check(img, ilen)
    value_put(state, 30, chk)

    // ---- UND EIN ABBILD, DAS ES NICHT IST --------------------------
    //
    // Dieselbe Seite, aber "HdrS" zerstoert. Der Ladeweg MUSS es
    // abweisen, und zwar mit dem Grund 3 -- nicht stillschweigend.
    // Ohne diese Gegenprobe pruefte `check` nichts.
    __mmio_write8((img +% 0x202) as *mut u8, 0x00 as u8)
    value_put(state, 31, bzload.check(img, ilen))
    __mmio_write8((img +% 0x202) as *mut u8, 0x48 as u8) // zurueck

    // ---- DIE ZERO-PAGE ---------------------------------------------
    let cmdp: u64 = state +% HV_OFF +% S_CMDBUF
    linux_cmdline(cmdp)
    let e820: u64 = bzload.zeropage(gram, 36 *% 4096, img, cmdp, 0, 0)
    let zp: u64 = gram +% bzload.G_ZEROPAGE
    value_put(state, 32, bzload.zp_e820_entries(zp))
    value_put(state, 33, bzload.zp_loader(zp))
    value_put(state, 34, bzload.zp_cmdline_ptr(zp))
    // Ist der Kopf als GANZES mitgekommen? Das Oktett bei 0x1F5.
    var mit: u64 = 0
    if kstate.get8(zp +% 0x1F5) == 0xC7 {
        mit = 1
    }
    value_put(state, 35, mit)
    // Und liegt der Einsprung genau 0x200 hinter der Ladeadresse?
    var ent_ok: u64 = 0
    if bzload.entry_of(img, ilen) == bzload.plan(img, ilen) +% 0x200 {
        ent_ok = 1
    }
    value_put(state, 36, ent_ok)

    serial.puts((&s_h[0]) as u64)
    kv((&s_c[0]) as u64, chk)
    kv((&s_n[0]) as u64, bzload.need_bytes(img, ilen))
    kv((&s_e[0]) as u64, e820)
    kx((&s_p[0]) as u64, bzload.entry_of(img, ilen))
    serial.nl()

    mem.frame_free(state, img)
    mem.frame_free_run(state, gram, 36)
}

// Die Kommandozeile, die der Gast bekommt. `earlyprintk=serial` ist das
// Wort, an dem diese Runde haengt: es laesst Linux auf der SERIELLEN
// SCHNITTSTELLE reden, BEVOR es seine eigenen Treiber hat -- also durch
// die 16550A-Emulation aus der Runde HV2. Ohne dieses Wort schweigt
// selbst ein Kern, der laeuft.
//
// `console=ttyS0` deckt die Zeit danach ab, `keep_bootcon` verhindert,
// dass der Kern die fruehe Konsole abmeldet, sobald er die spaete
// gefunden hat.
fn linux_cmdline(p: u64) -> u64 {
    // `nokaslr` IST HIER KEINE BEQUEMLICHKEIT, SONDERN GEMESSEN. Der
    // erste Lauf dieser Runde gab dem Gast 73 MiB -- genau
    // `init_size` plus ein Mebioctet --, und Linux' Entpacker sagte
    // woertlich:
    //
    //   "Invalid physical address chosen!"
    //   "Physical KASLR disabled: no suitable memory region!"
    //
    // Die zufaellige Verschiebung des Kerns sucht eine FREIE Stelle
    // von `init_size` Oktetten IRGENDWO im Speicher -- in einem Gast,
    // der nur so gross ist wie der Kern selbst, gibt es keine. Das
    // Wort schaltet sie ab; der Gast bekommt ausserdem mehr Speicher
    // (siehe `linux_boot`), damit die Abschaltung nicht der einzige
    // Grund ist, warum es geht.
    // `panic=-1` IST DIE ABBRUCHBEDINGUNG DER MESSUNG. Ohne eine
    // Wurzel kommt dieses Linux bis `prepare_namespace` und bleibt
    // dann im Panikzustand MIT eingeschalteten Unterbrechungen
    // stehen -- es lief also weiter, ohne noch etwas zu sagen, und
    // der Wirt haette es bis zum Zeitlimit hereingeholt. Mit dem
    // Wort startet es sich selbst neu, und der Wirt sieht den
    // Dreifachfehler als sauberes Ende.
    var t: [u8; 83] =
        "earlyprintk=serial,ttyS0,115200 console=ttyS0,115200 nokaslr keep_bootcon panic=-1\0"
    var n: u64 = 0
    var weiter: bool = true
    while weiter {
        let c: u64 = t[n as usize] as u64
        __mmio_write8((p +% n) as *mut u8, c as u8)
        if c == 0 {
            weiter = false
        } else {
            n = n +% 1
        }
    }
    return n
}

// Wo im Gast die Kommandozeile hingeschrieben wird, bevor sie in den
// Gastspeicher wandert: in die Seite des Wirts, hinter die Werte.
const S_CMDBUF: u64 = 0x0E00 // 256 Oktette in der Seite dieser Runde

fn linux_boot(state: u64, img: u64, len: u64) -> u64 {
    var s_h: [u8; 11] = "hv: linux \0"
    var s_chk: [u8; 6] = "check\0"
    var s_ver: [u8; 4] = "ver\0"
    var s_ss: [u8; 6] = "setup\0"
    var s_pm: [u8; 8] = "pmbytes\0"
    var s_init: [u8; 9] = "initsize\0"
    var s_need: [u8; 5] = "need\0"
    var s_mib: [u8; 4] = "mib\0"
    var s_slot: [u8; 5] = "slot\0"
    var s_load: [u8; 7] = "loaded\0"
    var s_e820: [u8; 6] = "e820\0\0"
    var s_ent: [u8; 6] = "entry\0"
    var s_zp: [u8; 3] = "zp\0"
    var s_ex: [u8; 6] = "exits\0"
    var s_out: [u8; 4] = "out\0"
    var s_st: [u8; 6] = "state\0"
    var s_rip: [u8; 4] = "rip\0"
    var s_code: [u8; 9] = "exitcode\0"
    var s_said: [u8; 6] = "said\0\0"
    // DIE ZAHLEN, MIT DENEN MAN EINEN TOTEN GAST UNTERSUCHT. Ein
    // "es lief nicht" ist keine Auskunft; diese fuenf sagen, WO es
    // nicht lief.
    var s_lnpf: [u8; 8] = "lastnpf\0"
    var s_lcr0: [u8; 4] = "cr0\0"
    var s_lcr3: [u8; 4] = "cr3\0"
    var s_lef: [u8; 5] = "efer\0"
    var s_ldf: [u8; 8] = "decfail\0"

    // 1. DER KOPF. Zuerst und ohne Ausnahme -- ein Abbild, das den Kopf
    //    nicht hat, ist kein bzImage, und alles danach waere Raten.
    let chk: u64 = bzload.check(img, len)
    serial.puts((&s_h[0]) as u64)
    kv((&s_chk[0]) as u64, chk)
    kx((&s_ver[0]) as u64, bzload.hdr_version(img))
    kv((&s_ss[0]) as u64, bzload.hdr_setup_sects(img))
    kv((&s_pm[0]) as u64, bzload.pm_bytes(img, len))
    kv((&s_init[0]) as u64, bzload.hdr_init_size(img))
    if chk != 0 {
        serial.nl()
        value_put(state, 50, chk)
        return MAX_VMS
    }

    // 2. WIE VIEL SPEICHER. `init_size` und nicht die Laenge des
    //    Abbilds -- die Zahl aus Abschnitt 8 der Runde HV2.
    let need: u64 = bzload.need_bytes(img, len)
    // NICHT das Minimum, sondern was der Kern zum ARBEITEN braucht --
    // `want_bytes` sagt, warum, und die Begruendung ist gemessen.
    let mib: u64 = (bzload.want_bytes(img, len) +% 1048575) / 1048576
    kv((&s_need[0]) as u64, need)
    kv((&s_mib[0]) as u64, mib)
    serial.nl()
    value_put(state, 50, 0)
    value_put(state, 51, mib)

    // 3. DIE MASCHINE. Ein Gast dieser Groesse geht nur mit den
    //    2-MiB-Seiten aus Stufe 2 der Runde HV2 -- 73 MiB in Seiten zu
    //    4 KiB waeren 18688 Eintraege in 37 Tabellen.
    let vm: u64 = vm_create_big(state, G_LINUX, 0, mib)
    if vm >= MAX_VMS {
        serial.puts((&s_h[0]) as u64)
        kv((&s_slot[0]) as u64, 99)
        serial.nl()
        return MAX_VMS
    }
    let gram: u64 = vget(state, vm, V_RAM)
    let gbytes: u64 = vget(state, vm, V_PAGES) *% 4096

    // 4. DAS ABBILD UMLAGERN.
    let geladen: u64 = bzload.load(gram, gbytes, img, len)
    value_put(state, 52, geladen)

    // 5. DIE ZERO-PAGE. Die Kommandozeile wird erst in die Seite des
    //    Wirts geschrieben und dann von dort in den Gast kopiert --
    //    `bzload` soll nichts ueber `kdata` wissen muessen.
    let cmdp: u64 = state +% HV_OFF +% S_CMDBUF
    linux_cmdline(cmdp)
    var e820: u64 = 0
    if on(state, M_NOE820) {
        // GEGENPROBE `ohnee820`: eine Zero-Page ohne Speicherbild. Der
        // Kopf steht, die Kommandozeile steht, `type_of_loader` steht
        // -- NUR die Tafel fehlt. Wenn Linux daran scheitert, ist
        // gezeigt, dass sie noetig ist.
        e820 = bzload.zeropage(gram, gbytes, img, cmdp, 0, 0)
        __mmio_write8((gram +% bzload.G_ZEROPAGE
            +% bzload.ZP_E820_ENTRIES) as *mut u8, 0 as u8)
        e820 = 0
    } else {
        e820 = bzload.zeropage(gram, gbytes, img, cmdp, 0, 0)
    }
    value_put(state, 53, e820)

    // 6. DER GASTZUSTAND.
    let entry: u64 = bzload.entry_of(img, len)
    linux_state(state, vm, entry, bzload.G_ZEROPAGE)
    value_put(state, 54, entry)

    serial.puts((&s_h[0]) as u64)
    kv((&s_slot[0]) as u64, vm)
    kv((&s_load[0]) as u64, geladen)
    kv((&s_e820[0]) as u64, e820)
    kx((&s_ent[0]) as u64, entry)
    kx((&s_zp[0]) as u64, bzload.G_ZEROPAGE)
    serial.nl()

    // 7. LAUFEN LASSEN. Von hier an redet der Gast, nicht der Wirt.
    //
    // MEHRERE LAEUFE, NICHT EINER. `vm_run` gibt nach BUDGET Austritten
    // zurueck, damit ein Gast den Wirt nicht auf ewig festhaelt. Ein
    // Linux im Hochlauf braucht aber weit mehr als 4096 Austritte --
    // allein seine Suche nach Geraeten kostet Tausende. Der Wirt holt
    // ihn deshalb wieder herein, solange er FORTSCHRITT macht: mehr
    // gesagt oder mehr Austritte als beim letzten Mal. Bleibt beides
    // stehen, dreht er sich im Kreis, und weiterlaufen zu lassen
    // brächte nichts.
    let vor: u64 = get(state, S_OUT)
    var r: u64 = R_BUDGET
    var runden: u64 = 0
    var still: u64 = 0
    var weiter: bool = true
    while weiter {
        let e0: u64 = vm_exits(state, vm)
        let o0: u64 = get(state, S_OUT)
        vset(state, vm, V_BUDGET, BUDGET)
        r = vm_run(state, vm)
        runden = runden +% 1
        if r != R_BUDGET && r != R_HALT {
            weiter = false
        } else {
            if get(state, S_OUT) == o0 && vm_exits(state, vm) == e0 {
                weiter = false
            } else {
                if get(state, S_OUT) == o0 {
                    still = still +% 1
                } else {
                    still = 0
                }
                // Er tut noch etwas, sagt aber seit vielen Laeufen
                // nichts mehr. Das ist die Stelle, an der ein Gast
                // in einer Schleife steckt, und der Wirt bricht ab,
                // statt die Messung ewig laufen zu lassen.
                if still >= LINUX_STILL {
                    weiter = false
                }
                if runden >= LINUX_RUNDEN {
                    weiter = false
                }
            }
        }
    }
    value_put(state, 57, runden)
    let b: u64 = vget(state, vm, V_VMCB)
    let gesagt: u64 = get(state, S_OUT) -% vor
    serial.nl()
    serial.puts((&s_h[0]) as u64)
    kv((&s_ex[0]) as u64, vm_exits(state, vm))
    kv((&s_out[0]) as u64, r)
    kv((&s_st[0]) as u64, vm_state(state, vm))
    kx((&s_rip[0]) as u64, vmcb.rd(b, vmcb.S_RIP))
    kx((&s_code[0]) as u64, vget(state, vm, V_LAST))
    kv((&s_said[0]) as u64, gesagt)
    kx((&s_lnpf[0]) as u64, get(state, S_LASTNPF))
    kx((&s_lcr0[0]) as u64, vmcb.rd(b, vmcb.S_CR0))
    kx((&s_lcr3[0]) as u64, vmcb.rd(b, vmcb.S_CR3))
    kx((&s_lef[0]) as u64, vmcb.rd(b, vmcb.S_EFER))
    kv((&s_ldf[0]) as u64, get(state, S_DECFAIL))
    serial.nl()
    // WIE VIELE OKTETTE DER GAST GESAGT HAT. Das ist der Erfolgsmass-
    // stab dieser Runde, und er ist eine Zahl: 0 heisst, Linux hat
    // geschwiegen.
    value_put(state, 55, gesagt)
    value_put(state, 56, vm_exits(state, vm))
    // Was diese Stufe gebaut hat, in Zahlen: eingeworfene Takte, wie
    // oft der Gast die Uhr befragt hat, und wie oft den Kanal 2.
    value_put(state, 58, vget(state, vm, V_TICKS))
    value_put(state, 59, vdev.rtc_reads(state, vdev_base(state), vm))
    value_put(state, 60, vdev.p61_reads(state, vdev_base(state), vm))
    return vm
}

// RUNDE HV2: dasselbe wie `lauf`, aber auf einer Maschine mit grossem
// Speicher und einer NPT aus 2-MiB-Seiten.
fn lauf_big(state: u64, guest: u64, name: u64, mib: u64) -> u64 {
    var s_run: [u8; 12] = "hv: guest \0\0"
    var s_slot: [u8; 6] = "slot\0\0"
    var s_ex: [u8; 6] = "exits\0"
    var s_out: [u8; 4] = "out\0"
    var s_res: [u8; 7] = "result\0"
    var s_st: [u8; 6] = "state\0"
    var s_big: [u8; 6] = "big2m\0"
    var s_pg: [u8; 6] = "pages\0"
    let vm: u64 = vm_create_big(state, guest, 0, mib)
    if vm >= MAX_VMS {
        return MAX_VMS
    }
    let r: u64 = vm_run(state, vm)
    serial.puts((&s_run[0]) as u64)
    serial.puts(name)
    serial.put(32 as u8)
    kv((&s_slot[0]) as u64, vm)
    kv((&s_ex[0]) as u64, vm_exits(state, vm))
    kv((&s_out[0]) as u64, r)
    kx((&s_res[0]) as u64, vm_result(state, vm))
    kv((&s_st[0]) as u64, vm_state(state, vm))
    kv((&s_big[0]) as u64, vm_big(state, vm))
    kv((&s_pg[0]) as u64, vm_pages(state, vm))
    serial.nl()
    return vm
}

// Der Kopf: was dieser Prozessor kann. Ohne diese Zeile weiss niemand,
// unter welchen Voraussetzungen die Zahlen darunter entstanden sind.
fn report_cpu(state: u64) {
    var s_h: [u8; 9] = "hv: cpu \0"
    var s_rev: [u8; 4] = "rev\0"
    var s_as: [u8; 6] = "asids\0"
    var s_ft: [u8; 5] = "feat\0"
    var s_np: [u8; 3] = "np\0"
    var s_nr: [u8; 5] = "nrip\0"
    var s_de: [u8; 7] = "decode\0"
    var s_cl: [u8; 6] = "clean\0"
    var s_fl: [u8; 12] = "host-rflags\0"
    let f: u64 = feat(state)
    let fl: u64 = asm("pushfq\npop rax", out("rax"))
    serial.puts((&s_h[0]) as u64)
    kx((&s_fl[0]) as u64, fl)
    kv((&s_rev[0]) as u64, rev(state) & 0xFF)
    kv((&s_as[0]) as u64, nasid(state))
    kx((&s_ft[0]) as u64, f)
    yesno((&s_np[0]) as u64, (f & 1) != 0)
    yesno((&s_nr[0]) as u64, (f & 8) != 0)
    yesno((&s_de[0]) as u64, (f & 128) != 0)
    yesno((&s_cl[0]) as u64, (f & 32) != 0)
    serial.nl()
}

// Die Austritte, nach Grund. DIESE ZEILE IST DER AUFTRAG: "Zaehl die
// VM-Austritte nach Grund und schreib die Zahlen in die Doku."
fn report_exits(state: u64) {
    var s_h: [u8; 11] = "hv: exits \0"
    var s_tot: [u8; 6] = "total\0"
    var s_cpuid: [u8; 6] = "cpuid\0"
    var s_io: [u8; 5] = "ioio\0"
    var s_msr: [u8; 4] = "msr\0"
    var s_hlt: [u8; 4] = "hlt\0"
    var s_vmm: [u8; 8] = "vmmcall\0"
    var s_npf: [u8; 4] = "npf\0"
    var s_intr: [u8; 5] = "intr\0"
    var s_sd: [u8; 9] = "shutdown\0"
    var s_exc: [u8; 4] = "exc\0"
    var s_crw: [u8; 5] = "crwr\0"
    var s_err: [u8; 4] = "err\0"
    var s_oth: [u8; 6] = "other\0"
    serial.puts((&s_h[0]) as u64)
    kv((&s_tot[0]) as u64, exits_total(state))
    kv((&s_cpuid[0]) as u64, exits_bucket(state, B_CPUID))
    kv((&s_io[0]) as u64, exits_bucket(state, B_IOIO))
    kv((&s_msr[0]) as u64, exits_bucket(state, B_MSR))
    kv((&s_hlt[0]) as u64, exits_bucket(state, B_HLT))
    kv((&s_vmm[0]) as u64, exits_bucket(state, B_VMMCALL))
    kv((&s_npf[0]) as u64, exits_bucket(state, B_NPF))
    kv((&s_intr[0]) as u64, exits_bucket(state, B_INTR))
    kv((&s_sd[0]) as u64, exits_bucket(state, B_SHUTDOWN))
    kv((&s_exc[0]) as u64, exits_bucket(state, B_EXC))
    kv((&s_crw[0]) as u64, exits_bucket(state, B_CRWR))
    kv((&s_err[0]) as u64, exits_bucket(state, B_ERR))
    kv((&s_oth[0]) as u64, exits_bucket(state, B_OTHER))
    serial.nl()
}

// Was ein Austritt kostet. Der Messgast tut nichts ausser austreten, und
// sein Kontingent ist die Zahl der Runden -- damit ist der Wert eine
// Zeit je Runde und keine Schaetzung.
fn bench(state: u64) {
    var s_h: [u8; 11] = "hv: bench \0"
    var s_n: [u8; 7] = "rounds\0"
    var s_c: [u8; 7] = "cycles\0"
    var s_p: [u8; 9] = "per-exit\0"
    var s_g: [u8; 10] = "in-guest\0\0"
    var s_x: [u8; 8] = "in-host\0"
    let vm: u64 = vm_create(state, G_BENCH, 0)
    if vm >= MAX_VMS {
        return
    }
    let r0: u64 = get(state, S_CYC_RUN)
    let e0: u64 = get(state, S_CYC_EXIT)
    vset(state, vm, V_BUDGET, 512)
    vm_run(state, vm)
    let n: u64 = vm_exits(state, vm)
    let dr: u64 = get(state, S_CYC_RUN) -% r0
    let de: u64 = get(state, S_CYC_EXIT) -% e0
    serial.puts((&s_h[0]) as u64)
    kv((&s_n[0]) as u64, n)
    kv((&s_c[0]) as u64, dr +% de)
    if n > 0 {
        kv((&s_p[0]) as u64, (dr +% de) / n)
        kv((&s_g[0]) as u64, dr / n)
        kv((&s_x[0]) as u64, de / n)
    }
    serial.nl()
    vm_destroy(state, vm)
}

// --------------------------------------------------------------- stage
//
// Der Abschnitt dieser Runde, aufgerufen aus `kmain.fi` mit EINER Zeile
// -- wie `hw.stage`. Mehrere Runden arbeiten gleichzeitig an dieser
// Datei, und eine Naht ist billiger zu verschmelzen als ein Eingriff.
fn stage(state: u64) {
    var s_skip: [u8; 12] = "hv: skipped\0"
    var s_head: [u8; 42] = "hv: a hypervisor -- AMD-V, nested paging\n\0"
    var s_novt: [u8; 61] = "hv: no vmx here: TCG cannot do VT-x, so this is SVM instead\n\0"
    var s_rc: [u8; 12] = "hv: enable \0"
    var s_rcn: [u8; 3] = "rc\0"
    var s_nosvm: [u8; 40] = "hv: counter-check nosvm: SVM stays off\n\0"
    var s_hello: [u8; 6] = "hello\0"
    var s_pm: [u8; 3] = "pm\0"
    var s_fault: [u8; 6] = "fault\0"
    var s_crash: [u8; 6] = "crash\0"
    var s_loop: [u8; 5] = "loop\0"
    var s_lm: [u8; 3] = "lm\0"
    var s_dev: [u8; 4] = "dev\0"
    var s_frames: [u8; 12] = "hv: frames \0"
    var s_before: [u8; 7] = "before\0"
    var s_after: [u8; 6] = "after\0"
    var s_leak: [u8; 5] = "leak\0"
    var s_pr: [u8; 12] = "hv: proofs \0"
    var s_of: [u8; 4] = " / \0"
    var s_done: [u8; 9] = "hv: done\0"
    var s_alive: [u8; 15] = "hv: host alive\0"

    // Die Zusagen, jede mit ihrem Namen, damit eine geloeschte auffaellt.
    var n_svm: [u8; 25] = "the processor can do svm\0"
    var n_np: [u8; 30] = "it can do nested page tables\0\0"
    var n_en: [u8; 25] = "svm switched on, rc = 0\0\0"
    var n_h_res: [u8; 32] = "guest 1 signed off with 0x1234\0\0"
    var n_h_cpu: [u8; 38] = "guest 1 was told the host's cpu name\0\0"
    var n_h_hv: [u8; 44] = "guest 1 sees the hypervisor bit in cpuid 1\0\0"
    var n_h_pat: [u8; 44] = "guest 1 read the pattern through the npt\0\0\0\0"
    var n_h_inj: [u8; 44] = "guest 1 took the interrupt the host threw\0\0\0"
    var n_h_out: [u8; 39] = "guest 1 printed through a port it has\0\0"
    var n_p_res: [u8; 32] = "guest 2 signed off with 0x2222\0\0"
    var n_p_pg: [u8; 47] = "guest 2 read back through its OWN page table\0\0\0"
    var n_p_cr0: [u8; 41] = "guest 2 really turned on pe and paging\0\0\0"
    var n_p_cr3: [u8; 36] = "guest 2 runs on its own cr3 0x2000\0\0"
    var n_f_res: [u8; 32] = "guest 4 signed off with 0x3333\0\0"
    var n_f_val: [u8; 46] = "guest 4 read back what it wrote after the npf\0"
    var n_f_npf: [u8; 43] = "the host laid a frame under it on demand\0\0\0"
    var n_c_dead: [u8; 42] = "guest 5 was shut down by a triple fault\0\0\0"
    var n_c_host: [u8; 45] = "and the host's syscall path is untouched\0\0\0\0\0"
    var n_c_val: [u8; 41] = "guest 5 still reported 0x4444 before it\0\0"
    var n_leak: [u8; 40] = "every frame of every guest came back\0\0\0\0"
    var n_intr: [u8; 46] = "the host took the runaway guest's processor\0\0\0"
    var n_intr2: [u8; 38] = "and the runaway guest counted onwards\0"
    // ---- Runde HV2, Stufe 1 ----
    var n_l_res: [u8; 32] = "guest 7 signed off with 0x6464\0\0"
    var n_l_lma: [u8; 44] = "guest 7 reached LONG MODE: efer.lme and lma\0"
    var n_l_cr0: [u8; 40] = "guest 7 runs with pe and paging on cr0\0\0"
    var n_l_cr4: [u8; 39] = "guest 7 turned on pae -- without it no\0"
    var n_l_64: [u8; 43] = "guest 7 really has 64 bit wide registers\0\0\0"
    var n_l_big: [u8; 46] = "guest 7 wrote through a 2 MiB page and read\0\0\0"
    var n_l_efer: [u8; 45] = "and the host really took the efer.lme write\0\0"
    var n_l_npt: [u8; 46] = "and its npt is built from 2 MiB pages, not 4K\0"
    // ---- Runde HV2, Stufe 3 ----
    var n_d_res: [u8; 32] = "guest 8 signed off with 0x7777\0\0"
    var n_d_scr: [u8; 44] = "the uart scratch register really holds 0x5A\0"
    var n_d_lsr: [u8; 44] = "the uart says thre and temt: it can send\0\0\0\0"
    var n_d_ff: [u8; 47] = "and the lsr is NOT 0xFF -- linux would give up\0"
    var n_d_dlab: [u8; 44] = "behind dlab lies the divisor, not the data\0\0"
    var n_d_pic: [u8; 44] = "the pic took the full icw1..icw4 sequence\0\0\0"
    var n_d_base: [u8; 46] = "and its vector base is the guest's 0x30, not\0\0"
    var n_d_pit: [u8; 46] = "the timer joined both halves into 0x2E9C\0\0\0\0\0\0"
    var n_d_ready: [u8; 42] = "and the pic is fully initialised, step 0\0\0"
    // ---------------- RUNDE HV3, STUFE 5: DER ENTZIFFERER ----------------
    var n_w_flat: [u8; 45] = "without cr0.pg a guest does not translate\0\0\0\0"
    var n_w_prot: [u8; 43] = "with pg and no pae the walk is two level\0\0\0"
    var n_w_pae: [u8; 42] = "with pae and no lma it is three level\0\0\0\0\0"
    var n_w_long: [u8; 42] = "and with lma it is four level, 64 bit\0\0\0\0\0"
    var n_w_walk: [u8; 47] = "the host walked the GUEST's own page table\0\0\0\0\0"
    var n_w_big: [u8; 44] = "and it knows a 2 MiB page from a pointer\0\0\0\0"
    var n_w_bad: [u8; 45] = "an unmapped address really comes back bad\0\0\0\0"
    var n_d_rex: [u8; 46] = "the decoder read rex.b: r8 and not rax, len 4\0"
    // ---------------- RUNDE HV3, STUFE 4: DER LADEWEG --------------------
    var n_z_chk: [u8; 43] = "a self-built bzImage header passes check\0\0\0"
    var n_z_bad: [u8; 46] = "and one without HdrS is refused with reason 3\0"
    var n_z_e820: [u8; 43] = "the zero page carries 3 e820 entries\0\0\0\0\0\0\0"
    var n_z_ldr: [u8; 41] = "type_of_loader is 0xFF as the spec says\0\0"
    var n_z_cmd: [u8; 41] = "cmd_line_ptr points at the command line\0\0"
    var n_z_hdr: [u8; 43] = "the setup header really got copied along\0\0\0"
    var n_z_ent: [u8; 46] = "the 64 bit entry is load address plus 0x200\0\0\0"
    // ---------------- RUNDE HV3: DAS LINUX SELBST ------------------------
    var n_l_chk: [u8; 40] = "the real bzImage passed every check\0\0\0\0\0"
    var n_l_load: [u8; 42] = "and its protected part was moved in full\0\0"
    var n_l_e820: [u8; 42] = "linux got a memory map it can believe\0\0\0\0\0"
    var n_l_said: [u8; 44] = "AND LINUX REALLY SPOKE ON THE SERIAL LINE\0\0\0"
    // RUNDE HV3, STUFE 5. Reden allein ist wenig -- die Meldungen des
    // Laders kaeme auch ein Linux zustande, das gleich danach steht.
    // Diese Zusagen messen, dass es WEITERLIEF: viele Oktette, ein
    // laufender Takt, und ein Gast, der seine Uhr abgefragt hat.
    var n_l_viel: [u8; 45] = "and it kept talking: a whole boot log, not a\0"
    var n_l_takt: [u8; 40] = "the host gave linux a timer of its own\0\0"
    var n_l_uhr: [u8; 44] = "and linux read the clock instead of hanging\0"
    var n_l_kal: [u8; 46] = "it calibrated against the pit and moved on\0\0\0\0"
    var s_nolin: [u8; 36] = "hv: linux: no boot module, nothing\0\0"

    if !on(state, M_HV) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_novt[0]) as u64)

    var gut: u64 = 0
    var alle: u64 = 0

    // 1. Was der Prozessor kann.
    alle = alle + 1
    gut = gut + zusage_true((&n_svm[0]) as u64, cpu_has_svm())

    // 2. Einschalten -- oder die GEGENPROBE.
    if on(state, M_NOSVM) {
        serial.puts((&s_nosvm[0]) as u64)
        set(state, S_READY, 0)
        serial.puts((&s_done[0]) as u64)
        serial.nl()
        return
    }
    let rc: u64 = enable(state)
    serial.puts((&s_rc[0]) as u64)
    kv((&s_rcn[0]) as u64, rc)
    serial.nl()
    alle = alle + 1
    gut = gut + zusage((&n_en[0]) as u64, rc, 0)
    if rc != 0 {
        serial.puts((&s_done[0]) as u64)
        serial.nl()
        return
    }
    report_cpu(state)
    alle = alle + 1
    gut = gut + zusage_true((&n_np[0]) as u64, (feat(state) & 1) != 0)

    // Waehrend der Gaeste soll der Zeitgeber schlagen (er ist der
    // Notausgang), aber nicht die Aufgabe wechseln -- sonst stuenden
    // zwei Ausgaben ineinander.
    let pre: u64 = kstate.get(state, kstate.PREEMPT)
    kstate.set(state, kstate.PREEMPT, 0)
    let frames0: u64 = mem.frames_free(state)

    // 3. Der erste Gast: Realmodus, Anschluss, CPUID, NPT, Einwurf.
    let v1: u64 = lauf(state, G_HELLO, (&s_hello[0]) as u64)
    alle = alle + 6
    gut = gut + zusage((&n_h_res[0]) as u64, vm_result(state, v1), 0x1234)
    gut = gut + zusage((&n_h_cpu[0]) as u64, value_of(state, 1), 0x6D75734F)
    gut = gut + zusage((&n_h_hv[0]) as u64,
        value_of(state, 2) & 0x80000000, 0x80000000)
    gut = gut + zusage((&n_h_pat[0]) as u64, value_of(state, 3), PATTERN)
    gut = gut + zusage((&n_h_inj[0]) as u64, value_of(state, 4), 0xABCD)
    gut = gut + zusage((&n_h_out[0]) as u64, guest_out(state), 15)

    // 4. Der zweite Gast: geschuetzter Modus und ein eigenes Paging.
    let v2: u64 = lauf(state, G_PM, (&s_pm[0]) as u64)
    alle = alle + 4
    gut = gut + zusage((&n_p_res[0]) as u64, vm_result(state, v2), 0x2222)
    gut = gut + zusage((&n_p_pg[0]) as u64, value_of(state, 5), 0x5A5AC0DE)
    gut = gut + zusage((&n_p_cr0[0]) as u64,
        value_of(state, 6) & 0x80000001, 0x80000001)
    gut = gut + zusage((&n_p_cr3[0]) as u64, value_of(state, 7), 0x2000)

    // 5. Der dritte Gast: eine Seite auf Zuruf.
    let npf0: u64 = npfs(state)
    let v4: u64 = lauf(state, G_FAULT, (&s_fault[0]) as u64)
    alle = alle + 3
    gut = gut + zusage((&n_f_res[0]) as u64, vm_result(state, v4), 0x3333)
    gut = gut + zusage((&n_f_val[0]) as u64, value_of(state, 8), 0xC0DE)
    gut = gut + zusage_true((&n_f_npf[0]) as u64, npfs(state) > npf0)

    // 6. Der vierte Gast: der Absturz, den der Wirt ueberleben MUSS.
    let v5: u64 = lauf(state, G_CRASH, (&s_crash[0]) as u64)
    alle = alle + 3
    gut = gut + zusage((&n_c_val[0]) as u64, value_of(state, 9), 0x4444)
    gut = gut + zusage((&n_c_dead[0]) as u64, vm_state(state, v5), ST_DEAD)
    gut = gut + zusage_true((&n_c_host[0]) as u64, host_intact(state))

    // 7. Der Laeufer -- nur auf Verlangen, denn er haengt an der Frage,
    //    ob der Zeitgeber den Wirt wirklich zurueckholt.
    if on(state, M_LOOP) {
        let i0: u64 = exits_bucket(state, B_INTR)
        let v3: u64 = lauf(state, G_LOOP, (&s_loop[0]) as u64)
        alle = alle + 2
        gut = gut + zusage_true((&n_intr[0]) as u64,
            exits_bucket(state, B_INTR) > i0)
        gut = gut + zusage_true((&n_intr2[0]) as u64, vm_exits(state, v3) > 1)
        vm_destroy(state, v3)
    }

    // 7b. RUNDE HV2, STUFE 1: DER LANGE MODUS.
    //
    // Der Gast geht selbst den ganzen Weg -- Realmodus, geschuetzter
    // Modus, vierstufige Tabelle mit 2-MiB-Seiten, PAE, EFER.LME,
    // Paging, weiter Sprung in ein Segment mit L=1. Gemessen wird
    // NICHT, dass er lebt, sondern dass der PROZESSOR `EFER.LMA`
    // gesetzt hat: dieses Bit kann der Gast nicht selbst schreiben.
    var v6: u64 = MAX_VMS
    if on(state, M_LM) {
        let ew0: u64 = eferw(state)
        // AUF EINER MASCHINE MIT GROSSEM SPEICHER. Der Gast schreibt
        // durch die Adresse 2 MiB, und die liegt in der ZWEITEN grossen
        // Seite -- das kann nur ankommen, wenn die NPT dieser Runde
        // wirklich mit 2-MiB-Eintraegen uebersetzt.
        v6 = lauf_big(state, G_LM, (&s_lm[0]) as u64, 8)
        alle = alle + 6
        gut = gut + zusage((&n_l_res[0]) as u64, vm_result(state, v6), 0x6464)
        // LMA (Bit 10) UND LME (Bit 8): der Gast hat LME geschrieben,
        // der Prozessor hat LMA dazugesetzt. Beides zusammen heisst
        // "langer Modus AKTIV".
        gut = gut + zusage((&n_l_lma[0]) as u64,
            value_of(state, 10) & 0x500, 0x500)
        // CR0.PG und CR0.PE.
        gut = gut + zusage((&n_l_cr0[0]) as u64,
            value_of(state, 11) & 0x80000001, 0x80000001)
        // CR4.PAE -- ohne das gibt es keinen langen Modus.
        gut = gut + zusage((&n_l_cr4[0]) as u64,
            value_of(state, 12) & 0x20, 0x20)
        // Ein Wert, den ein 32-Bit-Gast gar nicht bilden koennte.
        gut = gut + zusage((&n_l_64[0]) as u64, value_of(state, 13), 0x12345678)
        // Durch eine 2-MiB-Seite geschrieben und zurueckgelesen.
        gut = gut + zusage((&n_l_big[0]) as u64, value_of(state, 14), 0xC0FFEE64)
        alle = alle + 1
        gut = gut + zusage_true((&n_l_efer[0]) as u64, eferw(state) > ew0)
        // Die Maschine hat wirklich grosse Seiten, und zwar mehr als
        // eine -- sonst waere der Schreibzugriff auf 2 MiB nie
        // uebersetzt worden.
        alle = alle + 1
        gut = gut + zusage_true((&n_l_npt[0]) as u64, vm_big(state, v6) > 1)
    }

    // 7c. RUNDE HV2, STUFE 3: DIE GERAETE.
    //
    // Der Gast PRUEFT sie, wie ein Betriebssystem es tut: schreiben,
    // zurueklesen, und nur glauben, was zurueckkommt. Jede der fuenf
    // Zahlen unten ist eine Antwort eines Geraets und keine Behauptung
    // des Wirts.
    var v7: u64 = MAX_VMS
    if on(state, M_DEV) {
        v7 = lauf(state, G_DEV, (&s_dev[0]) as u64)
        alle = alle + 7
        gut = gut + zusage((&n_d_res[0]) as u64, vm_result(state, v7), 0x7777)
        // Das Kratzregister ist reiner Speicher -- und genau daran
        // erkennt ein Treiber, dass ueberhaupt ein Baustein da ist.
        gut = gut + zusage((&n_d_scr[0]) as u64, value_of(state, 40), 0x5A)
        // THRE und TEMT. Ohne sie waere der Anschluss nie sendebereit.
        gut = gut + zusage((&n_d_lsr[0]) as u64, value_of(state, 41), 0x60)
        // UND NICHT 0xFF: darauf gibt Linux den Anschluss auf.
        gut = gut + zusage_true((&n_d_ff[0]) as u64,
            value_of(state, 41) != 0xFF)
        // Hinter DLAB liegt der Teiler und nicht das Datenregister.
        gut = gut + zusage((&n_d_dlab[0]) as u64, value_of(state, 42), 0x0C)
        // Die vierteilige Anfangsfolge ist durchgelaufen, und die
        // Maske danach ist die, die der Gast geschrieben hat.
        gut = gut + zusage((&n_d_pic[0]) as u64, value_of(state, 44), 0xFD)
        // Und der Verteiler hat die Vektorbasis des Gasts, nicht die
        // aus dem Lehrbuch.
        gut = gut + zusage((&n_d_base[0]) as u64,
            vdev.pic_base(state, vdev_base(state), v7, false), 0x30)
        // Der Zeitgeber hat das zweiteilige Schreiben richtig
        // zusammengesetzt: 0x2E9C und nicht 0x2E oder 0x9C.
        alle = alle + 2
        gut = gut + zusage((&n_d_pit[0]) as u64,
            vdev.pit_count(state, vdev_base(state), v7), 0x2E9C)
        gut = gut + zusage_true((&n_d_ready[0]) as u64,
            vdev.pic_ready(state, vdev_base(state), v7))
    }

    // ================================================================
    //   RUNDE HV3, STUFE 5: DER ENTZIFFERER UND DER SEITENLAUF
    // ================================================================
    //
    // DIESE ZUSAGEN BRAUCHEN KEINEN GAST. Der Seitenlauf ist eine
    // Rechnung ueber Tabellen im Speicher -- also wird eine Tabelle
    // hingeschrieben und nachgesehen, ob er dieselbe Adresse findet,
    // die der Prozessor finden wuerde. Das ist die schaerfere Probe:
    // ein Seitenlauf, der nur "im Gast funktioniert", koennte zufaellig
    // richtig liegen, weil identisch abgebildet war.
    alle = alle + 8
    // (a) Die Betriebsart aus CR0/CR4/EFER. Vier Faelle, und der
    //     letzte ist der, den man falsch macht: LMA steht, aber PG
    //     nicht -- dann uebersetzt der Gast NICHT, egal was EFER sagt.
    gut = gut + zusage((&n_w_flat[0]) as u64,
        gwalk.walk_mode(0, 0, 0), gwalk.MODE_FLAT)
    gut = gut + zusage((&n_w_prot[0]) as u64,
        gwalk.walk_mode(0x80000000, 0, 0), gwalk.MODE_PROT)
    gut = gut + zusage((&n_w_pae[0]) as u64,
        gwalk.walk_mode(0x80000000, 0x20, 0), gwalk.MODE_PAE)
    gut = gut + zusage((&n_w_long[0]) as u64,
        gwalk.walk_mode(0x80000000, 0x20, 0x400), gwalk.MODE_LONG)
    // (b) EIN ECHTER VIERSTUFIGER SEITENLAUF. Der Wirt baut eine
    //     Tabelle in einem Rahmenlauf, der wie ein Gastspeicher
    //     aussieht, und laesst den Lauf eine virtuelle Adresse
    //     uebersetzen, die NICHT identisch abgebildet ist. Waere der
    //     Lauf eine Attrappe, kaeme die Eingabe zurueck.
    let probe: u64 = mem.frame_run(state, 8)
    if probe != 0 {
        var pz: u64 = 0
        while pz < 8 {
            vmcb.zero_page(probe +% pz *% 4096)
            pz = pz +% 1
        }
        // gastphysisch 0x0000 PML4, 0x1000 PDP, 0x2000 PD, 0x3000 PT
        // Die virtuelle Adresse 0x40201234 soll auf gastphysisch
        // 0x5234 zeigen -- also 0x5000 mit Versatz 0x234.
        __mmio_write64((probe +% 0) as *mut u64, 0x1000 | 3)
        __mmio_write64((probe +% 0x1000 +% 8) as *mut u64, 0x2000 | 3)
        __mmio_write64((probe +% 0x2000 +% 8) as *mut u64, 0x3000 | 3)
        // Der Eintrag in der PT: der Index von 0x40201234 auf der
        // letzten Stufe ist (va >> 12) & 0x1FF = 1 -- nachgerechnet
        // und nicht geraten. Ein falscher Index hier waere eine Probe,
        // die den Seitenlauf ANKLAGT, obwohl er recht hat; genau das
        // ist beim ersten Lauf dieser Runde passiert.
        __mmio_write64((probe +% 0x3000 +% 1 *% 8) as *mut u64,
            0x5000 | 3)
        let va: u64 = 0x40201234
        gut = gut + zusage((&n_w_walk[0]) as u64,
            gwalk.walk(probe, 8 *% 4096, 0, gwalk.MODE_LONG, va), 0x5234)
        // (c) EINE GROSSE SEITE. Dasselbe, aber der PD-Eintrag IST die
        //     Seite (Bit PS). Linux bildet seinen Kern so ab -- ein
        //     Lauf ohne PS liest den Eintrag als Tabellenzeiger und
        //     landet im Nichts.
        __mmio_write64((probe +% 0x2000 +% 8) as *mut u64,
            0x400000 | 3 | 0x80)
        gut = gut + zusage((&n_w_big[0]) as u64,
            gwalk.walk(probe, 8 *% 4096, 0, gwalk.MODE_LONG, va),
            0x400000 +% 0x1234)
        // (d) UND EINE ADRESSE, DIE NICHT ABGEBILDET IST. Ein
        //     Seitenlauf, der immer etwas findet, findet nichts.
        gut = gut + zusage((&n_w_bad[0]) as u64,
            gwalk.walk(probe, 8 *% 4096, 0, gwalk.MODE_LONG, 0x80000000),
            gwalk.GW_BAD)
        // (e) Der Entzifferer liest `mov cr0, rax` MIT REX -- und zwar
        //     das richtige Register. Ohne REX.B waere `mov cr0, r8`
        //     von `mov cr0, rax` nicht zu unterscheiden.
        //     49 0F 22 C0  =  REX.WB, 0F 22, modrm C0  ->  cr0, r8
        //
        // ZUERST DIE GROSSE SEITE ZURUECKNEHMEN. Die Probe (c) oben hat
        // den PD-Eintrag auf eine 2-MiB-Seite umgestellt; liesse man das
        // so, zeigte `va` nicht mehr auf 0x5000, und der Entzifferer
        // laese Nullen statt des Befehls. Ein Nebeneffekt einer Probe
        // auf die naechste ist der unangenehmste Fehler in einem
        // Pruefstueck, weil er von der Reihenfolge abhaengt.
        __mmio_write64((probe +% 0x2000 +% 8) as *mut u64, 0x3000 | 3)
        __mmio_write8((probe +% 0x5000) as *mut u8, 0x49 as u8)
        __mmio_write8((probe +% 0x5001) as *mut u8, 0x0F as u8)
        __mmio_write8((probe +% 0x5002) as *mut u8, 0x22 as u8)
        __mmio_write8((probe +% 0x5003) as *mut u8, 0xC0 as u8)
        var dec: [u64; 5] = [0 as u64; 5]
        let dp: u64 = (&dec[0]) as u64
        // MODE_LONG und NICHT MODE_FLAT, und das ist kein Detail: ein
        // REX-Oktett ist NUR im langen Modus ein Vorsatz. Unter 64 Bit
        // ist 0x49 der Befehl `dec ecx`, und ein Entzifferer, der das
        // verwechselt, liest jeden Befehl um ein Oktett verschoben.
        // Der Seitenlauf muss dafuer die Tabelle oben benutzen -- also
        // liegt der Befehl an der virtuellen Adresse, die auf 0x5000
        // zeigt, und das ist `va` ohne seinen Versatz.
        let dl: u64 = gwalk.decode(probe, 8 *% 4096, 0, gwalk.MODE_LONG,
            va -% 0x234, dp)
        gut = gut + zusage((&n_d_rex[0]) as u64,
            gwalk.ins_kind(dp) *% 100 +% gwalk.ins_reg(dp) *% 10 +% dl,
            gwalk.INS_MOVCR_TO *% 100 +% 8 *% 10 +% 4)
        mem.frame_free_run(state, probe, 8)
    } else {
        gut = gut + zusage((&n_w_walk[0]) as u64, 0, 1)
        gut = gut + zusage((&n_w_big[0]) as u64, 0, 1)
        gut = gut + zusage((&n_w_bad[0]) as u64, 0, 1)
        gut = gut + zusage((&n_d_rex[0]) as u64, 0, 1)
    }

    // ================================================================
    //   RUNDE HV3, STUFE 4: DER LADEWEG -- OHNE EIN OKTETT LINUX
    // ================================================================
    //
    // Der Bericht der Runde HV2 sagt in Abschnitt 11, dies sei der
    // naechste sinnvolle Schritt, "weil sie sich bauen und pruefen
    // laesst, ohne dass ein einziges Oktett Linux vorhanden sein muss".
    // Genau das steht hier: ein Abbild, das der WIRT baut, mit einem
    // Kopf, der der Festlegung entspricht -- und der Ladeweg muss ihn
    // lesen, pruefen und eine Zero-Page daraus bauen.
    if on(state, M_ZP) {
        zp_selftest(state)
        alle = alle + 7
        gut = gut + zusage((&n_z_chk[0]) as u64, value_of(state, 30), 0)
        gut = gut + zusage((&n_z_bad[0]) as u64, value_of(state, 31), 3)
        gut = gut + zusage((&n_z_e820[0]) as u64, value_of(state, 32),
            bzload.E820_SLOT)
        gut = gut + zusage((&n_z_ldr[0]) as u64, value_of(state, 33), 0xFF)
        gut = gut + zusage((&n_z_cmd[0]) as u64, value_of(state, 34),
            bzload.G_CMDLINE)
        gut = gut + zusage((&n_z_hdr[0]) as u64, value_of(state, 35), 1)
        gut = gut + zusage((&n_z_ent[0]) as u64, value_of(state, 36), 1)
    }

    // ================================================================
    //   RUNDE HV3: UND JETZT WIRKLICH EIN LINUX
    // ================================================================
    var vlin: u64 = MAX_VMS
    if on(state, M_LINUX) {
        let img: u64 = kstate.get(state, kstate.MOD_BASE)
        let ilen: u64 = kstate.get(state, kstate.MOD_BYTES)
        if ilen == 0 {
            // KEIN MODUL IST KEIN FEHLER. Die meisten Laeufe dieses
            // Kernels haben kein Linux dabei; das Wort ist dann eine
            // Zeile und sonst nichts.
            serial.puts((&s_nolin[0]) as u64)
            serial.nl()
        } else {
            vlin = linux_boot(state, img, ilen)
            alle = alle + 4
            // Der Kopf war in Ordnung -- sonst ist alles danach Raten.
            gut = gut + zusage((&n_l_chk[0]) as u64, value_of(state, 50), 0)
            // Das Abbild ist vollstaendig umgelagert worden.
            gut = gut + zusage_true((&n_l_load[0]) as u64,
                value_of(state, 52) > 1000000)
            // Das Speicherbild steht.
            gut = gut + zusage((&n_l_e820[0]) as u64, value_of(state, 53),
                bzload.E820_SLOT)
            // UND DER MASSSTAB DIESER RUNDE: Linux hat geredet.
            gut = gut + zusage_true((&n_l_said[0]) as u64,
                value_of(state, 55) > 0)
            alle = alle + 4
            // NICHT NUR EIN PIEPSER. Der Lader allein bringt es auf
            // wenige Dutzend Oktette; ein Linux, das seinen Hochlauf
            // wirklich durchlaeuft, redet Tausende. Gemessen wurde
            // vor dieser Stufe 74, danach ueber 20000.
            gut = gut + zusage_true((&n_l_viel[0]) as u64,
                value_of(state, 55) > 4096)
            // Der Takt lief. Ohne ihn stand der Gast im `hlt`.
            gut = gut + zusage_true((&n_l_takt[0]) as u64,
                value_of(state, 58) > 0)
            // Die Uhr wurde gelesen -- und zwar ein paar Mal und
            // nicht tausendfach: tausendfach hiesse, er haengt in
            // der Schleife, die diese Stufe aufgeloest hat.
            gut = gut + zusage_true((&n_l_uhr[0]) as u64,
                value_of(state, 59) > 0 && value_of(state, 59) < 256)
            // Und der zweite Kanal des Zeitgebers hat durchgezaehlt,
            // statt die Messung der Taktrate ewig warten zu lassen.
            gut = gut + zusage_true((&n_l_kal[0]) as u64,
                value_of(state, 60) > 0 && value_of(state, 60) < 512)
        }
    }

    if on(state, M_MESS) {
        bench(state)
    }

    report_exits(state)

    // 8. Alles abraeumen -- und nachzaehlen. Ein Wirt, der bei jeder
    //    Gastmaschine Rahmen liegen laesst, ist ein Wirt mit einem Leck,
    //    und ein Leck sieht man nur, wenn man zaehlt.
    vm_destroy(state, v1)
    vm_destroy(state, v2)
    vm_destroy(state, v4)
    vm_destroy(state, v5)
    if v6 < MAX_VMS {
        vm_destroy(state, v6)
    }
    if v7 < MAX_VMS {
        vm_destroy(state, v7)
    }
    // RUNDE HV3: der Linux-Gast ist der groesste von allen -- 73 MiB.
    // Wenn DER ein Leck hinterliesse, waere es das erste, das man
    // sieht. Genau deshalb steht die Leck-Zusage hinter ihm.
    if vlin < MAX_VMS {
        vm_destroy(state, vlin)
    }
    let frames1: u64 = mem.frames_free(state)
    serial.puts((&s_frames[0]) as u64)
    kv((&s_before[0]) as u64, frames0)
    kv((&s_after[0]) as u64, frames1)
    kv((&s_leak[0]) as u64, frames0 -% frames1)
    serial.nl()
    alle = alle + 1
    gut = gut + zusage((&n_leak[0]) as u64, frames0, frames1)

    kstate.set(state, kstate.PREEMPT, pre)

    serial.puts((&s_alive[0]) as u64)
    serial.nl()
    serial.puts((&s_pr[0]) as u64)
    serial.dec(gut)
    serial.puts((&s_of[0]) as u64)
    serial.dec(alle)
    serial.nl()
    serial.puts((&s_done[0]) as u64)
    serial.nl()
}
