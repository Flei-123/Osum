
import serial
import lib.kstate
import bus.pci
import libc.regio

export {
    present, init, active, hz, id,
    eoi, timer_start, timer_rate, timer_stop, map_device, map_range, window_claim, window_point, window_slots, lapic_phys,
    tsc_gegen_pm, win_pde, pde_at,
    route, mask_gsi, ioapic_entries, gsi_entry, pic_off,
    timer_running, timer_diag, pit_route, nosrc, cpuid_max, c15_eax, c15_ebx, c15_ecx, c16_eax,
    S_CLK, S_HPET, S_PMPORT, S_PMBITS, S_NOSRC,
    spurious, spurious_hit, tsc, tsc_hz, VEC_SPURIOUS, VEC_TIMER, esr_take,
    window, core_init, ipi,
    s3_save, s3_restore
}

const S_ACTIVE: u64 = 0x008
const S_LAPIC: u64 = 0x010
const S_IOAPIC: u64 = 0x018
const S_HZ: u64 = 0x020
const S_SPURIOUS: u64 = 0x028
const S_LAPIC_PHYS: u64 = 0x030
const S_DIVISOR: u64 = 0x038
const S_TSCHZ: u64 = 0x040
const S_CLK: u64 = 0x048
const S_HPET: u64 = 0x050
const S_PMPORT: u64 = 0x058
const S_PMBITS: u64 = 0x060
const S_NOSRC: u64 = 0x068
const S_PITSEEN: u64 = 0x070

const MSR_APIC_BASE: u64 = 0x1B
const APIC_BASE_ENABLE: u64 = 0x800
const IOAPIC_DEFAULT: u64 = 0xFEC00000

const R_ID: u64 = 0x020
const R_VERSION: u64 = 0x030
const R_TPR: u64 = 0x080
const R_EOI: u64 = 0x0B0
const R_LDR: u64 = 0x0D0
const R_DFR: u64 = 0x0E0
const R_SVR: u64 = 0x0F0
const R_ESR: u64 = 0x280
const R_ICR_LOW: u64 = 0x300
const R_ICR_HIGH: u64 = 0x310
const R_LVT_TIMER: u64 = 0x320
const R_LVT_LINT0: u64 = 0x350
const R_LVT_LINT1: u64 = 0x360
const R_LVT_ERROR: u64 = 0x370
const R_TIMER_INIT: u64 = 0x380
const R_TIMER_CUR: u64 = 0x390
const R_TIMER_DIV: u64 = 0x3E0

const LVT_MASKED: u64 = 0x10000
const LVT_PERIODIC: u64 = 0x20000

const VEC_SPURIOUS: u64 = 47
const VEC_TIMER: u64 = 32

const DIV_16: u64 = 0x3
const DIV_VALUE: u64 = 16

const PAGE_PRESENT: u64 = 1
const PAGE_WRITE: u64 = 2
const PAGE_PWT: u64 = 8
const PAGE_PCD: u64 = 16
const PAGE_HUGE: u64 = 0x80
const ADDR_MASK: u64 = 0x000FFFFFFFFFF000
const WINDOW_BASE: u64 = 0xC0000000

fn wrmsr(index: u64, value: u64) {
    asm("wrmsr", in("rcx") index, in("rax") value & 0xFFFFFFFF,
        in("rdx") value >> 32)
}

fn rdmsr(index: u64) -> u64 {
    var lo: u64 = 0
    var hi: u64 = 0
    asm("rdmsr", in("rcx") index, out("rax") & lo, out("rdx") & hi)
    return (hi << 32) | (lo & 0xFFFFFFFF)
}

const WIN_SLOTS: u64 = 16
const WIN_FIRST: u64 = 496
const WIN_VIRT: u64 = 496 * 0x200000
const HUGE_SIZE: u64 = 0x200000
const WIN_CLAIMED: u64 = 0xFFFFFFFFFFFFFFFF
const S_WIN: u64 = 0x080

fn kernel_pd(state: u64) -> u64 {
    var pml4: u64 = kstate.get(state, kstate.KPML4)
    if pml4 == 0 {
        pml4 = asm("mov rax, cr3", out("rax")) & ADDR_MASK
    }
    let pdpt: u64 = __mmio_read64(pml4 as *mut u64) & ADDR_MASK
    if pdpt == 0 {
        return 0
    }
    return __mmio_read64(pdpt as *mut u64) & ADDR_MASK
}

fn window_install(pd: u64, i: u64, block: u64) {
    __mmio_write64((pd + (WIN_FIRST + i) * 8) as *mut u64,
        block | PAGE_PRESENT | PAGE_WRITE | PAGE_PCD | PAGE_PWT | PAGE_HUGE)
    let c: u64 = asm("mov rax, cr3", out("rax"))
    asm("mov cr3, rax", in("rax") c)
}

fn map_device(state: u64, phys: u64) -> u64 {
    let block: u64 = phys & (~(HUGE_SIZE - 1))
    let inner: u64 = phys - block
    var i: u64 = 0
    while i < WIN_SLOTS {
        if kstate.get(state, pci.K2_SCALARS + S_WIN + i * 8) == block + 1 {
            return WIN_VIRT + i * HUGE_SIZE + inner
        }
        i = i + 1
    }
    let pd: u64 = kernel_pd(state)
    if pd == 0 {
        return 0
    }
    i = 0
    while i < WIN_SLOTS {
        if kstate.get(state, pci.K2_SCALARS + S_WIN + i * 8) == 0 {
            window_install(pd, i, block)
            kstate.set(state, pci.K2_SCALARS + S_WIN + i * 8, block + 1)
            return WIN_VIRT + i * HUGE_SIZE + inner
        }
        i = i + 1
    }
    return 0
}

fn map_range(state: u64, phys: u64, size: u64) -> u64 {
    if size == 0 || phys +% size < phys {
        return 0
    }
    let first: u64 = phys & (~(HUGE_SIZE - 1))
    let last: u64 = (phys + size - 1) & (~(HUGE_SIZE - 1))
    let count: u64 = (last - first) / HUGE_SIZE + 1
    if count > WIN_SLOTS {
        return 0
    }
    let pd: u64 = kernel_pd(state)
    if pd == 0 {
        return 0
    }
    var start: u64 = 0
    while start + count <= WIN_SLOTS {
        var fits: bool = true
        var k: u64 = 0
        while k < count {
            let mark: u64 = kstate.get(state, pci.K2_SCALARS + S_WIN + (start + k) * 8)
            if mark != 0 && mark != first + k * HUGE_SIZE + 1 {
                fits = false
                k = count
            } else {
                k = k + 1
            }
        }
        if fits {
            var j: u64 = 0
            while j < count {
                let at: u64 = pci.K2_SCALARS + S_WIN + (start + j) * 8
                if kstate.get(state, at) == 0 {
                    window_install(pd, start + j, first + j * HUGE_SIZE)
                    kstate.set(state, at, first + j * HUGE_SIZE + 1)
                }
                j = j + 1
            }
            return WIN_VIRT + start * HUGE_SIZE + (phys - first)
        }
        start = start + 1
    }
    return 0
}

fn window_claim(state: u64, phys: u64) -> u64 {
    let block: u64 = phys & (~(HUGE_SIZE - 1))
    let pd: u64 = kernel_pd(state)
    if pd == 0 {
        return 0
    }
    var i: u64 = 0
    while i < WIN_SLOTS {
        if kstate.get(state, pci.K2_SCALARS + S_WIN + i * 8) == 0 {
            window_install(pd, i, block)
            kstate.set(state, pci.K2_SCALARS + S_WIN + i * 8, WIN_CLAIMED)
            return WIN_VIRT + i * HUGE_SIZE
        }
        i = i + 1
    }
    return 0
}

fn window_point(state: u64, virt: u64, phys: u64) -> u64 {
    if virt < WIN_VIRT {
        return 0
    }
    let i: u64 = (virt - WIN_VIRT) / HUGE_SIZE
    if i >= WIN_SLOTS || kstate.get(state, pci.K2_SCALARS + S_WIN + i * 8) != WIN_CLAIMED {
        return 0
    }
    let pd: u64 = kernel_pd(state)
    if pd == 0 {
        return 0
    }
    window_install(pd, i, phys & (~(HUGE_SIZE - 1)))
    return 1
}

fn win_pde(state: u64, i: u64) -> u64 {
    if i >= WIN_SLOTS {
        return 0
    }
    if kstate.get(state, pci.K2_SCALARS + S_WIN + i * 8) == 0 {
        return 0
    }
    let pd: u64 = kernel_pd(state)
    if pd == 0 {
        return 0
    }
    return __mmio_read64((pd + (WIN_FIRST + i) * 8) as *mut u64) & 0xFFF
}

fn pde_at(state: u64, virt: u64) -> u64 {
    if virt < WIN_VIRT {
        return 0
    }
    let i: u64 = (virt - WIN_VIRT) / HUGE_SIZE
    return win_pde(state, i)
}

fn window_slots(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < WIN_SLOTS {
        if kstate.get(state, pci.K2_SCALARS + S_WIN + i * 8) != 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn lapic(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_LAPIC)
}

fn lapic_phys(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_LAPIC_PHYS)
}

fn ioapic(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_IOAPIC)
}

fn active(state: u64) -> bool {
    return kstate.get(state, pci.K2_SCALARS + S_ACTIVE) != 0
}

fn hz(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_HZ)
}

fn spurious(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_SPURIOUS)
}

fn spurious_hit(state: u64) {
    kstate.add(state, pci.K2_SCALARS + S_SPURIOUS, 1)
}

fn present() -> bool {
    var d: u64 = 0
    asm("push rbx\nmov eax, 1\ncpuid\npop rbx",
        out("rdx") & d, clobber("rax"), clobber("rcx"))
    return (d & 0x200) != 0
}

fn id(state: u64) -> u64 {
    return (regio.read32_at(lapic(state), R_ID) >> 24) & 0xFF
}

fn pit_arm() {
    let counts: u64 = 11932
    let port61: u64 = serial.in8(0x61 as u16) as u64
    serial.out8(0x61 as u16, ((port61 & 0xFC) | 1) as u8)
    serial.out8(0x43 as u16, 0xB0 as u8)
    serial.out8(0x42 as u16, (counts & 0xFF) as u8)
    serial.out8(0x42 as u16, ((counts >> 8) & 0xFF) as u8)
}

fn pit_wait() -> bool {
    var guard: u64 = 0
    while guard < 2000000 {
        if (serial.in8(0x61 as u16) as u64 & 0x20) != 0 {
            return true
        }
        guard = guard + 1
    }
    return false
}

static mut cal_t: [u64; 8] = [0 as u64; 8]
static mut cal_l: [u64; 8] = [0 as u64; 8]
static mut tsc_raw: u64 = 0
static mut tsc_brand: u64 = 0
fn cpuid_leaf(leaf: u64, reg: u64) -> u64 {
    var v: u64 = 0
    if reg == 0 {
        asm("push rbx\nxor ecx, ecx\ncpuid\npop rbx", in("rax") leaf, out("rax") & v,
            clobber("rcx"), clobber("rdx"))
    } else if reg == 1 {
        asm("push rbx\nxor ecx, ecx\ncpuid\nmov rax, rbx\npop rbx", in("rax") leaf,
            out("rax") & v, clobber("rcx"), clobber("rdx"))
    } else if reg == 2 {
        asm("push rbx\nxor ecx, ecx\ncpuid\nmov rax, rcx\npop rbx", in("rax") leaf,
            out("rax") & v, clobber("rcx"), clobber("rdx"))
    } else {
        asm("push rbx\nxor ecx, ecx\ncpuid\nmov rax, rdx\npop rbx", in("rax") leaf,
            out("rax") & v, clobber("rcx"), clobber("rdx"))
    }
    return v & 0xFFFFFFFF
}

fn cal_get(which: u64, i: u64) -> u64 {
    if which == 0 {
        return cal_t[i as usize]
    }
    return cal_l[i as usize]
}

fn cal_set(which: u64, i: u64, v: u64) {
    if which == 0 {
        cal_t[i as usize] = v
    } else {
        cal_l[i as usize] = v
    }
}

fn cal_median(which: u64, first: u64, n: u64) -> u64 {
    var i: u64 = first + 1
    while i < first + n {
        let v: u64 = cal_get(which, i)
        var j: u64 = i
        while j > first && cal_get(which, j - 1) > v {
            cal_set(which, j, cal_get(which, j - 1))
            j = j - 1
        }
        cal_set(which, j, v)
        i = i + 1
    }
    return cal_get(which, first + n / 2)
}

fn brand_mhz() -> u64 {
    if cpuid_max_ext() < 0x80000004 {
        return 0
    }
    var b: [u8; 49] = [0 as u8; 49]
    var leaf: u64 = 0
    while leaf < 3 {
        var reg: u64 = 0
        while reg < 4 {
            let v: u64 = cpuid_leaf(0x80000002 + leaf, reg)
            var k: u64 = 0
            while k < 4 {
                b[(leaf * 16 + reg * 4 + k) as usize] = ((v >> (8 * k)) & 0xFF) as u8
                k = k + 1
            }
            reg = reg + 1
        }
        leaf = leaf + 1
    }
    var i: u64 = 2
    while i < 48 {
        if b[i as usize] as u64 == 122 && b[(i - 1) as usize] as u64 == 72 {
            let unit: u64 = b[(i - 2) as usize] as u64
            var mult: u64 = 0
            if unit == 71 {
                mult = 1000
            }
            if unit == 77 {
                mult = 1
            }
            if mult == 0 || i < 4 {
                return 0
            }
            var j: u64 = i - 2
            var whole: u64 = 0
            var frac: u64 = 0
            var fdig: u64 = 0
            var scale: u64 = 1
            var seen_dot: bool = false
            var start: u64 = j
            while start > 0 {
                let c: u64 = b[(start - 1) as usize] as u64
                if (c >= 48 && c <= 57) || c == 46 {
                    start = start - 1
                } else {
                    break
                }
            }
            j = start
            while j < i - 2 {
                let c: u64 = b[j as usize] as u64
                if c == 46 {
                    seen_dot = true
                } else if seen_dot {
                    frac = frac * 10 + (c - 48)
                    fdig = fdig + 1
                    scale = scale * 10
                } else {
                    whole = whole * 10 + (c - 48)
                }
                j = j + 1
            }
            return whole * mult + (frac * mult) / scale
        }
        i = i + 1
    }
    return 0
}

fn cpuid_max_ext() -> u64 {
    return cpuid_leaf(0x80000000, 0)
}

fn calibrate(state: u64) -> u64 {
    let base: u64 = lapic(state)
    regio.write32_at(base, R_TIMER_DIV, DIV_16)
    regio.write32_at(base, R_LVT_TIMER, LVT_MASKED)
    kstate.set(state, pci.K2_SCALARS + S_CLK, 0)
    var per_sec: u64 = 0
    if !nosrc(state, 1) {
        per_sec = cal_pit(state, base)
        if per_sec != 0 {
            kstate.set(state, pci.K2_SCALARS + S_CLK, 1)
        }
    }
    if per_sec == 0 && !nosrc(state, 2) {
        per_sec = cal_pm(state, base)
        if per_sec != 0 {
            kstate.set(state, pci.K2_SCALARS + S_CLK, 2)
        }
    }
    if per_sec == 0 && !nosrc(state, 4) {
        per_sec = cal_cpuid(state)
        if per_sec != 0 {
            kstate.set(state, pci.K2_SCALARS + S_CLK, 3)
        }
    }
    if per_sec == 0 && !nosrc(state, 8) {
        per_sec = cal_hpet(state, base)
        if per_sec != 0 {
            kstate.set(state, pci.K2_SCALARS + S_CLK, 4)
        }
    }
    return per_sec
}

fn cal_done(state: u64, per_sec: u64, tsc_per_sec: u64) -> u64 {
    if per_sec < 100000 || per_sec > 4000000000 {
        return 0
    }
    if tsc_per_sec != 0 && (tsc_per_sec < 100000000 || tsc_per_sec > 10000000000) {
        return 0
    }
    var tsc_use: u64 = tsc_per_sec
    tsc_raw = tsc_per_sec
    let bm: u64 = brand_mhz() * 1000000
    tsc_brand = bm
    if tsc_use != 0 && bm != 0 && (tsc_use * 2 < bm || tsc_use > bm * 2) {
        tsc_use = bm
    }
    kstate.set(state, pci.K2_SCALARS + S_HZ, per_sec)
    kstate.set(state, pci.K2_SCALARS + S_TSCHZ, tsc_use)
    return per_sec
}

fn cal_pit(state: u64, base: u64) -> u64 {
    var n: u64 = 0
    var go: bool = true
    while go && n < 6 {
        pit_arm()
        regio.write32_at(base, R_TIMER_INIT, 0xFFFFFFFF)
        let t0: u64 = tsc()
        let done: bool = pit_wait()
        let left: u64 = regio.read32_at(base, R_TIMER_CUR)
        let t1: u64 = tsc()
        regio.write32_at(base, R_TIMER_INIT, 0)
        kstate.set(state, pci.K2_SCALARS + S_PITSEEN, serial.in8(0x61 as u16) as u64)
        if !done || t1 <= t0 || left > 0xFFFFFFFF {
            go = false
        } else {
            cal_t[n as usize] = t1 - t0
            cal_l[n as usize] = 0xFFFFFFFF - left
            n = n + 1
        }
    }
    if n == 0 {
        return 0
    }
    var first: u64 = 0
    if n >= 3 {
        first = 1
    }
    let mt: u64 = cal_median(0, first, n - first)
    let ml: u64 = cal_median(1, first, n - first)
    return cal_done(state, ml * 100, mt * 100)
}

fn cal_pm(state: u64, base: u64) -> u64 {
    let port: u64 = kstate.get(state, pci.K2_SCALARS + S_PMPORT)
    if port == 0 || port > 0xFFFC {
        return 0
    }
    var bits: u64 = kstate.get(state, pci.K2_SCALARS + S_PMBITS)
    if bits != 32 {
        bits = 24
    }
    let maske: u64 = (1 << bits) - 1
    let spanne: u64 = PM_HZ / 100
    regio.write32_at(base, R_TIMER_INIT, 0xFFFFFFFF)
    let a0: u64 = pm_read(port, bits)
    let t0: u64 = tsc()
    var vergangen: u64 = 0
    var wache: u64 = 0
    while vergangen < spanne && wache < 20000000 {
        let a: u64 = pm_read(port, bits)
        vergangen = (a + (maske + 1) - a0) & maske
        wache = wache + 1
    }
    let left: u64 = regio.read32_at(base, R_TIMER_CUR)
    let t1: u64 = tsc()
    regio.write32_at(base, R_TIMER_INIT, 0)
    if vergangen < spanne || t1 <= t0 || left > 0xFFFFFFFF {
        return 0
    }
    let elapsed: u64 = 0xFFFFFFFF - left
    return cal_done(state, (elapsed * PM_HZ) / vergangen,
        ((t1 - t0) * PM_HZ) / vergangen)
}

fn cal_cpuid(state: u64) -> u64 {
    let top: u64 = cpuid_max()
    if top < 0x15 {
        return 0
    }
    let den: u64 = c15_eax()
    let num: u64 = c15_ebx()
    if den == 0 || num == 0 {
        return 0
    }
    var crystal: u64 = c15_ecx()
    if crystal == 0 {
        if top >= 0x16 && c16_eax() != 0 {
            crystal = (c16_eax() * 1000000 * den) / num
        } else {
            crystal = 24000000
        }
    }
    return cal_done(state, crystal / DIV_VALUE, (crystal * num) / den)
}

fn cal_hpet(state: u64, base: u64) -> u64 {
    let phys: u64 = kstate.get(state, pci.K2_SCALARS + S_HPET)
    if phys == 0 {
        return 0
    }
    let h: u64 = map_device(state, phys)
    if h == 0 {
        return 0
    }
    let period: u64 = __mmio_read32((h + 4) as *mut u32) as u64
    if period == 0 || period > 100000000 {
        return 0
    }
    let cfg: u64 = __mmio_read32((h + 0x10) as *mut u32) as u64
    __mmio_write32((h + 0x10) as *mut u32, ((cfg | 1) & 0xFFFFFFFF) as u32)
    let spanne: u64 = 10000000000000 / period
    regio.write32_at(base, R_TIMER_INIT, 0xFFFFFFFF)
    let a0: u64 = __mmio_read32((h + 0xF0) as *mut u32) as u64
    let t0: u64 = tsc()
    var vergangen: u64 = 0
    var wache: u64 = 0
    while vergangen < spanne && wache < 20000000 {
        let a: u64 = __mmio_read32((h + 0xF0) as *mut u32) as u64
        vergangen = (a + 0x100000000 - a0) & 0xFFFFFFFF
        wache = wache + 1
    }
    let left: u64 = regio.read32_at(base, R_TIMER_CUR)
    let t1: u64 = tsc()
    regio.write32_at(base, R_TIMER_INIT, 0)
    __mmio_write32((h + 0x10) as *mut u32, (cfg & 0xFFFFFFFF) as u32)
    if vergangen < spanne || t1 <= t0 || left > 0xFFFFFFFF {
        return 0
    }
    let ns: u64 = (vergangen * period) / 1000000
    if ns == 0 {
        return 0
    }
    let elapsed: u64 = 0xFFFFFFFF - left
    return cal_done(state, (elapsed * 1000000000) / ns,
        ((t1 - t0) * 1000000000) / ns)
}

const PM_HZ: u64 = 3579545

fn in32(port: u16) -> u64 {
    return asm("in eax, dx", out("rax"), in("dx") port)
}

fn pm_read(port: u64, bits: u64) -> u64 {
    let v: u64 = in32(port as u16)
    if bits >= 32 {
        return v & 0xFFFFFFFF
    }
    return v & 0xFFFFFF
}

fn tsc_gegen_pm(port: u64, bits: u64) -> u64 {
    if port == 0 {
        return 0
    }
    let maske: u64 = (1 << bits) - 1
    let spanne: u64 = PM_HZ / 10
    let a0: u64 = pm_read(port, bits)
    let t0: u64 = tsc()
    var wache: u64 = 0
    var vergangen: u64 = 0
    while vergangen < spanne && wache < 200000000 {
        let a: u64 = pm_read(port, bits)
        vergangen = (a + (maske + 1) - a0) & maske
        wache = wache + 1
    }
    let t1: u64 = tsc()
    if vergangen < spanne || t1 <= t0 {
        return 0
    }
    return ((t1 - t0) / vergangen) * PM_HZ
        + (((t1 - t0) % vergangen) * PM_HZ) / vergangen
}

fn tsc() -> u64 {
    var lo: u64 = 0
    var hi: u64 = 0
    asm("rdtsc", out("rax") & lo, out("rdx") & hi)
    return (hi << 32) | (lo & 0xFFFFFFFF)
}

fn tsc_hz(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_TSCHZ)
}

fn cpuid_max() -> u64 {
    var v: u64 = 0
    asm("push rbx\nxor eax, eax\ncpuid\npop rbx", out("rax") & v,
        clobber("rcx"), clobber("rdx"))
    return v & 0xFFFFFFFF
}

fn c15_eax() -> u64 {
    var v: u64 = 0
    asm("push rbx\nmov eax, 0x15\nxor ecx, ecx\ncpuid\npop rbx", out("rax") & v,
        clobber("rcx"), clobber("rdx"))
    return v & 0xFFFFFFFF
}

fn c15_ebx() -> u64 {
    var v: u64 = 0
    asm("push rbx\nmov eax, 0x15\nxor ecx, ecx\ncpuid\nmov eax, ebx\npop rbx", out("rax") & v,
        clobber("rcx"), clobber("rdx"))
    return v & 0xFFFFFFFF
}

fn c15_ecx() -> u64 {
    var v: u64 = 0
    asm("push rbx\nmov eax, 0x15\nxor ecx, ecx\ncpuid\nmov eax, ecx\npop rbx", out("rax") & v,
        clobber("rcx"), clobber("rdx"))
    return v & 0xFFFFFFFF
}

fn c16_eax() -> u64 {
    var v: u64 = 0
    asm("push rbx\nmov eax, 0x16\nxor ecx, ecx\ncpuid\npop rbx", out("rax") & v,
        clobber("rcx"), clobber("rdx"))
    return v & 0xFFFF
}

fn pit_route(state: u64) {
    route(state, 2, VEC_TIMER, id(state), false, false)
    route(state, 0, VEC_TIMER, id(state), false, false)
}

fn nosrc(state: u64, bit: u64) -> bool {
    return (kstate.get(state, pci.K2_SCALARS + S_NOSRC) & bit) != 0
}

fn timer_diag(state: u64) {
    var d0: [u8; 12] = "timer: src=\0"
    var d1: [u8; 7] = " apic=\0"
    var d2: [u8; 5] = " hz=\0"
    var d3: [u8; 9] = " tsc_hz=\0"
    var d4: [u8; 8] = " pit61=\0"
    var d5: [u8; 6] = " lvt=\0"
    var d6: [u8; 6] = " cur=\0"
    var d7: [u8; 6] = " c15=\0"
    var d8: [u8; 2] = "/\0"
    var d9: [u8; 6] = " c16=\0"
    var d10: [u8; 5] = " pm=\0"
    var d11: [u8; 7] = " hpet=\0"
    var d12: [u8; 9] = " tscraw=\0"
    var d13: [u8; 8] = " brand=\0"
    serial.puts((&d0[0]) as u64)
    serial.dec(kstate.get(state, pci.K2_SCALARS + S_CLK))
    serial.puts((&d1[0]) as u64)
    serial.dec(kstate.get(state, pci.K2_SCALARS + S_ACTIVE))
    serial.puts((&d2[0]) as u64)
    serial.dec(hz(state))
    serial.puts((&d3[0]) as u64)
    serial.dec(tsc_hz(state))
    serial.puts((&d4[0]) as u64)
    serial.hex(serial.in8(0x61 as u16) as u64)
    serial.puts((&d5[0]) as u64)
    if kstate.get(state, pci.K2_SCALARS + S_ACTIVE) != 0 {
        let base: u64 = lapic(state)
        serial.hex(regio.read32_at(base, R_LVT_TIMER))
        serial.puts((&d6[0]) as u64)
        serial.dec(regio.read32_at(base, R_TIMER_CUR))
    } else {
        serial.hex(0)
        serial.puts((&d6[0]) as u64)
        serial.dec(0)
    }
    serial.puts((&d7[0]) as u64)
    if cpuid_max() >= 0x16 {
        serial.dec(c15_eax())
        serial.puts((&d8[0]) as u64)
        serial.dec(c15_ebx())
        serial.puts((&d8[0]) as u64)
        serial.dec(c15_ecx())
        serial.puts((&d9[0]) as u64)
        serial.dec(c16_eax())
    } else {
        serial.dec(0)
        serial.puts((&d9[0]) as u64)
        serial.dec(0)
    }
    serial.puts((&d10[0]) as u64)
    serial.hex(kstate.get(state, pci.K2_SCALARS + S_PMPORT))
    serial.puts((&d11[0]) as u64)
    serial.hex(kstate.get(state, pci.K2_SCALARS + S_HPET))
    serial.puts((&d12[0]) as u64)
    serial.dec(tsc_raw)
    serial.puts((&d13[0]) as u64)
    serial.dec(tsc_brand)
    serial.nl()
}

fn init(state: u64, want_hz: u64) -> bool {
    if !present() {
        return false
    }
    var base_msr: u64 = rdmsr(MSR_APIC_BASE)
    if (base_msr & APIC_BASE_ENABLE) == 0 {
        base_msr = base_msr | APIC_BASE_ENABLE
        wrmsr(MSR_APIC_BASE, base_msr)
    }
    let phys: u64 = base_msr & 0xFFFFF000
    if phys == 0 {
        return false
    }
    let base: u64 = map_device(state, phys)
    let io: u64 = map_device(state, IOAPIC_DEFAULT)
    if base == 0 || io == 0 {
        return false
    }
    kstate.set(state, pci.K2_SCALARS + S_LAPIC_PHYS, phys)
    kstate.set(state, pci.K2_SCALARS + S_LAPIC, base)
    kstate.set(state, pci.K2_SCALARS + S_IOAPIC, io)

    let ver: u64 = regio.read32_at(base, R_VERSION)
    if ver == 0xFFFFFFFF || ver == 0 {
        return false
    }

    regio.write32_at(base, R_TPR, 0)
    regio.write32_at(base, R_DFR, 0xFFFFFFFF)
    regio.write32_at(base, R_LDR, 1 << 24)
    regio.write32_at(base, R_LVT_LINT0, LVT_MASKED)
    regio.write32_at(base, R_LVT_LINT1, LVT_MASKED)
    regio.write32_at(base, R_LVT_ERROR, LVT_MASKED)
    regio.write32_at(base, R_ESR, 0)
    regio.write32_at(base, R_ESR, 0)
    regio.write32_at(base, R_SVR, 0x100 | VEC_SPURIOUS)

    let per_sec: u64 = calibrate(state)
    if per_sec == 0 {
        wire_back(state)
        return false
    }
    kstate.set(state, pci.K2_SCALARS + S_ACTIVE, 1)
    timer_start(state, want_hz)
    if !timer_running(state) {
        regio.write32_at(base, R_LVT_TIMER, LVT_MASKED)
        regio.write32_at(base, R_TIMER_INIT, 0)
        kstate.set(state, pci.K2_SCALARS + S_ACTIVE, 0)
        wire_back(state)
        return false
    }
    return true
}

fn wire_back(state: u64) {
    let base: u64 = lapic(state)
    regio.write32_at(base, R_LVT_LINT0, 0x700)
}

fn timer_running(state: u64) -> bool {
    let base: u64 = lapic(state)
    let hz: u64 = kstate.get(state, pci.K2_SCALARS + S_TSCHZ)
    let a: u64 = regio.read32_at(base, R_TIMER_CUR)
    if hz == 0 {
        var i: u64 = 0
        while i < 2000000 {
            asm("pause")
            i = i + 1
        }
    } else {
        let t0: u64 = tsc()
        var laeuft: bool = true
        while laeuft {
            if tsc() - t0 >= hz / 1000 {
                laeuft = false
            }
        }
    }
    let b: u64 = regio.read32_at(base, R_TIMER_CUR)
    return a != b
}

fn timer_start(state: u64, want_hz: u64) {
    let base: u64 = lapic(state)
    var init_count: u64 = hz(state) / want_hz
    if init_count == 0 {
        init_count = 1
    }
    if init_count > 0xFFFFFFFF {
        init_count = 0xFFFFFFFF
    }
    kstate.set(state, pci.K2_SCALARS + S_DIVISOR, init_count)
    regio.write32_at(base, R_TIMER_DIV, DIV_16)
    regio.write32_at(base, R_LVT_TIMER, VEC_TIMER | LVT_PERIODIC)
    regio.write32_at(base, R_TIMER_INIT, init_count)
}

fn timer_rate(state: u64, mult: u64) {
    let base: u64 = lapic(state)
    let d: u64 = kstate.get(state, pci.K2_SCALARS + S_DIVISOR)
    if d == 0 || mult == 0 {
        return
    }
    var c: u64 = d * mult
    if c > 0xFFFFFFFF {
        c = 0xFFFFFFFF
    }
    regio.write32_at(base, R_TIMER_INIT, c)
}

fn timer_stop(state: u64) {
    let base: u64 = lapic(state)
    regio.write32_at(base, R_LVT_TIMER, LVT_MASKED)
    regio.write32_at(base, R_TIMER_INIT, 0)
}

fn eoi(state: u64) {
    regio.write32_at(lapic(state), R_EOI, 0)
}

fn window(state: u64) -> u64 {
    return lapic(state)
}

fn core_init(state: u64, index: u64) {
    var base_msr: u64 = rdmsr(MSR_APIC_BASE)
    if (base_msr & APIC_BASE_ENABLE) == 0 {
        wrmsr(MSR_APIC_BASE, base_msr | APIC_BASE_ENABLE)
    }
    let base: u64 = lapic(state)
    regio.write32_at(base, R_TPR, 0)
    regio.write32_at(base, R_DFR, 0xFFFFFFFF)
    if index < 8 {
        regio.write32_at(base, R_LDR, 1 << (24 + index))
    }
    regio.write32_at(base, R_LVT_TIMER, LVT_MASKED)
    regio.write32_at(base, R_LVT_LINT0, LVT_MASKED)
    regio.write32_at(base, R_LVT_LINT1, LVT_MASKED)
    regio.write32_at(base, R_LVT_ERROR, LVT_MASKED)
    regio.write32_at(base, R_ESR, 0)
    regio.write32_at(base, R_ESR, 0)
    regio.write32_at(base, R_SVR, 0x100 | VEC_SPURIOUS)
}

fn ipi(state: u64, dest: u64, low: u64) {
    let base: u64 = lapic(state)
    regio.write32_at(base, R_ESR, 0)
    regio.write32_at(base, R_ICR_HIGH, (dest & 0xFF) << 24)
    regio.write32_at(base, R_ICR_LOW, low & 0xFFFFF)
    var guard: u64 = 0
    while guard < 1000000 {
        if (regio.read32_at(base, R_ICR_LOW) & 0x1000) == 0 {
            return
        }
        guard = guard + 1
    }
}

fn esr_take(state: u64) -> u64 {
    let base: u64 = lapic(state)
    regio.write32_at(base, R_ESR, 0)
    return regio.read32_at(base, R_ESR)
}

fn ioread(base: u64, reg: u64) -> u64 {
    __mmio_write32(base as *mut u32, (reg & 0xFF) as u32)
    return __mmio_read32((base + 0x10) as *mut u32) as u64
}

fn iowrite(base: u64, reg: u64, v: u64) {
    __mmio_write32(base as *mut u32, (reg & 0xFF) as u32)
    __mmio_write32((base + 0x10) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn ioapic_entries(state: u64) -> u64 {
    let v: u64 = ioread(ioapic(state), 0x01)
    if v == 0xFFFFFFFF {
        return 0
    }
    return ((v >> 16) & 0xFF) + 1
}

fn route(state: u64, gsi: u64, vector: u64, dest: u64, level: bool, low: bool) {
    let base: u64 = ioapic(state)
    var lo: u64 = vector & 0xFF
    if low {
        lo = lo | (1 << 13)
    }
    if level {
        lo = lo | (1 << 15)
    }
    iowrite(base, 0x11 + gsi * 2, (dest & 0xFF) << 24)
    iowrite(base, 0x10 + gsi * 2, lo)
}

fn gsi_entry(state: u64, gsi: u64) -> u64 {
    return ioread(ioapic(state), 0x10 + gsi * 2)
}

fn mask_gsi(state: u64, gsi: u64) {
    let base: u64 = ioapic(state)
    let lo: u64 = ioread(base, 0x10 + gsi * 2)
    iowrite(base, 0x10 + gsi * 2, lo | (1 << 16))
}

fn pic_off() {
    serial.out8(0x21 as u16, 0xFF as u8)
    serial.io_wait()
    serial.out8(0xA1 as u16, 0xFF as u8)
    serial.io_wait()
    serial.out8(0x22 as u16, 0x70 as u8)
    serial.out8(0x23 as u16, 0x01 as u8)
}

const S3_LREGS: u64 = 8

fn s3_lreg(i: u64) -> u64 {
    if i == 0 { return R_TPR }
    if i == 1 { return R_LDR }
    if i == 2 { return R_DFR }
    if i == 3 { return R_LVT_LINT0 }
    if i == 4 { return R_LVT_LINT1 }
    if i == 5 { return R_LVT_ERROR }
    if i == 6 { return R_TIMER_DIV }
    return R_LVT_TIMER
}

fn s3_put(buf: u64, i: u64, v: u64) {
    __mmio_write64((buf + i * 8) as *mut u64, v)
}

fn s3_get(buf: u64, i: u64) -> u64 {
    return __mmio_read64((buf + i * 8) as *mut u64)
}

fn s3_save(state: u64, buf: u64) -> u64 {
    s3_put(buf, 0, 0)
    if !active(state) {
        return 0
    }
    let base: u64 = lapic(state)
    s3_put(buf, 1, rdmsr(MSR_APIC_BASE))
    s3_put(buf, 2, regio.read32_at(base, R_SVR))
    s3_put(buf, 3, regio.read32_at(base, R_TIMER_INIT))
    var i: u64 = 0
    while i < S3_LREGS {
        s3_put(buf, 4 + i, regio.read32_at(base, s3_lreg(i)))
        i = i + 1
    }
    var n: u64 = ioapic_entries(state)
    if n > 240 {
        n = 240
    }
    let io: u64 = ioapic(state)
    var g: u64 = 0
    while g < n {
        s3_put(buf, 16 + g * 2, ioread(io, 0x10 + g * 2))
        s3_put(buf, 17 + g * 2, ioread(io, 0x11 + g * 2))
        g = g + 1
    }
    s3_put(buf, 0, n)
    return n
}

fn s3_restore(state: u64, buf: u64) -> u64 {
    if !active(state) {
        return 0
    }
    wrmsr(MSR_APIC_BASE, s3_get(buf, 1))
    let base: u64 = lapic(state)
    var i: u64 = 0
    while i < S3_LREGS {
        regio.write32_at(base, s3_lreg(i), s3_get(buf, 4 + i))
        i = i + 1
    }
    regio.write32_at(base, R_ESR, 0)
    regio.write32_at(base, R_ESR, 0)
    regio.write32_at(base, R_SVR, s3_get(buf, 2))
    let n: u64 = s3_get(buf, 0)
    let io: u64 = ioapic(state)
    var g: u64 = 0
    while g < n {
        iowrite(io, 0x11 + g * 2, s3_get(buf, 17 + g * 2))
        iowrite(io, 0x10 + g * 2, s3_get(buf, 16 + g * 2))
        g = g + 1
    }
    pic_off()
    regio.write32_at(base, R_TIMER_INIT, s3_get(buf, 3))
    var bad: u64 = 0
    g = 0
    while g < n {
        let want: u64 = s3_get(buf, 16 + g * 2) & 0xFFFFAFFF
        let have: u64 = ioread(io, 0x10 + g * 2) & 0xFFFFAFFF
        if want != have {
            bad = bad + 1
        }
        g = g + 1
    }
    return bad
}
