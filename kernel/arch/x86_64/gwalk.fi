
import lib.kstate

export {
    walk, walk_mode, MODE_FLAT, MODE_PAE, MODE_LONG, MODE_PROT,
    GW_BAD,
    INS_BAD, INS_MOVCR_TO, INS_MOVCR_FROM, INS_WRMSR, INS_RDMSR,
    INS_CPUID, INS_HLT, INS_IN, INS_OUT, INS_INVLPG,
    decode, ins_kind, ins_len, ins_reg, ins_cr, ins_rex,
    DEC_WORDS
}

const GW_BAD: u64 = 0xFFFFFFFFFFFFFFFF

const MODE_FLAT: u64 = 0
const MODE_PROT: u64 = 1
const MODE_PAE: u64 = 2
const MODE_LONG: u64 = 3

const PTE_P: u64 = 1
const PTE_PS: u64 = 128
const ADDR_MASK: u64 = 0x000FFFFFFFFFF000

fn walk_mode(cr0: u64, cr4: u64, efer: u64) -> u64 {
    if (cr0 & 0x80000000) == 0 {
        return MODE_FLAT
    }
    if (efer & 0x400) != 0 {
        return MODE_LONG
    }
    if (cr4 & 0x20) != 0 {
        return MODE_PAE
    }
    return MODE_PROT
}

fn tab_read(gram: u64, gbytes: u64, gpa: u64) -> u64 {
    if gpa +% 8 > gbytes {
        return 0
    }
    return __mmio_read64((gram +% gpa) as *mut u64)
}

fn walk(gram: u64, gbytes: u64, cr3: u64, mode: u64, va: u64) -> u64 {
    if mode == MODE_FLAT {
        if va >= gbytes {
            return GW_BAD
        }
        return va
    }

    if mode == MODE_LONG {
        let pml4: u64 = cr3 & ADDR_MASK
        let e4: u64 = tab_read(gram, gbytes, pml4
            +% ((va >> 39) & 0x1FF) *% 8)
        if (e4 & PTE_P) == 0 {
            return GW_BAD
        }
        let e3: u64 = tab_read(gram, gbytes, (e4 & ADDR_MASK)
            +% ((va >> 30) & 0x1FF) *% 8)
        if (e3 & PTE_P) == 0 {
            return GW_BAD
        }
        if (e3 & PTE_PS) != 0 {
            return (e3 & 0x000FFFFFC0000000) +% (va & 0x3FFFFFFF)
        }
        let e2: u64 = tab_read(gram, gbytes, (e3 & ADDR_MASK)
            +% ((va >> 21) & 0x1FF) *% 8)
        if (e2 & PTE_P) == 0 {
            return GW_BAD
        }
        if (e2 & PTE_PS) != 0 {
            return (e2 & 0x000FFFFFFFE00000) +% (va & 0x1FFFFF)
        }
        let e1: u64 = tab_read(gram, gbytes, (e2 & ADDR_MASK)
            +% ((va >> 12) & 0x1FF) *% 8)
        if (e1 & PTE_P) == 0 {
            return GW_BAD
        }
        return (e1 & ADDR_MASK) +% (va & 0xFFF)
    }

    if mode == MODE_PAE {
        let pdpt: u64 = cr3 & 0xFFFFFFE0
        let e3: u64 = tab_read(gram, gbytes, pdpt
            +% ((va >> 30) & 3) *% 8)
        if (e3 & PTE_P) == 0 {
            return GW_BAD
        }
        let e2: u64 = tab_read(gram, gbytes, (e3 & ADDR_MASK)
            +% ((va >> 21) & 0x1FF) *% 8)
        if (e2 & PTE_P) == 0 {
            return GW_BAD
        }
        if (e2 & PTE_PS) != 0 {
            return (e2 & 0x000FFFFFFFE00000) +% (va & 0x1FFFFF)
        }
        let e1: u64 = tab_read(gram, gbytes, (e2 & ADDR_MASK)
            +% ((va >> 12) & 0x1FF) *% 8)
        if (e1 & PTE_P) == 0 {
            return GW_BAD
        }
        return (e1 & ADDR_MASK) +% (va & 0xFFF)
    }

    let pd: u64 = cr3 & 0xFFFFF000
    let i2: u64 = (va >> 22) & 0x3FF
    if pd +% i2 *% 4 +% 4 > gbytes {
        return GW_BAD
    }
    let e2: u64 = __mmio_read32((gram +% pd +% i2 *% 4) as *mut u32) as u64
    if (e2 & PTE_P) == 0 {
        return GW_BAD
    }
    if (e2 & PTE_PS) != 0 {
        return (e2 & 0xFFC00000) +% (va & 0x3FFFFF)
    }
    let pt: u64 = e2 & 0xFFFFF000
    let i1: u64 = (va >> 12) & 0x3FF
    if pt +% i1 *% 4 +% 4 > gbytes {
        return GW_BAD
    }
    let e1: u64 = __mmio_read32((gram +% pt +% i1 *% 4) as *mut u32) as u64
    if (e1 & PTE_P) == 0 {
        return GW_BAD
    }
    return (e1 & 0xFFFFF000) +% (va & 0xFFF)
}

const DEC_WORDS: u64 = 5
const D_KIND: u64 = 0
const D_LEN: u64 = 1
const D_REG: u64 = 2
const D_CR: u64 = 3
const D_REX: u64 = 4

const INS_BAD: u64 = 0
const INS_MOVCR_TO: u64 = 1
const INS_MOVCR_FROM: u64 = 2
const INS_WRMSR: u64 = 3
const INS_RDMSR: u64 = 4
const INS_CPUID: u64 = 5
const INS_HLT: u64 = 6
const INS_IN: u64 = 7
const INS_OUT: u64 = 8
const INS_INVLPG: u64 = 9

fn ins_kind(d: u64) -> u64 {
    return __mmio_read64((d +% D_KIND *% 8) as *mut u64)
}

fn ins_len(d: u64) -> u64 {
    return __mmio_read64((d +% D_LEN *% 8) as *mut u64)
}

fn ins_reg(d: u64) -> u64 {
    return __mmio_read64((d +% D_REG *% 8) as *mut u64)
}

fn ins_cr(d: u64) -> u64 {
    return __mmio_read64((d +% D_CR *% 8) as *mut u64)
}

fn ins_rex(d: u64) -> u64 {
    return __mmio_read64((d +% D_REX *% 8) as *mut u64)
}

fn dset(d: u64, n: u64, v: u64) {
    __mmio_write64((d +% n *% 8) as *mut u64, v)
}

fn fetch(gram: u64, gbytes: u64, cr3: u64, mode: u64, lin: u64) -> u64 {
    let gpa: u64 = walk(gram, gbytes, cr3, mode, lin)
    if gpa == GW_BAD {
        return 0x100
    }
    if gpa >= gbytes {
        return 0x100
    }
    return kstate.get8(gram +% gpa)
}

fn decode(gram: u64, gbytes: u64, cr3: u64, mode: u64, lin: u64,
        d: u64) -> u64 {
    var n: u64 = 0
    while n < DEC_WORDS {
        dset(d, n, 0)
        n = n +% 1
    }
    var off: u64 = 0
    var rex: u64 = 0
    var op: u64 = 0

    var weiter: bool = true
    while weiter {
        op = fetch(gram, gbytes, cr3, mode, lin +% off)
        if op > 0xFF {
            return 0
        }
        if op == 0x66 || op == 0x67 || op == 0xF0 || op == 0xF2
            || op == 0xF3 || op == 0x2E || op == 0x36 || op == 0x3E
            || op == 0x26 || op == 0x64 || op == 0x65 {
            off = off +% 1
        } else {
            if op >= 0x40 && op <= 0x4F && mode == MODE_LONG {
                rex = op
                off = off +% 1
            } else {
                weiter = false
            }
        }
        if off > 5 {
            return 0
        }
    }
    dset(d, D_REX, rex)

    if op == 0xF4 {
        dset(d, D_KIND, INS_HLT)
        dset(d, D_LEN, off +% 1)
        return off +% 1
    }
    if op == 0xEC || op == 0xED {
        dset(d, D_KIND, INS_IN)
        dset(d, D_LEN, off +% 1)
        return off +% 1
    }
    if op == 0xEE || op == 0xEF {
        dset(d, D_KIND, INS_OUT)
        dset(d, D_LEN, off +% 1)
        return off +% 1
    }
    if op == 0xE4 || op == 0xE5 {
        dset(d, D_KIND, INS_IN)
        dset(d, D_LEN, off +% 2)
        return off +% 2
    }
    if op == 0xE6 || op == 0xE7 {
        dset(d, D_KIND, INS_OUT)
        dset(d, D_LEN, off +% 2)
        return off +% 2
    }

    if op != 0x0F {
        return 0
    }
    let op2: u64 = fetch(gram, gbytes, cr3, mode, lin +% off +% 1)
    if op2 > 0xFF {
        return 0
    }
    if op2 == 0x30 {
        dset(d, D_KIND, INS_WRMSR)
        dset(d, D_LEN, off +% 2)
        return off +% 2
    }
    if op2 == 0x32 {
        dset(d, D_KIND, INS_RDMSR)
        dset(d, D_LEN, off +% 2)
        return off +% 2
    }
    if op2 == 0xA2 {
        dset(d, D_KIND, INS_CPUID)
        dset(d, D_LEN, off +% 2)
        return off +% 2
    }

    if op2 == 0x20 || op2 == 0x22 {
        let modrm: u64 = fetch(gram, gbytes, cr3, mode, lin +% off +% 2)
        if modrm > 0xFF {
            return 0
        }
        if (modrm & 0xC0) != 0xC0 {
            return 0
        }
        var cr: u64 = (modrm >> 3) & 7
        if (rex & 4) != 0 {
            cr = cr +% 8
        }
        var reg: u64 = modrm & 7
        if (rex & 1) != 0 {
            reg = reg +% 8
        }
        dset(d, D_CR, cr)
        dset(d, D_REG, reg)
        if op2 == 0x22 {
            dset(d, D_KIND, INS_MOVCR_TO)
        } else {
            dset(d, D_KIND, INS_MOVCR_FROM)
        }
        dset(d, D_LEN, off +% 3)
        return off +% 3
    }

    return 0
}
