const PT_D: u64 = 64

fn rd(vmcb: u64, off: u64) -> u64 {
    return __mmio_read64((vmcb +% off) as *mut u64)
}

fn wr(vmcb: u64, off: u64, v: u64) {
    __mmio_write64((vmcb +% off) as *mut u64, v)
}

fn rd32(vmcb: u64, off: u64) -> u64 {
    return __mmio_read32((vmcb +% off) as *mut u32) as u64
}

fn wr32(vmcb: u64, off: u64, v: u64) {
    __mmio_write32((vmcb +% off) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn wr16(vmcb: u64, off: u64, v: u64) {
    __mmio_write16((vmcb +% off) as *mut u16, (v & 0xFFFF) as u16)
}

fn wr8(vmcb: u64, off: u64, v: u64) {
    __mmio_write8((vmcb +% off) as *mut u8, (v & 0xFF) as u8)
}

fn seg(vmcb: u64, off: u64, sel: u64, attr: u64, limit: u64, base: u64) {
    wr16(vmcb, off, sel)
    wr16(vmcb, off +% 2, attr)
    wr32(vmcb, off +% 4, limit)
    wr(vmcb, off +% 8, base)
}

fn seg_base(vmcb: u64, off: u64) -> u64 {
    return rd(vmcb, off +% 8)
}

fn seg_sel(vmcb: u64, off: u64) -> u64 {
    return __mmio_read16((vmcb +% off) as *mut u16) as u64
}

fn zero_page(p: u64) {
    var i: u64 = 0
    while i < 4096 {
        __mmio_write64((p +% i) as *mut u64, 0)
        i = i +% 8
    }
}
