// SPDX-License-Identifier: GPL-2.0-only
// kernel/trap.fi -- round 59: what happens after an interrupt.
//
// `isr.s` has saved the registers and knows the vector; from here on
// everything is Firn. Three cases:
//
//   * vector < 32: an EXCEPTION. The processor has no intention of going
//     on; it is reported with error code, instruction pointer, CR2 and
//     all sixteen general purpose registers -- and then the machine
//     stops. A kernel that silently continues after a #GP is lying.
//   * vector 32: the timer. Counter up, end of interrupt.
//   * vector 33: the keyboard. Read the scan code, translate, note.
//
// ROUND 62 adds the two things that make an operating system out of it.
// The timer now hands over to the SCHEDULER after the end-of-interrupt --
// that is the point at which a task loses the processor against its will.
// And an exception is no longer the end of the world: if it happened in
// RING 3 and there is a process behind it, that process dies and the
// kernel goes on. Only a fault in ring 0 still stops the machine, because
// there is nobody it could belong to.
//
// The frame is what `isr.s` built; the offsets are documented there and
// stand once more below.

import serial
import lib.kstate
import drv.hid.kbd
import gfx.gfx
import drv.con.sercon
import pwr.power
import pwr.pmon
import sched.sched
import apic
import drv.blk.nvme
import usb.usb
import drv.snd.audio
import net.netdev
import net.inet
import acpi.acpiev
import arch.cpu
import sched.rand
import sched.time
import sched.signal
import fs.evfd
import sched.proc
import arch.msr
import arch.safemem
import arch.arch
import fpu
import klog
import lib.ksymtab
import diag.crash
import diag.blkrace
import bus.notice
import diag.safe
import drv.wdt.wdt
import diag.hang
import diag.nmiguard

export {
    entry, nmi_strays,
    isr_us_last, isr_us_max, ticks_lost, ticks_late, ticks_lost_at, bh_tief,
    dead_pid, dead_num
}

// Offsets in the trap frame (see isr.s).
const F_VECTOR: u64 = 120
const F_ERROR: u64 = 128
const F_RIP: u64 = 136
const F_CS: u64 = 144
const F_RFLAGS: u64 = 152
const F_RSP: u64 = 160
const F_RBP: u64 = 80
const F_SS: u64 = 168

const VEC_TIMER: u64 = 32
const VEC_KEYBOARD: u64 = 33
const VEC_SERIAL: u64 = 36
const VEC_SCI: u64 = 37
const VEC_MOUSE: u64 = 46
// ROUND K2. The disk controller signals its completion on 44 -- over
// MSI-X, where it writes the vector as data to 0xFEE00000, or over its
// interrupt pin through the I/O APIC. Both paths end here, which is what
// makes the two comparable. 47 is what the local APIC delivers when it
// has nothing to deliver: a spurious interrupt gets NO end-of-interrupt,
// because the controller never began one.
const VEC_NVME: u64 = 44
// ROUND K8: the network card reports on 45, over MSI-X or over its pin
// through the I/O APIC -- the same two paths the disk has, and the same
// stub out of `isr.s`. The handler does nothing but acknowledge and
// count; the frames are taken out of the ring by the network task.
const VEC_NET: u64 = 45
const VEC_XHCI: u64 = 43
const VEC_AUDIO: u64 = 42
const VEC_SPURIOUS: u64 = 47
const GP_VECTOR: u64 = 13
const NM_VECTOR: u64 = 7

fn word(frame: u64, off: u64) -> u64 {
    return __mmio_read64((frame + off) as *mut u64)
}

// `KERNEL_TRAP` out of isr.s. rdi = frame, rsi = kernel data area.
fn entry(frame: u64, state: u64) {
    if halt_all != 0 {
        power.halt_forever()
    }
    let vector: u64 = word(frame, F_VECTOR)
    kstate.add(state, kstate.TRAPS, 1)
    kstate.set(state, kstate.LAST_TRAP, vector)
    if vector < 32 {
        if vector == 2 {
            let depth: u64 = nmiguard.enter(state, frame)
            if !hang.nmi(state, frame) {
                nmi_stray = nmi_stray + 1
            }
            nmiguard.leave(state, frame, depth)
            return
        }
        if (word(frame, F_CS) & 3) == 0 {
            nmiguard.note_fault(state, frame, vector)
        }
        if vector == GP_VECTOR && (word(frame, F_CS) & 3) == 0 {
            let fix: u64 = msr.catch_rip(state, word(frame, F_RIP))
            if fix != 0 {
                __mmio_write64((frame + F_RIP) as *mut u64, fix)
                return
            }
        }
        if vector == 14 && (word(frame, F_CS) & 3) == 0 {
            let pfix: u64 = msr.catch_rip(state, word(frame, F_RIP))
            if pfix != 0 {
                __mmio_write64((frame + F_RIP) as *mut u64, pfix)
                return
            }
        }
        if vector == NM_VECTOR {
            if fpu.on_nm(state, sched.fpu_area(state, sched.current(state))) {
                return
            }
        }
        if vector == 14 && user_fault(frame, state) {
            if !kstate.mode_on(state, kstate.M_NOSTACK) {
                if proc.grow_stack(state, sched.current(state), cr2(),
                        word(frame, F_RSP)) {
                    return
                }
            }
        }
        // WP-DEMAND: a page of a sparse shared object (memfd/SHM) that nobody has touched yet is made now, zeroed, and the instruction
        // repeats. Gegenprobe: `nodemand` on the kernel command line.
        if vector == 14 && user_fault(frame, state) {
            if !kstate.mode_on(state, kstate.M_NODEMAND) {
                if proc.demand_fault(state, sched.current(state), cr2(), word(frame, F_ERROR)) {
                    return
                }
                if proc.lazy_fault(state, sched.current(state), cr2(), word(frame, F_ERROR)) {
                    return
                }
            }
        }
        if user_fault(frame, state) {
            let cur: u64 = sched.current(state)
            let sig: u64 = signal.signal_of(vector)
            report_user(frame, state, vector, cur,
                signal.lethal(state, cur, sig))
            // RUNDE UNTERBAU: the page-fault address rides in the error word (above its low 16 bits) into the signal frame, where it
            // becomes `si_addr`; the hardware does not look at this word again (`iretq` pops it off beforehand).
            if vector == 14 {
                __mmio_write64((frame + F_ERROR) as *mut u64, (word(frame, F_ERROR) & 0xFFFF) | (cr2() << 16))
            }
            signal.fault(state, cur, vector)
            signal.check_trap(state, cur, frame)
            return
        }
        report(frame, state, vector)
        // does not return
    }
    if vector == VEC_SPURIOUS && apic.active(state) {
        apic.spurious_hit(state)
        return
    }
    if vector == VEC_TIMER {
        // ROUND K5: the global tick is what `sleep` and every counter of
        // round 59 count in, and it has to keep meaning "one hundredth of
        // a second" -- not "one hundredth divided by the number of cores".
        // So the BOOT processor counts it and the others count their own
        // (`cpu.C_TICKS`, in `sched.on_tick`).
        let isr_t0: u64 = time.tsc()
        if cpu.here(state) == 0 {
            marken_nachfuehren(state)
        }
        rand.stir(state, time.tsc())
        // The end-of-interrupt has to go out BEFORE the switch: the
        // controller lets nothing through until it has seen it, and the
        // task that is switched to would run without a timer.
        eoi(state, vector)
        if cpu.here(state) == 0 && bh_inside != 0 {
            ticks_spaet = ticks_spaet + 1
            return
        }
        // ============================== RUNDE BLECHEINGABE: DER HERZSCHLAG
        // On nine ticks in ten this compares two numbers and returns;
        // what the tenth costs is measured, not asserted (`PM_COST`).
        if cpu.here(state) == 0 {
            wdt.tick(state)
            hang.stall(state, frame, wdt.starved_s(state))
        }
        hang.beat(state, frame)
        blkrace.tick(state)
        pmon.tick(state)
        audio.tick(state)
        if cpu.here(state) == 0 && usb.ready(state) {
            if (kstate.get(state, kstate.TICKS) % 25) == 0 {
                usb.port_watch(state)
                usb.silence_check(state)
            }
        }
        lower_chunk(state, isr_t0)
        sched.on_tick(state)
        signal.alarm_check(state)
        evfd.tick(state)
        signal.check_trap(state, sched.current(state), frame)
        return
    }
    if vector == VEC_SERIAL {
        sercon.irq(state)
        eoi(state, vector)
        return
    }
    if vector == VEC_KEYBOARD {
        rand.stir(state, time.tsc())
        kbd.irq(state)
        eoi(state, vector)
        return
    }
    if vector == VEC_MOUSE {
        rand.stir(state, time.tsc())
        gfx.mouse_irq(state)
        gfx.wm_poll(state)
        eoi(state, vector)
        return
    }
    if vector >= VEC_AUDIO && vector <= VEC_NET + 1 {
        acpiev.shared(state, vector)
    }
    if vector == VEC_NVME {
        nvme.irq(state)
        eoi(state, vector)
        return
    }
    if vector == VEC_XHCI {
        rand.stir(state, time.tsc())
        usb.irq(state)
        gfx.wm_poll(state)
        eoi(state, vector)
        return
    }
    if vector == VEC_AUDIO {
        audio.irq(state)
        eoi(state, vector)
        return
    }
    if vector == VEC_NET {
        netdev.irq(state)
        inet.wake(state)
        eoi(state, vector)
        return
    }
    // ROUND NETMON: the SECOND card, on the next vector. Its frames are
    // not the stack's -- they are forwarded by `kernel/share.fi` -- so
    // the network task is woken all the same, because that task is what
    // turns the crank for both cards.
    if vector == VEC_NET + 1 {
        netdev.irq_on(state, 1)
        inet.wake(state)
        eoi(state, vector)
        return
    }
    if vector == VEC_SCI {
        acpiev.irq(state)
        eoi(state, vector)
        return
    }
    eoi(state, vector)
}

// Did the fault come out of a PROCESS? Two conditions, and both have to
// hold: the processor was in ring 3 (the two low bits of cs), and the
// current task is a user process. The ring 3 excursion of round 59 has no
// task behind it -- a fault in it still stops the kernel, and the
// counter-check of that round keeps measuring what it measured.
fn user_fault(frame: u64, state: u64) -> bool {
    if (word(frame, F_CS) & 3) != 3 {
        return false
    }
    let cur: u64 = sched.current(state)
    return sched.tget(state, cur, sched.T_KIND) == sched.K_USER
}

fn report_user(frame: u64, state: u64, vector: u64, cur: u64, dies: bool) {
    var s_kill: [u8; 13] = "user fault: \0"
    var s_pid: [u8; 6] = "pid=\0\0"
    var s_vec: [u8; 10] = "  vector=\0"
    var s_err: [u8; 7] = "  err=\0"
    var s_cr2: [u8; 7] = "  cr2=\0"
    var s_rip: [u8; 7] = "  rip=\0"
    var s_dead: [u8; 20] = "  -- process killed\0"
    var s_sig: [u8; 13] = "  -> caught \0"
    serial.puts((&s_kill[0]) as u64)
    serial.puts((&s_pid[0]) as u64)
    serial.dec(sched.tget(state, cur, sched.T_PID))
    serial.puts((&s_vec[0]) as u64)
    serial.dec(vector)
    serial.puts((&s_err[0]) as u64)
    serial.hex(word(frame, F_ERROR))
    serial.puts((&s_cr2[0]) as u64)
    serial.hex(cr2())
    serial.puts((&s_rip[0]) as u64)
    serial.hex(word(frame, F_RIP))
    if dies {
        serial.puts((&s_dead[0]) as u64)
    } else {
        serial.puts((&s_sig[0]) as u64)
        signal.say_name(signal.signal_of(vector))
    }
    serial.nl()
    trace_say(state, cur, word(frame, F_RSP))
    if dies {
        var nm: [u8; 24] = [0 as u8; 24]
        var k: u64 = 0
        while k < 23 && pmon.name_at(state, cur, k) != 0 {
            nm[k as usize] = (pmon.name_at(state, cur, k) & 0xFF) as u8
            k = k + 1
        }
        nm[k as usize] = 0 as u8
        let _ok: bool = crash.prog_bericht(state,
            regblock_fuellen(frame), word(frame, F_RIP),
            word(frame, F_CS), word(frame, F_RFLAGS),
            word(frame, F_RSP), word(frame, F_SS),
            word(frame, F_ERROR), cr2(), vector,
            sched.tget(state, cur, sched.T_PID),
            (&nm[0 as usize]) as u64,
            (&uspur[0 as usize]) as u64, uspur_n)
        notice.crash(state, (&nm[0 as usize]) as u64)
    }
}

//     #0 0x4007f056  #1 0x4007e202  #2 0x4007e201  #3 0x4007e200 ...
const U_TEXT_LO: u64 = 0x400000
const U_TEXT_HI: u64 = 0x500000
const U_PROG_LO: u64 = 0x40100000
const U_PROG_HI: u64 = 0x40400000

fn how_code(v: u64) -> bool {
    if v >= U_TEXT_LO && v < U_TEXT_HI {
        return true
    }
    return v >= U_PROG_LO && v < U_PROG_HI
}

static mut uspur: [u64; 8] = [0 as u64; 8]
static mut uspur_n: u64 = 0

fn trace_say(state: u64, cur: u64, rsp: u64) {
    var s_sp: [u8; 14] = "  spur rsp=\0\0\0"
    var s_at: [u8; 3] = " \0\0"
    var s_no: [u8; 12] = "  (keine)\0\0\0"
    serial.puts((&s_sp[0]) as u64)
    serial.hex(rsp)
    if rsp == 0 {
        serial.nl()
        return
    }
    var s_ph: [u8; 8] = "  phys=\0"
    var s_ks: [u8; 10] = "  kstack=\0"
    serial.puts((&s_ph[0]) as u64)
    serial.hex(proc.translate(state, cur, rsp))
    serial.puts((&s_ks[0]) as u64)
    serial.hex(sched.tget(state, cur, sched.T_KSTACK))
    var i: u64 = 0
    var n: u64 = 0
    while i < 256 && n < 8 {
        let a: u64 = rsp + i * 8
        let phys: u64 = proc.translate(state, cur, a)
        if phys != 0 {
            let v: u64 = __mmio_read64(phys as *mut u64)
            if how_code(v) {
                serial.puts((&s_at[0]) as u64)
                serial.hex(v)
                if n < 8 {
                    uspur[n as usize] = v
                }
                n = n + 1
            }
        }
        i = i + 1
    }
    uspur_n = n
    if uspur_n > 8 {
        uspur_n = 8
    }
    if n == 0 {
        serial.puts((&s_no[0]) as u64)
    }
    serial.nl()
    tot_pid = sched.tget(state, cur, sched.T_PID)
    dead_count = dead_count + 1
}

static mut tot_pid: u64 = 0
static mut nmi_stray: u64 = 0

fn nmi_strays() -> u64 {
    return nmi_stray
}
static mut dead_count: u64 = 0

fn dead_pid() -> u64 {
    return tot_pid
}

fn dead_num() -> u64 {
    return dead_count
}

static mut isr_us_l: u64 = 0
static mut isr_us_m: u64 = 0
static mut tick_tsc: u64 = 0
static mut ticks_dropped: u64 = 0
static mut ticks_spaet: u64 = 0
static mut ticks_lost_mark: u64 = 0
static mut bh_inside: u64 = 0
static mut bh_max: u64 = 0

fn isr_us_last() -> u64 {
    return isr_us_l
}

fn isr_us_max() -> u64 {
    return isr_us_m
}

fn ticks_lost() -> u64 {
    return ticks_dropped
}

fn ticks_late() -> u64 {
    return ticks_spaet
}

fn ticks_lost_at() -> u64 {
    return ticks_lost_mark
}

fn bh_tief() -> u64 {
    return bh_max
}

fn marken_nachfuehren(state: u64) {
    let now: u64 = time.tsc()
    let khz: u64 = time.khz(state)
    let je: u64 = khz *% (time.TICK_NS / 1000000)
    if khz == 0 || je == 0 || tick_tsc == 0 || now <= tick_tsc {
        tick_tsc = now
        kstate.add(state, kstate.TICKS, 1)
        return
    }
    var n: u64 = (now - tick_tsc) / je
    if n == 0 {
        kstate.add(state, kstate.TICKS, 1)
        return
    }
    if n > time.TICK_HZ {
        n = time.TICK_HZ
        tick_tsc = now
    } else {
        tick_tsc = tick_tsc +% n *% je
    }
    if n > 1 {
        ticks_dropped = ticks_dropped + (n - 1)
        ticks_lost_mark = kstate.get(state, kstate.TICKS)
    }
    kstate.add(state, kstate.TICKS, n)
}

fn lower_chunk(state: u64, t0: u64) {
    if cpu.here(state) != 0 {
        return
    }
    bh_inside = 1
    if bh_inside > bh_max {
        bh_max = bh_inside
    }
    arch.irq_on()
    serial.pump() // W-X3: drain the deferred serial ring (one FIFO burst, never waits)
    gfx.beat_tick(state)
    gfx.stall_tick(state)
    gfx.table_tick(state)
    serial.pump()
    arch.irq_off()
    bh_inside = 0
    let khz: u64 = time.khz(state)
    let je: u64 = khz / 1000
    if je == 0 {
        return
    }
    let t1: u64 = time.tsc()
    if t1 <= t0 {
        return
    }
    isr_us_l = (t1 - t0) / je
    if isr_us_l > isr_us_m {
        isr_us_m = isr_us_l
    }
}

fn eoi(state: u64, vector: u64) {
    if apic.active(state) {
        apic.eoi(state)
        return
    }
    if vector >= 40 {
        serial.out8(0xA0 as u16, 0x20 as u8)
    }
    serial.out8(0x20 as u16, 0x20 as u8)
}

// ------------------------------------------------------- the exception

fn cr2() -> u64 {
    return asm("mov rax, cr2", out("rax"))
}

// ====================================================== RUNDE BLECHKERN
const KERN_LO: u64 = 0x100000
// RUNDE PROTOKOLL: FUENF WAREN ZU WENIG.
const TRACE_MAX: u64 = 16

static mut ktrace: [u64; 16] = [0 as u64; 16]
static mut ktrace_n: u64 = 0
static mut halt_all: u64 = 0

const KSTACK_SPAN: u64 = 0x40000
const ART_CHAIN: u64 = 1
const ART_SCAN: u64 = 2
static mut ktrace_kind: u64 = 0

fn ktrace_chain(state: u64, rsp: u64, rbp: u64, hi: u64) {
    ktrace_n = safemem.chain(state, rsp, rbp, KSTACK_SPAN, KERN_LO, hi,
        (&ktrace[0]) as u64, TRACE_MAX)
}

fn ktrace_build(state: u64, rsp: u64, rbp: u64) {
    ktrace_n = 0
    ktrace_kind = 0
    if rsp == 0 || rsp < KERN_LO {
        return
    }
    var hi: u64 = __mmio_read64((kstate.get(state, kstate.VECTORS)
            + 74 * 8) as *mut u64)
    if hi <= KERN_LO {
        hi = kstate.get(state, kstate.KERNEL_END)
    }
    if hi <= KERN_LO {
        return
    }
    if !kstate.mode_on(state, kstate.M_STAPELSCAN) {
        ktrace_chain(state, rsp, rbp, hi)
        if ktrace_n > 0 {
            ktrace_kind = ART_CHAIN
            return
        }
    }
    ktrace_kind = ART_SCAN
    var i: u64 = 0
    while i < 512 && ktrace_n < TRACE_MAX {
        var v: u64 = 0
        if !safemem.read64(state, rsp + i * 8, (&v) as u64) {
            return
        }
        if v >= KERN_LO && v < hi {
            ktrace[ktrace_n as usize] = v
            ktrace_n = ktrace_n + 1
        }
        i = i + 1
    }
}

fn ktrace_say() {
    var s_a: [u8; 10] = "  kspur:\0\0"
    var s_k: [u8; 12] = "  (keine)   "
    var s_e: [u8; 7] = "      \0"
    var s_ke: [u8; 14] = " rahmenkette\0\0"
    var s_sc: [u8; 13] = " stapelscan\0\0"
    serial.puts((&s_a[0]) as u64)
    if ktrace_kind == ART_CHAIN {
        serial.puts((&s_ke[0]) as u64)
    }
    if ktrace_kind == ART_SCAN {
        serial.puts((&s_sc[0]) as u64)
    }
    if ktrace_n == 0 {
        serial.puts((&s_k[0]) as u64)
        serial.nl()
        return
    }
    //     sched.irq_restore+0x11 (sched.fi:1046)
    serial.nl()
    var i: u64 = 0
    while i < ktrace_n {
        serial.puts((&s_e[0]) as u64)
        ksymtab.say_addr(ktrace[i as usize])
        serial.nl()
        i = i + 1
    }
}

fn stoppzahl(state: u64) -> u64 {
    if !apic.active(state) || cpu.count(state) < 2 {
        return 0
    }
    return cpu.count(state) - 1
}

fn stop_all(state: u64) {
    halt_all = 1
    if stoppzahl(state) == 0 {
        return
    }
    apic.ipi(state, 0, 0xC4400)
}

static mut rep_own: [u64; 1] = [0 as u64; 1]
static mut rep_depth: u64 = 0
static mut rep_first: u64 = 0
static mut rep_cr2: u64 = 0

// Another core is already writing the report. Give it time; if it never
// finishes (it may hang itself), this core does the reset that
// `absturzneustart` promised, so the machine does not stand forever.
fn other_core_waits(state: u64) {
    asm("cli")
    if !kstate.mode_on(state, kstate.M_PANICBOOT) || safe.exhausted() {
        power.halt_forever()
    }
    var hz: u64 = apic.tsc_hz(state)
    if hz < 100000000 || hz > 10000000000 {
        hz = 4000000000
    }
    let t0: u64 = apic.tsc()
    while apic.tsc() - t0 < hz * (PANIC_REBOOT_S + 20) {
        asm("pause")
    }
    power.acpi_reset(state)
    power.halt_forever()
}

fn report(frame0: u64, state: u64, vector0: u64) {
    wdt.on_panic()
    // Four octets per name, so that the index is a multiplication and not
    // a search: entry n starts at 4 * n.
    var names: [u8; 128] = "#DE\0#DB\0NMI\0#BP\0#OF\0#BR\0#UD\0#NM\0#DF\0#CO\0#TS\0#NP\0#SS\0#GP\0#PF\0r15\0#MF\0#AC\0#MC\0#XM\0#VE\0#CP\0r22\0r23\0r24\0r25\0r26\0#HV\0#VC\0#SX\0r30\0r31\0"
    var head: [u8; 15] = "*** EXCEPTION \0"
    var s_err: [u8; 7] = "  err=\0"
    var s_cr2: [u8; 7] = "  cr2=\0"
    var s_rip: [u8; 6] = "rip=\0\0"
    var s_cs: [u8; 6] = "  cs=\0"
    var s_flg: [u8; 10] = "  rflags=\0"
    var s_rsp: [u8; 8] = "  rsp=\0\0"
    var s_ss: [u8; 6] = "  ss=\0"
    var s_tail: [u8; 20] = "*** kernel halted\0\0\0"
    var s_hint: [u8; 83] = "*** hint: photograph this screen. BIOS: Secure Boot OFF, SATA mode AHCI (not RAID)\0"
    // ============================================ DELL, 27.09.2026
    // ONE REPORT, AND IT IS THE FIRST FAULT.
    //
    // The Dell's panic picture of 27.09.2026 showed a fault INSIDE the
    // report of an earlier one (the stack scan still held trap.report
    // and its serial output under it) -- the first fault, the one that
    // mattered, was painted over by the second. Now:
    //   * another core already reporting: this one keeps out of the way;
    //   * a fault during this core's own report (depth 2): the FIRST
    //     frame is still intact on the stack above, so it is reported
    //     again, and the second fault goes into three log lines that the
    //     picture and the report both show under PROTOKOLL;
    //   * a third fault: nothing more is tried.
    var frame: u64 = frame0
    var vector: u64 = vector0
    let me: u64 = cpu.here(state) + 1
    let owner: u64 = __atomic_swap((&rep_own[0 as usize]) as u64 as *mut u64, 0, me)
    if owner != 0 && owner != me {
        other_core_waits(state)
    }
    rep_depth = rep_depth + 1
    var c2: u64 = cr2()
    if rep_depth == 1 {
        rep_first = frame
        rep_cr2 = c2
        crash.doppel_check()
    } else if rep_depth == 2 {
        var s_src: [u8; 5] = "trap\0"
        var s_v: [u8; 38] = "NESTED: 2nd error in the report, vec \0"
        var s_r: [u8; 15] = "2. fehler rip \0"
        var s_c: [u8; 15] = "2. fehler cr2 \0"
        var s_n: [u8; 39] = "*** fault during the report (nested): \0"
        serial.puts((&s_n[0]) as u64)
        serial.dec(vector)
        serial.put(32 as u8)
        serial.hex(word(frame, F_RIP))
        serial.put(32 as u8)
        serial.hex(c2)
        serial.nl()
        klog.sayn(state, klog.L_ERROR, (&s_src[0]) as u64, (&s_v[0]) as u64, vector)
        klog.sayh(state, klog.L_ERROR, (&s_src[0]) as u64, (&s_r[0]) as u64,
            word(frame, F_RIP))
        klog.sayh(state, klog.L_ERROR, (&s_src[0]) as u64, (&s_c[0]) as u64, c2)
        frame = rep_first
        vector = word(frame, F_VECTOR)
        c2 = rep_cr2
    } else {
        var s_3: [u8; 30] = "*** third fault -- giving up\0\0"
        serial.puts((&s_3[0]) as u64)
        serial.nl()
        if kstate.mode_on(state, kstate.M_PANICBOOT) {
            panic_reboot(state)
        }
        power.halt_forever()
    }

    serial.nl()
    serial.puts((&head[0]) as u64)
    serial.dec(vector)
    serial.put(32 as u8)
    serial.puts((&names[0]) as u64 + vector * 4)
    serial.puts((&s_err[0]) as u64)
    serial.hex(word(frame, F_ERROR))
    if vector == 14 {
        serial.puts((&s_cr2[0]) as u64)
        serial.hex(c2)
    }
    serial.nl()

    serial.put(32 as u8)
    serial.put(32 as u8)
    serial.puts((&s_rip[0]) as u64)
    serial.hex(word(frame, F_RIP))
    serial.puts((&s_cs[0]) as u64)
    serial.hex(word(frame, F_CS))
    serial.puts((&s_flg[0]) as u64)
    serial.hex(word(frame, F_RFLAGS))
    serial.puts((&s_rsp[0]) as u64)
    serial.hex(word(frame, F_RSP))
    serial.puts((&s_ss[0]) as u64)
    serial.hex(word(frame, F_SS))
    serial.nl()

    registers(frame)
    ktrace_build(state, word(frame, F_RSP), word(frame, F_RBP))
    ktrace_say()
    var s_lg: [u8; 32] = "*** die letzten Protokollzeilen\0"
    serial.puts((&s_lg[0]) as u64)
    serial.nl()
    klog.dump_tail(state, 50)
    let _bok: bool = crash.kern_bericht(state, regblock_fuellen(frame),
        word(frame, F_RIP), word(frame, F_CS), word(frame, F_RFLAGS),
        word(frame, F_RSP), word(frame, F_SS), word(frame, F_ERROR),
        c2, vector, (&ktrace[0 as usize]) as u64, ktrace_n)
    serial.puts((&s_hint[0]) as u64)
    serial.nl()
    serial.puts((&s_tail[0]) as u64)
    serial.nl()
    gfx.report_crash(state, vector, word(frame, F_ERROR), word(frame, F_RIP),
        c2, word(frame, F_RSP), word(frame, F_CS), cpu.here(state),
        (&ktrace[0]) as u64, ktrace_n, stoppzahl(state))
    gfx.panikbild(state, vector, word(frame, F_ERROR), word(frame, F_RIP),
        c2, word(frame, F_RSP), word(frame, F_CS),
        word(frame, F_RFLAGS), word(frame, F_SS), cpu.here(state),
        (&regblock[0 as usize]) as u64,
        (&ktrace[0 as usize]) as u64, ktrace_n, crash.last_file())
    if kstate.mode_on(state, kstate.M_PANICBOOT) {
        // `absturzneustart`: leave the picture up long enough to be
        // photographed, then reset. The report is already on its way
        // into the reserved band, so the next start picks it up.
        stop_all(state)
        gfx.panik_present(state)
        panic_reboot(state)
    }
    if kstate.mode_on(state, kstate.M_CRASH) {
        stop_all(state)
        gfx.panik_present(state)
        power.halt_forever()
    }
    power.shutdown(power.EXIT_TRAP)
}

// Wait about PANIC_REBOOT_S seconds on the time stamp counter (interrupts
// are off, the timer is gone) and reset the machine. If the reset does
// not take, stand still like `absturzhalt` would.
const PANIC_REBOOT_S: u64 = 20

fn panic_reboot(state: u64) {
    var s_w: [u8; 36] = "*** reset in 20 s (absturzneustart)\0"
    var s_g: [u8; 43] = "*** no reset: failed boots in a row (safe)\0"
    if safe.exhausted() {
        serial.puts((&s_g[0]) as u64)
        serial.nl()
        power.halt_forever()
    }
    serial.puts((&s_w[0]) as u64)
    serial.nl()
    var hz: u64 = apic.tsc_hz(state)
    if hz < 100000000 || hz > 10000000000 {
        hz = 4000000000
    }
    let t0: u64 = apic.tsc()
    let want: u64 = hz * PANIC_REBOOT_S
    while apic.tsc() - t0 < want {
        asm("pause")
    }
    power.acpi_reset(state)
    power.halt_forever()
}

static mut regblock: [u64; 16] = [0 as u64; 16]

fn regblock_fuellen(frame: u64) -> u64 {
    var offs: [u8; 16] = [14 as u8, 11 as u8, 13 as u8, 12 as u8,
        9 as u8, 8 as u8, 10 as u8, 20 as u8,
        7 as u8, 6 as u8, 5 as u8, 4 as u8,
        3 as u8, 2 as u8, 1 as u8, 0 as u8]
    var i: u64 = 0
    while i < 16 {
        regblock[i as usize] = word(frame, offs[i as usize] as u64 * 8)
        i = i + 1
    }
    return (&regblock[0 as usize]) as u64
}

// All sixteen, four per line. `rsp` comes out of the processor's frame,
// the other fifteen out of the pushes in isr.s.
fn registers(frame: u64) {
    var names: [u8; 64] = "rax\0rbx\0rcx\0rdx\0rsi\0rdi\0rbp\0rsp\0r8 \0r9 \0r10\0r11\0r12\0r13\0r14\0r15\0"
    // Offset in the frame, divided by 8 -- see isr.s.
    var offs: [u8; 16] = [14 as u8, 11 as u8, 13 as u8, 12 as u8,
        9 as u8, 8 as u8, 10 as u8, 20 as u8,
        7 as u8, 6 as u8, 5 as u8, 4 as u8,
        3 as u8, 2 as u8, 1 as u8, 0 as u8]
    var i: u64 = 0
    while i < 16 {
        serial.put(32 as u8)
        serial.put(32 as u8)
        serial.puts((&names[0]) as u64 + i * 4)
        serial.put(61 as u8)
        serial.hex_width(word(frame, offs[i as usize] as u64 * 8), 16)
        if i % 4 == 3 {
            serial.nl()
        }
        i = i + 1
    }
}
