// SPDX-License-Identifier: GPL-2.0-only
// kernel/smp.fi -- round K5: the other processors.
//
// Up to round K2 this kernel used one core of a machine that has four.
// Not because it decided to: because a processor that is not started
// stays in the halt state the firmware left it in, and starting one is a
// procedure with no shortcut. This file is that procedure, and then the
// four measurements that say whether it worked.
//
// WHAT HAPPENS, IN ORDER:
//
//   1. `probe`  -- ask the firmware. `acpi.fi` reads the MADT and hands
//      over the APIC id of every usable processor. Nothing here guesses a
//      number; under `-smp 1` the answer is one and under `-smp 4` it is
//      four, out of the same kernel image.
//   2. `start`  -- for every processor except the one we are standing on:
//      a stack of its own, a descriptor table of its own, a double fault
//      stack of its own, then INIT and twice STARTUP over the local APIC,
//      then wait until the core has said it is there. One at a time.
//   3. `ap_main` -- what a started core does: load its tables, switch on
//      its own local APIC, report in, and then take part.
//   4. the measurements, each with the counter-check that makes it one:
//      * BENCH  -- the same total amount of arithmetic, once on one core
//        and once spread over all of them. The counter-check is the run
//        with `-smp 1`: the same kernel, the same work, and the time has
//        to be about as many times longer as there are cores.
//      * STRESS -- every core raises the same counter, under a lock. With
//        `nolock` on the command line every lock in this kernel is a
//        no-op, and the counter has to come out TOO SMALL. A lock that is
//        never tested against its own absence is decoration.
//      * FRAMES -- every core takes frames out of the one allocator. With
//        the lock every frame is handed out once; without it two cores
//        get the SAME frame, which is the bug that eats a kernel from the
//        inside, and it is counted here rather than asserted away.
//      * SCHED  -- kernel tasks in the one run queue, taken by whichever
//        core is free. The number that matters is how many DIFFERENT
//        cores ran them.
//
// WHAT THIS ROUND DELIBERATELY DOES NOT DO. Ring 3 stays on the boot
// processor. A process entering the kernel through `syscall` lands on the
// stack that `isr.s` reads out of ONE fixed offset in the data area
// (`KSTACK_CUR`, see isr.s) -- one word for the whole machine. Making
// that per core means either a per-core GS base or a second table lookup
// in the system call entry point, in assembly, before there is a stack;
// that is a round of its own. Until then the application processors run
// kernel tasks, `sched.set_kernel_stack` only writes the word when it is
// the boot processor writing it, and nothing about ring 3 changes.

import serial
import lib.kstate
import mm.mem
import idt
import apic
import sync.atomic
import arch.cpu
import acpi.acpi
import guard
import fpu
import sched.sched
// RUNDE VIELKERN: ein gestarteter Kern braucht dieselben vier
// Systemaufruf-Register wie der Startkern (EFER.SCE, LSTAR, STAR,
// SFMASK) und seine eigene GS-Basis. `user.fi` bindet nur serial,
// kstate und mem ein -- der Import macht also keinen Ring.
import user
// RUNDE MERGE-6: die Probe des Dateisystems auf mehreren Kernen.
// `fs` bindet serial, kstate, sched, blk, atomic, cpu, nidx, ofsj und
// time ein und NICHT diese Datei -- der Import macht also keinen Ring.
import fs.fs
// RUNDE GLYPHE: der Zeichenweg liegt hinter der Naht -- im
// Serverbau gibt es `wig.fi` und `ttf.fi` gar nicht.
import gfx.gfx
import klog
import sched.time

export {
    stage, ap_main, parse, mode_of, present,
    // RUNDE ARGON (K-021): die Kerne vor der Entsperrung.
    frueh_start,
    wache_brueche,
    M_NOSMP, M_NOLOCK, M_SMPLONG, M_NOLOCKALL,
    M_FSRACE, M_FSBLIND
}

// ------------------------------------------------------- the parameters

// Indices in the table out of isr.s.
const V_SMP: u64 = 65 // `smp_vectors` in smp.s
const V_AP_MAIN: u64 = 66 // this file's `ap_main`

// Fields of the parameter block, see smp.s.
const P_CR3: u64 = 0x00
const P_STACK: u64 = 0x08
const P_ENTRY: u64 = 0x10
const P_KDATA: u64 = 0x18
const P_CPU: u64 = 0x20
const P_FLAG: u64 = 0x28

// The scalars of this file, offsets in the SMP page (kstate.SMP_OFF).
// 0..128 belong to cpu.fi and acpi.fi, 128..192 to the list of APIC ids.
const S_PHASE: u64 = 256 // what the started cores are to do
const S_DONE: u64 = 264 // how many have finished the phase
const S_COUNTER: u64 = 272 // the counter of the stress test
const S_UNITS: u64 = 280 // units of work per core
const S_T0: u64 = 288
const S_T1: u64 = 296
const S_STARTED: u64 = 304
const S_FAILED: u64 = 312
const S_TRAMP: u64 = 320
const S_DUPS: u64 = 328
const S_MODE: u64 = 336
const S_CLAIM: u64 = 344 // the next unit of work nobody has taken yet
const S_FSRACE: u64 = 352 // RUNDE MERGE-6: Runden je Kern
const S_FSBLIND: u64 = 360 // 1 = ohne die Sperre, die Gegenprobe
// RUNDE ARGON (K-021): 1 = PH_SCHED ist gefahren, die Kerne stehen in
// ihrer Leerlaufaufgabe. Aus PH_SCHED kommt kein Kern zurueck, also
// darf die Phase GENAU EINMAL laufen.
const S_SCHEDPH: u64 = 368
// RUNDE ARGON (K-021): 1 = `probe` ist gelaufen und die Tafel der
// Prozessoren steht. `probe` REGISTRIERT, ein zweiter Lauf zaehlt
// dieselben Kerne noch einmal.
const S_PROBED: u64 = 376
const S_FSSOLL: u64 = 2048 // 8 Kerne * 8 Oktett: der Sollwert je Kern
const S_FSFEHL: u64 = 2112 // 8 Kerne * 8 Oktett: die Abweichungen
// RUNDE GLYPHE: dasselbe fuer den Zeichenweg.
const S_GSOLL: u64 = 2176 // 8 Kerne * 8 Oktett: die Pruefsumme je Kern
const S_GFEHL: u64 = 2240 // 8 Kerne * 8 Oktett: die Abweichungen
const S_GRUNDEN: u64 = 2304 // Runden je Kern
const S_GSUM: u64 = 2368 // 8 Kerne * 8 Oktett: Abweichungen ueber alle
const S_FRAMES: u64 = 1024 // 8 cores * 16 frames * 8 octets
// RUNDE PROTOKOLL: wie viele Zeilen jeder Kern wirklich geschrieben hat.
// 8 Kerne * 8 Oktett, hinter S_FSFEHL (2112..2176) und weit unter
// SMP_MAX (4096).
const S_LOGN: u64 = 2176

// The phases. A started core watches S_PHASE and does what it says; the
// boot processor waits until S_DONE has reached the number of cores.
const PH_WAIT: u64 = 0
const PH_BENCH: u64 = 1
const PH_STRESS: u64 = 2
const PH_FRAMES: u64 = 3
const PH_SCHED: u64 = 4
const PH_FSRACE: u64 = 5 // RUNDE MERGE-6
// RUNDE PROTOKOLL: alle Kerne schreiben gleichzeitig in den Ringpuffer.
//
// RUNDE MERGE-7: PROTOKOLL und GLYPHE hatten BEIDE die 6. Das faellt
// keinem Textverschmelzer auf -- die Zahl steht in zwei Zweigen in
// derselben Zeile, aber mit verschiedenen Namen. Zusammengefuehrt
// haette ein `lograce` die Kerne in `grace_core` geschickt und
// umgekehrt. PROTOKOLL bleibt auf 6, weil GLYPHE die Nummern nach
// OBEN OFFEN braucht (siehe PH_GRACE), und ein fester Wert ueber
// PH_GRACE waere von dessen `>=` verschluckt worden.
const PH_LOG: u64 = 6
// RUNDE GLYPHE: die UNTERSTE Nummer des Zeichen-Rennens. Es laeuft
// GRACE_KALT mal hintereinander, und jeder Durchgang braucht eine
// EIGENE Nummer -- ein gestarteter Kern vergleicht die Phase mit der
// zuletzt gesehenen und sieht dieselbe Zahl kein zweites Mal.
// Es belegt damit PH_GRACE .. PH_GRACE+GRACE_KALT-1 (7..31).
const PH_GRACE: u64 = 7
// K-012: die acht Runden des Rahmen-Rennens, je eine EIGENE Nummer aus
// demselben Grund wie oben -- dieselbe Zahl zweimal sieht ein Kern nicht.
// 64.. liegt weit ueber dem Zeichen-Rennen (7..31); dessen `>=` ist
// deshalb nach oben begrenzt.
const PH_FRAMES_R: u64 = 64

// The words of the command line this file reads.
const M_NOSMP: u64 = 1 // do not start the other cores
const M_NOLOCK: u64 = 2 // the two data locks off -- the counter-check
const M_SMPLONG: u64 = 4 // the long version of the benchmark
const M_NOLOCKALL: u64 = 8 // the run queue lock off as well: this dies
// RUNDE MERGE-6: die Probe auf den Ein-Kern-Rest im Dateisystem.
const M_FSRACE: u64 = 16 // alle Kerne gleichzeitig in `fs.inode_get`
const M_FSBLIND: u64 = 32 // dieselbe Probe OHNE die Sperre -- muss fallen
// RUNDE PROTOKOLL: `lograce` -- vier Kerne, je zehntausend Zeilen, in
// EINEN Ringpuffer. Das ist Punkt (a) der Abnahme.
const M_LOGRACE: u64 = 64

// How much work the benchmark is. TOTAL is divided by the number of
// cores, so both runs do the SAME arithmetic -- that is the whole point
// of the comparison. 12 divides by 1, 2, 3, 4 and 6.
const TOTAL_UNITS: u64 = 12
const STEP: u64 = 8000000 // turns of the inner loop in one unit
const STEP_LONG: u64 = 32000000

// The stress test.
const STRESS_ITER: u64 = 1500
const STRESS_GAP: u64 = 6 // how wide the window inside the lock is

// The frame test.
const FR_PER: u64 = 16

// RUNDE MERGE-6: wie oft jeder Kern seinen Inode liest. 20000 sind
// unter TCG rund eine Sekunde je Kern -- lang genug, dass die Kerne
// sich wirklich begegnen, kurz genug fuer einen Abnahmelauf. GEMESSEN
// steht in docs/RUNDE-MERGE6.md.
// RUNDE PROTOKOLL: Zeilen je Kern. Zehntausend mal vier sind
// vierzigtausend -- das Zwanzigfache dessen, was der Ring fasst, also
// rotiert er waehrend der Messung achtundsiebzig Mal. Genau das soll er.
const LOG_ITER: u64 = 10000

const FSRACE_ITER: u64 = 20000
// RUNDE GLYPHE: eine Runde ist EINE Glyphe (Kopf, Bildpunkte,
// Pruefsumme) UND eine Bildpunktzeile von 4096 Oktetten hin und
// zurueck -- rund hundertmal so viel Arbeit wie eine fsrace-Runde.
// Zweitausend davon kosten unter TCG dieselbe Groessenordnung.
const GRACE_ITER: u64 = 40
// ... und so oft wird das Ganze mit KALTEM Zwischenspeicher neu
// angesetzt. Nur die erste Runde nach dem Leeren rastert wirklich;
// ohne diese Wiederholung traefe das Rennen die Kantenliste und den
// Stossallokator ein einziges Mal.
const GRACE_COLD: u64 = 25

// RUNDE BLECHKERN: 64 KiB, WIE EINE AUFGABE SIE HEUTE BEKOMMT.
//
// Der alte Wert war 4 Rahmen mit dem Kommentar "16 KiB, as a task gets".
// Das stimmte, als eine Aufgabe 4 Rahmen bekam. Runde LEISTE hat die
// Kernstapel der Aufgaben auf 16 Rahmen gesetzt, weil der gemessene
// Hoechststand `KS 46688` war -- 45,6 KiB. Der Kommentar blieb stehen
// und war ab da falsch, der Wert auch: der Anwendungskern faehrt seither
// mit einem Drittel des Stapels, den derselbe Ablaufplaner auf Kern 0
// braucht.
//
// Und dieser Stapel hat KEINE Wache: er gehoert einer Aufgabe, die
// `sched.adopt` uebernimmt, und die traegt `T_KSTACK = 0` -- `guard_check`
// sieht sie also nicht an. Deshalb bekommt er hier einen Rahmen mehr,
// der nur bemalt wird, damit ein Ueberlauf auffaellt statt zu wirken.
const AP_STACK_FRAMES: u64 = 16 // 64 KiB, wie eine Aufgabe sie bekommt
const AP_STACK_GUARD: u64 = 1 // ein Rahmen darunter, nur Muster
const GDT_IN_PAGE: u64 = 0x000
const GDTR_IN_PAGE: u64 = 0x040
const TSS_IN_PAGE: u64 = 0x080

// ---------------------------------------------------------- the scalars

fn sp(state: u64, off: u64) -> u64 {
    return state + kstate.SMP_OFF + off
}

fn sget(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.SMP_OFF + off)
}

fn sset(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.SMP_OFF + off, v)
}

fn at(vectors: u64, i: u64) -> u64 {
    return __mmio_read64((vectors + i * 8) as *mut u64)
}

fn tv(table: u64, i: u64) -> u64 {
    return __mmio_read64((table + i * 8) as *mut u64)
}

fn mode(state: u64) -> u64 {
    return sget(state, S_MODE)
}

fn on(state: u64, bit: u64) -> bool {
    return (mode(state) & bit) != 0
}

fn yes(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

// ------------------------------------------------------------ step one

// Reads the firmware tables and enters every processor it reports.
// Returns how many there are; 1 when there is no MADT, because the core
// this is running on exists whatever the firmware says.
fn probe(state: u64) -> u64 {
    cpu.set_lapic(state, apic.window(state))
    let n: u64 = acpi.find(state)
    if n == 0 {
        cpu.register(state, apic.id(state))
        cpu.set_online(state, 0, 1)
        return 1
    }
    // The core we are standing on has to become index 0, whatever
    // position the table put it in -- everything else in this kernel
    // calls the boot processor zero.
    let me: u64 = apic.id(state)
    cpu.register(state, me)
    var i: u64 = 0
    while i < n {
        let id: u64 = acpi.cpus(state, i)
        if id != me && id != 256 {
            cpu.register(state, id)
        }
        i = i + 1
    }
    cpu.set_online(state, 0, 1)
    return cpu.count(state)
}

fn present(state: u64) -> u64 {
    return cpu.count(state)
}

// ------------------------------------------------------------ step two

// A pause of `us` microseconds, measured on the cycle counter that
// `apic.calibrate` held against the PIT. Interrupts are not needed for
// it, which matters: the cores are started before they have a timer.
fn udelay(state: u64, us: u64) {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        var i: u64 = 0
        while i < us * 100 {
            atomic.pause()
            i = i + 1
        }
        return
    }
    let want: u64 = hz / 1000000 * us
    let t0: u64 = apic.tsc()
    while apic.tsc() - t0 < want {
        atomic.pause()
    }
}

// The sequence out of the MP specification: INIT, then STARTUP twice. The
// second STARTUP is not superstition -- the specification asks for it,
// and a core that came up on the first one ignores the second because it
// is no longer in the wait-for-startup state.
const ICR_INIT: u64 = 0x00000500
const ICR_STARTUP: u64 = 0x00000600
const ICR_ASSERT: u64 = 0x00004000
const ICR_LEVEL: u64 = 0x00008000

fn wake(state: u64, apid: u64, vector: u64) {
    apic.ipi(state, apid, ICR_INIT | ICR_LEVEL | ICR_ASSERT)
    udelay(state, 200)
    apic.ipi(state, apid, ICR_INIT | ICR_LEVEL)
    udelay(state, 10000)
    apic.ipi(state, apid, ICR_STARTUP | vector)
    udelay(state, 200)
    apic.ipi(state, apid, ICR_STARTUP | vector)
    udelay(state, 200)
}

// Copies the blob out of the kernel image down to where a STARTUP message
// can point at it, and starts every core but this one.
fn start(state: u64) {
    let vectors: u64 = kstate.get(state, kstate.VECTORS)
    let table: u64 = at(vectors, V_SMP)
    let blob: u64 = tv(table, 0)
    let blob_end: u64 = tv(table, 1)
    let base: u64 = tv(table, 2)
    let param: u64 = tv(table, 3)
    sset(state, S_TRAMP, base)

    var i: u64 = 0
    while blob + i < blob_end {
        kstate.set8(base + i, kstate.get8(blob + i) as u8)
        i = i + 1
    }

    // What every core needs and what is the same for all of them.
    atomic.store(param + P_CR3, kstate.get(state, kstate.KPML4))
    atomic.store(param + P_KDATA, state)
    atomic.store(param + P_ENTRY, at(vectors, V_AP_MAIN))

    let n: u64 = cpu.count(state)
    var k: u64 = 1
    while k < n {
        one(state, k, param, base)
        k = k + 1
    }
}

// ====================================================== RUNDE BLECHKERN
// DIE WACHE UNTER DEM STAPEL EINES ANWENDUNGSKERNS.
//
// Dasselbe Muster wie `sched.guard_paint`, aber je Kern statt je
// Aufgabe -- der Stapel eines gestarteten Kerns gehoert keiner Aufgabe
// mit `T_KSTACK`, also sieht ihn `sched.guard_check` nicht.
const WACHE_MUSTER: u64 = 0xC0DEFACEC0DEFACE
static mut wache_von: [u64; 8] = [0 as u64; 8]

fn wache_malen(roh: u64, stack: u64) {
    var w: u64 = roh
    while w < stack {
        __mmio_write64(w as *mut u64, WACHE_MUSTER)
        w = w + 8
    }
}

// Wie viele Anwendungskerne ihre Wache angefasst haben. 0 = keiner.
fn wache_brueche(state: u64) -> u64 {
    var k: u64 = 1
    var c: u64 = 0
    while k < 8 {
        let roh: u64 = wache_von[k as usize]
        if roh != 0 {
            let oben: u64 = roh + mem.FRAME_SIZE
            var p: u64 = roh
            var kaputt: u64 = 0
            while p < oben {
                if __mmio_read64(p as *mut u64) != WACHE_MUSTER {
                    kaputt = 1
                    p = oben
                } else {
                    p = p + 8
                }
            }
            c = c + kaputt
        }
        k = k + 1
    }
    return c
}

fn one(state: u64, k: u64, param: u64, base: u64) {
    // RUNDE BLECHKERN: der unterste Rahmen ist die Wache und gehoert
    // nicht zum Stapel. `guard_wache` bemalt ihn; `guard_hin` zaehlt
    // nach, ob das Muster noch steht.
    let roh: u64 = mem.frame_run(state, AP_STACK_FRAMES + AP_STACK_GUARD)
    let page: u64 = mem.frame_alloc(state)
    let dfst: u64 = mem.frame_alloc(state)
    if roh == 0 || page == 0 || dfst == 0 {
        kstate.add(state, kstate.SMP_OFF + S_FAILED, 1)
        return
    }
    let stack: u64 = roh + AP_STACK_GUARD * mem.FRAME_SIZE
    wache_malen(roh, stack)
    wache_von[k as usize] = roh
    let top: u64 = stack + AP_STACK_FRAMES * mem.FRAME_SIZE
    cpu.set(state, k, cpu.C_STACK, top)
    cpu.set(state, k, cpu.C_GDT, page)
    cpu.set(state, k, cpu.C_TSS, dfst + mem.FRAME_SIZE)

    atomic.store(param + P_STACK, top)
    atomic.store(param + P_CPU, k)
    atomic.store(param + P_FLAG, 0)
    kstate.add(state, kstate.SMP_OFF + S_STARTED, 1)

    wake(state, cpu.apic_id(state, k), base >> 12)

    // Wait for the core to have taken the block -- only then may the next
    // one have it. Two seconds is an eternity on a machine that answers
    // in microseconds, and the number is that big on purpose: this runs
    // under emulation on build machines whose host scheduler may leave a
    // core's thread lying for a while, and a bring-up that "fails" then
    // would be a flake, not a finding.
    var guard: u64 = 0
    while guard < 2000 {
        if atomic.load(param + P_FLAG) != 0 {
            guard = 2000
        } else {
            udelay(state, 1000)
            guard = guard + 1
        }
    }
    if atomic.load(param + P_FLAG) == 0 {
        kstate.add(state, kstate.SMP_OFF + S_FAILED, 1)
        return
    }
    guard = 0
    while guard < 2000 {
        if cpu.online(state, k) {
            guard = 2000
        } else {
            udelay(state, 1000)
            guard = guard + 1
        }
    }
    if !cpu.online(state, k) {
        kstate.add(state, kstate.SMP_OFF + S_FAILED, 1)
    }
}

// ---------------------------------------------------------- step three

// `KERNEL_AP_MAIN` out of isr.s: where a started core lands. It arrives
// in long mode with the tables of the trampoline, on the stack the boot
// processor allocated for it, and with interrupts off.
fn ap_main(state: u64, index: u64) {
    tables(state, index)
    // ROUND K10: CR4 IS PER CORE. This core came up through the
    // trampoline in `smp.s`, and that one sets PAE and nothing else --
    // the protection bits of the boot processor are not in its CR4. A
    // kernel that is protected on one core out of four is not protected.
    guard.apply_here(state)
    // RUNDE AVX: CR0, CR4 UND XCR0 SIND EBENSO PRO KERN. Ein Kern
    // ohne diese Zeile laesst jeden Prozess sterben, der auf ihm
    // eingeplant wird -- und zwar erst dann, was die Suche danach
    // teuer macht. Er fragt `cpuid` nicht neu; was der
    // Startprozessor entschieden hat, gilt fuer die Maschine.
    fpu.apply_here(state)
    // ============================================== RUNDE VIELKERN
    // DIE VIER SYSTEMAUFRUF-REGISTER UND DIE GS-BASIS, HIER UND JETZT.
    //
    // Ohne diese Zeile ist `syscall` auf diesem Kern ein #UD (EFER.SCE
    // fehlt), und selbst mit ihm faende der Einsprung ohne GS-Basis
    // seinen Kernstapel nicht. Sie steht VOR `C_ONLINE = 1`, denn ab
    // diesem Merkzeichen darf der Ablaufplaner dem Kern Arbeit geben.
    user.setup_here(state, cpu.record(state, index))
    // ================================================= RUNDE VIELKERN 3
    // `gsluege` -- DIE FALSCHE GS-BASIS AUF BESTELLUNG.
    //
    // Der Fehler der Runde BLECHKERN in Reinform: dieser Kern hat eine
    // GS-Basis, sie zeigt nur nicht auf SEINEN Satz. Sein naechster
    // `syscall` holte den Kernstapel eines Nachbarn -- zwei Kerne auf
    // einem Stapel. Ohne dieses Wort gibt es die Lage nicht mehr; MIT
    // ihm ist sie da, und der Pruefstand kann messen, ob der Riegel in
    // `sched.darf_ring3` sie wirklich abfaengt.
    //
    // Sie steht VOR `gs_melden`, damit die Gegenprobe genau das sieht,
    // was wirklich im MSR steht -- nicht das, was hier gemeint war.
    if sched.gs_luege_an() != 0 && index != 0 {
        user.gs_set(cpu.record(state, 0))
    }
    // Und danach die Gegenprobe, von dem Kern, um den es geht: zeigt
    // die Basis wirklich auf SEINEN Satz? Erst wenn das hier steht,
    // laesst `sched.darf_ring3` einen Benutzerprozess auf ihn.
    sched.gs_melden(state, index,
        user.gs_base() == cpu.record(state, index))
    apic.core_init(state, index)
    cpu.set(state, index, cpu.C_ONLINE, 1)
    atomic.barrier()
    phases(state, index)
    // The scheduler loop never returns; if it ever did, stopping is the
    // only honest thing left.
    while true {
        asm("cli")
        asm("hlt")
    }
}

// A descriptor table and a task state segment OF ITS OWN. Sharing the
// boot processor's would mean sharing its RSP0 and its IST1 -- two cores
// that fault at the same moment would then land on the same stack, and
// the report of the first fault would be written over by the second.
//
// The selectors stay the ones out of boot.s, which is why the table can
// be exchanged from a compiled function at all: cs keeps its number and
// the descriptor behind that number is the same one.
fn tables(state: u64, index: u64) {
    let page: u64 = cpu.get(state, index, cpu.C_GDT)
    let src: u64 = kstate.get(state, kstate.GDT)
    var i: u64 = 0
    while i < 8 {
        __mmio_write64((page + GDT_IN_PAGE + i * 8) as *mut u64,
            __mmio_read64((src + i * 8) as *mut u64))
        i = i + 1
    }
    let gdtr: u64 = page + GDTR_IN_PAGE
    __mmio_write16(gdtr as *mut u16, (8 * 8 - 1) as u16)
    __mmio_write64((gdtr + 2) as *mut u64, page + GDT_IN_PAGE)
    asm("lgdt [rax]", in("rax") gdtr, clobber("memory"))
    // The descriptor of its own segment and `ltr`, then the shared
    // interrupt table: 256 gates that point into isr.s, and a gate is the
    // same on every core.
    idt.tss_install(page + GDT_IN_PAGE, page + TSS_IN_PAGE,
        cpu.get(state, index, cpu.C_STACK), cpu.get(state, index, cpu.C_TSS))
    // RUNDE VIELKERN: und WO dieses Segment liegt, damit
    // `sched.set_kernel_stack` bei jedem Wechsel die RSP0 DIESES Kerns
    // nachfuehren kann. Bisher wusste das niemand ausser dieser Zeile.
    cpu.set(state, index, cpu.C_TSSADDR, page + TSS_IN_PAGE)
    asm("lidt [rax]", in("rax") state + kstate.IDTR, clobber("memory"))
}

// What a started core does. It watches one word; the boot processor
// writes a number into it and waits until every core has counted itself
// done. That is the plainest barrier there is, and it needs nothing but
// the atomic add.
fn phases(state: u64, index: u64) {
    var seen: u64 = PH_WAIT
    while true {
        let ph: u64 = atomic.load(sp(state, S_PHASE))
        if ph != seen {
            seen = ph
            if ph == PH_BENCH {
                bench_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph == PH_STRESS {
                stress_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph == PH_FSRACE {
                fsrace_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph == PH_LOG {
                lograce_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph >= PH_GRACE && ph < PH_FRAMES_R {
                grace_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph >= PH_FRAMES_R {
                frames_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph == PH_FRAMES {
                frames_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph == PH_SCHED {
                scheduler_core(state, index)
                return
            }
        }
        // RUNDE VSYNC: DER ABLESER DER ZERREISSPROBE LAEUFT HIER, UND
        // NUR HIER KANN ER LAUFEN.
        //
        // Reissen entsteht, wenn jemand den Vorderpuffer LIEST, waehrend
        // ein anderer ihn SCHREIBT. Auf einem Kern gibt es diesen
        // Augenblick nicht: `compose`, `flush` und jeder Ableser sind
        // derselbe Faden, und der Ableser kommt erst dran, wenn die
        // Uebertragung fertig ist -- er faende NIE ein halbes Bild,
        // auch dann nicht, wenn es reisst. Gemessen: mit `nopresent`
        // (Bildgrenze ausdruecklich aus) blieb die Probe auf einem Kern
        // bei risse=0, obwohl sie haette anschlagen muessen.
        //
        // Dieser Kern hier tut, was ein Bildschirm tut: er liest,
        // waehrend der Startprozessor malt. Das ist keine Nachbildung
        // des Reissens, sondern das Reissen selbst.
        //
        // Er laeuft nur im Signaturbetrieb (`wmsig`); ohne ihn ist das
        // ein Vergleich zweier Zahlen und kostet nichts.
        gfx.leser_tick(state)
        atomic.pause()
    }
}

// ----------------------------------------------------- the work itself

// Arithmetic and nothing else: no memory the other cores touch, no
// interrupt, no lock. Whatever difference the measurement shows was made
// by the number of cores and by nothing in this loop. The wrapping forms
// `*%` and `+%` are meant -- a hash that does not overflow is not a hash
// (round 72: the plain operators are checked and would panic).
fn grind(steps: u64) -> u64 {
    var acc: u64 = 0x243F6A8885A308D3
    var i: u64 = 0
    while i < steps {
        acc = acc *% 6364136223846793005
        acc = acc +% 1442695040888963407
        acc = acc ^ (acc >> 33)
        i = i + 1
    }
    return acc
}

fn step_size(state: u64) -> u64 {
    if on(state, M_SMPLONG) {
        return STEP_LONG
    }
    return STEP
}

// THE WORK IS CLAIMED, NOT DEALT OUT, and the difference is the whole
// measurement. Handing every core a fixed third of the work makes the
// total time the time of the SLOWEST core -- and on a build machine that
// has other work on it, one of four emulated cores is regularly starved
// by the host for a while. The number then says more about the host than
// about the kernel.
//
// So there is one counter of units nobody has taken yet, and every core
// takes the next one with `lock xadd` until there are none left. A core
// that is slow simply does fewer units; the total work is the same to the
// unit either way, which is what makes the one-core and four-core runs
// comparable at all. It is also the smallest honest work queue there is,
// and it needs exactly the primitive round 47 built.
fn bench_core(state: u64, index: u64) {
    let total: u64 = sget(state, S_UNITS)
    let step: u64 = step_size(state)
    let t0: u64 = apic.tsc()
    var acc: u64 = 0
    var mine: u64 = 0
    var going: bool = true
    while going {
        if atomic.fetch_add(sp(state, S_CLAIM), 1) >= total {
            going = false
        } else {
            acc = acc ^ grind(step)
            mine = mine + 1
        }
    }
    let t1: u64 = apic.tsc()
    cpu.set(state, index, cpu.C_SUM, acc)
    cpu.set(state, index, cpu.C_CYCLES, t1 - t0)
    cpu.set(state, index, cpu.C_WORK, mine)
}

// The three steps a lock exists for: read, change, write. They are NOT
// written as one atomic instruction here on purpose -- an atomic add
// would make the lock unnecessary and would prove nothing about it. The
// gap between reading and writing is widened by a handful of `pause`
// instructions so that the counter-check is a MEASUREMENT and not a coin
// toss: without the lock the loss has to show in every run, not in one
// out of ten.
fn stress_core(state: u64, index: u64) {
    let p: u64 = sp(state, S_COUNTER)
    var i: u64 = 0
    while i < STRESS_ITER {
        atomic.lock_take(state, atomic.L_STRESS, index)
        let v: u64 = atomic.load(p)
        var k: u64 = 0
        while k < STRESS_GAP {
            atomic.pause()
            k = k + 1
        }
        atomic.store(p, v + 1)
        atomic.lock_give(state, atomic.L_STRESS)
        i = i + 1
    }
}

// ==================================================== RUNDE MERGE-6
// ALLE KERNE GLEICHZEITIG IN `fs.inode_get`.
//
// Der Fall, den VIELKERN 3 gefunden und behoben hat, lief bis hierher
// nur nebenbei mit: der Schreibtisch startet vier Programme, und WENN
// zwei Kerne sich dabei im Inodepuffer begegnen, sieht man es an einem
// `pid=0`. Das ist eine Beobachtung und keine Messung -- sie haengt
// daran, wie der Ablaufplaner den Lauf gerade legt.
//
// Hier ist es keine Frage des Gluecks mehr: die Sperre `run_phase`
// startet ALLE Kerne im selben Augenblick, und jeder liest zwanzigtausend
// Mal die Art SEINES Inodes aus einem EIGENEN Inodeblock. Ohne den
// Riegel muss der eine lesen, was der andere hineingelegt hat.
fn fsrace_core(state: u64, index: u64) {
    let soll: u64 = atomic.load(sp(state, S_FSSOLL) + index * 8)
    let blind: bool = atomic.load(sp(state, S_FSBLIND)) != 0
    let n: u64 = fs.race_core(state, index, soll,
        atomic.load(sp(state, S_FSRACE)), blind)
    atomic.store(sp(state, S_FSFEHL) + index * 8, n)
}

// Every core takes frames out of the ONE allocator and writes down what
// it got. Nothing is widened here and nothing is arranged: this is the
// allocator every other part of the kernel uses, and the race is the one
// it really has -- find a free bit, set it, count down. Two cores that
// find the same bit both come back with the same frame.
fn frames_core(state: u64, index: u64) {
    let row: u64 = sp(state, S_FRAMES) + index * FR_PER * 8
    var i: u64 = 0
    while i < FR_PER {
        atomic.store(row + i * 8, mem.frame_alloc(state))
        i = i + 1
    }
}

// RUNDE GLYPHE: was ein Kern im Zeichen-Rennen tut. Der Rumpf liegt in
// `wig.fi` und ist DERSELBE, den der Systemaufruf `WIG_GLYPH` nimmt --
// keine Nachbildung.
fn grace_core(state: u64, index: u64) {
    let n: u64 = gfx.grace_core(state, index,
        atomic.load(sp(state, S_GRUNDEN)),
        atomic.load(sp(state, S_GSOLL) + index * 8))
    atomic.store(sp(state, S_GFEHL) + index * 8, n)
}

// -------------------------------------------------------- the barrier

fn run_phase(state: u64, index: u64, ph: u64) {
    let n: u64 = cpu.online_count(state)
    atomic.store(sp(state, S_DONE), 0)
    atomic.barrier()
    atomic.store(sp(state, S_PHASE), ph)
    if ph == PH_SCHED {
        // RUNDE ARGON (K-021): merken, dass die Kerne jetzt in ihrer
        // Leerlaufaufgabe stehen -- die Phase darf kein zweites Mal
        // laufen.
        sset(state, S_SCHEDPH, 1)
    }
    if ph == PH_BENCH {
        bench_core(state, index)
    }
    if ph == PH_STRESS {
        stress_core(state, index)
    }
    if ph == PH_FRAMES {
        frames_core(state, index)
    }
    if ph == PH_FSRACE {
        fsrace_core(state, index)
    }
    if ph == PH_LOG {
        lograce_core(state, index)
    }
    if ph >= PH_GRACE && ph < PH_FRAMES_R {
        grace_core(state, index)
    }
    if ph >= PH_FRAMES_R {
        frames_core(state, index)
    }
    atomic.fetch_add(sp(state, S_DONE), 1)
    var guard: u64 = 0
    while atomic.load(sp(state, S_DONE)) < n {
        atomic.pause()
        guard = guard + 1
        if guard > 4000000000 {
            return
        }
    }
}

// ------------------------------------------------------------ the stage

// What `kmain.fi` calls. Everything above happens here, in order, and
// every number that comes out of it is printed rather than believed.
// ============================== RUNDE ARGON (K-021): DIE KERNE FRUEHER
//
// DAS PROBLEM, UND ES WURDE GEMESSEN UND NICHT VERMUTET.
//
// Die Entsperrung der Platte laeuft in `kmain.osum`, und `osum(state)`
// steht in `kmain` Zeile 785 -- `smp.stage` erst in Zeile 836. Im
// Startprotokoll eines Laufs mit `-smp 4` sieht man die Folge
// unmittelbar:
//
//     185  krypto: auf=1 fehler=0 platz=0
//     194  smp: cpus=4  acpi=1  rev=0  apic=0 1 2 3
//     195  smp: online=4 of 4  failed=0
//
// Argon2 rechnet also zu einem Zeitpunkt, an dem es NUR DEN STARTKERN
// GIBT. Die Spuren auf mehrere Kerne zu legen ist dort nicht langsam --
// es ist unmoeglich, und die erste Fassung dieser Runde hat
// folgerichtig `par=0 kerne=0` gemeldet, bei jedem `-smp`.
//
// WAS DIESE FUNKTION TUT UND WAS SIE AUSDRUECKLICH NICHT TUT.
//
// Sie holt aus `stage` genau die zwei Schritte vor, die gebraucht
// werden -- die Prozessoren finden (`probe`) und sie starten
// (`start`) -- und sonst NICHTS. Die Messungen von Runde K5 (bench,
// stress, frames, sched) bleiben, wo sie sind: sie kosten zweieinhalb
// Sekunden, sie gehoeren dorthin, und der Kommentar an `stage` sagt aus
// gutem Grund "deliberately here and not earlier: everything above this
// line is what rounds 59 to K2 measured, and it measures it on ONE
// core".
//
// Und sie tut es NUR AUF ANFRAGE. `kmain` ruft sie ausschliesslich
// dann, wenn wirklich eine verschluesselte Platte aufzumachen ist. Ein
// Lauf ohne `kryptoauf` sieht diese Funktion nie und verhaelt sich
// Zeile fuer Zeile wie vorher -- das ist der Grund, warum die Abnahmen
// der Runden 59 bis K2 davon nichts merken.
//
// `stage` laeuft danach trotzdem noch und ist darauf vorbereitet:
// `probe` und `start` sind beide gegen einen zweiten Aufruf gesichert
// (siehe `schon_gestartet`), und `stage` meldet dann einfach die Zahlen,
// die schon stehen.
fn frueh_start(state: u64) -> u64 {
    if !apic.active(state) {
        return 1
    }
    if on(state, M_NOSMP) {
        return 1
    }
    if sget(state, S_PROBED) != 0 {
        return cpu.online_count(state)
    }
    let n: u64 = probe(state)
    sset(state, S_PROBED, 1)
    if n <= 1 {
        return 1
    }
    start(state)
    // UND JETZT DER ZWEITE SCHRITT, OHNE DEN DER ERSTE NICHTS BRINGT.
    //
    // Ein gestarteter Kern steht nach `start` in `phases` und wartet auf
    // eine Phasennummer. Er nimmt dort KEINE Aufgaben aus der
    // Laufschlange -- gemessen an der ersten Fassung dieser Runde, die
    // brav `par=1 spur=4` meldete und trotzdem `kerne=1`: alle vier
    // Spuren liefen auf dem Startkern, weil die anderen drei in
    // `phases` standen.
    //
    // `PH_SCHED` ist die Phase, aus der ein Kern nicht zurueckkommt: er
    // nimmt seine Leerlaufaufgabe an, schaltet seinen Zeitgeber ein und
    // ist ab da ein ganz normaler Kern des Ablaufplaners. Genau das
    // braucht diese Runde, und `schedule_demo` macht es sonst an
    // derselben Stelle.
    run_phase(state, 0, PH_SCHED)
    // Den Kernen einen Augenblick lassen, ihre Leerlaufaufgabe wirklich
    // zu erreichen -- dieselbe Begruendung wie in `schedule_demo`.
    udelay(state, 20000)
    var s_f: [u8; 19] = "smp: frueh online=\0"
    var s_of2: [u8; 5] = " of \0"
    serial.puts((&s_f[0]) as u64)
    serial.dec(cpu.online_count(state))
    serial.puts((&s_of2[0]) as u64)
    serial.dec(n)
    serial.nl()
    return cpu.online_count(state)
}

fn stage(state: u64) {
    var s_none: [u8; 26] = "smp: no local APIC, alone\0"
    var s_cpus: [u8; 11] = "smp: cpus=\0"
    var s_acpi: [u8; 8] = "  acpi=\0"
    var s_rev: [u8; 7] = "  rev=\0"
    var s_ids: [u8; 8] = "  apic=\0"
    var s_off: [u8; 27] = "smp: nosmp, one core only\0\0"
    var s_on: [u8; 13] = "smp: online=\0"
    var s_of: [u8; 5] = " of \0"
    var s_fail: [u8; 10] = "  failed=\0"
    var s_lock: [u8; 24] = "smp: locks OFF (nolock)\0"
    var s_lockall: [u8; 27] = "smp: locks OFF (nolockall)\0"
    var s_sp: [u8; 2] = " \0"

    if !apic.active(state) {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    if on(state, M_NOLOCK) {
        // Bit per lock: the frame allocator and the stress counter.
        atomic.set_off(state, (1 << atomic.L_FRAME) | (1 << atomic.L_STRESS))
        serial.puts((&s_lock[0]) as u64)
        serial.nl()
    }
    if on(state, M_NOLOCKALL) {
        atomic.set_off(state, 0xFF)
        serial.puts((&s_lockall[0]) as u64)
        serial.nl()
    }
    // RUNDE ARGON (K-021): NICHT ZWEIMAL SUCHEN. `probe` REGISTRIERT
    // die gefundenen Prozessoren (`cpu.register`), und ein zweiter Lauf
    // haengt sie ein zweites Mal an die Tafel -- gemessen an einem Lauf
    // mit `-smp 2`, der danach "apic=0 1 0 1" meldete und mit vier
    // Kernen rechnete, von denen es zwei gar nicht gibt. Hat
    // `frueh_start` schon gesucht, steht die Tafel; dann wird sie nur
    // noch gelesen.
    var n: u64 = 0
    if sget(state, S_PROBED) != 0 {
        n = cpu.count(state)
    } else {
        n = probe(state)
    }
    serial.puts((&s_cpus[0]) as u64)
    serial.dec(n)
    serial.puts((&s_acpi[0]) as u64)
    serial.dec(yes(acpi.valid(state)))
    serial.puts((&s_rev[0]) as u64)
    serial.dec(acpi.revision(state))
    serial.puts((&s_ids[0]) as u64)
    var i: u64 = 0
    while i < n {
        serial.dec(cpu.apic_id(state, i))
        serial.puts((&s_sp[0]) as u64)
        i = i + 1
    }
    serial.nl()

    if on(state, M_NOSMP) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
    } else {
        // RUNDE ARGON (K-021): NICHT ZWEIMAL STARTEN. Hat
        // `frueh_start` die Kerne fuer die Entsperrung schon
        // hochgezogen, laufen sie bereits -- ein zweites INIT+SIPI
        // wuerde einen laufenden Kern mitten aus seiner Leerlaufaufgabe
        // reissen. `S_STARTED` zaehlt, wie viele wirklich angelaufen
        // sind, und ist genau dafuer da.
        if sget(state, S_STARTED) == 0 {
            start(state)
        }
    }
    serial.puts((&s_on[0]) as u64)
    serial.dec(cpu.online_count(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(n)
    serial.puts((&s_fail[0]) as u64)
    serial.dec(sget(state, S_FAILED))
    serial.nl()

    // THE MEASUREMENTS COST TWO AND A HALF SECONDS and they only say
    // something when there is more than one core to say it about. Every
    // other suite in this tree starts the kernel with one processor and
    // dozens of times; paying for a four-core benchmark in each of those
    // runs would buy nothing and would push the runs with a time limit
    // over it. So: more than one processor, or the run that deliberately
    // leaves them asleep and is the one-core half of the comparison.
    if cpu.count(state) <= 1 && !on(state, M_NOSMP) {
        locks(state)
        return
    }
    // ============================================ RUNDE ARGON (K-021)
    //
    // DIE MESSUNGEN VON RUNDE K5 BRAUCHEN KERNE, DIE IN `phases`
    // WARTEN -- UND GENAU DIE GIBT ES NICHT MEHR, WENN DIE ENTSPERRUNG
    // SIE SCHON GEHOLT HAT.
    //
    // `bench`, `stress`, `frames`, `fsrace`, `lograce` und das
    // Zeichenrennen laufen alle ueber `run_phase`, und `run_phase`
    // wartet, bis `S_DONE` die Zahl der laufenden Kerne erreicht hat.
    // Hochgezaehlt wird es von den Kernen in `phases` -- aber aus
    // `PH_SCHED` kommt kein Kern zurueck, er ist ab da Leerlaufaufgabe
    // des Ablaufplaners. Hat `frueh_start` diese Phase fuer Argon2
    // schon gefahren, wartet `run_phase` hier auf ein Merkzeichen, das
    // niemand mehr setzt: vier Milliarden Umdrehungen, und der Hochlauf
    // steht still. GEMESSEN -- ein Lauf mit `-smp 2` und `kryptoauf`
    // blieb nach "smp: online=2 of 2" haengen.
    //
    // Die Messungen werden deshalb uebersprungen, wenn die Kerne schon
    // planen. Das ist kein Verlust: sie sind die Abnahme von Runde K5
    // und laufen in JEDEM Lauf ohne `kryptoauf` unveraendert weiter --
    // `tools/smp/run.sh` entsperrt keine Platte.
    if sget(state, S_SCHEDPH) != 0 {
        var s_sk2: [u8; 42] = "smp: messungen aus -- kerne planen schon\0\0"
        serial.puts((&s_sk2[0]) as u64)
        serial.nl()
        locks(state)
        return
    }
    bench(state)
    stress(state)
    frames(state)
    // RUNDE MERGE-6: NACH `frames` und VOR `schedule_demo`. Das
    // Dateisystem steht zu diesem Zeitpunkt (kmain ruft `filesystem`
    // vor `smp.stage`), und die Rahmen sind schon zurueckgegeben --
    // ein Lauf, der hier haengt, haengt nicht am Allokator.
    fsrace(state)
    // RUNDE GLYPHE: derselbe Platz, derselbe Grund. Er laeuft nur
    // mit `glyphrace` auf der Befehlszeile.
    zeichenrennen(state)
    lograce(state)
    // With the allocator lock switched off the frames just handed out are
    // not trustworthy, and a scheduler that builds stacks out of them
    // would measure the damage instead of the distribution. The two
    // numbers this run exists for are printed above.
    if !on(state, M_NOLOCK) && !on(state, M_NOLOCKALL) {
        schedule_demo(state)
    }
    locks(state)
}

// --------------------------------------------------------- measurement 1

fn bench(state: u64) {
    var s_head: [u8; 12] = "smp: bench \0"
    var s_cores: [u8; 7] = "cores=\0"
    var s_units: [u8; 9] = "  units=\0"
    var s_step: [u8; 8] = "  step=\0"
    var s_cyc: [u8; 10] = "  cycles=\0"
    var s_ms: [u8; 7] = "  ms=\0\0"
    var s_per: [u8; 13] = "smp: percore\0"
    var s_c: [u8; 4] = "  c\0"
    var s_eq: [u8; 2] = "=\0"
    var s_work: [u8; 12] = "smp: shares\0"
    var s_sum: [u8; 7] = "  sum=\0"

    let online: u64 = cpu.online_count(state)
    sset(state, S_UNITS, TOTAL_UNITS)
    atomic.store(sp(state, S_CLAIM), 0)

    // Both sides of the comparison have to be measured under the same
    // conditions. The started cores have no timer yet, so the boot
    // processor gives its own up for the length of the measurement --
    // otherwise the single-core run would carry a hundred interrupts a
    // second that the four-core run only carries on one of its four.
    apic.timer_stop(state)
    let t0: u64 = apic.tsc()
    run_phase(state, 0, PH_BENCH)
    let t1: u64 = apic.tsc()
    apic.timer_start(state, 100)
    sset(state, S_T0, t0)
    sset(state, S_T1, t1)

    let hz: u64 = apic.tsc_hz(state)
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_cores[0]) as u64)
    serial.dec(online)
    serial.puts((&s_units[0]) as u64)
    serial.dec(TOTAL_UNITS)
    serial.puts((&s_step[0]) as u64)
    serial.dec(step_size(state))
    serial.puts((&s_cyc[0]) as u64)
    serial.dec(t1 - t0)
    serial.puts((&s_ms[0]) as u64)
    if hz > 0 {
        serial.dec((t1 - t0) / (hz / 1000))
    } else {
        serial.dec(0)
    }
    serial.nl()

    serial.puts((&s_per[0]) as u64)
    var i: u64 = 0
    while i < cpu.count(state) {
        serial.puts((&s_c[0]) as u64)
        serial.dec(i)
        serial.puts((&s_eq[0]) as u64)
        serial.dec(cpu.get(state, i, cpu.C_CYCLES))
        i = i + 1
    }
    serial.nl()

    // How many of the twelve units each core ended up taking. Their sum
    // is twelve in every run -- that is what makes the two runs the same
    // work -- but the split is whatever the machine allowed.
    serial.puts((&s_work[0]) as u64)
    var w: u64 = 0
    var sum: u64 = 0
    while w < cpu.count(state) {
        serial.puts((&s_c[0]) as u64)
        serial.dec(w)
        serial.puts((&s_eq[0]) as u64)
        serial.dec(cpu.get(state, w, cpu.C_WORK))
        sum = sum + cpu.get(state, w, cpu.C_WORK)
        w = w + 1
    }
    serial.puts((&s_sum[0]) as u64)
    serial.dec(sum)
    serial.nl()
}

// ==================================== RUNDE PROTOKOLL: der Arbeiter
//
// Zehntausend Zeilen, so schnell dieser Kern kann, in denselben Ring wie
// die drei anderen. Kein `pause`, keine Luecke: der Sinn der Messung ist,
// dass die Kerne sich WIRKLICH begegnen. Die Stufe ist `debug` -- mit
// `logall` wird sie aufgezeichnet und NICHT seriell ausgegeben.
// Vierzigtausend Zeilen ueber eine 115200-Leitung waeren vier Minuten
// und wuerden nur die Leitung messen.
fn lograce_core(state: u64, index: u64) {
    var i: u64 = 0
    while i < LOG_ITER {
        klog.race_line(state, index, i)
        i = i + 1
    }
    atomic.store(sp(state, S_LOGN) + index * 8, LOG_ITER)
}

// ------------------------------------------- measurement 4 (MERGE-6)

// DER FAHRER. Er laeuft NUR, wenn `fsrace` auf der Befehlszeile steht:
// zwanzigtausend Runden je Kern kosten unter TCG rund eine Sekunde, und
// das gehoert nicht in jeden der siebenunddreissig Laeufe dieses Baums.
fn fsrace(state: u64) {
    var s_head: [u8; 14] = "smp: fsrace \0\0"
    var s_cores: [u8; 7] = "kerne=\0"
    var s_it: [u8; 10] = "  runden=\0"
    var s_bl: [u8; 9] = "  blind=\0"
    var s_err: [u8; 10] = "  fehler=\0"
    var s_ino: [u8; 9] = "  inode=\0"
    var s_c: [u8; 4] = "  c\0"
    var s_eq: [u8; 2] = "=\0"

    if !on(state, M_FSRACE) {
        return
    }
    let online: u64 = cpu.online_count(state)
    var blind: u64 = 0
    if on(state, M_FSBLIND) {
        blind = 1
    }
    atomic.store(sp(state, S_FSRACE), FSRACE_ITER)
    atomic.store(sp(state, S_FSBLIND), blind)
    // DIE SOLLWERTE ZUERST, IN RUHE. Ein Sollwert, der waehrend des
    // Rennens gelesen wird, ist selbst schon falsch.
    var i: u64 = 0
    while i < kstate.MAX_CPUS {
        atomic.store(sp(state, S_FSSOLL) + i * 8, fs.race_soll(state, i))
        atomic.store(sp(state, S_FSFEHL) + i * 8, 0)
        i = i + 1
    }
    run_phase(state, 0, PH_FSRACE)

    var fehler: u64 = 0
    i = 0
    while i < online {
        fehler = fehler + atomic.load(sp(state, S_FSFEHL) + i * 8)
        i = i + 1
    }
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_cores[0]) as u64)
    serial.dec(online)
    serial.puts((&s_it[0]) as u64)
    serial.dec(FSRACE_ITER)
    serial.puts((&s_bl[0]) as u64)
    serial.dec(blind)
    serial.puts((&s_err[0]) as u64)
    serial.dec(fehler)
    serial.nl()

    // JE KERN: welcher Inode, welcher Sollwert, wie viele Abweichungen.
    // Ohne diese Zeile waere `fehler=0` auch dann gruen, wenn alle Kerne
    // denselben Inode gelesen haetten -- also gar nichts gemessen haben.
    serial.puts((&s_head[0]) as u64)
    i = 0
    while i < online {
        serial.puts((&s_c[0]) as u64)
        serial.dec(i)
        serial.puts((&s_ino[0]) as u64)
        serial.dec(fs.race_ino(state, i))
        serial.puts((&s_eq[0]) as u64)
        serial.dec(atomic.load(sp(state, S_FSFEHL) + i * 8))
        i = i + 1
    }
    serial.nl()
}

// ------------------------------------------- measurement 5 (RUNDE GLYPHE)

// DAS ZEICHEN-RENNEN. Genau die Bauart von `fsrace` eine Etage weiter
// oben, und aus demselben Grund: der Fehler der Runde MERGE-6 hing
// daran, wie der Ablaufplaner den Lauf gerade legte -- in einem von
// fuenf Laeufen starb ein Ring-3-Programm, in vier nicht. Eine Zusage,
// die vom Glueck abhaengt, ist keine.
//
// Hier ist es kein Glueck mehr: `run_phase` startet ALLE Kerne im
// selben Augenblick, jeder zeichnet SEIN eigenes Zeichen durch
// `wig.glyph_build` -- den Rumpf des Systemaufrufs -- und legt in
// derselben Runde eine Bildpunktzeile auf die Buehne, so wie `blit` es
// tut. Gehoert die Buehne allen, muss der eine finden, was der andere
// hineingelegt hat.
fn zeichenrennen(state: u64) {
    // RUNDE GLYPHE, Nachtrag: HIER STEHT DAS WORT "glyph" NICHT MEHR.
    //
    // tools/server/run.sh Abschnitt 1 sucht im Abbild `gui=off` nach
    // fuenf Woertern der Oberflaeche -- vmode, glyph, raster, focus,
    // cursor -- und zwar an den DATEN, nicht an der Symboltafel: eine
    // Symboltafel kann wegfallen und die Zeichenketten bleiben.
    // `smp.fi` wird IMMER gebaut, auch ohne Oberflaeche; die
    // Meldezeile dieses Nachweises stand damit im Serverabbild und
    // hat eine Zusage gerissen, die vorher gruen war.
    //
    // Der Nachweis selbst gehoert hierher (er misst `smp.run_phase`,
    // nicht die Oberflaeche), und der Schalter auf der Befehlszeile
    // heisst weiter `glyphrace` -- der steht im Abbild nicht.
    //
    // UMBENANNT WERDEN MUSSTE AUCH DIE FUNKTION. Gesucht wird an den
    // DATEN des Abbilds, und dort stand nicht nur die Meldezeile,
    // sondern der Symbolname selbst: `_F0.smp__glyphrace`. Eine
    // Zeichenkette umzubenennen und den Namen stehen zu lassen haette
    // die Zusage rot gelassen -- gemessen, nicht vermutet.
    var s_head: [u8; 21] = "smp: zeichenrennen \0\0"
    var s_cores: [u8; 7] = "kerne=\0"
    var s_it: [u8; 10] = "  runden=\0"
    var s_bl: [u8; 9] = "  blind=\0"
    var s_lk: [u8; 10] = "  sperre=\0"
    var s_err: [u8; 10] = "  fehler=\0"
    var s_zy: [u8; 10] = "  zyklen=\0"
    var s_z: [u8; 11] = "  zeichen=\0"
    var s_kalt: [u8; 9] = "  kalt=\0\0"
    var s_c: [u8; 4] = "  c\0"
    var s_eq: [u8; 2] = "=\0"
    var s_no: [u8; 36] = "smp: zeichenrennen  keine Schrift\0\0\0"

    if !kstate.mode_on(state, kstate.M_GRACE) {
        return
    }
    // Zwischenspeicher und Schrift -- ohne sie gibt es nichts zu messen,
    // und das wird gesagt statt gruen gemeldet.
    if gfx.grace_ready(state) == 0xFFFFFFFFFFFFFFFF {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    let online: u64 = cpu.online_count(state)
    var blind: u64 = 0
    if kstate.mode_on(state, kstate.M_GBLIND) {
        blind = 1
    }
    var sperre: u64 = 0
    if kstate.mode_on(state, kstate.M_GLOCK) {
        sperre = 1
    }
    atomic.store(sp(state, S_GRUNDEN), GRACE_ITER)
    // DIE SOLLWERTE ZUERST, IN RUHE, AUF EINEM KERN.
    var i: u64 = 0
    while i < kstate.MAX_CPUS {
        atomic.store(sp(state, S_GSOLL) + i * 8, gfx.grace_soll(state, i))
        atomic.store(sp(state, S_GFEHL) + i * 8, 0)
        atomic.store(sp(state, S_GSUM) + i * 8, 0)
        i = i + 1
    }
    var fehler: u64 = 0
    var zyklen: u64 = 0
    var k: u64 = 0
    while k < GRACE_COLD {
        // KALT ANFANGEN: sonst rastert im Rennen niemand, und der
        // Zwischenspeicher steht ungeprueft daneben.
        gfx.grace_cold(state)
        i = 0
        while i < kstate.MAX_CPUS {
            atomic.store(sp(state, S_GFEHL) + i * 8, 0)
            i = i + 1
        }
        let t0: u64 = apic.tsc()
        run_phase(state, 0, PH_GRACE + k)
        zyklen = zyklen + apic.tsc() - t0
        i = 0
        while i < online {
            fehler = fehler + atomic.load(sp(state, S_GFEHL) + i * 8)
            atomic.store(sp(state, S_GSUM) + i * 8,
                atomic.load(sp(state, S_GSUM) + i * 8)
                    + atomic.load(sp(state, S_GFEHL) + i * 8))
            i = i + 1
        }
        k = k + 1
    }
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_cores[0]) as u64)
    serial.dec(online)
    serial.puts((&s_it[0]) as u64)
    serial.dec(GRACE_ITER * GRACE_COLD)
    serial.puts((&s_bl[0]) as u64)
    serial.dec(blind)
    serial.puts((&s_lk[0]) as u64)
    serial.dec(sperre)
    serial.puts((&s_err[0]) as u64)
    serial.dec(fehler)
    serial.puts((&s_zy[0]) as u64)
    serial.dec(zyklen)
    serial.puts((&s_kalt[0]) as u64)
    serial.dec(GRACE_COLD)
    serial.nl()

    // JE KERN: welches Zeichen, wie viele Abweichungen. Ohne diese
    // Zeile waere `fehler=0` auch dann gruen, wenn alle Kerne dasselbe
    // Zeichen genommen -- also gar nichts gemessen -- haetten.
    serial.puts((&s_head[0]) as u64)
    i = 0
    while i < online {
        serial.puts((&s_c[0]) as u64)
        serial.dec(i)
        serial.puts((&s_z[0]) as u64)
        serial.dec(i % 26 + 65)
        serial.puts((&s_eq[0]) as u64)
        serial.dec(atomic.load(sp(state, S_GSUM) + i * 8))
        i = i + 1
    }
    serial.nl()
}

// --------------------------------------------------------- measurement 2

fn stress(state: u64) {
    var s_head: [u8; 13] = "smp: stress \0"
    var s_want: [u8; 6] = "want=\0"
    var s_got: [u8; 7] = "  got=\0"
    var s_lost: [u8; 8] = "  lost=\0"
    var s_lk: [u8; 9] = "  locks=\0"
    var s_sp: [u8; 9] = "  spins=\0"

    atomic.store(sp(state, S_COUNTER), 0)
    run_phase(state, 0, PH_STRESS)
    let online: u64 = cpu.online_count(state)
    let want: u64 = online * STRESS_ITER
    let got: u64 = atomic.load(sp(state, S_COUNTER))
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_want[0]) as u64)
    serial.dec(want)
    serial.puts((&s_got[0]) as u64)
    serial.dec(got)
    serial.puts((&s_lost[0]) as u64)
    if got > want {
        serial.dec(0)
    } else {
        serial.dec(want - got)
    }
    serial.puts((&s_lk[0]) as u64)
    serial.dec(atomic.lock_takes(state, atomic.L_STRESS))
    serial.puts((&s_sp[0]) as u64)
    serial.dec(atomic.lock_spins(state, atomic.L_STRESS))
    serial.nl()
}

// ============================ RUNDE PROTOKOLL: Messung 5, Punkt (a)
//
// VIER KERNE, JE ZEHNTAUSEND ZEILEN, EIN RING.
//
// Was hier gemessen wird und was nicht:
//
//   `zeilen=`   was die Kerne zu schreiben BEHAUPTEN (4 * 10000). Das
//               ist der Sollwert und kommt aus den Kernen selbst, nicht
//               aus dieser Funktion -- ein Kern, der frueh aufhoert,
//               faellt damit auf.
//   `gesamt=`   was der Ring GEZAEHLT hat (`klog.seq`). Verloren gehen
//               darf keine einzige: der Zaehler steht unter derselben
//               Sperre wie das Schreiben. Ist er kleiner, haben zwei
//               Kerne dieselbe Laufnummer bekommen.
//   `ring=`     wie viele davon noch im Ring stehen (510).
//   `rotiert=`  wie viele herausgefallen sind. Das ist kein Verlust,
//               das ist der Sinn eines Ringpuffers -- aber es muss
//               genau `gesamt - 510` sein.
//   `kaputt=`   Eintraege, in denen Kopf und Text von verschiedenen
//               Kernen stammen (`klog.verify`). Das ist die Zahl, um
//               die es geht, und sie muss 0 sein.
fn lograce(state: u64) {
    var s_head: [u8; 15] = "smp: lograce \0\0"
    var s_k: [u8; 7] = "kerne=\0"
    var s_z: [u8; 10] = "  zeilen=\0"
    var s_g: [u8; 10] = "  gesamt=\0"
    var s_r: [u8; 8] = "  ring=\0"
    var s_ro: [u8; 11] = "  rotiert=\0"
    var s_b: [u8; 10] = "  kaputt=\0"
    var s_ms: [u8; 7] = "  ms=\0\0"
    var s_bh: [u8; 14] = "smp: logbank \0"
    var s_n: [u8; 9] = "aufrufe=\0"
    var s_ns: [u8; 7] = "  ns=\0\0"
    var s_je: [u8; 12] = "  ns_je_10=\0"

    if !on(state, M_LOGRACE) {
        return
    }
    let online: u64 = cpu.online_count(state)
    var i: u64 = 0
    while i < kstate.MAX_CPUS {
        atomic.store(sp(state, S_LOGN) + i * 8, 0)
        i = i + 1
    }
    let before: u64 = klog.seq(state)
    let t0: u64 = time.mono_ns(state)
    run_phase(state, 0, PH_LOG)
    let t1: u64 = time.mono_ns(state)

    var soll: u64 = 0
    i = 0
    while i < online {
        soll = soll + atomic.load(sp(state, S_LOGN) + i * 8)
        i = i + 1
    }
    let gesamt: u64 = klog.seq(state) - before
    var ring: u64 = klog.seq(state)
    if ring > klog.N_ENT {
        ring = klog.N_ENT
    }
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_k[0]) as u64)
    serial.dec(online)
    serial.puts((&s_z[0]) as u64)
    serial.dec(soll)
    serial.puts((&s_g[0]) as u64)
    serial.dec(gesamt)
    serial.puts((&s_r[0]) as u64)
    serial.dec(ring)
    serial.puts((&s_ro[0]) as u64)
    serial.dec(klog.lost(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(klog.verify(state))
    serial.puts((&s_ms[0]) as u64)
    serial.dec((t1 - t0) / 1000000)
    serial.nl()

    // ------------------ und gleich daneben Punkt (e): der schnelle Weg.
    //
    // Eine Million Aufrufe der Stufe debug bei einer Schwelle darueber.
    // Die Zahl, auf die es ankommt, steht als `ns` da; `ns_je_10` ist
    // dieselbe Zahl je zehn Aufrufe, damit man sie ohne Bruchrechnung
    // lesen kann.
    let ns: u64 = klog.bench(state, 1000000)
    serial.puts((&s_bh[0]) as u64)
    serial.puts((&s_n[0]) as u64)
    serial.dec(1000000)
    serial.puts((&s_ns[0]) as u64)
    serial.dec(ns)
    serial.puts((&s_ms[0]) as u64)
    serial.dec(ns / 1000000)
    serial.puts((&s_je[0]) as u64)
    serial.dec(ns / 100000)
    serial.nl()
}

// --------------------------------------------------------- measurement 3

// K-012: ACHT RUNDEN STATT EINER.
//
// Die Gegenprobe `nolock` hat ueber vier Laeufe 5/0/6/0 doppelte Rahmen
// gemessen -- in der Haelfte der Laeufe hat sich das Rennen, das sie
// zeigen soll, schlicht nicht ereignet. Sechzehn Rahmen je Kern sind
// seit Runde MEM (Suchbeginn am Merker statt bei 0) nur ein paar
// hundert Takte Arbeit, und ein Kern, der die Phase einen Augenblick
// spaeter sieht, beginnt, wenn der erste schon fertig ist.
//
// Das Rennen wird NICHT verbreitert und nichts kuenstlich verzoegert --
// es bleibt das des echten Verteilers. Es wird nur OEFTER gelaufen:
// acht Runden, jede ein eigenes Nehmen, Zaehlen und Zurueckgeben. Mit
// der Sperre muss die Summe ueber ALLE acht 0 sein (die Zusage wird
// strenger, nicht weicher); ohne sie reicht eine Runde, in der sich
// zwei Kerne treffen. `hits` sagt, in wie vielen Runden das geschah.
const FR_ROUNDS: u64 = 8

static mut fr_zero: u64 = 0
static mut fr_freed: u64 = 0

fn frames(state: u64) {
    var s_head: [u8; 13] = "smp: frames \0"
    var s_got: [u8; 5] = "got=\0"
    var s_dup: [u8; 8] = "  dups=\0"
    var s_zero: [u8; 8] = "  zero=\0"
    var s_free: [u8; 9] = "  freed=\0"
    var s_rnd: [u8; 10] = "  rounds=\0"
    var s_hit: [u8; 8] = "  hits=\0"

    let online: u64 = cpu.online_count(state)
    let total: u64 = online * FR_PER
    fr_zero = 0
    fr_freed = 0
    var dups: u64 = 0
    var hits: u64 = 0
    var r: u64 = 0
    while r < FR_ROUNDS {
        let d: u64 = frames_round(state, total, r)
        dups = dups + d
        if d > 0 {
            hits = hits + 1
        }
        r = r + 1
    }
    sset(state, S_DUPS, dups)

    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_got[0]) as u64)
    serial.dec(total)
    serial.puts((&s_dup[0]) as u64)
    serial.dec(dups)
    serial.puts((&s_zero[0]) as u64)
    serial.dec(fr_zero)
    serial.puts((&s_free[0]) as u64)
    serial.dec(fr_freed)
    serial.puts((&s_rnd[0]) as u64)
    serial.dec(FR_ROUNDS)
    serial.puts((&s_hit[0]) as u64)
    serial.dec(hits)
    serial.nl()
}

// One round: every core takes FR_PER frames out of the one allocator,
// the boot processor counts the doubles and gives everything back.
fn frames_round(state: u64, total: u64, r: u64) -> u64 {
    var i: u64 = 0
    while i < kstate.MAX_CPUS * FR_PER {
        atomic.store(sp(state, S_FRAMES) + i * 8, 0)
        i = i + 1
    }
    run_phase(state, 0, PH_FRAMES_R + r)

    // Every frame that was handed out twice is a frame two parts of the
    // kernel now believe is theirs alone.
    var dups: u64 = 0
    i = 0
    while i < total {
        let a: u64 = atomic.load(sp(state, S_FRAMES) + i * 8)
        if a == 0 {
            fr_zero = fr_zero + 1
        } else {
            var k: u64 = 0
            while k < i {
                if atomic.load(sp(state, S_FRAMES) + k * 8) == a {
                    dups = dups + 1
                    k = i
                } else {
                    k = k + 1
                }
            }
        }
        i = i + 1
    }

    // Give them back. A frame that came twice is freed once -- the
    // allocator would otherwise count it free twice over, which is the
    // second half of the same bug.
    i = 0
    while i < total {
        let a: u64 = atomic.load(sp(state, S_FRAMES) + i * 8)
        if a != 0 {
            var seen: bool = false
            var k: u64 = 0
            while k < i {
                if atomic.load(sp(state, S_FRAMES) + k * 8) == a {
                    seen = true
                    k = i
                } else {
                    k = k + 1
                }
            }
            if !seen {
                mem.frame_free(state, a)
                fr_freed = fr_freed + 1
            }
        }
        i = i + 1
    }

    return dups
}

// --------------------------------------------------------- measurement 4

// The scheduler across cores. The started cores stop being workers and
// become schedulers: each takes an idle task of its own, switches its
// timer on, and from then on takes whatever is ready out of the one run
// queue. The boot processor puts eight kernel tasks in and waits.
fn schedule_demo(state: u64) {
    var s_head: [u8; 12] = "smp: sched \0"
    var s_tasks: [u8; 7] = "tasks=\0"
    var s_done: [u8; 8] = "  done=\0"
    var s_cores: [u8; 14] = "  cores_used=\0"
    var s_sw: [u8; 12] = "  switches=\0"
    var s_ms: [u8; 7] = "  ms=\0\0"
    var s_per: [u8; 12] = "smp: picks \0"
    var s_c: [u8; 3] = " c\0"
    var s_eq: [u8; 2] = "=\0"

    // RUNDE ARGON (K-021): nur wenn die Kerne noch nicht in ihrer
    // Leerlaufaufgabe stehen. Hat `frueh_start` sie fuer die
    // Entsperrung schon dorthin geschickt, ist `PH_SCHED` laengst
    // gefahren -- ein zweites Mal wuerde `run_phase` auf ein `S_DONE`
    // warten, das keiner mehr hochzaehlt, denn aus `PH_SCHED` kommt
    // kein Kern zurueck.
    if sget(state, S_SCHEDPH) == 0 {
        run_phase(state, 0, PH_SCHED)
        // Give the started cores a moment to reach their idle task
        // before the work goes in; a task that is ready before there is
        // a core to take it simply waits, but the picture is cleaner
        // this way.
        udelay(state, 20000)
    }

    let hz: u64 = apic.tsc_hz(state)
    let t0: u64 = apic.tsc()
    let want: u64 = 8
    var made: u64 = 0
    var i: u64 = 0
    while i < want {
        let t: u64 = sched.create(state, sched.K_GRIND, 1, 0, 0)
        if t != 0 {
            sched.start(state, t)
            made = made + 1
        }
        i = i + 1
    }
    // Wait until they are all corpses, then clear them away.
    var guard: u64 = 0
    var done: u64 = 0
    while guard < 30000 {
        done = sched.zombies(state, sched.K_GRIND)
        if done >= made {
            guard = 30000
        } else {
            sched.yield_now(state)
            udelay(state, 1000)
            guard = guard + 1
        }
    }
    let t1: u64 = apic.tsc()

    var used: u64 = 0
    var c: u64 = 0
    while c < cpu.count(state) {
        if cpu.get(state, c, cpu.C_PICKS) > 0 {
            used = used + 1
        }
        c = c + 1
    }

    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_tasks[0]) as u64)
    serial.dec(made)
    serial.puts((&s_done[0]) as u64)
    serial.dec(done)
    serial.puts((&s_cores[0]) as u64)
    serial.dec(used)
    serial.puts((&s_sw[0]) as u64)
    serial.dec(kstate.get(state, kstate.SWITCHES))
    serial.puts((&s_ms[0]) as u64)
    if hz > 0 {
        serial.dec((t1 - t0) / (hz / 1000))
    } else {
        serial.dec(0)
    }
    serial.nl()

    serial.puts((&s_per[0]) as u64)
    c = 0
    while c < cpu.count(state) {
        serial.puts((&s_c[0]) as u64)
        serial.dec(c)
        serial.puts((&s_eq[0]) as u64)
        serial.dec(cpu.get(state, c, cpu.C_PICKS))
        c = c + 1
    }
    serial.nl()
    sched.reap_all(state)
}

// What a started core becomes once the measurements are over.
fn scheduler_core(state: u64, index: u64) {
    let idle: u64 = sched.adopt(state, sched.K_IDLE, 1,
        cpu.get(state, index, cpu.C_STACK))
    cpu.set(state, index, cpu.C_CUR, idle)
    cpu.set(state, index, cpu.C_IDLE, idle)
    atomic.barrier()
    // This phase is the one a core does not come back from, so it counts
    // itself done BEFORE it starts rather than after.
    atomic.fetch_add(sp(state, S_DONE), 1)
    apic.timer_start(state, 100)
    idt.enable()
    while true {
        cpu.add(state, index, cpu.C_IDLERUNS, 1)
        // RUNDE VSYNC: DER ABLESER GEHOERT HIERHER UND NICHT IN
        // `phases`. Ein gestarteter Kern verlaesst `phases` mit
        // PH_SCHED fuer immer und kommt nie zurueck -- der Ableser
        // dort lief also nur bis zum Start des Ablaufplaners.
        // GEMESSEN: 14 202 Ablesungen auf 4 735 Bilder, also drei je
        // Bild; eine Uebertragung dauert Mikrosekunden und wurde so gut
        // wie nie getroffen. Hier, im Leerlauf, liest er dicht.
        //
        // `idt.halt()` erst DANACH: wer schlaeft, liest nicht.
        var lz: u64 = 0
        while lz < 256 {
            gfx.leser_tick(state)
            lz = lz + 1
        }
        sched.yield_now(state)
        idt.halt()
    }
}

// ------------------------------------------------------------ the locks

fn locks(state: u64) {
    var s_head: [u8; 12] = "smp: locks \0"
    var s_n: [u8; 3] = " l\0"
    var s_eq: [u8; 2] = "=\0"
    var s_sl: [u8; 2] = "/\0"
    var s_off: [u8; 8] = "  off=\0\0"
    serial.puts((&s_head[0]) as u64)
    var i: u64 = 0
    while i < kstate.LOCK_COUNT {
        if atomic.lock_takes(state, i) > 0 {
            serial.puts((&s_n[0]) as u64)
            serial.dec(i)
            serial.puts((&s_eq[0]) as u64)
            serial.dec(atomic.lock_takes(state, i))
            serial.puts((&s_sl[0]) as u64)
            serial.dec(atomic.lock_spins(state, i))
        }
        i = i + 1
    }
    serial.puts((&s_off[0]) as u64)
    serial.dec(atomic.mask(state))
    serial.nl()
}

// ------------------------------------------------------ the command line

// The same shape as `kmain.mode_of` and `hw.mode_of`. Read once, in
// `kmain`, before the frame allocator can hand the command line out as
// heap (the trap that cost round K2 half an hour, see hw.fi).
fn mode_of(cmd: u64) -> u64 {
    var w_nosmp: [u8; 6] = "nosmp\0"
    var w_nolock: [u8; 7] = "nolock\0"
    var w_long: [u8; 8] = "smplong\0"
    var w_all: [u8; 10] = "nolockall\0"
    var w_race: [u8; 8] = "fsrace\0\0"
    var w_blind: [u8; 9] = "fsblind\0\0"
    var w_lograce: [u8; 8] = "lograce\0"
    if cmd == 0 {
        return 0
    }
    var m: u64 = 0
    if find(cmd, (&w_nosmp[0]) as u64, 5) != 0 {
        m = m | M_NOSMP
    }
    if find(cmd, (&w_nolock[0]) as u64, 6) != 0 {
        m = m | M_NOLOCK
    }
    if find(cmd, (&w_long[0]) as u64, 7) != 0 {
        m = m | M_SMPLONG
    }
    if find(cmd, (&w_all[0]) as u64, 9) != 0 {
        m = m | M_NOLOCKALL
    }
    // RUNDE MERGE-6: `fsblind` schaltet `fsrace` mit ein. Eine
    // Gegenprobe, die man versehentlich ohne die Probe starten kann,
    // misst nichts und sagt es nicht.
    if find(cmd, (&w_race[0]) as u64, 6) != 0 {
        m = m | M_FSRACE
    }
    if find(cmd, (&w_blind[0]) as u64, 7) != 0 {
        m = m | M_FSRACE | M_FSBLIND
    }
    // RUNDE PROTOKOLL.
    if find(cmd, (&w_lograce[0]) as u64, 7) != 0 {
        m = m | M_LOGRACE
    }
    return m
}

fn parse(state: u64, cmd: u64) {
    sset(state, S_MODE, mode_of(cmd))
}

fn find(hay: u64, needle: u64, n: u64) -> u64 {
    var i: u64 = 0
    while kstate.get8(hay + i) != 0 {
        var k: u64 = 0
        var hit: bool = true
        while k < n {
            if kstate.get8(hay + i + k) != kstate.get8(needle + k) {
                hit = false
                k = n
            } else {
                k = k + 1
            }
        }
        if hit {
            return hay + i
        }
        i = i + 1
    }
    return 0
}
