
import serial
import lib.kstate
import mm.mmframe
import idt
import apic
import sync.atomic
import arch.cpu
import acpi.acpi
import guard
import fpu
import sched.sched
import user
import fs.fs
import gfx.gfx
import klog
import sched.time
import libc.numeric

export {
    stage, ap_main, parse, mode_of, present,
    frueh_start,
    wache_brueche,
    park_all, unpark_all,
    M_NOSMP, M_NOLOCK, M_SMPLONG, M_NOLOCKALL,
    M_FSRACE, M_FSBLIND
}

const V_SMP: u64 = 65
const V_AP_MAIN: u64 = 66

const P_CR3: u64 = 0x00
const P_STACK: u64 = 0x08
const P_ENTRY: u64 = 0x10
const P_KDATA: u64 = 0x18
const P_CPU: u64 = 0x20
const P_FLAG: u64 = 0x28

const S_PHASE: u64 = 256
const S_DONE: u64 = 264
const S_COUNTER: u64 = 272
const S_UNITS: u64 = 280
const S_T0: u64 = 288
const S_T1: u64 = 296
const S_STARTED: u64 = 304
const S_FAILED: u64 = 312
const S_TRAMP: u64 = 320
const S_DUPS: u64 = 328
const S_MODE: u64 = 336
const S_CLAIM: u64 = 344
const S_FSRACE: u64 = 352
const S_FSBLIND: u64 = 360
const S_SCHEDPH: u64 = 368
const S_PROBED: u64 = 376
const S_FSSOLL: u64 = 2048
const S_FSFEHL: u64 = 2112
const S_GSOLL: u64 = 2176
const S_GFEHL: u64 = 2240
const S_GRUNDEN: u64 = 2304
const S_GSUM: u64 = 2368
const S_FRAMES: u64 = 1024
const S_LOGN: u64 = 2176

const PH_WAIT: u64 = 0
const PH_BENCH: u64 = 1
const PH_STRESS: u64 = 2
const PH_FRAMES: u64 = 3
const PH_SCHED: u64 = 4
const PH_FSRACE: u64 = 5
const PH_LOG: u64 = 6
const PH_GRACE: u64 = 7
const PH_FRAMES_R: u64 = 64

const M_NOSMP: u64 = 1
const M_NOLOCK: u64 = 2
const M_SMPLONG: u64 = 4
const M_NOLOCKALL: u64 = 8
const M_FSRACE: u64 = 16
const M_FSBLIND: u64 = 32
const M_LOGRACE: u64 = 64

const TOTAL_UNITS: u64 = 12
const STEP: u64 = 8000000
const STEP_LONG: u64 = 32000000

const STRESS_ITER: u64 = 1500
const STRESS_GAP: u64 = 6

const FR_PER: u64 = 16

const LOG_ITER: u64 = 10000

const FSRACE_ITER: u64 = 20000
const GRACE_ITER: u64 = 40
const GRACE_COLD: u64 = 25

const AP_STACK_FRAMES: u64 = 16
const AP_STACK_GUARD: u64 = 1
const GDT_IN_PAGE: u64 = 0x000
const GDTR_IN_PAGE: u64 = 0x040
const TSS_IN_PAGE: u64 = 0x080

fn sp(state: u64, off: u64) -> u64 {
    return state + kstate.SMP_OFF + off
}

fn sget(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.SMP_OFF + off)
}

fn sset(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.SMP_OFF + off, v)
}

fn at(vectors: u64, i: u64) -> u64 {
    return __mmio_read64((vectors + i * 8) as *mut u64)
}

fn tv(table: u64, i: u64) -> u64 {
    return __mmio_read64((table + i * 8) as *mut u64)
}

fn mode(state: u64) -> u64 {
    return sget(state, S_MODE)
}

fn on(state: u64, bit: u64) -> bool {
    return (mode(state) & bit) != 0
}

fn probe(state: u64) -> u64 {
    cpu.set_lapic(state, apic.window(state))
    let n: u64 = acpi.find(state)
    if n == 0 {
        cpu.register(state, apic.id(state))
        cpu.set_online(state, 0, 1)
        return 1
    }
    let me: u64 = apic.id(state)
    cpu.register(state, me)
    var i: u64 = 0
    while i < n {
        let id: u64 = acpi.cpus(state, i)
        if id != me && id != 256 {
            cpu.register(state, id)
        }
        i = i + 1
    }
    cpu.set_online(state, 0, 1)
    return cpu.count(state)
}

fn present(state: u64) -> u64 {
    return cpu.count(state)
}

fn udelay(state: u64, us: u64) {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        var i: u64 = 0
        while i < us * 100 {
            atomic.pause()
            i = i + 1
        }
        return
    }
    let want: u64 = hz / 1000000 * us
    let t0: u64 = apic.tsc()
    while !time.expired(t0, want) {
        atomic.pause()
    }
}

const ICR_INIT: u64 = 0x00000500
const ICR_STARTUP: u64 = 0x00000600
const ICR_ASSERT: u64 = 0x00004000
const ICR_LEVEL: u64 = 0x00008000

fn wake(state: u64, apid: u64, vector: u64) {
    apic.ipi(state, apid, ICR_INIT | ICR_LEVEL | ICR_ASSERT)
    udelay(state, 200)
    apic.ipi(state, apid, ICR_INIT | ICR_LEVEL)
    udelay(state, 10000)
    apic.ipi(state, apid, ICR_STARTUP | vector)
    udelay(state, 200)
    apic.ipi(state, apid, ICR_STARTUP | vector)
    udelay(state, 200)
}

fn prep_blob(state: u64) -> u64 {
    let vectors: u64 = kstate.get(state, kstate.VECTORS)
    let table: u64 = at(vectors, V_SMP)
    let blob: u64 = tv(table, 0)
    let blob_end: u64 = tv(table, 1)
    let base: u64 = tv(table, 2)
    let param: u64 = tv(table, 3)
    sset(state, S_TRAMP, base)

    var i: u64 = 0
    while blob + i < blob_end {
        kstate.set8(base + i, kstate.get8(blob + i) as u8)
        i = i + 1
    }

    atomic.store(param + P_CR3, kstate.get(state, kstate.KPML4))
    atomic.store(param + P_KDATA, state)
    atomic.store(param + P_ENTRY, at(vectors, V_AP_MAIN))
    return param
}

fn start(state: u64) {
    let vectors: u64 = kstate.get(state, kstate.VECTORS)
    let table: u64 = at(vectors, V_SMP)
    let base: u64 = tv(table, 2)
    let param: u64 = prep_blob(state)

    let n: u64 = cpu.count(state)
    var k: u64 = 1
    while k < n {
        one(state, k, param, base)
        k = k + 1
    }
}

const WACHE_MUSTER: u64 = 0xC0DEFACEC0DEFACE
static mut wache_von: [u64; 8] = [0 as u64; 8]

fn draw_guard(roh: u64, stack: u64) {
    var w: u64 = roh
    while w < stack {
        __mmio_write64(w as *mut u64, WACHE_MUSTER)
        w = w + 8
    }
}

fn wache_brueche(state: u64) -> u64 {
    var k: u64 = 1
    var c: u64 = 0
    while k < 8 {
        let roh: u64 = wache_von[k as usize]
        if roh != 0 {
            let top_v: u64 = roh + mmframe.FRAME_SIZE
            var p: u64 = roh
            var broken: u64 = 0
            while p < top_v {
                if __mmio_read64(p as *mut u64) != WACHE_MUSTER {
                    broken = 1
                    p = top_v
                } else {
                    p = p + 8
                }
            }
            c = c + broken
        }
        k = k + 1
    }
    return c
}

fn one(state: u64, k: u64, param: u64, base: u64) {
    let roh: u64 = mmframe.frame_run(state, AP_STACK_FRAMES + AP_STACK_GUARD)
    let page: u64 = mmframe.frame_alloc(state)
    let dfst: u64 = mmframe.frame_run(state, (idt.DF_STACK_BYTES + idt.NMI_STACK_BYTES) / mmframe.FRAME_SIZE)
    if roh == 0 || page == 0 || dfst == 0 {
        kstate.add(state, kstate.SMP_OFF + S_FAILED, 1)
        cpu.set(state, k, cpu.C_WHY, cpu.WHY_NOMEM)
        return
    }
    let stack: u64 = roh + AP_STACK_GUARD * mmframe.FRAME_SIZE
    draw_guard(roh, stack)
    wache_von[k as usize] = roh
    let top: u64 = stack + AP_STACK_FRAMES * mmframe.FRAME_SIZE
    cpu.set(state, k, cpu.C_STACK, top)
    cpu.set(state, k, cpu.C_GDT, page)
    cpu.set(state, k, cpu.C_TSS, dfst + idt.DF_STACK_BYTES)

    kstate.add(state, kstate.SMP_OFF + S_STARTED, 1)
    bring(state, k, param, base)
}

fn bring(state: u64, k: u64, param: u64, base: u64) {
    atomic.store(param + P_STACK, cpu.get(state, k, cpu.C_STACK))
    atomic.store(param + P_CPU, k)
    atomic.store(param + P_FLAG, 0)

    wake(state, cpu.apic_id(state, k), base >> 12)
    cpu.set(state, k, cpu.C_ESR, apic.esr_take(state))

    var guard: u64 = 0
    while guard < 2000 {
        if atomic.load(param + P_FLAG) != 0 {
            guard = 2000
        } else {
            udelay(state, 1000)
            guard = guard + 1
        }
    }
    if atomic.load(param + P_FLAG) == 0 {
        kstate.add(state, kstate.SMP_OFF + S_FAILED, 1)
        cpu.set(state, k, cpu.C_WHY, cpu.WHY_NOSIPI)
        return
    }
    guard = 0
    while guard < 2000 {
        if cpu.online(state, k) {
            guard = 2000
        } else {
            udelay(state, 1000)
            guard = guard + 1
        }
    }
    if !cpu.online(state, k) {
        kstate.add(state, kstate.SMP_OFF + S_FAILED, 1)
        cpu.set(state, k, cpu.C_WHY, cpu.WHY_NOONLINE)
    } else {
        cpu.set(state, k, cpu.C_WHY, cpu.WHY_OK)
    }
}

fn put_word(w: u64) {
    var v: u64 = w
    var i: u64 = 0
    while v != 0 && i < 8 {
        serial.put((v & 0xFF) as u8)
        v = v >> 8
        i = i + 1
    }
}

fn report_line(state: u64, n: u64) {
    var s_a: [u8; 7] = "smp: \0\0"
    var s_b: [u8; 12] = " of \0\0\0\0\0\0\0\0"
    var s_c: [u8; 10] = " online, \0"
    var s_d: [u8; 6] = "madt=\0"
    var s_e: [u8; 12] = ", failed:\0\0\0"
    var s_f: [u8; 6] = " none\0"
    var s_g: [u8; 3] = " c\0"
    var s_h: [u8; 7] = "(apic \0"
    var s_i: [u8; 6] = ",esr \0"
    var s_j: [u8; 2] = ")\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(cpu.online_count(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(n)
    serial.puts((&s_c[0]) as u64)
    serial.puts((&s_d[0]) as u64)
    serial.dec(acpi.total(state))
    serial.puts((&s_e[0]) as u64)
    var bad: u64 = 0
    var k: u64 = 0
    while k < n && k < kstate.MAX_CPUS {
        if !cpu.online(state, k) {
            bad = bad + 1
            serial.puts((&s_g[0]) as u64)
            serial.dec(k)
            serial.puts((&s_h[0]) as u64)
            serial.dec(cpu.apic_id(state, k))
            serial.put(44)
            put_word(cpu.why_word(cpu.get(state, k, cpu.C_WHY)))
            serial.puts((&s_i[0]) as u64)
            serial.hex(cpu.get(state, k, cpu.C_ESR))
            serial.puts((&s_j[0]) as u64)
        }
        k = k + 1
    }
    if acpi.total(state) > n {
        var s_k: [u8; 12] = " notstarted\0"
        serial.puts((&s_k[0]) as u64)
        serial.put(61)
        serial.dec(acpi.total(state) - n)
    } else if bad == 0 {
        serial.puts((&s_f[0]) as u64)
    }
    serial.nl()
}

fn arm_gs_index(state: u64) {
    if sched.gs_lie_get() == 0 {
        cpu.gs_arm(state)
    }
}

fn ap_main(state: u64, index: u64) {
    tables(state, index)
    guard.apply_here(state)
    fpu.apply_here(state)
    user.setup_here(state, cpu.record(state, index))
    if sched.gs_lie_get() != 0 && index != 0 {
        user.gs_set(cpu.record(state, 0))
    }
    sched.gs_report(state, index,
        user.gs_base() == cpu.record(state, index))
    apic.core_init(state, index)
    cpu.set(state, index, cpu.C_ONLINE, 1)
    atomic.barrier()
    if cpu.get(state, index, cpu.C_RESUMED) != 0 && cpu.get(state, index, cpu.C_IDLE) != 0 {
        scheduler_core(state, index)
    }
    phases(state, index)
    while true {
        asm("cli")
        asm("hlt")
    }
}

fn tables(state: u64, index: u64) {
    let page: u64 = cpu.get(state, index, cpu.C_GDT)
    let src: u64 = kstate.get(state, kstate.GDT)
    var i: u64 = 0
    while i < 8 {
        __mmio_write64((page + GDT_IN_PAGE + i * 8) as *mut u64,
            __mmio_read64((src + i * 8) as *mut u64))
        i = i + 1
    }
    let gdtr: u64 = page + GDTR_IN_PAGE
    __mmio_write16(gdtr as *mut u16, (8 * 8 - 1) as u16)
    __mmio_write64((gdtr + 2) as *mut u64, page + GDT_IN_PAGE)
    asm("lgdt [rax]", in("rax") gdtr, clobber("memory"))
    idt.tss_install(page + GDT_IN_PAGE, page + TSS_IN_PAGE,
        cpu.get(state, index, cpu.C_STACK), cpu.get(state, index, cpu.C_TSS),
        cpu.record(state, index))
    cpu.set(state, index, cpu.C_TSSADDR, page + TSS_IN_PAGE)
    asm("lidt [rax]", in("rax") state + kstate.IDTR, clobber("memory"))
}

fn phases(state: u64, index: u64) {
    var seen: u64 = PH_WAIT
    if cpu.get(state, index, cpu.C_RESUMED) != 0 {
        seen = atomic.load(sp(state, S_PHASE))
    }
    while true {
        if cpu.get(state, index, cpu.C_PARKREQ) != 0 {
            park_here(state, index)
        }
        let ph: u64 = atomic.load(sp(state, S_PHASE))
        if ph != seen {
            seen = ph
            if ph == PH_BENCH {
                bench_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph == PH_STRESS {
                stress_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph == PH_FSRACE {
                fsrace_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph == PH_LOG {
                lograce_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph >= PH_GRACE && ph < PH_FRAMES_R {
                grace_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph >= PH_FRAMES_R {
                frames_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph == PH_FRAMES {
                frames_core(state, index)
                atomic.fetch_add(sp(state, S_DONE), 1)
            }
            if ph == PH_SCHED {
                scheduler_core(state, index)
                return
            }
        }
        gfx.leser_tick(state)
        atomic.pause()
    }
}

fn grind(steps: u64) -> u64 {
    var acc: u64 = 0x243F6A8885A308D3
    var i: u64 = 0
    while i < steps {
        acc = acc *% 6364136223846793005
        acc = acc +% 1442695040888963407
        acc = acc ^ (acc >> 33)
        i = i + 1
    }
    return acc
}

fn step_size(state: u64) -> u64 {
    if on(state, M_SMPLONG) {
        return STEP_LONG
    }
    return STEP
}

fn bench_core(state: u64, index: u64) {
    let total: u64 = sget(state, S_UNITS)
    let step: u64 = step_size(state)
    let t0: u64 = apic.tsc()
    var acc: u64 = 0
    var mine: u64 = 0
    var going: bool = true
    while going {
        if atomic.fetch_add(sp(state, S_CLAIM), 1) >= total {
            going = false
        } else {
            acc = acc ^ grind(step)
            mine = mine + 1
        }
    }
    let t1: u64 = apic.tsc()
    cpu.set(state, index, cpu.C_SUM, acc)
    cpu.set(state, index, cpu.C_CYCLES, t1 - t0)
    cpu.set(state, index, cpu.C_WORK, mine)
}

fn stress_core(state: u64, index: u64) {
    let p: u64 = sp(state, S_COUNTER)
    var i: u64 = 0
    while i < STRESS_ITER {
        atomic.lock_take(state, atomic.L_STRESS, index)
        let v: u64 = atomic.load(p)
        var k: u64 = 0
        while k < STRESS_GAP {
            atomic.pause()
            k = k + 1
        }
        atomic.store(p, v + 1)
        atomic.lock_give(state, atomic.L_STRESS)
        i = i + 1
    }
}

fn fsrace_core(state: u64, index: u64) {
    let soll: u64 = atomic.load(sp(state, S_FSSOLL) + index * 8)
    let blind: bool = atomic.load(sp(state, S_FSBLIND)) != 0
    let n: u64 = fs.race_core(state, index, soll,
        atomic.load(sp(state, S_FSRACE)), blind)
    atomic.store(sp(state, S_FSFEHL) + index * 8, n)
}

fn frames_core(state: u64, index: u64) {
    let row: u64 = sp(state, S_FRAMES) + index * FR_PER * 8
    var i: u64 = 0
    while i < FR_PER {
        atomic.store(row + i * 8, mmframe.frame_alloc(state))
        i = i + 1
    }
}

fn grace_core(state: u64, index: u64) {
    let n: u64 = gfx.grace_core(state, index,
        atomic.load(sp(state, S_GRUNDEN)),
        atomic.load(sp(state, S_GSOLL) + index * 8))
    atomic.store(sp(state, S_GFEHL) + index * 8, n)
}

fn run_phase(state: u64, index: u64, ph: u64) {
    let n: u64 = cpu.online_count(state)
    atomic.store(sp(state, S_DONE), 0)
    atomic.barrier()
    atomic.store(sp(state, S_PHASE), ph)
    if ph == PH_SCHED {
        sset(state, S_SCHEDPH, 1)
    }
    if ph == PH_BENCH {
        bench_core(state, index)
    }
    if ph == PH_STRESS {
        stress_core(state, index)
    }
    if ph == PH_FRAMES {
        frames_core(state, index)
    }
    if ph == PH_FSRACE {
        fsrace_core(state, index)
    }
    if ph == PH_LOG {
        lograce_core(state, index)
    }
    if ph >= PH_GRACE && ph < PH_FRAMES_R {
        grace_core(state, index)
    }
    if ph >= PH_FRAMES_R {
        frames_core(state, index)
    }
    atomic.fetch_add(sp(state, S_DONE), 1)
    var guard: u64 = 0
    while atomic.load(sp(state, S_DONE)) < n {
        atomic.pause()
        guard = guard + 1
        if guard > 4000000000 {
            return
        }
    }
}

fn frueh_start(state: u64) -> u64 {
    if !apic.active(state) {
        return 1
    }
    if on(state, M_NOSMP) {
        if sget(state, S_PROBED) == 0 {
            let nn: u64 = probe(state)
            sset(state, S_PROBED, 1)
            var q: u64 = 1
            while q < nn && q < kstate.MAX_CPUS {
                cpu.set(state, q, cpu.C_WHY, cpu.WHY_NOSMP)
                q = q + 1
            }
        }
        return 1
    }
    if sget(state, S_PROBED) != 0 {
        return cpu.online_count(state)
    }
    let n: u64 = probe(state)
    sset(state, S_PROBED, 1)
    if n <= 1 {
        return 1
    }
    start(state)
    run_phase(state, 0, PH_SCHED)
    udelay(state, 20000)
    var s_f: [u8; 19] = "smp: frueh online=\0"
    var s_of2: [u8; 5] = " of \0"
    serial.puts((&s_f[0]) as u64)
    serial.dec(cpu.online_count(state))
    serial.puts((&s_of2[0]) as u64)
    serial.dec(n)
    serial.nl()
    return cpu.online_count(state)
}

fn stage(state: u64) {
    var s_none: [u8; 26] = "smp: no local APIC, alone\0"
    var s_cpus: [u8; 11] = "smp: cpus=\0"
    var s_acpi: [u8; 8] = "  acpi=\0"
    var s_rev: [u8; 7] = "  rev=\0"
    var s_ids: [u8; 8] = "  apic=\0"
    var s_off: [u8; 27] = "smp: nosmp, one core only\0\0"
    var s_on: [u8; 13] = "smp: online=\0"
    var s_of: [u8; 5] = " of \0"
    var s_fail: [u8; 10] = "  failed=\0"
    var s_lock: [u8; 24] = "smp: locks OFF (nolock)\0"
    var s_lockall: [u8; 27] = "smp: locks OFF (nolockall)\0"
    var s_sp: [u8; 2] = " \0"

    if !apic.active(state) {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    if on(state, M_NOLOCK) {
        atomic.set_off(state, (1 << atomic.L_FRAME) | (1 << atomic.L_STRESS))
        serial.puts((&s_lock[0]) as u64)
        serial.nl()
    }
    if on(state, M_NOLOCKALL) {
        atomic.set_off(state, 0xFF)
        serial.puts((&s_lockall[0]) as u64)
        serial.nl()
    }
    var n: u64 = 0
    if sget(state, S_PROBED) != 0 {
        n = cpu.count(state)
    } else {
        n = probe(state)
    }
    serial.puts((&s_cpus[0]) as u64)
    serial.dec(n)
    serial.puts((&s_acpi[0]) as u64)
    serial.dec(numeric.yes(acpi.valid(state)))
    serial.puts((&s_rev[0]) as u64)
    serial.dec(acpi.revision(state))
    serial.puts((&s_ids[0]) as u64)
    var i: u64 = 0
    while i < n {
        serial.dec(cpu.apic_id(state, i))
        serial.puts((&s_sp[0]) as u64)
        i = i + 1
    }
    serial.nl()

    if on(state, M_NOSMP) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        var q: u64 = 1
        while q < n && q < kstate.MAX_CPUS {
            cpu.set(state, q, cpu.C_WHY, cpu.WHY_NOSMP)
            q = q + 1
        }
    } else {
        if sget(state, S_STARTED) == 0 {
            start(state)
        }
    }
    serial.puts((&s_on[0]) as u64)
    serial.dec(cpu.online_count(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(n)
    serial.puts((&s_fail[0]) as u64)
    serial.dec(sget(state, S_FAILED))
    serial.nl()
    report_line(state, n)

    if cpu.count(state) <= 1 && !on(state, M_NOSMP) {
        locks(state)
        return
    }
    if sget(state, S_SCHEDPH) != 0 {
        var s_sk2: [u8; 51] = "smp: measurements off -- cores already scheduling\0\0"
        serial.puts((&s_sk2[0]) as u64)
        serial.nl()
        locks(state)
        return
    }
    bench(state)
    stress(state)
    frames(state)
    fsrace(state)
    glyphrace(state)
    lograce(state)
    if !on(state, M_NOLOCK) && !on(state, M_NOLOCKALL) {
        schedule_demo(state)
    }
    locks(state)
}

fn bench(state: u64) {
    var s_head: [u8; 12] = "smp: bench \0"
    var s_cores: [u8; 7] = "cores=\0"
    var s_units: [u8; 9] = "  units=\0"
    var s_step: [u8; 8] = "  step=\0"
    var s_cyc: [u8; 10] = "  cycles=\0"
    var s_ms: [u8; 7] = "  ms=\0\0"
    var s_per: [u8; 13] = "smp: percore\0"
    var s_c: [u8; 4] = "  c\0"
    var s_eq: [u8; 2] = "=\0"
    var s_work: [u8; 12] = "smp: shares\0"
    var s_sum: [u8; 7] = "  sum=\0"

    let online: u64 = cpu.online_count(state)
    sset(state, S_UNITS, TOTAL_UNITS)
    atomic.store(sp(state, S_CLAIM), 0)

    apic.timer_stop(state)
    let t0: u64 = apic.tsc()
    run_phase(state, 0, PH_BENCH)
    let t1: u64 = apic.tsc()
    apic.timer_start(state, 100)
    sset(state, S_T0, t0)
    sset(state, S_T1, t1)

    let hz: u64 = apic.tsc_hz(state)
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_cores[0]) as u64)
    serial.dec(online)
    serial.puts((&s_units[0]) as u64)
    serial.dec(TOTAL_UNITS)
    serial.puts((&s_step[0]) as u64)
    serial.dec(step_size(state))
    serial.puts((&s_cyc[0]) as u64)
    serial.dec(t1 - t0)
    serial.puts((&s_ms[0]) as u64)
    if hz > 0 {
        serial.dec((t1 - t0) / (hz / 1000))
    } else {
        serial.dec(0)
    }
    serial.nl()

    serial.puts((&s_per[0]) as u64)
    var i: u64 = 0
    while i < cpu.count(state) {
        serial.puts((&s_c[0]) as u64)
        serial.dec(i)
        serial.puts((&s_eq[0]) as u64)
        serial.dec(cpu.get(state, i, cpu.C_CYCLES))
        i = i + 1
    }
    serial.nl()

    serial.puts((&s_work[0]) as u64)
    var w: u64 = 0
    var sum: u64 = 0
    while w < cpu.count(state) {
        serial.puts((&s_c[0]) as u64)
        serial.dec(w)
        serial.puts((&s_eq[0]) as u64)
        serial.dec(cpu.get(state, w, cpu.C_WORK))
        sum = sum + cpu.get(state, w, cpu.C_WORK)
        w = w + 1
    }
    serial.puts((&s_sum[0]) as u64)
    serial.dec(sum)
    serial.nl()
}

fn lograce_core(state: u64, index: u64) {
    var i: u64 = 0
    while i < LOG_ITER {
        klog.race_line(state, index, i)
        i = i + 1
    }
    atomic.store(sp(state, S_LOGN) + index * 8, LOG_ITER)
}

fn fsrace(state: u64) {
    var s_head: [u8; 14] = "smp: fsrace \0\0"
    var s_cores: [u8; 7] = "cores=\0"
    var s_it: [u8; 10] = "  rounds=\0"
    var s_bl: [u8; 9] = "  blind=\0"
    var s_err: [u8; 10] = "  errors=\0"
    var s_ino: [u8; 9] = "  inode=\0"
    var s_c: [u8; 4] = "  c\0"
    var s_eq: [u8; 2] = "=\0"

    if !on(state, M_FSRACE) {
        return
    }
    let online: u64 = cpu.online_count(state)
    var blind: u64 = 0
    if on(state, M_FSBLIND) {
        blind = 1
    }
    atomic.store(sp(state, S_FSRACE), FSRACE_ITER)
    atomic.store(sp(state, S_FSBLIND), blind)
    var i: u64 = 0
    while i < kstate.MAX_CPUS {
        atomic.store(sp(state, S_FSSOLL) + i * 8, fs.race_soll(state, i))
        atomic.store(sp(state, S_FSFEHL) + i * 8, 0)
        i = i + 1
    }
    run_phase(state, 0, PH_FSRACE)

    var err: u64 = 0
    i = 0
    while i < online {
        err = err + atomic.load(sp(state, S_FSFEHL) + i * 8)
        i = i + 1
    }
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_cores[0]) as u64)
    serial.dec(online)
    serial.puts((&s_it[0]) as u64)
    serial.dec(FSRACE_ITER)
    serial.puts((&s_bl[0]) as u64)
    serial.dec(blind)
    serial.puts((&s_err[0]) as u64)
    serial.dec(err)
    serial.nl()

    serial.puts((&s_head[0]) as u64)
    i = 0
    while i < online {
        serial.puts((&s_c[0]) as u64)
        serial.dec(i)
        serial.puts((&s_ino[0]) as u64)
        serial.dec(fs.race_ino(state, i))
        serial.puts((&s_eq[0]) as u64)
        serial.dec(atomic.load(sp(state, S_FSFEHL) + i * 8))
        i = i + 1
    }
    serial.nl()
}

fn glyphrace(state: u64) {
    var s_head: [u8; 17] = "smp: glyphrace \0\0"
    var s_cores: [u8; 7] = "cores=\0"
    var s_it: [u8; 10] = "  rounds=\0"
    var s_bl: [u8; 9] = "  blind=\0"
    var s_lk: [u8; 8] = "  lock=\0"
    var s_err: [u8; 10] = "  errors=\0"
    var s_zy: [u8; 10] = "  cycles=\0"
    var s_z: [u8; 10] = "  glyphs=\0"
    var s_cold: [u8; 9] = "  cold=\0\0"
    var s_c: [u8; 4] = "  c\0"
    var s_eq: [u8; 2] = "=\0"
    var s_no: [u8; 27] = "smp: glyph race  no font\0\0\0"

    if !kstate.mode_on(state, kstate.M_GRACE) {
        return
    }
    if gfx.grace_ready(state) == 0xFFFFFFFFFFFFFFFF {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    let online: u64 = cpu.online_count(state)
    var blind: u64 = 0
    if kstate.mode_on(state, kstate.M_GBLIND) {
        blind = 1
    }
    var lock: u64 = 0
    if kstate.mode_on(state, kstate.M_GLOCK) {
        lock = 1
    }
    atomic.store(sp(state, S_GRUNDEN), GRACE_ITER)
    var i: u64 = 0
    while i < kstate.MAX_CPUS {
        atomic.store(sp(state, S_GSOLL) + i * 8, gfx.grace_soll(state, i))
        atomic.store(sp(state, S_GFEHL) + i * 8, 0)
        atomic.store(sp(state, S_GSUM) + i * 8, 0)
        i = i + 1
    }
    var err: u64 = 0
    var zyklen: u64 = 0
    var k: u64 = 0
    while k < GRACE_COLD {
        gfx.grace_cold(state)
        i = 0
        while i < kstate.MAX_CPUS {
            atomic.store(sp(state, S_GFEHL) + i * 8, 0)
            i = i + 1
        }
        let t0: u64 = apic.tsc()
        run_phase(state, 0, PH_GRACE + k)
        zyklen = zyklen + time.since(t0)
        i = 0
        while i < online {
            err = err + atomic.load(sp(state, S_GFEHL) + i * 8)
            atomic.store(sp(state, S_GSUM) + i * 8,
                atomic.load(sp(state, S_GSUM) + i * 8)
                    + atomic.load(sp(state, S_GFEHL) + i * 8))
            i = i + 1
        }
        k = k + 1
    }
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_cores[0]) as u64)
    serial.dec(online)
    serial.puts((&s_it[0]) as u64)
    serial.dec(GRACE_ITER * GRACE_COLD)
    serial.puts((&s_bl[0]) as u64)
    serial.dec(blind)
    serial.puts((&s_lk[0]) as u64)
    serial.dec(lock)
    serial.puts((&s_err[0]) as u64)
    serial.dec(err)
    serial.puts((&s_zy[0]) as u64)
    serial.dec(zyklen)
    serial.puts((&s_cold[0]) as u64)
    serial.dec(GRACE_COLD)
    serial.nl()

    serial.puts((&s_head[0]) as u64)
    i = 0
    while i < online {
        serial.puts((&s_c[0]) as u64)
        serial.dec(i)
        serial.puts((&s_z[0]) as u64)
        serial.dec(i % 26 + 65)
        serial.puts((&s_eq[0]) as u64)
        serial.dec(atomic.load(sp(state, S_GSUM) + i * 8))
        i = i + 1
    }
    serial.nl()
}

fn stress(state: u64) {
    var s_head: [u8; 13] = "smp: stress \0"
    var s_want: [u8; 6] = "want=\0"
    var s_got: [u8; 7] = "  got=\0"
    var s_lost: [u8; 8] = "  lost=\0"
    var s_lk: [u8; 9] = "  locks=\0"
    var s_sp: [u8; 9] = "  spins=\0"

    atomic.store(sp(state, S_COUNTER), 0)
    run_phase(state, 0, PH_STRESS)
    let online: u64 = cpu.online_count(state)
    let want: u64 = online * STRESS_ITER
    let got: u64 = atomic.load(sp(state, S_COUNTER))
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_want[0]) as u64)
    serial.dec(want)
    serial.puts((&s_got[0]) as u64)
    serial.dec(got)
    serial.puts((&s_lost[0]) as u64)
    if got > want {
        serial.dec(0)
    } else {
        serial.dec(want - got)
    }
    serial.puts((&s_lk[0]) as u64)
    serial.dec(atomic.lock_takes(state, atomic.L_STRESS))
    serial.puts((&s_sp[0]) as u64)
    serial.dec(atomic.lock_spins(state, atomic.L_STRESS))
    serial.nl()
}

fn lograce(state: u64) {
    var s_head: [u8; 15] = "smp: lograce \0\0"
    var s_k: [u8; 7] = "cores=\0"
    var s_z: [u8; 9] = "  lines=\0"
    var s_g: [u8; 9] = "  total=\0"
    var s_r: [u8; 8] = "  ring=\0"
    var s_ro: [u8; 11] = "  rotated=\0"
    var s_b: [u8; 10] = "  broken=\0"
    var s_ms: [u8; 7] = "  ms=\0\0"
    var s_bh: [u8; 14] = "smp: logbank \0"
    var s_n: [u8; 7] = "calls=\0"
    var s_ns: [u8; 7] = "  ns=\0\0"
    var s_je: [u8; 12] = "  ns_je_10=\0"

    if !on(state, M_LOGRACE) {
        return
    }
    let online: u64 = cpu.online_count(state)
    var i: u64 = 0
    while i < kstate.MAX_CPUS {
        atomic.store(sp(state, S_LOGN) + i * 8, 0)
        i = i + 1
    }
    let before: u64 = klog.seq(state)
    let t0: u64 = time.mono_ns(state)
    run_phase(state, 0, PH_LOG)
    let t1: u64 = time.mono_ns(state)

    var soll: u64 = 0
    i = 0
    while i < online {
        soll = soll + atomic.load(sp(state, S_LOGN) + i * 8)
        i = i + 1
    }
    let gesamt: u64 = klog.seq(state) - before
    var ring: u64 = klog.seq(state)
    if ring > klog.N_ENT {
        ring = klog.N_ENT
    }
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_k[0]) as u64)
    serial.dec(online)
    serial.puts((&s_z[0]) as u64)
    serial.dec(soll)
    serial.puts((&s_g[0]) as u64)
    serial.dec(gesamt)
    serial.puts((&s_r[0]) as u64)
    serial.dec(ring)
    serial.puts((&s_ro[0]) as u64)
    serial.dec(klog.lost(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(klog.verify(state))
    serial.puts((&s_ms[0]) as u64)
    serial.dec((t1 - t0) / 1000000)
    serial.nl()

    let ns: u64 = klog.bench(state, 1000000)
    serial.puts((&s_bh[0]) as u64)
    serial.puts((&s_n[0]) as u64)
    serial.dec(1000000)
    serial.puts((&s_ns[0]) as u64)
    serial.dec(ns)
    serial.puts((&s_ms[0]) as u64)
    serial.dec(ns / 1000000)
    serial.puts((&s_je[0]) as u64)
    serial.dec(ns / 100000)
    serial.nl()
}

const FR_ROUNDS: u64 = 8

static mut fr_zero: u64 = 0
static mut fr_freed: u64 = 0

fn frames(state: u64) {
    var s_head: [u8; 13] = "smp: frames \0"
    var s_got: [u8; 5] = "got=\0"
    var s_dup: [u8; 8] = "  dups=\0"
    var s_zero: [u8; 8] = "  zero=\0"
    var s_free: [u8; 9] = "  freed=\0"
    var s_rnd: [u8; 10] = "  rounds=\0"
    var s_hit: [u8; 8] = "  hits=\0"

    let online: u64 = cpu.online_count(state)
    let total: u64 = online * FR_PER
    fr_zero = 0
    fr_freed = 0
    var dups: u64 = 0
    var hits: u64 = 0
    var r: u64 = 0
    while r < FR_ROUNDS {
        let d: u64 = frames_pass(state, total, r)
        dups = dups + d
        if d > 0 {
            hits = hits + 1
        }
        r = r + 1
    }
    sset(state, S_DUPS, dups)

    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_got[0]) as u64)
    serial.dec(total)
    serial.puts((&s_dup[0]) as u64)
    serial.dec(dups)
    serial.puts((&s_zero[0]) as u64)
    serial.dec(fr_zero)
    serial.puts((&s_free[0]) as u64)
    serial.dec(fr_freed)
    serial.puts((&s_rnd[0]) as u64)
    serial.dec(FR_ROUNDS)
    serial.puts((&s_hit[0]) as u64)
    serial.dec(hits)
    serial.nl()
}

fn frames_pass(state: u64, total: u64, r: u64) -> u64 {
    var i: u64 = 0
    while i < kstate.MAX_CPUS * FR_PER {
        atomic.store(sp(state, S_FRAMES) + i * 8, 0)
        i = i + 1
    }
    run_phase(state, 0, PH_FRAMES_R + r)

    var dups: u64 = 0
    i = 0
    while i < total {
        let a: u64 = atomic.load(sp(state, S_FRAMES) + i * 8)
        if a == 0 {
            fr_zero = fr_zero + 1
        } else {
            var k: u64 = 0
            while k < i {
                if atomic.load(sp(state, S_FRAMES) + k * 8) == a {
                    dups = dups + 1
                    k = i
                } else {
                    k = k + 1
                }
            }
        }
        i = i + 1
    }

    i = 0
    while i < total {
        let a: u64 = atomic.load(sp(state, S_FRAMES) + i * 8)
        if a != 0 {
            var seen: bool = false
            var k: u64 = 0
            while k < i {
                if atomic.load(sp(state, S_FRAMES) + k * 8) == a {
                    seen = true
                    k = i
                } else {
                    k = k + 1
                }
            }
            if !seen {
                mmframe.frame_free(state, a)
                fr_freed = fr_freed + 1
            }
        }
        i = i + 1
    }

    return dups
}

fn schedule_demo(state: u64) {
    var s_head: [u8; 12] = "smp: sched \0"
    var s_tasks: [u8; 7] = "tasks=\0"
    var s_done: [u8; 8] = "  done=\0"
    var s_cores: [u8; 14] = "  cores_used=\0"
    var s_sw: [u8; 12] = "  switches=\0"
    var s_ms: [u8; 7] = "  ms=\0\0"
    var s_per: [u8; 12] = "smp: picks \0"
    var s_c: [u8; 3] = " c\0"
    var s_eq: [u8; 2] = "=\0"

    if sget(state, S_SCHEDPH) == 0 {
        run_phase(state, 0, PH_SCHED)
        udelay(state, 20000)
    }

    let hz: u64 = apic.tsc_hz(state)
    let t0: u64 = apic.tsc()
    let want: u64 = 8
    var made: u64 = 0
    var i: u64 = 0
    while i < want {
        let t: u64 = sched.create(state, sched.K_GRIND, 1, 0, 0)
        if t != 0 {
            sched.start(state, t)
            made = made + 1
        }
        i = i + 1
    }
    var guard: u64 = 0
    var done: u64 = 0
    while guard < 30000 {
        done = sched.zombies(state, sched.K_GRIND)
        if done >= made {
            guard = 30000
        } else {
            sched.yield_now(state)
            udelay(state, 1000)
            guard = guard + 1
        }
    }
    let t1: u64 = apic.tsc()

    var used: u64 = 0
    var c: u64 = 0
    while c < cpu.count(state) {
        if cpu.get(state, c, cpu.C_PICKS) > 0 {
            used = used + 1
        }
        c = c + 1
    }

    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_tasks[0]) as u64)
    serial.dec(made)
    serial.puts((&s_done[0]) as u64)
    serial.dec(done)
    serial.puts((&s_cores[0]) as u64)
    serial.dec(used)
    serial.puts((&s_sw[0]) as u64)
    serial.dec(kstate.get(state, kstate.SWITCHES))
    serial.puts((&s_ms[0]) as u64)
    if hz > 0 {
        serial.dec((t1 - t0) / (hz / 1000))
    } else {
        serial.dec(0)
    }
    serial.nl()

    serial.puts((&s_per[0]) as u64)
    c = 0
    while c < cpu.count(state) {
        serial.puts((&s_c[0]) as u64)
        serial.dec(c)
        serial.puts((&s_eq[0]) as u64)
        serial.dec(cpu.get(state, c, cpu.C_PICKS))
        c = c + 1
    }
    serial.nl()
    sched.reap_all(state)
}

fn scheduler_core(state: u64, index: u64) {
    var idle: u64 = cpu.get(state, index, cpu.C_IDLE)
    let again: bool = idle != 0 && cpu.get(state, index, cpu.C_RESUMED) != 0
    if again {
        cpu.set(state, index, cpu.C_CUR, idle)
    } else {
        idle = sched.adopt(state, sched.K_IDLE, 1,
            cpu.get(state, index, cpu.C_STACK))
        cpu.set(state, index, cpu.C_CUR, idle)
        cpu.set(state, index, cpu.C_IDLE, idle)
    }
    atomic.barrier()
    arm_gs_index(state)
    if !again {
        atomic.fetch_add(sp(state, S_DONE), 1)
    }
    apic.timer_start(state, 100)
    idt.enable()
    while true {
        cpu.add(state, index, cpu.C_IDLERUNS, 1)
        var lz: u64 = 0
        while lz < 256 {
            gfx.leser_tick(state)
            lz = lz + 1
        }
        sched.yield_now(state)
        if cpu.get(state, index, cpu.C_PARKREQ) != 0
        && cpu.get(state, index, cpu.C_CUR) == cpu.get(state, index, cpu.C_IDLE) {
            park_here(state, index)
        }
        asm("cli")
        apic.timer_rate(state, 10)
        cpu.x_set(state, index, cpu.X_HALTED, 1)
        if cpu.x_get(state, index, cpu.X_PEND) == 0 {
            asm("sti\nhlt")
        } else {
            asm("sti")
        }
        cpu.x_set(state, index, cpu.X_HALTED, 0)
        apic.timer_rate(state, 1)
        cpu.x_set(state, index, cpu.X_PEND, 0)
    }
}

fn park_here(state: u64, index: u64) {
    asm("cli")
    apic.core_init(state, index)
    cpu.set(state, index, cpu.C_PARKED, 1)
    atomic.barrier()
    while true {
        asm("cli")
        asm("hlt")
    }
}

fn park_all(state: u64) -> bool {
    let n: u64 = cpu.count(state)
    cpu.gs_disarm(state)
    var k: u64 = 1
    var asked: u64 = 0
    while k < n {
        cpu.set(state, k, cpu.C_PARKED, 0)
        if cpu.online(state, k) {
            cpu.set(state, k, cpu.C_PARKREQ, 1)
            asked = asked + 1
        }
        k = k + 1
    }
    if asked == 0 {
        return true
    }
    atomic.barrier()
    var waited: u64 = 0
    var all: bool = false
    while waited < 3000 && !all {
        all = true
        k = 1
        while k < n {
            if cpu.get(state, k, cpu.C_PARKREQ) != 0 && cpu.get(state, k, cpu.C_PARKED) == 0 {
                all = false
            }
            k = k + 1
        }
        if !all {
            udelay(state, 1000)
            waited = waited + 1
        }
    }
    if !all {
        unpark_all(state)
        return false
    }
    k = 1
    while k < n {
        if cpu.get(state, k, cpu.C_PARKREQ) != 0 {
            cpu.set_online(state, k, 0)
        }
        k = k + 1
    }
    return true
}

fn unpark_all(state: u64) -> u64 {
    let n: u64 = cpu.count(state)
    cpu.gs_disarm(state)
    let param: u64 = prep_blob(state)
    let base: u64 = sget(state, S_TRAMP)
    var k: u64 = 1
    while k < n {
        if cpu.get(state, k, cpu.C_PARKREQ) != 0 {
            let parked: bool = cpu.get(state, k, cpu.C_PARKED) != 0
            cpu.set(state, k, cpu.C_PARKREQ, 0)
            cpu.set(state, k, cpu.C_PARKED, 0)
            if parked {
                cpu.set(state, k, cpu.C_RESUMED, 1)
                cpu.set_online(state, k, 0)
                bring(state, k, param, base)
            }
        }
        k = k + 1
    }
    arm_gs_index(state)
    return cpu.online_count(state)
}

fn locks(state: u64) {
    var s_head: [u8; 12] = "smp: locks \0"
    var s_n: [u8; 3] = " l\0"
    var s_eq: [u8; 2] = "=\0"
    var s_sl: [u8; 2] = "/\0"
    var s_off: [u8; 8] = "  off=\0\0"
    serial.puts((&s_head[0]) as u64)
    var i: u64 = 0
    while i < kstate.LOCK_COUNT {
        if atomic.lock_takes(state, i) > 0 {
            serial.puts((&s_n[0]) as u64)
            serial.dec(i)
            serial.puts((&s_eq[0]) as u64)
            serial.dec(atomic.lock_takes(state, i))
            serial.puts((&s_sl[0]) as u64)
            serial.dec(atomic.lock_spins(state, i))
        }
        i = i + 1
    }
    serial.puts((&s_off[0]) as u64)
    serial.dec(atomic.mask(state))
    serial.nl()
}

fn mode_of(cmd: u64) -> u64 {
    var w_nosmp: [u8; 6] = "nosmp\0"
    var w_nolock: [u8; 7] = "nolock\0"
    var w_long: [u8; 8] = "smplong\0"
    var w_all: [u8; 10] = "nolockall\0"
    var w_race: [u8; 8] = "fsrace\0\0"
    var w_blind: [u8; 9] = "fsblind\0\0"
    var w_lograce: [u8; 8] = "lograce\0"
    if cmd == 0 {
        return 0
    }
    var m: u64 = 0
    if find(cmd, (&w_nosmp[0]) as u64, 5) != 0 {
        m = m | M_NOSMP
    }
    if find(cmd, (&w_nolock[0]) as u64, 6) != 0 {
        m = m | M_NOLOCK
    }
    if find(cmd, (&w_long[0]) as u64, 7) != 0 {
        m = m | M_SMPLONG
    }
    if find(cmd, (&w_all[0]) as u64, 9) != 0 {
        m = m | M_NOLOCKALL
    }
    if find(cmd, (&w_race[0]) as u64, 6) != 0 {
        m = m | M_FSRACE
    }
    if find(cmd, (&w_blind[0]) as u64, 7) != 0 {
        m = m | M_FSRACE | M_FSBLIND
    }
    if find(cmd, (&w_lograce[0]) as u64, 7) != 0 {
        m = m | M_LOGRACE
    }
    return m
}

fn parse(state: u64, cmd: u64) {
    sset(state, S_MODE, mode_of(cmd))
}

fn find(hay: u64, needle: u64, n: u64) -> u64 {
    var i: u64 = 0
    while kstate.get8(hay + i) != 0 {
        var k: u64 = 0
        var hit: bool = true
        while k < n {
            if kstate.get8(hay + i + k) != kstate.get8(needle + k) {
                hit = false
                k = n
            } else {
                k = k + 1
            }
        }
        if hit {
            return hay + i
        }
        i = i + 1
    }
    return 0
}
