import lib.kstate

export { read64, chain }

const V_READ_SAFE: u64 = 76

fn read64(state: u64, addr: u64, out: u64) -> bool {
    let fnp: u64 = __mmio_read64((kstate.get(state, kstate.VECTORS) + V_READ_SAFE * 8) as *mut u64)
    if fnp == 0 {
        return false
    }
    var rc: u64 = 1
    asm("call rax", in("rax") fnp, in("rdi") addr, in("rsi") out,
        out("rax") & rc, clobber("memory"))
    return rc == 0
}

fn chain(state: u64, rsp: u64, rbp: u64, span: u64, lo: u64, hi: u64, out: u64, max: u64) -> u64 {
    var fp: u64 = rbp
    var n: u64 = 0
    while n < max {
        if fp < rsp || fp >= rsp + span || fp % 8 != 0 {
            return n
        }
        var ret: u64 = 0
        if !read64(state, fp + 8, (&ret) as u64) || ret < lo || ret >= hi {
            return n
        }
        __mmio_write64((out + n * 8) as *mut u64, ret)
        n = n + 1
        var next: u64 = 0
        if !read64(state, fp, (&next) as u64) || next <= fp {
            return n
        }
        fp = next
    }
    return n
}
