// SPDX-License-Identifier: GPL-2.0-only
// kernel/arch/aarch64/virt.fi -- the addresses of `qemu-system-aarch64 -M virt`.
//
// The Firn twin of `virt.inc`, which the three remaining assembly files use.
// Two copies of the same eleven numbers is one copy too many, and
// `tools/arm/run.sh` says so in the only way that helps: it reads the
// addresses out of the device tree QEMU dumps and holds BOTH files against
// them. A number that drifts fails there, not somewhere in the dark.
//
// Where the numbers come from -- not a manual, not a guess:
//
//     qemu-system-aarch64 -machine virt,dumpdtb=virt.dtb -cpu cortex-a53
//     ./tools/arm/dtb.py virt.dtb --facts
//
//   /memory@40000000     reg   0x40000000  0x08000000     RAM, 128 MiB
//   /pl011@9000000       reg   0x09000000  0x1000         the serial console
//                        interrupts  0 1 4                SPI 1 -> INTID 33
//   /intc@8000000        reg   0x08000000  0x10000        GICv2 distributor
//                              0x08010000  0x10000        GICv2 CPU interface
//   /virtio_mmio@a000000 reg   0x0a000000  0x200          32 slots, 0x200 apart
//   /timer               interrupts  1 11 260             PPI 11 -> INTID 27
//
// WHY THE VIRTUAL TIMER. The physical timer of the architecture is reachable
// from EL1 only if EL2 lets it through (CNTHCTL_EL2.EL1PCEN). On a machine
// without EL2 that is moot, on one with EL2 it is a trap waiting to happen.
// CNTV_* is readable and writable at EL1 either way, and with CNTVOFF_EL2 = 0
// it counts the same ticks.
//
// AND THERE ARE NO PORTS HERE. Every number below is an ADDRESS. Every access
// to one has to be ordered by hand and needs a device attribute in its page
// descriptor -- see `arch.barrier_device` and docs/ARCH.md section 7.

profile kernel

export {
    RAM_BASE, RAM_SIZE, LOAD_ADDR,
    UART0, UART_DR, UART_FR, UART_IBRD, UART_FBRD, UART_LCRH,
    UART_CR, UART_IMSC, UART_ICR, UART_INTID,
    GICD, GICD_CTLR, GICD_TYPER, GICD_ISENABLER, GICD_ICENABLER,
    GICD_IPRIORITY, GICD_ITARGETSR,
    GICC, GICC_CTLR, GICC_PMR, GICC_IAR, GICC_EOIR,
    TIMER_INTID,
    VIRTIO_MMIO, VIRTIO_STRIDE, VIRTIO_SLOTS, VIRTIO_INTID0, VIRTIO_MAGIC,
    PSCI_SYSTEM_OFF
}

// --- memory
const RAM_BASE: u64 = 0x40000000
const RAM_SIZE: u64 = 0x08000000
const LOAD_ADDR: u64 = 0x40080000

// --- PL011, the serial console
const UART0: u64 = 0x09000000
const UART_DR: u64 = 0x000
const UART_FR: u64 = 0x018         // bit 5 = transmit FIFO full
const UART_IBRD: u64 = 0x024
const UART_FBRD: u64 = 0x028
const UART_LCRH: u64 = 0x02C
const UART_CR: u64 = 0x030
const UART_IMSC: u64 = 0x038
const UART_ICR: u64 = 0x044
const UART_INTID: u64 = 33         // SPI 1

// --- GICv2
const GICD: u64 = 0x08000000
const GICD_CTLR: u64 = 0x000
const GICD_TYPER: u64 = 0x004
const GICD_ISENABLER: u64 = 0x100
const GICD_ICENABLER: u64 = 0x180
const GICD_IPRIORITY: u64 = 0x400
const GICD_ITARGETSR: u64 = 0x800

const GICC: u64 = 0x08010000
const GICC_CTLR: u64 = 0x000
const GICC_PMR: u64 = 0x004
const GICC_IAR: u64 = 0x00C
const GICC_EOIR: u64 = 0x010

// --- the generic timer
const TIMER_INTID: u64 = 27        // PPI 11, the virtual timer

// --- virtio over MMIO, not over PCI as on the PC
const VIRTIO_MMIO: u64 = 0x0a000000
const VIRTIO_STRIDE: u64 = 0x200
const VIRTIO_SLOTS: u64 = 32
const VIRTIO_INTID0: u64 = 48      // SPI 16
const VIRTIO_MAGIC: u64 = 0x74726976   // "virt"

// --- how this machine is switched off
const PSCI_SYSTEM_OFF: u64 = 0x84000008
