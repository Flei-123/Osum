
import lib.kstate

export { rd, wr, rd0, catch_rip }

const V_FIXUPS: u64 = 70
const V_READ: u64 = 71
const V_WRITE: u64 = 72

fn vector(state: u64, i: u64) -> u64 {
    return __mmio_read64((kstate.get(state, kstate.VECTORS) + i * 8) as *mut u64)
}

fn rd(state: u64, index: u64, out: u64) -> bool {
    var rc: u64 = 1
    asm("call rax", in("rax") vector(state, V_READ), in("rdi") index,
        in("rsi") out, out("rax") & rc, clobber("memory"))
    return rc == 0
}

fn wr(state: u64, index: u64, value: u64) -> bool {
    var rc: u64 = 1
    asm("call rax", in("rax") vector(state, V_WRITE), in("rdi") index,
        in("rsi") value, out("rax") & rc, clobber("memory"))
    return rc == 0
}

fn rd0(state: u64, index: u64) -> u64 {
    var v: u64 = 0
    if !rd(state, index, (&v) as u64) {
        return 0
    }
    return v
}

fn catch_rip(state: u64, rip: u64) -> u64 {
    let tbl: u64 = vector(state, V_FIXUPS)
    if tbl == 0 {
        return 0
    }
    var i: u64 = 0
    while i < 32 {
        let at: u64 = __mmio_read64((tbl + i * 16) as *mut u64)
        if at == 0 {
            return 0
        }
        if at == rip {
            return __mmio_read64((tbl + i * 16 + 8) as *mut u64)
        }
        i = i + 1
    }
    return 0
}
