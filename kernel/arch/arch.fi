
profile kernel

import machine
import libc.regio

export {
    dev_out8, dev_out16, dev_out32, dev_in8, dev_in16, dev_in32, dev_io_wait,
    dev_read8, dev_read16, dev_read32, 
    dev_write8, dev_write16, dev_write32, 
    atomic_load, atomic_store,
    barrier, barrier_read, barrier_write, barrier_device,
    cache_writeback, cache_flush_line, cache_flush_line_opt,
    irq_on, irq_off, irq_save, irq_restore, irq_are_on, idle, pause,
    fill_words, copy_words, copy_octets, kdata_base,
    page_root, page_root_set, tlb_flush_all, tlb_flush_page,
    cycles, page_size, has_io_ports
}

fn dev_out8(port: u16, value: u8) {
    machine.out8(port, value)
}

fn dev_out16(port: u16, value: u16) {
    machine.out16(port, value)
}

fn dev_out32(port: u16, value: u32) {
    machine.out32(port, value)
}

fn dev_in8(port: u16) -> u8 {
    return machine.in8(port)
}

fn dev_in16(port: u16) -> u16 {
    return machine.in16(port)
}

fn dev_in32(port: u16) -> u32 {
    return machine.in32(port)
}

fn dev_io_wait() {
    machine.io_wait()
}

fn dev_read8(addr: u64) -> u8 {
    return machine.read8(addr)
}

fn dev_read16(addr: u64) -> u16 {
    return machine.read16(addr)
}

fn dev_read32(addr: u64) -> u32 {
    return machine.read32(addr)
}

fn dev_write8(addr: u64, v: u8) {
    machine.write8(addr, v)
}

fn dev_write16(addr: u64, v: u16) {
    machine.write16(addr, v)
}

fn dev_write32(addr: u64, v: u32) {
    machine.write32(addr, v)
}

fn atomic_load(addr: u64) -> u64 {
    return machine.atomic_load(addr)
}

fn atomic_store(addr: u64, v: u64) {
    machine.atomic_store(addr, v)
}

fn barrier() {
    machine.barrier()
}

fn barrier_read() {
    machine.barrier_read()
}

fn barrier_write() {
    machine.barrier_write()
}

fn barrier_device() {
    machine.barrier_device()
}

fn cache_writeback() {
    machine.cache_writeback()
}

fn cache_flush_line(addr: u64) {
    machine.cache_flush_line(addr)
}

fn cache_flush_line_opt(addr: u64) {
    machine.cache_flush_line_opt(addr)
}

fn irq_on() {
    machine.irq_on()
}

fn irq_off() {
    machine.irq_off()
}

fn irq_save() -> u64 {
    return machine.irq_save()
}

fn irq_restore(state: u64) {
    machine.irq_restore(state)
}

fn irq_are_on() -> bool {
    return machine.irq_are_on()
}

fn idle() {
    machine.idle()
}

fn fill_words(p: u64, value: u64, words: u64) {
    machine.fill_words(p, value, words)
}

fn copy_words(dst: u64, src: u64, words: u64) {
    machine.copy_words(dst, src, words)
}

fn copy_octets(dst: u64, src: u64, n: u64) {
    machine.copy_octets(dst, src, n)
}

fn kdata_base() -> u64 {
    return machine.kdata_base()
}

fn pause() {
    machine.pause()
}

fn page_root() -> u64 {
    return machine.page_root()
}

fn page_root_set(root: u64) {
    machine.page_root_set(root)
}

fn tlb_flush_all() {
    machine.tlb_flush_all()
}

fn tlb_flush_page(addr: u64) {
    machine.tlb_flush_page(addr)
}

fn cycles() -> u64 {
    return machine.cycles()
}

fn page_size() -> u64 {
    return machine.PAGE_SIZE
}

fn has_io_ports() -> bool {
    return machine.has_io_ports()
}
