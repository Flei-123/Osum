import libc.regio


profile kernel

export {
    out8, out16, out32, in8, in16, in32, io_wait, has_io_ports,
    read8, read16, read32, 
    write8, write16, write32, 
    atomic_load, atomic_store,
    barrier, barrier_read, barrier_write, barrier_device,
    cache_writeback, cache_flush_line, cache_flush_line_opt,
    irq_on, irq_off, irq_save, irq_restore, irq_are_on, idle, pause,
    fill_words, copy_words, copy_octets, kdata_base,
    page_root, page_root_set, tlb_flush_all, tlb_flush_page,
    cycles, trap_here,
    PAGE_SIZE, PAGE_BITS
}

const PAGE_SIZE: u64 = 4096
const PAGE_BITS: u64 = 12

#[arch(x86_64)]
fn has_io_ports() -> bool {
    return true
}

#[arch(aarch64)]
fn has_io_ports() -> bool {
    return false
}

#[arch(x86_64)]
fn out8(port: u16, value: u8) {
    asm("out dx, al", in("dx") port, in("al") value)
}

#[arch(aarch64)]
fn out8(port: u16, value: u8) {
    trap_here()
}

#[arch(x86_64)]
fn out16(port: u16, value: u16) {
    asm("out dx, ax", in("dx") port, in("ax") value)
}

#[arch(aarch64)]
fn out16(port: u16, value: u16) {
    trap_here()
}

#[arch(x86_64)]
fn out32(port: u16, value: u32) {
    asm("out dx, eax", in("dx") port, in("eax") value)
}

#[arch(aarch64)]
fn out32(port: u16, value: u32) {
    trap_here()
}

#[arch(x86_64)]
fn in8(port: u16) -> u8 {
    return asm("in al, dx\nmovzx eax, al", out("rax"), in("dx") port) as u8
}

#[arch(aarch64)]
fn in8(port: u16) -> u8 {
    trap_here()
    return 0 as u8
}

#[arch(x86_64)]
fn in16(port: u16) -> u16 {
    return asm("in ax, dx\nmovzx eax, ax", out("rax"), in("dx") port) as u16
}

#[arch(aarch64)]
fn in16(port: u16) -> u16 {
    trap_here()
    return 0 as u16
}

#[arch(x86_64)]
fn in32(port: u16) -> u32 {
    return asm("in eax, dx", out("rax"), in("dx") port) as u32
}

#[arch(aarch64)]
fn in32(port: u16) -> u32 {
    trap_here()
    return 0 as u32
}

#[arch(x86_64)]
fn io_wait() {
    out8(0x80 as u16, 0 as u8)
}

#[arch(aarch64)]
fn io_wait() {
}

#[arch(x86_64)]
fn trap_here() {
    asm("ud2")
}

#[arch(aarch64)]
fn trap_here() {
    asm("brk #1")
}

fn read8(addr: u64) -> u8 {
    return __mmio_read8(addr as *mut u8)
}

fn read16(addr: u64) -> u16 {
    return __mmio_read16(addr as *mut u16)
}

fn read32(addr: u64) -> u32 {
    return __mmio_read32(addr as *mut u32)
}

fn write8(addr: u64, v: u8) {
    __mmio_write8(addr as *mut u8, v)
}

fn write16(addr: u64, v: u16) {
    __mmio_write16(addr as *mut u16, v)
}

fn write32(addr: u64, v: u32) {
    __mmio_write32(addr as *mut u32, v)
}

#[arch(x86_64)]
fn atomic_load(addr: u64) -> u64 {
    return __mmio_read64(addr as *mut u64)
}

#[arch(aarch64)]
fn atomic_load(addr: u64) -> u64 {
    return asm("ldar x0, [x1]", out("x0"), in("x1") addr)
}

#[arch(x86_64)]
fn atomic_store(addr: u64, v: u64) {
    __mmio_write64(addr as *mut u64, v)
}

#[arch(aarch64)]
fn atomic_store(addr: u64, v: u64) {
    asm("stlr x1, [x0]", in("x0") addr, in("x1") v)
}

#[arch(x86_64)]
fn barrier() {
    asm("mfence")
}

#[arch(aarch64)]
fn barrier() {
    asm("dmb sy")
}

#[arch(x86_64)]
fn barrier_read() {
    asm("lfence")
}

#[arch(aarch64)]
fn barrier_read() {
    asm("dmb ishld")
}

#[arch(x86_64)]
fn barrier_write() {
    asm("sfence")
}

#[arch(aarch64)]
fn barrier_write() {
    asm("dmb ishst")
}

#[arch(x86_64)]
fn cache_writeback() {
    asm("wbinvd")
}

#[arch(aarch64)]
fn cache_writeback() {
    asm("dsb sy")
}

#[arch(x86_64)]
fn cache_flush_line(addr: u64) {
    asm("clflush [rax]", in("rax") addr)
}

#[arch(aarch64)]
fn cache_flush_line(addr: u64) {
    asm("dc civac, x0", in("x0") addr)
}

#[arch(x86_64)]
fn cache_flush_line_opt(addr: u64) {
    asm("clflushopt [rax]", in("rax") addr)
}

#[arch(aarch64)]
fn cache_flush_line_opt(addr: u64) {
    asm("dc civac, x0", in("x0") addr)
}

#[arch(x86_64)]
fn barrier_device() {
    asm("sfence")
}

#[arch(aarch64)]
fn barrier_device() {
    asm("dsb sy")
}

#[arch(x86_64)]
fn irq_on() {
    asm("sti")
}

#[arch(aarch64)]
fn irq_on() {
    asm("msr daifclr, #2")
}

#[arch(x86_64)]
fn irq_off() {
    asm("cli")
}

#[arch(aarch64)]
fn irq_off() {
    asm("msr daifset, #2")
}

#[arch(x86_64)]
fn irq_save() -> u64 {
    return asm("pushfq\npop rax\ncli", out("rax"))
}

#[arch(aarch64)]
fn irq_save() -> u64 {
    return asm("mrs x0, daif\nmsr daifset, #2", out("x0"))
}

#[arch(x86_64)]
fn irq_restore(state: u64) {
    if (state & 0x200) != 0 {
        asm("sti")
    }
}

#[arch(aarch64)]
fn irq_restore(state: u64) {
    asm("msr daif, x0", in("x0") state)
}

#[arch(x86_64)]
fn irq_are_on() -> bool {
    let flags: u64 = asm("pushfq\npop rax", out("rax"))
    return (flags & 0x200) != 0
}

#[arch(aarch64)]
fn irq_are_on() -> bool {
    let daif: u64 = asm("mrs x0, daif", out("x0"))
    return ((daif >> 7) & 1) == 0
}

#[arch(x86_64)]
fn idle() {
    asm("hlt")
}

#[arch(aarch64)]
fn idle() {
    asm("wfi")
}

#[arch(x86_64)]
fn pause() {
    asm("pause")
}

#[arch(aarch64)]
fn pause() {
    asm("yield")
}

#[arch(x86_64)]
fn fill_words(p: u64, value: u64, words: u64) {
    asm("cld\nrep stosq", in("rdi") p, in("rax") value, in("rcx") words,
        clobber("rdi"), clobber("rcx"), clobber("memory"))
}

#[arch(aarch64)]
fn fill_words(p: u64, value: u64, words: u64) {
    var i: u64 = 0
    while i < words {
        __mmio_write64((p + i * 8) as *mut u64, value)
        i = i + 1
    }
}

#[arch(x86_64)]
fn copy_words(dst: u64, src: u64, words: u64) {
    asm("cld\nrep movsq", in("rdi") dst, in("rsi") src, in("rcx") words,
        clobber("rdi"), clobber("rsi"), clobber("rcx"), clobber("memory"))
}

#[arch(aarch64)]
fn copy_words(dst: u64, src: u64, words: u64) {
    var i: u64 = 0
    while i < words {
        __mmio_write64((dst + i * 8) as *mut u64,
            __mmio_read64((src + i * 8) as *mut u64))
        i = i + 1
    }
}

#[arch(x86_64)]
fn copy_octets(dst: u64, src: u64, n: u64) {
    asm("cld\nrep movsb", in("rdi") dst, in("rsi") src, in("rcx") n,
        clobber("rdi"), clobber("rsi"), clobber("rcx"), clobber("memory"))
}

#[arch(aarch64)]
fn copy_octets(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        __mmio_write8((dst + i) as *mut u8, __mmio_read8((src + i) as *mut u8))
        i = i + 1
    }
}

#[arch(x86_64)]
fn kdata_base() -> u64 {
    return asm("lea rax, [rip + kdata]", out("rax"))
}

#[arch(aarch64)]
fn kdata_base() -> u64 {
    return asm("adrp x0, kdata\nadd x0, x0, :lo12:kdata", out("x0"))
}

#[arch(x86_64)]
fn page_root() -> u64 {
    return asm("mov rax, cr3", out("rax"))
}

#[arch(aarch64)]
fn page_root() -> u64 {
    return asm("mrs x0, ttbr0_el1", out("x0"))
}

#[arch(x86_64)]
fn page_root_set(root: u64) {
    asm("mov cr3, rdi", in("rdi") root)
}

#[arch(aarch64)]
fn page_root_set(root: u64) {
    asm("msr ttbr0_el1, x0\ndsb ish\nisb", in("x0") root)
}

#[arch(x86_64)]
fn tlb_flush_all() {
    asm("mov rax, cr3\nmov cr3, rax", out("rax"))
}

#[arch(aarch64)]
fn tlb_flush_all() {
    asm("dsb ishst\ntlbi vmalle1\ndsb ish\nisb")
}

#[arch(x86_64)]
fn tlb_flush_page(addr: u64) {
    asm("invlpg [rdi]", in("rdi") addr)
}

#[arch(aarch64)]
fn tlb_flush_page(addr: u64) {
    asm("dsb ishst\ntlbi vaae1is, x0\ndsb ish\nisb", in("x0") addr >> 12)
}

#[arch(x86_64)]
fn cycles() -> u64 {
    return asm("rdtsc\nshl rdx, 32\nor rax, rdx", out("rax"))
}

#[arch(aarch64)]
fn cycles() -> u64 {
    return asm("isb\nmrs x0, cntvct_el0", out("x0"))
}
