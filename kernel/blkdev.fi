// SPDX-License-Identifier: GPL-2.0-only
// kernel/blkdev.fi -- Runde BLECH: WELCHE PLATTE, ENTSCHIEDEN VOM BUS.
//
// Der Eigner hat es in einem Satz gesagt, und der Satz ist die ganze
// Begruendung dieser Datei:
//
//     "Die Struktur ist bei Netz schon richtig -- bei Speicher NICHT.
//      Halte beide gleich."
//
// Nachgelesen, nicht geglaubt. `kernel/netdev.fi` hat:
//
//   * EINE TABELLE (`driver_for`), in der steht, welcher Chip welchen
//     Treiber bekommt -- eine Zeile je Karte, an EINER Stelle;
//   * je Chip eine eigene Datei mit EINHEITLICHEN Namen (`init_on`,
//     `tx_frame_on`, `rx_take_on`, `link_up_on`);
//   * einen `probe`, der den Bus abgeht und selbst entscheidet;
//   * und eine Meldung MIT NUMMERN fuer jede Karte, die keinen Treiber
//     bekommt -- samt Grund, wenn der Kern den Chip immerhin kennt.
//
// `kernel/blk.fi` hat davon nichts. Dort stehen `use_ata`, `use_nvme`,
// `use_ahci` NEBENEINANDER, und der Aufrufer muss wissen, welche Art
// Platte er vor sich hat. Genau deshalb stand in `docs/RUNDE-MERGE3.md`
// der Satz "die automatische Treiberwahl beim Start ist nicht gebaut":
// es gab niemanden, der sie haette treffen koennen.
//
// ------------------------------------------------- WAS DIESE DATEI IST
//
// Die FEHLENDE SCHICHT, und zwar genau die, die `netdev.fi` fuer Netz
// ist -- nicht mehr:
//
//   `driver_for(cls, sub, pif)`  die Tabelle. Eine Zeile je Controller.
//   `reason_for(...)`            warum ein erkannter Controller trotzdem
//                                keinen Treiber bekommt.
//   `probe(state)`               der Lauf ueber den Bus. Fuellt die
//                                Plattenliste und die Liste der
//                                abgelehnten Controller.
//   `print_disks(state)`         was dabei herauskam, mit Nummern.
//   `print_table(state)`         die Tabelle OHNE Platte gegen eine
//                                eingebaute Nummernliste -- der einzige
//                                Weg, die Wahl fuer einen Controller zu
//                                pruefen, den dieses Verzeichnis nicht
//                                besitzt. Wort `blktab`, genau wie
//                                `nictab` bei Netz.
//   `init_on`/`present_on`/`blocks_on`/`bsize_on`/`read_on`/`write_on`/
//   `flush_on`                   der Verteiler, je Treiber dieselben
//                                Namen.
//
// ------------------------------------------- WAS DIESE DATEI NICHT IST
//
// Kein Ersatz fuer `blk.fi`. Die 813 Zeilen dort sind die BLOCKEBENE:
// 512 Oktett lesen, 512 Oktett schreiben, ein Versatz fuer die
// Partition. `fs.fi`, `vfs.fi`, `fat.fi` und `part.fi` reden mit
// dieser Ebene und aendern keine Zeile -- dieselbe Zusage, die
// `netdev.fi` gegenueber `inet.fi` gegeben hat.
//
// Die Geraetenummern sind deshalb ABSICHTLICH die von `blk.fi`
// (`DEV_NVME`, `DEV_AHCI`, `DEV_USB`, `DEV_ATA`): eine zweite
// Nummernwelt daneben waere genau die Abstraktion, die spaeter niemand
// mehr auseinandernimmt.
//
// ------------------------------------------------------- DIE ORDNUNG
//
// NVMe, dann AHCI, dann USB, dann IDE. Die Zahlen der KIND_-Konstanten
// SIND diese Ordnung -- kleiner zuerst -, damit sie an einer Stelle
// steht und nicht in einer Kette von `if`. Warum diese und keine
// andere: NVMe ist auf einem Rechner, der eines hat, immer die
// Systemplatte; AHCI ist der Normalfall seit 2010; ein USB-Stick ist
// haeufig das Installationsmedium und soll VOR der alten IDE-Platte
// kommen, weil ein Rechner mit beidem in aller Regel gerade
// installiert wird.

profile kernel

import serial
import kstate
import pci
import chipname
import blk
import nvme
import ahci
import usb

export {
    probe, kind_on, print_kind, print_disks, print_table,
    driver_for, reason_for, selftest,
    MAX_DISKS, disks, kind_at, bdf_at, dev_at, order_line,
    KIND_NONE, KIND_NVME, KIND_AHCI, KIND_USB, KIND_ATA,
    WHY_UNKNOWN, WHY_RAID, WHY_SATA_LEGACY, WHY_SD, WHY_SAS, WHY_SCSI,
    WHY_NVME_OTHER,
    unsupported_count, unsupported_vendor, unsupported_device,
    unsupported_reason,
    init_on, present_on, blocks_on, bsize_on, read_on, write_on,
    flush_on, dev_of,
    BLKDEV_OFF, BLKDEV_MAX
}

// ------------------------------------------------------ der Platz
//
// Eine Seite hinter der Wurzelwahl (0x85000), in demselben Stueck, das
// `tools/kernel/memmap.py` als frei ausweist. Eingetragen ist sie dort
// unter BLKDEV.
//
//   0x000..0x180   die gefundenen Platten, 0x30 je Eintrag -- 8
//   0x180..0x200   die Skalare
//   0x200..0x380   die abgelehnten Controller, 24 Oktett je Eintrag -- 16
const BLKDEV_OFF: u64 = 0x86000
const BLKDEV_MAX: u64 = 0x1000

const MAX_DISKS: u64 = 8
const DISK_SPAN: u64 = 0x30

const D_KIND: u64 = 0x00
const D_BDF: u64 = 0x08
const D_PCI: u64 = 0x10 // Platz in der Bustabelle von pci.fi
const D_VEN: u64 = 0x18
const D_DEV: u64 = 0x20
const D_UNIT: u64 = 0x28 // die Nummer INNERHALB des Treibers

const S_PROBED: u64 = 0x180
const S_NDISK: u64 = 0x188

const S_UNSUP_N: u64 = 0x200
const S_UNSUP: u64 = 0x208 // n * 24: Hersteller, Geraet, Grund
const MAX_UNSUP: u64 = 16

// DIE TREIBER. Die Zahlen SIND die Suchreihenfolge.
const KIND_NONE: u64 = 0
const KIND_NVME: u64 = 1 // kernel/nvme.fi
const KIND_AHCI: u64 = 2 // kernel/ahci.fi
const KIND_USB: u64 = 3 // kernel/usb.fi (Stick ueber xHCI)
const KIND_ATA: u64 = 4 // kernel/blk.fi, ATA-PIO auf 0x1F0

// WARUM ein erkannter Controller trotzdem keinen Treiber bekommt. Das
// ist dieselbe Unterscheidung, die `netdev.reason_for` fuer Netzkarten
// macht, und aus demselben Grund: "steht im RAID-Modus, stell das BIOS
// um" sagt einem Menschen vor einem Brett, was er TUN kann, waehrend
// "unbekannt" ihn zuerst an der Platte zweifeln laesst.
const WHY_UNKNOWN: u64 = 0
const WHY_RAID: u64 = 1 // 01:04 -- Intel RST / AMD RAIDXpert
const WHY_SATA_LEGACY: u64 = 2 // 01:06, Schnittstelle nicht AHCI
const WHY_SD: u64 = 3 // 08:05 -- SD/eMMC
const WHY_SAS: u64 = 4 // 01:07
const WHY_SCSI: u64 = 5 // 01:00
const WHY_NVME_OTHER: u64 = 6 // 01:08, aber nicht Schnittstelle 02

const SUB_SCSI: u64 = 0x00
const SUB_RAID: u64 = 0x04
const SUB_SAS: u64 = 0x07
const CLASS_SERIAL: u64 = 0x0C
const SUB_USBHC: u64 = 0x03
const CLASS_BASE: u64 = 0x08
const SUB_SD: u64 = 0x05

fn sd(i: u64, off: u64) -> u64 {
    return BLKDEV_OFF + i * DISK_SPAN + off
}

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, BLKDEV_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, BLKDEV_OFF + off, v)
}

// ==================================================== DIE TREIBERTABELLE
//
// EINE Stelle im ganzen Kern, an der steht, welcher Controller welchen
// Treiber bekommt. Wer eine Platte ergaenzt, schreibt hier EINE Zeile --
// er muss weder den Lauf ueber den Bus noch den Verteiler darunter
// anfassen. Dasselbe Versprechen wie `netdev.driver_for`.
//
// Entschieden wird an der PCI-KLASSE und nicht an Hersteller und
// Geraetenummer, und das ist der Unterschied zu Netz: ein NVMe-Riegel
// von Samsung und einer von WD haben verschiedene Nummern und
// DIESELBE Klasse (01:08:02), weil die Spezifikation das so verlangt.
// Ein Treiber, der Nummern sammelt, kennt genau die Riegel, die sein
// Schreiber besass.
fn driver_for(cls: u64, sub: u64, pif: u64) -> u64 {
    if cls == pci.CLASS_STORAGE {
        if sub == pci.SUB_NVM && pif == pci.PROGIF_NVME {
            return KIND_NVME
        }
        if sub == pci.SUB_SATA && pif == pci.PROGIF_AHCI {
            return KIND_AHCI
        }
        if sub == pci.SUB_IDE {
            return KIND_ATA
        }
        return KIND_NONE
    }
    if cls == CLASS_SERIAL && sub == SUB_USBHC {
        // Ein USB-Regler ist noch keine Platte -- ob ein Stick steckt,
        // weiss erst der Treiber. Er kommt trotzdem in die Liste, weil
        // die Entscheidung "gibt es hier eine Wurzel?" ohne ihn nicht
        // vollstaendig waere.
        return KIND_USB
    }
    return KIND_NONE
}

fn reason_for(cls: u64, sub: u64, pif: u64) -> u64 {
    if cls == pci.CLASS_STORAGE {
        if sub == SUB_RAID {
            return WHY_RAID
        }
        if sub == pci.SUB_SATA {
            return WHY_SATA_LEGACY
        }
        if sub == SUB_SAS {
            return WHY_SAS
        }
        if sub == SUB_SCSI {
            return WHY_SCSI
        }
        if sub == pci.SUB_NVM {
            return WHY_NVME_OTHER
        }
        return WHY_UNKNOWN
    }
    if cls == CLASS_BASE && sub == SUB_SD {
        return WHY_SD
    }
    return WHY_UNKNOWN
}

fn print_kind(k: u64) {
    var s_nv: [u8; 5] = "nvme\0"
    var s_ah: [u8; 5] = "ahci\0"
    var s_us: [u8; 4] = "usb\0"
    var s_id: [u8; 4] = "ide\0"
    var s_no: [u8; 5] = "none\0"
    if k == KIND_NVME {
        serial.puts((&s_nv[0]) as u64)
        return
    }
    if k == KIND_AHCI {
        serial.puts((&s_ah[0]) as u64)
        return
    }
    if k == KIND_USB {
        serial.puts((&s_us[0]) as u64)
        return
    }
    if k == KIND_ATA {
        serial.puts((&s_id[0]) as u64)
        return
    }
    serial.puts((&s_no[0]) as u64)
}

fn print_reason(why: u64) {
    var s_raid: [u8; 51] = "RAID-Modus -- im BIOS \"SATA Mode\" auf AHCI stellen\0"
    var s_leg: [u8; 22] = "SATA, aber nicht AHCI\0"
    var s_sd: [u8; 29] = "SD/eMMC-Regler, kein Treiber\0"
    var s_sas: [u8; 18] = "SAS, kein Treiber\0"
    var s_scsi: [u8; 19] = "SCSI, kein Treiber\0"
    var s_nvo: [u8; 42] = "NVM-Klasse, aber nicht NVMe-Schnittstelle\0"
    if why == WHY_RAID {
        serial.puts((&s_raid[0]) as u64)
        return
    }
    if why == WHY_SATA_LEGACY {
        serial.puts((&s_leg[0]) as u64)
        return
    }
    if why == WHY_SD {
        serial.puts((&s_sd[0]) as u64)
        return
    }
    if why == WHY_SAS {
        serial.puts((&s_sas[0]) as u64)
        return
    }
    if why == WHY_SCSI {
        serial.puts((&s_scsi[0]) as u64)
        return
    }
    if why == WHY_NVME_OTHER {
        serial.puts((&s_nvo[0]) as u64)
    }
}

// ------------------------------------------------------------ probe
//
// Der Lauf ueber den Bus. Er SCHREIBT KEIN REGISTER und zieht kein
// Geraet hoch -- `print_disks` darf deshalb vor jeder Stufe laufen, die
// etwas anfasst, genau wie `netdev.print_cards`.
//
// DIE LISTE WIRD SORTIERT GEHALTEN, beim Einfuegen: acht Eintraege, ein
// Einfuegesortieren, und danach steht die Reihenfolge im Speicher und
// nicht im Kopf dessen, der sie liest.
fn add_disk(state: u64, kind: u64, bdf: u64, i: u64, ven: u64, dev: u64,
    unit: u64) {
    let n: u64 = g(state, S_NDISK)
    if n >= MAX_DISKS {
        s(state, S_NDISK, n + 1)
        return
    }
    var k: u64 = n
    while k > 0 {
        if kstate.get(state, sd(k - 1, D_KIND)) <= kind {
            break
        }
        kstate.set(state, sd(k, D_KIND), kstate.get(state, sd(k - 1, D_KIND)))
        kstate.set(state, sd(k, D_BDF), kstate.get(state, sd(k - 1, D_BDF)))
        kstate.set(state, sd(k, D_PCI), kstate.get(state, sd(k - 1, D_PCI)))
        kstate.set(state, sd(k, D_VEN), kstate.get(state, sd(k - 1, D_VEN)))
        kstate.set(state, sd(k, D_DEV), kstate.get(state, sd(k - 1, D_DEV)))
        kstate.set(state, sd(k, D_UNIT), kstate.get(state, sd(k - 1, D_UNIT)))
        k = k - 1
    }
    kstate.set(state, sd(k, D_KIND), kind)
    kstate.set(state, sd(k, D_BDF), bdf)
    kstate.set(state, sd(k, D_PCI), i)
    kstate.set(state, sd(k, D_VEN), ven)
    kstate.set(state, sd(k, D_DEV), dev)
    kstate.set(state, sd(k, D_UNIT), unit)
    s(state, S_NDISK, n + 1)
}

fn note_unsupported(state: u64, ven: u64, dev: u64, why: u64) {
    let n: u64 = g(state, S_UNSUP_N)
    if n >= MAX_UNSUP {
        s(state, S_UNSUP_N, n + 1)
        return
    }
    s(state, S_UNSUP + n * 24, ven)
    s(state, S_UNSUP + n * 24 + 8, dev)
    s(state, S_UNSUP + n * 24 + 16, why)
    s(state, S_UNSUP_N, n + 1)
}

fn probe(state: u64) {
    if g(state, S_PROBED) != 0 {
        return
    }
    s(state, S_PROBED, 1)
    s(state, S_NDISK, 0)
    s(state, S_UNSUP_N, 0)
    let n: u64 = pci.count(state)
    var i: u64 = 0
    var n_nvme: u64 = 0
    var n_ahci: u64 = 0
    var n_usb: u64 = 0
    var n_ata: u64 = 0
    while i < n {
        let cls: u64 = pci.get(state, i, pci.E_CLASS)
        let sub: u64 = pci.get(state, i, pci.E_SUBCLASS)
        let pif: u64 = pci.get(state, i, pci.E_PROGIF)
        let bdf: u64 = pci.get(state, i, pci.E_BDF)
        let ven: u64 = pci.get(state, i, pci.E_VENDOR)
        let dev: u64 = pci.get(state, i, pci.E_DEVICE)
        let k: u64 = driver_for(cls, sub, pif)
        if k == KIND_NONE {
            // NUR was ueberhaupt Speicher sein koennte. Eine Grafikkarte
            // ist keine abgelehnte Platte, und eine Liste, die alles
            // aufzaehlt, sagt nichts mehr.
            if cls == pci.CLASS_STORAGE {
                note_unsupported(state, ven, dev, reason_for(cls, sub, pif))
            } else if cls == CLASS_BASE && sub == SUB_SD {
                note_unsupported(state, ven, dev, WHY_SD)
            }
        } else {
            var unit: u64 = 0
            if k == KIND_NVME {
                unit = n_nvme
                n_nvme = n_nvme + 1
            } else if k == KIND_AHCI {
                unit = n_ahci
                n_ahci = n_ahci + 1
            } else if k == KIND_USB {
                unit = n_usb
                n_usb = n_usb + 1
            } else {
                unit = n_ata
                n_ata = n_ata + 1
            }
            add_disk(state, k, bdf, i, ven, dev, unit)
        }
        i = i + 1
    }
}

fn disks(state: u64) -> u64 {
    probe(state)
    let n: u64 = g(state, S_NDISK)
    if n > MAX_DISKS {
        return MAX_DISKS
    }
    return n
}

fn kind_at(state: u64, i: u64) -> u64 {
    if i >= MAX_DISKS {
        return KIND_NONE
    }
    return kstate.get(state, sd(i, D_KIND))
}

fn bdf_at(state: u64, i: u64) -> u64 {
    return kstate.get(state, sd(i, D_BDF))
}

fn kind_on(state: u64, i: u64) -> u64 {
    return kind_at(state, i)
}

fn unsupported_count(state: u64) -> u64 {
    probe(state)
    let n: u64 = g(state, S_UNSUP_N)
    if n > MAX_UNSUP {
        return MAX_UNSUP
    }
    return n
}

fn unsupported_vendor(state: u64, i: u64) -> u64 {
    return g(state, S_UNSUP + i * 24)
}

fn unsupported_device(state: u64, i: u64) -> u64 {
    return g(state, S_UNSUP + i * 24 + 8)
}

fn unsupported_reason(state: u64, i: u64) -> u64 {
    return g(state, S_UNSUP + i * 24 + 16)
}

// DIE GERAETENUMMER VON `blk.fi`. Absichtlich dieselbe Welt: eine
// zweite Nummernwelt daneben waere die Abstraktion, die spaeter niemand
// mehr auseinandernimmt.
fn dev_of(k: u64) -> u64 {
    if k == KIND_NVME {
        return blk.DEV_NVME
    }
    if k == KIND_AHCI {
        return blk.DEV_AHCI
    }
    if k == KIND_USB {
        return blk.DEV_USB
    }
    if k == KIND_ATA {
        return blk.DEV_ATA
    }
    return blk.DEV_RAM
}

fn dev_at(state: u64, i: u64) -> u64 {
    return dev_of(kind_at(state, i))
}

// ==================================================== DER VERTEILER
//
// Ab hier ist jede Funktion dieselben drei Zeilen: fragen, welcher
// Treiber die Platte hat, und ihn rufen. Nichts anderes darf hier
// leben -- eine Verteilerschicht, die anfaengt Meinungen zu haben, ist
// ein dritter Treiber. Woertlich dieselbe Regel wie in `netdev.fi`.

fn init_on(state: u64, i: u64) -> bool {
    let k: u64 = kind_at(state, i)
    if k == KIND_NVME {
        if !nvme.present(state) {
            return false
        }
        if nvme.blocks(state) == 0 {
            return nvme.init(state, true, true)
        }
        return true
    }
    if k == KIND_AHCI {
        if ahci.mode(state) == ahci.MODE_AHCI {
            return true
        }
        return ahci.init(state)
    }
    if k == KIND_USB {
        return usb.msc_ready(state)
    }
    if k == KIND_ATA {
        return blk.present(state)
    }
    return false
}

fn present_on(state: u64, i: u64) -> bool {
    let k: u64 = kind_at(state, i)
    if k == KIND_NVME {
        return nvme.present(state)
    }
    if k == KIND_AHCI {
        return ahci.present(state)
    }
    if k == KIND_USB {
        return usb.msc_ready(state)
    }
    if k == KIND_ATA {
        return blk.present(state)
    }
    return false
}

fn blocks_on(state: u64, i: u64) -> u64 {
    let k: u64 = kind_at(state, i)
    if k == KIND_NVME {
        return nvme.blocks(state)
    }
    if k == KIND_AHCI {
        return ahci.blocks(state)
    }
    if k == KIND_USB {
        return usb.msc_blocks(state)
    }
    if k == KIND_ATA {
        return blk.blocks_on(state, blk.DEV_ATA)
    }
    return 0
}

fn bsize_on(state: u64, i: u64) -> u64 {
    let k: u64 = kind_at(state, i)
    if k == KIND_NVME {
        return 1 << nvme.block_shift(state)
    }
    if k == KIND_AHCI {
        return 1 << ahci.block_shift(state)
    }
    if k == KIND_USB {
        return usb.msc_bsize(state)
    }
    return blk.BLOCK_SIZE
}

// Lesen und Schreiben gehen ueber `blk.read_on`/`write_on` und nicht
// noch einmal an den Treibern vorbei. Das ist Absicht: die Blockebene
// gibt es, sie ist gemessen, und ein zweiter Weg zu denselben Oktetten
// waere die Stelle, an der die zwei irgendwann auseinanderlaufen.
fn read_on(state: u64, i: u64, lba: u64, dst: u64) -> bool {
    return blk.read_on(state, dev_at(state, i), lba, dst)
}

fn write_on(state: u64, i: u64, lba: u64, src: u64) -> bool {
    return blk.write_on(state, dev_at(state, i), lba, src)
}

fn flush_on(state: u64, i: u64) -> bool {
    let k: u64 = kind_at(state, i)
    if k == KIND_NVME {
        return nvme.flush(state)
    }
    if k == KIND_AHCI {
        return ahci.flush(state)
    }
    // ATA-PIO und der Stick schreiben durch; es gibt nichts zu leeren,
    // und `true` heisst hier "es steht draussen" und nicht "ich habe es
    // ignoriert".
    return true
}

// ---------------------------------------------------------- Ausgabe

fn tag() {
    var s0: [u8; 10] = "blkdev: \0\0"
    serial.puts((&s0[0]) as u64)
}

fn nums(ven: u64, dev: u64) {
    pci.hexn(ven, 4)
    serial.put(58 as u8)
    pci.hexn(dev, 4)
}

// Die Reihenfolge als EINE Zeile, damit ein Foto der seriellen Ausgabe
// reicht. Dasselbe, was `rootsel` frueher selbst gedruckt hat -- jetzt
// steht es dort, wo die Entscheidung faellt.
fn order_line(state: u64) {
    var s_h: [u8; 14] = "reihenfolge: \0"
    var s_ar: [u8; 4] = " > \0"
    var s_no: [u8; 44] = "reihenfolge: LEER -- kein Plattencontroller\0"
    probe(state)
    let n: u64 = disks(state)
    tag()
    if n == 0 {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_h[0]) as u64)
    var i: u64 = 0
    while i < n {
        if i > 0 {
            serial.puts((&s_ar[0]) as u64)
        }
        print_kind(kind_at(state, i))
        i = i + 1
    }
    serial.nl()
}

fn print_disks(state: u64) {
    var s_d: [u8; 2] = "d\0"
    var s_eq: [u8; 2] = "=\0"
    var s_at: [u8; 6] = " bdf=\0"
    var s_sp: [u8; 2] = " \0"
    var s_no: [u8; 19] = "kein Treiber fuer \0"
    var s_c: [u8; 6] = "  -- \0"
    var s_over: [u8; 38] = "mehr Geraete als Plaetze in der Liste\0"
    probe(state)
    order_line(state)
    let n: u64 = disks(state)
    var i: u64 = 0
    while i < n {
        tag()
        serial.puts((&s_d[0]) as u64)
        serial.dec(i)
        serial.puts((&s_eq[0]) as u64)
        print_kind(kind_at(state, i))
        serial.puts((&s_at[0]) as u64)
        serial.hex(bdf_at(state, i))
        serial.puts((&s_sp[0]) as u64)
        // Wie bei Netz: erst der Name, dann die Nummern als Beweis.
        let dv: u64 = kstate.get(state, sd(i, D_VEN))
        let dd: u64 = kstate.get(state, sd(i, D_DEV))
        if chipname.storage(dv, dd) {
            serial.put(32 as u8)
        }
        serial.put(40 as u8)
        nums(dv, dd)
        serial.put(41 as u8)
        serial.nl()
        i = i + 1
    }
    // UND JEDER CONTROLLER OHNE TREIBER, MIT SEINEN NUMMERN. Das ist
    // die Regel, die ueber allem steht -- hier fuer Platten, so wie
    // `netdev.print_cards` sie fuer Karten haelt.
    let m: u64 = unsupported_count(state)
    var j: u64 = 0
    while j < m {
        tag()
        serial.puts((&s_no[0]) as u64)
        let uv: u64 = unsupported_vendor(state, j)
        let ud: u64 = unsupported_device(state, j)
        if chipname.storage(uv, ud) {
            serial.put(32 as u8)
        }
        serial.put(40 as u8)
        nums(uv, ud)
        serial.put(41 as u8)
        let why: u64 = unsupported_reason(state, j)
        if why != WHY_UNKNOWN {
            serial.puts((&s_c[0]) as u64)
            print_reason(why)
        }
        serial.nl()
        j = j + 1
    }
    if g(state, S_NDISK) > MAX_DISKS || g(state, S_UNSUP_N) > MAX_UNSUP {
        tag()
        serial.puts((&s_over[0]) as u64)
        serial.nl()
    }
}

// ================================================= DIE TABELLE, GEPRUEFT
//
// Dieses Verzeichnis hat keinen Controller im RAID-Modus, keinen
// SD-Leser und keinen SAS-Regler. Was es aber pruefen KANN, ist die
// WAHL: fuer jede Klasse aus der Liste unten steht hinterher auf der
// seriellen Leitung, welchen Treiber sie bekaeme und warum nicht. Das
// ist der Unterschied zwischen einer Tabelle, die jemand gelesen hat,
// und einer, die jemand ausgefuehrt hat -- und es ist woertlich das,
// was `netdev.print_table` fuer Netz tut.
fn tab_line(cls: u64, sub: u64, pif: u64) {
    var s_t: [u8; 13] = "blkdev: tab \0"
    var s_c: [u8; 2] = ":\0"
    var s_a: [u8; 5] = " -> \0"
    var s_s: [u8; 3] = "  \0"
    serial.puts((&s_t[0]) as u64)
    pci.hexn(cls, 2)
    serial.puts((&s_c[0]) as u64)
    pci.hexn(sub, 2)
    serial.puts((&s_c[0]) as u64)
    pci.hexn(pif, 2)
    serial.puts((&s_a[0]) as u64)
    let k: u64 = driver_for(cls, sub, pif)
    print_kind(k)
    if k == KIND_NONE {
        let why: u64 = reason_for(cls, sub, pif)
        if why != WHY_UNKNOWN {
            serial.puts((&s_s[0]) as u64)
            print_reason(why)
        }
    }
    serial.nl()
}

fn print_table(state: u64) {
    tab_line(0x01, 0x08, 0x02) // NVMe
    tab_line(0x01, 0x06, 0x01) // SATA im AHCI-Modus
    tab_line(0x01, 0x06, 0x00) // SATA, herstellereigen
    tab_line(0x01, 0x01, 0x80) // IDE
    tab_line(0x01, 0x01, 0x8A) // IDE, andere Schnittstelle
    tab_line(0x0C, 0x03, 0x30) // xHCI
    tab_line(0x0C, 0x03, 0x20) // EHCI
    tab_line(0x01, 0x04, 0x00) // RAID -- Intel RST / AMD RAIDXpert
    tab_line(0x01, 0x07, 0x00) // SAS
    tab_line(0x01, 0x00, 0x00) // SCSI
    tab_line(0x01, 0x08, 0x00) // NVM-Klasse, aber nicht NVMe
    tab_line(0x08, 0x05, 0x01) // SD/eMMC
    tab_line(0x02, 0x00, 0x00) // eine Netzkarte: hier hat sie nichts zu suchen
}

// Was jeder gefundene Treiber ohne Gegenstelle ueber sich sagen kann:
// ist er da, wie gross ist er, welche Blockgroesse. Kein Schreibvorgang.
fn selftest(state: u64) {
    var s_h: [u8; 7] = "self d\0"
    var s_p: [u8; 6] = "  da=\0"
    var s_b: [u8; 11] = "  bloecke=\0"
    var s_z: [u8; 9] = "  bsize=\0"
    let n: u64 = disks(state)
    var i: u64 = 0
    while i < n {
        tag()
        serial.puts((&s_h[0]) as u64)
        serial.dec(i)
        serial.put(32 as u8)
        print_kind(kind_at(state, i))
        let ok: bool = init_on(state, i)
        serial.puts((&s_p[0]) as u64)
        var y: u64 = 0
        if ok {
            y = 1
        }
        serial.dec(y)
        serial.puts((&s_b[0]) as u64)
        serial.dec(blocks_on(state, i))
        serial.puts((&s_z[0]) as u64)
        serial.dec(bsize_on(state, i))
        serial.nl()
        i = i + 1
    }
}
