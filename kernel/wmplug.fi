// SPDX-License-Identifier: GPL-2.0-only
// kernel/wmplug.fi -- RUNDE WMPLUGIN: DIE BUCHHALTUNG DER ERWEITERUNGEN.
//
// WARUM ES DIESE DATEI GIBT UND WARUM SIE SO DUENN IST.
//
// Hyprland laedt Erweiterungen als `.so` IN DEN COMPOSITOR-PROZESS und
// laesst sie Funktionen umhaengen. Das ist bequem und es ist der Grund,
// warum dort ein fehlerhaftes Plugin den ganzen Schirm mitnimmt. Bei uns
// waere derselbe Weg schlimmer: unser Fensterserver liegt IM KERNEL
// (`kernel/wm.fi`, 9265 Zeilen, der Kopf sagt warum). Fremdcode dort ist
// Fremdcode in Ring 0, und /root/osum-roadmap/FREMDSOFTWARE.md Regel 4
// sagt dazu einen Satz: "Kein Fremdcode im Kern."
//
// Also laufen Plugins als GEWOEHNLICHE RING-3-PROZESSE. Diese Datei ist
// alles, was der Kern von ihnen weiss: eine Tafel mit acht Plaetzen, je
// ein Ereignisring, eine Rechtemaske, eine Frist. KEIN Code eines
// Plugins wird hier geladen, gelinkt oder angesprungen -- es gibt in
// dieser Datei keinen einzigen indirekten Sprung.
//
// DER KERN WARTET NIE. `notify` legt ein Ereignis in einen Ring und geht
// weiter; ist der Ring voll, faellt das aelteste heraus und ein Zaehler
// (P_LOST) steigt. Es gibt in diesem Modul keine Schleife, die auf einen
// Ring-3-Prozess wartet -- weder mit noch ohne Zeitschranke. Das ist der
// Unterschied zwischen "Plugin haengt" und "Schreibtisch haengt".
//
// DIE FRIST IST KEINE WARTEZEIT, SONDERN EIN KEHRBESEN. `sweep` laeuft
// im Zusammensetzpfad mit, schaut auf die acht Plaetze und wirft den
// hinaus, der seit WMP_FRIST Ticks nicht mehr abgeholt hat, obwohl etwas
// fuer ihn bereitliegt. Acht Vergleiche je Bild, keine Rekursion, keine
// Zuteilung.
//
// DIE SCHNITTSTELLE IST VERSIONIERT (WMP_ABI). Ein Plugin, das sich mit
// einer anderen Zahl anmeldet, wird abgewiesen -- nicht "irgendwie
// weitergemacht". Was die Nummern bedeuten, steht in
// docs/RUNDE-WMPLUGIN.md; die Syscall-Nummern stehen in `kernel/sys.fi`
// ab 2117, die Vermittlung in `kernel/sysgui.fi` (`plug_call`).
//
// KEINE REKURSION. Der Kernstapel ist 16 KiB und war schon einmal fast
// voll; alles hier ist eine Schleife ueber hoechstens acht Plaetze.

profile kernel

import kstate
import serial

export {
    WMP_ABI, MAX_PLUG, EV_SLOTS, EV_BYTES,
    E_WIN_OPEN, E_WIN_CLOSE, E_FOCUS, E_DESK, E_TILE, E_KEY, E_STOP,
    R_EV_WIN, R_EV_FOCUS, R_EV_DESK, R_EV_TILE, R_EV_KEY,
    R_ACT_WIN, R_ACT_FOCUS, R_ACT_KEY, R_ACT_BAR, R_ALL, R_DEFAULT,
    G_OK, G_CRASH, G_FRIST, G_RIGHTS, G_USER,
    init, ready, set_ready,
    reg, unreg, slot_of, valid, owner, name_at, abi_at, mask_at,
    rights_at, set_rights, grant, grant_lookup, grants,
    subscribe, notify, pop, pending, lost_at, grund_at,
    touch, sweep, sweep_at, set_frist, frist, last_at,
    set_key, key_at, key_owner, bar_set, bar_ptr, bar_len,
    plugs, events_in, events_out, kicks, denials, deny,
    desk_set, desk_of, desk_cur, desk_go, desk_dirty, desk_clear,
    selftest, selftest_max, failbits,
}

// ------------------------------------------------------- die Fassung
//
// EINE ZAHL, DIE STEIGT, WENN SICH DIE BEDEUTUNG AENDERT. Ein Plugin
// nennt sie beim Anmelden; stimmt sie nicht, gibt es keinen Platz.
// Nachgeben waere schlimmer als Abweisen: ein Plugin, das die Felder
// anders deutet als der Kern, schickt Unsinn an fremde Fenster.
const WMP_ABI: u64 = 1

const MAX_PLUG: u64 = 8
const PLUG_BYTES: u64 = 0xC0
const NAME_LEN: u64 = 16
const BAR_LEN: u64 = 32

// Die Ereignisringe: je Plugin 64 Plaetze zu 16 Oktetten.
const EV_SLOTS: u64 = 64
const EV_BYTES: u64 = 16
const EV_RING: u64 = 1024 // EV_SLOTS * EV_BYTES

// Die Aufteilung der Seite (kstate.WMP_OFF, 0x4000 Oktette):
//   0x0000  die Plugintafel      8 * 0xC0 = 0x600
//   0x0600  die Skalare          0x200
//   0x0800  die Gewaehrungstafel 16 * 0x20 = 0x200
//   0x0A00  die Flaechentafel    32 * 0x10 = 0x200
//   0x1000  die Ereignisringe    8 * 0x400 = 0x2000
const P_OFF: u64 = 0x0000
const S_OFF: u64 = 0x0600
const G_OFF: u64 = 0x0800
const D_OFF: u64 = 0x0A00
const R_OFF: u64 = 0x1000

// die Felder eines Platzes
const P_USED: u64 = 0x00
const P_OWNER: u64 = 0x08 // die Aufgabennummer des Ring-3-Prozesses
const P_ABI: u64 = 0x10
const P_MASK: u64 = 0x18 // abonnierte Ereignisse, Bit je Typ
const P_RIGHTS: u64 = 0x20
const P_HEAD: u64 = 0x28
const P_TAIL: u64 = 0x30
const P_LOST: u64 = 0x38
const P_LAST: u64 = 0x40 // Tick der letzten Abholung
const P_KEY: u64 = 0x48 // belegtes Kuerzel, (mods << 32) | taste, 0 = keins
const P_GRUND: u64 = 0x50 // warum abgemeldet, siehe G_*
const P_CALLS: u64 = 0x58
const P_GEN: u64 = 0x60 // steigt bei jeder Neubelegung des Platzes
const P_BARLEN: u64 = 0x68
const P_NAME: u64 = 0x70 // NAME_LEN Oktette
const P_BAR: u64 = 0x80 // BAR_LEN Oktette

// die Skalare
const S_READY: u64 = 0x00
const S_PLUGS: u64 = 0x08
const S_IN: u64 = 0x10 // Ereignisse eingelegt
const S_OUT: u64 = 0x18 // Ereignisse abgeholt
const S_KICKS: u64 = 0x20 // Abmeldungen wegen Verstoss
const S_DENY: u64 = 0x28 // abgewiesene Handlungen (Rechte)
const S_FRIST: u64 = 0x30 // Frist in Ticks
const S_GRANTS: u64 = 0x38
const S_DESK: u64 = 0x40 // die sichtbare Arbeitsflaeche
const S_DDIRTY: u64 = 0x48 // 1 = die Flaechenzuordnung hat sich geaendert
const S_FAIL: u64 = 0x50

// ein Eintrag der Gewaehrungstafel: Name (16), Maske (8), Rechte (8)
const MAX_GRANT: u64 = 16
const GR_BYTES: u64 = 0x20
const GR_NAME: u64 = 0x00
const GR_RIGHTS: u64 = 0x10
const GR_USED: u64 = 0x18

// ein Eintrag der Flaechentafel: Fenster-Id (8), Flaeche (8)
const MAX_DESK: u64 = 32
const DK_BYTES: u64 = 0x10
const DK_ID: u64 = 0x00
const DK_WS: u64 = 0x08

// die Ereignistypen. Die Maske eines Abonnements ist (1 << typ).
const E_WIN_OPEN: u64 = 1
const E_WIN_CLOSE: u64 = 2
const E_FOCUS: u64 = 3
const E_DESK: u64 = 4
const E_TILE: u64 = 5
const E_KEY: u64 = 6
const E_STOP: u64 = 7 // "du wirst abgemeldet" -- das letzte Ereignis

// die Rechte. Ereignisrechte entscheiden, WAS ein Plugin sieht;
// Handlungsrechte, WAS es tun darf. Getrennt, weil das Leistenwidget
// alles sehen darf und nichts anfassen koennen muss.
const R_EV_WIN: u64 = 0x01
const R_EV_FOCUS: u64 = 0x02
const R_EV_DESK: u64 = 0x04
const R_EV_TILE: u64 = 0x08
const R_EV_KEY: u64 = 0x10
const R_ACT_WIN: u64 = 0x100 // fremde Fenster setzen (Ort, Ebene, Flaeche)
const R_ACT_FOCUS: u64 = 0x200
const R_ACT_KEY: u64 = 0x400
const R_ACT_BAR: u64 = 0x800
const R_ALL: u64 = 0xF1F
// WAS EIN PLUGIN OHNE EINTRAG IN /etc/wmplug.conf BEKOMMT: zusehen.
// Nichts anfassen. Wer mehr will, steht in der Datei, und die Datei
// liest ein Programm in Ring 3 (/bin/wmplug), das root sein muss.
const R_DEFAULT: u64 = 0x1F

// die Gruende einer Abmeldung
const G_OK: u64 = 0 // selbst abgemeldet
const G_CRASH: u64 = 1 // Prozess ist weg
const G_FRIST: u64 = 2 // Frist ueberschritten
const G_RIGHTS: u64 = 3 // zu oft ohne Recht angeklopft
const G_USER: u64 = 4 // /bin/wmplug disable

// Die Vorgabefrist: 50 Ticks sind bei TICK_HZ=100 eine halbe Sekunde.
// Das ist grosszuegig fuer ein Plugin, das im Sekundentakt abholt, und
// hart genug, dass eine Endlosschleife binnen einer halben Sekunde
// auffliegt. `plugfrist` auf der Kommandozeile setzt sie kuerzer,
// damit der Abnahmelauf nicht wartet.
const FRIST_VORGABE: u64 = 50

// ---------------------------------------------------- die Zugriffe

fn sg(state: u64, off: u64) -> u64 {
    return kstate.get(state + kstate.WMP_OFF, S_OFF + off)
}

fn ss(state: u64, off: u64, v: u64) {
    kstate.set(state + kstate.WMP_OFF, S_OFF + off, v)
}

fn pg(state: u64, i: u64, off: u64) -> u64 {
    if i >= MAX_PLUG {
        return 0
    }
    return kstate.get(state + kstate.WMP_OFF, P_OFF + i * PLUG_BYTES + off)
}

fn ps(state: u64, i: u64, off: u64, v: u64) {
    if i >= MAX_PLUG {
        return
    }
    kstate.set(state + kstate.WMP_OFF, P_OFF + i * PLUG_BYTES + off, v)
}

// Die Adresse eines Feldes, fuer die Oktettzugriffe (Name, Leistentext).
fn pat(state: u64, i: u64, off: u64) -> u64 {
    return state + kstate.WMP_OFF + P_OFF + i * PLUG_BYTES + off
}

fn evat(state: u64, i: u64, k: u64) -> u64 {
    return state + kstate.WMP_OFF + R_OFF + i * EV_RING
        + (k % EV_SLOTS) * EV_BYTES
}

fn gat(state: u64, k: u64) -> u64 {
    return state + kstate.WMP_OFF + G_OFF + k * GR_BYTES
}

fn dat(state: u64, k: u64) -> u64 {
    return state + kstate.WMP_OFF + D_OFF + k * DK_BYTES
}

// ---------------------------------------------------- Auf und Zu

fn init(state: u64) {
    var o: u64 = 0
    while o < kstate.WMP_MAX {
        kstate.set(state + kstate.WMP_OFF, o, 0)
        o = o + 8
    }
    ss(state, S_FRIST, FRIST_VORGABE)
    ss(state, S_READY, 1)
}

fn ready(state: u64) -> bool {
    return sg(state, S_READY) != 0
}

fn set_ready(state: u64, an: bool) {
    if an {
        ss(state, S_READY, 1)
    } else {
        ss(state, S_READY, 0)
    }
}

fn valid(state: u64, i: u64) -> bool {
    if i >= MAX_PLUG {
        return false
    }
    return pg(state, i, P_USED) != 0
}

fn owner(state: u64, i: u64) -> u64 {
    return pg(state, i, P_OWNER)
}

fn name_at(state: u64, i: u64) -> u64 {
    return pat(state, i, P_NAME)
}

fn abi_at(state: u64, i: u64) -> u64 {
    return pg(state, i, P_ABI)
}

fn mask_at(state: u64, i: u64) -> u64 {
    return pg(state, i, P_MASK)
}

fn rights_at(state: u64, i: u64) -> u64 {
    return pg(state, i, P_RIGHTS)
}

fn set_rights(state: u64, i: u64, r: u64) {
    ps(state, i, P_RIGHTS, r & R_ALL)
}

fn grund_at(state: u64, i: u64) -> u64 {
    return pg(state, i, P_GRUND)
}

fn lost_at(state: u64, i: u64) -> u64 {
    return pg(state, i, P_LOST)
}

fn last_at(state: u64, i: u64) -> u64 {
    return pg(state, i, P_LAST)
}

fn plugs(state: u64) -> u64 {
    return sg(state, S_PLUGS)
}

fn events_in(state: u64) -> u64 {
    return sg(state, S_IN)
}

fn events_out(state: u64) -> u64 {
    return sg(state, S_OUT)
}

fn kicks(state: u64) -> u64 {
    return sg(state, S_KICKS)
}

fn denials(state: u64) -> u64 {
    return sg(state, S_DENY)
}

fn frist(state: u64) -> u64 {
    return sg(state, S_FRIST)
}

fn set_frist(state: u64, t: u64) {
    if t == 0 {
        return
    }
    ss(state, S_FRIST, t)
}

// Der Platz eines Prozesses, MAX_PLUG wenn er keinen hat.
fn slot_of(state: u64, me: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_PLUG {
        if pg(state, i, P_USED) != 0 && pg(state, i, P_OWNER) == me {
            return i
        }
        i = i + 1
    }
    return MAX_PLUG
}

// ANMELDEN. `name` zeigt auf NAME_LEN Oktette, die der AUFRUFER schon
// in den Kern kopiert hat -- dieses Modul folgt keinem Ring-3-Zeiger.
// Rueckgabe: der Platz, oder MAX_PLUG (kein Platz / falsche Fassung /
// schon angemeldet).
fn reg(state: u64, me: u64, abi: u64, name: u64, maske: u64) -> u64 {
    if !ready(state) {
        return MAX_PLUG
    }
    if abi != WMP_ABI {
        return MAX_PLUG
    }
    if slot_of(state, me) < MAX_PLUG {
        return MAX_PLUG
    }
    var i: u64 = 0
    while i < MAX_PLUG {
        if pg(state, i, P_USED) == 0 {
            ps(state, i, P_USED, 1)
            ps(state, i, P_OWNER, me)
            ps(state, i, P_ABI, abi)
            ps(state, i, P_HEAD, 0)
            ps(state, i, P_TAIL, 0)
            ps(state, i, P_LOST, 0)
            ps(state, i, P_CALLS, 0)
            ps(state, i, P_GRUND, G_OK)
            ps(state, i, P_KEY, 0)
            ps(state, i, P_BARLEN, 0)
            ps(state, i, P_GEN, pg(state, i, P_GEN) + 1)
            ps(state, i, P_LAST, kstate.get(state, kstate.TICKS))
            var k: u64 = 0
            while k < NAME_LEN {
                var c: u64 = 0
                if name != 0 {
                    c = kstate.get8(name + k) as u64
                }
                kstate.set8(pat(state, i, P_NAME) + k, c as u8)
                k = k + 1
            }
            kstate.set8(pat(state, i, P_NAME) + NAME_LEN - 1, 0 as u8)
            // DIE RECHTE KOMMEN AUS DER GEWAEHRUNGSTAFEL, nicht aus dem
            // Wunsch des Plugins. Steht sein Name nicht darin, sieht es
            // zu und fasst nichts an.
            let g: u64 = grant_lookup(state, pat(state, i, P_NAME))
            if g < MAX_GRANT {
                ps(state, i, P_RIGHTS,
                    kstate.get(gat(state, g), GR_RIGHTS) & R_ALL)
            } else {
                ps(state, i, P_RIGHTS, R_DEFAULT)
            }
            ps(state, i, P_MASK, maske)
            ss(state, S_PLUGS, sg(state, S_PLUGS) + 1)
            var s_r: [u8; 13] = "wmplug: reg \0"
            var s_p: [u8; 8] = " platz=\0"
            var s_c: [u8; 9] = " rechte=\0"
            serial.puts((&s_r[0]) as u64)
            serial.text(pat(state, i, P_NAME), 8)
            serial.puts((&s_p[0]) as u64)
            serial.dec(i)
            serial.puts((&s_c[0]) as u64)
            serial.hex(pg(state, i, P_RIGHTS))
            serial.nl()
            return i
        }
        i = i + 1
    }
    return MAX_PLUG
}

// ABMELDEN, mit Grund. Der Grund steht auf der Leitung, weil eine
// Abmeldung ohne Grund im Protokoll nicht von einem Absturz des
// Fensterservers zu unterscheiden waere.
fn unreg(state: u64, i: u64, grund: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    var s_u: [u8; 15] = "wmplug: unreg \0"
    var s_g: [u8; 8] = " grund=\0"
    var s_h: [u8; 8] = " holte=\0"
    var s_v: [u8; 9] = " verlor=\0"
    serial.puts((&s_u[0]) as u64)
    serial.text(pat(state, i, P_NAME), 8)
    serial.puts((&s_g[0]) as u64)
    serial.dec(grund)
    serial.puts((&s_h[0]) as u64)
    serial.dec(pg(state, i, P_CALLS))
    serial.puts((&s_v[0]) as u64)
    serial.dec(pg(state, i, P_LOST))
    serial.nl()
    ps(state, i, P_USED, 0)
    ps(state, i, P_OWNER, 0)
    ps(state, i, P_MASK, 0)
    ps(state, i, P_RIGHTS, 0)
    ps(state, i, P_KEY, 0)
    ps(state, i, P_BARLEN, 0)
    ps(state, i, P_GRUND, grund)
    if sg(state, S_PLUGS) != 0 {
        ss(state, S_PLUGS, sg(state, S_PLUGS) - 1)
    }
    if grund != G_OK && grund != G_USER {
        ss(state, S_KICKS, sg(state, S_KICKS) + 1)
    }
    return true
}

fn subscribe(state: u64, i: u64, maske: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    ps(state, i, P_MASK, maske)
    return true
}

// Eine abgewiesene Handlung zaehlen -- der Rueckgabewert allein ist kein
// Beleg, der Zaehler ist einer.
fn deny(state: u64, i: u64) {
    ss(state, S_DENY, sg(state, S_DENY) + 1)
    if valid(state, i) {
        ps(state, i, P_GRUND, G_RIGHTS)
    }
}

// --------------------------------------------- Ereignisse: rein, raus

// Welches Recht ein Ereignistyp braucht. Ohne das Recht wird er gar
// nicht erst eingelegt -- ein Plugin soll nichts sehen, was es nicht
// sehen darf, auch nicht kurz.
fn ev_right(typ: u64) -> u64 {
    if typ == E_WIN_OPEN || typ == E_WIN_CLOSE {
        return R_EV_WIN
    }
    if typ == E_FOCUS {
        return R_EV_FOCUS
    }
    if typ == E_DESK {
        return R_EV_DESK
    }
    if typ == E_TILE {
        return R_EV_TILE
    }
    if typ == E_KEY {
        return R_EV_KEY
    }
    return 0 // E_STOP geht immer durch
}

// DER EINZIGE WEG, AUF DEM EIN EREIGNIS IN EINEN RING KOMMT.
// Aufgerufen aus `wm.fi` (ev_push, create, destroy, set_focus) und aus
// `sysgui.fi`. LEGT AB UND GEHT WEITER: kein Warten, keine Zuteilung,
// keine Rekursion, hoechstens acht Durchlaeufe.
fn notify(state: u64, typ: u64, a: u64, b: u64, c: u64) {
    if !ready(state) {
        return
    }
    let recht: u64 = ev_right(typ)
    var i: u64 = 0
    while i < MAX_PLUG {
        if pg(state, i, P_USED) != 0
            && (pg(state, i, P_MASK) & (1 << typ)) != 0
            && (recht == 0 || (pg(state, i, P_RIGHTS) & recht) != 0) {
            push_one(state, i, typ, a, b, c)
        }
        i = i + 1
    }
}

// Ein Ereignis an EINEN Platz. Der Ring ist ein Ring: laeuft er ueber,
// faellt das AELTESTE heraus und P_LOST steigt. Der Kern verliert
// dadurch nichts -- das Plugin verliert etwas, und es kann nachsehen.
fn push_one(state: u64, i: u64, typ: u64, a: u64, b: u64, c: u64) {
    let kopf: u64 = pg(state, i, P_HEAD)
    var schwanz: u64 = pg(state, i, P_TAIL)
    if kopf - schwanz >= EV_SLOTS {
        schwanz = schwanz + 1
        ps(state, i, P_TAIL, schwanz)
        ps(state, i, P_LOST, pg(state, i, P_LOST) + 1)
    }
    let p: u64 = evat(state, i, kopf)
    kstate.set(p, 0, typ)
    kstate.set(p, 8, ((a & 0xFFFF) << 32) | ((b & 0xFFFF) << 16)
        | (c & 0xFFFF))
    ps(state, i, P_HEAD, kopf + 1)
    ss(state, S_IN, sg(state, S_IN) + 1)
}

fn pending(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return pg(state, i, P_HEAD) - pg(state, i, P_TAIL)
}

// ABHOLEN. `aus` zeigt in den KERN (der Aufrufer kopiert von dort nach
// Ring 3). Rueckgabe 1 = eines geholt, 0 = keines da. NIE blockierend --
// hier steht kein `while`, das auf etwas wartet.
fn pop(state: u64, i: u64, aus: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    touch(state, i)
    let schwanz: u64 = pg(state, i, P_TAIL)
    if pg(state, i, P_HEAD) == schwanz {
        return 0
    }
    let p: u64 = evat(state, i, schwanz)
    kstate.set(aus, 0, kstate.get(p, 0))
    kstate.set(aus, 8, kstate.get(p, 8))
    ps(state, i, P_TAIL, schwanz + 1)
    ss(state, S_OUT, sg(state, S_OUT) + 1)
    return 1
}

// "Ich lebe." Jede Abholung setzt die Frist zurueck.
fn touch(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    ps(state, i, P_LAST, kstate.get(state, kstate.TICKS))
    ps(state, i, P_CALLS, pg(state, i, P_CALLS) + 1)
}

// DER KEHRBESEN. Laeuft im Zusammensetzpfad mit: acht Vergleiche, kein
// Warten. Wer etwas liegen hat und seit `S_FRIST` Ticks nicht abgeholt
// hat, fliegt. Rueckgabe: wie viele abgemeldet wurden.
//
// WARUM NUR MIT LIEGENDEM EREIGNIS: ein Plugin, das nichts abonniert hat
// und nichts zu tun hat, ist nicht traege, sondern still. Bestraft wird,
// wer GERUFEN WURDE und nicht kommt.
fn sweep(state: u64) -> u64 {
    return sweep_at(state, kstate.get(state, kstate.TICKS))
}

// Dieselbe Pruefung mit einer GENANNTEN Uhrzeit. Der Selbsttest braucht
// das: er darf die Uhr des laufenden Systems nicht verstellen, nur um
// eine Frist reissen zu lassen.
fn sweep_at(state: u64, jetzt: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    let f: u64 = sg(state, S_FRIST)
    var raus: u64 = 0
    var i: u64 = 0
    while i < MAX_PLUG {
        if pg(state, i, P_USED) != 0
            && pg(state, i, P_HEAD) != pg(state, i, P_TAIL)
            && jetzt > pg(state, i, P_LAST) + f {
            unreg(state, i, G_FRIST)
            raus = raus + 1
        }
        i = i + 1
    }
    return raus
}

// ------------------------------------------------- Kuerzel und Leiste

fn set_key(state: u64, i: u64, taste: u64, mods: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if (pg(state, i, P_RIGHTS) & R_ACT_KEY) == 0 {
        deny(state, i)
        return false
    }
    // Kein zweiter Besitzer fuer dasselbe Kuerzel: wer zuerst kommt.
    let w: u64 = (mods << 32) | (taste & 0xFFFFFFFF)
    var k: u64 = 0
    while k < MAX_PLUG {
        if k != i && pg(state, k, P_USED) != 0 && pg(state, k, P_KEY) == w {
            return false
        }
        k = k + 1
    }
    ps(state, i, P_KEY, w)
    return true
}

fn key_at(state: u64, i: u64) -> u64 {
    return pg(state, i, P_KEY)
}

// Wem gehoert dieses Kuerzel? MAX_PLUG = niemandem.
fn key_owner(state: u64, taste: u64, mods: u64) -> u64 {
    let w: u64 = (mods << 32) | (taste & 0xFFFFFFFF)
    var i: u64 = 0
    while i < MAX_PLUG {
        if pg(state, i, P_USED) != 0 && pg(state, i, P_KEY) == w {
            return i
        }
        i = i + 1
    }
    return MAX_PLUG
}

// Der Leistenbereich: TEXT, nicht Bildpunkte. Ein Plugin malt NICHT --
// es sagt der Leiste, was dort stehen soll, und die Leiste malt es mit
// fUi/wlib wie alles andere. Damit gibt es keinen zweiten Zeichenweg.
fn bar_set(state: u64, i: u64, quelle: u64, n: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if (pg(state, i, P_RIGHTS) & R_ACT_BAR) == 0 {
        deny(state, i)
        return false
    }
    var len: u64 = n
    if len > BAR_LEN - 1 {
        len = BAR_LEN - 1
    }
    var k: u64 = 0
    while k < len {
        kstate.set8(pat(state, i, P_BAR) + k,
            kstate.get8(quelle + k) as u8)
        k = k + 1
    }
    kstate.set8(pat(state, i, P_BAR) + len, 0 as u8)
    ps(state, i, P_BARLEN, len)
    return true
}

fn bar_ptr(state: u64, i: u64) -> u64 {
    return pat(state, i, P_BAR)
}

fn bar_len(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return pg(state, i, P_BARLEN)
}

// ------------------------------------------------ die Gewaehrungstafel
//
// WER DARF WAS. Eingetragen von /bin/wmplug (Ring 3, root) aus
// /etc/wmplug.conf, gelesen beim Anmelden. Der Kern liest die Datei
// NICHT -- ein Dateiparser im Kern waere die naechste Angriffsflaeche.

fn grants(state: u64) -> u64 {
    return sg(state, S_GRANTS)
}

// Der Eintrag zu einem Namen (Zeiger auf NAME_LEN Kernoktette),
// MAX_GRANT wenn keiner.
fn grant_lookup(state: u64, name: u64) -> u64 {
    var k: u64 = 0
    while k < MAX_GRANT {
        if kstate.get(gat(state, k), GR_USED) != 0 {
            var gleich: bool = true
            var j: u64 = 0
            while j < NAME_LEN {
                if kstate.get8(gat(state, k) + GR_NAME + j)
                    != kstate.get8(name + j) {
                    gleich = false
                    j = NAME_LEN
                } else {
                    j = j + 1
                }
            }
            if gleich {
                return k
            }
        }
        k = k + 1
    }
    return MAX_GRANT
}

// Eintragen oder aendern. `name` zeigt auf NAME_LEN Kernoktette.
fn grant(state: u64, name: u64, rechte: u64) -> bool {
    var k: u64 = grant_lookup(state, name)
    if k >= MAX_GRANT {
        k = 0
        var frei: u64 = MAX_GRANT
        while k < MAX_GRANT {
            if kstate.get(gat(state, k), GR_USED) == 0 && frei == MAX_GRANT {
                frei = k
            }
            k = k + 1
        }
        if frei >= MAX_GRANT {
            return false
        }
        k = frei
        var j: u64 = 0
        while j < NAME_LEN {
            kstate.set8(gat(state, k) + GR_NAME + j,
                kstate.get8(name + j) as u8)
            j = j + 1
        }
        kstate.set(gat(state, k), GR_USED, 1)
        ss(state, S_GRANTS, sg(state, S_GRANTS) + 1)
    }
    kstate.set(gat(state, k), GR_RIGHTS, rechte & R_ALL)
    // WIRKT SOFORT, AUCH AUF SCHON ANGEMELDETE: `wmplug disable` soll
    // ein laufendes Plugin entwaffnen koennen, ohne es zu toeten.
    var i: u64 = 0
    while i < MAX_PLUG {
        if pg(state, i, P_USED) != 0
            && grant_lookup(state, pat(state, i, P_NAME)) == k {
            ps(state, i, P_RIGHTS, rechte & R_ALL)
        }
        i = i + 1
    }
    return true
}

// --------------------------------------------------- Arbeitsflaechen
//
// WARUM HIER UND NICHT IN wm.fi: der Fensterserver kennt Ebenen, aber
// keine Arbeitsflaechen -- nachgesehen, es gibt kein W_WS. Statt 9265
// Zeilen dafuer aufzumachen, fuehrt dieses Modul eine kleine Tafel
// (Fenster-Id -> Flaeche) und meldet, dass sie sich geaendert hat.
// WER SIE ANWENDET, IST `sysgui.fi`: dort liegt F_HIDDEN in Reichweite.
// Dieses Modul fasst kein Fenster an.

fn desk_cur(state: u64) -> u64 {
    return sg(state, S_DESK)
}

fn desk_set(state: u64, id: u64, ws: u64) -> bool {
    var frei: u64 = MAX_DESK
    var k: u64 = 0
    while k < MAX_DESK {
        let e: u64 = dat(state, k)
        if kstate.get(e, DK_ID) == id {
            kstate.set(e, DK_WS, ws)
            ss(state, S_DDIRTY, 1)
            return true
        }
        if kstate.get(e, DK_ID) == 0 && frei == MAX_DESK {
            frei = k
        }
        k = k + 1
    }
    if frei >= MAX_DESK {
        return false
    }
    kstate.set(dat(state, frei), DK_ID, id)
    kstate.set(dat(state, frei), DK_WS, ws)
    ss(state, S_DDIRTY, 1)
    return true
}

// Auf welcher Flaeche liegt dieses Fenster? Ohne Eintrag: 0, und 0
// heisst "ueberall sichtbar" -- ein Fenster, von dem kein Plugin etwas
// weiss, verschwindet nicht.
fn desk_of(state: u64, id: u64) -> u64 {
    var k: u64 = 0
    while k < MAX_DESK {
        if kstate.get(dat(state, k), DK_ID) == id {
            return kstate.get(dat(state, k), DK_WS)
        }
        k = k + 1
    }
    return 0
}

fn desk_go(state: u64, ws: u64) -> bool {
    if sg(state, S_DESK) == ws {
        return false
    }
    ss(state, S_DESK, ws)
    ss(state, S_DDIRTY, 1)
    notify(state, E_DESK, ws, 0, 0)
    return true
}

fn desk_dirty(state: u64) -> bool {
    return sg(state, S_DDIRTY) != 0
}

fn desk_clear(state: u64) {
    ss(state, S_DDIRTY, 0)
}

// ------------------------------------------------------- der Selbsttest
//
// Zusagen ueber dieses Modul allein, ohne Bildschirm und ohne Ring 3.
// Ein Bit je Zusage in S_FAIL: man will wissen, WELCHE gefallen ist.

const SELF_MAX: u64 = 10

fn selftest_max() -> u64 {
    return SELF_MAX
}

fn failbits(state: u64) -> u64 {
    return sg(state, S_FAIL)
}

fn fail(state: u64, n: u64) {
    ss(state, S_FAIL, sg(state, S_FAIL) | (1 << n))
}

fn selftest(state: u64) -> u64 {
    init(state)
    ss(state, S_FAIL, 0)
    var ok: u64 = 0
    var name: [u8; 16] = "selbsttest\0\0\0\0\0\0"
    let np: u64 = (&name[0]) as u64

    // 1: falsche Fassung wird abgewiesen.
    if reg(state, 777, WMP_ABI + 1, np, 0xFF) >= MAX_PLUG {
        ok = ok + 1
    } else {
        fail(state, 0)
    }
    // 2: richtige Fassung bekommt einen Platz.
    let i: u64 = reg(state, 777, WMP_ABI, np, 0xFF)
    if i < MAX_PLUG {
        ok = ok + 1
    } else {
        fail(state, 1)
    }
    // 3: ohne Eintrag in der Gewaehrungstafel nur Zuschauerrechte.
    if rights_at(state, i) == R_DEFAULT {
        ok = ok + 1
    } else {
        fail(state, 2)
    }
    // 4: eine Handlung ohne Recht wird abgewiesen UND gezaehlt.
    let vorher: u64 = denials(state)
    if !bar_set(state, i, np, 4) && denials(state) == vorher + 1 {
        ok = ok + 1
    } else {
        fail(state, 3)
    }
    // 5: mit Gewaehrung geht dieselbe Handlung.
    grant(state, np, R_ALL)
    if bar_set(state, i, np, 4) {
        ok = ok + 1
    } else {
        fail(state, 4)
    }
    // 6: ein Ereignis kommt an.
    notify(state, E_WIN_OPEN, 3, 0, 0)
    if pending(state, i) == 1 {
        ok = ok + 1
    } else {
        fail(state, 5)
    }
    // 7: und laesst sich abholen.
    var aus: [u64; 2] = [0; 2]
    if pop(state, i, (&aus[0]) as u64) == 1 && aus[0] == E_WIN_OPEN {
        ok = ok + 1
    } else {
        fail(state, 6)
    }
    // 8: der Ring laeuft ueber, ohne etwas anderes zu beschaedigen --
    // er verliert das AELTESTE und zaehlt den Verlust.
    var n: u64 = 0
    while n < EV_SLOTS + 5 {
        notify(state, E_WIN_OPEN, n, 0, 0)
        n = n + 1
    }
    if pending(state, i) == EV_SLOTS && lost_at(state, i) == 5 {
        ok = ok + 1
    } else {
        fail(state, 7)
    }
    // 9: die Frist greift -- ohne dass jemand gewartet haette.
    ps(state, i, P_LAST, 0)
    ss(state, S_FRIST, 1)
    if sweep_at(state, 1000) == 1 && !valid(state, i) {
        ok = ok + 1
    } else {
        fail(state, 8)
    }
    // 10: ein Ereignis ohne Empfaenger kostet nichts und faellt still.
    let e0: u64 = events_in(state)
    notify(state, E_FOCUS, 1, 0, 0)
    if events_in(state) == e0 {
        ok = ok + 1
    } else {
        fail(state, 9)
    }

    let bits: u64 = sg(state, S_FAIL)
    init(state)
    ss(state, S_FAIL, bits)
    var s_t: [u8; 18] = "wmplug: selftest \0"
    var s_s: [u8; 4] = " / \0"
    var s_f: [u8; 10] = "  failed=\0"
    serial.puts((&s_t[0]) as u64)
    serial.dec(ok)
    serial.puts((&s_s[0]) as u64)
    serial.dec(SELF_MAX)
    serial.puts((&s_f[0]) as u64)
    serial.hex(bits)
    serial.nl()
    return ok
}
