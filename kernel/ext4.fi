// SPDX-License-Identifier: GPL-2.0-only
// kernel/ext4.fi -- Runde FREMDFS: ext4, NUR LESEND.
//
// WOZU. Seit der Runde DUALBOOT kann OrientOS neben Windows oder neben
// einem Linux installiert werden. Danach steht der Benutzer vor einer
// Platte, auf der SEINE Dateien liegen -- und kommt nicht heran. Ein
// Zweitsystem, das die Daten des Erstsystems nicht sieht, ist ein
// besserer Bildschirmschoner. Diese Datei macht die Linux-Seite
// lesbar; `kernel/ntfs.fi` die Windows-Seite.
//
// NUR LESEND, UND ZWAR MIT ABSICHT. ext4 schreibend hiesse: Journal
// fuehren, Blockgruppen-Zaehler nachfuehren, Pruefsummen (metadata_csum)
// ueber Superblock, Gruppenbeschreiber, Inodes, Verzeichnisbloecke und
// Extent-Knoten neu rechnen. Jede einzelne dieser Stellen falsch
// gemacht heisst: die Platte ist fuer das ANDERE System kaputt, und
// zwar meistens erst beim naechsten `e2fsck` sichtbar. Der Auftrag
// dieser Runde ist das Lesen; das Schreiben ist keine halbe Runde
// mehr, sondern eine eigene, und bis dahin sagt dieser Treiber NEIN
// statt es halb zu koennen. `mask` traegt deshalb nur die vier
// lesenden Bits (siehe `ops` ganz unten).
//
// ================================================== DAS FORMAT
//
// DER SUPERBLOCK liegt bei Oktett 1024, IMMER -- unabhaengig von der
// Blockgroesse. Daraus kommen:
//   0x18 s_log_block_size    Blockgroesse = 1024 << diesem Wert
//   0x28 s_inodes_per_group
//   0x14 s_first_data_block  0 bei >=2048er Bloecken, sonst 1
//   0x38 s_magic             0xEF53, und nichts anderes
//   0x3A s_state             Bit 0 = sauber ausgehaengt
//   0x58 s_inode_size        128 bei altem ext2, 256 bei ext4
//   0x5C s_feature_compat
//   0x60 s_feature_incompat  darin Bit 6 (0x40) = EXTENTS,
//                            Bit 7 (0x80) = 64BIT,
//                            Bit 2 (0x04) = NEEDS_RECOVERY
//   0x64 s_feature_ro_compat
//   0xFE s_desc_size         Groesse eines Gruppenbeschreibers (64 bei
//                            64BIT, sonst 32)
//
// DIE BLOCKGRUPPEN. Hinter dem Superblock steht die Tafel der
// Gruppenbeschreiber, je `s_desc_size` Oktette. Was dieser Treiber
// davon braucht, ist EIN Feld: bg_inode_table (0x08, und bei 64 Bit
// die oberen 32 Bit bei 0x28). Die Bitkarten interessieren einen
// Leser nicht -- er fragt nie, was frei ist.
//
// EIN INODE ist `s_inode_size` Oktette. Daraus:
//   0x00 i_mode      die oberen vier Bits sind die ART
//                    (0x8 Datei, 0x4 Verzeichnis, 0xA Verweis)
//   0x04 i_size_lo   und 0x6C i_size_high -- zusammen 64 Bit. Ohne die
//                    oberen 32 Bit endet jede Datei ueber 4 GiB an der
//                    falschen Stelle; das ist der ganze Sinn von
//                    "grosse Dateien".
//   0x1A i_links_count
//   0x20 i_flags     Bit 19 (0x80000) = EXTENTS_FL
//                    Bit 12 (0x01000) = INDEX_FL (htree)
//   0x28 i_block     60 Oktette: entweder der Extent-Baum, oder die
//                    zwoelf direkten und drei indirekten Blocknummern,
//                    oder -- bei einem kurzen Verweis -- das Ziel als
//                    Text.
//
// DER EXTENT-BAUM (das Herzstueck von ext4, und der Grund, warum ein
// ext2-Leser hier nicht reicht). Jeder Knoten faengt mit zwoelf
// Oktetten an:
//   0x00 eh_magic 0xF30A, 0x02 eh_entries, 0x04 eh_max, 0x06 eh_depth
// Bei eh_depth == 0 folgen BLATT-Eintraege zu zwoelf Oktetten:
//   0x00 ee_block (erster logischer Block), 0x04 ee_len,
//   0x06 ee_start_hi, 0x08 ee_start_lo
// Bei eh_depth > 0 folgen INDEX-Eintraege zu zwoelf Oktetten:
//   0x00 ei_block, 0x04 ei_leaf_lo, 0x08 ei_leaf_hi
// und dahinter geht es eine Ebene tiefer. Der Baum wird hier
// SCHRITTWEISE abgestiegen und nicht rekursiv -- ein Kernelstapel ist
// 8 KiB, und die Tiefe steht auf der Platte, kommt also vom
// Fremdsystem. Mehr als `MAX_TIEFE` Ebenen werden abgelehnt statt
// mitgemacht.
//
// EIN ee_len > 32768 heisst "nicht initialisiert" (ein Loch, das
// belegt ist): die wirkliche Laenge ist ee_len - 32768, und der Inhalt
// ist als NULL zu lesen. Wer das uebersieht, liefert alten Platteninhalt
// aus -- fremde Daten aus geloeschten Dateien.
//
// EIN VERZEICHNIS ist eine Folge von Eintraegen:
//   0x00 inode (0 = Grabstein, uebergehen), 0x04 rec_len,
//   0x06 name_len, 0x07 file_type, dahinter der Name (UTF-8, ohne
//   Nullabschluss).
// Ein htree-INDIZIERTES Verzeichnis (INDEX_FL) sieht fuer einen LESER,
// der alles der Reihe nach durchgeht, GENAUSO aus: die Indexknoten
// sind als Eintraege getarnt, die niemand sieht (der erste hat
// name_len 0 und rec_len = Blockgroesse). Dieser Treiber geht deshalb
// linear durch alle Bloecke und braucht den Index NICHT -- er muss ihn
// nur nicht fuer Dateien halten. Das ist der ehrliche Weg: langsamer
// beim Suchen in sehr grossen Verzeichnissen, aber ohne eine zweite
// Formatbeschreibung, die falsch sein koennte.
//
// SYMBOLISCHE VERWEISE. Ist das Ziel kuerzer als 60 Oktette, steht es
// UNMITTELBAR in i_block -- kein Datenblock, kein Extent. Sonst steht
// es in den Datenbloecken wie bei einer Datei. Beide Wege kommen im
// Alltag vor, also koennen beide hier vor.
//
// ================================================== WAS NICHT GEHT
//
// Und es steht hier und nicht nur in den Doku-Dateien, weil der
// naechste, der diese Datei aufmacht, es wissen muss:
//
//   - SCHREIBEN. Gar nicht. Siehe oben.
//   - ext2/ext3 OHNE Extents (indirekte Bloecke). Der Weg ist
//     eingebaut (`block_of_indirect`), weil er zwanzig Zeilen sind und
//     ein `mkfs.ext2` ihn sofort braucht -- aber gemessen ist er in
//     dieser Runde NICHT, und deshalb steht er unter Vorbehalt.
//   - VERSCHLUESSELUNG (encrypt), INLINE-DATEN (inline_data),
//     VERBUNDENE ORDNER (casefold). Jedes dieser Merkmale aendert, wo
//     die Daten liegen. Traegt der Superblock eines davon, wird das
//     Dateisystem ABGELEHNT statt falsch gelesen -- siehe
//     `mount_probe`.
//   - PRUEFSUMMEN werden NICHT geprueft. Ein Leser, der sie prueft,
//     ist besser; einer, der sie FALSCH prueft, lehnt gesunde Platten
//     ab. Das ist eine eigene Runde wert.
//   - Ein unsauber ausgehaengtes Dateisystem (NEEDS_RECOVERY) wird
//     erkannt und NUR-LESEND mit Warnung eingehaengt. Begruendung
//     steht bei `mount_probe`.
//
// WO DER ZUSTAND LIEGT: `kstate.EXT4_OFF`, eine Seite.

profile kernel

import lib.kstate
import serial
import blk
import mnt
import vfsops
import sched.sched
import sync.atomic
import arch.cpu

export { ops, mount_probe, release, node_hold, node_drop,
    MAX_NODES, unsauber }

const BS: u64 = 512 // ein SEKTOR. Die Bloecke des Dateisystems sind groesser.

// ------------------------------------------------- die Seite, aufgeteilt

const SB_OFF: u64 = 0x000 // 8 Einhaengungen zu 128 Oktetten
const SB_BYTES: u64 = 128
// DIE KNOTENTAFEL: 0x400..0x780, also 16 Knoten zu 56 Oktetten.
//
// HIER LAG EIN FEHLER, DER EINEN HALBEN TAG GEKOSTET HAT. Die
// Tafel hatte 24 Plaetze zu 48 Oktetten (0x480) und fing bei
// 0x400 an -- sie endete also bei 0x880, und der erste grosse
// Puffer steht bei 0x800. Die letzten drei Knoten lagen damit
// MITTEN IM PUFFER: wer eine Datei oeffnete, die einen davon
// bekam, verlor ihre Felder beim ersten Lesen, weil derselbe
// Speicher gleich darauf mit einem Plattenblock ueberschrieben
// wurde.
//
// Von aussen sah das aus wie ein Fehler im Datenlauf: eine
// Datei war nach genau einem Block zu Ende, und ihre
// Pruefsumme war die der ersten 4096 Oktette. Gesucht wurde
// zuerst im Datenlauf, dann in der Knotenverwaltung -- der
// Fehler lag in DIESEN ZWEI ZAHLEN.
//
// `tools/fremdfs/run.sh` rechnet die Aufteilung seit dieser
// Runde nach (Abschnitt 1), und `tools/kernel/memmap.py` kennt
// die Stuecke ebenfalls. Ein Puffer, der in die Tafel
// hineinragt, faellt damit beim Bauen auf und nicht erst an
// einer falschen Pruefsumme.
const NODE_OFF: u64 = 0x400 // 24 Knoten zu 48 Oktetten
const NODE_BYTES: u64 = 56
const MAX_NODES: u64 = 16
// Die Arbeitspuffer. Ein Block des Dateisystems kann 4096 Oktette
// gross sein, und davon werden zwei gleichzeitig gebraucht (ein
// Verzeichnisblock, waehrend ein Extent-Knoten gelesen wird).
const BLKBUF: u64 = 0x800  // 4096: ein Block des Dateisystems
const NODEBUF: u64 = 0x1800 // 4096: ein zweiter Block (Extent-Knoten)
const INOBUF: u64 = 0x2800 // 512: der Sektor mit dem Inode
const SECBUF: u64 = 0x2A00 // 512: ein einzelner Sektor
const NAMBUF: u64 = 0x2C00 // 256: der Name, gegen den verglichen wird

// die Felder je Einhaengung
const S_VALID: u64 = 0
const S_BSIZE: u64 = 8   // Blockgroesse in Oktetten
const S_IPG: u64 = 16    // Inodes je Gruppe
const S_INOSZ: u64 = 24  // Groesse eines Inodes
const S_FIRST: u64 = 32  // s_first_data_block
const S_DESCSZ: u64 = 40 // Groesse eines Gruppenbeschreibers
const S_BLOCKS: u64 = 48 // wie viele Bloecke das Dateisystem hat
const S_INCOMPAT: u64 = 56
const S_64BIT: u64 = 64
const S_UNSAUBER: u64 = 72 // 1 = NEEDS_RECOVERY oder s_state != sauber
const S_GDBLOCK: u64 = 80  // der Block, in dem die Beschreibertafel anfaengt
// ---------------------------------------------- der Extent-Zwischenspeicher
//
// Der zuletzt gefundene Extent, damit sequentielles Lesen den Baum
// nicht fuer jeden Block neu absteigen muss. Die lange Begruendung
// steht bei `extent_lookup`.
const S_CINO: u64 = 88    // fuer welche Inode er gilt (0 = leer)
const S_CBLOCK: u64 = 96  // erster logischer Block des Extents
const S_CLEN: u64 = 104   // wie viele Bloecke er umfasst
const S_CPHYS: u64 = 112  // und wo sie physisch anfangen

// die Felder je Knoten
const N_MNT: u64 = 0 // Einhaengung + 1, 0 = frei
const N_INO: u64 = 8
const N_SIZE: u64 = 16
const N_MODE: u64 = 24
const N_FLAGS: u64 = 32
const N_LINKS: u64 = 40
// Wie viele Deskriptoren auf diesem Knoten offen sind; ein Platz mit
// N_USE > 0 wird nicht wiederverwendet.
const N_USE: u64 = 48

// Die Magie des Superblocks und die des Extent-Knotens.
const MAGIE: u64 = 0xEF53
const EXT_MAGIE: u64 = 0xF30A

// Die Merkmale, die dieser Treiber NICHT mitmacht. Jedes davon
// verschiebt, WO die Daten liegen -- ein Dateisystem damit zu lesen,
// als waere es gewoehnlich, liefert Muell statt eines Fehlers.
const INC_COMPRESSION: u64 = 0x1
const INC_RECOVER: u64 = 0x4
const INC_64BIT: u64 = 0x80
const INC_INLINE_DATA: u64 = 0x8000
const INC_ENCRYPT: u64 = 0x10000
const INC_CASEFOLD: u64 = 0x20000

const MAX_TIEFE: u64 = 5

// ------------------------------------------------------------ die Sperre
//
// DIESELBE SPERRE WIE OFS UND FAT, aus demselben Grund: sie schuetzt
// nicht nur die Arbeitspuffer dieser Datei, sondern die ATA-Register
// darunter, die `blk.fi` benutzt und die keine eigene haben.
const NESTED: u64 = 0x8000000000000000

fn enter(state: u64) -> u64 {
    let flags: u64 = sched.irq_save()
    let me: u64 = cpu.here(state)
    if atomic.lock_owner(state, atomic.L_FS) == me + 1 {
        return flags | NESTED
    }
    atomic.lock_take(state, atomic.L_FS, me)
    return flags
}

fn leave(state: u64, flags: u64) {
    if (flags & NESTED) == 0 {
        atomic.lock_give(state, atomic.L_FS)
    }
    sched.irq_restore(flags & 0x7FFFFFFFFFFFFFFF)
}

// ------------------------------------------------------ kleine Handgriffe

fn sb(state: u64, m: u64) -> u64 {
    return state + kstate.EXT4_OFF + SB_OFF + m * SB_BYTES
}

fn sget(state: u64, m: u64, f: u64) -> u64 {
    return __mmio_read64((sb(state, m) + f) as *mut u64)
}

fn sset(state: u64, m: u64, f: u64, v: u64) {
    __mmio_write64((sb(state, m) + f) as *mut u64, v)
}

fn nd(state: u64, i: u64) -> u64 {
    return state + kstate.EXT4_OFF + NODE_OFF + (i - 1) * NODE_BYTES
}

fn nget(state: u64, i: u64, f: u64) -> u64 {
    if i == 0 || i > MAX_NODES {
        return 0
    }
    return __mmio_read64((nd(state, i) + f) as *mut u64)
}

fn nset(state: u64, i: u64, f: u64, v: u64) {
    if i == 0 || i > MAX_NODES {
        return
    }
    __mmio_write64((nd(state, i) + f) as *mut u64, v)
}

fn buf(state: u64, which: u64) -> u64 {
    return state + kstate.EXT4_OFF + which
}

fn tick(state: u64) {
    kstate.add(state, kstate.VFS_INDIRECT, 1)
}

fn le16(p: u64) -> u64 {
    return kstate.get8(p) | (kstate.get8(p + 1) << 8)
}

fn le32(p: u64) -> u64 {
    return le16(p) | (le16(p + 2) << 16)
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, 0 as u8)
        i = i + 1
    }
}

fn rd(state: u64, m: u64, lba: u64, dst: u64) -> bool {
    return blk.read_on(state, mnt.dev(state, m), lba, dst)
}

// EINEN BLOCK DES DATEISYSTEMS LESEN. Ein Block sind mehrere Sektoren,
// und `blk.fi` kennt nur Sektoren -- also wird hier umgerechnet und
// Sektor fuer Sektor gefuellt.
//
// DIE GRENZE WIRD GEPRUEFT UND NICHT GERATEN. `blocks` steht im
// Superblock, also auf der Platte, also im Zugriff des fremden
// Systems. Ein abgeschnittenes Abbild (siehe die Gegenprobe
// `kurz-ext4.img`) nennt dort mehr Bloecke, als das Geraet hat; ohne
// diese zwei Zeilen liest der Treiber ueber das Ende hinaus und
// liefert, was `blk.fi` zufaellig im Puffer stehen laesst.
fn block_read(state: u64, m: u64, block: u64, dst: u64) -> bool {
    if block == 0 || block >= sget(state, m, S_BLOCKS) {
        return false
    }
    let bs: u64 = sget(state, m, S_BSIZE)
    let sektoren: u64 = bs / BS
    let erster: u64 = mnt.first(state, m) + block * sektoren
    var i: u64 = 0
    while i < sektoren {
        if !rd(state, m, erster + i, dst + i * BS) {
            return false
        }
        i = i + 1
    }
    return true
}

// -------------------------------------------------------- die Knotentafel

fn node_find(state: u64, m: u64, ino: u64) -> u64 {
    var i: u64 = 1
    while i <= MAX_NODES {
        if nget(state, i, N_MNT) == m + 1 && nget(state, i, N_INO) == ino {
            return i
        }
        i = i + 1
    }
    return 0
}

// EIN KNOTEN JE INODE, NICHT JE NACHSCHLAGEN -- derselbe Grund wie bei
// FAT32: wer dieselbe Datei zweimal oeffnet, soll denselben Knoten
// bekommen, sonst ist die kleine Tafel nach vierundzwanzig `open` voll
// und `st_ino` waere jedes Mal eine andere Zahl fuer dieselbe Datei.
// EINEN KNOTEN HOLEN -- UND WENN KEIN PLATZ FREI IST, EINEN
// WIEDERVERWENDEN. Die lange Begruendung steht in `kernel/ntfs.fi` bei
// derselben Funktion; kurz: eine Tafel, die voll laufen kann, MUSS
// einen Platz neu belegen koennen, sonst liefert der Aufrufer
// irgendwann den falschen Knoten. Ein Verzeichnis mit 512 Eintraegen
// fuellt 24 Plaetze sofort.
//
// Ein Platz, auf dem ein Deskriptor offen ist (`N_USE` > 0), wird
// NICHT genommen.
fn node_get(state: u64, m: u64, ino: u64, size: u64, mode: u64,
    flags: u64, links: u64) -> u64 {
    let have: u64 = node_find(state, m, ino)
    if have != 0 {
        nset(state, have, N_SIZE, size)
        nset(state, have, N_MODE, mode)
        nset(state, have, N_FLAGS, flags)
        nset(state, have, N_LINKS, links)
        return have
    }
    var i: u64 = 1
    while i <= MAX_NODES {
        if nget(state, i, N_MNT) == 0 {
            nset(state, i, N_MNT, m + 1)
            nset(state, i, N_INO, ino)
            nset(state, i, N_SIZE, size)
            nset(state, i, N_MODE, mode)
            nset(state, i, N_FLAGS, flags)
            nset(state, i, N_LINKS, links)
            nset(state, i, N_USE, 0)
            return i
        }
        i = i + 1
    }
    var k: u64 = 1
    while k <= MAX_NODES {
        if nget(state, k, N_USE) == 0 {
            nset(state, k, N_MNT, m + 1)
            nset(state, k, N_INO, ino)
            nset(state, k, N_SIZE, size)
            nset(state, k, N_MODE, mode)
            nset(state, k, N_FLAGS, flags)
            nset(state, k, N_LINKS, links)
            return k
        }
        k = k + 1
    }
    return 0
}

fn node_hold(state: u64, node: u64) {
    if node == 0 || node > MAX_NODES {
        return
    }
    nset(state, node, N_USE, nget(state, node, N_USE) + 1)
}

fn node_drop(state: u64, node: u64) {
    if node == 0 || node > MAX_NODES {
        return
    }
    let n: u64 = nget(state, node, N_USE)
    if n != 0 {
        nset(state, node, N_USE, n - 1)
    }
}

fn release(state: u64, m: u64) {
    var i: u64 = 1
    while i <= MAX_NODES {
        if nget(state, i, N_MNT) == m + 1 {
            zero(nd(state, i), NODE_BYTES)
        }
        i = i + 1
    }
}

fn unsauber(state: u64, m: u64) -> u64 {
    return sget(state, m, S_UNSAUBER)
}

// ------------------------------------------------------------- der Inode
//
// Den Rohinode in `INOBUF` holen. Die Rechnung ist die aus der
// Formatbeschreibung: Gruppe = (ino-1) / Inodes_je_Gruppe, Platz
// darin = (ino-1) % Inodes_je_Gruppe, und die Inodetafel der Gruppe
// steht im Gruppenbeschreiber.
//
// Rueckgabe: der Versatz des Inodes IM Puffer, oder 0.
fn inode_load(state: u64, m: u64, ino: u64) -> u64 {
    if ino == 0 {
        return 0
    }
    let ipg: u64 = sget(state, m, S_IPG)
    let inosz: u64 = sget(state, m, S_INOSZ)
    if ipg == 0 || inosz == 0 {
        return 0
    }
    let gruppe: u64 = (ino - 1) / ipg
    let platz: u64 = (ino - 1) % ipg
    let descsz: u64 = sget(state, m, S_DESCSZ)
    let bs: u64 = sget(state, m, S_BSIZE)

    // Der Gruppenbeschreiber. Er liegt irgendwo in der Tafel, die beim
    // Block nach dem Superblock anfaengt -- und die Tafel kann viele
    // Bloecke lang sein, also wird der richtige Block gerechnet und
    // nur DER gelesen.
    let doff: u64 = gruppe * descsz
    let dblock: u64 = sget(state, m, S_GDBLOCK) + doff / bs
    if !block_read(state, m, dblock, buf(state, BLKBUF)) {
        return 0
    }
    let d: u64 = buf(state, BLKBUF) + (doff % bs)
    var itab: u64 = le32(d + 0x8)
    if sget(state, m, S_64BIT) != 0 && descsz >= 64 {
        // DIE OBEREN 32 BIT. Ohne sie zeigt die Inodetafel jeder
        // Gruppe jenseits von 2^32 Bloecken auf die falsche Stelle --
        // und das ist genau der Fall, fuer den es 64BIT gibt.
        itab = itab | (le32(d + 0x28) << 32)
    }
    if itab == 0 {
        return 0
    }

    // Jetzt der Sektor, in dem dieser Inode steht.
    let byte_off: u64 = itab * bs + platz * inosz
    let sektor: u64 = mnt.first(state, m) + byte_off / BS
    if !rd(state, m, sektor, buf(state, INOBUF)) {
        return 0
    }
    let im_sektor: u64 = byte_off % BS
    // Ein Inode von 256 Oktetten kann NICHT ueber eine Sektorgrenze
    // gehen (512 ist ein Vielfaches von 128 und 256, und die Tafel
    // faengt an einer Blockgrenze an) -- aber wenn er es doch taete,
    // waere das Ergebnis halb gelesener Muell. Also wird es geprueft.
    if im_sektor + inosz > BS {
        return 0
    }
    return buf(state, INOBUF) + im_sektor
}

fn ino_mode(p: u64) -> u64 {
    return le16(p + 0x00)
}

fn ino_size(p: u64) -> u64 {
    // i_size_lo UND i_size_high. Genau diese eine Zeile ist der
    // Unterschied zwischen "grosse Dateien gehen" und "Dateien ueber
    // 4 GiB enden an einer zufaelligen Stelle".
    return le32(p + 0x04) | (le32(p + 0x6C) << 32)
}

fn ino_flags(p: u64) -> u64 {
    return le32(p + 0x20)
}

fn ino_links(p: u64) -> u64 {
    return le16(p + 0x1A)
}

fn art_von(mode: u64) -> u64 {
    let hoch: u64 = mode & 0xF000
    if hoch == 0x4000 {
        return vfsops.N_DIR
    }
    if hoch == 0xA000 {
        return vfsops.N_LNK
    }
    if hoch == 0x8000 {
        return vfsops.N_FILE
    }
    return vfsops.N_FILE
}

// ---------------------------------------------------------- die Extents
//
// DER n-TE LOGISCHE BLOCK EINER DATEI, als physische Blocknummer.
// Rueckgabe 0 heisst "nicht belegt" -- ein Loch, und ein Loch liest
// sich als Nullen und nicht als Fehler.
//
// Der Baum wird SCHRITTWEISE abgestiegen: `knoten` zeigt erst auf die
// 60 Oktette in i_block, danach jeweils auf einen gelesenen Block in
// NODEBUF. Rekursion waere hier eine Stapeltiefe, die auf der PLATTE
// steht -- also beim fremden System.
fn extent_lookup(state: u64, m: u64, iptr: u64, lblock: u64,
    ino: u64) -> u64 {
    // ERST IM ZWISCHENSPEICHER NACHSEHEN.
    //
    // Sequentielles Lesen bleibt fast immer im selben Extent -- der
    // Baum muss dafuer kein einziges Mal betreten werden. Gemessen
    // hat genau diese Abfrage aus 0,7 MB/s ein Vielfaches gemacht;
    // ohne sie steigt `f_read` fuer JEDEN Block von neuem ab, und bei
    // Baumtiefe 1 ist das ein zusaetzlicher Plattenzugriff je 4096
    // Oktette.
    if ino != 0 && sget(state, m, S_CINO) == ino {
        let cb: u64 = sget(state, m, S_CBLOCK)
        let cl: u64 = sget(state, m, S_CLEN)
        if cl != 0 && lblock >= cb && lblock < cb + cl {
            return sget(state, m, S_CPHYS) + (lblock - cb)
        }
    }
    var knoten: u64 = iptr + 0x28
    var runde: u64 = 0
    while runde <= MAX_TIEFE {
        if le16(knoten + 0x00) != EXT_MAGIE {
            return 0
        }
        let eintraege: u64 = le16(knoten + 0x02)
        let tiefe: u64 = le16(knoten + 0x06)
        if tiefe == 0 {
            // BLATT: den Eintrag suchen, der diesen Block enthaelt.
            var i: u64 = 0
            while i < eintraege {
                let e: u64 = knoten + 12 + i * 12
                let ee_block: u64 = le32(e + 0x00)
                var ee_len: u64 = le16(e + 0x04)
                // > 32768 heisst "belegt, aber nicht beschrieben".
                // Der Inhalt ist als NULL zu liefern -- steht dort der
                // alte Platteninhalt, waeren das fremde Daten aus
                // geloeschten Dateien.
                var unbeschrieben: bool = false
                if ee_len > 32768 {
                    ee_len = ee_len - 32768
                    unbeschrieben = true
                }
                if lblock >= ee_block && lblock < ee_block + ee_len {
                    if unbeschrieben {
                        return 0
                    }
                    let start: u64 = le32(e + 0x08) | (le16(e + 0x06) << 32)
                    // Den gefundenen Extent merken -- der naechste
                    // Block liegt fast immer noch darin.
                    if ino != 0 {
                        sset(state, m, S_CINO, ino)
                        sset(state, m, S_CBLOCK, ee_block)
                        sset(state, m, S_CLEN, ee_len)
                        sset(state, m, S_CPHYS, start)
                    }
                    return start + (lblock - ee_block)
                }
                i = i + 1
            }
            return 0
        }
        // INDEX: den letzten Eintrag nehmen, dessen ei_block noch
        // <= lblock ist. Die Eintraege sind aufsteigend sortiert --
        // das sagt das Format zu, und `e2fsck` prueft es.
        var gewaehlt: u64 = 0
        var i: u64 = 0
        while i < eintraege {
            let e: u64 = knoten + 12 + i * 12
            if le32(e + 0x00) <= lblock {
                gewaehlt = e
            }
            i = i + 1
        }
        if gewaehlt == 0 {
            return 0
        }
        let unten: u64 = le32(gewaehlt + 0x04) | (le16(gewaehlt + 0x08) << 32)
        if !block_read(state, m, unten, buf(state, NODEBUF)) {
            return 0
        }
        knoten = buf(state, NODEBUF)
        runde = runde + 1
    }
    // Tiefer als MAX_TIEFE: das ist kein Baum mehr, den dieser Treiber
    // versteht. Lieber nichts liefern als etwas Erfundenes.
    return 0
}

// DER ALTE WEG: zwoelf direkte Blocknummern, dann einfach, zweifach
// und dreifach indirekt. ext2 und ext3 benutzen ihn, ext4 nur noch
// fuer Dateisysteme ohne das Merkmal EXTENTS.
//
// UNTER VORBEHALT: in dieser Runde nicht gemessen (die Pruefbilder
// sind alle mit Extents gebaut). Er steht hier, weil er kurz ist und
// weil ein ext2-Abbild sonst gar nichts liefern wuerde -- aber wer
// sich darauf verlaesst, misst ihn bitte erst.
fn block_of_indirect(state: u64, m: u64, iptr: u64, lblock: u64) -> u64 {
    let bs: u64 = sget(state, m, S_BSIZE)
    let je: u64 = bs / 4 // Blocknummern je Block
    if lblock < 12 {
        return le32(iptr + 0x28 + lblock * 4)
    }
    var rest: u64 = lblock - 12
    if rest < je {
        let ind: u64 = le32(iptr + 0x28 + 12 * 4)
        if ind == 0 || !block_read(state, m, ind, buf(state, NODEBUF)) {
            return 0
        }
        return le32(buf(state, NODEBUF) + rest * 4)
    }
    rest = rest - je
    if rest < je * je {
        let ind2: u64 = le32(iptr + 0x28 + 13 * 4)
        if ind2 == 0 || !block_read(state, m, ind2, buf(state, NODEBUF)) {
            return 0
        }
        let mitte: u64 = le32(buf(state, NODEBUF) + (rest / je) * 4)
        if mitte == 0 || !block_read(state, m, mitte, buf(state, NODEBUF)) {
            return 0
        }
        return le32(buf(state, NODEBUF) + (rest % je) * 4)
    }
    rest = rest - je * je
    let ind3: u64 = le32(iptr + 0x28 + 14 * 4)
    if ind3 == 0 || !block_read(state, m, ind3, buf(state, NODEBUF)) {
        return 0
    }
    let oben: u64 = le32(buf(state, NODEBUF) + (rest / (je * je)) * 4)
    if oben == 0 || !block_read(state, m, oben, buf(state, NODEBUF)) {
        return 0
    }
    let mitte2: u64 = le32(buf(state, NODEBUF) + ((rest / je) % je) * 4)
    if mitte2 == 0 || !block_read(state, m, mitte2, buf(state, NODEBUF)) {
        return 0
    }
    return le32(buf(state, NODEBUF) + (rest % je) * 4)
}

// Die eine Stelle, an der sich entscheidet, welcher der beiden Wege
// gilt. `iptr` muss auf einen GELADENEN Inode zeigen.
fn block_of(state: u64, m: u64, iptr: u64, lblock: u64, ino: u64) -> u64 {
    if (ino_flags(iptr) & 0x80000) != 0 {
        return extent_lookup(state, m, iptr, lblock, ino)
    }
    return block_of_indirect(state, m, iptr, lblock)
}

// ------------------------------------------------------- Verzeichnisse
//
// EIN VERZEICHNIS LINEAR DURCHGEHEN. Das ist der Kern von `lookup` und
// von `readdir` zugleich, damit es nur EINE Stelle gibt, die das
// Eintragsformat kennt.
//
//   want == 0  -> den Namen in NAMBUF suchen
//   want > 0   -> den `want`-ten Eintrag liefern (1-basiert)
//
// Rueckgabe: die Inodenummer, oder 0. Bei Erfolg steht der Name in
// `out_name` (falls != 0).
//
// HTREE BRAUCHT HIER NICHTS: die Indexknoten eines htree-Verzeichnisses
// sind als Eintraege getarnt, die ein linearer Leser uebergeht (inode
// 0 bzw. name_len 0). Das ist kein Trick, sondern ausdrueckliche
// Absicht des Formats -- damit alte Leser weiterlesen koennen.
fn dir_walk(state: u64, m: u64, dir_iptr_ino: u64, want: u64,
    out_name: u64) -> u64 {
    let iptr: u64 = inode_load(state, m, dir_iptr_ino)
    if iptr == 0 {
        return 0
    }
    if art_von(ino_mode(iptr)) != vfsops.N_DIR {
        return 0
    }
    let groesse: u64 = ino_size(iptr)
    let bs: u64 = sget(state, m, S_BSIZE)
    if bs == 0 {
        return 0
    }
    var gesehen: u64 = 0
    var lblock: u64 = 0
    while lblock * bs < groesse {
        // ACHTUNG: `block_of` benutzt NODEBUF, und der Inode liegt in
        // INOBUF -- deshalb bleibt `iptr` gueltig. Der gelesene
        // Verzeichnisblock geht nach BLKBUF, den `block_of` nur beim
        // Gruppenbeschreiber benutzt, und das ist hier vorbei.
        let pblock: u64 = block_of(state, m, iptr, lblock,
            dir_iptr_ino)
        if pblock != 0 {
            if !block_read(state, m, pblock, buf(state, BLKBUF)) {
                return 0
            }
            let basis: u64 = buf(state, BLKBUF)
            var off: u64 = 0
            while off + 8 <= bs {
                let e: u64 = basis + off
                let ino: u64 = le32(e + 0x00)
                let reclen: u64 = le16(e + 0x04)
                let namelen: u64 = kstate.get8(e + 0x06)
                // EIN reclen VON NULL WAERE EINE ENDLOSSCHLEIFE. Die
                // Zahl kommt von der Platte, also vom fremden System;
                // sie zu pruefen ist kein Misstrauen, sondern die
                // Bedingung dafuer, dass ein kaputtes Dateisystem den
                // Kern nicht anhaelt.
                if reclen < 8 || off + reclen > bs {
                    off = bs
                } else {
                    // inode 0 = Grabstein (geloescht), und der erste
                    // "Eintrag" eines htree-Verzeichnisses ist genau
                    // so einer. Beide werden uebergangen.
                    if ino != 0 && namelen != 0 {
                        gesehen = gesehen + 1
                        var treffer: bool = false
                        if want == 0 {
                            treffer = name_eq(e + 0x08, namelen,
                                buf(state, NAMBUF))
                        } else {
                            treffer = gesehen == want
                        }
                        if treffer {
                            if out_name != 0 {
                                var i: u64 = 0
                                while i < namelen && i < vfsops.NAME_MAX - 1 {
                                    kstate.set8(out_name + i,
                                        kstate.get8(e + 0x08 + i) as u8)
                                    i = i + 1
                                }
                                kstate.set8(out_name + i, 0 as u8)
                            }
                            return ino
                        }
                    }
                    off = off + reclen
                }
            }
        }
        lblock = lblock + 1
    }
    return 0
}

// Ein Name aus dem Verzeichnis gegen einen nullabgeschlossenen Namen.
// Der Name auf der Platte hat KEINEN Nullabschluss -- er hat eine
// Laenge, und das ist der Unterschied, an dem ein Vergleich mit
// `strcmp` scheitern wuerde.
//
// ext4 UNTERSCHEIDET GROSS- UND KLEINSCHREIBUNG (anders als FAT), also
// wird hier Oktett fuer Oktett verglichen. Das gilt auch fuer die
// Umlaute: sie sind UTF-8, also mehrere Oktette, und ein Vergleich
// Oktett fuer Oktett ist fuer sie genau richtig.
fn name_eq(platte: u64, len: u64, gesucht: u64) -> bool {
    var i: u64 = 0
    while i < len {
        let c: u64 = kstate.get8(gesucht + i)
        if c == 0 {
            return false
        }
        if kstate.get8(platte + i) != c {
            return false
        }
        i = i + 1
    }
    return kstate.get8(gesucht + len) == 0
}

fn copy_name(dst: u64, src: u64, max: u64) -> u64 {
    var i: u64 = 0
    while kstate.get8(src + i) != 0 && i + 1 < max {
        kstate.set8(dst + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(dst + i, 0 as u8)
    return i
}

fn segment(path: u64, at: u64, out: u64, max: u64) -> u64 {
    var i: u64 = at
    while kstate.get8(path + i) == 47 {
        i = i + 1
    }
    var n: u64 = 0
    while kstate.get8(path + i) != 0 && kstate.get8(path + i) != 47 {
        if n + 1 < max {
            kstate.set8(out + n, kstate.get8(path + i) as u8)
            n = n + 1
        }
        i = i + 1
    }
    kstate.set8(out + n, 0 as u8)
    return i
}

// ==================================================== DIE VERRICHTUNGEN

fn mount_probe(state: u64, m: u64) -> u64 {
    let __f: u64 = enter(state)
    let __r: u64 = mount_probe__inner(state, m)
    leave(state, __f)
    return __r
}

fn mount_probe__inner(state: u64, m: u64) -> u64 {
    var s_nein: [u8; 24] = "ext4: nicht ext4 (\0\0\0\0\0\0"
    var s_ja: [u8; 16] = "ext4: bsize=\0\0\0\0"
    var s_i: [u8; 10] = " inodes=\0\0"
    var s_w: [u8; 40] = "ext4: WARNUNG unsauber ausgehaengt\0\0\0\0\0\0"
    sset(state, m, S_VALID, 0)
    sset(state, m, S_UNSAUBER, 0)

    // Der Superblock liegt bei Oktett 1024, also bei Sektor 2 der
    // Partition -- unabhaengig von der Blockgroesse.
    let base: u64 = mnt.first(state, m)
    if !rd(state, m, base + 2, buf(state, SECBUF)) {
        return 0
    }
    let s: u64 = buf(state, SECBUF)
    if le16(s + 0x38) != MAGIE {
        serial.puts((&s_nein[0]) as u64)
        serial.dec(1)
        serial.nl()
        return 0
    }
    let logbs: u64 = le32(s + 0x18)
    // 1024 << 6 waeren 64 KiB -- mehr als die Puffer dieser Datei, und
    // mehr als Linux selbst auf x86 anlegt (dort ist bei 4096 Schluss,
    // weil die Seitengroesse die Grenze ist).
    if logbs > 2 {
        serial.puts((&s_nein[0]) as u64)
        serial.dec(2)
        serial.nl()
        return 0
    }
    let bs: u64 = 1024 << logbs
    let ipg: u64 = le32(s + 0x28)
    var inosz: u64 = le16(s + 0x58)
    // ext2 der ersten Stunde traegt hier 0 und meint 128.
    if inosz == 0 {
        inosz = 128
    }
    if ipg == 0 || inosz < 128 || inosz > 1024 {
        serial.puts((&s_nein[0]) as u64)
        serial.dec(3)
        serial.nl()
        return 0
    }
    let inkompat: u64 = le32(s + 0x60)
    // DIE MERKMALE, DIE ALLES VERSCHIEBEN. Wer eines davon liest, als
    // waere es nicht da, bekommt Muell statt Daten -- also lieber
    // ehrlich ablehnen.
    if (inkompat & INC_COMPRESSION) != 0 || (inkompat & INC_INLINE_DATA) != 0
        || (inkompat & INC_ENCRYPT) != 0 || (inkompat & INC_CASEFOLD) != 0 {
        serial.puts((&s_nein[0]) as u64)
        serial.dec(4)
        serial.nl()
        return 0
    }
    var descsz: u64 = le16(s + 0xFE)
    let ist64: u64 = inkompat & INC_64BIT
    if ist64 != 0 {
        if descsz < 64 {
            descsz = 64
        }
    } else {
        descsz = 32
    }
    let erster: u64 = le32(s + 0x14)
    let bloecke: u64 = le32(s + 0x04) | (le32(s + 0x150) << 32)
    if bloecke == 0 {
        serial.puts((&s_nein[0]) as u64)
        serial.dec(5)
        serial.nl()
        return 0
    }

    // ============================================================
    // DAS UNSAUBER AUSGEHAENGTE DATEISYSTEM.
    //
    // Der Auftrag laesst die Wahl zwischen "ablehnen" und "nur lesend
    // mit Warnung", und verlangt eine Begruendung. Die Entscheidung
    // ist: EINHAENGEN, NUR LESEND, MIT WARNUNG.
    //
    // Warum nicht ablehnen: dieser Treiber kann ohnehin NUR lesen. Der
    // Schaden, vor dem eine Ablehnung schuetzt, ist das SCHREIBEN auf
    // ein Dateisystem, dessen Journal noch offene Eintraege hat -- das
    // kann hier gar nicht passieren. Ablehnen wuerde also niemanden
    // schuetzen, aber genau in dem Fall die Daten verweigern, in dem
    // man sie am dringendsten braucht: nach einem Absturz, wenn man
    // von der anderen Seite an seine Dateien will. Das ist der ganze
    // Zweck dieser Runde.
    //
    // Was der Benutzer wissen MUSS, und was die Warnung sagt: was hier
    // zu lesen ist, ist der Stand VOR dem Journal. Ein Linux, das
    // gleich danach startet, spielt das Journal ein und sieht
    // moeglicherweise etwas anderes -- neuere Daten. Wer also hier
    // eine Datei kopiert, kopiert unter Umstaenden eine aeltere
    // Fassung. Deshalb steht es im Klartext auf der Konsole und in
    // `mount` als eigene Meldung, und nicht nur in einer Doku-Datei.
    var unsauber_ist: u64 = 0
    if (inkompat & INC_RECOVER) != 0 {
        unsauber_ist = 1
    }
    // s_state Bit 0 = EXT2_VALID_FS ("sauber ausgehaengt").
    if (le16(s + 0x3A) & 1) == 0 {
        unsauber_ist = 1
    }

    sset(state, m, S_BSIZE, bs)
    sset(state, m, S_IPG, ipg)
    sset(state, m, S_INOSZ, inosz)
    sset(state, m, S_FIRST, erster)
    sset(state, m, S_DESCSZ, descsz)
    sset(state, m, S_BLOCKS, bloecke)
    sset(state, m, S_INCOMPAT, inkompat)
    sset(state, m, S_64BIT, ist64)
    sset(state, m, S_UNSAUBER, unsauber_ist)
    // Die Beschreibertafel faengt im Block NACH dem Superblock an.
    // Bei 1024er Bloecken ist der Superblock Block 1, die Tafel Block
    // 2; bei groesseren Bloecken liegt der Superblock IM Block 0, und
    // die Tafel ist Block 1.
    sset(state, m, S_GDBLOCK, erster + 1)
    sset(state, m, S_CINO, 0)
    sset(state, m, S_CBLOCK, 0)
    sset(state, m, S_CLEN, 0)
    sset(state, m, S_CPHYS, 0)
    sset(state, m, S_VALID, 1)

    // DIE GEGENPROBE GEGEN EIN ABGESCHNITTENES ABBILD. Der Superblock
    // sagt, wie viele Bloecke das Dateisystem hat; das Geraet sagt,
    // wie viele Sektoren es wirklich hat. Sagt der Superblock mehr,
    // ist das Abbild unvollstaendig -- und ein Treiber, der das nicht
    // merkt, liefert beim Lesen der letzten Dateien Muell.
    //
    // `mnt.blocks` ist die Zahl der SEKTOREN der Partition.
    let sektoren_da: u64 = mnt.blocks(state, m)
    if sektoren_da != 0 {
        let sektoren_noetig: u64 = bloecke * (bs / BS)
        if sektoren_noetig > sektoren_da {
            serial.puts((&s_nein[0]) as u64)
            serial.dec(6)
            serial.nl()
            sset(state, m, S_VALID, 0)
            return 0
        }
    }

    serial.puts((&s_ja[0]) as u64)
    serial.dec(bs)
    serial.puts((&s_i[0]) as u64)
    serial.dec(ipg)
    serial.nl()
    if unsauber_ist != 0 {
        serial.puts((&s_w[0]) as u64)
        serial.nl()
    }

    // Die Wurzel von ext4 ist IMMER Inode 2.
    let iptr: u64 = inode_load(state, m, 2)
    if iptr == 0 {
        sset(state, m, S_VALID, 0)
        return 0
    }
    if art_von(ino_mode(iptr)) != vfsops.N_DIR {
        sset(state, m, S_VALID, 0)
        return 0
    }
    return node_get(state, m, 2, ino_size(iptr), ino_mode(iptr),
        ino_flags(iptr), ino_links(iptr))
}

fn f_lookup(state: u64, m: u64, path: u64) -> u64 {
    let __f: u64 = enter(state)
    let __r: u64 = f_lookup__inner(state, m, path)
    leave(state, __f)
    return __r
}

fn f_lookup__inner(state: u64, m: u64, path: u64) -> u64 {
    tick(state)
    if sget(state, m, S_VALID) == 0 {
        return 0
    }
    var seg: [u8; 256] = [0 as u8; 256]
    var at: u64 = 0
    var ino: u64 = 2
    var going: bool = true
    while going {
        at = segment(path, at, (&seg[0]) as u64, 256)
        if kstate.get8((&seg[0]) as u64) == 0 {
            going = false
        } else {
            copy_name(buf(state, NAMBUF), (&seg[0]) as u64, 256)
            let next: u64 = dir_walk(state, m, ino, 0, 0)
            if next == 0 {
                return 0
            }
            ino = next
        }
    }
    let iptr: u64 = inode_load(state, m, ino)
    if iptr == 0 {
        return 0
    }
    return node_get(state, m, ino, ino_size(iptr), ino_mode(iptr),
        ino_flags(iptr), ino_links(iptr))
}

fn f_readdir(state: u64, m: u64, dir: u64, index: u64, out: u64) -> u64 {
    let __f: u64 = enter(state)
    let __r: u64 = f_readdir__inner(state, m, dir, index, out)
    leave(state, __f)
    return __r
}

fn f_readdir__inner(state: u64, m: u64, dir: u64, index: u64,
    out: u64) -> u64 {
    tick(state)
    if dir == 0 || sget(state, m, S_VALID) == 0 {
        return 0
    }
    let ino: u64 = nget(state, dir, N_INO)
    if ino == 0 {
        return 0
    }
    // ext4 HAT `.` UND `..` ALS ECHTE EINTRAEGE -- anders als die
    // Wurzel eines FAT32. Sie muessen hier also nicht erfunden werden;
    // `dir_walk` liefert sie als Eintrag 1 und 2 mit.
    let gefunden: u64 = dir_walk(state, m, ino, index + 1, out)
    if gefunden == 0 {
        return 0
    }
    // Der Knoten fuer den gefundenen Eintrag. `readdir` gibt einen
    // KNOTEN zurueck, nicht eine Inodenummer.
    let iptr: u64 = inode_load(state, m, gefunden)
    if iptr == 0 {
        return 0
    }
    let k: u64 = node_get(state, m, gefunden, ino_size(iptr), ino_mode(iptr),
        ino_flags(iptr), ino_links(iptr))
    if k == 0 {
        // HIER STAND `return dir`, und das war falsch: der Knoten des
        // VERZEICHNISSES fuer einen Dateieintrag. Wer die Datei danach
        // oeffnete, bekam ein Verzeichnis und konnte sie nicht lesen.
        // Lieber gar keinen Eintrag als den falschen.
        return 0
    }
    return k
}

fn f_attr(state: u64, m: u64, node: u64, what: u64) -> u64 {
    let __f: u64 = enter(state)
    let __r: u64 = f_attr__inner(state, m, node, what)
    leave(state, __f)
    return __r
}

fn f_attr__inner(state: u64, m: u64, node: u64, what: u64) -> u64 {
    tick(state)
    if node == 0 {
        return 0
    }
    let mode: u64 = nget(state, node, N_MODE)
    if what == vfsops.A_TYPE {
        return art_von(mode)
    }
    if what == vfsops.A_SIZE {
        return nget(state, node, N_SIZE)
    }
    if what == vfsops.A_MODE {
        // Die unteren zwoelf Bit sind die Rechte -- und ext4 hat sie
        // WIRKLICH, anders als FAT32. Also werden sie durchgereicht
        // und nicht erfunden.
        return mode & 0xFFF
    }
    if what == vfsops.A_NLINK {
        return nget(state, node, N_LINKS)
    }
    if what == vfsops.A_BLKSIZE {
        return sget(state, m, S_BSIZE)
    }
    // A_UID/A_GID: ext4 HAT beide im Inode. Sie hier zu liefern waere
    // aber nur dann richtig, wenn die Benutzerkennungen des fremden
    // Systems dieselben waeren wie die von OrientOS -- und das sind
    // sie nicht. Ein Benutzer 1000 dort ist nicht Benutzer 1000 hier.
    // Null (= root) ist die ehrliche Antwort: das Dateisystem ist nur
    // lesend eingehaengt, und wer es einhaengen darf, darf es lesen.
    if what == vfsops.A_UID {
        return 0
    }
    if what == vfsops.A_GID {
        return 0
    }
    return 0
}

fn f_read(state: u64, m: u64, node: u64, off: u64, dst: u64,
    len: u64) -> u64 {
    let __f: u64 = enter(state)
    let __r: u64 = f_read__inner(state, m, node, off, dst, len)
    leave(state, __f)
    return __r
}

fn f_read__inner(state: u64, m: u64, node: u64, off: u64, dst: u64,
    len: u64) -> u64 {
    tick(state)
    if node == 0 || sget(state, m, S_VALID) == 0 {
        return 0
    }
    let mode: u64 = nget(state, node, N_MODE)
    let art: u64 = art_von(mode)
    if art == vfsops.N_DIR {
        return 0
    }
    let groesse: u64 = nget(state, node, N_SIZE)
    if off >= groesse {
        return 0
    }
    var want: u64 = len
    if off + want > groesse {
        want = groesse - off
    }
    let ino: u64 = nget(state, node, N_INO)
    let iptr: u64 = inode_load(state, m, ino)
    if iptr == 0 {
        return 0
    }

    // DER KURZE SYMBOLISCHE VERWEIS. Ist das Ziel kuerzer als 60
    // Oktette, steht es UNMITTELBAR in i_block -- es gibt keinen
    // Datenblock, und ein Leser, der einen sucht, findet nichts.
    //
    // Die Bedingung ist die von Linux: Groesse < 60 UND keine Extents
    // gesetzt. (Ein Verweis MIT Extent-Merker hat sein Ziel in einem
    // Block, auch wenn es kurz ist.)
    if art == vfsops.N_LNK && groesse < 60 && (ino_flags(iptr) & 0x80000) == 0 {
        var i: u64 = 0
        while i < want {
            kstate.set8(dst + i, kstate.get8(iptr + 0x28 + off + i) as u8)
            i = i + 1
        }
        return want
    }

    let bs: u64 = sget(state, m, S_BSIZE)
    var fertig: u64 = 0
    while fertig < want {
        let pos: u64 = off + fertig
        let lblock: u64 = pos / bs
        let im_block: u64 = pos % bs
        var stueck: u64 = bs - im_block
        if stueck > want - fertig {
            stueck = want - fertig
        }
        let pblock: u64 = block_of(state, m, iptr, lblock, ino)
        if pblock == 0 {
            // EIN LOCH. Es liest sich als Nullen -- das ist keine
            // Notloesung, sondern das, was ein Loch IST: eine Datei
            // mit einer Luecke, fuer die nie ein Block belegt wurde.
            var i: u64 = 0
            while i < stueck {
                kstate.set8(dst + fertig + i, 0 as u8)
                i = i + 1
            }
        } else {
            if !block_read(state, m, pblock, buf(state, BLKBUF)) {
                return fertig
            }
            var i: u64 = 0
            while i < stueck {
                kstate.set8(dst + fertig + i,
                    kstate.get8(buf(state, BLKBUF) + im_block + i) as u8)
                i = i + 1
            }
        }
        fertig = fertig + stueck
    }
    return fertig
}

// ---------------------------------------------- was dieser Treiber NICHT tut
//
// Firn hat keinen Nullzeiger fuer `fn`, also traegt auch ein Treiber,
// der eine Verrichtung nicht anbietet, eine Funktion ein -- eine, die
// den Fehler zurueckgibt. `mask` sagt es VORHER (siehe `ops`), und
// `vfs.can` prueft das Bit, bevor der Zeiger ueberhaupt benutzt wird.
// Diese fuenf sind also das Fangnetz und nicht die Zusage.
fn f_write(state: u64, m: u64, node: u64, off: u64, src: u64,
    len: u64) -> u64 {
    return 0
}

fn f_create(state: u64, m: u64, path: u64, art: u64) -> u64 {
    return 0
}

fn f_unlink(state: u64, m: u64, path: u64) -> u64 {
    return 9
}

fn f_rename(state: u64, m: u64, from: u64, to: u64) -> u64 {
    return 9
}

fn f_trunc(state: u64, m: u64, node: u64) -> u64 {
    return 9
}

fn ops() -> vfsops.Ops {
    return vfsops.Ops {
        lookup: f_lookup,
        readdir: f_readdir,
        attr: f_attr,
        read: f_read,
        write: f_write,
        create: f_create,
        unlink: f_unlink,
        rename: f_rename,
        trunc: f_trunc,
        // NUR DIE VIER LESENDEN BITS. Das ist die Zusage dieser Runde,
        // und sie steht als Zahl da und nicht als Absicht: `vfs.can`
        // laesst ein `write` auf diesem Dateisystem gar nicht erst zum
        // Treiber durch, sondern antwortet -EPERM.
        mask: vfsops.OP_READONLY,
        tag: 875770213 // "ext4"
    }
}
