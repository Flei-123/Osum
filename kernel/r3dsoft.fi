// SPDX-License-Identifier: GPL-2.0-only
// kernel/r3dsoft.fi -- RUNDE GRAFIK-1, ETAPPE C: DREIECKE IN SOFTWARE.
//
// Das erste Backend hinter `r3d.fi`. Es rechnet alles mit dem
// Hauptprozessor: Eckpunkte umformen, Dreiecke fuellen, Tiefe pruefen,
// Textur abtasten, Licht anlegen. Es ist ehrlich klein -- kein
// Kantenglaetten, keine Verbundoperationen, keine
// Schattierungsprogramme -- und alles, was es kann, ist gemessen.
//
// WAS EIN RASTERER WIRKLICH TUT, in vier Schritten:
//
//   1. UMFORMEN. Jeder Eckpunkt geht durch Modell-, Ansichts- und
//      Projektionsmatrix. Danach liegt er im "Wuerfelraum": x und y
//      zwischen -1 und 1, z die Tiefe.
//   2. TEILEN. x und y werden durch die Tiefe geteilt -- das ist die
//      Perspektive, und es ist der einzige Schritt, der eine Teilung je
//      ECKPUNKT braucht (nicht je Bildpunkt; das waere der ganze
//      Messwert).
//   3. ABBILDEN. Aus -1..1 werden Bildpunktkoordinaten.
//   4. FUELLEN. Fuer jeden Bildpunkt im umschliessenden Rechteck: liegt
//      er im Dreieck? Ist er naeher als das, was schon da steht? Dann
//      Farbe hineinschreiben und Tiefe merken.
//
// DIE KANTENFUNKTION, UND WARUM SIE DIE GANZE INNERE SCHLEIFE IST.
//
// Ob ein Punkt in einem Dreieck liegt, laesst sich mit drei
// Kreuzprodukten entscheiden: fuer jede der drei Kanten sagt das
// Vorzeichen, auf welcher Seite der Punkt liegt. Sind alle drei
// Vorzeichen gleich, liegt er drin. Der Trick, der das bezahlbar macht:
// die Kantenfunktion ist LINEAR. Geht man einen Bildpunkt nach rechts,
// aendert sie sich um einen festen Betrag. Also wird sie EINMAL je Zeile
// ausgerechnet und dann nur noch addiert -- keine Multiplikation je
// Bildpunkt, keine Teilung.
//
// Dieselben drei Zahlen sind, auf ihre Summe normiert, die
// baryzentrischen Gewichte -- damit werden Tiefe, Textur und Farbe
// zwischen den Ecken verteilt. Ein Wert, drei Verwendungen.
//
// -------------------------------------------------------------------
// WO DER SPEICHER HERKOMMT, UND WARUM DAS DIE ENGSTE STELLE IST.
//
// Ein Tiefenpuffer fuer 2560x1440 mit vier Oktetten je Bildpunkt sind
// 14,7 MiB. Das ist mehr, als in `kdata` passt, und es ist mehr, als
// eine Halde beilaeufig hergibt. Also wird er mit `mem.frame_run`
// zusammenhaengend angefordert -- und wenn das nicht geht, gibt `start`
// FALSCH zurueck und der Aufrufer weiss es. Ein Rasterer, der bei
// Speichermangel in fremden Speicher schreibt, ist schlimmer als einer,
// der nicht startet.

profile kernel

import kstate
import mem
import serial

export {
    start, end, aktiv, clear, matrix, licht, textur, dreieck,
    dreiecke, punkte, bildpunkte, name, sin_fx, last_brightness,
    einheitsmatrix, mat_mul, proj_set, dreh_x, dreh_y, verschieben,
    selbsttest
}

// ---------------------------------------------------- der Zustand
//
// Er liegt in einer eigenen Seite von `kdata`. Die Adressen der Puffer
// selbst stehen darin; die Puffer liegen im Arbeitsspeicher.
//
// RUNDE GRAFIK-1: 0xAC000, VIER SEITEN, UND ZWAR NICHT 0x3D000.
//
// Die erste Fassung nahm 0x3D000 mit der Begruendung "die naechste
// freie Seite hinter dem Bildspeicher-Block". Das war FALSCH: dort
// liegt seit Runde K10/K11 der Fensterserver (`kstate.K11_OFF`). Der
// Rasterer hat dessen Zustand ueberschrieben und umgekehrt -- der
// Wuerfel wurde gezeichnet, `gemalt` zaehlte 111 Millionen Bildpunkte,
// und auf dem Schirm stand trotzdem nichts, weil `S_AKTIV`, `S_ZIEL`
// und die Matrizen zwischendurch von fremder Hand beschrieben wurden.
//
// GENAU DIESER FEHLER IST IN DIESEM PROJEKT SCHON VIERMAL PASSIERT --
// er steht viermal als Kommentar in `kstate.fi`, und `tools/kernel/
// memmap.py` ist eigens dafuer gebaut worden. Der Kartenpruefer meldete
// null Kollisionen, weil der neue Bereich bei ihm nicht EINGETRAGEN
// war; er kann nur pruefen, was er kennt. Der Eintrag steht jetzt dort.
//
// 0xAC000..0xB0000 sind sechzehn KiB am oberen Ende und laut Karte der
// groesste freie Block. Vier Seiten, weil dieser Bereich auch die
// Eckpunkt- und Texturzeiger von `r3dtest.fi` traegt.
const R3D_OFF: u64 = 0xAC000
const R3D_MAX: u64 = 16384

const S_AKTIV: u64 = 0x000
const S_TARGET: u64 = 0x008 // wohin die Farbe geht
const S_W: u64 = 0x010
const S_H: u64 = 0x018
const S_PITCH: u64 = 0x020 // Oktette je Zeile im Farbziel
const S_TIEFE: u64 = 0x028 // der Tiefenpuffer
const S_TIEFE_N: u64 = 0x030 // wie viele Rahmen er belegt
const S_TEX: u64 = 0x038
const S_TEXW: u64 = 0x040
const S_TEXH: u64 = 0x048
const S_TEXMW: u64 = 0x050 // Maske = w-1
const S_TEXMH: u64 = 0x058
const S_LX: u64 = 0x060 // Lichtrichtung, 16.16, normiert
const S_LY: u64 = 0x068
const S_LZ: u64 = 0x070
const S_LSTAERKE: u64 = 0x078
const S_LGRUND: u64 = 0x080
const S_DREIECKE: u64 = 0x088
const S_PUNKTE: u64 = 0x090
const S_BILDPUNKTE: u64 = 0x098
const S_SIN: u64 = 0x0A0 // die Sinustabelle, 1024 Woerter
const S_SIN_N: u64 = 0x0A8 // Rahmen der Tabelle
const S_TEX_OWN: u64 = 0x0B0 // 1 = Textur selbst angelegt, muss frei
const S_TEX_N: u64 = 0x0B8
const S_LETZTHELL: u64 = 0x0C0

// Die drei Matrizen liegen im Zustand selbst: 3 * 16 Woerter = 384
// Oktette, ab 0x100. Danach ist die Seite noch lange nicht voll.
const S_MAT: u64 = 0x100
const MAT_WORTE: u64 = 16
const MAT_OKTETTE: u64 = 128

const FIX_SHIFT: u64 = 16
const FIX_ONE: u64 = 65536
const SIN_N: u64 = 1024

const M_MODELL: u64 = 0
const M_ANSICHT: u64 = 1
const M_PROJ: u64 = 2

// Der groesste Tiefenwert -- "unendlich weit weg".
const TIEFE_FERN: u64 = 0x7FFFFFFFFFFFFFFF

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, R3D_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, R3D_OFF + off, v)
}

fn name() {
    var n: [u8; 24] = "software (r3dsoft.fi)\0\0\0"
    serial.puts((&n[0]) as u64)
}

fn aktiv(state: u64) -> bool {
    return g(state, S_AKTIV) != 0
}

// ---------------------------------------------------- Festkomma
//
// Dieselben zwei Rechnungen wie in `r3d.fi`. Sie stehen hier NOCH
// EINMAL und nicht als Aufruf dorthin, weil `r3d.fi` dieses Modul
// einbindet -- der umgekehrte Weg waere ein Kreis, und Firn nimmt
// keinen. Zwanzig Zeilen benannte Doppelung gegen einen Kreis, den es
// sonst nicht mehr aufzuloesen gaebe; derselbe Handel, den `fb.fi` in
// seinem Kopf beschreibt.

fn fx_mul(a: u64, b: u64) -> u64 {
    let na: bool = (a >> 63) != 0
    let nb: bool = (b >> 63) != 0
    var ua: u64 = a
    var ub: u64 = b
    if na {
        ua = 0 -% a
    }
    if nb {
        ub = 0 -% b
    }
    let p: u64 = (ua *% ub) >> FIX_SHIFT
    if na != nb {
        return 0 -% p
    }
    return p
}

fn fx_div(a: u64, b: u64) -> u64 {
    if b == 0 {
        return 0
    }
    let na: bool = (a >> 63) != 0
    let nb: bool = (b >> 63) != 0
    var ua: u64 = a
    var ub: u64 = b
    if na {
        ua = 0 -% a
    }
    if nb {
        ub = 0 -% b
    }
    if ub == 0 {
        return 0
    }
    let q: u64 = (ua << FIX_SHIFT) / ub
    if na != nb {
        return 0 -% q
    }
    return q
}

fn ist_neg(x: u64) -> bool {
    return (x >> 63) != 0
}

// Vorzeichenbehaftetes Kleiner. `<` auf u64 vergleicht Bitmuster; bei
// negativen Zahlen ist das falsch herum.
fn slt(a: u64, b: u64) -> bool {
    let na: bool = ist_neg(a)
    let nb: bool = ist_neg(b)
    if na != nb {
        return na
    }
    return a < b
}

// -------------------------------------------------- die Sinustabelle
//
// Sie entsteht beim Start aus der Rekursion des Einheitskreises. Fuer
// jeden der 1024 Schritte wird der Punkt (cos, sin) um einen Schritt
// weitergedreht:
//
//     x' = x*c - y*s
//     y' = x*s + y*c
//
// mit (c, s) der Drehung um EINEN Schritt. Damit sich der
// Rundungsfehler ueber 1024 Schritte nicht aufschaukelt, wird in 32.32
// gerechnet und erst am Ende auf 16.16 gekuerzt -- und die vier
// Viertelpunkte werden hart gesetzt, damit sin(0)=0, sin(90)=1 und die
// Vorzeichen exakt stimmen.
//
// Die Zahlen fuer einen Schritt (2*pi/1024) in 32.32:
//     cos = 0.99998117... * 2^32 = 4294959042
//     sin = 0.00613588... * 2^32 =   26353589
const SCHRITT_COS: u64 = 4294959042
const SCHRITT_SIN: u64 = 26353589

fn sin_tab_bauen(state: u64) {
    let t: u64 = g(state, S_SIN)
    if t == 0 {
        return
    }
    // In 32.32 rechnen: x = 1.0, y = 0.0
    var x: u64 = 1 << 32
    var y: u64 = 0
    var i: u64 = 0
    while i < SIN_N {
        // sin(i) ist y, gekuerzt von 32.32 auf 16.16
        var w: u64 = 0
        if ist_neg(y) {
            w = 0 -% ((0 -% y) >> 16)
        } else {
            w = y >> 16
        }
        kstate.set(t, i * 8, w)
        // einen Schritt weiterdrehen, in 32.32
        let nx: u64 = mul3232(x, SCHRITT_COS) -% mul3232(y, SCHRITT_SIN)
        let ny: u64 = mul3232(x, SCHRITT_SIN) +% mul3232(y, SCHRITT_COS)
        x = nx
        y = ny
        i = i + 1
    }
    // Die vier Viertelpunkte exakt. Ohne sie waere sin(90 Grad)
    // vielleicht 65535 statt 65536, und ein Wuerfel haette nach einer
    // Vierteldrehung eine schiefe Kante.
    kstate.set(t, 0, 0)
    kstate.set(t, 256 * 8, FIX_ONE)
    kstate.set(t, 512 * 8, 0)
    kstate.set(t, 768 * 8, 0 -% FIX_ONE)
}

// Multiplikation zweier 32.32-Zahlen mit Vorzeichen. Das volle Produkt
// haette 128 Bit; gebraucht wird die Mitte. Die Zahlen hier sind
// betragsmaessig <= 1, also passt (|a| >> 16) * (|b| >> 16) in 64 Bit.
fn mul3232(a: u64, b: u64) -> u64 {
    let na: bool = ist_neg(a)
    let nb: bool = ist_neg(b)
    var ua: u64 = a
    var ub: u64 = b
    if na {
        ua = 0 -% a
    }
    if nb {
        ub = 0 -% b
    }
    let p: u64 = (ua >> 16) *% (ub >> 16)
    if na != nb {
        return 0 -% p
    }
    return p
}

fn sin_fx(state: u64, schritt: u64) -> u64 {
    let t: u64 = g(state, S_SIN)
    if t == 0 {
        return 0
    }
    return kstate.get(t, (schritt & (SIN_N - 1)) * 8)
}

// ------------------------------------------------------- Matrizen
//
// Zeilenweise, 16 Zahlen in 16.16. Ein Punkt ist eine Zeile, die von
// rechts multipliziert wird -- dieselbe Ordnung, die auch OpenGL
// benutzt, damit die Formeln aus jedem Lehrbuch ohne Umdrehen passen.

fn mat_at(state: u64, art: u64) -> u64 {
    return state + R3D_OFF + S_MAT + art * MAT_OKTETTE
}

fn mget(m: u64, r: u64, c: u64) -> u64 {
    return kstate.get(m, (r * 4 + c) * 8)
}

fn mset(m: u64, r: u64, c: u64, v: u64) {
    kstate.set(m, (r * 4 + c) * 8, v)
}

fn einheitsmatrix(m: u64) {
    var r: u64 = 0
    while r < 4 {
        var c: u64 = 0
        while c < 4 {
            if r == c {
                mset(m, r, c, FIX_ONE)
            } else {
                mset(m, r, c, 0)
            }
            c = c + 1
        }
        r = r + 1
    }
}

// c = a * b. `ziel` darf NICHT auf `a` oder `b` zeigen.
fn mat_mul(ziel: u64, a: u64, b: u64) {
    var r: u64 = 0
    while r < 4 {
        var c: u64 = 0
        while c < 4 {
            var sum: u64 = 0
            var k: u64 = 0
            while k < 4 {
                sum = sum +% fx_mul(mget(a, r, k), mget(b, k, c))
                k = k + 1
            }
            mset(ziel, r, c, sum)
            c = c + 1
        }
        r = r + 1
    }
}

fn dreh_x(m: u64, sinw: u64, cosw: u64) {
    einheitsmatrix(m)
    mset(m, 1, 1, cosw)
    mset(m, 1, 2, 0 -% sinw)
    mset(m, 2, 1, sinw)
    mset(m, 2, 2, cosw)
}

// DIE VORZEICHEN GEHOEREN ZUR ZEILENVEKTOR-ORDNUNG, und sie waren
// beim ersten Versuch vertauscht. Ein Punkt ist hier eine ZEILE, die
// von rechts multipliziert wird (`punkt_mal_matrix` summiert ueber
// p[r] * m[r][c]) -- dafuer lautet die Y-Drehung
//
//     [  cos  0  -sin ]
//     [   0   1    0  ]
//     [  sin  0   cos ]
//
// und nicht die transponierte Fassung, die in Buechern steht, die mit
// Spaltenvektoren rechnen. Mit den vertauschten Vorzeichen drehte der
// Wuerfel in die falsche Richtung -- was man einem sich drehenden
// Wuerfel NICHT ansieht, weil er ja trotzdem dreht. Aufgefallen ist es
// nur, weil `selbsttest` Zusage 10 nachrechnet: eine Vierteldrehung um
// Y bringt (1,0,0) nach (0,0,-1). Die Messung meldete +1.
fn dreh_y(m: u64, sinw: u64, cosw: u64) {
    einheitsmatrix(m)
    mset(m, 0, 0, cosw)
    mset(m, 0, 2, 0 -% sinw)
    mset(m, 2, 0, sinw)
    mset(m, 2, 2, cosw)
}

fn verschieben(m: u64, tx: u64, ty: u64, tz: u64) {
    einheitsmatrix(m)
    mset(m, 3, 0, tx)
    mset(m, 3, 1, ty)
    mset(m, 3, 2, tz)
}

// Eine Projektionsmatrix. `f` ist der Brennweitenfaktor in 16.16
// (1.0 entspricht etwa 90 Grad Blickwinkel), `ar` das
// Seitenverhaeltnis (Breite/Hoehe) in 16.16. Nah- und Fernebene
// bestimmen, wie die Tiefe verteilt wird.
fn proj_set(m: u64, f: u64, ar: u64, nah: u64, fern: u64) {
    einheitsmatrix(m)
    mset(m, 0, 0, fx_div(f, ar))
    mset(m, 1, 1, f)
    if fern != nah {
        mset(m, 2, 2, fx_div(fern, fern -% nah))
        mset(m, 3, 2, fx_div(0 -% fx_mul(fern, nah), fern -% nah))
    }
    mset(m, 2, 3, FIX_ONE)
    mset(m, 3, 3, 0)
}

// ------------------------------------------------------- der Aufbau

fn start(state: u64, ziel: u64, w: u64, h: u64, pitch: u64) -> bool {
    if ziel == 0 || w == 0 || h == 0 {
        return false
    }
    if pitch < w * 4 {
        return false
    }
    // Der Tiefenpuffer: acht Oktette je Bildpunkt (ein Wort, damit die
    // Tiefe dieselbe Breite hat wie alles andere und kein Kuerzen noetig
    // ist). Zusammenhaengend, weil er als flaches Feld gelesen wird.
    let n: u64 = w * h * 8
    let rahmen: u64 = (n + 4095) / 4096
    let t: u64 = mem.frame_run(state, rahmen)
    if t == 0 {
        return false
    }
    // Die Sinustabelle: 1024 Woerter = 8 KiB = zwei Rahmen.
    var st: u64 = g(state, S_SIN)
    if st == 0 {
        let sr: u64 = mem.frame_run(state, 2)
        if sr == 0 {
            mem.frame_free_run(state, t, rahmen)
            return false
        }
        s(state, S_SIN, sr)
        s(state, S_SIN_N, 2)
        sin_tab_bauen(state)
    }
    s(state, S_TARGET, ziel)
    s(state, S_W, w)
    s(state, S_H, h)
    s(state, S_PITCH, pitch)
    s(state, S_TIEFE, t)
    s(state, S_TIEFE_N, rahmen)
    s(state, S_DREIECKE, 0)
    s(state, S_PUNKTE, 0)
    s(state, S_BILDPUNKTE, 0)
    s(state, S_TEX, 0)
    s(state, S_TEX_OWN, 0)
    // Licht: von vorn oben, damit ohne eigenes `licht` etwas zu sehen
    // ist statt einer schwarzen Flaeche.
    s(state, S_LX, 0)
    s(state, S_LY, 0)
    s(state, S_LZ, 0 -% FIX_ONE)
    s(state, S_LSTAERKE, FIX_ONE)
    s(state, S_LGRUND, FIX_ONE / 4)
    einheitsmatrix(mat_at(state, M_MODELL))
    einheitsmatrix(mat_at(state, M_ANSICHT))
    einheitsmatrix(mat_at(state, M_PROJ))
    s(state, S_AKTIV, 1)
    return true
}

fn end(state: u64) {
    if !aktiv(state) {
        return
    }
    let t: u64 = g(state, S_TIEFE)
    if t != 0 {
        mem.frame_free_run(state, t, g(state, S_TIEFE_N))
    }
    s(state, S_TIEFE, 0)
    let tx: u64 = g(state, S_TEX)
    if tx != 0 && g(state, S_TEX_OWN) != 0 {
        mem.frame_free_run(state, tx, g(state, S_TEX_N))
    }
    s(state, S_TEX, 0)
    s(state, S_TEX_OWN, 0)
    s(state, S_AKTIV, 0)
}

fn clear(state: u64, farbe: u64) {
    if !aktiv(state) {
        return
    }
    let w: u64 = g(state, S_W)
    let h: u64 = g(state, S_H)
    let ziel: u64 = g(state, S_TARGET)
    let pitch: u64 = g(state, S_PITCH)
    let tiefe: u64 = g(state, S_TIEFE)
    var y: u64 = 0
    while y < h {
        let zeile: u64 = ziel +% y *% pitch
        var x: u64 = 0
        while x < w {
            __mmio_write32((zeile +% x *% 4) as *mut u32, farbe as u32)
            x = x + 1
        }
        let tz: u64 = tiefe +% y *% w *% 8
        x = 0
        while x < w {
            kstate.set(tz, x * 8, TIEFE_FERN)
            x = x + 1
        }
        y = y + 1
    }
}

fn matrix(state: u64, art: u64, m: u64) {
    if art > M_PROJ {
        return
    }
    let z: u64 = mat_at(state, art)
    var i: u64 = 0
    while i < MAT_WORTE {
        kstate.set(z, i * 8, kstate.get(m, i * 8))
        i = i + 1
    }
}

fn licht(state: u64, rx: u64, ry: u64, rz: u64, staerke: u64, grund: u64) {
    // Die Richtung wird normiert, damit die Helligkeit nicht von der
    // Laenge des Vektors abhaengt. Wurzel in Festkomma: Newton, fuenf
    // Schritte -- das genuegt fuer eine Richtung.
    let q: u64 = fx_mul(rx, rx) +% fx_mul(ry, ry) +% fx_mul(rz, rz)
    let l: u64 = root_fx(q)
    if l == 0 {
        return
    }
    s(state, S_LX, fx_div(rx, l))
    s(state, S_LY, fx_div(ry, l))
    s(state, S_LZ, fx_div(rz, l))
    s(state, S_LSTAERKE, staerke)
    s(state, S_LGRUND, grund)
}

// Quadratwurzel einer 16.16-Zahl, ohne Gleitkomma. Newton mit fester
// Schrittzahl statt einer Schleife bis zur Genauigkeit: eine Schleife,
// die je nach Eingabe verschieden lange laeuft, ist in einem Kern eine
// Zeitbombe.
fn root_fx(x: u64) -> u64 {
    if x == 0 {
        return 0
    }
    if ist_neg(x) {
        return 0
    }
    // Startwert: die halbe Bitlaenge ist eine gute erste Naeherung.
    var r: u64 = x
    if r < FIX_ONE {
        r = FIX_ONE
    }
    var i: u64 = 0
    while i < 8 {
        if r == 0 {
            return 0
        }
        r = (r +% fx_div(x, r)) >> 1
        i = i + 1
    }
    return r
}

fn textur(state: u64, daten: u64, w: u64, h: u64) -> bool {
    if daten == 0 || w == 0 || h == 0 {
        return false
    }
    // Zweierpotenzen, damit das Umschlagen eine Maskierung ist.
    if (w & (w - 1)) != 0 {
        return false
    }
    if (h & (h - 1)) != 0 {
        return false
    }
    s(state, S_TEX, daten)
    s(state, S_TEXW, w)
    s(state, S_TEXH, h)
    s(state, S_TEXMW, w - 1)
    s(state, S_TEXMH, h - 1)
    return true
}

// ------------------------------------------------- ein Eckpunkt
//
// Ein Eckpunkt kommt als neun Woerter: x y z u v r g b (und ein
// Fuellwort). Nach der Umformung stehen Bildpunktlage, Tiefe und die
// unveraenderten Zusatzwerte in einem Zwischenfeld.

const V_WORTE: u64 = 9
const V_X: u64 = 0
const V_Y: u64 = 1
const V_Z: u64 = 2
const V_U: u64 = 3
const V_V: u64 = 4
const V_R: u64 = 5
const V_G: u64 = 6
const V_B: u64 = 7

// Einen Punkt durch eine Matrix schieben. Der Punkt ist (x,y,z,1); das
// vierte Ergebnis (w) wird gebraucht, also gibt es vier Rueckgaben
// ueber ein Feld statt eines Rueckgabewerts.
fn point_draw_matrix(m: u64, x: u64, y: u64, z: u64, aus: u64) {
    var c: u64 = 0
    while c < 4 {
        var sum: u64 = fx_mul(x, mget(m, 0, c))
        sum = sum +% fx_mul(y, mget(m, 1, c))
        sum = sum +% fx_mul(z, mget(m, 2, c))
        sum = sum +% mget(m, 3, c)
        kstate.set(aus, c * 8, sum)
        c = c + 1
    }
}

// ---------------------------------------------------- das Dreieck

// Die Kantenfunktion: auf welcher Seite der Kante (ax,ay)->(bx,by)
// liegt (cx,cy)? Positiv, negativ oder null. Alle Werte sind ganze
// Bildpunkte mal 65536 -- also wird hier NICHT mit fx_mul gerechnet,
// sondern mit einer Schiebung, die dem Wertebereich angemessen ist.
fn edge(ax: u64, ay: u64, bx: u64, by: u64, cx: u64, cy: u64) -> u64 {
    let d1x: u64 = bx -% ax
    let d1y: u64 = by -% ay
    let d2x: u64 = cx -% ax
    let d2y: u64 = cy -% ay
    return fx_mul(d1x, d2y) -% fx_mul(d1y, d2x)
}

fn min3(a: u64, b: u64, c: u64) -> u64 {
    var m: u64 = a
    if slt(b, m) {
        m = b
    }
    if slt(c, m) {
        m = c
    }
    return m
}

fn max3(a: u64, b: u64, c: u64) -> u64 {
    var m: u64 = a
    if slt(m, b) {
        m = b
    }
    if slt(m, c) {
        m = c
    }
    return m
}

// EIN Dreieck. `p` zeigt auf 3 * V_WORTE Woerter.
fn dreieck(state: u64, p: u64) {
    if !aktiv(state) {
        return
    }
    kstate.set(state + R3D_OFF + S_DREIECKE, 0,
        g(state, S_DREIECKE) + 1)

    let w: u64 = g(state, S_W)
    let h: u64 = g(state, S_H)

    // 1. Modell * Ansicht * Projektion, EINMAL je Dreieck und nicht je
    //    Eckpunkt.
    var mv: [u64; 16] = [0 as u64; 16]
    var mvp: [u64; 16] = [0 as u64; 16]
    let pmv: u64 = (&mv[0]) as u64
    let pmvp: u64 = (&mvp[0]) as u64
    mat_mul(pmv, mat_at(state, M_MODELL), mat_at(state, M_ANSICHT))
    mat_mul(pmvp, pmv, mat_at(state, M_PROJ))

    // 2. Die drei Eckpunkte umformen.
    var sx: [u64; 3] = [0 as u64; 3]
    var sy: [u64; 3] = [0 as u64; 3]
    var sz: [u64; 3] = [0 as u64; 3]
    var siw: [u64; 3] = [0 as u64; 3] // 1/w, fuer die Verteilung
    var tmp: [u64; 4] = [0 as u64; 4]
    let ptmp: u64 = (&tmp[0]) as u64

    var i: u64 = 0
    while i < 3 {
        let v: u64 = p + i * V_WORTE * 8
        point_draw_matrix(pmvp, kstate.get(v, V_X * 8),
            kstate.get(v, V_Y * 8), kstate.get(v, V_Z * 8), ptmp)
        let cw: u64 = kstate.get(ptmp, 3 * 8)
        // Hinter der Kamera oder auf ihr: dieses Dreieck faellt weg.
        // Ein richtiger Rasterer wuerde hier BESCHNEIDEN (das Dreieck
        // an der Nahebene zerschneiden); das ist mehr Arbeit als diese
        // Runde rechtfertigt, und der Wuerfel braucht es nicht. Es
        // steht hier als Auslassung und nicht als Versehen.
        if ist_neg(cw) || cw < 256 {
            return
        }
        let cx: u64 = kstate.get(ptmp, 0)
        let cy: u64 = kstate.get(ptmp, 8)
        let cz: u64 = kstate.get(ptmp, 16)
        // Teilen durch w -- die Perspektive. Je Eckpunkt, nicht je
        // Bildpunkt.
        let ndx: u64 = fx_div(cx, cw)
        let ndy: u64 = fx_div(cy, cw)
        // Auf Bildpunkte abbilden. y zeigt auf dem Schirm nach unten.
        kstate.set((&sx[0]) as u64, i * 8,
            fx_mul(ndx +% FIX_ONE, (w << FIX_SHIFT) / 2))
        kstate.set((&sy[0]) as u64, i * 8,
            fx_mul(FIX_ONE -% ndy, (h << FIX_SHIFT) / 2))
        kstate.set((&sz[0]) as u64, i * 8, fx_div(cz, cw))
        kstate.set((&siw[0]) as u64, i * 8, fx_div(FIX_ONE, cw))
        i = i + 1
    }

    let ax: u64 = kstate.get((&sx[0]) as u64, 0)
    let ay: u64 = kstate.get((&sy[0]) as u64, 0)
    let bx: u64 = kstate.get((&sx[0]) as u64, 8)
    let by: u64 = kstate.get((&sy[0]) as u64, 8)
    let ccx: u64 = kstate.get((&sx[0]) as u64, 16)
    let ccy: u64 = kstate.get((&sy[0]) as u64, 16)

    // 3. Die Flaeche. Ihr Vorzeichen sagt, ob das Dreieck uns zugewandt
    //    ist -- eine abgewandte Rueckseite wird weggelassen. Das ist
    //    kein Sparen um des Sparens willen: ohne diesen Test malt ein
    //    geschlossener Koerper seine Rueckwand ueber die Vorderwand,
    //    sobald der Tiefentest einmal gleich ausgeht.
    let flaeche: u64 = edge(ax, ay, bx, by, ccx, ccy)
    if ist_neg(flaeche) || flaeche == 0 {
        return
    }

    // 4. Das umschliessende Rechteck, auf den Schirm beschnitten.
    var x0: u64 = fx_to_int_s(min3(ax, bx, ccx))
    var y0: u64 = fx_to_int_s(min3(ay, by, ccy))
    var x1: u64 = fx_to_int_s(max3(ax, bx, ccx)) + 1
    var y1: u64 = fx_to_int_s(max3(ay, by, ccy)) + 1
    if ist_neg(x0) {
        x0 = 0
    }
    if ist_neg(y0) {
        y0 = 0
    }
    if ist_neg(x1) {
        return
    }
    if ist_neg(y1) {
        return
    }
    if x1 > w {
        x1 = w
    }
    if y1 > h {
        y1 = h
    }
    if x0 >= x1 || y0 >= y1 {
        return
    }

    // 5. Die Beleuchtung. EINE Zahl je Dreieck (flache Schattierung):
    //    die Normale steht senkrecht auf der Flaeche, und wie stark sie
    //    zum Licht zeigt, ist das Skalarprodukt. Eine Schattierung je
    //    Eckpunkt waere schoener und kostet drei Normalen je Dreieck --
    //    das ist eine Runde fuer sich.
    let hell: u64 = helligkeit(state, p)
    s(state, S_LETZTHELL, hell)

    // 6. Fuellen. Die Kantenfunktionen werden EINMAL fuer die linke
    //    obere Ecke ausgerechnet und danach nur noch addiert -- das ist
    //    der Grund, warum hier keine Multiplikation je Bildpunkt steht.
    let px0: u64 = fx_from_int_s(x0) +% (FIX_ONE / 2)
    let py0: u64 = fx_from_int_s(y0) +% (FIX_ONE / 2)

    // Die Schrittweiten je Bildpunkt nach rechts und nach unten.
    let e0dx: u64 = ay -% by
    let e0dy: u64 = bx -% ax
    let e1dx: u64 = by -% ccy
    let e1dy: u64 = ccx -% bx
    let e2dx: u64 = ccy -% ay
    let e2dy: u64 = ax -% ccx

    var e0z: u64 = edge(ax, ay, bx, by, px0, py0)
    var e1z: u64 = edge(bx, by, ccx, ccy, px0, py0)
    var e2z: u64 = edge(ccx, ccy, ax, ay, px0, py0)

    let ziel: u64 = g(state, S_TARGET)
    let pitch: u64 = g(state, S_PITCH)
    let tiefe: u64 = g(state, S_TIEFE)
    // DIE GEWICHTE ENTSTEHEN DURCH TEILEN UND NICHT DURCH EINEN
    // KEHRWERT, und das ist der Unterschied zwischen einem Bild und
    // einem Fleck.
    //
    // Die erste Fassung rechnete `inv_f = fx_div(FIX_ONE, flaeche)` und
    // danach je Bildpunkt `l = (e * inv_f) >> 16`. Ein Kehrwert in
    // 16.16 hat aber nur sechzehn Nachkommabits, und `flaeche` ist bei
    // einem bildschirmfuellenden Dreieck GROSS: bei 100000 Bildpunkten
    // Flaeche wird `inv_f` zu NULL, und mit ihm alle drei Gewichte.
    // Dann tastet jeder Bildpunkt denselben Texel (0,0) ab -- auf dem
    // Foto war das eine gleichmaessig graue Flaeche in der Farbe der
    // Gitterlinie, und die Messung "vier Farben" hat es aufgedeckt.
    //
    // Statt dessen wird je Bildpunkt GETEILT: `l = (e << 16) / flaeche`.
    // Das ist eine Division je Bildpunkt und je Gewicht, also drei --
    // teuer, aber richtig. Wer sie sparen will, muss die Flaeche vorher
    // herunterskalieren und dabei aufpassen, dass sie nicht null wird;
    // das ist eine Runde fuer sich und keine Zeile.
    let flaeche_t: u64 = flaeche

    let z0: u64 = kstate.get((&sz[0]) as u64, 0)
    let z1v: u64 = kstate.get((&sz[0]) as u64, 8)
    let z2v: u64 = kstate.get((&sz[0]) as u64, 16)

    // ================================================================
    // DIE INNERE SCHLEIFE, VON HAND AUSGESCHRIEBEN.
    //
    // WARUM DAS SEIN MUSS, und es ist gemessen und nicht vermutet:
    // FIRN INLINET NICHT. Im erzeugten Assembler steht fuer jedes
    // `fx_mul` ein echtes `call` -- nachgezaehlt mit
    // `firnc --emit=asm --opt-level=release-fast`, sechzehn Aufrufe von
    // `fx_mul` und fuenf von `fx_div` allein in `dreieck`, dazu je
    // Bildpunkt noch `farbe_an` mit bis zu zwoelf weiteren.
    //
    // Die erste Fassung dieser Schleife hat deshalb 225 ns JE
    // BILDPUNKT gebraucht (1280x720, 0,45 Bilder je Sekunde). Ein
    // Aufruf mit Rahmenaufbau kostet ein Vielfaches der Rechnung, die
    // er ausfuehrt -- bei zwanzig Aufrufen je Bildpunkt ist der Aufruf
    // die ganze Messung und die Multiplikation Beiwerk.
    //
    // Also steht die Arithmetik hier AUSGESCHRIEBEN. Das ist haesslich
    // und es ist Doppelung zu `fx_mul` -- aber es ist die Doppelung, um
    // die es in einer inneren Schleife geht, und sie steht an genau
    // EINER Stelle. Die lesbare Fassung bleibt als `fx_mul` erhalten
    // und wird ueberall sonst benutzt.
    //
    // DIE VORZEICHENBEHANDLUNG WIRD DABEI EINFACHER, nicht schwerer:
    // innerhalb des Dreiecks sind e0, e1 und e2 nicht negativ (das ist
    // gerade die Bedingung, unter der wir hier stehen), und `inv_f` ist
    // positiv, weil `flaeche` positiv ist. Also brauchen die
    // baryzentrischen Gewichte GAR KEINE Vorzeichenpruefung -- eine
    // einfache Multiplikation mit Schiebung genuegt. Nur die Tiefen
    // koennen negativ sein; dort steht die arithmetische Schiebung.
    var gemalt: u64 = 0
    let tex: u64 = g(state, S_TEX)
    let texw: u64 = g(state, S_TEXW)
    let texh: u64 = g(state, S_TEXH)
    let texmw: u64 = g(state, S_TEXMW)
    let texmh: u64 = g(state, S_TEXMH)
    // Die Texturkoordinaten der drei Ecken, EINMAL geholt statt je
    // Bildpunkt aus dem Speicher gelesen.
    let v0p: u64 = p
    let v1p: u64 = p + V_WORTE * 8
    let v2p: u64 = p + 2 * V_WORTE * 8
    let u0: u64 = kstate.get(v0p, V_U * 8)
    let u1: u64 = kstate.get(v1p, V_U * 8)
    let u2: u64 = kstate.get(v2p, V_U * 8)
    let tv0: u64 = kstate.get(v0p, V_V * 8)
    let tv1: u64 = kstate.get(v1p, V_V * 8)
    let tv2: u64 = kstate.get(v2p, V_V * 8)
    let r0: u64 = kstate.get(v0p, V_R * 8)
    let r1: u64 = kstate.get(v1p, V_R * 8)
    let r2: u64 = kstate.get(v2p, V_R * 8)
    let g0: u64 = kstate.get(v0p, V_G * 8)
    let g1: u64 = kstate.get(v1p, V_G * 8)
    let g2: u64 = kstate.get(v2p, V_G * 8)
    let b0: u64 = kstate.get(v0p, V_B * 8)
    let b1: u64 = kstate.get(v1p, V_B * 8)
    let b2: u64 = kstate.get(v2p, V_B * 8)
    // Die Texturgroesse als Ganzzahl, damit die Umrechnung eine
    // Multiplikation und keine Festkommarechnung ist.
    let texwf: u64 = texw << FIX_SHIFT
    let texhf: u64 = texh << FIX_SHIFT

    var y: u64 = y0
    while y < y1 {
        var e0: u64 = e0z
        var e1: u64 = e1z
        var e2: u64 = e2z
        let zeile: u64 = ziel +% y *% pitch
        let tz: u64 = tiefe +% y *% w *% 8
        var x: u64 = x0
        while x < x1 {
            // Innen? Alle drei Kantenwerte nicht negativ. Ein einziges
            // Oder ueber die Vorzeichenbits statt dreier Vergleiche.
            if ((e0 | e1 | e2) >> 63) == 0 {
                // Baryzentrisch. Alle Werte nicht negativ, siehe oben:
                // keine Verzweigung noetig.
                let l0: u64 = (e1 << FIX_SHIFT) / flaeche_t
                let l1: u64 = (e2 << FIX_SHIFT) / flaeche_t
                let l2: u64 = (e0 << FIX_SHIFT) / flaeche_t
                // Tiefe verteilen. Die z-Werte KOENNEN negativ sein,
                // also arithmetisch schieben -- ausgeschrieben, damit
                // kein Aufruf entsteht.
                var zz: u64 = 0
                if (z0 >> 63) != 0 {
                    zz = zz -% (((0 -% z0) *% l0) >> FIX_SHIFT)
                } else {
                    zz = zz +% ((z0 *% l0) >> FIX_SHIFT)
                }
                if (z1v >> 63) != 0 {
                    zz = zz -% (((0 -% z1v) *% l1) >> FIX_SHIFT)
                } else {
                    zz = zz +% ((z1v *% l1) >> FIX_SHIFT)
                }
                if (z2v >> 63) != 0 {
                    zz = zz -% (((0 -% z2v) *% l2) >> FIX_SHIFT)
                } else {
                    zz = zz +% ((z2v *% l2) >> FIX_SHIFT)
                }
                let alt: u64 = __mmio_read64((tz +% x *% 8) as *mut u64)
                // Vorzeichenbehafteter Vergleich, ausgeschrieben.
                var naeher: bool = false
                let nz: u64 = zz >> 63
                let na: u64 = alt >> 63
                if nz != na {
                    naeher = nz != 0
                } else {
                    naeher = zz < alt
                }
                if naeher {
                    __mmio_write64((tz +% x *% 8) as *mut u64, zz)
                    // ---- die Farbe, ebenfalls ausgeschrieben ----
                    var cr: u64 = 0
                    var cg: u64 = 0
                    var cb: u64 = 0
                    if tex != 0 {
                        // Texturkoordinaten verteilen. u und v liegen
                        // zwischen 0 und 1, die Gewichte auch -- alles
                        // nicht negativ, also ohne Verzweigung.
                        let uu: u64 = ((u0 *% l0) >> FIX_SHIFT) +% ((u1 *% l1) >> FIX_SHIFT) +% ((u2 *% l2) >> FIX_SHIFT)
                        let vv: u64 = ((tv0 *% l0) >> FIX_SHIFT) +% ((tv1 *% l1) >> FIX_SHIFT) +% ((tv2 *% l2) >> FIX_SHIFT)
                        let tu: u64 = ((uu *% texwf) >> (FIX_SHIFT * 2))
                            & texmw
                        let tvv: u64 = ((vv *% texhf) >> (FIX_SHIFT * 2))
                            & texmh
                        let px: u64 = __mmio_read32(
                            (tex +% (tvv *% texw +% tu) *% 4) as *mut u32) as u64
                        cr = (px >> 16) & 255
                        cg = (px >> 8) & 255
                        cb = px & 255
                    } else {
                        cr = (((r0 *% l0) >> FIX_SHIFT) +% ((r1 *% l1) >> FIX_SHIFT) +% ((r2 *% l2) >> FIX_SHIFT)) >> FIX_SHIFT
                        cg = (((g0 *% l0) >> FIX_SHIFT) +% ((g1 *% l1) >> FIX_SHIFT) +% ((g2 *% l2) >> FIX_SHIFT)) >> FIX_SHIFT
                        cb = (((b0 *% l0) >> FIX_SHIFT) +% ((b1 *% l1) >> FIX_SHIFT) +% ((b2 *% l2) >> FIX_SHIFT)) >> FIX_SHIFT
                    }
                    // Licht. `hell` liegt zwischen 0 und FIX_ONE.
                    cr = (cr *% hell) >> FIX_SHIFT
                    cg = (cg *% hell) >> FIX_SHIFT
                    cb = (cb *% hell) >> FIX_SHIFT
                    if cr > 255 {
                        cr = 255
                    }
                    if cg > 255 {
                        cg = 255
                    }
                    if cb > 255 {
                        cb = 255
                    }
                    __mmio_write32((zeile +% x *% 4) as *mut u32,
                        ((cr << 16) | (cg << 8) | cb) as u32)
                    gemalt = gemalt + 1
                }
            }
            e0 = e0 +% e0dx
            e1 = e1 +% e1dx
            e2 = e2 +% e2dx
            x = x + 1
        }
        e0z = e0z +% e0dy
        e1z = e1z +% e1dy
        e2z = e2z +% e2dy
        y = y + 1
    }
    s(state, S_BILDPUNKTE, g(state, S_BILDPUNKTE) + gemalt)
    s(state, S_PUNKTE, g(state, S_PUNKTE) + 3)
}

fn fx_from_int_s(n: u64) -> u64 {
    if ist_neg(n) {
        return 0 -% ((0 -% n) << FIX_SHIFT)
    }
    return n << FIX_SHIFT
}

fn fx_to_int_s(x: u64) -> u64 {
    if ist_neg(x) {
        return 0 -% ((0 -% x) >> FIX_SHIFT)
    }
    return x >> FIX_SHIFT
}

// Die Helligkeit eines Dreiecks: das Skalarprodukt aus Flaechennormale
// und Lichtrichtung, begrenzt auf 0..1, plus Grundanteil.
//
// DIE NORMALE MUSS IN DENSELBEN RAUM WIE DAS LICHT, und in der ersten
// Fassung tat sie das nicht. Sie wurde aus den MODELLKOORDINATEN
// gerechnet, das Licht steht aber im Weltraum -- also war die
// Beleuchtung von der Drehung des Wuerfels UNABHAENGIG. Eine Flaeche,
// die sich zum Licht dreht, wurde nicht heller; sie blieb, was sie war.
// Auf dem Bildschirmfoto sah man davon nichts als ein sehr dunkles
// Etwas, weil bei dieser Lichtrichtung die meisten Flaechen auf das
// Grundlicht zurueckfielen.
//
// Also wird die Normale mit der MODELLMATRIX gedreht, bevor das
// Skalarprodukt gebildet wird. Nur gedreht, nicht verschoben: eine
// Richtung hat keinen Ort, deshalb geht die vierte Zeile der Matrix
// (die Verschiebung) hier ausdruecklich NICHT ein.
fn helligkeit(state: u64, p: u64) -> u64 {
    let v0: u64 = p
    let v1: u64 = p + V_WORTE * 8
    let v2: u64 = p + 2 * V_WORTE * 8
    // Zwei Kantenvektoren im Modellraum.
    let ux: u64 = kstate.get(v1, V_X * 8) -% kstate.get(v0, V_X * 8)
    let uy: u64 = kstate.get(v1, V_Y * 8) -% kstate.get(v0, V_Y * 8)
    let uz: u64 = kstate.get(v1, V_Z * 8) -% kstate.get(v0, V_Z * 8)
    let vx: u64 = kstate.get(v2, V_X * 8) -% kstate.get(v0, V_X * 8)
    let vy: u64 = kstate.get(v2, V_Y * 8) -% kstate.get(v0, V_Y * 8)
    let vz: u64 = kstate.get(v2, V_Z * 8) -% kstate.get(v0, V_Z * 8)
    // Kreuzprodukt = Normale, noch im Modellraum.
    var nx: u64 = fx_mul(uy, vz) -% fx_mul(uz, vy)
    var ny: u64 = fx_mul(uz, vx) -% fx_mul(ux, vz)
    var nz: u64 = fx_mul(ux, vy) -% fx_mul(uy, vx)
    // In den Weltraum drehen -- nur der 3x3-Anteil der Modellmatrix.
    let mm: u64 = mat_at(state, M_MODELL)
    let wx: u64 = fx_mul(nx, mget(mm, 0, 0)) +% fx_mul(ny, mget(mm, 1, 0)) +% fx_mul(nz, mget(mm, 2, 0))
    let wy: u64 = fx_mul(nx, mget(mm, 0, 1)) +% fx_mul(ny, mget(mm, 1, 1)) +% fx_mul(nz, mget(mm, 2, 1))
    let wz: u64 = fx_mul(nx, mget(mm, 0, 2)) +% fx_mul(ny, mget(mm, 1, 2)) +% fx_mul(nz, mget(mm, 2, 2))
    nx = wx
    ny = wy
    nz = wz
    let q: u64 = fx_mul(nx, nx) +% fx_mul(ny, ny) +% fx_mul(nz, nz)
    let l: u64 = root_fx(q)
    if l == 0 {
        return g(state, S_LGRUND)
    }
    nx = fx_div(nx, l)
    ny = fx_div(ny, l)
    nz = fx_div(nz, l)
    // Das Licht ZEIGT in Richtung (lx,ly,lz); beleuchtet wird, was ihm
    // entgegensteht, also das negative Skalarprodukt.
    var d: u64 = 0 -% (fx_mul(nx, g(state, S_LX)) +% fx_mul(ny, g(state, S_LY)) +% fx_mul(nz, g(state, S_LZ)))
    if ist_neg(d) {
        d = 0
    }
    var hell: u64 = g(state, S_LGRUND) +% fx_mul(d, g(state, S_LSTAERKE))
    if hell > FIX_ONE {
        hell = FIX_ONE
    }
    return hell
}

// Die Farbe eines Bildpunkts: Textur (falls gebunden) mal Eckfarbe mal
// Helligkeit.
fn color_on(state: u64, p: u64, l0: u64, l1: u64, l2: u64,
    hell: u64) -> u64 {
    let v0: u64 = p
    let v1: u64 = p + V_WORTE * 8
    let v2: u64 = p + 2 * V_WORTE * 8
    var r: u64 = 0
    var gr: u64 = 0
    var b: u64 = 0
    let tex: u64 = g(state, S_TEX)
    if tex != 0 {
        // Texturkoordinaten verteilen. Ohne Perspektivkorrektur -- bei
        // einem Wuerfel, dessen Flaechen klein und flach zur Kamera
        // stehen, ist der Unterschied nicht zu sehen; bei einem langen
        // Boden waere er es sehr wohl. Steht hier als bekannte Grenze.
        let u: u64 = fx_mul(l0, kstate.get(v0, V_U * 8)) +% fx_mul(l1, kstate.get(v1, V_U * 8)) +% fx_mul(l2, kstate.get(v2, V_U * 8))
        let v: u64 = fx_mul(l0, kstate.get(v0, V_V * 8)) +% fx_mul(l1, kstate.get(v1, V_V * 8)) +% fx_mul(l2, kstate.get(v2, V_V * 8))
        let tw: u64 = g(state, S_TEXW)
        let th: u64 = g(state, S_TEXH)
        let tu: u64 = (fx_to_int_s(fx_mul(u, fx_from_int_s(tw))))
            & g(state, S_TEXMW)
        let tv: u64 = (fx_to_int_s(fx_mul(v, fx_from_int_s(th))))
            & g(state, S_TEXMH)
        let px: u64 = __mmio_read32((tex +% (tv *% tw +% tu) *% 4)
            as *mut u32) as u64
        r = (px >> 16) & 255
        gr = (px >> 8) & 255
        b = px & 255
    } else {
        r = fx_to_int_s(fx_mul(l0, kstate.get(v0, V_R * 8)) +% fx_mul(l1, kstate.get(v1, V_R * 8)) +% fx_mul(l2, kstate.get(v2, V_R * 8)))
        gr = fx_to_int_s(fx_mul(l0, kstate.get(v0, V_G * 8)) +% fx_mul(l1, kstate.get(v1, V_G * 8)) +% fx_mul(l2, kstate.get(v2, V_G * 8)))
        b = fx_to_int_s(fx_mul(l0, kstate.get(v0, V_B * 8)) +% fx_mul(l1, kstate.get(v1, V_B * 8)) +% fx_mul(l2, kstate.get(v2, V_B * 8)))
    }
    // Licht anlegen.
    r = (r *% hell) >> FIX_SHIFT
    gr = (gr *% hell) >> FIX_SHIFT
    b = (b *% hell) >> FIX_SHIFT
    if r > 255 {
        r = 255
    }
    if gr > 255 {
        gr = 255
    }
    if b > 255 {
        b = 255
    }
    return (r << 16) | (gr << 8) | b
}

fn dreiecke(state: u64) -> u64 {
    return g(state, S_DREIECKE)
}

fn punkte(state: u64) -> u64 {
    return g(state, S_PUNKTE)
}

fn bildpunkte(state: u64) -> u64 {
    return g(state, S_BILDPUNKTE)
}

// ------------------------------------------------------ der Selbsttest
//
// Was der Kern ueber seinen eigenen Rasterer PRUEFEN kann, ohne dass
// jemand ein Bild ansieht. Jede Zusage hat eine Gegenprobe -- eine
// Eigenschaft ohne Gegenprobe ist eine Behauptung.
//
// Rueckgabe: eine Bitmaske der NICHT bestandenen Zusagen. 0 = alles gut.
fn selbsttest(state: u64) -> u64 {
    var fehler: u64 = 0

    // 1. Festkomma: 2.0 * 3.0 = 6.0
    if fx_mul(2 * FIX_ONE, 3 * FIX_ONE) != 6 * FIX_ONE {
        fehler = fehler | 1
    }
    // 2. Vorzeichen: -2.0 * 3.0 = -6.0
    if fx_mul(0 -% (2 * FIX_ONE), 3 * FIX_ONE) != 0 -% (6 * FIX_ONE) {
        fehler = fehler | 2
    }
    // 3. Teilung: 6.0 / 3.0 = 2.0
    if fx_div(6 * FIX_ONE, 3 * FIX_ONE) != 2 * FIX_ONE {
        fehler = fehler | 4
    }
    // 4. Wurzel: sqrt(4.0) = 2.0, auf ein Tausendstel genau
    let wz: u64 = root_fx(4 * FIX_ONE)
    if wz > 2 * FIX_ONE + 64 || wz < 2 * FIX_ONE - 64 {
        fehler = fehler | 8
    }
    // 5. Sinustabelle: sin(0)=0, sin(90)=1, sin(180)=0, sin(270)=-1
    if g(state, S_SIN) != 0 {
        if sin_fx(state, 0) != 0 {
            fehler = fehler | 16
        }
        if sin_fx(state, 256) != FIX_ONE {
            fehler = fehler | 32
        }
        if sin_fx(state, 768) != 0 -% FIX_ONE {
            fehler = fehler | 64
        }
        // 6. sin(45 Grad) = 0.7071 -> 46341, auf ein Prozent genau
        let s45: u64 = sin_fx(state, 128)
        if s45 < 45800 || s45 > 46900 {
            fehler = fehler | 128
        }
    }
    // 7. Die Kantenfunktion: ein Punkt links einer aufwaerts laufenden
    //    Kante liegt auf der einen Seite, rechts auf der anderen.
    let e_a: u64 = edge(0, 0, 0, FIX_ONE, 0 -% FIX_ONE, 0)
    let e_b: u64 = edge(0, 0, 0, FIX_ONE, FIX_ONE, 0)
    if ist_neg(e_a) == ist_neg(e_b) {
        fehler = fehler | 256
    }
    // 8. Einheitsmatrix mal Einheitsmatrix ist die Einheitsmatrix.
    var m1: [u64; 16] = [0 as u64; 16]
    var m2: [u64; 16] = [0 as u64; 16]
    var m3: [u64; 16] = [0 as u64; 16]
    einheitsmatrix((&m1[0]) as u64)
    einheitsmatrix((&m2[0]) as u64)
    mat_mul((&m3[0]) as u64, (&m1[0]) as u64, (&m2[0]) as u64)
    if mget((&m3[0]) as u64, 0, 0) != FIX_ONE {
        fehler = fehler | 512
    }
    if mget((&m3[0]) as u64, 0, 1) != 0 {
        fehler = fehler | 1024
    }
    if mget((&m3[0]) as u64, 3, 3) != FIX_ONE {
        fehler = fehler | 2048
    }
    // 9. Eine Verschiebung verschiebt wirklich: (0,0,0) um (1,2,3).
    var mv: [u64; 16] = [0 as u64; 16]
    var aus: [u64; 4] = [0 as u64; 4]
    verschieben((&mv[0]) as u64, FIX_ONE, 2 * FIX_ONE, 3 * FIX_ONE)
    point_draw_matrix((&mv[0]) as u64, 0, 0, 0, (&aus[0]) as u64)
    if kstate.get((&aus[0]) as u64, 0) != FIX_ONE {
        fehler = fehler | 4096
    }
    if kstate.get((&aus[0]) as u64, 16) != 3 * FIX_ONE {
        fehler = fehler | 8192
    }
    // 10. Eine Vierteldrehung um Y bringt (1,0,0) nach (0,0,-1).
    var md: [u64; 16] = [0 as u64; 16]
    if g(state, S_SIN) != 0 {
        dreh_y((&md[0]) as u64, sin_fx(state, 256), sin_fx(state, 512))
        point_draw_matrix((&md[0]) as u64, FIX_ONE, 0, 0, (&aus[0]) as u64)
        let rx: u64 = kstate.get((&aus[0]) as u64, 0)
        let rz: u64 = kstate.get((&aus[0]) as u64, 16)
        if rx > 256 && rx < 0 -% 256 {
            fehler = fehler | 16384
        }
        if rz != 0 -% FIX_ONE {
            fehler = fehler | 32768
        }
    }
    return fehler
}

fn last_brightness(state: u64) -> u64 {
    return g(state, S_LETZTHELL)
}
