// SPDX-License-Identifier: GPL-2.0-only
// kernel/mnt.fi -- Runde K14: DIE EINHAENGETAFEL.
//
// Sie steht in einer eigenen Datei und nicht in `vfs.fi`, und der Grund
// ist keine Ordnungsliebe: die TREIBER brauchen sie (ein FAT32 muss
// wissen, auf welchem Geraet und ab welchem Block seine Einhaengung
// liegt), und `vfs.fi` braucht die Treiber. Laegen beide zusammen,
// waere es ein Kreis von Modulen -- den kann Firn nicht uebersetzen,
// und er waere auch fachlich falsch: Daten haengen nicht an Politik.
//
// EIN EINTRAG SIND 128 OKTETTE, acht Eintraege eine Achtel Seite:
//
//   used     1 = dieser Platz ist belegt
//   fstype   welcher Treiber (vfsops.FS_*)
//   dev      Blockgeraet (blk.DEV_*)
//   first    erster Block DIESER Einhaengung auf dem Geraet. Das ist
//            der Grund, warum eine Partition kein Sonderfall ist: der
//            Treiber rechnet in seinen eigenen Bloecken ab null, und
//            diese Zahl wird darauf addiert.
//   blocks   wie viele Bloecke ihm gehoeren -- ein Treiber, der
//            darueber hinausliest, liest in die naechste Partition.
//   flags    Bit 0 = nur lesend
//   root     der Wurzelknoten dieses Dateisystems
//   opens    OFFENE DESKRIPTOREN auf dieser Einhaengung. Das ist die
//            Zahl, wegen der `umount` nein sagen kann, und sie ist der
//            Unterschied zwischen einem Aushaengen und einem Datenverlust.
//   depth    wie viele Namensteile der Einhaengepfad hat ("/" = 0)
//   path     der Einhaengepfad als Text, 32 Oktette
//
// Der Platz 0 ist die WURZEL und wird beim Start belegt. Er laesst sich
// nicht aushaengen, solange etwas darauf offen ist -- und `umount /`
// von Runde K11 geht weiter durch denselben Weg wie vorher.

import kstate

export {
    init, alloc, free, used, count, set, get,
    path_at, path_len, set_path, path_eq_prefix, name_of,
    fstype, dev, first, blocks, flags, root, opens, depth,
    set_root, open_inc, open_dec, path_is, describe,
    M_USED, M_TYPE, M_DEV, M_FIRST, M_BLOCKS, M_FLAGS, M_ROOT, M_OPENS,
    MAX_MNT, MNT_BYTES, F_RDONLY, PATH_LEN
}

const MAX_MNT: u64 = 8
const MNT_BYTES: u64 = 128
const MNT_OFF: u64 = 0x040 // in kstate.K14_OFF
const PATH_LEN: u64 = 32

const M_USED: u64 = 0
const M_TYPE: u64 = 8
const M_DEV: u64 = 16
const M_FIRST: u64 = 24
const M_BLOCKS: u64 = 32
const M_FLAGS: u64 = 40
const M_ROOT: u64 = 48
const M_OPENS: u64 = 56
const M_DEPTH: u64 = 64
const M_PATH: u64 = 96 // 32 Oktette bis 128

const F_RDONLY: u64 = 1

fn at(state: u64, m: u64) -> u64 {
    return state + kstate.K14_OFF + MNT_OFF + m * MNT_BYTES
}

fn get(state: u64, m: u64, field: u64) -> u64 {
    if m >= MAX_MNT {
        return 0
    }
    return __mmio_read64((at(state, m) + field) as *mut u64)
}

fn set(state: u64, m: u64, field: u64, v: u64) {
    if m >= MAX_MNT {
        return
    }
    __mmio_write64((at(state, m) + field) as *mut u64, v)
}

fn init(state: u64) {
    var m: u64 = 0
    while m < MAX_MNT {
        var i: u64 = 0
        while i < MNT_BYTES {
            kstate.set8(at(state, m) + i, 0 as u8)
            i = i + 1
        }
        m = m + 1
    }
    kstate.set(state, kstate.VFS_MOUNTS, 0)
}

fn used(state: u64, m: u64) -> bool {
    return get(state, m, M_USED) != 0
}

fn count(state: u64) -> u64 {
    var n: u64 = 0
    var m: u64 = 0
    while m < MAX_MNT {
        if used(state, m) {
            n = n + 1
        }
        m = m + 1
    }
    return n
}

fn fstype(state: u64, m: u64) -> u64 {
    return get(state, m, M_TYPE)
}

fn dev(state: u64, m: u64) -> u64 {
    return get(state, m, M_DEV)
}

fn first(state: u64, m: u64) -> u64 {
    return get(state, m, M_FIRST)
}

fn blocks(state: u64, m: u64) -> u64 {
    return get(state, m, M_BLOCKS)
}

fn flags(state: u64, m: u64) -> u64 {
    return get(state, m, M_FLAGS)
}

fn root(state: u64, m: u64) -> u64 {
    return get(state, m, M_ROOT)
}

fn set_root(state: u64, m: u64, v: u64) {
    set(state, m, M_ROOT, v)
}

fn opens(state: u64, m: u64) -> u64 {
    return get(state, m, M_OPENS)
}

fn open_inc(state: u64, m: u64) {
    set(state, m, M_OPENS, opens(state, m) + 1)
}

fn open_dec(state: u64, m: u64) {
    let n: u64 = opens(state, m)
    if n > 0 {
        set(state, m, M_OPENS, n - 1)
    }
}

fn depth(state: u64, m: u64) -> u64 {
    return get(state, m, M_DEPTH)
}

fn path_at(state: u64, m: u64) -> u64 {
    return at(state, m) + M_PATH
}

fn path_len(state: u64, m: u64) -> u64 {
    let p: u64 = path_at(state, m)
    var n: u64 = 0
    while n < PATH_LEN && kstate.get8(p + n) != 0 {
        n = n + 1
    }
    return n
}

// Den Einhaengepfad setzen. Er wird NORMALISIERT: er faengt mit einem
// Schraegstrich an und endet ohne einen -- ausser er ist die Wurzel.
// Ohne das waeren "/mnt" und "/mnt/" zwei Einhaengepunkte, und der
// laengste gemeinsame Anfang, mit dem `vfs.fi` sucht, waere geraten.
fn set_path(state: u64, m: u64, src: u64) -> bool {
    let p: u64 = path_at(state, m)
    var i: u64 = 0
    while i < PATH_LEN {
        kstate.set8(p + i, 0 as u8)
        i = i + 1
    }
    var n: u64 = 0
    if kstate.get8(src) != 47 {
        return false
    }
    i = 0
    while kstate.get8(src + i) != 0 {
        if n >= PATH_LEN - 1 {
            return false
        }
        let c: u64 = kstate.get8(src + i)
        // Zwei Schraegstriche hintereinander werden einer.
        if c != 47 || n == 0 || kstate.get8(p + n - 1) != 47 {
            kstate.set8(p + n, c as u8)
            n = n + 1
        }
        i = i + 1
    }
    while n > 1 && kstate.get8(p + n - 1) == 47 {
        n = n - 1
        kstate.set8(p + n, 0 as u8)
    }
    var d: u64 = 0
    var k: u64 = 0
    while k < n {
        if kstate.get8(p + k) == 47 && k + 1 < n {
            d = d + 1
        }
        k = k + 1
    }
    set(state, m, M_DEPTH, d)
    return true
}

// Ist der Einhaengepfad von `m` ein Anfang von `path`, UND ZWAR AN
// EINER NAMENSGRENZE? Das ist die eine Stelle, an der eine
// Einhaengeschicht falsch werden kann: "/mnt" ist kein Anfang von
// "/mnttest", auch wenn die vier Oktette stimmen. Rueckgabe: wie viele
// Oktette des Pfades verbraucht sind, oder 0.
fn path_eq_prefix(state: u64, m: u64, path: u64) -> u64 {
    let p: u64 = path_at(state, m)
    let n: u64 = path_len(state, m)
    if n == 0 {
        return 0
    }
    if n == 1 {
        // Die Wurzel passt auf jeden Pfad, der mit '/' anfaengt.
        if kstate.get8(path) == 47 {
            return 1
        }
        return 0
    }
    var i: u64 = 0
    while i < n {
        if kstate.get8(path + i) != kstate.get8(p + i) {
            return 0
        }
        i = i + 1
    }
    let after: u64 = kstate.get8(path + n)
    if after == 0 || after == 47 {
        return n
    }
    return 0
}

// Der letzte Namensteil eines Einhaengepfads, fuer `readdir` auf dem
// Verzeichnis darueber. "/dev" -> "dev".
fn name_of(state: u64, m: u64, out: u64, max: u64) -> u64 {
    let p: u64 = path_at(state, m)
    let n: u64 = path_len(state, m)
    var cut: u64 = n
    while cut > 0 && kstate.get8(p + cut - 1) != 47 {
        cut = cut - 1
    }
    var i: u64 = 0
    while cut + i < n && i + 1 < max {
        kstate.set8(out + i, kstate.get8(p + cut + i) as u8)
        i = i + 1
    }
    kstate.set8(out + i, 0 as u8)
    return i
}

// Einen freien Platz nehmen. Platz 0 ist der Wurzel vorbehalten -- das
// ist keine Bequemlichkeit, sondern die Zusage, dass die Wurzel
// gefunden wird, auch wenn die Tafel voll ist.
fn alloc(state: u64, want_root: bool) -> u64 {
    if want_root {
        if used(state, 0) {
            return MAX_MNT
        }
        set(state, 0, M_USED, 1)
        kstate.set(state, kstate.VFS_MOUNTS, count(state))
        return 0
    }
    var m: u64 = 1
    while m < MAX_MNT {
        if !used(state, m) {
            var i: u64 = 0
            while i < MNT_BYTES {
                kstate.set8(at(state, m) + i, 0 as u8)
                i = i + 1
            }
            set(state, m, M_USED, 1)
            kstate.set(state, kstate.VFS_MOUNTS, count(state))
            return m
        }
        m = m + 1
    }
    return MAX_MNT
}

fn free(state: u64, m: u64) {
    if m >= MAX_MNT {
        return
    }
    var i: u64 = 0
    while i < MNT_BYTES {
        kstate.set8(at(state, m) + i, 0 as u8)
        i = i + 1
    }
    kstate.set(state, kstate.VFS_MOUNTS, count(state))
}

// Ist `path` GENAU der Einhaengepfad von `m`? Nicht "faengt damit an" --
// das ist `path_eq_prefix`. Zwei Fragen, zwei Funktionen; sie
// zusammenzulegen waere die Verwechslung, an der `umount /mnt/x` die
// falsche Einhaengung erwischt.
fn path_is(state: u64, m: u64, path: u64) -> bool {
    if !used(state, m) {
        return false
    }
    let n: u64 = path_len(state, m)
    var i: u64 = 0
    while i < n {
        if kstate.get8(path + i) != kstate.get8(path_at(state, m) + i) {
            return false
        }
        i = i + 1
    }
    return kstate.get8(path + n) == 0
}

// Eine Zeile ueber diese Einhaengung auf die serielle Leitung -- fuer
// den Testlauf, der die Tafel von aussen nachrechnet.
fn describe(state: u64, m: u64) -> u64 {
    return fstype(state, m)
}
