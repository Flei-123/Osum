
profile kernel

import lib.kstate
import fs.fs
import fs.fsctx
import fs.mnt
import fs.vfsops

export { ops, node_root, mount_probe, lookup_nofollow }

const SCRATCH_OFF: u64 = 0x980

fn tick(state: u64) {
    kstate.add(state, kstate.VFS_INDIRECT, 1)
}

fn node_root(state: u64) -> u64 {
    return fs.root(state)
}

fn i_lookup(state: u64, m: u64, path: u64) -> u64 {
    tick(state)
    if kstate.get(state, kstate.FS_READY) == 0 {
        return 0
    }
    return fs.path(state, path)
}

fn lookup_nofollow(state: u64, m: u64, path: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return 0
    }
    let flags: u64 = fsctx.enter(state, m)
    let r: u64 = fs.path_nofollow(state, path)
    fsctx.leave(state, m, flags)
    return r
}

fn i_readdir(state: u64, m: u64, dir: u64, index: u64, out: u64) -> u64 {
    tick(state)
    let scratch: u64 = state + kstate.K14_OFF + SCRATCH_OFF
    let ino: u64 = fs.entry_at(state, dir, index, scratch, fs.ENTRY_MAX)
    if ino == 0 {
        return 0
    }
    let nl: u64 = fs.name_len(state)
    var i: u64 = 0
    while i < nl {
        let c: u64 = kstate.get8(scratch + 8 + i)
        kstate.set8(out + i, c as u8)
        if c == 0 {
            i = nl
        } else {
            i = i + 1
        }
    }
    kstate.set8(out + nl, 0 as u8)
    return ino
}

fn i_attr(state: u64, m: u64, node: u64, what: u64) -> u64 {
    tick(state)
    if what == vfsops.A_TYPE {
        let art: u64 = fs.inode_type(state, node)
        if art == fs.T_DIR {
            return vfsops.N_DIR
        }
        if art == fs.T_FILE {
            return vfsops.N_FILE
        }
        if art == fs.T_LINK {
            return vfsops.N_LNK
        }
        return vfsops.N_NONE
    }
    if what == vfsops.A_SIZE {
        return fs.inode_size(state, node)
    }
    if what == vfsops.A_MODE {
        return fs.inode_mode(state, node)
    }
    if what == vfsops.A_UID {
        return fs.inode_uid(state, node)
    }
    if what == vfsops.A_GID {
        return fs.inode_gid(state, node)
    }
    if what == vfsops.A_NLINK {
        return 1
    }
    if what == vfsops.A_BLKSIZE {
        return 512
    }
    if what == vfsops.A_MTIME {
        return fs.inode_mtime(state, node)
    }
    if what == vfsops.A_CTIME {
        return fs.inode_ctime(state, node)
    }
    if what == vfsops.A_ATIME {
        return fs.inode_atime(state, node)
    }
    return 0
}

fn i_read(state: u64, m: u64, node: u64, off: u64, dst: u64,
    len: u64) -> u64 {
    tick(state)
    return fs.read_at(state, node, off, dst, len)
}

fn i_write(state: u64, m: u64, node: u64, off: u64, src: u64,
    len: u64) -> u64 {
    tick(state)
    return fs.write_at(state, node, off, src, len)
}

fn i_create(state: u64, m: u64, path: u64, art: u64) -> u64 {
    tick(state)
    var kind: u64 = fs.T_FILE
    if art == vfsops.N_DIR {
        kind = fs.T_DIR
    }
    return fs.create_path(state, path, kind)
}

fn i_unlink(state: u64, m: u64, path: u64) -> u64 {
    tick(state)
    if !fs.unlink_path(state, path) {
        return 2
    }
    return 0
}

fn i_rename(state: u64, m: u64, from: u64, to: u64) -> u64 {
    tick(state)
    return fs.rename_path(state, from, to)
}

fn i_trunc(state: u64, m: u64, node: u64) -> u64 {
    tick(state)
    fs.file_truncate(state, node)
    return 0
}

fn o_lookup(state: u64, m: u64, path: u64) -> u64 {
    let flags: u64 = fsctx.enter(state, m)
    let r: u64 = i_lookup(state, m, path)
    fsctx.leave(state, m, flags)
    return r
}

fn o_readdir(state: u64, m: u64, dir: u64, index: u64, out: u64) -> u64 {
    let flags: u64 = fsctx.enter(state, m)
    let r: u64 = i_readdir(state, m, dir, index, out)
    fsctx.leave(state, m, flags)
    return r
}

fn o_attr(state: u64, m: u64, node: u64, what: u64) -> u64 {
    let flags: u64 = fsctx.enter(state, m)
    let r: u64 = i_attr(state, m, node, what)
    fsctx.leave(state, m, flags)
    return r
}

fn o_read(state: u64, m: u64, node: u64, off: u64, dst: u64, len: u64) -> u64 {
    let flags: u64 = fsctx.enter(state, m)
    let r: u64 = i_read(state, m, node, off, dst, len)
    fsctx.leave(state, m, flags)
    return r
}

fn o_write(state: u64, m: u64, node: u64, off: u64, src: u64, len: u64) -> u64 {
    let flags: u64 = fsctx.enter(state, m)
    let r: u64 = i_write(state, m, node, off, src, len)
    fsctx.leave(state, m, flags)
    return r
}

fn o_create(state: u64, m: u64, path: u64, art: u64) -> u64 {
    let flags: u64 = fsctx.enter(state, m)
    let r: u64 = i_create(state, m, path, art)
    fsctx.leave(state, m, flags)
    return r
}

fn o_unlink(state: u64, m: u64, path: u64) -> u64 {
    let flags: u64 = fsctx.enter(state, m)
    let r: u64 = i_unlink(state, m, path)
    fsctx.leave(state, m, flags)
    return r
}

fn o_rename(state: u64, m: u64, from: u64, to: u64) -> u64 {
    let flags: u64 = fsctx.enter(state, m)
    let r: u64 = i_rename(state, m, from, to)
    fsctx.leave(state, m, flags)
    return r
}

fn o_trunc(state: u64, m: u64, node: u64) -> u64 {
    let flags: u64 = fsctx.enter(state, m)
    let r: u64 = i_trunc(state, m, node)
    fsctx.leave(state, m, flags)
    return r
}

fn mount_probe(state: u64, m: u64) -> u64 {
    if fsctx.is_root(state, m) {
        return node_root(state)
    }
    return fsctx.mount_foreign(state, m)
}

fn ops() -> vfsops.Ops {
    return vfsops.Ops {
        lookup: o_lookup,
        readdir: o_readdir,
        attr: o_attr,
        read: o_read,
        write: o_write,
        create: o_create,
        unlink: o_unlink,
        rename: o_rename,
        trunc: o_trunc,
        mask: vfsops.OP_ALL,
        tag: 7562863
    }
}
