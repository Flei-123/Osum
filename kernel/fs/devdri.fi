profile kernel

import lib.kstate

export { D_DRI, D_CARD, D_RENDER, owns, is_node, is_render, lookup, rdev, mode, root_entry, readdir }

const D_DRI: u64 = 4096
const D_CARD: u64 = 4097
const D_RENDER: u64 = 4098
const RDEV_CARD: u64 = 0xE200
const RDEV_RENDER: u64 = 0xE280
const MODE_DIR: u64 = 493
const MODE_NODE: u64 = 438

static mut n_dri: [u8; 4] = "dri\0"
static mut n_card: [u8; 6] = "card0\0"
static mut n_render: [u8; 12] = "renderD128\0\0"

fn owns(node: u64) -> bool {
    return node >= D_DRI && node <= D_RENDER
}

fn is_node(node: u64) -> bool {
    return node == D_CARD || node == D_RENDER
}

fn is_render(node: u64) -> bool {
    return node == D_RENDER
}

fn same(p: u64, name: u64) -> bool {
    var i: u64 = 0
    while kstate.get8(name + i) != 0 {
        if kstate.get8(p + i) != kstate.get8(name + i) {
            return false
        }
        i = i + 1
    }
    let end: u64 = kstate.get8(p + i)
    return end == 0 || end == 47
}

fn name_len(name: u64) -> u64 {
    var i: u64 = 0
    while kstate.get8(name + i) != 0 {
        i = i + 1
    }
    return i
}

fn lookup(p: u64) -> u64 {
    let dri: u64 = (&n_dri[0]) as u64
    if !same(p, dri) {
        return 0
    }
    var q: u64 = p + name_len(dri)
    while kstate.get8(q) == 47 {
        q = q + 1
    }
    if kstate.get8(q) == 0 {
        return D_DRI
    }
    if same(q, (&n_card[0]) as u64) && kstate.get8(q + 5) == 0 {
        return D_CARD
    }
    if same(q, (&n_render[0]) as u64) && kstate.get8(q + 10) == 0 {
        return D_RENDER
    }
    return 0
}

fn rdev(node: u64) -> u64 {
    if node == D_CARD {
        return RDEV_CARD
    }
    if node == D_RENDER {
        return RDEV_RENDER
    }
    return 0
}

fn mode(node: u64) -> u64 {
    if node == D_DRI {
        return MODE_DIR
    }
    return MODE_NODE
}

fn put_name(out: u64, src: u64) {
    var i: u64 = 0
    while kstate.get8(src + i) != 0 {
        kstate.set8(out + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(out + i, 0 as u8)
}

fn root_entry(k: u64, out: u64) -> u64 {
    if k != 0 {
        return 0
    }
    put_name(out, (&n_dri[0]) as u64)
    return D_DRI
}

fn readdir(index: u64, out: u64) -> u64 {
    if index == 0 {
        kstate.set8(out, 46 as u8)
        kstate.set8(out + 1, 0 as u8)
        return D_DRI
    }
    if index == 1 {
        kstate.set8(out, 46 as u8)
        kstate.set8(out + 1, 46 as u8)
        kstate.set8(out + 2, 0 as u8)
        return D_DRI
    }
    if index == 2 {
        put_name(out, (&n_card[0]) as u64)
        return D_CARD
    }
    if index == 3 {
        put_name(out, (&n_render[0]) as u64)
        return D_RENDER
    }
    return 0
}
