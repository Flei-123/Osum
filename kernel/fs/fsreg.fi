profile kernel

import fs.vfsops

export {
    bind_slot, proc_installed, proc_ops, proc_node_root, proc_sfs_root,
    dev_installed, dev_ops, dev_node_root,
    H_PROC_OPS, H_PROC_NODE_ROOT, H_PROC_SFS_ROOT, H_DEV_OPS, H_DEV_NODE_ROOT
}

const H_PROC_OPS: u64 = 0
const H_PROC_NODE_ROOT: u64 = 1
const H_PROC_SFS_ROOT: u64 = 2
const H_DEV_OPS: u64 = 3
const H_DEV_NODE_ROOT: u64 = 4
const H_COUNT: u64 = 5

static mut table: [u64; 5] = [0 as u64; 5]

fn bind_slot(slot: u64, handler: u64) {
    if slot < H_COUNT {
        table[slot as usize] = handler
    }
}

fn proc_installed() -> bool {
    return table[H_PROC_OPS as usize] != 0 && table[H_PROC_NODE_ROOT as usize] != 0 && table[H_PROC_SFS_ROOT as usize] != 0
}

fn dev_installed() -> bool {
    return table[H_DEV_OPS as usize] != 0 && table[H_DEV_NODE_ROOT as usize] != 0
}

fn proc_ops() -> vfsops.Ops {
    let call: fn() -> vfsops.Ops = table[H_PROC_OPS as usize] as fn() -> vfsops.Ops
    return call()
}

fn proc_node_root(state: u64) -> u64 {
    let call: fn(u64) -> u64 = table[H_PROC_NODE_ROOT as usize] as fn(u64) -> u64
    return call(state)
}

fn proc_sfs_root(state: u64) -> u64 {
    let call: fn(u64) -> u64 = table[H_PROC_SFS_ROOT as usize] as fn(u64) -> u64
    return call(state)
}

fn dev_ops() -> vfsops.Ops {
    let call: fn() -> vfsops.Ops = table[H_DEV_OPS as usize] as fn() -> vfsops.Ops
    return call()
}

fn dev_node_root(state: u64) -> u64 {
    let call: fn(u64) -> u64 = table[H_DEV_NODE_ROOT as usize] as fn(u64) -> u64
    return call(state)
}
