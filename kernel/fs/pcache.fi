profile kernel

import lib.kstate
import fs.cachelock

export {
    attach, REGION_FRAMES, read_hit, copy_out, begin_fill, attach_frame, finish_fill, abort_fill, buffer_of,
    drop_node, drop_ino, drop_mount, drop_all, take_frame,
    hits, misses, inserts, evictions, drops, resident, shrunk, bypassed,
    note_bypass, MISS, PAGE_BYTES
}

const MISS: u64 = 0xFFFFFFFFFFFFFFFF
const PAGE_BYTES: u64 = 4096
const SLOTS: u64 = 256
const WAYS: u64 = 8
const SETS: u64 = 32
const SLOT_BYTES: u64 = 64
const SLOTS_AT: u64 = 4096
const REGION_FRAMES: u64 = 5
const H_EPOCH: u64 = 8
const H_CLOCK: u64 = 16
const H_HITS: u64 = 24
const H_MISSES: u64 = 32
const H_INSERTS: u64 = 40
const H_EVICTS: u64 = 48
const H_DROPS: u64 = 56
const H_PAGES: u64 = 64
const H_SHRUNK: u64 = 72
const H_BYPASS: u64 = 80
const S_NODE: u64 = 0
const S_KEY: u64 = 8
const S_VALID: u64 = 16
const S_STAMP: u64 = 24
const S_FRAME: u64 = 32
const S_BUSY: u64 = 40

fn attach(state: u64, region: u64) {
    var o: u64 = 0
    while o < REGION_FRAMES * 4096 {
        kstate.set(region, o, 0)
        o = o + 8
    }
    kstate.set(region, H_CLOCK, 1)
    kstate.set(state, kstate.PCACHE_BASE, region)
}

fn enabled(state: u64) -> bool {
    return !kstate.mode_on(state, kstate.M_NOPCACHE)
}

fn slot_of(b: u64, i: u64) -> u64 {
    return b + SLOTS_AT + i * SLOT_BYTES
}

fn key_of(m: u64, idx: u64) -> u64 {
    return (idx << 8) | (m + 1)
}

fn set_hash(node: u64, m: u64, idx: u64) -> u64 {
    var h: u64 = (node ^ (m << 56)) *% 0x9E3779B97F4A7C15
    h = (h ^ (idx *% 0xC2B2AE3D27D4EB4F)) *% 0x9E3779B97F4A7C15
    return (h >> 32) % SETS
}

fn copy_out(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i + 8 <= n {
        kstate.set(dst, i, kstate.get(src, i))
        i = i + 8
    }
    while i < n {
        kstate.set8(dst + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
}

fn read_hit(state: u64, m: u64, node: u64, idx: u64, from: u64, n: u64, dst: u64) -> u64 {
    if !enabled(state) {
        return MISS
    }
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return MISS
    }
    let key: u64 = key_of(m, idx)
    let set: u64 = set_hash(node, m, idx)
    let flags: u64 = cachelock.take(b)
    var way: u64 = 0
    while way < WAYS {
        let s: u64 = slot_of(b, set * WAYS + way)
        if kstate.get(s, S_KEY) == key && kstate.get(s, S_NODE) == node {
            let valid: u64 = kstate.get(s, S_VALID)
            if from + n <= valid || valid < PAGE_BYTES {
                var take: u64 = n
                if from >= valid {
                    take = 0
                } else if from + n > valid {
                    take = valid - from
                }
                copy_out(dst, kstate.get(s, S_FRAME) + from, take)
                let clock: u64 = kstate.get(b, H_CLOCK) + 1
                kstate.set(b, H_CLOCK, clock)
                kstate.set(s, S_STAMP, clock)
                kstate.set(b, H_HITS, kstate.get(b, H_HITS) + 1)
                cachelock.give(b, flags)
                return take
            }
        }
        way = way + 1
    }
    kstate.set(b, H_MISSES, kstate.get(b, H_MISSES) + 1)
    cachelock.give(b, flags)
    return MISS
}

fn begin_fill(state: u64, m: u64, node: u64, idx: u64) -> u64 {
    if !enabled(state) {
        return 0
    }
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return 0
    }
    let set: u64 = set_hash(node, m, idx)
    let flags: u64 = cachelock.take(b)
    var victim: u64 = 0
    var oldest: u64 = MISS
    var empty: bool = false
    var way: u64 = 0
    while way < WAYS {
        let s: u64 = slot_of(b, set * WAYS + way)
        if kstate.get(s, S_BUSY) == 0 && !empty {
            if kstate.get(s, S_KEY) == 0 {
                victim = s
                empty = true
            } else if kstate.get(s, S_STAMP) < oldest {
                victim = s
                oldest = kstate.get(s, S_STAMP)
            }
        }
        way = way + 1
    }
    if victim == 0 {
        cachelock.give(b, flags)
        return 0
    }
    if kstate.get(victim, S_KEY) != 0 {
        kstate.set(b, H_EVICTS, kstate.get(b, H_EVICTS) + 1)
    }
    kstate.set(victim, S_KEY, 0)
    kstate.set(victim, S_BUSY, kstate.get(b, H_EPOCH) + 1)
    cachelock.give(b, flags)
    return victim
}

fn attach_frame(state: u64, slot: u64, frame: u64) {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    kstate.set(slot, S_FRAME, frame)
    kstate.add(b, H_PAGES, 1)
}

fn buffer_of(slot: u64) -> u64 {
    return kstate.get(slot, S_FRAME)
}

fn finish_fill(state: u64, slot: u64, m: u64, node: u64, idx: u64, valid: u64) {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    let flags: u64 = cachelock.take(b)
    if kstate.get(b, H_EPOCH) + 1 == kstate.get(slot, S_BUSY) && valid <= PAGE_BYTES {
        let clock: u64 = kstate.get(b, H_CLOCK) + 1
        kstate.set(b, H_CLOCK, clock)
        kstate.set(slot, S_NODE, node)
        kstate.set(slot, S_VALID, valid)
        kstate.set(slot, S_STAMP, clock)
        kstate.set(slot, S_KEY, key_of(m, idx))
        kstate.set(b, H_INSERTS, kstate.get(b, H_INSERTS) + 1)
    }
    kstate.set(slot, S_BUSY, 0)
    cachelock.give(b, flags)
}

fn abort_fill(state: u64, slot: u64) {
    kstate.set(slot, S_BUSY, 0)
}

fn drop_where(state: u64, mode: u64, m: u64, node: u64) {
    if kstate.mode_on(state, kstate.M_PCNOINVAL) {
        return
    }
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return
    }
    let flags: u64 = cachelock.take(b)
    kstate.set(b, H_EPOCH, kstate.get(b, H_EPOCH) + 1)
    var i: u64 = 0
    while i < SLOTS {
        let s: u64 = slot_of(b, i)
        let key: u64 = kstate.get(s, S_KEY)
        if key != 0 {
            var hit: bool = mode == 0
            if mode == 1 {
                hit = kstate.get(s, S_NODE) == node && (key & 255) == m + 1
            } else if mode == 2 {
                hit = kstate.get(s, S_NODE) == node
            } else if mode == 3 {
                hit = (key & 255) == m + 1
            }
            if hit {
                kstate.set(s, S_KEY, 0)
                kstate.set(b, H_DROPS, kstate.get(b, H_DROPS) + 1)
            }
        }
        i = i + 1
    }
    cachelock.give(b, flags)
}

fn drop_node(state: u64, m: u64, node: u64) {
    drop_where(state, 1, m, node)
}

fn drop_ino(state: u64, node: u64) {
    drop_where(state, 2, 0, node)
}

fn drop_mount(state: u64, m: u64) {
    drop_where(state, 3, m, 0)
}

fn drop_all(state: u64) {
    drop_where(state, 0, 0, 0)
}

fn take_frame(state: u64) -> u64 {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return 0
    }
    var f: u64 = 0
    let flags: u64 = cachelock.take(b)
    var i: u64 = 0
    while i < SLOTS && f == 0 {
        let s: u64 = slot_of(b, i)
        if kstate.get(s, S_BUSY) == 0 && kstate.get(s, S_FRAME) != 0 {
            f = kstate.get(s, S_FRAME)
            kstate.set(s, S_KEY, 0)
            kstate.set(s, S_FRAME, 0)
            kstate.set(b, H_PAGES, kstate.get(b, H_PAGES) - 1)
            kstate.set(b, H_SHRUNK, kstate.get(b, H_SHRUNK) + 1)
            kstate.set(b, H_EPOCH, kstate.get(b, H_EPOCH) + 1)
        }
        i = i + 1
    }
    cachelock.give(b, flags)
    return f
}

fn note_bypass(state: u64) {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b != 0 {
        kstate.add(b, H_BYPASS, 1)
    }
}

fn hits(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_HITS)
}

fn misses(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_MISSES)
}

fn inserts(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_INSERTS)
}

fn evictions(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_EVICTS)
}

fn drops(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_DROPS)
}

fn resident(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_PAGES)
}

fn shrunk(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_SHRUNK)
}

fn bypassed(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_BYPASS)
}
