// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import lib.kstate
import fs.cachelock
import arch.arch

export {
    attach, sets_for, region_frames, MIN_SETS, read_hit, copy_out, begin_fill, attach_frame, finish_fill, abort_fill, buffer_of,
    drop_node, drop_ino, drop_mount, drop_all, take_frame,
    hits, misses, inserts, evictions, drops, resident, shrunk, bypassed,
    note_bypass, MISS, PAGE_BYTES, pin, unpin, valid_of,
    drop_pages, stat, H_SCANS, H_WALKED, H_DROP_CALLS, H_DROP_NODE, H_DROP_INO, H_DROP_MOUNT, H_DROP_ALL, H_DROP_RANGE, H_SETS, H_EVICTS, H_SHRUNK,
    base_of, find_way, slot_at, pin_slot, unpin_slot, pin_page, frame_at, set_of, run_slot, run_frame, pin_page_run,
    patch_run, partials_of, drop_partials_before, note_write_alloc, H_PATCHES, H_WRITE_ALLOCS
}

const MISS: u64 = 0xFFFFFFFFFFFFFFFF
const PAGE_BYTES: u64 = 4096
const WAYS: u64 = 8
const MIN_SETS: u64 = 32
const MAX_SETS: u64 = 4096
const FRAMES_PER_SLOT: u64 = 8
const SLOT_BYTES: u64 = 64
const CHAIN_BUCKETS: u64 = 16384
const CHAIN_AT: u64 = 4096
const SLOTS_AT: u64 = 135168
const SLOT_SHIFT: u64 = 6
const LINK_MASK: u64 = 0xFFFFFFFF
const LINK_SHIFT: u64 = 32
const PARTIAL_ONE: u64 = 0x100000000
const GOLDEN: u64 = 0x9E3779B97F4A7C15
const H_EPOCH: u64 = 8
const H_CLOCK: u64 = 16
const H_HITS: u64 = 24
const H_MISSES: u64 = 32
const H_INSERTS: u64 = 40
const H_EVICTS: u64 = 48
const H_DROPS: u64 = 56
const H_PAGES: u64 = 64
const H_SHRUNK: u64 = 72
const H_BYPASS: u64 = 80
const H_SETS: u64 = 88
const H_MNT_LIVE: u64 = 96
const H_DROP_CALLS: u64 = 104
const H_SCANS: u64 = 112
const H_WALKED: u64 = 120
const H_DROP_NODE: u64 = 128
const H_DROP_INO: u64 = 136
const H_DROP_MOUNT: u64 = 144
const H_DROP_ALL: u64 = 152
const H_DROP_RANGE: u64 = 168
const H_PATCHES: u64 = 176
const H_WRITE_ALLOCS: u64 = 184
const PROBE_MAX_PAGES: u64 = 32
const S_NODE: u64 = 0
const S_KEY: u64 = 8
const S_VALID: u64 = 16
const S_STAMP: u64 = 24
const S_FRAME: u64 = 32
const S_BUSY: u64 = 40
const S_PIN: u64 = 48
const S_LINK: u64 = 56

fn sets_for(total_frames: u64) -> u64 {
    var sets: u64 = MIN_SETS
    while sets < MAX_SETS && sets * WAYS * FRAMES_PER_SLOT < total_frames {
        sets = sets * 2
    }
    return sets
}

fn region_frames(sets: u64) -> u64 {
    return (SLOTS_AT + sets * WAYS * SLOT_BYTES + PAGE_BYTES - 1) / PAGE_BYTES
}

fn attach(state: u64, region: u64, sets: u64) {
    arch.fill_words(region, 0, region_frames(sets) * PAGE_BYTES / 8)
    kstate.set(region, H_CLOCK, 1)
    kstate.set(region, H_SETS, sets)
    kstate.set(state, kstate.PCACHE_BASE, region)
}

fn enabled(state: u64) -> bool {
    return !kstate.mode_on(state, kstate.M_NOPCACHE)
}

fn slot_of(b: u64, i: u64) -> u64 {
    return b + SLOTS_AT + i * SLOT_BYTES
}

fn key_of(m: u64, idx: u64) -> u64 {
    return (idx << 8) | (m + 1)
}

fn set_of(b: u64, node: u64, m: u64, idx: u64) -> u64 {
    let h: u64 = ((node ^ (m << 56)) *% GOLDEN) >> 32
    return (h + idx) & (kstate.get(b, H_SETS) - 1)
}

fn chain_at(node: u64) -> u64 {
    return CHAIN_AT + (((node *% GOLDEN) >> 40) % CHAIN_BUCKETS) * 8
}

fn slot_ref(b: u64, s: u64) -> u64 {
    return ((s - b - SLOTS_AT) >> SLOT_SHIFT) + 1
}

fn slot_from_ref(b: u64, ref: u64) -> u64 {
    return slot_of(b, ref - 1)
}

fn chain_head(b: u64, node: u64) -> u64 {
    return kstate.get(b, chain_at(node)) & LINK_MASK
}

fn chain_partials(b: u64, node: u64) -> u64 {
    return kstate.get(b, chain_at(node)) >> LINK_SHIFT
}

fn chain_set_head(b: u64, node: u64, ref: u64) {
    kstate.set(b, chain_at(node), (kstate.get(b, chain_at(node)) & (LINK_MASK << LINK_SHIFT)) | ref)
}

fn chain_add(b: u64, s: u64, node: u64) {
    let head: u64 = chain_head(b, node)
    let ref: u64 = slot_ref(b, s)
    kstate.set(s, S_LINK, head)
    if head != 0 {
        let hs: u64 = slot_from_ref(b, head)
        kstate.set(hs, S_LINK, (kstate.get(hs, S_LINK) & LINK_MASK) | (ref << LINK_SHIFT))
    }
    chain_set_head(b, node, ref)
    if kstate.get(s, S_VALID) < PAGE_BYTES {
        kstate.set(b, chain_at(node), kstate.get(b, chain_at(node)) + PARTIAL_ONE)
    }
}

fn chain_del(b: u64, s: u64) {
    let link: u64 = kstate.get(s, S_LINK)
    let next: u64 = link & LINK_MASK
    let prev: u64 = link >> LINK_SHIFT
    let node: u64 = kstate.get(s, S_NODE)
    if prev == 0 {
        chain_set_head(b, node, next)
    } else {
        let ps: u64 = slot_from_ref(b, prev)
        kstate.set(ps, S_LINK, (kstate.get(ps, S_LINK) & (LINK_MASK << LINK_SHIFT)) | next)
    }
    if next != 0 {
        let ns: u64 = slot_from_ref(b, next)
        kstate.set(ns, S_LINK, (kstate.get(ns, S_LINK) & LINK_MASK) | (prev << LINK_SHIFT))
    }
    if kstate.get(s, S_VALID) < PAGE_BYTES {
        kstate.set(b, chain_at(node), kstate.get(b, chain_at(node)) - PARTIAL_ONE)
    }
    kstate.set(s, S_LINK, 0)
}

fn slot_count(b: u64) -> u64 {
    return kstate.get(b, H_SETS) * WAYS
}

fn copy_out(dst: u64, src: u64, n: u64) {
    arch.copy_octets(dst, src, n)
}

fn read_hit(state: u64, m: u64, node: u64, idx: u64, from: u64, n: u64, dst: u64) -> u64 {
    if !enabled(state) {
        return MISS
    }
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return MISS
    }
    let key: u64 = key_of(m, idx)
    let set: u64 = set_of(b, node, m, idx)
    let flags: u64 = cachelock.take(b)
    var way: u64 = 0
    while way < WAYS {
        let s: u64 = slot_of(b, set * WAYS + way)
        if kstate.get(s, S_KEY) == key && kstate.get(s, S_NODE) == node {
            let valid: u64 = kstate.get(s, S_VALID)
            if from + n <= valid || valid < PAGE_BYTES {
                var take: u64 = n
                if from >= valid {
                    take = 0
                } else if from + n > valid {
                    take = valid - from
                }
                copy_out(dst, kstate.get(s, S_FRAME) + from, take)
                let clock: u64 = kstate.get(b, H_CLOCK) + 1
                kstate.set(b, H_CLOCK, clock)
                kstate.set(s, S_STAMP, clock)
                kstate.set(b, H_HITS, kstate.get(b, H_HITS) + 1)
                cachelock.give(b, flags)
                return take
            }
        }
        way = way + 1
    }
    kstate.set(b, H_MISSES, kstate.get(b, H_MISSES) + 1)
    cachelock.give(b, flags)
    return MISS
}

fn base_of(state: u64) -> u64 {
    if !enabled(state) {
        return 0
    }
    return kstate.get(state, kstate.PCACHE_BASE)
}

fn find_way(b: u64, node: u64, m: u64, idx: u64) -> u64 {
    let key: u64 = key_of(m, idx)
    let sets_mask: u64 = *((b + H_SETS) as *mut u64) - 1
    let first: u64 = ((((node ^ (m << 56)) *% GOLDEN) >> 32) + idx) & sets_mask
    var s: u64 = b + SLOTS_AT + first * WAYS * SLOT_BYTES
    var way: u64 = 0
    while way < WAYS {
        if *((s + S_KEY) as *mut u64) == key && *((s + S_NODE) as *mut u64) == node {
            return way + 1
        }
        s = s + SLOT_BYTES
        way = way + 1
    }
    return 0
}

fn pin_page(b: u64, node: u64, m: u64, idx: u64, need: u64) -> u64 {
    let way: u64 = find_way(b, node, m, idx)
    if way == 0 {
        return 0
    }
    let s: u64 = slot_at(b, node, m, idx, way - 1)
    if *((s + S_VALID) as *mut u64) < need {
        return 0
    }
    pin_slot(b, s)
    return way
}

fn run_slot(b: u64, set0: u64, j: u64, way: u64) -> u64 {
    return slot_of(b, ((set0 + j) & (*((b + H_SETS) as *mut u64) - 1)) * WAYS + way)
}

fn run_frame(b: u64, set0: u64, j: u64, way: u64) -> u64 {
    return *((run_slot(b, set0, j, way) + S_FRAME) as *mut u64)
}

fn pin_page_run(b: u64, set0: u64, j: u64, node: u64, m: u64, idx: u64, need: u64) -> u64 {
    let key: u64 = key_of(m, idx)
    var s: u64 = run_slot(b, set0, j, 0)
    var way: u64 = 0
    while way < WAYS {
        if *((s + S_KEY) as *mut u64) == key && *((s + S_NODE) as *mut u64) == node {
            if *((s + S_VALID) as *mut u64) < need {
                return 0
            }
            pin_slot(b, s)
            return way + 1
        }
        s = s + SLOT_BYTES
        way = way + 1
    }
    return 0
}

fn frame_at(b: u64, node: u64, m: u64, idx: u64, way: u64) -> u64 {
    return *((slot_at(b, node, m, idx, way) + S_FRAME) as *mut u64)
}

fn slot_at(b: u64, node: u64, m: u64, idx: u64, way: u64) -> u64 {
    return slot_of(b, set_of(b, node, m, idx) * WAYS + way)
}

fn pin_slot(b: u64, s: u64) {
    let clock: u64 = kstate.get(b, H_CLOCK) + 1
    kstate.set(b, H_CLOCK, clock)
    kstate.set(s, S_STAMP, clock)
    kstate.set(s, S_PIN, kstate.get(s, S_PIN) + 1)
    kstate.set(b, H_HITS, kstate.get(b, H_HITS) + 1)
}

fn unpin_slot(s: u64) {
    let n: u64 = kstate.get(s, S_PIN)
    if n > 0 {
        kstate.set(s, S_PIN, n - 1)
    }
}

fn pin(state: u64, m: u64, node: u64, idx: u64) -> u64 {
    let b: u64 = base_of(state)
    if b == 0 {
        return 0
    }
    let flags: u64 = cachelock.take(b)
    let way: u64 = find_way(b, node, m, idx)
    if way == 0 {
        cachelock.give(b, flags)
        return 0
    }
    let s: u64 = slot_at(b, node, m, idx, way - 1)
    pin_slot(b, s)
    cachelock.give(b, flags)
    return s
}

fn unpin(state: u64, slot: u64) {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    let flags: u64 = cachelock.take(b)
    unpin_slot(slot)
    cachelock.give(b, flags)
}

fn valid_of(slot: u64) -> u64 {
    return kstate.get(slot, S_VALID)
}

fn begin_fill(state: u64, m: u64, node: u64, idx: u64) -> u64 {
    if !enabled(state) {
        return 0
    }
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return 0
    }
    let set: u64 = set_of(b, node, m, idx)
    let flags: u64 = cachelock.take(b)
    kstate.set(b, H_MNT_LIVE, kstate.get(b, H_MNT_LIVE) | (1 << (m & 63)))
    var victim: u64 = 0
    var oldest: u64 = MISS
    var empty: bool = false
    var way: u64 = 0
    while way < WAYS {
        let s: u64 = slot_of(b, set * WAYS + way)
        if kstate.get(s, S_BUSY) == 0 && kstate.get(s, S_PIN) == 0 && !empty {
            if kstate.get(s, S_KEY) == 0 {
                victim = s
                empty = true
            } else if kstate.get(s, S_STAMP) < oldest {
                victim = s
                oldest = kstate.get(s, S_STAMP)
            }
        }
        way = way + 1
    }
    if victim == 0 {
        cachelock.give(b, flags)
        return 0
    }
    if kstate.get(victim, S_KEY) != 0 {
        kstate.set(b, H_EVICTS, kstate.get(b, H_EVICTS) + 1)
        chain_del(b, victim)
    }
    kstate.set(victim, S_KEY, 0)
    kstate.set(victim, S_BUSY, kstate.get(b, H_EPOCH) + 1)
    cachelock.give(b, flags)
    return victim
}

fn attach_frame(state: u64, slot: u64, frame: u64) {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    kstate.set(slot, S_FRAME, frame)
    kstate.add(b, H_PAGES, 1)
}

fn buffer_of(slot: u64) -> u64 {
    return kstate.get(slot, S_FRAME)
}

fn finish_fill(state: u64, slot: u64, m: u64, node: u64, idx: u64, valid: u64) {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    let flags: u64 = cachelock.take(b)
    if kstate.get(b, H_EPOCH) + 1 == kstate.get(slot, S_BUSY) && valid <= PAGE_BYTES {
        let clock: u64 = kstate.get(b, H_CLOCK) + 1
        kstate.set(b, H_CLOCK, clock)
        kstate.set(slot, S_NODE, node)
        kstate.set(slot, S_VALID, valid)
        kstate.set(slot, S_STAMP, clock)
        kstate.set(slot, S_KEY, key_of(m, idx))
        kstate.set(b, H_MNT_LIVE, kstate.get(b, H_MNT_LIVE) | (1 << (m & 63)))
        chain_add(b, slot, node)
        kstate.set(b, H_INSERTS, kstate.get(b, H_INSERTS) + 1)
    }
    kstate.set(slot, S_BUSY, 0)
    cachelock.give(b, flags)
}

fn abort_fill(state: u64, slot: u64) {
    kstate.set(slot, S_BUSY, 0)
}

fn invalidate(b: u64, s: u64) {
    chain_del(b, s)
    kstate.set(s, S_KEY, 0)
    kstate.set(b, H_DROPS, kstate.get(b, H_DROPS) + 1)
}

fn drop_chain(b: u64, mode: u64, m: u64, node: u64) {
    var ref: u64 = chain_head(b, node)
    var walked: u64 = 0
    var dropped: u64 = 0
    while ref != 0 {
        let s: u64 = slot_from_ref(b, ref)
        ref = kstate.get(s, S_LINK) & LINK_MASK
        walked = walked + 1
        if kstate.get(s, S_NODE) == node && (mode == 2 || (kstate.get(s, S_KEY) & 255) == m + 1) {
            invalidate(b, s)
            dropped = dropped + 1
        }
    }
    kstate.set(b, H_WALKED, kstate.get(b, H_WALKED) + walked)
    if mode == 1 {
        kstate.set(b, H_DROP_NODE, kstate.get(b, H_DROP_NODE) + dropped)
    } else {
        kstate.set(b, H_DROP_INO, kstate.get(b, H_DROP_INO) + dropped)
    }
}

fn drop_scan(b: u64, mode: u64, m: u64) {
    var live: u64 = 0
    var dropped: u64 = 0
    let slots: u64 = slot_count(b)
    var i: u64 = 0
    while i < slots {
        let s: u64 = slot_of(b, i)
        let key: u64 = kstate.get(s, S_KEY)
        if key != 0 {
            if mode == 0 || (key & 255) == m + 1 {
                invalidate(b, s)
                dropped = dropped + 1
            } else {
                live = live | (1 << (((key & 255) - 1) & 63))
            }
        }
        i = i + 1
    }
    kstate.set(b, H_MNT_LIVE, live)
    kstate.set(b, H_SCANS, kstate.get(b, H_SCANS) + 1)
    if mode == 0 {
        kstate.set(b, H_DROP_ALL, kstate.get(b, H_DROP_ALL) + dropped)
    } else {
        kstate.set(b, H_DROP_MOUNT, kstate.get(b, H_DROP_MOUNT) + dropped)
    }
}

fn drop_where(state: u64, mode: u64, m: u64, node: u64) {
    if kstate.mode_on(state, kstate.M_PCNOINVAL) {
        return
    }
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return
    }
    if (mode == 1 || mode == 3) && (kstate.get(b, H_MNT_LIVE) & (1 << (m & 63))) == 0 {
        return
    }
    let flags: u64 = cachelock.take(b)
    kstate.set(b, H_EPOCH, kstate.get(b, H_EPOCH) + 1)
    kstate.set(b, H_DROP_CALLS, kstate.get(b, H_DROP_CALLS) + 1)
    if mode == 1 || mode == 2 {
        drop_chain(b, mode, m, node)
    } else {
        drop_scan(b, mode, m)
    }
    cachelock.give(b, flags)
}

fn probe_drop(b: u64, m: u64, node: u64, idx: u64) -> u64 {
    let key: u64 = key_of(m, idx)
    let set: u64 = set_of(b, node, m, idx)
    var dropped: u64 = 0
    var way: u64 = 0
    while way < WAYS {
        let s: u64 = slot_of(b, set * WAYS + way)
        if kstate.get(s, S_KEY) == key && kstate.get(s, S_NODE) == node {
            invalidate(b, s)
            dropped = dropped + 1
        }
        way = way + 1
    }
    return dropped
}

fn drop_range_probe(b: u64, node: u64, first: u64, last: u64) -> u64 {
    var mask: u64 = kstate.get(b, H_MNT_LIVE)
    var dropped: u64 = 0
    var m: u64 = 0
    while mask != 0 {
        if (mask & 1) != 0 {
            var idx: u64 = first
            while idx <= last {
                dropped = dropped + probe_drop(b, m, node, idx)
                idx = idx + 1
            }
        }
        mask = mask >> 1
        m = m + 1
    }
    return dropped
}

fn drop_range_chain(b: u64, node: u64, first: u64, last: u64) -> u64 {
    var ref: u64 = chain_head(b, node)
    var walked: u64 = 0
    var dropped: u64 = 0
    while ref != 0 {
        let s: u64 = slot_from_ref(b, ref)
        ref = kstate.get(s, S_LINK) & LINK_MASK
        walked = walked + 1
        let idx: u64 = kstate.get(s, S_KEY) >> 8
        if kstate.get(s, S_NODE) == node && idx >= first && idx <= last {
            invalidate(b, s)
            dropped = dropped + 1
        }
    }
    kstate.set(b, H_WALKED, kstate.get(b, H_WALKED) + walked)
    return dropped
}

fn drop_partial_before(b: u64, node: u64, first: u64) -> u64 {
    var ref: u64 = chain_head(b, node)
    var dropped: u64 = 0
    while ref != 0 {
        let s: u64 = slot_from_ref(b, ref)
        ref = kstate.get(s, S_LINK) & LINK_MASK
        if kstate.get(s, S_NODE) == node && (kstate.get(s, S_KEY) >> 8) < first && kstate.get(s, S_VALID) < PAGE_BYTES {
            invalidate(b, s)
            dropped = dropped + 1
        }
    }
    return dropped
}

fn drop_pages(state: u64, node: u64, off: u64, len: u64) {
    if len == 0 || kstate.mode_on(state, kstate.M_PCNOINVAL) {
        return
    }
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return
    }
    let first: u64 = off >> 12
    var last: u64 = (off + len - 1) >> 12
    if last < first {
        last = first
    }
    let flags: u64 = cachelock.take(b)
    kstate.set(b, H_EPOCH, kstate.get(b, H_EPOCH) + 1)
    kstate.set(b, H_DROP_CALLS, kstate.get(b, H_DROP_CALLS) + 1)
    var dropped: u64 = 0
    if last - first < PROBE_MAX_PAGES {
        dropped = drop_range_probe(b, node, first, last)
    } else {
        dropped = drop_range_chain(b, node, first, last)
    }
    if chain_partials(b, node) != 0 {
        dropped = dropped + drop_partial_before(b, node, first)
    }
    kstate.set(b, H_DROP_RANGE, kstate.get(b, H_DROP_RANGE) + dropped)
    cachelock.give(b, flags)
}

fn set_valid(b: u64, s: u64, node: u64, valid: u64) {
    let old: u64 = kstate.get(s, S_VALID)
    if old < PAGE_BYTES && valid >= PAGE_BYTES {
        kstate.set(b, chain_at(node), kstate.get(b, chain_at(node)) - PARTIAL_ONE)
    }
    kstate.set(s, S_VALID, valid)
}

fn patch_slot(b: u64, s: u64, node: u64, lo: u64, hi: u64, src: u64) {
    let valid: u64 = kstate.get(s, S_VALID)
    if lo <= valid {
        copy_out(kstate.get(s, S_FRAME) + lo, src, hi - lo)
        if hi > valid {
            set_valid(b, s, node, hi)
        }
        kstate.set(b, H_PATCHES, kstate.get(b, H_PATCHES) + 1)
    } else {
        invalidate(b, s)
    }
}

fn patch_run(state: u64, m: u64, node: u64, pos: u64, src: u64, len: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_PCNOINVAL) {
        return len
    }
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return len
    }
    let flags: u64 = cachelock.take(b)
    kstate.set(b, H_EPOCH, kstate.get(b, H_EPOCH) + 1)
    var done: u64 = 0
    var missing: bool = false
    while done < len && !missing {
        let at: u64 = pos + done
        let way: u64 = find_way(b, node, m, at >> 12)
        if way == 0 {
            missing = true
        } else {
            let lo: u64 = at & (PAGE_BYTES - 1)
            var span: u64 = PAGE_BYTES - lo
            if span > len - done {
                span = len - done
            }
            patch_slot(b, slot_at(b, node, m, at >> 12, way - 1), node, lo, lo + span, src + done)
            done = done + span
        }
    }
    cachelock.give(b, flags)
    return done
}

fn partials_of(state: u64, node: u64) -> u64 {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return 0
    }
    return chain_partials(b, node)
}

fn drop_partials_before(state: u64, node: u64, first: u64) {
    if kstate.mode_on(state, kstate.M_PCNOINVAL) {
        return
    }
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return
    }
    let flags: u64 = cachelock.take(b)
    if chain_partials(b, node) != 0 {
        let dropped: u64 = drop_partial_before(b, node, first)
        kstate.set(b, H_DROP_RANGE, kstate.get(b, H_DROP_RANGE) + dropped)
    }
    cachelock.give(b, flags)
}

fn note_write_alloc(state: u64) {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b != 0 {
        kstate.add(b, H_WRITE_ALLOCS, 1)
    }
}

fn drop_node(state: u64, m: u64, node: u64) {
    drop_where(state, 1, m, node)
}

fn drop_ino(state: u64, node: u64) {
    drop_where(state, 2, 0, node)
}

fn drop_mount(state: u64, m: u64) {
    drop_where(state, 3, m, 0)
}

fn drop_all(state: u64) {
    drop_where(state, 0, 0, 0)
}

fn take_frame(state: u64) -> u64 {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return 0
    }
    var f: u64 = 0
    let flags: u64 = cachelock.take(b)
    let slots: u64 = slot_count(b)
    var i: u64 = 0
    while i < slots && f == 0 {
        let s: u64 = slot_of(b, i)
        if kstate.get(s, S_BUSY) == 0 && kstate.get(s, S_PIN) == 0 && kstate.get(s, S_FRAME) != 0 {
            f = kstate.get(s, S_FRAME)
            if kstate.get(s, S_KEY) != 0 {
                chain_del(b, s)
            }
            kstate.set(s, S_KEY, 0)
            kstate.set(s, S_FRAME, 0)
            kstate.set(b, H_PAGES, kstate.get(b, H_PAGES) - 1)
            kstate.set(b, H_SHRUNK, kstate.get(b, H_SHRUNK) + 1)
            kstate.set(b, H_EPOCH, kstate.get(b, H_EPOCH) + 1)
        }
        i = i + 1
    }
    cachelock.give(b, flags)
    return f
}

fn note_bypass(state: u64) {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b != 0 {
        kstate.add(b, H_BYPASS, 1)
    }
}

fn hits(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_HITS)
}

fn misses(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_MISSES)
}

fn inserts(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_INSERTS)
}

fn evictions(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_EVICTS)
}

fn drops(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_DROPS)
}

fn resident(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_PAGES)
}

fn shrunk(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_SHRUNK)
}

fn bypassed(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_BYPASS)
}

fn stat(state: u64, off: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, off)
}

