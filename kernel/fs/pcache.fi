profile kernel

import lib.kstate
import fs.cachelock
import arch.arch

export {
    attach, sets_for, region_frames, MIN_SETS, read_hit, copy_out, begin_fill, attach_frame, finish_fill, abort_fill, buffer_of,
    drop_node, drop_ino, drop_mount, drop_all, take_frame,
    hits, misses, inserts, evictions, drops, resident, shrunk, bypassed,
    note_bypass, MISS, PAGE_BYTES, pin, unpin, valid_of,
    base_of, find_way, slot_at, pin_slot, unpin_slot, pin_page, frame_at
}

const MISS: u64 = 0xFFFFFFFFFFFFFFFF
const PAGE_BYTES: u64 = 4096
const WAYS: u64 = 8
const MIN_SETS: u64 = 32
const MAX_SETS: u64 = 4096
const FRAMES_PER_SLOT: u64 = 8
const SLOT_BYTES: u64 = 64
const FILTER_BUCKETS: u64 = 1024
const FILTER_AT: u64 = 4096
const SLOTS_AT: u64 = 12288
const GOLDEN: u64 = 0x9E3779B97F4A7C15
const H_EPOCH: u64 = 8
const H_CLOCK: u64 = 16
const H_HITS: u64 = 24
const H_MISSES: u64 = 32
const H_INSERTS: u64 = 40
const H_EVICTS: u64 = 48
const H_DROPS: u64 = 56
const H_PAGES: u64 = 64
const H_SHRUNK: u64 = 72
const H_BYPASS: u64 = 80
const H_SETS: u64 = 88
const H_MNT_LIVE: u64 = 96
const S_NODE: u64 = 0
const S_KEY: u64 = 8
const S_VALID: u64 = 16
const S_STAMP: u64 = 24
const S_FRAME: u64 = 32
const S_BUSY: u64 = 40
const S_PIN: u64 = 48

fn sets_for(total_frames: u64) -> u64 {
    var sets: u64 = MIN_SETS
    while sets < MAX_SETS && sets * WAYS * FRAMES_PER_SLOT < total_frames {
        sets = sets * 2
    }
    return sets
}

fn region_frames(sets: u64) -> u64 {
    return (SLOTS_AT + sets * WAYS * SLOT_BYTES + PAGE_BYTES - 1) / PAGE_BYTES
}

fn attach(state: u64, region: u64, sets: u64) {
    arch.fill_words(region, 0, region_frames(sets) * PAGE_BYTES / 8)
    kstate.set(region, H_CLOCK, 1)
    kstate.set(region, H_SETS, sets)
    kstate.set(state, kstate.PCACHE_BASE, region)
}

fn enabled(state: u64) -> bool {
    return !kstate.mode_on(state, kstate.M_NOPCACHE)
}

fn slot_of(b: u64, i: u64) -> u64 {
    return b + SLOTS_AT + i * SLOT_BYTES
}

fn key_of(m: u64, idx: u64) -> u64 {
    return (idx << 8) | (m + 1)
}

fn set_of(b: u64, node: u64, m: u64, idx: u64) -> u64 {
    let h: u64 = ((node ^ (m << 56)) *% GOLDEN) >> 32
    return (h + idx) & (kstate.get(b, H_SETS) - 1)
}

fn filter_at(node: u64) -> u64 {
    return FILTER_AT + (((node *% GOLDEN) >> 40) % FILTER_BUCKETS) * 8
}

fn filter_count(b: u64, node: u64) -> u64 {
    return kstate.get(b, filter_at(node))
}

fn filter_up(b: u64, node: u64) {
    kstate.set(b, filter_at(node), kstate.get(b, filter_at(node)) + 1)
}

fn filter_down(b: u64, node: u64) {
    let n: u64 = kstate.get(b, filter_at(node))
    if n > 0 {
        kstate.set(b, filter_at(node), n - 1)
    }
}

fn slot_count(b: u64) -> u64 {
    return kstate.get(b, H_SETS) * WAYS
}

fn copy_out(dst: u64, src: u64, n: u64) {
    arch.copy_octets(dst, src, n)
}

fn read_hit(state: u64, m: u64, node: u64, idx: u64, from: u64, n: u64, dst: u64) -> u64 {
    if !enabled(state) {
        return MISS
    }
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return MISS
    }
    let key: u64 = key_of(m, idx)
    let set: u64 = set_of(b, node, m, idx)
    let flags: u64 = cachelock.take(b)
    var way: u64 = 0
    while way < WAYS {
        let s: u64 = slot_of(b, set * WAYS + way)
        if kstate.get(s, S_KEY) == key && kstate.get(s, S_NODE) == node {
            let valid: u64 = kstate.get(s, S_VALID)
            if from + n <= valid || valid < PAGE_BYTES {
                var take: u64 = n
                if from >= valid {
                    take = 0
                } else if from + n > valid {
                    take = valid - from
                }
                copy_out(dst, kstate.get(s, S_FRAME) + from, take)
                let clock: u64 = kstate.get(b, H_CLOCK) + 1
                kstate.set(b, H_CLOCK, clock)
                kstate.set(s, S_STAMP, clock)
                kstate.set(b, H_HITS, kstate.get(b, H_HITS) + 1)
                cachelock.give(b, flags)
                return take
            }
        }
        way = way + 1
    }
    kstate.set(b, H_MISSES, kstate.get(b, H_MISSES) + 1)
    cachelock.give(b, flags)
    return MISS
}

fn base_of(state: u64) -> u64 {
    if !enabled(state) {
        return 0
    }
    return kstate.get(state, kstate.PCACHE_BASE)
}

fn find_way(b: u64, node: u64, m: u64, idx: u64) -> u64 {
    let key: u64 = key_of(m, idx)
    let sets_mask: u64 = __mmio_read64((b + H_SETS) as *mut u64) - 1
    let first: u64 = ((((node ^ (m << 56)) *% GOLDEN) >> 32) + idx) & sets_mask
    var s: u64 = b + SLOTS_AT + first * WAYS * SLOT_BYTES
    var way: u64 = 0
    while way < WAYS {
        if __mmio_read64((s + S_KEY) as *mut u64) == key && __mmio_read64((s + S_NODE) as *mut u64) == node {
            return way + 1
        }
        s = s + SLOT_BYTES
        way = way + 1
    }
    return 0
}

fn pin_page(b: u64, node: u64, m: u64, idx: u64, need: u64) -> u64 {
    let way: u64 = find_way(b, node, m, idx)
    if way == 0 {
        return 0
    }
    let s: u64 = slot_at(b, node, m, idx, way - 1)
    if __mmio_read64((s + S_VALID) as *mut u64) < need {
        return 0
    }
    pin_slot(b, s)
    return way
}

fn frame_at(b: u64, node: u64, m: u64, idx: u64, way: u64) -> u64 {
    return __mmio_read64((slot_at(b, node, m, idx, way) + S_FRAME) as *mut u64)
}

fn slot_at(b: u64, node: u64, m: u64, idx: u64, way: u64) -> u64 {
    return slot_of(b, set_of(b, node, m, idx) * WAYS + way)
}

fn pin_slot(b: u64, s: u64) {
    let clock: u64 = kstate.get(b, H_CLOCK) + 1
    kstate.set(b, H_CLOCK, clock)
    kstate.set(s, S_STAMP, clock)
    kstate.set(s, S_PIN, kstate.get(s, S_PIN) + 1)
    kstate.set(b, H_HITS, kstate.get(b, H_HITS) + 1)
}

fn unpin_slot(s: u64) {
    let n: u64 = kstate.get(s, S_PIN)
    if n > 0 {
        kstate.set(s, S_PIN, n - 1)
    }
}

fn pin(state: u64, m: u64, node: u64, idx: u64) -> u64 {
    let b: u64 = base_of(state)
    if b == 0 {
        return 0
    }
    let flags: u64 = cachelock.take(b)
    let way: u64 = find_way(b, node, m, idx)
    if way == 0 {
        cachelock.give(b, flags)
        return 0
    }
    let s: u64 = slot_at(b, node, m, idx, way - 1)
    pin_slot(b, s)
    cachelock.give(b, flags)
    return s
}

fn unpin(state: u64, slot: u64) {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    let flags: u64 = cachelock.take(b)
    unpin_slot(slot)
    cachelock.give(b, flags)
}

fn valid_of(slot: u64) -> u64 {
    return kstate.get(slot, S_VALID)
}

fn begin_fill(state: u64, m: u64, node: u64, idx: u64) -> u64 {
    if !enabled(state) {
        return 0
    }
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return 0
    }
    let set: u64 = set_of(b, node, m, idx)
    let flags: u64 = cachelock.take(b)
    kstate.set(b, H_MNT_LIVE, kstate.get(b, H_MNT_LIVE) | (1 << (m & 63)))
    var victim: u64 = 0
    var oldest: u64 = MISS
    var empty: bool = false
    var way: u64 = 0
    while way < WAYS {
        let s: u64 = slot_of(b, set * WAYS + way)
        if kstate.get(s, S_BUSY) == 0 && kstate.get(s, S_PIN) == 0 && !empty {
            if kstate.get(s, S_KEY) == 0 {
                victim = s
                empty = true
            } else if kstate.get(s, S_STAMP) < oldest {
                victim = s
                oldest = kstate.get(s, S_STAMP)
            }
        }
        way = way + 1
    }
    if victim == 0 {
        cachelock.give(b, flags)
        return 0
    }
    if kstate.get(victim, S_KEY) != 0 {
        kstate.set(b, H_EVICTS, kstate.get(b, H_EVICTS) + 1)
        filter_down(b, kstate.get(victim, S_NODE))
    }
    kstate.set(victim, S_KEY, 0)
    kstate.set(victim, S_BUSY, kstate.get(b, H_EPOCH) + 1)
    cachelock.give(b, flags)
    return victim
}

fn attach_frame(state: u64, slot: u64, frame: u64) {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    kstate.set(slot, S_FRAME, frame)
    kstate.add(b, H_PAGES, 1)
}

fn buffer_of(slot: u64) -> u64 {
    return kstate.get(slot, S_FRAME)
}

fn finish_fill(state: u64, slot: u64, m: u64, node: u64, idx: u64, valid: u64) {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    let flags: u64 = cachelock.take(b)
    if kstate.get(b, H_EPOCH) + 1 == kstate.get(slot, S_BUSY) && valid <= PAGE_BYTES {
        let clock: u64 = kstate.get(b, H_CLOCK) + 1
        kstate.set(b, H_CLOCK, clock)
        kstate.set(slot, S_NODE, node)
        kstate.set(slot, S_VALID, valid)
        kstate.set(slot, S_STAMP, clock)
        kstate.set(slot, S_KEY, key_of(m, idx))
        filter_up(b, node)
        kstate.set(b, H_INSERTS, kstate.get(b, H_INSERTS) + 1)
    }
    kstate.set(slot, S_BUSY, 0)
    cachelock.give(b, flags)
}

fn abort_fill(state: u64, slot: u64) {
    kstate.set(slot, S_BUSY, 0)
}

fn drop_where(state: u64, mode: u64, m: u64, node: u64) {
    if kstate.mode_on(state, kstate.M_PCNOINVAL) {
        return
    }
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return
    }
    if (mode == 1 || mode == 3) && (kstate.get(b, H_MNT_LIVE) & (1 << (m & 63))) == 0 {
        return
    }
    let flags: u64 = cachelock.take(b)
    kstate.set(b, H_EPOCH, kstate.get(b, H_EPOCH) + 1)
    var live: u64 = 0
    if (mode == 1 || mode == 2) && filter_count(b, node) == 0 {
        cachelock.give(b, flags)
        return
    }
    let slots: u64 = slot_count(b)
    var i: u64 = 0
    while i < slots {
        let s: u64 = slot_of(b, i)
        let key: u64 = kstate.get(s, S_KEY)
        if key != 0 {
            var hit: bool = mode == 0
            if mode == 1 {
                hit = kstate.get(s, S_NODE) == node && (key & 255) == m + 1
            } else if mode == 2 {
                hit = kstate.get(s, S_NODE) == node
            } else if mode == 3 {
                hit = (key & 255) == m + 1
            }
            if hit {
                kstate.set(s, S_KEY, 0)
                filter_down(b, kstate.get(s, S_NODE))
                kstate.set(b, H_DROPS, kstate.get(b, H_DROPS) + 1)
            } else {
                live = live | (1 << (((key & 255) - 1) & 63))
            }
        }
        i = i + 1
    }
    kstate.set(b, H_MNT_LIVE, live)
    cachelock.give(b, flags)
}

fn drop_node(state: u64, m: u64, node: u64) {
    drop_where(state, 1, m, node)
}

fn drop_ino(state: u64, node: u64) {
    drop_where(state, 2, 0, node)
}

fn drop_mount(state: u64, m: u64) {
    drop_where(state, 3, m, 0)
}

fn drop_all(state: u64) {
    drop_where(state, 0, 0, 0)
}

fn take_frame(state: u64) -> u64 {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b == 0 {
        return 0
    }
    var f: u64 = 0
    let flags: u64 = cachelock.take(b)
    let slots: u64 = slot_count(b)
    var i: u64 = 0
    while i < slots && f == 0 {
        let s: u64 = slot_of(b, i)
        if kstate.get(s, S_BUSY) == 0 && kstate.get(s, S_PIN) == 0 && kstate.get(s, S_FRAME) != 0 {
            f = kstate.get(s, S_FRAME)
            if kstate.get(s, S_KEY) != 0 {
                filter_down(b, kstate.get(s, S_NODE))
            }
            kstate.set(s, S_KEY, 0)
            kstate.set(s, S_FRAME, 0)
            kstate.set(b, H_PAGES, kstate.get(b, H_PAGES) - 1)
            kstate.set(b, H_SHRUNK, kstate.get(b, H_SHRUNK) + 1)
            kstate.set(b, H_EPOCH, kstate.get(b, H_EPOCH) + 1)
        }
        i = i + 1
    }
    cachelock.give(b, flags)
    return f
}

fn note_bypass(state: u64) {
    let b: u64 = kstate.get(state, kstate.PCACHE_BASE)
    if b != 0 {
        kstate.add(b, H_BYPASS, 1)
    }
}

fn hits(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_HITS)
}

fn misses(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_MISSES)
}

fn inserts(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_INSERTS)
}

fn evictions(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_EVICTS)
}

fn drops(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_DROPS)
}

fn resident(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_PAGES)
}

fn shrunk(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_SHRUNK)
}

fn bypassed(state: u64) -> u64 {
    return cachelock.field(state, kstate.PCACHE_BASE, H_BYPASS)
}
