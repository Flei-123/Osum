profile kernel

import lib.errno
import sched.sched
import serial
import fs.fs

export { PR_ZAP, zap }

const PR_ZAP: u64 = 0x4F535703

static mut t_done: [u8; 21] = "fszap: inode reset \0\0"
static mut t_type: [u8; 12] = " old type \0\0"
static mut t_deny: [u8; 22] = "fszap: refused inode \0"

fn refuse(ino: u64, e: u64) -> u64 {
    serial.puts((&t_deny[0]) as u64)
    serial.dec(ino)
    serial.nl()
    return e
}

fn zap(state: u64, me: u64, ino: u64) -> u64 {
    if sched.tget(state, me, sched.T_EUID) != 0 {
        return refuse(ino, errno.E_PERM)
    }
    if !fs.ready(state) || ino <= 1 || ino > fs.inode_count(state) || ino == fs.root(state) {
        return refuse(ino, errno.E_INVAL)
    }
    let old: u64 = fs.inode_type(state, ino)
    if old == fs.T_DIR {
        return refuse(ino, errno.E_ISDIR)
    }
    if !fs.inode_zap(state, ino) {
        return refuse(ino, errno.E_IO)
    }
    serial.puts((&t_done[0]) as u64)
    serial.dec(ino)
    serial.puts((&t_type[0]) as u64)
    serial.hex(old)
    serial.nl()
    return 0
}
