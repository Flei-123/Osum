profile kernel

import lib.kstate
import fs.ofsj

export {
    RUN_SLOTS, INODE_SLOTS, SPARE_SLOTS, enabled, scope_begin, scope_end, active, pending, due_pressure,
    push_block, push_inode, reset, seal, take_run, take_inode, took_start, took_len, took_ino,
    queued_blocks, queued_inodes
}

const RUN_SLOTS: u64 = 128
const INODE_SLOTS: u64 = 128
const SPARE_SLOTS: u64 = 16
const UNSEALED: u64 = 0xFFFFFFFFFFFFFFFF

static mut run_state: [u64; 128] = [0 as u64; 128]
static mut run_start: [u64; 128] = [0 as u64; 128]
static mut run_len: [u64; 128] = [0 as u64; 128]
static mut run_epoch: [u64; 128] = [0 as u64; 128]
static mut inode_state: [u64; 128] = [0 as u64; 128]
static mut inode_no: [u64; 128] = [0 as u64; 128]
static mut inode_epoch: [u64; 128] = [0 as u64; 128]
static mut last_run: [u64; 1] = [0 as u64; 1]
static mut used_runs: [u64; 1] = [0 as u64; 1]
static mut used_inodes: [u64; 1] = [0 as u64; 1]
static mut scope_on: [u64; 1] = [0 as u64; 1]
static mut took: [u64; 3] = [0 as u64; 3]

fn enabled(state: u64) -> bool {
    return !ofsj.enabled(state) && !kstate.mode_on(state, kstate.M_NODEFERFREE)
}

fn scope_begin(state: u64) {
    scope_on[0] = 0
    if enabled(state) {
        scope_on[0] = 1
    }
}

fn scope_end() {
    scope_on[0] = 0
}

fn active() -> bool {
    return scope_on[0] != 0
}

fn pending() -> bool {
    return used_runs[0] != 0 || used_inodes[0] != 0
}

fn due_pressure() -> bool {
    return used_runs[0] > RUN_SLOTS - SPARE_SLOTS || used_inodes[0] > INODE_SLOTS - SPARE_SLOTS
}

fn reset(state: u64) {
    var i: u64 = 0
    while i < RUN_SLOTS {
        if run_state[i as usize] == state {
            run_state[i as usize] = 0
            used_runs[0] = used_runs[0] - 1
        }
        if inode_state[i as usize] == state {
            inode_state[i as usize] = 0
            used_inodes[0] = used_inodes[0] - 1
        }
        i = i + 1
    }
}

fn push_block(state: u64, block: u64) -> bool {
    let at: u64 = last_run[0]
    if run_state[at as usize] == state && run_epoch[at as usize] == UNSEALED
        && block == run_start[at as usize] + run_len[at as usize] {
        run_len[at as usize] = run_len[at as usize] + 1
        return true
    }
    var i: u64 = 0
    while i < RUN_SLOTS {
        if run_state[i as usize] == 0 {
            run_state[i as usize] = state
            run_start[i as usize] = block
            run_len[i as usize] = 1
            run_epoch[i as usize] = UNSEALED
            last_run[0] = i
            used_runs[0] = used_runs[0] + 1
            return true
        }
        i = i + 1
    }
    return false
}

fn push_inode(state: u64, ino: u64) -> bool {
    var i: u64 = 0
    while i < INODE_SLOTS {
        if inode_state[i as usize] == 0 {
            inode_state[i as usize] = state
            inode_no[i as usize] = ino
            inode_epoch[i as usize] = UNSEALED
            used_inodes[0] = used_inodes[0] + 1
            return true
        }
        i = i + 1
    }
    return false
}

fn seal(state: u64, epoch: u64) {
    var i: u64 = 0
    while i < RUN_SLOTS {
        if run_state[i as usize] == state && run_epoch[i as usize] == UNSEALED {
            run_epoch[i as usize] = epoch
        }
        if inode_state[i as usize] == state && inode_epoch[i as usize] == UNSEALED {
            inode_epoch[i as usize] = epoch
        }
        i = i + 1
    }
}

fn take_run(state: u64, epoch: u64) -> bool {
    var i: u64 = 0
    while i < RUN_SLOTS {
        if run_state[i as usize] == state && run_epoch[i as usize] != UNSEALED && run_epoch[i as usize] < epoch {
            took[0] = run_start[i as usize]
            took[1] = run_len[i as usize]
            run_state[i as usize] = 0
            used_runs[0] = used_runs[0] - 1
            return true
        }
        i = i + 1
    }
    return false
}

fn take_inode(state: u64, epoch: u64) -> bool {
    var i: u64 = 0
    while i < INODE_SLOTS {
        if inode_state[i as usize] == state && inode_epoch[i as usize] != UNSEALED && inode_epoch[i as usize] < epoch {
            took[2] = inode_no[i as usize]
            inode_state[i as usize] = 0
            used_inodes[0] = used_inodes[0] - 1
            return true
        }
        i = i + 1
    }
    return false
}

fn took_start() -> u64 {
    return took[0]
}

fn took_len() -> u64 {
    return took[1]
}

fn took_ino() -> u64 {
    return took[2]
}

fn queued_blocks(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < RUN_SLOTS {
        if run_state[i as usize] == state {
            n = n + run_len[i as usize]
        }
        i = i + 1
    }
    return n
}

fn queued_inodes(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < INODE_SLOTS {
        if inode_state[i as usize] == state {
            n = n + 1
        }
        i = i + 1
    }
    return n
}
