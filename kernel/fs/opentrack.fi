profile kernel

import libc.regio

export { MAX, PATH_MAX, find, add, path_at, len_at, writable_at, release }

const MAX: u64 = 64
const PATH_BYTES: u64 = 112
const PATH_MAX: u64 = 111

static mut slot_of: [u64; 64] = [0 as u64; 64]
static mut slot_len: [u64; 64] = [0 as u64; 64]
static mut slot_write: [u64; 64] = [0 as u64; 64]
static mut slot_path: [u8; 7168] = [0 as u8; 7168]

fn path_at(i: u64) -> u64 {
    return (&slot_path[0]) as u64 + i * PATH_BYTES
}

fn len_at(i: u64) -> u64 {
    return slot_len[i as usize]
}

fn writable_at(i: u64) -> bool {
    return slot_write[i as usize] != 0
}

fn find(of: u64) -> u64 {
    var i: u64 = 0
    while i < MAX {
        if slot_of[i as usize] == of + 1 {
            return i
        }
        i = i + 1
    }
    return MAX
}

fn add(of: u64, path: u64, len: u64, writable: bool) {
    if len > PATH_MAX || find(of) != MAX {
        return
    }
    var i: u64 = 0
    while i < MAX {
        if slot_of[i as usize] == 0 {
            slot_of[i as usize] = of + 1
            slot_len[i as usize] = len
            slot_write[i as usize] = 0
            if writable {
                slot_write[i as usize] = 1
            }
            var o: u64 = 0
            while o < len {
                regio.write8(path_at(i) + o, regio.read8(path + o))
                o = o + 1
            }
            return
        }
        i = i + 1
    }
}

fn release(i: u64) {
    slot_of[i as usize] = 0
}
