
profile kernel

import lib.kstate

export {
    init, ready, note, take, seq, lost, count,
    REC, R_INO, R_PARENT, R_SIZE, R_KIND, R_NAME, R_OP,
    OP_ADD, OP_DEL, OP_SIZE, MAXJ, NAMEJ
}

const REC: u64 = 64
const R_INO: u64 = 0
const R_PARENT: u64 = 8
const R_SIZE: u64 = 16
const R_KIND: u64 = 24
const R_NAME: u64 = 32
const R_OP: u64 = 56
const NAMEJ: u64 = 24

const OP_ADD: u64 = 1
const OP_DEL: u64 = 2
const OP_SIZE: u64 = 3

const H_SEQ: u64 = 0x00
const H_HEAD: u64 = 0x08
const H_LOST: u64 = 0x10
const H_READY: u64 = 0x18
const H_BASE: u64 = 0x40
const MAXJ: u64 = 127

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.JRNL_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.JRNL_OFF + off, v)
}

fn slot_off(k: u64) -> u64 {
    return kstate.JRNL_OFF + H_BASE + (k % MAXJ) * REC
}

fn ready(state: u64) -> bool {
    return g(state, H_READY) != 0
}

fn seq(state: u64) -> u64 {
    return g(state, H_SEQ)
}

fn lost(state: u64) -> u64 {
    return g(state, H_LOST)
}

fn count(state: u64) -> u64 {
    let n: u64 = g(state, H_SEQ)
    if n > MAXJ {
        return MAXJ
    }
    return n
}

fn init(state: u64) -> bool {
    var i: u64 = 0
    while i < kstate.JRNL_MAX {
        kstate.set8(state + kstate.JRNL_OFF + i, 0 as u8)
        i = i + 1
    }
    s(state, H_READY, 1)
    return true
}

fn note(state: u64, op: u64, dir: u64, ino: u64, kind: u64, size: u64,
    name: u64) {
    if !ready(state) {
        return
    }
    let n: u64 = g(state, H_SEQ)
    let off: u64 = slot_off(n)
    kstate.set(state, off + R_INO, ino)
    kstate.set(state, off + R_PARENT, dir)
    kstate.set(state, off + R_SIZE, size)
    kstate.set(state, off + R_KIND, kind)
    kstate.set(state, off + R_OP, op)
    var k: u64 = 0
    while k < NAMEJ {
        var c: u64 = 0
        if name != 0 {
            c = kstate.get8(name + k)
        }
        kstate.set8(state + off + R_NAME + k, c as u8)
        k = k + 1
    }
    s(state, H_SEQ, n + 1)
    s(state, H_HEAD, (n + 1) % MAXJ)
}

fn take(state: u64, from: u64, out: u64, max: u64) -> u64 {
    let ende: u64 = g(state, H_SEQ)
    var first: u64 = 0
    if ende > MAXJ {
        first = ende - MAXJ
    }
    var f: u64 = from
    if f < first {
        s(state, H_LOST, g(state, H_LOST) + (first - f))
        f = first
    }
    var n: u64 = 0
    while f + n < ende && n < max {
        let von: u64 = state + slot_off(f + n)
        let move_to: u64 = out + n * REC
        var k: u64 = 0
        while k < REC {
            kstate.set8(move_to + k, kstate.get8(von + k) as u8)
            k = k + 1
        }
        n = n + 1
    }
    return n
}
