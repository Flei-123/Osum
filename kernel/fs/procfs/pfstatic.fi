profile kernel

import fs.procfs.pfwrite

export { make, TOP_COUNT, NET_COUNT }

const TOP_COUNT: u64 = 6
const NET_COUNT: u64 = 6

static mut blob: [u8; 502] = b"version 15\x0atimestamp 0\x0aNum       RefCount Protocol Flags    Type St Inode Path\x0a  sl  local_address                         remote_address                        st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode\x0a  sl  local_address                         remote_address                        st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode ref pointer drops\x0a  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode ref pointer drops\x0a"

static mut offsets: [u64; 12] = [0, 0, 0, 0, 0, 0, 23, 79, 224, 387, 502, 502]

static mut lengths: [u64; 12] = [0, 0, 0, 0, 0, 23, 56, 145, 163, 115, 0, 0]

fn make(state: u64, index: u64) -> u64 {
    if index >= 12 {
        return 0
    }
    return pfwrite.w_bytes(state, 0, ((&blob[0]) as u64) + offsets[index as usize], lengths[index as usize])
}
