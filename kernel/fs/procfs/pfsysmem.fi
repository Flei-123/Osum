profile kernel

import lib.kstate
import fs.procfs.pfproc

export { BLOCK_COUNT, block_size_line }

const BLOCK_COUNT: u64 = 4
const MIB: u64 = 1048576
const HEX_DIGITS: u64 = 16

fn block_size(state: u64) -> u64 {
    let size: u64 = (kstate.get(state, kstate.MEM_USABLE) / BLOCK_COUNT / MIB) * MIB
    if size < MIB {
        return MIB
    }
    return size
}

fn block_size_line(state: u64) -> u64 {
    return pfproc.w_nl(state, pfproc.w_hexn(state, 0, block_size(state), HEX_DIGITS))
}
