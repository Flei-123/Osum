profile kernel

import arch.cpu
import lib.kstate
import fs.procfs.pfproc
import fs.procfs.pfwrite

export { make }

const COLUMN_WIDTH: u64 = 11
const LABEL_WIDTH: u64 = 5

fn header(state: u64, cpus: u64) -> u64 {
    var cpu_word: [u8; 4] = "CPU\0"
    var p: u64 = pfwrite.w_spaces(state, 0, LABEL_WIDTH)
    var i: u64 = 0
    while i < cpus {
        p = pfwrite.w_spaces(state, p, COLUMN_WIDTH - 3 - pfwrite.digits_of(i))
        p = pfproc.w_str(state, p, (&cpu_word[0]) as u64)
        p = pfproc.w_num(state, p, i)
        i = i + 1
    }
    return pfproc.w_nl(state, p)
}

fn local_timer(state: u64, cpus: u64, start: u64) -> u64 {
    var label: [u8; 5] = "LOC:\0"
    var text: [u8; 25] = "  Local timer interrupts\0"
    var p: u64 = pfproc.w_ch(state, start, 32)
    p = pfproc.w_str(state, p, (&label[0]) as u64)
    var i: u64 = 0
    while i < cpus {
        p = pfwrite.w_pad_num(state, p, cpu.get(state, i, cpu.C_TICKS), COLUMN_WIDTH)
        i = i + 1
    }
    p = pfproc.w_str(state, p, (&text[0]) as u64)
    return pfproc.w_nl(state, p)
}

fn make(state: u64) -> u64 {
    var cpus: u64 = cpu.count(state)
    if cpus > kstate.MAX_CPUS {
        cpus = kstate.MAX_CPUS
    }
    if cpus == 0 {
        cpus = 1
    }
    return local_timer(state, cpus, header(state, cpus))
}
