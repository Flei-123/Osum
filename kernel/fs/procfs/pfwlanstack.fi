profile kernel

import net.inet
import net.netdev
import net.wlan_net
import net.wlan_link
import net.wlan_auto
import net.wlan_count
import fs.procfs.pfproc

export { write }

fn label(state: u64, at: u64, s: u64, v: u64) -> u64 {
    let p: u64 = pfproc.w_str(state, at, s)
    return pfproc.w_num(state, p, v)
}

fn label_ip(state: u64, at: u64, s: u64, v: u64) -> u64 {
    let p: u64 = pfproc.w_str(state, at, s)
    return pfproc.w_ip4(state, p, v)
}

const DHCP_DNS1: u64 = 4

fn active_dns(state: u64) -> u64 {
    if netdev.kind_on(state, netdev.uplink(state)) == netdev.KIND_WLAN {
        return wlan_auto.lease_dns()
    }
    return inet.dhcp_get(DHCP_DNS1)
}

fn counter(state: u64, at: u64, s: u64, which: u64) -> u64 {
    return label(state, at, s, wlan_count.get(which))
}

fn write_wire(state: u64, at: u64) -> u64 {
    var l_wire: [u8; 13] = "wire arp tx=\0"
    var l_rq: [u8; 7] = " rxrq=\0"
    var l_rp: [u8; 7] = " rxrp=\0"
    var l_txrp: [u8; 7] = " txrp=\0"
    var l_icmp: [u8; 10] = " icmp tx=\0"
    var l_irep: [u8; 8] = " rxrep=\0"
    var l_ioth: [u8; 8] = " rxoth=\0"
    var l_st: [u8; 11] = " stk icmp=\0"
    var l_stecho: [u8; 7] = " echo=\0"
    var l_starp: [u8; 6] = " arp=\0"
    var l_starpsup: [u8; 9] = " arpsup=\0"
    var l_tcp: [u8; 9] = " tcp tx=\0"
    var l_rxtcp: [u8; 5] = " rx=\0"
    var l_udp: [u8; 9] = " udp tx=\0"
    var l_err: [u8; 11] = " err conv=\0"
    var l_send: [u8; 7] = " send=\0"
    var l_last: [u8; 7] = " last=\0"
    var p: u64 = counter(state, at, (&l_wire[0]) as u64, wlan_count.C_TX_ARP_REQ)
    p = counter(state, p, (&l_rq[0]) as u64, wlan_count.C_RX_ARP_REQ)
    p = counter(state, p, (&l_rp[0]) as u64, wlan_count.C_RX_ARP_REP)
    p = counter(state, p, (&l_txrp[0]) as u64, wlan_count.C_TX_ARP_REP)
    p = counter(state, p, (&l_icmp[0]) as u64, wlan_count.C_TX_ICMP_REQ)
    p = counter(state, p, (&l_irep[0]) as u64, wlan_count.C_RX_ICMP_REPLY)
    p = counter(state, p, (&l_ioth[0]) as u64, wlan_count.C_RX_ICMP_OTHER)
    p = label(state, p, (&l_st[0]) as u64, inet.tx_kind_count(state, inet.TXK_ICMP))
    p = label(state, p, (&l_stecho[0]) as u64, inet.echoes(state))
    p = label(state, p, (&l_starp[0]) as u64, inet.tx_kind_count(state, inet.TXK_ARP))
    p = label(state, p, (&l_starpsup[0]) as u64, inet.tx_kind_count(state, inet.TXK_ARP_SUPPRESSED))
    p = counter(state, p, (&l_tcp[0]) as u64, wlan_count.C_TX_TCP)
    p = counter(state, p, (&l_rxtcp[0]) as u64, wlan_count.C_RX_TCP)
    p = counter(state, p, (&l_udp[0]) as u64, wlan_count.C_TX_UDP)
    p = counter(state, p, (&l_rxtcp[0]) as u64, wlan_count.C_RX_UDP)
    p = counter(state, p, (&l_err[0]) as u64, wlan_count.C_CONV_FAIL)
    p = counter(state, p, (&l_send[0]) as u64, wlan_count.C_SEND_FAIL)
    p = counter(state, p, (&l_last[0]) as u64, wlan_count.C_LAST_ERR)
    return pfproc.w_nl(state, p)
}

fn write(state: u64, at: u64) -> u64 {
    var l_stack: [u8; 13] = "stack wired=\0"
    var l_up: [u8; 9] = " uplink=\0"
    var l_kind: [u8; 7] = " kind=\0"
    var l_ip: [u8; 5] = " ip=\0"
    var l_gw: [u8; 5] = " gw=\0"
    var l_gwmac: [u8; 8] = " gwmac=\0"
    var l_none: [u8; 5] = "none\0"
    var l_rx: [u8; 5] = " rx=\0"
    var l_tx: [u8; 5] = " tx=\0"
    var l_drop: [u8; 7] = " drop=\0"
    var l_echo: [u8; 7] = " echo=\0"
    var l_dns: [u8; 6] = " dns=\0"
    var l_txfull: [u8; 9] = " txfull=\0"
    var l_amsdu: [u8; 8] = " amsdu=\0"
    var l_addba: [u8; 8] = " addba=\0"
    var w: u64 = 0
    if wlan_link.wired() { w = 1 }
    var p: u64 = label(state, at, (&l_stack[0]) as u64, w)
    p = label(state, p, (&l_up[0]) as u64, netdev.uplink(state))
    p = label(state, p, (&l_kind[0]) as u64, netdev.kind_on(state, netdev.uplink(state)))
    let gw: u64 = inet.gw(state)
    p = label_ip(state, p, (&l_ip[0]) as u64, inet.ip(state))
    p = label_ip(state, p, (&l_gw[0]) as u64, gw)
    p = pfproc.w_str(state, p, (&l_gwmac[0]) as u64)
    var mac: u64 = 0
    if gw != 0 { mac = inet.hop_mac(state, gw) }
    if mac == 0 {
        p = pfproc.w_str(state, p, (&l_none[0]) as u64)
    } else {
        p = pfproc.w_mac_packed(state, p, mac)
    }
    p = label(state, p, (&l_rx[0]) as u64, wlan_net.rx_frames_on(state, 0))
    p = label(state, p, (&l_tx[0]) as u64, wlan_net.tx_frames_on(state, 0))
    p = label(state, p, (&l_drop[0]) as u64, wlan_net.rx_drops())
    p = label(state, p, (&l_echo[0]) as u64, wlan_auto.echo_get())
    p = label(state, p, (&l_txfull[0]) as u64, wlan_auto.txfull_get())
    p = label(state, p, (&l_amsdu[0]) as u64, wlan_auto.amsdu_get())
    p = label(state, p, (&l_addba[0]) as u64, wlan_auto.addba_get())
    p = label_ip(state, p, (&l_dns[0]) as u64, active_dns(state))
    p = pfproc.w_nl(state, p)
    return write_wire(state, p)
}
