profile kernel

import lib.kstate
import sched.taskconst
import sched.taskslot

export { group_of, count, nth, find, listed }

fn group_of(state: u64, t: u64) -> u64 {
    let g: u64 = taskslot.tget(state, t, taskconst.T_TGID)
    if g == 0 {
        return taskslot.tget(state, t, taskconst.T_PID)
    }
    return g
}

fn member(state: u64, i: u64, group: u64) -> bool {
    let s: u64 = taskslot.tget(state, i, taskconst.T_STATE)
    if s == taskconst.S_FREE || s == taskconst.S_ZOMBIE {
        return false
    }
    return group_of(state, i) == group
}

fn count(state: u64, t: u64) -> u64 {
    let group: u64 = group_of(state, t)
    let total: u64 = kstate.get(state, kstate.TASKS)
    var n: u64 = 0
    var i: u64 = 0
    while i < total {
        if member(state, i, group) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn nth(state: u64, t: u64, index: u64) -> u64 {
    let group: u64 = group_of(state, t)
    let total: u64 = kstate.get(state, kstate.TASKS)
    var seen: u64 = 0
    var i: u64 = 0
    while i < total {
        if member(state, i, group) {
            if seen == index {
                return i
            }
            seen = seen + 1
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

fn find(state: u64, t: u64, tid: u64) -> u64 {
    let group: u64 = group_of(state, t)
    let total: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < total {
        if member(state, i, group) && taskslot.tget(state, i, taskconst.T_PID) == tid {
            return i
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

fn listed(state: u64, t: u64) -> bool {
    if taskslot.tget(state, t, taskconst.T_STATE) == taskconst.S_FREE {
        return false
    }
    return group_of(state, t) == taskslot.tget(state, t, taskconst.T_PID)
}
