profile kernel

import lib.kstate
import fs.procfs.pfproc

export { w_le64, w_hex_upper, w_spaces, w_pad_num, w_field_num, w_kb_line, w_bytes, digits_of }

const DECIMAL: u64 = 10
const SPACE: u64 = 32
const COLON: u64 = 58
const LABEL_WIDTH: u64 = 15
const KB_WIDTH: u64 = 8
const HEX_LETTER_BASE: u64 = 55
const DIGIT_BASE: u64 = 48

fn w_hex_upper(state: u64, at: u64, v: u64, digits: u64) -> u64 {
    var p: u64 = at
    var i: u64 = digits
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * 4)) & 15
        if d < DECIMAL {
            p = pfproc.w_ch(state, p, d + DIGIT_BASE)
        } else {
            p = pfproc.w_ch(state, p, d + HEX_LETTER_BASE)
        }
    }
    return p
}

fn w_spaces(state: u64, at: u64, n: u64) -> u64 {
    var p: u64 = at
    var i: u64 = 0
    while i < n {
        p = pfproc.w_ch(state, p, SPACE)
        i = i + 1
    }
    return p
}

fn digits_of(v: u64) -> u64 {
    var n: u64 = 1
    var x: u64 = v
    while x >= DECIMAL {
        x = x / DECIMAL
        n = n + 1
    }
    return n
}

fn w_pad_num(state: u64, at: u64, v: u64, width: u64) -> u64 {
    var p: u64 = at
    let used: u64 = digits_of(v)
    if used < width {
        p = w_spaces(state, p, width - used)
    }
    return pfproc.w_num(state, p, v)
}

fn w_field_num(state: u64, at: u64, v: u64) -> u64 {
    let p: u64 = pfproc.w_ch(state, at, SPACE)
    return pfproc.w_num(state, p, v)
}

fn str_len(s: u64) -> u64 {
    var n: u64 = 0
    while kstate.get8(s + n) != 0 {
        n = n + 1
    }
    return n
}

fn w_kb_line(state: u64, at: u64, label: u64, kb: u64) -> u64 {
    var kb_suffix: [u8; 4] = " kB\0"
    var p: u64 = pfproc.w_str(state, at, label)
    p = pfproc.w_ch(state, p, COLON)
    let used: u64 = str_len(label) + 1
    if used < LABEL_WIDTH {
        p = w_spaces(state, p, LABEL_WIDTH - used)
    }
    p = w_pad_num(state, p, kb, KB_WIDTH)
    p = pfproc.w_str(state, p, (&kb_suffix[0]) as u64)
    return pfproc.w_nl(state, p)
}

fn w_bytes(state: u64, at: u64, src: u64, n: u64) -> u64 {
    var p: u64 = at
    var i: u64 = 0
    while i < n {
        p = pfproc.w_ch(state, p, kstate.get8(src + i))
        i = i + 1
    }
    return p
}

fn w_le64(state: u64, at: u64, v: u64) -> u64 {
    var p: u64 = at
    var i: u64 = 0
    while i < 8 {
        p = pfproc.w_ch(state, p, (v >> (i * 8)) & 255)
        i = i + 1
    }
    return p
}
