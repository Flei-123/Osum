profile kernel

const K_ROOT: u64 = 1

const K_SFS: u64 = 8

const SF_ROOT: u64 = 1

const BUF_MAX: u64 = 131072

static mut render_buf: [u8; 131072] = [0 as u8; 131072]

fn render_buf_addr() -> u64 {
    return (&render_buf[0]) as u64
}

const COUNT_ONLY: u64 = 0x4000000000000000

static mut window_base_cell: [u64; 1] = [0]

fn window_base() -> u64 {
    return window_base_cell[0]
}

fn set_window(base: u64) {
    window_base_cell[0] = base
}
