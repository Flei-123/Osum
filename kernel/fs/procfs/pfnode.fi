const K_GLOBAL: u64 = 2

const K_PIDDIR: u64 = 3

const K_PIDFILE: u64 = 4

const K_FDDIR: u64 = 5

const K_FDFILE: u64 = 6

const K_SYS: u64 = 7

const SF_DEVICES: u64 = 2

const SF_SYSTEM: u64 = 3

const SF_CPU: u64 = 4

const SF_ONLINE: u64 = 5

const SF_POSSIBLE: u64 = 6

const SF_PRESENT: u64 = 7

const SF_CPUN: u64 = 8

const SF_CACHE: u64 = 9

const SF_IDX0: u64 = 10

const SF_C_LEVEL: u64 = 11

const SF_C_TYPE: u64 = 12

const SF_C_SIZE: u64 = 13

const SF_C_LINE: u64 = 14

const SF_C_SETS: u64 = 15

const SF_C_WAYS: u64 = 16

const G_MEMINFO: u64 = 1

const G_CPUINFO: u64 = 2

const G_UPTIME: u64 = 3

const G_MOUNTS: u64 = 4

const G_STAT: u64 = 5

const G_VERSION: u64 = 6

const G_HWID: u64 = 7

const G_KLOG: u64 = 8

const G_LOADAVG: u64 = 9

const G_SYSDIR: u64 = 10

const G_NETDIR: u64 = 11

const G_PCI: u64 = 12

const G_USB: u64 = 13

const G_FIRMWARE: u64 = 14

const G_WLAN: u64 = 15

const G_APPS: u64 = 16

const G_ODB: u64 = 17

const G_BENCH: u64 = 18

const G_FRAMES: u64 = 19

const G_ACPI: u64 = 20

const G_SYSMON: u64 = 21

const G_GPU: u64 = 22

const G_SAFE: u64 = 23

const G_DMAR: u64 = 24

const G_DRIVERS: u64 = 25

const G_BACKLIGHT: u64 = 26

const G_CPUS: u64 = 27

const G_INPUTDEVS: u64 = 28

const G_HOTKEYS: u64 = 29

const G_USBNET: u64 = 30

const G_WLANPOLL: u64 = 31

const G_WLANIRQ: u64 = 32

const G_CLOCK: u64 = 33

const G_USBSUM: u64 = 34

const G_ACPIDUMP: u64 = 35

const G_BATTERY: u64 = 36

const G_BRAND: u64 = 37

const G_THERMAL: u64 = 38

const G_PCIE: u64 = 39

const G_TOUCHEV: u64 = 40

const G_RANDOM: u64 = 41

const G_UEVENT: u64 = 42

const G_WATCHDOG: u64 = 43

const G_WDTHANG: u64 = 44

const G_BLUETOOTH: u64 = 45

const G_FSAUDIT: u64 = 46

const G_VMXCAPS: u64 = 47

const G_WLANTRACE: u64 = 48

const G_TPM: u64 = 49

const G_VFSCACHE: u64 = 50

const G_LAST: u64 = 50

const F_STATUS: u64 = 1

const F_STAT: u64 = 2

const F_CMDLINE: u64 = 3

const F_MAPS: u64 = 4

const F_FD: u64 = 5

const F_LIMITS: u64 = 6

const F_CGROUP: u64 = 7

const F_EXE: u64 = 8

const F_CWD: u64 = 9

const F_MMAPLOG: u64 = 10

const F_LAST: u64 = 10

fn build(state: u64, n: u64) -> u64 {
    let art: u64 = pfproc.n_art(n)
    let slot: u64 = pfproc.n_slot(n)
    let sub: u64 = pfproc.n_sub(n)
    if art == pfbase.K_SFS {
        return sfs_build(state, sub)
    }
    if art == K_GLOBAL {
        if sub == G_MEMINFO {
            return pfproc.make_meminfo(state)
        }
        if sub == G_CPUINFO {
            return pfproc.make_cpuinfo(state)
        }
        if sub == G_UPTIME {
            return pfproc.make_uptime(state)
        }
        if sub == G_MOUNTS {
            return pfproc.make_mounts(state)
        }
        if sub == G_STAT {
            return pfproc.make_stat(state)
        }
        if sub == G_VERSION {
            return pfproc.make_version(state)
        }
        if sub == G_HWID {
            return pfproc.make_hwid(state)
        }
        if sub == G_KLOG {
            return pfproc.make_klog(state)
        }
        if sub == G_LOADAVG {
            return pfproc.make_loadavg(state)
        }
        if sub == G_PCI {
            return pfproc.make_pci(state)
        }
        if sub == G_USB {
            return pfsys.make_usb(state)
        }
        if sub == G_FIRMWARE {
            return pfsys.make_firmware(state)
        }
        if sub == G_WLAN {
            return pfsys.make_wlan(state)
        }
        if sub == G_USBNET {
            return pfsys.make_usbnet(state)
        }
        if sub == G_APPS {
            return pfsys.make_apps(state)
        }
        if sub == G_ODB {
            return pfsys.make_odb(state)
        }
        if sub == G_ACPI {
            return acpidev.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_SAFE {
            return pfsys.make_safe(state)
        }
        if sub == G_DMAR {
            return dmar.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_BACKLIGHT {
            return blchain.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_CPUS {
            return pfproc.make_cpus(state)
        }
        if sub == G_HOTKEYS {
            hkdiag.set(hkdiag.I2CHID_DEVICES, i2chid.ndev())
            return hotkeys.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_WLANPOLL {
            return pfsys.make_wlanpoll(state)
        }
        if sub == G_WLANIRQ {
            return pfsys.make_wlanirq(state)
        }
        if sub == G_CLOCK {
            return pfsys.make_clock(state)
        }
        if sub == G_USBSUM {
            return procusb.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_BATTERY {
            return pfsys.make_battery(state)
        }
        if sub == G_BRAND {
            return pfsys.make_brand(state)
        }
        if sub == G_UEVENT {
            return uevent.render(pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_WATCHDOG {
            return wdtview.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_WDTHANG {
            return wdtview.render_hang(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_BLUETOOTH {
            return procbt.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_FSAUDIT {
            return fsaudit.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_VMXCAPS {
            return vmxcaps.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_VFSCACHE {
            return vfscview.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_TPM {
            return tpmprobe.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_RANDOM {
            return randview.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_THERMAL {
            return thermview.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_PCIE {
            return pcie.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_ACPIDUMP || sub == G_WLANTRACE {
            return 0
        }
        if sub == G_INPUTDEVS {
            return i2chid.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_TOUCHEV {
            return evring.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_DRIVERS {
            return drvdev.render(state, pfproc.buf(state), pfbase.BUF_MAX)
        }
        if sub == G_BENCH {
            return pfsys.make_bench(state)
        }
        if sub == G_FRAMES {
            return pfsys.make_frames(state)
        }
        if sub == G_SYSMON {
            return pfsys.make_sysmon(state)
        }
        if sub == G_GPU {
            return pfsys.make_gpu(state)
        }
        return 0
    }
    if art == K_SYS {
        return pfsys.make_sys(state, sub)
    }
    if art == K_PIDFILE {
        if !pfproc.alive(state, slot) {
            return 0
        }
        if sub == F_STATUS {
            return pfproc.make_status(state, slot)
        }
        if sub == F_STAT {
            return pfproc.make_pstat(state, slot)
        }
        if sub == F_CMDLINE {
            return pfproc.make_cmdline(state, slot)
        }
        if sub == F_MAPS {
            return pfproc.make_maps(state, slot)
        }
        if sub == F_LIMITS {
            return pfsys.make_limits(state, slot)
        }
        if sub == F_MMAPLOG {
            return pfsys.make_mmaplog(state, slot)
        }
        if sub == F_CGROUP {
            return pfsys.make_cgroup(state)
        }
        if sub == F_EXE {
            return pfproc.make_exe(state, slot)
        }
        if sub == F_CWD {
            return pfproc.make_cwd(state, slot)
        }
        return 0
    }
    if art == K_FDFILE {
        if !pfproc.alive(state, slot) {
            return 0
        }
        return pfproc.make_fdfile(state, slot, sub)
    }
    return 0
}

fn global_of(name: u64) -> u64 {
    var a: [u8; 8] = "meminfo\0"
    var b: [u8; 8] = "cpuinfo\0"
    var c: [u8; 7] = "uptime\0"
    var d: [u8; 7] = "mounts\0"
    var e: [u8; 5] = "stat\0"
    var f: [u8; 8] = "version\0"
    var g: [u8; 5] = "hwid\0"
    var k: [u8; 5] = "klog\0"
    var la: [u8; 8] = "loadavg\0"
    var gp: [u8; 4] = "pci\0"
    var gu: [u8; 4] = "usb\0"
    var gf: [u8; 9] = "firmware\0"
    var gw: [u8; 5] = "wlan\0"
    var gun: [u8; 7] = "usbnet\0"
    var ga: [u8; 5] = "apps\0"
    var go: [u8; 4] = "odb\0"
    var gb: [u8; 6] = "bench\0"
    var gfr: [u8; 7] = "frames\0"
    var gsf: [u8; 5] = "safe\0"
    var gdm: [u8; 5] = "dmar\0"
    var gdr: [u8; 8] = "drivers\0"
    var gbl: [u8; 10] = "backlight\0"
    var gcp: [u8; 5] = "cpus\0"
    var gid: [u8; 10] = "inputdevs\0"
    var ghk: [u8; 8] = "hotkeys\0"
    var gwp: [u8; 9] = "wlanpoll\0"
    if pfsys.streq(name, (&gwp[0]) as u64) {
        return G_WLANPOLL
    }
    var gwt: [u8; 11] = "wlan_trace\0"
    if pfsys.streq(name, (&gwt[0]) as u64) {
        return G_WLANTRACE
    }
    var gad: [u8; 9] = "acpidump\0"
    if pfsys.streq(name, (&gad[0]) as u64) {
        return G_ACPIDUMP
    }
    var gbt: [u8; 8] = "battery\0"
    if pfsys.streq(name, (&gbt[0]) as u64) {
        return G_BATTERY
    }
    var gth: [u8; 8] = "thermal\0"
    if pfsys.streq(name, (&gth[0]) as u64) {
        return G_THERMAL
    }
    var gue: [u8; 7] = "uevent\0"
    if pfsys.streq(name, (&gue[0]) as u64) {
        return G_UEVENT
    }
    var gwd: [u8; 9] = "watchdog\0"
    if pfsys.streq(name, (&gwd[0]) as u64) {
        return G_WATCHDOG
    }
    var gwh: [u8; 14] = "watchdog_hang\0"
    if pfsys.streq(name, (&gwh[0]) as u64) {
        return G_WDTHANG
    }
    var gfsa: [u8; 8] = "fsaudit\0"
    if pfsys.streq(name, (&gfsa[0]) as u64) {
        return G_FSAUDIT
    }
    var gvc: [u8; 9] = "vfscache\0"
    if pfsys.streq(name, (&gvc[0]) as u64) {
        return G_VFSCACHE
    }
    var gvmx: [u8; 8] = "vmxcaps\0"
    if pfsys.streq(name, (&gvmx[0]) as u64) {
        return G_VMXCAPS
    }
    var gtpm: [u8; 4] = "tpm\0"
    if pfsys.streq(name, (&gtpm[0]) as u64) {
        return G_TPM
    }
    var gblt: [u8; 10] = "bluetooth\0"
    if pfsys.streq(name, (&gblt[0]) as u64) {
        return G_BLUETOOTH
    }
    var grn: [u8; 7] = "random\0"
    if pfsys.streq(name, (&grn[0]) as u64) {
        return G_RANDOM
    }
    var gbr: [u8; 6] = "brand\0"
    if pfsys.streq(name, (&gbr[0]) as u64) {
        return G_BRAND
    }
    var gpe: [u8; 5] = "pcie\0"
    if pfsys.streq(name, (&gpe[0]) as u64) {
        return G_PCIE
    }
    var gte: [u8; 8] = "touchev\0"
    if pfsys.streq(name, (&gte[0]) as u64) {
        return G_TOUCHEV
    }
    var gus: [u8; 7] = "usbsum\0"
    if pfsys.streq(name, (&gus[0]) as u64) {
        return G_USBSUM
    }
    var gwq: [u8; 8] = "wlanirq\0"
    if pfsys.streq(name, (&gwq[0]) as u64) {
        return G_WLANIRQ
    }
    var gck: [u8; 6] = "clock\0"
    if pfsys.streq(name, (&gck[0]) as u64) {
        return G_CLOCK
    }
    if pfsys.streq(name, (&ghk[0]) as u64) {
        return G_HOTKEYS
    }
    if pfsys.streq(name, (&gid[0]) as u64) {
        return G_INPUTDEVS
    }
    if pfsys.streq(name, (&gcp[0]) as u64) {
        return G_CPUS
    }
    if pfsys.streq(name, (&gdm[0]) as u64) {
        return G_DMAR
    }
    if pfsys.streq(name, (&gdr[0]) as u64) {
        return G_DRIVERS
    }
    if pfsys.streq(name, (&gbl[0]) as u64) {
        return G_BACKLIGHT
    }
    if pfsys.streq(name, (&gsf[0]) as u64) {
        return G_SAFE
    }
    if pfsys.streq(name, (&gfr[0]) as u64) {
        return G_FRAMES
    }
    var ggp: [u8; 4] = "gpu\0"
    if pfsys.streq(name, (&ggp[0]) as u64) {
        return G_GPU
    }
    var gsm: [u8; 7] = "sysmon\0"
    if pfsys.streq(name, (&gsm[0]) as u64) {
        return G_SYSMON
    }
    var gac: [u8; 5] = "acpi\0"
    if pfsys.streq(name, (&gac[0]) as u64) {
        return G_ACPI
    }
    if pfsys.streq(name, (&gb[0]) as u64) {
        return G_BENCH
    }
    if pfsys.streq(name, (&go[0]) as u64) {
        return G_ODB
    }
    if pfsys.streq(name, (&ga[0]) as u64) {
        return G_APPS
    }
    if pfsys.streq(name, (&gp[0]) as u64) {
        return G_PCI
    }
    if pfsys.streq(name, (&gu[0]) as u64) {
        return G_USB
    }
    if pfsys.streq(name, (&gf[0]) as u64) {
        return G_FIRMWARE
    }
    if pfsys.streq(name, (&gw[0]) as u64) {
        return G_WLAN
    }
    if pfsys.streq(name, (&gun[0]) as u64) {
        return G_USBNET
    }
    if pfsys.streq(name, (&la[0]) as u64) {
        return G_LOADAVG
    }
    if pfsys.streq(name, (&a[0]) as u64) {
        return G_MEMINFO
    }
    if pfsys.streq(name, (&k[0]) as u64) {
        return G_KLOG
    }
    if pfsys.streq(name, (&g[0]) as u64) {
        return G_HWID
    }
    if pfsys.streq(name, (&b[0]) as u64) {
        return G_CPUINFO
    }
    if pfsys.streq(name, (&c[0]) as u64) {
        return G_UPTIME
    }
    if pfsys.streq(name, (&d[0]) as u64) {
        return G_MOUNTS
    }
    if pfsys.streq(name, (&e[0]) as u64) {
        return G_STAT
    }
    if pfsys.streq(name, (&f[0]) as u64) {
        return G_VERSION
    }
    return 0
}

fn pidfile_of(name: u64) -> u64 {
    var a: [u8; 7] = "status\0"
    var b: [u8; 5] = "stat\0"
    var c: [u8; 8] = "cmdline\0"
    var d: [u8; 5] = "maps\0"
    var e: [u8; 3] = "fd\0"
    var lm: [u8; 7] = "limits\0"
    var cg: [u8; 7] = "cgroup\0"
    var ex: [u8; 4] = "exe\0"
    var cw: [u8; 4] = "cwd\0"
    var ml: [u8; 8] = "mmaplog\0"
    if pfsys.streq(name, (&ml[0]) as u64) {
        return F_MMAPLOG
    }
    if pfsys.streq(name, (&ex[0]) as u64) {
        return F_EXE
    }
    if pfsys.streq(name, (&cw[0]) as u64) {
        return F_CWD
    }
    if pfsys.streq(name, (&lm[0]) as u64) {
        return F_LIMITS
    }
    if pfsys.streq(name, (&cg[0]) as u64) {
        return F_CGROUP
    }
    if pfsys.streq(name, (&a[0]) as u64) {
        return F_STATUS
    }
    if pfsys.streq(name, (&b[0]) as u64) {
        return F_STAT
    }
    if pfsys.streq(name, (&c[0]) as u64) {
        return F_CMDLINE
    }
    if pfsys.streq(name, (&d[0]) as u64) {
        return F_MAPS
    }
    if pfsys.streq(name, (&e[0]) as u64) {
        return F_FD
    }
    return 0
}

fn p_lookup(state: u64, m: u64, path: u64) -> u64 {
    pfproc.tick(state)
    if mnt.dev(state, m) == 1 {
        return sfs_lookup(state, path)
    }
    var seg: [u8; 24] = [0 as u8; 24]
    var at: u64 = pathseg.segment(path, 0, (&seg[0]) as u64, 24)
    if kstate.get8((&seg[0]) as u64) == 0 {
        return pfproc.node(pfbase.K_ROOT, 0, 0)
    }
    let g: u64 = global_of((&seg[0]) as u64)
    if g != 0 {
        var rest: [u8; 24] = [0 as u8; 24]
        pathseg.segment(path, at, (&rest[0]) as u64, 24)
        if kstate.get8((&rest[0]) as u64) != 0 {
            return 0
        }
        return pfproc.node(K_GLOBAL, 0, g)
    }
    var w_sys: [u8; 4] = "sys\0"
    var w_net: [u8; 4] = "net\0"
    let is_sys: bool = pfsys.streq((&seg[0]) as u64, (&w_sys[0]) as u64)
    let is_net: bool = pfsys.streq((&seg[0]) as u64, (&w_net[0]) as u64)
    if is_sys || is_net {
        var cur: u64 = pfbase.S_SYS
        if is_net {
            cur = pfbase.S_NET
        }
        var pos: u64 = at
        var guard: u64 = 0
        while guard < 6 {
            var sg: [u8; 24] = [0 as u8; 24]
            pos = pathseg.segment(path, pos, (&sg[0]) as u64, 24)
            if kstate.get8((&sg[0]) as u64) == 0 {
                return pfproc.node(K_SYS, 0, cur)
            }
            if !pfsys.sys_is_dir(cur) {
                return 0
            }
            cur = pfsys.sys_child(cur, (&sg[0]) as u64)
            if cur == 0 {
                return 0
            }
            guard = guard + 1
        }
        return 0
    }
    var w_self: [u8; 5] = "self\0"
    var slot: u64 = kstate.MAX_TASKS
    if pfsys.streq((&seg[0]) as u64, (&w_self[0]) as u64) {
        slot = sched.current(state)
    } else {
        let pid: u64 = pfsys.to_num((&seg[0]) as u64)
        if pid == 0xFFFFFFFF {
            return 0
        }
        slot = pfproc.slot_of_pid(state, pid)
    }
    if slot >= kstate.MAX_TASKS {
        return 0
    }
    var seg2: [u8; 24] = [0 as u8; 24]
    at = pathseg.segment(path, at, (&seg2[0]) as u64, 24)
    if kstate.get8((&seg2[0]) as u64) == 0 {
        return pfproc.node(K_PIDDIR, slot, 0)
    }
    let f: u64 = pidfile_of((&seg2[0]) as u64)
    if f == 0 {
        return 0
    }
    var seg3: [u8; 24] = [0 as u8; 24]
    at = pathseg.segment(path, at, (&seg3[0]) as u64, 24)
    if kstate.get8((&seg3[0]) as u64) == 0 {
        if f == F_FD {
            return pfproc.node(K_FDDIR, slot, 0)
        }
        return pfproc.node(K_PIDFILE, slot, f)
    }
    if f != F_FD {
        return 0
    }
    let fd: u64 = pfsys.to_num((&seg3[0]) as u64)
    if fd >= file.MAX_FD {
        return 0
    }
    if file.fd_of(state, slot, fd) >= file.MAX_OPEN {
        return 0
    }
    return pfproc.node(K_FDFILE, slot, fd)
}

fn dot_entry(state: u64, index: u64, out: u64) -> bool {
    if index == 0 {
        kstate.set8(out, 46 as u8)
        kstate.set8(out + 1, 0 as u8)
        return true
    }
    kstate.set8(out, 46 as u8)
    kstate.set8(out + 1, 46 as u8)
    kstate.set8(out + 2, 0 as u8)
    return true
}

fn global_name(state: u64, sub: u64, out: u64) {
    var a: [u8; 8] = "meminfo\0"
    var b: [u8; 8] = "cpuinfo\0"
    var c: [u8; 7] = "uptime\0"
    var d: [u8; 7] = "mounts\0"
    var e: [u8; 5] = "stat\0"
    var f: [u8; 8] = "version\0"
    var g: [u8; 5] = "hwid\0"
    var k: [u8; 5] = "klog\0"
    var la2: [u8; 8] = "loadavg\0"
    var sy2: [u8; 4] = "sys\0"
    var ne2: [u8; 4] = "net\0"
    var pc2: [u8; 4] = "pci\0"
    var us2: [u8; 4] = "usb\0"
    var fw2: [u8; 9] = "firmware\0"
    var wl2: [u8; 5] = "wlan\0"
    var un2: [u8; 7] = "usbnet\0"
    var ap2: [u8; 5] = "apps\0"
    var od2: [u8; 4] = "odb\0"
    var bn2: [u8; 6] = "bench\0"
    var fr2: [u8; 7] = "frames\0"
    var sm2: [u8; 7] = "sysmon\0"
    var ac2: [u8; 5] = "acpi\0"
    var gp2: [u8; 4] = "gpu\0"
    var sf2: [u8; 5] = "safe\0"
    var dm2: [u8; 5] = "dmar\0"
    var dr2: [u8; 8] = "drivers\0"
    var bl2: [u8; 10] = "backlight\0"
    var cp2: [u8; 5] = "cpus\0"
    var id2: [u8; 10] = "inputdevs\0"
    var hk2: [u8; 8] = "hotkeys\0"
    var wp2: [u8; 9] = "wlanpoll\0"
    var wq2: [u8; 8] = "wlanirq\0"
    var ck2: [u8; 6] = "clock\0"
    var wt2s: [u8; 11] = "wlan_trace\0"
    var ad2s: [u8; 9] = "acpidump\0"
    var us2s: [u8; 7] = "usbsum\0"
    var bt2s: [u8; 8] = "battery\0"
    var br2s: [u8; 6] = "brand\0"
    var th2s: [u8; 8] = "thermal\0"
    var pe2s: [u8; 5] = "pcie\0"
    var te2s: [u8; 8] = "touchev\0"
    var rn2s: [u8; 7] = "random\0"
    var ue2s: [u8; 7] = "uevent\0"
    var wd2s: [u8; 9] = "watchdog\0"
    var wh2s: [u8; 14] = "watchdog_hang\0"
    var bl2s: [u8; 10] = "bluetooth\0"
    var fa2s: [u8; 8] = "fsaudit\0"
    var vc2s: [u8; 9] = "vfscache\0"
    var vx2s: [u8; 8] = "vmxcaps\0"
    var tp2s: [u8; 4] = "tpm\0"
    var src: u64 = (&a[0]) as u64
    if sub == G_CLOCK {
        src = (&ck2[0]) as u64
    } else if sub == G_TOUCHEV {
        src = (&te2s[0]) as u64
    } else if sub == G_BATTERY {
        src = (&bt2s[0]) as u64
    } else if sub == G_UEVENT {
        src = (&ue2s[0]) as u64
    } else if sub == G_WATCHDOG {
        src = (&wd2s[0]) as u64
    } else if sub == G_WDTHANG {
        src = (&wh2s[0]) as u64
    } else if sub == G_BLUETOOTH {
        src = (&bl2s[0]) as u64
    } else if sub == G_FSAUDIT {
        src = (&fa2s[0]) as u64
    } else if sub == G_VFSCACHE {
        src = (&vc2s[0]) as u64
    } else if sub == G_VMXCAPS {
        src = (&vx2s[0]) as u64
    } else if sub == G_TPM {
        src = (&tp2s[0]) as u64
    } else if sub == G_RANDOM {
        src = (&rn2s[0]) as u64
    } else if sub == G_THERMAL {
        src = (&th2s[0]) as u64
    } else if sub == G_BRAND {
        src = (&br2s[0]) as u64
    } else if sub == G_PCIE {
        src = (&pe2s[0]) as u64
    } else if sub == G_WLANTRACE {
        src = (&wt2s[0]) as u64
    } else if sub == G_ACPIDUMP {
        src = (&ad2s[0]) as u64
    } else if sub == G_USBSUM {
        src = (&us2s[0]) as u64
    } else if sub == G_WLANIRQ {
        src = (&wq2[0]) as u64
    } else if sub == G_WLANPOLL {
        src = (&wp2[0]) as u64
    } else if sub == G_HOTKEYS {
        src = (&hk2[0]) as u64
    } else if sub == G_INPUTDEVS {
        src = (&id2[0]) as u64
    } else if sub == G_CPUS {
        src = (&cp2[0]) as u64
    } else if sub == G_DMAR {
        src = (&dm2[0]) as u64
    } else if sub == G_BACKLIGHT {
        src = (&bl2[0]) as u64
    } else if sub == G_DRIVERS {
        src = (&dr2[0]) as u64
    } else if sub == G_GPU {
        src = (&gp2[0]) as u64
    } else if sub == G_SAFE {
        src = (&sf2[0]) as u64
    } else if sub == G_SYSMON {
        src = (&sm2[0]) as u64
    } else if sub == G_FRAMES {
        src = (&fr2[0]) as u64
    } else if sub == G_ACPI {
        src = (&ac2[0]) as u64
    } else if sub == G_BENCH {
        src = (&bn2[0]) as u64
    } else if sub == G_ODB {
        src = (&od2[0]) as u64
    } else if sub == G_APPS {
        src = (&ap2[0]) as u64
    } else if sub == G_PCI {
        src = (&pc2[0]) as u64
    } else if sub == G_USB {
        src = (&us2[0]) as u64
    } else if sub == G_FIRMWARE {
        src = (&fw2[0]) as u64
    } else if sub == G_WLAN {
        src = (&wl2[0]) as u64
    } else if sub == G_USBNET {
        src = (&un2[0]) as u64
    } else if sub == G_LOADAVG {
        src = (&la2[0]) as u64
    } else if sub == G_SYSDIR {
        src = (&sy2[0]) as u64
    } else if sub == G_NETDIR {
        src = (&ne2[0]) as u64
    } else if sub == G_CPUINFO {
        src = (&b[0]) as u64
    } else if sub == G_UPTIME {
        src = (&c[0]) as u64
    } else if sub == G_MOUNTS {
        src = (&d[0]) as u64
    } else if sub == G_STAT {
        src = (&e[0]) as u64
    } else if sub == G_VERSION {
        src = (&f[0]) as u64
    } else if sub == G_HWID {
        src = (&g[0]) as u64
    } else if sub == G_KLOG {
        src = (&k[0]) as u64
    }
    var i: u64 = 0
    while kstate.get8(src + i) != 0 {
        kstate.set8(out + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(out + i, 0 as u8)
}

fn pidfile_name(state: u64, sub: u64, out: u64) {
    var a: [u8; 7] = "status\0"
    var b: [u8; 5] = "stat\0"
    var c: [u8; 8] = "cmdline\0"
    var d: [u8; 5] = "maps\0"
    var e: [u8; 3] = "fd\0"
    var lm2: [u8; 7] = "limits\0"
    var cg2: [u8; 7] = "cgroup\0"
    var ex2: [u8; 4] = "exe\0"
    var cw2: [u8; 4] = "cwd\0"
    var ml2: [u8; 8] = "mmaplog\0"
    var src: u64 = (&a[0]) as u64
    if sub == F_MMAPLOG {
        src = (&ml2[0]) as u64
    } else if sub == F_EXE {
        src = (&ex2[0]) as u64
    } else if sub == F_CWD {
        src = (&cw2[0]) as u64
    } else if sub == F_LIMITS {
        src = (&lm2[0]) as u64
    } else if sub == F_CGROUP {
        src = (&cg2[0]) as u64
    } else if sub == F_STAT {
        src = (&b[0]) as u64
    } else if sub == F_CMDLINE {
        src = (&c[0]) as u64
    } else if sub == F_MAPS {
        src = (&d[0]) as u64
    } else if sub == F_FD {
        src = (&e[0]) as u64
    }
    var i: u64 = 0
    while kstate.get8(src + i) != 0 {
        kstate.set8(out + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(out + i, 0 as u8)
}

fn num_name(state: u64, v: u64, out: u64) {
    var digits: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        kstate.set8(out, 48 as u8)
        kstate.set8(out + 1, 0 as u8)
        return
    }
    while x > 0 {
        digits[n as usize] = ((x % 10) + 48) as u8
        x = x / 10
        n = n + 1
    }
    var k: u64 = 0
    while n > 0 {
        n = n - 1
        kstate.set8(out + k, digits[n as usize])
        k = k + 1
    }
    kstate.set8(out + k, 0 as u8)
}

fn p_readdir(state: u64, m: u64, dir: u64, index: u64, out: u64) -> u64 {
    pfproc.tick(state)
    let art: u64 = pfproc.n_art(dir)
    let slot: u64 = pfproc.n_slot(dir)
    if index < 2 {
        dot_entry(state, index, out)
        return dir
    }
    let i: u64 = index - 2
    if art == pfbase.K_SFS {
        return sfs_readdir(state, dir, i, out)
    }
    if art == pfbase.K_ROOT {
        if i < G_LAST {
            global_name(state, i + 1, out)
            if i + 1 == G_SYSDIR {
                return pfproc.node(K_SYS, 0, pfbase.S_SYS)
            }
            if i + 1 == G_NETDIR {
                return pfproc.node(K_SYS, 0, pfbase.S_NET)
            }
            return pfproc.node(K_GLOBAL, 0, i + 1)
        }
        var seen: u64 = 0
        var t: u64 = 0
        let n: u64 = kstate.get(state, kstate.TASKS)
        while t < n {
            if pfproc.alive(state, t) {
                if seen == i - G_LAST {
                    num_name(state, sched.tget(state, t, sched.T_PID), out)
                    return pfproc.node(K_PIDDIR, t, 0)
                }
                seen = seen + 1
            }
            t = t + 1
        }
        return 0
    }
    if art == K_PIDDIR {
        if i < F_LAST {
            pidfile_name(state, i + 1, out)
            if i + 1 == F_FD {
                return pfproc.node(K_FDDIR, slot, 0)
            }
            return pfproc.node(K_PIDFILE, slot, i + 1)
        }
        return 0
    }
    if art == K_SYS {
        let c: u64 = pfsys.sys_nth(pfproc.n_sub(dir), i)
        if c == 0 {
            return 0
        }
        pfsys.sys_name(c, out)
        return pfproc.node(K_SYS, 0, c)
    }
    if art == K_FDDIR {
        var seen: u64 = 0
        var fd: u64 = 0
        while fd < file.MAX_FD {
            if file.fd_of(state, slot, fd) < file.MAX_OPEN {
                if seen == i {
                    num_name(state, fd, out)
                    return pfproc.node(K_FDFILE, slot, fd)
                }
                seen = seen + 1
            }
            fd = fd + 1
        }
        return 0
    }
    return 0
}

fn p_attr(state: u64, m: u64, n: u64, what: u64) -> u64 {
    pfproc.tick(state)
    let art: u64 = pfproc.n_art(n)
    if art == pfbase.K_SFS {
        return sfs_attr(state, n, what)
    }
    if what == vfsops.A_TYPE {
        if art == pfbase.K_ROOT || art == K_PIDDIR || art == K_FDDIR {
            return vfsops.N_DIR
        }
        if art == K_SYS {
            if pfsys.sys_is_dir(pfproc.n_sub(n)) {
                return vfsops.N_DIR
            }
            return vfsops.N_FILE
        }
        if art == K_PIDFILE && (pfproc.n_sub(n) == F_EXE || pfproc.n_sub(n) == F_CWD) {
            return vfsops.N_LNK
        }
        if art == K_GLOBAL || art == K_PIDFILE || art == K_FDFILE {
            return vfsops.N_FILE
        }
        return vfsops.N_NONE
    }
    if what == vfsops.A_SIZE {
        if art == pfbase.K_ROOT || art == K_PIDDIR || art == K_FDDIR || (art == K_SYS && pfsys.sys_is_dir(pfproc.n_sub(n))) {
            return 0
        }
        if art == K_GLOBAL && pfproc.n_sub(n) == G_ACPIDUMP {
            return acpidump.size(state)
        }
        if art == K_GLOBAL && pfproc.n_sub(n) == G_WLANTRACE {
            return wltrace.size(state)
        }
        let flags: u64 = lock(state)
        let len: u64 = build(state, n)
        unlock(state, flags)
        return len
    }
    if what == vfsops.A_MODE {
        if art == pfbase.K_ROOT || art == K_PIDDIR || art == K_FDDIR || (art == K_SYS && pfsys.sys_is_dir(pfproc.n_sub(n))) {
            return 365
        }
        if art == K_PIDFILE && (pfproc.n_sub(n) == F_EXE || pfproc.n_sub(n) == F_CWD) {
            return 511
        }
        return 292
    }
    if what == vfsops.A_NLINK {
        return 1
    }
    if what == vfsops.A_BLKSIZE {
        return 4096
    }
    return 0
}

fn lock(state: u64) -> u64 {
    let flags: u64 = sched.irq_save()
    atomic.lock_take(state, atomic.L_PROC, cpu.here(state))
    return flags
}

fn unlock(state: u64, flags: u64) {
    atomic.lock_give(state, atomic.L_PROC)
    sched.irq_restore(flags)
}

fn sfs_ncpu(state: u64) -> u64 {
    let n: u64 = cpu.count(state)
    if n == 0 {
        return 1
    }
    return n
}

fn sfs_nonline(state: u64) -> u64 {
    let n: u64 = cpu.online_count(state)
    if n == 0 {
        return 1
    }
    return n
}

fn sfs_cache_leaf(state: u64) -> u64 {
    if fpu.cpuid_a(0, 0) >= 4 && (fpu.cpuid_a(4, 0) & 31) != 0 {
        return 4
    }
    if fpu.cpuid_a(0x80000000, 0) >= 0x8000001D && ((fpu.cpuid_c(0x80000001, 0) >> 22) & 1) != 0 && (fpu.cpuid_a(0x8000001D, 0) & 31) != 0 {
        return 0x8000001D
    }
    return 0
}

fn sfs_cache_type(state: u64) -> u64 {
    let lf: u64 = sfs_cache_leaf(state)
    if lf == 0 {
        return 0
    }
    return fpu.cpuid_a(lf, 0) & 31
}

fn sfs_is_dir(sub: u64) -> bool {
    return sub == pfbase.SF_ROOT || sub == SF_DEVICES || sub == SF_SYSTEM || sub == SF_CPU || sub == SF_CPUN || sub == SF_CACHE || sub == SF_IDX0
}

fn sfs_count(state: u64, sub: u64) -> u64 {
    if sub == pfbase.SF_ROOT || sub == SF_DEVICES || sub == SF_SYSTEM {
        return 1
    }
    if sub == SF_CPU {
        return 3 + sfs_ncpu(state)
    }
    if sub == SF_CPUN {
        return 1
    }
    if sub == SF_CACHE {
        if sfs_cache_type(state) == 0 {
            return 0
        }
        return 1
    }
    if sub == SF_IDX0 {
        return 6
    }
    return 0
}

fn sfs_child(state: u64, sub: u64, slot: u64, i: u64) -> u64 {
    if i >= sfs_count(state, sub) {
        return 0
    }
    if sub == pfbase.SF_ROOT {
        return pfproc.node(pfbase.K_SFS, 0, SF_DEVICES)
    }
    if sub == SF_DEVICES {
        return pfproc.node(pfbase.K_SFS, 0, SF_SYSTEM)
    }
    if sub == SF_SYSTEM {
        return pfproc.node(pfbase.K_SFS, 0, SF_CPU)
    }
    if sub == SF_CPU {
        if i < 3 {
            return pfproc.node(pfbase.K_SFS, 0, SF_ONLINE + i)
        }
        return pfproc.node(pfbase.K_SFS, i - 3, SF_CPUN)
    }
    if sub == SF_CPUN {
        return pfproc.node(pfbase.K_SFS, slot, SF_CACHE)
    }
    if sub == SF_CACHE {
        return pfproc.node(pfbase.K_SFS, slot, SF_IDX0)
    }
    if sub == SF_IDX0 {
        return pfproc.node(pfbase.K_SFS, slot, SF_C_LEVEL + i)
    }
    return 0
}

fn sfs_name(state: u64, n: u64, out: u64) {
    var a1: [u8; 8] = "devices\0"
    var a2: [u8; 7] = "system\0"
    var a3: [u8; 4] = "cpu\0"
    var a4: [u8; 7] = "online\0"
    var a5: [u8; 9] = "possible\0"
    var a6: [u8; 8] = "present\0"
    var a7: [u8; 6] = "cache\0"
    var a8: [u8; 7] = "index0\0"
    var a9: [u8; 6] = "level\0"
    var a10: [u8; 5] = "type\0"
    var a11: [u8; 5] = "size\0"
    var a12: [u8; 20] = "coherency_line_size\0"
    var a13: [u8; 15] = "number_of_sets\0"
    var a14: [u8; 22] = "ways_of_associativity\0"
    let sub: u64 = pfproc.n_sub(n)
    if sub == SF_DEVICES {
        pfsys.copy_z(out, (&a1[0]) as u64)
    } else if sub == SF_SYSTEM {
        pfsys.copy_z(out, (&a2[0]) as u64)
    } else if sub == SF_CPU {
        pfsys.copy_z(out, (&a3[0]) as u64)
    } else if sub == SF_ONLINE {
        pfsys.copy_z(out, (&a4[0]) as u64)
    } else if sub == SF_POSSIBLE {
        pfsys.copy_z(out, (&a5[0]) as u64)
    } else if sub == SF_PRESENT {
        pfsys.copy_z(out, (&a6[0]) as u64)
    } else if sub == SF_CPUN {
        kstate.set8(out, 99 as u8)
        kstate.set8(out + 1, 112 as u8)
        kstate.set8(out + 2, 117 as u8)
        num_name(state, pfproc.n_slot(n), out + 3)
    } else if sub == SF_CACHE {
        pfsys.copy_z(out, (&a7[0]) as u64)
    } else if sub == SF_IDX0 {
        pfsys.copy_z(out, (&a8[0]) as u64)
    } else if sub == SF_C_LEVEL {
        pfsys.copy_z(out, (&a9[0]) as u64)
    } else if sub == SF_C_TYPE {
        pfsys.copy_z(out, (&a10[0]) as u64)
    } else if sub == SF_C_SIZE {
        pfsys.copy_z(out, (&a11[0]) as u64)
    } else if sub == SF_C_LINE {
        pfsys.copy_z(out, (&a12[0]) as u64)
    } else if sub == SF_C_SETS {
        pfsys.copy_z(out, (&a13[0]) as u64)
    } else if sub == SF_C_WAYS {
        pfsys.copy_z(out, (&a14[0]) as u64)
    } else {
        kstate.set8(out, 0 as u8)
    }
}

fn sfs_lookup(state: u64, path: u64) -> u64 {
    var seg: [u8; 32] = [0 as u8; 32]
    var nm: [u8; 32] = [0 as u8; 32]
    var cur: u64 = pfproc.node(pfbase.K_SFS, 0, pfbase.SF_ROOT)
    var at: u64 = 0
    var guard: u64 = 0
    while guard < 8 {
        at = pathseg.segment(path, at, (&seg[0]) as u64, 32)
        if kstate.get8((&seg[0]) as u64) == 0 {
            return cur
        }
        if !sfs_is_dir(pfproc.n_sub(cur)) {
            return 0
        }
        var found: u64 = 0
        var i: u64 = 0
        let cnt: u64 = sfs_count(state, pfproc.n_sub(cur))
        while i < cnt && found == 0 {
            let c: u64 = sfs_child(state, pfproc.n_sub(cur), pfproc.n_slot(cur), i)
            sfs_name(state, c, (&nm[0]) as u64)
            if pfsys.streq((&seg[0]) as u64, (&nm[0]) as u64) {
                found = c
            }
            i = i + 1
        }
        if found == 0 {
            return 0
        }
        cur = found
        guard = guard + 1
    }
    return 0
}

fn sfs_readdir(state: u64, dir: u64, i: u64, out: u64) -> u64 {
    let c: u64 = sfs_child(state, pfproc.n_sub(dir), pfproc.n_slot(dir), i)
    if c == 0 {
        return 0
    }
    sfs_name(state, c, out)
    return c
}

fn sfs_attr(state: u64, n: u64, what: u64) -> u64 {
    let sub: u64 = pfproc.n_sub(n)
    if what == vfsops.A_TYPE {
        if sfs_is_dir(sub) {
            return vfsops.N_DIR
        }
        return vfsops.N_FILE
    }
    if what == vfsops.A_SIZE {
        if sfs_is_dir(sub) {
            return 0
        }
        let flags: u64 = lock(state)
        let len: u64 = build(state, n)
        unlock(state, flags)
        return len
    }
    if what == vfsops.A_MODE {
        if sfs_is_dir(sub) {
            return 365
        }
        return 292
    }
    if what == vfsops.A_NLINK {
        return 1
    }
    if what == vfsops.A_BLKSIZE {
        return 4096
    }
    return 0
}

fn sfs_range(state: u64, n: u64) -> u64 {
    var p: u64 = pfproc.w_num(state, 0, 0)
    if n > 1 {
        p = pfproc.w_ch(state, p, 45)
        p = pfproc.w_num(state, p, n - 1)
    }
    return pfproc.w_nl(state, p)
}

fn sfs_build(state: u64, sub: u64) -> u64 {
    var p: u64 = 0
    if sub == SF_ONLINE {
        return sfs_range(state, sfs_nonline(state))
    }
    if sub == SF_POSSIBLE || sub == SF_PRESENT {
        return sfs_range(state, sfs_ncpu(state))
    }
    let lf: u64 = sfs_cache_leaf(state)
    let a: u64 = fpu.cpuid_a(lf, 0)
    let b: u64 = fpu.cpuid_b(lf, 0)
    let c: u64 = fpu.cpuid_c(lf, 0)
    let ways: u64 = (b >> 22) + 1
    let parts: u64 = ((b >> 12) & 1023) + 1
    let line: u64 = (b & 4095) + 1
    let sets: u64 = c + 1
    if sub == SF_C_LEVEL {
        p = pfproc.w_num(state, p, (a >> 5) & 7)
        return pfproc.w_nl(state, p)
    }
    if sub == SF_C_TYPE {
        var t1: [u8; 5] = "Data\0"
        var t2: [u8; 12] = "Instruction\0"
        var t3: [u8; 8] = "Unified\0"
        let ty: u64 = a & 31
        if ty == 1 {
            p = pfproc.w_str(state, p, (&t1[0]) as u64)
        } else if ty == 2 {
            p = pfproc.w_str(state, p, (&t2[0]) as u64)
        } else {
            p = pfproc.w_str(state, p, (&t3[0]) as u64)
        }
        return pfproc.w_nl(state, p)
    }
    if sub == SF_C_SIZE {
        p = pfproc.w_num(state, p, ways * parts * line * sets / 1024)
        p = pfproc.w_ch(state, p, 75)
        return pfproc.w_nl(state, p)
    }
    if sub == SF_C_LINE {
        p = pfproc.w_num(state, p, line)
        return pfproc.w_nl(state, p)
    }
    if sub == SF_C_SETS {
        p = pfproc.w_num(state, p, sets)
        return pfproc.w_nl(state, p)
    }
    if sub == SF_C_WAYS {
        p = pfproc.w_num(state, p, ways)
        return pfproc.w_nl(state, p)
    }
    return 0
}

fn p_read(state: u64, m: u64, n: u64, off: u64, dst: u64, len: u64) -> u64 {
    pfproc.tick(state)
    if pfproc.n_art(n) == K_GLOBAL && pfproc.n_sub(n) == G_ACPIDUMP {
        return acpidump.read(state, off, dst, len)
    }
    if pfproc.n_art(n) == K_GLOBAL && pfproc.n_sub(n) == G_WLANTRACE {
        return wltrace.read(state, off, dst, len)
    }
    let flags: u64 = lock(state)
    let now: u64 = kstate.get(state, kstate.TICKS)
    if off > 0 {
        let sl: u64 = procsnap.find(n, now)
        if sl != procsnap.NONE {
            let got: u64 = procsnap.read(sl, off, dst, len)
            unlock(state, flags)
            return got
        }
    }
    let have: u64 = build(state, n)
    procsnap.store(n, now, pfproc.buf(state), have)
    if off >= have {
        unlock(state, flags)
        return 0
    }
    var want: u64 = len
    if off + want > have {
        want = have - off
    }
    var i: u64 = 0
    while i < want {
        kstate.set8(dst + i, kstate.get8(pfproc.buf(state) + off + i) as u8)
        i = i + 1
    }
    unlock(state, flags)
    return want
}

fn p_write(state: u64, m: u64, n: u64, off: u64, src: u64,
    len: u64) -> u64 {
    pfproc.tick(state)
    return 0
}

fn p_create(state: u64, m: u64, path: u64, art: u64) -> u64 {
    pfproc.tick(state)
    return 0
}

fn p_unlink(state: u64, m: u64, path: u64) -> u64 {
    pfproc.tick(state)
    return 1
}

fn p_rename(state: u64, m: u64, from: u64, to: u64) -> u64 {
    pfproc.tick(state)
    return 1
}

fn p_trunc(state: u64, m: u64, n: u64) -> u64 {
    pfproc.tick(state)
    return 30
}

fn ops() -> vfsops.Ops {
    return vfsops.Ops {
        lookup: p_lookup,
        readdir: p_readdir,
        attr: p_attr,
        read: p_read,
        write: p_write,
        create: p_create,
        unlink: p_unlink,
        rename: p_rename,
        trunc: p_trunc,
        mask: vfsops.OP_READONLY,
        tag: 1668248176
    }
}
