profile kernel

import lib.kstate
import init.initstage
import fs.procfs.pfproc

export { append }

const MIN_MS: u64 = 10

fn append(state: u64, at: u64) -> u64 {
    var l_step: [u8; 11] = "boot.step \0"
    let khz: u64 = kstate.get(state, kstate.TIME_KHZ)
    if khz == 0 {
        return at
    }
    var p: u64 = at
    var stage: u64 = 0
    while stage < initstage.S_COUNT {
        var i: u64 = 0
        while i < initstage.count(stage) {
            let ms: u64 = initstage.step_cycles_of(stage, i) / khz
            if ms >= MIN_MS {
                p = pfproc.w_str(state, p, (&l_step[0]) as u64)
                p = pfproc.w_num(state, p, stage)
                p = pfproc.w_ch(state, p, 46)
                p = pfproc.w_num(state, p, i)
                p = pfproc.w_ch(state, p, 32)
                p = pfproc.w_num(state, p, ms)
                p = pfproc.w_nl(state, p)
            }
            i = i + 1
        }
        stage = stage + 1
    }
    return p
}
