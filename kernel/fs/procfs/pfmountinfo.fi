profile kernel

import fs.mnt
import fs.vfsops
import fs.procfs.pfproc

export { make }

const SPACE: u64 = 32
const SLASH: u64 = 47
const DASH: u64 = 45
const COMMA: u64 = 44
const COLON: u64 = 58

fn fs_name(state: u64, at: u64, t: u64) -> u64 {
    var n_ofs: [u8; 4] = "ofs\0"
    var n_proc: [u8; 5] = "proc\0"
    var n_dev: [u8; 9] = "devtmpfs\0"
    var n_fat: [u8; 5] = "vfat\0"
    var n_ext4: [u8; 5] = "ext4\0"
    var n_ntfs: [u8; 5] = "ntfs\0"
    var n_exfat: [u8; 6] = "exfat\0"
    var n_none: [u8; 5] = "none\0"
    if t == vfsops.FS_OFS {
        return pfproc.w_str(state, at, (&n_ofs[0]) as u64)
    }
    if t == vfsops.FS_PROC {
        return pfproc.w_str(state, at, (&n_proc[0]) as u64)
    }
    if t == vfsops.FS_DEV {
        return pfproc.w_str(state, at, (&n_dev[0]) as u64)
    }
    if t == vfsops.FS_FAT {
        return pfproc.w_str(state, at, (&n_fat[0]) as u64)
    }
    if t == vfsops.FS_EXT4 {
        return pfproc.w_str(state, at, (&n_ext4[0]) as u64)
    }
    if t == vfsops.FS_NTFS {
        return pfproc.w_str(state, at, (&n_ntfs[0]) as u64)
    }
    if t == vfsops.FS_EXFAT {
        return pfproc.w_str(state, at, (&n_exfat[0]) as u64)
    }
    return pfproc.w_str(state, at, (&n_none[0]) as u64)
}

fn access_text(state: u64, at: u64, m: u64) -> u64 {
    var rw: [u8; 3] = "rw\0"
    var ro: [u8; 3] = "ro\0"
    if (mnt.flags(state, m) & mnt.F_RDONLY) != 0 {
        return pfproc.w_str(state, at, (&ro[0]) as u64)
    }
    return pfproc.w_str(state, at, (&rw[0]) as u64)
}

fn root_mount(state: u64) -> u64 {
    var m: u64 = 0
    while m < mnt.MAX_MNT {
        if mnt.used(state, m) && mnt.path_len(state, m) == 1 {
            return m
        }
        m = m + 1
    }
    return mnt.MAX_MNT
}

fn line(state: u64, at: u64, m: u64, parent: u64) -> u64 {
    var relatime: [u8; 10] = ",relatime\0"
    var p: u64 = pfproc.w_num(state, at, m + 1)
    p = pfproc.w_ch(state, p, SPACE)
    p = pfproc.w_num(state, p, parent + 1)
    p = pfproc.w_ch(state, p, SPACE)
    p = pfproc.w_ch(state, p, 48)
    p = pfproc.w_ch(state, p, COLON)
    p = pfproc.w_num(state, p, m + 1)
    p = pfproc.w_ch(state, p, SPACE)
    p = pfproc.w_ch(state, p, SLASH)
    p = pfproc.w_ch(state, p, SPACE)
    p = pfproc.w_str(state, p, mnt.path_at(state, m))
    p = pfproc.w_ch(state, p, SPACE)
    p = access_text(state, p, m)
    p = pfproc.w_str(state, p, (&relatime[0]) as u64)
    p = pfproc.w_ch(state, p, SPACE)
    p = pfproc.w_ch(state, p, DASH)
    p = pfproc.w_ch(state, p, SPACE)
    p = fs_name(state, p, mnt.fstype(state, m))
    p = pfproc.w_ch(state, p, SPACE)
    p = pfproc.source_text(state, p, m)
    p = pfproc.w_ch(state, p, SPACE)
    p = access_text(state, p, m)
    return pfproc.w_nl(state, p)
}

fn make(state: u64) -> u64 {
    let root: u64 = root_mount(state)
    var p: u64 = 0
    var m: u64 = 0
    while m < mnt.MAX_MNT {
        if mnt.used(state, m) {
            var parent: u64 = root
            if m == root || root >= mnt.MAX_MNT {
                parent = m
            }
            p = line(state, p, m, parent)
        }
        m = m + 1
    }
    return p
}
