profile kernel

import net.netdev
import net.upstat
import fs.procfs.pfproc

export { make, make_connectivity, w_card_name, w_uplink_name }

fn w_col(state: u64, at: u64, v: u64) -> u64 {
    let p: u64 = pfproc.w_ch(state, at, 32)
    return pfproc.w_num(state, p, v)
}

fn w_zeros(state: u64, at: u64, n: u64) -> u64 {
    var p: u64 = at
    var z: u64 = 0
    while z < n {
        p = w_col(state, p, 0)
        z = z + 1
    }
    return p
}

fn w_ifname(state: u64, at: u64, k: u64, eth_index: u64) -> u64 {
    var s_eth: [u8; 4] = "eth\0"
    var s_usb: [u8; 4] = "usb\0"
    var s_wlan: [u8; 5] = "wlan\0"
    var p: u64 = at
    if k == netdev.KIND_WLAN {
        p = pfproc.w_str(state, p, (&s_wlan[0]) as u64)
        p = pfproc.w_num(state, p, 0)
    } else if k == netdev.KIND_USBNET {
        p = pfproc.w_str(state, p, (&s_usb[0]) as u64)
        p = pfproc.w_num(state, p, 0)
    } else {
        p = pfproc.w_str(state, p, (&s_eth[0]) as u64)
        p = pfproc.w_num(state, p, eth_index)
    }
    return p
}

fn w_name(state: u64, at: u64, k: u64, eth_index: u64) -> u64 {
    var p: u64 = pfproc.w_ch(state, at, 32)
    p = pfproc.w_ch(state, p, 32)
    p = w_ifname(state, p, k, eth_index)
    return pfproc.w_ch(state, p, 58)
}

fn is_eth(k: u64) -> bool {
    return k != netdev.KIND_WLAN && k != netdev.KIND_USBNET
}

fn w_card_name(state: u64, at: u64, card: u64) -> u64 {
    var eth: u64 = 0
    var c: u64 = 0
    while c < card {
        let k: u64 = netdev.kind_on(state, c)
        if k != netdev.KIND_NONE && netdev.present_on(state, c) && is_eth(k) {
            eth = eth + 1
        }
        c = c + 1
    }
    return w_ifname(state, at, netdev.kind_on(state, card), eth)
}

fn w_uplink_name(state: u64, at: u64) -> u64 {
    var s_default: [u8; 5] = "eth0\0"
    if netdev.uplink(state) >= netdev.MAX_CARDS {
        return pfproc.w_str(state, at, (&s_default[0]) as u64)
    }
    return w_card_name(state, at, netdev.uplink(state))
}

fn w_card(state: u64, at: u64, c: u64, eth_index: u64) -> u64 {
    var p: u64 = w_name(state, at, netdev.kind_on(state, c), eth_index)
    p = w_col(state, p, netdev.rx_octets_on(state, c))
    p = w_col(state, p, netdev.rx_frames_on(state, c))
    p = w_zeros(state, p, 6)
    p = w_col(state, p, netdev.tx_octets_on(state, c))
    p = w_col(state, p, netdev.tx_frames_on(state, c))
    p = w_col(state, p, 0)
    p = w_col(state, p, netdev.tx_drops_on(state, c))
    p = w_zeros(state, p, 4)
    return pfproc.w_nl(state, p)
}

fn make(state: u64) -> u64 {
    var h1: [u8; 58] = "Inter-|   Receive                            |  Transmit\n\0"
    var h2: [u8; 118] = " face |bytes packets errs drop fifo frame compressed multicast|bytes packets errs drop fifo colls carrier compressed\n\0"
    var p: u64 = pfproc.w_str(state, 0, (&h1[0]) as u64)
    p = pfproc.w_str(state, p, (&h2[0]) as u64)
    if !netdev.probed(state) {
        return p
    }
    var eth: u64 = 0
    var c: u64 = 0
    while c < netdev.MAX_CARDS {
        let k: u64 = netdev.kind_on(state, c)
        if k != netdev.KIND_NONE && netdev.present_on(state, c) {
            p = w_card(state, p, c, eth)
            if is_eth(k) {
                eth = eth + 1
            }
        }
        c = c + 1
    }
    return p
}

fn w_conn_state(state: u64, at: u64, st: u64) -> u64 {
    var s_unknown: [u8; 8] = "unknown\0"
    var s_online: [u8; 7] = "online\0"
    var s_local: [u8; 11] = "local-only\0"
    var s_offline: [u8; 8] = "offline\0"
    if st == upstat.UP_ONLINE { return pfproc.w_str(state, at, (&s_online[0]) as u64) }
    if st == upstat.UP_LOCAL { return pfproc.w_str(state, at, (&s_local[0]) as u64) }
    if st == upstat.UP_OFFLINE { return pfproc.w_str(state, at, (&s_offline[0]) as u64) }
    return pfproc.w_str(state, at, (&s_unknown[0]) as u64)
}

fn w_conn_line(state: u64, at: u64, c: u64) -> u64 {
    var s_default: [u8; 9] = " default\0"
    var p: u64 = w_card_name(state, at, c)
    p = pfproc.w_ch(state, p, 32)
    p = w_conn_state(state, p, upstat.status(c))
    if netdev.uplink(state) == c {
        p = pfproc.w_str(state, p, (&s_default[0]) as u64)
    }
    return pfproc.w_nl(state, p)
}

fn make_connectivity(state: u64) -> u64 {
    var p: u64 = 0
    if !netdev.probed(state) {
        return p
    }
    var c: u64 = 0
    while c < netdev.MAX_CARDS {
        let k: u64 = netdev.kind_on(state, c)
        if k != netdev.KIND_NONE && netdev.present_on(state, c) {
            p = w_conn_line(state, p, c)
        }
        c = c + 1
    }
    return p
}
