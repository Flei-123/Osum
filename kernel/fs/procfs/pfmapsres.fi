profile kernel

import fs.procfs.pfbase

export { remember, resume, cursor, offset, limit, set_stream }

const READ_AHEAD_BYTES: u64 = 4096

static mut cell: [u64; 3] = [0 as u64; 3]
static mut streaming: u64 = 0

fn set_stream(on: bool) {
    if on {
        streaming = 1
    } else {
        streaming = 0
    }
}

fn windowed(base: u64) -> bool {
    return streaming != 0 && base != pfbase.COUNT_ONLY
}

fn remember(t: u64, cur: u64, p: u64) {
    let base: u64 = pfbase.window_base()
    if !windowed(base) || p > base {
        return
    }
    cell[0 as usize] = t + 1
    cell[1 as usize] = cur
    cell[2 as usize] = p
}

fn resume(t: u64) -> bool {
    let base: u64 = pfbase.window_base()
    if !windowed(base) || base == 0 {
        return false
    }
    return cell[0 as usize] == t + 1 && cell[2 as usize] <= base
}

fn cursor() -> u64 {
    return cell[1 as usize]
}

fn offset() -> u64 {
    return cell[2 as usize]
}

fn limit(full: u64) -> u64 {
    let base: u64 = pfbase.window_base()
    if !windowed(base) {
        return full
    }
    return base + READ_AHEAD_BYTES
}
