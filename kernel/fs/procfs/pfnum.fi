profile kernel

import lib.kstate

export { num_name }

fn num_name(state: u64, v: u64, out: u64) {
    var digits: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        kstate.set8(out, 48 as u8)
        kstate.set8(out + 1, 0 as u8)
        return
    }
    while x > 0 {
        digits[n as usize] = ((x % 10) + 48) as u8
        x = x / 10
        n = n + 1
    }
    var k: u64 = 0
    while n > 0 {
        n = n - 1
        kstate.set8(out + k, digits[n as usize])
        k = k + 1
    }
    kstate.set8(out + k, 0 as u8)
}
