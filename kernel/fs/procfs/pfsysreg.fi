profile kernel

import lib.kstate
import fs.pathseg
import fs.procfs.pfproc
import fs.procfs.pfsystab
import fs.procfs.pfsysval

export { sys_root, net_root, pressure_root, sfs_root, node_root, memory_root, id_of, is_dir, walk, nth, count, child_named, name, make }

const DIR_FLAG: u64 = 0x800000
const PLEN_SHIFT: u64 = 13
const PLEN_MASK: u64 = 0x7F
const OFFSET_MASK: u64 = 0x1FFF
const ID_MASK: u64 = 0xFFFFFF
const SEP_FIELD: u64 = 124
const SEP_DIR: u64 = 47
const NEWLINE: u64 = 10
const KIND_NUMBER: u64 = 110
const KIND_PROVIDER: u64 = 112
const SEG_MAX: u64 = 40
const CHILD_CACHE_SLOTS: u64 = 64
const COUNT_CACHE_SLOTS: u64 = 16
const HASH_MASK: u64 = 0xFFFFFFFF
const LINE_MAX: u64 = 256

static mut root_cache: [u64; 6] = [0 as u64; 6]
static mut child_cache: [u64; 64] = [0 as u64; 64]
static mut count_key: [u64; 16] = [0 as u64; 16]
static mut count_val: [u64; 16] = [0 as u64; 16]
static mut line_starts: [u16; 256] = [0 as u16; 256]
static mut line_total: u64 = 0
static mut lines_built: bool = false

fn tab(at: u64) -> u64 {
    return kstate.get8(pfsystab.base() + at)
}

fn dir_id(offset: u64, plen: u64) -> u64 {
    return DIR_FLAG | (plen << PLEN_SHIFT) | offset
}

fn id_of(node: u64) -> u64 {
    return node & ID_MASK
}

fn is_dir(id: u64) -> bool {
    return (id & DIR_FLAG) != 0
}

fn plen_of(id: u64) -> u64 {
    return (id >> PLEN_SHIFT) & PLEN_MASK
}

fn offset_of(id: u64) -> u64 {
    return id & OFFSET_MASK
}

fn slash_end(line: u64) -> u64 {
    var n: u64 = 0
    while tab(line + n) != SEP_DIR {
        n = n + 1
    }
    return n + 1
}

fn tree_root(first: u64, second: u64) -> u64 {
    let total: u64 = line_count()
    var li: u64 = 0
    while li < total {
        let at: u64 = line_at(li)
        if tab(at) == first && tab(at + 1) == second {
            return dir_id(at, slash_end(at))
        }
        li = li + 1
    }
    return 0
}

fn cached_root(slot: u64, first: u64, second: u64) -> u64 {
    let known: u64 = root_cache[(slot) as usize]
    if known != 0 {
        return known
    }
    let found: u64 = tree_root(first, second)
    root_cache[(slot) as usize] = found
    return found
}

fn sys_root() -> u64 {
    return cached_root(0, 115, 121)
}

fn net_root() -> u64 {
    return cached_root(1, 110, 101)
}

fn pressure_root() -> u64 {
    return cached_root(2, 112, 114)
}

fn sfs_root() -> u64 {
    return cached_root(3, 115, 102)
}

fn node_root() -> u64 {
    return cached_root(4, 110, 111)
}

fn memory_root() -> u64 {
    return cached_root(5, 109, 101)
}

fn build_lines() {
    var n: u64 = 0
    var i: u64 = 0
    while i < pfsystab.LEN {
        if tab(i) == NEWLINE && i + 1 < pfsystab.LEN && n < LINE_MAX {
            line_starts[(n) as usize] = (i + 1) as u16
            n = n + 1
        }
        i = i + 1
    }
    line_total = n
    lines_built = true
}

fn line_count() -> u64 {
    if !lines_built {
        build_lines()
    }
    return line_total
}

fn line_at(index: u64) -> u64 {
    return line_starts[(index) as usize] as u64
}

fn has_prefix(line: u64, ref: u64, plen: u64) -> bool {
    var i: u64 = 0
    while i < plen {
        if tab(line + i) != tab(ref + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn part_len(line: u64, plen: u64) -> u64 {
    var n: u64 = 0
    while tab(line + plen + n) != SEP_DIR && tab(line + plen + n) != SEP_FIELD {
        n = n + 1
    }
    return n
}

fn same_part(a: u64, b: u64, plen: u64, n: u64) -> bool {
    if part_len(b, plen) != n {
        return false
    }
    var i: u64 = 0
    while i < n {
        if tab(a + plen + i) != tab(b + plen + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn child_id(line: u64, plen: u64) -> u64 {
    let n: u64 = part_len(line, plen)
    if tab(line + plen + n) == SEP_DIR {
        return dir_id(line, plen + n + 1)
    }
    return line
}

fn first_of_part(line: u64, ref: u64, plen: u64) -> bool {
    let n: u64 = part_len(line, plen)
    var li: u64 = 0
    while li < line_count() {
        let at: u64 = line_at(li)
        if at >= line {
            return true
        }
        if has_prefix(at, ref, plen) && same_part(line, at, plen, n) {
            return false
        }
        li = li + 1
    }
    return true
}

fn nth(dir: u64, index: u64) -> u64 {
    let ref: u64 = offset_of(dir)
    let plen: u64 = plen_of(dir)
    var seen: u64 = 0
    let total: u64 = line_count()
    var li: u64 = 0
    while li < total {
        let at: u64 = line_at(li)
        if has_prefix(at, ref, plen) && first_of_part(at, ref, plen) {
            if seen == index {
                return child_id(at, plen)
            }
            seen = seen + 1
        }
        li = li + 1
    }
    return 0
}

fn count_scan(dir: u64) -> u64 {
    var n: u64 = 0
    while nth(dir, n) != 0 {
        n = n + 1
    }
    return n
}

fn count(dir: u64) -> u64 {
    let slot: u64 = ((dir ^ (dir >> 3)) & (COUNT_CACHE_SLOTS - 1))
    if dir != 0 && count_key[(slot) as usize] == dir {
        return count_val[(slot) as usize]
    }
    let n: u64 = count_scan(dir)
    count_key[(slot) as usize] = dir
    count_val[(slot) as usize] = n
    return n
}

fn child_slot(dir: u64, seg: u64, seg_len: u64) -> u64 {
    var h: u64 = dir * 31 + seg_len
    var i: u64 = 0
    while i < seg_len {
        h = (h * 31 + kstate.get8(seg + i)) & HASH_MASK
        i = i + 1
    }
    return h & (CHILD_CACHE_SLOTS - 1)
}

fn line_matches(at: u64, ref: u64, plen: u64, seg: u64, seg_len: u64) -> bool {
    if !has_prefix(at, ref, plen) || part_len(at, plen) != seg_len {
        return false
    }
    var i: u64 = 0
    while i < seg_len {
        if tab(at + plen + i) != kstate.get8(seg + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn find_child(dir: u64, seg: u64, seg_len: u64) -> u64 {
    let ref: u64 = offset_of(dir)
    let plen: u64 = plen_of(dir)
    let slot: u64 = child_slot(dir, seg, seg_len)
    let hint: u64 = child_cache[(slot) as usize]
    if hint != 0 && hint < pfsystab.LEN && line_matches(hint, ref, plen, seg, seg_len) {
        return child_id(hint, plen)
    }
    let total: u64 = line_count()
    var li: u64 = 0
    while li < total {
        let at: u64 = line_at(li)
        if line_matches(at, ref, plen, seg, seg_len) {
            child_cache[(slot) as usize] = at
            return child_id(at, plen)
        }
        li = li + 1
    }
    return 0
}

fn str_len(p: u64) -> u64 {
    var n: u64 = 0
    while kstate.get8(p + n) != 0 {
        n = n + 1
    }
    return n
}

fn child_named(dir: u64, seg: u64) -> u64 {
    return find_child(dir, seg, str_len(seg))
}

fn walk(path: u64, from: u64, root: u64) -> u64 {
    var cur: u64 = root
    var pos: u64 = from
    var seg: [u8; 40] = [0 as u8; 40]
    var guard: u64 = 0
    while guard < 8 {
        pos = pathseg.segment(path, pos, (&seg[0]) as u64, SEG_MAX)
        let n: u64 = str_len((&seg[0]) as u64)
        if n == 0 {
            return cur
        }
        if !is_dir(cur) {
            return 0
        }
        cur = find_child(cur, (&seg[0]) as u64, n)
        if cur == 0 {
            return 0
        }
        guard = guard + 1
    }
    return 0
}

fn name(id: u64, out: u64) {
    var end: u64 = offset_of(id)
    if is_dir(id) {
        end = end + plen_of(id) - 1
    } else {
        end = end + path_len(end)
    }
    var start: u64 = end
    while start > 0 && tab(start - 1) != SEP_DIR && tab(start - 1) != NEWLINE {
        start = start - 1
    }
    var i: u64 = 0
    while start + i < end {
        kstate.set8(out + i, tab(start + i) as u8)
        i = i + 1
    }
    kstate.set8(out + i, 0 as u8)
}

fn path_len(line: u64) -> u64 {
    var n: u64 = 0
    while tab(line + n) != SEP_FIELD {
        n = n + 1
    }
    return n
}

fn number_at(at: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = at
    while tab(i) >= 48 && tab(i) <= 57 {
        v = v * 10 + (tab(i) - 48)
        i = i + 1
    }
    return v
}

fn write_text(state: u64, at: u64) -> u64 {
    var p: u64 = 0
    var i: u64 = at
    while tab(i) != NEWLINE {
        p = pfproc.w_ch(state, p, tab(i))
        i = i + 1
    }
    return pfproc.w_nl(state, p)
}

fn make(state: u64, id: u64) -> u64 {
    if is_dir(id) {
        return 0
    }
    let value: u64 = offset_of(id) + path_len(offset_of(id)) + 3
    let kind: u64 = tab(value - 2)
    if kind == KIND_PROVIDER {
        return pfsysval.make(state, number_at(value))
    }
    if kind == KIND_NUMBER {
        return pfproc.w_nl(state, pfproc.w_num(state, 0, number_at(value)))
    }
    return write_text(state, value)
}
