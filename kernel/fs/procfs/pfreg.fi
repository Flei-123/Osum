profile kernel

import lib.kstate
import fs.procfs.pfinterrupts
import fs.procfs.pfpidextra
import fs.procfs.pfpidview
import fs.procfs.pfsys
import fs.procfs.pfsysview

export { TOP_FIRST, TOP_COUNT, PID_FIRST, PID_COUNT, top_id, top_name, top_make, pid_id, pid_name, pid_make }

const TOP_FIRST: u64 = 54
const TOP_COUNT: u64 = 8
const PID_FIRST: u64 = 11
const PID_COUNT: u64 = 16
const NEWLINE: u64 = 10
const NAME_MAX: u64 = 24

static mut top_names: [u8; 73] = b"filesystems\x0acmdline\x0aswaps\x0avmstat\x0adiskstats\x0apartitions\x0adevices\x0ainterrupts\x0a"

static mut pid_names: [u8; 133] = b"environ\x0acomm\x0aauxv\x0astatm\x0asmaps_rollup\x0aoom_score_adj\x0aoom_score\x0aio\x0amounts\x0apersonality\x0awchan\x0acpuset\x0aloginuid\x0atimerslack_ns\x0asyscall\x0asched\x0a"

fn name_start(table: u64, index: u64) -> u64 {
    var at: u64 = 0
    var skip: u64 = index
    while skip > 0 {
        while kstate.get8(table + at) != NEWLINE {
            at = at + 1
        }
        at = at + 1
        skip = skip - 1
    }
    return table + at
}

fn copy_name(table: u64, index: u64, out: u64) {
    var src: u64 = name_start(table, index)
    var i: u64 = 0
    while kstate.get8(src + i) != NEWLINE && i < NAME_MAX {
        kstate.set8(out + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(out + i, 0 as u8)
}

fn find_id(table: u64, count: u64, first: u64, name: u64) -> u64 {
    var buf: [u8; 25] = [0 as u8; 25]
    var k: u64 = 0
    while k < count {
        copy_name(table, k, (&buf[0]) as u64)
        if pfsys.streq(name, (&buf[0]) as u64) {
            return first + k
        }
        k = k + 1
    }
    return 0
}

fn top_id(name: u64) -> u64 {
    return find_id((&top_names[0]) as u64, TOP_COUNT, TOP_FIRST, name)
}

fn top_name(sub: u64, out: u64) {
    copy_name((&top_names[0]) as u64, sub - TOP_FIRST, out)
}

fn top_make(state: u64, sub: u64) -> u64 {
    let k: u64 = sub - TOP_FIRST
    if k == 0 {
        return pfsysview.make_filesystems(state)
    }
    if k == 1 {
        return pfsysview.make_cmdline(state)
    }
    if k == 2 {
        return pfsysview.make_swaps(state)
    }
    if k == 3 {
        return pfsysview.make_vmstat(state)
    }
    if k == 4 {
        return pfsysview.make_diskstats(state)
    }
    if k == 5 {
        return pfsysview.make_partitions(state)
    }
    if k == 6 {
        return pfsysview.make_devices(state)
    }
    return pfinterrupts.make(state)
}

fn pid_id(name: u64) -> u64 {
    return find_id((&pid_names[0]) as u64, PID_COUNT, PID_FIRST, name)
}

fn pid_name(sub: u64, out: u64) {
    copy_name((&pid_names[0]) as u64, sub - PID_FIRST, out)
}

fn pid_make(state: u64, slot: u64, sub: u64) -> u64 {
    let k: u64 = sub - PID_FIRST
    if k == 0 {
        return pfpidview.make_environ(state, slot)
    }
    if k == 1 {
        return pfpidview.make_comm(state, slot)
    }
    if k == 2 {
        return pfpidview.make_auxv(state, slot)
    }
    if k == 3 {
        return pfpidview.make_statm(state, slot)
    }
    if k == 4 {
        return pfpidview.make_smaps_rollup(state, slot)
    }
    if k == 5 {
        return pfpidview.make_oom_score_adj(state, slot)
    }
    if k == 6 {
        return pfpidview.make_oom_score(state, slot)
    }
    if k == 7 {
        return pfpidview.make_io(state, slot)
    }
    if k == 8 {
        return pfpidview.make_mounts(state, slot)
    }
    if k == 9 {
        return pfpidview.make_personality(state, slot)
    }
    if k == 10 {
        return pfpidextra.make_wchan(state, slot)
    }
    if k == 11 {
        return pfpidextra.make_cpuset(state, slot)
    }
    if k == 12 {
        return pfpidextra.make_loginuid(state, slot)
    }
    if k == 13 {
        return pfpidextra.make_timerslack(state, slot)
    }
    if k == 14 {
        return pfpidextra.make_syscall(state, slot)
    }
    return pfpidextra.make_sched(state, slot)
}
