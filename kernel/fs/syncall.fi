profile kernel

import fs.vfs
import fs.mnt
import fs.vfsops
import fs.fat
import fs.exfat
import block.blk
import fs.jsync

export { sync_all }

fn sync_all(state: u64) -> bool {
    let journal_ok: bool = jsync.sync(state)
    var k: u64 = 0
    while k < vfs.MAX_MNT {
        if mnt.used(state, k) && mnt.fstype(state, k) == vfsops.FS_FAT {
            fat.sync(state, k)
        }
        if mnt.used(state, k) && mnt.fstype(state, k) == vfsops.FS_EXFAT {
            exfat.sync(state, k)
        }
        k = k + 1
    }
    let flushed: bool = blk.flush(state)
    return journal_ok && flushed
}
