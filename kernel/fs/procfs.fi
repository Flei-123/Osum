
profile kernel

import fs.vfsops
import bus.drvreg
import fs.procfs.pfnode
import fs.procfs.pfproc

export { ops, node_root, sfs_root }

fn ops() -> vfsops.Ops {
    return pfnode.ops()
}

fn node_root(state: u64) -> u64 {
    return pfproc.node_root(state)
}

fn sfs_root(state: u64) -> u64 {
    return pfproc.sfs_root(state)
}
