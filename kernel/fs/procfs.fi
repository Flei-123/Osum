// SPDX-License-Identifier: GPL-2.0-only
// kernel/procfs.fi -- Runde K14: /proc, ein Dateisystem aus nichts.
//
// EINE DATEI, DIE NIRGENDS LIEGT. Jede Datei bis zu dieser Runde hatte
// Bloecke auf einer Platte. Die Dateien hier haben keine: sie ENTSTEHEN
// in dem Augenblick, in dem jemand sie liest, aus dem Zustand des
// laufenden Kernels, und sie sind wieder weg, sobald das `read` zurueck
// ist. Das ist der ganze Trick von /proc, und es ist der Grund, warum
// dieses Verzeichnis in jedem Unix seit 1984 existiert: ein Programm in
// Ring 3 darf keine Kernelvariable lesen, aber es darf eine Datei lesen.
//
// WAS DAS ERSETZT. Runde K6 hat dafuer zwei SYSTEMAUFRUFE gebaut --
// SYS_OSUM_PSTAT (Nummer 1003) und SYS_OSUM_SYSINFO (1002), je ein Feld
// je Aufruf, und `ps`, `top`, `df`, `uname` und `date` fragen darueber.
// Das ist eine eigene ABI fuer eine Frage, die jedes Unix ueber das
// Dateisystem beantwortet. Von dieser Runde an geht es auch ueber
// Dateien.
//
// DIE BEIDEN AUFRUFE BLEIBEN. Der Auftrag dieser Runde sagt es
// ausdruecklich, und es ist auch die einzige ehrliche Reihenfolge: erst
// wird gemessen, dass beide Wege DIESELBEN ZAHLEN liefern, dann darf
// man ueber das Entfernen des einen reden. `tools/k14/run.sh` haelt
// `ps` (ueber PSTAT) und `cat /proc/<pid>/status` (ueber dieses
// Dateisystem) Zeile fuer Zeile gegeneinander -- und ein Unterschied
// ist ein Fehler, egal in welchem der beiden.
//
// WAS DRIN STEHT:
//
//   /proc/meminfo    Rahmen, freie Rahmen, nutzbarer Speicher
//   /proc/cpuinfo    je Prozessor eine Gruppe: Nummer, APIC-Kennung,
//                    ob er laeuft, wie viele Wechsel er hatte
//   /proc/uptime     Sekunden seit dem Start, mit Hundertsteln
//   /proc/mounts     die Einhaengetafel aus `mnt.fi`, in der Form, die
//                    Linux' /proc/mounts hat
//   /proc/stat       Ticks, Kontextwechsel, Systemaufrufe, Prozesse
//   /proc/version    was `uname` sagt
//   /proc/<pid>/     ein Verzeichnis je lebendem Prozess, darin:
//     status         Name, Pid, PPid, Zustand, Vorrang, Ticks, Fehler
//     stat           dieselben Zahlen in einer Zeile
//     cmdline        die Argumente, wie `execve` sie hingelegt hat --
//                    GELESEN AUS DEM ADRESSRAUM DES PROZESSES ueber
//                    `proc.translate`, nicht aus einer Kopie
//     maps           WELCHE SEITEN WIRKLICH ABGEBILDET SIND. Das ist
//                    keine Liste von Konstanten: die Seitentabelle des
//                    Prozesses wird Seite fuer Seite abgelaufen
//                    (`proc.translate`, `proc.page_exec`), und was
//                    zusammenhaengt, wird zu einer Zeile. Ein Prozess,
//                    der eine Seite mehr per `mmap` nimmt, hat danach
//                    eine andere Datei -- und genau das misst
//                    `tools/k14/run.sh`.
//     fd/            ein Verzeichnis mit den offenen Deskriptoren
//
// KEINE SYMBOLISCHEN VERWEISE. Linux macht aus /proc/<pid>/fd/1 einen
// Verweis; dieser Kernel hat keine. Die Eintraege sind hier gewoehnliche
// Dateien, deren INHALT sagt, was der Deskriptor ist ("file 12",
// "pipe", "tty 0"). Das steht so in docs/ROUNDK14.md, damit niemand
// spaeter glaubt, hier fehle etwas.
//
// WO DER TEXT ENTSTEHT: auf `kstate.PROCFS_OFF`, EINER Seite, mit
// `atomic.L_PROC` darum. Zwei Kerne, die gleichzeitig `/proc/meminfo`
// lesen, wuerden sich sonst ihre Texte ineinanderschreiben.

profile kernel

import lib.kstate
import klog
// RUNDE MARKE: der Produktname kommt aus EINER Quelle.
import lib.brand
import fs.mnt
import fs.vfsops
import sched.sched
import net.wlan_auto
import sched.proc
import sched.origin
import fs.file
import drv.con.odbuart
import diag.safe
import arch.cpu
import sync.atomic
import ipc.uio
import block.blk
import diag.hwid
import sched.rand
import net.inet
import bus.pci
import drv.net.iwl
import drv.net.usbnet
import wlan.iwl_probe
import apprights.policy
import usb.usb
import drv.usb.xhci
import diag.hwdiag
import acpi.acpi
import acpi.acpidev
import acpi.dmar
import pwr.blchain
import pwr.hotkeys
import pwr.hkdiag
import drv.hid.i2chid
import bus.drvreg
import bus.drvdev
import gfx.gfx
import arch.x86_64.fpu
import mm.mem
import ui.frameprof
import gfx.fb
import gfx.fbmtrr
import ui.sysmon

export { ops, node_root, sfs_root }

// ------------------------------------------------------------ die Knoten
//
// Ein Knoten ist EINE ZAHL, und sie traegt drei Dinge:
//
//     Art * 0x1000000  +  Aufgabenplatz * 0x100  +  Unterart
//
// Die Art sagt, was es ist; der Aufgabenplatz, zu welchem Prozess es
// gehoert; die Unterart, welche der Dateien. Damit braucht dieses
// Dateisystem KEINE Tafel im Speicher -- ein Knoten ist selbsterklaerend
// und ueberlebt jedes `fork`, weil er nichts festhaelt.
const K_ROOT: u64 = 1
const K_GLOBAL: u64 = 2
const K_PIDDIR: u64 = 3
const K_PIDFILE: u64 = 4
const K_FDDIR: u64 = 5
const K_FDFILE: u64 = 6
// ROUND UNTERBAU: /proc/sys/... (sub = which entry)
const K_SYS: u64 = 7
// ROUND LC-004: /sys (second procfs mount, mnt.dev == 1): node(K_SFS, cpu, sub). Only what is measured: the CPU set and the
// first cache level from CPUID leaf 4. Nothing else of sysfs exists yet (no class/, no fs/).
const K_SFS: u64 = 8
const SF_ROOT: u64 = 1
const SF_DEVICES: u64 = 2
const SF_SYSTEM: u64 = 3
const SF_CPU: u64 = 4
const SF_ONLINE: u64 = 5
const SF_POSSIBLE: u64 = 6
const SF_PRESENT: u64 = 7
const SF_CPUN: u64 = 8
const SF_CACHE: u64 = 9
const SF_IDX0: u64 = 10
const SF_C_LEVEL: u64 = 11
const SF_C_TYPE: u64 = 12
const SF_C_SIZE: u64 = 13
const SF_C_LINE: u64 = 14
const SF_C_SETS: u64 = 15
const SF_C_WAYS: u64 = 16
const S_SYS: u64 = 1
const S_KERNEL: u64 = 2
const S_VM: u64 = 3
const S_RANDOM: u64 = 4
const S_PIDMAX: u64 = 5
const S_OVERCOMMIT: u64 = 6
const S_UUID: u64 = 7
// ROUND STONES2: /proc/net/dev (busybox ifconfig lists the interfaces from it)
const S_NET: u64 = 8
const S_NETDEV: u64 = 9

const ART: u64 = 0x1000000
const SLOT: u64 = 0x100

// Die globalen Dateien.
const G_MEMINFO: u64 = 1
const G_CPUINFO: u64 = 2
const G_UPTIME: u64 = 3
const G_MOUNTS: u64 = 4
const G_STAT: u64 = 5
const G_VERSION: u64 = 6
// RUNDE TRESOR: /proc/hwid -- die Geraeteidentitaet. Sie steht HIER und
// nicht hinter einem eigenen Systemaufruf, weil sie genau das ist, was
// /proc gut kann: ein Blick auf den Kernzustand, den ein Programm in Ring
// 3 ohne eigene ABI lesen darf.
const G_HWID: u64 = 7
// ==================================================== RUNDE PROTOKOLL
//
// /proc/klog -- DAS KERNPROTOKOLL, SO WEIT ES AUF EINE SEITE PASST.
//
// UND DAS IST DIE EINSCHRAENKUNG, DIE HIER STEHT UND NICHT IN EINER
// FUSSNOTE: eine Datei dieses Dateisystems entsteht in EINEM
// Seitenpuffer (`kstate.PROCFS_OFF`, 4096 Oktette). Der Ring haelt 510
// Zeilen zu bis zu 130 Oktetten -- das ist das Sechzehnfache. Also
// stehen hier die LETZTEN Zeilen, so viele wie hineinpassen, und die
// erste Zeile sagt, wie viele es sind und wie viele fehlen.
//
// WER ALLES WILL, NIMMT /dev/klog (der Strom hat keine Grenze) oder
// /bin/log (das liest nach Laufnummern). Diese Datei ist die bequeme
// Antwort auf "was ist gerade los", nicht das Archiv.
const G_KLOG: u64 = 8
// ROUND UNTERBAU: /proc/loadavg and the directory /proc/sys (a directory is not
// a global file: lookup and readdir treat G_SYSDIR specially).
const G_LOADAVG: u64 = 9
const G_SYSDIR: u64 = 10
const G_NETDIR: u64 = 11
// ROUND MINT2 (E1): hardware tables for the system report.
const G_PCI: u64 = 12
const G_USB: u64 = 13
const G_FIRMWARE: u64 = 14
// ROUND W-IWL (M1b): /proc/wlan, what iwl.fi read from the Intel WLAN MAC.
const G_WLAN: u64 = 15
// ROUND W-AR3 (AR-2b): /proc/apps, the per-app counters of lib/apprights/policy.fi.
const G_APPS: u64 = 16
// ROUND W-O1I: /proc/odb, the ODB agent's view of the kernel: `odb=1` on the command line and the UART receiver-overrun counter.
const G_ODB: u64 = 17
// ROUND BENCH-A: /proc/bench, `key value` lines for the in-OS `bench` tool: boot milestones (ms since kernel entry), kernel heap, trap count.
const G_BENCH: u64 = 18
const G_FRAMES: u64 = 19
const G_ACPI: u64 = 20
const G_SYSMON: u64 = 21
const G_GPU: u64 = 22
const G_SAFE: u64 = 23
const G_DMAR: u64 = 24
const G_DRIVERS: u64 = 25
const G_BACKLIGHT: u64 = 26
const G_CPUS: u64 = 27 // W-SMP2: /proc/cpus
const G_INPUTDEVS: u64 = 28 // W-TOUCH4: /proc/inputdevs
const G_HOTKEYS: u64 = 29 // W-HW6: /proc/hotkeys
const G_USBNET: u64 = 30 // W-CH336-3: /proc/usbnet
const G_LAST: u64 = 30
const GPU_NA: u64 = 0xFFFFFFFFFFFFFFFF

// Die Dateien je Prozess.
const F_STATUS: u64 = 1
const F_STAT: u64 = 2
const F_CMDLINE: u64 = 3
const F_MAPS: u64 = 4
const F_FD: u64 = 5 // das VERZEICHNIS fd/
const F_LIMITS: u64 = 6
const F_CGROUP: u64 = 7
const F_EXE: u64 = 8 // symlink: the program the task was started from
const F_CWD: u64 = 9 // symlink: its working directory
const F_LAST: u64 = 9

const BUF_MAX: u64 = 4000 // von 4096; der Rest ist Luft fuer die letzte Zeile

fn node(art: u64, slot: u64, sub: u64) -> u64 {
    return art * ART + slot * SLOT + sub
}

fn n_art(n: u64) -> u64 {
    return n / ART
}

fn n_slot(n: u64) -> u64 {
    return (n / SLOT) % SLOT
}

fn n_sub(n: u64) -> u64 {
    return n % SLOT
}

fn node_root(state: u64) -> u64 {
    return node(K_ROOT, 0, 0)
}

// root node of the /sys mount (mnt.dev == 1)
fn sfs_root(state: u64) -> u64 {
    return node(K_SFS, 0, SF_ROOT)
}

fn tick(state: u64) {
    kstate.add(state, kstate.VFS_INDIRECT, 1)
}

// ------------------------------------------------------- der Textaufbau

fn buf(state: u64) -> u64 {
    return state + kstate.PROCFS_OFF
}

fn w_ch(state: u64, at: u64, c: u64) -> u64 {
    if at >= BUF_MAX {
        return at
    }
    kstate.set8(buf(state) + at, c as u8)
    return at + 1
}

fn w_str(state: u64, at: u64, s: u64) -> u64 {
    var p: u64 = at
    var i: u64 = 0
    while kstate.get8(s + i) != 0 {
        p = w_ch(state, p, kstate.get8(s + i))
        i = i + 1
    }
    return p
}

fn w_num(state: u64, at: u64, v: u64) -> u64 {
    var digits: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        return w_ch(state, at, 48)
    }
    while x > 0 {
        digits[n as usize] = ((x % 10) + 48) as u8
        x = x / 10
        n = n + 1
    }
    var p: u64 = at
    while n > 0 {
        n = n - 1
        p = w_ch(state, p, digits[n as usize] as u64)
    }
    return p
}

// Sechzehn Hexziffern, feste Breite -- so wie Linux' /proc/<pid>/maps
// seine Adressen schreibt. Feste Breite, damit sich die Spalten decken.
fn w_hex16(state: u64, at: u64, v: u64) -> u64 {
    var p: u64 = at
    var i: u64 = 16
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * 4)) & 15
        if d < 10 {
            p = w_ch(state, p, d + 48)
        } else {
            p = w_ch(state, p, d + 87)
        }
    }
    return p
}

fn w_nl(state: u64, at: u64) -> u64 {
    return w_ch(state, at, 10)
}

// ------------------------------------------------------- die Aufgaben

// Der Aufgabenplatz zu einer PID. MAX_TASKS heisst: gibt es nicht.
fn slot_of_pid(state: u64, pid: u64) -> u64 {
    var i: u64 = 0
    while i < kstate.get(state, kstate.TASKS) {
        if sched.tget(state, i, sched.T_STATE) != sched.S_FREE {
            if sched.tget(state, i, sched.T_PID) == pid {
                return i
            }
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

fn alive(state: u64, i: u64) -> bool {
    if i >= kstate.get(state, kstate.TASKS) {
        return false
    }
    return sched.tget(state, i, sched.T_STATE) != sched.S_FREE
}

// Der Buchstabe, den Linux' /proc/<pid>/stat an dritter Stelle traegt.
fn state_letter(s: u64) -> u64 {
    if s == sched.S_RUN {
        return 82 // R
    }
    if s == sched.S_READY {
        return 82 // R -- lauffaehig ist bei Linux dasselbe R
    }
    if s == sched.S_SLEEP {
        return 83 // S
    }
    if s == sched.S_WAIT {
        return 83 // S
    }
    if s == sched.S_ZOMBIE {
        return 90 // Z
    }
    if s == sched.S_STOP {
        return 84 // T
    }
    return 78 // N -- neu, noch nie gelaufen
}

fn kind_name(k: u64, out: u64) {
    var boot: [u8; 5] = "boot\0"
    var idle: [u8; 5] = "idle\0"
    var work: [u8; 7] = "worker\0"
    var user: [u8; 5] = "user\0"
    var netd: [u8; 5] = "netd\0"
    var grind: [u8; 6] = "grind\0"
    var src: u64 = (&user[0]) as u64
    if k == sched.K_BOOT {
        src = (&boot[0]) as u64
    } else if k == sched.K_IDLE {
        src = (&idle[0]) as u64
    } else if k == sched.K_WORKER {
        src = (&work[0]) as u64
    } else if k == sched.K_GRIND {
        src = (&grind[0]) as u64
    } else if k == sched.K_NETD {
        src = (&netd[0]) as u64
    }
    var i: u64 = 0
    while kstate.get8(src + i) != 0 {
        kstate.set8(out + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(out + i, 0 as u8)
}

// ------------------------------------------------------- die Erzeuger
//
// Jeder von ihnen schreibt seinen Text nach `buf` und gibt zurueck, wie
// lang er geworden ist. Keiner von ihnen weiss, wer ihn liest.

fn make_meminfo(state: u64) -> u64 {
    var t1: [u8; 17] = "MemTotal:      \0\0"
    var t2: [u8; 17] = "MemFree:       \0\0"
    var t3: [u8; 17] = "Frames:        \0\0"
    var t4: [u8; 17] = "FramesFree:    \0\0"
    var t5: [u8; 17] = "FrameSize:     \0\0"
    var kb: [u8; 4] = " kB\0"
    var p: u64 = 0
    p = w_str(state, p, (&t1[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.MEM_USABLE) / 1024)
    p = w_str(state, p, (&kb[0]) as u64)
    p = w_nl(state, p)
    p = w_str(state, p, (&t2[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.FRAMES_FREE) * 4)
    p = w_str(state, p, (&kb[0]) as u64)
    p = w_nl(state, p)
    var t2b: [u8; 17] = "MemAvailable:  \0\0"
    p = w_str(state, p, (&t2b[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.FRAMES_FREE) * 4)
    p = w_str(state, p, (&kb[0]) as u64)
    p = w_nl(state, p)
    p = w_str(state, p, (&t3[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.BITMAP_FRAMES))
    p = w_nl(state, p)
    p = w_str(state, p, (&t4[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.FRAMES_FREE))
    p = w_nl(state, p)
    p = w_str(state, p, (&t5[0]) as u64)
    p = w_num(state, p, 4096)
    p = w_nl(state, p)
    return p
}

fn make_cpuinfo(state: u64) -> u64 {
    var c1: [u8; 14] = "processor : \0\0"
    var c2: [u8; 14] = "apicid    : \0\0"
    var c3: [u8; 14] = "online    : \0\0"
    var c4: [u8; 14] = "switches  : \0\0"
    var c5: [u8; 14] = "ticks     : \0\0"
    // ROUND UNTERBAU: the lines feature detection by text looks for. Only the flags
    // every x86-64 CPU has by definition (long mode needs them) -- no guessed extras.
    var c6: [u8; 30] = "model name : x86-64 processor\0"
    var c7: [u8; 54] = "flags      : fpu tsc msr pae cx8 mmx fxsr sse sse2 lm\0"
    var p: u64 = 0
    // `cpu.count` ist die Zahl, die die FIRMWARE gemeldet hat -- und
    // sie ist null, solange `smp.fi` nicht gelaufen ist. Ein Lauf ohne
    // ACPI hat trotzdem einen Prozessor: den, auf dem er laeuft.
    var n: u64 = cpu.count(state)
    if n == 0 {
        n = 1
    }
    var i: u64 = 0
    while i < n {
        p = w_str(state, p, (&c1[0]) as u64)
        p = w_num(state, p, i)
        p = w_nl(state, p)
        p = w_str(state, p, (&c6[0]) as u64)
        p = w_nl(state, p)
        p = w_str(state, p, (&c7[0]) as u64)
        p = w_nl(state, p)
        p = w_str(state, p, (&c2[0]) as u64)
        p = w_num(state, p, cpu.get(state, i, cpu.C_APICID))
        p = w_nl(state, p)
        p = w_str(state, p, (&c3[0]) as u64)
        p = w_num(state, p, cpu.get(state, i, cpu.C_ONLINE))
        p = w_nl(state, p)
        p = w_str(state, p, (&c4[0]) as u64)
        p = w_num(state, p, cpu.get(state, i, cpu.C_SWITCHES))
        p = w_nl(state, p)
        p = w_str(state, p, (&c5[0]) as u64)
        p = w_num(state, p, cpu.get(state, i, cpu.C_TICKS))
        p = w_nl(state, p)
        p = w_nl(state, p)
        i = i + 1
    }
    return p
}

// W-SMP2: /proc/cpus -- one head line, one line per core. A photo of `cat /proc/cpus` answers "are the other cores there, and why not".
//   cpus_online=N cpus_madt=M failed=K kick=on|off kicks=T
//   cpuN apic=A online=0|1 why=ok|nomem|nosipi|noonline|nosmp|- esr=0xE ticks=T idle=I busy=P% switches=S picks=K cur_pid=P
//        cyc=C idlecyc=D halted=H kicktx=X kickrx=Y
// `busy` is TIME-weighted (TSC cycles between ticks, booked to the state at the tick); `ticks`/`idle` are raw tick counts (an idle
// application core ticks at 10 Hz, a busy one at 100 Hz, so tick counts of different cores are not comparable).
fn w_why(state: u64, at: u64, code: u64) -> u64 {
    var p: u64 = at
    var v: u64 = cpu.why_word(code)
    var i: u64 = 0
    while v != 0 && i < 8 {
        p = w_ch(state, p, v & 0xFF)
        v = v >> 8
        i = i + 1
    }
    return p
}

fn make_cpus(state: u64) -> u64 {
    var h1: [u8; 13] = "cpus_online=\0"
    var h2: [u8; 12] = " cpus_madt=\0"
    var h3: [u8; 9] = " failed=\0"
    var h4: [u8; 7] = " kick=\0"
    var h5: [u8; 8] = " kicks=\0"
    var on: [u8; 3] = "on\0"
    var off: [u8; 4] = "off\0"
    var l1: [u8; 4] = "cpu\0"
    var l2: [u8; 7] = " apic=\0"
    var l3: [u8; 9] = " online=\0"
    var l4: [u8; 6] = " why=\0"
    var l5: [u8; 8] = " esr=0x\0"
    var l6: [u8; 8] = " ticks=\0"
    var l7: [u8; 7] = " idle=\0"
    var l8: [u8; 7] = " busy=\0"
    var l9: [u8; 11] = " switches=\0"
    var l10: [u8; 8] = " picks=\0"
    var l11: [u8; 10] = " cur_pid=\0"
    var l12: [u8; 6] = " cyc=\0"
    var l13: [u8; 10] = " idlecyc=\0"
    var l14: [u8; 9] = " halted=\0"
    var l15: [u8; 9] = " kicktx=\0"
    var l16: [u8; 9] = " kickrx=\0"
    var pc: [u8; 3] = "%\0\0"
    var p: u64 = 0
    var n: u64 = cpu.count(state)
    if n > kstate.MAX_CPUS {
        n = kstate.MAX_CPUS
    }
    // A boot without the SMP probe has no per-core table (count 0): the boot core alone is still one online core.
    var bsp_only: bool = false
    if n == 0 {
        n = 1
        bsp_only = true
    }
    var madt: u64 = acpi.total(state)
    if madt == 0 {
        madt = n
    }
    var failed: u64 = 0
    var tx: u64 = 0
    var i: u64 = 0
    while i < n {
        if cpu.get(state, i, cpu.C_ONLINE) == 0 && !bsp_only {
            failed = failed + 1
        }
        tx = tx + cpu.x_get(state, i, cpu.X_KICKTX)
        i = i + 1
    }
    if madt > n {
        failed = failed + (madt - n)
    }
    p = w_str(state, p, (&h1[0]) as u64)
    var onl: u64 = cpu.online_count(state)
    if bsp_only {
        onl = 1
    }
    p = w_num(state, p, onl)
    p = w_str(state, p, (&h2[0]) as u64)
    p = w_num(state, p, madt)
    p = w_str(state, p, (&h3[0]) as u64)
    p = w_num(state, p, failed)
    p = w_str(state, p, (&h4[0]) as u64)
    if kstate.mode_on(state, kstate.M_NOKICK) {
        p = w_str(state, p, (&off[0]) as u64)
    } else {
        p = w_str(state, p, (&on[0]) as u64)
    }
    p = w_str(state, p, (&h5[0]) as u64)
    p = w_num(state, p, tx)
    p = w_nl(state, p)
    i = 0
    while i < n {
        let ticks: u64 = cpu.get(state, i, cpu.C_TICKS)
        let idle: u64 = cpu.get(state, i, cpu.C_IDLETICKS)
        let cyc: u64 = cpu.x_get(state, i, cpu.X_TOTCYC)
        let icyc: u64 = cpu.x_get(state, i, cpu.X_IDLECYC)
        var busy: u64 = 0
        if cyc > 0 {
            busy = (cyc - icyc) * 100 / cyc
        } else if ticks > 0 && idle <= ticks {
            busy = (ticks - idle) * 100 / ticks
        }
        var cur_pid: u64 = 0
        let ct: u64 = cpu.get(state, i, cpu.C_CUR)
        if ct < kstate.MAX_TASKS {
            cur_pid = sched.tget(state, ct, sched.T_PID)
        }
        p = w_str(state, p, (&l1[0]) as u64)
        p = w_num(state, p, i)
        p = w_str(state, p, (&l2[0]) as u64)
        p = w_num(state, p, cpu.get(state, i, cpu.C_APICID))
        p = w_str(state, p, (&l3[0]) as u64)
        var on_i: u64 = cpu.get(state, i, cpu.C_ONLINE)
        if bsp_only {
            on_i = 1
        }
        p = w_num(state, p, on_i)
        p = w_str(state, p, (&l4[0]) as u64)
        p = w_why(state, p, cpu.get(state, i, cpu.C_WHY))
        p = w_str(state, p, (&l5[0]) as u64)
        p = w_hexn(state, p, cpu.get(state, i, cpu.C_ESR), 8)
        p = w_str(state, p, (&l6[0]) as u64)
        p = w_num(state, p, ticks)
        p = w_str(state, p, (&l7[0]) as u64)
        p = w_num(state, p, idle)
        p = w_str(state, p, (&l8[0]) as u64)
        p = w_num(state, p, busy)
        p = w_str(state, p, (&pc[0]) as u64)
        p = w_str(state, p, (&l9[0]) as u64)
        p = w_num(state, p, cpu.get(state, i, cpu.C_SWITCHES))
        p = w_str(state, p, (&l10[0]) as u64)
        p = w_num(state, p, cpu.get(state, i, cpu.C_PICKS))
        p = w_str(state, p, (&l11[0]) as u64)
        p = w_num(state, p, cur_pid)
        p = w_str(state, p, (&l12[0]) as u64)
        p = w_num(state, p, cyc)
        p = w_str(state, p, (&l13[0]) as u64)
        p = w_num(state, p, icyc)
        p = w_str(state, p, (&l14[0]) as u64)
        p = w_num(state, p, cpu.x_get(state, i, cpu.X_HALTED))
        p = w_str(state, p, (&l15[0]) as u64)
        p = w_num(state, p, cpu.x_get(state, i, cpu.X_KICKTX))
        p = w_str(state, p, (&l16[0]) as u64)
        p = w_num(state, p, cpu.x_get(state, i, cpu.X_KICKRX))
        p = w_nl(state, p)
        i = i + 1
    }
    return p
}

fn make_uptime(state: u64) -> u64 {
    // Der Zeitgeber laeuft mit 100 Hz (`idt.fi`), ein Tick ist also eine
    // Hundertstelsekunde. Linux schreibt hier zwei Zahlen mit zwei
    // Nachkommastellen: Laufzeit und Leerlaufzeit.
    let ticks: u64 = kstate.get(state, kstate.TICKS)
    var p: u64 = 0
    p = w_num(state, p, ticks / 100)
    p = w_ch(state, p, 46)
    if (ticks % 100) < 10 {
        p = w_ch(state, p, 48)
    }
    p = w_num(state, p, ticks % 100)
    p = w_ch(state, p, 32)
    let idle: u64 = kstate.get(state, kstate.IDLE)
    var iticks: u64 = 0
    if idle < kstate.MAX_TASKS {
        iticks = sched.tget(state, idle, sched.T_TICKS)
    }
    p = w_num(state, p, iticks / 100)
    p = w_ch(state, p, 46)
    if (iticks % 100) < 10 {
        p = w_ch(state, p, 48)
    }
    p = w_num(state, p, iticks % 100)
    p = w_nl(state, p)
    return p
}

// DIE QUELLE EINER EINHAENGUNG. Ein Dateisystem ohne Platte hat keine
// Geraetedatei -- Linux schreibt dort den Namen des Treibers ("proc
// /proc proc rw"), und dieser Kernel schreibt ihn auch. Ein
// "/dev/ram0" davorzusetzen waere eine Erfindung: /proc liegt auf gar
// keinem Geraet.
fn source_text(state: u64, at: u64, m: u64) -> u64 {
    var t_proc: [u8; 6] = "proc \0"
    var t_dev: [u8; 7] = "devfs \0"
    let t: u64 = mnt.fstype(state, m)
    if t == vfsops.FS_PROC {
        return w_str(state, at, (&t_proc[0]) as u64)
    }
    if t == vfsops.FS_DEV {
        return w_str(state, at, (&t_dev[0]) as u64)
    }
    return dev_text(state, at, mnt.dev(state, m))
}

fn dev_text(state: u64, at: u64, dev: u64) -> u64 {
    var d_ram: [u8; 10] = "/dev/ram0\0"
    var d_ata: [u8; 9] = "/dev/hda\0"
    var d_atb: [u8; 9] = "/dev/hdb\0"
    var d_nvme: [u8; 11] = "/dev/nvme0\0"
    var d_none: [u8; 5] = "none\0"
    if dev == blk.DEV_RAM {
        return w_str(state, at, (&d_ram[0]) as u64)
    }
    if dev == blk.DEV_ATA {
        return w_str(state, at, (&d_ata[0]) as u64)
    }
    if dev == blk.DEV_ATA1 {
        return w_str(state, at, (&d_atb[0]) as u64)
    }
    if dev == blk.DEV_NVME {
        return w_str(state, at, (&d_nvme[0]) as u64)
    }
    return w_str(state, at, (&d_none[0]) as u64)
}

fn type_text(state: u64, at: u64, t: u64) -> u64 {
    var t_ofs: [u8; 4] = "ofs\0"
    var t_proc: [u8; 6] = "proc \0"
    var t_dev: [u8; 7] = "devfs \0"
    var t_fat: [u8; 6] = "vfat\0\0"
    var t_none: [u8; 5] = "none\0"
    if t == vfsops.FS_OFS {
        return w_str(state, at, (&t_ofs[0]) as u64)
    }
    if t == vfsops.FS_PROC {
        return w_str(state, at, (&t_proc[0]) as u64)
    }
    if t == vfsops.FS_DEV {
        return w_str(state, at, (&t_dev[0]) as u64)
    }
    if t == vfsops.FS_FAT {
        return w_str(state, at, (&t_fat[0]) as u64)
    }
    return w_str(state, at, (&t_none[0]) as u64)
}

// Die Form von Linux' /proc/mounts, Feld fuer Feld:
//     <Quelle> <Ort> <Art> <Schalter> 0 0
fn make_mounts(state: u64) -> u64 {
    var rw: [u8; 3] = "rw\0"
    var ro: [u8; 3] = "ro\0"
    var tail: [u8; 5] = " 0 0\0"
    var p: u64 = 0
    var m: u64 = 0
    while m < mnt.MAX_MNT {
        if mnt.used(state, m) {
            p = source_text(state, p, m)
            p = w_ch(state, p, 32)
            p = w_str(state, p, mnt.path_at(state, m))
            p = w_ch(state, p, 32)
            p = type_text(state, p, mnt.fstype(state, m))
            p = w_ch(state, p, 32)
            if (mnt.flags(state, m) & mnt.F_RDONLY) != 0 {
                p = w_str(state, p, (&ro[0]) as u64)
            } else {
                p = w_str(state, p, (&rw[0]) as u64)
            }
            p = w_str(state, p, (&tail[0]) as u64)
            p = w_nl(state, p)
        }
        m = m + 1
    }
    return p
}

fn make_stat(state: u64) -> u64 {
    var s1: [u8; 12] = "ticks     \0\0"
    var s2: [u8; 12] = "ctxt      \0\0"
    var s3: [u8; 12] = "syscalls  \0\0"
    var s4: [u8; 12] = "processes \0\0"
    var s5: [u8; 12] = "forks     \0\0"
    var s6: [u8; 12] = "execs     \0\0"
    var s7: [u8; 12] = "traps     \0\0"
    var s8: [u8; 12] = "opens     \0\0"
    var sc: [u8; 6] = "cpu  \0"
    var scc: [u8; 4] = "cpu\0"
    var sc0: [u8; 6] = " 0 0 \0"
    var sc1: [u8; 13] = " 0 0 0 0 0 0\0"
    var p: u64 = 0
    let total: u64 = kstate.get(state, kstate.TICKS)
    let idle_slot: u64 = kstate.get(state, kstate.IDLE)
    var idle_ticks: u64 = 0
    if idle_slot < kstate.MAX_TASKS {
        idle_ticks = sched.tget(state, idle_slot, sched.T_TICKS)
    }
    if idle_ticks > total {
        idle_ticks = total
    }
    p = w_str(state, p, (&sc[0]) as u64)
    p = w_num(state, p, total - idle_ticks)
    p = w_ch(state, p, 32)
    p = w_ch(state, p, 48)
    p = w_ch(state, p, 32)
    p = w_ch(state, p, 48)
    p = w_ch(state, p, 32)
    p = w_num(state, p, idle_ticks)
    var z: u64 = 0
    while z < 6 {
        p = w_ch(state, p, 32)
        p = w_ch(state, p, 48)
        z = z + 1
    }
    p = w_nl(state, p)
    // W-SMP2: one line per core, Linux layout (user nice system idle ...); busy = ticks - idle ticks of THAT core.
    var sn: u64 = cpu.count(state)
    if sn > kstate.MAX_CPUS {
        sn = kstate.MAX_CPUS
    }
    var sci: u64 = 0
    while sn > 1 && sci < sn {
        let ct: u64 = cpu.get(state, sci, cpu.C_TICKS)
        var ci: u64 = cpu.get(state, sci, cpu.C_IDLETICKS)
        if ci > ct {
            ci = ct
        }
        p = w_str(state, p, (&scc[0]) as u64)
        p = w_num(state, p, sci)
        p = w_ch(state, p, 32)
        p = w_num(state, p, ct - ci)
        p = w_str(state, p, (&sc0[0]) as u64)
        p = w_num(state, p, ci)
        p = w_str(state, p, (&sc1[0]) as u64)
        p = w_nl(state, p)
        sci = sci + 1
    }
    p = w_str(state, p, (&s1[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.TICKS))
    p = w_nl(state, p)
    p = w_str(state, p, (&s2[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.SWITCHES))
    p = w_nl(state, p)
    p = w_str(state, p, (&s3[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.SYSCALLS))
    p = w_nl(state, p)
    p = w_str(state, p, (&s4[0]) as u64)
    p = w_num(state, p, sched.alive_count(state))
    p = w_nl(state, p)
    p = w_str(state, p, (&s5[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.FORKS))
    p = w_nl(state, p)
    p = w_str(state, p, (&s6[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.EXECS))
    p = w_nl(state, p)
    p = w_str(state, p, (&s7[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.TRAPS))
    p = w_nl(state, p)
    p = w_str(state, p, (&s8[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.OPENS))
    p = w_nl(state, p)
    return p
}

// Copies `n` bytes of a text but drops everything up to and including the first
// blank ("osum 1a2b3c4d" -> "1a2b3c4d"); without a blank the whole text is copied.
fn w_tail(state: u64, at: u64, s: u64, n: u64) -> u64 {
    var p: u64 = at
    var i: u64 = 0
    while i < n && kstate.get8(s + i) != 32 {
        i = i + 1
    }
    if i < n {
        i = i + 1
    } else {
        i = 0
    }
    while i < n {
        p = w_ch(state, p, kstate.get8(s + i))
        i = i + 1
    }
    return p
}

fn make_version(state: u64) -> u64 {
    // Format: "<product> (Firn) version <N> build <hash> image <id>\n". `uname` takes
    // the text up to the number; the build hash comes from git at build time
    // (lib/version.fi, "+" suffix = uncommitted changes), the image id from the
    // IMAGE_ID build variable ("dev" when unset).
    var v: [u8; 64] = [0 as u8; 64]
    var vr: [u8; 22] = " (Firn) version \0\0\0\0\0\0"
    var l_build: [u8; 8] = " build \0"
    var l_image: [u8; 8] = " image \0"
    var vn: u64 = brand.anhaengen((&v[0]) as u64, 0, brand.produkt(), 63)
    vn = brand.anhaengen((&v[0]) as u64, vn, (&vr[0]) as u64, 63)
    kstate.set8((&v[0]) as u64 + vn, 0)
    var p: u64 = 0
    p = w_str(state, p, (&v[0]) as u64)
    p = w_num(state, p, uio.sysinfo(state, uio.I_VERSION))
    p = w_str(state, p, (&l_build[0]) as u64)
    p = w_tail(state, p, brand.version_text(), brand.version_n())
    p = w_str(state, p, (&l_image[0]) as u64)
    p = w_str(state, p, brand.image_text())
    p = w_nl(state, p)
    return p
}

// ---------------------------------------------- RUNDE TRESOR: /proc/hwid
//
// Zeilen der Form `schluessel: wert`, weil das Format von /proc/meminfo
// dasselbe ist und ein Werkzeug, das eines lesen kann, dann beide kann.
//
// EIN LEERER WERT IST EINE AUSSAGE, keine Luecke: er heisst "diese
// Maschine gibt das nicht her". Genau deshalb steht auch `..._valid`
// daneben -- sechzehn Nulloktette sind eine UUID, die keine ist, und ein
// Fingerabdruck, der sie mitrechnet, waere auf jeder Standard-VM dieser
// Welt derselbe.

fn w_field(state: u64, at: u64, label: u64, which: u64) -> u64 {
    var p: u64 = at
    p = w_str(state, p, label)
    let src: u64 = hwid.field(state, which)
    let n: u64 = hwid.field_len(state, which)
    var i: u64 = 0
    while i < n {
        p = w_ch(state, p, kstate.get8(src + i))
        i = i + 1
    }
    return w_nl(state, p)
}

fn w_hexb(state: u64, at: u64, v: u64) -> u64 {
    var p: u64 = at
    let hi: u64 = (v >> 4) & 15
    let lo: u64 = v & 15
    if hi < 10 {
        p = w_ch(state, p, hi + 48)
    } else {
        p = w_ch(state, p, hi + 87)
    }
    if lo < 10 {
        p = w_ch(state, p, lo + 48)
    } else {
        p = w_ch(state, p, lo + 87)
    }
    return p
}

// Die UUID in der gewohnten Schreibweise 8-4-4-4-12. Die ersten drei
// Gruppen stehen im Speicher KLEINENDIG (SMBIOS 2.6 und spaeter), die
// letzten beiden so, wie sie geschrieben werden -- wer alle sechzehn
// Oktette der Reihe nach ausgibt, bekommt eine andere UUID als jedes
// andere Werkzeug auf derselben Maschine.
fn w_uuid(state: u64, at: u64) -> u64 {
    let src: u64 = hwid.field(state, hwid.F_UUID)
    var p: u64 = at
    var order: [u8; 16] = [3 as u8, 2 as u8, 1 as u8, 0 as u8,
        5 as u8, 4 as u8, 7 as u8, 6 as u8,
        8 as u8, 9 as u8, 10 as u8, 11 as u8,
        12 as u8, 13 as u8, 14 as u8, 15 as u8]
    var i: u64 = 0
    while i < 16 {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            p = w_ch(state, p, 45)
        }
        p = w_hexb(state, p, kstate.get8(src + kstate.get8((&order[0]) as u64 + i)))
        i = i + 1
    }
    return p
}

fn make_hwid(state: u64) -> u64 {
    var l_sm: [u8; 22] = "system_manufacturer: \0"
    var l_sp: [u8; 17] = "system_product: \0"
    var l_sv: [u8; 17] = "system_version: \0"
    var l_ss: [u8; 16] = "system_serial: \0"
    var l_bm: [u8; 21] = "board_manufacturer: \0"
    var l_bp: [u8; 16] = "board_product: \0"
    var l_bs: [u8; 15] = "board_serial: \0"
    var l_uu: [u8; 7] = "uuid: \0"
    var l_uv: [u8; 13] = "uuid_valid: \0"
    var l_ns: [u8; 14] = "nvme_serial: \0"
    var l_nm: [u8; 13] = "nvme_model: \0"
    var l_am: [u8; 13] = "ahci_model: \0"
    var l_nv: [u8; 13] = "nvme_valid: \0"
    var l_ma: [u8; 6] = "mac: \0"
    var l_mv: [u8; 12] = "mac_valid: \0"
    var l_sb: [u8; 10] = "smbios: \0\0"
    var l_sc: [u8; 20] = "smbios_structures: \0"
    var l_ok: [u8; 12] = "smbios_ok: \0"
    var dot: [u8; 2] = ".\0"

    // Die spaeten Quellen nachholen. `hwid.refresh` weiss selbst, dass es
    // hoechstens achtmal fragt -- eine Maschine ohne Laufwerk soll nicht
    // bei jedem `cat` einen Admin-Befehl bezahlen.
    hwid.refresh(state)

    var p: u64 = 0
    p = w_field(state, p, (&l_sm[0]) as u64, hwid.F_SYS_MANUF)
    p = w_field(state, p, (&l_sp[0]) as u64, hwid.F_SYS_PRODUCT)
    p = w_field(state, p, (&l_sv[0]) as u64, hwid.F_SYS_VERSION)
    p = w_field(state, p, (&l_ss[0]) as u64, hwid.F_SYS_SERIAL)
    p = w_field(state, p, (&l_bm[0]) as u64, hwid.F_BOARD_MANUF)
    p = w_field(state, p, (&l_bp[0]) as u64, hwid.F_BOARD_PRODUCT)
    p = w_field(state, p, (&l_bs[0]) as u64, hwid.F_BOARD_SERIAL)
    p = w_str(state, p, (&l_uu[0]) as u64)
    p = w_uuid(state, p)
    p = w_nl(state, p)
    p = w_str(state, p, (&l_uv[0]) as u64)
    if hwid.have_uuid(state) {
        p = w_num(state, p, 1)
    } else {
        p = w_num(state, p, 0)
    }
    p = w_nl(state, p)
    p = w_field(state, p, (&l_ns[0]) as u64, hwid.F_NVME_SERIAL)
    p = w_field(state, p, (&l_nm[0]) as u64, hwid.F_NVME_MODEL)
    p = w_field(state, p, (&l_am[0]) as u64, hwid.F_AHCI_MODEL)
    p = w_str(state, p, (&l_nv[0]) as u64)
    if hwid.have_nvme(state) {
        p = w_num(state, p, 1)
    } else {
        p = w_num(state, p, 0)
    }
    p = w_nl(state, p)
    // Die MAC-Adresse in der gewohnten Schreibweise mit Doppelpunkten.
    p = w_str(state, p, (&l_ma[0]) as u64)
    let m: u64 = hwid.field(state, hwid.F_MAC)
    var i: u64 = 0
    while i < 6 {
        if i > 0 {
            p = w_ch(state, p, 58)
        }
        p = w_hexb(state, p, kstate.get8(m + i))
        i = i + 1
    }
    p = w_nl(state, p)
    p = w_str(state, p, (&l_mv[0]) as u64)
    if hwid.have_mac(state) {
        p = w_num(state, p, 1)
    } else {
        p = w_num(state, p, 0)
    }
    p = w_nl(state, p)
    p = w_str(state, p, (&l_sb[0]) as u64)
    p = w_num(state, p, hwid.version_major(state))
    p = w_str(state, p, (&dot[0]) as u64)
    p = w_num(state, p, hwid.version_minor(state))
    p = w_nl(state, p)
    p = w_str(state, p, (&l_sc[0]) as u64)
    p = w_num(state, p, hwid.structures(state))
    p = w_nl(state, p)
    p = w_str(state, p, (&l_ok[0]) as u64)
    if hwid.ok(state) {
        p = w_num(state, p, 1)
    } else {
        p = w_num(state, p, 0)
    }
    p = w_nl(state, p)
    return p
}

// ------------------------------------------------- die Dateien je Prozess

// RUNDE PROTOKOLL: die letzten Zeilen des Rings in den Seitenpuffer.
//
// RUECKWAERTS GEZAEHLT, VORWAERTS GESCHRIEBEN. Erst wird von der
// juengsten Zeile aus rueckwaerts gegangen, bis der Platz aufgebraucht
// ist -- so bleiben die NEUESTEN Zeilen stehen und nicht die aeltesten.
// Dann wird von dort vorwaerts geschrieben.
fn make_klog(state: u64) -> u64 {
    var s_kopf: [u8; 8] = "# klog \0"
    var s_von: [u8; 6] = " von \0"
    var s_z: [u8; 9] = " Zeilen\0\0"
    var s_l: [u8; 9] = ", Ring \0\0"
    let last: u64 = klog.seq(state)
    let first: u64 = klog.first_seq(state)
    let raum: u64 = kstate.PROCFS_MAX - 256
    // WIE VIELE ZEILEN SICHER PASSEN. Eine Zeile ist hoechstens so
    // lang wie ihr Eintrag: 88 Oktette Text, 8 Quelle und der Kopf mit
    // Zeit, Kern, pid und Stufe -- zusammen unter 144. Also
    // raum/144 Zeilen, ohne dass etwas gemessen werden muss. Passt
    // hinterher mehr, bleibt Platz ungenutzt; das ist der Preis dafuer,
    // dass diese Rechnung keine zweite Schleife braucht.
    var passt: u64 = raum / 144
    if passt == 0 {
        passt = 1
    }
    var von: u64 = first
    if last > passt && last - passt + 1 > first {
        von = last - passt + 1
    }
    var p: u64 = 0
    p = w_str(state, p, (&s_kopf[0]) as u64)
    p = w_num(state, p, last)
    p = w_str(state, p, (&s_z[0]) as u64)
    p = w_str(state, p, (&s_l[0]) as u64)
    p = w_num(state, p, klog.N_ENT)
    p = w_str(state, p, (&s_von[0]) as u64)
    p = w_num(state, p, von)
    p = w_ch(state, p, 10)
    var sq: u64 = von
    while sq <= last {
        if p + 160 >= raum {
            return p
        }
        p = p + klog.line_at(state, sq, buf(state) + p, raum - p)
        sq = sq + 1
    }
    return p
}

fn make_status(state: u64, t: u64) -> u64 {
    var l1: [u8; 10] = "Name:   \0\0"
    var l2: [u8; 10] = "Pid:    \0\0"
    var l3: [u8; 10] = "PPid:   \0\0"
    var l4: [u8; 10] = "State:  \0\0"
    var l5: [u8; 10] = "Prio:   \0\0"
    var l6: [u8; 10] = "Ticks:  \0\0"
    var l7: [u8; 10] = "Runs:   \0\0"
    var l8: [u8; 10] = "Faults: \0\0"
    var l9: [u8; 10] = "Brk:    \0\0"
    var l10: [u8; 10] = "Cwd:    \0\0"
    var name: [u8; 12] = [0 as u8; 12]
    var cm: [u8; 17] = [0 as u8; 17]
    var p: u64 = 0
    kind_name(sched.tget(state, t, sched.T_KIND), (&name[0]) as u64)
    // RUNDE LC1: the real process name (exec / prctl) when there is one
    let ca: u64 = sched.tget(state, t, sched.T_COMMA)
    let cb: u64 = sched.tget(state, t, sched.T_COMMB)
    var ci: u64 = 0
    while ci < 8 {
        kstate.set8(((&cm[0]) as u64) + ci, ((ca >> (ci * 8)) & 255) as u8)
        ci = ci + 1
    }
    ci = 0
    while ci < 7 {
        kstate.set8(((&cm[0]) as u64) + 8 + ci, ((cb >> (ci * 8)) & 255) as u8)
        ci = ci + 1
    }
    p = w_str(state, p, (&l1[0]) as u64)
    if ca != 0 {
        p = w_str(state, p, (&cm[0]) as u64)
    } else {
        p = w_str(state, p, (&name[0]) as u64)
    }
    p = w_nl(state, p)
    p = w_str(state, p, (&l2[0]) as u64)
    p = w_num(state, p, sched.tget(state, t, sched.T_PID))
    p = w_nl(state, p)
    p = w_str(state, p, (&l3[0]) as u64)
    let par: u64 = sched.tget(state, t, sched.T_PARENT)
    var ppid: u64 = 0
    if par < kstate.MAX_TASKS {
        ppid = sched.tget(state, par, sched.T_PID)
    }
    p = w_num(state, p, ppid)
    p = w_nl(state, p)
    p = w_str(state, p, (&l4[0]) as u64)
    p = w_ch(state, p, state_letter(sched.tget(state, t, sched.T_STATE)))
    p = w_nl(state, p)
    p = w_str(state, p, (&l5[0]) as u64)
    p = w_num(state, p, sched.tget(state, t, sched.T_PRIO))
    p = w_nl(state, p)
    p = w_str(state, p, (&l6[0]) as u64)
    p = w_num(state, p, sched.tget(state, t, sched.T_TICKS))
    p = w_nl(state, p)
    p = w_str(state, p, (&l7[0]) as u64)
    p = w_num(state, p, sched.tget(state, t, sched.T_RUNS))
    p = w_nl(state, p)
    p = w_str(state, p, (&l8[0]) as u64)
    p = w_num(state, p, sched.tget(state, t, sched.T_FAULTS))
    p = w_nl(state, p)
    p = w_str(state, p, (&l9[0]) as u64)
    p = w_hex16(state, p, sched.tget(state, t, sched.T_BRK))
    p = w_nl(state, p)
    p = w_str(state, p, (&l10[0]) as u64)
    var k: u64 = 0
    let n: u64 = uio.cwd_len(state, t)
    while k < n {
        p = w_ch(state, p, uio.cwd_at(state, t, k))
        k = k + 1
    }
    p = w_nl(state, p)
    // RUNDE UNTERBAU: the lines a program that reads /proc/self/status looks for (Linux names, kB): Threads (the tasks of this group),
    // VmRSS / VmSize (the pages this process holds, 4 kB each -- the kernel counts present pages, not a separate virtual size).
    var l12: [u8; 10] = "Threads:\0\0"
    var l13: [u8; 10] = "VmRSS:  \0\0"
    var l14: [u8; 10] = "VmSize: \0\0"
    var l15: [u8; 5] = " kB\0\0"
    var grp: u64 = sched.tget(state, t, sched.T_TGID)
    if grp == 0 {
        grp = sched.tget(state, t, sched.T_PID)
    }
    var nth: u64 = 0
    var ti: u64 = 0
    while ti < kstate.MAX_TASKS {
        if sched.tget(state, ti, sched.T_STATE) != sched.S_FREE && sched.tget(state, ti, sched.T_STATE) != sched.S_ZOMBIE {
            var tg: u64 = sched.tget(state, ti, sched.T_TGID)
            if tg == 0 {
                tg = sched.tget(state, ti, sched.T_PID)
            }
            if tg == grp {
                nth = nth + 1
            }
        }
        ti = ti + 1
    }
    p = w_str(state, p, (&l12[0]) as u64)
    p = w_num(state, p, nth)
    p = w_nl(state, p)
    p = w_str(state, p, (&l13[0]) as u64)
    p = w_num(state, p, sched.tget(state, t, sched.T_UPAGES) * 4)
    p = w_str(state, p, (&l15[0]) as u64)
    p = w_nl(state, p)
    p = w_str(state, p, (&l14[0]) as u64)
    p = w_num(state, p, sched.tget(state, t, sched.T_UPAGES) * 4)
    p = w_str(state, p, (&l15[0]) as u64)
    p = w_nl(state, p)
    // AB-003: where it comes from, as the kernel attests it
    // (kernel/sched/origin.fi). "-" = no label: the system / the user.
    var l11: [u8; 10] = "Origin: \0\0"
    p = w_str(state, p, (&l11[0]) as u64)
    if origin.is_empty(state, t) {
        p = w_ch(state, p, 45)
    } else {
        var j: u64 = 0
        while j < origin.LEN && origin.byte_at(state, t, j) != 0 {
            p = w_ch(state, p, origin.byte_at(state, t, j))
            j = j + 1
        }
    }
    p = w_nl(state, p)
    return p
}

// r823: ` <number>` -- one more field of the stat line.
fn st_num(state: u64, at: u64, v: u64) -> u64 {
    let p: u64 = w_ch(state, at, 32)
    return w_num(state, p, v)
}

// `/proc/<pid>/stat` in the Linux layout: 52 fields (proc(5)). busybox `ps`, procps and htop skip a fixed number of fields to find
// utime/start_time/vsize; with the old 10-field line the skip ran past the end of the buffer (busybox ps: SIGSEGV).
// Fields 1-4 are what `tools/k14` compares with SYS_OSUM_PSTAT (pid, (name), state, ppid). The kernel has no per-process
// time split, no tty and no signal masks: those fields are 0, which is a valid value for each of them.
fn make_pstat(state: u64, t: u64) -> u64 {
    var name: [u8; 12] = [0 as u8; 12]
    var cm: [u8; 17] = [0 as u8; 17]
    var p: u64 = 0
    kind_name(sched.tget(state, t, sched.T_KIND), (&name[0]) as u64)
    let ca: u64 = sched.tget(state, t, sched.T_COMMA)
    let cb: u64 = sched.tget(state, t, sched.T_COMMB)
    var ci: u64 = 0
    while ci < 8 {
        kstate.set8(((&cm[0]) as u64) + ci, ((ca >> (ci * 8)) & 255) as u8)
        ci = ci + 1
    }
    ci = 0
    while ci < 7 {
        kstate.set8(((&cm[0]) as u64) + 8 + ci, ((cb >> (ci * 8)) & 255) as u8)
        ci = ci + 1
    }
    p = w_num(state, p, sched.tget(state, t, sched.T_PID))
    p = w_ch(state, p, 32)
    p = w_ch(state, p, 40) // '('
    if ca != 0 {
        p = w_str(state, p, (&cm[0]) as u64)
    } else {
        p = w_str(state, p, (&name[0]) as u64)
    }
    p = w_ch(state, p, 41) // ')'
    p = w_ch(state, p, 32)
    p = w_ch(state, p, state_letter(sched.tget(state, t, sched.T_STATE)))
    let par: u64 = sched.tget(state, t, sched.T_PARENT)
    var ppid: u64 = 0
    if par < kstate.MAX_TASKS {
        ppid = sched.tget(state, par, sched.T_PID)
    }
    p = st_num(state, p, ppid) // 4
    p = st_num(state, p, sched.tget(state, t, sched.T_PGID)) // 5 pgrp
    p = st_num(state, p, sched.tget(state, t, sched.T_SID)) // 6 session
    p = st_num(state, p, 0) // 7 tty_nr
    p = st_num(state, p, 0) // 8 tpgid
    p = st_num(state, p, 0) // 9 flags
    p = st_num(state, p, sched.tget(state, t, sched.T_FAULTS)) // 10 minflt
    p = st_num(state, p, 0) // 11 cminflt
    p = st_num(state, p, 0) // 12 majflt
    p = st_num(state, p, 0) // 13 cmajflt
    p = st_num(state, p, sched.tget(state, t, sched.T_TICKS)) // 14 utime
    p = st_num(state, p, 0) // 15 stime
    p = st_num(state, p, 0) // 16 cutime
    p = st_num(state, p, 0) // 17 cstime
    p = st_num(state, p, sched.tget(state, t, sched.T_PRIO)) // 18 priority
    p = st_num(state, p, 0) // 19 nice
    p = st_num(state, p, 1) // 20 num_threads
    p = st_num(state, p, 0) // 21 itrealvalue
    p = st_num(state, p, 0) // 22 starttime
    p = st_num(state, p, sched.tget(state, t, sched.T_UPAGES) * 4096) // 23 vsize
    p = st_num(state, p, sched.tget(state, t, sched.T_UPAGES)) // 24 rss
    p = st_num(state, p, 0 -% 1) // 25 rsslim
    var f: u64 = 26
    while f <= 52 {
        if f == 38 {
            p = st_num(state, p, 17) // exit_signal = SIGCHLD
        } else {
            p = st_num(state, p, 0)
        }
        f = f + 1
    }
    p = w_nl(state, p)
    return p
}

// DIE ARGUMENTE, AUS DEM ADRESSRAUM DES PROZESSES. `elf.write_args`
// legt sie auf die oberste Stapelseite (`proc.ARGS_BASE`): erst `argc`,
// dann `argc` Zeiger, dann die Zeichenketten. Hier wird genau dort
// gelesen -- ueber `proc.translate`, also durch die Seitentabelle des
// FREMDEN Prozesses hindurch, und nicht aus einer Kopie, die der Kernel
// sich gemerkt haette. Eine Kopie waere veraltet, sobald `execve` lief.
fn make_cmdline(state: u64, t: u64) -> u64 {
    var p: u64 = 0
    let frame: u64 = proc.translate(state, t, proc.ARGS_BASE)
    if frame == 0 {
        return 0
    }
    let argc: u64 = __mmio_read64(frame as *mut u64)
    if argc == 0 || argc > proc.MAX_ARGS {
        return 0
    }
    var k: u64 = 0
    while k < argc {
        let ptr: u64 = __mmio_read64((frame + 8 + k * 8) as *mut u64)
        if ptr < proc.ARGS_BASE || ptr >= proc.ARGS_BASE + 4096 {
            k = argc
        } else {
            var at: u64 = frame + (ptr - proc.ARGS_BASE)
            var going: bool = true
            while going {
                let c: u64 = kstate.get8(at)
                if c == 0 {
                    going = false
                } else {
                    p = w_ch(state, p, c)
                    at = at + 1
                }
            }
            // Wie bei Linux: die Argumente sind durch NULLEN getrennt
            // und nicht durch Leerzeichen. Wer das anders schreibt,
            // kann ein Argument mit Leerzeichen nicht mehr wiedergeben.
            p = w_ch(state, p, 0)
            k = k + 1
        }
    }
    return p
}

// DIE SEITENTABELLE, ABGELAUFEN. Keine Konstantenliste: was hier steht,
// steht da, weil `proc.translate` fuer diese Adresse einen Rahmen
// gefunden hat.
fn make_maps(state: u64, t: u64) -> u64 {
    // RUNDE UNTERBAU: THE WHOLE PRIVATE REGION, WITH THE RIGHTS AS THEY ARE. The first version stopped at the first 2 MiB tile (the
    // image of a program, the stack, the first heap) and knew two right sets, "rw-" and "r-x"; a library mapped by dlopen, the mmap
    // windows and the big region were not listed at all, and a PROT_NONE guard page looked like data. Now every run of pages with
    // the same rights is one line `start-end rwxp 00000000 00:00 0` (the shape Linux prints, so a parser reads it), a run that is
    // mapped but closed to the user shows `---p`. The kernel keeps no list of mappings (no VMA), so a run has NO file name; the
    // main stack and the heap get the names Linux uses.
    var p: u64 = 0
    let low: u64 = proc.USER_DATA
    let high: u64 = proc.LAZY_ATOP
    var addr: u64 = low
    var run_start: u64 = 0
    var run_r: u64 = 0
    var in_run: bool = false
    while addr < high {
        var r: u64 = 0
        let k: u64 = proc.pd_slot(addr)
        // a 2 MiB tile that has no table is skipped whole (most of the region is empty)
        if k != 0 && proc.pt_for(state, t, addr, false) == 0 {
            if in_run {
                p = map_line(state, t, p, run_start, addr, run_r)
                in_run = false
            }
            addr = (addr & 0xFFFFFFFFFFE00000) + 0x200000
        } else {
            r = proc.page_rights(state, t, addr)
            if r != 0 && !in_run {
                in_run = true
                run_start = addr
                run_r = r
            } else if in_run {
                if r != run_r {
                    p = map_line(state, t, p, run_start, addr, run_r)
                    in_run = r != 0
                    run_start = addr
                    run_r = r
                }
            }
            addr = addr + 4096
        }
        if p > BUF_MAX - 300 {
            return p
        }
    }
    if in_run {
        p = map_line(state, t, p, run_start, high, run_r)
    }
    return p
}

// one line of /proc/<pid>/maps
fn map_line(state: u64, t: u64, at: u64, a: u64, b: u64, r: u64) -> u64 {
    var p: u64 = at
    p = w_hex16(state, p, a)
    p = w_ch(state, p, 45)
    p = w_hex16(state, p, b)
    p = w_ch(state, p, 32)
    if (r & 2) != 0 {
        p = w_ch(state, p, 114)
    } else {
        p = w_ch(state, p, 45)
    }
    if (r & 4) != 0 {
        p = w_ch(state, p, 119)
    } else {
        p = w_ch(state, p, 45)
    }
    if (r & 8) != 0 {
        p = w_ch(state, p, 120)
    } else {
        p = w_ch(state, p, 45)
    }
    p = w_ch(state, p, 112)
    var tail: [u8; 26] = " 00000000 00:00 0      \0\0\0"
    p = w_str(state, p, (&tail[0]) as u64)
    if a <= proc.USER_TOP - 4096 && b >= proc.USER_TOP {
        var nm: [u8; 8] = "[stack]\0"
        p = w_str(state, p, (&nm[0]) as u64)
    } else if a == 0x40080000 {
        var nh: [u8; 8] = "[heap]\0\0"
        p = w_str(state, p, (&nh[0]) as u64)
    } else if a >= MAPS_INTERP && a < proc.IMAGE_END {
        p = w_interp_name(state, t, p)
    } else if a >= proc.IMAGE_BASE && a < MAPS_INTERP {
        p = w_exe_name(state, t, p)
    }
    p = w_nl(state, p)
    return p
}

const MAPS_INTERP: u64 = 0x40A00000

fn w_exe_name(state: u64, t: u64, at: u64) -> u64 {
    var p: u64 = at
    let n: u64 = uio.exe_len(state, t)
    var i: u64 = 0
    while i < n {
        p = w_ch(state, p, uio.exe_at(state, t, i))
        i = i + 1
    }
    return p
}

fn w_interp_name(state: u64, t: u64, at: u64) -> u64 {
    var p: u64 = at
    let n: u64 = uio.interp_len(state, t)
    var i: u64 = 0
    while i < n {
        p = w_ch(state, p, uio.interp_at(state, t, i))
        i = i + 1
    }
    return p
}

// LC-PROC: the targets of the symlinks /proc/<pid>/exe and /proc/<pid>/cwd (the text is the link target, no newline)
fn make_exe(state: u64, t: u64) -> u64 {
    let n: u64 = uio.exe_len(state, t)
    var i: u64 = 0
    while i < n && i < BUF_MAX {
        w_ch(state, i, uio.exe_at(state, t, i))
        i = i + 1
    }
    return i
}

fn make_cwd(state: u64, t: u64) -> u64 {
    let n: u64 = uio.cwd_len(state, t)
    var i: u64 = 0
    while i < n && i < BUF_MAX {
        w_ch(state, i, uio.cwd_at(state, t, i))
        i = i + 1
    }
    return i
}

fn make_fdfile(state: u64, t: u64, fd: u64) -> u64 {
    var k_file: [u8; 6] = "file \0"
    var k_dir: [u8; 5] = "dir \0"
    var k_pipe: [u8; 6] = "pipe\0\0"
    var k_tty: [u8; 5] = "tty \0"
    var k_con: [u8; 8] = "console\0"
    var k_sock: [u8; 8] = "socket\0\0"
    var k_fb: [u8; 4] = "fb\0\0"
    var k_vfs: [u8; 5] = "vfs \0"
    var p: u64 = 0
    // `file.fd_of` gibt den PLATZ IN DER TAFEL DER OFFENEN DATEIEN
    // zurueck -- und `MAX_OPEN`, wenn der Deskriptor geschlossen ist.
    // NICHT null: null ist ein gueltiger Platz, naemlich die Konsole
    // auf Deskriptor 0. Die erste Fassung dieser Datei hat `!= 0`
    // geprueft und damit genau das Gegenteil aufgezaehlt: Deskriptor 0
    // fehlte in der Liste, und jeder GESCHLOSSENE stand darin.
    let e: u64 = file.fd_of(state, t, fd)
    if e >= file.MAX_OPEN {
        return 0
    }
    let kind: u64 = file.open_kind(state, e)
    if kind == file.K_FILE {
        p = w_str(state, p, (&k_file[0]) as u64)
        p = w_num(state, p, file.open_ino(state, e))
    } else if kind == file.K_DIR {
        p = w_str(state, p, (&k_dir[0]) as u64)
        p = w_num(state, p, file.open_ino(state, e))
    } else if kind == file.K_PIPER || kind == file.K_PIPEW {
        p = w_str(state, p, (&k_pipe[0]) as u64)
    } else if kind == file.K_TTY {
        p = w_str(state, p, (&k_tty[0]) as u64)
        p = w_num(state, p, file.open_ino(state, e))
    } else if kind == file.K_CONIN || kind == file.K_CONOUT {
        p = w_str(state, p, (&k_con[0]) as u64)
    } else if kind == file.K_SOCK {
        p = w_str(state, p, (&k_sock[0]) as u64)
    } else if kind == file.K_FB {
        p = w_str(state, p, (&k_fb[0]) as u64)
    } else {
        p = w_str(state, p, (&k_vfs[0]) as u64)
        p = w_num(state, p, file.open_ino(state, e))
    }
    p = w_nl(state, p)
    return p
}

// EINE Weiche fuer alle Dateien dieses Dateisystems. Sie ist die
// einzige Stelle, an der ein Knoten zu Text wird.

// ===================================================== ROUND UNTERBAU
//
// /proc/loadavg, /proc/<pid>/limits, /proc/<pid>/cgroup and /proc/sys/...:
// the files a big Linux program reads at startup. Values are the truth this
// kernel knows: no load average is computed (0.00), the descriptor limit is
// the real table size.

fn make_loadavg(state: u64) -> u64 {
    var z: [u8; 18] = "0.00 0.00 0.00 1/\0"
    var p: u64 = w_str(state, 0, (&z[0]) as u64)
    var live: u64 = 0
    var t: u64 = 0
    let n: u64 = kstate.get(state, kstate.TASKS)
    while t < n {
        if alive(state, t) {
            live = live + 1
        }
        t = t + 1
    }
    p = w_num(state, p, live)
    p = w_ch(state, p, 32)
    p = w_num(state, p, kstate.get(state, kstate.NEXT_PID) - 1)
    return w_nl(state, p)
}

// ---------------------------------------------------------------- E1 tables
// /proc/pci, /proc/usb, /proc/firmware: what the kernel FOUND, one line per
// device, no serial numbers (the system report must be safe to send).

fn w_hexn(state: u64, at: u64, v: u64, n: u64) -> u64 {
    var p: u64 = at
    var i: u64 = n
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * 4)) & 15
        if d < 10 {
            p = w_ch(state, p, d + 48)
        } else {
            p = w_ch(state, p, d + 87)
        }
    }
    return p
}

// "bb:dd.f cccc vvvv:dddd irq=N" -- class and subclass are the two digit pairs
// of lspci -n; the line ends with the interrupt line the firmware assigned.
fn make_pci(state: u64) -> u64 {
    var l_irq: [u8; 6] = " irq=\0"
    var p: u64 = 0
    let n: u64 = pci.count(state)
    var i: u64 = 0
    while i < n {
        let bdf: u64 = pci.get(state, i, pci.E_BDF)
        p = w_hexn(state, p, pci.bdf_bus(bdf), 2)
        p = w_ch(state, p, 58)
        p = w_hexn(state, p, pci.bdf_dev(bdf), 2)
        p = w_ch(state, p, 46)
        p = w_hexn(state, p, pci.bdf_fn(bdf), 1)
        p = w_ch(state, p, 32)
        p = w_hexn(state, p, pci.get(state, i, pci.E_CLASS), 2)
        p = w_hexn(state, p, pci.get(state, i, pci.E_SUBCLASS), 2)
        p = w_ch(state, p, 32)
        p = w_hexn(state, p, pci.get(state, i, pci.E_VENDOR), 4)
        p = w_ch(state, p, 58)
        p = w_hexn(state, p, pci.get(state, i, pci.E_DEVICE), 4)
        p = w_str(state, p, (&l_irq[0]) as u64)
        p = w_num(state, p, pci.get(state, i, pci.E_IRQLINE))
        p = w_nl(state, p)
        i = i + 1
    }
    return p
}

fn w_speed(state: u64, at: u64, sp: u64) -> u64 {
    var s_lo: [u8; 4] = "low\0"
    var s_fu: [u8; 5] = "full\0"
    var s_hi: [u8; 5] = "high\0"
    var s_su: [u8; 6] = "super\0"
    var s_un: [u8; 8] = "unknown\0"
    if sp == 1 {
        return w_str(state, at, (&s_fu[0]) as u64)
    }
    if sp == 2 {
        return w_str(state, at, (&s_lo[0]) as u64)
    }
    if sp == 3 {
        return w_str(state, at, (&s_hi[0]) as u64)
    }
    if sp >= 4 {
        return w_str(state, at, (&s_su[0]) as u64)
    }
    return w_str(state, at, (&s_un[0]) as u64)
}

fn w_driver(state: u64, at: u64, k: u64) -> u64 {
    var d0: [u8; 5] = "none\0"
    var d1: [u8; 9] = "keyboard\0"
    var d2: [u8; 6] = "mouse\0"
    var d3: [u8; 8] = "storage\0"
    var d4: [u8; 7] = "hidgen\0"
    var d5: [u8; 4] = "hub\0"
    var d6: [u8; 4] = "ecm\0"
    var d7: [u8; 6] = "rndis\0"
    var d8: [u8; 5] = "isoc\0"
    var d9: [u8; 4] = "ncm\0"
    var d10: [u8; 6] = "ch336\0"
    var d11: [u8; 8] = "ax88772\0"
    if k == usb.DRV_CH336 {
        return w_str(state, at, (&d10[0]) as u64)
    }
    if k == usb.DRV_AX88772 {
        return w_str(state, at, (&d11[0]) as u64)
    }
    if k == usb.DRV_KBD {
        return w_str(state, at, (&d1[0]) as u64)
    }
    if k == usb.DRV_MOUSE {
        return w_str(state, at, (&d2[0]) as u64)
    }
    if k == usb.DRV_MSC {
        return w_str(state, at, (&d3[0]) as u64)
    }
    if k == usb.DRV_HIDGEN {
        return w_str(state, at, (&d4[0]) as u64)
    }
    if k == usb.DRV_HUB {
        return w_str(state, at, (&d5[0]) as u64)
    }
    if k == usb.DRV_ECM {
        return w_str(state, at, (&d6[0]) as u64)
    }
    if k == usb.DRV_RNDIS {
        return w_str(state, at, (&d7[0]) as u64)
    }
    if k == 8 {
        return w_str(state, at, (&d8[0]) as u64)
    }
    if k == usb.DRV_NCM {
        return w_str(state, at, (&d9[0]) as u64)
    }
    return w_str(state, at, (&d0[0]) as u64)
}

// A short device kind from the interface class (device class when the interface
// class is empty): hid-keyboard / hid-mouse / hid / storage / hub / net / audio / other.
fn w_kind(state: u64, at: u64, icls: u64, ipro: u64, dcls: u64) -> u64 {
    var k_kb: [u8; 13] = "hid-keyboard\0"
    var k_ms: [u8; 10] = "hid-mouse\0"
    var k_hid: [u8; 4] = "hid\0"
    var k_st: [u8; 8] = "storage\0"
    var k_hub: [u8; 4] = "hub\0"
    var k_net: [u8; 4] = "net\0"
    var k_au: [u8; 6] = "audio\0"
    var k_ot: [u8; 6] = "other\0"
    var c: u64 = icls
    if c == 0 {
        c = dcls
    }
    if c == 3 {
        if ipro == 1 {
            return w_str(state, at, (&k_kb[0]) as u64)
        }
        if ipro == 2 {
            return w_str(state, at, (&k_ms[0]) as u64)
        }
        return w_str(state, at, (&k_hid[0]) as u64)
    }
    if c == 8 {
        return w_str(state, at, (&k_st[0]) as u64)
    }
    if c == 9 {
        return w_str(state, at, (&k_hub[0]) as u64)
    }
    if c == 2 || c == 10 || c == 0xE0 {
        return w_str(state, at, (&k_net[0]) as u64)
    }
    if c == 1 {
        return w_str(state, at, (&k_au[0]) as u64)
    }
    return w_str(state, at, (&k_ot[0]) as u64)
}

// Controller lines come first, one per xHCI found on the PCI bus (also with no
// device attached):
//   "controller xhci 00:04.0 1b36:000d ports=8 state=up selected"
//   "controller xhci 00:05.0 1022:149c state=idle"      (found, not the active one)
//   "controller none"                                    (no xHCI on this machine)
// Device lines:
// "vvvv:pppp port=N [hub=M] speed=S class=cc/ss/pp if=cc/ss/pp driver=NAME hc=xhci kind=K"
// (port = root port, hub = port on the hub in front of it, if any).
fn make_usb(state: u64) -> u64 {
    var l_ctl: [u8; 17] = "controller xhci \0"
    var l_none: [u8; 17] = "controller none\n\0"
    var l_ports: [u8; 8] = " ports=\0"
    var l_up: [u8; 10] = " state=up\0"
    var l_down: [u8; 12] = " state=down\0"
    var l_idle: [u8; 12] = " state=idle\0"
    var l_sel: [u8; 10] = " selected\0"
    var l_hc: [u8; 9] = " hc=xhci\0"
    var l_kind: [u8; 7] = " kind=\0"
    var p: u64 = 0
    let hcn: u64 = xhci.count_hc(state)
    if hcn == 0 {
        p = w_str(state, p, (&l_none[0]) as u64)
    }
    var h: u64 = 0
    while h < hcn {
        let idx: u64 = xhci.nth_hc(state, h)
        if idx < pci.MAX_DEV {
            let bdf: u64 = pci.get(state, idx, pci.E_BDF)
            p = w_str(state, p, (&l_ctl[0]) as u64)
            p = w_hexn(state, p, pci.bdf_bus(bdf), 2)
            p = w_ch(state, p, 58)
            p = w_hexn(state, p, pci.bdf_dev(bdf), 2)
            p = w_ch(state, p, 46)
            p = w_hexn(state, p, pci.bdf_fn(bdf), 1)
            p = w_ch(state, p, 32)
            p = w_hexn(state, p, pci.get(state, idx, pci.E_VENDOR), 4)
            p = w_ch(state, p, 58)
            p = w_hexn(state, p, pci.get(state, idx, pci.E_DEVICE), 4)
            if h == usb.choice(state) {
                p = w_str(state, p, (&l_ports[0]) as u64)
                p = w_num(state, p, xhci.ports(state))
                if xhci.ready(state) {
                    p = w_str(state, p, (&l_up[0]) as u64)
                } else {
                    p = w_str(state, p, (&l_down[0]) as u64)
                }
                p = w_str(state, p, (&l_sel[0]) as u64)
            } else {
                p = w_str(state, p, (&l_idle[0]) as u64)
            }
            p = w_nl(state, p)
        }
        h = h + 1
    }

    var l_port: [u8; 7] = " port=\0"
    var l_hub: [u8; 6] = " hub=\0"
    var l_sp: [u8; 8] = " speed=\0"
    var l_cl: [u8; 8] = " class=\0"
    var l_if: [u8; 5] = " if=\0"
    var l_dr: [u8; 9] = " driver=\0"
    let n: u64 = usb.fund_count(state)
    var i: u64 = 0
    while i < n {
        p = w_hexn(state, p, usb.fund_vid(state, i), 4)
        p = w_ch(state, p, 58)
        p = w_hexn(state, p, usb.fund_pid(state, i), 4)
        p = w_str(state, p, (&l_port[0]) as u64)
        p = w_num(state, p, usb.fund_port(state, i))
        if usb.fund_hub(state, i) != 0 {
            p = w_str(state, p, (&l_hub[0]) as u64)
            p = w_num(state, p, usb.fund_hub(state, i))
        }
        p = w_str(state, p, (&l_sp[0]) as u64)
        p = w_speed(state, p, usb.fund_speed(state, i))
        p = w_str(state, p, (&l_cl[0]) as u64)
        p = w_hexn(state, p, usb.fund_dcls(state, i), 2)
        p = w_ch(state, p, 47)
        p = w_hexn(state, p, usb.fund_dsub(state, i), 2)
        p = w_ch(state, p, 47)
        p = w_hexn(state, p, usb.fund_dpro(state, i), 2)
        p = w_str(state, p, (&l_if[0]) as u64)
        p = w_hexn(state, p, usb.fund_icls(state, i), 2)
        p = w_ch(state, p, 47)
        p = w_hexn(state, p, usb.fund_isub(state, i), 2)
        p = w_ch(state, p, 47)
        p = w_hexn(state, p, usb.fund_ipro(state, i), 2)
        p = w_str(state, p, (&l_dr[0]) as u64)
        p = w_driver(state, p, usb.fund_driver(state, i))
        p = w_str(state, p, (&l_hc[0]) as u64)
        p = w_str(state, p, (&l_kind[0]) as u64)
        p = w_kind(state, p, usb.fund_icls(state, i), usb.fund_ipro(state, i),
            usb.fund_dcls(state, i))
        p = w_nl(state, p)
        i = i + 1
    }
    return w_usbnet_lines(state, p)
}

fn w_ip4(state: u64, at: u64, a: u64) -> u64 {
    var p: u64 = w_num(state, at, (a >> 24) & 0xFF)
    p = w_ch(state, p, 46)
    p = w_num(state, p, (a >> 16) & 0xFF)
    p = w_ch(state, p, 46)
    p = w_num(state, p, (a >> 8) & 0xFF)
    p = w_ch(state, p, 46)
    return w_num(state, p, a & 0xFF)
}

fn w_usbnet_lines(state: u64, at: u64) -> u64 {
    var l_un: [u8; 20] = "usbnet: ready mode=\0"
    var l_lk: [u8; 7] = " link=\0"
    var l_bm: [u8; 7] = " bmsr=\0"
    var l_cf: [u8; 6] = " cfg=\0"
    var l_fw: [u8; 5] = " fw=\0"
    var l_ch: [u8; 6] = " chg=\0"
    var l_rx: [u8; 5] = " rx=\0"
    var l_tx: [u8; 5] = " tx=\0"
    var l_er: [u8; 6] = " err=\0"
    var l_dr: [u8; 7] = " drop=\0"
    var l_ip: [u8; 9] = "net: ip=\0"
    var l_gw: [u8; 5] = " gw=\0"
    var l_up: [u8; 3] = "up\0"
    var l_dn: [u8; 5] = "down\0"
    var l_uk: [u8; 8] = "unknown\0"
    var p: u64 = at
    if usbnet.ready_on(state, 0) {
        p = w_str(state, p, (&l_un[0]) as u64)
        p = w_num(state, p, usbnet.mode_get(state))
        p = w_str(state, p, (&l_lk[0]) as u64)
        let lk: u64 = usbnet.link_on(state, 0)
        if lk == 1 {
            p = w_str(state, p, (&l_up[0]) as u64)
        } else if lk == 2 {
            p = w_str(state, p, (&l_dn[0]) as u64)
        } else {
            p = w_str(state, p, (&l_uk[0]) as u64)
        }
        if usbnet.mode_get(state) == 3 {
            p = w_str(state, p, (&l_bm[0]) as u64)
            p = w_hexn(state, p, usbnet.ch_bmsr(state), 4)
            p = w_str(state, p, (&l_cf[0]) as u64)
            p = w_hexn(state, p, usbnet.ch_cfg(state), 8)
            p = w_str(state, p, (&l_fw[0]) as u64)
            p = w_hexn(state, p, usbnet.ch_fw(state), 2)
            p = w_str(state, p, (&l_ch[0]) as u64)
            p = w_num(state, p, usbnet.ch_changes(state))
        }
        p = w_str(state, p, (&l_rx[0]) as u64)
        p = w_num(state, p, usbnet.rx_frames_on(state, 0))
        p = w_str(state, p, (&l_tx[0]) as u64)
        p = w_num(state, p, usbnet.tx_frames_on(state, 0))
        p = w_str(state, p, (&l_er[0]) as u64)
        p = w_num(state, p, usbnet.errors(state))
        p = w_str(state, p, (&l_dr[0]) as u64)
        p = w_num(state, p, usbnet.tx_drops_on(state, 0))
        p = w_nl(state, p)
    }
    if inet.ready(state) {
        p = w_str(state, p, (&l_ip[0]) as u64)
        p = w_ip4(state, p, inet.ip(state))
        p = w_str(state, p, (&l_gw[0]) as u64)
        p = w_ip4(state, p, inet.gw(state))
        p = w_nl(state, p)
    }
    return p
}

fn w_sdec(state: u64, at: u64, v: u64) -> u64 {
    if (v >> 63) != 0 {
        let q: u64 = w_ch(state, at, 45)
        return w_num(state, q, 0xFFFFFFFFFFFFFFFF - v + 1)
    }
    return w_num(state, at, v)
}

fn w_usbnet_usb(state: u64, at: u64) -> u64 {
    var l_ab: [u8; 19] = "usb: ch336 absent\n\0"
    var l_id: [u8; 15] = "usb: ch336 id=\0"
    var l_sp: [u8; 8] = " speed=\0"
    var l_rt: [u8; 8] = " route=\0"
    var l_nc: [u8; 11] = "usb: ncfg=\0"
    var l_cf: [u8; 6] = " cfg=\0"
    var l_st: [u8; 9] = " setcfg=\0"
    var l_rc: [u8; 5] = " rc=\0"
    var l_if: [u8; 12] = "usb: iface=\0"
    var l_n: [u8; 6] = " num=\0"
    var l_ep: [u8; 12] = "usb: ep in=\0"
    var l_ou: [u8; 6] = " out=\0"
    var l_it: [u8; 6] = " int=\0"
    var l_im: [u8; 9] = " intmps=\0"
    var l_iv: [u8; 6] = " ivl=\0"
    var l_bm: [u8; 10] = " bulkmps=\0"
    var l_sp2: [u8; 11] = "usb: step=\0"
    var l_ok: [u8; 4] = " ok\0"
    var l_fl: [u8; 8] = " failed\0"
    var p: u64 = at
    if usb.ch_diag(state, usb.CK_PRESENT) == 0 {
        return w_str(state, p, (&l_ab[0]) as u64)
    }
    p = w_str(state, p, (&l_id[0]) as u64)
    p = w_hexn(state, p, usb.ch_diag(state, usb.CK_VID), 4)
    p = w_ch(state, p, 58)
    p = w_hexn(state, p, usb.ch_diag(state, usb.CK_PID), 4)
    p = w_str(state, p, (&l_sp[0]) as u64)
    p = w_speed(state, p, usb.ch_diag(state, usb.CK_SPEED))
    p = w_str(state, p, (&l_rt[0]) as u64)
    p = w_hexn(state, p, usb.ch_diag(state, usb.CK_ROUTE), 5)
    p = w_nl(state, p)
    p = w_str(state, p, (&l_nc[0]) as u64)
    p = w_num(state, p, usb.ch_diag(state, usb.CK_NCFG))
    p = w_str(state, p, (&l_cf[0]) as u64)
    p = w_num(state, p, usb.ch_diag(state, usb.CK_CFG))
    p = w_str(state, p, (&l_st[0]) as u64)
    p = w_num(state, p, usb.ch_diag(state, usb.CK_SET))
    p = w_str(state, p, (&l_rc[0]) as u64)
    p = w_sdec(state, p, usb.ch_diag(state, usb.CK_RC))
    p = w_nl(state, p)
    p = w_str(state, p, (&l_if[0]) as u64)
    p = w_hexn(state, p, usb.ch_diag(state, usb.CK_CLASS), 2)
    p = w_ch(state, p, 47)
    p = w_hexn(state, p, usb.ch_diag(state, usb.CK_SUB), 2)
    p = w_ch(state, p, 47)
    p = w_hexn(state, p, usb.ch_diag(state, usb.CK_PROTO), 2)
    p = w_str(state, p, (&l_n[0]) as u64)
    p = w_num(state, p, usb.ch_diag(state, usb.CK_IFACE))
    p = w_nl(state, p)
    let it: u64 = usb.ch_diag(state, usb.CK_INT)
    p = w_str(state, p, (&l_ep[0]) as u64)
    p = w_num(state, p, usb.ch_diag(state, usb.CK_INDCI))
    p = w_str(state, p, (&l_ou[0]) as u64)
    p = w_num(state, p, usb.ch_diag(state, usb.CK_OUTDCI))
    p = w_str(state, p, (&l_it[0]) as u64)
    p = w_num(state, p, it & 255)
    p = w_str(state, p, (&l_im[0]) as u64)
    p = w_num(state, p, (it >> 8) & 0xFFFF)
    p = w_str(state, p, (&l_iv[0]) as u64)
    p = w_num(state, p, it >> 24)
    p = w_str(state, p, (&l_bm[0]) as u64)
    p = w_num(state, p, usb.ch_diag(state, usb.CK_BULKMPS))
    p = w_nl(state, p)
    p = w_str(state, p, (&l_sp2[0]) as u64)
    p = w_num(state, p, usb.ch_diag(state, usb.CK_STEP))
    let res: u64 = usb.ch_diag(state, usb.CK_RESULT)
    if res == 1 {
        p = w_str(state, p, (&l_ok[0]) as u64)
    } else if res == 2 {
        p = w_str(state, p, (&l_fl[0]) as u64)
    }
    return w_nl(state, p)
}

fn w_usbnet_phy(state: u64, at: u64) -> u64 {
    var l_ph: [u8; 11] = "phy: bmcr=\0"
    var l_bs: [u8; 7] = " bmsr=\0"
    var l_id: [u8; 5] = " id=\0"
    var l_an: [u8; 7] = " anar=\0"
    var l_lp: [u8; 6] = " lpa=\0"
    var l_ae: [u8; 7] = " aner=\0"
    var l_ks: [u8; 8] = " kicks=\0"
    var l_kr: [u8; 9] = " kickrc=\0"
    var l_lk: [u8; 13] = "link: state=\0"
    var l_up: [u8; 3] = "up\0"
    var l_dn: [u8; 5] = "down\0"
    var l_uk: [u8; 8] = "unknown\0"
    var l_cg: [u8; 6] = " chg=\0"
    var l_md: [u8; 7] = " mode=\0"
    var l_fw: [u8; 5] = " fw=\0"
    var l_cu: [u8; 6] = " cfg=\0"
    var p: u64 = at
    if !usbnet.present_on(state, 0) || usbnet.mode_get(state) != 3 {
        return p
    }
    p = w_str(state, p, (&l_ph[0]) as u64)
    p = w_hexn(state, p, usbnet.ch_phy(state, 0), 4)
    p = w_str(state, p, (&l_bs[0]) as u64)
    p = w_hexn(state, p, usbnet.ch_bmsr(state), 4)
    p = w_str(state, p, (&l_id[0]) as u64)
    p = w_hexn(state, p, usbnet.ch_phy(state, 1), 8)
    p = w_str(state, p, (&l_an[0]) as u64)
    p = w_hexn(state, p, usbnet.ch_phy(state, 3), 4)
    p = w_str(state, p, (&l_lp[0]) as u64)
    p = w_hexn(state, p, usbnet.ch_phy(state, 4), 4)
    p = w_str(state, p, (&l_ae[0]) as u64)
    p = w_hexn(state, p, usbnet.ch_phy(state, 2), 4)
    p = w_str(state, p, (&l_ks[0]) as u64)
    p = w_num(state, p, usbnet.ch_phy(state, 5))
    p = w_str(state, p, (&l_kr[0]) as u64)
    p = w_num(state, p, usbnet.ch_phy(state, 6))
    p = w_nl(state, p)
    p = w_str(state, p, (&l_lk[0]) as u64)
    let lk: u64 = usbnet.link_on(state, 0)
    if lk == 1 {
        p = w_str(state, p, (&l_up[0]) as u64)
    } else if lk == 2 {
        p = w_str(state, p, (&l_dn[0]) as u64)
    } else {
        p = w_str(state, p, (&l_uk[0]) as u64)
    }
    p = w_str(state, p, (&l_cg[0]) as u64)
    p = w_num(state, p, usbnet.ch_changes(state))
    p = w_str(state, p, (&l_md[0]) as u64)
    p = w_num(state, p, usbnet.mode_get(state))
    p = w_str(state, p, (&l_fw[0]) as u64)
    p = w_hexn(state, p, usbnet.ch_fw(state), 2)
    p = w_str(state, p, (&l_cu[0]) as u64)
    p = w_hexn(state, p, usbnet.ch_cfg(state), 8)
    return w_nl(state, p)
}

fn w_usbnet_dhcp(state: u64, at: u64) -> u64 {
    var l_dh: [u8; 13] = "dhcp: state=\0"
    var l_tx: [u8; 5] = " tx=\0"
    var l_rx: [u8; 5] = " rx=\0"
    var l_tr: [u8; 6] = " try=\0"
    var p: u64 = at
    p = w_str(state, p, (&l_dh[0]) as u64)
    p = w_num(state, p, inet.dhcp_get(0))
    p = w_str(state, p, (&l_tx[0]) as u64)
    p = w_num(state, p, inet.dhcp_get(1))
    p = w_str(state, p, (&l_rx[0]) as u64)
    p = w_num(state, p, inet.dhcp_get(2))
    p = w_str(state, p, (&l_tr[0]) as u64)
    p = w_num(state, p, inet.dhcp_get(3))
    return w_nl(state, p)
}

fn make_usbnet(state: u64) -> u64 {
    var p: u64 = w_usbnet_usb(state, 0)
    p = w_usbnet_phy(state, p)
    p = w_usbnet_lines(state, p)
    return w_usbnet_dhcp(state, p)
}

// /proc/wlan: one line per Intel gen2 WLAN function found on the bus, read
// read-only by drv/net/iwl.fi (M1b). No MAC address, no serial number.
//   "00:14.3 8086:a0f0 hw_rev=0x00000351 rf_id=0x0010a110 mac=QuZ rf=HR"
//   "00:14.3 8086:a0f0 err=dead"      (device did not answer)
//   "none"                            (no such device on the bus)
fn make_wlan_devices(state: u64) -> u64 {
    var l_none: [u8; 5] = "none\0"
    var l_hw: [u8; 12] = " hw_rev=0x\0\0"
    var l_rf: [u8; 10] = " rf_id=0x\0"
    var l_mac: [u8; 6] = " mac=\0"
    var l_rfn: [u8; 5] = " rf=\0"
    var l_err: [u8; 6] = " err=\0"
    var l_dead: [u8; 5] = "dead\0"
    var l_bar: [u8; 4] = "bar\0"
    var l_oth: [u8; 6] = "other\0"
    var nm: [u8; 24] = [0 as u8; 24]
    var p: u64 = 0
    let n: u64 = iwl.count_targets(state)
    if n == 0 {
        p = w_str(state, p, (&l_none[0]) as u64)
        p = w_nl(state, p)
        if !iwl.diag_active() { return p }
    }
    var k: u64 = 0
    while k < n {
        let i: u64 = iwl.target_at(state, k)
        let bdf: u64 = pci.get(state, i, pci.E_BDF)
        p = w_hexn(state, p, pci.bdf_bus(bdf), 2)
        p = w_ch(state, p, 58)
        p = w_hexn(state, p, pci.bdf_dev(bdf), 2)
        p = w_ch(state, p, 46)
        p = w_hexn(state, p, pci.bdf_fn(bdf), 1)
        p = w_ch(state, p, 32)
        p = w_hexn(state, p, pci.get(state, i, pci.E_VENDOR), 4)
        p = w_ch(state, p, 58)
        p = w_hexn(state, p, pci.get(state, i, pci.E_DEVICE), 4)
        var pr: iwl_probe.Probe = iwl_probe.probe_new()
        let r: i64 = iwl.probe_at(state, i, &pr, false)
        if r != 0 {
            p = w_str(state, p, (&l_err[0]) as u64)
            if r == iwl_probe.E_DEAD {
                p = w_str(state, p, (&l_dead[0]) as u64)
            } else if r == iwl_probe.E_BAR {
                p = w_str(state, p, (&l_bar[0]) as u64)
            } else {
                p = w_str(state, p, (&l_oth[0]) as u64)
            }
        } else {
            p = w_str(state, p, (&l_hw[0]) as u64)
            p = w_hexn(state, p, pr.hw_rev, 8)
            p = w_str(state, p, (&l_rf[0]) as u64)
            p = w_hexn(state, p, pr.rf_id, 8)
            p = w_str(state, p, (&l_mac[0]) as u64)
            let _a: usize = iwl_probe.rev_name_get(pr.hw_rev, (&nm[0]) as u64)
            p = w_str(state, p, (&nm[0]) as u64)
            p = w_str(state, p, (&l_rfn[0]) as u64)
            let _b: usize = iwl_probe.rf_name_get(pr.rf_id, (&nm[0]) as u64)
            p = w_str(state, p, (&nm[0]) as u64)
        }
        p = w_nl(state, p)
        k = k + 1
    }
    var dg: [u8; 3400] = [0 as u8; 3400]
    let dn: u64 = iwl.diag_text((&dg[0]) as u64, 3400)
    var di: u64 = 0
    while di < dn {
        p = w_ch(state, p, dg[di as usize] as u64)
        di = di + 1
    }
    return p
}

fn w_ip(state: u64, at: u64, v: u64) -> u64 {
    var p: u64 = w_num(state, at, (v >> 24) & 255)
    p = w_ch(state, p, 46)
    p = w_num(state, p, (v >> 16) & 255)
    p = w_ch(state, p, 46)
    p = w_num(state, p, (v >> 8) & 255)
    p = w_ch(state, p, 46)
    return w_num(state, p, v & 255)
}

// /proc/wlan, autostart part (net/wlan_auto.fi), appended after the device lines:
//   "wlan: waiting for driver"                   (no transport bound yet)
//   "auto=retry rc=-111 tries=3 driver=bound"
//   "link losses=0 reconnects=0"
//   "ip=192.168.0.50 mask=255.255.255.0 gw=192.168.0.1"    (only when up)
fn make_wlan(state: u64) -> u64 {
    var l_wait: [u8; 25] = "wlan: waiting for driver\0"
    var l_auto: [u8; 6] = "auto=\0"
    var l_rc: [u8; 5] = " rc=\0"
    var l_tr: [u8; 8] = " tries=\0"
    var l_drv: [u8; 9] = " driver=\0"
    var l_bound: [u8; 6] = "bound\0"
    var l_waiting: [u8; 8] = "waiting\0"
    var l_link: [u8; 13] = "link losses=\0"
    var l_recon: [u8; 13] = " reconnects=\0"
    var l_ip: [u8; 4] = "ip=\0"
    var l_mask: [u8; 7] = " mask=\0"
    var l_gw: [u8; 5] = " gw=\0"
    var nm: [u8; 24] = [0 as u8; 24]
    var p: u64 = make_wlan_devices(state)
    if !wlan_auto.driver_ready() {
        p = w_str(state, p, (&l_wait[0]) as u64)
        p = w_nl(state, p)
    }
    let _n: usize = wlan_auto.name_copy((&nm[0]) as u64)
    p = w_str(state, p, (&l_auto[0]) as u64)
    p = w_str(state, p, (&nm[0]) as u64)
    p = w_str(state, p, (&l_rc[0]) as u64)
    let rc: i64 = wlan_auto.rc_get()
    if rc < 0 {
        p = w_ch(state, p, 45)
        p = w_num(state, p, (0 - rc) as u64)
    } else {
        p = w_num(state, p, rc as u64)
    }
    p = w_str(state, p, (&l_tr[0]) as u64)
    p = w_num(state, p, wlan_auto.tries_get())
    p = w_str(state, p, (&l_drv[0]) as u64)
    if wlan_auto.driver_ready() {
        p = w_str(state, p, (&l_bound[0]) as u64)
    } else {
        p = w_str(state, p, (&l_waiting[0]) as u64)
    }
    p = w_nl(state, p)
    p = w_str(state, p, (&l_link[0]) as u64)
    p = w_num(state, p, wlan_auto.losses_get())
    p = w_str(state, p, (&l_recon[0]) as u64)
    p = w_num(state, p, wlan_auto.reconnects_get())
    p = w_nl(state, p)
    if wlan_auto.scan_count() != 0 {
        var sb: [u8; 1100] = [0 as u8; 1100]
        let sn: u64 = wlan_auto.scan_text((&sb[0]) as u64, 1080)
        var si: u64 = 0
        while si < sn {
            p = w_ch(state, p, sb[si as usize] as u64)
            si = si + 1
        }
    }
    if wlan_auto.lease_ip() != 0 {
        p = w_str(state, p, (&l_ip[0]) as u64)
        p = w_ip(state, p, wlan_auto.lease_ip())
        p = w_str(state, p, (&l_mask[0]) as u64)
        p = w_ip(state, p, wlan_auto.lease_mask())
        p = w_str(state, p, (&l_gw[0]) as u64)
        p = w_ip(state, p, wlan_auto.lease_gateway())
        p = w_nl(state, p)
    }
    return p
}

// /proc/apps: one header line, then one line per app that has a slot in the rights table:
//   "# app cpu_ticks wakeups tx_bytes rx_bytes"
//   "mail 412 96 20480 1048576"
// cpu_ticks = timer ticks charged to tasks that carry the label app:<name> (children included, the label is sticky),
// wakeups = blocked->ready transitions of those tasks, tx/rx_bytes = payload octets of their sockets.
// Counted since boot (an app that is not in the table, because it was never registered or the table is full, is not
// counted). Unlabelled tasks (the person's own tools, system bundles) have no line.
fn make_safe(state: u64) -> u64 {
    var l_s: [u8; 6] = "safe=\0"
    var l_f: [u8; 7] = "fails=\0"
    var l_p: [u8; 7] = "phase=\0"
    var l_b: [u8; 10] = "fallback=\0"
    var p: u64 = w_str(state, 0, (&l_s[0]) as u64)
    if safe.is_safe() {
        p = w_num(state, p, 1)
    } else {
        p = w_num(state, p, 0)
    }
    p = w_nl(state, p)
    p = w_str(state, p, (&l_f[0]) as u64)
    p = w_num(state, p, safe.fails())
    p = w_nl(state, p)
    p = w_str(state, p, (&l_p[0]) as u64)
    p = w_num(state, p, safe.phase_now())
    p = w_nl(state, p)
    p = w_str(state, p, (&l_b[0]) as u64)
    if safe.fell_back() {
        p = w_num(state, p, 1)
    } else {
        p = w_num(state, p, 0)
    }
    p = w_nl(state, p)
    return p
}

fn make_odb(state: u64) -> u64 {
    var l_en: [u8; 5] = "odb=\0"
    var l_ov: [u8; 13] = "rx_overruns=\0"
    var p: u64 = w_str(state, 0, (&l_en[0]) as u64)
    if kstate.mode_on(state, kstate.M_ODB) {
        p = w_num(state, p, 1)
    } else {
        p = w_num(state, p, 0)
    }
    p = w_nl(state, p)
    p = w_str(state, p, (&l_ov[0]) as u64)
    p = w_num(state, p, odbuart.overruns())
    p = w_nl(state, p)
    return p
}

// /proc/bench: one `key value` per line, integers only.
//   boot.<phase> = ms since kernel_main entry (rdtsc stamps from kmain.fi, TIME_KHZ = cycles per ms); a phase not reached is left out
//   kernel.end = end of the kernel image in memory; heap.bytes / heap.blocks / heap.used_blocks = the kernel heap
//   irq.traps = interrupts and exceptions of every kind since boot; tsc.khz = rdtsc cycles per millisecond
fn bench_phase(state: u64, p0: u64, name: u64, i: u64, at: u64) -> u64 {
    let khz: u64 = kstate.get(state, kstate.TIME_KHZ)
    let t: u64 = kstate.get(state, kstate.BM_BASE + i * 8)
    if t == 0 || khz == 0 || t < p0 {
        return at
    }
    var l_boot: [u8; 6] = "boot.\0"
    var p: u64 = w_str(state, at, (&l_boot[0]) as u64)
    p = w_str(state, p, name)
    p = w_ch(state, p, 32)
    p = w_num(state, p, (t - p0) / khz)
    return w_nl(state, p)
}

fn make_bench(state: u64) -> u64 {
    var n_clock: [u8; 6] = "clock\0"
    var n_irq: [u8; 4] = "irq\0"
    var n_gfx: [u8; 4] = "gfx\0"
    var n_sched: [u8; 6] = "sched\0"
    var n_progs: [u8; 6] = "progs\0"
    var n_init: [u8; 5] = "init\0"
    var l_kend: [u8; 12] = "kernel.end \0"
    var l_hb: [u8; 12] = "heap.bytes \0"
    var l_hn: [u8; 13] = "heap.blocks \0"
    var l_hu: [u8; 18] = "heap.used_blocks \0"
    var l_tr: [u8; 11] = "irq.traps \0"
    var l_khz: [u8; 9] = "tsc.khz \0"
    let p0: u64 = kstate.get(state, kstate.BM_BASE)
    var p: u64 = 0
    p = bench_phase(state, p0, (&n_clock[0]) as u64, 1, p)
    p = bench_phase(state, p0, (&n_irq[0]) as u64, 2, p)
    p = bench_phase(state, p0, (&n_gfx[0]) as u64, 3, p)
    p = bench_phase(state, p0, (&n_sched[0]) as u64, 4, p)
    p = bench_phase(state, p0, (&n_progs[0]) as u64, 5, p)
    p = bench_phase(state, p0, (&n_init[0]) as u64, 6, p)
    p = w_str(state, p, (&l_kend[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.KERNEL_END))
    p = w_nl(state, p)
    p = w_str(state, p, (&l_hb[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.HEAP_END) - kstate.get(state, kstate.HEAP_BASE))
    p = w_nl(state, p)
    p = w_str(state, p, (&l_hn[0]) as u64)
    p = w_num(state, p, mem.heap_blocks(state, false))
    p = w_nl(state, p)
    p = w_str(state, p, (&l_hu[0]) as u64)
    p = w_num(state, p, mem.heap_blocks(state, true))
    p = w_nl(state, p)
    p = w_str(state, p, (&l_tr[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.TRAPS))
    p = w_nl(state, p)
    p = w_str(state, p, (&l_khz[0]) as u64)
    p = w_num(state, p, kstate.get(state, kstate.TIME_KHZ))
    p = w_nl(state, p)
    return p
}

fn frames_line(state: u64, p0: u64, i: u64, suffix: u64, v: u64) -> u64 {
    var l_win: [u8; 5] = "win.\0"
    var p: u64 = w_str(state, p0, (&l_win[0]) as u64)
    p = w_num(state, p, i)
    p = w_str(state, p, suffix)
    p = w_num(state, p, v)
    return w_nl(state, p)
}

fn kvn(state: u64, p0: u64, label: u64, v: u64) -> u64 {
    var p: u64 = w_str(state, p0, label)
    p = w_num(state, p, v)
    return w_nl(state, p)
}

fn fbperf_lines(state: u64, p0: u64) -> u64 {
    var k_cm: [u8; 15] = "fb_cache_mode \0"
    var k_pw: [u8; 8] = "pat_wc \0"
    var k_pm: [u8; 9] = "pat_msr \0"
    var k_pde: [u8; 8] = "fb_pde \0"
    var k_mt: [u8; 14] = "fb_mtrr_type \0"
    var k_mh: [u8; 14] = "fb_mtrr_hits \0"
    var k_mv: [u8; 14] = "mtrr_var_cnt \0"
    var k_me: [u8; 14] = "mtrr_enabled \0"
    var k_md: [u8; 15] = "mtrr_def_type \0"
    var k_fw: [u8; 14] = "fb_write_mbs \0"
    var k_f0: [u8; 16] = "fb_write0_mbs \0\0"
    var k_ws: [u8; 16] = "fb_mtrr_wc_st \0\0"
    var k_wr: [u8; 16] = "fb_mtrr_wc_rs \0\0"
    var k_wd: [u8; 17] = "fb_mtrr_wc_done \0"
    var k_wn: [u8; 14] = "fb_mtrr_wc_n \0"
    var k_fc: [u8; 13] = "fb_copy_mbs \0"
    var k_rw: [u8; 15] = "ram_write_mbs \0"
    var k_fs: [u8; 11] = "fb_stripe \0"
    var k_fx: [u8; 10] = "fb_width \0"
    var k_fh: [u8; 11] = "fb_height \0"
    var k_fp: [u8; 10] = "fb_pitch \0"
    var k_fn: [u8; 12] = "fb_flush_n \0"
    var k_fu: [u8; 13] = "fb_flush_us \0"
    var k_fm: [u8; 17] = "fb_flush_max_us \0"
    var k_fo: [u8; 14] = "fb_flush_okt \0"
    var k_pn: [u8; 9] = "phase_n \0"
    var k_pb: [u8; 13] = "phase_bg_us \0"
    var k_pwn: [u8; 14] = "phase_win_us \0"
    var k_ptp: [u8; 14] = "phase_top_us \0"
    var k_ppe: [u8; 15] = "phase_blit_us \0"
    var k_ppx: [u8; 10] = "phase_px \0"
    var k_pbl: [u8; 15] = "phase_blur_us \0"
    var k_pgl: [u8; 16] = "phase_glass_us \0"
    var k_psh: [u8; 17] = "phase_shadow_us \0"
    var v_wc: [u8; 3] = "wc\0"
    var v_wb: [u8; 3] = "wb\0"
    var v_uc: [u8; 3] = "uc\0"
    var v_un: [u8; 8] = "unknown\0"
    var p: u64 = p0
    p = w_str(state, p, (&k_cm[0]) as u64)
    let cm: u64 = fb.cache_mode(state)
    if cm == 0 {
        p = w_str(state, p, (&v_uc[0]) as u64)
    } else if cm == 1 {
        p = w_str(state, p, (&v_wc[0]) as u64)
    } else if cm == 2 {
        p = w_str(state, p, (&v_wb[0]) as u64)
    } else {
        p = w_str(state, p, (&v_un[0]) as u64)
    }
    p = w_nl(state, p)
    var pw: u64 = 0
    if ((fb.pat_roh(state) >> 32) & 255) == 1 {
        pw = 1
    }
    p = kvn(state, p, (&k_pw[0]) as u64, pw)
    p = kvn(state, p, (&k_pm[0]) as u64, fb.pat_roh(state))
    p = kvn(state, p, (&k_pde[0]) as u64, fb.pde_roh(state))
    let mt: u64 = fb.perf_get(state, fb.PF_MTRR)
    p = kvn(state, p, (&k_mt[0]) as u64, mt & 255)
    p = kvn(state, p, (&k_mh[0]) as u64, (mt >> 8) & 255)
    p = kvn(state, p, (&k_mv[0]) as u64, (mt >> 16) & 255)
    p = kvn(state, p, (&k_md[0]) as u64, (mt >> 24) & 255)
    p = kvn(state, p, (&k_me[0]) as u64, (mt >> 32) & 1)
    p = kvn(state, p, (&k_fw[0]) as u64, fb.perf_get(state, fb.PF_FBW))
    p = kvn(state, p, (&k_f0[0]) as u64, fb.perf_get(state, fb.PF_FBW0))
    p = kvn(state, p, (&k_ws[0]) as u64, fbmtrr.state_of(state))
    p = kvn(state, p, (&k_wr[0]) as u64, fbmtrr.reason_of(state))
    p = kvn(state, p, (&k_wn[0]) as u64, fbmtrr.count_of(state))
    p = kvn(state, p, (&k_wd[0]) as u64, fbmtrr.done_of(state))
    p = kvn(state, p, (&k_fc[0]) as u64, fb.perf_get(state, fb.PF_COPY))
    p = kvn(state, p, (&k_rw[0]) as u64, fb.perf_get(state, fb.PF_RAM))
    var st: u64 = 0
    if fb.stripe(state) {
        st = 1
    }
    p = kvn(state, p, (&k_fs[0]) as u64, st)
    p = kvn(state, p, (&k_fx[0]) as u64, fb.width(state))
    p = kvn(state, p, (&k_fh[0]) as u64, fb.height(state))
    p = kvn(state, p, (&k_fp[0]) as u64, fb.pitch(state))
    p = kvn(state, p, (&k_fn[0]) as u64, fb.flush_us_n(state))
    p = kvn(state, p, (&k_fu[0]) as u64, fb.flush_us_sum(state))
    p = kvn(state, p, (&k_fm[0]) as u64, fb.flush_us_max(state))
    p = kvn(state, p, (&k_fo[0]) as u64, fb.flush_okt(state))
    let wm: u64 = state + kstate.WM_OFF
    p = kvn(state, p, (&k_pn[0]) as u64, kstate.get(wm, 0x1630))
    p = kvn(state, p, (&k_pb[0]) as u64, kstate.get(wm, 0x1600))
    p = kvn(state, p, (&k_pwn[0]) as u64, kstate.get(wm, 0x1608))
    p = kvn(state, p, (&k_ptp[0]) as u64, kstate.get(wm, 0x1618))
    p = kvn(state, p, (&k_ppe[0]) as u64, kstate.get(wm, 0x1620))
    p = kvn(state, p, (&k_ppx[0]) as u64, kstate.get(wm, 0x1628))
    p = kvn(state, p, (&k_pbl[0]) as u64, kstate.get(wm, 0x1638))
    p = kvn(state, p, (&k_pgl[0]) as u64, kstate.get(wm, 0x1640))
    p = kvn(state, p, (&k_psh[0]) as u64, kstate.get(wm, 0x1648))
    return p
}

fn make_frames(state: u64) -> u64 {
    var l_slots: [u8; 14] = "frames.slots \0"
    var l_total: [u8; 17] = "frames.presents \0"
    var l_cost: [u8; 17] = "frames.note_cyc \0"
    var l_mon: [u8; 16] = "frames.overlay \0"
    var s_pres: [u8; 11] = ".presents \0"
    var s_avg: [u8; 13] = ".gap_avg_us \0"
    var s_max: [u8; 13] = ".gap_max_us \0"
    var s_last: [u8; 14] = ".gap_last_us \0"
    var s_pid: [u8; 6] = ".pid \0"
    var p: u64 = w_str(state, 0, (&l_slots[0]) as u64)
    p = w_num(state, p, frameprof.SLOTS)
    p = w_nl(state, p)
    p = w_str(state, p, (&l_total[0]) as u64)
    p = w_num(state, p, frameprof.total())
    p = w_nl(state, p)
    p = w_str(state, p, (&l_cost[0]) as u64)
    var per: u64 = 0
    if frameprof.total() != 0 {
        per = frameprof.cost() / frameprof.total()
    }
    p = w_num(state, p, per)
    p = w_nl(state, p)
    p = w_str(state, p, (&l_mon[0]) as u64)
    p = w_num(state, p, frameprof.mon_on())
    p = w_nl(state, p)
    p = fbperf_lines(state, p)
    var i: u64 = 0
    while i < frameprof.SLOTS {
        let r: u64 = frameprof.rec(i)
        if r != 0 && frameprof.field(r, frameprof.F_COUNT) != 0 {
            let gaps: u64 = frameprof.field(r, frameprof.F_GAPS)
            var avg: u64 = 0
            if gaps != 0 {
                avg = frameprof.field(r, frameprof.F_SUM) / gaps
            }
            p = frames_line(state, p, i, (&s_pres[0]) as u64, frameprof.field(r, frameprof.F_COUNT))
            p = frames_line(state, p, i, (&s_avg[0]) as u64, avg)
            p = frames_line(state, p, i, (&s_max[0]) as u64, frameprof.field(r, frameprof.F_MAX))
            p = frames_line(state, p, i, (&s_last[0]) as u64, frameprof.field(r, frameprof.F_GAP))
            p = frames_line(state, p, i, (&s_pid[0]) as u64, frameprof.pid_of(state, r))
        }
        i = i + 1
    }
    return p
}

fn gpu_kv(state: u64, p0: u64, label: u64, v: u64) -> u64 {
    var l_na: [u8; 3] = "-1\0"
    var p: u64 = w_str(state, p0, label)
    if v == GPU_NA {
        p = w_str(state, p, (&l_na[0]) as u64)
    } else {
        p = w_num(state, p, v)
    }
    return w_nl(state, p)
}

fn make_gpu(state: u64) -> u64 {
    var l_count: [u8; 11] = "gpu.count \0"
    var l_kind: [u8; 11] = "gpu0.kind \0"
    var l_name: [u8; 11] = "gpu0.name \0"
    var l_util: [u8; 16] = "gpu0.util_pm -1\0"
    var l_src: [u8; 15] = "gpu0.util_src \0"
    var l_vt: [u8; 23] = "gpu0.vram_total_bytes \0"
    var l_vu: [u8; 22] = "gpu0.vram_used_bytes \0"
    var l_fr: [u8; 13] = "gpu0.frames \0"
    var l_pb: [u8; 20] = "gpu0.present_bytes \0"
    var l_hc: [u8; 16] = "gpu0.hw_cursor \0"
    var n_fb: [u8; 3] = "fb\0"
    var n_vio: [u8; 7] = "virtio\0"
    var n_vmw: [u8; 7] = "vmsvga\0"
    let b: u64 = gfx.gpu_backend(state)
    var p: u64 = w_str(state, 0, (&l_count[0]) as u64)
    if b == 0 {
        p = w_num(state, p, 0)
        return w_nl(state, p)
    }
    p = w_num(state, p, 1)
    p = w_nl(state, p)
    var kind: u64 = 0
    var nm: u64 = (&n_fb[0]) as u64
    if b == 2 {
        kind = 1
        nm = (&n_vio[0]) as u64
    } else if b == 3 {
        kind = 1
        nm = (&n_vmw[0]) as u64
    }
    p = gpu_kv(state, p, (&l_kind[0]) as u64, kind)
    p = w_str(state, p, (&l_name[0]) as u64)
    p = w_str(state, p, nm)
    p = w_nl(state, p)
    p = w_str(state, p, (&l_util[0]) as u64)
    p = w_nl(state, p)
    p = gpu_kv(state, p, (&l_src[0]) as u64, 0)
    p = gpu_kv(state, p, (&l_vt[0]) as u64, gfx.gpu_vram_total(state))
    p = gpu_kv(state, p, (&l_vu[0]) as u64, gfx.gpu_vram_used(state))
    p = gpu_kv(state, p, (&l_fr[0]) as u64, gfx.gpu_frames(state))
    p = gpu_kv(state, p, (&l_pb[0]) as u64, gfx.gpu_present_bytes(state))
    p = gpu_kv(state, p, (&l_hc[0]) as u64, gfx.gpu_hw_cursor(state))
    return p
}

fn make_sysmon(state: u64) -> u64 {
    var l_cap: [u8; 12] = "sysmon.cap \0"
    var l_n: [u8; 14] = "sysmon.count \0"
    var l_cost: [u8; 17] = "sysmon.cost_cyc \0"
    var l_head: [u8; 67] = "# tick cpu_pct frames_free rd_blocks wr_blocks rx_octets tx_octets\0"
    var p: u64 = w_str(state, 0, (&l_cap[0]) as u64)
    p = w_num(state, p, sysmon.CAP)
    p = w_nl(state, p)
    p = w_str(state, p, (&l_n[0]) as u64)
    p = w_num(state, p, sysmon.count())
    p = w_nl(state, p)
    p = w_str(state, p, (&l_cost[0]) as u64)
    p = w_num(state, p, sysmon.cost())
    p = w_nl(state, p)
    p = w_str(state, p, (&l_head[0]) as u64)
    p = w_nl(state, p)
    var a: u64 = 0
    while a + 1 < sysmon.count() {
        p = w_num(state, p, sysmon.raw(a, sysmon.F_TICK))
        p = w_ch(state, p, 32)
        p = w_num(state, p, sysmon.busy_pct(a))
        p = w_ch(state, p, 32)
        p = w_num(state, p, sysmon.raw(a, sysmon.F_FREE))
        p = w_ch(state, p, 32)
        p = w_num(state, p, sysmon.delta(a, sysmon.F_RD))
        p = w_ch(state, p, 32)
        p = w_num(state, p, sysmon.delta(a, sysmon.F_WR))
        p = w_ch(state, p, 32)
        p = w_num(state, p, sysmon.delta(a, sysmon.F_RX))
        p = w_ch(state, p, 32)
        p = w_num(state, p, sysmon.delta(a, sysmon.F_TX))
        p = w_nl(state, p)
        a = a + 1
    }
    return p
}

fn make_apps(state: u64) -> u64 {
    var l_head: [u8; 42] = "# app cpu_ticks wakeups tx_bytes rx_bytes\0"
    var p: u64 = w_str(state, 0, (&l_head[0]) as u64)
    p = w_nl(state, p)
    var s: u64 = 0
    while s < policy.MAX_APPS {
        if policy.slot_used(s) {
            p = w_str(state, p, policy.slot_name(s))
            p = w_ch(state, p, 32)
            p = w_num(state, p, policy.acct_get(s, policy.A_CPU))
            p = w_ch(state, p, 32)
            p = w_num(state, p, policy.acct_get(s, policy.A_WAKE))
            p = w_ch(state, p, 32)
            p = w_num(state, p, policy.acct_get(s, policy.A_TX))
            p = w_ch(state, p, 32)
            p = w_num(state, p, policy.acct_get(s, policy.A_RX))
            p = w_nl(state, p)
        }
        s = s + 1
    }
    return p
}

// boot_mode: measured by hwdiag (traces a UEFI firmware does not leave).
// secure_boot: honest "unknown" -- the loader leaves no variable behind
// after the boot services are gone, so the kernel cannot read it.
fn make_firmware(state: u64) -> u64 {
    var l_bm: [u8; 12] = "boot_mode: \0"
    var v_bios: [u8; 5] = "BIOS\0"
    var v_uefi: [u8; 5] = "UEFI\0"
    var l_sb: [u8; 14] = "secure_boot: \0"
    var v_unk: [u8; 8] = "unknown\0"
    var l_fb: [u8; 14] = "framebuffer: \0"
    var l_bpp: [u8; 6] = " bpp=\0"
    var p: u64 = w_str(state, 0, (&l_bm[0]) as u64)
    if hwdiag.firmware_bios() {
        p = w_str(state, p, (&v_bios[0]) as u64)
    } else {
        p = w_str(state, p, (&v_uefi[0]) as u64)
    }
    p = w_nl(state, p)
    p = w_str(state, p, (&l_sb[0]) as u64)
    p = w_str(state, p, (&v_unk[0]) as u64)
    p = w_nl(state, p)
    p = w_str(state, p, (&l_fb[0]) as u64)
    p = w_num(state, p, gfx.fb_cols(state))
    p = w_ch(state, p, 120)
    p = w_num(state, p, gfx.fb_rows(state))
    p = w_str(state, p, (&l_bpp[0]) as u64)
    p = w_num(state, p, gfx.fb_bpp(state))
    return w_nl(state, p)
}

fn make_cgroup(state: u64) -> u64 {
    var z: [u8; 5] = "0::/\0"
    let p: u64 = w_str(state, 0, (&z[0]) as u64)
    return w_nl(state, p)
}

fn limit_line(state: u64, at: u64, label: u64, soft: u64, unit: u64) -> u64 {
    var p: u64 = w_str(state, at, label)
    p = w_num(state, p, soft)
    p = w_ch(state, p, 32)
    p = w_num(state, p, soft)
    p = w_ch(state, p, 32)
    p = w_str(state, p, unit)
    return w_nl(state, p)
}

fn make_limits(state: u64, t: u64) -> u64 {
    var h: [u8; 74] = "Limit                     Soft Limit           Hard Limit           Units\0"
    var l1: [u8; 27] = "Max open files            \0"
    var l2: [u8; 27] = "Max processes             \0"
    var l3: [u8; 27] = "Max stack size            \0"
    var u1: [u8; 6] = "files\0"
    var u2: [u8; 10] = "processes\0"
    var u3: [u8; 6] = "bytes\0"
    var p: u64 = w_str(state, 0, (&h[0]) as u64)
    p = w_nl(state, p)
    p = limit_line(state, p, (&l1[0]) as u64, file.MAX_FD, (&u1[0]) as u64)
    p = limit_line(state, p, (&l2[0]) as u64, kstate.MAX_TASKS, (&u2[0]) as u64)
    p = limit_line(state, p, (&l3[0]) as u64, 524288, (&u3[0]) as u64)
    return p
}

fn make_uuid_random(state: u64) -> u64 {
    // a random (version 4) UUID, new at every read: 16 bytes from the kernel generator
    let scratch: u64 = buf(state) + 4064
    rand.bytes(state, scratch, 16)
    kstate.set8(scratch + 6, ((kstate.get8(scratch + 6) & 15) | 64) as u8)
    kstate.set8(scratch + 8, ((kstate.get8(scratch + 8) & 63) | 128) as u8)
    var p: u64 = 0
    var i: u64 = 0
    while i < 16 {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            p = w_ch(state, p, 45)
        }
        p = w_hexb(state, p, kstate.get8(scratch + i))
        i = i + 1
    }
    return w_nl(state, p)
}

fn make_sys(state: u64, sub: u64) -> u64 {
    var p: u64 = 0
    if sub == S_PIDMAX {
        // pids are never reused here; the counter is 64 bit. The Linux default is shown.
        p = w_num(state, p, 4194304)
        return w_nl(state, p)
    }
    if sub == S_OVERCOMMIT {
        // mmap does not refuse by a commit estimate: that is mode 1 ("always")
        p = w_num(state, p, 1)
        return w_nl(state, p)
    }
    if sub == S_UUID {
        return make_uuid_random(state)
    }
    if sub == S_NETDEV {
        return make_netdev(state)
    }
    return 0
}

// /proc/net/dev: the one interface this kernel has. Packet counts are the
// stack's frame counters; byte counts are the card's octet counters;
// errors/drops are not counted anywhere, so they read 0 (the columns stay).
fn w_col(state: u64, at: u64, v: u64) -> u64 {
    var p: u64 = w_ch(state, at, 32)
    return w_num(state, p, v)
}

fn make_netdev(state: u64) -> u64 {
    var h1: [u8; 58] = "Inter-|   Receive                            |  Transmit\n\0"
    var h2: [u8; 118] = " face |bytes packets errs drop fifo frame compressed multicast|bytes packets errs drop fifo colls carrier compressed\n\0"
    var nm: [u8; 8] = "  eth0:\0"
    var p: u64 = w_str(state, 0, (&h1[0]) as u64)
    p = w_str(state, p, (&h2[0]) as u64)
    if !inet.ready(state) {
        return p
    }
    p = w_str(state, p, (&nm[0]) as u64)
    p = w_col(state, p, inet.card_octets(state, 1))
    p = w_col(state, p, inet.frames_in(state))
    var z: u64 = 0
    while z < 6 {
        p = w_col(state, p, 0)
        z = z + 1
    }
    p = w_col(state, p, inet.card_octets(state, 0))
    p = w_col(state, p, inet.frames_out(state))
    z = 0
    while z < 6 {
        p = w_col(state, p, 0)
        z = z + 1
    }
    return w_nl(state, p)
}

fn sys_is_dir(sub: u64) -> bool {
    return (sub >= S_SYS && sub <= S_RANDOM) || sub == S_NET
}

fn copy_z(out: u64, src: u64) {
    var i: u64 = 0
    while kstate.get8(src + i) != 0 {
        kstate.set8(out + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(out + i, 0 as u8)
}

fn sys_name(sub: u64, out: u64) {
    var n1: [u8; 4] = "sys\0"
    var n2: [u8; 7] = "kernel\0"
    var n3: [u8; 3] = "vm\0"
    var n4: [u8; 7] = "random\0"
    var n5: [u8; 8] = "pid_max\0"
    var n6: [u8; 18] = "overcommit_memory\0"
    var n7: [u8; 5] = "uuid\0"
    var n8: [u8; 4] = "net\0"
    var n9: [u8; 4] = "dev\0"
    if sub == S_KERNEL {
        copy_z(out, (&n2[0]) as u64)
    } else if sub == S_VM {
        copy_z(out, (&n3[0]) as u64)
    } else if sub == S_RANDOM {
        copy_z(out, (&n4[0]) as u64)
    } else if sub == S_PIDMAX {
        copy_z(out, (&n5[0]) as u64)
    } else if sub == S_OVERCOMMIT {
        copy_z(out, (&n6[0]) as u64)
    } else if sub == S_UUID {
        copy_z(out, (&n7[0]) as u64)
    } else if sub == S_NET {
        copy_z(out, (&n8[0]) as u64)
    } else if sub == S_NETDEV {
        copy_z(out, (&n9[0]) as u64)
    } else {
        copy_z(out, (&n1[0]) as u64)
    }
}

// the i-th child of directory `parent` (0 = none)
fn sys_nth(parent: u64, i: u64) -> u64 {
    if parent == S_SYS {
        if i == 0 {
            return S_KERNEL
        }
        if i == 1 {
            return S_VM
        }
        return 0
    }
    if parent == S_KERNEL {
        if i == 0 {
            return S_PIDMAX
        }
        if i == 1 {
            return S_RANDOM
        }
        return 0
    }
    if parent == S_VM && i == 0 {
        return S_OVERCOMMIT
    }
    if parent == S_RANDOM && i == 0 {
        return S_UUID
    }
    if parent == S_NET && i == 0 {
        return S_NETDEV
    }
    return 0
}

// the child of `parent` with the given name (0 = none)
fn sys_child(parent: u64, name: u64) -> u64 {
    var buf2: [u8; 24] = [0 as u8; 24]
    var i: u64 = 0
    while i < 4 {
        let c: u64 = sys_nth(parent, i)
        if c == 0 {
            return 0
        }
        sys_name(c, (&buf2[0]) as u64)
        if streq(name, (&buf2[0]) as u64) {
            return c
        }
        i = i + 1
    }
    return 0
}

fn build(state: u64, n: u64) -> u64 {
    let art: u64 = n_art(n)
    let slot: u64 = n_slot(n)
    let sub: u64 = n_sub(n)
    if art == K_SFS {
        return sfs_build(state, sub)
    }
    if art == K_GLOBAL {
        if sub == G_MEMINFO {
            return make_meminfo(state)
        }
        if sub == G_CPUINFO {
            return make_cpuinfo(state)
        }
        if sub == G_UPTIME {
            return make_uptime(state)
        }
        if sub == G_MOUNTS {
            return make_mounts(state)
        }
        if sub == G_STAT {
            return make_stat(state)
        }
        if sub == G_VERSION {
            return make_version(state)
        }
        if sub == G_HWID {
            return make_hwid(state)
        }
        if sub == G_KLOG {
            return make_klog(state)
        }
        if sub == G_LOADAVG {
            return make_loadavg(state)
        }
        if sub == G_PCI {
            return make_pci(state)
        }
        if sub == G_USB {
            return make_usb(state)
        }
        if sub == G_FIRMWARE {
            return make_firmware(state)
        }
        if sub == G_WLAN {
            return make_wlan(state)
        }
        if sub == G_USBNET {
            return make_usbnet(state)
        }
        if sub == G_APPS {
            return make_apps(state)
        }
        if sub == G_ODB {
            return make_odb(state)
        }
        if sub == G_ACPI {
            return acpidev.render(state, buf(state), BUF_MAX)
        }
        if sub == G_SAFE {
            return make_safe(state)
        }
        if sub == G_DMAR {
            return dmar.render(state, buf(state), BUF_MAX)
        }
        if sub == G_BACKLIGHT {
            return blchain.render(state, buf(state), BUF_MAX)
        }
        if sub == G_CPUS {
            return make_cpus(state)
        }
        if sub == G_HOTKEYS {
            hkdiag.set(hkdiag.I2CHID_DEVICES, i2chid.ndev())
            return hotkeys.render(state, buf(state), BUF_MAX)
        }
        if sub == G_INPUTDEVS {
            return i2chid.render(state, buf(state), BUF_MAX)
        }
        if sub == G_DRIVERS {
            return drvdev.render(state, buf(state), BUF_MAX)
        }
        if sub == G_BENCH {
            return make_bench(state)
        }
        if sub == G_FRAMES {
            return make_frames(state)
        }
        if sub == G_SYSMON {
            return make_sysmon(state)
        }
        if sub == G_GPU {
            return make_gpu(state)
        }
        return 0
    }
    if art == K_SYS {
        return make_sys(state, sub)
    }
    if art == K_PIDFILE {
        if !alive(state, slot) {
            return 0
        }
        if sub == F_STATUS {
            return make_status(state, slot)
        }
        if sub == F_STAT {
            return make_pstat(state, slot)
        }
        if sub == F_CMDLINE {
            return make_cmdline(state, slot)
        }
        if sub == F_MAPS {
            return make_maps(state, slot)
        }
        if sub == F_LIMITS {
            return make_limits(state, slot)
        }
        if sub == F_CGROUP {
            return make_cgroup(state)
        }
        if sub == F_EXE {
            return make_exe(state, slot)
        }
        if sub == F_CWD {
            return make_cwd(state, slot)
        }
        return 0
    }
    if art == K_FDFILE {
        if !alive(state, slot) {
            return 0
        }
        return make_fdfile(state, slot, sub)
    }
    return 0
}

// ------------------------------------------------------ die Verrichtungen

fn streq(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while kstate.get8(a + i) != 0 && kstate.get8(b + i) != 0 {
        if kstate.get8(a + i) != kstate.get8(b + i) {
            return false
        }
        i = i + 1
    }
    return kstate.get8(a + i) == kstate.get8(b + i)
}

// Ein Namensteil aus dem Pfad, ab `at`. Rueckgabe: die Stelle hinter
// ihm. `out` bekommt den Teil ohne Schraegstriche.
fn segment(path: u64, at: u64, out: u64, max: u64) -> u64 {
    var i: u64 = at
    while kstate.get8(path + i) == 47 {
        i = i + 1
    }
    var n: u64 = 0
    while kstate.get8(path + i) != 0 && kstate.get8(path + i) != 47 {
        if n + 1 < max {
            kstate.set8(out + n, kstate.get8(path + i) as u8)
            n = n + 1
        }
        i = i + 1
    }
    kstate.set8(out + n, 0 as u8)
    return i
}

fn to_num(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    if kstate.get8(p) == 0 {
        return 0xFFFFFFFF
    }
    while kstate.get8(p + i) != 0 {
        let c: u64 = kstate.get8(p + i)
        if c < 48 || c > 57 {
            return 0xFFFFFFFF
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

fn global_of(name: u64) -> u64 {
    var a: [u8; 8] = "meminfo\0"
    var b: [u8; 8] = "cpuinfo\0"
    var c: [u8; 7] = "uptime\0"
    var d: [u8; 7] = "mounts\0"
    var e: [u8; 5] = "stat\0"
    var f: [u8; 8] = "version\0"
    var g: [u8; 5] = "hwid\0"
    var k: [u8; 5] = "klog\0"
    var la: [u8; 8] = "loadavg\0"
    var gp: [u8; 4] = "pci\0"
    var gu: [u8; 4] = "usb\0"
    var gf: [u8; 9] = "firmware\0"
    var gw: [u8; 5] = "wlan\0"
    var gun: [u8; 7] = "usbnet\0"
    var ga: [u8; 5] = "apps\0"
    var go: [u8; 4] = "odb\0"
    var gb: [u8; 6] = "bench\0"
    var gfr: [u8; 7] = "frames\0"
    var gsf: [u8; 5] = "safe\0"
    var gdm: [u8; 5] = "dmar\0"
    var gdr: [u8; 8] = "drivers\0"
    var gbl: [u8; 10] = "backlight\0"
    var gcp: [u8; 5] = "cpus\0"
    var gid: [u8; 10] = "inputdevs\0"
    var ghk: [u8; 8] = "hotkeys\0"
    if streq(name, (&ghk[0]) as u64) {
        return G_HOTKEYS
    }
    if streq(name, (&gid[0]) as u64) {
        return G_INPUTDEVS
    }
    if streq(name, (&gcp[0]) as u64) {
        return G_CPUS
    }
    if streq(name, (&gdm[0]) as u64) {
        return G_DMAR
    }
    if streq(name, (&gdr[0]) as u64) {
        return G_DRIVERS
    }
    if streq(name, (&gbl[0]) as u64) {
        return G_BACKLIGHT
    }
    if streq(name, (&gsf[0]) as u64) {
        return G_SAFE
    }
    if streq(name, (&gfr[0]) as u64) {
        return G_FRAMES
    }
    var ggp: [u8; 4] = "gpu\0"
    if streq(name, (&ggp[0]) as u64) {
        return G_GPU
    }
    var gsm: [u8; 7] = "sysmon\0"
    if streq(name, (&gsm[0]) as u64) {
        return G_SYSMON
    }
    var gac: [u8; 5] = "acpi\0"
    if streq(name, (&gac[0]) as u64) {
        return G_ACPI
    }
    if streq(name, (&gb[0]) as u64) {
        return G_BENCH
    }
    if streq(name, (&go[0]) as u64) {
        return G_ODB
    }
    if streq(name, (&ga[0]) as u64) {
        return G_APPS
    }
    if streq(name, (&gp[0]) as u64) {
        return G_PCI
    }
    if streq(name, (&gu[0]) as u64) {
        return G_USB
    }
    if streq(name, (&gf[0]) as u64) {
        return G_FIRMWARE
    }
    if streq(name, (&gw[0]) as u64) {
        return G_WLAN
    }
    if streq(name, (&gun[0]) as u64) {
        return G_USBNET
    }
    if streq(name, (&la[0]) as u64) {
        return G_LOADAVG
    }
    if streq(name, (&a[0]) as u64) {
        return G_MEMINFO
    }
    if streq(name, (&k[0]) as u64) {
        return G_KLOG
    }
    if streq(name, (&g[0]) as u64) {
        return G_HWID
    }
    if streq(name, (&b[0]) as u64) {
        return G_CPUINFO
    }
    if streq(name, (&c[0]) as u64) {
        return G_UPTIME
    }
    if streq(name, (&d[0]) as u64) {
        return G_MOUNTS
    }
    if streq(name, (&e[0]) as u64) {
        return G_STAT
    }
    if streq(name, (&f[0]) as u64) {
        return G_VERSION
    }
    return 0
}

fn pidfile_of(name: u64) -> u64 {
    var a: [u8; 7] = "status\0"
    var b: [u8; 5] = "stat\0"
    var c: [u8; 8] = "cmdline\0"
    var d: [u8; 5] = "maps\0"
    var e: [u8; 3] = "fd\0"
    var lm: [u8; 7] = "limits\0"
    var cg: [u8; 7] = "cgroup\0"
    var ex: [u8; 4] = "exe\0"
    var cw: [u8; 4] = "cwd\0"
    if streq(name, (&ex[0]) as u64) {
        return F_EXE
    }
    if streq(name, (&cw[0]) as u64) {
        return F_CWD
    }
    if streq(name, (&lm[0]) as u64) {
        return F_LIMITS
    }
    if streq(name, (&cg[0]) as u64) {
        return F_CGROUP
    }
    if streq(name, (&a[0]) as u64) {
        return F_STATUS
    }
    if streq(name, (&b[0]) as u64) {
        return F_STAT
    }
    if streq(name, (&c[0]) as u64) {
        return F_CMDLINE
    }
    if streq(name, (&d[0]) as u64) {
        return F_MAPS
    }
    if streq(name, (&e[0]) as u64) {
        return F_FD
    }
    return 0
}

fn p_lookup(state: u64, m: u64, path: u64) -> u64 {
    tick(state)
    if mnt.dev(state, m) == 1 {
        return sfs_lookup(state, path)
    }
    var seg: [u8; 24] = [0 as u8; 24]
    var at: u64 = segment(path, 0, (&seg[0]) as u64, 24)
    if kstate.get8((&seg[0]) as u64) == 0 {
        return node(K_ROOT, 0, 0)
    }
    let g: u64 = global_of((&seg[0]) as u64)
    if g != 0 {
        // Ein globaler Name darf nichts hinter sich haben.
        var rest: [u8; 24] = [0 as u8; 24]
        segment(path, at, (&rest[0]) as u64, 24)
        if kstate.get8((&rest[0]) as u64) != 0 {
            return 0
        }
        return node(K_GLOBAL, 0, g)
    }
    // ROUND UNTERBAU: /proc/sys/<dir>/.../<file>
    var w_sys: [u8; 4] = "sys\0"
    var w_net: [u8; 4] = "net\0"
    let is_sys: bool = streq((&seg[0]) as u64, (&w_sys[0]) as u64)
    let is_net: bool = streq((&seg[0]) as u64, (&w_net[0]) as u64)
    if is_sys || is_net {
        var cur: u64 = S_SYS
        if is_net {
            cur = S_NET
        }
        var pos: u64 = at
        var guard: u64 = 0
        while guard < 6 {
            var sg: [u8; 24] = [0 as u8; 24]
            pos = segment(path, pos, (&sg[0]) as u64, 24)
            if kstate.get8((&sg[0]) as u64) == 0 {
                return node(K_SYS, 0, cur)
            }
            if !sys_is_dir(cur) {
                return 0
            }
            cur = sys_child(cur, (&sg[0]) as u64)
            if cur == 0 {
                return 0
            }
            guard = guard + 1
        }
        return 0
    }
    // ===================================== RUNDE CERTUS: `/proc/self`
    //
    // WARUM DIESER NAME FEHLTE UND WARUM ER DIE RUNDE AUFGEHALTEN HAT.
    //
    // Certus (der Browser) startete auf Osum, wurde geladen, kam in Ring
    // 3 an -- und gab sofort 90 zurueck. 90 ist in der Wurzeldatei des
    // Browsers die Zeile `if !gc_init() { return 90 }`.
    //
    // Der Sammler von Firn scannt den Stapel KONSERVATIV (SPEC 3.5.3):
    // er liest jedes Wort zwischen dem aktuellen Stapelzeiger und dem
    // BODEN des Stapels und behandelt alles, was wie ein Zeiger
    // aussieht, als eine Wurzel. Dafuer muss er wissen, wo der Boden
    // liegt -- und er kann es nicht selbst wissen, weil das
    // Betriebssystem den Stapel angelegt hat. Also fragt er danach, so
    // wie jede Laufzeit auf jedem Unix danach fragt:
    // `/proc/self/maps`, und wenn das nichts hergibt,
    // `/proc/self/stat` (`vendor/firn/lib/gc/gc.fi`,
    // `__gc_stack_bottom_maps` und `__gc_stack_bottom`).
    //
    // Dieses Dateisystem hatte `/proc/<pid>/maps` und
    // `/proc/<pid>/stat` seit Runde K11 -- aber `self` nicht, und ein
    // Prozess kennt seine eigene Nummer erst, wenn er `getpid` gerufen
    // hat. Ein Programm mit Sammler konnte hier also nicht starten, und
    // die Fehlermeldung dafuer war eine Zahl.
    //
    // `self` ist der laufende Prozess, und nichts weiter: dieselben
    // Dateien, dieselben Rechte, ein Name mehr. `sched.current` ist der
    // Platz, dem der Kern gerade gehoert -- und weil ein Systemaufruf
    // im Zusammenhang des Rufenden laeuft, ist das der Rufende.
    // (Runde CERTUS vom 28.08.2026, in Runde CERTUS-AUF-OSUM auf
    // `merge6` nachgezogen.)
    var w_self: [u8; 5] = "self\0"
    var slot: u64 = kstate.MAX_TASKS
    if streq((&seg[0]) as u64, (&w_self[0]) as u64) {
        slot = sched.current(state)
    } else {
        let pid: u64 = to_num((&seg[0]) as u64)
        if pid == 0xFFFFFFFF {
            return 0
        }
        slot = slot_of_pid(state, pid)
    }
    if slot >= kstate.MAX_TASKS {
        return 0
    }
    var seg2: [u8; 24] = [0 as u8; 24]
    at = segment(path, at, (&seg2[0]) as u64, 24)
    if kstate.get8((&seg2[0]) as u64) == 0 {
        return node(K_PIDDIR, slot, 0)
    }
    let f: u64 = pidfile_of((&seg2[0]) as u64)
    if f == 0 {
        return 0
    }
    var seg3: [u8; 24] = [0 as u8; 24]
    at = segment(path, at, (&seg3[0]) as u64, 24)
    if kstate.get8((&seg3[0]) as u64) == 0 {
        if f == F_FD {
            return node(K_FDDIR, slot, 0)
        }
        return node(K_PIDFILE, slot, f)
    }
    if f != F_FD {
        return 0
    }
    let fd: u64 = to_num((&seg3[0]) as u64)
    if fd >= file.MAX_FD {
        return 0
    }
    if file.fd_of(state, slot, fd) >= file.MAX_OPEN {
        return 0
    }
    return node(K_FDFILE, slot, fd)
}

fn dot_entry(state: u64, index: u64, out: u64) -> bool {
    if index == 0 {
        kstate.set8(out, 46 as u8)
        kstate.set8(out + 1, 0 as u8)
        return true
    }
    kstate.set8(out, 46 as u8)
    kstate.set8(out + 1, 46 as u8)
    kstate.set8(out + 2, 0 as u8)
    return true
}

fn global_name(state: u64, sub: u64, out: u64) {
    var a: [u8; 8] = "meminfo\0"
    var b: [u8; 8] = "cpuinfo\0"
    var c: [u8; 7] = "uptime\0"
    var d: [u8; 7] = "mounts\0"
    var e: [u8; 5] = "stat\0"
    var f: [u8; 8] = "version\0"
    var g: [u8; 5] = "hwid\0"
    var k: [u8; 5] = "klog\0"
    var la2: [u8; 8] = "loadavg\0"
    var sy2: [u8; 4] = "sys\0"
    var ne2: [u8; 4] = "net\0"
    var pc2: [u8; 4] = "pci\0"
    var us2: [u8; 4] = "usb\0"
    var fw2: [u8; 9] = "firmware\0"
    var wl2: [u8; 5] = "wlan\0"
    var un2: [u8; 7] = "usbnet\0"
    var ap2: [u8; 5] = "apps\0"
    var od2: [u8; 4] = "odb\0"
    var bn2: [u8; 6] = "bench\0"
    var fr2: [u8; 7] = "frames\0"
    var sm2: [u8; 7] = "sysmon\0"
    var ac2: [u8; 5] = "acpi\0"
    var gp2: [u8; 4] = "gpu\0"
    var sf2: [u8; 5] = "safe\0"
    var dm2: [u8; 5] = "dmar\0"
    var dr2: [u8; 8] = "drivers\0"
    var bl2: [u8; 10] = "backlight\0"
    var cp2: [u8; 5] = "cpus\0"
    var id2: [u8; 10] = "inputdevs\0"
    var hk2: [u8; 8] = "hotkeys\0"
    var src: u64 = (&a[0]) as u64
    if sub == G_HOTKEYS {
        src = (&hk2[0]) as u64
    } else if sub == G_INPUTDEVS {
        src = (&id2[0]) as u64
    } else if sub == G_CPUS {
        src = (&cp2[0]) as u64
    } else if sub == G_DMAR {
        src = (&dm2[0]) as u64
    } else if sub == G_BACKLIGHT {
        src = (&bl2[0]) as u64
    } else if sub == G_DRIVERS {
        src = (&dr2[0]) as u64
    } else if sub == G_GPU {
        src = (&gp2[0]) as u64
    } else if sub == G_SAFE {
        src = (&sf2[0]) as u64
    } else if sub == G_SYSMON {
        src = (&sm2[0]) as u64
    } else if sub == G_FRAMES {
        src = (&fr2[0]) as u64
    } else if sub == G_ACPI {
        src = (&ac2[0]) as u64
    } else if sub == G_BENCH {
        src = (&bn2[0]) as u64
    } else if sub == G_ODB {
        src = (&od2[0]) as u64
    } else if sub == G_APPS {
        src = (&ap2[0]) as u64
    } else if sub == G_PCI {
        src = (&pc2[0]) as u64
    } else if sub == G_USB {
        src = (&us2[0]) as u64
    } else if sub == G_FIRMWARE {
        src = (&fw2[0]) as u64
    } else if sub == G_WLAN {
        src = (&wl2[0]) as u64
    } else if sub == G_USBNET {
        src = (&un2[0]) as u64
    } else if sub == G_LOADAVG {
        src = (&la2[0]) as u64
    } else if sub == G_SYSDIR {
        src = (&sy2[0]) as u64
    } else if sub == G_NETDIR {
        src = (&ne2[0]) as u64
    } else if sub == G_CPUINFO {
        src = (&b[0]) as u64
    } else if sub == G_UPTIME {
        src = (&c[0]) as u64
    } else if sub == G_MOUNTS {
        src = (&d[0]) as u64
    } else if sub == G_STAT {
        src = (&e[0]) as u64
    } else if sub == G_VERSION {
        src = (&f[0]) as u64
    } else if sub == G_HWID {
        src = (&g[0]) as u64
    } else if sub == G_KLOG {
        src = (&k[0]) as u64
    }
    var i: u64 = 0
    while kstate.get8(src + i) != 0 {
        kstate.set8(out + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(out + i, 0 as u8)
}

fn pidfile_name(state: u64, sub: u64, out: u64) {
    var a: [u8; 7] = "status\0"
    var b: [u8; 5] = "stat\0"
    var c: [u8; 8] = "cmdline\0"
    var d: [u8; 5] = "maps\0"
    var e: [u8; 3] = "fd\0"
    var lm2: [u8; 7] = "limits\0"
    var cg2: [u8; 7] = "cgroup\0"
    var ex2: [u8; 4] = "exe\0"
    var cw2: [u8; 4] = "cwd\0"
    var src: u64 = (&a[0]) as u64
    if sub == F_EXE {
        src = (&ex2[0]) as u64
    } else if sub == F_CWD {
        src = (&cw2[0]) as u64
    } else if sub == F_LIMITS {
        src = (&lm2[0]) as u64
    } else if sub == F_CGROUP {
        src = (&cg2[0]) as u64
    } else if sub == F_STAT {
        src = (&b[0]) as u64
    } else if sub == F_CMDLINE {
        src = (&c[0]) as u64
    } else if sub == F_MAPS {
        src = (&d[0]) as u64
    } else if sub == F_FD {
        src = (&e[0]) as u64
    }
    var i: u64 = 0
    while kstate.get8(src + i) != 0 {
        kstate.set8(out + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(out + i, 0 as u8)
}

fn num_name(state: u64, v: u64, out: u64) {
    var digits: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        kstate.set8(out, 48 as u8)
        kstate.set8(out + 1, 0 as u8)
        return
    }
    while x > 0 {
        digits[n as usize] = ((x % 10) + 48) as u8
        x = x / 10
        n = n + 1
    }
    var k: u64 = 0
    while n > 0 {
        n = n - 1
        kstate.set8(out + k, digits[n as usize])
        k = k + 1
    }
    kstate.set8(out + k, 0 as u8)
}

fn p_readdir(state: u64, m: u64, dir: u64, index: u64, out: u64) -> u64 {
    tick(state)
    let art: u64 = n_art(dir)
    let slot: u64 = n_slot(dir)
    if index < 2 {
        dot_entry(state, index, out)
        return dir
    }
    let i: u64 = index - 2
    if art == K_SFS {
        return sfs_readdir(state, dir, i, out)
    }
    if art == K_ROOT {
        if i < G_LAST {
            global_name(state, i + 1, out)
            if i + 1 == G_SYSDIR {
                return node(K_SYS, 0, S_SYS)
            }
            if i + 1 == G_NETDIR {
                return node(K_SYS, 0, S_NET)
            }
            return node(K_GLOBAL, 0, i + 1)
        }
        // Dahinter die Prozesse, in der Reihenfolge der Aufgabentafel.
        var seen: u64 = 0
        var t: u64 = 0
        let n: u64 = kstate.get(state, kstate.TASKS)
        while t < n {
            if alive(state, t) {
                if seen == i - G_LAST {
                    num_name(state, sched.tget(state, t, sched.T_PID), out)
                    return node(K_PIDDIR, t, 0)
                }
                seen = seen + 1
            }
            t = t + 1
        }
        return 0
    }
    if art == K_PIDDIR {
        if i < F_LAST {
            pidfile_name(state, i + 1, out)
            if i + 1 == F_FD {
                return node(K_FDDIR, slot, 0)
            }
            return node(K_PIDFILE, slot, i + 1)
        }
        return 0
    }
    if art == K_SYS {
        let c: u64 = sys_nth(n_sub(dir), i)
        if c == 0 {
            return 0
        }
        sys_name(c, out)
        return node(K_SYS, 0, c)
    }
    if art == K_FDDIR {
        var seen: u64 = 0
        var fd: u64 = 0
        while fd < file.MAX_FD {
            if file.fd_of(state, slot, fd) < file.MAX_OPEN {
                if seen == i {
                    num_name(state, fd, out)
                    return node(K_FDFILE, slot, fd)
                }
                seen = seen + 1
            }
            fd = fd + 1
        }
        return 0
    }
    return 0
}

fn p_attr(state: u64, m: u64, n: u64, what: u64) -> u64 {
    tick(state)
    let art: u64 = n_art(n)
    if art == K_SFS {
        return sfs_attr(state, n, what)
    }
    if what == vfsops.A_TYPE {
        if art == K_ROOT || art == K_PIDDIR || art == K_FDDIR {
            return vfsops.N_DIR
        }
        if art == K_SYS {
            if sys_is_dir(n_sub(n)) {
                return vfsops.N_DIR
            }
            return vfsops.N_FILE
        }
        if art == K_PIDFILE && (n_sub(n) == F_EXE || n_sub(n) == F_CWD) {
            return vfsops.N_LNK
        }
        if art == K_GLOBAL || art == K_PIDFILE || art == K_FDFILE {
            return vfsops.N_FILE
        }
        return vfsops.N_NONE
    }
    if what == vfsops.A_SIZE {
        // EINE DATEI, DIE NIRGENDS LIEGT, HAT KEINE LAENGE, BIS MAN SIE
        // SCHREIBT. Also wird sie hier geschrieben und dann weggeworfen
        // -- das ist genau, was Linux tut, und der Grund, warum
        // `ls -l /proc` dort ueberall Nullen zeigt. Dieser Kernel sagt
        // die Wahrheit statt Null, und das kostet einen Aufbau.
        if art == K_ROOT || art == K_PIDDIR || art == K_FDDIR || (art == K_SYS && sys_is_dir(n_sub(n))) {
            return 0
        }
        let flags: u64 = lock(state)
        let len: u64 = build(state, n)
        unlock(state, flags)
        return len
    }
    if what == vfsops.A_MODE {
        if art == K_ROOT || art == K_PIDDIR || art == K_FDDIR || (art == K_SYS && sys_is_dir(n_sub(n))) {
            return 365 // 0o555 -- lesen und betreten, nicht schreiben
        }
        if art == K_PIDFILE && (n_sub(n) == F_EXE || n_sub(n) == F_CWD) {
            return 511 // 0o777: a symlink
        }
        return 292 // 0o444
    }
    if what == vfsops.A_NLINK {
        return 1
    }
    if what == vfsops.A_BLKSIZE {
        return 4096
    }
    return 0
}

fn lock(state: u64) -> u64 {
    let flags: u64 = sched.irq_save()
    atomic.lock_take(state, atomic.L_PROC, cpu.here(state))
    return flags
}

fn unlock(state: u64, flags: u64) {
    atomic.lock_give(state, atomic.L_PROC)
    sched.irq_restore(flags)
}

// ------------------------------------------------------------ /sys (LC-004)

fn sfs_ncpu(state: u64) -> u64 {
    let n: u64 = cpu.count(state)
    if n == 0 {
        return 1
    }
    return n
}

fn sfs_nonline(state: u64) -> u64 {
    let n: u64 = cpu.online_count(state)
    if n == 0 {
        return 1
    }
    return n
}

// CPUID leaf 4 (or AMD 0x8000001D), sub-leaf 0: type 0 means "no cache information" -- then index0 does not exist (nothing is invented).
fn sfs_cache_leaf(state: u64) -> u64 {
    if fpu.cpuid_a(0, 0) >= 4 && (fpu.cpuid_a(4, 0) & 31) != 0 {
        return 4 // Intel layout
    }
    // AMD: the same register layout under leaf 0x8000001D, offered when CPUID 0x80000001 ECX bit 22 (TOPOEXT) is set
    if fpu.cpuid_a(0x80000000, 0) >= 0x8000001D && ((fpu.cpuid_c(0x80000001, 0) >> 22) & 1) != 0 && (fpu.cpuid_a(0x8000001D, 0) & 31) != 0 {
        return 0x8000001D
    }
    return 0
}

fn sfs_cache_type(state: u64) -> u64 {
    let lf: u64 = sfs_cache_leaf(state)
    if lf == 0 {
        return 0
    }
    return fpu.cpuid_a(lf, 0) & 31
}

fn sfs_is_dir(sub: u64) -> bool {
    return sub == SF_ROOT || sub == SF_DEVICES || sub == SF_SYSTEM || sub == SF_CPU || sub == SF_CPUN || sub == SF_CACHE || sub == SF_IDX0
}

// number of children of directory node (sub, slot)
fn sfs_count(state: u64, sub: u64) -> u64 {
    if sub == SF_ROOT || sub == SF_DEVICES || sub == SF_SYSTEM {
        return 1
    }
    if sub == SF_CPU {
        return 3 + sfs_ncpu(state)
    }
    if sub == SF_CPUN {
        return 1
    }
    if sub == SF_CACHE {
        if sfs_cache_type(state) == 0 {
            return 0
        }
        return 1
    }
    if sub == SF_IDX0 {
        return 6
    }
    return 0
}

// the i-th child (node), 0 = none
fn sfs_child(state: u64, sub: u64, slot: u64, i: u64) -> u64 {
    if i >= sfs_count(state, sub) {
        return 0
    }
    if sub == SF_ROOT {
        return node(K_SFS, 0, SF_DEVICES)
    }
    if sub == SF_DEVICES {
        return node(K_SFS, 0, SF_SYSTEM)
    }
    if sub == SF_SYSTEM {
        return node(K_SFS, 0, SF_CPU)
    }
    if sub == SF_CPU {
        if i < 3 {
            return node(K_SFS, 0, SF_ONLINE + i)
        }
        return node(K_SFS, i - 3, SF_CPUN)
    }
    if sub == SF_CPUN {
        return node(K_SFS, slot, SF_CACHE)
    }
    if sub == SF_CACHE {
        return node(K_SFS, slot, SF_IDX0)
    }
    if sub == SF_IDX0 {
        return node(K_SFS, slot, SF_C_LEVEL + i)
    }
    return 0
}

fn sfs_name(state: u64, n: u64, out: u64) {
    var a1: [u8; 8] = "devices\0"
    var a2: [u8; 7] = "system\0"
    var a3: [u8; 4] = "cpu\0"
    var a4: [u8; 7] = "online\0"
    var a5: [u8; 9] = "possible\0"
    var a6: [u8; 8] = "present\0"
    var a7: [u8; 6] = "cache\0"
    var a8: [u8; 7] = "index0\0"
    var a9: [u8; 6] = "level\0"
    var a10: [u8; 5] = "type\0"
    var a11: [u8; 5] = "size\0"
    var a12: [u8; 20] = "coherency_line_size\0"
    var a13: [u8; 15] = "number_of_sets\0"
    var a14: [u8; 22] = "ways_of_associativity\0"
    let sub: u64 = n_sub(n)
    if sub == SF_DEVICES {
        copy_z(out, (&a1[0]) as u64)
    } else if sub == SF_SYSTEM {
        copy_z(out, (&a2[0]) as u64)
    } else if sub == SF_CPU {
        copy_z(out, (&a3[0]) as u64)
    } else if sub == SF_ONLINE {
        copy_z(out, (&a4[0]) as u64)
    } else if sub == SF_POSSIBLE {
        copy_z(out, (&a5[0]) as u64)
    } else if sub == SF_PRESENT {
        copy_z(out, (&a6[0]) as u64)
    } else if sub == SF_CPUN {
        kstate.set8(out, 99 as u8)
        kstate.set8(out + 1, 112 as u8)
        kstate.set8(out + 2, 117 as u8)
        num_name(state, n_slot(n), out + 3)
    } else if sub == SF_CACHE {
        copy_z(out, (&a7[0]) as u64)
    } else if sub == SF_IDX0 {
        copy_z(out, (&a8[0]) as u64)
    } else if sub == SF_C_LEVEL {
        copy_z(out, (&a9[0]) as u64)
    } else if sub == SF_C_TYPE {
        copy_z(out, (&a10[0]) as u64)
    } else if sub == SF_C_SIZE {
        copy_z(out, (&a11[0]) as u64)
    } else if sub == SF_C_LINE {
        copy_z(out, (&a12[0]) as u64)
    } else if sub == SF_C_SETS {
        copy_z(out, (&a13[0]) as u64)
    } else if sub == SF_C_WAYS {
        copy_z(out, (&a14[0]) as u64)
    } else {
        kstate.set8(out, 0 as u8)
    }
}

fn sfs_lookup(state: u64, path: u64) -> u64 {
    var seg: [u8; 32] = [0 as u8; 32]
    var nm: [u8; 32] = [0 as u8; 32]
    var cur: u64 = node(K_SFS, 0, SF_ROOT)
    var at: u64 = 0
    var guard: u64 = 0
    while guard < 8 {
        at = segment(path, at, (&seg[0]) as u64, 32)
        if kstate.get8((&seg[0]) as u64) == 0 {
            return cur
        }
        if !sfs_is_dir(n_sub(cur)) {
            return 0
        }
        var found: u64 = 0
        var i: u64 = 0
        let cnt: u64 = sfs_count(state, n_sub(cur))
        while i < cnt && found == 0 {
            let c: u64 = sfs_child(state, n_sub(cur), n_slot(cur), i)
            sfs_name(state, c, (&nm[0]) as u64)
            if streq((&seg[0]) as u64, (&nm[0]) as u64) {
                found = c
            }
            i = i + 1
        }
        if found == 0 {
            return 0
        }
        cur = found
        guard = guard + 1
    }
    return 0
}

fn sfs_readdir(state: u64, dir: u64, i: u64, out: u64) -> u64 {
    let c: u64 = sfs_child(state, n_sub(dir), n_slot(dir), i)
    if c == 0 {
        return 0
    }
    sfs_name(state, c, out)
    return c
}

fn sfs_attr(state: u64, n: u64, what: u64) -> u64 {
    let sub: u64 = n_sub(n)
    if what == vfsops.A_TYPE {
        if sfs_is_dir(sub) {
            return vfsops.N_DIR
        }
        return vfsops.N_FILE
    }
    if what == vfsops.A_SIZE {
        if sfs_is_dir(sub) {
            return 0
        }
        let flags: u64 = lock(state)
        let len: u64 = build(state, n)
        unlock(state, flags)
        return len
    }
    if what == vfsops.A_MODE {
        if sfs_is_dir(sub) {
            return 365 // 0o555
        }
        return 292 // 0o444
    }
    if what == vfsops.A_NLINK {
        return 1
    }
    if what == vfsops.A_BLKSIZE {
        return 4096
    }
    return 0
}

// "0" for one CPU, "0-N" for N+1
fn sfs_range(state: u64, n: u64) -> u64 {
    var p: u64 = w_num(state, 0, 0)
    if n > 1 {
        p = w_ch(state, p, 45)
        p = w_num(state, p, n - 1)
    }
    return w_nl(state, p)
}

fn sfs_build(state: u64, sub: u64) -> u64 {
    var p: u64 = 0
    if sub == SF_ONLINE {
        return sfs_range(state, sfs_nonline(state))
    }
    if sub == SF_POSSIBLE || sub == SF_PRESENT {
        return sfs_range(state, sfs_ncpu(state))
    }
    let lf: u64 = sfs_cache_leaf(state)
    let a: u64 = fpu.cpuid_a(lf, 0)
    let b: u64 = fpu.cpuid_b(lf, 0)
    let c: u64 = fpu.cpuid_c(lf, 0)
    let ways: u64 = (b >> 22) + 1
    let parts: u64 = ((b >> 12) & 1023) + 1
    let line: u64 = (b & 4095) + 1
    let sets: u64 = c + 1
    if sub == SF_C_LEVEL {
        p = w_num(state, p, (a >> 5) & 7)
        return w_nl(state, p)
    }
    if sub == SF_C_TYPE {
        var t1: [u8; 5] = "Data\0"
        var t2: [u8; 12] = "Instruction\0"
        var t3: [u8; 8] = "Unified\0"
        let ty: u64 = a & 31
        if ty == 1 {
            p = w_str(state, p, (&t1[0]) as u64)
        } else if ty == 2 {
            p = w_str(state, p, (&t2[0]) as u64)
        } else {
            p = w_str(state, p, (&t3[0]) as u64)
        }
        return w_nl(state, p)
    }
    if sub == SF_C_SIZE {
        p = w_num(state, p, ways * parts * line * sets / 1024)
        p = w_ch(state, p, 75)
        return w_nl(state, p)
    }
    if sub == SF_C_LINE {
        p = w_num(state, p, line)
        return w_nl(state, p)
    }
    if sub == SF_C_SETS {
        p = w_num(state, p, sets)
        return w_nl(state, p)
    }
    if sub == SF_C_WAYS {
        p = w_num(state, p, ways)
        return w_nl(state, p)
    }
    return 0
}

fn p_read(state: u64, m: u64, n: u64, off: u64, dst: u64, len: u64) -> u64 {
    tick(state)
    let flags: u64 = lock(state)
    let have: u64 = build(state, n)
    if off >= have {
        unlock(state, flags)
        return 0
    }
    var want: u64 = len
    if off + want > have {
        want = have - off
    }
    var i: u64 = 0
    while i < want {
        kstate.set8(dst + i, kstate.get8(buf(state) + off + i) as u8)
        i = i + 1
    }
    unlock(state, flags)
    return want
}

fn p_write(state: u64, m: u64, n: u64, off: u64, src: u64,
    len: u64) -> u64 {
    tick(state)
    return 0
}

fn p_create(state: u64, m: u64, path: u64, art: u64) -> u64 {
    tick(state)
    return 0
}

fn p_unlink(state: u64, m: u64, path: u64) -> u64 {
    tick(state)
    return 1 // EPERM
}

fn p_rename(state: u64, m: u64, from: u64, to: u64) -> u64 {
    tick(state)
    return 1
}

fn p_trunc(state: u64, m: u64, n: u64) -> u64 {
    tick(state)
    return 30 // EROFS
}

// Die Tafel. VIER Bits, und kein einziges davon schreibt: /proc ist ein
// Fenster in den Kernel und keine Tuer.
fn ops() -> vfsops.Ops {
    return vfsops.Ops {
        lookup: p_lookup,
        readdir: p_readdir,
        attr: p_attr,
        read: p_read,
        write: p_write,
        create: p_create,
        unlink: p_unlink,
        rename: p_rename,
        trunc: p_trunc,
        mask: vfsops.OP_READONLY,
        tag: 1668248176 // "proc"
    }
}
