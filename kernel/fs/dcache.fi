profile kernel

import lib.kstate
import fs.cachelock

export { attach, FRAMES, PATH_MAX, FNV_OFFSET, Key, key_of, extend, dot_follows, probe_key, insert_key, note_skip, SKIP_NONE, SKIP_LONG, SKIP_DOT, probe, insert, stamp, bump, bump_add, forget_node, forget_name, hits, misses, negative_hits, inserts, flushes, skipped_long, skipped_dot, kind_count, stale, evictions, MISS, NEG }

const MISS: u64 = 0xFFFFFFFFFFFFFFFF
const NEG: u64 = 0xFFFFFFFFFFFFFFFE
const NODE_LIMIT: u64 = 0x4000000000000000
const WAYS: u64 = 4
const SETS: u64 = 512
const ENTRY_BYTES: u64 = 128
const ENTRIES_AT: u64 = 4096
const ENTRY_COUNT: u64 = SETS * WAYS
const NODESNAP_AT: u64 = ENTRIES_AT + ENTRY_COUNT * ENTRY_BYTES
const TAGSNAP_AT: u64 = NODESNAP_AT + ENTRY_COUNT * 8
const BUCKETS: u64 = 512
const NODEGEN_AT: u64 = TAGSNAP_AT + ENTRY_COUNT * 8
const TAGGEN_AT: u64 = NODEGEN_AT + BUCKETS * 8
const FRAMES: u64 = 75
const PATH_AT: u64 = 40
const PATH_MAX: u64 = 87
const H_GEN: u64 = 8
const H_EPOCH: u64 = 16
const H_HITS: u64 = 24
const H_MISSES: u64 = 32
const H_NEGHITS: u64 = 40
const H_INSERTS: u64 = 48
const H_FLUSHES: u64 = 56
const H_VICTIM: u64 = 64
const H_NEG_GEN: u64 = 72
const H_SKIP_LONG: u64 = 80
const H_SKIP_DOT: u64 = 88
const H_STALE: u64 = 96
const H_EVICT: u64 = 104
const H_KIND_AT: u64 = 112
const E_GEN: u64 = 0
const E_MOUNT: u64 = 8
const E_NODE: u64 = 16
const E_NEG: u64 = 24
const E_HASH: u64 = 32
const FNV_OFFSET: u64 = 0xCBF29CE484222325
const FNV_PRIME: u64 = 0x100000001B3
const SKIP_NONE: u64 = 0
const SKIP_LONG: u64 = 1
const SKIP_DOT: u64 = 2

struct Key {
    hash: u64,
    len: u64,
    skip: u64,
}

fn attach(state: u64, region: u64) {
    var o: u64 = 0
    while o < FRAMES * 4096 {
        kstate.set(region, o, 0)
        o = o + 8
    }
    kstate.set(region, H_GEN, 1)
    kstate.set(region, H_NEG_GEN, 1)
    kstate.set(state, kstate.DCACHE_BASE, region)
}

fn enabled(state: u64) -> bool {
    return !kstate.mode_on(state, kstate.M_NODCACHE)
}

fn path_len(path: u64) -> u64 {
    var n: u64 = 0
    while kstate.get8(path + n) != 0 && n <= PATH_MAX {
        n = n + 1
    }
    return n
}

fn dot_component_end(c: u64) -> bool {
    return c == 0 || c == 47
}

fn dot_follows(p: u64) -> bool {
    if kstate.get8(p) != 46 {
        return false
    }
    let c1: u64 = kstate.get8(p + 1)
    if dot_component_end(c1) {
        return true
    }
    return c1 == 46 && dot_component_end(kstate.get8(p + 2))
}

fn key_of(m: u64, path: u64) -> Key {
    var h: u64 = FNV_OFFSET ^ m
    var n: u64 = 0
    var skip: u64 = SKIP_NONE
    var c: u64 = kstate.get8(path)
    while c != 0 && n <= PATH_MAX {
        if c == 47 && dot_follows(path + n + 1) {
            skip = SKIP_DOT
        }
        h = (h ^ c) *% FNV_PRIME
        n = n + 1
        c = kstate.get8(path + n)
    }
    if n > PATH_MAX {
        skip = SKIP_LONG
    }
    return Key { hash: h, len: n, skip: skip }
}

fn extend(hash: u64, c: u64) -> u64 {
    return (hash ^ c) *% FNV_PRIME
}

fn leaf_tag(path: u64, n: u64) -> u64 {
    var start: u64 = 0
    var i: u64 = 0
    while i < n {
        if kstate.get8(path + i) == 47 {
            start = i + 1
        }
        i = i + 1
    }
    var h: u64 = FNV_OFFSET
    i = start
    while i < n {
        h = (h ^ kstate.get8(path + i)) *% FNV_PRIME
        i = i + 1
    }
    return h | 1
}

fn path_same(entry: u64, path: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get8(entry + PATH_AT + i) != kstate.get8(path + i) {
            return false
        }
        i = i + 1
    }
    return kstate.get8(entry + PATH_AT + n) == 0
}

fn entry_index(b: u64, e: u64) -> u64 {
    return (e - b - ENTRIES_AT) >> 7
}

fn node_gen(b: u64, node: u64) -> u64 {
    return kstate.get(b, NODEGEN_AT + (node % BUCKETS) * 8)
}

fn tag_gen(b: u64, tag: u64) -> u64 {
    return kstate.get(b, TAGGEN_AT + ((tag >> 1) % BUCKETS) * 8)
}

fn entry_live(b: u64, e: u64, gen: u64, neg_gen: u64) -> bool {
    let tag: u64 = kstate.get(e, E_NEG)
    let idx: u64 = entry_index(b, e)
    if tag != 0 {
        return kstate.get(e, E_GEN) == neg_gen && kstate.get(b, TAGSNAP_AT + idx * 8) == tag_gen(b, tag)
    }
    return kstate.get(e, E_GEN) == gen && kstate.get(b, NODESNAP_AT + idx * 8) == node_gen(b, kstate.get(e, E_NODE))
}

fn slot_at(b: u64, h: u64, way: u64) -> u64 {
    return b + ENTRIES_AT + (((h >> 7) % SETS) * WAYS + way) * ENTRY_BYTES
}

fn note_skip(state: u64, skip: u64) {
    let b: u64 = kstate.get(state, kstate.DCACHE_BASE)
    if b == 0 {
        return
    }
    if skip == SKIP_LONG {
        kstate.set(b, H_SKIP_LONG, kstate.get(b, H_SKIP_LONG) + 1)
    } else if skip == SKIP_DOT {
        kstate.set(b, H_SKIP_DOT, kstate.get(b, H_SKIP_DOT) + 1)
    }
}

fn probe(state: u64, m: u64, path: u64) -> u64 {
    if !enabled(state) {
        return MISS
    }
    return probe_key(state, m, path, key_of(m, path))
}

fn probe_key(state: u64, m: u64, path: u64, k: Key) -> u64 {
    if !enabled(state) {
        return MISS
    }
    let b: u64 = kstate.get(state, kstate.DCACHE_BASE)
    if b == 0 {
        return MISS
    }
    if k.skip != SKIP_NONE {
        note_skip(state, k.skip)
        return MISS
    }
    let h: u64 = k.hash
    let n: u64 = k.len
    let flags: u64 = cachelock.take(b)
    let gen: u64 = kstate.get(b, H_GEN)
    let neg_gen: u64 = kstate.get(b, H_NEG_GEN)
    var way: u64 = 0
    while way < WAYS {
        let e: u64 = slot_at(b, h, way)
        if kstate.get(e, E_HASH) == h && kstate.get(e, E_MOUNT) == m && path_same(e, path, n) {
            if !entry_live(b, e, gen, neg_gen) {
                kstate.set(b, H_STALE, kstate.get(b, H_STALE) + 1)
            } else {
                var r: u64 = kstate.get(e, E_NODE)
                kstate.set(b, H_HITS, kstate.get(b, H_HITS) + 1)
                if kstate.get(e, E_NEG) != 0 {
                    r = NEG
                    kstate.set(b, H_NEGHITS, kstate.get(b, H_NEGHITS) + 1)
                }
                cachelock.give(b, flags)
                return r
            }
        }
        way = way + 1
    }
    kstate.set(b, H_MISSES, kstate.get(b, H_MISSES) + 1)
    cachelock.give(b, flags)
    return MISS
}

fn stamp(state: u64) -> u64 {
    let b: u64 = kstate.get(state, kstate.DCACHE_BASE)
    if b == 0 {
        return 0
    }
    return kstate.get(b, H_EPOCH)
}

fn insert(state: u64, m: u64, path: u64, node: u64, stamp_at_start: u64) {
    insert_key(state, m, path, key_of(m, path), node, stamp_at_start)
}

fn insert_key(state: u64, m: u64, path: u64, k: Key, node: u64, stamp_at_start: u64) {
    if !enabled(state) || node >= NODE_LIMIT || k.skip != SKIP_NONE {
        return
    }
    let b: u64 = kstate.get(state, kstate.DCACHE_BASE)
    if b == 0 {
        return
    }
    let h: u64 = k.hash
    let n: u64 = k.len
    let flags: u64 = cachelock.take(b)
    if kstate.get(b, H_EPOCH) != stamp_at_start {
        cachelock.give(b, flags)
        return
    }
    let gen: u64 = kstate.get(b, H_GEN)
    let neg_gen: u64 = kstate.get(b, H_NEG_GEN)
    var pick: u64 = 0
    var way: u64 = 0
    while way < WAYS {
        let e: u64 = slot_at(b, h, way)
        if entry_live(b, e, gen, neg_gen) && kstate.get(e, E_HASH) == h && kstate.get(e, E_MOUNT) == m && path_same(e, path, n) {
            pick = e
        }
        way = way + 1
    }
    way = 0
    while pick == 0 && way < WAYS {
        let e: u64 = slot_at(b, h, way)
        if !entry_live(b, e, gen, neg_gen) {
            pick = e
        }
        way = way + 1
    }
    if pick == 0 {
        kstate.set(b, H_EVICT, kstate.get(b, H_EVICT) + 1)
        let v: u64 = kstate.get(b, H_VICTIM)
        kstate.set(b, H_VICTIM, v + 1)
        pick = slot_at(b, h, v % WAYS)
    }
    kstate.set(pick, E_MOUNT, m)
    kstate.set(pick, E_HASH, h)
    let idx: u64 = (pick - b - ENTRIES_AT) / ENTRY_BYTES
    if node == 0 {
        let tag: u64 = leaf_tag(path, n)
        kstate.set(pick, E_GEN, neg_gen)
        kstate.set(pick, E_NEG, tag)
        kstate.set(pick, E_NODE, 0)
        kstate.set(b, TAGSNAP_AT + idx * 8, tag_gen(b, tag))
    } else {
        kstate.set(pick, E_GEN, gen)
        kstate.set(pick, E_NEG, 0)
        kstate.set(pick, E_NODE, node)
        kstate.set(b, NODESNAP_AT + idx * 8, node_gen(b, node))
    }
    var i: u64 = 0
    while i < n {
        kstate.set8(pick + PATH_AT + i, kstate.get8(path + i) as u8)
        i = i + 1
    }
    kstate.set8(pick + PATH_AT + n, 0 as u8)
    kstate.set(b, H_INSERTS, kstate.get(b, H_INSERTS) + 1)
    cachelock.give(b, flags)
}

fn bump(state: u64) {
    if kstate.mode_on(state, kstate.M_DCNOINVAL) {
        return
    }
    let b: u64 = kstate.get(state, kstate.DCACHE_BASE)
    if b == 0 {
        return
    }
    count_kind(b, 0)
    let flags: u64 = cachelock.take(b)
    kstate.set(b, H_GEN, kstate.get(b, H_GEN) + 1)
    kstate.set(b, H_NEG_GEN, kstate.get(b, H_NEG_GEN) + 1)
    kstate.set(b, H_EPOCH, kstate.get(b, H_EPOCH) + 1)
    kstate.set(b, H_FLUSHES, kstate.get(b, H_FLUSHES) + 1)
    cachelock.give(b, flags)
}

fn bump_add(state: u64) {
    if kstate.mode_on(state, kstate.M_DCNOINVAL) {
        return
    }
    let b: u64 = kstate.get(state, kstate.DCACHE_BASE)
    if b == 0 {
        return
    }
    count_kind(b, 1)
    let flags: u64 = cachelock.take(b)
    kstate.set(b, H_NEG_GEN, kstate.get(b, H_NEG_GEN) + 1)
    kstate.set(b, H_EPOCH, kstate.get(b, H_EPOCH) + 1)
    kstate.set(b, H_FLUSHES, kstate.get(b, H_FLUSHES) + 1)
    cachelock.give(b, flags)
}

fn forget_node(state: u64, node: u64) {
    if kstate.mode_on(state, kstate.M_DCNOINVAL) {
        return
    }
    let b: u64 = kstate.get(state, kstate.DCACHE_BASE)
    if b == 0 {
        return
    }
    count_kind(b, 2)
    let flags: u64 = cachelock.take(b)
    kstate.set(b, NODEGEN_AT + (node % BUCKETS) * 8, node_gen(b, node) + 1)
    kstate.set(b, H_EPOCH, kstate.get(b, H_EPOCH) + 1)
    kstate.set(b, H_FLUSHES, kstate.get(b, H_FLUSHES) + 1)
    cachelock.give(b, flags)
}

fn hits(state: u64) -> u64 {
    return cachelock.field(state, kstate.DCACHE_BASE, H_HITS)
}

fn misses(state: u64) -> u64 {
    return cachelock.field(state, kstate.DCACHE_BASE, H_MISSES)
}

fn negative_hits(state: u64) -> u64 {
    return cachelock.field(state, kstate.DCACHE_BASE, H_NEGHITS)
}

fn inserts(state: u64) -> u64 {
    return cachelock.field(state, kstate.DCACHE_BASE, H_INSERTS)
}

fn flushes(state: u64) -> u64 {
    return cachelock.field(state, kstate.DCACHE_BASE, H_FLUSHES)
}

fn skipped_long(state: u64) -> u64 {
    return cachelock.field(state, kstate.DCACHE_BASE, H_SKIP_LONG)
}

fn skipped_dot(state: u64) -> u64 {
    return cachelock.field(state, kstate.DCACHE_BASE, H_SKIP_DOT)
}

fn stale(state: u64) -> u64 {
    return cachelock.field(state, kstate.DCACHE_BASE, H_STALE)
}

fn evictions(state: u64) -> u64 {
    return cachelock.field(state, kstate.DCACHE_BASE, H_EVICT)
}

fn forget_name(state: u64, name: u64) {
    if kstate.mode_on(state, kstate.M_DCNOINVAL) {
        return
    }
    let b: u64 = kstate.get(state, kstate.DCACHE_BASE)
    if b == 0 {
        return
    }
    let n: u64 = path_len(name)
    let tag: u64 = leaf_tag(name, n)
    count_kind(b, 3)
    let flags: u64 = cachelock.take(b)
    kstate.set(b, TAGGEN_AT + ((tag >> 1) % BUCKETS) * 8, tag_gen(b, tag) + 1)
    kstate.set(b, H_EPOCH, kstate.get(b, H_EPOCH) + 1)
    kstate.set(b, H_FLUSHES, kstate.get(b, H_FLUSHES) + 1)
    cachelock.give(b, flags)
}

fn count_kind(b: u64, k: u64) {
    kstate.set(b, H_KIND_AT + k * 8, kstate.get(b, H_KIND_AT + k * 8) + 1)
}

fn kind_count(state: u64, k: u64) -> u64 {
    return cachelock.field(state, kstate.DCACHE_BASE, H_KIND_AT + k * 8)
}
