profile kernel

import lib.kstate
import lib.procw
import sched.susp
import net.netdev
import usb.usb
import pwr.s3rec
import libc.numeric

export { render }

const HEX4: u64 = 4
const HEX8: u64 = 8

static mut k_version: [u8; 10] = "version 1\0"
static mut k_s3: [u8; 3] = "s3\0"
static mut k_why: [u8; 4] = "why\0"
static mut k_why_text: [u8; 9] = "why_text\0"
static mut k_slp_typ_a: [u8; 10] = "slp_typ_a\0"
static mut k_slp_typ_b: [u8; 10] = "slp_typ_b\0"
static mut k_fadt: [u8; 5] = "fadt\0"
static mut k_facs: [u8; 5] = "facs\0"
static mut k_pm1a: [u8; 5] = "pm1a\0"
static mut k_wake_sts: [u8; 9] = "wake_sts\0"
static mut k_now_uplink_kind: [u8; 16] = "now_uplink_kind\0"
static mut k_now_usbnet_ready: [u8; 17] = "now_usbnet_ready\0"
static mut k_now_net_up: [u8; 11] = "now_net_up\0"
static mut k_now_usb_devices: [u8; 16] = "now_usb_devices\0"
static mut k_attempts: [u8; 9] = "attempts\0"
static mut k_cycles: [u8; 7] = "cycles\0"
static mut k_result: [u8; 7] = "result\0"
static mut k_rtc_secs: [u8; 9] = "rtc_secs\0"
static mut k_rtc_armed: [u8; 10] = "rtc_armed\0"
static mut k_slept_s: [u8; 8] = "slept_s\0"
static mut k_duration_ms: [u8; 12] = "duration_ms\0"
static mut k_cores_before: [u8; 13] = "cores_before\0"
static mut k_cores_after: [u8; 12] = "cores_after\0"
static mut k_nvme_resume: [u8; 12] = "nvme_resume\0"
static mut k_ahci_resume: [u8; 12] = "ahci_resume\0"
static mut k_usb_resume: [u8; 11] = "usb_resume\0"
static mut k_usb_devices: [u8; 12] = "usb_devices\0"
static mut k_usb_kbd: [u8; 8] = "usb_kbd\0"
static mut k_net_cards: [u8; 10] = "net_cards\0"
static mut k_net_resumed: [u8; 12] = "net_resumed\0"
static mut k_net_up: [u8; 7] = "net_up\0"
static mut k_hda_resume: [u8; 11] = "hda_resume\0"
static mut k_usbnet_up: [u8; 10] = "usbnet_up\0"
static mut k_uplink_kind: [u8; 12] = "uplink_kind\0"
static mut k_pci_lost: [u8; 9] = "pci_lost\0"
static mut k_pci_bad: [u8; 8] = "pci_bad\0"
static mut k_image_back: [u8; 11] = "image_back\0"


fn cell(key: u64, index: u64) {
    procw.line_num(key, s3rec.get(index))
}

fn render(state: u64, out: u64, cap: u64) -> u64 {
    procw.begin(out, cap)
    if !susp.ready(state) {
        susp.measure(state)
    }
    procw.put_s((&k_version[0]) as u64)
    procw.put_c(10)
    procw.line_num((&k_s3[0]) as u64, numeric.yes(susp.s3_ok(state)))
    procw.line_num((&k_why[0]) as u64, susp.why(state))
    procw.line_text((&k_why_text[0]) as u64, susp.why_text(susp.why(state)))
    procw.line_num((&k_slp_typ_a[0]) as u64, susp.s3_a(state))
    procw.line_num((&k_slp_typ_b[0]) as u64, susp.s3_b(state))
    procw.line_hex((&k_fadt[0]) as u64, susp.fadt(state), HEX8)
    procw.line_hex((&k_facs[0]) as u64, susp.facs(state), HEX8)
    procw.line_hex((&k_pm1a[0]) as u64, susp.pm1a(state), HEX4)
    procw.line_hex((&k_wake_sts[0]) as u64, s3rec.get(s3rec.WAKE_STS), HEX4)
    cell((&k_attempts[0]) as u64, s3rec.ATTEMPTS)
    cell((&k_cycles[0]) as u64, s3rec.CYCLES)
    cell((&k_result[0]) as u64, s3rec.RESULT)
    cell((&k_rtc_secs[0]) as u64, s3rec.RTC_SECS)
    cell((&k_rtc_armed[0]) as u64, s3rec.RTC_ARMED)
    cell((&k_slept_s[0]) as u64, s3rec.SLEPT_S)
    cell((&k_duration_ms[0]) as u64, s3rec.DURATION_MS)
    cell((&k_cores_before[0]) as u64, s3rec.CORES_BEFORE)
    cell((&k_cores_after[0]) as u64, s3rec.CORES_AFTER)
    cell((&k_nvme_resume[0]) as u64, s3rec.NVME_RESUME)
    cell((&k_ahci_resume[0]) as u64, s3rec.AHCI_RESUME)
    cell((&k_usb_resume[0]) as u64, s3rec.USB_RESUME)
    cell((&k_usb_devices[0]) as u64, s3rec.USB_DEVICES)
    cell((&k_usb_kbd[0]) as u64, s3rec.USB_KBD)
    cell((&k_net_cards[0]) as u64, s3rec.NET_CARDS)
    cell((&k_net_resumed[0]) as u64, s3rec.NET_RESUMED)
    cell((&k_net_up[0]) as u64, s3rec.NET_UP)
    cell((&k_hda_resume[0]) as u64, s3rec.HDA_RESUME)
    cell((&k_usbnet_up[0]) as u64, s3rec.USBNET_UP)
    cell((&k_uplink_kind[0]) as u64, s3rec.UPLINK_KIND)
    cell((&k_pci_lost[0]) as u64, s3rec.PCI_LOST)
    cell((&k_pci_bad[0]) as u64, s3rec.PCI_BAD)
    cell((&k_image_back[0]) as u64, s3rec.IMAGE_BACK)
    let usbnet: u64 = netdev.card_of_kind(state, netdev.KIND_USBNET)
    procw.line_num((&k_now_uplink_kind[0]) as u64, netdev.uplink_kind())
    procw.line_num((&k_now_usbnet_ready[0]) as u64, numeric.yes(usbnet != netdev.MAX_CARDS && netdev.ready_on(state, usbnet)))
    procw.line_num((&k_now_net_up[0]) as u64, numeric.yes(netdev.up(state)))
    procw.line_num((&k_now_usb_devices[0]) as u64, usb.count(state))
    return procw.used()
}
