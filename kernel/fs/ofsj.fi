
profile kernel

import lib.kstate
import block.blk
import mm.mmframe
import libc.regio
import libc.octets

export {
    setup, disable, enabled, begin, commit, abort, write, read, read_stream, read_stream_span,
    replay, needed, room, slots, counter, chunk, clear,
    J_TX, J_REPLAY, J_RBLOCKS, J_CHUNKS, J_WRITES, J_HITS, J_STGRUNS,
    HEAD_MAGIC, COMMIT_MAGIC, MAX_SLOTS, BLOCKS_NEEDED
}

const BS: u64 = 512

const HEAD_MAGIC: u64 = 0x444145484A53464F
const COMMIT_MAGIC: u64 = 0x4D4D4F434A53464F

const MAX_SLOTS: u64 = 512
const TGT_BLOCKS: u64 = 8
const HDR_BLOCKS: u64 = 9
const BLOCKS_NEEDED: u64 = 522

const H_MAGIC: u64 = 0
const H_SEQ: u64 = 8
const H_COUNT: u64 = 16
const H_SUM: u64 = 24

const J_ON: u64 = 0
const J_START: u64 = 8
const J_BLOCKS: u64 = 16
const J_DEPTH: u64 = 24
const J_COUNT: u64 = 32
const J_SEQ: u64 = 40
const J_FULL: u64 = 48
const J_OFFBIT: u64 = 56
const J_TX: u64 = 64
const J_REPLAY: u64 = 72
const J_RBLOCKS: u64 = 80
const J_CHUNKS: u64 = 88
const J_WRITES: u64 = 96
const J_HITS: u64 = 104
const J_STG: u64 = 112
const J_STGCAP: u64 = 120
const J_STGRUNS: u64 = 128

const TGT_OFF: u64 = 0x1000
const HSH_OFF: u64 = 0x2000

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.JR_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.JR_OFF + off, v)
}

fn counter(state: u64, welcher: u64) -> u64 {
    return g(state, welcher)
}

fn tgt(state: u64, i: u64) -> u64 {
    return kstate.get(state, kstate.JR_OFF + TGT_OFF + i * 8)
}

fn tgt_set(state: u64, i: u64, v: u64) {
    kstate.set(state, kstate.JR_OFF + TGT_OFF + i * 8, v)
}

fn hsh(state: u64, i: u64) -> u64 {
    return kstate.get(state, kstate.JR_OFF + HSH_OFF + i * 8)
}

fn hsh_set(state: u64, i: u64, v: u64) {
    kstate.set(state, kstate.JR_OFF + HSH_OFF + i * 8, v)
}

fn stg_cap(state: u64) -> u64 {
    return g(state, J_STGCAP)
}

fn stg(state: u64, i: u64) -> u64 {
    return g(state, J_STG) + i * BS
}

fn copy_block(from: u64, to: u64) {
    var i: u64 = 0
    while i < BS / 8 {
        regio.write64(to + i * 8, regio.read64(from + i * 8))
        i = i + 1
    }
}

fn stage_init(state: u64) {
    if g(state, J_STG) != 0 {
        return
    }
    var frames: u64 = 32
    var base: u64 = mmframe.frame_run(state, frames + 2)
    if base == 0 {
        frames = 8
        base = mmframe.frame_run(state, frames + 2)
    }
    if base == 0 {
        return
    }
    s(state, J_STGCAP, frames * mmframe.FRAME_SIZE / BS)
    s(state, J_STG, base + HDR_BLOCKS * BS)
}

fn hdr(state: u64) -> u64 {
    return g(state, J_STG) - HDR_BLOCKS * BS
}

fn zero_words(p: u64, n: u64) {
    var i: u64 = 0
    while i < n / 8 {
        regio.write64(p + i * 8, 0)
        i = i + 1
    }
}

const FNV_OFF: u64 = 0xCBF29CE484222325
const FNV_PRIME: u64 = 0x100000001B3

fn mix(h: u64, v: u64) -> u64 {
    return (h ^ v) *% FNV_PRIME
}

fn block_hash(p: u64) -> u64 {
    var h: u64 = FNV_OFF
    var i: u64 = 0
    while i < BS / 8 {
        h = mix(h, regio.read64(p + i * 8))
        i = i + 1
    }
    return h
}

fn head_blk(state: u64) -> u64 {
    return g(state, J_START)
}

fn tgt_blk(state: u64, k: u64) -> u64 {
    return g(state, J_START) + 1 + k
}

fn pay_blk(state: u64, i: u64) -> u64 {
    return g(state, J_START) + 1 + TGT_BLOCKS + i
}

fn commit_blk(state: u64) -> u64 {
    return g(state, J_START) + 1 + TGT_BLOCKS + MAX_SLOTS
}

fn scratch(state: u64) -> u64 {
    return state + kstate.JR_OFF + 0x800
}

fn scratch2(state: u64) -> u64 {
    return state + kstate.JR_OFF + 0xA00
}

fn copy(from: u64, to: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(to + i, kstate.get8(from + i) as u8)
        i = i + 1
    }
}

fn needed() -> u64 {
    return BLOCKS_NEEDED
}

fn enabled(state: u64) -> bool {
    return g(state, J_ON) == 1
}

fn slots(state: u64) -> u64 {
    return g(state, J_COUNT)
}

fn room(state: u64) -> u64 {
    let n: u64 = g(state, J_COUNT)
    if n >= MAX_SLOTS {
        return 0
    }
    return MAX_SLOTS - n
}

fn disable(state: u64) {
    s(state, J_ON, 0)
    s(state, J_DEPTH, 0)
    s(state, J_COUNT, 0)
    s(state, J_FULL, 0)
}

fn setup(state: u64, jstart: u64, jblocks: u64) -> bool {
    s(state, J_DEPTH, 0)
    s(state, J_COUNT, 0)
    s(state, J_FULL, 0)
    s(state, J_ON, 0)
    if jstart == 0 || jblocks < BLOCKS_NEEDED {
        return false
    }
    if kstate.mode_on(state, kstate.O_NOJRNL) {
        s(state, J_START, jstart)
        s(state, J_BLOCKS, jblocks)
        return false
    }
    s(state, J_START, jstart)
    s(state, J_BLOCKS, jblocks)
    s(state, J_ON, 1)
    stage_init(state)
    return true
}

fn begin(state: u64) {
    if !enabled(state) {
        return
    }
    let d: u64 = g(state, J_DEPTH)
    if d == 0 {
        s(state, J_COUNT, 0)
        s(state, J_FULL, 0)
    }
    s(state, J_DEPTH, d + 1)
}

const KEIN: u64 = 0xFFFFFFFFFFFFFFFF

fn find(state: u64, lba: u64) -> u64 {
    let n: u64 = g(state, J_COUNT)
    var i: u64 = 0
    while i < n {
        if tgt(state, i) == lba {
            return i
        }
        i = i + 1
    }
    return KEIN
}

fn write(state: u64, lba: u64, src: u64) -> bool {
    if !enabled(state) || g(state, J_DEPTH) == 0 {
        return blk.write(state, lba, src)
    }
    s(state, J_WRITES, g(state, J_WRITES) + 1)
    var i: u64 = find(state, lba)
    if i == KEIN {
        let n: u64 = g(state, J_COUNT)
        if n >= MAX_SLOTS {
            s(state, J_FULL, 1)
            return false
        }
        i = n
        tgt_set(state, i, lba)
        s(state, J_COUNT, n + 1)
    } else {
        s(state, J_HITS, g(state, J_HITS) + 1)
    }
    if g(state, J_STG) != 0 && i < stg_cap(state) {
        copy_block(src, stg(state, i))
    } else if !blk.write(state, pay_blk(state, i), src) {
        s(state, J_FULL, 1)
        return false
    }
    hsh_set(state, i, block_hash(src))
    return true
}

fn read(state: u64, lba: u64, dst: u64) -> bool {
    if enabled(state) && g(state, J_DEPTH) != 0 {
        let i: u64 = find(state, lba)
        if i != KEIN {
            if g(state, J_STG) != 0 && i < stg_cap(state) {
                copy_block(stg(state, i), dst)
                return true
            }
            return blk.read(state, pay_blk(state, i), dst)
        }
    }
    return blk.read(state, lba, dst)
}

fn read_stream(state: u64, lba: u64, dst: u64) -> bool {
    return read_stream_span(state, lba, dst, blk.S_SECTORS)
}

fn read_stream_span(state: u64, lba: u64, dst: u64, span: u64) -> bool {
    if enabled(state) && g(state, J_DEPTH) != 0 {
        let i: u64 = find(state, lba)
        if i != KEIN {
            if g(state, J_STG) != 0 && i < stg_cap(state) {
                copy_block(stg(state, i), dst)
                return true
            }
            return blk.read(state, pay_blk(state, i), dst)
        }
    }
    return blk.read_stream_span(state, lba, dst, span)
}

fn abort(state: u64) {
    let d: u64 = g(state, J_DEPTH)
    if d > 0 {
        s(state, J_DEPTH, d - 1)
    }
    if g(state, J_DEPTH) == 0 {
        s(state, J_COUNT, 0)
        s(state, J_FULL, 0)
    }
}

fn commit(state: u64) -> bool {
    if !enabled(state) {
        return true
    }
    let d: u64 = g(state, J_DEPTH)
    if d > 1 {
        s(state, J_DEPTH, d - 1)
        return true
    }
    s(state, J_DEPTH, 0)
    let n: u64 = g(state, J_COUNT)
    if n == 0 {
        return true
    }
    if g(state, J_FULL) == 1 {
        s(state, J_COUNT, 0)
        s(state, J_FULL, 0)
        return false
    }
    let seq: u64 = g(state, J_SEQ) + 1
    s(state, J_SEQ, seq)

    var m: u64 = 0
    if g(state, J_STG) != 0 {
        m = n
        if m > stg_cap(state) {
            m = stg_cap(state)
        }
    }
    if m > 0 && m == n {
        let h: u64 = hdr(state)
        zero_words(h, HDR_BLOCKS * BS)
        regio.write64(h + H_MAGIC, HEAD_MAGIC)
        regio.write64(h + H_SEQ, seq)
        regio.write64(h + H_COUNT, n)
        var q: u64 = 0
        while q < n {
            regio.write64(h + BS + q * 8, tgt(state, q))
            q = q + 1
        }
        s(state, J_STGRUNS, g(state, J_STGRUNS) + 1)
        if !blk.write_run(state, head_blk(state), h, HDR_BLOCKS + n) {
            return false
        }
    } else {
        if m > 0 {
            s(state, J_STGRUNS, g(state, J_STGRUNS) + 1)
            if !blk.write_run(state, pay_blk(state, 0), stg(state, 0), m) {
                return false
            }
        }
        var k: u64 = 0
        while k * 64 < n {
            octets.zero(scratch(state), BS)
            var j: u64 = 0
            while j < 64 && k * 64 + j < n {
                regio.write64(scratch(state) + j * 8, tgt(state, k * 64 + j))
                j = j + 1
            }
            if !blk.write(state, tgt_blk(state, k), scratch(state)) {
                return false
            }
            k = k + 1
        }
        octets.zero(scratch(state), BS)
        regio.write64(scratch(state) + H_MAGIC, HEAD_MAGIC)
        regio.write64(scratch(state) + H_SEQ, seq)
        regio.write64(scratch(state) + H_COUNT, n)
        if !blk.write(state, head_blk(state), scratch(state)) {
            return false
        }
    }
    blk.flush(state)
    var sum: u64 = FNV_OFF
    sum = mix(sum, seq)
    sum = mix(sum, n)
    var i: u64 = 0
    while i < n {
        sum = mix(sum, tgt(state, i))
        sum = mix(sum, hsh(state, i))
        i = i + 1
    }
    octets.zero(scratch(state), BS)
    regio.write64(scratch(state) + H_MAGIC, COMMIT_MAGIC)
    regio.write64(scratch(state) + H_SEQ, seq)
    regio.write64(scratch(state) + H_COUNT, n)
    regio.write64(scratch(state) + H_SUM, sum)
    if !blk.write(state, commit_blk(state), scratch(state)) {
        return false
    }
    blk.flush(state)
    s(state, J_TX, g(state, J_TX) + 1)

    i = 0
    while i < n {
        if i < m {
            var e: u64 = i + 1
            while e < m && tgt(state, e) == tgt(state, e - 1) + 1 {
                e = e + 1
            }
            s(state, J_STGRUNS, g(state, J_STGRUNS) + 1)
            if !blk.write_run(state, tgt(state, i), stg(state, i), e - i) {
                return false
            }
            i = e
        } else {
            if !blk.read(state, pay_blk(state, i), scratch2(state)) {
                return false
            }
            if !blk.write(state, tgt(state, i), scratch2(state)) {
                return false
            }
            i = i + 1
        }
    }
    blk.flush(state)
    octets.zero(scratch(state), BS)
    blk.write(state, commit_blk(state), scratch(state))
    s(state, J_COUNT, 0)
    s(state, J_FULL, 0)
    return true
}

fn chunk(state: u64) -> bool {
    if !enabled(state) {
        return true
    }
    if g(state, J_DEPTH) != 1 {
        return true
    }
    s(state, J_CHUNKS, g(state, J_CHUNKS) + 1)
    let ok: bool = commit(state)
    begin(state)
    return ok
}

fn replay(state: u64, jstart: u64, jblocks: u64) -> u64 {
    if jstart == 0 || jblocks < BLOCKS_NEEDED {
        return 0
    }
    s(state, J_START, jstart)
    s(state, J_BLOCKS, jblocks)
    if !blk.read(state, commit_blk(state), scratch(state)) {
        return 0
    }
    if regio.read64(scratch(state) + H_MAGIC) != COMMIT_MAGIC {
        return 0
    }
    let seq: u64 = regio.read64(scratch(state) + H_SEQ)
    let n: u64 = regio.read64(scratch(state) + H_COUNT)
    let sum: u64 = regio.read64(scratch(state) + H_SUM)
    if n == 0 || n > MAX_SLOTS {
        delete(state)
        return 0
    }
    if !blk.read(state, head_blk(state), scratch(state)) {
        return 0
    }
    if regio.read64(scratch(state) + H_MAGIC) != HEAD_MAGIC {
        delete(state)
        return 0
    }
    if regio.read64(scratch(state) + H_SEQ) != seq {
        delete(state)
        return 0
    }
    if regio.read64(scratch(state) + H_COUNT) != n {
        delete(state)
        return 0
    }
    var k: u64 = 0
    while k * 64 < n {
        if !blk.read(state, tgt_blk(state, k), scratch(state)) {
            return 0
        }
        var j: u64 = 0
        while j < 64 && k * 64 + j < n {
            tgt_set(state, k * 64 + j, regio.read64(scratch(state) + j * 8))
            j = j + 1
        }
        k = k + 1
    }
    var check: u64 = FNV_OFF
    check = mix(check, seq)
    check = mix(check, n)
    var i: u64 = 0
    while i < n {
        if !blk.read(state, pay_blk(state, i), scratch2(state)) {
            return 0
        }
        check = mix(check, tgt(state, i))
        check = mix(check, block_hash(scratch2(state)))
        i = i + 1
    }
    if check != sum {
        delete(state)
        return 0
    }
    i = 0
    while i < n {
        if !blk.read(state, pay_blk(state, i), scratch2(state)) {
            return 0
        }
        if !blk.write(state, tgt(state, i), scratch2(state)) {
            return 0
        }
        i = i + 1
    }
    blk.flush(state)
    delete(state)
    s(state, J_REPLAY, g(state, J_REPLAY) + 1)
    s(state, J_RBLOCKS, n)
    s(state, J_SEQ, seq)
    return n
}

fn clear(state: u64, jstart: u64, jblocks: u64) {
    if jstart == 0 || jblocks < BLOCKS_NEEDED {
        return
    }
    s(state, J_START, jstart)
    s(state, J_BLOCKS, jblocks)
    delete(state)
}

fn delete(state: u64) {
    octets.zero(scratch(state), BS)
    blk.write(state, commit_blk(state), scratch(state))
    blk.flush(state)
}
