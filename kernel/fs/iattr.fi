profile kernel

import lib.kstate
import arch.arch

export { MISS, KIND_TYPE_MASK, KIND_MODE_SHIFT, which_of, get, put, put_pointers, direct_get, perm_get, attr_get, attr_get_stable, kind_get, drop, drop_range, flush, leaf_hold, leaf_valid, leaf_drop }

const MISS: u64 = 0xFFFFFFFFFFFFFFFF
const KIND_TYPE_MASK: u64 = 0xFF
const KIND_MODE_SHIFT: u64 = 8
const LINES: u64 = 512
const LINE_WORDS: u64 = 82
const SLOTS: u64 = 4
const SLOT_WORDS: u64 = 20
const DIRECT_WORDS: u64 = 8
const DIRECT_WHICH: u64 = 8
const INDIRECT_WHICH: u64 = 16
const INDIRECT_WORDS: u64 = 3
const F_DIRECT: u64 = 24
const F_INDIRECT: u64 = 112
const SLOT_AT: u64 = 2
const TAG_VALID: u64 = 0x8000000000000000
const TAG_LBA_MASK: u64 = 0xFFFFFFFFFF
const TAG_VOL_MASK: u64 = 0xFFFFFF
const TAG_VOL_SHIFT: u64 = 40
const LINE_MUL: u64 = 0x9E3779B97F4A7C15
const LINE_SHIFT: u64 = 55
const VOLUME_MUL: u64 = 1000003
const F_TYPE: u64 = 0
const F_SIZE: u64 = 8
const F_MODE: u64 = 88
const F_UID: u64 = 96
const F_GID: u64 = 104
const F_CTIME: u64 = 136
const F_MTIME: u64 = 144
const F_ATIME: u64 = 152

const SEQ_AT: u64 = 41984
const STABLE_TRIES: u64 = 4
static mut cells: [u64; 41985] = [0 as u64; 41985]
static mut held_low: u64 = 0xFFFFFFFFFFFFFFFF
static mut held_high: u64 = 0

fn seq_flip() {
    cells[SEQ_AT as usize] = cells[SEQ_AT as usize] + 1
}

fn attr_get_stable(state: u64, lba: u64, idx: u64, out: u64) -> bool {
    let seq_addr: u64 = (&cells[SEQ_AT as usize]) as u64
    var tries: u64 = 0
    while tries < STABLE_TRIES {
        let before: u64 = arch.atomic_load(seq_addr)
        if (before & 1) == 0 {
            let hit: bool = attr_get(state, lba, idx, out)
            if arch.atomic_load(seq_addr) == before {
                return hit
            }
        }
        tries = tries + 1
    }
    return false
}

fn which_of(field: u64) -> u64 {
    if field == F_TYPE {
        return 0
    }
    if field == F_SIZE {
        return 1
    }
    if field == F_MODE {
        return 2
    }
    if field == F_UID {
        return 3
    }
    if field == F_GID {
        return 4
    }
    if field == F_MTIME {
        return 5
    }
    if field == F_CTIME {
        return 6
    }
    if field == F_ATIME {
        return 7
    }
    if field >= F_DIRECT && field < F_DIRECT + DIRECT_WORDS * 8 && (field - F_DIRECT) % 8 == 0 {
        return DIRECT_WHICH + (field - F_DIRECT) / 8
    }
    if field >= F_INDIRECT && field < F_INDIRECT + INDIRECT_WORDS * 8 && (field - F_INDIRECT) % 8 == 0 {
        return INDIRECT_WHICH + (field - F_INDIRECT) / 8
    }
    return MISS
}

fn tag_of(state: u64, lba: u64) -> u64 {
    let vol: u64 = kstate.get(state, kstate.DISK_DEV) * VOLUME_MUL + kstate.get(state, kstate.DISK_FIRST) + 1
    return TAG_VALID | ((vol & TAG_VOL_MASK) << TAG_VOL_SHIFT) | (lba & TAG_LBA_MASK)
}

fn line_of(lba: u64) -> u64 {
    return (((lba + 1) *% LINE_MUL) >> LINE_SHIFT) % LINES
}

fn get(state: u64, lba: u64, idx: u64, which: u64) -> u64 {
    if idx >= SLOTS {
        return MISS
    }
    let base: u64 = line_of(lba) * LINE_WORDS
    if cells[base as usize] != tag_of(state, lba) || (cells[(base + 1) as usize] & (1 << idx)) == 0 {
        return MISS
    }
    return cells[(base + SLOT_AT + idx * SLOT_WORDS + which) as usize]
}

fn perm_get(state: u64, lba: u64, idx: u64, out: u64) -> bool {
    if idx >= SLOTS {
        return false
    }
    let base: u64 = line_of(lba) * LINE_WORDS
    if cells[base as usize] != tag_of(state, lba) || (cells[(base + 1) as usize] & (1 << idx)) == 0 {
        return false
    }
    let at: u64 = base + SLOT_AT + idx * SLOT_WORDS
    *(out as *mut u64) = cells[at as usize]
    *((out + 8) as *mut u64) = cells[(at + 2) as usize]
    *((out + 16) as *mut u64) = cells[(at + 3) as usize]
    *((out + 24) as *mut u64) = cells[(at + 4) as usize]
    return true
}

fn attr_get(state: u64, lba: u64, idx: u64, out: u64) -> bool {
    if idx >= SLOTS {
        return false
    }
    let base: u64 = line_of(lba) * LINE_WORDS
    if cells[base as usize] != tag_of(state, lba) || (cells[(base + 1) as usize] & (1 << idx)) == 0 {
        return false
    }
    let at: u64 = base + SLOT_AT + idx * SLOT_WORDS
    *(out as *mut u64) = cells[at as usize]
    *((out + 8) as *mut u64) = cells[(at + 1) as usize]
    *((out + 16) as *mut u64) = cells[(at + 2) as usize]
    *((out + 24) as *mut u64) = cells[(at + 3) as usize]
    *((out + 32) as *mut u64) = cells[(at + 4) as usize]
    *((out + 40) as *mut u64) = cells[(at + 5) as usize]
    *((out + 48) as *mut u64) = cells[(at + 6) as usize]
    *((out + 56) as *mut u64) = cells[(at + 7) as usize]
    return true
}

fn kind_get(state: u64, lba: u64, idx: u64) -> u64 {
    if idx >= SLOTS {
        return MISS
    }
    let base: u64 = line_of(lba) * LINE_WORDS
    if cells[base as usize] != tag_of(state, lba) || (cells[(base + 1) as usize] & (1 << idx)) == 0 {
        return MISS
    }
    let at: u64 = base + SLOT_AT + idx * SLOT_WORDS
    return (cells[(at + 2) as usize] << KIND_MODE_SHIFT) | (cells[at as usize] & KIND_TYPE_MASK)
}

fn put(state: u64, lba: u64, idx: u64, kind: u64, size: u64, mode: u64, uid: u64, gid: u64,
    mtime: u64, ctime: u64, atime: u64) {
    if idx >= SLOTS {
        return
    }
    seq_flip()
    let base: u64 = line_of(lba) * LINE_WORDS
    let tag: u64 = tag_of(state, lba)
    if lba < held_low {
        held_low = lba
    }
    if lba > held_high {
        held_high = lba
    }
    if cells[base as usize] != tag {
        cells[base as usize] = tag
        cells[(base + 1) as usize] = 0
    }
    let at: u64 = base + SLOT_AT + idx * SLOT_WORDS
    cells[at as usize] = kind
    cells[(at + 1) as usize] = size
    cells[(at + 2) as usize] = mode
    cells[(at + 3) as usize] = uid
    cells[(at + 4) as usize] = gid
    cells[(at + 5) as usize] = mtime
    cells[(at + 6) as usize] = ctime
    cells[(at + 7) as usize] = atime
    cells[(base + 1) as usize] = cells[(base + 1) as usize] | (1 << idx)
    seq_flip()
}

fn direct_get(state: u64, lba: u64, idx: u64, count: u64, out: u64) -> bool {
    if idx >= SLOTS || count > DIRECT_WORDS {
        return false
    }
    let base: u64 = line_of(lba) * LINE_WORDS
    if cells[base as usize] != tag_of(state, lba) || (cells[(base + 1) as usize] & (1 << idx)) == 0 {
        return false
    }
    let at: u64 = base + SLOT_AT + idx * SLOT_WORDS + DIRECT_WHICH
    var i: u64 = 0
    while i < count {
        *((out + i * 8) as *mut u64) = cells[(at + i) as usize]
        i = i + 1
    }
    return true
}

fn put_pointers(lba: u64, idx: u64, src: u64) {
    if idx >= SLOTS {
        return
    }
    let at: u64 = line_of(lba) * LINE_WORDS + SLOT_AT + idx * SLOT_WORDS
    seq_flip()
    var i: u64 = 0
    while i < DIRECT_WORDS {
        cells[(at + DIRECT_WHICH + i) as usize] = kstate.get(src, F_DIRECT + i * 8)
        i = i + 1
    }
    i = 0
    while i < INDIRECT_WORDS {
        cells[(at + INDIRECT_WHICH + i) as usize] = kstate.get(src, F_INDIRECT + i * 8)
        i = i + 1
    }
    seq_flip()
}

static mut leaf_held: u64 = 0

fn leaf_hold(lba: u64) {
    leaf_held = lba
}

fn leaf_valid(lba: u64) -> bool {
    return leaf_held != 0 && leaf_held == lba
}

fn leaf_drop() {
    leaf_held = 0
}

fn drop(state: u64, lba: u64) {
    if lba == leaf_held {
        leaf_held = 0
    }
    let base: u64 = line_of(lba) * LINE_WORDS
    if cells[base as usize] == tag_of(state, lba) {
        seq_flip()
        cells[base as usize] = 0
        cells[(base + 1) as usize] = 0
        seq_flip()
    }
}

fn drop_range(state: u64, lba: u64, n: u64) {
    if leaf_held >= lba && leaf_held < lba + n {
        leaf_held = 0
    }
    if lba > held_high || lba + n <= held_low {
        return
    }
    var i: u64 = 0
    while i < n {
        drop(state, lba + i)
        i = i + 1
    }
}

fn flush() {
    leaf_held = 0
    seq_flip()
    held_low = 0xFFFFFFFFFFFFFFFF
    held_high = 0
    var i: u64 = 0
    while i < LINES {
        cells[(i * LINE_WORDS) as usize] = 0
        cells[(i * LINE_WORDS + 1) as usize] = 0
        i = i + 1
    }
    seq_flip()
}
