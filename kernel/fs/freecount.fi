profile kernel

export { select, invalidate, forget, known, value, store, claimed, released }

const SLOTS: u64 = 10

static mut totals: [u64; 10] = [0 as u64; 10]
static mut known_flags: [u64; 10] = [0 as u64; 10]
static mut selected: u64 = 0

fn select(slot: u64) {
    if slot < SLOTS {
        selected = slot
    }
}

fn invalidate() {
    known_flags[(selected) as usize] = 0
}

fn forget(slot: u64) {
    if slot < SLOTS {
        known_flags[(slot) as usize] = 0
    }
}

fn known() -> bool {
    return known_flags[(selected) as usize] != 0
}

fn value() -> u64 {
    return totals[(selected) as usize]
}

fn store(n: u64) {
    totals[(selected) as usize] = n
    known_flags[(selected) as usize] = 1
}

fn claimed() {
    if !known() {
        return
    }
    if totals[(selected) as usize] == 0 {
        invalidate()
        return
    }
    totals[(selected) as usize] = totals[(selected) as usize] - 1
}

fn released() {
    if known() {
        totals[(selected) as usize] = totals[(selected) as usize] + 1
    }
}
