
profile kernel

export {
    Ops,
    A_TYPE, A_SIZE, A_MODE, A_NLINK, A_RDEV, A_BLKSIZE,
    A_MTIME, A_CTIME, A_ATIME,
    A_UID, A_GID,
    N_NONE, N_FILE, N_DIR, N_CHR, N_BLK, N_LNK,
    OP_LOOKUP, OP_READDIR, OP_ATTR, OP_READ, OP_WRITE,
    OP_CREATE, OP_UNLINK, OP_RENAME, OP_TRUNC, OP_ALL, OP_READONLY,
    FS_NONE, FS_OFS, FS_PROC, FS_DEV, FS_FAT, FS_EXT4, FS_NTFS, FS_EXFAT,
    NODE_NONE, NAME_MAX
}

const A_TYPE: u64 = 0
const A_SIZE: u64 = 1
const A_MODE: u64 = 2
const A_NLINK: u64 = 3
const A_RDEV: u64 = 4
const A_BLKSIZE: u64 = 5
const A_MTIME: u64 = 6
const A_CTIME: u64 = 7
const A_ATIME: u64 = 8
const A_UID: u64 = 9
const A_GID: u64 = 10

const N_NONE: u64 = 0
const N_FILE: u64 = 1
const N_DIR: u64 = 2
const N_CHR: u64 = 3
const N_BLK: u64 = 4
const N_LNK: u64 = 5

const OP_LOOKUP: u64 = 1
const OP_READDIR: u64 = 2
const OP_ATTR: u64 = 4
const OP_READ: u64 = 8
const OP_WRITE: u64 = 16
const OP_CREATE: u64 = 32
const OP_UNLINK: u64 = 64
const OP_RENAME: u64 = 128
const OP_TRUNC: u64 = 256
const OP_ALL: u64 = 511
const OP_READONLY: u64 = 15

const FS_NONE: u64 = 0
const FS_OFS: u64 = 1
const FS_PROC: u64 = 2
const FS_DEV: u64 = 3
const FS_FAT: u64 = 4
const FS_EXT4: u64 = 5
const FS_NTFS: u64 = 6
const FS_EXFAT: u64 = 7

const NODE_NONE: u64 = 0
const NAME_MAX: u64 = 64

struct Ops {
    lookup: fn(u64, u64, u64) -> u64,
    readdir: fn(u64, u64, u64, u64, u64) -> u64,
    attr: fn(u64, u64, u64, u64) -> u64,
    read: fn(u64, u64, u64, u64, u64, u64) -> u64,
    write: fn(u64, u64, u64, u64, u64, u64) -> u64,
    create: fn(u64, u64, u64, u64) -> u64,
    unlink: fn(u64, u64, u64) -> u64,
    rename: fn(u64, u64, u64, u64) -> u64,
    trunc: fn(u64, u64, u64) -> u64,
    mask: u64,
    tag: u64
}
