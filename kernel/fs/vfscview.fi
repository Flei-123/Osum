profile kernel

import lib.kstate
import lib.procw
import fs.dcache
import fs.pcache

export { render }

fn render(state: u64, out: u64, cap: u64) -> u64 {
    var k_dh: [u8; 11] = "dcache.hit\0"
    var k_dm: [u8; 12] = "dcache.miss\0"
    var k_dn: [u8; 11] = "dcache.neg\0"
    var k_di: [u8; 14] = "dcache.insert\0"
    var k_df: [u8; 13] = "dcache.flush\0"
    var k_dl: [u8; 12] = "dcache.long\0"
    var k_dd: [u8; 11] = "dcache.dot\0"
    var k_ds: [u8; 13] = "dcache.stale\0"
    var k_de: [u8; 12] = "dcache.evic\0"
    var k_k0: [u8; 12] = "dcache.full\0"
    var k_k1: [u8; 12] = "dcache.neg0\0"
    var k_k2: [u8; 12] = "dcache.node\0"
    var k_k3: [u8; 12] = "dcache.name\0"
    var k_ph: [u8; 11] = "pcache.hit\0"
    var k_pm: [u8; 12] = "pcache.miss\0"
    var k_pi: [u8; 14] = "pcache.insert\0"
    var k_pd: [u8; 12] = "pcache.drop\0"
    var k_pr: [u8; 16] = "pcache.resident\0"
    var k_pb: [u8; 14] = "pcache.bypass\0"
    procw.begin(out, cap)
    procw.line_num((&k_dh[0]) as u64, dcache.hits(state))
    procw.line_num((&k_dm[0]) as u64, dcache.misses(state))
    procw.line_num((&k_dn[0]) as u64, dcache.negative_hits(state))
    procw.line_num((&k_di[0]) as u64, dcache.inserts(state))
    procw.line_num((&k_df[0]) as u64, dcache.flushes(state))
    procw.line_num((&k_dl[0]) as u64, dcache.skipped_long(state))
    procw.line_num((&k_dd[0]) as u64, dcache.skipped_dot(state))
    procw.line_num((&k_ds[0]) as u64, dcache.stale(state))
    procw.line_num((&k_de[0]) as u64, dcache.evictions(state))
    procw.line_num((&k_k0[0]) as u64, dcache.kind_count(state, 0))
    procw.line_num((&k_k1[0]) as u64, dcache.kind_count(state, 1))
    procw.line_num((&k_k2[0]) as u64, dcache.kind_count(state, 2))
    procw.line_num((&k_k3[0]) as u64, dcache.kind_count(state, 3))
    procw.line_num((&k_ph[0]) as u64, pcache.hits(state))
    procw.line_num((&k_pm[0]) as u64, pcache.misses(state))
    procw.line_num((&k_pi[0]) as u64, pcache.inserts(state))
    procw.line_num((&k_pd[0]) as u64, pcache.drops(state))
    procw.line_num((&k_pr[0]) as u64, pcache.resident(state))
    procw.line_num((&k_pb[0]) as u64, pcache.bypassed(state))
    return procw.used()
}
