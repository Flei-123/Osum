profile kernel

export { buffer, per_chunk, entry }

const CHUNK_BYTES: u64 = 4096
static mut chunk_buf: [u64; 512] = [0 as u64; 512]

fn buffer() -> u64 {
    return (&chunk_buf[0]) as u64
}

fn per_chunk(entry_bytes: u64) -> u64 {
    return CHUNK_BYTES / entry_bytes
}

fn entry(index: u64, entry_bytes: u64) -> u64 {
    return buffer() + index * entry_bytes
}
