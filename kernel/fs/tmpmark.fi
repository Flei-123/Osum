profile kernel

import fs.file
import libc.regio

export { volatile_path, mark_open, is_volatile_open }

const MARK: u64 = 1
const PREFIX_LEN: u64 = 5

fn volatile_path(path: u64) -> bool {
    var prefix: [u8; 6] = "/tmp/\0"
    let want: u64 = (&prefix[0 as usize]) as u64
    var i: u64 = 0
    while i < PREFIX_LEN {
        if regio.read8(path + i) != regio.read8(want + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn mark_open(state: u64, of: u64, path: u64) {
    if volatile_path(path) {
        file.open_set_x2(state, of, MARK)
    }
}

fn is_volatile_open(state: u64, of: u64) -> bool {
    let kind: u64 = file.open_kind(state, of)
    if kind != file.K_VFILE && kind != file.K_VDIR {
        return false
    }
    return file.open_x2(state, of) == MARK
}
