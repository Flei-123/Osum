profile kernel

import sync.fslock
import fs.ofsj

export { sync, idle }

fn sync(state: u64) -> bool {
    if !ofsj.pending() {
        return true
    }
    let flags: u64 = fslock.enter(state)
    let ok: bool = ofsj.flush_pending(state)
    fslock.leave(state, flags)
    return ok
}

fn idle(state: u64) {
    if !ofsj.pending() || ofsj.age(state) < ofsj.GROUP_IDLE_TICKS {
        return
    }
    let flags: u64 = fslock.save_irq()
    if fslock.try_take(state) {
        let _ok: bool = ofsj.flush_pending(state)
        fslock.give(state)
    }
    fslock.restore_irq(flags)
}
