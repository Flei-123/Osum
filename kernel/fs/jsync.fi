profile kernel

import sync.fslock
import block.blk
import fs.ofsj
import fs.fs
import arch.arch
import sched.sched

export { sync, drain, idle }

const DRAIN_SLOTS: u64 = 256
const DRAIN_ROUNDS_MAX: u64 = 4096
const IDLE_SLOTS: u64 = 32

fn sync(state: u64) -> bool {
    let flags: u64 = fslock.enter(state)
    var table_ok: bool = blk.wb_flush(state)
    if fs.reclaim_locked(state) && !blk.wb_flush(state) {
        table_ok = false
    }
    blk.wb_release(state)
    var ok: bool = true
    if ofsj.pending() {
        ok = ofsj.flush_pending(state)
    }
    fslock.leave(state, flags)
    return ok && table_ok
}

fn breathe() {
    if !arch.irq_are_on() {
        asm("sti\nnop\ncli")
    }
}

fn drain(state: u64) -> bool {
    if fslock.mine(state) {
        return true
    }
    var round: u64 = 0
    while round < DRAIN_ROUNDS_MAX {
        let flags: u64 = fslock.enter(state)
        let step: u64 = blk.wb_flush_some(state, DRAIN_SLOTS)
        fslock.leave(state, flags)
        if step == blk.FLUSH_FAILED {
            return false
        }
        if step == blk.FLUSH_DONE {
            return true
        }
        breathe()
        round = round + 1
    }
    return true
}

fn idle_table(state: u64) {
    if !blk.wb_due(state) {
        return
    }
    var round: u64 = 0
    while round < DRAIN_ROUNDS_MAX && sched.ready_count(state) == 0 {
        if idle_step(state) != blk.FLUSH_MORE {
            return
        }
        round = round + 1
    }
}

fn idle_step(state: u64) -> u64 {
    let flags: u64 = fslock.save_irq()
    if !fslock.try_take(state) {
        fslock.restore_irq(flags)
        return blk.FLUSH_FAILED
    }
    let step: u64 = blk.wb_flush_some(state, IDLE_SLOTS)
    if step == blk.FLUSH_DONE {
        finish_table(state)
    }
    fslock.give(state)
    fslock.restore_irq(flags)
    return step
}

fn finish_table(state: u64) {
    let _flushed: bool = blk.flush(state)
    if fs.reclaim_locked(state) {
        let _again: bool = blk.flush(state)
    }
    blk.wb_release(state)
}

fn idle(state: u64) {
    idle_table(state)
    if !ofsj.pending() || ofsj.age(state) < ofsj.GROUP_IDLE_TICKS {
        return
    }
    let flags: u64 = fslock.save_irq()
    if fslock.try_take(state) {
        let _ok: bool = ofsj.flush_pending(state)
        fslock.give(state)
    }
    fslock.restore_irq(flags)
}
