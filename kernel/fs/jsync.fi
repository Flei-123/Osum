profile kernel

import lib.kstate
import sync.atomic
import arch.cpu
import sched.sched
import fs.ofsj

export { sync, idle }

fn sync(state: u64) -> bool {
    if !ofsj.pending() {
        return true
    }
    let flags: u64 = sched.irq_save()
    let me: u64 = cpu.here(state)
    let nested: bool = atomic.lock_owner(state, atomic.L_FS) == me + 1
    if !nested {
        atomic.lock_take(state, atomic.L_FS, me)
    }
    let ok: bool = ofsj.flush_pending(state)
    if !nested {
        atomic.lock_give(state, atomic.L_FS)
    }
    sched.irq_restore(flags)
    return ok
}

fn idle(state: u64) {
    if !ofsj.pending() || ofsj.age(state) < ofsj.GROUP_IDLE_TICKS {
        return
    }
    let flags: u64 = sched.irq_save()
    let me: u64 = cpu.here(state)
    if atomic.lock_try(state, atomic.L_FS, me) {
        let _ok: bool = ofsj.flush_pending(state)
        atomic.lock_give(state, atomic.L_FS)
    }
    sched.irq_restore(flags)
}
