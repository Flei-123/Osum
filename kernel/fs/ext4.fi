// ================================================== DAS FORMAT
// ================================================== WAS NICHT GEHT

profile kernel

import lib.kstate
import serial
import block.blk
import fs.mnt
import fs.vfsops
import sched.sched
import sync.atomic
import arch.cpu

export { ops, mount_probe, release, node_hold, node_drop,
    MAX_NODES, unsauber }

const BS: u64 = 512

const SB_OFF: u64 = 0x000 // 8 Einhaengungen zu 128 Oktetten
const SB_BYTES: u64 = 128
const NODE_OFF: u64 = 0x400
const NODE_BYTES: u64 = 56
const MAX_NODES: u64 = 16
const BLKBUF: u64 = 0x800
const NODEBUF: u64 = 0x1800
const INOBUF: u64 = 0x2800
const SECBUF: u64 = 0x2A00 // 512: ein einzelner Sektor
const NAMBUF: u64 = 0x2C00

// die Felder je Einhaengung
const S_VALID: u64 = 0
const S_BSIZE: u64 = 8   // Blockgroesse in Oktetten
const S_IPG: u64 = 16    // Inodes je Gruppe
const S_INOSZ: u64 = 24  // Groesse eines Inodes
const S_FIRST: u64 = 32  // s_first_data_block
const S_DESCSZ: u64 = 40 // Groesse eines Gruppenbeschreibers
const S_BLOCKS: u64 = 48
const S_INCOMPAT: u64 = 56
const S_64BIT: u64 = 64
const S_UNSAUBER: u64 = 72
const S_GDBLOCK: u64 = 80
// ---------------------------------------------- der Extent-Zwischenspeicher
const S_CINO: u64 = 88
const S_CBLOCK: u64 = 96
const S_CLEN: u64 = 104   // wie viele Bloecke er umfasst
const S_CPHYS: u64 = 112  // und wo sie physisch anfangen

const N_MNT: u64 = 0 // Einhaengung + 1, 0 = frei
const N_INO: u64 = 8
const N_SIZE: u64 = 16
const N_MODE: u64 = 24
const N_FLAGS: u64 = 32
const N_NLINKS: u64 = 40
const N_USE: u64 = 48

const MAGIE: u64 = 0xEF53
const EXT_MAGIE: u64 = 0xF30A

const INC_COMPRESSION: u64 = 0x1
const INC_RECOVER: u64 = 0x4
const INC_64BIT: u64 = 0x80
const INC_INLINE_DATA: u64 = 0x8000
const INC_ENCRYPT: u64 = 0x10000
const INC_CASEFOLD: u64 = 0x20000

const MAX_TIEFE: u64 = 5

// ------------------------------------------------------------ die Sperre
const NESTED: u64 = 0x8000000000000000

fn enter(state: u64) -> u64 {
    let flags: u64 = sched.irq_save()
    let me: u64 = cpu.here(state)
    if atomic.lock_owner(state, atomic.L_FS) == me + 1 {
        return flags | NESTED
    }
    atomic.lock_take(state, atomic.L_FS, me)
    return flags
}

fn leave(state: u64, flags: u64) {
    if (flags & NESTED) == 0 {
        atomic.lock_give(state, atomic.L_FS)
    }
    sched.irq_restore(flags & 0x7FFFFFFFFFFFFFFF)
}

// ------------------------------------------------------ kleine Handgriffe

fn sb(state: u64, m: u64) -> u64 {
    return state + kstate.EXT4_OFF + SB_OFF + m * SB_BYTES
}

fn sget(state: u64, m: u64, f: u64) -> u64 {
    return __mmio_read64((sb(state, m) + f) as *mut u64)
}

fn sset(state: u64, m: u64, f: u64, v: u64) {
    __mmio_write64((sb(state, m) + f) as *mut u64, v)
}

fn nd(state: u64, i: u64) -> u64 {
    return state + kstate.EXT4_OFF + NODE_OFF + (i - 1) * NODE_BYTES
}

fn nget(state: u64, i: u64, f: u64) -> u64 {
    if i == 0 || i > MAX_NODES {
        return 0
    }
    return __mmio_read64((nd(state, i) + f) as *mut u64)
}

fn nset(state: u64, i: u64, f: u64, v: u64) {
    if i == 0 || i > MAX_NODES {
        return
    }
    __mmio_write64((nd(state, i) + f) as *mut u64, v)
}

fn buf(state: u64, which: u64) -> u64 {
    return state + kstate.EXT4_OFF + which
}

fn tick(state: u64) {
    kstate.add(state, kstate.VFS_INDIRECT, 1)
}

fn le16(p: u64) -> u64 {
    return kstate.get8(p) | (kstate.get8(p + 1) << 8)
}

fn le32(p: u64) -> u64 {
    return le16(p) | (le16(p + 2) << 16)
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, 0 as u8)
        i = i + 1
    }
}

fn rd(state: u64, m: u64, lba: u64, dst: u64) -> bool {
    return blk.read_on(state, mnt.dev(state, m), lba, dst)
}

fn block_read(state: u64, m: u64, block: u64, dst: u64) -> bool {
    if block == 0 || block >= sget(state, m, S_BLOCKS) {
        return false
    }
    let bs: u64 = sget(state, m, S_BSIZE)
    let sektoren: u64 = bs / BS
    let cur_first: u64 = mnt.first(state, m) + block * sektoren
    var i: u64 = 0
    while i < sektoren {
        if !rd(state, m, cur_first + i, dst + i * BS) {
            return false
        }
        i = i + 1
    }
    return true
}

// -------------------------------------------------------- die Knotentafel

fn node_find(state: u64, m: u64, ino: u64) -> u64 {
    var i: u64 = 1
    while i <= MAX_NODES {
        if nget(state, i, N_MNT) == m + 1 && nget(state, i, N_INO) == ino {
            return i
        }
        i = i + 1
    }
    return 0
}

fn node_get(state: u64, m: u64, ino: u64, size: u64, mode: u64,
    flags: u64, nlinks: u64) -> u64 {
    let have: u64 = node_find(state, m, ino)
    if have != 0 {
        nset(state, have, N_SIZE, size)
        nset(state, have, N_MODE, mode)
        nset(state, have, N_FLAGS, flags)
        nset(state, have, N_NLINKS, nlinks)
        return have
    }
    var i: u64 = 1
    while i <= MAX_NODES {
        if nget(state, i, N_MNT) == 0 {
            nset(state, i, N_MNT, m + 1)
            nset(state, i, N_INO, ino)
            nset(state, i, N_SIZE, size)
            nset(state, i, N_MODE, mode)
            nset(state, i, N_FLAGS, flags)
            nset(state, i, N_NLINKS, nlinks)
            nset(state, i, N_USE, 0)
            return i
        }
        i = i + 1
    }
    var k: u64 = 1
    while k <= MAX_NODES {
        if nget(state, k, N_USE) == 0 {
            nset(state, k, N_MNT, m + 1)
            nset(state, k, N_INO, ino)
            nset(state, k, N_SIZE, size)
            nset(state, k, N_MODE, mode)
            nset(state, k, N_FLAGS, flags)
            nset(state, k, N_NLINKS, nlinks)
            return k
        }
        k = k + 1
    }
    return 0
}

fn node_hold(state: u64, node: u64) {
    if node == 0 || node > MAX_NODES {
        return
    }
    nset(state, node, N_USE, nget(state, node, N_USE) + 1)
}

fn node_drop(state: u64, node: u64) {
    if node == 0 || node > MAX_NODES {
        return
    }
    let n: u64 = nget(state, node, N_USE)
    if n != 0 {
        nset(state, node, N_USE, n - 1)
    }
}

fn release(state: u64, m: u64) {
    var i: u64 = 1
    while i <= MAX_NODES {
        if nget(state, i, N_MNT) == m + 1 {
            zero(nd(state, i), NODE_BYTES)
        }
        i = i + 1
    }
}

fn unsauber(state: u64, m: u64) -> u64 {
    return sget(state, m, S_UNSAUBER)
}

// ------------------------------------------------------------- der Inode
fn inode_load(state: u64, m: u64, ino: u64) -> u64 {
    if ino == 0 {
        return 0
    }
    let ipg: u64 = sget(state, m, S_IPG)
    let inosz: u64 = sget(state, m, S_INOSZ)
    if ipg == 0 || inosz == 0 {
        return 0
    }
    let gruppe: u64 = (ino - 1) / ipg
    let slot: u64 = (ino - 1) % ipg
    let descsz: u64 = sget(state, m, S_DESCSZ)
    let bs: u64 = sget(state, m, S_BSIZE)

    let doff: u64 = gruppe * descsz
    let dblock: u64 = sget(state, m, S_GDBLOCK) + doff / bs
    if !block_read(state, m, dblock, buf(state, BLKBUF)) {
        return 0
    }
    let d: u64 = buf(state, BLKBUF) + (doff % bs)
    var itab: u64 = le32(d + 0x8)
    if sget(state, m, S_64BIT) != 0 && descsz >= 64 {
        itab = itab | (le32(d + 0x28) << 32)
    }
    if itab == 0 {
        return 0
    }

    let byte_off: u64 = itab * bs + slot * inosz
    let sektor: u64 = mnt.first(state, m) + byte_off / BS
    if !rd(state, m, sektor, buf(state, INOBUF)) {
        return 0
    }
    let im_sektor: u64 = byte_off % BS
    if im_sektor + inosz > BS {
        return 0
    }
    return buf(state, INOBUF) + im_sektor
}

fn ino_mode(p: u64) -> u64 {
    return le16(p + 0x00)
}

fn ino_size(p: u64) -> u64 {
    return le32(p + 0x04) | (le32(p + 0x6C) << 32)
}

fn ino_flags(p: u64) -> u64 {
    return le32(p + 0x20)
}

fn ino_nlinks(p: u64) -> u64 {
    return le16(p + 0x1A)
}

fn art_von(mode: u64) -> u64 {
    let type_bits: u64 = mode & 0xF000
    if type_bits == 0x4000 {
        return vfsops.N_DIR
    }
    if type_bits == 0xA000 {
        return vfsops.N_LNK
    }
    if type_bits == 0x8000 {
        return vfsops.N_FILE
    }
    return vfsops.N_FILE
}

// ---------------------------------------------------------- die Extents
fn extent_lookup(state: u64, m: u64, iptr: u64, lblock: u64,
    ino: u64) -> u64 {
    // ERST IM ZWISCHENSPEICHER NACHSEHEN.
    if ino != 0 && sget(state, m, S_CINO) == ino {
        let cb: u64 = sget(state, m, S_CBLOCK)
        let cl: u64 = sget(state, m, S_CLEN)
        if cl != 0 && lblock >= cb && lblock < cb + cl {
            return sget(state, m, S_CPHYS) + (lblock - cb)
        }
    }
    var node: u64 = iptr + 0x28
    var runde: u64 = 0
    while runde <= MAX_TIEFE {
        if le16(node + 0x00) != EXT_MAGIE {
            return 0
        }
        let eintraege: u64 = le16(node + 0x02)
        let tiefe: u64 = le16(node + 0x06)
        if tiefe == 0 {
            var i: u64 = 0
            while i < eintraege {
                let e: u64 = node + 12 + i * 12
                let ee_block: u64 = le32(e + 0x00)
                var ee_len: u64 = le16(e + 0x04)
                var unbeschrieben: bool = false
                if ee_len > 32768 {
                    ee_len = ee_len - 32768
                    unbeschrieben = true
                }
                if lblock >= ee_block && lblock < ee_block + ee_len {
                    if unbeschrieben {
                        return 0
                    }
                    let start: u64 = le32(e + 0x08) | (le16(e + 0x06) << 32)
                    if ino != 0 {
                        sset(state, m, S_CINO, ino)
                        sset(state, m, S_CBLOCK, ee_block)
                        sset(state, m, S_CLEN, ee_len)
                        sset(state, m, S_CPHYS, start)
                    }
                    return start + (lblock - ee_block)
                }
                i = i + 1
            }
            return 0
        }
        var gewaehlt: u64 = 0
        var i: u64 = 0
        while i < eintraege {
            let e: u64 = node + 12 + i * 12
            if le32(e + 0x00) <= lblock {
                gewaehlt = e
            }
            i = i + 1
        }
        if gewaehlt == 0 {
            return 0
        }
        let lower: u64 = le32(gewaehlt + 0x04) | (le16(gewaehlt + 0x08) << 32)
        if !block_read(state, m, lower, buf(state, NODEBUF)) {
            return 0
        }
        node = buf(state, NODEBUF)
        runde = runde + 1
    }
    return 0
}

fn block_of_indirect(state: u64, m: u64, iptr: u64, lblock: u64) -> u64 {
    let bs: u64 = sget(state, m, S_BSIZE)
    let je: u64 = bs / 4 // Blocknummern je Block
    if lblock < 12 {
        return le32(iptr + 0x28 + lblock * 4)
    }
    var rest: u64 = lblock - 12
    if rest < je {
        let ind: u64 = le32(iptr + 0x28 + 12 * 4)
        if ind == 0 || !block_read(state, m, ind, buf(state, NODEBUF)) {
            return 0
        }
        return le32(buf(state, NODEBUF) + rest * 4)
    }
    rest = rest - je
    if rest < je * je {
        let ind2: u64 = le32(iptr + 0x28 + 13 * 4)
        if ind2 == 0 || !block_read(state, m, ind2, buf(state, NODEBUF)) {
            return 0
        }
        let mitte: u64 = le32(buf(state, NODEBUF) + (rest / je) * 4)
        if mitte == 0 || !block_read(state, m, mitte, buf(state, NODEBUF)) {
            return 0
        }
        return le32(buf(state, NODEBUF) + (rest % je) * 4)
    }
    rest = rest - je * je
    let ind3: u64 = le32(iptr + 0x28 + 14 * 4)
    if ind3 == 0 || !block_read(state, m, ind3, buf(state, NODEBUF)) {
        return 0
    }
    let upper: u64 = le32(buf(state, NODEBUF) + (rest / (je * je)) * 4)
    if upper == 0 || !block_read(state, m, upper, buf(state, NODEBUF)) {
        return 0
    }
    let mitte2: u64 = le32(buf(state, NODEBUF) + ((rest / je) % je) * 4)
    if mitte2 == 0 || !block_read(state, m, mitte2, buf(state, NODEBUF)) {
        return 0
    }
    return le32(buf(state, NODEBUF) + (rest % je) * 4)
}

fn block_of(state: u64, m: u64, iptr: u64, lblock: u64, ino: u64) -> u64 {
    if (ino_flags(iptr) & 0x80000) != 0 {
        return extent_lookup(state, m, iptr, lblock, ino)
    }
    return block_of_indirect(state, m, iptr, lblock)
}

// ------------------------------------------------------- Verzeichnisse
fn dir_walk(state: u64, m: u64, dir_iptr_ino: u64, want: u64,
    out_name: u64) -> u64 {
    let iptr: u64 = inode_load(state, m, dir_iptr_ino)
    if iptr == 0 {
        return 0
    }
    if art_von(ino_mode(iptr)) != vfsops.N_DIR {
        return 0
    }
    let size: u64 = ino_size(iptr)
    let bs: u64 = sget(state, m, S_BSIZE)
    if bs == 0 {
        return 0
    }
    var seen: u64 = 0
    var lblock: u64 = 0
    while lblock * bs < size {
        let pblock: u64 = block_of(state, m, iptr, lblock,
            dir_iptr_ino)
        if pblock != 0 {
            if !block_read(state, m, pblock, buf(state, BLKBUF)) {
                return 0
            }
            let basis: u64 = buf(state, BLKBUF)
            var off: u64 = 0
            while off + 8 <= bs {
                let e: u64 = basis + off
                let ino: u64 = le32(e + 0x00)
                let reclen: u64 = le16(e + 0x04)
                let namelen: u64 = kstate.get8(e + 0x06)
                if reclen < 8 || off + reclen > bs {
                    off = bs
                } else {
                    if ino != 0 && namelen != 0 {
                        seen = seen + 1
                        var treffer: bool = false
                        if want == 0 {
                            treffer = name_eq(e + 0x08, namelen,
                                buf(state, NAMBUF))
                        } else {
                            treffer = seen == want
                        }
                        if treffer {
                            if out_name != 0 {
                                var i: u64 = 0
                                while i < namelen && i < vfsops.NAME_MAX - 1 {
                                    kstate.set8(out_name + i,
                                        kstate.get8(e + 0x08 + i) as u8)
                                    i = i + 1
                                }
                                kstate.set8(out_name + i, 0 as u8)
                            }
                            return ino
                        }
                    }
                    off = off + reclen
                }
            }
        }
        lblock = lblock + 1
    }
    return 0
}

fn name_eq(disk_name: u64, len: u64, gesucht: u64) -> bool {
    var i: u64 = 0
    while i < len {
        let c: u64 = kstate.get8(gesucht + i)
        if c == 0 {
            return false
        }
        if kstate.get8(disk_name + i) != c {
            return false
        }
        i = i + 1
    }
    return kstate.get8(gesucht + len) == 0
}

fn copy_name(dst: u64, src: u64, max: u64) -> u64 {
    var i: u64 = 0
    while kstate.get8(src + i) != 0 && i + 1 < max {
        kstate.set8(dst + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(dst + i, 0 as u8)
    return i
}

fn segment(path: u64, at: u64, out: u64, max: u64) -> u64 {
    var i: u64 = at
    while kstate.get8(path + i) == 47 {
        i = i + 1
    }
    var n: u64 = 0
    while kstate.get8(path + i) != 0 && kstate.get8(path + i) != 47 {
        if n + 1 < max {
            kstate.set8(out + n, kstate.get8(path + i) as u8)
            n = n + 1
        }
        i = i + 1
    }
    kstate.set8(out + n, 0 as u8)
    return i
}

// ==================================================== DIE VERRICHTUNGEN

fn mount_probe(state: u64, m: u64) -> u64 {
    let __f: u64 = enter(state)
    let __r: u64 = mount_probe__inner(state, m)
    leave(state, __f)
    return __r
}

fn mount_probe__inner(state: u64, m: u64) -> u64 {
    var s_nein: [u8; 24] = "ext4: nicht ext4 (\0\0\0\0\0\0"
    var s_ja: [u8; 16] = "ext4: bsize=\0\0\0\0"
    var s_i: [u8; 10] = " inodes=\0\0"
    var s_w: [u8; 40] = "ext4: WARNUNG unsauber ausgehaengt\0\0\0\0\0\0"
    sset(state, m, S_VALID, 0)
    sset(state, m, S_UNSAUBER, 0)

    let base: u64 = mnt.first(state, m)
    if !rd(state, m, base + 2, buf(state, SECBUF)) {
        return 0
    }
    let s: u64 = buf(state, SECBUF)
    if le16(s + 0x38) != MAGIE {
        serial.puts((&s_nein[0]) as u64)
        serial.dec(1)
        serial.nl()
        return 0
    }
    let logbs: u64 = le32(s + 0x18)
    if logbs > 2 {
        serial.puts((&s_nein[0]) as u64)
        serial.dec(2)
        serial.nl()
        return 0
    }
    let bs: u64 = 1024 << logbs
    let ipg: u64 = le32(s + 0x28)
    var inosz: u64 = le16(s + 0x58)
    if inosz == 0 {
        inosz = 128
    }
    if ipg == 0 || inosz < 128 || inosz > 1024 {
        serial.puts((&s_nein[0]) as u64)
        serial.dec(3)
        serial.nl()
        return 0
    }
    let inkompat: u64 = le32(s + 0x60)
    if (inkompat & INC_COMPRESSION) != 0 || (inkompat & INC_INLINE_DATA) != 0
        || (inkompat & INC_ENCRYPT) != 0 || (inkompat & INC_CASEFOLD) != 0 {
        serial.puts((&s_nein[0]) as u64)
        serial.dec(4)
        serial.nl()
        return 0
    }
    var descsz: u64 = le16(s + 0xFE)
    let ist64: u64 = inkompat & INC_64BIT
    if ist64 != 0 {
        if descsz < 64 {
            descsz = 64
        }
    } else {
        descsz = 32
    }
    let cur_first: u64 = le32(s + 0x14)
    let bloecke: u64 = le32(s + 0x04) | (le32(s + 0x150) << 32)
    if bloecke == 0 {
        serial.puts((&s_nein[0]) as u64)
        serial.dec(5)
        serial.nl()
        return 0
    }

    // ============================================================
    // DAS UNSAUBER AUSGEHAENGTE DATEISYSTEM.
    var unsauber_ist: u64 = 0
    if (inkompat & INC_RECOVER) != 0 {
        unsauber_ist = 1
    }
    // s_state Bit 0 = EXT2_VALID_FS ("sauber ausgehaengt").
    if (le16(s + 0x3A) & 1) == 0 {
        unsauber_ist = 1
    }

    sset(state, m, S_BSIZE, bs)
    sset(state, m, S_IPG, ipg)
    sset(state, m, S_INOSZ, inosz)
    sset(state, m, S_FIRST, cur_first)
    sset(state, m, S_DESCSZ, descsz)
    sset(state, m, S_BLOCKS, bloecke)
    sset(state, m, S_INCOMPAT, inkompat)
    sset(state, m, S_64BIT, ist64)
    sset(state, m, S_UNSAUBER, unsauber_ist)
    sset(state, m, S_GDBLOCK, cur_first + 1)
    sset(state, m, S_CINO, 0)
    sset(state, m, S_CBLOCK, 0)
    sset(state, m, S_CLEN, 0)
    sset(state, m, S_CPHYS, 0)
    sset(state, m, S_VALID, 1)

    let sektoren_da: u64 = mnt.blocks(state, m)
    if sektoren_da != 0 {
        let sektoren_noetig: u64 = bloecke * (bs / BS)
        if sektoren_noetig > sektoren_da {
            serial.puts((&s_nein[0]) as u64)
            serial.dec(6)
            serial.nl()
            sset(state, m, S_VALID, 0)
            return 0
        }
    }

    serial.puts((&s_ja[0]) as u64)
    serial.dec(bs)
    serial.puts((&s_i[0]) as u64)
    serial.dec(ipg)
    serial.nl()
    if unsauber_ist != 0 {
        serial.puts((&s_w[0]) as u64)
        serial.nl()
    }

    let iptr: u64 = inode_load(state, m, 2)
    if iptr == 0 {
        sset(state, m, S_VALID, 0)
        return 0
    }
    if art_von(ino_mode(iptr)) != vfsops.N_DIR {
        sset(state, m, S_VALID, 0)
        return 0
    }
    return node_get(state, m, 2, ino_size(iptr), ino_mode(iptr),
        ino_flags(iptr), ino_nlinks(iptr))
}

fn f_lookup(state: u64, m: u64, path: u64) -> u64 {
    let __f: u64 = enter(state)
    let __r: u64 = f_lookup__inner(state, m, path)
    leave(state, __f)
    return __r
}

fn f_lookup__inner(state: u64, m: u64, path: u64) -> u64 {
    tick(state)
    if sget(state, m, S_VALID) == 0 {
        return 0
    }
    var seg: [u8; 256] = [0 as u8; 256]
    var at: u64 = 0
    var ino: u64 = 2
    var going: bool = true
    while going {
        at = segment(path, at, (&seg[0]) as u64, 256)
        if kstate.get8((&seg[0]) as u64) == 0 {
            going = false
        } else {
            copy_name(buf(state, NAMBUF), (&seg[0]) as u64, 256)
            let next: u64 = dir_walk(state, m, ino, 0, 0)
            if next == 0 {
                return 0
            }
            ino = next
        }
    }
    let iptr: u64 = inode_load(state, m, ino)
    if iptr == 0 {
        return 0
    }
    return node_get(state, m, ino, ino_size(iptr), ino_mode(iptr),
        ino_flags(iptr), ino_nlinks(iptr))
}

fn f_readdir(state: u64, m: u64, dir: u64, index: u64, out: u64) -> u64 {
    let __f: u64 = enter(state)
    let __r: u64 = f_readdir__inner(state, m, dir, index, out)
    leave(state, __f)
    return __r
}

fn f_readdir__inner(state: u64, m: u64, dir: u64, index: u64,
    out: u64) -> u64 {
    tick(state)
    if dir == 0 || sget(state, m, S_VALID) == 0 {
        return 0
    }
    let ino: u64 = nget(state, dir, N_INO)
    if ino == 0 {
        return 0
    }
    let gefunden: u64 = dir_walk(state, m, ino, index + 1, out)
    if gefunden == 0 {
        return 0
    }
    let iptr: u64 = inode_load(state, m, gefunden)
    if iptr == 0 {
        return 0
    }
    let k: u64 = node_get(state, m, gefunden, ino_size(iptr), ino_mode(iptr),
        ino_flags(iptr), ino_nlinks(iptr))
    if k == 0 {
        return 0
    }
    return k
}

fn f_attr(state: u64, m: u64, node: u64, what: u64) -> u64 {
    let __f: u64 = enter(state)
    let __r: u64 = f_attr__inner(state, m, node, what)
    leave(state, __f)
    return __r
}

fn f_attr__inner(state: u64, m: u64, node: u64, what: u64) -> u64 {
    tick(state)
    if node == 0 {
        return 0
    }
    let mode: u64 = nget(state, node, N_MODE)
    if what == vfsops.A_TYPE {
        return art_von(mode)
    }
    if what == vfsops.A_SIZE {
        return nget(state, node, N_SIZE)
    }
    if what == vfsops.A_MODE {
        return mode & 0xFFF
    }
    if what == vfsops.A_NLINK {
        return nget(state, node, N_NLINKS)
    }
    if what == vfsops.A_BLKSIZE {
        return sget(state, m, S_BSIZE)
    }
    if what == vfsops.A_UID {
        return 0
    }
    if what == vfsops.A_GID {
        return 0
    }
    return 0
}

fn f_read(state: u64, m: u64, node: u64, off: u64, dst: u64,
    len: u64) -> u64 {
    let __f: u64 = enter(state)
    let __r: u64 = f_read__inner(state, m, node, off, dst, len)
    leave(state, __f)
    return __r
}

fn f_read__inner(state: u64, m: u64, node: u64, off: u64, dst: u64,
    len: u64) -> u64 {
    tick(state)
    if node == 0 || sget(state, m, S_VALID) == 0 {
        return 0
    }
    let mode: u64 = nget(state, node, N_MODE)
    let art: u64 = art_von(mode)
    if art == vfsops.N_DIR {
        return 0
    }
    let size: u64 = nget(state, node, N_SIZE)
    if off >= size {
        return 0
    }
    var want: u64 = len
    if off + want > size {
        want = size - off
    }
    let ino: u64 = nget(state, node, N_INO)
    let iptr: u64 = inode_load(state, m, ino)
    if iptr == 0 {
        return 0
    }

    if art == vfsops.N_LNK && size < 60 && (ino_flags(iptr) & 0x80000) == 0 {
        var i: u64 = 0
        while i < want {
            kstate.set8(dst + i, kstate.get8(iptr + 0x28 + off + i) as u8)
            i = i + 1
        }
        return want
    }

    let bs: u64 = sget(state, m, S_BSIZE)
    var fertig: u64 = 0
    while fertig < want {
        let pos: u64 = off + fertig
        let lblock: u64 = pos / bs
        let im_block: u64 = pos % bs
        var chunk: u64 = bs - im_block
        if chunk > want - fertig {
            chunk = want - fertig
        }
        let pblock: u64 = block_of(state, m, iptr, lblock, ino)
        if pblock == 0 {
            var i: u64 = 0
            while i < chunk {
                kstate.set8(dst + fertig + i, 0 as u8)
                i = i + 1
            }
        } else {
            if !block_read(state, m, pblock, buf(state, BLKBUF)) {
                return fertig
            }
            var i: u64 = 0
            while i < chunk {
                kstate.set8(dst + fertig + i,
                    kstate.get8(buf(state, BLKBUF) + im_block + i) as u8)
                i = i + 1
            }
        }
        fertig = fertig + chunk
    }
    return fertig
}

fn f_write(state: u64, m: u64, node: u64, off: u64, src: u64,
    len: u64) -> u64 {
    return 0
}

fn f_create(state: u64, m: u64, path: u64, art: u64) -> u64 {
    return 0
}

fn f_unlink(state: u64, m: u64, path: u64) -> u64 {
    return 9
}

fn f_rename(state: u64, m: u64, from: u64, to: u64) -> u64 {
    return 9
}

fn f_trunc(state: u64, m: u64, node: u64) -> u64 {
    return 9
}

fn ops() -> vfsops.Ops {
    return vfsops.Ops {
        lookup: f_lookup,
        readdir: f_readdir,
        attr: f_attr,
        read: f_read,
        write: f_write,
        create: f_create,
        unlink: f_unlink,
        rename: f_rename,
        trunc: f_trunc,
        mask: vfsops.OP_READONLY,
        tag: 875770213 // "ext4"
    }
}
