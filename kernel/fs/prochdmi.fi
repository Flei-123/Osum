profile kernel

import lib.procw
import lib.kstate
import drv.snd.hdmitab
import monitors.eld
import monitors.hdmipin

export { render }

static mut T0: [u8; 5] = "ctl \0"
static mut T1: [u8; 6] = " bdf=\0"
static mut T2: [u8; 8] = " owned=\0"
static mut T3: [u8; 11] = " statests=\0"
static mut T4: [u8; 9] = " codecs=\0"
static mut T5: [u8; 8] = " state=\0"
static mut T6: [u8; 8] = " fails=\0"
static mut T7: [u8; 5] = "eld \0"
static mut T8: [u8; 6] = " len=\0"
static mut T9: [u8; 14] = " valid=1 mon=\0"
static mut T10: [u8; 5] = " dp=\0"
static mut T11: [u8; 7] = " hdcp=\0"
static mut T12: [u8; 11] = " delay_ms=\0"
static mut T13: [u8; 6] = " mfg=\0"
static mut T14: [u8; 10] = " product=\0"
static mut T15: [u8; 11] = " speakers=\0"
static mut T16: [u8; 7] = " sads=\0"
static mut T17: [u8; 16] = " best_rate_bit=\0"
static mut T18: [u8; 5] = "sad \0"
static mut T19: [u8; 2] = " \0"
static mut T20: [u8; 6] = " fmt=\0"
static mut T21: [u8; 5] = " ch=\0"
static mut T22: [u8; 8] = " rates=\0"
static mut T23: [u8; 9] = " valid=0\0"
static mut T24: [u8; 8] = "eldhex \0"
static mut T25: [u8; 5] = "pin \0"
static mut T26: [u8; 6] = " ctl=\0"
static mut T27: [u8; 6] = " cad=\0"
static mut T28: [u8; 6] = " nid=\0"
static mut T29: [u8; 9] = " pincap=\0"
static mut T30: [u8; 7] = " wcap=\0"
static mut T31: [u8; 8] = " sense=\0"
static mut T32: [u8; 8] = " connn=\0"
static mut T33: [u8; 10] = " connsel=\0"
static mut T34: [u8; 9] = " pstate=\0"
static mut T35: [u8; 9] = " pinctl=\0"
static mut T36: [u8; 7] = " eapd=\0"
static mut T37: [u8; 8] = " unsol=\0"
static mut T38: [u8; 7] = " conv=\0"
static mut T39: [u8; 7] = " digi=\0"
static mut T40: [u8; 7] = " plan=\0"
static mut T41: [u8; 9] = " events=\0"
static mut T42: [u8; 12] = " synthetic=\0"
static mut T43: [u8; 21] = "hdmi v1 controllers=\0"
static mut T44: [u8; 7] = " pins=\0"
static mut T45: [u8; 8] = " scans=\0"
static mut T46: [u8; 8] = " polls=\0"
static mut T47: [u8; 16] = " sense_changes=\0"
static mut T48: [u8; 6] = "verb \0"
static mut T49: [u8; 7] = " word=\0"
static mut T50: [u8; 2] = "/\0"
static mut T51: [u8; 7] = " resp=\0"
static mut T52: [u8; 12] = " streaming=\0"
static mut T53: [u8; 8] = " strfmt=\0"
static mut T54: [u8; 7] = " strrb=\0"
static mut T55: [u8; 9] = " strwhy=\0"
static mut T56: [u8; 10] = " streams=\0"
static mut T57: [u8; 8] = " stops=\0"

fn kv(key: u64, v: u64) {
    procw.put_s(key)
    procw.put_dec(v)
}

fn kh(key: u64, v: u64) {
    procw.put_s(key)
    procw.put_hex(v, 8)
}

fn hexbyte(b: u64) {
    var d: u64 = (b >> 4) & 15
    if d < 10 {
        procw.put_c(48 + d)
    } else {
        procw.put_c(87 + d)
    }
    d = b & 15
    if d < 10 {
        procw.put_c(48 + d)
    } else {
        procw.put_c(87 + d)
    }
}

fn render_ctl(c: u64) {
    kv((&T0[0]) as u64, c)
    kh((&T1[0]) as u64, hdmitab.ctl_get(c, hdmitab.C_BDF))
    kv((&T2[0]) as u64, hdmitab.ctl_get(c, hdmitab.C_OWNED))
    kh((&T3[0]) as u64, hdmitab.ctl_get(c, hdmitab.C_STATESTS))
    kv((&T4[0]) as u64, hdmitab.ctl_get(c, hdmitab.C_CODECS))
    kv((&T5[0]) as u64, hdmitab.ctl_get(c, hdmitab.C_STATE))
    kv((&T6[0]) as u64, hdmitab.ctl_get(c, hdmitab.C_FAILS))
    procw.put_c(10)
}

fn render_eld(i: u64) {
    let e: u64 = hdmitab.eld_ptr(i)
    let n: u64 = hdmitab.pin_get(i, hdmitab.P_ELDLEN)
    kv((&T7[0]) as u64, i)
    kv((&T8[0]) as u64, n)
    if n != 0 && eld.eld_valid(e, n) {
        procw.put_s((&T9[0]) as u64)
        var k: u64 = 0
        while k < eld.eld_name_len(e) {
            let ch: u64 = eld.eld_name_at(e, k)
            if ch >= 32 && ch < 127 {
                procw.put_c(ch)
            }
            k = k + 1
        }
        var dp: u64 = 0
        if eld.eld_is_dp(e) {
            dp = 1
        }
        kv((&T10[0]) as u64, dp)
        var hd: u64 = 0
        if eld.eld_hdcp(e) {
            hd = 1
        }
        kv((&T11[0]) as u64, hd)
        kv((&T12[0]) as u64, eld.eld_sync_delay(e))
        kh((&T13[0]) as u64, eld.eld_mfg_id(e))
        kh((&T14[0]) as u64, eld.eld_product_id(e))
        kh((&T15[0]) as u64, eld.eld_speakers(e))
        kv((&T16[0]) as u64, eld.eld_sad_count(e))
        kv((&T17[0]) as u64, eld.eld_best_pcm_rate(e, n))
        procw.put_c(10)
        var j: u64 = 0
        while j < eld.eld_sad_count(e) {
            kv((&T18[0]) as u64, i)
            kv((&T19[0]) as u64, j)
            kv((&T20[0]) as u64, eld.eld_sad_format(e, j))
            kv((&T21[0]) as u64, eld.eld_sad_channels(e, j))
            kh((&T22[0]) as u64, eld.eld_sad_rates(e, j))
            procw.put_c(10)
            j = j + 1
        }
    } else {
        procw.put_s((&T23[0]) as u64)
        procw.put_c(10)
    }
    kv((&T24[0]) as u64, i)
    procw.put_c(32)
    var b: u64 = 0
    while b < n {
        hexbyte(kstate.get8(e + b))
        b = b + 1
    }
    procw.put_c(10)
}

fn render_pin(i: u64) {
    kv((&T25[0]) as u64, i)
    kv((&T26[0]) as u64, hdmitab.pin_get(i, hdmitab.P_CTL))
    kv((&T27[0]) as u64, hdmitab.pin_get(i, hdmitab.P_CAD))
    kv((&T28[0]) as u64, hdmitab.pin_get(i, hdmitab.P_NID))
    kh((&T29[0]) as u64, hdmitab.pin_get(i, hdmitab.P_PINCAP))
    kh((&T30[0]) as u64, hdmitab.pin_get(i, hdmitab.P_WCAP))
    kh((&T31[0]) as u64, hdmitab.pin_get(i, hdmitab.P_SENSE))
    kv((&T5[0]) as u64, hdmipin.pin_state(hdmitab.pin_get(i, hdmitab.P_SENSE)))
    kv((&T32[0]) as u64, hdmitab.pin_get(i, hdmitab.P_CONNN))
    kh((&T33[0]) as u64, hdmitab.pin_get(i, hdmitab.P_CONN))
    kh((&T34[0]) as u64, hdmitab.pin_get(i, hdmitab.P_PSTATE))
    kh((&T35[0]) as u64, hdmitab.pin_get(i, hdmitab.P_PINCTL))
    kh((&T36[0]) as u64, hdmitab.pin_get(i, hdmitab.P_EAPD))
    kh((&T37[0]) as u64, hdmitab.pin_get(i, hdmitab.P_UNSOL))
    kv((&T38[0]) as u64, hdmitab.pin_get(i, hdmitab.P_CONV))
    kh((&T39[0]) as u64, hdmitab.pin_get(i, hdmitab.P_CONVDIGI))
    kv((&T40[0]) as u64, hdmitab.pin_get(i, hdmitab.P_PLANLEN))
    kv((&T41[0]) as u64, hdmitab.pin_get(i, hdmitab.P_EVENTS))
    kv((&T42[0]) as u64, hdmitab.pin_get(i, hdmitab.P_SYNTH))
    kv((&T52[0]) as u64, hdmitab.pin_get(i, hdmitab.P_STREAMING))
    kh((&T53[0]) as u64, hdmitab.pin_get(i, hdmitab.P_STRFMT))
    kh((&T54[0]) as u64, hdmitab.pin_get(i, hdmitab.P_STRRB))
    kv((&T55[0]) as u64, hdmitab.pin_get(i, hdmitab.P_STRWHY))
    procw.put_c(10)
    render_eld(i)
}

fn render(out: u64, cap: u64) -> u64 {
    procw.begin(out, cap)
    kv((&T43[0]) as u64, hdmitab.ctl_count())
    kv((&T44[0]) as u64, hdmitab.pin_count())
    kv((&T45[0]) as u64, hdmitab.ctr_get(hdmitab.K_SCANS))
    kv((&T46[0]) as u64, hdmitab.ctr_get(hdmitab.K_POLLS))
    kv((&T41[0]) as u64, hdmitab.ctr_get(hdmitab.K_EVENTS))
    kv((&T47[0]) as u64, hdmitab.ctr_get(hdmitab.K_SENSECHG))
    kv((&T56[0]) as u64, hdmitab.ctr_get(hdmitab.K_STREAMS))
    kv((&T57[0]) as u64, hdmitab.ctr_get(hdmitab.K_STOPS))
    procw.put_c(10)
    var c: u64 = 0
    while c < hdmitab.ctl_count() {
        render_ctl(c)
        c = c + 1
    }
    var i: u64 = 0
    while i < hdmitab.pin_count() {
        render_pin(i)
        i = i + 1
    }
    var k: u64 = 0
    while k < hdmitab.vlog_count() {
        kv((&T48[0]) as u64, k)
        kh((&T49[0]) as u64, hdmitab.vlog_word(k) >> 16)
        procw.put_s((&T50[0]) as u64)
        procw.put_hex(hdmitab.vlog_word(k) & 0xFFFF, 4)
        procw.put_s((&T51[0]) as u64)
        procw.put_hex(hdmitab.vlog_resp(k), 8)
        procw.put_c(10)
        k = k + 1
    }
    return procw.used()
}
