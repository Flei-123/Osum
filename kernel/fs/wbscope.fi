profile kernel

import block.blk
import fs.ofsj

export { begin, begin_data, mark_struct, finish, barrier, mark_pre, order_create, mark_freed, before_alloc }

fn begin(state: u64) -> bool {
    if ofsj.enabled(state) {
        blk.wb_set_big_runs(state, false)
        return false
    }
    blk.wb_set_big_runs(state, true)
    blk.wb_begin(state)
    blk.wb_struct_lazy(state)
    return true
}

fn begin_data(state: u64) {
    if ofsj.enabled(state) {
        blk.wb_set_big_runs(state, false)
        blk.wb_begin(state)
        return
    }
    blk.wb_set_big_runs(state, true)
    blk.wb_begin_data(state)
}

fn finish(state: u64, opened: bool) -> bool {
    if !opened {
        return true
    }
    return blk.wb_end(state)
}

fn barrier(state: u64) {
    if ofsj.enabled(state) {
        return
    }
    let _ok: bool = blk.wb_flush(state)
}

fn mark_freed(state: u64) {
    if ofsj.enabled(state) {
        return
    }
    blk.wb_mark_freed(state)
}

fn before_alloc(state: u64) {
    if blk.wb_freed_pending(state) {
        barrier(state)
    }
}

fn mark_pre(state: u64, block: u64) {
    if ofsj.enabled(state) {
        return
    }
    blk.wb_mark_pre(state, block)
}

fn order_create(state: u64, inode_block: u64, meta_limit: u64) {
    if ofsj.enabled(state) {
        return
    }
    if inode_block >= meta_limit {
        barrier(state)
        return
    }
    blk.wb_set_meta(state, meta_limit)
}

fn mark_struct(state: u64) {
    if ofsj.enabled(state) {
        blk.wb_struct(state)
        return
    }
    blk.wb_struct_lazy(state)
}
