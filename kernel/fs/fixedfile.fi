profile kernel

import lib.kstate
import fs.fs

export { read, write }

const SLASH: u64 = 47
const MODE_PRIVATE: u64 = 384
const PATH_MAX: u64 = 64

fn last_slash(p: u64) -> u64 {
    var at: u64 = 0
    var i: u64 = 0
    while kstate.get8(p + i) != 0 && i < PATH_MAX {
        if kstate.get8(p + i) == SLASH {
            at = i
        }
        i = i + 1
    }
    return at
}

fn make_parent(state: u64, path: u64) {
    var dir: [u8; 64] = [0 as u8; 64]
    let cut: u64 = last_slash(path)
    if cut == 0 {
        return
    }
    var i: u64 = 0
    while i < cut {
        dir[i as usize] = kstate.get8(path + i) as u8
        i = i + 1
    }
    let d: u64 = (&dir[0]) as u64
    if fs.path(state, d) == 0 {
        let _c: u64 = fs.create_path(state, d, fs.T_DIR)
    }
}

fn read(state: u64, path: u64, dst: u64, len: u64) -> u64 {
    let ino: u64 = fs.path(state, path)
    if ino == 0 {
        return 0
    }
    return fs.read_at(state, ino, 0, dst, len)
}

fn write(state: u64, path: u64, src: u64, len: u64) -> bool {
    var ino: u64 = fs.path(state, path)
    var created: bool = false
    if ino == 0 {
        make_parent(state, path)
        ino = fs.create_path(state, path, fs.T_FILE)
        created = true
    }
    if ino == 0 {
        return false
    }
    if created {
        let _m: bool = fs.set_mode(state, ino, MODE_PRIVATE)
    }
    return fs.write_at(state, ino, 0, src, len) == len
}
