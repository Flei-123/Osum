// SPDX-License-Identifier: GPL-2.0-only
// kernel/fs.fi -- OFS, the Osum File System: from the block upwards.
//
// Built in round 62, named in round 96. The magic number in the
// superblock reads "OSUM-OFS" -- eight octets, so it fits into the one
// word `mount` compares before it believes anything else in the block.
//
// Not a "file system" in the sense of an array with names in it. This is
// the real shape, the one every Unix file system has had since 1974,
// only small:
//
//   block 0        THE SUPERBLOCK. Magic number, sizes, where everything
//                  lies. Whatever does not start with the magic number is
//                  not one of these -- `mount` refuses it, and that is
//                  the difference between a file system and a guess.
//   from block 1   THE BLOCK BITMAP. One bit per block: taken or free.
//                  SINCE OFS3 IT IS MANY BLOCKS, NOT ONE -- `SB_BITBLOCKS`
//                  says how many, each carries 4096 bits. (The sketch
//                  said "block 1", singular; that was the v2 layout and
//                  it is what point K-013 was about. 128 GiB needs
//                  65.536 of these blocks.)
//   then           THE INODES. How many and how big is in the superblock
//                  (`SB_INODES`, `SB_ISIZE` -- 256 octets since OFS3, of
//                  which the first 128 are octet for octet those of v2).
//                  An inode is the file: type, size, direct blocks and
//                  indirect ones. The NAME is not in it -- names live in
//                  directories, and that is why two names can mean the
//                  same file.
//   then           THE DATA. `SB_DATA` says where it starts.
//
// EVERY number in this sketch comes from the SUPERBLOCK at mount time,
// not from a constant in this file -- see "RUNDE OFS3" below.
//
// A DIRECTORY is a file whose contents are entries of 32 octets: eight
// for the inode number, twenty-four for the name. The root directory is
// inode 1 and contains `.` and `..` like every other one.
//
// Everything goes through `blk.fi`, block by block, never past it. That
// is what makes the same file system work on the RAM disk and on a real
// ATA disk without a line of difference -- and `tools/kernel/run.sh`
// runs it on both.
// The scratch blocks lie in the kernel data area (`kstate.FS_OFF`), not
// on the stack: a kernel stack is 8 KiB, and six blocks of 512 octets on
// it would be a third of it. Every entry point takes the interrupt flag
// down while it works with them -- on one processor that is the whole
// locking a file system needs, and it is honest about being exactly that.

import serial
import lib.kstate
import klog
import sched.sched
import sched.ctr
import block.blk
import sync.atomic
import arch.cpu
import fs.nidx
import fs.ofsj
import fs.ofsext
import sched.time

export {
    block_of, buf_sb, buf_zz, zero, get64, put64, geom_ext, geom_total, base_cover,
    base_inodes, ext_inodes, inodes_per_block, bm_blocks,
    set_size, format, mount, path, create_path, unlink_path, entry_at, ENTRY_MAX, dir_entries,
    inode_type, inode_size, read_at, write_at, file_truncate, root,
    free_blocks, used_inodes, MAGIC, T_FILE, T_DIR, DIRENT,
    NAME_LEN, INODE_COUNT, version, directs, inode_mode, inode_uid,
    inode_gid, set_mode, set_owner, set_meta, parent_ino, OFS_V1,
    OFS_V2, S_ISUID, S_ISGID, S_ISVTX, DIRECT_V1, DIRECT_V2,
    rename_path,
    enter, leave, lock_only, unlock_only, flags_nested,
    // ---- RUNDE PROTOKOLL ----
    free, ready,
    inode_count, data_start, scan, geom, entry_slot, slot_count,
    // ---------------------------------------------------- RUNDE OFS3
    OFS_V3, T_LINK, DIRENT_V3, NAME_V3, INODE_SIZE, INODE_SIZE_V3,
    dirent_size, name_len, inode_bytes, bm_start, bm_blocks, itable,
    inode_ctime, inode_mtime, inode_atime, set_times, touch_atime,
    max_file, max_blocks, format_as, path_nofollow, symlink_path,
    readlink_at, link_target_len, follows_symlinks,
    bitmap_blocks, bitmap_needed, total_blocks, SB_BITBLOCKS,
    SB_BLOCKS, SB_MAGIC, SB_DATA, SB_ITABLE, SB_INODES, SB_VERSION,
    link_path,
    // ---------------------------------------------------- RUNDE FSROBUST
    SB_JSTART, SB_JBLOCKS, journal_start, journal_blocks, journal_on,
    race_ino, race_soll, race_core,
    inode_block_of, inode_off, bm_block_of, bm_byte, ext_itable, inode_zap
}

const BS: u64 = 512 // one block
const MAGIC: u64 = 0x4F53554D2D4F4653 // "OSUM-OFS"
const INODE_SIZE: u64 = 128
const INODES_PER_BLOCK: u64 = 4
const INODE_COUNT: u64 = 128
const BITMAP_BLOCK: u64 = 1
const INODE_START: u64 = 2
const INODE_BLOCKS: u64 = 32
const DATA_START: u64 = 34
const DIRENT: u64 = 32
const NAME_LEN: u64 = 24
const INODE_SIZE_V3: u64 = 256
const IPB_V3: u64 = 2 // 512 / 256
const DIRENT_V3: u64 = 264 // 8 Oktette Inodenummer + 256 Oktette Name
const ENTRY_MAX: u64 = 264
const NAME_V3: u64 = 256
const BITS_PER_BLOCK: u64 = 4096
const DIRECT_V1: u64 = 11
const DIRECT_V2: u64 = 8
const PER_BLOCK: u64 = BS / 8 // pointers in one block: 64

const T_FREE: u64 = 0
const T_FILE: u64 = 1
const T_DIR: u64 = 2
const T_LINK: u64 = 3
const MAX_HOPS: u64 = 8

// ------------------------------------- ROUND K15, ZWEITER NACHTRAG
const G_INODES: u64 = 0
const G_DATA: u64 = 8
const G_BMSTART: u64 = 16
const G_BMBLOCKS: u64 = 24
const G_ITABLE: u64 = 32
const G_ISIZE: u64 = 40 // Oktette je Inode
const G_IHINT: u64 = 48
const G_DIRENT: u64 = 56 // Oktette je Verzeichniseintrag
const G_NAMELEN: u64 = 64
const G_HINT: u64 = 72
const G_TOTAL: u64 = 80
const G_JSTART: u64 = 88
const G_JBLOCKS: u64 = 96
const G_XBM: u64 = 104
const G_XIT: u64 = 112
const G_XIN: u64 = 120

fn base_inodes(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.FSG_OFF + G_INODES)
    if n == 0 {
        return INODE_COUNT
    }
    return n
}

fn ext_inodes(state: u64) -> u64 {
    return kstate.get(state, kstate.FSG_OFF + G_XIN)
}

fn ext_itable(state: u64) -> u64 {
    return kstate.get(state, kstate.FSG_OFF + G_XIT)
}

fn inode_count(state: u64) -> u64 {
    return base_inodes(state) + ext_inodes(state)
}

fn geom_ext(state: u64, xbm: u64, xit: u64, xin: u64) {
    kstate.set(state, kstate.FSG_OFF + G_XBM, xbm)
    kstate.set(state, kstate.FSG_OFF + G_XIT, xit)
    kstate.set(state, kstate.FSG_OFF + G_XIN, xin)
}

fn ext_bm_blocks(state: u64) -> u64 {
    if kstate.get(state, kstate.FSG_OFF + G_XBM) == 0 {
        return 0
    }
    let total: u64 = kstate.get(state, kstate.FSG_OFF + G_TOTAL)
    let cover: u64 = base_cover(state)
    if total <= cover {
        return 0
    }
    return ofsext.bm_blocks_for(total - cover)
}

fn data_start(state: u64) -> u64 {
    let d: u64 = kstate.get(state, kstate.FSG_OFF + G_DATA)
    if d == 0 {
        return DATA_START
    }
    return d
}

fn geom(state: u64, inodes: u64, data: u64) {
    kstate.set(state, kstate.FSG_OFF + G_INODES, inodes)
    kstate.set(state, kstate.FSG_OFF + G_DATA, data)
}

// ---------------------------------------------------------- RUNDE OFS3
fn bm_start(state: u64) -> u64 {
    let v: u64 = kstate.get(state, kstate.FSG_OFF + G_BMSTART)
    if v == 0 {
        return BITMAP_BLOCK
    }
    return v
}

fn bm_blocks(state: u64) -> u64 {
    let v: u64 = kstate.get(state, kstate.FSG_OFF + G_BMBLOCKS)
    if v == 0 {
        return 1
    }
    return v
}

fn bitmap_blocks(state: u64) -> u64 {
    return bm_blocks(state)
}

fn bitmap_needed(n: u64) -> u64 {
    return (n + BITS_PER_BLOCK - 1) / BITS_PER_BLOCK
}

fn geom_j(state: u64, js: u64, jb: u64) {
    kstate.set(state, kstate.FSG_OFF + G_JSTART, js)
    kstate.set(state, kstate.FSG_OFF + G_JBLOCKS, jb)
}

fn geom_total(state: u64, n: u64) {
    kstate.set(state, kstate.FSG_OFF + G_TOTAL, n)
}

fn total_blocks(state: u64) -> u64 {
    let dev: u64 = blk.blocks(state)
    let n: u64 = kstate.get(state, kstate.FSG_OFF + G_TOTAL)
    if n == 0 || n > dev {
        return dev
    }
    return n
}

fn itable(state: u64) -> u64 {
    let v: u64 = kstate.get(state, kstate.FSG_OFF + G_ITABLE)
    if v == 0 {
        return INODE_START
    }
    return v
}

fn inode_bytes(state: u64) -> u64 {
    let v: u64 = kstate.get(state, kstate.FSG_OFF + G_ISIZE)
    if v == 0 {
        return INODE_SIZE
    }
    return v
}

fn inodes_per_block(state: u64) -> u64 {
    return BS / inode_bytes(state)
}

fn dirent_size(state: u64) -> u64 {
    let v: u64 = kstate.get(state, kstate.FSG_OFF + G_DIRENT)
    if v == 0 {
        return DIRENT
    }
    return v
}

fn name_len(state: u64) -> u64 {
    let v: u64 = kstate.get(state, kstate.FSG_OFF + G_NAMELEN)
    if v == 0 {
        return NAME_LEN
    }
    return v
}

fn geom3(state: u64, bms: u64, bmb: u64, itab: u64, isz: u64,
    dent: u64, nlen: u64) {
    kstate.set(state, kstate.FSG_OFF + G_BMSTART, bms)
    kstate.set(state, kstate.FSG_OFF + G_BMBLOCKS, bmb)
    kstate.set(state, kstate.FSG_OFF + G_ITABLE, itab)
    kstate.set(state, kstate.FSG_OFF + G_ISIZE, isz)
    kstate.set(state, kstate.FSG_OFF + G_IHINT, 0)
    geom_ext(state, 0, 0, 0)
    kstate.set(state, kstate.FSG_OFF + G_DIRENT, dent)
    kstate.set(state, kstate.FSG_OFF + G_NAMELEN, nlen)
    kstate.set(state, kstate.FSG_OFF + G_HINT, 0)
}

fn base_cover(state: u64) -> u64 {
    return bm_blocks(state) * BITS_PER_BLOCK
}

fn max_blocks(state: u64) -> u64 {
    return (bm_blocks(state) + ext_bm_blocks(state)) * BITS_PER_BLOCK
}

fn max_file(state: u64) -> u64 {
    var n: u64 = directs(state) + PER_BLOCK + PER_BLOCK * PER_BLOCK
    if version(state) >= OFS_V3 {
        n = n + PER_BLOCK * PER_BLOCK * PER_BLOCK
        n = n + PER_BLOCK * PER_BLOCK * PER_BLOCK * PER_BLOCK
    }
    return n * BS
}

fn follows_symlinks(state: u64) -> bool {
    return !kstate.mode_on(state, kstate.O_NOLINKS)
}

// The fields of an inode.
const I_TYPE: u64 = 0
const I_SIZE: u64 = 8
const I_NLINK: u64 = 16
const I_DIRECT: u64 = 24 // eight of them from OFS 2 on, eleven before
const I_INDIRECT: u64 = 112
const I_DINDIRECT: u64 = 120 // round K4: 64 blocks of 64 pointers
const I_TINDIRECT: u64 = 128 // dreifach indirekt: 64 * 64 * 64 Bloecke
const I_CTIME: u64 = 136
const I_MTIME: u64 = 144 // zuletzt geschrieben
const I_ATIME: u64 = 152 // zuletzt gelesen
const I_QINDIRECT: u64 = 160 // quad indirect: 64^4 blocks, OFS 3 only
const I_MODE: u64 = 88
const I_UID: u64 = 96
const I_GID: u64 = 104

const S_ISUID: u64 = 2048
const S_ISGID: u64 = 1024 // 0o2000
const S_ISVTX: u64 = 512 // 0o1000

// The fields of the superblock.
const SB_MAGIC: u64 = 0
const SB_BSIZE: u64 = 8
const SB_BLOCKS: u64 = 16
const SB_INODES: u64 = 24
const SB_BITMAP: u64 = 32
const SB_ITABLE: u64 = 40
const SB_DATA: u64 = 48
const SB_ROOT: u64 = 56
const SB_VERSION: u64 = 64
const SB_BMBLOCKS: u64 = 72
const SB_ISIZE: u64 = 80
const SB_DIRENT: u64 = 88
const SB_NAMELEN: u64 = 96
const SB_BITBLOCKS: u64 = 72
// ------------------------------------------------------ RUNDE FSROBUST
const SB_JSTART: u64 = 104
const SB_JBLOCKS: u64 = 112
const OFS_V1: u64 = 1
const OFS_V2: u64 = 2
const OFS_V3: u64 = 3

// ------------------------------------------------------ the scratch area

// ------------------------------------------------------------ round K5
//
// EVERY CRITICAL SECTION OF THIS FILE GETS A LOCK. Up to round K2 the six
// places below made do with `sched.irq_save` -- turning interrupts off,
// which keeps this core's own handlers out of a half-written superblock
// and keeps NOTHING out on a machine with four cores. The pairs were
// already there and already correct, so the change is one word each: the
// same places now take `atomic.L_FS` as well.
//
// The lock is never held while another lock is taken. `blk.fi` and the
// two drivers under it have none of their own, and nothing in this file
// calls the scheduler between `enter` and `leave` -- which is the rule
// that makes this kernel's locks unable to deadlock (see
// sched.fi::create).
//
// IT IS HELD WHILE THE SAME LOCK IS TAKEN AGAIN, THOUGH, and the first
// version of this round deadlocked on exactly that: `format` writes the
// root directory through `dir_init`, which writes through `write_at`,
// which is one of the six entry points that take the lock. The core sat
// waiting for a lock it was holding itself, with interrupts off, and the
// machine went quiet at "fs: format ".
//
// So the pair below is RE-ENTRANT on the same core: if the lock already
// belongs to this core, the nested call only notes that it must not give
// it back. That is safe to decide by reading the owner word, because
// interrupts are off from the line above -- no other core can have
// written THIS core's number into it. Bit 63 of the saved flags carries
// the note; the processor never sets it, and `sched.irq_restore` only
// looks at bit 9.
const NESTED: u64 = 0x8000000000000000

fn free(state: u64) -> bool {
    return atomic.lock_owner(state, atomic.L_FS) != cpu.here(state) + 1
}

fn ready(state: u64) -> bool {
    return kstate.get(state, kstate.FS_READY) != 0
}

fn enter(state: u64) -> u64 {
    let flags: u64 = sched.irq_save()
    let me: u64 = cpu.here(state)
    if atomic.lock_owner(state, atomic.L_FS) == me + 1 {
        ofsj.begin(state)
        return flags | NESTED
    }
    atomic.lock_take(state, atomic.L_FS, me)
    ofsj.begin(state)
    return flags
}

fn leave(state: u64, flags: u64) {
    ofsj.commit(state)
    if (flags & NESTED) == 0 {
        atomic.lock_give(state, atomic.L_FS)
    }
    sched.irq_restore(flags)
}

fn lock_only(state: u64) -> u64 {
    let flags: u64 = sched.irq_save()
    let me: u64 = cpu.here(state)
    if atomic.lock_owner(state, atomic.L_FS) == me + 1 {
        return flags | NESTED
    }
    atomic.lock_take(state, atomic.L_FS, me)
    return flags
}

fn unlock_only(state: u64, flags: u64) {
    if (flags & NESTED) == 0 {
        atomic.lock_give(state, atomic.L_FS)
    }
    sched.irq_restore(flags)
}

fn flags_nested(flags: u64) -> bool {
    return (flags & NESTED) != 0
}

fn buf_sb(state: u64) -> u64 {
    return state + kstate.FS_OFF
}

fn buf_in(state: u64) -> u64 {
    return state + kstate.FS_OFF + 512
}

fn buf_dt(state: u64) -> u64 {
    return state + kstate.FS_OFF + 1024
}

fn buf_bm(state: u64) -> u64 {
    return state + kstate.FS_OFF + 1536
}

fn buf_ib(state: u64) -> u64 {
    return state + kstate.FS_OFF + 2048
}

fn buf_nm(state: u64) -> u64 {
    return state + kstate.FS_OFF + 2560
}

fn buf_zz(state: u64) -> u64 {
    return state + kstate.FS_OFF + 3072
}

// Round K4: the SECOND level of the double indirect block. It cannot share
// a buffer with `buf_ib` -- walking two levels means holding both -- and it
// cannot be `buf_zz` either, because `block_alloc` writes into that one to
// zero a fresh block.
fn buf_i2(state: u64) -> u64 {
    return state + kstate.FS_OFF + 3584
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, 0 as u8)
        i = i + 1
    }
}

fn copy(from: u64, to: u64, n: u64) {
    var i: u64 = 0
    // LA-9: whole words when source, destination and length are 8-aligned (a byte loop cost ~5 ns per byte in the read path)
    if ((from | to | n) & 7) == 0 {
        while i < n {
            __mmio_write64((to + i) as *mut u64, __mmio_read64((from + i) as *mut u64))
            i = i + 8
        }
        return
    }
    while i < n {
        kstate.set8(to + i, kstate.get8(from + i) as u8)
        i = i + 1
    }
}

fn get64(p: u64) -> u64 {
    return __mmio_read64(p as *mut u64)
}

fn put64(p: u64, v: u64) {
    __mmio_write64(p as *mut u64, v)
}

fn root(state: u64) -> u64 {
    return kstate.get(state, kstate.FS_ROOT)
}

// ---------------------------------------------------------- Runde K13

fn version(state: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_FORCEV2) {
        return OFS_V2
    }
    let v: u64 = kstate.get(state, kstate.K13_OFF + kstate.U_FSVER)
    if v == 0 {
        return OFS_V1
    }
    return v
}

fn directs(state: u64) -> u64 {
    if version(state) >= OFS_V2 {
        return DIRECT_V2
    }
    return DIRECT_V1
}

// ---------------------------------------------------------- RUNDE OFS3
fn inode_ctime(state: u64, ino: u64) -> u64 {
    if version(state) < OFS_V3 {
        return 0
    }
    return inode_get(state, ino, I_CTIME)
}

fn inode_mtime(state: u64, ino: u64) -> u64 {
    if version(state) < OFS_V3 {
        return 0
    }
    return inode_get(state, ino, I_MTIME)
}

fn inode_atime(state: u64, ino: u64) -> u64 {
    if version(state) < OFS_V3 {
        return 0
    }
    return inode_get(state, ino, I_ATIME)
}

fn now(state: u64) -> u64 {
    return time.now_sec(state)
}

fn set_times(state: u64, ino: u64, c: u64, m: u64, a: u64) -> bool {
    if version(state) < OFS_V3 {
        return false
    }
    if ino == 0 || ino > inode_count(state) {
        return false
    }
    let flags: u64 = enter(state)
    if !ofsj.read(state, inode_block_of(state, ino), buf_in(state)) {
        leave(state, flags)
        return false
    }
    let at: u64 = buf_in(state) + inode_off(state, ino)
    if c != 0 {
        put64(at + I_CTIME, c)
    }
    if m != 0 {
        put64(at + I_MTIME, m)
    }
    if a != 0 {
        put64(at + I_ATIME, a)
    }
    let r: bool = ofsj.write(state, inode_block_of(state, ino), buf_in(state))
    leave(state, flags)
    return r
}

fn touch_atime(state: u64, ino: u64) {
    if version(state) < OFS_V3 {
        return
    }
    if kstate.mode_on(state, kstate.O_NOATIME) {
        return
    }
    let nun: u64 = now(state)
    if nun == 0 {
        return
    }
    // r1181: RELATIME. The old rule (write whenever the second changed) made every poller that opens a config file once a
    // second cost one journalled inode write per file and second (measured: the taskbar alone, ~4.4 sector writes/s = 1139
    // outw/s of PIO in an idle desktop). Like Linux `relatime`: write only when the access time is not newer than the
    // modification/creation time (the first read after a change) or is older than a day. A stamp from the FUTURE (image
    // built on a host whose clock is ahead, RTC zone not known yet) says nothing about "changed since" and is ignored.
    let at: u64 = inode_get(state, ino, I_ATIME)
    let mt: u64 = inode_get(state, ino, I_MTIME)
    let ct: u64 = inode_get(state, ino, I_CTIME)
    if at != 0 && at <= nun && nun - at < ATIME_STALE && (mt > nun || at > mt) && (ct > nun || at > ct) {
        return
    }
    set_times(state, ino, 0, 0, nun)
}
const ATIME_STALE: u64 = 86400

fn touch_mtime(state: u64, ino: u64) {
    if version(state) < OFS_V3 {
        return
    }
    let nun: u64 = now(state)
    if nun == 0 || inode_get(state, ino, I_MTIME) == nun {
        return
    }
    set_times(state, ino, 0, nun, 0)
}

fn inode_mode(state: u64, ino: u64) -> u64 {
    if version(state) < OFS_V2 {
        return 493 // 0o755
    }
    return inode_get(state, ino, I_MODE) & 4095
}

fn inode_uid(state: u64, ino: u64) -> u64 {
    if version(state) < OFS_V2 {
        return 0
    }
    return inode_get(state, ino, I_UID)
}

fn inode_gid(state: u64, ino: u64) -> u64 {
    if version(state) < OFS_V2 {
        return 0
    }
    return inode_get(state, ino, I_GID)
}

fn set_mode(state: u64, ino: u64, mode: u64) -> bool {
    if version(state) < OFS_V2 {
        return false
    }
    let flags: u64 = enter(state)
    let r: bool = inode_set(state, ino, I_MODE, mode & 4095)
    leave(state, flags)
    return r
}

fn set_owner(state: u64, ino: u64, uid: u64, gid: u64) -> bool {
    if version(state) < OFS_V2 {
        return false
    }
    let flags: u64 = enter(state)
    var r: bool = true
    if uid != (0 -% 1) {
        r = inode_set(state, ino, I_UID, uid)
    }
    if r && gid != (0 -% 1) {
        r = inode_set(state, ino, I_GID, gid)
    }
    leave(state, flags)
    return r
}

fn set_meta(state: u64, ino: u64, mode: u64, uid: u64, gid: u64) -> bool {
    if version(state) < OFS_V2 {
        return false
    }
    let flags: u64 = enter(state)
    var r: bool = inode_set(state, ino, I_MODE, mode & 4095)
    if r {
        r = inode_set(state, ino, I_UID, uid)
    }
    if r {
        r = inode_set(state, ino, I_GID, gid)
    }
    leave(state, flags)
    return r
}

// ---------------------------------------------------------- the inodes

fn inode_slot(state: u64, ino: u64) -> u64 {
    let base: u64 = base_inodes(state)
    if ino <= base {
        return ino - 1
    }
    return ino - 1 - base
}

fn inode_block_of(state: u64, ino: u64) -> u64 {
    let slot: u64 = inode_slot(state, ino) / inodes_per_block(state)
    if ino <= base_inodes(state) {
        return itable(state) + slot
    }
    return kstate.get(state, kstate.FSG_OFF + G_XIT) + slot
}

fn inode_off(state: u64, ino: u64) -> u64 {
    return (inode_slot(state, ino) % inodes_per_block(state)) * inode_bytes(state)
}

//     desk: start /bin/taskbar  pid=0
//     elf: refused, reason 1  no such file
//     desk: start /bin/launcher pid=0
//     elf: refused, reason 2  not a plain file
fn inode_get(state: u64, ino: u64, field: u64) -> u64 {
    if ino == 0 || ino > inode_count(state) {
        return 0
    }
    let flags: u64 = enter(state)
    var v: u64 = 0
    if ofsj.read(state, inode_block_of(state, ino), buf_in(state)) {
        v = get64(buf_in(state) + inode_off(state, ino) + field)
    }
    leave(state, flags)
    return v
}

fn inode_set(state: u64, ino: u64, field: u64, v: u64) -> bool {
    if ino == 0 || ino > inode_count(state) {
        return false
    }
    let flags: u64 = enter(state)
    var ok: bool = false
    if ofsj.read(state, inode_block_of(state, ino), buf_in(state)) {
        put64(buf_in(state) + inode_off(state, ino) + field, v)
        ok = ofsj.write(state, inode_block_of(state, ino), buf_in(state))
    }
    leave(state, flags)
    return ok
}

fn inode_type(state: u64, ino: u64) -> u64 {
    return inode_get(state, ino, I_TYPE)
}

fn inode_size(state: u64, ino: u64) -> u64 {
    return inode_get(state, ino, I_SIZE)
}

fn inode_get_blind(state: u64, ino: u64, field: u64) -> u64 {
    if ino == 0 || ino > inode_count(state) {
        return 0
    }
    if !ofsj.read(state, inode_block_of(state, ino), buf_in(state)) {
        return 0
    }
    return get64(buf_in(state) + inode_off(state, ino) + field)
}

fn race_ino(state: u64, index: u64) -> u64 {
    let ipb: u64 = inodes_per_block(state)
    if ipb == 0 {
        return 1
    }
    let ino: u64 = 1 + index * ipb
    if ino == 0 || ino > inode_count(state) {
        return 1
    }
    return ino
}

fn race_soll(state: u64, index: u64) -> u64 {
    return inode_get(state, race_ino(state, index), I_TYPE)
}

fn race_core(state: u64, index: u64, soll: u64, runden: u64,
    blind: bool) -> u64 {
    let ino: u64 = race_ino(state, index)
    var errors: u64 = 0
    var i: u64 = 0
    while i < runden {
        var v: u64 = 0
        if blind {
            v = inode_get_blind(state, ino, I_TYPE)
        } else {
            v = inode_get(state, ino, I_TYPE)
        }
        if v != soll {
            errors = errors + 1
        }
        i = i + 1
    }
    return errors
}

// A whole inode at once: cheaper than eighteen single writes, and it is
// the only way a new inode gets a clean state.
fn inode_init(state: u64, ino: u64, kind: u64) -> bool {
    let flags: u64 = enter(state)
    if !ofsj.read(state, inode_block_of(state, ino), buf_in(state)) {
        leave(state, flags)
        return false
    }
    let at: u64 = buf_in(state) + inode_off(state, ino)
    zero(at, inode_bytes(state))
    put64(at + I_TYPE, kind)
    put64(at + I_NLINK, 1)
    if version(state) >= OFS_V3 {
        let nun: u64 = now(state)
        put64(at + I_CTIME, nun)
        put64(at + I_MTIME, nun)
        put64(at + I_ATIME, nun)
    }
    let ok: bool = ofsj.write(state, inode_block_of(state, ino),
        buf_in(state))
    leave(state, flags)
    return ok
}

fn inode_zap(state: u64, ino: u64) -> bool {
    if ino == 0 || ino > inode_count(state) {
        return false
    }
    let flags: u64 = enter(state)
    if !ofsj.read(state, inode_block_of(state, ino), buf_in(state)) {
        leave(state, flags)
        return false
    }
    let at: u64 = buf_in(state) + inode_off(state, ino)
    zero(at, inode_bytes(state))
    put64(at + I_TYPE, T_FILE)
    put64(at + I_NLINK, 1)
    if version(state) >= OFS_V2 {
        put64(at + I_MODE, 420)
    }
    if version(state) >= OFS_V3 {
        let t: u64 = now(state)
        put64(at + I_CTIME, t)
        put64(at + I_MTIME, t)
        put64(at + I_ATIME, t)
    }
    let ok: bool = ofsj.write(state, inode_block_of(state, ino), buf_in(state))
    leave(state, flags)
    return ok
}

fn inode_scan_free(state: u64, from: u64, to: u64) -> u64 {
    var ino: u64 = from
    while ino <= to {
        if inode_get(state, ino, I_TYPE) == T_FREE {
            return ino
        }
        ino = ino + 1
    }
    return 0
}

fn inode_alloc(state: u64, kind: u64) -> u64 {
    let last: u64 = inode_count(state)
    var start: u64 = kstate.get(state, kstate.FSG_OFF + G_IHINT)
    if start < 1 || start > last {
        start = 1
    }
    var ino: u64 = inode_scan_free(state, start, last)
    if ino == 0 && start > 1 {
        ino = inode_scan_free(state, 1, start - 1)
    }
    if ino == 0 {
        return 0
    }
    if !inode_init(state, ino, kind) {
        return 0
    }
    kstate.set(state, kstate.FSG_OFF + G_IHINT, ino + 1)
    return ino
}

fn inode_release(state: u64, ino: u64) -> bool {
    let hint: u64 = kstate.get(state, kstate.FSG_OFF + G_IHINT)
    if hint != 0 && ino < hint {
        kstate.set(state, kstate.FSG_OFF + G_IHINT, ino)
    }
    return inode_set(state, ino, I_TYPE, T_FREE)
}

fn used_in_region(state: u64, first: u64, count: u64) -> u64 {
    var n: u64 = 0
    var b: u64 = 0
    let ipb: u64 = inodes_per_block(state)
    let isz: u64 = inode_bytes(state)
    while b * ipb < count {
        if ofsj.read(state, first + b, buf_in(state)) {
            var k: u64 = 0
            while k < ipb && b * ipb + k < count {
                if get64(buf_in(state) + k * isz + I_TYPE) != T_FREE {
                    n = n + 1
                }
                k = k + 1
            }
        }
        b = b + 1
    }
    return n
}

fn used_inodes(state: u64) -> u64 {
    let flags: u64 = enter(state)
    let n: u64 = used_in_region(state, itable(state), base_inodes(state))
        + used_in_region(state, kstate.get(state, kstate.FSG_OFF + G_XIT),
            ext_inodes(state))
    leave(state, flags)
    return n
}

// ---------------------------------------------------------- the bitmap

// ---------------------------------------------------------- RUNDE OFS3
fn bm_block_of(state: u64, b: u64) -> u64 {
    let cover: u64 = base_cover(state)
    if b < cover {
        return bm_start(state) + b / BITS_PER_BLOCK
    }
    return kstate.get(state, kstate.FSG_OFF + G_XBM) + (b - cover) / BITS_PER_BLOCK
}

fn bm_byte(b: u64) -> u64 {
    return (b % BITS_PER_BLOCK) / 8
}

fn block_alloc(state: u64) -> u64 {
    let last: u64 = total_blocks(state)
    var lim: u64 = max_blocks(state)
    if last < lim {
        lim = last
    }
    let von: u64 = data_start(state)
    if von >= lim {
        return 0
    }
    var start: u64 = kstate.get(state, kstate.FSG_OFF + G_HINT)
    if start < von || start >= lim {
        start = von
    }
    let got: u64 = search_free(state, start, lim)
    if got != 0 {
        return got
    }
    return search_free(state, von, start)
}

fn search_free(state: u64, von: u64, bis: u64) -> u64 {
    var b: u64 = von
    while b < bis {
        let kb: u64 = bm_block_of(state, b)
        if !ofsj.read(state, kb, buf_bm(state)) {
            return 0
        }
        var ende: u64 = (b / BITS_PER_BLOCK + 1) * BITS_PER_BLOCK
        if ende > bis {
            ende = bis
        }
        var fund: u64 = 0
        while b < ende && fund == 0 {
            let p: u64 = buf_bm(state) + bm_byte(b)
            if (kstate.get8(p) & (1 << (b % 8))) == 0 {
                kstate.set8(p, (kstate.get8(p) | (1 << (b % 8))) as u8)
                fund = b
            } else {
                b = b + 1
            }
        }
        if fund != 0 {
            if !ofsj.write(state, kb, buf_bm(state)) {
                return 0
            }
            kstate.set(state, kstate.FSG_OFF + G_HINT, fund)
            zero(buf_zz(state), BS)
            ofsj.write(state, fund, buf_zz(state))
            return fund
        }
    }
    return 0
}

const FB_NONE: u64 = 0xFFFFFFFFFFFFFFFF

static mut fb_on: u64 = 0
static mut fb_kb: u64 = 0xFFFFFFFFFFFFFFFF

fn free_flush(state: u64) -> bool {
    if fb_kb == FB_NONE {
        return true
    }
    let kb: u64 = fb_kb
    fb_kb = FB_NONE
    return ofsj.write(state, kb, buf_bm(state))
}

fn free_batch_begin() {
    fb_on = 1
    fb_kb = FB_NONE
}

fn free_batch_end(state: u64) {
    let _ok: bool = free_flush(state)
    fb_on = 0
}

fn block_free(state: u64, b: u64) {
    if b < data_start(state) || b >= total_blocks(state) {
        return
    }
    if b >= max_blocks(state) {
        return
    }
    let kb: u64 = bm_block_of(state, b)
    if fb_on != 0 {
        if fb_kb != kb {
            if !free_flush(state) || !ofsj.read(state, kb, buf_bm(state)) {
                return
            }
            fb_kb = kb
        }
    } else if !ofsj.read(state, kb, buf_bm(state)) {
        return
    }
    let p: u64 = buf_bm(state) + bm_byte(b)
    kstate.set8(p, (kstate.get8(p) & (255 ^ (1 << (b % 8)))) as u8)
    if fb_on == 0 {
        ofsj.write(state, kb, buf_bm(state))
    }
    if b < kstate.get(state, kstate.FSG_OFF + G_HINT) {
        kstate.set(state, kstate.FSG_OFF + G_HINT, b)
    }
}

fn free_blocks(state: u64) -> u64 {
    let flags: u64 = enter(state)
    let last: u64 = total_blocks(state)
    var lim: u64 = max_blocks(state)
    if last < lim {
        lim = last
    }
    var n: u64 = 0
    var b: u64 = 0
    while b < lim {
        let kb: u64 = bm_block_of(state, b)
        if !ofsj.read(state, kb, buf_bm(state)) {
            leave(state, flags)
            return n
        }
        var ende: u64 = (b / BITS_PER_BLOCK + 1) * BITS_PER_BLOCK
        if ende > lim {
            ende = lim
        }
        while b < ende {
            let rest: u64 = ende - b
            if (b % 8) == 0 && rest >= 8 {
                let o: u64 = kstate.get8(buf_bm(state) + bm_byte(b))
                if o == 0 {
                    n = n + 8
                } else if o != 255 {
                    var k: u64 = 0
                    while k < 8 {
                        if (o & (1 << k)) == 0 {
                            n = n + 1
                        }
                        k = k + 1
                    }
                }
                b = b + 8
            } else {
                if (kstate.get8(buf_bm(state) + bm_byte(b))
                    & (1 << (b % 8))) == 0 {
                    n = n + 1
                }
                b = b + 1
            }
        }
    }
    leave(state, flags)
    return n
}

// The `index`-th block of a file. With `grow` a missing one is created --
// that is what makes a file grow.
fn block_of(state: u64, ino: u64, index: u64) -> u64 {
    let flags: u64 = enter(state)
    let b: u64 = file_block(state, ino, index, false)
    leave(state, flags)
    return b
}

fn file_block(state: u64, ino: u64, index: u64, grow: bool) -> u64 {
    let dn: u64 = directs(state)
    if index < dn {
        let b: u64 = inode_get(state, ino, I_DIRECT + index * 8)
        if b != 0 || !grow {
            return b
        }
        let fresh: u64 = block_alloc(state)
        if fresh == 0 {
            return 0
        }
        inode_set(state, ino, I_DIRECT + index * 8, fresh)
        return fresh
    }
    let k: u64 = index - dn
    if k < PER_BLOCK {
        return single_block(state, ino, k, grow)
    }
    let d: u64 = k - PER_BLOCK
    if d < PER_BLOCK * PER_BLOCK {
        return double_block(state, ino, d, grow)
    }
    if version(state) < OFS_V3 {
        return 0
    }
    let t: u64 = d - PER_BLOCK * PER_BLOCK
    if t < PER_BLOCK * PER_BLOCK * PER_BLOCK {
        return triple_block(state, ino, t, grow)
    }
    let q: u64 = t - PER_BLOCK * PER_BLOCK * PER_BLOCK
    if q >= PER_BLOCK * PER_BLOCK * PER_BLOCK * PER_BLOCK {
        return 0
    }
    return quad_block(state, ino, q, grow)
}

fn quad_block(state: u64, ino: u64, q: u64, grow: bool) -> u64 {
    var l1: u64 = inode_get(state, ino, I_QINDIRECT)
    if l1 == 0 {
        if !grow {
            return 0
        }
        l1 = block_alloc(state)
        if l1 == 0 {
            return 0
        }
        inode_set(state, ino, I_QINDIRECT, l1)
    }
    let l2: u64 = walk_level(state, l1, q / (PER_BLOCK * PER_BLOCK * PER_BLOCK), grow)
    if l2 == 0 {
        return 0
    }
    let l3: u64 = walk_level(state, l2, (q / (PER_BLOCK * PER_BLOCK)) % PER_BLOCK, grow)
    if l3 == 0 {
        return 0
    }
    let l4: u64 = walk_level(state, l3, (q / PER_BLOCK) % PER_BLOCK, grow)
    if l4 == 0 {
        return 0
    }
    return walk_level(state, l4, q % PER_BLOCK, grow)
}

fn ptr_at(state: u64, block: u64, k: u64) -> u64 {
    if !ofsj.read(state, block, buf_ib(state)) {
        return 0
    }
    return get64(buf_ib(state) + k * 8)
}

fn free_quad(state: u64, q1: u64) {
    var k1: u64 = 0
    while k1 < PER_BLOCK {
        let q2: u64 = ptr_at(state, q1, k1)
        if q2 != 0 {
            var k2: u64 = 0
            while k2 < PER_BLOCK {
                let q3: u64 = ptr_at(state, q2, k2)
                if q3 != 0 {
                    var k3: u64 = 0
                    while k3 < PER_BLOCK {
                        let q4: u64 = ptr_at(state, q3, k3)
                        if q4 != 0 {
                            free_dt(state, q4)
                            block_free(state, q4)
                        }
                        k3 = k3 + 1
                    }
                    block_free(state, q3)
                }
                k2 = k2 + 1
            }
            block_free(state, q2)
        }
        k1 = k1 + 1
    }
    block_free(state, q1)
}

// The block behind the ONE indirect pointer of the inode: 64 of them.
fn single_block(state: u64, ino: u64, k: u64, grow: bool) -> u64 {
    var ib: u64 = inode_get(state, ino, I_INDIRECT)
    if ib == 0 {
        if !grow {
            return 0
        }
        ib = block_alloc(state)
        if ib == 0 {
            return 0
        }
        inode_set(state, ino, I_INDIRECT, ib)
    }
    if !ofsj.read(state, ib, buf_ib(state)) {
        return 0
    }
    let b: u64 = get64(buf_ib(state) + k * 8)
    if b != 0 || !grow {
        return b
    }
    let fresh: u64 = block_alloc(state)
    if fresh == 0 {
        return 0
    }
    if !ofsj.read(state, ib, buf_ib(state)) {
        return 0
    }
    put64(buf_ib(state) + k * 8, fresh)
    ofsj.write(state, ib, buf_ib(state))
    return fresh
}

// ROUND K4: two levels. The block of the inode holds 64 pointers to
// blocks, and each of THOSE holds 64 pointers to data -- 4096 blocks, and
// with them the ceiling that made this round necessary is gone. Every
// allocation happens BEFORE the buffer it belongs in is read: `block_alloc`
// writes a block of its own, and a buffer held across it would come back
// changed.
fn double_block(state: u64, ino: u64, d: u64, grow: bool) -> u64 {
    var l1: u64 = inode_get(state, ino, I_DINDIRECT)
    if l1 == 0 {
        if !grow {
            return 0
        }
        l1 = block_alloc(state)
        if l1 == 0 {
            return 0
        }
        inode_set(state, ino, I_DINDIRECT, l1)
    }
    if !ofsj.read(state, l1, buf_ib(state)) {
        return 0
    }
    let slot: u64 = d / PER_BLOCK
    var l2: u64 = get64(buf_ib(state) + slot * 8)
    if l2 == 0 {
        if !grow {
            return 0
        }
        l2 = block_alloc(state)
        if l2 == 0 {
            return 0
        }
        if !ofsj.read(state, l1, buf_ib(state)) {
            return 0
        }
        put64(buf_ib(state) + slot * 8, l2)
        ofsj.write(state, l1, buf_ib(state))
    }
    if !ofsj.read(state, l2, buf_i2(state)) {
        return 0
    }
    let at: u64 = d % PER_BLOCK
    let b: u64 = get64(buf_i2(state) + at * 8)
    if b != 0 || !grow {
        return b
    }
    let fresh: u64 = block_alloc(state)
    if fresh == 0 {
        return 0
    }
    if !ofsj.read(state, l2, buf_i2(state)) {
        return 0
    }
    put64(buf_i2(state) + at * 8, fresh)
    ofsj.write(state, l2, buf_i2(state))
    return fresh
}

// ---------------------------------------------------------- RUNDE OFS3
fn triple_block(state: u64, ino: u64, t: u64, grow: bool) -> u64 {
    var l1: u64 = inode_get(state, ino, I_TINDIRECT)
    if l1 == 0 {
        if !grow {
            return 0
        }
        l1 = block_alloc(state)
        if l1 == 0 {
            return 0
        }
        inode_set(state, ino, I_TINDIRECT, l1)
    }
    let i1: u64 = t / (PER_BLOCK * PER_BLOCK)
    let l2: u64 = walk_level(state, l1, i1, grow)
    if l2 == 0 {
        return 0
    }
    let i2: u64 = (t / PER_BLOCK) % PER_BLOCK
    let l3: u64 = walk_level(state, l2, i2, grow)
    if l3 == 0 {
        return 0
    }
    return walk_level(state, l3, t % PER_BLOCK, grow)
}

fn walk_level(state: u64, block: u64, k: u64, grow: bool) -> u64 {
    if !ofsj.read(state, block, buf_ib(state)) {
        return 0
    }
    let b: u64 = get64(buf_ib(state) + k * 8)
    if b != 0 || !grow {
        return b
    }
    let fresh: u64 = block_alloc(state)
    if fresh == 0 {
        return 0
    }
    if !ofsj.read(state, block, buf_ib(state)) {
        return 0
    }
    put64(buf_ib(state) + k * 8, fresh)
    if !ofsj.write(state, block, buf_ib(state)) {
        return 0
    }
    return fresh
}

// Every block of a file back to the bitmap.
fn file_truncate(state: u64, ino: u64) {
    let vk_flags: u64 = enter(state)
    free_batch_begin()
    var i: u64 = 0
    let dn: u64 = directs(state)
    while i < dn {
        let b: u64 = inode_get(state, ino, I_DIRECT + i * 8)
        if b != 0 {
            block_free(state, b)
            inode_set(state, ino, I_DIRECT + i * 8, 0)
        }
        i = i + 1
    }
    let ib: u64 = inode_get(state, ino, I_INDIRECT)
    if ib != 0 {
        free_pointers(state, ib)
        block_free(state, ib)
        inode_set(state, ino, I_INDIRECT, 0)
    }
    // ROUND K4: and the two levels under the double indirect pointer.
    let l1: u64 = inode_get(state, ino, I_DINDIRECT)
    if l1 != 0 {
        if ofsj.read(state, l1, buf_ib(state)) {
            var k: u64 = 0
            while k < PER_BLOCK {
                let l2: u64 = get64(buf_ib(state) + k * 8)
                if l2 != 0 {
                    free_pointers(state, l2)
                    block_free(state, l2)
                    // `free_pointers` read over the buffer this loop walks.
                    if !ofsj.read(state, l1, buf_ib(state)) {
                        k = PER_BLOCK
                    }
                }
                k = k + 1
            }
        }
        block_free(state, l1)
        inode_set(state, ino, I_DINDIRECT, 0)
    }
    if version(state) >= OFS_V3 {
        let t1: u64 = inode_get(state, ino, I_TINDIRECT)
        if t1 != 0 {
            var k1: u64 = 0
            while k1 < PER_BLOCK {
                if !ofsj.read(state, t1, buf_ib(state)) {
                    k1 = PER_BLOCK
                } else {
                    let t2: u64 = get64(buf_ib(state) + k1 * 8)
                    if t2 != 0 {
                        var k2: u64 = 0
                        while k2 < PER_BLOCK {
                            if !ofsj.read(state, t2, buf_i2(state)) {
                                k2 = PER_BLOCK
                            } else {
                                let t3: u64 = get64(buf_i2(state) + k2 * 8)
                                if t3 != 0 {
                                    free_dt(state, t3)
                                    block_free(state, t3)
                                }
                                k2 = k2 + 1
                            }
                        }
                        block_free(state, t2)
                    }
                    k1 = k1 + 1
                }
            }
            block_free(state, t1)
            inode_set(state, ino, I_TINDIRECT, 0)
        }
        let qr: u64 = inode_get(state, ino, I_QINDIRECT)
        if qr != 0 {
            free_quad(state, qr)
            inode_set(state, ino, I_QINDIRECT, 0)
        }
    }
    free_batch_end(state)
    size_write(state, ino, 0, false)
    leave(state, vk_flags)
}

fn free_dt(state: u64, block: u64) {
    if !ofsj.read(state, block, buf_dt(state)) {
        return
    }
    var k: u64 = 0
    while k < PER_BLOCK {
        let b: u64 = get64(buf_dt(state) + k * 8)
        if b != 0 {
            block_free(state, b)
        }
        k = k + 1
    }
}

// Every block a pointer block points at, back to the bitmap. Reads through
// `buf_i2`, so that a caller walking `buf_ib` keeps what it is holding.
fn free_pointers(state: u64, block: u64) {
    if !ofsj.read(state, block, buf_i2(state)) {
        return
    }
    var k: u64 = 0
    while k < PER_BLOCK {
        let b: u64 = get64(buf_i2(state) + k * 8)
        if b != 0 {
            block_free(state, b)
        }
        k = k + 1
    }
}

// ------------------------------------------------------ reading, writing

// Both take KERNEL addresses. What comes out of ring 3 is copied into the
// data area by `sys.fi` beforehand and checked there -- a file system
// that followed a pointer of a process would be a hole.
// LA-9: the lowest-level pointer block that covers file block `index` (index >= directs), 0 for a hole. Mirrors `file_block`, grow = false; clobbers `buf_ib`.
fn leaf_of(state: u64, ino: u64, index: u64, dn: u64) -> u64 {
    let k: u64 = index - dn
    if k < PER_BLOCK {
        return inode_get(state, ino, I_INDIRECT)
    }
    let d: u64 = k - PER_BLOCK
    if d < PER_BLOCK * PER_BLOCK {
        let l1: u64 = inode_get(state, ino, I_DINDIRECT)
        if l1 == 0 {
            return 0
        }
        return walk_level(state, l1, d / PER_BLOCK, false)
    }
    if version(state) < OFS_V3 {
        return 0
    }
    let t: u64 = d - PER_BLOCK * PER_BLOCK
    if t < PER_BLOCK * PER_BLOCK * PER_BLOCK {
        let t1: u64 = inode_get(state, ino, I_TINDIRECT)
        if t1 == 0 {
            return 0
        }
        let t2: u64 = walk_level(state, t1, t / (PER_BLOCK * PER_BLOCK), false)
        if t2 == 0 {
            return 0
        }
        return walk_level(state, t2, (t / PER_BLOCK) % PER_BLOCK, false)
    }
    let q: u64 = t - PER_BLOCK * PER_BLOCK * PER_BLOCK
    if q >= PER_BLOCK * PER_BLOCK * PER_BLOCK * PER_BLOCK {
        return 0
    }
    let q1: u64 = inode_get(state, ino, I_QINDIRECT)
    if q1 == 0 {
        return 0
    }
    let q2: u64 = walk_level(state, q1, q / (PER_BLOCK * PER_BLOCK * PER_BLOCK), false)
    if q2 == 0 {
        return 0
    }
    let q3: u64 = walk_level(state, q2, (q / (PER_BLOCK * PER_BLOCK)) % PER_BLOCK, false)
    if q3 == 0 {
        return 0
    }
    return walk_level(state, q3, (q / PER_BLOCK) % PER_BLOCK, false)
}

fn read_at(state: u64, ino: u64, off: u64, dst: u64, len: u64) -> u64 {
    let flags: u64 = enter(state)
    let size: u64 = inode_get(state, ino, I_SIZE)
    var want: u64 = len
    if off >= size {
        want = 0
    } else {
        if off + want > size {
            want = size - off
        }
    }
    let dn: u64 = directs(state)
    // LA-9: the pointer block of the current group of 64 file blocks is read ONCE into `buf_i2` (was: inode + two pointer blocks per 512-byte block)
    var grp: u64 = 0xFFFFFFFFFFFFFFFF
    var leaf: u64 = 0
    var n: u64 = 0
    while n < want {
        let pos: u64 = off + n
        let inb: u64 = pos % BS
        var chunk: u64 = BS - inb
        if chunk > want - n {
            chunk = want - n
        }
        let index: u64 = pos / BS
        var b: u64 = 0
        if index < dn {
            b = file_block(state, ino, index, false)
        } else {
            let g: u64 = (index - dn) / PER_BLOCK
            if g != grp {
                grp = g
                leaf = leaf_of(state, ino, index, dn)
                if leaf != 0 {
                    if !ofsj.read(state, leaf, buf_i2(state)) {
                        leaf = 0
                    }
                }
            }
            if leaf != 0 {
                b = get64(buf_i2(state) + ((index - dn) % PER_BLOCK) * 8)
            }
        }
        if b == 0 {
            zero(dst + n, chunk) // a hole reads as zeros
        } else {
            if inb == 0 && chunk == BS {
                if !ofsj.read_stream(state, b, dst + n) {
                    leave(state, flags)
                    return n
                }
            } else {
                if !ofsj.read(state, b, buf_dt(state)) {
                    leave(state, flags)
                    return n
                }
                copy(buf_dt(state) + inb, dst + n, chunk)
            }
        }
        n = n + chunk
    }
    leave(state, flags)
    return n
}

// ------------------------------------------------ RUNDE SPEICHER
fn size_write(state: u64, ino: u64, new_size: u64, only_grow: bool) -> bool {
    if ino == 0 || ino > inode_count(state) {
        return false
    }
    if !ofsj.read(state, inode_block_of(state, ino), buf_in(state)) {
        return false
    }
    let at: u64 = buf_in(state) + inode_off(state, ino)
    let alt: u64 = get64(at + I_SIZE)
    if alt == new_size {
        return true
    }
    if only_grow && new_size < alt {
        return true
    }
    let kind: u64 = get64(at + I_TYPE)
    put64(at + I_SIZE, new_size)
    if !ofsj.write(state, inode_block_of(state, ino), buf_in(state)) {
        return false
    }
    if kind == T_FILE {
        nidx.note(state, nidx.OP_SIZE, 0, ino, kind, new_size, 0)
    }
    return true
}

// ROUND UNTERBAU: ftruncate() to any size. Growing leaves a hole (a hole reads as zeros). Shrinking first zeroes what lies beyond the
// new end in the blocks that exist -- otherwise a later growth (or a write past the end) would show the old content again.
fn set_size(state: u64, ino: u64, new_size: u64) -> bool {
    let flags: u64 = enter(state)
    let old: u64 = inode_get(state, ino, I_SIZE)
    if new_size < old {
        var bi: u64 = new_size / BS
        let inb: u64 = new_size % BS
        let last: u64 = (old + BS - 1) / BS
        if inb != 0 {
            let b: u64 = file_block(state, ino, bi, false)
            if b != 0 {
                if !ofsj.read(state, b, buf_dt(state)) {
                    leave(state, flags)
                    return false
                }
                zero(buf_dt(state) + inb, BS - inb)
                if !ofsj.write(state, b, buf_dt(state)) {
                    leave(state, flags)
                    return false
                }
            }
            bi = bi + 1
        }
        while bi < last {
            if ofsj.enabled(state) && ofsj.room(state) < 8 {
                ofsj.chunk(state)
            }
            let b: u64 = file_block(state, ino, bi, false)
            if b != 0 {
                zero(buf_dt(state), BS)
                if !ofsj.write(state, b, buf_dt(state)) {
                    leave(state, flags)
                    return false
                }
            }
            bi = bi + 1
        }
    }
    let ok: bool = size_write(state, ino, new_size, false)
    if ok {
        touch_mtime(state, ino)
    }
    leave(state, flags)
    return ok
}

// r728: the whole call is one write-behind scope; everything it wrote is on
// the drive when it returns (blk.wb_end flushes), so the crash window is the
// same system call as before.
fn write_at(state: u64, ino: u64, off: u64, src: u64, len: u64) -> u64 {
    let flags: u64 = lock_only(state)
    blk.wb_begin(state)
    let n: u64 = write_at_scoped(state, ino, off, src, len)
    let flushed: bool = blk.wb_end(state)
    unlock_only(state, flags)
    if !flushed {
        return 0
    }
    return n
}

fn write_at_scoped(state: u64, ino: u64, off: u64, src: u64, len: u64) -> u64 {
    let flags: u64 = enter(state)
    var n: u64 = 0
    // A full disk stops the writing and is REPORTED as the number of
    // octets that really went in -- a file system that answered with the
    // asked-for length here would be lying about a lost file.
    var stop: bool = false
    while n < len && !stop {
        let pos: u64 = off + n
        let inb: u64 = pos % BS
        var chunk: u64 = BS - inb
        if chunk > len - n {
            chunk = len - n
        }
        // ------------------------------------------- RUNDE FSROBUST
        if ofsj.enabled(state) && ofsj.room(state) < 8 {
            if n > 0 {
                size_write(state, ino, off + n, true)
                touch_mtime(state, ino)
            }
            ofsj.chunk(state)
        }
        let b: u64 = file_block(state, ino, pos / BS, true)
        if b == 0 {
            stop = true
        } else {
            // r728: a WHOLE block needs no read of the old contents.
            if chunk != BS {
                if !ofsj.read(state, b, buf_dt(state)) {
                    leave(state, flags)
                    return n
                }
            }
            copy(src + n, buf_dt(state) + inb, chunk)
            if !ofsj.write(state, b, buf_dt(state)) {
                leave(state, flags)
                return n
            }
            n = n + chunk
        }
    }
    // Only what really went in counts. A write that could not place a
    // single octet must not push the size up -- the file would then claim
    // a length whose blocks do not exist.
    if n > 0 {
        size_write(state, ino, off + n, true)
    }
    if n > 0 {
        touch_mtime(state, ino)
    }
    leave(state, flags)
    return n
}

// ------------------------------------------------------- the directories

fn name_eq(state: u64, a: u64, b: u64) -> bool {
    var i: u64 = 0
    let nl: u64 = name_len(state)
    while i < nl {
        let x: u64 = kstate.get8(a + i)
        let y: u64 = kstate.get8(b + i)
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return true
}

fn entry_read(state: u64, dir: u64, i: u64, out: u64) -> u64 {
    let de: u64 = dirent_size(state)
    if read_at(state, dir, i * de, out, de) != de {
        return 0
    }
    return get64(out)
}

fn dir_entries(state: u64, dir: u64) -> u64 {
    return inode_get(state, dir, I_SIZE) / dirent_size(state)
}

fn dir_find(state: u64, dir: u64, name: u64) -> u64 {
    let n: u64 = dir_entries(state, dir)
    var i: u64 = 0
    while i < n {
        let ino: u64 = entry_read(state, dir, i, buf_nm(state))
        if ino != 0 && name_eq(state, buf_nm(state) + 8, name) {
            return ino
        }
        i = i + 1
    }
    return 0
}

// The `index`-th LIVE entry. `out` gets the 32 octets of the entry:
// inode number and name. 0 = there is no such entry.
// ------------------------------------------- ROUND K15, ZWEITER NACHTRAG
fn entry_slot(state: u64, dir: u64, slot: u64, out: u64, cap: u64) -> u64 {
    if dirent_size(state) > cap {
        return 0
    }
    let flags: u64 = enter(state)
    if slot >= dir_entries(state, dir) {
        leave(state, flags)
        return 0
    }
    let ino: u64 = entry_read(state, dir, slot, out)
    leave(state, flags)
    return ino
}

fn slot_count(state: u64, dir: u64) -> u64 {
    let flags: u64 = enter(state)
    let n: u64 = dir_entries(state, dir)
    leave(state, flags)
    return n
}

fn entry_at(state: u64, dir: u64, index: u64, out: u64, cap: u64) -> u64 {
    if dirent_size(state) > cap {
        return 0
    }
    let flags: u64 = enter(state)
    let n: u64 = dir_entries(state, dir)
    var i: u64 = 0
    var seen: u64 = 0
    var got: u64 = 0
    while i < n {
        let ino: u64 = entry_read(state, dir, i, out)
        if ino != 0 {
            if seen == index {
                got = ino
                i = n
            }
            seen = seen + 1
        }
        i = i + 1
    }
    leave(state, flags)
    return got
}

fn dir_add(state: u64, dir: u64, name: u64, ino: u64) -> bool {
    let de: u64 = dirent_size(state)
    let nl: u64 = name_len(state)
    let n: u64 = dir_entries(state, dir)
    var slot: u64 = n
    var i: u64 = 0
    while i < n {
        if entry_read(state, dir, i, buf_nm(state)) == 0 {
            slot = i
            i = n
        } else {
            i = i + 1
        }
    }
    zero(buf_nm(state), de)
    put64(buf_nm(state), ino)
    var k: u64 = 0
    while k < nl - 1 && kstate.get8(name + k) != 0 {
        kstate.set8(buf_nm(state) + 8 + k, kstate.get8(name + k) as u8)
        k = k + 1
    }
    if write_at(state, dir, slot * de, buf_nm(state), de) != de {
        return false
    }
    if !punktname(name) {
        var kind: u64 = 0
        var sz: u64 = 0
        if ofsj.read(state, inode_block_of(state, ino), buf_in(state)) {
            let at: u64 = buf_in(state) + inode_off(state, ino)
            kind = get64(at + I_TYPE)
            sz = get64(at + I_SIZE)
        }
        nidx.note(state, nidx.OP_ADD, dir, ino, kind, sz, name)
    }
    return true
}

fn punktname(p: u64) -> bool {
    if kstate.get8(p) != 46 {
        return false
    }
    if kstate.get8(p + 1) == 0 {
        return true
    }
    if kstate.get8(p + 1) != 46 {
        return false
    }
    return kstate.get8(p + 2) == 0
}

fn dir_remove(state: u64, dir: u64, name: u64) -> u64 {
    let n: u64 = dir_entries(state, dir)
    var i: u64 = 0
    while i < n {
        let ino: u64 = entry_read(state, dir, i, buf_nm(state))
        if ino != 0 && name_eq(state, buf_nm(state) + 8, name) {
            zero(buf_nm(state), dirent_size(state))
            write_at(state, dir, i * dirent_size(state), buf_nm(state),
                dirent_size(state))
            if !punktname(name) {
                var kind: u64 = 0
                var sz: u64 = 0
                if ofsj.read(state, inode_block_of(state, ino), buf_in(state)) {
                    let at: u64 = buf_in(state) + inode_off(state, ino)
                    kind = get64(at + I_TYPE)
                    sz = get64(at + I_SIZE)
                }
                nidx.note(state, nidx.OP_DEL, dir, ino, kind, sz, name)
            }
            return ino
        }
        i = i + 1
    }
    return 0
}

// --------------------------------------------------------- the paths

fn p_name(state: u64) -> u64 {
    return state + kstate.OFS3_OFF + kstate.OP_NAME
}

fn p_work(state: u64) -> u64 {
    return state + kstate.OFS3_OFF + kstate.OP_WORK
}

fn p_build(state: u64) -> u64 {
    return state + kstate.OFS3_OFF + kstate.OP_BUILD
}

fn p_link(state: u64) -> u64 {
    return state + kstate.OFS3_OFF + kstate.OP_LINK
}

const PATHBUF: u64 = 1024

fn strlen(p: u64) -> u64 {
    var n: u64 = 0
    while kstate.get8(p + n) != 0 {
        n = n + 1
    }
    return n
}

fn strcopy(from: u64, to: u64, max: u64) -> u64 {
    var n: u64 = 0
    while n + 1 < max && kstate.get8(from + n) != 0 {
        kstate.set8(to + n, kstate.get8(from + n) as u8)
        n = n + 1
    }
    kstate.set8(to + n, 0 as u8)
    return n
}

// `/a/b/c` -> inode, 0 = not there. A leading slash is optional; without
// one it starts at the root as well, because a process has no working
// directory of its own yet.
//
// ---------------------------------------------------------- RUNDE OFS3
fn path(state: u64, p: u64) -> u64 {
    return resolve(state, p, true)
}

fn path_nofollow(state: u64, p: u64) -> u64 {
    return resolve(state, p, false)
}

fn resolve(state: u64, p: u64, follow_last: bool) -> u64 {
    let flags: u64 = enter(state)
    let w: u64 = p_work(state)
    strcopy(p, w, PATHBUF)
    let nl: u64 = name_len(state)
    var ino: u64 = root(state)
    var i: u64 = 0
    var spruenge: u64 = 0
    var going: bool = true
    var ergebnis: u64 = 0
    while going {
        while kstate.get8(w + i) == 47 {
            i = i + 1
        }
        if kstate.get8(w + i) == 0 {
            going = false
            ergebnis = ino
        } else {
            let von: u64 = i
            var n: u64 = 0
            while kstate.get8(w + i) != 0 && kstate.get8(w + i) != 47 {
                if n + 1 < nl {
                    kstate.set8(p_name(state) + n, kstate.get8(w + i) as u8)
                    n = n + 1
                }
                i = i + 1
            }
            kstate.set8(p_name(state) + n, 0 as u8)
            if inode_type(state, ino) != T_DIR {
                going = false
            } else {
                let naechst: u64 = dir_find(state, ino, p_name(state))
                if naechst == 0 {
                    going = false
                } else {
                    var j: u64 = i
                    while kstate.get8(w + j) == 47 {
                        j = j + 1
                    }
                    let mehr: bool = kstate.get8(w + j) != 0
                    if inode_type(state, naechst) == T_LINK
                        && (mehr || follow_last) && follows_symlinks(state) {
                        if spruenge >= MAX_HOPS {
                            going = false // ELOOP
                        } else {
                            spruenge = spruenge + 1
                            if !seq(state, w, von, i, naechst) {
                                going = false
                            } else {
                                ino = root(state)
                                i = 0
                            }
                        }
                    } else {
                        ino = naechst
                    }
                }
            }
        }
    }
    leave(state, flags)
    return ergebnis
}

fn seq(state: u64, w: u64, von: u64, bis: u64, link: u64) -> bool {
    let target: u64 = p_link(state)
    let n: u64 = inode_get(state, link, I_SIZE)
    if n == 0 || n >= PATHBUF {
        return false
    }
    if read_at(state, link, 0, target, n) != n {
        return false
    }
    kstate.set8(target + n, 0 as u8)
    let b: u64 = p_build(state)
    var at: u64 = 0
    // W-MG3 (chroot): a jailed task resolves symlink targets from ITS root. `w` starts with the jail root (it went through
    // `ctr.jail`), the target is folded inside the jail (so `..` stops at the root) and the root goes in front again.
    let jt: u64 = sched.current(state)
    let jrl: u64 = ctr.prefix_len(state, jt, w)
    if jrl > 0 && von > jrl && jrl + n + von + 4 < PATHBUF {
        var q: u64 = 0
        while q < jrl {
            kstate.set8(b + q, kstate.get8(w + q) as u8)
            q = q + 1
        }
        var m: u64 = 0
        if kstate.get8(target) != 47 {
            while jrl + m < von {
                kstate.set8(b + jrl + m, kstate.get8(w + jrl + m) as u8)
                m = m + 1
            }
        }
        var z: u64 = 0
        while z < n {
            kstate.set8(b + jrl + m + z, kstate.get8(target + z) as u8)
            z = z + 1
        }
        m = m + n
        if m == 0 || kstate.get8(b + jrl) != 47 {
            // not reachable for a valid path; keep the fold's precondition (leading slash)
            return false
        }
        let fl: u64 = ctr.fold(b + jrl, m)
        at = jrl + fl
        var rest2: u64 = bis
        if kstate.get8(w + rest2) != 0 {
            if kstate.get8(b + at - 1) != 47 {
                kstate.set8(b + at, 47 as u8)
                at = at + 1
            }
            while kstate.get8(w + rest2) == 47 {
                rest2 = rest2 + 1
            }
            while kstate.get8(w + rest2) != 0 && at + 1 < PATHBUF {
                kstate.set8(b + at, kstate.get8(w + rest2) as u8)
                at = at + 1
                rest2 = rest2 + 1
            }
        }
        kstate.set8(b + at, 0 as u8)
        strcopy(b, w, PATHBUF)
        return true
    }
    if kstate.get8(target) != 47 {
        var k: u64 = 0
        while k < von && at + 1 < PATHBUF {
            kstate.set8(b + at, kstate.get8(w + k) as u8)
            at = at + 1
            k = k + 1
        }
    }
    var k2: u64 = 0
    while k2 < n && at + 1 < PATHBUF {
        kstate.set8(b + at, kstate.get8(target + k2) as u8)
        at = at + 1
        k2 = k2 + 1
    }
    var rest: u64 = bis
    if kstate.get8(w + rest) != 0 {
        if at + 1 < PATHBUF && kstate.get8(b + at - 1) != 47 {
            kstate.set8(b + at, 47 as u8)
            at = at + 1
        }
        while kstate.get8(w + rest) == 47 {
            rest = rest + 1
        }
        while kstate.get8(w + rest) != 0 && at + 1 < PATHBUF {
            kstate.set8(b + at, kstate.get8(w + rest) as u8)
            at = at + 1
            rest = rest + 1
        }
    }
    kstate.set8(b + at, 0 as u8)
    strcopy(b, w, PATHBUF)
    return true
}

fn parent_of(state: u64, p: u64, out_name: u64) -> u64 {
    let buf: u64 = state + kstate.OFS3_OFF + kstate.OP_PATH
    var len: u64 = strcopy(p, buf, PATHBUF)
    if len == 0 {
        return 0
    }
    while len > 1 && kstate.get8(buf + len - 1) == 47 {
        len = len - 1
        kstate.set8(buf + len, 0 as u8)
    }
    var cut: u64 = len
    var found: bool = false
    while cut > 0 && !found {
        cut = cut - 1
        if kstate.get8(buf + cut) == 47 {
            found = true
        }
    }
    var dir: u64 = root(state)
    var start: u64 = 0
    if found {
        kstate.set8(buf + cut, 0 as u8)
        start = cut + 1
        if cut > 0 {
            dir = path(state, buf)
        }
    }
    if dir == 0 || inode_type(state, dir) != T_DIR {
        return 0
    }
    let nl: u64 = name_len(state)
    var k: u64 = 0
    while k + 1 < nl && kstate.get8(buf + start + k) != 0 {
        kstate.set8(out_name + k, kstate.get8(buf + start + k) as u8)
        k = k + 1
    }
    kstate.set8(out_name + k, 0 as u8)
    if k == 0 {
        return 0
    }
    return dir
}

fn parent_ino(state: u64, p: u64) -> u64 {
    let flags: u64 = enter(state)
    let dir: u64 = parent_of(state, p,
        state + kstate.OFS3_OFF + kstate.OP_NAME2)
    leave(state, flags)
    return dir
}

fn create_path(state: u64, p: u64, kind: u64) -> u64 {
    let flags: u64 = enter(state)
    let name: u64 = state + kstate.OFS3_OFF + kstate.OP_OLD
    let dir: u64 = parent_of(state, p, name)
    if dir == 0 {
        leave(state, flags)
        return 0
    }
    if dir_find(state, dir, name) != 0 {
        leave(state, flags)
        return 0
    }
    let ino: u64 = inode_alloc(state, kind)
    if ino == 0 {
        leave(state, flags)
        return 0
    }
    if kind == T_DIR {
        if !dir_init(state, ino, dir) {
            inode_release(state, ino)
            leave(state, flags)
            return 0
        }
    }
    if !dir_add(state, dir, name, ino) {
        inode_release(state, ino)
        leave(state, flags)
        return 0
    }
    leave(state, flags)
    return ino
}

// ---------------------------------------------------------- RUNDE OFS3
fn symlink_path(state: u64, target: u64, wo: u64) -> u64 {
    if version(state) < OFS_V3 {
        return 0
    }
    let n: u64 = strlen(target)
    if n == 0 || n >= PATHBUF {
        return 0
    }
    let flags: u64 = enter(state)
    let t: u64 = state + kstate.OFS3_OFF + kstate.OP_TMP
    strcopy(target, t, PATHBUF)
    var ino: u64 = create_path(state, wo, T_LINK)
    if ino != 0 {
        if write_at(state, ino, 0, t, n) != n {
            unlink_path(state, wo)
            ino = 0
        }
    }
    leave(state, flags)
    return ino
}

fn readlink_at(state: u64, ino: u64, dst: u64, max: u64) -> u64 {
    if inode_type(state, ino) != T_LINK {
        return 0
    }
    var n: u64 = inode_get(state, ino, I_SIZE)
    if n >= max {
        n = max - 1
    }
    let got: u64 = read_at(state, ino, 0, dst, n)
    kstate.set8(dst + got, 0 as u8)
    return got
}

fn link_target_len(state: u64, ino: u64) -> u64 {
    if inode_type(state, ino) != T_LINK {
        return 0
    }
    return inode_get(state, ino, I_SIZE)
}

// A fresh directory gets `.` and `..` -- without them it would not be one.
fn dir_init(state: u64, ino: u64, parent: u64) -> bool {
    var dot: [u8; 2] = ".\0"
    var dotdot: [u8; 3] = "..\0"
    if !dir_add(state, ino, (&dot[0]) as u64, ino) {
        return false
    }
    return dir_add(state, ino, (&dotdot[0]) as u64, parent)
}

fn unlink_path(state: u64, p: u64) -> bool {
    let flags: u64 = enter(state)
    let name: u64 = state + kstate.OFS3_OFF + kstate.OP_OLD
    let dir: u64 = parent_of(state, p, name)
    if dir == 0 {
        leave(state, flags)
        return false
    }
    let ino: u64 = dir_find(state, dir, name)
    if ino == 0 {
        leave(state, flags)
        return false
    }
    // A directory only goes when nothing is in it any more -- apart from
    // `.` and `..`, which are itself and its parent.
    if inode_type(state, ino) == T_DIR {
        var live: u64 = 0
        let n: u64 = dir_entries(state, ino)
        var i: u64 = 0
        while i < n {
            if entry_read(state, ino, i, buf_nm(state)) != 0 {
                live = live + 1
            }
            i = i + 1
        }
        if live > 2 {
            leave(state, flags)
            return false
        }
    }
    let nl: u64 = inode_get(state, ino, I_NLINK)
    if nl > 1 && inode_type(state, ino) == T_FILE {
        inode_set(state, ino, I_NLINK, nl - 1)
        dir_remove(state, dir, name)
        leave(state, flags)
        return true
    }
    file_truncate(state, ino)
    inode_release(state, ino)
    inode_set(state, ino, I_NLINK, 0)
    dir_remove(state, dir, name)
    leave(state, flags)
    return true
}

// ------------------------------------------------- Runde K14: umbenennen
fn rename_path(state: u64, from: u64, to: u64) -> u64 {
    let oldname: u64 = state + kstate.OFS3_OFF + kstate.OP_OLD
    let newname: u64 = state + kstate.OFS3_OFF + kstate.OP_NEW
    var dotdot: [u8; 3] = "..\0"
    let flags: u64 = enter(state)
    let odir: u64 = parent_of(state, from, oldname)
    if odir == 0 {
        leave(state, flags)
        return 2 // ENOENT
    }
    let ino: u64 = dir_find(state, odir, oldname)
    if ino == 0 {
        leave(state, flags)
        return 2
    }
    let ndir: u64 = parent_of(state, to, newname)
    if ndir == 0 {
        leave(state, flags)
        return 2
    }
    // POSIX: rename() onto an existing FILE replaces it atomically (sed -i, git, every
    // "write temp, rename over" program). Same inode (hard links): nothing to do.
    // Directories keep the old answer (EEXIST) -- no silent directory replacement.
    let ex: u64 = dir_find(state, ndir, newname)
    if ex != 0 {
        if ex == ino {
            leave(state, flags)
            return 0
        }
        if inode_type(state, ex) != T_FILE || inode_type(state, ino) != T_FILE {
            leave(state, flags)
            return 17 // EEXIST
        }
        let exnl: u64 = inode_get(state, ex, I_NLINK)
        if exnl > 1 {
            inode_set(state, ex, I_NLINK, exnl - 1)
        } else {
            file_truncate(state, ex)
            inode_release(state, ex)
            inode_set(state, ex, I_NLINK, 0)
        }
        dir_remove(state, ndir, newname)
    }
    if !dir_add(state, ndir, newname, ino) {
        leave(state, flags)
        return 28 // ENOSPC
    }
    if dir_remove(state, odir, oldname) == 0 {
        dir_remove(state, ndir, newname)
        leave(state, flags)
        return 2
    }
    if inode_type(state, ino) == T_DIR && odir != ndir {
        dir_remove(state, ino, (&dotdot[0]) as u64)
        dir_add(state, ino, (&dotdot[0]) as u64, ndir)
    }
    leave(state, flags)
    return 0
}

// ============================================== RUNDE INSTALL: link
fn link_path(state: u64, from: u64, to: u64) -> u64 {
    let newname: u64 = state + kstate.OFS3_OFF + kstate.OP_NEW
    let flags: u64 = enter(state)
    let ino: u64 = path(state, from)
    if ino == 0 {
        leave(state, flags)
        return 2 // ENOENT
    }
    if inode_type(state, ino) != T_FILE {
        leave(state, flags)
        return 1
    }
    let ndir: u64 = parent_of(state, to, newname)
    if ndir == 0 {
        leave(state, flags)
        return 2
    }
    if dir_find(state, ndir, newname) != 0 {
        leave(state, flags)
        return 17 // EEXIST
    }
    if !dir_add(state, ndir, newname, ino) {
        leave(state, flags)
        return 28 // ENOSPC
    }
    inode_set(state, ino, I_NLINK, inode_get(state, ino, I_NLINK) + 1)
    leave(state, flags)
    return 0
}

// ------------------------------------------------------ format and mount

fn format(state: u64) -> bool {
    var v: u64 = OFS_V2
    if kstate.mode_on(state, kstate.O_OFS3FMT) {
        v = OFS_V3
    }
    return format_as(state, v, INODE_COUNT)
}

fn format_as(state: u64, v: u64, inodes: u64) -> bool {
    ofsj.disable(state)
    let flags: u64 = enter(state)
    kstate.set(state, kstate.K13_OFF + kstate.U_FSVER, v)
    let total: u64 = blk.blocks(state)
    var isz: u64 = INODE_SIZE
    var ipb: u64 = INODES_PER_BLOCK
    var dent: u64 = DIRENT
    var nlen: u64 = NAME_LEN
    if v >= OFS_V3 {
        isz = INODE_SIZE_V3
        ipb = IPB_V3
        dent = DIRENT_V3
        nlen = NAME_V3
    }
    var bmb: u64 = 1
    if v >= OFS_V3 {
        bmb = (total + BITS_PER_BLOCK - 1) / BITS_PER_BLOCK
        if bmb == 0 {
            bmb = 1
        }
    }
    let bms: u64 = BITMAP_BLOCK
    let itab: u64 = bms + bmb
    let itb: u64 = (inodes + ipb - 1) / ipb
    var jb: u64 = 0
    if v >= OFS_V3 && kstate.mode_on(state, kstate.O_JRNLFMT) {
        jb = ofsj.BLOCKS_NEEDED
    }
    let js: u64 = itab + itb
    let ds: u64 = js + jb
    if total < ds + 8 {
        leave(state, flags)
        return false
    }
    geom3(state, bms, bmb, itab, isz, dent, nlen)
    geom(state, inodes, ds)
    geom_j(state, js, jb)
    geom_total(state, total)
    // The superblock.
    zero(buf_sb(state), BS)
    put64(buf_sb(state) + SB_MAGIC, MAGIC)
    put64(buf_sb(state) + SB_BSIZE, BS)
    put64(buf_sb(state) + SB_BLOCKS, total)
    put64(buf_sb(state) + SB_INODES, inodes)
    put64(buf_sb(state) + SB_BITMAP, bms)
    put64(buf_sb(state) + SB_ITABLE, itab)
    put64(buf_sb(state) + SB_DATA, ds)
    put64(buf_sb(state) + SB_ROOT, 1)
    put64(buf_sb(state) + SB_VERSION, v)
    if v >= OFS_V3 {
        put64(buf_sb(state) + SB_BMBLOCKS, bmb)
        put64(buf_sb(state) + SB_ISIZE, isz)
        put64(buf_sb(state) + SB_DIRENT, dent)
        put64(buf_sb(state) + SB_NAMELEN, nlen)
    }
    if jb != 0 {
        put64(buf_sb(state) + SB_JSTART, js)
        put64(buf_sb(state) + SB_JBLOCKS, jb)
    }
    var kb: u64 = 0
    while kb < bmb {
        zero(buf_bm(state), BS)
        var b: u64 = kb * BITS_PER_BLOCK
        let ende: u64 = (kb + 1) * BITS_PER_BLOCK
        while b < ende && b < ds {
            let p: u64 = buf_bm(state) + bm_byte(b)
            kstate.set8(p, (kstate.get8(p) | (1 << (b % 8))) as u8)
            b = b + 1
        }
        var t: u64 = kb * BITS_PER_BLOCK
        if t < total {
            t = total
        }
        while t < ende {
            let p2: u64 = buf_bm(state) + bm_byte(t)
            kstate.set8(p2, (kstate.get8(p2) | (1 << (t % 8))) as u8)
            t = t + 1
        }
        if !blk.write(state, bms + kb, buf_bm(state)) {
            leave(state, flags)
            return false
        }
        kb = kb + 1
    }
    // The inode table: empty.
    zero(buf_in(state), BS)
    var k: u64 = 0
    while k < itb {
        blk.write(state, itab + k, buf_in(state))
        k = k + 1
    }
    kstate.set(state, kstate.FS_ROOT, 1)
    kstate.set(state, kstate.FS_READY, 1)
    // The root directory.
    if inode_alloc(state, T_DIR) != 1 {
        kstate.set(state, kstate.FS_READY, 0)
        leave(state, flags)
        return false
    }
    if !dir_init(state, 1, 1) {
        kstate.set(state, kstate.FS_READY, 0)
        leave(state, flags)
        return false
    }
    set_meta(state, 1, 493, 0, 0)
    if jb != 0 {
        ofsj.clear(state, js, jb)
    }
    if !blk.write(state, 0, buf_sb(state)) {
        kstate.set(state, kstate.FS_READY, 0)
        leave(state, flags)
        return false
    }
    blk.flush(state)
    leave(state, flags)
    if jb != 0 {
        ofsj.setup(state, js, jb)
    }
    return true
}

fn journal_start(state: u64) -> u64 {
    return kstate.get(state, kstate.FSG_OFF + G_JSTART)
}

fn journal_blocks(state: u64) -> u64 {
    return kstate.get(state, kstate.FSG_OFF + G_JBLOCKS)
}

fn journal_on(state: u64) -> bool {
    return ofsj.enabled(state)
}

static mut q_fs: [u8; 3] = "fs\0"

fn lq() -> u64 {
    return (&q_fs[0]) as u64
}

fn mount(state: u64) -> bool {
    var log_superblock_unreadable: [u8; 36] = "superblock unreadable, not mounting\0"
    var l_magie: [u8; 33] = "falsche Kennung im Superblock, \0\0"
    var l_ok: [u8; 25] = "mounted, version/blocks \0"
    ofsj.disable(state)
    let flags: u64 = enter(state)
    kstate.set(state, kstate.FS_READY, 0)
    geom_j(state, 0, 0)
    if !blk.read(state, 0, buf_sb(state)) {
        klog.say(state, klog.L_INFO, lq(), (&log_superblock_unreadable[0]) as u64)
        leave(state, flags)
        return false
    }
    if get64(buf_sb(state) + SB_MAGIC) != MAGIC {
        klog.sayh(state, klog.L_INFO, lq(), (&l_magie[0]) as u64,
            get64(buf_sb(state) + SB_MAGIC))
        leave(state, flags)
        return false
    }
    // ------------------------------------------------ RUNDE FSROBUST
    let js0: u64 = get64(buf_sb(state) + SB_JSTART)
    let jb0: u64 = get64(buf_sb(state) + SB_JBLOCKS)
    if js0 != 0 && jb0 >= ofsj.BLOCKS_NEEDED
        && js0 + jb0 <= blk.blocks(state) {
        let move_to: u64 = ofsj.replay(state, js0, jb0)
        if move_to != 0 {
            var s_n: [u8; 20] = "ofsj: nachgetragen=\0"
            serial.puts((&s_n[0]) as u64)
            serial.dec(move_to)
            serial.nl()
        }
        if move_to != 0 {
            if !blk.read(state, 0, buf_sb(state)) {
                leave(state, flags)
                return false
            }
            if get64(buf_sb(state) + SB_MAGIC) != MAGIC {
                leave(state, flags)
                return false
            }
        }
    }
    if get64(buf_sb(state) + SB_BSIZE) != BS {
        leave(state, flags)
        return false
    }
    var ver: u64 = get64(buf_sb(state) + SB_VERSION)
    if ver == 0 {
        ver = OFS_V1
    }
    if ver > OFS_V3 {
        leave(state, flags)
        return false
    }
    kstate.set(state, kstate.K13_OFF + kstate.U_FSVER, ver)
    // ------------------------------------------------------ RUNDE OFS3
    var bmb: u64 = get64(buf_sb(state) + SB_BMBLOCKS)
    var isz: u64 = get64(buf_sb(state) + SB_ISIZE)
    var dent: u64 = get64(buf_sb(state) + SB_DIRENT)
    var nlen: u64 = get64(buf_sb(state) + SB_NAMELEN)
    if bmb == 0 {
        bmb = 1
    }
    if isz == 0 {
        isz = INODE_SIZE
    }
    if dent == 0 {
        dent = DIRENT
    }
    if nlen == 0 {
        nlen = NAME_LEN
    }
    if isz < INODE_SIZE || isz > BS || (BS % isz) != 0 {
        leave(state, flags)
        return false
    }
    if dent > ENTRY_MAX && dent <= BS {
        var l_dent: [u8; 54] = "mount refused: directory entry size exceeds ENTRY_MAX\0"
        klog.sayh(state, klog.L_INFO, lq(), (&l_dent[0]) as u64, dent)
        leave(state, flags)
        return false
    }
    if dent < DIRENT || dent > ENTRY_MAX || nlen < NAME_LEN || nlen + 8 > dent {
        leave(state, flags)
        return false
    }
    let bms2: u64 = get64(buf_sb(state) + SB_BITMAP)
    if bms2 == 0 || bmb == 0 {
        leave(state, flags)
        return false
    }
    if bmb * BITS_PER_BLOCK < blk.blocks(state)
        && bmb * BITS_PER_BLOCK < get64(buf_sb(state) + SB_BLOCKS) {
        leave(state, flags)
        return false
    }
    let ipb2: u64 = BS / isz
    geom3(state, bms2, bmb, get64(buf_sb(state) + SB_ITABLE), isz,
        dent, nlen)
    var ni: u64 = get64(buf_sb(state) + SB_INODES)
    var ds: u64 = get64(buf_sb(state) + SB_DATA)
    if ni == 0 {
        ni = INODE_COUNT
    }
    if ds == 0 {
        ds = DATA_START
    }
    let itab: u64 = get64(buf_sb(state) + SB_ITABLE)
    let noetig: u64 = (ni + ipb2 - 1) / ipb2
    if itab < bms2 + bmb || ds < itab + noetig
        || ds >= blk.blocks(state) {
        leave(state, flags)
        return false
    }
    geom(state, ni, ds)
    var tot: u64 = get64(buf_sb(state) + SB_BLOCKS)
    if tot == 0 || tot > blk.blocks(state) {
        tot = blk.blocks(state)
    }
    if get64(buf_sb(state) + ofsext.SB_XVER) != 0 {
        let xblocks: u64 = get64(buf_sb(state) + ofsext.SB_XBLOCKS)
        let xbm: u64 = get64(buf_sb(state) + ofsext.SB_XBMSTART)
        let xit: u64 = get64(buf_sb(state) + ofsext.SB_XITSTART)
        let xin: u64 = get64(buf_sb(state) + ofsext.SB_XINODES)
        if !ofsext.valid(bmb * BITS_PER_BLOCK, get64(buf_sb(state) + SB_BLOCKS),
            blk.blocks(state), ipb2, xblocks, xbm, xit, xin) {
            geom3(state, BITMAP_BLOCK, 1, INODE_START, INODE_SIZE, DIRENT, NAME_LEN)
            leave(state, flags)
            return false
        }
        geom_ext(state, xbm, xit, xin)
        tot = xblocks
    }
    geom_total(state, tot)
    let r: u64 = get64(buf_sb(state) + SB_ROOT)
    if inode_get(state, r, I_TYPE) != T_DIR {
        geom(state, INODE_COUNT, DATA_START)
        geom_total(state, 0)
        geom3(state, BITMAP_BLOCK, 1, INODE_START, INODE_SIZE,
            DIRENT, NAME_LEN)
        leave(state, flags)
        return false
    }
    kstate.set(state, kstate.FS_ROOT, r)
    klog.say2(state, klog.L_INFO, lq(), (&l_ok[0]) as u64,
        version(state), total_blocks(state))
    kstate.set(state, kstate.FS_READY, 1)
    leave(state, flags)
    let js: u64 = get64(buf_sb(state) + SB_JSTART)
    let jb: u64 = get64(buf_sb(state) + SB_JBLOCKS)
    if js != 0 && jb >= ofsj.BLOCKS_NEEDED && js >= itab + noetig
        && js + jb <= ds && js + jb <= blk.blocks(state) {
        geom_j(state, js, jb)
        ofsj.setup(state, js, jb)
    }
    return true
}

// ------------------------------------------- ROUND K15: DER TABELLENLAUF
const SCAN_SHIFT: u64 = 20
const SCAN_MASK: u64 = 1048575
const EPB: u64 = 16

fn scan(state: u64, cur: u64, out: u64, max: u64) -> u64 {
    let flags: u64 = enter(state)
    let c: u64 = get64(cur)
    var ino: u64 = c >> SCAN_SHIFT
    var idx: u64 = c & SCAN_MASK
    if ino < 1 {
        ino = 1
    }
    let last_inode: u64 = inode_count(state)
    var n: u64 = 0
    var full: bool = false
    while ino <= last_inode && !full {
        if inode_get(state, ino, I_TYPE) == T_DIR {
            let cnt: u64 = dir_entries(state, ino)
            let epb: u64 = BS / dirent_size(state)
            while idx < cnt && !full {
                var got: u64 = 0
                var bis: u64 = 0
                var chunk: u64 = 0
                if epb >= 1 && (BS % dirent_size(state)) == 0 {
                    chunk = idx / epb
                    got = read_at(state, ino, chunk * BS, buf_zz(state), BS)
                    bis = (chunk + 1) * epb
                    if bis > cnt {
                        bis = cnt
                    }
                    if bis > chunk * epb + got / dirent_size(state) {
                        bis = chunk * epb + got / dirent_size(state)
                    }
                } else {
                    got = entry_read(state, ino, idx, buf_zz(state))
                    if got == 0 {
                        got = 1
                    }
                    chunk = idx
                    bis = idx + 1
                }
                if got == 0 {
                    idx = cnt
                } else {
                    while idx < bis && !full {
                        var p: u64 = buf_zz(state)
                        if (BS % dirent_size(state)) == 0 {
                            p = buf_zz(state) + (idx % epb) * dirent_size(state)
                        }
                        let child: u64 = get64(p)
                        if child != 0 && !punktname(p + 8) {
                            if n >= max {
                                full = true
                            } else {
                                let rec: u64 = out + n * nidx.REC
                                put64(rec + nidx.R_INO, child)
                                put64(rec + nidx.R_PARENT, ino)
                                if ofsj.read(state,
                                    inode_block_of(state, child),
                                    buf_in(state)) {
                                    let at2: u64 = buf_in(state)
                                        + inode_off(state, child)
                                    put64(rec + nidx.R_SIZE,
                                        get64(at2 + I_SIZE))
                                    put64(rec + nidx.R_KIND,
                                        get64(at2 + I_TYPE))
                                } else {
                                    put64(rec + nidx.R_SIZE, 0)
                                    put64(rec + nidx.R_KIND, 0)
                                }
                                put64(rec + nidx.R_OP, idx)
                                copy(p + 8, rec + nidx.R_NAME, nidx.NAMEJ)
                                n = n + 1
                            }
                        }
                        if !full {
                            idx = idx + 1
                        }
                    }
                }
            }
        }
        if !full {
            ino = ino + 1
            idx = 0
        }
    }
    put64(cur, (ino << SCAN_SHIFT) | idx)
    leave(state, flags)
    return n
}
