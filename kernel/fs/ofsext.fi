profile kernel

export {
    SB_BLOCKS, SB_VERSION, SB_XVER, SB_XBLOCKS, SB_XBMSTART, SB_XITSTART, SB_XINODES, SB_XPLAN, SB_XCURSOR,
    MAX_EXT_INODES, BLOCKS_PER_INODE, MIN_DATA_BLOCKS,
    bm_blocks_for, plan_inodes, it_blocks_for, meta_blocks, eligible, valid
}

const SB_BLOCKS: u64 = 16
const SB_VERSION: u64 = 64
const SB_XVER: u64 = 120
const SB_XBLOCKS: u64 = 128
const SB_XBMSTART: u64 = 136
const SB_XITSTART: u64 = 144
const SB_XINODES: u64 = 152
const SB_XPLAN: u64 = 160
const SB_XCURSOR: u64 = 168

const BITS_PER_BLOCK: u64 = 4096
const MAX_EXT_INODES: u64 = 131072
const BLOCKS_PER_INODE: u64 = 256
const MIN_DATA_BLOCKS: u64 = 4096

fn bm_blocks_for(span: u64) -> u64 {
    return (span + BITS_PER_BLOCK - 1) / BITS_PER_BLOCK
}

fn plan_inodes(span: u64, ipb: u64) -> u64 {
    var n: u64 = span / BLOCKS_PER_INODE
    if n > MAX_EXT_INODES {
        n = MAX_EXT_INODES
    }
    return n - n % ipb
}

fn it_blocks_for(inodes: u64, ipb: u64) -> u64 {
    return (inodes + ipb - 1) / ipb
}

fn meta_blocks(span: u64, ipb: u64) -> u64 {
    return bm_blocks_for(span) + it_blocks_for(plan_inodes(span, ipb), ipb)
}

fn eligible(cover: u64, old_blocks: u64, dev: u64, ipb: u64) -> bool {
    if ipb == 0 || old_blocks > cover || dev <= cover {
        return false
    }
    let span: u64 = dev - cover
    if span <= meta_blocks(span, ipb) + MIN_DATA_BLOCKS {
        return false
    }
    return plan_inodes(span, ipb) != 0
}

fn valid(cover: u64, old_blocks: u64, dev: u64, ipb: u64, xblocks: u64,
    xbm: u64, xit: u64, xin: u64) -> bool {
    if ipb == 0 || xblocks <= cover || xblocks > dev || old_blocks > cover {
        return false
    }
    if xbm != cover || xin == 0 || xin % ipb != 0 {
        return false
    }
    let nbm: u64 = bm_blocks_for(xblocks - cover)
    if xit < xbm + nbm {
        return false
    }
    return xit + it_blocks_for(xin, ipb) <= xblocks
}
