
import lib.kstate
import fs.mnt
import fs.vfsops
import fs.ext4
import fs.ntfs
import fs.exfat
import fs.fat
import sched.sched
import sched.taskslot
import sync.atomic
import arch.cpu
import ipc.handle
import mm.mmframe

export {
    init, init_task, clear_task, close_all, inherit_task, inherit_std,
    next_used_fd,
    owner, share_table, release_use, release_table,
    fd_of, fd_set, fd_alloc, fd_free,
    open_alloc, open_ref, open_unref, open_kind, open_ino, open_off,
    open_set_off, open_flags, open_set_flags, open_used, open_refs,
    pipe_new, pipe_get, pipe_put, pipe_room, pipe_bytes, pipe_writers,
    pipe_readers,
    K_FREE, K_FILE, K_DIR, K_CONIN, K_CONOUT, K_PIPER, K_PIPEW, K_FB,
    K_TTY, K_SOCK, K_VFILE, K_VDIR, K_USOCK, K_SHM,
    K_EVENT, K_TIMER, K_SIGFD, K_EPOLL, K_INOTIFY, K_NETLINK,
    open_x1, open_set_x1, open_x2, open_set_x2, open_addr, of_at, OF_OFF,
    open_mnt, open_set_mnt, open_settle,
    fd_handle, fd_rights, fd_may, fd_check, fd_set_rights, fd_pass,
    rights_of_open,
    MAX_FD, MAX_OPEN, MAX_PIPES, PIPE_CAP, CON_IN, CON_OUT, CON_ERR
}

const OF_BYTES: u64 = 64
const MAX_OPEN: u64 = 1024

const OF_KIND: u64 = 0
const OF_INO: u64 = 8
const OF_OFF: u64 = 16
const OF_REF: u64 = 24
const OF_FLAGS: u64 = 32
const OF_MNT: u64 = 40

const K_FREE: u64 = 0
const K_FILE: u64 = 1
const K_DIR: u64 = 2
const K_CONIN: u64 = 3
const K_CONOUT: u64 = 4
const K_PIPER: u64 = 5
const K_PIPEW: u64 = 6
const K_FB: u64 = 7

const K_TTY: u64 = 8

const K_SOCK: u64 = 9

const K_VFILE: u64 = 12
const K_VDIR: u64 = 13

const K_USOCK: u64 = 14
const K_SHM: u64 = 15

const K_EVENT: u64 = 20
const K_TIMER: u64 = 21
const K_SIGFD: u64 = 22
const K_EPOLL: u64 = 23
const K_INOTIFY: u64 = 24
const K_NETLINK: u64 = 25
const OF_X1: u64 = 48
const OF_X2: u64 = 56

const CON_IN: u64 = 0
const CON_OUT: u64 = 1
const CON_ERR: u64 = 2

const MAX_FD: u64 = 512

const MAX_PIPES: u64 = 64
const PIPE_CAP: u64 = 65536
const PIPE_BIG: u64 = 8
const PIPE_SMALL_CAP: u64 = 8192
const PIPE_SMALL_OFF: u64 = 524288
const PH_BYTES: u64 = 64
const PH_READ: u64 = 0
const PH_WRITE: u64 = 8
const PH_READERS: u64 = 16
const PH_WRITERS: u64 = 24
const PH_USED: u64 = 32

fn of_at(i: u64) -> u64 {
    return kstate.OFILE_OFF + i * OF_BYTES
}

fn ph_at(i: u64) -> u64 {
    return kstate.PIPEHDR_OFF + i * PH_BYTES
}

fn init(state: u64) {
    kstate.set(state, of_at(CON_IN) + OF_KIND, K_CONIN)
    kstate.set(state, of_at(CON_IN) + OF_REF, 1)
    kstate.set(state, of_at(CON_OUT) + OF_KIND, K_CONOUT)
    kstate.set(state, of_at(CON_OUT) + OF_REF, 1)
    kstate.set(state, of_at(CON_ERR) + OF_KIND, K_CONOUT)
    kstate.set(state, of_at(CON_ERR) + OF_REF, 1)
}

fn slot_at(task: u64, fd: u64) -> u64 {
    return kstate.FDTAB_OFF + (task * MAX_FD + fd) * 8
}

fn fd_handle(state: u64, task: u64, fd: u64) -> u64 {
    if fd >= MAX_FD || task >= kstate.MAX_TASKS {
        return handle.HANDLE_NONE
    }
    return kstate.get(state, slot_at(owner(state, task), fd))
}

fn fd_of(state: u64, task: u64, fd: u64) -> u64 {
    return fd_check(state, task, fd, 0)
}

fn fd_check(state: u64, task: u64, fd: u64, need: u64) -> u64 {
    if fd >= MAX_FD || task >= kstate.MAX_TASKS {
        return MAX_OPEN
    }
    var t: u64 = task
    if (__mmio_read64((state + kstate.TASK_OFF + task * kstate.TASK_BYTES
        + sched.T_FDOWN) as *mut u64) & FDOWN_SLOT) != 0 {
        t = owner(state, task)
    }
    let h: u64 = __mmio_read64(
        (state + kstate.FDTAB_OFF + (t * MAX_FD + fd) * 8) as *mut u64)
    if h == handle.HANDLE_NONE {
        return MAX_OPEN
    }
    return handle.resolve_num(state, t, h, need)
}

fn fd_rights(state: u64, task: u64, fd: u64) -> u64 {
    return handle.rights_of(state, owner(state, task), fd_handle(state, task, fd))
}

fn fd_may(state: u64, task: u64, fd: u64, need: u64) -> bool {
    let h: u64 = fd_handle(state, task, fd)
    if h == handle.HANDLE_NONE {
        return false
    }
    return handle.may(state, owner(state, task), h, need)
}

fn fd_set_rights(state: u64, task0: u64, fd: u64, open: u64,
    rights: u64) -> bool {
    if fd >= MAX_FD || task0 >= kstate.MAX_TASKS {
        return false
    }
    let task: u64 = owner(state, task0)
    if open >= MAX_OPEN {
        return false
    }
    let o: u64 = handle.obj_get(state, handle.OK_FILE, open)
    if o >= handle.MAX_OBJ {
        return false
    }
    let h: u64 = handle.insert(state, task, o, rights)
    if h == handle.HANDLE_NONE {
        handle.obj_unref(state, o)
        return false
    }
    kstate.set(state, slot_at(task, fd), h)
    high_raise(state, task, fd + 1)
    return true
}

fn rights_of_open(state: u64, i: u64) -> u64 {
    var r: u64 = handle.rights_for_flags(kstate.get(state, of_at(i) + OF_FLAGS))
    let kind: u64 = kstate.get(state, of_at(i) + OF_KIND)
    if kind == K_CONIN {
        r = r | handle.R_READ
    }
    if kind == K_CONOUT {
        r = r | handle.R_WRITE
    }
    return r
}

fn fd_set(state: u64, task: u64, fd: u64, open: u64) -> bool {
    if open >= MAX_OPEN {
        return false
    }
    return fd_set_rights(state, task, fd, open, rights_of_open(state, open))
}

fn fd_free(state: u64, task: u64, fd: u64) {
    if task >= kstate.MAX_TASKS {
        return
    }
    fd_free_t(state, owner(state, task), fd)
}

fn fd_free_t(state: u64, task: u64, fd: u64) {
    if fd >= MAX_FD || task >= kstate.MAX_TASKS {
        return
    }
    let h: u64 = kstate.get(state, slot_at(task, fd))
    if h != handle.HANDLE_NONE {
        handle.drop(state, task, h)
    }
    kstate.set(state, slot_at(task, fd), 0)
    let cxo: u64 = kstate.CX_OFF + task * kstate.CX_BYTES + (fd >> 6) * 8
    kstate.set(state, cxo, kstate.get(state, cxo) & (0xFFFFFFFFFFFFFFFF -% (1 << (fd & 63))))
}

fn fd_pass(state: u64, from0: u64, to0: u64, fd: u64, mask: u64,
    tofd: u64) -> u64 {
    if tofd >= MAX_FD || to0 >= kstate.MAX_TASKS || from0 >= kstate.MAX_TASKS {
        return MAX_FD
    }
    let from: u64 = owner(state, from0)
    let to: u64 = owner(state, to0)
    let of: u64 = fd_of(state, from, fd)
    if of >= MAX_OPEN {
        return MAX_FD
    }
    if kstate.get(state, slot_at(to, tofd)) != 0 {
        return MAX_FD
    }
    let nh: u64 = handle.give(state, from, to, fd_handle(state, from, fd), mask)
    if handle.is_err(nh) {
        return MAX_FD
    }
    open_ref(state, of)
    kstate.set(state, slot_at(to, tofd), nh)
    high_raise(state, to, tofd + 1)
    return tofd
}

fn fd_alloc(state: u64, task0: u64, from: u64) -> u64 {
    if task0 >= kstate.MAX_TASKS {
        return MAX_FD
    }
    let task: u64 = owner(state, task0)
    var fd: u64 = from
    while fd < MAX_FD {
        if kstate.get(state, slot_at(task, fd)) == 0 {
            return fd
        }
        fd = fd + 1
    }
    return MAX_FD
}

fn init_task(state: u64, task: u64) {
    clear_task(state, task)
    fd_set(state, task, 0, CON_IN)
    fd_set(state, task, 1, CON_OUT)
    fd_set(state, task, 2, CON_ERR)
}

const FD_HIGH_FIELD: u64 = 24

fn high_addr(state: u64, table: u64) -> u64 {
    return state + kstate.TCPU_OFF + table * kstate.TCPU_BYTES + FD_HIGH_FIELD
}

fn high_mark(state: u64, table: u64) -> u64 {
    let n: u64 = __mmio_read64(high_addr(state, table) as *mut u64)
    if n > MAX_FD {
        return MAX_FD
    }
    return n
}

fn high_raise(state: u64, table: u64, n: u64) {
    let a: u64 = high_addr(state, table)
    while true {
        let cur: u64 = __mmio_read64(a as *mut u64)
        if cur >= n || atomic.cas(a, cur, n) == cur {
            return
        }
    }
}

fn high_reset(state: u64, table: u64) {
    __mmio_write64(high_addr(state, table) as *mut u64, 0)
}

fn used_from(state: u64, table: u64, from: u64) -> u64 {
    let limit: u64 = high_mark(state, table)
    var fd: u64 = from
    var p: u64 = state + slot_at(table, from)
    while fd < limit {
        if __mmio_read64(p as *mut u64) != (0 as u64) {
            return fd
        }
        p = p + 8
        fd = fd + 1
    }
    return MAX_FD
}

fn next_used_fd(state: u64, task: u64, from: u64) -> u64 {
    if task >= kstate.MAX_TASKS || from >= MAX_FD {
        return MAX_FD
    }
    return used_from(state, owner(state, task), from)
}

fn clear_task(state: u64, task: u64) {
    if task >= kstate.MAX_TASKS {
        return
    }
    var fd: u64 = used_from(state, task, 0)
    while fd < MAX_FD {
        fd_free_t(state, task, fd)
        fd = used_from(state, task, fd + 1)
    }
    let cx: u64 = kstate.CX_OFF + task * kstate.CX_BYTES
    var w: u64 = 0
    while w < kstate.CX_BYTES {
        kstate.set(state, cx + w, 0)
        w = w + 8
    }
    high_reset(state, task)
}

fn inherit_task(state: u64, parent: u64, child: u64) {
    clear_task(state, child)
    var fd: u64 = next_used_fd(state, parent, 0)
    while fd < MAX_FD {
        let of: u64 = fd_of(state, parent, fd)
        if of < MAX_OPEN {
            open_ref(state, of)
            fd_set_rights(state, child, fd, of,
                fd_rights(state, parent, fd))
        }
        fd = next_used_fd(state, parent, fd + 1)
    }
}

fn inherit_std(state: u64, parent: u64, child: u64) {
    clear_task(state, child)
    if kstate.mode_on(state, kstate.M_HSTRICT) {
        return
    }
    let logof: u64 = kstate.get(state, kstate.LOGOPEN)
    var fd: u64 = 0
    while fd < 3 {
        let of: u64 = fd_of(state, parent, fd)
        if of < MAX_OPEN {
            if fd != 0 && logof != 0 && of == logof {
                open_ref(state, fd)
                fd_set_rights(state, child, fd, fd, rights_of_open(state, fd))
            } else {
                open_ref(state, of)
                fd_set_rights(state, child, fd, of, fd_rights(state, parent, fd))
            }
        }
        fd = fd + 1
    }
}

fn close_all(state: u64, task: u64) {
    if task >= kstate.MAX_TASKS {
        return
    }
    if owner(state, task) != task {
        return
    }
    release_table(state, task)
}

fn release_table(state: u64, t: u64) {
    if t >= kstate.MAX_TASKS {
        return
    }
    var fd: u64 = used_from(state, t, 0)
    while fd < MAX_FD {
        let a: u64 = state + slot_at(t, fd)
        let h: u64 = __mmio_read64(a as *mut u64)
        if h != handle.HANDLE_NONE && atomic.cas(a, h, 0) == h {
            let of: u64 = handle.resolve_num(state, t, h, 0)
            if of < MAX_OPEN {
                open_unref(state, of)
            }
            handle.drop(state, t, h)
            let cxo: u64 = kstate.CX_OFF + t * kstate.CX_BYTES + (fd >> 6) * 8
            kstate.set(state, cxo, kstate.get(state, cxo) & (0xFFFFFFFFFFFFFFFF -% (1 << (fd & 63))))
        }
        fd = used_from(state, t, fd + 1)
    }
    high_reset(state, t)
}

const FDOWN_SLOT: u64 = 0xFFFF
const FDOWN_REL: u64 = 0x8000000000000000

fn owner(state: u64, task: u64) -> u64 {
    if task >= kstate.MAX_TASKS {
        return task
    }
    let w: u64 = taskslot.tget(state, task, sched.T_FDOWN)
    let s: u64 = w & FDOWN_SLOT
    if s == 0 {
        return task
    }
    let o: u64 = s - 1
    if o >= kstate.MAX_TASKS {
        return task
    }
    if (taskslot.tget(state, o, sched.T_PID) & 0xFFFFFFFF) != ((w >> 16) & 0xFFFFFFFF) {
        return task
    }
    if taskslot.tget(state, o, sched.T_STATE) == sched.S_FREE {
        return task
    }
    return o
}

fn share_table(state: u64, me: u64, thread: u64) {
    clear_task(state, thread)
    let o: u64 = owner(state, me)
    taskslot.tset(state, thread, sched.T_FDOWN,
        (((taskslot.tget(state, o, sched.T_PID) & 0xFFFFFFFF)) << 16) | (o + 1))
}

fn uses_table(state: u64, i: u64, t: u64) -> bool {
    let st: u64 = taskslot.tget(state, i, sched.T_STATE)
    if st == sched.S_FREE || st == sched.S_ZOMBIE || st == sched.S_REAPING
        || st == sched.S_NEW {
        return false
    }
    let w: u64 = taskslot.tget(state, i, sched.T_FDOWN)
    if (w & FDOWN_REL) != 0 {
        return false
    }
    if i == t {
        return (w & FDOWN_SLOT) == 0
    }
    return owner(state, i) == t && (w & FDOWN_SLOT) != 0
}

fn release_use(state: u64, task: u64) -> bool {
    if task >= kstate.MAX_TASKS {
        return true
    }
    let t: u64 = owner(state, task)
    let flags: u64 = sched.irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    taskslot.tset(state, task, sched.T_FDOWN,
        taskslot.tget(state, task, sched.T_FDOWN) | FDOWN_REL)
    var last: bool = true
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        if i != task && uses_table(state, i, t) {
            last = false
        }
        i = i + 1
    }
    atomic.lock_give(state, atomic.L_SCHED)
    sched.irq_restore(flags)
    return last
}

fn open_used(state: u64, i: u64) -> bool {
    if i >= MAX_OPEN {
        return false
    }
    return kstate.get(state, of_at(i) + OF_KIND) != K_FREE
}

fn open_alloc(state: u64, kind: u64, ino: u64, flags: u64) -> u64 {
    var i: u64 = CON_ERR + 1
    while i < MAX_OPEN {
        if kstate.get(state, of_at(i) + OF_KIND) == K_FREE {
            kstate.set(state, of_at(i) + OF_KIND, kind)
            kstate.set(state, of_at(i) + OF_INO, ino)
            kstate.set(state, of_at(i) + OF_OFF, 0)
            kstate.set(state, of_at(i) + OF_REF, 1)
            kstate.set(state, of_at(i) + OF_FLAGS, flags)
            kstate.set(state, of_at(i) + OF_MNT, 0)
            kstate.set(state, of_at(i) + OF_X1, 0)
            kstate.set(state, of_at(i) + OF_X2, 0)
            kstate.add(state, kstate.OPENS, 1)
            return i
        }
        i = i + 1
    }
    return MAX_OPEN
}

fn open_ref(state: u64, i: u64) {
    if i >= MAX_OPEN || i <= CON_ERR {
        return
    }
    kstate.add(state, of_at(i) + OF_REF, 1)
}

fn open_unref(state: u64, i: u64) {
    if i >= MAX_OPEN || i <= CON_ERR {
        return
    }
    let r: u64 = kstate.get(state, of_at(i) + OF_REF)
    if r > 1 {
        kstate.set(state, of_at(i) + OF_REF, r - 1)
        return
    }
    kstate.set(state, of_at(i) + OF_REF, 0)
    if handle.inflight_on(state, handle.OK_FILE, i) != 0 {
        kstate.add(state, kstate.H_DEFERRED, 1)
        return
    }
    open_teardown(state, i)
}

fn open_teardown(state: u64, i: u64) {
    let kind: u64 = kstate.get(state, of_at(i) + OF_KIND)
    let p: u64 = kstate.get(state, of_at(i) + OF_INO)
    if kind == K_PIPER {
        pipe_drop(state, p, true)
    }
    if kind == K_PIPEW {
        pipe_drop(state, p, false)
    }
    if kind == K_EPOLL || kind == K_INOTIFY || kind == K_NETLINK {
        let fr: u64 = kstate.get(state, of_at(i) + OF_OFF)
        if fr != 0 {
            mmframe.frame_free(state, fr)
        }
    }
    if kind == K_DIR || kind == K_VDIR {
        let pf: u64 = kstate.get(state, of_at(i) + OF_X1)
        if pf != 0 {
            mmframe.frame_free(state, pf)
        }
    }
    if kind == K_VFILE || kind == K_VDIR {
        let dm: u64 = kstate.get(state, of_at(i) + OF_MNT)
        mnt.open_dec(state, dm)
        let dt: u64 = mnt.fstype(state, dm)
        if dt == vfsops.FS_EXT4 {
            ext4.node_drop(state, p)
        }
        if dt == vfsops.FS_NTFS {
            ntfs.node_drop(state, p)
        }
        if dt == vfsops.FS_EXFAT {
            exfat.node_drop(state, p)
        }
        if dt == vfsops.FS_FAT {
            fat.node_drop(state, p)
        }
    }
    kstate.set(state, of_at(i) + OF_KIND, K_FREE)
    kstate.set(state, of_at(i) + OF_INO, 0)
    kstate.set(state, of_at(i) + OF_OFF, 0)
    kstate.set(state, of_at(i) + OF_REF, 0)
    kstate.set(state, of_at(i) + OF_FLAGS, 0)
    kstate.set(state, of_at(i) + OF_MNT, 0)
    kstate.set(state, of_at(i) + OF_X1, 0)
    kstate.set(state, of_at(i) + OF_X2, 0)
}

fn open_settle(state: u64, i: u64) {
    if i >= MAX_OPEN || i <= CON_ERR {
        return
    }
    if kstate.get(state, of_at(i) + OF_KIND) == K_FREE {
        return
    }
    if kstate.get(state, of_at(i) + OF_REF) != 0 {
        return
    }
    if handle.inflight_on(state, handle.OK_FILE, i) != 0 {
        return
    }
    open_teardown(state, i)
}

fn open_refs(state: u64, i: u64) -> u64 {
    if i >= MAX_OPEN {
        return 0
    }
    return kstate.get(state, of_at(i) + OF_REF)
}

fn open_x1(state: u64, i: u64) -> u64 {
    if i >= MAX_OPEN {
        return 0
    }
    return kstate.get(state, of_at(i) + OF_X1)
}

fn open_set_x1(state: u64, i: u64, v: u64) {
    if i < MAX_OPEN {
        kstate.set(state, of_at(i) + OF_X1, v)
    }
}

fn open_x2(state: u64, i: u64) -> u64 {
    if i >= MAX_OPEN {
        return 0
    }
    return kstate.get(state, of_at(i) + OF_X2)
}

fn open_set_x2(state: u64, i: u64, v: u64) {
    if i < MAX_OPEN {
        kstate.set(state, of_at(i) + OF_X2, v)
    }
}

fn open_addr(state: u64, i: u64) -> u64 {
    return state + of_at(i)
}

fn open_kind(state: u64, i: u64) -> u64 {
    if i >= MAX_OPEN {
        return K_FREE
    }
    return kstate.get(state, of_at(i) + OF_KIND)
}

fn open_ino(state: u64, i: u64) -> u64 {
    return kstate.get(state, of_at(i) + OF_INO)
}

fn open_off(state: u64, i: u64) -> u64 {
    return kstate.get(state, of_at(i) + OF_OFF)
}

fn open_set_off(state: u64, i: u64, off: u64) {
    kstate.set(state, of_at(i) + OF_OFF, off)
}

fn open_mnt(state: u64, i: u64) -> u64 {
    return kstate.get(state, of_at(i) + OF_MNT)
}

fn open_set_mnt(state: u64, i: u64, v: u64) {
    kstate.set(state, of_at(i) + OF_MNT, v)
}

fn open_flags(state: u64, i: u64) -> u64 {
    return kstate.get(state, of_at(i) + OF_FLAGS)
}

fn open_set_flags(state: u64, i: u64, f: u64) {
    kstate.set(state, of_at(i) + OF_FLAGS, f)
}

fn pipe_new(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_PIPES {
        if kstate.get(state, ph_at(i) + PH_USED) == 0 {
            kstate.set(state, ph_at(i) + PH_USED, 1)
            kstate.set(state, ph_at(i) + PH_READ, 0)
            kstate.set(state, ph_at(i) + PH_WRITE, 0)
            kstate.set(state, ph_at(i) + PH_READERS, 1)
            kstate.set(state, ph_at(i) + PH_WRITERS, 1)
            kstate.add(state, kstate.PIPES, 1)
            return i
        }
        i = i + 1
    }
    return MAX_PIPES
}

fn pipe_drop(state: u64, i: u64, reader: bool) {
    if i >= MAX_PIPES {
        return
    }
    if reader {
        let r: u64 = kstate.get(state, ph_at(i) + PH_READERS)
        if r > 0 {
            kstate.set(state, ph_at(i) + PH_READERS, r - 1)
        }
    } else {
        let w: u64 = kstate.get(state, ph_at(i) + PH_WRITERS)
        if w > 0 {
            kstate.set(state, ph_at(i) + PH_WRITERS, w - 1)
        }
    }
    let rd: u64 = kstate.get(state, ph_at(i) + PH_READERS)
    let wr: u64 = kstate.get(state, ph_at(i) + PH_WRITERS)
    if rd == 0 && wr == 0 {
        kstate.set(state, ph_at(i) + PH_USED, 0)
    }
    sched.poll_kick(state)
}

fn pipe_bytes(state: u64, i: u64) -> u64 {
    if i >= MAX_PIPES {
        return 0
    }
    let w: u64 = kstate.get(state, ph_at(i) + PH_WRITE)
    let r: u64 = kstate.get(state, ph_at(i) + PH_READ)
    return w - r
}

fn pipe_cap(i: u64) -> u64 {
    if i < PIPE_BIG {
        return PIPE_CAP
    }
    return PIPE_SMALL_CAP
}

fn pipe_base(i: u64) -> u64 {
    if i < PIPE_BIG {
        return i * PIPE_CAP
    }
    return PIPE_SMALL_OFF + (i - PIPE_BIG) * PIPE_SMALL_CAP
}

fn pipe_room(state: u64, i: u64) -> u64 {
    return pipe_cap(i) - pipe_bytes(state, i)
}

fn pipe_writers(state: u64, i: u64) -> u64 {
    if i >= MAX_PIPES {
        return 0
    }
    return kstate.get(state, ph_at(i) + PH_WRITERS)
}

fn pipe_readers(state: u64, i: u64) -> u64 {
    if i >= MAX_PIPES {
        return 0
    }
    return kstate.get(state, ph_at(i) + PH_READERS)
}

fn pipe_put(state: u64, i: u64, v: u64) -> bool {
    if pipe_room(state, i) == 0 {
        return false
    }
    let w: u64 = kstate.get(state, ph_at(i) + PH_WRITE)
    let at: u64 = state + kstate.PIPEBUF_OFF + pipe_base(i) + (w % pipe_cap(i))
    kstate.set8(at, v as u8)
    kstate.set(state, ph_at(i) + PH_WRITE, w + 1)
    return true
}

fn pipe_get(state: u64, i: u64) -> u64 {
    if pipe_bytes(state, i) == 0 {
        return 256
    }
    let r: u64 = kstate.get(state, ph_at(i) + PH_READ)
    let at: u64 = state + kstate.PIPEBUF_OFF + pipe_base(i) + (r % pipe_cap(i))
    let v: u64 = kstate.get8(at)
    kstate.set(state, ph_at(i) + PH_READ, r + 1)
    return v
}
