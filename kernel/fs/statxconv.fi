// SPDX-License-Identifier: GPL-2.0-only
profile kernel

export { STATX_BYTES, SYS_STATX, convert }

const STATX_BYTES: u64 = 256
const SYS_STATX: u64 = 332
const STATX_BASIC_STATS: u64 = 2047

const ST_DEV: u64 = 0
const ST_INO: u64 = 8
const ST_NLINK: u64 = 16
const ST_MODE: u64 = 24
const ST_UID: u64 = 28
const ST_GID: u64 = 32
const ST_RDEV: u64 = 40
const ST_SIZE: u64 = 48
const ST_BLKSIZE: u64 = 56
const ST_BLOCKS: u64 = 64
const ST_ATIME: u64 = 72
const ST_MTIME: u64 = 88
const ST_CTIME: u64 = 104

const SX_MASK: u64 = 0
const SX_BLKSIZE: u64 = 4
const SX_NLINK: u64 = 16
const SX_UID: u64 = 20
const SX_GID: u64 = 24
const SX_MODE: u64 = 28
const SX_INO: u64 = 32
const SX_SIZE: u64 = 40
const SX_BLOCKS: u64 = 48
const SX_ATIME: u64 = 64
const SX_CTIME: u64 = 96
const SX_MTIME: u64 = 112
const SX_RDEV_MAJOR: u64 = 128
const SX_RDEV_MINOR: u64 = 132
const SX_DEV_MAJOR: u64 = 136
const SX_DEV_MINOR: u64 = 140

fn major(dev: u64) -> u64 {
    return ((dev >> 8) & 4095) | ((dev >> 32) & 4294963200)
}

fn minor(dev: u64) -> u64 {
    return (dev & 255) | ((dev >> 12) & 4294967040)
}

fn put_time(dst: u64, secs: u64) {
    __mmio_write64(dst as *mut u64, secs)
    __mmio_write64((dst + 8) as *mut u64, 0)
}

fn convert(src: u64, dst: u64) {
    var i: u64 = 0
    while i < STATX_BYTES {
        __mmio_write8((dst + i) as *mut u8, 0 as u8)
        i = i + 1
    }
    let dev: u64 = __mmio_read64((src + ST_DEV) as *mut u64)
    let rdev: u64 = __mmio_read64((src + ST_RDEV) as *mut u64)
    __mmio_write32((dst + SX_MASK) as *mut u32, STATX_BASIC_STATS as u32)
    __mmio_write32((dst + SX_BLKSIZE) as *mut u32, __mmio_read64((src + ST_BLKSIZE) as *mut u64) as u32)
    __mmio_write32((dst + SX_NLINK) as *mut u32, __mmio_read64((src + ST_NLINK) as *mut u64) as u32)
    __mmio_write32((dst + SX_UID) as *mut u32, __mmio_read32((src + ST_UID) as *mut u32))
    __mmio_write32((dst + SX_GID) as *mut u32, __mmio_read32((src + ST_GID) as *mut u32))
    __mmio_write16((dst + SX_MODE) as *mut u16, __mmio_read32((src + ST_MODE) as *mut u32) as u16)
    __mmio_write64((dst + SX_INO) as *mut u64, __mmio_read64((src + ST_INO) as *mut u64))
    __mmio_write64((dst + SX_SIZE) as *mut u64, __mmio_read64((src + ST_SIZE) as *mut u64))
    __mmio_write64((dst + SX_BLOCKS) as *mut u64, __mmio_read64((src + ST_BLOCKS) as *mut u64))
    put_time(dst + SX_ATIME, __mmio_read64((src + ST_ATIME) as *mut u64))
    put_time(dst + SX_CTIME, __mmio_read64((src + ST_CTIME) as *mut u64))
    put_time(dst + SX_MTIME, __mmio_read64((src + ST_MTIME) as *mut u64))
    __mmio_write32((dst + SX_RDEV_MAJOR) as *mut u32, major(rdev) as u32)
    __mmio_write32((dst + SX_RDEV_MINOR) as *mut u32, minor(rdev) as u32)
    __mmio_write32((dst + SX_DEV_MAJOR) as *mut u32, major(dev) as u32)
    __mmio_write32((dst + SX_DEV_MINOR) as *mut u32, minor(dev) as u32)
}
