profile kernel

import lib.kstate
import lib.errno
import fs.vfs

export { failure_errno }

const SLASH: u64 = 47

fn last_slash(path: u64) -> u64 {
    var i: u64 = 0
    var at: u64 = 0
    while kstate.get8(path + i) != 0 {
        if kstate.get8(path + i) == SLASH {
            at = i
        }
        i = i + 1
    }
    return at
}

fn failure_errno(state: u64, m: u64, path: u64) -> u64 {
    let at: u64 = last_slash(path)
    if at == 0 {
        return errno.E_NOSPC
    }
    kstate.set8(path + at, 0)
    let parent: u64 = vfs.node_for(state, m, path)
    kstate.set8(path + at, SLASH as u8)
    if parent == 0 {
        return errno.E_NOENT
    }
    return errno.E_NOSPC
}
