// SPDX-License-Identifier: GPL-2.0-only
// kernel/devfs.fi -- Runde K14: /dev als ECHTES Dateisystem.
//
// WAS ES VORHER GAB, und warum es zu wenig war. Runde K7 brauchte einen
// Rahmenpuffer in Ring 3 und schrieb dafuer in `sys.do_open` drei
// Zeilen, die den Namen `/dev/fb` ABFANGEN, bevor irgendetwas
// nachgeschlagen wird. Der Kommentar dort ist ehrlich: "Es ist AUCH
// kein Verzeichnis `/dev` im OFS -- der Name wird abgefangen [...] Ein
// Osum mit einem echten Geraeteverzeichnis waere eine eigene Runde."
// Das ist diese Runde.
//
// Der Unterschied ist nicht kosmetisch. Ein abgefangener Name kann
// nicht aufgelistet werden, hat keine Groesse, keine Rechte, keinen
// `stat`, und jeder weitere Geraetename waere ein weiteres `if` in der
// heissesten Weiche des Kernels. Ein Dateisystem hat ein Verzeichnis:
// `ls -l /dev` zaehlt auf, was diese Maschine hat, und jedes Stueck
// davon hat eine Art, eine Kennzahl und ein `stat`, das sie sagt.
//
// WAS HIER DRIN LIEGT und wo die Oktette wirklich herkommen:
//
//   /dev/null      liest nichts (sofort Dateiende), schluckt alles
//   /dev/zero      liest Nullen, so viele wie verlangt
//   /dev/random    aus `kernel/rand.fi`, dem Sammler von Runde K9
//   /dev/urandom   dasselbe -- dieser Kernel hat KEINEN zweiten Topf,
//                  und zwei Namen fuer zwei Toepfe zu behaupten waere
//                  eine Luege ueber die Qualitaet des einen
//   /dev/tty       das beherrschende Terminal des LESENDEN Prozesses.
//                  Der Knoten selbst weiss nichts davon; `sys.fi` macht
//                  daraus einen K_TTY-Deskriptor, und ab da ist es
//                  wortgleich der Weg von Runde K9.
//   /dev/console   dasselbe fuer die Konsole
//   /dev/fb        der Rahmenpuffer, ebenso: `sys.fi` macht einen
//                  K_FB-Deskriptor daraus, und alle Messungen der Runde
//                  K7 laufen unveraendert weiter
//   /dev/hda       DIE PLATTE, blockweise. Das ist die einzige Datei
//                  hier, deren Oktette wirklich auf einem Traeger
//                  liegen -- und die, mit der `tools/k14/run.sh` misst,
//                  dass hier keine Attrappe steht: es liest den
//                  Bootsektor der zweiten Platte durch /dev/hdb und
//                  haelt ihn gegen das, was der WIRT in der Abbilddatei
//                  stehen hat.
//   /dev/hdb       die zweite Platte (der ATA-Sklave)
//   /dev/ram0      die RAM-Platte
//   /dev/nvme0     der NVMe-Regler von Runde K2
//
// KEIN ZUSTAND. Dieses Dateisystem hat keine Tafel im Speicher: der
// Knoten IST die Geraetenummer, die Liste steht als Kette von `if` in
// `name_to_node`, und ein Geraet mehr ist eine Zeile. Das ist die
// kleinste Bauart, die "echtes Dateisystem" noch ehrlich traegt.

profile kernel

import lib.kstate
import fs.mnt
import fs.vfsops
import sched.rand
import sched.randwait
import block.blk
import sched.sched
import sync.atomic
import arch.cpu
import klog
import drv.con.tty
import drv.con.odbuart
import fs.unixsock
import block.wlock
import bus.drvctlnode
import fs.procbt
import diag.tpmdev

export { ops, node_root, D_TTY, D_FB, D_CONSOLE, is_tty, is_fb, rdev_of, is_ptmx, pts_slot, shm_slot, full_path_in_shm }

// Die Knoten. Die 0 bleibt frei ("gibt es nicht"), die Wurzel ist 100 --
// damit ein Knoten nie mit einer Geraetenummer verwechselt wird.
const D_NULL: u64 = 1
const D_ZERO: u64 = 2
const D_RANDOM: u64 = 3
const D_URANDOM: u64 = 4
const D_TTY: u64 = 5
const D_CONSOLE: u64 = 6
const D_FB: u64 = 7
const D_HDA: u64 = 8
const D_HDB: u64 = 9
const D_RAM0: u64 = 10
const D_NVME0: u64 = 11
// RUNDE K17: der Stick. Er steht NUR dann im Verzeichnis, wenn wirklich
// einer angesteckt ist (`readdir`/`lookup` fragen `blk.present_on`) --
// ein Geraetename ohne Geraet dahinter waere eine Behauptung, und beim
// Abziehen verschwindet er wieder. Deshalb aendert sich an /dev in jedem
// Lauf ohne USB kein einziges Oktett.
const D_USB0: u64 = 12
// ==================================================== RUNDE PROTOKOLL
//
// /dev/klog -- DAS KERNPROTOKOLL ALS DATEI.
//
// Es ist der erste Knoten dieses Verzeichnisses, hinter dem WEDER ein
// Geraet noch eine Platte steckt, sondern ein Ringpuffer in `kdata`.
// Genau dafuer ist ein Geraeteverzeichnis da: `cat /dev/klog` liest,
// `echo hallo > /dev/klog` schreibt eine Zeile hinein, und kein
// Programm muss dafuer den Aufruf 1860 kennen.
//
// WIE DER VERSATZ AUF EINE ZEILE ABGEBILDET WIRD. Der Ring hat keine
// Oktettadressen, er hat Eintraege. `d_read` geht deshalb von der
// aeltesten noch vorhandenen Zeile an vorwaerts und zaehlt Laengen,
// bis es `off` erreicht hat. Das ist O(Zeilen) je Lesevorgang und
// waere fuer eine Platte unbrauchbar; fuer 510 Zeilen, die ein Mensch
// oder ein `cat` einmal liest, ist es die einfachste richtige Loesung.
//
// WAS DAS BEDEUTET, UND ES STEHT HIER STATT IN EINER FUSSNOTE: DER
// RING DREHT SICH WEITER, WAEHREND GELESEN WIRD. Wer /dev/klog mit
// vielen kleinen `read` liest, waehrend der Kern schreibt, bekommt
// keinen zusammenhaengenden Schnappschuss. Wer das braucht, nimmt
// `/bin/log`: es liest ueber den Aufruf 1860 NACH LAUFNUMMERN und
// merkt daran, dass ihm etwas entgangen ist.
const D_KLOG: u64 = 13
// The SATA disk behind an AHCI controller (Dell 9020). Listed only when
// the controller came up and a disk answered (`da`).
const D_SDA: u64 = 14
// ROUND FOOT-1 (PTY ABI): /dev/ptmx opens a NEW pty pair and gives the master; /dev/pts/N is the slave of pair N (N = the tty
// slot of the slave, what TIOCGPTN returns). Nothing is stored here: a /dev/pts entry exists exactly as long as that tty slot is
// a pty slave in use, so `ls /dev/pts` lists the pairs that are really open.
const D_PTMX: u64 = 15
const D_PTS: u64 = 16
// W-MG3: /dev/tty1../dev/tty6 -- virtual console names (busybox init / getty open them); all of them are the console tty
const D_TTY1: u64 = 17
const D_TTY6: u64 = 22
const D_SHM: u64 = 23
// ODB debug agent: raw COM2 (drv/con/odbuart.fi); listed only when the chip answers and the console does not own it
const D_ODB: u64 = 24
const D_WLOCK: u64 = 25
const D_DRVCTL: u64 = 26
const D_BTCTL: u64 = 27
const D_TPM0: u64 = 28
const D_LAST: u64 = 28
// /dev/shm/NAME: node SHM_BASE + i is the paged shm object i (unixsock), its name lives in kstate.SHMN_OFF + i * SHMN_SLOT.
// The name owns one reference of the object; unlink drops it. Only the USHM_PAGED paged objects can be named.
const SHM_BASE: u64 = 300
// the nodes of /dev/pts/N are PTS_BASE + N (above D_ROOT, so they are never taken for a device number)
const PTS_BASE: u64 = 200
const D_ROOT: u64 = 100

const BS: u64 = 512

fn node_root(state: u64) -> u64 {
    return D_ROOT
}

fn tick(state: u64) {
    kstate.add(state, kstate.VFS_INDIRECT, 1)
}

fn is_tty(node: u64) -> bool {
    return node == D_TTY || node == D_CONSOLE || (node >= D_TTY1 && node <= D_TTY6)
}

fn is_fb(node: u64) -> bool {
    return node == D_FB
}

fn is_ptmx(node: u64) -> bool {
    return node == D_PTMX
}

// The tty slot behind a /dev/pts/N node; MAX_TTY = not a pts node.
fn pts_slot(node: u64) -> u64 {
    if node >= PTS_BASE && node < PTS_BASE + tty.MAX_TTY {
        return node - PTS_BASE
    }
    return tty.MAX_TTY
}

fn pts_live(state: u64, slot: u64) -> bool {
    return slot >= 1 && slot < tty.MAX_TTY && tty.valid(state, slot) && tty.kind_of(state, slot) == tty.K_PTY_SLAVE
}

// Die Kennzahl, die `stat` in `st_rdev` traegt. Sie ist der Knoten
// selbst -- eine zweite Nummerierung waere eine zweite Stelle, an der
// dasselbe steht.
fn rdev_of(node: u64) -> u64 {
    return node
}

// Object index of a /dev/shm file node, MAX (USHM_PAGED) when the node is not one.
fn shm_slot(node: u64) -> u64 {
    if node >= SHM_BASE && node < SHM_BASE + unixsock.USHM_PAGED {
        return node - SHM_BASE
    }
    return unixsock.USHM_PAGED
}

fn shm_name_addr(state: u64, i: u64) -> u64 {
    return state + kstate.SHMN_OFF + i * kstate.SHMN_SLOT
}

fn shm_named(state: u64, i: u64) -> bool {
    return i < unixsock.USHM_PAGED && kstate.get8(shm_name_addr(state, i)) != 0 && unixsock.shm_used(state, i) != 0
}

// Slot of the object named `name` (NUL-terminated), USHM_PAGED when there is none.
fn shm_find(state: u64, name: u64) -> u64 {
    var i: u64 = 0
    while i < unixsock.USHM_PAGED {
        if shm_named(state, i) && streq(name, shm_name_addr(state, i)) {
            return i
        }
        i = i + 1
    }
    return unixsock.USHM_PAGED
}

// Path "[/]shm/NAME" -> address of NAME, 0 if the path is not below shm/ (NAME may be empty).
fn shm_rest(path: u64) -> u64 {
    var p: u64 = path
    while kstate.get8(p) == 47 {
        p = p + 1
    }
    if kstate.get8(p) == 115 && kstate.get8(p + 1) == 104 && kstate.get8(p + 2) == 109 && kstate.get8(p + 3) == 47 {
        return p + 4
    }
    return 0
}

// Does a FULL path (e.g. "/dev/shm/x") have a "/shm/" component? Used to pick EPERM vs ENOSPC when create failed.
fn full_path_in_shm(path: u64) -> bool {
    var i: u64 = 0
    while kstate.get8(path + i) != 0 {
        if kstate.get8(path + i) == 47 && kstate.get8(path + i + 1) == 115 && kstate.get8(path + i + 2) == 104
            && kstate.get8(path + i + 3) == 109 && kstate.get8(path + i + 4) == 47 {
            return true
        }
        i = i + 1
    }
    return false
}

fn streq(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while kstate.get8(a + i) != 0 && kstate.get8(b + i) != 0 {
        if kstate.get8(a + i) != kstate.get8(b + i) {
            return false
        }
        i = i + 1
    }
    return kstate.get8(a + i) == kstate.get8(b + i)
}

// Den Namen des n-ten Geraets in `out` schreiben. EINE Liste, von der
// `lookup` und `readdir` beide leben -- zwei Listen waeren zwei
// Wahrheiten, und die zweite waere irgendwann die falsche.
fn name_at(node: u64, out: u64) -> bool {
    var n_null: [u8; 5] = "null\0"
    var n_zero: [u8; 5] = "zero\0"
    var n_rand: [u8; 7] = "random\0"
    var n_urand: [u8; 8] = "urandom\0"
    var n_tty: [u8; 4] = "tty\0"
    var n_con: [u8; 8] = "console\0"
    var n_fb: [u8; 3] = "fb\0"
    var n_hda: [u8; 4] = "hda\0"
    var n_hdb: [u8; 4] = "hdb\0"
    var n_ram: [u8; 5] = "ram0\0"
    var n_nvme: [u8; 6] = "nvme0\0"
    var n_usb: [u8; 4] = "usb\0"
    var n_klog: [u8; 5] = "klog\0"
    var n_sda: [u8; 4] = "sda\0"
    var n_ptmx: [u8; 5] = "ptmx\0"
    var n_pts: [u8; 4] = "pts\0"
    var n_shm: [u8; 4] = "shm\0"
    var n_odb: [u8; 5] = "odb0\0"
    var n_wlock: [u8; 6] = "wlock\0"
    var n_drvctl: [u8; 7] = "drvctl\0"
    var n_btctl: [u8; 6] = "btctl\0"
    var n_tpm0: [u8; 5] = "tpm0\0"
    var src: u64 = 0
    if node >= D_TTY1 && node <= D_TTY6 {
        kstate.set8(out, 116 as u8)
        kstate.set8(out + 1, 116 as u8)
        kstate.set8(out + 2, 121 as u8)
        kstate.set8(out + 3, (48 + node - D_TTY1 + 1) as u8)
        kstate.set8(out + 4, 0 as u8)
        return true
    }
    if node == D_NULL {
        src = (&n_null[0]) as u64
    } else if node == D_ZERO {
        src = (&n_zero[0]) as u64
    } else if node == D_RANDOM {
        src = (&n_rand[0]) as u64
    } else if node == D_URANDOM {
        src = (&n_urand[0]) as u64
    } else if node == D_TTY {
        src = (&n_tty[0]) as u64
    } else if node == D_CONSOLE {
        src = (&n_con[0]) as u64
    } else if node == D_FB {
        src = (&n_fb[0]) as u64
    } else if node == D_HDA {
        src = (&n_hda[0]) as u64
    } else if node == D_HDB {
        src = (&n_hdb[0]) as u64
    } else if node == D_RAM0 {
        src = (&n_ram[0]) as u64
    } else if node == D_NVME0 {
        src = (&n_nvme[0]) as u64
    } else if node == D_USB0 {
        src = (&n_usb[0]) as u64
    } else if node == D_KLOG {
        src = (&n_klog[0]) as u64
    } else if node == D_SDA {
        src = (&n_sda[0]) as u64
    } else if node == D_PTMX {
        src = (&n_ptmx[0]) as u64
    } else if node == D_PTS {
        src = (&n_pts[0]) as u64
    } else if node == D_SHM {
        src = (&n_shm[0]) as u64
    } else if node == D_ODB {
        src = (&n_odb[0]) as u64
    } else if node == D_WLOCK {
        src = (&n_wlock[0]) as u64
    } else if node == D_DRVCTL {
        src = (&n_drvctl[0]) as u64
    } else if node == D_BTCTL {
        src = (&n_btctl[0]) as u64
    } else if node == D_TPM0 {
        src = (&n_tpm0[0]) as u64
    } else {
        return false
    }
    var i: u64 = 0
    while kstate.get8(src + i) != 0 {
        kstate.set8(out + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(out + i, 0 as u8)
    return true
}

// Welches Blockgeraet steht hinter diesem Knoten? MAX heisst: keines.
fn block_of(node: u64) -> u64 {
    if node == D_HDA {
        return blk.DEV_ATA
    }
    if node == D_HDB {
        return blk.DEV_ATA1
    }
    if node == D_RAM0 {
        return blk.DEV_RAM
    }
    if node == D_NVME0 {
        return blk.DEV_NVME
    }
    if node == D_USB0 {
        return blk.DEV_USB
    }
    if node == D_SDA {
        return blk.DEV_AHCI
    }
    return 99
}

fn is_block(node: u64) -> bool {
    return block_of(node) != 99
}

// ------------------------------------------------------ die Verrichtungen

fn d_lookup(state: u64, m: u64, path: u64) -> u64 {
    tick(state)
    var name: [u8; 16] = [0 as u8; 16]
    var p: u64 = path
    while kstate.get8(p) == 47 {
        p = p + 1
    }
    if kstate.get8(p) == 0 {
        return D_ROOT
    }
    // /dev/pts/N : "pts/" then decimal digits only
    if kstate.get8(p) == 112 && kstate.get8(p + 1) == 116 && kstate.get8(p + 2) == 115 && kstate.get8(p + 3) == 47 {
        var q: u64 = p + 4
        if kstate.get8(q) == 0 {
            return D_PTS // "pts/"
        }
        var num: u64 = 0
        var nd: u64 = 0
        while kstate.get8(q) >= 48 && kstate.get8(q) <= 57 && nd < 4 {
            num = num * 10 + (kstate.get8(q) - 48)
            q = q + 1
            nd = nd + 1
        }
        if nd == 0 || kstate.get8(q) != 0 || !pts_live(state, num) {
            return 0
        }
        return PTS_BASE + num
    }
    // /dev/shm/NAME
    let shm_n: u64 = shm_rest(p)
    if shm_n != 0 {
        if kstate.get8(shm_n) == 0 {
            return D_SHM
        }
        let si: u64 = shm_find(state, shm_n)
        if si >= unixsock.USHM_PAGED {
            return 0
        }
        return SHM_BASE + si
    }
    // Ein Geraeteverzeichnis hat keine Unterverzeichnisse; ein
    // Schraegstrich im Rest ist deshalb ein Fehler und keine Suche.
    var i: u64 = 0
    while kstate.get8(p + i) != 0 {
        if kstate.get8(p + i) == 47 {
            return 0
        }
        i = i + 1
    }
    var node: u64 = 1
    while node <= D_LAST {
        if name_at(node, (&name[0]) as u64) {
            if streq(p, (&name[0]) as u64) {
                if !da(state, node) {
                    return 0
                }
                return node
            }
        }
        node = node + 1
    }
    return 0
}

// RUNDE K17: GIBT ES DAS GERAET UEBERHAUPT NOCH? Fuer alles, was dieser
// Kernel seit 1986 kennt, ist die Antwort immer ja -- eine ATA-Platte
// verschwindet nicht im Betrieb. Ein Stick tut es, und deshalb ist
// /dev/usb0 der erste Eintrag dieses Verzeichnisses, dessen Dasein eine
// FRAGE ist und keine Zeile in einer Tabelle.
fn da(state: u64, node: u64) -> bool {
    if node == D_USB0 {
        return blk.present_on(state, blk.DEV_USB)
    }
    // No bring-up here (it deadlocked under the fs lock): kmain does it
    // at boot, this only asks whether a disk answered.
    if node == D_SDA {
        return blk.ahci_ready(state)
    }
    if node == D_ODB {
        return odbuart.present(state)
    }
    if node == D_TPM0 {
        return tpmdev.present(state)
    }
    return true
}

// /dev/pts: ".", "..", then the number of every pty slave in use
fn pts_readdir(state: u64, index: u64, out: u64) -> u64 {
    if index == 0 {
        kstate.set8(out, 46 as u8)
        kstate.set8(out + 1, 0 as u8)
        return D_PTS
    }
    if index == 1 {
        kstate.set8(out, 46 as u8)
        kstate.set8(out + 1, 46 as u8)
        kstate.set8(out + 2, 0 as u8)
        return D_PTS
    }
    var want: u64 = index - 2
    var t: u64 = 1
    while t < tty.MAX_TTY {
        if pts_live(state, t) {
            if want == 0 {
                var digits: [u8; 4] = [0 as u8; 4]
                var n: u64 = 0
                var x: u64 = t
                while x != 0 {
                    digits[n as usize] = (48 + x % 10) as u8
                    x = x / 10
                    n = n + 1
                }
                var k: u64 = 0
                while k < n {
                    kstate.set8(out + k, digits[(n - 1 - k) as usize])
                    k = k + 1
                }
                kstate.set8(out + n, 0 as u8)
                return PTS_BASE + t
            }
            want = want - 1
        }
        t = t + 1
    }
    return 0
}

// /dev/shm: ".", "..", then every named object
fn shm_readdir(state: u64, index: u64, out: u64) -> u64 {
    if index == 0 {
        kstate.set8(out, 46 as u8)
        kstate.set8(out + 1, 0 as u8)
        return D_SHM
    }
    if index == 1 {
        kstate.set8(out, 46 as u8)
        kstate.set8(out + 1, 46 as u8)
        kstate.set8(out + 2, 0 as u8)
        return D_SHM
    }
    var want: u64 = index - 2
    var i: u64 = 0
    while i < unixsock.USHM_PAGED {
        if shm_named(state, i) {
            if want == 0 {
                var k: u64 = 0
                while k + 1 < kstate.SHMN_SLOT && kstate.get8(shm_name_addr(state, i) + k) != 0 {
                    kstate.set8(out + k, kstate.get8(shm_name_addr(state, i) + k) as u8)
                    k = k + 1
                }
                kstate.set8(out + k, 0 as u8)
                return SHM_BASE + i
            }
            want = want - 1
        }
        i = i + 1
    }
    return 0
}

fn d_readdir(state: u64, m: u64, dir: u64, index: u64, out: u64) -> u64 {
    tick(state)
    if dir == D_PTS {
        return pts_readdir(state, index, out)
    }
    if dir == D_SHM {
        return shm_readdir(state, index, out)
    }
    if dir != D_ROOT {
        return 0
    }
    var dot: [u8; 2] = ".\0"
    var dotdot: [u8; 3] = "..\0"
    if index == 0 {
        kstate.set8(out, 46 as u8)
        kstate.set8(out + 1, 0 as u8)
        return D_ROOT
    }
    if index == 1 {
        kstate.set8(out, 46 as u8)
        kstate.set8(out + 1, 46 as u8)
        kstate.set8(out + 2, 0 as u8)
        return D_ROOT
    }
    let node: u64 = index - 1
    if node >= D_WLOCK {
        return 0
    }
    if !da(state, node) {
        return 0
    }
    if !name_at(node, out) {
        return 0
    }
    return node
}

fn d_attr(state: u64, m: u64, node: u64, what: u64) -> u64 {
    tick(state)
    if what == vfsops.A_TYPE {
        if node == D_ROOT || node == D_PTS || node == D_SHM {
            return vfsops.N_DIR
        }
        if shm_slot(node) < unixsock.USHM_PAGED {
            return vfsops.N_FILE
        }
        if pts_slot(node) < tty.MAX_TTY {
            return vfsops.N_CHR
        }
        if is_block(node) {
            return vfsops.N_BLK
        }
        if node >= 1 && node <= D_LAST {
            return vfsops.N_CHR
        }
        return vfsops.N_NONE
    }
    if what == vfsops.A_SIZE {
        // EIN BLOCKGERAET HAT EINE GROESSE, und sie ist keine
        // Erfindung: sie ist die Zahl der Bloecke mal 512. Ein
        // `lseek(fd, 0, SEEK_END)` auf /dev/hdb sagt damit, wie gross
        // die Platte ist -- und `tools/k14/run.sh` haelt die Zahl gegen
        // die Groesse der Abbilddatei auf dem Wirt.
        if is_block(node) {
            return blk.blocks_on(state, block_of(node)) * BS
        }
        if shm_slot(node) < unixsock.USHM_PAGED {
            return unixsock.shm_size(state, shm_slot(node))
        }
        return 0
    }
    if what == vfsops.A_MODE {
        if node == D_SHM {
            return 1023 // 0o1777
        }
        if node == D_ODB || node == D_WLOCK || node == D_DRVCTL || node == D_TPM0 {
            return 384 // 0o600: root only
        }
        if node == D_BTCTL {
            return 438
        }
        if node == D_ROOT || node == D_PTS {
            return 493 // 0o755
        }
        if shm_slot(node) < unixsock.USHM_PAGED {
            return 438 // 0o666
        }
        if node == D_NULL || node == D_ZERO || node == D_TTY
            || node == D_CONSOLE || node == D_PTMX || pts_slot(node) < tty.MAX_TTY {
            return 438 // 0o666
        }
        return 420 // 0o644
    }
    if what == vfsops.A_NLINK {
        return 1
    }
    if what == vfsops.A_RDEV {
        if node == D_ROOT {
            return 0
        }
        return rdev_of(node)
    }
    if what == vfsops.A_BLKSIZE {
        return BS
    }
    return 0
}

static mut odb_ovr_seen: u64 = 0
static mut q_odb: [u8; 4] = "odb\0"
static mut l_odb_ovr: [u8; 30] = "uart receiver overruns (hex) \0"

// One klog line each time the overrun count passes a power of two (odbc logs shows it): a flood stays at ~log2(n) lines.
fn odb_note_overruns(state: u64) {
    let n: u64 = odbuart.overruns()
    if n != odb_ovr_seen {
        odb_ovr_seen = n
        if (n & (n - 1)) == 0 {
            klog.sayh(state, klog.L_WARN, (&q_odb[0 as usize]) as u64, (&l_odb_ovr[0 as usize]) as u64, n)
        }
    }
}

fn d_read(state: u64, m: u64, node: u64, off: u64, dst: u64,
    len: u64) -> u64 {
    tick(state)
    if node == D_NULL {
        return 0
    }
    if node == D_ZERO {
        var i: u64 = 0
        while i < len {
            kstate.set8(dst + i, 0 as u8)
            i = i + 1
        }
        return len
    }
    if node == D_RANDOM || node == D_URANDOM {
        let _w: bool = randwait.wait_ready(state, false)
        return rand.bytes(state, dst, len)
    }
    if node == D_KLOG {
        return klog_read(state, off, dst, len)
    }
    if node == D_ODB {
        let got: u64 = odbuart.read_into(dst, len)
        odb_note_overruns(state)
        return got
    }
    if node == D_WLOCK {
        return wlock_read(off, dst, len)
    }
    if node == D_DRVCTL {
        return drvctl_read(off, dst, len)
    }
    if node == D_BTCTL {
        return btctl_read(state, off, dst, len)
    }
    if node == D_TPM0 {
        return tpmdev.read_into(off, dst, len)
    }
    if is_block(node) {
        return block_read(state, block_of(node), off, dst, len)
    }
    return 0
}

fn wlock_read(off: u64, dst: u64, len: u64) -> u64 {
    var b: [u8; 96] = [0 as u8; 96]
    let p: u64 = (&b[0 as usize]) as u64
    let n: u64 = wlock.status(p)
    if off >= n {
        return 0
    }
    var c: u64 = n - off
    if c > len {
        c = len
    }
    var i: u64 = 0
    while i < c {
        kstate.set8(dst + i, kstate.get8(p + off + i) as u8)
        i = i + 1
    }
    return c
}

fn drvctl_read(off: u64, dst: u64, len: u64) -> u64 {
    var b: [u8; 96] = [0 as u8; 96]
    let p: u64 = (&b[0 as usize]) as u64
    let n: u64 = drvctlnode.status(p)
    if off >= n {
        return 0
    }
    var c: u64 = n - off
    if c > len {
        c = len
    }
    var i: u64 = 0
    while i < c {
        kstate.set8(dst + i, kstate.get8(p + off + i) as u8)
        i = i + 1
    }
    return c
}

fn btctl_read(state: u64, off: u64, dst: u64, len: u64) -> u64 {
    let n: u64 = procbt.status(state)
    let p: u64 = procbt.status_ptr()
    if off >= n {
        return 0
    }
    var c: u64 = n - off
    if c > len {
        c = len
    }
    var i: u64 = 0
    while i < c {
        kstate.set8(dst + i, kstate.get8(p + off + i) as u8)
        i = i + 1
    }
    return c
}

fn btctl_write(state: u64, src: u64, len: u64) -> u64 {
    var b: [u8; 48] = [0 as u8; 48]
    let p: u64 = (&b[0 as usize]) as u64
    var n: u64 = len
    if n > 47 {
        n = 47
    }
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    if procbt.command(state, p, n) {
        return len
    }
    return 0
}

fn drvctl_write(state: u64, src: u64, len: u64) -> u64 {
    var b: [u8; 48] = [0 as u8; 48]
    let p: u64 = (&b[0 as usize]) as u64
    var n: u64 = len
    if n > 47 {
        n = 47
    }
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    if drvctlnode.command(state, p, n) {
        return len
    }
    return 0
}

fn wlock_write(src: u64, len: u64) -> u64 {
    var b: [u8; 48] = [0 as u8; 48]
    let p: u64 = (&b[0 as usize]) as u64
    var n: u64 = len
    if n > 47 {
        n = 47
    }
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    if wlock.command(p, n) {
        return len
    }
    return 0
}

// RUNDE PROTOKOLL: den Ring als Oktettstrom.
//
// Zeile fuer Zeile bauen, Laengen zaehlen, ab `off` kopieren. Der
// Zwischenpuffer ist EINER fuer alle Kerne -- deshalb unter derselben
// Sperre wie der Rest dieses Dateisystems (`enter`/`leave`).
fn klog_read(state: u64, off: u64, dst: u64, len: u64) -> u64 {
    let flags: u64 = enter(state)
    var b: [u8; 256] = [0 as u8; 256]
    let p: u64 = (&b[0 as usize]) as u64
    var pos: u64 = 0
    var n: u64 = 0
    var s: u64 = klog.first_seq(state)
    let last: u64 = klog.seq(state)
    while s <= last && n < len {
        let m2: u64 = klog.line_at(state, s, p, 255)
        if m2 != 0 {
            if pos + m2 > off {
                var i: u64 = 0
                if off > pos {
                    i = off - pos
                }
                while i < m2 && n < len {
                    kstate.set8(dst + n, kstate.get8(p + i) as u8)
                    n = n + 1
                    i = i + 1
                }
            }
            pos = pos + m2
        }
        s = s + 1
    }
    leave(state, flags)
    return n
}

// Und die Gegenrichtung: was hineingeschrieben wird, wird EINE Zeile im
// Protokoll, Stufe info, Quelle `prog`. Ein Zeilenende beendet die
// Zeile; laengere Texte werden auf die 88 Oktette eines Eintrags
// gekuerzt (`klog.fi`).
fn klog_write(state: u64, src: u64, len: u64) -> u64 {
    var t: [u8; 96] = [0 as u8; 96]
    var q: [u8; 5] = "prog\0"
    var i: u64 = 0
    while i < len && i < 95 {
        let c: u64 = kstate.get8(src + i)
        if c == 10 {
            break
        }
        t[i as usize] = (c & 0xFF) as u8
        i = i + 1
    }
    t[i as usize] = 0 as u8
    klog.say(state, klog.L_INFO, (&q[0 as usize]) as u64,
        (&t[0 as usize]) as u64)
    return len
}

fn d_write(state: u64, m: u64, node: u64, off: u64, src: u64,
    len: u64) -> u64 {
    tick(state)
    if node == D_KLOG {
        return klog_write(state, src, len)
    }
    if node == D_ODB {
        return odbuart.write_from(src, len)
    }
    if node == D_NULL || node == D_ZERO {
        return len // geschluckt, und das ist die Zusage
    }
    if node == D_RANDOM || node == D_URANDOM {
        rand.mix(state, src, len)
        return len
    }
    if node == D_WLOCK {
        return wlock_write(src, len)
    }
    if node == D_DRVCTL {
        return drvctl_write(state, src, len)
    }
    if node == D_BTCTL {
        return btctl_write(state, src, len)
    }
    if node == D_TPM0 {
        return tpmdev.command(state, src, len)
    }
    if is_block(node) {
        return block_write(state, block_of(node), off, src, len)
    }
    return 0
}

// EIN BLOCKGERAET OKTETTWEISE. Die Platte kann nur ganze Bloecke; ein
// `read` von 100 Oktetten ab Stelle 700 liest also Block 1 und gibt
// die Oktette 188..287 daraus heraus. Genau das macht jedes Unix, und
// genau das macht `dd` moeglich.
// DIE SPERRE DER PLATTE. `atomic.L_FS` schuetzt in `fs.fi` die
// Arbeitsbloecke des Dateisystems -- und darunter die ATA-Register, die
// `blk.fi` benutzt und die keine eigene haben. Ein `dd if=/dev/hda`
// auf einem zweiten Kern wuerde einem OFS mitten im Sektor die Tore
// umschreiben. Der Zwischenpuffer hier ist der zweite Grund: er ist
// EINER fuer alle Kerne.
fn enter(state: u64) -> u64 {
    let flags: u64 = sched.irq_save()
    let me: u64 = cpu.here(state)
    if atomic.lock_owner(state, atomic.L_FS) == me + 1 {
        return flags | 0x8000000000000000
    }
    atomic.lock_take(state, atomic.L_FS, me)
    return flags
}

fn leave(state: u64, flags: u64) {
    if (flags & 0x8000000000000000) == 0 {
        atomic.lock_give(state, atomic.L_FS)
    }
    sched.irq_restore(flags & 0x7FFFFFFFFFFFFFFF)
}

fn block_read(state: u64, dev: u64, off: u64, dst: u64, len: u64) -> u64 {
    let f: u64 = enter(state)
    let r: u64 = block_read_inner(state, dev, off, dst, len)
    leave(state, f)
    return r
}

fn block_write(state: u64, dev: u64, off: u64, src: u64, len: u64) -> u64 {
    let f: u64 = enter(state)
    let r: u64 = block_write_inner(state, dev, off, src, len)
    leave(state, f)
    return r
}

fn block_read_inner(state: u64, dev: u64, off: u64, dst: u64,
    len: u64) -> u64 {
    let scratch: u64 = state + kstate.K14_OFF + 0x740 + 0x40
    let total: u64 = blk.blocks_on(state, dev) * BS
    if off >= total {
        return 0
    }
    var want: u64 = len
    if off + want > total {
        want = total - off
    }
    var done: u64 = 0
    while done < want {
        let pos: u64 = off + done
        let lba: u64 = pos / BS
        let inb: u64 = pos % BS
        var chunk: u64 = BS - inb
        if chunk > want - done {
            chunk = want - done
        }
        if !blk.read_on(state, dev, lba, scratch) {
            return done
        }
        var i: u64 = 0
        while i < chunk {
            kstate.set8(dst + done + i, kstate.get8(scratch + inb + i) as u8)
            i = i + 1
        }
        done = done + chunk
    }
    return done
}

fn block_write_inner(state: u64, dev: u64, off: u64, src: u64,
    len: u64) -> u64 {
    let scratch: u64 = state + kstate.K14_OFF + 0x740 + 0x40
    let total: u64 = blk.blocks_on(state, dev) * BS
    if off >= total {
        return 0
    }
    var want: u64 = len
    if off + want > total {
        want = total - off
    }
    var done: u64 = 0
    while done < want {
        let pos: u64 = off + done
        let lba: u64 = pos / BS
        let inb: u64 = pos % BS
        var chunk: u64 = BS - inb
        if chunk > want - done {
            chunk = want - done
        }
        // Ein Teilblock muss GELESEN werden, bevor er geschrieben wird
        // -- sonst nimmt ein `write` von einem Oktett die anderen 511
        // mit. Das ist der Fehler, den jeder Blocktreiber einmal macht.
        if chunk != BS {
            if !blk.read_on(state, dev, lba, scratch) {
                return done
            }
        }
        var i: u64 = 0
        while i < chunk {
            kstate.set8(scratch + inb + i, kstate.get8(src + done + i) as u8)
            i = i + 1
        }
        if !blk.write_on(state, dev, lba, scratch) {
            return done
        }
        done = done + chunk
    }
    return done
}

// Only regular files below /dev/shm can be created: shm_open() = open(O_CREAT) + ftruncate + mmap.
fn d_create(state: u64, m: u64, path: u64, art: u64) -> u64 {
    tick(state)
    if art != vfsops.N_FILE {
        return 0
    }
    let nm: u64 = shm_rest(path)
    if nm == 0 || kstate.get8(nm) == 0 {
        return 0
    }
    var n: u64 = 0
    while kstate.get8(nm + n) != 0 {
        if kstate.get8(nm + n) == 47 {
            return 0
        }
        n = n + 1
    }
    if n + 1 >= kstate.SHMN_SLOT {
        return 0
    }
    let i: u64 = unixsock.shm_new(state)
    if i >= unixsock.USHM_PAGED {
        return 0
    }
    var k: u64 = 0
    while k < n {
        kstate.set8(shm_name_addr(state, i) + k, kstate.get8(nm + k) as u8)
        k = k + 1
    }
    kstate.set8(shm_name_addr(state, i) + n, 0 as u8)
    return SHM_BASE + i
}

// unlink("/dev/shm/NAME"): the name goes, the object lives on until the last descriptor/mapping lets go.
fn d_unlink(state: u64, m: u64, path: u64) -> u64 {
    tick(state)
    let nm: u64 = shm_rest(path)
    if nm == 0 {
        return 1 // EPERM
    }
    let i: u64 = shm_find(state, nm)
    if i >= unixsock.USHM_PAGED {
        return 2 // ENOENT
    }
    kstate.set8(shm_name_addr(state, i), 0 as u8)
    unixsock.shm_unref(state, i)
    return 0
}

fn d_rename(state: u64, m: u64, from: u64, to: u64) -> u64 {
    tick(state)
    return 1 // EPERM
}

fn d_trunc(state: u64, m: u64, node: u64) -> u64 {
    tick(state)
    return 0 // ein Geraet hat keine Laenge, die man kuerzen koennte
}

// Die Tafel. `mask` sagt, was es WIRKLICH kann: nachschlagen,
// auflisten, Attribute, lesen, schreiben, kuerzen. Anlegen, loeschen
// und umbenennen stehen NICHT darin -- `vfs.fi` faengt sie ab, bevor
// der Zeiger benutzt wird, und die drei Funktionen oben sind das
// Fangnetz darunter.
fn ops() -> vfsops.Ops {
    return vfsops.Ops {
        lookup: d_lookup,
        readdir: d_readdir,
        attr: d_attr,
        read: d_read,
        write: d_write,
        create: d_create,
        unlink: d_unlink,
        rename: d_rename,
        trunc: d_trunc,
        mask: 383, // LOOKUP|READDIR|ATTR|READ|WRITE|CREATE|UNLINK|TRUNC (create/unlink only below shm/)
        tag: 7759204 // "dev\0"
    }
}
