profile kernel

import klog
import diag.cmdopt

export { id32, blocks512, check, bad_count }

const ID_MAX: u64 = 4294967295
const ID_OVERFLOW: u64 = 65534
const SIZE_SUSPECT: u64 = 1099511627776

static mut q_stat: [u8; 5] = "stat\0"
static mut n_bad: u64 = 0
static mut w_off: [u8; 11] = "nostatsane\0"
static mut st_mode: u64 = 0

fn enabled(state: u64) -> bool {
    if st_mode == 0 {
        st_mode = 1
        if cmdopt.has(state, (&w_off[0]) as u64) {
            st_mode = 2
        }
    }
    return st_mode == 1
}

fn id32(state: u64, v: u64) -> u64 {
    if v > ID_MAX && enabled(state) {
        return ID_OVERFLOW
    }
    return v
}

fn blocks512(state: u64, size: u64) -> u64 {
    if !enabled(state) {
        return (size + 511) / 512
    }
    var b: u64 = size / 512
    if (size % 512) != 0 {
        b = b + 1
    }
    return b
}

fn bad_count() -> u64 {
    return n_bad
}

fn check(state: u64, ino: u64, uid: u64, gid: u64, size: u64) {
    var l_uid: [u8; 23] = "inode, raw uid (bad): \0"
    var l_gid: [u8; 23] = "inode, raw gid (bad): \0"
    var l_size: [u8; 24] = "inode, raw size (bad): \0"
    var bad: bool = false
    if uid > ID_MAX {
        klog.say2(state, klog.L_WARN, (&q_stat[0]) as u64, (&l_uid[0]) as u64, ino, uid)
        bad = true
    }
    if gid > ID_MAX {
        klog.say2(state, klog.L_WARN, (&q_stat[0]) as u64, (&l_gid[0]) as u64, ino, gid)
        bad = true
    }
    if size >= SIZE_SUSPECT {
        klog.say2(state, klog.L_WARN, (&q_stat[0]) as u64, (&l_size[0]) as u64, ino, size)
        bad = true
    }
    if bad {
        n_bad = n_bad +% 1
    }
}
