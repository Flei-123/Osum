profile kernel

import lib.procw
import drv.hid.kbd

export { render }

static mut k_caps: [u8; 5] = "caps\0"
static mut k_num: [u8; 4] = "num\0"
static mut k_scroll: [u8; 7] = "scroll\0"

fn flag(bits: u64, mask: u64) -> u64 {
    if (bits & mask) != 0 {
        return 1
    }
    return 0
}

fn render(state: u64, out: u64, cap: u64) -> u64 {
    procw.begin(out, cap)
    let bits: u64 = kbd.locks(state)
    procw.line_num((&k_caps[0]) as u64, flag(bits, kbd.LK_CAPS))
    procw.line_num((&k_num[0]) as u64, flag(bits, kbd.LK_NUM))
    procw.line_num((&k_scroll[0]) as u64, flag(bits, kbd.LK_SCROLL))
    return procw.used()
}
