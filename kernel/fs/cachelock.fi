profile kernel

import lib.kstate

export { take, give, field }

fn take(lock_at: u64) -> u64 {
    let flags: u64 = asm("pushfq\npop rax\ncli", out("rax"))
    let free: u64 = 0
    let held: u64 = 1
    var old: u64 = __atomic_swap(lock_at as *mut u64, free, held)
    while old != free {
        asm("pause")
        old = __atomic_swap(lock_at as *mut u64, free, held)
    }
    return flags
}

fn give(lock_at: u64, flags: u64) {
    kstate.set(lock_at, 0, 0)
    if (flags & 0x200) != 0 {
        asm("sti")
    }
}

fn field(state: u64, base_slot: u64, off: u64) -> u64 {
    let b: u64 = kstate.get(state, base_slot)
    if b == 0 {
        return 0
    }
    return kstate.get(b, off)
}
