
profile kernel

import lib.kstate
import serial
import fs.mnt
import fs.dcache
import fs.pcache
import mm.mmframe
import diag.cmdopt
import fs.vfsops
import fs.ofs
import fs.fsctx
import fs.fsreg
import fs.fat
import fs.ext4
import fs.ext4w
import fs.ntfs
import fs.exfat
import lib.errno

export {
    init, ready, mount_root, mount_at, umount_path, umount_index,
    mount_for, node_for, node_for_nofollow, resolve, ops_of,
    v_readdir, v_attr, v_read, v_write, v_create, v_unlink, v_rename,
    v_trunc, can, rdonly, root_node, type_of, all_mode,
    MAX_MNT, cache_words, cache_shrink, caches_up, page_cached
}

const MAX_MNT: u64 = 8
const READ_BYPASS: u64 = 65536
const PCACHE_LOW_FRAMES: u64 = 4096
const PCACHE_SHRINK_BATCH: u64 = 64

fn ops_of(t: u64) -> vfsops.Ops {
    if t == vfsops.FS_PROC && fsreg.proc_installed() {
        return fsreg.proc_ops()
    }
    if t == vfsops.FS_DEV && fsreg.dev_installed() {
        return fsreg.dev_ops()
    }
    if t == vfsops.FS_FAT {
        return fat.ops()
    }
    if t == vfsops.FS_EXT4 {
        return ext4w.ops()
    }
    if t == vfsops.FS_NTFS {
        return ntfs.ops()
    }
    if t == vfsops.FS_EXFAT {
        return exfat.ops()
    }
    return ofs.ops()
}

fn ready(state: u64) -> bool {
    return kstate.get(state, kstate.VFS_READY) != 0
}

fn all_mode(state: u64) -> bool {
    return kstate.mode_on(state, kstate.M_VFSALL)
}

fn init(state: u64) {
    mnt.init(state)
    kstate.set(state, kstate.VFS_READY, 1)
    kstate.set(state, kstate.VFS_LOOKUPS, 0)
    kstate.set(state, kstate.VFS_CROSSINGS, 0)
    kstate.set(state, kstate.VFS_OPS, 0)
    kstate.set(state, kstate.VFS_INDIRECT, 0)
    cache_words(state)
}

fn cache_words(state: u64) {
    var w_nd: [u8; 9] = "nodcache\0"
    var w_np: [u8; 9] = "nopcache\0"
    var w_di: [u8; 10] = "dcnoinval\0"
    var w_pi: [u8; 10] = "pcnoinval\0"
    if cmdopt.has(state, (&w_nd[0]) as u64) {
        kstate.mode_add(state, kstate.M_NODCACHE)
    }
    if cmdopt.has(state, (&w_np[0]) as u64) {
        kstate.mode_add(state, kstate.M_NOPCACHE)
    }
    if cmdopt.has(state, (&w_di[0]) as u64) {
        kstate.mode_add(state, kstate.M_DCNOINVAL)
    }
    if cmdopt.has(state, (&w_pi[0]) as u64) {
        kstate.mode_add(state, kstate.M_PCNOINVAL)
    }
}

fn region_up(state: u64, base_slot: u64, tried_slot: u64, frames: u64) -> u64 {
    let b: u64 = kstate.get(state, base_slot)
    if b != 0 {
        return b
    }
    if kstate.get(state, kstate.BITMAP) == 0 || kstate.add(state, tried_slot, 1) != 1 {
        return 0
    }
    return mmframe.frame_run(state, frames)
}

fn caches_up(state: u64) {
    if kstate.get(state, kstate.DCACHE_BASE) == 0 {
        let r: u64 = region_up(state, kstate.DCACHE_BASE, kstate.DCACHE_TRIED, dcache.FRAMES)
        if r != 0 {
            dcache.attach(state, r)
        }
    }
    if kstate.get(state, kstate.PCACHE_BASE) == 0 {
        pcache_up(state)
    }
}

fn pcache_up(state: u64) {
    if kstate.get(state, kstate.BITMAP) == 0 || kstate.add(state, kstate.PCACHE_TRIED, 1) != 1 {
        return
    }
    var sets: u64 = pcache.sets_for(mmframe.frames_total(state))
    while sets >= pcache.MIN_SETS {
        let r: u64 = mmframe.frame_run(state, pcache.region_frames(sets))
        if r != 0 {
            pcache.attach(state, r, sets)
            return
        }
        sets = sets / 2
    }
}

fn cache_shrink(state: u64, pages: u64) -> u64 {
    var freed: u64 = 0
    while freed < pages {
        let f: u64 = pcache.take_frame(state)
        if f == 0 {
            return freed
        }
        mmframe.frame_free(state, f)
        freed = freed + 1
    }
    return freed
}

fn page_for_fill(state: u64, m: u64, node: u64, idx: u64) -> u64 {
    if mmframe.frames_free(state) < PCACHE_LOW_FRAMES {
        cache_shrink(state, PCACHE_SHRINK_BATCH)
        if mmframe.frames_free(state) < PCACHE_LOW_FRAMES {
            return 0
        }
    }
    let slot: u64 = pcache.begin_fill(state, m, node, idx)
    if slot == 0 {
        return 0
    }
    if pcache.buffer_of(slot) == 0 {
        let f: u64 = mmframe.frame_alloc(state)
        if f == 0 {
            pcache.abort_fill(state, slot)
            return 0
        }
        pcache.attach_frame(state, slot, f)
    }
    return slot
}

fn page_cached(state: u64, m: u64) -> bool {
    if !can(state, m, vfsops.OP_READ) || !cacheable(mnt.fstype(state, m)) {
        return false
    }
    caches_up(state)
    return kstate.get(state, kstate.PCACHE_BASE) != 0
}

fn cacheable(t: u64) -> bool {
    return t == vfsops.FS_OFS || t == vfsops.FS_FAT || t == vfsops.FS_EXT4
        || t == vfsops.FS_NTFS || t == vfsops.FS_EXFAT
}

fn lookup_cached(state: u64, m: u64, rest: u64) -> u64 {
    let t: u64 = mnt.fstype(state, m)
    let o: vfsops.Ops = ops_of(t)
    if !cacheable(t) {
        return o.lookup(state, m, rest)
    }
    caches_up(state)
    let hit: u64 = dcache.probe(state, m, rest)
    if hit == dcache.NEG {
        return 0
    }
    if hit != dcache.MISS {
        return hit
    }
    let st: u64 = dcache.stamp(state)
    let r: u64 = o.lookup(state, m, rest)
    if r != 0 || t != vfsops.FS_OFS || kstate.get(state, kstate.FS_READY) != 0 {
        dcache.insert(state, m, rest, r, st)
    }
    return r
}

fn namespace_changed(state: u64) {
    dcache.bump(state)
}

fn type_of(state: u64, m: u64) -> u64 {
    return mnt.fstype(state, m)
}

fn root_node(state: u64, m: u64) -> u64 {
    return mnt.root(state, m)
}

fn rdonly(state: u64, m: u64) -> bool {
    if m >= MAX_MNT || !mnt.used(state, m) {
        return false
    }
    return (mnt.flags(state, m) & mnt.F_RDONLY) != 0
}

fn can(state: u64, m: u64, bit: u64) -> bool {
    if m >= MAX_MNT || !mnt.used(state, m) {
        return false
    }
    let o: vfsops.Ops = ops_of(mnt.fstype(state, m))
    if (o.mask & bit) == 0 {
        return false
    }
    if (mnt.flags(state, m) & mnt.F_RDONLY) != 0 {
        let schreibend: u64 = vfsops.OP_WRITE | vfsops.OP_CREATE
            | vfsops.OP_UNLINK | vfsops.OP_RENAME | vfsops.OP_TRUNC
        if (bit & schreibend) != 0 {
            return false
        }
    }
    return true
}

fn mount_for(state: u64, path: u64) -> u64 {
    var best: u64 = MAX_MNT
    var best_len: u64 = 0
    var m: u64 = 0
    while m < MAX_MNT {
        if mnt.used(state, m) {
            let used: u64 = mnt.path_eq_prefix(state, m, path)
            if used != 0 {
                if best == MAX_MNT || used > best_len {
                    best = m
                    best_len = used
                }
            }
        }
        m = m + 1
    }
    kstate.add(state, kstate.VFS_LOOKUPS, 1)
    if best != MAX_MNT && best != 0 {
        kstate.add(state, kstate.VFS_CROSSINGS, 1)
    }
    return best
}

fn rest_of(state: u64, m: u64, path: u64, slash: u64) -> u64 {
    let used: u64 = mnt.path_eq_prefix(state, m, path)
    if used == 0 {
        return 0
    }
    if mnt.path_len(state, m) == 1 {
        return path
    }
    let rest: u64 = path + used
    if kstate.get8(rest) == 0 {
        return slash
    }
    return rest
}

fn node_for(state: u64, m: u64, path: u64) -> u64 {
    var slash: [u8; 2] = "/\0"
    if m >= MAX_MNT || !mnt.used(state, m) {
        return 0
    }
    let rest: u64 = rest_of(state, m, path, (&slash[0]) as u64)
    if rest == 0 {
        return 0
    }
    if !can(state, m, vfsops.OP_LOOKUP) {
        return 0
    }
    kstate.add(state, kstate.VFS_OPS, 1)
    return lookup_cached(state, m, rest)
}

fn node_for_nofollow(state: u64, m: u64, path: u64) -> u64 {
    if m >= MAX_MNT || !mnt.used(state, m) || mnt.fstype(state, m) != vfsops.FS_OFS {
        return node_for(state, m, path)
    }
    var slash: [u8; 2] = "/\0"
    let rest: u64 = rest_of(state, m, path, (&slash[0]) as u64)
    if rest == 0 || !can(state, m, vfsops.OP_LOOKUP) {
        return 0
    }
    kstate.add(state, kstate.VFS_OPS, 1)
    return ofs.lookup_nofollow(state, m, rest)
}

fn resolve(state: u64, path: u64) -> u64 {
    let m: u64 = mount_for(state, path)
    if m >= MAX_MNT {
        return 0
    }
    return node_for(state, m, path)
}

fn v_readdir(state: u64, m: u64, dir: u64, index: u64, out: u64) -> u64 {
    if !can(state, m, vfsops.OP_READDIR) {
        return 0
    }
    kstate.add(state, kstate.VFS_OPS, 1)
    let o: vfsops.Ops = ops_of(mnt.fstype(state, m))
    return o.readdir(state, m, dir, index, out)
}

fn v_attr(state: u64, m: u64, node: u64, what: u64) -> u64 {
    if !can(state, m, vfsops.OP_ATTR) {
        return 0
    }
    kstate.add(state, kstate.VFS_OPS, 1)
    let o: vfsops.Ops = ops_of(mnt.fstype(state, m))
    return o.attr(state, m, node, what)
}

fn v_read(state: u64, m: u64, node: u64, off: u64, dst: u64,
    len: u64) -> u64 {
    if !can(state, m, vfsops.OP_READ) {
        return 0
    }
    kstate.add(state, kstate.VFS_OPS, 1)
    let t: u64 = mnt.fstype(state, m)
    let o: vfsops.Ops = ops_of(t)
    if !cacheable(t) || len == 0 || len > READ_BYPASS {
        pcache.note_bypass(state)
        return o.read(state, m, node, off, dst, len)
    }
    return read_paged(state, o, m, node, off, dst, len)
}

fn read_paged(state: u64, o: vfsops.Ops, m: u64, node: u64, off: u64,
    dst: u64, len: u64) -> u64 {
    caches_up(state)
    var done: u64 = 0
    while done < len {
        let pos: u64 = off + done
        let idx: u64 = pos >> 12
        let from: u64 = pos & 4095
        var want: u64 = pcache.PAGE_BYTES - from
        if want > len - done {
            want = len - done
        }
        var got: u64 = pcache.read_hit(state, m, node, idx, from, want, dst + done)
        if got == pcache.MISS {
            let slot: u64 = page_for_fill(state, m, node, idx)
            if slot == 0 {
                let r: u64 = o.read(state, m, node, pos, dst + done, len - done)
                if done == 0 || r > len - done {
                    return r
                }
                return done + r
            }
            let buf: u64 = pcache.buffer_of(slot)
            let r: u64 = o.read(state, m, node, idx << 12, buf, pcache.PAGE_BYTES)
            if r > pcache.PAGE_BYTES {
                pcache.abort_fill(state, slot)
                if done == 0 {
                    return r
                }
                return done
            }
            pcache.finish_fill(state, slot, m, node, idx, r)
            got = 0
            if r > from {
                got = r - from
                if got > want {
                    got = want
                }
                pcache.copy_out(dst + done, buf + from, got)
            }
        }
        done = done + got
        if got < want {
            return done
        }
    }
    return done
}

fn v_write(state: u64, m: u64, node: u64, off: u64, src: u64,
    len: u64) -> u64 {
    if m >= MAX_MNT || !mnt.used(state, m) {
        return errno.neg(errno.E_BADF)
    }
    let o: vfsops.Ops = ops_of(mnt.fstype(state, m))
    if (o.mask & vfsops.OP_WRITE) == 0 {
        return errno.neg(errno.E_PERM)
    }
    if (mnt.flags(state, m) & mnt.F_RDONLY) != 0 {
        return errno.neg(errno.E_ROFS)
    }
    kstate.add(state, kstate.VFS_OPS, 1)
    let r: u64 = o.write(state, m, node, off, src, len)
    pcache.drop_node(state, m, node)
    return r
}

fn v_create(state: u64, m: u64, path: u64, art: u64) -> u64 {
    var slash: [u8; 2] = "/\0"
    if m >= MAX_MNT || !mnt.used(state, m) {
        return 0
    }
    let o: vfsops.Ops = ops_of(mnt.fstype(state, m))
    if (o.mask & vfsops.OP_CREATE) == 0 {
        return 0
    }
    if (mnt.flags(state, m) & mnt.F_RDONLY) != 0 {
        return 0
    }
    let rest: u64 = rest_of(state, m, path, (&slash[0]) as u64)
    if rest == 0 {
        return 0
    }
    kstate.add(state, kstate.VFS_OPS, 1)
    let r: u64 = o.create(state, m, rest, art)
    dcache.bump_add(state)
    return r
}

fn v_unlink(state: u64, m: u64, path: u64) -> u64 {
    var slash: [u8; 2] = "/\0"
    if m >= MAX_MNT || !mnt.used(state, m) {
        return errno.E_BADF
    }
    let o: vfsops.Ops = ops_of(mnt.fstype(state, m))
    if (o.mask & vfsops.OP_UNLINK) == 0 {
        return errno.E_PERM
    }
    if (mnt.flags(state, m) & mnt.F_RDONLY) != 0 {
        return errno.E_ROFS
    }
    let rest: u64 = rest_of(state, m, path, (&slash[0]) as u64)
    if rest == 0 {
        return errno.E_NOENT
    }
    kstate.add(state, kstate.VFS_OPS, 1)
    var gone: u64 = 0
    if cacheable(mnt.fstype(state, m)) {
        gone = lookup_cached(state, m, rest)
    }
    let r: u64 = o.unlink(state, m, rest)
    if mnt.fstype(state, m) != vfsops.FS_OFS {
        namespace_changed(state)
    }
    if gone != 0 {
        pcache.drop_node(state, m, gone)
    }
    return r
}

fn v_rename(state: u64, from_m: u64, from: u64, to_m: u64,
    to: u64) -> u64 {
    var slash: [u8; 2] = "/\0"
    if from_m != to_m {
        return errno.E_XDEV
    }
    let m: u64 = from_m
    if m >= MAX_MNT || !mnt.used(state, m) {
        return errno.E_BADF
    }
    let o: vfsops.Ops = ops_of(mnt.fstype(state, m))
    if (o.mask & vfsops.OP_RENAME) == 0 {
        return errno.E_PERM
    }
    if (mnt.flags(state, m) & mnt.F_RDONLY) != 0 {
        return errno.E_ROFS
    }
    let a: u64 = rest_of(state, m, from, (&slash[0]) as u64)
    let b: u64 = rest_of(state, m, to, (&slash[0]) as u64)
    if a == 0 || b == 0 {
        return errno.E_NOENT
    }
    kstate.add(state, kstate.VFS_OPS, 1)
    var over: u64 = 0
    if cacheable(mnt.fstype(state, m)) {
        over = lookup_cached(state, m, b)
    }
    let r: u64 = o.rename(state, m, a, b)
    namespace_changed(state)
    if over != 0 {
        pcache.drop_node(state, m, over)
    }
    return r
}

fn v_trunc(state: u64, m: u64, node: u64) -> u64 {
    if m >= MAX_MNT || !mnt.used(state, m) {
        return errno.E_BADF
    }
    let o: vfsops.Ops = ops_of(mnt.fstype(state, m))
    if (o.mask & vfsops.OP_TRUNC) == 0 {
        return errno.E_PERM
    }
    if (mnt.flags(state, m) & mnt.F_RDONLY) != 0 {
        return errno.E_ROFS
    }
    kstate.add(state, kstate.VFS_OPS, 1)
    let r: u64 = o.trunc(state, m, node)
    pcache.drop_node(state, m, node)
    return r
}

fn mount_root(state: u64) -> bool {
    var slash: [u8; 2] = "/\0"
    if !ready(state) {
        init(state)
    }
    if mnt.used(state, 0) {
        return true
    }
    let m: u64 = mnt.alloc(state, true)
    if m >= MAX_MNT {
        return false
    }
    mnt.set(state, m, mnt.M_TYPE, vfsops.FS_OFS)
    mnt.set(state, m, mnt.M_DEV, kstate.get(state, kstate.DISK_DEV))
    mnt.set(state, m, mnt.M_FIRST, 0)
    mnt.set(state, m, mnt.M_BLOCKS, kstate.get(state, kstate.DISK_BLOCKS))
    mnt.set(state, m, mnt.M_FLAGS, 0)
    mnt.set_path(state, m, (&slash[0]) as u64)
    mnt.set_root(state, m, ofs.node_root(state))
    namespace_changed(state)
    return true
}

fn mount_at(state: u64, fstype: u64, dev: u64, first: u64, blocks: u64,
    path: u64, flags: u64) -> u64 {
    if !ready(state) {
        return MAX_MNT
    }
    let over: u64 = mount_for(state, path)
    if over >= MAX_MNT {
        return MAX_MNT
    }
    let node: u64 = node_for(state, over, path)
    if node == 0 {
        return MAX_MNT
    }
    if v_attr(state, over, node, vfsops.A_TYPE) != vfsops.N_DIR {
        return MAX_MNT
    }
    var k: u64 = 0
    while k < MAX_MNT {
        if mnt.used(state, k) && mnt.path_is(state, k, path) {
            return MAX_MNT
        }
        k = k + 1
    }
    let m: u64 = mnt.alloc(state, false)
    if m >= MAX_MNT {
        return MAX_MNT
    }
    mnt.set(state, m, mnt.M_TYPE, fstype)
    mnt.set(state, m, mnt.M_DEV, dev)
    mnt.set(state, m, mnt.M_FIRST, first)
    mnt.set(state, m, mnt.M_BLOCKS, blocks)
    mnt.set(state, m, mnt.M_FLAGS, flags)
    if !mnt.set_path(state, m, path) {
        mnt.free(state, m)
        return MAX_MNT
    }
    var r: u64 = 0
    if fstype == vfsops.FS_PROC {
        r = fsreg.proc_node_root(state)
        if dev == 1 {
            r = fsreg.proc_sfs_root(state)
        }
    } else if fstype == vfsops.FS_DEV {
        r = fsreg.dev_node_root(state)
    } else if fstype == vfsops.FS_FAT {
        r = fat.mount_probe(state, m)
    } else if fstype == vfsops.FS_EXT4 {
        r = ext4.mount_probe(state, m)
    } else if fstype == vfsops.FS_NTFS {
        r = ntfs.mount_probe(state, m)
    } else if fstype == vfsops.FS_EXFAT {
        r = exfat.mount_probe(state, m)
    } else {
        r = ofs.mount_probe(state, m)
    }
    if r == 0 {
        mnt.free(state, m)
        return MAX_MNT
    }
    mnt.set_root(state, m, r)
    pcache.drop_mount(state, m)
    namespace_changed(state)
    return m
}

fn umount_index(state: u64, m: u64) -> u64 {
    if m >= MAX_MNT || !mnt.used(state, m) {
        return errno.E_INVAL
    }
    if mnt.opens(state, m) != 0 {
        return errno.E_BUSY
    }
    var k: u64 = 0
    while k < MAX_MNT {
        if k != m && mnt.used(state, k) {
            if mnt.path_eq_prefix(state, m, mnt.path_at(state, k)) != 0 {
                return errno.E_BUSY
            }
        }
        k = k + 1
    }
    if m == 0 {
        return 0
    }
    if mnt.fstype(state, m) == vfsops.FS_OFS {
        fsctx.forget(state, m)
    }
    if mnt.fstype(state, m) == vfsops.FS_EXT4 {
        ext4w.unmount(state, m)
        ext4.release(state, m)
    }
    if mnt.fstype(state, m) == vfsops.FS_NTFS {
        ntfs.release(state, m)
    }
    if mnt.fstype(state, m) == vfsops.FS_EXFAT {
        exfat.sync(state, m)
        exfat.release(state, m)
    }
    if mnt.fstype(state, m) == vfsops.FS_FAT {
        fat.sync(state, m)
        fat.release(state, m)
    }
    mnt.free(state, m)
    pcache.drop_mount(state, m)
    namespace_changed(state)
    return 0
}

fn umount_path(state: u64, path: u64) -> u64 {
    var k: u64 = 0
    while k < MAX_MNT {
        if mnt.path_is(state, k, path) {
            return umount_index(state, k)
        }
        k = k + 1
    }
    return errno.E_INVAL
}
