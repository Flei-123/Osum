
profile kernel

import lib.kstate
import sched.time

export {
    init, arm, armed, arm_pid, drop, may_inject, note,
    active, eingespeist, denied, deny, arms, last_pid, gebaut,
    locked, lock, unlock, recent, is_locked, mark, injected_within,
    TIPP_NS, MAX_ANSCHLAEGE
}

fn gebaut() -> bool {
    return true
}

const TIPP_NS: u64 = 120000000000

const MAX_ANSCHLAEGE: u64 = 200

const S_ARMED: u64 = 0x00
const S_APID: u64 = 0x08
const S_DEADLINE: u64 = 0x10
const S_USED: u64 = 0x18
const S_TOTAL: u64 = 0x20
const S_DENIED: u64 = 0x28
const S_ARMS: u64 = 0x30
const S_LASTPID: u64 = 0x38
const S_LAST: u64 = 0x40
const S_LOCK: u64 = 0x48
const S_GUARD: u64 = 0x50

const SHOW_NS: u64 = 6000000000

fn gs(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.TIPP_OFF + off)
}

fn ss(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.TIPP_OFF + off, v)
}

fn init(state: u64) {
    ss(state, S_ARMED, 0)
    ss(state, S_APID, 0)
    ss(state, S_DEADLINE, 0)
    ss(state, S_USED, 0)
    ss(state, S_TOTAL, 0)
    ss(state, S_DENIED, 0)
    ss(state, S_ARMS, 0)
    ss(state, S_LASTPID, 0)
    ss(state, S_LAST, 0)
    ss(state, S_LOCK, 0)
    ss(state, S_GUARD, 0)
}

fn arm(state: u64, pid: u64) {
    ss(state, S_ARMED, 1)
    ss(state, S_APID, pid)
    ss(state, S_DEADLINE, time.mono_ns(state) +% TIPP_NS)
    ss(state, S_USED, 0)
    ss(state, S_LASTPID, pid)
    ss(state, S_LAST, time.mono_ns(state))
    kstate.add(state, kstate.TIPP_OFF + S_ARMS, 1)
}

fn armed(state: u64) -> bool {
    if gs(state, S_LOCK) != 0 {
        return false
    }
    if gs(state, S_ARMED) == 0 {
        return false
    }
    if time.mono_ns(state) > gs(state, S_DEADLINE) {
        return false
    }
    if gs(state, S_USED) >= MAX_ANSCHLAEGE {
        return false
    }
    return true
}

fn arm_pid(state: u64) -> u64 {
    return gs(state, S_APID)
}

fn active(state: u64) -> u64 {
    if armed(state) {
        return 1
    }
    return 0
}

fn drop(state: u64) {
    ss(state, S_ARMED, 0)
    ss(state, S_APID, 0)
    ss(state, S_DEADLINE, 0)
    ss(state, S_USED, 0)
}

fn may_inject(state: u64, pid: u64) -> bool {
    if !armed(state) {
        return false
    }
    return gs(state, S_APID) == pid
}

fn mark(state: u64) {
    ss(state, S_GUARD, time.mono_ns(state))
}

fn injected_within(state: u64, window_ns: u64) -> bool {
    let last: u64 = gs(state, S_GUARD)
    if last == 0 {
        return false
    }
    let now: u64 = time.mono_ns(state)
    return now < last || now - last < window_ns
}

fn note(state: u64) {
    mark(state)
    ss(state, S_LAST, time.mono_ns(state))
    kstate.add(state, kstate.TIPP_OFF + S_USED, 1)
    kstate.add(state, kstate.TIPP_OFF + S_TOTAL, 1)
}

fn deny(state: u64) {
    kstate.add(state, kstate.TIPP_OFF + S_DENIED, 1)
}

fn eingespeist(state: u64) -> u64 {
    return gs(state, S_TOTAL)
}

fn denied(state: u64) -> u64 {
    return gs(state, S_DENIED)
}

fn arms(state: u64) -> u64 {
    return gs(state, S_ARMS)
}

fn last_pid(state: u64) -> u64 {
    return gs(state, S_LASTPID)
}

fn locked(state: u64) -> bool {
    return gs(state, S_LOCK) != 0
}

fn lock(state: u64) {
    ss(state, S_LOCK, 1)
    drop(state)
}

fn unlock(state: u64) {
    ss(state, S_LOCK, 0)
}

fn recent(state: u64) -> u64 {
    let last: u64 = gs(state, S_LAST)
    if last == 0 {
        return 0
    }
    let now: u64 = time.mono_ns(state)
    if now < last {
        return 1
    }
    if now - last < SHOW_NS {
        return 1
    }
    return 0
}

fn is_locked(state: u64) -> u64 {
    if locked(state) {
        return 1
    }
    return 0
}
