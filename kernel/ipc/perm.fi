
profile kernel

import lib.kstate
import sched.sched
import sched.taskconst
import sched.taskslot
import fs.fs
import fs.dcache
import serial
import ipc.appfs

export {
    may, may_real, may_ids, on_create, walk_w, apply_exec, umask_of,
    euid, egid, uid_of, gid_of, is_root, may_signal,
    R_READ, R_WRITE, R_EXEC,
    checks, denied, report,
    may_attr,
    walk, walk_stat, mu_report
}

const R_EXEC: u64 = 1
const R_WRITE: u64 = 2
const R_READ: u64 = 4

fn uid_of(state: u64, t: u64) -> u64 {
    return taskslot.tget(state, t, taskconst.T_UID)
}

fn gid_of(state: u64, t: u64) -> u64 {
    return taskslot.tget(state, t, taskconst.T_GID)
}

fn euid(state: u64, t: u64) -> u64 {
    return taskslot.tget(state, t, taskconst.T_EUID)
}

fn egid(state: u64, t: u64) -> u64 {
    return taskslot.tget(state, t, taskconst.T_EGID)
}

fn is_root(state: u64, t: u64) -> bool {
    return euid(state, t) == 0
}

fn umask_of(state: u64, t: u64) -> u64 {
    return taskslot.tget(state, t, taskconst.T_UMASK) & 4095
}

fn checks(state: u64) -> u64 {
    return kstate.get(state, kstate.K13_OFF + kstate.U_CHECKS)
}

fn denied(state: u64) -> u64 {
    return kstate.get(state, kstate.K13_OFF + kstate.U_DENIED)
}

fn in_group(state: u64, t: u64, group: u64, gid: u64) -> bool {
    if gid == group {
        return true
    }
    if kstate.mode_on(state, kstate.M_NOGROUPS) {
        return false
    }
    if sched.groups_has(state, t, group) {
        kstate.add(state, kstate.MU_OFF + kstate.MU_GRPHITS, 1)
        return true
    }
    return false
}

fn may_attr(state: u64, t: u64, mode: u64, owner: u64, group: u64,
    want: u64, id: u64, gid: u64, ist_dir: bool) -> bool {
    kstate.add(state, kstate.K13_OFF + kstate.U_CHECKS, 1)
    var okay: bool = true
    if id == 0 {
        if (want & R_EXEC) != 0 && !ist_dir {
            if (mode & 73) == 0 {
                okay = false
            }
        }
    } else {
        var have: u64 = mode & 7
        if id == owner {
            have = (mode >> 6) & 7
        } else {
            if in_group(state, t, group, gid) {
                have = (mode >> 3) & 7
            }
        }
        if (want & have) != want {
            okay = false
        }
    }
    if okay {
        return true
    }
    kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
    if kstate.mode_on(state, kstate.M_NOPERM) {
        return true
    }
    return false
}

fn may_ids(state: u64, t: u64, ino: u64, want: u64, id: u64,
    gid: u64) -> bool {
    if ino == 0 {
        kstate.add(state, kstate.K13_OFF + kstate.U_CHECKS, 1)
        kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
        if kstate.mode_on(state, kstate.M_NOPERM) {
            return true
        }
        return false
    }
    let mode: u64 = fs.inode_mode(state, ino)
    let owner: u64 = fs.inode_uid(state, ino)
    let group: u64 = fs.inode_gid(state, ino)
    let ist_dir: bool = fs.inode_type(state, ino) == fs.T_DIR
    let okay: bool = may_attr(state, t, mode, owner, group, want, id, gid,
        ist_dir)
    if okay {
        return true
    }
    kstate.set(state, kstate.K13_OFF + kstate.U_LASTDENY, (ino << 8) | want)
    return false
}

fn may(state: u64, t: u64, ino: u64, want: u64) -> bool {
    return may_ids(state, t, ino, want, euid(state, t), egid(state, t))
}

fn may_real(state: u64, t: u64, ino: u64, want: u64) -> bool {
    return may_ids(state, t, ino, want, uid_of(state, t), gid_of(state, t))
}

fn may_signal(state: u64, from: u64, to: u64) -> bool {
    kstate.add(state, kstate.K13_OFF + kstate.U_CHECKS, 1)
    if is_root(state, from) {
        return true
    }
    let a: u64 = euid(state, from)
    if a == uid_of(state, to) || a == euid(state, to) {
        return true
    }
    kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
    if kstate.mode_on(state, kstate.M_NOPERM) {
        return true
    }
    return false
}

fn walk_w(state: u64, t: u64, path: u64) -> bool {
    if !appfs.write_ok(state, t, path) {
        return false
    }
    return walk(state, t, path)
}

fn component_start(path: u64, slash: u64) -> u64 {
    var e: u64 = slash
    while e > 0 && kstate.get8(path + e - 1) == 47 {
        e = e - 1
    }
    var b: u64 = e
    while b > 0 && kstate.get8(path + b - 1) != 47 {
        b = b - 1
    }
    return b
}

fn component_end(path: u64, slash: u64) -> u64 {
    var e: u64 = slash
    while e > 0 && kstate.get8(path + e - 1) == 47 {
        e = e - 1
    }
    return e
}

fn prefix_node(state: u64, path: u64, slash: u64) -> u64 {
    let saved: u64 = kstate.get8(path + slash)
    kstate.set8(path + slash, 0 as u8)
    let ino: u64 = fs.path(state, path)
    kstate.set8(path + slash, saved as u8)
    return ino
}

fn walk(state: u64, t: u64, path: u64) -> bool {
    if !appfs.read_ok(state, t, path) {
        return false
    }
    kstate.add(state, kstate.MU_OFF + kstate.MU_WALKS, 1)
    let flags: u64 = fs.enter(state)
    var cur: u64 = fs.root(state)
    var fast: bool = true
    var i: u64 = 0
    var erlaubt: bool = true
    var more: bool = true
    while more {
        let c: u64 = kstate.get8(path + i)
        if c == 0 {
            more = false
        } else {
            if c == 47 {
                let before: u64 = kstate.get8(path + i + 1)
                if i == 0 || (before != 47 && before != 0) {
                    var ino: u64 = 0
                    if i == 0 {
                        ino = cur
                    } else {
                        let stamp: u64 = dcache.stamp(state)
                        let saved: u64 = kstate.get8(path + i)
                        kstate.set8(path + i, 0 as u8)
                        let hit: u64 = dcache.probe(state, 0, path)
                        kstate.set8(path + i, saved as u8)
                        if hit != dcache.MISS && hit != dcache.NEG {
                            ino = hit
                        } else {
                            if fast {
                                ino = fs.step_dir(state, cur, path, component_start(path, i), component_end(path, i))
                                if ino != 0 && fs.inode_type(state, ino) == fs.T_LINK {
                                    ino = prefix_node(state, path, i)
                                    fast = false
                                }
                            } else {
                                ino = prefix_node(state, path, i)
                            }
                            if ino != 0 {
                                kstate.set8(path + i, 0 as u8)
                                dcache.insert(state, 0, path, ino, stamp)
                                kstate.set8(path + i, saved as u8)
                            }
                        }
                    }
                    if ino == 0 {
                        more = false
                    } else {
                        if fs.inode_type(state, ino) != fs.T_DIR {
                            more = false
                        } else {
                            cur = ino
                            if !may(state, t, ino, R_EXEC) {
                                erlaubt = false
                                more = false
                            }
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    fs.leave(state, flags)
    if erlaubt {
        return true
    }
    kstate.add(state, kstate.MU_OFF + kstate.MU_WALKDENY, 1)
    if kstate.mode_on(state, kstate.M_NOWALK) {
        return true
    }
    if kstate.mode_on(state, kstate.M_NOPERM) {
        return true
    }
    return false
}

fn walk_stat(state: u64, was: u64) -> u64 {
    return kstate.get(state, kstate.MU_OFF + was)
}

fn mu_report(state: u64) {
    var s_h: [u8; 12] = "mu: walks=\0\0"
    var s_d: [u8; 12] = " walkdeny=\0\0"
    var s_g: [u8; 11] = " grphits=\0\0"
    var s_s: [u8; 11] = " suppset=\0\0"
    var s_n: [u8; 11] = " nodechk=\0\0"
    let b: u64 = kstate.MU_OFF
    serial.puts((&s_h[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.MU_WALKS))
    serial.puts((&s_d[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.MU_WALKDENY))
    serial.puts((&s_g[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.MU_GRPHITS))
    serial.puts((&s_s[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.MU_SUPPSET))
    serial.puts((&s_n[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.MU_NODECHK))
    serial.nl()
}

fn on_create(state: u64, t: u64, ino: u64, mode: u64) -> bool {
    let m: u64 = mode & (~umask_of(state, t)) & 4095
    return fs.set_meta(state, ino, m, euid(state, t), egid(state, t))
}

fn apply_exec(state: u64, t: u64, ino: u64) {
    if kstate.mode_on(state, kstate.M_NOSUID) {
        return
    }
    let mode: u64 = fs.inode_mode(state, ino)
    if (mode & fs.S_ISUID) != 0 {
        let owner: u64 = fs.inode_uid(state, ino)
        taskslot.tset(state, t, taskconst.T_EUID, owner)
        taskslot.tset(state, t, taskconst.T_SUID, owner)
        kstate.add(state, kstate.K13_OFF + kstate.U_SUIDEXEC, 1)
    }
    if (mode & fs.S_ISGID) != 0 {
        let group: u64 = fs.inode_gid(state, ino)
        taskslot.tset(state, t, taskconst.T_EGID, group)
        taskslot.tset(state, t, taskconst.T_SGID, group)
    }
}

fn report(state: u64) {
    var s_head: [u8; 15] = "k13: ofsver=\0\0\0"
    var s_chk: [u8; 9] = " checks=\0"
    var s_den: [u8; 9] = " denied=\0"
    var s_set: [u8; 9] = " setids=\0"
    var s_chm: [u8; 9] = " chmods=\0"
    var s_cho: [u8; 9] = " chowns=\0"
    var s_sui: [u8; 11] = " suidexec=\0"
    var s_orp: [u8; 10] = " orphans=\0"
    var s_zom: [u8; 10] = " zombies=\0"
    var s_ini: [u8; 7] = " init=\0"
    let b: u64 = kstate.K13_OFF
    serial.puts((&s_head[0]) as u64)
    serial.dec(fs.version(state))
    serial.puts((&s_chk[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_CHECKS))
    serial.puts((&s_den[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_DENIED))
    serial.puts((&s_set[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_SETIDS))
    serial.puts((&s_chm[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_CHMODS))
    serial.puts((&s_cho[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_CHOWNS))
    serial.puts((&s_sui[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_SUIDEXEC))
    serial.puts((&s_orp[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_ORPHANS))
    serial.puts((&s_zom[0]) as u64)
    serial.dec(sched.zombies(state, taskconst.K_USER))
    serial.puts((&s_ini[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_INITOK))
    serial.nl()
    mu_report(state)
}
