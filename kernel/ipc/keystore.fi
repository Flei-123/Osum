import libc.regio
import sync.atomic

export {
    KEYS_MAX, NONE, PAYLOAD_MAX, DESC_MAX, TYPE_USER, TYPE_LOGON, TYPE_RING,
    find_serial, find_member, alloc, release_key, set_payload, payload_addr, payload_len,
    serial_of, type_of, revoked, set_revoked, desc_len, desc_addr, link, unlink, linked, clear_ring,
    member_count, member_serial, matches
}

const KEYS_MAX: u64 = 32
const NONE: u64 = 32
const PAYLOAD_MAX: u64 = 1024
const DESC_MAX: u64 = 63
const DESC_STRIDE: u64 = 64
const TYPE_USER: u64 = 1
const TYPE_LOGON: u64 = 2
const TYPE_RING: u64 = 3
const SERIAL_BASE: u64 = 0x1000000

static mut lock_word: [u64; 1] = [0 as u64; 1]
static mut next_serial: [u64; 1] = [0 as u64; 1]
static mut k_serial: [u64; 32] = [0 as u64; 32]
static mut k_type: [u64; 32] = [0 as u64; 32]
static mut k_revoked: [u64; 32] = [0 as u64; 32]
static mut k_plen: [u64; 32] = [0 as u64; 32]
static mut k_dlen: [u64; 32] = [0 as u64; 32]
static mut k_members: [u64; 32] = [0 as u64; 32]
static mut k_desc: [u8; 2048] = [0 as u8; 2048]
static mut k_data: [u8; 32768] = [0 as u8; 32768]

fn lock() {
    let p: u64 = (&lock_word[0]) as u64
    while atomic.cas(p, 0, 1) != 0 {
        atomic.pause()
    }
}

fn unlock() {
    atomic.store((&lock_word[0]) as u64, 0)
}

fn serial_of(slot: u64) -> u64 {
    return k_serial[slot as usize]
}

fn type_of(slot: u64) -> u64 {
    return k_type[slot as usize]
}

fn revoked(slot: u64) -> bool {
    return k_revoked[slot as usize] != 0
}

fn set_revoked(slot: u64) {
    k_revoked[slot as usize] = 1
}

fn desc_len(slot: u64) -> u64 {
    return k_dlen[slot as usize]
}

fn desc_addr(slot: u64) -> u64 {
    return (&k_desc[0]) as u64 + slot * DESC_STRIDE
}

fn payload_addr(slot: u64) -> u64 {
    return (&k_data[0]) as u64 + slot * PAYLOAD_MAX
}

fn payload_len(slot: u64) -> u64 {
    return k_plen[slot as usize]
}

fn find_serial(serial: u64) -> u64 {
    if serial == 0 {
        return NONE
    }
    var slot: u64 = 0
    while slot < KEYS_MAX {
        if k_serial[slot as usize] == serial {
            return slot
        }
        slot = slot + 1
    }
    return NONE
}

fn matches(slot: u64, kind: u64, desc: u64, len: u64) -> bool {
    if k_serial[slot as usize] == 0 || k_type[slot as usize] != kind || k_dlen[slot as usize] != len {
        return false
    }
    var i: u64 = 0
    while i < len {
        if k_desc[(slot * DESC_STRIDE + i) as usize] as u64 != regio.read8(desc + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn find_member(ring: u64, kind: u64, desc: u64, len: u64) -> u64 {
    var slot: u64 = 0
    while slot < KEYS_MAX {
        if (k_members[ring as usize] & (1 << slot)) != 0 && matches(slot, kind, desc, len) {
            return slot
        }
        slot = slot + 1
    }
    return NONE
}

fn alloc(kind: u64, desc: u64, len: u64) -> u64 {
    lock()
    var slot: u64 = 0
    var found: u64 = NONE
    while slot < KEYS_MAX {
        if k_serial[slot as usize] == 0 && found == NONE {
            found = slot
        }
        slot = slot + 1
    }
    if found != NONE {
        let s: usize = found as usize
        next_serial[0] = next_serial[0] + 1
        k_type[s] = kind
        k_revoked[s] = 0
        k_plen[s] = 0
        k_dlen[s] = len
        k_members[s] = 0
        var i: u64 = 0
        while i < len {
            k_desc[(found * DESC_STRIDE + i) as usize] = regio.read8(desc + i) as u8
            i = i + 1
        }
        k_serial[s] = SERIAL_BASE + next_serial[0]
    }
    unlock()
    return found
}

fn set_payload(slot: u64, src: u64, len: u64) {
    var i: u64 = 0
    while i < len {
        k_data[(slot * PAYLOAD_MAX + i) as usize] = regio.read8(src + i) as u8
        i = i + 1
    }
    k_plen[slot as usize] = len
}

fn link(ring: u64, key: u64) {
    lock()
    k_members[ring as usize] = k_members[ring as usize] | (1 << key)
    unlock()
}

fn unlink(ring: u64, key: u64) {
    lock()
    k_members[ring as usize] = k_members[ring as usize] & ~(1 << key)
    unlock()
}

fn linked(ring: u64, key: u64) -> bool {
    return (k_members[ring as usize] & (1 << key)) != 0
}

fn clear_ring(ring: u64) {
    lock()
    k_members[ring as usize] = 0
    unlock()
}

fn release_key(slot: u64) {
    lock()
    var other: u64 = 0
    while other < KEYS_MAX {
        k_members[other as usize] = k_members[other as usize] & ~(1 << slot)
        other = other + 1
    }
    k_serial[slot as usize] = 0
    k_members[slot as usize] = 0
    unlock()
}

fn member_count(ring: u64) -> u64 {
    var n: u64 = 0
    var slot: u64 = 0
    while slot < KEYS_MAX {
        if (k_members[ring as usize] & (1 << slot)) != 0 {
            n = n + 1
        }
        slot = slot + 1
    }
    return n
}

fn member_serial(ring: u64, index: u64) -> u64 {
    var n: u64 = 0
    var slot: u64 = 0
    while slot < KEYS_MAX {
        if (k_members[ring as usize] & (1 << slot)) != 0 {
            if n == index {
                return k_serial[slot as usize]
            }
            n = n + 1
        }
        slot = slot + 1
    }
    return 0
}
