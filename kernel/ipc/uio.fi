
import lib.kstate
import arch.arch
import sched.sched
import sched.taskslot
import fs.fs
import serial
import sched.time
import sched.ctr

export {
    reset, adopt, exe_set, exe_len, exe_at, exe_copy, interp_set, interp_len, interp_at, interp_copy, set_atbase, atbase, set_atbase2, next_base,
    resolve, chdir_to, cwd_len, cwd_at, sysinfo, pstat, kill_pid,
    SLOT, CWD_MAX, PATH_MAX,
    I_TICKS, I_UPTIME, I_FRAMES_FREE, I_FRAMES_ALL, I_BLOCKS, I_BFREE,
    I_INODES, I_IUSED, I_BSIZE, I_TASKS, I_SYSCALLS, I_VERSION,
    I_YEAR, I_MONTH, I_DAY, I_HOUR, I_MIN, I_SEC, I_TZMIN, I_TZBASE, I_TZRULE, I_MEM_USABLE,
    P_STATE, P_PID, P_PPID, P_KIND, P_PRIO, P_TICKS, P_EXIT, P_FAULTS,
    P_CPU, P_PAGES, P_NAME0, P_NAME1, P_AGE, P_CMD0, P_CMD_WORDS,
    P_UID, P_THREADS, P_DISKR, P_DISKW
}

const SLOT: u64 = 512
const O_CWD: u64 = 0
const CWD_MAX: u64 = 462
const O_ATBASE: u64 = 480
const O_ATBASE2: u64 = 488

const PATH_MAX: u64 = 1000

const E_PERM: u64 = 1
const E_NOENT: u64 = 2
const E_SRCH: u64 = 3
const E_INVAL: u64 = 22
const E_NOTDIR: u64 = 20
const E_NAMETOOLONG: u64 = 36

fn err(e: u64) -> u64 {
    return 0 -% e
}

fn slot_off(t: u64, extra: u64) -> u64 {
    return kstate.UIO_OFF + t * SLOT + extra
}

fn atbase(state: u64, t: u64) -> u64 {
    if t >= kstate.MAX_TASKS {
        return 0
    }
    return kstate.get(state, slot_off(t, O_ATBASE))
}

fn set_atbase(state: u64, t: u64, fr: u64) {
    if t < kstate.MAX_TASKS {
        kstate.set(state, slot_off(t, O_ATBASE), fr)
        if fr == 0 {
            kstate.set(state, slot_off(t, O_ATBASE2), 0)
        }
    }
}

fn set_atbase2(state: u64, t: u64, other: u64) {
    if t < kstate.MAX_TASKS {
        kstate.set(state, slot_off(t, O_ATBASE2), other)
    }
}

fn next_base(state: u64, t: u64) {
    if t >= kstate.MAX_TASKS {
        return
    }
    let other: u64 = kstate.get(state, slot_off(t, O_ATBASE2))
    if other == 0 {
        return
    }
    var cur: u64 = kstate.get(state, slot_off(t, O_ATBASE))
    if cur == 0 {
        cur = 1
    }
    var nb: u64 = other
    if nb == 1 {
        nb = 0
    }
    kstate.set(state, slot_off(t, O_ATBASE), nb)
    kstate.set(state, slot_off(t, O_ATBASE2), cur)
}

fn cwd_addr(state: u64, t: u64) -> u64 {
    return state + slot_off(t, O_CWD)
}

fn reset(state: u64, t: u64) {
    if t >= kstate.MAX_TASKS {
        return
    }
    let p: u64 = state + slot_off(t, 0)
    arch.fill_words(p, 0, SLOT / 8)
    kstate.set8(p + O_CWD, 47 as u8)
    exe_clear(state, t)
}

fn exe_addr(state: u64, t: u64) -> u64 {
    return state + kstate.EXE_OFF + t * kstate.EXE_SLOT
}

const EXE_HALF: u64 = 128

fn exe_clear(state: u64, t: u64) {
    if t >= kstate.MAX_TASKS {
        return
    }
    kstate.set8(exe_addr(state, t), 0 as u8)
    kstate.set8(exe_addr(state, t) + EXE_HALF, 0 as u8)
}

fn exe_set(state: u64, t: u64, path: u64) {
    if t >= kstate.MAX_TASKS {
        return
    }
    let a: u64 = exe_addr(state, t)
    var i: u64 = 0
    while i + 1 < EXE_HALF && kstate.get8(path + i) != 0 {
        kstate.set8(a + i, kstate.get8(path + i) as u8)
        i = i + 1
    }
    kstate.set8(a + i, 0 as u8)
}

fn exe_len(state: u64, t: u64) -> u64 {
    if t >= kstate.MAX_TASKS {
        return 0
    }
    let a: u64 = exe_addr(state, t)
    var n: u64 = 0
    while n + 1 < EXE_HALF && kstate.get8(a + n) != 0 {
        n = n + 1
    }
    return n
}

fn exe_at(state: u64, t: u64, i: u64) -> u64 {
    if t >= kstate.MAX_TASKS || i + 1 >= EXE_HALF {
        return 0
    }
    return kstate.get8(exe_addr(state, t) + i)
}

fn exe_copy(state: u64, from: u64, to: u64) {
    if from >= kstate.MAX_TASKS || to >= kstate.MAX_TASKS {
        return
    }
    exe_set(state, to, exe_addr(state, from))
    interp_copy(state, from, to)
}

fn interp_set(state: u64, t: u64, path: u64) {
    if t >= kstate.MAX_TASKS {
        return
    }
    let a: u64 = exe_addr(state, t) + EXE_HALF
    var i: u64 = 0
    if path != 0 {
        while i + 1 < EXE_HALF && kstate.get8(path + i) != 0 {
            kstate.set8(a + i, kstate.get8(path + i) as u8)
            i = i + 1
        }
    }
    kstate.set8(a + i, 0 as u8)
}

fn interp_len(state: u64, t: u64) -> u64 {
    if t >= kstate.MAX_TASKS {
        return 0
    }
    let a: u64 = exe_addr(state, t) + EXE_HALF
    var n: u64 = 0
    while n + 1 < EXE_HALF && kstate.get8(a + n) != 0 {
        n = n + 1
    }
    return n
}

fn interp_at(state: u64, t: u64, i: u64) -> u64 {
    if t >= kstate.MAX_TASKS || i + 1 >= EXE_HALF {
        return 0
    }
    return kstate.get8(exe_addr(state, t) + EXE_HALF + i)
}

fn interp_copy(state: u64, from: u64, to: u64) {
    if from >= kstate.MAX_TASKS || to >= kstate.MAX_TASKS {
        return
    }
    interp_set(state, to, exe_addr(state, from) + EXE_HALF)
}

fn adopt(state: u64, parent: u64, child: u64) {
    if parent >= kstate.MAX_TASKS || child >= kstate.MAX_TASKS {
        return
    }
    let a: u64 = state + slot_off(parent, 0)
    let b: u64 = state + slot_off(child, 0)
    arch.copy_words(b, a, SLOT / 8)
}

fn cwd_len(state: u64, t: u64) -> u64 {
    let c: u64 = cwd_addr(state, t)
    var n: u64 = 0
    while n < CWD_MAX && kstate.get8(c + n) != 0 {
        n = n + 1
    }
    if n == 0 {
        return 1
    }
    return n
}

fn cwd_at(state: u64, t: u64, i: u64) -> u64 {
    if i >= CWD_MAX {
        return 0
    }
    let c: u64 = kstate.get8(cwd_addr(state, t) + i)
    if c == 0 && i == 0 {
        return 47
    }
    return c
}

fn resolve(state: u64, t: u64, buf: u64, len: u64) -> u64 {
    if len > 0 && kstate.get8(buf) == 47 {
        if len >= PATH_MAX {
            return err(E_NAMETOOLONG)
        }
        return jailed(state, t, buf, len)
    }
    let base: u64 = atbase(state, t)
    var n: u64 = cwd_len(state, t)
    if base != 0 {
        n = 0
        while n < PATH_MAX && kstate.get8(base + n) != 0 {
            n = n + 1
        }
    }
    let s: u64 = buf + 2048
    var at: u64 = 0
    var i: u64 = 0
    while i < n {
        if base != 0 {
            kstate.set8(s + at, kstate.get8(base + i) as u8)
        } else {
            kstate.set8(s + at, cwd_at(state, t, i) as u8)
        }
        at = at + 1
        i = i + 1
    }
    if at == 0 || kstate.get8(s + at - 1) != 47 {
        kstate.set8(s + at, 47 as u8)
        at = at + 1
    }
    if at + len >= PATH_MAX {
        return err(E_NAMETOOLONG)
    }
    i = 0
    while i < len {
        kstate.set8(s + at + i, kstate.get8(buf + i) as u8)
        i = i + 1
    }
    at = at + len
    kstate.set8(s + at, 0 as u8)
    i = 0
    while i <= at {
        kstate.set8(buf + i, kstate.get8(s + i) as u8)
        i = i + 1
    }
    return jailed(state, t, buf, at)
}

fn jailed(state: u64, t: u64, buf: u64, len: u64) -> u64 {
    if !ctr.jail_needed(state, t) {
        return len
    }
    let n: u64 = ctr.jail(state, t, buf, len, PATH_MAX)
    if n == 0 {
        return err(E_NAMETOOLONG)
    }
    return n
}

fn chdir_to(state: u64, t: u64, buf: u64) -> u64 {
    let ino: u64 = fs.path(state, buf)
    if ino == 0 {
        return err(E_NOENT)
    }
    if fs.inode_type(state, ino) != fs.T_DIR {
        return err(E_NOTDIR)
    }
    let c: u64 = cwd_addr(state, t)
    var comp: [u8; 264] = [0 as u8; 264]
    var at: u64 = 0
    var i: u64 = ctr.prefix_len(state, t, buf)
    var going: bool = true
    while going {
        while kstate.get8(buf + i) == 47 {
            i = i + 1
        }
        if kstate.get8(buf + i) == 0 {
            going = false
        } else {
            var n: u64 = 0
            while kstate.get8(buf + i) != 0 && kstate.get8(buf + i) != 47 {
                if n < 255 {
                    comp[n as usize] = kstate.get8(buf + i) as u8
                    n = n + 1
                }
                i = i + 1
            }
            comp[n as usize] = 0 as u8
            if n == 1 && comp[0 as usize] == 46 as u8 {
                going = true
            } else {
                if n == 2 && comp[0 as usize] == 46 as u8
                && comp[1 as usize] == 46 as u8 {
                    while at > 0 && kstate.get8(c + at - 1) != 47 {
                        at = at - 1
                    }
                    if at > 0 {
                        at = at - 1
                    }
                } else {
                    if at + n + 2 >= CWD_MAX {
                        return err(E_NAMETOOLONG)
                    }
                    kstate.set8(c + at, 47 as u8)
                    at = at + 1
                    var k: u64 = 0
                    while k < n {
                        kstate.set8(c + at, comp[k as usize])
                        at = at + 1
                        k = k + 1
                    }
                }
            }
        }
    }
    if at == 0 {
        kstate.set8(c + at, 47 as u8)
        at = at + 1
    }
    kstate.set8(c + at, 0 as u8)
    taskslot.tset(state, t, sched.T_CWD, ino)
    return 0
}

const I_TICKS: u64 = 0
const I_UPTIME: u64 = 1
const I_FRAMES_FREE: u64 = 2
const I_FRAMES_ALL: u64 = 3
const I_BLOCKS: u64 = 4
const I_BFREE: u64 = 5
const I_INODES: u64 = 6
const I_IUSED: u64 = 7
const I_BSIZE: u64 = 8
const I_TASKS: u64 = 9
const I_SYSCALLS: u64 = 10
const I_VERSION: u64 = 11
const I_YEAR: u64 = 12
const I_MONTH: u64 = 13
const I_DAY: u64 = 14
const I_HOUR: u64 = 15
const I_MIN: u64 = 16
const I_SEC: u64 = 17
const I_TZMIN: u64 = 18
const I_TZBASE: u64 = 19
const I_TZRULE: u64 = 20
const I_MEM_USABLE: u64 = 21

const VERSION: u64 = 6

fn cmos(reg: u64) -> u64 {
    serial.out8(0x70 as u16, reg as u8)
    return serial.in8(0x71 as u16) as u64
}

fn rtc(what: u64) -> u64 {
    var guard: u64 = 0
    while guard < 100000 && (cmos(0x0A) & 0x80) != 0 {
        guard = guard + 1
    }
    var reg: u64 = 0
    if what == I_YEAR {
        reg = 9
    }
    if what == I_MONTH {
        reg = 8
    }
    if what == I_DAY {
        reg = 7
    }
    if what == I_HOUR {
        reg = 4
    }
    if what == I_MIN {
        reg = 2
    }
    if what == I_SEC {
        reg = 0
    }
    let b: u64 = cmos(0x0B)
    var raw: u64 = cmos(reg)
    var pm: bool = false
    if what == I_HOUR && (b & 2) == 0 && (raw & 0x80) != 0 {
        pm = true
        raw = raw & 0x7F
    }
    var v: u64 = raw
    if (b & 4) == 0 {
        v = (raw & 15) + (raw >> 4) * 10
    }
    if what == I_HOUR && pm && v < 12 {
        v = v + 12
    }
    if what == I_YEAR {
        v = v + 2000
    }
    return v
}

fn time_field(state: u64, what: u64) -> u64 {
    let now: u64 = time.now_local(state)
    let tag_s: u64 = now % 86400
    if what == I_HOUR {
        return tag_s / 3600
    }
    if what == I_MIN {
        return (tag_s % 3600) / 60
    }
    if what == I_SEC {
        return tag_s % 60
    }
    var days: u64 = now / 86400
    var jahr: u64 = 1970
    while true {
        var len_v: u64 = 365
        if (jahr % 4) == 0 && ((jahr % 100) != 0 || (jahr % 400) == 0) {
            len_v = 366
        }
        if days < len_v {
            break
        }
        days = days - len_v
        jahr = jahr + 1
    }
    if what == I_YEAR {
        return jahr
    }
    var schalt: u64 = 0
    if (jahr % 4) == 0 && ((jahr % 100) != 0 || (jahr % 400) == 0) {
        schalt = 1
    }
    var mon: u64 = 1
    while mon <= 12 {
        var d: u64 = 31
        if mon == 4 || mon == 6 || mon == 9 || mon == 11 {
            d = 30
        }
        if mon == 2 {
            d = 28 + schalt
        }
        if days < d {
            break
        }
        days = days - d
        mon = mon + 1
    }
    if what == I_MONTH {
        return mon
    }
    return days + 1
}

fn sysinfo(state: u64, what: u64) -> u64 {
    if what == I_TICKS {
        return kstate.get(state, kstate.TICKS)
    }
    if what == I_UPTIME {
        return kstate.get(state, kstate.TICKS) * 10
    }
    if what == I_FRAMES_FREE {
        return kstate.get(state, kstate.FRAMES_FREE)
    }
    if what == I_FRAMES_ALL {
        return kstate.get(state, kstate.BITMAP_FRAMES)
    }
    if what == I_BLOCKS {
        return kstate.get(state, kstate.DISK_BLOCKS)
    }
    if what == I_BFREE {
        if kstate.get(state, kstate.FS_READY) == 0 {
            return 0
        }
        return fs.free_blocks(state)
    }
    if what == I_INODES {
        if kstate.get(state, kstate.FS_READY) == 0 {
            return fs.INODE_COUNT
        }
        return fs.inode_count(state)
    }
    if what == I_IUSED {
        if kstate.get(state, kstate.FS_READY) == 0 {
            return 0
        }
        return fs.used_inodes(state)
    }
    if what == I_BSIZE {
        return 512
    }
    if what == I_TASKS {
        return sched.alive_count(state)
    }
    if what == I_SYSCALLS {
        return kstate.get(state, kstate.SYSCALLS)
    }
    if what == I_VERSION {
        return VERSION
    }
    if what >= I_YEAR && what <= I_SEC {
        return time_field(state, what)
    }
    if what == I_TZMIN {
        return time.tz_min(state)
    }
    if what == I_TZBASE {
        return time.tz_base(state)
    }
    if what == I_TZRULE {
        return time.tz_rule_get(state)
    }
    if what == I_MEM_USABLE {
        return kstate.get(state, kstate.MEM_USABLE) / 4096
    }
    return err(E_INVAL)
}

const P_STATE: u64 = 0
const P_PID: u64 = 1
const P_PPID: u64 = 2
const P_KIND: u64 = 3
const P_PRIO: u64 = 4
const P_TICKS: u64 = 5
const P_EXIT: u64 = 6
const P_FAULTS: u64 = 7
const P_CPU: u64 = 8
const P_PAGES: u64 = 9
const P_NAME0: u64 = 10
const P_NAME1: u64 = 11
const P_AGE: u64 = 12
const P_CMD0: u64 = 16
const P_CMD_WORDS: u64 = 32
const P_UID: u64 = 13
const P_THREADS: u64 = 14
const P_DISKR: u64 = 48
const P_DISKW: u64 = 49

fn pstat(state: u64, index: u64, field: u64) -> u64 {
    if index >= kstate.MAX_TASKS {
        return err(E_INVAL)
    }
    if index >= kstate.get(state, kstate.TASKS) {
        return 0
    }
    if field == P_STATE {
        return taskslot.tget(state, index, sched.T_STATE)
    }
    if taskslot.tget(state, index, sched.T_STATE) == sched.S_FREE {
        return 0
    }
    if field == P_PID {
        return taskslot.tget(state, index, sched.T_PID)
    }
    if field == P_PPID {
        let p: u64 = taskslot.tget(state, index, sched.T_PARENT)
        if p >= kstate.MAX_TASKS {
            return 0
        }
        return taskslot.tget(state, p, sched.T_PID)
    }
    if field == P_KIND {
        return taskslot.tget(state, index, sched.T_KIND)
    }
    if field == P_PRIO {
        return taskslot.tget(state, index, sched.T_PRIO)
    }
    if field == P_TICKS {
        return taskslot.tget(state, index, sched.T_TICKS)
    }
    if field == P_EXIT {
        return taskslot.tget(state, index, sched.T_EXIT)
    }
    if field == P_FAULTS {
        return taskslot.tget(state, index, sched.T_FAULTS)
    }
    return err(E_INVAL)
}

fn kill_pid(state: u64, pid: u64, code: u64) -> u64 {
    let flags: u64 = sched.irq_save()
    let i: u64 = sched.find_pid(state, pid)
    if i >= kstate.MAX_TASKS {
        sched.irq_restore(flags)
        return err(E_SRCH)
    }
    if !ctr.may_signal(state, sched.current(state), i) {
        ctr.note_escape(state)
        sched.irq_restore(flags)
        return err(E_SRCH)
    }
    let st: u64 = taskslot.tget(state, i, sched.T_STATE)
    if st == sched.S_FREE || st == sched.S_ZOMBIE {
        sched.irq_restore(flags)
        return err(E_SRCH)
    }
    if taskslot.tget(state, i, sched.T_KIND) != sched.K_USER {
        sched.irq_restore(flags)
        return err(E_PERM)
    }
    if i == sched.current(state) {
        sched.irq_restore(flags)
        sched.kill_group(state, i, code)
        sched.exit_task(state, code)
        return 0
    }
    sched.irq_restore(flags)
    sched.kill_group(state, i, code)
    var r: u64 = sched.kill_other(state, i, pid, code)
    var tries: u64 = 0
    while r == sched.KILL_LATER && tries < 4 {
        sched.sleep_ticks(state, 1)
        tries = tries + 1
        r = sched.kill_other(state, i, pid, code)
    }
    if r == sched.KILL_GONE && tries == 0 {
        return err(E_SRCH)
    }
    return 0
}
