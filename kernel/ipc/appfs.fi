profile kernel

import lib.kstate
import sched.origin
import apprights.fspolicy

export { read_ok, write_ok, free_ok }

fn read_ok(state: u64, t: u64, path: u64) -> bool {
    if origin.is_empty(state, t) {
        return true
    }
    return fspolicy.read_ok(origin.at(state, t), path)
}

fn write_ok(state: u64, t: u64, path: u64) -> bool {
    if origin.is_empty(state, t) {
        return true
    }
    return fspolicy.write_ok(origin.at(state, t), path)
}

fn free_ok(state: u64, t: u64) -> bool {
    if origin.is_empty(state, t) {
        return true
    }
    return fspolicy.link_ok(origin.at(state, t))
}
