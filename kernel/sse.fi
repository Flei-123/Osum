// SPDX-License-Identifier: GPL-2.0-only
//
// kernel/sse.fi -- RUNDE FEEDBACK: die 128-Bit-Register freischalten.
//
// WARUM DIESE DATEI EXISTIERT, und zwar ausgerechnet in einer Runde,
// die von einem Fehlerbericht handelt:
//
// `/bin/fetch` baut den TLS-1.3-Kanal, und TLS-1.3 rechnet SHA-256 bei
// jedem Handschlag. `vendor/firn/lib/std/crypto/sha256.fi` fragt vorher
// `cpu.has_sha()` und `cpu.has_ssse3()` -- meldet CPUID beides, nimmt es
// den Weg ueber `sha256rnds2` in `crypto/accel.fi`, und der arbeitet in
// xmm0..xmm5.
//
// UNTER TCG fiel das nie auf: QEMUs Ersatzprozessor meldet SHA-NI nicht,
// die Bibliothek rechnete skalar. Mit `-accel kvm -cpu host` auf einem
// Zen meldet CPUID SHA-NI -- und das erste `movdqu` endete als
//
//     user fault: pid=5  vector=6  err=0x0  rip=0x4013905f
//
// #UD, ungueltiger Befehl. Nicht weil der Prozessor die Befehle nicht
// koennte, sondern weil DIESER KERN sie nie erlaubt hat: nach dem
// Ruecksetzen ist CR4.OSFXSR null, und ohne dieses Bit ist jeder
// SSE-Befehl ein ungueltiger Befehl. Dieselbe Sorte Fehler wie in Runde
// KVMFIX -- er steht erst da, wenn die ECHTE CPU darunter liegt.
//
// WAS FREISCHALTEN HEISST. Vier Bits und eine Pflicht:
//
//   CR0.EM = 0   keine Nachbildung -- SSE-Befehle sollen laufen
//   CR0.MP = 1   `wait`/`fwait` sehen TS, wie es sich gehoert
//   CR4.OSFXSR = 1        `fxsave`/`fxrstor` gibt es, SSE ist erlaubt
//   CR4.OSXMMEXCPT = 1    ein SSE-Rechenfehler kommt als #XM (Vektor 19)
//                         und nicht als #UD -- sonst zeigt der
//                         Trap-Melder auf die falsche Ursache
//
// UND DIE PFLICHT: wer xmm erlaubt, muss xmm auch AUFHEBEN. Ein
// Aufgabenwechsel mitten in `sha256_ni_blocks` wuerde sonst die halb
// gerechneten Runden einer anderen Aufgabe in die Hand geben. Das
// erledigt `arch/x86_64/switch.s` mit `fxsave`/`fxrstor` in 512 Oktetten
// auf dem Kernstapel der Aufgabe, die gerade weggelegt wird -- siehe
// dort und `sched.frame_build`.
//
// OHNE CPUID WIRD NICHTS GESETZT. `mov cr4` mit einem Bit, das der
// Prozessor nicht kennt, ist ein #GP im Kern. Auf einer Maschine ohne
// FXSR bleibt es also aus, `cpu.has_sha()` in Ring 3 ist dann zwar
// weiterhin wahr -- deshalb wird SSE_OK gemeldet und der Testlauf liest
// es zurueck.

import kstate
import serial

export { on, on_here, ok, aps, report }

// CPUID Blatt 1, EDX
const F1_FXSR: u64 = 0x1000000  // Bit 24
const F1_SSE: u64 = 0x2000000   // Bit 25
const F1_SSE2: u64 = 0x4000000  // Bit 26

const CR0_MP: u64 = 0x2
const CR0_EM: u64 = 0x4
const CR4_OSFXSR: u64 = 0x200      // Bit 9
const CR4_OSXMMEXCPT: u64 = 0x400  // Bit 10

fn leaf1_edx() -> u64 {
    var d: u64 = 0
    asm("push rbx\nmov eax, 1\nxor ecx, ecx\ncpuid\nmov rax, rdx\npop rbx",
        out("rax") & d, clobber("rcx"), clobber("rdx"))
    return d
}

fn cr0() -> u64 {
    return asm("mov rax, cr0", out("rax"))
}

fn cr0_set(v: u64) {
    asm("mov cr0, rax", in("rax") v)
}

fn cr4() -> u64 {
    return asm("mov rax, cr4", out("rax"))
}

fn cr4_set(v: u64) {
    asm("mov cr4, rax", in("rax") v)
}

// Die Bits auf DEM Prozessor, der gerade laeuft. Gibt zurueck, ob sie
// danach WIRKLICH stehen -- zurueckgelesen, nicht angenommen.
fn arm() -> bool {
    let d: u64 = leaf1_edx()
    if (d & F1_FXSR) == 0 {
        return false
    }
    if (d & F1_SSE) == 0 {
        return false
    }
    var c0: u64 = cr0()
    c0 = c0 & (0xFFFFFFFFFFFFFFFF - CR0_EM)
    c0 = c0 | CR0_MP
    cr0_set(c0)
    var c4: u64 = cr4()
    c4 = c4 | CR4_OSFXSR
    c4 = c4 | CR4_OSXMMEXCPT
    cr4_set(c4)
    let soll: u64 = CR4_OSFXSR | CR4_OSXMMEXCPT
    if (cr4() & soll) != soll {
        return false
    }
    if (cr0() & CR0_EM) != 0 {
        return false
    }
    return true
}

// Der Startprozessor. Muss laufen, BEVOR die erste Aufgabe gebaut wird
// -- `frame_build` legt eine Anfangsablage fuer `fxrstor` an, und ein
// `fxrstor` auf einem Kern ohne OSFXSR waere selbst wieder ein #UD.
fn on(state: u64) {
    var v: u64 = 0
    if arm() {
        v = 1
    }
    kstate.set(state, kstate.SSE_OK, v)
    kstate.set(state, kstate.SSE_APS, 0)
}

// Jeder weitere Prozessor. Er fragt CPUID noch einmal -- anders als bei
// SMEP/SMAP kostet das nichts, und ein Kern, dem die Bits fehlen, darf
// hier nicht mitgezaehlt werden.
fn on_here(state: u64) {
    if kstate.get(state, kstate.SSE_OK) == 0 {
        return
    }
    if arm() {
        kstate.add(state, kstate.SSE_APS, 1)
    }
}

fn ok(state: u64) -> bool {
    return kstate.get(state, kstate.SSE_OK) != 0
}

fn aps(state: u64) -> u64 {
    return kstate.get(state, kstate.SSE_APS)
}

// Eine Zeile, die der Testlauf zurueckliest. `cr4=` steht mit dabei,
// weil ein gesetztes Bit nur dann etwas heisst, wenn es im Register
// steht und nicht in einer Variablen.
fn report(state: u64) {
    var s_a: [u8; 10] = "sse: cr4=\0"
    var s_b: [u8; 8] = "  cr0=\0\0"
    var s_c: [u8; 8] = "  sse=\0\0"
    var s_d: [u8; 8] = "  fxsr=\0"
    var s_e: [u8; 8] = "  shani\0"
    serial.puts((&s_a[0]) as u64)
    serial.hex(cr4())
    serial.puts((&s_b[0]) as u64)
    serial.hex(cr0())
    serial.puts((&s_c[0]) as u64)
    serial.dec(kstate.get(state, kstate.SSE_OK))
    serial.puts((&s_d[0]) as u64)
    var f: u64 = 0
    if (leaf1_edx() & F1_FXSR) != 0 {
        f = 1
    }
    serial.dec(f)
    serial.puts((&s_e[0]) as u64)
    serial.nl()
}
