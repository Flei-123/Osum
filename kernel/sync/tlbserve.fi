import lib.kstate
import arch.cpu
import mm.tlbstat

export { serve, request, issued, acked, note_cr3, loaded_cr3, VEC_TLB, MAX_CPUS, CR3_ADDR_MASK }

const VEC_TLB: u64 = 34

const MAX_CPUS: u64 = kstate.MAX_CPUS

const CR3_ADDR_MASK: u64 = 0x000FFFFFFFFFF000

static mut want: [u64; 8] = [0 as u64; 8]
static mut done: [u64; 8] = [0 as u64; 8]
static mut loaded: [u64; 8] = [0 as u64; 8]

fn want_cell(k: u64) -> u64 {
    return (&want[0]) as u64 + k * 8
}

fn done_cell(k: u64) -> u64 {
    return (&done[0]) as u64 + k * 8
}

fn loaded_cell(k: u64) -> u64 {
    return (&loaded[0]) as u64 + k * 8
}

fn serve(state: u64) {
    let me: u64 = cpu.here(state)
    if me >= MAX_CPUS {
        return
    }
    let w: u64 = __mmio_read64(want_cell(me) as *mut u64)
    if w == __mmio_read64(done_cell(me) as *mut u64) {
        return
    }
    tlbstat.note(tlbstat.SERVE_RUN)
    asm("mov rax, cr3\nmov cr3, rax", out("rax"), clobber("memory"))
    __mmio_write64(done_cell(me) as *mut u64, w)
}

fn request(k: u64) {
    let _g: u64 = __atomic_add(want_cell(k) as *mut u64, 1)
}

fn issued(k: u64) -> u64 {
    return __mmio_read64(want_cell(k) as *mut u64)
}

fn acked(k: u64, gen: u64) -> bool {
    return __mmio_read64(done_cell(k) as *mut u64) >= gen
}

fn note_cr3(me: u64, cr3: u64) {
    if me < MAX_CPUS {
        __mmio_write64(loaded_cell(me) as *mut u64, cr3 & CR3_ADDR_MASK)
    }
}

fn loaded_cr3(k: u64) -> u64 {
    return __mmio_read64(loaded_cell(k) as *mut u64)
}
