profile kernel

import lib.kstate
import sync.atomic
import sync.fslockstat
import arch.cpu
import sched.park

export { enter, leave, mine, take, try_take, give, nested, save_irq, restore_irq, park_begin, park_end, holder_parked }

const NESTED: u64 = 0x8000000000000000
const IF_BIT: u64 = 0x200

static mut parked_holder: u64 = 0

static mut releases: [u64; 9] = [0 as u64; 9]

#[inline]
fn task_id(state: u64) -> u64 {
    return cpu.get(state, cpu.here(state), cpu.C_CUR)
}

fn save_irq() -> u64 {
    return asm("pushfq\npop rax\ncli", out("rax"))
}

fn restore_irq(flags: u64) {
    if (flags & IF_BIT) != 0 {
        asm("sti")
    }
}

#[inline]
fn mine(state: u64) -> bool {
    return atomic.lock_owner(state, atomic.L_FS) == task_id(state) + 1
}

fn holder_parked() -> bool {
    return atomic.load((&parked_holder) as u64) != 0
}

fn park_begin(state: u64) -> bool {
    if !mine(state) {
        return false
    }
    atomic.store((&parked_holder) as u64, task_id(state) + 1)
    return true
}

fn park_end() {
    atomic.store((&parked_holder) as u64, 0)
}

fn take_parking(state: u64) -> bool {
    let q: u64 = (&releases[0]) as u64
    while holder_parked() && park.can_park(state) {
        let seen: u64 = park.seq(q)
        if atomic.lock_try(state, atomic.L_FS, task_id(state)) {
            return true
        }
        park.wait_on(state, q, seen)
    }
    return false
}

fn take(state: u64) {
    if !take_parking(state) {
        atomic.lock_take(state, atomic.L_FS, task_id(state))
    }
    fslockstat.begin()
}

fn try_take(state: u64) -> bool {
    if !atomic.lock_try(state, atomic.L_FS, task_id(state)) {
        return false
    }
    fslockstat.begin()
    return true
}

fn give(state: u64) {
    fslockstat.end()
    atomic.lock_give(state, atomic.L_FS)
    if park.has_waiters((&releases[0]) as u64) {
        park.wake_all(state, (&releases[0]) as u64)
    }
}

#[inline]
fn nested(flags: u64) -> bool {
    return (flags & NESTED) != 0
}

fn enter(state: u64) -> u64 {
    let flags: u64 = save_irq()
    if mine(state) {
        return flags | NESTED
    }
    take(state)
    return flags
}

fn leave(state: u64, flags: u64) {
    if !nested(flags) {
        give(state)
    }
    restore_irq(flags)
}
