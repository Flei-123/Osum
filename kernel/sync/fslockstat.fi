profile kernel

export { begin, end, holds, cycles, longest, long_holds }

const LONG_HOLD_CYCLES: u64 = 300000

static mut started: u64 = 0
static mut hold_count: u64 = 0
static mut hold_cycles: u64 = 0
static mut hold_longest: u64 = 0
static mut hold_long: u64 = 0

#[inline]
fn now() -> u64 {
    var lo: u64 = 0
    var hi: u64 = 0
    asm("rdtsc", out("rax") & lo, out("rdx") & hi)
    return (hi << 32) | (lo & 0xFFFFFFFF)
}

fn begin() {
    started = now()
}

fn end() {
    let spent: u64 = now() - started
    hold_count = hold_count + 1
    hold_cycles = hold_cycles + spent
    if spent > hold_longest {
        hold_longest = spent
    }
    if spent >= LONG_HOLD_CYCLES {
        hold_long = hold_long + 1
    }
}

fn holds() -> u64 {
    return hold_count
}

fn cycles() -> u64 {
    return hold_cycles
}

fn longest() -> u64 {
    return hold_longest
}

fn long_holds() -> u64 {
    return hold_long
}
