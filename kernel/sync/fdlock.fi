profile kernel

import lib.modes.words_locks
import lib.kstate
import sync.atomic
import sync.irqlock

export { enter, leave }

fn enter(state: u64) -> u64 {
    if kstate.mode_on(state, words_locks.M_NOFDLOCK) {
        return irqlock.skip()
    }
    return irqlock.enter(state, atomic.L_FD)
}

fn leave(state: u64, flags: u64) {
    irqlock.leave(state, atomic.L_FD, flags)
}
