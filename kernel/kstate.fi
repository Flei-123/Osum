// ------------------------------------------------------------- scalars

const TICKS: u64 = 0 // timer interrupts since `sti`
const KEYS: u64 = 8 // keys seen
const TRAPS: u64 = 16 // interrupts of every kind
const HEAP_BASE: u64 = 24
const HEAP_END: u64 = 32
const HEAP_HEAD: u64 = 40 // first block header of the heap
const BITMAP: u64 = 48 // address of the frame bitmap
const BITMAP_FRAMES: u64 = 56 // how many frames it covers
const MEM_TOP: u64 = 64 // highest usable octet + 1
const MEM_USABLE: u64 = 72 // usable octets according to the memory map
const FRAMES_FREE: u64 = 80 // free frames right now
// RUNDE K17: DER MODUS IST KEIN WORT MEHR, SONDERN EIN VEKTOR.
// Bis hierher stand der ganze Modus in DIESEM einen Wort (Versatz 88),
// und achtzehn Runden haben sich daraus Bits genommen, bis vier uebrig
// waren. Seit dieser Runde liegt der Modus in einer eigenen kdata-Seite
// als Feld aus MODE_WORDS Woertern -- EIN WORT JE UNTERSYSTEM. Die
// Tafel, wer welches Wort hat, steht weiter unten bei den Modusbits;
// gelesen und geschrieben wird ausschliesslich ueber `mode_on` und
// `mode_add`, und ein Modusname ist ab jetzt ein BITINDEX (Wort * 64 +
// Bit), keine Maske mehr.
//
// MODE ist das erste Wort des Vektors und damit dasselbe Wort wie
// vorher: `kstate.get(state, kstate.MODE)` liefert weiter die Bits
// 0..63, und die Trap-Art aus der Befehlszeile steht weiter in den
// untersten drei davon. Der Skalar 88 ist seit dieser Runde FREI.
const MODE_OFF: u64 = 0x4C000 // die Seite des Modusvektors in kdata
const MODE_MAX: u64 = 0x1000
const MODE_WORDS: u64 = 16 // 16 * 64 = 1024 Bits, Platz bis 512 Woerter
const MODE: u64 = MODE_OFF // Wort 0 -- der Kern
const MODE_FREE: u64 = 88 // frei seit Runde K17 (war MODE)
const VECTORS: u64 = 96 // address of the table out of isr.s
const KEYLEN: u64 = 104 // octets in KEYBUF
const IDTR: u64 = 112 // 10 octets: limit + base for `lidt`
const GDT: u64 = 128
const TSS: u64 = 136
const KERNEL_END: u64 = 144
const LAST_TRAP: u64 = 152 // vector of the last interrupt
const KEYBUF: u64 = 256 // 64 octets of collected characters

// Round 62. Everything below belongs to the scheduler, the processes and
// the file system. KSTACK_CUR is the one offset that is not only read in
// Firn: `syscall_entry` in isr.s takes the kernel stack of the current
// task out of it, and the number 344 stands there a second time.
const CURRENT: u64 = 320 // index of the running task
const TASKS: u64 = 328 // how many slots of the table are in use
const NEXT_PID: u64 = 336 // the pid the next task gets
const KSTACK_CUR: u64 = 344 // kernel stack of the current task (isr.s!)
const SWITCHES: u64 = 352 // context switches since the start
const TRACE_LEN: u64 = 360 // octets in the trace
const KPML4: u64 = 368 // the address space of the kernel
const PREEMPT: u64 = 376 // 1 = the timer may switch tasks
const DISK: u64 = 384 // address of the RAM disk
const DISK_BLOCKS: u64 = 392 // its size in blocks
const CONSOLE_POS: u64 = 400 // how much of the console input was read
const CONSOLE_LEN: u64 = 408 // how much of it there is
const IDLE: u64 = 416 // index of the idle task
const SPAWNS: u64 = 424 // processes created
const FS_ROOT: u64 = 432 // inode of the root directory
const FS_READY: u64 = 440 // 1 = a file system is mounted
const KILLED: u64 = 448 // tasks killed by a fault
const SYSCALLS: u64 = 456 // system calls answered
const DISK_DEV: u64 = 464 // 0 = RAM disk, 1 = ATA

// Round K1. The console became a real one -- the keys of `kbd.fi` are a
// ring now, and KEYPOS says how much of it the shell has eaten. The rest
// belongs to the ELF loader.
const KEYPOS: u64 = 472 // keys handed to `read` on descriptor 0
const NX_OK: u64 = 480 // 1 = the processor honours the no-execute bit
const EXECS: u64 = 488 // programs started from the disk
const ELF_ERR: u64 = 496 // why the last load was refused (elf.R_*)
const ELF_BYTES: u64 = 504 // octets of image the last load copied
const ELF_PAGES: u64 = 512 // pages it mapped
const ELF_LOADS: u64 = 520 // PT_LOAD segments it laid down

// Round K4. EXCURSION is the one that is not a counter: it is 1 while the
// ring 3 EXCURSION of round 59 is running (`user.run`), and only then do
// the numbers 1 and 2 mean the two marks of that round instead of `write`
// and `open`. That excursion is a mode of the kernel, not a process --
// nothing else in the system can reach those two numbers.
const EXCURSION: u64 = 528
const FORKS: u64 = 536 // processes split in two
const EXECVES: u64 = 544 // images replaced in place
const PIPES: u64 = 552 // pipes created
const MAPS: u64 = 560 // pages handed out by brk and mmap
const OPENS: u64 = 568 // descriptors opened since the start

// ---------------------------------------------------------- Runde K9
//
// Vier Dinge, die jedes Unix-Programm stillschweigend voraussetzt und die
// dieser Kernel bis zu dieser Runde NICHT hatte: Signale, ein Terminal,
// eine Uhr und Zufall. Die Skalare dazu liegen ab 576 -- der Bereich
// darunter gehoert den Runden 59 bis K6 und wird nicht angefasst.
//
// DIE UHR (kernel/time.fi). TIME_BOOT ist die Wandzeit in Sekunden seit
// 1970, EINMAL beim Start aus der CMOS-Uhr gelesen; TIME_TSC0 der
// Zyklenzaehler zu genau diesem Zeitpunkt. Alles Weitere ist Rechnung:
// die monotone Uhr ist (tsc - TIME_TSC0) / TIME_KHZ, die Echtzeituhr ist
// TIME_BOOT plus die monotone. TIME_LAST ist der zuletzt herausgegebene
// monotone Wert -- die Zusage "laeuft nie rueckwaerts" ist genau diese
// eine Zahl, und TIME_BACK zaehlt, wie oft sie eingreifen musste.
const TIME_BOOT: u64 = 576 // Sekunden seit 1970 beim Start
const TIME_TSC0: u64 = 584 // Zyklenzaehler zum selben Zeitpunkt
const TIME_KHZ: u64 = 592 // Zyklen je Millisekunde, 0 = ungemessen
const TIME_LAST: u64 = 600 // zuletzt herausgegebene monotone Nanosekunde
const TIME_BACK: u64 = 608 // wie oft die Klammer greifen musste
const TIME_CALLS: u64 = 616 // Aufrufe von clock_gettime

// DER ZUFALL (kernel/rand.fi).
const RAND_READY: u64 = 624 // 1 = der Generator ist gesaet
const RAND_FIXED: u64 = 632 // GEGENPROBE: 1 = jedes Oktett ist 0x5A
const RAND_BYTES: u64 = 640 // Oktette, die getrandom herausgegeben hat
const RAND_STIRS: u64 = 648 // Ereignisse, die in den Sammler gingen
const RAND_HW: u64 = 656 // 1 = RDSEED/RDRAND war vorhanden

// DIE SIGNALE (kernel/signal.fi).
const SIG_SENT: u64 = 664 // abgeschickt
const SIG_DELIVERED: u64 = 672 // wirklich zugestellt
const SIG_CAUGHT: u64 = 680 // an eine Behandlungsroutine in Ring 3
const SIG_DEFAULT: u64 = 688 // im Standardverhalten erledigt
const SIG_STOPS: u64 = 696 // angehaltene Prozesse

// DIE TERMINALSCHICHT (kernel/tty.fi).
const TTY_READY: u64 = 704 // 1 = tty.init ist gelaufen
const TTY_SIGS: u64 = 712 // Signale, die ein Steuerzeichen ausgeloest hat
const TTY_CHARS: u64 = 720 // Zeichen durch die Zeilendisziplin
const K9_MODE: u64 = 728 // die Woerter der Kommandozeile dieser Runde

// --------------------------------------------------------- Runde K10
//
// Zwei Portierungen aus OrientOS' Rust-Kernel, die beide Skalare
// brauchen und keinen eigenen Bereich: die Schutzbits SMEP/SMAP in CR4
// (`guard.fi`, aus `arch/x86_64/user.rs`) und das Boot-Modul samt
// Pruefsumme (`bootmod.fi`, aus `kcore/initramfs.rs`). Der Bereich ab
// 736 war frei -- die Runden 59 bis K9 enden bei 728.
const SMEP_OK: u64 = 736 // 1 = CR4.SMEP ist auf dieser Maschine an
const SMAP_OK: u64 = 744 // 1 = CR4.SMAP ist an
const GUARD_MODE: u64 = 752 // nosmep/nosmap/smapraw/smepraw
const SMAP_WINDOWS: u64 = 760 // wie oft `stac` das Fenster geoeffnet hat

// Die Informationsstruktur des Laders, aufgehoben: `bootmod.stage` und
// jeder spaetere Leser brauchen sie, und `kernel_main` hat sie nur als
// Argument.
const MBI: u64 = 768
const MOD_BASE: u64 = 776 // Anfang des ersten Boot-Moduls
const MOD_BYTES: u64 = 784 // seine Laenge in Oktetten
const MOD_CRC: u64 = 792 // die gerechnete Pruefsumme
const MOD_WANT: u64 = 800 // die verlangte (modcrc=), 0 = keine Vorgabe
const MOD_OK: u64 = 808 // 1 = vorhanden und Summe stimmt
const MOD_MODE: u64 = 816 // die Woerter dieser Runde (modfs)
const GUARD_APS: u64 = 824 // weitere Prozessoren mit gesetzten Schutzbits

// --------------------------------------------------------- Runde K14
//
// DIE VFS-SCHICHT. Bis zu dieser Runde kannte Osum genau EIN
// Dateisystem, und `FS_READY` oben war die ganze Buchfuehrung darueber:
// eine Null hiess "nichts eingehaengt", eine Eins "die eine Platte ist
// da". Ein zweites Dateisystem hat in dieser Zahl keinen Platz.
//
// Die Skalare hier zaehlen, was die Schicht tut, und sie sind der
// Grund, warum die Zusagen dieser Runde messbar sind statt behauptet:
// ein Lauf, in dem `VFS_CROSSINGS` null bleibt, hat KEINE
// Einhaengegrenze ueberquert, egal was er sonst meldet.
//
//   VFS_READY      1 = `vfs.init` ist gelaufen
//   VFS_MOUNTS     wie viele Einhaengepunkte gerade stehen
//   VFS_LOOKUPS    aufgeloeste Pfade
//   VFS_CROSSINGS  Pfade, die dabei eine Einhaengegrenze ueberquert
//                  haben (also NICHT auf der Wurzel landeten)
//   VFS_OPS        Verrichtungen, die ueber eine Ops-Tafel gingen
//   VFS_INDIRECT   davon die, die ein ECHTER indirekter Aufruf waren
//                  (`call *rax`) -- die beiden muessen gleich sein
//   DISK2_BLOCKS   die ZWEITE Platte (ATA-Sklave am ersten Bus): ihre
//   DISK2_DEV      Groesse in Bloecken und ihre Geraetenummer. Die
//                  erste Platte steht in DISK/DISK_BLOCKS/DISK_DEV und
//                  bleibt, was sie war -- ein Dateisystem mehr darf der
//                  bestehenden Platte nichts wegnehmen.
const K14_MODE: u64 = 832 // die Woerter der Kommandozeile dieser Runde
const VFS_READY: u64 = 840
const VFS_MOUNTS: u64 = 848
const VFS_LOOKUPS: u64 = 856
const VFS_CROSSINGS: u64 = 864
const VFS_OPS: u64 = 872
const VFS_INDIRECT: u64 = 880
const DISK2_BLOCKS: u64 = 888
const DISK2_DEV: u64 = 896

// ------------------------------------------------- RUNDE INSTALL
//
// DREI WOERTER, UND SIE SIND DER GANZE ZUSTAND, DEN "DIE WURZEL LIEGT
// AUF EINER PARTITION" IM KERN BRAUCHT.
//
//   DISK_FIRST    der erste Block der WURZEL auf ihrem Geraet. Bis zu
//                 dieser Runde war das immer 0, und `fs.fi` rechnete
//                 deshalb in absoluten Blocknummern der Platte. Steht
//                 hier eine Zahl, addiert `blk.read`/`blk.write` sie --
//                 und `fs.fi` aendert sich um KEINE Zeile. Genau dafuer
//                 gibt es die Schnittstelle in `blk.fi`; der Kommentar
//                 in `ofs.fi` sagt seit K14, dass der Tag kommt, an dem
//                 OFS auf einer Partition liegt.
//   DISK1_BLOCKS  wie viele Sektoren die ERSTE ATA-Platte wirklich hat,
//                 aus IDENTIFY (0xEC) und nicht aus einer Annahme. Bis
//                 hierher gab `blk.blocks_on(DEV_ATA)` die Groesse der
//                 WURZEL zurueck -- fuer ein `/dev/hda`, auf das ein
//                 Installationsprogramm eine Partitionstafel schreiben
//                 soll, ist das die falsche Zahl.
//   ROOT_PART     der Eintrag der Partitionstafel, aus dem die Wurzel
//                 kommt (16 = keine). Nur zum Berichten -- aber der
//                 Testlauf liest ihn zurueck.
const DISK_FIRST: u64 = 904
const DISK1_BLOCKS: u64 = 912
const ROOT_PART: u64 = 920

// --------------------------------------------------------- the regions

const IDT_OFF: u64 = 0x1000
const BITMAP_OFF: u64 = 0x2000
const BITMAP_BYTES: u64 = 0x4000
const PT_OFF: u64 = 0x6000

// Round 62, widened in round K4: a task record is 512 octets now. What
// filled the last eight of the old 256 was `T_FAULTS`; a process with a
// program break, an mmap area and a descriptor table needs more, and a
// record that is a power of two keeps the arithmetic of `task_at` a shift.
// The table therefore covers 0x8000..0xC000, and the trace and the console
// moved out of its way to the end of the data area.
// ================== RUNDE MERGE-2: DER AUFGABENSATZ WAECHST UND ZIEHT UM.
//
// Er war voll. 512 Oktette, belegt bis 503, und ZWEI Runden brauchten
// gleichzeitig das letzte Wort 504: POLL fuer `T_POLLSEQ` und MULTIUSER
// fuer `T_NGROUPS`. Beide haben in ihrem eigenen Quelltext ausgerechnet,
// dass 504 das letzte freie ist, und beide hatten recht.
//
// 1024 STATT 512, UND NICHT 576 -- DAS IST GEMESSEN UND NICHT GESCHMACK.
// 576 waere die sparsame Zahl gewesen (acht neue Woerter, 2 KiB mehr).
// Sie hat 200 Zyklen JE SYSTEMAUFRUF gekostet, und der Grund steht in
// `sched.rec`: die Adresse eines Satzes ist `TASK_OFF + i * TASK_BYTES`.
// Solange TASK_BYTES eine Zweierpotenz ist, ist das eine Schiebeoperation;
// 576 ist keine, und daraus wird eine Multiplikation -- auf JEDEM Weg in
// den Kernel. `tools/handle/run.sh` hat es sofort gemeldet:
//
//     getpid  352 -> 548 Zyklen      lseek  562 -> 761 Zyklen
//
// Beide um denselben festen Betrag, und `getpid` ist von dieser Runde
// gar nicht angefasst. Mit 1024 ist es wieder eine Schiebeoperation.
// Das kostet 32 * 512 = 16 KiB statt 2 KiB -- in einem Bereich, in dem
// nach Merge 06 rund 90 KiB frei sind -- und gibt 64 neue Woerter statt
// acht.
//
// UMZIEHEN MUSS ER DABEI, weil er nicht wachsen kann, wo er steht:
// 0x8000 + 32 * 1024 waere 0x10000, und bei 0xC000 faengt BLOCK_OFF an.
// Statt vier Bereiche darunter zu verschieben, geht der Satz in den
// Raum, den Merge 06 geschaffen hat (KDATA_SIZE 0xA0000): 0x88000 bis
// 0x90000. Angefasst wird dafuer EINE Zeile -- jeder Zugriff geht
// ueber `kstate.TASK_OFF + i * kstate.TASK_BYTES` (`sched.rec`), und
// die zwei Schleifen, die den Satz nullen, rechnen mit
// `TASK_BYTES / 8`. `tools/kernel/memmap.py` rechnet die neue Lage nach.
//
// 0x8000 bis 0xC000 sind danach FREI -- 16 KiB am Stueck, das groesste
// zusammenhaengende Loch der Karte.
const TASK_OFF: u64 = 0x88000 // the task table
const TASK_BYTES: u64 = 1024 // one slot
const MAX_TASKS: u64 = 32 // 32 * 1024 = 32 KiB
const TRACE_OFF: u64 = 0x25000 // who ran when, one octet per turn
const TRACE_MAX: u64 = 4096
const CONSOLE_OFF: u64 = 0x26000 // what `read` on descriptor 0 delivers
const CONSOLE_MAX: u64 = 4096
const BLOCK_OFF: u64 = 0xC000 // what a system call copies to and fro
const BLOCK_MAX: u64 = 4096
const NAME_OFF: u64 = 0xD000 // paths out of ring 3
const NAME_MAX: u64 = 4096
const FS_OFF: u64 = 0xE000 // the scratch blocks of the file system
const FS_MAX: u64 = 4096

// Round K1. 64 octets of ELF header plus at most sixteen program headers
// of 56 is 960 -- one page holds the whole front of a program file.
const ELF_OFF: u64 = 0xF000 // ELF header and program headers
const ELF_MAX: u64 = 4096

// ROUND K4 MOVED THESE TWO, and the reason is a bug that was in the tree
// and had not gone off yet: round K1 put them at 0x10000 and 0x11000, and
// round K2 put the PCI DEVICE TABLE at 0x10000 as well (`pci.K2_OFF`, two
// pages, plus a page of counters at 0x12000). Both rounds were right about
// the area being free when they were written, and nobody noticed that they
// had picked the same page. A run that reads its PCI bus and then starts a
// program off the disk would have had the argument block of `exec` write
// over the device table. The regions of every round are listed in one
// place from here on -- this file -- and the data area grew to 192 KiB so
// that there is room to be careful with (`kernel/boot.s`).
const EARG_OFF: u64 = 0x27000 // the arguments of `exec`, kernel side
const EARG_MAX: u64 = 4096
const LOAD_OFF: u64 = 0x28000 // one page of file data while loading
const LOAD_MAX: u64 = 4096

// Round K5. Everything a SECOND processor makes necessary.
//
// WHERE THESE FOUR LIE AND WHY IT COST AN HOUR. The list at the head of
// this file stops at 0x0F000, and the obvious reading is that everything
// above it is free. It is not: `pci.fi` puts its device table at 0x10000
// and its counters at 0x12000, and `nvme.fi` puts four queues, an
// identify page and two measurement buffers between 0x14000 and 0x1B000
// -- all of them offsets in this same area, none of them named here. The
// first version of round K5 put the per-core records at 0x12000, wrote
// the index of the running task over the address of the local APIC, and
// the machine stopped after exactly one timer interrupt: the
// end-of-interrupt went to address zero. So: 0x1B000 upwards, which is
// what is really left, and the map below now says so.
//
//   0x10000  pci.fi: the device table (8 KiB)
//   0x12000  pci.fi: the counters of round K2, and apic.fi/nvme.fi in it
//   0x14000  nvme.fi: admin and I/O queues, identify, two buffers
//   0x1B000  round K5, from here on
const CPU_OFF: u64 = 0x1B000 // one record per processor
const CPU_BYTES: u64 = 256
const MAX_CPUS: u64 = 8 // 8 * 256 = 2 KiB
const LOCK_OFF: u64 = 0x1B800 // the spin locks, see atomic.fi
const LOCK_BYTES: u64 = 64 // one cache line each, on purpose
const LOCK_COUNT: u64 = 8
const SMP_OFF: u64 = 0x1C000 // the scalars of smp.fi and cpu.fi
const SMP_MAX: u64 = 4096
// The task table is full: 248 + 8 = 256, and TASK_BYTES is 256. What
// round K5 has to note per TASK therefore goes into a second, parallel
// table rather than into a bigger record -- growing the record to 512
// would push the task table into the trace at 0xA000.
const TCPU_OFF: u64 = 0x1BA00 // 32 slots of 32: which core runs this task
const TCPU_BYTES: u64 = 32

// The scalars inside SMP_OFF.
const SMP_LAPIC: u64 = 0 // address of the local APIC window
const SMP_COUNT: u64 = 8 // processors the firmware reported
const SMP_NOLOCK: u64 = 16 // 1 = every lock is a no-op (counter-check)
const SMP_MODE: u64 = 24 // the words of the command line this round reads

// Round K6. The WORKING DIRECTORY of a task, as text: 128 octets per
// task, 32 tasks, exactly one page (`kernel/uio.fi`).
//
// WHERE IT LIES, AND WHERE IT DOES NOT. Round K6 wrote 0x1C000 into this
// file, and 0x1C000 is where round K5 put the scalars of `smp.fi` --
// both rounds read the map above at a moment when it stopped at 0x0F000
// and both concluded the page was free. It is not, and the map now says
// so. What IS free is the area behind the page of file data that round
// K4 moved to 0x28000, and that is where this page went.
// RUNDE OFS3: DIESE SEITE IST UMGEZOGEN, von 0x29000 nach 0x60000, und
// aus einer Seite sind vier geworden. Der Grund ist eine Zahl: `uio.SLOT`
// war 128 Oktette je Aufgabe, davon 78 fuer das Arbeitsverzeichnis -- und
// ein einzelner DATEINAME darf in OFS 3 schon 255 Zeichen haben. Ein
// Arbeitsverzeichnis, das kuerzer ist als ein Name darin, ist keine
// Grenze, sondern eine Falle: `cd` in ein Verzeichnis mit langem Namen
// haette den Pfad stumm abgeschnitten, und das naechste `ls` haette ein
// anderes Verzeichnis gezeigt.
//
// Bleiben konnte sie nicht: hinter 0x29000 liegt seit Runde K3 die
// Handle-Tafel von `cap.fi` (0x2A000..0x2E000). Der neue Platz liegt
// hinter der alten Grenze von `kdata`, und `kdata` waechst deshalb
// mit -- so wie in Runde K12 und in Runde K18.
const UIO_OFF: u64 = 0x60000
const UIO_MAX: u64 = 0x4000

// Round K4. Everything a POSIX process owns besides its memory.
//
//   OFILE    the OPEN FILE table of the system, 64 entries of 64 octets.
//            An entry is what `open` produced: a kind, an inode, a
//            position, the flags -- and a reference count, because `dup2`
//            and `fork` make two descriptors of one entry. Entries 0, 1
//            and 2 are the console and belong to nobody.
//   FDTAB    the DESCRIPTOR table per task: 32 tasks * 16 descriptors *
//            8 octets. A descriptor is an index into OFILE, plus one, so
//            that a zero can go on meaning "closed".
//   CTX      one saved user context per task, 128 octets: what `fork`
//            hands the child (`isr.s`, `user_resume`).
//   PIPEBUF  eight pipes of 512 octets.
//   PIPEHDR  their read and write positions and their two reference
//            counts -- a pipe whose writers are all gone reports the end
//            of the input, and one whose readers are gone gives -EPIPE.
const OFILE_OFF: u64 = 0x20000
const OFILE_MAX: u64 = 4096
const FDTAB_OFF: u64 = 0x21000
const FDTAB_MAX: u64 = 4096
const CTX_OFF: u64 = 0x22000
const CTX_MAX: u64 = 4096
const PIPEBUF_OFF: u64 = 0x23000
const PIPEBUF_MAX: u64 = 4096
const PIPEHDR_OFF: u64 = 0x24000
const PIPEHDR_MAX: u64 = 4096

// Die Handle-Tabellen von `cap.fi` -- die Capability-Schicht, die aus
// OrientOS' `libs/osum-abi-native/` hierher portiert wurde. 32 Tabellen zu
// je 16 Plaetzen zu je 32 Oktetten (Generation, Art, Rechte, Objekt) sind
// 16 KiB; die Wuerfelwerte daneben eine Seite. Sie liegen bewusst NEBEN
// FDTAB und nicht darin: ein Deskriptor ist Umgebungsautoritaet, ein
// Handle ist das Gegenteil davon, und die beiden ABIs sollen sich nicht
// gegenseitig ihre Tabellen umbauen.
const CAP_OFF: u64 = 0x2A000
const CAP_MAX: u64 = 0x4000
const CAP_NONCE_OFF: u64 = 0x2E000
const CAP_NONCE_MAX: u64 = 4096

// ---------------------------------------------------- Runde K9: Bereiche
//
// Drei neue Bereiche, und sie liegen HINTER allem bisherigen. Die Karte
// oben in dieser Datei ist die einzige Stelle, an der steht, wem welche
// Seite gehoert -- die Runden K4, K5 und K6 haben sich jede einmal
// dieselbe Seite genommen, weil sie nicht gepflegt wurde.
//
//   SIG   die Behandlungsroutinen: 32 Aufgaben * 32 Signale * 24 Oktette
//         (Routine, Flaggen, Maske) = 24576 Oktette = sechs Seiten.
//   TTY   die Terminals: acht Stueck zu je 2048 Oktetten. Ein Terminal
//         sind zwei Ringe (Eingang roh, Zeile fertig) und sein Zustand.
//   RAND  Schluessel, Zaehler, Sammler und Ausgabepuffer des Generators.
//
// Der Datenbereich waechst dafuer von 192 KiB auf 256 KiB -- `boot.s`
// haelt dieselbe Zahl ein zweites Mal, und die beiden muessen gleich
// sein.
const SIG_OFF: u64 = 0x2F000
const SIG_MAX: u64 = 0x8000
// Innerhalb von SIG: erst die Behandlungsroutinen, dann die geretteten
// Zusammenhaenge. Ein Signalrahmen traegt den VOLLSTAENDIGEN Zustand in
// der Form, die `iretq` zurueckgibt (22 Woerter), und `sigreturn` kopiert
// ihn hier durch -- ein Zeiger von Ring 3 wird nie unmittelbar gefolgt.
const SIGCTX_OFF: u64 = 0x35000 // 32 Aufgaben * 192 Oktette
const SIGCTX_BYTES: u64 = 192
const TTY_OFF: u64 = 0x37000
const TTY_MAX: u64 = 0x4000
const RAND_OFF: u64 = 0x3B000
const RAND_MAX: u64 = 4096

// ------------------------------------------- Runde K7B: der Bildschirm
//
// DER BEREICH, DER HIER BIS ZUM VERSCHMELZEN NICHT STAND -- und das war
// der ganze Fehler. Runde K7 legte den Zustand des Rahmenpuffers und den
// ZEICHENSATZ auf 0x2F000; sie las die Karte oben, fand dort
// CAP_NONCE_OFF als letzten Bereich und 0x30000 als damaliges
// KDATA_SIZE, und schrieb ihre Konstante in `fb.fi` statt hierher.
// Runde K9 las dieselbe Karte, sah 0x2F000 unbelegt -- weil es hier
// nicht stand -- und legte die SIGNALTABELLE dorthin.
//
// Beide Zweige waren fuer sich gruen. Der Textverschmelzer sah keine
// Kollision, weil sich keine gemeinsame Zeile ueberschnitt, nur zwei
// Adressen. Auf dem Schirm sah man es so: der Signalblock der Aufgabe 1
// (SIG_OFF + 1 * 32 * 24 = 0x2F300, 768 Oktette) loeschte die Oktette
// 0x300..0x600 des Zeichensatzes, also die Glyphen 0x40..0x6F -- '@' bis
// 'o'. Ziffern und Satzzeichen standen noch da, Buchstaben waren weg.
//
// Der Bereich liegt jetzt HINTER RAND, er steht in dieser Karte, und
// `tools/kernel/memmap.py` rechnet bei jedem Testlauf nach, dass sich
// keine zwei Bereiche ueberschneiden. `fb.fi` fuehrt denselben Wert ein
// zweites Mal (Firn setzt keine Konstante eines anderen Moduls in einen
// `const` ein); dass die beiden gleich sind, prueft dasselbe Programm.
const FB_OFF: u64 = 0x3C000
const FB_MAX: u64 = 4096

// ------------------------------------- Runde K11: Tastatur und Terminal
//
// EINE Seite fuer zwei Zustaende, die es vorher nicht gab: die
// Umschalt-/Steuerungstasten der PS/2-Tastatur (`kernel/kbd.fi`) und der
// Fluchtfolgenautomat der Bildschirmkonsole (`kernel/ansi.fi`). Beides
// ist wenige Woerter gross und haette in die Skalare oben gepasst -- es
// steht trotzdem als eigener Bereich hier, weil `tools/kernel/memmap.py`
// nur Bereiche gegeneinander rechnen kann und weil die naechste Runde
// dann sieht, dass 0x3D000 vergeben ist. Genau diese Zeile hat in Runde
// K7 gefehlt.
//
// Runde K10 laeuft parallel an fb.fi/font.fi und am Fensterdienst; die
// naechste freie Seite fuer sie ist 0x3E000.
const K11_OFF: u64 = 0x3D000
const K11_MAX: u64 = 4096

// Die Tastatur: was gerade gedrueckt gehalten wird.
const KB_SHIFT: u64 = 0x00
const KB_CTRL: u64 = 0x08
const KB_EXT: u64 = 0x10 // das Vorzeichen 0xE0 ist gekommen
const KB_SEQS: u64 = 0x18 // Fluchtfolgen, die die Tastatur erzeugt hat

// RUNDE TILING: DIE ALT-TASTE UND DER RING DER TASTENKUERZEL.
//
// Ein Fensterserver mit einem Baum braucht einen Modifikator, der NICHT
// in die Anwendung durchgereicht wird -- i3 nennt ihn `$mod` und legt
// ihn auf Alt oder auf die Windows-Taste. Dieser Kernel kannte bis
// hierher Umschalt und Steuerung; Steuerung geht an die Shell (STRG-C),
// also bleibt Alt.
//
// WARUM EIN EIGENER RING UND NICHT `deliver`: eine Taste mit Alt ist
// KEINE Eingabe fuer die Anwendung. Sie darf nicht in der
// Zeilendisziplin landen, sonst steht `h` in der Shell, wenn man das
// Fenster nach links wechselt. `kbd.irq` legt sie deshalb hier ab, und
// `wm.poll` holt sie ab -- dieselbe Richtung wie beim Zeigegeraet, und
// `kbd.fi` muss den Fensterserver dafuer nicht kennen.
const KB_ALT: u64 = 0x58 // Alt wird gehalten
const KB_HHEAD: u64 = 0x60
const KB_HTAIL: u64 = 0x68
const KB_HOTS: u64 = 0x70 // wie viele Kuerzel insgesamt kamen
const KB_HOT: u64 = 0xC0 // 16 Plaetze zu zwei Oktetten: Zeichen, Modifikatoren

// RUNDE I18N: DIE TASTATURBELEGUNG UND DIE ZWEITE ZUSATZTASTE. Bis
// hierher kannte dieser Kernel GENAU EINE Belegung, die amerikanische,
// fest verdrahtet in zwei Zeichenkettenliteralen in `kernel/kbd.fi`.
// Auf einer deutschen Tastatur ist damit weder ein Umlaut noch das
// Klammeraffenzeichen erreichbar.
//
// ALT (KB_ALT, oben) ist die LINKE Alt-Taste, Abtastcode 0x38 -- der
// Modifikator der Fensterkuerzel aus Runde TILING. ALTGR ist die
// RECHTE (0xE0 0x38) und auf einer deutschen Tastatur die dritte
// Ebene: AltGr+Q ist @, AltGr+E das Eurozeichen, AltGr+7 die
// geschweifte Klammer auf. Zwei Felder und nicht eines, weil es zwei
// verschiedene Tasten sind.
//
// MERGE: die Runde I18N hatte 0x60, 0x68 und 0x70 gewaehlt; dort liegen
// seit der Runde TILING Kopf, Schwanz und Zaehler des Kuerzelrings.
// Diese drei ziehen deshalb auf 0x78, 0x80 und 0x88 -- der Ring selbst
// faengt erst bei 0xC0 an.
const KB_ALTGR: u64 = 0x78
const KB_LAYOUT: u64 = 0x80 // 0 = us, 1 = de
const KB_SWITCH: u64 = 0x88 // wie oft umgeschaltet wurde -- eine Messung

// ROUND NETVIEW, THIRD ADDENDUM: THE SUPER KEY AND ONE GLOBAL HOTKEY.
//
// MERGE: this round took 0x58..0x70. There sit KB_ALT (round TILING,
// and it means the same thing this round means by "modifier") and the
// head, tail and counter of TILING's hotkey ring, and 0x78..0x88 are
// round I18N's layout words. These four move to 0x90..0xA8 -- the ring
// itself does not start before 0xC0, and ENV_BUF not before 0x200.
//
//   KB_SUPER  is the Windows key held down right now -- a modifier,
//             exactly like KB_SHIFT and KB_CTRL beside it.
//   HK_SEQ    counts hotkeys. A reader compares it with the number it
//             saw last time; that is the whole protocol, and it needs
//             no acknowledgement and cannot lose a press to a race
//             between two readers.
//   HK_KEY    which character it was.
//   HK_NS     the monotone clock AT THE MOMENT OF THE PRESS. It is
//             here so that "how long from the key to the panel" can be
//             measured against ONE clock instead of subtracting two
//             serial lines written by two programs.
const KB_SUPER: u64 = 0x90
const HK_SEQ: u64 = 0x98
const HK_KEY: u64 = 0xA0
const HK_NS: u64 = 0xA8

// Der Terminalautomat der Bildschirmkonsole.
const AN_STATE: u64 = 0x20 // 0 = Text, 1 = nach ESC, 2 = in ESC[
const AN_NPAR: u64 = 0x28
const AN_PRIV: u64 = 0x30 // das '?' in ESC[?25l
const AN_SEQS: u64 = 0x38 // wie viele Folgen ausgefuehrt wurden
const AN_REV: u64 = 0x40 // 1 = umgekehrte Darstellung
const AN_PAR: u64 = 0x80 // acht Zahlen zu acht Oktetten
const AN_MAXPAR: u64 = 8

// DIE UMGEBUNG (Runde K11). Runde K6 hat `export` geschrieben und in die
// Doku gesetzt: "Die Markierung erreicht kein Kind: `exec` hat in diesem
// Kernel keine Umgebung. Es steht hier, damit die Shell das Wort hat und
// die Runde danach etwas, woran sie es haengen kann." Das ist diese
// Runde. Ein Prozess setzt seinen Block mit SYS_OSUM_SETENV, und
// `elf.write_args` legt ihn jedem Kind auf die Argumentseite.
const ENV_N: u64 = 0x48 // wie viele Zeichenketten
const ENV_LEN: u64 = 0x50 // wie viele Oktette zusammen
const ENV_BUF: u64 = 0x200 // NAME=wert, jede mit einer Null dahinter
const ENV_MAX: u64 = 3584
// ------------------------------------------- Runde K10: die Oberflaeche
//
// Drei Bereiche, und sie liegen in den beiden Luecken, die Runde K7B
// ausdruecklich als frei ausgewiesen hat (0x1D000..0x20000, zwoelf KiB,
// und 0x3D000..0x40000, noch einmal zwoelf). Der Prueflauf
// `tools/kernel/memmap.py` rechnet sie ab dieser Runde mit -- eine
// Konstante, die NICHT hier steht, ist der Fehler, an dem Runde K7
// gescheitert ist.
//
//   MOUSE  der Zustand des Zeigegeraets: Paketpuffer, Position, Tasten,
//          Rad, Zaehler (kernel/ps2m.fi).
//   WM     der Fensterserver: Skalare, die Fenstertafel (8 Fenster zu
//          256 Oktetten) und je Fenster ein Ereignisring
//          (kernel/wm.fi).
//   TTF    die Zeichensatzplaetze des Schriftlesers. Der GLYPHENSPEICHER
//          liegt NICHT hier, sondern in einem eigenen Lauf aus Rahmen --
//          er ist ein halbes Megabyte gross und `kdata` sind 256 KiB
//          insgesamt (kernel/ttf.fi).
const MOUSE_OFF: u64 = 0x1D000
const MOUSE_MAX: u64 = 4096
// MERGE K10/K11: 0x3D000 war beim Bau dieser Runde frei -- Runde K11 hat
// sie gleichzeitig genommen (K11_OFF). Der Fensterserver zieht deshalb in
// die zweite Luecke, die K7B ausgewiesen hat: 0x1E000..0x20000, acht KiB,
// direkt hinter MOUSE. tools/kernel/memmap.py rechnet die Ueberschneidung
// nach -- genau dafuer steht sie dort.
const WM_OFF: u64 = 0x1E000
const WM_MAX: u64 = 0x2000
const TTF_OFF: u64 = 0x3F000
const TTF_MAX: u64 = 4096

// ------------------------------------------- Runde K13: die Benutzer
//
// ZWEI SEITEN, 0x41000 und 0x42000, und sie sind die ersten hinter dem
// Bereich des Hypervisors (0x40000). Runde K12 hat `kdata` auf 0x50000
// wachsen lassen und ausdruecklich geschrieben, dass die naechste Runde
// bei 0x41000 anfaengt -- das ist diese. Der Bereich steht in
// `tools/kernel/memmap.py`, und der Kartenpruefer rechnet nach, dass er
// sich mit keinem der 43 anderen ueberschneidet.
//
// WAS DRIN LIEGT: nur ZAEHLER und drei Merker. Die uid/gid eines
// Prozesses liegen NICHT hier, sondern im Aufgabensatz (`sched.fi`,
// T_UID..T_UMASK) -- ein Prozessattribut gehoert zum Prozess, und der
// Satz hat seit Runde K4 512 Oktette, von denen 384 belegt waren. Die
// Rechte einer DATEI liegen im Inode auf der Platte (`fs.fi`), nicht im
// Speicher. Was bleibt, ist das, was eine MESSUNG braucht: wie oft
// gefragt wurde, wie oft nein herauskam, wie oft eine Kennung gewechselt
// hat. Ohne diese Zahlen ist die Zusage "es wird geprueft" eine
// Behauptung.
//
// Die zweite Seite ist noch leer und ausdruecklich reserviert: sie steht
// in der Karte, damit die naechste Runde bei 0x43000 anfaengt und nicht
// hier.
const K13_OFF: u64 = 0x41000
const K13_MAX: u64 = 0x2000

// Die Zaehler, Offsets INNERHALB von K13_OFF.
const U_CHECKS: u64 = 0x00 // Rechtefragen, die durch perm.may gingen
const U_DENIED: u64 = 0x08 // davon abgelehnt
const U_SETIDS: u64 = 0x10 // erfolgreiche setuid/setgid/setres*
const U_CHMODS: u64 = 0x18 // chmod/fchmod/fchmodat
const U_CHOWNS: u64 = 0x20 // chown/fchown/fchownat
const U_SUIDEXEC: u64 = 0x28 // exec ueber eine Datei mit setuid-Bit
const U_FSVER: u64 = 0x30 // Fassung des eingehaengten OFS (1 oder 2)
const U_INITSLOT: u64 = 0x38 // Platz + 1 des Prozesses 1, 0 = keiner
const U_ORPHANS: u64 = 0x40 // Kinder, die an den Prozess 1 fielen
const U_INITOK: u64 = 0x48 // 1 = /sbin/init wurde gestartet
const U_ACPI: u64 = 0x50 // was die ACPI-Abschaltung gefunden hat
const U_LASTDENY: u64 = 0x58 // (ino << 8) | gewuenschte Rechte
// RUNDE INIT: welcher Weg den Neustart ausgeloest hat.
//   0 nichts versucht · 1 RESET_REG aus der FADT · 2 Anschluss 0xCF9
//   3 der Tastaturschaltkreis (8042)
// Die Zahl steht hier und nicht in einer neuen Seite: die zweite Seite
// des Bereichs (0x42000) traegt den Puffer von SYS_OSUM_USERINFO, und
// die erste war bis 0x58 belegt. Ein einzelner Zaehler bekommt keine
// eigene Seite.
const U_RESET: u64 = 0x60

// RUNDE K13. Fuenf der sechs sind GEGENPROBEN -- ohne sie beweist die
// Runde nichts:
//
//   `k13`      den Selbsttest dieser Runde in Ring 3 laufen lassen.
//   `noperm`   die Rechtepruefung sagt IMMER ja. Der Zugriff, der
//              scheitern MUSS, gelingt dann -- und genau daran haengt,
//              dass die Pruefung ueberhaupt etwas tut.
//   `initsh`   der Notweg: der Kernel startet /bin/sh statt /sbin/init,
//              so wie vor dieser Runde. Er ist geprueft, weil ein
//              System, das nur noch ueber init startet, bei einem
//              kaputten init gar nicht mehr startet.
//   `nosuid`   das setuid-Bit wird nicht beachtet.
//   `noacpi`   nicht ueber ACPI abschalten, sondern ueber den Ausgang
//              des Pruefstands. Die beiden sind am Beendigungscode von
//              QEMU zu unterscheiden (0 gegen 21), und das ist der
//              Beweis, dass die Abschaltung wirklich ACPI war.
//   `ofsv2raw` ein Abbild der alten Fassung mit den Regeln der neuen
//              lesen. Die Rechte werden dann aus Blockzeigern gelesen
//              und sind Unsinn -- die Gegenprobe zur Fassungsnummer im
//              Superblock.
//   `zombie`   ein Prozess, der ein Kind hinterlaesst und ohne `wait`
//              endet. Damit ist zu messen, was init einsammelt.
const M_K13: u64 = 128 // Wort 2, Bit 0
const M_NOPERM: u64 = 129 // Wort 2, Bit 1
const M_INITSH: u64 = 130 // Wort 2, Bit 2
const M_NOSUID: u64 = 131 // Wort 2, Bit 3
const M_NOACPI: u64 = 320 // Wort 5, Bit 0
const M_FORCEV2: u64 = 132 // Wort 2, Bit 4
const M_ZOMBIE: u64 = 133 // Wort 2, Bit 5
// RUNDE INIT, GEGENPROBE: `waitfirst` stellt das alte `wait4` wieder
// her, das den ERSTEN Prozess in der Aufgabentafel nahm, dessen
// Elternteil der Rufer ist -- egal in welchem Zustand. Lebte der noch,
// meldete `wait4` mit WNOHANG "nichts Neues" und der Zombie DAHINTER
// wurde nie abgeholt. Genau das ist der Fehler, den diese Runde
// gefunden hat, und ohne dieses Wort waere die Behebung eine
// Behauptung.
const M_WAITOLD: u64 = 134 // Wort 2, Bit 6
// ------------------------------------------- Runde K14: die VFS-Schicht
//
// DREI SEITEN, UND SIE STEHEN HIER, WEIL GENAU DAS DIE STELLE IST, AN
// DER DIESES PROJEKT VIERMAL DENSELBEN FEHLER GEMACHT HAT (siehe den
// Kopf von `tools/kernel/memmap.py`). Der Auftrag dieser Runde hat den
// Bereich 0x43000..0x46000 zugeteilt, weil weitere Runden GLEICHZEITIG
// an diesem Baum arbeiten; nichts ausserhalb davon wird genommen.
//
//   K14      0x43000  die Einhaengetafel (8 Eintraege zu 128 Oktetten),
//                     die Partitionstafel, die Skalare von devfs und
//                     procfs und zwei Pfadpuffer fuer die Aufloesung
//                     ueber Einhaengegrenzen hinweg.
//   FAT      0x44000  die Arbeitsbloecke von FAT32: ein Sektor der
//                     Zuordnungstafel, ein Verzeichnissektor, ein
//                     Datensektor und der Zusammenbau eines langen
//                     Namens. Ein Kernelstapel ist 8 KiB -- vier
//                     Sektoren darauf waeren ein Viertel davon.
//   PROCFS   0x45000  eine Seite, auf der eine Datei des /proc-
//                     Dateisystems ENTSTEHT. `/proc/meminfo` liegt
//                     nirgends; es wird bei jedem Lesen geschrieben,
//                     und das ist der Unterschied zwischen einem
//                     Dateisystem im Speicher und einer Datei.
const K14_OFF: u64 = 0x43000
const K14_MAX: u64 = 0x1000
const FAT_OFF: u64 = 0x44000
const FAT_MAX: u64 = 0x1000
const PROCFS_OFF: u64 = 0x45000
const PROCFS_MAX: u64 = 0x1000

// DIE WOERTER DER KOMMANDOZEILE, und die meisten davon sind GEGENPROBEN.
// Eine Eigenschaft, die sich nicht abschalten laesst, kann nicht
// gemessen werden -- ohne das Gegenstueck bleibt jede Zahl eine
// Behauptung ueber sich selbst.
//
//   `vfs`       die Schicht dieser Runde anschalten.
//   `novfs`     GEGENPROBE: nur die Wurzel, kein weiteres Einhaengen.
//               /proc, /dev und FAT32 gibt es dann nicht, und JEDE
//               Zusage dieser Runde ausser der ueber OFS MUSS fallen.
//   `noprocfs`  GEGENPROBE: /proc wird nicht eingehaengt.
//   `nodevfs`   GEGENPROBE: /dev wird nicht eingehaengt.
//   `nofat`     GEGENPROBE: die zweite Platte wird nicht angefasst.
//   `nopart`    GEGENPROBE: die Partitionstafel wird NICHT gelesen, das
//               Dateisystem also bei Block 0 der Platte gesucht. Auf
//               einer partitionierten Platte steht dort kein FAT32 --
//               die Messung MUSS zusammenbrechen.
//   `fatro`     FAT32 nur lesend einhaengen. Jeder Schreibversuch gibt
//               -EROFS, und das ist die Gegenprobe zur Schreibseite.
//   `vfsall`    AUCH die Wurzel geht durch die Ops-Tafel statt durch
//               den geraden Weg von Runde 62. Der Vergleich der beiden
//               Laeufe, Oktett fuer Oktett, ist der Beweis, dass OFS
//               ein NUTZER dieser Schicht ist und kein Sonderfall
//               daneben.
const M_VFS: u64 = 192 // Wort 3, Bit 0
const M_NOVFS: u64 = 193 // Wort 3, Bit 1
const M_NOPROCFS: u64 = 194 // Wort 3, Bit 2
const M_NODEVFS: u64 = 195 // Wort 3, Bit 3
const M_NOFAT: u64 = 196 // Wort 3, Bit 4
const M_NOPART: u64 = 197 // Wort 3, Bit 5
const M_FATRO: u64 = 198 // Wort 3, Bit 6
const M_VFSALL: u64 = 199 // Wort 3, Bit 7
// --------------------------------------- Runde K16: die Dateiarten
//
// DREI SEITEN, 0x49000..0x4C000, UND SIE GEHOEREN DIESER RUNDE ALLEIN.
// Am Morgen des 26.08.2026 liefen vier Runden gleichzeitig, und drei
// davon hatten dieselbe Seite genommen -- derselbe Fehler wie in K7, nur
// dreifach. Der Vorrat ist deshalb vorher verteilt worden:
//
//     K13  0x41000..0x43000     K14  0x43000..0x46000
//     K15  0x46000..0x49000     K16  0x49000..0x4C000   <- hier
//
// Was darin liegt:
//
//   FT_TAB     die Tabelle "Dateiart -> womit oeffnen", 32 Saetze zu 128
//              Oktetten. EINE Tabelle, kein Sonderfall in irgendeinem
//              Programm -- der Dateiverwalter von Runde K15 ruft sie ab,
//              statt Endungen selbst zu kennen.
//   FT_SCALARS die Zaehler, an denen die Abnahme misst.
//   FT_HEAD    die ersten Oktette einer Datei, um die MAGISCHE ZAHL zu
//              lesen. Der Kernel haelt nie einen Zeiger von Ring 3, also
//              wird auch hier erst kopiert und dann gelesen.
//   FT_LINE    die zerlegte `#!`-Zeile: Ausleger und ein Argument.
//   FT_REC     ein Satz, wie ihn Ring 3 zu sehen bekommt.
//   FT_ARGS    die Argumentliste, die beim Starten neu gebaut wird --
//              beim Ausleger eines Skripts stehen vorne zwei Woerter mehr.
const K16_OFF: u64 = 0x49000
const K16_MAX: u64 = 0x3000

// RUNDE K17: DER USB-BAUM. Acht Seiten, 0x50000..0x58000, und der Vorrat
// war VOR dem Bauen zugeteilt -- mehrere Runden arbeiten gleichzeitig an
// diesem Baum, und genau daraus sind die vier Kollisionen entstanden, die
// oben im Kopf dieser Datei stehen.
//
// Warum so viel: ein xHCI liest seine Befehle SELBST aus dem Speicher.
// Ringe, Zusammenhangstafel, Eingabezusammenhang und Datenpuffer muessen
// deshalb physisch zusammenhaengend und ausgerichtet liegen, und sie
// muessen dort liegen bleiben. Die Untergliederung steht in
// `kernel/xhci.fi` und `kernel/usb.fi`; sie liegt vollstaendig INNERHALB
// dieses Bereichs und ist in `tools/kernel/memmap.py` als solche
// eingetragen.
const K17_OFF: u64 = 0x50000
const K17_MAX: u64 = 0x8000

const FT_TAB: u64 = 0x0000 // FT_SLOTS * FT_SLOT = 4096
const FT_SCALARS: u64 = 0x1000
const FT_HEAD: u64 = 0x1200 // FT_HEAD_MAX
const FT_LINE: u64 = 0x1400 // 2 * 128
const FT_SB: u64 = 0x1300 // die erste Zeile, wenn sie `#!` ist
const FT_REC: u64 = 0x1600 // FT_SLOT
const FT_ARGS: u64 = 0x2000 // 2 * IARGS_MAX, siehe kernel/elf.fi
const FT_IPATH: u64 = 0x1700 // 2 * 128: der Pfad des Auslegers

const FT_SLOTS: u64 = 32
const FT_SLOT: u64 = 128
const FT_HEAD_MAX: u64 = 256

// Die Zaehler (Versatz ab K16_OFF + FT_SCALARS).
const FT_CLASSIFIED: u64 = 0x00 // wie oft eine Datei eingeordnet wurde
const FT_BY_MAGIC: u64 = 0x08 // davon am INHALT erkannt
const FT_BY_EXT: u64 = 0x10 // davon an der ENDUNG erkannt
const FT_OPENED: u64 = 0x18 // wie oft `fopen` etwas gestartet hat
const FT_SHEBANGS: u64 = 0x20 // wie oft `execve` einen Ausleger fand
const FT_REGISTERED: u64 = 0x28 // Eintraege in der Tabelle
const FT_REFUSED: u64 = 0x30 // wie oft `fopen` abgelehnt hat

// RUNDE K16: wie viele Stapelseiten bei Bedarf entstanden sind. Der
// Zaehler liegt bei den uebrigen Skalaren des Kernels und nicht im
// K16-Bereich, weil `proc.fi` ihn schreibt und `proc.fi` den K16-Bereich
// sonst nicht kennt.
const STACKGROW: u64 = 1024 // RUNDE K16
// ROUND MEM: how many octets the frame bitmap really occupies, and how
// many gibioctets of physical memory are identity mapped. Both used to
// be constants -- 16384 and 1 -- and both are now results of the memory
// map. They are printed at boot and read by `tools/mem/run.sh`.
const BITMAP_OCTETS: u64 = 1032
const MAPPED_GIB: u64 = 1040
// Where the next search for a free frame starts. A hint, not a promise:
// the search wraps around and still covers the whole map.
const FRAME_HINT: u64 = 1048
// What the stress test measured. They are scalars and not a return
// value because the caller wants to PRINT all of them, and a Firn
// function returns one word.
const STRESS_GOT: u64 = 1056 // frames it managed to take
const STRESS_HIGH: u64 = 1064 // the highest address among them
const STRESS_BEFORE: u64 = 1072 // free frames before
const STRESS_LOW: u64 = 1080 // free frames while everything was taken
const STRESS_BAD: u64 = 1088 // frames whose check word was wrong
const STRESS_SEEN: u64 = 1096 // frames the chain led back to
const STRESS_AFTER: u64 = 1104 // free frames after everything was freed
const PROBE_ADDR: u64 = 1112 // the high frame that was written and read
// RUNDE POLL: DIE WECKFOLGE. Eine Zahl, die JEDE Stelle im Kernel um
// eins erhoeht, an der ein Deskriptor BEREIT werden kann -- ein Oktett
// in ein Rohr, ein geschlossenes Gegenende, ein Rahmen von der Karte,
// eine Taste. Sie loest die klassische Wettlaufsituation von `poll`:
// wer schlafen gehen will, merkt sich diesen Stand VOR seiner Pruefung
// und legt sich nur schlafen, wenn er sich seither nicht bewegt hat.
// Ohne sie geht genau das Ereignis verloren, das zwischen `nichts ist
// bereit` und `ich schlafe` eintrifft -- und der Prozess schlaeft bis
// zum Zeitablauf, obwohl seine Daten schon da sind.
const POLLSEQ: u64 = 1120

// ================================================================
// RUNDE SERVERBUILD: DIE SERIELLE KONSOLE
// ================================================================
//
// Bis hierher war die serielle Leitung ein NOTAUSGANG: der Kernel
// schrieb hinaus, und niemand schrieb herein. Eingegeben wurde ueber
// die PS/2-Tastatur (`kbd.fi`, IRQ 1) oder ueber das Skript auf der
// Befehlszeile (`script=`). Auf einem Server gibt es weder das eine
// noch das andere -- da haengt ein Terminal an COM1, und das TIPPT.
//
// Diese fuenf Skalare fuehren, was auf dem Rueckweg passiert.
//
// RUNDE MERGE-2: sie standen ab 1120, und 1120 ist POLLSEQ (Runde
// POLL, achtzehn Zeilen weiter oben). Beide Runden haben sich an
// denselben Satz gehalten -- "1112 war der letzte vergebene Platz" --
// und beide hatten recht, jede fuer sich. Die fuenf ruecken auf 1128.
const SER_PORT: u64 = 1128 // 0 = COM1 (0x3F8), sonst der Torwert
const SER_RX: u64 = 1136 // empfangene Oktette
const SER_IRQS: u64 = 1144 // Unterbrechungen auf IRQ 4
const SER_DROPS: u64 = 1152 // Oktette, die kein Terminal aufnahm
const SER_OVERRUNS: u64 = 1160 // der Baustein meldet Ueberlauf (LSR Bit 1)
// next free scalar: 1168
// RUNDE K15: die Naht zwischen Fensterserver und Widget-Bibliothek
// (`kernel/wig.fi`). Drei Seiten aus dem Vorrat, den diese Runde
// zugeteilt bekommen hat -- 0x46000..0x49000, und keine andere:
//
//   +0x0000  die Skalare
//   +0x1000  die Zwischenablage, vier Kilooktett
//   +0x2000  der Umschlagpuffer -- EINE Bildpunktzeile oder EINE Glyphe
//
// Was gross ist, liegt auch hier NICHT in `kdata`: die Zeichenflaeche
// der Bibliothek ist ein `mmap` in Ring 3, und der Glyphenspeicher
// gehoert weiter `ttf.fi`.
const WIG_OFF: u64 = 0x46000
const WIG_MAX: u64 = 0x3000

// RUNDE K15, ZWEITER NACHTRAG: DIE SEITE DER SKALARE WIRD GETEILT.
//
// `wig.fi` braucht von der ersten Seite dieses Vorrats 0x40 Oktette.
// Der Rest der Seite ist Platz dieser Runde und keiner anderen, und der
// zweite Nachtrag braucht zwei Dinge darin:
//
//   +0x0080  FSG -- DIE GEOMETRIE DES DATEISYSTEMS, zwei Woerter, aus
//            dem Superblock beim Einhaengen. Bis hierher standen die
//            Zahl der Inodes (128) und der erste Datenblock (34) als
//            Konstanten in `fs.fi`; ein Abbild mit mehreren Tausend
//            Dateien braucht mehr Inodes, und die Zahl steht seit jeher
//            IM SUPERBLOCK -- sie wurde nur nie gelesen. Zwei Woerter,
//            und die alten Abbilder bleiben Oktett fuer Oktett dieselben.
//
// Warum nicht in den allgemeinen Skalaren am Anfang von `kdata`: dort
// vergeben mehrere Runden gleichzeitig Plaetze, und genau daran sind in
// dieser Runde schon drei Zusammenfuehrungen fast gescheitert. Hier
// gehoert die Seite dieser Runde allein.
//
// DAS JOURNAL LAG BIS ZUR RUNDE SPEICHER EBENFALLS IN DIESER SEITE, bei
// +0x0100 mit 0xF00 Oktetten. Es ist ausgezogen -- die Begruendung steht
// unten bei JRNL_OFF.
const FSG_OFF: u64 = 0x46080

// ====================================================== RUNDE SPEICHER
//
// ZWEI SEITEN, 0x5E000..0x60000, UND SIE GEHOEREN DIESER RUNDE ALLEIN.
//
// JRNL -- DAS AENDERUNGSJOURNAL DES DATEISYSTEMS. Ein Ring, in den
// `fs.fi` schreibt, und aus dem der Index in Ring 3 nachzieht, ohne neu
// zu bauen. Das Gegenstueck zum USN-Journal von NTFS, an dem "Everything"
// haengt. Laeuft er ueber, sagt er das, und der Index baut neu -- genau
// wie dort.
//
// WARUM ER AUS DER K15-SEITE AUSZIEHT, und der Grund ist eine Zahl. Bis
// zur Runde SPEICHER hielt der Ring 56 Saetze -- so viele, wie in die
// 0xF00 Oktette passten, die in der geteilten Seite von K15 uebrig
// waren. Seit dieser Runde meldet das Journal auch, dass eine Datei
// GEWACHSEN ist, und das passiert einmal je `write`: eine Datei von 30
// Kilooktett, mit einem Puffer von 512 Oktetten geschrieben, sind 60
// Saetze. In einem Ring von 56 laeuft das ueber, der Index sieht `lost`
// und baut neu -- richtig, aber langsam. 0x2000 Oktette fassen
// 0x40 + 127 * 64 = 8192, also 127 Saetze.
//
// WARUM 0x5E000 UND NICHT 0x4C000, die naechste freie Seite. Am
// 27.08.2026 laufen wieder mehrere Runden an diesem Baum: DESKTOP hat
// sich 0x54000..0x58000 genommen und dabei 0x4C000..0x54000 ausdruecklich
// fuer die Runde freigelassen, die der Reihe nach greift; OFS3 hat
// 0x5A000..0x5C000. Diese Runde nimmt das OBERE ENDE und laesst beides
// in Ruhe. `tools/kernel/memmap.py` rechnet nach, dass sich nichts
// ueberschneidet.
const JRNL_OFF: u64 = 0x5E000
const JRNL_MAX: u64 = 0x2000

// ============================================================ RUNDE K18
//
// ZWEI SEITEN, 0x58000 und 0x59000, AUS DEM VORRAT 0x58000..0x60000, UND
// SIE GEHOEREN DIESER RUNDE ALLEIN. Zur Zeit dieser Runde arbeiten wieder
// mehrere Runden gleichzeitig an diesem Baum; die Bereiche sind deshalb
// VORHER verteilt worden, so wie bei K13 bis K16:
//
//     K13  0x41000..0x43000     K14  0x43000..0x46000
//     K15  0x46000..0x49000     K16  0x49000..0x4C000
//     K18  0x58000..0x60000   <- hier, belegt sind die ersten zwei Seiten
//
//   K18   0x58000  die Skalare der Energieschicht: das laufende Profil,
//                  was zuletzt in welches MSR geschrieben und was danach
//                  zurueckgelesen wurde, die Zaehler fuer mwait und hlt,
//                  Temperatur und Drosselung. Ab Versatz 256 liegen die
//                  Zeilen, auf die `monitor` zeigt -- eine je Kern, 64
//                  Oktette auseinander, damit zwei Kerne sich nicht
//                  gegenseitig aufwecken.
//   BATT  0x59000  was aus den ACPI-Tabellen ueber Akku, Netzteil und
//                  Thermalzone gelesen wurde, samt der vier
//                  Zeichenketten aus `_BIF` (ab Versatz 256, je 64).
const K18_OFF: u64 = 0x58000
const K18_MAX: u64 = 0x1000
const BATT_OFF: u64 = 0x59000
const BATT_MAX: u64 = 0x1000

// ======================================================== RUNDE OFS3
//
// ZWEI SEITEN, 0x5A000..0x5C000, AUS DEM VORRAT, DEN DIE KARTE OBEN ALS
// FREI FUEHRT. Sie tragen die PFADPUFFER des Dateisystems, und der Grund,
// dass es sie gibt, ist eine Zahl: ein Name in OFS 3 darf 255 Zeichen
// lang sein (vorher 23). `fs.path` hielt seinen Namensbestandteil in
// `[u8; 32]` auf dem KERNELSTAPEL, `fs.parent_of` den ganzen Pfad in
// `[u8; 96]` -- zusammen 128 Oktette. Dieselben Puffer in der neuen
// Groesse waeren 256 + 1024, und dazu kommt beim Verfolgen eines
// symbolischen Verweises ein zweiter Pfad. Ein Kernelstapel ist 8 KiB;
// drei Kilooktette davon fuer ein `open` sind kein Handel, den man
// machen will -- schon gar nicht auf dem tiefsten Weg, den dieser Kernel
// hat.
//
// SICHER IST DAS, WEIL ALLE NUTZER UNTER DEM SCHLOSS DES DATEISYSTEMS
// STEHEN (`fs.enter`/`fs.leave`, `atomic.L_FS`). Es kann keine zweite
// gleichzeitige Benutzung geben, und die Verschachtelung ist
// aufgeschrieben: `parent_of` benutzt OP_PATH und ruft `path`, das
// OP_WORK, OP_BUILD und OP_NAME benutzt -- vier Puffer, die sich nicht
// ueberdecken.
const OFS3_OFF: u64 = 0x5A000
const OFS3_MAX: u64 = 0x2000

// Die Versaetze INNERHALB der zwei Seiten. Sie stehen in
// `tools/kernel/memmap.py` als "Versatz in OFS3_OFF" und sind deshalb
// keine eigenen Bereiche der Karte.
const OP_NAME: u64 = 0x000 // ein Namensbestandteil in `fs.path`, 256
const OP_NAME2: u64 = 0x100 // was `parent_of` als Namen herausgibt, 256
const OP_OLD: u64 = 0x200 // `rename`: der alte Name
const OP_NEW: u64 = 0x300 // `rename`: der neue Name
const OP_PATH: u64 = 0x400 // die Pfadkopie in `parent_of`, 1024
const OP_WORK: u64 = 0x800 // der laufende Pfad in `fs.path`, 1024
const OP_BUILD: u64 = 0xC00 // der neu gebaute Pfad nach einem Verweis
const OP_LINK: u64 = 0x1000 // das Ziel eines symbolischen Verweises, 1024
const OP_TMP: u64 = 0x1400 // Zwischenlage fuer `symlink`/`readlink`
const OP_ENT: u64 = 0x1800 // ein Verzeichniseintrag, 512
// RUNDE OFS3, jetzt in Wort 7 des Modusvektors statt in einem eigenen
// Moduswort in `OFS3_OFF`. Der Grund fuer das eigene Wort war, dass die
// 64 Bits des alten Modus voll waren; seit Runde K17 gibt es dafuer
// einen Vektor, und zwei Modussysteme nebeneinander waeren genau die
// Doppelbuchfuehrung, gegen die K17 angetreten ist.
const O_NOLINKS: u64 = 449 // Wort 7, Bit 1 -- `fs.path` folgt keinem Verweis
const O_OFS3: u64 = 450 // Wort 7, Bit 2 -- der Selbsttest in Ring 3
const O_OFS3FMT: u64 = 451 // Wort 7, Bit 3 -- `format` baut Fassung 3
const O_NOATIME: u64 = 452 // Wort 7, Bit 4 -- keine Zugriffszeit

// ------------------------------------------------------ RUNDE FSROBUST
//
// DREI WOERTER, UND ZWEI DAVON SIND GEGENPROBEN.
//
//   `nojournal` schaltet das Journal ab, OBWOHL die Platte eines
//               traegt. Das ist die Gegenprobe dieser Runde: derselbe
//               Kern, dieselbe Platte, ein Wort Unterschied -- und der
//               Stromausfalltest MUSS damit Schaeden finden. Eine
//               Absicherung, die man nicht abschalten kann, laesst sich
//               nicht messen.
//   `jrnlfmt`   `fs.format` legt einen Journalbereich an. Ohne das Wort
//               formatiert derselbe Kern wie vorher, Oktett fuer
//               Oktett.
//   `fsrcrash`  das Schreibprogramm der Stromausfallmessung laeuft
//               ENDLOS statt eine feste Zahl von Dateien zu schreiben --
//               so trifft der Abschuss immer mitten hinein.
const O_NOJRNL: u64 = 453 // Wort 7, Bit 5
const O_JRNLFMT: u64 = 454 // Wort 7, Bit 6
const O_FSRCRASH: u64 = 455 // Wort 7, Bit 7

// DIE WOERTER DER RUNDE OFS3 AUF DER BEFEHLSZEILE. Drei davon sind
// GEGENPROBEN -- ohne sie waere jede Zusage dieser Runde eine Behauptung
// ueber sich selbst.
//
//   `ofs3`      der Selbsttest dieser Runde in Ring 3.
//   `ofs3fmt`   `fs.format` baut ein Abbild der FASSUNG 3 statt der
//               Fassung 2. DIE VORGABE IST DIE FASSUNG 2, und zwar aus
//               demselben Grund, aus dem `mkfs.py` sie ohne `--v3`
//               baut: eine frisch formatierte Platte soll genau die
//               Platte sein, die alle Runden vor dieser gemessen
//               haben. Mit dem Wort dagegen faellt derselbe Kern in die
//               neue Fassung, und die groesste Platte steigt von zwei
//               Megaoktett auf Gigaoktette -- derselbe Kern, ein Wort
//               Unterschied. Waeren die neuen Grenzen im Uebersetzer
//               statt im Superblock, koennte dieser Unterschied gar
//               nicht entstehen.
//   `noatime`   GEGENPROBE: die Zugriffszeit wird beim Oeffnen NICHT
//               nachgefuehrt.
//   `nolinks`   GEGENPROBE: `fs.path` folgt keinem symbolischen Verweis.
//               Jeder Pfad ueber einen Verweis MUSS dann ins Leere
//               laufen.


// ======================================================= RUNDE DISPLAY
//
// ZWEI SEITEN. Diese Runde hatte 0x5A000 und 0x5B000 genommen, aus dem
// Rest des Vorrats 0x58000..0x60000 -- und Runde OFS3 hatte dieselben
// zwei Seiten fuer ihre Pfadpuffer genommen. Beim Zusammenfuehren hat
// der Kartenpruefer das gemeldet; DISPLAY zieht auf die naechsten zwei
// freien Seiten, 0x5C000 und 0x5D000, OFS3 bleibt stehen (zwei Seiten
// gegen zwei Seiten, aber OFS3 haengt mit zehn Versaetzen daran).
// Sie stehen hier und nicht nur in `vmode.fi`, weil
// genau das der Fehler war, an dem Runde K7 gescheitert ist: ein Bereich,
// der nur in seinem eigenen Modul steht, wird von der naechsten Runde
// ueberschrieben, und der Kartenpruefer sieht ihn nicht.
//
//   DISP  0x5C000  die Skalare des Modustreibers und die Modusliste, die
//                  `vmode.probe` der Karte abgefragt hat -- je Modus ein
//                  Achtoktettwort (Breite | Hoehe << 16 | Bit << 32).
//   DLUT  0x5D000  die Nachschlagetabelle fuer Helligkeit, Kontrast,
//                  Gamma und Farbsaettigung (drei mal 256 Oktette ab
//                  Versatz 0) und der EDID-Block, den die Karte ueber
//                  ihren Speicherbereich meldet (256 Oktette ab 0x400).
const DISP_OFF: u64 = 0x5C000
const DISP_MAX: u64 = 0x1000
const DLUT_OFF: u64 = 0x5D000
const DLUT_MAX: u64 = 0x1000

// ======================================================== ROUND NETMON
//
// MERGE: this round took 0x5A000..0x5D000 and 0x5D000..0x60000, the
// last six pages behind the old boundary. Rounds OFS3 (path buffers),
// DISPLAY (video modes) and SPEICHER (the change journal) have taken
// exactly those pages in the meantime, so both areas move up -- and
// there is not enough room left below 0x70000 either, so KDATA_SIZE
// goes from 0x70000 to 0x80000. That number stands HERE and in
// `kernel/arch/x86_64/boot.s`, and `tools/hv/run.sh` compares the two;
// both are changed.
//
// THREE PAGES, 0x6C000..0x6F000. What lives in it is the accounting
// of `kernel/netmon.fi`: six counters per task, a record per socket,
// and the seven scalars of the round. It is entered in
// `tools/kernel/memmap.py` like every other area -- that checker is the
// reason nobody has to trust this comment.
const NETMON_OFF: u64 = 0x6C000
const NETMON_MAX: u64 = 0x3000

// ======================================== ROUND NETMON, PART TWO
//
// THREE PAGES, 0x6F000..0x72000. What lives in them is `kernel/share.fi`: the NAT table (64
// records), the client table (16), and two frame-sized scratch areas
// for the packet being rewritten and the one being built. The next
// round that needs a page has to raise KDATA_SIZE -- which stands here
// AND in `kernel/boot.s`, and `tools/hv/run.sh` compares the two.
const SHARE_OFF: u64 = 0x6F000
const SHARE_MAX: u64 = 0x3000

// ======================================================= RUNDE DESKTOP
//
// VIER SEITEN, 0x54000..0x58000, UND SIE GEHOEREN DIESER RUNDE ALLEIN.
//
// WARUM DIESE RUNDE UEBERHAUPT EINE SEITE BRAUCHT, und der Grund ist
// eine Zahl: der Fensterserver konnte ACHT Fenster. Ein Schreibtisch
// mit Hintergrund (1), eine Taskleiste (1), der Starter (1), der
// Datei-Explorer mit Kontextmenue und Dialog (3) und die Einstellungen
// mit Dialog (2) sind ACHT -- die neunte Anwendung bekaeme kein
// Fenster mehr. MAX_WIN steigt deshalb von 8 auf 16, und damit passen
// Fenstertafel (16 x 256 = 0x1000) und Ereignisringe (16 x 512 =
// 0x2000) nicht mehr in die zwei Seiten von WM_OFF. Beide ziehen
// hierher; in WM_OFF bleiben die Skalare des Servers.
//
//   +0x0000  die Fenstertafel: 16 Saetze zu 256 Oktetten
//   +0x1000  die Ereignisringe: 16 Ringe zu 32 Plaetzen a 16 Oktetten
//   +0x3000  Vorrat dieser Runde
//
// WARUM NICHT 0x4C000, die naechste freie Seite. Am 27.08.2026 laufen
// wieder mehrere Runden an diesem Baum, darunter eine am Dateisystem.
// Wer sequentiell greift, greift 0x4C000. Diese Runde greift deshalb
// ans ANDERE Ende des freien Vorrats und laesst 0x4C000..0x54000 (32
// KiB) fuer die Runde, die der Reihe nach nimmt. Das ist keine Feinheit
// -- genau an dieser Stelle sind in diesem Baum schon vier
// Zusammenfuehrungen gescheitert (siehe tools/kernel/memmap.py).
// MERGE-VERSCHIEBUNG: 0x54000 -> 0x64000. Diese Runde hatte
// ausdruecklich ans ANDERE Ende des freien Vorrats gegriffen (0x54000)
// und 0x4C000..0x54000 fuer die Runde freigelassen, die der Reihe nach
// nimmt. Runde K17 hat dann NICHT der Reihe nach genommen, sondern
// 0x50000..0x58000 -- acht Seiten mitten hinein. Der Kartenpruefer hat
// die Ueberschneidung beim Zusammenfuehren sofort gemeldet. Verschoben
// wird DIESE Runde und nicht K17, weil vier Seiten leichter umziehen als
// acht; der Vorrat hinter den Arbeitsverzeichnissen (0x64000..0x70000,
// aus Runde OFS3) nimmt sie auf.
const DSK_OFF: u64 = 0x64000
const DSK_MAX: u64 = 0x4000

// ========================================================= RUNDE TILING
//
// VIER SEITEN, 0x4C000..0x50000, AUS DEM VORRAT 0x4C000..0x58000, DER
// SEIT RUNDE K16 ALS FREI AUSGEWIESEN IST. Sie gehoeren dem
// FENSTERBAUM. Waehrend diese Runde lief, liefen sechs weitere an
// demselben Baum; die Bereiche sind deshalb vorher verteilt worden, so
// wie bei K13 bis K16:
//
//     TILING   0x4C000..0x50000   <- hier, alle vier Seiten belegt
//     frei     0x50000..0x54000
//     DESKTOP  0x54000..0x58000
//
// WAS DRIN LIEGT, und die Rechnung dazu steht in `kernel/tile.fi`:
//
//   +0x0000  die Skalare des Baumes (Wurzel, Fokus, Flaeche, Zaehler)
//   +0x0200  die Knotentafel: 96 Knoten zu 128 Oktetten = 12288
//   +0x3200  die Tastenbelegung: 56 Eintraege zu 64 Oktetten = 3584
//
// Die 96 sind nicht geraten. Ein Baum mit N Blaettern hat hoechstens
// 2N-1 Knoten (jeder innere Knoten mit genau zwei Kindern); 96 Knoten
// tragen also 48 Fenster, und 48 heisst in `tile.fi` MAX_LEAVES. Wer
// das 49. anlegt, bekommt eine Absage und keinen stillen Ueberlauf.
// MERGE-VERSCHIEBUNG: 0x4C000 -> 0x68000. Diese Runde hat aus dem
// Vorrat gegriffen, den K16 als frei ausgewiesen hatte; Runde K17 hat
// dort inzwischen den Modusvektor (0x4C000) und ihre USB-Seiten
// (0x50000..0x58000). Der Fensterbaum zieht hinter die Fenstertafel der
// Runde DESKTOP.
const TILE_OFF: u64 = 0x68000
const TILE_MAX: u64 = 0x4000

// RUNDE TILING. Wie in jeder Runde davor sind zwei davon GEGENPROBEN:
//
//   `tile`         den Fensterbaum anschalten: neue Fenster werden
//                  gekachelt statt frei schwebend gelegt.
//   `tilefuzz`     zehntausend zufaellige Baumoperationen, nach jeder
//                  die Invariante pruefen. Ohne Verletzung oder gar
//                  nicht.
//   `tileshot`     vier Fenster fuer das Bildschirmfoto anlegen.
//   `tiletabs`     dieselben vier als Reiter (`tabbed`).
//   `tilerot`      dieselben vier nach einer Vierteldrehung.
//   `notiledirty`  GEGENPROBE zur Bereichsverfolgung des Baumes: beim
//                  Teilen wird der GANZE Schirm schmutzig statt nur der
//                  betroffene Teilbaum. Die gemalte Flaeche MUSS damit
//                  deutlich groesser werden -- sonst misst die
//                  Teilbaumverfolgung nichts.
// RUNDE TILING, in den Modusvektor der Runde K17 eingehaengt. Die alten
// Masken 1 << 33 .. 1 << 38 lagen mitten in dem Bereich, den die Runden
// K13 bis K16 schon belegt hatten -- diese Runde ist von einem AELTEREN
// Stand abgezweigt. Kacheln ist Oberflaeche, also Wort 1.
const M_TILE: u64 = 87 // Wort 1, Bit 23
const M_TILEFUZZ: u64 = 88 // Wort 1, Bit 24
const M_TILESHOT: u64 = 89 // Wort 1, Bit 25
const M_TILETABS: u64 = 90 // Wort 1, Bit 26
const M_TILEROT: u64 = 91 // Wort 1, Bit 27
const M_NOTILEDIRTY: u64 = 92 // Wort 1, Bit 28

// RUNDE TRESOR: die Geraeteidentitaet (`kernel/hwid.fi`). Zwei Seiten.
// MERGE: die Runde hatte 0x5A000 gewaehlt; dort liegen seit OFS3 die
// Pfadpuffer. Sie ziehen in den Vorrat hinter NETMON.
//
// Die ZWEITE Seite ist nicht Verschnitt: sie ist das DMA-Ziel des
// `identify controller` von NVMe, und ein PRP-Eintrag ueber 4096 Oktette
// mit einem Versatz ungleich null braeuchte einen zweiten Eintrag. Eine
// eigene, seitenausgerichtete Seite kostet nichts und spart den Fall.
const HWID_OFF: u64 = 0x72000
const HWID_MAX: u64 = 0x2000
// ROUND POWERMON. TWO PAGES, 0x5C000..0x5E000, out of the same store
// round K18 opened (0x58000..0x60000) and left mostly empty. It starts
// at 0x5C000 and not at the first free page because round NETMON has
// taken 0x5A000 and round DISPLAY 0x5A000..0x5C000, each on its own
// branch, and neither can see the other. Starting above both means the
// three merge in any order without the collision that has cost this
// project four rounds already (the list is a few hundred lines above).
//
//   PMON  0x5C000  the scalars of the power accounting, thirty-two task
//                  records of 96 octets and eleven brightness buckets.
//         0x5D000  the sample ring: 256 measured rates with the tick at
//                  which each was read, which is the graph a person sees.
//         0x5E000  sixteen PROGRAM rows. A process is not a program, and
//                  the person asked about programs -- and a task slot
//                  that is handed on would otherwise take the charge of
//                  whoever held it before with it.
// MERGE: 0x5C000 gehoert seit der Runde DISPLAY dem Modustreiber und
// 0x5E000 seit SPEICHER dem Aenderungsjournal. Diese drei Seiten ziehen
// hinter die Geraeteidentitaet der Runde TRESOR.
const PMON_OFF: u64 = 0x74000
const PMON_MAX: u64 = 0x3000

// RUNDE NETVIEW, BEIM VERSCHMELZEN VERSCHOBEN.
//
// Diese Runde hatte ihre vorgetaeuschten Steckdosen in die Seite von
// Runde K2 gelegt (`pci.K2_SCALARS`, 0x12000..0x14000) und im
// Kommentar festgehalten, sie bleibe "unter 0x1400". Das stimmte fuer
// sich allein und nach dem Verschmelzen nicht mehr:
//
//   `wg.fi`     (Runde TUNNEL)  0xC00..0xC60 -- mitten in der
//               Steckdosentabelle dieser Runde (0xB00..0xF00)
//   `hw.fi`     (Runde TUNNEL)  0xE00..0x1200 -- die Kopie der
//               Kernbefehlszeile, quer ueber die letzten Saetze der
//               Tabelle, ueber die Zaehler bei 0xF00 und ueber die
//               ersten zwei Antwortpuffer
//   `virtio.fi` (Runde NETMON)  CARD1 = 0x1400 -- der Kommentar dort
//               sagt 0x1600, die Zahl sagte 0x1400
//
// Dazu lag diese Runde SELBST uebereinander: 16 Puffer zu 256 Oktetten
// ab 0x1000 reichen bis 0x2000, und 0x1400 war noch einmal als
// Schreibfläche vergeben.
//
// Statt vier Zahlen gegeneinander zu schieben bekommt die Runde eine
// eigene Seitenfolge. Die Versaetze INNERHALB stehen in
// `kernel/netview.fi`; hier steht nur, wo sie anfangen.
const NETVIEW_OFF: u64 = 0x77000
const NETVIEW_MAX: u64 = 0x3000

// RUNDE HWNET. Die Auswahl der Netzkarte (`kernel/netdev.fi`) und der
// Treiber fuer die Intel-8254x-Familie (`kernel/e1000.fi`). EINE Seite,
// und sie liegt bewusst NICHT in `pci.K2_SCALARS`: diese Seite teilen
// sich neun Runden, und Runde NETVIEW hat einen Tag damit verbracht,
// dass zwei davon auf denselben acht Oktetten standen. Die Versaetze
// INNERHALB stehen in den beiden Dateien; hier steht nur, wo sie
// anfangen.
//
//   +0x000  netdev.fi: je Karte Treiberart, Einheit und PCI-Platz
//   +0x300  netdev.fi: die Karten OHNE Treiber, mit ihren Nummern
//   +0x400  e1000.fi:  Einheit 0
//   +0x600  e1000.fi:  Einheit 1
const NETDEV_OFF: u64 = 0x7A000
const NETDEV_MAX: u64 = 0x1000

// ======================================================== RUNDE FSROBUST
//
// DREI SEITEN AUS DEM LETZTEN FREIEN STUECK, 0x7A000..0x80000. Runde
// NETVIEW endet bei 0x7A000; danach war bis heute nichts. Was hier
// liegt, ist der Zustand des OFS-Journals (`kernel/ofsj.fi`):
//
//   +0x000  die Skalare: ob das Journal an ist, wo es liegt, wie tief
//           die laufende Umschreibung geschachtelt ist, wie viele
//           Plaetze belegt sind, die Folgenummer und sechs Zaehler.
//   +0x800  zwei Arbeitsbloecke zu je 512 Oktetten. Sie liegen HIER und
//           nicht auf dem Kernstapel: der hat 8 KiB, und `fs.fi` haelt
//           daneben schon sieben Bloecke.
//   +0x1000 die Zieltafel: 512 Blocknummern zu acht Oktetten.
//   +0x2000 die Streuwerte: 512 Pruefsummen zu acht Oktetten, eine je
//           Platz. Sie stehen hier, damit die Bestaetigung die
//           Nutzlast nicht noch einmal von der Platte lesen muss.
//
// `tools/kernel/memmap.py` rechnet nach, dass sich das mit nichts
// ueberschneidet.
// RUNDE MERGE-2: hier stand 0x7A000, und der Satz darueber -- "Runde
// NETVIEW endet bei 0x7A000; danach war bis heute nichts" -- war auf
// dem Zweig FSROBUST wahr. Auf main liegt dort seit Runde HWNET die
// Netzkartenauswahl, und AHCI und HANDLE haben den Rest genommen; das
// ist die sechste Runde, die sich dasselbe Stueck nimmt.
// Die drei Seiten liegen jetzt auf 0x8000..0xB000 -- in dem Loch von
// 16 KiB, das Merge 08 hinterlassen hat, als die Aufgabentafel nach
// 0x88000 umgezogen ist. Es ist das groesste zusammenhaengende Stueck
// der Karte und liegt genau richtig fuer drei Seiten am Stueck.
// ============================================================ RUNDE MODUL
//
// DREI SEITEN AUS DEM LOCH ZWISCHEN DEM MODUSVEKTOR UND DEM USB-VORRAT,
// 0x4D000..0x50000. Die Karte oben in dieser Datei weist das Stueck seit
// Runde K17 ausdruecklich als "frei" aus: MODE_OFF endet bei 0x4D000,
// K17_OFF faengt bei 0x50000 an. Genommen wird es hier zum ersten Mal.
//
//   +0x0000  die Skalare des Laders (`kernel/modul.fi`): Zaehler, der
//            letzte Grund, die Groessen des letzten Laufs
//   +0x0100  vier Modulsaetze zu je 0x80 Oktetten: Basis, Rahmenzahl,
//            Ein- und Aussprung, Steckplatz, Name
//   +0x0400  die Plaetze der ELF-Abschnitte waehrend des Ladens,
//            64 Eintraege zu acht Oktetten
//   +0x0800  DIE TREIBERTAFEL (`kernel/modtab.fi`): zwei Steckplaetze
//            zu je 64 Adressen. Sie ist das, was ein geladenes Modul
//            fuellt und was `kernel/ps2m-aus.fi` liest.
//   +0x1000  der Kopf der Moduldatei und Arbeitsplatz
//   +0x2000  frei
//
// WARUM DER LADER SEINEN ZUSTAND NICHT AUF DEM STAPEL HAELT: er wird aus
// `kmain.fi` gerufen, und der Kernstapel traegt gleichzeitig die
// Ed25519-Pruefung. Deren tiefster Rahmen misst 5264 Oktette (nachgesehen
// mit `--emit=asm`); alles, was daneben nicht sein muss, steht hier.
// RUNDE BLECH-ECHT: 0x4D000 haben sich ZWEI Runden genommen -- der
// EHCI-Regler der Runde BLECH und der Modullader hier, beide aus
// demselben Loch zwischen MODE_OFF und K17_OFF, beide zu Recht nach
// der Karte, die sie beim Abzweigen vorfanden. EHCI bleibt liegen
// (der Regler verlangt eine 4096-Ausrichtung mitten im Stueck), der
// Lader zieht hinter die Seiten der Runde HID: 0xA9000..0xAC000.
const MODUL_OFF: u64 = 0xA9000
const MODUL_MAX: u64 = 0x3000

const JR_OFF: u64 = 0x8000
const JR_MAX: u64 = 0x3000

// RUNDE K18. Die Woerter dieser Runde auf der Befehlszeile. Wie in jeder
// Runde davor sind die meisten davon GEGENPROBEN, und ohne sie beweist
// die Runde nichts:
//
//   `pwr`        die Energieschicht anschalten und den Selbsttest in
//                Ring 3 starten.
//   `nocstates`  der Leerlaufpfad nimmt NICHT `mwait`, sondern faellt auf
//                `hlt` zurueck. Der Zaehler PW_MWAITS muss dann null
//                bleiben und PW_HLTS steigen -- die Gegenprobe zu 4.2.
//   `nopwr`      die Schicht gar nicht erst erkunden. Dann darf kein
//                Profil, keine Temperatur und kein Akku gemeldet werden.
//   `pwrhot`     eine Temperatur ueber der Schwelle VORTAEUSCHEN, um den
//                Drosselpfad zu erreichen, ohne eine Tabelle zu haben.
//                Wird in der Abnahme NICHT fuer die Zusage benutzt --
//                dafuer steht die echte SSDT mit einer hohen Temperatur
//                bereit; das Wort ist nur zum Suchen von Fehlern da.
//   `noblank`    der Bildschirm geht NICHT von selbst aus.
const M_PWR: u64 = 321 // Wort 5, Bit 1
const M_NOCSTATES: u64 = 322 // Wort 5, Bit 2
const M_NOPWR: u64 = 323 // Wort 5, Bit 3
const M_PWRHOT: u64 = 324 // Wort 5, Bit 4
const M_NOBLANK: u64 = 325 // Wort 5, Bit 5
// `pwrdim` und `pwrblank` malen ein Pruefbild in den Rahmenpuffer und
// regeln danach die Helligkeit herunter beziehungsweise schalten ab. Sie
// sind fuer die Abnahme von 4.6 da: DASSELBE Bild, EIN Wort Unterschied,
// und der Bildpunkt an einer AUSGERECHNETEN Stelle muss genau den
// halbierten Wert tragen. Nicht "das Bild ist dunkler geworden" -- das
// waere wieder die Flaechenzaehlerei aus Runde K7B, die 87 Prozent
// Hintergrund fuer Text gehalten hat.
const M_PWRDIM: u64 = 326 // Wort 5, Bit 6
const M_PWRBLANK: u64 = 327 // Wort 5, Bit 7

// WORT 7, DAS DATEISYSTEM OFS UND DER RAHMENALLOKATOR. Die Runden MEM
// und OFS3 haben ihre Schalter angelegt, als der Modus noch EIN Wort
// war -- MEM nahm 1 << 54, OFS3 machte sich in `OFS3_OFF` ein zweites
// Moduswort auf, WEIL die 64 Bits nicht mehr reichten. Genau das ist
// die Not, gegen die Runde K17 den Modusvektor gebaut hat, also stehen
// beide jetzt darin, in einem eigenen Wort, und ein zweites Moduswort
// gibt es nicht mehr.
//
// ROUND MEM: the word `memstress` on the command line. It runs the
// frame stress test and the high probe and prints what they measured.
// It is a WORD and not the default, because two hundred thousand
// frames taken and given back is a second of boot that nobody needs
// twice.
const M_MEMSTRESS: u64 = 448 // Wort 7, Bit 0

// RUNDE DESKTOP. Die Woerter dieser Runde auf der Befehlszeile -- und
// wie in jeder Runde davor ist die Haelfte davon GEGENPROBE:
//
//   `desk`       Schreibtisch und Taskleiste starten
//                (/bin/desktop und /bin/taskbar).
//   `einst`      zusaetzlich /bin/settings.
//   `nolayer`    GEGENPROBE zu den Ebenen: `raise_win` achtet NICHT
//                mehr auf die Ebene. Dann kommt der Schreibtisch beim
//                ersten Klick nach vorn und verdeckt alles -- genau der
//                Zustand, den Logbuch K15 als "geht heute nicht"
//                beschrieben hat.
//   `nomin`      GEGENPROBE zum Minimieren: das Verbergen tut nichts.
//                Ein Fenster, auf dessen Leistenknopf geklickt wurde,
//                bleibt dann sichtbar.
//   `dhcp`       den DHCP-Klienten in Ring 3 starten (/bin/dhcp).
//   `nodhcp`     GEGENPROBE: derselbe Lauf ohne ihn -- die Adresse
//                bleibt die statische aus `inet.init`.
// RUNDE DESKTOP, in den Modusvektor der Runde K17 eingehaengt. Diese
// Runde hatte 1 << 54 bis 1 << 59 genommen -- und 1 << 54 hatten die
// Runden MEM und SPEICHER auch schon genommen. DREI Runden auf demselben
// Bit; keine von ihnen konnte es sehen, weil keine zwei von ihnen je in
// einem Baum lagen. Der Schreibtisch, die Einstellungen und die zwei
// Gegenproben gehoeren in das Wort der OBERFLAECHE (Wort 1, wie K10 und
// K15); der DHCP-Klient macht das Wort des NETZES auf (Wort 8), in dem
// die Netzrunden danach weiterzaehlen.
const M_DESK: u64 = 81 // Wort 1, Bit 17
const M_EINST: u64 = 82 // Wort 1, Bit 18
const M_NOLAYER: u64 = 83 // Wort 1, Bit 19
const M_NOMIN: u64 = 84 // Wort 1, Bit 20
const M_DHCP: u64 = 512 // Wort 8, Bit 0
const M_NODHCP: u64 = 513 // Wort 8, Bit 1
// RUNDE NETVIEW, NACHTRAG: `netvdemo` startet drei Programme unter drei
// Netzsichten, damit ein Bildschirmfoto vier gleichzeitig laufende
// Anwendungen in vier Sichten zeigen kann. Es ist ein MESSWORT wie
// `wmhold` und `wiglong` und kein Bestandteil des Schreibtischs. Die
// Runde hatte 1 << 62 gewaehlt; im Modusvektor der Runde K17 gehoert
// es in das Wort des NETZES, das die Runde DESKTOP aufgemacht hat.
const M_NETVDEMO: u64 = 514 // Wort 8, Bit 2

// ADDENDUM TASKBAR. Two more words, and the second is the counter-test
// without which the first proves nothing:
//
//   `wmax`     maximize the topmost ordinary window one second into the
//              hold, so that the screenshot shows a maximized window
//              next to the taskbar and the two rectangles can be
//              compared. The bar itself is not touched.
//   `nostrut`  COUNTER-TEST: the server ignores every strut. The work
//              area is the whole screen again, the maximized window
//              covers the taskbar, and the taskbar disappears from the
//              picture -- exactly the state this addendum removes.
// RUNDE TASKBAR-EDGE, in den Modusvektor der Runde K17 eingehaengt.
// Beides gehoert zur Oberflaeche, also in deren Wort.
const M_WMAX: u64 = 85 // Wort 1, Bit 21
const M_NOSTRUT: u64 = 86 // Wort 1, Bit 22

// RUNDE THEME, in den Modusvektor der Runde K17 eingehaengt: die
// alten Masken 1 << 60 und 1 << 61 gehoerten schon der Runde
// TASKBAR-EDGE (M_WMAX, M_NOSTRUT). Beides ist Oberflaeche, also
// Wort 1.
// RUNDE THEME: `themegui` startet /bin/themetest im Schreibtisch, mit
// einem eigenen Fenster. Nur so laesst sich das Umschalten MESSEN,
// waehrend wirklich etwas auf dem Bildschirm steht -- ein Umschalten
// ohne Fenster faerbt eine Tabelle um und sagt nichts ueber die Zeit,
// die ein Bild kostet.
const M_THEMEGUI: u64 = 93 // Wort 1, Bit 29
// `themeshot` ist dasselbe Fenster OHNE die Messung. Es muss ein
// eigenes Wort sein: der Messlauf schaltet zwanzig Mal um, und ein
// Bildschirmfoto, das waehrenddessen entsteht, zeigt einen Zustand
// zwischen zwei Themen. Genau das ist beim ersten Versuch passiert --
// hell und dunkel hatten dieselbe Farbverteilung.
const M_THEMESHOT: u64 = 94 // Wort 1, Bit 30

// RUNDE TRESOR. `hwid` laesst die Geraeteidentitaet auf die serielle
// Leitung schreiben -- ohne das Wort wird sie gelesen und still gehalten.
// `hwidefi` ist die GEGENPROBE zum EFI-Weg: der Testlauf baut eine
// EFI-Systemtafel VON HAND in den Speicher und laesst `hwid.from_efi`
// sie gehen. Ohne das Wort wird dieser Pfad nie betreten, weil Multiboot 1
// keine Systemtafel liefert.
// RUNDE TRESOR, in den Modusvektor der Runde K17 eingehaengt. 1 << 54
// und 1 << 55 hatten vier andere Runden auch schon gewaehlt. Die
// Geraeteidentitaet macht Wort 9 auf -- sie ist weder Oberflaeche noch
// Netz noch Dateisystem.
const M_HWID: u64 = 576 // Wort 9, Bit 0
const M_HWIDEFI: u64 = 577 // Wort 9, Bit 1

// RUNDE SERVERBUILD: Wort 10, und es ist das erste, das benutzt wird.
// `console=ttyS0` schaltet die serielle Konsole ein -- Eingabe ueber
// IRQ 4, und ein `read` auf der Konsole wartet dann WIRKLICH, statt
// nach vier Sekunden das Ende der Eingabe zu melden.
const M_SERCON: u64 = 646 // Wort 10, Bit 6
// RUNDE MERGE-2: die drei Bits dieser Runde standen auf 640..642 --
// dort, wo Runde HANDLE ihre sechs hingelegt hat. Beide Runden haben
// Wort 10 als frei vorgefunden, und beide hatten recht. Die drei hier
// ruecken hinter den Block von HANDLE, auf 646..648.
// GEGENPROBE: der Vektor wird nicht eingetragen. Dann kommt kein
// Oktett an, und jede Zusage dieses Abschnitts muss einstuerzen.
const M_NOSERIRQ: u64 = 647 // Wort 10, Bit 7
// Der zweite Weg: nachsehen statt sich rufen lassen. Ein Kernel, der
// die Leitung nur abfragt, verliert nichts, solange er oft genug
// nachsieht -- und das ist die Gegenprobe zur Gegenprobe.
const M_SERPOLL: u64 = 648 // Wort 10, Bit 8

// Runde K12 hat kdata von 0x40000 auf 0x50000 wachsen lassen, Runde K18
// von 0x50000 auf 0x60000 -- ihr Vorrat (0x58000..0x60000) liegt hinter
// der alten Grenze. Dieselbe Zahl steht in kernel/boot.s und
// tools/hv/run.sh vergleicht beide.
// RUNDE OFS3: 0x60000 -> 0x70000. Siehe UIO_OFF. Die Zahl steht
// ZWEIMAL -- hier und in `kernel/boot.s` --, und `tools/hv/run.sh`
// liest beide und vergleicht sie.

// ================================================ RUNDE HANDLE
//
// DIE HANDLE-SCHICHT (`kernel/handle.fi`). Sie liegt im letzten freien
// Stueck von `kdata` -- 0x7B000 bis 0x80000 waren nach Runde HWNET die
// einzigen fuenf Seiten, die noch niemandem gehoerten, und diese Runde
// braucht davon vier und ein Achtel:
//
//   HND_OFF   0x7B000  die Handle-Plaetze, 32 Aufgaben * 16 * 24 Oktett
//   HOBJ_OFF  0x7E000  die Objekttafel, 64 Eintraege * 40 Oktett
//   HREQ_OFF  0x7EA00  die Auftragstafel (Abbruch-Token), 64 * 32
//   HNON_OFF  0x7F200  der Wuerfelwert je Aufgabe, 32 * 8
//   HCNT_OFF  0x7F300  die Zaehler dieser Runde, 16 Woerter
//
// Wer hier etwas aendert, traegt es in `tools/kernel/memmap.py` ein --
// das ist die Stelle, an der dieses Projekt viermal denselben Fehler
// gemacht hat.
const HND_OFF: u64 = 0x80000
const HND_MAX: u64 = 0x3000
const HOBJ_OFF: u64 = 0x83000
const HOBJ_MAX: u64 = 0xA00
const HREQ_OFF: u64 = 0x83A00
const HREQ_MAX: u64 = 0x800
const HNON_OFF: u64 = 0x84200
const HNON_MAX: u64 = 0x100
const HCNT_OFF: u64 = 0x84300
const HCNT_MAX: u64 = 0x80

// Die Modusbits dieser Runde. Wort 10 war ganz frei -- ein Wort je
// Untersystem ist die Regel seit Runde K17, und die Handle-Schicht ist
// weder Oberflaeche noch Netz noch Dateisystem.
//
// M_HANDLE ist der Selbsttest in Ring 3. Die vier anderen sind
// GEGENPROBEN, und ohne sie beweist diese Runde nichts:
//
//   M_NOGEN    die Generation wird beim Aufloesen NICHT verglichen.
//              Genau der io_uring-Fehler: ein alter Auftrag trifft nach
//              Wiederverwendung des Platzes das NEUE Objekt. Der Test
//              "veraltet" MUSS damit fallen.
//   M_NOFLIGHT ein laufender Auftrag haelt KEINEN Verweis. Das Objekt
//              wird waehrend des Auftrags freigegeben; der Test
//              "kein Free waehrend in Flug" MUSS damit fallen.
//   M_NORIGHTS die Rechte des Handles werden im Deskriptorpfad NICHT
//              geprueft -- die zweite Haelfte der Tiefenstaffelung
//              faellt weg, die uid/gid-Pruefung bleibt.
//   M_HSTRICT  NICHTS wird geerbt ausser dem, was ausdruecklich
//              uebergeben wurde. Kein Kind bekommt 0, 1 und 2 geschenkt.
const M_HANDLE: u64 = 640 // Wort 10, Bit 0
const M_NOGEN: u64 = 641 // Wort 10, Bit 1
const M_NOFLIGHT: u64 = 642 // Wort 10, Bit 2
const M_NORIGHTS: u64 = 643 // Wort 10, Bit 3
const M_HSTRICT: u64 = 644 // Wort 10, Bit 4
const M_HBENCH: u64 = 645 // Wort 10, Bit 5

// Die Zaehler der Runde HANDLE. Sie stehen als SKALARE hier und nicht in
// HCNT_OFF, weil sie aus den Testlaeufern gelesen werden wie jeder
// andere Zaehler dieses Kernels auch. Die Versaetze 1400 aufwaerts waren
// frei; der hoechste vergebene Skalar davor ist 1392.
const H_CHECKS: u64 = 1400 // Aufloesungen eines Handles, gesamt
const H_DENIED: u64 = 1408 // davon abgelehnt, weil ein Recht fehlte
const H_STALE: u64 = 1416 // davon abgelehnt, weil die Generation nicht passte
const H_CANCELS: u64 = 1424 // abgebrochene Auftraege
const H_INFLIGHT: u64 = 1432 // BEGONNENE Auftraege (monoton, siehe req_end)
const H_DEFERRED: u64 = 1440 // Freigaben, die ein Auftrag aufgehalten hat
const H_OPENED: u64 = 1448 // angelegte Objekte
const H_CLOSED: u64 = 1456 // abgeraeumte Objekte
const H_PASSED: u64 = 1464 // ausdruecklich an ein Kind uebergebene Handles
const H_ESCALATE: u64 = 1472 // versuchte Rechteerweiterung beim Weitergeben

// RUNDE BLECH-ECHT: 640 -> 704 KiB. Die Runde HID ist vor Merge 2
// abgezweigt und hat sich 0x92000..0x9B000 genommen, weil kstate.fi
// das damals als frei auswies; seit Runde ASYNC liegen dort AIO, ACQ
// und ASC. Statt einer der beiden Runden ihre Seiten wegzunehmen,
// waechst kdata um 64 KiB -- genau das, was Merge 2 schon einmal
// getan hat (512 -> 640). kdata steht in .bss (boot.s), das Abbild
// wird davon NICHT groesser; es wird beim Start genullt.
const KDATA_SIZE: u64 = 0xC0000
// =============================================== RUNDE MULTIUSER
//
// EINE SEITE ZAEHLER UND EINE SEITE GRUPPEN, bei 0x7A000. Das ist der
// Anfang des letzten freien Stuecks der Karte (0x7A000..0x80000, 24
// KiB, siehe `python3 tools/kernel/memmap.py kernel -v`); die vier
// Kilooktette dahinter bleiben frei und stehen in der Karte, damit die
// naechste Runde bei 0x7C000 anfaengt und nicht hier.
//
// WARUM DIE ZUSATZGRUPPEN NICHT IM AUFGABENSATZ LIEGEN, obwohl Runde
// K13 zwoelf Zeilen darauf verwendet hat zu begruenden, dass ein
// Prozessattribut in den Satz des Prozesses gehoert -- und die
// Begruendung stimmt weiter:
//
//     Der Satz ist 512 Oktette gross (`TASK_BYTES`). K13 hat 392..440
//     belegt, Runde K16 nahm 448 (`T_BIG`), Runde NETVIEW 448..503
//     (`T_NETV`, `T_NETOK` mit sechs Woertern). Frei ist GENAU EIN
//     WORT: 504. Sechzehn Zusatzgruppen brauchen sechzehn.
//
// Also liegt im Satz das, was hineinpasst und was zaehlt: die ANZAHL
// (`T_NGROUPS` bei 504). Sie ist null, wenn `sched.create` den Satz
// nullt, und null heisst "keine Zusatzgruppen" -- ein Prozess, den es
// vor dieser Runde gab, verhaelt sich also genau wie vorher. Die
// Kennungen selbst stehen hier, MAX_TASKS mal MU_GRPMAX Woerter, und
// `sched.create` schreibt sie mit derselben Zeile mit, mit der es die
// Kennungen erbt. Die Gefahr, die K13 beschreibt -- eine zweite
// Tabelle, die jemand zu loeschen vergisst -- ist damit nicht weg,
// sondern benannt: es gibt genau EINE Stelle, die sie fuellt
// (`sched.groups_inherit`), und genau EINE, die sie leert
// (`sched.groups_clear`), und beide stehen in `sched.fi`.
// RUNDE MERGE-2: hier stand 0x7A000. Der Satz darueber -- "der Anfang
// des letzten freien Stuecks der Karte" -- war auf dem Zweig MULTIUSER
// wahr und ist es auf main nicht mehr: dort liegt seit Runde HWNET die
// Netzkarten-Auswahl, und AHCI und HANDLE haben den Rest genommen.
// `tools/kernel/memmap.py` hat die Ueberschneidung gemeldet. Die zwei
// Seiten liegen jetzt in dem Raum, den Merge 06 geschaffen hat, als er
// KDATA_SIZE auf 0xA0000 vergroessert hat -- hinter der Aufgabentafel,
// die dort seit Merge 08 auf 0x88000..0x90000 liegt.
const MU_OFF: u64 = 0x90000
const MU_MAX: u64 = 0x2000
// Die Zusatzgruppen: MAX_TASKS * MU_GRPMAX * 8 = 32 * 16 * 8 = 4096
// Oktette, also genau die zweite Seite.
const MU_GRP: u64 = 0x1000
const MU_GRPMAX: u64 = 16

// Die Zaehler, Versatz INNERHALB von MU_OFF. Ohne sie ist "der Pfad
// wird geprueft" eine Behauptung ueber sich selbst.
const MU_WALKS: u64 = 0x00 // Pfade, die durch perm.walk gingen
const MU_WALKDENY: u64 = 0x08 // davon am Betretungsrecht gescheitert
const MU_GRPHITS: u64 = 0x10 // Zugriffe, die eine ZUSATZgruppe erlaubte
const MU_SUPPSET: u64 = 0x18 // erfolgreiche setgroups
const MU_NODECHK: u64 = 0x20 // Rechtefragen ueber die VFS-Schicht
const MU_TRIES: u64 = 0x28 // Anmeldeversuche, die der Kern gesehen hat
const MU_DELAYMS: u64 = 0x30 // Millisekunden, die dabei verzoegert wurden

// DREI WOERTER, ZWEI DAVON GEGENPROBEN. Wort 10 ist frei (siehe
// `MODE_FREE` im Kartenpruefer: 10..15).
//
//   `mu`         den Selbsttest dieser Runde melden lassen.
//   `nowalk`     GEGENPROBE: das Betretungsrecht wird nicht geprueft --
//                also genau der Zustand VOR dieser Runde. Der Zugriff,
//                der scheitern MUSS, gelingt dann, und die Messung
//                bricht zusammen. Gezaehlt wird trotzdem.
//   `nogroups`   GEGENPROBE: Zusatzgruppen werden nicht beachtet. Die
//                Datei, die nur ueber eine Zusatzgruppe zu haben ist,
//                bleibt dann zu.
// RUNDE MERGE-2: DIE DRITTE RUNDE AN WORT 10, BIT 0. Vor MULTIUSER
// haben HANDLE (640..645) und SERVERBUILD (jetzt 646..648) dieselben
// drei Bits genommen; alle drei Runden haben Wort 10 als frei
// vorgefunden und alle drei bei Bit 0 angefangen. Diese ruecken auf
// 649..651. `tools/kernel/memmap.py` zaehlt es nach.
const M_MU: u64 = 649 // Wort 10, Bit 9
const M_NOWALK: u64 = 650 // Wort 10, Bit 10
const M_NOGROUPS: u64 = 651 // Wort 10, Bit 11

// ================================================ RUNDE ASYNC
//
// DIE ASYNCHRONE AUFTRAGSSCHICHT (`kernel/async.fi`). Sie ist die
// Zwischenstufe zwischen den Handles der Runde HANDLE und dem
// Completion-Ring der Runde RING, und sie braucht drei Bereiche.
//
// RUNDE MERGE-2 -- FUENFTE ADRESSKOLLISION DIESER RUNDE. Auf dem Zweig
// ASYNC war `kdata` nach Runde HANDLE bis 0x7F380 belegt und 0x80000
// die Grenze; der Zweig liess sie auf 0x90000 wachsen und legte seine
// vier Bereiche auf 0x80000..0x8D000. In `mergeline2` steht dort
// laengst etwas anderes: HND/HOBJ/HREQ/HNON/HCNT ab 0x80000 (Merge 06,
// Runde HANDLE), die Aufgabentafel TASK_OFF 0x88000..0x90000 (Merge
// 08) und MU_OFF 0x90000..0x92000 (Merge 09, Runde MULTIUSER). Alle
// vier Bereiche haetten sich ueberschnitten -- `tools/kernel/memmap.py`
// meldet es.
//
// KDATA_SIZE muss deshalb NICHT wachsen: Merge 06 hat sie bereits auf
// 0xA0000 gesetzt. Die vier Bereiche liegen jetzt HINTER MULTIUSER, in
// dem Raum 0x92000..0xA0000 (56 KiB); sie brauchen 0xD000 (52 KiB) und
// lassen 0x9F000..0xA0000 frei.
//
//   AIO_OFF  0x92000  die Auftragstafel, 64 Auftraege * 80 Oktett
//   ACQ_OFF  0x94000  die Fertigmeldungsringe, 32 Aufgaben * 1024 Oktett
//   ASC_OFF  0x9C000  die Sperre und der Vorrat dieser Runde
//   APATH_OFF 0x9D000 der Pfadvorrat, 64 * 128 Oktett
//
// Wer hier etwas aendert, traegt es in `tools/kernel/memmap.py` ein.
const AIO_OFF: u64 = 0x92000
const AIO_MAX: u64 = 0x2000
const ACQ_OFF: u64 = 0x94000
const ACQ_MAX: u64 = 0x8000
const ASC_OFF: u64 = 0x9C000
const ASC_MAX: u64 = 0x1000
// Der Pfadvorrat der asynchronen `open`: 64 Auftraege zu 128 Oktett.
// WARUM ER SEIN MUSS: ein `open` bekommt seinen Pfad als Zeiger in
// Ring 3, und der Arbeitsfaden liest ihn erst spaeter -- da kann der
// Prozess den Puffer laengst ueberschrieben haben oder gar nicht mehr da
// sein. Der Pfad wird deshalb BEI DER ABGABE in den Kern kopiert, im
// Zusammenhang des Abgebenden. Das ist dieselbe Regel wie bei den
// registrierten Puffern von io_uring, nur eine Nummer kleiner.
const APATH_OFF: u64 = 0x9D000
const APATH_MAX: u64 = 0x2000
const APATH_STRIDE: u64 = 128

// Die Modusbits dieser Runde. Wort 11 war ganz frei -- Wort 10 gehoert
// der Handle-Schicht, und ein Wort je Untersystem ist die Regel seit
// Runde K17.
//
// M_ASYNC ist der Selbsttest in Ring 3. Die uebrigen sind GEGENPROBEN
// und eine Messung:
//
//   M_NOAGEN   der Arbeitsfaden fragt NICHT `handle.req_object`,
//              sondern nimmt, was gerade unter dem Handle steht.
//              Genau der io_uring-Fehler, eine Ebene hoeher: Zusage
//              `nicht-das-neue-ding` MUSS damit fallen.
//   M_NOAREAP  ein sterbender Prozess raeumt seine Auftraege NICHT ab.
//              Die Zusage `tod-raeumt-ab` MUSS damit fallen.
//   M_NOAWORK  es laufen KEINE Arbeitsfaeden -- der Auftrag wird vom
//              abgebenden Prozess selbst ausgefuehrt. Das ist die
//              Gegenprobe zur Behauptung, dass die Arbeit wirklich
//              woanders geschieht, und zugleich der Massstab der
//              Durchsatzmessung.
//   M_ABENCH   die Messung: Latenz und Durchsatz bei 1, 4 und 16
//              gleichzeitig offenen Auftraegen.
//   M_ASTRESS  der Lauf, der die Warteschlange absichtlich ueberfuellt.
const M_ASYNC: u64 = 704 // Wort 11, Bit 0
const M_NOAGEN: u64 = 705 // Wort 11, Bit 1
const M_NOAREAP: u64 = 706 // Wort 11, Bit 2
const M_ABENCH: u64 = 707 // Wort 11, Bit 3
const M_NOAWORK: u64 = 708 // Wort 11, Bit 4
const M_ASTRESS: u64 = 709 // Wort 11, Bit 5

// ===================================================== RUNDE BLECH
//
// Wort 12, das erste der vier, die `tools/kernel/memmap.py` bis zu
// dieser Runde als frei ausgewiesen hat. `ehci` zieht den
// USB-2.0-Regler hoch, `ehcitest` liest zusaetzlich einen Block vom
// Stick und druckt seine Oktettsumme -- getrennt, weil der Lesetest
// eine Platte braucht und die Aufzaehlung nicht.
const M_EHCI: u64 = 768 // Wort 12, Bit 0
const M_EHCITEST: u64 = 769 // Wort 12, Bit 1
// NACHTRAG: die Plattentabelle und die Selbstauskunft der Treiber.
const M_BLKTAB: u64 = 770 // Wort 12, Bit 2
const M_BLKSELF: u64 = 771 // Wort 12, Bit 3
// RUNDE MODUL: `modul` auf der Kommandozeile. Wort 11, Bit 6 -- das
// erste freie Bit hinter Runde ASYNC. Ohne dieses Wort ist der ganze
// Modullader EINE gedruckte Zeile und sonst nichts; jede Messung der
// Runden 59 bis CERTUS sieht den Kern, den sie gesehen hat.
const M_MODUL: u64 = 710 // Wort 11, Bit 6
// GEGENPROBE ZUM LADEN: `modulaus` entlaedt das Modul wieder und misst
// danach dasselbe noch einmal. Ein Entladen, das nichts entlaedt, faellt
// genau daran auf.
const M_MODULAUS: u64 = 711 // Wort 11, Bit 7

// Die Zaehler der Runde ASYNC. 1480 aufwaerts war frei; der hoechste
// vergebene Skalar davor ist 1472 (H_ESCALATE).
const A_SUBMITTED: u64 = 1480 // abgegebene Auftraege
const A_COMPLETED: u64 = 1488 // ordentlich fertig gewordene
const A_CANCELLED: u64 = 1496 // abgebrochene
const A_STALED: u64 = 1504 // an der Generationspruefung gescheiterte
const A_FAILED: u64 = 1512 // mit einem Fehler geendete
const A_FULL: u64 = 1520 // Abgaben, die an der vollen Warteschlange scheiterten
const A_TIMEOUTS: u64 = 1528 // Wartevorgaenge, die an der Zeitgrenze endeten
const A_REAPED: u64 = 1536 // abgeholte Fertigmeldungen
const A_ABANDONED: u64 = 1544 // beim Prozesstod abgeraeumte Auftraege
const A_WORKRUNS: u64 = 1552 // Durchlaeufe der Arbeitsfaeden mit Arbeit
const A_POSTED: u64 = 1560 // eingestellte Fertigmeldungen
const A_DENIED: u64 = 1568 // Zugriffe auf einen fremden Auftrag

// ===================================================== RUNDE AVX
//
// Die Skalare der Vektorregister-Schicht (`kernel/arch/x86_64/fpu.fi`).
// Sie liegen in der SKALARSEITE (Offset 0..4096) und nehmen keine neue
// Seite in `kdata` -- der hoechste bis dahin vergebene Skalar war
// A_DENIED auf 1568, und ab 1600 ist die Seite frei. Damit aendert diese
// Runde `tools/kernel/memmap.py` nicht und liegt keiner anderen Runde im
// Weg, die gerade eine Seite sucht.
const FPU_WORDS: u64 = 1600 // nofpu/nofpuswitch/fpulazy/noxsave/noavx
const FPU_MODE: u64 = 1608 // 0 aus, 1 FXSAVE, 2 XSAVE, 3 XSAVEOPT
const FPU_XCR0: u64 = 1616 // die Maske, die wirklich in XCR0 steht
const FPU_SIZE: u64 = 1624 // Oktette je Bereich, aus cpuid 0x0D
const FPU_APS: u64 = 1632 // weitere Prozessoren mit gesetzten Bits
const FPU_CR4: u64 = 1640 // das CR4 des Startprozessors, zum Melden
const FPU_SAVES: u64 = 1648 // gesicherte Zustaende
const FPU_RESTORES: u64 = 1656 // geladene Zustaende
const FPU_NM: u64 = 1664 // #NM-Faelle auf dem traegen Weg
const FPU_AREAS: u64 = 1672 // angelegte Bereiche
const FPU_FEAT: u64 = 1680 // cpuid Blatt 1: ECX<<32 | EDX


// ================================================== DER MODUSVEKTOR
//
// WARUM ES IHN GIBT. Der Modus war achtzehn Runden lang EIN u64, und
// jede Runde nahm sich Bits daraus. Am 26.08.2026 lief die Rechnung auf:
// 57 Namen auf 60 von 64 Bits, vier frei (38, 61, 62, 63) -- und Runde
// K17 brauchte neun. Gleichzeitig lagen die Bits von K13, K14 und K16
// UEBEREINANDER, weil drei Zweige unabhaengig bei 1 << 31 angefangen
// hatten; die Gegenprobe `novfs` schaltete damit auch das
// Stapelwachstum ab, und acht Zusagen von K14 fielen an einem Fehler,
// der in keiner gemeinsamen Zeile stand. Das ist genau der Fehler, den
// dieses Projekt bei `kdata` viermal und bei der Vektortafel einmal
// gemacht hat -- eine Ebene hoeher.
//
// WARUM NICHT EINFACH BREITER. Ein zweites Wort haette dieselbe Rechnung
// nur um achtzehn Runden verschoben und gegen das ZWEITE Problem gar
// nichts getan: zwei Zweige, die unabhaengig "das naechste freie Bit"
// nehmen, nehmen dasselbe. Beides verschwindet erst, wenn nicht mehr
// EIN Vorrat verteilt wird, sondern JEDES UNTERSYSTEM SEINEN EIGENEN
// hat -- dieselbe Regel, nach der `kdata` seit Runde K12 in Seiten
// vergeben wird, und dieselbe, nach der `hw.fi`, `fb.fi`, `hv.fi`,
// `guard.fi`, `smp.fi` und `bootmod.fi` seit jeher ein eigenes
// Moduswort fuehren. Neu ist nur, dass der GEMEINSAME Modus es jetzt
// auch tut.
//
// WIE ES AUSSIEHT. `MODE_OFF` ist eine Seite in `kdata` mit MODE_WORDS
// Woertern. Ein Modusname ist ein BITINDEX ueber diesem Feld:
//
//     Index = Wort * 64 + Bit
//
// Gelesen wird mit `mode_on(state, M_X)`, gesetzt mit
// `mode_add(state, M_X)`; eine Maske steht nirgends mehr im Quelltext.
// Weil der Index das Wort ENTHAELT, prueft `tools/kernel/memmap.py` den
// neuen Raum mit derselben Regel wie den alten -- derselbe Name darf
// mehrfach dastehen, zwei verschiedene Namen nicht auf demselben Index
// -- und zusaetzlich, dass jeder Index unter MODE_WORDS * 64 bleibt.
// Eine vergessene alte Maske (2147483648) faellt damit sofort auf.
//
// DIE TAFEL DER WOERTER. Ein Wort gehoert einem UNTERSYSTEM, nicht einer
// Runde: wer eine bestehende Schicht erweitert, nimmt ein freies Bit in
// deren Wort; wer eine neue Schicht aufmacht, nimmt ein neues Wort. Zwei
// Runden, die gleichzeitig laufen, koennen sich damit nicht mehr in die
// Quere kommen, solange sie verschiedene Woerter haben.
//
//   Wort  0    0.. 63  DER KERN -- Trap-Art (Bits 0..2 sind ein FELD,
//                      kein Schalter: 1 #DE, 2 #PF, 3 #GP, 4 #DF) und
//                      die Grundschalter aus `kmain.fi`. Bits 3..7 und
//                      23..63 sind frei.
//   Wort  1   64..127  DIE OBERFLAECHE -- Runde K10 (Maus, Fensterserver,
//                      Schriften) und Runde K15 (Widgets, Dateimanager,
//                      Starter, Speicherplatzanalyse) und Runde DESKTOP
//                      (Schreibtisch, Einstellungen) und Runde
//                      TASKBAR-EDGE, TILING, THEME, ICONS und
//                      I18N. Frei ab Bit 33.
//   Wort  2  128..191  BENUTZER UND RECHTE -- Runde K13. Frei ab Bit 6.
//   Wort  3  192..255  DIE DATEISYSTEME -- Runde K14 (VFS, /proc, /dev,
//                      FAT32, Partitionen). Frei ab Bit 8.
//   Wort  4  256..319  SPEICHER UND PROZESSE -- Runde K16 (die grosse
//                      Arena, das Stapelwachstum). Frei ab Bit 2.
//   Wort  5  320..383  ENERGIE, ABSCHALTUNG UND ACPI -- `noacpi` aus
//                      Runde K13 und die Energieschicht aus Runde K18.
//                      Frei ab Bit 8.
//   Wort  6  384..447  USB -- Runde K17 (xHCI, der USB-Kern, HID,
//                      Massenspeicher).
//   Wort  7  448..511  DAS DATEISYSTEM OFS UND DER RAHMENALLOKATOR --
//                      Runde MEM (`memstress`) und Runde OFS3
//                      (`nolinks`, `ofs3`, `ofs3fmt`, `noatime`).
//                      Frei ab Bit 5.
//   Wort  8  512..575  DAS NETZ -- der DHCP-Klient der Runde DESKTOP
//                      und die Netzsichten der Runde NETVIEW.
//                      Frei ab Bit 3.
//   Wort  9  576..639  DIE GERAETEIDENTITAET -- Runde TRESOR.
//                      Frei ab Bit 2.
//   Wort 10  640..703  DIE HANDLE-SCHICHT (Runde HANDLE, 640..645), der
//                      serielle Serverbau (SERVERBUILD, 646..648) und
//                      die Mehrbenutzerschicht (MULTIUSER, 649..651).
//                      Frei ab Bit 12.
//   Wort 11  704..767  DIE ASYNCHRONE AUFTRAGSSCHICHT -- Runde ASYNC.
//                      Frei ab Bit 6.
//   Wort 12..15        FREI. Wird auch das knapp, waechst MODE_WORDS;
//                      die Seite fasst 512 Woerter.
//
// Die Namen selbst stehen bei ihrer Runde, dort wo auch steht, wofuer
// sie da sind -- verstreut ueber diese Datei, aber alle IN DIESER DATEI.
// `kmain.fi` fuehrt seit dieser Runde KEINE eigenen Modusnamen mehr;
// genau diese zweite Liste war der Grund, warum ein zu enger `grep` die
// Kollisionen nicht fand.

// ------------------------------------------------------ the command line

// WORT 0, DER KERN. Die Schalter, die es schon vor den benannten Runden
// gab; sie standen bis Runde K17 in `kmain.fi` und stehen jetzt hier,
// damit der Modusraum an EINER Stelle steht. Die Zahlen sind Bitindizes
// in Wort 0 und damit dieselben Bitnummern wie vorher.
const M_NOKBD: u64 = 8 // Wort 0, Bit 8 -- keine Tastatur in diesem Lauf
const M_NORING3: u64 = 9 // Wort 0, Bit 9 -- kein Ausflug nach Ring 3
const M_NOTIMER: u64 = 10 // Wort 0, Bit 10 -- kein Zeitgeber
const M_R3FAULT: u64 = 11 // Wort 0, Bit 11 -- Ring 3 loest einen Fehler aus
const M_NOSCHED: u64 = 12 // Wort 0, Bit 12 -- kein Scheduler
const M_NOPREEMPT: u64 = 13 // Wort 0, Bit 13 -- keine Verdraengung
const M_NOPROC: u64 = 14 // Wort 0, Bit 14 -- keine Prozesse
const M_NOFS: u64 = 15 // Wort 0, Bit 15 -- kein Dateisystem
const M_ATA: u64 = 16 // Wort 0, Bit 16 -- die echte Platte ueber ATA PIO
const M_OSUM: u64 = 17 // Wort 0, Bit 17 -- Platte einhaengen, /bin/sh starten
const M_NOBSS: u64 = 18 // Wort 0, Bit 18 -- GEGENPROBE: NICHT nullen, was
// die Datei offen laesst -- das Giftmuster bleibt sichtbar
const M_CAPS: u64 = 19 // Wort 0, Bit 19 -- die Capability-Schicht

// ROUND K9. Two of the three are GEGENPROBEN and nothing else: without
// them the round proves nothing.
//
//   `unix`     run the self-test of round K9 (signals, tty, clock,
//              random) -- as `caps` does it for the capability layer.
//   `nosig`    do not DELIVER any signal. Everything else stays: `kill`
//              still says 0, the pending bit is still set. The counter of
//              the program that counts its SIGINTs has to stay at zero.
//   `fixedrand` the generator hands out the same octet for ever. The
//              statistical check has to FAIL -- a check that cannot fail
//              measures nothing.
const M_UNIX: u64 = 20 // Wort 0, Bit 20
const M_NOSIG: u64 = 21 // Wort 0, Bit 21
const M_FIXRAND: u64 = 22 // Wort 0, Bit 22
// beweist die Runde nichts:
//
//   `wm`       Maus, Fensterserver und Schriften anschalten.
//   `nodirty`  das ganze Bild neu zusammensetzen statt nur die
//              schmutzigen Bereiche. Die Messung MUSS dabei deutlich
//              schlechter werden -- sonst misst die Bereichsverfolgung
//              nichts.
//   `nofocus`  Tastendruecke gehen an ALLE Fenster statt nur an das mit
//              dem Eingabefokus. Die Zusage "die Taste kommt beim
//              richtigen Fenster an" ist genau dann etwas wert, wenn sie
//              hiermit zusammenbricht.
//   `nomouse`  kein Zeigegeraet. Der Zeiger darf dann nicht im Bild
//              stehen.
//   `wmhold`   am Ende stillhalten, damit ein Bildschirmfoto entsteht.
//   `wmshell`  im Terminalfenster wirklich /bin/sh starten.
const M_WM: u64 = 64 // Wort 1, Bit 0
const M_NODIRTY: u64 = 65 // Wort 1, Bit 1
const M_NOFOCUS: u64 = 66 // Wort 1, Bit 2
const M_NOMOUSE: u64 = 67 // Wort 1, Bit 3
const M_WMHOLD: u64 = 68 // Wort 1, Bit 4
const M_WMSHELL: u64 = 69 // Wort 1, Bit 5
// nur auf IRQ 12. Die Gegenprobe zu dem Rueckfall, den QEMU noetig macht.
const M_NOMPOLL: u64 = 70 // Wort 1, Bit 6
const M_TTFDUMP: u64 = 71 // Wort 1, Bit 7
// Das ist die Gegenprobe zu ihr: mit dem Wort MUSS der Uebersetzer an
// dem Punkt stehenbleiben, an dem er mehr Speicher haben will als die
// alte Halde hergibt. Bleibt er es nicht, hat er die Arena nie gebraucht
// und sie beweist nichts.
const M_NOBIG: u64 = 256 // Wort 4, Bit 0
// `proc.grow_stack`: damit muss der Uebersetzer an derselben Stelle
// sterben wie vor dieser Runde, und der Zaehler STACKGROW bleibt bei
// null. Ein Stapel, der auch ohne die Eigenschaft reicht, beweist
// nichts.
const M_NOSTACK: u64 = 257 // Wort 4, Bit 1
// `wigfiles` den Dateimanager. Die Gegenproben stehen daneben:
// `wignohit` nimmt der Bibliothek die Trefferpruefung (ein Klick landet
// bei keinem Widget), `wignoclip` die Zwischenablage. Beide werden der
// Anwendung als ARGUMENT mitgegeben und nicht als Kernelmodus -- die
// Eigenschaft, die abgeschaltet wird, liegt in Ring 3.
const M_WIG: u64 = 72 // Wort 1, Bit 8
const M_WIGFILES: u64 = 73 // Wort 1, Bit 9
const M_WIGNOHIT: u64 = 74 // Wort 1, Bit 10
const M_WIGNOCLIP: u64 = 75 // Wort 1, Bit 11
const M_WIGLONG: u64 = 76 // Wort 1, Bit 12

// ================== RUNDE MESSTAFEL: DIE SPRACHE AUS DEM BOOTMENUE
//
// Justin hat gefragt, warum die Oberflaeche deutsch ist, und die
// ehrliche Antwort war: weil `tools/usbimg/build.sh` `de` nach
// /users/root/config/locale schreibt und es KEINEN Weg gab, das beim
// Start zu aendern. Beide Kataloge liegen im Abbild (de und en), das
// Einstellungsprogramm kann umschalten -- nur braucht man dafuer Maus
// oder Tastatur, und genau die ist bei ihm tot. Ein Sprachschalter,
// den man nur mit funktionierender Eingabe erreicht, ist fuer den
// Fall, in dem man ihn braucht, keiner.
//
// Also: `lang=en` auf der Kommandozeile. Der Kern schreibt die Wahl
// VOR dem ersten Ring-3-Programm in die Datei, an der `msg.fi` ohnehin
// nachsieht -- kein zweiter Weg zur Sprache, keine zweite Wahrheit.
// Die Datei bleibt der einzige Ort, an dem die Sprache steht.
const M_LANGEN: u64 = 200 // Wort 3, Bit 8 -- lang=en auf der Kommandozeile
const M_LANGDE: u64 = 201 // Wort 3, Bit 9 -- lang=de (ausdruecklich)
const M_WIGSTART: u64 = 77 // Wort 1, Bit 13
const M_WIGNOKEYS: u64 = 78 // Wort 1, Bit 14
// ZWEITER NACHTRAG: DIESELBE SUCHE OHNE DEN NAMENSINDEX. Dann findet
// "blau" nichts -- kein Programm heisst so, und ohne Index gibt es keine
// Dateitreffer. Das ist die Gegenprobe zu der Zusage, dass die Suche im
// GANZEN Dateisystem sucht und nicht nur in einer Anwendungsliste.
const M_WIGNOIDX: u64 = 79 // Wort 1, Bit 15
// RUNDE SPEICHER: `/bin/speicher`, die Speicherplatzanalyse. Sie sitzt
// auf derselben Widget-Bibliothek wie die Anwendungen der Runde K15
// und gehoert deshalb in DEREN Wort. Sie hatte 1 << 54 gewaehlt -- und
// Runde MEM hatte dieselbe Zahl gewaehlt. Zwei Schalter auf einem Bit:
// `memstress` haette die Speicherplatzanalyse mitgestartet und
// umgekehrt. Der Modusvektor der Runde K17 loest genau das auf.
const M_WIGSPEICHER: u64 = 80 // Wort 1, Bit 16

// ROUND ICONS.  `wigicons` starts /bin/icont instead of the widget
// demo: the Ring 3 program that walks every icon of the icon font,
// checks the promises of the round and measures what one icon costs
// against what one OSYM bitmap costs.  It is a mode and not an
// argument because it picks WHICH program is started, which is the
// kernel's business, not the library's.
// RUNDE ICONS, in den Modusvektor der Runde K17 eingehaengt. 1 << 47
// gehoert dort der Energieschicht der Runde K18.
const M_WIGICONS: u64 = 95 // Wort 1, Bit 31
// RUNDE I18N: `nostart` -- der Starter wird NICHT gestartet, damit das
// Bildschirmfoto der Sprachrunde nur die Fenster zeigt, um die es geht.
// Die Runde hatte 1 << 60 gewaehlt; das gehoert TASKBAR-EDGE (M_WMAX)
// und THEME (M_THEMEGUI).
const M_NOSTART: u64 = 96 // Wort 1, Bit 32

// ================================================ RUNDE HIDWEG (BLECH)
//
// `wmdauer` -- DER SCHREIBTISCH LAEUFT, BIS JEMAND IHN BEENDET.
//
// Gemessen am 03.09.2026, und es ist der Sperrpunkt der ganzen Runde:
// `kgui.wait_wm` wartete auf die Shell im Terminalfenster in einer
// Schleife mit HARTER RUNDENGRENZE (20000). Ist die Grenze erreicht,
// kehrt sie mit -2 zurueck, `surface` kehrt ohne `wmhold` sofort
// zurueck -- und der Kern laeuft durch bis `kernel: done`. Der
// Bildschirm behaelt das letzte Bild, aber NIEMAND ruft mehr
// `wm.poll`: kein Zeiger, keine Taste, kein Klick.
//
// Unter `nosched` -- und DAS steht auf jedem Schreibtisch-Eintrag des
// Sticks -- kostet eine Runde keine Marke, sondern nur einen
// Durchgang. Gemessen in QEMU: der Schreibtisch lebte **9,4 Sekunden**
// und war danach ein Standbild. Genau das hat Justin auf Blech gesehen
// und als "die Eingabe geht nicht" gemeldet.
//
// Mit diesem Wort gibt es keine Rundengrenze mehr: die Schleife laeuft
// weiter, holt Zeiger und Tasten ab, setzt zusammen -- und startet die
// Shell neu, wenn sie endet. Ohne das Wort bleibt alles, wie es war;
// jeder Testlauf der Runden K10 bis BLECH-HID misst denselben Kern.
const M_WMDAUER: u64 = 97 // Wort 1, Bit 33


// --------------------------------------------------------- the accesses

fn get(state: u64, off: u64) -> u64 {
    return __mmio_read64((state + off) as *mut u64)
}

fn set(state: u64, off: u64, v: u64) {
    __mmio_write64((state + off) as *mut u64, v)
}

// Read, add, write back -- as ONE instruction, `lock xadd`.
//
// ROUND K5 changed this line and the sentence that used to stand over it:
// "NOT atomic -- it does not have to be: the kernel runs on one
// processor". From the round with the second processor on, the three
// steps of a read-modify-write are three chances for another core to do
// exactly the same in between, and one of the two increments is then gone
// without a word. Every counter in this kernel goes through this
// function, so making this one line atomic makes all of them safe --
// TICKS, TRAPS, SWITCHES, NEXT_PID, the spurious count of the APIC.
// `__atomic_add` yields the OLD value; the callers of `add` want the new
// one, which is why the delta is added back on.
fn add(state: u64, off: u64, v: u64) -> u64 {
    return __atomic_add((state + off) as *mut u64, v) + v
}

fn get32(p: u64) -> u64 {
    return __mmio_read32(p as *mut u32) as u64
}

fn get16(p: u64) -> u64 {
    return __mmio_read16(p as *mut u16) as u64
}

fn get8(p: u64) -> u64 {
    return __mmio_read8(p as *mut u8) as u64
}

fn set8(p: u64, v: u8) {
    __mmio_write8(p as *mut u8, v)
}

// ------------------------------------------------------------ RUNDE K17
//
// WORT 6 DES MODUSVEKTORS -- DIE ERSTE RUNDE, DIE EIN EIGENES WORT
// BEKOMMT statt Bits aus einem gemeinsamen Vorrat. Genau daran ist der
// erste Anlauf dieser Runde gescheitert: sie und Runde K18 hatten
// unabhaengig voneinander dieselben sieben Bits genommen (1<<47 bis
// 1<<53), und danach waren im ganzen u64 nur noch vier frei.
//
// `usb` schaltet den Baum dieser Runde an; alles andere sind
// GEGENPROBEN, und ohne sie beweist die Runde nichts.
const M_USB: u64 = 384 // Wort 6, Bit 0 -- den Regler aufsetzen
const M_NOUSB: u64 = 385 // Wort 6, Bit 1 -- GEGENPROBE: gar kein USB
const M_USBPOLL: u64 = 386 // Wort 6, Bit 2 -- GEGENPROBE: ohne Meldung
const M_NOHID: u64 = 387 // Wort 6, Bit 3 -- GEGENPROBE: keine Eingabe
const M_NOMSC: u64 = 388 // Wort 6, Bit 4 -- GEGENPROBE: kein Stick
const M_UNPLUG: u64 = 389 // Wort 6, Bit 5 -- im Betrieb abziehen
const M_NOUSBIRQ: u64 = 390 // Wort 6, Bit 6 -- Vektor bleibt maskiert
const M_USBSTICK: u64 = 391 // Wort 6, Bit 7 -- den Stick einhaengen
const M_USBHOLD: u64 = 392 // Wort 6, Bit 8 -- stillhalten und dienen
// RUNDE BLECH-HID: nach dem USB-Baum anhalten, damit der Bericht auf
// einem Rechner ohne serielles Kabel LESBAR stehen bleibt. Wort 6 hatte
// ab Bit 9 noch fuenfundfuenfzig freie Bits.
const M_USBSTOP: u64 = 393 // Wort 6, Bit 9 -- nach `usb.stage` parken
const M_USBLEG: u64 = 394 // Wort 6, Bit 10 -- die Uebernahme pruefen
// RUNDE BLECH-HID: DER NOTAUSGANG. Ohne Eingabegeraet kann niemand
// etwas tippen -- also fuehrt die Shell beim Start ein SKRIPT aus und
// der Bildschirm bleibt danach stehen. Das ist der Weg, auf dem sich
// der Netzweg auf echtem Blech messen laesst, solange die Eingabe
// klemmt.
const M_NETLAUF: u64 = 395 // Wort 6, Bit 11 -- /etc/netlauf.sh fahren

// ================================================== RUNDE HID: WORT 11.
//
// Die Runde nimmt ein EIGENES Moduswort und nicht die letzten Bits von
// Wort 6. Wort 6 gehoert K17 (USB), und diese Runde laeuft neben MERGE-2,
// RING, NETPROFIL, RTL und AML auf demselben Zweigstand -- wer sich in
// ein fremdes Wort setzt, verschmilzt hinterher Bit gegen Bit. Die
// Woerter 11 bis 15 waren frei; hier ist Wort 11.
// RUNDE BLECH-ECHT: die acht Bits der Runde HID standen auf Wort 11,
// wo seit Runde ASYNC M_ASYNC..M_ASTRESS stehen. Sie ziehen auf das
// leere Wort 13 (832..839). Die Namen und ihre Bedeutung bleiben.
const M_HIDREP: u64 = 832 // Wort 13, Bit 0 -- der Zerleger-Selbsttest
const M_HID: u64 = 833 // Wort 13, Bit 1 -- der generische HID-Weg
const M_NURBOOT: u64 = 834 // Wort 13, Bit 2 -- GEGENPROBE: nur Boot-Protokoll
const M_I2CHID: u64 = 835 // Wort 13, Bit 3 -- I2C-HID aufsetzen
const M_NOI2C: u64 = 836 // Wort 13, Bit 4 -- GEGENPROBE: kein I2C
const M_HIDLAT: u64 = 837 // Wort 13, Bit 5 -- die Eingabelatenz messen
const M_HIDPAD: u64 = 838 // Wort 13, Bit 6 -- Touchpad-Berichte durchspielen
const M_HIDDUMP: u64 = 839 // Wort 13, Bit 7 -- jedes Feld einzeln melden

// RUNDE STANDBILD: `tafel` -- DIE MESSTAFEL WIRD ANGESAGT, NICHT GERATEN.
//
// Vorher hing sie an `wmdauer`. Das war eine ANNAHME ("wmdauer steht auf
// jedem Schreibtisch-Eintrag und auf keinem Laeufer") und sie war falsch:
// `tools/hidpunkte/run.sh` setzt `wmdauer` ebenfalls. Ein Schalter, der
// in einer Umgebung greift und in der anderen nicht, ist genau die Art
// Bedingung, die diese Runde gekostet hat.
//
// Jetzt ist es ein eigenes Wort auf der Kommandozeile. Der Blech-
// Menueeintrag setzt es, kein Laeufer setzt es. Damit ist das Verhalten
// in beiden Umgebungen BENANNT.
const M_TAFEL: u64 = 840 // Wort 13, Bit 8 -- die Messtafel anzeigen
// RUNDE KABEL: die serielle Leitung von Hand stilllegen.
const M_NOSERIAL: u64 = 841 // Wort 13, Bit 9 -- keine serielle Ausgabe

// ================= RUNDE BLECHEINGABE: VIER SCHALTER, DIE DIESE RUNDE
// BRAUCHT.
//
// `fbflush` -- nach jedem Blit `wbinvd`. Der ZWEITE, vom `fbuc`-Weg
//   unabhaengige Beweis derselben Ursache: kommt das Bild damit an und
//   ohne nicht, lag es im Zwischenspeicher.
// `herz`   -- der Herzschlag. Zwei Blinkfelder am rechten Rand, aus dem
//   Zeitgeberbehandler gemalt, und die Tastatur-LED im Sekundentakt.
//   Der einzige Kanal, der weder Fensterserver noch Leitung braucht.
// `nohub`  -- den Hub-Treiber stilllegen (Gegenprobe).
// `usbsafe`-- das Aufzaehlen NICHT aus dem Zeitgeber, sondern nur aus
//   der Schreibtischschleife. Gegenprobe zur Umstellung dieser Runde.
const M_FBFLUSH: u64 = 842 // Wort 13, Bit 10
const M_HERZ: u64 = 843 // Wort 13, Bit 11
const M_NOHUB: u64 = 844 // Wort 13, Bit 12
const M_USBSAFE: u64 = 845 // Wort 13, Bit 13
// ================================================== RUNDE BLECHDREI
// `notafel` -- das reservierte Band am oberen Rand NICHT einrichten.
//   Justins Wunsch: die Tafel steht im Normalbetrieb dauerhaft, und
//   dieses Wort ist der Weg, sie wieder loszuwerden, ohne dass der Rest
//   des Systems etwas davon merkt.
const M_NOTAFEL: u64 = 846 // Wort 13, Bit 14
// RUNDE BLECHVIER: `usbnoreset` -- die GEGENPROBE zur erzwungenen
// Anschluss-Ruecksetzung. Damit gilt ein schon freigeschalteter
// Anschluss wieder als fertig, so wie bis BLECHDREI.
const M_USBNORESET: u64 = 847 // Wort 13, Bit 15
// ============================================ RUNDE BLECHFUENF
// DREI WOERTER, DIE AUS JUSTINS BLECH KOMMEN.
//
// `absturzhalt` -- eine Ausnahme in Ring 0 schreibt Vektor, Fehlercode,
//   RIP und CR2 in das reservierte Band und HAELT AN, statt die
//   Maschine abzuschalten. Justin steht vor dem Rechner und kann nur
//   fotografieren; eine Absturzmeldung, die auf der seriellen Leitung
//   steht und danach den Rechner ausschaltet, ist fuer ihn keine.
//   Die Regressionslaeufe brauchen den alten Weg (`power.shutdown` mit
//   EXIT_TRAP sagt der Pruefung, dass es geknallt hat) -- deshalb ein
//   Schalter und keine Umstellung.
const M_ABSTURZ: u64 = 848 // Wort 13, Bit 16
// `pulsled` -- der LED-HERZSCHLAG auf der Tastatur. Er hat seine Frage
//   beantwortet (der Zeitgeber laeuft, HZ 99) und ist jetzt nur noch
//   im Weg: Justins Lampen blinkten dauernd, und Nummernfeststell liess
//   sich nicht mehr schalten, weil der Kern sie viermal je Sekunde
//   selbst umlegte. Ab hier gehoeren die Lampen dem Menschen; der
//   Herzschlag kommt nur noch, wenn dieses Wort dasteht.
const M_PULSLED: u64 = 849 // Wort 13, Bit 17
// `nopuls` -- die Diagnosezeile des Schreibtischs NICHT in das
//   Terminalfenster schreiben. Sie hat Justins Terminal unbrauchbar
//   gemacht: dieselbe Zeilengruppe lief endlos durch.
const M_NOPULS: u64 = 850 // Wort 13, Bit 18
// `zumachen` -- DIE GEGENPROBE ZU JUSTINS ABSTURZ, OHNE MAUS.
//   Er klickt auf das rote Kreuz, das Fenster geht zu, und die Maschine
//   ist weg. Der Mausweg laesst sich in QEMU nur ungenau nachfahren
//   (relative Pakete, eigener Teiler im HID-Zerleger). Mit diesem Wort
//   macht der Schreibtisch nach zehn Sekunden das oberste Fenster GENAU
//   SO zu, wie der Klick es tut -- `ev_push(E_CLOSE)` und `destroy` --
//   und laeuft danach weiter. Stirbt er dabei, ist es derselbe Tod.
const M_ZUMACHEN: u64 = 851 // Wort 13, Bit 19
// `knall` -- EIN KERNFEHLER AUF BESTELLUNG. Die Gegenprobe zur
//   Absturzanzeige: ohne sie liesse sich nur behaupten, dass die
//   Anzeige kommt, wenn es knallt. Der Schreibtisch schreibt nach zehn
//   Sekunden an eine Anschrift, die keine ist; danach muss im Band
//   Vektor 14, RIP und CR2 stehen und die Maschine stehenbleiben.
const M_KNALL: u64 = 852 // Wort 13, Bit 20
// ============================================== RUNDE STARTKNOPF
// `einsprung` -- EIN PROGRAMM MIT KAPUTTEM EINSPRUNG, AUF BESTELLUNG.
//
// Justins Absturz war ein #GP(0) am `sysretq` in `enter_user_task`,
// und der kommt aus genau einer Quelle: ein nicht kanonischer
// Ruecksprungzeiger in rcx, also `T_ENTRY`. Ohne dieses Wort liesse
// sich nur BEHAUPTEN, dass die Pruefung in `proc.user_start` hilft.
//
// Mit ihm bekommt das naechste Programm, das von der Platte startet,
// einen Einsprung von 0xDEAD000000000000 -- nicht kanonisch, also
// genau der Fall. Die Zusage: der PROZESS stirbt, die MASCHINE laeuft
// weiter und der Schreibtisch malt weiter. Vor dieser Runde haette
// derselbe Lauf die Maschine angehalten.
const M_EINSPRUNG: u64 = 853 // Wort 13, Bit 21

// --------------------------------------------------------- der Modusvektor
//
// DIE EINZIGEN ZWEI ZUGRIFFE AUF DEN MODUS. Ein Modusname ist ein
// Bitindex (Wort * 64 + Bit); welches Wort das ist, rechnet sich hier
// aus dem Index aus, und deshalb muss keine aufrufende Stelle wissen,
// in welchem Wort ihr Schalter liegt. Eine Maske steht nirgends mehr
// im Quelltext -- genau daran sind K17 und K18 aneinandergeraten.
//
// `bit` MUSS kleiner als MODE_WORDS * 64 sein; `tools/kernel/memmap.py`
// rechnet das fuer jeden Namen im Baum nach, bevor etwas gebaut wird.
fn mode_on(state: u64, bit: u64) -> bool {
    let m: u64 = 1 << (bit % 64)
    return (get(state, MODE_OFF + (bit / 64) * 8) & m) != 0
}

fn mode_add(state: u64, bit: u64) {
    let off: u64 = MODE_OFF + (bit / 64) * 8
    let m: u64 = 1 << (bit % 64)
    set(state, off, get(state, off) | m)
}

// Ein ganzes Wort, fuer die Faelle, die den Modus als ZAHL brauchen --
// die Trap-Art in `kmain.provoke` (Wort 0, Bits 0..2) und die Ausgabe
// des Modus auf der seriellen Leitung.
fn mode_word(state: u64, w: u64) -> u64 {
    return get(state, MODE_OFF + w * 8)
}

// ==================================================== RUNDE HDA: DER TON
//
// SIEBEN SEITEN, 0xB0000..0xB7000 -- und NICHT 0x92000..0x98000, wo
// Runde HDA sie hingelegt hatte. Der Zweig `hda` zweigte von MERGE-2
// Schritt 13 ab, und damals wies `kstate.fi` 0x92000 aufwaerts als
// frei aus. Seit MERGE-2 Schritt 17 (Runde ASYNC) liegen dort AIO,
// ACQ, ASC und APATH (0x92000..0x9F000), und Runde BLECH-ECHT hat
// KDATA_SIZE auf 0xB0000 gehoben. `tools/kernel/memmap.py` meldete
// nach dem Zusammenfuehren FUENF Kollisionen auf diesen Seiten -- die
// vierte Wiederholung des Fehlers, den der Kopf dieser Datei
// beschreibt, und diesmal hat ihn der Pruefer VOR dem Bauen gesehen.
//
// DER ERSTE ANLAUF DIESER RUNDE nahm 0x9F000..0xA6000 -- das Loch, das
// `kstate.fi` hinter APATH auswies. Der Pruefer meldete SECHS neue
// Kollisionen: dort liegt seit BLECH-ECHT die Runde HID (hidrep.fi,
// hidin.fi, i2chid.fi, 0xA0000..0xA9000), deren Konstanten NICHT in
// dieser Datei stehen. Wer nur `kstate.fi` liest, sieht die Karte nicht
// -- nur `python3 tools/kernel/memmap.py kernel -v` sieht sie ganz.
//
// ALSO WAECHST kdata EIN WEITERES MAL, 0xB0000 -> 0xC0000 (704 -> 768
// KiB), und der Ton liegt HINTER der alten Grenze, wo keine parallel
// laufende Runde ihn erwartet. Die Zahl steht ZWEIMAL, hier und in
// `kernel/arch/x86_64/boot.s`; `tools/hv/run.sh` haelt beide
// gegeneinander. Die Tabelle:
//
//   Bereich   war (hda)   ist (ton)   Seiten  Inhalt
//   AUD_OFF   0x92000     0xB0000     1       Tonschicht, AC97, AC97-BDL, Kratzpuffer
//   HDA_OFF   0x93000     0xB1000     1       HDA-Skalare, Codec-Tafel, DPIB, BDL
//   HDAR_OFF  0x94000     0xB2000     1       CORB + RIRB
//   HDAB_OFF  0x95000     0xB3000     1       Widget-Tafel
//   MIX_OFF   0x96000     0xB4000     2       Stromtafel, Mischpuffer
//   AUDB_OFF  (BLOCK_OFF) 0xB6000     1       Umsteigepuffer der Systemaufrufe (NEU)
//
// Angefasst wurden dafuer GENAU diese Konstanten -- jeder Zugriff der
// vier Tondateien geht ueber sie, keine Zahl steht doppelt.
//
// WARUM SECHS UND NICHT EINE. Runde MEDIA1 kam mit einer Seite aus,
// weil unter der Grenze nur AC97 stand: ein Portbereich, eine
// Deskriptorliste zu 256 Oktetten, ein Kratzpuffer. Intel HD-Audio
// bringt drei Dinge mit, die AC97 nicht hat, und alle drei sind
// SPEICHER, den der Regler per DMA liest oder schreibt und der deshalb
// physisch zusammenhaengend und ausgerichtet liegen muss:
//
//   der Befehlsring CORB   256 Eintraege zu 4 Oktetten = 1 KiB, 128er
//   der Antwortring RIRB   256 Eintraege zu 8 Oktetten = 2 KiB, 128er
//   der Positionspuffer    8 Oktette je Strom, 128er Ausrichtung
//   die Deskriptorliste    bis 256 Eintraege zu 16 Oktetten = 4 KiB
//
// Dazu kommt die Tafel des Widget-Graphen: HD-Audio beschreibt seinen
// Codec als Graph aus bis zu 128 Knoten, und der Weg vom Wandler zur
// Buchse wird EINMAL beim Aufsetzen gesucht und danach nur noch
// nachgeschlagen. Diese Tafel steht neben der Deskriptorliste.
//
//   0xB0000  `audio.fi` (Schicht) + `ac97.fi` (Treiber) + AC97-BDL
//            + Kratzpuffer -- die Aufteilung von Runde MEDIA1,
//            unveraendert uebernommen
//   0xB1000  `hda.fi`: Skalare (0x000..0x400), Codec-Tafel
//            (0x400..0x600), DMA-Positionspuffer (0x700..0x780,
//            128er ausgerichtet, 8 Oktette je Strom), die
//            Deskriptorliste des Ausgabestroms (0x800..0xA00,
//            32 Eintraege zu 16 Oktetten, 128er ausgerichtet)
//   0xB2000  CORB (0x000..0x400) und RIRB (0x400..0xC00)
//   0xB3000  die Widget-Tafel: 64 Knoten zu 64 Oktetten. Sie hat eine
//            GANZE Seite, weil an einem Knoten sechs Dinge haengen
//            (Faehigkeiten, Buchsenbelegung, Verstaerkerbereich und
//            bis zu acht Quellen mit ihrem INDEX -- der Index ist es,
//            der den Eingang eines Mischers benennt)
//   0xB4000  `mix.fi`: die Stromtafel (0x000..0x400) und der
//            Mischpuffer (0x400..0x2000, 1792 Rahmen)
//
// Alle sieben stehen in `tools/kernel/memmap.py`; wer sie verschiebt,
// ohne sie dort nachzuziehen, faellt beim naechsten Bau auf.
const AUD_OFF: u64 = 0xB0000
const AUD_MAX: u64 = 0x1000
const HDA_OFF: u64 = 0xB1000
const HDA_MAX: u64 = 0x1000
const HDAR_OFF: u64 = 0xB2000
const HDAR_MAX: u64 = 0x1000
const HDAB_OFF: u64 = 0xB3000
const HDAB_MAX: u64 = 0x1000
const MIX_OFF: u64 = 0xB4000
const MIX_MAX: u64 = 0x2000
// RUNDE TON: der Umsteigepuffer der Ton-Systemaufrufe. Runde HDA
// kopierte Ring-3-Rahmen in den MASCHINENWEITEN `BLOCK_OFF` -- genau
// den Ein-Kern-Rest, den MERGE-6 bei `write` gefunden hat (zwei
// Kerne, ein Puffer, zerschossene Daten). Eine eigene Seite, und sie
// wird NUR unter der Tonsperre (`audio.L_LOCK`) benutzt.
const AUDB_OFF: u64 = 0xB6000
const AUDB_MAX: u64 = 0x1000

// RUNDE TON, DER VORAUSLESEPUFFER DER PLATTE (`blk.fi`).
//
// Er steht in dieser Runde, weil er hier GEMESSEN wurde: eine Sekunde
// Ton von der IDE-Platte kostete 4982 Millisekunden LESEN und 8
// Millisekunden Ton. Ein Sektor je Befehl bei 512 Oktetten sind 375
// Befehle fuer 192 KiB. Der Puffer holt 32 Sektoren mit EINEM Befehl
// und beantwortet die naechsten 31 Anfragen aus dem Speicher.
//
// Fuenf Seiten: eine fuer die Buchhaltung (welche LBA, wie viele, von
// welchem Geraet), vier fuer die 32 * 512 Oktette Daten. Er wird nur
// unter der Dateisystemsperre (`atomic.L_FS`) angefasst -- `fs.fi`
// haelt sie ueber jedem Aufruf von `blk.read` -- und JEDES Schreiben
// wirft ihn weg, sonst liest der naechste Lauf, was vorgestern
// dortstand.
const BLKC_OFF: u64 = 0xB7000
const BLKC_MAX: u64 = 0x1000
const BLKD_OFF: u64 = 0xB8000
const BLKD_MAX: u64 = 0x8000
const BLKC_SECTORS: u64 = 8
// ZWEI WEGE, UND ZWAR AUS EINEM GEMESSENEN GRUND. Mit EINEM Puffer
// blieb /bin/play (258 KiB) beim Laden stehen, waehrend /bin/ls (38
// KiB) durchlief: eine Datei ueber der Grenze zu den indirekten
// Bloecken laesst das Dateisystem zwischen Zeigerblock und Datenblock
// hin- und herspringen, und ein Puffer mit einem einzigen Platz wirft
// bei jedem Sprung den anderen weg. Statt 16 Sektoren je Befehl zu
// sparen, las er 16 Sektoren je EINZELNEM Block -- sechzehnmal mehr
// als vorher. Zwei Plaetze, reihum vergeben, trennen die Zeiger von
// den Daten.
const BLKC_WAYS: u64 = 8

// WORT 14, DER TON -- und nicht Wort 11, das Runde HDA genommen hatte.
// Wort 11 gehoert auf `merge6` seit MERGE-2 der Runde ASYNC (704..709)
// und der Runde MODUL (710, 711); `tools/kernel/memmap.py` zaehlte nach
// dem Zusammenfuehren acht doppelt vergebene Modusindizes. Wort 12
// hat BLECH (EHCI, 768..771), Wort 13 hat HID/BLECHEINGABE (832..853).
// Wort 14 (896..959) war frei; Wort 15 bleibt es. Dieselbe Lehre wie
// bei den Seiten oben: zwei Zweige nehmen unabhaengig "das naechste
// freie Wort" und nehmen dasselbe -- und nur der Pruefer sieht es.
//
// `audio` schaltet den Ton an. Alles andere sind GEGENPROBEN und
// Schalter der Abnahme -- eine Zusage ohne Gegenprobe ist eine
// Behauptung.
const M_AUDIO: u64 = 896 // Wort 14, Bit 0 -- den Ton aufsetzen
const M_NOAUDIO: u64 = 897 // Bit 1 -- GEGENPROBE: gar kein Ton
const M_AUDSINE: u64 = 898 // Bit 2 -- 440 Hz aus dem Kernel
const M_AUDSAY: u64 = 899 // Bit 3 -- den Bericht drucken
const M_AUDNOMIX: u64 = 900 // Bit 4 -- GEGENPROBE: Mischer stumm
const M_AUDSTARVE: u64 = 901 // Bit 5 -- GEGENPROBE: Ring leerlaufen
const M_AUDBEEP: u64 = 902 // Bit 6 -- den Systemklang spielen
const M_NOSOUNDS: u64 = 903 // Bit 7 -- Systemklaenge aus
const M_AUDHALF: u64 = 904 // Bit 8 -- GEGENPROBE: halbe Lautstaerke
const M_AUDLONG: u64 = 905 // Bit 9 -- fuenf Sekunden statt einer
const M_NOHDA: u64 = 906 // Bit 10 -- GEGENPROBE: HDA uebergehen
const M_NOAC97: u64 = 907 // Bit 11 -- GEGENPROBE: AC97 uebergehen
const M_AUDMIX: u64 = 908 // Bit 12 -- ZWEI Stroeme gleichzeitig
const M_AUDCLIP: u64 = 909 // Bit 13 -- GEGENPROBE: Uebersteuerung
const M_AUD441: u64 = 910 // Bit 14 -- 44100 statt 48000 Hz
const M_AUDCLOSE: u64 = 911 // Bit 15 -- mitten im Lauf schliessen
const M_AUDPOS: u64 = 912 // Bit 16 -- der Positionsgang ueber 10 s
const M_AUDLOAD: u64 = 913 // Bit 17 -- dasselbe unter Rechenlast
const M_NOAUDIRQ: u64 = 914 // Bit 18 -- GEGENPROBE: Vektor maskiert
const M_AUDGRAPH: u64 = 915 // Bit 19 -- den Widget-Graphen drucken
