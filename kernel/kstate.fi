    M_NOPROC, M_NOFS, M_ATA, M_CAPS,
    // ---- Runde HANDLE ----
    HND_OFF, HND_MAX, HOBJ_OFF, HOBJ_MAX, HREQ_OFF, HREQ_MAX,
    HNON_OFF, HNON_MAX, HCNT_OFF, HCNT_MAX,
    M_HANDLE, M_NOGEN, M_NOFLIGHT, M_NORIGHTS, M_HSTRICT, M_HBENCH,
