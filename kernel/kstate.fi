    AUD_OFF, AUD_MAX, HDA_OFF, HDA_MAX, HDAR_OFF, HDAR_MAX,
    HDAB_OFF, HDAB_MAX, MIX_OFF, MIX_MAX, AUDB_OFF, AUDB_MAX,
