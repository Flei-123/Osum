// SPDX-License-Identifier: GPL-2.0-only
// kernel/kstate.fi -- round 59: the kernel's mutable state.
//
// Stage 0 of Firn has NO global mutable variables (SPEC 14, item 5:
// `const` only). A kernel needs some: an IDT, a frame bitmap, a tick
// counter that an interrupt increments while the main loop reads it.
//
// The way out is the one an operating system takes anyway: the state does
// not lie in the language, it lies in a MEMORY REGION whose address is
// handed over. `boot.s` reserves 128 KiB, zeroes them and puts the
// address into a register; `kernel_main` and `trap_entry` both get it. What
// is a global variable elsewhere is here an offset into that region.
//
// Every access goes through `__mmio_read64`/`__mmio_write64`, not through
// an ordinary pointer. That is not decoration: the tick counter is
// changed by an interrupt handler in the middle of the loop that reads
// it. An ordinary load may be hoisted out of the loop by the optimizer
// (`licm.rs`) -- the kernel would then wait forever. MMIO accesses may
// not be moved, merged or removed (round 52).
//
// Division of the region (offsets from the start):
//
//   0x00000  the scalars below
//   0x01000  IDT, 256 gates of 16 octets
//   0x02000  frame bitmap, 16 KiB -> 131072 frames -> 512 MiB
//   0x06000  page table for the split of the user page (4 KiB)
//   0x07000  the second one of those (round 59: code page and stack page)
//   0x08000  the task table, 32 slots of 256 octets (round 62)
//   0x0A000  the trace of the scheduler, 4096 octets (round 62)
//   0x0B000  the console input, 4096 octets (round 62)
//   0x0C000  what a system call copies to and fro (round 62)
//   0x0D000  paths out of ring 3 (round 62)
//   0x0E000  the scratch blocks of the file system (round 62)
//   0x0F000  ELF header and program headers (round K1)
//   0x10000  the PCI device table, 2 pages (round K2, `pci.K2_OFF`)
//   0x12000  the counters of the PCI/APIC/NVMe drivers (round K2)
//   0x14000  the NVMe queues, up to 0x1B000 (round K2, `nvme.fi`)
//   0x1B000  the per-core records, the locks and the task-to-core
//            table of round K5, up to 0x1C000
//   0x1C000  the scalars of `smp.fi` and `cpu.fi` (round K5)
//   0x20000  the open file table (round K4)
//   0x21000  the descriptor tables of the tasks (round K4)
//   0x22000  one saved user context per task, for `fork` (round K4)
//   0x23000  the pipe buffers, 0x24000 their headers (round K4)
//   0x25000  the trace of the scheduler (round 62, moved in K4)
//   0x26000  the console input (round 62, moved in K4)
//   0x27000  the arguments of `exec` (round K1, moved in K4)
//   0x28000  one page of file data while loading (round K1, moved in K4)
//   0x29000  the working directory of a task (round K6)
//   0x2A000  the capability tables of `cap.fi`, 32 tasks * 16 slots
//            of 32 octets, up to 0x2E000
//   0x2E000  their nonces, one per task
//   0x2F000  die Signalbehandlung, 32 Aufgaben * 32 Signale (Runde K9)
//   0x35000  je Aufgabe ein geretteter Zusammenhang fuer sigreturn (K9)
//   0x37000  die Terminals, acht Stueck (Runde K9)
//   0x3B000  Schluessel und Sammler des Zufallsgenerators (Runde K9)
//   0x3C000  der Rahmenpuffer und der 8x16-Zeichensatz (Runde K7B)
//   0x1D000  das Zeigegeraet (Runde K10)
//   0x3D000  der Fensterserver, zwei Seiten (Runde K10)
//   0x3F000  die Zeichensatzplaetze des Schriftlesers (Runde K10)
//   0x3C000  der Rahmenpuffer-Zustand samt Zeichensatz (Runde K7B)
//   0x40000  die Gastmaschinen des Hypervisors (Runde K12, `hv.fi`)
//   0x41000  die Zaehler der Benutzer/Rechte-Schicht (Runde K13)
//   0x43000  die VFS-Schicht, FAT32, procfs (Runde K14)
//   0x46000  die Naht zur Widget-Bibliothek, drei Seiten (Runde K15)
//   0x49000  die Tabelle der Dateiarten (Runde K16)
//   0x4C000  der Modusvektor (Runde K17, MODE_OFF)
//   0x4D000  frei
//   0x50000  USB: xHCI-Ringe und Geraetesaetze (Runde K17, K17_OFF)
//   0x64000  Fenstertafel und Ereignisringe (Runde DESKTOP, `wm.fi`)
//   0x68000  der Fensterbaum und die Tastenbelegung (Runde TILING,
//            `tile.fi`), vier Seiten bis 0x6C000
//   0x58000  die Energieschicht (Runde K18, `pwr.fi`)
//   0x59000  Akku, Netzteil und Thermalzone (Runde K18, `batt.fi`)
//   0x5A000  OFS in Fassung 3: die Pfadpuffer des Dateisystems,
//            zwei Seiten (Runde OFS3, `kernel/fs.fi`)
//   0x5C000  die Bildschirmmodi und die Nachschlagetabelle
//            (Runde DISPLAY, `vmode.fi`)
//   0x5E000  das Aenderungsjournal des Dateisystems, zwei Seiten
//            (Runde SPEICHER, `nidx.fi`)
//   0x60000  die Arbeitsverzeichnisse, vier Seiten (Runde OFS3;
//            lagen bis dahin auf 0x29000, eine Seite)
//   0x6C000  die Netzzaehlung je Prozess (Runde NETMON, `netmon.fi`)
//   0x6F000  Weiterleitung, NAT und DHCP-Server (Runde NETMON,
//            `share.fi`)
//   0x72000  die Geraeteidentitaet (Runde TRESOR, `hwid.fi`), zwei
//            Seiten -- die zweite ist das DMA-Ziel von NVMe identify
//   0x74000  der Energieverlauf (Runde POWERMON, `pmon.fi`), drei
//            Seiten
//   0x77000  die vorgetaeuschten Steckdosen (Runde NETVIEW,
//            `netview.fi`), drei Seiten
//   0x7A000  die Netzkarten-Auswahl und der e1000-Treiber (Runde
//            HWNET, `netdev.fi` und `e1000.fi`), eine Seite
//   0x7B000  der AHCI/SATA-Treiber (Runde AHCI, `ahci.fi`), fuenf
//            Seiten: Befehlsliste, FIS-Empfang und Befehlstafel auf
//            0x7B000, IDENTIFY auf 0x7C000, zwei Messpuffer, die
//            Zaehler auf 0x7F000.
//            RUNDE MERGE-2: die Runde hatte 0x7A000 aufwaerts genommen,
//            weil `kstate.fi` das damals als frei auswies. Inzwischen
//            liegt dort HWNET. Der Block ist um EINE Seite hochgerueckt
//            und damit unveraendert fuenf Seiten am Stueck; die
//            Ausrichtungen, auf die er sich beruft (1024/256/128), sind
//            Seitengrenzen und gelten hier genauso.
//   0x80000  die Handle-Schicht (Runde HANDLE, `handle.fi`):
//            0x80000 die Handle-Plaetze je Prozess (drei Seiten),
//            0x83000 die Objekttafel, 0x83A00 die Abbruch-Token,
//            0x84200 die Wuerfelwerte, 0x84300 die Zaehler
//   0x84380  frei, bis KDATA_SIZE (0xA0000)
//   0xB0000  DER TON (RUNDE HDA, Lage aus RUNDE TON): eine Seite
//            Tonschicht und AC97 (`audio.fi`, `ac97.fi`), drei
//            Seiten Intel HD-Audio (`hda.fi`: Skalare und
//            Positionspuffer, CORB/RIRB, Deskriptorliste und
//            Widget-Tafel), zwei Seiten Mischer (`mix.fi`), eine
//            Seite Umsteigepuffer der Ton-Systemaufrufe -- sieben
//            Seiten bis 0xB7000. Die DMA-Ringpuffer liegen NICHT
//            hier -- sie kommen aus dem Rahmenverwalter.
//   0xB7000  DER VORAUSLESEPUFFER DER PLATTE (Runde TON): eine Seite
//            Buchhaltung, acht Seiten Daten (8 Wege * 8 Sektoren)
//            bis 0xC0000 -- damit ist dieser Bereich VOLL
//   frei sind jetzt nur noch die Loecher:
//            0x87000 (eine Seite), 0x9F000 (eine Seite),
//            0xAC000..0xB0000 (vier Seiten)
//
// ================== RUNDE MERGE-2: kdata WAECHST VON 512 AUF 640 KiB.
//
// Der Rest oben war VIERFACH VERGEBEN. Vier Runden sind unabhaengig
// voneinander auf demselben Zweigstand entstanden, auf dem `kstate.fi`
// "0x7A000 frei, bis KDATA_SIZE" sagte, und jede hat sich genommen, was
// dort stand: HWNET eine Seite, AHCI fuenf, HANDLE viereinviertel, und
// MEDIA1, SNIP und FEEDBACK wollen je eine weitere. Vorhanden waren
// FUENF. Keine der Runden hat etwas falsch gemacht; der Satz, auf den
// sich alle berufen haben, war fuer jede einzeln wahr.
//
// Verschieben allein reicht dafuer nicht mehr -- die verbliebenen
// Loecher (0x4D000 drei Seiten, 0x3E000, 0x29000) fassen HANDLE gerade
// noch, und danach waere fuer die drei uebrigen Runden nichts da.
// Also wird der Bereich groesser, so wie Runde K12 ihn schon einmal
// groesser gemacht hat (0x40000 -> 0x50000): 0x80000 -> 0xA0000.
//
// WAS DAS KOSTET: 128 KiB mehr `.bss`. Der Bereich ist ein `.skip` in
// `kernel/arch/x86_64/boot.s` und liegt oberhalb von 1 MiB -- er hat
// mit dem 640-KiB-Loch des PC nichts zu tun, und im Abbild auf der
// Platte steht davon kein einziges Oktett.
//
// DIE ZAHL STEHT ZWEIMAL, hier und in `kernel/arch/x86_64/boot.s`.
// `tools/hv/run.sh` liest beide und vergleicht sie -- wer nur eine
// aendert, faellt dort auf.
//
// RUNDE K12 HAT DIESEN BEREICH WACHSEN LASSEN, von 0x40000 auf 0x50000.
// Der Grund steht hier, damit ihn niemand suchen muss: mit dem
// Rahmenpuffer bei 0x3C000 war `kdata` voll. Es gab keine freie Seite
// mehr. Wer eine braucht, nimmt eine von 0x41000 aufwaerts UND traegt
// sie in `tools/kernel/memmap.py` ein -- der Kartenpruefer rechnet nach,
// dass sich nichts ueberschneidet und dass alles unter KDATA_SIZE bleibt.
// Die Zahl steht ZWEIMAL: hier und in `kernel/boot.s`. Sie muessen
// gleich sein; `tools/hv/run.sh` liest beide und vergleicht sie.

export {
    TICKS, KEYS, TRAPS, HEAP_BASE, HEAP_END, HEAP_HEAD,
    BITMAP, BITMAP_FRAMES, MEM_TOP, MEM_USABLE, FRAMES_FREE, MODE,
    VECTORS, KEYLEN, KEYBUF, IDTR, GDT, TSS,
    KERNEL_END, LAST_TRAP, CURRENT, TASKS, NEXT_PID, KSTACK_CUR,
    SWITCHES, TRACE_LEN, KPML4, PREEMPT, DISK, DISK_BLOCKS,
    CONSOLE_POS, CONSOLE_LEN, IDLE, SPAWNS, FS_ROOT, FS_READY,
    KILLED, SYSCALLS, DISK_DEV, IDT_OFF, BITMAP_OFF, BITMAP_BYTES,
    PT_OFF, KDATA_SIZE, TASK_OFF, TASK_BYTES, MAX_TASKS, TRACE_OFF, POLLSEQ,
    TRACE_MAX, CONSOLE_OFF, CONSOLE_MAX, BLOCK_OFF, BLOCK_MAX, NAME_OFF,
    NAME_MAX, FS_OFF, FS_MAX, KEYPOS, NX_OK, EXECS,
    ELF_ERR, ELF_BYTES, ELF_PAGES, ELF_LOADS, ELF_OFF, ELF_MAX,
    EARG_OFF, EARG_MAX, LOAD_OFF, LOAD_MAX, EXCURSION, FORKS,
    EXECVES, PIPES, MAPS, OPENS, OFILE_OFF, OFILE_MAX,
    FDTAB_OFF, FDTAB_MAX, CTX_OFF, CTX_MAX, PIPEBUF_OFF, PIPEBUF_MAX,
    PIPEHDR_OFF, PIPEHDR_MAX, UIO_OFF, UIO_MAX, CAP_OFF, CAP_MAX,
    CAP_NONCE_OFF, CAP_NONCE_MAX, M_NOKBD, M_OSUM, M_NOBSS, TIME_BOOT,
    TIME_TSC0, TIME_KHZ, TIME_LAST, TIME_BACK, TIME_CALLS, RAND_READY,
    RAND_FIXED, RAND_BYTES, RAND_STIRS, RAND_HW, SIG_SENT, SIG_DELIVERED,
    SIG_CAUGHT, SIG_DEFAULT, SIG_STOPS, TTY_READY, TTY_SIGS, TTY_CHARS,
    SER_PORT, SER_RX, SER_IRQS, SER_DROPS, SER_OVERRUNS,
    M_SERCON, M_NOSERIRQ, M_SERPOLL,
    K9_MODE, SMEP_OK, SMAP_OK, GUARD_MODE, SMAP_WINDOWS, MBI,
    MOD_BASE, MOD_BYTES, MOD_CRC, MOD_WANT, MOD_OK, MOD_MODE,
    GUARD_APS, K11_OFF, K11_MAX, KB_SHIFT, KB_CTRL, KB_EXT,
    FPU_WORDS, FPU_MODE, FPU_XCR0, FPU_SIZE, FPU_APS, FPU_CR4,
    FPU_SAVES, FPU_RESTORES, FPU_NM, FPU_AREAS, FPU_FEAT,
    KB_SEQS, KB_SUPER, HK_SEQ, HK_KEY, HK_NS,
    AN_STATE, AN_NPAR, AN_PRIV, AN_SEQS, AN_REV,
    AN_PAR, AN_MAXPAR, ENV_N, ENV_LEN, ENV_BUF, ENV_MAX,
    SIG_OFF, SIG_MAX, SIGCTX_OFF, SIGCTX_BYTES, TTY_OFF, TTY_MAX,
    RAND_OFF, RAND_MAX, M_NOSIG, M_FIXRAND, M_UNIX, MOUSE_OFF,
    MOUSE_MAX, WM_OFF, WM_MAX, TTF_OFF, TTF_MAX, M_WM,
    M_NODIRTY, M_NOFOCUS, M_NOMOUSE, M_WMHOLD, M_WMSHELL, M_NOMPOLL,
    M_TTFDUMP, K13_OFF, K13_MAX, U_CHECKS, U_DENIED, U_SETIDS,
    U_CHMODS, U_CHOWNS, U_SUIDEXEC, U_FSVER, U_INITSLOT, U_ORPHANS,
    U_INITOK, U_ACPI, U_LASTDENY, U_RESET, M_NOPERM, M_INITSH, M_K13,
    M_WAITOLD,
    M_NOSUID, M_NOACPI, M_FORCEV2, M_ZOMBIE, CPU_OFF, CPU_BYTES,
    MAX_CPUS, LOCK_OFF, LOCK_BYTES, LOCK_COUNT, SMP_OFF, SMP_LAPIC,
    SMP_COUNT, SMP_NOLOCK, SMP_MODE, SMP_MAX, TCPU_OFF, TCPU_BYTES,
    K14_OFF, K14_MAX, FAT_OFF, FAT_MAX, PROCFS_OFF, PROCFS_MAX,
    K14_MODE, VFS_READY, VFS_MOUNTS, VFS_LOOKUPS, VFS_CROSSINGS, VFS_OPS,
    VFS_INDIRECT, DISK2_BLOCKS, DISK2_DEV, DISK_FIRST, DISK1_BLOCKS,
    ROOT_PART, M_VFS, M_NOVFS, M_NOPROCFS,
    M_NODEVFS, M_NOFAT, M_NOPART, M_FATRO, M_VFSALL, M_NOBIG,
    M_NOSTACK, K16_OFF, K16_MAX, FT_TAB, FT_SCALARS, FT_HEAD,
    FT_SB, FT_LINE, FT_REC, FT_ARGS, FT_IPATH, FT_SLOTS,
    FT_SLOT, FT_HEAD_MAX, FT_CLASSIFIED, FT_BY_MAGIC, FT_BY_EXT, FT_OPENED,
    FT_SHEBANGS, FT_REGISTERED, FT_REFUSED, STACKGROW,
    // ---- round MEM ----
    BITMAP_OCTETS, MAPPED_GIB, FRAME_HINT, M_MEMSTRESS,
    STRESS_GOT, STRESS_HIGH, STRESS_BEFORE, STRESS_LOW,
    STRESS_BAD, STRESS_SEEN, STRESS_AFTER, PROBE_ADDR,
