profile kernel

import lib.kstate
import sync.atomic
import mm.mmlock
import mm.tlbstat
import fs.procfs.pfproc

export { lines }

fn w_entry(state: u64, at: u64, name: u64, id: u64, takes: u64, spins: u64) -> u64 {
    var sp: [u8; 2] = " \0"
    var p: u64 = pfproc.w_str(state, at, name)
    p = pfproc.w_num(state, p, id)
    p = pfproc.w_str(state, p, (&sp[0]) as u64)
    p = pfproc.w_num(state, p, takes)
    p = pfproc.w_str(state, p, (&sp[0]) as u64)
    p = pfproc.w_num(state, p, spins)
    return pfproc.w_nl(state, p)
}

fn kernel_locks(state: u64, at: u64) -> u64 {
    var head: [u8; 6] = "lock.\0"
    var p: u64 = at
    var i: u64 = 0
    while i < kstate.LOCK_COUNT {
        p = w_entry(state, p, (&head[0]) as u64, i, atomic.lock_takes(state, i), atomic.lock_spins(state, i))
        i = i + 1
    }
    return p
}

fn mm_locks(state: u64, at: u64) -> u64 {
    var head: [u8; 8] = "mmlock.\0"
    var p: u64 = at
    var k: u64 = 0
    while k < mmlock.SPIN_KINDS {
        p = w_entry(state, p, (&head[0]) as u64, k, mmlock.spin_takes(k), mmlock.spin_count(k))
        k = k + 1
    }
    return p
}

fn tlb_counts(state: u64, at: u64) -> u64 {
    var head: [u8; 5] = "tlb.\0"
    var sp: [u8; 2] = " \0"
    var p: u64 = at
    var k: u64 = 0
    while k < tlbstat.COUNT {
        p = pfproc.w_str(state, p, (&head[0]) as u64)
        p = pfproc.w_num(state, p, k)
        p = pfproc.w_str(state, p, (&sp[0]) as u64)
        p = pfproc.w_num(state, p, tlbstat.get(k))
        p = pfproc.w_nl(state, p)
        k = k + 1
    }
    return p
}

fn lines(state: u64, at: u64) -> u64 {
    return tlb_counts(state, mm_locks(state, kernel_locks(state, at)))
}
