profile kernel

import lib.kstate

export { enter, raise, lower, ring_head, ring_num, ring_slot }

const RING_MASK: u64 = 31

static mut r_num: [u64; 32] = [0 as u64; 32]
static mut r_slot: [u64; 32] = [0 as u64; 32]
static mut r_head: u64 = 0
static mut slow_users: u64 = 0

fn enter(state: u64, number: u64, slot: u64) -> u64 {
    __atomic_add((state + kstate.SYSCALLS) as *mut u64, 1)
    let h: u64 = r_head
    r_num[(h & RING_MASK) as usize] = number
    r_slot[(h & RING_MASK) as usize] = slot
    r_head = h + 1
    return slow_users
}

fn raise() {
    __atomic_add((&slow_users) as *mut u64, 1)
}

fn lower() {
    slow_users = slow_users -% 1
}

fn ring_head() -> u64 {
    return r_head
}

fn ring_num(i: u64) -> u64 {
    return r_num[(i & RING_MASK) as usize]
}

fn ring_slot(i: u64) -> u64 {
    return r_slot[(i & RING_MASK) as usize]
}
