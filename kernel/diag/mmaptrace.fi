profile kernel

export { note, size, field, overflow, KIND_MAP, KIND_UNMAP, F_SLOT, F_KIND, F_LEN, F_RIP, F_CALLER1, F_CALLER2, F_COUNT, F_BYTES, clear_slot }

const ROWS: u64 = 256
const KIND_MAP: u64 = 1
const KIND_UNMAP: u64 = 2
const F_SLOT: u64 = 0
const F_KIND: u64 = 1
const F_LEN: u64 = 2
const F_RIP: u64 = 3
const F_CALLER1: u64 = 4
const F_CALLER2: u64 = 5
const F_COUNT: u64 = 6
const F_BYTES: u64 = 7

static mut t_slot: [u64; 256] = [0 as u64; 256]
static mut t_kind: [u64; 256] = [0 as u64; 256]
static mut t_len: [u64; 256] = [0 as u64; 256]
static mut t_rip: [u64; 256] = [0 as u64; 256]
static mut t_c1: [u64; 256] = [0 as u64; 256]
static mut t_c2: [u64; 256] = [0 as u64; 256]
static mut t_count: [u64; 256] = [0 as u64; 256]
static mut t_bytes: [u64; 256] = [0 as u64; 256]
static mut used: u64 = 0
static mut lost: u64 = 0

fn note(slot: u64, kind: u64, len: u64, rip: u64, c1: u64, c2: u64) {
    var i: u64 = 0
    while i < used {
        if t_slot[(i) as usize] == slot && t_kind[(i) as usize] == kind && t_len[(i) as usize] == len && t_rip[(i) as usize] == rip && t_c1[(i) as usize] == c1 && t_c2[(i) as usize] == c2 {
            t_count[(i) as usize] = t_count[(i) as usize] + 1
            t_bytes[(i) as usize] = t_bytes[(i) as usize] + len
            return
        }
        i = i + 1
    }
    if used >= ROWS {
        lost = lost + 1
        return
    }
    t_slot[(used) as usize] = slot
    t_kind[(used) as usize] = kind
    t_len[(used) as usize] = len
    t_rip[(used) as usize] = rip
    t_c1[(used) as usize] = c1
    t_c2[(used) as usize] = c2
    t_count[(used) as usize] = 1
    t_bytes[(used) as usize] = len
    used = used + 1
}

fn clear_slot(slot: u64) {
    var i: u64 = 0
    while i < used {
        if t_slot[(i) as usize] == slot {
            t_count[(i) as usize] = 0
            t_bytes[(i) as usize] = 0
        }
        i = i + 1
    }
}

fn size() -> u64 {
    return used
}

fn overflow() -> u64 {
    return lost
}

fn field(i: u64, f: u64) -> u64 {
    if i >= used {
        return 0
    }
    if f == F_SLOT {
        return t_slot[(i) as usize]
    }
    if f == F_KIND {
        return t_kind[(i) as usize]
    }
    if f == F_LEN {
        return t_len[(i) as usize]
    }
    if f == F_RIP {
        return t_rip[(i) as usize]
    }
    if f == F_CALLER1 {
        return t_c1[(i) as usize]
    }
    if f == F_CALLER2 {
        return t_c2[(i) as usize]
    }
    if f == F_COUNT {
        return t_count[(i) as usize]
    }
    return t_bytes[(i) as usize]
}
