
import serial
import lib.kstate
import bus.pci
import arch.x86_64.apic
import drv.blk.nvme
import drv.blk.ahci
import block.blk
import block.wlock
import fs.fs
import arch.x86_64.idt
import acpi.acpi
import libc.regio
import libc.numeric
import init.bootscan

export {
    parse, stage, disk, timer_off, mode_of,
    M_NOPCI, M_NOAPIC, M_NVME, M_BENCH, M_AHCI,
    M_NIC, M_NICINTX, M_NICNOIRQ, M_NICNOBM, M_NICTAB, M_NICSELF,
    M_NICICH, M_NICFAIL, M_NICFLUSH,
    net_ip, net_prefix, net_gw, net_set, net_svc, net_port, net_bytes, net_wait,
    net_ws, net_ts, net_sack,
    net_fallback,
    on, cmd_copy,
    blech_stage, gpe_abgeschaltet, gpe_status, ivrs_info, iommu_base,
    iommu_ctrl, iommu_stat, pmtmr_port, pmtmr_bits, smi_cmd,
    pm_tschz, pm_abweichung
}

const M_NOPCI: u64 = 1
const M_NOAPIC: u64 = 2
const M_NOIOAPIC: u64 = 4
const M_NVME: u64 = 8
const M_NOBM: u64 = 16
const M_NOMSIX: u64 = 32
const M_NOIRQ: u64 = 64
const M_BENCH: u64 = 128
const M_NVPOLL: u64 = 256
const M_NIC: u64 = 512
const M_NICINTX: u64 = 1024
const M_NICNOIRQ: u64 = 2048
const M_NICNOBM: u64 = 4096

const M_AHCI: u64 = 8192

const M_NICTAB: u64 = 16384
const M_NICSELF: u64 = 32768
const M_NICICH: u64 = 65536
const M_NICFAIL: u64 = 131072
const M_NICFLUSH: u64 = 524288
const M_AHCIRAID: u64 = 262144
const M_SLOWSATA: u64 = 1048576
const M_OLDSATA: u64 = 2097152
const M_LOSTSIG: u64 = 4194304
const M_FAKEWLAN: u64 = 8388608

const S_MODE: u64 = 0x1B0

const S_NIP: u64 = 0xC60
const S_NPREFIX: u64 = 0xC68
const S_NGW: u64 = 0xC70
const S_NSVC: u64 = 0xC78
const S_NPORT: u64 = 0xC80
const S_NBYTES: u64 = 0xC88
const S_NWAIT: u64 = 0xC90
const S_NVFALL: u64 = 0xC98
const S_NZWS: u64 = 0xCA0
const S_NZTS: u64 = 0xCA8
const S_NZSACK: u64 = 0xCB0

const TIMER_HZ: u64 = 100
const GSI_MOUSE: u64 = 12
const VEC_MOUSE: u64 = 46
const GSI_KEYBOARD: u64 = 1
const GSI_COM1: u64 = 4
const GSI_COM2: u64 = 3
const VEC_KEYBOARD: u64 = 33
const VEC_SERIAL: u64 = 36

const FS_BLOCKS: u64 = 2048
const BENCH_BLOCKS: u64 = 256
const BENCH_BATCH: u64 = 16

fn mode(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_MODE)
}

fn on(state: u64, bit: u64) -> bool {
    return (mode(state) & bit) != 0
}

fn parse(state: u64, cmd: u64) {
    kstate.set(state, pci.K2_SCALARS + S_MODE, mode_of(cmd))
    clock_words(state, cmd)
    save_cmd(state, cmd)
    net_parse(state, cmd)
}

const S_CMD: u64 = 0xE00
const CMD_MAX: u64 = 1023

fn save_cmd(state: u64, cmd: u64) {
    kstate.set8(pci.K2_SCALARS + S_CMD, 0 as u8)
    if cmd == 0 {
        return
    }
    var i: u64 = 0
    while i < CMD_MAX && kstate.get8(cmd + i) != 0 {
        kstate.set8(pci.K2_SCALARS + S_CMD + i, kstate.get8(cmd + i) as u8)
        i = i + 1
    }
    kstate.set8(pci.K2_SCALARS + S_CMD + i, 0 as u8)
}

fn clock_words(state: u64, cmd: u64) {
    var w_pit: [u8; 6] = "nopit\0"
    var w_pm: [u8; 5] = "nopm\0"
    var w_cpuid: [u8; 8] = "nocpuid\0"
    var w_hpet: [u8; 7] = "nohpet\0"
    var w_tick: [u8; 7] = "notick\0"
    var w_apict: [u8; 10] = "lapicmute\0"
    var bits: u64 = 0
    if bootscan.find_word(cmd, (&w_pit[0]) as u64, 5) != 0 {
        bits = bits | 1
    }
    if find(cmd, (&w_pm[0]) as u64, 4) != 0 {
        bits = bits | 2
    }
    if find(cmd, (&w_cpuid[0]) as u64, 7) != 0 {
        bits = bits | 4
    }
    if find(cmd, (&w_hpet[0]) as u64, 6) != 0 {
        bits = bits | 8
    }
    if find(cmd, (&w_tick[0]) as u64, 6) != 0 {
        bits = bits | 16
    }
    if find(cmd, (&w_apict[0]) as u64, 9) != 0 {
        bits = bits | 32
    }
    kstate.set(state, pci.K2_SCALARS + apic.S_NOSRC, bits)
}

fn cmd_copy(state: u64) -> u64 {
    if kstate.get8(pci.K2_SCALARS + S_CMD) == 0 {
        return 0
    }
    return pci.K2_SCALARS + S_CMD
}

fn net_parse(state: u64, cmd: u64) {
    var w_ip: [u8; 5] = "nip=\0"
    var w_gw: [u8; 5] = "ngw=\0"
    var w_svc: [u8; 6] = "nsvc=\0"
    var w_port: [u8; 7] = "nport=\0"
    var w_bytes: [u8; 8] = "nbytes=\0"
    var w_wait: [u8; 7] = "nwait=\0"
    var w_fall: [u8; 8] = "nvfall=\0"
    kstate.set(state, pci.K2_SCALARS + S_NIP, 0)
    kstate.set(state, pci.K2_SCALARS + S_NPREFIX, 24)
    kstate.set(state, pci.K2_SCALARS + S_NGW, 0)
    kstate.set(state, pci.K2_SCALARS + S_NSVC, 0)
    kstate.set(state, pci.K2_SCALARS + S_NPORT, 7)
    kstate.set(state, pci.K2_SCALARS + S_NBYTES, 262144)
    kstate.set(state, pci.K2_SCALARS + S_NWAIT, 0)
    kstate.set(state, pci.K2_SCALARS + S_NVFALL, 0)
    kstate.set(state, pci.K2_SCALARS + S_NZWS, 1)
    kstate.set(state, pci.K2_SCALARS + S_NZTS, 1)
    kstate.set(state, pci.K2_SCALARS + S_NZSACK, 1)
    if cmd == 0 {
        return
    }
    let a: u64 = find(cmd, (&w_ip[0]) as u64, 4)
    if a != 0 {
        var after: u64 = 0
        kstate.set(state, pci.K2_SCALARS + S_NIP, ip_of(a + 4, &after))
        if kstate.get8(after) == 47 {
            var e: u64 = 0
            let p: u64 = dec_of(after + 1, &e)
            let first: u64 = kstate.get8(after + 1)
            if first >= 48 && first <= 57 && p <= 32 {
                kstate.set(state, pci.K2_SCALARS + S_NPREFIX, p)
            }
        }
    }
    let g: u64 = find(cmd, (&w_gw[0]) as u64, 4)
    if g != 0 {
        var after2: u64 = 0
        kstate.set(state, pci.K2_SCALARS + S_NGW, ip_of(g + 4, &after2))
    }
    num_arg(state, cmd, (&w_svc[0]) as u64, 5, S_NSVC)
    num_arg(state, cmd, (&w_port[0]) as u64, 6, S_NPORT)
    num_arg(state, cmd, (&w_bytes[0]) as u64, 7, S_NBYTES)
    num_arg(state, cmd, (&w_wait[0]) as u64, 6, S_NWAIT)
    num_arg(state, cmd, (&w_fall[0]) as u64, 7, S_NVFALL)
    var w_zws: [u8; 6] = "nzws=\0"
    var w_zts: [u8; 6] = "nzts=\0"
    var w_zsk: [u8; 8] = "nzsack=\0"
    num_arg(state, cmd, (&w_zws[0]) as u64, 5, S_NZWS)
    num_arg(state, cmd, (&w_zts[0]) as u64, 5, S_NZTS)
    num_arg(state, cmd, (&w_zsk[0]) as u64, 7, S_NZSACK)
}

fn net_ws(state: u64) -> u64 { return kstate.get(state, pci.K2_SCALARS + S_NZWS) }
fn net_ts(state: u64) -> u64 { return kstate.get(state, pci.K2_SCALARS + S_NZTS) }
fn net_sack(state: u64) -> u64 { return kstate.get(state, pci.K2_SCALARS + S_NZSACK) }

fn num_arg(state: u64, cmd: u64, word: u64, n: u64, slot: u64) {
    let a: u64 = find(cmd, word, n)
    if a == 0 {
        return
    }
    var e: u64 = 0
    kstate.set(state, pci.K2_SCALARS + slot, dec_of(a + n, &e))
}

fn dec_of(p: u64, endp: *mut u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 20 {
        let c: u64 = kstate.get8(p + i)
        if c < 48 || c > 57 {
            i = 20
        } else {
            v = v * 10 + (c - 48)
            i = i + 1
        }
    }
    var k: u64 = 0
    while k < 20 {
        let c: u64 = kstate.get8(p + k)
        if c < 48 || c > 57 {
            *endp = p + k
            return v
        }
        k = k + 1
    }
    *endp = p + 20
    return v
}

fn ip_of(p: u64, endp: *mut u64) -> u64 {
    var v: u64 = 0
    var at: u64 = p
    var i: u64 = 0
    while i < 4 {
        var e: u64 = 0
        let part: u64 = dec_of(at, &e)
        v = (v << 8) | (part & 0xFF)
        at = e
        if i < 3 {
            if kstate.get8(at) != 46 {
                *endp = at
                return 0
            }
            at = at + 1
        }
        i = i + 1
    }
    *endp = at
    return v
}

fn net_set(state: u64, ip: u64, prefix: u64, gw: u64) {
    kstate.set(state, pci.K2_SCALARS + S_NIP, ip)
    kstate.set(state, pci.K2_SCALARS + S_NPREFIX, prefix)
    kstate.set(state, pci.K2_SCALARS + S_NGW, gw)
}

fn net_ip(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NIP)
}

fn net_prefix(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NPREFIX)
}

fn net_gw(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NGW)
}

fn net_svc(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NSVC)
}

fn net_port(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NPORT)
}

fn net_bytes(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NBYTES)
}

fn net_wait(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NWAIT)
}

fn net_fallback(state: u64) -> u64 {
    let v: u64 = kstate.get(state, pci.K2_SCALARS + S_NVFALL)
    if v > 2 {
        return 0
    }
    return v
}

fn clock_info(state: u64) {
    var w_facp: [u8; 5] = "FACP\0"
    var w_hpet: [u8; 5] = "HPET\0"
    let facp: u64 = acpi.table(state, (&w_facp[0]) as u64)
    if facp != 0 {
        let port: u64 = regio.read32(facp + F_PM_TMR)
        kstate.set(state, pci.K2_SCALARS + apic.S_PMPORT, port)
        var bits: u64 = 24
        if (regio.read32(facp + F_FLAGS) & 0x100) != 0 {
            bits = 32
        }
        kstate.set(state, pci.K2_SCALARS + apic.S_PMBITS, bits)
    }
    let hpet: u64 = acpi.table(state, (&w_hpet[0]) as u64)
    if hpet != 0 && regio.read32(hpet + 4) >= 56 {
        kstate.set(state, pci.K2_SCALARS + apic.S_HPET,
            __mmio_read64((hpet + 44) as *mut u64))
    }
}

fn stage(state: u64) {
    var s_off: [u8; 13] = "pci: skipped\0"
    var s_none: [u8; 16] = "apic: not there\0"
    var s_old: [u8; 21] = "apic: off, pic keeps\0"
    var s_on: [u8; 8] = "apic: \0\0"
    var s_id: [u8; 6] = "id=\0\0\0"
    var s_hz: [u8; 8] = "  hz=\0\0\0"
    var s_ent: [u8; 12] = "  ioapic=\0\0\0"
    var s_tick: [u8; 11] = "  tick=\0\0\0\0"
    var s_win: [u8; 10] = "  window=\0"
    var s_kbd: [u8; 24] = "apic: keyboard gsi 1 ->\0"
    var s_nokbd: [u8; 26] = "apic: keyboard NOT routed\0"

    if on(state, M_NOPCI) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
    } else {
        pci.scan(state)
        pci.list(state)
    }

    if on(state, M_NOAPIC) {
        serial.puts((&s_old[0]) as u64)
        serial.nl()
        return
    }
    if !apic.present() {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    clock_info(state)
    let up: bool = apic.init(state, TIMER_HZ)
    apic.timer_diag(state)
    if !up {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    apic.pic_off()
    serial.puts((&s_on[0]) as u64)
    serial.puts((&s_id[0]) as u64)
    serial.dec(apic.id(state))
    serial.puts((&s_hz[0]) as u64)
    serial.dec(apic.hz(state))
    serial.puts((&s_ent[0]) as u64)
    serial.dec(apic.ioapic_entries(state))
    serial.puts((&s_tick[0]) as u64)
    serial.dec(TIMER_HZ)
    serial.puts((&s_win[0]) as u64)
    serial.dec(apic.window_slots(state))
    serial.nl()

    var s_ser: [u8; 21] = "hw: serial gsi 4 ->\0\0"
    if on(state, M_NOIOAPIC) {
        serial.puts((&s_nokbd[0]) as u64)
        serial.nl()
    } else {
        if !kstate.mode_on(state, kstate.M_NOKIRQ) {
            apic.route(state, GSI_KEYBOARD, VEC_KEYBOARD, apic.id(state), false, false)
            serial.puts((&s_kbd[0]) as u64)
            serial.dec(VEC_KEYBOARD)
            serial.nl()
        }
        apic.route(state, GSI_MOUSE, VEC_MOUSE, apic.id(state), false, false)
        if kstate.mode_on(state, kstate.M_SERCON) {
            if !kstate.mode_on(state, kstate.M_NOSERIRQ) {
                apic.route(state, GSI_COM1, VEC_SERIAL, apic.id(state),
                    false, false)
                apic.route(state, GSI_COM2, VEC_SERIAL, apic.id(state),
                    false, false)
                serial.puts((&s_ser[0]) as u64)
                serial.dec(VEC_SERIAL)
                serial.nl()
            }
        }
    }
}

fn timer_off(state: u64) {
    if apic.active(state) {
        apic.timer_stop(state)
        return
    }
    idt.pic_mask(0xFD as u8, 0xFF as u8)
}

fn disk(state: u64) {
    if on(state, M_AHCI) {
        sata(state)
        return
    }
    var s_off: [u8; 14] = "nvme: skipped\0"
    var s_no: [u8; 16] = "nvme: no device\0"
    var s_fail: [u8; 20] = "nvme: init failed\0\0\0"
    var s_up: [u8; 8] = "nvme: \0\0"
    var s_blk: [u8; 8] = "blocks=\0"
    var s_sz: [u8; 10] = "  lbasz=\0\0"
    var s_irq: [u8; 8] = "  irq=\0\0"
    var s_msix: [u8; 6] = "msix\0\0"
    var s_intx: [u8; 6] = "intx\0\0"
    var s_masked: [u8; 9] = " masked\0\0"
    var s_bm: [u8; 12] = "  master=\0\0\0"

    if !on(state, M_NVME) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    if !nvme.present(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    if on(state, M_NVPOLL) {
        nvme.arm_polling(state)
    }
    let use_msix: bool = !on(state, M_NOMSIX)
    let armed: bool = !on(state, M_NOIRQ)
    let ok: bool = nvme.init(state, use_msix, armed)
    if on(state, M_NOBM) {
        pci.disable_master(nvme.bdf(state))
    }
    if !ok {
        serial.puts((&s_fail[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_up[0]) as u64)
    serial.puts((&s_blk[0]) as u64)
    serial.dec(nvme.blocks(state))
    serial.puts((&s_sz[0]) as u64)
    serial.dec(1 << nvme.block_shift(state))
    serial.puts((&s_irq[0]) as u64)
    if use_msix {
        serial.puts((&s_msix[0]) as u64)
    } else {
        serial.puts((&s_intx[0]) as u64)
    }
    if !armed {
        serial.puts((&s_masked[0]) as u64)
    }
    serial.puts((&s_bm[0]) as u64)
    serial.dec(numeric.yes(pci.master_on(nvme.bdf(state))))
    serial.nl()
    nvme.ns_report(state)
    nvme.ns_verify(state)

    if on(state, M_NOIRQ) {
        var n1: [u8; 20] = "nvme: noirq  onirq=\0"
        var n2: [u8; 10] = "  found=\0\0"
        var n3: [u8; 11] = "  polled=\0\0"
        var n4: [u8; 8] = "  irqs=\0"
        let buf: u64 = nvme.buffer(state, 0)
        serial.puts((&n1[0]) as u64)
        serial.dec(numeric.yes(nvme.read_block(state, 0, buf)))
        serial.puts((&n2[0]) as u64)
        serial.dec(nvme.drain(state))
        nvme.arm_polling(state)
        serial.puts((&n3[0]) as u64)
        serial.dec(numeric.yes(nvme.read_block(state, 0, buf)))
        serial.puts((&n4[0]) as u64)
        serial.dec(nvme.irqs(state))
        serial.nl()
        return
    }

    filesystem(state)
    if on(state, M_BENCH) {
        bench(state)
    }
}

const AHCI_LBA1: u64 = 4096
const AHCI_LBAN: u64 = 5000
const AHCI_MANY: u64 = 8

fn sata(state: u64) {
    var s_no: [u8; 16] = "ahci: no device\0"
    var s_ide: [u8; 33] = "ahci: mode=ide  set BIOS to AHCI\0"
    var s_fail: [u8; 19] = "ahci: init failed \0"
    var s_tfd: [u8; 7] = " tfd=\0\0"
    var s_why: [u8; 8] = "  why=\0\0"
    var s_up: [u8; 7] = "ahci: \0"
    var s_raid: [u8; 43] = "ahci: raid mode (class 01:04) used as AHCI\0"
    var s_blk: [u8; 8] = "blocks=\0"
    var s_sz: [u8; 10] = "  lbasz=\0\0"
    var s_prt: [u8; 8] = "  port=\0"
    var s_seen: [u8; 9] = "  ports=\0"
    var s_slot: [u8; 9] = "  slots=\0"
    var s_scan: [u8; 10] = "  scanus=\0"
    var s_bm: [u8; 10] = "  master=\0"
    var s_one: [u8; 14] = "ahci: one wr=\0"
    var s_rd: [u8; 7] = "  rd=\0\0"
    var s_same: [u8; 8] = "  same=\0"
    var s_pre: [u8; 8] = "  pre=\0\0"
    var s_many: [u8; 15] = "ahci: many wr=\0"
    var s_n: [u8; 5] = "  n=\0"
    var s_err: [u8; 9] = "  errs=\0\0"
    var s_cmd: [u8; 9] = "  cmds=\0\0"
    var s_dead: [u8; 9] = "  dead=\0\0"
    var s_live: [u8; 10] = "  alive=\0\0"

    if !ahci.present(state) {
        if ahci.ide_mode(state) {
            serial.puts((&s_ide[0]) as u64)
        } else {
            serial.puts((&s_no[0]) as u64)
        }
        serial.nl()
        return
    }
    if !ahci.init(state) {
        serial.puts((&s_fail[0]) as u64)
        serial.puts((&s_tfd[0]) as u64)
        serial.hex(ahci.last_tfd(state))
        serial.puts((&s_why[0]) as u64)
        serial.dec(ahci.why(state))
        serial.nl()
        return
    }

    if on(state, M_NOBM) {
        pci.disable_master(ahci.bdf(state))
    }

    if ahci.raid_mode(state) {
        serial.puts((&s_raid[0]) as u64)
        serial.nl()
    }
    serial.puts((&s_up[0]) as u64)
    serial.puts((&s_blk[0]) as u64)
    serial.dec(ahci.blocks(state))
    serial.puts((&s_sz[0]) as u64)
    serial.dec(1 << ahci.block_shift(state))
    serial.puts((&s_prt[0]) as u64)
    serial.dec(ahci.port(state))
    serial.puts((&s_seen[0]) as u64)
    serial.dec(ahci.ports_seen(state))
    serial.puts((&s_scan[0]) as u64)
    serial.dec(ahci.scan_us(state))
    serial.puts((&s_slot[0]) as u64)
    serial.dec(ahci.slots(state))
    serial.puts((&s_bm[0]) as u64)
    serial.dec(numeric.yes(pci.master_on(ahci.bdf(state))))
    serial.nl()

    let wbuf: u64 = ahci.buffer(state, 1)
    let rbuf: u64 = state + kstate.BLOCK_OFF
    fill(wbuf, 512, 0x5A)
    fill(rbuf, 512, 0xA5)
    if !wlock.foreign() {
        wlock.unlock(wlock.D_AHCI)
    }
    let w1: u64 = numeric.yes(ahci.write_block(state, AHCI_LBA1, wbuf))
    let pre: u64 = same(rbuf, wbuf, 512)
    let r1: u64 = numeric.yes(ahci.read_block(state, AHCI_LBA1, rbuf))
    serial.puts((&s_one[0]) as u64)
    serial.dec(w1)
    serial.puts((&s_rd[0]) as u64)
    serial.dec(r1)
    serial.puts((&s_pre[0]) as u64)
    serial.dec(pre)
    serial.puts((&s_same[0]) as u64)
    serial.dec(same(rbuf, wbuf, 512))
    serial.nl()

    let n: u64 = AHCI_MANY * 512
    stripe(wbuf, n)
    fill(rbuf, n, 0)
    let wn: u64 = numeric.yes(ahci.write_many(state, AHCI_LBAN, AHCI_MANY, wbuf))
    let rn: u64 = numeric.yes(ahci.read_many(state, AHCI_LBAN, AHCI_MANY, rbuf))
    serial.puts((&s_many[0]) as u64)
    serial.dec(wn)
    serial.puts((&s_rd[0]) as u64)
    serial.dec(rn)
    serial.puts((&s_n[0]) as u64)
    serial.dec(n)
    serial.puts((&s_same[0]) as u64)
    serial.dec(same(rbuf, wbuf, n))
    serial.nl()

    sata_fs(state)

    serial.puts((&s_up[0]) as u64)
    serial.puts((&s_cmd[0]) as u64)
    serial.dec(ahci.cmds(state))
    serial.puts((&s_err[0]) as u64)
    serial.dec(ahci.errs(state))
    serial.puts((&s_dead[0]) as u64)
    serial.dec(ahci.dead(state))
    serial.puts((&s_live[0]) as u64)
    serial.dec(numeric.yes(ahci.alive(state)))
    serial.nl()
}

fn sata_fs(state: u64) {
    var s_fmt: [u8; 14] = "ahci: format \0"
    var s_mount: [u8; 10] = "  mount=\0\0"
    var s_io: [u8; 14] = "ahci: wrote=\0\0"
    var s_read: [u8; 8] = "  read=\0"
    var s_same: [u8; 8] = "  same=\0"
    var s_list: [u8; 12] = "ahci: list \0"
    var p_file: [u8; 10] = "/sata.txt\0"
    var p_root: [u8; 2] = "/\0"
    var text: [u8; 31] = "ahci wrote this line over DMA\n\0"

    blk.use_ahci(state, FS_BLOCKS)
    serial.puts((&s_fmt[0]) as u64)
    serial.dec(numeric.yes(fs.format(state)))
    serial.puts((&s_mount[0]) as u64)
    serial.dec(numeric.yes(fs.mount(state)))
    serial.nl()
    let ino: u64 = fs.create_path(state, (&p_file[0]) as u64, fs.T_FILE)
    let wrote: u64 = fs.write_at(state, ino, 0, (&text[0]) as u64, 30)
    let scratch: u64 = state + kstate.BLOCK_OFF
    let got: u64 = fs.read_at(state, ino, 0, scratch, 64)
    serial.puts((&s_io[0]) as u64)
    serial.dec(wrote)
    serial.puts((&s_read[0]) as u64)
    serial.dec(got)
    serial.puts((&s_same[0]) as u64)
    serial.dec(same(scratch, (&text[0]) as u64, 30))
    serial.nl()
    list_dir(state, (&p_root[0]) as u64, (&s_list[0]) as u64)
}

fn fill(p: u64, n: u64, v: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, (v & 0xFF) as u8)
        i = i + 1
    }
}

fn stripe(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, (((i / 512) * 17 + i) & 0xFF) as u8)
        i = i + 1
    }
}

fn filesystem(state: u64) {
    var s_fmt: [u8; 14] = "nvme: format \0"
    var s_mount: [u8; 10] = "  mount=\0\0"
    var s_io: [u8; 14] = "nvme: wrote=\0\0"
    var s_read: [u8; 8] = "  read=\0"
    var s_same: [u8; 8] = "  same=\0"
    var s_list: [u8; 12] = "nvme: list \0"
    var s_irqs: [u8; 8] = "  irqs=\0"
    var s_wait: [u8; 9] = "  waits=\0"
    var p_file: [u8; 10] = "/nvme.txt\0"
    var p_root: [u8; 2] = "/\0"
    var text: [u8; 31] = "nvme wrote this line over DMA\n\0"

    blk.use_nvme(state, FS_BLOCKS)
    let before: u64 = nvme.irqs(state)
    serial.puts((&s_fmt[0]) as u64)
    serial.dec(numeric.yes(fs.format(state)))
    serial.puts((&s_mount[0]) as u64)
    serial.dec(numeric.yes(fs.mount(state)))
    serial.nl()
    let ino: u64 = fs.create_path(state, (&p_file[0]) as u64, fs.T_FILE)
    let wrote: u64 = fs.write_at(state, ino, 0, (&text[0]) as u64, 30)
    let scratch: u64 = state + kstate.BLOCK_OFF
    let got: u64 = fs.read_at(state, ino, 0, scratch, 64)
    serial.puts((&s_io[0]) as u64)
    serial.dec(wrote)
    serial.puts((&s_read[0]) as u64)
    serial.dec(got)
    serial.puts((&s_same[0]) as u64)
    serial.dec(same(scratch, (&text[0]) as u64, 30))
    serial.puts((&s_irqs[0]) as u64)
    serial.dec(nvme.irqs(state) - before)
    serial.puts((&s_wait[0]) as u64)
    serial.dec(nvme.waits(state))
    serial.nl()
    list_dir(state, (&p_root[0]) as u64, (&s_list[0]) as u64)
}

fn bench(state: u64) {
    var s_ata: [u8; 12] = "bench: ata \0"
    var s_nv: [u8; 13] = "bench: nvme \0"
    var s_many: [u8; 15] = "bench: nvme16 \0"
    var s_blocks: [u8; 8] = "blocks=\0"
    var s_cyc: [u8; 10] = "  cycles=\0"
    var s_us: [u8; 6] = "  us=\0"
    var s_kb: [u8; 11] = "  KiB_s=\0\0\0"
    var s_in: [u8; 12] = "  inwords=\0\0"
    var s_halt: [u8; 10] = "  halts=\0\0"
    var s_ok: [u8; 7] = "  ok=\0\0"
    var s_none: [u8; 26] = "bench: no ata drive, skip\0"
    var s_cmp: [u8; 15] = "bench: faster=\0"
    var s_pm: [u8; 8] = " permil\0"
    var s_hz: [u8; 12] = "bench: tsc=\0"

    let buf: u64 = nvme.buffer(state, 0)
    serial.puts((&s_hz[0]) as u64)
    serial.dec(apic.tsc_hz(state))
    serial.nl()

    if !blk.present(state) {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    blk.use_ata(state, BENCH_BLOCKS)
    let a0: u64 = apic.tsc()
    let aok: u64 = read_run(state, BENCH_BLOCKS, buf)
    let a1: u64 = apic.tsc()
    line(state, (&s_ata[0]) as u64, (&s_blocks[0]) as u64, (&s_cyc[0]) as u64,
        (&s_us[0]) as u64, (&s_kb[0]) as u64, (&s_in[0]) as u64,
        (&s_halt[0]) as u64, (&s_ok[0]) as u64,
        BENCH_BLOCKS, a1 - a0, BENCH_BLOCKS * 256, 0, aok)

    blk.use_nvme(state, BENCH_BLOCKS)
    let h0: u64 = nvme.waits(state)
    let n0: u64 = apic.tsc()
    let nok: u64 = read_run(state, BENCH_BLOCKS, buf)
    let n1: u64 = apic.tsc()
    line(state, (&s_nv[0]) as u64, (&s_blocks[0]) as u64, (&s_cyc[0]) as u64,
        (&s_us[0]) as u64, (&s_kb[0]) as u64, (&s_in[0]) as u64,
        (&s_halt[0]) as u64, (&s_ok[0]) as u64,
        BENCH_BLOCKS, n1 - n0, 0, nvme.waits(state) - h0, nok)

    let m0: u64 = apic.tsc()
    var done: u64 = 0
    var lba: u64 = 0
    while lba < BENCH_BLOCKS {
        if nvme.read_many(state, lba, BENCH_BATCH, buf) {
            done = done + BENCH_BATCH
        }
        lba = lba + BENCH_BATCH
    }
    let m1: u64 = apic.tsc()
    line(state, (&s_many[0]) as u64, (&s_blocks[0]) as u64, (&s_cyc[0]) as u64,
        (&s_us[0]) as u64, (&s_kb[0]) as u64, (&s_in[0]) as u64,
        (&s_halt[0]) as u64, (&s_ok[0]) as u64,
        BENCH_BLOCKS, m1 - m0, 0, 0, done)

    serial.puts((&s_cmp[0]) as u64)
    var factor: u64 = 0
    if (n1 - n0) > 0 {
        factor = (a1 - a0) * 1000 / (n1 - n0)
    }
    serial.dec(factor)
    serial.puts((&s_pm[0]) as u64)
    serial.nl()
}

fn read_run(state: u64, n: u64, buf: u64) -> u64 {
    var i: u64 = 0
    var ok: u64 = 0
    while i < n {
        if blk.read(state, i, buf) {
            ok = ok + 1
        }
        i = i + 1
    }
    return ok
}

fn line(state: u64, head: u64, l_blocks: u64, l_cyc: u64, l_us: u64,
    l_kb: u64, l_in: u64, l_halt: u64, l_ok: u64,
    blocks_n: u64, cycles: u64, inwords: u64, halts: u64, ok: u64) {
    let hz: u64 = apic.tsc_hz(state)
    serial.puts(head)
    serial.puts(l_blocks)
    serial.dec(blocks_n)
    serial.puts(l_cyc)
    serial.dec(cycles)
    var us: u64 = 0
    var kib: u64 = 0
    if hz > 0 && cycles > 0 {
        us = cycles * 1000000 / hz
        kib = blocks_n * 512 * hz / cycles / 1024
    }
    serial.puts(l_us)
    serial.dec(us)
    serial.puts(l_kb)
    serial.dec(kib)
    serial.puts(l_in)
    serial.dec(inwords)
    serial.puts(l_halt)
    serial.dec(halts)
    serial.puts(l_ok)
    serial.dec(ok)
    serial.nl()
}

fn same(a: u64, b: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < n {
        if kstate.get8(a + i) != kstate.get8(b + i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn list_dir(state: u64, p: u64, label: u64) {
    var s_sp: [u8; 2] = " \0"
    var s_colon: [u8; 2] = ":\0"
    let dir: u64 = fs.path(state, p)
    serial.puts(label)
    if dir == 0 {
        serial.nl()
        return
    }
    let out: u64 = state + kstate.NAME_OFF + 1024
    var i: u64 = 0
    var going: bool = true
    while going {
        let ino: u64 = fs.entry_at(state, dir, i, out, kstate.NAME_MAX - 1024)
        if ino == 0 {
            going = false
        } else {
            serial.puts(out + 8)
            serial.puts((&s_colon[0]) as u64)
            serial.dec(fs.inode_type(state, ino))
            serial.puts((&s_sp[0]) as u64)
            i = i + 1
        }
    }
    serial.nl()
}

fn mode_of(cmd: u64) -> u64 {
    var w_nopci: [u8; 6] = "nopci\0"
    var w_noapic: [u8; 7] = "noapic\0"
    var w_noio: [u8; 9] = "noioapic\0"
    var w_nvme: [u8; 5] = "nvme\0"
    var w_nobm: [u8; 5] = "nobm\0"
    var w_nomsix: [u8; 7] = "nomsix\0"
    var w_noirq: [u8; 6] = "noirq\0"
    var w_bench: [u8; 6] = "bench\0"
    var w_poll: [u8; 7] = "nvpoll\0"
    var w_nic: [u8; 4] = "nic\0"
    var w_nintx: [u8; 8] = "nicintx\0"
    var w_nnoirq: [u8; 9] = "nicnoirq\0"
    var w_nnobm: [u8; 8] = "nicnobm\0"
    var w_ahci: [u8; 5] = "ahci\0"
    var w_ntab: [u8; 7] = "nictab\0"
    var w_nself: [u8; 8] = "nicself\0"
    var w_nich: [u8; 7] = "nicich\0"
    var w_nfail: [u8; 8] = "nicfail\0"
    var w_nflush: [u8; 9] = "nicflush\0"
    var w_araid: [u8; 9] = "fakeraid\0"
    var w_slows: [u8; 9] = "slowsata\0"
    var w_olds: [u8; 8] = "oldsata\0"
    var w_lost: [u8; 8] = "lostsig\0"
    var w_fwl: [u8; 9] = "fakewlan\0"
    if cmd == 0 {
        return 0
    }
    var m: u64 = 0
    if find(cmd, (&w_nopci[0]) as u64, 5) != 0 {
        m = m | M_NOPCI
    }
    if find(cmd, (&w_noapic[0]) as u64, 6) != 0 {
        m = m | M_NOAPIC
    }
    if find(cmd, (&w_noio[0]) as u64, 8) != 0 {
        m = m | M_NOIOAPIC
    }
    if find(cmd, (&w_nvme[0]) as u64, 4) != 0 {
        m = m | M_NVME
    }
    if find(cmd, (&w_nobm[0]) as u64, 4) != 0 {
        m = m | M_NOBM
    }
    if find(cmd, (&w_nomsix[0]) as u64, 6) != 0 {
        m = m | M_NOMSIX
    }
    if find(cmd, (&w_noirq[0]) as u64, 5) != 0 {
        m = m | M_NOIRQ
    }
    if bootscan.find_lead(cmd, (&w_bench[0]) as u64, 5) != 0 {
        m = m | M_BENCH
    }
    if find(cmd, (&w_poll[0]) as u64, 6) != 0 {
        m = m | M_NVPOLL
    }
    if bootscan.find_lead(cmd, (&w_nic[0]) as u64, 3) != 0 {
        m = m | M_NIC
    }
    if find(cmd, (&w_nintx[0]) as u64, 7) != 0 {
        m = m | M_NICINTX
    }
    if find(cmd, (&w_nnoirq[0]) as u64, 8) != 0 {
        m = m | M_NICNOIRQ
    }
    if find(cmd, (&w_nnobm[0]) as u64, 7) != 0 {
        m = m | M_NICNOBM
    }
    if find(cmd, (&w_ahci[0]) as u64, 4) != 0 {
        m = m | M_AHCI
    }
    if find(cmd, (&w_ntab[0]) as u64, 6) != 0 {
        m = m | M_NICTAB
    }
    if find(cmd, (&w_nself[0]) as u64, 7) != 0 {
        m = m | M_NICSELF
    }
    if find(cmd, (&w_nich[0]) as u64, 6) != 0 {
        m = m | M_NICICH
    }
    if find(cmd, (&w_nfail[0]) as u64, 7) != 0 {
        m = m | M_NICFAIL
    }
    if find(cmd, (&w_nflush[0]) as u64, 8) != 0 {
        m = m | M_NICFLUSH
    }
    if find(cmd, (&w_araid[0]) as u64, 8) != 0 {
        m = m | M_AHCIRAID
    }
    if find(cmd, (&w_slows[0]) as u64, 8) != 0 {
        m = m | M_SLOWSATA
    }
    if find(cmd, (&w_olds[0]) as u64, 7) != 0 {
        m = m | M_OLDSATA
    }
    if find(cmd, (&w_lost[0]) as u64, 7) != 0 {
        m = m | M_LOSTSIG
    }
    if find(cmd, (&w_fwl[0]) as u64, 8) != 0 {
        m = m | M_FAKEWLAN
    }
    return m
}

fn find(hay: u64, needle: u64, n: u64) -> u64 {
    var i: u64 = 0
    while kstate.get8(hay + i) != 0 {
        var k: u64 = 0
        var hit: bool = true
        while k < n {
            if kstate.get8(hay + i + k) != kstate.get8(needle + k) {
                hit = false
                k = n
            } else {
                k = k + 1
            }
        }
        if hit {
            return hay + i
        }
        i = i + 1
    }
    return 0
}

const F_SMI_CMD: u64 = 48
const F_ACPI_EN: u64 = 52
const F_PM_TMR: u64 = 76
const F_GPE0: u64 = 80
const F_GPE1: u64 = 84
const F_PM_TMR_LEN: u64 = 91
const F_GPE0_LEN: u64 = 92
const F_GPE1_LEN: u64 = 93
const F_FLAGS: u64 = 112

const S_GPE_N: u64 = 0xCC8
const S_GPE_ST: u64 = 0xCD0
const S_IVRS: u64 = 0xCD8
const S_IOMMU: u64 = 0xCE0
const S_IOMMU_C: u64 = 0xCE8
const S_IOMMU_S: u64 = 0xCF0
const S_PMTMR: u64 = 0xCF8
const S_PMBITS: u64 = 0xD00
const S_SMI: u64 = 0xD08
const S_PMHZ: u64 = 0xD10
const S_ABW: u64 = 0xD18

fn dg(state: u64, off: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + off)
}

fn ds(state: u64, off: u64, v: u64) {
    kstate.set(state, pci.K2_SCALARS + off, v)
}

fn gpe_abgeschaltet(state: u64) -> u64 {
    return dg(state, S_GPE_N)
}

fn gpe_status(state: u64) -> u64 {
    return dg(state, S_GPE_ST)
}

fn ivrs_info(state: u64) -> u64 {
    return dg(state, S_IVRS)
}

fn iommu_base(state: u64) -> u64 {
    return dg(state, S_IOMMU)
}

fn iommu_ctrl(state: u64) -> u64 {
    return dg(state, S_IOMMU_C)
}

fn iommu_stat(state: u64) -> u64 {
    return dg(state, S_IOMMU_S)
}

fn pmtmr_port(state: u64) -> u64 {
    return dg(state, S_PMTMR)
}

fn pmtmr_bits(state: u64) -> u64 {
    return dg(state, S_PMBITS)
}

fn smi_cmd(state: u64) -> u64 {
    return dg(state, S_SMI)
}

fn pm_tschz(state: u64) -> u64 {
    return dg(state, S_PMHZ)
}

fn pm_abweichung(state: u64) -> u64 {
    return dg(state, S_ABW)
}

fn gpe_block_off(state: u64, blk: u64, len: u64) -> u64 {
    if blk == 0 || len < 2 {
        return 0
    }
    let halb: u64 = len / 2
    var seen: u64 = 0
    var i: u64 = 0
    while i < halb {
        let sts: u64 = (blk + i) & 0xFFFF
        let en: u64 = (blk + halb + i) & 0xFFFF
        seen = seen | (serial.in8(sts as u16) as u64)
        serial.out8(en as u16, 0 as u8)
        serial.out8(sts as u16, 0xFF as u8)
        i = i + 1
    }
    ds(state, S_GPE_ST, dg(state, S_GPE_ST) | seen)
    return halb * 8
}

fn blech_stage(state: u64) {
    var s_g: [u8; 12] = "acpi: gpe=\0\0"
    var s_gs: [u8; 7] = " sts=\0\0"
    var s_t: [u8; 9] = " pmtmr=\0\0"
    var s_tb: [u8; 7] = " bits=\0"
    var s_s: [u8; 7] = " smi=\0\0"
    var s_i: [u8; 13] = "acpi: ivrs=\0\0"
    var s_ib: [u8; 8] = " base=\0\0"
    var s_ic: [u8; 8] = " ctrl=\0\0"
    var s_is: [u8; 8] = " stat=\0\0"
    var s_keine: [u8; 6] = "keine\0"
    var w_facp: [u8; 5] = "FACP\0"
    var w_ivrs: [u8; 5] = "IVRS\0"

    let facp: u64 = acpi.table(state, (&w_facp[0]) as u64)
    if facp != 0 {
        ds(state, S_SMI, regio.read32(facp + F_SMI_CMD))
        ds(state, S_PMTMR, regio.read32(facp + F_PM_TMR))
        var bits: u64 = 24
        if (regio.read32(facp + F_FLAGS) & 0x100) != 0 {
            bits = 32
        }
        ds(state, S_PMBITS, bits)
        var n: u64 = gpe_block_off(state, regio.read32(facp + F_GPE0),
            kstate.get8(facp + F_GPE0_LEN))
        n = n + gpe_block_off(state, regio.read32(facp + F_GPE1),
            kstate.get8(facp + F_GPE1_LEN))
        ds(state, S_GPE_N, n)
    }
    serial.puts((&s_g[0]) as u64)
    serial.dec(dg(state, S_GPE_N))
    serial.puts((&s_gs[0]) as u64)
    serial.dec(dg(state, S_GPE_ST))
    serial.puts((&s_t[0]) as u64)
    serial.dec(dg(state, S_PMTMR))
    serial.puts((&s_tb[0]) as u64)
    serial.dec(dg(state, S_PMBITS))
    serial.puts((&s_s[0]) as u64)
    serial.dec(dg(state, S_SMI))
    serial.nl()

    var s_pm: [u8; 13] = "acpi: pmhz=\0\0"
    var s_pit: [u8; 8] = " pit=\0\0\0"
    var s_ab: [u8; 9] = " abw=\0\0\0\0"
    let pmhz: u64 = apic.tsc_gegen_pm(dg(state, S_PMTMR), dg(state, S_PMBITS))
    ds(state, S_PMHZ, pmhz)
    let pithz: u64 = apic.tsc_hz(state)
    ds(state, S_ABW, 9999)
    if pmhz != 0 && pithz != 0 {
        var d: u64 = 0
        if pithz > pmhz {
            d = pithz - pmhz
        } else {
            d = pmhz - pithz
        }
        ds(state, S_ABW, (d *% 1000) / pmhz)
    }
    serial.puts((&s_pm[0]) as u64)
    serial.dec(pmhz)
    serial.puts((&s_pit[0]) as u64)
    serial.dec(pithz)
    serial.puts((&s_ab[0]) as u64)
    serial.dec(dg(state, S_ABW))
    serial.nl()

    let ivrs: u64 = acpi.table(state, (&w_ivrs[0]) as u64)
    serial.puts((&s_i[0]) as u64)
    if ivrs == 0 {
        serial.puts((&s_keine[0]) as u64)
        serial.nl()
        return
    }
    ds(state, S_IVRS, regio.read32(ivrs + 36))
    let len_v: u64 = regio.read32(ivrs + 4)
    var p: u64 = ivrs + 48
    var basis: u64 = 0
    while p + 4 <= ivrs + len_v && basis == 0 {
        let typ: u64 = kstate.get8(p)
        let l: u64 = kstate.get8(p + 2) | (kstate.get8(p + 3) << 8)
        if l < 4 {
            p = ivrs + len_v
        } else {
            if typ == 0x10 || typ == 0x11 || typ == 0x40 {
                basis = __mmio_read64((p + 8) as *mut u64)
            }
            p = p + l
        }
    }
    ds(state, S_IOMMU, basis)
    if basis != 0 {
        let v: u64 = apic.map_device(state, basis & 0xFFFFFFFFFFFFC000)
        if v != 0 {
            ds(state, S_IOMMU_C, __mmio_read64((v + 0x18) as *mut u64))
            ds(state, S_IOMMU_S, __mmio_read64((v + 0x2020) as *mut u64))
        }
    }
    serial.dec(dg(state, S_IVRS))
    serial.puts((&s_ib[0]) as u64)
    serial.dec(dg(state, S_IOMMU))
    serial.puts((&s_ic[0]) as u64)
    serial.dec(dg(state, S_IOMMU_C))
    serial.puts((&s_is[0]) as u64)
    serial.dec(dg(state, S_IOMMU_S))
    serial.nl()
}
