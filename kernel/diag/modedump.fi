profile kernel

import lib.kstate
import lib.cmdword
import serial

export { parse, report }

fn parse(state: u64, cmd: u64) {
    var w_dump: [u8; 9] = "modedump\0"
    if cmdword.find(cmd, (&w_dump[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_MODEDUMP)
    }
}

fn report(state: u64) {
    var s_head: [u8; 13] = "boot: modes \0"
    if !kstate.mode_on(state, kstate.M_MODEDUMP) {
        return
    }
    serial.puts((&s_head[0]) as u64)
    var w: u64 = 0
    while w < kstate.MODE_WORDS {
        serial.hex(kstate.mode_word(state, w))
        serial.put(32 as u8)
        w = w + 1
    }
    serial.nl()
}
