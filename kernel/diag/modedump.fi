profile kernel

import lib.modes.words_diag
import lib.kstate
import serial

export { report }

fn report(state: u64) {
    var s_head: [u8; 13] = "boot: modes \0"
    if !kstate.mode_on(state, words_diag.M_MODEDUMP) {
        return
    }
    serial.puts((&s_head[0]) as u64)
    var w: u64 = 0
    while w < kstate.MODE_WORDS {
        serial.hex(kstate.mode_word(state, w))
        serial.put(32 as u8)
        w = w + 1
    }
    serial.nl()
}
