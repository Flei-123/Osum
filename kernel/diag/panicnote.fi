profile kernel

import lib.kstate
import diag.crash

export { write, length }

const V_PANIC_NOTE: u64 = 78
const N_LEN: u64 = 0
const N_OP1: u64 = 8
const N_OP2: u64 = 16
const N_TEXT: u64 = 24
const TEXT_MAX: u64 = 112

fn base(state: u64) -> u64 {
    let vec: u64 = kstate.get(state, kstate.VECTORS)
    if vec == 0 {
        return 0
    }
    return __mmio_read64((vec + V_PANIC_NOTE * 8) as *mut u64)
}

fn length(state: u64) -> u64 {
    let b: u64 = base(state)
    if b == 0 {
        return 0
    }
    let n: u64 = __mmio_read64((b + N_LEN) as *mut u64)
    if n > TEXT_MAX {
        return TEXT_MAX
    }
    return n
}

fn write(state: u64) {
    var s_h: [u8; 13] = "panic-text: \0"
    var s_o: [u8; 6] = " ops=\0"
    var s_c: [u8; 2] = ",\0"
    let n: u64 = length(state)
    if n == 0 {
        return
    }
    let b: u64 = base(state)
    crash.p_str((&s_h[0]) as u64)
    crash.p_bytes(b + N_TEXT, n)
    crash.p_str((&s_o[0]) as u64)
    crash.p_hex(__mmio_read64((b + N_OP1) as *mut u64), 16)
    crash.p_str((&s_c[0]) as u64)
    crash.p_hex(__mmio_read64((b + N_OP2) as *mut u64), 16)
    crash.p_nl()
}
