profile kernel

import lib.kstate
import klog
import fs.fs
import block.blk

export { save, panic_save, boot_no, saved_seq, segment_files, segment_max }

const SEGMENT_FILES: u64 = 4
const SEGMENT_MAX: u64 = 262144
const CHUNK_MAX: u64 = 4096
const LINE_MAX: u64 = 256
const HEADER_BYTES: u64 = 12
const PATH_MAX: u64 = 24

static mut chunk: [u8; 4096] = [0 as u8; 4096]
static mut line_buf: [u8; 256] = [0 as u8; 256]
static mut path_a: [u8; 24] = [0 as u8; 24]
static mut path_b: [u8; 24] = [0 as u8; 24]
static mut head_buf: [u8; 32] = [0 as u8; 32]
static mut boot_id: u64 = 0
static mut next_seq: u64 = 0
static mut segment_size: u64 = 0
static mut started: u64 = 0
static mut busy: u64 = 0
static mut dirty: u64 = 0

fn segment_files() -> u64 {
    return SEGMENT_FILES
}

fn segment_max() -> u64 {
    return SEGMENT_MAX
}

fn boot_no() -> u64 {
    return boot_id
}

fn saved_seq() -> u64 {
    return next_seq
}

fn put_str(dst: u64, at: u64, src: u64) -> u64 {
    var n: u64 = at
    var i: u64 = 0
    while kstate.get8(src + i) != 0 {
        kstate.set8(dst + n, kstate.get8(src + i) as u8)
        n = n + 1
        i = i + 1
    }
    return n
}

fn put_dec(dst: u64, at: u64, v: u64) -> u64 {
    var digits: [u8; 24] = [0 as u8; 24]
    var m: u64 = 0
    var x: u64 = v
    if x == 0 {
        digits[0 as usize] = 48 as u8
        m = 1
    }
    while x > 0 {
        digits[m as usize] = (48 + (x % 10)) as u8
        x = x / 10
        m = m + 1
    }
    var n: u64 = at
    while m > 0 {
        kstate.set8(dst + n, digits[(m - 1) as usize])
        n = n + 1
        m = m - 1
    }
    return n
}

fn segment_path(out: u64, index: u64) {
    var base: [u8; 14] = "/var/log/klog\0"
    var n: u64 = put_str(out, 0, (&base[0 as usize]) as u64)
    if index > 0 {
        kstate.set8(out + n, 46 as u8)
        n = n + 1
        n = put_dec(out, n, index)
    }
    kstate.set8(out + n, 0 as u8)
}

fn ensure_dirs(state: u64) -> bool {
    var var_dir: [u8; 5] = "/var\0"
    var log_dir: [u8; 9] = "/var/log\0"
    if fs.path(state, (&var_dir[0 as usize]) as u64) == 0 {
        if fs.create_path(state, (&var_dir[0 as usize]) as u64, fs.T_DIR) == 0 {
            return false
        }
    }
    if fs.path(state, (&log_dir[0 as usize]) as u64) == 0 {
        if fs.create_path(state, (&log_dir[0 as usize]) as u64, fs.T_DIR) == 0 {
            return false
        }
    }
    return true
}

fn parse_boot(state: u64, ino: u64) -> u64 {
    var prefix: [u8; 13] = "# klog boot \0"
    let h: u64 = (&head_buf[0 as usize]) as u64
    let n: u64 = fs.read_at(state, ino, 0, h, 31)
    if n <= HEADER_BYTES {
        return 0
    }
    var i: u64 = 0
    while i < HEADER_BYTES {
        if kstate.get8(h + i) != kstate.get8((&prefix[0 as usize]) as u64 + i) {
            return 0
        }
        i = i + 1
    }
    var v: u64 = 0
    while i < n {
        let c: u64 = kstate.get8(h + i)
        if c < 48 || c > 57 {
            return v
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

fn rotate(state: u64) {
    let a: u64 = (&path_a[0 as usize]) as u64
    let b: u64 = (&path_b[0 as usize]) as u64
    segment_path(a, SEGMENT_FILES - 1)
    let _gone: bool = fs.unlink_path(state, a)
    var i: u64 = SEGMENT_FILES - 1
    while i > 0 {
        segment_path(a, i - 1)
        segment_path(b, i)
        if fs.path(state, a) != 0 {
            let _r: u64 = fs.rename_path(state, a, b)
        }
        i = i - 1
    }
}

fn begin_segment(state: u64) -> u64 {
    var prefix: [u8; 13] = "# klog boot \0"
    let a: u64 = (&path_a[0 as usize]) as u64
    segment_path(a, 0)
    var ino: u64 = fs.path(state, a)
    if ino == 0 {
        ino = fs.create_path(state, a, fs.T_FILE)
    }
    if ino == 0 {
        return 0
    }
    let c: u64 = (&chunk[0 as usize]) as u64
    var n: u64 = put_str(c, 0, (&prefix[0 as usize]) as u64)
    n = put_dec(c, n, boot_id)
    kstate.set8(c + n, 10 as u8)
    n = n + 1
    if fs.write_at(state, ino, 0, c, n) != n {
        return 0
    }
    segment_size = n
    return ino
}

fn start(state: u64) -> bool {
    if !ensure_dirs(state) {
        return false
    }
    let a: u64 = (&path_a[0 as usize]) as u64
    segment_path(a, 0)
    let old: u64 = fs.path(state, a)
    boot_id = 1
    if old != 0 {
        boot_id = parse_boot(state, old) + 1
        rotate(state)
    }
    if begin_segment(state) == 0 {
        return false
    }
    next_seq = klog.first_seq(state)
    started = 1
    return true
}

fn flush_chunk(state: u64, ino: u64, used: u64) -> u64 {
    if used == 0 {
        return ino
    }
    let n: u64 = fs.write_at(state, ino, segment_size, (&chunk[0 as usize]) as u64, used)
    segment_size = segment_size + n
    if segment_size >= SEGMENT_MAX {
        rotate(state)
        return begin_segment(state)
    }
    return ino
}

fn append_lines(state: u64, first_ino: u64, last: u64) -> u64 {
    let c: u64 = (&chunk[0 as usize]) as u64
    let l: u64 = (&line_buf[0 as usize]) as u64
    var ino: u64 = first_ino
    var used: u64 = 0
    var saved: u64 = 0
    var s: u64 = next_seq
    if s < klog.first_seq(state) {
        s = klog.first_seq(state)
    }
    while s <= last && ino != 0 {
        let n: u64 = klog.line_at(state, s, l, LINE_MAX - 1)
        if used + n > CHUNK_MAX {
            ino = flush_chunk(state, ino, used)
            used = 0
        }
        var i: u64 = 0
        while i < n {
            kstate.set8(c + used + i, kstate.get8(l + i) as u8)
            i = i + 1
        }
        used = used + n
        if n != 0 {
            saved = saved + 1
        }
        s = s + 1
    }
    if ino != 0 {
        let _ino: u64 = flush_chunk(state, ino, used)
    }
    next_seq = s
    return saved
}

fn save(state: u64, flush: bool) -> u64 {
    if !fs.ready(state) || busy != 0 {
        return 0
    }
    busy = 1
    if started == 0 && !start(state) {
        busy = 0
        return 0
    }
    var saved: u64 = 0
    let last: u64 = klog.seq(state)
    if next_seq <= last {
        let a: u64 = (&path_a[0 as usize]) as u64
        segment_path(a, 0)
        var ino: u64 = fs.path(state, a)
        if ino == 0 {
            ino = begin_segment(state)
        }
        saved = append_lines(state, ino, last)
    }
    if saved != 0 {
        dirty = 1
    }
    if flush && dirty != 0 {
        let _f: bool = blk.flush(state)
        dirty = 0
    }
    busy = 0
    return saved
}

fn panic_save(state: u64) {
    busy = 0
    let _n: u64 = save(state, false)
}
