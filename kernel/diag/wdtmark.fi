profile kernel

import serial

export { load, mark, prev_state, prev_info, ST_NONE, ST_CLEAN, ST_ARMED, ST_FREEZE, ST_PLANTED, ST_PANIC }

const CM_MAGIC: u64 = 0x78
const CM_STATE: u64 = 0x79
const CM_INFO: u64 = 0x7A
const CM_CHECK: u64 = 0x7B
const MAGIC: u64 = 0x5C

const ST_NONE: u64 = 255
const ST_CLEAN: u64 = 0
const ST_ARMED: u64 = 1
const ST_FREEZE: u64 = 2
const ST_PLANTED: u64 = 3
const ST_PANIC: u64 = 4

static mut p_state: u64 = 255
static mut p_info: u64 = 0

fn cm_r(i: u64) -> u64 {
    serial.out8(0x70 as u16, i as u8)
    return serial.in8(0x71 as u16) as u64
}

fn cm_w(i: u64, v: u64) {
    serial.out8(0x70 as u16, i as u8)
    serial.out8(0x71 as u16, (v & 255) as u8)
}

fn check_of(st: u64, info: u64) -> u64 {
    return (MAGIC + st * 5 + info * 3 + 0x21) & 255
}

fn load() {
    p_state = ST_NONE
    p_info = 0
    if cm_r(CM_MAGIC) != MAGIC {
        return
    }
    let st: u64 = cm_r(CM_STATE)
    let info: u64 = cm_r(CM_INFO)
    if cm_r(CM_CHECK) != check_of(st, info) || st > ST_PANIC {
        return
    }
    p_state = st
    p_info = info
}

fn prev_state() -> u64 {
    return p_state
}

fn prev_info() -> u64 {
    return p_info
}

fn mark(st: u64, info: u64) {
    cm_w(CM_MAGIC, MAGIC)
    cm_w(CM_STATE, st)
    cm_w(CM_INFO, info)
    cm_w(CM_CHECK, check_of(st, info))
}
