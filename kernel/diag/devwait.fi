profile kernel

export { touch, recent }

static mut last_tsc: u64 = 0

fn read_tsc() -> u64 {
    var lo: u64 = 0
    var hi: u64 = 0
    asm("rdtsc", out("rax") & lo, out("rdx") & hi)
    return (hi << 32) | (lo & 0xFFFFFFFF)
}

fn touch() {
    last_tsc = read_tsc()
}

fn recent(now: u64, window: u64) -> bool {
    let t: u64 = last_tsc
    return t != 0 && now >= t && now - t <= window
}
