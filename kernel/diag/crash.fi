
profile kernel

import lib.kstate
import serial
import klog
import lib.ksymtab
import sched.time
import fs.fs
import gfx.gfx
import arch.cpu
import sched.sched
import lib.version
import mm.mmboot
import diag.safe
import block.blk

export {
    init, open, brand_delete, knall,
    kernel_report, prog_report, last_file, ram_retten, set_volatile,
    doppel_check, report_buf, report_len, p_bytes, ram_drop, hang_begin, hang_store, hang_file, hang_forget, p_str, p_dec, p_hex, p_nl, p_addr,
    KIND_PANIC, KIND_HANG, KIND_SOFT, rescued,
    A_KERN, A_PROG, geschrieben, tried, gescheitert
}

const A_KERN: u64 = 0
const KIND_PANIC: u64 = 0
const KIND_HANG: u64 = 1
const KIND_SOFT: u64 = 2
static mut ram_kind: u64 = 0
static mut file_kind: u64 = 0
static mut rescued_n: u64 = 0

fn rescued() -> bool {
    return rescued_n != 0
}
const A_PROG: u64 = 1

const BUF_MAX: u64 = 8192
static mut buf: [u8; 8192] = [0 as u8; 8192]
static mut buf_n: u64 = 0
static mut ge: u64 = 0
static mut ver: u64 = 0
static mut failed: u64 = 0
static mut open_flag: u64 = 0
static mut name_buf: [u8; 64] = [0 as u8; 64]

fn init(state: u64) {
    var m: [u8; 16] = "/var/crash/NEW\0\0"
    if fs.path(state, (&m[0 as usize]) as u64) != 0 {
        open_flag = 1
    } else {
        open_flag = 0
    }
}

fn open(state: u64) -> u64 {
    var m: [u8; 15] = "/var/crash/NEW\0"
    if !fs.ready(state) {
        return open_flag
    }
    if fs.path(state, (&m[0 as usize]) as u64) != 0 {
        open_flag = 1
    } else {
        open_flag = 0
    }
    return open_flag
}

fn brand_delete(state: u64) -> u64 {
    var m: [u8; 16] = "/var/crash/NEW\0\0"
    open_flag = 0
    if fs.unlink_path(state, (&m[0 as usize]) as u64) {
        return 1
    }
    return 0
}

fn geschrieben() -> u64 {
    return ge
}

fn tried() -> u64 {
    return ver
}

fn gescheitert() -> u64 {
    return failed
}

fn last_file() -> u64 {
    if name_buf[0 as usize] == 0 as u8 {
        return 0
    }
    return (&name_buf[0 as usize]) as u64
}

fn report_buf() -> u64 {
    return (&buf[0 as usize]) as u64
}

fn report_len() -> u64 {
    return buf_n
}

fn p_bytes(src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        p_ch(kstate.get8(src + i))
        i = i + 1
    }
}

fn ram_drop() {
    ram_clear()
}

fn p_ch(c: u64) {
    if buf_n >= BUF_MAX - 1 {
        return
    }
    buf[buf_n as usize] = (c & 0xFF) as u8
    buf_n = buf_n + 1
}

fn p_str(s: u64) {
    if s == 0 {
        return
    }
    var i: u64 = 0
    while i < 512 {
        let c: u64 = kstate.get8(s + i)
        if c == 0 {
            return
        }
        p_ch(c)
        i = i + 1
    }
}

fn p_dec(v: u64) {
    var t: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        t[0 as usize] = 48 as u8
        n = 1
    }
    while x > 0 {
        t[n as usize] = (48 + (x % 10)) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        p_ch(t[(n - 1) as usize] as u64)
        n = n - 1
    }
}

fn p_hex(v: u64, w: u64) {
    p_ch(48)
    p_ch(120)
    var i: u64 = w
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * 4)) & 15
        if d < 10 {
            p_ch(48 + d)
        } else {
            p_ch(87 + d)
        }
    }
}

fn p_nl() {
    p_ch(10)
}

fn p_addr(a: u64) {
    var s_plus: [u8; 2] = "+\0"
    var s_ob: [u8; 3] = " (\0"
    var s_co: [u8; 2] = ":\0"
    var s_cb: [u8; 2] = ")\0"
    let i: u64 = ksymtab.resolve(a)
    if i >= ksymtab.n_sym() {
        p_hex(a, 16)
        return
    }
    p_str(ksymtab.sym_name(i))
    p_str((&s_plus[0 as usize]) as u64)
    p_hex(a - ksymtab.sym_addr(i), 4)
    let pk: u64 = ksymtab.line_of(a)
    if pk == 0 {
        return
    }
    let f: u64 = ksymtab.file_name(ksymtab.line_file(pk))
    if f == 0 {
        return
    }
    p_str((&s_ob[0 as usize]) as u64)
    p_str(f)
    p_str((&s_co[0 as usize]) as u64)
    p_dec(ksymtab.line_nr(pk))
    p_str((&s_cb[0 as usize]) as u64)
}

fn header(state: u64, art: u64, kern: u64, pid: u64, name: u64) {
    var s_k: [u8; 35] = "=== OSUM CRASH REPORT (KERNEL) ===\0"
    var s_p: [u8; 36] = "=== OSUM CRASH REPORT (PROGRAM) ===\0"
    var s_f: [u8; 10] = "version: \0"
    var s_z: [u8; 8] = "time:  \0"
    var s_c: [u8; 9] = "kernel: \0"
    var s_i: [u8; 8] = "pid:   \0"
    var s_n: [u8; 8] = "prog:  \0"
    buf_n = 0
    if art == A_KERN {
        p_str((&s_k[0 as usize]) as u64)
    } else {
        p_str((&s_p[0 as usize]) as u64)
    }
    p_nl()
    p_str((&s_f[0 as usize]) as u64)
    p_str(version.text())
    p_nl()
    p_str((&s_z[0 as usize]) as u64)
    p_dec(time.now_sec(state))
    p_nl()
    p_str((&s_c[0 as usize]) as u64)
    p_dec(kern)
    p_nl()
    p_str((&s_i[0 as usize]) as u64)
    p_dec(pid)
    p_nl()
    if name != 0 {
        p_str((&s_n[0 as usize]) as u64)
        p_str(name)
        p_nl()
    }
}

fn register(regs: u64, rip: u64, cs: u64, flg: u64, rsp: u64, ss: u64,
        err: u64, cr2: u64, vec: u64) {
    var names: [u8; 64] = "rax\0rbx\0rcx\0rdx\0rsi\0rdi\0rbp\0rsp\0r8 \0r9 \0r10\0r11\0r12\0r13\0r14\0r15\0"
    var s_h: [u8; 13] = "-- register\0\0"
    var s_v: [u8; 8] = "vector \0"
    var s_e: [u8; 7] = "  err \0"
    var s_r: [u8; 7] = "  cr2 \0"
    var s_ri: [u8; 6] = "rip \0\0"
    var s_cs: [u8; 7] = "  cs \0\0"
    var s_fl: [u8; 11] = "  rflags \0\0"
    var s_sp: [u8; 8] = "  rsp \0\0"
    var s_ss: [u8; 7] = "  ss \0\0"
    p_str((&s_h[0 as usize]) as u64)
    p_nl()
    p_str((&s_v[0 as usize]) as u64)
    p_dec(vec)
    p_str((&s_e[0 as usize]) as u64)
    p_hex(err, 8)
    p_str((&s_r[0 as usize]) as u64)
    p_hex(cr2, 16)
    p_nl()
    p_str((&s_ri[0 as usize]) as u64)
    p_hex(rip, 16)
    p_str((&s_cs[0 as usize]) as u64)
    p_hex(cs, 4)
    p_str((&s_fl[0 as usize]) as u64)
    p_hex(flg, 8)
    p_str((&s_sp[0 as usize]) as u64)
    p_hex(rsp, 16)
    p_str((&s_ss[0 as usize]) as u64)
    p_hex(ss, 4)
    p_nl()
    var i: u64 = 0
    while i < 16 {
        p_str((&names[0 as usize]) as u64 + i * 4)
        p_ch(61)
        p_hex(__mmio_read64((regs + i * 8) as *mut u64), 16)
        if i % 4 == 3 {
            p_nl()
        } else {
            p_ch(32)
        }
        i = i + 1
    }
}

fn trace(spurp: u64, spurn: u64) {
    var s_h: [u8; 14] = "-- backtrace\0\0"
    var s_k: [u8; 9] = "  (none)\0"
    var s_e: [u8; 5] = "  #\0\0"
    var s_s: [u8; 2] = " \0"
    p_str((&s_h[0 as usize]) as u64)
    p_nl()
    if spurn == 0 {
        p_str((&s_k[0 as usize]) as u64)
        p_nl()
        return
    }
    var i: u64 = 0
    while i < spurn {
        p_str((&s_e[0 as usize]) as u64)
        p_dec(i)
        p_str((&s_s[0 as usize]) as u64)
        p_addr(__mmio_read64((spurp + i * 8) as *mut u64))
        p_nl()
        i = i + 1
    }
}

fn protokoll(state: u64, n: u64) {
    var s_h: [u8; 9] = "-- log\0\0\0"
    var s_ab: [u8; 18] = "  ... (truncated)\0"
    p_str((&s_h[0 as usize]) as u64)
    p_nl()
    let last: u64 = klog.seq(state)
    if last == 0 {
        return
    }
    var from: u64 = 1
    if last > n {
        from = last - n + 1
    }
    if from < klog.first_seq(state) {
        from = klog.first_seq(state)
    }
    var s: u64 = from
    while s <= last {
        if buf_n + 256 >= BUF_MAX {
            p_str((&s_ab[0 as usize]) as u64)
            p_nl()
            return
        }
        let n2: u64 = klog.line_at(state, s,
            (&buf[0 as usize]) as u64 + buf_n, BUF_MAX - 1 - buf_n)
        buf_n = buf_n + n2
        s = s + 1
    }
}

fn filename(state: u64) -> u64 {
    var pre: [u8; 12] = "/var/crash/\0"
    var suf: [u8; 5] = ".txt\0"
    var hsuf: [u8; 10] = "-hang.txt\0"
    let p: u64 = (&name_buf[0 as usize]) as u64
    var n: u64 = 0
    var i: u64 = 0
    while kstate.get8((&pre[0 as usize]) as u64 + i) != 0 {
        kstate.set8(p + n, kstate.get8((&pre[0 as usize]) as u64 + i) as u8)
        n = n + 1
        i = i + 1
    }
    var t: [u8; 24] = [0 as u8; 24]
    var m: u64 = 0
    var x: u64 = time.now_sec(state)
    if x == 0 {
        t[0 as usize] = 48 as u8
        m = 1
    }
    while x > 0 {
        t[m as usize] = (48 + (x % 10)) as u8
        x = x / 10
        m = m + 1
    }
    while m > 0 {
        kstate.set8(p + n, t[(m - 1) as usize])
        n = n + 1
        m = m - 1
    }
    i = 0
    var sp: u64 = (&suf[0 as usize]) as u64
    if file_kind != KIND_PANIC {
        sp = (&hsuf[0 as usize]) as u64
    }
    while kstate.get8(sp + i) != 0 {
        kstate.set8(p + n, kstate.get8(sp + i) as u8)
        n = n + 1
        i = i + 1
    }
    kstate.set8(p + n, 0 as u8)
    return p
}

fn report(state: u64, ok: bool, n: u64) {
    var s_j: [u8; 17] = "crash: report  \0\0"
    var s_ok: [u8; 11] = "  written \0"
    var s_no: [u8; 25] = "crash: report NOT stored\0"
    var s_ok2: [u8; 9] = "  bytes\0\0"
    if ok {
        serial.puts((&s_j[0 as usize]) as u64)
        serial.puts(last_file())
        serial.puts((&s_ok[0 as usize]) as u64)
        serial.dec(n)
        serial.puts((&s_ok2[0 as usize]) as u64)
    } else {
        serial.puts((&s_no[0 as usize]) as u64)
    }
    serial.nl()
}

static mut pc_name: [u8; 40] = [0 as u8; 40]
static mut pc_extra: [u8; 128] = [0 as u8; 128]

fn pc_build(n: u64) -> u64 {
    var pre: [u8; 19] = "/var/jarvis/panic-\0"
    var suf: [u8; 5] = ".txt\0"
    let p: u64 = (&pc_name[0 as usize]) as u64
    var k: u64 = 0
    var i: u64 = 0
    while kstate.get8((&pre[0 as usize]) as u64 + i) != 0 {
        kstate.set8(p + k, kstate.get8((&pre[0 as usize]) as u64 + i) as u8)
        k = k + 1
        i = i + 1
    }
    if n >= 10 {
        kstate.set8(p + k, (48 + n / 10) as u8)
        k = k + 1
    }
    kstate.set8(p + k, (48 + n % 10) as u8)
    k = k + 1
    i = 0
    while kstate.get8((&suf[0 as usize]) as u64 + i) != 0 {
        kstate.set8(p + k, kstate.get8((&suf[0 as usize]) as u64 + i) as u8)
        k = k + 1
        i = i + 1
    }
    kstate.set8(p + k, 0 as u8)
    return p
}

fn panic_copy(state: u64) {
    var d1: [u8; 5] = "/var\0"
    var d2: [u8; 12] = "/var/jarvis\0"
    if fs.path(state, (&d1[0 as usize]) as u64) == 0 {
        if fs.create_path(state, (&d1[0 as usize]) as u64, fs.T_DIR) == 0 {
            return
        }
    }
    if fs.path(state, (&d2[0 as usize]) as u64) == 0 {
        if fs.create_path(state, (&d2[0 as usize]) as u64, fs.T_DIR) == 0 {
            return
        }
    }
    var n: u64 = 1
    while n < 32 && fs.path(state, pc_build(n)) != 0 {
        n = n + 1
    }
    let name: u64 = pc_build(n)
    var ino: u64 = fs.path(state, name)
    if ino == 0 {
        ino = fs.create_path(state, name, fs.T_FILE)
    }
    if ino == 0 {
        return
    }
    let w: u64 = fs.write_at(state, ino, 0, (&buf[0 as usize]) as u64, buf_n)
    let x: u64 = safe.panic_extra((&pc_extra[0 as usize]) as u64)
    let w2: u64 = fs.write_at(state, ino, w, (&pc_extra[0 as usize]) as u64, x)
    let _z: bool = fs.set_size(state, ino, w + w2)
}

fn ablegen(state: u64) -> bool {
    var dir: [u8; 12] = "/var/crash\0\0"
    var var_: [u8; 5] = "/var\0"
    var m: [u8; 16] = "/var/crash/NEW\0\0"
    ver = ver + 1
    if !fs.ready(state) {
        failed = failed + 1
        report(state, false, 0)
        return false
    }
    if fs.path(state, (&var_[0 as usize]) as u64) == 0 {
        if fs.create_path(state, (&var_[0 as usize]) as u64, fs.T_DIR) == 0 {
            failed = failed + 1
            return false
        }
    }
    if fs.path(state, (&dir[0 as usize]) as u64) == 0 {
        if fs.create_path(state, (&dir[0 as usize]) as u64, fs.T_DIR) == 0 {
            failed = failed + 1
            return false
        }
    }
    let name: u64 = filename(state)
    var ino: u64 = fs.path(state, name)
    if ino == 0 {
        ino = fs.create_path(state, name, fs.T_FILE)
    }
    if ino == 0 {
        failed = failed + 1
        report(state, false, 0)
        return false
    }
    let n: u64 = fs.write_at(state, ino, 0, (&buf[0 as usize]) as u64, buf_n)
    if n != buf_n {
        failed = failed + 1
        report(state, false, n)
        return false
    }
    panic_copy(state)
    let before: u64 = blk.dev_flushes()
    if !blk.flush(state) {
        failed = failed + 1
        report(state, false, 0)
        return false
    }
    var s_fl: [u8; 32] = "crash: report flushed, device +\0"
    serial.puts((&s_fl[0 as usize]) as u64)
    serial.dec(blk.dev_flushes() - before)
    serial.nl()
    if fs.path(state, (&m[0 as usize]) as u64) == 0 {
        let _mi: u64 = fs.create_path(state, (&m[0 as usize]) as u64,
            fs.T_FILE)
    }
    open_flag = 1
    ge = ge + 1
    report(state, true, buf_n)
    return true
}

fn prog_report(state: u64, regs: u64, rip: u64, cs: u64, flg: u64,
        rsp: u64, ss: u64, err: u64, cr2: u64, vec: u64, pid: u64,
        name: u64, spurp: u64, spurn: u64) -> bool {
    var s_src: [u8; 6] = "crash\0"
    var s_msg: [u8; 20] = "program died, pid \0\0"
    header(state, A_PROG, cpu.here(state), pid, name)
    register(regs, rip, cs, flg, rsp, ss, err, cr2, vec)
    trace(spurp, spurn)
    protokoll(state, 50)
    klog.sayn(state, klog.L_ERROR, (&s_src[0 as usize]) as u64,
        (&s_msg[0 as usize]) as u64, pid)
    return ablegen(state)
}

const RAM_BASE: u64 = 0x96000
const RAM_HDR: u64 = 32
const RAM_MAGIC: u64 = 0x314B494E4150534F
const RAM_FNV_OFF: u64 = 0xCBF29CE484222325
const RAM_FNV_PRIME: u64 = 0x100000001B3

fn ram_sum(p: u64, n: u64) -> u64 {
    var h: u64 = RAM_FNV_OFF
    var i: u64 = 0
    while i < n {
        h = (h ^ kstate.get8(p + i)) *% RAM_FNV_PRIME
        i = i + 1
    }
    return h
}

const BANDS: u64 = 3
const BAND_LEN: u64 = 0x3000
const BEAT_OFF: u64 = 0x2FC0
const BEAT_MAGIC: u64 = 0x31544145425A534F

fn band(i: u64) -> u64 {
    if i == 0 {
        return RAM_BASE
    }
    return mmboot.crash_band(i - 1)
}

fn band_write(b: u64) {
    __mmio_write64(b as *mut u64, 0)
    var i: u64 = 0
    while i < buf_n {
        kstate.set8(b + RAM_HDR + i, buf[i as usize])
        i = i + 1
    }
    __mmio_write64((b + 8) as *mut u64, buf_n)
    __mmio_write64((b + 16) as *mut u64, ram_sum(b + RAM_HDR, buf_n))
    __mmio_write64((b + 24) as *mut u64, ram_kind)
    __mmio_write64(b as *mut u64, RAM_MAGIC)
}

fn ram_save() {
    var i: u64 = 0
    while i < BANDS {
        let b: u64 = band(i)
        if b != 0 {
            band_write(b)
        }
        i = i + 1
    }
}

static mut root_fluechtig: u64 = 0

fn set_volatile() {
    root_fluechtig = 1
}

fn ram_clear() {
    var i: u64 = 0
    while i < BANDS {
        let b: u64 = band(i)
        if b != 0 {
            __mmio_write64(b as *mut u64, 0)
        }
        i = i + 1
    }
}

fn band_state(b: u64) -> u64 {
    if __mmio_read64(b as *mut u64) != RAM_MAGIC {
        return 0
    }
    let n: u64 = __mmio_read64((b + 8) as *mut u64)
    if n == 0 || n > BUF_MAX {
        return 2
    }
    if ram_sum(b + RAM_HDR, n) != __mmio_read64((b + 16) as *mut u64) {
        return 2
    }
    return 1
}

fn beats(state: u64) {
    var s_src: [u8; 6] = "crash\0"
    var s_b: [u8; 9] = "band on \0"
    var s_h: [u8; 24] = "  heartbeat (0 = lost) \0"
    var s_r: [u8; 36] = "  report (0 empty, 1 ok, 2 broken) \0"
    var i: u64 = 0
    while i < BANDS {
        let b: u64 = band(i)
        klog.sayh(state, klog.L_INFO, (&s_src[0]) as u64, (&s_b[0]) as u64, b)
        if b != 0 {
            var n: u64 = 0
            if __mmio_read64((b + BEAT_OFF) as *mut u64) == BEAT_MAGIC {
                n = __mmio_read64((b + BEAT_OFF + 8) as *mut u64)
            }
            klog.sayn(state, klog.L_INFO, (&s_src[0]) as u64, (&s_h[0]) as u64, n)
            klog.sayn(state, klog.L_INFO, (&s_src[0]) as u64, (&s_r[0]) as u64,
                band_state(b))
            __mmio_write64((b + BEAT_OFF + 8) as *mut u64, n + 1)
            __mmio_write64((b + BEAT_OFF) as *mut u64, BEAT_MAGIC)
        }
        i = i + 1
    }
}

fn ram_retten(state: u64) -> u64 {
    var s_ok: [u8; 36] = "crash: report rescued from memory\0\0\0"
    var s_bad: [u8; 44] = "crash: memory report discarded (checksum)\0\0\0"
    beats(state)
    var found: u64 = 0
    var broken: u64 = 0
    var i: u64 = 0
    while i < BANDS && found == 0 {
        let b: u64 = band(i)
        if b != 0 {
            let st: u64 = band_state(b)
            if st == 1 {
                found = b
            }
            if st == 2 {
                broken = broken + 1
            }
        }
        i = i + 1
    }
    if found == 0 {
        if broken != 0 {
            serial.puts((&s_bad[0 as usize]) as u64)
            serial.nl()
            ram_clear()
        }
        return 0
    }
    let n: u64 = __mmio_read64((found + 8) as *mut u64)
    rescued_n = 1
    file_kind = __mmio_read64((found + 24) as *mut u64)
    if file_kind > KIND_SOFT {
        file_kind = KIND_PANIC
    }
    i = 0
    while i < n {
        buf[i as usize] = kstate.get8(found + RAM_HDR + i) as u8
        i = i + 1
    }
    buf_n = n
    serial.puts((&s_ok[0 as usize]) as u64)
    serial.nl()
    let ok: bool = ablegen(state)
    file_kind = KIND_PANIC
    if ok {
        ram_clear()
        return 1
    }
    return 0
}

fn hang_begin(state: u64, kind: u64) {
    var s_h: [u8; 25] = "=== OSUM HANG REPORT ===\0"
    var s_f: [u8; 10] = "version: \0"
    var s_z: [u8; 7] = "time: \0"
    buf_n = 0
    ram_kind = kind
    p_str((&s_h[0]) as u64)
    p_nl()
    p_str((&s_f[0]) as u64)
    p_str(version.text())
    p_nl()
    p_str((&s_z[0]) as u64)
    p_dec(time.now_sec(state))
    p_nl()
}

fn hang_store(state: u64) -> u64 {
    protokoll(state, 30)
    ram_save()
    ram_kind = KIND_PANIC
    return buf_n
}

fn hang_file(state: u64) -> bool {
    file_kind = KIND_HANG
    let ok: bool = ablegen(state)
    file_kind = KIND_PANIC
    return ok
}

fn hang_forget() {
    var i: u64 = 0
    while i < BANDS {
        let b: u64 = band(i)
        if b != 0 && band_state(b) == 1 && __mmio_read64((b + 24) as *mut u64) == KIND_SOFT {
            __mmio_write64(b as *mut u64, 0)
        }
        i = i + 1
    }
}

fn kernel_report(state: u64, regs: u64, rip: u64, cs: u64, flg: u64,
        rsp: u64, ss: u64, err: u64, cr2: u64, vec: u64,
        spurp: u64, spurn: u64) -> bool {
    header(state, A_KERN, cpu.here(state), 0, 0)
    register(regs, rip, cs, flg, rsp, ss, err, cr2, vec)
    trace(spurp, spurn)
    protokoll(state, 50)
    ram_save()
    if !fs.free(state) {
        var s_no: [u8; 39] = "crash: filesystem locked, no report\0\0\0\0"
        serial.puts((&s_no[0 as usize]) as u64)
        serial.nl()
        failed = failed + 1
        return false
    }
    if ablegen(state) {
        if root_fluechtig == 0 {
            ram_clear()
        }
        return true
    }
    return false
}

const STALE_WORD: u64 = 0x101000

fn knall(state: u64, art: u64) {
    var stale: [u64; 2] = [0 as u64; 2]
    __mmio_write64((&stale[0 as usize]) as u64 as *mut u64, STALE_WORD)
    var s_src: [u8; 6] = "crash\0"
    var s_msg: [u8; 31] = "forced crash on request, kind \0"
    klog.sayn(state, klog.L_ERROR, (&s_src[0 as usize]) as u64,
        (&s_msg[0 as usize]) as u64, art)
    if art == 2 {
        let _f: u64 = fs.enter(state)
        knall_a(0)
        return
    }
    if art == 3 {
        doppel = 1
        knall_a(0)
        return
    }
    knall_a(art)
}

static mut doppel: u64 = 0

fn doppel_check() {
    if doppel == 0 {
        return
    }
    doppel = 0
    let _v: u64 = __mmio_read64(0x700000000008 as *mut u64)
}

fn knall_a(art: u64) {
    knall_b(art)
}

fn knall_b(art: u64) {
    knall_c(art)
}

fn knall_c(art: u64) {
    if art == 1 {
        asm("ud2")
        return
    }
    let _v: u64 = __mmio_read64(0x700000000000 as *mut u64)
}
