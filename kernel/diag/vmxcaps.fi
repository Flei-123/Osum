// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import lib.kstate
import lib.procw
import arch.msr

export { render }

const MSR_FEATURE_CONTROL: u64 = 0x3A
const MSR_VMX_BASIC: u64 = 0x480
const MSR_VMX_PINBASED: u64 = 0x481
const MSR_VMX_PROCBASED: u64 = 0x482
const MSR_VMX_EXIT: u64 = 0x483
const MSR_VMX_ENTRY: u64 = 0x484
const MSR_VMX_MISC: u64 = 0x485
const MSR_VMX_CR0_FIXED0: u64 = 0x486
const MSR_VMX_CR4_FIXED0: u64 = 0x488
const MSR_VMX_PROCBASED2: u64 = 0x48B
const MSR_VMX_EPT_VPID: u64 = 0x48C
const MSR_VMX_TRUE_PINBASED: u64 = 0x48D
const MSR_VMX_TRUE_PROCBASED: u64 = 0x48E
const MSR_VMX_TRUE_EXIT: u64 = 0x48F
const MSR_VMX_TRUE_ENTRY: u64 = 0x490
const MSR_VMX_VMFUNC: u64 = 0x491

static mut s_eax_: [u8; 6] = " eax=\0"
static mut s_ebx_: [u8; 6] = " ebx=\0"
static mut s_ecx_: [u8; 6] = " ecx=\0"
static mut s_edx_: [u8; 6] = " edx=\0"
static mut s_sp: [u8; 2] = " \0"
static mut s_gp: [u8; 3] = "gp\0"
static mut s_cpuid_0: [u8; 8] = "cpuid.0\0"
static mut s_cpuid_1: [u8; 8] = "cpuid.1\0"
static mut s_cpuid_7: [u8; 8] = "cpuid.7\0"
static mut s_cpuid_80000001: [u8; 15] = "cpuid.80000001\0"
static mut s_cpuid_8000000a: [u8; 15] = "cpuid.8000000a\0"
static mut s_msr: [u8; 4] = "msr\0"

fn cpuid_a(leaf: u64, sub: u64) -> u64 {
    return asm("push rbx\nmov eax, edi\nmov ecx, esi\ncpuid\npop rbx",
        in("rdi") leaf, in("rsi") sub, out("rax"),
        clobber("rcx"), clobber("rdx"))
}

fn cpuid_b(leaf: u64, sub: u64) -> u64 {
    return asm("push rbx\nmov eax, edi\nmov ecx, esi\ncpuid\nmov eax, ebx\npop rbx",
        in("rdi") leaf, in("rsi") sub, out("rax"),
        clobber("rcx"), clobber("rdx"))
}

fn cpuid_c(leaf: u64, sub: u64) -> u64 {
    return asm("push rbx\nmov eax, edi\nmov ecx, esi\ncpuid\nmov eax, ecx\npop rbx",
        in("rdi") leaf, in("rsi") sub, out("rax"),
        clobber("rdx"))
}

fn cpuid_d(leaf: u64, sub: u64) -> u64 {
    return asm("push rbx\nmov eax, edi\nmov ecx, esi\ncpuid\nmov eax, edx\npop rbx",
        in("rdi") leaf, in("rsi") sub, out("rax"),
        clobber("rcx"))
}

fn line_cpuid(name: u64, leaf: u64, sub: u64) {
    procw.put_s(name)
    procw.put_s((&s_eax_[0]) as u64)
    procw.put_hex(cpuid_a(leaf, sub) & 0xFFFFFFFF, 8)
    procw.put_s((&s_ebx_[0]) as u64)
    procw.put_hex(cpuid_b(leaf, sub) & 0xFFFFFFFF, 8)
    procw.put_s((&s_ecx_[0]) as u64)
    procw.put_hex(cpuid_c(leaf, sub) & 0xFFFFFFFF, 8)
    procw.put_s((&s_edx_[0]) as u64)
    procw.put_hex(cpuid_d(leaf, sub) & 0xFFFFFFFF, 8)
    procw.put_c(10)
}

fn line_msr(state: u64, name: u64, index: u64) {
    var v: u64 = 0
    procw.put_s(name)
    procw.put_s((&s_sp[0]) as u64)
    procw.put_hex(index, 3)
    procw.put_c(32)
    if msr.rd(state, index, (&v) as u64) {
        procw.put_hex(v, 16)
    } else {
        procw.put_s((&s_gp[0]) as u64)
    }
    procw.put_c(10)
}

fn render(state: u64, out: u64, cap: u64) -> u64 {
    procw.begin(out, cap)
    line_cpuid((&s_cpuid_0[0]) as u64, 0, 0)
    line_cpuid((&s_cpuid_1[0]) as u64, 1, 0)
    line_cpuid((&s_cpuid_7[0]) as u64, 7, 0)
    line_cpuid((&s_cpuid_80000001[0]) as u64, 0x80000001, 0)
    line_cpuid((&s_cpuid_8000000a[0]) as u64, 0x8000000A, 0)
    line_msr(state, (&s_msr[0]) as u64, MSR_FEATURE_CONTROL)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_BASIC)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_PINBASED)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_PROCBASED)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_EXIT)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_ENTRY)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_MISC)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_CR0_FIXED0)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_CR0_FIXED0 + 1)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_CR4_FIXED0)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_CR4_FIXED0 + 1)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_PROCBASED2)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_EPT_VPID)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_TRUE_PINBASED)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_TRUE_PROCBASED)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_TRUE_EXIT)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_TRUE_ENTRY)
    line_msr(state, (&s_msr[0]) as u64, MSR_VMX_VMFUNC)
    return procw.used()
}
