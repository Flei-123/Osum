profile kernel

import lib.kstate
import diag.hw

export { has, number, selftest }

const SPACE: u64 = 32
const EQUALS: u64 = 61
const DIGIT_0: u64 = 48
const DIGIT_9: u64 = 57
const DECIMAL: u64 = 10

fn length(s: u64) -> u64 {
    var n: u64 = 0
    while kstate.get8(s + n) != 0 {
        n = n + 1
    }
    return n
}

fn matches_at(at: u64, word: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get8(at + i) != kstate.get8(word + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn word_start(cmd: u64, at: u64) -> bool {
    return at == cmd || kstate.get8(at - 1) == SPACE
}

fn word_end(after: u64) -> bool {
    let c: u64 = kstate.get8(after)
    return c == 0 || c == SPACE || c == EQUALS
}

fn locate(state: u64, word: u64) -> u64 {
    let cmd: u64 = hw.cmd_copy(state)
    if cmd == 0 {
        return 0
    }
    let n: u64 = length(word)
    if n == 0 {
        return 0
    }
    var at: u64 = cmd
    while kstate.get8(at) != 0 {
        if matches_at(at, word, n) && word_start(cmd, at) && word_end(at + n) {
            return at + n
        }
        at = at + 1
    }
    return 0
}

fn has(state: u64, word: u64) -> bool {
    return locate(state, word) != 0
}

fn number(state: u64, word: u64, fallback: u64) -> u64 {
    let p: u64 = locate(state, word)
    if p == 0 || kstate.get8(p) != EQUALS {
        return fallback
    }
    var v: u64 = 0
    var i: u64 = p + 1
    var c: u64 = kstate.get8(i)
    if c < DIGIT_0 || c > DIGIT_9 {
        return fallback
    }
    while c >= DIGIT_0 && c <= DIGIT_9 {
        v = v * DECIMAL + (c - DIGIT_0)
        i = i + 1
        c = kstate.get8(i)
    }
    return v
}

fn selftest(state: u64) -> bool {
    var w_here: [u8; 7] = "evself\0"
    var w_none: [u8; 8] = "zzqqxx9\0"
    var w_part: [u8; 3] = "ev\0"
    if !has(state, (&w_here[0]) as u64) {
        return false
    }
    if has(state, (&w_none[0]) as u64) {
        return false
    }
    if has(state, (&w_part[0]) as u64) {
        return false
    }
    return number(state, (&w_here[0]) as u64, 5) == 5
}
