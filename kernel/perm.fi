// SPDX-License-Identifier: GPL-2.0-only
// kernel/perm.fi -- Runde K13: WER DARF WAS, an genau EINER Stelle.
//
// Bis zu dieser Runde hatte Osum keine Benutzer. Jeder Prozess durfte
// jede Datei lesen und jede Datei ueberschreiben; `open` fragte, ob es
// den Namen gibt, und wenn ja, war die Antwort ja. Das ist die Bauart
// eines Kernels, der noch keine zwei Menschen kennt.
//
// DIESE DATEI IST DIE EINZIGE STELLE, AN DER "DARF ER?" BEANTWORTET
// WIRD, und das ist die Auflage dieser Runde, nicht ihr Schmuck. Ein
// System mit fuenf Rechtepruefungen an fuenf Stellen hat vier Stellen,
// an denen jemand einen Fall vergessen hat -- und Rechte sind genau die
// Sorte Code, bei der ein vergessener Fall nicht auffaellt, weil das
// System dann MEHR tut als es soll und nicht weniger. Also: `may` unten
// ist die Funktion, `sys.fi` ruft sie im Oeffnen-Pfad, in `mkdir`, in
// `unlink`, in `chdir` und in `execve` auf, und es gibt keine zweite
// Fassung dieser sechzehn Zeilen irgendwo sonst im Baum. Wer eine
// schreiben will, findet hier den Grund, es nicht zu tun.
//
// DIE REGEL SELBST ist die von Unix, und sie ist absichtlich nicht
// klueger als die:
//
//   1. Ist die wirksame Benutzerkennung 0, gilt: lesen und schreiben ja,
//      immer. AUSFUEHREN nur, wenn IRGENDEIN Ausfuehrungsbit gesetzt ist
//      -- root darf keine Textdatei starten, und das ist kein Detail,
//      sondern der Unterschied zwischen "root darf alles" und "root darf
//      Unsinn".
//   2. Sonst entscheidet GENAU EINE der drei Dreiergruppen: Besitzer,
//      wenn die Kennungen gleich sind; sonst Gruppe, wenn die Gruppen
//      gleich sind; sonst der Rest. Nicht die Vereinigung -- eine Datei
//      0o077 ist fuer ihren Besitzer wirklich verschlossen, und wer die
//      Gruppen ODER-verknuepft, hat Unix falsch abgeschrieben.
//   3. Gefragt wird mit der WIRKSAMEN Kennung (T_EUID), nicht mit der
//      echten. Das ist der ganze Sinn des setuid-Bits.
//
// GEZAEHLT WIRD JEDE FRAGE. `U_CHECKS` und `U_DENIED` in `kdata` sind
// die beiden Zahlen, an denen `tools/k13/run.sh` festmacht, dass hier
// ueberhaupt jemand gefragt hat -- eine Rechtepruefung, die niemand
// aufruft, ist von einer, die immer ja sagt, sonst nicht zu
// unterscheiden.
//
// DIE GEGENPROBE STEHT IN DIESER DATEI, in drei Zeilen: mit `noperm` auf
// der Kommandozeile sagt `may` immer ja -- gezaehlt wird trotzdem. Der
// Zugriff, der scheitern MUSS, gelingt dann, und der Testlaeufer haelt
// beide Laeufe gegeneinander. Ohne diese drei Zeilen misst die Runde nur
// sich selbst.

profile kernel

import kstate
import sched
import fs
import serial

export {
    may, may_real, may_ids, on_create, apply_exec, umask_of,
    euid, egid, uid_of, gid_of, is_root, may_signal,
    R_READ, R_WRITE, R_EXEC,
    checks, denied, report,
    // ------------------------------------------- RUNDE MULTIUSER
    // Die Regel auf drei ZAHLEN statt auf einer Inode -- damit sie
    // auch fuer ein Dateisystem gilt, das keine Inode von OFS hat.
    may_attr,
    // Das Betretungsrecht auf JEDEM Glied eines Pfades.
    walk, walk_stat, mu_report
}

// Was gefragt wird -- dieselben drei Bits, die in den Rechten stehen.
const R_EXEC: u64 = 1
const R_WRITE: u64 = 2
const R_READ: u64 = 4

// ------------------------------------------------------- die Kennungen

fn uid_of(state: u64, t: u64) -> u64 {
    return sched.tget(state, t, sched.T_UID)
}

fn gid_of(state: u64, t: u64) -> u64 {
    return sched.tget(state, t, sched.T_GID)
}

fn euid(state: u64, t: u64) -> u64 {
    return sched.tget(state, t, sched.T_EUID)
}

fn egid(state: u64, t: u64) -> u64 {
    return sched.tget(state, t, sched.T_EGID)
}

fn is_root(state: u64, t: u64) -> bool {
    return euid(state, t) == 0
}

fn umask_of(state: u64, t: u64) -> u64 {
    return sched.tget(state, t, sched.T_UMASK) & 4095
}

fn checks(state: u64) -> u64 {
    return kstate.get(state, kstate.K13_OFF + kstate.U_CHECKS)
}

fn denied(state: u64) -> u64 {
    return kstate.get(state, kstate.K13_OFF + kstate.U_DENIED)
}

// ------------------------------------------------------- DIE PRUEFUNG

// DIE EINE FRAGE, UND SIE STEHT GENAU EINMAL. `want` ist eine
// Oder-Verknuepfung aus R_READ, R_WRITE und R_EXEC; die Antwort gilt
// fuer ALLE gesetzten Bits zusammen.
//
// Die Kennungen kommen als Argument herein und werden nicht aus dem
// Prozess geholt, und das hat einen Grund: `access` fragt nach POSIX mit
// der ECHTEN Kennung und alles andere mit der WIRKSAMEN. Zwei
// Regelwerke waeren zwei Gelegenheiten, sich zu unterscheiden -- so ist
// es EIN Regelwerk mit zwei Eingaengen (`may` und `may_real` darunter).
// ============================================ RUNDE MULTIUSER
//
// DIE REGEL AUF DREI ZAHLEN. Bis zu dieser Runde stand sie auf einer
// INODE VON OFS -- `fs.inode_mode`, `fs.inode_uid`, `fs.inode_gid` --,
// und damit galt sie fuer genau ein Dateisystem. Ein Name auf einem
// FAT32-Stick, in /proc oder in /dev ging durch `open_vfs`, und dort
// wurde ueberhaupt nicht gefragt.
//
// Hier steht dieselbe Regel auf `mode`, `owner` und `group` als
// Zahlen. Wo sie herkommen, ist die Sache der Schicht darueber:
// `may_ids` holt sie aus der OFS-Inode, `sys.open_vfs` aus
// `vfs.v_attr`. Es bleibt EINE Regel; sie hat nur zwei Eingaenge mehr.
//
// UND DIE ZUSATZGRUPPEN. Die zweite Aenderung dieser Runde: `gid` war
// EINE Zahl, und ein Mensch ist in mehr als einer Gruppe. Gefragt wird
// jetzt die wirksame Gruppe UND die Liste aus `sched.groups_*`, und
// zwar in dieser Reihenfolge -- POSIX sagt: Besitzer, dann Gruppe
// (Haupt- oder Neben-), dann der Rest, und immer nur EINE der drei
// Dreiergruppen. Ein Treffer in einer NEBENgruppe wird gezaehlt
// (`MU_GRPHITS`), damit die Zusage "Zusatzgruppen wirken" eine Zahl
// hat und nicht nur einen Satz.
//
// `nogroups` auf der Kommandozeile ist die Gegenprobe: dann zaehlt nur
// die wirksame Gruppe, und die Datei, die nur ueber eine Nebengruppe
// zu haben war, bleibt zu.
fn in_group(state: u64, t: u64, group: u64, gid: u64) -> bool {
    if gid == group {
        return true
    }
    if kstate.mode_on(state, kstate.M_NOGROUPS) {
        return false
    }
    if sched.groups_has(state, t, group) {
        kstate.add(state, kstate.MU_OFF + kstate.MU_GRPHITS, 1)
        return true
    }
    return false
}

fn may_attr(state: u64, t: u64, mode: u64, owner: u64, group: u64,
    want: u64, id: u64, gid: u64, ist_dir: bool) -> bool {
    kstate.add(state, kstate.K13_OFF + kstate.U_CHECKS, 1)
    var okay: bool = true
    if id == 0 {
        // Regel 1: root liest und schreibt alles. Ausfuehren nur, wenn
        // die Datei ueberhaupt ausfuehrbar gemeint ist.
        //
        // RUNDE MULTIUSER: UND DAS GILT NICHT FUER VERZEICHNISSE. Das
        // x-Bit heisst bei einer Datei "starten" und bei einem
        // Verzeichnis "betreten" -- zwei verschiedene Dinge mit
        // demselben Bit. Linux macht denselben Unterschied
        // (CAP_DAC_OVERRIDE gibt root das Betreten IMMER, das Starten
        // nur, wenn irgendein x-Bit gesetzt ist), und der Grund ist
        // praktisch: ein Verzeichnis mit 0o700, das jemand anderem
        // gehoert, muss der Systemverwalter durchqueren koennen, sonst
        // kann er ein Heimverzeichnis nicht einmal sichern.
        //
        // GEMESSEN, NICHT UEBERLEGT: ohne diese Unterscheidung fiel
        // tools/k14/run.sh Abschnitt 9. Ueber die Ops-Tafel angelegte
        // Verzeichnisse bekamen den Modus 0 (siehe `sys.vfs_on_create`),
        // und root kam danach nicht mehr hinein -- "sh: cannot open
        // /neu/a.txt", waehrend derselbe Lauf auf dem geraden Weg
        // durchlief.
        if (want & R_EXEC) != 0 && !ist_dir {
            if (mode & 73) == 0 { // 0o111
                okay = false
            }
        }
    } else {
        var have: u64 = mode & 7
        if id == owner {
            have = (mode >> 6) & 7
        } else {
            if in_group(state, t, group, gid) {
                have = (mode >> 3) & 7
            }
        }
        if (want & have) != want {
            okay = false
        }
    }
    if okay {
        return true
    }
    kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
    if kstate.mode_on(state, kstate.M_NOPERM) {
        return true
    }
    return false
}

fn may_ids(state: u64, t: u64, ino: u64, want: u64, id: u64,
    gid: u64) -> bool {
    if ino == 0 {
        kstate.add(state, kstate.K13_OFF + kstate.U_CHECKS, 1)
        kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
        if kstate.mode_on(state, kstate.M_NOPERM) {
            return true
        }
        return false
    }
    let mode: u64 = fs.inode_mode(state, ino)
    let owner: u64 = fs.inode_uid(state, ino)
    let group: u64 = fs.inode_gid(state, ino)
    let ist_dir: bool = fs.inode_type(state, ino) == fs.T_DIR
    let okay: bool = may_attr(state, t, mode, owner, group, want, id, gid,
        ist_dir)
    if okay {
        return true
    }
    // Ab hier ist die Antwort NEIN. Gezaehlt hat `may_attr` schon --
    // und zwar BEVOR die Gegenprobe sie umbiegt. Genau darum ist
    // `noperm` eine Gegenprobe und keine Abkuerzung: die Zahl der
    // abgelehnten Zugriffe bleibt dieselbe, nur die Wirkung faellt weg,
    // und der Testlaeufer sieht beides. Hier steht nur noch, WELCHE
    // Inode es war -- die Zahl, die `may_attr` nicht kennen kann.
    kstate.set(state, kstate.K13_OFF + kstate.U_LASTDENY, (ino << 8) | want)
    return false
}

// Mit der WIRKSAMEN Kennung -- das ist der Normalfall und der Weg, den
// `open`, `mkdir`, `unlink`, `chdir` und `execve` nehmen.
fn may(state: u64, t: u64, ino: u64, want: u64) -> bool {
    return may_ids(state, t, ino, want, euid(state, t), egid(state, t))
}

// Mit der ECHTEN Kennung. Genau ein Aufrufer: `access`. POSIX will es so,
// damit ein setuid-Programm fragen kann, ob DER MENSCH davor die Datei
// haette lesen duerfen -- nicht, ob es selbst es darf.
fn may_real(state: u64, t: u64, ino: u64, want: u64) -> bool {
    return may_ids(state, t, ino, want, uid_of(state, t), gid_of(state, t))
}

// Darf dieser Prozess jenem ein Signal schicken? Die Regel von POSIX:
// root darf jedem, sonst muss eine der beiden Kennungen passen. Steht
// hier und nicht in `signal.fi`, weil es dieselbe Frage ist und weil es
// sonst eine zweite Stelle waere.
fn may_signal(state: u64, from: u64, to: u64) -> bool {
    kstate.add(state, kstate.K13_OFF + kstate.U_CHECKS, 1)
    if is_root(state, from) {
        return true
    }
    let a: u64 = euid(state, from)
    if a == uid_of(state, to) || a == euid(state, to) {
        return true
    }
    kstate.add(state, kstate.K13_OFF + kstate.U_DENIED, 1)
    if kstate.mode_on(state, kstate.M_NOPERM) {
        return true
    }
    return false
}

// ========================= RUNDE MULTIUSER: DAS BETRETUNGSRECHT
//
// DIE LUECKE, DIE K13 BENANNT UND NICHT GESCHLOSSEN HAT. Sie steht seit
// damals als Kommentar in `sys.do_open`:
//
//     "WAS HIER NICHT GEPRUEFT WIRD [...]: das Betretungsrecht auf
//      JEDEM Glied eines langen Pfades. Geprueft wird das letzte
//      Verzeichnis und das Ziel. Der Grund ist der Modulgraph --
//      `fs.path` loest den Pfad auf und kennt keine Aufgabe, und
//      `fs.fi` darf `perm.fi` nicht einbinden, weil `perm.fi` `fs.fi`
//      einbindet. Das ist eine echte Luecke und keine Vereinfachung."
//
// WAS DIE LUECKE WERT WAR, in einem Satz: ein Verzeichnis `0o700
// root:root` hat seinen Inhalt nicht geschuetzt. Wer den Namen der
// Datei darin kannte, hat sie geoeffnet -- gefragt wurde nur nach den
// Rechten der DATEI, und die konnte 0o644 sein. Auf einem
// Serverbetriebssystem ist das kein Schoenheitsfehler: /home/jemand mit
// 0o700 ist die uebliche und oft einzige Art, ein Heimverzeichnis
// abzuschliessen.
//
// DER MODULGRAPH IST NICHT DAS HINDERNIS, das er 1013 Tage lang schien.
// Die Pruefung muss nicht IN `fs.resolve` stehen. Sie steht hier -- in
// dem Modul, das `fs` ohnehin einbindet und das die Aufgabe kennt --
// und laeuft den Pfad EIN ZWEITES MAL ab, bevor der Aufrufer ihn
// aufloest. Das kostet einen zweiten Durchgang je Bestandteil und ist
// der Preis dafuer, `fs.fi` nicht anzufassen.
//
// WIE DER PFAD ZERLEGT WIRD, ohne einen Puffer: die Zeichenkette wird
// an jedem Schraegstrich VORUEBERGEHEND abgeschnitten (eine Null
// hineingeschrieben), `fs.path` darauf losgelassen und das Zeichen
// danach zurueckgeschrieben. `fs.resolve` kopiert den Pfad in seinen
// eigenen Arbeitspuffer, also sieht niemand die Null ausser dieser
// Schleife. Ein zweiter Puffer in `kdata` waere eine zweite Stelle,
// deren Groesse jemand vergisst.
//
// WAS GEPRUEFT WIRD: `R_EXEC` auf jedes VERZEICHNIS auf dem Weg,
// einschliesslich der Wurzel. Das ist die Regel von Unix, und das
// x-Bit eines Verzeichnisses heisst dort genau das: betreten duerfen.
// Das LETZTE Glied -- die Datei selbst -- wird hier NICHT geprueft;
// dafuer ist der Aufrufer da, und er tut es seit K13.
//
// WAS NICHT GEPRUEFT WIRD, und es steht auch unten in der Lueckenliste:
// ein Pfad, der ueber einen symbolischen Verweis in ein anderes
// Verzeichnis springt, wird an den Gliedern des GESCHRIEBENEN Pfades
// geprueft und nicht an denen des aufgeloesten. `fs.resolve` baut den
// Pfad beim Verfolgen eines Verweises neu, und diese Schleife sieht das
// Ergebnis nicht.
//
// `nowalk` auf der Kommandozeile ist die Gegenprobe: gezaehlt wird
// weiter, gewirkt wird nicht -- also genau der Zustand vor dieser
// Runde.
fn walk(state: u64, t: u64, path: u64) -> bool {
    kstate.add(state, kstate.MU_OFF + kstate.MU_WALKS, 1)
    var i: u64 = 0
    var erlaubt: bool = true
    var weiter: bool = true
    while weiter {
        let c: u64 = kstate.get8(path + i)
        if c == 0 {
            weiter = false
        } else {
            if c == 47 { // '/'
                // Zwei Schraegstriche hintereinander ("//") und der am
                // Ende ("/a/") ergeben denselben Praefix wie der davor;
                // sie werden uebersprungen, sonst zaehlt derselbe
                // Zugriff zweimal.
                let vor: u64 = kstate.get8(path + i + 1)
                if i == 0 || (vor != 47 && vor != 0) {
                    kstate.set8(path + i, 0 as u8)
                    let ino: u64 = fs.path(state, path)
                    kstate.set8(path + i, 47 as u8)
                    if ino == 0 {
                        // Den Teilpfad gibt es nicht. Dann gibt es den
                        // ganzen auch nicht, und der Aufrufer sagt
                        // gleich -ENOENT -- hier waere -EACCES die
                        // falsche Auskunft.
                        weiter = false
                    } else {
                        if fs.inode_type(state, ino) != fs.T_DIR {
                            weiter = false
                        } else {
                            if !may(state, t, ino, R_EXEC) {
                                erlaubt = false
                                weiter = false
                            }
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    if erlaubt {
        return true
    }
    kstate.add(state, kstate.MU_OFF + kstate.MU_WALKDENY, 1)
    if kstate.mode_on(state, kstate.M_NOWALK) {
        return true
    }
    if kstate.mode_on(state, kstate.M_NOPERM) {
        return true
    }
    return false
}

fn walk_stat(state: u64, was: u64) -> u64 {
    return kstate.get(state, kstate.MU_OFF + was)
}

// Die Zahlen dieser Runde, eine Zeile. Sie steht neben `report` aus
// K13 und aus demselben Grund: mit `init` kehrt `kmain` nie zurueck,
// also muss auch `sys.do_reboot` sie schreiben koennen.
fn mu_report(state: u64) {
    var s_h: [u8; 12] = "mu: walks=\0\0"
    var s_d: [u8; 12] = " walkdeny=\0\0"
    var s_g: [u8; 11] = " grphits=\0\0"
    var s_s: [u8; 11] = " suppset=\0\0"
    var s_n: [u8; 11] = " nodechk=\0\0"
    let b: u64 = kstate.MU_OFF
    serial.puts((&s_h[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.MU_WALKS))
    serial.puts((&s_d[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.MU_WALKDENY))
    serial.puts((&s_g[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.MU_GRPHITS))
    serial.puts((&s_s[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.MU_SUPPSET))
    serial.puts((&s_n[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.MU_NODECHK))
    serial.nl()
}

// ------------------------------------------------- eine NEUE Datei

// Was eine gerade entstandene Datei traegt. Der Inode kommt genullt aus
// `fs.inode_alloc` -- ohne diese Zeilen haette jede neue Datei die
// Rechte 0 und gehoerte root, und ein Benutzer koennte anlegen, was er
// danach selbst nicht mehr lesen darf.
//
// `mode` ist, was der Aufrufer wollte (0o666 bei `open`, 0o777 bei
// `mkdir`), die Maske des Prozesses wird abgezogen, und Besitzer und
// Gruppe sind die WIRKSAMEN Kennungen des Erzeugers.
fn on_create(state: u64, t: u64, ino: u64, mode: u64) -> bool {
    let m: u64 = mode & (~umask_of(state, t)) & 4095
    return fs.set_meta(state, ino, m, euid(state, t), egid(state, t))
}

// ------------------------------------------------- das setuid-Bit

// Ein Programm, dessen Datei das setuid-Bit traegt, laeuft mit der
// Kennung des BESITZERS der Datei und nicht mit der des Aufrufers. Das
// ist der einzige Weg, auf dem ein gewoehnlicher Benutzer etwas tun
// kann, was nur root darf -- `passwd` schreibt in /etc/shadow, und
// /etc/shadow darf sonst niemand anfassen.
//
// Es wird auf die AUFGABE angewandt, die der Lader gerade gebaut hat.
// `execve` tauscht danach die Adressraeume und traegt die Kennungen von
// dort in den Aufrufer ein; `spawn` startet die Aufgabe unmittelbar.
// Beide Wege gehen durch `elf.build`, und darum steht der Aufruf dort.
//
// DIE GESICHERTE KENNUNG WIRD MITGESETZT. Ohne sie koennte ein
// setuid-Programm seine Rechte ablegen und nie zurueckholen; mit ihr ist
// `setuid(0)` nach `setuid(getuid())` erlaubt, solange die gesicherte
// Kennung 0 ist. Das ist genau die Zusage, auf der `su` steht.
//
// `nosuid` schaltet es ab -- die Gegenprobe: `passwd` scheitert dann
// beim Schreiben, und zwar mit -EACCES und nicht mit einem stillen
// Nichts.
fn apply_exec(state: u64, t: u64, ino: u64) {
    if kstate.mode_on(state, kstate.M_NOSUID) {
        return
    }
    let mode: u64 = fs.inode_mode(state, ino)
    if (mode & fs.S_ISUID) != 0 {
        let owner: u64 = fs.inode_uid(state, ino)
        sched.tset(state, t, sched.T_EUID, owner)
        sched.tset(state, t, sched.T_SUID, owner)
        kstate.add(state, kstate.K13_OFF + kstate.U_SUIDEXEC, 1)
    }
    if (mode & fs.S_ISGID) != 0 {
        let group: u64 = fs.inode_gid(state, ino)
        sched.tset(state, t, sched.T_EGID, group)
        sched.tset(state, t, sched.T_SGID, group)
    }
}

// ------------------------------------------------------- der Bericht
//
// Acht Zahlen, eine Zeile. Sie steht HIER und nicht in `kmain.fi`, und
// der Grund ist eine gemessene Enttaeuschung: sobald `init` die Maschine
// ueber ACPI abschaltet, kehrt `kmain.osum` NIE zurueck -- der Bericht am
// Ende des Laufs kam dann nicht, und der Testlaeufer las leere Zahlen.
// Von hier aus koennen ihn beide rufen: `kmain` am Ende eines Laufs ohne
// init, und `sys.do_reboot` als letzte Amtshandlung mit init.
fn report(state: u64) {
    var s_head: [u8; 15] = "k13: ofsver=\0\0\0"
    var s_chk: [u8; 9] = " checks=\0"
    var s_den: [u8; 9] = " denied=\0"
    var s_set: [u8; 9] = " setids=\0"
    var s_chm: [u8; 9] = " chmods=\0"
    var s_cho: [u8; 9] = " chowns=\0"
    var s_sui: [u8; 11] = " suidexec=\0"
    var s_orp: [u8; 10] = " orphans=\0"
    var s_zom: [u8; 10] = " zombies=\0"
    var s_ini: [u8; 7] = " init=\0"
    let b: u64 = kstate.K13_OFF
    serial.puts((&s_head[0]) as u64)
    serial.dec(fs.version(state))
    serial.puts((&s_chk[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_CHECKS))
    serial.puts((&s_den[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_DENIED))
    serial.puts((&s_set[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_SETIDS))
    serial.puts((&s_chm[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_CHMODS))
    serial.puts((&s_cho[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_CHOWNS))
    serial.puts((&s_sui[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_SUIDEXEC))
    serial.puts((&s_orp[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_ORPHANS))
    serial.puts((&s_zom[0]) as u64)
    serial.dec(sched.zombies(state, sched.K_USER))
    serial.puts((&s_ini[0]) as u64)
    serial.dec(kstate.get(state, b + kstate.U_INITOK))
    serial.nl()
    // RUNDE MULTIUSER: die Zahlen dieser Runde in derselben Ausgabe.
    // Sie stehen in einer EIGENEN Zeile mit eigenem Praefix -- Runde
    // MERGE hat gelernt, was passiert, wenn zwei Runden dieselben
    // Feldnamen auf dieselbe Leitung schreiben: `val` nimmt den
    // letzten Treffer, und jede Frage nach `denied` wurde mit der Null
    // einer anderen Runde beantwortet.
    mu_report(state)
}
