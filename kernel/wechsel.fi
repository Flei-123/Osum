// SPDX-License-Identifier: GPL-2.0-only
// kernel/wechsel.fi -- RUNDE HOTPLUG: DER WECHSELDATENTRAEGER.
//
// Was hier steht, ist die NAHT zwischen zwei Schichten, die einander
// ausdruecklich nicht kennen duerfen:
//
//   * `usb.fi` weiss, dass an Anschluss 3 ein Massenspeicher haengt.
//     Es weiss NICHTS von Partitionen, Dateisystemen oder Pfaden --
//     und das ist eine gemessene Zusage: `tools/k17/run.sh`,
//     Abschnitt 1, prueft, dass `fs.fi`, `fat.fi`, `vfs.fi`, `ofs.fi`
//     und `part.fi` KEIN `usb.*` rufen, und umgekehrt bindet `usb.fi`
//     weder `vfs` noch `part` ein.
//   * `vfs.fi` weiss, wie man ein FAT32 an einem Pfad einhaengt. Es
//     weiss NICHTS davon, dass die Bloecke ueber vier Endpunkte, einen
//     Befehlsblock und eine Quittung kommen.
//
// Zwischen beiden fehlte bis zu dieser Runde genau ein Stueck: WER
// bemerkt, dass ein Stick gekommen ist, und WER macht daraus eine
// Einhaengung. `kmain.usb_mount` tat es EINMAL BEIM START und nur
// unter dem Kommandozeilenwort `usbstick`; ein Stick, der zur Laufzeit
// hineingesteckt wurde, wurde aufgezaehlt (`usb.hotplug_work` gibt es
// seit Runde BLECHEINGABE) und danach vergessen. Diese Datei ist das
// fehlende Stueck.
//
// ================================================== DER ABLAUF
//
//   1. `usb.hotplug_work` hat einen Massenspeicher aufgenommen und
//      ruft `wechsel.kommt(dev)`.
//   2. `part.scan` liest MBR oder GPT vom Geraet. Findet sich nichts,
//      gilt das ganze Geraet als eine Partition -- ein Stick, den ein
//      Fotoapparat formatiert hat, hat oft keine Tafel.
//   3. Fuer die erste brauchbare Partition wird das DATEISYSTEM
//      ERKANNT, und zwar am Inhalt und nicht am Typoktett der Tafel
//      (`fs_erkennen`): das Typoktett ist eine Behauptung des
//      Formatierers, der Bootsektor ist der Befund.
//   4. `vfs.mount_at` haengt sie unter `/medien/usbN` ein.
//   5. Das Ereignis geht auf den SYSTEMBUS (`bus.noti_post`), damit
//      die Oberflaeche es erfaehrt, ohne zu pollen.
//
// Beim Abziehen ruft `usb.gone` -> `wechsel.geht(dev)`, und dann gilt
// die Regel dieser Runde:
//
// ================================================== DATENVERLUST
//
// DER SCHLIMMSTE FEHLER HIER IST EIN HALB GESCHRIEBENER BLOCK. Deshalb
// gibt es ZWEI Wege hinaus, und sie sind ausdruecklich verschieden:
//
//   AUSWERFEN (`auswerfen`) ist der geordnete Weg. Er schreibt zuerst
//   alles Ausstehende auf das Geraet (`fat.sync` ueber
//   `vfs.umount_index`), sagt NEIN, wenn noch ein Deskriptor offen ist
//   (`mnt.opens != 0` -> E_BUSY), und gibt den Platz erst frei, wenn
//   das Geraet die Daten wirklich hat. Ein Auswerfen, das nicht
//   synchronisiert, ist ein Knopf, der luegt.
//
//   ABZIEHEN (`geht`) ist der Notfall. Das Geraet ist schon weg; hier
//   ist nichts mehr zu retten und auch nichts mehr zu schreiben --
//   WER JETZT NOCH `fat.sync` RIEFE, SCHRIEBE IN EIN LOCH. Genau das
//   ist der Grund, warum `geht` NICHT ueber `vfs.umount_index` geht:
//   die Einhaengung wird ROH aus der Tafel genommen (`mnt.free`), und
//   offene Deskriptoren darauf laufen danach in ENODEV -- was sie
//   ohnehin tun, weil `blk.present_on` fuer ein abgezogenes Geraet
//   falsch meldet. Ein Datenverlust ist das nicht: die Daten waren in
//   dem Augenblick verloren, in dem die Hand am Stecker zog. Was
//   dieser Zweig verhindert, ist der ZWEITE Schaden -- ein Kern, der
//   auf ein totes Geraet schreibt und dabei stirbt.
//
// ================================================== ZWEI STICKS
//
// Die Tafel hat acht Plaetze, jeder mit seiner eigenen Geraetenummer
// und seinem eigenen Pfad (`/medien/usb0`, `/medien/usb1`, ...). Der
// Name haengt am PLATZ und nicht an der Reihenfolge des Ansteckens:
// wer Platz 0 raeumt und neu ansteckt, bekommt wieder `usb0`, und
// zwei gleichzeitig gesteckte Sticks koennen einander den Pfad nicht
// wegnehmen.

profile kernel

import lib.kstate
import serial
import blk
import part
import vfs
import vfsops
import mnt
import fat
import bus
import lib.errno
import lib.kutil

export {
    init, kommt, geht, auswerfen, bereit,
    anzahl, traeger_dev, traeger_mnt, traeger_pfad, traeger_bloecke,
    ereignisse, angesteckt, abgezogen, ausgeworfen, fehler,
    letztes_ereignis, EV_NONE, EV_KOMMT, EV_GEHT, EV_AUS,
    MAX_TRAEGER, sag, gesamt_sync, fs_erkennen,
    // RUNDE HOTPLUG-2: traegt die Tafel dieses Blockgeraet schon?
    hat_dev,
    FS_UNBEKANNT, medien_pfad
}

// ------------------------------------------------------------ die Tafel

const MAX_TRAEGER: u64 = 8
const T_BYTES: u64 = 64
const T_BASIS: u64 = 0x100 // die Traeger fangen hinter den Skalaren an

// Die Felder eines Platzes.
const T_USED: u64 = 0
const T_DEV: u64 = 8 // blk.DEV_*
const T_MNT: u64 = 16 // Platz in der Einhaengetafel
const T_FIRST: u64 = 24 // erster Block der Partition
const T_BLOCKS: u64 = 32
const T_FSTYPE: u64 = 40 // vfsops.FS_*
const T_PFAD: u64 = 48 // 16 Oktette Pfad, im Platz selbst

// Die Skalare.
const S_READY: u64 = 0x00
const S_N: u64 = 0x08 // wie viele Plaetze belegt sind
const S_KOMMT: u64 = 0x10 // Anstecken gezaehlt
const S_GEHT: u64 = 0x18 // Abziehen gezaehlt
const S_AUS: u64 = 0x20 // Auswerfen gezaehlt
const S_FEHLER: u64 = 0x28 // was nicht ging
const S_EVENTS: u64 = 0x30 // Ereignisse auf dem Bus
const S_LASTEV: u64 = 0x38 // das letzte Ereignis
const S_SYNCS: u64 = 0x40 // wie oft wirklich synchronisiert wurde

// Die Arten eines Ereignisses.
const EV_NONE: u64 = 0
const EV_KOMMT: u64 = 1
const EV_GEHT: u64 = 2
const EV_AUS: u64 = 3

const FS_UNBEKANNT: u64 = 0

fn basis(state: u64) -> u64 {
    return state + kstate.WECHSEL_OFF
}

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.WECHSEL_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.WECHSEL_OFF + off, v)
}

fn at(state: u64, i: u64) -> u64 {
    return basis(state) + T_BASIS + i * T_BYTES
}

fn tg(state: u64, i: u64, f: u64) -> u64 {
    if i >= MAX_TRAEGER {
        return 0
    }
    return kstate.get(state, kstate.WECHSEL_OFF + T_BASIS + i * T_BYTES + f)
}

fn ts(state: u64, i: u64, f: u64, v: u64) {
    if i >= MAX_TRAEGER {
        return
    }
    kstate.set(state, kstate.WECHSEL_OFF + T_BASIS + i * T_BYTES + f, v)
}

fn bereit(state: u64) -> bool {
    return g(state, S_READY) != 0
}

fn anzahl(state: u64) -> u64 {
    return g(state, S_N)
}

fn traeger_dev(state: u64, i: u64) -> u64 {
    return tg(state, i, T_DEV)
}

fn traeger_mnt(state: u64, i: u64) -> u64 {
    return tg(state, i, T_MNT)
}

fn traeger_bloecke(state: u64, i: u64) -> u64 {
    return tg(state, i, T_BLOCKS)
}

fn traeger_pfad(state: u64, i: u64) -> u64 {
    if i >= MAX_TRAEGER {
        return 0
    }
    return at(state, i) + T_PFAD
}

fn ereignisse(state: u64) -> u64 {
    return g(state, S_EVENTS)
}

fn angesteckt(state: u64) -> u64 {
    return g(state, S_KOMMT)
}

fn abgezogen(state: u64) -> u64 {
    return g(state, S_GEHT)
}

fn ausgeworfen(state: u64) -> u64 {
    return g(state, S_AUS)
}

fn fehler(state: u64) -> u64 {
    return g(state, S_FEHLER)
}

fn letztes_ereignis(state: u64) -> u64 {
    return g(state, S_LASTEV)
}

fn gesamt_sync(state: u64) -> u64 {
    return g(state, S_SYNCS)
}

fn init(state: u64) {
    var i: u64 = 0
    while i < MAX_TRAEGER * T_BYTES + T_BASIS {
        kstate.set8(basis(state) + i, 0 as u8)
        i = i + 1
    }
    s(state, S_READY, 1)
}

// ------------------------------------------------- der Pfad eines Platzes

// `/medien/usbN` in den Platz selbst schreiben. KEIN Zeiger auf den
// Stapel: `mnt.set_path` kopiert zwar, aber `traeger_pfad` gibt die
// Adresse spaeter an Ring 3 weiter, und die muss den Aufruf ueberleben.
fn pfad_bauen(state: u64, i: u64) {
    let p: u64 = at(state, i) + T_PFAD
    // "/medien/usb" = 11 Oktette, dann die Ziffer, dann die Null.
    kstate.set8(p + 0, 47 as u8) // '/'
    kstate.set8(p + 1, 109 as u8) // 'm'
    kstate.set8(p + 2, 101 as u8) // 'e'
    kstate.set8(p + 3, 100 as u8) // 'd'
    kstate.set8(p + 4, 105 as u8) // 'i'
    kstate.set8(p + 5, 101 as u8) // 'e'
    kstate.set8(p + 6, 110 as u8) // 'n'
    kstate.set8(p + 7, 47 as u8) // '/'
    kstate.set8(p + 8, 117 as u8) // 'u'
    kstate.set8(p + 9, 115 as u8) // 's'
    kstate.set8(p + 10, 98 as u8) // 'b'
    kstate.set8(p + 11, (48 + (i % 10)) as u8)
    kstate.set8(p + 12, 0 as u8)
}

// Der Ordner, unter dem alles haengt. Er muss es geben, sonst sagt
// `vfs.mount_at` nein -- ein Einhaengepunkt ist ein Verzeichnis.
static mut p_medien: [u8; 8] = "/medien\0"

fn medien_pfad() -> u64 {
    return (&p_medien[0]) as u64
}

// ------------------------------------------------- das Dateisystem erkennen

// WAS WIRKLICH AUF DEM GERAET LIEGT -- gelesen, nicht geglaubt.
//
// Das Typoktett einer MBR-Tafel (0x0B, 0x0C fuer FAT32) ist eine
// BEHAUPTUNG dessen, der formatiert hat. Sie stimmt meistens und ist
// deshalb gefaehrlich: wer ihr glaubt, haengt irgendwann ein NTFS als
// FAT32 ein und schreibt in eine Struktur, die er nicht versteht.
//
// Erkannt wird am BOOTSEKTOR der Partition selbst:
//   * FAT32: Oktett 82..87 tragen "FAT32   ", und die Signatur 0x55AA
//     steht am Ende. Zusaetzlich wird geprueft, dass die Zahl der
//     Oktette je Sektor eine Zweierpotenz zwischen 512 und 4096 ist --
//     ein Nullblock traegt sonst zufaellig die halbe Kennung.
//   * OFS: die eigene Kennung im Superblock, ueber `ofs`s eigene Zahl.
//
// Rueckgabe: vfsops.FS_FAT, vfsops.FS_OFS oder FS_UNBEKANNT.
fn fs_erkennen(state: u64, dev: u64, first: u64) -> u64 {
    let buf: u64 = basis(state) + T_BASIS + MAX_TRAEGER * T_BYTES
    var i: u64 = 0
    while i < 512 {
        kstate.set8(buf + i, 0 as u8)
        i = i + 1
    }
    if !blk.read_on(state, dev, first, buf) {
        return FS_UNBEKANNT
    }
    // Die Signatur am Ende. Ohne sie ist es kein Bootsektor, und alles
    // Weitere waere geraten.
    let sig0: u64 = kstate.get8(buf + 510)
    let sig1: u64 = kstate.get8(buf + 511)
    if sig0 == 0x55 && sig1 == 0xAA {
        // Oktette je Sektor, kleinendig in 11..12.
        let bps: u64 = kstate.get8(buf + 11) | (kstate.get8(buf + 12) << 8)
        if bps == 512 || bps == 1024 || bps == 2048 || bps == 4096 {
            // "FAT32   " ab Oktett 82.
            if kstate.get8(buf + 82) == 70 && kstate.get8(buf + 83) == 65
                && kstate.get8(buf + 84) == 84 && kstate.get8(buf + 85) == 51
                && kstate.get8(buf + 86) == 50 {
                return vfsops.FS_FAT
            }
            // Auch ein FAT16/FAT12 traegt seine Kennung, nur bei 54.
            // Dieser Kern hat dafuer keinen Treiber -- also wird es
            // ausdruecklich NICHT als FAT gemeldet, statt es
            // einzuhaengen und beim ersten Verzeichnis zu scheitern.
            if kstate.get8(buf + 54) == 70 && kstate.get8(buf + 55) == 65
                && kstate.get8(buf + 56) == 84 {
                return FS_UNBEKANNT
            }
        }
    }
    return FS_UNBEKANNT
}

// ------------------------------------------------- ein Platz in der Tafel

fn platz_frei(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_TRAEGER {
        if tg(state, i, T_USED) == 0 {
            return i
        }
        i = i + 1
    }
    return MAX_TRAEGER
}

// RUNDE HOTPLUG-2: TRAEGT DIE TAFEL DIESES GERAET SCHON?
//
// Die Frage, an der die Schleife in `wechsel_schritt` haengt. Sie ist
// ausdruecklich KEINE zweite Buchhaltung: geantwortet wird aus
// derselben Traegertafel, die auch `kommt` und `geht` fuehren. Wer
// stattdessen mitzaehlte, haette zwei Wahrheiten und muesste sie
// vergleichen.
fn hat_dev(state: u64, dev: u64) -> bool {
    return platz_von_dev(state, dev) < MAX_TRAEGER
}

fn platz_von_dev(state: u64, dev: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_TRAEGER {
        if tg(state, i, T_USED) != 0 && tg(state, i, T_DEV) == dev {
            return i
        }
        i = i + 1
    }
    return MAX_TRAEGER
}

// ------------------------------------------------- das Ereignis auf den Bus

// EIN GERAETEEREIGNIS, UND ZWAR AUF DEM BESTEHENDEN BUS.
//
// Der Auftrag sagte ausdruecklich: pruefen, ob der Systembus dafuer
// taugt, statt etwas Zweites danebenzustellen. Er taugt --
// `bus.noti_post` traegt eine Meldung mit Prioritaet und Text, die
// Leiste zeigt sie schon an (Runde SYSTEMBUS, Abschnitt e), und
// `bus.pub`/`bus.sub` traegt sie an jeden Abonnenten. Also wird hier
// KEIN zweiter Meldeweg gebaut.
//
// Der Text ist kurz und maschinenlesbar, weil ihn zwei sehr
// verschiedene Leser bekommen: ein Mensch in der Leiste und der
// Explorer, der daraufhin seine Seitenleiste neu aufbaut.
//
//     "usb+ /medien/usb0"   angesteckt und eingehaengt
//     "usb- /medien/usb0"   abgezogen
//     "usb^ /medien/usb0"   ausgeworfen
fn melden(state: u64, art: u64, i: u64) {
    var txt: [u8; 32] = [0 as u8; 32]
    txt[0] = 117 as u8 // 'u'
    txt[1] = 115 as u8 // 's'
    txt[2] = 98 as u8 // 'b'
    var z: u64 = 43 // '+'
    if art == EV_GEHT {
        z = 45 // '-'
    } else if art == EV_AUS {
        z = 94 // '^'
    }
    txt[3] = z as u8
    txt[4] = 32 as u8 // ' '
    var n: u64 = 5
    if i < MAX_TRAEGER {
        let p: u64 = at(state, i) + T_PFAD
        var k: u64 = 0
        while k < 16 && n < 30 {
            let c: u64 = kstate.get8(p + k)
            if c == 0 {
                k = 16
            } else {
                txt[n as usize] = c as u8
                n = n + 1
                k = k + 1
            }
        }
    }
    txt[n as usize] = 0 as u8
    s(state, S_LASTEV, art)
    s(state, S_EVENTS, g(state, S_EVENTS) + 1)
    // Aufgabe 0: der Kern selbst. `noti_post` liest daraus pid und uid.
    let _r: u64 = bus.noti_post(state, 0, 1, n, (&txt[0]) as u64)
}

// ------------------------------------------------- ein Traeger kommt

// EIN WECHSELDATENTRAEGER IST DA. Gerufen aus `usb.hotplug_work`,
// nachdem der Massenspeicher aufgezaehlt und `blk` ihn kennt.
//
// Rueckgabe: der Platz in der Tafel, oder MAX_TRAEGER.
fn kommt(state: u64, dev: u64) -> u64 {
    var s_h: [u8; 16] = "wechsel: kommt \0"
    var s_d: [u8; 6] = "dev=\0\0"
    var s_p: [u8; 9] = "  parts=\0"
    var s_f: [u8; 9] = "  first=\0"
    var s_n: [u8; 10] = "  blocks=\0"
    var s_t: [u8; 7] = "  fs=\0\0"
    var s_m: [u8; 9] = "  mount=\0"
    var s_schon: [u8; 32] = "wechsel: dev schon in der Tafel\0"
    var s_voll: [u8; 25] = "wechsel: kein Platz frei\0"
    var s_kein: [u8; 35] = "wechsel: kein Dateisystem erkannt\0\0"

    if !bereit(state) {
        init(state)
    }
    // ================================================== RUNDE HOTPLUG
    // DIE EINHAENGESCHICHT KANN NOCH GAR NICHT STEHEN.
    //
    // `k14_setup` ruft `vfs.init` + `vfs.mount_root` beim Start --
    // aber nur, wenn es laeuft. Im grafischen Lauf (`wigfiles`) haengt
    // der Fensterserver die Wurzel SELBST ein, ueber `fs.fi`, und die
    // VFS-Schicht darueber bleibt unberuehrt: `vfs.ready` ist falsch.
    // GEMESSEN: `kgui: wechsel gen=1 weg=1 vfs=0` -- der Stick war da,
    // die Flanke kam an, und es gab keine Tafel, in die er gepasst
    // haette.
    //
    // Also wird sie hier nachgezogen. Das ist kein Kunstgriff: `init`
    // setzt eine leere Tafel, `mount_root` traegt die Platte ein, von
    // der schon gelesen wird (`kstate.DISK_DEV`) -- beides beschreibt,
    // was ohnehin der Fall ist. Steht die Schicht schon, tut
    // `mount_root` nichts (`if mnt.used(state, 0) { return true }`).
    if !vfs.ready(state) {
        vfs.init(state)
        if !vfs.mount_root(state) {
            return MAX_TRAEGER
        }
    }
    // ================================================== RUNDE HOTPLUG
    // DER ORDNER `/medien` KANN HIER NOCH FEHLEN, UND DAS IST KEIN
    // SONDERFALL.
    //
    // `k14_setup` legt ihn beim Start an -- aber `k14_setup` laeuft
    // nicht in jedem Betrieb. Im grafischen Lauf (`wigfiles`) haengt
    // der Fensterserver die Wurzel SELBST ein (`wm: mount=1`), und
    // diese Zeile kommt nie vorbei. Gemessen: der Stick wurde
    // aufgezaehlt (`usb: msc blocks=98304`), und danach kam keine
    // einzige `wechsel:`-Zeile, weil `/medien/usb0` keinen Ort hatte.
    //
    // Also wird hier nachgesehen und notfalls nachgeholt. Liegt der
    // Ordner schon, gibt `v_create` null zurueck -- kein Fehler.
    let wurzel: u64 = vfs.mount_for(state, (&p_medien[0]) as u64)
    if wurzel < vfs.MAX_MNT {
        let _md: u64 = vfs.v_create(state, wurzel,
            (&p_medien[0]) as u64, vfsops.N_DIR)
    }
    // Zweimal derselbe Stick waere zwei Einhaengungen auf einem Geraet.
    if platz_von_dev(state, dev) < MAX_TRAEGER {
        serial.puts((&s_schon[0]) as u64)
        serial.nl()
        return MAX_TRAEGER
    }
    let i: u64 = platz_frei(state)
    if i >= MAX_TRAEGER {
        serial.puts((&s_voll[0]) as u64)
        serial.nl()
        s(state, S_FEHLER, g(state, S_FEHLER) + 1)
        return MAX_TRAEGER
    }
    s(state, S_KOMMT, g(state, S_KOMMT) + 1)

    // 1. Die Partitionstafel. Findet sich keine, ist das GANZE Geraet
    //    die Partition -- so formatieren Fotoapparate und so kommt
    //    mancher Stick aus der Fabrik.
    var first: u64 = 0
    var anz: u64 = blk.blocks_on(state, dev)
    let nparts: u64 = part.scan(state, dev)
    var fstyp: u64 = FS_UNBEKANNT
    if nparts != 0 {
        // Jede Partition der Reihe nach ansehen und die erste nehmen,
        // deren INHALT ein Dateisystem ist, das dieser Kern kann.
        // NICHT die erste, deren TYPOKTETT danach aussieht.
        var k: u64 = 0
        while k < part.MAX_PARTS && fstyp == FS_UNBEKANNT {
            if part.dev_of(state, k) == dev && part.blocks(state, k) != 0 {
                let st: u64 = part.start(state, k)
                let t: u64 = fs_erkennen(state, dev, st)
                if t != FS_UNBEKANNT {
                    fstyp = t
                    first = st
                    anz = part.blocks(state, k)
                }
            }
            k = k + 1
        }
    }
    if fstyp == FS_UNBEKANNT {
        // Kein Treffer in der Tafel (oder gar keine Tafel): das ganze
        // Geraet ab Block 0 versuchen.
        fstyp = fs_erkennen(state, dev, 0)
        first = 0
        anz = blk.blocks_on(state, dev)
    }

    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_d[0]) as u64)
    serial.dec(dev)
    serial.puts((&s_p[0]) as u64)
    serial.dec(nparts)
    serial.puts((&s_f[0]) as u64)
    serial.dec(first)
    serial.puts((&s_n[0]) as u64)
    serial.dec(anz)
    serial.puts((&s_t[0]) as u64)
    serial.dec(fstyp)

    if fstyp == FS_UNBEKANNT {
        // DER EHRLICHE AUSGANG. Ein Stick mit NTFS oder exFAT wird
        // NICHT eingehaengt und NICHT als Attrappe in die Tafel
        // gestellt -- er wird gemeldet und stehengelassen. Ein Eintrag
        // in der Seitenleiste, den niemand oeffnen kann, waere
        // schlimmer als keiner.
        serial.puts((&s_m[0]) as u64)
        serial.dec(0)
        serial.nl()
        serial.puts((&s_kein[0]) as u64)
        serial.nl()
        s(state, S_FEHLER, g(state, S_FEHLER) + 1)
        return MAX_TRAEGER
    }

    // 2. Den Platz belegen, DANN einhaengen: `pfad_bauen` schreibt in
    //    den Platz, und `vfs.mount_at` liest den Pfad daraus.
    ts(state, i, T_USED, 1)
    ts(state, i, T_DEV, dev)
    ts(state, i, T_FIRST, first)
    ts(state, i, T_BLOCKS, anz)
    ts(state, i, T_FSTYPE, fstyp)
    pfad_bauen(state, i)

    // DER EINHAENGEPUNKT MUSS ES GEBEN. `/medien` legt `k14_setup`
    // beim Start an; `/medien/usbN` kann es dort nicht anlegen, weil
    // dort noch niemand weiss, wie viele Sticks kommen. Also hier --
    // und zwar VOR dem Einhaengen, denn `vfs.mount_at` verlangt ein
    // Verzeichnis, das schon da ist.
    //
    // Liegt der Ordner schon (zweites Anstecken auf denselben Platz),
    // gibt `v_create` null, und das ist kein Fehler.
    let ueber: u64 = vfs.mount_for(state, at(state, i) + T_PFAD)
    if ueber < vfs.MAX_MNT {
        let _mk: u64 = vfs.v_create(state, ueber,
            at(state, i) + T_PFAD, vfsops.N_DIR)
    }
    let m: u64 = vfs.mount_at(state, fstyp, dev, first, anz,
        at(state, i) + T_PFAD, 0)
    serial.puts((&s_m[0]) as u64)
    serial.dec(kutil.yes(m < vfs.MAX_MNT))
    serial.nl()
    if m >= vfs.MAX_MNT {
        // Der Ordner fehlt, oder das Dateisystem hat beim Anlesen
        // widersprochen. Der Platz wird wieder frei -- eine Halbzeile
        // in der Tafel waere ein Traeger, den man nicht loswird.
        ts(state, i, T_USED, 0)
        s(state, S_FEHLER, g(state, S_FEHLER) + 1)
        return MAX_TRAEGER
    }
    ts(state, i, T_MNT, m)
    s(state, S_N, g(state, S_N) + 1)
    melden(state, EV_KOMMT, i)
    return i
}

// ------------------------------------------------- ein Traeger geht

// ABGEZOGEN, OHNE ZU FRAGEN. Das Geraet ist WEG -- hier wird nichts
// mehr geschrieben (siehe der Kopf dieser Datei), sondern nur noch
// aufgeraeumt, damit der Rest des Systems nicht auf eine Einhaengung
// zeigt, hinter der kein Geraet mehr steht.
//
// Rueckgabe: wie viele Plaetze geraeumt wurden.
fn geht(state: u64, dev: u64) -> u64 {
    var s_h: [u8; 22] = "wechsel: geht  dev=\0\0\0"
    var s_m: [u8; 8] = "  mnt=\0\0"
    var s_o: [u8; 10] = "  opens=\0\0"
    if !bereit(state) {
        return 0
    }
    var n: u64 = 0
    var i: u64 = 0
    while i < MAX_TRAEGER {
        if tg(state, i, T_USED) != 0 && tg(state, i, T_DEV) == dev {
            let m: u64 = tg(state, i, T_MNT)
            serial.puts((&s_h[0]) as u64)
            serial.dec(dev)
            serial.puts((&s_m[0]) as u64)
            serial.dec(m)
            serial.puts((&s_o[0]) as u64)
            serial.dec(mnt.opens(state, m))
            serial.nl()
            // ROH aus der Tafel, OHNE sync. `fat.release` gibt die
            // Puffer dieses Dateisystems frei, ohne sie zu schreiben --
            // das ist genau der Unterschied zum Auswerfen.
            if mnt.used(state, m) && mnt.dev(state, m) == dev {
                if mnt.fstype(state, m) == vfsops.FS_FAT {
                    fat.release(state, m)
                }
                mnt.free(state, m)
            }
            ts(state, i, T_USED, 0)
            ts(state, i, T_MNT, 0)
            if g(state, S_N) != 0 {
                s(state, S_N, g(state, S_N) - 1)
            }
            s(state, S_GEHT, g(state, S_GEHT) + 1)
            melden(state, EV_GEHT, i)
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// ------------------------------------------------- auswerfen

// DER GEORDNETE WEG, und der einzige, der etwas schreibt.
//
// Rueckgabe: 0 = ausgeworfen, sonst der POSITIVE errno.
//   E_INVAL  diesen Traeger gibt es nicht
//   E_BUSY   es ist noch etwas offen (`mnt.opens != 0`) oder es haengt
//            etwas darunter -- beides kommt aus `vfs.umount_index`
//
// WICHTIG: das Synchronisieren passiert IN `vfs.umount_index`
// (`fat.sync` vor `fat.release`), und zwar NUR, wenn die Pruefung auf
// offene Deskriptoren vorher durchging. Ein Auswerfen, das die Daten
// schreibt und dann E_BUSY meldet, haette die Datei eines anderen
// Prozesses halb geschrieben.
fn auswerfen(state: u64, i: u64) -> u64 {
    var s_h: [u8; 20] = "wechsel: auswerfen \0"
    var s_i: [u8; 4] = "i=\0\0"
    var s_r: [u8; 8] = "  rc=\0\0\0"
    if !bereit(state) || i >= MAX_TRAEGER {
        return errno.E_INVAL
    }
    if tg(state, i, T_USED) == 0 {
        return errno.E_INVAL
    }
    let m: u64 = tg(state, i, T_MNT)
    // Das Geraet ist noch da: JETZT wird geschrieben. `umount_index`
    // ruft `fat.sync` und danach `fat.release`.
    let rc: u64 = vfs.umount_index(state, m)
    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_i[0]) as u64)
    serial.dec(i)
    serial.puts((&s_r[0]) as u64)
    serial.dec(rc)
    serial.nl()
    if rc != 0 {
        // E_BUSY: der Traeger BLEIBT. Das ist der ganze Sinn der
        // Zahl -- ein Auswerfen, das sich nicht aufhalten laesst,
        // waere ein Abziehen mit Knopf.
        s(state, S_FEHLER, g(state, S_FEHLER) + 1)
        return rc
    }
    s(state, S_SYNCS, g(state, S_SYNCS) + 1)
    ts(state, i, T_USED, 0)
    ts(state, i, T_MNT, 0)
    if g(state, S_N) != 0 {
        s(state, S_N, g(state, S_N) - 1)
    }
    s(state, S_AUS, g(state, S_AUS) + 1)
    melden(state, EV_AUS, i)
    return 0
}

// ------------------------------------------------- die Auskunft

fn sag(state: u64) {
    var s_h: [u8; 17] = "wechsel: traeger\0"
    var s_n: [u8; 4] = "n=\0\0"
    var s_k: [u8; 8] = "  kom=\0\0"
    var s_g: [u8; 8] = "  geh=\0\0"
    var s_a: [u8; 8] = "  aus=\0\0"
    var s_s: [u8; 9] = "  sync=\0\0"
    var s_e: [u8; 8] = "  evt=\0\0"
    var s_f: [u8; 8] = "  err=\0\0"
    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_n[0]) as u64)
    serial.dec(g(state, S_N))
    serial.puts((&s_k[0]) as u64)
    serial.dec(g(state, S_KOMMT))
    serial.puts((&s_g[0]) as u64)
    serial.dec(g(state, S_GEHT))
    serial.puts((&s_a[0]) as u64)
    serial.dec(g(state, S_AUS))
    serial.puts((&s_s[0]) as u64)
    serial.dec(g(state, S_SYNCS))
    serial.puts((&s_e[0]) as u64)
    serial.dec(g(state, S_EVENTS))
    serial.puts((&s_f[0]) as u64)
    serial.dec(g(state, S_FEHLER))
    serial.nl()
}
