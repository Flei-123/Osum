    if find(cmd, (&wcpr[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_WACHPRUEF)
    }
    if find(cmd, (&wcno[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_NOWACH)
    }
    if find(cmd, (&wcme[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_WACHMESS)
