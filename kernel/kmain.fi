// `iwlboot` / `iwlfwtest` (LW-3a): opt-in Intel WLAN firmware boot, QEMU firmware lookup test bed.
fn iwl_words(state: u64, cmd: u64) {
    var w_ib: [u8; 8] = "iwlboot\0"
    var w_it: [u8; 10] = "iwlfwtest\0"
    if find(cmd, (&w_ib[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_IWLBOOT)
    }
    if find(cmd, (&w_it[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFWTEST)
    }
    var w_fh: [u8; 10] = "iwlfhtest\0"
    var w_fl: [u8; 10] = "iwlfhlost\0"
    var w_fb: [u8; 9] = "iwlfhbad\0"
    if find(cmd, (&w_fh[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHTEST)
    }
    if find(cmd, (&w_fl[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHLOST)
    }
    if find_word(cmd, (&w_fb[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHBAD)
    }
    var w_ni: [u8; 6] = "noiwl\0"
    var w_nn: [u8; 11] = "iwlfhnonvm\0"
    var w_nc: [u8; 13] = "iwlfhnoinitc\0"
    var w_na: [u8; 13] = "iwlfhnoalive\0"
    var w_bn: [u8; 12] = "iwlfhbadnvm\0"
    var w_bi: [u8; 10] = "iwlfhbind\0"
    if find_word(cmd, (&w_ni[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOIWL)
    }
    if find_word(cmd, (&w_nn[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHNONVM)
    }
    if find_word(cmd, (&w_nc[0]) as u64, 12) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHNOINITC)
    }
    if find_word(cmd, (&w_na[0]) as u64, 12) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHNOALIVE)
    }
    if find_word(cmd, (&w_bn[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHBADNVM)
    }
    if find_word(cmd, (&w_bi[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHBIND)
    }
    var w_iwloldscan: [u8; 11] = "iwloldscan\0"
    var w_iwloldslot: [u8; 11] = "iwloldslot\0"
    var w_iwloldssid: [u8; 11] = "iwloldssid\0"
    var w_iwloldmac: [u8; 10] = "iwloldmac\0"
    var w_iwloldtxq: [u8; 10] = "iwloldtxq\0"
    var w_iwloldloss: [u8; 11] = "iwloldloss\0"
    var w_iwloldpbkdf: [u8; 12] = "iwloldpbkdf\0"
    var w_iwlfhdrop: [u8; 10] = "iwlfhdrop\0"
    var w_wlannoloss: [u8; 11] = "wlannoloss\0"
    var w_iwloldrx: [u8; 9] = "iwloldrx\0"
    var w_iwlfhslow: [u8; 10] = "iwlfhslow\0"
    var w_iwloldalive: [u8; 12] = "iwloldalive\0"
    var w_iwlfhrxonly: [u8; 12] = "iwlfhrxonly\0"
    var w_iwlnotrace: [u8; 11] = "iwlnotrace\0"
    var w_iwlfhwake: [u8; 10] = "iwlfhwake\0"
    var w_iwlfhdead: [u8; 10] = "iwlfhdead\0"
    var w_iwlfhrxsilent: [u8; 14] = "iwlfhrxsilent\0"
    var w_iwlnoraw: [u8; 9] = "iwlnoraw\0"
    var w_iwlfhexpwake: [u8; 13] = "iwlfhexpwake\0"
    var w_iwlnorxexp: [u8; 11] = "iwlnorxexp\0"
    var w_iwlfhmsi: [u8; 9] = "iwlfhmsi\0"
    var w_iwlnopoll: [u8; 10] = "iwlnopoll\0"
    var w_iwlnoown: [u8; 9] = "iwlnoown\0"
    if find_word(cmd, (&w_iwloldscan[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDSCAN)
    }
    if find_word(cmd, (&w_iwloldslot[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDSLOT)
    }
    if find_word(cmd, (&w_iwloldssid[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDSSID)
    }
    if find_word(cmd, (&w_iwloldmac[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDMAC)
    }
    if find_word(cmd, (&w_iwloldtxq[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDTXQ)
    }
    if find_word(cmd, (&w_iwloldloss[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDLOSS)
    }
    if find_word(cmd, (&w_iwloldpbkdf[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDPBKDF)
    }
    if find_word(cmd, (&w_iwlfhdrop[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHDROP)
    }
    if find_word(cmd, (&w_wlannoloss[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_WLANNOLOSS)
    }
    if find_word(cmd, (&w_iwloldrx[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDRX)
    }
    if find_word(cmd, (&w_iwlfhslow[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHSLOW)
    }
    if find_word(cmd, (&w_iwloldalive[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDALIVE)
    }
    if find_word(cmd, (&w_iwlfhrxonly[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHRXONLY)
    }
    if find_word(cmd, (&w_iwlnotrace[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLNOTRACE)
    }
    if find_word(cmd, (&w_iwlfhwake[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHWAKE)
    }
    if find_word(cmd, (&w_iwlfhdead[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHDEAD)
    }
    if find_word(cmd, (&w_iwlfhrxsilent[0]) as u64, 13) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHRXSILENT)
    }
    if find_word(cmd, (&w_iwlnoraw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_IWLNORAW)
    }
    if find_word(cmd, (&w_iwlfhexpwake[0]) as u64, 12) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHEXPWAKE)
    }
    if find_word(cmd, (&w_iwlnorxexp[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLNORXEXP)
    }
    if find_word(cmd, (&w_iwlfhmsi[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHMSI)
    }
    if find_word(cmd, (&w_iwlnopoll[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLNOPOLL)
    }
    if find_word(cmd, (&w_iwlnoown[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_IWLNOOWN)
    }
    var w_iwlnoipoll: [u8; 11] = "iwlnoipoll\0"
    if find_word(cmd, (&w_iwlnoipoll[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLNOIPOLL)
    }
    var w_iwlfhrfkill: [u8; 12] = "iwlfhrfkill\0"
    if find_word(cmd, (&w_iwlfhrfkill[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHRFKILL)
    }
}

fn hotkey_words(state: u64, cmd: u64) {
    var w_nh: [u8; 8] = "nohktab\0"
    var w_ne: [u8; 5] = "noec\0"
    var w_es: [u8; 6] = "ecsim\0"
    if find_word(cmd, (&w_nh[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOHKTAB)
    }
    if find_word(cmd, (&w_ne[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_NOEC)
    }
    if find_word(cmd, (&w_es[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_ECSIM)
    }
}

fn store_words(state: u64, cmd: u64) {
    var w_ns: [u8; 8] = "nostore\0"
    if find_word(cmd, (&w_ns[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOSTORE)
    }
    var w_du: [u8; 10] = "drvunload\0"
    if find_word(cmd, (&w_du[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_DRVUNLOAD)
    }
    var w_fbc: [u8; 12] = "iwlfhbigcal\0"
    if find_word(cmd, (&w_fbc[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHBIGCAL)
    }
    var w_ono: [u8; 12] = "iwloldnotif\0"
    if find_word(cmd, (&w_ono[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDNOTIF)
    }
    var w_oty: [u8; 11] = "iwloldtype\0"
    if find_word(cmd, (&w_oty[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDTYPE)
    }
    var w_oph: [u8; 10] = "iwloldphy\0"
    if find_word(cmd, (&w_oph[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDPHY)
    }
    var w_oin: [u8; 11] = "iwloldinit\0"
    if find_word(cmd, (&w_oin[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDINIT)
    }
    var w_irt: [u8; 7] = "iwlrt=\0"
    let rtv: u64 = num_nach(cmd, (&w_irt[0]) as u64, 6, 0)
    if (rtv & 1) != 0 { kstate.mode_add(state, kstate.M_IWLRT0) }
    if (rtv & 2) != 0 { kstate.mode_add(state, kstate.M_IWLRT1) }
    if (rtv & 4) != 0 { kstate.mode_add(state, kstate.M_IWLRT2) }
    var w_ohd: [u8; 10] = "iwloldhdr\0"
    if find_word(cmd, (&w_ohd[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDHDR)
    }
    var w_dh: [u8; 8] = "drvhold\0"
    if find_word(cmd, (&w_dh[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_DRVHOLD)
    }
    var w_sh: [u8; 9] = "slothold\0"
    if find_word(cmd, (&w_sh[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_SLOTHOLD)
    }
    var w_nc: [u8; 8] = "noclass\0"
    if find_word(cmd, (&w_nc[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOCLASS)
    }
    var w_bc: [u8; 9] = "badclass\0"
    if find_word(cmd, (&w_bc[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_BADCLASS)
    }
    var w_npk: [u8; 10] = "nophykick\0"
    if find_word(cmd, (&w_npk[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_NOPHYKICK)
    }
    var w_nci: [u8; 9] = "nochintr\0"
    if find_word(cmd, (&w_nci[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOCHINTR)
    }
    var w_nca: [u8; 8] = "nochalt\0"
    if find_word(cmd, (&w_nca[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOCHALT)
    }
    var w_nwl: [u8; 11] = "nowirelock\0"
    if find_word(cmd, (&w_nwl[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_NOWIRELOCK)
    }
    var w_nbg: [u8; 12] = "noblkguard\0\0"
    if find_word(cmd, (&w_nbg[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_NOBLKGUARD)
    }
    var w_nal: [u8; 12] = "nodrvlock\0\0\0"
    if find_word(cmd, (&w_nal[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_NOAHCILOCK)
    }
    var w_arc: [u8; 8] = "blkrace\0"
    if find_word(cmd, (&w_arc[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_AHCIRACE)
    }
    var w_wlt: [u8; 8] = "wltrace\0"
    if find_word(cmd, (&w_wlt[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_WLTRACE)
    }
    var w_swd: [u8; 9] = "serwiden\0"
    if find_word(cmd, (&w_swd[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_SERWIDEN)
    }
    var w_nsi: [u8; 8] = "nosetif\0"
    if find_word(cmd, (&w_nsi[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOSETIF)
    }
    var w_unr: [u8; 12] = "usbnorescan\0"
    if find_word(cmd, (&w_unr[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_NOUSBRESCAN)
    }
    var w_nag: [u8; 9] = "noarpgap\0"
    if find_word(cmd, (&w_nag[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOARPGAP)
    }
}

// `rndisonly` (r811 test bed): bind a USB network device that offers ECM and RNDIS to RNDIS.
