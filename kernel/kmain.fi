    var evnw: [u8; 10] = "noacpiev\0\0"
    var evdw: [u8; 7] = "evdump\0"
    var evsw: [u8; 7] = "evself\0"
    var evfw: [u8; 7] = "evfake\0"
    var evhw: [u8; 9] = "evnohold\0"
    var evww: [u8; 7] = "evwait\0"
    var evlw: [u8; 6] = "evlid\0"
    var evw: [u8; 8] = "acpiev\0\0"
    var spmw: [u8; 10] = "suspmess\0\0"
    var spw: [u8; 8] = "suspend\0"
    if find(cmd, (&evnw[0]) as u64, 8) != 0 {
