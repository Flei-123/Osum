    }
    if find(cmd, (&spmw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_SUSPMESS)
    }
    if find(cmd, (&spw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_SUSPEND)
    }
    var slarm: [u8; 10] = "schlafarm\0"
    var slpr: [u8; 12] = "schlafpruef\0"  // DRAHT: Kernzeilenwort, tools/suspend/run.sh
    var slhw: [u8; 9] = "schlafhw\0"
    var slkp: [u8; 13] = "schlafkaputt\0"
    var slno: [u8; 10] = "noschlaf\0\0"
    var slme: [u8; 11] = "schlafmess\0"
    var slw: [u8; 7] = "schlaf\0"
    if find(cmd, (&slarm[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_SCHLAFARM)
    }
    if find(cmd, (&slpr[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_SCHLAFPRUEF)
    }
    if find(cmd, (&slhw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_SCHLAFHW)
    }
    if find(cmd, (&slkp[0]) as u64, 12) != 0 {
        kstate.mode_add(state, kstate.M_SCHLAFKAPUTT)
    }
    if find(cmd, (&slno[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOSCHLAF)
    }
    if find(cmd, (&slme[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_SCHLAFMESS)
    }
    if find_word(cmd, (&slw[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_SCHLAF)
    }
    // K-004: the real S3. Whole words, because `s3` is short enough to
    // sit inside anything.
    var w_s3: [u8; 3] = "s3\0"
    var w_s3z: [u8; 7] = "s3zwei\0"
    var w_s3k: [u8; 9] = "s3kaputt\0"
    if find_word(cmd, (&w_s3[0]) as u64, 2) != 0 {
        kstate.mode_add(state, kstate.M_S3)
    }
    if find_word(cmd, (&w_s3z[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_S3_SECOND)
    }
    if find_word(cmd, (&w_s3k[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_S3_BROKEN)
    }
    var w_s3nh: [u8; 10] = "s3nohooks\0"
    if find_word(cmd, (&w_s3nh[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_S3NOHOOKS)
    }
    var w_s3sm: [u8; 6] = "s3smp\0"
    if find_word(cmd, (&w_s3sm[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_S3SMP)
    }
    var w_s3ls: [u8; 7] = "s3loss\0"
    if find_word(cmd, (&w_s3ls[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_S3LOSS)
    }
    var w_s3ns: [u8; 10] = "s3nostart\0"
    if find_word(cmd, (&w_s3ns[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_S3NOSTART)
    }
    var w_s3n: [u8; 9] = "s3nobild\0"
    if find_word(cmd, (&w_s3n[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_S3NOBILD)
    }
    // ================= RUNDE WACH (K-018, Abschluss): DER WIEDERANLAUF
    var wcarm: [u8; 8] = "wacharm\0"
    var wcpr: [u8; 10] = "wachpruef\0"  // DRAHT: Kernzeilenwort, tools/suspend/run.sh
    var wcno: [u8; 8] = "nowach\0\0"
    var wcme: [u8; 9] = "wachmess\0"
    var wcw: [u8; 5] = "wach\0"
    if find(cmd, (&wcarm[0]) as u64, 7) != 0 {
