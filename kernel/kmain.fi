// SPDX-License-Identifier: GPL-2.0-only
// kernel/kmain.fi -- round 59: a small kernel, in Firn.
//
// Round 52 proved that `profile kernel` produces a freestanding object
// file: no libc, no runtime, no `_start`. What booted back then said its
// name over the serial port and stopped. This is the kernel that does
// something:
//
//   * it installs an IDT of its own and reports exceptions with error
//     code, CR2 and all sixteen registers (`trap.fi`),
//   * it remaps the two PICs and lets the PIT tick at 100 Hz; the counter
//     runs measurably up (`idt.fi`),
//   * it reads the memory map of the boot loader, manages the physical
//     memory frame by frame and puts a heap on top (`mem.fi`),
//   * it reads the keyboard over IRQ1 (`kbd.fi`),
//   * it goes into ring 3 and comes back through a system call
//     (`user.fi`).
//
// Everything of that is Firn. Assembly is exactly where the machine is
// not yet in a state a compiled function could run in: `boot.s` (long
// mode) and `isr.s` (interrupt entry points).
//
// What runs is decided by the command line of the boot loader
// (`-append`): without arguments the full run, with `trap=de|pf|gp|df` a
// deliberate fault. `tools/kernel/run.sh` starts both.

profile kernel

import serial
import kstate
import fassung
import arch.x86_64.idt
import mem
import arch.x86_64.trap
import kbd
import arch.x86_64.user
import power
import pwr
import batt
import hwid
import pmon
import sched
import tasks
import proc
import sys
import file
import blk
import fs
import elf
import hw
import netsvc
import arch.x86_64.smp
import netview
import netmon
import share
import cap
import handle
import async
import gfx
import sercon
import kutil
import nidx
import arch.x86_64.apic
import arch.x86_64.hv

import time
import rand
import tty
import signal
import arch.x86_64.guard
import arch.x86_64.fpu
import bootmod
import modul
import ksym
import modtab
import modidx
import ab
import hwdiag
import rootsel
import ehci
import blkdev
import perm

// RUNDE K14: die VFS-Schicht und die fremden Dateisysteme. `vfs` zieht
// `mnt`, `vfsops`, `ofs`, `procfs`, `devfs` und `fat` mit herein --
// alles, was diese Runde an den Kernel haengt, haengt an dieser einen
// Zeile.
import vfs
import mnt
import vfsops
import part
import devfs
import ftype
// RUNDE K17: der USB-Baum -- Regler, Kern, Klassen.
import xhci
import usb
import hidrep
import hidin
import i2chid

// Indices in the table out of isr.s.
const V_DF_STACK: u64 = 52
const V_IRQ_STACK: u64 = 53

// The bits of the command line, see `mode_of` at the bottom.
// Round K1. The two of them live in `kstate.fi`, because `sys.fi` and
// `elf.fi` read them too; the names are repeated here so that this file
// reads like the rest of the list.
// Die Capability-Runde: Handles statt Umgebungsautoritaet
// (`kernel/cap.fi`, portiert aus OrientOS). Ein eigenes Wort auf der
// Kommandozeile, damit KEIN bestehender Testlauf sich aendert -- die
// Runden 59 bis K6 messen weiter genau das, was sie gemessen haben.
// ROUND K9, dieselben Werte wie in `kstate.fi`.

// The programs in uprog.fi.
const P_HELLO: u64 = 1
const P_MEMORY: u64 = 2
const P_FAULT: u64 = 3
const P_BADPTR: u64 = 4
const P_CHILD: u64 = 5
const P_PARENT: u64 = 6
const P_SHELL: u64 = 8
const P_STEAL: u64 = 9
const P_FORK: u64 = 10
const P_CAPS: u64 = 12
// MESSUNG RUNDE HANDLE: die Syscall-Latenz aus Ring 3.
const P_HBENCH: u64 = 49
// RUNDE HANDLE: der Selbsttest der Handle-Schicht in Ring 3.
const P_HANDLE: u64 = 48
// RUNDE ASYNC: der Selbsttest der Auftragsschicht und ihre Messung.
const P_ASYNC: u64 = 50
const P_ABENCH: u64 = 51
const P_ASYNCFS: u64 = 52
const P_VEC: u64 = 53 // RUNDE AVX
// RUNDE K13: die beiden Programmnummern dieser Runde (kernel/uprog.fi).
const P_PWR: u64 = 45
const P_PWRIDLE: u64 = 46
const P_PWRLOAD: u64 = 47
const P_USER: u64 = 16
const P_ZOMBIE: u64 = 17
const P_HV: u64 = 15 // RUNDE K12: die Gastmaschine aus Ring 3 (14 nahm K10s Fenster)

const DISK_FRAMES: u64 = 256 // 1 MiB of RAM disk

// ROUND K6: the drive the userland lies on is not the RAM disk. Twenty
// three programs of round K6 built by firnc1 are over a megabyte, and
// the block bitmap of OFS is ONE block -- 4096 bits, and therefore 4096
// blocks, and therefore two megabytes. That is the ceiling of this file
// system and this is the number that names it.
const OSUM_BLOCKS: u64 = 4096
const DISK_BLOCKS: u64 = 2048
// ROUNDE K14: die zweite Platte. Die Zahl gibt der Wirt vor -- ATA PIO
// sagt von sich aus nicht, wie gross ein Laufwerk ist, und ein
// IDENTIFY dafuer waere ein zweites Protokoll fuer eine Zahl, die
// `tools/k14/run.sh` ohnehin kennt (es baut das Abbild). 80 MiB.
const DISK2_BLOCKS: u64 = 163840

const ADDR_MASK: u64 = 0x000FFFFFFFFFF000

const TICKS_WANTED: u64 = 20 // 200 ms at 100 Hz
const KEYS_WANTED: u64 = 4
const KEY_TIMEOUT: u64 = 250 // 2.5 s, then it goes on regardless

// `KERNEL_MAIN` out of boot.s. Six arguments, System V, see boot.s.
// ==================================================================
// RUNDE OFS3: DIE GROESSE DER WURZELPLATTE, GEFRAGT STATT GERATEN
// ==================================================================

fn kernel_main(mbi: u64, vectors: u64, state: u64, kernel_end: u64,
    gdt: u64, tss: u64) {
    var s_banner: [u8; 32] = "firn kernel r62, profile kernel\0"
    var s_mb: [u8; 11] = "mb: flags=\0"
    var s_cmd: [u8; 8] = "  cmd=\0\0"
    var s_none: [u8; 7] = "(none)\0"
    var s_idt: [u8; 6] = "idt: \0"
    var s_gates: [u8; 21] = " gates, vector 8 IST\0"
    var s_pic: [u8; 30] = "pic: master 0x20, slave 0x28\0\0"
    var s_pit: [u8; 6] = "pit: \0"
    var s_hz: [u8; 20] = " Hz, divisor \0\0\0\0\0\0\0"
    var s_done: [u8; 13] = "kernel: done\0"

    serial.init()
    // ============ RUNDE KABEL: SITZT DA UEBERHAUPT EIN BAUSTEIN?
    //
    // Die allererste Frage, noch vor der ersten Zeile Text -- denn wenn
    // hier nichts sitzt, wartet JEDES Oktett danach vergeblich. Der
    // Test schreibt ins Notizregister und liest zurueck; der rohe LSR
    // wird mitgenommen und steht spaeter auf der Messtafel.
    let _uart: bool = serial.probe()
    // RUNDE FASSUNG: DIE ERSTE ZEILE SAGT, WELCHE FASSUNG DAS IST.
    // Sie steht vor dem Banner und vor allem anderen, damit sie auch
    // auf einem Foto der ersten Bildschirmseite noch drauf ist.
    serial.puts(fassung.text())
    serial.nl()
    serial.puts((&s_banner[0]) as u64)
    serial.nl()

    kstate.set(state, kstate.VECTORS, vectors)
    kstate.set(state, kstate.GDT, gdt)
    kstate.set(state, kstate.TSS, tss)
    kstate.set(state, kstate.KERNEL_END, kernel_end)

    let cmd: u64 = mem.cmdline(mbi)
    mode_of(state, cmd)
    // ROUND K2: read here and not down in `hw.stage`, and the reason is
    // worth knowing -- the command line of the boot loader lies ABOVE
    // `kernel_end`, and the frame allocator hands exactly those frames
    // out. The first heap of the run stands on it. See docs/OSUM-K2.md.
    hw.parse(state, cmd)
    // RUNDE NETVIEW, ZWEITER NACHTRAG: die systemweite Voreinstellung
    // aus derselben Befehlszeile, EINMAL hierher gestellt. Sie steht
    // nicht in `netsvc.stage`, weil die Stufe ohne das Wort `nic` sofort
    // zurueckkehrt -- und eine Maschine ohne Karte ist genau der Fall,
    // fuer den `when-offline` gebaut ist.
    netview.fallback_set(state, hw.net_fallback(state))
    smp.parse(state, cmd)
    gfx.parse(state, cmd)
    // RUNDE SERVERBUILD: `console=ttyS0`. HIER und nicht spaeter --
    // `hw.stage` traegt den Vektor der Leitung nur ein, wenn das
    // Modusbit schon steht, und `serial.put` holt sich den Torwert bei
    // jedem Oktett aus derselben Zelle.
    sercon.parse(state, cmd)
    // ROUNDE K10: die Schutzbits und das Boot-Modul lesen ihr eigenes
    // Wort, so wie `fb` es seit K7 tut. Die Informationsstruktur wird
    // hier aufgehoben, weil sie spaeter noch gebraucht wird und
    // `kernel_main` sie nur als Argument hat.
    kstate.set(state, kstate.MBI, mbi)
    guard.parse(state, cmd)
    // RUNDE AVX: die Vektorregister lesen ihr eigenes Wort, so wie
    // `guard` seit K10. nofpu / nofpuswitch / fpulazy / noxsave / noavx.
    fpu.parse(state, cmd)
    bootmod.parse(state, cmd)
    hv.parse(state, cmd)
    // ROUND NETMON: the accounting is on from the first instruction, so
    // that a frame sent during the boot is counted like every other. Its
    // own mode word, out of the same command line -- `kstate.MODE` has
    // two bits left and four rounds are running beside this one.
    netmon.parse(state, cmd)
    pmon.parse(state, cmd)

    // ROUND K9. Die Uhr wird gelesen, BEVOR irgendetwas anderes Zeit
    // braucht: TIME_BOOT und TIME_TSC0 muessen aus demselben Augenblick
    // stammen, sonst ist der Fehler fuer immer eingebaut. Der Sammler des
    // Zufallsgenerators faengt hier an -- von hier bis zum ersten
    // `getrandom` ruehrt jeder Zeitgeber- und Tastaturschlag ein.
    time.init(state)
    rand.init(state)
    if kstate.mode_on(state, kstate.M_FIXRAND) {
        rand.fixed_set(state, 1)
    }
    // ROUND K9. DIE TERMINALSCHICHT, und sie steht vor `file.init`:
    // Deskriptor 0, 1 und 2 sind von hier an Enden eines Terminals, und
    // ein Terminal, das es beim ersten `write` noch nicht gibt, waere
    // eine stille Konsole.
    tty.init(state)
    // Und unmittelbar danach der Rueckweg: die Zeilendisziplin steht,
    // also darf ein Oktett von der Leitung kommen. Frueher haette
    // `tty.push` kein Terminal, in das es koennte.
    sercon.init(state)
    console_load(state, cmd)
    // ROUND K4: the three console descriptors of the system. They exist
    // before the first task does, they belong to no process, and every
    // process is handed them at its creation (`proc.create_bare`).
    file.init(state)
    // RUNDE K16: die Tabelle "Dateiart -> womit oeffnen". Sie steht vor
    // dem ersten Programmstart, weil `execve` seit dieser Runde `#!`
    // versteht und ein Doppelklick von Runde K15 auf sie zugreift.
    ftype.init(state)
    // RUNDE K15, zweiter Nachtrag: DAS AENDERUNGSJOURNAL, und es steht
    // HIER. `fs.dir_add` schreibt hinein, und das erste `mkdir` dieses
    // Laufes passiert lange vor `wig.init` -- ein Journal, das erst mit
    // der Oberflaeche entsteht, hat die halbe Wurzel schon verpasst.
    nidx.init(state)
    serial.puts((&s_mb[0]) as u64)
    serial.hex(kstate.get32(mbi))
    serial.puts((&s_cmd[0]) as u64)
    if cmd == 0 {
        serial.puts((&s_none[0]) as u64)
    } else {
        serial.puts(cmd)
    }
    serial.nl()

    // 1. descriptor tables. The TSS first: the IDT points into it with
    //    IST1, and `ltr` after `lidt` would be a window in which a #DF
    //    has no stack.
    idt.tss_install(gdt, tss, at(vectors, V_IRQ_STACK), at(vectors, V_DF_STACK))
    let gates: u64 = idt.build(state, vectors)
    serial.puts((&s_idt[0]) as u64)
    serial.dec(gates)
    serial.puts((&s_gates[0]) as u64)
    serial.nl()

    // 2. the interrupt controllers and the timer.
    idt.pic_remap()
    idt.pic_mask(0xFC as u8, 0xFF as u8) // only IRQ0 and IRQ1
    serial.puts((&s_pic[0]) as u64)
    serial.nl()
    let divisor: u64 = idt.pit_init(100)
    serial.puts((&s_pit[0]) as u64)
    serial.dec(100)
    serial.puts((&s_hz[0]) as u64)
    serial.dec(divisor)
    serial.nl()

    // 3. memory.
    memory(state, mbi, kernel_end)

    // 3a-null. RUNDE HID: DER ZERLEGER, SO FRUEH WIE MOEGLICH.
    // Er rechnet ausschliesslich auf `kdata` und haengt an keinem Bus:
    // kein xHCI, kein I2C, kein Zeitgeber, kein Scheduler. Deshalb
    // steht er HIER und nicht bei den Geraeten -- ein Fehler im
    // Zerleger ist dann von einem Fehler im Regler unterscheidbar, und
    // der Selbsttest laeuft auf einer Maschine, die sonst gar nichts
    // hat. Ohne `hidrep` ist das eine Verzweigung und sonst nichts.
    hid_stage(state)

    // 3a0. ROUNDE K10: was der Lader danebengelegt hat, und ob es heil
    //      angekommen ist. Muss NACH `memory` stehen -- vorher gibt es
    //      keinen Rahmenverwalter, der den Bereich haette reservieren
    //      koennen -- und VOR allem, was Rahmen anfordert.
    bootmod.stage(state, mbi)

    // 3a. ROUND K2: the bus is read and the interrupts move from the two
    //     8259s to the APIC -- before the first `sti`, because a
    //     controller must not be swapped while it is delivering. See
    //     `hw.fi`, `pci.fi`, `apic.fi`.
    hw.stage(state)

    // 3b2. RUNDE BLECHVIER: DIE BLECH-DIAGNOSE.
    //
    //      Hier und nicht frueher: `blech_stage` braucht die
    //      Fensterplaetze von `apic.map_device` (fuer die IOMMU-
    //      Register), und die richtet `hw.stage` gerade ein. Und hier
    //      und nicht spaeter: die GPE-Bits werden abgeschaltet, BEVOR
    //      irgendein Geraet den SCI ziehen kann.
    hw.blech_stage(state)

    // 3c. ROUNDE K7: DER BILDSCHIRM. Hier und nicht frueher, weil der
    //     Rahmenpuffer oberhalb des abgebildeten Gigabytes liegt und die
    //     Fensterplaetze dafuer aus derselben Liste kommen wie die des
    //     APIC (`apic.map_device`) -- und weil der Zweitpuffer aus dem
    //     Rahmenverwalter kommt, den Abschnitt 3 gerade erst aufgebaut
    //     hat. Ohne das Wort `gfx` kehrt das hier sofort zurueck.
    gfx.stage_graphics(state, mbi)

    // 3c-bis. RUNDE USBIMG: DIE HARDWARE-DIAGNOSE. Hier und an keiner
    //     anderen Stelle, und dafuer gibt es drei Gruende:
    //
    //       * der Bus ist gelesen (`hw.stage`, eine Zeile hoeher), also
    //         gibt es eine Geraeteliste, ueber die zu berichten waere;
    //       * der Bildschirm steht und `fb.set_echo` ist an, also geht
    //         jede Zeile von hier an AUCH auf den Schirm -- genau das
    //         verlangt Punkt 4 der Runde;
    //       * und es ist VOR jeder Stufe, die ein Geraet wirklich
    //         hochzieht. Haengt `netsvc.stage` an einer fremden Karte
    //         oder `hw.disk` an einem Controller, den dieser Kern nicht
    //         kennt, dann steht der Bericht, aus dem hervorgeht WARUM,
    //         zu diesem Zeitpunkt schon vollstaendig auf dem Schirm.
    //         Eine Diagnose, die man erst nach dem Aufhaengen lesen
    //         koennte, waere keine.
    //
    //     Ohne das Wort `hwdiag` ist das hier ein Zeichenkettenvergleich
    //     und sonst nichts.
    //     UND ES LIEST `hw.cmd_copy` UND NICHT `cmd`. Das ist kein
    //     Schoenheitsfehler, sondern die Falle, vor der der Kommentar bei
    //     `hw.parse` dreissig Zeilen weiter oben warnt: die Zeichenkette
    //     des Laders liegt OBERHALB von `kernel_end`, und genau diese
    //     Rahmen gibt der Verwalter als erstes aus. Beim ersten Versuch
    //     stand in `cmd` an dieser Stelle 0x560000 -- der Anfang des
    //     Haldenblocks, der inzwischen darauf steht. `hw.parse` hat die
    //     Zeile in dem einen Augenblick kopiert, in dem sie noch lesbar
    //     war; diese Kopie ueberlebt den ganzen Lauf.
    hwdiag.stage(state, hw.cmd_copy(state))

    // 3c-ter. RUNDE BLECH, NACHTRAG: DIE PLATTENTABELLE, OHNE PLATTE.
    //     Dasselbe, was `nictab` fuer Netz tut -- und aus demselben
    //     Grund: dieses Verzeichnis hat keinen Controller im RAID-Modus
    //     und keinen SD-Leser, aber die WAHL laesst sich trotzdem
    //     pruefen. Ohne die Worte ist das hier ein Vergleich zweier
    //     Bits.
    if kstate.mode_on(state, kstate.M_BLKTAB) {
        blkdev.print_table(state)
    }

    // 3b. the task table. From here on there is a scheduler -- it does
    //     not switch anything yet, because there is only one task, but
    //     the timer already counts its ticks against it.
    kstate.set(state, kstate.KPML4,
        asm("mov rax, cr3", out("rax")) & ADDR_MASK)
    // RUNDE AVX: CR0/CR4/XCR0, UND ZWAR VOR `sched.init`.
    //
    // Bis zu dieser Runde stand in CR4 nur PAE (0x20) plus SMEP/SMAP --
    // kein OSFXSR, kein OSXSAVE. Damit war JEDE SSE-Anweisung auf dieser
    // Maschine ein #UD, und `/bin/fetch` starb unter `-cpu max` an der
    // SHA-NI-Fassung von SHA-256, die Firns Bibliothek dort waehlt.
    //
    // Die Zeile steht HIER und nicht neben `guard.apply`, weil
    // `sched.init` und das erste `sched.create` schon Vektorbereiche
    // anfordern -- `fpu.area_new` antwortet 0, solange nicht
    // freigeschaltet ist, und Aufgabe 0 haette dann keinen.
    fpu.apply(state)
    sched.init(state)
    let idle: u64 = sched.create(state, sched.K_IDLE, 1, 0, 0)
    sched.start(state, idle)
    sched.set_idle(state, idle)
    // `syscall`/`sysret` need their four MSRs before the first process,
    // not only before the excursion of round 59. Without EFER.SCE the
    // `sysretq` of `enter_user_task` is an invalid opcode.
    user.setup(state)
    // ROUNDE K10: SMEP und SMAP, und zwar hier -- direkt hinter den
    // vier Modellregistern und VOR der ersten Seite mit Benutzerbit.
    // Ein Schutzbit, das erst nach dem ersten unprivilegierten
    // Programm gesetzt wird, hat genau dieses eine nicht geschuetzt.
    guard.apply(state)
    guard.report(state)
    // RUNDE AVX: der Bericht steht HIER und die Freischaltung weiter
    // oben -- so steht in der Zeile das VOLLSTAENDIGE CR4, mit SMEP
    // und SMAP darin.
    fpu.report(state)
    proc.map_programs(state)
    // Die beiden Gegenproben. Sie tun nichts, solange die
    // Kommandozeile sie nicht ausdruecklich verlangt -- und wenn sie
    // etwas tun, endet der Lauf hier im Trap-Melder. Genau das ist
    // der Nachweis.
    guard.raw_read(state)
    guard.raw_exec(state)

    // 4. a deliberate fault, when the command line asks for one. Comes
    //    back only if the IDT is broken -- `trap.report` stops.
    provoke(state)

    // 5. interrupts on, and the proof that they arrive.
    ticks(state)

    // 5a. ROUND K9. Erst jetzt laesst sich der Zyklenzaehler eichen: es
    //     gibt einen Zeitgeber, von dem nachgewiesen ist, dass er
    //     schlaegt. Vorher gaebe es nichts, wogegen zu messen waere.
    clock(state)

    // 6. three tasks at the same time.
    scheduler(state)

    // 7. the keyboard.
    keyboard(state)

    // 7b. processes with an address space of their own.
    processes(state)
    capabilities(state)
    // 7b-quater. RUNDE HANDLE: die Lebensdauerrechnung. Hier und nicht
    //     spaeter, aus demselben Grund wie K13 eine Zeile weiter unten:
    //     sie braucht KEIN Dateisystem. Der Selbsttest arbeitet auf
    //     einer Roehre, und eine Roehre gibt es immer.
    handles(state)
    // Der Benchmark steht ABSICHTLICH ausserhalb von `handles`: mit
    // `handle` laufen die Zaehler mit, und dann misst er den Selbsttest
    // und nicht den Regelbetrieb. `hbench` allein ist die Messung, die
    // gilt.
    handle_bench(state)
    // 7b-quinquies. RUNDE ASYNC: die asynchrone Auftragsschicht. Hier
    //     und direkt hinter HANDLE, weil sie auf ihr steht und aus
    //     demselben Grund kein Dateisystem braucht -- gearbeitet wird
    //     auf Roehren. Die Arbeitsfaeden entstehen bei der ersten
    //     Abgabe; ohne das Wort `async` bleibt der Kernel Aufgabe fuer
    //     Aufgabe derselbe wie vorher.
    asyncs(state)
    async_bench(state)
    // 7b-sexies. RUNDE AVX: die Gegenprobe zum Kontextwechsel. Hier und
    //     nicht spaeter, weil sie kein Dateisystem braucht -- vier
    //     Prozesse, ihre Vektorregister und sonst nichts.
    vectors(state)
    // RUNDE MERGE-5: HIER wird angehalten, wenn `hwdiagstop` auf der
    // Kommandozeile steht -- nicht mehr oben in `hwdiag.stage`. So
    // stehen auf dem Schirm eines Rechners OHNE serielles Kabel auch
    // `guard: cr4=`, `fpu: mode=` und (mit dem Wort `vecproc`) die
    // Zeilen der Vektorprobe, bevor der Bildschirm einfriert. Der
    // Bericht selbst wird unveraendert weiter oben gedruckt.
    hwdiag.park_if_asked(state, hw.cmd_copy(state))
    // 7b-bis. RUNDE K13: Kennungen aus Ring 3, ohne Platte. Hier und
    //     nicht spaeter, weil es KEIN Dateisystem braucht -- die Zusagen
    //     ueber uid/gid gelten auch in einem Lauf `nofs`, und ein Test,
    //     der ohne Platte auskommt, kann sich nicht an ihr vertun.
    //     Ohne das Wort `k13` eine Zeile und sonst nichts.
    users(state)

    // 7b-ter. RUNDE K18: DIE ENERGIESCHICHT UND IHRE MESSUNG.
    //     Hier und nicht weiter unten, und der Grund ist derselbe wie
    //     eine Zeile darueber bei K13: das hier braucht KEIN
    //     Dateisystem, keine Platte und keinen zweiten Prozessor. Die
    //     ACPI-Tabellen findet `acpi.table_count` selbst, wenn `find`
    //     noch nicht gelaufen ist -- genau dafuer hat Runde K13 den
    //     nachtraeglichen RSDP-Suchlauf in `acpi.table` eingebaut.
    //
    //     IN DER ERSTEN FASSUNG STAND ES HINTER `smp.stage`, und dort
    //     kam das Messprogramm aus seinem `nanosleep` nicht zurueck:
    //     `smp.stage` laesst die Rechenaufgaben seiner eigenen Messung
    //     laufen, und der Schlaefer wartete hinter ihnen, bis die Frist
    //     von `wait_for` abgelaufen war. Zwanzig Sekunden, Ausgang -2,
    //     und keine einzige Zahl. Weiter oben ist das Bild ruhig.
    power_stage(state)
    power_test(state)

    // 7c. the file system.
    filesystem(state)
    // 7c-bis. RUNDE ASYNC, zweiter Teil: die Arten, die ein
    //     DATEISYSTEM brauchen -- asynchron oeffnen, lesen, auf den
    //     Traeger druecken, schliessen. Sie stehen hier und nicht oben
    //     bei `asyncs`, weil es vor dieser Zeile keine Datei gibt, die
    //     man oeffnen koennte.
    asyncs_fs(state)

    // 7d. a command line in ring 3.
    shell(state)

    // 7e. the same file system on a real disk.
    ata_disk(state)

    // 7e-bis. ROUND K8: the network card, the TCP/IP stack of round K3
    //     on top of it, and the task that moves frames between the two.
    //     Deliberately BEFORE `osum`: the shell that starts down there
    //     runs `/bin/ping` and `/bin/wget`, and both need a wire.
    //     Without `nic` on the command line this is one printed line and
    //     nothing else -- every measurement of rounds 59 to K6 sees the
    //     kernel it saw before.
    netsvc.stage(state)

    // 7e-ter. RUNDE K17: DER USB-BAUM. Hier und nicht spaeter, aus drei
    //     Gruenden: der Bus muss gelesen sein (`hw.stage`, Runde K2),
    //     die Meldungen muessen ankommen koennen (der APIC steht seit
    //     derselben Runde), und alles darunter braucht ihn -- die Shell,
    //     die gleich in `osum` startet, liest von einer Tastatur, und
    //     der Stick, den sie einhaengen soll, muss vorher ein
    //     Blockgeraet sein. Ohne das Wort `usb` ist das hier EINE
    //     gedruckte Zeile und sonst nichts.
    usb_stage(state)
    // RUNDE HID: HID UEBER I2C. Hier und nicht bei `hid_stage` -- die
    // Suche nach dem Regler braucht den PCI-Baum aus `hw.stage`, und
    // ACPI muss gelesen sein. Ohne `i2chid` ist das eine Verzweigung.
    i2chid.stage(state)

    // 7e-quater. RUNDE BLECH: DER USB-2.0-REGLER. Hinter `usb_stage`
    //     und nicht davor: auf einem Chipsatz mit beiden Reglern soll
    //     der xHCI zuerst greifen, weil er der bessere Weg ist -- der
    //     EHCI ist der Rueckfall fuer Bretter, die keinen haben. Ohne
    //     das Wort `ehci` ist das hier eine gedruckte Zeile.
    ehci.stage(state)
    // RUNDE BLECH-HID: HIER haelt der Diagnose-Eintrag an, wenn
    // `usbstop` auf der Kommandozeile steht. Der USB-Bericht ist damit
    // das LETZTE auf dem Schirm -- ein Foto davon beantwortet die
    // Frage, warum keine Eingabe ankommt.
    hwdiag.park_after_usb(state)
    if kstate.mode_on(state, kstate.M_EHCITEST) {
        // Der Stick: drei Bloecke, und ihre Oktettsummen haelt der WIRT
        // gegen dasselbe Abbild, aus dem QEMU liest. "Der Treiber
        // meldet Erfolg" ist keine Messung.
        ehci.selftest(state, 0)
        ehci.selftest(state, 1)
        ehci.selftest(state, 64)
        // Die Tastatur: ein Fenster, in dem der Wirt ueber den Monitor
        // Tasten schickt. Der Unterbrechungsendpunkt hat keinen eigenen
        // Vektor (siehe ehci.fi), also wird abgefragt -- und die
        // Schleife steht HIER und nicht in `ehci.fi`, damit dieser
        // Treiber den Ablaufplaner nicht einbinden muss.
        var eh_i: u64 = 0
        while eh_i < 900 {
            ehci.poll(state)
            sched.sleep_ticks(state, 1)
            eh_i = eh_i + 1
        }
        ehci.report(state)
    }

    // 7e-ter. RUNDE TRESOR: DIE GERAETEIDENTITAET (`kernel/hwid.fi`).
    //     Hier und nicht frueher, weil die MAC-Adresse erst existiert,
    //     wenn `netsvc.stage` die Karte hochgezogen hat -- und nicht
    //     spaeter, weil `osum(state)` gleich darunter die Shell startet
    //     und ein Programm in Ring 3 die Werte schon lesen koennen soll.
    //     Was hier NOCH nicht dasteht, ist die Seriennummer des
    //     NVMe-Laufwerks: die kommt aus `hw.disk`, und das laeuft eine
    //     Stufe TIEFER. Dafuer holt `hwid.refresh` beim Lesen nach.
    hwid.stage(state)

    // 7e-quater. RUNDE MODUL: EIN TREIBER, DER NICHT IM KERN STEHT.
    //     HIER und nicht spaeter, und der Grund ist der Zeitpunkt: der
    //     Bus ist gelesen, der Zeitgeber schlaegt, der APIC steht, und
    //     `osum` eine Zeile weiter unten startet die Shell und kehrt
    //     erst zurueck, wenn sie fertig ist. Ein Treiber, den ein
    //     Programm in Ring 3 benutzen soll, muss VOR diesem Programm da
    //     sein. Ohne das Wort `modul` ist das hier EINE gedruckte Zeile
    //     und sonst nichts.
    moduls(state)

    // 7f. round K1: a system on that disk. Mount what the host built,
    //     load /bin/sh out of it, and let it run until it is done.
    osum(state)
    // 7g. ROUND K2: and once more one layer lower, on a controller that
    //     fetches its own commands out of memory (`hw.disk`).
    hw.disk(state)

    // RUNDE TRESOR: JETZT ist die Geraeteidentitaet vollstaendig -- die
    // Seriennummer des Laufwerks gibt es erst, seit `hw.disk` den
    // Controller aufgesetzt hat. Hier wird nachgeholt und gemeldet.
    hwid.late(state)

    // 7h. ROUND K5: the other processors. Deliberately here and not
    //     earlier: everything above this line is what rounds 59 to K2
    //     measured, and it measures it on ONE core, exactly as before.
    //     Under `-smp 1` this stage finds one processor and the whole
    //     kernel behaves as it did; under `-smp 4` it starts the other
    //     three and hands them work.
    smp.stage(state)
    // RUNDE AVX, ZWEITER DURCHGANG: dieselben vier Prozesse NOCH EINMAL,
    // jetzt aber mit allen Kernen oben. Der erste Durchgang oben lief
    // auf einem Prozessor -- er misst, dass der Wechsel sichert; dieser
    // hier misst zusaetzlich, dass eine Aufgabe, die von einem Kern auf
    // einen anderen wandert, ihre Register mitnimmt. Ohne
    // `fpu.apply_here` in `smp.ap_main` waere das nicht einmal
    // fehlerhaft, sondern toedlich: der erste `movdqu` auf einem Kern
    // ohne CR4.OSFXSR ist ein #UD.
    vectors_smp(state)
    ring3_smp(state)
    fpu_bench(state)


    // 7i. RUNDE K12: ein Wirt fuer fremde Betriebssysteme. Hier und
    //     nicht frueher, aus drei Gruenden: der Rahmenverwalter muss
    //     stehen (eine Gastmaschine will Rahmen), der Zeitgeber muss
    //     schlagen (er ist der Notausgang aus einem Gast, der den
    //     Prozessor nicht hergibt), und alles oberhalb dieser Zeile ist
    //     das, was die Runden 59 bis K9 gemessen haben -- ohne das Wort
    //     `hv` ist das hier EINE gedruckte Zeile und sonst nichts.
    hv.stage(state)
    hv_ring3(state)

    // 8. ring 3, the excursion of round 59.
    ring3(state)

    // 8b. ROUNDE K10: DIE OBERFLAECHE. Zeigegeraet, Schriftleser und
    //     Fensterserver -- und darauf zwei Anwendungen. Hier und nicht
    //     frueher, weil alles davon steht: der Bildschirm aus K7, das
    //     Terminal aus K9, die Handles aus K6 und das Dateisystem, aus
    //     dem die Schriften kommen. Ohne das Wort `wm` kehrt das sofort
    //     zurueck und keine Messung der Runden 52 bis K9 aendert sich.
    gfx.stage_surface(state)

    // 9. ROUNDE K7: stillhalten, damit ein Bildschirmfoto entstehen
    //    kann. Ohne `fbhold` ist das ein Nichts.
    gfx.stage_hold(state)

    // ROUNDE K10: was die Schutzbits am Ende des Laufs zu berichten
    // haben -- wie viele weitere Prozessoren sie tragen und wie oft das
    // SMAP-Fenster wirklich geoeffnet wurde. Eine Zusage "SMAP ist an"
    // ohne eine einzige Fensteroeffnung waere ein Kernel, der
    // Ring-3-Speicher nie anfasst.
    guard.report_aps(state)
    fpu.report_aps(state)
    // ...und ob das Boot-Modul den ganzen Lauf unversehrt ueberstanden
    // hat. Haette `mem.scan` seinen Bereich nicht reserviert, stuende
    // hier jetzt eine andere Summe.
    bootmod.recheck(state)
    usb.report(state)
    // RUNDE HID: DIE LATENZMESSUNG, GANZ AM ENDE. Sie braucht die
    // kalibrierte Taktzahl aus `time.calibrate` (Stufe 7), und die
    // gibt es weiter oben noch nicht -- der erste Anlauf hat deshalb
    // Zyklen ohne Zeit gemeldet.
    if kstate.mode_on(state, kstate.M_HIDLAT) {
        hidin.stage(state)
        hidin.latenz(state)
    }

    sercon.report(state)
    serial.puts((&s_done[0]) as u64)
    serial.nl()
    power.shutdown(power.EXIT_OK)
}

// ------------------------------------- RUNDE K12: eine Gastmaschine aus Ring 3
//
// Der Kernel hat oben bewiesen, dass er Gaeste fuehren kann. Diese Naht
// beweist etwas anderes und Schwierigeres: dass ein UNPRIVILEGIERTES
// Programm es auch kann -- und zwar genau so weit, wie sein Handle
// reicht. Es laeuft im selben Rahmen wie `capabilities` (Runde K10 der
// Handles): ein eigener Prozess, ein Handle auf die Konsole, und was es
// meldet, meldet es aus Ring 3.
fn hv_ring3(state: u64) {
    var s_exit: [u8; 17] = "hv: ring 3 exit=\0"
    if !hv.on(state, hv.M_HV) {
        return
    }
    if !hv.ready(state) {
        return
    }
    let rechte: u64 = cap.R_WRITE | cap.R_DUPLICATE | cap.R_INSPECT
    let t: u64 = proc.create_cap(state, P_HV, rechte, 2)
    if t == 0 {
        return
    }
    let e: u64 = kutil.wait_for(state, t)
    serial.puts((&s_exit[0]) as u64)
    serial.dec(e)
    serial.nl()
}

// ------------------------------------------------------ ROUNDE K7: Grafik
//
// Was hier passiert und warum es an dieser Stelle steht, steht in
// `kernel/fb.fi`. Hier steht nur die REIHENFOLGE: Zweitpuffer holen,
// Rahmenpuffer entgegennehmen, melden was gefunden wurde, die Zusagen
// des Kernels ueber seinen eigenen Bildschirm zaehlen, die beiden Wege
// (mit und ohne Zweitpuffer) gegeneinander messen -- und ERST DANN den
// Spiegel anschalten. Die Reihenfolge ist nicht beliebig: ein Spiegel,
// der waehrend der Messung mitzeichnet, misst sich selbst.




// ================================================== RUNDE DISPLAY











// ---------------------------------------------------------- Runde K9
//
// Punkt 5a: die Uhr. Der Zyklenzaehler wird gegen den Zeitgeber gehalten,
// und was dabei herauskommt, steht in der Ausgabe -- eine Uhr, die ihre
// eigene Frequenz nicht meldet, kann niemand nachrechnen. Danach wird der
// Zufallsgenerator gesaet und seine ersten sechzehn Oktette gemeldet:
// zwei Laeufe, die dieselben sechzehn melden, haetten denselben Zufall.
fn clock(state: u64) {
    var s_khz: [u8; 12] = "time: tsc=\0\0"
    var s_khzu: [u8; 6] = " kHz\0\0"
    var s_wall: [u8; 8] = "  wall=\0"
    var s_mono: [u8; 9] = "  mono=\0\0"
    var s_ns: [u8; 4] = " ns\0"
    var s_tick: [u8; 20] = "time: no tsc, ticks\0"
    var s_seed: [u8; 13] = "rand: seed=\0\0"
    var s_hw: [u8; 7] = "  hw=\0\0"
    var s_stir: [u8; 9] = "  stirs=\0"
    var s_fix: [u8; 20] = "rand: FIXED (probe)\0"

    let k: u64 = time.calibrate(state)
    rand.seed(state)
    // GEEICHT UND GESAET WIRD IMMER -- GEMELDET NUR AUF VERLANGEN.
    //
    // Die beiden Zeilen unten sind die einzigen im ganzen Kernel, die
    // sich zwischen zwei Laeufen desselben Abbilds UNTERSCHEIDEN MUESSEN:
    // die eine traegt die gemessene Taktfrequenz und die Wandzeit, die
    // andere die ersten sechzehn Oktette des Zufallsstroms. Genau das ist
    // ihr Sinn -- und genau deshalb duerfen sie nicht in einem Lauf
    // stehen, dessen Ausgabe Zeile fuer Zeile mit der eines zweiten
    // Laufes verglichen wird (`tools/osum/run.sh`, Abschnitt 11;
    // `tools/kernel/run.sh`, Abschnitt 17). `tools/unix/run.sh` fragt
    // ausdruecklich danach, und nur dort werden sie gedruckt.
    if !kstate.mode_on(state, kstate.M_UNIX) {
        return
    }
    if k == 0 {
        serial.puts((&s_tick[0]) as u64)
        serial.nl()
    } else {
        serial.puts((&s_khz[0]) as u64)
        serial.dec(k)
        serial.puts((&s_khzu[0]) as u64)
        serial.puts((&s_wall[0]) as u64)
        serial.dec(time.boot_sec(state))
        serial.puts((&s_mono[0]) as u64)
        serial.dec(time.mono_ns(state))
        serial.puts((&s_ns[0]) as u64)
        serial.nl()
    }
    if kstate.mode_on(state, kstate.M_FIXRAND) {
        serial.puts((&s_fix[0]) as u64)
        serial.nl()
    }
    serial.puts((&s_seed[0]) as u64)
    var i: u64 = 0
    while i < 16 {
        serial.hex_width(rand.seed_hex(state, i), 2)
        i = i + 1
    }
    serial.puts((&s_hw[0]) as u64)
    serial.dec(rand.hardware(state))
    serial.puts((&s_stir[0]) as u64)
    serial.dec(kstate.get(state, kstate.RAND_STIRS))
    serial.nl()
}

fn at(vectors: u64, i: u64) -> u64 {
    return __mmio_read64((vectors + i * 8) as *mut u64)
}

// ------------------------------------------------------------- memory

// ROUND MEM: what the stress test measured, one number per line so that
// a runner can read them without knowing anything about prose.
//
// It runs only with `memstress` on the command line. The number of
// frames is HALF of what is free, capped at 200000 -- half, so that a
// machine with 512 MiB still has room to boot afterwards, and capped,
// because taking sixteen million frames on a 64 GiB machine measures
// patience and not the allocator.
fn mem_stress_report(state: u64) {
    if !kstate.mode_on(state, kstate.M_MEMSTRESS) {
        return
    }
    var s_p: [u8; 12] = "memstress: \0"
    var s_want: [u8; 6] = "want=\0"
    var s_got: [u8; 7] = " got=\0\0"
    var s_hi: [u8; 7] = " high=\0"
    var s_bef: [u8; 9] = " before=\0"
    var s_low: [u8; 6] = " low=\0"
    var s_aft: [u8; 9] = " after=\0\0"
    var s_bad: [u8; 6] = " bad=\0"
    var s_seen: [u8; 7] = " seen=\0"
    var s_ok: [u8; 5] = " ok=\0"
    var s_pr: [u8; 15] = "memprobe: at=\0\0"
    var s_prok: [u8; 5] = " ok=\0"

    var want: u64 = mem.frames_free(state) / 2
    if want > 200000 {
        want = 200000
    }
    let good: bool = mem.stress(state, want)
    serial.puts((&s_p[0]) as u64)
    serial.puts((&s_want[0]) as u64)
    serial.dec(want)
    serial.puts((&s_got[0]) as u64)
    serial.dec(kstate.get(state, kstate.STRESS_GOT))
    serial.puts((&s_hi[0]) as u64)
    serial.hex(kstate.get(state, kstate.STRESS_HIGH))
    serial.puts((&s_bef[0]) as u64)
    serial.dec(kstate.get(state, kstate.STRESS_BEFORE))
    serial.puts((&s_low[0]) as u64)
    serial.dec(kstate.get(state, kstate.STRESS_LOW))
    serial.puts((&s_aft[0]) as u64)
    serial.dec(kstate.get(state, kstate.STRESS_AFTER))
    serial.puts((&s_bad[0]) as u64)
    serial.dec(kstate.get(state, kstate.STRESS_BAD))
    serial.puts((&s_seen[0]) as u64)
    serial.dec(kstate.get(state, kstate.STRESS_SEEN))
    serial.puts((&s_ok[0]) as u64)
    serial.dec(kutil.yes(good))
    serial.nl()

    let hi: bool = mem.probe_high(state)
    serial.puts((&s_pr[0]) as u64)
    serial.hex(kstate.get(state, kstate.PROBE_ADDR))
    serial.puts((&s_prok[0]) as u64)
    serial.dec(kutil.yes(hi))
    serial.nl()
}

fn memory(state: u64, mbi: u64, kernel_end: u64) {
    var s_end: [u8; 13] = "kernel end: \0"
    var s_map: [u8; 7] = "mmap: \0"
    var s_entries: [u8; 12] = " entries, \0\0"
    var s_usable: [u8; 18] = " KiB usable, top=\0"
    var s_frames: [u8; 9] = "frames: \0"
    var s_cover: [u8; 12] = " covered, \0\0"
    var s_free: [u8; 6] = " free\0"
    var s_heap: [u8; 7] = "heap: \0"
    var s_size: [u8; 9] = "  size=\0\0"
    var s_ok: [u8; 4] = "ok\0\0"
    var s_bad: [u8; 7] = "FAILED\0"

    serial.puts((&s_end[0]) as u64)
    serial.hex(kernel_end)
    serial.nl()

    let entries: u64 = mem.scan(state, mbi, kernel_end)
    serial.puts((&s_map[0]) as u64)
    serial.dec(entries)
    serial.puts((&s_entries[0]) as u64)
    serial.dec(kstate.get(state, kstate.MEM_USABLE) / 1024)
    serial.puts((&s_usable[0]) as u64)
    serial.hex(kstate.get(state, kstate.MEM_TOP))
    serial.nl()

    serial.puts((&s_frames[0]) as u64)
    serial.dec(kstate.get(state, kstate.BITMAP_FRAMES))
    serial.puts((&s_cover[0]) as u64)
    serial.dec(mem.frames_free(state))
    serial.puts((&s_free[0]) as u64)
    serial.nl()

    // ROUND MEM: the two numbers that used to be constants. They stand
    // on a LINE OF THEIR OWN, because the line above is read by every
    // acceptance since round 59 and must not change by one character.
    var s_bm: [u8; 13] = "mem: bitmap=\0"
    var s_oct: [u8; 17] = " octets  mapped=\0"
    var s_gib: [u8; 11] = " GiB  of \0\0"
    var s_gsee: [u8; 5] = " GiB\0"
    serial.puts((&s_bm[0]) as u64)
    serial.dec(mem.bitmap_octets(state))
    serial.puts((&s_oct[0]) as u64)
    serial.dec(mem.mapped_gib(state))
    serial.puts((&s_gib[0]) as u64)
    serial.dec((kstate.get(state, kstate.MEM_TOP) + 1073741823) / 1073741824)
    serial.puts((&s_gsee[0]) as u64)
    serial.nl()
    mem_stress_report(state)

    // 256 KiB of heap out of 64 frames in a row.
    let heap: u64 = mem.frame_run(state, 64)
    mem.heap_init(state, heap, 64 * mem.FRAME_SIZE)
    serial.puts((&s_heap[0]) as u64)
    serial.hex(heap)
    serial.puts((&s_size[0]) as u64)
    serial.dec(64 * mem.FRAME_SIZE)
    serial.nl()

    var s_ft: [u8; 13] = "frame test: \0"
    var s_ht: [u8; 12] = "heap test: \0"
    if mem.frame_selftest(state) {
        serial.puts((&s_ft[0]) as u64)
        serial.puts((&s_ok[0]) as u64)
    } else {
        serial.puts((&s_ft[0]) as u64)
        serial.puts((&s_bad[0]) as u64)
    }
    serial.nl()
    if mem.heap_selftest(state) {
        serial.puts((&s_ht[0]) as u64)
        serial.puts((&s_ok[0]) as u64)
    } else {
        serial.puts((&s_ht[0]) as u64)
        serial.puts((&s_bad[0]) as u64)
    }
    serial.nl()
}

// ------------------------------------------------------------- the timer

fn ticks(state: u64) {
    var s_wait: [u8; 15] = "ticks: waiting\0"
    var s_got: [u8; 8] = "ticks: \0"
    var s_traps: [u8; 9] = "  traps=\0"
    var s_masked: [u8; 20] = "ticks: timer masked\0"
    var s_spin: [u8; 14] = "spin: ticks=+\0"

    // THE COUNTER-CHECK: with IRQ0 masked the same spin loop has to
    // count exactly zero ticks. Otherwise the number below would prove
    // nothing -- a counter that somebody increments elsewhere counts up
    // as well.
    if kstate.mode_on(state, kstate.M_NOTIMER) {
        // ROUND K2: whichever clock is running gets silenced -- after
        // this round that is not necessarily the PIT.
        hw.timer_off(state)
        idt.enable()
        serial.puts((&s_masked[0]) as u64)
        serial.nl()
        serial.puts((&s_spin[0]) as u64)
        serial.dec(spin(state))
        serial.nl()
        return
    }

    idt.enable()
    serial.puts((&s_wait[0]) as u64)
    serial.nl()
    // ================================ RUNDE BLECHEINGABE: MIT GRENZE.
    //
    // HIER STAND EINE SCHLEIFE OHNE AUSWEG. Kommt keine Marke, dreht sie
    // fuer immer -- und der Rechner steht mit schwarzem Schirm, ohne
    // dass irgendjemand sagen koennte, warum. Dass Justins Brett hier
    // DURCHKOMMT (es erreicht den Schreibtisch), ist damit ein
    // MESSWERT und keine Vermutung: der oertliche Zeitgeber schlaegt
    // beim Start, mit bereits abgeschaltetem alten Regler. Trotzdem
    // gehoert eine Grenze hierher -- ein Kern, der an einer Zeile
    // haengt, kann nicht einmal sagen, an welcher.
    var s_keine: [u8; 30] = "ticks: KEINE MARKE, weiter!!!\0"
    let start: u64 = kstate.get(state, kstate.TICKS)
    let thz: u64 = apic.tsc_hz(state)
    let t0: u64 = apic.tsc()
    var warte: bool = true
    while warte {
        if kstate.get(state, kstate.TICKS) - start >= TICKS_WANTED {
            warte = false
        } else if thz != 0 && apic.tsc() - t0 > thz * 3 {
            warte = false
            serial.puts((&s_keine[0]) as u64)
            serial.nl()
        } else {
            idt.halt()
        }
    }
    serial.puts((&s_got[0]) as u64)
    serial.dec(kstate.get(state, kstate.TICKS))
    serial.puts((&s_traps[0]) as u64)
    serial.dec(kstate.get(state, kstate.TRAPS))
    serial.nl()
    serial.puts((&s_spin[0]) as u64)
    serial.dec(spin(state))
    serial.nl()
}

// A loop of a fixed length, without `hlt`: how many ticks arrive in it.
// The same number in both directions -- with the timer it is greater than
// zero, without it exactly zero.
fn spin(state: u64) -> u64 {
    let before: u64 = kstate.get(state, kstate.TICKS)
    var i: u64 = 0
    while i < 4000000 {
        asm("pause")
        i = i + 1
    }
    return kstate.get(state, kstate.TICKS) - before
}

// ------------------------------------------------------- the scheduler

// The proof of round 62, point 1: three tasks, one processor.
//
// The three workers are identical except for their priority. They are
// started, and the boot task lies down to sleep until all three are
// corpses -- it must not spin, or it would be taking away exactly the
// processor time that is being measured here.
fn scheduler(state: u64) {
    var s_skip: [u8; 16] = "sched: skipped\0\0"
    var s_pre: [u8; 16] = "sched: preempt=\0"
    var s_start: [u8; 16] = "sched: workers \0"
    var s_sw: [u8; 17] = "sched: switches=\0"
    var s_alt: [u8; 16] = "  alternations=\0"
    var s_len: [u8; 12] = "  entries=\0\0"
    var s_trace: [u8; 8] = "trace: \0"
    var s_free: [u8; 20] = "sched: frames_free=\0"
    var s_of: [u8; 7] = " of \0\0\0"
    var s_done: [u8; 13] = "sched: done\0\0"
    var s_sp: [u8; 2] = " \0"

    if kstate.mode_on(state, kstate.M_NOSCHED) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    if kstate.mode_on(state, kstate.M_NOPREEMPT) {
        kstate.set(state, kstate.PREEMPT, 0)
    }
    serial.puts((&s_pre[0]) as u64)
    serial.dec(kstate.get(state, kstate.PREEMPT))
    serial.nl()

    let before: u64 = mem.frames_free(state)
    kstate.set(state, kstate.TRACE_LEN, 0)
    let a: u64 = sched.create(state, sched.K_WORKER, 1, 0, 0)
    let b: u64 = sched.create(state, sched.K_WORKER, 2, 0, 0)
    let c: u64 = sched.create(state, sched.K_WORKER, 3, 0, 0)
    // All three at the same moment: they are supposed to compete, not to
    // get a head start over each other.
    sched.start(state, a)
    sched.start(state, b)
    sched.start(state, c)
    let lo: u64 = sched.tget(state, a, sched.T_PID)
    let hi: u64 = sched.tget(state, c, sched.T_PID)
    serial.puts((&s_start[0]) as u64)
    serial.dec(lo)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(sched.tget(state, b, sched.T_PID))
    serial.puts((&s_sp[0]) as u64)
    serial.dec(hi)
    serial.nl()

    while workers_alive(state) > 0 {
        sched.sleep_ticks(state, 1)
    }

    serial.puts((&s_sw[0]) as u64)
    serial.dec(kstate.get(state, kstate.SWITCHES))
    serial.puts((&s_alt[0]) as u64)
    serial.dec(alternations(state, lo, hi))
    serial.puts((&s_len[0]) as u64)
    serial.dec(kstate.get(state, kstate.TRACE_LEN))
    serial.nl()
    sched.trace_dump(state, (&s_trace[0]) as u64, 60)
    sched.dump_tasks(state)

    // The corpses are cleared away: three kernel stacks of two frames
    // each have to come back, otherwise the kernel leaks memory per task.
    sched.reap(state, a)
    sched.reap(state, b)
    sched.reap(state, c)
    serial.puts((&s_free[0]) as u64)
    serial.dec(mem.frames_free(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(before)
    serial.nl()
    serial.puts((&s_done[0]) as u64)
    serial.nl()
}

// How many workers are still alive.
fn workers_alive(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < kstate.get(state, kstate.TASKS) {
        let st: u64 = sched.tget(state, i, sched.T_STATE)
        if sched.tget(state, i, sched.T_KIND) == sched.K_WORKER {
            if st != sched.S_FREE && st != sched.S_ZOMBIE {
                n = n + 1
            }
        }
        i = i + 1
    }
    return n
}

// How often the processor went from one worker to a DIFFERENT one.
// Everything that is not a worker is left out -- otherwise the boot task
// falling asleep would count as interleaving.
fn alternations(state: u64, lo: u64, hi: u64) -> u64 {
    let len: u64 = kstate.get(state, kstate.TRACE_LEN)
    var prev: u64 = 0
    var n: u64 = 0
    var i: u64 = 0
    while i < len {
        let v: u64 = kstate.get8(state + kstate.TRACE_OFF + i)
        if v >= lo && v <= hi {
            if prev != 0 && v != prev {
                n = n + 1
            }
            prev = v
        }
        i = i + 1
    }
    return n
}

// -------------------------------------------------------- the processes

// Point 2 and point 3 of the round: separate address spaces, and system
// calls that say what went wrong.
fn processes(state: u64) {
    var s_skip: [u8; 15] = "proc: skipped\0\0"
    var s_pages: [u8; 13] = "proc: pages=\0"
    var s_one: [u8; 17] = "proc: hello pid=\0"
    var s_hexit: [u8; 18] = "proc: hello exit=\0"
    var s_exit: [u8; 8] = "  exit=\0"
    var s_frames: [u8; 20] = "proc: frames_free=\0\0"
    var s_of: [u8; 5] = " of \0"
    var s_priv: [u8; 13] = "proc: data \0\0"
    var s_vs: [u8; 5] = " vs \0"
    var s_sep: [u8; 15] = "  separated=\0\0\0"
    var s_kill: [u8; 15] = "proc: killed=\0\0"
    var s_alive: [u8; 14] = "proc: alive=\0\0"
    var s_done: [u8; 12] = "proc: done\0\0"
    var s_fork: [u8; 24] = "proc: fork parent kept \0"

    if kstate.mode_on(state, kstate.M_NOPROC) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    // DIE ZAEHLUNG BEGINNT HINTER `map_programs` UND NICHT DAVOR.
    //
    // Das war bis Runde K18 dasselbe und ist es jetzt nicht mehr.
    // `map_programs` macht die Seiten von `uprog.fi` fuer Ring 3
    // erreichbar, EINMAL fuer den ganzen Lauf, und es nimmt sich dafuer
    // je angefangener 2-MiB-Kachel eine Seitentabelle. Solange `.utext`
    // in EINE Kachel passte, war das die feste Tabelle aus der
    // Datenregion und kostete keinen Rahmen -- der Kommentar bei
    // `proc.map_programs` sagt das seit Runde K6 ausdruecklich voraus:
    // "Solange `.utext` in eine Kachel passt, aendert diese Schleife
    // nichts an dem, was die Runden 59 bis K6 gemessen haben."
    //
    // RUNDE K18 HAT DREI PROGRAMME DAZUGELEGT, und damit reicht `.utext`
    // von 0x1FC000 bis 0x20A000 -- ueber die Kachelgrenze bei 0x200000.
    // Die zweite Kachel bekommt einen eigenen Rahmen, und der wird nie
    // freigegeben, weil er den ganzen Lauf gebraucht wird.
    //
    // Die Zusage, um die es hier geht, heisst "jeder Adressraum ist
    // zurueckgekommen". Ein Rahmen, der absichtlich stehen bleibt, ist
    // kein verlorener Adressraum -- er stand nur bis hierher zufaellig
    // ausserhalb der Messung, weil `.utext` zufaellig in eine Kachel
    // passte. Die Klammer umschliesst jetzt genau das, worueber die
    // Zusage spricht.
    serial.puts((&s_pages[0]) as u64)
    let vorher_map: u64 = mem.frames_free(state)
    serial.dec(proc.map_programs(state))
    serial.nl()
    // EIGENE ZEILE, NICHT ANGEHAENGT. Die erste Fassung schrieb
    // "proc: pages=14  ptframes=1" -- und `tools/caps/run.sh` liest die
    // Seitenzahl mit `sed 's/.*=//'` heraus. `.*` ist GIERIG: aus der
    // laengeren Zeile wurde die 1 statt der 14, und zwei Zusagen einer
    // fremden Runde fielen um. Genau derselbe Fehler steht als Warnung
    // im Kopf von `tools/k15/run.sh`. Wer eine Zeile ergaenzt, die
    // andere lesen, ergaenzt sie nicht -- er schreibt eine neue.
    let kachelrahmen: u64 = vorher_map -% mem.frames_free(state)
    var s_kachel: [u8; 18] = "proc: ptframes=\0\0\0"
    serial.puts((&s_kachel[0]) as u64)
    serial.dec(kachelrahmen)
    serial.nl()
    let before: u64 = mem.frames_free(state)

    // 1. one process: it says who it is, and its exit code is its pid.
    let one: u64 = proc.create(state, P_HELLO, 7, 2)
    serial.puts((&s_one[0]) as u64)
    serial.dec(sched.tget(state, one, sched.T_PID))
    serial.nl()
    let one_exit: u64 = kutil.wait_for(state, one)
    serial.puts((&s_hexit[0]) as u64)
    serial.dec(one_exit)
    serial.nl()

    // 2. THE PROOF: two processes, the same address, different frames.
    let a: u64 = proc.create(state, P_MEMORY, 111, 2)
    let b: u64 = proc.create(state, P_MEMORY, 222, 2)
    let pa: u64 = sched.tget(state, a, sched.T_DATA)
    let pb: u64 = sched.tget(state, b, sched.T_DATA)
    let ea: u64 = kutil.wait_for(state, a)
    let eb: u64 = kutil.wait_for(state, b)
    serial.puts((&s_priv[0]) as u64)
    serial.hex(pa)
    serial.puts((&s_vs[0]) as u64)
    serial.hex(pb)
    serial.puts((&s_sep[0]) as u64)
    var sep: u64 = 0
    if pa != pb && ea == 1 && eb == 1 {
        sep = 1
    }
    serial.dec(sep)
    serial.nl()

    // 3. THE COUNTER-CHECK: a process that touches kernel memory dies --
    //    and the kernel does not.
    let f: u64 = proc.create(state, P_FAULT, 0, 2)
    let fe: u64 = kutil.wait_for(state, f)
    let g: u64 = proc.create(state, P_STEAL, 0, 2)
    let ge: u64 = kutil.wait_for(state, g)
    serial.puts((&s_kill[0]) as u64)
    serial.dec(kstate.get(state, kstate.KILLED))
    serial.puts((&s_exit[0]) as u64)
    serial.dec(fe)
    serial.puts((&s_exit[0]) as u64)
    serial.dec(ge)
    serial.nl()

    // 4. system calls with bad arguments: error codes, not silence.
    let p4: u64 = proc.create(state, P_BADPTR, 0, 2)
    kutil.wait_for(state, p4)

    // 4b. the fork-like half of spawn: the child inherits the memory of
    //     its parent -- and gets a frame of its own for it.
    let pf: u64 = proc.create(state, P_FORK, 0, 2)
    let ef: u64 = kutil.wait_for(state, pf)
    serial.puts((&s_fork[0]) as u64)
    serial.dec(ef)
    serial.nl()

    // 5. spawn and wait, seen from ring 3.
    let p5: u64 = proc.create(state, P_PARENT, 0, 2)
    let e5: u64 = kutil.wait_for(state, p5)
    serial.puts((&s_alive[0]) as u64)
    serial.dec(sched.alive_count(state))
    serial.puts((&s_exit[0]) as u64)
    serial.dec(e5)
    serial.nl()

    serial.puts((&s_frames[0]) as u64)
    serial.dec(mem.frames_free(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(before)
    serial.nl()
    serial.puts((&s_done[0]) as u64)
    serial.nl()
}

// ------------------------------------------- Capabilities (aus OrientOS)
//
// Die POSIX-Schicht ueber diesem Abschnitt gibt jedem Prozess seine drei
// Deskriptoren, ohne dass jemand sie ihm gibt. Dieser Abschnitt zeigt das
// Gegenteil: eine LEERE Handle-Tabelle, EIN ausdruecklich uebergebenes
// Handle, und ein Programm in Ring 3, das genau so viel darf, wie darin
// steht.
//
// Zwei Dinge misst der Kernel selbst, weil ein Programm sie nicht zeigen
// kann: dass zwei Prozesse fuer DENSELBEN Platz VERSCHIEDENE Handle-Werte
// bekommen (der Wuerfelwert), und dass eine frische Tabelle wirklich leer
// ist. Alles Uebrige misst das Programm jenseits des Schutzwalls.
fn capabilities(state: u64) {
    var s_skip: [u8; 13] = "cap: skipped\0"
    var s_begin: [u8; 32] = "cap: handles instead of ambient\0"
    var s_slot: [u8; 15] = "cap: slot t1=\0\0"
    var s_t2: [u8; 7] = "  t2=\0\0"
    var s_left: [u8; 9] = "  left=\0\0"
    var s_h1: [u8; 12] = "cap: first \0"
    var s_h2: [u8; 10] = "  second \0"
    var s_diff: [u8; 10] = "  differ=\0"
    var s_exit: [u8; 18] = "cap: ring 3 exit=\0"
    var s_done: [u8; 10] = "cap: done\0"

    if !kstate.mode_on(state, kstate.M_CAPS) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_begin[0]) as u64)
    serial.nl()

    // Schreiben, vervielfaeltigen, uebertragen, Auskunft -- und
    // ABSICHTLICH KEIN Leserecht. Genau daran haengt die Zusage, dass ein
    // gueltiges Handle ohne Recht ein anderer Fehler ist als ein
    // gefaelschtes.
    let rechte: u64 = cap.R_WRITE | cap.R_DUPLICATE | cap.R_TRANSFER
        | cap.R_INSPECT

    let t1: u64 = proc.create_cap(state, P_CAPS, rechte, 2)
    let g1: u64 = sched.tget(state, t1, sched.T_WORK)
    let e1: u64 = kutil.wait_for(state, t1)
    // Der erste Lauf hat seine Tabelle absichtlich vollgemacht (die Zusage
    // "eine volle Tabelle sagt Exhausted"). Was hier steht, ist also
    // 16 -- und genau darum ist der ZWEITE Lauf der Beweis: er bekommt
    // denselben Platz in der Aufgabentabelle und zaehlt trotzdem GENAU EIN
    // Handle. Nichts wird geerbt, auch nicht von einem Vorgaenger.
    let left: u64 = cap.used(state, t1)
    serial.puts((&s_exit[0]) as u64)
    serial.dec(e1)
    serial.nl()

    // Derselbe Platz, ein anderer Prozess: der Wuerfelwert der Tabelle
    // macht daraus einen anderen Handle-Wert. Ein abgehoertes Handle aus
    // einem fremden Prozess trifft damit auch dann nichts, wenn dort
    // zufaellig derselbe Platz belegt ist.
    let t2: u64 = proc.create_cap(state, P_CAPS, rechte, 2)
    let g2: u64 = sched.tget(state, t2, sched.T_WORK)
    let e2: u64 = kutil.wait_for(state, t2)
    serial.puts((&s_h1[0]) as u64)
    serial.hex(g1)
    serial.puts((&s_h2[0]) as u64)
    serial.hex(g2)
    serial.puts((&s_diff[0]) as u64)
    var diff: u64 = 0
    if g1 != g2 {
        diff = 1
    }
    serial.dec(diff)
    serial.nl()
    serial.puts((&s_exit[0]) as u64)
    serial.dec(e2)
    serial.nl()
    serial.puts((&s_slot[0]) as u64)
    serial.dec(t1)
    serial.puts((&s_t2[0]) as u64)
    serial.dec(t2)
    serial.puts((&s_left[0]) as u64)
    serial.dec(left)
    serial.nl()

    serial.puts((&s_done[0]) as u64)
    serial.nl()
}


// ==================================================== RUNDE HANDLE
//
// DREI DINGE MISST DIESER ABSCHNITT, UND ZWEI DAVON KANN EIN PROGRAMM
// IN RING 3 NICHT MESSEN.
//
//   1. DER SELBSTTEST IN RING 3 (`uprog.u_handle`, dreissig Zusagen).
//      Rechte-Eskalation, Use-after-close mit Generationszaehler,
//      doppeltes Schliessen, gefaelschte Handles, Abbruch mitten im
//      Auftrag. Sein Beendigungscode ist die Zahl der GEFALLENEN
//      Zusagen -- 0 heisst, alle dreissig standen.
//
//   2. EIN HANDLE AUS EINEM FREMDEN PROZESS. Das kann ein Programm
//      nicht zeigen, weil es den Wert des anderen gar nicht kennt --
//      und genau das ist ja die Zusage. Der Kernel legt deshalb
//      DASSELBE Objekt in ZWEI Aufgabentafeln, vergleicht die beiden
//      Handle-Werte und versucht, den einen im anderen Prozess
//      aufzuloesen. Beides muss scheitern: gleiche Werte gibt es nicht,
//      und ein fremder Wert trifft nichts.
//
//   3. DIE ZAEHLER. Wie oft ueberhaupt gefragt wurde (`H_CHECKS`), wie
//      oft ein Recht fehlte, wie oft etwas veraltet war, wie oft eine
//      Freigabe von einem laufenden Auftrag aufgehalten wurde. Eine
//      Rechtepruefung, die niemand aufruft, ist von einer, die immer ja
//      sagt, sonst nicht zu unterscheiden -- das ist die Lehre aus
//      Runde K13, und sie gilt hier genauso.
fn handles(state: u64) {
    var s_skip: [u8; 16] = "handle: skipped\0"
    var s_begin: [u8; 15] = "handle: begin\0\0"
    var s_exit: [u8; 21] = "handle: ring 3 exit=\0"
    var s_done: [u8; 14] = "handle: done\0\0"
    if !kstate.mode_on(state, kstate.M_HANDLE) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_begin[0]) as u64)
    serial.nl()
    handle_fremd(state)
    handle_uebergabe(state)
    let t: u64 = proc.create(state, P_HANDLE, 0, 2)
    let e: u64 = kutil.wait_for(state, t)
    serial.puts((&s_exit[0]) as u64)
    serial.dec(e)
    serial.nl()
    handle_zahlen(state)
    serial.puts((&s_done[0]) as u64)
    serial.nl()
}

// (d) EIN HANDLE AUS EINEM FREMDEN PROZESS.
//
// Zwei Aufgabentafeln, DASSELBE Objekt, DERSELBE Platz -- und trotzdem
// zwei verschiedene Handle-Werte, weil in die Generation der
// Wuerfelwert der Tafel eingeht und der aus der pid kommt. Ein
// abgehoerter Wert aus einem fremden Prozess trifft damit auch dann
// nichts, wenn dort zufaellig derselbe Platz belegt ist.
//
// Gemessen wird auf zwei Aufgabenplaetzen, die gerade niemand hat (die
// beiden obersten). Das ist eine Messung an der TAFEL und nicht an zwei
// laufenden Prozessen, und das steht hier, damit es niemand fuer mehr
// haelt, als es ist -- der Weg ueber zwei echte Prozesse scheitert
// daran, dass keiner den Handle-Wert des anderen kennt, was ja genau
// die Zusage ist.
fn handle_fremd(state: u64) {
    var s_a: [u8; 14] = "handle: ha=\0\0\0"
    var s_b: [u8; 7] = "  hb=\0\0"
    var s_d: [u8; 11] = "  differ=\0\0"
    var s_x: [u8; 10] = "  cross=\0\0"
    var s_n: [u8; 21] = "  nonce-differ=\0\0\0\0\0\0"
    let a: u64 = kstate.MAX_TASKS - 1
    let b: u64 = kstate.MAX_TASKS - 2
    handle.clear_task(state, a, 4242)
    handle.clear_task(state, b, 4243)
    let o: u64 = handle.obj_get(state, handle.OK_FILE, file.CON_OUT)
    handle.obj_ref(state, o)
    let ha: u64 = handle.insert(state, a, o, handle.R_WRITE)
    let hb: u64 = handle.insert(state, b, o, handle.R_WRITE)
    var differ: u64 = 0
    if ha != hb {
        differ = 1
    }
    // Der Wert aus Prozess a, in Prozess b vorgelegt: er muss NICHTS
    // treffen. `handle.MAX_OBJ` ist das Nein dieser Funktion.
    var cross: u64 = 0
    if handle.resolve(state, b, ha) >= handle.MAX_OBJ {
        cross = 1
    }
    var nd: u64 = 0
    if handle.nonce_of(state, a) != handle.nonce_of(state, b) {
        nd = 1
    }
    serial.puts((&s_a[0]) as u64)
    serial.hex(ha)
    serial.puts((&s_b[0]) as u64)
    serial.hex(hb)
    serial.puts((&s_d[0]) as u64)
    serial.dec(differ)
    serial.puts((&s_x[0]) as u64)
    serial.dec(cross)
    serial.puts((&s_n[0]) as u64)
    serial.dec(nd)
    serial.nl()
    // Aufgeraeumt: die beiden Plaetze zurueck, damit die Objekttafel
    // nach diesem Abschnitt genauso aussieht wie davor.
    handle.clear_task(state, a, 0)
    handle.clear_task(state, b, 0)
}

// DIE AUSDRUECKLICHE UEBERGABE AN EIN KIND, kernelseitig gemessen.
//
// Der Gegenentwurf zu "alles wird vererbt": Aufgabe a gibt EIN Handle
// an Aufgabe b, und verlangt dabei ALLE Rechte. Sie bekommt trotzdem
// nur die Schnittmenge mit dem, was sie selbst hat -- `handle.give`
// kann nicht addieren, und es gibt in `handle.fi` keine Funktion, die
// es koennte.
//
// Zwei Gegenproben stehen daneben, denn ohne sie misst das nichts:
// ein Handle OHNE R_TRANSFER laesst sich gar nicht weitergeben, und
// nach der Uebergabe traegt das Objekt ZWEI Verweise und nicht einen
// -- ein weitergegebenes Handle ist ein zweiter Halter und keine
// Verschiebung.
fn handle_uebergabe(state: u64) {
    var s_p: [u8; 15] = "handle: pass=\0\0"
    var s_s: [u8; 11] = "  shrink=\0\0"
    var s_t: [u8; 15] = "  notransfer=\0\0"
    var s_r: [u8; 9] = "  refs=\0\0"
    let a: u64 = kstate.MAX_TASKS - 1
    let b: u64 = kstate.MAX_TASKS - 2
    handle.clear_task(state, a, 777)
    handle.clear_task(state, b, 778)
    let o: u64 = handle.obj_get(state, handle.OK_FILE, file.CON_OUT)
    // Lesen, schreiben, weitergeben -- und ABSICHTLICH kein R_SEEK.
    let ha: u64 = handle.insert(state, a, o,
        handle.R_READ | handle.R_WRITE | handle.R_TRANSFER)
    // ALLE Rechte verlangt. Was drueben ankommt, ist die Schnittmenge.
    let hb: u64 = handle.give(state, a, b, ha, handle.R_ALL)
    var passt: u64 = 0
    if !handle.is_err(hb) {
        passt = 1
    }
    let rb: u64 = handle.rights_of(state, b, hb)
    var shrink: u64 = 0
    if (rb & handle.R_SEEK) == 0 {
        if (rb & handle.R_WRITE) != 0 {
            shrink = 1
        }
    }
    // Ein Handle ohne R_TRANSFER: der Versuch muss -E_RIGHTS geben.
    let o2: u64 = handle.obj_get(state, handle.OK_FILE, file.CON_IN)
    let hc: u64 = handle.insert(state, a, o2, handle.R_READ)
    var kein: u64 = 0
    if handle.is_err(handle.give(state, a, b, hc, handle.R_ALL)) {
        kein = 1
    }
    let refs: u64 = handle.obj_refs(state, o)
    serial.puts((&s_p[0]) as u64)
    serial.dec(passt)
    serial.puts((&s_s[0]) as u64)
    serial.dec(shrink)
    serial.puts((&s_t[0]) as u64)
    serial.dec(kein)
    serial.puts((&s_r[0]) as u64)
    serial.dec(refs)
    serial.nl()
    handle.clear_task(state, a, 0)
    handle.clear_task(state, b, 0)
}

fn hnum(name: u64, v: u64) {
    var s_p: [u8; 9] = "handle: \0"
    var s_e: [u8; 2] = "=\0"
    serial.puts((&s_p[0]) as u64)
    serial.puts(name)
    serial.puts((&s_e[0]) as u64)
    serial.dec(v)
    serial.nl()
}

fn handle_zahlen(state: u64) {
    var n_ch: [u8; 7] = "checks\0"
    var n_de: [u8; 7] = "denied\0"
    var n_st: [u8; 6] = "stale\0"
    var n_ca: [u8; 8] = "cancels\0"
    var n_de2: [u8; 9] = "deferred\0"
    var n_op: [u8; 7] = "opened\0"
    var n_cl: [u8; 7] = "closed\0"
    var n_pa: [u8; 7] = "passed\0"
    var n_es: [u8; 9] = "escalate\0"
    var n_ob: [u8; 8] = "objects\0"
    var n_fl: [u8; 9] = "inflight\0"
    hnum((&n_ch[0]) as u64, kstate.get(state, kstate.H_CHECKS))
    hnum((&n_de[0]) as u64, kstate.get(state, kstate.H_DENIED))
    hnum((&n_st[0]) as u64, kstate.get(state, kstate.H_STALE))
    hnum((&n_ca[0]) as u64, kstate.get(state, kstate.H_CANCELS))
    hnum((&n_de2[0]) as u64, kstate.get(state, kstate.H_DEFERRED))
    hnum((&n_op[0]) as u64, kstate.get(state, kstate.H_OPENED))
    hnum((&n_cl[0]) as u64, kstate.get(state, kstate.H_CLOSED))
    hnum((&n_pa[0]) as u64, kstate.get(state, kstate.H_PASSED))
    hnum((&n_es[0]) as u64, kstate.get(state, kstate.H_ESCALATE))
    // Die beiden LECK-ZAHLEN. Nach einem Lauf, in dem jeder Prozess
    // ordentlich geendet hat, darf kein Auftrag mehr laufen, und die
    // Objekttafel darf nur noch die drei Konsoleneintraege halten.
    hnum((&n_ob[0]) as u64, handle.objects_used(state))
    hnum((&n_fl[0]) as u64, handle.req_live(state))
}

// ------------------------------------------- der Mikrobenchmark
//
// WAS DIE HANDLE-SCHICHT IM HEISSEN PFAD KOSTET, IN ZYKLEN.
//
// Gemessen wird in Ring 0 und nicht in Ring 3, und der Grund ist, dass
// hier GENAU die Funktion gemessen werden soll, die diese Runde
// eingebaut hat: `file.fd_of` loest einen Deskriptor auf, und seit
// dieser Runde geht das durch `handle.resolve`. Ein Syscall aus Ring 3
// misst zusaetzlich `syscall`/`sysret`, die Adressraumfrage und den
// Zeigerpruefer -- alles Dinge, die diese Runde nicht angefasst hat und
// die den Unterschied nur verduennen wuerden.
//
// BLOECKE UND MEDIAN, nicht Mittelwert: der Zeitgeber unterbricht, und
// ein einzelner Ausreisser von zehntausend Zyklen wuerde einen
// Mittelwert ueber tausend Aufrufe verdoppeln. Gemessen werden 33
// Bloecke zu je 512 Aufrufen; berichtet wird der Median der 33
// Blockmittel.
const HB_BLOCKS: u64 = 33
const HB_ITERS: u64 = 512

fn hb_sort(p: *mut u64, n: u64) {
    var i: u64 = 1
    while i < n {
        let v: u64 = *((p as u64 + i * 8) as *mut u64)
        var j: u64 = i
        var going: bool = true
        while going {
            if j == 0 {
                going = false
            } else {
                let w: u64 = *((p as u64 + (j - 1) * 8) as *mut u64)
                if w <= v {
                    going = false
                } else {
                    *((p as u64 + j * 8) as *mut u64) = w
                    j = j - 1
                }
            }
        }
        *((p as u64 + j * 8) as *mut u64) = v
        i = i + 1
    }
}

// Der Median der Blockmittel fuer `file.fd_of` auf Deskriptor 1.
fn hb_fd_of(state: u64, me: u64) -> u64 {
    var b: [u64; 33] = [0 as u64; 33]
    var k: u64 = 0
    while k < HB_BLOCKS {
        let t0: u64 = time.tsc()
        var i: u64 = 0
        var acc: u64 = 0
        while i < HB_ITERS {
            acc = acc +% file.fd_of(state, me, 1)
            i = i + 1
        }
        let t1: u64 = time.tsc()
        // `acc` muss gelesen werden, sonst darf der Uebersetzer die
        // Schleife wegwerfen. Die Addition unten kostet nichts und
        // haelt sie am Leben.
        b[k as usize] = ((t1 -% t0) / HB_ITERS) +% (acc & 0)
        k = k + 1
    }
    hb_sort((&b[0]) as *mut u64, HB_BLOCKS)
    return b[16]
}

// Zum Vergleich: eine Leerschleife derselben Form. Was sie kostet, ist
// der Preis der MESSUNG selbst (rdtsc, Schleife, Addition) und muss von
// der Zahl oben abgezogen werden, damit dort nicht der Zeitgeber steht.
fn hb_leer(state: u64) -> u64 {
    var b: [u64; 33] = [0 as u64; 33]
    var k: u64 = 0
    while k < HB_BLOCKS {
        let t0: u64 = time.tsc()
        var i: u64 = 0
        var acc: u64 = 0
        while i < HB_ITERS {
            acc = acc +% kstate.get(state, kstate.TICKS)
            i = i + 1
        }
        let t1: u64 = time.tsc()
        b[k as usize] = ((t1 -% t0) / HB_ITERS) +% (acc & 0)
        k = k + 1
    }
    hb_sort((&b[0]) as *mut u64, HB_BLOCKS)
    return b[16]
}

fn handle_bench(state: u64) {
    var n_fd: [u8; 12] = "bench-fd-of\0"
    var n_le: [u8; 12] = "bench-leer\0\0"
    var n_kh: [u8; 11] = "bench-khz\0\0"
    var n_it: [u8; 13] = "bench-iters\0\0"
    var n_ok: [u8; 12] = "bench-fdok\0\0"
    if !kstate.mode_on(state, kstate.M_HBENCH) {
        return
    }
    let me: u64 = sched.current(state)
    // DER BOOTPROZESS HAT KEINE DESKRIPTOREN. Er kommt nicht aus
    // `proc.create`, also hat `file.init_task` ihn nie gesehen, und
    // `fd_of` steigt bei ihm SOFORT aus: der Platz ist null. Der erste
    // Anlauf dieser Messung hat genau das gemessen -- vorher 19, nachher
    // 21 Zyklen, und beide Male lief `handle.resolve` ueberhaupt nicht.
    // Deshalb bekommt der Bootprozess hier seine drei Deskriptoren, und
    // deshalb steht `bench-fdok` mit in der Ausgabe: es ist der Eintrag,
    // den `fd_of` liefert, und es MUSS 1 sein (die Konsole). Steht dort
    // 64, misst der Benchmark nichts und die Zahl daneben ist wertlos.
    handle.clear_task(state, me, sched.tget(state, me, sched.T_PID))
    file.init_task(state, me)
    hnum((&n_ok[0]) as u64, file.fd_of(state, me, 1))
    hnum((&n_le[0]) as u64, hb_leer(state))
    hnum((&n_fd[0]) as u64, hb_fd_of(state, me))
    hnum((&n_kh[0]) as u64, time.khz(state))
    hnum((&n_it[0]) as u64, HB_BLOCKS * HB_ITERS)
    // UND DIE ECHTE SYSCALL-LATENZ, aus Ring 3 und ueber
    // `syscall`/`sysret`. Die Zahl darueber ist die Funktion,
    // diese hier ist der Preis, den ein Programm bezahlt.
    let tb: u64 = proc.create(state, P_HBENCH, 0, 2)
    kutil.wait_for(state, tb)
    // Wieder abraeumen: der Bootprozess soll nach der Messung genau so
    // dastehen wie davor.
    file.close_all(state, me)
}

// The boot task waits for a task the way `wait` does it for a process:
// sleep until it is a corpse, read the exit code, clear it away.

// ==================================================== RUNDE ASYNC
//
// DIE ASYNCHRONE AUFTRAGSSCHICHT, GEMESSEN UND NACHGEZAEHLT.
//
// Was ein Programm in Ring 3 zeigen kann, zeigt `uprog.u_async`: zwei
// und dreissig Zusagen ueber Lebensdauer, Abbruch, Rueckstau und fremde
// Auftraege. Sein Beendigungscode ist die Zahl der GEFALLENEN Zusagen --
// 0 heisst, alle standen.
//
// Was ein Programm NICHT zeigen kann, steht hier: die Leckzahlen. Nach
// einem Lauf, in dem jeder Prozess ordentlich geendet hat, MUSS die
// Auftragstafel leer sein, kein Handle-Auftrag mehr in Flug, kein Ring
// eine Meldung verloren haben und die Objekttafel wieder auf ihren drei
// Konsoleneintraegen stehen. Eine Refcount-Schicht, die niemand
// nachzaehlt, ist eine Behauptung.
fn asyncs(state: u64) {
    var s_skip: [u8; 15] = "async: skipped\0"
    var s_begin: [u8; 14] = "async: begin\0\0"
    var s_exit: [u8; 20] = "async: ring 3 exit=\0"
    var s_done: [u8; 13] = "async: done\0\0"
    if !kstate.mode_on(state, kstate.M_ASYNC) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_begin[0]) as u64)
    serial.nl()
    let t: u64 = proc.create(state, P_ASYNC, 0, 2)
    let e: u64 = kutil.wait_for(state, t)
    serial.puts((&s_exit[0]) as u64)
    serial.dec(e)
    serial.nl()
    async_zahlen(state)
    serial.puts((&s_done[0]) as u64)
    serial.nl()
}

// RUNDE ASYNC, ZWEITER TEIL: auf einem echten Dateisystem.
fn asyncs_fs(state: u64) {
    var s_exit: [u8; 22] = "asyncfs: ring 3 exit=\0"
    if !kstate.mode_on(state, kstate.M_ASYNC) {
        return
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        return
    }
    let t: u64 = proc.create(state, P_ASYNCFS, 0, 2)
    let e: u64 = kutil.wait_for(state, t)
    serial.puts((&s_exit[0]) as u64)
    serial.dec(e)
    serial.nl()
}

fn anum(name: u64, v: u64) {
    var s_p: [u8; 8] = "async: \0"
    var s_e: [u8; 2] = "=\0"
    serial.puts((&s_p[0]) as u64)
    serial.puts(name)
    serial.puts((&s_e[0]) as u64)
    serial.dec(v)
    serial.nl()
}

fn async_zahlen(state: u64) {
    var n_su: [u8; 10] = "submitted\0"
    var n_co: [u8; 10] = "completed\0"
    var n_ca: [u8; 10] = "cancelled\0"
    var n_st: [u8; 6] = "stale\0"
    var n_fa: [u8; 7] = "failed\0"
    var n_fu: [u8; 5] = "full\0"
    var n_ti: [u8; 9] = "timeouts\0"
    var n_re: [u8; 7] = "reaped\0"
    var n_ab: [u8; 10] = "abandoned\0"
    var n_po: [u8; 7] = "posted\0"
    var n_de: [u8; 7] = "denied\0"
    var n_wo: [u8; 9] = "workruns\0"
    var n_us: [u8; 5] = "used\0"
    var n_li: [u8; 5] = "live\0"
    var n_lo: [u8; 5] = "lost\0"
    var n_ob: [u8; 8] = "objects\0"
    var n_fl: [u8; 9] = "inflight\0"
    var n_by: [u8; 6] = "bytes\0"
    var n_wk: [u8; 8] = "workers\0"
    var n_ct: [u8; 6] = "tasks\0"
    hnum_a(state, (&n_su[0]) as u64, kstate.A_SUBMITTED)
    hnum_a(state, (&n_co[0]) as u64, kstate.A_COMPLETED)
    hnum_a(state, (&n_ca[0]) as u64, kstate.A_CANCELLED)
    hnum_a(state, (&n_st[0]) as u64, kstate.A_STALED)
    hnum_a(state, (&n_fa[0]) as u64, kstate.A_FAILED)
    hnum_a(state, (&n_fu[0]) as u64, kstate.A_FULL)
    hnum_a(state, (&n_ti[0]) as u64, kstate.A_TIMEOUTS)
    hnum_a(state, (&n_re[0]) as u64, kstate.A_REAPED)
    hnum_a(state, (&n_ab[0]) as u64, kstate.A_ABANDONED)
    hnum_a(state, (&n_po[0]) as u64, kstate.A_POSTED)
    hnum_a(state, (&n_de[0]) as u64, kstate.A_DENIED)
    hnum_a(state, (&n_wo[0]) as u64, kstate.A_WORKRUNS)
    // DIE LECKZAHLEN. Alle fuenf muessen null sein (bis auf die drei
    // Konsoleneintraege der Objekttafel).
    anum((&n_us[0]) as u64, async.used(state))
    anum((&n_li[0]) as u64, async.live(state))
    anum((&n_lo[0]) as u64, async_lost(state))
    anum((&n_ob[0]) as u64, handle.objects_used(state))
    anum((&n_fl[0]) as u64, handle.req_live(state))
    anum((&n_by[0]) as u64, async.bytes_per_request())
    anum((&n_wk[0]) as u64, async_workers(state))
    anum((&n_ct[0]) as u64, async.MAX_AIO)
}

fn hnum_a(state: u64, name: u64, off: u64) {
    anum(name, kstate.get(state, off))
}

// Verlorene Fertigmeldungen ueber ALLE Aufgaben. Sie MUSS null sein:
// die Abgabe laesst je Prozess hoechstens so viele Auftraege offen, wie
// der Ring Plaetze hat -- ein Ring, der verwirft, ist schlimmer als eine
// Abgabe, die -EAGAIN sagt.
fn async_lost(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        n = n + async.cq_lost(state, i)
        i = i + 1
    }
    return n
}

// Wie viele Arbeitsfaeden wirklich laufen. Nicht die Zahl, die
// `async.WORKERS` verspricht -- die, die in der Aufgabentabelle steht.
fn async_workers(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        if sched.tget(state, i, sched.T_STATE) != sched.S_FREE {
            if sched.tget(state, i, sched.T_KIND) == sched.K_AIO {
                n = n + 1
            }
        }
        i = i + 1
    }
    return n
}

// Die Messung. Sie steht ABSICHTLICH ausserhalb von `asyncs`: mit
// `async` laeuft der Selbsttest mit, und dann misst sie den Selbsttest
// und nicht den Regelbetrieb. `abench` allein ist die Messung, die gilt.
fn async_bench(state: u64) {
    var n_kh: [u8; 12] = "abench-khz\0\0"
    var n_wk: [u8; 16] = "abench-workers\0\0"
    if !kstate.mode_on(state, kstate.M_ABENCH) {
        return
    }
    let tb: u64 = proc.create(state, P_ABENCH, 0, 2)
    kutil.wait_for(state, tb)
    anum((&n_kh[0]) as u64, time.khz(state))
    anum((&n_wk[0]) as u64, async_workers(state))
}

// ==================================================== RUNDE K13
//
// Zwei Programme aus `uprog.fi`, beide in Ring 3, beide ohne Platte:
//
//   P_USER    fragt nach seinen Kennungen, wechselt sie, laesst sich
//             ablehnen und gibt sie an ein Kind weiter. Vierzehn
//             Zeilen "k13u: NAME=WERT" auf der seriellen Leitung.
//   P_ZOMBIE  laesst ein Kind zurueck, ohne auf es zu warten. Ohne
//             einen Prozess 1 bleibt die Leiche stehen -- das ist die
//             GEGENPROBE zu init, und sie steht hier, weil sie ohne
//             Userland auskommt und deshalb nicht an einem kaputten
//             Abbild scheitern kann.
fn users(state: u64) {
    var s_skip: [u8; 14] = "k13: skipped\0\0"
    var s_begin: [u8; 12] = "k13: begin\0\0"
    var s_exit: [u8; 18] = "k13: ring 3 exit=\0"
    var s_z: [u8; 16] = "k13: zombies=\0\0\0"
    var s_a: [u8; 8] = " after=\0"
    if !kstate.mode_on(state, kstate.M_K13) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_begin[0]) as u64)
    serial.nl()
    let t: u64 = proc.create(state, P_USER, 0, 2)
    let e: u64 = kutil.wait_for(state, t)
    serial.puts((&s_exit[0]) as u64)
    serial.dec(e)
    serial.nl()
    if kstate.mode_on(state, kstate.M_ZOMBIE) {
        let before: u64 = sched.zombies(state, sched.K_USER)
        let z: u64 = proc.create(state, P_ZOMBIE, 0, 2)
        kutil.wait_for(state, z)
        // Dem Enkel Zeit lassen, seinerseits zu sterben. Danach steht
        // eine Leiche in der Tafel, um die sich niemand kuemmert.
        var w: u64 = 0
        while w < 40 {
            sched.sleep_ticks(state, 2)
            w = w + 1
        }
        serial.puts((&s_z[0]) as u64)
        serial.dec(before)
        serial.puts((&s_a[0]) as u64)
        serial.dec(sched.zombies(state, sched.K_USER))
        serial.nl()
    }
}


// ------------------------------------------------------ the file system

// Point 4: a RAM disk as a block device, and a real file system on it.
fn filesystem(state: u64) {
    var s_skip: [u8; 13] = "fs: skipped\0\0"
    var s_disk: [u8; 11] = "fs: disk=\0\0"
    var s_blocks: [u8; 10] = "  blocks=\0"
    var s_pre: [u8; 22] = "fs: mount unformatted\0"
    var s_eq: [u8; 2] = "=\0"
    var s_fmt: [u8; 12] = "fs: format \0"
    var s_free: [u8; 8] = "  free=\0"
    var s_ino: [u8; 10] = "  inodes=\0"
    var s_small: [u8; 11] = "fs: small \0"
    var s_wrote: [u8; 8] = "wrote=\0\0"
    var s_read: [u8; 8] = "  read=\0"
    var s_same: [u8; 8] = "  same=\0"
    var s_big: [u8; 9] = "fs: big \0"
    var s_list: [u8; 10] = "fs: list \0"
    var s_dir: [u8; 12] = "fs: subdir \0"
    var s_unlink: [u8; 12] = "fs: unlink \0"
    var s_after: [u8; 9] = "  after=\0"
    var s_gone: [u8; 8] = "  gone=\0"
    var s_done: [u8; 10] = "fs: done\0\0"
    var s_of: [u8; 5] = " of \0"
    var p_hello: [u8; 11] = "/hello.txt\0"
    var p_docs: [u8; 6] = "/docs\0"
    var p_big: [u8; 14] = "/docs/big.bin\0"
    var p_limit: [u8; 11] = "/limit.bin\0"
    var s_limit: [u8; 18] = "fs: limit asked=\0\0"
    var s_wrote2: [u8; 10] = "  wrote=\0\0"
    var s_size: [u8; 9] = "  size=\0\0"
    var p_root: [u8; 2] = "/\0"
    var text: [u8; 15] = "firn round 62\n\0"

    if kstate.mode_on(state, kstate.M_NOFS) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    let disk: u64 = mem.frame_run(state, DISK_FRAMES)
    if disk == 0 {
        return
    }
    blk.ram_init(state, disk, DISK_BLOCKS)
    serial.puts((&s_disk[0]) as u64)
    serial.hex(disk)
    serial.puts((&s_blocks[0]) as u64)
    serial.dec(blk.blocks(state))
    serial.nl()

    // THE COUNTER-CHECK first: a disk without a magic number is not a
    // file system, and `mount` has to say so.
    serial.puts((&s_pre[0]) as u64)
    serial.puts((&s_eq[0]) as u64)
    serial.dec(kutil.yes(fs.mount(state)))
    serial.nl()

    serial.puts((&s_fmt[0]) as u64)
    serial.dec(kutil.yes(fs.format(state)))
    serial.puts((&s_eq[0]) as u64)
    serial.dec(kutil.yes(fs.mount(state)))
    serial.puts((&s_free[0]) as u64)
    serial.dec(fs.free_blocks(state))
    serial.puts((&s_ino[0]) as u64)
    serial.dec(fs.used_inodes(state))
    serial.nl()

    // A small file: create, write, read back, compare.
    let ino: u64 = fs.create_path(state, (&p_hello[0]) as u64, fs.T_FILE)
    let wrote: u64 = fs.write_at(state, ino, 0, (&text[0]) as u64, 14)
    let scratch: u64 = state + kstate.BLOCK_OFF
    let got: u64 = fs.read_at(state, ino, 0, scratch, 64)
    serial.puts((&s_small[0]) as u64)
    serial.puts((&s_wrote[0]) as u64)
    serial.dec(wrote)
    serial.puts((&s_read[0]) as u64)
    serial.dec(got)
    serial.puts((&s_same[0]) as u64)
    serial.dec(same(scratch, (&text[0]) as u64, 14))
    serial.nl()

    // A subdirectory and a file in it that is bigger than a block: that
    // is where the block allocation is really tested.
    fs.create_path(state, (&p_docs[0]) as u64, fs.T_DIR)
    let big: u64 = fs.create_path(state, (&p_big[0]) as u64, fs.T_FILE)
    let pattern: u64 = state + kstate.BLOCK_OFF + 2048
    var i: u64 = 0
    while i < 1500 {
        kstate.set8(pattern + i, (48 + i % 10) as u8)
        i = i + 1
    }
    let bw: u64 = fs.write_at(state, big, 0, pattern, 1500)
    let br: u64 = fs.read_at(state, big, 0, scratch, 1500)
    serial.puts((&s_big[0]) as u64)
    serial.puts((&s_wrote[0]) as u64)
    serial.dec(bw)
    serial.puts((&s_read[0]) as u64)
    serial.dec(br)
    serial.puts((&s_same[0]) as u64)
    serial.dec(same(scratch, pattern, 1500))
    serial.puts((&s_free[0]) as u64)
    serial.dec(fs.free_blocks(state))
    serial.nl()

    // THE LIMIT OF THE SHAPE. Round 62 wrote twelve chunks here, because
    // twelve direct blocks and one indirect one were 76 blocks = 38912
    // octets and the thirteenth chunk had nowhere to go. ROUND K4 gave the
    // inode a DOUBLE indirect pointer -- 11 + 64 + 64 * 64 blocks -- and
    // that ceiling is gone; a program that carries a libc does not fit
    // under 38912 octets, which is why it had to go.
    //
    // So what is measured here is the NEW shape: 300 chunks are asked for,
    // which is more than the whole RAM disk holds, and the file system has
    // to write what it can, SAY how much that was, and stop -- instead of
    // answering with the length it was asked for. The number that comes
    // out is over 38912 (the two levels really work) and under 1228800
    // (the disk really is the limit now).
    let lim: u64 = fs.create_path(state, (&p_limit[0]) as u64, fs.T_FILE)
    var asked: u64 = 0
    var stored: u64 = 0
    var chunk: u64 = 0
    while chunk < 300 {
        asked = asked + 4096
        stored = stored + fs.write_at(state, lim, chunk * 4096, pattern, 4096)
        chunk = chunk + 1
    }
    serial.puts((&s_limit[0]) as u64)
    serial.dec(asked)
    serial.puts((&s_wrote2[0]) as u64)
    serial.dec(stored)
    serial.puts((&s_size[0]) as u64)
    serial.dec(fs.inode_size(state, lim))
    serial.nl()
    fs.unlink_path(state, (&p_limit[0]) as u64)

    // What is in the root directory, and what in the subdirectory.
    list_dir(state, (&p_root[0]) as u64, (&s_list[0]) as u64)
    list_dir(state, (&p_docs[0]) as u64, (&s_dir[0]) as u64)

    // Delete: the name goes, the blocks come back.
    let before: u64 = fs.free_blocks(state)
    serial.puts((&s_unlink[0]) as u64)
    serial.dec(kutil.yes(fs.unlink_path(state, (&p_big[0]) as u64)))
    serial.puts((&s_gone[0]) as u64)
    serial.dec(kutil.yes(fs.path(state, (&p_big[0]) as u64) == 0))
    serial.puts((&s_after[0]) as u64)
    serial.dec(fs.free_blocks(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(before)
    serial.nl()

    serial.puts((&s_done[0]) as u64)
    serial.nl()
}


fn same(a: u64, b: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < n {
        if kstate.get8(a + i) != kstate.get8(b + i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

// `ls` in the kernel: every entry of a directory with its type.
fn list_dir(state: u64, p: u64, label: u64) {
    var s_sp: [u8; 2] = " \0"
    var s_colon: [u8; 2] = ":\0"
    let dir: u64 = fs.path(state, p)
    serial.puts(label)
    if dir == 0 {
        serial.nl()
        return
    }
    let out: u64 = state + kstate.NAME_OFF + 1024
    var i: u64 = 0
    var going: bool = true
    while going {
        let ino: u64 = fs.entry_at(state, dir, i, out)
        if ino == 0 {
            going = false
        } else {
            serial.puts(out + 8)
            serial.puts((&s_colon[0]) as u64)
            serial.dec(fs.inode_type(state, ino))
            serial.puts((&s_sp[0]) as u64)
            i = i + 1
        }
    }
    serial.nl()
}

// ------------------------------------------------------------- the shell

// What the console delivers on descriptor 0. In the test it comes from
// the boot loader: `script=ls;cat /hello.txt` -- a semicolon is a line
// break, and everything up to the end of the command line belongs to it.
fn console_load(state: u64, cmd: u64) -> u64 {
    var tag: [u8; 8] = "script=\0"
    kstate.set(state, kstate.CONSOLE_LEN, 0)
    kstate.set(state, kstate.CONSOLE_POS, 0)
    if cmd == 0 {
        return 0
    }
    let at: u64 = find(cmd, (&tag[0]) as u64, 7)
    if at == 0 {
        return 0
    }
    var p: u64 = at + 7
    var n: u64 = 0
    while kstate.get8(p) != 0 && n < kstate.CONSOLE_MAX - 2 {
        var c: u64 = kstate.get8(p)
        if c == 59 {
            c = 10 // ';' is a line break
        }
        // ROUND K9: `^C` IM SKRIPT IST WIRKLICH STRG-C. Ein Dach gefolgt
        // von einem Grossbuchstaben wird zu dem Steuerzeichen, das die
        // Taste schickt -- `^C` zu 3, `^D` zu 4, `^Z` zu 26. Das Skript
        // geht seit dieser Runde durch dieselbe Zeilendisziplin wie die
        // Tastatur (`sys.script_feed` -> `tty.push`), und deshalb loest
        // ein `^C` hier genau dasselbe SIGINT aus wie ein Mensch am
        // Terminal. Ohne diesen Weg liesse sich STRG-C nur mit einem
        // Menschen davor pruefen -- und was niemand nachmessen kann,
        // gilt in diesem Projekt als Behauptung.
        if c == 94 {
            let nxt: u64 = kstate.get8(p + 1)
            if nxt >= 64 && nxt < 96 {
                c = nxt - 64
                p = p + 1
            }
        }
        kstate.set8(state + kstate.CONSOLE_OFF + n, c as u8)
        n = n + 1
        p = p + 1
    }
    if n > 0 && kstate.get8(state + kstate.CONSOLE_OFF + n - 1) != 10 {
        kstate.set8(state + kstate.CONSOLE_OFF + n, 10 as u8)
        n = n + 1
    }
    kstate.set(state, kstate.CONSOLE_LEN, n)
    return n
}

// Point 5: `ls`, `cat`, `echo` and three more, in ring 3, over the system
// calls of point 3, on the file system of point 4.
// ROUNDE K10: MIT `wmshell` GEHOERT DAS SKRIPT DER SHELL IM FENSTER.
//
// Die Kommandozeile traegt EIN Skript (`script=...`), und es wird von
// dem gelesen, der zuerst danach greift. Runde K1 startet hier eine
// Shell im Kernelabbild, Runde K6 eine von der Platte -- beide vor der
// Oberflaeche. Ohne diese Abfrage hat die Shell im Terminalfenster
// nichts mehr zu lesen, und im Bild steht eine leere Eingabezeile.
fn wm_owns_shell(state: u64) -> bool {
    return kstate.mode_on(state, kstate.M_WMSHELL)
}

// ============================================================ RUNDE MODUL
//
// DER ABSCHNITT, DER MISST, was `kernel/modul.fi` kann. Er ist der
// einzige Aufrufer des Laders in diesem Kern, und er tut in genau dieser
// Reihenfolge:
//
//   1. Die Ausfuhrtafel des Kerns drucken (`kernel/ksym.fi`) -- mit
//      Namen UND Adressen. `tools/modul/run.sh` haelt jede dieser
//      Zahlen gegen das, was `nm` im gebundenen Abbild sagt. Waeren sie
//      verschieden, waere der Kniff mit dem Funktionswert falsch, und
//      alles darunter waere Zufall.
//   2. DEN ZUSTAND OHNE MODUL: gibt es ein Zeigegeraet? Im gewoehnlichen
//      Bau: ja, es steht im Abbild. Mit `--ohne-ps2m`: nein, und das ist
//      der Ausgangspunkt der Messung.
//   3. Die Wurzelplatte einhaengen -- die Moduldatei liegt darauf, so
//      wie ein Treiber unter Windows in `C:\Windows\System32\drivers`
//      liegt und nicht im Kern.
//   4. Laden. Danach noch einmal Punkt 2: dasselbe `gfx.mouse_present`,
//      dieselbe Zeile Quelltext, andere Antwort.
//   5. Das Geraet aufsetzen und die Zahlen drucken, die der
//      QEMU-Monitor von aussen bewegen kann.
//   6. Auf Wunsch (`modulaus`) entladen und noch einmal messen.
//
// Die GEGENPROBEN stehen nicht hier, sondern in den Dateien: der Laeufer
// baut vier absichtlich kaputte Module und laesst denselben Abschnitt
// laufen. Was sich aendert, ist der Grund, den Punkt 4 druckt.
fn moduls(state: u64) {
    var s_off: [u8; 11] = "modul: off\0"
    var s_abi: [u8; 12] = "modul: abi=\0"
    var s_syms: [u8; 13] = "modul: syms=\0"
    var s_sym: [u8; 10] = "modul:   \0"
    var s_gl: [u8; 2] = "=\0"
    var s_vor: [u8; 17] = "modul: vor init=\0"
    var s_nach: [u8; 18] = "modul: nach init=\0"
    var s_pres: [u8; 10] = " present=\0"
    var s_id: [u8; 5] = " id=\0"
    var s_pkt: [u8; 6] = " pkt=\0"
    var s_mount: [u8; 14] = "modul: mount=\0"
    var s_lade: [u8; 14] = "modul: laden=\0"
    var s_warte: [u8; 13] = "modul: warte\0"
    var s_frei: [u8; 13] = "modul: frei=\0"
    var s_ent: [u8; 17] = "modul: entladen=\0"
    var s_ende: [u8; 12] = "modul: ende\0"
    var pfad: [u8; 18] = "/lib/ps2maus.omod\0"
    // DER ZWEITE PFAD IST DER, AN DEN `opk` INSTALLIERT. Runde INSTALL
    // legt ein Paket unter /store/<hash>/ ab und baut daraus /apps neu;
    // eine Datei `lib/x` aus einem Paket `ps2maus` liegt danach unter
    // /apps/ps2maus.prog/lib/x. Der Kern sucht deshalb an beiden
    // Stellen -- erst dort, wo ein Mensch sie hinlegt, dann dort, wo die
    // Paketverwaltung sie hinlegt. Genau so hat Windows einen
    // DriverStore neben System32\drivers.
    var pfad2: [u8; 36] = "/apps/ps2maus.prog/lib/ps2maus.omod\0"

    if !kstate.mode_on(state, kstate.M_MODUL) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }

    modul.init(state)

    // 1. DIE AUSFUHRTAFEL DES KERNS, mit Namen UND Adressen.
    //    `tools/modul/run.sh` haelt jede dieser Zahlen gegen das, was
    //    `nm` im gebundenen Abbild sagt. Waeren sie verschieden, waere
    //    der Kniff mit dem Funktionswert (`kernel/ksym.fi`) falsch, und
    //    alles darunter waere Zufall statt Messung.
    serial.puts((&s_abi[0]) as u64)
    serial.dec(ksym.ABI)
    serial.nl()
    serial.puts((&s_syms[0]) as u64)
    serial.dec(ksym.anzahl())
    serial.nl()
    var i: u64 = 0
    while i < ksym.anzahl() {
        serial.puts((&s_sym[0]) as u64)
        ksym.name_at(i)
        serial.puts((&s_gl[0]) as u64)
        serial.hex(ksym.adresse_at(i))
        serial.nl()
        i = i + 1
    }

    // 2. DER ZUSTAND OHNE MODUL. Nicht "es ist keins geladen", sondern
    //    die Frage, um die es geht: LAESST SICH DAS GERAET AUFSETZEN?
    //    Im gewoehnlichen Bau ja -- der Treiber steht im Abbild. Mit
    //    `--ohne-ps2m` nein, und das ist der Ausgangspunkt.
    serial.puts((&s_vor[0]) as u64)
    serial.dec(kutil.yes(gfx.mouse_init(state, 800, 600)))
    serial.puts((&s_pres[0]) as u64)
    serial.dec(kutil.yes(gfx.mouse_present(state)))
    serial.puts((&s_pkt[0]) as u64)
    serial.dec(gfx.mouse_packets(state))
    serial.nl()

    // 3. Die Wurzelplatte -- die Moduldatei liegt darauf, so wie ein
    //    Treiber unter Windows in `\Windows\System32\drivers` liegt und
    //    nicht im Kern.
    if blk.present(state) {
        blk.use_ata(state, kutil.root_blocks(state))
    }
    let eingehaengt: bool = fs.mount(state)
    serial.puts((&s_mount[0]) as u64)
    serial.dec(kutil.yes(eingehaengt))
    serial.nl()

    // Die freien Rahmen VOR dem Laden. Ein Lader, der Rahmen verliert,
    // faellt an dieser Zahl auf und an keiner anderen.
    let frei_vor: u64 = mem.frames_free(state)

    // 4. LADEN.
    var grund: u64 = modul.laden(state, (&pfad[0]) as u64,
        modidx.SLOT_MAUS)
    if grund == modul.R_NOFILE {
        grund = modul.laden(state, (&pfad2[0]) as u64, modidx.SLOT_MAUS)
    }
    serial.puts((&s_lade[0]) as u64)
    modul.say_reason(grund)
    serial.nl()
    zahlen(state)

    // 5. DERSELBE AUFRUF WIE IN PUNKT 2, dieselbe Zeile Quelltext.
    serial.puts((&s_nach[0]) as u64)
    serial.dec(kutil.yes(gfx.mouse_init(state, 800, 600)))
    serial.puts((&s_pres[0]) as u64)
    serial.dec(kutil.yes(gfx.mouse_present(state)))
    serial.puts((&s_id[0]) as u64)
    serial.dec(gfx.mouse_id(state))
    serial.puts((&s_pkt[0]) as u64)
    serial.dec(gfx.mouse_packets(state))
    serial.nl()

    if grund == modul.R_OK {
        bewegen(state, (&s_warte[0]) as u64)
    }

    // 6. ENTLADEN, wenn verlangt.
    if kstate.mode_on(state, kstate.M_MODULAUS) {
        let ok: bool = modul.entladen(state, 0)
        serial.puts((&s_ent[0]) as u64)
        serial.dec(kutil.yes(ok))
        serial.puts((&s_pres[0]) as u64)
        serial.dec(kutil.yes(gfx.mouse_present(state)))
        serial.puts((&s_pkt[0]) as u64)
        serial.dec(gfx.mouse_packets(state))
        serial.nl()
        // Und die Rahmen: nach dem Entladen muessen es wieder so viele
        // sein wie vorher.
        serial.puts((&s_frei[0]) as u64)
        serial.dec(mem.frames_free(state))
        serial.puts((&s_gl[0]) as u64)
        serial.dec(frei_vor)
        serial.nl()
        // UND DANACH WIRD DIE MAUS NOCH EINMAL BEWEGT. Eine
        // Unterbrechung, die nach dem Entladen kommt, laeuft in
        // `ps2m-aus.irq` und findet dort eine Null. Dass der Kern das
        // ueberlebt, ist die Zusage; dass er es TUT, misst diese Zeile.
        bewegen(state, (&s_warte[0]) as u64)
    }

    serial.puts((&s_ende[0]) as u64)
    serial.nl()
}

fn zahlen(state: u64) {
    var a: [u8; 14] = "modul: sigok=\0"
    var b: [u8; 7] = " secs=\0"
    var c: [u8; 7] = " syms=\0"
    var e: [u8; 6] = " rel=\0"
    var f: [u8; 6] = " ext=\0"
    var g2: [u8; 8] = " bytes=\0"
    var h: [u8; 8] = " datei=\0"
    var i2: [u8; 8] = " basis=\0"
    var j: [u8; 9] = " rahmen=\0"
    var k2: [u8; 6] = " abi=\0"
    var l: [u8; 9] = " initrc=\0"
    var m2: [u8; 10] = " plaetze=\0"
    var n2: [u8; 12] = " abgelehnt=\0"
    serial.puts((&a[0]) as u64)
    serial.dec(modul.sig_ok(state))
    serial.puts((&b[0]) as u64)
    serial.dec(modul.secs(state))
    serial.puts((&c[0]) as u64)
    serial.dec(modul.syms(state))
    serial.puts((&e[0]) as u64)
    serial.dec(modul.relocs(state))
    serial.puts((&f[0]) as u64)
    serial.dec(modul.ext_syms(state))
    serial.puts((&g2[0]) as u64)
    serial.dec(modul.image_bytes(state))
    serial.puts((&h[0]) as u64)
    serial.dec(modul.file_bytes(state))
    serial.puts((&i2[0]) as u64)
    serial.hex(modul.base_of(state, 0))
    serial.puts((&j[0]) as u64)
    serial.dec(modul.frames_of(state, 0))
    serial.puts((&k2[0]) as u64)
    serial.dec(modul.abi_of_file(state))
    serial.puts((&l[0]) as u64)
    serial.dec(modul.init_rc(state))
    serial.puts((&m2[0]) as u64)
    serial.dec(modtab.count(state, modidx.SLOT_MAUS))
    serial.puts((&n2[0]) as u64)
    serial.dec(modul.rejects(state))
    serial.nl()
}

// Warten, waehrend der Laeufer von aussen `mouse_move` schickt, und
// danach die Zahlen drucken. Die Marke `modul: warte` ist das Zeichen
// fuer den Laeufer -- er wartet darauf und nicht auf die Uhr des Wirts,
// aus demselben Grund, aus dem Runde OTA ihre Schusszeitpunkte an
// Marken ausgerichtet hat (docs/RUNDE-MERGE3.md, Teil 1b).
fn bewegen(state: u64, marke: u64) {
    var c: [u8; 12] = "modul: pkt=\0"
    var d2: [u8; 6] = " mov=\0"
    var e: [u8; 4] = " x=\0"
    var f: [u8; 4] = " y=\0"
    var g2: [u8; 6] = " btn=\0"
    var h2: [u8; 7] = " irqs=\0"
    serial.puts(marke)
    serial.nl()
    let bis: u64 = kstate.get(state, kstate.TICKS) + 500
    while kstate.get(state, kstate.TICKS) < bis {
        asm("hlt")
    }
    serial.puts((&c[0]) as u64)
    serial.dec(gfx.mouse_packets(state))
    serial.puts((&d2[0]) as u64)
    serial.dec(gfx.mouse_moves(state))
    serial.puts((&e[0]) as u64)
    serial.dec(gfx.mouse_x(state))
    serial.puts((&f[0]) as u64)
    serial.dec(gfx.mouse_y(state))
    serial.puts((&g2[0]) as u64)
    serial.dec(gfx.mouse_buttons(state))
    serial.puts((&h2[0]) as u64)
    serial.dec(gfx.mouse_clicks(state))
    serial.nl()
}

fn shell(state: u64) {
    if wm_owns_shell(state) {
        return
    }
    var s_none: [u8; 14] = "sh: no script\0"
    var s_in: [u8; 17] = "sh: input bytes=\0"
    var s_out: [u8; 15] = "sh: commands=\0\0"
    // ROUND K1: with `osum` the shell comes off the disk, and the one
    // compiled into the kernel would eat the script before it.
    if kstate.mode_on(state, kstate.M_OSUM) {
        return
    }
    if kstate.get(state, kstate.CONSOLE_LEN) == 0 {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_in[0]) as u64)
    serial.dec(kstate.get(state, kstate.CONSOLE_LEN))
    serial.nl()
    let i: u64 = proc.create(state, P_SHELL, 0, 2)
    let code: u64 = kutil.wait_for(state, i)
    serial.puts((&s_out[0]) as u64)
    serial.dec(code)
    serial.nl()
}

// ------------------------------------------------------------- osum

// ROUND K1: THE POINT OF THE ROUND, IN ONE FUNCTION.
//
// Everything above starts a program the kernel was compiled with. This
// one starts a program the kernel has never seen: it mounts the drive
// QEMU was handed, looks up `/bin/sh` in it, reads that file, lays its
// segments into a fresh address space with the rights the file asks for,
// and waits for it. What the shell then does -- `ls`, `cat`, `echo` --
// it does by loading FURTHER files off the same disk through `exec`.
//
// The kernel therefore has no list of programs any more. `tools/osum/
// run.sh` proves that by putting a DIFFERENT file at `/bin/ls` and
// watching the output change without a line of the kernel changing.
// ==================================================================
// RUNDE K14 -- DIE VFS-SCHICHT UND DIE FREMDEN DATEISYSTEME
//
// Hier steht die REIHENFOLGE, und sie ist wieder nicht beliebig:
//
//   1. Die Schicht selbst und die WURZEL. Ohne einen Eintrag fuer die
//      Wurzel hat kein weiterer Einhaengepunkt einen Ort, an dem er
//      haengen koennte -- `mount_at` verlangt ein Verzeichnis, das es
//      gibt, und ein Verzeichnis gibt es nur auf einem eingehaengten
//      Dateisystem.
//   2. /proc und /dev. Beide brauchen keine Platte.
//   3. Die ZWEITE Platte, ihre Partitionstafel und das FAT32 darauf.
//      Zuletzt, weil sie als einzige fehlschlagen kann, ohne dass
//      etwas kaputt ist: eine Maschine ohne zweites Laufwerk ist keine
//      kaputte Maschine.
//
// JEDER EINHAENGEPUNKT MUSS ALS VERZEICHNIS AUF DER WURZEL LIEGEN. Das
// ist der Grund, warum diese Runde an einem bestehenden Plattenabbild
// nichts aendert: wo kein /proc liegt, wird auch keines eingehaengt,
// und die 1486 Zusagen der Runden 59 bis K12 messen weiter genau das,
// was sie gemessen haben.
fn k14_setup(state: u64) {
    var s_off: [u8; 20] = "k14: novfs␀␀␀␀␀␀␀␀␀␀"
    var s_root: [u8; 14] = "k14: root=␀␀␀␀"
    var s_proc: [u8; 14] = "  proc=␀␀␀␀␀␀␀"
    var s_dev: [u8; 10] = "  dev=␀␀␀␀"
    var s_fat: [u8; 10] = "  fat=␀␀␀␀"
    var s_k14: [u8; 6] = "k14: ␀"
    var s_disk2: [u8; 16] = "k14: disk2=␀␀␀␀␀"
    var s_parts: [u8; 12] = "  parts=␀␀␀␀"
    var s_mnts: [u8; 12] = "  mounts=␀␀␀"
    var p_proc: [u8; 6] = "/proc␀"
    var p_dev: [u8; 5] = "/dev␀"
    var p_mnt: [u8; 5] = "/mnt␀"
    // RUNDE K17: K14_MODE ist die Kopie DES WORTES, in dem die Schalter
    // dieser Runde liegen -- seit dem Modusvektor ist das Wort 3 und
    // nicht mehr Wort 0.
    kstate.set(state, kstate.K14_MODE, kstate.mode_word(state, 3))
    if !kstate.mode_on(state, kstate.M_VFS) {
        return
    }
    vfs.init(state)
    let root_ok: bool = vfs.mount_root(state)
    serial.puts((&s_root[0]) as u64)
    serial.dec(kutil.yes(root_ok))
    if kstate.mode_on(state, kstate.M_NOVFS) {
        // DIE GEGENPROBE. Die Wurzel steht, alles andere nicht --
        // /proc, /dev und FAT32 gibt es in diesem Lauf nicht, und
        // jede Zusage dieser Runde ausser der ueber OFS MUSS fallen.
        serial.nl()
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    var proc_m: u64 = vfs.MAX_MNT
    var dev_m: u64 = vfs.MAX_MNT
    if !kstate.mode_on(state, kstate.M_NOPROCFS) {
        proc_m = vfs.mount_at(state, vfsops.FS_PROC, 0, 0, 0,
            (&p_proc[0]) as u64, 0)
    }
    if !kstate.mode_on(state, kstate.M_NODEVFS) {
        dev_m = vfs.mount_at(state, vfsops.FS_DEV, 0, 0, 0,
            (&p_dev[0]) as u64, 0)
    }
    serial.puts((&s_proc[0]) as u64)
    serial.dec(kutil.yes(proc_m < vfs.MAX_MNT))
    serial.puts((&s_dev[0]) as u64)
    serial.dec(kutil.yes(dev_m < vfs.MAX_MNT))
    serial.nl()
    if kstate.mode_on(state, kstate.M_NOFAT) {
        return
    }
    // Die zweite Platte. `probe_ata1` liest ihren ersten Block; ein
    // Statusregister allein ist noch keine Platte.
    let have2: bool = blk.probe_ata1(state, DISK2_BLOCKS)
    serial.puts((&s_disk2[0]) as u64)
    serial.dec(kutil.yes(have2))
    serial.nl()
    if !have2 {
        return
    }
    var first: u64 = 0
    var count: u64 = blk.blocks_on(state, blk.DEV_ATA1)
    var nparts: u64 = 0
    if !kstate.mode_on(state, kstate.M_NOPART) {
        nparts = part.scan(state, blk.DEV_ATA1)
        if nparts != 0 {
            // Die erste Partition, die ein FAT32 sein koennte. Auf
            // einer GPT-Platte ist das die mit der Kennung "Microsoft
            // basic data", auf einer MBR-Platte der Typ 0x0B/0x0C.
            var pick: u64 = part.find_kind(state, blk.DEV_ATA1,
                part.T_FAT32)
            if pick >= part.MAX_PARTS {
                pick = part.find_kind(state, blk.DEV_ATA1, part.T_BASIC)
            }
            if pick >= part.MAX_PARTS {
                pick = part.find_kind(state, blk.DEV_ATA1, part.T_EFI)
            }
            if pick < part.MAX_PARTS {
                first = part.start(state, pick)
                count = part.blocks(state, pick)
            }
        }
    }
    serial.puts((&s_parts[0]) as u64)
    serial.dec(nparts)
    serial.nl()
    var fflags: u64 = 0
    if kstate.mode_on(state, kstate.M_FATRO) {
        fflags = mnt.F_RDONLY
    }
    let fat_m: u64 = vfs.mount_at(state, vfsops.FS_FAT, blk.DEV_ATA1,
        first, count, (&p_mnt[0]) as u64, fflags)
    serial.puts((&s_k14[0]) as u64)
    serial.puts((&s_fat[0]) as u64)
    serial.dec(kutil.yes(fat_m < vfs.MAX_MNT))
    serial.puts((&s_mnts[0]) as u64)
    serial.dec(kstate.get(state, kstate.VFS_MOUNTS))
    serial.nl()
}

// Was die Schicht in diesem Lauf getan hat. Vier Zahlen, und jede
// einzelne ist eine, die `tools/k14/run.sh` zurueckliest -- eine
// Runde, die eine Einhaengegrenze baut und nicht sagen kann, wie oft
// sie ueberquert wurde, hat nichts vorzuweisen.
fn say_k14(state: u64) {
    var s: [u8; 18] = "k14: mounts=␀␀␀␀␀␀"
    var s_l: [u8; 12] = " lookups=␀␀␀"
    var s_c: [u8; 14] = " crossings=␀␀␀"
    var s_o: [u8; 8] = " ops=␀␀␀"
    var s_i: [u8; 12] = " indirect=␀␀"
    if !kstate.mode_on(state, kstate.M_VFS) {
        return
    }
    serial.puts((&s[0]) as u64)
    serial.dec(kstate.get(state, kstate.VFS_MOUNTS))
    serial.puts((&s_l[0]) as u64)
    serial.dec(kstate.get(state, kstate.VFS_LOOKUPS))
    serial.puts((&s_c[0]) as u64)
    serial.dec(kstate.get(state, kstate.VFS_CROSSINGS))
    serial.puts((&s_o[0]) as u64)
    serial.dec(kstate.get(state, kstate.VFS_OPS))
    serial.puts((&s_i[0]) as u64)
    serial.dec(kstate.get(state, kstate.VFS_INDIRECT))
    serial.nl()
}

// ================================================== RUNDE INSTALL
//
// DIE WURZEL VON EINER PARTITION.
//
// Bis zu dieser Runde kannte dieser Kern genau zwei Wurzeln: das
// Boot-Modul (ein ISO hat keine Platte) und Block 0 einer Platte (die
// Testabbilder liegen dort roh). Eine Platte, die ein
// Installationsprogramm beschrieben hat, hat WEDER: in Block 0 steht ein
// Schutz-MBR, und das Dateisystem faengt irgendwo dahinter an. Genau der
// Fall, den `part.fi` seit Runde K14 lesen kann und fuer den ihn bis
// heute niemand gefragt hat.
//
// DIE REIHENFOLGE IST ABSICHTLICH DIESE:
//
//   1. Boot-Modul, wenn die Kommandozeile eines verlangt und die Summe
//      stimmt. Unveraendert.
//   2. OFS ab Block 0 der Platte. Unveraendert -- und deshalb sieht
//      JEDE Messung vor dieser Runde genau das, was sie sah.
//   3. ERST WENN DAS FEHLSCHLAEGT: die Partitionstafel lesen und die
//      erste Partition mit UNSERER Typkennung als Wurzel nehmen.
//
// Ein Schritt 3, der vor Schritt 2 laege, wuerde auf einer rohen
// OFS-Platte eine Partitionstafel suchen, die es nicht gibt -- und in
// den 1486 bestehenden Zusagen steht keine einzige Partition.
fn root_from_part(state: u64) -> bool {
    var s_try: [u8; 20] = "osum: rootpart scan\0"
    var s_at: [u8; 16] = "osum: rootpart=\0"
    var s_fi: [u8; 9] = "  first=\0"
    var s_bl: [u8; 10] = "  blocks=\0"
    var s_none: [u8; 26] = "osum: no ofs partition\0\0\0\0"
    serial.puts((&s_try[0]) as u64)
    serial.nl()
    let n: u64 = part.scan(state, blk.DEV_ATA)
    if n == 0 {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        blk.use_ata(state, OSUM_BLOCKS)
        return false
    }
    let i: u64 = part.find_kind(state, blk.DEV_ATA, part.T_OFS)
    if i >= part.MAX_PARTS {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        blk.use_ata(state, OSUM_BLOCKS)
        return false
    }
    let first: u64 = part.start(state, i)
    let cnt: u64 = part.blocks(state, i)
    blk.use_at(state, blk.DEV_ATA, first, cnt)
    if !fs.mount(state) {
        blk.use_ata(state, OSUM_BLOCKS)
        return false
    }
    kstate.set(state, kstate.ROOT_PART, i)
    serial.puts((&s_at[0]) as u64)
    serial.dec(i)
    serial.puts((&s_fi[0]) as u64)
    serial.dec(first)
    serial.puts((&s_bl[0]) as u64)
    serial.dec(cnt)
    serial.nl()
    return true
}




// RUNDE K17: EIN STICK, EINGEHAENGT WIE JEDE ANDERE PLATTE.
//
// Hier steht keine einzige Zeile ueber USB. `part.scan` bekommt eine
// Geraetenummer, `vfs.mount_at` bekommt eine Geraetenummer, und `fat.fi`
// liest Bloecke ueber `blk.read_on`. Dass diese Bloecke ueber vier
// Endpunkte, einen Befehlsblock und eine Quittung gekommen sind, weiss
// keiner davon -- und genau das IST die Zusage der Schnittstelle aus
// Runde 62. Sie wird hier zum dritten Mal eingeloest (nach NVMe in K2
// und dem ATA-Sklaven in K14).
fn usb_mount(state: u64) {
    var s_h: [u8; 12] = "k17: stick \0"
    var s_p: [u8; 8] = "parts=\0\0"
    var s_f: [u8; 9] = "  first=\0"
    var s_n: [u8; 10] = "  blocks=\0"
    var s_m: [u8; 9] = "  mount=\0"
    var p_usb: [u8; 5] = "/usb\0"
    if !kstate.mode_on(state, kstate.M_USBSTICK) {
        return
    }
    if !usb.msc_ready(state) {
        return
    }
    if !vfs.ready(state) {
        return
    }
    var first: u64 = 0
    var anzahl: u64 = blk.blocks_on(state, blk.DEV_USB)
    let nparts: u64 = part.scan(state, blk.DEV_USB)
    if nparts != 0 {
        var pick: u64 = part.find_kind(state, blk.DEV_USB, part.T_FAT32)
        if pick >= part.MAX_PARTS {
            pick = part.find_kind(state, blk.DEV_USB, part.T_BASIC)
        }
        if pick < part.MAX_PARTS {
            first = part.start(state, pick)
            anzahl = part.blocks(state, pick)
        }
    }
    let m: u64 = vfs.mount_at(state, vfsops.FS_FAT, blk.DEV_USB, first,
        anzahl, (&p_usb[0]) as u64, 0)
    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_p[0]) as u64)
    serial.dec(nparts)
    serial.puts((&s_f[0]) as u64)
    serial.dec(first)
    serial.puts((&s_n[0]) as u64)
    serial.dec(anzahl)
    serial.puts((&s_m[0]) as u64)
    serial.dec(kutil.yes(m < vfs.MAX_MNT))
    serial.nl()
}

fn osum(state: u64) {
    if wm_owns_shell(state) {
        return
    }
    var s_off: [u8; 14] = "osum: skipped\0"
    var s_no: [u8; 15] = "osum: no drive\0"
    var s_mount: [u8; 14] = "osum: mount=\0\0"
    var s_bin: [u8; 12] = "osum: bin \0\0"
    var s_fail: [u8; 22] = "osum: sh did not load\0"
    var s_exit: [u8; 16] = "osum: sh exit=\0\0"
    var s_free: [u8; 20] = "osum: frames_free=\0\0"
    var s_of: [u8; 5] = " of \0"
    var p_sh: [u8; 8] = "/bin/sh\0"
    var p_init: [u8; 11] = "/sbin/init\0"
    // RUNDE INIT: /bin/init ZUERST. Auf diesem System liegt alles
    // Ausfuehrbare in /bin -- `sbin` war nie etwas anderes als eine
    // Gewohnheit aus einer Zeit, in der /usr auf ein anderes Band
    // passen musste. Beide Namen bleiben stehen, und der Grund ist
    // gemessen und nicht ideologisch: `tools/k13/run.sh` legt sein init
    // seit jener Runde nach /sbin/init, und eine Runde, die etwas
    // hinzufuegt, darf keine bestehende Zusage kosten.
    var p_init2: [u8; 10] = "/bin/init\0"
    var a_init: [u8; 5] = "init\0"
    var p_bin: [u8; 5] = "/bin\0"
    var a_sh: [u8; 3] = "sh\0"
    // RUNDE BLECH-HID: das Argument des Notausgangs, 17 Oktette mit
    // der Null.
    var a_nlauf: [u8; 17] = "/etc/netlauf.sh\0\0"
    var s_mod: [u8; 20] = "osum: from module \0\0"
    var s_blk: [u8; 10] = "  blocks=\0"
    var s_sect: [u8; 20] = "osum: ata0 sectors=\0"

    if !kstate.mode_on(state, kstate.M_OSUM) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    // ROUNDE K10: DIE WURZELPLATTE DARF EIN BOOT-MODUL SEIN.
    //
    // Bis hierher lag das Userland auf einer Platte, die QEMU mit
    // `-drive` hereinreicht. Ein ISO hat keine solche Platte; was ein
    // Lader dort weiterreichen kann, ist ein MODUL. `bootmod.ready`
    // sagt nur dann ja, wenn es eines gibt, seine Pruefsumme stimmt und
    // die Kommandozeile es angefordert hat -- ein Modul, das niemand
    // verlangt hat, wird nicht heimlich zur Wurzel. Fuer `fs.fi`
    // aendert sich dabei nichts: es sind dieselben 512 Oktette je
    // Block, nur aus einem anderen Geraet. Genau dafuer gibt es die
    // Schnittstelle in `blk.fi`.
    // RUNDE INSTALL: WIE GROSS IST DIE ERSTE PLATTE WIRKLICH.
    //
    // Das steht VOR der Entscheidung ueber die Wurzel und nicht darin,
    // und der Grund ist genau der Fall, um den es in dieser Runde geht:
    // ein System, das von einem ISO startet und sich auf die Platte
    // installieren soll, hat seine Wurzel im Modul und die Platte
    // daneben. Stuende die Frage im `else`-Zweig, wuesste `/dev/hda`
    // in genau diesem Fall seine Groesse nicht -- und ein
    // Installationsprogramm, das die Groesse der Zielplatte nicht
    // kennt, kann keine Partitionstafel schreiben.
    if blk.present(state) {
        let sekt: u64 = blk.probe_ata0(state)
        serial.puts((&s_sect[0]) as u64)
        serial.dec(sekt)
        serial.nl()
    }
    var kein_ata: bool = false
    if bootmod.ready(state) {
        blk.ram_init(state, bootmod.base(state), bootmod.blocks(state))
        serial.puts((&s_mod[0]) as u64)
        serial.hex(bootmod.base(state))
        serial.puts((&s_blk[0]) as u64)
        serial.dec(bootmod.blocks(state))
        serial.nl()
    } else {
        if !blk.present(state) {
            serial.puts((&s_no[0]) as u64)
            serial.nl()
            kein_ata = true
        } else {
            blk.use_ata(state, kutil.root_blocks(state))
        }
    }
    var mounted: bool = false
    if !kein_ata {
        mounted = fs.mount(state)
        if !mounted && !bootmod.ready(state) {
            mounted = root_from_part(state)
        }
    }
    // RUNDE BLECH: DIE AUTOMATISCHE WURZELWAHL, und sie steht HIER --
    // hinter dem alten Weg und nicht davor.
    //
    // Der Grund ist eine Zahl: alle 54 Abschnitte der Abnahme haengen
    // ihre Wurzel heute ueber die zwei Zeilen darueber ein (ATA an
    // 0x1F0, roh oder ueber die Partitionstafel), und jede einzelne
    // davon ist gruen. Eine Reihenfolge, die NVMe zuerst probiert,
    // waere in genau den Laeufen eine Aenderung, in denen daneben eine
    // leere NVMe-Platte steht -- also eine Aenderung an bestehenden
    // Messungen statt an einem Startproblem.
    //
    // Was diese Zeile loest, ist der Fall, in dem der alte Weg NICHTS
    // findet: ein PC mit NVMe-Riegel oder mit einer SATA-Platte am
    // AHCI-Controller und ohne irgendetwas an 0x1F0. Bis heute endete
    // der Start dort mit `osum: no disk`, obwohl der passende Treiber
    // im selben Abbild liegt. `rootsel.mount_root` geht die Bewerber in
    // der Reihenfolge NVMe, AHCI, USB, IDE durch, zieht jeden hoch und
    // NIMMT DEN ERSTEN, DESSEN WURZEL SICH WIRKLICH EINHAENGEN LAESST.
    if !mounted && !bootmod.ready(state) {
        mounted = rootsel.mount_root(state, hw.on(state, hw.M_NVME),
            hw.on(state, hw.M_AHCI))
    }
    serial.puts((&s_mount[0]) as u64)
    serial.dec(kutil.yes(mounted))
    serial.nl()
    if !mounted {
        return
    }
    // ROUNDE K14: die Schicht, BEVOR das erste Programm laeuft. Eine
    // Shell, die /proc erst nach ihrem Start bekaeme, haette es zum
    // Zeitpunkt ihres eigenen `open` noch nicht.
    k14_setup(state)
    // RUNDE UPDATE: DER ERPROBUNGSZAEHLER. Hier und nicht spaeter -- die
    // Wurzel ist eingehaengt, der erste Prozess laeuft noch nicht, und
    // genau dazwischen liegt die einzige Stelle, an der ein Kern ueber
    // eine Generation entscheiden kann, die gleich starten soll.
    // Begruendung und Grenzen: kernel/ab.fi.
    ab.ab_boot(state)
    // RUNDE CUSTOMRES (MERGE-2 18): DER GESPEICHERTE BILDMODUS. Hier
    // und nicht frueher -- vor dem Einhaengen der Wurzel gibt es die
    // Datei nicht. Der Ruf geht durch die Grafiknaht: `dispsave` haengt
    // an `vmode`, und `vmode` gibt es im GUI-losen Kern nicht.
    // BEIDE Zeilen bleiben -- ab.ab_boot entscheidet ueber die
    // Generation, disp_restore ueber den Bildmodus.
    gfx.disp_restore(state)
    usb_mount(state)
    list_dir(state, (&p_bin[0]) as u64, (&s_bin[0]) as u64)

    // ================================================== RUNDE K13
    //
    // DER ERSTE PROZESS. Bis zu dieser Runde startete der Kern die Shell
    // -- und damit hatte dieses System keinen Ort, an dem `login`
    // haette laufen koennen, keinen Prozess, der Waisen einsammelt, und
    // keinen, der beim Abschalten aufraeumt. Von hier an startet er
    // `/sbin/init`, und die Shell ist etwas, das init startet.
    //
    // ZWEI NOTWEGE, UND BEIDE SIND GEPRUEFT:
    //
    //   1. Das Wort `initsh` auf der Kommandozeile nimmt den alten Weg.
    //      Ein System, das nur noch ueber init startet, startet bei
    //      einem kaputten init gar nicht mehr -- das ist genau die
    //      Sorte Abhaengigkeit, die man sich nicht ohne Hintertuer
    //      einbaut.
    //   2. LIEGT KEIN /sbin/init AUF DER PLATTE, wird /bin/sh genommen,
    //      und es steht eine Zeile darueber auf der seriellen Leitung.
    //      Das ist nicht nur Vorsicht: JEDES Abbild, das die Runden K1
    //      bis K12 bauen, hat kein /sbin/init, und alle ihre Messungen
    //      sollen weiter genau das messen, was sie gemessen haben.
    // argv[0] ist der Name des Programms, so wie es jedes System seit
    // 1975 haelt -- und der Weg, auf dem `/bin/sh` erfaehrt, wie es
    // heisst. Seit dieser Runde steht dort `init`, wenn init startet.
    let abuf: u64 = state + kstate.EARG_OFF
    var use_init: bool = false
    var initpath: u64 = (&p_init[0]) as u64
    if !kstate.mode_on(state, kstate.M_INITSH) {
        if fs.path(state, (&p_init2[0]) as u64) != 0 {
            use_init = true
            initpath = (&p_init2[0]) as u64
        }
        if !use_init {
            if fs.path(state, (&p_init[0]) as u64) != 0 {
                use_init = true
            }
        }
    }
    var first: u64 = (&p_sh[0]) as u64
    var k: u64 = 0
    var argn: u64 = 1
    if use_init {
        first = initpath
        while k < 5 {
            kstate.set8(abuf + k, a_init[k as usize])
            k = k + 1
        }
        kstate.set(state, kstate.K13_OFF + kstate.U_INITOK, 1)
    } else {
        while k < 3 {
            kstate.set8(abuf + k, a_sh[k as usize])
            k = k + 1
        }
        // ============== RUNDE BLECH-HID: DER NOTAUSGANG OHNE TASTATUR
        //
        // Justins Rechner hat den Stick gestartet, ein Bild gezeigt --
        // und keine Eingabe angenommen. Damit war JEDER Befehl
        // unerreichbar: `dhcp`, `host`, `fetch`, `ota`. Ein System, das
        // sich nur mit einer Tastatur befragen laesst, ist auf einem
        // Rechner ohne Tastatur nicht messbar.
        //
        // `netlauf` gibt der Shell ein ARGUMENT mit, und `/bin/sh`
        // kann seit Runde K11 ein Skript als Ganzes lesen (`u_start`,
        // `run_script`). Der Arg-Puffer ist eine Folge
        // nullterminierter Zeichenketten; "sh\0" steht schon darin,
        // dahinter kommt der Pfad, und `argc` wird zwei.
        //
        // Danach haelt `hwdiag.park_after_shell` den Schirm an -- ohne
        // das waere das Ergebnis eine Zehntelsekunde zu sehen.
        if kstate.mode_on(state, kstate.M_NETLAUF) {
            var j: u64 = 0
            while j < 17 {
                kstate.set8(abuf + 3 + j, a_nlauf[j as usize])
                j = j + 1
            }
            argn = 2
        }
    }
    // EINE ZEILE NUR DANN, WENN SICH ETWAS AENDERT -- und sie enthaelt
    // ABSICHTLICH KEINEN PFAD. Der erste Entwurf schrieb
    // `osum: first = /sbin/init`, und Abschnitt 5 von `./test.sh` hat
    // das zu Recht als Fehler gemeldet: dort steht seit Runde K1 die
    // Zusage, dass in einem bestimmten Lauf die Zeichenfolge `bin/`
    // NIRGENDS in der Ausgabe vorkommt (der Beweis, dass `ls` dort kein
    // Verzeichnis mehr auflistet) -- und `/sbin/init` enthaelt `bin/`
    // ebenso wie `/bin/sh`. Ohne init bleibt die Ausgabe deshalb Oktett
    // fuer Oktett die der Runden K1 bis K12.
    if use_init {
        var s_first: [u8; 16] = "osum: pid1 init\0"
        serial.puts((&s_first[0]) as u64)
        serial.nl()
    }
    // PID 1 GEHOERT DEM ERSTEN PROZESS, und bis zu dieser Runde gehoerte
    // sie der BOOTAUFGABE (`sched.init` setzt sie dort seit Runde 62).
    // Das war richtig, solange es keinen ersten Prozess gab: die
    // Bootaufgabe ist der Anfang jeder Elternkette und musste eine
    // Nummer haben. Jetzt gibt es einen, und `init` prueft als erstes,
    // ob er sie hat -- ein `init`, das irgendwo mittendrin laeuft,
    // wuerde fremde Kinder einsammeln.
    //
    // Also getauscht: die Bootaufgabe nimmt die naechste freie Nummer,
    // der Zaehler geht auf 1, und die Aufgabe, die gleich entsteht,
    // bekommt sie. Danach laeuft der Zaehler dort weiter, wo er war --
    // sonst bekaeme der naechste Prozess die 2, die die Leerlaufaufgabe
    // schon hat.
    //
    // ES GESCHIEHT NUR, WENN WIRKLICH `/sbin/init` STARTET. Jedes Abbild
    // der Runden K1 bis K12 hat keines, und dort aendert sich damit
    // keine einzige Zahl -- die Bootaufgabe behaelt ihre 1, und alle
    // Messungen dieser Runden messen, was sie gemessen haben.
    var keep: u64 = 0
    if use_init {
        keep = kstate.get(state, kstate.NEXT_PID)
        sched.tset(state, 0, sched.T_PID, keep)
        kstate.set(state, kstate.NEXT_PID, 1)
    }
    let before: u64 = mem.frames_free(state)
    let t: u64 = elf.spawn(state, first, abuf, argn, 2)
    if use_init {
        kstate.set(state, kstate.NEXT_PID, keep + 1)
    }
    if t == 0 {
        serial.puts((&s_fail[0]) as u64)
        serial.nl()
        elf.say_reason(kstate.get(state, kstate.ELF_ERR))
        return
    }
    // DER PLATZ DES PROZESSES 1, damit `sched.reparent` die Waisen
    // dorthin haengen kann. Um eins erhoeht, damit die Null weiter
    // "es gibt keinen" heisst -- ohne init bleibt alles wie vorher, und
    // genau das misst die Gegenprobe.
    if use_init {
        kstate.set(state, kstate.K13_OFF + kstate.U_INITSLOT, t + 1)
    }
    // No line of its own for the pid: `elf.spawn` printed it BEFORE the
    // task became runnable (`elf: start ...`), and anything this task
    // prints afterwards races with the shell, which is already running.
    // Round K1 had that race in the measurement for a while -- the two
    // compilers produced the same system and different transcripts.
    let code: u64 = wait_long(state, t)
    serial.puts((&s_exit[0]) as u64)
    serial.dec(code)
    serial.nl()
    // Every frame the image took has to come back with the process. The
    // guard compares these two numbers -- a loader that leaked a page per
    // program would show up here and nowhere else.
    serial.puts((&s_free[0]) as u64)
    serial.dec(mem.frames_free(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(before)
    serial.nl()
    say_k14(state)
    say_posix(state)
    perm.report(state)
    usb.report(state)
    netview.report(state)
    netmon.report(state)
    share.report(state)
    // ROUND POWERMON: the same numbers ring 3 reads, on the serial line,
    // so the acceptance run can hold the two sides against each other.
    pmon.report(state)
    // RUNDE BLECH-HID: der Selbstlauf soll LESBAR stehen bleiben.
    hwdiag.park_after_shell(state)
}

// ROUND K4: what the system call layer did in this run. Six counters, one
// line -- and every one of them is a number `tools/posix/run.sh` reads
// back. A round that adds `fork` and cannot say how often it forked has
// nothing to show when the number is wrong.
fn say_posix(state: u64) {
    var s_head: [u8; 17] = "osum: syscalls=\0\0"
    var s_fork: [u8; 8] = " forks=\0"
    var s_exec: [u8; 10] = " execves=\0"
    var s_pipe: [u8; 8] = " pipes=\0"
    var s_map: [u8; 7] = " maps=\0"
    var s_open: [u8; 8] = " opens=\0"
    serial.puts((&s_head[0]) as u64)
    serial.dec(kstate.get(state, kstate.SYSCALLS))
    serial.puts((&s_fork[0]) as u64)
    serial.dec(kstate.get(state, kstate.FORKS))
    serial.puts((&s_exec[0]) as u64)
    serial.dec(kstate.get(state, kstate.EXECVES))
    serial.puts((&s_pipe[0]) as u64)
    serial.dec(kstate.get(state, kstate.PIPES))
    serial.puts((&s_map[0]) as u64)
    serial.dec(kstate.get(state, kstate.MAPS))
    serial.puts((&s_open[0]) as u64)
    serial.dec(kstate.get(state, kstate.OPENS))
    serial.nl()
    say_k16(state)
}

// RUNDE K16: drei Zahlen, an denen die Abnahme misst, und jede von ihnen
// ist die Grundlage einer GEGENPROBE.
//
//   stackgrow  wie viele Stapelseiten bei Bedarf entstanden sind. Mit
//              `nostackgrow` MUSS hier null stehen -- und der
//              Uebersetzer MUSS dann sterben.
//   shebangs   wie oft `execve` ein `#!` gefunden hat.
//   ftype      wie oft eine Datei eingeordnet wurde, und wie oft davon
//              am INHALT statt am Namen.
fn say_k16(state: u64) {
    var s_h: [u8; 18] = "osum: stackgrow=\0\0"
    var s_sb: [u8; 12] = " shebangs=\0\0"
    var s_ft: [u8; 9] = " ftype=\0\0"
    var s_mg: [u8; 10] = " magisch=\0"
    var s_ex: [u8; 10] = " endung=\0\0"
    let sk: u64 = kstate.K16_OFF + kstate.FT_SCALARS
    serial.puts((&s_h[0]) as u64)
    serial.dec(kstate.get(state, kstate.STACKGROW))
    serial.puts((&s_sb[0]) as u64)
    serial.dec(kstate.get(state, sk + kstate.FT_SHEBANGS))
    serial.puts((&s_ft[0]) as u64)
    serial.dec(kstate.get(state, sk + kstate.FT_CLASSIFIED))
    serial.puts((&s_mg[0]) as u64)
    serial.dec(kstate.get(state, sk + kstate.FT_BY_MAGIC))
    serial.puts((&s_ex[0]) as u64)
    serial.dec(kstate.get(state, sk + kstate.FT_BY_EXT))
    serial.nl()
}

// `wait_for` gives a process twenty seconds, which is right for a program
// that only computes. A shell waits for a person. This one waits ten
// times as long; what ends the run is the console going quiet
// (`sys.KEY_IDLE`), not this bound.
fn wait_long(state: u64, i: u64) -> u64 {
    if i == 0 {
        return 0xFFFFFFFFFFFFFFFF
    }
    var s_deep: [u8; 22] = "osum: kstack deepest=\0"
    var s_of: [u8; 5] = " of \0"
    var rounds: u64 = 0
    while rounds < 20000 {
        if sched.tget(state, i, sched.T_STATE) == sched.S_ZOMBIE {
            let code: u64 = sched.tget(state, i, sched.T_EXIT)
            // Before the stack goes back to the frame allocator: how much
            // of it was ever touched. The deepest system call of this
            // round runs on exactly this stack.
            serial.puts((&s_deep[0]) as u64)
            serial.dec(sched.stack_high(state, i))
            serial.puts((&s_of[0]) as u64)
            serial.dec(sched.KSTACK_FRAMES * mem.FRAME_SIZE)
            serial.nl()
            proc.reap(state, i)
            return code
        }
        sched.sleep_ticks(state, 1)
        rounds = rounds + 1
    }
    return 0xFFFFFFFFFFFFFFFE
}

// ---------------------------------------------------------- a real disk

// The same file system, one layer lower: not the RAM disk any more but a
// drive over ATA PIO. `tools/kernel/run.sh` hands QEMU an image for it
// and looks INTO that image afterwards -- what the kernel wrote has to be
// in the file on the host.
fn ata_disk(state: u64) {
    var s_off: [u8; 13] = "ata: skipped\0"
    var s_no: [u8; 14] = "ata: no drive\0"
    var s_yes: [u8; 21] = "ata: drive present\0\0\0"
    var s_fmt: [u8; 13] = "ata: format \0"
    var s_mount: [u8; 10] = "  mount=\0\0"
    var s_io: [u8; 13] = "ata: wrote=\0\0"
    var s_read: [u8; 8] = "  read=\0"
    var s_same: [u8; 8] = "  same=\0"
    var s_list: [u8; 11] = "ata: list \0"
    var p_file: [u8; 9] = "/ata.txt\0"
    var p_root: [u8; 2] = "/\0"
    var text: [u8; 30] = "ata disk holds this line r62\n\0"

    // ROUND K1: `ata_disk` FORMATS the drive. With `osum` the drive
    // carries the file system the host built, and formatting it would
    // throw the whole userland away before the first program runs.
    if !(kstate.mode_on(state, kstate.M_ATA)
         && !kstate.mode_on(state, kstate.M_OSUM)) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    if !blk.present(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    blk.use_ata(state, DISK_BLOCKS)
    serial.puts((&s_yes[0]) as u64)
    serial.nl()
    serial.puts((&s_fmt[0]) as u64)
    serial.dec(kutil.yes(fs.format(state)))
    serial.puts((&s_mount[0]) as u64)
    serial.dec(kutil.yes(fs.mount(state)))
    serial.nl()
    let ino: u64 = fs.create_path(state, (&p_file[0]) as u64, fs.T_FILE)
    let wrote: u64 = fs.write_at(state, ino, 0, (&text[0]) as u64, 29)
    let scratch: u64 = state + kstate.BLOCK_OFF
    let got: u64 = fs.read_at(state, ino, 0, scratch, 64)
    serial.puts((&s_io[0]) as u64)
    serial.dec(wrote)
    serial.puts((&s_read[0]) as u64)
    serial.dec(got)
    serial.puts((&s_same[0]) as u64)
    serial.dec(same(scratch, (&text[0]) as u64, 29))
    serial.nl()
    list_dir(state, (&p_root[0]) as u64, (&s_list[0]) as u64)
}

// ---------------------------------------------------------- the keyboard

fn keyboard(state: u64) {
    var s_ready: [u8; 12] = "kbd: ready\0\0"
    var s_got: [u8; 6] = "kbd: \0"
    var s_none: [u8; 7] = "(none)\0"
    if kstate.mode_on(state, kstate.M_NOKBD)
       || kstate.mode_on(state, kstate.M_NOTIMER) {
        return
    }
    // ROUND K1: with `osum` the keys belong to the shell, not to this
    // demonstration -- and waiting 2.5 seconds for four of them here
    // would only delay it.
    if kstate.mode_on(state, kstate.M_OSUM) {
        return
    }
    serial.puts((&s_ready[0]) as u64)
    serial.nl()
    let start: u64 = kstate.get(state, kstate.TICKS)
    var waiting: bool = true
    while waiting {
        if kstate.get(state, kstate.KEYLEN) >= KEYS_WANTED {
            waiting = false
        }
        if kstate.get(state, kstate.TICKS) - start >= KEY_TIMEOUT {
            waiting = false
        }
        if waiting {
            idt.halt()
        }
    }
    serial.puts((&s_got[0]) as u64)
    let n: u64 = kstate.get(state, kstate.KEYLEN)
    if n == 0 {
        serial.puts((&s_none[0]) as u64)
    } else {
        serial.text(state + kstate.KEYBUF, n)
    }
    serial.nl()
}

// ------------------------------------------------------------- ring 3

// ==================================================== RUNDE K18
//
// DIE ENERGIESCHICHT WIRD ANGESCHALTET UND MELDET, WAS SIE VORFINDET.
//
// Die Reihenfolge ist nicht beliebig:
//
//   1. `pwr.probe` fragt den PROZESSOR (CPUID und ein paar MSR): gibt es
//      SpeedStep, HWP, Turbo, MONITOR/MWAIT, eine Temperaturanzeige, und
//      welche Taktstufen nennt die Maschine?
//   2. `batt.scan` fragt die FIRMWARE (die ACPI-Tabellen): gibt es einen
//      Akku, ein Netzteil, eine Thermalzone?
//   3. Was dabei an Temperatur herauskam, wird in die Energieschicht
//      gereicht. Die beiden Dateien importieren einander NICHT -- ein
//      Modulgraph mit einem Kreis darin uebersetzt nicht, und ein Wort
//      hier ist billiger als eine dritte Datei dazwischen.
//   4. Erst dann wird ein Profil gesetzt. "Ausgeglichen" ist der
//      Anfangswert, wie bei jedem System, das diese drei Schalter hat.
//
// Alles, was gemeldet wird, ist eine Zahl in der Form `pwr: NAME=WERT`
// -- der Testlauf liest sie zeilenweise, und was der Kernel nicht
// wirklich gelesen hat, meldet er als `ok=0` statt als Null in Grad
// Celsius.
fn power_stage(state: u64) {
    var s_off: [u8; 14] = "pwr: skipped\0\0"
    if kstate.mode_on(state, kstate.M_NOPWR) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    pwr.probe(state)
    batt.scan(state)
    // Die Thermalzone aus den Tabellen in die Energieschicht reichen.
    if batt.value(state, batt.BT_TZOK) != 0 {
        kstate.set(state, kstate.K18_OFF + pwr.PW_TZRAW,
            batt.value(state, batt.BT_TZ))
        kstate.set(state, kstate.K18_OFF + pwr.PW_CAPS,
            pwr.caps(state) | pwr.C_ACPITZ)
    }
    // `pwrhot` taeuscht eine Temperatur ueber der Schwelle vor. NUR zum
    // Fehlersuchen -- die Abnahme benutzt dafuer eine echte SSDT.
    if kstate.mode_on(state, kstate.M_PWRHOT) {
        kstate.set(state, kstate.K18_OFF + pwr.PW_TZRAW, 3632) // 90 Grad
    }
    pwr.set_profile(state, pwr.PROF_BALANCED)
    pwr.throttle_check(state)
    // ROUND POWERMON: the accounting starts HERE and not in `pmon.parse`.
    // Its sample walks the ACPI tables, and the tables are only good for
    // walking once `batt.scan` above has been over them.
    pmon.arm(state)
    power_report(state)
}





fn power_report(state: u64) {
    var n_caps: [u8; 5] = "caps\0"
    var n_prof: [u8; 8] = "profile\0"
    var n_rat: [u8; 7] = "ratios\0"
    var n_rsrc: [u8; 10] = "ratiosrc\0\0"
    var n_pc: [u8; 8] = "perfctl\0"
    var n_pb: [u8; 9] = "perfback\0"
    var n_hw: [u8; 7] = "hwpreq\0"
    var n_hb: [u8; 8] = "hwpback\0"
    var n_mi: [u8; 5] = "misc\0"
    var n_mb: [u8; 9] = "miscback\0"
    var n_mo: [u8; 9] = "miscorig\0"
    var n_cst: [u8; 7] = "cstate\0"
    var n_tmp: [u8; 5] = "temp\0"
    var n_tok: [u8; 8] = "tempok\0\0"
    var n_tjm: [u8; 6] = "tjmax\0"
    var n_thr: [u8; 10] = "throttles\0"
    var n_ap: [u8; 8] = "applies\0"
    var n_tz: [u8; 6] = "tzraw\0"
    kutil.phex((&n_caps[0]) as u64, pwr.caps(state))
    kutil.pnum((&n_prof[0]) as u64, pwr.cur_profile(state))
    kutil.phex((&n_rat[0]) as u64, pwr.value(state, pwr.PW_RATIOS))
    kutil.pnum((&n_rsrc[0]) as u64, pwr.value(state, pwr.PW_RATIOSRC))
    kutil.phex((&n_pc[0]) as u64, pwr.value(state, pwr.PW_PERFCTL))
    kutil.phex((&n_pb[0]) as u64, pwr.value(state, pwr.PW_PERFBACK))
    kutil.phex((&n_hw[0]) as u64, pwr.value(state, pwr.PW_HWPREQ))
    kutil.phex((&n_hb[0]) as u64, pwr.value(state, pwr.PW_HWPBACK))
    kutil.phex((&n_mi[0]) as u64, pwr.value(state, pwr.PW_MISC))
    kutil.phex((&n_mb[0]) as u64, pwr.value(state, pwr.PW_MISCBACK))
    kutil.phex((&n_mo[0]) as u64, pwr.value(state, pwr.PW_MISCORIG))
    kutil.pnum((&n_cst[0]) as u64, pwr.value(state, pwr.PW_CSTATE))
    kutil.pnum((&n_tmp[0]) as u64, pwr.temp_c(state))
    kutil.pnum((&n_tok[0]) as u64, pwr.value(state, pwr.PW_TEMPOK))
    kutil.pnum((&n_tjm[0]) as u64, pwr.value(state, pwr.PW_TJMAX))
    kutil.pnum((&n_thr[0]) as u64, pwr.value(state, pwr.PW_THROTTLES))
    kutil.pnum((&n_ap[0]) as u64, pwr.value(state, pwr.PW_APPLIES))
    kutil.pnum((&n_tz[0]) as u64, pwr.value(state, pwr.PW_TZRAW))
    // UND DIE AKKUWERTE. Sie stehen hier, damit der Testlauf die
    // Meldung des KERNELS gegen das halten kann, was `/bin/power` aus
    // RING 3 ueber `syscall` herausbekommt. Gehen die beiden
    // auseinander, ist die Schnittstelle kaputt -- und ohne diese Zeilen
    // gaebe es die eine Haelfte des Vergleichs gar nicht.
    var n_bpres: [u8; 11] = "batpresent\0"
    var n_bpct: [u8; 8] = "percent\0"
    var n_bmin: [u8; 8] = "minutes\0"
    var n_bre: [u8; 10] = "batremain\0"
    var n_bfull: [u8; 8] = "batfull\0"
    var n_brt: [u8; 8] = "batrate\0"
    var n_bst: [u8; 9] = "batstate\0"
    var n_bac: [u8; 3] = "ac\0"
    var n_bacok: [u8; 5] = "acok\0"
    var n_btab: [u8; 7] = "tables\0"
    var vor: u64 = 0
    if batt.present(state) {
        vor = 1
    }
    kutil.pnum((&n_bpres[0]) as u64, vor)
    kutil.pnum((&n_bpct[0]) as u64, batt.percent(state))
    kutil.pnum((&n_bmin[0]) as u64, batt.minutes(state))
    kutil.pnum((&n_bre[0]) as u64, batt.value(state, batt.BT_REMAIN))
    kutil.pnum((&n_bfull[0]) as u64, batt.value(state, batt.BT_FULL))
    kutil.pnum((&n_brt[0]) as u64, batt.value(state, batt.BT_RATE))
    kutil.pnum((&n_bst[0]) as u64, batt.value(state, batt.BT_STATE))
    var netz: u64 = 0
    if batt.ac_online(state) {
        netz = 1
    }
    var nok: u64 = 0
    if batt.ac_known(state) {
        nok = 1
    }
    kutil.pnum((&n_bac[0]) as u64, netz)
    kutil.pnum((&n_bacok[0]) as u64, nok)
    kutil.pnum((&n_btab[0]) as u64, batt.value(state, batt.BT_TABLES))
}

// RUNDE K18: DIE ENERGIESCHICHT, GEMESSEN AUS RING 3.
//
// Warum aus Ring 3 und nicht aus dem Kernel: eine Zahl, die den Weg
// durch `syscall` gegangen ist, ist wirklich durch die Schnittstelle
// gekommen -- und die Schnittstelle ist das, was `/bin/power` benutzt.
// Der Kernel meldet dieselben Werte oben in `power_report`; dass beide
// Wege dasselbe sagen, ist eine der Zusagen dieser Runde.
//
// Danach zweimal dasselbe mit verschiedener Beschaeftigung: ein
// Programm, das SCHLAEFT (dann laeuft der Leerlaufpfad), und eines, das
// RECHNET (dann laeuft er nicht). Der Unterschied zwischen den beiden
// Zaehlerstaenden ist die Messung von 4.2 -- und er kommt aus der
// Beschaeftigung der Maschine, nicht aus einem Schalter.
fn power_test(state: u64) {
    var s_skip: [u8; 19] = "k18: skipped\0\0\0\0\0\0\0"
    var s_beg: [u8; 12] = "k18: begin\0\0"
    var s_exit: [u8; 18] = "k18: ring3 exit=\0\0"
    var n_mA: [u8; 12] = "mwaits_load\0"
    var n_hA: [u8; 10] = "hlts_load\0"
    var n_iA: [u8; 14] = "idleruns_load\0"
    var n_mB: [u8; 12] = "mwaits_idle\0"
    var n_hB: [u8; 10] = "hlts_idle\0"
    var n_iB: [u8; 14] = "idleruns_idle\0"
    if !kstate.mode_on(state, kstate.M_PWR) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_beg[0]) as u64)
    serial.nl()
    let t: u64 = proc.create(state, P_PWR, 0, 2)
    let e: u64 = kutil.wait_for(state, t)
    serial.puts((&s_exit[0]) as u64)
    serial.dec(e)
    serial.nl()

    // 1. RECHNEN. Solange das laeuft, ist der Kern beschaeftigt.
    let m0: u64 = pwr.value(state, pwr.PW_MWAITS)
    let h0: u64 = pwr.value(state, pwr.PW_HLTS)
    let i0: u64 = pwr.value(state, pwr.PW_IDLERUNS)
    let l: u64 = proc.create(state, P_PWRLOAD, 4000000, 2)
    kutil.wait_for(state, l)
    kpair((&n_mA[0]) as u64, pwr.value(state, pwr.PW_MWAITS) -% m0)
    kpair((&n_hA[0]) as u64, pwr.value(state, pwr.PW_HLTS) -% h0)
    kpair((&n_iA[0]) as u64, pwr.value(state, pwr.PW_IDLERUNS) -% i0)

    // 2. SCHLAFEN. Jetzt hat der Kern nichts zu tun.
    let m1: u64 = pwr.value(state, pwr.PW_MWAITS)
    let h1: u64 = pwr.value(state, pwr.PW_HLTS)
    let i1: u64 = pwr.value(state, pwr.PW_IDLERUNS)
    let d: u64 = proc.create(state, P_PWRIDLE, 800, 2)
    kutil.wait_for(state, d)
    kpair((&n_mB[0]) as u64, pwr.value(state, pwr.PW_MWAITS) -% m1)
    kpair((&n_hB[0]) as u64, pwr.value(state, pwr.PW_HLTS) -% h1)
    kpair((&n_iB[0]) as u64, pwr.value(state, pwr.PW_IDLERUNS) -% i1)
}

fn kpair(name: u64, v: u64) {
    var s_h: [u8; 6] = "k18: \0"
    var s_m: [u8; 4] = " = \0"
    serial.puts((&s_h[0]) as u64)
    serial.puts(name)
    serial.puts((&s_m[0]) as u64)
    serial.dec(v)
    serial.nl()
}

fn ring3(state: u64) {
    var s_off: [u8; 20] = "ring3: skipped\0\0\0\0\0\0"
    var s_bad: [u8; 15] = "ring3: FAILED\0\0"
    if kstate.mode_on(state, kstate.M_NORING3) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    if !user.run(state) {
        serial.puts((&s_bad[0]) as u64)
        serial.nl()
    }
}

// ------------------------------------------------- the deliberate faults

// The kernel provokes the fault itself, so that the report can be
// checked. Each one of them ends in `trap.report` -- and there in
// `power.shutdown`.
fn provoke(state: u64) {
    var s_go: [u8; 22] = "trap: provoking kind \0"
    // DIE TRAP-ART IST EIN FELD, KEIN SCHALTER: Wort 0, Bits 0..2,
    // Werte 1..4. Bis Runde K17 stand hier `& 0xFF`, und damit
    // gehoerten die Bits 3..7 faktisch niemandem -- ein Schalter
    // dort haette einen Prozessorfehler ausgeloest.
    let kind: u64 = kstate.mode_word(state, 0) & 0x7
    if kind == 0 {
        return
    }
    serial.puts((&s_go[0]) as u64)
    serial.dec(kind)
    serial.nl()
    if kind == 1 {
        // #DE, provoked in ASSEMBLY since round 83. It used to be a plain
        // `42 / zero` with the divisor read out of the data area so that no
        // pass could fold it away -- and that stopped reaching the
        // processor the moment the checked arithmetic of round 72 arrived:
        // `dev`/`dev-fast`/`release-safe` catch a division by zero BEFORE
        // the `div` instruction and hand it to the panic path, which in a
        // kernel is `osum_panic` and never comes back. That is the round
        // working, not the round breaking the kernel -- but what this test
        // wants to see is the CPU's own exception and the report `trap.fi`
        // writes for it, so the division goes past the language.
        asm("xor rdx, rdx\nmov rax, 42\nxor rcx, rcx\ndiv rcx")
        kstate.set(state, kstate.LAST_TRAP, 42)
    }
    if kind == 2 {
        // #PF at exactly the first octet that boot.s did not map.
        kstate.set(state, kstate.LAST_TRAP, __mmio_read64(0x40000000 as *mut u64))
    }
    if kind == 3 {
        // #GP: an address that is not canonical.
        __mmio_write64(0x0000800000000000 as *mut u64, 1)
    }
    if kind == 4 {
        // #DF: a fault whose report faults again, because rsp is
        // unusable. Only IST1 catches this.
        asm("mov rsp, 0\npush rax")
    }
}

// --------------------------------------------------------- command line

// Bits 0..7 = kind of fault, bit 8 = no keyboard, bit 9 = no ring 3.
fn mode_of(state: u64, cmd: u64) {
    var s_trap: [u8; 6] = "trap=\0"
    var nokbd: [u8; 6] = "nokbd\0"
    var noring: [u8; 8] = "noring3\0"
    var notimer: [u8; 8] = "notimer\0"
    var dtaf: [u8; 6] = "tafel\0"
    var dnos: [u8; 9] = "noserial\0"
    var dfbf: [u8; 8] = "fbflush\0"
    var dherz: [u8; 5] = "herz\0"
    var dnhub: [u8; 6] = "nohub\0"
    var dusaf: [u8; 8] = "usbsafe\0"
    var dnotaf: [u8; 8] = "notafel\0"
    var dnores: [u8; 11] = "usbnoreset\0"
    // RUNDE BLECHFUENF: drei neue Woerter. `absturzhalt` haelt bei einer
    // Ausnahme an und schreibt sie auf den Schirm; `pulsled` bringt den
    // LED-Herzschlag zurueck (Vorgabe: AUS, die Lampen gehoeren dem
    // Menschen); `nopuls` haelt die Diagnosezeile aus dem Terminal.
    var dabst: [u8; 12] = "absturzhalt\0"
    var dpled: [u8; 8] = "pulsled\0"
    var dnopu: [u8; 7] = "nopuls\0"
    var dzuma: [u8; 9] = "zumachen\0"
    var dtz: [u8; 4] = "tz=\0"
    var dknall: [u8; 6] = "knall\0"
    var r3fault: [u8; 11] = "ring3fault\0"
    var nosched: [u8; 8] = "nosched\0"
    var nopre: [u8; 10] = "nopreempt\0"
    var noproc: [u8; 7] = "noproc\0"
    var nofs: [u8; 5] = "nofs\0"
    var ata: [u8; 4] = "ata\0"
    var script: [u8; 8] = "script=\0"
    if cmd == 0 {
        return
    }
    let at_trap: u64 = find(cmd, (&s_trap[0]) as u64, 5)
    if at_trap != 0 {
        let a: u64 = kstate.get8(at_trap + 5)
        let b: u64 = kstate.get8(at_trap + 6)
        // Bits 0..2 von Wort 0 sind ein FELD (die Art), kein Schalter.
        if a == 100 && b == 101 {
            kstate.set(state, kstate.MODE, 1) // de
        }
        if a == 112 && b == 102 {
            kstate.set(state, kstate.MODE, 2) // pf
        }
        if a == 103 && b == 112 {
            kstate.set(state, kstate.MODE, 3) // gp
        }
        if a == 100 && b == 102 {
            kstate.set(state, kstate.MODE, 4) // df
        }
    }
    var osumw: [u8; 5] = "osum\0"
    var nobss: [u8; 6] = "nobss\0"
    if find(cmd, (&osumw[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_OSUM)
    }
    if find(cmd, (&nobss[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOBSS)
    }
    if find(cmd, (&nokbd[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOKBD)
    }
    if find(cmd, (&noring[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NORING3)
    }
    // RUNDE STANDBILD: die Messtafel wird ausdruecklich eingeschaltet.
    // RUNDE BLECHDREI: `notafel` gewinnt -- und es MUSS zuerst gefragt
    // werden, weil das Wort "tafel" in "notafel" steckt und `find` es
    // dort auch findet. Wer nur auf "tafel" prueft, schaltet mit dem
    // Ausschalter ein.
    let aus_tafel: bool = find(cmd, (&dnotaf[0]) as u64, 7) != 0
    if aus_tafel {
        kstate.mode_add(state, kstate.M_NOTAFEL)
    } else if find(cmd, (&dtaf[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_TAFEL)
    }
    // ================================ RUNDE BLECHEINGABE: VIER WOERTER.
    // `fbflush` -- nach jedem Blit `wbinvd` (Justins zweiter, von `fbuc`
    //              unabhaengiger Beweis derselben Ursache).
    // `herz`    -- die zwei Blinkfelder und die Lampe der Tastatur.
    // `nohub`   -- den Hub-Treiber stilllegen (Gegenprobe).
    // `usbsafe` -- der Zeitgeber sieht gar nicht mehr nach Anschluessen.
    if find(cmd, (&dfbf[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_FBFLUSH)
    }
    if find(cmd, (&dherz[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_HERZ)
    }
    if find(cmd, (&dnhub[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOHUB)
    }
    if find(cmd, (&dusaf[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_USBSAFE)
    }
    // RUNDE BLECHVIER: die Gegenprobe zur erzwungenen Ruecksetzung.
    if find(cmd, (&dnores[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_USBNORESET)
    }
    // RUNDE BLECHFUENF.
    if find(cmd, (&dabst[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_ABSTURZ)
    }
    if find(cmd, (&dpled[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_PULSLED)
    }
    if find(cmd, (&dnopu[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_NOPULS)
    }
    if find(cmd, (&dzuma[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_ZUMACHEN)
    }
    if find(cmd, (&dknall[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_KNALL)
    }
    // RUNDE BLECHFUENF: `tz=<minuten>` -- der Versatz auf Ortszeit.
    let tzp: u64 = find(cmd, (&dtz[0]) as u64, 3)
    if tzp != 0 {
        var tzv: u64 = 0
        var tzi: u64 = tzp + 3
        var tzn: u64 = 0
        while tzn < 5 && kstate.get8(tzi) >= 48 && kstate.get8(tzi) <= 57 {
            tzv = tzv * 10 + (kstate.get8(tzi) - 48)
            tzi = tzi + 1
            tzn = tzn + 1
        }
        if tzn != 0 {
            time.set_tz(state, tzv)
        }
    }
    // RUNDE KABEL: die Leitung von Hand stilllegen.
    if find(cmd, (&dnos[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOSERIAL)
        serial.set_aus(1)
    }
    if find(cmd, (&notimer[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOTIMER)
    }
    if find(cmd, (&r3fault[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_R3FAULT)
    }
    if find(cmd, (&nosched[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOSCHED)
    }
    if find(cmd, (&nopre[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_NOPREEMPT)
    }
    if find(cmd, (&noproc[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_NOPROC)
    }
    // RUNDE MESSTAFEL: die Sprache der Oberflaeche aus dem Bootmenue.
    var l_en: [u8; 8] = "lang=en\0"
    var l_de: [u8; 8] = "lang=de\0"
    if find(cmd, (&l_en[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_LANGEN)
    }
    if find(cmd, (&l_de[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_LANGDE)
    }
    if find(cmd, (&nofs[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_NOFS)
    }
    if find(cmd, (&ata[0]) as u64, 3) != 0 {
        kstate.mode_add(state, kstate.M_ATA)
    }
    var capsw: [u8; 5] = "caps\0"
    if find(cmd, (&capsw[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_CAPS)
    }
    // ROUND K9. `unix` schaltet den Selbsttest dieser Runde ein, `nosig`
    // und `fixedrand` sind die beiden GEGENPROBEN dazu -- ohne sie
    // beweist die Runde nichts.
    var unixw: [u8; 5] = "unix\0"
    var nosigw: [u8; 6] = "nosig\0"
    var fixrw: [u8; 10] = "fixedrand\0"
    // ROUNDE K10. `wm` schaltet Maus, Fensterserver und Schriften an;
    // `nodirty`, `nofocus` und `nomouse` sind die drei GEGENPROBEN
    // dazu, `wmhold` haelt fuer das Bildschirmfoto still und `wmshell`
    // startet die Shell im Terminalfenster.
    var wmw: [u8; 3] = "wm\0"
    var ndw: [u8; 8] = "nodirty\0"
    var nfw: [u8; 8] = "nofocus\0"
    var nmw: [u8; 8] = "nomouse\0"
    var whw: [u8; 7] = "wmhold\0"
    var wsw: [u8; 8] = "wmshell\0"
    var npw: [u8; 8] = "nompoll\0"
    var tdw: [u8; 9] = "ttfdump\0\0"
    // RUNDE K13. `k13` schaltet den Selbsttest dieser Runde in Ring 3
    // an; die sechs anderen sind GEGENPROBEN, und ohne sie beweist die
    // Runde nichts. Was sie tun, steht bei ihren Bits in kstate.fi.
    // `k13run` und nicht `k13`: die Kommandozeile wird nach TEILWORTEN
    // durchsucht, und `script=k13t` enthaelt `k13`. Dieser Fehler war
    // eine Stunde lang in dieser Runde und sah aus wie eine Verklemmung
    // im Scheduler -- er war es nicht, es lief nur ein Selbsttest mit,
    // den niemand angefordert hatte.
    var k13w: [u8; 7] = "k13run\0"
    var npw13: [u8; 7] = "noperm\0"
    var ishw: [u8; 7] = "initsh\0"
    var nsuw: [u8; 7] = "nosuid\0"
    var nacw: [u8; 7] = "noacpi\0"
    var v2rw: [u8; 9] = "ofsv2raw\0"
    var zomw: [u8; 7] = "zombie\0"
    var wf1w: [u8; 10] = "waitfirst\0"
    // ===================================================== RUNDE HANDLE
    //
    // `handle` schaltet den Selbsttest an. Die vier danach sind
    // GEGENPROBEN und stehen in kstate.fi bei ihren Bits erklaert;
    // `hbench` ist der Mikrobenchmark der Syscall-Latenz.
    //
    // `hbench` und nicht `bench`: die Kommandozeile wird nach
    // TEILWOERTERN durchsucht, und ein kurzes Wort trifft irgendwann
    // etwas, was es nicht treffen sollte. Runde K13 hat diesen Fehler
    // eine Stunde lang gesucht (siehe `k13run` oben).
    var hndw: [u8; 7] = "handle\0"
    var ngenw: [u8; 6] = "nogen\0"
    var nflw: [u8; 9] = "noflight\0"
    var nrgw: [u8; 9] = "norights\0"
    var hstw: [u8; 8] = "hstrict\0"
    var hbw: [u8; 7] = "hbench\0"
    if find(cmd, (&hndw[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_HANDLE)
    }
    if find(cmd, (&ngenw[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOGEN)
    }
    if find(cmd, (&nflw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOFLIGHT)
    }
    if find(cmd, (&nrgw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NORIGHTS)
    }
    if find(cmd, (&hstw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_HSTRICT)
    }
    if find(cmd, (&hbw[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_HBENCH)
    }
    // RUNDE ASYNC. `async` schaltet den Selbsttest an, `abench` die
    // Messung; die drei danach sind GEGENPROBEN und stehen in
    // `kstate.fi` bei ihren Bits erklaert. Die Woerter sind lang genug,
    // dass die Teilwortsuche nichts anderes trifft -- `abench` und
    // `hbench` unterscheiden sich im ersten Zeichen und sind beide
    // sechs lang.
    var asyw: [u8; 6] = "async\0"
    var abw: [u8; 7] = "abench\0"
    var nagw: [u8; 7] = "noagen\0"
    var narw: [u8; 8] = "noareap\0"
    var nawv: [u8; 8] = "noawork\0"
    var astw: [u8; 8] = "astress\0"
    // RUNDE MODUL: `modul` schaltet den Modullader-Abschnitt ein.
    var mdlw: [u8; 6] = "modul\0"
    var mdaw: [u8; 9] = "modulaus\0"
    if find(cmd, (&asyw[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_ASYNC)
    }
    if find(cmd, (&abw[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_ABENCH)
    }
    if find(cmd, (&nagw[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_NOAGEN)
    }
    if find(cmd, (&narw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOAREAP)
    }
    if find(cmd, (&nawv[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOAWORK)
    }
    if find(cmd, (&astw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_ASTRESS)
    }
    if find(cmd, (&mdlw[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_MODUL)
    }
    if find(cmd, (&mdaw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_MODULAUS)
    }
    if find(cmd, (&k13w[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_K13)
    }
    if find(cmd, (&npw13[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_NOPERM)
    }
    if find(cmd, (&ishw[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_INITSH)
    }
    if find(cmd, (&nsuw[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_NOSUID)
    }
    if find(cmd, (&nacw[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_NOACPI)
    }
    if find(cmd, (&v2rw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_FORCEV2)
    }
    if find(cmd, (&zomw[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_ZOMBIE)
    }
    // ============================================== RUNDE MULTIUSER
    //
    // DREI WOERTER, ZWEI DAVON GEGENPROBEN.
    //
    //   `murun`      den Selbsttest dieser Runde melden lassen.
    //   `nowalk`     das BETRETUNGSRECHT abschalten -- der Zustand vor
    //                dieser Runde: gefragt wird nur nach der Zieldatei,
    //                nicht nach den Verzeichnissen davor. Der Zugriff,
    //                der scheitern MUSS, gelingt dann.
    //   `nogroups`   Zusatzgruppen werden nicht beachtet.
    //
    // `murun` und nicht `mu`: die Kommandozeile wird nach TEILWORTEN
    // durchsucht. Runde K13 hat eine Stunde an genau diesem Fehler
    // gesucht (`script=k13t` enthaelt `k13`), Runde OFS3 hat ihn
    // deshalb vermieden, und diese hier tut es auch.
    var muw: [u8; 6] = "murun\0"
    var nwkw: [u8; 7] = "nowalk\0"
    var ngrw: [u8; 9] = "nogroups\0"
    if find(cmd, (&muw[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_MU)
    }
    if find(cmd, (&nwkw[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_NOWALK)
    }
    if find(cmd, (&ngrw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOGROUPS)
    }
    // RUNDE INIT, GEGENPROBE: das alte `wait4`.
    if find(cmd, (&wf1w[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_WAITOLD)
    }
    // ==================================================== RUNDE OFS3
    //
    // RUNDE OFS3: VIER WOERTER, UND DREI DAVON SIND GEGENPROBEN. Sie
    // standen bis zu diesem Zusammenfuehren in einem EIGENEN Moduswort
    // (`OFS3_MODE`), weil im alten 64-Bit-MODE nur noch Bit 63 frei war
    // und das gesperrt ist -- `fs.enter` benutzt es als Merker fuer eine
    // verschachtelte Sperre. Runde K17 hat den Modus zu einem VEKTOR
    // gemacht; die vier Bits stehen deshalb jetzt in dessen Wort 7 und
    // werden hier gelesen wie jedes andere Wort auch.
    //
    // `ofs3run` und nicht `ofs3`: die Befehlszeile wird nach TEILWORTEN
    // durchsucht, und `ofs3fmt` faengt nicht mit `ofs3` an, aber ein
    // Pfad wie `script=ofs3t` taete es. Runde K13 hat diesen Fehler
    // schon einmal gemacht und eine Stunde lang gesucht.
    var o3w: [u8; 8] = "ofs3run\0"
    var o2fw: [u8; 8] = "ofs3fmt\0"
    var natw: [u8; 8] = "noatime\0"
    var nlkw: [u8; 8] = "nolinks\0"
    if find(cmd, (&o3w[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.O_OFS3)
    }
    if find(cmd, (&o2fw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.O_OFS3FMT)
    }
    if find(cmd, (&natw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.O_NOATIME)
    }
    if find(cmd, (&nlkw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.O_NOLINKS)
    }
    // RUNDE FSROBUST. `jrnlfmt` laesst `fs.format` einen Journalbereich
    // anlegen; `nojournal` schaltet das Journal ab, OBWOHL die Platte
    // eines traegt -- das ist die Gegenprobe der ganzen Runde, und ohne
    // sie waere "der Stromausfall macht keinen Schaden" eine Behauptung
    // ueber sich selbst. `fsrcrash` laesst das Schreibprogramm der
    // Messung endlos laufen, damit der Abschuss immer mitten hinein
    // trifft.
    var jfw: [u8; 8] = "jrnlfmt␀"
    var njw: [u8; 10] = "nojournal␀"
    var fcw: [u8; 9] = "fsrcrash␀"
    if find(cmd, (&jfw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.O_JRNLFMT)
    }
    if find(cmd, (&njw[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.O_NOJRNL)
    }
    if find(cmd, (&fcw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.O_FSRCRASH)
    }
    // RUNDE TILING. `tile` schaltet den Fensterbaum an; `tilefuzz` laesst
    // zehntausend zufaellige Operationen darauf los, `tileshot`,
    // `tiletabs` und `tilerot` bauen die drei Anordnungen fuer die
    // Bildschirmfotos, und `notiledirty` ist die GEGENPROBE zur
    // Teilbaumverfolgung.
    var tiw: [u8; 5] = "tile\0"
    var tfw: [u8; 9] = "tilefuzz\0"
    var tsw: [u8; 9] = "tileshot\0"
    var ttw: [u8; 9] = "tiletabs\0"
    var trw: [u8; 8] = "tilerot\0"
    var ntw: [u8; 12] = "notiledirty\0"
    if find(cmd, (&tiw[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_TILE)
    }
    if find(cmd, (&tfw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_TILEFUZZ)
    }
    if find(cmd, (&tsw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_TILESHOT)
    }
    if find(cmd, (&ttw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_TILETABS)
    }
    if find(cmd, (&trw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_TILEROT)
    }
    if find(cmd, (&ntw[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_NOTILEDIRTY)
    }
    // RUNDE K16: die Gegenprobe zur grossen Arena.
    var nbw: [u8; 9] = "nobigmem\0"
    // ROUND MEM: the stress test of the frame allocator.
    var msw: [u8; 11] = "memstress\0\0"
    var nsw: [u8; 12] = "nostackgrow\0"
    if find(cmd, (&wmw[0]) as u64, 2) != 0 {
        kstate.mode_add(state, kstate.M_WM)
    }
    if find(cmd, (&ndw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NODIRTY)
    }
    if find(cmd, (&nfw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOFOCUS)
    }
    if find(cmd, (&nmw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOMOUSE)
    }
    if find(cmd, (&whw[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_WMHOLD)
    }
    if find(cmd, (&wsw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_WMSHELL)
    }
    if find(cmd, (&npw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOMPOLL)
    }
    if find(cmd, (&tdw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_TTFDUMP)
    }
    if find(cmd, (&nbw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOBIG)
    }
    if find(cmd, (&msw[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_MEMSTRESS)
    }
    if find(cmd, (&nsw[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_NOSTACK)
    }
    // RUNDE K15. `wig` startet die Anwendung, die auf der
    // Widget-Bibliothek sitzt, `wigfiles` den Dateimanager; die beiden
    // Gegenproben `wignohit` und `wignoclip` werden der Anwendung als
    // ARGUMENT durchgereicht, weil die Eigenschaft, die sie abschalten,
    // in Ring 3 liegt und nicht im Kernel. `wiglong` haelt laenger
    // still -- eine Oberflaeche, die von aussen wirklich BEDIENT wird,
    // braucht mehr als fuenf Sekunden fuer zwanzig Monitorbefehle.
    var wgw: [u8; 4] = "wig\0"
    var wfw: [u8; 9] = "wigfiles\0"
    var wnh: [u8; 9] = "wignohit\0"
    var wnc: [u8; 10] = "wignoclip\0"
    var wlw: [u8; 8] = "wiglong\0"
    // NACHTRAG ZU K15: `wigstart` startet den Starter (das Fenster mit
    // dem Suchfeld ueber dem Anwendungsverzeichnis), `wignokeys` ist
    // seine Gegenprobe -- dieselbe Suche ohne die Schluesselwoerter.
    var wsw2: [u8; 9] = "wigstart\0"
    var wnk: [u8; 10] = "wignokeys\0"
    var wni: [u8; 10] = "wignoidx\0\0"
    // RUNDE SPEICHER: `wigspeicher` startet die Speicherplatzanalyse.
    // Sie enthaelt `wig` als Anfang, also setzt die Zeile darueber
    // ohnehin schon M_WIG -- genau wie bei `wigfiles`, und genau
    // deshalb bleibt die Klickaufgabe weg, die sich sonst den
    // Bildschirm mit der Anwendung teilt.
    var wsp: [u8; 12] = "wigspeicher\0"
    // ROUND ICONS: start /bin/icont instead of the widget demo.
    var wic: [u8; 10] = "wigicons\0\0"
    if find(cmd, (&wgw[0]) as u64, 3) != 0 {
        kstate.mode_add(state, kstate.M_WIG)
    }
    if find(cmd, (&wfw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_WIGFILES)
    }
    if find(cmd, (&wnh[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_WIGNOHIT)
    }
    if find(cmd, (&wnc[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_WIGNOCLIP)
    }
    if find(cmd, (&wlw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_WIGLONG)
    }
    if find(cmd, (&wsw2[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_WIGSTART)
    }
    if find(cmd, (&wnk[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_WIGNOKEYS)
    }
    if find(cmd, (&wni[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_WIGNOIDX)
    }
    if find(cmd, (&wsp[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_WIGSPEICHER)
    }
    // RUNDE DESKTOP: der Schreibtisch, die Taskleiste, die
    // Einstellungen, der DHCP-Klient -- und die drei Gegenproben.
    var dkw: [u8; 5] = "desk\0"
    // RUNDE HIDWEG: `wmdauer` -- der Schreibtisch bekommt keine
    // Rundengrenze mehr. Siehe kstate.M_WMDAUER.
    var dwd: [u8; 8] = "wmdauer\0"
    var dew: [u8; 6] = "einst\0"
    // RUNDE I18N: die Gegenprobe fuer das Bildschirmfoto -- ohne den
    // Starter, damit das gemessene Fenster nicht verdeckt ist.
    var nstw: [u8; 8] = "nostart\0"
    var dnl: [u8; 8] = "nolayer\0"
    var dnm: [u8; 6] = "nomin\0"
    var ddh: [u8; 5] = "dhcp\0"
    var dnd: [u8; 7] = "nodhcp\0"
    if find(cmd, (&dkw[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_DESK)
    }
    if find(cmd, (&dwd[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_WMDAUER)
    }
    if find(cmd, (&dew[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_EINST)
    }
    // ZUERST `themeshot`, DANN `themegui` -- die Suche nach "themegui"
    // findet das Wort nicht in "themeshot", aber die Reihenfolge steht
    // hier trotzdem ausdruecklich: bei `dhcp`/`nodhcp` zwanzig Zeilen
    // weiter unten war genau das schon einmal ein Fehler.
    var dts: [u8; 10] = "themeshot\0"
    var dtg: [u8; 9] = "themegui\0"
    if find(cmd, (&dts[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_THEMESHOT)
    }
    if find(cmd, (&dtg[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_THEMEGUI)
    }
    if find(cmd, (&nstw[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOSTART)
    }
    // RUNDE NETVIEW, NACHTRAG.
    var dnv: [u8; 9] = "netvdemo\0"
    if find(cmd, (&dnv[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NETVDEMO)
    }
    if find(cmd, (&dnl[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOLAYER)
    }
    if find(cmd, (&dnm[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOMIN)
    }
    // ZUERST `nodhcp`, DANN `dhcp` -- sonst findet die Suche nach
    // "dhcp" das Wort INNERHALB von "nodhcp" und schaltet beides an.
    // Genau das ist beim Bauen dieser Runde passiert.
    if find(cmd, (&dnd[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_NODHCP)
    }
    if find(cmd, (&ddh[0]) as u64, 4) != 0 {
        if !kstate.mode_on(state, kstate.M_NODHCP) {
            kstate.mode_add(state, kstate.M_DHCP)
        }
    }
    // ADDENDUM TASKBAR: maximize, and the counter-test to the struts.
    var dwm: [u8; 5] = "wmax\0"
    var dns: [u8; 8] = "nostrut\0"
    if find(cmd, (&dwm[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_WMAX)
    }
    if find(cmd, (&dns[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOSTRUT)
    }
    if find(cmd, (&wic[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_WIGICONS)
    }
    // RUNDE K18: die Energieschicht und ihre Gegenproben.
    var pww: [u8; 4] = "pwr\0"
    var pwnc: [u8; 10] = "nocstates\0"
    var pwno: [u8; 6] = "nopwr\0"
    var pwho: [u8; 7] = "pwrhot\0"
    var pwnb: [u8; 8] = "noblank\0"
    if find(cmd, (&pww[0]) as u64, 3) != 0 {
        kstate.mode_add(state, kstate.M_PWR)
    }
    if find(cmd, (&pwnc[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_NOCSTATES)
    }
    if find(cmd, (&pwno[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOPWR)
    }
    if find(cmd, (&pwho[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_PWRHOT)
    }
    if find(cmd, (&pwnb[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOBLANK)
    }
    // RUNDE TRESOR: `hwid` schreibt die Geraeteidentitaet auf die
    // serielle Leitung, `hwidefi` geht den EFI-Weg gegen eine von Hand
    // gebaute Systemtafel.
    var hwdw: [u8; 5] = "hwid\0"
    var hwef: [u8; 8] = "hwidefi\0"
    if find(cmd, (&hwdw[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_HWID)
    }
    if find(cmd, (&hwef[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_HWIDEFI)
    }
    var pwd: [u8; 7] = "pwrdim\0"
    var pwbl: [u8; 9] = "pwrblank\0"
    if find(cmd, (&pwd[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_PWRDIM)
    }
    if find(cmd, (&pwbl[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_PWRBLANK)
    }
    if find(cmd, (&unixw[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_UNIX)
    }
    if find(cmd, (&nosigw[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOSIG)
    }
    if find(cmd, (&fixrw[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_FIXRAND)
    }
    // ROUNDE K14. `vfs` schaltet die Schicht an; alles andere sind
    // GEGENPROBEN, und ohne sie beweist die Runde nichts.
    var w_vfs: [u8; 4] = "vfs␀"
    var w_novfs: [u8; 6] = "novfs␀"
    var w_nopfs: [u8; 9] = "noprocfs␀"
    var w_nodfs: [u8; 8] = "nodevfs␀"
    var w_nofat: [u8; 6] = "nofat␀"
    var w_nopart: [u8; 7] = "nopart␀"
    var w_fatro: [u8; 6] = "fatro␀"
    var w_vfsall: [u8; 7] = "vfsall␀"
    if find(cmd, (&w_vfs[0]) as u64, 3) != 0 {
        kstate.mode_add(state, kstate.M_VFS)
    }
    if find(cmd, (&w_novfs[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOVFS)
    }
    if find(cmd, (&w_nopfs[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOPROCFS)
    }
    if find(cmd, (&w_nodfs[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NODEVFS)
    }
    if find(cmd, (&w_nofat[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOFAT)
    }
    if find(cmd, (&w_nopart[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_NOPART)
    }
    if find(cmd, (&w_fatro[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_FATRO)
    }
    if find(cmd, (&w_vfsall[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_VFSALL)
    }
    // ROUNDE K17. `usb` schaltet den Baum an; die acht anderen sind
    // GEGENPROBEN. `nousb` und nicht `noxhci`: die Gegenprobe soll die
    // GANZE Runde ausschalten und nicht nur den Regler -- und sie darf
    // sich nicht selbst wieder einschalten, weshalb `usb` erst gesucht
    // wird und `nousb` danach das Bit wieder loeschen koennte. Es wird
    // stattdessen ein zweites Bit gesetzt und `usb.stage` sieht beide
    // an; ein Schalter, den sein eigenes Argument aufhebt, ist keiner
    // (die Lehre aus `nic`/`net` in Runde K8).
    var w_usb: [u8; 4] = "usb\0"
    var w_nousb: [u8; 6] = "nousb\0"
    var w_upoll: [u8; 8] = "usbpoll\0"
    var w_nohid: [u8; 6] = "nohid\0"
    var w_nomsc: [u8; 6] = "nomsc\0"
    var w_unplug: [u8; 7] = "unplug\0"
    var w_noirq2: [u8; 9] = "usbnoirq\0"
    var w_stick: [u8; 9] = "usbstick\0"
    var w_hold: [u8; 8] = "usbhold\0"
    // RUNDE BLECH-HID: nach dem USB-Baum anhalten. Enthaelt `usb` und
    // ist damit derselbe Bauplan wie `usbhold`/`usbpoll`: wer den
    // USB-Bericht sehen will, will USB. Eingetragen in
    // tools/hid/worte.py.
    var w_ustop: [u8; 8] = "usbstop\0"
    var w_uleg: [u8; 7] = "usbleg\0"
    var w_nlauf: [u8; 8] = "netlauf\0"
    // RUNDE BLECH: der USB-2.0-Regler. Ein EIGENES Wort und nicht `usb`
    // -- der EHCI ist ein zweiter Treiber neben xHCI und kein Teil des
    // Baums von Runde K17; wer beide Regler in einer Maschine hat, soll
    // sie einzeln einschalten koennen, sonst ist nicht zu sagen, welcher
    // die Tastatur geliefert hat.
    var w_ehci: [u8; 5] = "ehci\0"
    var w_ehcit: [u8; 9] = "ehcitest\0"
    // RUNDE BLECH, NACHTRAG: dasselbe Wort wie `nictab`, eine Etage
    // tiefer. `blktab` faehrt die Plattentabelle OHNE Platte gegen eine
    // eingebaute Klassenliste; `blkself` fragt jeden gefundenen Treiber,
    // was er ueber sich sagen kann.
    var w_btab: [u8; 7] = "blktab\0"
    var w_bself: [u8; 8] = "blkself\0"
    if find(cmd, (&w_btab[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_BLKTAB)
    }
    if find(cmd, (&w_bself[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_BLKSELF)
    }
    if find(cmd, (&w_ehci[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_EHCI)
    }
    if find(cmd, (&w_ehcit[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_EHCITEST)
    }
    if find(cmd, (&w_usb[0]) as u64, 3) != 0 {
        kstate.mode_add(state, kstate.M_USB)
    }
    if find(cmd, (&w_nousb[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOUSB)
    }
    if find(cmd, (&w_upoll[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_USBPOLL)
    }
    if find(cmd, (&w_nohid[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOHID)
    }
    if find(cmd, (&w_nomsc[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOMSC)
    }
    if find(cmd, (&w_unplug[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_UNPLUG)
    }
    if find(cmd, (&w_noirq2[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOUSBIRQ)
    }
    if find(cmd, (&w_stick[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_USBSTICK)
    }
    if find(cmd, (&w_hold[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_USBHOLD)
    }
    if find(cmd, (&w_ustop[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_USBSTOP)
    }
    if find(cmd, (&w_uleg[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_USBLEG)
    }
    if find(cmd, (&w_nlauf[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NETLAUF)
    }
    // RUNDE HID. `hidgen` schaltet den generischen Weg an, `nurboot` ist
    // die GEGENPROBE dazu (nur Boot-Protokoll, wie vor dieser Runde),
    // `hidrep`/`hidpad`/`hidlat`/`hiddump` sind Selbsttests.
    //
    // DIE ERSTEN NAMEN DIESER RUNDE WAREN FALSCH, und der Fehler ist
    // genau der, vor dem der Kommentar zu `nousb` in Runde K17 warnt:
    // `find` vergleicht OKTETTE und kennt keine Wortgrenze. Der Schalter
    // hiess erst `hid` und die Gegenprobe `nohidrep` -- und `nohidrep`
    // enthaelt `nohid`. Damit schaltete die GEGENPROBE des generischen
    // Weges die GANZE USB-Eingabe ab, und der Lauf, der beweisen sollte,
    // dass ohne den Zerleger alles weiterlaeuft, hatte gar kein Geraet
    // mehr. Aufgefallen ist es in `tools/hid/run.sh` an der Zusage
    // "usb-kbd laeuft weiter". Seitdem prueft derselbe Laeufer
    // mechanisch, dass KEIN Moduswort in einem anderen steckt.
    var w_hidrep: [u8; 7] = "hidrep\0"
    var w_hiddump: [u8; 8] = "hiddump\0"
    var w_nohrep: [u8; 8] = "nurboot\0"
    var w_hidlat: [u8; 7] = "hidlat\0"
    var w_hidpad: [u8; 7] = "hidpad\0"
    var w_i2chid: [u8; 7] = "i2chid\0"
    var w_noi2c: [u8; 6] = "noi2c\0"
    var w_hid: [u8; 7] = "hidgen\0"
    if find(cmd, (&w_hidrep[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_HIDREP)
    }
    if find(cmd, (&w_hiddump[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_HIDDUMP)
    }
    if find(cmd, (&w_nohrep[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NURBOOT)
    }
    if find(cmd, (&w_hidlat[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_HIDLAT)
    }
    if find(cmd, (&w_hidpad[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_HIDPAD)
    }
    if find(cmd, (&w_i2chid[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_I2CHID)
    }
    if find(cmd, (&w_noi2c[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOI2C)
    }
    if find(cmd, (&w_hid[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_HID)
    }
}

// Address of the first occurrence, or 0. The command line is a C string.
fn find(hay: u64, needle: u64, n: u64) -> u64 {
    var i: u64 = 0
    while kstate.get8(hay + i) != 0 {
        var k: u64 = 0
        var hit: bool = true
        while k < n {
            if kstate.get8(hay + i + k) != kstate.get8(needle + k) {
                hit = false
                k = n
            } else {
                k = k + 1
            }
        }
        if hit {
            return hay + i
        }
        i = i + 1
    }
    return 0
}


// ==================================================================
// ROUNDE K10 -- DIE OBERFLAECHE
//
// Was hier passiert, steht in `kernel/ps2m.fi` (das Zeigegeraet),
// `kernel/ttf.fi` (die Schriften) und `kernel/wm.fi` (der
// Fensterserver). Hier steht die REIHENFOLGE, und die ist wieder nicht
// beliebig:
//
//   1. Der Arbeitsbereich des Schriftlesers -- ein halbes Megabyte aus
//      dem Rahmenverwalter, NICHT aus dem Kernelhaufen. Der ist 256 KiB
//      gross und gehoert allen.
//   2. Das Dateisystem, falls es noch nicht steht. Die Schriften liegen
//      auf der Platte, so wie sie auf jedem System auf der Platte
//      liegen -- ein Zeichensatzleser, der seinen Zeichensatz im
//      Kernelabbild traegt, liest keinen.
//   3. Die beiden Schriften.
//   4. Das Zeigegeraet. Nach dem Bildschirm, weil es seinen Anschlag an
//      der Bildgroesse hat.
//   5. Der Fensterserver.
//   6. Die Fenster und die Anwendungen.
// ==================================================================



// ==================================================== ADDENDUM TASKBAR

// ====================================================== RUNDE DESKTOP

// ------------------------------------------------------------- USB
//
// RUNDE SERVERBUILD: diese drei standen schon immer hier. Beim Umzug
// der Oberflaeche nach `kgui.fi` wanderten sie einmal mit, weil EINE
// ihrer Zeilen ein Zeigegeraet anmeldet -- und kamen zurueck, weil ein
// Server USB-Platten hat und keine Maus. Die eine Zeile geht jetzt
// durch `gfx.mouse_adopt`.

// ------------------------------------------------------------- HID
//
// RUNDE HID. Ohne `hidrep` ist das hier NICHTS -- kein Zerleger laeuft,
// keine Zeile wird gedruckt, und keine Messung der Runden 59 bis
// MERGE-2 aendert sich.
fn hid_stage(state: u64) {
    if kstate.mode_on(state, kstate.M_HIDREP) {
        hidrep.selbsttest(state)
    }
    // Die Wiedergabe braucht die Tastenkarten und die Zaehler -- also
    // erst aufsetzen, dann abspielen.
    if kstate.mode_on(state, kstate.M_HIDPAD) {
        hidin.stage(state)
        hidin.wiedergabe(state)
    }
    // RUNDE HID: der Ersatzweg fuer ACPI an einer gebauten Tabelle.
    // Braucht keinen Bus und laeuft deshalb ueberall.
    if kstate.mode_on(state, kstate.M_HIDDUMP) {
        i2chid.scan_test(state)
    }

}

fn usb_stage(state: u64) {
    // RUNDE BLECH-HID: die Gegenprobe zur Uebernahme, an einer gebauten
    // Faehigkeitsliste. Sie braucht keinen Regler und laeuft deshalb
    // auch auf einer Maschine ohne USB -- genau das ist ihr Zweck.
    if kstate.mode_on(state, kstate.M_USBLEG) {
        xhci.legtest(state)
    }
    usb.stage(state)
    if !usb.ready(state) {
        return
    }
    // Ein Zeigegeraet braucht einen Anschlag, auch wenn es nicht am 8042
    // haengt. Steht schon ein PS/2-Zeiger, bleibt dessen Einstellung.
    if usb.have_mouse(state) {
        // RUNDE HIDWEG: DER ANSCHLAG IST DER SCHIRM UND NICHT 1024x768.
        //
        // Hier standen zwei feste Zahlen. Auf Justins Ultrabreitbild
        // (der blaue Grund fuellt den ganzen Schirm, Runde STICK) waere
        // der Zeiger damit in die linke obere Ecke eingesperrt gewesen
        // -- eine Grenze, die man erst bemerkt, wenn man an sie stoesst.
        //
        // `ps2m.init` setzt die richtigen Grenzen spaeter noch einmal,
        // ABER NUR, WENN ES LAEUFT: auf einem Brett ohne 8042 kommt es
        // gar nicht so weit. Genau so ein Brett ist Justins.
        var aw: u64 = 1024
        var ah: u64 = 768
        if gfx.ready(state) && gfx.width(state) > 0 && gfx.height(state) > 0 {
            aw = gfx.width(state)
            ah = gfx.height(state)
        }
        gfx.mouse_adopt(state, aw, ah)
    }
    usb_hold(state)
    // DIE GEGENPROBE ZUM ABZIEHEN. Sie steht hier und nicht in der
    // Bibliothek, weil sie eine Anforderung der Kommandozeile ist und
    // kein Zustand des Geraets.
    if kstate.mode_on(state, kstate.M_UNPLUG) {
        usb_unplug(state)
    }
}

// STILLHALTEN, DAMIT VON AUSSEN JEMAND TIPPEN KANN. Dasselbe, was
// `wmhold` seit Runde K10 fuer das Bildschirmfoto tut: der Kern kommt
// zur Ruhe, meldet das auf der seriellen Leitung, und erst danach
// schickt der Testlaeufer seine Maus- und Tastenbefehle in den
// QEMU-Monitor. Ohne diese Marke faellt der erste Klick in einen Kern,
// der noch aufzaehlt.
//
// Mit `usbpoll` wird waehrenddessen SELBST nachgesehen statt auf die
// Meldung zu warten -- die Gegenprobe zu `usbnoirq`.
fn usb_hold(state: u64) {
    var s_h: [u8; 10] = "k17: hold\0"
    var s_r: [u8; 10] = "k17: free\0"
    if !kstate.mode_on(state, kstate.M_USBHOLD) {
        return
    }
    let pollen: bool = kstate.mode_on(state, kstate.M_USBPOLL)
    serial.puts((&s_h[0]) as u64)
    serial.nl()
    var i: u64 = 0
    while i < 900 {
        if pollen {
            usb.poll(state)
        }
        // RUNDE BLECH: derselbe Griff fuer den EHCI. Er hat keinen
        // eigenen Meldevektor (siehe der Kopf von `ehci.fi`), also ist
        // Abfragen fuer ihn nicht die Gegenprobe, sondern der Weg.
        ehci.poll(state)
        sched.sleep_ticks(state, 1)
        i = i + 1
    }
    usb.report(state)
    serial.puts((&s_r[0]) as u64)
    serial.nl()
}

// Was nach dem Abziehen noch geht. Drei Zeilen, und jede einzelne ist
// eine Zusage: der Kern laeuft weiter, das Blockgeraet meldet sich als
// nicht da, und ein offener Deskriptor darauf gibt ENODEV (das prueft
// `/bin/k17` aus Ring 3, nicht der Kern).
fn usb_unplug(state: u64) {
    var s_a: [u8; 22] = "k17: before unplug=\0\0\0"
    var s_b: [u8; 21] = "k17: after unplug=\0\0\0"
    var s_p: [u8; 11] = "  present=\0"
    var s_d: [u8; 11] = "  devices=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(kutil.yes(blk.present_on(state, blk.DEV_USB)))
    serial.puts((&s_d[0]) as u64)
    serial.dec(usb.count(state))
    serial.nl()
    usb.unplug_now(state)
    serial.puts((&s_b[0]) as u64)
    serial.dec(kutil.yes(blk.present_on(state, blk.DEV_USB)))
    serial.puts((&s_d[0]) as u64)
    serial.dec(usb.count(state))
    serial.puts((&s_p[0]) as u64)
    serial.dec(usb.unplugs(state))
    serial.nl()
}


// ==================================================== RUNDE AVX
//
// DER NACHWEIS, DASS DER KONTEXTWECHSEL DIE VEKTORREGISTER SICHERT.
//
// Vier Prozesse laufen GLEICHZEITIG, jeder mit einem Muster, das nur zu
// ihm passt. Jeder gibt den Prozessor 128-mal ab und sieht danach nach,
// ob er seine eigenen Werte wiederfindet. Der Beendigungscode ist die
// Zahl der Abweichungen; 0 in allen vier heisst, dass kein Prozess je
// die Register eines anderen gesehen hat.
//
// DIE GEGENPROBE IST DIE HAELFTE DES NACHWEISES. Mit `nofpuswitch`
// schaltet `fpu.apply` frei, aber `fpu.switch` tut nichts -- genau der
// Fehler, vor dem `docs/OTA.md` warnt ("Das Freischalten allein waere
// FALSCH: dann benutzt Ring 3 Vektorregister, die kein Kontextwechsel
// sichert"). Dann MUSS diese Zahl gross werden. Ein Test, der nicht rot
// werden kann, misst nichts.
fn vectors(state: u64) {
    var s_skip: [u8; 13] = "vec: skipped\0"
    var s_beg: [u8; 11] = "vec: begin\0"
    var s_ex: [u8; 11] = "vec: exit=\0"
    var s_sp: [u8; 2] = " \0"
    var s_sum: [u8; 10] = "vec: sum=\0"
    var s_res: [u8; 12] = "vec: clean=\0"
    if !fpu.want(state, fpu.M_VEC) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_beg[0]) as u64)
    serial.nl()
    // Bit 9: der letzte der vier macht zusaetzlich die `fork`-Probe.
    let a: u64 = proc.create(state, P_VEC, 1, 2)
    let b: u64 = proc.create(state, P_VEC, 2, 2)
    let c: u64 = proc.create(state, P_VEC, 3, 2)
    let d: u64 = proc.create(state, P_VEC, 0x200 | 4, 2)
    let ea: u64 = kutil.wait_for(state, a)
    let eb: u64 = kutil.wait_for(state, b)
    let ec: u64 = kutil.wait_for(state, c)
    let ed: u64 = kutil.wait_for(state, d)
    serial.puts((&s_ex[0]) as u64)
    serial.dec(ea)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(eb)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(ec)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(ed)
    serial.nl()
    serial.puts((&s_sum[0]) as u64)
    serial.dec(ea + eb + ec + ed)
    serial.nl()
    serial.puts((&s_res[0]) as u64)
    if ea == 0 && eb == 0 && ec == 0 && ed == 0 {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()
}


// RUNDE AVX: DIE PROBE AUF MEHREREN PROZESSOREN.
//
// KERNaufgaben und keine Prozesse, und dafuer gibt es einen gemessenen
// Grund. Ein Versuch mit vier Prozessen aus Ring 3 hinter `smp.stage`
// endete unter `-smp 4` in einem #DF mit `rsp` in einer NUTZERseite:
// `syscall_entry` in `isr.s` legt den Nutzerstapel in EIN globales Wort
// (`sys_rsp`) und holt den Kernstapel aus EINEM (`kdata + KSTACK_CUR`).
// Zwei Kerne, die gleichzeitig einen Systemaufruf machen, stehen danach
// auf demselben Kernstapel. Das ist eine Grenze aus Runde K5 -- sie
// steht im Kommentar von `sched.set_kernel_stack` woertlich da ("a
// started core ... never leaves ring 0 in this round") -- und sie hat
// mit den Vektorregistern nichts zu tun. Nachgeprueft: dieselben vier
// Aufgaben mit `nofpu` (also ohne eine Zeile dieser Runde) enden genauso.
//
// KERNAUFGABEN wandern sehr wohl ueber alle Kerne (`may_run` mit
// ANY_CPU) und gehen durch DENSELBEN `switch_to`. Also wird auf ihnen
// gemessen, was zu messen ist: dass eine Aufgabe ihre Vektorregister
// mitnimmt, wenn der Scheduler sie auf einen anderen Kern legt.
fn vectors_smp(state: u64) {
    var s_beg: [u8; 15] = "vecsmp: begin\0\0"
    var s_ex: [u8; 14] = "vecsmp: exit=\0"
    var s_sp: [u8; 2] = " \0"
    var s_c: [u8; 15] = "vecsmp: clean=\0"
    var s_n: [u8; 15] = "vecsmp: cores=\0"
    var s_m: [u8; 16] = "vecsmp: onmask=\0"
    var s_sk: [u8; 16] = "vecsmp: skipped\0"
    if !fpu.want(state, fpu.M_VEC) {
        return
    }
    if !fpu.enabled(state) {
        serial.puts((&s_sk[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_beg[0]) as u64)
    serial.nl()
    // Die Zahl der Kerne, die die Freischaltung WIRKLICH tragen: die
    // weiteren Prozessoren, die sich in `fpu.apply_here` selbst gezaehlt
    // haben, plus den Startprozessor. Zurueckgelesen aus CR4 und nicht
    // angenommen -- siehe `guard.report_aps`.
    serial.puts((&s_n[0]) as u64)
    serial.dec(kstate.get(state, kstate.FPU_APS) + 1)
    serial.nl()
    var t: [u64; 6] = [0 as u64; 6]
    var i: u64 = 0
    while i < 6 {
        t[i as usize] = sched.create(state, sched.K_VEC, 1, 0, 0)
        i = i + 1
    }
    i = 0
    while i < 6 {
        if t[i as usize] != 0 {
            sched.start(state, t[i as usize])
        }
        i = i + 1
    }
    while vec_tasks_alive(state) > 0 {
        sched.sleep_ticks(state, 1)
    }
    var bad: u64 = 0
    var mask: u64 = 0
    serial.puts((&s_ex[0]) as u64)
    i = 0
    while i < 6 {
        if t[i as usize] != 0 {
            let e: u64 = sched.tget(state, t[i as usize], sched.T_EXIT)
            bad = bad + e
            mask = mask | sched.cpu_mask(state, t[i as usize])
            serial.dec(e)
            serial.puts((&s_sp[0]) as u64)
        }
        i = i + 1
    }
    serial.nl()
    // Welche Kerne diese sechs Aufgaben zusammen wirklich getragen
    // haben. Ein Bit je Kern; steht hier 0x1, lief alles auf dem
    // Startprozessor und der Abschnitt hat nichts ueber mehrere
    // Prozessoren gesagt.
    serial.puts((&s_m[0]) as u64)
    serial.hex(mask)
    serial.nl()
    serial.puts((&s_c[0]) as u64)
    if bad == 0 {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()
}

fn vec_tasks_alive(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < kstate.get(state, kstate.TASKS) {
        if sched.tget(state, i, sched.T_KIND) == sched.K_VEC {
            let st: u64 = sched.tget(state, i, sched.T_STATE)
            if st != sched.S_FREE && st != sched.S_ZOMBIE {
                n = n + 1
            }
        }
        i = i + 1
    }
    return n
}


// RUNDE AVX, DIAGNOSE UND KEINE ABNAHME: dieselben vier PROZESSE hinter
// `smp.stage`. Ohne das Wort `r3smp` passiert hier nichts. Was dabei
// herauskommt, steht in `docs/RUNDE-AVX.md`: unter `-smp 1` laeuft es
// durch, unter `-smp 4` endet es in einem #DF -- auch mit `nofpu`, also
// ohne eine Zeile dieser Runde. Der Grund liegt in `isr.s` und ist
// Runde K5 alt.
fn ring3_smp(state: u64) {
    var s_beg: [u8; 14] = "r3smp: begin\0\0"
    var s_ex: [u8; 13] = "r3smp: exit=\0"
    var s_sp: [u8; 2] = " \0"
    if !fpu.want(state, fpu.M_R3SMP) {
        return
    }
    serial.puts((&s_beg[0]) as u64)
    serial.nl()
    // Bit 8: ohne Freischaltung darf das Programm kein Vektorregister
    // anfassen -- sonst misst der Lauf ein #UD statt des Wettlaufs.
    var flag: u64 = 0
    if !fpu.enabled(state) {
        flag = 0x100
    }
    let a: u64 = proc.create(state, P_VEC, flag | 5, 2)
    let b: u64 = proc.create(state, P_VEC, flag | 6, 2)
    let c: u64 = proc.create(state, P_VEC, flag | 7, 2)
    let d: u64 = proc.create(state, P_VEC, flag | 8, 2)
    let ea: u64 = kutil.wait_for(state, a)
    let eb: u64 = kutil.wait_for(state, b)
    let ec: u64 = kutil.wait_for(state, c)
    let ed: u64 = kutil.wait_for(state, d)
    serial.puts((&s_ex[0]) as u64)
    serial.dec(ea)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(eb)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(ec)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(ed)
    serial.nl()
}


// RUNDE AVX: WAS DER KONTEXTWECHSEL JETZT MEHR KOSTET.
//
// Zwei Arme, und der Unterschied zwischen ihnen ist die ganze Frage
// "lazy oder nicht":
//
//   A  zwei Aufgaben, die NUR den Prozessor abgeben und kein einziges
//      Vektorregister anfassen. Das ist der Fall, fuer den der traege
//      Weg gebaut ist.
//   B  zwei Aufgaben, die in jeder Runde alle 16 xmm beschreiben und
//      auslesen. Das ist der Fall, den es in Wirklichkeit gibt --
//      praktisch jede libc benutzt SSE.
//
// Gemessen wird mit `rdtsc` um den ganzen Lauf und dem globalen
// Wechselzaehler. Was herauskommt, ist der Preis EINES Wechsels, alles
// eingerechnet: Laufliste, Sperre, Adressraum, Stapel -- und seit dieser
// Runde XSAVE/XRSTOR. Der Vergleichswert kommt aus demselben Abbild mit
// dem Wort `nofpu`, also aus dem Stand vor dieser Runde.
fn fpu_bench(state: u64) {
    var s_a: [u8; 17] = "fpubench: armA c\0"
    var s_b: [u8; 17] = "fpubench: armB c\0"
    var s_sw: [u8; 12] = "  switches=\0"
    var s_cy: [u8; 10] = "  cycles=\0"
    var s_per: [u8; 9] = "  each=\0\0"
    var s_mem: [u8; 17] = "fpubench: bytes=\0"
    var s_ar: [u8; 10] = "  areas=\0\0"
    var s_fr: [u8; 11] = "  frames=\0\0"
    if !fpu.want(state, fpu.M_BENCH) {
        return
    }
    // ZUERST die Anweisungen selbst, und das ist die Zahl, auf die es
    // ankommt. Der Wechsel als Ganzes ist auf diesem Wirt (zwoelf Kerne,
    // auf denen gleichzeitig mehrere andere Runden QEMU laufen lassen)
    // um mehr verrauscht, als der Unterschied gross ist -- eine Messung,
    // deren Rauschen groesser ist als ihr Gegenstand, misst nichts.
    bench_ops(state)
    bench_ops(state)
    bench_ops(state)
    bench_parts(state)
    bench_parts(state)
    bench_arm(state, sched.K_YIELD, (&s_a[0]) as u64, (&s_sw[0]) as u64,
        (&s_cy[0]) as u64, (&s_per[0]) as u64)
    if fpu.enabled(state) {
        bench_arm(state, sched.K_VEC, (&s_b[0]) as u64, (&s_sw[0]) as u64,
            (&s_cy[0]) as u64, (&s_per[0]) as u64)
    }
    // Der Speicher: die GEMESSENE Groesse aus cpuid Blatt 0x0D und der
    // Rahmen, der dafuer je Aufgabe belegt wird. Beides gehoert genannt
    // -- das eine ist der Bedarf, das andere der Preis.
    serial.puts((&s_mem[0]) as u64)
    serial.dec(kstate.get(state, kstate.FPU_SIZE))
    serial.puts((&s_ar[0]) as u64)
    serial.dec(kstate.get(state, kstate.FPU_AREAS))
    serial.puts((&s_fr[0]) as u64)
    serial.dec(4096)
    serial.nl()
}

fn bench_arm(state: u64, kind: u64, label: u64, s_sw: u64, s_cy: u64,
    s_per: u64) {
    let a: u64 = sched.create(state, kind, 1, 0, 0)
    let b: u64 = sched.create(state, kind, 1, 0, 0)
    if a == 0 || b == 0 {
        return
    }
    let sw0: u64 = kstate.get(state, kstate.SWITCHES)
    let t0: u64 = time.tsc()
    sched.start(state, a)
    sched.start(state, b)
    while bench_alive(state, kind) > 0 {
        sched.sleep_ticks(state, 1)
    }
    let t1: u64 = time.tsc()
    let sw1: u64 = kstate.get(state, kstate.SWITCHES)
    let sw: u64 = sw1 - sw0
    let cy: u64 = t1 - t0
    serial.puts(label)
    serial.puts(s_sw)
    serial.dec(sw)
    serial.puts(s_cy)
    serial.dec(cy)
    serial.puts(s_per)
    if sw > 0 {
        serial.dec(cy / sw)
    } else {
        serial.dec(0)
    }
    serial.nl()
}

fn bench_alive(state: u64, kind: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < kstate.get(state, kstate.TASKS) {
        if sched.tget(state, i, sched.T_KIND) == kind {
            let st: u64 = sched.tget(state, i, sched.T_STATE)
            if st != sched.S_FREE && st != sched.S_ZOMBIE {
                n = n + 1
            }
        }
        i = i + 1
    }
    return n
}


// DER PREIS DER BEIDEN ANWEISUNGEN, OHNE ALLES ANDERE.
//
// `fpu.save` + `fpu.restore` in einer Schleife, gegen dieselbe Schleife
// ohne die beiden gehalten. Was uebrig bleibt, ist genau das, was jeder
// Kontextwechsel seit dieser Runde mehr kostet -- unabhaengig davon, wie
// teuer der Wechsel drumherum ist und wie stark der Wirt gerade belastet
// wird.
//
// Die Leerschleife rechnet etwas, das gedruckt wird. Ein Rumpf, dessen
// Ergebnis niemand liest, waere in `dce.rs` weg, und dann waere die
// Referenz null.
// MINIMUM STATT MITTELWERT, und das ist hier kein Schoenheitsfehler,
// sondern die einzige Art, auf diesem Wirt etwas zu messen. Zwoelf
// Kerne, auf denen gleichzeitig mehrere andere Runden QEMU laufen
// lassen: ein Mittelwert misst dann die Nachbarn mit. Ein
// weggenommener Zeitabschnitt kann eine Messung nur VERLAENGERN, nie
// verkuerzen -- also ist das Minimum ueber viele kurze Buendel der
// saubere Wert, und der Mittelwert daneben sagt, wie unruhig es war.
const BENCH_BURSTS: u64 = 400
const BENCH_IN: u64 = 250

fn bench_ops(state: u64) {
    var s_a: [u8; 18] = "fpubench: ops n=\0\0"
    var s_b: [u8; 8] = "  min=\0\0"
    var s_c: [u8; 9] = "  mitt=\0\0"
    var s_d: [u8; 12] = "  leermin=\0\0"
    var s_e: [u8; 8] = "  je=\0\0\0"
    var s_f: [u8; 8] = "  acc=\0\0"
    var s_no: [u8; 18] = "fpubench: ops aus\0"
    if !fpu.enabled(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    let area: u64 = mem.frame_alloc(state)
    if area == 0 {
        return
    }
    fpu.area_init(state, area)
    // Erst laden, damit die Register in einem definierten Zustand sind
    // und XSAVEOPT seine Bezugsadresse kennt.
    fpu.restore(state, area)
    var best: u64 = 0xFFFFFFFFFFFFFFFF
    var total: u64 = 0
    var b: u64 = 0
    while b < BENCH_BURSTS {
        let t0: u64 = time.tsc()
        var i: u64 = 0
        while i < BENCH_IN {
            fpu.save(state, area)
            fpu.restore(state, area)
            i = i + 1
        }
        let d: u64 = time.tsc() - t0
        if d < best {
            best = d
        }
        total = total +% d
        b = b + 1
    }
    // Dieselbe Schleife OHNE die beiden Aufrufe. Ihr Ergebnis wird
    // gedruckt -- ein Rumpf, den niemand liest, waere in `dce.rs` weg
    // und die Referenz waere null.
    var lbest: u64 = 0xFFFFFFFFFFFFFFFF
    var acc: u64 = 0
    var c: u64 = 0
    while c < BENCH_BURSTS {
        let t0: u64 = time.tsc()
        var i: u64 = 0
        while i < BENCH_IN {
            acc = acc +% kstate.get(state, kstate.FPU_SIZE)
            i = i + 1
        }
        let d: u64 = time.tsc() - t0
        if d < lbest {
            lbest = d
        }
        c = c + 1
    }
    serial.puts((&s_a[0]) as u64)
    serial.dec(BENCH_BURSTS * BENCH_IN)
    serial.puts((&s_b[0]) as u64)
    serial.dec(best / BENCH_IN)
    serial.puts((&s_c[0]) as u64)
    serial.dec(total / (BENCH_BURSTS * BENCH_IN))
    serial.puts((&s_d[0]) as u64)
    serial.dec(lbest / BENCH_IN)
    serial.puts((&s_e[0]) as u64)
    if best > lbest {
        serial.dec((best - lbest) / BENCH_IN)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_f[0]) as u64)
    serial.hex(acc)
    serial.nl()
    mem.frame_free(state, area)
}


// DIE EINZELTEILE, aus denen die Entscheidung "traege oder nicht"
// besteht. Dasselbe Verfahren wie `bench_ops`: Minimum ueber viele
// kurze Buendel.
//
//   sichern    was jeder Wechsel in BEIDEN Faellen kostet
//   laden      was der traege Weg einspart -- aber nur bei Aufgaben, die
//              kein einziges Vektorregister anfassen
//   ts         `mov cr0` mit gesetztem TS und `clts` zurueck; das ist,
//              was der traege Weg dafuer ZUSAETZLICH bezahlt.
//              ACHTUNG: unter KVM ist `mov cr0` ein Ausstieg aus der
//              Gastmaschine und deshalb teurer als auf Blech. Die Zahl
//              ist eine OBERE Schranke, kein Hardwarewert.
fn bench_parts(state: u64) {
    var s_a: [u8; 20] = "fpubench: teile sav\0"
    var s_b: [u8; 8] = "  lad=\0\0"
    var s_c: [u8; 8] = "  ts=\0\0\0"
    if !fpu.enabled(state) {
        return
    }
    let area: u64 = mem.frame_alloc(state)
    if area == 0 {
        return
    }
    fpu.area_init(state, area)
    fpu.restore(state, area)
    var bs: u64 = 0xFFFFFFFFFFFFFFFF
    var bl: u64 = 0xFFFFFFFFFFFFFFFF
    var bt: u64 = 0xFFFFFFFFFFFFFFFF
    var b: u64 = 0
    while b < BENCH_BURSTS {
        var t0: u64 = time.tsc()
        var i: u64 = 0
        while i < BENCH_IN {
            fpu.save(state, area)
            i = i + 1
        }
        var d: u64 = time.tsc() - t0
        if d < bs {
            bs = d
        }
        t0 = time.tsc()
        i = 0
        while i < BENCH_IN {
            fpu.restore(state, area)
            i = i + 1
        }
        d = time.tsc() - t0
        if d < bl {
            bl = d
        }
        t0 = time.tsc()
        i = 0
        while i < BENCH_IN {
            fpu.ts_set()
            fpu.ts_clear()
            i = i + 1
        }
        d = time.tsc() - t0
        if d < bt {
            bt = d
        }
        b = b + 1
    }
    serial.puts((&s_a[0]) as u64)
    serial.dec(bs / BENCH_IN)
    serial.puts((&s_b[0]) as u64)
    serial.dec(bl / BENCH_IN)
    serial.puts((&s_c[0]) as u64)
    serial.dec(bt / BENCH_IN)
    serial.nl()
    mem.frame_free(state, area)
}
