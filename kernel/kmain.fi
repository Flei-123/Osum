// SPDX-License-Identifier: GPL-2.0-only
// kernel/kmain.fi -- round 59: a small kernel, in Firn.
//
// Round 52 proved that `profile kernel` produces a freestanding object
// file: no libc, no runtime, no `_start`. What booted back then said its
// name over the serial port and stopped. This is the kernel that does
// something:
//
//   * it installs an IDT of its own and reports exceptions with error
//     code, CR2 and all sixteen registers (`trap.fi`),
//   * it remaps the two PICs and lets the PIT tick at 100 Hz; the counter
//     runs measurably up (`idt.fi`),
//   * it reads the memory map of the boot loader, manages the physical
//     memory frame by frame and puts a heap on top (`mem.fi`),
//   * it reads the keyboard over IRQ1 (`kbd.fi`),
//   * it goes into ring 3 and comes back through a system call
//     (`user.fi`).
//
// Everything of that is Firn. Assembly is exactly where the machine is
// not yet in a state a compiled function could run in: `boot.s` (long
// mode) and `isr.s` (interrupt entry points).
//
// What runs is decided by the command line of the boot loader
// (`-append`): without arguments the full run, with `trap=de|pf|gp|df` a
// deliberate fault. `tools/kernel/run.sh` starts both.

profile kernel

import serial
import lib.kstate
import lib.version
import arch.x86_64.idt
import mm.mem
import arch.x86_64.trap
import drv.hid.kbd
import arch.x86_64.user
import pwr.power
import pwr.pwr
import pwr.batt
import diag.hwid
import pwr.pmon
import sched.sched
import tasks
import sched.proc
import sys.sys
import fs.file
import fs.unixsock
import block.wlock
import block.blk
import fs.fs
import ldr.elf
import diag.hw
import diag.cmdopt
import sched.randsetup
import sched.randseed
import net.netsvc
import net.wlan_auto
import net.netdev
import arch.x86_64.smp
import net.netview
import net.netmon
import net.ebpfhook
import net.ebpftest
import ipc.share
import ipc.cap
import ipc.handle
import ipc.async
import gfx.gfx
import ui.ax
import drv.con.sercon
import lib.kutil
import fs.nidx
import arch.x86_64.apic
import arch.x86_64.hv

import sched.time
import sched.rand
import crypto.krypto
import crypto.cryptboot
import crypto.kargon
import crypto.kaesni
import crypto.kshani
import drv.con.tty
import sched.signal
import arch.x86_64.guard
import arch.x86_64.fpu
import ldr.bootmod
import ldr.module
import pwr.s3
import lib.ksym
import lib.ksymtab
import diag.crash
import diag.safe
import klog
import ldr.modtab
import ldr.modidx
import lib.ab
import diag.hwdiag
import gfx.grafik
import gfx.r3dtest
import block.rootsel
import bus.drvreg
import bus.ecamdiag
import drv.usb.ehci
import drv.usb.ehcikbd
import drv.usb.ohci
import block.blkdev
import ipc.perm

import fs.vfs
import fs.mnt
import fs.vfsops
import block.wechsel
import block.part
import fs.devfs
import fs.ftype
import drv.usb.xhci
import usb.usb
import drv.hid.hidrep
import drv.hid.hidin
import acpi.acpibl
import pwr.blchain
import drv.wdt.wdt
import drv.hid.hksim
import drv.hid.i2chid
import bus.bus
import bus.slots
import arch.arch
import drv.snd.ac97
import drv.snd.hda
import drv.net.iwl
import drv.snd.mix
import drv.snd.audio
import drv.snd.captest
import acpi.aml
import acpi.acpiev
import sched.susp
import sched.schlaf
import sched.wach
import bus.drvstore
import diag.hang
import diag.nmiguard
import net.kodb
import net.nethot
import libc.regio
import libc.numeric
import init.bootargs
import init.bootmem
import init.testsched
import init.testproc
import init.testasync
import init.testbus
import init.testvec
import init.testpower
import init.bootaudio
import init.bootusb
import init.bootmods
import init.bootfs
import init.bootshell
import init.bootmisc
import init.bootroot

// Indices in the table out of isr.s.
const V_DF_STACK: u64 = 52
const V_IRQ_STACK: u64 = 53

const ADDR_MASK: u64 = 0x000FFFFFFFFFF000

fn kernel_main(mbi: u64, vectors: u64, state: u64, kernel_end: u64,
    gdt: u64, tss: u64) {
    var s_banner: [u8; 32] = "firn kernel r62, profile kernel\0"
    var s_mb: [u8; 11] = "mb: flags=\0"
    var s_cmd: [u8; 8] = "  cmd=\0\0"
    var s_none: [u8; 7] = "(none)\0"
    var s_idt: [u8; 6] = "idt: \0"
    var s_gates: [u8; 21] = " gates, vector 8 IST\0"
    var s_pic: [u8; 30] = "pic: master 0x20, slave 0x28\0\0"
    var s_pit: [u8; 6] = "pit: \0"
    var s_hz: [u8; 20] = " Hz, divisor \0\0\0\0\0\0\0"
    var s_done: [u8; 13] = "kernel: done\0"

    kstate.set(state, kstate.BM_BASE + 0, time.tsc())
    serial.init()
    // ============ RUNDE KABEL: SITZT DA UEBERHAUPT EIN BAUSTEIN?
    let _uart: bool = serial.probe()
    serial.puts(version.text())
    serial.nl()
    serial.puts((&s_banner[0]) as u64)
    serial.nl()

    kstate.set(state, kstate.VECTORS, vectors)
    kstate.set(state, kstate.GDT, gdt)
    kstate.set(state, kstate.TSS, tss)
    kstate.set(state, kstate.KERNEL_END, kernel_end)

    klog.init(state)
    let cmd: u64 = mem.cmdline(mbi)
    safe.boot(state, cmd)
    bootargs.mode_of(state, cmd)
    // ROUND K2: read here and not down in `hw.stage`, and the reason is
    // worth knowing -- the command line of the boot loader lies ABOVE
    // `kernel_end`, and the frame allocator hands exactly those frames
    // out. The first heap of the run stands on it. See docs/OSUM-K2.md.
    hw.parse(state, cmd)
    netview.fallback_set(state, hw.net_fallback(state))
    smp.parse(state, cmd)
    gfx.parse(state, cmd)
    sercon.parse(state, cmd)
    kstate.set(state, kstate.MBI, mbi)
    guard.parse(state, cmd)
    fpu.parse(state, cmd)
    bootmod.parse(state, cmd)
    hv.parse(state, cmd)
    // ROUND NETMON: the accounting is on from the first instruction, so
    // that a frame sent during the boot is counted like every other. Its
    // own mode word, out of the same command line -- `kstate.MODE` has
    // two bits left and four rounds are running beside this one.
    netmon.parse(state, cmd)
    pmon.parse(state, cmd)
    // ROUND A11Y-2: the accessibility layer is THERE before anything
    // else -- the keyboard asks it for sticky keys, the window server for
    // the magnifier and the contrast, whether or not a tree is recorded.
    // `a11y` switches recording on from boot. The self test of the store
    // runs on every boot, before any program (docs/A11Y.md 8).
    ax.init(state)
    ax.parse(state, cmd)
    var s_axt: [u8; 14] = "ax: selftest \0"
    var s_axo: [u8; 4] = " / \0"
    serial.puts((&s_axt[0]) as u64)
    serial.dec(ax.selftest(state))
    serial.puts((&s_axo[0]) as u64)
    serial.dec(ax.selftest_max())
    serial.nl()

    ebpfhook.init(state)
    if kstate.mode_on(state, kstate.M_NOEBPF) {
        ebpfhook.set_on(state, 0)
    }

    time.init(state)
    kstate.set(state, kstate.BM_BASE + 8, time.tsc())
    // r544: the command line was read before (mode_of), so the zone and
    // `rtcutc` are known: convert the hardware clock to UTC now. Calling
    // this only from mode_of did nothing -- the RTC was not read yet there.
    time.tz_anwenden(state)
    randsetup.start(state)
    if kstate.mode_on(state, kstate.M_FIXRAND) {
        rand.fixed_set(state, 1)
    }
    tty.init(state)
    sercon.init(state)
    bootshell.console_load(state, cmd)
    // ROUND K4: the three console descriptors of the system. They exist
    // before the first task does, they belong to no process, and every
    // process is handed them at its creation (`proc.create_bare`).
    file.init(state)
    unixsock.init(state)
    ftype.init(state)
    nidx.init(state)
    if !kstate.mode_on(state, kstate.M_NOBUS) {
        bus.init(state)
        slots.init(state)
        if kstate.mode_on(state, kstate.M_NOTIDEMO) {
            var s_n1: [u8; 23] = "Datenträger verbunden\0"
            var s_n2: [u8; 22] = "Aktualisierung bereit\0"
            bus.noti_post(state, 0, 1, 22, (&s_n1[0]) as u64)
            bus.noti_post(state, 0, 2, 21, (&s_n2[0]) as u64)
        }
    }
    if safe.is_safe() && !kstate.mode_on(state, kstate.M_NOBUS) {
        var s_sf1: [u8; 39] = "SAFE MODE: network and drivers are off\0"
        var s_sf2: [u8; 47] = "SAFE MODE after a failed boot: see /var/jarvis\0"
        if safe.fell_back() {
            bus.noti_post(state, 0, 1, 46, (&s_sf2[0]) as u64)
        } else {
            bus.noti_post(state, 0, 1, 38, (&s_sf1[0]) as u64)
        }
    }
    serial.puts((&s_mb[0]) as u64)
    serial.hex(regio.read32(mbi))
    serial.puts((&s_cmd[0]) as u64)
    if cmd == 0 {
        serial.puts((&s_none[0]) as u64)
    } else {
        serial.puts(cmd)
    }
    serial.nl()

    // 1. descriptor tables. The TSS first: the IDT points into it with
    //    IST1, and `ltr` after `lidt` would be a window in which a #DF
    //    has no stack.
    idt.tss_install(gdt, tss, at(vectors, V_IRQ_STACK), at(vectors, V_DF_STACK),
        state + kstate.CPU_OFF)
    let gates: u64 = idt.build(state, vectors)
    serial.puts((&s_idt[0]) as u64)
    serial.dec(gates)
    serial.puts((&s_gates[0]) as u64)
    serial.nl()

    // 2. the interrupt controllers and the timer.
    idt.pic_remap()
    idt.pic_mask(0xFC as u8, 0xFF as u8) // only IRQ0 and IRQ1
    serial.puts((&s_pic[0]) as u64)
    serial.nl()
    let divisor: u64 = idt.pit_init(100)
    kstate.set(state, kstate.BM_BASE + 16, time.tsc())
    serial.puts((&s_pit[0]) as u64)
    serial.dec(100)
    serial.puts((&s_hz[0]) as u64)
    serial.dec(divisor)
    serial.nl()

    // 3. memory.
    bootmem.memory(state, mbi, kernel_end)

    bootusb.hid_stage(state)

    bootmod.stage(state, mbi)

    // 3a. ROUND K2: the bus is read and the interrupts move from the two
    //     8259s to the APIC -- before the first `sti`, because a
    //     controller must not be swapped while it is delivering. See
    //     `hw.fi`, `pci.fi`, `apic.fi`.
    hw.stage(state)
    ecamdiag.stage(state)
    // W-AX201 M1b: read-only identify of the Intel WLAN MAC (serial line "iwl: ...").
    iwl.boot(state)

    // 3b2. RUNDE BLECHVIER: DIE BLECH-DIAGNOSE.
    hw.blech_stage(state)
    aml.snapshot_boot(state)
    drvreg.boot_report(state)

    fpu.apply(state)
    gfx.stage_graphics(state, mbi)
    kstate.set(state, kstate.BM_BASE + 24, time.tsc())

    hwdiag.stage(state, hw.cmd_copy(state))

    grafik.stage(state, hw.cmd_copy(state))

    r3dtest.stage(state, hw.cmd_copy(state))

    if kstate.mode_on(state, kstate.M_BLKTAB) {
        blkdev.print_table(state)
    }

    // 3b. the task table. From here on there is a scheduler -- it does
    //     not switch anything yet, because there is only one task, but
    //     the timer already counts its ticks against it.
    kstate.set(state, kstate.KPML4,
        asm("mov rax, cr3", out("rax")) & ADDR_MASK)
    fpu.apply(state)
    sched.init(state)
    kstate.set(state, kstate.BM_BASE + 32, time.tsc())
    let idle: u64 = sched.create(state, sched.K_IDLE, 1, 0, 0)
    sched.start(state, idle)
    sched.set_idle(state, idle)
    // `syscall`/`sysret` need their four MSRs before the first process,
    // not only before the excursion of round 59. Without EFER.SCE the
    // `sysretq` of `enter_user_task` is an invalid opcode.
    user.setup(state)
    var s_g0: [u8; 16] = "user: gs-basis ␀"
    var s_g1: [u8; 10] = "  kstack ␀"
    serial.puts((&s_g0[0]) as u64)
    serial.hex(user.gs_base())
    serial.puts((&s_g1[0]) as u64)
    serial.hex(sched.kstack_here(state))
    serial.nl()
    guard.apply(state)
    guard.report(state)
    fpu.report(state)
    kaesni.apply(state)
    kaesni.report(state)
    kshani.apply(state)
    kshani.report(state)
    if kstate.mode_on(state, kstate.M_SHATEST) {
        kshani.selftest(state)
    }
    if kstate.mode_on(state, kstate.M_AESTEST) {
        kaesni.selftest(state)
    }
    if kstate.mode_on(state, kstate.M_AESBENCH) {
        kaesni.bench(state)
    }
    if kstate.mode_on(state, kstate.M_EBPFTEST) {
        ebpftest.selftest(state)
    }
    if kstate.mode_on(state, kstate.M_EBPFBENCH) {
        ebpftest.bench(state)
    }
    bootmisc.ebpfhook_report(state)
    if kstate.mode_on(state, kstate.M_EBPFDROP) {
        ebpftest.load_drop_icmp(state)
        ebpftest.drop_probe(state)
    }
    proc.map_programs(state)
    kstate.set(state, kstate.BM_BASE + 40, time.tsc())
    guard.raw_read(state)
    guard.raw_exec(state)

    // 4. a deliberate fault, when the command line asks for one. Comes
    //    back only if the IDT is broken -- `trap.report` stops.
    testsched.provoke(state)

    // 5. interrupts on, and the proof that they arrive.
    testsched.ticks(state)

    testsched.clock(state)

    // 6. three tasks at the same time.
    testsched.scheduler(state)

    // 7. the keyboard.
    testsched.keyboard(state)

    // 7b. processes with an address space of their own.
    testproc.processes(state)
    testproc.capabilities(state)
    testproc.handles(state)
    testproc.handle_bench(state)
    testproc.fuzzer(state)
    testasync.asyncs(state)
    testasync.async_bench(state)
    testvec.vectors(state)
    bootmem.speicherdruck(state)
    hwdiag.park_if_asked(state, hw.cmd_copy(state))
    testproc.users(state)
    testbus.busround(state)
    testbus.clipdemo(state)

    testpower.power_stage(state)
    aml.stage(state)
    acpiev.stage(state)
    ecamdiag.aml_probe(state)
    susp.stage(state)
    // K-004: the real S3. Right behind the measurement it needs, and
    // before the disk, the network and the shell -- everything after
    // this line runs on a machine that has been asleep once.
    s3.stage(state)
    acpibl.stage(state)
    blchain.stage(state)
    wdt.stage(state)
    nmiguard.init(state)
    kodb.init(state)
    hang.init(state)
    if kstate.mode_on(state, kstate.M_EVSELF) {
        acpiev.selftest(state)
        acpibl.selftest(state)
        blchain.selftest(state)
        hksim.selftest(state)
    }
    if kstate.mode_on(state, kstate.M_EVWAIT) {
        acpiev.wait_loop(state, 9000)
    }
    testpower.power_test(state)

    // 7c. the file system.
    bootfs.filesystem(state)
    crash.init(state)
    testasync.asyncs_fs(state)

    // 7d. a command line in ring 3.
    bootshell.shell(state)

    // 7e. the same file system on a real disk.
    bootfs.ata_disk(state)

    // 7e-bis. ROUND K8: the network card, the TCP/IP stack of round K3
    //     on top of it, and the task that moves frames between the two.
    //     Deliberately BEFORE `osum`: the shell that starts down there
    //     runs `/bin/ping` and `/bin/wget`, and both need a wire.
    //     Without `nic` on the command line this is one printed line and
    //     nothing else -- every measurement of rounds 59 to K6 sees the
    //     kernel it saw before.
    netsvc.stage(state)

    bootusb.usb_stage(state)
    // L-015: a USB tethering function (CDC-ECM) is only known now; bring the
    // network stage up again for it (it stopped at "nic: no device").
    if netdev.late_usb(state) {
        netsvc.stage(state)
    }
    if iwl.count_targets(state) > 0 || iwl.held_ready() {
        let _wa: u64 = wlan_auto.start(state)
    }
    i2chid.stage(state)

    ehci.stage(state)
    // r1003: OHCI (USB 1.1, VirtualBox default controller). Runs with the `usb` word or the `ehci` word;
    // it only drives its own root-hub ports, so it never competes with xHCI for a device.
    bootusb.ohci_stage(state)
    hwdiag.park_after_usb(state)
    if kstate.mode_on(state, kstate.M_EHCITEST) {
        ehci.selftest(state, 0)
        ehci.selftest(state, 1)
        ehci.selftest(state, 64)
        var eh_i: u64 = 0
        // r1003: the same window measures the pointer path (tools/usbhid): the host injects wheel, buttons,
        // absolute moves and keys through QMP after the marker line; the sums go out as `hidwin:`.
        var hw_btn: u64 = 0
        var hw_wchg: u64 = 0
        var hw_wlast: u64 = gfx.mouse_wheel(state)
        var hw_x0: u64 = gfx.mouse_x(state)
        var hw_y0: u64 = gfx.mouse_y(state)
        var hw_xmax: u64 = hw_x0
        var hw_ymax: u64 = hw_y0
        var s_open: [u8; 14] = "hidwin: open\0\0"
        serial.puts((&s_open[0]) as u64)
        serial.nl()
        while eh_i < 900 {
            ehci.poll(state)
            ehcikbd.pump(state)
            ohci.poll(state)
            usb.poll(state)
            hw_btn = hw_btn | gfx.mouse_buttons(state)
            let hw_w: u64 = gfx.mouse_wheel(state)
            if hw_w != hw_wlast {
                hw_wchg = hw_wchg + 1
                hw_wlast = hw_w
            }
            if gfx.mouse_x(state) > hw_xmax {
                hw_xmax = gfx.mouse_x(state)
            }
            if gfx.mouse_y(state) > hw_ymax {
                hw_ymax = gfx.mouse_y(state)
            }
            sched.sleep_ticks(state, 1)
            eh_i = eh_i + 1
        }
        ehci.report(state)
        var s_hw: [u8; 14] = "hidwin: keys=\0"
        var s_hr: [u8; 10] = " reports=\0"
        var s_hm: [u8; 8] = " moves=\0"
        var s_hh: [u8; 9] = " wheels=\0"
        var s_hc: [u8; 11] = " wheelchg=\0"
        var s_hb: [u8; 6] = " btn=\0"
        var s_hx: [u8; 4] = " x=\0"
        var s_hy: [u8; 4] = " y=\0"
        var s_hi: [u8; 5] = " id=\0"
        serial.puts((&s_hw[0]) as u64)
        serial.dec(hidin.keys(state))
        serial.puts((&s_hr[0]) as u64)
        serial.dec(hidin.reports(state))
        serial.puts((&s_hm[0]) as u64)
        serial.dec(hidin.moves(state))
        serial.puts((&s_hh[0]) as u64)
        serial.dec(hidin.wheels(state))
        serial.puts((&s_hc[0]) as u64)
        serial.dec(hw_wchg)
        serial.puts((&s_hb[0]) as u64)
        serial.dec(hw_btn)
        serial.puts((&s_hx[0]) as u64)
        serial.dec(hw_xmax)
        serial.puts((&s_hy[0]) as u64)
        serial.dec(hw_ymax)
        serial.puts((&s_hi[0]) as u64)
        serial.dec(gfx.mouse_id(state))
        serial.nl()
    }

    bootaudio.audio_stage(state)

    hwid.stage(state)

    bootmods.moduls(state)

    // 7f. round K1: a system on that disk. Mount what the host built,
    //     load /bin/sh out of it, and let it run until it is done.
    bootroot.osum(state)
    ecamdiag.proc_probe(state)
    // ============================ RUNDE SCHLAF (K-018, zweite Haelfte)
    if kstate.mode_on(state, kstate.M_SCHLAFPRUEF) {
        schlaf.check(state, schlaf.frei_beim_start(state))
    }
    // ============= RUNDE WACH (K-018, Abschluss): DER WIEDERANLAUF
    if kstate.mode_on(state, kstate.M_WACHPRUEF) {
        wach.check(state)
    }
    if kstate.mode_on(state, kstate.M_WACHMESS) {
        wach.measure(state)
    }
    if kstate.mode_on(state, kstate.M_WACHARM) {
        var wzyk: u64 = 1
        if kstate.mode_on(state, kstate.M_WACH) {
            wzyk = 2
        }
        wach.arm(state, wzyk)
    }
    if kstate.mode_on(state, kstate.M_SCHLAFARM) {
        schlaf.arm_and_exit(state)
    }
    // RUNDE HOTPLUG: DER RUECKFALL.
    bootusb.usb_hold(state)
    // 7g. ROUND K2: and once more one layer lower, on a controller that
    //     fetches its own commands out of memory (`hw.disk`).
    hw.disk(state)

    hwid.late(state)

    // 7h. ROUND K5: the other processors. Deliberately here and not
    //     earlier: everything above this line is what rounds 59 to K2
    //     measured, and it measures it on ONE core, exactly as before.
    //     Under `-smp 1` this stage finds one processor and the whole
    //     kernel behaves as it did; under `-smp 4` it starts the other
    //     three and hands them work.
    smp.stage(state)
    // DD-12: standby with the other cores running (word `s3smp`)
    s3.stage_smp(state)
    user.gs_set(sched.gs_expected(state))
    sched.kstack_again(state)
    let gs_ok: bool = sched.gs_check(state, user.gs_base())
    var s_gs: [u8; 22] = "smp: gs-basis kern 0 ␀"
    var s_gsj: [u8; 4] = "ok␀␀"
    var s_gsn: [u8; 7] = "FALSCH␀"
    serial.puts((&s_gs[0]) as u64)
    if gs_ok {
        serial.puts((&s_gsj[0]) as u64)
    } else {
        serial.puts((&s_gsn[0]) as u64)
    }
    serial.nl()
    testvec.vectors_smp(state)
    testvec.ring3_smp(state)
    if kstate.mode_on(state, kstate.M_BOOTBENCH) {
        testvec.fpu_bench(state)
    }

    hv.stage(state)
    bootmisc.hv_ring3(state)

    // 8. ring 3, the excursion of round 59.
    testsched.ring3(state)

    gfx.stage_surface(state)

    gfx.stage_hold(state)

    guard.report_aps(state)
    fpu.report_aps(state)
    bootmod.recheck(state)
    usb.report(state)
    if kstate.mode_on(state, kstate.M_HIDLAT) {
        hidin.stage(state)
        hidin.latenz(state)
    }

    sercon.report(state)
    if kstate.mode_on(state, kstate.M_KRACH)
            && kstate.mode_on(state, kstate.M_KRACHJETZT) {
        crash.knall(state, 0)
    }
    serial.puts((&s_done[0]) as u64)
    serial.nl()
    power.shutdown(power.EXIT_OK)
}

fn at(vectors: u64, i: u64) -> u64 {
    return __mmio_read64((vectors + i * 8) as *mut u64)
}
