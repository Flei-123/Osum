profile kernel

import libc.regio

export { attr_find, attr_len, attr_data, attr_u32, attr_ip4, align4, rd16 }

fn rd16(p: u64) -> u64 {
    return regio.read8(p) | (regio.read8(p + 1) << 8)
}

fn align4(n: u64) -> u64 {
    return (n + 3) & 0xFFFFFFFC
}

fn attr_find(first: u64, end: u64, typ: u64) -> u64 {
    var q: u64 = first
    while q + 4 <= end {
        let len: u64 = rd16(q)
        if len < 4 || q + len > end {
            return 0
        }
        if (rd16(q + 2) & 0x3FFF) == typ {
            return q
        }
        q = q + align4(len)
    }
    return 0
}

fn attr_len(a: u64) -> u64 {
    return rd16(a) - 4
}

fn attr_data(a: u64) -> u64 {
    return a + 4
}

fn attr_u32(a: u64) -> u64 {
    return regio.read32(a + 4)
}

fn attr_ip4(a: u64) -> u64 {
    return (regio.read8(a + 4) << 24) | (regio.read8(a + 5) << 16)
        | (regio.read8(a + 6) << 8) | regio.read8(a + 7)
}
