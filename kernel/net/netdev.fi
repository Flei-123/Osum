// ROUND DELL2: a raw chip counter or register for diagnostics
// (`dhcp status`). Only e1000/I21x has it; everything else says
// 0xFFFFFFFF, "not available", rather than a zero that reads like a
// measurement.
fn hwstat_on(state: u64, c: u64, which: u64) -> u64 {
    let eo: netclass.EthOps = ethreg.ops_for(state, kind_on(state, c))
    return eo.hwstat(state, unit_of(state, c), which)
}

fn mac_at_on(state: u64, c: u64, i: u64) -> u64 {
    let eo: netclass.EthOps = ethreg.ops_for(state, kind_on(state, c))
    return eo.mac_at(state, unit_of(state, c), i)
}

