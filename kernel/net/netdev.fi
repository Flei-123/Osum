    return eo.tx_frame(state, unit_of(state, c), src, n)
}

fn poll_on(state: u64, c: u64) -> bool {
    let eo: netclass.EthOps = ethreg.ops_for(state, kind_on(state, c))
    return eo.poll(state, unit_of(state, c))
