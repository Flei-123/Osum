profile kernel

import serial
import lib.errno
import net.wlan_auto
import net.wlan_knobs
import drv.net.iwl

export { request, service, state_word }

static mut pending: u64 = 0
static mut finished: u64 = 0

fn request(state: u64, knob: u64, value: u64) -> u64 {
    if wlan_auto.driver_bound() || pending != 0 {
        return errno.neg(errno.E_BUSY)
    }
    let k: u64 = wlan_knobs.apply(state, knob, value)
    if errno.is_error(k) {
        return k
    }
    pending = 1
    if wlan_auto.start(state) == 0 {
        pending = 0
        return errno.neg(errno.E_NOMEM)
    }
    return 0
}

fn service(state: u64) {
    var s_begin: [u8; 14] = "wlan: reload\0\0"
    var s_end: [u8; 19] = "wlan: reload done\0\0"
    if pending == 0 {
        return
    }
    serial.puts((&s_begin[0]) as u64)
    serial.nl()
    iwl.reload_reset()
    iwl.fw_stage(state)
    serial.puts((&s_end[0]) as u64)
    serial.nl()
    finished = finished + 1
    pending = 0
}

fn state_word() -> u64 {
    return pending | (finished << 8)
}
