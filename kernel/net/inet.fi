
import lib.kstate
import sched.time
import mm.mmframe
import serial
import sync.atomic
import arch.cpu
import sched.sched
import sched.taskconst
import sched.taskslot
import net.netdev
import lib.errno
import arch.x86_64.apic
import bus.pci
import net.wire
import net.tcp
import net.stack
import net.netmon
import net.ebpfhook
import net.sharebind
import net.wg
import net.kodb

export { arp_flush, arp_ask, EPHEMERAL_BASE, EPHEMERAL_MASK,
    init, ready, pump, netd_body, wake, configure, readdr, us, set_task,
    ip, mask, gw, mac_at, stat, pumps, frames_in, frames_out,
    carrier, gw_known, link_speed, hwstat,
    bounce, saddr,
    tcp_stat, sock_dbg, task_slot, print_state,
    card_octets, hw_for,
    next_hop, route_via_gw, hop_mac, arp_slots, arp_ip_at, arp_mac_slot,
    sock_new, sock_free, sock_kind, sock_handle,
    sock_bind, sock_listen, sock_accept, sock_connect,
    sock_send, sock_recv, sock_sendto, sock_recvfrom, tx_kind_count, TXK_ARP, TXK_ICMP, TXK_UDP, TXK_TCP, TXK_OTHER, TXK_ARP_SUPPRESSED,
    sock_close, sock_shutdown, sock_state, sock_peer, sock_local,
    sock_readable, sock_next_len, sock_writable, sock_error,
    sock_acceptable, sock_hup,
    sock_nonblock, sock_set_nonblock, sock_put_nonblock, sock_tmo, sock_set_tmo, TMO_MASK,
    SK_FREE, SK_TCP, SK_UDP, SK_ICMP, SOCK_MAX,
    SF_LISTEN, SF_NONBLOCK, SF_CONNECTED, SF_KEEPALIVE,
    sock_ka_set, sock_ka_get, KA_ON, KA_IDLE, KA_INTVL, KA_CNT, sock_stale
, dhcp_set, dhcp_get}

const S_STACK: u64 = 0x300
const S_READY: u64 = 0x308
const S_IP: u64 = 0x310
const S_MASK: u64 = 0x318
const S_GW: u64 = 0x320
const S_PUMPS: u64 = 0x328
const S_IN: u64 = 0x330
const S_OUT: u64 = 0x338
const S_TASK: u64 = 0x340
const S_SCRATCH: u64 = 0x348
const S_KICK: u64 = 0x350
const S_HOT: u64 = 0x358
const S_ICMP_HEAD: u64 = 0x360
const S_ICMP_TAIL: u64 = 0x368
const S_ARPN: u64 = 0x370
const S_ECHOES: u64 = 0x378
const S_SEQ: u64 = 0x380
const S_SOCKS: u64 = 0x390
const S_BOUNCE: u64 = 0x398
const S_SADDR: u64 = 0x3F0
const S_TXARP: u64 = 0x3A0
const S_TXICMP: u64 = 0x3A8
const S_TXUDP: u64 = 0x3B0
const S_TXTCP: u64 = 0x3B8
const S_TXOTHER: u64 = 0x3C0
const S_ARPSUP: u64 = 0x3C8
const S_ARPTGT: u64 = 0x3D0
const S_ARPTICK: u64 = 0x3D8

const TXK_ARP: u64 = 0
const TXK_ICMP: u64 = 1
const TXK_UDP: u64 = 2
const TXK_TCP: u64 = 3
const TXK_OTHER: u64 = 4
const TXK_ARP_SUPPRESSED: u64 = 5
const ARP_GAP_ANY: u64 = 5
const ARP_GAP_SAME: u64 = 100

const SOCK_OFF: u64 = 0x400
const SOCK_BYTES: u64 = 32
const SOCK_MAX: u64 = 16

const ARP_OFF: u64 = 0x600
const ARP_BYTES: u64 = 16
const ARP_MAX: u64 = 8

const ICMP_OFF: u64 = 0x700
const ICMP_BYTES: u64 = 256
const ICMP_SLOTS: u64 = 4
const ICMP_MAX: u64 = 192

const SO_KIND: u64 = 0
const SO_H: u64 = 8
const SO_PORT: u64 = 16
const SO_FLAGS: u64 = 24

const SK_FREE: u64 = 0
const SK_TCP: u64 = 1
const SK_UDP: u64 = 2
const SK_ICMP: u64 = 3

const SF_LISTEN: u64 = 1
const SF_NONBLOCK: u64 = 2
const SF_CONNECTED: u64 = 4
const SF_KEEPALIVE: u64 = 8
const KA_MASK: u64 = 0x1FFFFFFFFF08
const KA_IDLE_DEF: u64 = 7200
const KA_INTVL_DEF: u64 = 75
const KA_CNT_DEF: u64 = 9
const KA_ON: u64 = 0
const KA_IDLE: u64 = 1
const KA_INTVL: u64 = 2
const KA_CNT: u64 = 3

const NOHANDLE: u64 = 0xFFFFFFFF

const UDP_HANDLES: u64 = 4

const UDP_QUEUE_LEN: usize = 4

const EPHEMERAL_BASE: u64 = 40000

const EPHEMERAL_MASK: u64 = 4095

const LPORT_MASK: u64 = 0xFFFF

const PEER_PORT_SHIFT: u64 = 16

const PEER_IP_SHIFT: u64 = 32

const PUMP_BATCH: u64 = 32

const HOT_TURNS: u64 = 4000

const HOT_US: u64 = 1500

const QUIET_US: u64 = 3000000
const QUIET_TICKS: u64 = 5

const FRAME_CAP: u64 = 1600

const H_MASK: u64 = 0xFFFFFFFF

static mut in_epoch: u64 = 0

fn sc(off: u64) -> u64 {
    return pci.K2_SCALARS + off
}

fn ready(state: u64) -> bool {
    return kstate.get(state, sc(S_READY)) != 0
}

fn ip(state: u64) -> u64 {
    return kstate.get(state, sc(S_IP))
}

fn mask(state: u64) -> u64 {
    return kstate.get(state, sc(S_MASK))
}

fn gw(state: u64) -> u64 {
    return kstate.get(state, sc(S_GW))
}

fn mac_at(state: u64, i: u64) -> u64 {
    return netdev.mac_at(state, i)
}

fn carrier(state: u64) -> bool {
    if !netdev.present(state) {
        return false
    }
    return netdev.link_up(state)
}

fn hwstat(state: u64, which: u64) -> u64 {
    if !netdev.present(state) {
        return 0xFFFFFFFF
    }
    return netdev.hwstat_on(state, 0, which)
}

fn link_speed(state: u64) -> u64 {
    if !netdev.present(state) {
        return 0
    }
    return netdev.link_speed(state)
}

fn gw_known(state: u64) -> bool {
    let g: u64 = gw(state)
    if g == 0 {
        return false
    }
    return arp_look(state, g) != 0
}

fn pumps(state: u64) -> u64 {
    return kstate.get(state, sc(S_PUMPS))
}

fn tx_slot(kind: u64) -> u64 {
    if kind == TXK_ARP {
        return S_TXARP
    }
    if kind == TXK_ICMP {
        return S_TXICMP
    }
    if kind == TXK_UDP {
        return S_TXUDP
    }
    if kind == TXK_TCP {
        return S_TXTCP
    }
    if kind == TXK_ARP_SUPPRESSED {
        return S_ARPSUP
    }
    return S_TXOTHER
}

fn tx_kind_count(state: u64, kind: u64) -> u64 {
    return kstate.get(state, sc(tx_slot(kind)))
}

fn count_tx(state: u64, f: u64, n: u64) {
    var kind: u64 = TXK_OTHER
    if n >= 14 {
        let et: u64 = (kstate.get8(f + 12) << 8) | kstate.get8(f + 13)
        if et == 0x0806 {
            kind = TXK_ARP
        } else if et == 0x0800 && n >= 24 {
            let proto: u64 = kstate.get8(f + 23)
            if proto == 1 {
                kind = TXK_ICMP
            } else if proto == 17 {
                kind = TXK_UDP
            } else if proto == 6 {
                kind = TXK_TCP
            }
        }
    }
    kstate.add(state, sc(tx_slot(kind)), 1)
}

fn arp_may_ask(state: u64, target: u64) -> bool {
    if kstate.mode_on(state, kstate.M_NOARPGAP) {
        return true
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    let last: u64 = kstate.get(state, sc(S_ARPTICK))
    if last != 0 && now >= last {
        let age: u64 = now - last
        if age < ARP_GAP_ANY || (age < ARP_GAP_SAME && kstate.get(state, sc(S_ARPTGT)) == target) {
            kstate.add(state, sc(S_ARPSUP), 1)
            return false
        }
    }
    kstate.set(state, sc(S_ARPTICK), now)
    kstate.set(state, sc(S_ARPTGT), target)
    return true
}

fn frames_in(state: u64) -> u64 {
    return kstate.get(state, sc(S_IN))
}

fn frames_out(state: u64) -> u64 {
    return kstate.get(state, sc(S_OUT))
}

fn bounce(state: u64) -> u64 {
    return kstate.get(state, sc(S_BOUNCE))
}

fn saddr(state: u64) -> u64 {
    return kstate.get(state, sc(S_SADDR))
}

fn hw_for(state: u64, target: u64) -> u64 {
    let flags: u64 = hold(state)
    let m: u64 = arp_look(state, target)
    if m == 0 {
        arp_ask(state, target)
    }
    drop_lock(state, flags)
    return m
}

fn card_octets(state: u64, which: u64) -> u64 {
    if which == 0 {
        return netdev.tx_octets(state)
    }
    return netdev.rx_octets(state)
}

fn task_slot(state: u64) -> u64 {
    return kstate.get(state, sc(S_TASK))
}

fn set_task(state: u64, t: u64) {
    kstate.set(state, sc(S_TASK), t)
}

fn us(state: u64) -> u64 {
    return now_us(state)
}

fn st(state: u64) -> *mut stack.Stack {
    return kstate.get(state, sc(S_STACK)) as *mut stack.Stack
}

fn stat(state: u64, which: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    return stack.net_stat(st(state), (which & 0xFFFFFFFF) as u32)
}

const S_NZWS: u64 = 0xCA0
const S_NZTS: u64 = 0xCA8
const S_NZSACK: u64 = 0xCB0

fn nzp_options(state: u64) {
    let t: *mut tcp.Tcp = stack.net_tcp(st(state))
    let ws: u64 = kstate.get(state, pci.K2_SCALARS + S_NZWS)
    let ts: u64 = kstate.get(state, pci.K2_SCALARS + S_NZTS)
    let sk: u64 = kstate.get(state, pci.K2_SCALARS + S_NZSACK)
    tcp.tcp_set_wscale(t, (ws & 0xFFFFFFFF) as u32)
    tcp.tcp_set_ts(t, (ts & 0xFFFFFFFF) as u32)
    tcp.tcp_set_sack(t, (sk & 0xFFFFFFFF) as u32)
}

fn sock_dbg(state: u64, i: u64, which: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    let h: u64 = sock_handle(state, i)
    if h == NOHANDLE {
        return 0
    }
    return tcp.tcp_dbg(stack.net_tcp(st(state)), h as i32, (which & 0xFFFFFFFF) as u32)
}

fn tcp_stat(state: u64, which: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    return tcp.tcp_stat(stack.net_tcp(st(state)), (which & 0xFFFFFFFF) as u32)
}

fn now_us(state: u64) -> u64 {
    return time.mono_ns(state) / 1000
}

fn hold(state: u64) -> u64 {
    let flags: u64 = sched.irq_save()
    atomic.lock_take(state, atomic.L_NET, cpu.here(state))
    return flags
}

fn drop_lock(state: u64, flags: u64) {
    atomic.lock_give(state, atomic.L_NET)
    sched.irq_restore(flags)
}

fn init(state: u64, a: u64, b: u64, c: u64, d: u64, prefix: u64,
    gateway: u64) -> bool {
    kstate.set(state, sc(S_READY), 0)
    if !netdev.ready(state) {
        return false
    }
    let pages: u64 = (stack.net_size() as u64 + mmframe.FRAME_SIZE - 1)
        / mmframe.FRAME_SIZE
    let base: u64 = mmframe.frame_run(state, pages + 3)
    if base == 0 {
        return false
    }
    kstate.set(state, sc(S_STACK), base)
    kstate.set(state, sc(S_SCRATCH), base + pages * mmframe.FRAME_SIZE)
    kstate.set(state, sc(S_BOUNCE), base + (pages + 1) * mmframe.FRAME_SIZE)
    kstate.set(state, sc(S_SADDR), base + (pages + 2) * mmframe.FRAME_SIZE)
    var z: u64 = 0
    while z < (pages + 3) * mmframe.FRAME_SIZE {
        __mmio_write64((base + z) as *mut u64, 0)
        z = z + 8
    }

    var m: [u8; 6] = [0 as u8; 6]
    var i: u64 = 0
    while i < 6 {
        m[i as usize] = netdev.mac_at(state, i) as u8
        i = i + 1
    }
    let own: u32 = wire.ip4(a as u8, b as u8, c as u8, d as u8)
    var netmask: u32 = 0
    if prefix >= 32 {
        netmask = 0xFFFFFFFF
    } else if prefix > 0 {
        netmask = ((0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF) as u32
    }
    var seed: u64 = apic.tsc()
    if seed == 0 {
        seed = 20260825
    }
    stack.net_init(st(state), own, netmask, (gateway & 0xFFFFFFFF) as u32,
        &m[0], seed)
    nzp_options(state)
    kstate.set(state, sc(S_IP), own as u64)
    kstate.set(state, sc(S_MASK), netmask as u64)
    kstate.set(state, sc(S_GW), gateway)
    kstate.set(state, sc(S_SEQ), 1)
    kstate.set(state, sc(S_READY), 1)
    return true
}

fn configure(state: u64, a: u64, b: u64, c: u64, d: u64, prefix: u64,
    gateway: u64) -> bool {
    return init(state, a, b, c, d, prefix, gateway)
}

fn readdr(state: u64, a: u64, b: u64, c: u64, d: u64, prefix: u64,
    gateway: u64) -> bool {
    if !ready(state) {
        return false
    }
    var m: [u8; 6] = [0 as u8; 6]
    var i: u64 = 0
    while i < 6 {
        m[i as usize] = netdev.mac_at(state, i) as u8
        i = i + 1
    }
    let own: u32 = wire.ip4(a as u8, b as u8, c as u8, d as u8)
    var netmask: u32 = 0
    if prefix >= 32 {
        netmask = 0xFFFFFFFF
    } else if prefix > 0 {
        netmask = ((0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF) as u32
    }
    if (own as u64) == ip(state) && (netmask as u64) == mask(state)
        && (gateway & 0xFFFFFFFF) == gw(state) {
        return true
    }
    var seed: u64 = apic.tsc()
    if seed == 0 {
        seed = 20260827
    }
    let flags: u64 = hold(state)
    stack.net_init(st(state), own, netmask, (gateway & 0xFFFFFFFF) as u32,
        &m[0], seed)
    nzp_options(state)
    kstate.set(state, sc(S_IP), own as u64)
    kstate.set(state, sc(S_MASK), netmask as u64)
    kstate.set(state, sc(S_GW), gateway)
    in_epoch = (in_epoch + 1) & H_MASK
    let rebound: u64 = rebind_all(state)
    let stale: u64 = stale_count(state)
    let ep: u64 = in_epoch
    drop_lock(state, flags)
    say_epoch(ep, rebound, stale)
    return true
}

fn rebind_one(state: u64, i: u64) -> i32 {
    let port: u16 = lport_of(state, i) as u16
    let k: u64 = sock_kind(state, i)
    if k == SK_UDP {
        return stack.udp_bind(st(state), port)
    }
    if k == SK_TCP && (sock_flags(state, i) & SF_LISTEN) != 0 {
        return stack.net_listen(st(state), port)
    }
    return -1
}

fn rebind_all(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < SOCK_MAX {
        if kstate.get(state, so_at(i) + SO_H) != NOHANDLE {
            let h: i32 = rebind_one(state, i)
            if h >= 0 {
                h_store(state, i, h as u64, in_epoch)
                n = n + 1
            }
        }
        i = i + 1
    }
    return n
}

fn stale_count(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < SOCK_MAX {
        if sock_stale(state, i) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn say_epoch(ep: u64, rebound: u64, stale: u64) {
    var s_e: [u8; 20] = "inet: readdr epoch=\0"
    var s_r: [u8; 10] = " rebound=\0"
    var s_s: [u8; 8] = " stale=\0"
    serial.puts((&s_e[0]) as u64)
    serial.dec(ep)
    serial.puts((&s_r[0]) as u64)
    serial.dec(rebound)
    serial.puts((&s_s[0]) as u64)
    serial.dec(stale)
    serial.nl()
}

fn h_store(state: u64, i: u64, h: u64, ep: u64) {
    kstate.set(state, so_at(i) + SO_H, (h & H_MASK) | (ep << 32))
}

fn sock_stale(state: u64, i: u64) -> bool {
    if i >= SOCK_MAX {
        return false
    }
    let raw: u64 = kstate.get(state, so_at(i) + SO_H)
    return raw != NOHANDLE && (raw >> 32) != in_epoch
}

fn gone_or(state: u64, i: u64, e: u64) -> u64 {
    if sock_stale(state, i) {
        return errno.neg(errno.E_CONNRESET)
    }
    return errno.neg(e)
}

fn rx_snapshot(state: u64, src: u64, n: u64) -> u64 {
    let dst: u64 = kstate.get(state, sc(S_SCRATCH))
    var k: u64 = 0
    while k + 4 <= n {
        __mmio_write32((dst + k) as *mut u32,
            __mmio_read32((src + k) as *mut u32))
        k = k + 4
    }
    while k < n {
        __mmio_write8((dst + k) as *mut u8,
            __mmio_read8((src + k) as *mut u8))
        k = k + 1
    }
    return dst
}

fn pump(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    let flags: u64 = hold(state)
    let s: *mut stack.Stack = st(state)
    let now: u64 = now_us(state)
    var work: u64 = 0

    var frame: u64 = 0
    var slot: u64 = 0
    var n: u64 = 0
    while n < PUMP_BATCH {
        let len: u64 = netdev.rx_take(state, &frame, &slot)
        if len == 0 {
            n = PUMP_BATCH
        } else {
            frame = rx_snapshot(state, frame, len)
            netmon.frame_seen(state, frame, len, false)
            let verdikt: u64 = ebpfhook.xdp(state, frame, len)
            if verdikt == ebpfhook.DROP {
                netdev.rx_recycle(state, slot)
                kstate.add(state, sc(S_IN), 1)
                work = work + 1
                n = n + 1
            } else {
                learn(state, frame, len)
                icmp_catch(state, frame, len)
            if !kodb.rx_hook(state, frame, len, ip(state), mask(state))
                && !wg.rx_hook(state, frame, len)
                && !sharebind.inbound(state, frame, len) {
                stack.net_input(s, frame as *mut u8, len as usize, now)
            }
            netdev.rx_recycle(state, slot)
            kstate.add(state, sc(S_IN), 1)
            work = work + 1
            n = n + 1
            }
        }
    }

    stack.net_poll(s, now)

    let out: u64 = kstate.get(state, sc(S_SCRATCH))
    n = 0
    while n < PUMP_BATCH {
        if netdev.tx_room(state) == 0 {
            n = PUMP_BATCH
        } else {
            let len: usize = stack.net_output(s, out as *mut u8,
                FRAME_CAP as usize, now)
            if len == 0 {
                n = PUMP_BATCH
            } else {
                netmon.frame_seen(state, out, len as u64, true)
                if wg.tx_hook(state, out, len as u64) == 0 {
                    count_tx(state, out, len as u64)
                    netdev.tx_frame(state, out, len as u64)
                    kstate.add(state, sc(S_OUT), 1)
                }
                work = work + 1
                n = n + 1
            }
        }
    }
    n = 0
    while n < PUMP_BATCH {
        let kl: u64 = kodb.tx_len()
        if kl == 0 || netdev.tx_room(state) == 0 {
            n = PUMP_BATCH
        } else {
            netdev.tx_frame(state, kodb.tx_ptr(), kl)
            kodb.tx_pop()
            kstate.add(state, sc(S_OUT), 1)
            work = work + 1
            n = n + 1
        }
    }
    wg.tick(state)

    kstate.add(state, sc(S_PUMPS), 1)
    drop_lock(state, flags)
    if work != 0 {
        sched.poll_kick(state)
    }
    return work
}

fn quiet_since(state: u64, t0: u64) -> bool {
    let now: u64 = now_us(state)
    return now > t0 && now - t0 >= QUIET_US
}

fn netd_body(state: u64, index: u64) {
    set_task(state, index + 1)
    var hot: u64 = HOT_TURNS
    var hot_t0: u64 = now_us(state)
    var seen: u64 = 0
    let old_rule: bool = kstate.mode_on(state, kstate.M_NETDHOT)
    while true {
        let kick_before: u64 = kstate.get(state, sc(S_KICK))
        var w: u64 = pump(state)
        kodb.service(state, ip(state))
        w = w + sharebind.pump(state)
        let kick: u64 = kstate.get(state, sc(S_KICK))
        if w > 0 || kick != seen {
            hot = HOT_TURNS
            hot_t0 = now_us(state)
            seen = kick
        }
        taskslot.tset(state, index, taskconst.T_WORK,
            kstate.get(state, sc(S_PUMPS)))
        if now_us(state) < hot_t0 {
            hot_t0 = now_us(state)
        }
        if hot > 0 {
            hot = hot - 1
            if !old_rule {
                let now: u64 = now_us(state)
                if now > hot_t0 && now - hot_t0 >= HOT_US {
                    hot = 0
                }
            }
        }
        if hot > 0 {
            sched.yield_now(state)
        } else if !old_rule && quiet_since(state, hot_t0) {
            sched.sleep_ticks_unless(state, sc(S_KICK), kick_before, QUIET_TICKS)
        } else {
            sched.sleep_ticks_unless(state, sc(S_KICK), kick_before, 1)
        }
    }
}

fn wake(state: u64) {
    kstate.add(state, sc(S_KICK), 1)
    let t: u64 = kstate.get(state, sc(S_TASK))
    if t != 0 {
        sched.wake_sleeper(state, t - 1)
    }
}

fn arp_at(i: u64) -> u64 {
    return sc(ARP_OFF + i * ARP_BYTES)
}

fn learn(state: u64, f: u64, n: u64) {
    if n < 14 {
        return
    }
    var src: u64 = 0
    let et: u64 = wire.eth_type(f as *mut u8) as u64
    if et == wire.ETYPE_ARP as u64 {
        if n < 14 + wire.ARP_LEN as u64 {
            return
        }
        src = wire.arp_spa(((f + 14) as *mut u8)) as u64
    } else if et == wire.ETYPE_IP4 as u64 {
        if n < 14 + 20 {
            return
        }
        src = wire.ip_src(((f + 14) as *mut u8)) as u64
    } else {
        return
    }
    if src == 0 {
        return
    }
    let lmask: u64 = mask(state) & 0xFFFFFFFF
    if ip(state) != 0 && (src & lmask) != (ip(state) & lmask) {
        return
    }
    var mac: u64 = 0
    var i: u64 = 0
    while i < 6 {
        mac = mac | (__mmio_read8((f + 6 + i) as *mut u8) as u64 << (i * 8))
        i = i + 1
    }
    var slot: u64 = ARP_MAX
    i = 0
    while i < ARP_MAX {
        if kstate.get(state, arp_at(i)) == src {
            slot = i
            i = ARP_MAX
        } else {
            i = i + 1
        }
    }
    if slot == ARP_MAX {
        slot = kstate.get(state, sc(S_ARPN)) % ARP_MAX
        kstate.set(state, sc(S_ARPN), slot + 1)
    }
    kstate.set(state, arp_at(slot), src)
    kstate.set(state, arp_at(slot) + 8, mac)
}

fn next_hop(state: u64, dst: u64) -> u64 {
    let m: u64 = mask(state) & 0xFFFFFFFF
    let g: u64 = gw(state) & 0xFFFFFFFF
    if (dst & m) != (ip(state) & m) && g != 0 {
        return g
    }
    return dst
}

fn route_via_gw(state: u64, dst: u64) -> bool {
    return next_hop(state, dst) != (dst & 0xFFFFFFFF)
}

fn hop_mac(state: u64, dst: u64) -> u64 {
    return arp_look(state, next_hop(state, dst))
}

fn arp_flush(state: u64) {
    var i: u64 = 0
    while i < ARP_MAX {
        kstate.set(state, arp_at(i), 0)
        kstate.set(state, arp_at(i) + 8, 0)
        i = i + 1
    }
    kstate.set(state, sc(S_ARPN), 0)
    kstate.set(state, sc(S_ARPTICK), 0)
}

fn arp_slots() -> u64 {
    return ARP_MAX
}

fn arp_ip_at(state: u64, i: u64) -> u64 {
    return kstate.get(state, arp_at(i))
}

fn arp_mac_slot(state: u64, i: u64) -> u64 {
    return kstate.get(state, arp_at(i) + 8)
}

fn arp_look(state: u64, target: u64) -> u64 {
    var i: u64 = 0
    while i < ARP_MAX {
        if kstate.get(state, arp_at(i)) == target {
            return kstate.get(state, arp_at(i) + 8)
        }
        i = i + 1
    }
    return 0
}

fn arp_ask(state: u64, target: u64) {
    if !arp_may_ask(state, target) {
        return
    }
    var f: [u8; 64] = [0 as u8; 64]
    var me: [u8; 6] = [0 as u8; 6]
    var zero: [u8; 6] = [0 as u8; 6]
    var bc: [u8; 6] = [0 as u8; 6]
    var i: u64 = 0
    while i < 6 {
        me[i as usize] = netdev.mac_at(state, i) as u8
        i = i + 1
    }
    wire.mac_broadcast(&bc[0])
    wire.eth_build(&f[0], &bc[0], &me[0], wire.ETYPE_ARP)
    wire.arp_build(&f[14], wire.ARP_REQUEST, &me[0],
        (ip(state) & 0xFFFFFFFF) as u32, &zero[0],
        (target & 0xFFFFFFFF) as u32)
    netmon.frame_seen(state, (&f[0]) as u64, 14 + wire.ARP_LEN as u64, true)
    count_tx(state, (&f[0]) as u64, 14 + wire.ARP_LEN as u64)
    netdev.tx_frame(state, (&f[0]) as u64, 14 + wire.ARP_LEN as u64)
}

fn icmp_at(i: u64) -> u64 {
    return sc(ICMP_OFF + (i % ICMP_SLOTS) * ICMP_BYTES)
}

fn icmp_catch(state: u64, f: u64, n: u64) {
    if n < 14 + 20 + 8 {
        return
    }
    if wire.eth_type(f as *mut u8) != wire.ETYPE_IP4 {
        return
    }
    let d: u64 = f + 14
    if wire.ip_proto(d as *mut u8) != wire.IP_ICMP {
        return
    }
    if wire.ip_dst(d as *mut u8) as u64 != ip(state) {
        return
    }
    let ihl: u64 = wire.ip_ihl(d as *mut u8) as u64
    if ihl < 20 {
        return
    }
    let icmp: u64 = d + ihl
    if wire.icmp_type(icmp as *mut u8) != wire.ICMP_ECHO_REPLY {
        return
    }
    var len: u64 = wire.ip_total(d as *mut u8) as u64
    if len <= ihl {
        return
    }
    len = len - ihl
    if len > ICMP_MAX {
        len = ICMP_MAX
    }
    let tail: u64 = kstate.get(state, sc(S_ICMP_TAIL))
    let a: u64 = icmp_at(tail)
    kstate.set(state, a, wire.ip_src(d as *mut u8) as u64)
    kstate.set(state, a + 8, len)
    var i: u64 = 0
    while i < len {
        kstate.set8(state + a + 16 + i,
            __mmio_read8((icmp + i) as *mut u8))
        i = i + 1
    }
    kstate.set(state, sc(S_ICMP_TAIL), tail + 1)
    kstate.add(state, sc(S_ECHOES), 1)
}

fn icmp_send(state: u64, dst: u64, body: u64, n: u64) -> u64 {
    if n < 8 || n > ICMP_MAX {
        return errno.neg(errno.E_INVAL)
    }
    let hop: u64 = next_hop(state, dst)
    let hw: u64 = arp_look(state, hop)
    if hw == 0 {
        arp_ask(state, hop)
        return errno.neg(errno.E_AGAIN)
    }
    var f: [u8; 256] = [0 as u8; 256]
    var me: [u8; 6] = [0 as u8; 6]
    var peer: [u8; 6] = [0 as u8; 6]
    var i: u64 = 0
    while i < 6 {
        me[i as usize] = netdev.mac_at(state, i) as u8
        peer[i as usize] = ((hw >> (i * 8)) & 0xFF) as u8
        i = i + 1
    }
    wire.eth_build(&f[0], &peer[0], &me[0], wire.ETYPE_IP4)
    i = 0
    while i < n {
        f[(34 + i) as usize] = kstate.get8(body + i) as u8
        i = i + 1
    }
    f[36] = 0 as u8
    f[37] = 0 as u8
    let sum: u16 = wire.checksum(&f[34], n as usize)
    wire.put16(&f[0], 36 as usize, sum)
    let seq: u64 = kstate.add(state, sc(S_SEQ), 1)
    wire.ip_build(&f[14], (seq & 0xFFFF) as u16, wire.IP_ICMP,
        (ip(state) & 0xFFFFFFFF) as u32, (dst & 0xFFFFFFFF) as u32,
        n as usize)
    netmon.frame_seen(state, (&f[0]) as u64, 14 + 20 + n, true)
    count_tx(state, (&f[0]) as u64, 14 + 20 + n)
    if !netdev.tx_frame(state, (&f[0]) as u64, 14 + 20 + n) {
        return errno.neg(errno.E_AGAIN)
    }
    return n
}

fn icmp_take(state: u64, dst: u64, cap: u64, from: *mut u64) -> u64 {
    let head: u64 = kstate.get(state, sc(S_ICMP_HEAD))
    if head == kstate.get(state, sc(S_ICMP_TAIL)) {
        return errno.neg(errno.E_AGAIN)
    }
    let a: u64 = icmp_at(head)
    *from = kstate.get(state, a)
    var len: u64 = kstate.get(state, a + 8)
    if len > cap {
        len = cap
    }
    var i: u64 = 0
    while i < len {
        kstate.set8(dst + i, kstate.get8(state + a + 16 + i) as u8)
        i = i + 1
    }
    kstate.set(state, sc(S_ICMP_HEAD), head + 1)
    return len
}

fn so_at(i: u64) -> u64 {
    return sc(SOCK_OFF + i * SOCK_BYTES)
}

fn lport_of(state: u64, i: u64) -> u64 {
    return kstate.get(state, so_at(i) + SO_PORT) & LPORT_MASK
}

fn lport_set(state: u64, i: u64, port: u64) {
    let w: u64 = kstate.get(state, so_at(i) + SO_PORT)
    kstate.set(state, so_at(i) + SO_PORT, (w - (w & LPORT_MASK)) | (port & LPORT_MASK))
}

fn peer_set(state: u64, i: u64, addr: u64, port: u64) {
    let lp: u64 = lport_of(state, i)
    kstate.set(state, so_at(i) + SO_PORT,
        lp | ((port & 0xFFFF) << PEER_PORT_SHIFT) | ((addr & 0xFFFFFFFF) << PEER_IP_SHIFT))
}

fn peer_ip_of(state: u64, i: u64) -> u64 {
    return kstate.get(state, so_at(i) + SO_PORT) >> PEER_IP_SHIFT
}

fn peer_port_of(state: u64, i: u64) -> u64 {
    return (kstate.get(state, so_at(i) + SO_PORT) >> PEER_PORT_SHIFT) & 0xFFFF
}

fn sock_kind(state: u64, i: u64) -> u64 {
    if i >= SOCK_MAX {
        return SK_FREE
    }
    return kstate.get(state, so_at(i) + SO_KIND) & 0xFF
}

fn sock_handle(state: u64, i: u64) -> u64 {
    if i >= SOCK_MAX {
        return NOHANDLE
    }
    let raw: u64 = kstate.get(state, so_at(i) + SO_H)
    if raw == NOHANDLE || (raw >> 32) != in_epoch {
        return NOHANDLE
    }
    return raw & H_MASK
}

fn sock_flags(state: u64, i: u64) -> u64 {
    return kstate.get(state, so_at(i) + SO_FLAGS)
}

fn sock_nonblock(state: u64, i: u64) -> bool {
    if i >= SOCK_MAX {
        return false
    }
    return (kstate.get(state, so_at(i) + SO_FLAGS) & SF_NONBLOCK) != 0
}

fn sock_set_nonblock(state: u64, i: u64) {
    if i >= SOCK_MAX {
        return
    }
    kstate.set(state, so_at(i) + SO_FLAGS,
        kstate.get(state, so_at(i) + SO_FLAGS) | SF_NONBLOCK)
}

fn sock_put_nonblock(state: u64, i: u64, on: bool) {
    if i >= SOCK_MAX {
        return
    }
    let flags: u64 = kstate.get(state, so_at(i) + SO_FLAGS)
    if on {
        kstate.set(state, so_at(i) + SO_FLAGS, flags | SF_NONBLOCK)
    } else {
        kstate.set(state, so_at(i) + SO_FLAGS, flags & (~SF_NONBLOCK))
    }
}

const TMO_MASK: u64 = 0xFFFFFF
const TMO_RCV_SHIFT: u64 = 8
const TMO_SND_SHIFT: u64 = 32

fn sock_tmo(state: u64, i: u64, snd: bool) -> u64 {
    if i >= SOCK_MAX {
        return 0
    }
    var sh: u64 = TMO_RCV_SHIFT
    if snd {
        sh = TMO_SND_SHIFT
    }
    return (kstate.get(state, so_at(i) + SO_KIND) >> sh) & TMO_MASK
}

fn sock_set_tmo(state: u64, i: u64, snd: bool, ticks: u64) {
    if i >= SOCK_MAX {
        return
    }
    var sh: u64 = TMO_RCV_SHIFT
    if snd {
        sh = TMO_SND_SHIFT
    }
    var t: u64 = ticks
    if t > TMO_MASK {
        t = TMO_MASK
    }
    let w: u64 = kstate.get(state, so_at(i) + SO_KIND)
    let keep: u64 = w - (w & (TMO_MASK << sh))
    kstate.set(state, so_at(i) + SO_KIND, keep | (t << sh))
}

fn sock_new(state: u64, kind: u64) -> u64 {
    var i: u64 = 0
    while i < SOCK_MAX {
        if (kstate.get(state, so_at(i) + SO_KIND) & 0xFF) == SK_FREE {
            kstate.set(state, so_at(i) + SO_KIND, kind)
            kstate.set(state, so_at(i) + SO_H, NOHANDLE)
            kstate.set(state, so_at(i) + SO_PORT, 0)
            kstate.set(state, so_at(i) + SO_FLAGS, 0)
            netmon.sock_gone(state, i)
            netmon.sock_open(state, i, sched.current(state),
                taskslot.tget(state, sched.current(state), taskconst.T_PID), kind)
            kstate.add(state, sc(S_SOCKS), 1)
            return i
        }
        i = i + 1
    }
    return SOCK_MAX
}

fn sock_free(state: u64, i: u64) {
    if i >= SOCK_MAX {
        return
    }
    netmon.sock_gone(state, i)
    kstate.set(state, so_at(i) + SO_KIND, SK_FREE)
    kstate.set(state, so_at(i) + SO_H, NOHANDLE)
    kstate.set(state, so_at(i) + SO_PORT, 0)
    kstate.set(state, so_at(i) + SO_FLAGS, 0)
}

fn sock_bind(state: u64, i: u64, port: u64) -> u64 {
    let k: u64 = sock_kind(state, i)
    if k == SK_FREE {
        return errno.neg(errno.E_BADF)
    }
    if port > 65535 {
        return errno.neg(errno.E_INVAL)
    }
    var bound: u64 = port
    if k == SK_UDP {
        let flags: u64 = hold(state)
        var h: i32 = 0 - 1
        if port == 0 {
            var tries: u64 = 0
            while h < 0 && tries < 64 {
                bound = EPHEMERAL_BASE + (kstate.add(state, sc(S_SEQ), 1) & EPHEMERAL_MASK)
                h = stack.udp_bind(st(state), (bound & 0xFFFF) as u16)
                tries = tries + 1
            }
        } else {
            h = stack.udp_bind(st(state), (port & 0xFFFF) as u16)
        }
        let ep: u64 = in_epoch
        drop_lock(state, flags)
        if h < 0 {
            return errno.neg(errno.E_ADDRINUSE)
        }
        h_store(state, i, h as u64, ep)
    }
    lport_set(state, i, bound)
    netmon.sset(state, i, netmon.S_LPORT, bound)
    return 0
}

fn sock_listen(state: u64, i: u64, backlog: u64) -> u64 {
    if sock_kind(state, i) != SK_TCP {
        return errno.neg(errno.E_OPNOTSUPP)
    }
    let port: u64 = lport_of(state, i)
    if port == 0 {
        return errno.neg(errno.E_INVAL)
    }
    let flags: u64 = hold(state)
    let h: i32 = stack.net_listen(st(state), (port & 0xFFFF) as u16)
    let ep: u64 = in_epoch
    drop_lock(state, flags)
    if h < 0 {
        return errno.neg(errno.E_ADDRINUSE)
    }
    h_store(state, i, h as u64, ep)
    kstate.set(state, so_at(i) + SO_FLAGS, sock_flags(state, i) | SF_LISTEN)
    return 0
}

fn sock_accept(state: u64, i: u64) -> u64 {
    if sock_kind(state, i) != SK_TCP {
        return errno.neg(errno.E_OPNOTSUPP)
    }
    let l: u64 = sock_handle(state, i)
    if l == NOHANDLE || (sock_flags(state, i) & SF_LISTEN) == 0 {
        return errno.neg(errno.E_INVAL)
    }
    let flags: u64 = hold(state)
    let h: i32 = stack.net_accept(st(state), l as i32)
    let ep: u64 = in_epoch
    drop_lock(state, flags)
    if h < 0 {
        return errno.neg(errno.E_AGAIN)
    }
    let n: u64 = sock_new(state, SK_TCP)
    if n >= SOCK_MAX {
        let f2: u64 = hold(state)
        stack.net_abort(st(state), h)
        drop_lock(state, f2)
        return errno.neg(errno.E_NFILE)
    }
    h_store(state, n, h as u64, ep)
    kstate.set(state, so_at(n) + SO_FLAGS, SF_CONNECTED | (sock_flags(state, i) & KA_MASK))
    ka_apply(state, n)
    let f3: u64 = hold(state)
    let t2: *mut tcp.Tcp = stack.net_tcp(st(state))
    let alp: u64 = tcp.tcp_local_port(t2, h) as u64
    let aip: u64 = tcp.tcp_peer_ip(t2, h) as u64
    let apt: u64 = tcp.tcp_peer_port(t2, h) as u64
    drop_lock(state, f3)
    kstate.set(state, so_at(n) + SO_PORT, alp)
    netmon.sset(state, n, netmon.S_LPORT, alp)
    netmon.sset(state, n, netmon.S_RADDR, aip)
    netmon.sset(state, n, netmon.S_RPORT, apt)
    return n
}

fn sock_ka_get(state: u64, i: u64, which: u64) -> u64 {
    let f: u64 = sock_flags(state, i)
    if which == KA_ON {
        if (f & SF_KEEPALIVE) != 0 {
            return 1
        }
        return 0
    }
    var v: u64 = 0
    if which == KA_IDLE {
        v = (f >> 8) & 0x7FFF
        if v == 0 {
            v = KA_IDLE_DEF
        }
    } else if which == KA_INTVL {
        v = (f >> 23) & 0x7FFF
        if v == 0 {
            v = KA_INTVL_DEF
        }
    } else {
        v = (f >> 38) & 0x7F
        if v == 0 {
            v = KA_CNT_DEF
        }
    }
    return v
}

fn ka_apply(state: u64, i: u64) {
    let h: u64 = sock_handle(state, i)
    if sock_kind(state, i) != SK_TCP || h == NOHANDLE {
        return
    }
    var on: bool = false
    if sock_ka_get(state, i, KA_ON) == 1 {
        on = true
    }
    let idle: u64 = sock_ka_get(state, i, KA_IDLE) * 1000000
    let intvl: u64 = sock_ka_get(state, i, KA_INTVL) * 1000000
    let cnt: u64 = sock_ka_get(state, i, KA_CNT)
    let flags: u64 = hold(state)
    stack.net_keepalive(st(state), h as i32, on, idle, intvl, cnt as u32,
        now_us(state))
    drop_lock(state, flags)
}

fn sock_ka_set(state: u64, i: u64, which: u64, v: u64) -> u64 {
    var f: u64 = sock_flags(state, i)
    if which == KA_ON {
        if v != 0 {
            f = f | SF_KEEPALIVE
        } else {
            f = f & ~SF_KEEPALIVE
        }
    } else if which == KA_IDLE {
        f = (f & ~(0x7FFF << 8)) | (v << 8)
    } else if which == KA_INTVL {
        f = (f & ~(0x7FFF << 23)) | (v << 23)
    } else {
        f = (f & ~(0x7F << 38)) | (v << 38)
    }
    kstate.set(state, so_at(i) + SO_FLAGS, f)
    ka_apply(state, i)
    return 0
}

fn sock_connect(state: u64, i: u64, addr: u64, port: u64) -> u64 {
    let k: u64 = sock_kind(state, i)
    if k == SK_FREE {
        return errno.neg(errno.E_BADF)
    }
    if k != SK_TCP {
        if k == SK_UDP && lport_of(state, i) == 0 {
            let br: u64 = sock_bind(state, i, 0)
            if errno.is_error(br) {
                return br
            }
        }
        peer_set(state, i, addr, port)
        netmon.sset(state, i, netmon.S_RADDR, addr)
        netmon.sset(state, i, netmon.S_RPORT, port)
        kstate.set(state, so_at(i) + SO_FLAGS,
            sock_flags(state, i) | SF_CONNECTED)
        return 0
    }
    if kstate.get(state, so_at(i) + SO_H) != NOHANDLE {
        return errno.neg(errno.E_ISCONN)
    }
    let flags: u64 = hold(state)
    let h: i32 = stack.net_connect(st(state), (addr & 0xFFFFFFFF) as u32,
        (port & 0xFFFF) as u16, now_us(state))
    let ep: u64 = in_epoch
    drop_lock(state, flags)
    if h < 0 {
        return errno.neg(errno.E_NFILE)
    }
    h_store(state, i, h as u64, ep)
    ka_apply(state, i)
    let f2: u64 = hold(state)
    let t: *mut tcp.Tcp = stack.net_tcp(st(state))
    let lp: u16 = tcp.tcp_local_port(t, h as i32)
    drop_lock(state, f2)
    kstate.set(state, so_at(i) + SO_PORT, lp as u64)
    netmon.sset(state, i, netmon.S_LPORT, lp as u64)
    netmon.sset(state, i, netmon.S_RADDR, addr)
    netmon.sset(state, i, netmon.S_RPORT, port)
    wake(state)
    return 0
}

fn sock_state(state: u64, i: u64) -> u64 {
    if sock_kind(state, i) != SK_TCP {
        return tcp.S_CLOSED as u64
    }
    let h: u64 = sock_handle(state, i)
    if h == NOHANDLE {
        return tcp.S_CLOSED as u64
    }
    let flags: u64 = hold(state)
    let s: u32 = stack.net_state(st(state), h as i32)
    drop_lock(state, flags)
    return s as u64
}

fn sock_error(state: u64, i: u64) -> u64 {
    if sock_stale(state, i) {
        return errno.E_CONNRESET
    }
    let h: u64 = sock_handle(state, i)
    if sock_kind(state, i) != SK_TCP || h == NOHANDLE {
        return 0
    }
    let flags: u64 = hold(state)
    let e: i32 = stack.net_error(st(state), h as i32)
    drop_lock(state, flags)
    if e == tcp.E_RESET {
        return errno.E_CONNRESET
    }
    if e == tcp.E_REFUSED {
        return errno.E_CONNREFUSED
    }
    if e == tcp.E_TIMEOUT {
        return errno.E_TIMEDOUT
    }
    return 0
}

fn udp_queued(state: u64, h: u64) -> u64 {
    if h >= UDP_HANDLES {
        return 0
    }
    let flags: u64 = hold(state)
    let s: *mut stack.Stack = st(state)
    var n: u64 = 0
    if (*s).udp_used[h as usize] == 1 && (*s).udp_head[h as usize] != (*s).udp_tail[h as usize] {
        n = 1
    }
    drop_lock(state, flags)
    return n
}

fn sock_readable(state: u64, i: u64) -> u64 {
    let h: u64 = sock_handle(state, i)
    let k: u64 = sock_kind(state, i)
    if h == NOHANDLE {
        if k == SK_ICMP {
            return kstate.get(state, sc(S_ICMP_TAIL))
                - kstate.get(state, sc(S_ICMP_HEAD))
        }
        return 0
    }
    if k == SK_UDP {
        return udp_queued(state, h)
    }
    if k != SK_TCP {
        return 0
    }
    let flags: u64 = hold(state)
    let n: usize = stack.net_readable(st(state), h as i32)
    drop_lock(state, flags)
    return n as u64
}

fn sock_next_len(state: u64, i: u64) -> u64 {
    let h: u64 = sock_handle(state, i)
    if sock_kind(state, i) != SK_UDP || h >= UDP_HANDLES {
        return 0
    }
    let flags: u64 = hold(state)
    let s: *mut stack.Stack = st(state)
    var n: u64 = 0
    if (*s).udp_used[h as usize] == 1 && (*s).udp_head[h as usize] != (*s).udp_tail[h as usize] {
        n = (*s).udp_dlen[(h as usize) * UDP_QUEUE_LEN + (*s).udp_head[h as usize]] as u64
    }
    drop_lock(state, flags)
    return n
}

fn sock_writable(state: u64, i: u64) -> u64 {
    let h: u64 = sock_handle(state, i)
    if sock_kind(state, i) != SK_TCP || h == NOHANDLE {
        return 0
    }
    let s: u64 = sock_state(state, i)
    if s == tcp.S_SYN_SENT as u64 || s == tcp.S_SYN_RECEIVED as u64 {
        return 0
    }
    let flags: u64 = hold(state)
    let n: usize = stack.net_writable(st(state), h as i32)
    drop_lock(state, flags)
    return n as u64
}

fn sock_acceptable(state: u64, i: u64) -> u64 {
    if sock_kind(state, i) != SK_TCP {
        return 0
    }
    let l: u64 = sock_handle(state, i)
    if l == NOHANDLE || (sock_flags(state, i) & SF_LISTEN) == 0 {
        return 0
    }
    let flags: u64 = hold(state)
    let t: *mut tcp.Tcp = stack.net_tcp(st(state))
    var n: u64 = 0
    var k: usize = 0
    while k < tcp.MAXCONN {
        let c: *mut tcp.Tcb = &(*t).c[k]
        if (*c).used == 1 && ((*c).listener as u64) == l && (*c).accepted == 0 {
            if (*c).state == tcp.S_ESTABLISHED || (*c).state == tcp.S_CLOSE_WAIT {
                n = n + 1
            }
        }
        k = k + 1
    }
    drop_lock(state, flags)
    return n
}

fn sock_hup(state: u64, i: u64) -> u64 {
    if sock_kind(state, i) != SK_TCP {
        return 0
    }
    if sock_stale(state, i) {
        return 1
    }
    let h: u64 = sock_handle(state, i)
    if h == NOHANDLE {
        return 0
    }
    if (sock_flags(state, i) & SF_LISTEN) != 0 {
        return 0
    }
    let s: u64 = sock_state(state, i)
    if s == tcp.S_CLOSE_WAIT as u64 || s == tcp.S_LAST_ACK as u64
        || s == tcp.S_CLOSING as u64 || s == tcp.S_TIME_WAIT as u64
        || s == tcp.S_CLOSED as u64 {
        return 1
    }
    return 0
}

fn sock_send(state: u64, i: u64, src: u64, n: u64) -> u64 {
    let k: u64 = sock_kind(state, i)
    if k == SK_FREE {
        return errno.neg(errno.E_BADF)
    }
    if k == SK_TCP {
        let h: u64 = sock_handle(state, i)
        if h == NOHANDLE {
            return gone_or(state, i, errno.E_NOTCONN)
        }
        let e: u64 = sock_error(state, i)
        if e != 0 {
            return errno.neg(e)
        }
        let flags: u64 = hold(state)
        let got: usize = stack.net_send(st(state), h as i32,
            src as *mut u8, n as usize)
        drop_lock(state, flags)
        if got == 0 && n != 0 {
            return errno.neg(errno.E_AGAIN)
        }
        netmon.pay_out(state, i, got as u64)
        wake(state)
        return got as u64
    }
    if k == SK_UDP && (sock_flags(state, i) & SF_CONNECTED) != 0 {
        return sock_sendto(state, i, src, n, 0, 0)
    }
    return errno.neg(errno.E_DESTADDRREQ)
}

fn sock_recv(state: u64, i: u64, dst: u64, n: u64) -> u64 {
    let k: u64 = sock_kind(state, i)
    if k == SK_FREE {
        return errno.neg(errno.E_BADF)
    }
    if k != SK_TCP {
        return errno.neg(errno.E_OPNOTSUPP)
    }
    let h: u64 = sock_handle(state, i)
    if h == NOHANDLE {
        return gone_or(state, i, errno.E_NOTCONN)
    }
    let flags: u64 = hold(state)
    let got: usize = stack.net_recv(st(state), h as i32, dst as *mut u8,
        n as usize)
    let s: u32 = stack.net_state(st(state), h as i32)
    drop_lock(state, flags)
    if got > 0 {
        netmon.pay_in(state, i, got as u64)
        return got as u64
    }
    if s == tcp.S_CLOSE_WAIT || s == tcp.S_LAST_ACK || s == tcp.S_CLOSED
        || s == tcp.S_TIME_WAIT || s == tcp.S_CLOSING {
        return 0
    }
    let e: u64 = sock_error(state, i)
    if e != 0 {
        return errno.neg(e)
    }
    return errno.neg(errno.E_AGAIN)
}

fn sock_sendto(state: u64, i: u64, src: u64, n: u64, addr: u64,
    port: u64) -> u64 {
    let k: u64 = sock_kind(state, i)
    if k == SK_TCP {
        return sock_send(state, i, src, n)
    }
    if k == SK_ICMP {
        let flags: u64 = hold(state)
        let r: u64 = icmp_send(state, addr, src, n)
        drop_lock(state, flags)
        if !errno.is_error(r) {
            netmon.sset(state, i, netmon.S_RADDR, addr)
            netmon.pay_out(state, i, r)
        }
        return r
    }
    if k != SK_UDP {
        return errno.neg(errno.E_BADF)
    }
    var dst_ip: u64 = addr
    var dst_port: u64 = port
    if (sock_flags(state, i) & SF_CONNECTED) != 0 && dst_ip == 0 && dst_port == 0 {
        dst_ip = peer_ip_of(state, i)
        dst_port = peer_port_of(state, i)
    }
    if dst_ip == 0 && dst_port == 0 {
        return errno.neg(errno.E_DESTADDRREQ)
    }
    var sport: u64 = lport_of(state, i)
    if sport == 0 {
        let br: u64 = sock_bind(state, i, 0)
        if errno.is_error(br) {
            return br
        }
        sport = lport_of(state, i)
    }
    netmon.sset(state, i, netmon.S_RADDR, dst_ip)
    netmon.sset(state, i, netmon.S_RPORT, dst_port)
    let flags: u64 = hold(state)
    let ok: bool = stack.udp_send(st(state), (sport & 0xFFFF) as u16,
        (dst_ip & 0xFFFFFFFF) as u32, (dst_port & 0xFFFF) as u16,
        src as *mut u8, n as usize, now_us(state))
    drop_lock(state, flags)
    if !ok {
        return errno.neg(errno.E_AGAIN)
    }
    netmon.pay_out(state, i, n)
    wake(state)
    return n
}

fn sock_recvfrom(state: u64, i: u64, dst: u64, n: u64, addr: *mut u64,
    port: *mut u64) -> u64 {
    let k: u64 = sock_kind(state, i)
    if k == SK_TCP {
        *addr = 0
        *port = 0
        return sock_recv(state, i, dst, n)
    }
    if k == SK_ICMP {
        let flags: u64 = hold(state)
        let r: u64 = icmp_take(state, dst, n, addr)
        drop_lock(state, flags)
        *port = 0
        if !errno.is_error(r) {
            netmon.pay_in(state, i, r)
        }
        return r
    }
    if k != SK_UDP {
        return errno.neg(errno.E_BADF)
    }
    let h: u64 = sock_handle(state, i)
    if h == NOHANDLE {
        return gone_or(state, i, errno.E_INVAL)
    }
    var fip: u32 = 0
    var fport: u16 = 0
    let flags: u64 = hold(state)
    let got: usize = stack.udp_recv(st(state), h as i32, dst as *mut u8,
        n as usize, &fip, &fport)
    drop_lock(state, flags)
    if got == 0 {
        return errno.neg(errno.E_AGAIN)
    }
    *addr = fip as u64
    *port = fport as u64
    netmon.pay_in(state, i, got as u64)
    return got as u64
}

fn sock_peer(state: u64, i: u64, addr: *mut u64, port: *mut u64) -> u64 {
    *addr = 0
    *port = 0
    if sock_kind(state, i) == SK_UDP {
        if (sock_flags(state, i) & SF_CONNECTED) == 0 {
            return errno.neg(errno.E_NOTCONN)
        }
        *addr = peer_ip_of(state, i)
        *port = peer_port_of(state, i)
        return 0
    }
    if sock_kind(state, i) != SK_TCP {
        return errno.neg(errno.E_OPNOTSUPP)
    }
    let h: u64 = sock_handle(state, i)
    if h == NOHANDLE {
        return errno.neg(errno.E_NOTCONN)
    }
    let flags: u64 = hold(state)
    let t: *mut tcp.Tcp = stack.net_tcp(st(state))
    *addr = tcp.tcp_peer_ip(t, h as i32) as u64
    *port = tcp.tcp_peer_port(t, h as i32) as u64
    drop_lock(state, flags)
    return 0
}

fn sock_local(state: u64, i: u64, addr: *mut u64, port: *mut u64) -> u64 {
    *addr = ip(state)
    *port = lport_of(state, i)
    if sock_kind(state, i) == SK_TCP {
        let h: u64 = sock_handle(state, i)
        if h != NOHANDLE {
            let flags: u64 = hold(state)
            let t: *mut tcp.Tcp = stack.net_tcp(st(state))
            let p: u16 = tcp.tcp_local_port(t, h as i32)
            drop_lock(state, flags)
            if p != 0 as u16 {
                *port = p as u64
            }
        }
    }
    return 0
}

fn sock_shutdown(state: u64, i: u64, how: u64) -> u64 {
    if sock_kind(state, i) != SK_TCP {
        return errno.neg(errno.E_OPNOTSUPP)
    }
    let h: u64 = sock_handle(state, i)
    if h == NOHANDLE {
        return errno.neg(errno.E_NOTCONN)
    }
    if how != 0 {
        let flags: u64 = hold(state)
        stack.net_close(st(state), h as i32)
        drop_lock(state, flags)
        wake(state)
    }
    return 0
}

fn sock_close(state: u64, i: u64) {
    let k: u64 = sock_kind(state, i)
    if k == SK_FREE {
        return
    }
    let h: u64 = sock_handle(state, i)
    if h != NOHANDLE {
        let flags: u64 = hold(state)
        if k == SK_TCP {
            stack.net_close(st(state), h as i32)
        } else if k == SK_UDP {
            stack.udp_close(st(state), h as i32)
        }
        drop_lock(state, flags)
        wake(state)
    }
    sock_free(state, i)
}

fn hex2(v: u64) {
    var i: u64 = 0
    while i < 2 {
        let d: u64 = (v >> ((1 - i) * 4)) & 0xF
        if d < 10 {
            serial.put((48 + d) as u8)
        } else {
            serial.put((87 + d) as u8)
        }
        i = i + 1
    }
}

fn print_state(state: u64) {
    var s_head: [u8; 7] = "net: \0\0"
    var s_ip: [u8; 5] = " ip=\0"
    var s_dot: [u8; 2] = ".\0"
    var s_mac: [u8; 7] = "  mac=\0"
    var s_colon: [u8; 2] = ":\0"
    var s_none: [u8; 14] = "net: no card\0\0"
    if !ready(state) {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_ip[0]) as u64)
    let a: u64 = ip(state)
    serial.dec((a >> 24) & 0xFF)
    serial.puts((&s_dot[0]) as u64)
    serial.dec((a >> 16) & 0xFF)
    serial.puts((&s_dot[0]) as u64)
    serial.dec((a >> 8) & 0xFF)
    serial.puts((&s_dot[0]) as u64)
    serial.dec(a & 0xFF)
    serial.puts((&s_mac[0]) as u64)
    var i: u64 = 0
    while i < 6 {
        if i > 0 {
            serial.puts((&s_colon[0]) as u64)
        }
        hex2(netdev.mac_at(state, i))
        i = i + 1
    }
    serial.nl()
}

static mut dh_state: u64 = 0
static mut dh_tx: u64 = 0
static mut dh_rx: u64 = 0
static mut dh_try: u64 = 0
static mut dh_dns1: u64 = 0
static mut dh_dns2: u64 = 0
static mut dh_dns3: u64 = 0

fn dhcp_set(was: u64, value: u64) {
    if was == 0 {
        dh_state = value
    }
    if was == 1 {
        dh_tx = value
    }
    if was == 2 {
        dh_rx = value
    }
    if was == 3 {
        dh_try = value
    }
    if was == 4 {
        dh_dns1 = value
    }
    if was == 5 {
        dh_dns2 = value
    }
    if was == 6 {
        dh_dns3 = value
    }
}

fn dhcp_get(was: u64) -> u64 {
    if was == 0 {
        return dh_state
    }
    if was == 1 {
        return dh_tx
    }
    if was == 2 {
        return dh_rx
    }
    if was == 3 {
        return dh_try
    }
    if was == 4 {
        return dh_dns1
    }
    if was == 5 {
        return dh_dns2
    }
    if was == 6 {
        return dh_dns3
    }
    return 0
}
