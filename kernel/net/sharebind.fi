profile kernel

export { bind_share, inbound, pump, H_INBOUND, H_PUMP }

const H_INBOUND: u64 = 0
const H_PUMP: u64 = 1
const H_COUNT: u64 = 2

static mut table: [u64; 2] = [0 as u64; 2]

fn bind_share(slot: u64, handler: u64) {
    if slot < H_COUNT {
        table[slot as usize] = handler
    }
}

fn inbound(state: u64, frame: u64, len: u64) -> bool {
    let handler: u64 = table[H_INBOUND as usize]
    if handler == 0 {
        return false
    }
    let call: fn(u64, u64, u64) -> bool = handler as fn(u64, u64, u64) -> bool
    return call(state, frame, len)
}

fn pump(state: u64) -> u64 {
    let handler: u64 = table[H_PUMP as usize]
    if handler == 0 {
        return 0
    }
    let call: fn(u64) -> u64 = handler as fn(u64) -> u64
    return call(state)
}
