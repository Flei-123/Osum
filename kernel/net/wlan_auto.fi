profile kernel

import serial
import lib.kstate
import mm.mmframe
import sched.sched
import sched.time
import fs.vfs
import wlan.device
import wlan.connect
import wlan.iwl_ops
import wlan.join
import wlan.dhcp_link
import wlan.autojoin
import wlan.iwl_pwr
import wlan.iwl_probe
import wlan.scanfmt
import wlan.iwl_le
import wlan.iwl_fwcaps
import wlan.ethconv
import wlan.addba
import wlan.iwl_cmdq
import wlan.linkprobe
import net.wlan_net
import drv.net.iwl
import drv.net.iwl_xport
import net.wlan_diag
import net.wltrace
import drv.net.iwl_heldcaps
import drv.net.iwl_heldmac

export {
    start, task_step, mac_ptr, pump, is_up, bind, unbind, driver_ready, state_code, rc_get, tries_get, name_copy,
    lease_ip, lease_mask, lease_gateway, lease_dns, losses_get, reconnects_get, echo_get, txfull_get, amsdu_get, addba_get, driver_bound, attach_held, scan_text, scan_count, STATE_NONE,
    scan_request, rejoin_request, scan_seq_get, scan_rc_get, diag_text, radio_set, radio_off, quirks_refresh
}

const STATE_NONE: u64 = 0xFFFF
const CONF_MAX: u64 = 512
const OBJ_PAGES: u64 = 16
const SCAN_PERIOD: u64 = 30
const SCAN_TEXT_CAP: u64 = 1024
const POLL_TICKS: u64 = 100
const UP_TICKS: u64 = 500
const TICKS_PER_SEC: u64 = 100
const XID_BASE: u64 = 0x57A10000

static mut wa_obj: u64 = 0
static mut wa_task: u64 = 0
static mut wa_dev: u64 = 0
static mut wa_mvm: u64 = 0
static mut wa_bound: u64 = 0
static mut wa_xid: u64 = 0
static mut wa_now: u64 = 0
static mut wa_old_rx: u64 = 0
static mut wa_echo: u64 = 0
static mut wa_txfull: u64 = 0
static mut wa_txwait: u64 = 1
static mut wa_amsdu: u64 = 0
static mut wa_addba: u64 = 0
static mut wa_resume: u64 = 0
static mut wa_resume_ok: u64 = 0
static mut wa_pmk_max: u64 = 0
static mut wa_scan_at: u64 = 0
static mut wa_scan_n: u64 = 0
static mut wa_scan_len: u64 = 0
static mut wa_scan_seq: u64 = 0
static mut wa_scan_rc: i64 = 0
static mut wa_rejoin: u64 = 0
static mut wa_hold_base: u64 = 0
static mut wa_hold_armed: u64 = 0
static mut wa_radio_off: u64 = 0
static mut wa_scan_buf: [u8; 1100] = [0 as u8; 1100]
static mut wa_raw: [u8; 1100] = [0 as u8; 1100]
static mut wa_mac: [u8; 6] = [0 as u8; 6]
static mut wa_eth: [u8; 1536] = [0 as u8; 1536]
static mut wa_frame: [u8; 1600] = [0 as u8; 1600]
static mut wa_prot: [u8; 1700] = [0 as u8; 1700]
static mut wa_rx: [u8; 2400] = [0 as u8; 2400]
static mut wa_plain: [u8; 2400] = [0 as u8; 2400]
static mut wa_conf: [u8; 520] = [0 as u8; 520]
static mut wa_path: [u8; 15] = "/etc/wlan.conf\0"

fn auto_of() -> *mut autojoin.Auto { return (wa_obj) as *mut autojoin.Auto }
fn join_of() -> *mut join.Join { return (wa_obj + 2 * 4096) as *mut join.Join }
fn session_of() -> *mut connect.Session { return (wa_obj + 6 * 4096) as *mut connect.Session }
fn scan_session_of() -> *mut connect.Session { return (wa_obj + 7 * 4096) as *mut connect.Session }
fn device_of() -> *mut device.Device { return (wa_obj + 8 * 4096) as *mut device.Device }
fn mvm_of() -> *mut iwl_ops.Mvm { return (wa_obj + 9 * 4096) as *mut iwl_ops.Mvm }
fn xctx_of() -> *mut iwl_xport.XCtx { return (wa_obj + 12 * 4096) as *mut iwl_xport.XCtx }
fn pend_addr() -> u64 { return wa_obj + 13 * 4096 }

fn alloc_objects(state: u64) -> bool {
    if wa_obj != 0 { return true }
    let a: u64 = mmframe.frame_run(state, OBJ_PAGES)
    if a == 0 { return false }
    var i: u64 = 0
    while i < OBJ_PAGES * 4096 {
        let q: *mut u64 = (a + i) as *mut u64
        *q = 0
        i = i + 8
    }
    wa_obj = a
    *auto_of() = autojoin.auto_new()
    return true
}

fn read_mac(p: *mut iwl_probe.Probe) {
    wa_mac[0] = 2 as u8
    wa_mac[1] = 0x4F as u8
    wa_mac[2] = 0x52 as u8
    wa_mac[3] = 0x49 as u8
    wa_mac[4] = 0x45 as u8
    wa_mac[5] = 0x4E as u8
    if iwl_heldmac.ready() {
        var j: u64 = 0
        while j < 6 {
            wa_mac[j as usize] = *((iwl_heldmac.mac() + j) as *mut u8)
            j = j + 1
        }
        return
    }
    if iwl_pwr.mac_access_get(p) != 0 { return }
    let m0: u64 = iwl_pwr.prph_rd(p, 0xA03080)
    let m1: u64 = iwl_pwr.prph_rd(p, 0xA03084)
    iwl_pwr.mac_access_put(p)
    if m0 == 0 && m1 == 0 { return }
    if m0 == 0xFFFFFFFF { return }
    let b0: u64 = (m0 >> 24) & 0xFF
    if (b0 & 1) != 0 { return }
    wa_mac[0] = b0 as u8
    wa_mac[1] = ((m0 >> 16) & 0xFF) as u8
    wa_mac[2] = ((m0 >> 8) & 0xFF) as u8
    wa_mac[3] = (m0 & 0xFF) as u8
    wa_mac[4] = ((m1 >> 8) & 0xFF) as u8
    wa_mac[5] = (m1 & 0xFF) as u8
}

fn attach_held(state: u64) -> bool {
    if wa_bound != 0 { return true }
    if !iwl.held_ready() { return false }
    if !alloc_objects(state) { return false }
    let p: *mut iwl_probe.Probe = iwl.held_probe()
    read_mac(p)
    let x: *mut iwl_xport.XCtx = xctx_of()
    *x = iwl_xport.xctx_new(state, (iwl.held_cq()) as u64, (p) as u64, pend_addr())
    iwl_xport.xctx_fast(x)
    let o: *mut iwl_ops.Mvm = mvm_of()
    *o = iwl_ops.mvm_new()
    iwl_ops.ops_set_address(o, (&wa_mac[0]) as u64)
    if iwl_heldcaps.ready() { iwl_ops.ops_set_caps(o, iwl_heldcaps.words()) }
    let g: *mut device.Device = device_of()
    *g = device.device_new()
    if !iwl_ops.ops_attach(g, o, (x) as u64, iwl_xport.tr_submit, iwl_xport.tr_poll) { return false }
    bind((g) as u64, (o) as u64)
    return true
}

fn bind(g: u64, o: u64) {
    wa_dev = g
    wa_mvm = o
    wa_bound = 1
}

fn unbind() {
    wa_bound = 0
    wa_dev = 0
    wa_mvm = 0
}

fn driver_bound() -> bool { return wa_bound != 0 }

fn quirks_refresh(state: u64) {
    let q: u64 = iwl.quirk_bits(state)
    if iwl_heldcaps.ready() { iwl_heldcaps.set_quirks(q) }
    if wa_mvm != 0 { iwl_fwcaps.caps_set_quirks(iwl_ops.ops_caps(mvm_of()), q) }
    if wa_mvm != 0 && wa_dev != 0 { iwl_ops.ops_sync_board(device_of(), mvm_of()) }
}
fn driver_ready() -> bool { return wa_bound != 0 && wa_dev != 0 && wa_mvm != 0 }

fn state_code() -> u64 {
    if wa_obj == 0 { return STATE_NONE }
    return autojoin.auto_state(auto_of())
}

fn rc_get() -> i64 {
    if wa_obj == 0 { return 0 }
    return autojoin.auto_rc(auto_of())
}

fn tries_get() -> u64 {
    if wa_obj == 0 { return 0 }
    return autojoin.auto_tries(auto_of())
}

fn name_copy(dst: u64) -> usize {
    var code: u64 = state_code()
    if code == STATE_NONE { code = autojoin.AS_WAIT_DRIVER }
    return autojoin.auto_name(code, dst)
}

fn lease_ip() -> u64 {
    if wa_obj == 0 || !autojoin.auto_up(auto_of()) { return 0 }
    return (*autojoin.auto_lease(auto_of())).ip
}

fn lease_mask() -> u64 {
    if wa_obj == 0 || !autojoin.auto_up(auto_of()) { return 0 }
    return (*autojoin.auto_lease(auto_of())).mask
}

fn lease_gateway() -> u64 {
    if wa_obj == 0 || !autojoin.auto_up(auto_of()) { return 0 }
    return (*autojoin.auto_lease(auto_of())).gateway
}

fn lease_dns() -> u64 {
    if wa_obj == 0 || !autojoin.auto_up(auto_of()) { return 0 }
    return (*autojoin.auto_lease(auto_of())).dns
}

fn losses_get() -> u64 {
    if wa_obj == 0 { return 0 }
    return autojoin.auto_losses(auto_of())
}

fn echo_get() -> u64 { return wa_echo }
fn txfull_get() -> u64 { return wa_txfull }
fn amsdu_get() -> u64 { return wa_amsdu }
fn addba_get() -> u64 { return wa_addba }

fn reconnects_get() -> u64 {
    if wa_obj == 0 { return 0 }
    return autojoin.auto_reconnects(auto_of())
}

fn conf_read(state: u64) -> u64 {
    let m: u64 = vfs.mount_for(state, (&wa_path[0]) as u64)
    if m >= vfs.MAX_MNT { return 0 }
    let node: u64 = vfs.node_for(state, m, (&wa_path[0]) as u64)
    if node == 0 { return 0 }
    let n: u64 = vfs.v_read(state, m, node, 0, (&wa_conf[0]) as u64, CONF_MAX)
    if n > CONF_MAX { return 0 }
    return n
}

fn conf_wipe() {
    var i: u64 = 0
    while i < 520 {
        wa_conf[i as usize] = 0 as u8
        i = i + 1
    }
}

fn idle_yield(ctx: u64) -> u64 {
    let pmk: bool = wa_obj != 0 && autojoin.auto_state(auto_of()) == autojoin.AS_PMK
    if pmk && wa_resume_ok != 0 {
        let gap: u64 = time.since(wa_resume)
        if gap > wa_pmk_max { wa_pmk_max = gap }
    }
    sched.yield_now(ctx)
    wa_resume = time.tsc()
    if pmk { wa_resume_ok = 1 } else { wa_resume_ok = 0 }
    return 0
}

fn pmk_chunk_for(state: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_IWLOLDPBKDF) { return 1000000 }
    return autojoin.PMK_CHUNK_DEFAULT
}

fn log_pmk(state: u64) {
    var s_p: [u8; 17] = "wlan: pmk steps ␀"
    var s_m: [u8; 9] = " max_us ␀"
    var khz: u64 = time.khz(state)
    if khz == 0 { khz = 1 }
    serial.puts((&s_p[0]) as u64)
    serial.dec(autojoin.auto_pmk_steps(auto_of()))
    serial.puts((&s_m[0]) as u64)
    serial.dec(wa_pmk_max * 1000 / khz)
    serial.nl()
}

fn now_sec(state: u64) -> u64 {
    return kstate.get(state, kstate.TICKS) / TICKS_PER_SEC
}

fn log_state(rc: i64) {
    var nm: [u8; 24] = [0 as u8; 24]
    var s_a: [u8; 12] = "wlan: auto \0"
    var s_r: [u8; 5] = " rc \0"
    var s_t: [u8; 8] = " tries \0"
    let _n: usize = name_copy((&nm[0]) as u64)
    serial.puts((&s_a[0]) as u64)
    serial.puts((&nm[0]) as u64)
    serial.puts((&s_r[0]) as u64)
    if rc < 0 {
        serial.put(45 as u8)
        serial.dec((0 - rc) as u64)
    } else {
        serial.dec(rc as u64)
    }
    serial.puts((&s_t[0]) as u64)
    serial.dec(tries_get())
    serial.nl()
}

fn attempt(state: u64) {
    let n: u64 = conf_read(state)
    *join_of() = join.join_new()
    *session_of() = connect.session_new()
    wa_xid = wa_xid + 1
    wa_pmk_max = 0
    wa_resume_ok = 0
    autojoin.auto_pmk_chunk_set(auto_of(), pmk_chunk_for(state))
    let rc: i64 = autojoin.auto_attempt(auto_of(), (&wa_conf[0]) as u64, n as usize, join_of(), session_of(),
        (wa_dev) as *mut device.Device, (wa_mvm) as *mut iwl_ops.Mvm, idle_yield, state,
        XID_BASE + wa_xid, now_sec(state))
    conf_wipe()
    log_pmk(state)
    log_state(rc)
}

fn diag_text(dst: u64, cap: u64) -> u64 { return wlan_diag.render(dst, cap, mvm_of(), xctx_of()) }
fn scan_count() -> u64 { return wa_scan_n }
fn scan_seq_get() -> u64 { return wa_scan_seq }
fn scan_rc_get() -> i64 { return wa_scan_rc }
fn scan_request() { wa_scan_at = 0 }
fn rejoin_request() { wa_rejoin = 1 }
fn radio_off() -> bool { return wa_radio_off != 0 }

fn radio_set(off: bool) {
    var s_off: [u8; 19] = "wlan: radio off\0\0\0\0"
    var s_on: [u8; 19] = "wlan: radio on\0\0\0\0\0"
    if off == (wa_radio_off != 0) { return }
    if off {
        wa_radio_off = 1
        serial.puts((&s_off[0]) as u64)
    } else {
        wa_radio_off = 0
        wa_scan_at = 0
        wa_rejoin = 1
        serial.puts((&s_on[0]) as u64)
    }
    serial.nl()
}

fn radio_down() {
    if autojoin.auto_up(auto_of()) {
        connect.trennen(session_of(), (wa_dev) as *mut device.Device)
        autojoin.auto_link_lost(auto_of(), wa_now)
    }
}

fn scan_text(dst: u64, cap: u64) -> u64 {
    var n: u64 = wa_scan_len
    if n > cap { n = cap }
    var i: u64 = 0
    while i < n {
        *((dst + i) as *mut u8) = wa_scan_buf[i as usize]
        i = i + 1
    }
    return n
}

fn scan_render() {
    let raw: u64 = (&wa_raw[0]) as u64
    let n: usize = scanfmt.scan_lines(scan_session_of(), raw, SCAN_TEXT_CAP as usize)
    var out: u64 = 0
    var lines: u64 = 0
    var at: u64 = 0
    while at < n as u64 {
        if out + 4 + 1 > SCAN_TEXT_CAP { break }
        wa_scan_buf[out as usize] = 110 as u8
        wa_scan_buf[(out + 1) as usize] = 101 as u8
        wa_scan_buf[(out + 2) as usize] = 116 as u8
        wa_scan_buf[(out + 3) as usize] = 32 as u8
        out = out + 4
        var c: u8 = 0 as u8
        while at < n as u64 && c != 10 as u8 {
            c = wa_raw[at as usize]
            if out < SCAN_TEXT_CAP + 64 { wa_scan_buf[out as usize] = c }
            out = out + 1
            at = at + 1
        }
        lines = lines + 1
    }
    wa_scan_len = out
    wa_scan_n = lines
}

fn scan_pass(state: u64) {
    *join_of() = join.join_new()
    join.join_idle_set(join_of(), state, idle_yield)
    *scan_session_of() = connect.session_new()
    let rc: i64 = join.join_scan(join_of(), scan_session_of(), device_of(), mvm_of())
    wa_scan_rc = rc
    wa_scan_seq = wa_scan_seq + 1
    if rc == 0 || connect.net_count(scan_session_of()) != 0 { scan_render() }
    wa_scan_at = now_sec(state)
}

fn mac_ptr() -> u64 { return (&wa_mac[0]) as u64 }

fn is_up() -> bool { return wa_obj != 0 && autojoin.auto_up(auto_of()) }

fn pump_tx() -> u64 {
    var w: u64 = 0
    while wlan_net.tx_pending() && w < 8 {
        let n: u64 = wlan_net.tx_take((&wa_eth[0]) as u64, 1536)
        w = w + 1
        if n != 0 {
            let fl: i64 = ethconv.eth_to_wlan((&wa_eth[0]) as u64, n, (&wa_frame[0]) as u64, 1600,
                (&(*session_of()).aa[0]) as u64)
            if fl > 0 {
                let r: i64 = connect.data_send(session_of(), (wa_dev) as *mut device.Device, (&wa_frame[0]) as u64,
                    fl as usize, (&wa_prot[0]) as u64, 1700)
                if r == iwl_cmdq.E_CQ_FULL && wa_txwait != 0 {
                    wlan_net.tx_untake(n)
                    wa_txfull = wa_txfull + 1
                    return w - 1
                }
            }
        }
    }
    return w
}

fn deliver_amsdu(n: u64) {
    var at: u64 = ethconv.data_hdr_len((&wa_plain[0]) as u64, n)
    var next: u64 = 0
    var subs: u64 = 0
    while subs < 64 {
        let m: i64 = ethconv.amsdu_sub((&wa_plain[0]) as u64, n, at, (&wa_eth[0]) as u64, 1536, &next)
        if m <= 0 { return }
        let _o: bool = wlan_net.rx_offer((&wa_eth[0]) as u64, m as u64)
        wa_amsdu = wa_amsdu + 1
        at = next
        subs = subs + 1
    }
}
fn pump_rx() -> u64 {
    var w: u64 = 0
    var tries: u64 = 0
    while tries < 8 && wlan_net.rx_admit(wa_now, wa_old_rx != 0) {
        tries = tries + 1
        let n: i64 = connect.data_receive(session_of(), (wa_dev) as *mut device.Device, (&wa_rx[0]) as u64, 2400,
            (&wa_plain[0]) as u64, 2400)
        if n == 0 { return w }
        w = w + 1
        if n > 0 {
            autojoin.auto_rx_seen(auto_of(), wa_now)
            if addba.is_request((&wa_plain[0]) as u64, n as u64) {
                let rl: u64 = addba.build_decline((&wa_plain[0]) as u64, mac_ptr(), (&wa_frame[0]) as u64)
                let _s: i64 = device.send((wa_dev) as *mut device.Device, (&wa_frame[0]) as u64, rl as usize)
                wa_addba = wa_addba + 1
                continue
            }
            if ethconv.from_self((&wa_plain[0]) as u64, n as u64, mac_ptr()) {
                wa_echo = wa_echo + 1
                continue
            }
            if ethconv.is_amsdu((&wa_plain[0]) as u64, n as u64) {
                deliver_amsdu(n as u64)
                continue
            }
            let m: i64 = ethconv.wlan_to_eth((&wa_plain[0]) as u64, n as u64, (&wa_eth[0]) as u64, 1536)
            if m > 0 {
                let _o: bool = wlan_net.rx_offer((&wa_eth[0]) as u64, m as u64)
            }
        }
    }
    return w
}

fn send_probe() {
    let n: usize = linkprobe.arp_probe_build((&wa_eth[0]) as u64, (&wa_mac[0]) as u64,
        lease_ip(), lease_gateway())
    let fl: i64 = ethconv.eth_to_wlan((&wa_eth[0]) as u64, n as u64, (&wa_frame[0]) as u64, 1600,
        (&(*session_of()).aa[0]) as u64)
    if fl > 0 {
        let _r: i64 = connect.data_send(session_of(), (wa_dev) as *mut device.Device, (&wa_frame[0]) as u64,
            fl as usize, (&wa_prot[0]) as u64, 1700)
    }
}

fn log_link(msg: u64) {
    serial.puts(msg)
    serial.dec(losses_get())
    serial.nl()
}

fn link_watch(state: u64) {
    if kstate.mode_on(state, kstate.M_WLANNOLOSS) || kstate.mode_on(state, kstate.M_IWLOLDLOSS) || lease_gateway() == 0 { return }
    let r: u64 = autojoin.auto_link_check(auto_of(), wa_now)
    if r == autojoin.LC_PROBE {
        var s_p: [u8; 18] = "wlan: link probe ␀"
        send_probe()
        log_link((&s_p[0]) as u64)
    }
    if r == autojoin.LC_LOST {
        var s_l: [u8; 17] = "wlan: link lost ␀"
        autojoin.auto_link_lost(auto_of(), wa_now)
        connect.trennen(session_of(), (wa_dev) as *mut device.Device)
        wa_scan_at = 0
        log_link((&s_l[0]) as u64)
    }
}

fn pump() -> u64 {
    if !driver_ready() || !is_up() { return 0 }
    return pump_tx() + pump_rx()
}

fn task_step(state: u64) -> bool {
    wa_now = now_sec(state)
    wa_txwait = 1
    if kstate.mode_on(state, kstate.M_WLNOTXWAIT) { wa_txwait = 0 }
    wa_old_rx = 0
    if kstate.mode_on(state, kstate.M_IWLOLDRX) {
        wa_old_rx = 1
        wlan_net.set_rx_depth(8)
    }
    if !alloc_objects(state) {
        sched.sleep_ticks(state, UP_TICKS)
    } else if !driver_ready() && !attach_held(state) {
        if autojoin.auto_state(auto_of()) != autojoin.AS_WAIT_DRIVER {
            autojoin.auto_driver_wait(auto_of())
        }
        sched.sleep_ticks(state, POLL_TICKS)
    } else if wa_radio_off != 0 {
        radio_down()
        sched.sleep_ticks(state, POLL_TICKS)
    } else if wa_rejoin != 0 {
        wa_rejoin = 0
        if autojoin.auto_up(auto_of()) {
            connect.trennen(session_of(), (wa_dev) as *mut device.Device)
        }
        autojoin.auto_kick(auto_of())
        wa_hold_base = autojoin.auto_tries(auto_of())
        wa_hold_armed = 1
        sched.sleep_ticks(state, 1)
    } else if autojoin.auto_up(auto_of()) {
        link_watch(state)
        return autojoin.auto_up(auto_of())
    } else if wa_scan_at == 0 || now_sec(state) >= wa_scan_at + SCAN_PERIOD {
        scan_pass(state)
        wa_scan_at = now_sec(state)
        sched.sleep_ticks(state, 1)
    } else if autojoin.auto_due(auto_of(), now_sec(state)) && !(kstate.mode_on(state, kstate.M_WLTRACE) && (wa_hold_armed == 0 || autojoin.auto_tries(auto_of()) > wa_hold_base)) {
        attempt(state)
        sched.sleep_ticks(state, 1)
    } else {
        sched.sleep_ticks(state, POLL_TICKS)
    }
    return false
}

fn start(state: u64) -> u64 {
    wltrace.sync(state)
    if wa_task != 0 { return wa_task }
    let t: u64 = sched.create(state, sched.K_WLAN, 1, 0, 0)
    if t == 0 { return 0 }
    sched.start(state, t)
    wa_task = t
    return t
}
