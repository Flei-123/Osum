profile kernel

import lib.kstate
import sched.sched
import net.wlan_auto
import net.wlan_reload
import net.wlan_rfkill
import net.wlan_net
import net.netdev
import net.netsvc
import net.inet
import diag.hw

export { task_body, wired, last_ip, prefix_of, lease_of, LEASE_IP, LEASE_MASK, LEASE_GW, LEASE_DNS }

const YIELD_TURNS: u64 = 64

const LEASE_IP: u64 = 0
const LEASE_MASK: u64 = 1
const LEASE_GW: u64 = 2
const LEASE_DNS: u64 = 3

static mut wl_wired: u64 = 0
static mut wl_staged: u64 = 0
static mut wl_last_ip: u64 = 0

fn wired() -> bool { return wl_wired != 0 }

fn last_ip() -> u64 { return wl_last_ip }

fn lease_of(state: u64, which: u64) -> u64 {
    if wl_wired == 0 || netdev.kind_on(state, netdev.uplink(state)) != netdev.KIND_WLAN {
        return 0
    }
    if which == LEASE_IP { return wlan_auto.lease_ip() }
    if which == LEASE_MASK { return wlan_auto.lease_mask() }
    if which == LEASE_GW { return wlan_auto.lease_gateway() }
    if which == LEASE_DNS { return wlan_auto.lease_dns() }
    return 0
}

fn prefix_of(mask: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < 32 {
        if ((mask >> (31 - i)) & 1) == 0 { return n }
        n = n + 1
        i = i + 1
    }
    return n
}

fn wlan_is_uplink(state: u64) -> bool {
    return netdev.kind_on(state, netdev.uplink(state)) == netdev.KIND_WLAN
}

fn wire(state: u64) {
    wlan_net.set_mac(wlan_auto.mac_ptr())
    wlan_net.set_link(true)
    let _late: bool = netdev.wlan_late(state)
    wl_wired = 1
    let ip: u64 = wlan_auto.lease_ip()
    wl_last_ip = ip
    if kstate.mode_on(state, kstate.M_WLANFIRST) {
        netdev.uplink_prefer(state, netdev.KIND_WLAN)
    } else {
        let _c: bool = netdev.uplink_refresh(state)
    }
    if !wlan_is_uplink(state) {
        return
    }
    let prefix: u64 = prefix_of(wlan_auto.lease_mask())
    let gw: u64 = wlan_auto.lease_gateway()
    hw.net_set(state, ip, prefix, gw)
    if inet.ready(state) {
        let _r: bool = inet.readdr(state, (ip >> 24) & 0xFF, (ip >> 16) & 0xFF, (ip >> 8) & 0xFF, ip & 0xFF, prefix, gw)
    } else if wl_staged == 0 {
        wl_staged = 1
        netsvc.stage(state)
    }
}

fn unwire(state: u64) {
    let was_uplink: bool = wlan_is_uplink(state)
    wlan_net.set_link(false)
    if netdev.uplink_kind() == netdev.KIND_WLAN {
        netdev.uplink_prefer(state, netdev.KIND_NONE)
    }
    if was_uplink {
        hw.net_set(state, 0, 0, 0)
    }
    wl_wired = 0
}

fn task_body(state: u64, index: u64) {
    var idle: u64 = 0
    while true {
        wlan_reload.service(state)
        wlan_rfkill.watch(state)
        if wlan_auto.task_step(state) {
            if wl_wired == 0 { wire(state) }
            let w: u64 = wlan_auto.pump()
            if w != 0 {
                idle = 0
                sched.yield_now(state)
            } else {
                idle = idle + 1
                if idle > YIELD_TURNS {
                    sched.sleep_ticks(state, 1)
                } else {
                    sched.yield_now(state)
                }
            }
        } else if wl_wired != 0 {
            unwire(state)
        }
    }
}
