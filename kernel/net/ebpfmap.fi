
profile kernel

import lib.kstate

export {
    NMAPS, M_ARRAY, M_HASH, MAX_ENTRIES,
    init, create, destroy, kind_of, used, entries_of,
    lookup, lookup_value, update, delete, value_at, key_at, slot_used,
    hits, misses, updates, count_of
}

const NMAPS: u64 = 4

const MAX_ENTRIES: u64 = 64

const M_ARRAY: u64 = 1
const M_HASH: u64 = 2

const SCAL: u64 = 0x0000
const HDRS: u64 = 0x0040
const HBYTES: u64 = 64
const ENTS: u64 = 0x0200
const EBYTES: u64 = 24
const TBYTES: u64 = MAX_ENTRIES * EBYTES

const MP_HITS: u64 = 0x00
const MP_MISS: u64 = 0x08
const MP_UPD: u64 = 0x10

const H_KIND: u64 = 0
const H_N: u64 = 1
const H_COUNT: u64 = 2

const E_USE: u64 = 0
const E_KEY: u64 = 8
const E_VAL: u64 = 16

fn mp(off: u64) -> u64 {
    return kstate.EBPFMAP_OFF + off
}

fn hat(i: u64) -> u64 {
    return mp(HDRS + i * HBYTES)
}

fn eat(state: u64, i: u64, k: u64) -> u64 {
    return state + mp(ENTS + i * TBYTES + k * EBYTES)
}

fn init(state: u64) {
    var i: u64 = 0
    while i < kstate.EBPFMAP_MAX / 8 {
        kstate.set(state, mp(i * 8), 0)
        i = i + 1
    }
}

fn hits(state: u64) -> u64 {
    return kstate.get(state, mp(MP_HITS))
}

fn misses(state: u64) -> u64 {
    return kstate.get(state, mp(MP_MISS))
}

fn updates(state: u64) -> u64 {
    return kstate.get(state, mp(MP_UPD))
}

fn kind_of(state: u64, i: u64) -> u64 {
    if i >= NMAPS {
        return 0
    }
    return kstate.get(state, hat(i) + H_KIND * 8)
}

fn used(state: u64, i: u64) -> bool {
    return kind_of(state, i) != 0
}

fn entries_of(state: u64, i: u64) -> u64 {
    if i >= NMAPS {
        return 0
    }
    return kstate.get(state, hat(i) + H_N * 8)
}

fn count_of(state: u64, i: u64) -> u64 {
    if i >= NMAPS {
        return 0
    }
    return kstate.get(state, hat(i) + H_COUNT * 8)
}

fn create(state: u64, kind: u64, n: u64) -> u64 {
    if kind != M_ARRAY && kind != M_HASH {
        return NMAPS
    }
    if n == 0 || n > MAX_ENTRIES {
        return NMAPS
    }
    var i: u64 = 0
    while i < NMAPS {
        if kstate.get(state, hat(i) + H_KIND * 8) == 0 {
            var k: u64 = 0
            while k < MAX_ENTRIES {
                __mmio_write64((eat(state, i, k) + E_USE) as *mut u64, 0)
                __mmio_write64((eat(state, i, k) + E_KEY) as *mut u64, 0)
                __mmio_write64((eat(state, i, k) + E_VAL) as *mut u64, 0)
                k = k + 1
            }
            kstate.set(state, hat(i) + H_KIND * 8, kind)
            kstate.set(state, hat(i) + H_N * 8, n)
            kstate.set(state, hat(i) + H_COUNT * 8, 0)
            if kind == M_ARRAY {
                var j: u64 = 0
                while j < n {
                    __mmio_write64((eat(state, i, j) + E_USE) as *mut u64, 1)
                    __mmio_write64((eat(state, i, j) + E_KEY) as *mut u64, j)
                    j = j + 1
                }
                kstate.set(state, hat(i) + H_COUNT * 8, n)
            }
            return i
        }
        i = i + 1
    }
    return NMAPS
}

fn destroy(state: u64, i: u64) -> bool {
    if i >= NMAPS || kstate.get(state, hat(i) + H_KIND * 8) == 0 {
        return false
    }
    kstate.set(state, hat(i) + H_KIND * 8, 0)
    kstate.set(state, hat(i) + H_N * 8, 0)
    kstate.set(state, hat(i) + H_COUNT * 8, 0)
    var k: u64 = 0
    while k < MAX_ENTRIES {
        __mmio_write64((eat(state, i, k) + E_USE) as *mut u64, 0)
        __mmio_write64((eat(state, i, k) + E_KEY) as *mut u64, 0)
        __mmio_write64((eat(state, i, k) + E_VAL) as *mut u64, 0)
        k = k + 1
    }
    return true
}

fn hash(k: u64, n: u64) -> u64 {
    let h: u64 = (k *% 0x9E3779B97F4A7C15) >> 40
    return h % n
}

fn find(state: u64, i: u64, key: u64, want_free: u64) -> u64 {
    let n: u64 = kstate.get(state, hat(i) + H_N * 8)
    if n == 0 {
        return MAX_ENTRIES
    }
    var h: u64 = hash(key, n)
    var step: u64 = 0
    while step < n {
        let at: u64 = eat(state, i, h)
        let u: u64 = __mmio_read64((at + E_USE) as *mut u64)
        if u == 0 {
            if want_free != 0 {
                return h
            }
            return MAX_ENTRIES
        }
        if __mmio_read64((at + E_KEY) as *mut u64) == key {
            return h
        }
        h = h + 1
        if h >= n {
            h = 0
        }
        step = step + 1
    }
    return MAX_ENTRIES
}

fn slot_of(state: u64, i: u64, key: u64) -> u64 {
    let kind: u64 = kstate.get(state, hat(i) + H_KIND * 8)
    if kind == 0 {
        return MAX_ENTRIES
    }
    if kind == M_ARRAY {
        if key >= kstate.get(state, hat(i) + H_N * 8) {
            return MAX_ENTRIES
        }
        return key
    }
    return find(state, i, key, 0)
}

fn lookup(state: u64, map: u64, key: u64) -> u64 {
    if map >= NMAPS {
        kstate.add(state, mp(MP_MISS), 1)
        return 0
    }
    let s: u64 = slot_of(state, map, key)
    if s >= MAX_ENTRIES {
        kstate.add(state, mp(MP_MISS), 1)
        return 0
    }
    kstate.add(state, mp(MP_HITS), 1)
    return eat(state, map, s) + E_VAL
}

fn lookup_value(state: u64, map: u64, key: u64, found: *mut u64) -> u64 {
    *found = 0
    if map >= NMAPS {
        return 0
    }
    let s: u64 = slot_of(state, map, key)
    if s >= MAX_ENTRIES {
        return 0
    }
    *found = 1
    return __mmio_read64((eat(state, map, s) + E_VAL) as *mut u64)
}

fn update(state: u64, map: u64, key: u64, val: u64) -> u64 {
    if map >= NMAPS {
        return 1
    }
    let kind: u64 = kstate.get(state, hat(map) + H_KIND * 8)
    if kind == 0 {
        return 1
    }
    kstate.add(state, mp(MP_UPD), 1)
    if kind == M_ARRAY {
        if key >= kstate.get(state, hat(map) + H_N * 8) {
            return 1
        }
        __mmio_write64((eat(state, map, key) + E_VAL) as *mut u64, val)
        return 0
    }
    let s: u64 = find(state, map, key, 1)
    if s >= MAX_ENTRIES {
        return 1
    }
    let at: u64 = eat(state, map, s)
    let u0: u64 = __mmio_read64((at + E_USE) as *mut u64)
    if u0 == 0 {
        __mmio_write64((at + E_USE) as *mut u64, 1)
        __mmio_write64((at + E_KEY) as *mut u64, key)
        kstate.add(state, hat(map) + H_COUNT * 8, 1)
    }
    __mmio_write64((at + E_VAL) as *mut u64, val)
    return 0
}

fn delete(state: u64, map: u64, key: u64) -> u64 {
    if map >= NMAPS {
        return 1
    }
    let kind: u64 = kstate.get(state, hat(map) + H_KIND * 8)
    if kind == 0 {
        return 1
    }
    if kind == M_ARRAY {
        if key >= kstate.get(state, hat(map) + H_N * 8) {
            return 1
        }
        __mmio_write64((eat(state, map, key) + E_VAL) as *mut u64, 0)
        return 0
    }
    let s: u64 = find(state, map, key, 0)
    if s >= MAX_ENTRIES {
        return 1
    }
    let n: u64 = kstate.get(state, hat(map) + H_N * 8)
    __mmio_write64((eat(state, map, s) + E_USE) as *mut u64, 0)
    __mmio_write64((eat(state, map, s) + E_KEY) as *mut u64, 0)
    __mmio_write64((eat(state, map, s) + E_VAL) as *mut u64, 0)
    if kstate.get(state, hat(map) + H_COUNT * 8) > 0 {
        kstate.set(state, hat(map) + H_COUNT * 8,
            kstate.get(state, hat(map) + H_COUNT * 8) - 1)
    }
    var h: u64 = s + 1
    if h >= n {
        h = 0
    }
    var step: u64 = 0
    while step < n {
        let at: u64 = eat(state, map, h)
        let u1: u64 = __mmio_read64((at + E_USE) as *mut u64)
        if u1 == 0 {
            step = n
        } else {
            let k2: u64 = __mmio_read64((at + E_KEY) as *mut u64)
            let v2: u64 = __mmio_read64((at + E_VAL) as *mut u64)
            __mmio_write64((at + E_USE) as *mut u64, 0)
            __mmio_write64((at + E_KEY) as *mut u64, 0)
            __mmio_write64((at + E_VAL) as *mut u64, 0)
            if kstate.get(state, hat(map) + H_COUNT * 8) > 0 {
                kstate.set(state, hat(map) + H_COUNT * 8,
                    kstate.get(state, hat(map) + H_COUNT * 8) - 1)
            }
            update(state, map, k2, v2)
            h = h + 1
            if h >= n {
                h = 0
            }
            step = step + 1
        }
    }
    return 0
}

fn value_at(state: u64, map: u64, slot: u64) -> u64 {
    if map >= NMAPS || slot >= MAX_ENTRIES {
        return 0
    }
    return __mmio_read64((eat(state, map, slot) + E_VAL) as *mut u64)
}

fn key_at(state: u64, map: u64, slot: u64) -> u64 {
    if map >= NMAPS || slot >= MAX_ENTRIES {
        return 0
    }
    return __mmio_read64((eat(state, map, slot) + E_KEY) as *mut u64)
}

fn slot_used(state: u64, map: u64, slot: u64) -> u64 {
    if map >= NMAPS || slot >= MAX_ENTRIES {
        return 0
    }
    return __mmio_read64((eat(state, map, slot) + E_USE) as *mut u64)
}
