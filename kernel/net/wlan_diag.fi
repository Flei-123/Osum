profile kernel

import wlan.iwl_ops
import drv.net.iwl_xport
import wlan.iwl_fwerr

export { render }

static mut S_DIAG: [u8; 7] = "diag: \0"
static mut S_STEP: [u8; 6] = "step=\0"
static mut S_ERR: [u8; 6] = " err=\0"
static mut S_CMD: [u8; 8] = " cmd=0x\0"
static mut S_RLEN: [u8; 7] = " rlen=\0"
static mut S_W0: [u8; 7] = " w0=0x\0"
static mut S_OK: [u8; 7] = " ok=0x\0"
static mut S_SENT: [u8; 7] = " sent=\0"
static mut S_XCMD: [u8; 9] = " last=0x\0"
static mut S_XERR: [u8; 7] = " xerr=\0"
static mut S_FWERR: [u8; 19] = "diag: fwerr ptr=0x\0"
static mut S_UMAC: [u8; 19] = "diag: umac ptr=0x\0\0"
static mut S_FE_VALID: [u8; 10] = " valid=0x\0"
static mut S_FE_ID: [u8; 7] = " id=0x\0"
static mut S_FE_BL2: [u8; 11] = " blink2=0x\0"
static mut S_FE_IL1: [u8; 11] = " ilink1=0x\0"
static mut S_FE_D1: [u8; 10] = " data1=0x\0"
static mut S_FE_D2: [u8; 10] = " data2=0x\0"
static mut S_FE_HC: [u8; 9] = " hcmd=0x\0"
static mut S_NONE: [u8; 5] = "none\0"
static mut S_DEAD: [u8; 25] = "diag: fw_dead csr_int=0x\0"
static mut S_UPTR: [u8; 12] = " umac_at=0x\0"
static mut S_PHY: [u8; 8] = "phy_ctx\0"
static mut S_MAC: [u8; 8] = "mac_ctx\0"
static mut S_BIND: [u8; 8] = "binding\0"
static mut S_SCFG: [u8; 9] = "scan_cfg\0"
static mut S_AUX: [u8; 8] = "aux_sta\0"
static mut S_SREQ: [u8; 9] = "scan_req\0"
static mut S_UNK: [u8; 8] = "unknown\0"

struct Out {
    dst: u64,
    cap: u64,
    n: u64
}

fn put_ch(o: *mut Out, c: u64) {
    if (*o).n >= (*o).cap { return }
    *(((*o).dst + (*o).n) as *mut u8) = c as u8
    (*o).n = (*o).n + 1
}

fn put_str(o: *mut Out, s: u64) {
    var i: u64 = 0
    var done: bool = false
    while !done {
        let q: *mut u8 = (s + i) as *mut u8
        let c: u8 = *q
        if c == 0 {
            done = true
        } else {
            put_ch(o, c as u64)
            i = i + 1
        }
    }
}

fn put_dec(o: *mut Out, v: u64) {
    var tmp: [u8; 20] = [0 as u8; 20]
    var k: u64 = 0
    var x: u64 = v
    if x == 0 {
        put_ch(o, 48)
        return
    }
    while x != 0 {
        tmp[k as usize] = (48 + (x % 10)) as u8
        x = x / 10
        k = k + 1
    }
    while k != 0 {
        k = k - 1
        put_ch(o, tmp[k as usize] as u64)
    }
}

fn put_sdec(o: *mut Out, v: i64) {
    if v < 0 {
        put_ch(o, 45)
        put_dec(o, (0 - v) as u64)
    } else {
        put_dec(o, v as u64)
    }
}

fn put_hex(o: *mut Out, v: u64) {
    var started: bool = false
    var sh: u64 = 60
    while true {
        let d: u64 = (v >> sh) & 15
        if d != 0 || started || sh == 0 {
            started = true
            if d < 10 { put_ch(o, 48 + d) } else { put_ch(o, 87 + d) }
        }
        if sh == 0 { return }
        sh = sh - 4
    }
}

fn step_name(step: u64) -> u64 {
    if step == iwl_ops.STEP_NONE { return (&S_NONE[0]) as u64 }
    if step == iwl_ops.STEP_PHY_CTX { return (&S_PHY[0]) as u64 }
    if step == iwl_ops.STEP_MAC_CTX { return (&S_MAC[0]) as u64 }
    if step == iwl_ops.STEP_BINDING { return (&S_BIND[0]) as u64 }
    if step == iwl_ops.STEP_SCAN_CFG { return (&S_SCFG[0]) as u64 }
    if step == iwl_ops.STEP_AUX_STA { return (&S_AUX[0]) as u64 }
    if step == iwl_ops.STEP_SCAN_REQ { return (&S_SREQ[0]) as u64 }
    return (&S_UNK[0]) as u64
}

fn put_fwerr(o: *mut Out, fe: *mut iwl_fwerr.FwErr, head: u64) {
    put_str(o, head)
    put_hex(o, iwl_fwerr.fwerr_ptr(fe))
    put_str(o, (&S_FE_VALID[0]) as u64)
    put_hex(o, iwl_fwerr.fwerr_word(fe, iwl_fwerr.W_VALID))
    put_str(o, (&S_FE_ID[0]) as u64)
    put_hex(o, iwl_fwerr.fwerr_word(fe, iwl_fwerr.W_ID))
    put_str(o, (&S_FE_BL2[0]) as u64)
    put_hex(o, iwl_fwerr.fwerr_word(fe, iwl_fwerr.W_BLINK2))
    put_str(o, (&S_FE_IL1[0]) as u64)
    put_hex(o, iwl_fwerr.fwerr_word(fe, iwl_fwerr.W_ILINK1))
    put_str(o, (&S_FE_D1[0]) as u64)
    put_hex(o, iwl_fwerr.fwerr_word(fe, iwl_fwerr.W_DATA1))
    put_str(o, (&S_FE_D2[0]) as u64)
    put_hex(o, iwl_fwerr.fwerr_word(fe, iwl_fwerr.W_DATA2))
    put_str(o, (&S_FE_HC[0]) as u64)
    put_hex(o, iwl_fwerr.fwerr_word(fe, iwl_fwerr.W_HCMD))
    put_ch(o, 10)
}

fn render(dst: u64, cap: u64, m: *mut iwl_ops.Mvm, x: *mut iwl_xport.XCtx) -> u64 {
    var o: Out = Out { dst: dst, cap: cap, n: 0 }
    put_str(&o, (&S_DIAG[0]) as u64)
    put_str(&o, (&S_STEP[0]) as u64)
    put_str(&o, step_name(iwl_ops.ops_fail_step(m)))
    put_str(&o, (&S_ERR[0]) as u64)
    put_sdec(&o, iwl_ops.ops_fail_rc(m))
    put_str(&o, (&S_CMD[0]) as u64)
    put_hex(&o, iwl_ops.ops_fail_cmd(m))
    put_str(&o, (&S_OK[0]) as u64)
    put_hex(&o, iwl_ops.ops_ok_steps(m))
    put_str(&o, (&S_SENT[0]) as u64)
    put_dec(&o, iwl_xport.xp_sent(x))
    put_str(&o, (&S_XCMD[0]) as u64)
    put_hex(&o, iwl_xport.xp_last_cmd(x))
    put_str(&o, (&S_RLEN[0]) as u64)
    put_dec(&o, iwl_xport.xp_last_len(x))
    put_str(&o, (&S_W0[0]) as u64)
    put_hex(&o, iwl_xport.xp_last_w0(x))
    put_str(&o, (&S_XERR[0]) as u64)
    put_sdec(&o, iwl_xport.xp_last_err(x))
    put_ch(&o, 10)
    if iwl_xport.xp_fw_dead(x) != 0 {
        put_str(&o, (&S_DEAD[0]) as u64)
        put_hex(&o, iwl_xport.xp_fw_dead(x))
        put_str(&o, (&S_UPTR[0]) as u64)
        put_hex(&o, iwl_xport.xp_uerr_ptr(x))
        put_ch(&o, 10)
    }
    let fe: *mut iwl_fwerr.FwErr = iwl_xport.xp_fwerr(x)
    if iwl_fwerr.fwerr_count(fe) != 0 { put_fwerr(&o, fe, (&S_FWERR[0]) as u64) }
    let fu: *mut iwl_fwerr.FwErr = iwl_xport.xp_umac(x)
    if iwl_fwerr.fwerr_count(fu) != 0 { put_fwerr(&o, fu, (&S_UMAC[0]) as u64) }
    return o.n
}
