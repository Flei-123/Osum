profile kernel

import lib.kstate

export { publish, stage, heals, rung, age_ticks, published_since, H_UNKNOWN, H_OK, H_NOGW, H_NODNS, H_NOINET, STALE_TICKS }

const H_UNKNOWN: u64 = 0
const H_OK: u64 = 1
const H_NOGW: u64 = 2
const H_NODNS: u64 = 3
const H_NOINET: u64 = 4
const H_LAST: u64 = 4

const STALE_TICKS: u64 = 9000

static mut nh_stage: u64 = 0
static mut nh_heals: u64 = 0
static mut nh_rung: u64 = 0
static mut nh_tick: u64 = 0

fn publish(state: u64, st: u64, heal_count: u64, last_rung: u64) -> u64 {
    if st > H_LAST {
        return 0
    }
    nh_stage = st
    nh_heals = heal_count
    nh_rung = last_rung
    nh_tick = kstate.get(state, kstate.TICKS) + 1
    return 1
}

fn age_ticks(state: u64) -> u64 {
    if nh_tick == 0 {
        return 0xFFFFFFFF
    }
    return kstate.get(state, kstate.TICKS) + 1 - nh_tick
}

fn published_since(tick: u64) -> bool {
    return nh_tick > tick
}

fn stage(state: u64) -> u64 {
    if nh_tick == 0 || age_ticks(state) > STALE_TICKS {
        return H_UNKNOWN
    }
    return nh_stage
}

fn heals() -> u64 {
    return nh_heals
}

fn rung() -> u64 {
    return nh_rung
}
