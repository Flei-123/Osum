profile kernel

import sync.atomic
import sync.irqlock
import net.wlan_net

export { rx_take_on, rx_recycle_on, tx_room_on, tx_frame_on, tx_take, tx_untake, rx_offer, set_link }

fn rx_take_on(state: u64, u: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    let f: u64 = irqlock.enter(state, atomic.L_WLQ)
    let n: u64 = wlan_net.rx_take_on(state, u, frame, slot)
    irqlock.leave(state, atomic.L_WLQ, f)
    return n
}

fn rx_recycle_on(state: u64, u: u64, id: u64) {
    let f: u64 = irqlock.enter(state, atomic.L_WLQ)
    wlan_net.rx_recycle_on(state, u, id)
    irqlock.leave(state, atomic.L_WLQ, f)
}

fn tx_room_on(state: u64, u: u64) -> u64 {
    let f: u64 = irqlock.enter(state, atomic.L_WLQ)
    let n: u64 = wlan_net.tx_room_on(state, u)
    irqlock.leave(state, atomic.L_WLQ, f)
    return n
}

fn tx_frame_on(state: u64, u: u64, src: u64, n: u64) -> bool {
    let f: u64 = irqlock.enter(state, atomic.L_WLQ)
    let ok: bool = wlan_net.tx_frame_on(state, u, src, n)
    irqlock.leave(state, atomic.L_WLQ, f)
    return ok
}

fn tx_take(state: u64, dst: u64, cap: u64) -> u64 {
    let f: u64 = irqlock.enter(state, atomic.L_WLQ)
    let n: u64 = wlan_net.tx_take(dst, cap)
    irqlock.leave(state, atomic.L_WLQ, f)
    return n
}

fn tx_untake(state: u64, n: u64) {
    let f: u64 = irqlock.enter(state, atomic.L_WLQ)
    wlan_net.tx_untake(n)
    irqlock.leave(state, atomic.L_WLQ, f)
}

fn rx_offer(state: u64, src: u64, n: u64) -> bool {
    let f: u64 = irqlock.enter(state, atomic.L_WLQ)
    let ok: bool = wlan_net.rx_offer(src, n)
    irqlock.leave(state, atomic.L_WLQ, f)
    return ok
}

fn set_link(state: u64, on: bool) {
    let f: u64 = irqlock.enter(state, atomic.L_WLQ)
    wlan_net.set_link(on)
    irqlock.leave(state, atomic.L_WLQ, f)
}
