profile kernel

import lib.kstate
import lib.errno

export { count, name_text, apply, state_of }

static mut NAMES: [u8; 115] = "iwlnoown\niwlnoipoll\niwlnopoll\niwlnorxexp\niwlnoraw\niwlfhmsi\niwloldalive\niwlnotrace\niwloldslot\niwlrt0\niwlrt1\niwlrt2\n\0"

fn count() -> u64 {
    return 12
}

fn bit_of(i: u64) -> u64 {
    if i == 0 { return kstate.M_IWLNOOWN }
    if i == 1 { return kstate.M_IWLNOIPOLL }
    if i == 2 { return kstate.M_IWLNOPOLL }
    if i == 3 { return kstate.M_IWLNORXEXP }
    if i == 4 { return kstate.M_IWLNORAW }
    if i == 5 { return kstate.M_IWLFHMSI }
    if i == 6 { return kstate.M_IWLOLDALIVE }
    if i == 7 { return kstate.M_IWLNOTRACE }
    if i == 8 { return kstate.M_IWLOLDSLOT }
    if i == 9 { return kstate.M_IWLRT0 }
    if i == 10 { return kstate.M_IWLRT1 }
    return kstate.M_IWLRT2
}

fn name_text(index: u64, out: u64, cap: u64) -> u64 {
    if index >= count() {
        return errno.neg(errno.E_INVAL)
    }
    var line: u64 = 0
    var at: u64 = 0
    let base: u64 = (&NAMES[0]) as u64
    while line < index {
        if (*((base + at) as *mut u8)) == 10 as u8 {
            line = line + 1
        }
        at = at + 1
    }
    var n: u64 = 0
    while (*((base + at + n) as *mut u8)) != 10 as u8 {
        if n + 1 >= cap {
            return errno.neg(errno.E_INVAL)
        }
        __mmio_write8((out + n) as *mut u8, *((base + at + n) as *mut u8))
        n = n + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return n
}

fn apply(state: u64, knob: u64, value: u64) -> u64 {
    if knob == 0 {
        return 0
    }
    if knob > count() || value > 1 {
        return errno.neg(errno.E_INVAL)
    }
    let bit: u64 = bit_of(knob - 1)
    if value == 1 {
        kstate.mode_add(state, bit)
    } else {
        kstate.mode_del(state, bit)
    }
    return 0
}

fn state_of(state: u64, index: u64) -> u64 {
    if index >= count() {
        return errno.neg(errno.E_INVAL)
    }
    if kstate.mode_on(state, bit_of(index)) {
        return 1
    }
    return 0
}
