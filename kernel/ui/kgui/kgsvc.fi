    var p_nv: [u8; 13] = "/bin/netview\0"
    var a_flt: [u8; 31] = "netview\0filtered\0/bin/explorer\0"
    var a_fak: [u8; 30] = "netview\0faked\0/bin/widgetdemo\0"
    var a_non: [u8; 27] = "netview\0none\0/bin/settings\0"
    let _a: u64 = desk_spawn_n(state, (&p_nv[0]) as u64,
        (&a_flt[0]) as u64, 31, 3)
    var runden: u64 = 0
    while runden < 200 {
        wmkeys.poll(state)
        wmcompose.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }

    let _b: u64 = desk_spawn_n(state, (&p_nv[0]) as u64,
        (&a_fak[0]) as u64, 30, 3)
    runden = 0
    while runden < 200 {
        wmkeys.poll(state)
        wmcompose.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    let _c: u64 = desk_spawn_n(state, (&p_nv[0]) as u64,
        (&a_non[0]) as u64, 27, 3)
    runden = 0
    while runden < 400 {
        wmkeys.poll(state)
        wmcompose.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
}

fn k15_start(state: u64) -> u64 {
    var p_files: [u8; 14] = "/bin/explorer\0"
    var p_demo: [u8; 16] = "/bin/widgetdemo\0"
    var p_start: [u8; 14] = "/bin/launcher\0"
    var p_spei: [u8; 14] = "/bin/speicher\0"
    var a_files: [u8; 9] = "explorer\0"
    var a_demo: [u8; 11] = "widgetdemo\0"
    var a_start: [u8; 9] = "launcher\0"
    var a_spei: [u8; 9] = "speicher\0"
    var p_icons: [u8; 12] = "/bin/icont\0\0"
    var a_icons: [u8; 6] = "icont\0"
    var a_nohit: [u8; 6] = "nohit\0"
    var a_noclip: [u8; 7] = "noclip\0"
    var a_nokeys: [u8; 7] = "nokeys\0"
    var a_noidx: [u8; 6] = "noidx\0"
    var a_list: [u8; 6] = "liste\0"
    let abuf: u64 = state + kstate.EARG_OFF
    var path: u64 = (&p_demo[0]) as u64
    var arg0: u64 = (&a_demo[0]) as u64
    var n0: u64 = 11
    if kstate.mode_on(state, kstate.M_WIGFILES) {
        path = (&p_files[0]) as u64
        arg0 = (&a_files[0]) as u64
        n0 = 9
    }
    if kstate.mode_on(state, kstate.M_WIGSTART) {
        path = (&p_start[0]) as u64
        arg0 = (&a_start[0]) as u64
        n0 = 9
    }
    if kstate.mode_on(state, kstate.M_WIGSPEICHER) {
        path = (&p_spei[0]) as u64
        arg0 = (&a_spei[0]) as u64
        n0 = 9
    }

    if kstate.mode_on(state, kstate.M_WIGICONS) {
        path = (&p_icons[0]) as u64
        arg0 = (&a_icons[0]) as u64
        n0 = 6
    }

    wigapp_zerlegen(state)
    if wg_da != 0 {
        path = (&wg_path[0]) as u64
        arg0 = (&wg_args[0]) as u64
        n0 = wg_len
    }
    var at: u64 = 0
    var k: u64 = 0
    while k < n0 {
        kstate.set8(abuf + at, kstate.get8(arg0 + k) as u8)
        at = at + 1
        k = k + 1
    }
    var argc: u64 = 1
    if wg_da != 0 {
        argc = wg_argc
    }
    if kstate.mode_on(state, kstate.M_WIGNOHIT) {
        k = 0
        while k < 6 {
            kstate.set8(abuf + at, a_nohit[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    if kstate.mode_on(state, kstate.M_WIGNOCLIP) {
        k = 0
        while k < 7 {
            kstate.set8(abuf + at, a_noclip[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    if kstate.mode_on(state, kstate.M_WIGNOKEYS) {
        k = 0
        while k < 7 {
            kstate.set8(abuf + at, a_nokeys[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    if kstate.mode_on(state, kstate.M_WIGNOIDX) {
        k = 0
        while k < 6 {
            kstate.set8(abuf + at, a_noidx[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }

    if kstate.mode_on(state, kstate.M_WIGSTART) {
        k = 0
        while k < 6 {
            kstate.set8(abuf + at, a_list[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    if path == (&p_demo[0]) as u64 {
        var a_limit: [u8; 6] = "limit\0"
        k = 0
        while k < 6 {
            kstate.set8(abuf + at, a_limit[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    var s_k15: [u8; 12] = "k15: start \0"
    var s_pid: [u8; 11] = "k15: pid= \0"
    serial.puts((&s_k15[0]) as u64)
    serial.puts(path)
    serial.nl()
    let pid: u64 = elf.spawn(state, path, abuf, argc, 2)
    serial.puts((&s_pid[0]) as u64)
    serial.dec(pid)
    serial.nl()
    if pid == 0 {
        elf.say_reason(kstate.get(state, kstate.ELF_ERR))
    }
    var runden: u64 = 0
    while runden < 400 {
        wmkeys.poll(state)
        wmcompose.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    return pid
}

static mut sp_takt: u64 = 0

static mut sp_startet: u64 = 0

static mut lo_startet: u64 = 0

fn standby_wache(state: u64) {
    let sp: u64 = kstate.K11_OFF
    if kstate.get(state, sp + kstate.SP_STANDBY) == 0 {
        return
    }
    kstate.set(state, sp + kstate.SP_STANDBY, 0)
    var s_w: [u8; 18] = "standby: wunsch\0\0\0"
    var s_z: [u8; 20] = "standby: antwort=\0\0\0"
    serial.puts((&s_w[0]) as u64)
    serial.nl()
    let _f: bool = blk.flush(state)
    if kstate.get(state, sp + kstate.SP_ON) == 0 {
        kstate.set(state, sp + kstate.SP_ON, 1)
        kstate.add(state, sp + kstate.SP_LOCKS, 1)
    }
    let r: u64 = s3.suspend(state)
    var rc: u64 = 4
    if r == s3.R_OK_S3 || r == s3.R_RESUME {
        rc = 1
        kstate.add(state, sp + kstate.SP_STANDBYS, 1)

        wmbase.damage_all(state)
    } else if r == s3.R_SMP || r == s3.R_PARK {
        rc = 2
    } else if r == s3.R_NOS3 {
        rc = 3
    }
    kstate.set(state, sp + kstate.SP_STANDBYRC, rc)
    serial.puts((&s_z[0]) as u64)
    serial.dec(rc)
    serial.nl()
}

fn abmelde_wache(state: u64) {
    let sp: u64 = kstate.K11_OFF
    if kstate.get(state, sp + kstate.SP_LOGOUT) == 0 {
        return
    }
    if lo_startet != 0 {
        return
    }
    lo_startet = 1
    kstate.set(state, sp + kstate.SP_LOGOUT, 0)
    let uid: u64 = kstate.get(state, sp + kstate.SP_UID)
    var s_a: [u8; 24] = "logout: session uid=\0\0\0\0"
    let z_lo: u64 = serial.line_at()
    serial.puts((&s_a[0]) as u64)
    serial.dec(uid)
    serial.nl()
    serial.line_clear(z_lo)

    let _f: bool = blk.flush(state)
    var getroffen: u64 = 0
    if uid != 0 {
        var i: u64 = 0
        while i < kstate.MAX_TASKS {
            let z: u64 = sched.tget(state, i, sched.T_STATE)
            if z != sched.S_FREE && z != sched.S_ZOMBIE
               && sched.tget(state, i, sched.T_UID) == uid {
                let pid: u64 = sched.tget(state, i, sched.T_PID)
                if pid != 0 {
                    let _k: u64 = signal.send_pid(state, pid,
                        signal.SIGKILL)
                    getroffen = getroffen + 1
                }
            }
            i = i + 1
        }
    }
    var s_g: [u8; 20] = "logout: killed n=\0\0\0"
    serial.puts((&s_g[0]) as u64)
    serial.dec(getroffen)
    serial.nl()
    kstate.set(state, sp + kstate.SP_ON, 0)
    kstate.set(state, sp + kstate.SP_PID, 0)
    kstate.set(state, sp + kstate.SP_SLOT, 0)
    kstate.set(state, sp + kstate.SP_UID, 0)
    var p_glog: [u8; 13] = "/bin/glogin\0\0"
    var a_glog: [u8; 8] = "glogin\0\0"
    let space: u64 = desk_spawn(state, (&p_glog[0]) as u64,
        (&a_glog[0]) as u64, 8)
    var fresh: u64 = 0
    if space < kstate.MAX_TASKS {
        fresh = sched.tget(state, space, sched.T_PID)
    }
    kstate.add(state, sp + kstate.SP_LOGOUTS, 1)
    var s_n: [u8; 29] = "logout: login restarted pid=\0"
    serial.puts((&s_n[0]) as u64)
    serial.dec(fresh)
    serial.nl()
    lo_startet = 0
}

static mut tot_say: u64 = 0

fn window_watch(state: u64) {
    if wmgate.lock_active(state) || fb.sweep_aus(state) {
        return
    }
    let tasks: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < wm.MAX_WIN {
        if wmbase.valid(state, i) {
            let o: u64 = wmbase.win_owner(state, i)
            if o != 0 && o < tasks {
                let zs: u64 = sched.tget(state, o, sched.T_STATE)
                if zs == sched.S_ZOMBIE || zs == sched.S_FREE {
                    var s_t: [u8; 29] = "kgui: dead window removed i=\0"
                    var s_o: [u8; 8] = " owner=\0"
                    serial.puts((&s_t[0]) as u64)
                    serial.dec(i)
                    serial.puts((&s_o[0]) as u64)
                    serial.dec(o)
                    serial.nl()
                    let _d: bool = wmcore.destroy(state, i)
                    tot_say = tot_say + 1
                }
            }
        }
        i = i + 1
    }
}

static mut winch_c: [u64; 32] = [0 as u64; 32]

static mut winch_r: [u64; 32] = [0 as u64; 32]

fn winch_wache(state: u64) {
    var i: u64 = 0
    while i < wm.MAX_WIN {
        let sz: u64 = wmterm.term_size(state, i)
        if sz == 0 {
            winch_c[(i) as usize] = 0
            winch_r[(i) as usize] = 0
        } else {
            let c: u64 = sz & 0xFFFF
            let r: u64 = sz >> 16
            if winch_c[(i) as usize] == 0 {
                winch_c[(i) as usize] = c
                winch_r[(i) as usize] = r
            } else if winch_c[(i) as usize] != c || winch_r[(i) as usize] != r {
                winch_c[(i) as usize] = c
                winch_r[(i) as usize] = r
                let t: u64 = wmterm.tty_of(state, i)
                if t < tty.MAX_TTY && tty.valid(state, t) {
                    let grp: u64 = tty.pgrp(state, t)
                    var hit: u64 = 0
                    if grp != 0 {
                        hit = signal.send_pgid(state, grp, signal.SIGWINCH)
                    } else {
                        hit = signal.send_tty(state, t, t == tty.console(), signal.SIGWINCH)
                    }
                    var s_w: [u8; 17] = "kgui: winch win=\0"
                    var s_g: [u8; 6] = " grp=\0"
                    var s_h: [u8; 6] = " hit=\0"
                    serial.puts((&s_w[0]) as u64)
                    serial.dec(i)
                    serial.puts((&s_g[0]) as u64)
                    serial.dec(grp)
                    serial.puts((&s_h[0]) as u64)
                    serial.dec(hit)
                    var s_c: [u8; 7] = " cols=\0"
                    var s_r: [u8; 7] = " rows=\0"
                    serial.puts((&s_c[0]) as u64)
                    serial.dec(c)
                    serial.puts((&s_r[0]) as u64)
                    serial.dec(r)
                    serial.nl()
                }
            }
        }
        i = i + 1
    }
}

static mut hup_t: [u64; 32] = [0 as u64; 32]

static mut hup_said: u64 = 0

fn hup_in_use(state: u64, t: u64, skip: u64) -> bool {
    var j: u64 = 0
    while j < wm.MAX_WIN {
        if j != skip && wmterm.tty_of(state, j) == t && wm.win_kind(state, j) == wm.K_TERM {
            return true
        }
        j = j + 1
    }
    return false
}

fn hup_wache(state: u64) {
    var i: u64 = 0
    while i < wm.MAX_WIN {
        let t: u64 = wmterm.tty_of(state, i)
        let seen: u64 = hup_t[(i) as usize]
        if seen != 0 && (t == wmterm.NO_TTY || t + 1 != seen) {
            let old: u64 = seen - 1
            hup_t[(i) as usize] = 0

            if old < tty.MAX_TTY && tty.valid(state, old) && old != tty.console() && !hup_in_use(state, old, i) {
                let hit: u64 = signal.send_tty(state, old, false, signal.SIGHUP)
                if hup_said < 40 {
                    hup_said = hup_said + 1
                    var s_h: [u8; 18] = "kgui: hangup tty=\0"
                    var s_n: [u8; 6] = " hit=\0"
                    serial.puts((&s_h[0]) as u64)
                    serial.dec(old)
                    serial.puts((&s_n[0]) as u64)
                    serial.dec(hit)
                    serial.nl()
                }
            }
        }
        if t != wmterm.NO_TTY && t < tty.MAX_TTY && t != tty.console() && wm.win_kind(state, i) == wm.K_TERM {
            hup_t[(i) as usize] = t + 1
        }
        i = i + 1
    }
}

const ZOMBIE_MAX_AGE: u64 = 3000

static mut zs_tick: u64 = 0

static mut zs_said: u64 = 0

fn zombie_sweep(state: u64) {
    if fb.zreap_aus(state) {
        return
    }
    zs_tick = zs_tick + 1
    if (zs_tick & 15) != 0 {
        return
    }
    let me: u64 = sched.current(state)
    let n: u64 = kstate.get(state, kstate.TASKS)
    let now: u64 = kstate.get(state, kstate.TICKS)
    var i: u64 = 1
    while i < n {
        if sched.tget(state, i, sched.T_STATE) == sched.S_ZOMBIE && i != me {
            let p: u64 = sched.tget(state, i, sched.T_PARENT)
            var warum: u64 = 0
            if p == me {
                warum = 1
            } else if p >= n {
                warum = 2
            } else {
                let ps: u64 = sched.tget(state, p, sched.T_STATE)
                if ps == sched.S_FREE || ps == sched.S_ZOMBIE {
                    warum = 2
                } else if signal.handler_of(state, p, signal.SIGCHLD)
                    == signal.SIG_IGN {
                    warum = 3
                } else {
                    let ende: u64 = sched.tget(state, i, sched.T_END)
                    if now > ende && now - ende > ZOMBIE_MAX_AGE {
                        warum = 4
                    }
                }
            }
            if warum != 0 {
                if zs_said < 40 {
                    zs_said = zs_said + 1
                    var s_z: [u8; 22] = "kgui: zombie reaped \0\0"
                    var s_p: [u8; 9] = " parent=\0"
                    var s_w: [u8; 6] = " why=\0"
                    serial.puts((&s_z[0]) as u64)
                    serial.dec(sched.tget(state, i, sched.T_PID))
                    serial.puts((&s_p[0]) as u64)
                    serial.dec(sched.tget(state, i, sched.T_PARENT))
                    serial.puts((&s_w[0]) as u64)
                    serial.dec(warum)
                    serial.nl()
                }

                var j: u64 = 0
                while j < n {
                    if j != i && sched.tget(state, j, sched.T_STATE)
                        != sched.S_FREE
                        && sched.tget(state, j, sched.T_PARENT) == i {
                        sched.tset(state, j, sched.T_PARENT, me)
                    }
                    j = j + 1
                }
                let _r: bool = proc.reap(state, i)
            }
        }
        i = i + 1
    }
}

fn lock_watch(state: u64) {
    if !wmgate.lock_active(state) {
        return
    }
    if sp_startet != 0 {
        return
    }
    sp_takt = sp_takt + 1
    if (sp_takt & 31) != 0 {
        return
    }
    let pid: u64 = wmgate.sperrer(state)
    if pid != 0 {
        let t: u64 = sched.find_pid(state, pid)
        if t < kstate.MAX_TASKS {
            let z: u64 = sched.tget(state, t, sched.T_STATE)
            if z != sched.S_ZOMBIE && z != sched.S_FREE {
                return
            }
        }
    }
    var p_lock: [u8; 10] = "/bin/lock\0"
    var a_lock: [u8; 5] = "lock\0"
    sp_startet = 1

    let space: u64 = desk_spawn(state, (&p_lock[0]) as u64,
        (&a_lock[0]) as u64, 5)
    kstate.set(state, kstate.K11_OFF + kstate.SP_SLOT, space)
    var fresh: u64 = 0
    if space < kstate.MAX_TASKS {
        fresh = sched.tget(state, space, sched.T_PID)
    }
    kstate.set(state, kstate.K11_OFF + kstate.SP_PID, fresh)
    kstate.add(state, kstate.K11_OFF + kstate.SP_SPAWNS, 1)
    var s_w: [u8; 29] = "lock: locker restarted, pid=\0"
    serial.puts((&s_w[0]) as u64)
    serial.dec(fresh)
    serial.nl()
    sp_startet = 0
}

fn shell_start(state: u64) -> u64 {
    var p_sh: [u8; 8] = "/bin/sh\0"

    var p_osh: [u8; 9] = "/bin/osh\0"
    var a_sh: [u8; 3] = "sh\0"
    var p_run: u64 = (&p_sh[0]) as u64
    if fs.path(state, (&p_osh[0]) as u64) != 0 {
        p_run = (&p_osh[0]) as u64
    }
    let abuf: u64 = state + kstate.EARG_OFF
    var k: u64 = 0
    while k < 3 {
        kstate.set8(abuf + k, a_sh[k as usize])
        k = k + 1
    }
    var s_cs: [u8; 17] = "wm: console sh: \0"
    serial.puts((&s_cs[0]) as u64)
    serial.puts(p_run)
    serial.nl()
    return elf.spawn(state, p_run, abuf, 1, 2)
}

static mut tab_kid: [u64; 32] = [0 as u64; 32]

static mut tab_kpid: [u64; 32] = [0 as u64; 32]

fn tabs_spawn(state: u64) {
    var p_t: [u8; 10] = "/bin/term\0"
    var a_t: [u8; 5] = "term\0"
    let abuf: u64 = state + kstate.EARG_OFF
    var k: u64 = 0
    while k < 5 {
        kstate.set8(abuf + k, a_t[k as usize])
        k = k + 1
    }
    let slot: u64 = elf.spawn(state, (&p_t[0]) as u64, abuf, 1, 2)
    var s_ts: [u8; 24] = "wm: tab shell started: \0"
    serial.puts((&s_ts[0]) as u64)
    serial.dec(slot)
    serial.nl()
    if slot == 0 {
        wmtabs.tt_cancel(state)
        return
    }
    var j: u64 = 0
    while j < 32 {
        if tab_kid[j as usize] == 0 {
            tab_kid[j as usize] = slot
            tab_kpid[j as usize] = sched.tget(state, slot, sched.T_PID)
            return
        }
        j = j + 1
    }
}

fn tabs_reap(state: u64) {
    var j: u64 = 0
    while j < 32 {
        let sl: u64 = tab_kid[j as usize]
        if sl != 0 {
            if sched.tget(state, sl, sched.T_PID) != tab_kpid[j as usize] {
                tab_kid[j as usize] = 0
            } else if sched.tget(state, sl, sched.T_STATE) == sched.S_ZOMBIE {
                proc.reap(state, sl)
                tab_kid[j as usize] = 0
            }
        }
        j = j + 1
    }
}

fn jv_backoff(state: u64, now: u64) {
    jv_next = now + jv_wait
    var s_b: [u8; 30] = "desk: jarvisd restart in (s)=\0"
    let z_b: u64 = serial.line_at()
    serial.puts((&s_b[0]) as u64)
    serial.dec(jv_wait / 100)
    serial.nl()
    serial.line_clear(z_b)
    jv_wait = jv_wait * 2
    if jv_wait > 6000 {
        jv_wait = 6000
    }
}

fn jv_stamp(state: u64, slot: u64) -> u64 {
    if slot == 0 || slot >= kstate.MAX_TASKS {
        return 0
    }
    return sched.tget(state, slot, sched.T_PID)
}

fn sv2_parse(cmd: u64) {
    var w: [u8; 8] = "sokill=\0"
    var i: u64 = 0
    while i < 4096 && kstate.get8(cmd + i) != 0 {
        var k: u64 = 0
        while k < 7 && kstate.get8(cmd + i + k) == (w[k as usize] as u64) {
            k = k + 1
        }
        if k == 7 {
            var v: u64 = 0
            var j: u64 = i + 7
            var n: u64 = 0
            while n < 7 && kstate.get8(cmd + j) >= 48 && kstate.get8(cmd + j) <= 57 {
                v = v * 10 + (kstate.get8(cmd + j) - 48)
                j = j + 1
                n = n + 1
            }
            so_killafter = v
            return
        }
        i = i + 1
    }
}

fn sv2_spawn(state: u64, w: u64) -> u64 {
    if w == 0 {
        var p_so: [u8; 12] = "/bin/social\0"
        var a_so: [u8; 13] = "social\0serve\0"
        return desk_spawn_n(state, (&p_so[0]) as u64, (&a_so[0]) as u64, 13, 2)
    }
    var p_me: [u8; 12] = "/bin/melder\0"
    var a_me: [u8; 13] = "melder\0serve\0"
    return desk_spawn_n(state, (&p_me[0]) as u64, (&a_me[0]) as u64, 13, 2)
}

fn sv2_arm(state: u64, w: u64, slot: u64) {
    sv2_slot[w as usize] = slot
    sv2_tpid[w as usize] = jv_stamp(state, slot)
    sv2_born[w as usize] = kstate.get(state, kstate.TICKS)
    sv2_n[w as usize] = sv2_n[w as usize] + 1
    if sv2_wait[w as usize] == 0 {
        sv2_wait[w as usize] = 500
    }
    sv2_armed[w as usize] = 1
}

fn sv2_say(state: u64, w: u64, tail: u64, v: u64) {
    var s_s: [u8; 13] = "desk: social\0"
    var s_m: [u8; 13] = "desk: melder\0"
    var s_e: [u8; 12] = " ended slot\0"
    var s_r: [u8; 13] = " respawn pid\0"
    let z: u64 = serial.line_at()
    if w == 0 {
        serial.puts((&s_s[0]) as u64)
    } else {
        serial.puts((&s_m[0]) as u64)
    }
    if tail == 0 {
        serial.puts((&s_e[0]) as u64)
    } else {
        serial.puts((&s_r[0]) as u64)
    }
    serial.put(61 as u8)
    serial.dec(v)
    serial.nl()
    serial.line_clear(z)
}

fn sv2_watch_one(state: u64, w: u64) {
    let wi: usize = w as usize
    if sv2_armed[wi] == 0 {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    let sl: u64 = sv2_slot[wi]
    if sl != 0 {
        var dead: bool = false
        if sl >= kstate.MAX_TASKS {
            dead = true
        } else {
            let stt: u64 = sched.tget(state, sl, sched.T_STATE)
            let stamp_now: u64 = sched.tget(state, sl, sched.T_PID)
            if w == 0 && so_killafter != 0 && stt != sched.S_ZOMBIE && stt != sched.S_FREE
                && stamp_now == sv2_tpid[wi] && now - sv2_born[wi] >= so_killafter {
                let _k: u64 = sched.kill_other(state, sl, sv2_tpid[wi], 9)
                sv2_born[wi] = now
                return
            }
            if stt != sched.S_FREE && stamp_now != sv2_tpid[wi] {
                dead = true
            } else if stt == sched.S_ZOMBIE {
                let _r: bool = proc.reap(state, sl)
                dead = true
            } else if stt == sched.S_FREE {
                dead = true
            }
        }
        if !dead {
            return
        }
        sv2_say(state, w, 0, sl)
        if now - sv2_born[wi] >= 12000 {
            sv2_wait[wi] = 500
        }
        sv2_slot[wi] = 0
        sv2_next[wi] = now + sv2_wait[wi]
        sv2_wait[wi] = sv2_wait[wi] * 2
        if sv2_wait[wi] > 6000 {
            sv2_wait[wi] = 6000
        }
        return
    }
    if now < sv2_next[wi] {
        return
    }
    let slot: u64 = sv2_spawn(state, w)
    if slot == 0 {
        sv2_next[wi] = now + sv2_wait[wi]
        sv2_wait[wi] = sv2_wait[wi] * 2
        if sv2_wait[wi] > 6000 {
            sv2_wait[wi] = 6000
        }
        return
    }
    sv2_arm(state, w, slot)
    sv2_say(state, w, 1, sv2_tpid[wi])
}

fn sv2_watch(state: u64) {
    sv2_watch_one(state, 0)
    sv2_watch_one(state, 1)
}

fn shell_respawn(state: u64, w: u64) -> u64 {
    var p_task: [u8; 13] = "/bin/taskbar\0"
    var a_task: [u8; 8] = "taskbar\0"
    var p_star: [u8; 14] = "/bin/launcher\0"
    var a_star: [u8; 18] = "starter\0versteckt\0"
    var a_vis: [u8; 8] = "starter\0"
    var p_dh: [u8; 10] = "/bin/dhcp\0"
    var a_dh: [u8; 11] = "dhcp\0dauer\0"
    if w == shellsup.W_DHCP {
        return desk_spawn_svc(state, 2, (&p_dh[0]) as u64, (&a_dh[0]) as u64, 11, 2)
    }
    if w == shellsup.W_TASKBAR {
        return desk_spawn(state, (&p_task[0]) as u64, (&a_task[0]) as u64, 8)
    }
    if kstate.mode_on(state, kstate.M_LAUNCHERVIS) {
        return desk_spawn_n(state, (&p_star[0]) as u64, (&a_vis[0]) as u64, 8, 1)
    }
    return desk_spawn_n(state, (&p_star[0]) as u64, (&a_star[0]) as u64, 18, 2)
}

fn shell_watch_one(state: u64, w: u64) {
    if shellsup.watch(state, w) == 0 {
        return
    }
    let slot: u64 = shell_respawn(state, w)
    if slot == 0 {
        shellsup.spawn_failed(state, w)
        return
    }
    shellsup.arm(state, w, slot)
}

fn shell_watch(state: u64) {
    shell_watch_one(state, shellsup.W_TASKBAR)
    shell_watch_one(state, shellsup.W_LAUNCHER)
    shell_watch_one(state, shellsup.W_DHCP)
}

fn jarvis_watch(state: u64) {
    if jv_armed == 0 {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if jv_pid != 0 {
        var sl: u64 = jv_pid
        if jv_noname != 0 {

            sl = sched.find_pid(state, jv_pid)
        }
        var dead: bool = false
        if sl >= kstate.MAX_TASKS {
            dead = true
        } else {
            let stt: u64 = sched.tget(state, sl, sched.T_STATE)
            let stamp_now: u64 = sched.tget(state, sl, sched.T_PID)
            if jv_killafter != 0 && stt != sched.S_ZOMBIE && now - jv_born >= jv_killafter {
                var s_k: [u8; 21] = "desk: jarvisd killed\0"
                serial.puts((&s_k[0]) as u64)
                serial.nl()
                let _k: u64 = sched.kill_other(state, sl, jv_tpid, 9)
                jv_born = now
                return
            }
            if jv_noname == 0 && stt != sched.S_FREE && stamp_now != jv_tpid {

                dead = true
            } else if stt == sched.S_ZOMBIE {
                let _r: bool = proc.reap(state, sl)
                dead = true
            } else if stt == sched.S_FREE {

                dead = true
            }
        }
        if !dead {
            return
        }
        var s_e: [u8; 25] = "desk: jarvisd ended pid=\0"
        let z_e: u64 = serial.line_at()
        serial.puts((&s_e[0]) as u64)
        serial.dec(jv_pid)
        serial.nl()
        serial.line_clear(z_e)
        if now - jv_born >= 12000 {
            jv_wait = 500
        }
        jv_pid = 0
        jv_backoff(state, now)
        return
    }
    if now < jv_next {
        return
    }
    var p_jv: [u8; 13] = "/bin/jarvisd\0"
    var a_jv: [u8; 8] = "jarvisd\0"
    let pid: u64 = desk_spawn_svc(state, 3, (&p_jv[0]) as u64,
        (&a_jv[0]) as u64, 8, 1)
    if pid == 0 {
        jv_backoff(state, now)
        return
    }
    jv_pid = pid
    jv_tpid = jv_stamp(state, pid)
    jv_born = now
}

fn lj_wait(state: u64) -> bool {
    if !wmlatency.lj_fast(state) {
        return false
    }
    let kh: u64 = time.khz(state)
    if kh < 1000 {
        return false
    }
    let end: u64 = time.tsc() + (kh / 1000) * 1000
    while time.tsc() < end {
        sched.yield_now(state)
    }
    return true
}

fn quiet_seq(state: u64) -> u64 {
    return usb.reports(state) + xhci.events(state) + ps2m.packets(state) + usb.hid_keys(state)
        + kstate.get(state, kstate.KEYLEN) + kstate.get(state, kstate.K11_OFF + kstate.KB_HHEAD)
}

fn quiet_wake(state: u64, seq: u64) -> bool {
    if wm.input_hot(state) {
        return true
    }
    if quiet_seq(state) != seq {
        return true
    }

    return false
}

fn quiet_more(state: u64, goal: u64, seq: u64) {
    var n: u64 = 0
    while n < 8 && kstate.get(state, kstate.TICKS) < goal {
        if quiet_wake(state, seq) {
            return
        }
        sched.idle_wait(state)
        n = n + 1
    }
}

const QUIET_PULSE_EXTRA: u64 = 2500

fn ser_defer_on(state: u64) {
    if !fb.phases_an(state) {
        serial.defer_on()
    }
}

fn ser_defer_off(state: u64) {
    if !fb.phases_an(state) {
        serial.defer_off()
    }
}

fn pulse_extra() -> u64 {
    if kgbase.board_quiet != 0 {
        return QUIET_PULSE_EXTRA
    }
    return 0
}

fn tz_text(state: u64, buf: u64, at: u64, t: u64) -> u64 {
    return pulse_text(state, buf, at, t)
}

fn pulse_text(state: u64, buf: u64, at: u64, t: u64) -> u64 {
    var n: u64 = at
    var i: u64 = 0
    while kstate.get8(t + i) != 0 && n < 190 {
        kstate.set8(buf + n, kstate.get8(t + i) as u8)
        n = n + 1
        i = i + 1
    }
    return n
}

fn pulse_two(state: u64, buf: u64, at: u64, v: u64) -> u64 {
    var n: u64 = at
    let w: u64 = v % 100
    kstate.set8(buf + n, (48 + w / 10) as u8)
    kstate.set8(buf + n + 1, (48 + w % 10) as u8)
    return n + 2
}

fn pulse_hexn(state: u64, buf: u64, at: u64, v: u64, digits: u64) -> u64 {
    var ziffern: [u8; 17] = "0123456789ABCDEF\0"
    var i: u64 = digits
    var n: u64 = at
    while i > 0 {
        i = i - 1
        kstate.set8(buf + n, ziffern[((v >> (i * 4)) & 15) as usize])
        n = n + 1
    }
    return n
}

fn pulse_hex(state: u64, buf: u64, at: u64, v: u64) -> u64 {
    var ziffern: [u8; 17] = "0123456789ABCDEF\0"
    var n: u64 = at
    if v > 255 {
        kstate.set8(buf + n, 45 as u8)
        kstate.set8(buf + n + 1, 45 as u8)
        return n + 2
    }
    kstate.set8(buf + n, ziffern[((v >> 4) & 15) as usize])
    kstate.set8(buf + n + 1, ziffern[(v & 15) as usize])
    return n + 2
}

fn pulse_num(state: u64, buf: u64, at: u64, v: u64) -> u64 {
    var ziffern: [u8; 24] = [0 as u8; 24]
    var k: u64 = 0
    var w: u64 = v
    if w == 0 {
        ziffern[0] = 0x30
        k = 1
    }
    while w != 0 && k < 20 {
        ziffern[k as usize] = (0x30 + (w % 10)) as u8
        w = w / 10
        k = k + 1
    }
    var n: u64 = at
    while k > 0 && n < 190 {
        k = k - 1
        kstate.set8(buf + n, ziffern[k as usize])
        n = n + 1
    }
    return n
}
