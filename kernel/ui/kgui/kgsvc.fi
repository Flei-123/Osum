const I18N_LINES: u64 = 1000

fn halt_secs(state: u64) -> u64 {
    let h: u64 = pmon.wighalt(state)
    if h != 0 {
        return h
    }
    if kstate.mode_on(state, kstate.M_WIGLONG) {
        return 20
    }
    return 5
}

static mut wg_path: [u8; 64] = [0 as u8; 64]

static mut wg_args: [u8; 128] = [0 as u8; 128]

static mut wg_len: u64 = 0

static mut wg_argc: u64 = 0

static mut wg_da: u64 = 0

fn wigapp_zerlegen(state: u64) {
    wg_da = 0
    wg_len = 0
    wg_argc = 0
    let wa: u64 = pmon.wigapp(state)
    if wa == 0 {
        return
    }
    var slash: u64 = 0
    var kommas: u64 = 0
    var wargs: u64 = 0
    var wi: u64 = 0
    while wi < 63 && kstate.get8(wa + wi) != 0 {
        var c: u64 = kstate.get8(wa + wi)
        if c == 44 {
            c = 0
            kommas = kommas + 1
            if wargs == 0 {
                wargs = wi + 1
            }
        }
        wg_path[wi as usize] = c as u8
        if c == 47 && wargs == 0 {
            slash = wi + 1
        }
        wi = wi + 1
    }
    var wj: u64 = 0
    while wj < 31 && wg_path[(slash + wj) as usize] != 0 as u8 {
        wg_args[wj as usize] = wg_path[(slash + wj) as usize]
        wj = wj + 1
    }
    if wj == 0 {
        return
    }
    wg_args[wj as usize] = 0 as u8
    wg_len = wj + 1
    wg_argc = 1
    wg_da = 1
    if wargs == 0 {
        return
    }
    var wp: u64 = wargs
    while wp < 63 && wg_path[wp as usize] != 0 as u8 && wg_len < 120 {
        var wl: u64 = 0
        while wp + wl < 63 && wg_path[(wp + wl) as usize] != 0 as u8
              && wg_len < 120 {
            wg_args[wg_len as usize] = wg_path[(wp + wl) as usize]
            wg_len = wg_len + 1
            wl = wl + 1
        }
        wg_args[wg_len as usize] = 0 as u8
        wg_len = wg_len + 1
        wg_argc = wg_argc + 1
        wp = wp + wl + 1
    }
}

static mut log_open: u64 = 0

static mut svc_open: [u64; 4] = [0; 4]

static mut svc_max: u64 = 65536

static mut svc_next: u64 = 0

static mut jv_pid: u64 = 0

static mut jv_tpid: u64 = 0

static mut jv_born: u64 = 0

static mut jv_next: u64 = 0

static mut sv2_slot: [u64; 2] = [0 as u64; 2]

static mut sv2_tpid: [u64; 2] = [0 as u64; 2]

static mut sv2_born: [u64; 2] = [0 as u64; 2]

static mut sv2_next: [u64; 2] = [0 as u64; 2]

static mut sv2_wait: [u64; 2] = [0 as u64; 2]

static mut sv2_armed: [u64; 2] = [0 as u64; 2]

static mut sv2_n: [u64; 2] = [0 as u64; 2]

static mut so_killafter: u64 = 0

static mut jv_wait: u64 = 500

static mut jv_armed: u64 = 0

static mut jv_noname: u64 = 0

static mut jv_killafter: u64 = 0

static mut svc_mode: u64 = 0

fn log_open_get(state: u64, svc: bool, sid: u64) -> u64 {
    if svc {
        if svc_open[sid as usize] == 0 {
            let t: u64 = tty.alloc_log_svc(state, sid)
            if t >= tty.MAX_TTY {
                return 0
            }
            let of: u64 = file.open_alloc(state, file.K_TTY, t, 1)
            if of >= file.MAX_OPEN {
                return 0
            }
            svc_open[sid as usize] = of
            var s_p: [u8; 18] = "desk: svclog tty=\0"
            var s_o: [u8; 5] = " of=\0"
            serial.puts((&s_p[0]) as u64)
            serial.dec(t)
            serial.puts((&s_o[0]) as u64)
            serial.dec(of)
            serial.nl()
        }
        return svc_open[sid as usize]
    }
    if log_open == 0 {
        let t: u64 = tty.alloc_log(state)
        if t >= tty.MAX_TTY {
            return 0
        }

        let of: u64 = file.open_alloc(state, file.K_TTY, t, 1)
        if of >= file.MAX_OPEN {
            return 0
        }
        log_open = of
        kstate.set(state, kstate.LOGOPEN, of)
        var s_p: [u8; 21] = "desk: protokoll tty=\0"
        var s_o: [u8; 5] = " of=\0"
        serial.puts((&s_p[0]) as u64)
        serial.dec(t)
        serial.puts((&s_o[0]) as u64)
        serial.dec(of)
        serial.nl()
    }
    return log_open
}

fn protokoll_binden(state: u64, task: u64) {
    if task == 0 {
        return
    }
    let svc: bool = svc_mode != 0 && !kstate.mode_on(state, kstate.M_SVCCON)
    var sid: u64 = 0
    if svc {
        sid = svc_mode - 1
    }
    let lo: u64 = log_open_get(state, svc, sid)
    if lo == 0 {
        return
    }

    let fl: u64 = sched.irq_save()
    var fd: u64 = 1
    while fd < 3 {
        file.open_ref(state, lo)
        file.fd_free(state, task, fd)
        if !file.fd_set(state, task, fd, lo) {
            file.open_unref(state, lo)
        }
        fd = fd + 1
    }
    sched.irq_restore(fl)
}

fn desk_spawn_svc(state: u64, sid: u64, path: u64, arg: u64, n: u64, argc: u64) -> u64 {
    svc_mode = sid + 1
    let pid: u64 = desk_spawn_n(state, path, arg, n, argc)
    svc_mode = 0
    return pid
}

fn svc_parse(cmd: u64) {
    var wn: [u8; 9] = "jvnoname\0"
    var in0: u64 = 0
    while in0 < 4096 && kstate.get8(cmd + in0) != 0 {
        var kn: u64 = 0
        while kn < 8 && kstate.get8(cmd + in0 + kn) == (wn[kn as usize] as u64) {
            kn = kn + 1
        }
        if kn == 8 {
            jv_noname = 1
        }
        in0 = in0 + 1
    }
    var w: [u8; 11] = "svclogmax=\0"
    var i: u64 = 0
    while i < 4096 && kstate.get8(cmd + i) != 0 {
        var k: u64 = 0
        while k < 10 && kstate.get8(cmd + i + k) == (w[k as usize] as u64) {
            k = k + 1
        }
        if k == 10 {
            var v: u64 = 0
            var j: u64 = i + 10
            var n: u64 = 0
            while n < 9 && kstate.get8(cmd + j) >= 48 && kstate.get8(cmd + j) <= 57 {
                v = v * 10 + (kstate.get8(cmd + j) - 48)
                j = j + 1
                n = n + 1
            }
            svc_max = v
            return
        }
        i = i + 1
    }
}

fn svc_name(sid: u64, old: bool, dst: u64) {
    var a: [u8; 18] = "/var/log/ota.log\0\0"
    var b: [u8; 18] = "/var/log/sntp.log\0"
    var c: [u8; 18] = "/var/log/dhcp.log\0"
    var i: u64 = 0
    var done: bool = false
    while i < 18 && !done {
        var ch: u64 = a[i as usize] as u64
        if sid == 1 {
            ch = b[i as usize] as u64
        }
        if sid == 2 {
            ch = c[i as usize] as u64
        }
        if ch == 0 {
            done = true
        } else {
            kstate.set8(dst + i, ch as u8)
            i = i + 1
        }
    }
    if old {
        kstate.set8(dst + i, 46)
        kstate.set8(dst + i + 1, 49)
        i = i + 2
    }
    kstate.set8(dst + i, 0)
}

fn svc_append(state: u64, sid: u64, src: u64, n: u64) {
    var p: [u8; 24] = [0; 24]
    var q: [u8; 24] = [0; 24]
    svc_name(sid, false, (&p[0]) as u64)
    svc_name(sid, true, (&q[0]) as u64)
    var ino: u64 = fs.path(state, (&p[0]) as u64)
    if ino == 0 {
        var d1: [u8; 5] = "/var\0"
        var d2: [u8; 9] = "/var/log\0"
        if fs.path(state, (&d1[0]) as u64) == 0 {
            let _a: u64 = fs.create_path(state, (&d1[0]) as u64, fs.T_DIR)
        }
        if fs.path(state, (&d2[0]) as u64) == 0 {
            let _b: u64 = fs.create_path(state, (&d2[0]) as u64, fs.T_DIR)
        }
        ino = fs.create_path(state, (&p[0]) as u64, fs.T_FILE)
        if ino == 0 {
            return
        }
    }
    var size: u64 = fs.inode_size(state, ino)
    if size + n > svc_max {
        let _u: bool = fs.unlink_path(state, (&q[0]) as u64)
        let _r: u64 = fs.rename_path(state, (&p[0]) as u64, (&q[0]) as u64)
        ino = fs.create_path(state, (&p[0]) as u64, fs.T_FILE)
        if ino == 0 {
            return
        }
        size = 0
    }
    let _w: u64 = fs.write_at(state, ino, size, src, n)
}

fn svc_flush(state: u64) {
    if svc_max == 0 || kstate.get(state, kstate.FS_READY) == 0 {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if now < svc_next {
        return
    }
    svc_next = now + 100
    var buf: [u8; 256] = [0; 256]
    var lim: u64 = 256
    if svc_max < lim {
        lim = svc_max
    }
    var sid: u64 = 0
    while sid < 3 {
        var rounds: u64 = 0
        var n: u64 = 1
        while n != 0 && rounds < 16 {
            n = tty.svc_take(sid, (&buf[0]) as u64, lim)
            if n != 0 {
                svc_append(state, sid, (&buf[0]) as u64, n)
            }
            rounds = rounds + 1
        }
        sid = sid + 1
    }
}

static mut mausflut_hz: u64 = 0

static mut mauslauf_start: u64 = 0

static mut mouseflood_mark: u64 = 0

static mut mouseflood_left: u64 = 0

static mut mausflut_n: u64 = 0

static mut mausflut_klicks: u64 = 0

fn parse(state: u64, cmd: u64) {
    if cmd == 0 {
        return
    }
    svc_parse(cmd)
    sv2_parse(cmd)
    shellsup.parse(cmd)
    stall.parse(cmd)
    frameprof.parse(cmd)
    pixelguard.parse(state)
    sysmon.parse(cmd)
    var w: [u8; 10] = "mausflut=\0"
    var i: u64 = 0
    while i < 4096 && kstate.get8(cmd + i) != 0 {
        var k: u64 = 0
        while k < 9 && kstate.get8(cmd + i + k) == (w[k as usize] as u64) {
            k = k + 1
        }
        if k == 9 {
            var v: u64 = 0
            var j: u64 = i + 9
            var n: u64 = 0
            while n < 6 && kstate.get8(cmd + j) >= 48
                && kstate.get8(cmd + j) <= 57 {
                v = v * 10 + (kstate.get8(cmd + j) - 48)
                j = j + 1
                n = n + 1
            }
            mausflut_hz = v
            return
        }
        i = i + 1
    }
    var w2: [u8; 10] = "mauslauf=\0"
    var i2: u64 = 0
    while i2 < 4096 && kstate.get8(cmd + i2) != 0 {
        var k2: u64 = 0
        while k2 < 9 && kstate.get8(cmd + i2 + k2) == (w2[k2 as usize] as u64) {
            k2 = k2 + 1
        }
        if k2 == 9 {
            var v2: u64 = 0
            var j2: u64 = i2 + 9
            var n2: u64 = 0
            while n2 < 7 && kstate.get8(cmd + j2) >= 48
                && kstate.get8(cmd + j2) <= 57 {
                v2 = v2 * 10 + (kstate.get8(cmd + j2) - 48)
                j2 = j2 + 1
                n2 = n2 + 1
            }
            kgbase.mauslauf_soll = v2
            return
        }
        i2 = i2 + 1
    }

    var w3: [u8; 8] = "jvkill=\0"
    var i3: u64 = 0
    while i3 < 4096 && kstate.get8(cmd + i3) != 0 {
        var k3: u64 = 0
        while k3 < 7 && kstate.get8(cmd + i3 + k3) == (w3[k3 as usize] as u64) {
            k3 = k3 + 1
        }
        if k3 == 7 {
            var v3: u64 = 0
            var j3: u64 = i3 + 7
            var n3: u64 = 0
            while n3 < 7 && kstate.get8(cmd + j3) >= 48
                && kstate.get8(cmd + j3) <= 57 {
                v3 = v3 * 10 + (kstate.get8(cmd + j3) - 48)
                j3 = j3 + 1
                n3 = n3 + 1
            }
            jv_killafter = v3
            return
        }
        i3 = i3 + 1
    }
}

fn mouserun_open() -> bool {
    return kgbase.mauslauf_soll != 0 && kgbase.mauslauf_ist < kgbase.mauslauf_soll
}

fn mouserun_count() -> u64 {
    return kgbase.mauslauf_ist
}

fn mouserun_duration() -> u64 {
    return kgbase.mauslauf_us
}

fn mauslauf_schritt(state: u64) {
    if kgbase.mauslauf_soll == 0 || !wmbase.ready(state) {
        return
    }
    if kgbase.mauslauf_ist >= kgbase.mauslauf_soll {
        return
    }
    if kgbase.mauslauf_ist == 0 {
        ps2m.adopt(state, fb.width(state), fb.height(state))
        ps2m.set_pos(state, fb.width(state) / 2, fb.height(state) * 2 / 3)
        mauslauf_start = time.mono_ns(state)
    }
    var b0: u64 = 8
    var dx: u64 = 3
    if mouseflood_left != 0 {
        dx = 253
        b0 = b0 | 0x10
    }
    var dy: u64 = 0
    if (kgbase.mauslauf_ist % 14) == 0 {
        dy = 1
    }
    if (kgbase.mauslauf_ist % 14) == 7 {
        dy = 255
        b0 = b0 | 0x20
    }
    ps2m.usb_packet(state, b0, dx, dy, 0, false)
    if ps2m.changed(state) {
        let _c: bool = ps2m.take_change(state)
        wminput.on_mouse(state)
    }
    let x: u64 = ps2m.x(state)
    if x + 16 >= fb.width(state) {
        mouseflood_left = 1
    }
    if x <= 16 {
        mouseflood_left = 0
    }
    kgbase.mauslauf_ist = kgbase.mauslauf_ist + 1
    kgbase.mauslauf_us = (time.mono_ns(state) - mauslauf_start) / 1000
}

fn mausflut_klickzahl() -> u64 {
    return mausflut_klicks
}

fn mausflut_schritt(state: u64) {
    if mausflut_hz == 0 || !wmbase.ready(state) {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if mouseflood_mark == 0 {
        ps2m.adopt(state, fb.width(state), fb.height(state))
        ps2m.set_pos(state, fb.width(state) / 2, fb.height(state) * 2 / 3)
        mouseflood_mark = now
        return
    }
    if now <= mouseflood_mark {
        return
    }
    var marken: u64 = now - mouseflood_mark
    if marken > 10 {
        marken = 10
    }
    mouseflood_mark = now
    var k: u64 = marken * mausflut_hz / 100
    while k > 0 {
        var b0: u64 = 8
        var dx: u64 = 3
        if mouseflood_left != 0 {
            dx = 253
            b0 = b0 | 0x10
        }
        var dy: u64 = 0
        if (mausflut_n % 14) == 0 {
            dy = 1
        }
        if (mausflut_n % 14) == 7 {
            dy = 255
            b0 = b0 | 0x20
        }
        if (mausflut_n % 250) == 0 {
            b0 = b0 | ps2m.B_LEFT
            mausflut_klicks = mausflut_klicks + 1
        }
        ps2m.usb_packet(state, b0, dx, dy, 0, false)
        if ps2m.changed(state) {
            let _c: bool = ps2m.take_change(state)
            wminput.on_mouse(state)
        }
        let x: u64 = ps2m.x(state)
        if x + 16 >= fb.width(state) {
            mouseflood_left = 1
        }
        if x <= 16 {
            mouseflood_left = 0
        }
        mausflut_n = mausflut_n + 1
        k = k - 1
    }
}

fn desk_spawn(state: u64, path: u64, arg: u64, n: u64) -> u64 {
    return desk_spawn_n(state, path, arg, n, 1)
}

fn desk_spawn_n(state: u64, path: u64, arg: u64, n: u64,
    argc: u64) -> u64 {

    let eflags: u64 = sched.irq_save()
    let abuf: u64 = cpu.earg_buf(state)
    var k: u64 = 0
    while k < n {
        kstate.set8(abuf + k, kstate.get8(arg + k) as u8)
        k = k + 1
    }
    let pid: u64 = elf.spawn(state, path, abuf, argc, 2)
    sched.irq_restore(eflags)
    if pid != 0 {
        if pid < kstate.MAX_TASKS {
            sched.tset(state, pid, sched.T_OOMSAFE, 1)
        }
    }
    protokoll_binden(state, pid)
    let z: u64 = serial.line_at()
    var s_st: [u8; 13] = "desk: start \0"
    var s_pid: [u8; 7] = "  pid=\0"
    var s_cpu: [u8; 8] = "  kern=\0"
    serial.puts((&s_st[0]) as u64)
    serial.puts(path)
    serial.puts((&s_pid[0]) as u64)
    serial.dec(pid)
    serial.puts((&s_cpu[0]) as u64)
    serial.dec(sched.hier(state))
    serial.nl()
    serial.line_clear(z)
    if pid == 0 {
        elf.say_reason(kstate.get(state, kstate.ELF_ERR))
    }
    return pid
}

fn i18n_bench(state: u64, f: u64, px: u64) {
    var s_a: [u8; 21] = "i18n: draw ascii us=\0"
    var s_u: [u8; 20] = "i18n: draw utf8 us=\0"
    var s_g: [u8; 22] = "i18n: draw glyphs us=\0"
    var s_r: [u8; 8] = " reps=\0\0"
    var s_n: [u8; 8] = " chars=\0"
    var line: [u8; 40] = "The display mode is set at boot; at run\0"
    if f >= ttf.MAX_FONTS || apic.tsc_hz(state) == 0 {
        return
    }
    let p: u64 = (&line[0]) as u64
    let _w0: i64 = ttf.text_width26(state, f, p, 40, px)
    var t: u64 = apic.tsc()
    var i: u64 = 0
    var acc: i64 = 0
    while i < I18N_LINES {
        acc = acc + ttf.text_width26_bytes(state, f, p, 40, px)
        i = i + 1
    }
    let alt: u64 = kgdisp.us_of(state, apic.tsc() - t)
    t = apic.tsc()
    i = 0
    while i < I18N_LINES {
        acc = acc + ttf.text_width26(state, f, p, 40, px)
        i = i + 1
    }
    let fresh: u64 = kgdisp.us_of(state, apic.tsc() - t)
    t = apic.tsc()
    i = 0
    while i < I18N_LINES {
        var k: u64 = 0
        while k < 40 {
            let _sl: u64 = ttf.glyph(state, f, kstate.get8(p + k), px)
            k = k + 1
        }
        i = i + 1
    }
    let zeichnen: u64 = kgdisp.us_of(state, apic.tsc() - t)
    serial.puts((&s_a[0]) as u64)
    serial.dec(alt)
    serial.puts((&s_r[0]) as u64)
    serial.dec(I18N_LINES)
    serial.puts((&s_n[0]) as u64)
    serial.dec(40)
    serial.nl()
    serial.puts((&s_u[0]) as u64)
    serial.dec(fresh)
    serial.puts((&s_r[0]) as u64)
    serial.dec(I18N_LINES)
    serial.puts((&s_n[0]) as u64)
    serial.dec(40)
    serial.nl()
    serial.puts((&s_g[0]) as u64)
    serial.dec(zeichnen)
    serial.puts((&s_r[0]) as u64)
    serial.dec(I18N_LINES)
    serial.nl()
    if acc == 0 {
        serial.nl()
    }
}

fn tastatur_zur_sprache(state: u64, en: bool) {
    var lay: u64 = kbd.L_DE
    if en {
        lay = kbd.L_US
    }
    var s_kb: [u8; 18] = "kbd: layout de␀␀␀\0"
    if en {
        s_kb[12 as usize] = 101 as u8
        s_kb[13 as usize] = 110 as u8
    }
    if kbd.set_layout(state, lay) {
        serial.puts((&s_kb[0]) as u64)
        serial.nl()
    }
}

fn locale_set(state: u64) {
    let en: bool = kstate.mode_on(state, kstate.M_LANGEN)
    let de: bool = kstate.mode_on(state, kstate.M_LANGDE)
    tastatur_zur_sprache(state, en)
    if !en && !de {
        return
    }
    var cur_path: [u8; 26] = "/users/root/config/locale\0"
    var t_en: [u8; 4] = "en\n\0"
    var t_de: [u8; 4] = "de\n\0"
    var s_ok: [u8; 16] = "locale: gesetzt\0"
    var s_sp: [u8; 2] = " \0"
    var s_rc: [u8; 5] = " rc=\0"
    let ino: u64 = fs.path(state, (&cur_path[0]) as u64)
    if ino == 0 {
        var s_no: [u8; 27] = "locale: no file for it\0\0\0\0\0"
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    fs.file_truncate(state, ino)
    var q: u64 = (&t_de[0]) as u64
    if en {
        q = (&t_en[0]) as u64
    }
    let n: u64 = fs.write_at(state, ino, 0, q, 3)
    serial.puts((&s_ok[0]) as u64)
    serial.puts((&s_sp[0]) as u64)
    serial.text(q, 2)
    serial.puts((&s_rc[0]) as u64)
    serial.dec(n)
    serial.nl()
}

fn desk_start(state: u64) -> u64 {
    locale_set(state)
    var p_desk: [u8; 13] = "/bin/desktop\0"
    var p_task: [u8; 13] = "/bin/taskbar\0"
    var p_star: [u8; 14] = "/bin/launcher\0"
    var p_set: [u8; 14] = "/bin/settings\0"
    var p_dhcp: [u8; 10] = "/bin/dhcp\0"
    var p_jv: [u8; 13] = "/bin/jarvisd\0"
    var a_desk: [u8; 8] = "desktop\0"
    var a_task: [u8; 8] = "taskbar\0"
    var a_star: [u8; 18] = "starter\0versteckt\0"
    var a_set: [u8; 9] = "settings\0"
    var a_dhcp: [u8; 11] = "dhcp\0dauer\0"
    var a_jv: [u8; 8] = "jarvisd\0"

    var p_glog: [u8; 13] = "/bin/glogin\0\0"
    var a_glog: [u8; 8] = "glogin\0\0"
    var s_anm: [u8; 33] = "desk: sign-in before desktop\0\0\0\0\0"
    var s_root: [u8; 35] = "desk: WITHOUT sign-in -- uid stays\0"
    var do_login: bool = kstate.mode_on(state, kstate.M_LOGIN)
        && !kstate.mode_on(state, kstate.M_NOANMELDUNG)
    var pid: u64 = 0

    var p_bus: [u8; 15] = "/bin/orientbus\0"
    var a_bus: [u8; 16] = "orientbus\0serve\0"
    var s_bus: [u8; 20] = "desk: orientbus pid\0"
    if fs.path(state, (&p_bus[0]) as u64) != 0 {
        let bp: u64 = desk_spawn_n(state, (&p_bus[0]) as u64,
            (&a_bus[0]) as u64, 16, 2)
        serial.puts((&s_bus[0]) as u64)
        serial.put(61 as u8)
        serial.dec(bp)
        serial.nl()

        var p_sd: [u8; 15] = "/bin/settingsd\0"
        var a_sd: [u8; 16] = "settingsd\0serve\0"
        if fs.path(state, (&p_sd[0]) as u64) != 0 {
            let _sd: u64 = desk_spawn_n(state, (&p_sd[0]) as u64,
                (&a_sd[0]) as u64, 16, 2)
        }

        var p_st: [u8; 13] = "/bin/stored\0\0"
        var a_st: [u8; 13] = "stored\0serve\0"
        if fs.path(state, (&p_st[0]) as u64) != 0 {
            let _st: u64 = desk_spawn_n(state, (&p_st[0]) as u64,
                (&a_st[0]) as u64, 13, 2)
        }
        var p_md: [u8; 12] = "/bin/mediad\0"
        var a_md: [u8; 13] = "mediad\0serve\0"
        if fs.path(state, (&p_md[0]) as u64) != 0 {
            let _md: u64 = desk_spawn_n(state, (&p_md[0]) as u64,
                (&a_md[0]) as u64, 13, 2)
        }

        var p_ax: [u8; 9] = "/bin/axd\0"
        var a_ax: [u8; 10] = "axd\0serve\0"
        if fs.path(state, (&p_ax[0]) as u64) != 0 {
            let _ax: u64 = desk_spawn_n(state, (&p_ax[0]) as u64,
                (&a_ax[0]) as u64, 10, 2)
        }

        var p_so: [u8; 12] = "/bin/social\0"
        var a_so: [u8; 13] = "social\0serve\0"
        if fs.path(state, (&p_so[0]) as u64) != 0 {
            let _so: u64 = desk_spawn_n(state, (&p_so[0]) as u64,
                (&a_so[0]) as u64, 13, 2)
            sv2_arm(state, 0, _so)
            var s_so: [u8; 18] = "desk: social pid\0\0"
            serial.puts((&s_so[0]) as u64)
            serial.put(61 as u8)
            serial.dec(_so)
            serial.nl()
            var p_me: [u8; 12] = "/bin/melder\0"
            var a_me: [u8; 13] = "melder\0serve\0"
            if fs.path(state, (&p_me[0]) as u64) != 0 {
                let _me: u64 = desk_spawn_n(state, (&p_me[0]) as u64,
                    (&a_me[0]) as u64, 13, 2)
                sv2_arm(state, 1, _me)
                var s_me: [u8; 18] = "desk: melder pid\0\0"
                serial.puts((&s_me[0]) as u64)
                serial.put(61 as u8)
                serial.dec(_me)
                serial.nl()
            }
        }
    }

    var p_ota: [u8; 9] = "/bin/ota\0"
    var a_ota: [u8; 9] = "ota\0boot\0"
    if fs.path(state, (&p_ota[0]) as u64) != 0 {
        let _ot: u64 = desk_spawn_svc(state, 0, (&p_ota[0]) as u64,
            (&a_ota[0]) as u64, 9, 2)
    }

    var p_sn: [u8; 10] = "/bin/sntp\0"
    var a_sn: [u8; 10] = "sntp\0boot\0"
    if fs.path(state, (&p_sn[0]) as u64) != 0 {
        let _sn: u64 = desk_spawn_svc(state, 1, (&p_sn[0]) as u64,
            (&a_sn[0]) as u64, 10, 2)
    }

    var p_nc: [u8; 14] = "/bin/netcheck\0"
    var a_nc: [u8; 9] = "netcheck\0"
    if fs.path(state, (&p_nc[0]) as u64) != 0 {
        let _nc: u64 = desk_spawn_n(state, (&p_nc[0]) as u64,
            (&a_nc[0]) as u64, 9, 1)
    }

    var p_ar: [u8; 15] = "/bin/apprights\0"
    var a_ar: [u8; 15] = "apprights\0load\0"
    if fs.path(state, (&p_ar[0]) as u64) != 0 {

        let _ar: u64 = desk_spawn_n(state, (&p_ar[0]) as u64,
            (&a_ar[0]) as u64, 15, 2)
    }

    var p_odb: [u8; 10] = "/bin/odbd\0"
    var a_odb: [u8; 5] = "odbd\0"
    var c_odb: [u8; 14] = "/etc/odb.conf\0"

    if (fs.path(state, (&c_odb[0]) as u64) != 0 || kstate.mode_on(state, kstate.M_ODB)) && fs.path(state, (&p_odb[0]) as u64) != 0 {
        let _od: u64 = desk_spawn(state, (&p_odb[0]) as u64,
            (&a_odb[0]) as u64, 5)
    }
    if do_login {
        serial.puts((&s_anm[0]) as u64)
        serial.nl()
        pid = desk_spawn(state, (&p_glog[0]) as u64,
            (&a_glog[0]) as u64, 8)
    } else {
        serial.puts((&s_root[0]) as u64)
        serial.nl()
        pid = desk_spawn(state, (&p_desk[0]) as u64,
            (&a_desk[0]) as u64, 8)
    }
    var runden: u64 = 0
    while runden < 250 {
        wmkeys.poll(state)
        wmcompose.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    let _l: u64 = desk_spawn(state, (&p_task[0]) as u64,
        (&a_task[0]) as u64, 8)
    shellsup.arm(state, shellsup.W_TASKBAR, _l)
    runden = 0
    while runden < 250 {
        wmkeys.poll(state)
        wmcompose.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    if !kstate.mode_on(state, kstate.M_NOSTART) {
        if kstate.mode_on(state, kstate.M_LAUNCHERVIS) {

            pid = desk_spawn_n(state, (&p_star[0]) as u64,
                (&a_star[0]) as u64, 8, 1)
        } else {
            pid = desk_spawn_n(state, (&p_star[0]) as u64,
                (&a_star[0]) as u64, 18, 2)
        }
        shellsup.arm(state, shellsup.W_LAUNCHER, pid)
    }
    wigapp_zerlegen(state)
    if wg_da != 0 {
        pid = desk_spawn_n(state, (&wg_path[0]) as u64,
            (&wg_args[0]) as u64, wg_len, wg_argc)
    }
    if kstate.mode_on(state, kstate.M_SETTINGS) {
        pid = desk_spawn(state, (&p_set[0]) as u64,
            (&a_set[0]) as u64, 9)
    }
    if kstate.mode_on(state, kstate.M_THEMEGUI)
       || kstate.mode_on(state, kstate.M_THEMESHOT) {
        if kstate.mode_on(state, kstate.M_THEMEGUI) {
            var p_ex: [u8; 14] = "/bin/explorer\0"
            var a_ex: [u8; 9] = "explorer\0"
            let _e: u64 = desk_spawn(state, (&p_ex[0]) as u64,
                (&a_ex[0]) as u64, 9)
        }
        var p_tg: [u8; 15] = "/bin/themetest\0"
        var a_tg: [u8; 14] = "themetest\0gui\0"
        var a_ts: [u8; 15] = "themetest\0shot\0"
        if kstate.mode_on(state, kstate.M_THEMESHOT) {
            pid = desk_spawn_n(state, (&p_tg[0]) as u64,
                (&a_ts[0]) as u64, 15, 2)
        } else {
            pid = desk_spawn_n(state, (&p_tg[0]) as u64,
                (&a_tg[0]) as u64, 14, 2)
        }
    }
    if kstate.mode_on(state, kstate.M_DHCP) {
        let _d: u64 = desk_spawn_svc(state, 2, (&p_dhcp[0]) as u64,
            (&a_dhcp[0]) as u64, 11, 2)
        shellsup.arm(state, shellsup.W_DHCP, _d)
    }
    if kstate.mode_on(state, kstate.M_JARVIS) {
        let _j: u64 = desk_spawn_svc(state, 3, (&p_jv[0]) as u64,
            (&a_jv[0]) as u64, 8, 1)
        jv_pid = _j
        jv_tpid = jv_stamp(state, _j)
        jv_born = kstate.get(state, kstate.TICKS)
        if fs.path(state, (&p_jv[0]) as u64) != 0 {
            jv_armed = 1
            var s_a: [u8; 27] = "desk: jarvisd watch armed=\0"
            serial.puts((&s_a[0]) as u64)
            serial.dec(_j)
            serial.nl()
            if _j == 0 {
                jv_next = jv_born + 500
            }
        }
    }

    if kstate.mode_on(state, kstate.M_NETVDEMO) {
        netv_demo(state)
    }
    runden = 0
    while runden < 500 {
        wmkeys.poll(state)
        wmcompose.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    return pid
}

