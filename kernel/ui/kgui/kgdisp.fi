const DISP_RUNDEN: u64 = 5

const PX_X: u64 = 120

const PX_Y: u64 = 120

const PX_COLOR: u64 = 13132850

const PAINT_RUNDEN: u64 = 4

fn paint_bench(state: u64) {
    var s_h: [u8; 22] = "        paintbench: \0\0"
    var s_x: [u8; 2] = "x\0"
    var s_fi: [u8; 9] = "  fill=\0\0"
    var s_fa: [u8; 11] = "  fill_a=\0\0"
    var s_cy: [u8; 5] = " cyc\0"
    var s_pp: [u8; 12] = "  je-px=\0\0\0\0"
    var s_pa: [u8; 8] = " / \0\0\0\0\0"
    var s_ra: [u8; 12] = "  faktor=\0\0\0"
    var s_pm: [u8; 8] = "/1000\0\0\0"
    var s_bl: [u8; 11] = "  blends=\0\0"
    var s_rd: [u8; 10] = "  reads=\0\0"
    var s_sk: [u8; 10] = "  skips=\0\0"
    var s_db: [u8; 10] = "  dbl=\0\0\0\0"
    var s_sp: [u8; 12] = "  simd_px=\0\0"
    var s_so: [u8; 12] = "  simd_ok=\0\0"
    var s_fe: [u8; 11] = "  fpu_en=\0\0"

    if apic.tsc_hz(state) == 0 {
        return
    }
    let w: u64 = fb.width(state)
    let h: u64 = fb.height(state)
    if w == 0 || h == 0 {
        return
    }
    let color: u64 = fb.rgb(state, 0x20, 0x30, 0x40)
    let overlay: u64 = fb.rgb(state, 0xFF, 0xFF, 0xFF)

    var t: u64 = apic.tsc()
    var i: u64 = 0
    while i < PAINT_RUNDEN {
        fb.fill(state, 0, 0, w, h, color)
        i = i + 1
    }
    let c_fill: u64 = (tscdelta.between(t, apic.tsc())) / PAINT_RUNDEN

    fb.blend_reset(state)
    t = apic.tsc()
    i = 0
    while i < PAINT_RUNDEN {
        fb.fill_a(state, 0, 0, w, h, overlay, 128)
        i = i + 1
    }
    let c_fa: u64 = (tscdelta.between(t, apic.tsc())) / PAINT_RUNDEN

    let px: u64 = w * h
    serial.puts((&s_h[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_fi[0]) as u64)
    serial.dec(c_fill)
    serial.puts((&s_cy[0]) as u64)
    serial.puts((&s_fa[0]) as u64)
    serial.dec(c_fa)
    serial.puts((&s_cy[0]) as u64)
    serial.puts((&s_pp[0]) as u64)
    serial.dec(c_fill * 1000 / px)
    serial.puts((&s_pa[0]) as u64)
    serial.dec(c_fa * 1000 / px)
    serial.puts((&s_pm[0]) as u64)
    serial.puts((&s_ra[0]) as u64)
    if c_fill != 0 {
        serial.dec(c_fa * 1000 / c_fill)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_pm[0]) as u64)
    serial.puts((&s_bl[0]) as u64)
    serial.dec(fb.blends(state))
    serial.puts((&s_rd[0]) as u64)
    serial.dec(fb.blend_reads(state))
    serial.puts((&s_sp[0]) as u64)
    serial.dec(fb.simd_px(state))
    serial.puts((&s_so[0]) as u64)
    serial.dec(numeric.yes(fb.simd_ok(state)))
    serial.puts((&s_fe[0]) as u64)
    serial.dec(numeric.yes(fpu.enabled(state)))
    serial.puts((&s_sk[0]) as u64)
    serial.dec(fb.blend_skips(state))
    serial.puts((&s_db[0]) as u64)
    if fb.double_buffered(state) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()

    var s_st: [u8; 24] = "        paint: selftest\0"
    var s_of: [u8; 5] = " of \0"
    var s_ok: [u8; 12] = "  gezaehlt=\0"
    var s_no: [u8; 6] = "  ok\0\0"
    var s_bad: [u8; 8] = "  WRONG\0"
    let gemischt: u64 = fb.blends(state)
    serial.puts((&s_st[0]) as u64)
    serial.puts((&s_ok[0]) as u64)
    serial.dec(fb.selftest3(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(fb.selftest3_max())
    if gemischt == px * PAINT_RUNDEN {
        serial.puts((&s_no[0]) as u64)
    } else {
        serial.puts((&s_bad[0]) as u64)
    }
    serial.nl()
    fb.blend_reset(state)
    fb.clear(state, 0)
}

fn host_boot_fit(state: u64) {
    var s_bf: [u8; 20] = "vmsvga: bootfit \0\0\0\0"
    var s_hi: [u8; 8] = " hint \0\0"
    var s_ar: [u8; 6] = " -> \0\0"
    var s_rc: [u8; 6] = " rc=\0\0"
    var s_sc: [u8; 9] = " scale=\0\0"
    var s_x: [u8; 2] = "x\0"
    var hv: u64 = 0
    if vmsvga.is_ready(state) && vmode.ready(state) {
        hv = vmsvga.boot_hint(state)
        if hv == 0 && kstate.mode_on(state, kstate.M_VMSVGABOOT) {
            hv = (2400 << 16) | 1400
        }
        if hv == 0 && kstate.mode_on(state, kstate.M_VMSVGAFULL) {
            hv = (1920 << 16) | 1080
        }
    }
    var rc: u64 = 0
    if hv != 0 && ((hv / 65536) != fb.width(state) || (hv % 65536) != fb.height(state)) {

        serial.puts((&s_bf[0]) as u64)
        serial.dec(fb.width(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.height(state))
        serial.puts((&s_hi[0]) as u64)
        serial.dec(hv / 65536)
        serial.puts((&s_x[0]) as u64)
        serial.dec(hv % 65536)
        serial.nl()
        rc = vmode.follow_host(state, hv / 65536, hv % 65536)

        vmsvga.boot_handled(state, hv)
    }

    if fb.uiscale(state) == 1 && fb.res_w(state) == 0
        && kstate.get(state, kstate.UISCALE_WUNSCH) == 0 && vmode.dpi_scale(state, fb.width(state)) == 0 {
        var aw: u64 = fb.width(state)
        var ah: u64 = fb.height(state)
        if hv != 0 {
            aw = hv / 65536
            ah = hv % 65536
        }
        var a: u64 = vmode.auto_scale(aw, ah)
        if a > 1 && fb.width(state) < 1600 {
            a = 1
        }
        if a > 1 {
            let _a: bool = fb.set_uiscale(state, a)
        }
    }
    if hv != 0 {
        serial.puts((&s_bf[0]) as u64)
        serial.puts((&s_ar[0]) as u64)
        serial.dec(fb.width(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.height(state))
        serial.puts((&s_rc[0]) as u64)
        serial.dec(rc)
        serial.puts((&s_sc[0]) as u64)
        serial.dec(fb.uiscale(state))
        serial.nl()
    }
}

fn vmode_stage(state: u64) {
    var s_no: [u8; 22] = "disp: no card\0\0\0\0\0\0\0\0\0"
    var s_hd: [u8; 12] = "disp: vram=\0"
    var s_kib: [u8; 5] = " KiB\0"
    var s_dep: [u8; 10] = "  depths=\0"
    var s_lim: [u8; 12] = "  maplimit=\0"
    var s_pr: [u8; 10] = "  probed=\0"
    var s_rf: [u8; 11] = "  refused=\0"
    var s_tb: [u8; 10] = "  toobig=\0"
    var s_um: [u8; 15] = "  unmappable=\0\0"
    var s_md: [u8; 13] = "disp: modes \0"
    var s_out: [u8; 13] = "disp: out   \0"
    var s_why2: [u8; 10] = "  reason=\0"
    var s_one: [u8; 9] = "disp:   \0"
    var s_x: [u8; 2] = "x\0"
    var s_at: [u8; 3] = "x \0"
    var s_ed: [u8; 12] = "disp: edid \0"
    var s_yes: [u8; 4] = "ok\0\0"
    var s_why: [u8; 5] = "why=\0"
    var s_nat: [u8; 8] = "  nat=\0\0"
    var s_ven: [u8; 8] = "  ven=\0\0"
    var s_mod: [u8; 8] = "  mod=\0\0"
    var s_st: [u8; 16] = "disp: selftest \0"
    var s_of: [u8; 4] = " / \0"
    var s_st2: [u8; 15] = "fb: selftest2 \0"
    var s_room: [u8; 10] = "fb: room \0"
    var s_geo: [u8; 12] = "disp: geom \0"
    var s_gp: [u8; 9] = "  pitch=\0"
    var s_gt: [u8; 9] = "  panel=\0"
    var s_gq: [u8; 10] = "  ppitch=\0"
    var s_gr: [u8; 7] = "  rot=\0"
    var s_gs: [u8; 9] = "  scale=\0"
    var s_gl: [u8; 7] = "  lut=\0"
    var s_gv: [u8; 7] = "  sat=\0"
    var s_gd: [u8; 12] = "  drawback=\0"
    var s_raw: [u8; 12] = "disp: edid \0"

    if !vmode.want(state, vmode.M_DISP) {
        return
    }
    let n: u64 = vmode.probe(state)
    if n == 0 && !vmode.ready(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_hd[0]) as u64)
    serial.dec(vmode.vram(state) / 1024)
    serial.puts((&s_kib[0]) as u64)
    serial.puts((&s_dep[0]) as u64)
    serial.hex(vmode.depths(state))
    serial.puts((&s_lim[0]) as u64)
    serial.dec(vmode.map_limit(state))
    serial.puts((&s_pr[0]) as u64)
    serial.dec(vmode.probed(state))
    serial.puts((&s_rf[0]) as u64)
    serial.dec(vmode.refused(state))
    serial.puts((&s_tb[0]) as u64)
    serial.dec(vmode.toobig(state))
    serial.puts((&s_um[0]) as u64)
    serial.dec(vmode.probed(state) - vmode.refused(state)
        - vmode.toobig(state) - n)
    serial.nl()
    serial.puts((&s_md[0]) as u64)
    serial.dec(n)
    serial.nl()
    var i: u64 = 0
    while i < n {
        serial.puts((&s_one[0]) as u64)
        serial.dec(vmode.mode_w(state, i))
        serial.puts((&s_x[0]) as u64)
        serial.dec(vmode.mode_h(state, i))
        serial.puts((&s_at[0]) as u64)
        serial.dec(vmode.mode_bpp(state, i))
        serial.nl()
        i = i + 1
    }
    i = 0
    while i < vmode.cand_count() {
        let reason: u64 = vmode.cand_why(state, i)
        if reason != 0 {
            serial.puts((&s_out[0]) as u64)
            serial.dec(vmode.cand_w(i))
            serial.puts((&s_x[0]) as u64)
            serial.dec(vmode.cand_h(i))
            serial.puts((&s_why2[0]) as u64)
            serial.dec(reason)
            serial.nl()
        }
        i = i + 1
    }
    serial.puts((&s_ed[0]) as u64)
    if vmode.edid_ok(state) {
        serial.puts((&s_yes[0]) as u64)
        serial.puts((&s_nat[0]) as u64)
        serial.dec(vmode.edid_native_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(vmode.edid_native_h(state))
        serial.puts((&s_ven[0]) as u64)
        i = 0
        while i < 3 {
            serial.put(vmode.vendor_at(state, i) as u8)
            i = i + 1
        }
        serial.puts((&s_mod[0]) as u64)
        i = 0
        while i < 13 {
            let c: u64 = vmode.model_at(state, i)
            if c >= 32 && c < 127 {
                serial.put(c as u8)
            }
            i = i + 1
        }
    } else {
        serial.puts((&s_why[0]) as u64)
        serial.dec(vmode.edid_why(state))
    }
    serial.nl()
    if vmode.want(state, vmode.M_EDID) {
        serial.puts((&s_raw[0]) as u64)
        var s_sp: [u8; 2] = " \0"
        i = 0
        while i < vmode.edid_bytes() {
            serial.hex(vmode.edid_at(state, i))
            serial.puts((&s_sp[0]) as u64)
            i = i + 1
        }
        serial.nl()
    }
    serial.puts((&s_st[0]) as u64)
    serial.dec(vmode.selftest(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(vmode.selftest_max())
    serial.nl()
    var s_ka: [u8; 20] = "disp: tiles all=\0\0\0\0"
    var s_ka2: [u8; 8] = "  frei=\0"
    var s_ka3: [u8; 10] = "  belegt=\0"
    var s_ka4: [u8; 6] = "  fb=\0"
    var s_ka5: [u8; 11] = "  laufmax=\0"
    serial.puts((&s_ka[0]) as u64)
    serial.dec(fb.win_slots())
    serial.puts((&s_ka2[0]) as u64)
    serial.dec(fb.free_slots(state))
    serial.puts((&s_ka3[0]) as u64)
    serial.dec(apic.window_slots(state))
    serial.puts((&s_ka4[0]) as u64)
    serial.dec(fb.slot0(state))
    serial.puts((&s_ka5[0]) as u64)
    serial.dec(fb.longest_run(state))
    serial.nl()

    if kstate.mode_on(state, kstate.M_FASTBOOT) {
        var s_skip: [u8; 31] = "disp: selftests skipped (fast)\0"
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
    } else {
        var s_stc: [u8; 23] = "disp: custom selftest \0"
        serial.puts((&s_stc[0]) as u64)
        serial.dec(vmode.selftest_custom(state))
        serial.puts((&s_of[0]) as u64)
        serial.dec(vmode.selftest_custom_max())
        serial.nl()
        serial.puts((&s_st2[0]) as u64)
        serial.dec(fb.selftest2(state))
        serial.puts((&s_of[0]) as u64)
        serial.dec(fb.selftest2_max())
        serial.nl()
    }
    serial.puts((&s_room[0]) as u64)
    serial.dec(fb.selftest5(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(fb.selftest5_max())
    serial.nl()
    serial.puts((&s_geo[0]) as u64)
    serial.dec(fb.width(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.height(state))
    serial.puts((&s_gp[0]) as u64)
    serial.dec(fb.pitch(state))
    serial.puts((&s_gt[0]) as u64)
    serial.dec(fb.panel_w(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.panel_h(state))
    serial.puts((&s_gq[0]) as u64)
    serial.dec(fb.panel_pitch(state))
    serial.puts((&s_gr[0]) as u64)
    serial.dec(fb.rotation(state))
    serial.puts((&s_gs[0]) as u64)
    serial.dec(fb.scale(state))
    serial.puts((&s_gl[0]) as u64)
    serial.dec(fb.lut(state))
    serial.puts((&s_gv[0]) as u64)
    serial.dec(fb.saturation(state))
    serial.puts((&s_gd[0]) as u64)
    serial.dec(numeric.yes(fb.draw_at(state) == fb.back(state)))
    serial.nl()
}

fn display_hold(state: u64) {
    var s_sw: [u8; 14] = "disp: switch \0"
    var s_x: [u8; 2] = "x\0"
    var s_arr: [u8; 5] = " -> \0"
    var s_rc: [u8; 5] = " rc=\0"
    var s_us: [u8; 5] = " us=\0"
    var s_now: [u8; 8] = " panel=\0"
    var s_cnt: [u8; 12] = "disp: sw=\0\0\0"
    var s_fl: [u8; 9] = "  fail=\0\0"
    var s_rv: [u8; 8] = "  rev=\0\0"
    var s_rot: [u8; 12] = "disp: rot=\0\0"
    var s_img: [u8; 8] = "  img=\0\0"
    var s_cf: [u8; 20] = "disp: confirm pend=\0"
    var s_left: [u8; 8] = " left=\0\0"
    var s_rr: [u8; 9] = " after=\0\0"

    if !vmode.ready(state) {
        return
    }
    if vmode.want(state, vmode.M_BIG) {
        disp_switch(state, 1024, 768, (&s_sw[0]) as u64, (&s_x[0]) as u64,
            (&s_arr[0]) as u64, (&s_rc[0]) as u64, (&s_us[0]) as u64,
            (&s_now[0]) as u64)
    }
    if vmode.want(state, vmode.M_BACK) {
        disp_switch(state, 800, 600, (&s_sw[0]) as u64, (&s_x[0]) as u64,
            (&s_arr[0]) as u64, (&s_rc[0]) as u64, (&s_us[0]) as u64,
            (&s_now[0]) as u64)
    }
    if vmode.want(state, vmode.M_BAD) {
        disp_switch(state, 4096, 4096, (&s_sw[0]) as u64, (&s_x[0]) as u64,
            (&s_arr[0]) as u64, (&s_rc[0]) as u64, (&s_us[0]) as u64,
            (&s_now[0]) as u64)
    }
    if vmode.want(state, vmode.M_CONFIRM) {
        disp_switch(state, 1024, 768, (&s_sw[0]) as u64, (&s_x[0]) as u64,
            (&s_arr[0]) as u64, (&s_rc[0]) as u64, (&s_us[0]) as u64,
            (&s_now[0]) as u64)
        serial.puts((&s_cf[0]) as u64)
        serial.dec(numeric.yes(vmode.pending(state)))
        serial.puts((&s_left[0]) as u64)
        serial.dec(vmode.remaining(state) / 1000)
        serial.nl()
        disp_wait(state, vmode.CONFIRM_MS + 500)
        let ging: bool = vmode.poll(state)
        serial.puts((&s_cf[0]) as u64)
        serial.dec(numeric.yes(vmode.pending(state)))
        serial.puts((&s_rr[0]) as u64)
        serial.dec(numeric.yes(ging))
        serial.puts((&s_now[0]) as u64)
        serial.dec(fb.panel_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.panel_h(state))
        serial.nl()
    }

    if vmode.want(state, vmode.M_OWN) {
        disp_own(state, 1400, 1050, 32)
    }
    if vmode.want(state, vmode.M_EIGENBAD) {
        disp_own(state, 3840, 2160, 32)
        disp_own(state, 1366, 768, 32)
        disp_own(state, 1400, 1050, 16)
    }
    if vmode.want(state, vmode.M_EIGENFRIST) {
        disp_own(state, 1400, 1050, 32)
        serial.puts((&s_cf[0]) as u64)
        serial.dec(numeric.yes(vmode.pending(state)))
        serial.puts((&s_left[0]) as u64)
        serial.dec(vmode.remaining(state) / 1000)
        serial.nl()
        disp_wait(state, vmode.CONFIRM_MS + 1500)
        let ging: bool = vmode.poll(state)
        serial.puts((&s_cf[0]) as u64)
        serial.dec(numeric.yes(vmode.pending(state)))
        serial.puts((&s_rr[0]) as u64)
        serial.dec(numeric.yes(ging))
        serial.puts((&s_now[0]) as u64)
        serial.dec(fb.panel_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.panel_h(state))
        serial.nl()
    }
    if vmode.want(state, vmode.M_BENCH) {
        disp_bench(state)
    }
    if vmode.want(state, vmode.M_ROT) {
        fb.set_rotation(state, 90)
        serial.puts((&s_rot[0]) as u64)
        serial.dec(fb.rotation(state))
        serial.puts((&s_img[0]) as u64)
        serial.dec(fb.width(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.height(state))
        serial.puts((&s_now[0]) as u64)
        serial.dec(fb.panel_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.panel_h(state))
        serial.nl()
    }
    vmode.confirm(state)
    serial.puts((&s_cnt[0]) as u64)
    serial.dec(vmode.switches(state))
    serial.puts((&s_fl[0]) as u64)
    serial.dec(vmode.fails(state))
    serial.puts((&s_rv[0]) as u64)
    serial.dec(vmode.reverts(state))
    serial.nl()
}

fn disp_own(state: u64, w: u64, h: u64, bpp: u64) {
    var s_e: [u8; 12] = "disp: own \0\0"
    var s_x: [u8; 2] = "x\0"
    var s_t: [u8; 3] = "x \0"
    var s_rc: [u8; 5] = " rc=\0"
    var s_wy: [u8; 8] = "  why=\0\0"
    var s_nm: [u8; 8] = "  num=\0\0"
    var s_lim: [u8; 12] = "  maplimit=\0"
    var s_vr: [u8; 9] = "  vram=\0\0"
    var s_now: [u8; 8] = " panel=\0"
    var s_us: [u8; 5] = " us=\0"
    var s_cn: [u8; 11] = "  custom=\0\0"
    let t: u64 = apic.tsc()
    let rc: u64 = vmode.set_custom(state, w, h, bpp)
    let d: u64 = us_of(state, time.since(t))
    serial.puts((&s_e[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_t[0]) as u64)
    serial.dec(bpp)
    serial.puts((&s_rc[0]) as u64)
    serial.dec(rc)
    serial.puts((&s_wy[0]) as u64)
    serial.dec(vmode.cust_why(state))
    serial.puts((&s_nm[0]) as u64)
    serial.dec(vmode.cust_num(state))
    serial.puts((&s_vr[0]) as u64)
    serial.dec(vmode.vram(state))
    serial.puts((&s_lim[0]) as u64)
    serial.dec(vmode.map_limit(state))
    serial.puts((&s_cn[0]) as u64)
    serial.dec(vmode.customs(state))
    serial.puts((&s_now[0]) as u64)
    serial.dec(fb.panel_w(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.panel_h(state))
    serial.puts((&s_us[0]) as u64)
    serial.dec(d)
    serial.nl()
}

fn disp_wait(state: u64, ms: u64) {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return
    }
    let bis: u64 = apic.tsc() + (hz / 1000) * ms
    while apic.tsc() < bis {
    }
}

fn disp_switch(state: u64, w: u64, h: u64, s_sw: u64, s_x: u64, s_arr: u64,
    s_rc: u64, s_us: u64, s_now: u64) {
    let vw: u64 = fb.panel_w(state)
    let vh: u64 = fb.panel_h(state)
    let t: u64 = apic.tsc()
    let rc: u64 = vmode.set_mode(state, w, h, 32)
    let d: u64 = us_of(state, time.since(t))
    serial.puts(s_sw)
    serial.dec(vw)
    serial.puts(s_x)
    serial.dec(vh)
    serial.puts(s_arr)
    serial.dec(w)
    serial.puts(s_x)
    serial.dec(h)
    serial.puts(s_rc)
    serial.dec(rc)
    serial.puts(s_us)
    serial.dec(d)
    serial.puts(s_now)
    serial.dec(fb.panel_w(state))
    serial.puts(s_x)
    serial.dec(fb.panel_h(state))
    serial.nl()
}

fn disp_bench(state: u64) {
    var s_h: [u8; 13] = "disp: bench \0"
    var s_x: [u8; 2] = "x\0"
    var s_fl: [u8; 10] = "  flush=\0\0"
    var s_lu: [u8; 8] = "  lut=\0\0"
    var s_sa: [u8; 8] = "  sat=\0\0"
    var s_ro: [u8; 10] = "  rot90=\0\0"
    var s_ln: [u8; 11] = "  lutline=\0"
    var s_us: [u8; 4] = " us\0"
    var s_px: [u8; 7] = "  px=\0\0"
    var s_want: [u8; 18] = "disp: bench want \0"
    var s_rc: [u8; 5] = " rc=\0"

    let n: u64 = vmode.count(state)
    if n > 0 {
        let brc: u64 = vmode.set_mode(state, vmode.mode_w(state, n - 1),
            vmode.mode_h(state, n - 1), 32)
        vmode.confirm(state)
        serial.puts((&s_want[0]) as u64)
        serial.dec(vmode.mode_w(state, n - 1))
        serial.puts((&s_x[0]) as u64)
        serial.dec(vmode.mode_h(state, n - 1))
        serial.puts((&s_rc[0]) as u64)
        serial.dec(brc)
        serial.nl()
    }
    let w: u64 = fb.panel_w(state)
    let h: u64 = fb.panel_h(state)
    fb.clear(state, fb.rgb(state, 0x30, 0x60, 0x90))

    fb.set_lut(state, 0)
    fb.set_saturation(state, 100)
    fb.set_rotation(state, 0)
    var t: u64 = apic.tsc()
    var i: u64 = 0
    while i < DISP_RUNDEN {
        fb.dirty_all(state)
        fb.flush(state)
        i = i + 1
    }
    let d_fl: u64 = us_of(state, time.since(t)) / DISP_RUNDEN

    fb.set_lut(state, vmode.lut_addr(state))
    t = apic.tsc()
    i = 0
    while i < DISP_RUNDEN {
        fb.dirty_all(state)
        fb.flush(state)
        i = i + 1
    }
    let d_lu: u64 = us_of(state, time.since(t)) / DISP_RUNDEN

    t = apic.tsc()
    i = 0
    while i < DISP_RUNDEN {
        fb.dirty(state, 0, 16)
        fb.flush(state)
        i = i + 1
    }
    let d_ln: u64 = us_of(state, time.since(t)) / DISP_RUNDEN

    fb.set_saturation(state, 150)
    t = apic.tsc()
    i = 0
    while i < DISP_RUNDEN {
        fb.dirty_all(state)
        fb.flush(state)
        i = i + 1
    }
    let d_sa: u64 = us_of(state, time.since(t)) / DISP_RUNDEN
    fb.set_saturation(state, 100)

    fb.set_lut(state, 0)
    var d_ro: u64 = 0
    if fb.set_rotation(state, 90) {
        t = apic.tsc()
        i = 0
        while i < DISP_RUNDEN {
            fb.dirty_all(state)
            fb.flush(state)
            i = i + 1
        }
        d_ro = us_of(state, time.since(t)) / DISP_RUNDEN
        fb.set_rotation(state, 0)
    }

    serial.puts((&s_h[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_px[0]) as u64)
    serial.dec(w * h)
    serial.puts((&s_fl[0]) as u64)
    serial.dec(d_fl)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_lu[0]) as u64)
    serial.dec(d_lu)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_ln[0]) as u64)
    serial.dec(d_ln)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sa[0]) as u64)
    serial.dec(d_sa)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_ro[0]) as u64)
    serial.dec(d_ro)
    serial.puts((&s_us[0]) as u64)
    serial.nl()
}

fn us_of(state: u64, takte: u64) -> u64 {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return 0
    }
    return takte * 1000000 / hz
}

fn durchsatz(state: u64) {
    var s_h: [u8; 20] = "        durchsatz: \0"
    var s_x: [u8; 2] = "x\0"
    var s_px: [u8; 9] = "  bytes=\0"
    var s_us: [u8; 7] = "  us=\0\0"
    var s_mb: [u8; 9] = "  mb_s=\0\0"
    var s_fps: [u8; 8] = "  fps=\0\0"
    var s_pde: [u8; 8] = "  pde=\0\0"
    var s_pat: [u8; 8] = "  pat=\0\0"
    var s_wc: [u8; 7] = "  wc=\0\0"
    var s_uc: [u8; 7] = "  uc=\0\0"
    var s_st: [u8; 12] = "  streifen=\0"
    var s_nb: [u8; 33] = "        durchsatz: no time base\0\0"

    if apic.tsc_hz(state) == 0 {
        serial.puts((&s_nb[0]) as u64)
        serial.nl()
        return
    }
    let w: u64 = fb.width(state)
    let h: u64 = fb.height(state)
    if w == 0 || h == 0 {
        return
    }
    let bytes: u64 = fb.pitch(state) *% h
    let color: u64 = fb.rgb(state, 0x10, 0x20, 0x30)

    let t: u64 = apic.tsc()
    var i: u64 = 0
    while i < kgbase.GFX_RUNDEN {
        fb.clear(state, color)
        i = i + 1
    }
    let us: u64 = us_of(state, tscdelta.between(t, apic.tsc())) / kgbase.GFX_RUNDEN

    serial.puts((&s_h[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_px[0]) as u64)
    serial.dec(bytes)
    serial.puts((&s_us[0]) as u64)
    serial.dec(us)
    serial.puts((&s_mb[0]) as u64)
    if us != 0 {
        serial.dec(bytes / us)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_fps[0]) as u64)
    if us != 0 {
        serial.dec(1000000 / us)
    } else {
        serial.dec(0)
    }
    serial.nl()

    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_pde[0]) as u64)
    serial.hex(fb.pde_roh(state))
    serial.puts((&s_pat[0]) as u64)
    serial.hex(fb.pat_roh(state))
    serial.puts((&s_wc[0]) as u64)
    serial.dec(fb.wc(state))
    serial.puts((&s_uc[0]) as u64)
    serial.dec(numeric.yes(fb.uncached(state)))
    serial.puts((&s_st[0]) as u64)
    serial.dec(numeric.yes(fb.stripe(state)))
    serial.nl()
}

fn perf_rate(state: u64, bytes: u64, cyc: u64, rounds: u64) -> u64 {
    let us: u64 = us_of(state, cyc)
    if us == 0 {
        return 0
    }
    return bytes * rounds / us
}

fn fb_clear_rate(state: u64, bytes: u64, color: u64) -> u64 {
    let t: u64 = apic.tsc()
    var n: u64 = 0
    while n < kgbase.GFX_RUNDEN && us_of(state, tscdelta.between(t, apic.tsc())) < 400000 {
        fb.clear(state, color)
        n = n + 1
    }
    return perf_rate(state, bytes, tscdelta.between(t, apic.tsc()), n)
}

fn fbperf(state: u64, back: u64) {
    var s_h: [u8; 16] = "        fbperf:\0"
    var s_w: [u8; 16] = "  fb_write_mbs=\0"
    var s_c: [u8; 16] = "  fb_copy_mbs=\0\0"
    var s_r: [u8; 17] = "  ram_write_mbs=\0"
    var s_m: [u8; 15] = "  cache_mode=\0\0"
    var s_p: [u8; 11] = "  pat_wc=\0\0"
    var s_t: [u8; 14] = "  mtrr_type=\0\0"
    var s_f0: [u8; 17] = "  fb_write0_mbs=\0"
    var s_ms: [u8; 16] = "  mtrr_wc_st=\0\0\0"
    var s_mr: [u8; 16] = "  mtrr_wc_rs=\0\0\0"
    var s_mc: [u8; 16] = "  mtrr_wc_n=\0\0\0\0"
    var s_md: [u8; 16] = "  mtrr_wc_done=\0"
    var s_n: [u8; 37] = "        fbperf: no time base\0\0\0\0\0\0\0\0\0"
    if apic.tsc_hz(state) == 0 {
        serial.puts((&s_n[0]) as u64)
        serial.nl()
        return
    }
    let w: u64 = fb.width(state)
    let h: u64 = fb.height(state)
    if w == 0 || h == 0 {
        return
    }
    let bytes: u64 = fb.pitch(state) *% h
    let color: u64 = fb.rgb(state, 0x10, 0x20, 0x30)
    fb.mtrr_probe(state)
    var ram: u64 = 0
    var cpy: u64 = 0
    var n: u64 = 0
    var t: u64 = 0
    var i: u64 = 0
    if back != 0 {
        fb.set_back(state, back)
        t = apic.tsc()
        i = 0
        while i < kgbase.GFX_RUNDEN {
            fb.clear(state, color)
            i = i + 1
        }
        ram = perf_rate(state, bytes, tscdelta.between(t, apic.tsc()), kgbase.GFX_RUNDEN)
        t = apic.tsc()
        n = 0
        while n < kgbase.GFX_RUNDEN && us_of(state, tscdelta.between(t, apic.tsc())) < 400000 {
            fb.dirty_all(state)
            fb.flush(state)
            n = n + 1
        }
        cpy = perf_rate(state, bytes, tscdelta.between(t, apic.tsc()), n)
    }
    fb.set_back(state, 0)
    var fbw: u64 = fb_clear_rate(state, bytes, color)
    let fbw0: u64 = fbw
    n = kgbase.GFX_RUNDEN
    if fb.mtrrsim_an(state) {
        fbmtrr.sim_enable(state)
    }
    if fb.wc(state) != 0 {
        let st: u64 = fbmtrr.setup(state, fb.phys(state), fb.pitch(state) *% h, true, fb.nomtrr_an(state))
        if st == fbmtrr.ST_TENTATIVE {
            fbw = fb_clear_rate(state, bytes, color)
            if fbw * 4 < fbw0 * 5 && (!fb.mtrrsim_an(state) || fb.mtrrstrict_an(state)) {
                fbmtrr.revert(state, fbmtrr.RS_NO_GAIN)
                fbw = fbw0
            } else {
                fbmtrr.confirm(state)
            }
        }
    } else {
        fbmtrr.setup(state, 0, 0, false, fb.nomtrr_an(state))
    }
    fb.mtrr_probe(state)
    fb.perf_set(state, fb.PF_FBW0, fbw0)
    if back != 0 {
        fb.set_back(state, back)
        fb.dirty_all(state)
        fb.flush(state)
    }
    fb.perf_set(state, fb.PF_FBW, fbw)
    fb.perf_set(state, fb.PF_COPY, cpy)
    fb.perf_set(state, fb.PF_RAM, ram)
    fb.perf_set(state, fb.PF_BYTES, bytes)
    fb.perf_set(state, fb.PF_ROUNDS, n)
    fb.perf_set(state, fb.PF_DONE, 1)
    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_w[0]) as u64)
    serial.dec(fbw)
    serial.puts((&s_c[0]) as u64)
    serial.dec(cpy)
    serial.puts((&s_r[0]) as u64)
    serial.dec(ram)
    serial.puts((&s_m[0]) as u64)
    serial.dec(fb.cache_mode(state))
    serial.puts((&s_p[0]) as u64)
    serial.dec(fb.wc(state))
    serial.puts((&s_t[0]) as u64)
    serial.dec(fb.perf_get(state, fb.PF_MTRR) & 255)
    serial.puts((&s_f0[0]) as u64)
    serial.dec(fbw0)
    serial.puts((&s_ms[0]) as u64)
    serial.dec(fbmtrr.state_of(state))
    serial.puts((&s_mr[0]) as u64)
    serial.dec(fbmtrr.reason_of(state))
    serial.puts((&s_mc[0]) as u64)
    serial.dec(fbmtrr.count_of(state))
    serial.puts((&s_md[0]) as u64)
    serial.hex(fbmtrr.done_of(state))
    serial.nl()
}

fn bench_line(state: u64) -> u64 {
    let mark: bool = fb.cursor_on(state)
    fb.set_cursor(state, false)
    fb.clear(state, 0)
    fb.home(state)
    fb.flush(state)
    let t: u64 = apic.tsc()
    var i: u64 = 0
    while i < kgbase.GFX_RUNDEN {
        var c: u64 = 0
        while c < 80 {
            fb.putc(state, 88)
            c = c + 1
        }
        fb.putc(state, 10)
        i = i + 1
    }
    let us: u64 = us_of(state, time.since(t)) / kgbase.GFX_RUNDEN
    fb.set_cursor(state, mark)
    return us
}

fn testimage_header(dst: u64) -> u64 {
    var rest: [u8; 22] = " K7 FRAMEBUFFER 01234\0"
    var n: u64 = brand.append(dst, 0, brand.product(), 63)
    n = brand.append(dst, n, (&rest[0]) as u64, 63)
    kstate.set8(dst + n, 0)
    return n
}

fn vgpuhw_run(state: u64) {
    var s_p1: [u8; 17] = "vgpuhw: move hw=\0"
    var s_p2: [u8; 19] = "vgpuhw: frames hw=\0"
    var s_fr: [u8; 9] = " moves=\0\0"
    var s_ok: [u8; 7] = " okt=\0\0"
    var s_pf: [u8; 11] = " perframe=\0"
    var s_rd: [u8; 14] = "vgpuhw: ready\0"
    var s_pn: [u8; 15] = "vgpuhw: panel=\0"
    var s_x: [u8; 2] = "x\0"
    var s_en: [u8; 12] = "vgpuhw: end\0"
    var s_no: [u8; 15] = "vgpuhw: novgpu\0"
    if !vgpu.usable(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    let hw: bool = vgpu.cursor_usable(state) && !kstate.mode_on(state, kstate.M_NOHWCUR)
    let y0: u64 = 300
    let x0: u64 = 300
    if hw {
        let _z: bool = vgpu.cursor_displayed(state, 0, 32, x0, y0, 0, 0, 0)
    }
    let white: u64 = fb.rgb(state, 0xFF, 0xFF, 0xFF)

    let o1: u64 = vgpu.oktette(state)
    let m1: u64 = vgpu.cursor_moves(state)
    var i: u64 = 0
    while i < 60 {
        let nx: u64 = x0 + i * 3
        if hw {
            let _m: bool = vgpu.cursor_bewegen(state, nx, y0)
        } else {
            fb.fill(state, nx, y0, 12, 12, white)
            fb.flush_rect(state, nx, y0, 12, 12)
            gfx.frame_done(state)
        }
        i = i + 1
    }
    serial.puts((&s_p1[0]) as u64)
    if hw {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_fr[0]) as u64)
    serial.dec(vgpu.cursor_moves(state) - m1)
    serial.puts((&s_ok[0]) as u64)
    serial.dec(vgpu.oktette(state) - o1)
    serial.nl()

    let o2: u64 = vgpu.oktette(state)
    i = 0
    while i < 60 {
        let nx: u64 = x0 + i * 3
        if kstate.mode_on(state, kstate.M_WMRUHE) {
            fb.dirty_all(state)
        } else {
            fb.flush_rect(state, nx - 8, y0 - 8, 48, 48)
        }
        gfx.frame_done(state)
        i = i + 1
    }
    let d2: u64 = vgpu.oktette(state) - o2
    serial.puts((&s_p2[0]) as u64)
    if hw {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_ok[0]) as u64)
    serial.dec(d2)
    serial.puts((&s_pf[0]) as u64)
    serial.dec(d2 / 60)
    serial.nl()
    vgpu.say_hw(state)
    serial.puts((&s_rd[0]) as u64)
    serial.nl()

    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return
    }
    var until: u64 = apic.tsc() + hz * 30
    var lw: u64 = fb.panel_w(state)
    var lh: u64 = fb.panel_h(state)
    while apic.tsc() < until {
        let _e: bool = gfx.gpu_event(state)
        let pw: u64 = fb.panel_w(state)
        let ph: u64 = fb.panel_h(state)
        if pw != lw || ph != lh {
            lw = pw
            lh = ph

            fb.fill(state, 0, 0, 100, 100, fb.rgb(state, 0xFF, 0, 0))
            fb.flush_rect(state, 0, 0, 100, 100)
            gfx.frame_done(state)
            serial.puts((&s_pn[0]) as u64)
            serial.dec(pw)
            serial.puts((&s_x[0]) as u64)
            serial.dec(ph)
            serial.nl()
            vgpu.say_hw(state)
            until = apic.tsc() + hz * 6
        }
    }
    serial.puts((&s_en[0]) as u64)
    serial.nl()
}

static mut hint_next_ms: u64 = 0

static mut hint_step: u64 = 0

static mut hint_probe: u64 = 0xFFFFFFFFFFFFFFFF

fn hint_player(state: u64) {
    var s_a: [u8; 20] = "vmsvga: testhint \0\0\0"
    var s_x: [u8; 2] = "x\0"
    var s_r: [u8; 5] = " rc=\0"
    let hz: u64 = apic.tsc_hz(state)
    if hz < 1000 {
        return
    }
    let now: u64 = apic.tsc() / (hz / 1000)
    if hint_next_ms == 0 {
        hint_next_ms = now + 45000
        if kstate.mode_on(state, kstate.M_VMSVGAFULL) {

            hint_next_ms = now + 150000
        }
        var s_pt: [u8; 12] = "refitprobe\0\0"
        let pr: u64 = wmcore.create(state, 0, 20, 20, 900, 500, wmlayout.K_RAW, (&s_pt[0]) as u64)
        if pr < wm.MAX_WIN {
            hint_probe = pr
        }
        return
    }
    if now < hint_next_ms {
        return
    }
    hint_next_ms = now + 25000
    var w: u64 = 1280
    var h: u64 = 720
    let k: u64 = hint_step % 4
    if kstate.mode_on(state, kstate.M_VMSVGAFULL) {

        w = 1920
        h = 1200
        if k == 1 {
            w = 1366
            h = 768
        }
        if k == 2 {
            w = 1024
            h = 768
        }
        if k == 3 {
            w = 1920
            h = 1080
        }
    } else if kstate.mode_on(state, kstate.M_VMSVGAODD) {

        w = 1426
        h = 861
        if k == 1 {
            w = 1397
            h = 777
        }
        if k == 2 {
            w = 1111
            h = 703
        }
        if k == 3 {
            w = 1853
            h = 1049
        }
    } else if kstate.mode_on(state, kstate.M_VMSVGASTALE) {

        if k == 1 || k == 3 {
            w = 800
            h = 600
        }
        if k == 2 {
            w = 1024
            h = 768
        }
    } else if kstate.mode_on(state, kstate.M_VMSVGABIG) {

        if k == 1 {
            w = 2496
            h = 1507
        }
        if k == 2 {
            w = 1024
            h = 768
        }
        if k == 3 {
            w = 1600
            h = 900
        }
    } else if kstate.mode_on(state, kstate.M_VMSVGABOOT) {

        w = 1920
        h = 1080
        if k == 1 {
            w = 1280
            h = 720
        }
        if k == 2 {
            w = 2304
            h = 1296
        }
        if k == 3 {
            w = 1600
            h = 900
        }
    } else {
        if k == 1 || k == 3 {
            w = 1024
            h = 768
        }
        if k == 2 {
            w = 1600
            h = 900
        }
    }
    hint_step = hint_step + 1
    let rc: u64 = vmode.follow_host(state, w, h)
    serial.puts((&s_a[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_r[0]) as u64)
    serial.dec(rc)

    var s_nw: [u8; 6] = " now=\0"
    serial.puts((&s_nw[0]) as u64)
    serial.dec(fb.width(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.height(state))
    var s_sw: [u8; 5] = " sw=\0"
    var s_fl: [u8; 5] = " fl=\0"
    var s_rv: [u8; 5] = " rv=\0"
    serial.puts((&s_sw[0]) as u64)
    serial.dec(vmode.switches(state))
    serial.puts((&s_fl[0]) as u64)
    serial.dec(vmode.fails(state))
    serial.puts((&s_rv[0]) as u64)
    serial.dec(vmode.reverts(state))
    serial.nl()
    if hint_probe < wm.MAX_WIN {
        var s_rp: [u8; 18] = "wm: refit probe \0\0"
        serial.puts((&s_rp[0]) as u64)
        serial.dec(wmblur.win_w(state, hint_probe))
        serial.puts((&s_x[0]) as u64)
        serial.dec(wmblur.win_h(state, hint_probe))
        serial.nl()
    }
}

fn vmsvga_hint_one(state: u64, w: u64, h: u64) {
    var s_a: [u8; 17] = "vmsvga: hint in=\0"
    var s_x: [u8; 2] = "x\0"
    var s_p1: [u8; 5] = " p1=\0"
    var s_pe: [u8; 7] = " pend=\0"
    var s_rc: [u8; 5] = " rc=\0"
    var s_m: [u8; 7] = " mode=\0"
    var s_d: [u8; 6] = " dev=\0"
    var s_b: [u8; 6] = " bad=\0"
    vmsvga.vmm_fake(state, (w << 16) | h)
    let p1: u64 = vmsvga.host_pending(state)
    let p2: u64 = vmsvga.host_pending(state)
    var r: u64 = 99
    if p2 != 0 {
        r = vmode.follow_host(state, p2 / 65536, p2 % 65536)
    }
    vmsvga.vmm_fake(state, 0)

    vmsvga_pic(state)
    serial.puts((&s_a[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_p1[0]) as u64)
    serial.dec(p1)
    serial.puts((&s_pe[0]) as u64)
    serial.dec(p2 / 65536)
    serial.puts((&s_x[0]) as u64)
    serial.dec(p2 % 65536)
    serial.puts((&s_rc[0]) as u64)
    serial.dec(r)
    serial.puts((&s_m[0]) as u64)
    serial.dec(fb.panel_w(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.panel_h(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(vmsvga.width(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(vmsvga.height(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(vmsvga.verify_bad(state))
    serial.nl()
}

fn vmsvga_hint_stage(state: u64) {
    vmsvga_hint_one(state, 1137, 683)
    vmsvga_hint_one(state, 1280, 721)
    vmsvga_hint_one(state, 4096, 2304)
    vmsvga_hint_one(state, 1920, 1080)
    vmsvga_hint_one(state, 1024, 768)
}

fn vmsvga_pic(state: u64) {
    let w: u64 = fb.panel_w(state)
    let h: u64 = fb.panel_h(state)
    fb.set_cursor(state, false)
    fb.clear(state, 0)
    fb.fill(state, 0, 0, 100, 100, fb.rgb(state, 0xFF, 0, 0))
    fb.fill(state, 100, 0, 100, 100, fb.rgb(state, 0, 0xFF, 0))
    fb.fill(state, 200, 0, 100, 100, fb.rgb(state, 0, 0, 0xFF))
    fb.fill(state, 300, 0, 100, 100, fb.rgb(state, 0xFF, 0xFF, 0xFF))
    fb.line(state, 0, 110, 399, 210, fb.rgb(state, 0xFF, 0xFF, 0))
    fb.fill(state, w - 50, h - 50, 50, 50, fb.rgb(state, 0xFF, 0, 0xFF))
    fb.dirty_all(state)
    fb.flush(state)
    gfx.frame_done(state)
}

fn vmsvga_pause(state: u64, secs: u64) {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return
    }
    let until: u64 = apic.tsc() + hz * secs
    while apic.tsc() < until {
        let _e: bool = gfx.gpu_event(state)
        gfx.frame_done(state)
    }
}

fn vmsvga_run(state: u64) {
    var s_p1: [u8; 18] = "vmsvga: move hw=\0\0"
    var s_p2: [u8; 20] = "vmsvga: frames hw=\0\0"
    var s_mv: [u8; 9] = " moves=\0\0"
    var s_df: [u8; 7] = " defs=\0"
    var s_ok: [u8; 7] = " okt=\0\0"
    var s_pf: [u8; 11] = " perframe=\0"
    var s_rd: [u8; 14] = "vmsvga: ready\0"
    var s_pn: [u8; 15] = "vmsvga: panel=\0"
    var s_x: [u8; 2] = "x\0"
    var s_en: [u8; 12] = "vmsvga: end\0"
    var s_no: [u8; 17] = "vmsvga: novmsvga\0"
    var s_id: [u8; 18] = "vmsvga: idle okt=\0"
    var s_mx: [u8; 11] = " maxframe=\0"
    var s_ip: [u8; 6] = " pio=\0"
    var s_ma: [u8; 8] = " maxat=\0"
    var hw: bool = false
    let on: bool = vmsvga.is_ready(state)
    let y0: u64 = 300
    let x0: u64 = 300
    if on {
        hw = vmsvga.cursor_ready(state)
        if hw {
            let _z: bool = vmsvga.cursor_show(state, 0, 32, x0, y0, 0, 0, 0)
        }
        let o1: u64 = vmsvga.update_octets(state)
        let m1: u64 = vmsvga.cursor_moves(state)
        var i: u64 = 0
        while i < 60 {
            if hw {
                let _m: bool = vmsvga.cursor_bewegen(state, x0 + i * 3, y0)
            }
            i = i + 1
        }
        serial.puts((&s_p1[0]) as u64)
        if hw {
            serial.dec(1)
        } else {
            serial.dec(0)
        }
        serial.puts((&s_mv[0]) as u64)
        serial.dec(vmsvga.cursor_moves(state) - m1)
        serial.puts((&s_df[0]) as u64)
        serial.dec(vmsvga.cursor_defs(state))
        serial.puts((&s_ok[0]) as u64)
        serial.dec(vmsvga.update_octets(state) - o1)
        serial.nl()

        fb.flush_rect(state, 0, 0, 8, 8)
        gfx.frame_done(state)
        let o2: u64 = vmsvga.update_octets(state)
        i = 0
        var mx: u64 = 0
        var mxat: u64 = 0
        while i < 60 {
            let ob: u64 = vmsvga.update_octets(state)
            if kstate.mode_on(state, kstate.M_WMRUHE) {
                fb.dirty_all(state)
                fb.flush(state)
            } else {
                fb.flush_rect(state, x0 + i * 3 - 8, y0 - 8, 48, 48)
            }
            gfx.frame_done(state)
            let dd: u64 = vmsvga.update_octets(state) - ob
            if dd > mx {
                mx = dd
                mxat = i
            }
            i = i + 1
        }
        let d2: u64 = vmsvga.update_octets(state) - o2
        serial.puts((&s_p2[0]) as u64)
        if hw {
            serial.dec(1)
        } else {
            serial.dec(0)
        }
        serial.puts((&s_ok[0]) as u64)
        serial.dec(d2)
        serial.puts((&s_pf[0]) as u64)
        serial.dec(d2 / 60)
        serial.puts((&s_mx[0]) as u64)
        serial.dec(mx)
        serial.puts((&s_ma[0]) as u64)
        serial.dec(mxat)
        serial.nl()

        vmsvga_pause(state, 3)

        let o3: u64 = vmsvga.update_octets(state)
        let p3: u64 = vmsvga.pio_count(state)
        vmsvga_pause(state, 3)
        serial.puts((&s_id[0]) as u64)
        serial.dec(vmsvga.update_octets(state) - o3)
        serial.puts((&s_ip[0]) as u64)
        serial.dec(vmsvga.pio_count(state) - p3)
        serial.nl()
        vmsvga.say(state)
    } else {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
    }
    serial.puts((&s_rd[0]) as u64)
    serial.nl()

    var k: u64 = 0
    while k < 5 {
        var nw: u64 = fb.panel_w(state)
        var nh: u64 = fb.panel_h(state)
        if k == 1 {
            nw = 1024
            nh = 768
        }
        if k == 2 {
            nw = 1280
            nh = 720
        }
        if k == 3 {
            nw = 640
            nh = 480
        }
        if k == 4 {
            nw = 800
            nh = 600
        }
        if k != 0 {
            let _f: u64 = vmode.follow_host(state, nw, nh)
        }

        if on {
            vmsvga.say(state)
        }
        serial.puts((&s_pn[0]) as u64)
        serial.dec(fb.panel_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.panel_h(state))
        serial.nl()
        vmsvga_pic(state)
        if k == 4 {
            vmsvga_pause(state, 13)
            if on {
                vmsvga.say(state)
            }
        } else {
            vmsvga_pause(state, 4)
        }
        k = k + 1
    }
    if on {
        vmsvga_hint_stage(state)
    }
    serial.puts((&s_en[0]) as u64)
    serial.nl()
}

fn pattern(state: u64, eine: u64, two: u64) {
    fb.set_cursor(state, false)
    fb.clear(state, 0)
    fb.fill(state, 0, 0, 100, 100, fb.rgb(state, 0xFF, 0, 0))
    fb.fill(state, 100, 0, 100, 100, fb.rgb(state, 0, 0xFF, 0))
    fb.fill(state, 200, 0, 100, 100, fb.rgb(state, 0, 0, 0xFF))
    fb.fill(state, 300, 0, 100, 100, fb.rgb(state, 0xFF, 0xFF, 0xFF))
    fb.line(state, 0, 110, 399, 210, fb.rgb(state, 0xFF, 0xFF, 0))
    vgpu.ext_testimage(state)
    fb.goto(state, 0, 14)
    serial.puts(eine)
    serial.nl()
    serial.puts(two)
    serial.nl()
    fb.dirty_all(state)
    fb.flush(state)
}

fn power_screen(state: u64) {
    var n_a: [u8; 6] = "px_a\0\0"
    var n_b: [u8; 6] = "px_b\0\0"
    var n_c: [u8; 6] = "px_c\0\0"
    var n_d: [u8; 6] = "px_d\0\0"
    var n_e: [u8; 6] = "px_e\0\0"
    var n_no: [u8; 9] = "px_none\0\0"
    if !kstate.mode_on(state, kstate.M_PWR) {
        return
    }
    if !fb.ready(state) {
        kutil.pnum((&n_no[0]) as u64, 1)
        return
    }
    let echo_vorher: bool = fb.echo_on(state)
    fb.set_echo(state, false)
    fb.fill(state, 100, 100, 64, 64, PX_COLOR)
    fb.flush(state)
    kutil.phex((&n_a[0]) as u64, fb.get_pixel(state, PX_X, PX_Y) & 0xFFFFFF)

    if kstate.mode_on(state, kstate.M_PWRDIM) {
        pwr.set_bright(state, 50)
        kutil.phex((&n_b[0]) as u64, fb.get_pixel(state, PX_X, PX_Y) & 0xFFFFFF)
        pwr.set_bright(state, 100)
        kutil.phex((&n_c[0]) as u64, fb.get_pixel(state, PX_X, PX_Y) & 0xFFFFFF)
        pwr.set_bright(state, 50)
    }
    if kstate.mode_on(state, kstate.M_PWRBLANK) {
        pwr.blank(state)
        kutil.phex((&n_d[0]) as u64, fb.get_pixel(state, PX_X, PX_Y) & 0xFFFFFF)
        kutil.pnum((&n_e[0]) as u64, pwr.value(state, pwr.PW_BLANKS))
    }
    fb.flush(state)
    var s_shot: [u8; 12] = "pwr: shot\0\0\0"
    serial.puts((&s_shot[0]) as u64)
    serial.nl()
    let hz: u64 = apic.tsc_hz(state)
    if hz != 0 {
        let bis: u64 = apic.tsc() + hz * 5
        while apic.tsc() < bis {
        }
    }
    var s_go: [u8; 12] = "pwr: shotgo\0"
    serial.puts((&s_go[0]) as u64)
    serial.nl()
    fb.set_echo(state, echo_vorher)
}

fn gui_root_from_part(state: u64) -> bool {
    var s_try: [u8; 18] = "wm: rootpart scan\0"
    var s_at: [u8; 14] = "wm: rootpart=\0"
    var s_fi: [u8; 9] = "  first=\0"
    var s_bl: [u8; 10] = "  blocks=\0"
    var s_none: [u8; 22] = "wm: keine OFS-Part.\0\0\0"
    serial.puts((&s_try[0]) as u64)
    serial.nl()
    let n: u64 = part.scan(state, blk.DEV_ATA)
    if n == 0 {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return false
    }
    let i: u64 = part.find_root(state, blk.DEV_ATA)
    if i >= part.MAX_PARTS {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return false
    }
    let first: u64 = part.start(state, i)
    let cnt: u64 = part.blocks(state, i)
    blk.use_at(state, blk.DEV_ATA, first, cnt)
    if !fs.mount(state) {
        blk.use_ata(state, kutil.root_blocks(state))
        return false
    }
    kstate.set(state, kstate.ROOT_PART, i)
    serial.puts((&s_at[0]) as u64)
    serial.dec(i)
    serial.puts((&s_fi[0]) as u64)
    serial.dec(first)
    serial.puts((&s_bl[0]) as u64)
    serial.dec(cnt)
    serial.nl()
    return true
}

fn zieh_marken(state: u64) {
    if zieh_marken_gesetzt != 0 {
        return
    }
    zieh_marken_gesetzt = 1
    let vl: u64 = kstate.get(state, kstate.ZIEH_LIFT)
    let vt: u64 = kstate.get(state, kstate.ZIEH_TILT)
    let vs: u64 = kstate.get(state, kstate.ZIEH_SWING)
    if vl != 9999 {
        let _fl: bool = wmdraw.set_form(state, wmlayout.FM_LIFT, vl)
    }
    if vt != 9999 {
        let _ft: bool = wmdraw.set_form(state, wmlayout.FM_TILT, vt)
    }
    if vs != 9999 {
        let _fs: bool = wmdraw.set_form(state, wmlayout.FM_SWING, vs)
    }
    let vb: u64 = kstate.get(state, kstate.BLUR_R)
    let vbt: u64 = kstate.get(state, kstate.BLUR_TINT)
    let vbn: u64 = kstate.get(state, kstate.BLUR_NOISE)

    if kstate.mode_on(state, kstate.M_BLURNOCACHE) {
        wm.set_blur_cache(state, false)
    }
    if vb != 9999 {
        let _fb: bool = wmdraw.set_form(state, wmlayout.FM_BLUR, vb)
    }
    if vbt != 9999 {
        let _fbt: bool = wmdraw.set_form(state, wmlayout.FM_BLURTINT, vbt)
    }
    if vbn != 9999 {
        let _fbn: bool = wmdraw.set_form(state, wmlayout.FM_BLURNOISE, vbn)
    }
}

static mut zieh_marken_gesetzt: u64 = 0

static mut zieh_t0: u64 = 0

static mut zieh_schritt: u64 = 0

static mut zieh_win: u64 = 0

static mut blur_t0: u64 = 0

static mut blur_schritt: u64 = 0

fn blur_vorfuehrung(state: u64) {
    let t: u64 = kstate.get(state, kstate.TICKS)
    let ab: u64 = blur_t0
    if ab == 0 {
        blur_t0 = t
        return
    }
    let seit: u64 = t - ab
    if seit >= 50 && blur_schritt == 0 {
        blur_schritt = 1
        var s_g: [u8; 7] = "Muster\0"
        let sw: u64 = wmgeom.max_w(state)
        let sh: u64 = wmgeom.max_h(state)
        let g: u64 = wmcore.create(state, 0, 0, 0, sw, sh, wmlayout.K_RAW,
            (&s_g[0]) as u64)
        if g < wm.MAX_WIN {
            wmcore.set_deco(state, g, false)
            wmcore.set_layer(state, g, wm.L_DESK)
            var y: u64 = 0
            while y < sh {
                var x: u64 = 0
                while x < sw {
                    let fx: u64 = x / 64
                    let fy: u64 = y / 64
                    var c: u64 = 0x1E3A8A
                    if ((fx + fy) & 1) == 0 {
                        c = 0xF59E0B
                    }
                    if ((fx + fy) & 3) == 2 {
                        c = 0x10B981
                    }
                    var bw: u64 = 64
                    if x + bw > sw {
                        bw = sw - x
                    }
                    var bh: u64 = 64
                    if y + bh > sh {
                        bh = sh - y
                    }
                    wmdraw.fill(state, g, x, y, bw, bh, c)
                    x = x + 64
                }
                y = y + 64
            }
            wmcpath.flush_win(state, g)
        }
        var s_m: [u8; 11] = "Startmenü\0"
        let m: u64 = wmcore.create(state, 0, 80, 120, 320, 520, wmlayout.K_RAW,
            (&s_m[0]) as u64)
        if m < wm.MAX_WIN {
            wmcore.set_deco(state, m, false)
            wmcore.set_layer(state, m, wmlayout.L_MENU)
            wmdraw.fill(state, m, 0, 0, 320, 520, 0xF8FAFC)
            blur_frame(state, m, 320, 520)
            let _o1: bool = wmblur.set_opac(state, m, 150)
            wmcpath.flush_win(state, m)
        }
        var s_l: [u8; 11] = "Leiste2   \0"
        let l: u64 = wmcore.create(state, 0, 0, (sh - 96) as i64, sw, 48,
            wmlayout.K_RAW, (&s_l[0]) as u64)
        if l < wm.MAX_WIN {
            wmcore.set_deco(state, l, false)
            wmcore.set_layer(state, l, wmlayout.L_TOP)
            wmdraw.fill(state, l, 0, 0, sw, 48, 0xF8FAFC)
            blur_frame(state, l, sw, 48)
            let _o2: bool = wmblur.set_opac(state, l, 150)
            wmcpath.flush_win(state, l)
        }
        var s_s: [u8; 18] = "blur: vorgefuehrt\0"
        serial.puts((&s_s[0]) as u64)
        serial.nl()
    }
}

fn blur_frame(state: u64, i: u64, w: u64, h: u64) {
    wmdraw.fill(state, i, 0, 0, w, 4, 0xFFFFFF)
    wmdraw.fill(state, i, 0, h - 4, w, 4, 0xFFFFFF)
    wmdraw.fill(state, i, 0, 0, 4, h, 0xFFFFFF)
    wmdraw.fill(state, i, w - 4, 0, 4, h, 0xFFFFFF)
}

fn zieh_vorfuehrung(state: u64) {
    let t: u64 = kstate.get(state, kstate.TICKS)
    let ab: u64 = zieh_t0
    if ab == 0 {
        zieh_t0 = t
        return
    }
    let seit: u64 = t - ab
    if seit >= 50 && zieh_schritt == 0 {
        zieh_schritt = 1
        var s_t: [u8; 7] = "Ziehen\0"
        let i: u64 = wmcore.create(state, 0, 120, 380, 360, 240, wmlayout.K_RAW,
            (&s_t[0]) as u64)
        if i < wm.MAX_WIN {
            wmdraw.fill(state, i, 0, 0, 360, 240, 0x2E6FD9)
            wmdraw.fill(state, i, 16, 16, 150, 100, 0xF8FAFC)
            wmdraw.fill(state, i, 200, 140, 140, 80, 0xFFC857)
            zieh_win = i + 1
            var s_g: [u8; 16] = "zieh: angefasst\0"
            serial.puts((&s_g[0]) as u64)
            serial.nl()
            tiling.drag_begin_pub(state, i, 40, 20)
        }
    }
    if seit >= 60 && seit < 100 && zieh_win != 0 {
        let i: u64 = zieh_win - 1
        let n: i64 = (seit - 60) as i64
        wmcore.move_win(state, i, 120 + n * 9, 380 - n * 4)
    }

    if zieh_win != 0 && seit >= 55 && seit <= 190 {
        let i: u64 = zieh_win - 1
        var s_p: [u8; 12] = "zieh: t=\0\0\0\0"
        var s_x: [u8; 5] = "  x=\0"
        var s_y: [u8; 5] = "  y=\0"
        var s_s: [u8; 6] = "  sx=\0"
        var s_t2: [u8; 6] = "  sy=\0"
        serial.puts((&s_p[0]) as u64)
        serial.dec(seit)
        serial.puts((&s_x[0]) as u64)
        serial.dec(wm.win_x_pub(state, i) as u64)
        serial.puts((&s_y[0]) as u64)
        serial.dec(wm.win_y_pub(state, i) as u64)
        serial.puts((&s_s[0]) as u64)
        serial.dec(wmanim.swing_dx(state, i) as u64)
        serial.puts((&s_t2[0]) as u64)
        serial.dec(wmanim.swing_dy(state, i) as u64)
        serial.nl()
    }
    if seit >= 180 && zieh_schritt == 1 {
        zieh_schritt = 2
        if zieh_win != 0 {
            tiling.drag_end_pub(state, zieh_win - 1)
        }
        var s_l: [u8; 18] = "zieh: losgelassen\0"
        serial.puts((&s_l[0]) as u64)
        serial.nl()
    }
}

fn anim_vorfuehrung(state: u64) {
    let t: u64 = kstate.get(state, kstate.TICKS)
    let ab: u64 = wmpresent.before_t0(state)
    if ab == 0 {
        wm.set_before_t0(state, t)
        return
    }
    let seit: u64 = t - ab
    let schritt: u64 = wmpresent.before_step(state)
    if seit >= 50 && schritt == 0 {
        wm.set_before_step(state, 1)
        var s_t: [u8; 9] = "Aufgehen\0"
        let i: u64 = wmcore.create(state, 0, 220, 180, 320, 200, wmlayout.K_RAW,
            (&s_t[0]) as u64)
        if i < wm.MAX_WIN {
            wmdraw.fill(state, i, 0, 0, 320, 200, 0x2E6FD9)
            wmdraw.fill(state, i, 20, 20, 280, 160, 0xE8EEF7)
            wm.set_before_win(state, i + 1)
            let _a: bool = wmanim.open_anim(state, i)
        }
    }
    if seit >= 150 && schritt == 1 {
        wm.set_before_step(state, 2)
        let w: u64 = wmpresent.before_win(state)
        if w != 0 {
            let _c: bool = wmanimctl.close_anim(state, w - 1)
        }
    }
}

fn leser_tick(state: u64) {
    wmframe.leser_tick(state)
}

static mut dnd_buf: [u8; 232] = [0 as u8; 232]

fn dnd_pump(state: u64) {
    let r: u64 = wmkeys.dnd_take_paste(state, (&dnd_buf[0]) as u64, 230)
    if r == 0 {
        return
    }
    let t: u64 = r >> 32
    let n: u64 = r & 0xFFFFFFFF
    let _s: u64 = tty.push_text(state, t, (&dnd_buf[0]) as u64, n)
}

static mut tclip_a: [u8; 4104] = [0 as u8; 4104]

static mut tclip_wait_tty: u64 = 0

static mut tclip_wait_sel: u64 = 0

static mut tclip_wait_since: u64 = 0

const TCLIP_WAIT_NS: u64 = 3000000000

fn termclip_fetch(state: u64, sel: u64, pa: u64) -> u64 {
    var len: u64 = slots.get_kernel(state, sel, 0, 1, pa, 4096)
    if len == slots.KGET_AGAIN {
        return len
    }
    if len == 0 {
        len = slots.get_kernel(state, sel, 0, 2, pa, 4096)
    }
    if len == 0 {
        len = slots.get_kernel(state, sel, 0, 5, pa, 4096)
        if len == slots.KGET_AGAIN {
            return 0
        }
        if len != 0 {
            len = urilist.list_to_plain(pa, len, 4096)
            var q: u64 = 0
            while q < len {
                if kstate.get8(pa + q) == 10 {
                    kstate.set8(pa + q, 32)
                }
                q = q + 1
            }
        }
    }
    return len
}

fn termclip_paste(state: u64, t: u64, sel: u64, pa: u64) -> bool {
    var use: u64 = sel
    if use == slots.SEL_PRIMARY && slots.count(state, slots.SEL_PRIMARY) == 0 {
        use = slots.SEL_CLIP
    }
    let len: u64 = termclip_fetch(state, use, pa)
    if len == slots.KGET_AGAIN {
        return false
    }
    if len != 0 {
        let _s: u64 = tty.push_text(state, t, pa, len)
        wmtermio.term_paste_done(state)
    }
    return true
}

fn termclip_pump(state: u64) {
    let pa: u64 = (&tclip_a[0]) as u64
    let n: u64 = wmterm.term_copy_take(state, pa, 4096)
    if n != 0 {
        let _b: u64 = slots.put_kernel(state, sched.current(state), slots.SEL_CLIP, bus.T_TEXT, pa, n)
    }
    let pn: u64 = wmterm.term_primary_take(state, pa, 4096)
    if pn != 0 {
        let _p: u64 = slots.put_kernel(state, sched.current(state), slots.SEL_PRIMARY, bus.T_TEXT, pa, pn)
    }
    let t1: u64 = wmterm.term_paste_take(state)
    if t1 != 0 {
        let psel: u64 = wmterm.term_paste_sel(state)
        if !termclip_paste(state, t1 - 1, psel, pa) {
            tclip_wait_tty = t1
            tclip_wait_sel = psel
            tclip_wait_since = time.mono_ns(state)
        }
        return
    }
    if tclip_wait_tty != 0 {
        if termclip_paste(state, tclip_wait_tty - 1, tclip_wait_sel, pa)
            || time.mono_ns(state) - tclip_wait_since > TCLIP_WAIT_NS {
            tclip_wait_tty = 0
        }
    }
}
