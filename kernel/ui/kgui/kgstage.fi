fn say_font(state: u64, f: u64, px: u64, name: u64, s_font: u64, s_g: u64,
    s_upm: u64, s_asc: u64, s_desc: u64, s_lh: u64, s_kp: u64, s_st: u64,
    s_of: u64) {
    if f >= ttf.MAX_FONTS {
        return
    }
    serial.puts(s_font)
    serial.puts(name)
    serial.puts(s_g)
    serial.dec(ttf.glyphs(state, f))
    serial.puts(s_upm)
    serial.dec(ttf.upm(state, f))
    serial.puts(s_asc)
    serial.dec(ttf.ascent(state, f, px) as u64)
    serial.puts(s_desc)
    serial.dec(ttf.descent(state, f, px) as u64)
    serial.puts(s_lh)
    serial.dec(ttf.line_height(state, f, px))
    serial.puts(s_kp)
    serial.dec(kgrun.kern_pairs(state, f, px))
    serial.puts(s_st)
    serial.dec(ttf.selftest(state, f))
    serial.puts(s_of)
    serial.dec(ttf.selftest_max())
    serial.nl()
}

fn say_glyph(state: u64, f: u64, px: u64, c: u64) {
    var s_g: [u8; 12] = "ttfglyph c=\0"
    var s_px: [u8; 6] = "  px=\0"
    var s_w: [u8; 5] = "  w=\0"
    var s_h: [u8; 5] = "  h=\0"
    var s_l: [u8; 8] = "  left=\0"
    var s_t: [u8; 7] = "  top=\0"
    var s_a: [u8; 7] = "  adv=\0"
    var s_s: [u8; 7] = "  sum=\0"
    var s_r: [u8; 10] = "ttfrow \0\0\0"
    var stufen: [u8; 11] = " .:-=+*#%@\0"
    let slot: u64 = ttf.glyph(state, f, c, px)
    serial.puts((&s_g[0]) as u64)
    serial.dec(c)
    serial.puts((&s_px[0]) as u64)
    serial.dec(px)
    serial.puts((&s_w[0]) as u64)
    serial.dec(ttf.g_w(state, slot))
    serial.puts((&s_h[0]) as u64)
    serial.dec(ttf.g_h(state, slot))
    serial.puts((&s_l[0]) as u64)
    serial.dec(ttf.g_left(state, slot) as u64)
    serial.puts((&s_t[0]) as u64)
    serial.dec(ttf.g_top(state, slot) as u64)
    serial.puts((&s_a[0]) as u64)
    serial.dec(ttf.g_adv(state, slot) as u64)
    serial.puts((&s_s[0]) as u64)
    serial.dec(kgrun.glyph_sum(state, slot))
    serial.nl()
    var y: u64 = 0
    while y < ttf.g_h(state, slot) {
        serial.puts((&s_r[0]) as u64)
        serial.dec(y)
        serial.put(32 as u8)
        serial.put(124 as u8)
        var x: u64 = 0
        while x < ttf.g_w(state, slot) {
            let a: u64 = ttf.g_pixel(state, slot, x, y)
            serial.put(stufen[(a * 10 / 256) as usize])
            x = x + 1
        }
        serial.put(124 as u8)
        serial.nl()
        y = y + 1
    }
}

fn tile_conf(state: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return 0
    }
    var cur_path: [u8; 31] = "/users/osum/config/tiling.conf\0"
    let ino: u64 = fs.path(state, (&cur_path[0]) as u64)
    if ino == 0 {
        return 0
    }
    let n: u64 = fs.inode_size(state, ino)
    if n == 0 || n > 4000 {
        return 0
    }
    let buf: u64 = mmframe.frame_run(state, 1)
    if buf == 0 {
        return 0
    }
    var off: u64 = 0
    while off < n {
        var c: u64 = n - off
        if c > 4096 {
            c = 4096
        }
        let got: u64 = fs.read_at(state, ino, off, buf + off, c)
        if got == 0 {
            off = n
        } else {
            off = off + got
        }
    }
    let k: u64 = tile.bind_parse(state, buf, n)
    mmframe.frame_free_run(state, buf, 1)
    return k
}

fn tile_build(state: u64, n: u64, w: u64, h: u64) {
    tile.init(state, 0, 0, w, h)
    var k: u64 = 0
    while k < n {
        k = k + 1
        tile.insert(state, 0)
    }
}

fn tile_time(state: u64, n: u64, w: u64, h: u64, verify: bool) -> u64 {
    tile_build(state, n, w, h)
    let t: u64 = apic.tsc()
    var i: u64 = 0
    while i < TILE_RUNDEN {
        if verify {
            tile.check(state)
        } else {
            tile.relayout(state)
        }
        i = i + 1
    }
    return kgdisp.us_of(state, time.since(t))
}

fn tile_stage(state: u64, w: u64, h: u64) {
    var s_t: [u8; 7] = "tile: \0"
    var s_x: [u8; 2] = "x\0"
    var s_nd: [u8; 10] = "  nodes=\0\0"
    var s_lv: [u8; 12] = "  maxleaf=\0\0"
    var s_bd: [u8; 10] = "  binds=\0\0"
    var s_st: [u8; 11] = "selftest \0\0"
    var s_of: [u8; 4] = "/\0\0\0"
    var s_be: [u8; 20] = "tile: bench relay2=\0"
    var s_r8: [u8; 10] = "  relay8=\0"
    var s_r32: [u8; 11] = "  relay32=\0"
    var s_ck: [u8; 11] = "  check32=\0"
    var s_ns: [u8; 4] = " ns\0"
    var s_fz: [u8; 18] = "tile: fuzz ops=\0\0\0"
    var s_vi: [u8; 15] = "  violations=\0\0"
    var s_pk: [u8; 9] = "  peak=\0\0"
    var s_ch: [u8; 11] = "  checks=\0\0"
    var s_nos: [u8; 22] = "  (notiledirty: an)\0\0\0"

    serial.puts((&s_t[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_nd[0]) as u64)
    serial.dec(tile.MAX_NODES)
    serial.puts((&s_lv[0]) as u64)
    serial.dec(tile.MAX_LEAVES)
    serial.nl()

    serial.puts((&s_t[0]) as u64)
    serial.puts((&s_st[0]) as u64)
    serial.dec(tile.selftest(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(tile.selftest_max())
    var s_fb: [u8; 11] = "  failed=\0\0"
    serial.puts((&s_fb[0]) as u64)
    serial.hex(tile.failbits(state))
    serial.nl()

    let nb: u64 = tile_conf(state)
    serial.puts((&s_t[0]) as u64)
    serial.puts((&s_bd[0]) as u64 + 2)
    serial.dec(nb)
    serial.nl()

    if apic.tsc_hz(state) != 0 {
        let r2: u64 = tile_time(state, 2, w, h, false)
        let r8: u64 = tile_time(state, 8, w, h, false)
        let r32: u64 = tile_time(state, 32, w, h, false)
        let c32: u64 = tile_time(state, 32, w, h, true)
        serial.puts((&s_be[0]) as u64)
        serial.dec(r2)
        serial.puts((&s_ns[0]) as u64)
        serial.puts((&s_r8[0]) as u64)
        serial.dec(r8)
        serial.puts((&s_ns[0]) as u64)
        serial.puts((&s_r32[0]) as u64)
        serial.dec(r32)
        serial.puts((&s_ns[0]) as u64)
        serial.puts((&s_ck[0]) as u64)
        serial.dec(c32)
        serial.puts((&s_ns[0]) as u64)
        serial.nl()
    }

    if kstate.mode_on(state, kstate.M_TILEFUZZ) {
        tile.init(state, 0, 0, w, h)
        let v: u64 = tile.fuzz(state, 10000)
        serial.puts((&s_fz[0]) as u64)
        serial.dec(10000)
        serial.puts((&s_vi[0]) as u64)
        serial.dec(v)
        serial.puts((&s_pk[0]) as u64)
        serial.dec(tile.peak(state))
        serial.puts((&s_ch[0]) as u64)
        serial.dec(tile.checks(state))
        serial.nl()
    }

    tile.init(state, 0, 0, w, h)
    if kstate.mode_on(state, kstate.M_NOTILEDIRTY) {
        tile.set_nosub(state, true)
        serial.puts((&s_t[0]) as u64)
        serial.puts((&s_nos[0]) as u64)
        serial.nl()
    }
}

fn tile_shot(state: u64, w: u64, h: u64) {
    var t1: [u8; 4] = "One\0"
    var t2: [u8; 4] = "Two\0"
    var t3: [u8; 6] = "Three\0"
    var t4: [u8; 5] = "Four\0"
    var s_w: [u8; 11] = "tile: win=\0"
    var s_k: [u8; 3] = " \0\0"
    var s_c: [u8; 2] = ",\0"
    var s_x: [u8; 2] = "x\0"
    var s_d: [u8; 19] = "tile: dirty split=\0"
    var s_cl: [u8; 9] = "  close=\0"
    var s_sc: [u8; 10] = "  screen=\0"
    var s_tb: [u8; 13] = "tile: tabs=\0\0"
    var s_hd: [u8; 10] = "  hidden=\0"

    let tabs: bool = kstate.mode_on(state, kstate.M_TILETABS)
    let rot: bool = kstate.mode_on(state, kstate.M_TILEROT)
    var a: u64 = wm.MAX_WIN
    var b: u64 = wm.MAX_WIN
    var c: u64 = wm.MAX_WIN
    var d: u64 = wm.MAX_WIN
    var f: u64 = 0
    while f < wm.MAX_WIN {
        if wmbase.valid(state, f) && tiling.tiled(state, f) {
            tiling.tile_float(state, f)
        }
        f = f + 1
    }
    a = wmcore.create(state, 0, 0, 0, w / 2, h / 2, wmlayout.K_RAW, (&t1[0]) as u64)
    b = wmcore.create(state, 0, 0, 0, w / 2, h / 2, wmlayout.K_RAW, (&t2[0]) as u64)
    c = wmcore.create(state, 0, 0, 0, w / 2, h / 2, wmlayout.K_RAW, (&t3[0]) as u64)
    d = wmcore.create(state, 0, 0, 0, w / 2, h / 2, wmlayout.K_RAW, (&t4[0]) as u64)
    tile_arrange(state, a, b, c, d, false)
    let paar: u64 = tile_dirty(state)
    tile_arrange(state, a, b, c, d, tabs)
    if rot {
        tile.rotate(state, tile.root(state), 1)
        tiling.tile_apply(state)
    }
    wmbase.damage_all(state)
    tile_paint(state, a, fb.rgb(state, 0xC0, 0x30, 0x30))
    tile_paint(state, b, fb.rgb(state, 0x30, 0xB0, 0x50))
    tile_paint(state, c, fb.rgb(state, 0x30, 0x60, 0xE0))
    tile_paint(state, d, fb.rgb(state, 0xE0, 0xC0, 0x30))
    tile_say(state, a, (&s_w[0]) as u64, (&s_k[0]) as u64,
        (&s_c[0]) as u64, (&s_x[0]) as u64)
    tile_say(state, b, (&s_w[0]) as u64, (&s_k[0]) as u64,
        (&s_c[0]) as u64, (&s_x[0]) as u64)
    tile_say(state, c, (&s_w[0]) as u64, (&s_k[0]) as u64,
        (&s_c[0]) as u64, (&s_x[0]) as u64)
    tile_say(state, d, (&s_w[0]) as u64, (&s_k[0]) as u64,
        (&s_c[0]) as u64, (&s_x[0]) as u64)
    var versteckt: u64 = 0
    var k: u64 = 0
    while k < wm.MAX_WIN {
        if wmbase.valid(state, k) && tiling.win_tabbed(state, k) {
            versteckt = versteckt + 1
        }
        k = k + 1
    }
    serial.puts((&s_tb[0]) as u64)
    serial.dec(numeric.yes(tabs))
    serial.puts((&s_hd[0]) as u64)
    serial.dec(versteckt)
    serial.nl()
    serial.puts((&s_d[0]) as u64)
    serial.dec(paar & 0xFFFFFFFF)
    serial.puts((&s_cl[0]) as u64)
    serial.dec(paar >> 32)
    serial.puts((&s_sc[0]) as u64)
    serial.dec(w * h)
    serial.nl()
}

fn tile_arrange(state: u64, a: u64, b: u64, c: u64, d: u64, tabs: bool) {
    var k: u64 = 0
    while k < wm.MAX_WIN {
        if wmbase.valid(state, k) {
            tiling.tile_release(state, k)
        }
        k = k + 1
    }
    tile.set_next_split(state, 0)
    tiling.tile_take(state, a)
    tile.set_next_split(state, 1)
    tiling.tile_take(state, b)
    if tabs {
        tile.set_layout(state, tile.root(state), tile.LAY_TABBED)
        tiling.tile_apply(state)
        tile.set_next_split(state, 0)
        tiling.tile_take(state, c)
        tile.set_next_split(state, 0)
        tiling.tile_take(state, d)
    } else {
        wmcore.set_focus(state, b)
        tile.set_next_split(state, 2)
        tiling.tile_take(state, c)
        wmcore.set_focus(state, a)
        tile.set_next_split(state, 2)
        tiling.tile_take(state, d)
    }
    tiling.tile_apply(state)
    wmbase.damage_all(state)
}

fn tile_paint(state: u64, i: u64, color: u64) {
    if i >= wm.MAX_WIN {
        return
    }
    wmdraw.fill(state, i, 0, 0, wmblur.win_w(state, i), wmblur.win_h(state, i), color)
}

fn tile_say(state: u64, i: u64, sw: u64, sk: u64, sc: u64, sx: u64) {
    if i >= wm.MAX_WIN {
        return
    }
    serial.puts(sw)
    serial.dec(i)
    serial.puts(sk)
    serial.dec(wmbase.win_x(state, i) as u64)
    serial.puts(sc)
    serial.dec(wmbase.win_y(state, i) as u64)
    serial.puts(sk)
    serial.dec(wmbase.outer_w(state, i))
    serial.puts(sx)
    serial.dec(wmbase.outer_h(state, i))
    serial.nl()
}

fn tile_dirty(state: u64) -> u64 {
    let f: u64 = wmbase.focus(state)
    if f >= wm.MAX_WIN || !tiling.tiled(state, f) {
        return 0
    }
    wmbase.damage_all(state)
    wmcompose.compose(state)
    let p0: u64 = wm.pixels(state)
    tiling.tile_release(state, f)
    wmcompose.compose(state)
    let close_path: u64 = wm.pixels(state) - p0
    wmbase.damage_all(state)
    wmcompose.compose(state)
    let p1: u64 = wm.pixels(state)
    tiling.tile_take(state, f)
    wmcompose.compose(state)
    let auf: u64 = wm.pixels(state) - p1
    wmbase.damage_all(state)
    wmcompose.compose(state)
    return (close_path << 32) | (auf & 0xFFFFFFFF)
}

fn ub_line(state: u64, tw: u64, p: u64, n: u64) {
    kstate.set8(p + n, 10 as u8)
    wmtermio.term_write(state, tw, p, n + 1)
    var i: u64 = 0
    while i < n {
        serial.put(kstate.get8(p + i) as u8)
        i = i + 1
    }
    serial.nl()
}

fn ub_sp(state: u64, b: u64, n: u64) -> u64 {
    var l: [u8; 2] = " \0"
    return kgsvc.pulse_text(state, b, n, (&l[0]) as u64)
}

fn ub_cls(state: u64, b: u64, n: u64, c: u64, u: u64, pr: u64) -> u64 {
    var d: [u8; 2] = ":\0"
    var m: u64 = kgsvc.pulse_hexn(state, b, n, c, 2)
    m = kgsvc.pulse_text(state, b, m, (&d[0]) as u64)
    m = kgsvc.pulse_hexn(state, b, m, u, 2)
    m = kgsvc.pulse_text(state, b, m, (&d[0]) as u64)
    return kgsvc.pulse_hexn(state, b, m, pr, 2)
}

fn usb_bericht(state: u64, tw: u64) {
    if tw >= wm.MAX_WIN {
        return
    }
    var b: [u8; 128] = [0 as u8; 128]
    let p: u64 = (&b[0]) as u64

    var t_h: [u8; 6] = "USB  \0"
    var t_hc: [u8; 5] = "hc=\0\0"
    var t_po: [u8; 8] = " ports=\0"
    var t_de: [u8; 6] = " dev=\0"
    var t_fu: [u8; 7] = " fund=\0"
    var t_hb: [u8; 7] = " hubs=\0"
    var t_hp: [u8; 8] = " hbprt=\0"
    var t_fa: [u8; 8] = " fails=\0"
    var n: u64 = 0
    n = kgsvc.pulse_text(state, p, 0, (&t_h[0]) as u64)
    n = kgsvc.pulse_text(state, p, n, (&t_hc[0]) as u64)
    n = kgsvc.pulse_num(state, p, n, xhci.count_hc(state))
    n = kgsvc.pulse_text(state, p, n, (&t_po[0]) as u64)
    n = kgsvc.pulse_num(state, p, n, xhci.ports(state))
    n = kgsvc.pulse_text(state, p, n, (&t_de[0]) as u64)
    n = kgsvc.pulse_num(state, p, n, usb.count(state))
    n = kgsvc.pulse_text(state, p, n, (&t_fu[0]) as u64)
    n = kgsvc.pulse_num(state, p, n, usb.fund_count(state))
    n = kgsvc.pulse_text(state, p, n, (&t_hb[0]) as u64)
    n = kgsvc.pulse_num(state, p, n, usb.hubs(state))
    n = kgsvc.pulse_text(state, p, n, (&t_hp[0]) as u64)
    n = kgsvc.pulse_num(state, p, n, usb.hubports(state))
    n = kgsvc.pulse_text(state, p, n, (&t_fa[0]) as u64)
    n = kgsvc.pulse_num(state, p, n, usb.fails(state))
    ub_line(state, tw, p, n)

    var t_p: [u8; 4] = " P\0\0"
    var t_c: [u8; 6] = " ccs=\0"
    var t_e: [u8; 5] = " en=\0"
    var t_s: [u8; 5] = " sp=\0"
    var t_r: [u8; 7] = " psc=\0\0"
    let np: u64 = xhci.ports(state)
    var i: u64 = 1
    while i <= np && i < 32 {
        n = kgsvc.pulse_text(state, p, 0, (&t_p[0]) as u64)
        n = kgsvc.pulse_num(state, p, n, i)
        n = kgsvc.pulse_text(state, p, n, (&t_c[0]) as u64)
        n = kgsvc.pulse_num(state, p, n, numeric.yes(xhci.port_connected(state, i)))
        n = kgsvc.pulse_text(state, p, n, (&t_e[0]) as u64)
        n = kgsvc.pulse_num(state, p, n, numeric.yes(xhci.port_enabled(state, i)))
        n = kgsvc.pulse_text(state, p, n, (&t_s[0]) as u64)
        n = kgsvc.pulse_num(state, p, n, xhci.port_speed(state, i))
        n = kgsvc.pulse_text(state, p, n, (&t_r[0]) as u64)
        n = kgsvc.pulse_hexn(state, p, n, xhci.portsc(state, i), 8)
        ub_line(state, tw, p, n)
        i = i + 1
    }

    var t_d: [u8; 4] = " D\0\0"
    var t_at: [u8; 3] = " @\0"
    var t_dot: [u8; 2] = ".\0"
    var t_id: [u8; 5] = " id=\0"
    var t_dc: [u8; 6] = " dev=\0"
    var t_if: [u8; 5] = " if=\0"
    var t_nn: [u8; 4] = " n=\0"
    var t_ff: [u8; 4] = " f=\0"
    var t_dr: [u8; 6] = " drv=\0"
    var t_empty: [u8; 23] = " NOT A SINGLE DEVICE!\0\0"
    let nf: u64 = usb.fund_count(state)
    if nf == 0 {
        n = kgsvc.pulse_text(state, p, 0, (&t_empty[0]) as u64)
        ub_line(state, tw, p, n)
    }
    i = 0
    while i < nf {
        n = kgsvc.pulse_text(state, p, 0, (&t_d[0]) as u64)
        n = kgsvc.pulse_num(state, p, n, i)
        n = kgsvc.pulse_text(state, p, n, (&t_at[0]) as u64)
        n = kgsvc.pulse_num(state, p, n, usb.fund_port(state, i))
        n = kgsvc.pulse_text(state, p, n, (&t_dot[0]) as u64)
        n = kgsvc.pulse_num(state, p, n, usb.fund_hub(state, i))
        n = kgsvc.pulse_text(state, p, n, (&t_s[0]) as u64)
        n = kgsvc.pulse_num(state, p, n, usb.fund_speed(state, i))
        n = kgsvc.pulse_text(state, p, n, (&t_id[0]) as u64)
        n = kgsvc.pulse_hexn(state, p, n, usb.fund_vid(state, i), 4)
        n = kgsvc.pulse_text(state, p, n, (&t_dot[0]) as u64)
        n = kgsvc.pulse_hexn(state, p, n, usb.fund_pid(state, i), 4)
        n = kgsvc.pulse_text(state, p, n, (&t_dc[0]) as u64)
        n = ub_cls(state, p, n, usb.fund_dcls(state, i),
            usb.fund_dsub(state, i), usb.fund_dpro(state, i))
        n = kgsvc.pulse_text(state, p, n, (&t_if[0]) as u64)
        n = ub_cls(state, p, n, usb.fund_icls(state, i),
            usb.fund_isub(state, i), usb.fund_ipro(state, i))
        n = kgsvc.pulse_text(state, p, n, (&t_nn[0]) as u64)
        n = kgsvc.pulse_num(state, p, n, usb.fund_ifaces(state, i))
        n = kgsvc.pulse_text(state, p, n, (&t_ff[0]) as u64)
        n = kgsvc.pulse_num(state, p, n, usb.fund_flags(state, i))
        n = kgsvc.pulse_text(state, p, n, (&t_dr[0]) as u64)
        n = kgsvc.pulse_num(state, p, n, usb.fund_driver(state, i))
        ub_line(state, tw, p, n)
        i = i + 1
    }
}

fn pb_dec(state: u64, v: u64) {
    var t: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        t[0 as usize] = 48 as u8
        n = 1
    }
    while x > 0 {
        t[n as usize] = (48 + (x % 10)) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        fb.putc(state, t[(n - 1) as usize] as u64)
        n = n - 1
    }
}

fn pb_hex(state: u64, v: u64, w: u64) {
    fb.putc(state, 48)
    fb.putc(state, 120)
    var i: u64 = w
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * 4)) & 15
        if d < 10 {
            fb.putc(state, 48 + d)
        } else {
            fb.putc(state, 87 + d)
        }
    }
}

fn pb_str(state: u64, p: u64) {
    if p == 0 {
        return
    }
    fb.puts(state, p)
}

fn pb_addr(state: u64, a: u64) {
    var s_plus: [u8; 2] = "+\0"
    var s_ob: [u8; 3] = " (\0"
    var s_co: [u8; 2] = ":\0"
    var s_cb: [u8; 2] = ")\0"
    let i: u64 = ksymtab.resolve(a)
    if i >= ksymtab.n_sym() {
        pb_hex(state, a, 16)
        return
    }
    pb_str(state, ksymtab.sym_name(i))
    pb_str(state, (&s_plus[0 as usize]) as u64)
    pb_hex(state, a - ksymtab.sym_addr(i), 4)
    let pk: u64 = ksymtab.line_of(a)
    if pk == 0 {
        return
    }
    let f: u64 = ksymtab.file_name(ksymtab.line_file(pk))
    if f == 0 {
        return
    }
    pb_str(state, (&s_ob[0 as usize]) as u64)
    pb_str(state, f)
    pb_str(state, (&s_co[0 as usize]) as u64)
    pb_dec(state, ksymtab.line_nr(pk))
    pb_str(state, (&s_cb[0 as usize]) as u64)
}

fn panikbild(state: u64, vec: u64, err: u64, rip: u64, cr2: u64,
        rsp: u64, cs: u64, flg: u64, ss: u64, kern: u64, regs: u64,
        trace: u64, spurn: u64, cur_file: u64) {
    var names: [u8; 128] = "#DE\0#DB\0NMI\0#BP\0#OF\0#BR\0#UD\0#NM\0#DF\0#CO\0#TS\0#NP\0#SS\0#GP\0#PF\0r15\0#MF\0#AC\0#MC\0#XM\0#VE\0#CP\0r22\0r23\0r24\0r25\0r26\0#HV\0#VC\0#SX\0r30\0r31\0"
    var rnamen: [u8; 64] = "rax\0rbx\0rcx\0rdx\0rsi\0rdi\0rbp\0rsp\0r8 \0r9 \0r10\0r11\0r12\0r13\0r14\0r15\0"
    var s_head: [u8; 27] = "*** OSUM  KERNEL-PANIK ***\0"
    var s_vek: [u8; 8] = "  VEK \0\0"
    var s_err: [u8; 8] = "  ERR \0\0"
    var s_krn: [u8; 9] = "  KERN \0\0"
    var s_rip: [u8; 6] = "RIP \0\0"
    var s_cr2: [u8; 8] = "  CR2 \0\0"
    var s_cs: [u8; 7] = "  CS \0\0"
    var s_flg: [u8; 8] = "  FLG \0\0"
    var s_rsp: [u8; 7] = "RSP \0\0\0"
    var s_ss: [u8; 7] = "  SS \0\0"
    var s_trace: [u8; 15] = "-- RUECKSPUR\0\0\0"
    var s_prot: [u8; 15] = "-- PROTOKOLL\0\0\0"
    var s_ber: [u8; 12] = "-- BERICHT\0\0"
    var s_kb: [u8; 10] = "-- (none)\0"
    var s_ab: [u8; 20] = "  ... abgeschnitten\0"
    var s_photo: [u8; 41] = "*** PLEASE PHOTOGRAPH -- machine halted\0\0"
    var s_sp: [u8; 3] = "  \0"
    var s_gl: [u8; 2] = "=\0"

    if !fb.ready(state) {
        return
    }
    let rot: u64 = fb.rgb(state, 128, 0, 0)
    let weiss: u64 = fb.rgb(state, 255, 255, 255)
    let gelb: u64 = fb.rgb(state, 255, 220, 80)
    fb.clear(state, rot)
    fb.set_color(state, weiss, rot)
    fb.home(state)

    pb_str(state, (&s_head[0 as usize]) as u64)
    pb_str(state, (&s_vek[0 as usize]) as u64)
    pb_dec(state, vec)
    fb.putc(state, 32)
    if vec < 32 {
        pb_str(state, (&names[0 as usize]) as u64 + vec * 4)
    }
    pb_str(state, (&s_err[0 as usize]) as u64)
    pb_hex(state, err, 8)
    pb_str(state, (&s_krn[0 as usize]) as u64)
    pb_dec(state, kern)
    fb.nl(state)
    pb_str(state, version.text())
    fb.nl(state)

    pb_str(state, (&s_rip[0 as usize]) as u64)
    pb_addr(state, rip)
    fb.nl(state)
    pb_str(state, (&s_rsp[0 as usize]) as u64)
    pb_hex(state, rsp, 16)
    pb_str(state, (&s_cs[0 as usize]) as u64)
    pb_hex(state, cs, 4)
    pb_str(state, (&s_ss[0 as usize]) as u64)
    pb_hex(state, ss, 4)
    pb_str(state, (&s_flg[0 as usize]) as u64)
    pb_hex(state, flg, 8)
    if vec == 14 {
        pb_str(state, (&s_cr2[0 as usize]) as u64)
        pb_hex(state, cr2, 16)
    }
    fb.nl(state)

    var i: u64 = 0
    while i < 16 {
        pb_str(state, (&rnamen[0 as usize]) as u64 + i * 4)
        pb_str(state, (&s_gl[0 as usize]) as u64)
        pb_hex(state, __mmio_read64((regs + i * 8) as *mut u64), 16)
        if i % 4 == 3 {
            fb.nl(state)
        } else {
            pb_str(state, (&s_sp[0 as usize]) as u64)
        }
        i = i + 1
    }

    fb.set_color(state, gelb, rot)
    pb_str(state, (&s_trace[0 as usize]) as u64)
    fb.nl(state)
    fb.set_color(state, weiss, rot)
    if spurn == 0 {
        pb_str(state, (&s_kb[0 as usize]) as u64)
        fb.nl(state)
    }
    i = 0
    while i < spurn {
        pb_str(state, (&s_sp[0 as usize]) as u64)
        pb_addr(state, __mmio_read64((trace + i * 8) as *mut u64))
        fb.nl(state)
        i = i + 1
    }

    fb.set_color(state, gelb, rot)
    pb_str(state, (&s_prot[0 as usize]) as u64)
    fb.nl(state)
    fb.set_color(state, weiss, rot)
    let rows: u64 = fb.rows(state)
    var free: u64 = 0
    if rows > fb.cy(state) + 3 {
        free = rows - fb.cy(state) - 3
    }
    let last: u64 = klog.seq(state)
    var von: u64 = 1
    if last > free {
        von = last - free + 1
    }
    if von < klog.first_seq(state) {
        von = klog.first_seq(state)
    }
    if last > 0 && last >= von {
        if von > klog.first_seq(state) {
            pb_str(state, (&s_ab[0 as usize]) as u64)
            fb.nl(state)
        }
        var b: [u8; 200] = [0 as u8; 200]
        var sq: u64 = von
        while sq <= last {
            let n: u64 = klog.line_at(state, sq,
                (&b[0 as usize]) as u64, 199)
            if n > 1 {
                fb.text(state, (&b[0 as usize]) as u64, n - 1)
                fb.nl(state)
            }
            sq = sq + 1
        }
    }

    fb.set_color(state, gelb, rot)
    pb_str(state, (&s_ber[0 as usize]) as u64)
    fb.putc(state, 32)
    if cur_file != 0 {
        pb_str(state, cur_file)
    } else {
        pb_str(state, (&s_kb[0 as usize]) as u64)
    }
    fb.nl(state)
    pb_str(state, (&s_photo[0 as usize]) as u64)
    fb.nl(state)
    fb.flush(state)
}

fn speicherdruck_gui(state: u64) {
    if !kstate.mode_on(state, kstate.M_MEMHOG)
        && !kstate.mode_on(state, kstate.M_MEMHOGN) {
        return
    }
    var s_beg: [u8; 26] = "speicherdruck: gui start\n\0"
    var s_free: [u8; 21] = "speicherdruck: frei=\0"
    serial.puts((&s_beg[0]) as u64)
    serial.puts((&s_free[0]) as u64)
    serial.dec(mmframe.frames_free(state))
    serial.nl()
    let a: u64 = proc.create(state, P_HOG, 1, 2)
    if kstate.mode_on(state, kstate.M_MEMHOGN) {
        let b: u64 = proc.create(state, P_HOG, 2, 2)
        let c: u64 = proc.create(state, P_HOG, 3, 2)
    }
}
