fn say_max(state: u64) {
    var s_a: [u8; 16] = "wm: max win=\0\0\0\0"
    var s_b: [u8; 6] = " ok=\0\0"
    var s_c: [u8; 6] = " wx=\0\0"
    var s_d: [u8; 6] = " wy=\0\0"
    var s_e: [u8; 6] = " ww=\0\0"
    var s_f: [u8; 6] = " wh=\0\0"
    var s_t: [u8; 10] = "Maximized\0"

    let i: u64 = wmcore.create(state, 0, 0, 0, wmgeom.max_w(state),
        wmgeom.max_h(state), wmlayout.K_RAW,
        (&s_t[0]) as u64)
    if i >= wm.MAX_WIN {
        return
    }
    wmdraw.fill(state, i, 0, 0, wmgeom.max_w(state), wmgeom.max_h(state),
        fb.rgb(state, 0x24, 0x50, 0x30))
    let ok: bool = wmworkarea.maximize(state, i, true)
    wmbase.damage_all(state)
    wmcompose.compose(state)
    serial.puts((&s_a[0]) as u64)
    serial.dec(i)
    serial.puts((&s_b[0]) as u64)
    serial.dec(numeric.yes(ok))
    serial.puts((&s_c[0]) as u64)
    serial.dec(wmworkarea.work_x(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(wmworkarea.work_y(state))
    serial.puts((&s_e[0]) as u64)
    serial.dec(wmworkarea.work_w(state))
    serial.puts((&s_f[0]) as u64)
    serial.dec(wmworkarea.work_h(state))
    serial.nl()
}

fn say_wins(state: u64) {
    var s_a: [u8; 12] = "wm: win nr=\0"
    var s_b: [u8; 6] = " id=\0\0"
    var s_c: [u8; 5] = " z=\0\0"
    var s_d: [u8; 9] = " layer=\0\0"
    var s_e: [u8; 10] = " hidden=\0\0"
    var s_f: [u8; 8] = " deco=\0\0"
    var s_g: [u8; 5] = " x=\0\0"
    var s_h: [u8; 5] = " y=\0\0"
    var s_i: [u8; 5] = " w=\0\0"
    var s_j: [u8; 5] = " h=\0\0"
    var s_k: [u8; 9] = " focus=\0\0"
    var s_l: [u8; 6] = " t=[\0\0"
    var s_m: [u8; 4] = "]\0\0\0"
    var s_n: [u8; 16] = "wm: wins n=\0\0\0\0\0"
    var s_o: [u8; 10] = " hides=\0\0\0"
    var s_p: [u8; 10] = " shows=\0\0\0"
    var s_q: [u8; 12] = " nolayer=\0\0\0"
    var s_r: [u8; 10] = " nomin=\0\0\0"
    var s_s1: [u8; 8] = " strut=\0"
    var s_s2: [u8; 12] = " strutedge=\0"
    var s_s3: [u8; 6] = " max=\0"
    var s_s4: [u8; 6] = " ow=\0\0"
    var s_s5: [u8; 6] = " oh=\0\0"
    var s_w1: [u8; 16] = "wm: work x=\0\0\0\0\0"
    var i: u64 = 0
    while i < wm.MAX_WIN {
        if wmbase.valid(state, i) {
            serial.puts((&s_a[0]) as u64)
            serial.dec(i)
            serial.puts((&s_b[0]) as u64)
            serial.dec(wm.win_id(state, i))
            serial.puts((&s_c[0]) as u64)
            serial.dec(wmblur.win_z(state, i))
            serial.puts((&s_d[0]) as u64)
            serial.dec(tiling.win_layer(state, i))
            serial.puts((&s_e[0]) as u64)
            serial.dec(numeric.yes(wmcompose.win_hidden(state, i)))
            serial.puts((&s_f[0]) as u64)
            serial.dec(numeric.yes(wmcore.win_deco(state, i)))
            serial.puts((&s_g[0]) as u64)
            serial.dec(wmbase.win_x(state, i) as u64)
            serial.puts((&s_h[0]) as u64)
            serial.dec(wmbase.win_y(state, i) as u64)
            serial.puts((&s_i[0]) as u64)
            serial.dec(wmblur.win_w(state, i))
            serial.puts((&s_j[0]) as u64)
            serial.dec(wmblur.win_h(state, i))
            serial.puts((&s_k[0]) as u64)
            serial.dec(numeric.yes(wmbase.focus(state) == i))
            serial.puts((&s_s1[0]) as u64)
            serial.dec(wmworkarea.win_strut_size(state, i))
            serial.puts((&s_s2[0]) as u64)
            serial.dec(wmworkarea.win_strut_edge(state, i))
            serial.puts((&s_s3[0]) as u64)
            serial.dec(numeric.yes(wmworkarea.is_max(state, i)))
            serial.puts((&s_s4[0]) as u64)
            serial.dec(wmbase.outer_w(state, i))
            serial.puts((&s_s5[0]) as u64)
            serial.dec(wmbase.outer_h(state, i))
            serial.puts((&s_l[0]) as u64)
            serial.puts(wm.win_title(state, i))
            serial.puts((&s_m[0]) as u64)
            serial.nl()
        }
        i = i + 1
    }
    serial.puts((&s_n[0]) as u64)
    serial.dec(wmcore.count(state))
    serial.puts((&s_o[0]) as u64)
    serial.dec(wm.hides(state))
    serial.puts((&s_p[0]) as u64)
    serial.dec(wm.shows(state))
    serial.puts((&s_q[0]) as u64)
    serial.dec(numeric.yes(wm.nolayer(state)))
    serial.puts((&s_r[0]) as u64)
    serial.dec(numeric.yes(wm.nomin(state)))
    serial.nl()

    serial.puts((&s_w1[0]) as u64)
    serial.dec(wmworkarea.work_x(state))
    serial.puts((&s_h[0]) as u64)
    serial.dec(wmworkarea.work_y(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(wmworkarea.work_w(state))
    serial.puts((&s_j[0]) as u64)
    serial.dec(wmworkarea.work_h(state))
    serial.puts((&s_q[0]) as u64)
    serial.dec(numeric.yes(wmworkarea.nostrut(state)))
    serial.nl()
}

static mut vgpu_ereig_getan: u64 = 0

