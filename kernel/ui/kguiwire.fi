profile kernel

import gfx.kguihook
import ui.kgui

export { install }

fn install(state: u64) {
    kguihook.bind_ui(kguihook.H_STAGE_GRAPHICS, kgui.stage_graphics as u64)
    kguihook.bind_ui(kguihook.H_STAGE_SURFACE, kgui.stage_surface as u64)
    kguihook.bind_ui(kguihook.H_STAGE_HOLD, kgui.stage_hold as u64)
    kguihook.bind_ui(kguihook.H_BOARD_TICK, kgui.board_tick as u64)
    kguihook.bind_ui(kguihook.H_BEAT_TICK, kgui.beat_tick as u64)
    kguihook.bind_ui(kguihook.H_STALL_TICK, kgui.stall_tick as u64)
    kguihook.bind_ui(kguihook.H_LESER_TICK, kgui.leser_tick as u64)
    kguihook.bind_ui(kguihook.H_WM_ON_KEY, kgui.wm_on_key as u64)
    kguihook.bind_ui(kguihook.H_WM_POLL, kgui.wm_poll as u64)
    kguihook.bind_ui(kguihook.H_CRASH, kgui.crash as u64)
    kguihook.bind_ui(kguihook.H_GRACE_READY, kgui.grace_ready as u64)
    kguihook.bind_ui(kguihook.H_GRACE_SOLL, kgui.grace_soll as u64)
    kguihook.bind_ui(kguihook.H_GRACE_CORE, kgui.grace_core as u64)
    kguihook.bind_ui(kguihook.H_GRACE_COLD, kgui.grace_cold as u64)
    kguihook.bind_ui(kguihook.H_PARSE, kgui.parse as u64)
    kguihook.bind_ui(kguihook.H_PANIKBILD, kgui.panikbild as u64)
}
