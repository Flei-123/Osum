import netdev
import block.part
import inet
import pwr.pmon
import sched.proc
import drv.hid.ps2m
import pwr.pwr
import sched.sched
import serial
import sched.signal
import ui.tile
import ui.wmplug
import drv.gpu.vgpu
import gfx.gfx
import sched.time
import arch.x86_64.trap
import gfx.ttf
import drv.con.tty
import usb.usb
import fs.vfs
// RUNDE HOTPLUG: die Naht zwischen Blockgeraet und Einhaengung.
import block.wechsel
import gfx.vmode
import ui.wig
import ui.wm
import lib.version
// RUNDE MARKE: der Produktname kommt aus EINER Quelle.
import lib.brand
import drv.usb.xhci
import lib.kutil
import klog
import lib.ksymtab

export {
    stage_graphics, stage_surface, stage_hold, tafel_tick, beat_tick,
    leser_tick,
    // RUNDE BLECHFUENF: die Absturzanzeige. `trap.report` ruft sie.
    absturz,
    // RUNDE GLYPHE: die drei Tueren des Zeichen-Nachweises.
    grace_ready, grace_soll, grace_core, grace_cold,
    // RUNDE BLECH2: `mausflut=<hz>` aus der Kommandozeile (gfx.parse).
    parse,
    // RUNDE PROTOKOLL: der GANZE Schirm, direkt auf den Rahmenpuffer.
    panikbild
}

const P_FB: u64 = 13
const P_WCLICK: u64 = 14
const GFX_RUNDEN: u64 = 5 // Wiederholungen je Messwert
const DISP_RUNDEN: u64 = 5
const PX_X: u64 = 120
const PX_Y: u64 = 120
const PX_COLOR: u64 = 13132850 // 0xC86432 = 200,100,50
const WM_ARENA_FRAMES: u64 = 128 // 512 KiB, ttf.ARENA_BYTES
const K10_RUNDEN: u64 = 20
const I18N_LINES: u64 = 1000
const TILE_RUNDEN: u64 = 1000

// ---------------------------------------------------------- die Tueren
//
// Vier Einstiege, und mehr weiss `kernel_main` von der Oberflaeche
// nicht. Sie heissen wie die Funktionen, die frueher an dieser Stelle
// standen, damit ein `git log -L` sie weiter findet.

fn stage_graphics(state: u64, mbi: u64) {
    graphics(state, mbi)
}


fn stage_surface(state: u64) {
    surface(state)
}

fn stage_hold(state: u64) {
    gfx_hold(state)
}


// Wie oft jede Messung wiederholt wird.
const PAINT_RUNDEN: u64 = 4

// RUNDE MERGE-2: DIESE FUNKTION IST BEIM VERSCHMELZEN FAST VERLOREN
// GEGANGEN. Sie stand in kmain.fi mitten in einem Block, den
// serverbuild als Ganzes nach kgui.fi gezogen hat -- aber sie ist
// NEUER als der Abzweig (Runde PAINT) und stand deshalb in keiner der
// beiden Fassungen des Umzugsguts. Wer beim Konflikt die Seite von
// serverbuild nimmt, verliert sie lautlos: kein Konflikt, keine
// Meldung, nur ein Ruf ins Leere. Aufgefallen ist sie dem Uebersetzer
// ("unknown function 'paint_bench'"), und danach hat
// /root/verlust_pruefen.py alle 295 Funktionen von vorher gegen die 343
// von nachher gehalten: sie war die einzige.
//
// Sie steht jetzt hier und nicht mehr in kmain.fi, weil ihr einziger
// Rufer `graphics` hier steht und weil sie misst, was die Oberflaeche
// tut -- bei gui=off gibt es beides nicht.
fn paint_bench(state: u64) {
    var s_h: [u8; 22] = "        paintbench: \0\0"
    var s_x: [u8; 2] = "x\0"
    var s_fi: [u8; 9] = "  fill=\0\0"
    var s_fa: [u8; 11] = "  fill_a=\0\0"
    var s_cy: [u8; 5] = " cyc\0"
    var s_pp: [u8; 12] = "  je-px=\0\0\0\0"
    var s_pa: [u8; 8] = " / \0\0\0\0\0"
    var s_ra: [u8; 12] = "  faktor=\0\0\0"
    var s_pm: [u8; 8] = "/1000\0\0\0"
    var s_bl: [u8; 11] = "  blends=\0\0"
    var s_rd: [u8; 10] = "  reads=\0\0"
    var s_sk: [u8; 10] = "  skips=\0\0"
    var s_db: [u8; 10] = "  dbl=\0\0\0\0"
    var s_sp: [u8; 12] = "  simd_px=\0\0"
    var s_so: [u8; 12] = "  simd_ok=\0\0"
    var s_fe: [u8; 11] = "  fpu_en=\0\0"

    if apic.tsc_hz(state) == 0 {
        return
    }
    let w: u64 = fb.width(state)
    let h: u64 = fb.height(state)
    if w == 0 || h == 0 {
        return
    }
    let farbe: u64 = fb.rgb(state, 0x20, 0x30, 0x40)
    let ueber: u64 = fb.rgb(state, 0xFF, 0xFF, 0xFF)

    // 1. undurchsichtig
    var t: u64 = apic.tsc()
    var i: u64 = 0
    while i < PAINT_RUNDEN {
        fb.fill(state, 0, 0, w, h, farbe)
        i = i + 1
    }
    let c_fill: u64 = (apic.tsc() -% t) / PAINT_RUNDEN

    // 2. gemischt, mit einer Deckung, die BEIDE Abkuerzungen verfehlt
    //    (a == 128 ist weder 0 noch 255) -- sonst misst man den
    //    schnellen Zweig und nennt ihn Mischung.
    fb.blend_reset(state)
    t = apic.tsc()
    i = 0
    while i < PAINT_RUNDEN {
        fb.fill_a(state, 0, 0, w, h, ueber, 128)
        i = i + 1
    }
    let c_fa: u64 = (apic.tsc() -% t) / PAINT_RUNDEN

    let px: u64 = w * h
    serial.puts((&s_h[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_fi[0]) as u64)
    serial.dec(c_fill)
    serial.puts((&s_cy[0]) as u64)
    serial.puts((&s_fa[0]) as u64)
    serial.dec(c_fa)
    serial.puts((&s_cy[0]) as u64)
    // Takte je Bildpunkt in TAUSENDSTELN, weil beide Wege unter zehn
    // Takten liegen koennen und eine ganze Zahl dort nichts mehr sagt.
    serial.puts((&s_pp[0]) as u64)
    serial.dec(c_fill * 1000 / px)
    serial.puts((&s_pa[0]) as u64)
    serial.dec(c_fa * 1000 / px)
    serial.puts((&s_pm[0]) as u64)
    serial.puts((&s_ra[0]) as u64)
    if c_fill != 0 {
        serial.dec(c_fa * 1000 / c_fill)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_pm[0]) as u64)
    serial.puts((&s_bl[0]) as u64)
    serial.dec(fb.blends(state))
    serial.puts((&s_rd[0]) as u64)
    serial.dec(fb.blend_reads(state))
    serial.puts((&s_sp[0]) as u64)
    serial.dec(fb.simd_px(state))
    serial.puts((&s_so[0]) as u64)
    serial.dec(bnum(fb.simd_ok(state)))
    serial.puts((&s_fe[0]) as u64)
    serial.dec(bnum(fpu.enabled(state)))
    serial.puts((&s_sk[0]) as u64)
    serial.dec(fb.blend_skips(state))
    serial.puts((&s_db[0]) as u64)
    if fb.double_buffered(state) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()

    // DIE ZUSAGEN AUS DEM KERN SELBST, gleich hinter der Messung: die
    // Zahl der gemischten Bildpunkte MUSS die Zahl der Bildpunkte der
    // Flaeche mal der Rundenzahl sein. Waere sie kleiner, haette die
    // Mischung Zeilen uebersprungen und die Messung waere zu gut.
    var s_st: [u8; 24] = "        paint: selftest\0"
    var s_of: [u8; 5] = " of \0"
    var s_ok: [u8; 12] = "  gezaehlt=\0"
    var s_no: [u8; 6] = "  ok\0\0"
    var s_bad: [u8; 9] = "  FALSCH\0"
    // ERST die Zahl ablesen, DANN die Zusagen laufen lassen: `selftest3`
    // mischt selbst und wuerde den Zaehler, ueber den es urteilt,
    // waehrend des Urteils weiterdrehen. Die erste Fassung tat genau das
    // und meldete FALSCH bei vierzehn von vierzehn gehaltenen Zusagen.
    let gemischt: u64 = fb.blends(state)
    serial.puts((&s_st[0]) as u64)
    serial.puts((&s_ok[0]) as u64)
    serial.dec(fb.selftest3(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(fb.selftest3_max())
    if gemischt == px * PAINT_RUNDEN {
        serial.puts((&s_no[0]) as u64)
    } else {
        serial.puts((&s_bad[0]) as u64)
    }
    serial.nl()
    fb.blend_reset(state)
    fb.clear(state, 0)
}

fn graphics(state: u64, mbi: u64) {
    var s_none: [u8; 24] = "fb: kein Rahmenpuffer\0\0\0"
    var s_geo: [u8; 5] = "fb: \0"
    var s_x: [u8; 2] = "x\0"
    var s_bpp: [u8; 4] = "x32\0"
    var s_pitch: [u8; 9] = "  pitch=\0"
    var s_src: [u8; 7] = "  src=\0"
    var s_mb: [u8; 3] = "mb\0"
    var s_vbe: [u8; 4] = "vbe\0"
    var s_phys: [u8; 8] = "  phys=\0"
    var s_win: [u8; 7] = "  win=\0"
    var s_huge: [u8; 8] = "  huge=\0"
    var s_cols: [u8; 8] = "  cols=\0"
    var s_rows: [u8; 8] = "  rows=\0"
    var s_back: [u8; 8] = "  back=\0"
    var s_none2: [u8; 5] = "none\0"
    var s_uc: [u8; 6] = "  uc=\0"
    var s_wc: [u8; 6] = "  wc=\0"
    var s_st: [u8; 14] = "fb: selftest \0"
    var s_of: [u8; 4] = " / \0"
    var s_on: [u8; 31] = "fb: console mirrored to screen\0"

    if !fb.want(state, fb.M_GFX) {
        return
    }
    var w: u64 = fb.WIDTH_STD
    var h: u64 = fb.HEIGHT_STD
    if fb.want(state, fb.M_BIG) {
        w = fb.WIDTH_BIG
        h = fb.HEIGHT_BIG
    }
    // RUNDE SCHIRM -- DIE TAFEL FRAGEN, STATT ZWEI ZAHLEN ZU RATEN.
    //
    // Ohne Lader (qemu -kernel) stellt der Kern den Modus selbst ein, und
    // bis zu dieser Runde nahm er dafuer 800x600 oder, auf ein Wort hin,
    // 1024x768. Auf jeder Tafel, die etwas anderes kann, war das die
    // falsche Zahl -- und zwei Zeilen weiter unten meldete DERSELBE
    // Kern, was die Tafel wirklich ist:
    //
    //     disp: edid ok  nat=1920x1080
    //     fb:   800x600x32
    //
    // Die Reihenfolge ist: die Befehlszeile schlaegt alles, dann der
    // EDID-Block der Tafel, dann die eingebaute Vorgabe.
    var quelle_w: u64 = 0 // 0 = eingebaut, 1 = Befehlszeile, 2 = EDID
    if fb.want(state, fb.M_RES) && fb.res_w(state) != 0 {
        w = fb.res_w(state)
        h = fb.res_h(state)
        quelle_w = 1
    } else {
        let nat: u64 = vmode.native(state)
        if nat != 0 {
            w = nat >> 16
            h = nat & 0xFFFF
            quelle_w = 2
        }
    }
    // RUNDE SCHIRM: die Tafelmeldung SELBST in den Mitschnitt, sonst ist
    // ein Rueckfall auf die Vorgabe nicht von einer fehlenden Tafel zu
    // unterscheiden.
    var s_nat: [u8; 10] = "fb: nat=\0\0"
    var s_natx: [u8; 2] = "x\0"
    var s_why: [u8; 8] = "  why=\0\0"
    serial.puts((&s_nat[0]) as u64)
    serial.dec(vmode.edid_native_w(state))
    serial.puts((&s_natx[0]) as u64)
    serial.dec(vmode.edid_native_h(state))
    serial.puts((&s_why[0]) as u64)
    serial.dec(vmode.edid_why(state))
    serial.nl()
    // Der Zweitpuffer, aus zusammenhaengenden Rahmen. Acht Rahmen mehr
    // als gerechnet: eine Karte darf eine laengere Zeile liefern als
    // Breite mal vier, und ein zu kleiner Zweitpuffer waere ein
    // Schreibzugriff daneben. `fb.init` prueft die Groesse noch einmal
    // und laesst ihn im Zweifel liegen.
    //
    // RUNDE SCHIRM: `fb.need_bytes` statt `w * h * 4`. Unter einem Lader
    // bestimmt der LADER die Aufloesung, und ein Puffer, der fuer 800x600
    // gerechnet wurde, wird bei 1920x1080 stillschweigend verworfen --
    // gemessen als "back=none" in JEDEM Start ueber Limine.
    var back: u64 = 0
    var back_bytes: u64 = 0
    if !fb.want(state, fb.M_NODBL) {
        var noetig: u64 = fb.need_bytes(mbi, w, h)
        if noetig == 0 {
            noetig = w * h * 4
        }
        let rahmen: u64 = (noetig + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE + 8
        back = mem.frame_run(state, rahmen)
        if back != 0 {
            back_bytes = rahmen * mem.FRAME_SIZE
        }
    }
    if !fb.init(state, mbi, w, h, back, back_bytes, fb.want(state, fb.M_UC)) {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    if fb.want(state, fb.M_NOCUR) {
        fb.set_cursor(state, false)
    }

    // RUNDE FEEDBACK (in diesen Zweig geholt von BRIDGE-2): der Schein
    // fuer das Bildschirmfoto. HIER und nicht frueher, weil es ohne
    // Rahmenpuffer nichts zu fotografieren gibt -- und `shot.init`
    // setzt nur Zaehler, es fasst die Karte nicht an. Diese Datei und
    // nicht `kmain.fi` (wo FEEDBACK sie hatte), weil `kgui.fi` bei
    // `gui=off` gar nicht erst uebersetzt wird: ein Kern ohne
    // Oberflaeche soll den Schein auch nicht anlegen.
    // ======================================== RUNDE VIRTIOGPU
    // DEN GRAFIKTREIBER AUFSETZEN -- HIER UND NICHT FRUEHER.
    //
    // `vgpu.init` haengt den ZWEITPUFFER von `fb.fi` als Unterlage an
    // eine Ressource des Geraets. Den Puffer gibt es erst, seit
    // `fb.init` zurueckgekommen ist -- also steht der Aufruf genau
    // hier und keine Zeile hoeher.
    //
    // FINDET ER KEIN GERAET, PASSIERT NICHTS. `init` gibt `false`
    // zurueck, `vgpu.bereit` bleibt falsch, und `fb.flush` nimmt seinen
    // alten Weg. Justins Brett hat kein virtio-gpu; fuer das Brett
    // aendert diese Runde deshalb kein einziges Oktett.
    //
    // `novgpu` ist die GEGENPROBE: derselbe Kern, dasselbe QEMU, nur
    // ohne den neuen Weg. Ohne sie waere jede Messung unten eine
    // Behauptung -- man haette nichts, wogegen man sie haelt.
    if !kstate.mode_on(state, kstate.M_NOVGPU) {
        if vgpu.init(state) {
            fb.set_vgpu(state, true)
        }
    }
    vgpu.say(state)

    shot.init(state)

    // RUNDE BRUECKE: der Schein fuer die eingespeiste Eingabe, aus
    // denselben Gruenden an derselben Stelle. Ohne Fensterserver gibt
    // es keinen Tastaturring, in den etwas hineinkoennte.
    tip.init(state)

    // RUNDE SCHIRM: sagt die Tafel, wie GROSS sie ist, schlaegt das die
    // Regel nach der reinen Bildpunktzahl. Ein 27-Zoll-4K und ein
    // 15-Zoll-4K haben dieselben Bildpunkte und einen Faktor
    // Unterschied in der Groesse eines Buchstabens.
    if fb.res_w(state) == 0 {
        let ds: u64 = vmode.dpi_scale(state, fb.width(state))
        if ds != 0 {
            let _sc: bool = fb.set_uiscale(state, ds)
        }
    }
    // ============================================ RUNDE ECHTHARDWARE-1
    // `uiscale=<n>` SCHLAEGT DAS EDID.
    //
    // Justins Fehler vom 09.09. (Kacheltitel ueber dem Zustandswort,
    // "Ausfuehre" statt "Ausfuehren") treten NUR bei Vervielfachung 2
    // auf, und die kommt aus dem EDID seines Monitors. QEMU liefert
    // kein EDID, also stand im Emulator immer 1 -- und deshalb war
    // KEINER dieser Fehler im Emulator zu sehen, obwohl beide seit
    // Wochen im Baum lagen.
    //
    // Ein Fehler, den der Pruefstand nicht ausloesen kann, ist ein
    // Fehler, der wiederkommt. `kmain` liest das Wort und legt die Zahl
    // ab; hier wird sie angewandt, NACH dem EDID, damit sie es schlaegt.
    let uw: u64 = kstate.get(state, kstate.UISCALE_WUNSCH)
    if uw >= 1 && uw <= 4 {
        let _sw: bool = fb.set_uiscale(state, uw)
    }

    serial.puts((&s_geo[0]) as u64)
    serial.dec(fb.width(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.height(state))
    serial.puts((&s_bpp[0]) as u64)
    serial.puts((&s_pitch[0]) as u64)
    serial.dec(fb.pitch(state))
    serial.puts((&s_src[0]) as u64)
    if fb.source(state) == fb.SRC_MB {
        serial.puts((&s_mb[0]) as u64)
    } else {
        serial.puts((&s_vbe[0]) as u64)
    }
    serial.puts((&s_phys[0]) as u64)
    serial.hex(fb.phys(state))
    serial.puts((&s_win[0]) as u64)
    serial.hex(fb.addr(state))
    serial.puts((&s_huge[0]) as u64)
    serial.dec(fb.huges(state))
    serial.puts((&s_cols[0]) as u64)
    serial.dec(fb.cols(state))
    serial.puts((&s_rows[0]) as u64)
    serial.dec(fb.rows(state))
    serial.puts((&s_back[0]) as u64)
    if fb.back(state) == 0 {
        serial.puts((&s_none2[0]) as u64)
    } else {
        serial.hex(fb.back(state))
    }
    serial.puts((&s_uc[0]) as u64)
    serial.dec(bnum(fb.uncached(state)))
    // RUNDE ZWISCHENSPEICHER: die eine Zahl, die sagt, ob der
    // Rahmenpuffer write-combining abgebildet ist. wc=0 bei uc=0 heisst
    // WRITE-BACK -- und damit landet jede kleine Aenderung im
    // Zwischenspeicher statt auf der Karte.
    serial.puts((&s_wc[0]) as u64)
    serial.dec(fb.wc(state))
    serial.nl()
    // RUNDE SCHIRM: woher die Aufloesung kam, wie gross die Schrift ist
    // und ob der Puffer in Streifen geschoben wird. Drei Zahlen, die
    // vorher nirgends standen und ohne die man den Unterschied zwischen
    // "es geht" und "es geht zufaellig" nicht sieht.
    var s_sc: [u8; 13] = "fb: skala x\0\0"
    var s_src2: [u8; 10] = "  quelle=\0"
    var s_str: [u8; 12] = "  streifen=\0"
    var s_mm: [u8; 7] = "  mm=\0\0"
    serial.puts((&s_sc[0]) as u64)
    serial.dec(fb.uiscale(state))
    serial.puts((&s_src2[0]) as u64)
    serial.dec(quelle_w)
    serial.puts((&s_str[0]) as u64)
    serial.dec(bnum(fb.stripe(state)))
    serial.puts((&s_mm[0]) as u64)
    serial.dec(vmode.edid_mm_w(state))
    serial.nl()

    let n: u64 = fb.selftest(state)
    serial.puts((&s_st[0]) as u64)
    serial.dec(n)
    serial.puts((&s_of[0]) as u64)
    serial.dec(fb.selftest_max())
    var s_fbf: [u8; 11] = "  failed=\0\0"
    serial.puts((&s_fbf[0]) as u64)
    serial.hex(fb.failbits(state))
    serial.nl()

    gfx_bench(state, back)
    paint_bench(state)
    durchsatz(state)

    // RUNDE DISPLAY: die Karte fragen, was sie kann. Hier und nicht
    // frueher, weil `probe` die Fensterplaetze zaehlt, die `fb.init`
    // gerade genommen hat -- und weil es im laufenden Betrieb erkundet,
    // also einen Bildschirm braucht, den es hinterher wieder so
    // hinstellen kann, wie es ihn vorgefunden hat.
    vmode_stage(state)

    // ============================================ RUNDE BLECHDREI
    // DAS BAND WIRD HIER RESERVIERT, VOR DEM ERSTEN ZEICHEN.
    //
    // Justin: "ich muss ganz schnell sein mit dem Foto machen, weil
    // kurz darauf der Schreibtisch startet und alles ueberschreibt."
    // Ab hier gehoeren die obersten Bildzeilen der Messtafel, und
    // NIEMAND kommt mehr hinein -- weder das Boot-Protokoll (es faengt
    // gleich darunter an, `fb.set_band` setzt die Schreibmarke), noch
    // der Fensterserver, noch die Taskleiste, noch Ring 3. Gesperrt
    // wird in `fb.pixel`/`hline`/`blit`/`glyph` und in `wm.fb_row`.
    //
    // `notafel` laesst es wie vorher. Ohne `tafel` gibt es auch nichts
    // zu schuetzen.
    if kstate.mode_on(state, kstate.M_TAFEL)
        && !kstate.mode_on(state, kstate.M_NOTAFEL) {
        let hoehe: u64 = wm.messhoehe(state, BOARD_LINES)
        let gesetzt: bool = fb.set_band(state, hoehe)
        var s_bd: [u8; 12] = "fb: band=\0\0\0"
        var s_bk: [u8; 7] = "  kol=\0"
        serial.puts((&s_bd[0]) as u64)
        serial.dec(fb.band(state))
        serial.puts((&s_bk[0]) as u64)
        serial.dec(wm.mess_kol(state))
        serial.put(32 as u8)
        serial.dec(bnum(gesetzt))
        serial.nl()
    }

    // Und JETZT der Spiegel: ab hier geht jedes Oktett, das ueber
    // `serial.put` laeuft, auch auf den Bildschirm.
    fb.clear(state, 0)
    fb.home(state)
    fb.set_echo(state, true)
    serial.puts((&s_on[0]) as u64)
    serial.nl()
}

fn bnum(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

//
// Was hier steht, ist NUR die Reihenfolge und die Meldung. Die Sache
// selbst steht in `kernel/vmode.fi` (Liste, Wechsel, Frist, Tabelle) und
// in `kernel/fb.fi` (Abbildung, Drehung, Skalierung). Wie ueberall in
// diesem Kernel gilt: was gemeldet wird, ist gemessen -- die Liste ist
// die, die die Karte angenommen hat, und nicht die, nach der gefragt
// wurde.
fn vmode_stage(state: u64) {
    var s_no: [u8; 22] = "disp: keine Karte\0\0\0\0\0"
    var s_hd: [u8; 12] = "disp: vram=\0"
    var s_kib: [u8; 5] = " KiB\0"
    var s_dep: [u8; 10] = "  depths=\0"
    var s_lim: [u8; 12] = "  maplimit=\0"
    var s_pr: [u8; 10] = "  probed=\0"
    var s_rf: [u8; 11] = "  refused=\0"
    var s_tb: [u8; 10] = "  toobig=\0"
    var s_um: [u8; 15] = "  unmappable=\0\0"
    var s_md: [u8; 13] = "disp: modes \0"
    var s_out: [u8; 13] = "disp: out   \0"
    var s_why2: [u8; 10] = "  reason=\0"
    var s_one: [u8; 9] = "disp:   \0"
    var s_x: [u8; 2] = "x\0"
    var s_at: [u8; 3] = "x \0"
    var s_ed: [u8; 12] = "disp: edid \0"
    var s_yes: [u8; 4] = "ok\0\0"
    var s_why: [u8; 5] = "why=\0"
    var s_nat: [u8; 8] = "  nat=\0\0"
    var s_ven: [u8; 8] = "  ven=\0\0"
    var s_mod: [u8; 8] = "  mod=\0\0"
    var s_st: [u8; 16] = "disp: selftest \0"
    var s_of: [u8; 4] = " / \0"
    var s_st2: [u8; 15] = "fb: selftest2 \0"
    var s_geo: [u8; 12] = "disp: geom \0"
    var s_gp: [u8; 9] = "  pitch=\0"
    var s_gt: [u8; 9] = "  panel=\0"
    var s_gq: [u8; 10] = "  ppitch=\0"
    var s_gr: [u8; 7] = "  rot=\0"
    var s_gs: [u8; 9] = "  scale=\0"
    var s_gl: [u8; 7] = "  lut=\0"
    var s_gv: [u8; 7] = "  sat=\0"
    var s_gd: [u8; 12] = "  drawback=\0"
    var s_raw: [u8; 12] = "disp: edid \0"

    if !vmode.want(state, vmode.M_DISP) {
        return
    }
    let n: u64 = vmode.probe(state)
    if n == 0 && !vmode.ready(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_hd[0]) as u64)
    serial.dec(vmode.vram(state) / 1024)
    serial.puts((&s_kib[0]) as u64)
    serial.puts((&s_dep[0]) as u64)
    serial.hex(vmode.depths(state))
    serial.puts((&s_lim[0]) as u64)
    serial.dec(vmode.map_limit(state))
    serial.puts((&s_pr[0]) as u64)
    serial.dec(vmode.probed(state))
    serial.puts((&s_rf[0]) as u64)
    serial.dec(vmode.refused(state))
    serial.puts((&s_tb[0]) as u64)
    serial.dec(vmode.toobig(state))
    serial.puts((&s_um[0]) as u64)
    serial.dec(vmode.probed(state) - vmode.refused(state)
        - vmode.toobig(state) - n)
    serial.nl()
    serial.puts((&s_md[0]) as u64)
    serial.dec(n)
    serial.nl()
    var i: u64 = 0
    while i < n {
        serial.puts((&s_one[0]) as u64)
        serial.dec(vmode.mode_w(state, i))
        serial.puts((&s_x[0]) as u64)
        serial.dec(vmode.mode_h(state, i))
        serial.puts((&s_at[0]) as u64)
        serial.dec(vmode.mode_bpp(state, i))
        serial.nl()
        i = i + 1
    }
    // UND DIE ANDERE SEITE DER LISTE: was NICHT aufgenommen wurde und
    // warum. Eine Liste ohne ihre Ausschluesse ist eine Behauptung --
    // man sieht ihr nicht an, ob gefragt und abgelehnt oder gar nicht
    // erst gefragt wurde.
    i = 0
    while i < vmode.cand_count() {
        let grund: u64 = vmode.cand_why(state, i)
        if grund != 0 {
            serial.puts((&s_out[0]) as u64)
            serial.dec(vmode.cand_w(i))
            serial.puts((&s_x[0]) as u64)
            serial.dec(vmode.cand_h(i))
            serial.puts((&s_why2[0]) as u64)
            serial.dec(grund)
            serial.nl()
        }
        i = i + 1
    }
    serial.puts((&s_ed[0]) as u64)
    if vmode.edid_ok(state) {
        serial.puts((&s_yes[0]) as u64)
        serial.puts((&s_nat[0]) as u64)
        serial.dec(vmode.edid_native_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(vmode.edid_native_h(state))
        serial.puts((&s_ven[0]) as u64)
        i = 0
        while i < 3 {
            serial.put(vmode.vendor_at(state, i) as u8)
            i = i + 1
        }
        serial.puts((&s_mod[0]) as u64)
        i = 0
        while i < 13 {
            let c: u64 = vmode.model_at(state, i)
            if c >= 32 && c < 127 {
                serial.put(c as u8)
            }
            i = i + 1
        }
    } else {
        serial.puts((&s_why[0]) as u64)
        serial.dec(vmode.edid_why(state))
    }
    serial.nl()
    if vmode.want(state, vmode.M_EDID) {
        serial.puts((&s_raw[0]) as u64)
        // MIT TRENNER, und das ist eine gemessene Berichtigung: ohne
        // ihn stand da `0x00xff0xff...`, und ein Leser draussen kann
        // "0x0" gefolgt von "0xff" nicht von "0x00" gefolgt von "xff"
        // unterscheiden. Der Pruefer draussen zaehlte 64 Oktette statt
        // 128 und meldete den EDID-Block als kaputt, obwohl er in
        // Ordnung war.
        var s_sp: [u8; 2] = " \0"
        i = 0
        while i < vmode.edid_bytes() {
            serial.hex(vmode.edid_at(state, i))
            serial.puts((&s_sp[0]) as u64)
            i = i + 1
        }
        serial.nl()
    }
    serial.puts((&s_st[0]) as u64)
    serial.dec(vmode.selftest(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(vmode.selftest_max())
    serial.nl()
    // RUNDE CUSTOMRES: DIE FENSTERPLAETZE ALS ZAHL UND NICHT ALS SATZ.
    // `maplimit` sagt, wieviel geht; diese Zeile sagt, WARUM nicht mehr
    // geht. Sechzehn Plaetze zu 2 MiB sind 32 MiB (WIN_SLOTS seit
    // Commit 758c3c6, kernel/fb.fi:574 -- vorher acht), und davon
    // bleiben nicht alle uebrig: der lokale APIC und der I/O-APIC
    // halten je einen fuer vier Kilooktett Register.
    // Das ist keine Rechnung aus dem Quelltext, sondern die Belegung,
    // wie sie beim Start wirklich dasteht. `belegt` zaehlt ALLE
    // eingetragenen Plaetze -- der Rahmenpuffer gehoert dazu; wer die
    // zwei APIC-Plaetze allein sehen will, zieht die Kacheln des
    // Rahmenpuffers ab.
    var s_ka: [u8; 20] = "disp: kacheln alle=\0"
    var s_ka2: [u8; 8] = "  frei=\0"
    var s_ka3: [u8; 10] = "  belegt=\0"
    var s_ka4: [u8; 6] = "  fb=\0"
    var s_ka5: [u8; 11] = "  laufmax=\0"
    serial.puts((&s_ka[0]) as u64)
    serial.dec(fb.win_slots())
    serial.puts((&s_ka2[0]) as u64)
    serial.dec(fb.free_slots(state))
    serial.puts((&s_ka3[0]) as u64)
    serial.dec(apic.window_slots(state))
    serial.puts((&s_ka4[0]) as u64)
    serial.dec(fb.slot0(state))
    serial.puts((&s_ka5[0]) as u64)
    serial.dec(fb.longest_run(state))
    serial.nl()

    // RUNDE CUSTOMRES: eine EIGENE Zahl und nicht die fuenfzehn von
    // oben. Der Grund steht bei `vmode.selftest_custom`: eine bestehende
    // Zusage zu erhoehen, um eine neue unterzubringen, waere die
    // bequeme Art, eine alte anzufassen.
    var s_stc: [u8; 23] = "disp: custom selftest \0"
    serial.puts((&s_stc[0]) as u64)
    serial.dec(vmode.selftest_custom(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(vmode.selftest_custom_max())
    serial.nl()
    serial.puts((&s_st2[0]) as u64)
    serial.dec(fb.selftest2(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(fb.selftest2_max())
    serial.nl()
    // NACH den Zusagen die Geometrie noch einmal ausgeben. Die Zusagen
    // stellen Drehung, Tabelle und Bildgroesse um und wieder zurueck;
    // ob sie das VOLLSTAENDIG tun, sieht man nur an diesen Zahlen --
    // und die erste Fassung tat es nicht (siehe docs/DISPLAY.md).
    serial.puts((&s_geo[0]) as u64)
    serial.dec(fb.width(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.height(state))
    serial.puts((&s_gp[0]) as u64)
    serial.dec(fb.pitch(state))
    serial.puts((&s_gt[0]) as u64)
    serial.dec(fb.panel_w(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.panel_h(state))
    serial.puts((&s_gq[0]) as u64)
    serial.dec(fb.panel_pitch(state))
    serial.puts((&s_gr[0]) as u64)
    serial.dec(fb.rotation(state))
    serial.puts((&s_gs[0]) as u64)
    serial.dec(fb.scale(state))
    serial.puts((&s_gl[0]) as u64)
    serial.dec(fb.lut(state))
    serial.puts((&s_gv[0]) as u64)
    serial.dec(fb.saturation(state))
    serial.puts((&s_gd[0]) as u64)
    serial.dec(bnum(fb.draw_at(state) == fb.back(state)))
    serial.nl()
}

// Der Wechsel im laufenden Betrieb, kurz vor dem Stillhalten -- damit
// das Bildschirmfoto das Ergebnis zeigt und nicht das, was die Konsole
// danach darueber gerollt hat.
fn display_hold(state: u64) {
    var s_sw: [u8; 14] = "disp: switch \0"
    var s_x: [u8; 2] = "x\0"
    var s_arr: [u8; 5] = " -> \0"
    var s_rc: [u8; 5] = " rc=\0"
    var s_us: [u8; 5] = " us=\0"
    var s_now: [u8; 8] = " panel=\0"
    var s_cnt: [u8; 12] = "disp: sw=\0\0\0"
    var s_fl: [u8; 9] = "  fail=\0\0"
    var s_rv: [u8; 8] = "  rev=\0\0"
    var s_rot: [u8; 12] = "disp: rot=\0\0"
    var s_img: [u8; 8] = "  img=\0\0"
    var s_cf: [u8; 20] = "disp: confirm pend=\0"
    var s_left: [u8; 8] = " left=\0\0"
    var s_rr: [u8; 9] = " after=\0\0"

    if !vmode.ready(state) {
        return
    }
    if vmode.want(state, vmode.M_BIG) {
        disp_switch(state, 1024, 768, (&s_sw[0]) as u64, (&s_x[0]) as u64,
            (&s_arr[0]) as u64, (&s_rc[0]) as u64, (&s_us[0]) as u64,
            (&s_now[0]) as u64)
    }
    if vmode.want(state, vmode.M_BACK) {
        disp_switch(state, 800, 600, (&s_sw[0]) as u64, (&s_x[0]) as u64,
            (&s_arr[0]) as u64, (&s_rc[0]) as u64, (&s_us[0]) as u64,
            (&s_now[0]) as u64)
    }
    if vmode.want(state, vmode.M_BAD) {
        // 4096x4096 steht in keiner Liste und passt in keinen
        // Bildspeicher. Danach MUSS derselbe Bildschirm dastehen.
        disp_switch(state, 4096, 4096, (&s_sw[0]) as u64, (&s_x[0]) as u64,
            (&s_arr[0]) as u64, (&s_rc[0]) as u64, (&s_us[0]) as u64,
            (&s_now[0]) as u64)
    }
    if vmode.want(state, vmode.M_CONFIRM) {
        // Wechseln, NICHT bestaetigen, die Frist ablaufen lassen.
        disp_switch(state, 1024, 768, (&s_sw[0]) as u64, (&s_x[0]) as u64,
            (&s_arr[0]) as u64, (&s_rc[0]) as u64, (&s_us[0]) as u64,
            (&s_now[0]) as u64)
        serial.puts((&s_cf[0]) as u64)
        serial.dec(bnum(vmode.pending(state)))
        serial.puts((&s_left[0]) as u64)
        serial.dec(vmode.remaining(state) / 1000)
        serial.nl()
        disp_wait(state, vmode.CONFIRM_MS + 500)
        let ging: bool = vmode.poll(state)
        serial.puts((&s_cf[0]) as u64)
        serial.dec(bnum(vmode.pending(state)))
        serial.puts((&s_rr[0]) as u64)
        serial.dec(bnum(ging))
        serial.puts((&s_now[0]) as u64)
        serial.dec(fb.panel_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.panel_h(state))
        serial.nl()
    }
    // ============================================ RUNDE CUSTOMRES
    if vmode.want(state, vmode.M_OWN) {
        disp_own(state, 1400, 1050, 32)
    }
    if vmode.want(state, vmode.M_EIGENBAD) {
        // 3840x2160 nimmt die Karte an und ihr Bildspeicher traegt es
        // (der Laeufer gibt diesem Lauf 64 MiB) -- was NICHT traegt,
        // sind die 2-MiB-Fensterplaetze dieses Kernels. Die Meldung
        // MUSS das sagen, und zwar mit beiden Zahlen.
        //
        // RUNDE KLEINKRAM (14.09.2026), A-018: hier stand 2560x1440,
        // und das war richtig, SOLANGE WIN_SLOTS 8 war. Commit 758c3c6
        // ("der Rahmenpuffer nahm den Geraeten die Plaetze") hat sie
        // auf 16 gesetzt, damit 3440x1440 am Stueck haengt. Seither
        // sind es 16 Kacheln, `maplimit` ist 29360128 statt 14680064
        // -- und 2560x1440x4 = 14745600 PASST. Der Kern hat also
        // voellig zu Recht angenommen, was dieser Abschnitt als
        // "muesste abgelehnt werden" gelesen hat; rot war die
        // ERWARTUNG, nicht der Kern. 3840x2160x4 = 33177600 liegt
        // ueber 29360128 und misst dieselbe Schranke wieder echt.
        disp_own(state, 3840, 2160, 32)
        // ... und das hier ist die Karte selbst: 1366 ist kein
        // Vielfaches von acht, und QEMU laesst deshalb den Ankerwert
        // stehen. Zwei verschiedene Schranken, zwei verschiedene
        // Gruende, in EINEM Lauf.
        disp_own(state, 1366, 768, 32)
        // Und die dritte: eine Farbtiefe, die dieser Kernel nicht malt.
        disp_own(state, 1400, 1050, 16)
    }
    if vmode.want(state, vmode.M_EIGENFRIST) {
        // DIE ZUSAGE DIESER RUNDE. Auf eine EIGENE Aufloesung wechseln,
        // NICHT bestaetigen -- und nichts weiter tun. Kein `poll`, kein
        // Systemaufruf, kein Programm: nur warten. Was danach dasteht,
        // hat die Leerlaufaufgabe zurueckgeschaltet, oder es hat
        // niemand.
        disp_own(state, 1400, 1050, 32)
        serial.puts((&s_cf[0]) as u64)
        serial.dec(bnum(vmode.pending(state)))
        serial.puts((&s_left[0]) as u64)
        serial.dec(vmode.remaining(state) / 1000)
        serial.nl()
        disp_wait(state, vmode.CONFIRM_MS + 1500)
        // In DIESEM Lauf gibt es noch keine Leerlaufaufgabe: der Kern
        // steht in seiner eigenen Startaufgabe und wartet in einer
        // Zaehlschleife. Also wird `poll` hier gerufen, genau wie im
        // Abschnitt `dispconfirm` -- gemessen wird hier, dass die FRIST
        // fuer eine EIGENE Aufloesung genauso gestellt und genauso
        // zurueckgenommen wird wie fuer eine aus der Liste.
        //
        // DASS SIE OHNE JEDES ZUTUN ABLAEUFT, wird eine Ebene hoeher
        // gemessen und nicht hier: in Abschnitt 5 von
        // tools/customres/run.sh schaltet ein PROGRAMM in Ring 3 um und
        // legt sich dann schlafen. Was dort zurueckschaltet, ist die
        // Leerlaufaufgabe (`tasks.idle`), und sonst nichts -- `sleep`
        // ruft keinen einzigen Bildschirmaufruf.
        let ging: bool = vmode.poll(state)
        serial.puts((&s_cf[0]) as u64)
        serial.dec(bnum(vmode.pending(state)))
        serial.puts((&s_rr[0]) as u64)
        serial.dec(bnum(ging))
        serial.puts((&s_now[0]) as u64)
        serial.dec(fb.panel_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.panel_h(state))
        serial.nl()
    }
    if vmode.want(state, vmode.M_BENCH) {
        disp_bench(state)
    }
    if vmode.want(state, vmode.M_ROT) {
        fb.set_rotation(state, 90)
        serial.puts((&s_rot[0]) as u64)
        serial.dec(fb.rotation(state))
        serial.puts((&s_img[0]) as u64)
        serial.dec(fb.width(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.height(state))
        serial.puts((&s_now[0]) as u64)
        serial.dec(fb.panel_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.panel_h(state))
        serial.nl()
    }
    vmode.confirm(state)
    serial.puts((&s_cnt[0]) as u64)
    serial.dec(vmode.switches(state))
    serial.puts((&s_fl[0]) as u64)
    serial.dec(vmode.fails(state))
    serial.puts((&s_rv[0]) as u64)
    serial.dec(vmode.reverts(state))
    serial.nl()
}

// RUNDE CUSTOMRES: EINE EIGENE AUFLOESUNG VERLANGEN UND MELDEN, WAS
// DARAUS WURDE -- mit dem Grund und der Zahl, nicht mit "ging nicht".
fn disp_own(state: u64, w: u64, h: u64, bpp: u64) {
    var s_e: [u8; 14] = "disp: eigen \0\0"
    var s_x: [u8; 2] = "x\0"
    var s_t: [u8; 3] = "x \0"
    var s_rc: [u8; 5] = " rc=\0"
    var s_wy: [u8; 8] = "  why=\0\0"
    var s_nm: [u8; 8] = "  num=\0\0"
    var s_lim: [u8; 12] = "  maplimit=\0"
    var s_vr: [u8; 9] = "  vram=\0\0"
    var s_now: [u8; 8] = " panel=\0"
    var s_us: [u8; 5] = " us=\0"
    var s_cn: [u8; 11] = "  custom=\0\0"
    let t: u64 = apic.tsc()
    let rc: u64 = vmode.set_custom(state, w, h, bpp)
    let d: u64 = us_of(state, apic.tsc() - t)
    serial.puts((&s_e[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_t[0]) as u64)
    serial.dec(bpp)
    serial.puts((&s_rc[0]) as u64)
    serial.dec(rc)
    serial.puts((&s_wy[0]) as u64)
    serial.dec(vmode.cust_why(state))
    serial.puts((&s_nm[0]) as u64)
    serial.dec(vmode.cust_num(state))
    serial.puts((&s_vr[0]) as u64)
    serial.dec(vmode.vram(state))
    serial.puts((&s_lim[0]) as u64)
    serial.dec(vmode.map_limit(state))
    serial.puts((&s_cn[0]) as u64)
    serial.dec(vmode.customs(state))
    serial.puts((&s_now[0]) as u64)
    serial.dec(fb.panel_w(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.panel_h(state))
    serial.puts((&s_us[0]) as u64)
    serial.dec(d)
    serial.nl()
}

fn disp_wait(state: u64, ms: u64) {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return
    }
    let bis: u64 = apic.tsc() + (hz / 1000) * ms
    while apic.tsc() < bis {
    }
}

fn disp_switch(state: u64, w: u64, h: u64, s_sw: u64, s_x: u64, s_arr: u64,
    s_rc: u64, s_us: u64, s_now: u64) {
    let vw: u64 = fb.panel_w(state)
    let vh: u64 = fb.panel_h(state)
    let t: u64 = apic.tsc()
    let rc: u64 = vmode.set_mode(state, w, h, 32)
    let d: u64 = us_of(state, apic.tsc() - t)
    serial.puts(s_sw)
    serial.dec(vw)
    serial.puts(s_x)
    serial.dec(vh)
    serial.puts(s_arr)
    serial.dec(w)
    serial.puts(s_x)
    serial.dec(h)
    serial.puts(s_rc)
    serial.dec(rc)
    serial.puts(s_us)
    serial.dec(d)
    serial.puts(s_now)
    serial.dec(fb.panel_w(state))
    serial.puts(s_x)
    serial.dec(fb.panel_h(state))
    serial.nl()
}

fn disp_bench(state: u64) {
    var s_h: [u8; 13] = "disp: bench \0"
    var s_x: [u8; 2] = "x\0"
    var s_fl: [u8; 10] = "  flush=\0\0"
    var s_lu: [u8; 8] = "  lut=\0\0"
    var s_sa: [u8; 8] = "  sat=\0\0"
    var s_ro: [u8; 10] = "  rot90=\0\0"
    var s_ln: [u8; 11] = "  lutline=\0"
    var s_us: [u8; 4] = " us\0"
    var s_px: [u8; 7] = "  px=\0\0"
    var s_want: [u8; 18] = "disp: bench want \0"
    var s_rc: [u8; 5] = " rc=\0"

    // Den groessten Modus der Liste nehmen -- die Frage ist, was das
    // Umrechnen bei VIEL Flaeche kostet, nicht bei wenig.
    let n: u64 = vmode.count(state)
    if n > 0 {
        let brc: u64 = vmode.set_mode(state, vmode.mode_w(state, n - 1),
            vmode.mode_h(state, n - 1), 32)
        vmode.confirm(state)
        serial.puts((&s_want[0]) as u64)
        serial.dec(vmode.mode_w(state, n - 1))
        serial.puts((&s_x[0]) as u64)
        serial.dec(vmode.mode_h(state, n - 1))
        serial.puts((&s_rc[0]) as u64)
        serial.dec(brc)
        serial.nl()
    }
    let w: u64 = fb.panel_w(state)
    let h: u64 = fb.panel_h(state)
    fb.clear(state, fb.rgb(state, 0x30, 0x60, 0x90))

    fb.set_lut(state, 0)
    fb.set_saturation(state, 100)
    fb.set_rotation(state, 0)
    var t: u64 = apic.tsc()
    var i: u64 = 0
    while i < DISP_RUNDEN {
        fb.dirty_all(state)
        fb.flush(state)
        i = i + 1
    }
    let d_fl: u64 = us_of(state, apic.tsc() - t) / DISP_RUNDEN

    fb.set_lut(state, vmode.lut_addr(state))
    t = apic.tsc()
    i = 0
    while i < DISP_RUNDEN {
        fb.dirty_all(state)
        fb.flush(state)
        i = i + 1
    }
    let d_lu: u64 = us_of(state, apic.tsc() - t) / DISP_RUNDEN

    // UND DIE ZAHL, DIE IM BETRIEB WIRKLICH ZAEHLT: eine Textzeile, also
    // sechzehn Bildzeilen. Eine Konsole baut fast nie ein ganzes Bild
    // auf -- derselbe Einwand, den `bench_zeile` in Runde K7 gegen den
    // vollen Bildaufbau erhoben hat, gilt fuer die Nachschlagetabelle
    // genauso. Wer nur das volle Bild misst, sieht die Tabelle nur von
    // ihrer teuersten Seite.
    t = apic.tsc()
    i = 0
    while i < DISP_RUNDEN {
        fb.dirty(state, 0, 16)
        fb.flush(state)
        i = i + 1
    }
    let d_ln: u64 = us_of(state, apic.tsc() - t) / DISP_RUNDEN

    fb.set_saturation(state, 150)
    t = apic.tsc()
    i = 0
    while i < DISP_RUNDEN {
        fb.dirty_all(state)
        fb.flush(state)
        i = i + 1
    }
    let d_sa: u64 = us_of(state, apic.tsc() - t) / DISP_RUNDEN
    fb.set_saturation(state, 100)

    fb.set_lut(state, 0)
    var d_ro: u64 = 0
    if fb.set_rotation(state, 90) {
        t = apic.tsc()
        i = 0
        while i < DISP_RUNDEN {
            fb.dirty_all(state)
            fb.flush(state)
            i = i + 1
        }
        d_ro = us_of(state, apic.tsc() - t) / DISP_RUNDEN
        fb.set_rotation(state, 0)
    }

    serial.puts((&s_h[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_px[0]) as u64)
    serial.dec(w * h)
    serial.puts((&s_fl[0]) as u64)
    serial.dec(d_fl)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_lu[0]) as u64)
    serial.dec(d_lu)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_ln[0]) as u64)
    serial.dec(d_ln)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sa[0]) as u64)
    serial.dec(d_sa)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_ro[0]) as u64)
    serial.dec(d_ro)
    serial.puts((&s_us[0]) as u64)
    serial.nl()
}

// Mikrosekunden aus Prozessortakten. `apic.tsc_hz` steht seit
// `hw.stage`; ohne APIC gibt es keine Zeitbasis und damit keine Messung.
fn us_of(state: u64, takte: u64) -> u64 {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return 0
    }
    return takte * 1000000 / hz
}

// DIE MESSUNG. Beide Wege auf DERSELBEN Maschine, mit DEMSELBEN
// Zeitzaehler und in EINEM Lauf -- zwei QEMU-Starts waeren zwei
// Maschinen und die Zahlen nicht vergleichbar.
//
//   1. voller Bildaufbau, direkt auf die Karte
//   2. eine Rollbewegung,  direkt auf die Karte
//   3. voller Bildaufbau in den Zweitpuffer + Uebertragung
//   4. eine Rollbewegung  im Zweitpuffer + Uebertragung
fn gfx_bench(state: u64, back: u64) {
    var s_b1: [u8; 26] = "        fbbench: direct  \0"
    var s_b2: [u8; 26] = "        fbbench: buffered\0"
    var s_fill: [u8; 8] = "  fill=\0"
    var s_scr: [u8; 10] = "  scroll=\0"
    var s_fl: [u8; 9] = "  flush=\0"
    var s_ln: [u8; 9] = "  line=\0\0"
    var s_us: [u8; 4] = " us\0"
    var s_nb: [u8; 30] = "        fbbench: no time base\0"

    if apic.tsc_hz(state) == 0 {
        serial.puts((&s_nb[0]) as u64)
        serial.nl()
        return
    }
    let farbe: u64 = fb.rgb(state, 0x20, 0x30, 0x40)

    // --- 1 und 2: ohne Zweitpuffer, jeder Bildpunkt geht auf die Karte.
    fb.set_back(state, 0)
    var t: u64 = apic.tsc()
    var i: u64 = 0
    while i < GFX_RUNDEN {
        fb.clear(state, farbe)
        i = i + 1
    }
    let d_fill: u64 = us_of(state, apic.tsc() - t) / GFX_RUNDEN
    t = apic.tsc()
    i = 0
    while i < GFX_RUNDEN {
        fb.scroll(state)
        i = i + 1
    }
    let d_scroll: u64 = us_of(state, apic.tsc() - t) / GFX_RUNDEN
    let d_line: u64 = bench_line(state)
    serial.puts((&s_b1[0]) as u64)
    serial.puts((&s_fill[0]) as u64)
    serial.dec(d_fill)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_scr[0]) as u64)
    serial.dec(d_scroll)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_ln[0]) as u64)
    serial.dec(d_line)
    serial.puts((&s_us[0]) as u64)
    serial.nl()

    if back == 0 {
        fb.set_back(state, 0)
        return
    }

    // --- 3 und 4: derselbe Bildaufbau im Arbeitsspeicher, danach EINE
    //     Uebertragung. Die Uebertragung wird getrennt ausgewiesen, weil
    //     genau sie der Preis der Doppelpufferung ist.
    fb.set_back(state, back)
    t = apic.tsc()
    i = 0
    while i < GFX_RUNDEN {
        fb.clear(state, farbe)
        i = i + 1
    }
    let b_fill: u64 = us_of(state, apic.tsc() - t) / GFX_RUNDEN
    t = apic.tsc()
    i = 0
    while i < GFX_RUNDEN {
        fb.scroll(state)
        i = i + 1
    }
    let b_scroll: u64 = us_of(state, apic.tsc() - t) / GFX_RUNDEN
    t = apic.tsc()
    i = 0
    while i < GFX_RUNDEN {
        fb.dirty_all(state)
        fb.flush(state)
        i = i + 1
    }
    let b_flush: u64 = us_of(state, apic.tsc() - t) / GFX_RUNDEN
    let b_line: u64 = bench_line(state)
    serial.puts((&s_b2[0]) as u64)
    serial.puts((&s_fill[0]) as u64)
    serial.dec(b_fill)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_scr[0]) as u64)
    serial.dec(b_scroll)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_fl[0]) as u64)
    serial.dec(b_flush)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_ln[0]) as u64)
    serial.dec(b_line)
    serial.puts((&s_us[0]) as u64)
    serial.nl()
}

// =====================================================================
// RUNDE SCHNELLBILD: DER DURCHSATZ IN MB/s, UND DIE ABBILDUNG DAZU
// =====================================================================
//
// WARUM DIESE MESSUNG UND NICHT `fbbench`. `fbbench` misst Mikrosekunden
// je Vollbild. Das ist die richtige Zahl, um zwei Wege zu vergleichen,
// aber es ist NICHT die Zahl, an der man erkennt, ob die Abbildung
// stimmt: 40 ms bei 1280x800 und 40 ms bei 3440x1440 sind derselbe
// Zeitwert und ein Unterschied von Faktor 4,8 im Durchsatz.
//
// Die Recherche (FREMDSOFTWARE.md 4a) nennt die Schwelle:
//     uncached (UC)     -> 50..200 MB/s
//     write-combining   -> 2000..6000 MB/s
// Dazwischen liegt Faktor 30, und das erkennt man nur an MB/s.
//
// Gemessen wird der REINE SCHREIBWEG in den Zeichenpuffer: `n` volle
// Bilder mit `rep stosq`, ohne Mischen, ohne Text, ohne Fensterserver.
// Was hier herauskommt, ist die OBERGRENZE -- kein Zeichner wird je
// schneller als der Speicher darunter.
//
// DAZU DIE ABBILDUNG, UND ZWAR GEMESSEN, NICHT GEGLAUBT: `fb.pde_roh`
// liest den ECHTEN Seitentafeleintrag des Fensterplatzes zurueck,
// `fb.pat_roh` das MSR. Erst beide zusammen sagen, ob
// Write-Combining wirklich greift:
//     Bit 12 im Eintrag gesetzt UND Stelle 4 im PAT == 01  -> WC
// Ohne diese zwei Zahlen ist jede Aussage ueber UC/WC eine Behauptung.
fn durchsatz(state: u64) {
    var s_h: [u8; 20] = "        durchsatz: \0"
    var s_x: [u8; 2] = "x\0"
    var s_px: [u8; 9] = "  bytes=\0"
    var s_us: [u8; 7] = "  us=\0\0"
    var s_mb: [u8; 9] = "  mb_s=\0\0"
    var s_fps: [u8; 8] = "  fps=\0\0"
    var s_pde: [u8; 8] = "  pde=\0\0"
    var s_pat: [u8; 8] = "  pat=\0\0"
    var s_wc: [u8; 7] = "  wc=\0\0"
    var s_uc: [u8; 7] = "  uc=\0\0"
    var s_st: [u8; 12] = "  streifen=\0"
    var s_nb: [u8; 33] = "        durchsatz: no time base\0\0"

    if apic.tsc_hz(state) == 0 {
        serial.puts((&s_nb[0]) as u64)
        serial.nl()
        return
    }
    let w: u64 = fb.width(state)
    let h: u64 = fb.height(state)
    if w == 0 || h == 0 {
        return
    }
    // Der Puffer, in den wirklich gezeichnet wird -- mit Zweitpuffer ist
    // das der Arbeitsspeicher, ohne ihn die Karte. Genau der Unterschied
    // soll sichtbar werden, deshalb wird hier NICHTS umgestellt.
    let bytes: u64 = fb.pitch(state) *% h
    let farbe: u64 = fb.rgb(state, 0x10, 0x20, 0x30)

    let t: u64 = apic.tsc()
    var i: u64 = 0
    while i < GFX_RUNDEN {
        fb.clear(state, farbe)
        i = i + 1
    }
    let us: u64 = us_of(state, apic.tsc() -% t) / GFX_RUNDEN

    serial.puts((&s_h[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_px[0]) as u64)
    serial.dec(bytes)
    serial.puts((&s_us[0]) as u64)
    serial.dec(us)
    // MB/s aus Oktetten und Mikrosekunden, ohne Fliesskomma und ohne
    // Ueberlauf: Oktette/us ist bereits MB/s (1e6/1e6 kuerzt sich weg).
    serial.puts((&s_mb[0]) as u64)
    if us != 0 {
        serial.dec(bytes / us)
    } else {
        serial.dec(0)
    }
    // Die Obergrenze in Bildern je Sekunde, die aus genau dieser Zeit
    // folgt. Mehr kann der Bildweg nie, egal was darueber laeuft.
    serial.puts((&s_fps[0]) as u64)
    if us != 0 {
        serial.dec(1000000 / us)
    } else {
        serial.dec(0)
    }
    serial.nl()

    // Die Abbildung, aus der Seitentafel selbst.
    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_pde[0]) as u64)
    serial.hex(fb.pde_roh(state))
    serial.puts((&s_pat[0]) as u64)
    serial.hex(fb.pat_roh(state))
    serial.puts((&s_wc[0]) as u64)
    serial.dec(fb.wc(state))
    serial.puts((&s_uc[0]) as u64)
    serial.dec(bnum(fb.uncached(state)))
    serial.puts((&s_st[0]) as u64)
    serial.dec(bnum(fb.stripe(state)))
    serial.nl()
}

// EINE TEXTZEILE, so wie die Konsole sie schreibt -- achtzig Zeichen und
// ein Umbruch.
//
// Diese Zahl ist die wichtigere der drei, und der Grund steht in ihr
// selbst: eine Konsole baut fast nie ein ganzes Bild auf. Sie schreibt
// eine Zeile, und mit Zweitpuffer wird von genau dieser Zeile
// uebertragen, was sich geaendert hat -- sechzehn Bildzeilen statt
// sechshundert. Wer nur den vollen Bildaufbau misst, sieht die
// Doppelpufferung nur von ihrer teuren Seite.
//
// Ohne Zeichenmarke, weil die je Zeichen zweimal ein Rechteck malt und
// die Messung damit ueber ihren eigenen Cursor stolpern wuerde.
fn bench_line(state: u64) -> u64 {
    let marke: bool = fb.cursor_on(state)
    fb.set_cursor(state, false)
    fb.clear(state, 0)
    fb.home(state)
    fb.flush(state)
    let t: u64 = apic.tsc()
    var i: u64 = 0
    while i < GFX_RUNDEN {
        var c: u64 = 0
        while c < 80 {
            fb.putc(state, 88) // 'X'
            c = c + 1
        }
        fb.putc(state, 10)
        i = i + 1
    }
    let us: u64 = us_of(state, apic.tsc() - t) / GFX_RUNDEN
    fb.set_cursor(state, marke)
    return us
}

// DAS PROGRAMM IN RING 3, DAS DEN BILDSCHIRM BESPIELT (`uprog.u_fb`).
//
// Der Spiegel wird VORHER abgeschaltet und die Flaeche geleert, und das
// ist keine Kosmetik: solange die Konsole mitschreibt, rollt jede weitere
// Zeile das Bild nach oben und uebermalt, was das Programm gezeichnet
// hat. Danach gehoert die Flaeche dem Programm allein -- und das
// Bildschirmfoto zeigt, was RING 3 dort hingelegt hat, nicht der Kernel.
fn gfx_user(state: u64) {
    var s_run: [u8; 30] = "fb: ring 3 paints, mirror off\0"
    var s_exit: [u8; 18] = "fb: ring 3 exit=\0\0"

    serial.puts((&s_run[0]) as u64)
    serial.nl()
    fb.set_echo(state, false)
    fb.set_cursor(state, false)
    fb.clear(state, 0)
    fb.dirty_all(state)
    fb.flush(state)
    // Die Geometrie in einem 32-Bit-Argument: Breite oben, Hoehe unten.
    // Ein Programm in Ring 3 kann sie sonst nirgends herbekommen.
    let arg: u64 = (fb.width(state) << 16) | fb.height(state)
    let t: u64 = proc.create(state, P_FB, arg, 2)
    let e: u64 = kutil.wait_for(state, t)
    serial.puts((&s_exit[0]) as u64)
    serial.dec(e)
    serial.nl()
}

// Das Pruefbild und das Stillhalten. Beides nur auf ausdrueckliches Wort:
// `fbtest` malt, `fbhold` wartet, damit der Testlaeufer draussen
// `screendump` rufen kann, waehrend das Bild noch steht.
// RUNDE MARKE: DIE KOPFZEILE DES PRUEFBILDS TRAEGT DEN PRODUKTNAMEN.
// Sie stand hier als Literal und ist ANZEIGETEXT -- ein Mensch liest
// sie vom Bildschirm ab. Also wird sie zusammengesetzt statt getippt.
// Die vier Laeufer, die sie bildpunktgenau nachmessen (gfx, customres,
// display, und zwar zehnmal), lesen denselben Namen aus `marke.conf`;
// eine Zusage, die auf einen fest getippten Text zeigt, waere nach der
// ersten Umbenennung eine Zusage auf etwas, das es nicht mehr gibt.
fn testimage_header(dst: u64) -> u64 {
    var rest: [u8; 22] = " K7 FRAMEBUFFER 01234\0"
    var n: u64 = brand.anhaengen(dst, 0, brand.produkt(), 63)
    n = brand.anhaengen(dst, n, (&rest[0]) as u64, 63)
    kstate.set8(dst + n, 0)
    return n
}

fn gfx_hold(state: u64) {
    var s_pat: [u8; 64] = [0 as u8; 64]
    let _pk: u64 = testimage_header((&s_pat[0]) as u64)
    var s_pat2: [u8; 26] = "abcdefghijklm ABCDEFGHIJK\0"
    var s_hold: [u8; 10] = "fb: hold\0\0"
    var s_go: [u8; 10] = "fb: go\0\0\0\0"

    if fb.ready(state) {
        if fb.want(state, fb.M_USER) {
            gfx_user(state)
        }
        // RUNDE DISPLAY: DER WECHSEL ZUERST, DANN DAS PRUEFBILD.
        //
        // Die erste Fassung hatte es andersherum, und beides ging
        // schief: nach einem Moduswechsel ist der Zweitpuffer neu und
        // leer, das alte Pruefbild also weg -- und nach einer Drehung
        // liegt im Zweitpuffer ein Bild mit der Zeilenlaenge des
        // UNGEDREHTEN Bildes, das `present` dann quer auseinanderzieht.
        // Gemessen: das Foto zeigte statt vier Farbfeldern einen
        // Streifenteppich. Wer die Geometrie aendert, muss danach neu
        // zeichnen; das gilt fuer dieses Pruefbild genauso wie fuer
        // jedes Fenster.
        display_hold(state)
        if fb.want(state, fb.M_PATTERN) {
            pattern(state, (&s_pat[0]) as u64, (&s_pat2[0]) as u64)
        }
        // RUNDE K18: das Pruefbild der Helligkeit. HIER und nicht oben in
        // `power_stage`, und das ist gemessen und nicht ueberlegt: dort
        // gemalt, war es im Bildschirmfoto nicht mehr zu finden -- die
        // Konsole schreibt zwischen `power_stage` und dem Stillhalten
        // noch drei Dutzend Zeilen auf denselben Schirm und rollt ihn
        // dabei. Die Kernelmeldung stimmte trotzdem (px_a=0xc86432), das
        // Bild war leer. Genau die Art Unterschied, wegen der in diesem
        // Projekt im BILD nachgemessen wird und nicht nur im Bericht.
        power_screen(state)
        fb.flush(state)
    }
    // STILLGEHALTEN WIRD AUCH OHNE BILDSCHIRM, und das ist der Grund,
    // aus dem `fbhold` nicht an `gfx` haengt: die Gegenprobe in
    // `tools/gfx/run.sh` faehrt DENSELBEN Kernel mit DERSELBEN
    // Kommandozeile und nur ohne das Wort `gfx`, wartet genauso lange und
    // macht genauso ein Bildschirmfoto. Waere das Warten an den
    // Bildschirm gebunden, waere die Gegenprobe ein anderer Lauf -- und
    // ein Vergleich zweier verschiedener Laeufe beweist nichts.
    if !fb.want(state, fb.M_HOLD) {
        return
    }
    serial.puts((&s_hold[0]) as u64)
    serial.nl()
    // Rund vier Sekunden. Der Testlaeufer draussen sieht die Zeile oben,
    // ruft `screendump` und prueft das Bild, waehrend es noch steht.
    let hz: u64 = apic.tsc_hz(state)
    if hz != 0 {
        let bis: u64 = apic.tsc() + hz * 4
        while apic.tsc() < bis {
            // ============================ RUNDE HOTPLUG
            // AUCH DIESES WARTEN IST BETRIEB.
            //
            // Hier stand eine leere Schleife, und das war richtig,
            // solange draussen nur fotografiert wurde. Sobald der
            // Testlaeufer WAEHRENDDESSEN einen Stick steckt, ist es
            // falsch: `port_watch` (im Zeitgeber) merkt den
            // Anschlusswechsel vor, und niemand arbeitet ihn ab.
            // GEMESSEN: `events=1`, `hotplugs=0` -- das Geraet klopfte
            // an, und der Kern hielt die Augen zu.
            //
            // Dieselben zwei Zeilen wie in der Schreibtischschleife,
            // in derselben Reihenfolge: erst aufzaehlen, dann
            // einhaengen.
            usb.hotplug_work(state)
            wechsel_schritt(state)
        }
    }
    serial.puts((&s_go[0]) as u64)
    serial.nl()
}

// Das Pruefbild. Vier Felder in REINEN Farben, weil ein Bildschirmfoto
// sie ohne Rundungsfrage nachrechnen kann, eine Linie quer darunter --
// und zwei Textzeilen an einer Stelle, die sich ausrechnen laesst:
// Zeile 14 beginnt bei y = 224, Spalte 0 bei x = 0.
//
// Der Text geht ueber `serial.puts`, nicht ueber `fb.puts`. Damit steht
// dasselbe im seriellen Protokoll wie auf dem Bildschirm, und der
// Testlaeufer kann beides gegeneinander halten statt nur das eine gegen
// sich selbst.
fn pattern(state: u64, eine: u64, zwei: u64) {
    fb.set_cursor(state, false)
    fb.clear(state, 0)
    fb.fill(state, 0, 0, 100, 100, fb.rgb(state, 0xFF, 0, 0))
    fb.fill(state, 100, 0, 100, 100, fb.rgb(state, 0, 0xFF, 0))
    fb.fill(state, 200, 0, 100, 100, fb.rgb(state, 0, 0, 0xFF))
    fb.fill(state, 300, 0, 100, 100, fb.rgb(state, 0xFF, 0xFF, 0xFF))
    fb.line(state, 0, 110, 399, 210, fb.rgb(state, 0xFF, 0xFF, 0))
    fb.goto(state, 0, 14)
    serial.puts(eine)
    serial.nl()
    serial.puts(zwei)
    serial.nl()
    fb.dirty_all(state)
    fb.flush(state)
}

// RUNDE K17. Die Naht ist absichtlich duenn: was USB ist, steht in
// `usb.fi` und `xhci.fi`, und `kmain.fi` bekommt vier Zeilen statt
// vierzig. Dieselbe Ueberlegung wie bei `hw.stage` in Runde K2 -- an
// dieser Datei arbeiten mehrere Runden gleichzeitig, und eine Naht laesst
// sich verschmelzen, ein ueber tausend Zeilen verteilter Unterschied
// nicht.

fn power_screen(state: u64) {
    var n_a: [u8; 6] = "px_a\0\0"
    var n_b: [u8; 6] = "px_b\0\0"
    var n_c: [u8; 6] = "px_c\0\0"
    var n_d: [u8; 6] = "px_d\0\0"
    var n_e: [u8; 6] = "px_e\0\0"
    var n_no: [u8; 9] = "px_none\0\0"
    // OHNE DAS WORT `pwr` WIRD HIER GAR NICHTS GEMALT.
    //
    // Das fehlte in der ersten Fassung, und `tools/gfx/run.sh` hat es
    // gefunden: dort wird der GANZE Bildschirm gegen den seriellen
    // Mitschnitt gehalten, Bildpunkt fuer Bildpunkt -- und ein
    // Pruefbild von 64 mal 64, das in JEDEM `gfx`-Lauf ueber der
    // Konsole lag, machte daraus "14757 Bildpunkte falsch". Eine Runde
    // darf das Bild einer anderen nicht bemalen, nur weil sie
    // uebersetzt wurde.
    if !kstate.mode_on(state, kstate.M_PWR) {
        return
    }
    if !fb.ready(state) {
        kutil.pnum((&n_no[0]) as u64, 1)
        return
    }
    // DIE KONSOLE WIRD FUER DIE DAUER DER MESSUNG STUMMGESCHALTET, und
    // das ist keine Kosmetik: jede Zeile, die auf den Schirm geht, ROLLT
    // ihn um sechzehn Bildpunkte. In der ersten Fassung stand das
    // Pruefbild deshalb in jedem Lauf woanders -- bei (100,68), wenn
    // eine Zeile danach kam, und bei (100,36), wenn es drei waren. Die
    // Farben stimmten auf den Punkt, die Stelle nicht, und ein Test, der
    // an einer festen Stelle nachsieht, haette das fuer einen Fehler der
    // Helligkeit gehalten. Ab hier geht alles nur noch auf die serielle
    // Leitung, und das Bild steht still.
    let echo_vorher: bool = fb.echo_on(state)
    fb.set_echo(state, false)
    fb.fill(state, 100, 100, 64, 64, PX_COLOR)
    fb.flush(state)
    kutil.phex((&n_a[0]) as u64, fb.get_pixel(state, PX_X, PX_Y) & 0xFFFFFF)

    if kstate.mode_on(state, kstate.M_PWRDIM) {
        pwr.set_bright(state, 50)
        kutil.phex((&n_b[0]) as u64, fb.get_pixel(state, PX_X, PX_Y) & 0xFFFFFF)
        // Und wieder hoch. 200*50/100*100/50 ist wieder 200 -- die Farbe
        // ist mit Absicht so gewaehlt, dass die Ganzzahlrechnung hier
        // nichts verliert. Bei 201 waere es 200, und dann muesste diese
        // Zusage anders lauten.
        pwr.set_bright(state, 100)
        kutil.phex((&n_c[0]) as u64, fb.get_pixel(state, PX_X, PX_Y) & 0xFFFFFF)
        pwr.set_bright(state, 50)
    }
    if kstate.mode_on(state, kstate.M_PWRBLANK) {
        pwr.blank(state)
        kutil.phex((&n_d[0]) as u64, fb.get_pixel(state, PX_X, PX_Y) & 0xFFFFFF)
        kutil.pnum((&n_e[0]) as u64, pwr.value(state, pwr.PW_BLANKS))
    }
    // EIN EIGENES STILLHALTEN FUER DIESE RUNDE, und der Grund ist
    // gemessen: das Stillhalten von Runde K7 (`fbhold`) meldet sich mit
    // einer Zeile, die auf DEMSELBEN Schirm landet -- die Konsole rollt,
    // und das Pruefbild war im Bildschirmfoto nicht mehr zu finden,
    // obwohl der Kernel es beim Zurueckesen noch sah. Also: erst die
    // Marke, dann malen, dann warten, und dazwischen sagt niemand mehr
    // etwas. Das Bild, das der Testlaeufer aufnimmt, ist genau das, was
    // hier gemalt wurde.
    fb.flush(state)
    var s_shot: [u8; 12] = "pwr: shot\0\0\0"
    serial.puts((&s_shot[0]) as u64)
    serial.nl()
    let hz: u64 = apic.tsc_hz(state)
    if hz != 0 {
        let bis: u64 = apic.tsc() + hz * 5
        while apic.tsc() < bis {
        }
    }
    var s_go: [u8; 12] = "pwr: shotgo\0"
    serial.puts((&s_go[0]) as u64)
    serial.nl()
    fb.set_echo(state, echo_vorher)
}

// RUNDE INSTALLER (P-001): DIE WURZEL AUF EINER PARTITION, FUER DEN
// WEG UEBER DEN FENSTERSERVER.
//
// Woertlich dasselbe wie `root_from_part` in kernel/kmain.fi, und das
// ist hier die ehrlichere Loesung als ein Aufruf hinueber: `kmain`
// importiert `kgui` und nicht umgekehrt, ein Aufruf in die andere
// Richtung waere ein Ring in den Abhaengigkeiten. Was beide teilen,
// sind `part` und `blk` -- die Tafel wird an EINER Stelle gelesen
// (part.fi), und nur die vier Zeilen, die das Ergebnis einhaengen,
// stehen zweimal.
fn gui_root_from_part(state: u64) -> bool {
    var s_try: [u8; 18] = "wm: rootpart scan\0"
    var s_at: [u8; 14] = "wm: rootpart=\0"
    var s_fi: [u8; 9] = "  first=\0"
    var s_bl: [u8; 10] = "  blocks=\0"
    var s_none: [u8; 22] = "wm: keine OFS-Part.\0\0\0"
    serial.puts((&s_try[0]) as u64)
    serial.nl()
    let n: u64 = part.scan(state, blk.DEV_ATA)
    if n == 0 {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return false
    }
    let i: u64 = part.find_kind(state, blk.DEV_ATA, part.T_OFS)
    if i >= part.MAX_PARTS {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return false
    }
    let first: u64 = part.start(state, i)
    let cnt: u64 = part.blocks(state, i)
    blk.use_at(state, blk.DEV_ATA, first, cnt)
    if !fs.mount(state) {
        blk.use_ata(state, kutil.root_blocks(state))
        return false
    }
    kstate.set(state, kstate.ROOT_PART, i)
    serial.puts((&s_at[0]) as u64)
    serial.dec(i)
    serial.puts((&s_fi[0]) as u64)
    serial.dec(first)
    serial.puts((&s_bl[0]) as u64)
    serial.dec(cnt)
    serial.nl()
    return true
}

fn surface(state: u64) {
    var s_off: [u8; 12] = "wm: skipped\0"
    var s_nofb: [u8; 22] = "wm: kein Bildschirm\0\0\0"
    var s_noar: [u8; 24] = "wm: kein Arbeitsbereich\0"
    var s_fs: [u8; 12] = "wm: mount=\0\0"
    var s_font: [u8; 6] = "ttf: \0"
    var s_g: [u8; 10] = "  glyphs=\0"
    var s_upm: [u8; 7] = "  upm=\0"
    var s_asc: [u8; 7] = "  asc=\0"
    var s_desc: [u8; 8] = "  desc=\0"
    var s_lh: [u8; 6] = "  lh=\0"
    var s_kp: [u8; 8] = "  kern=\0"
    var s_st: [u8; 12] = "  selftest \0"
    var s_of: [u8; 4] = " / \0"
    var s_nofont: [u8; 28] = "ttf: keine Schrift gefunden\0"
    var s_mono: [u8; 5] = "mono\0"
    var s_sans: [u8; 5] = "sans\0"
    var s_icons: [u8; 6] = "icons\0"
    var s_noicons: [u8; 18] = "wm: no icon font\0\0"
    let PX_ICON: u64 = 16
    var s_ms: [u8; 8] = "mouse: \0"
    var s_id: [u8; 5] = "id=\0\0"
    var s_pk: [u8; 11] = "  packets=\0"
    var s_none: [u8; 19] = "mouse: kein Zeiger\0"
    var s_wm: [u8; 5] = "wm: \0"
    var s_x: [u8; 2] = "x\0"
    var s_win: [u8; 11] = "  windows=\0"
    var s_cur: [u8; 10] = "  cursor=\0"
    var s_dirty: [u8; 9] = "  dirty=\0"
    var s_focus: [u8; 9] = "  focus=\0"
    var s_arena: [u8; 10] = "  arena=\0\0"
    var s_term: [u8; 15] = "wm: term win=\0\0"
    var s_cols: [u8; 8] = "  cols=\0"
    var s_rows: [u8; 8] = "  rows=\0"
    var s_cell: [u8; 8] = "  cell=\0"
    var s_hold: [u8; 10] = "wm: hold\0\0"
    var s_go: [u8; 8] = "wm: go\0\0"
    var s_exit: [u8; 16] = "wm: sh exit=\0\0\0\0"
    var s_stat: [u8; 6] = "wm: \0\0"
    var s_comp: [u8; 13] = "composites=\0\0"
    var s_blit: [u8; 9] = "  blits=\0"
    var s_pix: [u8; 10] = "  pixels=\0"
    var s_cache: [u8; 12] = "  cached=\0\0\0"
    var s_hit: [u8; 8] = "  hits=\0"
    var s_miss: [u8; 9] = "  miss=\0\0"
    // RUNDE VEKTOR: die Bildzeit, in EINER Zeile, damit
    // tools/design/bildzeit.py sie ohne Ratespiel findet.
    var s_bz: [u8; 12] = "bildzeit: \0\0"
    var s_bzn: [u8; 4] = "n=\0\0"
    var s_bzm: [u8; 12] = "  mittel=\0\0\0"
    var s_bzx: [u8; 9] = "  max=\0\0\0"
    var s_bzu: [u8; 12] = "  ueber16=\0\0"
    var s_bzus: [u8; 4] = " us\0"
    var s_bzh: [u8; 12] = "bildfach: \0\0"
    var s_bzsp: [u8; 2] = " \0"
    var s_bzb: [u8; 16] = "  betrieb max=\0\0"
    var s_bzbu: [u8; 12] = "  ueber16=\0\0"

    if !kstate.mode_on(state, kstate.M_WM) {
        // ==================================== RUNDE STARTKNOPF
        // UND WELCHES MODUSWORT DAS SAGT.
        //
        // "wm: skipped" allein ist zweideutig: entweder stand `wm`
        // nicht auf der Befehlszeile, oder das Bit ist unterwegs
        // verlorengegangen. Der Unterschied hat eine Runde gekostet --
        // in einem Abbild fehlte der Schreibtisch, obwohl `wm` in der
        // gedruckten Befehlszeile stand. Ab hier stehen die ersten
        // vier Modusworte daneben, und die Frage beantwortet die
        // Zeile selbst.
        var s_mw: [u8; 14] = "  modus w0..3\0"
        serial.puts((&s_off[0]) as u64)
        serial.puts((&s_mw[0]) as u64)
        var w: u64 = 0
        while w < 4 {
            serial.put(32 as u8)
            serial.hex(kstate.mode_word(state, w))
            w = w + 1
        }
        serial.nl()
        return
    }
    if !fb.ready(state) {
        serial.puts((&s_nofb[0]) as u64)
        serial.nl()
        return
    }
    // 1. der Arbeitsbereich
    let arena: u64 = mem.frame_run(state, WM_ARENA_FRAMES)
    if arena == 0 || !ttf.init(state, arena, WM_ARENA_FRAMES * mem.FRAME_SIZE) {
        serial.puts((&s_noar[0]) as u64)
        serial.nl()
        return
    }
    // 2. das Dateisystem, falls noetig
    //
    // RUNDE USBIMG: UND ES DARF AUS DEM BOOT-MODUL KOMMEN.
    //
    // Bis hierher stand hier nur `blk.use_ata`: der Schreibtisch fand
    // seine Schriften auf einer Platte, die QEMU mit `-drive if=ide`
    // hereinreichte. Auf einem USB-Stick an einem fremden Rechner gibt
    // es diese Platte nicht -- und ob dieser Rechner ueberhaupt einen
    // Controller hat, den dieser Kern bedienen kann, ist genau die
    // Frage, die die Diagnose erst beantworten soll. Ein Schreibtisch,
    // der dafuer eine Platte braucht, koennte auf dem Stick nie
    // starten.
    //
    // `osum` (weiter unten) kann das seit Runde K10, aber es kehrt
    // sofort zurueck, wenn der Fensterserver die Shell besitzt. Also
    // stehen dieselben drei Zeilen hier noch einmal -- fuer den Weg, auf
    // dem es KEINE Shell im Kern gibt.
    //
    // RUNDE MERGE-2: die Aenderung kam auf `usbimg` in kernel/kmain.fi
    // an; seit `serverbuild` steht `surface` hier, und hierher gehoert
    // sie.
    if kstate.get(state, kstate.FS_READY) == 0 {
        var quelle: bool = false
        if bootmod.ready(state) {
            blk.ram_init(state, bootmod.base(state), bootmod.blocks(state))
            quelle = true
        } else {
            if blk.present(state) {
                blk.use_ata(state, kutil.root_blocks(state))
                quelle = true
            }
        }
        if quelle {
            var m: bool = fs.mount(state)
            // ============================ RUNDE INSTALLER (P-001)
            // UND WENN DIE WURZEL AUF EINER PARTITION LIEGT.
            //
            // Hier stand nur `fs.mount`. Das findet ein Dateisystem
            // ab BLOCK 0 der Platte -- die Lage jedes Testabbilds
            // dieses Baums -- und ein Boot-Modul im Arbeitsspeicher.
            // Eine Platte, die das Installationsprogramm beschrieben
            // hat, hat WEDER: in Block 0 steht ein Schutz-MBR, und
            // das Dateisystem faengt hinter der EFI-Partition an.
            //
            // `kmain.osum` kann das seit Runde INSTALL
            // (`root_from_part`), und genau deshalb ist die Abnahme
            // dieser Runde ueber den TEXTWEG gruen geworden. Der Weg
            // ueber den FENSTERSERVER hatte die Zeilen nicht -- also
            // startete die frisch installierte Platte, malte den
            // Schreibtisch und fand ihre eigene Wurzel nicht:
            //
            //     wm: mount=0
            //
            // Das ist der Unterschied zwischen "die Platte bootet"
            // und "man kann damit arbeiten", und er faellt nur auf,
            // wenn jemand nach der Installation wirklich einen
            // Schreibtisch hochfahren laesst.
            //
            // Die Reihenfolge ist dieselbe wie drueben und aus
            // demselben Grund: erst der alte Weg (damit jede
            // bestehende Messung genau das sieht, was sie sah), und
            // ERST WENN DER FEHLSCHLAEGT die Partitionstafel.
            if !m && !bootmod.ready(state) {
                m = gui_root_from_part(state)
            }
            serial.puts((&s_fs[0]) as u64)
            serial.dec(kutil.yes(m))
            serial.nl()
        }
    }
    // 3. die Schriften
    var p_mono: [u8; 15] = "/lib/mono.ttf\0\0"
    var p_sans: [u8; 15] = "/lib/sans.ttf\0\0"
    // ROUND ICONS: the third font.  It carries no letters but the
    // symbols of the interface, and it is NOT required -- if it is
    // missing everything keeps running and the icons are absent.
    var p_icon: [u8; 16] = "/lib/icons.ttf\0\0"
    let f_mono: u64 = load_font(state, (&p_mono[0]) as u64)
    let f_sans: u64 = load_font(state, (&p_sans[0]) as u64)
    let f_icon: u64 = load_font(state, (&p_icon[0]) as u64)
    if f_mono >= ttf.MAX_FONTS && f_sans >= ttf.MAX_FONTS {
        serial.puts((&s_nofont[0]) as u64)
        serial.nl()
        return
    }
    var f_ui: u64 = f_sans
    if f_ui >= ttf.MAX_FONTS {
        f_ui = f_mono
    }
    var f_tx: u64 = f_mono
    if f_tx >= ttf.MAX_FONTS {
        f_tx = f_sans
    }
    // RUNDE SCHIRM: die Schriftgroesse der Oberflaeche haengt an der
    // Vervielfachung. 15 und 16 waren die Zahlen fuer 800x600; auf
    // 3840x2160 sind sie ein Viertel der physischen Groesse, die sie
    // dort hatten -- derselbe Fehler, den wir bei Certus gefunden haben.
    let UISC: u64 = fb.uiscale(state)
    let PX_UI: u64 = 15 * UISC
    let PX_MONO: u64 = 16 * UISC
    say_font(state, f_tx, PX_MONO, (&s_mono[0]) as u64, (&s_font[0]) as u64,
        (&s_g[0]) as u64, (&s_upm[0]) as u64, (&s_asc[0]) as u64,
        (&s_desc[0]) as u64, (&s_lh[0]) as u64, (&s_kp[0]) as u64,
        (&s_st[0]) as u64, (&s_of[0]) as u64)
    if f_sans < ttf.MAX_FONTS && f_sans != f_tx {
        say_font(state, f_sans, PX_UI, (&s_sans[0]) as u64,
            (&s_font[0]) as u64, (&s_g[0]) as u64, (&s_upm[0]) as u64,
            (&s_asc[0]) as u64, (&s_desc[0]) as u64, (&s_lh[0]) as u64,
            (&s_kp[0]) as u64, (&s_st[0]) as u64, (&s_of[0]) as u64)
    }
    // 4. das Zeigegeraet
    let w: u64 = fb.width(state)
    let h: u64 = fb.height(state)
    if kstate.mode_on(state, kstate.M_NOMOUSE) {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
    } else {
        ps2m.init(state, w, h)
        serial.puts((&s_ms[0]) as u64)
        serial.puts((&s_id[0]) as u64)
        serial.dec(ps2m.id(state))
        serial.puts((&s_pk[0]) as u64)
        serial.dec(ps2m.packets(state))
        serial.puts((&s_st[0]) as u64)
        serial.dec(ps2m.selftest(state))
        serial.puts((&s_of[0]) as u64)
        serial.dec(ps2m.selftest_max())
        serial.nl()
        ps2m.reset_counters(state)
        ps2m.set_poll(state,
            !kstate.mode_on(state, kstate.M_NOMPOLL))
    }
    // 5. der Fensterserver
    let nodirty: bool = kstate.mode_on(state, kstate.M_NODIRTY)
    let nofocus: bool = kstate.mode_on(state, kstate.M_NOFOCUS)
    if !wm.init(state, w, h, nodirty, nofocus) {
        return
    }
    // RUNDE DESKTOP: die beiden Gegenproben. Sie stehen hier und nicht
    // in `wm.init`, weil `init` schon vier Argumente hat und weil
    // dieselbe Zeile in `tools/desktop/run.sh` als ein Wort auf der
    // Befehlszeile erscheint.
    wm.set_nolayer(state, kstate.mode_on(state, kstate.M_NOLAYER))
    wm.set_nomin(state, kstate.mode_on(state, kstate.M_NOMIN))
    wm.set_nostrut(state, kstate.mode_on(state, kstate.M_NOSTRUT))
    // RUNDE VSYNC: dieselbe Stelle, dieselbe Begruendung. `vsync`
    // schaltet die Bildgrenze an, `nopresent` sticht sie wieder aus --
    // die Gegenprobe muss GEWINNEN, sonst waere sie keine.
    wm.set_vsync(state, kstate.mode_on(state, kstate.M_VSYNC)
        && !kstate.mode_on(state, kstate.M_NOPRESENT))
    wm.set_noanim(state, kstate.mode_on(state, kstate.M_NOANIM))
    wm.set_sig(state, kstate.mode_on(state, kstate.M_WMSIG))
    wm.set_leser(state, kstate.mode_on(state, kstate.M_WMSIG))
    // RUNDE VSYNC: die Seitenumschaltung. Sie wird VERSUCHT und meldet
    // ehrlich, ob die Karte sie hergibt -- `flip=0` heisst dann
    // "kopiert weiter zeilenweise" und nicht "kaputt".
    var geflippt: bool = false
    if kstate.mode_on(state, kstate.M_FLIP)
        && !kstate.mode_on(state, kstate.M_NOFLIP) {
        geflippt = fb.flip_setup(state)
    }
    var s_fl: [u8; 12] = "fb: flip=\0\0\0"
    serial.puts((&s_fl[0]) as u64)
    serial.dec(bool_num(geflippt))
    serial.nl()
    wm.set_uiscale(state, UISC)
    wm.set_fonts(state, f_ui, PX_UI, f_tx, PX_MONO)
    // ROUND ICONS: the icon font is reported LATER, after `wig.init`.
    // It has to be: `wig.init` clears the first 0x80 octets of its page
    // and that is where the slot is kept.  The first version set it
    // here, three dozen lines earlier, and Ring 3 then found no icons
    // at all while the kernel had loaded the font and said so -- the
    // most misleading kind of failure there is, because both halves
    // were telling the truth.
    if f_icon < ttf.MAX_FONTS {
        say_font(state, f_icon, PX_ICON, (&s_icons[0]) as u64,
            (&s_font[0]) as u64, (&s_g[0]) as u64, (&s_upm[0]) as u64,
            (&s_asc[0]) as u64, (&s_desc[0]) as u64, (&s_lh[0]) as u64,
            (&s_kp[0]) as u64, (&s_st[0]) as u64, (&s_of[0]) as u64)
    } else {
        serial.puts((&s_noicons[0]) as u64)
        serial.nl()
    }
    if kstate.mode_on(state, kstate.M_NOMOUSE) {
        wm.set_cursor(state, false)
    }
    serial.puts((&s_wm[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_cur[0]) as u64)
    serial.dec(bnum(wm.cursor_on(state)))
    serial.puts((&s_dirty[0]) as u64)
    serial.dec(1 - bnum(nodirty))
    serial.puts((&s_focus[0]) as u64)
    serial.dec(1 - bnum(nofocus))
    serial.puts((&s_arena[0]) as u64)
    serial.dec(WM_ARENA_FRAMES * mem.FRAME_SIZE)
    serial.nl()
    serial.puts((&s_wm[0]) as u64)
    serial.puts((&s_st[0]) as u64 + 2)
    serial.dec(wm.selftest(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(wm.selftest_max())
    var s_wmf: [u8; 11] = "  failed=\0\0"
    serial.puts((&s_wmf[0]) as u64)
    serial.hex(wm.failbits(state))
    var s_d1: [u8; 8] = "  mw=\0\0\0"
    var s_d2: [u8; 8] = "  max=\0\0"
    serial.puts((&s_d1[0]) as u64)
    serial.dec(wm.diag1(state))
    serial.puts((&s_d2[0]) as u64)
    serial.dec(wm.diag2(state))
    serial.nl()
    // RUNDE K15: die Naht zur Widget-Bibliothek. Sie kommt NACH dem
    // Fensterserver, weil sie in seine Fenster schreibt, und sie kommt
    // IMMER -- auch ohne das Wort `wig`. Ein Aufruf, den es nur
    // manchmal gibt, ist kein Aufruf, sondern eine Falle.
    wig.init(state)
    wig.set_icon_font(state, f_icon)
    var s_wig: [u8; 6] = "wig: \0"
    var s_wsel: [u8; 11] = "selftest \0\0"
    serial.puts((&s_wig[0]) as u64)
    serial.puts((&s_wsel[0]) as u64)
    serial.dec(wig.selftest(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(wig.selftest_max())
    serial.nl()

    // RUNDE TILING. Sie kommt HIER, vor dem ersten Fenster: der
    // Selbsttest, der Zufallstest und die Zeitmessung bauen sich ihre
    // eigenen Baeume und raeumen sie wieder ab. Danach steht der Baum
    // leer und der Fensterserver kann ihn benutzen.
    tile_stage(state, w, h)
    // RUNDE WMPLUGIN. Genau wie oben: der Selbsttest der Plugintafel
    // raeumt hinter sich auf (`wmplug.selftest` setzt am Ende `init`),
    // also darf er VOR dem ersten Fenster laufen. Ohne `plugtest`
    // passiert hier nichts.
    wmplug_stage(state)
    let willtile: bool = kstate.mode_on(state, kstate.M_TILE)
    let tileshot: bool =
        kstate.mode_on(state, kstate.M_TILESHOT)
    if willtile && !tileshot {
        wm.set_tile_on(state, true)
    }

    // 6. der Bildschirm gehoert ab hier dem Server. Der Spiegel der
    //    Textkonsole geht AUS -- zwei Zeichner auf einer Flaeche war
    //    genau das Problem, das Runde K7 offen gelassen hat.
    fb.set_echo(state, false)
    fb.set_cursor(state, false)
    fb.clear(state, 0)
    wm.damage_all(state)

    // RUNDE STANDBILD, STUFE 1: der frueheste Punkt, an dem es einen
    // Rahmenpuffer und einen Zeichensatz gibt. Steht die Tafel HIER
    // schon nicht, trifft die Malroutine den Schirm nicht -- und dann
    // ist es kein Zeitgeber- und kein Schleifenproblem.
    tafel_boot(state, 1)
    st(10)

    // Das Terminalfenster. Es bekommt das Terminal der Konsole -- von
    // hier an geht jedes Oktett, das ein Prozess auf fd 1 schreibt,
    // durch `tty.emit` mit SINK_WINDOW in dieses Fenster UND weiter auf
    // die serielle Leitung.
    var t_titel: [u8; 16] = "Terminal -- sh\0\0"
    // RUNDE HIDPUNKTE: 560 MAL 380 WAREN BILDPUNKTE UND SIND JETZT EIN
    // MASS. Auf Justins Ultrawide meldet `fb` `skala x2`, die
    // Zeichenzelle ist 20x38 -- 560 Bildpunkte sind dann 28 Spalten,
    // und in 28 Spalten passt weder "Terminal -- sh" in die Titelzeile
    // noch "K10 WINDOW SERVER 0123 ..." in eine Zeile. Genau die zwei
    // abgeschnittenen Zeilen stehen auf seinem Foto ("al -- sh",
    // "K10 WINDOW SERVER 0123"): der Titel wird MITTIG gesetzt, ist
    // breiter als das Fenster und ragt links hinaus.
    //
    // Das Fenster waechst deshalb mit derselben Zahl wie alles andere
    // an dieser Oberflaeche, und es bleibt in jedem Fall GANZ auf dem
    // Schirm -- auch auf einer kleinen Tafel, wo 560*2 nicht mehr
    // hineinpasst.
    let k: u64 = wm.uisc(state)
    let sw: u64 = fb.width(state)
    let sh: u64 = fb.height(state)
    var t_x: u64 = 24 * k
    var t_y: u64 = 40 * k
    var t_w: u64 = 560 * k
    var t_h: u64 = 380 * k
    if t_w + 2 * t_x > sw {
        t_x = 24
        if t_w + 2 * t_x > sw {
            t_w = sw - 2 * t_x
        }
    }
    if t_h + 2 * t_y > sh {
        t_y = 40
        if t_h + 2 * t_y > sh {
            t_h = sh - 2 * t_y
        }
    }
    let tw: u64 = wm.create(state, 0, t_x as i64, t_y as i64, t_w, t_h,
        wm.K_TERM, (&t_titel[0]) as u64)
    if tw < wm.MAX_WIN {
        // RUNDE PAINT: Dieses Fenster gehoert zum Buendel `terminal`.
        // Es ist das einzige, das der KERN anlegt -- alle anderen sagen
        // es ueber WM_APP selbst. Ohne diese Zeile bekaeme ausgerechnet
        // das Fenster kein Symbol, nach dem am haeufigsten gefragt
        // wurde.
        var t_app: [u8; 9] = "terminal\0"
        let _ta: bool = wm.set_app(state, tw, (&t_app[0]) as u64)
        wm.bind_tty(state, tw, tty.console())
        tty.set_window(state, tty.console(), tw)
        tty.set_sink(state, tty.console(), tty.SINK_WINDOW)
        serial.puts((&s_term[0]) as u64)
        serial.dec(tw)
        serial.puts((&s_cols[0]) as u64)
        serial.dec(wm.term_cols(state, tw))
        serial.puts((&s_rows[0]) as u64)
        serial.dec(wm.term_rows(state, tw))
        serial.puts((&s_cell[0]) as u64)
        serial.dec(560 / wm.term_cols(state, tw))
        serial.puts((&s_x[0]) as u64)
        serial.dec(380 / wm.term_rows(state, tw))
        serial.nl()
        // Zwei Zeilen, die IM FENSTER stehen und deren Stelle sich
        // ausrechnen laesst -- Zeile 0 und 1, Spalte 0. Genau das
        // rechnet `tools/wm/run.sh` bildpunktgenau gegen den
        // Referenzrasterer nach.
        // RUNDE MESSTAFEL: DIESE ZEILE LIEST DER BENUTZER, ALSO
        // TRAEGT SIE DEN SYSTEMNAMEN.
        //
        // RUNDE MARKE: und deshalb steht der Name jetzt nicht mehr
        // hier, sondern kommt aus `marke.conf`. Die vier
        // bildpunktgenauen Zusagen in `tools/wm/run.sh` lesen dieselbe
        // Datei -- eine Zusage auf einen fest getippten Namen waere
        // nach der ersten Umbenennung eine Zusage auf etwas, das es
        // nicht mehr gibt.
        var b1: [u8; 64] = [0 as u8; 64]
        var b1r: [u8; 14] = " K10 WM 0123\n\0"
        var n1: u64 = brand.anhaengen((&b1[0]) as u64, 0, brand.produkt(), 63)
        n1 = brand.anhaengen((&b1[0]) as u64, n1, (&b1r[0]) as u64, 63)
        var b2: [u8; 32] = "abcdefghijklm ABCDEFGHIJK +-*/\n\0"
        // RUNDE BLECH2: NICHT auf dem Schreibtisch. Dort will der
        // Mensch ein leeres Terminal mit einer Eingabeaufforderung;
        // die zwei Zeilen sind das Messmuster von tools/wm/run.sh, und
        // der faehrt `gfx wm` ohne `desk`.
        if !kstate.mode_on(state, kstate.M_DESK) {
            wm.term_write(state, tw, (&b1[0]) as u64, n1)
            wm.term_write(state, tw, (&b2[0]) as u64, 31)
        }
    }

    // Die Anwendung in Ring 3. Sie legt ihr Fenster SELBST an, ueber ein
    // Handle -- der Kernel gibt ihr keine Flaeche, sie holt sich eine.
    //
    // RUNDE K15: mit `wig` oder `wigfiles` bleibt sie WEG. Nicht aus
    // Schoenheit: `u_wclick` wartet in einer Schleife auf Ereignisse und
    // teilt sich einen Prozessor mit der Anwendung dieser Runde, und ihr
    // Fenster liegt genau dort, wo der Dateimanager steht.
    // ============ RUNDE BLECHEINGABE: WAS DER KERN AN USB SIEHT,
    // ============ IN DAS TERMINALFENSTER.
    //
    // Justins erste Forderung, woertlich: "Sag zuerst, WAS DER KERN
    // UEBERHAUPT SIEHT. Auf den SCHIRM (Terminalfenster oder Tafel,
    // nicht seriell)."
    //
    // Das Terminalfenster ist dafuer die RICHTIGE Flaeche, und das ist
    // nicht geraten: auf seinem Foto vom 04.09., 14:51 steht es oben
    // links mit dem vollen Protokoll -- es ist die einzige Flaeche
    // dieses Systems, von der BEWIESEN ist, dass sie bei ihm ankommt.
    // Die Messtafel kam auf demselben Foto nicht, die serielle Leitung
    // hat er gar nicht (Zeile 9 der Tafel misst das).
    st(18)
    usb_bericht(state, tw)
    st(19)

    // ============ RUNDE STANDBILD: DIE TAFEL, EINMAL, HIER.
    //
    // Das ist die letzte Zeile vor dem ersten Ring-3-Programm. Was
    // danach kommt, kann haengen; was hier steht, steht auf dem Schirm.
    tafel_boot(state, 2)
    st(20)

    var t: u64 = 0
    if !kstate.mode_on(state, kstate.M_WIG)
       && !kstate.mode_on(state, kstate.M_WIGFILES)
       && !kstate.mode_on(state, kstate.M_WIGSTART)
       && !kstate.mode_on(state, kstate.M_DESK)
       && !kstate.mode_on(state, kstate.M_TILESHOT) {
        t = proc.create(state, P_WCLICK, (w << 16) | h, 2)
        // Ein paar Marken, damit sie ihr Fenster wirklich anlegt, bevor
        // gemessen wird.
        sched.sleep_ticks(state, 12)
        wm.compose(state)
    } else if kstate.mode_on(state, kstate.M_DESK) {
        // RUNDE I18N: die Kostenmessung VOR den Programmen. Danach
        // schreiben drei Prozesse auf dieselbe serielle Leitung, und
        // eine Zahl, die zwischen zwei fremden Zeilen steht, liest kein
        // Laeufer mehr.
        st(21)
        i18n_bench(state, f_ui, PX_UI)
        st(22)
        t = desk_start(state)
        st(23)
    } else {
        t = k15_start(state)
    }

    // Die Shell im Terminalfenster -- auf ausdrueckliches Wort, weil sie
    // eine Platte braucht.
    st(24)
    if kstate.mode_on(state, kstate.M_WMSHELL) {
        let sh: u64 = shell_start(state)
        st(25)
        // RUNDE TAFEL: DIE SCHLEIFE WIRD IMMER BETRETEN, auch wenn die
        // Shell nicht kam. Vorher stand hier `if sh != 0` um den
        // ganzen Aufruf -- und damit hing der Schreibtisch am Gelingen
        // eines Prozessstarts. `wait_wm` entscheidet jetzt selbst: mit
        // `wmdauer` laeuft es weiter, ohne kehrt es sofort zurueck wie
        // bisher.
        var s_nosh: [u8; 24] = "wm: KEINE SHELL, weiter\0"
        if sh == 0 {
            serial.puts((&s_nosh[0]) as u64)
            serial.nl()
        }
        st(26)
        let code: u64 = wait_wm(state, sh, tw)
        st(40)
        if sh != 0 {
            serial.puts((&s_exit[0]) as u64)
            serial.dec(code)
            serial.nl()
        }
    }

    // Auf Verlangen: einige Glyphen als Text auf die Leitung, damit
    // `tools/wm/run.sh` den Rasterer selbst gegen die zweite Fassung
    // halten kann, ohne den Umweg ueber das Bild.
    if kstate.mode_on(state, kstate.M_TTFDUMP) {
        var char: [u8; 9] = "AVROegW.\0"
        var zi: u64 = 0
        while zi < 8 {
            say_glyph(state, f_tx, PX_MONO, char[zi as usize] as u64)
            zi = zi + 1
        }
    }
    if willtile && tileshot {
        wm.set_tile_on(state, true)
        tile_shot(state, w, h)
    }
    wm_bench(state, f_tx, PX_MONO)
    wm.damage_all(state)
    wm.compose(state)
    // RUNDE VSYNC: das letzte Bild MUSS noch auf den Schirm, bevor der
    // Testlaeufer fotografiert. Ohne diese Zeile bliebe mit `vsync`
    // genau das vorgemerkte Rechteck im Rueckpuffer liegen -- und das
    // Foto zeigte den vorletzten Zustand.
    let _gz2: u64 = wm.present(state)

    serial.puts((&s_stat[0]) as u64)
    serial.puts((&s_comp[0]) as u64)
    serial.dec(wm.composites(state))
    serial.puts((&s_blit[0]) as u64)
    serial.dec(wm.blits(state))
    serial.puts((&s_pix[0]) as u64)
    serial.dec(wm.pixels(state))
    serial.puts((&s_cache[0]) as u64)
    serial.dec(ttf.cache_used(state))
    serial.puts((&s_hit[0]) as u64)
    serial.dec(ttf.hits(state))
    serial.puts((&s_miss[0]) as u64)
    serial.dec(ttf.misses(state))
    serial.nl()
    // RUNDE VEKTOR: DIE BILDZEIT.
    //
    // Ohne diese Zeile war "kein Bild ueber 16 ms" eine Behauptung.
    // Der Mittelwert wird HIER gerechnet und nicht im Auswertskript,
    // damit beide dieselbe Zahl meinen; n == 0 heisst, es wurde nichts
    // zusammengesetzt (dann steht 0 da und nicht eine Division durch
    // null).
    serial.puts((&s_bz[0]) as u64)
    serial.puts((&s_bzn[0]) as u64)
    serial.dec(wm.frame_us_n(state))
    serial.puts((&s_bzm[0]) as u64)
    if wm.frame_us_n(state) > 0 {
        serial.dec(wm.frame_us_sum(state) / wm.frame_us_n(state))
    } else {
        serial.dec(0)
    }
    serial.puts((&s_bzus[0]) as u64)
    serial.puts((&s_bzx[0]) as u64)
    serial.dec(wm.frame_us_max(state))
    serial.puts((&s_bzus[0]) as u64)
    serial.puts((&s_bzu[0]) as u64)
    serial.dec(wm.frame_ueber16(state))
    serial.nl()
    // Das Histogramm: acht Faecher, je eine Verdoppelung ab 1 ms.
    // Ein Mittelwert verschweigt, ob die langen Bilder am Start
    // liegen oder im Betrieb; diese Zeile sagt es.
    serial.puts((&s_bzh[0]) as u64)
    var fi: u64 = 0
    while fi < 8 {
        serial.dec(wm.frame_fach(state, fi))
        serial.puts((&s_bzsp[0]) as u64)
        fi = fi + 1
    }
    serial.puts((&s_bzb[0]) as u64)
    serial.dec(wm.frame_us_maxw(state))
    serial.puts((&s_bzus[0]) as u64)
    serial.puts((&s_bzbu[0]) as u64)
    serial.dec(wm.frame_ueber16w(state))
    serial.nl()
    serial.puts((&s_wm[0]) as u64)
    serial.puts((&s_win[0]) as u64 + 2)
    serial.dec(wm.count(state))
    serial.puts((&s_focus[0]) as u64)
    serial.dec(wm.focus(state))
    serial.nl()

    // Stillhalten, damit ein Bildschirmfoto entsteht -- und dabei WEITER
    // den Zeiger verfolgen und zusammensetzen. Genau darin werden von
    // aussen ueber den QEMU-Monitor Mausereignisse eingespeist.
    if !kstate.mode_on(state, kstate.M_WMHOLD) {
        return
    }
    serial.puts((&s_hold[0]) as u64)
    serial.nl()
    // DIE WARTESCHLEIFE GIBT DIE MASCHINE HER, und das ist kein
    // Schoenheitsfehler, den man auch lassen koennte: die Anwendung in
    // Ring 3 laeuft in DIESER Zeit. Die erste Fassung wartete mit
    // `while apic.tsc() < bis {}` und liess den Zeitgeber die Aufgaben
    // umschalten -- die Anwendung bekam dabei so wenig Rechenzeit, dass
    // sie die Klickereignisse nicht mehr abholte. Im Bild sah man das
    // als fehlenden Klickfleck, und im Mitschnitt an nichts.
    let hz: u64 = apic.tsc_hz(state)
    // RUNDE K15: mit `wiglong` zwanzig statt fuenf Sekunden. Eine
    // Oberflaeche, in die von aussen dreissig Monitorbefehle gespeist
    // werden -- Bewegungen, Klicks, Tasten --, ist in fuenf Sekunden
    // nicht bedient, und ein Foto davon zeigt einen halben Vorgang.
    var sek: u64 = 5
    if kstate.mode_on(state, kstate.M_WIGLONG) {
        sek = 20
    }
    // RUNDE OBERFLAECHE: `wighalt=<sekunden>` sticht beide.  Die
    // Bestandsaufnahme holt sieben Ansichten aus EINEM Start und
    // klickt sich dazwischen durch; in zwanzig Sekunden ist das nicht
    // zu machen, und sieben einzelne Starts waeren sieben verschiedene
    // Uhrzeiten in der Leiste.  Die Zahl kommt aus `pmon`, weil die
    // Befehlszeile hier schon ueberschrieben sein kann.
    let halt: u64 = pmon.wighalt(state)
    if halt != 0 {
        sek = halt
    }
    var s_halt: [u8; 15] = "wm: halt sek=\0\0"
    serial.puts((&s_halt[0]) as u64)
    serial.dec(sek)
    serial.nl()
    // ADDENDUM TASKBAR: MAXIMIZE ONE SECOND IN, and not before the
    // loop. The taskbar is a program in ring 3; it needs the first
    // moments of the hold to read its configuration file, place itself
    // and declare its strut. A window maximized before that would be
    // measured against a work area that is still the whole screen, and
    // the measurement would pass for the wrong reason.
    var maxed: bool = false
    if hz != 0 {
        let ab: u64 = apic.tsc()
        let bis: u64 = ab + hz * sek
        while apic.tsc() < bis {
            if !maxed && kstate.mode_on(state, kstate.M_WMAX) {
                if apic.tsc() > ab + hz {
                    maxed = true
                    say_max(state)
                }
            }
            wm.poll(state)
            // ================================ RUNDE HOTPLUG
            // AUCH DAS HALTEN IST BETRIEB -- derselbe Befund wie in
            // `hold_a_moment` eine Seite weiter oben.
            //
            // In dieser Schleife laeuft die Abnahme der Oberflaeche:
            // von aussen kommen Klicks, Tasten -- und seit dieser
            // Runde auch ein STICK (`device_add` ueber den Monitor).
            // Ohne diese zwei Zeilen merkt der Kern den Anschluss
            // nicht: `port_watch` legt ihn im Zeitgeber ab, und
            // niemand holt ihn wieder. GEMESSEN: `events=1`,
            // `hotplugs=0`, und zwei Bildschirmfotos, die sich
            // Oktett fuer Oktett gleichen.
            usb.hotplug_work(state)
            wechsel_schritt(state)
            // MERGE-8: ALLTAG (Sperrer-Wache) und VSYNC (Bildgrenze)
            // haengen beide in dieser Halteschleife, unabhaengig
            // voneinander. Die Wache zuerst: sie kehrt ohne stehende
            // Sperre sofort zurueck und darf die Reihenfolge des
            // Takts (weiterstellen -> zeichnen -> EINMAL uebertragen)
            // nicht verschieben.
            // RUNDE ALLTAG: auch die Halteschleife ist eine Schleife,
            // in der der Sperrer sterben kann -- und die Abnahme
            // dieser Runde laeuft genau in ihr.
            sperre_wache(state)
            // RUNDE LOGIND: und der Abmeldewunsch, in derselben
            // Schleife und aus demselben Grund -- der Starter kann ihn
            // nur aufschreiben, ausfuehren muss ihn der Kern.
            abmelde_wache(state)
            // RUNDE VSYNC: DIE REIHENFOLGE IM TAKT, und sie ist der
            // ganze Punkt. Erst die Bewegungen weiterstellen (das
            // macht die betroffenen Bereiche schmutzig), dann
            // zeichnen, dann EINMAL uebertragen. `present` ist die
            // Bildgrenze: alles, was seit dem letzten Tick gezeichnet
            // wurde, geht zusammen auf den Schirm oder gar nicht.
            // RUNDE VSYNC: DIE FENSTERBEWEGUNG VORFUEHREN.
            //
            // `wmanim` laesst waehrend des Haltens ein Fenster
            // AUFGEHEN und spaeter wieder ZUGEHEN. Ohne so einen
            // Anlass gaebe es nichts zu messen: Fenster entstehen in
            // dieser Messung sonst vor dem Halten, und ein Foto vom
            // Ende einer Bewegung sieht aus wie eines ohne Bewegung.
            //
            // Die Zeitpunkte sind Ticks seit Beginn des Haltens, damit
            // der Ablauf bei jedem Lauf derselbe ist.
            if kstate.mode_on(state, kstate.M_WMANIM) {
                anim_vorfuehrung(state)
            }
            // RUNDE VSYNC: `wmruhe` -- das Fenster steht, das Bild
            // wechselt trotzdem. So misst die Zerreissprobe das
            // Uebertragen und nicht die Bewegung.
            if kstate.mode_on(state, kstate.M_WMRUHE) {
                wm.damage_all(state)
            }
            // RUNDE VIRTIOGPU: den Schirmwechsel-Weg einmal gehen.
            if kstate.mode_on(state, kstate.M_VGPUEREIG) {
                if vgpu_ereig_getan == 0 {
                    vgpu_ereig_getan = 1
                    let _e: bool = vgpu.ereignis_erzwingen(state)
                }
            }
            // RUNDE VIRTIOGPU: DIE TICKENDE UHR.
            //
            // Ein Rechteck von der Groesse einer Uhr in der Leiste,
            // unten rechts, in jedem Takt neu. Gemalt wird wirklich
            // (sonst waere der Schmutz gelogen), und zwar mit einer
            // Farbe, die sich je Takt aendert -- so steht im Bild
            // etwas anderes und nicht nur eine Schmutzmarke.
            if kstate.mode_on(state, kstate.M_VGPUUHR) {
                let uw: u64 = 96
                let uh: u64 = 20
                let ux: u64 = fb.width(state) - uw - 8
                let uy: u64 = fb.height(state) - uh - 4
                let t: u64 = kstate.get(state, kstate.TICKS)
                let c: u64 = fb.rgb(state, (t * 7) & 0xFF,
                    (t * 13) & 0xFF, 0x80)
                fb.fill(state, ux, uy, uw, uh, c)
                wm.damage(state, ux as i64, uy as i64,
                    (ux + uw) as i64, (uy + uh) as i64)
            }
            // RUNDE VIRTIOGPU: DER ZEIGERSTROM AUCH IN DIESER SCHLEIFE.
            //
            // `mausflut=<hz>` gab es seit Runde BLECH2, aber nur in der
            // Schreibtischschleife mit Ring 3 -- in der Halteschleife
            // (`wmhold`, die jede Messung dieser Runde benutzt) stand
            // der Zeiger still. Eine Messung der Uebertragung an einem
            // STEHENDEN Bild misst aber das Falsche: dort ist jede Zahl
            // klein, weil sich nichts aendert.
            //
            // Mit dieser Zeile bewegt sich der Zeiger auch beim Halten,
            // und `tools/vgpu/messen.sh` misst einen Schreibtisch, auf
            // dem wirklich etwas passiert.
            mausflut_schritt(state)
            mauslauf_schritt(state)
            let _offen: u64 = wm.anim_tick(state)
            // RUNDE VSYNC: DER ABLESER LIEST VOR UND NACH DEM MALEN.
            // Vorher steht das fertige Bild der letzten Runde auf der
            // Karte, nachher das neue -- und dazwischen liegt genau
            // die Uebertragung, um die es geht. Ohne Bildgrenze faellt
            // sie in viele kleine Schuebe auseinander, und dann findet
            // der Ableser die beiden Haelften verschieden.
            wm.leser_tick(state)
            wm.compose(state)
            wm.leser_tick(state)
            let _gz: u64 = wm.present(state)
            // RUNDE VIRTIOGPU: DIE UEBERTRAGUNG AN DER BILDGRENZE.
            //
            // `wm.present` hat das Schmutzrechteck des ganzen Bildes
            // angemeldet; HIER geht es hinaus, in EINEM
            // `TRANSFER_TO_HOST_2D` und EINEM `RESOURCE_FLUSH`. Ohne
            // Grafiktreiber ist die Zeile ein Nichts -- dann hat
            // `wm.present` die Bildpunkte schon selbst kopiert.
            //
            // Die Stelle ist mit Bedacht NACH `wm.present` und nicht
            // darin: `wm.fi` ist der Fensterserver und soll von
            // Geraeten nichts wissen. Die Naht ist `gfx.fi`.
            gfx.bild_fertig(state)
            wm.leser_tick(state)
            sched.sleep_ticks(state, 1)
        }
    }
    wm.damage_all(state)
    wm.compose(state)
    // RUNDE SOFTUI: DIE ZWEITE MESSUNG, UND WARUM ES SIE GEBEN MUSS.
    //
    // `wm_bench` oben laeuft, BEVOR die Taskleiste in Ring 3 ihre
    // Formmarken schickt -- zu dem Zeitpunkt ist der Radius 0 und die
    // Schattenstaerke 0, und die Zahl beschreibt einen Bildaufbau, den
    // auf einer eingerichteten Maschine niemand je sieht. Sie ist nicht
    // falsch, sie beantwortet nur eine andere Frage.
    //
    // Diese hier laeuft NACH dem Halten: die Taskleiste hat geredet,
    // `shape=modern` steht in den vier Formwoertern, und der gemessene
    // Bildaufbau ist der mit runden Ecken und Schatten. Genau der
    // Unterschied zwischen den beiden Zahlen ist der Preis der Form.
    wm_bench2(state)
    say_vsync(state)
    say_gpu(state)
    vgpu.say(state)
    serial.puts((&s_go[0]) as u64)
    serial.nl()
    say_wm_input(state)
    say_mauslauf(state)
    say_wig(state)
    say_wins(state)
    let _unused: u64 = t
}

// RUNDE VSYNC: DER ANLASS FUER DIE FENSTERBEWEGUNG.
//
// Zwei Schritte, an festen Ticks seit dem Beginn des Haltens: bei 50
// (eine halbe Sekunde) geht ein Fenster AUF, bei 150 wieder ZU. Beide
// Male ueber `wm.open_anim` bzw. `wm.close_anim`, also genau ueber den
// Weg, den eine Anwendung nehmen wuerde.
//
// Warum feste Ticks und keine Zufallszahl: der Ablauf muss bei jedem
// Lauf derselbe sein, sonst vergleicht die Bildserie zwei verschiedene
// Vorgaenge.
fn anim_vorfuehrung(state: u64) {
    let t: u64 = kstate.get(state, kstate.TICKS)
    let ab: u64 = wm.before_t0(state)
    if ab == 0 {
        wm.set_before_t0(state, t)
        return
    }
    let seit: u64 = t - ab
    let schritt: u64 = wm.before_step(state)
    if seit >= 50 && schritt == 0 {
        wm.set_before_step(state, 1)
        var s_t: [u8; 9] = "Aufgehen\0"
        let i: u64 = wm.create(state, 0, 220, 180, 320, 200, wm.K_RAW,
            (&s_t[0]) as u64)
        if i < wm.MAX_WIN {
            // Eine Flaeche, auf der man das Wachsen SIEHT: ohne
            // Fuellung waere das Zwischenbild schwarz auf schwarz.
            wm.fill(state, i, 0, 0, 320, 200, 0x2E6FD9)
            wm.fill(state, i, 20, 20, 280, 160, 0xE8EEF7)
            wm.set_before_win(state, i + 1)
            let _a: bool = wm.open_anim(state, i)
        }
    }
    if seit >= 150 && schritt == 1 {
        wm.set_before_step(state, 2)
        let w: u64 = wm.before_win(state)
        if w != 0 {
            let _c: bool = wm.close_anim(state, w - 1)
        }
    }
}

// RUNDE VSYNC: der Ableser, von `gfx` gerufen und damit von JEDEM
// gestarteten Kern. Eine Zeile Weiterleitung -- die Sache selbst steht
// im Fensterserver, weil nur er weiss, wo ein Fenster liegt.
fn leser_tick(state: u64) {
    wm.leser_tick(state)
}

// RUNDE VSYNC: DIE ZAHLEN DER BILDGRENZE UND DER BEWEGUNG.
//
// Eine Zeile, und jede Zahl darin beantwortet eine Frage, die man sonst
// nur behaupten koennte:
//
//   vsync=    ist die Bildgrenze an?
//   comp=     wie oft wurde gezeichnet
//   pres=     wie oft wirklich uebertragen. Mit Bildgrenze MUSS diese
//             Zahl KLEINER sein als `comp` -- sonst hat das Sammeln
//             nichts gesammelt und die Trennung ist eine Behauptung.
//   pend=     wie viele Zeichnungen ohne eigene Uebertragung blieben
//   anim=     begonnene Fensterbewegungen
//   frames=   ihre Zwischenbilder. Bei 120 ms und TICK_HZ=100 sind
//             ungefaehr zwoelf je Bewegung zu erwarten; steht hier 0,
//             hat es keine Bewegung gegeben, sondern einen Sprung.
//   ticks=    wie oft der Bewegungstakt lief
//   sig=      Signaturbetrieb, und die Nummer des letzten Bildes
// ================================================ RUNDE VIRTIOGPU
// DIE UEBERTRAGUNGSWAAGE ALS EINE ZEILE.
//
// Diese Zeile ist der ganze Messwert der Runde, und sie steht
// absichtlich getrennt von `wm: vsync=`: die Zahlen dort beschreiben
// den Fensterserver, diese hier den WEG ZUM SCHIRM. Sie wird in
// BEIDEN Betriebsarten gedruckt -- mit virtio-gpu und ohne --, aus
// derselben Quelle und mit derselben Rechnung. Nur so ist "vorher
// gegen nachher" ein Vergleich und keine Gegenueberstellung zweier
// verschiedener Messungen.
//
//   okt=     Oktette, die insgesamt hinausgetragen wurden
//   rect=    in wie vielen Rechtecken/Streifen
//   bilder=  wie viele BILDER daraus wurden (wm.present-Durchlaeufe)
//   je=      okt/bilder -- DIE ZAHL, um die es geht
//   weg=     0 = Rahmenpuffer der Firmware, 1 = virtio-gpu
fn say_gpu(state: u64) {
    var s_a: [u8; 10] = "gpu: okt=\0"
    var s_b: [u8; 9] = "  rect=\0\0"
    var s_c: [u8; 11] = "  bilder=\0\0"
    var s_d: [u8; 7] = "  je=\0\0"
    var s_e: [u8; 8] = "  weg=\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(fb.tx_octets(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(fb.tx_rects(state))
    serial.puts((&s_c[0]) as u64)
    serial.dec(fb.frames(state))
    serial.puts((&s_d[0]) as u64)
    if fb.frames(state) != 0 {
        serial.dec(fb.tx_octets(state) / fb.frames(state))
    } else {
        serial.dec(0)
    }
    serial.puts((&s_e[0]) as u64)
    // 0 = Rahmenpuffer der Firmware, 1 = virtio-gpu. Aus `fb.fi`
    // gelesen und nicht aus dem Treiber: die Weiche steht dort, und
    // wer die Zahl meldet, soll sie an derselben Stelle holen, an der
    // sie auch wirkt.
    if fb.on_vgpu(state) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()
}

fn say_vsync(state: u64) {
    var s_a: [u8; 12] = "wm: vsync=\0\0"
    var s_b: [u8; 8] = "  comp=\0"
    var s_c: [u8; 8] = "  pres=\0"
    var s_d: [u8; 8] = "  pend=\0"
    var s_e: [u8; 8] = "  anim=\0"
    var s_f: [u8; 10] = "  frames=\0"
    var s_g: [u8; 9] = "  ticks=\0"
    var s_h: [u8; 7] = "  sig=\0"
    var s_i: [u8; 9] = "  frame=\0"
    var s_j: [u8; 10] = "  motion=\0"
    var s_k: [u8; 9] = "  liest=\0"
    var s_l: [u8; 9] = "  risse=\0"
    var s_m: [u8; 8] = "  flip=\0"
    var s_n: [u8; 9] = "  flips=\0"
    var s_o: [u8; 8] = "  r_ob=\0"
    var s_p: [u8; 8] = "  r_un=\0"
    var s_q: [u8; 11] = "  ohnesig=\0"
    var s_r: [u8; 8] = "  halt=\0"
    var s_ps: [u8; 10] = "  pxsum=\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(bool_num(wm.vsync_on(state)))
    serial.puts((&s_b[0]) as u64)
    serial.dec(wm.composites(state))
    serial.puts((&s_c[0]) as u64)
    serial.dec(wm.presents(state))
    serial.puts((&s_ps[0]) as u64)
    serial.dec(wm.pxsum(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(wm.skipped(state))
    serial.puts((&s_e[0]) as u64)
    serial.dec(wm.anims(state))
    serial.puts((&s_f[0]) as u64)
    serial.dec(wm.anim_frames(state))
    serial.puts((&s_g[0]) as u64)
    serial.dec(wm.anim_ticks(state))
    serial.puts((&s_h[0]) as u64)
    serial.dec(bool_num(wm.sig_on(state)))
    serial.puts((&s_i[0]) as u64)
    serial.dec(wm.frame_no(state))
    serial.puts((&s_j[0]) as u64)
    serial.dec(wm.form(state, wm.FM_MOTION))
    serial.puts((&s_k[0]) as u64)
    serial.dec(wm.liest(state))
    serial.puts((&s_l[0]) as u64)
    serial.dec(wm.risse(state))
    serial.puts((&s_m[0]) as u64)
    serial.dec(bool_num(fb.flip_on(state)))
    serial.puts((&s_n[0]) as u64)
    serial.dec(fb.flips(state))
    serial.puts((&s_o[0]) as u64)
    serial.dec(wm.tear_top(state))
    serial.puts((&s_p[0]) as u64)
    serial.dec(wm.tear_bottom(state))
    serial.puts((&s_q[0]) as u64)
    serial.dec(wm.without_sig(state))
    // RUNDE UHRWERK, nachgemessen: wie viele Zeichnungen auf EINE
    // Sekunde Halten kamen. Die Runde UHRWERK hat 4,3/s gemessen und
    // diese Sparsamkeit ausdruecklich als Gut bezeichnet -- diese Zahl
    // ist die Gegenprobe, dass die Bildgrenze sie nicht verschlechtert
    // hat. `halt` ist die Haltedauer in Sekunden.
    serial.puts((&s_r[0]) as u64)
    serial.dec(halt_secs(state))
    var s_v: [u8; 12] = "  verworf=\0\0"
    serial.puts((&s_v[0]) as u64)
    serial.dec(wm.verworfen(state))
    if wm.risse(state) != 0 {
        var s_w: [u8; 10] = "  rissy0=\0"
        var s_x: [u8; 7] = "  y1=\0\0"
        var s_y: [u8; 8] = "  bild=\0"
        serial.puts((&s_w[0]) as u64)
        serial.dec(wm.riss_y0(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(wm.riss_y1(state))
        serial.puts((&s_y[0]) as u64)
        serial.dec(wm.riss_frame(state))
    }
    serial.nl()
}

// Wie lange gehalten wurde, in Sekunden -- dieselbe Rechnung wie im
// Halten selbst, damit die Rate daneben nicht aus zwei Quellen kommt.
fn halt_secs(state: u64) -> u64 {
    let h: u64 = pmon.wighalt(state)
    if h != 0 {
        return h
    }
    if kstate.mode_on(state, kstate.M_WIGLONG) {
        return 20
    }
    return 5
}

fn bool_num(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

//
// MAXIMIZE THE TOPMOST ORDINARY WINDOW AND SAY WHAT CAME OF IT. The
// point of the exercise is the pair of rectangles that follows: the
// window that fills the work area, and the bar that owns the edge. If
// the strut works they touch and do not overlap; with `nostrut` the
// window is the whole screen and the bar is under it.
fn say_max(state: u64) {
    var s_a: [u8; 16] = "wm: max win=\0\0\0\0"
    var s_b: [u8; 6] = " ok=\0\0"
    var s_c: [u8; 6] = " wx=\0\0"
    var s_d: [u8; 6] = " wy=\0\0"
    var s_e: [u8; 6] = " ww=\0\0"
    var s_f: [u8; 6] = " wh=\0\0"
    var s_t: [u8; 10] = "Maximized\0"
    // A WINDOW OF ITS OWN AND NOT THE ONE THAT HAPPENS TO BE ON TOP.
    // The first version maximized the topmost application window and
    // got `ok=0` every time, for a reason worth keeping: a window keeps
    // the buffer it was created with, the starter asked for 440 x 300,
    // and 796 x 568 does not fit into it. That is the server refusing
    // to lie, not a defect -- so the measurement gets a window that was
    // created large enough, and the refusal keeps its meaning.
    let i: u64 = wm.create(state, 0, 0, 0, wm.max_w(state),
        wm.max_h(state), wm.K_RAW,
        (&s_t[0]) as u64)
    if i >= wm.MAX_WIN {
        return
    }
    wm.fill(state, i, 0, 0, wm.max_w(state), wm.max_h(state),
        fb.rgb(state, 0x24, 0x50, 0x30))
    let ok: bool = wm.maximize(state, i, true)
    wm.damage_all(state)
    wm.compose(state)
    serial.puts((&s_a[0]) as u64)
    serial.dec(i)
    serial.puts((&s_b[0]) as u64)
    serial.dec(bnum(ok))
    serial.puts((&s_c[0]) as u64)
    serial.dec(wm.work_x(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(wm.work_y(state))
    serial.puts((&s_e[0]) as u64)
    serial.dec(wm.work_w(state))
    serial.puts((&s_f[0]) as u64)
    serial.dec(wm.work_h(state))
    serial.nl()
}

//
// WAS WIRKLICH IN DER FENSTERTAFEL STEHT, Satz fuer Satz, auf die
// serielle Leitung. Ohne das waere jede Aussage dieser Runde ueber
// Ebenen und ueber Minimieren eine Aussage ueber etwas, das man im Bild
// gerade NICHT sieht -- ein verborgenes Fenster ist im Bild
// ununterscheidbar von einem geschlossenen.
//
//   wm: win nr=<platz> id=<nummer> z=<stufe> layer=<ebene> hidden=<0/1>
//       deco=<0/1> x= y= w= h= focus=<0/1> t=[<titel>]
fn say_wins(state: u64) {
    var s_a: [u8; 12] = "wm: win nr=\0"
    var s_b: [u8; 6] = " id=\0\0"
    var s_c: [u8; 5] = " z=\0\0"
    var s_d: [u8; 9] = " layer=\0\0"
    var s_e: [u8; 10] = " hidden=\0\0"
    var s_f: [u8; 8] = " deco=\0\0"
    var s_g: [u8; 5] = " x=\0\0"
    var s_h: [u8; 5] = " y=\0\0"
    var s_i: [u8; 5] = " w=\0\0"
    var s_j: [u8; 5] = " h=\0\0"
    var s_k: [u8; 9] = " focus=\0\0"
    var s_l: [u8; 6] = " t=[\0\0"
    var s_m: [u8; 4] = "]\0\0\0"
    var s_n: [u8; 16] = "wm: wins n=\0\0\0\0\0"
    var s_o: [u8; 10] = " hides=\0\0\0"
    var s_p: [u8; 10] = " shows=\0\0\0"
    var s_q: [u8; 12] = " nolayer=\0\0\0"
    var s_r: [u8; 10] = " nomin=\0\0\0"
    var s_s1: [u8; 8] = " strut=\0"
    var s_s2: [u8; 12] = " strutedge=\0"
    var s_s3: [u8; 6] = " max=\0"
    var s_s4: [u8; 6] = " ow=\0\0"
    var s_s5: [u8; 6] = " oh=\0\0"
    var s_w1: [u8; 16] = "wm: work x=\0\0\0\0\0"
    var i: u64 = 0
    while i < wm.MAX_WIN {
        if wm.valid(state, i) {
            serial.puts((&s_a[0]) as u64)
            serial.dec(i)
            serial.puts((&s_b[0]) as u64)
            serial.dec(wm.win_id(state, i))
            serial.puts((&s_c[0]) as u64)
            serial.dec(wm.win_z(state, i))
            serial.puts((&s_d[0]) as u64)
            serial.dec(wm.win_layer(state, i))
            serial.puts((&s_e[0]) as u64)
            serial.dec(bnum(wm.win_hidden(state, i)))
            serial.puts((&s_f[0]) as u64)
            serial.dec(bnum(wm.win_deco(state, i)))
            serial.puts((&s_g[0]) as u64)
            serial.dec(wm.win_x(state, i) as u64)
            serial.puts((&s_h[0]) as u64)
            serial.dec(wm.win_y(state, i) as u64)
            serial.puts((&s_i[0]) as u64)
            serial.dec(wm.win_w(state, i))
            serial.puts((&s_j[0]) as u64)
            serial.dec(wm.win_h(state, i))
            serial.puts((&s_k[0]) as u64)
            serial.dec(bnum(wm.focus(state) == i))
            serial.puts((&s_s1[0]) as u64)
            serial.dec(wm.win_strut_size(state, i))
            serial.puts((&s_s2[0]) as u64)
            serial.dec(wm.win_strut_edge(state, i))
            serial.puts((&s_s3[0]) as u64)
            serial.dec(bnum(wm.is_max(state, i)))
            serial.puts((&s_s4[0]) as u64)
            serial.dec(wm.outer_w(state, i))
            serial.puts((&s_s5[0]) as u64)
            serial.dec(wm.outer_h(state, i))
            serial.puts((&s_l[0]) as u64)
            serial.puts(wm.win_title(state, i))
            serial.puts((&s_m[0]) as u64)
            serial.nl()
        }
        i = i + 1
    }
    serial.puts((&s_n[0]) as u64)
    serial.dec(wm.count(state))
    serial.puts((&s_o[0]) as u64)
    serial.dec(wm.hides(state))
    serial.puts((&s_p[0]) as u64)
    serial.dec(wm.shows(state))
    serial.puts((&s_q[0]) as u64)
    serial.dec(bnum(wm.nolayer(state)))
    serial.puts((&s_r[0]) as u64)
    serial.dec(bnum(wm.nomin(state)))
    serial.nl()
    // THE WORK AREA, from the server itself. The taskbar says the same
    // thing from ring 3 (`taskbar: work`); the two lines must agree,
    // and the runner checks that they do.
    serial.puts((&s_w1[0]) as u64)
    serial.dec(wm.work_x(state))
    serial.puts((&s_h[0]) as u64)
    serial.dec(wm.work_y(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(wm.work_w(state))
    serial.puts((&s_j[0]) as u64)
    serial.dec(wm.work_h(state))
    serial.puts((&s_q[0]) as u64)
    serial.dec(bnum(wm.nostrut(state)))
    serial.nl()
}

// EIN PROGRAMM VON DER PLATTE STARTEN, mit genau einem Argument. Die
// drei Zeilen standen in `k15_start` viermal untereinander; hier
// stehen sie einmal.
// ================================================== RUNDE WERKZEUGE
// `wigapp=` UND SEINE ARGUMENTE, EINMAL ZERLEGT.
//
//     wigapp=/bin/taskmgr,melde,takt,300
//
// Warum ein Komma und kein Leerzeichen: die Kernkommandozeile IST durch
// Leerzeichen getrennt -- `pmon.take_wigapp` holt genau EIN Wort. Ein
// zweites Trennzeichen innerhalb dieses Wortes kostet die Schleife hier
// unten und keine neue Regel.
//
// WARUM ES DAS BRAUCHT: ohne Argumente laesst sich ein Programm mit
// Fenster nur in seiner Grundeinstellung messen. Der Aufgabenverwalter
// soll fuer den Testlauf jeden Durchgang MELDEN und oefter messen als
// einmal je Sekunde -- beides sind Argumente, und beides waere sonst je
// ein neuer Schalter im Kern gewesen, den die naechste Runde wieder
// verdoppelt. Genau diese Ueberlegung hat `wigapp=` selbst
// hervorgebracht (Runde POWERMON, drei fest verdrahtete Namen).
//
// ZERLEGT WIRD AN EINER STELLE, weil es zwei Leser gibt: `k15_start`
// (ein einzelnes Fenster im Fensterserver) und `desk_start` (dasselbe
// Programm zusaetzlich zum Schreibtisch, damit ein Bild von der
// Taskleiste UND der Anwendung entstehen kann).
static mut wg_path: [u8; 64] = [0 as u8; 64]
static mut wg_args: [u8; 128] = [0 as u8; 128]
static mut wg_len: u64 = 0 // belegte Oktette in wg_args
static mut wg_argc: u64 = 0
static mut wg_da: u64 = 0 // 1 = auf der Kommandozeile stand ein wigapp=

fn wigapp_zerlegen(state: u64) {
    wg_da = 0
    wg_len = 0
    wg_argc = 0
    let wa: u64 = pmon.wigapp(state)
    if wa == 0 {
        return
    }
    var slash: u64 = 0
    var kommas: u64 = 0
    var wargs: u64 = 0 // Stelle hinter dem ersten Komma, 0 = keines
    var wi: u64 = 0
    while wi < 63 && kstate.get8(wa + wi) != 0 {
        var c: u64 = kstate.get8(wa + wi)
        if c == 44 {
            // Jedes Komma wird zur Null: damit steht in `wg_path` schon
            // die Form, die `abuf` verlangt -- Zeichenkette, Null,
            // Zeichenkette, Null.
            c = 0
            kommas = kommas + 1
            if wargs == 0 {
                wargs = wi + 1
            }
        }
        wg_path[wi as usize] = c as u8
        if c == 47 && wargs == 0 {
            slash = wi + 1
        }
        wi = wi + 1
    }
    var wj: u64 = 0
    while wj < 31 && wg_path[(slash + wj) as usize] != 0 as u8 {
        wg_args[wj as usize] = wg_path[(slash + wj) as usize]
        wj = wj + 1
    }
    if wj == 0 {
        return
    }
    // DIE NULL GEHOERT DAZU. Jede andere Stelle, die hier ein Argument
    // hinlegt, zaehlt sie mit (`a_nohit` ist 6 Oktette fuer fuenf
    // Buchstaben). Ohne sie klebte das zweite Argument am ersten; es
    // fiel bis zu dieser Runde nicht auf, weil `wigapp=` nie ein
    // zweites hatte und `abuf` mit Nullen anfaengt.
    wg_args[wj as usize] = 0 as u8
    wg_len = wj + 1
    wg_argc = 1
    wg_da = 1
    if wargs == 0 {
        return
    }
    var wp: u64 = wargs
    while wp < 63 && wg_path[wp as usize] != 0 as u8 && wg_len < 120 {
        var wl: u64 = 0
        while wp + wl < 63 && wg_path[(wp + wl) as usize] != 0 as u8
              && wg_len < 120 {
            wg_args[wg_len as usize] = wg_path[(wp + wl) as usize]
            wg_len = wg_len + 1
            wl = wl + 1
        }
        wg_args[wg_len as usize] = 0 as u8
        wg_len = wg_len + 1
        wg_argc = wg_argc + 1
        wp = wp + wl + 1
    }
}

// ====================================================== RUNDE BLECH2
// DAS PROTOKOLL DER SCHREIBTISCHPROGRAMME GEHT AUF DIE LEITUNG, NICHT
// IN DAS TERMINAL DES MENSCHEN.
//
// Justins Foto vom 05.09. 22:46: das Terminalfenster ist beim Start
// voll mit `taskbar: text ...`, `taskbar: btn ...`, `taskbar: state ...`
// -- Messzeilen der Leiste, die ueber fd 1 in die Konsole (SINK_WINDOW)
// und damit in SEIN Fenster liefen. Die Zeilen sind richtig, und
// tools/desktop/run.sh liest sie -- von der SERIELLEN LEITUNG, nicht
// aus dem Fenster. Also bekommen die Programme, die der Schreibtisch
// selbst startet (desktop, taskbar, launcher, settings, dhcp), fuer
// fd 1 und fd 2 ein eigenes Terminal, dessen Ausgabe NUR auf die
// Leitung geht (`tty.alloc_log`, SINK_SERIAL). Auf der Leitung steht
// Oktett fuer Oktett dasselbe wie vorher.
//
// WAS SIE STARTEN, BEKOMMT WIEDER DIE KONSOLE: `file.inherit_std`
// tauscht das Protokoll-Terminal beim Vererben gegen die
// Konsoleneintraege (kstate.LOGOPEN). Ein `sh` aus dem Startmenue
// schreibt damit wie bisher in das Terminalfenster.
//
// Die Runde PROTOKOLL baut parallel einen Ringpuffer-Log; sobald der
// da ist, ist `alloc_log` die eine Stelle, die ihn statt der Leitung
// nimmt.
static mut log_open: u64 = 0

fn protokoll_binden(state: u64, task: u64) {
    if task == 0 {
        return
    }
    if log_open == 0 {
        let t: u64 = tty.alloc_log(state)
        if t >= tty.MAX_TTY {
            return
        }
        // 1 = O_WRONLY (sys.fi) -- `kgui` darf `sys` nicht einbinden.
        let of: u64 = file.open_alloc(state, file.K_TTY, t, 1)
        if of >= file.MAX_OPEN {
            return
        }
        log_open = of
        kstate.set(state, kstate.LOGOPEN, of)
        var s_p: [u8; 21] = "desk: protokoll tty=\0"
        var s_o: [u8; 5] = " of=\0"
        serial.puts((&s_p[0]) as u64)
        serial.dec(t)
        serial.puts((&s_o[0]) as u64)
        serial.dec(of)
        serial.nl()
    }
    // Unter gesperrten Unterbrechungen: das Kind darf seine erste Zeile
    // nicht schreiben, bevor sein fd 1 umgehaengt ist.
    let fl: u64 = sched.irq_save()
    var fd: u64 = 1
    while fd < 3 {
        file.open_ref(state, log_open)
        file.fd_free(state, task, fd)
        if !file.fd_set(state, task, fd, log_open) {
            file.open_unref(state, log_open)
        }
        fd = fd + 1
    }
    sched.irq_restore(fl)
}

// ====================================================== RUNDE BLECH2
// `mausflut=<hz>` -- EIN ZEIGERSTROM AUS DEM KERN, MIT ECHTER RATE.
//
// Die QMP-Maus von QEMU (tools/metal2/maus.py) belastet den Weg
// xHCI -> Bericht -> ps2m -> wm mit ECHTEN Berichten, aber das
// Mausgeraet von QEMU fasst Bewegungen zwischen zwei Abfragen zu einem
// Bericht zusammen: im Gast kommen rund hundert je Sekunde an. Justins
// Spielmaus meldet bis zu tausend. Dieses Wort erzeugt genau diese Rate
// im Kern selbst: je Marke (100 Hz) hz/100 Pakete in `ps2m.usb_packet`,
// jedes sofort durch `wm.on_mouse` -- so wie ein USB-Bericht seit dieser
// Runde auch (hidin.maus_melden -> gfx.mouse_now). Der Zeiger faehrt
// waagerecht ueber den Schreibtisch hin und her, auf zwei Dritteln der
// Hoehe (Terminal und Schreibtisch, nicht die Leiste), und alle 250
// Pakete faellt ein Linksklick. Die Klicks stehen in `ps2m.clicks` --
// Tafelzeile 2 `K` -- und muessen als `kl=` (E_DOWN eingereiht) wieder
// herauskommen: kein Klick verloren, gezaehlt.
static mut vgpu_ereig_getan: u64 = 0
static mut mausflut_hz: u64 = 0
// RUNDE GPU (G-012): `mauslauf=<n>` -- EIN GEZAEHLTER ZEIGERLAUF.
//
// WARUM ES DEN GEBEN MUSS, UND ES IST EINE GEMESSENE NOT: `mausflut`
// haengt an der UHR (`marken * hz / 100`). Auf einem Wirt unter Last
// -- und auf diesem laufen acht Runden gleichzeitig, Lastmittel ueber
// 10 bei 20 Kernen -- kommt die Uhr unregelmaessig voran. DREI Laeufe
// mit DEMSELBEN Kern und DERSELBEN Zeile ergaben packets=0, 0 und 1;
// ein vierter, frueherer, ergab 21. Eine Waage, die bei gleicher Last
// verschiedene Zahlen zeigt, wiegt nichts.
//
// `mauslauf=<n>` schickt GENAU n Zeigerpakete, so schnell die Schleife
// laeuft, ohne die Uhr zu fragen. Damit ist die Zahl der Bewegungen
// eine ZUSAGE und keine Beobachtung -- und die Messung vergleichbar.
static mut mauslauf_soll: u64 = 0
static mut mauslauf_ist: u64 = 0
static mut mauslauf_start: u64 = 0
static mut mauslauf_us: u64 = 0
static mut mausflut_marke: u64 = 0
static mut mausflut_links: u64 = 0
static mut mausflut_n: u64 = 0
static mut mausflut_klicks: u64 = 0

fn parse(state: u64, cmd: u64) {
    if cmd == 0 {
        return
    }
    var w: [u8; 10] = "mausflut=\0"
    var i: u64 = 0
    while i < 4096 && kstate.get8(cmd + i) != 0 {
        var k: u64 = 0
        while k < 9 && kstate.get8(cmd + i + k) == (w[k as usize] as u64) {
            k = k + 1
        }
        if k == 9 {
            var v: u64 = 0
            var j: u64 = i + 9
            var n: u64 = 0
            while n < 6 && kstate.get8(cmd + j) >= 48
                && kstate.get8(cmd + j) <= 57 {
                v = v * 10 + (kstate.get8(cmd + j) - 48)
                j = j + 1
                n = n + 1
            }
            mausflut_hz = v
            return
        }
        i = i + 1
    }
    var w2: [u8; 10] = "mauslauf=\0"
    var i2: u64 = 0
    while i2 < 4096 && kstate.get8(cmd + i2) != 0 {
        var k2: u64 = 0
        while k2 < 9 && kstate.get8(cmd + i2 + k2) == (w2[k2 as usize] as u64) {
            k2 = k2 + 1
        }
        if k2 == 9 {
            var v2: u64 = 0
            var j2: u64 = i2 + 9
            var n2: u64 = 0
            while n2 < 7 && kstate.get8(cmd + j2) >= 48
                && kstate.get8(cmd + j2) <= 57 {
                v2 = v2 * 10 + (kstate.get8(cmd + j2) - 48)
                j2 = j2 + 1
                n2 = n2 + 1
            }
            mauslauf_soll = v2
            return
        }
        i2 = i2 + 1
    }
}

// DER GEZAEHLTE LAUF. Gibt `true` zurueck, solange er noch nicht fertig
// ist -- die Halteschleife fragt danach, ob sie weiterlaufen muss.
fn mauslauf_offen() -> bool {
    return mauslauf_soll != 0 && mauslauf_ist < mauslauf_soll
}

fn mauslauf_zahl() -> u64 {
    return mauslauf_ist
}

fn mauslauf_dauer() -> u64 {
    return mauslauf_us
}

fn mauslauf_schritt(state: u64) {
    if mauslauf_soll == 0 || !wm.ready(state) {
        return
    }
    if mauslauf_ist >= mauslauf_soll {
        return
    }
    if mauslauf_ist == 0 {
        ps2m.adopt(state, fb.width(state), fb.height(state))
        ps2m.set_pos(state, fb.width(state) / 2, fb.height(state) * 2 / 3)
        mauslauf_start = time.mono_ns(state)
    }
    // EIN Paket je Aufruf. Die Halteschleife ruft oft genug; mehrere
    // je Aufruf wuerden die Bilder zusammenfassen und genau den
    // Unterschied verwischen, den diese Messung sehen will.
    var b0: u64 = 8
    var dx: u64 = 3
    if mausflut_links != 0 {
        dx = 253
        b0 = b0 | 0x10
    }
    var dy: u64 = 0
    if (mauslauf_ist % 14) == 0 {
        dy = 1
    }
    if (mauslauf_ist % 14) == 7 {
        dy = 255
        b0 = b0 | 0x20
    }
    ps2m.usb_packet(state, b0, dx, dy, 0, false)
    if ps2m.changed(state) {
        let _c: bool = ps2m.take_change(state)
        wm.on_mouse(state)
    }
    let x: u64 = ps2m.x(state)
    if x + 16 >= fb.width(state) {
        mausflut_links = 1
    }
    if x <= 16 {
        mausflut_links = 0
    }
    mauslauf_ist = mauslauf_ist + 1
    mauslauf_us = (time.mono_ns(state) - mauslauf_start) / 1000
}

fn mausflut_klickzahl() -> u64 {
    return mausflut_klicks
}

fn mausflut_schritt(state: u64) {
    if mausflut_hz == 0 || !wm.ready(state) {
        return
    }
    let jetzt: u64 = kstate.get(state, kstate.TICKS)
    if mausflut_marke == 0 {
        // Der erste Schritt stellt den Zeiger auf die Schreibtischflaeche.
        ps2m.adopt(state, fb.width(state), fb.height(state))
        ps2m.set_pos(state, fb.width(state) / 2, fb.height(state) * 2 / 3)
        mausflut_marke = jetzt
        return
    }
    if jetzt <= mausflut_marke {
        return
    }
    var marken: u64 = jetzt - mausflut_marke
    if marken > 10 {
        marken = 10
    }
    mausflut_marke = jetzt
    var k: u64 = marken * mausflut_hz / 100
    while k > 0 {
        var b0: u64 = 8
        var dx: u64 = 3
        if mausflut_links != 0 {
            dx = 253
            b0 = b0 | 0x10
        }
        var dy: u64 = 0
        if (mausflut_n % 14) == 0 {
            dy = 1
        }
        if (mausflut_n % 14) == 7 {
            dy = 255
            b0 = b0 | 0x20
        }
        if (mausflut_n % 250) == 0 {
            b0 = b0 | ps2m.B_LEFT
            mausflut_klicks = mausflut_klicks + 1
        }
        ps2m.usb_packet(state, b0, dx, dy, 0, false)
        if ps2m.changed(state) {
            let _c: bool = ps2m.take_change(state)
            wm.on_mouse(state)
        }
        let x: u64 = ps2m.x(state)
        if x + 16 >= fb.width(state) {
            mausflut_links = 1
        }
        if x <= 16 {
            mausflut_links = 0
        }
        mausflut_n = mausflut_n + 1
        k = k - 1
    }
}

fn desk_spawn(state: u64, pfad: u64, arg: u64, n: u64) -> u64 {
    return desk_spawn_n(state, pfad, arg, n, 1)
}

// RUNDE NETVIEW, NACHTRAG: DASSELBE MIT MEHR ALS EINEM ARGUMENT. Bis
// hierher stand die Eins fest im Aufruf von `elf.spawn`, weil jedes
// Programm des Schreibtischs genau seinen eigenen Namen bekam.
// `/bin/netview faked /bin/widgetdemo` sind drei, und `n` war schon immer
// die Zahl der OKTETTE und nie die der Argumente -- die beiden waren
// nur nie zu unterscheiden, weil es immer eines war.
fn desk_spawn_n(state: u64, pfad: u64, arg: u64, n: u64,
    argc: u64) -> u64 {
    let abuf: u64 = state + kstate.EARG_OFF
    var k: u64 = 0
    while k < n {
        kstate.set8(abuf + k, kstate.get8(arg + k) as u8)
        k = k + 1
    }
    let pid: u64 = elf.spawn(state, pfad, abuf, argc, 2)
    protokoll_binden(state, pid)
    let z: u64 = serial.line_at(sched.hier(state))
    var s_st: [u8; 13] = "desk: start \0"
    var s_pid: [u8; 7] = "  pid=\0"
    var s_cpu: [u8; 8] = "  kern=\0"
    serial.puts((&s_st[0]) as u64)
    serial.puts(pfad)
    serial.puts((&s_pid[0]) as u64)
    serial.dec(pid)
    serial.puts((&s_cpu[0]) as u64)
    serial.dec(sched.hier(state))
    // RUNDE MERGE-6: DER BLOCK DER RUNDE WERKZEUGE STEHT HIER NICHT
    // ZWEIMAL. Sie hat denselben Fehler gefunden wie VIELKERN 3 --
    // `pid=0` ohne Grund -- und dieselbe Abhilfe gebaut
    // (`elf.say_reason` aus `kstate.ELF_ERR`). Genommen ist die von
    // VIELKERN 3, elf Zeilen weiter unten: sie steht NACH `serial.nl`
    // und `zeile_aus`, und `say_reason` schreibt eine eigene Zeile.
    // Zweimal gerufen stuende der Grund zweimal auf der Leitung, und
    // jeder Laeufer, der Zeilen zaehlt, zaehlte falsch.
    serial.nl()
    serial.line_clear(z)
    // =================================================== RUNDE VIELKERN 3
    // EIN FEHLSCHLAG, DER NICHTS SAGT, IST KEINE MESSUNG.
    //
    // Die Vorrunde stand vor `pid=0` und hatte nichts weiter: keine
    // `elf: start`-Zeile, keine Ausnahme, kein Grund. `elf.build` legt
    // den Grund seit jeher in `kstate.ELF_ERR` ab, und `sys.do_exec`
    // liest ihn auch aus -- nur der Weg aus dem Kern heraus (der
    // Schreibtisch) tat es nicht. Von hier an sagt er ihn.
    if pid == 0 {
        elf.say_reason(kstate.get(state, kstate.ELF_ERR))
    }
    return pid
}

fn i18n_bench(state: u64, f: u64, px: u64) {
    var s_a: [u8; 21] = "i18n: draw ascii us=\0"
    var s_u: [u8; 20] = "i18n: draw utf8 us=\0"
    var s_g: [u8; 22] = "i18n: draw glyphs us=\0"
    var s_r: [u8; 8] = " reps=\0\0"
    var s_n: [u8; 8] = " chars=\0"
    // Vierzig Zeichen -- die Laenge einer Beschriftung dieser
    // Oberflaeche, gemessen an "Der Bildmodus wird beim Start gesetzt".
    var zeile: [u8; 42] = "Der Bildmodus wird beim Start gesetzt; im\0"
    if f >= ttf.MAX_FONTS || apic.tsc_hz(state) == 0 {
        return
    }
    let p: u64 = (&zeile[0]) as u64
    // Erst einmal warmlaufen -- der Glyphenspeicher soll bei BEIDEN
    // Messungen voll sein, sonst misst die erste die Rasterung mit.
    let _w0: i64 = ttf.text_width26(state, f, p, 40, px)
    var t: u64 = apic.tsc()
    var i: u64 = 0
    var acc: i64 = 0
    while i < I18N_LINES {
        acc = acc + ttf.text_width26_bytes(state, f, p, 40, px)
        i = i + 1
    }
    let alt: u64 = us_of(state, apic.tsc() - t)
    t = apic.tsc()
    i = 0
    while i < I18N_LINES {
        acc = acc + ttf.text_width26(state, f, p, 40, px)
        i = i + 1
    }
    let neu: u64 = us_of(state, apic.tsc() - t)
    // Und das wirkliche Zeichnen derselben Zeile, als Massstab: je
    // Zeichen eine Glyphe aus dem Speicher holen ist das, was `wm.text`
    // ausser der Schleife noch tut.
    t = apic.tsc()
    i = 0
    while i < I18N_LINES {
        var k: u64 = 0
        while k < 40 {
            let _sl: u64 = ttf.glyph(state, f, kstate.get8(p + k), px)
            k = k + 1
        }
        i = i + 1
    }
    let zeichnen: u64 = us_of(state, apic.tsc() - t)
    serial.puts((&s_a[0]) as u64)
    serial.dec(alt)
    serial.puts((&s_r[0]) as u64)
    serial.dec(I18N_LINES)
    serial.puts((&s_n[0]) as u64)
    serial.dec(40)
    serial.nl()
    serial.puts((&s_u[0]) as u64)
    serial.dec(neu)
    serial.puts((&s_r[0]) as u64)
    serial.dec(I18N_LINES)
    serial.puts((&s_n[0]) as u64)
    serial.dec(40)
    serial.nl()
    serial.puts((&s_g[0]) as u64)
    serial.dec(zeichnen)
    serial.puts((&s_r[0]) as u64)
    serial.dec(I18N_LINES)
    serial.nl()
    if acc == 0 {
        serial.nl()
    }
}

// DER SCHREIBTISCH. Vier Programme von der Platte, in dieser
// Reihenfolge, und die Reihenfolge ist keine Laune:
//
//   1. /bin/schreibtisch  legt das Fenster auf Ebene 0 an. Es entsteht
//      als erstes und ist trotzdem HINTEN -- ohne Ebenen ginge das
//      nicht, und genau das ist die Zusage dieser Runde.
//   2. /bin/leiste        legt ihres auf Ebene 2 an. Es entsteht als
//      zweites und bleibt trotzdem VORN, auch wenn danach noch drei
//      Fenster aufgehen.
//   3. /bin/launcher       ein gewoehnliches Fenster dazwischen.
//   4. /bin/einstellungen nur auf Wort (`einst`), und /bin/dhcp nur
//      auf Wort (`dhcp`) -- der DHCP-Lauf braucht eine Karte, und
//      nicht jeder Messlauf hat eine.
// ================= RUNDE MESSTAFEL: DIE SPRACHE, BEVOR JEMAND FRAGT
//
// `msg.fi` liest die Sprache in dieser Reihenfolge:
//   1. /users/<name>/config/locale   die Wahl des Benutzers
//   2. /etc/locale.conf              die Vorgabe des Systems
//   3. `en`                          die Quellsprache
//
// Der Bau schreibt `de` in (1). Diese Funktion ueberschreibt (1) --
// und zwar VOR dem ersten Ring-3-Programm, damit Schreibtisch,
// Taskleiste, Starter und Einstellungen alle dieselbe Sprache lesen.
// Es wird KEIN zweiter Weg zur Sprache gebaut: die Datei bleibt die
// einzige Wahrheit, sie wird nur vorher richtig gestellt.
//
// Ohne `lang=` passiert hier nichts -- ein Stick ohne den Schalter
// verhaelt sich Oktett fuer Oktett wie vorher.
// ===================================================== RUNDE TUERSCHLOSS
//
// DIE TASTATUR FOLGT DER SPRACHE, und zwar hier und an keiner zweiten
// Stelle.
//
// GEMESSEN (Runde DURCHKLICK, Punkt 6.2): die Oberflaeche kam
// durchgehend deutsch hoch -- "Programm suchen:", "Ausfuehren" mit
// echtem `ue`, 100 % Trefferquote -- und die Tastatur stand dabei auf
// `L_US`. `KB_LAYOUT` wird nirgends gesetzt, und ein nicht gesetztes
// Feld ist null, und null ist `L_US`. Wer `z` drueckt, bekommt `y`;
// `@`, `ue`, `oe`, `ae`, `ss` liegen falsch. Der deutsche Satz liegt in
// `kbd.fi` fertig da (`de_code`, `de_shift`, `de_altgr`) -- er war nur
// nie die Vorgabe.
//
// WARUM IN DIESER FUNKTION. Sie ist die Stelle, an der die Sprache
// dieses Laufes feststeht, und sie laeuft VOR dem ersten
// Ring-3-Programm. Die Belegung wird damit aus DERSELBEN Quelle
// abgeleitet wie die Texte -- es entsteht kein zweiter Weg zur Sprache,
// und `settings` kann sie nachher weiter mit `kbd.set_layout`
// umstellen (der Zaehler `KB_SWITCH` zaehlt beides).
fn tastatur_zur_sprache(state: u64, en: bool) {
    var lay: u64 = kbd.L_DE
    if en {
        lay = kbd.L_US
    }
    var s_kb: [u8; 18] = "kbd: layout de␀␀␀\0"
    if en {
        s_kb[12 as usize] = 101 as u8 // 'e'
        s_kb[13 as usize] = 110 as u8 // 'n'
    }
    if kbd.set_layout(state, lay) {
        serial.puts((&s_kb[0]) as u64)
        serial.nl()
    }
}

fn locale_set(state: u64) {
    let en: bool = kstate.mode_on(state, kstate.M_LANGEN)
    let de: bool = kstate.mode_on(state, kstate.M_LANGDE)
    // DIE BELEGUNG WIRD IMMER GESETZT, auch ohne `lang=` auf der
    // Kommandozeile: der Bau schreibt `de` in
    // /users/root/config/locale, die Oberflaeche kommt deutsch hoch,
    // und die Tastatur hat dann deutsch zu sein. `lang=en` dreht beides
    // zusammen um -- Sprache und Belegung koennen nicht auseinander
    // laufen, weil sie aus demselben `en` folgen.
    tastatur_zur_sprache(state, en)
    if !en && !de {
        return
    }
    var pfad: [u8; 26] = "/users/root/config/locale\0"
    var t_en: [u8; 4] = "en\n\0"
    var t_de: [u8; 4] = "de\n\0"
    var s_ok: [u8; 16] = "locale: gesetzt\0"
    var s_sp: [u8; 2] = " \0"
    var s_rc: [u8; 5] = " rc=\0"
    let ino: u64 = fs.path(state, (&pfad[0]) as u64)
    if ino == 0 {
        var s_no: [u8; 27] = "locale: keine Datei dafuer\0"
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    fs.file_truncate(state, ino)
    var q: u64 = (&t_de[0]) as u64
    if en {
        q = (&t_en[0]) as u64
    }
    let n: u64 = fs.write_at(state, ino, 0, q, 3)
    serial.puts((&s_ok[0]) as u64)
    serial.puts((&s_sp[0]) as u64)
    serial.text(q, 2)
    serial.puts((&s_rc[0]) as u64)
    serial.dec(n)
    serial.nl()
}

fn desk_start(state: u64) -> u64 {
    locale_set(state)
    var p_desk: [u8; 13] = "/bin/desktop\0"
    var p_task: [u8; 13] = "/bin/taskbar\0"
    var p_star: [u8; 14] = "/bin/launcher\0"
    var p_set: [u8; 14] = "/bin/settings\0"
    var p_dhcp: [u8; 10] = "/bin/dhcp\0"
    var p_jv: [u8; 13] = "/bin/jarvisd\0"
    var a_desk: [u8; 8] = "desktop\0"
    var a_task: [u8; 8] = "taskbar\0"
    // ==================================== RUNDE ECHTHARDWARE-4
    // DER STARTER KOMMT UNSICHTBAR HOCH.
    //
    // Auf JEDEM Belegbild aus ECHTHARDWARE-3 klebte "Search
    // programs" unten links am Schreibtisch -- weil hier nur
    // "starter" mitging und das Fenster damit sichtbar aufmachte.
    // Ein Startmenue steht nicht herum; es kommt auf Super oder
    // Klick aufs Logo und geht danach wieder zu. Das zweite Wort
    // `versteckt` schaltet genau das (launcher.fi, `wlib.win_hide`).
    // Zwei Argumente heisst: 18 Oktette, argc = 2.
    var a_star: [u8; 18] = "starter\0versteckt\0"
    var a_set: [u8; 9] = "settings\0"
    // RUNDE ECHTHARDWARE-6: ZWEI WOERTER, und das zweite ist der
    // Unterschied zwischen "einmal gefragt" und "bekommt eine
    // Adresse". `dauer` laesst den Klienten nach einem Fehlschlag
    // spaeter neu anlaufen, statt das System fuer immer auf der
    // Notadresse 169.254.x.x stehenzulassen. Justins Tafel `Dd` sagt,
    // dass gefragt wurde und niemand antwortete -- im Lauf davor
    // antwortete derselbe Router. Zwei Argumente heisst: 11 Oktette,
    // argc = 2.
    var a_dhcp: [u8; 11] = "dhcp\0dauer\0"
    // RUNDE MERGE-11: EIN Argument, der Helfer laeuft dauerhaft.
    var a_jv: [u8; 8] = "jarvisd\0"
    // ================================================ RUNDE ANMELDUNG
    //
    // WER DEN SCHREIBTISCH STARTET, ENTSCHEIDET, UNTER WELCHER KENNUNG
    // ER LAEUFT -- und das ist der ganze Befund P-002.
    //
    // Bis hierher stand hier EIN Aufruf: `/bin/desktop`, gestartet aus
    // der Startaufgabe des Kerns. Ein Kind erbt uid und gid seines
    // Erzeugers (`sched.fi`, T_UID/T_GID in `proc.create`), und die
    // Startaufgabe ist uid 0. Also lief der Schreibtisch als root, und
    // mit ihm die Taskleiste, der Starter und alles, was von dort
    // gestartet wird. Wer den Deckel aufklappte, war Verwalter.
    //
    // MIT `anmeldung` STARTET HIER `/bin/glogin` STATTDESSEN. Der
    // Anmeldeschirm fragt Namen und Kennwort, prueft gegen
    // /etc/shadow (PBKDF2, `pw.check_hash` -- dieselbe Funktion, die
    // `login` am Terminal nimmt), legt Zusatzgruppen, Gruppe und
    // Kennung ab und startet DANN `/bin/desktop`. Der Schreibtisch ist
    // von da an ein Kind des angemeldeten Menschen.
    //
    // DIE TASKLEISTE STARTET DER KERN WEITER SELBST, und das ist eine
    // ehrliche Grenze dieser Runde: sie laeuft damit weiter als root.
    // Warum sie nicht auch aus `glogin` kommt, steht in
    // docs/RUNDE-ANMELDUNG.md Abschnitt 6 -- kurz: sie legt
    // /etc/taskbar.conf an und liest /proc, und beides gehoert vor dem
    // Umzug geprueft. Der Schreibtisch ist der Prozess, an dem der
    // Mensch arbeitet; er ist der, der zuerst herunter musste.
    var p_glog: [u8; 13] = "/bin/glogin\0\0"
    var a_glog: [u8; 8] = "glogin\0\0"
    var s_anm: [u8; 33] = "desk: anmeldung vor schreibtisch\0"
    var s_root: [u8; 35] = "desk: OHNE anmeldung -- uid bleibt\0"
    var anmelden: bool = kstate.mode_on(state, kstate.M_ANMELDUNG)
        && !kstate.mode_on(state, kstate.M_NOANMELDUNG)
    var pid: u64 = 0
    if anmelden {
        serial.puts((&s_anm[0]) as u64)
        serial.nl()
        pid = desk_spawn(state, (&p_glog[0]) as u64,
            (&a_glog[0]) as u64, 8)
    } else {
        serial.puts((&s_root[0]) as u64)
        serial.nl()
        pid = desk_spawn(state, (&p_desk[0]) as u64,
            (&a_desk[0]) as u64, 8)
    }
    // Dem Schreibtisch Zeit geben, sein Fenster anzulegen und seine
    // Ebene zu setzen, BEVOR die Leiste kommt. Ohne das ist die
    // Reihenfolge in der Tafel eine Frage des Zufalls, und eine
    // Messung ueber eine Reihenfolge, die sich bei jedem Lauf anders
    // einstellt, misst nichts.
    var runden: u64 = 0
    while runden < 250 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    let _l: u64 = desk_spawn(state, (&p_task[0]) as u64,
        (&a_task[0]) as u64, 8)
    runden = 0
    while runden < 250 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    if !kstate.mode_on(state, kstate.M_NOSTART) {
        pid = desk_spawn_n(state, (&p_star[0]) as u64,
            (&a_star[0]) as u64, 18, 2)
    }
    // RUNDE WERKZEUGE: `wigapp=` GILT AUCH AUF DEM SCHREIBTISCH.
    //
    // Ohne den Schreibtisch startet `wigapp=` EIN Fenster ANSTELLE von
    // allem anderen (Runde POWERMON) -- gut fuer eine Messung, aber es
    // gibt dann keine Taskleiste, kein Startmenue und keinen zweiten
    // Prozess, den man beenden koennte. Genau das braucht die Abnahme
    // dieser Runde aber: der Beweis, dass der Knopf "Prozess beenden"
    // wirklich einen Prozess beendet, ist ein Bild VORHER und eines
    // NACHHER, und dafuer muss es ein Opfer geben.
    //
    // Also: hier startet dasselbe Programm ZUSAETZLICH, nach der Leiste
    // und dem Starter. Ohne `wigapp=` aendert sich keine Zeile.
    wigapp_zerlegen(state)
    if wg_da != 0 {
        pid = desk_spawn_n(state, (&wg_path[0]) as u64,
            (&wg_args[0]) as u64, wg_len, wg_argc)
    }
    if kstate.mode_on(state, kstate.M_EINST) {
        pid = desk_spawn(state, (&p_set[0]) as u64,
            (&a_set[0]) as u64, 9)
    }
    // RUNDE THEME: das Messprogramm mit eigenem Fenster. Es schaltet
    // hell und dunkel um und meldet, was ein Bild dabei gekostet hat.
    if kstate.mode_on(state, kstate.M_THEMEGUI)
       || kstate.mode_on(state, kstate.M_THEMESHOT) {
        // DER DATEIMANAGER GEHOERT MIT AUFS BILD. Das Bildschirmfoto
        // dieser Runde soll zeigen, was ein Thema wirklich anfasst:
        // eine Liste mit Kopfzeile und Auswahl, ein Fenster mit
        // Widgets und einen Dialog -- nicht eine leere Flaeche.
        // RUNDE MERGE-2: NUR BEI `themegui`, NICHT BEI `themeshot`.
        //
        // Gemessen an tools/look/run.sh, Abschnitt A2a: der
        // Dateimanager legt sich mit seinem Suchfenster und seiner
        // Nachfrage UEBER die Themenprobe (z=4,5,6 gegen z=3), und auf
        // dem Bild steht an der Stelle, an der `Übernehmen` gemeldet
        // wird, nichts als die Flaeche des Managers. Der Pruefer meldet
        // dann "526 von 526 Tintenpunkten falsch" und man sucht den
        // Fehler im Zeichensatz.
        //
        // `themegui` ist die Messfassung und will die volle Buehne --
        // dort bleibt der Manager. `themeshot` heisst "NUR DAS BILD"
        // (kernel/user/themetest.fi), und dazu gehoert, dass nichts
        // davorsteht.
        if kstate.mode_on(state, kstate.M_THEMEGUI) {
            var p_ex: [u8; 14] = "/bin/explorer\0"
            var a_ex: [u8; 9] = "explorer\0"
            let _e: u64 = desk_spawn(state, (&p_ex[0]) as u64,
                (&a_ex[0]) as u64, 9)
        }
        var p_tg: [u8; 15] = "/bin/themetest\0"
        var a_tg: [u8; 14] = "themetest\0gui\0"
        var a_ts: [u8; 15] = "themetest\0shot\0"
        if kstate.mode_on(state, kstate.M_THEMESHOT) {
            pid = desk_spawn_n(state, (&p_tg[0]) as u64,
                (&a_ts[0]) as u64, 15, 2)
        } else {
            pid = desk_spawn_n(state, (&p_tg[0]) as u64,
                (&a_tg[0]) as u64, 14, 2)
        }
    }
    if kstate.mode_on(state, kstate.M_DHCP) {
        let _d: u64 = desk_spawn(state, (&p_dhcp[0]) as u64,
            (&a_dhcp[0]) as u64, 11)
    }
    // ================================================ RUNDE MERGE-11
    // DER JARVIS-HELFER, NACH dem DHCP.
    //
    // Die Reihenfolge ist kein Zufall: `jarvisd` loest beim Verbinden
    // `store.fleitec.com` auf, und dafuer braucht es einen
    // Nameserver. Den schreibt `/bin/dhcp` in /etc/resolv.conf. Startet
    // der Helfer vorher, meldet er "der Name laesst sich nicht
    // aufloesen" -- gemessen in tools/bridge2/https443.sh, erster
    // Anlauf. Er versucht es zwar erneut, aber eine vermeidbare
    // Fehlermeldung beim Start ist eine, die jemand fuer den Fehler
    // haelt.
    if kstate.mode_on(state, kstate.M_JARVIS) {
        let _j: u64 = desk_spawn(state, (&p_jv[0]) as u64,
            (&a_jv[0]) as u64, 8)
    }
    // ================================================== RUNDE MERGE-6
    // HIER STAND DERSELBE START EIN ZWEITES MAL.
    //
    // OBERFLAECHE und WERKZEUGE haben unabhaengig voneinander dieselbe
    // Luecke geschlossen -- `wigapp=` galt bis dahin nur auf dem
    // Fensterserver-Pfad (`k15_start`) und nicht auf dem Schreibtisch --
    // und beide haben ihren Block an eine andere Stelle dieser Funktion
    // geschrieben. Git hat beide behalten, und das Programm startete
    // ZWEIMAL. GEMESSEN, `wigapp=/bin/taskmgr,melde,takt,500`:
    //
    //     desk: start /bin/taskmgr                   pid=8
    //     desk: start /bin/taskmgr,melde,takt,500    pid=0
    //
    // Genommen ist der Block der Runde WERKZEUGE, dreissig Zeilen
    // weiter oben, und zwar aus einem Grund, den man an diesen zwei
    // Zeilen ablesen kann: er ZERLEGT die Argumente am Komma
    // (`wigapp_zerlegen`), der hier stehende nahm die ganze
    // Zeichenkette als Pfad. Das ist die `pid=0`-Zeile -- ein Pfad
    // namens "/bin/taskmgr,melde,takt,500" gibt es nicht.
    //
    // Die Wirkung war nicht nur eine Zeile zu viel: der Aufgabenverwalter
    // lief dadurch OHNE `melde`, meldete also keine einzige seiner
    // Zeilen, und acht Zusagen der Runde WERKZEUGE fielen, ohne dass
    // etwas an ihm kaputt gewesen waere.
    //
    // DREI PROGRAMME UNTER DREI SICHTEN, damit ein Bildschirmfoto die
    // eigentliche Zusage dieser Runde zeigen kann: VIER Anwendungen
    // gleichzeitig, jede mit einer anderen Vorstellung davon, ob es ein
    // Netz gibt. Der Starter, den der Schreibtisch ohnehin aufmacht,
    // ist die vierte -- er laeuft `real` und traegt darum KEIN Zeichen.
    //
    // `/bin/locate` stand hier zuerst und war falsch: das ist der
    // Namensindex auf der Kommandozeile und macht kein Fenster auf. Der
    // erste Lauf zeigte drei Knoepfe statt vier, und das ist der Grund,
    // warum diese Runde die Zahl der Knoepfe MISST und nicht ansieht.
    //
    // Sie gehen durch `/bin/netview` und nicht ueber einen eigenen
    // Weg: das ist derselbe Ablauf, den die Shell, der Starter und der
    // Dateimanager nehmen, und ein Messaufbau, der einen anderen Weg
    // nimmt, misst den anderen Weg.
    if kstate.mode_on(state, kstate.M_NETVDEMO) {
        netv_demo(state)
    }
    runden = 0
    while runden < 500 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    return pid
}

// RUNDE NETVIEW, NACHTRAG: drei Fenster, drei Sichten. Die Argumente
// stehen hintereinander mit je einer Null dazwischen, so wie
// `desk_spawn` sie erwartet.
fn netv_demo(state: u64) {
    var p_nv: [u8; 13] = "/bin/netview\0"
    var a_flt: [u8; 31] = "netview\0filtered\0/bin/explorer\0"
    var a_fak: [u8; 30] = "netview\0faked\0/bin/widgetdemo\0"
    var a_non: [u8; 27] = "netview\0none\0/bin/settings\0"
    let _a: u64 = desk_spawn_n(state, (&p_nv[0]) as u64,
        (&a_flt[0]) as u64, 31, 3)
    var runden: u64 = 0
    while runden < 200 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    // MERGE FIX: the blob is 30 octets since /bin/wigdemo became
    // /bin/widgetdemo. The 27 was the old length and cut the path off
    // after "/bin/widgetde" -- the faked window never started, and the
    // taskbar had no button carrying the `faked` mark.
    let _b: u64 = desk_spawn_n(state, (&p_nv[0]) as u64,
        (&a_fak[0]) as u64, 30, 3)
    runden = 0
    while runden < 200 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    let _c: u64 = desk_spawn_n(state, (&p_nv[0]) as u64,
        (&a_non[0]) as u64, 27, 3)
    runden = 0
    while runden < 400 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
}

// RUNDE K15: DIE ANWENDUNG DIESER RUNDE STARTEN. Sie kommt von der
// PLATTE und ist keine eingebaute Aufgabe -- die Widget-Bibliothek ist
// eine Bibliothek in Ring 3, und ein Programm, das sie benutzt, ist ein
// gewoehnliches Programm. `/bin/files` ist der Dateimanager,
// `/bin/widgetdemo` die Anwendung, die jedes Widget einmal hinstellt und
// ueber die serielle Leitung meldet, was sie sieht.
//
// Die beiden Gegenproben gehen als ARGUMENT mit. Das ist die ehrliche
// Stelle dafuer: `nohit` schaltet die Trefferpruefung der Bibliothek ab
// (ein Klick landet dann bei keinem Widget), `noclip` die
// Zwischenablage. Beides liegt in Ring 3, also wird es in Ring 3
// abgeschaltet.
fn k15_start(state: u64) -> u64 {
    var p_files: [u8; 14] = "/bin/explorer\0"
    var p_demo: [u8; 16] = "/bin/widgetdemo\0"
    var p_start: [u8; 14] = "/bin/launcher\0"
    var p_spei: [u8; 14] = "/bin/speicher\0"
    var a_files: [u8; 9] = "explorer\0"
    var a_demo: [u8; 11] = "widgetdemo\0"
    var a_start: [u8; 9] = "launcher\0"
    var a_spei: [u8; 9] = "speicher\0"
    var p_icons: [u8; 12] = "/bin/icont\0\0"
    var a_icons: [u8; 6] = "icont\0"
    var a_nohit: [u8; 6] = "nohit\0"
    var a_noclip: [u8; 7] = "noclip\0"
    var a_nokeys: [u8; 7] = "nokeys\0"
    var a_noidx: [u8; 6] = "noidx\0"
    let abuf: u64 = state + kstate.EARG_OFF
    var pfad: u64 = (&p_demo[0]) as u64
    var arg0: u64 = (&a_demo[0]) as u64
    var n0: u64 = 11
    if kstate.mode_on(state, kstate.M_WIGFILES) {
        pfad = (&p_files[0]) as u64
        arg0 = (&a_files[0]) as u64
        n0 = 9
    }
    if kstate.mode_on(state, kstate.M_WIGSTART) {
        pfad = (&p_start[0]) as u64
        arg0 = (&a_start[0]) as u64
        n0 = 9
    }
    if kstate.mode_on(state, kstate.M_WIGSPEICHER) {
        pfad = (&p_spei[0]) as u64
        arg0 = (&a_spei[0]) as u64
        n0 = 9
    }
    // ROUND ICONS: the program that measures the icon font.
    if kstate.mode_on(state, kstate.M_WIGICONS) {
        pfad = (&p_icons[0]) as u64
        arg0 = (&a_icons[0]) as u64
        n0 = 6
    }
    // ROUND POWERMON: `wigapp=/bin/NAME` starts THAT program in the
    // window server instead of one of the three above. Not a new bit in
    // `kstate.MODE` -- that word has two bits left out of sixty-four and
    // a dozen rounds are working on this tree at once. And not a fourth
    // hard-wired name either: the next round that wants to show a window
    // would need a fifth, and the one after that a sixth. The path is
    // read out of the command line, the name after the last slash
    // becomes argv[0], and nothing here has to change again.
    wigapp_zerlegen(state)
    if wg_da != 0 {
        pfad = (&wg_path[0]) as u64
        arg0 = (&wg_args[0]) as u64
        n0 = wg_len
    }
    var at: u64 = 0
    var k: u64 = 0
    while k < n0 {
        kstate.set8(abuf + at, kstate.get8(arg0 + k) as u8)
        at = at + 1
        k = k + 1
    }
    var argc: u64 = 1
    if wg_da != 0 {
        argc = wg_argc
    }
    if kstate.mode_on(state, kstate.M_WIGNOHIT) {
        k = 0
        while k < 6 {
            kstate.set8(abuf + at, a_nohit[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    if kstate.mode_on(state, kstate.M_WIGNOCLIP) {
        k = 0
        while k < 7 {
            kstate.set8(abuf + at, a_noclip[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    if kstate.mode_on(state, kstate.M_WIGNOKEYS) {
        k = 0
        while k < 7 {
            kstate.set8(abuf + at, a_nokeys[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    if kstate.mode_on(state, kstate.M_WIGNOIDX) {
        k = 0
        while k < 6 {
            kstate.set8(abuf + at, a_noidx[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    let pid: u64 = elf.spawn(state, pfad, abuf, argc, 2)
    var s_k15: [u8; 12] = "k15: start \0"
    var s_pid: [u8; 7] = "  pid=\0"
    serial.puts((&s_k15[0]) as u64)
    serial.puts(pfad)
    serial.puts((&s_pid[0]) as u64)
    serial.dec(pid)
    serial.nl()
    if pid == 0 {
        elf.say_reason(kstate.get(state, kstate.ELF_ERR))
    }
    // Der Anwendung Zeit geben, ihr Fenster anzulegen und einmal zu
    // malen, BEVOR gemessen wird -- sie liest dazu die Platte.
    var runden: u64 = 0
    while runden < 400 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    return pid
}

// Was die Naht in diesem Lauf wirklich getan hat. Die Zahlen sind die
// Gegenprobe zu jeder Aussage ueber die Bereichsverfolgung: `blits` ist,
// wie oft Ring 3 ein Rechteck herueber geschoben hat, `pixels` wie viele
// Bildpunkte das waren -- und das ist NICHT dasselbe wie die Bildpunkte,
// die der Server danach zusammengesetzt hat.
// RUNDE ALLTAG: nachsehen, ob der Sperrer noch da ist.
//
// Nicht in jeder Runde: `find_pid` laeuft ueber die Aufgabentafel, und
// die Schleife hier dreht sich hundertmal in der Sekunde. Alle 32
// Runden reicht -- laenger als ein Wimpernschlag ist die Luecke nie,
// und in dieser Luecke ist die Sperre trotzdem dicht (der
// Fensterserver laesst nichts durch, wm.darf).
static mut sp_takt: u64 = 0

// RUNDE ANMELDUNG: DIE WACHE DARF SICH NICHT SELBST BETRETEN.
//
// GEMESSEN am Abnahmelauf vom 13.09.: nach EINEM Druck auf Super+L
// standen ZWEI Sperrer im Bericht --
//
//     desk: start /bin/lock  pid=7 ... sperre: Sperrer neu, pid=7
//     desk: start /bin/lock  pid=8 ... sperre: Sperrer neu, pid=8
//
// URSACHE, und sie ist keine Frage der Zeit, sondern der Verschachtelung:
// `sperre_wache` ruft `desk_spawn`, und `desk_spawn` dreht 250 Runden
// `wm.poll` + `wm.compose` + `sleep_ticks`, damit das neue Fenster
// entstehen kann. Die Halteschleife (Zeile ~2188) und die Hauptschleife
// (~3701) rufen die Wache aber BEIDE -- und waehrend der 250 Runden
// kommt die andere Schleife dran, sieht `SP_PID` noch unveraendert
// (es wird erst NACH `desk_spawn` gesetzt) und startet einen zweiten.
//
// EIN ZWEITER SPERRER IST NICHT HARMLOS: nur EINER steht in `SP_PID`,
// also darf nur einer aufsperren. Der andere liegt mit seinem Fenster
// darueber, nimmt die Tastatur an und weist jedes richtige Kennwort mit
// `-EPERM` ab -- genau das stand im Lauf als
// "sperre: falsches Kennwort, bleibt zu", obwohl das Kennwort stimmte.
//
// DIE ABHILFE IST EIN RIEGEL UND KEINE WARTEZEIT. Eine Wartezeit waere
// geraten; dieser Riegel ist eine Zusage: solange ein Start laeuft,
// startet niemand einen zweiten.
static mut sp_startet: u64 = 0

// ============================================== RUNDE LOGIND (P-002)
// ABMELDEN -- DIE SITZUNG BEENDEN UND DEN ANMELDESCHIRM ZURUECKHOLEN.
//
// Diese Funktion steht aus DEMSELBEN GRUND im Kern wie `sperre_wache`
// darunter: sie braucht Rechte, die der Bittsteller nicht hat. Der
// Starter laeuft als uid 1000; `glogin` muss als root laufen, weil es
// /etc/shadow (0600 root) liest. Wer abgibt, bekommt nicht zurueck --
// also tut es der, der die Rechte nie abgegeben hat.
//
// WAS SIE TUT, IN DIESER REIHENFOLGE:
//
//   1. die Puffer schreiben (`sync`). Ein Abmelden beendet Programme,
//      und ein Programm, dessen Datei noch im Speicher steht, verliert
//      sie sonst. Das ist derselbe Gedanke wie beim Ausschalten.
//   2. JEDE Aufgabe der Sitzung beenden -- alles, dessen T_UID die
//      Kennung aus SP_UID ist. Das ist der Schreibtisch UND alles, was
//      der Mensch von dort gestartet hat; ein Abmelden, das die
//      Programme des Vorgaengers weiterlaufen laesst, ist keines.
//      SIGKILL und nicht SIGTERM: hier wartet niemand auf eine Frist,
//      und ein Programm, das den Abschied verweigert, haelt sonst die
//      Sitzung offen.
//   3. die Sperre raeumen. Stand sie (der Mensch hat vom
//      Sperrbildschirm aus abgemeldet), waere sonst der Anmeldeschirm
//      unter einem Sperrbildschirm begraben, dessen Sperrer gerade
//      gestorben ist -- und `sperre_wache` wuerde ihn brav neu
//      starten. Gemessen ist das eine schwarze Flaeche, auf der kein
//      Kennwort hilft.
//   4. SP_UID auf 0. Es gibt keine Sitzung mehr, und der
//      Sperrbildschirm faellt damit auf `getuid` zurueck, bis `glogin`
//      die naechste eintraegt.
//   5. `glogin` neu starten, als root, ueber denselben `desk_spawn`,
//      den `desk_start` beim Systemstart nimmt. Kein zweiter Weg
//      daneben.
//
// WARUM DIE TASKLEISTE STEHEN BLEIBT: sie laeuft als root (siehe
// `desk_start`, die ehrliche Grenze der Runde ANMELDUNG) und gehoert
// damit nicht zur Sitzung -- Schritt 2 fasst sie nicht an. Das ist
// hier sogar richtig: der Anmeldeschirm liegt auf `L_TOP` und deckt
// sie zu.
static mut lo_startet: u64 = 0

fn abmelde_wache(state: u64) {
    let sp: u64 = kstate.K11_OFF
    if kstate.get(state, sp + kstate.SP_LOGOUT) == 0 {
        return
    }
    // DER RIEGEL, aus demselben Grund wie in `sperre_wache`: diese
    // Funktion haengt an ZWEI Schleifen (der Halteschleife und
    // `wait_wm`), und `desk_spawn` dreht 250 Runden `wm.poll`. Ohne
    // Riegel kaeme die andere Schleife waehrenddessen durch, saehe den
    // Wunsch noch stehen und startete einen ZWEITEN Anmeldeschirm.
    if lo_startet != 0 {
        return
    }
    lo_startet = 1
    // Den Wunsch SOFORT loeschen, nicht am Ende. Stuerbe der Start des
    // Anmeldeschirms, wuerde er sonst in jeder Runde neu versucht.
    kstate.set(state, sp + kstate.SP_LOGOUT, 0)
    let uid: u64 = kstate.get(state, sp + kstate.SP_UID)
    var s_a: [u8; 26] = "abmelden: Sitzung uid=\0\0\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(uid)
    serial.nl()
    // 1. DIE PUFFER.
    //
    // `blk.flush` und nicht `do_sync` aus sys.fi: das waere ein
    // Rueckimport (sys.fi importiert kgui), und der Teil, der hier
    // zaehlt, ist genau dieser -- die Schreibpuffer der Platte auf die
    // Platte. Es ist derselbe Aufruf, den `do_sync` als letztes macht.
    let _f: bool = blk.flush(state)
    // 2. ALLES, WAS DER SITZUNG GEHOERT.
    //
    // uid 0 wird NICHT gejagt. Lief das System ohne Anmeldung hoch
    // (SP_UID == 0), waere "alles mit uid 0" der ganze Rechner --
    // einschliesslich der Leiste, des Fensterservers und der Aufgabe,
    // in der diese Zeile gerade laeuft. Ohne Sitzung gibt es nichts
    // abzumelden, und dann bleibt es beim Neustart des Anmeldeschirms.
    var getroffen: u64 = 0
    if uid != 0 {
        var i: u64 = 0
        while i < kstate.MAX_TASKS {
            let z: u64 = sched.tget(state, i, sched.T_STATE)
            if z != sched.S_FREE && z != sched.S_ZOMBIE
               && sched.tget(state, i, sched.T_UID) == uid {
                let pid: u64 = sched.tget(state, i, sched.T_PID)
                if pid != 0 {
                    // `send_pid` und nicht `do_kill`: `do_kill` ist der
                    // SYSTEMAUFRUF-Einstieg und prueft Vorzeichen und
                    // Prozessgruppen, um am Ende bei positiver Nummer
                    // genau dies zu tun. Hier ist die Nummer bekannt und
                    // positiv, also der direkte Weg.
                    let _k: u64 = signal.send_pid(state, pid,
                        signal.SIGKILL)
                    getroffen = getroffen + 1
                }
            }
            i = i + 1
        }
    }
    var s_g: [u8; 23] = "abmelden: beendet n=\0\0\0"
    serial.puts((&s_g[0]) as u64)
    serial.dec(getroffen)
    serial.nl()
    // 3. DIE SPERRE RAEUMEN.
    kstate.set(state, sp + kstate.SP_ON, 0)
    kstate.set(state, sp + kstate.SP_PID, 0)
    kstate.set(state, sp + kstate.SP_SLOT, 0)
    // 4. KEINE SITZUNG MEHR.
    kstate.set(state, sp + kstate.SP_UID, 0)
    // 5. DER ANMELDESCHIRM, ALS ROOT.
    var p_glog: [u8; 13] = "/bin/glogin\0\0"
    var a_glog: [u8; 8] = "glogin\0\0"
    let platz: u64 = desk_spawn(state, (&p_glog[0]) as u64,
        (&a_glog[0]) as u64, 8)
    var neu: u64 = 0
    if platz < kstate.MAX_TASKS {
        neu = sched.tget(state, platz, sched.T_PID)
    }
    kstate.add(state, sp + kstate.SP_LOGOUTS, 1)
    var s_n: [u8; 29] = "abmelden: Anmeldung neu pid=\0"
    serial.puts((&s_n[0]) as u64)
    serial.dec(neu)
    serial.nl()
    lo_startet = 0
}

fn sperre_wache(state: u64) {
    if !wm.sperre_an(state) {
        return
    }
    // DER RIEGEL. Er steht VOR dem Takt: waere er dahinter, kaeme die
    // zweite Schleife in einer Runde durch, in der der Takt gerade
    // passt, und der Riegel haette nur die Haelfte der Faelle erwischt.
    if sp_startet != 0 {
        return
    }
    sp_takt = sp_takt + 1
    if (sp_takt & 31) != 0 {
        return
    }
    // "LEBT NOCH" HEISST NICHT "STEHT NOCH IN DER TAFEL".
    //
    // Eine gestorbene Aufgabe bleibt als LEICHE (S_ZOMBIE) darin
    // stehen, bis jemand ihren Ausgang abholt -- `find_pid` findet sie
    // also weiter. Der erste Anlauf hat den Sperrer deshalb nie neu
    // gestartet: er war tot und trotzdem "da". Gemessen an
    // `lock -absturz`: user fault, und danach ein Bildschirm, auf dem
    // nichts mehr steht.
    let pid: u64 = wm.sperrer(state)
    if pid != 0 {
        let t: u64 = sched.find_pid(state, pid)
        if t < kstate.MAX_TASKS {
            let z: u64 = sched.tget(state, t, sched.T_STATE)
            if z != sched.S_ZOMBIE && z != sched.S_FREE {
                return
            }
        }
    }
    var p_lock: [u8; 10] = "/bin/lock\0"
    var a_lock: [u8; 5] = "lock\0"
    sp_startet = 1
    // ============================================ RUNDE ANMELDUNG
    // `elf.spawn` GIBT EINEN PLATZ ZURUECK, KEINE PROZESSNUMMER --
    // und die Vorrunde hat ihn als eine behandelt.
    //
    // GEMESSEN am Lauf vom 13.09. (`wm: darf`, eigens dafuer eingebaut):
    //
    //     sperre: Sperrer neu, pid=6  slot=5
    //     wm: darf i=4 owner=6 slot=5
    //
    // Das Fenster des Sperrers gehoerte Platz 6, als Sperrer eingetragen
    // war Platz 5 -- also stimmte `wm.darf` fuer SEIN EIGENES Fenster
    // nicht, und `compose` hat waehrend der Sperre GAR NICHTS gemalt:
    // der Sperrbildschirm blieb unsichtbar (`malen=0 px=0`), obwohl das
    // Programm lief, seine Bedienelemente angelegt hatte und
    // "sperre: bereit" meldete.
    //
    // WIE ES DAZU KAM: `elf.spawn` reicht durch, was `elf.build`
    // zurueckgibt, und das ist der PLATZ IN DER AUFGABENTAFEL (`t`).
    // Hier stand `sched.find_pid(state, neu)` -- eine Suche nach der
    // PROZESSNUMMER `neu`. Die beiden Zahlen sind nur so lange gleich,
    // wie nie ein Prozess geendet hat; nach der Anmeldung (glogin
    // endet, der Schreibtisch kommt dazu) laufen sie auseinander, und
    // genau dann war die Sperre blind.
    //
    // RICHTIG IST: `neu` IST der Platz. Die Prozessnummer dazu steht in
    // der Tafel und wird von dort geholt -- nicht umgekehrt.
    let platz: u64 = desk_spawn(state, (&p_lock[0]) as u64,
        (&a_lock[0]) as u64, 5)
    kstate.set(state, kstate.K11_OFF + kstate.SP_SLOT, platz)
    var neu: u64 = 0
    if platz < kstate.MAX_TASKS {
        neu = sched.tget(state, platz, sched.T_PID)
    }
    kstate.set(state, kstate.K11_OFF + kstate.SP_PID, neu)
    kstate.add(state, kstate.K11_OFF + kstate.SP_SPAWNS, 1)
    var s_w: [u8; 26] = "sperre: Sperrer neu, pid=\0"
    serial.puts((&s_w[0]) as u64)
    serial.dec(neu)
    serial.nl()
    // ERST JETZT AUF. `SP_PID` steht, also sieht die andere Schleife
    // beim naechsten Durchgang einen lebenden Sperrer und kehrt um.
    sp_startet = 0
}

fn say_wig(state: u64) {
    var s_a: [u8; 12] = "wig: blits=\0"
    var s_b: [u8; 10] = "  rows=\0\0\0"
    var s_c: [u8; 10] = "  pixels=\0"
    var s_d: [u8; 10] = "  glyphs=\0"
    var s_e: [u8; 12] = "  clipset=\0\0"
    var s_f: [u8; 12] = "  clipget=\0\0"
    var s_g: [u8; 10] = "  shape=\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(wig.blits(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(wig.rows_copied(state))
    serial.puts((&s_c[0]) as u64)
    serial.dec(wig.pixels(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(wig.glyph_calls(state))
    serial.puts((&s_e[0]) as u64)
    serial.dec(wig.clip_writes(state))
    serial.puts((&s_f[0]) as u64)
    serial.dec(wig.clip_reads(state))
    serial.puts((&s_g[0]) as u64)
    serial.dec(wm.shape(state))
    serial.nl()
}

// Warten auf die Shell im Fenster -- wie `wait_long`, aber es setzt
// zwischendurch zusammen, damit man beim Zusehen etwas sieht und damit
// der Zeiger sich bewegen laesst, waehrend sie laeuft.
// Die Shell im Terminalfenster starten. Steht hier und nicht mehr
// mitten in `surface`, weil sie seit RUNDE HIDWEG zweimal gebraucht
// wird: einmal am Anfang und wieder, wenn sie im Dauerbetrieb endet.
fn shell_start(state: u64) -> u64 {
    var p_sh: [u8; 8] = "/bin/sh\0"
    var a_sh: [u8; 3] = "sh\0"
    let abuf: u64 = state + kstate.EARG_OFF
    var k: u64 = 0
    while k < 3 {
        kstate.set8(abuf + k, a_sh[k as usize])
        k = k + 1
    }
    return elf.spawn(state, (&p_sh[0]) as u64, abuf, 1, 2)
}

// ===================================================== RUNDE HIDWEG
//
// DIESE SCHLEIFE IST DER SCHREIBTISCH. Sie holt den Zeiger ab
// (`wm.poll`) und setzt das Bild zusammen (`wm.compose`) -- laeuft sie
// nicht, bewegt sich nichts, egal wie fehlerfrei der USB-Baum darunter
// ist.
//
// WAS HIER FALSCH WAR, und es ist der Sperrpunkt der Runde: die
// Schleife hatte eine HARTE RUNDENGRENZE von 20000. Sie war als
// Notausgang fuer die TESTLAEUFE gedacht -- ein Laeufer, der ewig auf
// eine Shell wartet, ist kein Laeufer. Auf dem Stick aber steht auf
// jedem Schreibtisch-Eintrag `nosched`, und dann kostet eine Runde
// keine Zeitmarke, sondern nur einen Durchgang. GEMESSEN in QEMU mit
// genau der Kommandozeile von Menue 4: der Schreibtisch lebte
// **9,4 Sekunden**, danach kehrte `surface` zurueck, der Kern lief
// durch bis `kernel: done` und das Bild stand still.
//
// Von aussen sieht das aus wie ein kaputter Eingabetreiber: das Bild
// ist da, der Zeiger ist da, Tastatur und Maus haben Strom -- und
// nichts reagiert. Der Treiber war in Ordnung; es rief ihn nur
// niemand mehr.
//
// Mit `wmdauer` gibt es keine Grenze. Endet die Shell im Fenster
// (STRG-D), wird sie NEU GESTARTET statt den Schreibtisch mitzunehmen.
fn wait_wm(state: u64, i: u64, tw: u64) -> u64 {
    let dauer: bool = kstate.mode_on(state, kstate.M_WMDAUER)
    // ============ RUNDE TAFEL: DIESE SCHLEIFE IST DER SCHREIBTISCH,
    // UND SIE DARF NICHT AN DER SHELL HAENGEN.
    //
    // HIER STAND `if i == 0 { return }`, ganz oben, vor allem anderen.
    // Damit galt: startet `/bin/sh` nicht, laeuft der Schreibtisch
    // KEINE EINZIGE RUNDE. Kein `wm.poll` (also keine Eingabe), kein
    // `wm.compose` (also kein Bild nach dem ersten), kein
    // `kopf_malen` (also keine Messtafel). Der Bildschirm zeigt das
    // Startbild -- Hintergrund, Fenster, Zeiger --, und danach steht
    // alles still.
    //
    // Das ist Oktett fuer Oktett das Bild, das Justin am 04.09. um
    // 10:03 fotografiert hat, und es ist derselbe Fehler, den die
    // Runde HIDWEG im Kommentar darueber schon einmal beschrieben hat:
    // "Der Treiber war in Ordnung; es rief ihn nur niemand mehr."
    //
    // Im Dauerbetrieb wird deshalb GELAUFEN, mit oder ohne Shell. Ein
    // Schreibtisch ohne Terminal ist ein Schreibtisch; ein
    // Schreibtisch, der nicht laeuft, ist ein Standbild.
    //
    // Ohne `wmdauer` bleibt es beim alten Verhalten -- ein Testlaeufer,
    // der auf eine Shell wartet, die es nicht gibt, soll weiterhin
    // sofort zurueckkehren und nicht ewig drehen.
    st(27)
    if i == 0 && !dauer {
        st(28)
        return 0xFFFFFFFFFFFFFFFF
    }
    st(29)
    var s_d: [u8; 12] = "wm: dauer\0\0\0"
    if dauer {
        serial.puts((&s_d[0]) as u64)
        serial.nl()
    }
    var cur: u64 = i
    var rounds: u64 = 0
    var neustarts: u64 = 0
    // ZWEI UHREN, UND DIE SCHNELLERE GEWINNT. Der Zeitgeber ist die
    // richtige (fuenf Sekunden bleiben fuenf Sekunden, egal wie schnell
    // die Maschine zusammensetzt) -- aber unter `nosched` ist nicht
    // ausgemacht, dass die Marken ueberhaupt weiterzaehlen, und ein
    // Puls, der nie kommt, ist schlimmer als einer, der ungenau ist.
    // Also ausserdem eine Rundenzahl als Rueckfall.
    var naechster: u64 = kstate.get(state, kstate.TICKS) + PULS_MARKEN
    var naechste_runde: u64 = PULS_RUNDEN
    var letzte_marke: u64 = kstate.get(state, kstate.TICKS)
    st(30)
    while dauer || rounds < 20000 {
        st(31)
        wmrunden = rounds
        // ==================================== RUNDE ACPI-EREIGNISSE
        //
        // HIER LAEUFT AML IM SCHREIBTISCHBETRIEB, und diese Zeile ist
        // die Folge einer Messung.
        //
        // `acpiev.pump` steht seit dieser Runde in der
        // Leerlaufaufgabe (`kernel/tasks.fi`) -- dem richtigen Ort,
        // wenn ein Ablaufplaner laeuft. Der Schreibtisch dieses
        // Abbilds laeuft aber mit `nosched`, und dann kommt die
        // Leerlaufaufgabe NIE dran: die Bilder der Abnahme zeigten
        // einen Deckel, der sich schliesst, und einen Sperrbildschirm,
        // der nicht kam. Nicht weil der Weg kaputt war, sondern weil
        // niemand die Kurbel drehte.
        //
        // Also auch hier. Zweimal `pump` schadet nicht -- die Funktion
        // arbeitet ein Bitfeld ab und ist leer, wenn nichts anliegt;
        // ihr erster Vergleich ist ein Wort aus `kdata` gegen null.
        acpiev.pump(state)
        // `cur == 0` heisst: es laeuft gerade keine Shell. Dann gibt es
        // auch keinen Zustand abzufragen -- gefragt wird erst wieder,
        // wenn der Puls unten eine neue gestartet hat.
        if cur != 0 && sched.tget(state, cur, sched.T_STATE) == sched.S_ZOMBIE {
            let code: u64 = sched.tget(state, cur, sched.T_EXIT)
            proc.reap(state, cur)
            if !dauer {
                return code
            }
            // Im Dauerbetrieb ist eine beendete Shell kein Grund, den
            // Schreibtisch zu schliessen -- sie kommt wieder.
            //
            // ABER NICHT SOFORT. Gemessen: auf einer Maschine, deren
            // Konsole nichts liefert, kehrt `read` mit null zurueck und
            // die Shell endet in dem Augenblick, in dem sie anfaengt.
            // Wer sie dann ungebremst neu startet, baut einen
            // Prozessgenerator statt eines Terminals. Eine Sekunde
            // Abstand -- ein Mensch merkt sie nicht, ein Sturm schon.
            sched.sleep_ticks(state, 100)
            neustarts = neustarts + 1
            cur = shell_start(state)
            if cur == 0 {
                cur = i
            }
        }
        // RUNDE HIDWEG, MESSPUNKT: der zweite Weg zu denselben
        // Berichten. Steht die Meldung, findet er nichts mehr vor --
        // steht sie nicht, ist er der Weg. Der Unterschied ist an
        // `irq=` und `ber=` im Puls abzulesen.
        mausflut_schritt(state)
        st(32)
        usb.poll(state)
        // RUNDE BLECHEINGABE: HIER wird aufgezaehlt und nicht im
        // Zeitgeberbehandler. `attach` wartet in `port_reset` bis zu
        // einer halben Sekunde -- das gehoert in Aufgabenkontext, wo es
        // dauern darf, und nicht in eine Unterbrechung mit
        // abgeschalteten Unterbrechungen.
        st(33)
        usb.hotplug_work(state)
        // ================================== RUNDE HOTPLUG
        // AUFZAEHLEN UND EINHAENGEN SIND ZWEI SCHRITTE, UND SIE STEHEN
        // ABSICHTLICH HINTEREINANDER.
        //
        // `usb.hotplug_work` hat gerade den Stick aufgenommen (oder
        // fallengelassen); JETZT stimmen `usb.msc_gen`/`usb.msc_weg`.
        // Erst danach darf jemand Bloecke lesen -- ein Einhaengen
        // waehrend des Aufzaehlens laese in ein Geraet, das noch keine
        // Adresse hat.
        wechsel_schritt(state)
        st(34)
        wm.poll(state)
        // ==================================== RUNDE ALLTAG: DIE SPERRE
        //
        // DER AUSFALLZUSTAND, und er ist der ganze Grund, warum diese
        // fuenf Zeilen im KERN stehen und nicht im Sperrprogramm:
        // stirbt der Sperrer, waehrend die Sperre steht -- abgeschossen,
        // abgestuerzt, egal --, bleibt die Sperre STEHEN und der Kern
        // startet ihn neu. Ein Sperrbildschirm, den man durch einen
        // Absturz loswird, ist ein Bildschirmschoner.
        sperre_wache(state)
        // RUNDE LOGIND: der Abmeldewunsch, siehe `abmelde_wache`.
        abmelde_wache(state)
        st(35)
        wm.compose(state)
        st(36)
        // RUNDE FASSUNG: UNMITTELBAR NACH DEM ZUSAMMENSETZEN, JEDE
        // RUNDE. Vorher stand die Zeile nur im Puls und war beim
        // naechsten `compose` weg (siehe `kopf_malen`).
        // RUNDE TAFEL: und die Tafel erfaehrt, ob eine Shell laeuft.
        tafel_shell(cur)
        header_paint(state)
        st(37)
        if dauer {
            let jetzt: u64 = kstate.get(state, kstate.TICKS)
            // DIE MARKEN SIND DIE UHR. Die Rundenzahl ist NUR der
            // Rueckfall fuer den Fall, dass die Marken STEHEN -- und
            // genau dann ist der Puls das Wichtigste auf dem Schirm,
            // weil ein stehender Zeitgeber heisst, dass die
            // Unterbrechungen aus sind. Steht die Uhr nicht, schweigt
            // der Rueckfall: sonst schreibt der Kern dem Menschen sein
            // Terminalfenster in vierzig Sekunden 238-mal voll
            // (gemessen), und das ist keine Diagnose, das ist Rauschen.
            // ==================================== RUNDE BLECHFUENF
            // DER RUECKFALL HAT DAS TERMINAL GEFLUTET.
            //
            // Justin fotografiert dieselbe Zeilengruppe, die endlos
            // durchlaeuft, und die Marke darin steigt um zwei bis vier
            // je Zeile (mk=1799, 1803, 1805, 1809). Die Rechnung dazu:
            // `letzte_marke` wurde am Ende JEDER Rueckfallpruefung neu
            // gesetzt, also verglich der Rueckfall die Marke von jetzt
            // mit der von vor PULS_RUNDEN Runden. Seit die
            // Schreibtischschleife wirklich laeuft (LOOP 810, RND in
            // Millionen), passen viertausend Runden in eine einzige
            // Marke -- und dann sind die beiden Marken IMMER gleich und
            // der Rueckfall feuert IMMER.
            //
            // Der Rueckfall ist fuer einen STEHENDEN Zeitgeber gedacht.
            // Also wird jetzt gegen die Marke des LETZTEN ANSTRICHS
            // verglichen: hat sich seither keine einzige Marke bewegt,
            // steht die Uhr wirklich, und nur dann redet er.
            var feuern: bool = false
            if jetzt >= naechster {
                naechster = jetzt + PULS_MARKEN
                naechste_runde = rounds + PULS_RUNDEN
                letzte_marke = jetzt
                feuern = true
            } else if rounds >= naechste_runde {
                naechste_runde = rounds + PULS_RUNDEN
                if jetzt == letzte_marke {
                    feuern = true
                }
            }
            if feuern {
                input_pulse(state, tw, neustarts)
                tafel_seriell_an()
                // RUNDE TAFEL: KAM DIE SHELL NICHT, WIRD ES HIER NOCH
                // EINMAL VERSUCHT -- im Pulstakt und nicht in jeder
                // Runde. Der Schreibtisch laeuft inzwischen ohnehin;
                // das hier ist der Nachschlag, kein Startzwang.
                if cur == 0 {
                    cur = shell_start(state)
                    if cur != 0 {
                        neustarts = neustarts + 1
                    }
                }
            }
        }
        // ==================================== RUNDE BLECHFUENF
        // DIE GEGENPROBE ZU JUSTINS ABSTURZ. Nach zehn Sekunden geht
        // das oberste Fenster zu -- ueber denselben Weg wie das Kreuz.
        // Danach laeuft die Schleife weiter; wer hier stirbt, stirbt an
        // dem, woran Justin gestorben ist.
        // Alle fuenf Sekunden EINES: zuerst das Terminalfenster (das
        // mit dem Kreuz auf Justins Foto), danach der Reihe nach die
        // uebrigen. Jedes einzelne ist ein eigener Verdaechtiger, und
        // dazwischen laeuft der Schreibtisch weiter -- ein Absturz, der
        // erst beim naechsten Anstrich kommt, faellt sonst durch.
        // RUNDE BLECHFUENF: die Gegenprobe zur Absturzanzeige.
        if kstate.mode_on(state, kstate.M_KNALL) {
            if kstate.get(state, kstate.TICKS) > 1000 {
                __mmio_write64(0x00007FFFFFFF0000 as *mut u64, 1)
            }
        }
        if kstate.mode_on(state, kstate.M_ZUMACHEN) {
            let jj: u64 = kstate.get(state, kstate.TICKS)
            if jj > 1000 && jj >= zumach_marke {
                zumach_marke = jj + 500
                if zumach_getan == 0 {
                    // ERSTER DURCHGANG: EIN ECHTER KLICK AUF DAS KREUZ.
                    // Nicht `destroy` von der Seite, sondern der Weg,
                    // den Justins Maus genommen hat -- mit `cap_track`,
                    // `raise_win`, `set_focus` und allem, was `on_mouse`
                    // vor dem Schliessen noch tut.
                    let ti: u64 = wm.term_win(state)
                    if ti < wm.MAX_WIN {
                        let pkt: u64 = wm.cross_point(state, ti)
                        ps2m.set_pos(state, pkt >> 32, pkt & 0xFFFFFFFF)
                        wm.poll(state)
                        ps2m.usb_packet(state, 8 | ps2m.B_LEFT, 0, 0, 0,
                            false)
                        let _p1: bool = wm.poll(state)
                        ps2m.usb_packet(state, 8, 0, 0, 0, false)
                        let _p2: bool = wm.poll(state)
                        zumach_fenster = ti + 1
                    }
                } else {
                    // Und danach: den Zeiger BEWEGEN. Justin hat nach
                    // dem Klick weitergearbeitet, und `cap_track` fasst
                    // dabei den ueberfahrenen Knopf des Fensters an,
                    // das es nicht mehr gibt.
                    ps2m.set_pos(state, 400 + zumach_getan * 40, 500)
                    let _p3: bool = wm.poll(state)
                    zumach_fenster = wm.close_top(state) + 1
                }
                zumach_getan = zumach_getan + 1
                close_say(state)
            }
        }
        st(38)
        sched.sleep_ticks(state, 1)
        rounds = rounds + 1
    }
    return 0xFFFFFFFFFFFFFFFE
}

// Wie oft der Eingabepuls erscheint: alle 500 Marken, also alle fuenf
// Sekunden, WENN der Zeitgeber laeuft. Unter `nosched` zaehlt er
// trotzdem (der Zeitgeberbehandler haengt nicht am Ablaufplaner), also
// ist der Abstand auch dort eine echte Zeit und keine Rundenzahl.
const PULS_MARKEN: u64 = 500
// Der Rueckfall, wenn die Marken nicht laufen.
const PULS_RUNDEN: u64 = 4000

// =============================== DER EINGABEPULS, GEBAUT FUER EIN FOTO
//
// Justin steht vor dem Rechner mit einem Mobiltelefon. Er kann NICHT
// die serielle Leitung mitlesen -- was er sehen kann, ist der
// Bildschirm, und darauf das Terminalfenster. Also wird diese eine
// Zeile DORT hineingeschrieben (`wm.term_write`) und zusaetzlich auf
// die serielle Leitung.
//
// Sie beantwortet die Frage "wo bleibt mein Tastendruck" der Reihe
// nach, von unten nach oben:
//
//   ber=   HID-Berichte, die der USB-Baum entgegengenommen hat
//   irq=   Meldungen des xHCI (0 hiesse: alles nur ueber Abfrage)
//   ta=    Tasten, die `hidin` daraus gelesen hat, lo= Loslassen
//   bew=   Mausbewegungen aus HID-Berichten
//   pk=    Pakete, die beim Zeiger ankamen (mx/my = seine Stelle)
//   wm=    wie oft der Fensterserver eine Zeigeraenderung abgeholt hat
//   kl=    Klicks, die im Fensterserver ankamen
//
// Steht `ber=0`, kommt gar nichts an. Steht `ber` hoch und `pk=0`,
// haengt es zwischen Bericht und Zeiger. Steht `pk` hoch und `wm=0`,
// haengt es im Fensterserver.
// ================================== RUNDE FASSUNG: DIE KOPFZEILE BLEIBT
//
// HIER WAR EIN ECHTER FEHLER, UND ER HAT JUSTIN EINEN TESTLAUF
// GEKOSTET. Die Messleiste wurde bisher NUR im Puls gemalt, also alle
// fuenf Sekunden -- und sie markiert ihren Streifen dabei als
// schmutzig. Das naechste `wm.compose` malt einen schmutzigen Streifen
// mit dem Schreibtisch zu. Sichtbar war die Zeile damit fuer den
// Bruchteil einer Runde; auf einem Foto ist sie praktisch nie drauf.
// Justin hat sie deshalb gemeldet als "keine gruene Zeile" -- und er
// hatte recht.
//
// Jetzt steht der Text in einem bleibenden Puffer, und gemalt wird er
// nach JEDEM `compose`. Der Puls fuellt nur noch den Puffer.
static mut kopf: [u8; 176] = [0 as u8; 176]
static mut kopf_n: u64 = 0

fn header_set(state: u64, p: u64, n: u64) {
    var i: u64 = 0
    var m: u64 = n
    if m > 175 {
        m = 175
    }
    while i < m {
        kstate.set8((&kopf[0]) as u64 + i, kstate.get8(p + i) as u8)
        i = i + 1
    }
    kopf_n = m
}

// ====================================== RUNDE MESSTAFEL: SIEBEN ZEILEN
//
// WARUM ES DIESE TAFEL GIBT. Nach der Runde FASSUNG stand EINE Zeile
// oben am Schirm, mit zwanzig Zahlen darin. Justin hat sie
// fotografiert und konnte sie nicht lesen -- aus zwei Metern, mit dem
// Mobiltelefon, in `uisc`-Groesse. Eine Diagnose, die man nicht lesen
// kann, ist keine.
//
// Also: SIEBEN kurze Zeilen, jede eine STUFE des Eingabewegs, jede in
// EINER Farbe. Gruen heiszt "hier kam etwas an", rot heiszt "hier kam
// nichts an". Justin muss keine Ziffer entziffern -- er sucht die
// ERSTE ROTE ZEILE, und das ist die Stelle, an der es abreiszt.
//
// DIE STUFEN, von unten nach oben durch die Kette:
//
//   1 USB     HID-Berichte, die der USB-Baum entgegengenommen hat.
//             Rot heiszt: der Regler liefert gar nichts.
//   2 REIHE   was `hidin` daraus gemacht und EINGEREIHT hat -- Tasten
//             in den Ring von `kbd`, Mausbewegungen als Pakete in
//             `ps2m`. Rot bei gruenem 1: die Berichte werden nicht
//             verstanden (falsche Beschreibung, falsches Protokoll).
//   3 SERVER  was der FENSTERSERVER davon abgeholt hat (`on_key`,
//             `on_mouse`). Rot bei gruenem 2: die Hauptschleife ruft
//             `wm.poll` nicht mehr, oder der Ring wird nicht geleert.
//   4 RING    Ereignisse, die in einen Fensterring GELEGT wurden.
//             Rot bei gruenem 3: es gibt kein Fenster mit Fokus.
//   5 APP     Ereignisse, die ein RING-3-PROGRAMM ABGEHOLT hat.
//             Rot bei gruenem 4 ist der wichtigste Befund von allen:
//             der Kern liefert, und niemand holt ab -- dann laeuft
//             kein Anwendungsprozess mehr. Das erklaert die tote
//             Eingabe UND die unsichtbare Taskleiste mit EINER Ursache.
//   6 ZEIGER  wo der Server den Zeiger fuehrt.
//
// ZEILE 0 IST DER HERZSCHLAG und sie beantwortet die Frage davor:
// LAEUFT DAS SYSTEM UEBERHAUPT NOCH? `B` sind die zusammengesetzten
// Bilder (die Hauptschleife), `T` die Zeitgebermarken (die
// Unterbrechung). Stehen beide still, ist der Rechner haengengeblieben
// und keine der sechs Stufen darunter bedeutet etwas. Genau diese
// Unterscheidung -- "eingefroren" gegen "laeuft, bekommt aber nichts"
// -- war bisher auf keinem Foto zu treffen.
// RUNDE BLECHDREI: SECHZEHN ZEILEN, ACHT JE SPALTE.
// Zwei kommen dazu, und beide gehoeren in den ZEITGEBER-Pfad -- den
// einzigen, der auf Justins Brett nachweislich laeuft:
//   14 WAHL -- welcher USB-Regler gewonnen hat und mit welcher Punktzahl
//   15 BAND -- ob das reservierte Band wirklich steht
// ============================================== RUNDE STARTKNOPF
// ZWANZIG BLEIBEN ZWANZIG -- UND WARUM.
//
// Vier neue Zeilen waeren 24, und 24 sind auf 1440 Bildpunkten ein
// Band von 582. Gemessen: mit diesem Band startet der Schreibtisch aus
// dem USB-Abbild nicht mehr (`wm: skipped`, und der ganze Modusvektor
// steht auf null), waehrend derselbe Kern ueber `-kernel` mit
// demselben Band einwandfrei hochkommt. Die Ursache steckt im
// Lader-/modfs-Pfad und ist NICHT gefunden -- also wird das Band nicht
// groesser gemacht, bis sie es ist.
//
// Die vier neuen Zeilen kommen deshalb auf Plaetze, deren Frage
// BEANTWORTET ist:
//   14 WAHL  -> ENDP   (die Reglerwahl steht fest: hc1, USB laeuft)
//   17 BLECH -> FUND   (IOMMU uebersetzt nicht, GPEs sind maskiert)
// und die Absturzklinke ueberschreibt, WENN es geknallt hat:
//    9 EICH  -> KNALL  (LSR FF, PIT und ACPI-Uhr stimmen ueberein)
//   13 ABBILD-> KRIP   (PDE 10E3, PAT 01 -- write-combining steht)
// Ein Absturz ist wichtiger als eine beantwortete Frage.
//
// ================================================== RUNDE LEISTE
// UND JETZT DOCH VIERUNDZWANZIG -- WEIL DIE URSACHE GEFUNDEN IST.
//
// Der Absatz darueber sagt: "Die Ursache steckt im Lader-/modfs-Pfad
// und ist NICHT gefunden -- also wird das Band nicht groesser gemacht,
// bis sie es ist." Sie ist gefunden, und sie steckte nicht im Lader:
// ein KERNSTAPEL lief unten heraus und schrieb in den Rahmen darunter
// (siehe `kernel/sched.fi`, KSTACK_FRAMES). Ein groesseres Band
// verschiebt Code und Rahmen und damit das OPFER -- beim einen Stand
// war es etwas Folgenloses, beim anderen die Modusseite. Das Band war
// nie die Ursache, es war der Wuerfel.
//
// Mit der Waechterseite unter jedem Kernstapel ist ein solcher
// Ueberlauf keine stille Zerstoerung mehr, sondern eine Meldung mit
// Aufgabennummer -- und die Zeilen 20 bis 22 bekommen ihre eigenen
// Plaetze zurueck:
//   20 ENDP   der Endpunktzustand aus Sicht des Reglers
//   21 FUND   die Fundliste des USB-Baums, Stufe fuer Stufe
//   22 NETZ   die Netzkarte: Hersteller, Geraet, Verbindung, Adresse
// 24 Zeilen sind auf 1440 Bildpunkten ein Band von 582, und 582 * 2
// ist kleiner als 1440 -- `fb.set_band` nimmt es seit der Runde
// STARTKNOPF an.
const BOARD_LINES: u64 = 25
const TAFEL_SPALTEN: u64 = 48

fn tz_text(state: u64, buf: u64, at: u64, t: u64) -> u64 {
    return puls_text(state, buf, at, t)
}

// Jede Runde nach dem Zusammensetzen -- damit die Tafel auch dann
// steht, wenn Fenster, Taskleiste und Schrift versagen.
// RUNDE TAFEL: EIN EIGENER TAKT, UNABHAENGIG VON ALLEM.
//
// Der Balken geht jetzt ueber die volle Breite: auf 3440x1440 sind das
// 3440 x 390 = 1,34 Millionen Bildpunkte je Anstrich. In jeder Runde
// waeren das auf einem UNGEPUFFERTEN Firmware-Rahmenpuffer -- und
// genau so einen richtet Limine auf Justins Brett ein -- mehrere
// hundert Megabyte je Sekunde ueber den Bus. Die Maschine wuerde
// dabei nichts anderes mehr tun.
//
// Also zehnmal je Sekunde. Fuer ein Foto ist das reichlich, und es
// haengt an KEINER anderen Bedingung: nicht an `compose`, nicht an
// Schmutz, nicht an einem Fenster, nicht an der Taskleiste.
const TAFEL_MARKEN: u64 = 10 // Zeitmarken zwischen zwei Anstrichen
const TAFEL_RUNDEN: u64 = 200 // Rueckfall, wenn die Marken stehen
const TAFEL_SERMARKEN: u64 = 500 // fuenf Sekunden zwischen zwei Berichten
// RUNDE BLECHFUENF: die Gegenprobe `zumachen`.
static mut zumach_getan: u64 = 0
static mut zumach_fenster: u64 = 0
static mut zumach_marke: u64 = 0

fn close_say(state: u64) {
    var s_z: [u8; 12] = "zumachen n=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_c: [u8; 4] = " c=\0"
    serial.puts((&s_z[0]) as u64)
    serial.dec(zumach_getan)
    serial.puts((&s_w[0]) as u64)
    serial.dec(zumach_fenster)
    serial.puts((&s_c[0]) as u64)
    serial.dec(wm.count(state))
    serial.nl()
}
static mut tafel_marke: u64 = 0
static mut tafel_runde: u64 = 0
static mut tafel_sh: u64 = 0
// RUNDE TAFEL, RUECKFALLEBENE: dieselben acht Zeilen auf die serielle
// Leitung. Wenn der Rahmenpuffer selbst das Problem ist, ist das der
// einzige Weg nach draussen -- und er kostet nichts, solange niemand
// mitliest. Gesetzt wird die Marke im Puls (alle fuenf Sekunden),
// geloescht am Ende des Anstrichs.
static mut tafel_seriell: u64 = 0

fn tafel_seriell_an() {
    tafel_seriell = 1
    kopf_seriell = 1
}

// ====================================================== RUNDE BLECH2
// DIE ZEILEN 0 BIS 7 KAMEN NIE AUF DIE LEITUNG.
//
// `tafel_seriell` wird vom Puls gesetzt und vom Zeitgeber-Anstrich
// (`tafel_tick`, zehnmal je Sekunde) nach dessen Zeilen 8..23 wieder
// geloescht. Die Zeilen 0..7 malt aber die SCHREIBTISCHSCHLEIFE
// (`kopf_malen`), und die kam fast nie zwischen Setzen und Loeschen --
// in einem 45-Sekunden-Lauf mit 20 Anstrichen der Zeilen 8..23 stand
// von den Zeilen 1..7 keine einzige im Mitschnitt. Genau diese Zeilen
// tragen RING/VERL (4) und TK (7): die Abnahme dieser Runde konnte sie
// nicht lesen. Also eine eigene Marke fuer den Kopf, die NUR
// `kopf_malen` loescht, nachdem es seine Zeilen gesagt hat.
static mut kopf_seriell: u64 = 0

fn header_line_say(state: u64, b: u64, n: u64) {
    if kopf_seriell == 0 {
        return
    }
    var v: [u8; 8] = "tafel: \0"
    let z: u64 = serial.line_at(sched.hier(state))
    serial.puts((&v[0]) as u64)
    serial.text(b, n)
    serial.nl()
    serial.line_clear(z)
}

// Der Schreibtisch sagt der Tafel, ob eine Shell laeuft. Das ist die
// Zahl, die Justins Foto vom 04.09. gekostet hat: ohne Shell lief die
// Schleife gar nicht, und niemand konnte es sehen.
// ====================================== RUNDE HOTPLUG
// DER SCHRITT, DER AUS EINEM GERAET EINEN ORT MACHT.
//
// Er steht HIER und nicht in `usb.fi`, und das ist die ganze Bauform
// dieser Runde: `usb.fi` darf nichts von Dateisystemen wissen (Zusage
// der Runde K17, gemessen in `tools/k17/run.sh` Abschnitt 1), und
// `vfs.fi` nichts von USB. Also liest die Schreibtischschleife ZWEI
// ZAHLEN und ruft die Naht -- `kernel/wechsel.fi` --, die beide Seiten
// kennen darf.
//
// ZWEI MERKER UND KEIN ZUSTAND: `hp_gen` und `hp_weg` sind der Stand
// des letzten Blicks. Ein Zaehler, der sich bewegt hat, ist eine
// Flanke; bewegt er sich nicht, kostet dieser Schritt einen Vergleich.
// Das ist der Grund, warum er in jeder Runde der Schleife stehen darf,
// ohne sie zu belasten.
//
// WARUM NICHT DER ZEITGEBER: weil Einhaengen Bloecke liest, und Bloecke
// lesen dauert. Im Zeitgeberbehandler stuenden dabei die
// Unterbrechungen -- genau der Fehler, den der Kopf von
// `usb.port_watch` beschreibt und den diese Runde nicht wiederholt.
static mut hp_gen: u64 = 0
static mut hp_weg: u64 = 0

fn wechsel_schritt(state: u64) {
    var s_d: [u8; 20] = "kgui: wechsel gen=\0\0"
    var s_w: [u8; 8] = "  weg=\0\0"
    var s_v: [u8; 9] = "  vfs=\0\0\0"
    let gen: u64 = usb.msc_gen(state)
    let weg: u64 = usb.msc_weg(state)
    if gen != hp_gen || weg != hp_weg {
        serial.puts((&s_d[0]) as u64)
        serial.dec(gen)
        serial.puts((&s_w[0]) as u64)
        serial.dec(weg)
        serial.puts((&s_v[0]) as u64)
        serial.dec(kutil.yes(vfs.ready(state)))
        serial.nl()
    }
    // ZUERST DAS GEHEN. Wer einen Stick abzieht und sofort einen
    // zweiten steckt, hat in derselben Runde beide Flanken; wird dann
    // zuerst eingehaengt, ist der Platz des alten noch belegt.
    // RUNDE HOTPLUG-2: jeder Platz einzeln. Siehe `kmain.wechsel_schritt`
    // -- die zwei Zaehler sagen DASS, die Liste sagt WELCHER.
    if weg != hp_weg {
        hp_weg = weg
        var i: u64 = 0
        while i < blk.MAX_USB {
            let d: u64 = blk.usb_dev(i)
            if !usb.msc_ready_at(state, i) && wechsel.hat_dev(state, d) {
                let _n: u64 = wechsel.geht(state, d)
            }
            i = i + 1
        }
    }
    if gen != hp_gen {
        hp_gen = gen
        var j: u64 = 0
        while j < blk.MAX_USB {
            let d2: u64 = blk.usb_dev(j)
            if usb.msc_ready_at(state, j) && !wechsel.hat_dev(state, d2) {
                let _i: u64 = wechsel.kommt(state, d2)
            }
            j = j + 1
        }
    }
}

fn tafel_shell(v: u64) {
    tafel_sh = v
}

// Eine Tafelzeile auf die serielle Leitung -- nur wenn die Marke steht.
fn board_line_say(state: u64, b: u64, n: u64) {
    if tafel_seriell == 0 {
        return
    }
    var v: [u8; 8] = "tafel: \0"
    let z: u64 = serial.line_at(sched.hier(state))
    serial.puts((&v[0]) as u64)
    serial.text(b, n)
    serial.nl()
    serial.line_clear(z)
}

// ====================================================================
// RUNDE HAENGER: DIE TAFEL HAENGT JETZT AM ZEITGEBER, AN SONST NICHTS.
//
// Vorige Runde hat sie von der Shell geloest -- sie stand trotzdem
// nicht auf Justins Schirm. Der Grund kann nur noch einer sein: die
// SCHLEIFE, die sie malt, laeuft nicht. `wait_wm` ist Kernkode, aber
// unter `nosched` (so bootet jeder Schreibtisch-Eintrag) gibt es KEINE
// Verdraengung: bleibt irgendein Systemaufruf im Kern stehen, bekommt
// diese Schleife nie wieder den Prozessor, und mit ihr steht alles --
// Bild, Eingabe, Taskleiste, Tafel. Vier Meldungen, eine Ursache.
//
// Ein Messgeraet, das genau dann ausfaellt, wenn es gebraucht wird, ist
// keins. Also wird die Tafel ab hier aus dem ZEITGEBERBEHANDLER
// gemalt: `trap.fi` -> `gfx.tafel_tick` -> hierher. Das laeuft, solange
// die Unterbrechungen an sind, voellig gleich, was Ring 3 oder die
// Hauptschleife gerade tun.
//
// ZEILE 8 IST DIE ANTWORT AUF JUSTINS FRAGE. Sie zeigt drei Zaehler:
//   IRQ   -- wie oft der Zeitgeber diese Funktion gerufen hat
//   MAL   -- wie oft die Tafel gemalt wurde
//   LOOP  -- wie oft die Schreibtischschleife `kopf_malen` gerufen hat
// Bewegt sich IRQ und LOOP steht: die Maschine lebt, die Hauptschleife
// haengt (Systemaufruf/Ring 3). Steht IRQ auch: die Unterbrechungen
// sind aus. Steht beides und der Zeiger ist da: der Rechner ist tot.
// Diese Unterscheidung war auf keinem Foto zu treffen.
// RUNDE BLECHDREI: 40 GEMERKT, 30 GEMALT -- und die kleinere Zahl
// gewann still. Justins Foto zeigte "... HUB 0 KBD" und dort hoerte
// die Zeile auf. Jetzt ist es EINE Zahl, und sie steht in `wm` genauso.
const TAFEL_SP: u64 = 48 // Zeichen je gemerkter Zeile
// ==================================================== RUNDE LEISTE
// DIESE DREI FELDER WAREN DER ZWEITE UEBERSCHREIBER.
//
// Sie standen auf 20 und 960 (= 20 * TAFEL_SP), waehrend die Zahl der
// Zeilen eine KONSTANTE eine Seite weiter oben ist. Wer `TAFEL_ZEILEN`
// erhoeht -- und die Runde STARTKNOPF hat es auf 24 versucht --,
// erhoeht damit nicht diese drei. `tafel_len` und `tafel_fg` fliegen
// dann mit "index out of bounds" auf (gemessen, kgui.fi:3170); `tafel_txt`
// tut das NICHT, denn dort wird ueber `kstate.set8(ziel + i, ...)`
// geschrieben, also mit rohem Zeiger und ohne Grenze. Vier Zeilen zu 48
// Oktetten gingen still HINTER das Feld -- und was dahinter liegt,
// entscheidet die Bindereihenfolge.
//
// GENAU DAS ist die Beschreibung des "unsichtbaren Ueberschreibers" aus
// der Runde STARTKNOPF: "irgendwo im Baum schreibt etwas ueber das Ende
// eines Feldes hinaus; vorher traf das etwas Folgenloses, nach der
// Umordnung die Modusseite". Der `import cpu` war der Wuerfel, nicht die
// Ursache.
//
// Ab hier haengen die Groessen an derselben Zahl wie die Zeilen. Wer
// `TAFEL_ZEILEN` aendert, aendert HIER mit -- und `tafel_merken` steigt
// weiterhin vorher aus, wenn die Zeile zu gross ist.
static mut tafel_txt: [u8; 1200] = [0 as u8; 1200] // TAFEL_ZEILEN * TAFEL_SP
static mut tafel_len: [u64; 25] = [0 as u64; 25]
static mut tafel_fg: [u64; 25] = [0 as u64; 25]
static mut tafel_hat: u64 = 0 // steht schon Inhalt bereit?
static mut tafel_drin: u64 = 0 // Wiedereintrittssperre
static mut tafel_irq: u64 = 0 // Rufe aus dem Zeitgeber
static mut tafel_mal: u64 = 0 // Anstriche
static mut tafel_loop: u64 = 0 // Rufe aus der Schreibtischschleife
static mut tafel_irqm: u64 = 0 // letzte Marke, an der aus dem IRQ gemalt wurde
static mut tafel_serm: u64 = 0 // letzte Marke der seriellen Ausgabe
// ================================================== RUNDE BLECHDREI
// ============ DIE ECHTE FREQUENZ, AUS EINER ZWEITEN UHR
//
// Justin konnte aus einem EINZELNEN Foto nicht ablesen, wie schnell der
// Zeitgeber wirklich schlaegt -- "IRQ 260 MAL 26" ist ohne ein zweites
// Foto und eine Armbanduhr keine Rate. Zwei Fotos im Minutenabstand
// ergaben zuletzt drei Marken je Sekunde statt hundert; das war die
// wichtigste Zahl der ganzen Runde, und sie kostete ihn zwei Bilder und
// eine Rechnung.
//
// Der Zyklenzaehler (`rdtsc`) ist eine von der Unterbrechung voellig
// unabhaengige Uhr, und `time.khz` sagt, wie viele Zyklen eine
// Millisekunde sind (in `time.fi` gegen den PIT geeicht). Damit steht
// die Rate als ZAHL auf der Tafel: soll 100, gemessen was auch immer.
static mut hz_tsc: u64 = 0
static mut hz_irq: u64 = 0
static mut hz_wert: u64 = 0

fn hz_takt(state: u64) -> u64 {
    let k: u64 = time.khz(state)
    if k == 0 {
        return 0
    }
    let t: u64 = time.tsc()
    if hz_tsc == 0 || t <= hz_tsc || tafel_irq < hz_irq {
        hz_tsc = t
        hz_irq = tafel_irq
        return hz_wert
    }
    let dt: u64 = t - hz_tsc
    // Erst nach einer vollen Sekunde -- kuerzer waere die Koernung
    // groesser als die Aussage.
    if dt < k * 1000 {
        return hz_wert
    }
    let di: u64 = tafel_irq - hz_irq
    hz_wert = di * k * 1000 / dt
    hz_tsc = t
    hz_irq = tafel_irq
    return hz_wert
}

// EINE ZEILE ABLEGEN. Gemalt wird sie erst in `tafel_streichen` -- und
// zwar von wem auch immer als naechstes drankommt, Schleife oder
// Zeitgeber.
static mut zu_lang: u64 = 0
static mut lang_max: u64 = 0
static mut lang_zeile: u64 = 0

fn board_remember(zeile: u64, p: u64, n: u64, fg: u64) {
    if zeile >= BOARD_LINES {
        return
    }
    var m: u64 = n
    if m > TAFEL_SP {
        // ==================================== RUNDE VIELKERN
        // EINE TAFEL, DIE ABSCHNEIDET, OHNE ES ZU SAGEN, LUEGT.
        //
        // Zeile 12 war 70 Zeichen lang und die Tafel ist 48 breit. Auf
        // dem Schirm stand also `... TB 1 W` -- `WA`, `KS` und `R3F`
        // waren ABGESCHNITTEN. Genau diese drei Zahlen habe ich Justin
        // als das genannt, was er nach dem Brennen nachsehen soll. Er
        // haette sie nie sehen koennen.
        //
        // Ab hier wird jede zu lange Zeile GEZAEHLT und die laengste
        // gemerkt; `LANG` auf Zeile 23 zeigt beides. Steht dort etwas
        // anderes als 0, fehlt auf dem Schirm etwas.
        // Eine MASKE, kein Zaehler: sonst steht dort nach zwei Minuten
        // eine vierstellige Zahl, die nur sagt, wie oft gemalt wurde.
        // Was zaehlt, ist WIE VIELE VERSCHIEDENE Zeilen zu lang sind.
        zu_lang = zu_lang | (1 << zeile)
        if n > lang_max {
            lang_max = n
            lang_zeile = zeile
        }
        m = TAFEL_SP
    }
    let ziel: u64 = (&tafel_txt[0]) as u64 + zeile * TAFEL_SP
    var i: u64 = 0
    while i < m {
        kstate.set8(ziel + i, kstate.get8(p + i) as u8)
        i = i + 1
    }
    tafel_len[zeile as usize] = m
    tafel_fg[zeile as usize] = fg
    tafel_hat = 1
}

// DER EINZIGE ANSTREICHER. Grund, Zeilen, Takt-Zeile, Flush.
// ============================================ RUNDE BLECHFUENF
// DIE ABSTURZANZEIGE, UND WARUM SIE IN DAS BAND GEHOERT.
//
// Justin hat auf das rote Kreuz eines Fensters geklickt; das Fenster
// ging zu, und danach war die Maschine weg. Was dabei WIRKLICH passiert
// ist, stand bis zu dieser Runde ausschliesslich auf der seriellen
// Leitung -- und sein Brett hat keine (LSR FF, seit der Runde KABEL
// gemessen). Danach schaltete `report` den Rechner ab. Fuer ihn war ein
// Kernabsturz damit ununterscheidbar von einem Ausfall der Stromzufuhr.
//
// Ab hier stehen Vektor, Fehlercode, RIP und CR2 in dem einen Bereich,
// den NIEMAND ueberschreiben kann, in grosser roter Schrift -- und der
// Rechner HAELT AN statt sich abzuschalten. Ein Foto der Adresse sagt
// uns, wo es geknallt ist; raten muessen wir nicht mehr.
//
// Der Anstrich geht bewusst NICHT ueber den Schmutzbereich: an dieser
// Stelle ist der Kern schon halb tot, und die Buchfuehrung des
// Fensterservers ist womoeglich genau das, was ihn umgebracht hat.
// `fb.flush_rect` mit festen Koordinaten haengt an nichts.
// ============================================== RUNDE STARTKNOPF
// DIE ABSTURZKLINKE -- WEIL EINE ANZEIGE, DIE VERSCHWINDET, LUEGT.
//
// Justin hat den ersten Absturz fotografiert und danach die Maus
// bewegt: die rote Anzeige war WEG, alles wieder gruen, die Zaehler
// liefen weiter (B31 -> B2626 -> B7085). Auf dem Schirm stand
// "ANGEHALTEN", und angehalten war nichts.
//
// Das ist kein Widerspruch, sondern eine Auskunft: `power.halt_forever`
// macht `cli; hlt` -- das haelt DEN KERN AN, AUF DEM ES LAEUFT, und
// sonst keinen. Lief der Fehler auf einem der anderen Kerne, steht der
// bis zum Ausschalten still, und der Rest der Maschine merkt nichts.
// Der naechste Anstrich der Tafel (aus dem Zeitgeber des LEBENDEN
// Kerns) hat die rote Anzeige dann einfach ueberschrieben.
//
// AB HIER GEHT DAS NICHT MEHR. Der Absturz wird GEMERKT: Nummer,
// Vektor, RIP, und WELCHER KERN. Solange die Klinke steht, malt die
// Tafel diese Zeilen in jedem Anstrich mit -- egal, welcher Kern noch
// laeuft. Und sie sagt dazu, ob dieser Kern anhaelt oder weiterlaeuft,
// statt "ANGEHALTEN" zu behaupten und dann weiterzumalen.
static mut ab_klinke: u64 = 0 // steht ein Absturz an?
static mut ab_zahl: u64 = 0 // wie viele es waren
static mut ab_vec: u64 = 0
static mut ab_rip: u64 = 0
static mut ab_cr2: u64 = 0
static mut ab_rsp: u64 = 0
static mut ab_err: u64 = 0
static mut ab_cs: u64 = 0
static mut ab_kern: u64 = 0 // der Kern, auf dem es geknallt hat
static mut ab_haelt: u64 = 0 // haelt dieser Kern danach an?
// RUNDE BLECHKERN: die Ruecksprungkette des Kernstapels und die Zahl
// der Kerne, denen der NMI geschickt wurde.
static mut ab_spur: [u64; 5] = [0 as u64; 5]
static mut ab_spurn: u64 = 0
static mut ab_stopp: u64 = 0

// Die Aufzeichnung, in ZWEI Zeilen der laufenden Tafel. Sie stehen
// UNTER den Messzeilen und ueberschreiben nichts von ihnen: Justin
// braucht beides -- die Zahlen, die weiterlaufen, UND den Beleg, dass
// es geknallt hat.
fn crash_lines(state: u64) {
    var b: [u8; 64] = [0 as u8; 64]
    let p: u64 = (&b[0]) as u64
    let rot: u64 = wm.mess_rot(state)
    var namen: [u8; 128] = "#DE\0#DB\0NMI\0#BP\0#OF\0#BR\0#UD\0#NM\0#DF\0#CO\0#TS\0#NP\0#SS\0#GP\0#PF\0r15\0#MF\0#AC\0#MC\0#XM\0#VE\0#CP\0r22\0r23\0r24\0r25\0r26\0#HV\0#VC\0#SX\0r30\0r31\0"
    var t0: [u8; 10] = "9 KNALL  \0"
    var s_n: [u8; 4] = "N \0\0"
    var s_v: [u8; 5] = " VEK\0"
    var s_k: [u8; 4] = " K\0\0"
    var s_h: [u8; 8] = " HAELT\0\0"
    var s_w: [u8; 8] = " WEITER\0"
    var n: u64 = 0
    n = puls_text(state, p, 0, (&t0[0]) as u64)
    n = puls_text(state, p, n, (&s_n[0]) as u64)
    n = pulse_num(state, p, n, ab_zahl)
    n = puls_text(state, p, n, (&s_v[0]) as u64)
    n = pulse_num(state, p, n, ab_vec)
    if ab_vec < 32 {
        n = puls_text(state, p, n, (&namen[0]) as u64 + ab_vec * 4)
    }
    n = puls_text(state, p, n, (&s_k[0]) as u64)
    n = pulse_num(state, p, n, ab_kern)
    if ab_haelt != 0 {
        n = puls_text(state, p, n, (&s_h[0]) as u64)
    } else {
        n = puls_text(state, p, n, (&s_w[0]) as u64)
    }
    board_remember(9, p, n, rot)
    board_line_say(state, p, n)

    var t1: [u8; 10] = "13 KRIP  \0"
    var s_c: [u8; 7] = "  CS \0\0"
    var s_e: [u8; 7] = " ERR \0\0"
    n = puls_text(state, p, 0, (&t1[0]) as u64)
    n = puls_hexn(state, p, n, ab_rip, 8)
    n = puls_text(state, p, n, (&s_c[0]) as u64)
    n = puls_hexn(state, p, n, ab_cs & 0xFFFF, 4)
    n = puls_text(state, p, n, (&s_e[0]) as u64)
    n = puls_hexn(state, p, n, ab_err & 0xFFFF, 4)
    // cr2 nur bei #PF -- sonst ist es eine alte Zahl, siehe oben.
    if ab_vec == 14 {
        var s_r: [u8; 7] = " CR2 \0\0"
        n = puls_text(state, p, n, (&s_r[0]) as u64)
        n = puls_hexn(state, p, n, ab_cr2, 8)
    } else {
        var s_s: [u8; 7] = " RSP \0\0"
        n = puls_text(state, p, n, (&s_s[0]) as u64)
        n = puls_hexn(state, p, n, ab_rsp, 8)
    }
    board_remember(13, p, n, rot)
    board_line_say(state, p, n)
}

// ====================================================== RUNDE BLECHKERN
// DIE ABSTURZANZEIGE SAGT DASSELBE AUCH AUF DIE LEITUNG.
//
// Justin hat keine serielle Leitung, also ist der Schirm fuer ihn die
// Wahrheit -- und genau deshalb muss der PRUEFSTAND nachlesen koennen,
// was dort steht. Bisher ging die Anzeige nur auf den Rahmenpuffer; ob
// eine Zeile wirklich gemalt wurde, liess sich nur fotografieren und
// mit dem Auge vergleichen. Ab hier steht jede Zeile Oktett fuer Oktett
// auch im Mitschnitt, mit demselben Puffer und derselben Laenge.
fn from_line(state: u64, z: u64, p: u64, n: u64, farbe: u64) {
    wm.messzeile(state, z, p, n, farbe)
    var v: [u8; 12] = "absturz:  ␀\0"
    serial.puts((&v[0]) as u64)
    serial.dec(z)
    serial.put(32 as u8)
    serial.text(p, n)
    serial.nl()
}

fn absturz_klinke() -> u64 {
    return ab_klinke
}

fn absturz(state: u64, vec: u64, err: u64, rip: u64, cr2: u64, rsp: u64,
    cs: u64, kern: u64, spur: u64, spurn: u64, gestoppt: u64) {
    // ZUERST MERKEN, DANN MALEN. Kommt der Kern beim Malen selbst um,
    // steht die Aufzeichnung trotzdem und die Tafel des naechsten
    // Anstrichs bringt sie auf den Schirm.
    ab_zahl = ab_zahl + 1
    if ab_klinke == 0 {
        ab_vec = vec
        ab_rip = rip
        ab_cr2 = cr2
        ab_rsp = rsp
        ab_err = err
        ab_cs = cs
        ab_kern = kern
        // RUNDE BLECHKERN: die Ruecksprungkette des Kernstapels wird
        // MITGEMERKT, nicht nur mitgemalt -- die Klinke muss sie bei
        // jedem spaeteren Anstrich wieder hinschreiben koennen.
        ab_spurn = 0
        while ab_spurn < spurn && ab_spurn < 5 {
            ab_spur[ab_spurn as usize] =
                __mmio_read64((spur + ab_spurn * 8) as *mut u64)
            ab_spurn = ab_spurn + 1
        }
        ab_stopp = gestoppt
        ab_haelt = 0
        if kstate.mode_on(state, kstate.M_ABSTURZ) {
            ab_haelt = 1
        }
        ab_klinke = 1
    }
    if !fb.ready(state) {
        return
    }
    // Vier Oktett je Name, damit der Index eine Multiplikation ist --
    // dieselbe Tabelle wie in `trap.report`, damit auf dem Schirm
    // dasselbe Wort steht wie auf der Leitung.
    var namen: [u8; 128] = "#DE\0#DB\0NMI\0#BP\0#OF\0#BR\0#UD\0#NM\0#DF\0#CO\0#TS\0#NP\0#SS\0#GP\0#PF\0r15\0#MF\0#AC\0#MC\0#XM\0#VE\0#CP\0r22\0r23\0r24\0r25\0r26\0#HV\0#VC\0#SX\0r30\0r31\0"
    fb.band_open(state, true)
    // ============================================== RUNDE LEISTE
    // DIE ZWEI ZAHLEN VERGLEICHEN, EINMAL, LAUT.
    //
    // `kgui.TAFEL_ZEILEN` und `wm.MESS_ZEILEN` muessen gleich sein.
    // Sie sind es viermal nicht gewesen (BLECHDREI, STARTKNOPF und
    // zweimal in dieser Runde), und jedes Mal war die Folge etwas
    // anderes: abgeschnittene Zeilen, ein schwarzes Drittel, und
    // zuletzt ein #PF im Kern. Der Vergleich kostet eine Zeile.
    if wm.measure_lines() != BOARD_LINES {
        var s_uz: [u8; 33] = "tafel: ZEILENZAHL UNGLEICH kgui=\0"
        var s_uw: [u8; 6] = "  wm=\0"
        serial.puts((&s_uz[0]) as u64)
        serial.dec(BOARD_LINES)
        serial.puts((&s_uw[0]) as u64)
        serial.dec(wm.measure_lines())
        serial.nl()
    }
    wm.measure_reason(state, BOARD_LINES, TAFEL_SPALTEN)
    var b: [u8; 64] = [0 as u8; 64]
    let p: u64 = (&b[0]) as u64
    let rot: u64 = wm.mess_rot(state)
    let gelb: u64 = wm.mess_gelb(state)
    var n: u64 = 0

    var z0: [u8; 21] = "*** ABSTURZ *** VEK \0"
    var lz: [u8; 2] = " \0"
    n = puls_text(state, p, 0, (&z0[0]) as u64)
    n = pulse_num(state, p, n, vec)
    n = puls_text(state, p, n, (&lz[0]) as u64)
    if vec < 32 {
        n = puls_text(state, p, n, (&namen[0]) as u64 + vec * 4)
    }
    from_line(state, 0, p, n, rot)

    var z1: [u8; 5] = "RIP \0"
    n = puls_text(state, p, 0, (&z1[0]) as u64)
    n = puls_hexn(state, p, n, rip, 16)
    from_line(state, 1, p, n, rot)

    // ============================================ RUNDE STARTKNOPF
    // CR2 GILT NUR BEI #PF -- SONST IST DIE ZAHL ALT.
    //
    // Das Register wird von einem Seitenfehler gesetzt und von NICHTS
    // wieder geloescht. Justins Foto zeigte neben einem #GP ein cr2
    // von 0x4007EFF8, und diese Zahl hat eine ganze Stunde Analyse in
    // die falsche Richtung gefuehrt: sie stammte vom Wachsen des
    // Prozessstapels und hatte mit dem Absturz nichts zu tun. Ein
    // Messgeraet, das eine alte Zahl neben eine neue stellt, ohne es
    // zu sagen, ist schlimmer als eins, das schweigt.
    var z2: [u8; 5] = "CR2 \0"
    var z2a: [u8; 12] = "  (ALT, \0\0\0\0"
    var z2b: [u8; 17] = "gilt nur bei PF)\0"
    n = puls_text(state, p, 0, (&z2[0]) as u64)
    n = puls_hexn(state, p, n, cr2, 16)
    if vec != 14 {
        n = puls_text(state, p, n, (&z2a[0]) as u64)
        n = puls_text(state, p, n, (&z2b[0]) as u64)
    }
    from_line(state, 2, p, n, rot)

    var z3: [u8; 5] = "ERR \0"
    var z3b: [u8; 6] = "  CS \0"
    n = puls_text(state, p, 0, (&z3[0]) as u64)
    n = puls_hexn(state, p, n, err & 0xFFFFFFFF, 8)
    n = puls_text(state, p, n, (&z3b[0]) as u64)
    n = puls_hexn(state, p, n, cs & 0xFFFF, 4)
    from_line(state, 3, p, n, rot)

    var z4: [u8; 5] = "RSP \0"
    n = puls_text(state, p, 0, (&z4[0]) as u64)
    n = puls_hexn(state, p, n, rsp, 16)
    from_line(state, 4, p, n, rot)

    // Wo der Kern zuletzt WAR. `st()` setzt die Stufe in jeder Runde
    // des Schreibtischs; zusammen mit dem RIP sagt sie, in welchem
    // Abschnitt es geknallt ist, auch ohne Symboltafel.
    var z5: [u8; 10] = "STUFE ST \0"
    var z5b: [u8; 6] = " MAX \0"
    var z5c: [u8; 6] = " RND \0"
    n = puls_text(state, p, 0, (&z5[0]) as u64)
    n = pulse_num(state, p, n, level_num())
    n = puls_text(state, p, n, (&z5b[0]) as u64)
    n = pulse_num(state, p, n, stufe_max())
    n = puls_text(state, p, n, (&z5c[0]) as u64)
    n = pulse_num(state, p, n, wm_runden())
    from_line(state, 5, p, n, gelb)

    // ============================================ RUNDE STARTKNOPF
    // WER. Ein Ring-0-Absturz ohne den Prozess dahinter laesst offen,
    // welches Programm ihn ausgeloest hat -- und genau das war Justins
    // Frage ("ich habe ein Fenster zugemacht, und dann war er weg").
    // AUF ist der Platz der laufenden Aufgabe, PID ihre Kennung, ART
    // ihre Gattung (2 = Nutzerprozess), SYS die Nummer des zuletzt
    // begonnenen Systemaufrufs.
    var z7: [u8; 5] = "AUF \0"
    var z7b: [u8; 7] = " PID \0\0"
    var z7c: [u8; 7] = " ART \0\0"
    var z7d: [u8; 7] = " PRG \0\0"
    var z7e: [u8; 7] = " BAD \0\0"
    let cur: u64 = sched.current(state)
    n = puls_text(state, p, 0, (&z7[0]) as u64)
    n = pulse_num(state, p, n, cur)
    n = puls_text(state, p, n, (&z7b[0]) as u64)
    n = pulse_num(state, p, n, sched.tget(state, cur, sched.T_PID))
    n = puls_text(state, p, n, (&z7c[0]) as u64)
    n = pulse_num(state, p, n, sched.tget(state, cur, sched.T_KIND))
    n = puls_text(state, p, n, (&z7d[0]) as u64)
    var pn: u64 = 0
    while pn < 16 && pmon.name_at(state, cur, pn) != 0 {
        if n < TAFEL_SPALTEN - 1 {
            kstate.set8(p + n, pmon.name_at(state, cur, pn) as u8)
            n = n + 1
        }
        pn = pn + 1
    }
    n = puls_text(state, p, n, (&z7e[0]) as u64)
    n = pulse_num(state, p, n, proc.badentry_num())
    from_line(state, 6, p, n, gelb)

    // UND JETZT DIE WAHRHEIT UEBER DAS ANHALTEN. `halt_forever` haelt
    // DIESEN Kern an, nicht die Maschine. Steht daneben eine
    // Kernnummer ungleich 0, laeuft der Rest weiter -- und genau das
    // hat Justin gesehen.
    var z8: [u8; 6] = "KERN \0"
    var z8a: [u8; 26] = " HAELT AN -- BITTE FOTO\0\0\0"
    var z8b: [u8; 29] = " LAEUFT WEITER -- BITTE FOTO\0"
    var z8c: [u8; 9] = "  NR \0\0\0\0"
    n = puls_text(state, p, 0, (&z8[0]) as u64)
    n = pulse_num(state, p, n, ab_kern)
    if ab_haelt != 0 {
        n = puls_text(state, p, n, (&z8a[0]) as u64)
    } else {
        n = puls_text(state, p, n, (&z8b[0]) as u64)
    }
    n = puls_text(state, p, n, (&z8c[0]) as u64)
    n = pulse_num(state, p, n, ab_zahl)
    from_line(state, 7, p, n, gelb)

    // ============================================ RUNDE BLECHKERN
    // WOHER DER SPRUNG KAM -- die Kette der Ruecksprungadressen, die
    // noch auf dem KERNSTAPEL steht.
    //
    // Justins Anzeige sagte `RIP 0000000000000080`, und 0x80 ist keine
    // Adresse: dorthin springt nur, wessen Ruecksprungkette jemand
    // ueberschrieben hat. Welche Adresse das war, stand nirgends. Diese
    // Zeile ist die Antwort: die ersten fuenf Zahlen ab `rsp`, die
    // zwischen 0x100000 und dem Kernende liegen. `addr2line` auf
    // `kernel.img.elf` macht daraus Quellzeilen.
    var z9: [u8; 7] = "SPUR ␀\0"
    var z9k: [u8; 9] = "(keine)␀\0"
    var z9l: [u8; 3] = " ␀\0"
    n = puls_text(state, p, 0, (&z9[0]) as u64)
    if ab_spurn == 0 {
        n = puls_text(state, p, n, (&z9k[0]) as u64)
    } else {
        var si: u64 = 0
        while si < ab_spurn && si < 4 {
            n = puls_hexn(state, p, n, ab_spur[si as usize], 8)
            n = puls_text(state, p, n, (&z9l[0]) as u64)
            si = si + 1
        }
    }
    from_line(state, 8, p, n, gelb)

    // UND WAS MIT DEN ANDEREN KERNEN GESCHIEHT. `halt_forever` haelt nur
    // den eigenen an; seit dieser Runde bekommen die uebrigen einen NMI
    // und bleiben im Fangnetz stehen. Steht hier eine Zahl, ist die
    // Maschine wirklich still und die Anzeige wird nicht mehr
    // ueberschrieben.
    var za: [u8; 16] = "ANDERE KERNE: ␀\0"
    var zb: [u8; 22] = " NMI, MASCHINE STEHT␀\0"
    var zc: [u8; 18] = "keiner -- allein␀\0"
    n = puls_text(state, p, 0, (&za[0]) as u64)
    if ab_stopp == 0 {
        n = puls_text(state, p, n, (&zc[0]) as u64)
    } else {
        n = pulse_num(state, p, n, ab_stopp)
        n = puls_text(state, p, n, (&zb[0]) as u64)
    }
    from_line(state, 9, p, n, gelb)

    // UNBEDINGT UEBERTRAGEN. Kein `dirty`, kein `compose`, keine
    // Bedingung -- das ganze Band in einem Zug auf die Karte.
    fb.flush_rect(state, 0, 0, wm.mess_vollbreite(state),
        wm.messhoehe(state, BOARD_LINES))
    fb.band_open(state, false)
}

// Der Zustand der Aufgabe hinter dem obersten Ebenenfenster -- das ist
// die Taskleiste. 0, wenn es keins gibt.
// ==================================================== RUNDE LEISTE
// DER HOECHSTE KERNSTAPELSTAND ALLER AUFGABEN, in Oktetten.
//
// `sched.stack_high` liest die Hochwassermarke aus der Faerbung
// zurueck. Was hier steht, ist das Maximum ueber alle lebenden
// Aufgaben -- die eine Zahl, an der man sieht, ob 64 KiB reichen. Sie
// gehoert neben den Waechterzaehler: der sagt, DASS es passiert ist,
// diese sagt, WIE NAH man dran ist.
fn kstack_up(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var m: u64 = 0
    while i < n {
        if sched.tget(state, i, sched.T_STATE) != sched.S_FREE {
            let h: u64 = sched.stack_high(state, i)
            if h > m {
                m = h
            }
        }
        i = i + 1
    }
    return m
}

fn taskbar_state(state: u64) -> u64 {
    // RUNDE LEISTE: `panel_win` und nicht `top_layer_win` -- seit dem
    // Startmenue liegt auf L_TOP mehr als die Leiste, und `TB` hat
    // eine Runde lang den Starter gemessen.
    let tb: u64 = wm.panel_win(state)
    if tb >= wm.MAX_WIN {
        return 0
    }
    let o: u64 = wm.win_owner(state, tb)
    if o >= kstate.MAX_TASKS {
        return 0
    }
    return sched.tget(state, o, sched.T_STATE)
}

fn tafel_streichen(state: u64) {
    if !fb.ready(state) {
        return
    }
    if tafel_drin != 0 {
        return
    }
    tafel_drin = 1
    tafel_mal = tafel_mal + 1
    // ============================================ RUNDE STARTKNOPF
    // WAR SCHON EINMAL ETWAS? Dann steht es in JEDEM Anstrich wieder
    // da. Justins erster Absturz war nach einer Mausbewegung spurlos
    // weg -- der naechste Anstrich hatte ihn ueberschrieben, und
    // damit war das wichtigste Beweisstueck des Abends fort.
    if ab_klinke != 0 {
        crash_lines(state)
    }
    // Die Takt-Zeile wird JEDES MAL frisch gebaut -- sie ist der Puls,
    // und ein Puls aus dem Zwischenspeicher waere keiner.
    var tb: [u8; 64] = [0 as u8; 64]
    let tp: u64 = (&tb[0]) as u64
    // ============================================ RUNDE ECHTHARDWARE-5
    // HIER FEHLTE DIE NULL AM ENDE -- UND DAS IST DER GRUND FUER
    // JUSTINS ZWEITE ROTE ZEILE.
    //
    // `"8 TICK  "` sind ACHT Zeichen in einem Feld von ACHT Oktetten:
    // kein Abschluss. `puls_text` kopiert bis zur Null und lief
    // deshalb ueber das Feldende hinaus in die Nachbarfelder --
    // gemessen stand auf der Leitung
    //
    //     tafel: 8 TICK  8 TICK  8 TICK  ... (vierundzwanzigmal)
    //
    // also 190 Zeichen statt der 48, die auf die Tafel passen. Die
    // Zeile wurde abgeschnitten, `zu_lang` bekam ihr Bit gesetzt, und
    // GENAU DAS faerbt Zeile 23 rot (`LG 3 Z8 190` -- drei zu lange
    // Zeilen, die laengste ist Zeile 8 mit 190 Zeichen).
    //
    // Justins Frage "was bedeutet das Rot" hat damit eine sehr
    // einfache Antwort: einen fehlenden Nullabschluss, drei Zeilen
    // weiter oben. Kein Sicherheitsproblem, aber auch kein Schoenheits-
    // fehler -- es war ein Lesen ueber die Grenze eines Feldes hinaus.
    var t8: [u8; 9] = "8 TICK  \0"
    var t_i: [u8; 5] = "IRQ \0"
    var t_m: [u8; 6] = " MAL \0"
    var t_l: [u8; 7] = " LOOP \0"
    var tn: u64 = 0
    tn = puls_text(state, tp, 0, (&t8[0]) as u64)
    tn = puls_text(state, tp, tn, (&t_i[0]) as u64)
    tn = pulse_num(state, tp, tn, tafel_irq)
    tn = puls_text(state, tp, tn, (&t_m[0]) as u64)
    tn = pulse_num(state, tp, tn, tafel_mal)
    tn = puls_text(state, tp, tn, (&t_l[0]) as u64)
    tn = pulse_num(state, tp, tn, tafel_loop)
    // RUNDE KABEL: UND DER GEMESSENE PREEMPT-WERT.
    //
    // Justin hat meine Erklaerung der Vorrunde im Quelltext widerlegt:
    // `nosched` setzt NUR M_NOSCHED, und ausgewertet wird das in
    // `kmain.scheduler()` -- dem Selbsttest mit den drei K_WORKERn.
    // `sched.init` steht in `kmain.fi:387`, im Hauptpfad, und setzt
    // PREEMPT auf 1. `M_NOPREEMPT` steht HINTER dem nosched-Return und
    // wird bei `nosched` nie erreicht. Die Verdraengung ist also AN.
    // Damit das nicht wieder eine Lesung bleibt, steht die Zahl hier.
    var t_p: [u8; 6] = " PRE \0"
    tn = puls_text(state, tp, tn, (&t_p[0]) as u64)
    tn = pulse_num(state, tp, tn, kstate.get(state, kstate.PREEMPT))
    // RUNDE BLECHDREI: DIE RATE, AUS DEM ZYKLENZAEHLER. Soll 100.
    var t_hz: [u8; 5] = " HZ \0"
    let hz: u64 = hz_takt(state)
    tn = puls_text(state, tp, tn, (&t_hz[0]) as u64)
    tn = pulse_num(state, tp, tn, hz)
    board_remember(8, tp, tn, wm.mess_ampel(state, tafel_loop))
    board_line_say(state, tp, tn)

    // ---- Zeile 9: DAS KABEL. Sitzt an 0x3F8 ueberhaupt ein Baustein?
    //
    // LSR 00 heisst: nicht dekodiertes Tor, es gibt keinen UART -- und
    // GENAU DANN drehte `serial.put` bis zu dieser Runde fuer immer.
    // LSR FF heisst offener Bus. SCR ist das Notizregister: kommt A5
    // zurueck, sitzt dort einer.
    // ============================================ RUNDE BLECHVIER
    // AUS DER KABEL-ZEILE WIRD DIE EICH-ZEILE.
    //
    // `VERW` und `AUS` haben ihre Frage beantwortet (Justins Brett hat
    // keinen UART, LSR FF, und `serial.put` dreht seit der Runde KABEL
    // nicht mehr fuer immer). An ihre Stelle tritt die Frage dieser
    // Runde: STIMMT DIE EICHUNG UEBERHAUPT?
    //   PIT -- Zyklen je Mikrosekunde, gegen den 8254 gemessen
    //   PM  -- dasselbe, gegen den ACPI-Zeitgeber (3,579545 MHz, per
    //          Spezifikation, von SMIs nicht zu verfaelschen)
    //   ABW -- Abweichung der beiden in PROMILLE. Ueber hundert (zehn
    //          Prozent) verwirft Linux eine Eichung; 9999 heisst, dass
    //          gar nicht verglichen werden konnte.
    // Auf Ryzen wird der 8254 ueber LPC emuliert -- dort ist genau das
    // die Zahl, die entscheidet, ob die Uhr dieses Kerns etwas taugt.
    var t9: [u8; 10] = "9 CALIB  \0"
    var k_l: [u8; 5] = "LSR \0"
    var t_s: [u8; 6] = " PIT \0"
    var k_v: [u8; 5] = " PM \0"
    var t_a: [u8; 6] = " ABW \0"
    var k_m: [u8; 5] = " FB \0"
    var k_wb: [u8; 3] = "WB\0"
    var k_wc: [u8; 3] = "WC\0"
    var k_uc: [u8; 3] = "UC\0"
    tn = puls_text(state, tp, 0, (&t9[0]) as u64)
    tn = puls_text(state, tp, tn, (&k_l[0]) as u64)
    tn = puls_hex(state, tp, tn, serial.lsr_roh())
    tn = puls_text(state, tp, tn, (&t_s[0]) as u64)
    tn = pulse_num(state, tp, tn, time.khz(state) / 1000)
    tn = puls_text(state, tp, tn, (&k_v[0]) as u64)
    tn = pulse_num(state, tp, tn, hw.pm_tschz(state) / 1000000)
    tn = puls_text(state, tp, tn, (&t_a[0]) as u64)
    tn = pulse_num(state, tp, tn, hw.pm_abweichung(state))
    // UND DIE ABBILDUNGSART DES RAHMENPUFFERS. WB heisst: kleine
    // Aenderungen bleiben im Zwischenspeicher und kommen nie an.
    tn = puls_text(state, tp, tn, (&k_m[0]) as u64)
    if fb.uncached(state) {
        tn = puls_text(state, tp, tn, (&k_uc[0]) as u64)
    } else if fb.wc(state) != 0 {
        tn = puls_text(state, tp, tn, (&k_wc[0]) as u64)
    } else {
        tn = puls_text(state, tp, tn, (&k_wb[0]) as u64)
    }
    // Gruen, wenn das Notizregister A5 zurueckgab -- sonst rot.
    // Gruen, solange die zwei Uhren um weniger als ein Prozent
    // auseinanderliegen. Rot heisst: eine der beiden luegt, und dann
    // ist jede Zeitangabe dieses Kerns eine Schaetzung.
    var kfarbe: u64 = wm.mess_rot(state)
    if hw.pm_abweichung(state) < 10 {
        kfarbe = wm.mess_gruen(state)
    }
    board_remember(9, tp, tn, kfarbe)
    board_line_say(state, tp, tn)

    // ---- Zeile 10: DER HERZSCHLAG UND DER ZEITGEBER ----
    //
    // `HZ` ist die Zahl der Rufe aus dem Zeitgeberbehandler, seit der
    // Kern laeuft. Steht sie, steht der Zeitgeber. `TOT` zaehlt, wie oft
    // eine Aufgabe NICHT schlafen gelegt wurde, weil seit 300 ms
    // (am Zyklenzaehler gemessen) keine Marke mehr kam -- eine Zahl
    // groesser null ist der Beweis, dass der Zeitgeber wirklich stand.
    var t10: [u8; 10] = "10 BEAT  \0"
    // RUNDE BLECHFUENF: DIESE ZAHL IST KEINE FREQUENZ. Zeile 8 hat ein
    // `HZ`, und das IST eine (Marken je Sekunde, aus dem
    // Zyklenzaehler). Hier stand dasselbe Wort vor einer SCHLAGZAHL --
    // "HERZ HZ 2178" neben "TAKT HZ 99" laesst jeden die Tafel falsch
    // lesen. Zwei Groessen, zwei Namen.
    var h_h: [u8; 6] = "SCHL \0"
    var h_t: [u8; 6] = " TOT \0"
    var h_l: [u8; 6] = " LED \0"
    // ============================================ RUNDE ECHTHARDWARE-5
    // `HELL` HIESS NICHT HELLIGKEIT, UND GENAU SO WURDE ES GELESEN.
    //
    // Justin zu seiner Tafel (Zeile 10, `HELL 163`): er hat die Zahl
    // fuer den Wert des HELLIGKEITSREGLERS gehalten und gefragt, warum
    // der Regler nichts tut, obwohl dort 163 steht.
    //
    // Sie hat mit Helligkeit nichts zu tun. `herz_hell` zaehlt, wie oft
    // das BLINKFELD des Herzschlags hell war (`herz_tick`: alle 25
    // Marken wird `herz_an` umgelegt und bei jedem hellen Durchgang um
    // eins erhoeht). 163 heisst also "das Herz hat 163 Mal geblinkt" --
    // ein Lebenszeichen, kein Regler.
    //
    // Eine Abkuerzung, die zwei Dinge bedeuten kann, ist auf einer
    // Diagnosetafel keine Abkuerzung, sondern eine Falle. Sie heisst
    // jetzt `BLINK`, und damit steht auf der Tafel, was gemessen wird.
    var h_b: [u8; 8] = " BLINK \0"
    tn = puls_text(state, tp, 0, (&t10[0]) as u64)
    tn = puls_text(state, tp, tn, (&h_h[0]) as u64)
    tn = pulse_num(state, tp, tn, beat_num())
    tn = puls_text(state, tp, tn, (&h_t[0]) as u64)
    tn = pulse_num(state, tp, tn, sched.tote_schlaefe(state))
    tn = puls_text(state, tp, tn, (&h_l[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.leds_sent(state))
    // RUNDE BLECHZWEI: VERSUCHE UND FEHLSCHLAEGE GETRENNT. Justins
    // Tafel sagte "LED 0", und das ist zweideutig: keine Tastatur, oder
    // Tastatur da und der Steuertransfer scheitert. `T` sind die
    // Versuche, `B` die Fehlschlaege -- damit ist es eindeutig.
    var h_v: [u8; 2] = "/\0"
    tn = puls_text(state, tp, tn, (&h_v[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.leds_try(state))
    tn = puls_text(state, tp, tn, (&h_v[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.leds_fail(state))
    tn = puls_text(state, tp, tn, (&h_b[0]) as u64)
    tn = pulse_num(state, tp, tn, beat_brightnum())
    board_remember(10, tp, tn, wm.mess_ampel(state, beat_num()))
    board_line_say(state, tp, tn)

    // ---- Zeile 11: WAS AN USB HAENGT ----
    var t11: [u8; 10] = "11 USB   \0"
    var u_d: [u8; 5] = "DEV \0"
    var u_f: [u8; 7] = " FUND \0"
    var u_h: [u8; 6] = " HUB \0"
    var u_k: [u8; 6] = " KBD \0"
    var u_t: [u8; 6] = " TAS \0"
    var u_x: [u8; 7] = " FAIL \0"
    tn = puls_text(state, tp, 0, (&t11[0]) as u64)
    tn = puls_text(state, tp, tn, (&u_d[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.count(state))
    tn = puls_text(state, tp, tn, (&u_f[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.fund_count(state))
    tn = puls_text(state, tp, tn, (&u_h[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.hubs(state))
    // RUNDE BLECHZWEI: `KBD` war die Zahl der TASTENEREIGNISSE und
    // stand damit neben einer USB-Diagnose, die "kbd=1" meldete --
    // zwei Zaehler, die dasselbe Wort benutzen und Verschiedenes
    // zaehlen. Jetzt getrennt: `KBD` ist das GERAET (Platz + 1, 0 =
    // keines), `TAS` sind die angekommenen Tasten.
    tn = puls_text(state, tp, tn, (&u_k[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.kbd_dev(state))
    tn = puls_text(state, tp, tn, (&u_t[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.hid_keys(state))
    tn = puls_text(state, tp, tn, (&u_x[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.fails(state))
    board_remember(11, tp, tn, wm.mess_ampel(state, usb.fund_count(state)))
    board_line_say(state, tp, tn)

    // ---- Zeile 12: DIE STUFENMARKE. WO STEHT DER KERN? ----
    //
    // `ST` ist der zuletzt erreichte Schritt, `MAX` der hoechste
    // ueberhaupt erreichte, `RND` die Rundenzahl der
    // Schreibtischschleife. Stehen ST und MAX auf derselben Zahl und
    // RND bleibt null, haengt es GENAU an dieser Zeile:
    //   19 usb_bericht   21 i18n_bench   22 desk_start
    //   25 shell_start   30 vor der Schleife
    //   32 usb.poll  33 hotplug_work  34 wm.poll  35 wm.compose
    //   36 kopf_malen  37 der Puls  38 sleep_ticks   40 zurueck
    var t12: [u8; 10] = "12 STAGE \0"
    var s_st: [u8; 4] = "ST \0"
    var s_mx: [u8; 6] = " MAX \0"
    // RUNDE BLECHFUENF: WAS `RND` IST. Justin sah "RND 2200221" neben
    // "LOOP 810" und hielt die Zahl fuer Unsinn. Sie ist es nicht:
    // `RND` sind die RUNDEN DER SCHREIBTISCHSCHLEIFE (`wm_runden`,
    // gesetzt in `wait_wm`), `LOOP` sind die Anstriche der Tafel aus
    // ebendieser Schleife. Die Schleife dreht viel oefter, als die
    // Tafel gemalt wird -- das Verhaeltnis ist der Anstrichtakt und
    // kein Fehler. In QEMU steht es bei rund zehn zu eins, auf Justins
    // Brett bei rund zweitausendsiebenhundert zu eins; woran das liegt,
    // ist UNGEMESSEN und gehoert in eine eigene Runde.
    var s_rd: [u8; 6] = " RND \0"
    var s_lp: [u8; 7] = " LOOP \0"
    tn = puls_text(state, tp, 0, (&t12[0]) as u64)
    tn = puls_text(state, tp, tn, (&s_st[0]) as u64)
    tn = pulse_num(state, tp, tn, level_num())
    tn = puls_text(state, tp, tn, (&s_mx[0]) as u64)
    tn = pulse_num(state, tp, tn, stufe_max())
    tn = puls_text(state, tp, tn, (&s_rd[0]) as u64)
    tn = pulse_num(state, tp, tn, wm_runden())
    tn = puls_text(state, tp, tn, (&s_lp[0]) as u64)
    tn = pulse_num(state, tp, tn, tafel_loop)
    // ==================================== RUNDE STARTKNOPF
    // UND DER ZUSTAND DER TASKLEISTE, IM ZEITGEBERPFAD.
    //
    // Zeile 7 sagt dasselbe ausfuehrlicher -- aber Zeile 7 wird aus
    // der SCHREIBTISCHSCHLEIFE gemalt, und wenn die haengt, ist sie
    // nicht da. Genau dann wird sie gebraucht. Also steht die eine
    // entscheidende Zahl hier, wo der Zeitgeber sie hinschreibt:
    //   1 bereit  2 laeuft  3 SCHLAEFT  4 wartet  5 LEICHE  0 keine
    var s_tb: [u8; 5] = " TB \0"
    tn = puls_text(state, tp, tn, (&s_tb[0]) as u64)
    tn = pulse_num(state, tp, tn, taskbar_state(state))
    // ======================================== RUNDE LEISTE
    // DIE WAECHTERSEITE UNTER DEN KERNSTAPELN.
    //
    // `WA` ist die Zahl der Ueberlaeufe, `T` wie tief der letzte ging
    // (in Oktetten unter den Stapelboden) und `KS` der hoechste je
    // gemessene Stapelstand aller Aufgaben, in Oktetten von 65536.
    //
    // WA MUSS NULL BLEIBEN. Steht dort etwas anderes, hat ein
    // Kernstapel in fremden Speicher geschrieben, und jeder andere
    // Messwert auf dieser Tafel ist ab da eine Vermutung.
    // RUNDE VIELKERN: WA, T, KS und R3F sind von hier auf Zeile 23
    // gewandert. Sie standen ab Zeichen 46 einer 70 Zeichen langen
    // Zeile und waren auf einer 48 Zeichen breiten Tafel unsichtbar.
    // ======================================== RUNDE BLECHKERN
    // R3F: RING-3-PROZESSE AUF EINEM FREMDEN KERN.
    //
    // Bis zu dieser Runde durfte ein Anwendungskern einen Benutzer-
    // prozess nehmen, obwohl `syscall_entry` den Kernstapel aus EINEM
    // Wort fuer die ganze Maschine holt. Zwei Kerne standen dann auf
    // einem Stapel. Das war Justins #UD auf Kern 2, und es war der
    // ganze Unterschied zwischen `-smp 1` (sauber) und `-smp 4`.
    //
    // R3F MUSS NULL BLEIBEN, genau wie WA. Steht dort etwas anderes,
    // ist die Bindung an Kern 0 durchbrochen.
    var ampel12: u64 = wm.mess_ampel(state, wm_runden())
    board_remember(12, tp, tn, ampel12)
    board_line_say(state, tp, tn)

    // ---- Zeile 13: DIE ABBILDUNG, AUS DER SEITENTAFEL GELESEN ----
    //
    // Nicht die ABSICHT (`S_WC`), sondern die BITS, die wirklich in der
    // Seitentafel stehen:
    //   PDE 00E3 = write-back      (der stille Fall)
    //   PDE 10E3 = write-combining (Bit 12 gesetzt)
    //   PDE 00FB = uncached        (Bit 3 und 4 gesetzt)
    // GEMESSEN in QEMU mit allen drei Betriebsarten, nicht gerechnet.
    // `PAT` ist Oktett 4 des MSR 0x277 -- es MUSS 01 sein, sonst ist
    // das PAT-Bit in der Seitentafel wirkungslos. `KCH` sagt, wie viele
    // 2-MiB-Kacheln der Puffer braucht; mehr als acht heisst
    // Streifenbetrieb.
    var t13: [u8; 10] = "13 IMAGE \0"
    var a_p: [u8; 6] = " PDE \0"
    var a_t: [u8; 6] = " PAT \0"
    var a_k: [u8; 6] = " KCH \0"
    let pde: u64 = fb.pde_roh(state)
    tn = puls_text(state, tp, 0, (&t13[0]) as u64)
    tn = puls_text(state, tp, tn, (&a_p[0]) as u64)
    tn = puls_hexn(state, tp, tn, pde & 0xFFFF, 4)
    tn = puls_text(state, tp, tn, (&a_t[0]) as u64)
    tn = puls_hexn(state, tp, tn, (fb.pat_roh(state) >> 32) & 0xFF, 2)
    tn = puls_text(state, tp, tn, (&a_k[0]) as u64)
    tn = pulse_num(state, tp, tn, fb.stripe_slots(state))
    // Gruen, wenn die Seitentafel WIRKLICH write-combining oder
    // uncached sagt -- rot bei write-back, denn dann bleibt eine kleine
    // Aenderung im Zwischenspeicher liegen und kommt nie an.
    var afarbe: u64 = wm.mess_rot(state)
    if (pde & 0x1000) != 0 || (pde & 0x18) != 0 {
        afarbe = wm.mess_gruen(state)
    }
    board_remember(13, tp, tn, afarbe)
    board_line_say(state, tp, tn)

    // ---- Zeile 14: WELCHER USB-REGLER GEWONNEN HAT ----
    //
    // Justins Brett hat ZWEI xHCI-Regler, und dieser Kern faehrt genau
    // EINEN (sein Vorrat -- Ringe, Zusammenhaenge, Endpunkttafel --
    // liegt einmal da). Welcher es wird, entscheidet eine Punktzahl:
    // acht je Boot-Tastatur oder Boot-Maus, drei je andere HID-Klasse,
    // eins fuer den generischen Weg. Der Stick zaehlt NICHT.
    //
    // Zwischen zwei Laeufen desselben Sticks kippte diese Wahl bei
    // Justin von "Tastatur und Maus" auf "nur der Stick" -- die Zahlen
    // standen aber nur auf der SERIELLEN Leitung, und die hat er nicht.
    // Jetzt stehen sie auf dem Schirm: `HC` ist die Wahl von wie vielen,
    // `P` sind die Punkte je Regler in ihrer Reihenfolge.
    var t14: [u8; 10] = "14 PICK  \0"
    var w_hc: [u8; 4] = "HC \0"
    var w_vo: [u8; 2] = "/\0"
    var w_pk: [u8; 4] = " P \0"
    var w_ko: [u8; 2] = ",\0"
    var w_rv: [u8; 6] = " RVR \0"
    var w_rf: [u8; 6] = " RFL \0"
    var w_mm: [u8; 6] = " MMU \0"
    let nhc: u64 = xhci.count_hc(state)
    tn = puls_text(state, tp, 0, (&t14[0]) as u64)
    tn = puls_text(state, tp, tn, (&w_hc[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.wahl(state))
    tn = puls_text(state, tp, tn, (&w_vo[0]) as u64)
    tn = pulse_num(state, tp, tn, nhc)
    tn = puls_text(state, tp, tn, (&w_pk[0]) as u64)
    var hi: u64 = 0
    while hi < nhc && hi < 4 {
        if hi != 0 {
            tn = puls_text(state, tp, tn, (&w_ko[0]) as u64)
        }
        tn = pulse_num(state, tp, tn, usb.pkt_get(state, hi))
        hi = hi + 1
    }
    // RUNDE BLECHVIER, DREI ZAHLEN DAZU:
    //   RVR -- wie viele Anschluesse zurueckgesetzt werden MUSSTEN,
    //          obwohl sie schon freigeschaltet waren. Das ist die Zahl
    //          der Geraete, die die FIRMWARE vor uns angefasst hatte --
    //          genau die, bei denen das Ueberspringen der Ruecksetzung
    //          eine tote Tastatur ergab.
    //   RFL -- Ruecksetzungen, die nicht quittiert wurden.
    //   MMU -- die Seitentafelbits des xHCI-REGISTERSATZES, aus der
    //          Seitentafel ZURUECKGELESEN. 01B = PRESENT|WRITE|PWT|PCD
    //          |HUGE, also unbeschreibbar -- richtig. Fehlten PWT/PCD
    //          (083), laege eine Tuerklingel im L1 und klingelte nie:
    //          derselbe Fehler wie beim Rahmenpuffer, nur schlimmer.
    tn = puls_text(state, tp, tn, (&w_rv[0]) as u64)
    tn = pulse_num(state, tp, tn, xhci.reset_vorbelegt(state))
    tn = puls_text(state, tp, tn, (&w_rf[0]) as u64)
    tn = pulse_num(state, tp, tn, xhci.reset_fails(state))
    tn = puls_text(state, tp, tn, (&w_mm[0]) as u64)
    tn = puls_hexn(state, tp, tn, xhci.bar_pde(state) & 0xFFF, 3)
    board_remember(14, tp, tn, wm.mess_ampel(state, usb.kbd_dev(state)))
    board_line_say(state, tp, tn)

    // ---- Zeile 15: STEHT DAS RESERVIERTE BAND WIRKLICH? ----
    //
    // Die Tafel selbst kann nicht beweisen, dass sie geschuetzt ist --
    // sie ist ja da. Diese Zeile sagt, WARUM: `H` ist die Hoehe des
    // gesperrten Bandes in Bildpunkten (0 = kein Schutz, dann kann der
    // Schreibtisch wieder darueber malen), `KOL` die Zahl der Spalten,
    // `SP` die Zeichen je Zeile -- die Zahl, die in der Vorrunde
    // stillschweigend auf dreissig beschnitten wurde.
    var t15: [u8; 10] = "15 STRIP \0"
    var b_h: [u8; 3] = "H \0"
    var b_k: [u8; 6] = " KOL \0"
    var b_s: [u8; 5] = " SP \0"
    var b_w: [u8; 5] = " BR \0"
    let bh: u64 = fb.band(state)
    tn = puls_text(state, tp, 0, (&t15[0]) as u64)
    tn = puls_text(state, tp, tn, (&b_h[0]) as u64)
    tn = pulse_num(state, tp, tn, bh)
    tn = puls_text(state, tp, tn, (&b_k[0]) as u64)
    tn = pulse_num(state, tp, tn, wm.mess_kol(state))
    tn = puls_text(state, tp, tn, (&b_s[0]) as u64)
    tn = pulse_num(state, tp, tn, TAFEL_SPALTEN)
    tn = puls_text(state, tp, tn, (&b_w[0]) as u64)
    tn = pulse_num(state, tp, tn, wm.mess_vollbreite(state))
    board_remember(15, tp, tn, wm.mess_ampel(state, bh))
    board_line_say(state, tp, tn)

    // ---- Zeile 16: DER ZEITGEBERBEHANDLER MISST SICH SELBST ----
    //
    // DIE ZEILE, DIE DIESE RUNDE BEANTWORTET. Justins Recherche hat
    // ausgerechnet, dass ein Anstrich von 396 ms bei 10-ms-Takt
    // neununddreissig von vierzig Schlaegen verschluckt -- IRR und ISR
    // haben ein Bit je Vektor, alles darueber faellt still weg (Intel
    // SDM Band 3, 10.8.4). Statt das zu glauben, steht es hier:
    //   US    -- wie lange der Behandler zuletzt gebraucht hat
    //   MAX   -- wie lange am laengsten
    //   VERL  -- Marken, die der Zyklenzaehler NACHTRAGEN musste
    //   SPAET -- Schlaege, die in einen laufenden Anstrich fielen und
    //            umgekehrt sind. Ohne die Sperre waeren genau das die
    //            verlorenen -- diese Zahl ist der Beweis, dass der
    //            Umbau wirkt.
    // Rot, sobald der Behandler laenger als eine halbe Marke braucht.
    // RUNDE BLECH2: OHNE `US` -- mit `LM` dahinter war die Zeile 50
    // Zeichen (Tafel: `LG 1 Z16 50`, gemessen). MAX ist die Zahl, an
    // der die Farbe haengt; die letzte Laufzeit steht weiter auf der
    // Leitung nicht -- wer sie braucht, hat trap.isr_us_last.
    // ============================================ RUNDE ECHTHARDWARE-5
    // `VERL` STAND HIER UND AUF ZEILE 4, UND MEINTE ETWAS ANDERES.
    //
    // Justin liest die Tafel als Ganzes und hat beide Zahlen in einem
    // Punkt zusammengefasst ("Ringpuffer verliert weiter Ereignisse:
    // RING ... VERL 29 ... ISR ... VERL 43"). Das sind aber zwei
    // voellig verschiedene Groessen:
    //
    //   Zeile 4  VERL -- EREIGNISSE, die aus dem Ring eines Fensters
    //                    gefallen sind (`wm.ev_push`).
    //   Zeile 16 VERL -- ZEITGEBERSCHLAEGE, die ausgefallen sind,
    //                    weil die Unterbrechungen gesperrt waren
    //                    (`trap.ticks_lost`). Mit dem Ring hat das
    //                    nichts zu tun.
    //
    // Zwei Groessen, zwei Namen: hier heisst es jetzt `TVERL`
    // (Takt-Verluste). Wer die Tafel liest, soll nicht zwei Dinge
    // addieren, die nichts miteinander zu tun haben.
    var t16: [u8; 8] = "16 ISR \0"
    var i_m: [u8; 5] = "MAX \0"
    var i_v: [u8; 8] = " TVERL \0"
    var i_s: [u8; 8] = " SPAET \0"
    let us: u64 = trap.isr_us_max()
    tn = puls_text(state, tp, 0, (&t16[0]) as u64)
    tn = puls_text(state, tp, tn, (&i_m[0]) as u64)
    tn = pulse_num(state, tp, tn, us)
    tn = puls_text(state, tp, tn, (&i_v[0]) as u64)
    tn = pulse_num(state, tp, tn, trap.ticks_lost())
    tn = puls_text(state, tp, tn, (&i_s[0]) as u64)
    tn = pulse_num(state, tp, tn, trap.ticks_late())
    // RUNDE BLECH2: `LM` -- die Marke, bei der ZULETZT nachgetragen
    // wurde. Steht sie klein und bleibt stehen, sind die VERL vom
    // Start (Aufzaehlung, Anschlussruecksetzung mit gesperrten
    // Unterbrechungen); laeuft sie mit, verliert der laufende Betrieb.
    // In SEKUNDEN seit dem Start (Marken / 100), damit die Zeile in 48
    // Zeichen bleibt.
    var i_lm: [u8; 5] = " LM \0"
    tn = puls_text(state, tp, tn, (&i_lm[0]) as u64)
    tn = pulse_num(state, tp, tn, trap.ticks_lost_at() / 100)
    var ifarbe: u64 = wm.mess_gruen(state)
    if us > 5000 {
        ifarbe = wm.mess_rot(state)
    }
    board_remember(16, tp, tn, ifarbe)
    board_line_say(state, tp, tn)

    // ---- Zeile 17: WAS DAS BLECH UNTER UNS TUT ----
    //
    // Drei Dinge, die in QEMU NIE auffallen und auf echtem Blech einen
    // Kern stillstehen lassen (siehe `hw.blech_stage`):
    //   GPE  -- wie viele General-Purpose-Event-Bits abgeschaltet
    //           wurden. Null heisst: keine FADT gefunden, und dann kann
    //           ein Ereignis den SCI dauerhaft ziehen.
    //   ST   -- was in den GPE-Statusregistern STAND. Groesser null
    //           heisst: es haette wirklich einen Sturm gegeben.
    //   IVR  -- das IVinfo-Feld der IVRS. 0 = keine IOMMU-Tabelle.
    //   CTL  -- Bit 0 des IOMMU-Steuerregisters: 1 = die Uebersetzung
    //           ist AN, und dann wird jeder DMA ausserhalb der
    //           Unity-Bereiche STILL abgebrochen.
    //   PMT  -- die Anschrift des ACPI-Zeitgebers (3,579545 MHz, per
    //           Spezifikation). Der richtige Eichmassstab auf Ryzen,
    //           wo der 8254 ueber LPC emuliert wird.
    var t17: [u8; 10] = "17 BOARD \0"
    var q_g: [u8; 5] = "GPE \0"
    var q_s: [u8; 5] = " ST \0"
    var q_i: [u8; 6] = " IVR \0"
    var q_c: [u8; 6] = " CTL \0"
    var q_p: [u8; 6] = " PMT \0"
    let ivr: u64 = hw.ivrs_info(state)
    let ctl: u64 = hw.iommu_ctrl(state)
    tn = puls_text(state, tp, 0, (&t17[0]) as u64)
    tn = puls_text(state, tp, tn, (&q_g[0]) as u64)
    tn = pulse_num(state, tp, tn, hw.gpe_abgeschaltet(state))
    tn = puls_text(state, tp, tn, (&q_s[0]) as u64)
    tn = puls_hex(state, tp, tn, hw.gpe_status(state))
    tn = puls_text(state, tp, tn, (&q_i[0]) as u64)
    tn = puls_hexn(state, tp, tn, ivr & 0xFFFF, 4)
    tn = puls_text(state, tp, tn, (&q_c[0]) as u64)
    tn = pulse_num(state, tp, tn, ctl & 1)
    tn = puls_text(state, tp, tn, (&q_p[0]) as u64)
    tn = puls_hexn(state, tp, tn, hw.pmtmr_port(state) & 0xFFFF, 4)
    // Rot, sobald die IOMMU wirklich uebersetzt -- das ist der Zustand,
    // in dem xHCI-Ereignisringe still leer bleiben.
    var bfarbe: u64 = wm.mess_gruen(state)
    if (ctl & 1) != 0 {
        bfarbe = wm.mess_rot(state)
    }
    board_remember(17, tp, tn, bfarbe)
    board_line_say(state, tp, tn)

    // ---- Zeile 18: DIE TASTATUR, OKTETT FUER OKTETT ----
    //
    // DIE ZEILE, DIE DIESE RUNDE BEANTWORTET. "KBD 2 TAS 0" ist
    // zweideutig -- eine Tastatur ist da, keine Taste kommt an, und
    // warum, steht nirgends. `ber=6188` half nicht: die Maus hatte
    // davon 6186, also ist die Summe ueber alle Geraete eine Zahl ohne
    // Aussage ueber die Tastatur.
    //
    // Hier zaehlt nur DIE TASTATUR:
    //   BER  -- fertige Unterbrechungstransfers DIESES Geraets
    //   ARM  -- wie oft ein Block auf ihren Ring gelegt wurde. Ist ARM
    //           gross und BER null, wird nachgefragt und nie
    //           geantwortet; sind beide null, laeuft der Transfer gar
    //           nicht.
    //   CC   -- der letzte Fertigmeldungscode (1 = gut, 13 = kurz,
    //           4 = Uebertragungsfehler, 6 = Stall)
    //   ROH  -- die ersten acht Oktett des zuletzt empfangenen Berichts
    //
    // UND SO LIEST JUSTIN SIE: eine Taste druecken und HALTEN, dann
    // fotografieren. Aendert sich ROH, kommt der Bericht an und der
    // Zerleger ist schuld. Bleibt ROH auf Nullen und BER steht, kommt
    // nichts an, und dann ist es der Endpunkt.
    var t18: [u8; 10] = "18 KEYS  \0"
    var k_d: [u8; 3] = "D \0"
    var k_b: [u8; 6] = " BER \0"
    var k_a: [u8; 6] = " ARM \0"
    var k_c: [u8; 5] = " CC \0"
    var k_r: [u8; 6] = " RK ␀\0"
    let kd: u64 = usb.kbd_dev(state)
    tn = puls_text(state, tp, 0, (&t18[0]) as u64)
    tn = puls_text(state, tp, tn, (&k_d[0]) as u64)
    tn = pulse_num(state, tp, tn, kd)
    var kfarb: u64 = wm.mess_rot(state)
    if kd != 0 {
        let kdev: u64 = kd - 1
        tn = puls_text(state, tp, tn, (&k_b[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.dev_reps(state, kdev))
        tn = puls_text(state, tp, tn, (&k_a[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.dev_arms(state, kdev))
        tn = puls_text(state, tp, tn, (&k_c[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.dev_cc(state, kdev))
        // RUNDE VIELKERN: `RK` statt `ROH`, und der letzte Bericht,
        // der NICHT leer war (siehe usb.D_ROHW). Vier Oktett statt
        // acht: Nummer 0 sind die Umschalttasten, 2 bis 4 die ersten
        // drei Tastencodes -- Nummer 1 ist immer 0 und die Codes 5/6
        // braucht niemand, um zu sehen, DASS ein Bericht ankommt. Acht
        // Oktett waeren 51 Zeichen auf einer 48 Zeichen breiten Tafel
        // gewesen, also unsichtbar; das ist derselbe Fehler, den
        // Zeile 12 hatte.
        //
        // `N` ist die Zahl der nicht-leeren Berichte. Steht dort etwas
        // groesser null und `TAS` bleibt bei 0, kommt der Bericht an
        // und der ZERLEGER ist schuld. Bleibt `N` bei 0 und `BER`
        // steigt, kommen nur Leermeldungen -- dann ist es der Endpunkt.
        let rw: u64 = usb.dev_rohw(state, kdev)
        tn = puls_text(state, tp, tn, (&k_r[0]) as u64)
        tn = puls_hexn(state, tp, tn, rw & 0xFF, 2)
        tn = puls_hexn(state, tp, tn, (rw >> 16) & 0xFF, 2)
        tn = puls_hexn(state, tp, tn, (rw >> 24) & 0xFF, 2)
        tn = puls_hexn(state, tp, tn, (rw >> 32) & 0xFF, 2)
        var k_n: [u8; 5] = " N ␀\0"
        tn = puls_text(state, tp, tn, (&k_n[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.dev_rohn(state, kdev))
        // ======================================= RUNDE ECHTHARDWARE-6
        // `W` -- die Rufe des Wachhundes. Steht `BER` still und `W`
        // laeuft hoch, hat der Ring wirklich geschwiegen und es wurde
        // nachgesehen. Damit ist auf EINEM Foto zu unterscheiden, ob
        // gerade niemand tippt oder ob die Zustellung haengt -- genau
        // die Unterscheidung, die auf Justins Foto gefehlt hat.
        var k_w: [u8; 4] = " W \0"
        tn = puls_text(state, tp, tn, (&k_w[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.wachen(state))
        // RUNDE ECHTHARDWARE-6: `NEU` -- wie oft ein stummer Endpunkt
        // frisch bestueckt wurde. Laeuft die Zahl hoch und `BER` bleibt
        // null, hat das Geraet wirklich nichts zu sagen; steigt `BER`
        // danach, hat die Wiederherstellung gegriffen.
        var k_nu: [u8; 6] = " NEU \0"
        tn = puls_text(state, tp, tn, (&k_nu[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.wiedern(state))
        if usb.dev_reps(state, kdev) != 0 {
            kfarb = wm.mess_gruen(state)
        }
    }
    board_remember(18, tp, tn, kfarb)
    board_line_say(state, tp, tn)

    // ---- Zeile 19: DIE UHR ----
    //
    // Justin sagt, die Uhrzeit stimmt nicht, und auf dem Foto stand
    // 18:47, als es wirklich 18:47 war. Aus einem Foto laesst sich
    // beides nicht unterscheiden -- also stehen hier DREI Zeiten
    // nebeneinander:
    //   RTC  -- was der CMOS-Baustein GERADE sagt (hh:mm:ss). Das ist
    //           die Quelle, aus der die Taskleiste ihre Uhr nimmt
    //           (`uio.sysinfo` liest 0x70/0x71 bei jedem Aufruf neu).
    //   KRN  -- die Zeit des KERNS, TIME_BOOT plus Zyklenzaehler. Sie
    //           laeuft unabhaengig von der RTC weiter; laufen die
    //           beiden auseinander, steht eine von beiden.
    //   TZ   -- der Versatz auf Ortszeit in Minuten (`tz=` auf der
    //           Kommandozeile, Vorgabe 0). Steht die RTC auf UTC und
    //           TZ auf 0, geht die Anzeige im Sommer zwei Stunden nach.
    //   D    -- der Tag aus der RTC, damit auch das Datum belegt ist.
    // RUNDE ECHTHARDWARE-5: DIE UEBERSCHRIFT WIRD KUERZER, DAMIT DIE
    // ZEILE IN DIE TAFEL PASST.
    //
    // Nach dem Nullabschluss (siehe Zeile 8) stand hier
    // `19 CLOCKRTC 11:58:25 ...` -- Wort an Wort, 49 Zeichen bei 48
    // Plaetzen. Sie war damit die LETZTE Zeile, die Zeile 23 rot
    // faerbte (`LG 1 Z19 49`).
    //
    // Die Vorrunde hat an dieser Zeile schon `KRN`->`K` und `TZ`->`Z`
    // gekuerzt; am Inhalt ist nichts mehr zu holen, ohne eine Auskunft
    // wegzunehmen. Also die UEBERSCHRIFT: `19 CLOCK` -> `19 UHR`.
    // Das spart zwei Zeichen, die Zeile misst 47, und mit dem
    // Trennzeichen dahinter liest sie sich wieder als zwei Woerter.
    var t19: [u8; 8] = "19 UHR \0"
    var u_r: [u8; 5] = "RTC \0"
    var u_dp: [u8; 2] = ":\0"
    // RUNDE ECHTHARDWARE-3: DIESE ZEILE WAR 51 ZEICHEN LANG UND DIE
    // TAFEL IST 48 BREIT. `LG 4 Z19 51` auf Zeile 23 hat genau das
    // gemeldet -- drei Zeichen fielen hinten ab, und die Zeile 23 war
    // deshalb dauerhaft ROT. Die Beschriftungen werden gekuerzt
    // (`KRN`->`K`, `TZ`->`Z`), der Inhalt bleibt vollstaendig.
    var u_kr: [u8; 4] = " K \0"
    var u_tz: [u8; 4] = " Z \0"
    var u_dd: [u8; 4] = " D \0"
    var u_pt: [u8; 2] = ".\0"
    tn = puls_text(state, tp, 0, (&t19[0]) as u64)
    tn = puls_text(state, tp, tn, (&u_r[0]) as u64)
    tn = pulse_two(state, tp, tn, time.rtc_field(time.R_HOUR))
    tn = puls_text(state, tp, tn, (&u_dp[0]) as u64)
    tn = pulse_two(state, tp, tn, time.rtc_field(time.R_MIN))
    tn = puls_text(state, tp, tn, (&u_dp[0]) as u64)
    tn = pulse_two(state, tp, tn, time.rtc_field(time.R_SEC))
    let ks: u64 = time.now_local(state) % 86400
    tn = puls_text(state, tp, tn, (&u_kr[0]) as u64)
    tn = pulse_two(state, tp, tn, ks / 3600)
    tn = puls_text(state, tp, tn, (&u_dp[0]) as u64)
    tn = pulse_two(state, tp, tn, (ks % 3600) / 60)
    tn = puls_text(state, tp, tn, (&u_dp[0]) as u64)
    tn = pulse_two(state, tp, tn, ks % 60)
    tn = puls_text(state, tp, tn, (&u_tz[0]) as u64)
    tn = pulse_num(state, tp, tn, time.tz_min(state))
    tn = puls_text(state, tp, tn, (&u_dd[0]) as u64)
    tn = pulse_two(state, tp, tn, time.rtc_field(time.R_DAY))
    tn = puls_text(state, tp, tn, (&u_pt[0]) as u64)
    tn = pulse_two(state, tp, tn, time.rtc_field(time.R_MONTH))
    // RUNDE ECHTHARDWARE-1: DIE UHR HAT JETZT EINE QUELLE, und diese
    // Zeile prueft genau das.
    //
    // `KRN` ist ORTSZEIT (`now_local`), die RTC steht -- Vorgabe --
    // ebenfalls auf Ortszeit. Beide muessen deshalb DIESELBE Minute
    // zeigen. Vorher wurde der Versatz zweimal gezaehlt und die Zeile
    // stand auf Justins Foto rot bei 14:38 gegen 12:38; jetzt ist ein
    // Unterschied wieder das, was er sein soll: ein Fehler.
    //
    // `U` sagt dazu, WIE die RTC gelesen wurde -- 0 Ortszeit (Vorgabe,
    // wie Windows), 1 UTC (`rtcutc`). Ohne diese Ziffer laesst sich aus
    // einem Foto nicht entscheiden, ob eine falsche Uhr am Versatz oder
    // an der Auslegung liegt.
    var u_u: [u8; 4] = " U \0"
    tn = puls_text(state, tp, tn, (&u_u[0]) as u64)
    tn = pulse_num(state, tp, tn, time.rtc_utc(state))
    var ufarb: u64 = wm.mess_rot(state)
    if (ks / 60) % 60 == time.rtc_field(time.R_MIN) {
        ufarb = wm.mess_gruen(state)
    }
    board_remember(19, tp, tn, ufarb)
    board_line_say(state, tp, tn)

    // ---- Zeile 20: DER BILDSPEICHER SAGT SELBST, WAS ER IST ----
    //
    // DIE ZEILE, DIE RUNDE 31 BEANTWORTET. Justin sieht auf echter
    // Hardware eckige Fenster, grobe Symbole und einen gepixelten
    // Zeiger; im Pruefstand ist die Ecke MESSBAR rund (0 Fuellpunkte
    // ausserhalb des Radius von 121 geprueften). Zwei Erklaerungen
    // blieben uebrig, und keine liess sich aus dem Quelltext
    // entscheiden: ein anderer Bildspeicher-Pfad oder ein anderes
    // Thema. Geraten wird hier nichts -- die Maschine sagt es selbst:
    //
    //   BR/HO  das LOGISCHE Bild, in das gemalt wird
    //   TF     die TAFEL, also was die Karte wirklich anzeigt.
    //          Weicht sie von BR/HO ab, wird HOCHGESTRECKT -- und
    //          genau das frisst runde Ecken, Symbolkanten und den
    //          Zeiger, alles aus EINER Ursache.
    //   ZL     die Zeilenbreite (stride). Ist sie groesser als BR*4,
    //          richtet die Karte aus, und jede Rechnung mit `BR*4`
    //          liegt zeilenweise daneben.
    //   T      Farbtiefe in Bit.
    //   SK     die Vervielfachung der Oberflaeche (uiscale).
    //   ST     1 = STREIFENBETRIEB. Der Puffer passt nicht in die acht
    //          2-MiB-Fensterplaetze und wird scheibenweise geschoben.
    //          Bei 3840x2160x4 (33 177 600 Oktette, sechzehn Kacheln)
    //          ist das unvermeidlich -- und die Abnahme faehrt nur
    //          1280x800 und 2560x1440, loest ihn also NIE aus.
    //
    // Rot, sobald Tafel und Bild auseinanderfallen: dann wird
    // gestreckt, und kein Zeichenfehler darunter ist echt.
    var t24: [u8; 7] = "24 FB \0"
    var f_x: [u8; 2] = "x\0"
    var f_tf: [u8; 3] = " T\0"
    var f_zl: [u8; 3] = " Z\0"
    var f_t: [u8; 3] = " B\0"
    var f_sk: [u8; 3] = " S\0"
    var f_st: [u8; 3] = " R\0"
    let lw: u64 = fb.width(state)
    let lh: u64 = fb.height(state)
    let pw: u64 = fb.panel_w(state)
    let ph: u64 = fb.panel_h(state)
    tn = puls_text(state, tp, 0, (&t24[0]) as u64)
    tn = pulse_num(state, tp, tn, lw)
    tn = puls_text(state, tp, tn, (&f_x[0]) as u64)
    tn = pulse_num(state, tp, tn, lh)
    tn = puls_text(state, tp, tn, (&f_tf[0]) as u64)
    tn = pulse_num(state, tp, tn, pw)
    tn = puls_text(state, tp, tn, (&f_x[0]) as u64)
    tn = pulse_num(state, tp, tn, ph)
    tn = puls_text(state, tp, tn, (&f_zl[0]) as u64)
    tn = pulse_num(state, tp, tn, fb.pitch(state))
    tn = puls_text(state, tp, tn, (&f_t[0]) as u64)
    tn = pulse_num(state, tp, tn, fb.bpp(state))
    tn = puls_text(state, tp, tn, (&f_sk[0]) as u64)
    tn = pulse_num(state, tp, tn, fb.uiscale(state))
    tn = puls_text(state, tp, tn, (&f_st[0]) as u64)
    tn = pulse_num(state, tp, tn, bnum(fb.stripe(state)))
    var ffarb: u64 = wm.mess_gruen(state)
    if lw != pw || lh != ph {
        ffarb = wm.mess_rot(state)
    }
    board_remember(24, tp, tn, ffarb)
    board_line_say(state, tp, tn)

    // ---- Zeile 20: DER ENDPUNKT, WIE DER REGLER IHN SIEHT ----
    //
    // Die Zeile darueber zaehlt UNSERE Sicht (Bloecke hin, Meldungen
    // zurueck). Diese hier fragt den REGLER: `EP` ist der
    // Endpunktzustand aus dem Geraetezusammenhang --
    //   0 gar nicht da  1 laeuft  2 ANGEHALTEN  3 gestoppt  4 FEHLER.
    // Steht dort 2 oder 4, nimmt der Endpunkt keinen Block mehr an,
    // egal wie oft geklingelt wird: `ARM` laeuft hoch, `BER` steht.
    // `F` sind die Transfers mit schlechtem Code, `H` die
    // Wiederbelebungen. Vor dieser Runde gab es die Wiederbelebung
    // ueberhaupt nicht -- ein einziger Uebertragungsfehler hat die
    // Tastatur fuer immer stillgelegt, waehrend die Maus weiterlief.
    var t20: [u8; 10] = "20 ENDP  \0"
    var e_k: [u8; 5] = "KBD \0"
    var e_m: [u8; 6] = " MAU \0"
    var e_e: [u8; 4] = "EP\0\0"
    var e_f: [u8; 3] = " F\0"
    var e_h: [u8; 3] = " H\0"
    var e_hg: [u8; 6] = " HEI \0"
    var e_op: [u8; 5] = " OP \0"
    let ekd: u64 = usb.kbd_dev(state)
    let emd: u64 = usb.mouse_dev(state)
    tn = puls_text(state, tp, 0, (&t20[0]) as u64)
    tn = puls_text(state, tp, tn, (&e_k[0]) as u64)
    tn = puls_text(state, tp, tn, (&e_e[0]) as u64)
    var ekst: u64 = 0
    if ekd != 0 {
        ekst = usb.dev_epstate(state, ekd - 1)
    }
    tn = pulse_num(state, tp, tn, ekst)
    tn = puls_text(state, tp, tn, (&e_f[0]) as u64)
    if ekd != 0 {
        tn = pulse_num(state, tp, tn, usb.dev_errs(state, ekd - 1))
    } else {
        tn = pulse_num(state, tp, tn, 0)
    }
    tn = puls_text(state, tp, tn, (&e_h[0]) as u64)
    if ekd != 0 {
        tn = pulse_num(state, tp, tn, usb.dev_heal(state, ekd - 1))
    } else {
        tn = pulse_num(state, tp, tn, 0)
    }
    tn = puls_text(state, tp, tn, (&e_m[0]) as u64)
    tn = puls_text(state, tp, tn, (&e_e[0]) as u64)
    var emst: u64 = 0
    if emd != 0 {
        emst = usb.dev_epstate(state, emd - 1)
    }
    tn = pulse_num(state, tp, tn, emst)
    tn = puls_text(state, tp, tn, (&e_f[0]) as u64)
    if emd != 0 {
        tn = pulse_num(state, tp, tn, usb.dev_errs(state, emd - 1))
    } else {
        tn = pulse_num(state, tp, tn, 0)
    }
    tn = puls_text(state, tp, tn, (&e_hg[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.heilungen(state))
    tn = puls_text(state, tp, tn, (&e_op[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.without_space(state))
    // Gruen nur, wenn der Tastaturendpunkt WIRKLICH laeuft.
    var efarb: u64 = wm.mess_rot(state)
    if ekst == 1 {
        efarb = wm.mess_gruen(state)
    }
    board_remember(20, tp, tn, efarb)
    board_line_say(state, tp, tn)

    // ---- Zeile 21: DIE FUNDLISTE, STUFE FUER STUFE ----
    //
    // "FUND 5 DEV 2" ist die Zahl, die Justin zu Recht fuer einen
    // Widerspruch haelt: fuenf Geraete gefunden, zwei uebrig, und
    // `FAIL 0`. Der Grund ist, dass `FAIL` nur die Fehlschlaege VOR dem
    // Geraeteplatz zaehlt (Ruecksetzung, Steckplatz, Platz). Wer an
    // `Address Device`, am Deskriptor oder an der Konfiguration
    // scheitert, verschwindet lautlos.
    //
    // Ab hier steht je Fund, WIE WEIT er gekommen ist:
    //   A = adressiert   D = beschrieben   C = konfiguriert
    //   B = ein Treiber hat es genommen
    // "3:AD--" heisst: Geraet an Anschluss 3, Adresse und Deskriptor
    // gingen, die Konfiguration nicht. Das ist die Auskunft, die drei
    // Runden lang gefehlt hat.
    var t21: [u8; 10] = "21 FOUND \0"
    var f_dp: [u8; 2] = ":\0"
    var f_sp: [u8; 2] = " \0"
    var f_a: [u8; 2] = "A\0"
    var f_d: [u8; 2] = "D\0"
    var f_c: [u8; 2] = "C\0"
    var f_b: [u8; 2] = "B\0"
    var f_n: [u8; 2] = "-\0"
    tn = puls_text(state, tp, 0, (&t21[0]) as u64)
    var fi: u64 = 0
    var fvoll: u64 = 0
    // ==================================== RUNDE ECHTHARDWARE-1
    // FUENF FUNDE UND NICHT SECHS -- die Zeile war um genau drei
    // Zeichen zu lang, und das hat die Tafel rot gemacht.
    //
    // Gerechnet: Kopf "21 FOUND " sind 9 Zeichen, je Fund kommen
    // "<Anschluss>:ADCB " -- eine Ziffer, ein Doppelpunkt, vier Marken,
    // ein Leerzeichen, also 7. Sechs Funde sind 9 + 42 = 51, die Tafel
    // ist 48 breit (TAFEL_SP). Auf Justins Foto stand deshalb
    // "23 SICHER ... LG 2 Z21 51": zwei Zeilen abgeschnitten, die
    // laengste war Zeile 21 mit 51 Zeichen -- und Zeile 23 wird rot,
    // sobald `zu_lang` nicht null ist.
    //
    // Das war also KEIN Schwellwert und kein Sicherheitsproblem: es
    // war eine Zeile, die nicht auf den Schirm passt, und die Tafel
    // hat genau das gemeldet, wofuer sie gebaut wurde. Fuenf Funde
    // sind 9 + 35 = 44 und passen.
    while fi < usb.fund_count(state) && fi < 5 {
        let fl: u64 = usb.fund_flags(state, fi)
        tn = pulse_num(state, tp, tn, usb.fund_port(state, fi))
        tn = puls_text(state, tp, tn, (&f_dp[0]) as u64)
        if (fl & 1) != 0 {
            tn = puls_text(state, tp, tn, (&f_a[0]) as u64)
        } else {
            tn = puls_text(state, tp, tn, (&f_n[0]) as u64)
        }
        if (fl & 2) != 0 {
            tn = puls_text(state, tp, tn, (&f_d[0]) as u64)
        } else {
            tn = puls_text(state, tp, tn, (&f_n[0]) as u64)
        }
        if (fl & 4) != 0 {
            tn = puls_text(state, tp, tn, (&f_c[0]) as u64)
        } else {
            tn = puls_text(state, tp, tn, (&f_n[0]) as u64)
        }
        if (fl & 8) != 0 {
            tn = puls_text(state, tp, tn, (&f_b[0]) as u64)
            fvoll = fvoll + 1
        } else {
            tn = puls_text(state, tp, tn, (&f_n[0]) as u64)
        }
        tn = puls_text(state, tp, tn, (&f_sp[0]) as u64)
        fi = fi + 1
    }
    // WAS NICHT MEHR HINPASST, WIRD GEZAEHLT UND NICHT VERSCHWIEGEN.
    if usb.fund_count(state) > 5 {
        var f_pl: [u8; 2] = "+\0"
        tn = puls_text(state, tp, tn, (&f_pl[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.fund_count(state) - 5)
    }
    board_remember(21, tp, tn, wm.mess_ampel(state, fvoll))
    board_line_say(state, tp, tn)

    // ---- Zeile 22: DIE NETZKARTE ----
    //
    // ================================================== RUNDE LEISTE
    // DIE ZEILE, DIE JUSTIN FOTOGRAFIEREN SOLL, DAMIT `jarvisd` LAEUFT.
    //
    // Sein Brett hat keine serielle Leitung (LSR FF, seit Runde KABEL
    // gemessen). Alles, was `netdev.fi` beim Erkunden auf die Leitung
    // schreibt -- also auch die eine Zahl, die entscheidet, ob dieser
    // Kern seinen Netzchip fahren kann -- ist auf seinem Rechner
    // unsichtbar. Deshalb steht sie ab hier auf der Tafel:
    //
    //   K    welcher Treiber gewaehlt wurde
    //        0 keiner  1 virtio  2 e1000  3 r8169  4 i219
    //   BDF  wo die Karte auf dem Bus sitzt (Bus/Geraet/Funktion)
    //   L    Verbindung: 1 = Kabel steckt und der Partner antwortet
    //   ABL  wie viele Karten der Klasse 02:00 ABGELEHNT wurden, und
    //        dahinter Hersteller und Geraet der ERSTEN davon. GENAU
    //        DIESE VIER HEXZIFFERNPAARE brauche ich von ihm, wenn K 0
    //        ist -- damit steht fest, ob sein Chip in der Tabelle
    //        fehlt oder ob der Treiber ihn nicht hochbekommt.
    //   IP   die Adresse, die der Stapel gerade fuehrt. Steht dort
    //        169.254.x.x, ist es die feste aus der Befehlszeile und
    //        DHCP hat nichts gebracht; steht dort etwas aus seinem
    //        Heimnetz, ist die Leitung fertig und `jarvisd` kann
    //        hinaus.
    // RUNDE ECHTHARDWARE-1: EIN LEERZEICHEN WENIGER IM KOPF.
    // Mit dem DHCP-Buchstaben am Ende waere die Zeile 49 Zeichen lang
    // gewesen -- eines ueber der Tafelbreite, und damit rot. Gemessen,
    // nicht geschaetzt: "22 NETZ K3 BDF 0900 L 1 ABL 0 IP 169.254.10.1 DA"
    // sind 48.
    var t22: [u8; 9] = "22 NET  \0"
    var n_k: [u8; 3] = "K\0\0"
    var n_b: [u8; 6] = " BDF \0"
    var n_l: [u8; 4] = " L \0"
    var n_a: [u8; 6] = " ABL \0"
    var n_d: [u8; 2] = ":\0"
    var n_i: [u8; 5] = " IP \0"
    var n_p: [u8; 2] = ".\0"
    let nk0: u64 = netdev.kind_on(state, 0)
    tn = puls_text(state, tp, 0, (&t22[0]) as u64)
    tn = puls_text(state, tp, tn, (&n_k[0]) as u64)
    tn = pulse_num(state, tp, tn, nk0)
    tn = puls_text(state, tp, tn, (&n_b[0]) as u64)
    tn = puls_hexn(state, tp, tn, netdev.bdf_on(state, 0), 4)
    tn = puls_text(state, tp, tn, (&n_l[0]) as u64)
    var lnk: u64 = 0
    if netdev.link_up_on(state, 0) {
        lnk = 1
    }
    tn = pulse_num(state, tp, tn, lnk)
    let abl: u64 = netdev.unsupported_count(state)
    tn = puls_text(state, tp, tn, (&n_a[0]) as u64)
    tn = pulse_num(state, tp, tn, abl)
    if abl != 0 {
        tn = puls_text(state, tp, tn, (&n_d[0]) as u64)
        tn = puls_hexn(state, tp, tn, netdev.unsupported_vendor(state, 0), 4)
        tn = puls_text(state, tp, tn, (&n_d[0]) as u64)
        tn = puls_hexn(state, tp, tn, netdev.unsupported_device(state, 0), 4)
    }
    let adr: u64 = inet.ip(state)
    tn = puls_text(state, tp, tn, (&n_i[0]) as u64)
    tn = pulse_num(state, tp, tn, (adr >> 24) & 255)
    tn = puls_text(state, tp, tn, (&n_p[0]) as u64)
    tn = pulse_num(state, tp, tn, (adr >> 16) & 255)
    tn = puls_text(state, tp, tn, (&n_p[0]) as u64)
    tn = pulse_num(state, tp, tn, (adr >> 8) & 255)
    tn = puls_text(state, tp, tn, (&n_p[0]) as u64)
    tn = pulse_num(state, tp, tn, adr & 255)
    // RUNDE ECHTHARDWARE-1: WIE WEIT DER DHCP-KLIENT GEKOMMEN IST.
    //
    //   D  0 nicht gelaufen  1 DISCOVER  2 OFFER  3 REQUEST
    //      4 ACK (Adresse steht)  5 aufgegeben  6 NAK
    //   S  Pakete hinaus   E  Antworten herein   V  Versuch
    //
    // Aus diesen vier Zahlen ist die Ursache aus EINEM Foto ablesbar:
    // `D 1 S 0` heisst, der Stapel liess nichts hinaus (der Rundruf
    // haengt an ARP, siehe Kopf von kernel/user/dhcp.fi).
    // `D 1 S 4 E 0` heisst, es ging hinaus und niemand antwortete --
    // dann liegt es am Netz und nicht an uns.
    // ================================== RUNDE ECHTHARDWARE-1
    // WIE WEIT DER DHCP-KLIENT KAM -- VIER ZEICHEN, NICHT SECHZEHN.
    //
    // Justins Foto zeigt "K3 BDF 0900 L 1 ABL 0 IP 169.254.10.1":
    // Treiber da, Kabel da, und trotzdem die feste Adresse von der
    // Kommandozeile. Woran es lag, stand nirgends -- der Klient meldet
    // es auf die serielle Leitung, und sein Brett hat keine.
    //
    // Es steht jetzt hier, aber KOMPAKT: die Zeile hat 46 von 48
    // Zeichen gebraucht, und Zeile 21 hat gerade vorgefuehrt, was
    // passiert, wenn man das ignoriert (LG 2, Z21 51, Tafel rot).
    // Also EIN Buchstabe fuer den Zustand statt vier Zahlen:
    //
    //   .  gar nicht gelaufen   d  DISCOVER hinaus
    //   o  OFFER da             r  REQUEST hinaus
    //   A  ACK -- Adresse steht t  aufgegeben (Zeitablauf)
    //   n  NAK vom Server       x  DISCOVER ging NICHT hinaus
    //
    // `x` ist der Fall, auf den es ankommt: Zustand 1 mit null
    // gesendeten Paketen heisst, der Stapel liess nichts hinaus (der
    // Rundruf haengt an ARP, siehe Kopf von kernel/user/dhcp.fi) --
    // das ist ein anderer Fehler als "niemand hat geantwortet".
    var n_dh: [u8; 3] = " D\0"
    let dst: u64 = inet.dhcp_get(0)
    let dtx: u64 = inet.dhcp_get(1)
    var dz: [u8; 2] = ".\0"
    if dst == 1 {
        dz[0] = 100 as u8 // d
        if dtx == 0 {
            dz[0] = 120 as u8 // x -- nichts ging hinaus
        }
    }
    if dst == 2 {
        dz[0] = 111 as u8 // o
    }
    if dst == 3 {
        dz[0] = 114 as u8 // r
    }
    if dst == 4 {
        dz[0] = 65 as u8 // A
    }
    if dst == 5 {
        dz[0] = 116 as u8 // t
    }
    if dst == 6 {
        dz[0] = 110 as u8 // n
    }
    tn = puls_text(state, tp, tn, (&n_dh[0]) as u64)
    tn = puls_text(state, tp, tn, (&dz[0]) as u64)
    // GRUEN erst, wenn wirklich eine Adresse steht UND ein Treiber da
    // ist. Eine gelbe Zeile heisst "Karte erkannt, aber keine
    // Verbindung", eine rote "kein Treiber".
    var nfarb: u64 = wm.mess_rot(state)
    if nk0 != 0 {
        nfarb = wm.mess_ampel(state, lnk)
    }
    board_remember(22, tp, tn, nfarb)
    board_line_say(state, tp, tn)



    // ---- Zeile 23: DIE ZAHLEN, DIE NULL SEIN MUESSEN ----
    //
    // Eine eigene Zeile, weil sie auf Zeile 12 nicht mehr auf den
    // Schirm passten (siehe `tafel_merken`). Was hier steht, ist die
    // Antwort auf "kann ich den anderen Zahlen dieser Tafel glauben":
    //
    //   WA   Ueberlaeufe einer Kernstapel-Waechterseite. MUSS 0 sein.
    //   KS   hoechster gemessener Kernstapelstand, von 65536.
    //   R3W  Kerne, deren GS-Basis NICHT auf ihren eigenen Satz zeigt.
    //        MUSS 0 sein -- sonst faende ein Systemaufruf dort seinen
    //        Kernstapel nicht, und genau daran ist Justins Brett am
    //        05.09. gestorben.
    //   R3K  auf WIE VIELEN Kernen Ring 3 wirklich gelaufen ist. Das
    //        ist die Zahl, die diese Runde beweist: vor ihr war sie 1.
    //   LANG Tafelzeilen, die abgeschnitten wurden. MUSS 0 sein.
    var t23: [u8; 12] = "23 SAFETY  \0"
    var q_wa: [u8; 5] = "WA ␀\0"
    var q_ks: [u8; 6] = " KS ␀\0"
    var q_rw: [u8; 7] = " R3W ␀\0"
    var q_rk: [u8; 7] = " R3K ␀\0"
    var q_lg: [u8; 6] = " LG ␀\0"
    tn = puls_text(state, tp, 0, (&t23[0]) as u64)
    tn = puls_text(state, tp, tn, (&q_wa[0]) as u64)
    tn = pulse_num(state, tp, tn, sched.guard_faults())
    tn = puls_text(state, tp, tn, (&q_ks[0]) as u64)
    tn = pulse_num(state, tp, tn, kstack_up(state))
    tn = puls_text(state, tp, tn, (&q_rw[0]) as u64)
    tn = pulse_num(state, tp, tn, sched.gs_error(state))
    tn = puls_text(state, tp, tn, (&q_rk[0]) as u64)
    tn = pulse_num(state, tp, tn, sched.ring3_kerne(state))
    tn = puls_text(state, tp, tn, (&q_lg[0]) as u64)
    var lz: u64 = 0
    var lb: u64 = 0
    while lb < BOARD_LINES {
        if ((zu_lang >> lb) & 1) != 0 {
            lz = lz + 1
        }
        lb = lb + 1
    }
    tn = pulse_num(state, tp, tn, lz)
    if lz != 0 {
        var q_lz: [u8; 4] = " Z␀\0"
        tn = puls_text(state, tp, tn, (&q_lz[0]) as u64)
        tn = pulse_num(state, tp, tn, lang_zeile)
        var q_ls: [u8; 3] = " ␀\0"
        tn = puls_text(state, tp, tn, (&q_ls[0]) as u64)
        tn = pulse_num(state, tp, tn, lang_max)
    }
    var f23: u64 = wm.mess_gruen(state)
    if sched.guard_faults() != 0 || sched.gs_error(state) != 0
       || zu_lang != 0 {
        f23 = wm.mess_rot(state)
    }
    board_remember(23, tp, tn, f23)
    board_line_say(state, tp, tn)
    // RUNDE VIELKERN 3: und dazu, wenn die Tafel ohnehin auf die
    // serielle Leitung geht (alle fuenf Sekunden), die AUFLOESUNG von
    // `R3K` -- welcher Prozess auf welchem Kern. Eine Zahl ohne die
    // Aufloesung dahinter laesst sich nicht nachpruefen.
    if tafel_seriell != 0 {
        sched.ring3_bericht(state)
        // RUNDE ECHTHARDWARE-5: und der INHALT des Terminalfensters.
        // Justins Befund B laesst sich nur so belegen, ohne aus
        // Bildpunkten Buchstaben zu raten -- das Fenster sagt selbst,
        // was in seinen Zellen steht.
        wm.term_dump(state, wm.term_win(state))
    }

    // ================================================ RUNDE BLECHZWEI
    // ============ NUR DIE ZEILEN, DIE SICH WIRKLICH GEAENDERT HABEN.
    //
    // DIE RECHNUNG, DIE DIESEN UMBAU ERZWUNGEN HAT. Bis hierher malte
    // jeder Anstrich den ganzen Balken neu und uebertrug ihn in VOLLEN
    // Bildzeilen: auf Justins Schirm 582 Zeilen zu 3440 Bildpunkten,
    // 8,0 MB, zehnmal je Sekunde.
    //
    // Auf ECHTEM Blech mit UNCACHED-Abbildung ist jeder Vierbyte-Wert
    // eine eigene Bustransaktion. Das ist nicht die Zahl, die diese
    // Runde in QEMU gemessen hat (dort gibt es keine
    // Zwischenspeicher-Semantik) -- es ist um Groessenordnungen
    // langsamer. Und genau das steht in Justins Foto: der Markenzaehler
    // stieg in ungefaehr einer Minute von 130 auf 320, also rund drei
    // Marken je Sekunde statt hundert. SIEBENUNDNEUNZIG PROZENT DER
    // ZEITGEBERSCHLAEGE GEHEN VERLOREN, weil der Behandler noch mit dem
    // vorigen Anstrich beschaeftigt ist -- und die
    // Schreibtischschleife, die dazwischen laufen muesste, bekommt
    // nichts. `LOOP 0`.
    //
    // Jetzt: der Balken einmal beim ersten Anstrich, danach je Zeile
    // ein Vergleich mit dem, was zuletzt dort stand. Die Taktzeile
    // aendert sich jedes Mal, die uebrigen selten -- ein
    // Regelanstrich uebertraegt damit EINE Zeile zu 780 x 48
    // Bildpunkten statt 582 volle.
    // ============ GEMESSEN, UND DESHALB STEHT DAS HIER.
    //
    // Im ersten Lauf mit dem Zeilenvergleich standen auf dem
    // Bildschirmfoto nur NOCH DIE HALBEN Zeilen: y=5 und y=400 schwarz
    // mit gruener Schrift, y=100 und y=200 der Schreibtischgrund. Der
    // Grund ist offensichtlich, sobald man ihn sieht: der Fensterserver
    // malt bei jedem `compose` seinen Grund ueber die ganze Flaeche --
    // auch ueber die Tafel. Eine Zeile, die sich NICHT geaendert hat,
    // wird dann nicht nachgezogen und bleibt weg.
    //
    // Also: hat der Fensterserver seit dem letzten Anstrich
    // zusammengesetzt, wird ALLES neu gemalt. Hat er nicht -- und genau
    // das ist Justins Fall, `LOOP 0` --, bleibt es beim billigen Weg
    // mit einer Zeile. Der teure Fall ist damit an den gebunden, der
    // ihn verursacht.
    // ============================================ RUNDE BLECHDREI
    // DER SCHLUESSEL ZUM BAND. Ab hier -- und NUR hier -- darf in die
    // obersten Bildzeilen geschrieben werden; `fb.band_lo` weist jeden
    // anderen ab. Er wird am Ende dieser Funktion wieder umgedreht,
    // auch auf jedem Rueckweg.
    fb.band_open(state, true)
    // Die Gegenprobe zu `wm.composites` faellt damit weg: der
    // Fensterserver KANN die Tafel nicht mehr uebermalen, also muss
    // auch nichts mehr nachgezogen werden. Was bleibt, ist der billige
    // Weg -- nur Zeilen, die sich wirklich geaendert haben.
    tafel_comp = wm.composites(state)
    if tafel_grund == 0 {
        tafel_grund = 1
        wm.measure_reason(state, BOARD_LINES, TAFEL_SPALTEN)
        fb.flush_rect(state, 0, 0, wm.mess_vollbreite(state),
            wm.messhoehe(state, BOARD_LINES))
    }
    let breite: u64 = wm.measure_width(state, TAFEL_SPALTEN)
    let zh: u64 = wm.messzeile_h(state)
    var z: u64 = 0
    while z < BOARD_LINES {
        let n: u64 = tafel_len[z as usize]
        if n != 0 && board_changed(z, n) {
            wm.messzeile(state, z, (&tafel_txt[0]) as u64 + z * TAFEL_SP,
                n, tafel_fg[z as usize])
            fb.flush_rect(state, wm.messzeile_x(state, z),
                wm.messzeile_y(state, z), breite, zh)
            board_remember_old(z, n)
        }
        z = z + 1
    }
    fb.band_open(state, false)
    // ============ RUNDE BLECHZWEI: NUR DAS RECHTECK, NICHT DAS BILD.
    //
    // Hier stand `fb.flush(state)`. Das uebertraegt den ganzen
    // Schmutzbereich in VOLLEN Bildzeilen -- auf Justins Schirm 582
    // Zeilen zu 3440 Bildpunkten, also 8,0 MB, zehnmal je Sekunde. Bei
    // der gemessenen UC-Rate sind das 80 ms JE ANSTRICH im
    // Zeitgeberbehandler, mit abgeschalteten Unterbrechungen: der
    // Rechner verbraucht vier Fuenftel seiner Zeit damit, sein eigenes
    // Messgeraet zu malen. `LOOP 0` in derselben Messung ist damit kein
    // Zufall mehr.
    //
    // Und `fb.flush` setzte ausserdem den Schmutzbereich des
    // FENSTERSERVERS auf null -- aus dem Zeitgeber gerufen zog es dem
    // gerade zusammensetzenden Server seine Buchfuehrung weg.
    tafel_drin = 0
}

// Was zuletzt WIRKLICH auf dem Schirm stand -- Text, Laenge und Farbe.
// Ohne die Farbe waere eine Zeile, die nur von rot auf gruen wechselt,
// unsichtbar geblieben, und die Ampel ist die halbe Aussage der Tafel.
// RUNDE LEISTE: dieselbe Groesse wie oben, aus demselben Grund.
static mut tafel_alt: [u8; 1152] = [0 as u8; 1152]
static mut tafel_altlen: [u64; 25] = [0 as u64; 25]
static mut tafel_altfg: [u64; 25] = [0 as u64; 25]
static mut tafel_grund: u64 = 0
// Der Stand des Zusammensetzers beim letzten Anstrich.
static mut tafel_comp: u64 = 0

fn board_changed(z: u64, n: u64) -> bool {
    if tafel_altlen[z as usize] != n {
        return true
    }
    if tafel_altfg[z as usize] != tafel_fg[z as usize] {
        return true
    }
    let a: u64 = (&tafel_txt[0]) as u64 + z * TAFEL_SP
    let b: u64 = (&tafel_alt[0]) as u64 + z * TAFEL_SP
    var i: u64 = 0
    while i < n {
        if kstate.get8(a + i) != kstate.get8(b + i) {
            return true
        }
        i = i + 1
    }
    return false
}

fn board_remember_old(z: u64, n: u64) {
    let a: u64 = (&tafel_txt[0]) as u64 + z * TAFEL_SP
    let b: u64 = (&tafel_alt[0]) as u64 + z * TAFEL_SP
    var i: u64 = 0
    while i < n {
        kstate.set8(b + i, kstate.get8(a + i) as u8)
        i = i + 1
    }
    tafel_altlen[z as usize] = n
    tafel_altfg[z as usize] = tafel_fg[z as usize]
}

// AUS DEM ZEITGEBERBEHANDLER. Laeuft mit abgeschalteten
// Unterbrechungen, nimmt kein Schloss und ruft nichts, was schlafen
// koennte. Zehnmal je Sekunde -- oefter waere auf einem ungepufferten
// Firmware-Rahmenpuffer bei 3440x1440 sinnlos teuer.
// AUS DEM ZEITGEBERBEHANDLER.
//
// ============ HIER STAND DER FEHLER DIESER RUNDE, UND ER WAR MEINER.
//
// Vorher standen hier ZWEI Sperren:
//
//     if !kstate.mode_on(state, kstate.M_WMDAUER) { return }
//     if tafel_hat == 0 { return }
//
// Die zweite hat die ganze Runde gekostet. `tafel_hat` wird NUR in
// `tafel_merken` gesetzt, und `tafel_merken` ruft NUR `kopf_malen`, und
// `kopf_malen` ruft NUR `wait_wm` -- die Schreibtischschleife. Damit
// hing der angeblich unabhaengige Zeitgeberweg WEITERHIN daran, dass
// die Schleife mindestens eine Runde gelaufen war.
//
// In QEMU lief sie, also wurde `tafel_hat` 1, also malte der Zeitgeber
// (453 Anstriche gemessen) -- und die Messung sah richtig aus. Auf
// Justins Brett laeuft die Schleife nie eine volle Runde, `tafel_hat`
// bleibt 0, und die Tafel kommt nie. Genau das zeigt sein Foto.
//
// Ein Messgeraet darf keinen Messwert brauchen, um anzugehen. Ohne
// Inhalt zeigt es eben Nullen -- und DAS ist die Aussage, auf die es
// ankommt.
//
// Die erste Sperre ist ebenfalls weg: `wmdauer` war eine Annahme ueber
// Umgebungen (`tools/hidpunkte/run.sh` setzt es auch). Jetzt entscheidet
// ein eigenes Wort auf der Kommandozeile, `tafel`.
// ================================================ RUNDE BLECHEINGABE
// ============ DER HERZSCHLAG, AUS DEM ZEITGEBER, VOR ALLEM ANDEREN
//
// Justins Bild steht seit dem ersten Vollbild still: die Uhr der
// Taskleiste zeigte um 14:51 und um 14:54 dieselbe Minute. Zwei
// Erklaerungen bleiben, und sie sind nur mit etwas zu trennen, das sich
// SICHTBAR bewegt, ohne Fensterserver, ohne Schreibtischschleife, ohne
// serielle Leitung (er hat keinen UART).
//
// Alle 25 Marken -- viermal je Sekunde -- werden zwei Felder am rechten
// Bildrand umgelegt: links ueber den NORMALEN Weg (Zweitpuffer,
// Schmutz, flush), rechts DIREKT in das Fenster der Karte. Und einmal
// je Sekunde die Rollen-Lampe der Tastatur.
//
// Die Tafel steht danach: sie ist teuer (ein schwarzer Balken ueber
// 3440 Bildpunkte), der Herzschlag ist billig und muss auch dann noch
// schlagen, wenn die Tafel es nicht schafft.
// ================================================== RUNDE BLECHZWEI
// ============ DIE STUFENMARKE: WO STEHT DER KERN GERADE?
//
// Justins Foto vom Menueeintrag `fbuc` zeigt die Messtafel, sie
// aktualisiert sich (IRQ 130 -> 320 -> 610, MAL 13 -> 32 -> 61) -- und
// darin steht `LOOP 0`.
//
// `tafel_loop` wird an GENAU EINER Stelle erhoeht, in `kopf_malen`, und
// `kopf_malen` wird an GENAU EINER Stelle gerufen, im Rumpf von
// `wait_wm`. Die erste Erhoehung passiert schon beim ERSTEN Aufruf (der
// Marken-Test faellt beim ersten Mal durch). `LOOP 0` heisst deshalb
// hart: DIESE ZEILE WURDE NIE ERREICHT -- in ueber sechs Sekunden nicht.
//
// Raten hilft hier nicht mehr. Also eine Zahl, die bei jedem Schritt
// der Startfolge und bei jedem Schritt im Schleifenrumpf neu gesetzt
// wird, und die der ZEITGEBERPFAD auf die Tafel malt. Ein einziges Foto
// sagt dann, an welcher Zeile es steht.
//
//   10..19  die Startfolge bis zum ersten Ring-3-Programm
//   20..29  die Programme und der Weg in `wait_wm`
//   30..39  DER SCHLEIFENRUMPF von `wait_wm`, Schritt fuer Schritt
//   40      `wait_wm` ist zurueckgekehrt
//
// Bleibt die Zahl auf 35 stehen, haengt es in `wm.compose`. Bleibt sie
// auf 33, haengt es im Aufzaehlen. Kommt sie nie ueber 24, wurde
// `wait_wm` nie betreten. Das ist der Unterschied zwischen einer
// Vermutung und einer Adresse.
static mut stufe: u64 = 0
static mut stufe_hoch: u64 = 0
static mut wmrunden: u64 = 0

fn st(n: u64) {
    stufe = n
    if n > stufe_hoch {
        stufe_hoch = n
    }
}

fn level_num() -> u64 {
    return stufe
}

fn stufe_max() -> u64 {
    return stufe_hoch
}

fn wm_runden() -> u64 {
    return wmrunden
}

static mut herz_n: u64 = 0
static mut herz_marke: u64 = 0
static mut herz_an: u64 = 0
static mut herz_sek: u64 = 0
static mut herz_led: u64 = 0
// Wie oft HELL gemalt wurde -- damit sich das Blinken MESSEN laesst und
// nicht nur fotografieren.
static mut herz_hell: u64 = 0

fn beat_num() -> u64 {
    return herz_n
}

fn beat_brightnum() -> u64 {
    return herz_hell
}

fn beat_tick(state: u64) {
    if !kstate.mode_on(state, kstate.M_BEAT) {
        return
    }
    herz_n = herz_n + 1
    let jetzt: u64 = kstate.get(state, kstate.TICKS)
    if jetzt < herz_marke + 25 {
        return
    }
    herz_marke = jetzt
    herz_an = 1 - herz_an
    herz_hell = herz_hell + herz_an
    // ==================================== RUNDE BLECHFUENF
    // DIE ZWEI BLINKFELDER GEHOEREN ZUM DIAGNOSESCHALTER.
    //
    // Justin hat sie als "zwei farbige Quadrate am rechten Rand"
    // gemeldet und fuer einen Zeichenfehler gehalten. Sie sind keiner:
    // links gruen ist der normale Weg (Zweitpuffer und `flush`),
    // rechts gelb geht unmittelbar in das Fenster der Karte -- der
    // Unterschied der beiden war der Beweis, dass der Rahmenpuffer
    // ueberhaupt erreichbar ist. Diese Frage ist beantwortet (die Tafel
    // steht, und sie steht ueber den normalen Weg). Auf einem
    // Schreibtisch, den ein Mensch benutzt, haben zwei blinkende
    // Kaestchen nichts verloren -- sie kommen mit demselben Schalter
    // zurueck wie die Lampe.
    if kstate.mode_on(state, kstate.M_PULSLED) {
        fb.beat(state, 0, herz_an)
        fb.beat(state, 1, herz_an)
    }
    // ==================================== RUNDE BLECHFUENF
    // DIE LAMPEN GEHOEREN AB HIER DEM MENSCHEN.
    //
    // Der LED-Herzschlag war ein Messgeraet fuer eine Frage, die
    // beantwortet ist: laeuft der Zeitgeber? Justins Tafel sagt HZ 99,
    // also ja. Was blieb, war Schaden -- an seiner Tastatur blinkten
    // Nummernfeststell und Rollen dauernd, und Nummernfeststell liess
    // sich NICHT mehr umschalten, weil der Kern die Maske zweimal je
    // Sekunde selbst ueberschrieb. Ein Diagnosewerkzeug, das die
    // Bedienung kaputtmacht, gehoert auf einen Schalter.
    //
    // Und das ist zugleich die Richtigstellung einer falschen Deutung:
    // "LED 30/30/0" war NICHT gelungenes Nummernfeststell-Schalten,
    // das waren die Herzschlaege beim Zaehlen. Ohne diesen Schalter
    // sagt dieselbe Zahl jetzt das, was sie zu sagen vorgibt.
    if !kstate.mode_on(state, kstate.M_PULSLED) {
        return
    }
    // Die Lampe halb so schnell -- eine Tastatur mag keinen
    // Steuertransfer viermal je Sekunde, und zweimal reicht dem Auge.
    herz_sek = herz_sek + 1
    if (herz_sek & 1) == 0 {
        herz_led = 1 - herz_led
        usb.beat_leds(state, herz_led)
    }
}

fn tafel_tick(state: u64) {
    if !kstate.mode_on(state, kstate.M_TAFEL) {
        return
    }
    tafel_irq = tafel_irq + 1
    // RUNDE BLECHDREI: NICHT WAEHREND DES AUFZAEHLENS. Siehe
    // `usb.busy` -- die Begruendung steht dort, mit Justins beiden
    // Messwerten.
    if usb.busy(state) != 0 {
        return
    }
    let jetzt: u64 = kstate.get(state, kstate.TICKS)
    // ZWEI UHREN, WIE IN DER SCHLEIFE. Steht der Zeitgeber, zaehlt die
    // Zahl der Rufe -- kommt gar kein Ruf mehr, ist das die Aussage.
    var faellig: bool = false
    if jetzt >= tafel_irqm + TAFEL_MARKEN {
        tafel_irqm = jetzt
        faellig = true
    }
    if !faellig {
        return
    }
    // DIE LEITUNG, UNABHAENGIG VON DER SCHLEIFE. Bisher setzte nur der
    // Puls in `wait_wm` die Marke -- laeuft die Schleife nicht, kam auch
    // seriell nichts. Alle fuenf Sekunden, damit es kein Rauschen wird.
    if jetzt >= tafel_serm + TAFEL_SERMARKEN {
        tafel_serm = jetzt
        tafel_seriell = 1
        kopf_seriell = 1
    }
    tafel_streichen(state)
    tafel_seriell = 0
}

// ============ DAS STANDBILD, EINMAL, UNBEDINGT.
//
// Gemalt am Ende der Boot-Folge, BEVOR das erste Ring-3-Programm
// startet. Es beantwortet die Frage, die drei Runden lang offen war und
// die kein Foto bisher trennen konnte:
//
//   Tafel steht (auch nur mit Nullen)  -> der Kern lebt und die
//                                         Malroutine TRIFFT den Schirm.
//                                         Bleiben die Zahlen danach
//                                         stehen, ist der Zeitgeber tot
//                                         oder die Schleife haengt.
//   Tafel steht GAR NICHT              -> die Malroutine trifft den
//                                         Schirm nicht (Rahmenpuffer,
//                                         Zeilenlaenge, Farbformat).
//
// Es haengt an KEINEM Zeitgeber, an KEINER Schleife und an KEINEM
// Ring-3-Programm -- nur am Schalter und daran, dass es einen
// Rahmenpuffer gibt.
fn tafel_boot(state: u64, stufe: u64) {
    if !kstate.mode_on(state, kstate.M_TAFEL) {
        return
    }
    if !fb.ready(state) {
        return
    }
    var s_b: [u8; 24] = "tafel: STANDBILD gemalt\0"
    // Die Zeilen, die es noch nicht gibt, mit einem Strich fuellen --
    // eine leere Tafel waere nicht von einer fehlenden zu unterscheiden.
    var lz: [u8; 25] = "-- noch keine Messung --\0"
    var z: u64 = 0
    while z < BOARD_LINES {
        if tafel_len[z as usize] == 0 {
            board_remember(z, (&lz[0]) as u64, 24, wm.mess_gelb(state))
        }
        z = z + 1
    }
    // ZEILE 0 SAGT, WIE WEIT DER KERN GEKOMMEN IST. Stufe 1 steht
    // direkt nach `fb.clear`, VOR dem Terminalfenster; Stufe 2 steht
    // hinter allen Fenstern und VOR dem ersten Ring-3-Programm. Sieht
    // Justin nur STUFE1, ist der Kern zwischen Fensterbau und Ring 3
    // stehengeblieben -- und genau diese Strecke erklaert ein fehlendes
    // Terminalfenster.
    var sb: [u8; 64] = [0 as u8; 64]
    let sp: u64 = (&sb[0]) as u64
    var t_st: [u8; 10] = "STANDBILD\0"
    var t_su: [u8; 8] = " STUFE \0"
    var sn: u64 = 0
    sn = puls_text(state, sp, 0, (&t_st[0]) as u64)
    sn = puls_text(state, sp, sn, (&t_su[0]) as u64)
    sn = pulse_num(state, sp, sn, stufe)
    board_remember(0, sp, sn, wm.mess_gelb(state))
    tafel_seriell = 1
    tafel_streichen(state)
    tafel_seriell = 0
    serial.puts((&s_b[0]) as u64)
    serial.nl()
}

fn header_paint(state: u64) {
    if !fb.ready(state) {
        return
    }
    // ===================================================== RUNDE TUERSCHLOSS
    //
    // OHNE `tafel` WIRD KEINE TAFEL GEMALT -- und bis hierher wurde sie
    // es doch.
    //
    // Diese Funktion laeuft nach JEDEM `compose` (Zeile 3438), ohne
    // jede Bedingung, und sie endet unten mit `tafel_streichen` -- dem
    // Anstrich der 24 Diagnosezeilen. `tafel_streichen` selbst fragt
    // `M_TAFEL` NICHT ab (das tun nur `tafel_tick` und `tafel_boot`),
    // also stand die Tafel auf jedem Schreibtisch, auch auf dem eines
    // Menschen, der nie danach gefragt hat.
    //
    // GEMESSEN in Runde TUERSCHLOSS, Kommandozeile OHNE das Wort
    // `tafel` (Bildschirmfoto pruef/shots/tp/getippt.png):
    //
    //   * gruene Tinte von x=4 bis x=764 und y=40 bis y=633,
    //     dreizehn Textbaender -- waehrend das Terminalfenster nur
    //     x=24..584, y=40..420 gross ist;
    //   * 2605 gruene Bildpunkte AUSSERHALB des Fensters;
    //   * die Glyphen sind ein verdoppeltes 8x16-Bitmuster (Zellbreite
    //     16, Zeilenabstand 32) und damit nicht die TTF-Schrift, mit
    //     der der Fensterserver seine Zellen malt;
    //   * 168 `tafel:`-Zeilen auf der seriellen Leitung.
    //
    // Der Schaden ist genau der, den Runde DURCHKLICK bei Punkt 3.7
    // gemessen und dem Terminal angelastet hat: was ein Mensch tippt,
    // steht unter der Tafel und ist im Bild nicht wiederzufinden (77 %
    // statt der geforderten 97 %). Nicht die Shell war stumm, nicht die
    // Tastatur -- die Diagnose lag darueber.
    //
    // `M_NOTAFEL` bleibt zusaetzlich wirksam: wer `notafel` schreibt,
    // hat schon vorher nichts sehen wollen.
    if !kstate.mode_on(state, kstate.M_TAFEL)
        || kstate.mode_on(state, kstate.M_NOTAFEL) {
        return
    }
    let jetzt: u64 = kstate.get(state, kstate.TICKS)
    tafel_runde = tafel_runde + 1
    if jetzt != tafel_marke {
        if jetzt < tafel_marke + TAFEL_MARKEN {
            return
        }
        tafel_marke = jetzt
        tafel_runde = 0
    } else {
        // Die Uhr steht (`nosched`, keine Unterbrechungen). Dann zaehlt
        // die Rundenzahl -- ein Messgeraet, das an einer stehenden Uhr
        // haengt, misst genau dann nichts, wenn es gebraucht wird.
        if tafel_runde < TAFEL_RUNDEN {
            return
        }
        tafel_runde = 0
    }
    tafel_loop = tafel_loop + 1
    var buf: [u8; 64] = [0 as u8; 64]
    let b: u64 = (&buf[0]) as u64
    var n: u64 = 0

    // ---- Zeile 0: welche Fassung, und schlaegt das Herz noch ----
    var t_b: [u8; 4] = " B\0\0"
    var t_t: [u8; 4] = " T\0\0"
    n = tz_text(state, b, 0, version.text())
    n = tz_text(state, b, n, (&t_b[0]) as u64)
    n = pulse_num(state, b, n, wm.composites(state))
    n = tz_text(state, b, n, (&t_t[0]) as u64)
    n = pulse_num(state, b, n, kstate.get(state, kstate.TICKS))
    // RUNDE TAFEL: UND OB EINE SHELL LAEUFT. `sh0` heisst: keine --
    // und bis zu dieser Runde hiess das ausserdem, dass diese ganze
    // Schleife nicht lief und die Tafel deshalb nicht zu sehen war.
    var t_sh: [u8; 5] = " sh\0\0"
    n = tz_text(state, b, n, (&t_sh[0]) as u64)
    n = pulse_num(state, b, n, tafel_sh)
    // ============================================ RUNDE ECHTHARDWARE-5
    // WIE VIEL TEXT IM TERMINALFENSTER ANKOMMT. Justins Befund B ist
    // "das Fenster ist leer, obwohl sh laeuft"; `TO` zaehlt die
    // Oktette, die `wm.term_out` erreichen, `TP` die, die wirklich in
    // eine Zelle gingen. TO 0 heisst: es kommt gar nichts an (der
    // Fehler liegt vor dem Fensterserver). TO gross und TP 0 heisst:
    // das Fenster nimmt sie nicht an.
    var t_to: [u8; 5] = " TO\0\0"
    var t_tp: [u8; 5] = " TP\0\0"
    n = tz_text(state, b, n, (&t_to[0]) as u64)
    n = pulse_num(state, b, n, wm.term_outs(state))
    n = tz_text(state, b, n, (&t_tp[0]) as u64)
    n = pulse_num(state, b, n, wm.term_puts_n(state))
    board_remember(0, b, n, wm.mess_weiss(state))
    header_line_say(state, b, n)

    // ---- Zeile 1: Stufe 1, die HID-Berichte ----
    var t1: [u8; 12] = "1 USB  BER \0"
    var t_w: [u8; 7] = " WAHL \0"
    let ber: u64 = usb.reports(state)
    n = tz_text(state, b, 0, (&t1[0]) as u64)
    n = pulse_num(state, b, n, ber)
    n = tz_text(state, b, n, (&t_w[0]) as u64)
    n = pulse_num(state, b, n, usb.wahl(state))
    board_remember(1, b, n, wm.mess_ampel(state, ber))
    header_line_say(state, b, n)

    // ---- Zeile 2: Stufe 2, eingereiht ----
    var t2: [u8; 9] = "2 QUEUE \0"
    var t_ta: [u8; 3] = "T\0\0"
    var t_ma: [u8; 4] = " M\0\0"
    // RUNDE BLECH2: `K` -- Tastenflanken, die beim Zeiger angekommen sind
    // (ps2m.clicks). Zusammen mit `kl=` im Puls (E_DOWN in einen Ring
    // gelegt) ist das die Kette, an der ein verlorener Klick haengen
    // bleibt: QMP-Klicks == K == kl.
    var t_ka: [u8; 4] = " K\0\0"
    let e_ta: u64 = usb.hid_keys(state)
    let e_ma: u64 = ps2m.packets(state)
    n = tz_text(state, b, 0, (&t2[0]) as u64)
    n = tz_text(state, b, n, (&t_ta[0]) as u64)
    n = pulse_num(state, b, n, e_ta)
    n = tz_text(state, b, n, (&t_ma[0]) as u64)
    n = pulse_num(state, b, n, e_ma)
    n = tz_text(state, b, n, (&t_ka[0]) as u64)
    n = pulse_num(state, b, n, ps2m.clicks(state))
    // `D` -- E_DOWN, die in einen Fensterring gelegt wurden (wm.downs),
    // im SELBEN Anstrich wie K: mit dem Zeiger ueber einem Fenster
    // muss D gleich K sein, sonst ist zwischen Zeiger und Ring ein
    // Klick verschwunden. (`kl=` im Puls ist dieselbe Zahl, aber zu
    // einem anderen Zeitpunkt.)
    var t_d: [u8; 4] = " D\0\0"
    n = tz_text(state, b, n, (&t_d[0]) as u64)
    n = pulse_num(state, b, n, wm.downs(state))
    board_remember(2, b, n, wm.mess_ampel(state, e_ta + e_ma))
    header_line_say(state, b, n)

    // ---- Zeile 3: Stufe 3, der Fensterserver hat abgeholt ----
    var t3: [u8; 9] = "3 SERV  \0"
    let s_ta: u64 = wm.keyin(state)
    let s_ma: u64 = wm.moves_seen(state)
    n = tz_text(state, b, 0, (&t3[0]) as u64)
    n = tz_text(state, b, n, (&t_ta[0]) as u64)
    n = pulse_num(state, b, n, s_ta)
    n = tz_text(state, b, n, (&t_ma[0]) as u64)
    n = pulse_num(state, b, n, s_ma)
    board_remember(3, b, n, wm.mess_ampel(state, s_ta + s_ma))
    header_line_say(state, b, n)

    // ---- Zeile 4: Stufe 4, in den Fensterring gelegt ----
    var t4: [u8; 10] = "4 RING   \0"
    var t_v: [u8; 8] = "  VERL \0"
    // RUNDE BLECH2: `KOAL` -- Bewegungen, die in ein liegendes E_MOVE
    // zusammengefasst wurden (kein Verlust, siehe wm.ev_push). Und die
    // Zeile wird ROT, sobald VERL nicht null ist: genau die Zahl, die
    // Justin fotografieren soll.
    var t_ko: [u8; 7] = " KOAL \0"
    let rein: u64 = wm.evpush(state)
    let verl: u64 = wm.evdrops(state)
    n = tz_text(state, b, 0, (&t4[0]) as u64)
    n = pulse_num(state, b, n, rein)
    n = tz_text(state, b, n, (&t_v[0]) as u64)
    n = pulse_num(state, b, n, verl)
    n = tz_text(state, b, n, (&t_ko[0]) as u64)
    n = pulse_num(state, b, n, wm.evkoal(state))
    var f4: u64 = wm.mess_ampel(state, rein)
    if verl != 0 {
        f4 = wm.mess_rot(state)
    }
    board_remember(4, b, n, f4)
    header_line_say(state, b, n)

    // ---- Zeile 5: Stufe 5, ein Programm hat abgeholt ----
    var t5: [u8; 10] = "5 APP    \0"
    let raus: u64 = wm.evpop(state)
    n = tz_text(state, b, 0, (&t5[0]) as u64)
    n = pulse_num(state, b, n, raus)
    board_remember(5, b, n, wm.mess_ampel(state, raus))
    header_line_say(state, b, n)

    // ---- Zeile 6: der Zeiger ----
    var t6: [u8; 10] = "6 CURSOR \0"
    var t_x: [u8; 3] = "X\0\0"
    var t_y: [u8; 4] = " Y\0\0"
    n = tz_text(state, b, 0, (&t6[0]) as u64)
    n = tz_text(state, b, n, (&t_x[0]) as u64)
    n = pulse_num(state, b, n, wm.curx(state))
    n = tz_text(state, b, n, (&t_y[0]) as u64)
    n = pulse_num(state, b, n, wm.cury(state))
    board_remember(6, b, n, wm.mess_ampel(state, s_ma))
    header_line_say(state, b, n)

    // ---- Zeile 7: die TASKLEISTE -- wird sie ueberhaupt gemalt? ----
    //
    // Justins zweiter Befund: die Leiste meldet Erfolg und ist nicht zu
    // sehen. `MAL` ist die Zahl der Male, die `wm.compose` sie WIRKLICH
    // gemalt hat. Ist sie 0 (rot), hat das Zusammensetzen sie
    // uebergangen -- dann liegt es an `fl` (verborgen/Reiter) oder an
    // der Stapelfolge. Laeuft sie hoch und der untere Bildrand bleibt
    // leer, sind die Bildpunkte gemalt und der Fehler liegt DAHINTER.
    var t7: [u8; 10] = "7 PANEL  \0"
    var t_id: [u8; 4] = "id\0\0"
    var t_yy: [u8; 4] = " y\0\0"
    var t_ml: [u8; 6] = " MAL \0"
    var t_fl: [u8; 4] = " fl\0"
    let tb: u64 = wm.panel_win(state)
    n = tz_text(state, b, 0, (&t7[0]) as u64)
    if tb >= wm.MAX_WIN {
        // Kein Fenster auf der obersten Ebene: die Leiste hat sich nie
        // angemeldet. Das ist ein anderer Fehler als "gemalt, unsichtbar".
        var t_kein: [u8; 5] = "KEIN\0"
        n = tz_text(state, b, n, (&t_kein[0]) as u64)
        board_remember(7, b, n, wm.mess_rot(state))
    header_line_say(state, b, n)
    } else {
        let draw: u64 = wm.win_paints(state, tb)
        n = tz_text(state, b, n, (&t_id[0]) as u64)
        n = pulse_num(state, b, n, wm.win_id(state, tb))
        n = tz_text(state, b, n, (&t_yy[0]) as u64)
        n = pulse_num(state, b, n, wm.win_y(state, tb) as u64)
        n = tz_text(state, b, n, (&t_ml[0]) as u64)
        n = pulse_num(state, b, n, draw)
        n = tz_text(state, b, n, (&t_fl[0]) as u64)
        n = pulse_num(state, b, n, wm.win_flags(state, tb))
        // ==================================== RUNDE STARTKNOPF
        // UND WAS IHR PROZESS GERADE TUT. Das ist die Zahl, die
        // Justins Hauptbefund entscheidet: die Leiste steht auf
        // 19:49, waehrend die Tafel 19:50:30 zeigt, und `MAL`
        // laeuft trotzdem hoch. `MAL` zaehlt, wie oft der
        // ZUSAMMENSETZER ihren Puffer auf den Schirm gelegt hat --
        // ueber den INHALT dieses Puffers sagt das nichts. Malt der
        // Prozess nicht mehr hinein, legt der Zusammensetzer
        // weiterhin brav dasselbe alte Bild hin.
        //
        // `ZU` ist der Zustand seiner Aufgabe:
        //   1 bereit  2 laeuft  3 SCHLAEFT  4 wartet  5 LEICHE
        // Steht dort dauerhaft 5, ist der Prozess tot -- dann helfen
        // keine Klicks. Steht dort dauerhaft 3, schlaeft er und
        // niemand weckt ihn: dann ist der Zeitgeberweg schuld
        // (`sched.on_tick` weckt Schlaefer, und nur der).
        var t_zu: [u8; 5] = " ZU \0"
        let bo: u64 = wm.win_owner(state, tb)
        n = tz_text(state, b, n, (&t_zu[0]) as u64)
        n = pulse_num(state, b, n, sched.tget(state, bo, sched.T_STATE))
        // RUNDE BLECH2: TK heisst jetzt "Titelzeilen im Band der Tafel"
        // (wm.title_text); die alte Zaehlweise steht als `tka=` in
        // `wm: fen`. Rot, sobald TK nicht null ist.
        var l_tk: [u8; 5] = " TK \0"
        n = puls_text(state, b, n, (&l_tk[0]) as u64)
        let tk: u64 = wm.title_clipped()
        n = pulse_num(state, b, n, tk)
        var f7: u64 = wm.mess_ampel(state, draw)
        if tk != 0 {
            f7 = wm.mess_rot(state)
        }
        board_remember(7, b, n, f7)
        header_line_say(state, b, n)
    }
    // ================================ UND JETZT AUF DEN SCHIRM DAMIT
    //
    // HIER WAR DER FEHLER, DER JUSTIN DIE GANZE RUNDE FASSUNG GEKOSTET
    // HAT, und er ist gemessen, nicht vermutet.
    //
    // `wm.compose` steigt in seiner ZWEITEN Zeile aus, wenn nichts
    // schmutzig ist (`S_DON == 0`) -- und der Ausstieg liegt VOR
    // `fb.flush`. Auf einem Schreibtisch, auf dem sich nichts bewegt,
    // wird also NIE geflusht. Alles, was danach in den Rahmenpuffer
    // gemalt wird, landet im ZWEITPUFFER und kommt dort nicht mehr weg.
    //
    // Genau das ist mit der gruenen Zeile passiert. In QEMU fiel es
    // nicht auf, weil dort die Shell im Terminalfenster staendig neu
    // startet und mit jeder Zeile Schmutz erzeugt -- also floss der
    // Puffer. Auf Justins Brett steht der Schreibtisch still, es wird
    // nichts schmutzig, es wird nie geflusht, und die Zeile ist
    // unsichtbar. Er hat gemeldet "kein sichtbarer Unterschied", und er
    // hatte zum zweiten Mal recht.
    //
    // Gemessen am Bildschirmfoto vor dieser Zeile: die obersten 84
    // Bildzeilen der Tafel standen auf dem Schirm, die restlichen 258
    // nicht -- der Rest des Zweitpuffers war nie hinuebergekommen.
    //
    // Diese eine Zeile ist der Unterschied zwischen "in den Puffer
    // gemalt" und "auf dem Bildschirm". Sie flusht NUR die Zeilen der
    // Tafel (`fb.dirty` hat sie eben markiert), nicht das ganze Bild.
    tafel_streichen(state)
    tafel_seriell = 0
    kopf_seriell = 0
}

fn input_pulse(state: u64, tw: u64, neustarts: u64) {
    var buf: [u8; 200] = [0 as u8; 200]
    var n: u64 = 0
    var m_ber: [u8; 10] = "eingabe: \0"
    var m_b: [u8; 5] = "ber=\0"
    var m_i: [u8; 6] = " irq=\0"
    var m_e: [u8; 5] = " ev=\0"
    var m_s: [u8; 6] = " sts=\0"
    var m_n: [u8; 7] = " iman=\0"
    var m_mk: [u8; 5] = " mk=\0"
    var m_if: [u8; 5] = " if=\0"
    var m_t: [u8; 5] = " ta=\0"
    var m_l: [u8; 5] = " lo=\0"
    var m_w: [u8; 6] = " bew=\0"
    var m_p: [u8; 5] = " pk=\0"
    var m_x: [u8; 5] = " xy=\0"
    var m_k: [u8; 2] = ",\0"
    var m_m: [u8; 5] = " wm=\0"
    var m_c: [u8; 5] = " kl=\0"
    var m_sh: [u8; 5] = " sh=\0"
    // RUNDE FASSUNG: DIE ZEILE FAENGT MIT DER FASSUNG AN. Justin
    // fotografiert den Bildschirm; wenn die Fassung nicht IN der Zeile
    // steht, die er fotografiert, steht sie fuer ihn nirgends.
    var m_wahl: [u8; 7] = " wahl=\0"
    n = puls_text(state, (&buf[0]) as u64, n, version.text())
    n = puls_text(state, (&buf[0]) as u64, n, (&m_wahl[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.wahl(state))
    kstate.set8((&buf[0]) as u64 + n, 32)
    n = n + 1
    n = puls_text(state, (&buf[0]) as u64, n, (&m_ber[0]) as u64)
    n = puls_text(state, (&buf[0]) as u64, n, (&m_b[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.reports(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_i[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, xhci.irqs(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_e[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, xhci.events(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_s[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, xhci.usbsts(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_n[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, xhci.iman(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_mk[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, kstate.get(state, kstate.TICKS))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_if[0]) as u64)
    let fl: u64 = asm("pushfq\npop rax", out("rax"))
    n = pulse_num(state, (&buf[0]) as u64, n, (fl >> 9) & 1)
    n = puls_text(state, (&buf[0]) as u64, n, (&m_t[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.hid_keys(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_l[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.hid_los(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_w[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.hid_bew(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_p[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, ps2m.packets(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_x[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, ps2m.x(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_k[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, ps2m.y(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_m[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, wm.moves_seen(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_c[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, wm.downs(state))
    n = puls_text(state, (&buf[0]) as u64, n, (&m_sh[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, neustarts)
    kstate.set8((&buf[0]) as u64 + n, 10)
    n = n + 1
    // RUNDE BLECHFUENF: `nopuls` haelt die Zeile aus dem Terminal. Die
    // Kopfzeile oben und die serielle Ausgabe bleiben -- was Justin
    // stoerte, war das Fenster, in dem er arbeiten will.
    if tw < wm.MAX_WIN && !kstate.mode_on(state, kstate.M_NOPULS) {
        let _w: u64 = wm.term_write(state, tw, (&buf[0]) as u64, n)
    }
    // RUNDE MESSTAFEL: und die ganze Fensterliste auf die Leitung --
    // Kennung, Lage, Groesse, Ebene, Merker, Stapelplatz, Malzaehler.
    // Damit ist der Weg der Taskleiste vom Anlegen bis zum
    // Zusammensetzen lueckenlos in Zahlen nachlesbar.
    wm.wins_say(state)
    // RUNDE HIDPUNKTE: UND DIESELBE ZEILE OBEN AUF DEN SCHIRM, an
    // `compose` vorbei. Auf Justins Brett war das Terminalfenster zu
    // schmal und links abgeschnitten -- die Diagnose stand also da, wo
    // sie am schlechtesten zu lesen war. Diese Zeile haengt an nichts:
    // kein Fenster, kein Puffer, keine TTF-Schrift.
    //
    // RUNDE FASSUNG: sie wird hier nur noch HINTERLEGT und in der
    // Hauptschleife nach jedem `compose` gemalt -- sonst ueberschreibt
    // das naechste Zusammensetzen sie sofort wieder.
    if n > 0 {
        header_set(state, (&buf[0]) as u64, n - 1)
    }
    kstate.set8((&buf[0]) as u64 + n - 1, 0)
    serial.puts((&buf[0]) as u64)
    serial.nl()
    kstate.set8((&buf[0]) as u64 + n - 1, 10)
}

fn puls_text(state: u64, buf: u64, at: u64, t: u64) -> u64 {
    var n: u64 = at
    var i: u64 = 0
    while kstate.get8(t + i) != 0 && n < 190 {
        kstate.set8(buf + n, kstate.get8(t + i) as u8)
        n = n + 1
        i = i + 1
    }
    return n
}

// RUNDE KABEL: ZWEI HEXZIFFERN. Ein LSR-Wert gehoert in Hex auf die
// Tafel und nicht in Dezimal -- 0x00, 0x20 und 0xFF sind drei
// verschiedene Aussagen, und "0", "32", "255" liest niemand als
// Registerzustand. 256 heisst "nicht geprueft" und wird als "--"
// geschrieben.
// RUNDE BLECHEINGABE: HEXADEZIMAL MIT ANGEGEBENER BREITE.
//
// `puls_hex` kann genau zwei Ziffern und schreibt fuer alles darueber
// "--". Fuer ein Klassentripel reicht das; fuer 0x1B36 (Hersteller),
// 0x000D (Erzeugnis) und ein PORTSC-Register (32 Bit) nicht -- und
// genau die drei sind die Zahlen, an denen sich auf Justins Brett
// entscheidet, WAS dort haengt.
// RUNDE BLECHFUENF: ZWEI DEZIMALSTELLEN MIT FUEHRENDER NULL. Eine Uhr
// als "18:7:5" liest niemand als 18:07:05.
fn pulse_two(state: u64, buf: u64, at: u64, v: u64) -> u64 {
    var n: u64 = at
    let w: u64 = v % 100
    kstate.set8(buf + n, (48 + w / 10) as u8)
    kstate.set8(buf + n + 1, (48 + w % 10) as u8)
    return n + 2
}

fn puls_hexn(state: u64, buf: u64, at: u64, v: u64, stellen: u64) -> u64 {
    var ziffern: [u8; 17] = "0123456789ABCDEF\0"
    var i: u64 = stellen
    var n: u64 = at
    while i > 0 {
        i = i - 1
        kstate.set8(buf + n, ziffern[((v >> (i * 4)) & 15) as usize])
        n = n + 1
    }
    return n
}

fn puls_hex(state: u64, buf: u64, at: u64, v: u64) -> u64 {
    var ziffern: [u8; 17] = "0123456789ABCDEF\0"
    var n: u64 = at
    if v > 255 {
        kstate.set8(buf + n, 45 as u8)
        kstate.set8(buf + n + 1, 45 as u8)
        return n + 2
    }
    kstate.set8(buf + n, ziffern[((v >> 4) & 15) as usize])
    kstate.set8(buf + n + 1, ziffern[(v & 15) as usize])
    return n + 2
}

fn pulse_num(state: u64, buf: u64, at: u64, v: u64) -> u64 {
    var ziffern: [u8; 24] = [0 as u8; 24]
    var k: u64 = 0
    var w: u64 = v
    if w == 0 {
        ziffern[0] = 0x30
        k = 1
    }
    while w != 0 && k < 20 {
        ziffern[k as usize] = (0x30 + (w % 10)) as u8
        w = w / 10
        k = k + 1
    }
    var n: u64 = at
    while k > 0 && n < 190 {
        k = k - 1
        kstate.set8(buf + n, ziffern[k as usize])
        n = n + 1
    }
    return n
}

// Was das Zeigegeraet in diesem Lauf WIRKLICH gemeldet hat. Die Zahlen
// sind der einzige Weg, von aussen nachzuweisen, dass die ueber den
// QEMU-Monitor eingespeisten Bewegungen angekommen sind.
// RUNDE GPU (G-012): DIE ZAHLEN DES GEZAEHLTEN LAUFS.
//
// Sie stehen in einer eigenen Zeile, weil die Abnahme genau sie
// vergleicht -- mit Zeiger in der Hardware und ohne (`nohwcur`).
// `pakete` ist die ZUSAGE (so viele wurden geschickt), alles andere
// ist gemessen.
fn say_mauslauf(state: u64) {
    if mauslauf_soll == 0 {
        return
    }
    var s: [u8; 18] = "mauslauf: pakete=\0"
    var s_us: [u8; 7] = "  us=\0\0"
    var s_cd: [u8; 11] = "  curdef=\0\0"
    var s_cm: [u8; 12] = "  curmove=\0\0"
    var s_ce: [u8; 11] = "  curerr=\0\0"
    var s_hw: [u8; 7] = "  hw=\0\0"
    serial.puts((&s[0]) as u64)
    serial.dec(mauslauf_ist)
    serial.puts((&s_us[0]) as u64)
    serial.dec(mauslauf_us)
    serial.puts((&s_cd[0]) as u64)
    serial.dec(vgpu.cursor_defs(state))
    serial.puts((&s_cm[0]) as u64)
    serial.dec(vgpu.cursor_moves(state))
    serial.puts((&s_ce[0]) as u64)
    serial.dec(vgpu.cursor_fehler(state))
    serial.puts((&s_hw[0]) as u64)
    if wm.hwcur_an(state) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()
}

fn say_wm_input(state: u64) {
    var s: [u8; 12] = "wminput: x=\0"
    var s_y: [u8; 5] = "  y=\0"
    var s_b: [u8; 7] = "  btn=\0"
    var s_p: [u8; 11] = "  packets=\0"
    var s_m: [u8; 9] = "  moves=\0"
    var s_d: [u8; 9] = "  drops=\0"
    var s_w: [u8; 9] = "  wheel=\0"
    var s_i: [u8; 8] = "  irqs=\0"
    var s_po: [u8; 9] = "  polls=\0"
    var s_sp: [u8; 12] = "  spurious=\0"
    var s_gs: [u8; 8] = "  gsi=\0\0"
    var s_dn: [u8; 9] = "  downs=\0"
    var s_mv: [u8; 12] = "  onmouse=\0\0"
    var s_ht: [u8; 8] = "  hits=\0"
    var s_e0: [u8; 7] = "  ev0=\0"
    var s_e1: [u8; 7] = "  ev1=\0"
    var s_z0: [u8; 6] = "  z0=\0"
    var s_z1: [u8; 6] = "  z1=\0"
    var s_k0: [u8; 9] = "  keys0=\0"
    var s_k1: [u8; 9] = "  keys1=\0"
    var s_wn: [u8; 13] = "wmafter: n=\0\0"
    var s_wf: [u8; 9] = "  focus=\0"
    var s_c: [u8; 10] = "  clicks=\0"
    var s_s: [u8; 11] = "  status=\0\0"
    serial.puts((&s[0]) as u64)
    serial.dec(ps2m.x(state))
    serial.puts((&s_y[0]) as u64)
    serial.dec(ps2m.y(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(ps2m.buttons(state))
    serial.puts((&s_p[0]) as u64)
    serial.dec(ps2m.packets(state))
    serial.puts((&s_m[0]) as u64)
    serial.dec(ps2m.moves(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(ps2m.drops(state))
    serial.puts((&s_w[0]) as u64)
    serial.dec(ps2m.wheel(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(ps2m.irqs(state))
    serial.puts((&s_po[0]) as u64)
    serial.dec(ps2m.polls(state))
    serial.puts((&s_sp[0]) as u64)
    serial.dec(ps2m.spurious(state))
    serial.puts((&s_gs[0]) as u64)
    serial.hex(apic.gsi_entry(state, 12))
    serial.puts((&s_dn[0]) as u64)
    serial.dec(wm.downs(state))
    serial.puts((&s_mv[0]) as u64)
    serial.dec(wm.moves_seen(state))
    serial.puts((&s_ht[0]) as u64)
    serial.dec(wm.hits_seen(state))
    serial.puts((&s_e0[0]) as u64)
    serial.dec(wm.ev_waiting(state, 0))
    serial.puts((&s_e1[0]) as u64)
    serial.dec(wm.ev_waiting(state, 1))
    serial.puts((&s_z0[0]) as u64)
    serial.dec(wm.win_z(state, 0))
    serial.puts((&s_z1[0]) as u64)
    serial.dec(wm.win_z(state, 1))
    serial.puts((&s_k0[0]) as u64)
    serial.dec(wm.win_keys(state, 0))
    serial.puts((&s_k1[0]) as u64)
    serial.dec(wm.win_keys(state, 1))
    serial.nl()
    // WIE VIELE FENSTER ES DANACH NOCH GIBT. Die Zeile `wm: windows=`
    // weiter oben steht VOR der Wartezeit -- was mit der Maus geschlossen
    // wurde, konnte sie nicht wissen.
    serial.puts((&s_wn[0]) as u64)
    serial.dec(wm.count(state))
    serial.puts((&s_wf[0]) as u64)
    serial.dec(wm.focus(state))
    serial.puts((&s_c[0]) as u64)
    serial.dec(ps2m.clicks(state))
    serial.puts((&s_s[0]) as u64)
    serial.hex(ps2m.status())
    serial.nl()
    wmplug_bilanz(state)
}

// RUNDE WMPLUGIN: DIE BILANZ AM ENDE DES HALTENS.
//
// Sie steht hier und nicht beim Hochlauf, weil sie ueber den LAUF
// Auskunft gibt und nicht ueber den Aufbau: wie viele Plugins noch
// angemeldet sind, wie viele Ereignisse eingelegt und abgeholt wurden,
// wie viele Plaetze geraeumt werden mussten (Absturz oder Frist), wie
// viele Handlungen an den Rechten scheiterten und wie viele Tasten ein
// Plugin bekommen hat -- und damit kein Fenster. Ohne diese Zeile
// muesste ein Laeufer aus einzelnen Meldungen zusammenzaehlen, und eine
// Summe, die der Laeufer selbst bildet, belegt weniger als eine, die der
// Kern nennt.
fn wmplug_bilanz(state: u64) {
    if !wmplug.ready(state) {
        return
    }
    var s_b: [u8; 16] = "wmplug: bilanz␀␀"
    var s_p: [u8; 9] = "  plugs=␀"
    var s_i: [u8; 8] = "  evin=␀"
    var s_o: [u8; 9] = "  evout=␀"
    var s_k: [u8; 10] = "  kicks=␀␀"
    var s_d: [u8; 9] = "  deny=␀␀"
    var s_t: [u8; 12] = "  plugkeys=␀"
    serial.puts((&s_b[0]) as u64)
    serial.puts((&s_p[0]) as u64)
    serial.dec(wmplug.plugs(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(wmplug.events_in(state))
    serial.puts((&s_o[0]) as u64)
    serial.dec(wmplug.events_out(state))
    serial.puts((&s_k[0]) as u64)
    serial.dec(wmplug.kicks(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(wmplug.denials(state))
    serial.puts((&s_t[0]) as u64)
    serial.dec(wm.plugkeys(state))
    serial.nl()
}

fn say_font(state: u64, f: u64, px: u64, name: u64, s_font: u64, s_g: u64,
    s_upm: u64, s_asc: u64, s_desc: u64, s_lh: u64, s_kp: u64, s_st: u64,
    s_of: u64) {
    if f >= ttf.MAX_FONTS {
        return
    }
    serial.puts(s_font)
    serial.puts(name)
    serial.puts(s_g)
    serial.dec(ttf.glyphs(state, f))
    serial.puts(s_upm)
    serial.dec(ttf.upm(state, f))
    serial.puts(s_asc)
    serial.dec(ttf.ascent(state, f, px) as u64)
    serial.puts(s_desc)
    serial.dec(ttf.descent(state, f, px) as u64)
    serial.puts(s_lh)
    serial.dec(ttf.line_height(state, f, px))
    serial.puts(s_kp)
    serial.dec(kern_pairs(state, f, px))
    serial.puts(s_st)
    serial.dec(ttf.selftest(state, f))
    serial.puts(s_of)
    serial.dec(ttf.selftest_max())
    serial.nl()
}

// Wie viele der 95 Zeichenpaare dieser Schrift wirklich unterschnitten
// werden -- eine Zahl statt der Behauptung "kann Unterschneidung".
fn kern_pairs(state: u64, f: u64, px: u64) -> u64 {
    var n: u64 = 0
    var a: u64 = 0x20
    while a <= 0x7E {
        var b: u64 = 0x20
        while b <= 0x7E {
            if ttf.kern26(state, f, ttf.glyph_of(state, f, a),
                ttf.glyph_of(state, f, b), px) != 0 {
                n = n + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    return n
}

// ======================================================= RUNDE GLYPHE
// WAS DER NACHWEIS BRAUCHT, BEVOR ES EINEN SCHREIBTISCH GIBT.
//
// `smp.glyphrace` laeuft im Hochlauf, aus `smp.stage` heraus -- da ist
// die Platte da (kmain ruft `filesystem` davor), aber der
// Fensterserver noch nicht. Der Zeichenweg braucht dafuer genau zwei
// Dinge: einen Zwischenspeicher und EINE Schrift. Beides holt diese
// Funktion mit denselben Zeilen wie `surface` weiter oben; ein
// Rahmenpuffer wird NICHT gebraucht, es wird nichts angezeigt.
//
// Rueckgabe: der Platz der Schrift, oder alle Bits gesetzt, wenn es
// nichts zu messen gibt (keine Platte, keine Schrift, kein Speicher).
fn grace_ready(state: u64) -> u64 {
    var s_gf: [u8; 18] = "gui: grace font=\0\0"
    var s_gfs: [u8; 8] = "  fs=\0\0\0"
    if ttf.fonts(state) > 0 {
        wig.race_ready(state, 0)
        return 0
    }
    let arena: u64 = mem.frame_run(state, WM_ARENA_FRAMES)
    if arena == 0
        || !ttf.init(state, arena, WM_ARENA_FRAMES * mem.FRAME_SIZE) {
        return 0xFFFFFFFFFFFFFFFF
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        var quelle: bool = false
        if bootmod.ready(state) {
            blk.ram_init(state, bootmod.base(state), bootmod.blocks(state))
            quelle = true
        } else {
            if blk.present(state) {
                blk.use_ata(state, kutil.root_blocks(state))
                quelle = true
            }
        }
        if quelle {
            let m: bool = fs.mount(state)
            serial.puts((&s_gfs[0]) as u64)
            serial.dec(kutil.yes(m))
        }
    }
    var p_sans: [u8; 15] = "/lib/sans.ttf\0\0"
    let f: u64 = load_font(state, (&p_sans[0]) as u64)
    serial.puts((&s_gf[0]) as u64)
    serial.dec(f)
    serial.nl()
    if f >= ttf.MAX_FONTS {
        return 0xFFFFFFFFFFFFFFFF
    }
    wig.race_ready(state, f)
    return f
}

fn grace_soll(state: u64, index: u64) -> u64 {
    return wig.race_soll(state, index)
}

fn grace_core(state: u64, index: u64, runden: u64, soll: u64) -> u64 {
    return wig.race_core(state, index, runden, soll)
}

fn grace_cold(state: u64) {
    ttf.cache_clear(state)
}

// Eine Schriftdatei von der Platte in den Speicher und in den Leser.
fn load_font(state: u64, pfad: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return ttf.MAX_FONTS
    }
    let ino: u64 = fs.path(state, pfad)
    if ino == 0 {
        return ttf.MAX_FONTS
    }
    let n: u64 = fs.inode_size(state, ino)
    if n < 12 || n > 1048576 {
        return ttf.MAX_FONTS
    }
    let rahmen: u64 = (n + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    let buf: u64 = mem.frame_run(state, rahmen)
    if buf == 0 {
        return ttf.MAX_FONTS
    }
    var off: u64 = 0
    while off < n {
        var c: u64 = n - off
        if c > 4096 {
            c = 4096
        }
        let got: u64 = fs.read_at(state, ino, off, buf + off, c)
        if got == 0 {
            off = n
        } else {
            off = off + got
        }
    }
    return ttf.load_font(state, buf, n)
}

// DIE MESSUNG DIESER RUNDE, und sie hat zwei Teile:
//
//   1. ZUSAMMENSETZEN MIT UND OHNE BEREICHSVERFOLGUNG. Derselbe
//      Bildschirm, dieselben Fenster, derselbe Zeitzaehler -- einmal
//      ueber den ganzen Schirm und einmal ueber das Rechteck, das ein
//      bewegter Zeiger schmutzig macht. Das ist die Zahl, die eine
//      bedienbare Oberflaeche von einer unbedienbaren trennt.
//   2. SCHRIFTRASTERUNG MIT UND OHNE ZWISCHENSPEICHER. Fuenfundneunzig
//      Zeichen frisch gerastert gegen fuenfundneunzig aus dem Speicher.
// EINE GLYPHE ALS TEXT AUF DIE SERIELLE LEITUNG.
//
// Der Rasterer sitzt im Kernel; ein Bildschirmfoto zeigt sein Ergebnis
// erst, nachdem es durch Fenster, Zusammensetzung und Zweitpuffer
// gelaufen ist. Wenn dort etwas fehlt, ist die erste Frage: liegt es am
// Rasterer oder am Weg dahinter? Diese Ausgabe beantwortet sie -- sie
// zeigt die Deckung, wie sie aus `ttf.glyph` herauskommt, und
// `tools/wm/run.sh` haelt sie gegen `tools/ttf/raster.py`.
fn glyph_sum(state: u64, slot: u64) -> u64 {
    var acc: u64 = 2166136261
    var i: u64 = 0
    let n: u64 = ttf.g_w(state, slot) * ttf.g_h(state, slot)
    while i < n {
        let a: u64 = ttf.g_pixel(state, slot, i % ttf.g_w(state, slot),
            i / ttf.g_w(state, slot))
        acc = ((acc ^ a) *% 16777619) & 0xFFFFFFFF
        i = i + 1
    }
    return acc
}

fn say_glyph(state: u64, f: u64, px: u64, c: u64) {
    var s_g: [u8; 12] = "ttfglyph c=\0"
    var s_px: [u8; 6] = "  px=\0"
    var s_w: [u8; 5] = "  w=\0"
    var s_h: [u8; 5] = "  h=\0"
    var s_l: [u8; 8] = "  left=\0"
    var s_t: [u8; 7] = "  top=\0"
    var s_a: [u8; 7] = "  adv=\0"
    var s_s: [u8; 7] = "  sum=\0"
    var s_r: [u8; 10] = "ttfrow \0\0\0"
    var stufen: [u8; 11] = " .:-=+*#%@\0"
    let slot: u64 = ttf.glyph(state, f, c, px)
    serial.puts((&s_g[0]) as u64)
    serial.dec(c)
    serial.puts((&s_px[0]) as u64)
    serial.dec(px)
    serial.puts((&s_w[0]) as u64)
    serial.dec(ttf.g_w(state, slot))
    serial.puts((&s_h[0]) as u64)
    serial.dec(ttf.g_h(state, slot))
    serial.puts((&s_l[0]) as u64)
    serial.dec(ttf.g_left(state, slot) as u64)
    serial.puts((&s_t[0]) as u64)
    serial.dec(ttf.g_top(state, slot) as u64)
    serial.puts((&s_a[0]) as u64)
    serial.dec(ttf.g_adv(state, slot) as u64)
    // EINE PRUEFSUMME UEBER DIE ROHEN DECKUNGSWERTE. Die Zeilen darunter
    // sind auf zehn Stufen gerundet, damit ein Mensch sie lesen kann;
    // diese Zahl ist es nicht. `tools/ttf/raster.py` rechnet dieselbe
    // Summe aus seiner eigenen Rasterung -- stimmen die beiden, sind die
    // zwei Fassungen des Rasterers OKTETT FUER OKTETT einig.
    serial.puts((&s_s[0]) as u64)
    serial.dec(glyph_sum(state, slot))
    serial.nl()
    var y: u64 = 0
    while y < ttf.g_h(state, slot) {
        serial.puts((&s_r[0]) as u64)
        serial.dec(y)
        serial.put(32 as u8)
        serial.put(124 as u8)
        var x: u64 = 0
        while x < ttf.g_w(state, slot) {
            let a: u64 = ttf.g_pixel(state, slot, x, y)
            serial.put(stufen[(a * 10 / 256) as usize])
            x = x + 1
        }
        serial.put(124 as u8)
        serial.nl()
        y = y + 1
    }
}

fn wm_bench(state: u64, f: u64, px: u64) {
    var s_c: [u8; 23] = "wmbench: compose full=\0"
    var s_us: [u8; 4] = " us\0"
    var s_sm: [u8; 10] = "  small=\0\0"
    var s_fa: [u8; 11] = "  factor=\0\0"
    var s_g: [u8; 21] = "wmbench: glyph cold=\0"
    var s_wa: [u8; 9] = "  warm=\0\0"
    var s_pc: [u8; 12] = " (je 95 Zn)\0"

    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return
    }
    // 1a. der ganze Schirm
    var t: u64 = apic.tsc()
    var i: u64 = 0
    while i < K10_RUNDEN {
        wm.damage_all(state)
        wm.compose(state)
        i = i + 1
    }
    let full: u64 = us_of(state, apic.tsc() - t) / K10_RUNDEN
    // 1b. nur das Rechteck eines Zeigers (12x18) -- das, was eine
    //     Zeigerbewegung wirklich schmutzig macht.
    t = apic.tsc()
    i = 0
    while i < K10_RUNDEN {
        wm.damage(state, 300, 300, 312, 318)
        wm.compose(state)
        i = i + 1
    }
    var small: u64 = us_of(state, apic.tsc() - t) / K10_RUNDEN
    serial.puts((&s_c[0]) as u64)
    serial.dec(full)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sm[0]) as u64)
    serial.dec(small)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_fa[0]) as u64)
    if small == 0 {
        small = 1
    }
    serial.dec(full * 100 / small)
    serial.nl()

    // 2. die Schriftrasterung
    if f < ttf.MAX_FONTS {
        let kalt_px: u64 = px + 7 // eine Groesse, die noch niemand hat
        t = apic.tsc()
        var c: u64 = 0x20
        while c <= 0x7E {
            ttf.glyph(state, f, c, kalt_px)
            c = c + 1
        }
        let kalt: u64 = us_of(state, apic.tsc() - t)
        t = apic.tsc()
        c = 0x20
        while c <= 0x7E {
            ttf.glyph(state, f, c, kalt_px)
            c = c + 1
        }
        var warm: u64 = us_of(state, apic.tsc() - t)
        serial.puts((&s_g[0]) as u64)
        serial.dec(kalt)
        serial.puts((&s_us[0]) as u64)
        serial.puts((&s_wa[0]) as u64)
        serial.dec(warm)
        serial.puts((&s_us[0]) as u64)
        serial.puts((&s_fa[0]) as u64)
        if warm == 0 {
            warm = 1
        }
        serial.dec(kalt * 100 / warm)
        serial.puts((&s_pc[0]) as u64)
        serial.nl()
    }
}

// RUNDE MERGE-2: dieser Block kam auf `softui` in kernel/kmain.fi an;
// seit `serverbuild` steht der ganze Fensterteil hier.
// ===================================================== RUNDE SOFTUI
//
// DERSELBE BILDAUFBAU, ABER MIT DER FORM, DIE WIRKLICH AUF DEM SCHIRM
// STEHT -- und dazu die zwei Zaehler, die sagen, WOFUER die Zeit
// draufgegangen ist:
//
//   shadowpx   gemischte Bildpunkte, die zum Fensterschatten gehoeren
//   aapx       Bildpunkte, die durch den Eckenabtaster mussten
//
// Der zweite ist der eigentliche Messwert dieser Runde. Der Schatten
// aus Runde PAINT hat ihn in die Hoehe getrieben, weil er seine Ecken
// BEI JEDEM BILD neu abgetastet hat; die vorberechnete Maske dieser
// Runde macht ihn zu null, ohne dass ein Bildpunkt weniger gemischt
// wird. Wer nur die Mikrosekunden misst, sieht den Grund nicht.
const SOFTUI_RUNDEN: u64 = 20

fn wm_bench2(state: u64) {
    var s_c: [u8; 24] = "wmbench2: compose full=\0"
    var s_us: [u8; 4] = " us\0"
    var s_sm: [u8; 10] = "  small=\0\0"
    var s_sp: [u8; 13] = "  shadowpx=\0\0"
    var s_aa: [u8; 9] = "  aapx=\0\0"
    var s_sb: [u8; 12] = "  shbuild=\0\0"
    var s_r: [u8; 25] = "wmbench2: ringe   full=\0\0"
    var s_m: [u8; 25] = "wmbench2: maske   full=\0\0"
    var s_o: [u8; 25] = "wmbench2: ohne    full=\0\0"
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return
    }
    var t: u64 = apic.tsc()
    var i: u64 = 0
    while i < SOFTUI_RUNDEN {
        wm.damage_all(state)
        wm.compose(state)
        i = i + 1
    }
    let full: u64 = us_of(state, apic.tsc() - t) / SOFTUI_RUNDEN
    t = apic.tsc()
    i = 0
    while i < SOFTUI_RUNDEN {
        wm.damage(state, 300, 300, 312, 318)
        wm.compose(state)
        i = i + 1
    }
    let small: u64 = us_of(state, apic.tsc() - t) / SOFTUI_RUNDEN
    // EIN EINZIGES Bild fuer die zwei Zaehler. Ueber zwanzig Laeufe
    // gemittelt waere die Zahl durch zwanzig teilbar und nicht mehr
    // nachrechenbar; hier steht, was EIN voller Bildaufbau kostet.
    wm.paint_reset(state)
    wm.damage_all(state)
    wm.compose(state)
    serial.puts((&s_c[0]) as u64)
    serial.dec(full)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sm[0]) as u64)
    serial.dec(small)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(wm.shadow_px(state))
    serial.puts((&s_aa[0]) as u64)
    serial.dec(wm.aa_px(state))
    serial.puts((&s_sb[0]) as u64)
    serial.dec(wm.shadow_builds(state))
    serial.nl()
    // ============================== DAS VORHER UND DAS NACHHER
    //
    // BEIDE FASSUNGEN IN EINEM LAUF, auf derselben Maschine, mit
    // demselben Zeitgeber, an demselben Bild. Zwei QEMU-Starts waeren
    // zwei Maschinen; auf einem Wirt, der noch fuenf andere Abnahmen
    // traegt, sind zwei Maschinen zwei verschiedene Zahlen.
    //
    // Zuerst die Maske, dann die Ringe, dann zurueck auf die Maske --
    // die letzte Zeile stellt den Zustand wieder her, mit dem das Bild
    // aufgenommen wird.
    wm.paint_reset(state)
    t = apic.tsc()
    i = 0
    while i < SOFTUI_RUNDEN {
        wm.damage_all(state)
        wm.compose(state)
        i = i + 1
    }
    let m_us: u64 = us_of(state, apic.tsc() - t) / SOFTUI_RUNDEN
    let m_sp: u64 = wm.shadow_px(state) / SOFTUI_RUNDEN
    let m_aa: u64 = wm.aa_px(state) / SOFTUI_RUNDEN
    wm.set_shadow_old(state, true)
    wm.paint_reset(state)
    t = apic.tsc()
    i = 0
    while i < SOFTUI_RUNDEN {
        wm.damage_all(state)
        wm.compose(state)
        i = i + 1
    }
    let r_us: u64 = us_of(state, apic.tsc() - t) / SOFTUI_RUNDEN
    let r_sp: u64 = wm.shadow_px(state) / SOFTUI_RUNDEN
    let r_aa: u64 = wm.aa_px(state) / SOFTUI_RUNDEN
    wm.set_shadow_old(state, false)
    // ============================== UND DER LAUF, DER KEINEN HAT
    //
    // Die Regel dieses Baums (tools/paint/shadow.py): "Es wird IMMER
    // gegen den Lauf gemessen, der es nicht hat." Ohne diese dritte
    // Zahl sind die ersten beiden zwei Bildaufbauten, die zu neunzig
    // Hundertsteln aus dem Umkopieren von Fensterpuffern bestehen, und
    // ihr Unterschied verschwindet im Rauschen. Mit ihr steht da, was
    // der Schatten WIRKLICH kostet.
    let s1: u64 = wm.form(state, wm.FM_SHADOW)
    let s2: u64 = wm.form(state, wm.FM_SHADOW2)
    let _f1: bool = wm.set_form(state, wm.FM_SHADOW, 0)
    let _f2: bool = wm.set_form(state, wm.FM_SHADOW2, 0)
    t = apic.tsc()
    i = 0
    while i < SOFTUI_RUNDEN {
        wm.damage_all(state)
        wm.compose(state)
        i = i + 1
    }
    let o_us: u64 = us_of(state, apic.tsc() - t) / SOFTUI_RUNDEN
    let _f3: bool = wm.set_form(state, wm.FM_SHADOW, s1)
    let _f4: bool = wm.set_form(state, wm.FM_SHADOW2, s2)
    serial.puts((&s_o[0]) as u64)
    serial.dec(o_us)
    serial.puts((&s_us[0]) as u64)
    serial.nl()
    serial.puts((&s_m[0]) as u64)
    serial.dec(m_us)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(m_sp)
    serial.puts((&s_aa[0]) as u64)
    serial.dec(m_aa)
    serial.nl()
    serial.puts((&s_r[0]) as u64)
    serial.dec(r_us)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(r_sp)
    serial.puts((&s_aa[0]) as u64)
    serial.dec(r_aa)
    serial.nl()
    wm.paint_reset(state)
    wm.damage_all(state)
    wm.compose(state)
}

fn tile_conf(state: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return 0
    }
    var pfad: [u8; 31] = "/users/osum/config/tiling.conf\0"
    let ino: u64 = fs.path(state, (&pfad[0]) as u64)
    if ino == 0 {
        return 0
    }
    let n: u64 = fs.inode_size(state, ino)
    if n == 0 || n > 4000 {
        return 0
    }
    let buf: u64 = mem.frame_run(state, 1)
    if buf == 0 {
        return 0
    }
    var off: u64 = 0
    while off < n {
        var c: u64 = n - off
        if c > 4096 {
            c = 4096
        }
        let got: u64 = fs.read_at(state, ino, off, buf + off, c)
        if got == 0 {
            off = n
        } else {
            off = off + got
        }
    }
    let k: u64 = tile.bind_parse(state, buf, n)
    mem.frame_free_run(state, buf, 1)
    return k
}

fn tile_build(state: u64, n: u64, w: u64, h: u64) {
    tile.init(state, 0, 0, w, h)
    var k: u64 = 0
    while k < n {
        k = k + 1
        tile.insert(state, 0)
    }
}

fn tile_time(state: u64, n: u64, w: u64, h: u64, pruefen: bool) -> u64 {
    tile_build(state, n, w, h)
    let t: u64 = apic.tsc()
    var i: u64 = 0
    while i < TILE_RUNDEN {
        if pruefen {
            tile.check(state)
        } else {
            tile.relayout(state)
        }
        i = i + 1
    }
    return us_of(state, apic.tsc() - t)
}

// RUNDE WMPLUGIN: DER SELBSTTEST DER PLUGINTAFEL UND DIE KURZE FRIST.
//
// Der Selbsttest laeuft OHNE Bildschirm und OHNE Ring 3 -- er prueft
// dreizehn Zusagen des Moduls gegen sich selbst (falsche Fassung wird
// abgewiesen, Ring laeuft ueber ohne Schaden, Frist greift, Handlung
// ohne Recht wird gezaehlt). Er raeumt die Tafel am Ende ab.
fn wmplug_stage(state: u64) {
    if kstate.mode_on(state, kstate.M_PLUGTEST) {
        wmplug.selftest(state)
        // Der Selbsttest hat die Tafel neu aufgesetzt; ob sie offen ist,
        // entscheidet nach wie vor die Kommandozeile.
        if !kstate.mode_on(state, kstate.M_WMPLUG)
            || kstate.mode_on(state, kstate.M_PLUGAUS) {
            wmplug.set_ready(state, false)
        }
    }
    // `plugfrist`: DREI TICKS statt fuenfzig. Das ist eine ABKUERZUNG
    // FUER DEN ABNAHMELAUF und keine Vorgabe fuer den Alltag -- sie
    // steht hier, damit die Haenger-Gegenprobe in 30 ms faellt und
    // nicht in einer halben Sekunde.
    if kstate.mode_on(state, kstate.M_PLUGFRIST) {
        wmplug.set_frist(state, 3)
    }
    var s_p: [u8; 9] = "wmplug: \0"
    var s_a: [u8; 5] = "abi=\0"
    var s_s: [u8; 9] = "  tafel=\0"
    var s_f: [u8; 9] = "  frist=\0"
    var s_z: [u8; 4] = " zu\0"
    var s_o: [u8; 7] = " offen\0"
    serial.puts((&s_p[0]) as u64)
    serial.puts((&s_a[0]) as u64)
    serial.dec(wmplug.WMP_ABI)
    serial.puts((&s_s[0]) as u64)
    if wmplug.ready(state) {
        serial.puts((&s_o[0]) as u64)
    } else {
        serial.puts((&s_z[0]) as u64)
    }
    serial.puts((&s_f[0]) as u64)
    serial.dec(wmplug.frist(state))
    serial.nl()
}

fn tile_stage(state: u64, w: u64, h: u64) {
    var s_t: [u8; 7] = "tile: \0"
    var s_x: [u8; 2] = "x\0"
    var s_nd: [u8; 10] = "  nodes=\0\0"
    var s_lv: [u8; 12] = "  maxleaf=\0\0"
    var s_bd: [u8; 10] = "  binds=\0\0"
    var s_st: [u8; 11] = "selftest \0\0"
    var s_of: [u8; 4] = "/\0\0\0"
    var s_be: [u8; 20] = "tile: bench relay2=\0"
    var s_r8: [u8; 10] = "  relay8=\0"
    var s_r32: [u8; 11] = "  relay32=\0"
    var s_ck: [u8; 11] = "  check32=\0"
    var s_ns: [u8; 4] = " ns\0"
    var s_fz: [u8; 18] = "tile: fuzz ops=\0\0\0"
    var s_vi: [u8; 15] = "  violations=\0\0"
    var s_pk: [u8; 9] = "  peak=\0\0"
    var s_ch: [u8; 11] = "  checks=\0\0"
    var s_nos: [u8; 22] = "  (notiledirty: an)\0\0\0"

    serial.puts((&s_t[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_nd[0]) as u64)
    serial.dec(tile.MAX_NODES)
    serial.puts((&s_lv[0]) as u64)
    serial.dec(tile.MAX_LEAVES)
    serial.nl()

    serial.puts((&s_t[0]) as u64)
    serial.puts((&s_st[0]) as u64)
    serial.dec(tile.selftest(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(tile.selftest_max())
    var s_fb: [u8; 11] = "  failed=\0\0"
    serial.puts((&s_fb[0]) as u64)
    serial.hex(tile.failbits(state))
    serial.nl()

    // DIE TASTENBELEGUNG KOMMT NACH DEM SELBSTTEST -- der raeumt die
    // Tabelle am Ende ab, und eine Belegung, die danach leer ist, waere
    // eine, die es nur auf dem Papier gibt.
    let nb: u64 = tile_conf(state)
    serial.puts((&s_t[0]) as u64)
    serial.puts((&s_bd[0]) as u64 + 2)
    serial.dec(nb)
    serial.nl()

    if apic.tsc_hz(state) != 0 {
        let r2: u64 = tile_time(state, 2, w, h, false)
        let r8: u64 = tile_time(state, 8, w, h, false)
        let r32: u64 = tile_time(state, 32, w, h, false)
        let c32: u64 = tile_time(state, 32, w, h, true)
        serial.puts((&s_be[0]) as u64)
        serial.dec(r2)
        serial.puts((&s_ns[0]) as u64)
        serial.puts((&s_r8[0]) as u64)
        serial.dec(r8)
        serial.puts((&s_ns[0]) as u64)
        serial.puts((&s_r32[0]) as u64)
        serial.dec(r32)
        serial.puts((&s_ns[0]) as u64)
        serial.puts((&s_ck[0]) as u64)
        serial.dec(c32)
        serial.puts((&s_ns[0]) as u64)
        serial.nl()
    }

    if kstate.mode_on(state, kstate.M_TILEFUZZ) {
        tile.init(state, 0, 0, w, h)
        let v: u64 = tile.fuzz(state, 10000)
        serial.puts((&s_fz[0]) as u64)
        serial.dec(10000)
        serial.puts((&s_vi[0]) as u64)
        serial.dec(v)
        serial.puts((&s_pk[0]) as u64)
        serial.dec(tile.peak(state))
        serial.puts((&s_ch[0]) as u64)
        serial.dec(tile.checks(state))
        serial.nl()
    }

    tile.init(state, 0, 0, w, h)
    if kstate.mode_on(state, kstate.M_NOTILEDIRTY) {
        tile.set_nosub(state, true)
        serial.puts((&s_t[0]) as u64)
        serial.puts((&s_nos[0]) as u64)
        serial.nl()
    }
}

// ------------------------------------------ die drei Anordnungen fuers Foto
//
// VIER FENSTER, und zwar in einer Anordnung, die sich AUSRECHNEN laesst:
// erst waagerecht in zwei Haelften, dann jede Haelfte senkrecht. Das
// ergibt vier Kacheln zu 400x300 an den Stellen (0,0), (400,0), (0,300)
// und (400,300) -- Zahlen, die `tools/gfx/checkshot.py` Bildpunkt fuer
// Bildpunkt nachrechnen kann. Mit `tiletabs` werden aus denselben vier
// Fenstern vier REITER in einem Container, mit `tilerot` wird die
// Anordnung um eine Vierteldrehung gedreht.
fn tile_shot(state: u64, w: u64, h: u64) {
    var t1: [u8; 6] = "Eins\0\0"
    var t2: [u8; 6] = "Zwei\0\0"
    var t3: [u8; 6] = "Drei\0\0"
    var t4: [u8; 6] = "Vier\0\0"
    var s_w: [u8; 11] = "tile: win=\0"
    var s_k: [u8; 3] = " \0\0"
    var s_c: [u8; 2] = ",\0"
    var s_x: [u8; 2] = "x\0"
    var s_d: [u8; 19] = "tile: dirty split=\0"
    var s_cl: [u8; 9] = "  close=\0"
    var s_sc: [u8; 10] = "  screen=\0"
    var s_tb: [u8; 13] = "tile: tabs=\0\0"
    var s_hd: [u8; 10] = "  hidden=\0"

    let tabs: bool = kstate.mode_on(state, kstate.M_TILETABS)
    let rot: bool = kstate.mode_on(state, kstate.M_TILEROT)
    var a: u64 = wm.MAX_WIN
    var b: u64 = wm.MAX_WIN
    var c: u64 = wm.MAX_WIN
    var d: u64 = wm.MAX_WIN
    // Das Terminalfenster bleibt fuer das Foto AUSSERHALB des Baumes --
    // sonst zeigt das Bild fuenf Kacheln und die Aufgabe verlangt vier.
    // Es schwebt weiter an seinem Platz und liegt unter den vier neuen.
    var f: u64 = 0
    while f < wm.MAX_WIN {
        if wm.valid(state, f) && wm.tiled(state, f) {
            // `tile_float` und nicht `tile_release`: das Fenster soll an
            // seinen ALTEN Platz zurueck. Bliebe es dort liegen, wo der
            // Baum es hingelegt hat (ueber dem ganzen Schirm), verdeckte
            // es die Reiterzeile -- die wird unter den Fenstern gemalt,
            // weil dieser Fensterserver noch keine Ebenen kennt.
            wm.tile_float(state, f)
        }
        f = f + 1
    }
    a = wm.create(state, 0, 0, 0, w / 2, h / 2, wm.K_RAW, (&t1[0]) as u64)
    b = wm.create(state, 0, 0, 0, w / 2, h / 2, wm.K_RAW, (&t2[0]) as u64)
    c = wm.create(state, 0, 0, 0, w / 2, h / 2, wm.K_RAW, (&t3[0]) as u64)
    d = wm.create(state, 0, 0, 0, w / 2, h / 2, wm.K_RAW, (&t4[0]) as u64)
    // ERST DIE MESSUNG, DANN DAS BILD, und in dieser Reihenfolge aus
    // einem Grund: die Messung nimmt ein Fenster aus dem Baum und haengt
    // es wieder hinein, und danach steht der Baum anders da. Also wird
    // die Anordnung fuer das Foto DANACH noch einmal hergestellt. Ein
    // Foto, das eine andere Anordnung zeigt als die Zeilen darueber,
    // waere schlimmer als gar keins.
    tile_arrange(state, a, b, c, d, false)
    let paar: u64 = tile_dirty(state)
    tile_arrange(state, a, b, c, d, tabs)
    if rot {
        tile.rotate(state, tile.root(state), 1)
        wm.tile_apply(state)
    }
    wm.damage_all(state)
    // Jedes Fenster bekommt eine eigene Farbe -- das ist es, was auf dem
    // Foto nachgerechnet wird.
    tile_paint(state, a, fb.rgb(state, 0xC0, 0x30, 0x30))
    tile_paint(state, b, fb.rgb(state, 0x30, 0xB0, 0x50))
    tile_paint(state, c, fb.rgb(state, 0x30, 0x60, 0xE0))
    tile_paint(state, d, fb.rgb(state, 0xE0, 0xC0, 0x30))
    tile_say(state, a, (&s_w[0]) as u64, (&s_k[0]) as u64,
        (&s_c[0]) as u64, (&s_x[0]) as u64)
    tile_say(state, b, (&s_w[0]) as u64, (&s_k[0]) as u64,
        (&s_c[0]) as u64, (&s_x[0]) as u64)
    tile_say(state, c, (&s_w[0]) as u64, (&s_k[0]) as u64,
        (&s_c[0]) as u64, (&s_x[0]) as u64)
    tile_say(state, d, (&s_w[0]) as u64, (&s_k[0]) as u64,
        (&s_c[0]) as u64, (&s_x[0]) as u64)
    var versteckt: u64 = 0
    var k: u64 = 0
    while k < wm.MAX_WIN {
        if wm.valid(state, k) && wm.win_tabbed(state, k) {
            versteckt = versteckt + 1
        }
        k = k + 1
    }
    serial.puts((&s_tb[0]) as u64)
    serial.dec(bnum(tabs))
    serial.puts((&s_hd[0]) as u64)
    serial.dec(versteckt)
    serial.nl()
    // DIE MESSUNG, UM DIE ES GEHT: wie viele Bildpunkte kostet ein
    // Teilen, und wie viele ein Schliessen? Gemessen wird der ZAEHLER
    // des Fensterservers, nicht eine Schaetzung -- `compose` addiert die
    // Flaeche, die es wirklich zusammengesetzt hat.
    serial.puts((&s_d[0]) as u64)
    serial.dec(paar & 0xFFFFFFFF)
    serial.puts((&s_cl[0]) as u64)
    serial.dec(paar >> 32)
    serial.puts((&s_sc[0]) as u64)
    serial.dec(w * h)
    serial.nl()
}

// VIER FENSTER IN EINE BESTIMMTE ANORDNUNG BRINGEN, und zwar
// wiederholbar: erst alle vier aus dem Baum nehmen, dann in fester
// Reihenfolge wieder hinein. Erst waagerecht in zwei Haelften, dann jede
// Haelfte senkrecht -- vier Kacheln zu 400x300. Mit `tabs` wird aus der
// Wurzel ein Reitercontainer, und die beiden letzten kommen als REITER
// dazu statt zu teilen; genau das tut i3, wenn ein Fenster in einem
// Reitercontainer aufgeht.
fn tile_arrange(state: u64, a: u64, b: u64, c: u64, d: u64, tabs: bool) {
    var k: u64 = 0
    while k < wm.MAX_WIN {
        if wm.valid(state, k) {
            wm.tile_release(state, k)
        }
        k = k + 1
    }
    tile.set_next_split(state, 0)
    wm.tile_take(state, a)
    tile.set_next_split(state, 1)
    wm.tile_take(state, b)
    if tabs {
        tile.set_layout(state, tile.root(state), tile.LAY_TABBED)
        wm.tile_apply(state)
        tile.set_next_split(state, 0)
        wm.tile_take(state, c)
        tile.set_next_split(state, 0)
        wm.tile_take(state, d)
    } else {
        wm.set_focus(state, b)
        tile.set_next_split(state, 2)
        wm.tile_take(state, c)
        wm.set_focus(state, a)
        tile.set_next_split(state, 2)
        wm.tile_take(state, d)
    }
    wm.tile_apply(state)
    wm.damage_all(state)
}

fn tile_paint(state: u64, i: u64, farbe: u64) {
    if i >= wm.MAX_WIN {
        return
    }
    wm.fill(state, i, 0, 0, wm.win_w(state, i), wm.win_h(state, i), farbe)
}

fn tile_say(state: u64, i: u64, sw: u64, sk: u64, sc: u64, sx: u64) {
    if i >= wm.MAX_WIN {
        return
    }
    serial.puts(sw)
    serial.dec(i)
    serial.puts(sk)
    serial.dec(wm.win_x(state, i) as u64)
    serial.puts(sc)
    serial.dec(wm.win_y(state, i) as u64)
    serial.puts(sk)
    serial.dec(wm.outer_w(state, i))
    serial.puts(sx)
    serial.dec(wm.outer_h(state, i))
    serial.nl()
}

// Schliessen und wieder Teilen, jedes fuer sich gemessen. Der Rueckgabe
// traegt beide Zahlen: Teilen unten, Schliessen oben.
fn tile_dirty(state: u64) -> u64 {
    let f: u64 = wm.focus(state)
    if f >= wm.MAX_WIN || !wm.tiled(state, f) {
        return 0
    }
    wm.damage_all(state)
    wm.compose(state)
    let p0: u64 = wm.pixels(state)
    wm.tile_release(state, f)
    wm.compose(state)
    let close_path: u64 = wm.pixels(state) - p0
    wm.damage_all(state)
    wm.compose(state)
    let p1: u64 = wm.pixels(state)
    wm.tile_take(state, f)
    wm.compose(state)
    let auf: u64 = wm.pixels(state) - p1
    wm.damage_all(state)
    wm.compose(state)
    return (close_path << 32) | (auf & 0xFFFFFFFF)
}


// ####################################################################
// ============ RUNDE BLECHEINGABE: DER USB-BERICHT AUF DEM SCHIRM
// ####################################################################
//
// Vier Blöcke, und jeder beantwortet eine von Justins Fragen:
//
//   USB   -- wie viele Regler, Anschluesse, Geraete, wie viele Hubs,
//            wie viele Fehlschlaege. Steht hier ueberall null, war es
//            die Aufzaehlung und nicht die Tastenverarbeitung.
//   P<n>  -- JE WURZELANSCHLUSS: steckt etwas (ccs), ist er
//            freigeschaltet (en), welche Geschwindigkeit, und das rohe
//            PORTSC-Register. Ein Anschluss mit ccs=1 en=0 ist ein
//            Geraet, das der Regler sieht und nicht hochbekommt.
//   D<n>  -- JE GEFUNDENEM GERAET: Anschluss (und Hubanschluss
//            dahinter), Geschwindigkeit, Hersteller:Erzeugnis,
//            Geraeteklasse, Klasse der GEWAEHLTEN Schnittstelle, wie
//            viele Schnittstellen es hat, welche Stufen geglueckt sind
//            und welcher Treiber es genommen hat.
//   f=     -- die Stufen: 1 Adresse, 2 Deskriptor, 4 SET_CONFIGURATION
//            quittiert, 8 ein Treiber hat es genommen. f=7 ohne 8
//            heisst: der Kern hat mit dem Geraet geredet und konnte
//            nichts damit anfangen. STEHT DORT KLASSE 09, IST ES EIN
//            HUB.
//
// Jede Zeile geht in das Fenster UND auf die Leitung -- dieselben
// Oktette, damit ein Foto und ein Protokoll dasselbe sagen.
fn ub_line(state: u64, tw: u64, p: u64, n: u64) {
    kstate.set8(p + n, 10 as u8)
    wm.term_write(state, tw, p, n + 1)
    var i: u64 = 0
    while i < n {
        serial.put(kstate.get8(p + i) as u8)
        i = i + 1
    }
    serial.nl()
}

fn ub_sp(state: u64, b: u64, n: u64) -> u64 {
    var l: [u8; 2] = " \0"
    return puls_text(state, b, n, (&l[0]) as u64)
}

// Klasse:Unterklasse:Protokoll, immer sechs Zeichen -- so stehen die
// Zeilen auf einem Foto untereinander und lassen sich vergleichen.
fn ub_cls(state: u64, b: u64, n: u64, c: u64, u: u64, pr: u64) -> u64 {
    var d: [u8; 2] = ":\0"
    var m: u64 = puls_hexn(state, b, n, c, 2)
    m = puls_text(state, b, m, (&d[0]) as u64)
    m = puls_hexn(state, b, m, u, 2)
    m = puls_text(state, b, m, (&d[0]) as u64)
    return puls_hexn(state, b, m, pr, 2)
}

fn usb_bericht(state: u64, tw: u64) {
    // NULL IST EIN GUELTIGES FENSTER. `wm: term win=0` steht in jedem
    // Protokoll dieses Baums -- das Terminal ist das erste Fenster, das
    // der Kern anlegt. Eine Pruefung auf `== 0` haette den ganzen
    // Bericht verschluckt, und genau das tat sie im ersten Lauf.
    if tw >= wm.MAX_WIN {
        return
    }
    var b: [u8; 128] = [0 as u8; 128]
    let p: u64 = (&b[0]) as u64

    var t_h: [u8; 6] = "USB  \0"
    var t_hc: [u8; 5] = "hc=\0\0"
    var t_po: [u8; 8] = " ports=\0"
    var t_de: [u8; 6] = " dev=\0"
    var t_fu: [u8; 7] = " fund=\0"
    var t_hb: [u8; 7] = " hubs=\0"
    var t_hp: [u8; 8] = " hbprt=\0"
    var t_fa: [u8; 8] = " fails=\0"
    var n: u64 = 0
    n = puls_text(state, p, 0, (&t_h[0]) as u64)
    n = puls_text(state, p, n, (&t_hc[0]) as u64)
    n = pulse_num(state, p, n, xhci.count_hc(state))
    n = puls_text(state, p, n, (&t_po[0]) as u64)
    n = pulse_num(state, p, n, xhci.ports(state))
    n = puls_text(state, p, n, (&t_de[0]) as u64)
    n = pulse_num(state, p, n, usb.count(state))
    n = puls_text(state, p, n, (&t_fu[0]) as u64)
    n = pulse_num(state, p, n, usb.fund_count(state))
    n = puls_text(state, p, n, (&t_hb[0]) as u64)
    n = pulse_num(state, p, n, usb.hubs(state))
    n = puls_text(state, p, n, (&t_hp[0]) as u64)
    n = pulse_num(state, p, n, usb.hubports(state))
    n = puls_text(state, p, n, (&t_fa[0]) as u64)
    n = pulse_num(state, p, n, usb.fails(state))
    ub_line(state, tw, p, n)

    // ---- je Wurzelanschluss ----
    var t_p: [u8; 4] = " P\0\0"
    var t_c: [u8; 6] = " ccs=\0"
    var t_e: [u8; 5] = " en=\0"
    var t_s: [u8; 5] = " sp=\0"
    var t_r: [u8; 7] = " psc=\0\0"
    let np: u64 = xhci.ports(state)
    var i: u64 = 1
    while i <= np && i < 32 {
        n = puls_text(state, p, 0, (&t_p[0]) as u64)
        n = pulse_num(state, p, n, i)
        n = puls_text(state, p, n, (&t_c[0]) as u64)
        n = pulse_num(state, p, n, ja1(xhci.port_connected(state, i)))
        n = puls_text(state, p, n, (&t_e[0]) as u64)
        n = pulse_num(state, p, n, ja1(xhci.port_enabled(state, i)))
        n = puls_text(state, p, n, (&t_s[0]) as u64)
        n = pulse_num(state, p, n, xhci.port_speed(state, i))
        n = puls_text(state, p, n, (&t_r[0]) as u64)
        n = puls_hexn(state, p, n, xhci.portsc(state, i), 8)
        ub_line(state, tw, p, n)
        i = i + 1
    }

    // ---- je gefundenem Geraet ----
    var t_d: [u8; 4] = " D\0\0"
    var t_at: [u8; 3] = " @\0"
    var t_dot: [u8; 2] = ".\0"
    var t_id: [u8; 5] = " id=\0"
    var t_dc: [u8; 6] = " dev=\0"
    var t_if: [u8; 5] = " if=\0"
    var t_nn: [u8; 4] = " n=\0"
    var t_ff: [u8; 4] = " f=\0"
    var t_dr: [u8; 6] = " drv=\0"
    var t_leer: [u8; 24] = " KEIN EINZIGES GERÄT!\0\0"
    let nf: u64 = usb.fund_count(state)
    if nf == 0 {
        n = puls_text(state, p, 0, (&t_leer[0]) as u64)
        ub_line(state, tw, p, n)
    }
    i = 0
    while i < nf {
        n = puls_text(state, p, 0, (&t_d[0]) as u64)
        n = pulse_num(state, p, n, i)
        n = puls_text(state, p, n, (&t_at[0]) as u64)
        n = pulse_num(state, p, n, usb.fund_port(state, i))
        n = puls_text(state, p, n, (&t_dot[0]) as u64)
        n = pulse_num(state, p, n, usb.fund_hub(state, i))
        n = puls_text(state, p, n, (&t_s[0]) as u64)
        n = pulse_num(state, p, n, usb.fund_speed(state, i))
        n = puls_text(state, p, n, (&t_id[0]) as u64)
        n = puls_hexn(state, p, n, usb.fund_vid(state, i), 4)
        n = puls_text(state, p, n, (&t_dot[0]) as u64)
        n = puls_hexn(state, p, n, usb.fund_pid(state, i), 4)
        n = puls_text(state, p, n, (&t_dc[0]) as u64)
        n = ub_cls(state, p, n, usb.fund_dcls(state, i),
            usb.fund_dsub(state, i), usb.fund_dpro(state, i))
        n = puls_text(state, p, n, (&t_if[0]) as u64)
        n = ub_cls(state, p, n, usb.fund_icls(state, i),
            usb.fund_isub(state, i), usb.fund_ipro(state, i))
        n = puls_text(state, p, n, (&t_nn[0]) as u64)
        n = pulse_num(state, p, n, usb.fund_ifaces(state, i))
        n = puls_text(state, p, n, (&t_ff[0]) as u64)
        n = pulse_num(state, p, n, usb.fund_flags(state, i))
        n = puls_text(state, p, n, (&t_dr[0]) as u64)
        n = pulse_num(state, p, n, usb.fund_driver(state, i))
        ub_line(state, tw, p, n)
        i = i + 1
    }
}

fn ja1(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

// ==================================================== RUNDE PROTOKOLL
// DER PANIK-BILDSCHIRM, UND DIE EINZIGE ERLAUBTE AUSNAHME VON DER
// wlib-REGEL DIESES PROJEKTS.
//
// DIE REGEL: alles, was ein Mensch sieht, entsteht in Ring 3 und geht
// durch `wlib`. Der Kern malt nicht. Das ist keine Stilfrage -- es ist
// der Grund, aus dem es in diesem System genau EINE Stelle gibt, an der
// eine Oberflaeche entsteht, und damit genau eine Stelle, an der man sie
// aendern muss.
//
// DIE AUSNAHME, UND WARUM SIE UNVERMEIDLICH IST. Ein Panik-Bildschirm
// wird gebraucht, WENN DER KERN GESTORBEN IST. In diesem Augenblick:
//
//   * laeuft kein Prozess mehr weiter -- der Ablaufplaner wird nie
//     wieder aufgerufen, also kann kein Programm in Ring 3 etwas malen;
//   * ist der Fensterserver moeglicherweise genau das, was kaputt ist
//     (Justins Absturz von Runde STARTKNOPF kam aus `wm.fi`);
//   * darf keine Sperre mehr genommen werden -- ein anderer Kern kann
//     sie halten, und er kommt nie mehr dazu, sie herzugeben;
//   * gibt es keinen Rahmenverwalter mehr, dem man einen Puffer
//     abfragen koennte.
//
// Ein Panik-Bildschirm ueber `wlib` waere also ein Panik-Bildschirm,
// der genau dann nicht erscheint, wenn er gebraucht wird. Deshalb malt
// DIESE Funktion unmittelbar in den Rahmenpuffer, mit dem Textmodus,
// den `fb.fi` seit Runde K7 ohnehin hat: `fb.clear`, `fb.putc`,
// `fb.flush`. Kein Fenster, kein Server, keine Sperre, keine Zuteilung.
//
// UND SIE IST DIE EINZIGE. Es gibt in diesem Kern keine zweite Stelle,
// die ohne `wlib` etwas Sichtbares erzeugt; die Messtafel am oberen
// Rand (Runde BLECHDREI) geht ueber `wm.messzeile` und damit ueber den
// Fensterserver.
//
// WAS DRAUFSTEHT, in dieser Reihenfolge und aus diesem Grund:
//
//   1. WAS  -- Vektor, Name, Fehlercode, Kernnummer. Die erste Frage.
//   2. WO   -- rip, aufgeloest zu Name+Versatz (Datei:Zeile). Bis zu
//              dieser Runde stand hier eine nackte Zahl.
//   3. WOMIT-- alle sechzehn Register. Sie sind die einzige Chance,
//              einen Zeigerfehler ohne Nachbau zu erkennen.
//   4. WOHER-- die Rueckverfolgung, aufgeloest.
//   5. WAS VORHER WAR -- die letzten Zeilen des Kernprotokolls. Auf
//              einem Brett ohne serielle Leitung ist das die einzige
//              Stelle, an der die Treiberausgaben je sichtbar werden.
//   6. WO ES SPAETER STEHT -- der Pfad des Berichts auf der Platte.
//
// Reicht der Schirm nicht fuer alle Protokollzeilen, wird ABGESCHNITTEN
// UND GESAGT, dass abgeschnitten wurde. Der vollstaendige Text liegt in
// /var/crash.
const PB_HEADER: u64 = 3 // Zeilen bis zum ersten Register

fn pb_dec(state: u64, v: u64) {
    var t: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        t[0 as usize] = 48 as u8
        n = 1
    }
    while x > 0 {
        t[n as usize] = (48 + (x % 10)) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        fb.putc(state, t[(n - 1) as usize] as u64)
        n = n - 1
    }
}

fn pb_hex(state: u64, v: u64, w: u64) {
    fb.putc(state, 48)
    fb.putc(state, 120)
    var i: u64 = w
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * 4)) & 15
        if d < 10 {
            fb.putc(state, 48 + d)
        } else {
            fb.putc(state, 87 + d)
        }
    }
}

fn pb_str(state: u64, p: u64) {
    if p == 0 {
        return
    }
    fb.puts(state, p)
}

// Eine Adresse als `Name+Versatz (Datei:Zeile)`. Ohne Symboltabelle
// bleibt die rohe Zahl -- aermer, nicht falsch.
fn pb_addr(state: u64, a: u64) {
    var s_plus: [u8; 2] = "+\0"
    var s_ob: [u8; 3] = " (\0"
    var s_co: [u8; 2] = ":\0"
    var s_cb: [u8; 2] = ")\0"
    let i: u64 = ksymtab.resolve(a)
    if i >= ksymtab.n_sym() {
        pb_hex(state, a, 16)
        return
    }
    pb_str(state, ksymtab.sym_name(i))
    pb_str(state, (&s_plus[0 as usize]) as u64)
    pb_hex(state, a - ksymtab.sym_addr(i), 4)
    let pk: u64 = ksymtab.line_of(a)
    if pk == 0 {
        return
    }
    let f: u64 = ksymtab.file_name(ksymtab.line_file(pk))
    if f == 0 {
        return
    }
    pb_str(state, (&s_ob[0 as usize]) as u64)
    pb_str(state, f)
    pb_str(state, (&s_co[0 as usize]) as u64)
    pb_dec(state, ksymtab.line_nr(pk))
    pb_str(state, (&s_cb[0 as usize]) as u64)
}

fn panikbild(state: u64, vec: u64, err: u64, rip: u64, cr2: u64,
        rsp: u64, cs: u64, flg: u64, ss: u64, kern: u64, regs: u64,
        spur: u64, spurn: u64, datei: u64) {
    var namen: [u8; 128] = "#DE\0#DB\0NMI\0#BP\0#OF\0#BR\0#UD\0#NM\0#DF\0#CO\0#TS\0#NP\0#SS\0#GP\0#PF\0r15\0#MF\0#AC\0#MC\0#XM\0#VE\0#CP\0r22\0r23\0r24\0r25\0r26\0#HV\0#VC\0#SX\0r30\0r31\0"
    var rnamen: [u8; 64] = "rax\0rbx\0rcx\0rdx\0rsi\0rdi\0rbp\0rsp\0r8 \0r9 \0r10\0r11\0r12\0r13\0r14\0r15\0"
    var s_kopf: [u8; 27] = "*** OSUM  KERNEL-PANIK ***\0"
    var s_vek: [u8; 8] = "  VEK \0\0"
    var s_err: [u8; 8] = "  ERR \0\0"
    var s_krn: [u8; 9] = "  KERN \0\0"
    var s_rip: [u8; 6] = "RIP \0\0"
    var s_cr2: [u8; 8] = "  CR2 \0\0"
    var s_cs: [u8; 7] = "  CS \0\0"
    var s_flg: [u8; 8] = "  FLG \0\0"
    var s_rsp: [u8; 7] = "RSP \0\0\0"
    var s_ss: [u8; 7] = "  SS \0\0"
    var s_spur: [u8; 15] = "-- RUECKSPUR\0\0\0"
    var s_prot: [u8; 15] = "-- PROTOKOLL\0\0\0"
    var s_ber: [u8; 12] = "-- BERICHT\0\0"
    var s_kb: [u8; 14] = "-- (keiner)\0\0\0"
    var s_ab: [u8; 20] = "  ... abgeschnitten\0"
    var s_foto: [u8; 43] = "*** BITTE FOTOGRAFIEREN -- Maschine steht\0\0"
    var s_sp: [u8; 3] = "  \0"
    var s_gl: [u8; 2] = "=\0"

    if !fb.ready(state) {
        return
    }
    // ROT UND WEISS, und der ganze Schirm. Ein Panik-Bildschirm, der
    // aussieht wie das System, ist ein Panik-Bildschirm, den man
    // uebersieht.
    let rot: u64 = fb.rgb(state, 128, 0, 0)
    let weiss: u64 = fb.rgb(state, 255, 255, 255)
    let gelb: u64 = fb.rgb(state, 255, 220, 80)
    fb.clear(state, rot)
    fb.set_color(state, weiss, rot)
    fb.home(state)

    pb_str(state, (&s_kopf[0 as usize]) as u64)
    pb_str(state, (&s_vek[0 as usize]) as u64)
    pb_dec(state, vec)
    fb.putc(state, 32)
    if vec < 32 {
        pb_str(state, (&namen[0 as usize]) as u64 + vec * 4)
    }
    pb_str(state, (&s_err[0 as usize]) as u64)
    pb_hex(state, err, 8)
    pb_str(state, (&s_krn[0 as usize]) as u64)
    pb_dec(state, kern)
    fb.nl(state)
    pb_str(state, version.text())
    fb.nl(state)

    // WO. Die Zeile, um die es geht.
    pb_str(state, (&s_rip[0 as usize]) as u64)
    pb_addr(state, rip)
    fb.nl(state)
    pb_str(state, (&s_rsp[0 as usize]) as u64)
    pb_hex(state, rsp, 16)
    pb_str(state, (&s_cs[0 as usize]) as u64)
    pb_hex(state, cs, 4)
    pb_str(state, (&s_ss[0 as usize]) as u64)
    pb_hex(state, ss, 4)
    pb_str(state, (&s_flg[0 as usize]) as u64)
    pb_hex(state, flg, 8)
    // CR2 GILT NUR BEI #PF. Dieselbe Regel wie in der Messtafel, und
    // aus demselben Grund (Runde STARTKNOPF, eine Stunde Fehlsuche).
    if vec == 14 {
        pb_str(state, (&s_cr2[0 as usize]) as u64)
        pb_hex(state, cr2, 16)
    }
    fb.nl(state)

    // WOMIT.
    var i: u64 = 0
    while i < 16 {
        pb_str(state, (&rnamen[0 as usize]) as u64 + i * 4)
        pb_str(state, (&s_gl[0 as usize]) as u64)
        pb_hex(state, __mmio_read64((regs + i * 8) as *mut u64), 16)
        if i % 4 == 3 {
            fb.nl(state)
        } else {
            pb_str(state, (&s_sp[0 as usize]) as u64)
        }
        i = i + 1
    }

    // WOHER.
    fb.set_color(state, gelb, rot)
    pb_str(state, (&s_spur[0 as usize]) as u64)
    fb.nl(state)
    fb.set_color(state, weiss, rot)
    if spurn == 0 {
        pb_str(state, (&s_kb[0 as usize]) as u64)
        fb.nl(state)
    }
    i = 0
    while i < spurn {
        pb_str(state, (&s_sp[0 as usize]) as u64)
        pb_addr(state, __mmio_read64((spur + i * 8) as *mut u64))
        fb.nl(state)
        i = i + 1
    }

    // WAS VORHER WAR. So viele Zeilen, wie noch auf den Schirm gehen --
    // zwei bleiben fuer den Bericht und die Bitte um das Foto frei.
    fb.set_color(state, gelb, rot)
    pb_str(state, (&s_prot[0 as usize]) as u64)
    fb.nl(state)
    fb.set_color(state, weiss, rot)
    let rows: u64 = fb.rows(state)
    var free: u64 = 0
    if rows > fb.cy(state) + 3 {
        free = rows - fb.cy(state) - 3
    }
    let last: u64 = klog.seq(state)
    var von: u64 = 1
    if last > free {
        von = last - free + 1
    }
    if von < klog.first_seq(state) {
        von = klog.first_seq(state)
    }
    if last > 0 && last >= von {
        // Steht mehr im Ring, als auf den Schirm passt, sagt das die
        // erste Zeile -- der ganze Text liegt in /var/crash.
        if von > klog.first_seq(state) {
            pb_str(state, (&s_ab[0 as usize]) as u64)
            fb.nl(state)
        }
        var b: [u8; 200] = [0 as u8; 200]
        var sq: u64 = von
        while sq <= last {
            let n: u64 = klog.line_at(state, sq,
                (&b[0 as usize]) as u64, 199)
            if n > 1 {
                // Ohne das Zeilenende: `fb.nl` macht den Umbruch.
                fb.text(state, (&b[0 as usize]) as u64, n - 1)
                fb.nl(state)
            }
            sq = sq + 1
        }
    }

    // WO ES SPAETER STEHT.
    fb.set_color(state, gelb, rot)
    pb_str(state, (&s_ber[0 as usize]) as u64)
    fb.putc(state, 32)
    if datei != 0 {
        pb_str(state, datei)
    } else {
        pb_str(state, (&s_kb[0 as usize]) as u64)
    }
    fb.nl(state)
    pb_str(state, (&s_foto[0 as usize]) as u64)
    fb.nl(state)
    fb.flush(state)
}
