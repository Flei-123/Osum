fn halt_secs(state: u64) -> u64 {
    let h: u64 = pmon.wighalt(state)
    if h != 0 {
        return h
    }
    if kstate.mode_on(state, kstate.M_WIGLONG) {
        return 20
    }
    return 5
}

fn bool_num(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

// MAXIMIZE THE TOPMOST ORDINARY WINDOW AND SAY WHAT CAME OF IT. The
// point of the exercise is the pair of rectangles that follows: the
// window that fills the work area, and the bar that owns the edge. If
// the strut works they touch and do not overlap; with `nostrut` the
// window is the whole screen and the bar is under it.
fn say_max(state: u64) {
    var s_a: [u8; 16] = "wm: max win=\0\0\0\0"
    var s_b: [u8; 6] = " ok=\0\0"
    var s_c: [u8; 6] = " wx=\0\0"
    var s_d: [u8; 6] = " wy=\0\0"
    var s_e: [u8; 6] = " ww=\0\0"
    var s_f: [u8; 6] = " wh=\0\0"
    var s_t: [u8; 10] = "Maximized\0"
    // A WINDOW OF ITS OWN AND NOT THE ONE THAT HAPPENS TO BE ON TOP.
    // The first version maximized the topmost application window and
    // got `ok=0` every time, for a reason worth keeping: a window keeps
    // the buffer it was created with, the starter asked for 440 x 300,
    // and 796 x 568 does not fit into it. That is the server refusing
    // to lie, not a defect -- so the measurement gets a window that was
    // created large enough, and the refusal keeps its meaning.
    let i: u64 = wm.create(state, 0, 0, 0, wm.max_w(state),
        wm.max_h(state), wm.K_RAW,
        (&s_t[0]) as u64)
    if i >= wm.MAX_WIN {
        return
    }
    wm.fill(state, i, 0, 0, wm.max_w(state), wm.max_h(state),
        fb.rgb(state, 0x24, 0x50, 0x30))
    let ok: bool = wm.maximize(state, i, true)
    wm.damage_all(state)
    wm.compose(state)
    serial.puts((&s_a[0]) as u64)
    serial.dec(i)
    serial.puts((&s_b[0]) as u64)
    serial.dec(bnum(ok))
    serial.puts((&s_c[0]) as u64)
    serial.dec(wm.work_x(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(wm.work_y(state))
    serial.puts((&s_e[0]) as u64)
    serial.dec(wm.work_w(state))
    serial.puts((&s_f[0]) as u64)
    serial.dec(wm.work_h(state))
    serial.nl()
}

//   wm: win nr=<platz> id=<nummer> z=<stufe> layer=<ebene> hidden=<0/1>
//       deco=<0/1> x= y= w= h= focus=<0/1> t=[<titel>]
fn say_wins(state: u64) {
    var s_a: [u8; 12] = "wm: win nr=\0"
    var s_b: [u8; 6] = " id=\0\0"
    var s_c: [u8; 5] = " z=\0\0"
    var s_d: [u8; 9] = " layer=\0\0"
    var s_e: [u8; 10] = " hidden=\0\0"
    var s_f: [u8; 8] = " deco=\0\0"
    var s_g: [u8; 5] = " x=\0\0"
    var s_h: [u8; 5] = " y=\0\0"
    var s_i: [u8; 5] = " w=\0\0"
    var s_j: [u8; 5] = " h=\0\0"
    var s_k: [u8; 9] = " focus=\0\0"
    var s_l: [u8; 6] = " t=[\0\0"
    var s_m: [u8; 4] = "]\0\0\0"
    var s_n: [u8; 16] = "wm: wins n=\0\0\0\0\0"
    var s_o: [u8; 10] = " hides=\0\0\0"
    var s_p: [u8; 10] = " shows=\0\0\0"
    var s_q: [u8; 12] = " nolayer=\0\0\0"
    var s_r: [u8; 10] = " nomin=\0\0\0"
    var s_s1: [u8; 8] = " strut=\0"
    var s_s2: [u8; 12] = " strutedge=\0"
    var s_s3: [u8; 6] = " max=\0"
    var s_s4: [u8; 6] = " ow=\0\0"
    var s_s5: [u8; 6] = " oh=\0\0"
    var s_w1: [u8; 16] = "wm: work x=\0\0\0\0\0"
    var i: u64 = 0
    while i < wm.MAX_WIN {
        if wm.valid(state, i) {
            serial.puts((&s_a[0]) as u64)
            serial.dec(i)
            serial.puts((&s_b[0]) as u64)
            serial.dec(wm.win_id(state, i))
            serial.puts((&s_c[0]) as u64)
            serial.dec(wm.win_z(state, i))
            serial.puts((&s_d[0]) as u64)
            serial.dec(wm.win_layer(state, i))
            serial.puts((&s_e[0]) as u64)
            serial.dec(bnum(wm.win_hidden(state, i)))
            serial.puts((&s_f[0]) as u64)
            serial.dec(bnum(wm.win_deco(state, i)))
            serial.puts((&s_g[0]) as u64)
            serial.dec(wm.win_x(state, i) as u64)
            serial.puts((&s_h[0]) as u64)
            serial.dec(wm.win_y(state, i) as u64)
            serial.puts((&s_i[0]) as u64)
            serial.dec(wm.win_w(state, i))
            serial.puts((&s_j[0]) as u64)
            serial.dec(wm.win_h(state, i))
            serial.puts((&s_k[0]) as u64)
            serial.dec(bnum(wm.focus(state) == i))
            serial.puts((&s_s1[0]) as u64)
            serial.dec(wm.win_strut_size(state, i))
            serial.puts((&s_s2[0]) as u64)
            serial.dec(wm.win_strut_edge(state, i))
            serial.puts((&s_s3[0]) as u64)
            serial.dec(bnum(wm.is_max(state, i)))
            serial.puts((&s_s4[0]) as u64)
            serial.dec(wm.outer_w(state, i))
            serial.puts((&s_s5[0]) as u64)
            serial.dec(wm.outer_h(state, i))
            serial.puts((&s_l[0]) as u64)
            serial.puts(wm.win_title(state, i))
            serial.puts((&s_m[0]) as u64)
            serial.nl()
        }
        i = i + 1
    }
    serial.puts((&s_n[0]) as u64)
    serial.dec(wm.count(state))
    serial.puts((&s_o[0]) as u64)
    serial.dec(wm.hides(state))
    serial.puts((&s_p[0]) as u64)
    serial.dec(wm.shows(state))
    serial.puts((&s_q[0]) as u64)
    serial.dec(bnum(wm.nolayer(state)))
    serial.puts((&s_r[0]) as u64)
    serial.dec(bnum(wm.nomin(state)))
    serial.nl()
    // THE WORK AREA, from the server itself. The taskbar says the same
    // thing from ring 3 (`taskbar: work`); the two lines must agree,
    // and the runner checks that they do.
    serial.puts((&s_w1[0]) as u64)
    serial.dec(wm.work_x(state))
    serial.puts((&s_h[0]) as u64)
    serial.dec(wm.work_y(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(wm.work_w(state))
    serial.puts((&s_j[0]) as u64)
    serial.dec(wm.work_h(state))
    serial.puts((&s_q[0]) as u64)
    serial.dec(bnum(wm.nostrut(state)))
    serial.nl()
}

//     wigapp=/bin/taskmgr,melde,takt,300
static mut wg_path: [u8; 64] = [0 as u8; 64]
static mut wg_args: [u8; 128] = [0 as u8; 128]
static mut wg_len: u64 = 0 // belegte Oktette in wg_args
static mut wg_argc: u64 = 0
static mut wg_da: u64 = 0

fn wigapp_zerlegen(state: u64) {
    wg_da = 0
    wg_len = 0
    wg_argc = 0
    let wa: u64 = pmon.wigapp(state)
    if wa == 0 {
        return
    }
    var slash: u64 = 0
    var kommas: u64 = 0
    var wargs: u64 = 0
    var wi: u64 = 0
    while wi < 63 && kstate.get8(wa + wi) != 0 {
        var c: u64 = kstate.get8(wa + wi)
        if c == 44 {
            c = 0
            kommas = kommas + 1
            if wargs == 0 {
                wargs = wi + 1
            }
        }
        wg_path[wi as usize] = c as u8
        if c == 47 && wargs == 0 {
            slash = wi + 1
        }
        wi = wi + 1
    }
    var wj: u64 = 0
    while wj < 31 && wg_path[(slash + wj) as usize] != 0 as u8 {
        wg_args[wj as usize] = wg_path[(slash + wj) as usize]
        wj = wj + 1
    }
    if wj == 0 {
        return
    }
    wg_args[wj as usize] = 0 as u8
    wg_len = wj + 1
    wg_argc = 1
    wg_da = 1
    if wargs == 0 {
        return
    }
    var wp: u64 = wargs
    while wp < 63 && wg_path[wp as usize] != 0 as u8 && wg_len < 120 {
        var wl: u64 = 0
        while wp + wl < 63 && wg_path[(wp + wl) as usize] != 0 as u8
              && wg_len < 120 {
            wg_args[wg_len as usize] = wg_path[(wp + wl) as usize]
            wg_len = wg_len + 1
            wl = wl + 1
        }
        wg_args[wg_len as usize] = 0 as u8
        wg_len = wg_len + 1
        wg_argc = wg_argc + 1
        wp = wp + wl + 1
    }
}

static mut log_open: u64 = 0

// ====================================== SERVICE LOG (r-svclog, 10.10.2026)
// SERVICES KEEP THEIR LOG FOR THEIR CHILDREN; THE TERMINAL WINDOW GETS NOTHING.
//
// Dell photo: the terminal window showed `fetch: ...` lines all the time. Cause
// (read in the code, `file.inherit_std`): `ota` is started by the desktop and has
// the log terminal on fd 1/2 -- but whatever a service starts with `elf.spawn`
// (`ota` -> `/bin/fetch` every 30 s while there is no network) gets the CONSOLE
// entries instead, and the console is the terminal window (SINK_WINDOW).
//
// The swap in `inherit_std` is right for a `sh` started from the start menu. It is
// wrong for a service. So services (dhcp, jarvisd, ota, sntp) get a SECOND log
// terminal (same sink: the serial line): `inherit_std` only swaps the first one
// (`kstate.LOGOPEN`), a descendant of a service therefore inherits the service log
// unchanged -- fork, spawn and exec alike. Boot word `svccon` switches back to the
// old behaviour (control sample).
static mut svc_open: [u64; 4] = [0; 4]
// r-svclog2: the service logs also go to /var/log/<service>.log (ota, sntp, dhcp; jarvisd keeps its own file).
// `svclogmax=<octets>` (boot word) is the size at which a file rotates to <name>.1; 0 = no files (control).
static mut svc_max: u64 = 65536
static mut svc_next: u64 = 0
static mut jv_pid: u64 = 0 // task SLOT of the helper (`elf.spawn` returns the slot, not the pid)
static mut jv_tpid: u64 = 0 // its real process number, read at the spawn: the stamp of this incarnation
static mut jv_born: u64 = 0
static mut jv_next: u64 = 0
// r147: respawn watch of the social service (0) and the Melder (1), see sv2_watch
static mut sv2_slot: [u64; 2] = [0 as u64; 2]
static mut sv2_tpid: [u64; 2] = [0 as u64; 2]
static mut sv2_born: [u64; 2] = [0 as u64; 2]
static mut sv2_next: [u64; 2] = [0 as u64; 2]
static mut sv2_wait: [u64; 2] = [0 as u64; 2] // back-off in ticks, 0 = not set yet (500)
static mut sv2_armed: [u64; 2] = [0 as u64; 2]
static mut sv2_n: [u64; 2] = [0 as u64; 2] // starts so far (the first one included)
static mut so_killafter: u64 = 0
static mut jv_wait: u64 = 500
static mut jv_armed: u64 = 0
static mut jv_dbg: u64 = 0
// `jvnoname`: control sample -- the watch looks the SLOT up as a process number (`find_pid`, the original mistake) and does
// not compare the stamp: it watches whichever task carries that number, so the end of the helper goes unnoticed.
static mut jv_noname: u64 = 0
static mut jv_killafter: u64 = 0
static mut svc_mode: u64 = 0

fn log_open_get(state: u64, svc: bool, sid: u64) -> u64 {
    if svc {
        if svc_open[sid as usize] == 0 {
            let t: u64 = tty.alloc_log_svc(state, sid)
            if t >= tty.MAX_TTY {
                return 0
            }
            let of: u64 = file.open_alloc(state, file.K_TTY, t, 1)
            if of >= file.MAX_OPEN {
                return 0
            }
            svc_open[sid as usize] = of
            var s_p: [u8; 18] = "desk: svclog tty=\0"
            var s_o: [u8; 5] = " of=\0"
            serial.puts((&s_p[0]) as u64)
            serial.dec(t)
            serial.puts((&s_o[0]) as u64)
            serial.dec(of)
            serial.nl()
        }
        return svc_open[sid as usize]
    }
    if log_open == 0 {
        let t: u64 = tty.alloc_log(state)
        if t >= tty.MAX_TTY {
            return 0
        }
        // 1 = O_WRONLY (sys.fi) -- `kgui` must not import `sys`.
        let of: u64 = file.open_alloc(state, file.K_TTY, t, 1)
        if of >= file.MAX_OPEN {
            return 0
        }
        log_open = of
        kstate.set(state, kstate.LOGOPEN, of)
        var s_p: [u8; 21] = "desk: protokoll tty=\0"
        var s_o: [u8; 5] = " of=\0"
        serial.puts((&s_p[0]) as u64)
        serial.dec(t)
        serial.puts((&s_o[0]) as u64)
        serial.dec(of)
        serial.nl()
    }
    return log_open
}

fn protokoll_binden(state: u64, task: u64) {
    if task == 0 {
        return
    }
    let svc: bool = svc_mode != 0 && !kstate.mode_on(state, kstate.M_SVCCON)
    var sid: u64 = 0
    if svc {
        sid = svc_mode - 1
    }
    let lo: u64 = log_open_get(state, svc, sid)
    if lo == 0 {
        return
    }
    // With interrupts off: the child must not write its first line before its
    // fd 1 is re-pointed.
    let fl: u64 = sched.irq_save()
    var fd: u64 = 1
    while fd < 3 {
        file.open_ref(state, lo)
        file.fd_free(state, task, fd)
        if !file.fd_set(state, task, fd, lo) {
            file.open_unref(state, lo)
        }
        fd = fd + 1
    }
    sched.irq_restore(fl)
}

// Start a SERVICE of the desktop (log stays with the service and its children).
// `sid`: 0 ota, 1 sntp, 2 dhcp, 3 jarvisd (its own log ring and terminal; the file is written by the service).
fn desk_spawn_svc(state: u64, sid: u64, path: u64, arg: u64, n: u64, argc: u64) -> u64 {
    svc_mode = sid + 1
    let pid: u64 = desk_spawn_n(state, path, arg, n, argc)
    svc_mode = 0
    return pid
}

// `svclogmax=<octets>`: size limit of /var/log/<service>.log (see svc_flush).
fn svc_parse(cmd: u64) {
    var wn: [u8; 9] = "jvnoname\0"
    var in0: u64 = 0
    while in0 < 4096 && kstate.get8(cmd + in0) != 0 {
        var kn: u64 = 0
        while kn < 8 && kstate.get8(cmd + in0 + kn) == (wn[kn as usize] as u64) {
            kn = kn + 1
        }
        if kn == 8 {
            jv_noname = 1
        }
        in0 = in0 + 1
    }
    var w: [u8; 11] = "svclogmax=\0"
    var i: u64 = 0
    while i < 4096 && kstate.get8(cmd + i) != 0 {
        var k: u64 = 0
        while k < 10 && kstate.get8(cmd + i + k) == (w[k as usize] as u64) {
            k = k + 1
        }
        if k == 10 {
            var v: u64 = 0
            var j: u64 = i + 10
            var n: u64 = 0
            while n < 9 && kstate.get8(cmd + j) >= 48 && kstate.get8(cmd + j) <= 57 {
                v = v * 10 + (kstate.get8(cmd + j) - 48)
                j = j + 1
                n = n + 1
            }
            svc_max = v
            return
        }
        i = i + 1
    }
}

// Copy the name of the log file of service `sid` to `dst` ("/var/log/ota.log", or "...log.1" when `old`).
fn svc_name(sid: u64, old: bool, dst: u64) {
    var a: [u8; 18] = "/var/log/ota.log\0\0"
    var b: [u8; 18] = "/var/log/sntp.log\0"
    var c: [u8; 18] = "/var/log/dhcp.log\0"
    var i: u64 = 0
    var done: bool = false
    while i < 18 && !done {
        var ch: u64 = a[i as usize] as u64
        if sid == 1 {
            ch = b[i as usize] as u64
        }
        if sid == 2 {
            ch = c[i as usize] as u64
        }
        if ch == 0 {
            done = true
        } else {
            kstate.set8(dst + i, ch as u8)
            i = i + 1
        }
    }
    if old {
        kstate.set8(dst + i, 46)
        kstate.set8(dst + i + 1, 49)
        i = i + 2
    }
    kstate.set8(dst + i, 0)
}

// Append `n` octets at `src` to the log file of service `sid`; rotate to <name>.1 when it would pass `svc_max`.
fn svc_append(state: u64, sid: u64, src: u64, n: u64) {
    var p: [u8; 24] = [0; 24]
    var q: [u8; 24] = [0; 24]
    svc_name(sid, false, (&p[0]) as u64)
    svc_name(sid, true, (&q[0]) as u64)
    var ino: u64 = fs.path(state, (&p[0]) as u64)
    if ino == 0 {
        var d1: [u8; 5] = "/var\0"
        var d2: [u8; 9] = "/var/log\0"
        if fs.path(state, (&d1[0]) as u64) == 0 {
            let _a: u64 = fs.create_path(state, (&d1[0]) as u64, fs.T_DIR)
        }
        if fs.path(state, (&d2[0]) as u64) == 0 {
            let _b: u64 = fs.create_path(state, (&d2[0]) as u64, fs.T_DIR)
        }
        ino = fs.create_path(state, (&p[0]) as u64, fs.T_FILE)
        if ino == 0 {
            return
        }
    }
    var size: u64 = fs.inode_size(state, ino)
    if size + n > svc_max {
        let _u: bool = fs.unlink_path(state, (&q[0]) as u64)
        let _r: u64 = fs.rename_path(state, (&p[0]) as u64, (&q[0]) as u64)
        ino = fs.create_path(state, (&p[0]) as u64, fs.T_FILE)
        if ino == 0 {
            return
        }
        size = 0
    }
    let _w: u64 = fs.write_at(state, ino, size, src, n)
}

// Once a second (desktop loop): drain the service rings into /var/log/{ota,sntp,dhcp}.log. The serial line already
// got the octets when they were written, so this is the file copy only.
fn svc_flush(state: u64) {
    if svc_max == 0 || kstate.get(state, kstate.FS_READY) == 0 {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if now < svc_next {
        return
    }
    svc_next = now + 100
    var buf: [u8; 256] = [0; 256]
    var lim: u64 = 256
    if svc_max < lim {
        lim = svc_max
    }
    var sid: u64 = 0
    while sid < 3 {
        var rounds: u64 = 0
        var n: u64 = 1
        while n != 0 && rounds < 16 {
            n = tty.svc_take(sid, (&buf[0]) as u64, lim)
            if n != 0 {
                svc_append(state, sid, (&buf[0]) as u64, n)
            }
            rounds = rounds + 1
        }
        sid = sid + 1
    }
}

static mut vgpu_ereig_getan: u64 = 0
static mut mausflut_hz: u64 = 0
// RUNDE GPU (G-012): `mauslauf=<n>` -- EIN GEZAEHLTER ZEIGERLAUF.
static mut mauslauf_soll: u64 = 0
static mut mauslauf_ist: u64 = 0
static mut mauslauf_start: u64 = 0
static mut mauslauf_us: u64 = 0
static mut mouseflood_mark: u64 = 0
static mut mouseflood_left: u64 = 0
static mut mausflut_n: u64 = 0
static mut mausflut_klicks: u64 = 0

fn parse(state: u64, cmd: u64) {
    if cmd == 0 {
        return
    }
    svc_parse(cmd)
    sv2_parse(cmd)
    shellsup.parse(cmd)
    stall.parse(cmd)
    frameprof.parse(cmd)
    pixelguard.parse(state)
    sysmon.parse(cmd)
    var w: [u8; 10] = "mausflut=\0"
    var i: u64 = 0
    while i < 4096 && kstate.get8(cmd + i) != 0 {
        var k: u64 = 0
        while k < 9 && kstate.get8(cmd + i + k) == (w[k as usize] as u64) {
            k = k + 1
        }
        if k == 9 {
            var v: u64 = 0
            var j: u64 = i + 9
            var n: u64 = 0
            while n < 6 && kstate.get8(cmd + j) >= 48
                && kstate.get8(cmd + j) <= 57 {
                v = v * 10 + (kstate.get8(cmd + j) - 48)
                j = j + 1
                n = n + 1
            }
            mausflut_hz = v
            return
        }
        i = i + 1
    }
    var w2: [u8; 10] = "mauslauf=\0"
    var i2: u64 = 0
    while i2 < 4096 && kstate.get8(cmd + i2) != 0 {
        var k2: u64 = 0
        while k2 < 9 && kstate.get8(cmd + i2 + k2) == (w2[k2 as usize] as u64) {
            k2 = k2 + 1
        }
        if k2 == 9 {
            var v2: u64 = 0
            var j2: u64 = i2 + 9
            var n2: u64 = 0
            while n2 < 7 && kstate.get8(cmd + j2) >= 48
                && kstate.get8(cmd + j2) <= 57 {
                v2 = v2 * 10 + (kstate.get8(cmd + j2) - 48)
                j2 = j2 + 1
                n2 = n2 + 1
            }
            mauslauf_soll = v2
            return
        }
        i2 = i2 + 1
    }
    // `jvkill=<ticks>`: test hook of the respawn test -- kill `jarvisd` that many ticks after each start.
    var w3: [u8; 8] = "jvkill=\0"
    var i3: u64 = 0
    while i3 < 4096 && kstate.get8(cmd + i3) != 0 {
        var k3: u64 = 0
        while k3 < 7 && kstate.get8(cmd + i3 + k3) == (w3[k3 as usize] as u64) {
            k3 = k3 + 1
        }
        if k3 == 7 {
            var v3: u64 = 0
            var j3: u64 = i3 + 7
            var n3: u64 = 0
            while n3 < 7 && kstate.get8(cmd + j3) >= 48
                && kstate.get8(cmd + j3) <= 57 {
                v3 = v3 * 10 + (kstate.get8(cmd + j3) - 48)
                j3 = j3 + 1
                n3 = n3 + 1
            }
            jv_killafter = v3
            return
        }
        i3 = i3 + 1
    }
}

fn mouserun_open() -> bool {
    return mauslauf_soll != 0 && mauslauf_ist < mauslauf_soll
}

fn mouserun_count() -> u64 {
    return mauslauf_ist
}

fn mouserun_duration() -> u64 {
    return mauslauf_us
}

fn mauslauf_schritt(state: u64) {
    if mauslauf_soll == 0 || !wm.ready(state) {
        return
    }
    if mauslauf_ist >= mauslauf_soll {
        return
    }
    if mauslauf_ist == 0 {
        ps2m.adopt(state, fb.width(state), fb.height(state))
        ps2m.set_pos(state, fb.width(state) / 2, fb.height(state) * 2 / 3)
        mauslauf_start = time.mono_ns(state)
    }
    var b0: u64 = 8
    var dx: u64 = 3
    if mouseflood_left != 0 {
        dx = 253
        b0 = b0 | 0x10
    }
    var dy: u64 = 0
    if (mauslauf_ist % 14) == 0 {
        dy = 1
    }
    if (mauslauf_ist % 14) == 7 {
        dy = 255
        b0 = b0 | 0x20
    }
    ps2m.usb_packet(state, b0, dx, dy, 0, false)
    if ps2m.changed(state) {
        let _c: bool = ps2m.take_change(state)
        wm.on_mouse(state)
    }
    let x: u64 = ps2m.x(state)
    if x + 16 >= fb.width(state) {
        mouseflood_left = 1
    }
    if x <= 16 {
        mouseflood_left = 0
    }
    mauslauf_ist = mauslauf_ist + 1
    mauslauf_us = (time.mono_ns(state) - mauslauf_start) / 1000
}

fn mausflut_klickzahl() -> u64 {
    return mausflut_klicks
}

fn mausflut_schritt(state: u64) {
    if mausflut_hz == 0 || !wm.ready(state) {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if mouseflood_mark == 0 {
        ps2m.adopt(state, fb.width(state), fb.height(state))
        ps2m.set_pos(state, fb.width(state) / 2, fb.height(state) * 2 / 3)
        mouseflood_mark = now
        return
    }
    if now <= mouseflood_mark {
        return
    }
    var marken: u64 = now - mouseflood_mark
    if marken > 10 {
        marken = 10
    }
    mouseflood_mark = now
    var k: u64 = marken * mausflut_hz / 100
    while k > 0 {
        var b0: u64 = 8
        var dx: u64 = 3
        if mouseflood_left != 0 {
            dx = 253
            b0 = b0 | 0x10
        }
        var dy: u64 = 0
        if (mausflut_n % 14) == 0 {
            dy = 1
        }
        if (mausflut_n % 14) == 7 {
            dy = 255
            b0 = b0 | 0x20
        }
        if (mausflut_n % 250) == 0 {
            b0 = b0 | ps2m.B_LEFT
            mausflut_klicks = mausflut_klicks + 1
        }
        ps2m.usb_packet(state, b0, dx, dy, 0, false)
        if ps2m.changed(state) {
            let _c: bool = ps2m.take_change(state)
            wm.on_mouse(state)
        }
        let x: u64 = ps2m.x(state)
        if x + 16 >= fb.width(state) {
            mouseflood_left = 1
        }
        if x <= 16 {
            mouseflood_left = 0
        }
        mausflut_n = mausflut_n + 1
        k = k - 1
    }
}

fn desk_spawn(state: u64, path: u64, arg: u64, n: u64) -> u64 {
    return desk_spawn_n(state, path, arg, n, 1)
}

fn desk_spawn_n(state: u64, path: u64, arg: u64, n: u64,
    argc: u64) -> u64 {
    // r360: the argument page is per core, so the core must not change
    // between the fill and the loader: interrupt flag down for both
    // (`elf.spawn` saves and restores the flags again, it nests).
    let eflags: u64 = sched.irq_save()
    let abuf: u64 = cpu.earg_buf(state)
    var k: u64 = 0
    while k < n {
        kstate.set8(abuf + k, kstate.get8(arg + k) as u8)
        k = k + 1
    }
    let pid: u64 = elf.spawn(state, path, abuf, argc, 2)
    sched.irq_restore(eflags)
    if pid != 0 {
        if pid < kstate.MAX_TASKS {
            sched.tset(state, pid, sched.T_OOMSAFE, 1)
        }
    }
    protokoll_binden(state, pid)
    let z: u64 = serial.line_at(sched.hier(state))
    var s_st: [u8; 13] = "desk: start \0"
    var s_pid: [u8; 7] = "  pid=\0"
    var s_cpu: [u8; 8] = "  kern=\0"
    serial.puts((&s_st[0]) as u64)
    serial.puts(path)
    serial.puts((&s_pid[0]) as u64)
    serial.dec(pid)
    serial.puts((&s_cpu[0]) as u64)
    serial.dec(sched.hier(state))
    serial.nl()
    serial.line_clear(z)
    if pid == 0 {
        elf.say_reason(kstate.get(state, kstate.ELF_ERR))
    }
    return pid
}

fn i18n_bench(state: u64, f: u64, px: u64) {
    var s_a: [u8; 21] = "i18n: draw ascii us=\0"
    var s_u: [u8; 20] = "i18n: draw utf8 us=\0"
    var s_g: [u8; 22] = "i18n: draw glyphs us=\0"
    var s_r: [u8; 8] = " reps=\0\0"
    var s_n: [u8; 8] = " chars=\0"
    var line: [u8; 40] = "The display mode is set at boot; at run\0"
    if f >= ttf.MAX_FONTS || apic.tsc_hz(state) == 0 {
        return
    }
    let p: u64 = (&line[0]) as u64
    let _w0: i64 = ttf.text_width26(state, f, p, 40, px)
    var t: u64 = apic.tsc()
    var i: u64 = 0
    var acc: i64 = 0
    while i < I18N_LINES {
        acc = acc + ttf.text_width26_bytes(state, f, p, 40, px)
        i = i + 1
    }
    let alt: u64 = us_of(state, apic.tsc() - t)
    t = apic.tsc()
    i = 0
    while i < I18N_LINES {
        acc = acc + ttf.text_width26(state, f, p, 40, px)
        i = i + 1
    }
    let fresh: u64 = us_of(state, apic.tsc() - t)
    t = apic.tsc()
    i = 0
    while i < I18N_LINES {
        var k: u64 = 0
        while k < 40 {
            let _sl: u64 = ttf.glyph(state, f, kstate.get8(p + k), px)
            k = k + 1
        }
        i = i + 1
    }
    let zeichnen: u64 = us_of(state, apic.tsc() - t)
    serial.puts((&s_a[0]) as u64)
    serial.dec(alt)
    serial.puts((&s_r[0]) as u64)
    serial.dec(I18N_LINES)
    serial.puts((&s_n[0]) as u64)
    serial.dec(40)
    serial.nl()
    serial.puts((&s_u[0]) as u64)
    serial.dec(fresh)
    serial.puts((&s_r[0]) as u64)
    serial.dec(I18N_LINES)
    serial.puts((&s_n[0]) as u64)
    serial.dec(40)
    serial.nl()
    serial.puts((&s_g[0]) as u64)
    serial.dec(zeichnen)
    serial.puts((&s_r[0]) as u64)
    serial.dec(I18N_LINES)
    serial.nl()
    if acc == 0 {
        serial.nl()
    }
}

fn tastatur_zur_sprache(state: u64, en: bool) {
    var lay: u64 = kbd.L_DE
    if en {
        lay = kbd.L_US
    }
    var s_kb: [u8; 18] = "kbd: layout de␀␀␀\0"
    if en {
        s_kb[12 as usize] = 101 as u8 // 'e'
        s_kb[13 as usize] = 110 as u8 // 'n'
    }
    if kbd.set_layout(state, lay) {
        serial.puts((&s_kb[0]) as u64)
        serial.nl()
    }
}

fn locale_set(state: u64) {
    let en: bool = kstate.mode_on(state, kstate.M_LANGEN)
    let de: bool = kstate.mode_on(state, kstate.M_LANGDE)
    tastatur_zur_sprache(state, en)
    if !en && !de {
        return
    }
    var cur_path: [u8; 26] = "/users/root/config/locale\0"
    var t_en: [u8; 4] = "en\n\0"
    var t_de: [u8; 4] = "de\n\0"
    var s_ok: [u8; 16] = "locale: gesetzt\0"
    var s_sp: [u8; 2] = " \0"
    var s_rc: [u8; 5] = " rc=\0"
    let ino: u64 = fs.path(state, (&cur_path[0]) as u64)
    if ino == 0 {
        var s_no: [u8; 27] = "locale: keine Datei dafuer\0"
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    fs.file_truncate(state, ino)
    var q: u64 = (&t_de[0]) as u64
    if en {
        q = (&t_en[0]) as u64
    }
    let n: u64 = fs.write_at(state, ino, 0, q, 3)
    serial.puts((&s_ok[0]) as u64)
    serial.puts((&s_sp[0]) as u64)
    serial.text(q, 2)
    serial.puts((&s_rc[0]) as u64)
    serial.dec(n)
    serial.nl()
}

fn desk_start(state: u64) -> u64 {
    locale_set(state)
    var p_desk: [u8; 13] = "/bin/desktop\0"
    var p_task: [u8; 13] = "/bin/taskbar\0"
    var p_star: [u8; 14] = "/bin/launcher\0"
    var p_set: [u8; 14] = "/bin/settings\0"
    var p_dhcp: [u8; 10] = "/bin/dhcp\0"
    var p_jv: [u8; 13] = "/bin/jarvisd\0"
    var a_desk: [u8; 8] = "desktop\0"
    var a_task: [u8; 8] = "taskbar\0"
    var a_star: [u8; 18] = "starter\0versteckt\0"
    var a_set: [u8; 9] = "settings\0"
    var a_dhcp: [u8; 11] = "dhcp\0dauer\0"
    var a_jv: [u8; 8] = "jarvisd\0"
    // ================================================ RUNDE ANMELDUNG
    var p_glog: [u8; 13] = "/bin/glogin\0\0"
    var a_glog: [u8; 8] = "glogin\0\0"
    var s_anm: [u8; 33] = "desk: anmeldung vor schreibtisch\0"
    var s_root: [u8; 35] = "desk: OHNE anmeldung -- uid bleibt\0"
    var do_login: bool = kstate.mode_on(state, kstate.M_LOGIN)
        && !kstate.mode_on(state, kstate.M_NOANMELDUNG)
    var pid: u64 = 0
    // AB-016: THE ACTION BUS STARTS FIRST (docs/ACTION-BUS.md). On an
    // image with a screen `init` does not run (see `wm_owns_shell` in
    // kmain.fi) -- the session starts here, so the broker does too, and
    // BEFORE the sign-in: the settings provider and every app that says
    // `hello` find it already there. Only if the image carries it -- an
    // image without /bin/orientbus (every older acceptance image) starts
    // exactly what it started before. Started from the kernel task, the
    // broker has no origin label and uid 0: the one process the kernel
    // lets hold `orient.bus` (kernel/bus/bus.fi, AB-003).
    var p_bus: [u8; 15] = "/bin/orientbus\0"
    var a_bus: [u8; 16] = "orientbus\0serve\0"
    var s_bus: [u8; 20] = "desk: orientbus pid\0"
    if fs.path(state, (&p_bus[0]) as u64) != 0 {
        let bp: u64 = desk_spawn_n(state, (&p_bus[0]) as u64,
            (&a_bus[0]) as u64, 16, 2)
        serial.puts((&s_bus[0]) as u64)
        serial.put(61 as u8)
        serial.dec(bp)
        serial.nl()
        // the settings provider (AB-005), if the image has it
        var p_sd: [u8; 15] = "/bin/settingsd\0"
        var a_sd: [u8; 16] = "settingsd\0serve\0"
        if fs.path(state, (&p_sd[0]) as u64) != 0 {
            let _sd: u64 = desk_spawn_n(state, (&p_sd[0]) as u64,
                (&a_sd[0]) as u64, 16, 2)
        }
        // DAILY-DRIVER (P-007): the program store's provider, if the image has it
        var p_st: [u8; 13] = "/bin/stored\0\0"
        var a_st: [u8; 13] = "stored\0serve\0"
        if fs.path(state, (&p_st[0]) as u64) != 0 {
            let _st: u64 = desk_spawn_n(state, (&p_st[0]) as u64,
                (&a_st[0]) as u64, 13, 2)
        }
        var p_md: [u8; 12] = "/bin/mediad\0"
        var a_md: [u8; 13] = "mediad\0serve\0"
        if fs.path(state, (&p_md[0]) as u64) != 0 {
            let _md: u64 = desk_spawn_n(state, (&p_md[0]) as u64,
                (&a_md[0]) as u64, 13, 2)
        }
        // A11Y-2 (AB-021): the accessibility tree's provider, if the
        // image has it. It records nothing until somebody asks.
        var p_ax: [u8; 9] = "/bin/axd\0"
        var a_ax: [u8; 10] = "axd\0serve\0"
        if fs.path(state, (&p_ax[0]) as u64) != 0 {
            let _ax: u64 = desk_spawn_n(state, (&p_ax[0]) as u64,
                (&a_ax[0]) as u64, 10, 2)
        }
        // r140 (ex r34-rest): THE SOCIAL SERVICE AND THE MELDER, if the image
        // has them -- the same two a server image gets from /etc/inittab
        // (`init` does not run on a screen image). The service talks to the
        // address book through its providers (/etc/social/providers) and
        // fetches the list of games itself; the Melder reports a running game
        // of /etc/social/games.tsv. Both wait for the network by themselves
        // (they try again). r147: the desktop loop watches both (sv2_watch) and
        // starts one again 5 s after it ended (back-off up to 60 s), like an
        // inittab `respawn` line does on a server image.
        var p_so: [u8; 12] = "/bin/social\0"
        var a_so: [u8; 13] = "social\0serve\0"
        if fs.path(state, (&p_so[0]) as u64) != 0 {
            let _so: u64 = desk_spawn_n(state, (&p_so[0]) as u64,
                (&a_so[0]) as u64, 13, 2)
            sv2_arm(state, 0, _so)
            var s_so: [u8; 18] = "desk: social pid\0\0"
            serial.puts((&s_so[0]) as u64)
            serial.put(61 as u8)
            serial.dec(_so)
            serial.nl()
            var p_me: [u8; 12] = "/bin/melder\0"
            var a_me: [u8; 13] = "melder\0serve\0"
            if fs.path(state, (&p_me[0]) as u64) != 0 {
                let _me: u64 = desk_spawn_n(state, (&p_me[0]) as u64,
                    (&a_me[0]) as u64, 13, 2)
                sv2_arm(state, 1, _me)
                var s_me: [u8; 18] = "desk: melder pid\0\0"
                serial.puts((&s_me[0]) as u64)
                serial.put(61 as u8)
                serial.dec(_me)
                serial.nl()
            }
        }
    }
    // DAILY-DRIVER: THE UPDATE SERVICE (`ota boot`), if the image has
    // /bin/ota. With a new generation in trial it waits until the sign-in
    // screen or the desktop has been running for a minute, then marks the
    // generation good itself; if that does not happen it reboots, and
    // after three tries the kernel switches back (kernel/ab.fi). With
    // `auto=ja` in /etc/ota.conf it then searches in the background and
    // stages a newer version for the next start. It never reboots on
    // its own account except to roll back.
    var p_ota: [u8; 9] = "/bin/ota\0"
    var a_ota: [u8; 9] = "ota\0boot\0"
    if fs.path(state, (&p_ota[0]) as u64) != 0 {
        let _ot: u64 = desk_spawn_svc(state, 0, (&p_ota[0]) as u64,
            (&a_ota[0]) as u64, 9, 2)
    }
    // DAILY-DRIVER: THE ZONE AND THE NETWORK CLOCK (`sntp boot`), if the
    // image has /bin/sntp: applies /etc/time.conf (offset, rule) to the
    // kernel and sets the clock from /etc/ntp.conf when auto=true.
    var p_sn: [u8; 10] = "/bin/sntp\0"
    var a_sn: [u8; 10] = "sntp\0boot\0"
    if fs.path(state, (&p_sn[0]) as u64) != 0 {
        let _sn: u64 = desk_spawn_svc(state, 1, (&p_sn[0]) as u64,
            (&a_sn[0]) as u64, 10, 2)
    }
    // W-APPRIGHTS AR-2: `apprights load` registers the manifest ceilings (perm=) and brings the saved grants
    // (/etc/apprights.conf) back into the kernel table. Without it every app is back at default deny after a restart.
    var p_ar: [u8; 15] = "/bin/apprights\0"
    var a_ar: [u8; 15] = "apprights\0load\0"
    if fs.path(state, (&p_ar[0]) as u64) != 0 {
        // two arguments ("apprights" "load"): desk_spawn would pass argc 1 and the tool prints its usage instead of loading
        let _ar: u64 = desk_spawn_n(state, (&p_ar[0]) as u64,
            (&a_ar[0]) as u64, 15, 2)
    }
    // ODB (debug build only, docs/ODB.md): the image has no init in the graphical target, so the desktop starts the debug agent
    // itself -- and only when /etc/odb.conf exists (tools/usbimg/build.sh ODB=1 puts it there) or the command line has `odb=1`. odbd checks `enable=1` / /proc/odb itself.
    var p_odb: [u8; 10] = "/bin/odbd\0"
    var a_odb: [u8; 5] = "odbd\0"
    var c_odb: [u8; 14] = "/etc/odb.conf\0"
    // `odb=1` on the kernel command line enables the agent without a conf file (r1155)
    if (fs.path(state, (&c_odb[0]) as u64) != 0 || kstate.mode_on(state, kstate.M_ODB)) && fs.path(state, (&p_odb[0]) as u64) != 0 {
        let _od: u64 = desk_spawn(state, (&p_odb[0]) as u64,
            (&a_odb[0]) as u64, 5)
    }
    if do_login {
        serial.puts((&s_anm[0]) as u64)
        serial.nl()
        pid = desk_spawn(state, (&p_glog[0]) as u64,
            (&a_glog[0]) as u64, 8)
    } else {
        serial.puts((&s_root[0]) as u64)
        serial.nl()
        pid = desk_spawn(state, (&p_desk[0]) as u64,
            (&a_desk[0]) as u64, 8)
    }
    var runden: u64 = 0
    while runden < 250 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    let _l: u64 = desk_spawn(state, (&p_task[0]) as u64,
        (&a_task[0]) as u64, 8)
    shellsup.arm(state, shellsup.W_TASKBAR, _l)
    runden = 0
    while runden < 250 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    if !kstate.mode_on(state, kstate.M_NOSTART) {
        if kstate.mode_on(state, kstate.M_LAUNCHERVIS) {
            // test aid: "starter" alone = the window stays visible
            pid = desk_spawn_n(state, (&p_star[0]) as u64,
                (&a_star[0]) as u64, 8, 1)
        } else {
            pid = desk_spawn_n(state, (&p_star[0]) as u64,
                (&a_star[0]) as u64, 18, 2)
        }
        shellsup.arm(state, shellsup.W_LAUNCHER, pid)
    }
    wigapp_zerlegen(state)
    if wg_da != 0 {
        pid = desk_spawn_n(state, (&wg_path[0]) as u64,
            (&wg_args[0]) as u64, wg_len, wg_argc)
    }
    if kstate.mode_on(state, kstate.M_SETTINGS) {
        pid = desk_spawn(state, (&p_set[0]) as u64,
            (&a_set[0]) as u64, 9)
    }
    if kstate.mode_on(state, kstate.M_THEMEGUI)
       || kstate.mode_on(state, kstate.M_THEMESHOT) {
        if kstate.mode_on(state, kstate.M_THEMEGUI) {
            var p_ex: [u8; 14] = "/bin/explorer\0"
            var a_ex: [u8; 9] = "explorer\0"
            let _e: u64 = desk_spawn(state, (&p_ex[0]) as u64,
                (&a_ex[0]) as u64, 9)
        }
        var p_tg: [u8; 15] = "/bin/themetest\0"
        var a_tg: [u8; 14] = "themetest\0gui\0"
        var a_ts: [u8; 15] = "themetest\0shot\0"
        if kstate.mode_on(state, kstate.M_THEMESHOT) {
            pid = desk_spawn_n(state, (&p_tg[0]) as u64,
                (&a_ts[0]) as u64, 15, 2)
        } else {
            pid = desk_spawn_n(state, (&p_tg[0]) as u64,
                (&a_tg[0]) as u64, 14, 2)
        }
    }
    if kstate.mode_on(state, kstate.M_DHCP) {
        let _d: u64 = desk_spawn_svc(state, 2, (&p_dhcp[0]) as u64,
            (&a_dhcp[0]) as u64, 11, 2)
        shellsup.arm(state, shellsup.W_DHCP, _d)
    }
    if kstate.mode_on(state, kstate.M_JARVIS) {
        let _j: u64 = desk_spawn_svc(state, 3, (&p_jv[0]) as u64,
            (&a_jv[0]) as u64, 8, 1)
        jv_pid = _j
        jv_tpid = jv_stamp(state, _j)
        jv_born = kstate.get(state, kstate.TICKS)
        if fs.path(state, (&p_jv[0]) as u64) != 0 {
            jv_armed = 1
            var s_a: [u8; 27] = "desk: jarvisd watch armed=\0"
            serial.puts((&s_a[0]) as u64)
            serial.dec(_j)
            serial.nl()
            if _j == 0 {
                jv_next = jv_born + 500
            }
        }
    }
    //     desk: start /bin/taskmgr                   pid=8
    //     desk: start /bin/taskmgr,melde,takt,500    pid=0
    if kstate.mode_on(state, kstate.M_NETVDEMO) {
        netv_demo(state)
    }
    runden = 0
    while runden < 500 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    return pid
}

fn netv_demo(state: u64) {
    var p_nv: [u8; 13] = "/bin/netview\0"
    var a_flt: [u8; 31] = "netview\0filtered\0/bin/explorer\0"
    var a_fak: [u8; 30] = "netview\0faked\0/bin/widgetdemo\0"
    var a_non: [u8; 27] = "netview\0none\0/bin/settings\0"
    let _a: u64 = desk_spawn_n(state, (&p_nv[0]) as u64,
        (&a_flt[0]) as u64, 31, 3)
    var runden: u64 = 0
    while runden < 200 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    // MERGE FIX: the blob is 30 octets since /bin/wigdemo became
    // /bin/widgetdemo. The 27 was the old length and cut the path off
    // after "/bin/widgetde" -- the faked window never started, and the
    // taskbar had no button carrying the `faked` mark.
    let _b: u64 = desk_spawn_n(state, (&p_nv[0]) as u64,
        (&a_fak[0]) as u64, 30, 3)
    runden = 0
    while runden < 200 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    let _c: u64 = desk_spawn_n(state, (&p_nv[0]) as u64,
        (&a_non[0]) as u64, 27, 3)
    runden = 0
    while runden < 400 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
}

fn k15_start(state: u64) -> u64 {
    var p_files: [u8; 14] = "/bin/explorer\0"
    var p_demo: [u8; 16] = "/bin/widgetdemo\0"
    var p_start: [u8; 14] = "/bin/launcher\0"
    var p_spei: [u8; 14] = "/bin/speicher\0"
    var a_files: [u8; 9] = "explorer\0"
    var a_demo: [u8; 11] = "widgetdemo\0"
    var a_start: [u8; 9] = "launcher\0"
    var a_spei: [u8; 9] = "speicher\0"
    var p_icons: [u8; 12] = "/bin/icont\0\0"
    var a_icons: [u8; 6] = "icont\0"
    var a_nohit: [u8; 6] = "nohit\0"
    var a_noclip: [u8; 7] = "noclip\0"
    var a_nokeys: [u8; 7] = "nokeys\0"
    var a_noidx: [u8; 6] = "noidx\0"
    var a_list: [u8; 6] = "liste\0"
    let abuf: u64 = state + kstate.EARG_OFF
    var path: u64 = (&p_demo[0]) as u64
    var arg0: u64 = (&a_demo[0]) as u64
    var n0: u64 = 11
    if kstate.mode_on(state, kstate.M_WIGFILES) {
        path = (&p_files[0]) as u64
        arg0 = (&a_files[0]) as u64
        n0 = 9
    }
    if kstate.mode_on(state, kstate.M_WIGSTART) {
        path = (&p_start[0]) as u64
        arg0 = (&a_start[0]) as u64
        n0 = 9
    }
    if kstate.mode_on(state, kstate.M_WIGSPEICHER) {
        path = (&p_spei[0]) as u64
        arg0 = (&a_spei[0]) as u64
        n0 = 9
    }
    // ROUND ICONS: the program that measures the icon font.
    if kstate.mode_on(state, kstate.M_WIGICONS) {
        path = (&p_icons[0]) as u64
        arg0 = (&a_icons[0]) as u64
        n0 = 6
    }
    // ROUND POWERMON: `wigapp=/bin/NAME` starts THAT program in the
    // window server instead of one of the three above. Not a new bit in
    // `kstate.MODE` -- that word has two bits left out of sixty-four and
    // a dozen rounds are working on this tree at once. And not a fourth
    // hard-wired name either: the next round that wants to show a window
    // would need a fifth, and the one after that a sixth. The path is
    // read out of the command line, the name after the last slash
    // becomes argv[0], and nothing here has to change again.
    wigapp_zerlegen(state)
    if wg_da != 0 {
        path = (&wg_path[0]) as u64
        arg0 = (&wg_args[0]) as u64
        n0 = wg_len
    }
    var at: u64 = 0
    var k: u64 = 0
    while k < n0 {
        kstate.set8(abuf + at, kstate.get8(arg0 + k) as u8)
        at = at + 1
        k = k + 1
    }
    var argc: u64 = 1
    if wg_da != 0 {
        argc = wg_argc
    }
    if kstate.mode_on(state, kstate.M_WIGNOHIT) {
        k = 0
        while k < 6 {
            kstate.set8(abuf + at, a_nohit[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    if kstate.mode_on(state, kstate.M_WIGNOCLIP) {
        k = 0
        while k < 7 {
            kstate.set8(abuf + at, a_noclip[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    if kstate.mode_on(state, kstate.M_WIGNOKEYS) {
        k = 0
        while k < 7 {
            kstate.set8(abuf + at, a_nokeys[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    if kstate.mode_on(state, kstate.M_WIGNOIDX) {
        k = 0
        while k < 6 {
            kstate.set8(abuf + at, a_noidx[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    // r402: the launcher of the k15 runs measure the list of the OLD window (rows, hover, search);
    // the Windows 11 window is measured by `tools/startmenu`
    if kstate.mode_on(state, kstate.M_WIGSTART) {
        k = 0
        while k < 6 {
            kstate.set8(abuf + at, a_list[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    if path == (&p_demo[0]) as u64 {
        var a_limit: [u8; 6] = "limit\0"
        k = 0
        while k < 6 {
            kstate.set8(abuf + at, a_limit[k as usize])
            at = at + 1
            k = k + 1
        }
        argc = argc + 1
    }
    let pid: u64 = elf.spawn(state, path, abuf, argc, 2)
    var s_k15: [u8; 12] = "k15: start \0"
    var s_pid: [u8; 7] = "  pid=\0"
    serial.puts((&s_k15[0]) as u64)
    serial.puts(path)
    serial.puts((&s_pid[0]) as u64)
    serial.dec(pid)
    serial.nl()
    if pid == 0 {
        elf.say_reason(kstate.get(state, kstate.ELF_ERR))
    }
    var runden: u64 = 0
    while runden < 400 {
        wm.poll(state)
        wm.compose(state)
        sched.sleep_ticks(state, 1)
        runden = runden + 1
    }
    return pid
}

static mut sp_takt: u64 = 0

//     desk: start /bin/lock  pid=7 ... sperre: Sperrer neu, pid=7
//     desk: start /bin/lock  pid=8 ... sperre: Sperrer neu, pid=8
static mut sp_startet: u64 = 0

// WAS SIE TUT, IN DIESER REIHENFOLGE:
static mut lo_startet: u64 = 0

// DAILY-DRIVER (r143): THE STANDBY WISH (sperre op 11), done here because S3
// needs the kernel's own context. The screen is locked first, so the wake-up
// shows the lock screen and not an open session; the answer goes into
// SP_STANDBYRC (see kstate) for the program that asked.
fn standby_wache(state: u64) {
    let sp: u64 = kstate.K11_OFF
    if kstate.get(state, sp + kstate.SP_STANDBY) == 0 {
        return
    }
    kstate.set(state, sp + kstate.SP_STANDBY, 0)
    var s_w: [u8; 18] = "standby: wunsch\0\0\0"
    var s_z: [u8; 20] = "standby: antwort=\0\0\0"
    serial.puts((&s_w[0]) as u64)
    serial.nl()
    let _f: bool = blk.flush(state)
    if kstate.get(state, sp + kstate.SP_ON) == 0 {
        kstate.set(state, sp + kstate.SP_ON, 1)
        kstate.add(state, sp + kstate.SP_LOCKS, 1)
    }
    let r: u64 = s3.suspend(state)
    var rc: u64 = 4
    if r == s3.R_OK_S3 || r == s3.R_RESUME {
        rc = 1
        kstate.add(state, sp + kstate.SP_STANDBYS, 1)
        // the picture has to be made again after the sleep
        wm.damage_all(state)
    } else if r == s3.R_SMP || r == s3.R_PARK {
        rc = 2
    } else if r == s3.R_NOS3 {
        rc = 3
    }
    kstate.set(state, sp + kstate.SP_STANDBYRC, rc)
    serial.puts((&s_z[0]) as u64)
    serial.dec(rc)
    serial.nl()
}

fn abmelde_wache(state: u64) {
    let sp: u64 = kstate.K11_OFF
    if kstate.get(state, sp + kstate.SP_LOGOUT) == 0 {
        return
    }
    if lo_startet != 0 {
        return
    }
    lo_startet = 1
    kstate.set(state, sp + kstate.SP_LOGOUT, 0)
    let uid: u64 = kstate.get(state, sp + kstate.SP_UID)
    var s_a: [u8; 26] = "abmelden: Sitzung uid=\0\0\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(uid)
    serial.nl()
    // 1. DIE PUFFER.
    let _f: bool = blk.flush(state)
    var getroffen: u64 = 0
    if uid != 0 {
        var i: u64 = 0
        while i < kstate.MAX_TASKS {
            let z: u64 = sched.tget(state, i, sched.T_STATE)
            if z != sched.S_FREE && z != sched.S_ZOMBIE
               && sched.tget(state, i, sched.T_UID) == uid {
                let pid: u64 = sched.tget(state, i, sched.T_PID)
                if pid != 0 {
                    let _k: u64 = signal.send_pid(state, pid,
                        signal.SIGKILL)
                    getroffen = getroffen + 1
                }
            }
            i = i + 1
        }
    }
    var s_g: [u8; 23] = "abmelden: beendet n=\0\0\0"
    serial.puts((&s_g[0]) as u64)
    serial.dec(getroffen)
    serial.nl()
    kstate.set(state, sp + kstate.SP_ON, 0)
    kstate.set(state, sp + kstate.SP_PID, 0)
    kstate.set(state, sp + kstate.SP_SLOT, 0)
    kstate.set(state, sp + kstate.SP_UID, 0)
    var p_glog: [u8; 13] = "/bin/glogin\0\0"
    var a_glog: [u8; 8] = "glogin\0\0"
    let space: u64 = desk_spawn(state, (&p_glog[0]) as u64,
        (&a_glog[0]) as u64, 8)
    var fresh: u64 = 0
    if space < kstate.MAX_TASKS {
        fresh = sched.tget(state, space, sched.T_PID)
    }
    kstate.add(state, sp + kstate.SP_LOGOUTS, 1)
    var s_n: [u8; 29] = "abmelden: Anmeldung neu pid=\0"
    serial.puts((&s_n[0]) as u64)
    serial.dec(fresh)
    serial.nl()
    lo_startet = 0
}

// ==================================== 04.10.2026 (DELL): DEAD WINDOWS
// A process that ends (round limit, fault, kill) did NOT take its windows
// with it: only files and sockets are closed on exit. The start menu's
// process ("starter") ended, its window stayed as a picture -- "Programm
// suchen:" with an empty field, the highlight stuck, no click and no key
// accepted (Justin's Dell photo, 04.10.2026 13:30). Every tick: a window
// whose owner is a corpse (or a free slot) is destroyed. The next press on
// Super / Start then finds no window and starts a fresh launcher.
// NOT while the lock stands: the lock's own death must not show the desktop
// for a moment (`sperre_wache` restarts it).
static mut tot_say: u64 = 0

fn window_watch(state: u64) {
    if wm.sperre_an(state) || fb.sweep_aus(state) {
        return
    }
    let tasks: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < wm.MAX_WIN {
        if wm.valid(state, i) {
            let o: u64 = wm.win_owner(state, i)
            if o != 0 && o < tasks {
                let zs: u64 = sched.tget(state, o, sched.T_STATE)
                if zs == sched.S_ZOMBIE || zs == sched.S_FREE {
                    var s_t: [u8; 29] = "kgui: dead window removed i=\0"
                    var s_o: [u8; 8] = " owner=\0"
                    serial.puts((&s_t[0]) as u64)
                    serial.dec(i)
                    serial.puts((&s_o[0]) as u64)
                    serial.dec(o)
                    serial.nl()
                    let _d: bool = wm.destroy(state, i)
                    tot_say = tot_say + 1
                }
            }
        }
        i = i + 1
    }
}

// ==================================== r462: SIGWINCH FOR TERMINAL WINDOWS
// When the grid of a terminal window changes (the user dragged an edge, maximised it), the foreground process group of the tty
// bound to that window gets SIGWINCH: an editor or a pager asks `TIOCGWINSZ` again and draws for the new size. Every tick, like
// `fenster_wache`; a window is remembered the first time it is seen.
static mut winch_c: [u64; 32] = [0 as u64; 32]
static mut winch_r: [u64; 32] = [0 as u64; 32]

fn winch_wache(state: u64) {
    var i: u64 = 0
    while i < wm.MAX_WIN {
        let sz: u64 = wm.term_size(state, i)
        if sz == 0 {
            winch_c[(i) as usize] = 0
            winch_r[(i) as usize] = 0
        } else {
            let c: u64 = sz & 0xFFFF
            let r: u64 = sz >> 16
            if winch_c[(i) as usize] == 0 {
                winch_c[(i) as usize] = c
                winch_r[(i) as usize] = r
            } else if winch_c[(i) as usize] != c || winch_r[(i) as usize] != r {
                winch_c[(i) as usize] = c
                winch_r[(i) as usize] = r
                let t: u64 = wm.tty_of(state, i)
                if t < tty.MAX_TTY && tty.valid(state, t) {
                    let grp: u64 = tty.pgrp(state, t)
                    var hit: u64 = 0
                    if grp != 0 {
                        hit = signal.send_pgid(state, grp, signal.SIGWINCH)
                    } else {
                        hit = signal.send_tty(state, t, t == tty.console(), signal.SIGWINCH)
                    }
                    var s_w: [u8; 17] = "kgui: winch win=\0"
                    var s_g: [u8; 6] = " grp=\0"
                    var s_h: [u8; 6] = " hit=\0"
                    serial.puts((&s_w[0]) as u64)
                    serial.dec(i)
                    serial.puts((&s_g[0]) as u64)
                    serial.dec(grp)
                    serial.puts((&s_h[0]) as u64)
                    serial.dec(hit)
                    var s_c: [u8; 7] = " cols=\0"
                    var s_r: [u8; 7] = " rows=\0"
                    serial.puts((&s_c[0]) as u64)
                    serial.dec(c)
                    serial.puts((&s_r[0]) as u64)
                    serial.dec(r)
                    serial.nl()
                }
            }
        }
        i = i + 1
    }
}

// ==================================== W-X2: HANGUP FOR CLOSED TERMINAL WINDOWS
// Closing a terminal window (the 'x', a tab's 'x', Ctrl+Shift+W) only ends the INPUT of its tty: a shell that sits in a foreground program
// (`sleep`, `edit`, `jarvisd -v`) never reads again and stayed alive for ever without a window -- a task slot lost per closed tab. A real
// terminal hangs up: every task that has the tty of a vanished window as its controlling terminal gets SIGHUP. Every tick a window is
// remembered with its tty (the console is never hung up: its shell is restarted by the desktop loop); a slot that is free or holds
// another tty now has hung up.
static mut hup_t: [u64; 32] = [0 as u64; 32]
static mut hup_said: u64 = 0

fn hup_in_use(state: u64, t: u64, skip: u64) -> bool {
    var j: u64 = 0
    while j < wm.MAX_WIN {
        if j != skip && wm.tty_of(state, j) == t && wm.win_kind(state, j) == wm.K_TERM {
            return true
        }
        j = j + 1
    }
    return false
}

fn hup_wache(state: u64) {
    var i: u64 = 0
    while i < wm.MAX_WIN {
        let t: u64 = wm.tty_of(state, i)
        let seen: u64 = hup_t[(i) as usize]
        if seen != 0 && (t == wm.NO_TTY || t + 1 != seen) {
            let old: u64 = seen - 1
            hup_t[(i) as usize] = 0
            // r1088: a tty number that a LIVE window holds again (the slot was freed and a new tab took the number before this round saw
            // the old window go) must not be hung up: its shell would get SIGHUP / EOF and say `sh: bye`.
            if old < tty.MAX_TTY && tty.valid(state, old) && old != tty.console() && !hup_in_use(state, old, i) {
                let hit: u64 = signal.send_tty(state, old, false, signal.SIGHUP)
                if hup_said < 40 {
                    hup_said = hup_said + 1
                    var s_h: [u8; 18] = "kgui: hangup tty=\0"
                    var s_n: [u8; 6] = " hit=\0"
                    serial.puts((&s_h[0]) as u64)
                    serial.dec(old)
                    serial.puts((&s_n[0]) as u64)
                    serial.dec(hit)
                    serial.nl()
                }
            }
        }
        if t != wm.NO_TTY && t < tty.MAX_TTY && t != tty.console() && wm.win_kind(state, i) == wm.K_TERM {
            hup_t[(i) as usize] = t + 1
        }
        i = i + 1
    }
}

// ==================================== 04.10.2026 (DELL): ZOMBIE LEAK
// Justin, Dell: "after several programs are open no further one opens".
// Measured in a VM with the Dell's own image: the task table has 32 slots
// (slot 0 never given out), the system itself holds about 20 of them, and
// EVERY program that ends stays in its slot as a corpse until its creator
// calls wait4. Nobody does: the start menu, the taskbar, the file manager
// start programs with SYS_EXEC and never wait, and the kernel's own boot
// task (parent of the login screen, dhcp ...) never waits either. After a
// handful of opened-and-closed programs `fork`/exec failed for good.
// Corpses are now taken away here, every 16th round of the desktop loop:
//   1. the parent is the boot task itself (this loop): nobody will wait;
//   2. the parent is gone or a corpse itself: nobody will wait;
//   3. the parent ignores SIGCHLD (POSIX: children are reaped
//      automatically) -- the start menu and the taskbar say so at start;
//   4. nobody picked it up for ZOMBIE_MAX_AGE ticks (about 30 s): a
//      safety net, so that no program can leak slots for ever.
// A parent that waits normally (the shell, settings) is never touched
// before rule 4.
const ZOMBIE_MAX_AGE: u64 = 3000
static mut zs_tick: u64 = 0
static mut zs_said: u64 = 0

fn zombie_sweep(state: u64) {
    if fb.zreap_aus(state) {
        return
    }
    zs_tick = zs_tick + 1
    if (zs_tick & 15) != 0 {
        return
    }
    let me: u64 = sched.current(state)
    let n: u64 = kstate.get(state, kstate.TASKS)
    let now: u64 = kstate.get(state, kstate.TICKS)
    var i: u64 = 1
    while i < n {
        if sched.tget(state, i, sched.T_STATE) == sched.S_ZOMBIE && i != me {
            let p: u64 = sched.tget(state, i, sched.T_PARENT)
            var warum: u64 = 0
            if p == me {
                warum = 1
            } else if p >= n {
                warum = 2
            } else {
                let ps: u64 = sched.tget(state, p, sched.T_STATE)
                if ps == sched.S_FREE || ps == sched.S_ZOMBIE {
                    warum = 2
                } else if signal.handler_of(state, p, signal.SIGCHLD)
                    == signal.SIG_IGN {
                    warum = 3
                } else {
                    let ende: u64 = sched.tget(state, i, sched.T_END)
                    if now > ende && now - ende > ZOMBIE_MAX_AGE {
                        warum = 4
                    }
                }
            }
            if warum != 0 {
                if zs_said < 40 {
                    zs_said = zs_said + 1
                    var s_z: [u8; 22] = "kgui: zombie reaped \0\0"
                    var s_p: [u8; 9] = " parent=\0"
                    var s_w: [u8; 6] = " why=\0"
                    serial.puts((&s_z[0]) as u64)
                    serial.dec(sched.tget(state, i, sched.T_PID))
                    serial.puts((&s_p[0]) as u64)
                    serial.dec(sched.tget(state, i, sched.T_PARENT))
                    serial.puts((&s_w[0]) as u64)
                    serial.dec(warum)
                    serial.nl()
                }
                // Its living children must not keep a slot number that is
                // free in a moment (and given to a stranger): they fall
                // to this loop's task, as they would fall to init.
                var j: u64 = 0
                while j < n {
                    if j != i && sched.tget(state, j, sched.T_STATE)
                        != sched.S_FREE
                        && sched.tget(state, j, sched.T_PARENT) == i {
                        sched.tset(state, j, sched.T_PARENT, me)
                    }
                    j = j + 1
                }
                let _r: bool = proc.reap(state, i)
            }
        }
        i = i + 1
    }
}

fn lock_watch(state: u64) {
    if !wm.sperre_an(state) {
        return
    }
    if sp_startet != 0 {
        return
    }
    sp_takt = sp_takt + 1
    if (sp_takt & 31) != 0 {
        return
    }
    let pid: u64 = wm.sperrer(state)
    if pid != 0 {
        let t: u64 = sched.find_pid(state, pid)
        if t < kstate.MAX_TASKS {
            let z: u64 = sched.tget(state, t, sched.T_STATE)
            if z != sched.S_ZOMBIE && z != sched.S_FREE {
                return
            }
        }
    }
    var p_lock: [u8; 10] = "/bin/lock\0"
    var a_lock: [u8; 5] = "lock\0"
    sp_startet = 1
    //     sperre: Sperrer neu, pid=6  slot=5
    //     wm: darf i=4 owner=6 slot=5
    let space: u64 = desk_spawn(state, (&p_lock[0]) as u64,
        (&a_lock[0]) as u64, 5)
    kstate.set(state, kstate.K11_OFF + kstate.SP_SLOT, space)
    var fresh: u64 = 0
    if space < kstate.MAX_TASKS {
        fresh = sched.tget(state, space, sched.T_PID)
    }
    kstate.set(state, kstate.K11_OFF + kstate.SP_PID, fresh)
    kstate.add(state, kstate.K11_OFF + kstate.SP_SPAWNS, 1)
    var s_w: [u8; 26] = "sperre: Sperrer neu, pid=\0"
    serial.puts((&s_w[0]) as u64)
    serial.dec(fresh)
    serial.nl()
    sp_startet = 0
}

fn say_wig(state: u64) {
    var s_a: [u8; 12] = "wig: blits=\0"
    var s_b: [u8; 10] = "  rows=\0\0\0"
    var s_c: [u8; 10] = "  pixels=\0"
    var s_d: [u8; 10] = "  glyphs=\0"
    var s_e: [u8; 12] = "  clipset=\0\0"
    var s_f: [u8; 12] = "  clipget=\0\0"
    var s_g: [u8; 10] = "  shape=\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(wig.blits(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(wig.rows_copied(state))
    serial.puts((&s_c[0]) as u64)
    serial.dec(wig.pixels(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(wig.glyph_calls(state))
    serial.puts((&s_e[0]) as u64)
    serial.dec(wig.clip_writes(state))
    serial.puts((&s_f[0]) as u64)
    serial.dec(wig.clip_reads(state))
    serial.puts((&s_g[0]) as u64)
    serial.dec(wm.shape(state))
    serial.nl()
}

fn shell_start(state: u64) -> u64 {
    var p_sh: [u8; 8] = "/bin/sh\0"
    // LCSH fix: on images where /bin/sh is busybox the Osum shell lives at /bin/osh. The window console shell MUST be the Osum shell:
    // busybox ash on this console tty froze the sign-in screen's keyboard input (VirtualBox report 16.10.2026, QEMU repro).
    var p_osh: [u8; 9] = "/bin/osh\0"
    var a_sh: [u8; 3] = "sh\0"
    var p_run: u64 = (&p_sh[0]) as u64
    if fs.path(state, (&p_osh[0]) as u64) != 0 {
        p_run = (&p_osh[0]) as u64
    }
    let abuf: u64 = state + kstate.EARG_OFF
    var k: u64 = 0
    while k < 3 {
        kstate.set8(abuf + k, a_sh[k as usize])
        k = k + 1
    }
    var s_cs: [u8; 17] = "wm: console sh: \0"
    serial.puts((&s_cs[0]) as u64)
    serial.puts(p_run)
    serial.nl()
    return elf.spawn(state, p_run, abuf, 1, 2)
}

// r1014 TERMINAL TABS: Ctrl+Shift+T / the '+' ask the window server (`wm.tt_request`); the desktop loop starts /bin/term, which opens
// the new terminal window and its shell (like the start menu does); `gfx.term_new` joins it to the group of the asking window.
// The started tasks are children of the desktop: finished ones are reaped here (slot + pid, a reused slot is never reaped).
static mut tab_kid: [u64; 32] = [0 as u64; 32]
static mut tab_kpid: [u64; 32] = [0 as u64; 32]

fn tabs_spawn(state: u64) {
    var p_t: [u8; 10] = "/bin/term\0"
    var a_t: [u8; 5] = "term\0"
    let abuf: u64 = state + kstate.EARG_OFF
    var k: u64 = 0
    while k < 5 {
        kstate.set8(abuf + k, a_t[k as usize])
        k = k + 1
    }
    let slot: u64 = elf.spawn(state, (&p_t[0]) as u64, abuf, 1, 2)
    var s_ts: [u8; 24] = "wm: tab shell started: \0"
    serial.puts((&s_ts[0]) as u64)
    serial.dec(slot)
    serial.nl()
    if slot == 0 {
        wm.tt_cancel(state)
        return
    }
    var j: u64 = 0
    while j < 32 {
        if tab_kid[j as usize] == 0 {
            tab_kid[j as usize] = slot
            tab_kpid[j as usize] = sched.tget(state, slot, sched.T_PID)
            return
        }
        j = j + 1
    }
}

fn tabs_reap(state: u64) {
    var j: u64 = 0
    while j < 32 {
        let sl: u64 = tab_kid[j as usize]
        if sl != 0 {
            if sched.tget(state, sl, sched.T_PID) != tab_kpid[j as usize] {
                tab_kid[j as usize] = 0
            } else if sched.tget(state, sl, sched.T_STATE) == sched.S_ZOMBIE {
                proc.reap(state, sl)
                tab_kid[j as usize] = 0
            }
        }
        j = j + 1
    }
}

// ===================================================== RUNDE HIDWEG
// `jarvisd` supervises its own worker (restart with back-off 2 s .. 60 s, kills a
// silent one). Nothing supervised the supervisor: if that process died (fault, kill,
// out of memory), the Dell stayed off the bridge until somebody started it by hand
// (Boss, 08.10. 15:45 UTC). The desktop loop now watches the process the boot word
// `jarvis` started: gone or zombie -> start it again after 5 s, doubling up to 60 s;
// a run of two minutes or more resets the back-off.

fn jv_backoff(state: u64, now: u64) {
    jv_next = now + jv_wait
    var s_b: [u8; 30] = "desk: jarvisd restart in (s)=\0"
    let z_b: u64 = serial.line_at(sched.hier(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(jv_wait / 100)
    serial.nl()
    serial.line_clear(z_b)
    jv_wait = jv_wait * 2
    if jv_wait > 6000 {
        jv_wait = 6000
    }
}

// SLOT AND PID ARE TWO NUMBERS (r-jvdouble, 10.10.2026).
//
// `elf.spawn` -- and so `desk_spawn_svc` -- returns the TASK SLOT, not the process number. The watch used to
// hand that number to `sched.find_pid`, which looks for a process number. The two are equal only on a small machine
// where nothing has ended yet; on the personal image the boot consumes pids before the desktop starts its
// services (slot 16 = pid 27) and `find_pid(16)` found `settingsd`. The program name check of r-svclog2 then said
// "not jarvisd" about the wrong task, the watch declared the running helper dead and started a second one
// ("already running -- not starting a second one", exit, back-off 10, 20, 40 ... for ever).
//
// NOW: the watch keeps the SLOT (where to look) and the PROCESS NUMBER read from that slot at the spawn (who we
// started). Process numbers are never handed out twice, so "the slot holds another number" is the exact
// definition of "our process ended and the slot was reused" -- without reading anything of the program's memory.
fn jv_stamp(state: u64, slot: u64) -> u64 {
    if slot == 0 || slot >= kstate.MAX_TASKS {
        return 0
    }
    return sched.tget(state, slot, sched.T_PID)
}

// ====================================== r147: RESPAWN OF THE SOCIAL SERVICE AND THE MELDER
// A screen image has no `init`, so nothing brought /bin/social and /bin/melder back when they ended
// (fault, kill, out of memory). The desktop loop watches the two like it watches `jarvisd`: gone or zombie
// -> start again after 5 s, back-off doubling up to 60 s; a run of two minutes or more resets it.
// Index 0 = social, 1 = melder. Same slot/stamp rule as jv_stamp (the slot is where to look, the process
// number read at the spawn is who we started). `sokill=<ticks>` (boot word) is the test hook: kill the
// social service that many ticks after each start (the melder is not touched by it).

fn sv2_parse(cmd: u64) {
    var w: [u8; 8] = "sokill=\0"
    var i: u64 = 0
    while i < 4096 && kstate.get8(cmd + i) != 0 {
        var k: u64 = 0
        while k < 7 && kstate.get8(cmd + i + k) == (w[k as usize] as u64) {
            k = k + 1
        }
        if k == 7 {
            var v: u64 = 0
            var j: u64 = i + 7
            var n: u64 = 0
            while n < 7 && kstate.get8(cmd + j) >= 48 && kstate.get8(cmd + j) <= 57 {
                v = v * 10 + (kstate.get8(cmd + j) - 48)
                j = j + 1
                n = n + 1
            }
            so_killafter = v
            return
        }
        i = i + 1
    }
}

// start social (w = 0) or melder (w = 1); returns the slot (0 = failed)
fn sv2_spawn(state: u64, w: u64) -> u64 {
    if w == 0 {
        var p_so: [u8; 12] = "/bin/social\0"
        var a_so: [u8; 13] = "social\0serve\0"
        return desk_spawn_n(state, (&p_so[0]) as u64, (&a_so[0]) as u64, 13, 2)
    }
    var p_me: [u8; 12] = "/bin/melder\0"
    var a_me: [u8; 13] = "melder\0serve\0"
    return desk_spawn_n(state, (&p_me[0]) as u64, (&a_me[0]) as u64, 13, 2)
}

// remember what was started (slot + its process number) and arm the watch
fn sv2_arm(state: u64, w: u64, slot: u64) {
    sv2_slot[w as usize] = slot
    sv2_tpid[w as usize] = jv_stamp(state, slot)
    sv2_born[w as usize] = kstate.get(state, kstate.TICKS)
    sv2_n[w as usize] = sv2_n[w as usize] + 1
    if sv2_wait[w as usize] == 0 {
        sv2_wait[w as usize] = 500
    }
    sv2_armed[w as usize] = 1
}

fn sv2_say(state: u64, w: u64, tail: u64, v: u64) {
    var s_s: [u8; 13] = "desk: social\0"
    var s_m: [u8; 13] = "desk: melder\0"
    var s_e: [u8; 12] = " ended slot\0"
    var s_r: [u8; 13] = " respawn pid\0"
    let z: u64 = serial.line_at(sched.hier(state))
    if w == 0 {
        serial.puts((&s_s[0]) as u64)
    } else {
        serial.puts((&s_m[0]) as u64)
    }
    if tail == 0 {
        serial.puts((&s_e[0]) as u64)
    } else {
        serial.puts((&s_r[0]) as u64)
    }
    serial.put(61 as u8)
    serial.dec(v)
    serial.nl()
    serial.line_clear(z)
}

fn sv2_watch_one(state: u64, w: u64) {
    let wi: usize = w as usize
    if sv2_armed[wi] == 0 {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    let sl: u64 = sv2_slot[wi]
    if sl != 0 {
        var dead: bool = false
        if sl >= kstate.MAX_TASKS {
            dead = true
        } else {
            let stt: u64 = sched.tget(state, sl, sched.T_STATE)
            let stamp_now: u64 = sched.tget(state, sl, sched.T_PID)
            if w == 0 && so_killafter != 0 && stt != sched.S_ZOMBIE && stt != sched.S_FREE
                && stamp_now == sv2_tpid[wi] && now - sv2_born[wi] >= so_killafter {
                let _k: u64 = sched.kill_other(state, sl, sv2_tpid[wi], 9)
                sv2_born[wi] = now
                return
            }
            if stt != sched.S_FREE && stamp_now != sv2_tpid[wi] {
                dead = true
            } else if stt == sched.S_ZOMBIE {
                let _r: bool = proc.reap(state, sl)
                dead = true
            } else if stt == sched.S_FREE {
                dead = true
            }
        }
        if !dead {
            return
        }
        sv2_say(state, w, 0, sl)
        if now - sv2_born[wi] >= 12000 {
            sv2_wait[wi] = 500
        }
        sv2_slot[wi] = 0
        sv2_next[wi] = now + sv2_wait[wi]
        sv2_wait[wi] = sv2_wait[wi] * 2
        if sv2_wait[wi] > 6000 {
            sv2_wait[wi] = 6000
        }
        return
    }
    if now < sv2_next[wi] {
        return
    }
    let slot: u64 = sv2_spawn(state, w)
    if slot == 0 {
        sv2_next[wi] = now + sv2_wait[wi]
        sv2_wait[wi] = sv2_wait[wi] * 2
        if sv2_wait[wi] > 6000 {
            sv2_wait[wi] = 6000
        }
        return
    }
    sv2_arm(state, w, slot)
    sv2_say(state, w, 1, sv2_tpid[wi])
}

fn sv2_watch(state: u64) {
    sv2_watch_one(state, 0)
    sv2_watch_one(state, 1)
}

fn shell_respawn(state: u64, w: u64) -> u64 {
    var p_task: [u8; 13] = "/bin/taskbar\0"
    var a_task: [u8; 8] = "taskbar\0"
    var p_star: [u8; 14] = "/bin/launcher\0"
    var a_star: [u8; 18] = "starter\0versteckt\0"
    var a_vis: [u8; 8] = "starter\0"
    var p_dh: [u8; 10] = "/bin/dhcp\0"
    var a_dh: [u8; 11] = "dhcp\0dauer\0"
    if w == shellsup.W_DHCP {
        return desk_spawn_svc(state, 2, (&p_dh[0]) as u64, (&a_dh[0]) as u64, 11, 2)
    }
    if w == shellsup.W_TASKBAR {
        return desk_spawn(state, (&p_task[0]) as u64, (&a_task[0]) as u64, 8)
    }
    if kstate.mode_on(state, kstate.M_LAUNCHERVIS) {
        return desk_spawn_n(state, (&p_star[0]) as u64, (&a_vis[0]) as u64, 8, 1)
    }
    return desk_spawn_n(state, (&p_star[0]) as u64, (&a_star[0]) as u64, 18, 2)
}

fn shell_watch_one(state: u64, w: u64) {
    if shellsup.watch(state, w) == 0 {
        return
    }
    let slot: u64 = shell_respawn(state, w)
    if slot == 0 {
        shellsup.spawn_failed(state, w)
        return
    }
    shellsup.arm(state, w, slot)
}

fn shell_watch(state: u64) {
    shell_watch_one(state, shellsup.W_TASKBAR)
    shell_watch_one(state, shellsup.W_LAUNCHER)
    shell_watch_one(state, shellsup.W_DHCP)
}

fn jarvis_watch(state: u64) {
    if jv_armed == 0 {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if jv_pid != 0 {
        var sl: u64 = jv_pid
        if jv_noname != 0 {
            // control sample: the original mistake -- the slot number looked up as a process number
            sl = sched.find_pid(state, jv_pid)
        }
        var dead: bool = false
        if sl >= kstate.MAX_TASKS {
            dead = true
        } else {
            let stt: u64 = sched.tget(state, sl, sched.T_STATE)
            let stamp_now: u64 = sched.tget(state, sl, sched.T_PID)
            if jv_killafter != 0 && stt != sched.S_ZOMBIE && now - jv_born >= jv_killafter {
                var s_k: [u8; 21] = "desk: jarvisd killed\0"
                serial.puts((&s_k[0]) as u64)
                serial.nl()
                let _k: u64 = sched.kill_other(state, sl, jv_tpid, 9)
                jv_born = now
                return
            }
            if jv_noname == 0 && stt != sched.S_FREE && stamp_now != jv_tpid {
                // the slot belongs to another process now: ours ended (and was reaped) long ago
                dead = true
            } else if stt == sched.S_ZOMBIE {
                let _r: bool = proc.reap(state, sl)
                dead = true
            } else if stt == sched.S_FREE {
                // already reaped by somebody else; the slot still carries the pid
                dead = true
            }
        }
        if !dead {
            return
        }
        var s_e: [u8; 25] = "desk: jarvisd ended pid=\0"
        let z_e: u64 = serial.line_at(sched.hier(state))
        serial.puts((&s_e[0]) as u64)
        serial.dec(jv_pid)
        serial.nl()
        serial.line_clear(z_e)
        if now - jv_born >= 12000 {
            jv_wait = 500
        }
        jv_pid = 0
        jv_backoff(state, now)
        return
    }
    if now < jv_next {
        return
    }
    var p_jv: [u8; 13] = "/bin/jarvisd\0"
    var a_jv: [u8; 8] = "jarvisd\0"
    let pid: u64 = desk_spawn_svc(state, 3, (&p_jv[0]) as u64,
        (&a_jv[0]) as u64, 8, 1)
    if pid == 0 {
        jv_backoff(state, now)
        return
    }
    jv_pid = pid
    jv_tpid = jv_stamp(state, pid)
    jv_born = now
}

// W-J (17.10.2026): while the desktop is ACTIVE (pointer input or a painted frame in the last 200 ms) a round is ~1 ms (yield-spin on the
// TSC) instead of 10-20 ms (`sleep_ticks(1)` + `idle_wait`), so a USB/PS2 packet is seen within ~1 ms. Rest: false -> the caller sleeps on
// the tick as before (no spinning at rest). Word `nolatfix` = old loop (gate counter-proof).
fn lj_wait(state: u64) -> bool {
    if !wm.lj_fast(state) {
        return false
    }
    let kh: u64 = time.khz(state)
    if kh < 1000 {
        return false
    }
    let end: u64 = time.tsc() + (kh / 1000) * 1000
    while time.tsc() < end {
        sched.yield_now(state)
    }
    return true
}

// W-X1 (18.10.2026): IDLE BACKOFF OF THE KERNEL DESKTOP LOOP (r1076). The loop ran its full round (~30 pollers + compose test) on EVERY
// timer tick even on a dead-quiet desktop: QEMU 5.6-7.2 % of a core, VirtualBox ~25 %. After QUIET_TICKS (2 s) without a sign of life it
// runs one round per QUIET_DEPTH ticks (30 ms); the ticks in between are `hlt`s that end at once when input arrives. Latency: the polled
// devices (USB) are seen at most QUIET_DEPTH ticks late ONCE per quiet stretch, PS2 pointer / keys end the wait at the interrupt.
const QUIET_TICKS: u64 = 200
const QUIET_DEPTH: u64 = 3
const QUIET_FRAME_GAP: u64 = 8
static mut quiet_rounds: u64 = 0
// why the quiet state was left: 0 pointer path hot, 1 input counters moved, 2 host flush pending, 3 frames closer than QUIET_FRAME_GAP
static mut quiet_why: [u64; 4] = [0 as u64; 4]

// A number that changes whenever an input source delivered something (any change counts, it is only compared for inequality).
fn quiet_seq(state: u64) -> u64 {
    return usb.reports(state) + xhci.events(state) + ps2m.packets(state) + usb.hid_keys(state)
        + kstate.get(state, kstate.KEYLEN) + kstate.get(state, kstate.K11_OFF + kstate.KB_HHEAD)
}

// Input arrived or the pointer path got hot: leave the extra waiting at once.
fn quiet_wake(state: u64, seq: u64) -> bool {
    if wm.input_hot(state) {
        return true
    }
    if quiet_seq(state) != seq {
        return true
    }
    // (not kbd.waiting: a key byte nobody consumes would end every wait at once -- measured, the rounds stayed at 93/s)
    return false
}

// More ticks of `hlt` up to the tick `goal`; bounded, so a dead timer cannot hold the loop.
fn quiet_more(state: u64, goal: u64, seq: u64) {
    var n: u64 = 0
    while n < 8 && kstate.get(state, kstate.TICKS) < goal {
        if quiet_wake(state, seq) {
            return
        }
        sched.idle_wait(state)
        n = n + 1
    }
}

fn wait_wm(state: u64, i: u64, tw: u64) -> u64 {
    let duration: bool = kstate.mode_on(state, kstate.M_WMDAUER)
    st(27)
    if i == 0 && !duration {
        st(28)
        return 0xFFFFFFFFFFFFFFFF
    }
    st(29)
    var s_d: [u8; 12] = "wm: dauer\0\0\0"
    if duration {
        serial.puts((&s_d[0]) as u64)
        serial.nl()
    }
    // W-J: the latency gate (word `phases`) starts its pointer workload at the first `wm: hold` line; the real loop prints it once
    if duration && fb.phases_an(state) {
        var s_wj: [u8; 10] = "wm: hold\0\0"
        serial.puts((&s_wj[0]) as u64)
        serial.nl()
    }
    var cur: u64 = i
    var rounds: u64 = 0
    // W-X1: quiet-backoff state (tick of the last sign of life, input / frame counters seen then)
    var q_t0: u64 = kstate.get(state, kstate.TICKS)
    var q_seq: u64 = quiet_seq(state)
    var q_frames: u64 = wm.frames_total(state)
    var q_fr_t: u64 = q_t0
    var neustarts: u64 = 0
    var shell_next: u64 = 0
    var shell_born: u64 = 0
    var shell_back: u64 = 100
    // r1040 (17.10.2026): with the word `nokbd` the console read returns 0 at once (sys.fi), so the shell sees EOF and says `sh: bye`
    // the moment it starts. Nobody can type into it, so it is not restarted at all (the test machines have no keyboard).
    var shell_gone: bool = false
    var naechster: u64 = kstate.get(state, kstate.TICKS) + PULSE_MARKS
    var next_round: u64 = PULSE_ROUNDS
    var last_mark: u64 = kstate.get(state, kstate.TICKS)
    st(30)
    while duration || rounds < 20000 {
        st(31)
        wmrunden = rounds
        stall_spin(state)
        safe.loop(state)
        // ==================================== RUNDE ACPI-EREIGNISSE
        sub(1)
        acpiev.pump(state)
        sub(2)
        jarvis_watch(state)
        sv2_watch(state)
        shell_watch(state)
        sub(3)
        svc_flush(state)
        sub(4)
        if cur != 0 && sched.tget(state, cur, sched.T_STATE) == sched.S_ZOMBIE {
            let code: u64 = sched.tget(state, cur, sched.T_EXIT)
            proc.reap(state, cur)
            if !duration {
                return code
            }
            // W-L (17.10.2026): the one second is a DEADLINE now, not a sleep. `sleep_ticks` returned at once (dead-timer yield / nosched
            // desktop), so a shell that dies at start was respawned every round: an ELF load + reap of ~25 ms inside the round (single-CPU
            // latency gate: 2486 spawns, section k5 = 25 ms in every round). The loop keeps running; the restart waits for the deadline.
            // A shell that lived less than 3 s doubles the wait (1 s, 2 s, 4 s ... 30 s): a crash loop must not eat the rounds.
            cur = 0
            if kstate.mode_on(state, kstate.M_NOKBD) {
                shell_gone = true
            }
            let t_dead: u64 = kstate.get(state, kstate.TICKS)
            if t_dead - shell_born < 300 {
                shell_back = shell_back * 2
                if shell_back > 3000 {
                    shell_back = 3000
                }
            } else {
                shell_back = 100
            }
            shell_next = t_dead + shell_back
        }
        if cur == 0 && !shell_gone && shell_next != 0 && kstate.get(state, kstate.TICKS) >= shell_next {
            shell_next = 0
            cur = shell_start(state)
            if cur != 0 {
                neustarts = neustarts + 1
                shell_born = kstate.get(state, kstate.TICKS)
            } else {
                shell_next = kstate.get(state, kstate.TICKS) + shell_back
            }
        }
        // r1058 (z11, VBox): copy / paste mailboxes were only emptied from the mouse IRQ (trap.fi -> gfx.wm_poll), so a paste showed up at the
        // next mouse event. The desktop loop empties them every round too (nothing waiting = two loads).
        dnd_pump(state)
        termclip_pump(state)
        if wm.tt_want_spawn(state) {
            tabs_spawn(state)
        }
        tabs_reap(state)
        sub(5)
        mausflut_schritt(state)
        sub(6)
        st(32)
        usb.poll(state)
        let _oh: bool = ohci.poll_wm(state)
        // z10d: the idle task starves on a busy desktop (ohci polls == wmpolls in the pulse line), so the display confirm
        // deadline never fired in the VM. Run the same check from the window-server loop.
        let _dp: bool = vmode.poll(state)
        i2chid.poll_tick(state)
        st(33)
        usb.hotplug_work(state)
        if netdev.late_usb(state) {
            netsvc.stage(state)
        }
        wechsel_schritt(state)
        st(34)
        sub(7)
        wm.poll(state)
        sub(8)
        wm.lj_round(state)
        lock_watch(state)
        // RUNDE LOGIND: der Abmeldewunsch, siehe `abmelde_wache`.
        abmelde_wache(state)
        standby_wache(state)
        window_watch(state)
        winch_wache(state)
        hup_wache(state)
        // Y2 (17.10.2026): the VMSVGA host hint (VirtualBox: guest device request) is polled HERE as well. On the VirtualBox laptop VM
        // the idle task never reached gfx.gpu_ereignis (pulse hp=0/0/0), so the hint was never read. host_pending rate-limits itself
        // (1 s), so this is a clock read per call.
        // r1297/r1299: EVERY round, not every 64th. On the VirtualBox VM a round is long and rounds run only when something happens, so
        // 64 rounds were up to ~60 s of wall time until a resize hint was even looked at (measured 66 s, hint 1280x720 -> mode switch);
        // the guest then sat on the old picture and, after the switch, on the dark compositor background until the next repaint.
        if vmsvga.is_ready(state) && !vgpu.usable(state) {
            let hp: u64 = vmsvga.host_pending(state)
            if hp != 0 {
                let _hf: u64 = vmode.follow_host(state, hp / 65536, hp % 65536)
            }
        }
        if kstate.mode_on(state, kstate.M_VMSVGAHINTS) && (rounds & 63) == 0 {
            hint_player(state)
        }
        sub(9)
        zombie_sweep(state)
        sub(10)
        st(35)
        // 24.09.2026: THE WINDOW MOVEMENTS TICK HERE TOO. `anim_tick`
        // stood only in the hold loop of `surface`; on the desktop every
        // window that opened with a movement (all of them: WIG create ->
        // `open_anim`) stayed in it FOREVER -- composed pixel by pixel
        // through the blending path, and a window closed with the
        // title-bar cross was never destroyed. Measured with a debug line
        // in `compose`: the login window carried W_ANK=1 for as long as
        // it existed.
        let _an: u64 = wm.anim_tick(state)
        sub(11)
        if wm.lj_may_compose(state) {
            wm.compose(state)
        }
        // VMSVGA / virtio-gpu: THE FRAME BOUNDARY OF THE REAL DESKTOP (vbfixD, 16.10.2026). `compose` (and the ring-3 compositor's
        // CP_PRESENT) only copy into the card's memory and NOTE the box; the host learns about it from `gfx.bild_fertig` (VMSVGA: one
        // UPDATE, virtio-gpu: TRANSFER + FLUSH). Only the hold loops of `surface` called it, so on the real desktop (this loop) not one
        // UPDATE ever followed the first picture -- invisible in QEMU (it scans the VRAM itself), a frozen / patchy screen in VirtualBox
        // once TRACES=0 stopped the host from watching the VRAM. One call per round, on this one core: with nothing painted it costs a
        // time read and compares (no port I/O). tools/vmsvga/desktop.sh is the gate.
        sub(12)
        wm.cadence_note(state, vmsvga.is_ready(state) && vmsvga.pending(state))
        gfx.bild_fertig(state)
        wm.lj_done(state)
        sub(13)
        st(36)
        board_shell(cur)
        header_paint(state)
        sub(14)
        st(37)
        if duration {
            let now: u64 = kstate.get(state, kstate.TICKS)
            var feuern: bool = false
            if now >= naechster + pulse_extra() {
                naechster = now + PULSE_MARKS
                next_round = rounds + PULSE_ROUNDS
                last_mark = now
                feuern = true
            } else if rounds >= next_round {
                next_round = rounds + PULSE_ROUNDS
                if now == last_mark {
                    feuern = true
                }
            }
            if feuern {
                // W-X3: the pulse + board lines go into the serial ring (no THRE busy-wait); the timer bottom half drains it
                ser_defer_on(state)
                sub(20)
                input_pulse(state, tw, neustarts)
                sub(21)
                vmsvga.pulse_say(state)
                sub(22)
                if fb.phases_an(state) {
                    sect_say(state)
                    // per-task ticks: which task holds the core between two desktop rounds (single-CPU latency, W-L)
                    sched.dump_tasks(state)
                }
                sub(23)
                board_serial_on()
                ser_defer_off(state)
                if fb.termdump_an(state) {
                    wm.term_dump(state, wm.term_win(state))
                    wm.term_dump_all(state)
                }
                if cur == 0 && shell_next == 0 && !shell_gone {
                    cur = shell_start(state)
                    if cur != 0 {
                        neustarts = neustarts + 1
                        shell_born = kstate.get(state, kstate.TICKS)
                    }
                }
            }
        }
        if kstate.mode_on(state, kstate.M_KNALL) {
            if kstate.get(state, kstate.TICKS) > 1000 {
                __mmio_write64(0x00007FFFFFFF0000 as *mut u64, 1)
            }
        }
        if kstate.mode_on(state, kstate.M_ZUMACHEN) {
            let jj: u64 = kstate.get(state, kstate.TICKS)
            if jj > 1000 && jj >= close_mark {
                close_mark = jj + 500
                if close_done == 0 {
                    let ti: u64 = wm.term_win(state)
                    if ti < wm.MAX_WIN {
                        let pkt: u64 = wm.cross_point(state, ti)
                        ps2m.set_pos(state, pkt >> 32, pkt & 0xFFFFFFFF)
                        wm.poll(state)
                        ps2m.usb_packet(state, 8 | ps2m.B_LEFT, 0, 0, 0,
                            false)
                        let _p1: bool = wm.poll(state)
                        ps2m.usb_packet(state, 8, 0, 0, 0, false)
                        let _p2: bool = wm.poll(state)
                        close_window = ti + 1
                    }
                } else {
                    ps2m.set_pos(state, 400 + close_done * 40, 500)
                    let _p3: bool = wm.poll(state)
                    close_window = wm.close_top(state) + 1
                }
                close_done = close_done + 1
                close_say(state)
            }
        }
        sub(15)
        st(38)
        if duration && lj_wait(state) {
            // W-J: active stretch -> ~1 ms rounds (input is polled in this loop)
            board_quiet = 0
            q_t0 = kstate.get(state, kstate.TICKS)
            q_seq = quiet_seq(state)
            q_frames = wm.frames_total(state)
            q_fr_t = q_t0
        } else {
            // W-X1 (18.10.2026): quiet backoff. After QUIET_TICKS without any sign of life (pointer / key input, a painted frame, a
            // pending host flush) the round runs every QUIET_DEPTH-th tick instead of every tick; the extra ticks are plain `hlt`s that end
            // at once when input shows up (quiet_wake). Word `noquiet` = old loop (gate counter-proof).
            var depth: u64 = 1
            if duration && !kstate.mode_on(state, kstate.M_NOQUIET) {
                let now_q: u64 = kstate.get(state, kstate.TICKS)
                let seq_q: u64 = quiet_seq(state)
                let fr_q: u64 = wm.frames_total(state)
                var busy_q: bool = false
                if wm.input_hot(state) {
                    busy_q = true
                    quiet_why[0] = quiet_why[0] + 1
                }
                if seq_q != q_seq {
                    busy_q = true
                    quiet_why[1] = quiet_why[1] + 1
                }
                if vmsvga.is_ready(state) && vmsvga.pending(state) {
                    busy_q = true
                    quiet_why[2] = quiet_why[2] + 1
                }
                if fr_q != q_frames {
                    // a single frame after a long gap (cursor blink, clock, a repaint) is ambient; frames closer than QUIET_FRAME_GAP
                    // ticks (an animation, a client drawing at speed) are activity
                    if now_q - q_fr_t < QUIET_FRAME_GAP {
                        busy_q = true
                        quiet_why[3] = quiet_why[3] + 1
                    }
                    q_fr_t = now_q
                    q_frames = fr_q
                }
                if busy_q {
                    q_t0 = now_q
                    q_seq = seq_q
                } else if now_q - q_t0 >= QUIET_TICKS {
                    depth = QUIET_DEPTH
                }
                quiet_rounds = quiet_rounds + (depth - 1)
            }
            board_quiet = depth - 1
            let t_goal: u64 = kstate.get(state, kstate.TICKS) + depth
            sched.sleep_ticks(state, 1)
            // 04.10.2026 (Dell): wait for the next interrupt instead of spinning
            // (see `sched.idle_wait`); only in the permanent desktop, where the
            // timer is known to run.
            if duration && !fb.hlt_aus(state) {
                sched.idle_wait(state)
                if depth > 1 {
                    quiet_more(state, t_goal, q_seq)
                }
            }
        }
        rounds = rounds + 1
    }
    return 0xFFFFFFFFFFFFFFFE
}

const QUIET_PULSE_EXTRA: u64 = 2500

// W-X3: periodic serial reports go through the non-blocking ring (serial.defer_on) -- except with the profiling word `phases`:
// its dumps are many KB, the ring would overflow, and gates that count stalls (latency) see the old blocking timing.
fn ser_defer_on(state: u64) {
    if !fb.phases_an(state) {
        serial.defer_on()
    }
}

fn ser_defer_off(state: u64) {
    if !fb.phases_an(state) {
        serial.defer_off()
    }
}

fn pulse_extra() -> u64 {
    if board_quiet != 0 {
        return QUIET_PULSE_EXTRA
    }
    return 0
}
const PULSE_MARKS: u64 = 500
const PULSE_ROUNDS: u64 = 4000

static mut header: [u8; 176] = [0 as u8; 176]
static mut header_n: u64 = 0

fn header_set(state: u64, p: u64, n: u64) {
    var i: u64 = 0
    var m: u64 = n
    if m > 175 {
        m = 175
    }
    while i < m {
        kstate.set8((&header[0]) as u64 + i, kstate.get8(p + i) as u8)
        i = i + 1
    }
    header_n = m
}

// ====================================== RUNDE MESSTAFEL: SIEBEN ZEILEN
const BOARD_LINES: u64 = 25
const BOARD_COLUMNS: u64 = 48

fn tz_text(state: u64, buf: u64, at: u64, t: u64) -> u64 {
    return pulse_text(state, buf, at, t)
}

const BOARD_MARKS: u64 = 10
// W-X1 (18.10.2026): on a quiet desktop (see `quiet_seq`) the board repaints once per second instead of 10x per second. The board was the
// whole idle cost of the `boot` task: ~1.2 ms per desktop round (changed lines: tick / IRQ / paint counters + a host flush each) = 9-10 %
// of a core on QEMU, ~25 % on VirtualBox. Input or a painted frame ends the quiet state within one tick.
const BOARD_QUIET_MARKS: u64 = 1000
static mut board_quiet: u64 = 0

fn board_iv() -> u64 {
    if board_quiet != 0 {
        return BOARD_QUIET_MARKS
    }
    return BOARD_MARKS
}
const BOARD_ROUNDS: u64 = 200
const BOARD_SERIAL_MARKS: u64 = 500
// RUNDE BLECHFUENF: die Gegenprobe `zumachen`.
static mut close_done: u64 = 0
static mut close_window: u64 = 0
static mut close_mark: u64 = 0

fn close_say(state: u64) {
    var s_z: [u8; 12] = "zumachen n=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_c: [u8; 4] = " c=\0"
    serial.puts((&s_z[0]) as u64)
    serial.dec(close_done)
    serial.puts((&s_w[0]) as u64)
    serial.dec(close_window)
    serial.puts((&s_c[0]) as u64)
    serial.dec(wm.count(state))
    serial.nl()
}
static mut board_mark: u64 = 0
static mut board_round: u64 = 0
static mut board_sh: u64 = 0
static mut board_serial: u64 = 0

fn board_serial_on() {
    board_serial = 1
    header_serial = 1
}

static mut header_serial: u64 = 0

fn header_line_say(state: u64, b: u64, n: u64) {
    if header_serial == 0 {
        return
    }
    var v: [u8; 8] = "tafel: \0"
    let z: u64 = serial.line_at(sched.hier(state))
    ser_defer_on(state)
    serial.puts((&v[0]) as u64)
    serial.text(b, n)
    serial.nl()
    ser_defer_off(state)
    serial.line_clear(z)
}

static mut hp_gen: u64 = 0
static mut hp_gone: u64 = 0

fn wechsel_schritt(state: u64) {
    var s_d: [u8; 20] = "kgui: wechsel gen=\0\0"
    var s_w: [u8; 8] = "  weg=\0\0"
    var s_v: [u8; 9] = "  vfs=\0\0\0"
    let gen: u64 = usb.msc_gen(state)
    let gone: u64 = usb.msc_weg(state)
    if gen != hp_gen || gone != hp_gone {
        serial.puts((&s_d[0]) as u64)
        serial.dec(gen)
        serial.puts((&s_w[0]) as u64)
        serial.dec(gone)
        serial.puts((&s_v[0]) as u64)
        serial.dec(kutil.yes(vfs.ready(state)))
        serial.nl()
    }
    if gone != hp_gone {
        hp_gone = gone
        var i: u64 = 0
        while i < blk.MAX_USB {
            let d: u64 = blk.usb_dev(i)
            if !usb.msc_ready_at(state, i) && wechsel.hat_dev(state, d) {
                let _n: u64 = wechsel.geht(state, d)
            }
            i = i + 1
        }
    }
    if gen != hp_gen {
        hp_gen = gen
        var j: u64 = 0
        while j < blk.MAX_USB {
            let d2: u64 = blk.usb_dev(j)
            if usb.msc_ready_at(state, j) && !wechsel.hat_dev(state, d2) {
                let _i: u64 = wechsel.kommt(state, d2)
            }
            j = j + 1
        }
    }
}

fn board_shell(v: u64) {
    board_sh = v
}

fn board_line_say(state: u64, b: u64, n: u64) {
    if board_serial == 0 {
        return
    }
    var v: [u8; 8] = "tafel: \0"
    let z: u64 = serial.line_at(sched.hier(state))
    ser_defer_on(state)
    serial.puts((&v[0]) as u64)
    serial.text(b, n)
    serial.nl()
    ser_defer_off(state)
    serial.line_clear(z)
}

const BOARD_SP: u64 = 48 // Zeichen je gemerkter Zeile
static mut board_txt: [u8; 1200] = [0 as u8; 1200] // TAFEL_ZEILEN * TAFEL_SP
static mut board_len: [u64; 25] = [0 as u64; 25]
static mut board_fg: [u64; 25] = [0 as u64; 25]
static mut board_has: u64 = 0
static mut board_inside: u64 = 0 // Wiedereintrittssperre
static mut board_irq: u64 = 0
static mut board_paint: u64 = 0 // Anstriche
static mut board_loop: u64 = 0
static mut board_irqm: u64 = 0
static mut board_serial_mark: u64 = 0
static mut hz_tsc: u64 = 0
static mut hz_irq: u64 = 0
static mut hz_value: u64 = 0

fn hz_takt(state: u64) -> u64 {
    let k: u64 = time.khz(state)
    if k == 0 {
        return 0
    }
    let t: u64 = time.tsc()
    if hz_tsc == 0 || t <= hz_tsc || board_irq < hz_irq {
        hz_tsc = t
        hz_irq = board_irq
        return hz_value
    }
    let dt: u64 = t - hz_tsc
    if dt < k * 1000 {
        return hz_value
    }
    let di: u64 = board_irq - hz_irq
    hz_value = di * k * 1000 / dt
    hz_tsc = t
    hz_irq = board_irq
    return hz_value
}

static mut zu_lang: u64 = 0
static mut lang_max: u64 = 0
static mut long_line: u64 = 0

fn board_remember(line: u64, p: u64, n: u64, fg: u64) {
    if line >= BOARD_LINES {
        return
    }
    var m: u64 = n
    if m > BOARD_SP {
        zu_lang = zu_lang | (1 << line)
        if n > lang_max {
            lang_max = n
            long_line = line
        }
        m = BOARD_SP
    }
    let target: u64 = (&board_txt[0]) as u64 + line * BOARD_SP
    var i: u64 = 0
    while i < m {
        kstate.set8(target + i, kstate.get8(p + i) as u8)
        i = i + 1
    }
    board_len[line as usize] = m
    board_fg[line as usize] = fg
    board_has = 1
}

static mut ab_klinke: u64 = 0
static mut ab_count: u64 = 0
static mut ab_vec: u64 = 0
static mut ab_rip: u64 = 0
static mut ab_cr2: u64 = 0
static mut ab_rsp: u64 = 0
static mut ab_err: u64 = 0
static mut ab_cs: u64 = 0
static mut ab_kern: u64 = 0
static mut ab_haelt: u64 = 0 // haelt dieser Kern danach an?
static mut ab_trace: [u64; 5] = [0 as u64; 5]
static mut ab_spurn: u64 = 0
static mut ab_stopp: u64 = 0

fn crash_lines(state: u64) {
    var b: [u8; 64] = [0 as u8; 64]
    let p: u64 = (&b[0]) as u64
    let rot: u64 = wm.mess_rot(state)
    var names: [u8; 128] = "#DE\0#DB\0NMI\0#BP\0#OF\0#BR\0#UD\0#NM\0#DF\0#CO\0#TS\0#NP\0#SS\0#GP\0#PF\0r15\0#MF\0#AC\0#MC\0#XM\0#VE\0#CP\0r22\0r23\0r24\0r25\0r26\0#HV\0#VC\0#SX\0r30\0r31\0"
    var t0: [u8; 10] = "9 KNALL  \0"
    var s_n: [u8; 4] = "N \0\0"
    var s_v: [u8; 5] = " VEK\0"
    var s_k: [u8; 4] = " K\0\0"
    var s_h: [u8; 8] = " HAELT\0\0"
    var s_w: [u8; 8] = " WEITER\0"
    var n: u64 = 0
    n = pulse_text(state, p, 0, (&t0[0]) as u64)
    n = pulse_text(state, p, n, (&s_n[0]) as u64)
    n = pulse_num(state, p, n, ab_count)
    n = pulse_text(state, p, n, (&s_v[0]) as u64)
    n = pulse_num(state, p, n, ab_vec)
    if ab_vec < 32 {
        n = pulse_text(state, p, n, (&names[0]) as u64 + ab_vec * 4)
    }
    n = pulse_text(state, p, n, (&s_k[0]) as u64)
    n = pulse_num(state, p, n, ab_kern)
    if ab_haelt != 0 {
        n = pulse_text(state, p, n, (&s_h[0]) as u64)
    } else {
        n = pulse_text(state, p, n, (&s_w[0]) as u64)
    }
    board_remember(9, p, n, rot)
    board_line_say(state, p, n)

    var t1: [u8; 10] = "13 KRIP  \0"
    var s_c: [u8; 7] = "  CS \0\0"
    var s_e: [u8; 7] = " ERR \0\0"
    n = pulse_text(state, p, 0, (&t1[0]) as u64)
    n = pulse_hexn(state, p, n, ab_rip, 8)
    n = pulse_text(state, p, n, (&s_c[0]) as u64)
    n = pulse_hexn(state, p, n, ab_cs & 0xFFFF, 4)
    n = pulse_text(state, p, n, (&s_e[0]) as u64)
    n = pulse_hexn(state, p, n, ab_err & 0xFFFF, 4)
    if ab_vec == 14 {
        var s_r: [u8; 7] = " CR2 \0\0"
        n = pulse_text(state, p, n, (&s_r[0]) as u64)
        n = pulse_hexn(state, p, n, ab_cr2, 8)
    } else {
        var s_s: [u8; 7] = " RSP \0\0"
        n = pulse_text(state, p, n, (&s_s[0]) as u64)
        n = pulse_hexn(state, p, n, ab_rsp, 8)
    }
    board_remember(13, p, n, rot)
    board_line_say(state, p, n)
}

fn from_line(state: u64, z: u64, p: u64, n: u64, color: u64) {
    wm.messzeile(state, z, p, n, color)
    var v: [u8; 12] = "absturz:  ␀\0"
    serial.puts((&v[0]) as u64)
    serial.dec(z)
    serial.put(32 as u8)
    serial.text(p, n)
    serial.nl()
}

fn crash_hook() -> u64 {
    return ab_klinke
}

fn crash(state: u64, vec: u64, err: u64, rip: u64, cr2: u64, rsp: u64,
    cs: u64, kern: u64, trace: u64, spurn: u64, gestoppt: u64) {
    ab_count = ab_count + 1
    if ab_klinke == 0 {
        ab_vec = vec
        ab_rip = rip
        ab_cr2 = cr2
        ab_rsp = rsp
        ab_err = err
        ab_cs = cs
        ab_kern = kern
        ab_spurn = 0
        while ab_spurn < spurn && ab_spurn < 5 {
            ab_trace[ab_spurn as usize] =
                __mmio_read64((trace + ab_spurn * 8) as *mut u64)
            ab_spurn = ab_spurn + 1
        }
        ab_stopp = gestoppt
        ab_haelt = 0
        if kstate.mode_on(state, kstate.M_CRASH) {
            ab_haelt = 1
        }
        ab_klinke = 1
    }
    if !fb.ready(state) {
        return
    }
    var names: [u8; 128] = "#DE\0#DB\0NMI\0#BP\0#OF\0#BR\0#UD\0#NM\0#DF\0#CO\0#TS\0#NP\0#SS\0#GP\0#PF\0r15\0#MF\0#AC\0#MC\0#XM\0#VE\0#CP\0r22\0r23\0r24\0r25\0r26\0#HV\0#VC\0#SX\0r30\0r31\0"
    fb.band_open(state, true)
    if wm.measure_lines() != BOARD_LINES {
        var s_uz: [u8; 33] = "tafel: ZEILENZAHL UNGLEICH kgui=\0"
        var s_uw: [u8; 6] = "  wm=\0"
        serial.puts((&s_uz[0]) as u64)
        serial.dec(BOARD_LINES)
        serial.puts((&s_uw[0]) as u64)
        serial.dec(wm.measure_lines())
        serial.nl()
    }
    wm.measure_reason(state, BOARD_LINES, BOARD_COLUMNS)
    var b: [u8; 64] = [0 as u8; 64]
    let p: u64 = (&b[0]) as u64
    let rot: u64 = wm.mess_rot(state)
    let gelb: u64 = wm.mess_gelb(state)
    var n: u64 = 0

    var z0: [u8; 21] = "*** ABSTURZ *** VEK \0"
    var lz: [u8; 2] = " \0"
    n = pulse_text(state, p, 0, (&z0[0]) as u64)
    n = pulse_num(state, p, n, vec)
    n = pulse_text(state, p, n, (&lz[0]) as u64)
    if vec < 32 {
        n = pulse_text(state, p, n, (&names[0]) as u64 + vec * 4)
    }
    from_line(state, 0, p, n, rot)

    var z1: [u8; 5] = "RIP \0"
    n = pulse_text(state, p, 0, (&z1[0]) as u64)
    n = pulse_hexn(state, p, n, rip, 16)
    from_line(state, 1, p, n, rot)

    var z2: [u8; 5] = "CR2 \0"
    var z2a: [u8; 12] = "  (ALT, \0\0\0\0"
    var z2b: [u8; 17] = "gilt nur bei PF)\0"
    n = pulse_text(state, p, 0, (&z2[0]) as u64)
    n = pulse_hexn(state, p, n, cr2, 16)
    if vec != 14 {
        n = pulse_text(state, p, n, (&z2a[0]) as u64)
        n = pulse_text(state, p, n, (&z2b[0]) as u64)
    }
    from_line(state, 2, p, n, rot)

    var z3: [u8; 5] = "ERR \0"
    var z3b: [u8; 6] = "  CS \0"
    n = pulse_text(state, p, 0, (&z3[0]) as u64)
    n = pulse_hexn(state, p, n, err & 0xFFFFFFFF, 8)
    n = pulse_text(state, p, n, (&z3b[0]) as u64)
    n = pulse_hexn(state, p, n, cs & 0xFFFF, 4)
    from_line(state, 3, p, n, rot)

    var z4: [u8; 5] = "RSP \0"
    n = pulse_text(state, p, 0, (&z4[0]) as u64)
    n = pulse_hexn(state, p, n, rsp, 16)
    from_line(state, 4, p, n, rot)

    var z5: [u8; 10] = "STUFE ST \0"
    var z5b: [u8; 6] = " MAX \0"
    var z5c: [u8; 6] = " RND \0"
    n = pulse_text(state, p, 0, (&z5[0]) as u64)
    n = pulse_num(state, p, n, level_num())
    n = pulse_text(state, p, n, (&z5b[0]) as u64)
    n = pulse_num(state, p, n, level_max())
    n = pulse_text(state, p, n, (&z5c[0]) as u64)
    n = pulse_num(state, p, n, wm_runden())
    from_line(state, 5, p, n, gelb)

    var z7: [u8; 5] = "AUF \0"
    var z7b: [u8; 7] = " PID \0\0"
    var z7c: [u8; 7] = " ART \0\0"
    var z7d: [u8; 7] = " PRG \0\0"
    var z7e: [u8; 7] = " BAD \0\0"
    let cur: u64 = sched.current(state)
    n = pulse_text(state, p, 0, (&z7[0]) as u64)
    n = pulse_num(state, p, n, cur)
    n = pulse_text(state, p, n, (&z7b[0]) as u64)
    n = pulse_num(state, p, n, sched.tget(state, cur, sched.T_PID))
    n = pulse_text(state, p, n, (&z7c[0]) as u64)
    n = pulse_num(state, p, n, sched.tget(state, cur, sched.T_KIND))
    n = pulse_text(state, p, n, (&z7d[0]) as u64)
    var pn: u64 = 0
    while pn < 16 && pmon.name_at(state, cur, pn) != 0 {
        if n < BOARD_COLUMNS - 1 {
            kstate.set8(p + n, pmon.name_at(state, cur, pn) as u8)
            n = n + 1
        }
        pn = pn + 1
    }
    n = pulse_text(state, p, n, (&z7e[0]) as u64)
    n = pulse_num(state, p, n, proc.badentry_num())
    from_line(state, 6, p, n, gelb)

    var z8: [u8; 6] = "KERN \0"
    var z8a: [u8; 26] = " HAELT AN -- BITTE FOTO\0\0\0"
    var z8b: [u8; 29] = " LAEUFT WEITER -- BITTE FOTO\0"
    var z8c: [u8; 9] = "  NR \0\0\0\0"
    n = pulse_text(state, p, 0, (&z8[0]) as u64)
    n = pulse_num(state, p, n, ab_kern)
    if ab_haelt != 0 {
        n = pulse_text(state, p, n, (&z8a[0]) as u64)
    } else {
        n = pulse_text(state, p, n, (&z8b[0]) as u64)
    }
    n = pulse_text(state, p, n, (&z8c[0]) as u64)
    n = pulse_num(state, p, n, ab_count)
    from_line(state, 7, p, n, gelb)

    var z9: [u8; 7] = "SPUR ␀\0"
    var z9k: [u8; 9] = "(keine)␀\0"
    var z9l: [u8; 3] = " ␀\0"
    n = pulse_text(state, p, 0, (&z9[0]) as u64)
    if ab_spurn == 0 {
        n = pulse_text(state, p, n, (&z9k[0]) as u64)
    } else {
        var si: u64 = 0
        while si < ab_spurn && si < 4 {
            n = pulse_hexn(state, p, n, ab_trace[si as usize], 8)
            n = pulse_text(state, p, n, (&z9l[0]) as u64)
            si = si + 1
        }
    }
    from_line(state, 8, p, n, gelb)

    var za: [u8; 16] = "ANDERE KERNE: ␀\0"
    var zb: [u8; 22] = " NMI, MASCHINE STEHT␀\0"
    var zc: [u8; 18] = "keiner -- allein␀\0"
    n = pulse_text(state, p, 0, (&za[0]) as u64)
    if ab_stopp == 0 {
        n = pulse_text(state, p, n, (&zc[0]) as u64)
    } else {
        n = pulse_num(state, p, n, ab_stopp)
        n = pulse_text(state, p, n, (&zb[0]) as u64)
    }
    from_line(state, 9, p, n, gelb)

    fb.flush_rect(state, 0, 0, wm.mess_vollbreite(state),
        wm.messhoehe(state, BOARD_LINES))
    fb.band_open(state, false)
}

fn kstack_up(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var m: u64 = 0
    while i < n {
        if sched.tget(state, i, sched.T_STATE) != sched.S_FREE {
            let h: u64 = sched.stack_high(state, i)
            if h > m {
                m = h
            }
        }
        i = i + 1
    }
    return m
}

fn taskbar_state(state: u64) -> u64 {
    let tb: u64 = wm.panel_win(state)
    if tb >= wm.MAX_WIN {
        return 0
    }
    let o: u64 = wm.win_owner(state, tb)
    if o >= kstate.MAX_TASKS {
        return 0
    }
    return sched.tget(state, o, sched.T_STATE)
}

fn board_clear(state: u64) {
    if !fb.ready(state) {
        return
    }
    if board_inside != 0 {
        return
    }
    board_inside = 1
    board_paint = board_paint + 1
    if ab_klinke != 0 {
        crash_lines(state)
    }
    var tb: [u8; 64] = [0 as u8; 64]
    let tp: u64 = (&tb[0]) as u64
    //     tafel: 8 TICK  8 TICK  8 TICK  ... (vierundzwanzigmal)
    var t8: [u8; 9] = "8 TICK  \0"
    var t_i: [u8; 5] = "IRQ \0"
    var t_m: [u8; 6] = " MAL \0"
    var t_l: [u8; 7] = " LOOP \0"
    var tn: u64 = 0
    tn = pulse_text(state, tp, 0, (&t8[0]) as u64)
    tn = pulse_text(state, tp, tn, (&t_i[0]) as u64)
    tn = pulse_num(state, tp, tn, board_irq)
    tn = pulse_text(state, tp, tn, (&t_m[0]) as u64)
    tn = pulse_num(state, tp, tn, board_paint)
    tn = pulse_text(state, tp, tn, (&t_l[0]) as u64)
    tn = pulse_num(state, tp, tn, board_loop)
    var t_p: [u8; 6] = " PRE \0"
    tn = pulse_text(state, tp, tn, (&t_p[0]) as u64)
    tn = pulse_num(state, tp, tn, kstate.get(state, kstate.PREEMPT))
    var t_hz: [u8; 5] = " HZ \0"
    let hz: u64 = hz_takt(state)
    tn = pulse_text(state, tp, tn, (&t_hz[0]) as u64)
    tn = pulse_num(state, tp, tn, hz)
    board_remember(8, tp, tn, wm.mess_ampel(state, board_loop))
    board_line_say(state, tp, tn)

    var t9: [u8; 10] = "9 CALIB  \0"
    var k_l: [u8; 5] = "LSR \0"
    var t_s: [u8; 6] = " PIT \0"
    var k_v: [u8; 5] = " PM \0"
    var t_a: [u8; 6] = " ABW \0"
    var k_m: [u8; 5] = " FB \0"
    var k_wb: [u8; 3] = "WB\0"
    var k_wc: [u8; 3] = "WC\0"
    var k_uc: [u8; 3] = "UC\0"
    tn = pulse_text(state, tp, 0, (&t9[0]) as u64)
    tn = pulse_text(state, tp, tn, (&k_l[0]) as u64)
    tn = pulse_hex(state, tp, tn, serial.lsr_roh())
    tn = pulse_text(state, tp, tn, (&t_s[0]) as u64)
    tn = pulse_num(state, tp, tn, time.khz(state) / 1000)
    tn = pulse_text(state, tp, tn, (&k_v[0]) as u64)
    tn = pulse_num(state, tp, tn, hw.pm_tschz(state) / 1000000)
    tn = pulse_text(state, tp, tn, (&t_a[0]) as u64)
    tn = pulse_num(state, tp, tn, hw.pm_abweichung(state))
    tn = pulse_text(state, tp, tn, (&k_m[0]) as u64)
    if fb.uncached(state) {
        tn = pulse_text(state, tp, tn, (&k_uc[0]) as u64)
    } else if fb.wc(state) != 0 {
        tn = pulse_text(state, tp, tn, (&k_wc[0]) as u64)
    } else {
        tn = pulse_text(state, tp, tn, (&k_wb[0]) as u64)
    }
    var kfarbe: u64 = wm.mess_rot(state)
    if hw.pm_abweichung(state) < 10 {
        kfarbe = wm.mess_gruen(state)
    }
    board_remember(9, tp, tn, kfarbe)
    board_line_say(state, tp, tn)

    var t10: [u8; 10] = "10 BEAT  \0"
    var h_h: [u8; 6] = "SCHL \0"
    var h_t: [u8; 6] = " TOT \0"
    var h_l: [u8; 6] = " LED \0"
    var h_b: [u8; 8] = " BLINK \0"
    tn = pulse_text(state, tp, 0, (&t10[0]) as u64)
    tn = pulse_text(state, tp, tn, (&h_h[0]) as u64)
    tn = pulse_num(state, tp, tn, beat_num())
    tn = pulse_text(state, tp, tn, (&h_t[0]) as u64)
    tn = pulse_num(state, tp, tn, sched.dead_sleeps(state))
    tn = pulse_text(state, tp, tn, (&h_l[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.leds_sent(state))
    var h_v: [u8; 2] = "/\0"
    tn = pulse_text(state, tp, tn, (&h_v[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.leds_try(state))
    tn = pulse_text(state, tp, tn, (&h_v[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.leds_fail(state))
    tn = pulse_text(state, tp, tn, (&h_b[0]) as u64)
    tn = pulse_num(state, tp, tn, beat_brightnum())
    board_remember(10, tp, tn, wm.mess_ampel(state, beat_num()))
    board_line_say(state, tp, tn)

    // ---- Zeile 11: WAS AN USB HAENGT ----
    var t11: [u8; 10] = "11 USB   \0"
    var u_d: [u8; 5] = "DEV \0"
    var u_f: [u8; 7] = " FUND \0"
    var u_h: [u8; 6] = " HUB \0"
    var u_k: [u8; 6] = " KBD \0"
    var u_t: [u8; 6] = " TAS \0"
    var u_x: [u8; 7] = " FAIL \0"
    tn = pulse_text(state, tp, 0, (&t11[0]) as u64)
    tn = pulse_text(state, tp, tn, (&u_d[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.count(state))
    tn = pulse_text(state, tp, tn, (&u_f[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.fund_count(state))
    tn = pulse_text(state, tp, tn, (&u_h[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.hubs(state))
    tn = pulse_text(state, tp, tn, (&u_k[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.kbd_dev(state))
    tn = pulse_text(state, tp, tn, (&u_t[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.hid_keys(state))
    tn = pulse_text(state, tp, tn, (&u_x[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.fails(state))
    board_remember(11, tp, tn, wm.mess_ampel(state, usb.fund_count(state)))
    board_line_say(state, tp, tn)

    var t12: [u8; 10] = "12 STAGE \0"
    var s_st: [u8; 4] = "ST \0"
    var s_mx: [u8; 6] = " MAX \0"
    var s_rd: [u8; 6] = " RND \0"
    var s_lp: [u8; 7] = " LOOP \0"
    tn = pulse_text(state, tp, 0, (&t12[0]) as u64)
    tn = pulse_text(state, tp, tn, (&s_st[0]) as u64)
    tn = pulse_num(state, tp, tn, level_num())
    tn = pulse_text(state, tp, tn, (&s_mx[0]) as u64)
    tn = pulse_num(state, tp, tn, level_max())
    tn = pulse_text(state, tp, tn, (&s_rd[0]) as u64)
    tn = pulse_num(state, tp, tn, wm_runden())
    tn = pulse_text(state, tp, tn, (&s_lp[0]) as u64)
    tn = pulse_num(state, tp, tn, board_loop)
    var s_tb: [u8; 5] = " TB \0"
    tn = pulse_text(state, tp, tn, (&s_tb[0]) as u64)
    tn = pulse_num(state, tp, tn, taskbar_state(state))
    var ampel12: u64 = wm.mess_ampel(state, wm_runden())
    board_remember(12, tp, tn, ampel12)
    board_line_say(state, tp, tn)

    var t13: [u8; 10] = "13 IMAGE \0"
    var a_p: [u8; 6] = " PDE \0"
    var a_t: [u8; 6] = " PAT \0"
    var a_k: [u8; 6] = " KCH \0"
    let pde: u64 = fb.pde_roh(state)
    tn = pulse_text(state, tp, 0, (&t13[0]) as u64)
    tn = pulse_text(state, tp, tn, (&a_p[0]) as u64)
    tn = pulse_hexn(state, tp, tn, pde & 0xFFFF, 4)
    tn = pulse_text(state, tp, tn, (&a_t[0]) as u64)
    tn = pulse_hexn(state, tp, tn, (fb.pat_roh(state) >> 32) & 0xFF, 2)
    tn = pulse_text(state, tp, tn, (&a_k[0]) as u64)
    tn = pulse_num(state, tp, tn, fb.stripe_slots(state))
    var afarbe: u64 = wm.mess_rot(state)
    if (pde & 0x1000) != 0 || (pde & 0x18) != 0 {
        afarbe = wm.mess_gruen(state)
    }
    board_remember(13, tp, tn, afarbe)
    board_line_say(state, tp, tn)

    var t14: [u8; 10] = "14 PICK  \0"
    var w_hc: [u8; 4] = "HC \0"
    var w_vo: [u8; 2] = "/\0"
    var w_pk: [u8; 4] = " P \0"
    var w_ko: [u8; 2] = ",\0"
    var w_rv: [u8; 6] = " RVR \0"
    var w_rf: [u8; 6] = " RFL \0"
    var w_mm: [u8; 6] = " MMU \0"
    let nhc: u64 = xhci.count_hc(state)
    tn = pulse_text(state, tp, 0, (&t14[0]) as u64)
    tn = pulse_text(state, tp, tn, (&w_hc[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.choice(state))
    tn = pulse_text(state, tp, tn, (&w_vo[0]) as u64)
    tn = pulse_num(state, tp, tn, nhc)
    tn = pulse_text(state, tp, tn, (&w_pk[0]) as u64)
    var hi: u64 = 0
    while hi < nhc && hi < 4 {
        if hi != 0 {
            tn = pulse_text(state, tp, tn, (&w_ko[0]) as u64)
        }
        tn = pulse_num(state, tp, tn, usb.pkt_get(state, hi))
        hi = hi + 1
    }
    tn = pulse_text(state, tp, tn, (&w_rv[0]) as u64)
    tn = pulse_num(state, tp, tn, xhci.reset_vorbelegt(state))
    tn = pulse_text(state, tp, tn, (&w_rf[0]) as u64)
    tn = pulse_num(state, tp, tn, xhci.reset_fails(state))
    tn = pulse_text(state, tp, tn, (&w_mm[0]) as u64)
    tn = pulse_hexn(state, tp, tn, xhci.bar_pde(state) & 0xFFF, 3)
    board_remember(14, tp, tn, wm.mess_ampel(state, usb.kbd_dev(state)))
    board_line_say(state, tp, tn)

    var t15: [u8; 10] = "15 STRIP \0"
    var b_h: [u8; 3] = "H \0"
    var b_k: [u8; 6] = " KOL \0"
    var b_s: [u8; 5] = " SP \0"
    var b_w: [u8; 5] = " BR \0"
    let bh: u64 = fb.band(state)
    tn = pulse_text(state, tp, 0, (&t15[0]) as u64)
    tn = pulse_text(state, tp, tn, (&b_h[0]) as u64)
    tn = pulse_num(state, tp, tn, bh)
    tn = pulse_text(state, tp, tn, (&b_k[0]) as u64)
    tn = pulse_num(state, tp, tn, wm.mess_kol(state))
    tn = pulse_text(state, tp, tn, (&b_s[0]) as u64)
    tn = pulse_num(state, tp, tn, BOARD_COLUMNS)
    tn = pulse_text(state, tp, tn, (&b_w[0]) as u64)
    tn = pulse_num(state, tp, tn, wm.mess_vollbreite(state))
    board_remember(15, tp, tn, wm.mess_ampel(state, bh))
    board_line_say(state, tp, tn)

    var t16: [u8; 8] = "16 ISR \0"
    var i_m: [u8; 5] = "MAX \0"
    var i_v: [u8; 8] = " TVERL \0"
    var i_s: [u8; 8] = " SPAET \0"
    let us: u64 = trap.isr_us_max()
    tn = pulse_text(state, tp, 0, (&t16[0]) as u64)
    tn = pulse_text(state, tp, tn, (&i_m[0]) as u64)
    tn = pulse_num(state, tp, tn, us)
    tn = pulse_text(state, tp, tn, (&i_v[0]) as u64)
    tn = pulse_num(state, tp, tn, trap.ticks_lost())
    tn = pulse_text(state, tp, tn, (&i_s[0]) as u64)
    tn = pulse_num(state, tp, tn, trap.ticks_late())
    var i_lm: [u8; 5] = " LM \0"
    tn = pulse_text(state, tp, tn, (&i_lm[0]) as u64)
    tn = pulse_num(state, tp, tn, trap.ticks_lost_at() / 100)
    var ifarbe: u64 = wm.mess_gruen(state)
    if us > 5000 {
        ifarbe = wm.mess_rot(state)
    }
    board_remember(16, tp, tn, ifarbe)
    board_line_say(state, tp, tn)

    var t17: [u8; 10] = "17 BOARD \0"
    var q_g: [u8; 5] = "GPE \0"
    var q_s: [u8; 5] = " ST \0"
    var q_i: [u8; 6] = " IVR \0"
    var q_c: [u8; 6] = " CTL \0"
    var q_p: [u8; 6] = " PMT \0"
    let ivr: u64 = hw.ivrs_info(state)
    let ctl: u64 = hw.iommu_ctrl(state)
    tn = pulse_text(state, tp, 0, (&t17[0]) as u64)
    tn = pulse_text(state, tp, tn, (&q_g[0]) as u64)
    tn = pulse_num(state, tp, tn, hw.gpe_abgeschaltet(state))
    tn = pulse_text(state, tp, tn, (&q_s[0]) as u64)
    tn = pulse_hex(state, tp, tn, hw.gpe_status(state))
    tn = pulse_text(state, tp, tn, (&q_i[0]) as u64)
    tn = pulse_hexn(state, tp, tn, ivr & 0xFFFF, 4)
    tn = pulse_text(state, tp, tn, (&q_c[0]) as u64)
    tn = pulse_num(state, tp, tn, ctl & 1)
    tn = pulse_text(state, tp, tn, (&q_p[0]) as u64)
    tn = pulse_hexn(state, tp, tn, hw.pmtmr_port(state) & 0xFFFF, 4)
    var bfarbe: u64 = wm.mess_gruen(state)
    if (ctl & 1) != 0 {
        bfarbe = wm.mess_rot(state)
    }
    board_remember(17, tp, tn, bfarbe)
    board_line_say(state, tp, tn)

    var t18: [u8; 10] = "18 KEYS  \0"
    var k_d: [u8; 3] = "D \0"
    var k_b: [u8; 6] = " BER \0"
    var k_a: [u8; 6] = " ARM \0"
    var k_c: [u8; 5] = " CC \0"
    var k_r: [u8; 6] = " RK ␀\0"
    let kd: u64 = usb.kbd_dev(state)
    tn = pulse_text(state, tp, 0, (&t18[0]) as u64)
    tn = pulse_text(state, tp, tn, (&k_d[0]) as u64)
    tn = pulse_num(state, tp, tn, kd)
    var kfarb: u64 = wm.mess_rot(state)
    if kd != 0 {
        let kdev: u64 = kd - 1
        tn = pulse_text(state, tp, tn, (&k_b[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.dev_reps(state, kdev))
        tn = pulse_text(state, tp, tn, (&k_a[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.dev_arms(state, kdev))
        tn = pulse_text(state, tp, tn, (&k_c[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.dev_cc(state, kdev))
        let rw: u64 = usb.dev_rohw(state, kdev)
        tn = pulse_text(state, tp, tn, (&k_r[0]) as u64)
        tn = pulse_hexn(state, tp, tn, rw & 0xFF, 2)
        tn = pulse_hexn(state, tp, tn, (rw >> 16) & 0xFF, 2)
        tn = pulse_hexn(state, tp, tn, (rw >> 24) & 0xFF, 2)
        tn = pulse_hexn(state, tp, tn, (rw >> 32) & 0xFF, 2)
        var k_n: [u8; 5] = " N ␀\0"
        tn = pulse_text(state, tp, tn, (&k_n[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.dev_rohn(state, kdev))
        var k_w: [u8; 4] = " W \0"
        tn = pulse_text(state, tp, tn, (&k_w[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.wachen(state))
        var k_nu: [u8; 6] = " NEU \0"
        tn = pulse_text(state, tp, tn, (&k_nu[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.wiedern(state))
        if usb.dev_reps(state, kdev) != 0 {
            kfarb = wm.mess_gruen(state)
        }
    }
    board_remember(18, tp, tn, kfarb)
    board_line_say(state, tp, tn)

    var t19: [u8; 8] = "19 UHR \0"
    var u_r: [u8; 5] = "RTC \0"
    var u_dp: [u8; 2] = ":\0"
    var u_kr: [u8; 4] = " K \0"
    var u_tz: [u8; 4] = " Z \0"
    var u_dd: [u8; 4] = " D \0"
    var u_pt: [u8; 2] = ".\0"
    tn = pulse_text(state, tp, 0, (&t19[0]) as u64)
    tn = pulse_text(state, tp, tn, (&u_r[0]) as u64)
    tn = pulse_two(state, tp, tn, time.rtc_field(time.R_HOUR))
    tn = pulse_text(state, tp, tn, (&u_dp[0]) as u64)
    tn = pulse_two(state, tp, tn, time.rtc_field(time.R_MIN))
    tn = pulse_text(state, tp, tn, (&u_dp[0]) as u64)
    tn = pulse_two(state, tp, tn, time.rtc_field(time.R_SEC))
    let ks: u64 = time.now_local(state) % 86400
    tn = pulse_text(state, tp, tn, (&u_kr[0]) as u64)
    tn = pulse_two(state, tp, tn, ks / 3600)
    tn = pulse_text(state, tp, tn, (&u_dp[0]) as u64)
    tn = pulse_two(state, tp, tn, (ks % 3600) / 60)
    tn = pulse_text(state, tp, tn, (&u_dp[0]) as u64)
    tn = pulse_two(state, tp, tn, ks % 60)
    tn = pulse_text(state, tp, tn, (&u_tz[0]) as u64)
    tn = pulse_num(state, tp, tn, time.tz_min(state))
    tn = pulse_text(state, tp, tn, (&u_dd[0]) as u64)
    tn = pulse_two(state, tp, tn, time.rtc_field(time.R_DAY))
    tn = pulse_text(state, tp, tn, (&u_pt[0]) as u64)
    tn = pulse_two(state, tp, tn, time.rtc_field(time.R_MONTH))
    var u_u: [u8; 4] = " U \0"
    tn = pulse_text(state, tp, tn, (&u_u[0]) as u64)
    tn = pulse_num(state, tp, tn, time.rtc_utc(state))
    var ufarb: u64 = wm.mess_rot(state)
    if (ks / 60) % 60 == time.rtc_field(time.R_MIN) {
        ufarb = wm.mess_gruen(state)
    }
    board_remember(19, tp, tn, ufarb)
    board_line_say(state, tp, tn)

    var t24: [u8; 7] = "24 FB \0"
    var f_x: [u8; 2] = "x\0"
    var f_tf: [u8; 3] = " T\0"
    var f_zl: [u8; 3] = " Z\0"
    var f_t: [u8; 3] = " B\0"
    var f_sk: [u8; 3] = " S\0"
    var f_st: [u8; 3] = " R\0"
    let lw: u64 = fb.width(state)
    let lh: u64 = fb.height(state)
    let pw: u64 = fb.panel_w(state)
    let ph: u64 = fb.panel_h(state)
    tn = pulse_text(state, tp, 0, (&t24[0]) as u64)
    tn = pulse_num(state, tp, tn, lw)
    tn = pulse_text(state, tp, tn, (&f_x[0]) as u64)
    tn = pulse_num(state, tp, tn, lh)
    tn = pulse_text(state, tp, tn, (&f_tf[0]) as u64)
    tn = pulse_num(state, tp, tn, pw)
    tn = pulse_text(state, tp, tn, (&f_x[0]) as u64)
    tn = pulse_num(state, tp, tn, ph)
    tn = pulse_text(state, tp, tn, (&f_zl[0]) as u64)
    tn = pulse_num(state, tp, tn, fb.pitch(state))
    tn = pulse_text(state, tp, tn, (&f_t[0]) as u64)
    tn = pulse_num(state, tp, tn, fb.bpp(state))
    tn = pulse_text(state, tp, tn, (&f_sk[0]) as u64)
    tn = pulse_num(state, tp, tn, fb.uiscale(state))
    tn = pulse_text(state, tp, tn, (&f_st[0]) as u64)
    tn = pulse_num(state, tp, tn, bnum(fb.stripe(state)))
    var ffarb: u64 = wm.mess_gruen(state)
    if lw != pw || lh != ph {
        ffarb = wm.mess_rot(state)
    }
    board_remember(24, tp, tn, ffarb)
    board_line_say(state, tp, tn)

    var t20: [u8; 10] = "20 ENDP  \0"
    var e_k: [u8; 5] = "KBD \0"
    var e_m: [u8; 6] = " MAU \0"
    var e_e: [u8; 4] = "EP\0\0"
    var e_f: [u8; 3] = " F\0"
    var e_h: [u8; 3] = " H\0"
    var e_hg: [u8; 6] = " HEI \0"
    var e_op: [u8; 5] = " OP \0"
    let ekd: u64 = usb.kbd_dev(state)
    let emd: u64 = usb.mouse_dev(state)
    tn = pulse_text(state, tp, 0, (&t20[0]) as u64)
    tn = pulse_text(state, tp, tn, (&e_k[0]) as u64)
    tn = pulse_text(state, tp, tn, (&e_e[0]) as u64)
    var ekst: u64 = 0
    if ekd != 0 {
        ekst = usb.dev_epstate(state, ekd - 1)
    }
    tn = pulse_num(state, tp, tn, ekst)
    tn = pulse_text(state, tp, tn, (&e_f[0]) as u64)
    if ekd != 0 {
        tn = pulse_num(state, tp, tn, usb.dev_errs(state, ekd - 1))
    } else {
        tn = pulse_num(state, tp, tn, 0)
    }
    tn = pulse_text(state, tp, tn, (&e_h[0]) as u64)
    if ekd != 0 {
        tn = pulse_num(state, tp, tn, usb.dev_heal(state, ekd - 1))
    } else {
        tn = pulse_num(state, tp, tn, 0)
    }
    tn = pulse_text(state, tp, tn, (&e_m[0]) as u64)
    tn = pulse_text(state, tp, tn, (&e_e[0]) as u64)
    var emst: u64 = 0
    if emd != 0 {
        emst = usb.dev_epstate(state, emd - 1)
    }
    tn = pulse_num(state, tp, tn, emst)
    tn = pulse_text(state, tp, tn, (&e_f[0]) as u64)
    if emd != 0 {
        tn = pulse_num(state, tp, tn, usb.dev_errs(state, emd - 1))
    } else {
        tn = pulse_num(state, tp, tn, 0)
    }
    tn = pulse_text(state, tp, tn, (&e_hg[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.heilungen(state))
    tn = pulse_text(state, tp, tn, (&e_op[0]) as u64)
    tn = pulse_num(state, tp, tn, usb.without_space(state))
    var efarb: u64 = wm.mess_rot(state)
    if ekst == 1 {
        efarb = wm.mess_gruen(state)
    }
    board_remember(20, tp, tn, efarb)
    board_line_say(state, tp, tn)

    var t21: [u8; 10] = "21 FOUND \0"
    var f_dp: [u8; 2] = ":\0"
    var f_sp: [u8; 2] = " \0"
    var f_a: [u8; 2] = "A\0"
    var f_d: [u8; 2] = "D\0"
    var f_c: [u8; 2] = "C\0"
    var f_b: [u8; 2] = "B\0"
    var f_n: [u8; 2] = "-\0"
    tn = pulse_text(state, tp, 0, (&t21[0]) as u64)
    var fi: u64 = 0
    var fvoll: u64 = 0
    while fi < usb.fund_count(state) && fi < 5 {
        let fl: u64 = usb.fund_flags(state, fi)
        tn = pulse_num(state, tp, tn, usb.fund_port(state, fi))
        tn = pulse_text(state, tp, tn, (&f_dp[0]) as u64)
        if (fl & 1) != 0 {
            tn = pulse_text(state, tp, tn, (&f_a[0]) as u64)
        } else {
            tn = pulse_text(state, tp, tn, (&f_n[0]) as u64)
        }
        if (fl & 2) != 0 {
            tn = pulse_text(state, tp, tn, (&f_d[0]) as u64)
        } else {
            tn = pulse_text(state, tp, tn, (&f_n[0]) as u64)
        }
        if (fl & 4) != 0 {
            tn = pulse_text(state, tp, tn, (&f_c[0]) as u64)
        } else {
            tn = pulse_text(state, tp, tn, (&f_n[0]) as u64)
        }
        if (fl & 8) != 0 {
            tn = pulse_text(state, tp, tn, (&f_b[0]) as u64)
            fvoll = fvoll + 1
        } else {
            tn = pulse_text(state, tp, tn, (&f_n[0]) as u64)
        }
        tn = pulse_text(state, tp, tn, (&f_sp[0]) as u64)
        fi = fi + 1
    }
    if usb.fund_count(state) > 5 {
        var f_pl: [u8; 2] = "+\0"
        tn = pulse_text(state, tp, tn, (&f_pl[0]) as u64)
        tn = pulse_num(state, tp, tn, usb.fund_count(state) - 5)
    }
    board_remember(21, tp, tn, wm.mess_ampel(state, fvoll))
    board_line_say(state, tp, tn)

    var t22: [u8; 9] = "22 NET  \0"
    var n_k: [u8; 3] = "K\0\0"
    var n_b: [u8; 6] = " BDF \0"
    var n_l: [u8; 4] = " L \0"
    var n_a: [u8; 6] = " ABL \0"
    var n_d: [u8; 2] = ":\0"
    var n_i: [u8; 5] = " IP \0"
    var n_p: [u8; 2] = ".\0"
    let nk0: u64 = netdev.kind_on(state, 0)
    tn = pulse_text(state, tp, 0, (&t22[0]) as u64)
    tn = pulse_text(state, tp, tn, (&n_k[0]) as u64)
    tn = pulse_num(state, tp, tn, nk0)
    tn = pulse_text(state, tp, tn, (&n_b[0]) as u64)
    tn = pulse_hexn(state, tp, tn, netdev.bdf_on(state, 0), 4)
    tn = pulse_text(state, tp, tn, (&n_l[0]) as u64)
    var lnk: u64 = 0
    if netdev.link_up_on(state, 0) {
        lnk = 1
    }
    tn = pulse_num(state, tp, tn, lnk)
    let abl: u64 = netdev.unsupported_count(state)
    tn = pulse_text(state, tp, tn, (&n_a[0]) as u64)
    tn = pulse_num(state, tp, tn, abl)
    if abl != 0 {
        tn = pulse_text(state, tp, tn, (&n_d[0]) as u64)
        tn = pulse_hexn(state, tp, tn, netdev.unsupported_vendor(state, 0), 4)
        tn = pulse_text(state, tp, tn, (&n_d[0]) as u64)
        tn = pulse_hexn(state, tp, tn, netdev.unsupported_device(state, 0), 4)
    }
    let adr: u64 = inet.ip(state)
    tn = pulse_text(state, tp, tn, (&n_i[0]) as u64)
    tn = pulse_num(state, tp, tn, (adr >> 24) & 255)
    tn = pulse_text(state, tp, tn, (&n_p[0]) as u64)
    tn = pulse_num(state, tp, tn, (adr >> 16) & 255)
    tn = pulse_text(state, tp, tn, (&n_p[0]) as u64)
    tn = pulse_num(state, tp, tn, (adr >> 8) & 255)
    tn = pulse_text(state, tp, tn, (&n_p[0]) as u64)
    tn = pulse_num(state, tp, tn, adr & 255)
    var n_dh: [u8; 3] = " D\0"
    let dst: u64 = inet.dhcp_get(0)
    let dtx: u64 = inet.dhcp_get(1)
    var dz: [u8; 2] = ".\0"
    if dst == 1 {
        dz[0] = 100 as u8 // d
        if dtx == 0 {
            dz[0] = 120 as u8 // x -- nichts ging hinaus
        }
    }
    if dst == 2 {
        dz[0] = 111 as u8 // o
    }
    if dst == 3 {
        dz[0] = 114 as u8 // r
    }
    if dst == 4 {
        dz[0] = 65 as u8 // A
    }
    if dst == 5 {
        dz[0] = 116 as u8 // t
    }
    if dst == 6 {
        dz[0] = 110 as u8 // n
    }
    tn = pulse_text(state, tp, tn, (&n_dh[0]) as u64)
    tn = pulse_text(state, tp, tn, (&dz[0]) as u64)
    var nfarb: u64 = wm.mess_rot(state)
    if nk0 != 0 {
        nfarb = wm.mess_ampel(state, lnk)
    }
    board_remember(22, tp, tn, nfarb)
    board_line_say(state, tp, tn)

    var t23: [u8; 12] = "23 SAFETY  \0"
    var q_wa: [u8; 5] = "WA ␀\0"
    var q_ks: [u8; 6] = " KS ␀\0"
    var q_rw: [u8; 7] = " R3W ␀\0"
    var q_rk: [u8; 7] = " R3K ␀\0"
    var q_lg: [u8; 6] = " LG ␀\0"
    tn = pulse_text(state, tp, 0, (&t23[0]) as u64)
    tn = pulse_text(state, tp, tn, (&q_wa[0]) as u64)
    tn = pulse_num(state, tp, tn, sched.guard_faults())
    tn = pulse_text(state, tp, tn, (&q_ks[0]) as u64)
    tn = pulse_num(state, tp, tn, kstack_up(state))
    tn = pulse_text(state, tp, tn, (&q_rw[0]) as u64)
    tn = pulse_num(state, tp, tn, sched.gs_error(state))
    tn = pulse_text(state, tp, tn, (&q_rk[0]) as u64)
    tn = pulse_num(state, tp, tn, sched.ring3_cores(state))
    tn = pulse_text(state, tp, tn, (&q_lg[0]) as u64)
    var lz: u64 = 0
    var lb: u64 = 0
    while lb < BOARD_LINES {
        if ((zu_lang >> lb) & 1) != 0 {
            lz = lz + 1
        }
        lb = lb + 1
    }
    tn = pulse_num(state, tp, tn, lz)
    if lz != 0 {
        var q_lz: [u8; 4] = " Z␀\0"
        tn = pulse_text(state, tp, tn, (&q_lz[0]) as u64)
        tn = pulse_num(state, tp, tn, long_line)
        var q_ls: [u8; 3] = " ␀\0"
        tn = pulse_text(state, tp, tn, (&q_ls[0]) as u64)
        tn = pulse_num(state, tp, tn, lang_max)
    }
    var f23: u64 = wm.mess_gruen(state)
    if sched.guard_faults() != 0 || sched.gs_error(state) != 0
       || zu_lang != 0 {
        f23 = wm.mess_rot(state)
    }
    board_remember(23, tp, tn, f23)
    board_line_say(state, tp, tn)
    if board_serial != 0 {
        sched.ring3_report(state)
        wm.term_dump(state, wm.term_win(state))
        wm.term_dump_all(state)
    }

    fb.band_open(state, true)
    board_comp = wm.composites(state)
    if board_background == 0 {
        board_background = 1
        wm.measure_reason(state, BOARD_LINES, BOARD_COLUMNS)
        fb.flush_rect(state, 0, 0, wm.mess_vollbreite(state),
            wm.messhoehe(state, BOARD_LINES))
    }
    let cur_width: u64 = wm.measure_width(state, BOARD_COLUMNS)
    let zh: u64 = wm.messzeile_h(state)
    var z: u64 = 0
    while z < BOARD_LINES {
        let n: u64 = board_len[z as usize]
        if n != 0 && board_changed(z, n) {
            wm.messzeile(state, z, (&board_txt[0]) as u64 + z * BOARD_SP,
                n, board_fg[z as usize])
            fb.flush_rect(state, wm.messzeile_x(state, z),
                wm.messzeile_y(state, z), cur_width, zh)
            board_remember_old(z, n)
        }
        z = z + 1
    }
    fb.band_open(state, false)
    board_inside = 0
}

static mut board_old: [u8; 1152] = [0 as u8; 1152]
static mut board_oldlen: [u64; 25] = [0 as u64; 25]
static mut board_oldfg: [u64; 25] = [0 as u64; 25]
static mut board_background: u64 = 0
static mut board_comp: u64 = 0

fn board_changed(z: u64, n: u64) -> bool {
    if board_oldlen[z as usize] != n {
        return true
    }
    if board_oldfg[z as usize] != board_fg[z as usize] {
        return true
    }
    let a: u64 = (&board_txt[0]) as u64 + z * BOARD_SP
    let b: u64 = (&board_old[0]) as u64 + z * BOARD_SP
    var i: u64 = 0
    while i < n {
        if kstate.get8(a + i) != kstate.get8(b + i) {
            return true
        }
        i = i + 1
    }
    return false
}

fn board_remember_old(z: u64, n: u64) {
    let a: u64 = (&board_txt[0]) as u64 + z * BOARD_SP
    let b: u64 = (&board_old[0]) as u64 + z * BOARD_SP
    var i: u64 = 0
    while i < n {
        kstate.set8(b + i, kstate.get8(a + i) as u8)
        i = i + 1
    }
    board_oldlen[z as usize] = n
    board_oldfg[z as usize] = board_fg[z as usize]
}

static mut level: u64 = 0
static mut level_up: u64 = 0
static mut wmrunden: u64 = 0

// W-L (17.10.2026): per-section clock of the desktop round. `st(n)` closes the section of the previous level: the TSC distance since the
// last `st` is charged to that level (31..38 = the sections of wait_wm). Printed with the pulse (`wm: sect`, word `phases`).
static mut sect_sum: [u64; 40] = [0 as u64; 40]
static mut sect_max: [u64; 40] = [0 as u64; 40]
static mut sect_n: [u64; 40] = [0 as u64; 40]
static mut sect_last: u64 = 0
// finer marks inside the sections: `sub(k)` charges the time since the previous mark to mark k (k = 1..39)
static mut sub_sum: [u64; 40] = [0 as u64; 40]
static mut sub_max: [u64; 40] = [0 as u64; 40]
static mut sub_last: u64 = 0

fn sub(k: u64) {
    let now: u64 = time.tsc()
    if sub_last != 0 && now > sub_last && k < 40 {
        let d: u64 = now - sub_last
        sub_sum[k as usize] = sub_sum[k as usize] + d
        if d > sub_max[k as usize] {
            sub_max[k as usize] = d
        }
    }
    sub_last = now
}

fn st(n: u64) {
    if level >= 31 && level <= 38 {
        let now: u64 = time.tsc()
        if sect_last != 0 && now > sect_last {
            let d: u64 = now - sect_last
            sect_sum[level as usize] = sect_sum[level as usize] + d
            sect_n[level as usize] = sect_n[level as usize] + 1
            if d > sect_max[level as usize] {
                sect_max[level as usize] = d
            }
        }
        sect_last = now
    } else if n >= 31 && n <= 38 {
        sect_last = time.tsc()
    }
    level = n
    if n > level_up {
        level_up = n
    }
}

// `wm: sect s31=<mean us>/<max us> ...` over the rounds since the last line; then the counters restart.
fn sect_say(state: u64) {
    let kh: u64 = time.khz(state)
    if kh < 1000 {
        return
    }
    let per_us: u64 = kh / 1000
    var s_h: [u8; 10] = "wm: sect \0"
    var s_s: [u8; 3] = " s\0"
    var s_e: [u8; 2] = "=\0"
    var s_m: [u8; 2] = "/\0"
    var s_n: [u8; 4] = " n=\0"
    serial.puts((&s_h[0]) as u64)
    var k: u64 = 31
    while k <= 38 {
        let n: u64 = sect_n[k as usize]
        serial.puts((&s_s[0]) as u64)
        serial.dec(k)
        serial.puts((&s_e[0]) as u64)
        if n != 0 {
            serial.dec(sect_sum[k as usize] / n / per_us)
        } else {
            serial.dec(0)
        }
        serial.puts((&s_m[0]) as u64)
        serial.dec(sect_max[k as usize] / per_us)
        k = k + 1
    }
    serial.puts((&s_n[0]) as u64)
    serial.dec(sect_n[31])
    serial.nl()
    var s_u: [u8; 10] = "wm: sub \0\0"
    var s_k: [u8; 2] = "k\0"
    serial.puts((&s_u[0]) as u64)
    k = 1
    while k < 40 {
        if sub_sum[k as usize] != 0 {
            serial.puts((&s_k[0]) as u64)
            serial.dec(k)
            serial.puts((&s_e[0]) as u64)
            let nn: u64 = sect_n[31]
            if nn != 0 {
                serial.dec(sub_sum[k as usize] / nn / per_us)
            } else {
                serial.dec(0)
            }
            serial.puts((&s_m[0]) as u64)
            serial.dec(sub_max[k as usize] / per_us)
            serial.puts((&s_s[0]) as u64)
        }
        k = k + 1
    }
    var s_q: [u8; 8] = " quiet=\0"
    serial.puts((&s_q[0]) as u64)
    serial.dec(quiet_rounds)
    var s_qs: [u8; 5] = " qs=\0"
    serial.puts((&s_qs[0]) as u64)
    serial.dec(usb.reports(state))
    serial.puts((&s_m[0]) as u64)
    serial.dec(xhci.events(state))
    serial.puts((&s_m[0]) as u64)
    serial.dec(ps2m.packets(state))
    serial.puts((&s_m[0]) as u64)
    serial.dec(usb.hid_keys(state))
    serial.puts((&s_m[0]) as u64)
    serial.dec(kstate.get(state, kstate.KEYLEN))
    serial.puts((&s_m[0]) as u64)
    serial.dec(kstate.get(state, kstate.K11_OFF + kstate.KB_HHEAD))
    var s_w: [u8; 7] = " why=\0\0"
    serial.puts((&s_w[0]) as u64)
    serial.dec(quiet_why[0])
    serial.puts((&s_m[0]) as u64)
    serial.dec(quiet_why[1])
    serial.puts((&s_m[0]) as u64)
    serial.dec(quiet_why[2])
    serial.puts((&s_m[0]) as u64)
    serial.dec(quiet_why[3])
    serial.nl()
    k = 0
    while k < 40 {
        sect_sum[k as usize] = 0
        sect_max[k as usize] = 0
        sect_n[k as usize] = 0
        sub_sum[k as usize] = 0
        sub_max[k as usize] = 0
        k = k + 1
    }
}

fn level_num() -> u64 {
    return level
}

fn level_max() -> u64 {
    return level_up
}

fn wm_runden() -> u64 {
    return wmrunden
}

static mut beat_n: u64 = 0
static mut beat_mark: u64 = 0
static mut beat_on: u64 = 0
static mut beat_secs: u64 = 0
static mut beat_led: u64 = 0
static mut beat_bright: u64 = 0

fn beat_num() -> u64 {
    return beat_n
}

fn beat_brightnum() -> u64 {
    return beat_bright
}

fn beat_tick(state: u64) {
    if !kstate.mode_on(state, kstate.M_BEAT) {
        return
    }
    beat_n = beat_n + 1
    let now: u64 = kstate.get(state, kstate.TICKS)
    if now < beat_mark + 25 {
        return
    }
    beat_mark = now
    beat_on = 1 - beat_on
    beat_bright = beat_bright + beat_on
    if kstate.mode_on(state, kstate.M_PULSLED) {
        fb.beat(state, 0, beat_on)
        fb.beat(state, 1, beat_on)
    }
    if !kstate.mode_on(state, kstate.M_PULSLED) {
        return
    }
    beat_secs = beat_secs + 1
    if (beat_secs & 1) == 0 {
        beat_led = 1 - beat_led
        usb.beat_leds(state, beat_led)
    }
}

fn stall_inputs(state: u64) -> u64 {
    return kstate.get(state, kstate.KEYS) + ps2m.packets(state) + ps2m.clicks(state)
}

fn stall_tick(state: u64) {
    frameprof.tick(state)
    sysmon.tick(state)
    let _s: bool = stall.check(state, stall_inputs(state), wmrunden, wm.frames_total(state))
    safe.tick(state, wmrunden)
}

fn stall_spin(state: u64) {
    let n: u64 = stall.spin_due(state, stall_inputs(state))
    if n == 0 {
        return
    }
    let end: u64 = kstate.get(state, kstate.TICKS) + n
    var spun: u64 = 0
    while kstate.get(state, kstate.TICKS) < end {
        spun = spun + 1
    }
}

fn board_tick(state: u64) {
    if !kstate.mode_on(state, kstate.M_BOARD) {
        return
    }
    board_irq = board_irq + 1
    if usb.busy(state) != 0 {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    var faellig: bool = false
    if now >= board_irqm + board_iv() {
        board_irqm = now
        faellig = true
    }
    if !faellig {
        return
    }
    if now >= board_serial_mark + BOARD_SERIAL_MARKS + pulse_extra() {
        board_serial_mark = now
        board_serial = 1
        header_serial = 1
    }
    ser_defer_on(state)
    board_clear(state)
    ser_defer_off(state)
    board_serial = 0
}

// ============ DAS STANDBILD, EINMAL, UNBEDINGT.
fn board_boot(state: u64, level: u64) {
    if !kstate.mode_on(state, kstate.M_BOARD) {
        return
    }
    if !fb.ready(state) {
        return
    }
    var s_b: [u8; 24] = "tafel: STANDBILD gemalt\0"
    var lz: [u8; 25] = "-- noch keine Messung --\0"
    var z: u64 = 0
    while z < BOARD_LINES {
        if board_len[z as usize] == 0 {
            board_remember(z, (&lz[0]) as u64, 24, wm.mess_gelb(state))
        }
        z = z + 1
    }
    var sb: [u8; 64] = [0 as u8; 64]
    let sp: u64 = (&sb[0]) as u64
    var t_st: [u8; 10] = "STANDBILD\0"
    var t_su: [u8; 8] = " STUFE \0"
    var sn: u64 = 0
    sn = pulse_text(state, sp, 0, (&t_st[0]) as u64)
    sn = pulse_text(state, sp, sn, (&t_su[0]) as u64)
    sn = pulse_num(state, sp, sn, level)
    board_remember(0, sp, sn, wm.mess_gelb(state))
    board_serial = 1
    board_clear(state)
    board_serial = 0
    serial.puts((&s_b[0]) as u64)
    serial.nl()
}

fn header_paint(state: u64) {
    if !fb.ready(state) {
        return
    }
    // ===================================================== RUNDE TUERSCHLOSS
    if !kstate.mode_on(state, kstate.M_BOARD)
        || kstate.mode_on(state, kstate.M_NOTAFEL) {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    board_round = board_round + 1
    if now != board_mark {
        if now < board_mark + board_iv() {
            return
        }
        board_mark = now
        board_round = 0
    } else {
        if board_round < BOARD_ROUNDS {
            return
        }
        board_round = 0
    }
    board_loop = board_loop + 1
    var buf: [u8; 64] = [0 as u8; 64]
    let b: u64 = (&buf[0]) as u64
    var n: u64 = 0

    var t_b: [u8; 4] = " B\0\0"
    var t_t: [u8; 4] = " T\0\0"
    n = tz_text(state, b, 0, version.text())
    n = tz_text(state, b, n, (&t_b[0]) as u64)
    n = pulse_num(state, b, n, wm.composites(state))
    n = tz_text(state, b, n, (&t_t[0]) as u64)
    n = pulse_num(state, b, n, kstate.get(state, kstate.TICKS))
    var t_sh: [u8; 5] = " sh\0\0"
    n = tz_text(state, b, n, (&t_sh[0]) as u64)
    n = pulse_num(state, b, n, board_sh)
    var t_to: [u8; 5] = " TO\0\0"
    var t_tp: [u8; 5] = " TP\0\0"
    n = tz_text(state, b, n, (&t_to[0]) as u64)
    n = pulse_num(state, b, n, wm.term_outs(state))
    n = tz_text(state, b, n, (&t_tp[0]) as u64)
    n = pulse_num(state, b, n, wm.term_puts_n(state))
    board_remember(0, b, n, wm.mess_weiss(state))
    header_line_say(state, b, n)

    var t1: [u8; 12] = "1 USB  BER \0"
    var t_w: [u8; 7] = " WAHL \0"
    let ber: u64 = usb.reports(state)
    n = tz_text(state, b, 0, (&t1[0]) as u64)
    n = pulse_num(state, b, n, ber)
    n = tz_text(state, b, n, (&t_w[0]) as u64)
    n = pulse_num(state, b, n, usb.choice(state))
    board_remember(1, b, n, wm.mess_ampel(state, ber))
    header_line_say(state, b, n)

    // ---- Zeile 2: Stufe 2, eingereiht ----
    var t2: [u8; 9] = "2 QUEUE \0"
    var t_ta: [u8; 3] = "T\0\0"
    var t_ma: [u8; 4] = " M\0\0"
    var t_ka: [u8; 4] = " K\0\0"
    let e_ta: u64 = usb.hid_keys(state)
    let e_ma: u64 = ps2m.packets(state)
    n = tz_text(state, b, 0, (&t2[0]) as u64)
    n = tz_text(state, b, n, (&t_ta[0]) as u64)
    n = pulse_num(state, b, n, e_ta)
    n = tz_text(state, b, n, (&t_ma[0]) as u64)
    n = pulse_num(state, b, n, e_ma)
    n = tz_text(state, b, n, (&t_ka[0]) as u64)
    n = pulse_num(state, b, n, ps2m.clicks(state))
    var t_d: [u8; 4] = " D\0\0"
    n = tz_text(state, b, n, (&t_d[0]) as u64)
    n = pulse_num(state, b, n, wm.downs(state))
    board_remember(2, b, n, wm.mess_ampel(state, e_ta + e_ma))
    header_line_say(state, b, n)

    var t3: [u8; 9] = "3 SERV  \0"
    let s_ta: u64 = wm.keyin(state)
    let s_ma: u64 = wm.moves_seen(state)
    n = tz_text(state, b, 0, (&t3[0]) as u64)
    n = tz_text(state, b, n, (&t_ta[0]) as u64)
    n = pulse_num(state, b, n, s_ta)
    n = tz_text(state, b, n, (&t_ma[0]) as u64)
    n = pulse_num(state, b, n, s_ma)
    board_remember(3, b, n, wm.mess_ampel(state, s_ta + s_ma))
    header_line_say(state, b, n)

    var t4: [u8; 10] = "4 RING   \0"
    var t_v: [u8; 8] = "  VERL \0"
    var t_ko: [u8; 7] = " KOAL \0"
    let rein: u64 = wm.evpush(state)
    let verl: u64 = wm.evdrops(state)
    n = tz_text(state, b, 0, (&t4[0]) as u64)
    n = pulse_num(state, b, n, rein)
    n = tz_text(state, b, n, (&t_v[0]) as u64)
    n = pulse_num(state, b, n, verl)
    n = tz_text(state, b, n, (&t_ko[0]) as u64)
    n = pulse_num(state, b, n, wm.evkoal(state))
    var f4: u64 = wm.mess_ampel(state, rein)
    if verl != 0 {
        f4 = wm.mess_rot(state)
    }
    board_remember(4, b, n, f4)
    header_line_say(state, b, n)

    var t5: [u8; 10] = "5 APP    \0"
    let raus: u64 = wm.evpop(state)
    n = tz_text(state, b, 0, (&t5[0]) as u64)
    n = pulse_num(state, b, n, raus)
    board_remember(5, b, n, wm.mess_ampel(state, raus))
    header_line_say(state, b, n)

    var t6: [u8; 10] = "6 CURSOR \0"
    var t_x: [u8; 3] = "X\0\0"
    var t_y: [u8; 4] = " Y\0\0"
    n = tz_text(state, b, 0, (&t6[0]) as u64)
    n = tz_text(state, b, n, (&t_x[0]) as u64)
    n = pulse_num(state, b, n, wm.curx(state))
    n = tz_text(state, b, n, (&t_y[0]) as u64)
    n = pulse_num(state, b, n, wm.cury(state))
    board_remember(6, b, n, wm.mess_ampel(state, s_ma))
    header_line_say(state, b, n)

    var t7: [u8; 10] = "7 PANEL  \0"
    var t_id: [u8; 4] = "id\0\0"
    var t_yy: [u8; 4] = " y\0\0"
    var t_ml: [u8; 6] = " MAL \0"
    var t_fl: [u8; 4] = " fl\0"
    let tb: u64 = wm.panel_win(state)
    n = tz_text(state, b, 0, (&t7[0]) as u64)
    if tb >= wm.MAX_WIN {
        var t_kein: [u8; 5] = "KEIN\0"
        n = tz_text(state, b, n, (&t_kein[0]) as u64)
        board_remember(7, b, n, wm.mess_rot(state))
    header_line_say(state, b, n)
    } else {
        let draw: u64 = wm.win_paints(state, tb)
        n = tz_text(state, b, n, (&t_id[0]) as u64)
        n = pulse_num(state, b, n, wm.win_id(state, tb))
        n = tz_text(state, b, n, (&t_yy[0]) as u64)
        n = pulse_num(state, b, n, wm.win_y(state, tb) as u64)
        n = tz_text(state, b, n, (&t_ml[0]) as u64)
        n = pulse_num(state, b, n, draw)
        n = tz_text(state, b, n, (&t_fl[0]) as u64)
        n = pulse_num(state, b, n, wm.win_flags(state, tb))
        var t_zu: [u8; 5] = " ZU \0"
        let bo: u64 = wm.win_owner(state, tb)
        n = tz_text(state, b, n, (&t_zu[0]) as u64)
        n = pulse_num(state, b, n, sched.tget(state, bo, sched.T_STATE))
        var l_tk: [u8; 5] = " TK \0"
        n = pulse_text(state, b, n, (&l_tk[0]) as u64)
        let tk: u64 = wm.title_clipped()
        n = pulse_num(state, b, n, tk)
        var f7: u64 = wm.mess_ampel(state, draw)
        if tk != 0 {
            f7 = wm.mess_rot(state)
        }
        board_remember(7, b, n, f7)
        header_line_say(state, b, n)
    }
    board_clear(state)
    board_serial = 0
    header_serial = 0
}

fn input_pulse(state: u64, tw: u64, neustarts: u64) {
    sub(24)
    usb.probe(state)
    sub(25)
    var buf: [u8; 200] = [0 as u8; 200]
    var n: u64 = 0
    var m_ber: [u8; 10] = "eingabe: \0"
    var m_b: [u8; 5] = "ber=\0"
    var m_i: [u8; 6] = " irq=\0"
    var m_e: [u8; 5] = " ev=\0"
    var m_s: [u8; 6] = " sts=\0"
    var m_n: [u8; 7] = " iman=\0"
    var m_mk: [u8; 5] = " mk=\0"
    var m_if: [u8; 5] = " if=\0"
    var m_t: [u8; 5] = " ta=\0"
    var m_l: [u8; 5] = " lo=\0"
    var m_w: [u8; 6] = " bew=\0"
    var m_p: [u8; 5] = " pk=\0"
    var m_x: [u8; 5] = " xy=\0"
    var m_k: [u8; 2] = ",\0"
    var m_m: [u8; 5] = " wm=\0"
    var m_c: [u8; 5] = " kl=\0"
    var m_sh: [u8; 5] = " sh=\0"
    var m_select: [u8; 7] = " wahl=\0"
    n = pulse_text(state, (&buf[0]) as u64, n, version.text())
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_select[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.choice(state))
    kstate.set8((&buf[0]) as u64 + n, 32)
    n = n + 1
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_ber[0]) as u64)
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_b[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.reports(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_i[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, xhci.irqs(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_e[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, xhci.events(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_s[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, xhci.usbsts(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_n[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, xhci.iman(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_mk[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, kstate.get(state, kstate.TICKS))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_if[0]) as u64)
    let fl: u64 = asm("pushfq\npop rax", out("rax"))
    n = pulse_num(state, (&buf[0]) as u64, n, (fl >> 9) & 1)
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_t[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.hid_keys(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_l[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.hid_los(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_w[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.hid_bew(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_p[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, ps2m.packets(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_x[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, ps2m.x(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_k[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, ps2m.y(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_m[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, wm.moves_seen(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_c[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, wm.downs(state))
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_sh[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, neustarts)
    var m_sc: [u8; 5] = " sc=\0"
    var m_sx: [u8; 5] = " sx=\0"
    var m_sj: [u8; 5] = " sj=\0"
    var m_dx: [u8; 5] = " dx=\0"
    var m_rp: [u8; 5] = " rp=\0"
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_sc[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.service_cpus())
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_sx[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.service_skips())
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_sj[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.service_seq_jumps())
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_dx[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, xhci.drain_overlaps())
    n = pulse_text(state, (&buf[0]) as u64, n, (&m_rp[0]) as u64)
    n = pulse_num(state, (&buf[0]) as u64, n, usb.ring_peak_get())
    kstate.set8((&buf[0]) as u64 + n, 10)
    n = n + 1
    if tw < wm.MAX_WIN && !kstate.mode_on(state, kstate.M_NOPULS) {
        let _w: u64 = wm.term_write(state, tw, (&buf[0]) as u64, n)
    }
    let pz: u64 = serial.line_at(sched.hier(state))
    wm.wins_say(state)
    ohci.pulse_say(state)
    if n > 0 {
        header_set(state, (&buf[0]) as u64, n - 1)
    }
    kstate.set8((&buf[0]) as u64 + n - 1, 0)
    serial.puts((&buf[0]) as u64)
    serial.nl()
    serial.line_clear(pz)
    kstate.set8((&buf[0]) as u64 + n - 1, 10)
}

fn pulse_text(state: u64, buf: u64, at: u64, t: u64) -> u64 {
    var n: u64 = at
    var i: u64 = 0
    while kstate.get8(t + i) != 0 && n < 190 {
        kstate.set8(buf + n, kstate.get8(t + i) as u8)
        n = n + 1
        i = i + 1
    }
    return n
}

fn pulse_two(state: u64, buf: u64, at: u64, v: u64) -> u64 {
    var n: u64 = at
    let w: u64 = v % 100
    kstate.set8(buf + n, (48 + w / 10) as u8)
    kstate.set8(buf + n + 1, (48 + w % 10) as u8)
    return n + 2
}

fn pulse_hexn(state: u64, buf: u64, at: u64, v: u64, digits: u64) -> u64 {
    var ziffern: [u8; 17] = "0123456789ABCDEF\0"
    var i: u64 = digits
    var n: u64 = at
    while i > 0 {
        i = i - 1
        kstate.set8(buf + n, ziffern[((v >> (i * 4)) & 15) as usize])
        n = n + 1
    }
    return n
}

fn pulse_hex(state: u64, buf: u64, at: u64, v: u64) -> u64 {
    var ziffern: [u8; 17] = "0123456789ABCDEF\0"
    var n: u64 = at
    if v > 255 {
        kstate.set8(buf + n, 45 as u8)
        kstate.set8(buf + n + 1, 45 as u8)
        return n + 2
    }
    kstate.set8(buf + n, ziffern[((v >> 4) & 15) as usize])
    kstate.set8(buf + n + 1, ziffern[(v & 15) as usize])
    return n + 2
}

fn pulse_num(state: u64, buf: u64, at: u64, v: u64) -> u64 {
    var ziffern: [u8; 24] = [0 as u8; 24]
    var k: u64 = 0
    var w: u64 = v
    if w == 0 {
        ziffern[0] = 0x30
        k = 1
    }
    while w != 0 && k < 20 {
        ziffern[k as usize] = (0x30 + (w % 10)) as u8
        w = w / 10
        k = k + 1
    }
    var n: u64 = at
    while k > 0 && n < 190 {
        k = k - 1
        kstate.set8(buf + n, ziffern[k as usize])
        n = n + 1
    }
    return n
}

fn say_mauslauf(state: u64) {
    if mauslauf_soll == 0 {
        return
    }
    var s: [u8; 18] = "mauslauf: pakete=\0"
    var s_us: [u8; 7] = "  us=\0\0"
    var s_cd: [u8; 11] = "  curdef=\0\0"
    var s_cm: [u8; 12] = "  curmove=\0\0"
    var s_ce: [u8; 11] = "  curerr=\0\0"
    var s_hw: [u8; 7] = "  hw=\0\0"
    serial.puts((&s[0]) as u64)
    serial.dec(mauslauf_ist)
    serial.puts((&s_us[0]) as u64)
    serial.dec(mauslauf_us)
    serial.puts((&s_cd[0]) as u64)
    serial.dec(vgpu.cursor_defs(state))
    serial.puts((&s_cm[0]) as u64)
    serial.dec(vgpu.cursor_moves(state))
    serial.puts((&s_ce[0]) as u64)
    serial.dec(vgpu.cursor_fehler(state))
    serial.puts((&s_hw[0]) as u64)
    if wm.hwcur_an(state) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()
}

fn say_wm_input(state: u64) {
    var s: [u8; 12] = "wminput: x=\0"
    var s_y: [u8; 5] = "  y=\0"
    var s_b: [u8; 7] = "  btn=\0"
    var s_p: [u8; 11] = "  packets=\0"
    var s_m: [u8; 9] = "  moves=\0"
    var s_d: [u8; 9] = "  drops=\0"
    var s_w: [u8; 9] = "  wheel=\0"
    var s_i: [u8; 8] = "  irqs=\0"
    var s_po: [u8; 9] = "  polls=\0"
    var s_sp: [u8; 12] = "  spurious=\0"
    var s_gs: [u8; 8] = "  gsi=\0\0"
    var s_dn: [u8; 9] = "  downs=\0"
    var s_mv: [u8; 12] = "  onmouse=\0\0"
    var s_ht: [u8; 8] = "  hits=\0"
    var s_e0: [u8; 7] = "  ev0=\0"
    var s_e1: [u8; 7] = "  ev1=\0"
    var s_z0: [u8; 6] = "  z0=\0"
    var s_z1: [u8; 6] = "  z1=\0"
    var s_k0: [u8; 9] = "  keys0=\0"
    var s_k1: [u8; 9] = "  keys1=\0"
    var s_wn: [u8; 13] = "wmafter: n=\0\0"
    var s_wf: [u8; 9] = "  focus=\0"
    var s_c: [u8; 10] = "  clicks=\0"
    var s_s: [u8; 11] = "  status=\0\0"
    serial.puts((&s[0]) as u64)
    serial.dec(ps2m.x(state))
    serial.puts((&s_y[0]) as u64)
    serial.dec(ps2m.y(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(ps2m.buttons(state))
    serial.puts((&s_p[0]) as u64)
    serial.dec(ps2m.packets(state))
    serial.puts((&s_m[0]) as u64)
    serial.dec(ps2m.moves(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(ps2m.drops(state))
    serial.puts((&s_w[0]) as u64)
    serial.dec(ps2m.wheel(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(ps2m.irqs(state))
    serial.puts((&s_po[0]) as u64)
    serial.dec(ps2m.polls(state))
    serial.puts((&s_sp[0]) as u64)
    serial.dec(ps2m.spurious(state))
    serial.puts((&s_gs[0]) as u64)
    serial.hex(apic.gsi_entry(state, 12))
    serial.puts((&s_dn[0]) as u64)
    serial.dec(wm.downs(state))
    serial.puts((&s_mv[0]) as u64)
    serial.dec(wm.moves_seen(state))
    serial.puts((&s_ht[0]) as u64)
    serial.dec(wm.hits_seen(state))
    serial.puts((&s_e0[0]) as u64)
    serial.dec(wm.ev_waiting(state, 0))
    serial.puts((&s_e1[0]) as u64)
    serial.dec(wm.ev_waiting(state, 1))
    serial.puts((&s_z0[0]) as u64)
    serial.dec(wm.win_z(state, 0))
    serial.puts((&s_z1[0]) as u64)
    serial.dec(wm.win_z(state, 1))
    serial.puts((&s_k0[0]) as u64)
    serial.dec(wm.win_keys(state, 0))
    serial.puts((&s_k1[0]) as u64)
    serial.dec(wm.win_keys(state, 1))
    serial.nl()
    serial.puts((&s_wn[0]) as u64)
    serial.dec(wm.count(state))
    serial.puts((&s_wf[0]) as u64)
    serial.dec(wm.focus(state))
    serial.puts((&s_c[0]) as u64)
    serial.dec(ps2m.clicks(state))
    serial.puts((&s_s[0]) as u64)
    serial.hex(ps2m.status())
    serial.nl()
    wmplug_bilanz(state)
}

fn wmplug_bilanz(state: u64) {
    if !wmplug.ready(state) {
        return
    }
    var s_b: [u8; 16] = "wmplug: bilanz␀␀"
    var s_p: [u8; 9] = "  plugs=␀"
    var s_i: [u8; 8] = "  evin=␀"
    var s_o: [u8; 9] = "  evout=␀"
    var s_k: [u8; 10] = "  kicks=␀␀"
    var s_d: [u8; 9] = "  deny=␀␀"
    var s_t: [u8; 12] = "  plugkeys=␀"
    serial.puts((&s_b[0]) as u64)
    serial.puts((&s_p[0]) as u64)
    serial.dec(wmplug.plugs(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(wmplug.events_in(state))
    serial.puts((&s_o[0]) as u64)
    serial.dec(wmplug.events_out(state))
    serial.puts((&s_k[0]) as u64)
    serial.dec(wmplug.kicks(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(wmplug.denials(state))
    serial.puts((&s_t[0]) as u64)
    serial.dec(wm.plugkeys(state))
    serial.nl()
}

fn say_font(state: u64, f: u64, px: u64, name: u64, s_font: u64, s_g: u64,
    s_upm: u64, s_asc: u64, s_desc: u64, s_lh: u64, s_kp: u64, s_st: u64,
    s_of: u64) {
    if f >= ttf.MAX_FONTS {
        return
    }
    serial.puts(s_font)
    serial.puts(name)
    serial.puts(s_g)
    serial.dec(ttf.glyphs(state, f))
    serial.puts(s_upm)
    serial.dec(ttf.upm(state, f))
    serial.puts(s_asc)
    serial.dec(ttf.ascent(state, f, px) as u64)
    serial.puts(s_desc)
    serial.dec(ttf.descent(state, f, px) as u64)
    serial.puts(s_lh)
    serial.dec(ttf.line_height(state, f, px))
    serial.puts(s_kp)
    serial.dec(kern_pairs(state, f, px))
    serial.puts(s_st)
    serial.dec(ttf.selftest(state, f))
    serial.puts(s_of)
    serial.dec(ttf.selftest_max())
    serial.nl()
}

fn kern_pairs(state: u64, f: u64, px: u64) -> u64 {
    var n: u64 = 0
    var a: u64 = 0x20
    while a <= 0x7E {
        var b: u64 = 0x20
        while b <= 0x7E {
            if ttf.kern26(state, f, ttf.glyph_of(state, f, a),
                ttf.glyph_of(state, f, b), px) != 0 {
                n = n + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    return n
}

fn grace_ready(state: u64) -> u64 {
    var s_gf: [u8; 18] = "gui: grace font=\0\0"
    var s_gfs: [u8; 8] = "  fs=\0\0\0"
    if ttf.fonts(state) > 0 {
        wig.race_ready(state, 0)
        return 0
    }
    let arena: u64 = mem.frame_run(state, WM_ARENA_FRAMES)
    if arena == 0
        || !ttf.init(state, arena, WM_ARENA_FRAMES * mem.FRAME_SIZE) {
        return 0xFFFFFFFFFFFFFFFF
    }
    if kstate.get(state, kstate.FS_READY) == 0 {
        var quelle: bool = false
        if bootmod.ready(state) {
            blk.ram_init(state, bootmod.base(state), bootmod.blocks(state))
            quelle = true
        } else {
            if blk.present(state) {
                blk.use_ata(state, kutil.root_blocks(state))
                quelle = true
            }
        }
        if quelle {
            let m: bool = fs.mount(state)
            serial.puts((&s_gfs[0]) as u64)
            serial.dec(kutil.yes(m))
        }
    }
    var p_sans: [u8; 15] = "/lib/sans.ttf\0\0"
    let f: u64 = load_font(state, (&p_sans[0]) as u64)
    serial.puts((&s_gf[0]) as u64)
    serial.dec(f)
    serial.nl()
    if f >= ttf.MAX_FONTS {
        return 0xFFFFFFFFFFFFFFFF
    }
    wig.race_ready(state, f)
    return f
}

fn grace_soll(state: u64, index: u64) -> u64 {
    return wig.race_soll(state, index)
}

fn grace_core(state: u64, index: u64, runden: u64, soll: u64) -> u64 {
    return wig.race_core(state, index, runden, soll)
}

fn grace_cold(state: u64) {
    ttf.cache_clear(state)
}

fn load_font(state: u64, cur_path: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return ttf.MAX_FONTS
    }
    let ino: u64 = fs.path(state, cur_path)
    if ino == 0 {
        return ttf.MAX_FONTS
    }
    let n: u64 = fs.inode_size(state, ino)
    if n < 12 || n > 1048576 {
        return ttf.MAX_FONTS
    }
    let frame: u64 = (n + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    let buf: u64 = mem.frame_run(state, frame)
    if buf == 0 {
        return ttf.MAX_FONTS
    }
    var off: u64 = 0
    while off < n {
        var c: u64 = n - off
        if c > 4096 {
            c = 4096
        }
        let got: u64 = fs.read_at(state, ino, off, buf + off, c)
        if got == 0 {
            off = n
        } else {
            off = off + got
        }
    }
    return ttf.load_font(state, buf, n)
}

fn glyph_sum(state: u64, slot: u64) -> u64 {
    var acc: u64 = 2166136261
    var i: u64 = 0
    let n: u64 = ttf.g_w(state, slot) * ttf.g_h(state, slot)
    while i < n {
        let a: u64 = ttf.g_pixel(state, slot, i % ttf.g_w(state, slot),
            i / ttf.g_w(state, slot))
        acc = ((acc ^ a) *% 16777619) & 0xFFFFFFFF
        i = i + 1
    }
    return acc
}

fn say_glyph(state: u64, f: u64, px: u64, c: u64) {
    var s_g: [u8; 12] = "ttfglyph c=\0"
    var s_px: [u8; 6] = "  px=\0"
    var s_w: [u8; 5] = "  w=\0"
    var s_h: [u8; 5] = "  h=\0"
    var s_l: [u8; 8] = "  left=\0"
    var s_t: [u8; 7] = "  top=\0"
    var s_a: [u8; 7] = "  adv=\0"
    var s_s: [u8; 7] = "  sum=\0"
    var s_r: [u8; 10] = "ttfrow \0\0\0"
    var stufen: [u8; 11] = " .:-=+*#%@\0"
    let slot: u64 = ttf.glyph(state, f, c, px)
    serial.puts((&s_g[0]) as u64)
    serial.dec(c)
    serial.puts((&s_px[0]) as u64)
    serial.dec(px)
    serial.puts((&s_w[0]) as u64)
    serial.dec(ttf.g_w(state, slot))
    serial.puts((&s_h[0]) as u64)
    serial.dec(ttf.g_h(state, slot))
    serial.puts((&s_l[0]) as u64)
    serial.dec(ttf.g_left(state, slot) as u64)
    serial.puts((&s_t[0]) as u64)
    serial.dec(ttf.g_top(state, slot) as u64)
    serial.puts((&s_a[0]) as u64)
    serial.dec(ttf.g_adv(state, slot) as u64)
    serial.puts((&s_s[0]) as u64)
    serial.dec(glyph_sum(state, slot))
    serial.nl()
    var y: u64 = 0
    while y < ttf.g_h(state, slot) {
        serial.puts((&s_r[0]) as u64)
        serial.dec(y)
        serial.put(32 as u8)
        serial.put(124 as u8)
        var x: u64 = 0
        while x < ttf.g_w(state, slot) {
            let a: u64 = ttf.g_pixel(state, slot, x, y)
            serial.put(stufen[(a * 10 / 256) as usize])
            x = x + 1
        }
        serial.put(124 as u8)
        serial.nl()
        y = y + 1
    }
}

fn wm_bench(state: u64, f: u64, px: u64) {
    var s_c: [u8; 23] = "wmbench: compose full=\0"
    var s_us: [u8; 4] = " us\0"
    var s_sm: [u8; 10] = "  small=\0\0"
    var s_fa: [u8; 11] = "  factor=\0\0"
    var s_g: [u8; 21] = "wmbench: glyph cold=\0"
    var s_wa: [u8; 9] = "  warm=\0\0"
    var s_pc: [u8; 12] = " (je 95 Zn)\0"

    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return
    }
    var t: u64 = apic.tsc()
    var i: u64 = 0
    while i < K10_RUNDEN {
        wm.damage_all(state)
        wm.compose(state)
        i = i + 1
    }
    let full: u64 = us_of(state, apic.tsc() - t) / K10_RUNDEN
    t = apic.tsc()
    i = 0
    while i < K10_RUNDEN {
        wm.damage(state, 300, 300, 312, 318)
        wm.compose(state)
        i = i + 1
    }
    var small: u64 = us_of(state, apic.tsc() - t) / K10_RUNDEN
    serial.puts((&s_c[0]) as u64)
    serial.dec(full)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sm[0]) as u64)
    serial.dec(small)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_fa[0]) as u64)
    if small == 0 {
        small = 1
    }
    serial.dec(full * 100 / small)
    serial.nl()

    // 2. die Schriftrasterung
    if f < ttf.MAX_FONTS {
        let cold_px: u64 = px + 7
        t = apic.tsc()
        var c: u64 = 0x20
        while c <= 0x7E {
            ttf.glyph(state, f, c, cold_px)
            c = c + 1
        }
        let cold: u64 = us_of(state, apic.tsc() - t)
        t = apic.tsc()
        c = 0x20
        while c <= 0x7E {
            ttf.glyph(state, f, c, cold_px)
            c = c + 1
        }
        var warm: u64 = us_of(state, apic.tsc() - t)
        serial.puts((&s_g[0]) as u64)
        serial.dec(cold)
        serial.puts((&s_us[0]) as u64)
        serial.puts((&s_wa[0]) as u64)
        serial.dec(warm)
        serial.puts((&s_us[0]) as u64)
        serial.puts((&s_fa[0]) as u64)
        if warm == 0 {
            warm = 1
        }
        serial.dec(cold * 100 / warm)
        serial.puts((&s_pc[0]) as u64)
        serial.nl()
    }
}

const SOFTUI_RUNDEN: u64 = 20

fn wm_bench2(state: u64) {
    var s_c: [u8; 24] = "wmbench2: compose full=\0"
    var s_us: [u8; 4] = " us\0"
    var s_sm: [u8; 10] = "  small=\0\0"
    var s_sp: [u8; 13] = "  shadowpx=\0\0"
    var s_aa: [u8; 9] = "  aapx=\0\0"
    var s_sb: [u8; 12] = "  shbuild=\0\0"
    var s_r: [u8; 25] = "wmbench2: ringe   full=\0\0"
    var s_m: [u8; 25] = "wmbench2: maske   full=\0\0"
    var s_o: [u8; 25] = "wmbench2: ohne    full=\0\0"
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return
    }
    var t: u64 = apic.tsc()
    var i: u64 = 0
    while i < SOFTUI_RUNDEN {
        wm.damage_all(state)
        wm.compose(state)
        i = i + 1
    }
    let full: u64 = us_of(state, apic.tsc() - t) / SOFTUI_RUNDEN
    t = apic.tsc()
    i = 0
    while i < SOFTUI_RUNDEN {
        wm.damage(state, 300, 300, 312, 318)
        wm.compose(state)
        i = i + 1
    }
    let small: u64 = us_of(state, apic.tsc() - t) / SOFTUI_RUNDEN
    wm.paint_reset(state)
    wm.damage_all(state)
    wm.compose(state)
    serial.puts((&s_c[0]) as u64)
    serial.dec(full)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sm[0]) as u64)
    serial.dec(small)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(wm.shadow_px(state))
    serial.puts((&s_aa[0]) as u64)
    serial.dec(wm.aa_px(state))
    serial.puts((&s_sb[0]) as u64)
    serial.dec(wm.shadow_builds(state))
    serial.nl()
    wm.paint_reset(state)
    t = apic.tsc()
    i = 0
    while i < SOFTUI_RUNDEN {
        wm.damage_all(state)
        wm.compose(state)
        i = i + 1
    }
    let m_us: u64 = us_of(state, apic.tsc() - t) / SOFTUI_RUNDEN
    let m_sp: u64 = wm.shadow_px(state) / SOFTUI_RUNDEN
    let m_aa: u64 = wm.aa_px(state) / SOFTUI_RUNDEN
    wm.set_shadow_old(state, true)
    wm.paint_reset(state)
    t = apic.tsc()
    i = 0
    while i < SOFTUI_RUNDEN {
        wm.damage_all(state)
        wm.compose(state)
        i = i + 1
    }
    let r_us: u64 = us_of(state, apic.tsc() - t) / SOFTUI_RUNDEN
    let r_sp: u64 = wm.shadow_px(state) / SOFTUI_RUNDEN
    let r_aa: u64 = wm.aa_px(state) / SOFTUI_RUNDEN
    wm.set_shadow_old(state, false)
    let s1: u64 = wm.form(state, wm.FM_SHADOW)
    let s2: u64 = wm.form(state, wm.FM_SHADOW2)
    let _f1: bool = wm.set_form(state, wm.FM_SHADOW, 0)
    let _f2: bool = wm.set_form(state, wm.FM_SHADOW2, 0)
    t = apic.tsc()
    i = 0
    while i < SOFTUI_RUNDEN {
        wm.damage_all(state)
        wm.compose(state)
        i = i + 1
    }
    let o_us: u64 = us_of(state, apic.tsc() - t) / SOFTUI_RUNDEN
    let _f3: bool = wm.set_form(state, wm.FM_SHADOW, s1)
    let _f4: bool = wm.set_form(state, wm.FM_SHADOW2, s2)
    serial.puts((&s_o[0]) as u64)
    serial.dec(o_us)
    serial.puts((&s_us[0]) as u64)
    serial.nl()
    serial.puts((&s_m[0]) as u64)
    serial.dec(m_us)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(m_sp)
    serial.puts((&s_aa[0]) as u64)
    serial.dec(m_aa)
    serial.nl()
    serial.puts((&s_r[0]) as u64)
    serial.dec(r_us)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(r_sp)
    serial.puts((&s_aa[0]) as u64)
    serial.dec(r_aa)
    serial.nl()
    wm.paint_reset(state)
    wm.damage_all(state)
    wm.compose(state)
}

fn tile_conf(state: u64) -> u64 {
    if kstate.get(state, kstate.FS_READY) == 0 {
        return 0
    }
    var cur_path: [u8; 31] = "/users/osum/config/tiling.conf\0"
    let ino: u64 = fs.path(state, (&cur_path[0]) as u64)
    if ino == 0 {
        return 0
    }
    let n: u64 = fs.inode_size(state, ino)
    if n == 0 || n > 4000 {
        return 0
    }
    let buf: u64 = mem.frame_run(state, 1)
    if buf == 0 {
        return 0
    }
    var off: u64 = 0
    while off < n {
        var c: u64 = n - off
        if c > 4096 {
            c = 4096
        }
        let got: u64 = fs.read_at(state, ino, off, buf + off, c)
        if got == 0 {
            off = n
        } else {
            off = off + got
        }
    }
    let k: u64 = tile.bind_parse(state, buf, n)
    mem.frame_free_run(state, buf, 1)
    return k
}

fn tile_build(state: u64, n: u64, w: u64, h: u64) {
    tile.init(state, 0, 0, w, h)
    var k: u64 = 0
    while k < n {
        k = k + 1
        tile.insert(state, 0)
    }
}

fn tile_time(state: u64, n: u64, w: u64, h: u64, verify: bool) -> u64 {
    tile_build(state, n, w, h)
    let t: u64 = apic.tsc()
    var i: u64 = 0
    while i < TILE_RUNDEN {
        if verify {
            tile.check(state)
        } else {
            tile.relayout(state)
        }
        i = i + 1
    }
    return us_of(state, apic.tsc() - t)
}

fn wmplug_stage(state: u64) {
    if kstate.mode_on(state, kstate.M_PLUGTEST) {
        wmplug.selftest(state)
        if !kstate.mode_on(state, kstate.M_WMPLUG)
            || kstate.mode_on(state, kstate.M_PLUGAUS) {
            wmplug.set_ready(state, false)
        }
    }
    if kstate.mode_on(state, kstate.M_PLUGFRIST) {
        wmplug.set_frist(state, 3)
    }
    var s_p: [u8; 9] = "wmplug: \0"
    var s_a: [u8; 5] = "abi=\0"
    var s_s: [u8; 9] = "  tafel=\0"
    var s_f: [u8; 9] = "  frist=\0"
    var s_z: [u8; 4] = " zu\0"
    var s_o: [u8; 7] = " offen\0"
    serial.puts((&s_p[0]) as u64)
    serial.puts((&s_a[0]) as u64)
    serial.dec(wmplug.WMP_ABI)
    serial.puts((&s_s[0]) as u64)
    if wmplug.ready(state) {
        serial.puts((&s_o[0]) as u64)
    } else {
        serial.puts((&s_z[0]) as u64)
    }
    serial.puts((&s_f[0]) as u64)
    serial.dec(wmplug.frist(state))
    serial.nl()
}

fn tile_stage(state: u64, w: u64, h: u64) {
    var s_t: [u8; 7] = "tile: \0"
    var s_x: [u8; 2] = "x\0"
    var s_nd: [u8; 10] = "  nodes=\0\0"
    var s_lv: [u8; 12] = "  maxleaf=\0\0"
    var s_bd: [u8; 10] = "  binds=\0\0"
    var s_st: [u8; 11] = "selftest \0\0"
    var s_of: [u8; 4] = "/\0\0\0"
    var s_be: [u8; 20] = "tile: bench relay2=\0"
    var s_r8: [u8; 10] = "  relay8=\0"
    var s_r32: [u8; 11] = "  relay32=\0"
    var s_ck: [u8; 11] = "  check32=\0"
    var s_ns: [u8; 4] = " ns\0"
    var s_fz: [u8; 18] = "tile: fuzz ops=\0\0\0"
    var s_vi: [u8; 15] = "  violations=\0\0"
    var s_pk: [u8; 9] = "  peak=\0\0"
    var s_ch: [u8; 11] = "  checks=\0\0"
    var s_nos: [u8; 22] = "  (notiledirty: an)\0\0\0"

    serial.puts((&s_t[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_nd[0]) as u64)
    serial.dec(tile.MAX_NODES)
    serial.puts((&s_lv[0]) as u64)
    serial.dec(tile.MAX_LEAVES)
    serial.nl()

    serial.puts((&s_t[0]) as u64)
    serial.puts((&s_st[0]) as u64)
    serial.dec(tile.selftest(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(tile.selftest_max())
    var s_fb: [u8; 11] = "  failed=\0\0"
    serial.puts((&s_fb[0]) as u64)
    serial.hex(tile.failbits(state))
    serial.nl()

    let nb: u64 = tile_conf(state)
    serial.puts((&s_t[0]) as u64)
    serial.puts((&s_bd[0]) as u64 + 2)
    serial.dec(nb)
    serial.nl()

    if apic.tsc_hz(state) != 0 {
        let r2: u64 = tile_time(state, 2, w, h, false)
        let r8: u64 = tile_time(state, 8, w, h, false)
        let r32: u64 = tile_time(state, 32, w, h, false)
        let c32: u64 = tile_time(state, 32, w, h, true)
        serial.puts((&s_be[0]) as u64)
        serial.dec(r2)
        serial.puts((&s_ns[0]) as u64)
        serial.puts((&s_r8[0]) as u64)
        serial.dec(r8)
        serial.puts((&s_ns[0]) as u64)
        serial.puts((&s_r32[0]) as u64)
        serial.dec(r32)
        serial.puts((&s_ns[0]) as u64)
        serial.puts((&s_ck[0]) as u64)
        serial.dec(c32)
        serial.puts((&s_ns[0]) as u64)
        serial.nl()
    }

    if kstate.mode_on(state, kstate.M_TILEFUZZ) {
        tile.init(state, 0, 0, w, h)
        let v: u64 = tile.fuzz(state, 10000)
        serial.puts((&s_fz[0]) as u64)
        serial.dec(10000)
        serial.puts((&s_vi[0]) as u64)
        serial.dec(v)
        serial.puts((&s_pk[0]) as u64)
        serial.dec(tile.peak(state))
        serial.puts((&s_ch[0]) as u64)
        serial.dec(tile.checks(state))
        serial.nl()
    }

    tile.init(state, 0, 0, w, h)
    if kstate.mode_on(state, kstate.M_NOTILEDIRTY) {
        tile.set_nosub(state, true)
        serial.puts((&s_t[0]) as u64)
        serial.puts((&s_nos[0]) as u64)
        serial.nl()
    }
}

fn tile_shot(state: u64, w: u64, h: u64) {
    var t1: [u8; 6] = "Eins\0\0"
    var t2: [u8; 6] = "Zwei\0\0"
    var t3: [u8; 6] = "Drei\0\0"
    var t4: [u8; 6] = "Vier\0\0"
    var s_w: [u8; 11] = "tile: win=\0"
    var s_k: [u8; 3] = " \0\0"
    var s_c: [u8; 2] = ",\0"
    var s_x: [u8; 2] = "x\0"
    var s_d: [u8; 19] = "tile: dirty split=\0"
    var s_cl: [u8; 9] = "  close=\0"
    var s_sc: [u8; 10] = "  screen=\0"
    var s_tb: [u8; 13] = "tile: tabs=\0\0"
    var s_hd: [u8; 10] = "  hidden=\0"

    let tabs: bool = kstate.mode_on(state, kstate.M_TILETABS)
    let rot: bool = kstate.mode_on(state, kstate.M_TILEROT)
    var a: u64 = wm.MAX_WIN
    var b: u64 = wm.MAX_WIN
    var c: u64 = wm.MAX_WIN
    var d: u64 = wm.MAX_WIN
    var f: u64 = 0
    while f < wm.MAX_WIN {
        if wm.valid(state, f) && wm.tiled(state, f) {
            wm.tile_float(state, f)
        }
        f = f + 1
    }
    a = wm.create(state, 0, 0, 0, w / 2, h / 2, wm.K_RAW, (&t1[0]) as u64)
    b = wm.create(state, 0, 0, 0, w / 2, h / 2, wm.K_RAW, (&t2[0]) as u64)
    c = wm.create(state, 0, 0, 0, w / 2, h / 2, wm.K_RAW, (&t3[0]) as u64)
    d = wm.create(state, 0, 0, 0, w / 2, h / 2, wm.K_RAW, (&t4[0]) as u64)
    tile_arrange(state, a, b, c, d, false)
    let paar: u64 = tile_dirty(state)
    tile_arrange(state, a, b, c, d, tabs)
    if rot {
        tile.rotate(state, tile.root(state), 1)
        wm.tile_apply(state)
    }
    wm.damage_all(state)
    tile_paint(state, a, fb.rgb(state, 0xC0, 0x30, 0x30))
    tile_paint(state, b, fb.rgb(state, 0x30, 0xB0, 0x50))
    tile_paint(state, c, fb.rgb(state, 0x30, 0x60, 0xE0))
    tile_paint(state, d, fb.rgb(state, 0xE0, 0xC0, 0x30))
    tile_say(state, a, (&s_w[0]) as u64, (&s_k[0]) as u64,
        (&s_c[0]) as u64, (&s_x[0]) as u64)
    tile_say(state, b, (&s_w[0]) as u64, (&s_k[0]) as u64,
        (&s_c[0]) as u64, (&s_x[0]) as u64)
    tile_say(state, c, (&s_w[0]) as u64, (&s_k[0]) as u64,
        (&s_c[0]) as u64, (&s_x[0]) as u64)
    tile_say(state, d, (&s_w[0]) as u64, (&s_k[0]) as u64,
        (&s_c[0]) as u64, (&s_x[0]) as u64)
    var versteckt: u64 = 0
    var k: u64 = 0
    while k < wm.MAX_WIN {
        if wm.valid(state, k) && wm.win_tabbed(state, k) {
            versteckt = versteckt + 1
        }
        k = k + 1
    }
    serial.puts((&s_tb[0]) as u64)
    serial.dec(bnum(tabs))
    serial.puts((&s_hd[0]) as u64)
    serial.dec(versteckt)
    serial.nl()
    serial.puts((&s_d[0]) as u64)
    serial.dec(paar & 0xFFFFFFFF)
    serial.puts((&s_cl[0]) as u64)
    serial.dec(paar >> 32)
    serial.puts((&s_sc[0]) as u64)
    serial.dec(w * h)
    serial.nl()
}

fn tile_arrange(state: u64, a: u64, b: u64, c: u64, d: u64, tabs: bool) {
    var k: u64 = 0
    while k < wm.MAX_WIN {
        if wm.valid(state, k) {
            wm.tile_release(state, k)
        }
        k = k + 1
    }
    tile.set_next_split(state, 0)
    wm.tile_take(state, a)
    tile.set_next_split(state, 1)
    wm.tile_take(state, b)
    if tabs {
        tile.set_layout(state, tile.root(state), tile.LAY_TABBED)
        wm.tile_apply(state)
        tile.set_next_split(state, 0)
        wm.tile_take(state, c)
        tile.set_next_split(state, 0)
        wm.tile_take(state, d)
    } else {
        wm.set_focus(state, b)
        tile.set_next_split(state, 2)
        wm.tile_take(state, c)
        wm.set_focus(state, a)
        tile.set_next_split(state, 2)
        wm.tile_take(state, d)
    }
    wm.tile_apply(state)
    wm.damage_all(state)
}

fn tile_paint(state: u64, i: u64, color: u64) {
    if i >= wm.MAX_WIN {
        return
    }
    wm.fill(state, i, 0, 0, wm.win_w(state, i), wm.win_h(state, i), color)
}

fn tile_say(state: u64, i: u64, sw: u64, sk: u64, sc: u64, sx: u64) {
    if i >= wm.MAX_WIN {
        return
    }
    serial.puts(sw)
    serial.dec(i)
    serial.puts(sk)
    serial.dec(wm.win_x(state, i) as u64)
    serial.puts(sc)
    serial.dec(wm.win_y(state, i) as u64)
    serial.puts(sk)
    serial.dec(wm.outer_w(state, i))
    serial.puts(sx)
    serial.dec(wm.outer_h(state, i))
    serial.nl()
}

fn tile_dirty(state: u64) -> u64 {
    let f: u64 = wm.focus(state)
    if f >= wm.MAX_WIN || !wm.tiled(state, f) {
        return 0
    }
    wm.damage_all(state)
    wm.compose(state)
    let p0: u64 = wm.pixels(state)
    wm.tile_release(state, f)
    wm.compose(state)
    let close_path: u64 = wm.pixels(state) - p0
    wm.damage_all(state)
    wm.compose(state)
    let p1: u64 = wm.pixels(state)
    wm.tile_take(state, f)
    wm.compose(state)
    let auf: u64 = wm.pixels(state) - p1
    wm.damage_all(state)
    wm.compose(state)
    return (close_path << 32) | (auf & 0xFFFFFFFF)
}

fn ub_line(state: u64, tw: u64, p: u64, n: u64) {
    kstate.set8(p + n, 10 as u8)
    wm.term_write(state, tw, p, n + 1)
    var i: u64 = 0
    while i < n {
        serial.put(kstate.get8(p + i) as u8)
        i = i + 1
    }
    serial.nl()
}

fn ub_sp(state: u64, b: u64, n: u64) -> u64 {
    var l: [u8; 2] = " \0"
    return pulse_text(state, b, n, (&l[0]) as u64)
}

fn ub_cls(state: u64, b: u64, n: u64, c: u64, u: u64, pr: u64) -> u64 {
    var d: [u8; 2] = ":\0"
    var m: u64 = pulse_hexn(state, b, n, c, 2)
    m = pulse_text(state, b, m, (&d[0]) as u64)
    m = pulse_hexn(state, b, m, u, 2)
    m = pulse_text(state, b, m, (&d[0]) as u64)
    return pulse_hexn(state, b, m, pr, 2)
}

fn usb_bericht(state: u64, tw: u64) {
    if tw >= wm.MAX_WIN {
        return
    }
    var b: [u8; 128] = [0 as u8; 128]
    let p: u64 = (&b[0]) as u64

    var t_h: [u8; 6] = "USB  \0"
    var t_hc: [u8; 5] = "hc=\0\0"
    var t_po: [u8; 8] = " ports=\0"
    var t_de: [u8; 6] = " dev=\0"
    var t_fu: [u8; 7] = " fund=\0"
    var t_hb: [u8; 7] = " hubs=\0"
    var t_hp: [u8; 8] = " hbprt=\0"
    var t_fa: [u8; 8] = " fails=\0"
    var n: u64 = 0
    n = pulse_text(state, p, 0, (&t_h[0]) as u64)
    n = pulse_text(state, p, n, (&t_hc[0]) as u64)
    n = pulse_num(state, p, n, xhci.count_hc(state))
    n = pulse_text(state, p, n, (&t_po[0]) as u64)
    n = pulse_num(state, p, n, xhci.ports(state))
    n = pulse_text(state, p, n, (&t_de[0]) as u64)
    n = pulse_num(state, p, n, usb.count(state))
    n = pulse_text(state, p, n, (&t_fu[0]) as u64)
    n = pulse_num(state, p, n, usb.fund_count(state))
    n = pulse_text(state, p, n, (&t_hb[0]) as u64)
    n = pulse_num(state, p, n, usb.hubs(state))
    n = pulse_text(state, p, n, (&t_hp[0]) as u64)
    n = pulse_num(state, p, n, usb.hubports(state))
    n = pulse_text(state, p, n, (&t_fa[0]) as u64)
    n = pulse_num(state, p, n, usb.fails(state))
    ub_line(state, tw, p, n)

    // ---- je Wurzelanschluss ----
    var t_p: [u8; 4] = " P\0\0"
    var t_c: [u8; 6] = " ccs=\0"
    var t_e: [u8; 5] = " en=\0"
    var t_s: [u8; 5] = " sp=\0"
    var t_r: [u8; 7] = " psc=\0\0"
    let np: u64 = xhci.ports(state)
    var i: u64 = 1
    while i <= np && i < 32 {
        n = pulse_text(state, p, 0, (&t_p[0]) as u64)
        n = pulse_num(state, p, n, i)
        n = pulse_text(state, p, n, (&t_c[0]) as u64)
        n = pulse_num(state, p, n, ja1(xhci.port_connected(state, i)))
        n = pulse_text(state, p, n, (&t_e[0]) as u64)
        n = pulse_num(state, p, n, ja1(xhci.port_enabled(state, i)))
        n = pulse_text(state, p, n, (&t_s[0]) as u64)
        n = pulse_num(state, p, n, xhci.port_speed(state, i))
        n = pulse_text(state, p, n, (&t_r[0]) as u64)
        n = pulse_hexn(state, p, n, xhci.portsc(state, i), 8)
        ub_line(state, tw, p, n)
        i = i + 1
    }

    // ---- je gefundenem Geraet ----
    var t_d: [u8; 4] = " D\0\0"
    var t_at: [u8; 3] = " @\0"
    var t_dot: [u8; 2] = ".\0"
    var t_id: [u8; 5] = " id=\0"
    var t_dc: [u8; 6] = " dev=\0"
    var t_if: [u8; 5] = " if=\0"
    var t_nn: [u8; 4] = " n=\0"
    var t_ff: [u8; 4] = " f=\0"
    var t_dr: [u8; 6] = " drv=\0"
    var t_empty: [u8; 23] = " NOT A SINGLE DEVICE!\0\0"
    let nf: u64 = usb.fund_count(state)
    if nf == 0 {
        n = pulse_text(state, p, 0, (&t_empty[0]) as u64)
        ub_line(state, tw, p, n)
    }
    i = 0
    while i < nf {
        n = pulse_text(state, p, 0, (&t_d[0]) as u64)
        n = pulse_num(state, p, n, i)
        n = pulse_text(state, p, n, (&t_at[0]) as u64)
        n = pulse_num(state, p, n, usb.fund_port(state, i))
        n = pulse_text(state, p, n, (&t_dot[0]) as u64)
        n = pulse_num(state, p, n, usb.fund_hub(state, i))
        n = pulse_text(state, p, n, (&t_s[0]) as u64)
        n = pulse_num(state, p, n, usb.fund_speed(state, i))
        n = pulse_text(state, p, n, (&t_id[0]) as u64)
        n = pulse_hexn(state, p, n, usb.fund_vid(state, i), 4)
        n = pulse_text(state, p, n, (&t_dot[0]) as u64)
        n = pulse_hexn(state, p, n, usb.fund_pid(state, i), 4)
        n = pulse_text(state, p, n, (&t_dc[0]) as u64)
        n = ub_cls(state, p, n, usb.fund_dcls(state, i),
            usb.fund_dsub(state, i), usb.fund_dpro(state, i))
        n = pulse_text(state, p, n, (&t_if[0]) as u64)
        n = ub_cls(state, p, n, usb.fund_icls(state, i),
            usb.fund_isub(state, i), usb.fund_ipro(state, i))
        n = pulse_text(state, p, n, (&t_nn[0]) as u64)
        n = pulse_num(state, p, n, usb.fund_ifaces(state, i))
        n = pulse_text(state, p, n, (&t_ff[0]) as u64)
        n = pulse_num(state, p, n, usb.fund_flags(state, i))
        n = pulse_text(state, p, n, (&t_dr[0]) as u64)
        n = pulse_num(state, p, n, usb.fund_driver(state, i))
        ub_line(state, tw, p, n)
        i = i + 1
    }
}

fn ja1(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

const PB_HEADER: u64 = 3

fn pb_dec(state: u64, v: u64) {
    var t: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        t[0 as usize] = 48 as u8
        n = 1
    }
    while x > 0 {
        t[n as usize] = (48 + (x % 10)) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        fb.putc(state, t[(n - 1) as usize] as u64)
        n = n - 1
    }
}

fn pb_hex(state: u64, v: u64, w: u64) {
    fb.putc(state, 48)
    fb.putc(state, 120)
    var i: u64 = w
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * 4)) & 15
        if d < 10 {
            fb.putc(state, 48 + d)
        } else {
            fb.putc(state, 87 + d)
        }
    }
}

fn pb_str(state: u64, p: u64) {
    if p == 0 {
        return
    }
    fb.puts(state, p)
}

fn pb_addr(state: u64, a: u64) {
    var s_plus: [u8; 2] = "+\0"
    var s_ob: [u8; 3] = " (\0"
    var s_co: [u8; 2] = ":\0"
    var s_cb: [u8; 2] = ")\0"
    let i: u64 = ksymtab.resolve(a)
    if i >= ksymtab.n_sym() {
        pb_hex(state, a, 16)
        return
    }
    pb_str(state, ksymtab.sym_name(i))
    pb_str(state, (&s_plus[0 as usize]) as u64)
    pb_hex(state, a - ksymtab.sym_addr(i), 4)
    let pk: u64 = ksymtab.line_of(a)
    if pk == 0 {
        return
    }
    let f: u64 = ksymtab.file_name(ksymtab.line_file(pk))
    if f == 0 {
        return
    }
    pb_str(state, (&s_ob[0 as usize]) as u64)
    pb_str(state, f)
    pb_str(state, (&s_co[0 as usize]) as u64)
    pb_dec(state, ksymtab.line_nr(pk))
    pb_str(state, (&s_cb[0 as usize]) as u64)
}

fn panikbild(state: u64, vec: u64, err: u64, rip: u64, cr2: u64,
        rsp: u64, cs: u64, flg: u64, ss: u64, kern: u64, regs: u64,
        trace: u64, spurn: u64, cur_file: u64) {
    var names: [u8; 128] = "#DE\0#DB\0NMI\0#BP\0#OF\0#BR\0#UD\0#NM\0#DF\0#CO\0#TS\0#NP\0#SS\0#GP\0#PF\0r15\0#MF\0#AC\0#MC\0#XM\0#VE\0#CP\0r22\0r23\0r24\0r25\0r26\0#HV\0#VC\0#SX\0r30\0r31\0"
    var rnamen: [u8; 64] = "rax\0rbx\0rcx\0rdx\0rsi\0rdi\0rbp\0rsp\0r8 \0r9 \0r10\0r11\0r12\0r13\0r14\0r15\0"
    var s_head: [u8; 27] = "*** OSUM  KERNEL-PANIK ***\0"
    var s_vek: [u8; 8] = "  VEK \0\0"
    var s_err: [u8; 8] = "  ERR \0\0"
    var s_krn: [u8; 9] = "  KERN \0\0"
    var s_rip: [u8; 6] = "RIP \0\0"
    var s_cr2: [u8; 8] = "  CR2 \0\0"
    var s_cs: [u8; 7] = "  CS \0\0"
    var s_flg: [u8; 8] = "  FLG \0\0"
    var s_rsp: [u8; 7] = "RSP \0\0\0"
    var s_ss: [u8; 7] = "  SS \0\0"
    var s_trace: [u8; 15] = "-- RUECKSPUR\0\0\0"
    var s_prot: [u8; 15] = "-- PROTOKOLL\0\0\0"
    var s_ber: [u8; 12] = "-- BERICHT\0\0"
    var s_kb: [u8; 14] = "-- (keiner)\0\0\0"
    var s_ab: [u8; 20] = "  ... abgeschnitten\0"
    var s_photo: [u8; 41] = "*** PLEASE PHOTOGRAPH -- machine halted\0\0"
    var s_sp: [u8; 3] = "  \0"
    var s_gl: [u8; 2] = "=\0"

    if !fb.ready(state) {
        return
    }
    let rot: u64 = fb.rgb(state, 128, 0, 0)
    let weiss: u64 = fb.rgb(state, 255, 255, 255)
    let gelb: u64 = fb.rgb(state, 255, 220, 80)
    fb.clear(state, rot)
    fb.set_color(state, weiss, rot)
    fb.home(state)

    pb_str(state, (&s_head[0 as usize]) as u64)
    pb_str(state, (&s_vek[0 as usize]) as u64)
    pb_dec(state, vec)
    fb.putc(state, 32)
    if vec < 32 {
        pb_str(state, (&names[0 as usize]) as u64 + vec * 4)
    }
    pb_str(state, (&s_err[0 as usize]) as u64)
    pb_hex(state, err, 8)
    pb_str(state, (&s_krn[0 as usize]) as u64)
    pb_dec(state, kern)
    fb.nl(state)
    pb_str(state, version.text())
    fb.nl(state)

    pb_str(state, (&s_rip[0 as usize]) as u64)
    pb_addr(state, rip)
    fb.nl(state)
    pb_str(state, (&s_rsp[0 as usize]) as u64)
    pb_hex(state, rsp, 16)
    pb_str(state, (&s_cs[0 as usize]) as u64)
    pb_hex(state, cs, 4)
    pb_str(state, (&s_ss[0 as usize]) as u64)
    pb_hex(state, ss, 4)
    pb_str(state, (&s_flg[0 as usize]) as u64)
    pb_hex(state, flg, 8)
    if vec == 14 {
        pb_str(state, (&s_cr2[0 as usize]) as u64)
        pb_hex(state, cr2, 16)
    }
    fb.nl(state)

    // WOMIT.
    var i: u64 = 0
    while i < 16 {
        pb_str(state, (&rnamen[0 as usize]) as u64 + i * 4)
        pb_str(state, (&s_gl[0 as usize]) as u64)
        pb_hex(state, __mmio_read64((regs + i * 8) as *mut u64), 16)
        if i % 4 == 3 {
            fb.nl(state)
        } else {
            pb_str(state, (&s_sp[0 as usize]) as u64)
        }
        i = i + 1
    }

    // WOHER.
    fb.set_color(state, gelb, rot)
    pb_str(state, (&s_trace[0 as usize]) as u64)
    fb.nl(state)
    fb.set_color(state, weiss, rot)
    if spurn == 0 {
        pb_str(state, (&s_kb[0 as usize]) as u64)
        fb.nl(state)
    }
    i = 0
    while i < spurn {
        pb_str(state, (&s_sp[0 as usize]) as u64)
        pb_addr(state, __mmio_read64((trace + i * 8) as *mut u64))
        fb.nl(state)
        i = i + 1
    }

    fb.set_color(state, gelb, rot)
    pb_str(state, (&s_prot[0 as usize]) as u64)
    fb.nl(state)
    fb.set_color(state, weiss, rot)
    let rows: u64 = fb.rows(state)
    var free: u64 = 0
    if rows > fb.cy(state) + 3 {
        free = rows - fb.cy(state) - 3
    }
    let last: u64 = klog.seq(state)
    var von: u64 = 1
    if last > free {
        von = last - free + 1
    }
    if von < klog.first_seq(state) {
        von = klog.first_seq(state)
    }
    if last > 0 && last >= von {
        if von > klog.first_seq(state) {
            pb_str(state, (&s_ab[0 as usize]) as u64)
            fb.nl(state)
        }
        var b: [u8; 200] = [0 as u8; 200]
        var sq: u64 = von
        while sq <= last {
            let n: u64 = klog.line_at(state, sq,
                (&b[0 as usize]) as u64, 199)
            if n > 1 {
                fb.text(state, (&b[0 as usize]) as u64, n - 1)
                fb.nl(state)
            }
            sq = sq + 1
        }
    }

    fb.set_color(state, gelb, rot)
    pb_str(state, (&s_ber[0 as usize]) as u64)
    fb.putc(state, 32)
    if cur_file != 0 {
        pb_str(state, cur_file)
    } else {
        pb_str(state, (&s_kb[0 as usize]) as u64)
    }
    fb.nl(state)
    pb_str(state, (&s_photo[0 as usize]) as u64)
    fb.nl(state)
    fb.flush(state)
}

// ==================================================== RUNDE SPEICHERDRUCK
fn speicherdruck_gui(state: u64) {
    if !kstate.mode_on(state, kstate.M_MEMHOG)
        && !kstate.mode_on(state, kstate.M_MEMHOGN) {
        return
    }
    var s_beg: [u8; 26] = "speicherdruck: gui start\n\0"
    var s_free: [u8; 21] = "speicherdruck: frei=\0"
    serial.puts((&s_beg[0]) as u64)
    serial.puts((&s_free[0]) as u64)
    serial.dec(mem.frames_free(state))
    serial.nl()
    let a: u64 = proc.create(state, P_HOG, 1, 2)
    if kstate.mode_on(state, kstate.M_MEMHOGN) {
        let b: u64 = proc.create(state, P_HOG, 2, 2)
        let c: u64 = proc.create(state, P_HOG, 3, 2)
    }
}
