const P_FB: u64 = 13
const P_WCLICK: u64 = 14
const P_HOG: u64 = 66 // K-002: 64/65 sind P_SCHLAF/P_WACH
const GFX_RUNDEN: u64 = 5 // Wiederholungen je Messwert
const DISP_RUNDEN: u64 = 5
const PX_X: u64 = 120
const PX_Y: u64 = 120
const PX_COLOR: u64 = 13132850 // 0xC86432 = 200,100,50
const WM_ARENA_FRAMES: u64 = 128 // 512 KiB, ttf.ARENA_BYTES
const K10_RUNDEN: u64 = 20
const I18N_LINES: u64 = 1000
const TILE_RUNDEN: u64 = 1000

// ---------------------------------------------------------- die Tueren

fn stage_graphics(state: u64, mbi: u64) {
    graphics(state, mbi)
}

fn stage_surface(state: u64) {
    surface(state)
}

fn stage_hold(state: u64) {
    gfx_hold(state)
}

const PAINT_RUNDEN: u64 = 4

fn paint_bench(state: u64) {
    var s_h: [u8; 22] = "        paintbench: \0\0"
    var s_x: [u8; 2] = "x\0"
    var s_fi: [u8; 9] = "  fill=\0\0"
    var s_fa: [u8; 11] = "  fill_a=\0\0"
    var s_cy: [u8; 5] = " cyc\0"
    var s_pp: [u8; 12] = "  je-px=\0\0\0\0"
    var s_pa: [u8; 8] = " / \0\0\0\0\0"
    var s_ra: [u8; 12] = "  faktor=\0\0\0"
    var s_pm: [u8; 8] = "/1000\0\0\0"
    var s_bl: [u8; 11] = "  blends=\0\0"
    var s_rd: [u8; 10] = "  reads=\0\0"
    var s_sk: [u8; 10] = "  skips=\0\0"
    var s_db: [u8; 10] = "  dbl=\0\0\0\0"
    var s_sp: [u8; 12] = "  simd_px=\0\0"
    var s_so: [u8; 12] = "  simd_ok=\0\0"
    var s_fe: [u8; 11] = "  fpu_en=\0\0"

    if apic.tsc_hz(state) == 0 {
        return
    }
    let w: u64 = fb.width(state)
    let h: u64 = fb.height(state)
    if w == 0 || h == 0 {
        return
    }
    let color: u64 = fb.rgb(state, 0x20, 0x30, 0x40)
    let overlay: u64 = fb.rgb(state, 0xFF, 0xFF, 0xFF)

    // 1. undurchsichtig
    var t: u64 = apic.tsc()
    var i: u64 = 0
    while i < PAINT_RUNDEN {
        fb.fill(state, 0, 0, w, h, color)
        i = i + 1
    }
    let c_fill: u64 = (apic.tsc() -% t) / PAINT_RUNDEN

    fb.blend_reset(state)
    t = apic.tsc()
    i = 0
    while i < PAINT_RUNDEN {
        fb.fill_a(state, 0, 0, w, h, overlay, 128)
        i = i + 1
    }
    let c_fa: u64 = (apic.tsc() -% t) / PAINT_RUNDEN

    let px: u64 = w * h
    serial.puts((&s_h[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_fi[0]) as u64)
    serial.dec(c_fill)
    serial.puts((&s_cy[0]) as u64)
    serial.puts((&s_fa[0]) as u64)
    serial.dec(c_fa)
    serial.puts((&s_cy[0]) as u64)
    serial.puts((&s_pp[0]) as u64)
    serial.dec(c_fill * 1000 / px)
    serial.puts((&s_pa[0]) as u64)
    serial.dec(c_fa * 1000 / px)
    serial.puts((&s_pm[0]) as u64)
    serial.puts((&s_ra[0]) as u64)
    if c_fill != 0 {
        serial.dec(c_fa * 1000 / c_fill)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_pm[0]) as u64)
    serial.puts((&s_bl[0]) as u64)
    serial.dec(fb.blends(state))
    serial.puts((&s_rd[0]) as u64)
    serial.dec(fb.blend_reads(state))
    serial.puts((&s_sp[0]) as u64)
    serial.dec(fb.simd_px(state))
    serial.puts((&s_so[0]) as u64)
    serial.dec(bnum(fb.simd_ok(state)))
    serial.puts((&s_fe[0]) as u64)
    serial.dec(bnum(fpu.enabled(state)))
    serial.puts((&s_sk[0]) as u64)
    serial.dec(fb.blend_skips(state))
    serial.puts((&s_db[0]) as u64)
    if fb.double_buffered(state) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()

    var s_st: [u8; 24] = "        paint: selftest\0"
    var s_of: [u8; 5] = " of \0"
    var s_ok: [u8; 12] = "  gezaehlt=\0"
    var s_no: [u8; 6] = "  ok\0\0"
    var s_bad: [u8; 9] = "  FALSCH\0"
    let gemischt: u64 = fb.blends(state)
    serial.puts((&s_st[0]) as u64)
    serial.puts((&s_ok[0]) as u64)
    serial.dec(fb.selftest3(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(fb.selftest3_max())
    if gemischt == px * PAINT_RUNDEN {
        serial.puts((&s_no[0]) as u64)
    } else {
        serial.puts((&s_bad[0]) as u64)
    }
    serial.nl()
    fb.blend_reset(state)
    fb.clear(state, 0)
}

fn graphics(state: u64, mbi: u64) {
    var s_none: [u8; 24] = "fb: kein Rahmenpuffer\0\0\0"
    var s_geo: [u8; 5] = "fb: \0"
    var s_x: [u8; 2] = "x\0"
    var s_bpp: [u8; 4] = "x32\0"
    var s_pitch: [u8; 9] = "  pitch=\0"
    var s_src: [u8; 7] = "  src=\0"
    var s_mb: [u8; 3] = "mb\0"
    var s_vbe: [u8; 4] = "vbe\0"
    var s_phys: [u8; 8] = "  phys=\0"
    var s_win: [u8; 7] = "  win=\0"
    var s_huge: [u8; 8] = "  huge=\0"
    var s_cols: [u8; 8] = "  cols=\0"
    var s_rows: [u8; 8] = "  rows=\0"
    var s_back: [u8; 8] = "  back=\0"
    var s_none2: [u8; 5] = "none\0"
    var s_uc: [u8; 6] = "  uc=\0"
    var s_wc: [u8; 6] = "  wc=\0"
    var s_st: [u8; 14] = "fb: selftest \0"
    var s_of: [u8; 4] = " / \0"
    var s_on: [u8; 31] = "fb: console mirrored to screen\0"

    if !fb.want(state, fb.M_GFX) {
        return
    }
    var w: u64 = fb.WIDTH_STD
    var h: u64 = fb.HEIGHT_STD
    if fb.want(state, fb.M_BIG) {
        w = fb.WIDTH_BIG
        h = fb.HEIGHT_BIG
    }
    //     disp: edid ok  nat=1920x1080
    //     fb:   800x600x32
    var size_source: u64 = 0 // 0 = eingebaut, 1 = Befehlszeile, 2 = EDID
    if fb.want(state, fb.M_RES) && fb.res_w(state) != 0 {
        w = fb.res_w(state)
        h = fb.res_h(state)
        size_source = 1
    } else {
        let nat: u64 = vmode.native(state)
        if nat != 0 {
            w = nat >> 16
            h = nat & 0xFFFF
            size_source = 2
        }
    }
    // r827: EXTEND SIZES THE DESKTOP FROM THE HEADS. With `vgpuextend` and no `fbres=` the framebuffer is as wide
    // as the connected heads side by side (pack_row) and as high as the tallest: no hand-typed size to keep in sync.
    if kstate.mode_on(state, kstate.M_VGPUEXT) && !kstate.mode_on(state, kstate.M_NOVGPU) && size_source != 1 {
        let pd: u64 = vgpu.probe_desktop(state)
        if pd != 0 {
            w = pd >> 16
            h = pd & 0xFFFF
            size_source = 3
            var s_pd: [u8; 18] = "fb: heads desk=\0\0\0"
            serial.puts((&s_pd[0]) as u64)
            serial.dec(w)
            serial.put(120)
            serial.dec(h)
            serial.nl()
        }
    }
    var s_nat: [u8; 10] = "fb: nat=\0\0"
    var s_natx: [u8; 2] = "x\0"
    var s_why: [u8; 8] = "  why=\0\0"
    serial.puts((&s_nat[0]) as u64)
    serial.dec(vmode.edid_native_w(state))
    serial.puts((&s_natx[0]) as u64)
    serial.dec(vmode.edid_native_h(state))
    serial.puts((&s_why[0]) as u64)
    serial.dec(vmode.edid_why(state))
    serial.nl()
    if (mbi == 0 || (kstate.get32(mbi) & 0x1000) == 0) && !kstate.mode_on(state, kstate.M_NOBOOTFIT) {
        let vram_b: u64 = vmode.boot_vram()
        if vram_b != 0 {
            let fit: u64 = vmode.boot_fit(w, h, vram_b)
            if fit != ((w << 16) | h) {
                var s_fit: [u8; 9] = "fb: fit \0"
                var s_vr: [u8; 7] = " vram=\0"
                w = fit >> 16
                h = fit & 0xFFFF
                serial.puts((&s_fit[0]) as u64)
                serial.dec(w)
                serial.put(120)
                serial.dec(h)
                serial.puts((&s_vr[0]) as u64)
                serial.dec(vram_b / 1024)
                serial.nl()
            }
        }
    }
    var back: u64 = 0
    var back_bytes: u64 = 0
    var shadow: u64 = 0
    var fb_ok: bool = false
    var s_retry: [u8; 11] = "fb: retry \0"
    while !fb_ok {
        // r-vmsvga, Weg 3: no loader framebuffer (qemu -kernel -vga vmware) -> VMSVGA sets the mode itself and hands fb.init a
        // synthetic multiboot info. Skipped with `novmsvga` or when the loader gave a framebuffer.
        var mbi_use: u64 = mbi
        if mbi == 0 || (kstate.get32(mbi) & 0x1000) == 0 {
            let m3: u64 = vmsvga.boot_mbi(state, w, h)
            if m3 != 0 {
                mbi_use = m3
            }
        }
        back = 0
        back_bytes = 0
        shadow = 0
        if !fb.want(state, fb.M_NODBL) {
            var noetig: u64 = fb.need_bytes(mbi_use, w, h)
            if noetig == 0 {
                noetig = w * h * 4
            }
            let frame: u64 = (noetig + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE + 8
            back = mem.frame_run(state, frame)
            if back != 0 {
                back_bytes = frame * mem.FRAME_SIZE
                // vboxlag: the shadow copy of what the card shows (same size, for the diff flush; none = whole rectangles as before)
                shadow = mem.frame_run(state, frame)
            }
        }
        if fb.init(state, mbi_use, w, h, back, back_bytes, fb.want(state, fb.M_UC)) {
            fb_ok = true
        } else {
            if shadow != 0 {
                mem.frame_free_run(state, shadow, back_bytes / mem.FRAME_SIZE)
            }
            if back != 0 {
                mem.frame_free_run(state, back, back_bytes / mem.FRAME_SIZE)
            }
            var nx: u64 = vmode.boot_step(w, h)
            if kstate.mode_on(state, kstate.M_NOBOOTRETRY) {
                nx = 0
            }
            if nx == 0 {
                serial.puts((&s_none[0]) as u64)
                serial.nl()
                return
            }
            w = nx >> 16
            h = nx & 0xFFFF
            serial.puts((&s_retry[0]) as u64)
            serial.dec(w)
            serial.put(120)
            serial.dec(h)
            serial.nl()
        }
    }
    if shadow != 0 {
        fb.set_shadow(state, shadow, back_bytes)
    }
    if fb.want(state, fb.M_NOCUR) {
        fb.set_cursor(state, false)
    }

    if !kstate.mode_on(state, kstate.M_NOVGPU) {
        if vgpu.init(state) {
            fb.set_vgpu(state, true)
        }
    }
    // r-vmsvga: virtio-gpu > VMSVGA > Bochs VBE > firmware framebuffer. Counter-proof word `novmsvga`.
    if !fb.on_vgpu(state) && !kstate.mode_on(state, kstate.M_NOVMSVGA) {
        let _v: bool = vmsvga.init(state)
    }
    vgpu.say(state)
    vmsvga.say(state)

    shot.init(state)

    tip.init(state)

    if fb.res_w(state) == 0 {
        let ds: u64 = vmode.dpi_scale(state, fb.width(state))
        if ds != 0 {
            let _sc: bool = fb.set_uiscale(state, ds)
        } else if vgpu.usable(state) && vgpu.head_edid_ok(state, 0) {
            // r815: no table EDID (vmode) but the virtual GPU gave one for head 0: its suggested percent
            // (100/125/150/175/200/250/300) rounded to the integer UI scale this kernel has (150 -> 2).
            let vs: u64 = (vgpu.head_scale(state, 0) + 50) / 100
            if vs >= 2 && vs <= 4 {
                let _sv: bool = fb.set_uiscale(state, vs)
            }
        }
    }
    // ============================================ RUNDE ECHTHARDWARE-1
    // `uiscale=<n>` SCHLAEGT DAS EDID.
    let uw: u64 = kstate.get(state, kstate.UISCALE_WUNSCH)
    if uw >= 1 && uw <= 4 {
        let _sw: bool = fb.set_uiscale(state, uw)
    }

    serial.puts((&s_geo[0]) as u64)
    serial.dec(fb.width(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.height(state))
    serial.puts((&s_bpp[0]) as u64)
    serial.puts((&s_pitch[0]) as u64)
    serial.dec(fb.pitch(state))
    serial.puts((&s_src[0]) as u64)
    if fb.source(state) == fb.SRC_MB {
        serial.puts((&s_mb[0]) as u64)
    } else {
        serial.puts((&s_vbe[0]) as u64)
    }
    serial.puts((&s_phys[0]) as u64)
    serial.hex(fb.phys(state))
    serial.puts((&s_win[0]) as u64)
    serial.hex(fb.addr(state))
    serial.puts((&s_huge[0]) as u64)
    serial.dec(fb.huges(state))
    serial.puts((&s_cols[0]) as u64)
    serial.dec(fb.cols(state))
    serial.puts((&s_rows[0]) as u64)
    serial.dec(fb.rows(state))
    serial.puts((&s_back[0]) as u64)
    if fb.back(state) == 0 {
        serial.puts((&s_none2[0]) as u64)
    } else {
        serial.hex(fb.back(state))
    }
    serial.puts((&s_uc[0]) as u64)
    serial.dec(bnum(fb.uncached(state)))
    serial.puts((&s_wc[0]) as u64)
    serial.dec(fb.wc(state))
    serial.nl()
    var s_ord: [u8; 17] = "fb: order panel=\0"
    var s_swz: [u8; 7] = "  swz=\0"
    serial.puts((&s_ord[0]) as u64)
    serial.dec(fb.panel_order(state))
    serial.puts((&s_swz[0]) as u64)
    serial.dec(bnum(fb.swizzled(state)))
    serial.nl()
    var s_sc: [u8; 13] = "fb: skala x\0\0"
    var s_src2: [u8; 10] = "  quelle=\0"
    var s_str: [u8; 12] = "  streifen=\0"
    var s_mm: [u8; 7] = "  mm=\0\0"
    serial.puts((&s_sc[0]) as u64)
    serial.dec(fb.uiscale(state))
    serial.puts((&s_src2[0]) as u64)
    serial.dec(size_source)
    serial.puts((&s_str[0]) as u64)
    serial.dec(bnum(fb.stripe(state)))
    serial.puts((&s_mm[0]) as u64)
    serial.dec(vmode.edid_mm_w(state))
    serial.nl()

    let n: u64 = fb.selftest(state)
    serial.puts((&s_st[0]) as u64)
    serial.dec(n)
    serial.puts((&s_of[0]) as u64)
    serial.dec(fb.selftest_max())
    var s_fbf: [u8; 11] = "  failed=\0\0"
    serial.puts((&s_fbf[0]) as u64)
    serial.hex(fb.failbits(state))
    serial.nl()

    gfx_bench(state, back)
    paint_bench(state)
    durchsatz(state)
    fbperf(state, back)

    vmode_stage(state)

    if kstate.mode_on(state, kstate.M_BOARD)
        && !kstate.mode_on(state, kstate.M_NOTAFEL) {
        let cur_height: u64 = wm.messhoehe(state, BOARD_LINES)
        let gesetzt: bool = fb.set_band(state, cur_height)
        var s_bd: [u8; 12] = "fb: band=\0\0\0"
        var s_bk: [u8; 7] = "  kol=\0"
        serial.puts((&s_bd[0]) as u64)
        serial.dec(fb.band(state))
        serial.puts((&s_bk[0]) as u64)
        serial.dec(wm.mess_kol(state))
        serial.put(32 as u8)
        serial.dec(bnum(gesetzt))
        serial.nl()
    }

    fb.clear(state, 0)
    fb.home(state)
    fb.set_echo(state, true)
    serial.puts((&s_on[0]) as u64)
    serial.nl()
}

fn bnum(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

fn host_boot_fit(state: u64) {
    var s_bf: [u8; 20] = "vmsvga: bootfit \0\0\0\0"
    var s_hi: [u8; 8] = " hint \0\0"
    var s_ar: [u8; 6] = " -> \0\0"
    var s_rc: [u8; 6] = " rc=\0\0"
    var s_sc: [u8; 9] = " scale=\0\0"
    var s_x: [u8; 2] = "x\0"
    var hv: u64 = 0
    if vmsvga.is_ready(state) && vmode.ready(state) {
        hv = vmsvga.boot_hint(state)
        if hv == 0 && kstate.mode_on(state, kstate.M_VMSVGABOOT) {
            hv = (2400 << 16) | 1400
        }
        if hv == 0 && kstate.mode_on(state, kstate.M_VMSVGAFULL) {
            hv = (1920 << 16) | 1080
        }
    }
    var rc: u64 = 0
    if hv != 0 && ((hv / 65536) != fb.width(state) || (hv % 65536) != fb.height(state)) {
        // two whole lines: follow_host prints its own `vmsvga: mode` line in between
        serial.puts((&s_bf[0]) as u64)
        serial.dec(fb.width(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.height(state))
        serial.puts((&s_hi[0]) as u64)
        serial.dec(hv / 65536)
        serial.puts((&s_x[0]) as u64)
        serial.dec(hv % 65536)
        serial.nl()
        rc = vmode.follow_host(state, hv / 65536, hv % 65536)
        // the debouncer of the idle poll must not apply the same hint a second time
        vmsvga.boot_handled(state, hv)
    }
    // the scale: only when nobody decided yet (no `uiscale=`, no table EDID size). The REQUESTED host size decides (a card or map limit
    // may shrink the screen below it, the host picture is still big), the final screen must still leave >= 800 logical px of width.
    if fb.uiscale(state) == 1 && fb.res_w(state) == 0
        && kstate.get(state, kstate.UISCALE_WUNSCH) == 0 && vmode.dpi_scale(state, fb.width(state)) == 0 {
        var aw: u64 = fb.width(state)
        var ah: u64 = fb.height(state)
        if hv != 0 {
            aw = hv / 65536
            ah = hv % 65536
        }
        var a: u64 = vmode.auto_scale(aw, ah)
        if a > 1 && fb.width(state) < 1600 {
            a = 1
        }
        if a > 1 {
            let _a: bool = fb.set_uiscale(state, a)
        }
    }
    if hv != 0 {
        serial.puts((&s_bf[0]) as u64)
        serial.puts((&s_ar[0]) as u64)
        serial.dec(fb.width(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.height(state))
        serial.puts((&s_rc[0]) as u64)
        serial.dec(rc)
        serial.puts((&s_sc[0]) as u64)
        serial.dec(fb.uiscale(state))
        serial.nl()
    }
}

fn vmode_stage(state: u64) {
    var s_no: [u8; 22] = "disp: keine Karte\0\0\0\0\0"
    var s_hd: [u8; 12] = "disp: vram=\0"
    var s_kib: [u8; 5] = " KiB\0"
    var s_dep: [u8; 10] = "  depths=\0"
    var s_lim: [u8; 12] = "  maplimit=\0"
    var s_pr: [u8; 10] = "  probed=\0"
    var s_rf: [u8; 11] = "  refused=\0"
    var s_tb: [u8; 10] = "  toobig=\0"
    var s_um: [u8; 15] = "  unmappable=\0\0"
    var s_md: [u8; 13] = "disp: modes \0"
    var s_out: [u8; 13] = "disp: out   \0"
    var s_why2: [u8; 10] = "  reason=\0"
    var s_one: [u8; 9] = "disp:   \0"
    var s_x: [u8; 2] = "x\0"
    var s_at: [u8; 3] = "x \0"
    var s_ed: [u8; 12] = "disp: edid \0"
    var s_yes: [u8; 4] = "ok\0\0"
    var s_why: [u8; 5] = "why=\0"
    var s_nat: [u8; 8] = "  nat=\0\0"
    var s_ven: [u8; 8] = "  ven=\0\0"
    var s_mod: [u8; 8] = "  mod=\0\0"
    var s_st: [u8; 16] = "disp: selftest \0"
    var s_of: [u8; 4] = " / \0"
    var s_st2: [u8; 15] = "fb: selftest2 \0"
    var s_room: [u8; 10] = "fb: room \0"
    var s_geo: [u8; 12] = "disp: geom \0"
    var s_gp: [u8; 9] = "  pitch=\0"
    var s_gt: [u8; 9] = "  panel=\0"
    var s_gq: [u8; 10] = "  ppitch=\0"
    var s_gr: [u8; 7] = "  rot=\0"
    var s_gs: [u8; 9] = "  scale=\0"
    var s_gl: [u8; 7] = "  lut=\0"
    var s_gv: [u8; 7] = "  sat=\0"
    var s_gd: [u8; 12] = "  drawback=\0"
    var s_raw: [u8; 12] = "disp: edid \0"

    if !vmode.want(state, vmode.M_DISP) {
        return
    }
    let n: u64 = vmode.probe(state)
    if n == 0 && !vmode.ready(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_hd[0]) as u64)
    serial.dec(vmode.vram(state) / 1024)
    serial.puts((&s_kib[0]) as u64)
    serial.puts((&s_dep[0]) as u64)
    serial.hex(vmode.depths(state))
    serial.puts((&s_lim[0]) as u64)
    serial.dec(vmode.map_limit(state))
    serial.puts((&s_pr[0]) as u64)
    serial.dec(vmode.probed(state))
    serial.puts((&s_rf[0]) as u64)
    serial.dec(vmode.refused(state))
    serial.puts((&s_tb[0]) as u64)
    serial.dec(vmode.toobig(state))
    serial.puts((&s_um[0]) as u64)
    serial.dec(vmode.probed(state) - vmode.refused(state)
        - vmode.toobig(state) - n)
    serial.nl()
    serial.puts((&s_md[0]) as u64)
    serial.dec(n)
    serial.nl()
    var i: u64 = 0
    while i < n {
        serial.puts((&s_one[0]) as u64)
        serial.dec(vmode.mode_w(state, i))
        serial.puts((&s_x[0]) as u64)
        serial.dec(vmode.mode_h(state, i))
        serial.puts((&s_at[0]) as u64)
        serial.dec(vmode.mode_bpp(state, i))
        serial.nl()
        i = i + 1
    }
    i = 0
    while i < vmode.cand_count() {
        let reason: u64 = vmode.cand_why(state, i)
        if reason != 0 {
            serial.puts((&s_out[0]) as u64)
            serial.dec(vmode.cand_w(i))
            serial.puts((&s_x[0]) as u64)
            serial.dec(vmode.cand_h(i))
            serial.puts((&s_why2[0]) as u64)
            serial.dec(reason)
            serial.nl()
        }
        i = i + 1
    }
    serial.puts((&s_ed[0]) as u64)
    if vmode.edid_ok(state) {
        serial.puts((&s_yes[0]) as u64)
        serial.puts((&s_nat[0]) as u64)
        serial.dec(vmode.edid_native_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(vmode.edid_native_h(state))
        serial.puts((&s_ven[0]) as u64)
        i = 0
        while i < 3 {
            serial.put(vmode.vendor_at(state, i) as u8)
            i = i + 1
        }
        serial.puts((&s_mod[0]) as u64)
        i = 0
        while i < 13 {
            let c: u64 = vmode.model_at(state, i)
            if c >= 32 && c < 127 {
                serial.put(c as u8)
            }
            i = i + 1
        }
    } else {
        serial.puts((&s_why[0]) as u64)
        serial.dec(vmode.edid_why(state))
    }
    serial.nl()
    if vmode.want(state, vmode.M_EDID) {
        serial.puts((&s_raw[0]) as u64)
        var s_sp: [u8; 2] = " \0"
        i = 0
        while i < vmode.edid_bytes() {
            serial.hex(vmode.edid_at(state, i))
            serial.puts((&s_sp[0]) as u64)
            i = i + 1
        }
        serial.nl()
    }
    serial.puts((&s_st[0]) as u64)
    serial.dec(vmode.selftest(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(vmode.selftest_max())
    serial.nl()
    var s_ka: [u8; 20] = "disp: kacheln alle=\0"
    var s_ka2: [u8; 8] = "  frei=\0"
    var s_ka3: [u8; 10] = "  belegt=\0"
    var s_ka4: [u8; 6] = "  fb=\0"
    var s_ka5: [u8; 11] = "  laufmax=\0"
    serial.puts((&s_ka[0]) as u64)
    serial.dec(fb.win_slots())
    serial.puts((&s_ka2[0]) as u64)
    serial.dec(fb.free_slots(state))
    serial.puts((&s_ka3[0]) as u64)
    serial.dec(apic.window_slots(state))
    serial.puts((&s_ka4[0]) as u64)
    serial.dec(fb.slot0(state))
    serial.puts((&s_ka5[0]) as u64)
    serial.dec(fb.longest_run(state))
    serial.nl()

    var s_stc: [u8; 23] = "disp: custom selftest \0"
    serial.puts((&s_stc[0]) as u64)
    serial.dec(vmode.selftest_custom(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(vmode.selftest_custom_max())
    serial.nl()
    serial.puts((&s_st2[0]) as u64)
    serial.dec(fb.selftest2(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(fb.selftest2_max())
    serial.nl()
    serial.puts((&s_room[0]) as u64)
    serial.dec(fb.selftest5(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(fb.selftest5_max())
    serial.nl()
    serial.puts((&s_geo[0]) as u64)
    serial.dec(fb.width(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.height(state))
    serial.puts((&s_gp[0]) as u64)
    serial.dec(fb.pitch(state))
    serial.puts((&s_gt[0]) as u64)
    serial.dec(fb.panel_w(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.panel_h(state))
    serial.puts((&s_gq[0]) as u64)
    serial.dec(fb.panel_pitch(state))
    serial.puts((&s_gr[0]) as u64)
    serial.dec(fb.rotation(state))
    serial.puts((&s_gs[0]) as u64)
    serial.dec(fb.scale(state))
    serial.puts((&s_gl[0]) as u64)
    serial.dec(fb.lut(state))
    serial.puts((&s_gv[0]) as u64)
    serial.dec(fb.saturation(state))
    serial.puts((&s_gd[0]) as u64)
    serial.dec(bnum(fb.draw_at(state) == fb.back(state)))
    serial.nl()
}

fn display_hold(state: u64) {
    var s_sw: [u8; 14] = "disp: switch \0"
    var s_x: [u8; 2] = "x\0"
    var s_arr: [u8; 5] = " -> \0"
    var s_rc: [u8; 5] = " rc=\0"
    var s_us: [u8; 5] = " us=\0"
    var s_now: [u8; 8] = " panel=\0"
    var s_cnt: [u8; 12] = "disp: sw=\0\0\0"
    var s_fl: [u8; 9] = "  fail=\0\0"
    var s_rv: [u8; 8] = "  rev=\0\0"
    var s_rot: [u8; 12] = "disp: rot=\0\0"
    var s_img: [u8; 8] = "  img=\0\0"
    var s_cf: [u8; 20] = "disp: confirm pend=\0"
    var s_left: [u8; 8] = " left=\0\0"
    var s_rr: [u8; 9] = " after=\0\0"

    if !vmode.ready(state) {
        return
    }
    if vmode.want(state, vmode.M_BIG) {
        disp_switch(state, 1024, 768, (&s_sw[0]) as u64, (&s_x[0]) as u64,
            (&s_arr[0]) as u64, (&s_rc[0]) as u64, (&s_us[0]) as u64,
            (&s_now[0]) as u64)
    }
    if vmode.want(state, vmode.M_BACK) {
        disp_switch(state, 800, 600, (&s_sw[0]) as u64, (&s_x[0]) as u64,
            (&s_arr[0]) as u64, (&s_rc[0]) as u64, (&s_us[0]) as u64,
            (&s_now[0]) as u64)
    }
    if vmode.want(state, vmode.M_BAD) {
        disp_switch(state, 4096, 4096, (&s_sw[0]) as u64, (&s_x[0]) as u64,
            (&s_arr[0]) as u64, (&s_rc[0]) as u64, (&s_us[0]) as u64,
            (&s_now[0]) as u64)
    }
    if vmode.want(state, vmode.M_CONFIRM) {
        disp_switch(state, 1024, 768, (&s_sw[0]) as u64, (&s_x[0]) as u64,
            (&s_arr[0]) as u64, (&s_rc[0]) as u64, (&s_us[0]) as u64,
            (&s_now[0]) as u64)
        serial.puts((&s_cf[0]) as u64)
        serial.dec(bnum(vmode.pending(state)))
        serial.puts((&s_left[0]) as u64)
        serial.dec(vmode.remaining(state) / 1000)
        serial.nl()
        disp_wait(state, vmode.CONFIRM_MS + 500)
        let ging: bool = vmode.poll(state)
        serial.puts((&s_cf[0]) as u64)
        serial.dec(bnum(vmode.pending(state)))
        serial.puts((&s_rr[0]) as u64)
        serial.dec(bnum(ging))
        serial.puts((&s_now[0]) as u64)
        serial.dec(fb.panel_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.panel_h(state))
        serial.nl()
    }
    // ============================================ RUNDE CUSTOMRES
    if vmode.want(state, vmode.M_OWN) {
        disp_own(state, 1400, 1050, 32)
    }
    if vmode.want(state, vmode.M_EIGENBAD) {
        disp_own(state, 3840, 2160, 32)
        disp_own(state, 1366, 768, 32)
        disp_own(state, 1400, 1050, 16)
    }
    if vmode.want(state, vmode.M_EIGENFRIST) {
        disp_own(state, 1400, 1050, 32)
        serial.puts((&s_cf[0]) as u64)
        serial.dec(bnum(vmode.pending(state)))
        serial.puts((&s_left[0]) as u64)
        serial.dec(vmode.remaining(state) / 1000)
        serial.nl()
        disp_wait(state, vmode.CONFIRM_MS + 1500)
        let ging: bool = vmode.poll(state)
        serial.puts((&s_cf[0]) as u64)
        serial.dec(bnum(vmode.pending(state)))
        serial.puts((&s_rr[0]) as u64)
        serial.dec(bnum(ging))
        serial.puts((&s_now[0]) as u64)
        serial.dec(fb.panel_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.panel_h(state))
        serial.nl()
    }
    if vmode.want(state, vmode.M_BENCH) {
        disp_bench(state)
    }
    if vmode.want(state, vmode.M_ROT) {
        fb.set_rotation(state, 90)
        serial.puts((&s_rot[0]) as u64)
        serial.dec(fb.rotation(state))
        serial.puts((&s_img[0]) as u64)
        serial.dec(fb.width(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.height(state))
        serial.puts((&s_now[0]) as u64)
        serial.dec(fb.panel_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.panel_h(state))
        serial.nl()
    }
    vmode.confirm(state)
    serial.puts((&s_cnt[0]) as u64)
    serial.dec(vmode.switches(state))
    serial.puts((&s_fl[0]) as u64)
    serial.dec(vmode.fails(state))
    serial.puts((&s_rv[0]) as u64)
    serial.dec(vmode.reverts(state))
    serial.nl()
}

fn disp_own(state: u64, w: u64, h: u64, bpp: u64) {
    var s_e: [u8; 14] = "disp: eigen \0\0"
    var s_x: [u8; 2] = "x\0"
    var s_t: [u8; 3] = "x \0"
    var s_rc: [u8; 5] = " rc=\0"
    var s_wy: [u8; 8] = "  why=\0\0"
    var s_nm: [u8; 8] = "  num=\0\0"
    var s_lim: [u8; 12] = "  maplimit=\0"
    var s_vr: [u8; 9] = "  vram=\0\0"
    var s_now: [u8; 8] = " panel=\0"
    var s_us: [u8; 5] = " us=\0"
    var s_cn: [u8; 11] = "  custom=\0\0"
    let t: u64 = apic.tsc()
    let rc: u64 = vmode.set_custom(state, w, h, bpp)
    let d: u64 = us_of(state, apic.tsc() - t)
    serial.puts((&s_e[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_t[0]) as u64)
    serial.dec(bpp)
    serial.puts((&s_rc[0]) as u64)
    serial.dec(rc)
    serial.puts((&s_wy[0]) as u64)
    serial.dec(vmode.cust_why(state))
    serial.puts((&s_nm[0]) as u64)
    serial.dec(vmode.cust_num(state))
    serial.puts((&s_vr[0]) as u64)
    serial.dec(vmode.vram(state))
    serial.puts((&s_lim[0]) as u64)
    serial.dec(vmode.map_limit(state))
    serial.puts((&s_cn[0]) as u64)
    serial.dec(vmode.customs(state))
    serial.puts((&s_now[0]) as u64)
    serial.dec(fb.panel_w(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.panel_h(state))
    serial.puts((&s_us[0]) as u64)
    serial.dec(d)
    serial.nl()
}

fn disp_wait(state: u64, ms: u64) {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return
    }
    let bis: u64 = apic.tsc() + (hz / 1000) * ms
    while apic.tsc() < bis {
    }
}

fn disp_switch(state: u64, w: u64, h: u64, s_sw: u64, s_x: u64, s_arr: u64,
    s_rc: u64, s_us: u64, s_now: u64) {
    let vw: u64 = fb.panel_w(state)
    let vh: u64 = fb.panel_h(state)
    let t: u64 = apic.tsc()
    let rc: u64 = vmode.set_mode(state, w, h, 32)
    let d: u64 = us_of(state, apic.tsc() - t)
    serial.puts(s_sw)
    serial.dec(vw)
    serial.puts(s_x)
    serial.dec(vh)
    serial.puts(s_arr)
    serial.dec(w)
    serial.puts(s_x)
    serial.dec(h)
    serial.puts(s_rc)
    serial.dec(rc)
    serial.puts(s_us)
    serial.dec(d)
    serial.puts(s_now)
    serial.dec(fb.panel_w(state))
    serial.puts(s_x)
    serial.dec(fb.panel_h(state))
    serial.nl()
}

fn disp_bench(state: u64) {
    var s_h: [u8; 13] = "disp: bench \0"
    var s_x: [u8; 2] = "x\0"
    var s_fl: [u8; 10] = "  flush=\0\0"
    var s_lu: [u8; 8] = "  lut=\0\0"
    var s_sa: [u8; 8] = "  sat=\0\0"
    var s_ro: [u8; 10] = "  rot90=\0\0"
    var s_ln: [u8; 11] = "  lutline=\0"
    var s_us: [u8; 4] = " us\0"
    var s_px: [u8; 7] = "  px=\0\0"
    var s_want: [u8; 18] = "disp: bench want \0"
    var s_rc: [u8; 5] = " rc=\0"

    let n: u64 = vmode.count(state)
    if n > 0 {
        let brc: u64 = vmode.set_mode(state, vmode.mode_w(state, n - 1),
            vmode.mode_h(state, n - 1), 32)
        vmode.confirm(state)
        serial.puts((&s_want[0]) as u64)
        serial.dec(vmode.mode_w(state, n - 1))
        serial.puts((&s_x[0]) as u64)
        serial.dec(vmode.mode_h(state, n - 1))
        serial.puts((&s_rc[0]) as u64)
        serial.dec(brc)
        serial.nl()
    }
    let w: u64 = fb.panel_w(state)
    let h: u64 = fb.panel_h(state)
    fb.clear(state, fb.rgb(state, 0x30, 0x60, 0x90))

    fb.set_lut(state, 0)
    fb.set_saturation(state, 100)
    fb.set_rotation(state, 0)
    var t: u64 = apic.tsc()
    var i: u64 = 0
    while i < DISP_RUNDEN {
        fb.dirty_all(state)
        fb.flush(state)
        i = i + 1
    }
    let d_fl: u64 = us_of(state, apic.tsc() - t) / DISP_RUNDEN

    fb.set_lut(state, vmode.lut_addr(state))
    t = apic.tsc()
    i = 0
    while i < DISP_RUNDEN {
        fb.dirty_all(state)
        fb.flush(state)
        i = i + 1
    }
    let d_lu: u64 = us_of(state, apic.tsc() - t) / DISP_RUNDEN

    t = apic.tsc()
    i = 0
    while i < DISP_RUNDEN {
        fb.dirty(state, 0, 16)
        fb.flush(state)
        i = i + 1
    }
    let d_ln: u64 = us_of(state, apic.tsc() - t) / DISP_RUNDEN

    fb.set_saturation(state, 150)
    t = apic.tsc()
    i = 0
    while i < DISP_RUNDEN {
        fb.dirty_all(state)
        fb.flush(state)
        i = i + 1
    }
    let d_sa: u64 = us_of(state, apic.tsc() - t) / DISP_RUNDEN
    fb.set_saturation(state, 100)

    fb.set_lut(state, 0)
    var d_ro: u64 = 0
    if fb.set_rotation(state, 90) {
        t = apic.tsc()
        i = 0
        while i < DISP_RUNDEN {
            fb.dirty_all(state)
            fb.flush(state)
            i = i + 1
        }
        d_ro = us_of(state, apic.tsc() - t) / DISP_RUNDEN
        fb.set_rotation(state, 0)
    }

    serial.puts((&s_h[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_px[0]) as u64)
    serial.dec(w * h)
    serial.puts((&s_fl[0]) as u64)
    serial.dec(d_fl)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_lu[0]) as u64)
    serial.dec(d_lu)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_ln[0]) as u64)
    serial.dec(d_ln)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_sa[0]) as u64)
    serial.dec(d_sa)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_ro[0]) as u64)
    serial.dec(d_ro)
    serial.puts((&s_us[0]) as u64)
    serial.nl()
}

fn us_of(state: u64, takte: u64) -> u64 {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return 0
    }
    return takte * 1000000 / hz
}

fn gfx_bench(state: u64, back: u64) {
    var s_b1: [u8; 26] = "        fbbench: direct  \0"
    var s_b2: [u8; 26] = "        fbbench: buffered\0"
    var s_fill: [u8; 8] = "  fill=\0"
    var s_scr: [u8; 10] = "  scroll=\0"
    var s_fl: [u8; 9] = "  flush=\0"
    var s_ln: [u8; 9] = "  line=\0\0"
    var s_us: [u8; 4] = " us\0"
    var s_nb: [u8; 30] = "        fbbench: no time base\0"

    if apic.tsc_hz(state) == 0 {
        serial.puts((&s_nb[0]) as u64)
        serial.nl()
        return
    }
    let color: u64 = fb.rgb(state, 0x20, 0x30, 0x40)

    fb.set_back(state, 0)
    var t: u64 = apic.tsc()
    var i: u64 = 0
    while i < GFX_RUNDEN {
        fb.clear(state, color)
        i = i + 1
    }
    let d_fill: u64 = us_of(state, apic.tsc() - t) / GFX_RUNDEN
    t = apic.tsc()
    i = 0
    while i < GFX_RUNDEN {
        fb.scroll(state)
        i = i + 1
    }
    let d_scroll: u64 = us_of(state, apic.tsc() - t) / GFX_RUNDEN
    let d_line: u64 = bench_line(state)
    serial.puts((&s_b1[0]) as u64)
    serial.puts((&s_fill[0]) as u64)
    serial.dec(d_fill)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_scr[0]) as u64)
    serial.dec(d_scroll)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_ln[0]) as u64)
    serial.dec(d_line)
    serial.puts((&s_us[0]) as u64)
    serial.nl()

    if back == 0 {
        fb.set_back(state, 0)
        return
    }

    fb.set_back(state, back)
    t = apic.tsc()
    i = 0
    while i < GFX_RUNDEN {
        fb.clear(state, color)
        i = i + 1
    }
    let b_fill: u64 = us_of(state, apic.tsc() - t) / GFX_RUNDEN
    t = apic.tsc()
    i = 0
    while i < GFX_RUNDEN {
        fb.scroll(state)
        i = i + 1
    }
    let b_scroll: u64 = us_of(state, apic.tsc() - t) / GFX_RUNDEN
    t = apic.tsc()
    i = 0
    while i < GFX_RUNDEN {
        fb.dirty_all(state)
        fb.flush(state)
        i = i + 1
    }
    let b_flush: u64 = us_of(state, apic.tsc() - t) / GFX_RUNDEN
    let b_line: u64 = bench_line(state)
    serial.puts((&s_b2[0]) as u64)
    serial.puts((&s_fill[0]) as u64)
    serial.dec(b_fill)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_scr[0]) as u64)
    serial.dec(b_scroll)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_fl[0]) as u64)
    serial.dec(b_flush)
    serial.puts((&s_us[0]) as u64)
    serial.puts((&s_ln[0]) as u64)
    serial.dec(b_line)
    serial.puts((&s_us[0]) as u64)
    serial.nl()
}

fn durchsatz(state: u64) {
    var s_h: [u8; 20] = "        durchsatz: \0"
    var s_x: [u8; 2] = "x\0"
    var s_px: [u8; 9] = "  bytes=\0"
    var s_us: [u8; 7] = "  us=\0\0"
    var s_mb: [u8; 9] = "  mb_s=\0\0"
    var s_fps: [u8; 8] = "  fps=\0\0"
    var s_pde: [u8; 8] = "  pde=\0\0"
    var s_pat: [u8; 8] = "  pat=\0\0"
    var s_wc: [u8; 7] = "  wc=\0\0"
    var s_uc: [u8; 7] = "  uc=\0\0"
    var s_st: [u8; 12] = "  streifen=\0"
    var s_nb: [u8; 33] = "        durchsatz: no time base\0\0"

    if apic.tsc_hz(state) == 0 {
        serial.puts((&s_nb[0]) as u64)
        serial.nl()
        return
    }
    let w: u64 = fb.width(state)
    let h: u64 = fb.height(state)
    if w == 0 || h == 0 {
        return
    }
    let bytes: u64 = fb.pitch(state) *% h
    let color: u64 = fb.rgb(state, 0x10, 0x20, 0x30)

    let t: u64 = apic.tsc()
    var i: u64 = 0
    while i < GFX_RUNDEN {
        fb.clear(state, color)
        i = i + 1
    }
    let us: u64 = us_of(state, apic.tsc() -% t) / GFX_RUNDEN

    serial.puts((&s_h[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_px[0]) as u64)
    serial.dec(bytes)
    serial.puts((&s_us[0]) as u64)
    serial.dec(us)
    serial.puts((&s_mb[0]) as u64)
    if us != 0 {
        serial.dec(bytes / us)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_fps[0]) as u64)
    if us != 0 {
        serial.dec(1000000 / us)
    } else {
        serial.dec(0)
    }
    serial.nl()

    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_pde[0]) as u64)
    serial.hex(fb.pde_roh(state))
    serial.puts((&s_pat[0]) as u64)
    serial.hex(fb.pat_roh(state))
    serial.puts((&s_wc[0]) as u64)
    serial.dec(fb.wc(state))
    serial.puts((&s_uc[0]) as u64)
    serial.dec(bnum(fb.uncached(state)))
    serial.puts((&s_st[0]) as u64)
    serial.dec(bnum(fb.stripe(state)))
    serial.nl()
}

fn perf_rate(state: u64, bytes: u64, cyc: u64, rounds: u64) -> u64 {
    let us: u64 = us_of(state, cyc)
    if us == 0 {
        return 0
    }
    return bytes * rounds / us
}

fn fb_clear_rate(state: u64, bytes: u64, color: u64) -> u64 {
    let t: u64 = apic.tsc()
    var n: u64 = 0
    while n < GFX_RUNDEN && us_of(state, apic.tsc() -% t) < 400000 {
        fb.clear(state, color)
        n = n + 1
    }
    return perf_rate(state, bytes, apic.tsc() -% t, n)
}

fn fbperf(state: u64, back: u64) {
    var s_h: [u8; 16] = "        fbperf:\0"
    var s_w: [u8; 16] = "  fb_write_mbs=\0"
    var s_c: [u8; 16] = "  fb_copy_mbs=\0\0"
    var s_r: [u8; 17] = "  ram_write_mbs=\0"
    var s_m: [u8; 15] = "  cache_mode=\0\0"
    var s_p: [u8; 11] = "  pat_wc=\0\0"
    var s_t: [u8; 14] = "  mtrr_type=\0\0"
    var s_f0: [u8; 17] = "  fb_write0_mbs=\0"
    var s_ms: [u8; 16] = "  mtrr_wc_st=\0\0\0"
    var s_mr: [u8; 16] = "  mtrr_wc_rs=\0\0\0"
    var s_mc: [u8; 16] = "  mtrr_wc_n=\0\0\0\0"
    var s_md: [u8; 16] = "  mtrr_wc_done=\0"
    var s_n: [u8; 37] = "        fbperf: no time base\0\0\0\0\0\0\0\0\0"
    if apic.tsc_hz(state) == 0 {
        serial.puts((&s_n[0]) as u64)
        serial.nl()
        return
    }
    let w: u64 = fb.width(state)
    let h: u64 = fb.height(state)
    if w == 0 || h == 0 {
        return
    }
    let bytes: u64 = fb.pitch(state) *% h
    let color: u64 = fb.rgb(state, 0x10, 0x20, 0x30)
    fb.mtrr_probe(state)
    var ram: u64 = 0
    var cpy: u64 = 0
    var n: u64 = 0
    var t: u64 = 0
    var i: u64 = 0
    if back != 0 {
        fb.set_back(state, back)
        t = apic.tsc()
        i = 0
        while i < GFX_RUNDEN {
            fb.clear(state, color)
            i = i + 1
        }
        ram = perf_rate(state, bytes, apic.tsc() -% t, GFX_RUNDEN)
        t = apic.tsc()
        n = 0
        while n < GFX_RUNDEN && us_of(state, apic.tsc() -% t) < 400000 {
            fb.dirty_all(state)
            fb.flush(state)
            n = n + 1
        }
        cpy = perf_rate(state, bytes, apic.tsc() -% t, n)
    }
    fb.set_back(state, 0)
    var fbw: u64 = fb_clear_rate(state, bytes, color)
    let fbw0: u64 = fbw
    n = GFX_RUNDEN
    if fb.mtrrsim_an(state) {
        fbmtrr.sim_enable(state)
    }
    if fb.wc(state) != 0 {
        let st: u64 = fbmtrr.setup(state, fb.phys(state), fb.pitch(state) *% h, true, fb.nomtrr_an(state))
        if st == fbmtrr.ST_TENTATIVE {
            fbw = fb_clear_rate(state, bytes, color)
            if fbw * 4 < fbw0 * 5 && (!fb.mtrrsim_an(state) || fb.mtrrstrict_an(state)) {
                fbmtrr.revert(state, fbmtrr.RS_NO_GAIN)
                fbw = fbw0
            } else {
                fbmtrr.confirm(state)
            }
        }
    } else {
        fbmtrr.setup(state, 0, 0, false, fb.nomtrr_an(state))
    }
    fb.mtrr_probe(state)
    fb.perf_set(state, fb.PF_FBW0, fbw0)
    if back != 0 {
        fb.set_back(state, back)
        fb.dirty_all(state)
        fb.flush(state)
    }
    fb.perf_set(state, fb.PF_FBW, fbw)
    fb.perf_set(state, fb.PF_COPY, cpy)
    fb.perf_set(state, fb.PF_RAM, ram)
    fb.perf_set(state, fb.PF_BYTES, bytes)
    fb.perf_set(state, fb.PF_ROUNDS, n)
    fb.perf_set(state, fb.PF_DONE, 1)
    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_w[0]) as u64)
    serial.dec(fbw)
    serial.puts((&s_c[0]) as u64)
    serial.dec(cpy)
    serial.puts((&s_r[0]) as u64)
    serial.dec(ram)
    serial.puts((&s_m[0]) as u64)
    serial.dec(fb.cache_mode(state))
    serial.puts((&s_p[0]) as u64)
    serial.dec(fb.wc(state))
    serial.puts((&s_t[0]) as u64)
    serial.dec(fb.perf_get(state, fb.PF_MTRR) & 255)
    serial.puts((&s_f0[0]) as u64)
    serial.dec(fbw0)
    serial.puts((&s_ms[0]) as u64)
    serial.dec(fbmtrr.state_of(state))
    serial.puts((&s_mr[0]) as u64)
    serial.dec(fbmtrr.reason_of(state))
    serial.puts((&s_mc[0]) as u64)
    serial.dec(fbmtrr.count_of(state))
    serial.puts((&s_md[0]) as u64)
    serial.hex(fbmtrr.done_of(state))
    serial.nl()
}

fn bench_line(state: u64) -> u64 {
    let mark: bool = fb.cursor_on(state)
    fb.set_cursor(state, false)
    fb.clear(state, 0)
    fb.home(state)
    fb.flush(state)
    let t: u64 = apic.tsc()
    var i: u64 = 0
    while i < GFX_RUNDEN {
        var c: u64 = 0
        while c < 80 {
            fb.putc(state, 88) // 'X'
            c = c + 1
        }
        fb.putc(state, 10)
        i = i + 1
    }
    let us: u64 = us_of(state, apic.tsc() - t) / GFX_RUNDEN
    fb.set_cursor(state, mark)
    return us
}

fn gfx_user(state: u64) {
    var s_run: [u8; 30] = "fb: ring 3 paints, mirror off\0"
    var s_exit: [u8; 18] = "fb: ring 3 exit=\0\0"

    serial.puts((&s_run[0]) as u64)
    serial.nl()
    fb.set_echo(state, false)
    fb.set_cursor(state, false)
    fb.clear(state, 0)
    fb.dirty_all(state)
    fb.flush(state)
    let arg: u64 = (fb.width(state) << 16) | fb.height(state)
    let t: u64 = proc.create(state, P_FB, arg, 2)
    let e: u64 = kutil.wait_for(state, t)
    serial.puts((&s_exit[0]) as u64)
    serial.dec(e)
    serial.nl()
}

fn testimage_header(dst: u64) -> u64 {
    var rest: [u8; 22] = " K7 FRAMEBUFFER 01234\0"
    var n: u64 = brand.append(dst, 0, brand.product(), 63)
    n = brand.append(dst, n, (&rest[0]) as u64, 63)
    kstate.set8(dst + n, 0)
    return n
}

fn gfx_hold(state: u64) {
    var s_pat: [u8; 64] = [0 as u8; 64]
    let _pk: u64 = testimage_header((&s_pat[0]) as u64)
    var s_pat2: [u8; 26] = "abcdefghijklm ABCDEFGHIJK\0"
    var s_hold: [u8; 10] = "fb: hold\0\0"
    var s_go: [u8; 10] = "fb: go\0\0\0\0"

    if fb.ready(state) {
        if fb.want(state, fb.M_USER) {
            gfx_user(state)
        }
        display_hold(state)
        if fb.want(state, fb.M_PATTERN) {
            pattern(state, (&s_pat[0]) as u64, (&s_pat2[0]) as u64)
        }
        fb.canon_probe(state)
        power_screen(state)
        fb.flush(state)
        // r819: with a virtio-gpu `fb.flush` returns at once (the device reads the back buffer);
        // the dirty rect only reaches the host through `vgpu.present`. Without this line the
        // test image stayed in the back buffer and a screendump of the vgpu showed black.
        gfx.bild_fertig(state)
    }
    if !fb.want(state, fb.M_HOLD) {
        return
    }
    serial.puts((&s_hold[0]) as u64)
    serial.nl()
    if kstate.mode_on(state, kstate.M_VGPUHW) {
        vgpuhw_run(state)
    }
    if kstate.mode_on(state, kstate.M_VMSVGAHW) {
        vmsvga_run(state)
    }
    let hz: u64 = apic.tsc_hz(state)
    if hz != 0 {
        let bis: u64 = apic.tsc() + hz * 4
        while apic.tsc() < bis {
            usb.hotplug_work(state)
            if netdev.late_usb(state) {
                netsvc.stage(state)
            }
            wechsel_schritt(state)
        }
    }
    serial.puts((&s_go[0]) as u64)
    serial.nl()
}

fn vgpuhw_run(state: u64) {
    var s_p1: [u8; 17] = "vgpuhw: move hw=\0"
    var s_p2: [u8; 19] = "vgpuhw: frames hw=\0"
    var s_fr: [u8; 9] = " moves=\0\0"
    var s_ok: [u8; 7] = " okt=\0\0"
    var s_pf: [u8; 11] = " perframe=\0"
    var s_rd: [u8; 14] = "vgpuhw: ready\0"
    var s_pn: [u8; 15] = "vgpuhw: panel=\0"
    var s_x: [u8; 2] = "x\0"
    var s_en: [u8; 12] = "vgpuhw: end\0"
    var s_no: [u8; 15] = "vgpuhw: novgpu\0"
    if !vgpu.usable(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    let hw: bool = vgpu.cursor_usable(state) && !kstate.mode_on(state, kstate.M_NOHWCUR)
    let y0: u64 = 300
    let x0: u64 = 300
    if hw {
        let _z: bool = vgpu.cursor_displayed(state, 0, 32, x0, y0, 0, 0, 0)
    }
    let white: u64 = fb.rgb(state, 0xFF, 0xFF, 0xFF)
    // phase 1: moves only
    let o1: u64 = vgpu.oktette(state)
    let m1: u64 = vgpu.cursor_moves(state)
    var i: u64 = 0
    while i < 60 {
        let nx: u64 = x0 + i * 3
        if hw {
            let _m: bool = vgpu.cursor_bewegen(state, nx, y0)
        } else {
            fb.fill(state, nx, y0, 12, 12, white)
            fb.flush_rect(state, nx, y0, 12, 12)
            gfx.bild_fertig(state)
        }
        i = i + 1
    }
    serial.puts((&s_p1[0]) as u64)
    if hw {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_fr[0]) as u64)
    serial.dec(vgpu.cursor_moves(state) - m1)
    serial.puts((&s_ok[0]) as u64)
    serial.dec(vgpu.oktette(state) - o1)
    serial.nl()
    // phase 2: 60 frames, one pointer-sized dirty rect (or the whole screen under wmruhe)
    let o2: u64 = vgpu.oktette(state)
    i = 0
    while i < 60 {
        let nx: u64 = x0 + i * 3
        if kstate.mode_on(state, kstate.M_WMRUHE) {
            fb.dirty_all(state)
        } else {
            fb.flush_rect(state, nx - 8, y0 - 8, 48, 48)
        }
        gfx.bild_fertig(state)
        i = i + 1
    }
    let d2: u64 = vgpu.oktette(state) - o2
    serial.puts((&s_p2[0]) as u64)
    if hw {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_ok[0]) as u64)
    serial.dec(d2)
    serial.puts((&s_pf[0]) as u64)
    serial.dec(d2 / 60)
    serial.nl()
    vgpu.say_hw(state)
    serial.puts((&s_rd[0]) as u64)
    serial.nl()
    // phase 3: wait for the host resize
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return
    }
    var until: u64 = apic.tsc() + hz * 30
    var lw: u64 = fb.panel_w(state)
    var lh: u64 = fb.panel_h(state)
    while apic.tsc() < until {
        let _e: bool = gfx.gpu_event(state)
        let pw: u64 = fb.panel_w(state)
        let ph: u64 = fb.panel_h(state)
        if pw != lw || ph != lh {
            lw = pw
            lh = ph
            // the switch cleared the screen: paint the red square again so the harness has something to find
            fb.fill(state, 0, 0, 100, 100, fb.rgb(state, 0xFF, 0, 0))
            fb.flush_rect(state, 0, 0, 100, 100)
            gfx.bild_fertig(state)
            serial.puts((&s_pn[0]) as u64)
            serial.dec(pw)
            serial.puts((&s_x[0]) as u64)
            serial.dec(ph)
            serial.nl()
            vgpu.say_hw(state)
            until = apic.tsc() + hz * 6
        }
    }
    serial.puts((&s_en[0]) as u64)
    serial.nl()
}

// `vmsvgahw` test bed (tools/vmsvga/run.sh): the VMSVGA hardware cursor, the size of the UPDATE rectangles, and mode switches
// through the host-resize path (vmode.follow_host = what the topology poll calls). The same mode sequence also runs on the
// Bochs path (reference for the pixel comparison; `novmsvga` or `-vga std`).
//   phase 1  pointer moves only: 60 moves, nothing may travel as picture data (update octets difference 0)
//   phase 2  60 frames with one 48x48 dirty rect: octets the host was told per frame
//   phase 3  four mode switches, each with a fixed test picture and a pause for the harness screendump
// Host-hint stage of the vmsvga test bed: the hint a VirtualBox window drag would deliver is injected (vmsvga.vmm_fake) and the REAL
// poll code (host_pending: two polls in a row, sane size, differs from the mode) and vmode.follow_host run. Odd sizes, an odd height
// and a screen bigger than the card/map window (4096x2304 -> shrunk, same aspect) must all end in a working mode.
// r1004 gate (tools/vmsvga/resize.sh, kernel word `vmsvgahints`): the real desktop plays host resolution hints by itself, because QEMU's
// vmware card never sends one. 45 s after the first call, then every 25 s: 1280x720, 1024x768, 1600x900, 1024x768 (repeating) go
// through vmode.follow_host, the very call the VirtualBox hint poll makes. Serial: `vmsvga: testhint WxH rc=N`.
static mut hint_next_ms: u64 = 0
static mut hint_step: u64 = 0
// r1061: a floating probe window (900x500) that the hint player makes before the first hint. After every hint the line
// `wm: refit probe WxH` names its size: it must shrink on a smaller screen and get the 900x500 back when the screen grows again.
static mut hint_probe: u64 = 0xFFFFFFFFFFFFFFFF

fn hint_player(state: u64) {
    var s_a: [u8; 20] = "vmsvga: testhint \0\0\0"
    var s_x: [u8; 2] = "x\0"
    var s_r: [u8; 5] = " rc=\0"
    let hz: u64 = apic.tsc_hz(state)
    if hz < 1000 {
        return
    }
    let now: u64 = apic.tsc() / (hz / 1000)
    if hint_next_ms == 0 {
        hint_next_ms = now + 45000
        if kstate.mode_on(state, kstate.M_VMSVGAFULL) {
            // r1226: the Full HD gate judges the boot mode (1920x1080) after the login first; with three parallel QEMUs the login can take > 45 s
            hint_next_ms = now + 150000
        }
        var s_pt: [u8; 12] = "refitprobe\0\0"
        let pr: u64 = wm.create(state, 0, 20, 20, 900, 500, wm.K_RAW, (&s_pt[0]) as u64)
        if pr < wm.MAX_WIN {
            hint_probe = pr
        }
        return
    }
    if now < hint_next_ms {
        return
    }
    hint_next_ms = now + 25000
    var w: u64 = 1280
    var h: u64 = 720
    let k: u64 = hint_step % 4
    if kstate.mode_on(state, kstate.M_VMSVGAFULL) {
        // r1226 (tools/fullhd): Full HD steps -- 1920x1200, 1366x768 (width not divisible by 8), 1024x768, 1920x1080
        w = 1920
        h = 1200
        if k == 1 {
            w = 1366
            h = 768
        }
        if k == 2 {
            w = 1024
            h = 768
        }
        if k == 3 {
            w = 1920
            h = 1080
        }
    } else if kstate.mode_on(state, kstate.M_VMSVGAODD) {
        // tools/vmsvgaresize/odd.sh: odd sizes as a VirtualBox window with GUI scale 1.75 sends them: 1426x861, 1397x777, 1111x703, 1853x1049
        w = 1426
        h = 861
        if k == 1 {
            w = 1397
            h = 777
        }
        if k == 2 {
            w = 1111
            h = 703
        }
        if k == 3 {
            w = 1853
            h = 1049
        }
    } else if kstate.mode_on(state, kstate.M_VMSVGASTALE) {
        // stale-stride gate (tools/vmsvgaresize/stale.sh): 1280x720, 800x600, 1024x768, 800x600
        if k == 1 || k == 3 {
            w = 800
            h = 600
        }
        if k == 2 {
            w = 1024
            h = 768
        }
    } else if kstate.mode_on(state, kstate.M_VMSVGABIG) {
        // r1139 (tools/vmsvgaresize/big.sh): 1280x720, 2496x1507 (over the 8-tile framebuffer limit: follow_host shrinks it ONCE to 2340x1412),
        // 1024x768, 1600x900
        if k == 1 {
            w = 2496
            h = 1507
        }
        if k == 2 {
            w = 1024
            h = 768
        }
        if k == 3 {
            w = 1600
            h = 900
        }
    } else if kstate.mode_on(state, kstate.M_VMSVGABOOT) {
        // W-C3f: large steps like a VirtualBox window drag: 1920x1080, 1280x720, 2304x1296 (QEMU's card limit is 2368), 1600x900; with the kernel words vmsvgahints + vmsvgaboot
        w = 1920
        h = 1080
        if k == 1 {
            w = 1280
            h = 720
        }
        if k == 2 {
            w = 2304
            h = 1296
        }
        if k == 3 {
            w = 1600
            h = 900
        }
    } else {
        if k == 1 || k == 3 {
            w = 1024
            h = 768
        }
        if k == 2 {
            w = 1600
            h = 900
        }
    }
    hint_step = hint_step + 1
    let rc: u64 = vmode.follow_host(state, w, h)
    serial.puts((&s_a[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_r[0]) as u64)
    serial.dec(rc)
    // r1139: the size the screen really has now (a hint over the card/tile limit is shrunk)
    var s_nw: [u8; 6] = " now=\0"
    serial.puts((&s_nw[0]) as u64)
    serial.dec(fb.width(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.height(state))
    var s_sw: [u8; 5] = " sw=\0"
    var s_fl: [u8; 5] = " fl=\0"
    var s_rv: [u8; 5] = " rv=\0"
    serial.puts((&s_sw[0]) as u64)
    serial.dec(vmode.switches(state))
    serial.puts((&s_fl[0]) as u64)
    serial.dec(vmode.fails(state))
    serial.puts((&s_rv[0]) as u64)
    serial.dec(vmode.reverts(state))
    serial.nl()
    if hint_probe < wm.MAX_WIN {
        var s_rp: [u8; 18] = "wm: refit probe \0\0"
        serial.puts((&s_rp[0]) as u64)
        serial.dec(wm.win_w(state, hint_probe))
        serial.puts((&s_x[0]) as u64)
        serial.dec(wm.win_h(state, hint_probe))
        serial.nl()
    }
}

fn vmsvga_hint_one(state: u64, w: u64, h: u64) {
    var s_a: [u8; 17] = "vmsvga: hint in=\0"
    var s_x: [u8; 2] = "x\0"
    var s_p1: [u8; 5] = " p1=\0"
    var s_pe: [u8; 7] = " pend=\0"
    var s_rc: [u8; 5] = " rc=\0"
    var s_m: [u8; 7] = " mode=\0"
    var s_d: [u8; 6] = " dev=\0"
    var s_b: [u8; 6] = " bad=\0"
    vmsvga.vmm_fake(state, (w << 16) | h)
    let p1: u64 = vmsvga.host_pending(state)
    let p2: u64 = vmsvga.host_pending(state)
    var r: u64 = 99
    if p2 != 0 {
        r = vmode.follow_host(state, p2 / 65536, p2 % 65536)
    }
    vmsvga.vmm_fake(state, 0)
    // a picture in the new mode (the verify copy then proves nothing changed outside the rectangles told to the host)
    vmsvga_pic(state)
    serial.puts((&s_a[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_p1[0]) as u64)
    serial.dec(p1)
    serial.puts((&s_pe[0]) as u64)
    serial.dec(p2 / 65536)
    serial.puts((&s_x[0]) as u64)
    serial.dec(p2 % 65536)
    serial.puts((&s_rc[0]) as u64)
    serial.dec(r)
    serial.puts((&s_m[0]) as u64)
    serial.dec(fb.panel_w(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(fb.panel_h(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(vmsvga.width(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(vmsvga.height(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(vmsvga.verify_bad(state))
    serial.nl()
}

fn vmsvga_hint_stage(state: u64) {
    vmsvga_hint_one(state, 1137, 683)
    vmsvga_hint_one(state, 1280, 721)
    vmsvga_hint_one(state, 4096, 2304)
    vmsvga_hint_one(state, 1920, 1080)
    vmsvga_hint_one(state, 1024, 768)
}

fn vmsvga_pic(state: u64) {
    let w: u64 = fb.panel_w(state)
    let h: u64 = fb.panel_h(state)
    fb.set_cursor(state, false)
    fb.clear(state, 0)
    fb.fill(state, 0, 0, 100, 100, fb.rgb(state, 0xFF, 0, 0))
    fb.fill(state, 100, 0, 100, 100, fb.rgb(state, 0, 0xFF, 0))
    fb.fill(state, 200, 0, 100, 100, fb.rgb(state, 0, 0, 0xFF))
    fb.fill(state, 300, 0, 100, 100, fb.rgb(state, 0xFF, 0xFF, 0xFF))
    fb.line(state, 0, 110, 399, 210, fb.rgb(state, 0xFF, 0xFF, 0))
    fb.fill(state, w - 50, h - 50, 50, 50, fb.rgb(state, 0xFF, 0, 0xFF))
    fb.dirty_all(state)
    fb.flush(state)
    gfx.bild_fertig(state)
}

fn vmsvga_pause(state: u64, secs: u64) {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return
    }
    let until: u64 = apic.tsc() + hz * secs
    while apic.tsc() < until {
        let _e: bool = gfx.gpu_event(state)
        gfx.bild_fertig(state) // a frame boundary without drawing (the wm does the same every tick)
    }
}

fn vmsvga_run(state: u64) {
    var s_p1: [u8; 18] = "vmsvga: move hw=\0\0"
    var s_p2: [u8; 20] = "vmsvga: frames hw=\0\0"
    var s_mv: [u8; 9] = " moves=\0\0"
    var s_df: [u8; 7] = " defs=\0"
    var s_ok: [u8; 7] = " okt=\0\0"
    var s_pf: [u8; 11] = " perframe=\0"
    var s_rd: [u8; 14] = "vmsvga: ready\0"
    var s_pn: [u8; 15] = "vmsvga: panel=\0"
    var s_x: [u8; 2] = "x\0"
    var s_en: [u8; 12] = "vmsvga: end\0"
    var s_no: [u8; 17] = "vmsvga: novmsvga\0"
    var s_id: [u8; 18] = "vmsvga: idle okt=\0"
    var s_mx: [u8; 11] = " maxframe=\0"
    var s_ip: [u8; 6] = " pio=\0"
    var s_ma: [u8; 8] = " maxat=\0"
    var hw: bool = false
    let on: bool = vmsvga.is_ready(state)
    let y0: u64 = 300
    let x0: u64 = 300
    if on {
        hw = vmsvga.cursor_ready(state)
        if hw {
            let _z: bool = vmsvga.cursor_show(state, 0, 32, x0, y0, 0, 0, 0)
        }
        let o1: u64 = vmsvga.update_octets(state)
        let m1: u64 = vmsvga.cursor_moves(state)
        var i: u64 = 0
        while i < 60 {
            if hw {
                let _m: bool = vmsvga.cursor_bewegen(state, x0 + i * 3, y0)
            }
            i = i + 1
        }
        serial.puts((&s_p1[0]) as u64)
        if hw {
            serial.dec(1)
        } else {
            serial.dec(0)
        }
        serial.puts((&s_mv[0]) as u64)
        serial.dec(vmsvga.cursor_moves(state) - m1)
        serial.puts((&s_df[0]) as u64)
        serial.dec(vmsvga.cursor_defs(state))
        serial.puts((&s_ok[0]) as u64)
        serial.dec(vmsvga.update_octets(state) - o1)
        serial.nl()
        // warm-up: the first frame after the test picture carries everything that was dirty before
        // (flush_rect validates the diff shadow with one full copy; `flush` alone does not)
        fb.flush_rect(state, 0, 0, 8, 8)
        gfx.bild_fertig(state)
        let o2: u64 = vmsvga.update_octets(state)
        i = 0
        var mx: u64 = 0
        var mxat: u64 = 0
        while i < 60 {
            let ob: u64 = vmsvga.update_octets(state)
            if kstate.mode_on(state, kstate.M_WMRUHE) {
                fb.dirty_all(state)
                fb.flush(state)
            } else {
                fb.flush_rect(state, x0 + i * 3 - 8, y0 - 8, 48, 48)
            }
            gfx.bild_fertig(state)
            let dd: u64 = vmsvga.update_octets(state) - ob
            if dd > mx {
                mx = dd
                mxat = i
            }
            i = i + 1
        }
        let d2: u64 = vmsvga.update_octets(state) - o2
        serial.puts((&s_p2[0]) as u64)
        if hw {
            serial.dec(1)
        } else {
            serial.dec(0)
        }
        serial.puts((&s_ok[0]) as u64)
        serial.dec(d2)
        serial.puts((&s_pf[0]) as u64)
        serial.dec(d2 / 60)
        serial.puts((&s_mx[0]) as u64)
        serial.dec(mx)
        serial.puts((&s_ma[0]) as u64)
        serial.dec(mxat)
        serial.nl()
        // let the trailing keep-alive UPDATE (2 s after the last painted frame) go out first
        vmsvga_pause(state, 3)
        // idle: three seconds without drawing must not send picture data and must not touch a port at all
        let o3: u64 = vmsvga.update_octets(state)
        let p3: u64 = vmsvga.pio_count(state)
        vmsvga_pause(state, 3)
        serial.puts((&s_id[0]) as u64)
        serial.dec(vmsvga.update_octets(state) - o3)
        serial.puts((&s_ip[0]) as u64)
        serial.dec(vmsvga.pio_count(state) - p3)
        serial.nl()
        vmsvga.say(state)
    } else {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
    }
    serial.puts((&s_rd[0]) as u64)
    serial.nl()
    // phase 3: mode switches, same sequence with and without the driver
    var k: u64 = 0
    while k < 5 {
        var nw: u64 = fb.panel_w(state)
        var nh: u64 = fb.panel_h(state)
        if k == 1 {
            nw = 1024
            nh = 768
        }
        if k == 2 {
            nw = 1280
            nh = 720
        }
        if k == 3 {
            nw = 640
            nh = 480
        }
        if k == 4 {
            nw = 800
            nh = 600
        }
        if k != 0 {
            let _f: u64 = vmode.follow_host(state, nw, nh)
        }
        // every line of text goes out BEFORE the picture: the serial echo paints into the frame buffer, and the picture
        // (which clears the screen first) must be the same with and without the driver
        if on {
            vmsvga.say(state)
        }
        serial.puts((&s_pn[0]) as u64)
        serial.dec(fb.panel_w(state))
        serial.puts((&s_x[0]) as u64)
        serial.dec(fb.panel_h(state))
        serial.nl()
        vmsvga_pic(state)
        if k == 4 {
            vmsvga_pause(state, 13) // longer than the 10 s safety net
            if on {
                vmsvga.say(state)
            }
        } else {
            vmsvga_pause(state, 4)
        }
        k = k + 1
    }
    if on {
        vmsvga_hint_stage(state)
    }
    serial.puts((&s_en[0]) as u64)
    serial.nl()
}

fn pattern(state: u64, eine: u64, two: u64) {
    fb.set_cursor(state, false)
    fb.clear(state, 0)
    fb.fill(state, 0, 0, 100, 100, fb.rgb(state, 0xFF, 0, 0))
    fb.fill(state, 100, 0, 100, 100, fb.rgb(state, 0, 0xFF, 0))
    fb.fill(state, 200, 0, 100, 100, fb.rgb(state, 0, 0, 0xFF))
    fb.fill(state, 300, 0, 100, 100, fb.rgb(state, 0xFF, 0xFF, 0xFF))
    fb.line(state, 0, 110, 399, 210, fb.rgb(state, 0xFF, 0xFF, 0))
    vgpu.ext_testimage(state)
    fb.goto(state, 0, 14)
    serial.puts(eine)
    serial.nl()
    serial.puts(two)
    serial.nl()
    fb.dirty_all(state)
    fb.flush(state)
}

fn power_screen(state: u64) {
    var n_a: [u8; 6] = "px_a\0\0"
    var n_b: [u8; 6] = "px_b\0\0"
    var n_c: [u8; 6] = "px_c\0\0"
    var n_d: [u8; 6] = "px_d\0\0"
    var n_e: [u8; 6] = "px_e\0\0"
    var n_no: [u8; 9] = "px_none\0\0"
    if !kstate.mode_on(state, kstate.M_PWR) {
        return
    }
    if !fb.ready(state) {
        kutil.pnum((&n_no[0]) as u64, 1)
        return
    }
    let echo_vorher: bool = fb.echo_on(state)
    fb.set_echo(state, false)
    fb.fill(state, 100, 100, 64, 64, PX_COLOR)
    fb.flush(state)
    kutil.phex((&n_a[0]) as u64, fb.get_pixel(state, PX_X, PX_Y) & 0xFFFFFF)

    if kstate.mode_on(state, kstate.M_PWRDIM) {
        pwr.set_bright(state, 50)
        kutil.phex((&n_b[0]) as u64, fb.get_pixel(state, PX_X, PX_Y) & 0xFFFFFF)
        pwr.set_bright(state, 100)
        kutil.phex((&n_c[0]) as u64, fb.get_pixel(state, PX_X, PX_Y) & 0xFFFFFF)
        pwr.set_bright(state, 50)
    }
    if kstate.mode_on(state, kstate.M_PWRBLANK) {
        pwr.blank(state)
        kutil.phex((&n_d[0]) as u64, fb.get_pixel(state, PX_X, PX_Y) & 0xFFFFFF)
        kutil.pnum((&n_e[0]) as u64, pwr.value(state, pwr.PW_BLANKS))
    }
    fb.flush(state)
    var s_shot: [u8; 12] = "pwr: shot\0\0\0"
    serial.puts((&s_shot[0]) as u64)
    serial.nl()
    let hz: u64 = apic.tsc_hz(state)
    if hz != 0 {
        let bis: u64 = apic.tsc() + hz * 5
        while apic.tsc() < bis {
        }
    }
    var s_go: [u8; 12] = "pwr: shotgo\0"
    serial.puts((&s_go[0]) as u64)
    serial.nl()
    fb.set_echo(state, echo_vorher)
}

fn gui_root_from_part(state: u64) -> bool {
    var s_try: [u8; 18] = "wm: rootpart scan\0"
    var s_at: [u8; 14] = "wm: rootpart=\0"
    var s_fi: [u8; 9] = "  first=\0"
    var s_bl: [u8; 10] = "  blocks=\0"
    var s_none: [u8; 22] = "wm: keine OFS-Part.\0\0\0"
    serial.puts((&s_try[0]) as u64)
    serial.nl()
    let n: u64 = part.scan(state, blk.DEV_ATA)
    if n == 0 {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return false
    }
    let i: u64 = part.find_kind(state, blk.DEV_ATA, part.T_OFS)
    if i >= part.MAX_PARTS {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return false
    }
    let first: u64 = part.start(state, i)
    let cnt: u64 = part.blocks(state, i)
    blk.use_at(state, blk.DEV_ATA, first, cnt)
    if !fs.mount(state) {
        blk.use_ata(state, kutil.root_blocks(state))
        return false
    }
    kstate.set(state, kstate.ROOT_PART, i)
    serial.puts((&s_at[0]) as u64)
    serial.dec(i)
    serial.puts((&s_fi[0]) as u64)
    serial.dec(first)
    serial.puts((&s_bl[0]) as u64)
    serial.dec(cnt)
    serial.nl()
    return true
}

fn surface(state: u64) {
    var s_off: [u8; 12] = "wm: skipped\0"
    var s_nofb: [u8; 22] = "wm: kein Bildschirm\0\0\0"
    var s_noar: [u8; 24] = "wm: kein Arbeitsbereich\0"
    var s_fs: [u8; 12] = "wm: mount=\0\0"
    var s_font: [u8; 6] = "ttf: \0"
    var s_g: [u8; 10] = "  glyphs=\0"
    var s_upm: [u8; 7] = "  upm=\0"
    var s_asc: [u8; 7] = "  asc=\0"
    var s_desc: [u8; 8] = "  desc=\0"
    var s_lh: [u8; 6] = "  lh=\0"
    var s_kp: [u8; 8] = "  kern=\0"
    var s_st: [u8; 12] = "  selftest \0"
    var s_of: [u8; 4] = " / \0"
    var s_nofont: [u8; 28] = "ttf: keine Schrift gefunden\0"
    var s_mono: [u8; 5] = "mono\0"
    var s_sans: [u8; 5] = "sans\0"
    var s_icons: [u8; 6] = "icons\0"
    var s_bold: [u8; 5] = "bold\0"
    var s_noicons: [u8; 18] = "wm: no icon font\0\0"
    let PX_ICON: u64 = 16
    var s_ms: [u8; 8] = "mouse: \0"
    var s_id: [u8; 5] = "id=\0\0"
    var s_pk: [u8; 11] = "  packets=\0"
    var s_none: [u8; 19] = "mouse: kein Zeiger\0"
    var s_wm: [u8; 5] = "wm: \0"
    var s_x: [u8; 2] = "x\0"
    var s_win: [u8; 11] = "  windows=\0"
    var s_cur: [u8; 10] = "  cursor=\0"
    var s_dirty: [u8; 9] = "  dirty=\0"
    var s_focus: [u8; 9] = "  focus=\0"
    var s_arena: [u8; 10] = "  arena=\0\0"
    var s_term: [u8; 15] = "wm: term win=\0\0"
    var s_cols: [u8; 8] = "  cols=\0"
    var s_rows: [u8; 8] = "  rows=\0"
    var s_cell: [u8; 8] = "  cell=\0"
    var s_hold: [u8; 10] = "wm: hold\0\0"
    var s_go: [u8; 8] = "wm: go\0\0"
    var s_exit: [u8; 16] = "wm: sh exit=\0\0\0\0"
    var s_stat: [u8; 6] = "wm: \0\0"
    var s_comp: [u8; 13] = "composites=\0\0"
    var s_blit: [u8; 9] = "  blits=\0"
    var s_pix: [u8; 10] = "  pixels=\0"
    var s_cache: [u8; 12] = "  cached=\0\0\0"
    var s_hit: [u8; 8] = "  hits=\0"
    var s_miss: [u8; 9] = "  miss=\0\0"
    var s_bz: [u8; 12] = "bildzeit: \0\0"
    var s_bzn: [u8; 4] = "n=\0\0"
    var s_bzm: [u8; 12] = "  mittel=\0\0\0"
    var s_bzx: [u8; 9] = "  max=\0\0\0"
    var s_bzu: [u8; 12] = "  ueber16=\0\0"
    var s_bzus: [u8; 4] = " us\0"
    var s_bzh: [u8; 12] = "bildfach: \0\0"
    var s_bzsp: [u8; 2] = " \0"
    var s_bzb: [u8; 16] = "  betrieb max=\0\0"
    var s_bzbu: [u8; 12] = "  ueber16=\0\0"

    if !kstate.mode_on(state, kstate.M_WM) {
        var s_mw: [u8; 14] = "  modus w0..3\0"
        serial.puts((&s_off[0]) as u64)
        serial.puts((&s_mw[0]) as u64)
        var w: u64 = 0
        while w < 4 {
            serial.put(32 as u8)
            serial.hex(kstate.mode_word(state, w))
            w = w + 1
        }
        serial.nl()
        return
    }
    if !fb.ready(state) {
        serial.puts((&s_nofb[0]) as u64)
        serial.nl()
        return
    }
    // 1. der Arbeitsbereich
    let arena: u64 = mem.frame_run(state, WM_ARENA_FRAMES)
    if arena == 0 || !ttf.init(state, arena, WM_ARENA_FRAMES * mem.FRAME_SIZE) {
        serial.puts((&s_noar[0]) as u64)
        serial.nl()
        return
    }
    // ROUND FUI-KERNTEXT: the work area of fUi's rasteriser, BEFORE the
    // fonts are loaded (each load hands its file to fUi as well). No run
    // of frames -> fUi ink stays off and ttf.fi keeps its 4x4 samples;
    // the line says which one this boot draws with.
    var s_fuiink: [u8; 16] = "ttf: ink=fui on\0"
    var s_oldink: [u8; 16] = "ttf: ink=kernel\0"
    let fuiarea: u64 = mem.frame_run(state, ttf.FUI_FRAMES)
    if ttf.fui_attach(state, fuiarea) {
        serial.puts((&s_fuiink[0]) as u64)
    } else {
        serial.puts((&s_oldink[0]) as u64)
    }
    serial.nl()
    // 2. das Dateisystem, falls noetig
    if kstate.get(state, kstate.FS_READY) == 0 {
        var quelle: bool = false
        if bootmod.ready(state) {
            blk.ram_init(state, bootmod.base(state), bootmod.blocks(state))
            quelle = true
        } else {
            if blk.present(state) {
                blk.use_ata(state, kutil.root_blocks(state))
                quelle = true
            }
        }
        if quelle {
            var m: bool = fs.mount(state)
            //     wm: mount=0
            if !m && !bootmod.ready(state) {
                m = gui_root_from_part(state)
            }
            serial.puts((&s_fs[0]) as u64)
            serial.dec(kutil.yes(m))
            serial.nl()
        }
    }
    // 3. die Schriften
    var p_mono: [u8; 15] = "/lib/mono.ttf\0\0"
    var p_sans: [u8; 15] = "/lib/sans.ttf\0\0"
    // ROUND ICONS: the third font.  It carries no letters but the
    // symbols of the interface, and it is NOT required -- if it is
    // missing everything keeps running and the icons are absent.
    var p_icon: [u8; 16] = "/lib/icons.ttf\0\0"
    var p_bold: [u8; 15] = "/lib/bold.ttf\0\0"
    let f_mono: u64 = load_font(state, (&p_mono[0]) as u64)
    let f_sans: u64 = load_font(state, (&p_sans[0]) as u64)
    let f_icon: u64 = load_font(state, (&p_icon[0]) as u64)
    let f_bold: u64 = load_font(state, (&p_bold[0]) as u64)
    if f_mono >= ttf.MAX_FONTS && f_sans >= ttf.MAX_FONTS {
        serial.puts((&s_nofont[0]) as u64)
        serial.nl()
        return
    }
    var f_ui: u64 = f_sans
    if f_ui >= ttf.MAX_FONTS {
        f_ui = f_mono
    }
    var f_tx: u64 = f_mono
    if f_tx >= ttf.MAX_FONTS {
        f_tx = f_sans
    }
    host_boot_fit(state)
    let UISC: u64 = fb.uiscale(state)
    let PX_UI: u64 = 15 * UISC
    let PX_MONO: u64 = 16 * UISC
    say_font(state, f_tx, PX_MONO, (&s_mono[0]) as u64, (&s_font[0]) as u64,
        (&s_g[0]) as u64, (&s_upm[0]) as u64, (&s_asc[0]) as u64,
        (&s_desc[0]) as u64, (&s_lh[0]) as u64, (&s_kp[0]) as u64,
        (&s_st[0]) as u64, (&s_of[0]) as u64)
    if f_sans < ttf.MAX_FONTS && f_sans != f_tx {
        say_font(state, f_sans, PX_UI, (&s_sans[0]) as u64,
            (&s_font[0]) as u64, (&s_g[0]) as u64, (&s_upm[0]) as u64,
            (&s_asc[0]) as u64, (&s_desc[0]) as u64, (&s_lh[0]) as u64,
            (&s_kp[0]) as u64, (&s_st[0]) as u64, (&s_of[0]) as u64)
    }
    if f_bold < ttf.MAX_FONTS {
        say_font(state, f_bold, PX_UI, (&s_bold[0]) as u64,
            (&s_font[0]) as u64, (&s_g[0]) as u64, (&s_upm[0]) as u64,
            (&s_asc[0]) as u64, (&s_desc[0]) as u64, (&s_lh[0]) as u64,
            (&s_kp[0]) as u64, (&s_st[0]) as u64, (&s_of[0]) as u64)
    }
    // boot words deskrot90/180/270: the desktop starts with the output turned (gate tools/rotinput)
    if vmode.want(state, vmode.M_DESKROT1) {
        let _r1: bool = fb.set_rotation(state, 90)
    } else if vmode.want(state, vmode.M_DESKROT2) {
        let _r2: bool = fb.set_rotation(state, 180)
    } else if vmode.want(state, vmode.M_DESKROT3) {
        let _r3: bool = fb.set_rotation(state, 270)
    }
    // 4. das Zeigegeraet
    let w: u64 = fb.width(state)
    let h: u64 = fb.height(state)
    if kstate.mode_on(state, kstate.M_NOMOUSE) {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
    } else {
        ps2m.init(state, w, h)
        serial.puts((&s_ms[0]) as u64)
        serial.puts((&s_id[0]) as u64)
        serial.dec(ps2m.id(state))
        serial.puts((&s_pk[0]) as u64)
        serial.dec(ps2m.packets(state))
        serial.puts((&s_st[0]) as u64)
        serial.dec(ps2m.selftest(state))
        serial.puts((&s_of[0]) as u64)
        serial.dec(ps2m.selftest_max())
        serial.nl()
        ptrcfg.selftest(state)
        ps2m.e2e_selftest(state)
        ps2m.reset_counters(state)
        ps2m.set_poll(state,
            !kstate.mode_on(state, kstate.M_NOMPOLL))
    }
    // 5. der Fensterserver
    let nodirty: bool = kstate.mode_on(state, kstate.M_NODIRTY)
    let nofocus: bool = kstate.mode_on(state, kstate.M_NOFOCUS)
    if !wm.init(state, w, h, nodirty, nofocus) {
        return
    }
    wm.set_nolayer(state, kstate.mode_on(state, kstate.M_NOLAYER))
    wm.set_nomin(state, kstate.mode_on(state, kstate.M_NOMIN))
    wm.set_nostrut(state, kstate.mode_on(state, kstate.M_NOSTRUT))
    // r826: extended desktop -> hand the head rects to the window server (work area per head, pointer per head)
    if vgpu.ext_active(state) {
        wm.heads_sync(state)
    }
    wm.set_vsync(state, kstate.mode_on(state, kstate.M_VSYNC)
        && !kstate.mode_on(state, kstate.M_NOPRESENT))
    wm.set_noanim(state, kstate.mode_on(state, kstate.M_NOANIM))
    wm.set_sig(state, kstate.mode_on(state, kstate.M_WMSIG))
    wm.set_leser(state, kstate.mode_on(state, kstate.M_WMSIG))
    var geflippt: bool = false
    if kstate.mode_on(state, kstate.M_FLIP)
        && !kstate.mode_on(state, kstate.M_NOFLIP) {
        geflippt = fb.flip_setup(state)
    }
    var s_fl: [u8; 12] = "fb: flip=\0\0\0"
    serial.puts((&s_fl[0]) as u64)
    serial.dec(bool_num(geflippt))
    serial.nl()
    wm.set_uiscale(state, UISC)
    wm.set_fonts(state, f_ui, PX_UI, f_tx, PX_MONO)
    // ROUND ICONS: the icon font is reported LATER, after `wig.init`.
    // It has to be: `wig.init` clears the first 0x80 octets of its page
    // and that is where the slot is kept.  The first version set it
    // here, three dozen lines earlier, and Ring 3 then found no icons
    // at all while the kernel had loaded the font and said so -- the
    // most misleading kind of failure there is, because both halves
    // were telling the truth.
    if f_icon < ttf.MAX_FONTS {
        say_font(state, f_icon, PX_ICON, (&s_icons[0]) as u64,
            (&s_font[0]) as u64, (&s_g[0]) as u64, (&s_upm[0]) as u64,
            (&s_asc[0]) as u64, (&s_desc[0]) as u64, (&s_lh[0]) as u64,
            (&s_kp[0]) as u64, (&s_st[0]) as u64, (&s_of[0]) as u64)
    } else {
        serial.puts((&s_noicons[0]) as u64)
        serial.nl()
    }
    if kstate.mode_on(state, kstate.M_NOMOUSE) {
        wm.set_cursor(state, false)
    }
    serial.puts((&s_wm[0]) as u64)
    serial.dec(w)
    serial.puts((&s_x[0]) as u64)
    serial.dec(h)
    serial.puts((&s_cur[0]) as u64)
    serial.dec(bnum(wm.cursor_on(state)))
    serial.puts((&s_dirty[0]) as u64)
    serial.dec(1 - bnum(nodirty))
    serial.puts((&s_focus[0]) as u64)
    serial.dec(1 - bnum(nofocus))
    serial.puts((&s_arena[0]) as u64)
    serial.dec(WM_ARENA_FRAMES * mem.FRAME_SIZE)
    serial.nl()
    serial.puts((&s_wm[0]) as u64)
    serial.puts((&s_st[0]) as u64 + 2)
    serial.dec(vtest.selftest(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(vtest.selftest_max())
    var s_wmf: [u8; 11] = "  failed=\0\0"
    serial.puts((&s_wmf[0]) as u64)
    serial.hex(vtest.failbits(state))
    var s_d1: [u8; 8] = "  mw=\0\0\0"
    var s_d2: [u8; 8] = "  max=\0\0"
    serial.puts((&s_d1[0]) as u64)
    serial.dec(vtest.diag1(state))
    serial.puts((&s_d2[0]) as u64)
    serial.dec(vtest.diag2(state))
    serial.nl()
    // r400: the VT subset of the terminal (a window of its own, made and destroyed here)
    var s_vt: [u8; 14] = "wm: vttest \0\0\0"
    let vt_n: u64 = vtest.vt_selftest(state)
    serial.puts((&s_vt[0]) as u64)
    serial.dec(vt_n)
    serial.puts((&s_of[0]) as u64)
    serial.dec(vtest.vt_selftest_max())
    serial.nl()
    // r462: the rest of the VT subset (cursor, erase, edit, scroll region, colours, alternate screen, strings)
    var s_vt2: [u8; 15] = "wm: vttest2 \0\0\0"
    let vt2_n: u64 = vtest.vt2_selftest(state)
    serial.puts((&s_vt2[0]) as u64)
    serial.dec(vt2_n)
    serial.puts((&s_of[0]) as u64)
    serial.dec(vtest.vt2_selftest_max())
    serial.nl()
    wig.init(state)
    wig.set_icon_font(state, f_icon)
    wig.set_bold_font(state, f_bold)
    var s_wig: [u8; 6] = "wig: \0"
    var s_wsel: [u8; 11] = "selftest \0\0"
    serial.puts((&s_wig[0]) as u64)
    serial.puts((&s_wsel[0]) as u64)
    serial.dec(wig.selftest(state))
    serial.puts((&s_of[0]) as u64)
    serial.dec(wig.selftest_max())
    serial.nl()

    tile_stage(state, w, h)
    wmplug_stage(state)
    let willtile: bool = kstate.mode_on(state, kstate.M_TILE)
    let tileshot: bool =
        kstate.mode_on(state, kstate.M_TILESHOT)
    if willtile && !tileshot {
        wm.set_tile_on(state, true)
    }

    fb.set_echo(state, false)
    fb.set_cursor(state, false)
    fb.clear(state, 0)
    wm.damage_all(state)

    board_boot(state, 1)
    st(10)

    var t_title: [u8; 16] = "Terminal -- sh\0\0"
    let k: u64 = wm.uisc(state)
    let sw: u64 = fb.width(state)
    let sh: u64 = fb.height(state)
    var t_x: u64 = 24 * k
    var t_y: u64 = 40 * k
    var t_w: u64 = 560 * k
    var t_h: u64 = 380 * k
    if t_w + 2 * t_x > sw {
        t_x = 24
        if t_w + 2 * t_x > sw {
            t_w = sw - 2 * t_x
        }
    }
    if t_h + 2 * t_y > sh {
        t_y = 40
        if t_h + 2 * t_y > sh {
            t_h = sh - 2 * t_y
        }
    }
    let tw: u64 = wm.create(state, 0, t_x as i64, t_y as i64, t_w, t_h,
        wm.K_TERM, (&t_title[0]) as u64)
    if tw < wm.MAX_WIN {
        var t_app: [u8; 9] = "terminal\0"
        let _ta: bool = wm.set_app(state, tw, (&t_app[0]) as u64)
        wm.bind_tty(state, tw, tty.console())
        tty.set_window(state, tty.console(), tw)
        // W-A: boot word `nobootterm`: no terminal window on the fresh desktop (the shell keeps running behind it).
        if kstate.mode_on(state, kstate.M_NOBOOTTERM) {
            wm.set_hidden(state, tw, true)
            var s_bth: [u8; 25] = "wm: bootterm hidden win=\0"
            serial.puts((&s_bth[0]) as u64)
            serial.dec(tw)
            serial.nl()
        }
        tty.set_sink(state, tty.console(), tty.SINK_WINDOW)
        serial.puts((&s_term[0]) as u64)
        serial.dec(tw)
        serial.puts((&s_cols[0]) as u64)
        serial.dec(wm.term_cols(state, tw))
        serial.puts((&s_rows[0]) as u64)
        serial.dec(wm.term_rows(state, tw))
        serial.puts((&s_cell[0]) as u64)
        serial.dec(560 / wm.term_cols(state, tw))
        serial.puts((&s_x[0]) as u64)
        serial.dec(380 / wm.term_rows(state, tw))
        serial.nl()
        var s_tg: [u8; 20] = "wm: termgitter win=\0"
        var s_tgx: [u8; 4] = " x=\0"
        var s_tgy: [u8; 4] = " y=\0"
        var s_tgw: [u8; 8] = " cellw=\0"
        var s_tgh: [u8; 8] = " cellh=\0"
        var s_tga: [u8; 6] = " asc=\0"
        var s_tgp: [u8; 5] = " px=\0"
        serial.puts((&s_tg[0]) as u64)
        serial.dec(tw)
        serial.puts((&s_tgx[0]) as u64)
        serial.dec((wm.win_x(state, tw) as u64) + wm.inx(state, tw))
        serial.puts((&s_tgy[0]) as u64)
        serial.dec((wm.win_y(state, tw) as u64) + wm.iny(state, tw))
        serial.puts((&s_tgw[0]) as u64)
        serial.dec(wm.term_cellw(state, tw))
        serial.puts((&s_tgh[0]) as u64)
        serial.dec(wm.term_cellh(state, tw))
        serial.puts((&s_tga[0]) as u64)
        serial.dec(wm.term_asc(state))
        serial.puts((&s_tgp[0]) as u64)
        serial.dec(wm.term_px(state))
        serial.nl()
        var b1: [u8; 64] = [0 as u8; 64]
        var b1r: [u8; 14] = " K10 WM 0123\n\0"
        var n1: u64 = brand.append((&b1[0]) as u64, 0, brand.product(), 63)
        n1 = brand.append((&b1[0]) as u64, n1, (&b1r[0]) as u64, 63)
        var b2: [u8; 32] = "abcdefghijklm ABCDEFGHIJK +-*/\n\0"
        if !kstate.mode_on(state, kstate.M_DESK) {
            wm.term_write(state, tw, (&b1[0]) as u64, n1)
            wm.term_write(state, tw, (&b2[0]) as u64, 31)
        }
    }

    st(18)
    usb_bericht(state, tw)
    st(19)

    board_boot(state, 2)
    st(20)

    // r826 test bed: windows and struts on two heads (tools/wmheads); `hdhot` adds unplug/replug of head 1
    if kstate.mode_on(state, kstate.M_HDTEST) {
        wm.hd_demo(state, kstate.mode_on(state, kstate.M_HDHOT))
    }
    // r804 test bed: horizontal wheel to a window + window-switch swipes (tools/hid/wheel.sh)
    if kstate.mode_on(state, kstate.M_HWTEST) {
        wm.hw_demo(state)
    }

    var t: u64 = 0
    if !kstate.mode_on(state, kstate.M_WIG)
       && !kstate.mode_on(state, kstate.M_WIGFILES)
       && !kstate.mode_on(state, kstate.M_WIGSTART)
       && !kstate.mode_on(state, kstate.M_DESK)
       && !kstate.mode_on(state, kstate.M_TILESHOT) {
        t = proc.create(state, P_WCLICK, (w << 16) | h, 2)
        sched.sleep_ticks(state, 12)
        wm.compose(state)
    } else if kstate.mode_on(state, kstate.M_DESK) {
        st(21)
        i18n_bench(state, f_ui, PX_UI)
        st(22)
        t = desk_start(state)
        st(23)
        speicherdruck_gui(state)
    } else {
        t = k15_start(state)
    }

    st(24)
    if kstate.mode_on(state, kstate.M_WMSHELL) {
        let sh: u64 = shell_start(state)
        st(25)
        var s_nosh: [u8; 24] = "wm: KEINE SHELL, weiter\0"
        if sh == 0 {
            serial.puts((&s_nosh[0]) as u64)
            serial.nl()
        }
        st(26)
        let code: u64 = wait_wm(state, sh, tw)
        st(40)
        if sh != 0 {
            serial.puts((&s_exit[0]) as u64)
            serial.dec(code)
            serial.nl()
        }
    }

    if kstate.mode_on(state, kstate.M_TTFDUMP) {
        var char: [u8; 9] = "AVROegW.\0"
        var zi: u64 = 0
        while zi < 8 {
            say_glyph(state, f_tx, PX_MONO, char[zi as usize] as u64)
            zi = zi + 1
        }
    }
    if willtile && tileshot {
        wm.set_tile_on(state, true)
        tile_shot(state, w, h)
    }
    wm_bench(state, f_tx, PX_MONO)
    wm.damage_all(state)
    wm.compose(state)
    let _gz2: u64 = wm.present(state)

    serial.puts((&s_stat[0]) as u64)
    serial.puts((&s_comp[0]) as u64)
    serial.dec(wm.composites(state))
    serial.puts((&s_blit[0]) as u64)
    serial.dec(wm.blits(state))
    serial.puts((&s_pix[0]) as u64)
    serial.dec(wm.pixels(state))
    serial.puts((&s_cache[0]) as u64)
    serial.dec(ttf.cache_used(state))
    serial.puts((&s_hit[0]) as u64)
    serial.dec(ttf.hits(state))
    serial.puts((&s_miss[0]) as u64)
    serial.dec(ttf.misses(state))
    serial.nl()
    wm.glas_bericht(state)
    // RUNDE VEKTOR: DIE BILDZEIT.
    serial.puts((&s_bz[0]) as u64)
    serial.puts((&s_bzn[0]) as u64)
    serial.dec(wm.frame_us_n(state))
    serial.puts((&s_bzm[0]) as u64)
    if wm.frame_us_n(state) > 0 {
        serial.dec(wm.frame_us_sum(state) / wm.frame_us_n(state))
    } else {
        serial.dec(0)
    }
    serial.puts((&s_bzus[0]) as u64)
    serial.puts((&s_bzx[0]) as u64)
    serial.dec(wm.frame_us_max(state))
    serial.puts((&s_bzus[0]) as u64)
    serial.puts((&s_bzu[0]) as u64)
    serial.dec(wm.frame_ueber16(state))
    serial.nl()
    serial.puts((&s_bzh[0]) as u64)
    var fi: u64 = 0
    while fi < 8 {
        serial.dec(wm.frame_fach(state, fi))
        serial.puts((&s_bzsp[0]) as u64)
        fi = fi + 1
    }
    serial.puts((&s_bzb[0]) as u64)
    serial.dec(wm.frame_us_maxw(state))
    serial.puts((&s_bzus[0]) as u64)
    serial.puts((&s_bzbu[0]) as u64)
    serial.dec(wm.frame_ueber16w(state))
    serial.nl()
    serial.puts((&s_wm[0]) as u64)
    serial.puts((&s_win[0]) as u64 + 2)
    serial.dec(wm.count(state))
    serial.puts((&s_focus[0]) as u64)
    serial.dec(wm.focus(state))
    serial.nl()

    if !kstate.mode_on(state, kstate.M_WMHOLD) {
        return
    }
    serial.puts((&s_hold[0]) as u64)
    serial.nl()
    let hz: u64 = apic.tsc_hz(state)
    var secs: u64 = 5
    if kstate.mode_on(state, kstate.M_WIGLONG) {
        secs = 20
    }
    let halt: u64 = pmon.wighalt(state)
    if halt != 0 {
        secs = halt
    }
    var s_halt: [u8; 15] = "wm: halt sek=\0\0"
    serial.puts((&s_halt[0]) as u64)
    serial.dec(secs)
    serial.nl()
    // ADDENDUM TASKBAR: MAXIMIZE ONE SECOND IN, and not before the
    // loop. The taskbar is a program in ring 3; it needs the first
    // moments of the hold to read its configuration file, place itself
    // and declare its strut. A window maximized before that would be
    // measured against a work area that is still the whole screen, and
    // the measurement would pass for the wrong reason.
    var maxed: bool = false
    if hz != 0 {
        let ab: u64 = apic.tsc()
        let bis: u64 = ab + hz * secs
        while apic.tsc() < bis {
            if !maxed && kstate.mode_on(state, kstate.M_WMAX) {
                if apic.tsc() > ab + hz {
                    maxed = true
                    say_max(state)
                }
            }
            wm.poll(state)
            usb.hotplug_work(state)
            if netdev.late_usb(state) {
                netsvc.stage(state)
            }
            wechsel_schritt(state)
            lock_watch(state)
            abmelde_wache(state)
            standby_wache(state)
            if kstate.mode_on(state, kstate.M_WMANIM) {
                anim_vorfuehrung(state)
            }
            // RUNDE ZIEH: den Zug vorfuehren. Eigener Schalter,
            // eigener Ablauf -- `wmanim` und `wmzieh` duerfen
            // zusammen laufen, sie fassen verschiedene Fenster an.
            if kstate.mode_on(state, kstate.M_WMZIEH) {
                zieh_marken(state)
                zieh_vorfuehrung(state)
            }
            if kstate.mode_on(state, kstate.M_WMBLUR) {
                zieh_marken(state)
                blur_vorfuehrung(state)
            }
            if kstate.mode_on(state, kstate.M_WMRUHE) {
                wm.damage_all(state)
            }
            if kstate.mode_on(state, kstate.M_VGPUEREIG) {
                if vgpu_ereig_getan == 0 {
                    vgpu_ereig_getan = 1
                    let _e: bool = vgpu.ereignis_erzwingen(state)
                }
            }
            // RUNDE VIRTIOGPU: DIE TICKENDE UHR.
            if kstate.mode_on(state, kstate.M_VGPUUHR) {
                let uw: u64 = 96
                let uh: u64 = 20
                let ux: u64 = fb.width(state) - uw - 8
                let uy: u64 = fb.height(state) - uh - 4
                let t: u64 = kstate.get(state, kstate.TICKS)
                let c: u64 = fb.rgb(state, (t * 7) & 0xFF,
                    (t * 13) & 0xFF, 0x80)
                fb.fill(state, ux, uy, uw, uh, c)
                wm.damage(state, ux as i64, uy as i64,
                    (ux + uw) as i64, (uy + uh) as i64)
            }
            mausflut_schritt(state)
            mauslauf_schritt(state)
            let _open: u64 = wm.anim_tick(state)
            let _sw: u64 = wm.swing_tick(state)
            wm.leser_tick(state)
            wm.compose(state)
            wm.leser_tick(state)
            let _gz: u64 = wm.present(state)
            gfx.bild_fertig(state)
            wm.leser_tick(state)
            sched.sleep_ticks(state, 1)
        }
    }
    wm.damage_all(state)
    wm.compose(state)
    wm_bench2(state)
    say_vsync(state)
    say_gpu(state)
    vgpu.say(state)
    serial.puts((&s_go[0]) as u64)
    serial.nl()
    say_wm_input(state)
    say_mauslauf(state)
    say_wig(state)
    say_wins(state)
    let _unused: u64 = t
}

fn zieh_marken(state: u64) {
    if zieh_marken_gesetzt != 0 {
        return
    }
    zieh_marken_gesetzt = 1
    let vl: u64 = kstate.get(state, kstate.ZIEH_LIFT)
    let vt: u64 = kstate.get(state, kstate.ZIEH_TILT)
    let vs: u64 = kstate.get(state, kstate.ZIEH_SWING)
    if vl != 9999 {
        let _fl: bool = wm.set_form(state, wm.FM_LIFT, vl)
    }
    if vt != 9999 {
        let _ft: bool = wm.set_form(state, wm.FM_TILT, vt)
    }
    if vs != 9999 {
        let _fs: bool = wm.set_form(state, wm.FM_SWING, vs)
    }
    let vb: u64 = kstate.get(state, kstate.BLUR_R)
    let vbt: u64 = kstate.get(state, kstate.BLUR_TINT)
    let vbn: u64 = kstate.get(state, kstate.BLUR_NOISE)
    // GEGENPROBE: der Zwischenspeicher, einmal je Lauf.
    if kstate.mode_on(state, kstate.M_BLURNOCACHE) {
        wm.set_blur_cache(state, false)
    }
    if vb != 9999 {
        let _fb: bool = wm.set_form(state, wm.FM_BLUR, vb)
    }
    if vbt != 9999 {
        let _fbt: bool = wm.set_form(state, wm.FM_BLURTINT, vbt)
    }
    if vbn != 9999 {
        let _fbn: bool = wm.set_form(state, wm.FM_BLURNOISE, vbn)
    }
}

static mut zieh_marken_gesetzt: u64 = 0
static mut zieh_t0: u64 = 0
static mut zieh_schritt: u64 = 0
static mut zieh_win: u64 = 0

static mut blur_t0: u64 = 0
static mut blur_schritt: u64 = 0

fn blur_vorfuehrung(state: u64) {
    let t: u64 = kstate.get(state, kstate.TICKS)
    let ab: u64 = blur_t0
    if ab == 0 {
        blur_t0 = t
        return
    }
    let seit: u64 = t - ab
    if seit >= 50 && blur_schritt == 0 {
        blur_schritt = 1
        var s_g: [u8; 7] = "Muster\0"
        let sw: u64 = wm.max_w(state)
        let sh: u64 = wm.max_h(state)
        let g: u64 = wm.create(state, 0, 0, 0, sw, sh, wm.K_RAW,
            (&s_g[0]) as u64)
        if g < wm.MAX_WIN {
            wm.set_deco(state, g, false)
            wm.set_layer(state, g, wm.L_DESK)
            var y: u64 = 0
            while y < sh {
                var x: u64 = 0
                while x < sw {
                    let fx: u64 = x / 64
                    let fy: u64 = y / 64
                    var c: u64 = 0x1E3A8A
                    if ((fx + fy) & 1) == 0 {
                        c = 0xF59E0B
                    }
                    if ((fx + fy) & 3) == 2 {
                        c = 0x10B981
                    }
                    var bw: u64 = 64
                    if x + bw > sw {
                        bw = sw - x
                    }
                    var bh: u64 = 64
                    if y + bh > sh {
                        bh = sh - y
                    }
                    wm.fill(state, g, x, y, bw, bh, c)
                    x = x + 64
                }
                y = y + 64
            }
            wm.flush_win(state, g)
        }
        var s_m: [u8; 11] = "Startmenü\0"
        let m: u64 = wm.create(state, 0, 80, 120, 320, 520, wm.K_RAW,
            (&s_m[0]) as u64)
        if m < wm.MAX_WIN {
            wm.set_deco(state, m, false)
            wm.set_layer(state, m, wm.L_MENUE)
            wm.fill(state, m, 0, 0, 320, 520, 0xF8FAFC)
            blur_frame(state, m, 320, 520)
            let _o1: bool = wm.set_opac(state, m, 150)
            wm.flush_win(state, m)
        }
        var s_l: [u8; 11] = "Leiste2   \0"
        let l: u64 = wm.create(state, 0, 0, (sh - 96) as i64, sw, 48,
            wm.K_RAW, (&s_l[0]) as u64)
        if l < wm.MAX_WIN {
            wm.set_deco(state, l, false)
            wm.set_layer(state, l, wm.L_TOP)
            wm.fill(state, l, 0, 0, sw, 48, 0xF8FAFC)
            blur_frame(state, l, sw, 48)
            let _o2: bool = wm.set_opac(state, l, 150)
            wm.flush_win(state, l)
        }
        var s_s: [u8; 18] = "blur: vorgefuehrt\0"
        serial.puts((&s_s[0]) as u64)
        serial.nl()
    }
}

fn blur_frame(state: u64, i: u64, w: u64, h: u64) {
    wm.fill(state, i, 0, 0, w, 4, 0xFFFFFF)
    wm.fill(state, i, 0, h - 4, w, 4, 0xFFFFFF)
    wm.fill(state, i, 0, 0, 4, h, 0xFFFFFF)
    wm.fill(state, i, w - 4, 0, 4, h, 0xFFFFFF)
}

fn zieh_vorfuehrung(state: u64) {
    let t: u64 = kstate.get(state, kstate.TICKS)
    let ab: u64 = zieh_t0
    if ab == 0 {
        zieh_t0 = t
        return
    }
    let seit: u64 = t - ab
    if seit >= 50 && zieh_schritt == 0 {
        zieh_schritt = 1
        var s_t: [u8; 7] = "Ziehen\0"
        let i: u64 = wm.create(state, 0, 120, 380, 360, 240, wm.K_RAW,
            (&s_t[0]) as u64)
        if i < wm.MAX_WIN {
            wm.fill(state, i, 0, 0, 360, 240, 0x2E6FD9)
            wm.fill(state, i, 16, 16, 150, 100, 0xF8FAFC)
            wm.fill(state, i, 200, 140, 140, 80, 0xFFC857)
            zieh_win = i + 1
            var s_g: [u8; 16] = "zieh: angefasst\0"
            serial.puts((&s_g[0]) as u64)
            serial.nl()
            wm.drag_begin_pub(state, i, 40, 20)
        }
    }
    if seit >= 60 && seit < 100 && zieh_win != 0 {
        let i: u64 = zieh_win - 1
        let n: i64 = (seit - 60) as i64
        wm.move_win(state, i, 120 + n * 9, 380 - n * 4)
    }
    // RUNDE ZIEH: DIE WAHRE LAGE, JEDEN TICK.
    if zieh_win != 0 && seit >= 55 && seit <= 190 {
        let i: u64 = zieh_win - 1
        var s_p: [u8; 12] = "zieh: t=\0\0\0\0"
        var s_x: [u8; 5] = "  x=\0"
        var s_y: [u8; 5] = "  y=\0"
        var s_s: [u8; 6] = "  sx=\0"
        var s_t2: [u8; 6] = "  sy=\0"
        serial.puts((&s_p[0]) as u64)
        serial.dec(seit)
        serial.puts((&s_x[0]) as u64)
        serial.dec(wm.win_x_pub(state, i) as u64)
        serial.puts((&s_y[0]) as u64)
        serial.dec(wm.win_y_pub(state, i) as u64)
        serial.puts((&s_s[0]) as u64)
        serial.dec(wm.swing_dx(state, i) as u64)
        serial.puts((&s_t2[0]) as u64)
        serial.dec(wm.swing_dy(state, i) as u64)
        serial.nl()
    }
    if seit >= 180 && zieh_schritt == 1 {
        zieh_schritt = 2
        if zieh_win != 0 {
            wm.drag_end_pub(state, zieh_win - 1)
        }
        var s_l: [u8; 18] = "zieh: losgelassen\0"
        serial.puts((&s_l[0]) as u64)
        serial.nl()
    }
}

fn anim_vorfuehrung(state: u64) {
    let t: u64 = kstate.get(state, kstate.TICKS)
    let ab: u64 = wm.before_t0(state)
    if ab == 0 {
        wm.set_before_t0(state, t)
        return
    }
    let seit: u64 = t - ab
    let schritt: u64 = wm.before_step(state)
    if seit >= 50 && schritt == 0 {
        wm.set_before_step(state, 1)
        var s_t: [u8; 9] = "Aufgehen\0"
        let i: u64 = wm.create(state, 0, 220, 180, 320, 200, wm.K_RAW,
            (&s_t[0]) as u64)
        if i < wm.MAX_WIN {
            wm.fill(state, i, 0, 0, 320, 200, 0x2E6FD9)
            wm.fill(state, i, 20, 20, 280, 160, 0xE8EEF7)
            wm.set_before_win(state, i + 1)
            let _a: bool = wm.open_anim(state, i)
        }
    }
    if seit >= 150 && schritt == 1 {
        wm.set_before_step(state, 2)
        let w: u64 = wm.before_win(state)
        if w != 0 {
            let _c: bool = wm.close_anim(state, w - 1)
        }
    }
}

fn leser_tick(state: u64) {
    wm.leser_tick(state)
}

// W-DND: a path dropped on a terminal window is typed into its tty (the window server cannot see the tty module).
// Called from the window server's poll (`gfx.wm_poll`); nothing waits -> one comparison.
static mut dnd_buf: [u8; 232] = [0 as u8; 232]

fn dnd_pump(state: u64) {
    let r: u64 = wm.dnd_take_paste(state, (&dnd_buf[0]) as u64, 230)
    if r == 0 {
        return
    }
    let t: u64 = r >> 32
    let n: u64 = r & 0xFFFFFFFF
    let _s: u64 = tty.push_text(state, t, (&dnd_buf[0]) as u64, n)
}

static mut tclip_a: [u8; 4104] = [0 as u8; 4104]
static mut tclip_wait_tty: u64 = 0
static mut tclip_wait_sel: u64 = 0
static mut tclip_wait_since: u64 = 0
const TCLIP_WAIT_NS: u64 = 3000000000

fn termclip_fetch(state: u64, sel: u64, pa: u64) -> u64 {
    var len: u64 = slots.get_kernel(state, sel, 0, 1, pa, 4096)
    if len == slots.KGET_AGAIN {
        return len
    }
    if len == 0 {
        len = slots.get_kernel(state, sel, 0, 2, pa, 4096)
    }
    if len == 0 {
        len = slots.get_kernel(state, sel, 0, 5, pa, 4096)
        if len == slots.KGET_AGAIN {
            return 0
        }
        if len != 0 {
            len = urilist.list_to_plain(pa, len, 4096)
            var q: u64 = 0
            while q < len {
                if kstate.get8(pa + q) == 10 {
                    kstate.set8(pa + q, 32)
                }
                q = q + 1
            }
        }
    }
    return len
}

fn termclip_paste(state: u64, t: u64, sel: u64, pa: u64) -> bool {
    var use: u64 = sel
    if use == slots.SEL_PRIMARY && slots.count(state, slots.SEL_PRIMARY) == 0 {
        use = slots.SEL_CLIP
    }
    let len: u64 = termclip_fetch(state, use, pa)
    if len == slots.KGET_AGAIN {
        return false
    }
    if len != 0 {
        let _s: u64 = tty.push_text(state, t, pa, len)
        wm.term_paste_done(state)
    }
    return true
}

fn termclip_pump(state: u64) {
    let pa: u64 = (&tclip_a[0]) as u64
    let n: u64 = wm.term_copy_take(state, pa, 4096)
    if n != 0 {
        let _b: u64 = slots.put_kernel(state, sched.current(state), slots.SEL_CLIP, bus.T_TEXT, pa, n)
    }
    let pn: u64 = wm.term_primary_take(state, pa, 4096)
    if pn != 0 {
        let _p: u64 = slots.put_kernel(state, sched.current(state), slots.SEL_PRIMARY, bus.T_TEXT, pa, pn)
    }
    let t1: u64 = wm.term_paste_take(state)
    if t1 != 0 {
        let psel: u64 = wm.term_paste_sel(state)
        if !termclip_paste(state, t1 - 1, psel, pa) {
            tclip_wait_tty = t1
            tclip_wait_sel = psel
            tclip_wait_since = time.mono_ns(state)
        }
        return
    }
    if tclip_wait_tty != 0 {
        if termclip_paste(state, tclip_wait_tty - 1, tclip_wait_sel, pa)
            || time.mono_ns(state) - tclip_wait_since > TCLIP_WAIT_NS {
            tclip_wait_tty = 0
        }
    }
}

fn say_gpu(state: u64) {
    var s_a: [u8; 10] = "gpu: okt=\0"
    var s_b: [u8; 9] = "  rect=\0\0"
    var s_c: [u8; 11] = "  bilder=\0\0"
    var s_d: [u8; 7] = "  je=\0\0"
    var s_e: [u8; 8] = "  weg=\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(fb.tx_octets(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(fb.tx_rects(state))
    serial.puts((&s_c[0]) as u64)
    serial.dec(fb.frames(state))
    serial.puts((&s_d[0]) as u64)
    if fb.frames(state) != 0 {
        serial.dec(fb.tx_octets(state) / fb.frames(state))
    } else {
        serial.dec(0)
    }
    serial.puts((&s_e[0]) as u64)
    if fb.on_vgpu(state) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()
}

