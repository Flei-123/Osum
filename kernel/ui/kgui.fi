profile kernel


export {
    stage_graphics, stage_surface, stage_hold, board_tick, beat_tick, stall_tick,
    leser_tick, wm_poll,

    crash,
    grace_ready, grace_soll, grace_core, grace_cold,
    parse,
    panikbild
}
import ui.wm.wmkeys
import ui.kgui.kgdisp
import ui.kgui.kgrun
import ui.kgui.kgstage
import ui.kgui.kgsvc
import ui.kgui.kgwm

static mut jv_dbg: u64 = 0

const PB_HEADER: u64 = 3

fn stage_graphics(state: u64, mbi: u64) {
    kgstage.stage_graphics(state, mbi)
}

fn stage_surface(state: u64) {
    kgstage.stage_surface(state)
}

fn stage_hold(state: u64) {
    kgstage.stage_hold(state)
}

fn board_tick(state: u64) {
    kgrun.board_tick(state)
}

fn beat_tick(state: u64) {
    kgwm.beat_tick(state)
}

fn stall_tick(state: u64) {
    kgrun.stall_tick(state)
}

fn leser_tick(state: u64) {
    kgdisp.leser_tick(state)
}

fn wm_poll(state: u64) -> bool {
    kgdisp.dnd_pump(state)
    kgdisp.termclip_pump(state)
    return wmkeys.poll(state)
}

fn crash(state: u64, vec: u64, err: u64, rip: u64, cr2: u64, rsp: u64, cs: u64, kern: u64, trace: u64, spurn: u64, gestoppt: u64) {
    kgrun.crash(state, vec, err, rip, cr2, rsp, cs, kern, trace, spurn, gestoppt)
}

fn grace_ready(state: u64) -> u64 {
    return kgrun.grace_ready(state)
}

fn grace_soll(state: u64, index: u64) -> u64 {
    return kgrun.grace_soll(state, index)
}

fn grace_core(state: u64, index: u64, runden: u64, soll: u64) -> u64 {
    return kgrun.grace_core(state, index, runden, soll)
}

fn grace_cold(state: u64) {
    kgrun.grace_cold(state)
}

fn parse(state: u64, cmd: u64) {
    kgsvc.parse(state, cmd)
}

fn panikbild(state: u64, vec: u64, err: u64, rip: u64, cr2: u64, rsp: u64, cs: u64, flg: u64, ss: u64, kern: u64, regs: u64, trace: u64, spurn: u64, cur_file: u64) {
    kgstage.panikbild(state, vec, err, rip, cr2, rsp, cs, flg, ss, kern, regs, trace, spurn, cur_file)
}
