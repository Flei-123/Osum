profile kernel

import lib.kstate
import mm.mem
import sched.sched
import sched.time
import serial

export { parse, tick, note, field, reset, page, total, cost, rec, pid_of, mon_toggle, mon_set, mon_on, hover_in, hover_push, hover_coal, hover_term, hover_pop, hover_get, H_IN, H_PUSH, H_COAL, H_TERM, H_POP, H_WIN, H_X, H_Y, SLOTS, F_COUNT, F_LAST, F_SUM, F_GAPS, F_MAX, F_GAP, F_OWNER, GAP_CAP_US }

const SLOTS: u64 = 32
const REC_WORDS: u64 = 15
const HDR_AT: u64 = 3840
const F_COUNT: u64 = 0
const F_LAST: u64 = 1
const F_SUM: u64 = 2
const F_GAPS: u64 = 3
const F_MAX: u64 = 4
const F_GAP: u64 = 5
const F_OWNER: u64 = 6 // owner task slot + 1 of the window (0 = unknown); pid_of() turns it into the pid
const GAP_CAP_US: u64 = 1000000
const H_IN: u64 = 0
const H_PUSH: u64 = 1
const H_COAL: u64 = 2
const H_TERM: u64 = 3
const H_POP: u64 = 4
const H_WIN: u64 = 5
const H_X: u64 = 6
const H_Y: u64 = 7
const H_WORDS: u64 = 8

static mut pg: u64 = 0
static mut seen: u64 = 0
static mut spent: u64 = 0
static mut every: u64 = 0
static mut due: u64 = 0
static mut mon_flag: u64 = 0
static mut hv: [u64; 8] = [0 as u64; 8]

static mut w_dump: [u8; 12] = "framesdump=\0"
static mut t_win: [u8; 13] = "frames: win=\0"
static mut t_pres: [u8; 11] = " presents=\0"
static mut t_avg: [u8; 9] = " avg_us=\0"
static mut t_max: [u8; 9] = " max_us=\0"
static mut t_tot: [u8; 15] = "frames: total=\0"
static mut t_cyc: [u8; 11] = " note_cyc=\0"
static mut t_pid: [u8; 6] = " pid=\0"
static mut t_hv: [u8; 14] = "frames: hover\0"
static mut t_hin: [u8; 5] = " in=\0"
static mut t_hpush: [u8; 9] = " pushed=\0"
static mut t_hcoal: [u8; 7] = " coal=\0"
static mut t_hterm: [u8; 7] = " term=\0"
static mut t_hpop: [u8; 9] = " popped=\0"
static mut t_hwin: [u8; 6] = " win=\0"

fn rd(a: u64) -> u64 {
    return __mmio_read64(a as *mut u64)
}

fn wr(a: u64, v: u64) {
    __mmio_write64(a as *mut u64, v)
}

fn hover_get(k: u64) -> u64 {
    if k >= H_WORDS {
        return 0
    }
    return hv[k as usize]
}

fn hover_in() {
    hv[H_IN as usize] = hv[H_IN as usize] + 1
}

fn hover_push(win: u64, x: u64, y: u64) {
    hv[H_PUSH as usize] = hv[H_PUSH as usize] + 1
    hv[H_WIN as usize] = win + 1
    hv[H_X as usize] = x
    hv[H_Y as usize] = y
}

fn hover_coal() {
    hv[H_COAL as usize] = hv[H_COAL as usize] + 1
}

fn hover_term() {
    hv[H_TERM as usize] = hv[H_TERM as usize] + 1
}

fn hover_pop() {
    hv[H_POP as usize] = hv[H_POP as usize] + 1
}

fn field(r: u64, k: u64) -> u64 {
    return rd(r + k * 8)
}

fn mon_toggle() -> bool {
    if mon_flag == 0 {
        mon_flag = 1
    } else {
        mon_flag = 0
    }
    return mon_flag != 0
}

fn mon_set(on: bool) {
    if on {
        mon_flag = 1
    } else {
        mon_flag = 0
    }
}

fn mon_on() -> u64 {
    return mon_flag
}

fn page() -> u64 {
    return pg
}

fn total() -> u64 {
    return seen
}

fn cost() -> u64 {
    return spent
}

fn ensure(state: u64) -> u64 {
    if pg != 0 {
        return pg
    }
    let f: u64 = mem.frame_alloc(state)
    if f == 0 {
        return 0
    }
    var o: u64 = 0
    while o < mem.FRAME_SIZE / 8 {
        wr(f + o * 8, 0)
        o = o + 1
    }
    pg = f
    return f
}

fn rec(i: u64) -> u64 {
    if pg == 0 || i >= SLOTS {
        return 0
    }
    return pg + i * REC_WORDS * 8
}

fn reset(i: u64) {
    let r: u64 = rec(i)
    if r == 0 {
        return
    }
    var k: u64 = 0
    while k < REC_WORDS {
        wr(r + k * 8, 0)
        k = k + 1
    }
}

fn us_of(state: u64, d: u64) -> u64 {
    let kh: u64 = time.khz(state)
    if kh < 1000 {
        return 0
    }
    return d / (kh / 1000)
}

// `owner` = the task slot that owns window i (wm W_OWNER); stored so /proc/frames and the dump can name the pid.
fn note(state: u64, i: u64, owner: u64) {
    if i >= SLOTS {
        return
    }
    if ensure(state) == 0 {
        return
    }
    let r: u64 = rec(i)
    let now: u64 = time.tsc()
    let t0: u64 = now
    let n: u64 = rd(r + F_COUNT * 8)
    let last: u64 = rd(r + F_LAST * 8)
    if n > 0 && now > last {
        let gap: u64 = us_of(state, now - last)
        if gap < GAP_CAP_US {
            wr(r + F_SUM * 8, rd(r + F_SUM * 8) + gap)
            wr(r + F_GAPS * 8, rd(r + F_GAPS * 8) + 1)
            if gap > rd(r + F_MAX * 8) {
                wr(r + F_MAX * 8, gap)
            }
        }
        wr(r + F_GAP * 8, gap)
    }
    wr(r + F_COUNT * 8, n + 1)
    wr(r + F_OWNER * 8, owner + 1)
    wr(r + F_LAST * 8, now)
    seen = seen + 1
    let t1: u64 = time.tsc()
    if t1 > t0 {
        spent = spent + (t1 - t0)
    }
}

fn word_at(cmd: u64, i: u64) -> bool {
    var k: u64 = 0
    while k < 11 {
        if kstate.get8(cmd + i + k) != kstate.get8((&w_dump[0]) as u64 + k) {
            return false
        }
        k = k + 1
    }
    return i == 0 || kstate.get8(cmd + i - 1) == 32
}

fn parse(cmd: u64) {
    var i: u64 = 0
    while i < 4096 && kstate.get8(cmd + i) != 0 {
        if word_at(cmd, i) {
            var v: u64 = 0
            var n: u64 = 0
            while n < 7 && kstate.get8(cmd + i + 11 + n) >= 48 && kstate.get8(cmd + i + 11 + n) <= 57 {
                v = v * 10 + (kstate.get8(cmd + i + 11 + n) - 48)
                n = n + 1
            }
            every = v
        }
        i = i + 1
    }
}

// The pid (as Ring 3 sees it) of the task that owns the window of record `r`; 0 = unknown or gone.
fn pid_of(state: u64, r: u64) -> u64 {
    let o: u64 = field(r, F_OWNER)
    if o == 0 || o - 1 >= kstate.MAX_TASKS {
        return 0
    }
    if sched.tget(state, o - 1, sched.T_STATE) == sched.S_FREE {
        return 0
    }
    return sched.tget(state, o - 1, sched.T_PID)
}

fn say(label: u64, v: u64) {
    serial.puts(label)
    serial.dec(v)
}

fn tick(state: u64) {
    if every == 0 {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if now < due {
        return
    }
    due = now + every
    var i: u64 = 0
    while i < SLOTS {
        let r: u64 = rec(i)
        if r != 0 && field(r, F_COUNT) != 0 {
            var avg: u64 = 0
            if field(r, F_GAPS) != 0 {
                avg = field(r, F_SUM) / field(r, F_GAPS)
            }
            say((&t_win[0]) as u64, i)
            say((&t_pres[0]) as u64, field(r, F_COUNT))
            say((&t_avg[0]) as u64, avg)
            say((&t_max[0]) as u64, field(r, F_MAX))
            say((&t_pid[0]) as u64, pid_of(state, r))
            serial.nl()
        }
        i = i + 1
    }
    var per: u64 = 0
    if seen != 0 {
        per = spent / seen
    }
    if hv[H_IN as usize] != 0 || hv[H_PUSH as usize] != 0 {
        serial.puts((&t_hv[0]) as u64)
        say((&t_hin[0]) as u64, hv[H_IN as usize])
        say((&t_hpush[0]) as u64, hv[H_PUSH as usize])
        say((&t_hcoal[0]) as u64, hv[H_COAL as usize])
        say((&t_hterm[0]) as u64, hv[H_TERM as usize])
        say((&t_hpop[0]) as u64, hv[H_POP as usize])
        say((&t_hwin[0]) as u64, hv[H_WIN as usize])
        serial.nl()
    }
    say((&t_tot[0]) as u64, seen)
    say((&t_cyc[0]) as u64, per)
    serial.nl()
}
