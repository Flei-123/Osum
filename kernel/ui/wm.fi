// ------------------------------------------------------- die Zahlen

// RUNDE DESKTOP: SECHZEHN STATT ACHT, und die Zahl ist keine Laune.
// Ein Schreibtisch (1) mit einer Taskleiste (1), dem Starter (1), dem
// Datei-Explorer samt Kontextmenue und Dialog (3) und den
// Einstellungen samt Dialog (2) sind ACHT Fenster -- das neunte bekam
// -E_EXHAUSTED. Mit sechzehn passen Fenstertafel (0x1000) und
// Ereignisringe (0x2000) nicht mehr in die zwei Seiten von WM_OFF;
// beide liegen deshalb in `kstate.DSK_OFF` (0x54000..0x58000), dem
// Vorrat dieser Runde. In WM_OFF stehen nur noch die Skalare.
// DELL ROUND: 16 -> 32 (see kstate.DSK_OFF).
const MAX_WIN: u64 = 32
const WIN_BYTES: u64 = 512
const W_OFF: u64 = 0x0 // die Fenstertafel, Versatz IN kstate.DSK_OFF
const EV_OFF: u64 = 0x4000 // (unused since the DELL ROUND: the event rings are at kstate.EVR_OFF)
const EV_SLOTS: u64 = 32
const EV_BYTES: u64 = 16
const EV_RING: u64 = 512 // EV_SLOTS * EV_BYTES
// RUNDE ECHTHARDWARE-6: so viele Ringverluste werden EINZELN gemeldet,
// danach nur noch gezaehlt. Siehe die Begruendung bei `ev_push`.
const VERL_SAY: u64 = 32

// RUNDE SCHIRM -- DIESE VIER ZAHLEN WAREN BILDPUNKTE UND SIND JETZT
// GRUNDMASSE. Eine Titelleiste von 22 Bildpunkten ist auf 1024x768 eine
// Titelleiste und auf 3840x2160 ein Strich: auf einer Tafel mit viermal
// so vielen Bildpunkten je Zoll ist sie physisch ein Viertel so hoch.
// Multipliziert wird mit `uisc(state)`, und der Faktor kommt aus
// `fb.uiscale` -- entweder aus der PHYSISCHEN Groesse der Tafel (EDID,
// Oktett 21) oder, wenn die Tafel dazu schweigt, aus ihrer Bildpunktzahl.
const TITLE_H0: u64 = 22 // die Titelleiste
const BORDER0: u64 = 2 // der Rand links, rechts und unten
// RUNDE ECHTHARDWARE-3: 12 -> 8, aber jetzt am GANZEN Rand statt nur
// in der Ecke. Multipliziert mit `uisc` sind das auf Justins Schirm 16
// Bildpunkte Rand -- breit genug zum Treffen, schmal genug, dass ein
// Klick in die Flaeche noch ein Klick in die Flaeche ist.
// DELL ROUND: how much of a window must stay in sight when it is pushed
// over the left or right screen edge (base pixels, times uisc).
const VIS_MIN0: u64 = 96
const GRIP0: u64 = 8 // der Rand, an dem die Groesse gezogen wird
const CLOSE_W0: u64 = 14
// RUNDE TITELABSTAND (Justin, 13.09.2026): der Titel klebte am Rand.
// Er stand bei BORDER0 + 5 = 7 Bildpunkten, und die 5 war eine nackte
// Zahl an zwei Stellen -- in der Malstelle und in der Serienausgabe,
// die ein Laeufer zum Nachrechnen liest. Jetzt EINE Konstante, und sie
// wird wie alle Grundmasse mit `uisc` multipliziert: bisher wuchs der
// Rand mit der Tafel, der Abstand dahinter aber nicht.
const TITLE_PAD0: u64 = 10

const K_RAW: u64 = 0 // die Anwendung malt selbst
const K_TERM: u64 = 1 // ein Zeichenraster, der Server malt

// ADDENDUM TASKBAR: the largest window this server will make. It is
// the screen, and it is exported because whoever wants a window that
// can be maximized to ANY work area has to ask for this size when the
// window is created -- the buffer is never reallocated.
//
// RUNDE SCHIRM: DAS WAREN ZWEI ZAHLEN IM QUELLTEXT, UND SIE HABEN
// GELOGEN, SOBALD DER SCHIRM GROESSER WAR. Auf 1024x768 fielen genau
// deshalb vier Zusagen des Selbsttests (26/30 statt 30/30): ein Fenster,
// das mit 800x600 entsteht, kann eine Arbeitsflaeche von 1024x740 nicht
// fuellen, `resize_win` waechst nicht ueber seinen Puffer hinaus, und
// `maximize` gibt darum ehrlich `false` zurueck. Auf Justins Blech
// (1280x800 unter UEFI, 1920x1080 unter BIOS) heisst dasselbe:
// "maximieren" macht ein Fenster von 800x600 in der Ecke.
//
// Jetzt sind es die Masse des Schirms, die `init` einmal hinlegt.
// MAX_W_HARD ist nur noch die Obergrenze, an der ein Puffer je Fenster
// unvernuenftig wuerde -- 3840x2160x4 sind 33 MiB, und sechzehn davon
// waeren mehr, als der Rahmenverwalter ueberhaupt verwaltet.
const MAX_W_HARD: u64 = 4096
const MAX_H_HARD: u64 = 2304

// ------------------------------------------- RUNDE DESKTOP: die Ebenen
//
// DREI EBENEN, UND SIE SIND DER GRUND, WARUM ES EINEN SCHREIBTISCH
// GEBEN KANN. Bis zu dieser Runde war die Stapelreihenfolge EINE Kette:
// wer angeklickt wurde, kam nach ganz oben. Ein Hintergrundbild ist
// aber ein Fenster, das NIE nach oben darf, und eine Taskleiste ist ein
// Fenster, das IMMER oben bleiben muss -- beides ist in einer einzigen
// Kette nicht ausdrueckbar. Logbuch K15 hat genau das als "geht heute
// nicht" vermerkt.
//
// Die Ordnung ist jetzt zweistufig: erst die Ebene, dann innerhalb der
// Ebene die Reihenfolge. `raise_win` hebt ein Fenster nur bis an die
// Oberkante SEINER Ebene. Die Gegenprobe heisst `nolayer` und schaltet
// genau diese eine Zeile ab -- dann kommt der Schreibtisch beim ersten
// Klick nach vorn und verdeckt alles.
const L_DESK: u64 = 0 // der Schreibtisch, immer ganz hinten
const L_NORMAL: u64 = 1 // gewoehnliche Anwendungen
const L_TOP: u64 = 2 // die Taskleiste
// ================================================== RUNDE ECHTHARDWARE-3
// DREI EBENEN WAREN ZU WENIG, UND DAS IST DIE WURZEL MEHRERER FEHLER.
//
// Justins Befund vom 09.09.: der Tooltip verschwindet HINTER der
// Taskleiste, das Kontextmenue ist ein echtes Fenster mit Titelleiste
// und Kreuz, und das Startmenue ueberlappt die Leiste. Alle drei sind
// dasselbe Problem: es gab nur `L_TOP`, und wer dort hin musste, lag
// mit der Leiste auf EINER Ebene -- die Reihenfolge entschied dann,
// wer spaeter angelegt wurde, und das ist keine Ordnung, sondern ein
// Zufall.
//
// DIE ORDNUNG, VON UNTEN NACH OBEN, und sie ist ab hier eine ZUSAGE:
//
//     L_DESK    0  Schreibtisch
//     L_NORMAL  1  gewoehnliche Fenster und Dialoge
//     L_TOP     2  die Taskleiste
//     L_MENUE   3  Startmenue/Ueberlagerung -- ueber der Leiste
//     L_POPUP   4  Klappmenues und Kontextmenues
//     L_TIP     5  Blasen, ueber ALLEM
//
// Die Zahlen 0..2 bleiben, was sie waren: jedes Programm, das `L_TOP`
// sagt, meint weiter die Leiste und liegt weiter dort. Neu ist nur,
// dass ueber ihr noch etwas sein KANN.
// ================================================== RUNDE VOLLBILD
// EINE SECHSTE EBENE, UND ZWAR ZWISCHEN LEISTE UND MENUES.
//
// Ein Vollbildfenster muss UEBER der Taskleiste liegen -- sonst
// schimmert sie durch, und genau das hat Justin ausgeschlossen ("die
// Taskleiste darf NICHT durchscheinen"). Es darf aber NICHT ueber
// Kontextmenues und Blasen liegen: ein Menue, das ein Vollbildprogramm
// selbst aufklappt, waere sonst unsichtbar.
//
// Also L_FULL = 3, und die drei darueber ruecken um eins hoch. Die
// Zahlen 0..2 bleiben unangetastet -- das ist die Zusage aus
// ECHTHARDWARE-3, und jedes Programm, das `L_TOP` sagt, liegt weiter
// genau dort.
const L_FULL: u64 = 3 // Vollbild: ueber der Leiste, unter den Menues
const L_MENUE: u64 = 4 // Startmenue: ueber der Leiste, unter den Menues
const L_POPUP: u64 = 5 // Klapp- und Kontextmenue
const L_TIP: u64 = 6 // die Blase, ueber allem
// ==================================================== RUNDE DREI (S-006)
// L_TOAST -- DIE EINBLENDUNG, UEBER DER BLASE UND OHNE BLUR.
//
// SIE BEKOMMT EINE EIGENE EBENE, UND DER GRUND IST EINE HARTE ZAHL:
// der Blur-Zwischenspeicher hat VIER Plaetze (`BC_N`), und das ist
// keine weiche Konstante. Die Angaben je Platz liegen als Felder in
// kdata, und ihr Abstand ist 0x20 = 32 Oktette = GENAU VIER Woerter
// (S_BC_WIN 0x13A0, S_BC_X 0x13C0, ...). Ein fuenfter Platz wuerde
// S_BC_X ueberschreiben -- zwei Groessen auf einer Adresse, derselbe
// Fehler, den MERGE-9 schon einmal hatte.
//
// Die vier waren GEZAEHLT und nicht geraten: Leiste, Startmenue, ein
// Klappmenue, eine Blase. Diese Runde bringt eine FUENFTE
// durchscheinende Flaeche, und damit lief der Ring ueber: ein Platz
// wurde mitten im Malen neu vergeben, die gleitende Summe in `blur_v`
// zog Zeilen ab, die nie addiert worden waren, und der Fensterserver
// starb mit
//
//     panic: integer overflow in 'u64 - u64' at wm.fi:6832
//
// GEMESSEN: mit der Einblendung auf L_TIP fiel `pruef/abmelden.py` von
// 13/0 auf 7/6 -- und zwar NICHT, weil am Abmelden etwas falsch war,
// sondern weil der Server beim Malen der Leiste starb. Der Panic stand
// mitten in einer Leistenzeile und war nur auf der seriellen Leitung
// zu sehen; im Bild sah es aus wie ein Menue, das seine Wahl verschluckt.
//
// ALSO KEIN BLUR FUER DIE EINBLENDUNG. Das ist die richtige Antwort und
// nicht nur die billige: eine Benachrichtigung steht wenige Sekunden
// da, sie ist eine KARTE mit eigener deckender Flaeche (`draw_board`),
// und ein Weichzeichner darunter waere ohnehin fast unsichtbar. Den
// Zwischenspeicher auf fuenf zu heben hiesse, das Speicherbild des
// Kerns umzulegen -- fuer einen Effekt, den niemand sieht.
//
// Wer ihn doch will, hebt `BC_N` UND die Abstaende der S_BC_*-Felder
// gemeinsam an. Beides, oder keines.
const L_TOAST: u64 = 7 // die Benachrichtigung, ueber allem, ohne Blur
// W-WINOPTS S2: L_FLOAT -- THE ONLY "ALWAYS ON TOP" AN APP CAN GET. The NUMBER is 8 because 0..7 are promises (a program that says L_TOP
// means the task bar and stays there). The ORDER is not the number: L_FLOAT lies above L_NORMAL and BELOW L_TOP, so the task bar, start
// menu, popups, tips, toasts and the lock screen (L_TOP) always cover it. Every comparison of layers for z order goes through
// `layer_rank`. A non-root caller needs the right `window.float` (lib/apprights/policy.fi) for it; L_TOP stays root only.
// The same number is in kernel/user/wlibc.fi (ring 3 cannot import the window server).
const L_FLOAT: u64 = 8
const L_MAX: u64 = 8

// Z rank of a layer: the layer number doubled, and L_FLOAT in the gap between L_NORMAL (2) and L_TOP (4).
fn layer_rank(l: u64) -> u64 {
    if l == L_FLOAT {
        return 3
    }
    return l * 2
}

// Die Merkmale eines Fensters.
//   F_HIDDEN  minimiert: es wird nicht zusammengesetzt und nimmt keinen
//             Klick an. Es lebt weiter, sein Puffer bleibt.
//   F_NODECO  ohne Schmuck: kein Rahmen, keine Titelleiste, kein
//             Schliessfeld, kein Groessengriff. Schreibtisch und
//             Taskleiste sind so.
const F_HIDDEN: u64 = 1
const F_NODECO: u64 = 2
// ADDENDUM TASKBAR: a maximized window is not a window that happens to
// be as large as the work area -- it is a window that FOLLOWS the work
// area. Without the flag the server cannot tell the two apart, and a
// taskbar that moves to another edge would leave every window where it
// was.
const F_MAXIMIZED: u64 = 4
// RUNDE TILING: dieses Fenster liegt hinter einem Reiter. Es ist NICHT
// dasselbe wie F_HIDDEN (minimiert): ein Klick auf den Reiter holt es
// zurueck, ein Klick auf den Fensterknopf der Leiste nicht.
const F_TABBED: u64 = 8

// ============================================ RUNDE ECHTHARDWARE-1
// EIN FENSTER DER OBERSTEN EBENE, DAS DIE TASTATUR TROTZDEM WILL.
//
// Justins Befund vom 09.09.: im Startmenue laesst sich nichts tippen.
// Die Ursache ist eine Regel, die fuer die Taskleiste richtig ist und
// fuer das Startmenue falsch: `on_mouse` gibt den Fokus NUR an
// Fenster der Ebene L_NORMAL (Runde DESKTOP -- "ein Schreibtisch, der
// den Fokus an sich zieht, macht jeden Tastendruck danach
// wirkungslos"). Der Starter liegt aber auf L_TOP, weil er UEBER allem
// stehen muss -- und bekam damit nie eine Taste.
//
// Die Ebene zu wechseln waere die falsche Abhilfe: dann verschwindet
// das Menue hinter Fenstern. Also sagt das Fenster selbst, was es
// will. Vorgabe ist NEIN, also bleibt die Leiste, was sie war.
const F_KEYS: u64 = 16

// ================================================== RUNDE VOLLBILD
// VOLLBILD IST NICHT MAXIMIERT, UND DAS IST DER GANZE PUNKT.
//
// Justins Vorgabe, und sie deckt sich mit Windows und jedem Browser:
//
//   MAXIMIERT = die ARBEITSFLAECHE. Die Leiste bleibt sichtbar, die
//               Titelleiste bleibt da. Das Fenster BERUEHRT die Leiste
//               nie. Das ist F_MAXIMIZED, und es gibt es schon.
//
//   VOLLBILD  = der GANZE Schirm, die Leistenflaeche eingeschlossen.
//               Keine Titelleiste, kein Rahmen, und die Leiste ist
//               NICHT zu sehen. Das ist F_FULL, und das ist neu.
//
// ZWEI ZUSTAENDE, NICHT EINER. Wer sie in ein Merkerbit legt, kann die
// Frage "war es vorher maximiert?" beim Verlassen nicht mehr
// beantworten -- und genau das ist der Teil, der laut Justin "gerne
// kaputtgeht". Deshalb hat das Vollbild EIGENE Sicherungsplaetze
// (W_FSXY/W_FSWH) und laesst F_MAXIMIZED unangetastet stehen: beim
// Verlassen wird der alte Zustand nicht ERRATEN, sondern GELESEN.
const F_FULL: u64 = 32
// r454: TABS IN THE TITLE BAR. A window with this flag has its buffer grown upward by the strip of the title bar
// (`strip_h`): the client paints the strip (tabs, plus button), the server still draws frame, shadow and the three caption
// buttons (AFTER the client area) and skips the title background and text. The client declares the empty x-range of the
// strip (`W_DRAGX`): a press there starts the server's own move, a double click maximises / restores. docs/COMPOSITOR.md.
const F_CAPCLIENT: u64 = 64

// ADDENDUM TASKBAR: the four screen edges. The numbers are written to
// /etc/taskbar.conf as words ("bottom", "top", "left", "right") and
// they are the same four numbers in the kernel, in the taskbar and in
// the settings application -- there is no translation table.
const EDGE_BOTTOM: u64 = 0
const EDGE_TOP: u64 = 1
const EDGE_LEFT: u64 = 2
const EDGE_RIGHT: u64 = 3

const E_KEY: u64 = 1
const E_DOWN: u64 = 2
const E_UP: u64 = 3
const E_MOVE: u64 = 4
const E_CLOSE: u64 = 5
const E_FOCUS: u64 = 6
const E_RESIZE: u64 = 7
// ROUND A11Y-2: "press your control number a" -- put into a window by
// the accessibility tree (sysgui.ax_call, AX_PRESS), never by input. The
// widget layer handles it like a click on that control.
const E_AXPRESS: u64 = 8
// ROUND FV-W24: THE MOUSE WHEEL REACHES A WINDOW. a = x, b = y (client
// coordinates, like E_MOVE), c = the notches since the last report as a
// 16-bit two's complement, POSITIVE = scrolled UP (away from the user, the
// sign of Linux REL_WHEEL and Windows WM_MOUSEWHEEL). The driver sums with
// the opposite sign (`ps2m.wheel`: +1 = toward the user), so it is flipped
// here. Goes to the window under the pointer.
const E_WHEEL: u64 = 9
// r804: THE HORIZONTAL WHEEL (two-finger sideways scroll, AC Pan). Same layout as E_WHEEL, c = notches as a 16-bit
// two's complement, POSITIVE = scrolled RIGHT (Linux REL_HWHEEL, Windows WM_MOUSEHWHEEL). The driver sum
// (`ps2m.hwheel`) already has this sign, so it is NOT flipped.
const E_HWHEEL: u64 = 10

// die Skalare
const S_READY: u64 = 0x000
const S_COUNT: u64 = 0x008
const S_FOCUS: u64 = 0x010 // Fenster + 1, 0 = keines
const S_NEXTID: u64 = 0x018
const S_DX0: u64 = 0x020 // der schmutzige Bereich
const S_DY0: u64 = 0x028
const S_DX1: u64 = 0x030
const S_DY1: u64 = 0x038
const S_DON: u64 = 0x040
const S_SW: u64 = 0x048 // Bildschirmgroesse
const S_SH: u64 = 0x050
const S_DRAG: u64 = 0x058 // Fenster + 1, das am Zeiger haengt
const S_DRAGX: u64 = 0x060
const S_DRAGY: u64 = 0x068
const S_SIZING: u64 = 0x070 // Fenster + 1, dessen Groesse gezogen wird
const S_CURON: u64 = 0x078
const S_CURX: u64 = 0x080 // wo der Zeiger zuletzt gemalt wurde
const S_CURY: u64 = 0x088
const S_COMPOSITES: u64 = 0x090
const S_BLITS: u64 = 0x098
const S_PIXELS: u64 = 0x0A0
const S_NODIRTY: u64 = 0x0A8 // GEGENPROBE: immer das ganze Bild
const S_NOFOCUS: u64 = 0x0B0 // GEGENPROBE: Tasten an alle
const S_FONT_UI: u64 = 0x0B8
const S_FONT_MONO: u64 = 0x0C0
const S_PX_UI: u64 = 0x0C8
const S_PX_MONO: u64 = 0x0D0
const S_LASTUS: u64 = 0x0D8
const S_KEYS: u64 = 0x0E0
const S_EVDROP: u64 = 0x0E8
const S_CURSAVE: u64 = 0x0F0 // Rahmen fuer den Zeigergrund
const S_DESK: u64 = 0x0F8
const S_DOWNS: u64 = 0x100
const S_MOVES: u64 = 0x108
const S_HITS: u64 = 0x110 // die Farbe des Hintergrunds
// RUNDE K15: WELCHES ZEIGERBILD. 0 = Pfeil, 1 = Textbalken. Es steht
// hier und nicht in der Anwendung, weil der Zeiger UEBER allen Fenstern
// liegt und vom Server gemalt wird -- eine Anwendung, die ihn selbst
// zeichnete, zeichnete ihn in ihr eigenes Rechteck und damit unter alle
// anderen. `kernel/wig.fi` setzt ihn auf Verlangen aus Ring 3.
const S_SHAPE: u64 = 0x118
// RUNDE DESKTOP. Vier Skalare: die beiden Gegenproben und die beiden
// Zaehler, ohne die "das Fenster wurde minimiert" eine Behauptung
// ueber etwas waere, das man im Bild gerade NICHT sieht.
const S_NOLAYER: u64 = 0x120 // GEGENPROBE: die Ebenen abschalten
const S_NOMIN: u64 = 0x128 // GEGENPROBE: das Verbergen abschalten
const S_HIDES: u64 = 0x130 // wie oft ein Fenster verborgen wurde
const S_SHOWS: u64 = 0x138 // und wie oft es wieder auftauchte
// ADDENDUM TASKBAR: the work area and its two counters. It is kept as
// four scalars and NOT recomputed on demand: `compose` runs sixty
// times a second and would walk the window table each time for an
// answer that changes when a strut changes and at no other moment.
const S_WORK_X: u64 = 0x140
const S_WORK_Y: u64 = 0x148
const S_WORK_W: u64 = 0x150
const S_WORK_H: u64 = 0x158
const S_NOSTRUT: u64 = 0x160 // COUNTER-TEST: ignore every strut
const S_STRUTS: u64 = 0x168 // how often a strut was declared or cleared
const S_WORKCALC: u64 = 0x170 // how often the work area was recomputed
// ============================================ RUNDE ECHTHARDWARE-4
// WELCHE FORM DIE ANWENDUNG WOLLTE.
//
// Ab dieser Runde setzt der Server selbst eine Form, sobald der Zeiger
// ueber einem Fensterrand steht (Doppelpfeil), und nimmt sie zurueck,
// sobald er ihn verlaesst. "Zuruecknehmen" heisst aber nicht "Pfeil":
// eine Anwendung, die ueber ihrem Textfeld die Textmarke gesetzt hat
// (`wig.set_shape` aus Ring 3), bekaeme sonst bei jeder Mausbewegung
// den Pfeil zurueck und die Marke waere nie zu sehen. Also stehen die
// beiden Wuensche NEBENEINANDER: was die Anwendung will, und was der
// Rand gerade verlangt.
const S_SHAPE_APP: u64 = 0x178
// RUNDE TILING. Die Skalare des Kachelbetriebs. Sie lagen bei 0x120,
// wo die Runden DESKTOP und TASKLEISTE zusammen schon elf Woerter
// stehen haben -- zwei Runden auf denselben Adressen. Sie zogen
// deshalb hinter deren Block, auf 0x180.
//
// UND DORT LAG SCHON DIE RUNDE THEME. Runde PAINT hat es gefunden, als
// sie fuer die FORM des Fensters drei freie Woerter suchte:
//
//     const S_TILE: u64 = 0x180      // Runde TILING
//     const S_DECO: u64 = 0x180      // Runde THEME, ELF Woerter
//                                    // (0x180 bis einschliesslich 0x1D0)
//
// Beide werden ueber dasselbe `gs`/`ss` in denselben Block geschrieben.
// Das ist BILDPUNKTGENAU der Fehler aus Runde K7B -- der Zeichensatz
// und die Signaltafel auf 0x2F000 --, nur eine Ebene tiefer: zwei
// Zweige, jeder fuer sich gruen, keine gemeinsame ZEILE, nur eine
// gemeinsame ADRESSE. Ein Textverschmelzer kann das nicht sehen.
//
// WAS ES ANRICHTETE, Wort fuer Wort. `deco_push` in Ring 3 setzt elf
// Farben hintereinander; jede davon landete AUSSERDEM in einem Skalar
// des Kachelbetriebs:
//
//     DK_FRAME + 1     -> S_TILE     Kachelbetrieb sieht "an" aus
//     DK_TITLE + 1     -> S_PVON     ein Vorschaurechteck liegt an
//     DK_TEXT + 1      -> S_PVX      seine Koordinaten sind Farben
//     DK_FRAME_ON + 1  -> S_PVY
//     DK_TITLE_ON + 1  -> S_PVW
//     DK_TEXT_ON + 1   -> S_PVH
//     DK_CLOSE + 1     -> S_DROPN
//     DK_CLOSE_MARK+1  -> S_DROPS
//     DK_DESK + 1      -> S_DROPE
//     DK_TERM_FG + 1   -> S_DRAGT
//     DK_TERM_BG + 1   -> S_HOTS
//
// und umgekehrt: jedes Tastenkuerzel zaehlte S_HOTS hoch und AENDERTE
// DAMIT DIE HINTERGRUNDFARBE EINES TERMINALFENSTERS.
//
// Dazu ein zweiter, kleinerer Treffer in derselben Ecke: `S_DECON`
// stand auf 0x1C0, weil der Block zu seiner Zeit ACHT Woerter hatte
// ("acht Woerter, 0x180 .. 0x1B8" -- der Kommentar steht noch da).
// Runde MERGE hat ihn auf ELF erweitert und S_DECON nicht mitgezogen:
// seither ist 0x1C0 gleichzeitig der Schreibzaehler UND Steckplatz 8,
// die Farbe des Schreibtischgrundes. Jeder gesetzte Farbwert
// ueberschrieb sie mit der Zahl der bisherigen Schreibvorgaenge.
//
// GEFUNDEN HAT DAS `tools/paint/scalars.py`, und zwar mechanisch: es
// liest alle `const S_...: u64 = 0x...` einer Datei und rechnet sie
// paarweise gegeneinander, mit der Laenge aus dem Kommentar oder aus
// einer Laengenkonstante. Dreizehn Ueberschneidungen, alle dreizehn
// hier.
//
// DIE NEUE AUFTEILUNG, mit Luft dazwischen statt auf Kante:
//
//     0x180 .. 0x1D0   THEME, elf Farbsteckplaetze
//     0x1D8            THEME, der Schreibzaehler
//     0x200 .. 0x258   TILING
//     0x280 .. 0x2B0   PAINT, die Form und ihre Zaehler
//
// WM_MAX ist 0x2000; die naechste Runde nimmt 0x300.
const S_TILE: u64 = 0x200 // 1 = neue Fenster gehen in den Baum
const S_PVON: u64 = 0x208 // ein Vorschaurechteck liegt auf dem Schirm
const S_PVX: u64 = 0x210
const S_PVY: u64 = 0x218
const S_PVW: u64 = 0x220
const S_PVH: u64 = 0x228
const S_DROPN: u64 = 0x230 // Zielknoten + 1 beim Ziehen
const S_DROPS: u64 = 0x238 // Seite am Ziel (tile.D_*), 4 = als Reiter
const S_DROPE: u64 = 0x240 // Bildschirmrand + 1 statt eines Zielfensters
const S_DRAGT: u64 = 0x248 // das gezogene Fenster kam AUS dem Baum
const S_HOTS: u64 = 0x250 // wie viele Tastenkuerzel ausgefuehrt wurden
const S_ACTS: u64 = 0x258 // wie viele davon wirklich etwas getan haben

// ===================================== RUNDE MESSTAFEL: DER EINGABEWEG
//
// Drei Zaehler, die es vorher nicht gab, und jeder beantwortet GENAU
// eine Frage aus Justins Kette "wo bleibt mein Tastendruck":
//
//   S_KEYIN   wie oft `on_key` gerufen wurde -- also wie viele Tasten
//             der FENSTERSERVER entgegengenommen hat. Vorher war das
//             nicht zu sehen: `usb.hid_keys` zaehlt, was `hidin` an
//             `kbd` gab, und danach klaffte eine Luecke bis zum Fenster.
//   S_EVPUSH  wie viele Ereignisse in einen Fensterring GELEGT wurden.
//   S_EVPOP   wie viele ein RING-3-PROGRAMM daraus ABGEHOLT hat.
//
// Das letzte Paar ist der Kern der Sache. Stehen beide hoch, arbeitet
// der Schreibtisch. Laeuft `S_EVPUSH` hoch und `S_EVPOP` bleibt null,
// dann liefert der Kern und NIEMAND holt ab -- dann laeuft kein
// Ring-3-Prozess mehr, und das erklaert die tote Eingabe UND die
// unsichtbare Taskleiste mit EINER Ursache statt mit zweien.
//
// Die Luecke 0x260..0x278 war frei; `tools/paint/scalars.py` prueft das
// mechanisch nach und ist nach dieser Aenderung gelaufen.
const S_EVPUSH: u64 = 0x260 // Ereignisse in einen Fensterring gelegt
const S_EVPOP: u64 = 0x268 // Ereignisse von einem Programm abgeholt
const S_KEYIN: u64 = 0x270 // Tasten, die der Fensterserver annahm

// ---------------------------------------------------- RUNDE THEME
//
// DIE ACHT FARBEN DER FENSTERDEKORATION, und der Grund, warum sie hier
// als DATEN stehen und nicht mehr als Zahlen im Zeichencode:
//
// Rahmen und Titelleiste malt der SERVER -- er muss, er setzt das Bild
// zusammen. Damit sass bis zu dieser Runde die einzige Stelle der
// Oberflaeche, die ihre Farbe selbst wusste, im KERNEL: sechs Werte in
// `draw_win`, unerreichbar fuer jedes Schema. Ein helles Thema mit
// dunkelblauer Titelleiste ist kein helles Thema.
//
// Die Loesung ist NICHT, den Kernel das Thema lesen zu lassen -- dann
// haette der Kernel eine Meinung darueber, wie ein Fenster aussieht.
// Sie ist: der Server haelt acht Zahlen, und wer sie setzt, ist Ring 3
// (WM_DECO, `kernel/sys.fi`). Die Farbpolitik bleibt im Userland, der
// Server bekommt das Ergebnis.
//
// GESPEICHERT WIRD WERT + 1. Null heisst "nie gesetzt", und dann gilt
// `deco_fallback` -- sonst waere eine frisch gestartete Maschine, deren
// Taskleiste noch nicht laeuft, schwarz auf schwarz.
// DECO_SLOTS Woerter, 0x180 bis einschliesslich 0x1D0. Der Kommentar
// sagte "acht Woerter, 0x180 .. 0x1B8" und stimmte, bis Runde MERGE
// drei Steckplaetze anhaengte; die Laenge steht deshalb jetzt als
// RECHNUNG neben der Konstante und nicht als Zahl im Kommentar.
const S_DECO: u64 = 0x180 // DECO_SLOTS Woerter
const S_DECON: u64 = 0x1D8 // wie oft ein Wert gesetzt wurde
// ============================================ RUNDE ECHTHARDWARE-4
// WER DEN FOKUS VORHER HATTE.
//
// GEMESSEN an menue-2560/serial.txt dieser Runde:
//     wm: fokus id=11 vor=7      <- das Startmenue bekommt ihn
//     taskbar: startmenue auf
//     wm: fokus id=12 vor=11     <- eine INFOBLASE bekommt ihn
//     wm: fokus id=7 vor=0       <- die Blase geht, und er faellt
//                                   auf das Anwendungsfenster
//     key: ^[                    <- Escape geht ins Leere
//
// Eine Blase ("Start", `wlib.tip_win_open`) wird als gewoehnliches
// Fenster angelegt und bekommt dabei den Fokus; ERST DANACH setzt sie
// ihre Ebene auf L_TIP, und `set_layer` gibt den Fokus dann an
// `top_visible` -- das ist das oberste NORMALE Fenster und nicht das,
// das ihn vorher hatte. Das Startmenue war ihn damit los, ohne dass
// jemand es angeklickt haette, und Escape kam nie bei ihm an.
//
// Also merkt sich der Server, wer ihn zuletzt hatte, und gibt ihn
// DORTHIN zurueck. Das ist dieselbe Regel, die jedes Fenstersystem
// fuer transiente Fenster hat.
const S_FOCUS_PREV: u64 = 0x1E0
const DECO_SLOTS: u64 = 11

// ==================================================== RUNDE PAINT
//
// DIE FORM DES FENSTERS -- vier Zahlen, die der Server bekommt, weil er
// das Fenster malt und die Widget-Bibliothek nicht an es herankommt.
//
// Runde LOOK hat die Formmarken gebaut (Radius, Schatten, Abstaende)
// und in docs/ROUNDLOOK.md ehrlich aufgeschrieben, was sie NICHT
// erreicht: "The top-level window frame is still square, and so is its
// shadow. `radius_window` and the window shadow are read out of the
// shape file, carried through the resolver and NOT DRAWN. Those pixels
// belong to the kernel's compositor, not to the widget library, and
// reaching them means widening a protocol."
//
// Das ist diese Erweiterung. Sie ist so schmal wie WM_DECO und aus
// demselben Grund: der Kernel bekommt KEINE Formdatei und keine
// Meinung, er bekommt vier aufgeloeste Zahlen. Wer sie setzen darf, ist
// wer eine Taskleiste IST -- dasselbe Recht wie bei den Farben.
const S_FORMN: u64 = 0x2A0 // wie oft ein Wert gesetzt wurde
const S_SHADOWPX: u64 = 0x2A8 // gemischte Bildpunkte fuer Schatten
const S_AAPX: u64 = 0x2B0 // Bildpunkte durch den Eckenabtaster
// ===================================================== RUNDE SOFTUI
//
// SECHS WOERTER MEHR, UND DER GRUND, WARUM S_FORM UMZIEHT.
//
// Runde PAINT hat vier Formwoerter auf 0x280 gelegt und den Zaehler
// unmittelbar dahinter auf 0x2A0. Diese Runde braucht acht -- der
// Schatten des UNSCHARFEN Fensters ist ein eigenes Paar (Staerke und
// Reichweite), der Verlauf der Titelleiste eine Zahl, und die Frage,
// ob die Titelleiste drei Windows-Schaltflaechen traegt oder das alte
// Schliessfeld, ist die achte. Acht Woerter ab 0x280 liefen genau in
// S_FORMN hinein; `tools/paint/scalars.py` haette es gemeldet, aber
// erst nach dem Bau. Also zieht der Block dorthin, wo Platz fuer die
// naechste Runde ist, und der Zaehler bleibt, wo er war.
const S_FORM: u64 = 0x300 // FORM_SLOTS Woerter
// Wie oft die Schattenmaske gebaut wurde. DAS IST DER MESSWERT DIESER
// RUNDE: er muss klein und konstant bleiben, waehrend die Zahl der
// Bilder waechst. Steigt er mit jedem Bild, ist die Maske keine.
const S_SHBUILD: u64 = 0x2B8
const S_SHKEY: u64 = 0x2C0 // fuer welche Werte sie gebaut wurde
const S_SHS: u64 = 0x2C8 // die Kantenlaenge des Eckquadrats
const S_SHOLD: u64 = 0x2D0 // GEGENPROBE: wieder mit Ringen malen
const S_CAPHOV: u64 = 0x2D8 // ueberfahrene Schaltflaeche, (Fenster*4+n)+1
const S_CAPHITS: u64 = 0x2E0
// RUNDE SCHIRM: die Vervielfachung des Fensterschmucks. 0 heisst "noch
// nicht gesetzt" und wird als 1 gelesen.
const S_UISC: u64 = 0x2E8 // wie oft eine davon geklickt wurde
// ====================================================== RUNDE BLECH2
// ZWEI ZAEHLER FUER DEN EREIGNISRING, siehe `ev_push`:
//   S_EVKOAL -- Bewegungen, die in ein NOCH NICHT ABGEHOLTES E_MOVE
//               desselben Fensters zusammengefasst wurden. Das ist
//               kein Verlust: die Anwendung bekommt die letzte Stelle,
//               und genau die will sie.
//   S_EVTERM -- Ereignisse an das Terminalfenster des KERNS, das
//               keinen Abholer in Ring 3 hat. Sie werden gezaehlt und
//               nicht eingereiht -- vorher fielen sie nach 32 Stueck
//               als VERL aus dem Ring (Justins 1283).
const S_EVKOAL: u64 = 0x2F0
const S_EVTERM: u64 = 0x2F8
// r402: the caption button that is held down, (window * 4 + n) + 1, 0 = none. A caption button
// acts on RELEASE over the same button (as on Windows); the held one is painted darker.
const S_CAPDOWN: u64 = 0x3B0
// DIE MASKE SELBST. Zwei Baenke -- aktiv und unscharf -- mal
// SHMASK_SIDE^2 Oktette. 40 ist RADIUS_MAX + SHADOW_MAX, also die
// groesste Ecke, die dieser Server ueberhaupt malen darf.
const S_SHMASK: u64 = 0x400 // 3200 Oktette
const S_SHEDGE: u64 = 0x1080 // 32 Oktette
const S_FAIL: u64 = 0x10A8 // Bitmaske
const S_DIAG1: u64 = 0x10B0 // Diagnose des Selbsttests
const S_DIAG2: u64 = 0x10B8 // Bitmaske der NICHT bestandenen Zusagen

// ================== RUNDE VSYNC: DIE BILDGRENZE UND DIE BEWEGUNG
//
// Bis hierher rief `compose` am Ende `fb.flush`, und `flush` uebertrug
// die schmutzigen Zeilen SOFORT. Bei einer Bewegung liegen zwischen zwei
// Mauspaketen aber mehrere `compose`-Laeufe, und jeder davon schob seinen
// Streifen einzeln auf die Karte. Wer in diesem Augenblick abliest --
// der Bildaufbau des Schirms tut es staendig --, sieht die obere Haelfte
// des Fensters aus dem einen und die untere aus dem naechsten Zustand.
// Das ist das Reissen, und es entsteht NICHT durch einen fehlenden
// Rueckpuffer (den gibt es seit Runde SCHIRM), sondern durch die
// FEHLENDE BILDGRENZE: es war nie gesagt, welche Zeichenschritte
// zusammen EIN Bild sind.
//
// Also wird die Uebertragung von der Zeichnung getrennt:
//
//   `compose`  zeichnet in den Rueckpuffer und merkt den Bereich vor.
//   `present`  uebertraegt EINMAL, im Zeitgebertakt.
//
// S_VSYNC schaltet das an, S_PEND sammelt das Rechteck ueber mehrere
// `compose`-Laeufe hinweg. `nopresent` ist die Gegenprobe: dann geht es
// wieder den alten Weg, und die Zerreissprobe MUSS fehlschlagen.
const S_VSYNC: u64 = 0x10C0 // 1 = Uebertragen erst im Tick
const S_PEND: u64 = 0x10C8 // 1 = es liegt ein ungezeigtes Bild
const S_PX0: u64 = 0x10D0 // das gesammelte Rechteck
const S_PY0: u64 = 0x10D8
const S_PX1: u64 = 0x10E0
const S_PY1: u64 = 0x10E8
const S_PRESENTS: u64 = 0x10F0 // wie oft wirklich uebertragen wurde
const S_SKIPPED: u64 = 0x10F8 // Zeichnungen ohne eigene Uebertragung
// DIE ZERREISSPROBE. Jedes Bild bekommt eine Nummer; malt der Server im
// Signaturbetrieb, faerbt er den oberen und den unteren Rand JEDES
// Fensters mit einer Farbe, die aus dieser Nummer faellt. Ein
// Bildschirmfoto, das im selben Fenster ZWEI verschiedene Signaturen
// zeigt, hat ein halb uebertragenes Bild erwischt -- und genau das ist
// Reissen, sichtbar gemacht.
const S_SIG: u64 = 0x1100 // 1 = Signaturbetrieb
const S_FRAME: u64 = 0x1108 // die laufende Bildnummer
// DIE BEWEGUNG BEIM OEFFNEN UND SCHLIESSEN. Vier Zahlen je Fenster
// liegen im Fenstersatz (W_AN*), hier stehen nur die Zaehler und der
// Takt. Die Zeiten kommen aus den Formmarken (FM_MOTION) und nicht aus
// eigenen Konstanten -- DESIGN-2 hat sie in wlib gesetzt, und zwei
// Wahrheiten ueber dieselbe Dauer waeren eine zu viel.
// DER ABLESER DER ZERREISSPROBE. Er tut, was ein Bildschirm tut: er
// liest den VORDERPUFFER, oben und unten, und vergleicht die beiden
// Signaturen. Sind sie verschieden, hat er ein halb uebertragenes Bild
// erwischt -- und genau das ist Reissen.
const S_LESER: u64 = 0x1130 // 1 = der Ableser laeuft
const S_LIEST: u64 = 0x1138 // wie oft abgelesen wurde
const S_RISS: u64 = 0x1140 // wie oft es dabei nicht zusammenpasste
const S_LX: u64 = 0x1148 // wo abgelesen wird (Fenstermitte)
const S_LY0: u64 = 0x1150 // die obere Zeile
const S_LY1: u64 = 0x1158 // und die untere
const S_R0: u64 = 0x1160 // die erste beobachtete Signatur oben, +1
const S_R1: u64 = 0x1168 // und die untere, +1
const S_KEIN: u64 = 0x1170 // Ablesungen ohne Signatur an einer Stelle
const S_LPAAR: u64 = 0x1178 // zwei Woerter: die beiden abgelesenen Punkte
const S_LFEST: u64 = 0x1188 // 1 = die Ablesestelle steht fest
const S_RY0: u64 = 0x11A8 // wo der erste Riss gesehen wurde
const S_RY1: u64 = 0x11B0
const S_RFR: u64 = 0x11B8 // und bei welcher Bildnummer
const S_VERWORF: u64 = 0x11C0 // Ablesungen ueber eine Bildgrenze hinweg
// Die drei Zahlen der Vorfuehrung (kgui ruft sie). Sie liegen HIER und
// nicht in `kstate`, weil dort jede Seite gezaehlt ist und diese drei
// nur die Oberflaeche etwas angehen.
const S_VT0: u64 = 0x1190 // Tick, an dem das Halten begann
const S_VSTEP: u64 = 0x1198 // wie weit die Vorfuehrung ist
const S_VWIN: u64 = 0x11A0 // das vorgefuehrte Fenster + 1
const S_ANIMS: u64 = 0x1110 // begonnene Bewegungen
const S_ANFRAMES: u64 = 0x1118 // gezeichnete Zwischenbilder
const S_NOANIM: u64 = 0x1120 // GEGENPROBE: keine Bewegung
const S_TICKS: u64 = 0x1128 // wie oft `anim_tick` lief
// RUNDE ZIEH: DIE MESSWERTE DES AUFHEBENS. `S_SWINGS` zaehlt die
// Ticks, in denen sich ein Nachzug geaendert hat, `S_DRAGPX` die
// Bildpunkte, die dabei skaliert uebertragen wurden. Die zweite Zahl
// ist die, auf die es ankommt: sie sagt, was das Ziehen KOSTET, und
// sie ist im Server gezaehlt und nicht im Bild geraten.
// 0x1208 und 0x1210: der freie Platz hinter S_SZAH (0x1200) und vor
// S_FRUS (0x1300). Die erste Fassung legte sie auf 0x1130/0x1138 --
// dort liegen S_LESER und S_LIEST der Runde VSYNC, und
// tools/paint/scalars.py hat genau das gemeldet, bevor irgendetwas
// gebaut war. Dafuer gibt es das Werkzeug.
const S_SWINGS: u64 = 0x1208
const S_DRAGPX: u64 = 0x1210
// RUNDE ZIEH: DIE BILDZEIT WAEHREND DES ZUGES, GETRENNT GEZAEHLT.
//
// `bildzeit:` mittelt ueber ALLE Bilder eines Laufs -- auch ueber das
// Hochfahren, in dem Schreibtisch, Taskleiste und drei Fenster
// entstehen. GEMESSEN: das Maximum liegt dort bei 51 ms, und zwar
// AUCH mit allen drei Marken auf 0 (ziehpx=0). Diese Zahl kann die
// Ruckelfrage also gar nicht beantworten, weil sie nicht vom Ziehen
// kommt.
//
// Diese vier zaehlen deshalb NUR die Bilder, in denen wirklich ein
// Fenster aufgehoben gemalt wurde -- das ist die Frage, die Justins
// Bedingung stellt ("das Ziehen darf nicht ruckeln").
const S_ZFRN: u64 = 0x1218   // Bilder mit aufgehobenem Fenster
const S_ZFRUS: u64 = 0x1220  // ihre Summe in Mikrosekunden
const S_ZFRMAX: u64 = 0x1228 // die laengste davon
const S_ZFRUE: u64 = 0x1230  // wie viele ueber 16,7 ms lagen
// Wurde in DIESEM Bild ein Fenster aufgehoben gemalt?
const S_ZFLAG: u64 = 0x1238
// UND DAS GEGENSTUECK: die Bilder desselben Laufs OHNE aufgehobenes
// Fenster. Erst der Vergleich BEIDER Zahlen aus DEMSELBEN Lauf sagt,
// was das Ziehen kostet -- eine Bildzeit allein sagt nur, was die
// Maschine gerade kostet.
const S_OFRN: u64 = 0x1240
const S_OFRUS: u64 = 0x1248
const S_OFRMAX: u64 = 0x1250

// ======================================================= RUNDE BLUR
// DIE ZAHLEN DER WEICHZEICHNUNG.
//
// 0x1258..0x12C8 -- der Bereich zwischen S_OFRMAX (0x1250) und S_FRUS
// (0x1300) war frei; `tools/paint/scalars.py` prueft das mechanisch,
// und genau dieses Werkzeug hat in Runde ZIEH eine echte Kollision
// gemeldet, bevor etwas gebaut war.
const S_BLURS: u64 = 0x1258    // wie oft eine Flaeche GERECHNET wurde
const S_BLURCACHE: u64 = 0x1260 // wie oft sie KOPIERT wurde
const S_BLURPX: u64 = 0x1268   // wie viele Bildpunkte gerechnet wurden
const S_BLURUS: u64 = 0x1270   // und wie lange das zusammen dauerte
// ---- der Zwischenspeicher selbst, EINE Flaeche.
//
// WARUM NUR EINE. Gleichzeitig sichtbar sind in der Regel Leiste UND
// Startmenue; zwei Flaechen waeren also der ehrliche Fall. Der Speicher
// dafuer kommt aber aus `mem.frame_run`, und ein zweiter Puffer von
// Schirmbreite mal Menuehoehe ist ein halbes Megabyte, das auf einer
// kleinen Maschine fehlt. Gemessen (siehe BEFUND) traegt EIN Platz die
// Trefferquote schon ueber 90 Prozent, weil die Leiste in fast jedem
// Bild schmutzig ist und das Menue nur, wenn sich darunter etwas regt.
const S_BC_BUF: u64 = 0x1278   // der Puffer, 0 = keiner
const S_BC_BYTES: u64 = 0x1280 // wie gross er ist (ALLE Plaetze zusammen)
// ---- VIER PLAETZE, und das ist eine MESSUNG und keine Meinung.
//
// Die erste Fassung hatte EINEN Platz, mit der Begruendung, die Leiste
// sei ohnehin in fast jedem Bild schmutzig. Auf dem einfachen
// Schreibtisch stimmte das auch: n=2, cache=83, Quote 97 Prozent.
//
// Dann lief die Vorfuehrung mit DREI durchscheinenden Flaechen
// gleichzeitig (Leiste, Startmenue, zweite Leiste), und die Quote fiel
// auf NULL: n=273, cache=0. Der Grund ist nicht der Filter, sondern der
// eine Platz -- jede Flaeche warf die vorige hinaus, und in jedem Bild
// wurden alle drei neu gerechnet. Das ist genau die Sorte Fehler, die
// auf dem Prueftisch nicht auffaellt und auf dem Schreibtisch des
// Menschen jeden Tag zuschlaegt: Leiste UND offenes Menue sind der
// NORMALFALL und nicht der Ausnahmefall.
//
// VIER Plaetze, weil vier die Zahl der Flaechen ist, die ueberhaupt
// gleichzeitig durchscheinen koennen: Leiste, Startmenue, ein
// Klappmenue und eine Blase. Je Platz ein eigener Satz Angaben.
const BC_N: u64 = 4
const S_BC_WIN: u64 = 0x13A0   // je Platz: Fenster + 1, 0 = leer
const S_BC_X: u64 = 0x13C0     // je Platz: das Rechteck
const S_BC_Y: u64 = 0x13E0
const S_BC_W: u64 = 0x1400
const S_BC_H: u64 = 0x1420
// ---- DIE UNGUELTIGKEITSERKLAERUNG, und das ist die schwierige Frage
// dieser Runde.
//
// Woran erkennt der Server, dass sich UNTER der weichgezeichneten
// Flaeche etwas geaendert hat? Nicht daran, dass das Fenster selbst
// schmutzig ist -- die Leiste ist in fast jedem Bild schmutzig, ohne
// dass sich der Schreibtisch darunter geruehrt haette.
//
// Die Antwort ist ein ZAEHLER JE FLAECHE, und er steht auf demselben
// Papier wie die Schmutzrechtecke, die dieser Server ohnehin fuehrt:
//
//   `S_BC_STAMP` ist die Bildnummer, bei der die Flaeche gerechnet
//   wurde. `S_BC_HIT` ist der Zaehler, den `blur_touch` hochzaehlt --
//   und `blur_touch` ruft genau die Stelle, die ein SCHMUTZRECHTECK
//   anmeldet, das die Flaeche SCHNEIDET. Ein Schmutzrechteck, das die
//   Flaeche nicht beruehrt, laesst sie gueltig.
//
// Damit ist die Regel vollstaendig und ohne Raten: kopiert wird, wenn
// Fenster, Rechteck UND Zaehler unveraendert sind. Sonst gerechnet.
const S_BC_STAMP: u64 = 0x1440 // je Platz: Bildnummer der Rechnung
const S_BC_HIT: u64 = 0x1460   // je Platz: Schmutzzaehler beim Rechnen
// Je Platz EIN Zaehler -- vier Woerter, 0x1480..0x14A0.
const S_BC_GEN: u64 = 0x1480
// Welcher Platz als naechstes geraeumt wird, wenn alle belegt sind.
const S_BC_NEXT: u64 = 0x14A0
// Wie gross EIN Platz ist, in Oktetten.
const S_BC_EIN: u64 = 0x14B0
// GEGENPROBE: 1 = der Zwischenspeicher wird NICHT benutzt.
//
// Die Auftragsliste verlangt DREI Zahlen und nicht eine: ohne Blur,
// mit Blur ohne Speicher, mit Blur mit Speicher. Ohne diesen Schalter
// waere die mittlere nicht zu messen, ohne den Speicher auszubauen --
// und eine Zahl aus einem anderen Kern ist keine Gegenprobe.
const S_BC_AUS: u64 = 0x14B8
// Die gleitende Summenzeile des senkrechten Durchgangs. Sie liegt NICHT
// in kdata -- drei Kanaele mal BLUR_W_MAX mal 8 Oktette waeren 82 KiB
// --, sondern kommt aus `mem.frame_run`, neben dem Puffer.
const S_BC_SUM: u64 = 0x14A8   // 3 * BLUR_W_MAX Woerter, 0 = keine
// RUNDE SCHNELLBILD: die SUMME der uebertragenen Bildpunkte, ueber
// alle Bilder. Zusammen mit S_PRESENTS ergibt das den Anteil, den ein
// Bild wirklich anfasst -- die Zahl, die FREMDSOFTWARE.md 4a mit
// "1 bis 5 Prozent" veranschlagt. `present` gibt die Flaeche schon
// zurueck, aber niemand hat sie bisher aufsummiert, und ohne Summe ist
// der Anteil nicht messbar.
// RUNDE MERGE9: 0x11C8 statt 0x1130. Auf 0x1130 liegt seit Runde
// GLYPHE S_LESER (kernel/wm.fi:554) -- die Runde SCHNELLBILD hat
// S_PXSUM auf ihrem Zweig dorthin gelegt, weil die Stelle DORT frei
// war. Zusammengefuehrt schrieben beide dasselbe Wort: der Ableser
// haette die Pixelsumme als "laeuft/laeuft nicht" gelesen und die
// Summe waere bei jedem Anstrich ueberschrieben worden.
// GEMESSEN von tools/paint/run.sh ("Skalare ueberschneiden sich").
// 0x11C8 ist das erste freie Wort hinter S_VERWORF (0x11C0).
const S_PXSUM: u64 = 0x11C8

// ==================================== ZUSAMMENFUEHRUNG VEKTOR + ECHTHARDWARE-5
// BEIDE RUNDEN HABEN SICH DIESELBEN WORTE GENOMMEN.
//
// ECHTHARDWARE-5 legte S_TOUT/S_TPUT (Terminalzaehler) und die fuenf
// Woerter des Kantenziehens auf 0x11D0..0x1200; die Bildzeitmessung
// dieser Runde lag auf DENSELBEN 0x11D0..0x1248. Sechs Worte
// ueberschnitten sich -- 0x11D0, 0x11D8, 0x11E0, 0x11E8, 0x11F0 und
// 0x1200. Das haette keinen Uebersetzungsfehler gegeben, sondern das
// hier: die Bildzeit haette den Ankerwert der gezogenen Kante
// ueberschrieben, und ein Fenster waere beim Ziehen gesprungen,
// waehrend die Bildzeitfaecher Unsinn zeigen. Genau die Sorte Fehler,
// die man auf einem Foto sieht und im Quelltext nicht.
//
// AUFGELOEST ZUGUNSTEN VON ECHTHARDWARE-5 AN SEINER STELLE: dessen
// Zahlen stehen in einem ausgelieferten Abbild und sind auf echtem
// Blech gemessen; die Bildzeitmessung ist juenger und noch in keinem
// Abbild. Sie zieht deshalb auf 0x1300..0x1378 um, wo nichts liegt
// (WM_MAX ist 0x2000). Keine der beiden Runden verliert ein Feld.

// ==================================================== RUNDE ECHTHARDWARE-5
// WIE VIELE OKTETTE IM TERMINALFENSTER ANGEKOMMEN SIND.
//
// Justins Befund B: das Fenster "Terminal -- sh" ist LEER, obwohl die
// Tafel `sh14` meldet -- die Shell laeuft also. Zwischen der Shell und
// der Zeichenflaeche versickert die Ausgabe, und ohne eine Zahl ist
// nicht zu unterscheiden, ob (a) nie ein Oktett hier ankommt, (b) sie
// ankommen und in kein Feld gemalt werden, oder (c) sie gemalt und
// gleich wieder ueberdeckt werden. Diese zwei Zaehler trennen die
// Faelle: `S_TOUT` zaehlt JEDEN Ruf von `term_out`, `S_TPUT` nur die,
// die wirklich eine Zelle gesetzt haben.
const S_TOUT: u64 = 0x11D0
const S_TPUT: u64 = 0x11D8

// ==================================================== RUNDE ECHTHARDWARE-5
// AN WELCHER KANTE DIE GROESSE GEZOGEN WIRD -- UND WOGEGEN.
//
// Justins Befund D: "Ziehen funktioniert nur an der rechten Kante."
// Das stimmte, und es stand so im Quelltext: `on_mouse` nahm nur
// `am_rechts || am_unten` an, und `resize_win` rechnet die neue
// Groesse IMMER aus der linken oberen Ecke (`x - win_x`). Damit KANN
// die linke und die obere Kante nicht gehen -- eine Bewegung nach
// links macht das Fenster dort schmaler statt breiter.
//
// `S_SZEDGE` ist eine Bitmaske: 1 links, 2 rechts, 4 oben, 8 unten.
// Eine Ecke ist zwei Bits gleichzeitig, und genau das macht "beide
// Achsen zugleich" aus. Die vier Ankerwerte halten die
// GEGENUEBERLIEGENDE Kante fest: zieht man links, bleibt rechts stehen,
// und das Fenster springt nicht.
const S_SZEDGE: u64 = 0x11E0
const S_SZAX: u64 = 0x11E8 // die festgehaltene x-Kante (Bildschirm)
const S_SZAY: u64 = 0x11F0 // die festgehaltene y-Kante
const S_SZAW: u64 = 0x11F8 // Breite beim Anfassen
const S_SZAH: u64 = 0x1200 // Hoehe beim Anfassen
// DELL ROUND (04.10.2026): where the pointer stood relative to the grabbed
// edge when the button went down (signed, as u64). The edge then FOLLOWS the
// pointer at that distance. Before, the top edge was set to the pointer
// itself as the top of the CONTENT -- 22 px (the title bar) below the edge
// that was grabbed: a drag of 30 px moved the window top by 8.
const S_SZOFFX: u64 = 0x15E0
const S_SZOFFY: u64 = 0x15E8
// r460 (docs/COMPOSITOR.md S0): THE TIME INSIDE `compose_one`, BY PHASE, in microseconds, summed since the last F12 (printed by
// `bild_say_reset` as `wm: phase ...` and set to zero there). One word each, 0x1600 .. 0x1638.
const S_PH_BG: u64 = 0x1600    // the desktop fill and the tiling bars
const S_PH_WIN: u64 = 0x1608   // every window (`paint_win`), the drag path included
const S_PH_DRAG: u64 = 0x1610  // only the windows painted lifted (`paint_win_drag`)
const S_PH_TOP: u64 = 0x1618   // signature, preview, trusted dialog, pointer, magnifier
const S_PH_PEND: u64 = 0x1620  // `pend_add` / the flush of the frame
const S_PH_PX: u64 = 0x1628    // pixels of the dirty rectangles
const S_PH_N: u64 = 0x1630     // frames counted
const S_PH_BLUR: u64 = 0x1638  // inside `paint_win`: the acrylic blur of a window (`blur_flaeche`)
const S_PH_GLASS: u64 = 0x1640 // inside `paint_win`: the frosted strip under a glass window (`glass_prepare`)
const S_PH_SHADOW: u64 = 0x1648 // inside `paint_win`: the shadow (`paint_shadow`)
// r461 (docs/COMPOSITOR.md S2): THE DAMAGE AS A REGION. `damage` keeps the bounding box (everything else reads it) AND adds the
// rectangle to a list of disjoint rectangles (`fui.region`, up to 16). When the list covers clearly less than the box, `compose_one`
// paints the rectangles one by one: two small changes in two corners cost two small rectangles, not the screen in between.
const S_RLOCK: u64 = 0x1650    // spin lock of the region (`damage` runs on any core, the region is a list)
const S_RBAD: u64 = 0x1658     // set when the lock could not be had: this frame uses the box
const S_RFRAMES: u64 = 0x1660  // frames composed rectangle by rectangle
const S_RSAVED: u64 = 0x1668   // pixels they did not have to paint (box minus region)
const S_STRIPWIN: u64 = 0x1670 // r454: window (index + 1) of the last press on a client strip's drag region, 0 = none
const S_STRIPT: u64 = 0x1678   // r454: the time of that press (mono_ns), for the double click
const S_RGN: u64 = 0x1700      // 65 words: the region (`fui.region`, REGION_WORDS)

const SZ_L: u64 = 1
const SZ_R: u64 = 2
const SZ_T: u64 = 4
const SZ_B: u64 = 8

// ---------------------------------------------- RUNDE VEKTOR: DIE BILDZEIT
//
// Bis hierher gab es KEINE Zahl fuer "wie lange dauert ein Bild". Es
// gab die Zahl der Bilder und die der Bildpunkte, aber nicht die Zeit
// -- und damit liess sich die Auflage "kein Bild ueber 16 ms" weder
// vorher noch nachher belegen, sondern nur behaupten.
//
// Gemessen wird um `compose` herum, also um das Zusammensetzen des
// Bildes: Hintergrund, Fenster, Leiste, Zeiger. Die Uhr ist der
// Zyklenzaehler (`time.tsc`), umgerechnet ueber `time.khz`.
//
// Vier Zahlen, weil ein Mittelwert allein den schlimmsten Fall
// versteckt -- und der schlimmste Fall ist der, den ein Mensch als
// Ruckeln sieht.
const S_FRUS: u64 = 0x1300    // Summe der Bildzeiten in Mikrosekunden
const S_FRN: u64 = 0x1308     // wie viele Bilder darin stecken
const S_FRMAX: u64 = 0x1310   // die laengste Bildzeit
const S_FRLAST: u64 = 0x1318  // die letzte Bildzeit
// Wie viele Bilder ueber 16 ms lagen. Die Auflage dieser Runde in
// einer Zahl: sie MUSS null bleiben.
const S_FRUEBER: u64 = 0x1320
// Ein Histogramm, acht Faecher, je eine Verdoppelung: <1ms, <2, <4,
// <8, <16, <32, <64, darueber. Ein Mittelwert und ein Groesstwert
// sagen nicht, OB die langen Bilder am Anfang stehen (Moduswechsel,
// kalter Zwischenspeicher) oder mitten im Betrieb -- und genau das
// ist der Unterschied zwischen "faellt niemandem auf" und "ruckelt".
const S_FRH: u64 = 0x1330      // acht Worte, 0x1330..0x1368
// Die laengste Bildzeit NACH den ersten zehn Bildern. Die ersten zehn
// sind der Start: erstes Bild ueberhaupt, erster Moduswechsel, erste
// Schrift. Was danach kommt, ist der Betrieb.
// RUNDE WMPLUGIN: DIE VON EINEM PLUGIN GESCHLUCKTE TASTE.
// S_KSWAL ist ein EINSCHUSS-Merker: `on_key` setzt ihn, wenn ein
// Kuerzel einem Plugin gehoert, und `key_tty` liest und loescht ihn
// gleich darauf. Ohne ihn ginge die Taste zwar an kein Fenster mehr,
// aber immer noch an das Terminal des Fokusfensters -- und damit an
// die Shell darin. Halb geschluckt ist nicht geschluckt.
const S_KSWAL: u64 = 0x1380
const S_KPLUG: u64 = 0x1388 // wie viele Tasten ein Plugin bekam
const S_SWTICK: u64 = 0x1390 // Tick des letzten Kehrbesens
// RUNDE GPU (G-012): welche Zeigerform zuletzt an das Geraet ging.
// Getrennt von S_SHAPE, weil der Vergleich genau der Punkt ist, an
// dem entschieden wird, ob das BILD neu hinaus muss oder nur der Ort.
const S_HWSHAPE: u64 = 0x1398
const S_FRMAXW: u64 = 0x1370
const S_FRUEBERW: u64 = 0x1378
// ====================================================== RUNDE GLAS
//
// NEUNZEHN WOERTER AB 0x1500, UND WARUM NICHT MEHR AB 0x13A0.
//
// Auf dem Zweig GLAS stand hier "siebzehn Woerter ab 0x13A0, und dort
// ist wirklich Platz". Das stimmte auf jenem Zweig und ist beim
// Zusammenfuehren falsch geworden: die Runde BLUR hat mit derselben
// Begruendung denselben Platz belegt. Ihr Zwischenspeicher ist ein
// FELD mit vier Plaetzen und einem Abstand von 0x20 je Platz
// (S_BC_WIN 0x13A0, S_BC_X 0x13C0, S_BC_Y 0x13E0, S_BC_W 0x1400,
// S_BC_H 0x1420) und reicht bis 0x14BF -- fuenf der Glaszahlen lagen
// Wort auf Wort darauf. Zwei Runden, die unabhaengig voneinander
// dieselbe Luecke gesehen haben, und kein Werkzeug, das zwei ZWEIGE
// gegeneinander haelt.
//
// Die Glaszahlen wandern, nicht das Feld: ein Feld mit Abstand laesst
// sich nicht ohne Rechnung verschieben, neunzehn Skalare schon. Ab
// 0x1500 ist frei -- der Blockspeicher endet bei 0x14B8, WM_MAX sind
// 0x2000. `tools/paint/scalars.py` rechnet es nach.
//
// S_GLASSGEN ist die BILDRUNDENNUMMER DES UNTERGRUNDS und nicht die
// des Bildes: sie steigt genau dann, wenn in dieser Runde etwas UNTER
// der Leiste gemalt wurde. Die Uhr in der Leiste laeuft jede Sekunde
// und macht Schmutz, ohne dass sich unter der Leiste etwas aendert --
// ohne diese Trennung waere das Milchglas sechzigmal in der Sekunde neu
// gerechnet worden, obwohl dasselbe herausgekommen waere.
const S_GLASSGEN: u64 = 0x1500 // Stand des Untergrunds
const S_GLGEN: u64 = 0x1508 // fuer welchen Stand der Streifen gilt
const S_GLVALID: u64 = 0x1510 // 0 = der Streifen ist ungueltig
const S_GLX: u64 = 0x1518 // und fuer welches Rechteck
const S_GLY: u64 = 0x1520
const S_GLW: u64 = 0x1528
const S_GLH: u64 = 0x1530
const S_GLR: u64 = 0x1538 // und fuer welchen Weichzeichnerradius
const S_GLUS: u64 = 0x1540 // Summe der Weichzeichnerzeiten in us
const S_GLN: u64 = 0x1548 // wie viele Laeufe darin stecken
const S_GLMAX: u64 = 0x1550 // der laengste Lauf
const S_GLLAST: u64 = 0x1558 // der letzte
const S_GLHIT: u64 = 0x1560 // Treffer des Zwischenspeichers
const S_GLRUN: u64 = 0x1568 // Anfragen an ihn insgesamt
// WIE OFT DIE SCHLIERENREGEL ZUGETROFFEN HAT. Ohne diese Zahl waere
// "beim Verschieben bleiben keine Schlieren stehen" eine Behauptung
// ueber eine Regel, von der niemand weiss, ob sie je gelaufen ist.
const S_PANELGROW: u64 = 0x1570
const S_GLSAY: u64 = 0x1578 // Laeufe seit der letzten Meldezeile
const S_GLTEST: u64 = 0x1580 // bestandene Zusagen von `selftest_glas`
// GEGENPROBE: die Schlierenregel abgeschaltet (`noglasgrow`).
const S_NOGROW: u64 = 0x1588
// ================================================ RUNDE GLAS (NACHTRAG)
// WIE WEIT EIN FENSTER WIRKLICH UNTER DER LEISTE STAND, in Bildpunkten
// der groessten je gemessenen Schnittflaeche.
//
// Die Zusage "nach einem Zug unter der Leiste bleiben keine Schlieren"
// wurde mit `diff 0` belegt -- und `diff 0` kommt auch dann heraus,
// wenn das Fenster die Leiste nie beruehrt hat. Genau das war der Fall:
// der Zug der Abnahme fasste den oberen RAHMEN und veraenderte die
// Groesse, statt das Fenster zu bewegen. Diese Zahl ist die Gegenprobe
// dazu; sie steht in `wm: schlieren ... unterpx=`.
const S_UNTERPX: u64 = 0x1590

// ------------------------------- RUNDE VEKTOR: DIE ZEICHEN LIEGEN FERTIG
//
// Ein Fensterzeichen ist in jedem Bild dasselbe: dieselbe Form,
// dieselbe Groesse, dieselbe Kantenglaettung. Es JE BILD neu zu
// rastern -- Bezier zerlegen, Kanten bauen, vier Abtastzeilen je
// Bildzeile -- ist Arbeit, deren Ergebnis schon dasteht.
//
// GEMESSEN, warum das noetig ist: ohne diesen Speicher stieg bei
// 2560x1440 und Vervielfachung 2 die mittlere Bildzeit von 4234 auf
// 5211 Mikrosekunden, und im Betrieb rutschten sechsundzwanzig Bilder
// aus dem Fach 4..8 ms in das Fach 8..16 ms. Die Formen sind billig,
// aber sie sind es NICHT dreimal je Fenster und Bild.
//
// Vier Zeichen: Minimieren, Maximieren, Wiederherstellen, Schliessen.
// Je Zeichen die Deckung als ein Oktett pro Bildpunkt, hoechstens
// 40x40 (10 * Vervielfachung 4).
const CG_N: u64 = 4
// RUNDE KERN-FUI: EIN FACH HAELT JETZT VIER OKTETTE JE BILDPUNKT.
//
// `fui.core` schreibt BGRX (`core.put`), also vier Oktette -- es in ein
// Oktett je Punkt malen zu lassen ginge nur, indem man `core.fi` eine
// zweite Ablage beibringt, und das waere wieder die zweite Umsetzung,
// die diese Runde gerade abschafft. Also bekommt fUi, was es erwartet,
// und der Puffer waechst von 6400 auf 25 600 Oktette.
//
// Nach dem Rastern wird das Fach an Ort und Stelle auf ein Oktett je
// Punkt eingedampft (`cg_dampf`) -- das Uebertragen laeuft je BILD und
// liest dann ein Viertel.
const CG_KANTE: u64 = 40      // 10 * Vervielfachung 4
const CG_FACH: u64 = 6400     // 40 * 40 * 4 Oktette je Zeichen
const CG_MAX: u64 = 1600      // 40 * 40 Punkte

// RUNDE VEKTOR: die vier gerasterten Zeichen. `cg_gr` ist die
// Kantenlaenge, mit der sie gerastert wurden -- wechselt die
// Vervielfachung, gilt der Speicher nicht mehr.
static mut cg_deck: [u8; 25600] = [0 as u8; 25600]
static mut cg_gut: [u64; 4] = [0 as u64; 4]
static mut cg_gr: u64 = 0
static mut cg_w: [u64; 4] = [0 as u64; 4]
static mut cg_h: [u64; 4] = [0 as u64; 4]
static mut cg_treffer: u64 = 0
static mut cg_bauten: u64 = 0

// Die Arten einer Fensterbewegung. Oeffnen waechst, Schliessen und
// Minimieren schrumpfen -- der Unterschied zwischen den letzten beiden
// liegt NICHT im Bild, sondern darin, was danach passiert.
const AN_OPEN: u64 = 1
const AN_CLOSE: u64 = 2
const AN_MIN: u64 = 3
// Ein Tick sind zehn Millisekunden, weil `time.TICK_HZ` 100 ist. Die
// Zahl steht hier als Konstante und nicht als Division im Quelltext,
// damit ein Takt von 250 Hz an EINER Stelle nachgezogen wird.
const MS_PRO_TICK: u64 = 10
// Die Vorgabe, wenn keine Formmarke da ist: MO_FAST aus wlibc.
const MOTION_DEF: u64 = 120
const MOTION_MAX: u64 = 500
// Wie hoch der Signaturstreifen ist. Vier Zeilen sind im PPM sicher zu
// finden und im Bild klein genug, um den Rest nicht zu verdecken.
const SIG_H: u64 = 4
// Wie klein ein Fenster am Anfang der Oeffnungsbewegung ist, in
// Tausendsteln. 850 heisst: es waechst aus 85 Prozent heraus -- der
// Sprung, den man sieht, ohne dass es zappelt.
const AN_SCALE0: u64 = 850
const SHMASK_SIDE: u64 = 40
// RUNDE BLUR: 12 -> 15. Drei Marken mehr (FM_BLUR, FM_BLURTINT,
// FM_BLURNOISE). ZUSAMMENFUEHRUNG MIT DER RUNDE GLAS: 15 -> 18, denn
// deren drei Plaetze (FM_TB_ALPHA, FM_WIN_ALPHA, FM_GLASS_KEY) haengen
// hinten an. Einen VIERTEN hatte GLAS fuer ein eigenes Milchglas
// vorgesehen -- der faellt weg, weil `FM_BLUR` dieses Systems der eine
// Weichzeichner ist. Wer hier etwas aendert, aendert `wlibc.FORM_SLOTS`
// mit -- die beiden Listen halten `tools/paint/run.sh` gegeneinander.
const FORM_SLOTS: u64 = 22
// r402 (DECO): THE THREE MEASURES OF THE WINDOW CHROME ARE SHAPE NUMBERS NOW.
//
// Until here the title bar (22), the frame (2) and the caption button (30) were three
// constants; `osum.shape` could not ask for a Windows 11 bar (32 high, buttons 46 wide, a
// one point frame). They go the same way as the radius and the shadow: resolved in ring 3, one
// number each, 0 = "never said" = the constants of the old stand (so `classic` and `modern`
// draw octet for octet what they drew). All three are in DESIGN POINTS and grow with
// `uisc`. The numbers are a contract with `sys.WF_*` and `wlibc.WF_*`.
//   FM_TITLE_BAR  the height of the bar itself (the part that carries title and buttons);
//                 the old stand is 19 (= 22 - 1 separator - 2 frame)
//   FM_CAP_W      the width of ONE caption button (30 before; Windows 11: 46)
//   FM_FRAME      the frame at left, right and below (2 before; Windows 11: 1)
const FM_TITLE_BAR: u64 = 18
const FM_CAP_W: u64 = 19
const FM_FRAME: u64 = 20
// W-S: edge highlight of a blurred surface (start menu, menus, popups): percent of white mixed into the outermost top row and the
// two side columns, 0..RIM_MAX. 0 = none. Stored in the blur cache together with the picture.
const FM_BLURRIM: u64 = 21
const RIM_MAX: u64 = 60
const FM_RADIUS: u64 = 0 // Eckenradius des Fensterrahmens, 0 = eckig
const FM_SHADOW: u64 = 1 // Staerke des Schattens, 0..100, 0 = keiner
const FM_SHADOW_R: u64 = 2 // wie weit er reicht, in Bildpunkten
const FM_SHADOW_C: u64 = 3 // seine Farbe, 0xRRGGBB
// RUNDE SOFTUI: DER SCHATTEN DES UNSCHARFEN FENSTERS.
//
// Das ist die eine Stelle, an der man den Fokus SIEHT, ohne dass eine
// Titelleiste dafuer knallblau sein muss: das aktive Fenster steht
// hoeher ueber dem Schreibtisch als die anderen. Zwei Zahlen und nicht
// eine, weil "tiefer" beides ist -- dunkler UND weiter.
const FM_SHADOW2: u64 = 4 // Staerke unter einem unscharfen Fenster
const FM_SHADOW_R2: u64 = 5 // und wie weit die reicht
// Der Verlauf der Titelleiste, in Helligkeitsstufen ueber die ganze
// Hoehe. 0 = Volltonfarbe, also genau das Bild vor dieser Runde.
const FM_GRAD: u64 = 6
// 0 = das alte Schliessfeld (ein rotes Quadrat mit Kreuz), 1 = die
// drei Windows-Schaltflaechen rechts oben.
const FM_CAPTION: u64 = 7
// RUNDE VSYNC: DIE DAUER EINER FENSTERBEWEGUNG, in Millisekunden.
// Sie kommt aus derselben Quelle wie alle anderen Formmarken -- die
// Taskleiste schickt sie beim Start --, damit "Animationen reduzieren"
// EINE Stelle hat und nicht zwei. 0 heisst SOFORT FERTIG und nicht
// uebersprungen: der Endzustand wird in beiden Faellen erreicht.
// Vorgabe ist MO_FAST aus wlibc (120 ms), siehe DESIGN-2.
const FM_MOTION: u64 = 8
// ======================================================= RUNDE ZIEH
// DAS AUFHEBEN BEIM VERSCHIEBEN -- DREI WIRKUNGEN, DREI MARKEN.
//
// Justins Wunsch war ausdruecklich, dass er damit SPIELEN kann: "jede
// der drei Wirkungen einzeln schaltbar plus Staerke regelbar". Deshalb
// ist es NICHT eine Marke "Ziehanimation an/aus" mit drei fest
// verdrahteten Wirkungen, sondern drei Zahlen, und jede ist zugleich
// der Schalter UND der Regler: 0 heisst aus, sonst ist die Zahl die
// Staerke. Eine Marke weniger, ein Zustand weniger, der auseinander
// laufen kann -- dieselbe Regel wie bei FM_SHADOW (0 = kein Schatten).
//
// FM_LIFT  wie viel groesser das Fenster am Zeiger wird, in
//          Tausendsteln ueber 1000. 50 sind also 105 Prozent -- genau
//          die Zahl, auf der die Kostenmessung der Auftragsliste
//          steht (1,04 ms fuer 900x650).
// FM_TILT  wie stark der Pivot an der ANGEFASSTEN Stelle liegt statt
//          in der Mitte, 0..100 Prozent. 100 heisst: die Stelle unter
//          dem Zeiger bleibt exakt unter dem Zeiger, das Fenster
//          waechst ausschliesslich von ihr weg. Das ist die
//          Naeherung an eine Kippung, die dieser Server leisten kann
//          -- eine echte Drehmatrix kann er nicht, und eine halbe
//          waere ein Bild, das niemand bestellt hat.
// FM_SWING wie stark die Traegheit nachzieht, 0..100. Sie wirkt auf
//          den VERSATZ des Bildes gegen die wahre Fensterlage, nicht
//          auf die Lage selbst: das Fenster steht, wo der Zeiger es
//          hinzieht, und nur sein Bild haengt hinterher. Alles andere
//          waere ein Fenster, das man nicht mehr zielgenau ablegen
//          kann.
const FM_LIFT: u64 = 9
const FM_TILT: u64 = 10
const FM_SWING: u64 = 11

// ======================================================= RUNDE BLUR
// DIE WEICHZEICHNUNG HINTER DER FLAECHE -- UND WARUM SIE DREI MARKEN
// HAT UND NICHT EINE.
//
// Justin, mehrfach: "der Blur wie in Windows ist nicht drin". Was
// Windows Acryl nennt, sind DREI Dinge uebereinander, und man sieht
// sofort, wenn eines fehlt:
//
//   1. die WEICHZEICHNUNG dessen, was dahinter liegt,
//   2. eine TOENUNG darueber (sonst liest sich keine Schrift darauf),
//   3. ein feines RAUSCHEN (sonst wirkt es wie Milchglas und nicht
//      wie Acryl -- das ist der Unterschied, den man sieht, ohne ihn
//      benennen zu koennen).
//
// Drei Marken also, und jede ist wieder Schalter UND Regler -- 0 heisst
// aus. Dieselbe Regel wie FM_SHADOW und wie die drei der Runde ZIEH.
//
// FM_BLUR       der RADIUS des Kastenfilters, 0..16. 0 = kein Blur,
//               und dann kostet diese ganze Runde nichts: `blur_flaeche`
//               kehrt auf der ersten Zeile um.
// FM_BLURTINT   wie stark die Flaeche danach in Richtung ihrer eigenen
//               Farbe gezogen wird, 0..100 Prozent.
// FM_BLURNOISE  die Amplitude des Rauschens in Helligkeitsstufen,
//               0..16.
const FM_BLUR: u64 = 12
const FM_BLURTINT: u64 = 13
const FM_BLURNOISE: u64 = 14

// ====================================================== RUNDE GLAS
//
// DREI PLAETZE MEHR, UND WARUM SIE IM KERN UND NICHT IN RING 3 LIEGEN.
//
// Die Taskleiste ist ein gewoehnliches Fenster ohne Schmuck. Sie malt
// in IHREN Puffer und kann nicht wissen, was unter ihr liegt -- also
// kann sie auch nicht durchsichtig sein. Der einzige Ort, an dem beides
// gleichzeitig vorliegt (die Flaeche der Leiste UND der schon fertig
// gemalte Untergrund), ist die Zeile in `paint_win`, die den einen
// Puffer in den anderen kopiert. Deshalb stehen diese Zahlen hier.
//
// DIE NUMMERN SIND EIN VERTRAG: `sys.WF_TB_ALPHA` bis `sys.WF_GLASS_KEY`
// tragen dieselben Werte, und `tools/themestore/run.sh` haelt die beiden
// Listen gegeneinander. Wer eine aendert, aendert beide im selben Commit.
//
// ZUSAMMENFUEHRUNG: DIESE ZAHLEN SIND 15/16/17 UND NICHT 9/10/12.
// Auf dem Zweig GLAS standen sie auf 9, 10 und 12, weil dort die
// Runden ZIEH und BLUR fehlten. Auf main liegen dort FM_LIFT, FM_TILT,
// FM_SWING (9..11) und das Acryl (12..14). Eine Formmarke ist eine
// NUMMER auf einer Leitung, kein Name -- also wandern die drei ans
// Ende, und `sys.WF_*` wandert im selben Commit mit.
//
// UND DER VIERTE PLATZ VON GLAS IST WEG. Er hiess dort `FM_BLUR` und
// trug den Radius eines eigenen Milchglases unter der Leiste. Zwei
// Weichzeichner nebeneinander waeren zwei Orte fuer dieselbe Sache --
// das Milchglas der Leiste liest seinen Radius jetzt aus `FM_BLUR`
// der Runde BLUR (Platz 12), und der Regler, den Justin sieht, ist
// der des Acryls.
const FM_TB_ALPHA: u64 = 15 // Deckkraft der Taskleiste in Prozent, 0..100
const FM_WIN_ALPHA: u64 = 16 // Deckkraft gewoehnlicher Fenster, 0..100
// Die Farbe, mit der Ring 3 die Leistenflaeche ausgefuellt hat. Sie ist
// die SCHLUESSELFARBE des Abstandsalphas in `glass_mix`: nur was ihr
// gleicht, wird durchsichtig, Schrift und Symbole bleiben deckend.
const FM_GLASS_KEY: u64 = 17 // 0xRRGGBB
// Die Obergrenzen. Sie stehen hier und nicht beim Aufrufer, weil ein
// Radius von 4000 den Rahmen nicht rund macht, sondern den Server in
// eine Schleife ueber vier Millionen Eckpunkte schickt.
const RADIUS_MAX: u64 = 24
const SHADOW_MAX: u64 = 16
// ======================================================= RUNDE ZIEH
// DIE OBERGRENZEN, UND WARUM SIE SO NIEDRIG SIND.
//
// LIFT_MAX = 120, also hoechstens 112 Prozent. Die Kostenmessung der
// Auftragsliste sagt: 900x650 unskaliert kopieren kostet 0,18 ms,
// dasselbe auf 105 Prozent skaliert 1,04 ms von 16,7 ms Budget. Die
// Kosten wachsen mit der FLAECHE, und 112 Prozent sind 1,25 mal die
// Flaeche von 100. Wer mehr will, bezahlt es mit dem Bild.
//
// TILT_MAX und SWING_MAX sind 100, weil beide Prozente sind. Bei
// TILT = 100 bleibt der angefasste Punkt exakt stehen; mehr hat
// keine Bedeutung. Bei SWING = 100 ist der Nachzug so gross, wie
// diese Runde ihn ohne sichtbares Zappeln gemessen hat.
const LIFT_MAX: u64 = 120
const TILT_MAX: u64 = 100
const SWING_MAX: u64 = 100

// ======================================================= RUNDE BLUR
// DIE DECKEL, UND WARUM SIE GENAU HIER LIEGEN.
//
// BLUR_MAX = 16. Die Kosten des Kastenfilters haengen NICHT am Radius
// (die gleitende Summe kostet je Bildpunkt eine Addition und eine
// Subtraktion, gleich ob der Radius 2 oder 200 ist) -- der Deckel steht
// aus einem anderen Grund da: `n` = 2r+1 geht in die Kehrwerttafel
// `RECIP`, und die ist fuer n <= 33 als EXAKT nachgewiesen
// (tools/blur/kehrwert.py, alle n, alle Summen). 16 ist der groesste
// Radius, der diese Zusage haelt.
//
// TINT_MAX = 100, weil es Prozente sind. NOISE_MAX = 16: darueber ist
// es kein feines Korn mehr, sondern Griesel.
const BLUR_MAX: u64 = 16
const TINT_MAX: u64 = 100
const NOISE_MAX: u64 = 16
// Wie viele Summen die gleitende Zeile fasst -- die groesste Breite,
// die dieser Server je weichzeichnet. Eine Taskleiste ist so breit wie
// der Schirm; 3440 deckt auch Justins breiten Schirm ab.
const BLUR_W_MAX: u64 = 3440
// Der Nenner der Kehrwerttafel. 19 ist die Zahl, die `probe2` ueber
// ALLE n (1..33) und ALLE Summen (0..n*255) als fehlerfrei gemessen
// hat -- mit 16, 20 und 24 blieb ein Fehler von einer Stufe stehen,
// und eine Stufe ist auf einer weichgezeichneten Flaeche genau das,
// was man als Streifen sieht.
const RECIP_SHIFT: u64 = 19
const RECIP_RUND: u64 = 262144 // 1 << 18
// Wie weit das Bild beim Nachziehen HOECHSTENS hinter dem Fenster
// zurueckbleiben darf, in Bildpunkten. Ohne diesen Deckel wird aus
// einer schnellen Zeigerbewegung ein Fenster, dessen Bild quer ueber
// den Schirm nachsegelt -- und aus einem Schmuck ein Fehler.
const SWING_MAX_PX: i64 = 48
// Die Federkonstante des Auspendelns, in Tausendsteln je Tick. Bei
// TICK_HZ = 100 zieht sich der Versatz damit je Tick um ein Viertel
// zusammen: nach zehn Ticks (100 ms) ist er auf 5,6 Prozent. Das ist
// das Auspendeln, das Justin bestellt hat -- kein Schwingen um den
// Nullpunkt, sondern ein Nachlassen. Ein echter Federschwinger
// braeuchte eine zweite Zustandsgroesse (die Geschwindigkeit) je
// Fenster und wuerde bei der Zeigerabtastrate dieses Servers
// ueberschwingen, was wie ein Wackelkontakt aussieht.
const SWING_DECAY: u64 = 250
// ====================================================== RUNDE GLAS
// UND DIE UNTERGRENZE DER DECKKRAFT, und sie ist keine Bevormundung.
// Eine Leiste mit 5 Prozent Deckung ist keine Einstellung, sondern ein
// Fehlerbild: man sieht sie nicht mehr, ihre Schrift steht ohne Grund
// im Hintergrundbild, und die Zusage "4,5:1" der Runde THEME waere auch
// mit dem Abstandsalpha nicht mehr zu halten. 20 Prozent ist die Zahl,
// bei der ein heller Grund unter dunkler Schrift noch als Flaeche
// erkennbar bleibt (gemessen in docs/RUNDE-GLAS.md).
const ALPHA_MIN: u64 = 20
// ============================================== RUNDE GLAS (NACHTRAG 2)
// UND JETZT IST AUCH DIE ZAHL DER LEISTE NULL.
//
// Der Kommentar dazu stimmte, solange die Leiste keine Textplatte
// hatte. Sie hat eine: ihre Schrift geht wie jede andere Schrift von
// Ring 3 durch `wlibc.text_at`, und die setzt `PLATTE` in jeden
// Bildpunkt, auf dem ein Buchstabe steht. Damit traegt die Leiste ihre
// Lesbarkeit an derselben Stelle wie ein Fenster -- unter der Schrift
// und nicht ueber der ganzen Flaeche.
//
// Was die 40 Stufen wirklich bewirkt haben, steht im Dateinamen einer
// Aufnahme dieser Runde: `11-dunkles-bild-leiste-soll40-wirkt82`. Der
// Regler sagte 40 Prozent, die Leiste stand bei 82, und ein Regler,
// der um mehr als das Doppelte luegt, ist kein Regler. Justin hat
// ausdruecklich eine WIRKLICH durchsichtige Leiste bestellt.
const SCHLEIER: u64 = 0
// UND DIESELBE ZAHL FUER EIN GEWOEHNLICHES FENSTER.
//
// Auch hier ist die Deckung dorthin gewandert, wo sie hingehoert:
// UNTER DIE SCHRIFT. Ring 3 setzt `PLATTE_MARKE` in jeden Bildpunkt,
// auf dem Schrift steht (kernel/user/wlibc.fi, `platte`), und
// `glass_mix` nimmt einen markierten Bildpunkt unveraendert. Damit ist
// die Zeile deckend und die Flaeche zwischen den Zeilen so
// durchsichtig, wie der Regler sagt.
//
// Die Konstante bleibt stehen (statt an den Aufrufstellen zu
// verschwinden), weil `tools/themestore/glascheck.py` dieselbe Zahl
// fuehrt und die Abnahme beide gegeneinander haelt: wer hier eine Zahl
// einsetzt, muss sie dort auch einsetzen, sonst wird der Lauf rot.
const SCHLEIER_WIN: u64 = 0
// Die Marke der Textplatte, in den oberen acht Bit eines Bildpunktes
// des Fensterpuffers. Sie steht wortgleich in kernel/user/wlibc.fi
// (`const PLATTE`) -- Ring 3 setzt sie, Ring 0 liest und entfernt sie,
// und `tools/themestore/run.sh` haelt die beiden Zahlen gegeneinander.
const PLATTE_MARKE: u64 = 0x01000000
// RUNDE SOFTUI: die Obergrenze des Titelverlaufs, in Helligkeitsstufen.
const GRAD_MAX: u64 = 24
// Die drei Schaltflaechen rechts oben, in der Reihenfolge, in der sie
// dort stehen. DIE ZAHLEN SIND EIN PROTOKOLL: `cap_hover` gibt
// (Fenster * 4 + n) + 1 zurueck, und tools/softui/ liest sie.
const CAP_MIN: u64 = 0 // Minimieren -- ein waagerechter Strich
const CAP_MAX: u64 = 1 // Maximieren -- ein Quadrat
const CAP_CLOSE: u64 = 2 // Schliessen -- ein Kreuz
const CAP_N: u64 = 3
// Die Breite einer Schaltflaeche. Windows 11 nimmt 46 auf 1920; hier
// sind es 800 Bildpunkte Schirmbreite und Fenster ab 300, also ist die
// Flaeche auf 30 x (TITLE_H - 2*BORDER) heruntergerechnet -- immer noch
// ein groesseres Ziel als das 14 x 14 grosse Schliessfeld davor.
const CAP_W0: u64 = 30
const DK_FRAME: u64 = 0
const DK_TITLE: u64 = 1
const DK_TEXT: u64 = 2
const DK_FRAME_ON: u64 = 3
const DK_TITLE_ON: u64 = 4
const DK_TEXT_ON: u64 = 5
const DK_CLOSE: u64 = 6
const DK_CLOSE_MARK: u64 = 7
// Drei weitere Flaechen, die der Server selbst faerbt: der Grund unter
// allen Fenstern (sichtbar, solange kein Schreibtisch laeuft) und die
// beiden Farben eines Terminalfensters.
//
// NICHT DABEI IST DER MAUSZEIGER. Er bleibt weiss mit schwarzem Rand,
// und zwar mit Absicht: er liegt ueber den Bildpunkten der Anwendung,
// und was dort steht, bestimmt kein Thema. Ein Zeiger, der sich mit dem
// Thema faerbt, ist ein Zeiger, den man auf dem falschen Bild verliert.
const DK_DESK: u64 = 8
const DK_TERM_FG: u64 = 9
const DK_TERM_BG: u64 = 10
// Die Bitmaske einer 24-Bit-Farbe. Sie hat einen Namen, damit
// tests/theme/rawcolour.py sie nicht als Farbe zaehlt -- und weil eine
// Maske, die wie eine Farbe aussieht, es verdient, eine zu heissen.
const RGB24: u64 = 0x00FFFFFF
// Die groesste Strebe, die ein Fenster anmelden darf. Sie steht hier,
// weil 0xFFFFFF mitten in einer Bedingung wie eine Farbe aussieht und
// keine ist.
const STRUT_MAX: u64 = 0x00FFFFFF
// Die beiden Prueffarben des Selbsttests. Sie faerben nichts, was ein
// Mensch sieht: sie werden geschrieben und wieder gelesen.
const PROBE_IN: u64 = 0x0000FF00
const PROBE_OUT: u64 = 0x00FF0000
// DER MAUSZEIGER IST ABSICHTLICH THEMENFREI. Er liegt ueber den
// Bildpunkten der Anwendung, und was dort steht, bestimmt kein Schema
// -- ein Foto, ein Terminal, ein Spiel. Weiss mit schwarzem Rand ist
// auf jedem Grund zu sehen; eine Zeigerfarbe aus dem Thema ist eine,
// die man auf dem falschen Bild verliert. Deshalb stehen diese beiden
// Werte hier und werden nicht ueber WM_DECO gesetzt.
const CURSOR_BODY: u64 = 0x00FFFFFF
const CURSOR_EDGE: u64 = 0x00000000

// ein Fenster
const W_USED: u64 = 0x00
const W_ID: u64 = 0x08
const W_OWNER: u64 = 0x10
const W_X: u64 = 0x18 // AUSSEN, oben links
const W_Y: u64 = 0x20
const W_W: u64 = 0x28 // die Malflaeche, ohne Rahmen
const W_H: u64 = 0x30
const W_BUF: u64 = 0x38
const W_BUFBYTES: u64 = 0x40
const W_Z: u64 = 0x48
const W_KIND: u64 = 0x50
const W_COLS: u64 = 0x58
const W_ROWS: u64 = 0x60
const W_CX: u64 = 0x68
const W_CY: u64 = 0x70
// Terminal grid: six planes (characters, attributes, colours, and the same three for the saved main screen), each one holds
// TG cells. 16384 cells = 192 x 85, enough for a 1920 x 1080 window with a 10 x 19 cell (r468: the old 4096 cut the screen
// of a maximised terminal after 21 rows).
const TG: u64 = 16384
const TG_FRAMES: u64 = 24
const TG_ALT_WORDS: u64 = 6144
const W_GRID: u64 = 0x78
const W_EHEAD: u64 = 0x80
const W_ETAIL: u64 = 0x88
const W_FG: u64 = 0x90
const W_BG: u64 = 0x98
const W_CELLW: u64 = 0xA0
const W_CELLH: u64 = 0xA8
// 0xB8 und NICHT 0xA8: dort liegt W_CELLH. Die erste Fassung nahm 0xA8,
// und die Zahl der Tastenereignisse des Terminalfensters war danach
// genau seine Zellenhoehe -- neunzehn, ohne dass eine Taste gedrueckt
// worden waere. Dieselbe Sorte Fehler wie Runde K7B, eine Ebene tiefer.
const W_KEYS: u64 = 0xB8
const W_TTY: u64 = 0xB0 // Runde K10: das Terminal + 1, 0 = keines
const W_TITLE: u64 = 0xC0 // 32 Oktette, bis 0xE0
// RUNDE DESKTOP: die beiden letzten freien Woerter des Satzes. Der
// Satz ist 256 Oktette lang, der Titel endet bei 0xE0 -- vier Woerter
// waren frei, zwei sind es noch.
const W_LAYER: u64 = 0xE0 // L_DESK, L_NORMAL oder L_TOP
const W_FLAGS: u64 = 0xE8 // F_HIDDEN | F_NODECO | F_MAXIMIZED
// ADDENDUM TASKBAR: the last two free words of the record. After this
// the 256 octets are full; the next round that needs a field has to
// enlarge WIN_BYTES, and that moves the window table (see `wat`).
//   W_STRUT  0 = this window reserves nothing.
//            otherwise (edge + 1) | (size << 8).
//   W_SAVE   the rectangle to go back to when a maximized window is
//            restored: x, y, w, h packed into four 16-bit fields, the
//            two coordinates biased by 4096 because a window may sit
//            at a negative one.
const W_STRUT: u64 = 0xF0
const W_SAVE: u64 = 0xF8
// RUNDE TILING, IN EINEN GROESSEREN SATZ. Diese Runde hatte 0xE0, 0xE8,
// 0xF0 und 0xF8 genommen -- dieselben vier Woerter, die DESKTOP und der
// Taskleisten-Nachtrag schon belegt haben, mit anderer Bedeutung. Der
// Satz von 256 Oktetten ist damit wirklich voll, und der Nachtrag hat
// aufgeschrieben, was dann zu tun ist: WIN_BYTES wird groesser, und die
// Fenstertafel wandert. WIN_BYTES ist deshalb 512, die Ereignisringe
// liegen ab 0x2000 statt ab 0x1000, und diese Runde bekommt drei
// Woerter im neuen Teil.
const W_NODE: u64 = 0x100 // Knoten im Fensterbaum + 1, 0 = schwebend
// Wohin ein Fenster zurueckkehrt, wenn es den Baum verlaesst. Zwei
// Woerter statt vier: x und y beziehungsweise Breite und Hoehe in je
// zwei Vierteln. Ein Fenster ist hoechstens 2048 gross, das passt.
const W_SAVXY: u64 = 0x108
const W_SAVWH: u64 = 0x110
// ==================================================== RUNDE PAINT
//
// WELCHEM PROGRAMM DIESES FENSTER GEHOERT -- als BUENDELNAME, nicht als
// Titel.
//
// DIE FRAGE, DIE DAHINTER STEHT: "warum sind Start, Terminal und Suchen
// in der Taskleiste keine Symbole?" Die Symbole EXISTIEREN seit Runde
// K15 (`/apps/<name>.osp/symbol`, Format OSYM). Was fehlte, war die
// Verbindung: ein Fenster hatte einen TITEL und sonst nichts, und ein
// Titel ist uebersetzt, vom Programm frei waehlbar und aendert sich
// waehrend des Laufs ("Terminal -- sh").
//
// ZWEI WEGE WAREN MOEGLICH, und die Wahl ist begruendet:
//
//   1. DER SERVER LEITET ES AUS DEM PROGRAMMPFAD AB. Klingt billiger,
//      ist es nicht. Der Pfad steht nirgends im Aufgabensatz; `procfs`
//      liest argv[0] durch die Seitentabelle des FREMDEN Prozesses
//      (`make_cmdline`), also einmal je Fenster und Neuzeichnen. Und er
//      antwortet falsch, wo es darauf ankommt: `/bin/files` und
//      `/bin/explorer` sind DIESELBE Inode (Runde K15), ein Programm
//      kann per Shell-Skript gestartet sein, und `sh` in einem
//      Terminalfenster ist nicht das Programm, das das Fenster besitzt.
//   2. DAS PROGRAMM SAGT ES SELBST, einmal, beim Oeffnen. Das ist, was
//      X11 `WM_CLASS` nennt und Windows `AppUserModelID`, und aus
//      demselben Grund: nur die Anwendung weiss, als was sie auftreten
//      will.
//
// Also (2). Vierundzwanzig Oktette im Fenstersatz, gesetzt ueber
// WM_APP, ausgeliefert in WM_LIST. Wer nichts sagt, bekommt einen
// leeren Namen und die Taskleiste faellt auf reinen Text zurueck --
// dieselbe Regel wie bei Netz und Akku.
const W_APP: u64 = 0x118 // APP_LEN Oktette

// ================= RUNDE MESSTAFEL: WURDE DIESES FENSTER GEMALT ODER NICHT
//
// Justins Taskleiste meldet Erfolg (`rc=0`, richtige Groesse, richtige
// Kante) und ist trotzdem nicht zu sehen. Zwischen "das Fenster gibt es"
// und "die Bildpunkte stehen auf dem Schirm" lagen bisher vier Stufen
// ohne eine einzige Zahl. Diese beiden Zaehler schliessen die groesste
// Luecke davon:
//
//   W_PAINTS  wie oft `paint_win` dieses Fenster wirklich gemalt hat
//   W_PX      wie viele Bildpunkte dabei zusammenkamen
//
// Steht bei der Leiste PAINTS=0, hat `compose` sie UEBERGANGEN -- dann
// ist sie verborgen, nicht in der Stapelfolge, oder ihr Rechteck liegt
// ausserhalb des schmutzigen Bereichs. Steht PAINTS hoch und man sieht
// sie trotzdem nicht, sind die Bildpunkte gemalt und der Fehler liegt
// DAHINTER (Zweitpuffer, Flush, Zeilenabstand). Das ist der Unterschied,
// den kein Foto bisher machen konnte.
//
// 0x118 + APP_LEN endet bei 0x130, WIN_BYTES ist 512 -- der Platz ist da.
const W_PAINTS: u64 = 0x130 // wie oft compose dieses Fenster malte
const W_PX: u64 = 0x138 // und wie viele Bildpunkte dabei herauskamen

// RUNDE VSYNC: DIE BEWEGUNG EINES FENSTERS. Vier Zahlen, und keine
// davon ist eine Dauer in Bildern: `W_AN0` ist der Tick, an dem sie
// begann, `W_ANMS` die zugesagte Dauer in Millisekunden. Erst
// `anim_p` rechnet daraus den Fortschritt -- dieselbe Trennung wie in
// wlib (DESIGN-2), damit ein Kernel mit TICK_HZ=100 und eine
// Bibliothek, die in Millisekunden zusagt, dieselbe Bewegung meinen.
const W_ANK: u64 = 0x140 // Art: 0 keine, AN_OPEN, AN_CLOSE, AN_MIN
const W_AN0: u64 = 0x148 // start time (mono ms, r1135)
const W_ANMS: u64 = 0x150 // zugesagte Dauer in Millisekunden
const W_ANP: u64 = 0x158 // zuletzt gezeichneter Fortschritt, 0..1000
// ================================================== RUNDE VOLLBILD
// WOHIN DAS VOLLBILD ZURUECKKEHRT -- eigene Plaetze, NICHT W_SAVE.
//
// W_SAVE gehoert dem Maximieren. Wuerde das Vollbild denselben Platz
// benutzen, zerstoerte der Weg "maximiert -> Vollbild -> zurueck"
// genau die Zahl, auf die das Maximieren zurueckwill: das Fenster
// kaeme als normales Fenster mit den Massen der Arbeitsflaeche
// heraus, und es waere nicht mehr maximiert. Zwei Zustaende, zwei
// Sicherungen.
const W_FSXY: u64 = 0x160
const W_FSWH: u64 = 0x168
// ===================================================== RUNDE OBERFLAECHE
// WOHIN DAS FENSTER BEIM MINIMIEREN FLIEGT.
//
// Justins Wunsch war ausdruecklich "zum EIGENEN Taskleistenknopf und
// nicht in eine beliebige Ecke". Der Knopf gehoert der Taskleiste, also
// dem Userland -- der Server kennt ihn nicht und soll ihn auch nicht
// erraten. Sie sagt ihn deshalb SELBST (WM_MINRECT), und zwar fuer ein
// FREMDES Fenster, genau wie WM_ACT.
//
// Steht hier nichts (W_MINW == 0), bleibt es beim bisherigen Verhalten:
// mittig schrumpfen. Ein Ziel, das nie gesetzt wurde, darf keine
// Bewegung in die linke obere Ecke werden.
const W_MINXY: u64 = 0x170 // x in den unteren 32 Bit, y in den oberen
const W_MINWH: u64 = 0x178 // Breite unten, Hoehe oben; 0 = kein Ziel
// ======================================================= RUNDE ZIEH
// DER NACHZUG DES BILDES BEIM VERSCHIEBEN.
//
// Zwei VORZEICHENBEHAFTETE Zahlen, als u64 abgelegt und beim Lesen
// nach i64 zurueckgeholt -- `wsv`/`wg` kennen nur u64, und ein
// eigener Speicherweg fuer zwei Zahlen waere ein zweiter Weg, der
// falsch sein kann.
//
// Sie sagen, wie weit das BILD des Fensters hinter seiner wahren Lage
// zurueckhaengt. Die wahre Lage (W_X/W_Y) folgt dem Zeiger ohne jede
// Verzoegerung -- das ist die Bedingung, unter der man ein Fenster
// noch zielgenau ablegen kann. Nur was man SIEHT, laeuft hinterher
// und pendelt aus.
//
// W_DXLAST/W_DYLAST ist die Fensterlage beim letzten Tick. Aus der
// Differenz zur jetzigen faellt die Geschwindigkeit, und aus ihr der
// Nachzug -- ohne dass der Zeigerweg selbst gespeichert werden muss.
const W_SWX: u64 = 0x180 // Nachzug x, als i64 gelesen
const W_SWY: u64 = 0x188 // Nachzug y
const W_DXLAST: u64 = 0x190 // Fensterlage beim letzten Tick
const W_DYLAST: u64 = 0x198
// Der Tick, an dem das Fenster losgelassen wurde, und 0, solange es
// haengt. Daran erkennt `anim_tick`, dass ein Fenster zwar nicht mehr
// gezogen wird, sein Bild aber noch auspendelt -- ohne dafuer eine
// zweite Bewegungsart neben AN_OPEN/AN_CLOSE/AN_MIN zu erfinden. Die
// drei sind ZUSTAENDE des Fensters (es geht auf, es geht zu, es geht
// weg); das Auspendeln ist keiner davon, es ist ein Nachklang.
const W_SWOFF: u64 = 0x1A0
// ======================================================= RUNDE BLUR
// WIE DECKEND DIESES FENSTER IST, 0..255. 0 heisst "wie immer",
// also vollstaendig deckend -- der Wert wird als "Deckung + 1"
// gespeichert, damit ein wiederverwendeter Platz (alles null) das
// alte Verhalten hat.
//
// WARUM ES DAS GEBEN MUSS. Die erste Fassung dieser Runde hat den
// Blur unter der Leiste sauber gerechnet -- und dann hat die Leiste
// ihren eigenen, DECKENDEN Puffer darueber kopiert. Im Bild war von
// der Weichzeichnung nichts zu sehen, obwohl die Zaehler sie belegten
// (n=26, cache=247). Ein Blur, den man nicht sieht, ist keiner.
//
// Acryl ist genau dieses Paar: WEICHZEICHNEN und dann DURCHSCHEINEN
// LASSEN. Fehlt das zweite, hat man Arbeit geleistet und sie danach
// zugedeckt.
const W_OPAC: u64 = 0x1A8
// r454: the drag region of the caption strip: x0 in the low 32 bits, x1 in the high 32 (client coordinates); 0 = none
const W_DRAGX: u64 = 0x1B0
// COMPOSITOR S3: the shared memory object (unixsock) that holds this window's buffer, + 1; 0 = the buffer is the server's own run of frames
const W_SHM: u64 = 0x1B8
// W-CURSOR: the pointer shape this window's program asked for (WIG_CURSOR), 0 = arrow. Used only while the pointer is over the client area.
const W_CURSOR: u64 = 0x1C0
// W-WINOPTS S4 (docs/APP-WINDOW-OPTS.md): THE BRIGHTNESS BEHIND THIS WINDOW, measured on demand and cached in the window's own slot
// (0x1C8 .. 0x200 is the end of the 512 octets). W_BL_MEAN is the mean linear luminance (Q16) + 1; 0 = no valid measurement.
const W_BL_MEAN: u64 = 0x1C8
const W_BL_HI: u64 = 0x1D0 // the second brightest of the 32 samples (a robust "worst case" for white text)
const W_BL_LO: u64 = 0x1D8 // the second darkest sample (the worst case for black text)
const W_BL_XY: u64 = 0x1E0 // the rectangle the measurement was made for: (x + 32768) << 32 | (y + 32768)
const W_BL_WH: u64 = 0x1E8 // w << 32 | h
const W_BL_RUNS: u64 = 0x1F0 // how many times the 32 points were really measured
const W_BL_HITS: u64 = 0x1F8 // how many answers came from the cache
const BL_NX: u64 = 8
const BL_NY: u64 = 4
// COMPOSITOR S3 scalars (far from the others on purpose)
const S_TABF: u64 = 0x1E00   // the window table page (frame address), 0 = not made yet
const S_TABI: u64 = 0x1E08   // its shared object + 1
const S_TABSEQ: u64 = 0x1E10 // the table's sequence number (odd while the page is being written)
const S_SH_DMG: u64 = 0x1E18 // damage calls of shared windows since the last F12
const S_SH_PX: u64 = 0x1E20  // pixels they named
const S_BL_N: u64 = 0x1E28   // rows copied from a client by `blit_in` (WIG_BLIT) since the last F12
const S_BL_PX: u64 = 0x1E30  // and their pixels
const S_SH_ATT: u64 = 0x1E38 // windows that got a shared buffer (running total)
const S_SH_DET: u64 = 0x1E40 // shared buffers taken back by a resize (running total)
const S_TAB_N: u64 = 0x1E48  // table pages published
const S_TM_SH: u64 = 0x1E50  // terminal buffers made as kernel-owned shared objects (running total)
const S_CHRF: u64 = 0x1E58   // S6b: the chrome page (frame address), 0 = not made yet
const S_CHRI: u64 = 0x1E60   // its shared object + 1
const APP_LEN: u64 = 24

// "kein Terminal". Absichtlich eine Zahl und kein Ruf nach `tty.fi`:
// dieses Modul darf `tty` NICHT einbinden, weil `tty` es einbindet
// (SINK_WINDOW). Der Abhaengigkeitsgraph bleibt ein Baum, und die
// Richtung ist die richtige -- der Fensterserver weiss nichts von
// Zeilendisziplinen, das Terminal weiss, wohin es schreibt.
const NO_TTY: u64 = 255

fn gs(state: u64, off: u64) -> u64 {
    return kstate.get(state + kstate.WM_OFF, off)
}

fn ss(state: u64, off: u64, v: u64) {
    kstate.set(state + kstate.WM_OFF, off, v)
}

// RUNDE THEME: DIE ACHT FARBEN DER DEKORATION.
//
// `deco_fallback` ist die EINZIGE Stelle im Server, an der eine Farbe
// als Zahl steht. Sie sind die Werte, die bis zu dieser Runde mitten im
// Zeichencode standen, und sie gelten genau so lange, bis ein Programm
// in Ring 3 etwas anderes sagt.
fn deco_fallback(i: u64) -> u64 {
    if i == DK_FRAME {
        return 0x003A4654
    }
    if i == DK_TITLE {
        return 0x002C3848
    }
    if i == DK_TEXT {
        return 0x00909CA8
    }
    if i == DK_FRAME_ON {
        return 0x004C9AE8
    }
    if i == DK_TITLE_ON {
        return 0x001C4E7E
    }
    if i == DK_TEXT_ON {
        return 0x00FFFFFF
    }
    if i == DK_CLOSE {
        return 0x00D04040
    }
    if i == DK_DESK {
        return 0x001E2A38
    }
    if i == DK_TERM_FG {
        return 0x00E0E6EC
    }
    if i == DK_TERM_BG {
        return 0x0010141A
    }
    return 0x00FFFFFF
}

fn deco_rgb(state: u64, i: u64) -> u64 {
    if i >= DECO_SLOTS {
        return 0
    }
    let v: u64 = gs(state, S_DECO + i * 8)
    if v == 0 {
        return deco_fallback(i)
    }
    return v - 1
}

// 0xRRGGBB im Format des Bildschirms. Der Server rechnet um und nicht
// der Aufrufer: welches Format der Rahmenpuffer hat, weiss `fb`.
fn rgb24(state: u64, v: u64) -> u64 {
    return fb.rgb(state, (v >> 16) & 255, (v >> 8) & 255, v & 255)
}

fn deco(state: u64, i: u64) -> u64 {
    return rgb24(state, deco_rgb(state, i))
}

fn set_deco_colour(state: u64, i: u64, v: u64) -> bool {
    if i >= DECO_SLOTS {
        return false
    }
    ss(state, S_DECO + i * 8, (v & RGB24) + 1)
    ss(state, S_DECON, gs(state, S_DECON) + 1)
    if i == DK_DESK {
        ss(state, S_DESK, deco(state, DK_DESK))
    }
    // EIN TERMINALFENSTER, DAS SCHON OFFEN IST, ZIEHT MIT. Seine
    // beiden Farben stehen im Fenster und nicht im Server, weil jedes
    // Terminal seine eigenen haben darf; wer nur die Voreinstellung
    // aendert, aendert sonst nur die Fenster, die es noch nicht gibt.
    if i == DK_TERM_FG || i == DK_TERM_BG {
        var k: u64 = 0
        while k < MAX_WIN {
            if wg(state, k, W_USED) != 0 && wg(state, k, W_KIND) == K_TERM {
                if i == DK_TERM_FG {
                    wsv(state, k, W_FG, deco(state, DK_TERM_FG))
                } else {
                    wsv(state, k, W_BG, deco(state, DK_TERM_BG))
                    // ==================================== RUNDE FARBE
                    // DIE NEUE FARBE MUSS AUCH GEMALT WERDEN.
                    //
                    // Hier wurde bis zu dieser Runde NUR `W_BG`
                    // gesetzt. Das ist die Farbe, mit der das Terminal
                    // KUENFTIG loescht -- die Bildpunkte, die schon im
                    // Puffer stehen, behalten die alte. Ein Terminal,
                    // das beim Start des Systems entsteht (der
                    // Schreibtisch macht genau das) und dessen Flaeche
                    // sich danach nicht mehr ganz erneuert, bleibt
                    // deshalb fuer immer in der eingebauten Farbe.
                    //
                    // GEMESSEN (1280x800, mode=dark, dieser Runde):
                    // #10141a auf 20,4 Prozent der Bildflaeche,
                    // Blaustich B-R = +10, waehrend der Rest des
                    // Schirms schon auf der neutralen Rampe stand
                    // (#18181b, B-R = +3). Genau das Fenster, von dem
                    // Justin sagt, es sei "immer noch blau".
                    //
                    // Der Reihenfolge wegen ist das kein Sonderfall,
                    // sondern die Regel: die Leiste schickt ihre elf
                    // Farben, WENN sie laeuft -- und das ist immer
                    // NACH dem ersten Fenster.
                    fill(state, k, 0, 0, wg(state, k, W_W),
                        wg(state, k, W_H), deco(state, DK_TERM_BG))
                    term_redraw(state, k)
                    damage_win(state, k)
                }
            }
            k = k + 1
        }
    }
    return true
}

// ==================================================== RUNDE PAINT
//
// DIE FORM DES FENSTERS. Vier Zahlen, gesetzt von dem, der auch die
// Farben setzt, gelesen von `paint_win`.
//
// Wie bei den Farben wird WERT + 1 abgelegt: null heisst "nie gesetzt".
// Der Rueckfall ist ECKIG UND OHNE SCHATTEN, also genau das Bild, das
// dieses System vor dieser Runde gemalt hat. Eine Maschine, deren
// Taskleiste noch nicht laeuft, sieht damit aus wie immer und nicht
// wie ein halb gemaltes Fenster.
fn form(state: u64, i: u64) -> u64 {
    if i >= FORM_SLOTS {
        return 0
    }
    let v: u64 = gs(state, S_FORM + i * 8)
    if v == 0 {
        return 0
    }
    return v - 1
}

// ====================================================== RUNDE GLAS
//
// DERSELBE PLATZ, ABER MIT EINER ANDEREN VORGABE -- UND DAS IST KEINE
// BEQUEMLICHKEIT, SONDERN DIE FALLE DIESER RUNDE.
//
// `form` oben legt WERT + 1 ab und liefert bei 0 ("nie gesetzt") eine
// Null zurueck. Fuer Radius, Schatten und Verlauf ist das genau
// richtig: null heisst eckig, schattenlos, flach -- also das Bild vor
// der Runde PAINT. Fuer eine DECKKRAFT heisst null aber UNSICHTBAR.
// Zwischen dem Start des Fensterservers und dem ersten `form_push` der
// Taskleiste liegen mehrere hundert Bilder; in dieser Zeit waere die
// Leiste vollstaendig durchsichtig gewesen und der Schreibtisch haette
// beim Hochfahren geflackert.
//
// Also liest JEDE Deckkraft durch diesen Leser und nie durch `form`.
// `vorgabe` ist der Wert, der gilt, solange niemand etwas gesagt hat --
// 100 fuer beide Alphas, also Bildpunkt fuer Bildpunkt das Verhalten
// vor dieser Runde.
fn form_or(state: u64, i: u64, vorgabe: u64) -> u64 {
    if i >= FORM_SLOTS {
        return vorgabe
    }
    let v: u64 = gs(state, S_FORM + i * 8)
    if v == 0 {
        return vorgabe
    }
    return v - 1
}

fn set_form(state: u64, i: u64, v: u64) -> bool {
    if i >= FORM_SLOTS {
        return false
    }
    var w: u64 = v
    if i == FM_RADIUS && w > RADIUS_MAX {
        w = RADIUS_MAX
    }
    if i == FM_SHADOW && w > 100 {
        w = 100
    }
    if i == FM_SHADOW_R && w > SHADOW_MAX {
        w = SHADOW_MAX
    }
    if i == FM_SHADOW_C {
        w = w & RGB24
    }
    // RUNDE SOFTUI: dieselben Grenzen fuer das zweite Paar, und der
    // Verlauf bekommt eine eigene. GRAD_MAX ist die Zahl, ueber der
    // aus "dezent" ein Farbkeil wird -- 24 Helligkeitsstufen ueber die
    // ganze Titelleiste sind schon mehr, als Windows 11 nimmt.
    if i == FM_SHADOW2 && w > 100 {
        w = 100
    }
    if i == FM_SHADOW_R2 && w > SHADOW_MAX {
        w = SHADOW_MAX
    }
    if i == FM_GRAD && w > GRAD_MAX {
        w = GRAD_MAX
    }
    if i == FM_CAPTION && w > 1 {
        w = 1
    }
    if i == FM_TITLE_BAR && w > 64 {
        w = 64
    }
    if i == FM_CAP_W && w > 120 {
        w = 120
    }
    if i == FM_FRAME && w > 4 {
        w = 4
    }
    // RUNDE VSYNC: eine halbe Sekunde ist die Obergrenze. Laenger ist
    // keine Rueckmeldung mehr, sondern Warten.
    if i == FM_MOTION && w > MOTION_MAX {
        w = MOTION_MAX
    }
    // RUNDE ZIEH: die drei Wirkungen des Aufhebens. Jede Zahl ist
    // Schalter und Regler zugleich, 0 = aus.
    if i == FM_LIFT && w > LIFT_MAX {
        w = LIFT_MAX
    }
    if i == FM_TILT && w > TILT_MAX {
        w = TILT_MAX
    }
    if i == FM_SWING && w > SWING_MAX {
        w = SWING_MAX
    }
    // RUNDE BLUR: die drei Marken des Acryls. Der Server glaubt auch
    // hier keiner Zahl aus Ring 3 -- ein Radius von 400 wuerde die
    // Kehrwerttafel verlassen, fuer die die Exaktheit nachgewiesen ist.
    if i == FM_BLUR && w > BLUR_MAX {
        w = BLUR_MAX
    }
    if i == FM_BLURTINT && w > TINT_MAX {
        w = TINT_MAX
    }
    if i == FM_BLURNOISE && w > NOISE_MAX {
        w = NOISE_MAX
    }
    if i == FM_BLURRIM && w > RIM_MAX {
        w = RIM_MAX
    }
    // RUNDE GLAS: die drei neuen Plaetze werden hier geklemmt und nicht
    // beim Aufrufer. Ring 3 darf jede Zahl schicken; was hier ankommt,
    // liegt danach in seinem Bereich -- sonst haette ein
    // `taskbar_alpha=4000` aus der Vorlagendatei den Mischer in eine
    // Deckung von 10 200 Prozent geschickt.
    if (i == FM_TB_ALPHA || i == FM_WIN_ALPHA) && w > 100 {
        w = 100
    }
    if (i == FM_TB_ALPHA || i == FM_WIN_ALPHA) && w < ALPHA_MIN {
        w = ALPHA_MIN
    }
    if i == FM_GLASS_KEY {
        w = w & RGB24
    }
    // Und jede AENDERUNG an den Glaszahlen macht den Streifen des
    // Milchglases ungueltig: er ist fuer einen bestimmten Radius und
    // eine bestimmte Grundfarbe gerechnet worden.
    //
    // AENDERUNG HEISST: DER WERT IST EIN ANDERER. Hier stand "jeder
    // Aufruf", und die Leiste schickt ihre Zahlen bei jedem Neumalen
    // mit -- also einmal je Sekunde, wenn die Uhr weiterzaehlt.
    // GEMESSEN an einem Lauf von zwanzig Sekunden: 26 Streifen, davon
    // 24 neu gerechnet und 2 wiederverwendet. Mit dem Vergleich sind
    // es 25 Wiederverwendungen und ein einziges Rechnen -- und genau
    // das ist die Zusage "wird der Untergrund nicht veraendert, wird
    // nicht neu gerechnet".
    //
    // ZUSAMMENFUEHRUNG: die Liste steht AUSGESCHRIEBEN und nicht mehr
    // als `i >= FM_TB_ALPHA`. Auf dem Zweig GLAS lagen die vier Zahlen
    // am Ende der Liste, und ein Vergleich auf die Nummer war deshalb
    // dasselbe wie eine Aufzaehlung. Jetzt liegt `FM_BLUR` (12) DAVOR,
    // und der Radius des Acryls gehoert ausdruecklich dazu -- das
    // Milchglas der Leiste wird aus ihm gerechnet.
    if (i == FM_TB_ALPHA || i == FM_WIN_ALPHA || i == FM_GLASS_KEY
        || i == FM_BLUR) && gs(state, S_FORM + i * 8) != w + 1 {
        ss(state, S_GLVALID, 0)
    }
    ss(state, S_FORM + i * 8, w + 1)
    ss(state, S_FORMN, gs(state, S_FORMN) + 1)
    return true
}

fn form_writes(state: u64) -> u64 {
    return gs(state, S_FORMN)
}

fn shadow_px(state: u64) -> u64 {
    return gs(state, S_SHADOWPX)
}

// Der Zaehler des Abtasters. Er sitzt seit dieser Runde im Rasterer
// selbst (`lib/ecke.fi`) und nicht mehr im Zustandsblock: es gibt
// einen Schirm, einen Zustand und einen Abtaster, und der Zaehler
// gehoert dem, der zaehlt.
fn aa_px(state: u64) -> u64 {
    return ecke.aa_px()
}

fn paint_reset(state: u64) {
    ss(state, S_SHADOWPX, 0)
    ecke.aa_reset()
}

fn shadow_builds(state: u64) -> u64 {
    return gs(state, S_SHBUILD)
}

// DIE GEGENPROBE ZU DIESER RUNDE, und sie ist der einzige Grund, warum
// `ring_round` und der alte Schattenweg stehenbleiben duerfen.
//
// Ein "vorher/nachher" aus ZWEI Laeufen ist zwei Maschinen: anderer
// Wirt, andere Last, anderer Zeitgeber. Mit diesem Schalter laufen
// beide Fassungen in EINEM Bild nacheinander, auf demselben Fenster
// und mit demselben Zaehler -- und der Unterschied ist dann wirklich
// der Unterschied.
fn set_shadow_old(state: u64, on: bool) {
    if on {
        ss(state, S_SHOLD, 1)
    } else {
        ss(state, S_SHOLD, 0)
    }
}

fn cap_hover(state: u64) -> u64 {
    return gs(state, S_CAPHOV)
}

fn cap_hits(state: u64) -> u64 {
    return gs(state, S_CAPHITS)
}

// DIE DECKUNG EINES ECKPUNKTES steht nicht mehr hier, sondern in
// `lib/ecke.fi`, und zwar als einzige Fassung im Baum.
//
// Sie stand an dieser Stelle Zeile fuer Zeile so, wie sie auch in
// `wlibc.corner_cov` stand, und beide trugen den Kommentar, sie
// seien dieselbe Rechnung. Das war eine Zusage, die ein Mensch beim
// Bearbeiten einhalten musste -- und die Widget-Bibliothek malt die
// runde Ecke eines Knopfes, waehrend dieser Server die runde Ecke
// des Fensters darum malt. Weichen sie ab, sieht man zwei
// Kruemmungen nebeneinander. `lib/` ist das eine Verzeichnis, das
// der Kernbau und jedes Ring-3-Programm schon durchsuchen, also
// liegt sie dort; `aa_px` unten liest den Zaehler des Abtasters.

// UND DIE ZWEITE HAELFTE DERSELBEN AUSKUNFT, `ecke.corner_skip`, sagt
// AB WELCHER SPALTE eine Zeile voll gedeckt ist. Sie steht in
// derselben Datei und wird von der zeilenweisen Kopie der
// Anwendungsflaeche gebraucht (`paint_win`): wortweise kopierte
// Bildpunkte koennen kein Alpha tragen, also muessen sie dort
// aufhoeren, wo die Rundung anfaengt, statt sie zu uebermalen.

// Ein Rechteck, auf den schmutzigen Bereich beschnitten. Der Beschnitt
// steht EINMAL hier und nicht sechsmal in `paint_win`.
//
// RUNDE GLAS: MIT EINER DECKKRAFT, und sie geht durch `fb.fill_a` --
// also durch dieselbe `blend`-Arithmetik wie alles andere. `a == 255`
// nimmt weiterhin `fb.fill` und ist Bildpunkt fuer Bildpunkt der Weg
// vor dieser Runde; das ist der Grund, warum die Deckkraft hier ein
// Argument geworden ist und nicht eine zweite Fuellfunktion daneben.
fn fill_clip(state: u64, x: i64, y: i64, w: i64, h: i64, farbe: u64,
    a: u64, cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    let ax0: i64 = imax(x, cx0)
    let ay0: i64 = imax(y, cy0)
    let ax1: i64 = imin(x + w, cx1)
    let ay1: i64 = imin(y + h, cy1)
    if ax1 <= ax0 || ay1 <= ay0 || ax1 <= 0 || ay1 <= 0 {
        return
    }
    if a >= 255 {
        fb.fill(state, imax(ax0, 0) as u64, imax(ay0, 0) as u64,
            (ax1 - imax(ax0, 0)) as u64, (ay1 - imax(ay0, 0)) as u64, farbe)
        return
    }
    if a == 0 {
        return
    }
    fb.fill_a(state, imax(ax0, 0) as u64, imax(ay0, 0) as u64,
        (ax1 - imax(ax0, 0)) as u64, (ay1 - imax(ay0, 0)) as u64, farbe, a)
}

// Ein GEMISCHTER Bildpunkt, beschnitten. `a == 0` und `a == 255` gehen
// durch `fb.pixel_a`, das beide Abkuerzungen selbst kennt.
fn px_clip(state: u64, x: i64, y: i64, farbe: u64, a: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if x < cx0 || y < cy0 || x >= cx1 || y >= cy1 || x < 0 || y < 0 {
        return
    }
    fb.pixel_a(state, x as u64, y as u64, farbe, a)
}

// EINE GEFUELLTE FLAECHE MIT RUNDEN ECKEN, direkt in den Bildpuffer.
//
// r == 0 ist Aufruf fuer Aufruf das alte `fill_clip`, und das ist keine
// Optimierung, sondern die Zusage: auf `shape=classic` malt dieser
// Server BILDPUNKTGENAU dasselbe wie vor der Runde.
//
// Warum die Ecken GEMISCHT und nicht ausgespart werden: was unter der
// Ecke liegt, steht zu diesem Zeitpunkt schon im Bildpuffer -- der
// Schreibtisch und alle tieferen Fenster sind gemalt. Genau das ist
// der Grund, warum das hier geht und in Ring 3 nicht: die Bibliothek
// malt in IHREN Puffer und weiss nicht, was darunter liegt.
fn fill_round(state: u64, x: i64, y: i64, w: i64, h: i64, r0: u64,
    farbe: u64, a: u64, cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if w <= 0 || h <= 0 || a == 0 {
        return
    }
    var r: u64 = r0
    if r * 2 > w as u64 {
        r = (w / 2) as u64
    }
    if r * 2 > h as u64 {
        r = (h / 2) as u64
    }
    if r == 0 {
        fill_clip(state, x, y, w, h, farbe, a, cx0, cy0, cx1, cy1)
        return
    }
    let ri: i64 = r as i64
    fill_clip(state, x, y + ri, w, h - 2 * ri, farbe, a, cx0, cy0, cx1, cy1)
    fill_clip(state, x + ri, y, w - 2 * ri, ri, farbe, a, cx0, cy0, cx1, cy1)
    fill_clip(state, x + ri, y + h - ri, w - 2 * ri, ri, farbe, a,
        cx0, cy0, cx1, cy1)
    var dy: u64 = 0
    while dy < r {
        var dx: u64 = 0
        while dx < r {
            var cov: u64 = ecke.corner_cov(r - 1 - dx, r - 1 - dy, r)
            // RUNDE GLAS: die Eckendeckung UND die Fensterdeckkraft in
            // EINER Zahl. Zweimal mischen -- erst die Ecke, dann das
            // Fenster -- haette den Rand der Rundung zweimal gegen den
            // Untergrund gerechnet und ihn sichtbar dunkler gemacht.
            if a < 255 {
                cov = cov * a / 255
            }
            if cov != 0 {
                let x0: i64 = x + dx as i64
                let y0: i64 = y + dy as i64
                let x1: i64 = x + w - 1 - dx as i64
                let y1: i64 = y + h - 1 - dy as i64
                px_clip(state, x0, y0, farbe, cov, cx0, cy0, cx1, cy1)
                px_clip(state, x1, y0, farbe, cov, cx0, cy0, cx1, cy1)
                px_clip(state, x0, y1, farbe, cov, cx0, cy0, cx1, cy1)
                px_clip(state, x1, y1, farbe, cov, cx0, cy0, cx1, cy1)
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

// EIN UMRISS VON EINEM BILDPUNKT, rund, gemischt -- der Baustein des
// Schattens. Vier gerade Stuecke und vier Boegen; ein Bildpunkt gehoert
// zum Bogen, wenn er im aeusseren Kreis liegt und im inneren nicht.
fn ring_round(state: u64, x: i64, y: i64, w: i64, h: i64, r0: u64,
    farbe: u64, a: u64, cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if w <= 1 || h <= 1 || a == 0 {
        return
    }
    var r: u64 = r0
    if r * 2 > w as u64 {
        r = (w / 2) as u64
    }
    if r * 2 > h as u64 {
        r = (h / 2) as u64
    }
    let ri: i64 = r as i64
    hline_a_clip(state, x + ri, y, w - 2 * ri, farbe, a, cx0, cy0, cx1, cy1)
    hline_a_clip(state, x + ri, y + h - 1, w - 2 * ri, farbe, a,
        cx0, cy0, cx1, cy1)
    // RUNDE SOFTUI: GEZAEHLT WIRD JETZT JEDER BILDPUNKT. Vorher zaehlte
    // `S_SHADOWPX` nur die waagerechten Laeufe -- die Spalten und die
    // vier Boegen liefen ueber `px_clip` und blieben unsichtbar. Ein
    // Zaehler, der die Haelfte auslaesst, macht die neue Fassung
    // scheinbar teurer als die alte.
    var k: i64 = y + ri
    while k < y + h - ri {
        shadow_px1(state, x, k, farbe, a, cx0, cy0, cx1, cy1)
        shadow_px1(state, x + w - 1, k, farbe, a, cx0, cy0, cx1, cy1)
        k = k + 1
    }
    if r == 0 {
        return
    }
    var innen: u64 = 0
    if r > 1 {
        innen = r - 1
    }
    var dy: u64 = 0
    while dy < r {
        var dx: u64 = 0
        while dx < r {
            let aussen: u64 = ecke.corner_cov(r - 1 - dx, r - 1 - dy, r)
            var i2: u64 = 0
            if innen > 0 {
                i2 = ecke.corner_cov(r - 1 - dx, r - 1 - dy, innen)
            }
            var cov: u64 = 0
            if aussen > i2 {
                cov = aussen - i2
            }
            if cov != 0 {
                let d: u64 = cov * a / 255
                let x0: i64 = x + dx as i64
                let y0: i64 = y + dy as i64
                let x1: i64 = x + w - 1 - dx as i64
                let y1: i64 = y + h - 1 - dy as i64
                shadow_px1(state, x0, y0, farbe, d, cx0, cy0, cx1, cy1)
                shadow_px1(state, x1, y0, farbe, d, cx0, cy0, cx1, cy1)
                shadow_px1(state, x0, y1, farbe, d, cx0, cy0, cx1, cy1)
                shadow_px1(state, x1, y1, farbe, d, cx0, cy0, cx1, cy1)
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

fn hline_a_clip(state: u64, x: i64, y: i64, n: i64, farbe: u64, a: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if y < cy0 || y >= cy1 || y < 0 || n <= 0 {
        return
    }
    let x0: i64 = imax(imax(x, cx0), 0)
    let x1: i64 = imin(x + n, cx1)
    if x1 <= x0 {
        return
    }
    fb.hline_a(state, x0 as u64, y as u64, (x1 - x0) as u64, farbe, a)
    ss(state, S_SHADOWPX, gs(state, S_SHADOWPX) + (x1 - x0) as u64)
}

// =====================================================================
// DER FENSTERSCHATTEN -- und warum er hier moeglich ist und in Ring 3
// nicht.
// =====================================================================
//
// docs/ROUNDLOOK.md schrieb, ein weicher Schatten sei nicht gemalt,
// weil "the compositor cannot read what is under a window". Das war
// eine Aussage ueber die WIDGET-BIBLIOTHEK und stimmte dort: sie malt
// in den Puffer IHRES Fensters und sieht nichts darunter.
//
// Fuer den Server stimmt sie nicht, und zwar seit Runde K10: JEDES
// FENSTER HAT SEINEN EIGENEN PUFFER (`W_BUF`, in `create` aus dem
// Rahmenverwalter geholt), und `compose` setzt von unten nach oben
// zusammen -- erst der Schreibtischgrund, dann Fenster fuer Fenster.
// Wenn `paint_win` fuer Fenster i laeuft, steht ALLES, was unter i
// liegt, bereits fertig im Bildpuffer. Der Untergrund ist da; es hat
// ihn nur nie jemand gelesen.
//
// Damit ist der Schatten kein Umbau, sondern ein Aufruf an der
// richtigen Stelle: VOR dem Rahmen von i, NACH allem unter i.
//
// WIE ER GEMALT WIRD. Keine Faltung -- eine Gaussche Unschaerfe
// braeuchte einen zweiten Puffer in Bildschirmgroesse und zwei
// Durchlaeufe darueber. Statt dessen `reach` geschachtelte Umrisse,
// jeder einen Bildpunkt weiter aussen und jeder schwaecher als der
// vorige: ein linearer Abfall. Bei den vier bis sechs Bildpunkten, die
// ein Fensterschatten wirklich benutzt, ist der Unterschied zur
// Gausskurve nicht zu sehen, und der Preis ist `reach` Umrisse statt
// einer Faltung -- also der UMFANG mal `reach` und nicht die FLAECHE.
// Fuer ein Fenster von 796x576 und reach 6 sind das rund 17 000
// gemischte Bildpunkte statt 458 000.
//
// UND ER SITZT TIEFER ALS DAS FENSTER. Ein Bildpunkt Versatz nach unten
// je Ring; das ist es, was das Ding als "darueber" und nicht als
// "leuchtend" lesbar macht.
fn paint_shadow(state: u64, i: u64, cx0: i64, cy0: i64, cx1: i64,
    cy1: i64) {
    // RUNDE SOFTUI: WELCHE BANK. Das Fenster mit dem Fokus steht
    // hoeher; die anderen liegen flacher auf dem Schreibtisch.
    var staerke: u64 = shadow_staerke(state, FM_SHADOW2)
    var reach: u64 = form(state, FM_SHADOW_R2)
    var bank: u64 = 1
    if focus(state) == i {
        staerke = shadow_staerke(state, FM_SHADOW)
        reach = form(state, FM_SHADOW_R)
        bank = 0
    }
    if staerke == 0 || reach == 0 {
        return
    }
    let farbe: u64 = rgb24(state, form(state, FM_SHADOW_C))
    let r: u64 = form(state, FM_RADIUS)
    let wx: i64 = win_x(state, i)
    let wy: i64 = win_y(state, i)
    let ow: i64 = outer_w(state, i) as i64
    let oh: i64 = outer_h(state, i) as i64
    if gs(state, S_SHOLD) != 0 {
        shadow_rings(state, wx, wy, ow, oh, r, staerke, reach, farbe,
            cx0, cy0, cx1, cy1)
        return
    }
    shadow_mask(state, wx, wy, ow, oh, r, reach, bank, farbe,
        cx0, cy0, cx1, cy1)
}

// ---------------------------------------------------- DER ALTE WEG
//
// `reach` geschachtelte Umrisse, jeder einen Bildpunkt weiter aussen
// und jeder schwaecher. Er steht als GEGENPROBE hier und nicht als
// Erbstueck: `set_shadow_old` schaltet ihn an, und dann muss dasselbe
// Bild herauskommen wie mit der Maske. Kaeme etwas anderes heraus,
// waere die Maske falsch und niemand haette es gemerkt.
fn shadow_rings(state: u64, wx: i64, wy: i64, ow: i64, oh: i64, r: u64,
    staerke: u64, reach: u64, farbe: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    var k: u64 = reach
    while k > 0 {
        let a: u64 = staerke * 255 / 100 * (reach + 1 - k) / (reach + 1)
        if a != 0 {
            ring_round(state, wx - k as i64, wy - k as i64 + 1,
                ow + 2 * k as i64, oh + 2 * k as i64, r + k, farbe, a,
                cx0, cy0, cx1, cy1)
        }
        k = k - 1
    }
}

// =====================================================================
// DIE VORBERECHNETE SCHATTENMASKE -- der Kern dieser Runde.
// =====================================================================
//
// WAS AM ALTEN WEG TEUER WAR, und es waren nicht die Bildpunkte.
//
// `ring_round` tastet jede Ecke jedes Rings neu ab: fuer jeden der
// (r+k)^2 Punkte eines Eckquadrats ZWEI Aufrufe von `corner_cov`, und
// jeder davon bis zu sechzehn Unterproben. Bei r=10 und reach=6 sind
// das je Fenster 4 * sum_{k=1..6}(10+k)^2 = 4444 Eckpunkte mal zwei
// Abtastungen -- BEI JEDEM BILD, obwohl sich an der Ecke zwischen zwei
// Bildern nichts aendert. Ein Schatten ist eine Funktion der FORM und
// nicht der Zeit.
//
// ALSO EINMAL RECHNEN. Der Schatten ist punktsymmetrisch in seinen vier
// Ecken und in seinen vier geraden Stuecken konstant je Abstand. Damit
// zerfaellt er in genau zwei Tafeln:
//
//   * EIN Eckquadrat mit S = r + reach Kanten laenge, das viermal
//     gespiegelt gemalt wird,
//   * EIN Streifen von `reach` Deckungswerten fuer oben, unten, links
//     und rechts.
//
// Das ist die Neun-Felder-Zerlegung, die jedes Fenstersystem fuer
// Rahmenbilder benutzt, nur mit Deckung statt Farbe. Sie haengt NICHT
// an der Fenstergroesse: eine Maske bedient jedes Fenster auf dem
// Schirm.
//
// UND SIE LIEST DEN UNTERGRUND NICHT. Das ist die Auflage dieser Runde
// und zugleich der Grund, warum das hier ueberhaupt geht: in der Maske
// steht Deckung, keine Farbe. Was darunter liegt, kommt erst beim
// Mischen dazu -- `fb.pixel_a` liest genau den einen Bildpunkt, den es
// gerade schreibt, und niemals eine Flaeche. Ein Backdrop-Readback
// waere das Gegenteil: erst den ganzen Bereich lesen, dann rechnen.
//
// WAS DIE MASKE GENAUER MACHT ALS DIE RINGE. Die Ringe liegen auf
// ganzen Bildpunkten; ihre Boegen ueberlappen sich an den Diagonalen
// und lassen an den Achsen Luecken. Die Maske rechnet den ECHTEN
// Abstand zum Fensterrand in Sechzehnteln eines Bildpunktes und liest
// den Abfall an dieser Stelle ab. An ganzzahligen Abstaenden kommt
// dasselbe heraus wie vorher -- die Rampe ist dieselbe Formel --,
// dazwischen etwas Besseres.
// RUNDE GLAS: DIE DECKKRAFT DES FENSTERSCHMUCKS, als 0..255.
//
// Rahmen, Titelleiste und die Flaechen der Schaltflaechen gehen durch
// diese eine Zahl. Sie steht in einer Funktion und nicht an sechs
// Stellen im Quelltext, weil sonst die naechste Runde fuenf davon
// nachzieht und eine vergisst.
fn deco_alpha(state: u64) -> u64 {
    return form_or(state, FM_WIN_ALPHA, 100) * 255 / 100
}

// UND DIE STAERKE DES SCHATTENS, mit derselben Deckkraft verrechnet.
//
// Ein voller Schatten unter einem halb durchsichtigen Fenster sieht
// falsch aus, weil er mehr Licht schluckt als das Fenster selbst. Die
// Zahl geht durch `shadow_key` mit in den Maskenschluessel -- damit
// wird die Schattenmaske beim Verschieben des Reglers genau EINMAL neu
// gebaut und nicht in jedem Bild, und `shadow_builds` bleibt klein.
fn shadow_staerke(state: u64, slot: u64) -> u64 {
    return form(state, slot) * form_or(state, FM_WIN_ALPHA, 100) / 100
}

fn shadow_key(state: u64) -> u64 {
    let r: u64 = form(state, FM_RADIUS)
    let a1: u64 = shadow_staerke(state, FM_SHADOW)
    let r1: u64 = form(state, FM_SHADOW_R)
    let a2: u64 = shadow_staerke(state, FM_SHADOW2)
    let r2: u64 = form(state, FM_SHADOW_R2)
    // Ein Schluessel und kein Zeitstempel: baut die Maske nur neu, wenn
    // sich wirklich eine der fuenf Zahlen geaendert hat. + 1, damit
    // "alles null" nicht wie "nie gebaut" aussieht.
    return ((((r * 17 + r1) * 17 + r2) * 101 + a1) * 101 + a2) + 1
}

// Die ganzzahlige Quadratwurzel, Newton. Sie laeuft NUR beim Bau der
// Maske -- also 1600 mal je Formwechsel und kein einziges Mal beim
// Malen eines Bildes.
fn isqrt(n: u64) -> u64 {
    if n < 2 {
        return n
    }
    var x: u64 = n
    var y: u64 = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

// Der Abfall an einem Abstand `d16` (in Sechzehnteln eines Bildpunktes)
// vom Fensterrand. Bei d16 = 16*k steht hier auf das Oktett genau die
// Zahl, die der alte Ring k bekommen hat.
fn shadow_ramp(staerke: u64, reach: u64, d16: u64) -> u64 {
    let full: u64 = reach * 16 + 16
    if d16 == 0 || d16 >= full {
        return 0
    }
    return staerke * 255 / 100 * (full - d16) / full
}

fn shadow_build(state: u64) {
    let r: u64 = form(state, FM_RADIUS)
    let a1: u64 = shadow_staerke(state, FM_SHADOW)
    let r1: u64 = form(state, FM_SHADOW_R)
    let a2: u64 = shadow_staerke(state, FM_SHADOW2)
    let r2: u64 = form(state, FM_SHADOW_R2)
    var rmax: u64 = r1
    if r2 > rmax {
        rmax = r2
    }
    var side: u64 = r + rmax
    if side > SHMASK_SIDE {
        side = SHMASK_SIDE
    }
    ss(state, S_SHS, side)
    let base: u64 = state + kstate.WM_OFF + S_SHMASK
    let ebase: u64 = state + kstate.WM_OFF + S_SHEDGE
    // die beiden Streifen der geraden Stuecke
    var k: u64 = 0
    while k < SHADOW_MAX {
        var v1: u64 = 0
        var v2: u64 = 0
        if k < r1 {
            v1 = shadow_ramp(a1, r1, (k + 1) * 16)
        }
        if k < r2 {
            v2 = shadow_ramp(a2, r2, (k + 1) * 16)
        }
        kstate.set8(ebase + k, v1 as u8)
        kstate.set8(ebase + SHADOW_MAX + k, v2 as u8)
        k = k + 1
    }
    // das Eckquadrat, einmal fuer beide Baenke
    let bank: u64 = SHMASK_SIDE * SHMASK_SIDE
    var j: u64 = 0
    while j < side {
        var ii: u64 = 0
        while ii < side {
            let dx: u64 = side - ii
            let dy: u64 = side - j
            // 16 * sqrt(dx^2 + dy^2), also der Abstand vom Mittelpunkt
            // des Eckkreises in Sechzehnteln.
            let dist16: u64 = isqrt((dx * dx + dy * dy) * 256)
            var d16: u64 = 0
            if dist16 > r * 16 {
                d16 = dist16 - r * 16
            }
            let o: u64 = j * SHMASK_SIDE + ii
            kstate.set8(base + o, shadow_ramp(a1, r1, d16) as u8)
            kstate.set8(base + bank + o, shadow_ramp(a2, r2, d16) as u8)
            ii = ii + 1
        }
        j = j + 1
    }
    ss(state, S_SHKEY, shadow_key(state))
    ss(state, S_SHBUILD, gs(state, S_SHBUILD) + 1)
}

// Ein Bildpunkt aus der Maske, gemischt und gezaehlt.
fn shadow_px1(state: u64, x: i64, y: i64, farbe: u64, a: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if a == 0 {
        return
    }
    if x < cx0 || y < cy0 || x >= cx1 || y >= cy1 || x < 0 || y < 0 {
        return
    }
    fb.pixel_a(state, x as u64, y as u64, farbe, a)
    ss(state, S_SHADOWPX, gs(state, S_SHADOWPX) + 1)
}

// Ein Lauf aus der Deckungstafel, beschnitten. Die Beschneidung
// passiert HIER und einmal je Lauf -- `fb.hline_mask` prueft nur noch
// den Bildschirmrand.
fn mask_run(state: u64, x: i64, y: i64, n: i64, farbe: u64, m0: u64,
    schritt: i64, cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if n <= 0 || y < cy0 || y >= cy1 || y < 0 {
        return
    }
    var a: i64 = x
    var m: u64 = m0
    var len: i64 = n
    if a < cx0 {
        let weg: i64 = cx0 - a
        if weg >= len {
            return
        }
        a = cx0
        len = len - weg
        if schritt < 0 {
            m = m -% weg as u64
        } else {
            m = m +% weg as u64
        }
    }
    if a + len > cx1 {
        len = cx1 - a
    }
    if len <= 0 || a < 0 {
        return
    }
    fb.hline_mask(state, a as u64, y as u64, len as u64, farbe, m, schritt)
    ss(state, S_SHADOWPX, gs(state, S_SHADOWPX) + len as u64)
}

// Ein Lauf mit EINER Deckung, beschnitten -- die gerade Kante.
fn edge_run(state: u64, x: i64, y: i64, n: i64, farbe: u64, a: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if a == 0 {
        return
    }
    hline_a_clip(state, x, y, n, farbe, a, cx0, cy0, cx1, cy1)
}

// =====================================================================
// DER SCHATTEN, ZEILE FUER ZEILE
// =====================================================================
//
// DIE ERSTE FASSUNG DIESER RUNDE WAR SPALTENWEISE UND DAS WAR DER
// FEHLER. Sie hat die Ecktafel Punkt fuer Punkt ueber `fb.pixel_a`
// abgearbeitet, und gemessen kostete der Schatten damit 1143 us je Bild
// gegen 1268 us mit den alten Ringen -- elf Hundertstel besser, wo
// vier- bis fuenffach zu erwarten war. Die Abtastung war weg, die
// Buchhaltung nicht: sechs Zustandszugriffe je Bildpunkt.
//
// Also nicht "welcher Bildpunkt der Tafel gehoert wohin", sondern
// "welche LAEUFE hat diese Bildzeile". Die Neun-Felder-Zerlegung
// beantwortet das ohne eine einzige Bedingung je Bildpunkt:
//
//   Zeilen ueber dem Fenster   zwei Ecklaeufe + ein gerader Lauf
//   Zeilen an der Fensterecke  zwei Ecklaeufe
//   Zeilen in der Mitte        zwei Randlaeufe aus dem Streifen
//   Zeilen unter dem Fenster   spiegelbildlich zu oben
//
// Die beiden RECHTEN Laeufe lesen dieselbe Tafelzeile RUECKWAERTS
// (`schritt = -1`), die beiden UNTEREN dieselbe Tafel von unten. Eine
// Tafel, vier Ecken, kein Spiegeln zur Laufzeit.
fn shadow_mask(state: u64, wx: i64, wy: i64, ow: i64, oh: i64, r: u64,
    reach: u64, bank: u64, farbe: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if gs(state, S_SHKEY) != shadow_key(state) {
        shadow_build(state)
    }
    let side: u64 = gs(state, S_SHS)
    if side == 0 || reach == 0 {
        return
    }
    let base: u64 = state + kstate.WM_OFF + S_SHMASK
        + bank * SHMASK_SIDE * SHMASK_SIDE
    let ebase: u64 = state + kstate.WM_OFF + S_SHEDGE + bank * SHADOW_MAX
    // EIN BILDPUNKT TIEFER. Derselbe Versatz wie beim alten Weg: der
    // Schatten sitzt unter dem Fenster und nicht um es herum.
    let sy: i64 = wy + 1
    let si: i64 = side as i64
    let ri: i64 = r as i64
    let rc: i64 = reach as i64
    // x der vier Ecklaeufe
    let lx: i64 = wx - rc // linke Tafel, vorwaerts
    let rx: i64 = wx + ow - ri // rechte Tafel, rueckwaerts
    let mx: i64 = wx + ri // der gerade Teil dazwischen
    let mw: i64 = ow - 2 * ri
    let my: i64 = sy + ri // erste Zeile des geraden Mittelteils
    let mh: i64 = oh - 2 * ri
    // FIX (compositor S6a): the table square starts REACH rows above the window and ends R rows inside it (its corner circle is centred at
    // the bottom right of the square). The rows were placed `side` rows above the window (R too high above, R too low below), so the top and
    // bottom shadow floated away from the window. The kernel picture is the oracle of wmd: both use the same rows now.
    // -------------------------------------------- oben, side Zeilen
    var j: i64 = 0
    while j < si {
        let y: i64 = sy - rc + j
        let m: u64 = base + (j * SHMASK_SIDE as i64) as u64
        mask_run(state, lx, y, si, farbe, m, 1, cx0, cy0, cx1, cy1)
        mask_run(state, rx, y, si, farbe, m + (side - 1), -1,
            cx0, cy0, cx1, cy1)
        // Der gerade Teil oben gibt es nur, solange die Zeile noch
        // UEBER dem Fenster liegt.
        if j < rc && mw > 0 {
            let a: u64 = kstate.get8(ebase + (rc - 1 - j) as u64)
            edge_run(state, mx, y, mw, farbe, a, cx0, cy0, cx1, cy1)
        }
        j = j + 1
    }
    // ------------------------------------------- unten, side Zeilen
    j = 0
    while j < si {
        let y: i64 = sy + oh + rc - 1 - j
        let m: u64 = base + (j * SHMASK_SIDE as i64) as u64
        mask_run(state, lx, y, si, farbe, m, 1, cx0, cy0, cx1, cy1)
        mask_run(state, rx, y, si, farbe, m + (side - 1), -1,
            cx0, cy0, cx1, cy1)
        if j < rc && mw > 0 {
            let a: u64 = kstate.get8(ebase + (rc - 1 - j) as u64)
            edge_run(state, mx, y, mw, farbe, a, cx0, cy0, cx1, cy1)
        }
        j = j + 1
    }
    // ------------------------------------------------ die Mitte
    //
    // Links laeuft der Streifen von aussen nach innen, rechts von innen
    // nach aussen -- also dieselben `reach` Oktette, einmal vorwaerts
    // und einmal rueckwaerts. Auch hier: EIN Streifen, zwei Seiten.
    if mh > 0 && rc > 0 {
        var q: i64 = 0
        while q < mh {
            let y: i64 = my + q
            mask_run(state, wx - rc, y, rc, farbe, ebase + (reach - 1), -1,
                cx0, cy0, cx1, cy1)
            mask_run(state, wx + ow, y, rc, farbe, ebase, 1,
                cx0, cy0, cx1, cy1)
            q = q + 1
        }
    }
}

fn deco_writes(state: u64) -> u64 {
    return gs(state, S_DECON)
}

// DIE FENSTERTAFEL LIEGT SEIT DER RUNDE DESKTOP IN `kstate.DSK_OFF`
// UND NICHT MEHR IN `WM_OFF`. Die Skalare stehen weiter in WM_OFF; das
// ist die einzige Stelle, an der die beiden Bereiche auseinanderfallen,
// und sie steht deshalb hier in einer einzigen Funktion.
fn wat(i: u64) -> u64 {
    return kstate.DSK_OFF + W_OFF + i * WIN_BYTES
}

fn wg(state: u64, i: u64, off: u64) -> u64 {
    return kstate.get(state, wat(i) + off)
}

fn wsv(state: u64, i: u64, off: u64, v: u64) {
    kstate.set(state, wat(i) + off, v)
}

fn ready(state: u64) -> bool {
    return gs(state, S_READY) != 0
}

fn valid(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return wg(state, i, W_USED) != 0
}

fn count(state: u64) -> u64 {
    return gs(state, S_COUNT)
}

fn focus(state: u64) -> u64 {
    let f: u64 = gs(state, S_FOCUS)
    if f == 0 {
        return MAX_WIN
    }
    return f - 1
}

fn composites(state: u64) -> u64 {
    return gs(state, S_COMPOSITES)
}

// W-X1: every frame that reached the card (composes + pointer-only blits); the desktop loop compares it to see "something was painted".
fn frames_total(state: u64) -> u64 {
    return gs(state, S_COMPOSITES) + lj_cp_n
}

// W-X1: the pointer / key path is hot (input in the last LJ_ACTIVE_US); the quiet backoff of the desktop loop never applies then.
fn input_hot(state: u64) -> bool {
    return lj_active(state)
}

// RUNDE MESSTAFEL -- die fuenf Stufen, von aussen lesbar.
fn evpush(state: u64) -> u64 {
    return gs(state, S_EVPUSH)
}

fn evpop(state: u64) -> u64 {
    return gs(state, S_EVPOP)
}

fn keyin(state: u64) -> u64 {
    return gs(state, S_KEYIN)
}

// WO DER ZEIGER LAUT FENSTERSERVER STEHT. Nicht `ps2m.x` -- das ist
// die Stelle, die der Treiber fuehrt. Wenn die beiden auseinander
// laufen, holt der Server nicht ab, und genau das soll man sehen.
fn curx(state: u64) -> u64 {
    return gs(state, S_CURX)
}

fn cury(state: u64) -> u64 {
    return gs(state, S_CURY)
}

fn evdrops(state: u64) -> u64 {
    return gs(state, S_EVDROP)
}

// RUNDE BLECH2: zusammengefasste Bewegungen und Ereignisse an das
// abholerlose Terminal des Kerns -- beides KEIN Verlust, beides eine
// Zahl auf Tafelzeile 4 bzw. in `wm: fen`.
fn evkoal(state: u64) -> u64 {
    return gs(state, S_EVKOAL)
}

fn evterm(state: u64) -> u64 {
    return gs(state, S_EVTERM)
}

fn win_paints(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return wg(state, i, W_PAINTS)
}

fn win_px(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return wg(state, i, W_PX)
}

fn win_flags(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return wg(state, i, W_FLAGS)
}

// ==================================================== RUNDE LEISTE
// DIESE FUNKTION HAT EINE RUNDE LANG DAS FALSCHE FENSTER GEMESSEN.
//
// Der Satz darunter -- "dorthin legt `taskbar.fi` sich, und sonst
// nichts" -- stimmte, als er geschrieben wurde. Seit der Runde
// STARTKNOPF legt sich das STARTMENUE (`launcher.fi`, `window_plain`)
// ebenfalls auf `L_TOP`, und weil es SPAETER kommt, liegt es weiter
// oben im Stapel: `top_layer_win` liefert seitdem den Starter.
//
// Damit hat Tafelzeile 7 die ganze letzte Runde die Anstriche und den
// Aufgabenzustand des STARTMENUES gezeigt und "die Leiste lebt"
// gemeldet, waehrend die Leiste stand. Eine Messung, die auf das
// falsche Ding zeigt, ist schlimmer als keine.
//
// `panel_win` fragt deshalb nach dem, was eine Taskleiste WIRKLICH
// ausmacht und was ein Menue nie tut: sie reserviert eine Kante des
// Schirms (`W_STRUT != 0`). Das ist dieselbe Regel, nach der
// `sysgui.fi` entscheidet, wer eine Leiste sein darf.
fn panel_win(state: u64) -> u64 {
    var z: u64 = gs(state, S_COUNT)
    while z > 0 {
        z = z - 1
        let i: u64 = at_z(state, z)
        if i < MAX_WIN && wg(state, i, W_USED) != 0 {
            if wg(state, i, W_LAYER) == L_TOP && wg(state, i, W_STRUT) != 0 {
                return i
            }
        }
    }
    // Keine Leiste mit Kante: dann taugt die alte Antwort immer noch
    // besser als gar keine -- aber der Rufende sieht am fehlenden
    // Strut, dass es die Leiste nicht ist.
    return MAX_WIN
}

// DAS FENSTER DER TASKLEISTE, ohne dass der Kern die Leiste kennen muss:
// das oberste benutzte Fenster auf der Ebene L_TOP. Genau dorthin legt
// `taskbar.fi` sich (`WS_LAYER = L_TOP`), und sonst nichts.
// RUNDE LEISTE: NICHT MEHR FUER DIE LEISTE BENUTZEN -- dafuer gibt es
// `panel_win`. Diese hier liefert das oberste Fenster der obersten
// Ebene, was seit dem Startmenue etwas anderes ist.
fn top_layer_win(state: u64) -> u64 {
    var z: u64 = gs(state, S_COUNT)
    while z > 0 {
        z = z - 1
        let i: u64 = at_z(state, z)
        if i < MAX_WIN && wg(state, i, W_USED) != 0 {
            if wg(state, i, W_LAYER) == L_TOP {
                return i
            }
        }
    }
    return MAX_WIN
}

// ================== RUNDE MESSTAFEL: DIE FENSTERLISTE AUF DIE LEITUNG
//
// Eine Zeile je Fenster, mit ALLEM, was zwischen "angelegt" und
// "sichtbar" schiefgehen kann: Kennung, Lage, Groesse, Ebene, die
// Merkerbits, der Platz in der Stapelfolge -- und die beiden neuen
// Zaehler. Wer diese Liste hat, muss ueber die Taskleiste nicht mehr
// raten.
// r402 (docs/COMPOSITOR.md S0): THE FRAME TIME SINCE THE LAST F12, by bucket. The counters of the frame
// time (`S_FRUS ...`, the same ones `bildzeit:` prints at the end of a run) are printed and set to
// zero, so that a runner can measure one PHASE after the boot (idle, pointer, menu, window drag)
// and not the mean over a whole run that is dominated by the start.
fn bild_say_reset(state: u64) {
    cadence_say_reset(state)
    var s_b: [u8; 12] = "wm: bild n=\0"
    var s_m: [u8; 9] = " mittel=\0"
    var s_x: [u8; 6] = " max=\0"
    var s_u: [u8; 10] = " ueber16=\0"
    var s_f: [u8; 7] = " fach=\0"
    let n: u64 = gs(state, S_FRN)
    serial.puts((&s_b[0]) as u64)
    serial.dec(n)
    serial.puts((&s_m[0]) as u64)
    if n != 0 {
        serial.dec(gs(state, S_FRUS) / n)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_x[0]) as u64)
    serial.dec(gs(state, S_FRMAX))
    serial.puts((&s_u[0]) as u64)
    serial.dec(gs(state, S_FRUEBER))
    serial.puts((&s_f[0]) as u64)
    var k: u64 = 0
    while k < 8 {
        serial.dec(gs(state, S_FRH + k * 8))
        if k < 7 {
            serial.put(32 as u8)
        }
        ss(state, S_FRH + k * 8, 0)
        k = k + 1
    }
    serial.nl()
    if fb.phases_an(state) {
        lj_say_reset(state)
    }
    // r460: where the time of those frames went (microseconds summed; divide by n for the mean per frame). `blurs= bhits= blurus=`
    // are running totals of the blur counters (NOT reset here: the acceptance runs read them); a runner takes differences.
    var s_p: [u8; 14] = "wm: phase n=\0\0"
    var s_p1: [u8; 5] = " bg=\0"
    var s_p2: [u8; 6] = " win=\0"
    var s_p3: [u8; 7] = " drag=\0"
    var s_p4: [u8; 6] = " top=\0"
    var s_p5: [u8; 7] = " pend=\0"
    var s_p6: [u8; 5] = " px=\0"
    var s_p7: [u8; 7] = " blur=\0"
    var s_p8: [u8; 8] = " glass=\0"
    var s_p9: [u8; 9] = " shadow=\0"
    var s_pa: [u8; 6] = " rgn=\0"
    var s_pb: [u8; 8] = " saved=\0"
    var s_pc: [u8; 8] = " blurs=\0"
    var s_pd: [u8; 8] = " bhits=\0"
    var s_pe: [u8; 9] = " blurus=\0"
    // only when the kernel word `phases` is on: this line is long, and the acceptance runs that press F12 for the window table
    // must not get a second long serial line to interleave with (lockseal reads a program's line in the same window)
    if fb.phases_an(state) {
        serial.puts((&s_p[0]) as u64)
        serial.dec(gs(state, S_PH_N))
        serial.puts((&s_p1[0]) as u64)
        serial.dec(gs(state, S_PH_BG))
        serial.puts((&s_p2[0]) as u64)
        serial.dec(gs(state, S_PH_WIN))
        serial.puts((&s_p3[0]) as u64)
        serial.dec(gs(state, S_PH_DRAG))
        serial.puts((&s_p4[0]) as u64)
        serial.dec(gs(state, S_PH_TOP))
        serial.puts((&s_p5[0]) as u64)
        serial.dec(gs(state, S_PH_PEND))
        serial.puts((&s_p6[0]) as u64)
        serial.dec(gs(state, S_PH_PX))
        serial.puts((&s_p7[0]) as u64)
        serial.dec(gs(state, S_PH_BLUR))
        serial.puts((&s_p8[0]) as u64)
        serial.dec(gs(state, S_PH_GLASS))
        serial.puts((&s_p9[0]) as u64)
        serial.dec(gs(state, S_PH_SHADOW))
        serial.puts((&s_pa[0]) as u64)
        serial.dec(gs(state, S_RFRAMES))
        serial.puts((&s_pb[0]) as u64)
        serial.dec(gs(state, S_RSAVED))
        serial.puts((&s_pc[0]) as u64)
        serial.dec(gs(state, S_BLURS))
        serial.puts((&s_pd[0]) as u64)
        serial.dec(gs(state, S_BLURCACHE))
        serial.puts((&s_pe[0]) as u64)
        serial.dec(gs(state, S_BLURUS))
        serial.nl()
    }
    cp_say_reset(state)
    // COMPOSITOR S3: what the clients' pixels cost since the last F12. `blitpx` are the pixels the kernel copied out of a client (WIG_BLIT),
    // `shpx` the pixels of shared windows that were named dirty WITHOUT a copy. Printed only once a shared window or a blit happened.
    if gs(state, S_BL_PX) != 0 || gs(state, S_SH_DMG) != 0 {
        var s_s: [u8; 14] = "wm: shared n=\0"
        var s_s1: [u8; 9] = " blitpx=\0"
        var s_s2: [u8; 8] = " blits=\0"
        var s_s3: [u8; 7] = " shpx=\0"
        var s_s4: [u8; 8] = " shdmg=\0"
        var s_s5: [u8; 9] = " attach=\0"
        var s_s6: [u8; 9] = " detach=\0"
        serial.puts((&s_s[0]) as u64)
        serial.dec(gs(state, S_FRN))
        serial.puts((&s_s1[0]) as u64)
        serial.dec(gs(state, S_BL_PX))
        serial.puts((&s_s2[0]) as u64)
        serial.dec(gs(state, S_BL_N))
        serial.puts((&s_s3[0]) as u64)
        serial.dec(gs(state, S_SH_PX))
        serial.puts((&s_s4[0]) as u64)
        serial.dec(gs(state, S_SH_DMG))
        serial.puts((&s_s5[0]) as u64)
        serial.dec(gs(state, S_SH_ATT))
        serial.puts((&s_s6[0]) as u64)
        serial.dec(gs(state, S_SH_DET))
        serial.nl()
        ss(state, S_BL_PX, 0)
        ss(state, S_BL_N, 0)
        ss(state, S_SH_PX, 0)
        ss(state, S_SH_DMG, 0)
    }
    ss(state, S_RFRAMES, 0)
    ss(state, S_RSAVED, 0)
    ss(state, S_PH_BLUR, 0)
    ss(state, S_PH_GLASS, 0)
    ss(state, S_PH_SHADOW, 0)
    ss(state, S_PH_N, 0)
    ss(state, S_PH_BG, 0)
    ss(state, S_PH_WIN, 0)
    ss(state, S_PH_DRAG, 0)
    ss(state, S_PH_TOP, 0)
    ss(state, S_PH_PEND, 0)
    ss(state, S_PH_PX, 0)
    ss(state, S_FRUS, 0)
    ss(state, S_FRN, 0)
    ss(state, S_FRMAX, 0)
    ss(state, S_FRUEBER, 0)
    // W-PRESENT: what the copies to the card cost since the last F12 (n copies, microseconds summed, the longest one), and the running
    // octets those copies pushed (measured around the copy, so the board and the console do not count) and the running rectangle total.
    var s_w0: [u8; 14] = "wm: flush n=\0\0"
    var s_w1: [u8; 5] = " us=\0"
    var s_w2: [u8; 6] = " max=\0"
    var s_w3: [u8; 6] = " okt=\0"
    var s_w4: [u8; 7] = " rect=\0"
    serial.puts((&s_w0[0]) as u64)
    serial.dec(fb.flush_us_n(state))
    serial.puts((&s_w1[0]) as u64)
    serial.dec(fb.flush_us_sum(state))
    serial.puts((&s_w2[0]) as u64)
    serial.dec(fb.flush_us_max(state))
    serial.puts((&s_w3[0]) as u64)
    serial.dec(fb.flush_okt(state))
    serial.puts((&s_w4[0]) as u64)
    serial.dec(fb.tx_rects(state))
    serial.nl()
    var s_b0: [u8; 13] = "wm: beam on=\0"
    var s_b1: [u8; 7] = " pipe=\0"
    var s_b2: [u8; 5] = " vt=\0"
    var s_b3: [u8; 6] = " mhz=\0"
    var s_b4: [u8; 9] = " copies=\0"
    var s_b5: [u8; 8] = " waits=\0"
    var s_b6: [u8; 5] = " to=\0"
    var s_b7: [u8; 6] = " big=\0"
    var s_b8: [u8; 9] = " waitus=\0"
    var s_b9: [u8; 8] = " maxus=\0"
    var s_ba: [u8; 6] = " rin=\0"
    var s_bb: [u8; 7] = " rout=\0"
    serial.puts((&s_b0[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_ON))
    serial.puts((&s_b1[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_PIPE))
    serial.puts((&s_b2[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_VT))
    serial.puts((&s_b3[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_MHZ))
    serial.puts((&s_b4[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_COPY))
    serial.puts((&s_b5[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_WAITS))
    serial.puts((&s_b6[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_TO))
    serial.puts((&s_b7[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_BIG))
    serial.puts((&s_b8[0]) as u64)
    serial.dec(time_us(state, fb.bm(state, fb.S_BM_WCYC)))
    serial.puts((&s_b9[0]) as u64)
    serial.dec(time_us(state, fb.bm(state, fb.S_BM_WMAX)))
    serial.puts((&s_ba[0]) as u64)
    serial.dec(fb.bm(state, fb.S_RM_IN))
    serial.puts((&s_bb[0]) as u64)
    serial.dec(fb.bm(state, fb.S_RM_OUT))
    serial.nl()
    beam.say(state)
    pixelguard.say()
    fb.flush_reset(state)
}

fn wins_say(state: u64) {
    if !ready(state) {
        return
    }
    // r402: a marker in front of every dump, so that a runner can tell one dump from the next
    var s_fl: [u8; 14] = "wm: fenliste\0\0"
    serial.puts((&s_fl[0]) as u64)
    serial.nl()
    bild_say_reset(state)
    var s_h: [u8; 11] = "wm: fen i=\0"
    var s_id: [u8; 5] = " id=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var s_l: [u8; 6] = " lay=\0"
    var s_f: [u8; 5] = " fl=\0"
    var s_z: [u8; 4] = " z=\0"
    var s_p: [u8; 8] = " malen=\0"
    var s_px: [u8; 5] = " px=\0"
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 {
            serial.puts((&s_h[0]) as u64)
            serial.dec(i)
            serial.puts((&s_id[0]) as u64)
            serial.dec(wg(state, i, W_ID))
            serial.puts((&s_x[0]) as u64)
            serial.dec(win_x(state, i) as u64)
            serial.puts((&s_y[0]) as u64)
            serial.dec(win_y(state, i) as u64)
            serial.puts((&s_w[0]) as u64)
            serial.dec(wg(state, i, W_W))
            serial.puts((&s_hh[0]) as u64)
            serial.dec(wg(state, i, W_H))
            serial.puts((&s_l[0]) as u64)
            serial.dec(wg(state, i, W_LAYER))
            serial.puts((&s_f[0]) as u64)
            serial.dec(wg(state, i, W_FLAGS))
            serial.puts((&s_z[0]) as u64)
            serial.dec(wg(state, i, W_Z))
            serial.puts((&s_p[0]) as u64)
            serial.dec(wg(state, i, W_PAINTS))
            serial.puts((&s_px[0]) as u64)
            serial.dec(wg(state, i, W_PX))
            // ============================================== RUNDE BLECH2
            // WO DER TITEL STEHT, damit ein Laeufer ihn im Bild
            // bildpunktgenau nachrechnen kann (tools/metal2/run.sh mit
            // `checkshot.py tkette`): Anfang, Grundlinie, Schriftgroesse,
            // Schrift- und Leistenfarbe -- und `tka`, die alte
            // TK-Zaehlweise, zum Vergleich mit dem Bild.
            if deko(state, i) {
                var s_tx: [u8; 5] = " tx=\0"
                var s_tb: [u8; 5] = " tb=\0"
                var s_tp: [u8; 5] = " tp=\0"
                var s_tf: [u8; 5] = " tf=\0"
                var s_tg: [u8; 5] = " tg=\0"
                var s_tk: [u8; 6] = " tka=\0"
                let f: u64 = gs(state, S_FONT_UI)
                let px: u64 = gs(state, S_PX_UI)
                var before: i64 = 0
                let sicht: u64 = netview.view_of(state, win_owner(state, i))
                if sicht != netview.V_REAL && sicht <= 3 {
                    before = netmark.W as i64 + 4
                }
                var tf: u64 = deco_rgb(state, DK_TEXT)
                var tg: u64 = deco_rgb(state, DK_TITLE)
                if focus(state) == i {
                    tf = deco_rgb(state, DK_TEXT_ON)
                    tg = deco_rgb(state, DK_TITLE_ON)
                }
                var tb: i64 = win_y(state, i) + border(state) as i64
                if f < ttf.MAX_FONTS {
                    tb = win_y(state, i) + title_base(state, f)
                }
                serial.puts((&s_tx[0]) as u64)
                serial.dec((win_x(state, i) + border(state) as i64 + title_pad(state) as i64 + before) as u64)
                serial.puts((&s_tb[0]) as u64)
                serial.dec(tb as u64)
                serial.puts((&s_tp[0]) as u64)
                serial.dec(px)
                serial.puts((&s_tf[0]) as u64)
                serial.hex(tf)
                serial.puts((&s_tg[0]) as u64)
                serial.hex(tg)
                serial.puts((&s_tk[0]) as u64)
                serial.dec(titel_schnitt_alt)
                // r402: the measures of the chrome, so that a runner can place the three
                // caption buttons without a constant of its own
                var s_br: [u8; 6] = " bar=\0"
                var s_cw: [u8; 7] = " capw=\0"
                var s_fr: [u8; 5] = " fr=\0"
                serial.puts((&s_br[0]) as u64)
                serial.dec(title_h(state) - 1 - border(state))
                serial.puts((&s_cw[0]) as u64)
                serial.dec(cap_w(state))
                serial.puts((&s_fr[0]) as u64)
                serial.dec(border(state))
            }
            serial.nl()
        }
        i = i + 1
    }
}

fn blits(state: u64) -> u64 {
    return gs(state, S_BLITS)
}

fn pixels(state: u64) -> u64 {
    return gs(state, S_PIXELS)
}

fn last_us(state: u64) -> u64 {
    return gs(state, S_LASTUS)
}

fn cursor_on(state: u64) -> bool {
    return gs(state, S_CURON) != 0
}

fn set_cursor(state: u64, on: bool) {
    if on {
        ss(state, S_CURON, 1)
    } else {
        ss(state, S_CURON, 0)
    }
}

fn font_ui(state: u64) -> u64 {
    return gs(state, S_FONT_UI)
}

fn font_mono(state: u64) -> u64 {
    return gs(state, S_FONT_MONO)
}

fn px_ui(state: u64) -> u64 {
    return gs(state, S_PX_UI)
}

fn px_mono(state: u64) -> u64 {
    return gs(state, S_PX_MONO)
}

fn set_fonts(state: u64, ui: u64, pui: u64, mono: u64, pmono: u64) {
    ss(state, S_FONT_UI, ui)
    ss(state, S_PX_UI, pui)
    ss(state, S_FONT_MONO, mono)
    ss(state, S_PX_MONO, pmono)
}

fn win_x(state: u64, i: u64) -> i64 {
    return wg(state, i, W_X) as i64
}

fn win_y(state: u64, i: u64) -> i64 {
    return wg(state, i, W_Y) as i64
}

fn win_w(state: u64, i: u64) -> u64 {
    return wg(state, i, W_W)
}

fn win_h(state: u64, i: u64) -> u64 {
    return wg(state, i, W_H)
}

fn win_z(state: u64, i: u64) -> u64 {
    return wg(state, i, W_Z)
}

fn win_buf(state: u64, i: u64) -> u64 {
    return wg(state, i, W_BUF)
}

fn win_owner(state: u64, i: u64) -> u64 {
    return wg(state, i, W_OWNER)
}

fn win_kind(state: u64, i: u64) -> u64 {
    return wg(state, i, W_KIND)
}

fn win_id(state: u64, i: u64) -> u64 {
    return wg(state, i, W_ID)
}

// HAT DIESES FENSTER SCHMUCK? Rahmen, Titelleiste, Schliessfeld und
// Griff kosten links BORDER und oben TITLE_H. Ein Schreibtisch, der
// zwei Bildpunkte neben dem Bildschirmrand anfaengt, ist kein
// Schreibtisch; eine Taskleiste mit Titelleiste ist keine Taskleiste.
fn deko(state: u64, i: u64) -> bool {
    return (wg(state, i, W_FLAGS) & F_NODECO) == 0
}

// Der Versatz der Malflaeche innerhalb des aeusseren Rechtecks. An
// EINER Stelle, weil dieselbe Rechnung im Zusammensetzen, im Treffer
// und in der Ereignisverteilung vorkommt -- und weil sie in der ersten
// Fassung dieser Runde an zweien davon stand und an der dritten nicht.
fn inx(state: u64, i: u64) -> u64 {
    if deko(state, i) {
        return border(state)
    }
    return 0
}

fn iny(state: u64, i: u64) -> u64 {
    if deko(state, i) {
        // r454: the client strip lies INSIDE the buffer, so the buffer starts below the top frame line only
        if (wg(state, i, W_FLAGS) & F_CAPCLIENT) != 0 {
            return border(state)
        }
        return title_h(state)
    }
    return 0
}

// r454: does this window paint its own title strip?
fn cap_client(state: u64, i: u64) -> bool {
    if i >= MAX_WIN || !valid(state, i) || !deko(state, i) {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_CAPCLIENT) != 0
}

// r454: the height of the strip in buffer rows: the title bar and the line under it (what the buffer grows by)
fn strip_h(state: u64) -> u64 {
    return title_h(state) - border(state)
}

// r454: the width the three caption buttons (and the frame) take at the right end of the strip
fn cap_strip_w(state: u64) -> u64 {
    return CAP_N * cap_w(state) + border(state)
}

// r454: is the client x inside the declared drag region of the strip? (the caption buttons are tested before this)
fn strip_drag_at(state: u64, i: u64, x: i64) -> bool {
    let r: u64 = wg(state, i, W_DRAGX)
    let x0: u64 = r & 0xFFFFFFFF
    let x1: u64 = r >> 32
    if x1 <= x0 || x < 0 {
        return false
    }
    return (x as u64) >= x0 && (x as u64) < x1
}

// r454: the program declares the empty part of its strip: [x0, x1) in client coordinates (0, 0 = none)
fn set_strip_drag(state: u64, i: u64, x0: u64, x1: u64) -> bool {
    if !cap_client(state, i) {
        return false
    }
    wsv(state, i, W_DRAGX, (x0 & 0xFFFFFFFF) | (x1 << 32))
    return true
}

// r454: switch the client strip on or off. The buffer grows (shrinks) by the strip height so that the OUTER size of the window
// stays what it was; the program gets an E_RESIZE with the new size and lays itself out again.
fn set_cap_client(state: u64, i: u64, on: bool) -> bool {
    if !valid(state, i) || !deko(state, i) {
        return false
    }
    // the counter-proof of tools/tabstrip: the server says no, the program keeps its old layout
    if on && fb.nostrip_an(state) {
        return false
    }
    let has: bool = (wg(state, i, W_FLAGS) & F_CAPCLIENT) != 0
    if on == has {
        return true
    }
    let sh: u64 = strip_h(state)
    let w: u64 = wg(state, i, W_W)
    let h: u64 = wg(state, i, W_H)
    let f: u64 = wg(state, i, W_FLAGS)
    if on {
        wsv(state, i, W_FLAGS, f | F_CAPCLIENT)
        wsv(state, i, W_DRAGX, 0)
        if !resize_win(state, i, w, h + sh) {
            wsv(state, i, W_FLAGS, f)
            return false
        }
        return true
    }
    if h <= sh + 16 {
        return false
    }
    wsv(state, i, W_FLAGS, f & ~F_CAPCLIENT)
    wsv(state, i, W_DRAGX, 0)
    if !resize_win(state, i, w, h - sh) {
        wsv(state, i, W_FLAGS, f)
        return false
    }
    return true
}

fn outer_w(state: u64, i: u64) -> u64 {
    if !deko(state, i) {
        return wg(state, i, W_W)
    }
    return wg(state, i, W_W) + border(state) * 2
}

fn outer_h(state: u64, i: u64) -> u64 {
    if !deko(state, i) {
        return wg(state, i, W_H)
    }
    return wg(state, i, W_H) + iny(state, i) + border(state)
}

fn win_layer(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return L_NORMAL
    }
    return wg(state, i, W_LAYER)
}

fn win_hidden(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_HIDDEN) != 0
}

fn win_deco(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return deko(state, i)
}

// Die Adresse des Titels IM KERNEL. Nur `sys.fi` benutzt sie, um ihn
// nach Ring 3 zu kopieren -- die Taskleiste braucht Namen.
fn win_title(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return 0
    }
    return state + wat(i) + W_TITLE
}

// Das Fenster mit dieser Nummer. Die Taskleiste kennt FREMDE Fenster
// nur ueber ihre Nummer -- ein Handle bekommt sie nicht, und ein Platz
// in der Tafel waere eine Zahl, die sich unter ihr aendert.
fn by_id(state: u64, id: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_ID) == id {
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

fn hides(state: u64) -> u64 {
    return gs(state, S_HIDES)
}

fn shows(state: u64) -> u64 {
    return gs(state, S_SHOWS)
}

fn nolayer(state: u64) -> bool {
    return gs(state, S_NOLAYER) != 0
}

fn nomin(state: u64) -> bool {
    return gs(state, S_NOMIN) != 0
}

fn set_nolayer(state: u64, on: bool) {
    if on {
        ss(state, S_NOLAYER, 1)
    } else {
        ss(state, S_NOLAYER, 0)
    }
}

fn set_nomin(state: u64, on: bool) {
    if on {
        ss(state, S_NOMIN, 1)
    } else {
        ss(state, S_NOMIN, 0)
    }
}

fn term_cols(state: u64, i: u64) -> u64 {
    return wg(state, i, W_COLS)
}

fn term_rows(state: u64, i: u64) -> u64 {
    return wg(state, i, W_ROWS)
}

fn term_cx(state: u64, i: u64) -> u64 {
    return wg(state, i, W_CX)
}

fn term_cy(state: u64, i: u64) -> u64 {
    return wg(state, i, W_CY)
}

// ====================================== RUNDE GLAS (nachtrag)
// WO EINE ZELLE WIRKLICH LIEGT -- gefragt von aussen.
//
// `wm: term win=0 cols= rows= cell=` hat die Zellengroesse bis zu
// dieser Runde aus zwei festen Zahlen GETEILT (560/cols, 380/rows),
// und das stimmte genau fuer den einen Aufbau, in dem es geschrieben
// wurde. Wer eine Zeile des Terminals bildpunktgenau nachrastern will
// -- tools/look/umlaut.py tut das seit dem Nachtrag --, braucht die
// echten Zahlen: Zellenbreite, Zellenhoehe und den Aufsteiger der
// Festbreitenschrift, denn die Grundlinie der Zeile r liegt bei
// y + r * Zellenhoehe + Aufsteiger. Geraten wird hier nichts mehr.
fn term_cellw(state: u64, i: u64) -> u64 {
    return wg(state, i, W_CELLW)
}

fn term_cellh(state: u64, i: u64) -> u64 {
    return wg(state, i, W_CELLH)
}

fn term_asc(state: u64) -> u64 {
    let f: u64 = gs(state, S_FONT_MONO)
    if f >= ttf.MAX_FONTS {
        return 0
    }
    // `ttf.ascent` rechnet in i64 (ein Aufsteiger kann rechnerisch
    // negativ werden); hier ist er eine Hoehe in Bildpunkten.
    return ttf.ascent(state, f, gs(state, S_PX_MONO)) as u64
}

fn term_px(state: u64) -> u64 {
    return gs(state, S_PX_MONO)
}

// ------------------------------------------------------------- Start

fn init(state: u64, w: u64, h: u64, nodirty: bool, nofocus: bool) -> bool {
    if w == 0 || h == 0 {
        return false
    }
    var i: u64 = 0
    while i < MAX_WIN {
        wsv(state, i, W_USED, 0)
        wsv(state, i, W_EHEAD, 0)
        wsv(state, i, W_ETAIL, 0)
        wsv(state, i, W_LAYER, L_NORMAL)
        wsv(state, i, W_FLAGS, 0)
        wsv(state, i, W_STRUT, 0)
        wsv(state, i, W_SAVE, 0)
        i = i + 1
    }
    ss(state, S_COUNT, 0)
    ss(state, S_FOCUS, 0)
    ss(state, S_NEXTID, 1)
    ss(state, S_SW, w)
    ss(state, S_SH, h)
    ss(state, S_DRAG, 0)
    ss(state, S_SIZING, 0)
    ss(state, S_CURON, 1)
    ss(state, S_CURX, w / 2)
    ss(state, S_CURY, h / 2)
    ss(state, S_COMPOSITES, 0)
    ss(state, S_BLITS, 0)
    ss(state, S_PIXELS, 0)
    ss(state, S_KEYS, 0)
    ss(state, S_EVDROP, 0)
    ss(state, S_LASTUS, 0)
    ss(state, S_DON, 0)
    ss(state, S_CLOCK, 0)
    ss(state, S_RLOCK, 0)
    ss(state, S_RBAD, 0)
    region.region_clear(state + kstate.WM_OFF + S_RGN)
    ss(state, S_NODIRTY, 0)
    if nodirty {
        ss(state, S_NODIRTY, 1)
    }
    ss(state, S_NOFOCUS, 0)
    if nofocus {
        ss(state, S_NOFOCUS, 1)
    }
    ss(state, S_HIDES, 0)
    ss(state, S_SHOWS, 0)
    // ADDENDUM TASKBAR: before the first strut the work area IS the
    // screen. `recalc_work` reads S_SW and S_SH, so it has to run after
    // both are set -- they are, twelve lines above this one.
    ss(state, S_NOSTRUT, 0)
    ss(state, S_STRUTS, 0)
    ss(state, S_WORKCALC, 0)
    recalc_work(state)
    ss(state, S_DESK, deco(state, DK_DESK))
    ss(state, S_FONT_UI, ttf.MAX_FONTS)
    ss(state, S_FONT_MONO, ttf.MAX_FONTS)
    ss(state, S_TILE, 0)
    ss(state, S_PVON, 0)
    ss(state, S_DROPN, 0)
    ss(state, S_DROPE, 0)
    ss(state, S_DRAGT, 0)
    ss(state, S_HOTS, 0)
    ss(state, S_ACTS, 0)
    ss(state, S_READY, 1)
    // RUNDE TILING: der Baum bekommt dieselbe Flaeche wie der Schirm.
    // Er ist erst einmal LEER und schaltet nichts um -- ohne das Wort
    // `tile` verhaelt sich der Fensterserver wie vorher.
    tile.init(state, 0, 0, w, h)
    // RUNDE WMPLUGIN: die Plugintafel. Ohne das Wort `wmplug` (und mit
    // `plugaus` erst recht) bleibt sie ZU -- dann weist `plug_call`
    // jede Anmeldung mit E_UNSUPPORTED ab und dieser Fensterserver
    // verhaelt sich Zeile fuer Zeile wie vor der Runde.
    wmplug.init(state)
    if !kstate.mode_on(state, kstate.M_WMPLUG)
        || kstate.mode_on(state, kstate.M_PLUGAUS) {
        wmplug.set_ready(state, false)
    }
    // RUNDE GLAS: der Selbsttest der Mischung und des Weichzeichners.
    // Er steht HIER und nicht in `selftest`, weil der dort mitten in
    // einer Zeile laeuft, die `kgui` schreibt -- siehe `fokus_still`.
    glastest_say(state)
    damagetest_say(state)
    ss(state, S_GLASSGEN, 1)
    ss(state, S_GLVALID, 0)
    ss(state, S_PANELGROW, 0)
    ss(state, S_GLHIT, 0)
    ss(state, S_GLRUN, 0)
    ss(state, S_GLUS, 0)
    ss(state, S_GLN, 0)
    ss(state, S_GLMAX, 0)
    ss(state, S_GLLAST, 0)
    ss(state, S_GLSAY, 0)
    set_noglasgrow(state, fb.glasgrow_aus(state))
    // Die Gegenprobe meldet sich von selbst: ein Lauf, in dem die Regel
    // abgeschaltet ist, muss das in seiner eigenen Ausgabe sagen und
    // nicht nur auf der Befehlszeile.
    if gs(state, S_NOGROW) != 0 {
        schlieren_say(state)
    }
    damage_all(state)
    return true
}

// ---------------------------------------------------- die Rechtecke

// The region of the damage. A short spin lock: `damage` is called from every core (mouse IRQ, client calls) and the region is a
// list that is cut and appended to; the critical section is a few dozen instructions. If the lock cannot be had the box (which
// is always kept) carries the frame: `S_RBAD`.
fn rgn_lock(state: u64) -> bool {
    let lk: u64 = state + kstate.WM_OFF + S_RLOCK
    var spins: u64 = 0
    var got: bool = false
    while !got {
        let alt: u64 = __atomic_swap(lk as *mut u64, 0 as u64, 1 as u64)
        if alt == 0 {
            got = true
        } else {
            spins = spins + 1
            if spins > 20000 {
                return false
            }
        }
    }
    return true
}

fn rgn_unlock(state: u64) {
    arch.atomic_store(state + kstate.WM_OFF + S_RLOCK, 0)
}

fn rgn_add(state: u64, a: i64, b: i64, c: i64, d: i64) {
    if !rgn_lock(state) {
        ss(state, S_RBAD, 1)
        return
    }
    region.region_add(state + kstate.WM_OFF + S_RGN, a, b, c, d)
    rgn_unlock(state)
}

fn rgn_all(state: u64) {
    if !rgn_lock(state) {
        ss(state, S_RBAD, 1)
        return
    }
    let r: u64 = state + kstate.WM_OFF + S_RGN
    region.region_clear(r)
    region.region_add(r, 0, 0, gs(state, S_SW) as i64, gs(state, S_SH) as i64)
    rgn_unlock(state)
}

// Take the region out for one frame: copy its rectangles to `out` (4 words each) and empty it. Returns the number of rectangles,
// or 0 when the frame should use the box: the region was marked bad, it is empty, it does not agree with the box (a racing
// `damage`), it has one rectangle, or it covers more than three quarters of the box (cutting costs more than it saves).
fn rgn_take(state: u64, out: u64, bx0: u64, by0: u64, bx1: u64, by1: u64) -> u64 {
    if !rgn_lock(state) {
        return 0
    }
    let off: bool = fb.rgn_aus(state)
    let r: u64 = state + kstate.WM_OFF + S_RGN
    var n: u64 = region.region_count(r)
    let bad: u64 = gs(state, S_RBAD)
    if off || bad != 0 || n < 2 || region.region_bounds(r, 0) != bx0 as i64 || region.region_bounds(r, 1) != by0 as i64
        || region.region_bounds(r, 2) != bx1 as i64 || region.region_bounds(r, 3) != by1 as i64 {
        n = 0
    }
    let box_area: u64 = (bx1 - bx0) * (by1 - by0)
    let area: u64 = region.region_area(r)
    if n != 0 && area * 100 > box_area * 75 {
        n = 0
    }
    if n != 0 {
        var i: u64 = 0
        while i < n {
            var k: u64 = 0
            while k < 4 {
                __mmio_write64((out + (i * 4 + k) * 8) as *mut u64, region.region_rect(r, i, k) as u64)
                k = k + 1
            }
            i = i + 1
        }
        ss(state, S_RSAVED, gs(state, S_RSAVED) + (box_area - area))
        if pixelguard.bug_is(5) && n >= 2 {
            var bk: u64 = 0
            while bk < 4 {
                __mmio_write64((out + (4 + bk) * 8) as *mut u64, __mmio_read64((out + ((n - 1) * 4 + bk) * 8) as *mut u64))
                bk = bk + 1
            }
            n = n - 1
        }
    }
    region.region_clear(r)
    ss(state, S_RBAD, 0)
    rgn_unlock(state)
    return n
}

fn damage(state: u64, x0: i64, y0: i64, x1: i64, y1: i64) {
    damage_ex(state, x0, y0, x1, y1, 0)
}

// r461: `skip` says whose blurred picture this change CANNOT spoil. The blur of a window is made from what lies UNDER it; the
// pointer is painted over everything and a window's own contents are painted over its own blur, so neither makes the cached
// blur wrong. Before this, every pointer move and every hover row of the start menu threw its blur away and the menu was
// filtered again (37 times in 56 frames, 27 ms each: `wm: phase` of the menu). 0 = nobody (every change counts), BT_ALL = the
// pointer (no blur is spoiled), i + 1 = window i's own contents.
const BT_ALL: u64 = 0xFFFFFFFF

fn damage_ex(state: u64, x0: i64, y0: i64, x1: i64, y1: i64, skip: u64) {
    if !ready(state) {
        return
    }
    if skip != 0 && skip <= frameprof.SLOTS {
        frameprof.note(state, skip - 1, win_owner(state, skip - 1))
    }
    if gs(state, S_NODIRTY) != 0 {
        damage_all(state)
        return
    }
    var a: i64 = x0
    var b: i64 = y0
    var c: i64 = x1
    var d: i64 = y1
    if a < 0 {
        a = 0
    }
    if b < 0 {
        b = 0
    }
    if c > gs(state, S_SW) as i64 {
        c = gs(state, S_SW) as i64
    }
    if d > gs(state, S_SH) as i64 {
        d = gs(state, S_SH) as i64
    }
    if c <= a || d <= b {
        return
    }
    let pre_a: i64 = a
    let pre_b: i64 = b
    let pre_c: i64 = c
    let pre_d: i64 = d
    // RUNDE BLUR: DIE UNGUELTIGKEITSERKLAERUNG, an der EINEN Stelle,
    // durch die jede Aenderung dieses Servers geht. Schneidet das
    // gemeldete Rechteck die weichgezeichnete Flaeche, ist ihr
    // Zwischenspeicher hin; liegt es daneben, bleibt er gueltig.
    // Deshalb steht der Ruf HIER und nicht in `compose` -- in `compose`
    // waere schon zusammengefasst, was hier noch einzeln ankommt.
    blur_touch(state, a, b, c, d, skip)
    // W-WINOPTS S4: the same rule for the brightness behind a window
    bl_touch(state, a, b, c, d, skip)
    // ================================================= RUNDE GLAS
    //
    // DIE SCHLIERENREGEL, UND WARUM ES OHNE SIE WIRKLICH SCHLIEREN GIBT.
    //
    // Solange die Leiste DECKEND kopiert wurde, war es gleichgueltig,
    // was unter ihr lag: ihre Bildpunkte haengen von nichts ab. Sobald
    // sie mischt, haengt JEDER ihrer Bildpunkte vom Untergrund ab --
    // und der Schmutz eines bewegten Fensters ist sein altes und sein
    // neues Rechteck. Schiebt man ein Fenster unter der Leiste nach
    // links, wird nur der Teil der Leiste neu gemischt, unter dem das
    // Fenster war oder ist; der Rest behaelt die Mischung aus dem
    // vorigen Bild und zeigt einen Schatten des Fensters an einer
    // Stelle, an der es nicht mehr steht. Genau das ist die Schliere.
    //
    // Also: schneidet ein gemeldetes Rechteck das Rechteck der Leiste,
    // wird es auf die VOLLE Leiste aufgezogen -- und zwar nur, solange
    // die Leiste ueberhaupt mischt. Bei voller Deckung und ohne
    // Milchglas ist es Bildpunkt fuer Bildpunkt der Weg vor der Runde.
    //
    // `S_PANELGROW` zaehlt, wie oft die Regel zugetroffen hat.
    // `noglasgrow` schaltet sie ab; dann MUSS die Abnahme Schlieren
    // finden, sonst hat sie nie etwas geprueft.
    if gs(state, S_NOGROW) == 0
        && (form_or(state, FM_TB_ALPHA, 100) < 100
            || form(state, FM_BLUR) > 0) {
        let pw: u64 = panel_win(state)
        if pw < MAX_WIN {
            let px0: i64 = win_x(state, pw)
            let py0: i64 = win_y(state, pw)
            let px1: i64 = px0 + outer_w(state, pw) as i64
            let py1: i64 = py0 + outer_h(state, pw) as i64
            if c > px0 && a < px1 && d > py0 && b < py1 {
                if px0 < a {
                    a = px0
                }
                if py0 < b {
                    b = py0
                }
                if px1 > c {
                    c = px1
                }
                if py1 > d {
                    d = py1
                }
                if a < 0 {
                    a = 0
                }
                if b < 0 {
                    b = 0
                }
                if c > gs(state, S_SW) as i64 {
                    c = gs(state, S_SW) as i64
                }
                if d > gs(state, S_SH) as i64 {
                    d = gs(state, S_SH) as i64
                }
                ss(state, S_PANELGROW, gs(state, S_PANELGROW) + 1)
                // Der Beweis, dass die Regel wirklich zugetroffen hat
                // -- beim ersten Mal und danach alle fuenfhundert. Eine
                // Zeile je Schmutzrechteck waere ein Wasserfall im
                // Bildtakt.
                let gz: u64 = gs(state, S_PANELGROW)
                if gz == 1 || gz % 500 == 0 {
                    schlieren_say(state)
                }
            }
        }
    }
    // vboxlag: with `phases`, every dirty rectangle over 16384 px is printed (before / after the glass-bar growth, and whose blur it spares)
    if fb.phases_an(state) && ((c - a) * (d - b)) > 16384 {
        var s_g0: [u8; 9] = "wm: dmg \0"
        var s_g1: [u8; 7] = " pre= \0"
        var s_g2: [u8; 7] = " skip=\0"
        serial.puts((&s_g0[0]) as u64)
        serial.dec(a as u64)
        serial.put(32 as u8)
        serial.dec(b as u64)
        serial.put(32 as u8)
        serial.dec(c as u64)
        serial.put(32 as u8)
        serial.dec(d as u64)
        serial.puts((&s_g1[0]) as u64)
        serial.dec(pre_a as u64)
        serial.put(32 as u8)
        serial.dec(pre_b as u64)
        serial.put(32 as u8)
        serial.dec(pre_c as u64)
        serial.put(32 as u8)
        serial.dec(pre_d as u64)
        serial.puts((&s_g2[0]) as u64)
        serial.dec(skip)
        serial.nl()
    }
    // r53: THE REGION AND THE BOX ARE UPDATED UNDER ONE LOCK, and `compose_one` takes the box and clears `S_DON` under the same lock.
    // Before, a `damage` on one core could read `S_DON == 1`, be held up (a vCPU descheduled by the host), while another core ran a whole
    // `compose_one` (which clears `S_DON`); `damage` then widened the box of a frame that was already taken and never set `S_DON` again:
    // its rectangle was LOST. The lost rectangle was typically the last repaint of a client window (the FreeViewer picture) after a
    // terminal repaint had composed it half-drawn -> a dark rectangle (terminal-sized) in the viewer until the viewer drew again.
    let locked: bool = rgn_lock(state)
    if locked {
        region.region_add(state + kstate.WM_OFF + S_RGN, a, b, c, d)
    } else {
        ss(state, S_RBAD, 1)
    }
    box_add(state, a, b, c, d)
    if locked {
        rgn_unlock(state)
    }
}

// r53: add one rectangle to the dirty box. The caller holds the region lock (or could not get it). `S_DON == 0` means "the box is empty":
// the rectangle becomes the box (never widened by a stale box of a frame that was already taken).
fn box_add(state: u64, a: i64, b: i64, c: i64, d: i64) {
    if gs(state, S_DON) == 0 {
        ss(state, S_DX0, a as u64)
        ss(state, S_DY0, b as u64)
        ss(state, S_DX1, c as u64)
        ss(state, S_DY1, d as u64)
        ss(state, S_DON, 1)
        return
    }
    if (a as u64) < gs(state, S_DX0) {
        ss(state, S_DX0, a as u64)
    }
    if (b as u64) < gs(state, S_DY0) {
        ss(state, S_DY0, b as u64)
    }
    if (c as u64) > gs(state, S_DX1) {
        ss(state, S_DX1, c as u64)
    }
    if (d as u64) > gs(state, S_DY1) {
        ss(state, S_DY1, d as u64)
    }
}

// r53: take the dirty box for one frame: its four numbers go to `out` (x0, y0, x1, y1), `S_DON` is cleared. false = no damage pending.
// Runs under the region lock (the same lock `damage_ex` holds while it adds), so a `damage` is either completely before the take (its
// rectangle is in the box) or completely after it (it starts a new box). Without the lock the old unlocked way runs; a frame is never skipped.
fn box_take(state: u64, out: u64) -> bool {
    if gs(state, S_DON) == 0 {
        return false
    }
    let tk: bool = rgn_lock(state)
    if gs(state, S_DON) == 0 {
        if tk {
            rgn_unlock(state)
        }
        return false
    }
    __mmio_write64(out as *mut u64, gs(state, S_DX0))
    __mmio_write64((out + 8) as *mut u64, gs(state, S_DY0))
    __mmio_write64((out + 16) as *mut u64, gs(state, S_DX1))
    __mmio_write64((out + 24) as *mut u64, gs(state, S_DY1))
    ss(state, S_DON, 0)
    if tk {
        rgn_unlock(state)
    }
    return true
}

fn damage_all(state: u64) {
    // RUNDE GLAS: das ganze Bild ist neu, also auch alles unter der
    // Leiste -- der Milchglasstreifen gilt nicht mehr.
    ss(state, S_GLASSGEN, gs(state, S_GLASSGEN) + 1)
    ss(state, S_DX0, 0)
    ss(state, S_DY0, 0)
    ss(state, S_DX1, gs(state, S_SW))
    ss(state, S_DY1, gs(state, S_SH))
    ss(state, S_DON, 1)
    rgn_all(state)
    // REPAINT-1: a whole-screen change (wallpaper, theme, snap, resolution, Ctrl+Alt+R) spoils every cached blur, too
    var bk: u64 = 0
    while bk < BC_N {
        ss(state, S_BC_GEN + bk * 8, gs(state, S_BC_GEN + bk * 8) + 1)
        bk = bk + 1
    }
}

// RUNDE PAINT: DER SCHATTEN GEHOERT ZUM SCHMUTZ.
//
// Ein Schatten liegt AUSSERHALB des Fensterrechtecks. Meldet ein
// Fenster beim Verschieben nur sein eigenes Rechteck als geaendert,
// bleibt der alte Schatten stehen -- eine Spur aus grauen Raendern
// quer ueber den Schreibtisch. Der erste Entwurf dieser Runde tat
// genau das, und man sah es sofort.
//
// Also: der schmutzige Bereich waechst um die Reichweite des Schattens,
// und zwar auf ALLEN VIER SEITEN. Unten und rechts reicht er weiter
// (der Schatten sitzt einen Bildpunkt tiefer), oben und links wird
// trotzdem dieselbe Zahl genommen -- ein Bereich, der einen Bildpunkt
// zu gross ist, kostet eine Bildzeile; einer, der einen zu klein ist,
// kostet eine sichtbare Kante.
fn damage_win(state: u64, i: u64) {
    damage_win_ex(state, i, 0)
}

fn damage_win_ex(state: u64, i: u64, skip: u64) {
    // RUNDE GLAS: DIESE EINE STELLE SAGT DEM MILCHGLAS, DASS SICH SEIN
    // UNTERGRUND GEAENDERT HAT. `flush_win`, `move_win`, `resize_win`,
    // `raise_win` und `destroy` laufen alle hier durch -- es gibt also
    // keine zweite Stelle, an der ein Fenster sich ruehren koennte.
    glass_touch(state, i)
    // RUNDE SOFTUI: DIE GROESSERE DER BEIDEN REICHWEITEN.
    //
    // Es gibt jetzt zwei Schatten -- einen unter dem scharfen Fenster
    // und einen flacheren unter den uebrigen -- und ein Fenster
    // WECHSELT zwischen ihnen. Der schmutzige Bereich muss deshalb den
    // groesseren der beiden fassen, sonst bleibt beim Fokuswechsel der
    // Rest des tieferen Schattens als grauer Saum stehen. Genau diese
    // Sorte Spur hat Runde PAINT schon einmal gejagt.
    var r: i64 = form(state, FM_SHADOW_R) as i64
    let r2: i64 = form(state, FM_SHADOW_R2) as i64
    if r2 > r {
        r = r2
    }
    if form(state, FM_SHADOW) == 0 && form(state, FM_SHADOW2) == 0 {
        r = 0
    }
    if !deko(state, i) {
        r = 0
    }
    var x0: i64 = win_x(state, i) - r
    var y0: i64 = win_y(state, i) - r
    if x0 < 0 {
        x0 = 0
    }
    if y0 < 0 {
        y0 = 0
    }
    damage_ex(state, x0, y0,
        win_x(state, i) + outer_w(state, i) as i64 + r + 1,
        win_y(state, i) + outer_h(state, i) as i64 + r + 1, skip)
}

fn dirty_x0(state: u64) -> u64 {
    return gs(state, S_DX0)
}

fn dirty_y0(state: u64) -> u64 {
    return gs(state, S_DY0)
}

fn dirty_x1(state: u64) -> u64 {
    return gs(state, S_DX1)
}

fn dirty_y1(state: u64) -> u64 {
    return gs(state, S_DY1)
}

// ------------------------------------------------------ die Fenster

fn create(state: u64, owner: u64, x: i64, y: i64, w: u64, h: u64,
    kind: u64, title: u64) -> u64 {
    return create_ex(state, owner, x, y, w, h, kind, title, 0, 0, 0)
}

// `sbase` != 0: the buffer is the run of frames of shared object `sidx` (`sbytes` long, one reference taken for the window) and not
// a run of the server's own -- the client paints into it and the compositor reads it from there (docs/COMPOSITOR.md S3).
fn create_ex(state: u64, owner: u64, x: i64, y: i64, w: u64, h: u64,
    kind: u64, title: u64, sbase: u64, sbytes: u64, sidx: u64) -> u64 {
    if !ready(state) || w < 32 || h < 16 || w > MAX_W_HARD
        || h > MAX_H_HARD {
        return MAX_WIN
    }
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) == 0 {
            let bytes: u64 = w * h * 4
            var rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
            var buf: u64 = 0
            var kshm: u64 = 0
            if sbase != 0 {
                if sbytes < bytes || kind == K_TERM {
                    return MAX_WIN
                }
                buf = sbase
                rahmen = sbytes / mem.FRAME_SIZE
            } else {
                // COMPOSITOR r486 (terminal): the grid is painted by the kernel into the window's buffer; the buffer is a shared object the
                // kernel made itself, so the compositor in ring 3 can map it read-only (WM_BUFFD) and judge the terminal as a plain window.
                // The word `noshare` (or no object / no contiguous run to be had) leaves the old private run of frames.
                if kind == K_TERM {
                    kshm = kern_shared(state, bytes)
                    if kshm != 0 {
                        buf = unixsock.shm_frame(state, kshm - 1, 0)
                        rahmen = unixsock.shm_pages(state, kshm - 1)
                    }
                }
                if buf == 0 {
                    buf = mem.frame_run(state, rahmen)
                }
            }
            if buf == 0 {
                return MAX_WIN
            }
            wsv(state, i, W_USED, 1)
            wsv(state, i, W_ID, gs(state, S_NEXTID))
            ss(state, S_NEXTID, gs(state, S_NEXTID) + 1)
            wsv(state, i, W_OWNER, owner)
            // ==================================== RUNDE BLECHDREI
            // EIN FENSTER FAENGT UNTER DER ARBEITSFLAECHE AN.
            //
            // Der Schreibtisch legt sein Terminalfenster auf feste
            // Koordinaten (x=24, y=40). Mit dem reservierten Band der
            // Messtafel lag es damit VOLLSTAENDIG darunter und wurde von
            // `fb` weggeschnitten -- ein Fenster, das es gibt, das man
            // aber nicht sieht. Ein Strut, den nur die Maximierung
            // beachtet, ist keiner.
            //
            // Nur nach UNTEN geschoben, nie verkleinert, und nur wenn es
            // ein Band gibt: bei `nostrut` und auf schmalen Schirmen ist
            // `work_y` null und diese Zeilen tun nichts. Deshalb sehen
            // die Laeufe in tools/wm/run.sh dieselben Koordinaten wie
            // vorher.
            var wy: i64 = y
            let oben: i64 = gs(state, S_WORK_Y) as i64
            if wy < oben {
                wy = oben
            }
            wsv(state, i, W_X, x as u64)
            wsv(state, i, W_Y, wy as u64)
            wsv(state, i, W_W, w)
            wsv(state, i, W_H, h)
            wsv(state, i, W_BUF, buf)
            wsv(state, i, W_BUFBYTES, rahmen * mem.FRAME_SIZE)
            wsv(state, i, W_SHM, 0)
            wsv(state, i, W_CURSOR, 0)
            wsv(state, i, W_BL_MEAN, 0)
            wsv(state, i, W_BL_RUNS, 0)
            wsv(state, i, W_BL_HITS, 0)
            if sbase != 0 {
                unixsock.shm_ref(state, sidx)
                wsv(state, i, W_SHM, sidx + 1)
                ss(state, S_SH_ATT, gs(state, S_SH_ATT) + 1)
            } else if kshm != 0 {
                // the object's first reference is the window's own (no client holds one)
                wsv(state, i, W_SHM, kshm)
                ss(state, S_TM_SH, gs(state, S_TM_SH) + 1)
            }
            wsv(state, i, W_KIND, kind)
            wsv(state, i, W_EHEAD, 0)
            wsv(state, i, W_ETAIL, 0)
            wsv(state, i, W_FG, deco(state, DK_TERM_FG))
            wsv(state, i, W_BG, deco(state, DK_TERM_BG))
            wsv(state, i, W_GRID, 0)
            wsv(state, i, W_KEYS, 0)
            wsv(state, i, W_LAYER, L_NORMAL)
            wsv(state, i, W_FLAGS, 0)
            wsv(state, i, W_STRUT, 0)
            wsv(state, i, W_SAVE, 0)
            // RUNDE PAINT: ein wiederverwendeter Platz erbt sonst den
            // Buendelnamen des VORIGEN Fensters -- und damit sein
            // Symbol. Genau die Sorte Fehler, die man erst sieht, wenn
            // das sechzehnte Fenster aufgeht.
            let _cl: bool = set_app(state, i, 0)
            // ====================================== RUNDE ZIEH
            // UND DER NACHZUG DES VORIGEN FENSTERS AUCH NICHT.
            //
            // Derselbe Grund wie beim Buendelnamen eine Zeile
            // darueber: ein wiederverwendeter Platz erbt sonst den
            // Bildversatz des Fensters, das hier vorher lag -- und
            // das neue Fenster erschiene beim ersten Bild um bis zu
            // 48 Bildpunkte verschoben, ohne dass es je jemand
            // gezogen haette. Die Sorte Fehler, die man erst beim
            // sechzehnten Fenster sieht.
            wsv(state, i, W_SWX, 0)
            wsv(state, i, W_SWY, 0)
            wsv(state, i, W_SWOFF, 0)
            // RUNDE BLUR: und die Deckung auch nicht -- ein
            // wiederverwendeter Platz waere sonst durchsichtig, ohne
            // dass es jemand bestellt hat.
            wsv(state, i, W_OPAC, 0)
            wsv(state, i, W_DRAGX, 0)
            wsv(state, i, W_DXLAST, 0)
            wsv(state, i, W_DYLAST, 0)
            wsv(state, i, W_Z, gs(state, S_COUNT))
            ss(state, S_COUNT, gs(state, S_COUNT) + 1)
            // RUNDE DESKTOP: ein neues Fenster kommt an die Oberkante
            // SEINER Ebene und nicht an die Oberkante von allem. Solange
            // es keine Taskleiste gibt, ist das dasselbe; sobald es eine
            // gibt, ist es der Unterschied zwischen einer Leiste und
            // einem Fenster, das sie verdeckt.
            raise_win(state, i)
            set_title(state, i, title)
            fill(state, i, 0, 0, w, h, wg(state, i, W_BG))
            if kind == K_TERM {
                term_setup(state, i)
            }
            set_focus(state, i)
            damage_win(state, i)
            if gs(state, S_TILE) != 0 {
                tile_take(state, i)
            }
            // RUNDE WMPLUGIN: ABLEGEN UND WEITERGEHEN. `notify` schreibt
            // in hoechstens acht Ringe und kehrt zurueck -- hier wird
            // auf kein Ring-3-Programm gewartet, auch nicht kurz.
            wmplug.notify(state, wmplug.E_WIN_OPEN, wg(state, i, W_ID),
                wg(state, i, W_LAYER), 0)
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

// RUNDE PAINT: der Buendelname des Fensters. Wie `set_title`
// abgeschnitten statt abgelehnt -- ein zu langer Name ist kein Grund,
// ein Fenster zu verweigern -- und immer nullterminiert.
fn set_app(state: u64, i: u64, p: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    var k: u64 = 0
    while k < APP_LEN - 1 {
        var c: u64 = 0
        if p != 0 {
            c = kstate.get8(p + k)
        }
        kstate.set8(state + wat(i) + W_APP + k, c as u8)
        if c == 0 {
            k = APP_LEN - 1
        } else {
            k = k + 1
        }
    }
    kstate.set8(state + wat(i) + W_APP + APP_LEN - 1, 0 as u8)
    return true
}

fn win_app(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return 0
    }
    return state + wat(i) + W_APP
}

fn set_title(state: u64, i: u64, p: u64) {
    var k: u64 = 0
    while k < 31 {
        var c: u64 = 0
        if p != 0 {
            c = kstate.get8(p + k)
        }
        kstate.set8(state + wat(i) + W_TITLE + k, c as u8)
        if c == 0 {
            k = 31
        } else {
            k = k + 1
        }
    }
    kstate.set8(state + wat(i) + W_TITLE + 31, 0 as u8)
}

fn destroy(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    frameprof.reset(i)
    tt_forget(state, i)
    tile_release(state, i)
    damage_win(state, i)
    wmplug.notify(state, wmplug.E_WIN_CLOSE, wg(state, i, W_ID), 0, 0)
    // Stirbt der Prozess EINES PLUGINS, faellt sein Fenster hier durch.
    // Der Platz in der Plugintafel haengt aber am Prozess und nicht am
    // Fenster -- aufgeraeumt wird er von `wmplug.sweep` und vom
    // Prozessende in `sysgui.fi`.
    let z: u64 = wg(state, i, W_Z)
    // ADDENDUM TASKBAR: a window that reserved a screen edge gives the
    // edge back when it dies. Without this the work area would stay
    // small after the taskbar exits, and every window maximized after
    // that would leave a strip of empty desktop.
    let hatte_strut: bool = wg(state, i, W_STRUT) != 0
    wsv(state, i, W_STRUT, 0)
    wsv(state, i, W_USED, 0)
    if wg(state, i, W_BUF) != 0 {
        if wg(state, i, W_SHM) != 0 {
            // a shared buffer belongs to its object: the window gives back its reference, the client's mapping keeps the frames until it lets go
            unixsock.shm_unref(state, wg(state, i, W_SHM) - 1)
            wsv(state, i, W_SHM, 0)
        } else {
            mem.frame_free_run(state, wg(state, i, W_BUF),
                wg(state, i, W_BUFBYTES) / mem.FRAME_SIZE)
        }
        wsv(state, i, W_BUF, 0)
    }
    if wg(state, i, W_GRID) != 0 {
        mem.frame_free_run(state, wg(state, i, W_GRID), TG_FRAMES)
        wsv(state, i, W_GRID, 0)
    }
    sb_free(state, i)
    // Die Stapelreihenfolge schliesst sich: wer ueber dem geschlossenen
    // Fenster lag, rutscht eine Stufe herunter. Ohne das entstehen
    // Luecken, und `compose` findet auf einer Stufe kein Fenster mehr.
    var k: u64 = 0
    while k < MAX_WIN {
        if wg(state, k, W_USED) != 0 && wg(state, k, W_Z) > z {
            wsv(state, k, W_Z, wg(state, k, W_Z) - 1)
        }
        k = k + 1
    }
    ss(state, S_COUNT, gs(state, S_COUNT) - 1)
    if focus(state) == i {
        ss(state, S_FOCUS, 0)
        // Der Fokus geht an das oberste verbliebene SICHTBARE Fenster
        // der normalen Ebene -- nicht an den Schreibtisch und nicht an
        // die Taskleiste.
        let o: u64 = top_visible(state)
        if o < MAX_WIN {
            set_focus(state, o)
        }
    }
    if gs(state, S_DRAG) == i + 1 {
        ss(state, S_DRAG, 0)
    }
    if gs(state, S_SIZING) == i + 1 {
        ss(state, S_SIZING, 0)
    }
    // ==================================== RUNDE BLECHFUENF
    // WAS SONST NOCH AUF DIESES FENSTER ZEIGT.
    //
    // Justin klickt auf das Kreuz, und danach ist die Maschine weg.
    // `S_DRAG` und `S_SIZING` waren gedacht, `S_CAPHOV` nicht -- und
    // GENAU DAS ist der Zustand nach einem Klick auf das Kreuz: der
    // Zeiger stand ueber dem Knopf, also stand dort die Nummer dieses
    // Fensters, und der naechste `cap_track` faerbt eine Schaltflaeche
    // an einem Fenster, das es nicht mehr gibt. Wird der Platz danach
    // neu vergeben, faerbt er die des NEUEN.
    if gs(state, S_CAPHOV) != 0 && (gs(state, S_CAPHOV) - 1) / 4 == i {
        ss(state, S_CAPHOV, 0)
    }
    // UND DIE MASSE AUF NULL. `destroy` hat den Puffer freigegeben und
    // W_BUF genullt, die BREITE und HOEHE aber stehen gelassen. Ein
    // Weg, der die Gueltigkeit nicht prueft, rechnet damit ein
    // plausibles Rechteck aus und schreibt es an die Anschrift null --
    // also mitten in die Seitentafeln des Kerns. Mit Nullen kommt er
    // ueber die erste Schleifenbedingung nicht hinaus.
    wsv(state, i, W_W, 0)
    wsv(state, i, W_H, 0)
    wsv(state, i, W_COLS, 0)
    wsv(state, i, W_ROWS, 0)
    wsv(state, i, W_CX, 0)
    wsv(state, i, W_CY, 0)
    wsv(state, i, W_KIND, 0)
    wsv(state, i, W_CURSOR, 0)
    wsv(state, i, W_BL_MEAN, 0)
    wsv(state, i, W_BL_RUNS, 0)
    wsv(state, i, W_BL_HITS, 0)
    wsv(state, i, W_EHEAD, 0)
    wsv(state, i, W_ETAIL, 0)
    if hatte_strut {
        recalc_work(state)
    }
    return true
}

// ============================================ RUNDE BLECHFUENF
// DAS OBERSTE FENSTER ZUMACHEN -- GENAU SO WIE DAS KREUZ.
//
// Kein zweiter Weg neben `on_mouse`, sondern DIESELBEN ZWEI ZEILEN:
// erst das Ereignis in den Ring des Fensters, dann `destroy`. Waere es
// ein anderer Weg, waere die Gegenprobe wertlos.
// DIE MITTE DES SCHLIESSKREUZES eines Fensters, gepackt (x << 32) | y.
// Damit kann die Gegenprobe wirklich DORTHIN klicken, wo Justin
// geklickt hat -- und nicht einen zweiten Schliessweg neben dem Kreuz
// benutzen, der die Haelfte der Arbeit auslaesst.
fn cross_point(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    let bx: i64 = cap_x0(state, i) + (CAP_CLOSE * cap_w(state)) as i64
        + (cap_w(state) / 2) as i64
    let by: i64 = win_y(state, i) + border(state) as i64
        + ((title_h(state) - 1 - border(state)) / 2) as i64
    if bx < 0 || by < 0 {
        return 0
    }
    return ((bx as u64) << 32) | (by as u64)
}

fn term_win(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_KIND) == K_TERM {
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

// ---------------------------------------------------- die drei Anlaesse
//
// DREI EINSTIEGE UND EIN FALLBACK, und der Fallback ist der Kern der
// Sache: ist die Bewegung abgeschaltet (Formmarke motion=0 oder die
// Gegenprobe `noanim`), tut jede dieser Funktionen SOFORT das, was sie
// zusagt. Der Endzustand haengt nie an der Bewegung -- ein Fenster, das
// geschlossen werden soll, wird geschlossen, ob es dabei schrumpft oder
// nicht. Das ist der Unterschied zwischen "reduziert" und "kaputt".

// Ein neues Fenster waechst auf. Der Aufrufer hat es schon angelegt.
fn open_anim(state: u64, i: u64) -> bool {
    return anim_start(state, i, AN_OPEN)
}

// Schliessen ueber die Bewegung. Das Fenster verschwindet erst, wenn
// sie durch ist -- `anim_tick` ruft dann `destroy`. Ohne Bewegung
// geschieht genau das sofort.
fn close_anim(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    ev_push(state, i, E_CLOSE, 0, 0, 0)
    if !anim_start(state, i, AN_CLOSE) {
        destroy(state, i)
        return false
    }
    return true
}

// Minimieren ueber die Bewegung. Dasselbe Bild wie beim Schliessen,
// aber am Ende steht `set_hidden` und nicht `destroy`.
fn minimize_anim(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if !anim_start(state, i, AN_MIN) {
        set_hidden(state, i, true)
        return false
    }
    return true
}

// DAS ZIEL DES MINIMIERENS SETZEN. Die Taskleiste ruft das fuer ein
// FREMDES Fenster; die Rechtepruefung sitzt in `sysgui.fi` und ist
// dieselbe wie bei WM_ACT (der Rufende muss selbst ein Fenster auf der
// Leistenebene haben).
//
// Ein Rechteck mit Breite oder Hoehe 0 LOESCHT das Ziel -- ein Knopf,
// der verschwindet, weil das Fenster nicht mehr in die Leiste passt,
// soll wieder mittig schrumpfen und nicht auf einen Punkt zielen, den
// es nicht mehr gibt.
fn set_min_rect(state: u64, i: u64, x: i64, y: i64, w: u64, h: u64)
    -> bool {
    if !valid(state, i) {
        return false
    }
    if w == 0 || h == 0 {
        wsv(state, i, W_MINWH, 0)
        return true
    }
    wsv(state, i, W_MINXY,
        ((x as u64) & 0xFFFFFFFF) | (((y as u64) & 0xFFFFFFFF) << 32))
    wsv(state, i, W_MINWH, (w & 0xFFFFFFFF) | ((h & 0xFFFFFFFF) << 32))
    return true
}

fn min_rect_w(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return wg(state, i, W_MINWH) & 0xFFFFFFFF
}

fn close_top(state: u64) -> u64 {
    let i: u64 = top_visible(state)
    if i >= MAX_WIN {
        return MAX_WIN
    }
    ev_push(state, i, E_CLOSE, 0, 0, 0)
    destroy(state, i)
    return i
}

// DAS TERMINALFENSTER. Justins Foto zeigt "Terminal -- sh" mit dem
// Kreuz, auf das er geklickt hat -- also ist DAS das Fenster, das die
// Gegenprobe zuerst zumachen muss und nicht irgendeines.
fn close_term(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_KIND) == K_TERM {
            ev_push(state, i, E_CLOSE, 0, 0, 0)
            destroy(state, i)
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

fn topmost(state: u64) -> u64 {
    var beste: u64 = MAX_WIN
    var bz: u64 = 0
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 {
            if beste == MAX_WIN || wg(state, i, W_Z) >= bz {
                beste = i
                bz = wg(state, i, W_Z)
            }
        }
        i = i + 1
    }
    return beste
}

// DAS OBERSTE SICHTBARE FENSTER DER NORMALEN EBENE. Es ist das, an das
// der Fokus faellt, wenn eines geschlossen oder minimiert wird -- und
// es ist ausdruecklich NICHT der Schreibtisch und NICHT die
// Taskleiste. Beide nehmen die Tastatur nicht an; wer in einer
// Taskleiste tippt, hat kein Fenster mehr, in dem der Text landet.
fn top_visible(state: u64) -> u64 {
    var beste: u64 = MAX_WIN
    var bz: u64 = 0
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_LAYER) == L_NORMAL {
            if (wg(state, i, W_FLAGS) & F_HIDDEN) == 0 {
                if beste == MAX_WIN || wg(state, i, W_Z) >= bz {
                    beste = i
                    bz = wg(state, i, W_Z)
                }
            }
        }
        i = i + 1
    }
    return beste
}

// AUF WELCHE STUFE GEHOERT EIN FENSTER DER EBENE `l` GANZ OBEN. Gezaehlt
// werden alle belegten Fenster mit kleinerer ODER GLEICHER Ebene --
// einschliesslich des Fensters selbst, wenn es schon belegt ist. Die
// gesuchte Stufe ist eine weniger.
fn zslot(state: u64, l: u64) -> u64 {
    var n: u64 = 0
    var k: u64 = 0
    while k < MAX_WIN {
        if wg(state, k, W_USED) != 0 && layer_rank(wg(state, k, W_LAYER)) <= layer_rank(l) {
            n = n + 1
        }
        k = k + 1
    }
    return n
}

// EIN FENSTER AUF EINE ANDERE STUFE, in beide Richtungen. Runde K10
// hatte nur `raise_win`, und das konnte nur nach oben: es zog alles
// ueber dem Fenster eine Stufe herunter und setzte es an die Spitze.
// Mit Ebenen muss ein Fenster auch SINKEN koennen (ein Schreibtisch,
// der als letztes entsteht, gehoert nach ganz hinten), und das ist die
// andere Haelfte derselben Verschiebung.
fn move_to_z(state: u64, i: u64, ziel: u64) {
    let z: u64 = wg(state, i, W_Z)
    if ziel == z || ziel >= gs(state, S_COUNT) {
        return
    }
    var k: u64 = 0
    while k < MAX_WIN {
        if wg(state, k, W_USED) != 0 && k != i {
            let kz: u64 = wg(state, k, W_Z)
            if z < ziel {
                if kz > z && kz <= ziel {
                    wsv(state, k, W_Z, kz - 1)
                }
            } else {
                if kz >= ziel && kz < z {
                    wsv(state, k, W_Z, kz + 1)
                }
            }
        }
        k = k + 1
    }
    wsv(state, i, W_Z, ziel)
    damage_win(state, i)
}

// Das Fenster auf einer Stufe der Stapelreihenfolge.
fn at_z(state: u64, z: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_Z) == z {
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

// HEBEN HEISST SEIT DER RUNDE DESKTOP: an die Oberkante SEINER EBENE.
// Mit `nolayer` ist es wieder die Oberkante von allem -- und genau
// dann verdeckt der Schreibtisch beim ersten Klick den ganzen
// Bildschirm. Das ist die Gegenprobe, und sie ist eine Zeile.
fn raise_win(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    var ziel: u64 = gs(state, S_COUNT) - 1
    if gs(state, S_NOLAYER) == 0 {
        ziel = zslot(state, wg(state, i, W_LAYER)) - 1
    }
    move_to_z(state, i, ziel)
}

// DIE EBENE EINES FENSTERS SETZEN. Danach wandert es sofort an die
// Oberkante der neuen Ebene -- ein Schreibtisch, der seine Ebene
// bekommt und liegen bleibt, wo er war, waere kein Schreibtisch.
static mut layer_guard: u64 = 0

fn set_layer(state: u64, i: u64, l: u64) {
    if !valid(state, i) || l > L_MAX {
        return
    }
    if wg(state, i, W_LAYER) == l {
        return
    }
    wsv(state, i, W_LAYER, l)
    layer_guard = i + 1
    // Ein Fenster, das aus der normalen Ebene verschwindet, darf den
    // Eingabefokus nicht mitnehmen.
    //
    // RUNDE VOLLBILD: AUSSER ES IST DAS VOLLBILD. Ein Vollbildfenster
    // liegt auf L_FULL und ist trotzdem das Fenster, in dem der Mensch
    // arbeitet -- naehme man ihm hier den Fokus, ginge das zweite F11
    // ins Leere und der Schirm waere gesperrt. Genau der Fall, den
    // Justin als "sonst ist der Schirm gesperrt" benannt hat.
    if l != L_NORMAL && l != L_FULL && focus(state) == i
        && (wg(state, i, W_FLAGS) & F_KEYS) == 0 {
        ss(state, S_FOCUS, 0)
        // RUNDE ECHTHARDWARE-4: ZURUECK ZU DEM, DER IHN HATTE.
        // Der Grund steht bei S_FOCUS_PREV. `top_visible` bleibt der
        // zweite Weg -- fuer den Fall, dass der Vorbesitzer inzwischen
        // weg oder verborgen ist.
        let before: u64 = gs(state, S_FOCUS_PREV)
        if before != 0 && before - 1 != i && valid(state, before - 1)
            && (wg(state, before - 1, W_FLAGS) & F_HIDDEN) == 0 {
            set_focus(state, before - 1)
        } else {
            let o: u64 = top_visible(state)
            if o < MAX_WIN {
                set_focus(state, o)
            }
        }
    }
    layer_guard = 0
    raise_win(state, i)
    damage_all(state)
}

// MINIMIEREN UND WIEDERHERSTELLEN. Ein verborgenes Fenster wird nicht
// zusammengesetzt und nimmt keinen Klick an -- es LEBT aber weiter, sein
// Puffer bleibt liegen, seine Ereignisse laufen weiter auf. Das ist der
// ganze Unterschied zu `destroy`, und er ist der Grund, warum ein
// Leistenknopf ein Fenster zurueckholen kann.
//
// `nomin` ist die Gegenprobe und tut hier NICHTS -- und deshalb bleibt
// das Fenster dann stehen, obwohl der Knopf gedrueckt wurde.
fn set_hidden(state: u64, i: u64, h: bool) {
    if !valid(state, i) {
        return
    }
    if gs(state, S_NOMIN) != 0 {
        return
    }
    let f: u64 = wg(state, i, W_FLAGS)
    if h {
        if (f & F_HIDDEN) != 0 {
            return
        }
        wsv(state, i, W_FLAGS, f | F_HIDDEN)
        // RUNDE OBERFLAECHE: EINE LAUFENDE BEWEGUNG ENDET HIER.
        //
        // Das Startmenue legt sein Fenster an und verbirgt es sofort
        // wieder. Mit der Oeffnungsbewegung aus WM_CREATE lief danach
        // eine Bewegung auf einem Fenster, das niemand sieht -- und
        // beim naechsten Aufklappen stand `W_ANK` noch, also malte
        // `paint_win_anim` das Menue geschrumpft und durchscheinend
        // statt fertig. Gemessen als `fl=19` dort, wo `fl=18` stehen
        // muss (tools/logind, Abschnitt 5).
        //
        // `W_ANP` bleibt auf 1000: wer nicht mehr in Bewegung ist,
        // ist FERTIG und nicht auf halbem Weg.
        wsv(state, i, W_ANK, 0)
        wsv(state, i, W_ANP, 1000)
        // ====================================== RUNDE ZIEH
        // UND DER NACHZUG ENDET HIER EBENSO.
        //
        // Genau dieselbe Lehre, die der Kommentar darueber aus der
        // vorigen Runde zieht: was ein Fenster aus dem Bild nimmt,
        // muss JEDE laufende Bewegung daran beenden -- nicht nur die,
        // die es gestartet hat. Bliebe der Versatz stehen, kaeme das
        // Fenster beim naechsten Zeigen um bis zu 48 Bildpunkte
        // verschoben zurueck, und `swing_tick` wuerde ihn erst ueber
        // mehrere Bilder wieder einfangen.
        wsv(state, i, W_SWX, 0)
        wsv(state, i, W_SWY, 0)
        wsv(state, i, W_SWOFF, 0)
        ss(state, S_HIDES, gs(state, S_HIDES) + 1)
        // ADDENDUM TASKBAR: a window nobody can see reserves nothing.
        if wg(state, i, W_STRUT) != 0 {
            recalc_work(state)
        }
        damage_win(state, i)
        if focus(state) == i {
            ss(state, S_FOCUS, 0)
            let o: u64 = top_visible(state)
            if o < MAX_WIN {
                set_focus(state, o)
            }
        }
        if gs(state, S_DRAG) == i + 1 {
            ss(state, S_DRAG, 0)
        }
        if gs(state, S_SIZING) == i + 1 {
            ss(state, S_SIZING, 0)
        }
    } else {
        if (f & F_HIDDEN) == 0 {
            return
        }
        wsv(state, i, W_FLAGS, f & ~F_HIDDEN)
        // Und dasselbe beim Zeigen: ein Fenster, das aus der Leiste
        // zurueckkommt, steht sofort ganz da.
        wsv(state, i, W_ANK, 0)
        wsv(state, i, W_ANP, 1000)
        ss(state, S_SHOWS, gs(state, S_SHOWS) + 1)
        if wg(state, i, W_STRUT) != 0 {
            recalc_work(state)
        }
        damage_win(state, i)
    }
}

fn set_deco(state: u64, i: u64, on: bool) {
    if !valid(state, i) {
        return
    }
    let f: u64 = wg(state, i, W_FLAGS)
    damage_win(state, i) // das ALTE Rechteck, samt Rahmen
    if on {
        wsv(state, i, W_FLAGS, f & ~F_NODECO)
    } else {
        wsv(state, i, W_FLAGS, f | F_NODECO)
    }
    damage_win(state, i) // und das neue, ohne
}

// ==================== ADDENDUM TASKBAR: STRUTS AND THE WORK AREA ====
//
// THE PROBLEM, stated plainly. Round DESKTOP gave this system a
// taskbar, and it is a window like any other. A window made as large as
// the screen is therefore drawn OVER it; a window placed under it is
// invisible. As long as the taskbar always sat at the bottom edge one
// could hard-code 28 pixels somewhere and move on. It no longer always
// sits at the bottom.
//
// X11 solved this in 1997 with a window property named `_NET_WM_STRUT`:
// a window declares how many pixels of which screen edge it occupies,
// the window manager subtracts every strut from the screen, and calls
// what is left the WORK AREA. All layout arithmetic uses the work area
// and not the screen. This is the same idea in a form that fits a
// kernel with no properties and no atoms: ONE WORD in the window
// record, and four scalars for the result.
//
// WHY IT LIVES IN THE SERVER AND NOT IN THE TASKBAR. Because the
// taskbar is not the only one who needs the answer. The round TILING
// running in parallel on this tree turns the window system into a tree
// of frames, and the ROOT RECTANGLE of that tree is exactly this work
// area -- not the screen. If the reservation lived inside the taskbar,
// every other client would have to ask the taskbar, and a client that
// does not know a taskbar exists would get it wrong and never find out.
//
// THE INTERFACE, and TILING should need nothing beyond it:
//
//     work_x(state), work_y(state), work_w(state), work_h(state)
//         the free rectangle. Never degenerate: a strut that would eat
//         the screen is refused, see `recalc_work`.
//     set_strut(state, i, edge, size) -> bool
//         declare (size > 0) or clear (size == 0) a reservation.
//         Recomputes the work area and refits every maximized window
//         in the same breath.
//     maximize(state, i, on) -> bool
//         fill the WORK AREA, not the screen, and remember where the
//         window was. This is the one call a tiling layout would
//         replace; the work area underneath it stays as it is.
//
// THE RULE, one sentence: whoever changes a strut, a screen size or the
// visibility of a strut-holding window calls `recalc_work`, and
// `recalc_work` refits the maximized windows. Nobody caches the work
// area anywhere else. There is exactly one copy of this state.
//
// THE COUNTER-TEST is `nostrut` and it is one branch: with it the work
// area is the whole screen again, a maximized window covers the taskbar
// and the taskbar is gone from the picture. That is the state this
// addendum removes, and it has to be reachable to be measurable.

fn uisc(state: u64) -> u64 {
    let v: u64 = gs(state, S_UISC)
    if v == 0 || v > 4 {
        return 1
    }
    return v
}

fn set_uiscale(state: u64, v: u64) {
    if v >= 1 && v <= 4 {
        ss(state, S_UISC, v)
    }
}

// r402: the three measures come from the form slots (0 = the constants of the old stand).
// The bar is `bar` design points high, below it one separator line, around it the frame:
// `title_h` is the whole top part of the outer rectangle (frame + bar + separator).
fn frame_d(state: u64) -> u64 {
    let v: u64 = form(state, FM_FRAME)
    if v == 0 {
        return BORDER0
    }
    return v
}

fn bar_d(state: u64) -> u64 {
    let v: u64 = form(state, FM_TITLE_BAR)
    if v == 0 {
        return TITLE_H0 - 1 - BORDER0
    }
    return v
}

fn title_h(state: u64) -> u64 {
    return (frame_d(state) + bar_d(state) + 1) * uisc(state)
}

fn border(state: u64) -> u64 {
    return frame_d(state) * uisc(state)
}

fn title_pad(state: u64) -> u64 {
    return TITLE_PAD0 * uisc(state)
}

// DELL ROUND (04.10.2026, Justin): the title sat closer to the top edge than the
// bottom. The baseline was border + ascent, i.e. the line box started at the top
// of the bar and all the spare height ended up below it. A first try centred
// the whole line box (ascent + descent) -- measured on the pictures that still
// left 3 px above and 5 px below, because a title is mostly ascenders and few
// descenders: the line box is not what the eye centres. Now the INK is centred:
// its height is the height of a tall letter, about four fifths of the font size
// (measured: 12 rows at 15 px), between the border and the bottom of the title
// bar. The result is the baseline offset from the window's top edge; the
// descenders are kept inside the bar. Same formula at every ui scale (px, the
// bar and the border all scale together).
fn title_base(state: u64, f: u64) -> i64 {
    let px: u64 = gs(state, S_PX_UI)
    let asc: i64 = ttf.ascent(state, f, px)
    if fb.winfix_aus(state) {
        return border(state) as i64 + asc
    }
    let desc: i64 = ttf.descent(state, f, px)
    let ink: i64 = ((px * 4 + 2) / 5) as i64
    let bar: i64 = title_h(state) as i64 - border(state) as i64
    var base: i64 = border(state) as i64 + (bar + ink) / 2
    // descenders stay inside the bar
    let lowest: i64 = title_h(state) as i64 - 1 - desc
    if base > lowest {
        base = lowest
    }
    if base < asc {
        base = asc
    }
    return base
}

fn grip(state: u64) -> u64 {
    return GRIP0 * uisc(state)
}

// ============================================ RUNDE GLAS (nachtrag)
// DIE OBERE GREIFKANTE IST SCHMALER ALS DIE DREI ANDEREN -- UND ZWAR
// WEIL HINTER IHR DIE TITELLEISTE LIEGT UND NICHT DER INHALT.
//
// Links, rechts und unten grenzt der Greifrand an die Malflaeche: acht
// Bildpunkte dort kosten nichts, weil dort ohnehin niemand etwas
// anfasst. Oben grenzt er an die TITELLEISTE, also an die eine
// Flaeche, die es gibt, damit man ein Fenster VERSCHIEBEN kann. Acht
// von zweiundzwanzig Bildpunkten Titelhoehe sind mehr als ein Drittel
// davon -- und wer dort hineingreift, zieht das Fenster nicht, sondern
// zieht seine Oberkante herunter.
//
// GEMESSEN, und das ist der ganze Befund zu Bild 15 dieser Runde: der
// Abnahmelauf zieht bei 400,10 (das Fenster steht bei y=3, die
// Titelschrift beginnt bei y=5) und meinte einen Zug unter die
// Leiste. Auf der Leitung stand statt dessen
//
//     wm: zieh k=4 w=760 h=16 x=20 vorh=31 vory=538
//
// -- vierzehn Mal `zieh` und kein einziges `move`. Das Fenster wurde
// auf seine Mindesthoehe zusammengeschoben, und die Aufnahme zeigte
// einen leeren Rumpf, den alle fuer einen Zeichenfehler hielten. Die
// Schlierenprobe dieser Runde hat damit nie ein bewegtes Fenster
// gesehen.
//
// Der Rahmen selbst plus zwei Bildpunkte bleibt greifbar (vier auf
// einem gewoehnlichen Schirm, acht bei uiscale 2, also genau so viel
// wie Justins Blech vorher hatte) -- die obere Kante laesst sich
// weiter ziehen, sie frisst nur die Titelleiste nicht mehr auf.
// DELL ROUND (04.10.2026, Justin): the top grip was 4 px at scale 1 and
// the cursor never changed there. Now border + 3 px = 5 px (10 at scale
// 2) -- still well under the 22 px title bar, which stays for moving.
fn grip_oben(state: u64) -> u64 {
    if fb.winfix_aus(state) {
        return border(state) + 2 * uisc(state)
    }
    return border(state) + 3 * uisc(state)
}

fn close_w(state: u64) -> u64 {
    return CLOSE_W0 * uisc(state)
}

fn cap_w(state: u64) -> u64 {
    let v: u64 = form(state, FM_CAP_W)
    if v == 0 {
        return CAP_W0 * uisc(state)
    }
    return v * uisc(state)
}

// RUNDE SCHIRM: das groesste Fenster, das dieser Server macht -- die
// Masse des Schirms, gedeckelt auf das, was ein Puffer je Fenster noch
// vertraegt.
fn max_w(state: u64) -> u64 {
    var v: u64 = gs(state, S_SW)
    if v == 0 || v > MAX_W_HARD {
        v = MAX_W_HARD
    }
    return v
}

fn max_h(state: u64) -> u64 {
    var v: u64 = gs(state, S_SH)
    if v == 0 || v > MAX_H_HARD {
        v = MAX_H_HARD
    }
    return v
}

fn work_x(state: u64) -> u64 {
    return gs(state, S_WORK_X)
}

fn work_y(state: u64) -> u64 {
    return gs(state, S_WORK_Y)
}

fn work_w(state: u64) -> u64 {
    return gs(state, S_WORK_W)
}

fn work_h(state: u64) -> u64 {
    return gs(state, S_WORK_H)
}

// ================================================== RUNDE FENSTER
// DIE ARBEITSFLAECHE ALS ZAHLEN -- und daneben der ganze Schirm.
//
// Justins Frage lautet, ob ein maximiertes Fenster die Leiste
// beruehrt. Diese Frage ist nur zu beantworten, wenn beide Rechtecke
// auf der Leitung stehen: die Arbeitsflaeche (wo maximiert enden
// MUSS) und der Schirm (wo Vollbild enden DARF). Die Taskleiste
// meldet ihre Sicht als `taskbar: work` -- diese Zeile ist die des
// Fensterverwalters, und wenn die beiden auseinanderlaufen, ist genau
// das der Fehler.
//
//     wm: work x=0 y=0 w=3440 h=1360  schirm=3440x1440 struts=1
fn work_say(state: u64) {
    var s_h: [u8; 12] = "wm: work x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var s_s: [u8; 10] = "  schirm=\0"
    var s_x2: [u8; 2] = "x\0"
    var s_st: [u8; 9] = " struts=\0"
    serial.puts((&s_h[0]) as u64)
    serial.dec(gs(state, S_WORK_X))
    serial.puts((&s_y[0]) as u64)
    serial.dec(gs(state, S_WORK_Y))
    serial.puts((&s_w[0]) as u64)
    serial.dec(gs(state, S_WORK_W))
    serial.puts((&s_hh[0]) as u64)
    serial.dec(gs(state, S_WORK_H))
    serial.puts((&s_s[0]) as u64)
    serial.dec(gs(state, S_SW))
    serial.puts((&s_x2[0]) as u64)
    serial.dec(gs(state, S_SH))
    serial.puts((&s_st[0]) as u64)
    serial.dec(gs(state, S_STRUTS))
    serial.nl()
}

fn struts(state: u64) -> u64 {
    return gs(state, S_STRUTS)
}

fn workcalcs(state: u64) -> u64 {
    return gs(state, S_WORKCALC)
}

fn nostrut(state: u64) -> bool {
    return gs(state, S_NOSTRUT) != 0
}

fn win_strut_edge(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return EDGE_BOTTOM
    }
    let v: u64 = wg(state, i, W_STRUT)
    if v == 0 {
        return EDGE_BOTTOM
    }
    return (v & 0xFF) - 1
}

fn win_strut_size(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return 0
    }
    return wg(state, i, W_STRUT) >> 8
}

// ================================================== r826 WINDOW SERVER PER OUTPUT
// An extended desktop is ONE wide framebuffer; each output (head) shows one rect of it. The head rects live in
// ONE place, the pointer driver's head table (ps2m.set_head), fed by `heads_sync` from the vgpu extend table. With
// fewer than two heads in that table nothing below changes anything: `hd_x/y/w/h` answer with the whole screen,
// `win_head` is 0 and `head_work` is the old work area.
//
// THE RULES. (1) A window's HOME head is the head its outer rect overlaps most (none: the first existing head).
// (2) The work area is per head: a strut counts for a head only if the strut window overlaps that head's rect.
// (3) Maximize, fullscreen and the drag clamp use the home head's rect/work area. (4) The tile tree and the
// `work_*` scalars stay on the primary head. No new WM scalars (the page is full): the work area of a head is
// computed from scratch and returned packed (x, y, w, h as four 16-bit fields).
const HD_MAX: u64 = 8
const S_HD_SYNCS: u64 = 0x1FF0 // how often `heads_sync` ran
const S_HD_GEN: u64 = 0x1FF8 // hot-plug generation (vgpu.hot_gen) seen by the last `heads_sync`

fn hd_multi(state: u64) -> bool {
    return ps2m.heads(state) >= 2
}

fn hd_present(state: u64, hd: u64) -> bool {
    return hd < HD_MAX && ps2m.head_w(state, hd) != 0
}

// The first head that exists (the primary one); 0 when there is none.
fn hd_primary(state: u64) -> u64 {
    var hd: u64 = 0
    while hd < HD_MAX {
        if ps2m.head_w(state, hd) != 0 {
            return hd
        }
        hd = hd + 1
    }
    return 0
}

// Number of heads that exist (1 on a plain screen).
fn hd_count(state: u64) -> u64 {
    if !hd_multi(state) {
        return 1
    }
    var n: u64 = 0
    var hd: u64 = 0
    while hd < HD_MAX {
        if ps2m.head_w(state, hd) != 0 {
            n = n + 1
        }
        hd = hd + 1
    }
    return n
}

fn hd_x(state: u64, hd: u64) -> u64 {
    if !hd_multi(state) {
        return 0
    }
    return ps2m.head_x(state, hd)
}

fn hd_y(state: u64, hd: u64) -> u64 {
    if !hd_multi(state) {
        return 0
    }
    return ps2m.head_y(state, hd)
}

// r815: suggested UI scale of a head in percent (100..300) from its EDID (vgpu output table); 100 when unknown.
fn hd_scale(state: u64, hd: u64) -> u64 {
    if !hd_multi(state) {
        return vgpu.head_scale(state, 0)
    }
    return vgpu.head_scale(state, hd)
}

fn hd_w(state: u64, hd: u64) -> u64 {
    if !hd_multi(state) {
        return gs(state, S_SW)
    }
    return ps2m.head_w(state, hd)
}

fn hd_h(state: u64, hd: u64) -> u64 {
    if !hd_multi(state) {
        return gs(state, S_SH)
    }
    return ps2m.head_h(state, hd)
}

// Overlap area (px) of head `hd` with the rect [x0,x1) x [y0,y1).
fn hd_overlap(state: u64, hd: u64, x0: i64, y0: i64, x1: i64, y1: i64) -> u64 {
    if !hd_present(state, hd) {
        return 0
    }
    let hx: i64 = ps2m.head_x(state, hd) as i64
    let hy: i64 = ps2m.head_y(state, hd) as i64
    let hx1: i64 = hx + ps2m.head_w(state, hd) as i64
    let hy1: i64 = hy + ps2m.head_h(state, hd) as i64
    var ax: i64 = x0
    if hx > ax {
        ax = hx
    }
    var ay: i64 = y0
    if hy > ay {
        ay = hy
    }
    var bx: i64 = x1
    if hx1 < bx {
        bx = hx1
    }
    var by: i64 = y1
    if hy1 < by {
        by = hy1
    }
    if bx <= ax || by <= ay {
        return 0
    }
    return ((bx - ax) as u64) * ((by - ay) as u64)
}

// The head that shows point (x, y); HD_MAX when none.
fn hd_at(state: u64, x: i64, y: i64) -> u64 {
    var hd: u64 = 0
    while hd < HD_MAX {
        if hd_overlap(state, hd, x, y, x + 1, y + 1) != 0 {
            return hd
        }
        hd = hd + 1
    }
    return HD_MAX
}

// HOME HEAD of a window: the head its outer rect overlaps most; with no overlap at all the primary head.
fn win_head(state: u64, i: u64) -> u64 {
    if !hd_multi(state) || !valid(state, i) {
        return 0
    }
    let x0: i64 = win_x(state, i)
    let y0: i64 = win_y(state, i)
    let x1: i64 = x0 + outer_w(state, i) as i64
    let y1: i64 = y0 + outer_h(state, i) as i64
    var best: u64 = HD_MAX
    var ba: u64 = 0
    var hd: u64 = 0
    while hd < HD_MAX {
        let a: u64 = hd_overlap(state, hd, x0, y0, x1, y1)
        if a > ba {
            ba = a
            best = hd
        }
        hd = hd + 1
    }
    if best == HD_MAX {
        return hd_primary(state)
    }
    return best
}

fn hw_x(p: u64) -> u64 {
    return (p >> 48) & 0xFFFF
}

fn hw_y(p: u64) -> u64 {
    return (p >> 32) & 0xFFFF
}

fn hw_w(p: u64) -> u64 {
    return (p >> 16) & 0xFFFF
}

fn hw_h(p: u64) -> u64 {
    return p & 0xFFFF
}

// THE WORK AREA OF ONE HEAD, from scratch (see `recalc_work` for why nothing is cached). Packed x|y|w|h, 16 bits each.
// On a plain screen this is exactly the old rectangle; with several heads a strut counts only on the heads its window
// overlaps, and the measuring band only on the head at the desktop origin.
fn head_work(state: u64, hd: u64) -> u64 {
    let multi: bool = hd_multi(state)
    let hx: u64 = hd_x(state, hd)
    let hy: u64 = hd_y(state, hd)
    let hw: u64 = hd_w(state, hd)
    let hh: u64 = hd_h(state, hd)
    var x0: u64 = hx
    var y0: u64 = hy
    var x1: u64 = hx + hw
    var y1: u64 = hy + hh
    if gs(state, S_NOSTRUT) == 0 {
        if hx == 0 && hy == 0 {
            let band: u64 = fb.band(state)
            if band > y0 {
                y0 = band
            }
        }
        var i: u64 = 0
        while i < MAX_WIN {
            if wg(state, i, W_USED) != 0 && wg(state, i, W_STRUT) != 0
                && (wg(state, i, W_FLAGS) & F_HIDDEN) == 0 {
                var on: bool = true
                if multi {
                    let sx: i64 = win_x(state, i)
                    let sy: i64 = win_y(state, i)
                    on = hd_overlap(state, hd, sx, sy, sx + outer_w(state, i) as i64,
                        sy + outer_h(state, i) as i64) != 0
                }
                if on {
                    let e: u64 = (wg(state, i, W_STRUT) & 0xFF) - 1
                    let n: u64 = wg(state, i, W_STRUT) >> 8
                    if e == EDGE_TOP {
                        if hy + n > y0 {
                            y0 = hy + n
                        }
                    } else if e == EDGE_BOTTOM {
                        if n < hh && hy + hh - n < y1 {
                            y1 = hy + hh - n
                        }
                    } else if e == EDGE_LEFT {
                        if hx + n > x0 {
                            x0 = hx + n
                        }
                    } else {
                        if n < hw && hx + hw - n < x1 {
                            x1 = hx + hw - n
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    // a strut that eats the head is refused, same rule as the plain work area
    if x1 < x0 + 64 || y1 < y0 + 64 {
        x0 = hx
        y0 = hy
        x1 = hx + hw
        y1 = hy + hh
    }
    return ((x0 & 0xFFFF) << 48) | ((y0 & 0xFFFF) << 32) | (((x1 - x0) & 0xFFFF) << 16) | ((y1 - y0) & 0xFFFF)
}

// The work area a window is maximized to: that of its home head (the primary work area on a plain screen).
fn win_work(state: u64, i: u64) -> u64 {
    if !hd_multi(state) {
        return ((gs(state, S_WORK_X) & 0xFFFF) << 48) | ((gs(state, S_WORK_Y) & 0xFFFF) << 32)
            | ((gs(state, S_WORK_W) & 0xFFFF) << 16) | (gs(state, S_WORK_H) & 0xFFFF)
    }
    return head_work(state, win_head(state, i))
}


// r826: show one head line on the serial port (the gate parses these): `wm: head N rect=X,Y WxH work=X,Y WxH`.
fn hd_say(state: u64, hd: u64) {
    var s_h: [u8; 10] = "wm: head \0"
    var s_r: [u8; 7] = " rect=\0"
    var s_c: [u8; 2] = ",\0"
    var s_x: [u8; 2] = "x\0"
    var s_w: [u8; 7] = " work=\0"
    var s_s: [u8; 2] = " \0"
    let p: u64 = head_work(state, hd)
    serial.puts((&s_h[0]) as u64)
    serial.dec(hd)
    serial.puts((&s_r[0]) as u64)
    serial.dec(hd_x(state, hd))
    serial.puts((&s_c[0]) as u64)
    serial.dec(hd_y(state, hd))
    serial.puts((&s_s[0]) as u64)
    serial.dec(hd_w(state, hd))
    serial.puts((&s_x[0]) as u64)
    serial.dec(hd_h(state, hd))
    serial.puts((&s_w[0]) as u64)
    serial.dec(hw_x(p))
    serial.puts((&s_c[0]) as u64)
    serial.dec(hw_y(p))
    serial.puts((&s_s[0]) as u64)
    serial.dec(hw_w(p))
    serial.puts((&s_x[0]) as u64)
    serial.dec(hw_h(p))
    serial.nl()
}

// r815: "wm: hscale N=P" -- the EDID scale suggestion (percent) of head N next to the UI scale the desktop really uses.
fn hd_say_scale(state: u64, hd: u64) {
    var s_h: [u8; 12] = "wm: hscale \0"
    var s_e: [u8; 2] = "=\0"
    var s_u: [u8; 4] = " u=\0"
    serial.puts((&s_h[0]) as u64)
    serial.dec(hd)
    serial.puts((&s_e[0]) as u64)
    serial.dec(hd_scale(state, hd))
    serial.puts((&s_u[0]) as u64)
    serial.dec(fb.uiscale(state))
    serial.nl()
}

// THE HEAD TABLE FOLLOWS THE OUTPUTS. Called after the window server is up and from `gfx.gpu_ereignis` after every
// successful re-layout (hot-plug): copy the extend rects of the vgpu driver into the pointer driver's table, bring
// windows that sit on no head any more to the primary head, keep the others in sight (title bar reachable), refit
// fullscreen windows to their home head, recompute the work areas (this refits maximized windows and the tile
// tree) and put the pointer back onto a head. With extend off the table is empty and the model is off.
fn heads_sync(state: u64) {
    if !ready(state) {
        return
    }
    let act: bool = vgpu.ext_active(state)
    var n: u64 = 0
    var hd: u64 = 0
    while hd < HD_MAX {
        var w: u64 = 0
        if act {
            w = vgpu.ext_w(state, hd)
        }
        ps2m.set_head(state, hd, vgpu.ext_x(state, hd), vgpu.ext_y(state, hd), w, vgpu.ext_h(state, hd))
        if w != 0 {
            n = hd + 1
        }
        hd = hd + 1
    }
    if act && n < 2 {
        n = 2
    }
    if !act {
        n = 0
    }
    ps2m.set_heads(state, n)
    if n >= 2 {
        let p0: u64 = head_work(state, hd_primary(state))
        var i: u64 = 0
        while i < MAX_WIN {
            let f: u64 = wg(state, i, W_FLAGS)
            if wg(state, i, W_USED) != 0 && (f & F_HIDDEN) == 0 {
                if (f & F_FULL) != 0 {
                    let fh: u64 = win_head(state, i)
                    if resize_win(state, i, hd_w(state, fh), hd_h(state, fh)) {
                        move_win(state, i, hd_x(state, fh) as i64, hd_y(state, fh) as i64)
                    }
                } else if deko(state, i) && (f & F_MAXIMIZED) == 0 {
                    var ov: u64 = 0
                    let ox: i64 = win_x(state, i)
                    let oy: i64 = win_y(state, i)
                    var h2: u64 = 0
                    while h2 < HD_MAX {
                        ov = ov + hd_overlap(state, h2, ox, oy, ox + outer_w(state, i) as i64,
                            oy + outer_h(state, i) as i64)
                        h2 = h2 + 1
                    }
                    if ov == 0 {
                        move_win(state, i, (hw_x(p0) + 24) as i64, (hw_y(p0) + 24) as i64)
                    }
                    drag_klemmen(state, i)
                }
            }
            i = i + 1
        }
        ps2m.set_pos(state, ps2m.x(state), ps2m.y(state))
    }
    tl_heads_changed(state)
    recalc_work(state)
    ss(state, S_HD_SYNCS, gs(state, S_HD_SYNCS) + 1)
    ss(state, S_HD_GEN, vgpu.hot_gen(state))
    var s_n: [u8; 13] = "wm: heads n=\0"
    var s_p: [u8; 10] = " present=\0"
    var s_g: [u8; 6] = " gen=\0"
    var s_y: [u8; 8] = " syncs=\0"
    serial.puts((&s_n[0]) as u64)
    serial.dec(n)
    serial.puts((&s_p[0]) as u64)
    serial.dec(hd_count(state))
    serial.puts((&s_g[0]) as u64)
    serial.dec(gs(state, S_HD_GEN))
    serial.puts((&s_y[0]) as u64)
    serial.dec(gs(state, S_HD_SYNCS))
    serial.nl()
    hd = 0
    while hd < HD_MAX {
        if hd_present(state, hd) {
            hd_say(state, hd)
            hd_say_scale(state, hd)
        }
        hd = hd + 1
    }
}

fn hd_say_mode(state: u64, tag: u64) {
    var s_a: [u8; 5] = "hd: \0"
    var s_m: [u8; 9] = " mirror=\0"
    var s_c: [u8; 12] = " connected=\0"
    var s_p: [u8; 10] = " present=\0"
    let mode: u64 = display_mode(state)
    serial.puts((&s_a[0]) as u64)
    serial.puts(tag)
    serial.puts((&s_m[0]) as u64)
    serial.dec((mode >> 8) & 1)
    serial.puts((&s_c[0]) as u64)
    serial.dec(mode & 255)
    serial.puts((&s_p[0]) as u64)
    serial.dec(hd_count(state))
    serial.nl()
}

fn display_mode(state: u64) -> u64 {
    var mirrored: u64 = 0
    if vgpu.mirror_active(state) {
        mirrored = 1
    }
    return (mirrored << 8) | vgpu.head_count(state)
}

fn set_display_mode(state: u64, mirror: bool) -> bool {
    if !vgpu.set_mirror(state, mirror) {
        return false
    }
    heads_sync(state)
    return true
}

fn head_syncs(state: u64) -> u64 {
    return gs(state, S_HD_SYNCS)
}

// One `hd:` line: a window's outer rect.
fn hd_say_win(state: u64, i: u64, tag: u64) {
    var s_a: [u8; 5] = "hd: \0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_k: [u8; 7] = " head=\0"
    var s_f: [u8; 5] = " fl=\0"
    serial.puts((&s_a[0]) as u64)
    serial.puts(tag)
    serial.puts((&s_x[0]) as u64)
    serial.dec(win_x(state, i) as u64)
    serial.puts((&s_y[0]) as u64)
    serial.dec(win_y(state, i) as u64)
    serial.puts((&s_w[0]) as u64)
    serial.dec(outer_w(state, i))
    serial.puts((&s_h[0]) as u64)
    serial.dec(outer_h(state, i))
    serial.puts((&s_k[0]) as u64)
    serial.dec(win_head(state, i))
    serial.puts((&s_f[0]) as u64)
    serial.dec(wg(state, i, W_FLAGS))
    serial.nl()
}

// TEST BED for `hdtest` / `hdhot` (tools/wmheads): windows and struts on two heads, printed as `hd:` lines.
// Needs an extended desktop (vgpuextend with two heads). With `hot` it also unplugs head 1 and plugs it back.
// r828: edge docking on head 1 (floating halves): right/top/bottom of head 1, a seam edge (no docking), a drop
// in the middle (no docking). Needs the docking switch on; restored afterwards.
// r804 TEST BED for `hwheeltest`: horizontal wheel steps to the window under a point (event type + notches in the
// window ring), a miss over the empty desktop, and 3-finger swipes as window switch. Prints `hw:` lines.
static mut hw_out: [u64; 2] = [0 as u64; 2]

fn hw_drain(state: u64, i: u64) {
    var n: u64 = 0
    while n < 64 && ev_pop(state, i, (&hw_out[0 as usize]) as u64) {
        n = n + 1
    }
}

fn hw_say_ev(state: u64, i: u64, tag: u64) {
    var s_p: [u8; 5] = "hw: \0"
    var s_t: [u8; 7] = " type=\0"
    var s_c: [u8; 4] = " c=\0"
    var s_n: [u8; 7] = " empty\0"
    serial.puts((&s_p[0]) as u64)
    serial.puts(tag)
    if !ev_pop(state, i, (&hw_out[0 as usize]) as u64) {
        serial.puts((&s_n[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_t[0]) as u64)
    serial.dec(hw_out[0 as usize])
    serial.puts((&s_c[0]) as u64)
    serial.hex(hw_out[1 as usize] & 0xFFFF)
    serial.nl()
}

fn hw_say_sw(state: u64, tag: u64, moved: bool, fc: u64, wa: u64, wb: u64) {
    var s_p: [u8; 5] = "hw: \0"
    var s_m: [u8; 8] = " moved=\0"
    var s_f: [u8; 8] = " focus=\0"
    serial.puts((&s_p[0]) as u64)
    serial.puts(tag)
    serial.puts((&s_m[0]) as u64)
    if moved {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_f[0]) as u64)
    if fc == wa {
        serial.put(97 as u8)
    } else if fc == wb {
        serial.put(98 as u8)
    } else {
        serial.put(63 as u8)
    }
    serial.nl()
}

fn hw_demo(state: u64) {
    var t_a: [u8; 5] = "hw-a\0"
    var t_b: [u8; 5] = "hw-b\0"
    var g_r: [u8; 12] = "right2 on-a\0"
    var g_l: [u8; 11] = "left1 on-a\0"
    var g_g: [u8; 11] = "gap no-win\0"
    var g_b: [u8; 12] = "right1 on-b\0"
    var g_a2: [u8; 12] = "on-a after \0"
    var g_s1: [u8; 11] = "swipe left\0"
    var g_s2: [u8; 12] = "swipe right\0"
    var g_s3: [u8; 12] = "swipe 2 fin\0"
    var g_s4: [u8; 9] = "swipe up\0"
    if !ready(state) {
        return
    }
    let wa: u64 = create(state, 0, 40, 40, 300, 200, K_RAW, (&t_a[0]) as u64)
    let wb: u64 = create(state, 0, 400, 40, 300, 200, K_RAW, (&t_b[0]) as u64)
    if wa >= MAX_WIN || wb >= MAX_WIN {
        return
    }
    hw_drain(state, wa)
    hw_drain(state, wb)
    wh_seen = ps2m.wheel(state)
    hwh_seen = ps2m.hwheel(state)
    // two steps right over window a: ONE event, c = 2
    ps2m.hwheel_add(state, 1)
    ps2m.hwheel_add(state, 1)
    hwheel_out(state, 150, 150)
    hw_say_ev(state, wa, (&g_r[0]) as u64)
    // one step left: c = 0xFFFF (-1)
    ps2m.hwheel_add(state, 0 - 1)
    hwheel_out(state, 150, 150)
    hw_say_ev(state, wa, (&g_l[0]) as u64)
    // over the gap between the windows: the sum is taken, nobody gets an event
    ps2m.hwheel_add(state, 1)
    hwheel_out(state, 370, 150)
    hw_say_ev(state, wa, (&g_g[0]) as u64)
    hw_say_ev(state, wb, (&g_g[0]) as u64)
    // over window b: b gets it, a does not
    ps2m.hwheel_add(state, 1)
    hwheel_out(state, 500, 150)
    hw_say_ev(state, wb, (&g_b[0]) as u64)
    hw_say_ev(state, wa, (&g_a2[0]) as u64)
    // swipes: with two windows left = the other window, right = back, 2 fingers and up = nothing
    raise_win(state, wa)
    set_focus(state, wa)
    let m1: bool = swipe_do(state, 1, 3)
    hw_say_sw(state, (&g_s1[0]) as u64, m1, focus(state), wa, wb)
    let m2: bool = swipe_do(state, 2, 3)
    hw_say_sw(state, (&g_s2[0]) as u64, m2, focus(state), wa, wb)
    let m3: bool = swipe_do(state, 1, 2)
    hw_say_sw(state, (&g_s3[0]) as u64, m3, focus(state), wa, wb)
    let m4: bool = swipe_do(state, 3, 3)
    hw_say_sw(state, (&g_s4[0]) as u64, m4, focus(state), wa, wb)
}

fn hd_say_tree(state: u64, i: u64, tag: u64) {
    var s_a: [u8; 10] = "hd: tree \0"
    var s_t: [u8; 7] = " tree=\0"
    var s_n: [u8; 8] = " tiled=\0"
    serial.puts((&s_a[0]) as u64)
    serial.puts(tag)
    serial.puts((&s_t[0]) as u64)
    serial.dec(tile_tree_tag(state, i))
    serial.puts((&s_n[0]) as u64)
    if tiled(state, i) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()
}

fn hd_say_drop(state: u64, pos: u64) {
    var s_e: [u8; 11] = "hd: drope=\0"
    var s_p: [u8; 6] = " pos=\0"
    serial.puts((&s_e[0]) as u64)
    serial.dec(gs(state, S_DROPE))
    serial.puts((&s_p[0]) as u64)
    serial.puts(pos)
    serial.nl()
}

fn hd_say_trees(state: u64, tag: u64) {
    var s_a: [u8; 11] = "hd: trees \0"
    var s_n: [u8; 8] = " nodes=\0"
    var s_l: [u8; 9] = " leaves=\0"
    serial.puts((&s_a[0]) as u64)
    serial.puts(tag)
    serial.puts((&s_n[0]) as u64)
    serial.dec(tile_nodes_all(state))
    serial.puts((&s_l[0]) as u64)
    serial.dec(tile_leaves_all(state))
    serial.nl()
}

// r839: tile tree per head. Tiling is switched on WITHOUT taking the windows that exist (ss, not set_tile_on).
fn hd_demo_tile(state: u64, hot: bool, wa: u64, wb: u64, bar: u64) {
    var t_c1: [u8; 8] = "tile-c1\0"
    var t_c0: [u8; 8] = "tile-c0\0"
    var t_c2: [u8; 8] = "tile-c2\0"
    var t_c1b: [u8; 9] = "split-c1\0"
    var t_c2b: [u8; 9] = "split-c2\0"
    var t_c0t: [u8; 7] = "top-c0\0"
    var t_c1t: [u8; 7] = "top-c1\0"
    var t_c2t: [u8; 7] = "top-c2\0"
    var t_top: [u8; 5] = "top1\0"
    var t_sm: [u8; 5] = "seam\0"
    var t_mid: [u8; 7] = "middle\0"
    var t_off: [u8; 4] = "off\0"
    var t_u0: [u8; 10] = "unplug-c0\0"
    var t_u1: [u8; 10] = "unplug-c1\0"
    var t_u2: [u8; 10] = "unplug-c2\0"
    var t_c3: [u8; 10] = "replug-c3\0"
    var t_n0: [u8; 6] = "start\0"
    var t_n1: [u8; 5] = "full\0"
    var t_n2: [u8; 7] = "unplug\0"
    var t_n3: [u8; 7] = "replug\0"
    var t_n4: [u8; 4] = "end\0"
    var t_f: [u8; 5] = "tile\0"
    if !hd_multi(state) {
        return
    }
    // a clean slate: nothing tiled, no strut, the full head rects are the work areas
    set_tile_on(state, false)
    let _d1: bool = destroy(state, wa)
    let _d2: bool = destroy(state, wb)
    let _d3: bool = destroy(state, bar)
    let h1x: i64 = hd_x(state, 1) as i64
    let hw: i64 = hd_w(state, 1) as i64
    ss(state, S_TILE, 1)
    hd_say_trees(state, (&t_n0[0]) as u64)
    // a new window lands on the head it is on: its own tree, filling that head's work area
    let c1: u64 = create(state, 0, h1x + 60, 60, 300, 200, K_RAW, (&t_f[0]) as u64)
    hd_say_win(state, c1, (&t_c1[0]) as u64)
    hd_say_tree(state, c1, (&t_c1[0]) as u64)
    let c0: u64 = create(state, 0, 60, 60, 300, 200, K_RAW, (&t_f[0]) as u64)
    hd_say_win(state, c0, (&t_c0[0]) as u64)
    hd_say_tree(state, c0, (&t_c0[0]) as u64)
    hd_say_trees(state, (&t_n1[0]) as u64)
    // the second window on head 1 splits ONLY head 1's tree
    let c2: u64 = create(state, 0, h1x + 100, 100, 300, 200, K_RAW, (&t_f[0]) as u64)
    hd_say_win(state, c1, (&t_c1b[0]) as u64)
    hd_say_win(state, c2, (&t_c2b[0]) as u64)
    hd_say_win(state, c0, (&t_c0[0]) as u64)
    hd_say_tree(state, c2, (&t_c2[0]) as u64)
    // drag c0 over to the top edge of head 1: tiled as the upper half of head 1's tree
    drag_begin(state, c0)
    hd_say_tree(state, c0, (&t_c0t[0]) as u64)
    drag_hover(state, c0, h1x + hw / 2, 0)
    hd_say_drop(state, (&t_top[0]) as u64)
    drag_end(state, c0, h1x + hw / 2, 0)
    hd_say_win(state, c0, (&t_c0t[0]) as u64)
    hd_say_win(state, c1, (&t_c1t[0]) as u64)
    hd_say_win(state, c2, (&t_c2t[0]) as u64)
    hd_say_tree(state, c0, (&t_c0t[0]) as u64)
    hd_say_trees(state, (&t_n2[0]) as u64)
    // the seam between the heads is no docking edge; the middle of a tile: no edge either; switch off: nothing
    drag_hover(state, c0, h1x, 100)
    hd_say_drop(state, (&t_sm[0]) as u64)
    drag_hover(state, c0, h1x + hw / 2, 300)
    hd_say_drop(state, (&t_mid[0]) as u64)
    ss(state, S_DROPN, 0)
    ss(state, S_DROPE, 0)
    ss(state, S_PVON, 0)
    ss(state, S_TILE, 0)
    drag_hover(state, c0, h1x + hw - 1, 100)
    hd_say_drop(state, (&t_off[0]) as u64)
    ss(state, S_TILE, 1)
    if hot {
        let _t1: bool = vgpu.hot_toggle(state, 1)
        heads_sync(state)
        hd_say_win(state, c0, (&t_u0[0]) as u64)
        hd_say_win(state, c1, (&t_u1[0]) as u64)
        hd_say_win(state, c2, (&t_u2[0]) as u64)
        hd_say_tree(state, c0, (&t_u0[0]) as u64)
        hd_say_tree(state, c1, (&t_u1[0]) as u64)
        hd_say_tree(state, c2, (&t_u2[0]) as u64)
        hd_say_trees(state, (&t_n2[0]) as u64)
        let _t2: bool = vgpu.hot_toggle(state, 1)
        heads_sync(state)
        let c3: u64 = create(state, 0, h1x + 80, 80, 300, 200, K_RAW, (&t_f[0]) as u64)
        hd_say_win(state, c3, (&t_c3[0]) as u64)
        hd_say_tree(state, c3, (&t_c3[0]) as u64)
        hd_say_trees(state, (&t_n3[0]) as u64)
    }
    set_tile_on(state, false)
    hd_say_trees(state, (&t_n4[0]) as u64)
    if hot {
        var t_mp: [u8; 11] = "mirror-pre\0"
        var t_mo: [u8; 10] = "mirror-on\0"
        var t_mf: [u8; 11] = "mirror-off\0"
        var t_gn: [u8; 8] = "mode-on\0"
        var t_gf: [u8; 9] = "mode-off\0"
        let c4: u64 = create(state, 0, h1x + 120, 120, 200, 150, K_RAW, (&t_mp[0]) as u64)
        hd_say_win(state, c4, (&t_mp[0]) as u64)
        let _s1: bool = set_display_mode(state, true)
        hd_say_mode(state, (&t_gn[0]) as u64)
        hd_say_win(state, c4, (&t_mo[0]) as u64)
        let _s2: bool = set_display_mode(state, false)
        hd_say_mode(state, (&t_gf[0]) as u64)
        hd_say_win(state, c4, (&t_mf[0]) as u64)
    }
}

fn hd_demo(state: u64, hot: bool) {
    var t_bar: [u8; 4] = "bar\0"
    var t_a: [u8; 6] = "win-a\0"
    var t_b: [u8; 6] = "win-b\0"
    var t_m1: [u8; 5] = "max1\0"
    var t_m0: [u8; 5] = "max0\0"
    var t_f1: [u8; 6] = "full1\0"
    var t_un: [u8; 7] = "unmax1\0"
    var t_u1: [u8; 9] = "unplug-a\0"
    var t_u2: [u8; 11] = "unplug-bar\0"
    var t_pl: [u8; 9] = "replug-a\0"
    var t_pb: [u8; 11] = "replug-bar\0"
    var s_no: [u8; 14] = "hd: no extend\0"
    var s_cl: [u8; 13] = "hd: clamp x=\0"
    var s_cy: [u8; 4] = " y=\0"
    var s_wk: [u8; 24] = "hd: after unplug work0 \0"
    if !hd_multi(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    let sw: u64 = gs(state, S_SW)
    let sh: u64 = gs(state, S_SH)
    // 1. a 28 px bar over the bottom edge of the whole desktop: one strut per head it touches
    var s_sc: [u8; 12] = "hd: screen \0"
    serial.puts((&s_sc[0]) as u64)
    serial.dec(sw)
    serial.put(120 as u8)
    serial.dec(sh)
    serial.nl()
    let bar: u64 = create(state, 0, 0, (sh - 28) as i64, sw, 28, K_RAW, (&t_bar[0]) as u64)
    if bar >= MAX_WIN {
        return
    }
    set_deco(state, bar, false)
    let _s: bool = set_strut(state, bar, EDGE_BOTTOM, 28)
    hd_say(state, 0)
    hd_say(state, 1)
    // 2. a window on head 1, maximized: fills the work area of head 1
    let wa: u64 = create(state, 0, (hd_x(state, 1) + 60) as i64, 60, 300, 200, K_RAW, (&t_a[0]) as u64)
    let _m1: bool = maximize(state, wa, true)
    hd_say_win(state, wa, (&t_m1[0]) as u64)
    // 3. a window on head 0, maximized: fills the work area of head 0
    let wb: u64 = create(state, 0, 40, 50, 300, 200, K_RAW, (&t_b[0]) as u64)
    let _m0: bool = maximize(state, wb, true)
    hd_say_win(state, wb, (&t_m0[0]) as u64)
    // 4. back to normal: the saved rect is restored on the head it came from
    let _u: bool = maximize(state, wa, false)
    hd_say_win(state, wa, (&t_un[0]) as u64)
    // 5. fullscreen of the window on head 1: exactly head 1, not the desktop
    let _f: bool = fullscreen(state, wa, true)
    hd_say_win(state, wa, (&t_f1[0]) as u64)
    let _f2: bool = fullscreen(state, wa, false)
    // 6. pointer clamp with heads of different height: head 1 only 240 high -> a point below it goes back onto it
    let h1x: u64 = ps2m.head_x(state, 1)
    let h1y: u64 = ps2m.head_y(state, 1)
    let h1w: u64 = ps2m.head_w(state, 1)
    let h1h: u64 = ps2m.head_h(state, 1)
    ps2m.set_head(state, 1, h1x, h1y, h1w, 240)
    ps2m.set_pos(state, h1x + 60, 250)
    serial.puts((&s_cl[0]) as u64)
    serial.dec(ps2m.x(state))
    serial.puts((&s_cy[0]) as u64)
    serial.dec(ps2m.y(state))
    serial.nl()
    ps2m.set_head(state, 1, h1x, h1y, h1w, h1h)
    if !hot {
        hd_demo_tile(state, hot, wa, wb, bar)
        return
    }
    let _m2: bool = maximize(state, wa, true)
    // 7. unplug head 1: the window on it comes to head 0 (and is maximized there if it was), head 1's strut is gone
    let _t1: bool = vgpu.hot_toggle(state, 1)
    heads_sync(state)
    hd_say_win(state, wa, (&t_u1[0]) as u64)
    hd_say_win(state, bar, (&t_u2[0]) as u64)
    // 8. plug it back: head 1 is there again with its work area
    let _t2: bool = vgpu.hot_toggle(state, 1)
    heads_sync(state)
    hd_say_win(state, wa, (&t_pl[0]) as u64)
    hd_say_win(state, bar, (&t_pb[0]) as u64)
    hd_demo_tile(state, hot, wa, wb, bar)
}

// THE WORK AREA, recomputed from scratch. Not incrementally: an
// incremental work area is a cache, and a cache of four numbers that
// three modules write is the kind of thing that is right in every test
// and wrong on the machine.
fn recalc_work(state: u64) {
    if hd_multi(state) {
        // r826: several heads -- the work_* scalars (and with them the tile tree) belong to the primary head.
        let p: u64 = head_work(state, hd_primary(state))
        ss(state, S_WORK_X, hw_x(p))
        ss(state, S_WORK_Y, hw_y(p))
        ss(state, S_WORK_W, hw_w(p))
        ss(state, S_WORK_H, hw_h(p))
        ss(state, S_WORKCALC, gs(state, S_WORKCALC) + 1)
        refit_max(state)
        tile_area_work(state)
        tile_apply(state)
        return
    }
    let sw: u64 = gs(state, S_SW)
    let sh: u64 = gs(state, S_SH)
    var x0: u64 = 0
    var y0: u64 = 0
    var x1: u64 = sw
    var y1: u64 = sh
    if gs(state, S_NOSTRUT) == 0 {
        // RUNDE BLECHDREI: das reservierte Band der Messtafel ist ein
        // Strut wie jeder andere -- nur einer, den kein Fenster haelt.
        // Ohne diese Zeile legte der Schreibtisch seine Fenster unter
        // die Tafel, und `fb` schnitte sie dort ab.
        y0 = fb.band(state)
        var i: u64 = 0
        while i < MAX_WIN {
            if wg(state, i, W_USED) != 0 && wg(state, i, W_STRUT) != 0 {
                if (wg(state, i, W_FLAGS) & F_HIDDEN) == 0 {
                    let e: u64 = (wg(state, i, W_STRUT) & 0xFF) - 1
                    let n: u64 = wg(state, i, W_STRUT) >> 8
                    if e == EDGE_TOP {
                        if n > y0 {
                            y0 = n
                        }
                    } else if e == EDGE_BOTTOM {
                        if n < sh && sh - n < y1 {
                            y1 = sh - n
                        }
                    } else if e == EDGE_LEFT {
                        if n > x0 {
                            x0 = n
                        }
                    } else {
                        if n < sw && sw - n < x1 {
                            x1 = sw - n
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    // A STRUT THAT EATS THE SCREEN IS NOT A STRUT. The smallest window
    // this server will make is 32 x 16 (see `resize_win`), plus the
    // decoration; below 64 x 64 of work area nothing can be laid out at
    // all, and the honest answer is to refuse the reservation rather
    // than to hand out a rectangle nobody can use.
    if x1 < x0 + 64 || y1 < y0 + 64 {
        x0 = 0
        y0 = 0
        x1 = sw
        y1 = sh
    }
    ss(state, S_WORK_X, x0)
    ss(state, S_WORK_Y, y0)
    ss(state, S_WORK_W, x1 - x0)
    ss(state, S_WORK_H, y1 - y0)
    ss(state, S_WORKCALC, gs(state, S_WORKCALC) + 1)
    refit_max(state)
    // RUNDE VOLLBILD: UND DER KACHELBAUM FOLGT MIT. `refit_max` zieht
    // die maximierten Fenster nach, der Baum blieb bisher stehen -- ein
    // gekacheltes Fenster behielt die Flaeche von vor dem Strut und lag
    // damit unter der Leiste. Dieselbe Begruendung wie bei `refit_max`
    // eine Zeile darueber: ein Strut, den nur die Haelfte beachtet, ist
    // keiner.
    tile_area_work(state)
    tile_apply(state)
}

fn set_nostrut(state: u64, on: bool) {
    if on {
        ss(state, S_NOSTRUT, 1)
    } else {
        ss(state, S_NOSTRUT, 0)
    }
    recalc_work(state)
}

fn set_strut(state: u64, i: u64, edge: u64, size: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if edge > EDGE_RIGHT {
        return false
    }
    if size > STRUT_MAX {
        return false
    }
    if size == 0 {
        wsv(state, i, W_STRUT, 0)
    } else {
        wsv(state, i, W_STRUT, (edge + 1) | (size << 8))
    }
    ss(state, S_STRUTS, gs(state, S_STRUTS) + 1)
    recalc_work(state)
    return true
}

fn is_max(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0
}

// PUT A WINDOW ON THE WORK AREA. The OUTER rectangle of the window --
// frame, title bar and all -- becomes the work area exactly; the
// drawing surface is that minus the decoration. A window without
// decoration (desktop, taskbar) has no such difference, which is why
// this goes through `deko` and not through BORDER and TITLE_H.
fn fit_work(state: u64, i: u64) -> bool {
    let hwk: u64 = win_work(state, i)
    var iw: u64 = hw_w(hwk)
    var ih: u64 = hw_h(hwk)
    if deko(state, i) {
        if iw <= border(state) * 2 || ih <= iny(state, i) + border(state) {
            return false
        }
        iw = iw - border(state) * 2
        ih = ih - iny(state, i) - border(state)
    }
    if !resize_win(state, i, iw, ih) {
        return false
    }
    move_win(state, i, hw_x(hwk) as i64, hw_y(hwk) as i64)
    return true
}

// EVERY MAXIMIZED WINDOW FOLLOWS THE WORK AREA. This is the whole point
// of the flag: the taskbar moves from the bottom edge to the left edge,
// the work area changes, and the windows that were filling it fill the
// new one. Without this they would keep the old rectangle and half of
// them would sit under the taskbar.
fn refit_max(state: u64) {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 {
            if (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0 {
                let _r: bool = fit_work(state, i)
            }
        }
        i = i + 1
    }
}

fn maximize(state: u64, i: u64, on: bool) -> bool {
    if !valid(state, i) {
        return false
    }
    let f: u64 = wg(state, i, W_FLAGS)
    if on {
        if (f & F_MAXIMIZED) != 0 {
            return true
        }
        // Where to go back to. Biased by 4096 because a window may sit
        // at a negative coordinate and these are sixteen unsigned bits.
        let sx: u64 = ((win_x(state, i) + 4096) as u64) & 0xFFFF
        let sy: u64 = ((win_y(state, i) + 4096) as u64) & 0xFFFF
        wsv(state, i, W_SAVE, (sx << 48) | (sy << 32)
            | ((wg(state, i, W_W) & 0xFFFF) << 16)
            | (wg(state, i, W_H) & 0xFFFF))
        wsv(state, i, W_FLAGS, f | F_MAXIMIZED)
        if !fit_work(state, i) {
            // It did not fit -- most often because the buffer this
            // window was created with is smaller than the work area
            // (`resize_win` refuses to grow past it). Then it is NOT
            // maximized, and saying so is the whole difference between
            // a measurement and a claim.
            wsv(state, i, W_FLAGS, f)
            return false
        }
        return true
    }
    if (f & F_MAXIMIZED) == 0 {
        return true
    }
    let v: u64 = wg(state, i, W_SAVE)
    wsv(state, i, W_FLAGS, f & ~F_MAXIMIZED)
    let _r: bool = resize_win(state, i, (v >> 16) & 0xFFFF, v & 0xFFFF)
    let bx: i64 = ((v >> 48) & 0xFFFF) as i64 - 4096
    let by: i64 = ((v >> 32) & 0xFFFF) as i64 - 4096
    move_win(state, i, bx, by)
    return true
}

// ================================================== RUNDE VOLLBILD
// F11: DER GANZE SCHIRM, OHNE LEISTE UND OHNE SCHMUCK.
//
// Der Unterschied zu `maximize` in Zahlen (3440x1440, Leiste 80 hoch):
//
//     maximiert:  x=0 y=0   w=3440 h=1360   Leiste sichtbar, Titel da
//     Vollbild:   x=0 y=0   w=3440 h=1440   Leiste weg,      kein Titel
//
// WAS GESICHERT WIRD UND WARUM SO VIEL. Zurueck muss nicht nur die
// Groesse, sondern auch die LAGE und der ZUSTAND -- war das Fenster
// vorher maximiert, ist es hinterher wieder maximiert und nicht
// normal. F_MAXIMIZED wird deshalb NICHT geloescht, sondern
// stehengelassen und beim Verlassen ausgewertet.
//
// WARUM DIE LEISTE NICHT "VERSTECKT" WIRD. Ein `F_HIDDEN` auf der
// Leiste waere der naheliegende Weg und der falsche: die Leiste
// haelt einen Strut, `recalc_work` liefe, die Arbeitsflaeche
// waechst auf den ganzen Schirm, und JEDES maximierte Fenster
// dahinter wuerde mitwachsen. Beim Verlassen muesste alles
// zurueckgerechnet werden. Stattdessen liegt das Vollbildfenster
// einfach UEBER der Leiste (Ebene L_FULL) -- die Leiste bleibt, was
// sie ist, sie ist nur verdeckt. Das ist auch, was Windows tut.
fn fullscreen(state: u64, i: u64, on: bool) -> bool {
    if !valid(state, i) {
        return false
    }
    let f: u64 = wg(state, i, W_FLAGS)
    if on {
        if (f & F_FULL) != 0 {
            return true
        }
        // Lage und Groesse sichern -- mit demselben Versatz von 4096
        // wie `maximize`, weil ein Fenster negativ liegen darf.
        let sx: u64 = ((win_x(state, i) + 4096) as u64) & 0xFFFF
        let sy: u64 = ((win_y(state, i) + 4096) as u64) & 0xFFFF
        wsv(state, i, W_FSXY, (sx << 32) | sy)
        wsv(state, i, W_FSWH, ((wg(state, i, W_W) & 0xFFFF) << 32)
            | (wg(state, i, W_H) & 0xFFFF))
        // Der Schmuck faellt weg. Ob er vorher da war, steht im
        // gesicherten Merkerwort -- deshalb wird F_NODECO gesetzt und
        // nicht getauscht.
        let hatte_deko: bool = deko(state, i)
        wsv(state, i, W_FLAGS, f | F_FULL | F_NODECO)
        // r826: the whole HOME head (the whole screen on a plain one)
        let fh: u64 = win_head(state, i)
        let sw: u64 = hd_w(state, fh)
        let sh: u64 = hd_h(state, fh)
        if !resize_win(state, i, sw, sh) {
            // Passt nicht -- dann ist es NICHT im Vollbild, und das
            // zu sagen ist der Unterschied zwischen einer Messung und
            // einer Behauptung (dieselbe Regel wie in `maximize`).
            var back: u64 = f
            if !hatte_deko {
                back = back | F_NODECO
            }
            wsv(state, i, W_FLAGS, back)
            return false
        }
        move_win(state, i, hd_x(state, fh) as i64, hd_y(state, fh) as i64)
        // UEBER die Leiste. Die Ebene ist die einzige Stelle, an der
        // "vor der Leiste" ueberhaupt ausgedrueckt werden kann.
        set_layer(state, i, L_FULL)
        raise_win(state, i)
        return true
    }
    if (f & F_FULL) == 0 {
        return true
    }
    // Zurueck auf die normale Ebene, BEVOR die Groesse kommt: sonst
    // malt ein Anstrich dazwischen das Fenster noch ganz oben.
    set_layer(state, i, L_NORMAL)
    let xy: u64 = wg(state, i, W_FSXY)
    let wh: u64 = wg(state, i, W_FSWH)
    // Der Schmuck kommt zurueck -- ausser das Fenster hatte nie
    // welchen (Schreibtisch, Leiste).
    var nf: u64 = f & ~F_FULL & ~F_NODECO
    wsv(state, i, W_FLAGS, nf)
    // WAR ES VORHER MAXIMIERT, wird es das wieder -- und zwar ueber
    // `fit_work`, damit es die AKTUELLE Arbeitsflaeche bekommt und
    // nicht die von damals. Das ist der Fall, der ohne eigene
    // Sicherungsplaetze kaputtginge.
    if (nf & F_MAXIMIZED) != 0 {
        if fit_work(state, i) {
            return true
        }
        wsv(state, i, W_FLAGS, nf & ~F_MAXIMIZED)
    }
    let _r: bool = resize_win(state, i, (wh >> 32) & 0xFFFF, wh & 0xFFFF)
    let bx: i64 = ((xy >> 32) & 0xFFFF) as i64 - 4096
    let by: i64 = (xy & 0xFFFF) as i64 - 4096
    move_win(state, i, bx, by)
    return true
}

// ================================================== RUNDE VOLLBILD
// WAS DAS VOLLBILD MIT DEM FENSTER GEMACHT HAT, ALS ZAHLEN.
//
// Justin will die Geometrie in ALLEN DREI Zustaenden sehen und den
// Rueckweg geprueft haben. Ohne diese Zeile muesste man sie aus dem
// Bild schaetzen -- und ein Zustandswechsel, den man nur sieht, ist
// keiner, den man nachrechnen kann.
//
//     wm: voll id=7 an=1 x=0 y=0 w=3440 h=1440 fl=34 lay=3
//
// `fl` traegt beide Merker: 32 ist F_FULL, 4 waere zusaetzlich
// F_MAXIMIZED -- daran liest ein Pruefer ab, ob der Rueckweg auf
// "maximiert" oder auf "normal" fuehren muss.
fn full_say(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    var s_h: [u8; 13] = "wm: voll id=\0"
    var s_a: [u8; 5] = " an=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var s_f: [u8; 5] = " fl=\0"
    var s_l: [u8; 6] = " lay=\0"
    serial.puts((&s_h[0]) as u64)
    serial.dec(wg(state, i, W_ID))
    serial.puts((&s_a[0]) as u64)
    if (wg(state, i, W_FLAGS) & F_FULL) != 0 {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_x[0]) as u64)
    serial.dec(win_x(state, i) as u64)
    serial.puts((&s_y[0]) as u64)
    serial.dec(win_y(state, i) as u64)
    serial.puts((&s_w[0]) as u64)
    serial.dec(wg(state, i, W_W))
    serial.puts((&s_hh[0]) as u64)
    serial.dec(wg(state, i, W_H))
    serial.puts((&s_f[0]) as u64)
    serial.dec(wg(state, i, W_FLAGS))
    serial.puts((&s_l[0]) as u64)
    serial.dec(wg(state, i, W_LAYER))
    serial.nl()
}

fn is_full(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_FULL) != 0
}

// ======================================================= RUNDE TUERSCHLOSS
// WAEHREND DES SELBSTTESTS SAGT DER FOKUS NICHTS.
//
// `set_focus` meldet seit dieser Runde jeden Wechsel als
// `wm: fokus id=<neu> vor=<alt>` -- und das ist der Beleg, ohne den
// Alt+Tab nicht messbar waere. Der Selbsttest ruft `set_focus` aber in
// seiner Zusage 7 auf, und zwar MITTEN in die Zeile hinein, die
// `kgui` gerade schreibt:
//
//     wm: selftest wm: fokus id=1 vor=0
//
// Damit war die Zahl hinter `selftest` weg, und tools/wm/run.sh meldete
// "keine Zahl gefunden (erwartet eq 30)" -- ein Fehler, den diese Runde
// selbst gebaut hat. Eine Diagnosezeile, die eine andere zerschneidet,
// ist keine Diagnose.
static mut fokus_still: u64 = 0

// RUNDE ECHTHARDWARE-1: das Fenster sagt, ob es die Tastatur will.
//
// Wird es JETZT gesetzt und das Fenster liegt schon oben und ist
// sichtbar, bekommt es den Fokus sofort -- sonst muesste man es erst
// noch einmal anklicken, und genau dieser zweite Klick war der Punkt,
// an dem Justins Startmenue "nichts tut" aussah.
fn set_keys(state: u64, i: u64, an: bool) {
    if !valid(state, i) {
        return
    }
    if an {
        wsv(state, i, W_FLAGS, wg(state, i, W_FLAGS) | F_KEYS)
        if (wg(state, i, W_FLAGS) & F_HIDDEN) == 0 {
            set_focus(state, i)
        }
    } else {
        wsv(state, i, W_FLAGS, wg(state, i, W_FLAGS) & ~F_KEYS)
    }
}

fn popups_dismiss_on_focus(state: u64, target: u64) {
    let layer: u64 = wg(state, target, W_LAYER)
    if layer == L_POPUP || layer == L_TIP || layer == L_TOAST {
        return
    }
    var j: u64 = 0
    while j < MAX_WIN {
        if j != target && j + 1 != layer_guard && valid(state, j) && wg(state, j, W_LAYER) == L_POPUP && (wg(state, j, W_FLAGS) & F_HIDDEN) == 0 {
            ev_push(state, j, E_CLOSE, 0, 0, 0)
        }
        j = j + 1
    }
}

fn set_focus(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    // Ein verborgenes Fenster bekommt die Tastatur nicht. Sonst tippt
    // man in etwas, das nicht auf dem Schirm steht.
    if (wg(state, i, W_FLAGS) & F_HIDDEN) != 0 {
        return
    }
    let alt: u64 = focus(state)
    if alt == i {
        return
    }
    popups_dismiss_on_focus(state, i)
    if alt < MAX_WIN {
        damage_win(state, alt)
        ev_push(state, alt, E_FOCUS, 0, 0, 0)
    }
    if alt < MAX_WIN {
        ss(state, S_FOCUS_PREV, alt + 1)
    }
    ss(state, S_FOCUS, i + 1)
    wmplug.notify(state, wmplug.E_FOCUS, wg(state, i, W_ID), 0, 0)
    // ================================================ RUNDE TUERSCHLOSS
    //
    // DER FOKUSWECHSEL WIRD GESAGT, und ohne diese Zeile war Punkt 4.3
    // der Vorrunde gar nicht messbar.
    //
    // Runde DURCHKLICK schrieb "`focus=1` bleibt ueber 137 Meldungen
    // konstant" und belegte damit, dass Alt+Tab nichts tut. Nachgesehen:
    // das `focus=1` in jenen Mitschnitten stammt aus
    // `taskbar: btn ... hidden=0 focus=1` -- der KNOPFLISTE der Leiste --
    // und aus `wm: 1280x800 ... focus=1`, der EINSCHALTMELDUNG des
    // Servers. Keines von beiden ist der Eingabefokus. Der Befund war
    // richtig, sein Beleg zeigte aber auf etwas anderes.
    //
    // Der Eingabefokus stand nirgends auf der Leitung. Jetzt steht er
    // da: eine Zeile je WIRKLICHEM Wechsel (die Abfrage `alt == i`
    // weiter oben laesst Wiederholungen gar nicht bis hierher), mit dem
    // Fenster davor und danach.
    if fokus_still == 0 {
        var s_fk: [u8; 14] = "wm: fokus id=\0"
        var s_fv: [u8; 7] = " vor=\0\0"
        serial.puts((&s_fk[0]) as u64)
        serial.dec(wg(state, i, W_ID))
        serial.puts((&s_fv[0]) as u64)
        if alt < MAX_WIN {
            serial.dec(wg(state, alt, W_ID))
        } else {
            serial.dec(0)
        }
        serial.nl()
    }
    ev_push(state, i, E_FOCUS, 0, 0, 1)
    // RUNDE TILING: DER BAUM FUEHRT SEINEN EIGENEN FOKUS, und die beiden
    // muessen derselbe sein. Ohne diese zwei Zeilen teilt ein neues
    // Fenster nicht das ANGEKLICKTE, sondern das zuletzt angelegte -- ein
    // Fehler, der aussieht wie ein kaputter Baum und keiner ist.
    if wg(state, i, W_NODE) != 0 {
        tl_sel(state, nd_tag(wg(state, i, W_NODE)))
        tile.set_focus(tt(state), nd_node(wg(state, i, W_NODE)))
    }
    damage_win(state, i)
}

fn move_win(state: u64, i: u64, x: i64, y: i64) {
    if !valid(state, i) {
        return
    }
    // RUNDE ZIEH: WER GROESSER MALT, MUSS GROESSER SCHMUTZIG MELDEN.
    //
    // Ein aufgehobenes Fenster deckt mehr Flaeche als seine
    // Fenstertafel angibt (Skalierung plus Nachzug). Meldete diese
    // Stelle weiter nur `damage_win`, bliebe beim Ziehen ein Rand des
    // vorigen Bildes stehen -- ein Schmierstreifen, der aussieht wie
    // ein Fehler im Zeichnen und keiner ist.
    let hebt: bool = drag_paint_on(state, i)
    if hebt {
        damage_win_lift(state, i)
    } else {
        damage_win(state, i) // die alte Stelle wird wiederhergestellt
    }
    wsv(state, i, W_X, x as u64)
    wsv(state, i, W_Y, y as u64)
    if hebt {
        damage_win_lift(state, i)
    } else {
        damage_win(state, i) // und die neue gemalt
    }
    unter_leiste_messen(state, i)
}

// ================================================ RUNDE GLAS (NACHTRAG)
//
// WIE GROSS DIE SCHNITTFLAECHE MIT DER LEISTE IST -- gemessen an der
// Stelle, durch die jede Bewegung geht.
//
// `tools/themestore/run.sh` belegte "keine Schlieren" mit `diff 0` auf
// dem Leistenstreifen. Diese Zahl ist 0, solange die Leiste mit sich
// selbst verglichen wird, und sie ist AUCH 0, wenn das Fenster nie
// unter die Leiste gekommen ist -- ein gruener Haken ueber einem
// leeren Schnitt. Seit diesem Nachtrag steht die Schnittflaeche
// daneben: ist sie 0, hat die Probe nichts geprueft, und der Laeufer
// zaehlt sie rot.
fn unter_leiste_messen(state: u64, i: u64) {
    let pw: u64 = panel_win(state)
    if pw >= MAX_WIN || i == pw || !valid(state, i) {
        return
    }
    let px0: i64 = win_x(state, pw)
    let py0: i64 = win_y(state, pw)
    let px1: i64 = px0 + outer_w(state, pw) as i64
    let py1: i64 = py0 + outer_h(state, pw) as i64
    var a: i64 = win_x(state, i)
    var b: i64 = win_y(state, i)
    var c: i64 = a + outer_w(state, i) as i64
    var d: i64 = b + outer_h(state, i) as i64
    if a < px0 {
        a = px0
    }
    if b < py0 {
        b = py0
    }
    if c > px1 {
        c = px1
    }
    if d > py1 {
        d = py1
    }
    if c <= a || d <= b {
        return
    }
    let f: u64 = ((c - a) * (d - b)) as u64
    if f > gs(state, S_UNTERPX) {
        ss(state, S_UNTERPX, f)
        // GEMELDET WIRD BEIM WACHSEN UND NICHT AM ENDE DES LAUFS.
        // Die Schlusszeilen dieses Servers stehen bei `wm: hold`, also
        // BEVOR der Laeufer ueberhaupt klickt; eine Zahl, die erst
        // waehrend des Zuges entsteht, kommt dort nie an. Bei einem Zug
        // sind das eine Handvoll Zeilen (je neuer Groesstwert eine),
        // und der Laeufer nimmt die letzte.
        schlieren_say(state)
    }
}

fn unter_leiste_px(state: u64) -> u64 {
    return gs(state, S_UNTERPX)
}

fn resize_win(state: u64, i: u64, w: u64, h: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    // RUNDE SCHIRM: DIE ZWEI 2048 WAREN DER GRUND, WARUM AUF EINEM
    // 2560x1440-SCHIRM NICHTS MEHR MAXIMIERTE.
    //
    // Gemessen: `wm: selftest 26 / 30  failed=0x58c04200  mw=2  max=0`
    // -- das Fenster entstand (mw=2), aber `maximize` gab false. Der
    // Weg dahin ist fit_work -> resize_win, und dort stand ein fester
    // Deckel von 2048, den jeder Schirm ueber 2048 Bildpunkten Breite
    // reisst. Die Grenze, die es wirklich gibt, ist der PUFFER des
    // Fensters, und die steht zwei Zeilen tiefer.
    // ================================================== RUNDE GRIFF
    // WARUM DIE LEISTE SICH NICHT AUF IHREN SPALT ZUSAMMENZIEHEN KANN.
    //
    // GEMESSEN (Justins Blech, 2560x1440, ECHTHARDWARE-2):
    //
    //     taskbar: size w=2560 h=2 rc=-4
    //
    // `-4` ist E_INVALID und kommt aus genau dieser Zeile: die
    // Taskleiste mit `autohide=1` will sich auf ihren SLIVER von zwei
    // Bildpunkten zurueckziehen (kernel/user/taskbar.fi, `SLIVER`),
    // und `h < 16` weist das ab. Die Leiste bleibt in voller Hoehe
    // stehen -- das automatische Verbergen ist damit gebaut, gemeldet
    // und wirkungslos.
    //
    // WOFUER DIE 32x16 DA SIND: fuer ein Fenster MIT SCHMUCK. Unter
    // einer Titelleiste plus zwei Rahmen ist ein Fenster von 8x8
    // sinnlos, und `wm_strut` beruft sich weiter oben ausdruecklich auf
    // diese Zahl. Fuer ein Fenster OHNE Schmuck gilt die Begruendung
    // nicht: ein Spalt am Bildschirmrand IST die richtige Groesse.
    //
    // Also gilt die Untergrenze weiter -- aber sie fragt vorher, ob das
    // Fenster ueberhaupt Schmuck traegt. Ein undekoriertes Fenster darf
    // bis auf 1x1 herunter; kleiner als ein Bildpunkt ist nichts, und
    // `w * h * 4` weiter unten bleibt damit wohldefiniert.
    var keep_buf: u64 = 0
    var keep_w: u64 = 0
    var keep_h: u64 = 0
    var keep_free: u64 = 0
    var min_w: u64 = 32
    var min_h: u64 = 16
    if !win_deco(state, i) {
        min_w = 1
        min_h = 1
    }
    if w < min_w || h < min_h || w > MAX_W_HARD || h > MAX_H_HARD {
        return false
    }
    // RUNDE HIDPUNKTE: HIER STAND "OHNE NEUEN PUFFER NICHT GROESSER ALS
    // ANGELEGT", UND DAS WAR DER GRUND, WARUM AUF EINEM ULTRAWIDE-SCHIRM
    // KEINE TASKLEISTE ZU SEHEN IST.
    //
    // Gemessen auf 3440x1440: die Leiste entsteht klein, will auf
    // `w=3440 h=56` wachsen (770 560 Oktett) und bekommt `rc=-4`. Sie
    // behaelt ihren alten Puffer von 128 Bildpunkten Breite -- und
    // genau 128 Bildpunkte breit ist sie danach auf dem Schirm
    // (nachgemessen im Bildschirmfoto, `docs/shots/hidpunkte/`). Auf
    // 1280x800 passte der Wunsch zufaellig in den vorhandenen Puffer,
    // deshalb ist das nie aufgefallen.
    //
    // Ein Fenster, das waechst, bekommt jetzt einen groesseren Puffer.
    // Der alte wird NICHT freigegeben -- `mem.frame_run` hat kein
    // Gegenstueck in diesem Kern, und ein Rahmen, der zurueckgegeben
    // wird, ohne dass es einen Weg dafuer gibt, ist schlimmer als einer,
    // der liegen bleibt. Bei sechzehn Fenstern ist das begrenzt.
    // W-C3f: a resize to the size the window already has must NOT take the shared buffer away. The client compares the new size with its
    // own (equal -> nothing to re-attach), so a detach here left the window on a private, blank buffer for good (the taskbar after a
    // repeated apply, QEMU gate line `a resize step detached more windows than were re-attached`).
    if wg(state, i, W_SHM) != 0 && wg(state, i, W_W) == w && wg(state, i, W_H) == h && wg(state, i, W_KIND) != K_TERM {
        return true
    }
    if wg(state, i, W_KIND) == K_TERM && wg(state, i, W_SHM) != 0 {
        // COMPOSITOR r486: the terminal's buffer belongs to the kernel, which paints it with the new row length itself
        if !term_fit(state, i, w * h * 4) {
            return false
        }
    } else if wg(state, i, W_SHM) != 0 {
        // COMPOSITOR S3: a shared buffer has the row length of the old width. The window leaves it (the client keeps its mapping alive)
        // and gets a buffer of its own; the client takes the new size from E_RESIZE and attaches a new shared buffer (WM_SETBUF).
        keep_buf = wg(state, i, W_BUF)
        keep_w = wg(state, i, W_W)
        keep_h = wg(state, i, W_H)
        if !detach_buf(state, i, w * h * 4) {
            return false
        }
    } else if wg(state, i, W_KIND) != K_TERM && wg(state, i, W_BUF) != 0 && !resize_clear_an(state) {
        // W-FLICKER: a window on a kernel-own buffer (the client has not re-attached yet, or never will) gets fresh frames at every size so
        // that the old picture can be copied over with the new row length (the old way re-used the buffer and cleared it to the background)
        let bytes: u64 = w * h * 4
        let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
        let neu: u64 = mem.frame_run(state, rahmen)
        if neu == 0 {
            return false
        }
        keep_buf = wg(state, i, W_BUF)
        keep_w = wg(state, i, W_W)
        keep_h = wg(state, i, W_H)
        keep_free = wg(state, i, W_BUFBYTES) / mem.FRAME_SIZE
        wsv(state, i, W_BUF, neu)
        wsv(state, i, W_BUFBYTES, rahmen * mem.FRAME_SIZE)
    } else if w * h * 4 > wg(state, i, W_BUFBYTES) {
        let bytes: u64 = w * h * 4
        let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
        let neu: u64 = mem.frame_run(state, rahmen)
        if neu == 0 {
            return false // wirklich kein Speicher -- dann ehrlich nein
        }
        wsv(state, i, W_BUF, neu)
        wsv(state, i, W_BUFBYTES, rahmen * mem.FRAME_SIZE)
    }
    damage_win(state, i)
    wsv(state, i, W_W, w)
    wsv(state, i, W_H, h)
    // r1061: any resize (user, program, screen fit) drops the remembered pre-shrink size; screen_fit_windows sets it again afterwards
    if (wg(state, i, W_SAVWH) >> 63) != 0 {
        wsv(state, i, W_SAVWH, 0)
    }
    if wg(state, i, W_KIND) == K_TERM {
        term_setup(state, i)
    } else if keep_buf != 0 && !resize_clear_an(state) {
        keep_resized(state, i, keep_buf, keep_w, keep_h)
        if keep_free != 0 {
            mem.frame_free_run(state, keep_buf, keep_free)
        }
    } else {
        fill(state, i, 0, 0, w, h, wg(state, i, W_BG))
    }
    ev_push(state, i, E_RESIZE, w, h, 0)
    damage_win(state, i)
    return true
}

// W-FLICKER (resize): THE OLD PICTURE STAYS UNTIL THE CLIENT HAS PAINTED THE NEW ONE.
// Before: a resize filled the window's new kernel buffer with the background colour, the compositor showed that flat window until the client
// had taken E_RESIZE, mapped a new shared buffer and painted (tens of ms on slow hardware = a visible flash on every step of a drag).
// Now the overlap of the old and the new size is copied over (row by row, the row lengths differ), only the newly exposed strips get the
// background colour. `old` is the buffer the window just left: the client still maps it, so it is alive.
fn resize_clear_an(state: u64) -> bool {
    return kstate.mode_on(state, kstate.M_RESCLEAR)
}

fn keep_resized(state: u64, i: u64, old: u64, ow: u64, oh: u64) {
    let nw: u64 = wg(state, i, W_W)
    let nh: u64 = wg(state, i, W_H)
    let nb: u64 = wg(state, i, W_BUF)
    if nb == 0 || old == 0 {
        fill(state, i, 0, 0, nw, nh, wg(state, i, W_BG))
        return
    }
    var cw: u64 = ow
    if nw < cw {
        cw = nw
    }
    var ch: u64 = oh
    if nh < ch {
        ch = nh
    }
    var y: u64 = 0
    while y < ch {
        copy_words(nb +% y *% nw *% 4, old +% y *% ow *% 4, cw / 2)
        if (cw & 1) != 0 {
            __mmio_write32((nb +% y *% nw *% 4 +% (cw - 1) *% 4) as *mut u32,
                __mmio_read32((old +% y *% ow *% 4 +% (cw - 1) *% 4) as *mut u32))
        }
        y = y + 1
    }
    if nw > cw {
        fill(state, i, cw, 0, nw - cw, ch, wg(state, i, W_BG))
    }
    if nh > ch {
        fill(state, i, 0, ch, nw, nh - ch, wg(state, i, W_BG))
    }
}

// ---------------------------------------------------- in ein Fenster

fn wpixel(state: u64, i: u64, x: u64, y: u64, color: u64) {
    let w: u64 = wg(state, i, W_W)
    if x >= w || y >= wg(state, i, W_H) {
        return
    }
    __mmio_write32((wg(state, i, W_BUF) +% y *% w *% 4 +% x *% 4)
        as *mut u32, color as u32)
}

fn wget(state: u64, i: u64, x: u64, y: u64) -> u64 {
    let w: u64 = wg(state, i, W_W)
    if x >= w || y >= wg(state, i, W_H) {
        return 0
    }
    return __mmio_read32((wg(state, i, W_BUF) +% y *% w *% 4 +% x *% 4)
        as *mut u32) as u64
}

fn fill(state: u64, i: u64, x: u64, y: u64, w: u64, h: u64, color: u64) {
    // RUNDE BLECHFUENF: KEIN PUFFER, KEIN SCHREIBEN. `valid` prueft den
    // Belegungsmerker; der Puffer ist eine zweite Zusage, und nach
    // `destroy` ist sie null. Eine Fuellung ohne diese Zeile schriebe
    // ab Anschrift null.
    if !valid(state, i) || wg(state, i, W_BUF) == 0 {
        return
    }
    let ww: u64 = wg(state, i, W_W)
    let wh: u64 = wg(state, i, W_H)
    if x >= ww || y >= wh {
        return
    }
    var bw: u64 = w
    var bh: u64 = h
    if x + bw > ww {
        bw = ww - x
    }
    if y + bh > wh {
        bh = wh - y
    }
    var r: u64 = 0
    while r < bh {
        let p: u64 = wg(state, i, W_BUF) +% (y + r) *% ww *% 4 +% x *% 4
        fill_words(p, (color & 0xFFFFFFFF) | ((color & 0xFFFFFFFF) << 32),
            bw / 2)
        if (bw & 1) != 0 {
            __mmio_write32((p +% (bw - 1) *% 4) as *mut u32, color as u32)
        }
        r = r + 1
    }
}

fn fill_words(p: u64, value: u64, words: u64) {
    if words == 0 {
        return
    }
    arch.fill_words(p, value, words)
}

fn copy_words(dst: u64, src: u64, words: u64) {
    if words == 0 {
        return
    }
    arch.copy_words(dst, src, words)
}

// Eine Farbe mit Deckkraft ueber eine andere. Ganzzahlig und ohne
// Rundungsbeiwerk -- `tools/ttf/raster.py` und `tools/gfx/checkshot.py`
// rechnen dieselbe Zeile, sonst waere ein bildpunktgenauer Vergleich
// eines kantengeglaetteten Zeichens nicht moeglich.
fn blend(alt: u64, neu: u64, a: u64) -> u64 {
    return comp.blend(alt, neu, a)
}

// One channel (lib/fui/comp.fi `mix8`; see the header of `fb.mix8` for the measurement).
fn mix8(dst: u64, src: u64, a: u64, ia: u64) -> u64 {
    return comp.mix8(dst, src, a, ia)
}

// Eine Zeile Text in ein Fenster, mit Kantenglaettung und
// Unterschneidung. `y` ist die GRUNDLINIE, nicht die Oberkante -- das
// ist die Groesse, mit der Schriften rechnen, und die einzige, an der
// zwei Schriftgroessen nebeneinander stehen koennen.
fn text(state: u64, i: u64, f: u64, px: u64, x: i64, y: i64, p: u64,
    n: u64, color: u64) -> i64 {
    if !valid(state, i) || f >= ttf.MAX_FONTS {
        return x
    }
    // RUNDE I18N: EIN DURCHLAUF JE ZEICHEN, NICHT JE OKTETT. Vorher
    // stand hier `kstate.get8(p + k)` und `k = k + 1`; fuer die zwei
    // Oktette eines Umlauts hat das zwei Glyphen gesucht, keine
    // gefunden und zwei Leerraeume gemalt. Die Null bleibt das Ende der
    // Zeichenkette -- ein Nulloktett kommt in gueltigem UTF-8 nur als
    // U+0000 vor, und das ist ohnehin das Ende.
    var cx: i64 = x * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = n
        } else {
            let gid: u64 = ttf.glyph_of(state, f, c)
            if vorher != 0 {
                cx = cx + ttf.kern26(state, f, vorher, gid, px)
            }
            let slot: u64 = ttf.glyph(state, f, c, px)
            if slot < ttf.SLOTS {
                draw_glyph(state, i, slot, cx >> 6, y, color)
                cx = cx + ttf.g_adv(state, slot)
            } else {
                cx = cx + ttf.advance26(state, f, gid, px)
            }
            vorher = gid
            k = k + l
        }
    }
    return cx >> 6
}

fn draw_glyph(state: u64, i: u64, slot: u64, x: i64, y: i64, color: u64) {
    draw_glyph_clip(state, i, slot, x, y, color, 0,
        wg(state, i, W_W) as i64)
}

// EINE GLYPHE, AUF EINEN SENKRECHTEN STREIFEN BESCHNITTEN.
//
// Im Terminal ist der Streifen die ZELLE, und das ist keine Feinheit:
// DejaVu Sans Mono hat bei sechzehn Bildpunkten eine Laufweite von
// 9,625, die Zelle ist also zehn breit -- und 'W', 'V' und 'M' sind
// BREITER als zehn. Ohne Beschnitt ragen sie in die naechste Zelle,
// und sobald dort ein Zeichen geschrieben wird, loescht dessen
// Hintergrund die Haelfte des vorigen wieder weg. Gemessen: von 1413
// Tintenpunkten einer Zeile waren 146 falsch, und alle davon standen am
// rechten Rand eines breiten Buchstabens. Mit Beschnitt sind es null,
// und das Bild zeigt, was ein Terminal zeigt.
fn draw_glyph_clip(state: u64, i: u64, slot: u64, x: i64, y: i64,
    color: u64, cx0: i64, cx1: i64) {
    let gw: u64 = ttf.g_w(state, slot)
    let gh: u64 = ttf.g_h(state, slot)
    if gw == 0 || gh == 0 {
        return
    }
    let x0: i64 = x + ttf.g_left(state, slot)
    let y0: i64 = y - ttf.g_top(state, slot)
    var ww: i64 = wg(state, i, W_W) as i64
    let wh: i64 = wg(state, i, W_H) as i64
    var lo: i64 = cx0
    if lo < 0 {
        lo = 0
    }
    if cx1 < ww {
        ww = cx1
    }
    var r: u64 = 0
    while r < gh {
        let py: i64 = y0 + r as i64
        if py >= 0 && py < wh {
            var c: u64 = 0
            while c < gw {
                let pxx: i64 = x0 + c as i64
                if pxx >= lo && pxx < ww {
                    let a: u64 = ttf.g_pixel(state, slot, c, r)
                    if a != 0 {
                        wpixel(state, i, pxx as u64, py as u64,
                            blend(wget(state, i, pxx as u64, py as u64),
                                color, a))
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

// Ein Rechteck aus fremdem Speicher in ein Fenster -- das, was eine
// Anwendung braucht, die selbst malt.
fn blit_in(state: u64, i: u64, src: u64, x: u64, y: u64, w: u64,
    h: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    let ww: u64 = wg(state, i, W_W)
    if x >= ww || y >= wg(state, i, W_H) {
        return 0
    }
    var bw: u64 = w
    var bh: u64 = h
    if x + bw > ww {
        bw = ww - x
    }
    if y + bh > wg(state, i, W_H) {
        bh = wg(state, i, W_H) - y
    }
    ss(state, S_BL_N, gs(state, S_BL_N) + bh)
    ss(state, S_BL_PX, gs(state, S_BL_PX) + bw * bh)
    var r: u64 = 0
    while r < bh {
        copy_words(wg(state, i, W_BUF) +% (y + r) *% ww *% 4 +% x *% 4,
            src +% r *% w *% 4, bw *% 4 / 8)
        if (bw & 1) != 0 {
            __mmio_write32((wg(state, i, W_BUF) +% (y + r) *% ww *% 4
                +% (x + bw - 1) *% 4) as *mut u32,
                __mmio_read32((src +% r *% w *% 4 +% (bw - 1) *% 4)
                    as *mut u32))
        }
        r = r + 1
    }
    return bw * bh
}

// ================================================= COMPOSITOR S3 (docs/COMPOSITOR.md)
//
// SHARED WINDOW BUFFERS. Until now a client painted into memory of its own and `WIG_BLIT` copied the pixels into the server's buffer on every
// frame (two copies in the kernel, one more in the client's strip). A window can now take over the run of frames of a memfd
// (`memfd_create(MFD_FRAMES)`): the client maps it, paints into it, and `WM_DAMAGE` only names the rectangle that changed. The compositor
// reads the same frames -- 0 copies of the client's pixels per frame.

// the kernel word `noshare` switches it off: the counter-proof of tools/comp/shared.sh (clients fall back to WIG_BLIT)
fn shared_ok(state: u64) -> bool {
    return !fb.noshare_an(state)
}

// 0 = the window paints into frames of the server's own, else the shared object + 1
fn win_shm(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return wg(state, i, W_SHM)
}

// COMPOSITOR r486 (terminal): a shared object the KERNEL makes for a window buffer of `bytes` (the server paints the terminal grid into it
// itself; nobody else holds a descriptor). Returns the object + 1 with its one reference, or 0 (noshare, no slot, no contiguous run).
fn kern_shared(state: u64, bytes: u64) -> u64 {
    if !shared_ok(state) {
        return 0
    }
    let pages: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    if pages == 0 || pages > unixsock.SHM_PAGES_CONTIG {
        return 0
    }
    let k: u64 = unixsock.shm_new_contig(state)
    if k >= unixsock.USHM_MAX {
        return 0
    }
    if unixsock.shm_grow(state, k, pages) != 0 {
        unixsock.shm_unref(state, k)
        return 0
    }
    unixsock.shm_set_size(state, k, pages * mem.FRAME_SIZE)
    return k + 1
}

// The terminal window `i` (its buffer is a kernel-made shared object) is going to be `bytes` big: keep the buffer when it fits (the server
// paints with the new row length), else a new object; when no object can be had the window goes back to a private run of frames.
fn term_fit(state: u64, i: u64, bytes: u64) -> bool {
    if bytes <= wg(state, i, W_BUFBYTES) {
        return true
    }
    let o: u64 = kern_shared(state, bytes)
    if o == 0 {
        return detach_buf(state, i, bytes)
    }
    unixsock.shm_unref(state, wg(state, i, W_SHM) - 1)
    wsv(state, i, W_SHM, o)
    wsv(state, i, W_BUF, unixsock.shm_frame(state, o - 1, 0))
    wsv(state, i, W_BUFBYTES, unixsock.shm_pages(state, o - 1) * mem.FRAME_SIZE)
    ss(state, S_TM_SH, gs(state, S_TM_SH) + 1)
    return true
}

// W-C3f: one serial line per buffer change of a shared window (rare: only on resizes). kind 0 = detach failed (no contiguous frames),
// 1 = detach, 2 = attach. Gate tools/vmsvgaresize reads them next to `wm: shared`.
fn wm_note(state: u64, kind: u64, i: u64, bytes: u64) {
    var s_a: [u8; 12] = "wm: bufchg \0"
    var s_w: [u8; 6] = " win=\0"
    var s_b: [u8; 8] = " bytes=\0"
    var s_k: [u8; 6] = " own=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(kind)
    serial.puts((&s_w[0]) as u64)
    serial.dec(i)
    serial.puts((&s_b[0]) as u64)
    serial.dec(bytes)
    serial.puts((&s_k[0]) as u64)
    serial.dec(wg(state, i, W_OWNER))
    serial.nl()
}

// A shared window gets a buffer of its own of `bytes` and lets go of the shared one.
fn detach_buf(state: u64, i: u64, bytes: u64) -> bool {
    let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    let neu: u64 = mem.frame_run(state, rahmen)
    if neu == 0 {
        wm_note(state, 0, i, bytes)
        return false
    }
    wm_note(state, 1, i, bytes)
    unixsock.shm_unref(state, wg(state, i, W_SHM) - 1)
    wsv(state, i, W_SHM, 0)
    wsv(state, i, W_BUF, neu)
    wsv(state, i, W_BUFBYTES, rahmen * mem.FRAME_SIZE)
    ss(state, S_SH_DET, gs(state, S_SH_DET) + 1)
    return true
}

// Window `i` now paints from the run of frames of shared object `sidx` (WM_SETBUF). The old buffer (own frames or an older shared
// object) is given back. false when the run is smaller than the window or the window is a terminal (the server paints those).
fn attach_buf(state: u64, i: u64, sbase: u64, sbytes: u64, sidx: u64) -> bool {
    if !valid(state, i) || sbase == 0 {
        return false
    }
    if wg(state, i, W_KIND) == K_TERM || sbytes < wg(state, i, W_W) * wg(state, i, W_H) * 4 {
        return false
    }
    if wg(state, i, W_BUF) == sbase {
        return true
    }
    // W-FLICKER (resize): the new shared buffer starts out empty; the window keeps showing the picture it had (kept by `keep_resized`)
    // until the client paints into the new buffer. Copy it over BEFORE the old frames go (a client that painted first is not asked: WM_SETBUF
    // comes right after the buffer is made, in `win_reshare`).
    if wg(state, i, W_SHM) == 0 && wg(state, i, W_BUF) != 0 && !resize_clear_an(state) {
        let cb: u64 = wg(state, i, W_W) * wg(state, i, W_H) * 4
        if cb <= wg(state, i, W_BUFBYTES) {
            copy_words(sbase, wg(state, i, W_BUF), cb / 8)
            var ci: u64 = (cb / 8) * 8
            while ci < cb {
                __mmio_write32((sbase +% ci) as *mut u32, __mmio_read32((wg(state, i, W_BUF) +% ci) as *mut u32))
                ci = ci + 4
            }
        }
    }
    if wg(state, i, W_SHM) != 0 {
        unixsock.shm_unref(state, wg(state, i, W_SHM) - 1)
    } else if wg(state, i, W_BUF) != 0 {
        mem.frame_free_run(state, wg(state, i, W_BUF), wg(state, i, W_BUFBYTES) / mem.FRAME_SIZE)
    }
    unixsock.shm_ref(state, sidx)
    wm_note(state, 2, i, sbytes)
    wsv(state, i, W_SHM, sidx + 1)
    wsv(state, i, W_BUF, sbase)
    wsv(state, i, W_BUFBYTES, sbytes)
    ss(state, S_SH_ATT, gs(state, S_SH_ATT) + 1)
    damage_win(state, i)
    return true
}

// The client painted a rectangle of its shared buffer (window coordinates): only that rectangle is dirty (the same rectangle
// `wig.blit` names after its copy). Returns the pixels named.
fn damage_rect(state: u64, i: u64, x: u64, y: u64, w: u64, h: u64) -> u64 {
    if !valid(state, i) || w == 0 || h == 0 {
        return 0
    }
    let ww: u64 = wg(state, i, W_W)
    let wh: u64 = wg(state, i, W_H)
    if x >= ww || y >= wh {
        return 0
    }
    var bw: u64 = w
    var bh: u64 = h
    if x + bw > ww {
        bw = ww - x
    }
    if y + bh > wh {
        bh = wh - y
    }
    let sx: i64 = win_x(state, i) + inx(state, i) as i64 + x as i64
    let sy: i64 = win_y(state, i) + iny(state, i) as i64 + y as i64
    if gs(state, S_PL_ON) != 0 {
        pl_damage(state)
    }
    if win_hidden(state, i) && !fb.nohidskip_an(state) {
        return bw * bh
    }
    damage_ex(state, sx, sy, sx + bw as i64, sy + bh as i64, i + 1)
    ss(state, S_SH_DMG, gs(state, S_SH_DMG) + 1)
    ss(state, S_SH_PX, gs(state, S_SH_PX) + bw * bh)
    return bw * bh
}

// THE WINDOW TABLE PAGE. One 4 KiB frame the kernel keeps up to date and any process may map READ-ONLY (WM_TABLE): who owns which
// window, where it stands, in which layer and order, with which flags, and where its pixels are. The compositor in ring 3 (`wmd`, S4)
// reads it; nobody can write it (the object is SMF_RO), so a program cannot forge an owner. All words are u64, little endian:
//
//   word 0   magic 0x42415457 ("WTAB") | version 1 << 32
//   word 1   sequence number: odd while the kernel writes, even when the page is consistent (read it before and after; equal and even = good)
//   word 2   number of rows         word 3  screen width | height << 32       word 4  focused window id (0 = none)
//   word 5   number of frames composed (`composites`) when the table was written      word 6  words per row (12)      word 7  1 while the screen is locked
//   from word 16, one row per used window, TAB_ROW words each:
//     +0 id | slot << 32        +1 owner (task number)    +2 x (outer, i64)   +3 y (outer, i64)
//     +4 client width           +5 client height          +6 z | layer << 16 | kind << 24
//     +7 flags (W_FLAGS)        +8 inx | iny << 32 (client area inside the frame)
//     +9 shared object + 1 (0 = the buffer is the server's own)      +10 row length in octets
//     +11 opacity (W_OPAC) in the low 32 bits; bit 32 = PLAIN: right now the server paints this window's client area as a plain copy of its
//         buffer (no opening/closing motion, no lifting, no blur, no glass, no translucency) -- the only windows a shadow compositor can
//         reproduce exactly before the chrome and the effects move to it (S6); bit 33 = SHADOW: the window has a shadow under its frame (S6a)
//   words 8 and 9 (S6a): the shadow numbers, see `tab_publish`
const TAB_MAGIC: u64 = 0x42415457
const TAB_ROW: u64 = 12
const TAB_HEAD: u64 = 16

// Does `compose` paint the client area of window `i` as a plain copy of its buffer right now? (The same decisions `paint_win` takes.)
fn tab_plain(state: u64, i: u64) -> bool {
    if win_hidden(state, i) {
        return false
    }
    if wg(state, i, W_ANK) != 0 || drag_paint_on(state, i) || blur_will(state, i) {
        return false
    }
    var alpha: u64 = form_or(state, FM_WIN_ALPHA, 100)
    // a window with a frame is painted with the window alpha only (`paint_win`, the framed branch): no opacity, no full-screen rule
    if deko(state, i) {
        return alpha >= 100
    }
    let pw: u64 = panel_win(state)
    if pw < MAX_WIN && i == pw {
        alpha = form_or(state, FM_TB_ALPHA, 100)
    }
    let op: u64 = win_opac(state, i)
    if op < 255 {
        let opp: u64 = op *% 100 / 255
        if opp < alpha {
            alpha = opp
        }
    }
    if deckt_schirm(state, i) {
        alpha = 100
    }
    return alpha >= 100
}

fn tab_object(state: u64) -> u64 {
    if gs(state, S_TABI) != 0 {
        return gs(state, S_TABI) - 1
    }
    let f: u64 = mem.frame_alloc(state)
    if f == 0 {
        return unixsock.USHM_MAX
    }
    var o: u64 = 0
    while o < mem.FRAME_SIZE / 8 {
        __mmio_write64((f + o * 8) as *mut u64, 0)
        o = o + 1
    }
    let k: u64 = unixsock.shm_wrap(state, f, 1, unixsock.SMF_RO)
    if k >= unixsock.USHM_MAX {
        mem.frame_free(state, f)
        return unixsock.USHM_MAX
    }
    ss(state, S_TABF, f)
    ss(state, S_TABI, k + 1)
    tab_publish(state)
    return k
}

// S6b: THE CHROME PAGE. A second read-only frame, ROOT ONLY (WM_TABLE with argument 1): everything the compositor in ring 3 needs to paint the frame, the
// title bar, the caption buttons and the title text of a framed window exactly as `paint_win` does -- the colours of the decoration, the measures,
// the hover state and the titles. Titles are private (the window table page has none), so this page is for the compositor only and its title
// words are zero while the screen is locked. Written by `tab_publish` inside the same odd/even bracket as the window table, so a reader that
// sees the table consistent sees this page consistent too. All words u64:
//   0 magic "WCHR" | 1 << 32      1 the table's sequence number it was written with      2 valid (1)
//   3, 4, 5  fb.rgb(255,0,0), fb.rgb(0,255,0), fb.rgb(0,0,255): the compositor refuses to compose when they are not 0xFF0000, 0xFF00, 0xFF
//   6..13    the colours (0xRRGGBB): frame, title, text, frame (focused), title (focused), text (focused), close, close mark
//   14 radius  15 gradient  16 caption style (0 = old red close box)  17 border  18 title height (frame + bar + line)  19 caption button width
//   20 ui scale  21 decoration alpha (0..255)  22 hovered caption button ((slot * 4 + n) + 1)  23 held caption button (same coding)
//   24 ui font  25 ui font size  26 title padding  27 title baseline offset from the window top (i64)  28 netmark width | height << 16
//   29 1 when the title font exists (the server paints a title only then)
//   from word 32: four words of title per table row (31 octets and a zero);  from word 192: one word per table row: the netmark (1..3) or 0
const CHR_MAGIC: u64 = 0x52484357
const CHR_TITLE: u64 = 32
const CHR_MARK: u64 = 192

fn chrome_object(state: u64) -> u64 {
    // the table first: the chrome page is written by `tab_publish`, which runs only once the table exists
    let kt: u64 = tab_object(state)
    if kt >= unixsock.USHM_MAX {
        return kt
    }
    if gs(state, S_CHRI) != 0 {
        return gs(state, S_CHRI) - 1
    }
    let f: u64 = mem.frame_alloc(state)
    if f == 0 {
        return unixsock.USHM_MAX
    }
    var o: u64 = 0
    while o < mem.FRAME_SIZE / 8 {
        __mmio_write64((f + o * 8) as *mut u64, 0)
        o = o + 1
    }
    let k: u64 = unixsock.shm_wrap(state, f, 1, unixsock.SMF_RO)
    if k >= unixsock.USHM_MAX {
        mem.frame_free(state, f)
        return unixsock.USHM_MAX
    }
    ss(state, S_CHRF, f)
    ss(state, S_CHRI, k + 1)
    tab_publish(state)
    return k
}

fn tw(f: u64, w: u64, v: u64) {
    __mmio_write64((f + w * 8) as *mut u64, v)
}

// Write the table (only when somebody asked for it once: `tab_object`). Called by `compose` before the frame.
fn tab_publish(state: u64) {
    let f: u64 = gs(state, S_TABF)
    if f == 0 {
        return
    }
    let seq: u64 = gs(state, S_TABSEQ) + 1
    ss(state, S_TABSEQ, seq)
    arch.atomic_store(f + 8, seq) // odd: being written (a locked store: a full barrier, also on a core that reorders)
    var n: u64 = 0
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 {
            let r: u64 = TAB_HEAD + n * TAB_ROW
            tw(f, r + 0, wg(state, i, W_ID) | (i << 32))
            tw(f, r + 1, wg(state, i, W_OWNER))
            tw(f, r + 2, wg(state, i, W_X))
            tw(f, r + 3, wg(state, i, W_Y))
            tw(f, r + 4, wg(state, i, W_W))
            tw(f, r + 5, wg(state, i, W_H))
            tw(f, r + 6, wg(state, i, W_Z) | (wg(state, i, W_LAYER) << 16) | (wg(state, i, W_KIND) << 24))
            tw(f, r + 7, wg(state, i, W_FLAGS))
            tw(f, r + 8, inx(state, i) | (iny(state, i) << 32))
            tw(f, r + 9, wg(state, i, W_SHM))
            tw(f, r + 10, wg(state, i, W_W) * 4)
            var plain: u64 = 0
            if tab_plain(state, i) {
                plain = 1
            }
            // S6a: bit 33 = this window gets a shadow under its frame (a framed window that is on the screen): `paint_win` calls `paint_shadow`
            var shad: u64 = 0
            if deko(state, i) && !win_hidden(state, i) {
                shad = 1
            }
            tw(f, r + 11, (wg(state, i, W_OPAC) & 0xFFFFFFFF) | (plain << 32) | (shad << 33))
            // S6b: the title and the netmark of this row go to the chrome page (never while the screen is locked)
            let cf: u64 = gs(state, S_CHRF)
            if cf != 0 {
                var t0: u64 = 0
                var t1: u64 = 0
                var t2: u64 = 0
                var t3: u64 = 0
                var mk: u64 = 0
                if !sperre_an(state) {
                    let tp: u64 = state + wat(i) + W_TITLE
                    t0 = __mmio_read64(tp as *mut u64)
                    t1 = __mmio_read64((tp + 8) as *mut u64)
                    t2 = __mmio_read64((tp + 16) as *mut u64)
                    t3 = __mmio_read64((tp + 24) as *mut u64) & 0x00FFFFFFFFFFFFFF
                    let sicht: u64 = netview.view_of(state, win_owner(state, i))
                    if sicht != netview.V_REAL && sicht <= 3 {
                        mk = sicht
                    }
                }
                tw(cf, CHR_TITLE + n * 4, t0)
                tw(cf, CHR_TITLE + n * 4 + 1, t1)
                tw(cf, CHR_TITLE + n * 4 + 2, t2)
                tw(cf, CHR_TITLE + n * 4 + 3, t3)
                tw(cf, CHR_MARK + n, mk)
            }
            n = n + 1
        }
        i = i + 1
    }
    tw(f, 0, TAB_MAGIC | (1 << 32))
    tw(f, 2, n)
    tw(f, 3, gs(state, S_SW) | (gs(state, S_SH) << 32))
    var fo: u64 = 0
    let fi: u64 = gs(state, S_FOCUS)
    if fi != 0 {
        fo = wg(state, fi - 1, W_ID)
    }
    tw(f, 4, fo)
    // S6a: what the compositor needs to paint the window shadow exactly (the same numbers `shadow_build` takes, already scaled by the window
    // alpha): word 8 = strength of the focused window | its reach << 8 | strength of the others << 16 | their reach << 24 | corner radius << 32;
    // word 9 = shadow colour (rgb24) | 1 << 32 (the words are valid) | 1 << 33 when the old ring painter is on
    var sold: u64 = 0
    if gs(state, S_SHOLD) != 0 {
        sold = 1
    }
    tw(f, 8, shadow_staerke(state, FM_SHADOW) | (form(state, FM_SHADOW_R) << 8) | (shadow_staerke(state, FM_SHADOW2) << 16)
        | (form(state, FM_SHADOW_R2) << 24) | (form(state, FM_RADIUS) << 32))
    tw(f, 9, rgb24(state, form(state, FM_SHADOW_C)) | (1 << 32) | (sold << 33))
    // S6b: the numbers of the chrome (see `chrome_object`)
    let cf2: u64 = gs(state, S_CHRF)
    if cf2 != 0 {
        tw(cf2, 0, CHR_MAGIC | (1 << 32))
        tw(cf2, 2, 1)
        tw(cf2, 3, fb.rgb(state, 255, 0, 0))
        tw(cf2, 4, fb.rgb(state, 0, 255, 0))
        tw(cf2, 5, fb.rgb(state, 0, 0, 255))
        tw(cf2, 6, deco_rgb(state, DK_FRAME))
        tw(cf2, 7, deco_rgb(state, DK_TITLE))
        tw(cf2, 8, deco_rgb(state, DK_TEXT))
        tw(cf2, 9, deco_rgb(state, DK_FRAME_ON))
        tw(cf2, 10, deco_rgb(state, DK_TITLE_ON))
        tw(cf2, 11, deco_rgb(state, DK_TEXT_ON))
        tw(cf2, 12, deco_rgb(state, DK_CLOSE))
        tw(cf2, 13, deco_rgb(state, DK_CLOSE_MARK))
        tw(cf2, 14, form(state, FM_RADIUS))
        tw(cf2, 15, form(state, FM_GRAD))
        tw(cf2, 16, form(state, FM_CAPTION))
        tw(cf2, 17, border(state))
        tw(cf2, 18, title_h(state))
        tw(cf2, 19, cap_w(state))
        tw(cf2, 20, uisc(state))
        tw(cf2, 21, deco_alpha(state))
        tw(cf2, 22, gs(state, S_CAPHOV))
        tw(cf2, 23, gs(state, S_CAPDOWN))
        let fu: u64 = gs(state, S_FONT_UI)
        tw(cf2, 24, fu)
        tw(cf2, 25, gs(state, S_PX_UI))
        tw(cf2, 26, title_pad(state))
        var tbase: i64 = 0
        if fu < ttf.MAX_FONTS {
            tbase = title_base(state, fu)
        }
        tw(cf2, 27, tbase as u64)
        tw(cf2, 28, netmark.W | (netmark.H << 16))
        var fok: u64 = 0
        if fu < ttf.MAX_FONTS {
            fok = 1
        }
        tw(cf2, 29, fok)
    }
    ss(state, S_TAB_N, gs(state, S_TAB_N) + 1)
    tw(f, 5, gs(state, S_COMPOSITES))
    tw(f, 6, TAB_ROW)
    var lk: u64 = 0
    if sperre_an(state) {
        lk = 1
    }
    tw(f, 7, lk)
    let cf3: u64 = gs(state, S_CHRF)
    if cf3 != 0 {
        tw(cf3, 1, seq + 1)
    }
    arch.atomic_store(f + 8, seq + 1) // even: consistent
    ss(state, S_TABSEQ, seq + 1)
}

// numbers for the F12 line and the tests: 0 attached, 1 damage calls, 2 pixels named, 3 rows blitted, 4 pixels blitted, 5 detached, 6 table pages
fn sh_stat(state: u64, k: u64) -> u64 {
    if k == 0 {
        return gs(state, S_SH_ATT)
    }
    if k == 1 {
        return gs(state, S_SH_DMG)
    }
    if k == 2 {
        return gs(state, S_SH_PX)
    }
    if k == 3 {
        return gs(state, S_BL_N)
    }
    if k == 4 {
        return gs(state, S_BL_PX)
    }
    if k == 5 {
        return gs(state, S_SH_DET)
    }
    return gs(state, S_TAB_N)
}

// ===========================================================================================================================
// COMPOSITOR S5 (docs/COMPOSITOR.md section 4): THE COMPOSITOR IN RING 3 TAKES THE SCAN-OUT, THE KERNEL KEEPS A WATCHDOG
//
// `wmd` (kernel/user/wmd.fi) attaches with WM_COMP. From then on `compose` still paints the whole picture into the draw target,
// but it does NOT push it to the card: the finished rectangle is HANDED OVER (cp_hand) and the compositor is woken (cp_kick).
// The compositor calls WM_COMP / CP_PRESENT, and only then does the card get the rectangle (cp_flush_locked) -- the card belongs to the
// kernel, the decision WHEN a frame is shown belongs to ring 3. What stays in the kernel on purpose: the framebuffer and the flip, the
// lock (while it stands the compositor gets no input and no key), the trusted dialog, and THE WATCHDOG:
//
//   * a rectangle that waits longer than CP_LIMIT_MS for the compositor is pushed to the card by the kernel (a MISS);
//   * CP_MAXMISS misses in a row, or the death of the task, detach the compositor: the kernel presents every frame itself again,
//     exactly as before S5 (that is the fall-back path, it is the old code);
//   * the word `nowatch` switches the watchdog off (the counter-proof: a compositor that hangs then freezes the screen);
//   * the word `nocomp` refuses the attach (the counter-proof: the kernel presents, the compositor's presents stay at 0).
//
// The INPUT COPY RING: the compositor needs pointer and key events for chrome (move, hover, Alt+Tab). The kernel keeps routing input
// itself (`darf`, the lock) and writes a COPY into a read-only page (WM_COMP / CP_PAGE): pointer moves, button changes, and keys ONLY
// while Alt or the Windows key is held (a shortcut) -- the code of an ordinary key is never copied, so a password typed into a window is
// not seen. While the screen is locked or the trusted dialog is up NOTHING is copied.
//
// The compositor page (u64 words): 0 magic | version << 32, 1 attached (0 / 1), 2 events written (head), 3 events refused (lock / dialog),
// 4 frames handed over, 5 frames presented, 6 a rectangle waits, 7..10 its x0 y0 x1 y1, 11 screen locked, 12 cycles per millisecond.
// From word 16 a ring of CP_RING entries of 4 words: 0 type | mods << 8 | buttons << 16 | (index + 1) << 32, 1 x | y << 32, 2 key code,
// 3 time stamp counter at the interrupt. A reader keeps its own tail; an entry is good when word 0 >> 32 == its index + 1 before and after.
const CP_MAGIC: u64 = 0x504D4357
const CP_LIMIT_MS: u64 = 50
const CP_MAXMISS: u64 = 3
const CP_RING: u64 = 64
const CP_RING_AT: u64 = 16
const CP_NOT: u64 = 0xFFFFFFFFFFFFFFFF // the caller is not the attached compositor
const CP_BUSY: u64 = 0xFFFFFFFFFFFFFFFE // the compose lock did not come free in time: try again
const CP_EV_MOVE: u64 = 1
const CP_EV_BTN: u64 = 2
const CP_EV_KEY: u64 = 3
const S_CP_TASK: u64 = 0x1F00   // task index of the compositor + 1, 0 = none (the kernel presents)
const S_CP_PID: u64 = 0x1F08    // its pid (the slot may be reused)
const S_CP_FSEQ: u64 = 0x1F10   // frames handed over
const S_CP_ASEQ: u64 = 0x1F18   // frames shown
const S_CP_PEND: u64 = 0x1F20   // 1 = a rectangle waits for the card
const S_CP_X0: u64 = 0x1F28
const S_CP_Y0: u64 = 0x1F30
const S_CP_X1: u64 = 0x1F38
const S_CP_Y1: u64 = 0x1F40
const S_CP_T0: u64 = 0x1F48     // time stamp counter when the oldest waiting rectangle was handed over
const S_CP_IN0: u64 = 0x1F50    // time stamp counter of the first pointer movement not shown yet
const S_CP_NEW: u64 = 0x1F58    // 1 = something was handed over since the last kick
const S_CP_MISS: u64 = 0x1F60   // misses in a row
const S_CP_NMISS: u64 = 0x1F68  // misses, running total (the watchdog pushed a frame)
const S_CP_NDET: u64 = 0x1F70   // detaches, running total
const S_CP_NATT: u64 = 0x1F78   // attaches, running total
const S_CP_NPRES: u64 = 0x1F80  // frames the compositor showed
const S_CP_NKP: u64 = 0x1F88    // frames the kernel showed itself (no compositor)
const S_CP_NHAND: u64 = 0x1F90  // rectangles handed over
const S_CP_PAGEF: u64 = 0x1F98  // the compositor page (frame address)
const S_CP_PAGEI: u64 = 0x1FA0  // its shared object + 1
const S_CP_HEAD: u64 = 0x1FA8   // events written
const S_CP_EVREF: u64 = 0x1FB0  // events refused (lock, dialog)
const S_CP_HOP: u64 = 0x1FB8    // hand-over to present, microseconds: n, sum, max (3 words)
const S_CP_WLAT: u64 = 0x1FD0   // pointer interrupt to card, compositor path: n, sum, max
const S_CP_KLAT: u64 = 0x1FE8   // the same, kernel path: n, sum, max

fn cp_on(state: u64) -> bool {
    return gs(state, S_CP_TASK) != 0
}

fn cp_lock(state: u64) -> bool {
    let lk: u64 = state + kstate.WM_OFF + S_CLOCK
    var n: u64 = 0
    while n < 200000 {
        let was: u64 = __atomic_swap(lk as *mut u64, 0 as u64, 1 as u64)
        if was == 0 {
            return true
        }
        n = n + 1
    }
    return false
}

fn cp_unlock(state: u64) {
    arch.atomic_store(state + kstate.WM_OFF + S_CLOCK, 0)
}

// the compositor page: made at the first WM_COMP / CP_PAGE, read-only for everybody (SMF_RO)
fn cp_page_object(state: u64) -> u64 {
    if gs(state, S_CP_PAGEI) != 0 {
        return gs(state, S_CP_PAGEI) - 1
    }
    let f: u64 = mem.frame_alloc(state)
    if f == 0 {
        return unixsock.USHM_MAX
    }
    var o: u64 = 0
    while o < mem.FRAME_SIZE / 8 {
        __mmio_write64((f + o * 8) as *mut u64, 0)
        o = o + 1
    }
    let k: u64 = unixsock.shm_wrap(state, f, 1, unixsock.SMF_RO)
    if k >= unixsock.USHM_MAX {
        mem.frame_free(state, f)
        return unixsock.USHM_MAX
    }
    ss(state, S_CP_PAGEF, f)
    ss(state, S_CP_PAGEI, k + 1)
    tw(f, 0, CP_MAGIC | (1 << 32))
    tw(f, 12, time.khz(state))
    cp_sync(state)
    return k
}

// the header words of the page (no sequence number: every word is a single aligned store)
fn cp_sync(state: u64) {
    let f: u64 = gs(state, S_CP_PAGEF)
    if f == 0 {
        return
    }
    var on: u64 = 0
    if cp_on(state) {
        on = 1
    }
    tw(f, 1, on)
    tw(f, 3, gs(state, S_CP_EVREF))
    tw(f, 4, gs(state, S_CP_FSEQ))
    tw(f, 5, gs(state, S_CP_ASEQ))
    tw(f, 6, gs(state, S_CP_PEND))
    tw(f, 7, gs(state, S_CP_X0))
    tw(f, 8, gs(state, S_CP_Y0))
    tw(f, 9, gs(state, S_CP_X1))
    tw(f, 10, gs(state, S_CP_Y1))
    var lk: u64 = 0
    if sperre_an(state) {
        lk = 1
    }
    tw(f, 11, lk)
}

// ================== W-J (17.10.2026): INPUT -> PICTURE LATENCY
//
// Boss: "every interaction feels slow". The desktop loop (kgui wait_wm) slept `sleep_ticks(1)` + `idle_wait`: a round every 10-20 ms,
// so a pointer packet waited up to 20 ms BEFORE wm.poll even saw it (USB HID is polled in that loop), then up to one more round for
// the frame. Two clocks, printed with the word `phases` on every F12 as `wm: lat ...` (running since the last F12):
//   gap*: time between two input polls while the desktop is ACTIVE (input or a frame in the last 200 ms). A packet arrives at a random
//         point of a gap, so the mean wait before the poll is  sum(gap^2) / (2 * sum(gap))  -> `gapwait`.
//   lat*: from wm.poll consuming pointer input to the frame being on the card (compose + present of the same round).
// Input -> picture (mean) = gapwait + latmean. The fast path (ACTIVE only; `nolatfix` = old loop): rounds of ~1 ms (yield-spin),
// composes at most every LJ_MIN_US after the last painted frame, the first frame after rest is never delayed.
const LJ_ACTIVE_US: u64 = 200000
const LJ_MIN_US: u64 = 6000
static mut lj_last_round: u64 = 0
static mut lj_act: u64 = 0
// r1049: last INPUT (pointer or key). Painted frames extend the active stretch only within LJ_CHAIN_US of it, so a timer frame at rest
// (terminal cursor blink, clock) never starts a 200 ms yield-spin (it did: 45 % of the core at idle).
static mut lj_inp: u64 = 0
const LJ_CHAIN_US: u64 = 1000000
static mut lj_in0: u64 = 0
static mut lj_in_comp: u64 = 0
static mut lj_last_comp: u64 = 0
static mut lj_comp_tsc: u64 = 0
// W-L: pointer-only frames (blit of the cursor box, cp_lat) never bump S_COMPOSITES -- the poll -> picture clock stayed open until some unrelated
// compose and read 60-180 ms on 2+ CPUs. `lj_cp_n` counts every frame that reached the card; lj_in_comp / lj_done compare against composes + it.
static mut lj_cp_n: u64 = 0
static mut lj_gap: [u64; 8] = [0 as u64; 8]
static mut lj_lat: [u64; 8] = [0 as u64; 8]

fn lj_us(state: u64, d: u64) -> u64 {
    let kh: u64 = time.khz(state)
    if kh < 1000 {
        return 0
    }
    return d / (kh / 1000)
}

fn lj_active(state: u64) -> bool {
    if lj_act == 0 {
        return false
    }
    let now: u64 = time.tsc()
    if now < lj_act {
        return true
    }
    return lj_us(state, now - lj_act) < LJ_ACTIVE_US
}

// called once per desktop round right after the input poll
fn lj_round(state: u64) {
    let now: u64 = time.tsc()
    if lj_last_round != 0 && now > lj_last_round && lj_active(state) {
        let g: u64 = lj_us(state, now - lj_last_round)
        lj_gap[0] = lj_gap[0] + 1
        lj_gap[1] = lj_gap[1] + g
        lj_gap[2] = lj_gap[2] + g * g
        if g > lj_gap[3] {
            lj_gap[3] = g
        }
        if g > 8000 {
            lj_gap[4] = lj_gap[4] + 1
        }
        if g > 16000 {
            lj_gap[5] = lj_gap[5] + 1
        }
        if g > 33000 {
            lj_gap[6] = lj_gap[6] + 1
        }
    }
    lj_last_round = now
}

// wm.poll consumed pointer input (move / button): start the poll -> picture clock, keep the fast path on
fn lj_input(state: u64) {
    let now: u64 = time.tsc()
    lj_act = now
    lj_inp = now
    if lj_in0 == 0 {
        lj_in0 = now
        lj_in_comp = gs(state, S_COMPOSITES) + lj_cp_n
    }
}

// after compose + present of a round: a frame was painted -> close the clock
fn lj_done(state: u64) {
    let c: u64 = gs(state, S_COMPOSITES)
    let now: u64 = time.tsc()
    if c != lj_last_comp {
        lj_last_comp = c
        lj_comp_tsc = now
        // r1049: a frame extends the active stretch only while the last input is recent (animation after a click / key), never from rest
        if lj_inp != 0 && (now < lj_inp || lj_us(state, now - lj_inp) < LJ_CHAIN_US) {
            lj_act = now
        }
    }
    if lj_in0 != 0 && c + lj_cp_n != lj_in_comp {
        if now > lj_in0 {
            let l: u64 = lj_us(state, now - lj_in0)
            // an input that changed nothing visible waits for some unrelated frame: ignore those (> 250 ms)
            if l < 250000 {
                lj_lat[0] = lj_lat[0] + 1
                lj_lat[1] = lj_lat[1] + l
                if l > lj_lat[2] {
                    lj_lat[2] = l
                }
                if l > 16000 {
                    lj_lat[3] = lj_lat[3] + 1
                }
                if l > 33000 {
                    lj_lat[4] = lj_lat[4] + 1
                }
            }
        }
        lj_in0 = 0
    }
}

// the fast path may compose now? (rest: always; active: not sooner than LJ_MIN_US after the last painted frame)
fn lj_may_compose(state: u64) -> bool {
    if kstate.mode_on(state, kstate.M_NOLATFIX) {
        return true
    }
    if !lj_active(state) {
        return true
    }
    let now: u64 = time.tsc()
    if lj_comp_tsc == 0 || now < lj_comp_tsc {
        return true
    }
    return lj_us(state, now - lj_comp_tsc) >= LJ_MIN_US
}

fn lj_fast(state: u64) -> bool {
    if kstate.mode_on(state, kstate.M_NOLATFIX) {
        return false
    }
    return lj_active(state)
}

fn lj_say_reset(state: u64) {
    var s_l: [u8; 14] = "wm: lat gapn=\0"
    var s_1: [u8; 10] = " gapmean=\0"
    var s_2: [u8; 10] = " gapwait=\0"
    var s_3: [u8; 9] = " gapmax=\0"
    var s_4: [u8; 7] = " gap8=\0"
    var s_5: [u8; 8] = " gap16=\0"
    var s_6: [u8; 8] = " gap33=\0"
    var s_7: [u8; 8] = " latn=\0\0"
    var s_8: [u8; 10] = " latmean=\0"
    var s_9: [u8; 9] = " latmax=\0"
    var s_a: [u8; 8] = " lat16=\0"
    var s_b: [u8; 8] = " lat33=\0"
    let n: u64 = lj_gap[0]
    serial.puts((&s_l[0]) as u64)
    serial.dec(n)
    serial.puts((&s_1[0]) as u64)
    if n != 0 {
        serial.dec(lj_gap[1] / n)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_2[0]) as u64)
    if lj_gap[1] != 0 {
        serial.dec(lj_gap[2] / (2 * lj_gap[1]))
    } else {
        serial.dec(0)
    }
    serial.puts((&s_3[0]) as u64)
    serial.dec(lj_gap[3])
    serial.puts((&s_4[0]) as u64)
    serial.dec(lj_gap[4])
    serial.puts((&s_5[0]) as u64)
    serial.dec(lj_gap[5])
    serial.puts((&s_6[0]) as u64)
    serial.dec(lj_gap[6])
    let m: u64 = lj_lat[0]
    serial.puts((&s_7[0]) as u64)
    serial.dec(m)
    serial.puts((&s_8[0]) as u64)
    if m != 0 {
        serial.dec(lj_lat[1] / m)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_9[0]) as u64)
    serial.dec(lj_lat[2])
    serial.puts((&s_a[0]) as u64)
    serial.dec(lj_lat[3])
    serial.puts((&s_b[0]) as u64)
    serial.dec(lj_lat[4])
    serial.nl()
    var z: u64 = 0
    while z < 8 {
        lj_gap[z as usize] = 0
        lj_lat[z as usize] = 0
        z = z + 1
    }
}

// the first pointer movement that has not reached the card yet (the start of the input-to-picture clock)
fn cp_in(state: u64) {
    if gs(state, S_CP_IN0) == 0 {
        ss(state, S_CP_IN0, time.tsc())
    }
}

fn cp_stat3(state: u64, at: u64, us: u64) {
    ss(state, at, gs(state, at) + 1)
    ss(state, at + 8, gs(state, at + 8) + us)
    if us > gs(state, at + 16) {
        ss(state, at + 16, us)
    }
}

// the frame reached the card: close the clocks. `by_comp` says who put it there.
fn cp_lat(state: u64, by_comp: bool) {
    lj_cp_n = lj_cp_n + 1
    let kh: u64 = time.khz(state)
    if kh < 1000 {
        ss(state, S_CP_IN0, 0)
        return
    }
    let now: u64 = time.tsc()
    let t0: u64 = gs(state, S_CP_IN0)
    ss(state, S_CP_IN0, 0)
    if t0 != 0 && now > t0 {
        if by_comp {
            cp_stat3(state, S_CP_WLAT, (now - t0) / (kh / 1000))
        } else {
            cp_stat3(state, S_CP_KLAT, (now - t0) / (kh / 1000))
        }
    }
}

// A finished rectangle (compose holds the lock): it waits for the compositor instead of going to the card.
fn cp_hand(state: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if gs(state, S_CP_PEND) == 0 {
        ss(state, S_CP_X0, x0)
        ss(state, S_CP_Y0, y0)
        ss(state, S_CP_X1, x1)
        ss(state, S_CP_Y1, y1)
        ss(state, S_CP_PEND, 1)
        ss(state, S_CP_T0, time.tsc())
    } else {
        if x0 < gs(state, S_CP_X0) {
            ss(state, S_CP_X0, x0)
        }
        if y0 < gs(state, S_CP_Y0) {
            ss(state, S_CP_Y0, y0)
        }
        if x1 > gs(state, S_CP_X1) {
            ss(state, S_CP_X1, x1)
        }
        if y1 > gs(state, S_CP_Y1) {
            ss(state, S_CP_Y1, y1)
        }
    }
    ss(state, S_CP_NEW, 1)
    ss(state, S_CP_NHAND, gs(state, S_CP_NHAND) + 1)
}

// Wake the compositor, once per `compose`, after everything was handed over (lock held).
fn cp_kick(state: u64) {
    if gs(state, S_CP_TASK) == 0 || gs(state, S_CP_NEW) == 0 {
        return
    }
    ss(state, S_CP_NEW, 0)
    ss(state, S_CP_FSEQ, gs(state, S_CP_FSEQ) + 1)
    cp_sync(state)
    sched.poll_kick_one(state, gs(state, S_CP_TASK) - 1)
}

// Push the waiting rectangle to the card (lock held): the one place where a handed-over frame becomes visible. Returns its pixels.
fn cp_flush_locked(state: u64, by_comp: bool) -> u64 {
    if gs(state, S_CP_PEND) == 0 {
        return 0
    }
    let x0: u64 = gs(state, S_CP_X0)
    let y0: u64 = gs(state, S_CP_Y0)
    let x1: u64 = gs(state, S_CP_X1)
    let y1: u64 = gs(state, S_CP_Y1)
    let t0: u64 = gs(state, S_CP_T0)
    ss(state, S_CP_PEND, 0)
    ss(state, S_CP_T0, 0)
    var area: u64 = 0
    var pl_t0: u64 = 0
    if gs(state, S_PL_ON) != 0 {
        pl_t0 = time.tsc()
    }
    if x1 > x0 && y1 > y0 {
        if gs(state, S_VSYNC) != 0 {
            // the same two ways `present` takes
            if fb.flip_on(state) {
                fb.flush_rect(state, 0, 0, gs(state, S_SW), gs(state, S_SH))
                fb.flip(state)
            } else {
                fb.flush_rect(state, x0, y0, x1 - x0, y1 - y0)
            }
            ss(state, S_PRESENTS, gs(state, S_PRESENTS) + 1)
            fb.frame_done(state)
        } else {
            flush_box(state, x0, y0, x1, y1)
        }
        area = (x1 - x0) * (y1 - y0)
        ss(state, S_PXSUM, gs(state, S_PXSUM) +% area)
    }
    ss(state, S_CP_ASEQ, gs(state, S_CP_FSEQ))
    if pl_t0 != 0 && x1 > x0 && y1 > y0 {
        var pl_kind: u64 = PL_F_WDOG
        if by_comp {
            pl_kind = PL_F_COMP
        }
        pl_record(state, pl_kind, x0, y0, x1, y1, pl_t0, t0)
    }
    if by_comp {
        let kh: u64 = time.khz(state)
        let now: u64 = time.tsc()
        if kh >= 1000 && t0 != 0 && now > t0 {
            cp_stat3(state, S_CP_HOP, (now - t0) / (kh / 1000))
        }
        ss(state, S_CP_NPRES, gs(state, S_CP_NPRES) + 1)
    }
    cp_lat(state, by_comp)
    cp_sync(state)
    return area
}

fn cp_detach_locked(state: u64, why: u64) {
    if gs(state, S_CP_TASK) == 0 {
        return
    }
    var s_cd: [u8; 29] = "wm: compositor detached why=\0"
    serial.puts((&s_cd[0]) as u64)
    serial.dec(why)
    serial.nl()
    // whatever waits goes to the card now; from the next frame on the kernel presents itself
    let _px: u64 = cp_flush_locked(state, false)
    ss(state, S_CP_TASK, 0)
    ss(state, S_CP_PID, 0)
    ss(state, S_CP_NDET, gs(state, S_CP_NDET) + 1)
    cp_sync(state)
}

// THE WATCHDOG (compose calls it with the lock held, at the start of every run, and the desktop loop runs `compose` all the time):
// a dead compositor is detached at once; a rectangle that waits longer than CP_LIMIT_MS is pushed by the kernel.
fn cp_watch(state: u64) {
    let tk: u64 = gs(state, S_CP_TASK)
    if tk == 0 {
        return
    }
    let idx: u64 = tk - 1
    let st: u64 = sched.tget(state, idx, sched.T_STATE)
    if st == sched.S_ZOMBIE || st == sched.S_FREE || sched.tget(state, idx, sched.T_PID) != gs(state, S_CP_PID) {
        cp_detach_locked(state, 1)
        return
    }
    if fb.nowatch_an(state) {
        return
    }
    if gs(state, S_CP_PEND) == 0 {
        return
    }
    let kh: u64 = time.khz(state)
    let t0: u64 = gs(state, S_CP_T0)
    let now: u64 = time.tsc()
    if kh >= 1000 && t0 != 0 && now > t0 && (now - t0) / kh >= CP_LIMIT_MS {
        let _px: u64 = cp_flush_locked(state, false)
        ss(state, S_CP_NMISS, gs(state, S_CP_NMISS) + 1)
        ss(state, S_CP_MISS, gs(state, S_CP_MISS) + 1)
        if gs(state, S_CP_MISS) >= CP_MAXMISS {
            cp_detach_locked(state, 2)
        }
    }
}


// ===========================================================================================================================
// PRESENT LOG (W-DELLFLICK, 14.10.2026): ONE RECORD PER PRESENT, OFF BY DEFAULT, ONE WORD COMPARED WHEN OFF.
//
// Why: on the real Dell (Intel I219, real GPU framebuffer, real timing) the sign-in screen flickered (middle area pale for 1-3 frames every
// 1-2 s) and no VM reproduces it. This log records, for every rectangle that reaches the card, what the VM cannot show us:
// which core composed it, which core presented it, which core made the last WM_DAMAGE call (= the core the client painted on), how long the
// hand-over waited, whether the compositor or the watchdog presented, and whether a CLIENT BUFFER CHANGED WHILE THE FRAME WAS COMPOSED.
//
// Switch: WM_COMP / CP_LOG (stride), root only: the program `presentlog` (kernel/user/presentlog.fi) does it and writes the records to
// /var/log/presentlog.txt. stride 0 = off. With the switch off, every hook is `if gs(state, S_PL_ON) != 0` -- one load, no store.
//
// The torn-buffer test: before the desktop is filled and after the last window was copied, a hash of every shared client buffer is taken
// (every stride-th 64-bit word). When the two hashes differ a client wrote into its buffer WHILE the frame was composed -- the frame holds a mix
// of two client pictures: flag TORN. Flag DMGMID: a WM_DAMAGE arrived during the compose (the client finished a picture mid-frame).
//
// The page (SMF_RO, one frame, u64 words): 0 magic | version << 32, 1 stride (0 = off), 2 head (records written), 3 ring size | words per record << 32,
// 4 cycles per ms, 5 environment bits (0 double buffered, 1 uncached, 2 page flip, 3 vsync, 4 compositor attached), 6 suspected torn presents (total),
// 7 presents logged (total). From word 16 a ring of PL_RING records of 8 words (a record is good when word 0 >> 32 == its index + 1 before AND after
// the read):
//   0 (index + 1) << 32 | flags   (bit 0 compositor presented, bit 1 watchdog presented, bit 2 TORN, bit 3 DMGMID, bit 4 several composes merged,
//                                  bit 5 painted straight on the card (no back buffer))
//   1 time stamp counter when the present began     2 x0 | y0 << 16 | x1 << 32 | y1 << 48
//   3 compose core | present core << 8 | damage core << 16 | composes << 24 | hand-over to present, microseconds << 32
//   4 compose duration (us, the longest) | present (copy) duration us << 32
//   5 hash before | hash after << 32 (of the last compose; 32 bits each)
//   6 damage calls (total, low 32 bits) | damage-to-present us << 32      7 microseconds since the previous present
const PL_MAGIC: u64 = 0x474C5250
const PL_RING: u64 = 60
const PL_AT: u64 = 16
const PL_ENT: u64 = 8
const PL_F_COMP: u64 = 1
const PL_F_WDOG: u64 = 2
const PL_F_TORN: u64 = 4
const PL_F_DMGMID: u64 = 8
const PL_F_MULTI: u64 = 16
const PL_F_DIRECT: u64 = 32
const S_PL_ON: u64 = 0x1E68     // stride in 64-bit words, 0 = off
const S_PL_PAGEF: u64 = 0x1E70  // the log page (frame address)
const S_PL_PAGEI: u64 = 0x1E78  // its shared object + 1
const S_PL_HEAD: u64 = 0x1E80   // records written
const S_PL_DSEQ: u64 = 0x1E88   // WM_DAMAGE calls (running total)
const S_PL_DCORE: u64 = 0x1E90  // core of the last WM_DAMAGE call
const S_PL_DTSC: u64 = 0x1E98   // its time stamp
const S_PL_FLAGS: u64 = 0x1EA0  // flags collected since the last present
const S_PL_CCORE: u64 = 0x1EA8  // core of the last compose
const S_PL_CDUR: u64 = 0x1EB0   // longest compose since the last present (us)
const S_PL_HASH: u64 = 0x1EB8   // hash before | hash after << 32 of the last compose
const S_PL_NCOMP: u64 = 0x1EC0  // composes since the last present
const S_PL_NTORN: u64 = 0x1EC8  // presents flagged TORN (total)
const S_PL_TPREV: u64 = 0x1ED0  // time stamp of the previous present
const S_PL_NREC: u64 = 0x1ED8   // presents logged (total)

fn pl_on(state: u64) -> bool {
    return gs(state, S_PL_ON) != 0
}

// the APIC id of the core this runs on (cpuid leaf 1, ebx bits 31..24)
fn pl_core() -> u64 {
    var v: u64 = 0
    asm("push rbx\nmov eax, 1\ncpuid\nmov eax, ebx\nshr eax, 24\npop rbx",
        out("rax") & v, clobber("rcx"), clobber("rdx"))
    return (v >> 0) & 0xFF
}

// Hash of every shared client buffer (every stride-th word). Reads only; never called with the log off.
fn pl_hash(state: u64) -> u64 {
    var stride: u64 = gs(state, S_PL_ON)
    if stride == 0 {
        stride = 16
    }
    var h: u64 = 0xCBF29CE484222325
    var i: u64 = 0
    while i < MAX_WIN {
        if win_shm(state, i) != 0 && !win_hidden(state, i) {
            let b: u64 = wg(state, i, W_BUF)
            let n: u64 = wg(state, i, W_BUFBYTES) / 8
            if b != 0 {
                var k: u64 = 0
                while k < n {
                    h = (h ^ __mmio_read64((b + k * 8) as *mut u64)) *% 0x100000001B3
                    k = k + stride
                }
            }
        }
        i = i + 1
    }
    return h
}

// WM_DAMAGE hook: who finished a picture, on which core, when.
fn pl_damage(state: u64) {
    ss(state, S_PL_DSEQ, gs(state, S_PL_DSEQ) + 1)
    ss(state, S_PL_DCORE, pl_core())
    ss(state, S_PL_DTSC, time.tsc())
}

// compose_rect hooks: `pl_compose_begin` returns the hash and the damage counter; `pl_compose_end` compares.
fn pl_compose_begin(state: u64, outp: u64) {
    __mmio_write64(outp as *mut u64, pl_hash(state))
    __mmio_write64((outp + 8) as *mut u64, gs(state, S_PL_DSEQ))
    __mmio_write64((outp + 16) as *mut u64, time.tsc())
}

fn pl_compose_end(state: u64, inp: u64) {
    let hb: u64 = __mmio_read64(inp as *mut u64)
    let d0: u64 = __mmio_read64((inp + 8) as *mut u64)
    let t0: u64 = __mmio_read64((inp + 16) as *mut u64)
    let ha: u64 = pl_hash(state)
    var fl: u64 = gs(state, S_PL_FLAGS)
    if ha != hb {
        fl = fl | PL_F_TORN
    }
    if gs(state, S_PL_DSEQ) != d0 {
        fl = fl | PL_F_DMGMID
    }
    if gs(state, S_PL_NCOMP) != 0 {
        fl = fl | PL_F_MULTI
    }
    ss(state, S_PL_FLAGS, fl)
    ss(state, S_PL_NCOMP, gs(state, S_PL_NCOMP) + 1)
    ss(state, S_PL_CCORE, pl_core())
    ss(state, S_PL_HASH, (hb & 0xFFFFFFFF) | (ha << 32))
    let us: u64 = ph_us(state, t0, time.tsc())
    if us > gs(state, S_PL_CDUR) {
        ss(state, S_PL_CDUR, us)
    }
}

// the log page: made at the first CP_LOG, read-only for everybody
fn pl_page_object(state: u64) -> u64 {
    if gs(state, S_PL_PAGEI) != 0 {
        return gs(state, S_PL_PAGEI) - 1
    }
    let f: u64 = mem.frame_alloc(state)
    if f == 0 {
        return unixsock.USHM_MAX
    }
    var o: u64 = 0
    while o < mem.FRAME_SIZE / 8 {
        __mmio_write64((f + o * 8) as *mut u64, 0)
        o = o + 1
    }
    let k: u64 = unixsock.shm_wrap(state, f, 1, unixsock.SMF_RO)
    if k >= unixsock.USHM_MAX {
        mem.frame_free(state, f)
        return unixsock.USHM_MAX
    }
    ss(state, S_PL_PAGEF, f)
    ss(state, S_PL_PAGEI, k + 1)
    tw(f, 0, PL_MAGIC | (1 << 32))
    tw(f, 3, PL_RING | (PL_ENT << 32))
    tw(f, 4, time.khz(state))
    return k
}

fn pl_env_bits(state: u64) -> u64 {
    var e: u64 = 0
    if fb.double_buffered(state) {
        e = e | 1
    }
    if fb.uncached(state) {
        e = e | 2
    }
    if fb.flip_on(state) {
        e = e | 4
    }
    if gs(state, S_VSYNC) != 0 {
        e = e | 8
    }
    if cp_on(state) {
        e = e | 16
    }
    return e
}

// WM_COMP / CP_LOG: root (`presentlog`) switches the log on (stride > 0) or off (0) and gets the page. CP_BUSY (0 for the caller) = switched off.
fn cp_log(state: u64, me: u64, stride: u64) -> u64 {
    // root only (WM_COMP is root only in sysgui); no compositor needed: the Dell shown the kernel path, `wmd present` is not running there
    if stride == 0 {
        ss(state, S_PL_ON, 0)
        let f0: u64 = gs(state, S_PL_PAGEF)
        if f0 != 0 {
            tw(f0, 1, 0)
        }
        return CP_BUSY
    }
    let k: u64 = pl_page_object(state)
    if k >= unixsock.USHM_MAX {
        return k
    }
    let f: u64 = gs(state, S_PL_PAGEF)
    tw(f, 1, stride)
    tw(f, 5, pl_env_bits(state))
    ss(state, S_PL_FLAGS, 0)
    ss(state, S_PL_NCOMP, 0)
    ss(state, S_PL_CDUR, 0)
    ss(state, S_PL_TPREV, time.tsc())
    ss(state, S_PL_ON, stride)
    return k
}

// One record, written after the rectangle reached the card. `kind`: PL_F_COMP / PL_F_WDOG / 0 (kernel path); `t0` = the time stamp
// when the present began; `hand_t0` = when the rectangle was handed over (0 = unknown).
fn pl_record(state: u64, kind: u64, x0: u64, y0: u64, x1: u64, y1: u64, t0: u64, hand_t0: u64) {
    let f: u64 = gs(state, S_PL_PAGEF)
    if f == 0 {
        return
    }
    let t1: u64 = time.tsc()
    var fl: u64 = gs(state, S_PL_FLAGS) | kind
    if !fb.double_buffered(state) {
        fl = fl | PL_F_DIRECT
    }
    if (fl & PL_F_TORN) != 0 {
        ss(state, S_PL_NTORN, gs(state, S_PL_NTORN) + 1)
    }
    let idx: u64 = gs(state, S_PL_HEAD)
    let at: u64 = PL_AT + (idx % PL_RING) * PL_ENT
    tw(f, at, 0)
    tw(f, at + 1, t0)
    tw(f, at + 2, (x0 & 0xFFFF) | ((y0 & 0xFFFF) << 16) | ((x1 & 0xFFFF) << 32) | ((y1 & 0xFFFF) << 48))
    var hop: u64 = 0
    if hand_t0 != 0 && t0 > hand_t0 {
        hop = ph_us(state, hand_t0, t0)
    }
    tw(f, at + 3, (gs(state, S_PL_CCORE) & 0xFF) | ((pl_core() & 0xFF) << 8) | ((gs(state, S_PL_DCORE) & 0xFF) << 16)
        | ((gs(state, S_PL_NCOMP) & 0xFF) << 24) | ((hop & 0xFFFFFFFF) << 32))
    tw(f, at + 4, (gs(state, S_PL_CDUR) & 0xFFFFFFFF) | ((ph_us(state, t0, t1) & 0xFFFFFFFF) << 32))
    tw(f, at + 5, gs(state, S_PL_HASH))
    var dus: u64 = 0
    if gs(state, S_PL_DTSC) != 0 && t1 > gs(state, S_PL_DTSC) {
        dus = ph_us(state, gs(state, S_PL_DTSC), t1)
    }
    tw(f, at + 6, (gs(state, S_PL_DSEQ) & 0xFFFFFFFF) | ((dus & 0xFFFFFFFF) << 32))
    var since: u64 = 0
    if gs(state, S_PL_TPREV) != 0 && t0 > gs(state, S_PL_TPREV) {
        since = ph_us(state, gs(state, S_PL_TPREV), t0)
    }
    tw(f, at + 7, since)
    tw(f, at, ((idx + 1) << 32) | fl)
    ss(state, S_PL_HEAD, idx + 1)
    ss(state, S_PL_NREC, gs(state, S_PL_NREC) + 1)
    ss(state, S_PL_TPREV, t0)
    ss(state, S_PL_FLAGS, 0)
    ss(state, S_PL_NCOMP, 0)
    ss(state, S_PL_CDUR, 0)
    tw(f, 2, idx + 1)
    tw(f, 6, gs(state, S_PL_NTORN))
    tw(f, 7, gs(state, S_PL_NREC))
}

// WM_COMP / CP_ATTACH. 0 = attached, 1 = refused (`nocomp`), 2 = another live compositor is attached, 3 = busy.
fn cp_attach(state: u64, me: u64) -> u64 {
    if fb.nocomp_an(state) {
        return 1
    }
    if !cp_lock(state) {
        return 3
    }
    let cur: u64 = gs(state, S_CP_TASK)
    if cur != 0 && cur != me + 1 {
        let idx: u64 = cur - 1
        let st: u64 = sched.tget(state, idx, sched.T_STATE)
        if st != sched.S_ZOMBIE && st != sched.S_FREE && sched.tget(state, idx, sched.T_PID) == gs(state, S_CP_PID) {
            cp_unlock(state)
            return 2
        }
        cp_detach_locked(state, 1)
    }
    ss(state, S_CP_TASK, me + 1)
    ss(state, S_CP_PID, sched.tget(state, me, sched.T_PID))
    ss(state, S_CP_MISS, 0)
    ss(state, S_CP_NATT, gs(state, S_CP_NATT) + 1)
    cp_sync(state)
    cp_unlock(state)
    // a first complete frame for the new compositor to show
    damage_all(state)
    return 0
}

fn cp_detach(state: u64, me: u64) -> u64 {
    if gs(state, S_CP_TASK) != me + 1 {
        return CP_NOT
    }
    if !cp_lock(state) {
        return CP_BUSY
    }
    cp_detach_locked(state, 3)
    cp_unlock(state)
    return 0
}

// WM_COMP / CP_PRESENT: show what waits. Returns the pixels (0 = nothing waited).
fn cp_present(state: u64, me: u64) -> u64 {
    if gs(state, S_CP_TASK) != me + 1 {
        return CP_NOT
    }
    if !cp_lock(state) {
        return CP_BUSY
    }
    var px: u64 = 0
    if gs(state, S_CP_TASK) == me + 1 {
        px = cp_flush_locked(state, true)
        if px != 0 {
            ss(state, S_CP_MISS, 0)
        }
    }
    cp_unlock(state)
    return px
}

// WM_COMP / CP_WAIT: sleep until a frame newer than `seen` was handed over, for at most `ms`. Returns the number of the newest frame.
// The wake-up is the one `poll` uses: the sequence is read BEFORE the look, `poll_sleep` sleeps only if it has not moved.
fn cp_wait(state: u64, me: u64, seen: u64, ms: u64) -> u64 {
    if gs(state, S_CP_TASK) != me + 1 {
        return CP_NOT
    }
    let ps: u64 = sched.poll_seq(state)
    if gs(state, S_CP_FSEQ) != seen {
        return gs(state, S_CP_FSEQ)
    }
    sched.poll_sleep(state, ps, kstate.get(state, kstate.TICKS) + ms / 10 + 1)
    return gs(state, S_CP_FSEQ)
}

// the input copy: see the header. `a`, `b`, `c` as in the page description.
fn cp_event(state: u64, typ: u64, mods: u64, btn: u64, x: u64, y: u64, code: u64) {
    let f: u64 = gs(state, S_CP_PAGEF)
    if f == 0 || gs(state, S_CP_TASK) == 0 {
        return
    }
    if sperre_an(state) || td_live(state) {
        ss(state, S_CP_EVREF, gs(state, S_CP_EVREF) + 1)
        return
    }
    let h: u64 = gs(state, S_CP_HEAD)
    let at: u64 = CP_RING_AT + (h % CP_RING) * 4
    tw(f, at + 1, x | (y << 32))
    tw(f, at + 2, code)
    tw(f, at + 3, time.tsc())
    tw(f, at, typ | (mods << 8) | (btn << 16) | ((h + 1) << 32))
    ss(state, S_CP_HEAD, h + 1)
    arch.atomic_store(f + 16, h + 1)
}

// the modifiers that make a key a shortcut (Alt or the Windows key): 1 = shortcut
fn cp_shortcut(state: u64) -> u64 {
    if kstate.get(state, kstate.K11_OFF + kstate.KB_OLD) != 0 || kstate.get(state, kstate.K11_OFF + kstate.KB_SUPER) != 0 {
        return 1
    }
    return 0
}

fn cp_stat(state: u64, k: u64) -> u64 {
    if k == 0 {
        return gs(state, S_CP_NATT)
    }
    if k == 1 {
        return gs(state, S_CP_NDET)
    }
    if k == 2 {
        return gs(state, S_CP_NMISS)
    }
    if k == 3 {
        return gs(state, S_CP_NPRES)
    }
    if k == 4 {
        return gs(state, S_CP_NKP)
    }
    if k == 5 {
        return gs(state, S_CP_NHAND)
    }
    if k == 6 {
        return gs(state, S_CP_HEAD)
    }
    if k == 7 {
        return gs(state, S_CP_EVREF)
    }
    return 0
}

// F12: one line, only when a compositor ever attached or the word `phases` is on (the input-to-picture clock of the kernel path is wanted there).
fn cp_say_reset(state: u64) {
    if gs(state, S_CP_NATT) == 0 && !fb.phases_an(state) {
        return
    }
    var s_c0: [u8; 13] = "wm: comp on=\0"
    var s_c1: [u8; 6] = " att=\0"
    var s_c2: [u8; 6] = " det=\0"
    var s_c3: [u8; 7] = " miss=\0"
    var s_c4: [u8; 7] = " hand=\0"
    var s_c5: [u8; 7] = " pres=\0"
    var s_c6: [u8; 8] = " kpres=\0"
    var s_c7: [u8; 5] = " ev=\0"
    var s_c8: [u8; 8] = " evref=\0"
    var s_h0: [u8; 7] = " hopn=\0"
    var s_h1: [u8; 9] = " hopavg=\0"
    var s_h2: [u8; 9] = " hopmax=\0"
    var s_w0: [u8; 8] = " wlatn=\0"
    var s_w1: [u8; 10] = " wlatavg=\0"
    var s_w2: [u8; 10] = " wlatmax=\0"
    var s_k0: [u8; 8] = " klatn=\0"
    var s_k1: [u8; 10] = " klatavg=\0"
    var s_k2: [u8; 10] = " klatmax=\0"
    serial.puts((&s_c0[0]) as u64)
    if cp_on(state) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_c1[0]) as u64)
    serial.dec(gs(state, S_CP_NATT))
    serial.puts((&s_c2[0]) as u64)
    serial.dec(gs(state, S_CP_NDET))
    serial.puts((&s_c3[0]) as u64)
    serial.dec(gs(state, S_CP_NMISS))
    serial.puts((&s_c4[0]) as u64)
    serial.dec(gs(state, S_CP_NHAND))
    serial.puts((&s_c5[0]) as u64)
    serial.dec(gs(state, S_CP_NPRES))
    serial.puts((&s_c6[0]) as u64)
    serial.dec(gs(state, S_CP_NKP))
    serial.puts((&s_c7[0]) as u64)
    serial.dec(gs(state, S_CP_HEAD))
    serial.puts((&s_c8[0]) as u64)
    serial.dec(gs(state, S_CP_EVREF))
    var n: u64 = gs(state, S_CP_HOP)
    serial.puts((&s_h0[0]) as u64)
    serial.dec(n)
    serial.puts((&s_h1[0]) as u64)
    if n != 0 {
        serial.dec(gs(state, S_CP_HOP + 8) / n)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_h2[0]) as u64)
    serial.dec(gs(state, S_CP_HOP + 16))
    n = gs(state, S_CP_WLAT)
    serial.puts((&s_w0[0]) as u64)
    serial.dec(n)
    serial.puts((&s_w1[0]) as u64)
    if n != 0 {
        serial.dec(gs(state, S_CP_WLAT + 8) / n)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_w2[0]) as u64)
    serial.dec(gs(state, S_CP_WLAT + 16))
    n = gs(state, S_CP_KLAT)
    serial.puts((&s_k0[0]) as u64)
    serial.dec(n)
    serial.puts((&s_k1[0]) as u64)
    if n != 0 {
        serial.dec(gs(state, S_CP_KLAT + 8) / n)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_k2[0]) as u64)
    serial.dec(gs(state, S_CP_KLAT + 16))
    serial.nl()
    // the clocks start again for the next phase; the totals above (att, det, miss, hand, pres, kpres, ev) are running
    var z: u64 = 0
    while z < 3 {
        ss(state, S_CP_HOP + z * 8, 0)
        ss(state, S_CP_WLAT + z * 8, 0)
        ss(state, S_CP_KLAT + z * 8, 0)
        z = z + 1
    }
}

fn flush_win(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    // vboxlag: a HIDDEN (minimized / popup-not-shown) window is not composed, so its repaint changes nothing on the screen. Before this,
    // the hidden tray / calendar / mini windows made the whole window rectangle dirty about five times a second at idle
    // (1.3 MB per frame to the card). Showing a window damages it anyway (`show_win`), so nothing is lost; `nohidskip` is the counter-proof.
    if win_hidden(state, i) && !fb.nohidskip_an(state) {
        return
    }
    // the client painted new contents: its own blur (made from what is under it) is still good
    damage_win_ex(state, i, i + 1)
}

// ------------------------------------------------- das Zusammensetzen

// Der Zeiger. Achtzehn Zeilen zu zwoelf Bildpunkten, als zwei
// Bitmasken je Zeile: Umriss und Fuellung. Warum von Hand und nicht als
// Bilddatei: es sind 72 Oktette, und ein Zeiger, der aus einer Datei
// kommt, fehlt genau dann, wenn man ihn zum Suchen des Fehlers braucht.
const CUR_W: u64 = 12
const CUR_H: u64 = 18

// RUNDE HIDPUNKTE: DER ZEIGER IST EIN PFEIL -- ER WAR NUR ZU KLEIN,
// UM EINER ZU SEIN.
//
// Die Bitmaske stimmt; aus einem echten Bildschirmfoto (3440x1440)
// herausgeschnitten ist ein sauberer Pfeil mit durchgehendem Schwanz
// und umlaufendem Rand zu sehen -- er ist dort acht mal fuenfzehn
// Bildpunkte gross. Auf einem 34-Zoll-Ultrawide ist das ein Fleck, und
// genau als "einzelner weisser Fleck" hat Justin ihn beschrieben.
//
// Titelleiste, Rand und Schriftgroesse wachsen seit Runde SCHIRM mit
// `uisc(state)`; der Zeiger war das einzige Stueck Oberflaeche, das es
// nicht tat. Jetzt wird jeder Bildpunkt der Maske zu einem Block von
// `uisc` mal `uisc` -- auf 1280x800 (uisc=1) aendert sich damit KEIN
// einziges Bildpunkt, und das ist die Gegenprobe.
// ============================================ RUNDE ECHTHARDWARE-4
// DIE GROESSE KOMMT AUS `zeiger.fi`, UND SIE IST QUADRATISCH.
//
// Bis hierher war der Zeiger 12 mal 18 Bildpunkte mal Vervielfachung.
// Die neun Formen (Pfeil, Textmarke, Hand, zwei Balken, zwei
// Diagonalen, Kreuz, Sanduhr) passen nicht alle in ein hohes Rechteck
// -- der Doppelpfeil ist breiter als hoch --, also ist das Feld
// quadratisch: 24 Bildpunkte bei Vervielfachung 1, 48 bei 2. Justins
// Vorgabe war "rund 24 bei 1, 48 bei 2", und das ist sie.
fn cur_w(state: u64) -> u64 {
    return cursor.size(uisc(state))
}

fn cur_h(state: u64) -> u64 {
    return cursor.size(uisc(state))
}

// DER GRIFFPUNKT. Die Mausposition ist die SPITZE des Pfeils und die
// MITTE der Textmarke -- ein Zeiger, dessen Griff immer in der linken
// oberen Ecke laege, klickte bei jeder anderen Form daneben. Diese
// beiden Zahlen sagen, um wieviel das Bild gegen die Position versetzt
// gemalt wird, und die Schadensrechnung nimmt dieselben.
fn cur_ox(state: u64) -> u64 {
    return cursor.griff_x(gs(state, S_SHAPE), cur_w(state))
}

fn cur_oy(state: u64) -> u64 {
    return cursor.griff_y(gs(state, S_SHAPE), cur_h(state))
}

fn cursor_row(r: u64, fuell: bool) -> u64 {
    return cursor_row_of(0, r, fuell)
}

// RUNDE K15: ZWEI ZEIGERBILDER STATT EINEM. Der Balken ist mechanisch
// aus dem Pfeil-Verfahren entstanden und nicht von Hand gemalt: die
// Fuellung ist der Balken, der Umriss ist die Fuellung um einen
// Bildpunkt geweitet. Damit ist er ueber JEDEM Untergrund zu sehen --
// derselbe Grund, aus dem der Pfeil einen schwarzen Rand hat.
fn cursor_row_of(form: u64, r: u64, fuell: bool) -> u64 {
    // Bit 11 ist links.
    // ================================= RUNDE BLECH-HID: DER PFEIL WAR KEINER.
    //
    // Justin hat den Zeiger auf echtem Blech fotografiert und
    // vergroessert: ein weisses Dreieck, darunter eine LUECKE, darunter
    // zwei getrennte weisse Stummel. Das war kein Rasterfehler und
    // nichts, was die Maschine getan hat -- es stand so in diesen zwei
    // Zeilen:
    //
    //   innen[11] = 0x0400   EIN einziger gesetzter Bildpunkt; genau
    //                        unter der breitesten Zeile (0x07fc) reisst
    //                        der Pfeil damit ab.
    //   innen[12..16] = 0x0370, 0x01b0, 0x01b0, 0x00d8, 0x00d8
    //                        je ZWEI getrennte Bloecke, und der Umriss
    //                        hat die Luecke dazwischen auch noch
    //                        umrandet (0x0c88).
    //
    // Gemeint war der klassische X11-Zeiger, dessen Schwanz sich in zwei
    // Beine gabelt. Von Hand in Hexadezimalzahlen geschrieben sieht das
    // aus wie ein Pfeil; auf dem Schirm sieht es aus wie Bruchstuecke.
    //
    // DER NEUE PFEIL IST NICHT VON HAND GERECHNET. In
    // `tools/wm/zeiger.py` steht eine Silhouette -- je Zeile GENAU EIN
    // Bereich --, und die Fuellung ist ihre EROSION um einen Bildpunkt
    // in den vier Richtungen; was uebrigbleibt, ist der Rand und ist
    // damit ueberall genau einen Bildpunkt breit. Derselbe Laeufer liest
    // diese zwei Masken zurueck, malt sie als ASCII-Bild und rechnet
    // sechs Zusagen nach: eine zusammenhaengende Flaeche, jeder
    // Fuellpunkt rundherum gedeckt, keine Zeile mit zwei Bloecken, kein
    // allein stehender Punkt, keine Ueberschneidung, und die Spitze auf
    // dem Griffpunkt (0,0).
    //
    //    0 |.           |     10 |.#######..  |
    //    1 |..          |     11 |.######.    |
    //    2 |.#.         |     12 | .#####.    |
    //    3 |.##.        |     13 |  .####.    |
    //    4 |.###.       |     14 |   .###.    |
    //    5 |.####.      |     15 |   .###.    |
    //    6 |.#####.     |     16 |   .###.    |
    //    7 |.######.    |     17 |   .....    |
    //    8 |.#######.   |
    //    9 |.########.  |
    var umriss: [u8; 37] = b"\x08\x00\x0c\x00\x0a\x00\x09\x00\x08\x80\x08\x40\x08\x20\x08\x10\x08\x08\x08\x04\x08\x0c\x08\x10\x04\x10\x02\x10\x01\x10\x01\x10\x01\x10\x01\xf0\x00"
    var innen: [u8; 37] = b"\x00\x00\x00\x00\x04\x00\x06\x00\x07\x00\x07\x80\x07\xc0\x07\xe0\x07\xf0\x07\xf8\x07\xf0\x07\xe0\x03\xe0\x01\xe0\x00\xe0\x00\xe0\x00\xe0\x00\x00\x00"
    var bumriss: [u8; 37] = b"\x03\xfc\x03\xfc\x03\xfc\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x03\xfc\x03\xfc\x03\xfc\x00"
    var binnen: [u8; 37] = b"\x00\x00\x01\xf8\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x01\xf8\x00\x00\x00"
    if r >= CUR_H {
        return 0
    }
    var p: u64 = 0
    if form == 1 {
        if fuell {
            p = (&binnen[0]) as u64 + r * 2
        } else {
            p = (&bumriss[0]) as u64 + r * 2
        }
    } else {
        if fuell {
            p = (&innen[0]) as u64 + r * 2
        } else {
            p = (&umriss[0]) as u64 + r * 2
        }
    }
    return (kstate.get8(p) << 8) | kstate.get8(p + 1)
}

fn shape(state: u64) -> u64 {
    return gs(state, S_SHAPE)
}

// DIESELBE UMSCHALTUNG, ABER OHNE DEN WUNSCH DER ANWENDUNG ZU
// UEBERSCHREIBEN. Nur der Server ruft das -- fuer die Raender.
fn shape_intern(state: u64, s: u64) {
    if s >= cursor.FORMEN || !ready(state) {
        return
    }
    if gs(state, S_SHAPE) == s {
        return
    }
    ss(state, S_SHAPE, s)
    // DELL ROUND: the shape change on the wire (a runner reads it).
    let mx: i64 = gs(state, S_CURX) as i64
    let my: i64 = gs(state, S_CURY) as i64
    var s_fm: [u8; 11] = "wm: form=\0\0"
    var s_fx: [u8; 4] = " x=\0"
    var s_fy: [u8; 4] = " y=\0"
    serial.puts((&s_fm[0]) as u64)
    serial.dec(s)
    serial.puts((&s_fx[0]) as u64)
    serial.dec(mx as u64)
    serial.puts((&s_fy[0]) as u64)
    serial.dec(my as u64)
    serial.nl()
    let gw: i64 = cur_w(state) as i64
    damage(state, mx - gw, my - gw, mx + gw, my + gw)
}

// ============================================ RUNDE ECHTHARDWARE-4
// DER ZEIGER SAGT, WAS DER RAND KANN.
//
// Seit ECHTHARDWARE-3 ist der GANZE rechte und untere Rand eines
// Fensters ein Griff zum Groessenaendern (vorher waren es zwoelf
// Bildpunkte in einer Ecke). Ein Griff, den man nicht SIEHT, ist
// trotzdem einer, den man nicht findet -- deshalb wechselt der Zeiger
// dort jetzt die Form, genau wie bei jedem anderen System:
//
//   rechte Kante        Doppelpfeil waagrecht
//   untere Kante        Doppelpfeil senkrecht
//   die Ecke dazwischen Doppelpfeil diagonal NW-SO
//   sonst               was die Anwendung wollte
//
// Waehrend gezogen oder in der Groesse geaendert wird, bleibt die Form
// stehen: der Zeiger laeuft dabei aus dem Randstreifen heraus, und ein
// Zeiger, der mitten im Ziehen die Form wechselt, flackert.
fn margin_cursor(state: u64, i: u64, x: i64, y: i64) {
    // W-CURSOR counter-proof `noshapes`: an arrow over everything.
    if fb.noshapes_an(state) {
        shape_intern(state, cursor.F_PFEIL)
        return
    }
    if gs(state, S_SIZING) != 0 {
        return
    }
    if gs(state, S_DRAG) != 0 {
        // a window is carried by its title bar: the move cross
        shape_intern(state, cursor.F_CROSS)
        return
    }
    if dnd_forbidden(state, i) { // W-DND: nobody takes a drop here
        shape_intern(state, cursor.F_NO)
        return
    }
    if dh_live != 0 { // W-DND: Ctrl = copy (plus), otherwise move (drop arrow)
        if (mods_of(state) & M_CTRL) != 0 {
            shape_intern(state, cursor.F_COPY)
        } else {
            shape_intern(state, cursor.F_MOVE)
        }
        return
    }
    var will: u64 = cursor.F_PFEIL
    if i < MAX_WIN && valid(state, i) {
        // the wish of the program counts over the CLIENT area only; the
        // frame and the title bar are the server's and show the arrow.
        let cx: i64 = x - win_x(state, i) - inx(state, i) as i64
        let cy: i64 = y - win_y(state, i) - iny(state, i) as i64
        if cx >= 0 && cy >= 0 && cx < wg(state, i, W_W) as i64
            && cy < wg(state, i, W_H) as i64 {
            if wg(state, i, W_KIND) == K_TERM {
                // the terminal grid is text
                will = cursor.F_TEXT
            } else {
                will = wg(state, i, W_CURSOR)
                if will >= cursor.FORMEN {
                    will = cursor.F_PFEIL
                }
            }
        }
    }
    if i < MAX_WIN && valid(state, i) && deko(state, i) {
        let lx: i64 = x - win_x(state, i) - inx(state, i) as i64
        let ly: i64 = y - win_y(state, i) - iny(state, i) as i64
        let k: u64 = grip_mask(state, i, lx, ly)
        var l: bool = (k & SZ_L) != 0
        let r: bool = (k & SZ_R) != 0
        var t: bool = (k & SZ_T) != 0
        var b: bool = (k & SZ_B) != 0
        // counter-proof `nowinfix`: the old cursor knew right and bottom only
        if fb.winfix_aus(state) {
            l = false
            t = false
        }
        // DELL ROUND: all eight directions. Before, only right, bottom
        // and the corner between them had a cursor.
        if (l && t) || (r && b) {
            will = cursor.F_DIAG1
        } else if (r && t) || (l && b) {
            will = cursor.F_DIAG2
        } else if l || r {
            will = cursor.F_WIDTH
        } else if t || b {
            will = cursor.F_HEIGHT
        }
    }
    shape_intern(state, will)
}

// The edges a point (window-local to the work area) is on: the SAME test
// the press uses, so the cursor shows exactly where a drag would resize.
fn grip_mask(state: u64, i: u64, lokal_x: i64, lokal_y: i64) -> u64 {
    // a maximised window has no grips (it fills the work area)
    if (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0 && !fb.winfix_aus(state) {
        return 0
    }
    let rand: i64 = grip(state) as i64
    let iw: i64 = wg(state, i, W_W) as i64
    let ih: i64 = wg(state, i, W_H) as i64
    let oben: i64 = 0 - iny(state, i) as i64
    var kanten: u64 = 0
    if lokal_x > 0 - rand && lokal_x < rand {
        kanten = kanten | SZ_L
    }
    if lokal_x >= iw - rand && lokal_x < iw + rand {
        kanten = kanten | SZ_R
    }
    if lokal_y >= oben && lokal_y < oben + grip_oben(state) as i64 {
        kanten = kanten | SZ_T
    }
    if lokal_y >= ih - rand && lokal_y < ih + rand {
        kanten = kanten | SZ_B
    }
    let im_rahmen: bool = lokal_x > 0 - rand
        && lokal_y >= oben
        && lokal_x < iw + rand && lokal_y < ih + rand
    if !im_rahmen {
        return 0
    }
    return kanten
}

// Das Bild wechseln und die STELLE schmutzig machen, an der der Zeiger
// gerade steht -- sonst steht das alte Bild dort, bis sich die Maus
// bewegt.
fn set_shape(state: u64, s: u64) {
    if s >= cursor.FORMEN || !ready(state) {
        return
    }
    ss(state, S_SHAPE_APP, s)
    // W-CURSOR: the wish belongs to the window under the pointer (the
    // program answers a move event of exactly that window) and is
    // remembered there. The shape shown follows from the window and the
    // spot (`margin_cursor`), so leaving the window drops the wish at once
    // and returning needs no new call.
    let mx: i64 = gs(state, S_CURX) as i64
    let my: i64 = gs(state, S_CURY) as i64
    var i: u64 = hit(state, mx, my)
    if i < MAX_WIN && valid(state, i) {
        wsv(state, i, W_CURSOR, s)
        if !darf(state, i) {
            i = MAX_WIN
        }
    }
    margin_cursor(state, i, mx, my)
}

// ================== RUNDE VSYNC: BEWEGUNG, BILDGRENZE, SIGNATUR

// Die zugesagte Dauer einer Fensterbewegung. Steht keine Formmarke da,
// gilt MO_FAST -- dieselben 120 ms, die wlib seit DESIGN-2 fuer Hover
// und Menue nimmt. Die Zahl steht hier EINMAL; wer sie aendern will,
// aendert die Formmarke und nicht den Quelltext.
fn motion_ms(state: u64) -> u64 {
    if gs(state, S_FORM + FM_MOTION * 8) == 0 {
        return MOTION_DEF
    }
    return form(state, FM_MOTION)
}

// Sind Bewegungen abgeschaltet? Zwei Wege fuehren dahin, und sie
// bedeuten dasselbe: die Formmarke sagt 0 (das ist "Animationen
// reduzieren"), oder die Gegenprobe `noanim` steht auf der
// Befehlszeile. In beiden Faellen ist eine Bewegung SOFORT FERTIG.
fn anim_off(state: u64) -> bool {
    return gs(state, S_NOANIM) != 0 || motion_ms(state) == 0
}

// ease-out, ganzzahlig: 1-(1-t)^2 in Tausendsteln. Dieselbe Kurve wie
// `wlib.ease(EASE_OUT)` -- absichtlich, damit ein Fenster, das
// aufgeht, und ein Knopf, der hell wird, sich gleich anfuehlen.
// Keine Fliesskommazahl: der Kernel rettet in `syscall` kein SSE.
fn ease_out(t: u64) -> u64 {
    var pp: u64 = t
    if pp > 1000 {
        pp = 1000
    }
    let inv: u64 = 1000 - pp
    return 1000 - inv * inv / 1000
}

// Der Fortschritt einer laufenden Bewegung, 0..1000. Er faellt aus der
// VERGANGENEN ZEIT und nicht aus der Zahl der Bilder: bei TICK_HZ=100
// ist ein Tick 10 ms, und eine Zusage von 120 ms sind zwoelf Ticks --
// aber wenn der Server einmal langsamer ist, springt die Bewegung
// weiter, statt sich zu dehnen.
fn anim_p(state: u64, i: u64) -> u64 {
    let ms: u64 = wg(state, i, W_ANMS)
    if ms == 0 {
        return 1000
    }
    // r1135: wall clock (monotonic ms), not ticks. A slow guest loses
    // ticks; the motion must still end after its promised duration.
    let jetzt: u64 = time.mono_ns(state) / 1000000
    let ab: u64 = wg(state, i, W_AN0)
    if jetzt <= ab {
        return 0
    }
    let vergangen: u64 = jetzt - ab
    if vergangen >= ms {
        return 1000
    }
    return vergangen * 1000 / ms
}

// Eine Bewegung anmelden. `art` ist AN_OPEN, AN_CLOSE oder AN_MIN.
// Ist sie abgeschaltet, wird NICHTS angemeldet -- der Aufrufer sieht
// `false` und macht seinen Endzustand sofort.
fn anim_start(state: u64, i: u64, art: u64) -> bool {
    if !valid(state, i) || anim_off(state) {
        return false
    }
    wsv(state, i, W_ANK, art)
    wsv(state, i, W_AN0, time.mono_ns(state) / 1000000)
    wsv(state, i, W_ANMS, motion_ms(state))
    wsv(state, i, W_ANP, 0)
    ss(state, S_ANIMS, gs(state, S_ANIMS) + 1)
    damage_win(state, i)
    return true
}

fn anim_laeuft(state: u64, i: u64) -> bool {
    return valid(state, i) && wg(state, i, W_ANK) != 0
}

fn anims(state: u64) -> u64 {
    return gs(state, S_ANIMS)
}

fn anim_frames(state: u64) -> u64 {
    return gs(state, S_ANFRAMES)
}

fn anim_ticks(state: u64) -> u64 {
    return gs(state, S_TICKS)
}

// RUNDE ZIEH: die beiden Zahlen des Aufhebens.
fn swings(state: u64) -> u64 {
    return gs(state, S_SWINGS)
}

fn drag_px(state: u64) -> u64 {
    return gs(state, S_DRAGPX)
}

// RUNDE ZIEH: die Bildzeit, NUR fuer Bilder mit aufgehobenem Fenster.
fn zieh_frn(state: u64) -> u64 {
    return gs(state, S_ZFRN)
}

fn zieh_frus(state: u64) -> u64 {
    return gs(state, S_ZFRUS)
}

fn zieh_frmax(state: u64) -> u64 {
    return gs(state, S_ZFRMAX)
}

fn zieh_frueber(state: u64) -> u64 {
    return gs(state, S_ZFRUE)
}

// Die Grundlast: Bilder desselben Laufs OHNE aufgehobenes Fenster.
fn ohne_frn(state: u64) -> u64 {
    return gs(state, S_OFRN)
}

fn ohne_frus(state: u64) -> u64 {
    return gs(state, S_OFRUS)
}

fn ohne_frmax(state: u64) -> u64 {
    return gs(state, S_OFRMAX)
}

fn set_noanim(state: u64, on: bool) {
    ss(state, S_NOANIM, 0)
    if on {
        ss(state, S_NOANIM, 1)
    }
}

// Der Fortschritt, den `paint_win` gerade sehen soll -- schon durch die
// Kurve gelaufen. Beim Schliessen und Minimieren laeuft er rueckwaerts:
// dieselbe Kurve, gespiegelt, statt einer zweiten.
fn anim_mix(state: u64, i: u64) -> u64 {
    let art: u64 = wg(state, i, W_ANK)
    if art == 0 {
        return 1000
    }
    let e: u64 = ease_out(anim_p(state, i))
    if art == AN_OPEN {
        return e
    }
    return 1000 - e
}

// EIN TICK DER BEWEGUNGEN, und er gehoert in den Zeitgeber und nicht
// ins Zeichnen. Er macht drei Dinge: abgelaufene Bewegungen beenden,
// laufende schmutzig machen (sonst zeichnet `compose` sie nicht), und
// beim Ende einer Schliessbewegung das Fenster WIRKLICH wegnehmen.
// Gibt zurueck, wie viele Bewegungen noch laufen.
fn anim_tick(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    ss(state, S_TICKS, gs(state, S_TICKS) + 1)
    var offen: u64 = 0
    var i: u64 = 0
    while i < MAX_WIN {
        if valid(state, i) && wg(state, i, W_ANK) != 0 {
            let p: u64 = anim_p(state, i)
            let art: u64 = wg(state, i, W_ANK)
            // Der Bereich wird IMMER schmutzig, auch wenn der
            // Fortschritt gleich blieb -- am Ende der Bewegung steht
            // sonst das letzte Zwischenbild auf dem Schirm.
            // r461: a window that opens or closes cannot spoil the blur of the windows below it
            damage_win_ex(state, i, i + 1)
            if p >= 1000 {
                wsv(state, i, W_ANK, 0)
                wsv(state, i, W_ANP, 1000)
                // DAS FENSTER GEHT ERST JETZT. Waere es beim Klick
                // verschwunden, haette die Bewegung nichts mehr zu
                // zeigen gehabt -- das ist der ganze Grund, warum
                // Schliessen ueber diesen Umweg laeuft.
                if art == AN_CLOSE {
                    destroy(state, i)
                } else {
                    if art == AN_MIN {
                        set_hidden(state, i, true)
                    }
                }
            } else {
                wsv(state, i, W_ANP, p)
                ss(state, S_ANFRAMES, gs(state, S_ANFRAMES) + 1)
                offen = offen + 1
            }
        }
        i = i + 1
    }
    return offen
}

// ---------------------------------------------------- DIE BILDGRENZE

fn set_vsync(state: u64, on: bool) {
    ss(state, S_VSYNC, 0)
    if on {
        ss(state, S_VSYNC, 1)
    }
}

fn vsync_on(state: u64) -> bool {
    return gs(state, S_VSYNC) != 0
}

fn pxsum(state: u64) -> u64 {
    return gs(state, S_PXSUM)
}

fn presents(state: u64) -> u64 {
    return gs(state, S_PRESENTS)
}

fn skipped(state: u64) -> u64 {
    return gs(state, S_SKIPPED)
}

fn pending(state: u64) -> bool {
    return gs(state, S_PEND) != 0
}

// Das gezeichnete Rechteck vormerken, statt es zu uebertragen. Mehrere
// `compose`-Laeufe zwischen zwei Ticks wachsen so zu EINEM Rechteck
// zusammen, und der Schirm sieht sie zusammen oder gar nicht.
fn pend_add(state: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if gs(state, S_PEND) == 0 {
        ss(state, S_PX0, x0)
        ss(state, S_PY0, y0)
        ss(state, S_PX1, x1)
        ss(state, S_PY1, y1)
        ss(state, S_PEND, 1)
        return
    }
    if x0 < gs(state, S_PX0) {
        ss(state, S_PX0, x0)
    }
    if y0 < gs(state, S_PY0) {
        ss(state, S_PY0, y0)
    }
    if x1 > gs(state, S_PX1) {
        ss(state, S_PX1, x1)
    }
    if y1 > gs(state, S_PY1) {
        ss(state, S_PY1, y1)
    }
}

// DAS BILD ZEIGEN. Eine Uebertragung, ein Rechteck -- und der Zaehler
// steigt nur, wenn wirklich etwas anlag. Wer das im Takt ruft, hat
// genau die Bildgrenze, die vorher fehlte.
fn present(state: u64) -> u64 {
    if !ready(state) || !fb.ready(state) {
        return 0
    }
    if gs(state, S_PEND) == 0 {
        return 0
    }
    let x0: u64 = gs(state, S_PX0)
    let y0: u64 = gs(state, S_PY0)
    let x1: u64 = gs(state, S_PX1)
    let y1: u64 = gs(state, S_PY1)
    ss(state, S_PEND, 0)
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    // COMPOSITOR S5: with a compositor the rectangle is handed over, the compositor shows it
    if cp_on(state) && cp_lock(state) {
        cp_hand(state, x0, y0, x1, y1)
        cp_kick(state)
        cp_unlock(state)
        return (x1 - x0) * (y1 - y0)
    }
    // `flush_rect` statt `flush`: nur die Spalten, die wirklich
    // schmutzig waren. `flush` haette die ganze Bildbreite genommen,
    // weil es nur Zeilen kennt.
    // MIT SEITENUMSCHALTUNG MUSS DIE GANZE SEITE STIMMEN, nicht nur
    // das schmutzige Rechteck: gezeigt wird gleich die ANDERE Haelfte,
    // und in der steht das vorletzte Bild. Was seitdem woanders
    // gemalt wurde, fehlte dort. Also die volle Flaeche kopieren --
    // sie ist unsichtbar, solange nicht umgeschaltet ist, und der
    // Preis dafuer steht in docs/VSYNC.md.
    if fb.flip_on(state) {
        fb.flush_rect(state, 0, 0, gs(state, S_SW), gs(state, S_SH))
        fb.flip(state)
    } else {
        beam.wait(state, x0, y0, x1 - x0, y1 - y0)
        fb.flush_rect(state, x0, y0, x1 - x0, y1 - y0)
    }
    ss(state, S_PRESENTS, gs(state, S_PRESENTS) + 1)
    // RUNDE VIRTIOGPU: DIE BILDGRENZE IST HIER UND SONST NIRGENDS.
    // `flushes` zaehlt Uebertragungen, und davon gibt es mehrere je
    // Bild. Wer "Oktette je Bild" ausrechnen will, braucht die Zahl
    // der BILDER -- und ein Bild ist genau ein Durchlauf hier.
    fb.frame_done(state)
    let flaeche: u64 = (x1 - x0) * (y1 - y0)
    ss(state, S_PXSUM, gs(state, S_PXSUM) +% flaeche)
    return flaeche
}

// ------------------------------------------- DER ABLESER (SCANOUT)
//
// WARUM ES DIESEN ABLESER GEBEN MUSS, UND WARUM ER IM KERNEL SITZT.
//
// Die erste Fassung der Zerreissprobe hat von aussen fotografiert und
// die Signaturen im Bild verglichen. Sie fand NIE ein zerrissenes Bild
// -- auch dann nicht, wenn die Bildgrenze ausdruecklich abgeschaltet
// war (`nopresent`) und es also reissen MUSSTE. Der Grund liegt in
// QEMU: `screendump` liest die Bildflaeche in EINEM Zug, waehrend
// niemand schreibt. Ein halb uebertragenes Bild ist darin nicht zu
// sehen. Eine Messung, die auch bei abgeschalteter Zusage gruen
// bleibt, misst nichts -- also war sie zu verwerfen.
//
// Der Ableser stellt dieselbe Frage an der Stelle, an der sie
// beantwortbar ist: er liest den VORDERPUFFER (die Karte), oben und
// unten, GENAU SO, wie ein Bildschirm ihn ausliest -- und er tut es
// waehrend der Server malt. Findet er oben und unten verschiedene
// Signaturen, hat er ein halbes Bild in der Hand.
//
// Das ist keine Nachbildung des Reissens, sondern das Reissen selbst:
// ein Bildschirm, der in diesem Augenblick abgelesen haette, haette
// dasselbe gesehen.
fn set_leser(state: u64, on: bool) {
    ss(state, S_LESER, 0)
    if on {
        ss(state, S_LESER, 1)
    }
}

fn liest(state: u64) -> u64 {
    return gs(state, S_LIEST)
}

fn risse(state: u64) -> u64 {
    return gs(state, S_RISS)
}

fn tear_top(state: u64) -> u64 {
    return gs(state, S_R0)
}

fn tear_bottom(state: u64) -> u64 {
    return gs(state, S_R1)
}

fn without_sig(state: u64) -> u64 {
    return gs(state, S_KEIN)
}

fn riss_y0(state: u64) -> u64 {
    return gs(state, S_RY0)
}

fn riss_y1(state: u64) -> u64 {
    return gs(state, S_RY1)
}

fn riss_frame(state: u64) -> u64 {
    return gs(state, S_RFR)
}

// Wie viele Ablesungen verworfen wurden, weil zwischen ihren beiden
// Punkten umgeschaltet wurde. Sie sind KEIN Riss -- die Zahl steht
// daneben, damit man sieht, wie oft es vorkam.
fn verworfen(state: u64) -> u64 {
    return gs(state, S_VERWORF)
}

// Die drei Zahlen der Vorfuehrung, von `kgui` gelesen und gesetzt.
fn before_t0(state: u64) -> u64 {
    return gs(state, S_VT0)
}

fn set_before_t0(state: u64, v: u64) {
    ss(state, S_VT0, v)
}

fn before_step(state: u64) -> u64 {
    return gs(state, S_VSTEP)
}

fn set_before_step(state: u64, v: u64) {
    ss(state, S_VSTEP, v)
}

fn before_win(state: u64) -> u64 {
    return gs(state, S_VWIN)
}

fn set_before_win(state: u64, v: u64) {
    ss(state, S_VWIN, v)
}

// Welche Farbnummer steht an dieser Stelle? MAX_SIG heisst "keine der
// acht" -- dort steht dann Fensterinhalt oder Hintergrund, und das ist
// kein Widerspruch, sondern nur nichts zu vergleichen.
fn sig_nr(c: u64) -> u64 {
    var k: u64 = 0
    while k < 8 {
        if sig_colour(k) == (c & RGB24) {
            return k
        }
        k = k + 1
    }
    return 8
}

// EINMAL ABLESEN. Er nimmt das oberste sichtbare Fenster, liest dessen
// oberen und unteren Signaturstreifen aus dem VORDERPUFFER und
// vergleicht. Der Aufrufer ruft das dicht -- je dichter, desto eher
// erwischt er die Uebertragung mitten im Lauf.
fn leser_tick(state: u64) {
    if gs(state, S_LESER) == 0 || gs(state, S_SIG) == 0 {
        return
    }
    let i: u64 = top_visible(state)
    if i >= MAX_WIN {
        return
    }
    // NUR AN EINEM FENSTER, DAS SICH GERADE NICHT BEWEGT UND NICHT
    // AUFGEHT. Waehrend einer Oeffnungsbewegung wird die Flaeche
    // skaliert und gemischt gemalt -- die Signaturstreifen liegen dann
    // nicht dort, wo dieser Ableser sie aus `win_x`/`win_y` errechnet,
    // und was er findet, ist wieder eine Aussage ueber die Messung.
    // Dasselbe gilt fuer ein gezogenes Fenster.
    if wg(state, i, W_ANK) != 0 || gs(state, S_DRAG) != 0 {
        return
    }
    let wx: i64 = win_x(state, i)
    let wy: i64 = win_y(state, i)
    let ow: i64 = outer_w(state, i) as i64
    let oh: i64 = outer_h(state, i) as i64
    if ow <= 0 || oh < 2 * SIG_H as i64 || wx < 0 || wy < 0 {
        return
    }
    // DIE STELLE WIRD AUS EINER EINZIGEN ABLESUNG DES ORTES GERECHNET.
    //
    // Der Ableser rechnete sie zuerst bei jeder Ablesung frisch aus
    // `win_x`/`win_y` -- und zwar ZWEIMAL, einmal fuer oben und einmal
    // fuer unten. Waehrend eines Zuges wandert das Fenster dazwischen,
    // und dann las er oben an der neuen und unten an der alten Stelle:
    // zwei Signaturen, die nichts miteinander zu tun hatten. GEMESSEN
    // als 97 Prozent "Risse" bei stehender Bildgrenze, waehrend
    // derselbe Ableser am STEHENDEN Bild null fand. Der Fehler lag in
    // der Messung.
    //
    // Eine feste Stelle war die naechste Fassung und auch falsch: das
    // Fenster wandert unter ihr weg, und dann misst sie Hintergrund
    // (gemessen: 1 165 276 Ablesungen ohne Signatur von 1 210 449).
    //
    // Richtig ist: den Ort EINMAL lesen und BEIDE Punkte daraus
    // rechnen. Bewegt sich das Fenster danach, gehoert die Ablesung
    // eben zum vorigen Ort -- aber zu EINEM Ort, und genau darauf
    // kommt es an.
    let x: u64 = (wx + ow / 2) as u64
    let y0: u64 = (wy + 1) as u64
    let y1: u64 = (wy + oh - 2) as u64
    // BEIDE PUNKTE AUS DERSELBEN BILDSEITE, in einem Zug. Zwei
    // getrennte Ablesungen haetten den Seitenwechsel dazwischen
    // erwischt und einen Riss gemeldet, den es nicht gab -- siehe
    // `fb.front_paar`.
    let puffer: u64 = state + kstate.WM_OFF + S_LPAAR
    // BIS ZU DREI VERSUCHE. `front_paar` sagt `false`, wenn zwischen
    // den beiden Punkten die Bildseite gewechselt wurde -- dann hat die
    // Ablesung KEINE Aussage (siehe die Begruendung dort). Ein neuer
    // Versuch trifft die naechste ruhige Spanne; klappt es dreimal
    // nicht, wird gar nichts gezaehlt. Eine verworfene Ablesung ist
    // KEIN Riss, und sie als einen zu zaehlen waere die eine Zahl, auf
    // die sich diese Runde nicht verlassen duerfte.
    var versuch: u64 = 0
    var gut: bool = false
    while versuch < 3 && !gut {
        gut = fb.front_paar(state, x, y0, y1, puffer)
        versuch = versuch + 1
    }
    if !gut {
        ss(state, S_VERWORF, gs(state, S_VERWORF) + 1)
        return
    }
    let a: u64 = kstate.get(state, kstate.WM_OFF + S_LPAAR)
    let b: u64 = kstate.get(state, kstate.WM_OFF + S_LPAAR + 8)
    let ka: u64 = sig_nr(a)
    let kb: u64 = sig_nr(b)
    ss(state, S_LIEST, gs(state, S_LIEST) + 1)
    // Nur wenn BEIDE eine Signatur tragen, ist die Frage gestellt.
    // Steht an einer Stelle Fensterinhalt, wurde dort gerade nichts
    // uebertragen -- das ist kein Riss.
    if ka < 8 && kb < 8 && ka != kb {
        ss(state, S_RISS, gs(state, S_RISS) + 1)
        // Die ERSTE Beobachtung festhalten: welche zwei Signaturen,
        // an welchen Zeilen. Ohne sie ist "es reisst" eine Zahl ohne
        // Anhalt, und die Suche nach dem Grund faengt bei null an.
        if gs(state, S_R0) == 0 {
            ss(state, S_R0, ka + 1)
            ss(state, S_R1, kb + 1)
            // Und WO es passiert ist: die Zeilen und die Bildnummer.
            // Ohne sie bleibt "es reisst noch ein bisschen" eine Zahl
            // ohne Anhalt.
            ss(state, S_RY0, y0)
            ss(state, S_RY1, y1)
            ss(state, S_RFR, gs(state, S_FRAME))
        }
    }
    if ka >= 8 || kb >= 8 {
        ss(state, S_KEIN, gs(state, S_KEIN) + 1)
    }
}

// ---------------------------------------------------- DIE SIGNATUR

fn set_sig(state: u64, on: bool) {
    ss(state, S_SIG, 0)
    if on {
        ss(state, S_SIG, 1)
    }
}

fn sig_on(state: u64) -> bool {
    return gs(state, S_SIG) != 0
}

fn frame_no(state: u64) -> u64 {
    return gs(state, S_FRAME)
}

// Die Farbe einer Bildnummer. Acht gut unterscheidbare Volltoene --
// keine Rechnung mit kleinen Unterschieden, denn ein Foto wird
// maschinell gelesen und ein Unterschied von eins waere keiner.
fn sig_colour(n: u64) -> u64 {
    let k: u64 = n & 7
    if k == 0 {
        return 0xFF0000
    }
    if k == 1 {
        return 0x00FF00
    }
    if k == 2 {
        return 0x0000FF
    }
    if k == 3 {
        return 0xFFFF00
    }
    if k == 4 {
        return 0xFF00FF
    }
    if k == 5 {
        return 0x00FFFF
    }
    if k == 6 {
        return 0xFF8000
    }
    return 0xFFFFFF
}

// DIE ZERREISSPROBE, und warum sie so und nicht anders aussieht.
//
// Reissen ist unter QEMU nicht zu sehen: `screendump` liest die
// Bildflaeche, nachdem der Bildaufbau fertig ist, und ein halb
// uebertragenes Bild sieht dabei aus wie ein ganzes. Also wird die
// Frage umgestellt. Jedes Bild traegt eine Nummer; im Signaturbetrieb
// malt der Server einen Streifen dieser Farbe an den OBEREN und einen
// an den UNTEREN Rand jedes Fensters. Beide Streifen entstehen im
// SELBEN `compose`-Lauf und tragen deshalb dieselbe Farbe.
//
// Wird nun mitten in der Uebertragung abgelesen, steht oben noch das
// alte und unten schon das neue Bild -- ZWEI Farben in einem Fenster.
// Das ist Reissen, und ein Programm kann es zaehlen. Steht die
// Bildgrenze, MUSS jedes Foto in jedem Fenster genau eine Farbe zeigen.
fn paint_sig(state: u64, i: u64, cx0: i64, cy0: i64, cx1: i64,
    cy1: i64) {
    if gs(state, S_SIG) == 0 {
        return
    }
    let farbe: u64 = sig_colour(gs(state, S_FRAME))
    let wx: i64 = win_x(state, i)
    let wy: i64 = win_y(state, i)
    let ow: i64 = outer_w(state, i) as i64
    let oh: i64 = outer_h(state, i) as i64
    if oh < 2 * SIG_H as i64 {
        return
    }
    fill_clip(state, wx, wy, ow, SIG_H as i64, farbe, 255, cx0, cy0, cx1, cy1)
    fill_clip(state, wx, wy + oh - SIG_H as i64, ow, SIG_H as i64, farbe, 255,
        cx0, cy0, cx1, cy1)
}

// 24.09.2026: ONE COMPOSITION AT A TIME. `compose` is called from the
// kernel's desktop loop AND out of a dozen window system calls, and a
// system call can be preempted by the loop (or run on another core). Two
// compositions at once share one scratch area -- the column sums of the
// glass blur (`S_BC_SUM`) -- and the second one pulled the sums of the
// first below zero: `panic: integer overflow in 'u64 - u64'` in
// `blur_v`, reproduced with a single core as soon as windows really
// left their opening movement. A TRY-lock and not a spin: whoever finds
// it taken returns, the damage stays pending (`S_DON` is only cleared by
// the composition that runs), and the next turn of the loop paints it.
const S_CLOCK: u64 = 0x1598
// ROUND A11Y-2 (S-008): the magnifier. 0x15A0..0x15E0, behind S_CLOCK.
const S_MAGN: u64 = 0x15A0 // how often the panel was painted
const S_MAGFS: u64 = 0x15A8 // the focus count last seen (ax.fseq)
const S_MAGPX: u64 = 0x15B0 // the pointer last seen
const S_MAGPY: u64 = 0x15B8
const S_MAGMODE: u64 = 0x15C0 // 0 = follows the pointer, 1 = the focus
const S_MAGLX: u64 = 0x15C8 // where the panel stood last time, + 1
const S_MAGCX: u64 = 0x15D0 // the centre it magnified last time
const S_MAGCY: u64 = 0x15D8

// The microseconds between two clock readings (0 while the clock is not calibrated or after a world switch).
fn ph_us(state: u64, t0: u64, t1: u64) -> u64 {
    let kh: u64 = time.khz(state)
    if kh < 1000 || t1 <= t0 {
        return 0
    }
    return (t1 - t0) / (kh / 1000)
}

fn ph_add(state: u64, slot: u64, t0: u64, t1: u64) {
    ss(state, slot, gs(state, slot) + ph_us(state, t0, t1))
}

fn pg_window_at(state: u64, x: u64, y: u64) -> u64 {
    var z: u64 = gs(state, S_COUNT)
    while z > 0 {
        z = z - 1
        let i: u64 = at_z(state, z)
        if i < MAX_WIN && (wg(state, i, W_FLAGS) & (F_HIDDEN | F_TABBED)) == 0 {
            let wx: i64 = win_x(state, i)
            let wy: i64 = win_y(state, i)
            if (x as i64) >= wx && (x as i64) < wx + outer_w(state, i) as i64
                && (y as i64) >= wy && (y as i64) < wy + outer_h(state, i) as i64 {
                return i + 1
            }
        }
    }
    return 0
}

fn pg_ready(state: u64) -> bool {
    if ax.mag(state) || fb.transformed(state) || fb.on_vgpu(state) || fb.flip_on(state) {
        return false
    }
    if fb.back(state) == 0 || fb.draw_at(state) != fb.back(state) {
        return false
    }
    if gs(state, S_VSYNC) != 0 || cp_on(state) {
        return false
    }
    return true
}

fn pg_render(state: u64, slot: u64) -> bool {
    if !pixelguard.begin(state, slot) {
        return false
    }
    compose_rect(state, 0, 0, gs(state, S_SW), gs(state, S_SH), 0)
    pixelguard.finish(state)
    return true
}

fn pg_box(state: u64, out: u64) {
    var k: u64 = 0
    while k < 4 {
        __mmio_write64((out + k * 8) as *mut u64, 0 as u64)
        k = k + 1
    }
    if gs(state, S_DON) != 0 {
        __mmio_write64(out as *mut u64, gs(state, S_DX0))
        __mmio_write64((out + 8) as *mut u64, gs(state, S_DY0))
        __mmio_write64((out + 16) as *mut u64, gs(state, S_DX1))
        __mmio_write64((out + 24) as *mut u64, gs(state, S_DY1))
    }
}

fn pg_compare(state: u64, slot: u64) -> u64 {
    var bx: [u64; 4] = [0 as u64; 4]
    pg_box(state, (&bx[0]) as u64)
    return pixelguard.compare(state, slot, bx[0], bx[1], bx[2], bx[3])
}

fn pg_cursor(state: u64) -> u64 {
    return gs(state, S_CURX) * 65536 + gs(state, S_CURY)
}

fn pg_check(state: u64, painted: u64, cur0: u64) {
    if !pixelguard.due(state, painted) {
        return
    }
    if !pg_ready(state) {
        pixelguard.count(pixelguard.ST_SKIPPED)
        return
    }
    let t0: u64 = time.tsc()
    let pl: u64 = gs(state, S_PL_ON)
    let zf: u64 = gs(state, S_ZFLAG)
    let p0: u64 = gs(state, S_PH_BG)
    let p1: u64 = gs(state, S_PH_WIN)
    let p2: u64 = gs(state, S_PH_DRAG)
    let p3: u64 = gs(state, S_PH_TOP)
    let p4: u64 = gs(state, S_PH_PEND)
    let p5: u64 = gs(state, S_PH_BLUR)
    let p6: u64 = gs(state, S_PH_GLASS)
    let p7: u64 = gs(state, S_PH_SHADOW)
    ss(state, S_PL_ON, 0)
    if pg_render(state, 0) {
        pixelguard.count(pixelguard.ST_CHECKS)
        let bad: u64 = pg_compare(state, 0)
        if bad == 0 {
            pixelguard.clear_cand(0)
        }
        if bad != 0 && pg_cursor(state) != cur0 {
            pixelguard.count(pixelguard.ST_PENDING)
        } else if bad != 0 {
            if pg_render(state, 1) {
                let bad2: u64 = pg_compare(state, 1)
                if bad2 == 0 {
                    pixelguard.count(pixelguard.ST_PENDING)
                } else if pixelguard.compare_refs(state, pixelguard.cmp_get(pixelguard.CMP_X0), pixelguard.cmp_get(pixelguard.CMP_Y0),
                    pixelguard.cmp_get(pixelguard.CMP_X1), pixelguard.cmp_get(pixelguard.CMP_Y1)) != 0 {
                    pixelguard.count(pixelguard.ST_UNSTABLE)
                } else if !pixelguard.confirm(0, pixelguard.cmp_get(pixelguard.CMP_X0), pixelguard.cmp_get(pixelguard.CMP_Y0),
                    pixelguard.cmp_get(pixelguard.CMP_X1), pixelguard.cmp_get(pixelguard.CMP_Y1)) {
                    pixelguard.count(pixelguard.ST_PENDING)
                } else {
                    let win: u64 = pg_window_at(state, pixelguard.cmp_get(pixelguard.CMP_FX), pixelguard.cmp_get(pixelguard.CMP_FY))
                    pixelguard.report(state, 0, win, pixelguard.ref_addr(1), fb.back(state))
                }
            }
        }
    }
    if !fb.stripe(state) {
        pixelguard.count(pixelguard.ST_CARD_CHECKS)
        let cbad: u64 = pixelguard.card_compare(state)
        if cbad == 0 {
            pixelguard.clear_cand(1)
        }
        if cbad != 0 && !pixelguard.confirm(1, pixelguard.cmp_get(pixelguard.CMP_X0), pixelguard.cmp_get(pixelguard.CMP_Y0),
            pixelguard.cmp_get(pixelguard.CMP_X1), pixelguard.cmp_get(pixelguard.CMP_Y1)) {
            pixelguard.count(pixelguard.ST_PENDING)
        } else if cbad != 0 {
            let cwin: u64 = pg_window_at(state, pixelguard.cmp_get(pixelguard.CMP_FX), pixelguard.cmp_get(pixelguard.CMP_FY))
            pixelguard.report(state, 1, cwin, fb.back(state), fb.addr(state))
        }
    }
    ss(state, S_PL_ON, pl)
    ss(state, S_ZFLAG, zf)
    ss(state, S_PH_BG, p0)
    ss(state, S_PH_WIN, p1)
    ss(state, S_PH_DRAG, p2)
    ss(state, S_PH_TOP, p3)
    ss(state, S_PH_PEND, p4)
    ss(state, S_PH_BLUR, p5)
    ss(state, S_PH_GLASS, p6)
    ss(state, S_PH_SHADOW, p7)
    pixelguard.set_last(pixelguard.ST_US, time_us(state, time.tsc() - t0))
}

fn compose(state: u64) -> u64 {
    let lk: u64 = state + kstate.WM_OFF + S_CLOCK
    let alt: u64 = __atomic_swap(lk as *mut u64, 0 as u64, 1 as u64)
    if alt != 0 {
        return 0
    }
    if pixelguard.frozen() {
        arch.atomic_store(lk, 0)
        return 0
    }
    screen_follow(state)
    cp_watch(state)
    tab_publish(state)
    let cur0: u64 = pg_cursor(state)
    let r: u64 = compose_one(state)
    pg_check(state, r, cur0)
    cp_kick(state)
    arch.atomic_store(lk, 0)
    return r
}

// W-PRESENT: PUSH ONE FINISHED RECTANGLE TO THE CARD WITHOUT THE PAGE FLIP (the path of every frame when `vsync` is off, i.e. the shipping
// configuration). Only the changed columns are copied (`fb.flush_region`); the word `fullrows` brings the old whole-row copy back as the counter-proof.
// The copy is timed with the TSC: F12 prints sum / max / count (`wm: flush`), because the time the card holds a half-copied frame is the time
// a scan-out can tear it.
fn time_us(state: u64, cyc: u64) -> u64 {
    let kh: u64 = time.khz(state)
    if kh < 1000 {
        return 0
    }
    return cyc / (kh / 1000)
}

fn flush_box(state: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    // W-VBLANK: with a working scan-line counter the copy waits until the raster is out of the rows it writes (returns at once otherwise)
    beam.wait(state, x0, y0, x1 - x0, y1 - y0)
    let t0: u64 = time.tsc()
    let o0: u64 = fb.tx_octets(state)
    if fb.fullrows_an(state) {
        fb.dirty(state, y0, y1)
        fb.flush(state)
    } else {
        var fw: u64 = x1 - x0
        if pixelguard.bug_is(4) && fw > 1 {
            fw = fw - 1
        }
        fb.flush_region(state, x0, y0, fw, y1 - y0)
    }
    let t1: u64 = time.tsc()
    if gs(state, S_PL_ON) != 0 {
        pl_record(state, 0, x0, y0, x1, y1, t0, 0)
    }
    fb.flush_note(state, ph_us(state, t0, t1), fb.tx_octets(state) - o0)
    beam.note(state, ph_us(state, t0, t1), fb.tx_octets(state) - o0)
}

// W-VBLANK: merge the rectangles of one frame. Two rectangles become one when they overlap, or when the union is at most a quarter larger than
// the two together (a few more octets copied, one pass instead of two). `rs` holds `n` rectangles of 4 words (x0, y0, x1, y1); returns the new count.
fn rects_merge(rs: u64, n0: u64) -> u64 {
    var n: u64 = n0
    var again: bool = true
    while again && n > 1 {
        again = false
        var i: u64 = 0
        while i < n && !again {
            var j: u64 = i + 1
            while j < n && !again {
                let ax0: u64 = __mmio_read64((rs + (i * 4) * 8) as *mut u64)
                let ay0: u64 = __mmio_read64((rs + (i * 4 + 1) * 8) as *mut u64)
                let ax1: u64 = __mmio_read64((rs + (i * 4 + 2) * 8) as *mut u64)
                let ay1: u64 = __mmio_read64((rs + (i * 4 + 3) * 8) as *mut u64)
                let bx0: u64 = __mmio_read64((rs + (j * 4) * 8) as *mut u64)
                let by0: u64 = __mmio_read64((rs + (j * 4 + 1) * 8) as *mut u64)
                let bx1: u64 = __mmio_read64((rs + (j * 4 + 2) * 8) as *mut u64)
                let by1: u64 = __mmio_read64((rs + (j * 4 + 3) * 8) as *mut u64)
                var ux0: u64 = ax0
                if bx0 < ux0 {
                    ux0 = bx0
                }
                var uy0: u64 = ay0
                if by0 < uy0 {
                    uy0 = by0
                }
                var ux1: u64 = ax1
                if bx1 > ux1 {
                    ux1 = bx1
                }
                var uy1: u64 = ay1
                if by1 > uy1 {
                    uy1 = by1
                }
                let aa: u64 = (ax1 - ax0) * (ay1 - ay0)
                let ba: u64 = (bx1 - bx0) * (by1 - by0)
                let ua: u64 = (ux1 - ux0) * (uy1 - uy0)
                var join: bool = false
                if ax0 < bx1 && bx0 < ax1 && ay0 < by1 && by0 < ay1 {
                    join = true
                } else if ua * 100 <= (aa + ba) * 125 {
                    join = true
                }
                if join {
                    __mmio_write64((rs + (i * 4) * 8) as *mut u64, ux0)
                    __mmio_write64((rs + (i * 4 + 1) * 8) as *mut u64, uy0)
                    __mmio_write64((rs + (i * 4 + 2) * 8) as *mut u64, ux1)
                    __mmio_write64((rs + (i * 4 + 3) * 8) as *mut u64, uy1)
                    // the last rectangle takes the place of j
                    var k: u64 = 0
                    while k < 4 {
                        __mmio_write64((rs + (j * 4 + k) * 8) as *mut u64, __mmio_read64((rs + ((n - 1) * 4 + k) * 8) as *mut u64))
                        k = k + 1
                    }
                    n = n - 1
                    again = true
                }
                j = j + 1
            }
            i = i + 1
        }
    }
    return n
}

// W-VBLANK: ONE PASS FOR ALL RECTANGLES OF A FRAME. Every rectangle was painted into the back buffer first; now they go to the card
// back to back (each held back for the raster when beam sync works), and the dirty-row marks the painters left are spent once at the end.
fn flush_many(state: u64, rs: u64, n: u64) {
    var us_sum: u64 = 0
    var okt_sum: u64 = 0
    var ylo: u64 = 0xFFFFFFFF
    var yhi: u64 = 0
    var i: u64 = 0
    while i < n {
        let x0: u64 = __mmio_read64((rs + (i * 4) * 8) as *mut u64)
        let y0: u64 = __mmio_read64((rs + (i * 4 + 1) * 8) as *mut u64)
        let x1: u64 = __mmio_read64((rs + (i * 4 + 2) * 8) as *mut u64)
        let y1: u64 = __mmio_read64((rs + (i * 4 + 3) * 8) as *mut u64)
        if x1 > x0 && y1 > y0 {
            beam.wait(state, x0, y0, x1 - x0, y1 - y0)
            let ta: u64 = time.tsc()
            let oa: u64 = fb.tx_octets(state)
            var fw: u64 = x1 - x0
            if pixelguard.bug_is(4) && fw > 1 {
                fw = fw - 1
            }
            fb.flush_rect(state, x0, y0, fw, y1 - y0)
            if gs(state, S_PL_ON) != 0 {
                pl_record(state, 0, x0, y0, x1, y1, ta, 0)
            }
            us_sum = us_sum + ph_us(state, ta, time.tsc())
            okt_sum = okt_sum + (fb.tx_octets(state) - oa)
            if y0 < ylo {
                ylo = y0
            }
            if y1 > yhi {
                yhi = y1
            }
        }
        i = i + 1
    }
    if yhi > ylo {
        let tb: u64 = time.tsc()
        let ob: u64 = fb.tx_octets(state)
        fb.flush_done(state, ylo, yhi)
        us_sum = us_sum + ph_us(state, tb, time.tsc())
        okt_sum = okt_sum + (fb.tx_octets(state) - ob)
    }
    fb.flush_note(state, us_sum, okt_sum)
    beam.note(state, us_sum, okt_sum)
}

// One rectangle of the frame: grow it over the blurring windows it touches, then the desktop, the windows from bottom to top,
// the layers above them, the pointer and the hand-over to `present`. Returns the number of pixels of the (grown) rectangle.
fn compose_rect(state: u64, bx0: u64, by0: u64, bx1: u64, by1: u64, outr: u64) -> u64 {
    var x0: u64 = bx0
    var y0: u64 = by0
    var x1: u64 = bx1
    var y1: u64 = by1
    // ============================== FIX 04.10.2026: THE MENU BLUR BAND
    //
    // Justin, Dell: moving the mouse over the start menu smeared a band of
    // it (the window's own text, blurred). THE SAME RULE AS THE BAR'S
    // (see `damage`), FOR EVERY WINDOW THAT BLURS. `paint_win` blurs the
    // WHOLE outer rectangle of such a window from what stands in the second
    // buffer, but paints the window itself only inside the dirty
    // rectangle. A pointer or a hover row dirties a small strip: the blur
    // then read the window's OLD pixels (the rest of the window was not
    // repainted from the desktop up) and wrote them blurred over the full
    // width of the window; the text came back only inside the strip.
    // So a dirty rectangle that touches a blurring window grows to that
    // window's whole rectangle: the desktop is repainted under all of it,
    // the blur reads a clean background, the window is painted over all
    // of it. Grown windows can touch further ones, so up to three rounds.
    // `noglasgrow` switches this off (the counter-proof of the tests).
    if gs(state, S_NOGROW) == 0 && form(state, FM_BLUR) > 0 {
        var rounds: u64 = 0
        var grew: bool = true
        while grew && rounds < 3 {
            grew = false
            rounds = rounds + 1
            var wi: u64 = 0
            while wi < MAX_WIN {
                if blur_will(state, wi) && !blur_hit_ok(state, wi) {
                    var qx0: i64 = win_x(state, wi)
                    var qy0: i64 = win_y(state, wi)
                    var qx1: i64 = qx0 + outer_w(state, wi) as i64
                    var qy1: i64 = qy0 + outer_h(state, wi) as i64
                    if qx0 < 0 {
                        qx0 = 0
                    }
                    if qy0 < 0 {
                        qy0 = 0
                    }
                    if qx1 > gs(state, S_SW) as i64 {
                        qx1 = gs(state, S_SW) as i64
                    }
                    if qy1 > gs(state, S_SH) as i64 {
                        qy1 = gs(state, S_SH) as i64
                    }
                    if qx1 > x0 as i64 && qx0 < x1 as i64
                        && qy1 > y0 as i64 && qy0 < y1 as i64 {
                        if (qx0 as u64) < x0 {
                            x0 = qx0 as u64
                            grew = true
                        }
                        if (qy0 as u64) < y0 {
                            y0 = qy0 as u64
                            grew = true
                        }
                        if (qx1 as u64) > x1 {
                            x1 = qx1 as u64
                            grew = true
                        }
                        if (qy1 as u64) > y1 {
                            y1 = qy1 as u64
                            grew = true
                        }
                    }
                }
                wi = wi + 1
            }
        }
    }
    // PRESENT LOG: hash of the shared client buffers before the frame is composed (see pl_compose_begin)
    var pl_b: [u64; 3] = [0 as u64; 3]
    let pl_on_here: bool = gs(state, S_PL_ON) != 0
    if pl_on_here {
        pl_compose_begin(state, (&pl_b[0]) as u64)
    }
    let ph_a0: u64 = time.tsc()
    // 1. der Hintergrund
    fb.fill(state, x0, y0, x1 - x0, y1 - y0, gs(state, S_DESK))
    // 1b. die Reiter- und Stapelzeilen des Baumes. Sie liegen UNTER den
    //     Fenstern und ueberschneiden sie nicht -- der Baum hat ihre
    //     Hoehe von der Flaeche der Kinder abgezogen.
    if gs(state, S_TILE) != 0 {
        paint_bars(state, x0, y0, x1, y1)
    }
    ph_add(state, S_PH_BG, ph_a0, time.tsc())
    // 2. die Fenster, von unten nach oben
    let ph_b: u64 = time.tsc()
    var z: u64 = 0
    while z < gs(state, S_COUNT) {
        let i: u64 = at_z(state, z)
        // RUNDE DESKTOP: ein minimiertes Fenster wird uebergangen. Es
        // ist der einzige Unterschied zwischen "minimiert" und
        // "geschlossen", den das Zusammensetzen sieht.
        // RUNDE TILING: und ein Fenster, das hinter einem Reiter liegt,
        // ebenfalls. Zwei Gruende, nicht zu malen, ZWEI Bits -- die
        // Runde TILING hatte dafuer ein eigenes Wort, aber "minimiert"
        // und "hinter einem Reiter" muessen sich getrennt aufheben
        // lassen.
        // RUNDE ALLTAG: WAEHREND DER SPERRE WIRD NUR DER SPERRER
        // GEMALT. Eine Ebene ueber allem waere zu wenig: der Starter
        // liegt auch oben, und im ersten Anlauf stand er im Bild des
        // Sperrbildschirms. Was nicht dem Sperrer gehoert, ist waehrend
        // der Sperre nicht auf dem Schirm -- und der Inhalt eines
        // fremden Fensters ist damit auch nicht ablesbar.
        if i < MAX_WIN && (wg(state, i, W_FLAGS) & (F_HIDDEN | F_TABBED)) == 0
            && darf(state, i) {
            let pw_t: u64 = time.tsc()
            paint_win(state, i, x0, y0, x1, y1)
            if fb.phases_an(state) {
                let pw_us: u64 = ph_us(state, pw_t, time.tsc())
                if pw_us > 8000 {
                    var s_pw: [u8; 17] = "wm: slowwin win=\0"
                    var s_pw2: [u8; 5] = " us=\0"
                    var s_pw3: [u8; 5] = " px=\0"
                    serial.puts((&s_pw[0]) as u64)
                    serial.dec(i)
                    serial.puts((&s_pw2[0]) as u64)
                    serial.dec(pw_us)
                    serial.puts((&s_pw3[0]) as u64)
                    serial.dec(wg(state, i, W_PX))
                    serial.nl()
                }
            }
        }
        z = z + 1
    }
    let ph_c: u64 = time.tsc()
    ph_add(state, S_PH_WIN, ph_b, ph_c)
    if pl_on_here {
        pl_compose_end(state, (&pl_b[0]) as u64)
    }
    // 2a. RUNDE VSYNC: die Signatur der Zerreissprobe, ueber der
    //     Fensterflaeche und unter allem, was darueber liegt. Sie wird
    //     je Fenster gemalt, damit ein Foto sie JE FENSTER vergleichen
    //     kann -- ein Streifen quer ueber den Schirm haette nicht
    //     gezeigt, welches Fenster zerrissen ist.
    if gs(state, S_SIG) != 0 {
        var zs: u64 = 0
        while zs < gs(state, S_COUNT) {
            let si: u64 = at_z(state, zs)
            if si < MAX_WIN
                && (wg(state, si, W_FLAGS) & (F_HIDDEN | F_TABBED)) == 0 {
                paint_sig(state, si, x0 as i64, y0 as i64, x1 as i64,
                    y1 as i64)
            }
            zs = zs + 1
        }
    }
    let tp_sig: u64 = time.tsc()
    // 2b. das Vorschaurechteck beim Ziehen -- ueber den Fenstern, unter
    //     dem Zeiger.
    if gs(state, S_PVON) != 0 {
        paint_preview(state, x0, y0, x1, y1)
    }
    // 2c. ROUND ACTION-BUS-5 (AB-004): the trusted dialog, over every
    //     window and under the pointer only
    let tp_pv: u64 = time.tsc()
    paint_switcher(state, x0, y0, x1, y1) // W1d: the Alt+Tab panel, over the windows
    td_paint(state, x0, y0, x1, y1)
    let tp_td: u64 = time.tsc()
    // 3. der Zeiger, ganz oben
    //
    // RUNDE GPU (G-012): NUR NOCH, WENN IHN NIEMAND ANDERES TRAEGT.
    // Liegt der Zeiger als eigene Flaeche auf dem Geraet, waere dieses
    // Malen nicht nur ueberfluessig, sondern falsch -- man saehe ihn
    // DOPPELT, einmal im Bild und einmal darueber. `hwcur_an` ist
    // deshalb die Bedingung fuer BEIDES: fuer das Malen hier und fuer
    // den Schaden bei der Bewegung.
    if gs(state, S_CURON) != 0 && !hwcur_an(state) {
        paint_cursor(state, x0, y0, x1, y1)
    }
    let tp_cur: u64 = time.tsc()
    // 4. ROUND A11Y-2: THE MAGNIFIER, ON TOP OF EVERYTHING -- after the
    //    pointer, so the pointer is in the magnified picture too. It
    //    reads from the finished picture (`fb.get_pixel` reads the draw
    //    target), so it magnifies what is ON THE SCREEN, not one window.
    if ax.mag(state) {
        paint_mag(state)
    }
    // RUNDE VSYNC: DIE WEICHE. Mit Bildgrenze wird das Rechteck nur
    // VORGEMERKT -- `present` uebertraegt es im Takt, und zwar als
    // Ganzes. Ohne (die Gegenprobe `nopresent`) geht es den alten Weg
    // und wird sofort geschoben; dann MUSS die Zerreissprobe wieder
    // gemischte Signaturen finden.
    let ph_d: u64 = time.tsc()
    ph_add(state, S_PH_TOP, ph_c, ph_d)
    // r481: with `phases`, a frame whose top layer took over 8 ms says which part it was (signature, preview, trusted dialog, pointer, magnifier)
    if ph_us(state, ph_c, ph_d) > 8000 && fb.phases_an(state) {
        var s_t0: [u8; 13] = "wm: toplong \0"
        var s_t1: [u8; 6] = " sig=\0"
        var s_t2: [u8; 5] = " pv=\0"
        var s_t3: [u8; 5] = " td=\0"
        var s_t4: [u8; 6] = " cur=\0"
        var s_t5: [u8; 6] = " mag=\0"
        serial.puts((&s_t0[0]) as u64)
        serial.puts((&s_t1[0]) as u64)
        serial.dec(ph_us(state, ph_c, tp_sig))
        serial.puts((&s_t2[0]) as u64)
        serial.dec(ph_us(state, tp_sig, tp_pv))
        serial.puts((&s_t3[0]) as u64)
        serial.dec(ph_us(state, tp_pv, tp_td))
        serial.puts((&s_t4[0]) as u64)
        serial.dec(ph_us(state, tp_td, tp_cur))
        serial.puts((&s_t5[0]) as u64)
        serial.dec(ph_us(state, tp_cur, ph_d))
        serial.nl()
    }
    // vboxlag: with `phases`, a composed rectangle over 16384 px is printed with the dirty box it grew from
    if fb.phases_an(state) && (x1 - x0) * (y1 - y0) > 16384 {
        var s_c0: [u8; 11] = "wm: crect \0"
        var s_c1: [u8; 6] = " in= \0"
        serial.puts((&s_c0[0]) as u64)
        serial.dec(x0)
        serial.put(32 as u8)
        serial.dec(y0)
        serial.put(32 as u8)
        serial.dec(x1)
        serial.put(32 as u8)
        serial.dec(y1)
        serial.puts((&s_c1[0]) as u64)
        serial.dec(bx0)
        serial.put(32 as u8)
        serial.dec(by0)
        serial.put(32 as u8)
        serial.dec(bx1)
        serial.put(32 as u8)
        serial.dec(by1)
        serial.nl()
    }
    if pixelguard.rendering() {
        return (x1 - x0) * (y1 - y0)
    }
    if gs(state, S_VSYNC) != 0 {
        pend_add(state, x0, y0, x1, y1)
        ss(state, S_SKIPPED, gs(state, S_SKIPPED) + 1)
    } else if cp_on(state) {
        // COMPOSITOR S5: the finished rectangle waits for the compositor in ring 3 (the watchdog pushes it when it takes too long)
        cp_hand(state, x0, y0, x1, y1)
    } else if outr != 0 {
        // W-VBLANK: the caller collects the finished rectangles of the frame and copies them together
        __mmio_write64(outr as *mut u64, x0)
        __mmio_write64((outr + 8) as *mut u64, y0)
        __mmio_write64((outr + 16) as *mut u64, x1)
        __mmio_write64((outr + 24) as *mut u64, y1)
    } else {
        flush_box(state, x0, y0, x1, y1)
        ss(state, S_CP_NKP, gs(state, S_CP_NKP) + 1)
        cp_lat(state, false)
    }
    ph_add(state, S_PH_PEND, ph_d, time.tsc())
    return (x1 - x0) * (y1 - y0)
}

// One frame of the composed picture: the dirty box or its rectangles are painted by `compose_rect` (background, then every window
// from the bottom to the top that touches the rectangle), and the frame time is counted here.
fn compose_one(state: u64) -> u64 {
    if !ready(state) || !fb.ready(state) {
        return 0
    }
    // ROUND A11Y-2: WITH THE MAGNIFIER ITS PANEL IS ALWAYS PART OF THE
    // DIRTY AREA -- and so is the place it stood last time, if it moved.
    // Without this the panel would be painted and not transferred, or
    // its old picture would stay on the screen.
    if ax.mag(state) {
        mag_damage(state)
    } else if gs(state, S_MAGLX) != 0 {
        // switched off: the old panel goes away
        let ox: u64 = gs(state, S_MAGLX) - 1
        ss(state, S_MAGLX, 0)
        damage(state, ox as i64, 0, (ox + MAG_W) as i64, MAG_H as i64)
    }
    var bt: [u64; 4] = [0 as u64; 4]
    if !box_take(state, (&bt[0]) as u64) {
        return 0
    }
    let x0: u64 = bt[0]
    let y0: u64 = bt[1]
    let x1: u64 = bt[2]
    let y1: u64 = bt[3]
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    // ROUND VSYNC: THE FRAME NUMBER RISES HERE and not when the picture is
    // transferred. Everything painted in this run belongs to ONE frame and
    // carries the same signature.
    ss(state, S_FRAME, gs(state, S_FRAME) + 1)
    // ROUND WMPLUGIN: THE BROOM, ONCE A FRAME. Eight comparisons, no
    // waiting, no allocation -- it throws out whoever was called and does
    // not come. THIS IS THE ONLY PLACE IN THE COMPOSE PATH that knows
    // anything about plug-ins.
    wmplug.sweep(state)
    // ROUND VEKTOR: the clock for this frame.
    let t_start: u64 = time.tsc()
    // r481: where the time of a slow frame went (only with the kernel word `phases`; see the `wm: slow` line below)
    let sl_bg: u64 = gs(state, S_PH_BG)
    let sl_win: u64 = gs(state, S_PH_WIN)
    let sl_top: u64 = gs(state, S_PH_TOP)
    let sl_pend: u64 = gs(state, S_PH_PEND)
    let sl_blur: u64 = gs(state, S_PH_BLUR)
    let sl_shd: u64 = gs(state, S_PH_SHADOW)
    let sl_drg: u64 = gs(state, S_PH_DRAG)
    let sl_gls: u64 = gs(state, S_PH_GLASS)
    // r461: with a region of several rectangles, paint them one by one (never with the magnifier: it paints one panel over
    // the finished picture and must see the whole picture once)
    var rs: [u64; 64] = [0 as u64; 64]
    var nr: u64 = 0
    if !ax.mag(state) {
        nr = rgn_take(state, (&rs[0]) as u64, x0, y0, x1, y1)
    } else {
        nr = 0
    }
    var painted: u64 = 0
    if nr == 0 {
        painted = compose_rect(state, x0, y0, x1, y1, 0)
    } else {
        ss(state, S_RFRAMES, gs(state, S_RFRAMES) + 1)
        // W-VBLANK: in the shipping path (no frame boundary, no compositor) the rectangles are painted one after the other into the back buffer and
        // then merged and copied to the card in ONE pass; `fullrows` keeps the old copy per rectangle (counter-proof).
        let collect: bool = gs(state, S_VSYNC) == 0 && !cp_on(state) && !fb.fullrows_an(state)
        var ri: u64 = 0
        while ri < nr {
            var outp: u64 = 0
            if collect {
                outp = (&rs[(ri * 4) as usize]) as u64
            }
            var rx1: u64 = rs[(ri * 4 + 2) as usize]
            if pixelguard.bug_is(1) && rx1 > rs[(ri * 4) as usize] + 1 {
                rx1 = rx1 - 1
            }
            painted = painted + compose_rect(state, rs[(ri * 4) as usize], rs[(ri * 4 + 1) as usize],
                rx1, rs[(ri * 4 + 3) as usize], outp)
            ri = ri + 1
        }
        if collect {
            // compose_rect wrote the grown rectangle over its own slot (the arguments were read before the call)
            let nm: u64 = rects_merge((&rs[0]) as u64, nr)
            fb.bm_add(state, fb.S_RM_IN, nr)
            fb.bm_add(state, fb.S_RM_OUT, nm)
            flush_many(state, (&rs[0]) as u64, nm)
            ss(state, S_CP_NKP, gs(state, S_CP_NKP) + nm)
            cp_lat(state, false)
        }
    }
    ss(state, S_PH_PX, gs(state, S_PH_PX) + painted)
    ss(state, S_PH_N, gs(state, S_PH_N) + 1)
    ss(state, S_COMPOSITES, gs(state, S_COMPOSITES) + 1)
    ss(state, S_PIXELS, gs(state, S_PIXELS) + painted)
    // RUNDE VEKTOR: die Bildzeit. `khz` ist die Zyklenzahl je
    // Millisekunde; geteilt durch 1000 sind es die je Mikrosekunde.
    // Ist die Uhr noch nicht geeicht (khz == 0), wird nichts gezaehlt
    // -- eine Division durch null waere hier ein Absturz im Bildtakt.
    let kh: u64 = time.khz(state)
    if kh >= 1000 {
        let t_ende: u64 = time.tsc()
        // Als Subtraktion auf der Seite, die gross genug ist: der
        // Zyklenzaehler kann zwischen zwei Ablesungen nicht kleiner
        // werden, aber ein Weltwechsel in eine Gastmaschine kann ihn
        // zuruecksetzen. Dann wird dieses eine Bild nicht gezaehlt.
        if t_ende > t_start {
            let us: u64 = (t_ende - t_start) / (kh / 1000)
            ss(state, S_FRUS, gs(state, S_FRUS) + us)
            ss(state, S_FRN, gs(state, S_FRN) + 1)
            ss(state, S_FRLAST, us)
            if us > gs(state, S_FRMAX) {
                ss(state, S_FRMAX, us)
            }
            if us > 16000 {
                ss(state, S_FRUEBER, gs(state, S_FRUEBER) + 1)
                if fb.phases_an(state) {
                    var s_sl: [u8; 13] = "wm: slow us=\0"
                    var s_s1: [u8; 5] = " bg=\0"
                    var s_s2: [u8; 6] = " win=\0"
                    var s_s3: [u8; 6] = " top=\0"
                    var s_s4: [u8; 7] = " pend=\0"
                    var s_s5: [u8; 7] = " blur=\0"
                    var s_s6: [u8; 6] = " shd=\0"
                    var s_s7: [u8; 6] = " drg=\0"
                    var s_s8: [u8; 6] = " gls=\0"
                    var s_s9: [u8; 5] = " px=\0"
                    serial.puts((&s_sl[0]) as u64)
                    serial.dec(us)
                    serial.puts((&s_s1[0]) as u64)
                    serial.dec(gs(state, S_PH_BG) -% sl_bg)
                    serial.puts((&s_s2[0]) as u64)
                    serial.dec(gs(state, S_PH_WIN) -% sl_win)
                    serial.puts((&s_s3[0]) as u64)
                    serial.dec(gs(state, S_PH_TOP) -% sl_top)
                    serial.puts((&s_s4[0]) as u64)
                    serial.dec(gs(state, S_PH_PEND) -% sl_pend)
                    serial.puts((&s_s5[0]) as u64)
                    serial.dec(gs(state, S_PH_BLUR) -% sl_blur)
                    serial.puts((&s_s6[0]) as u64)
                    serial.dec(gs(state, S_PH_SHADOW) -% sl_shd)
                    serial.puts((&s_s7[0]) as u64)
                    serial.dec(gs(state, S_PH_DRAG) -% sl_drg)
                    serial.puts((&s_s8[0]) as u64)
                    serial.dec(gs(state, S_PH_GLASS) -% sl_gls)
                    serial.puts((&s_s9[0]) as u64)
                    serial.dec(painted)
                    serial.nl()
                }
            }
            // RUNDE ZIEH: dasselbe Bild noch einmal, aber nur,
            // wenn in ihm ein Fenster AUFGEHOBEN gemalt wurde.
            // `zieh_frame` wird von `compose` gesetzt und hier
            // wieder geloescht -- so zaehlt genau das Bild, das den
            // teuren Weg gegangen ist, und keines daneben.
            if gs(state, S_ZFLAG) == 0 {
                // Ein Bild ohne aufgehobenes Fenster -- die
                // Grundlast derselben Maschine im selben Lauf.
                ss(state, S_OFRN, gs(state, S_OFRN) + 1)
                ss(state, S_OFRUS, gs(state, S_OFRUS) + us)
                if us > gs(state, S_OFRMAX) {
                    ss(state, S_OFRMAX, us)
                }
            }
            if gs(state, S_ZFLAG) != 0 {
                ss(state, S_ZFLAG, 0)
                ss(state, S_ZFRN, gs(state, S_ZFRN) + 1)
                ss(state, S_ZFRUS, gs(state, S_ZFRUS) + us)
                if us > gs(state, S_ZFRMAX) {
                    ss(state, S_ZFRMAX, us)
                }
                if us > 16700 {
                    ss(state, S_ZFRUE, gs(state, S_ZFRUE) + 1)
                }
            }
            // Das Fach: die Verdoppelung, in der diese Zeit liegt.
            var fach: u64 = 0
            var g: u64 = 1000
            while fach < 7 && us >= g {
                g = g * 2
                fach = fach + 1
            }
            ss(state, S_FRH + fach * 8, gs(state, S_FRH + fach * 8) + 1)
            // Und dasselbe noch einmal, aber erst ab dem elften Bild.
            if gs(state, S_FRN) > 10 {
                if us > gs(state, S_FRMAXW) {
                    ss(state, S_FRMAXW, us)
                }
                if us > 16000 {
                    ss(state, S_FRUEBERW, gs(state, S_FRUEBERW) + 1)
                }
            }
        }
    }
    return painted
}

// ------------------------------------------- RUNDE VEKTOR: DIE BILDZEIT
//
// Fuenf Ableser, damit die Abnahme die Zahlen holen kann, ohne die
// Offsets zu kennen.

fn frame_us_sum(state: u64) -> u64 {
    return gs(state, S_FRUS)
}

fn frame_us_n(state: u64) -> u64 {
    return gs(state, S_FRN)
}

fn frame_us_max(state: u64) -> u64 {
    return gs(state, S_FRMAX)
}

fn frame_us_last(state: u64) -> u64 {
    return gs(state, S_FRLAST)
}

fn frame_ueber16(state: u64) -> u64 {
    return gs(state, S_FRUEBER)
}

// Ein Fach des Histogramms, 0..7.
fn frame_fach(state: u64, i: u64) -> u64 {
    if i > 7 {
        return 0
    }
    return gs(state, S_FRH + i * 8)
}

// Der Betrieb, also ohne die ersten zehn Bilder.
fn frame_us_maxw(state: u64) -> u64 {
    return gs(state, S_FRMAXW)
}

fn frame_ueber16w(state: u64) -> u64 {
    return gs(state, S_FRUEBERW)
}

// WIE VIELE TASTEN BEI DIESEM FENSTER ANGEKOMMEN SIND. Die Zahl ist die
// Gegenprobe zum Eingabefokus: mit Fokus MUSS sie beim unbeteiligten
// Fenster null sein, mit `nofocus` MUSS sie es nicht sein. Ohne diese
// zwei Zahlen waere "die Taste geht an das richtige Fenster" eine
// Behauptung ueber etwas, das man im Bild nicht sieht.
fn win_keys(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return 0
    }
    return wg(state, i, W_KEYS)
}

fn downs(state: u64) -> u64 {
    return gs(state, S_DOWNS)
}

fn moves_seen(state: u64) -> u64 {
    return gs(state, S_MOVES)
}

fn hits_seen(state: u64) -> u64 {
    return gs(state, S_HITS)
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

// Ein Fenster in den schmutzigen Bereich. Rahmen, Titelleiste,
// Schliessfeld, Groessengriff -- und dann die Flaeche der Anwendung.
// RUNDE VSYNC: EIN FENSTER IN BEWEGUNG, und warum es NICHT der
// gewoehnliche Weg mit anderen Zahlen ist.
//
// Beim Oeffnen und Schliessen soll das Fenster skalieren UND
// durchscheinen. Skalieren heisst: die Fensterflaeche (`W_BUF`) wird
// beim Uebertragen abgetastet, nicht Zeile fuer Zeile kopiert.
// Durchscheinen heisst: jeder Bildpunkt wird mit dem gemischt, was
// schon dasteht. Beides zusammen geht nur, wenn man an die Flaeche VOR
// dem Uebertragen herankommt -- genau das, was DESIGN-2 in wlib
// vermisst hat und was hier, im Server, selbstverstaendlich ist.
//
// Der Rahmen wird dabei NICHT mitgemalt: ein Rahmen, der mitskaliert,
// hat an jeder Kante eine andere Strichstaerke und sieht nach Fehler
// aus. Gemalt wird die Flaeche, mittig um denselben Punkt, um den auch
// das fertige Fenster steht.
// ====================================================== RUNDE ZIEH
//
// DAS AUFHEBEN BEIM VERSCHIEBEN -- DREI WIRKUNGEN, EINZELN SCHALTBAR.
//
// Justins Wunsch, woertlich: beim Ziehen eines Fensters wird es leicht
// groesser ("als wuerde man es aufheben"), der Pivot liegt an der
// angefassten Stelle statt in der Mitte, und es schwingt mit Traegheit
// um diesen Punkt und pendelt beim Absetzen aus -- nur beim
// Verschieben, nicht sonst.
//
// WAS DIESER SERVER NICHT KANN, UND WARUM DAS HIER SO STEHT. Eine
// echte Kipp-Transformation braucht je Zielbildpunkt eine Ruecktrans-
// formation mit Sinus und Kosinus. Dieser Kernel rettet in `syscall`
// kein SSE (siehe `ease_out`), rechnet also ganzzahlig, und die
// Abtastung in `paint_win_anim` ist eine Nachbarabtastung ueber
// Zeilen. Eine gedrehte Flaeche waere damit eine Treppe aus
// Rechtecken. Die Vorrunde hat das schon festgestellt, und die
// Naeherung, die stattdessen hier steht, ist:
//
//   VERSATZ + SKALIERUNG UM EINEN VERSCHOBENEN PIVOT.
//
// Das Fenster waechst um FM_LIFT, und der Punkt, der dabei STEHEN
// BLEIBT, ist nicht die Mitte, sondern (bei FM_TILT = 100) die Stelle
// unter dem Zeiger. Genau das ist die Wahrnehmung "ich habe es an
// dieser Ecke angefasst": fasst man unten rechts an, waechst das
// Fenster nach oben links weg. Der Nachzug (FM_SWING) legt einen
// Versatz gegen die Bewegungsrichtung darueber, und beim Loslassen
// laeuft dieser Versatz gegen null -- das ist das Auspendeln.
//
// DIE WAHRE LAGE DES FENSTERS BLEIBT UNBERUEHRT. W_X/W_Y folgen dem
// Zeiger ohne Verzoegerung; nur das BILD haengt hinterher. Ein
// Fenster, dessen Ablegepunkt von einer Feder abhaengt, ist ein
// Fenster, das man nicht mehr trifft -- und `drag_hover` (die
// Andockvorschau) rechnet ohnehin mit der wahren Lage.

// Ist das Fenster gerade dasjenige, das am Zeiger haengt?
fn is_dragged(state: u64, i: u64) -> bool {
    return gs(state, S_DRAG) == i + 1
}

// DIE VORFUEHRUNG FASST AN UND LAESST LOS -- ueber dieselben zwei
// Wege wie der Zeiger.
//
// Sie stehen hier und nicht in `kgui.fi`, weil `S_DRAG`, `S_DRAGX`
// und `S_DRAGY` diesem Modul gehoeren. Ein zweiter Ort, der sie
// setzt, waere ein zweiter Ort, an dem der Zustand des Ziehens
// falsch sein kann -- und genau daran ist die Oeffnungsbewegung des
// Startmenues in der vorigen Runde gescheitert.
// Die wahre Lage, oeffentlich -- fuer die Vorfuehrung, die sie in
// die serielle Leitung schreibt. `win_x`/`win_y` sind modulintern.
fn win_x_pub(state: u64, i: u64) -> i64 {
    return win_x(state, i)
}

fn win_y_pub(state: u64, i: u64) -> i64 {
    return win_y(state, i)
}

fn drag_begin_pub(state: u64, i: u64, gx: u64, gy: u64) {
    if !valid(state, i) {
        return
    }
    drag_begin(state, i)
    ss(state, S_DRAG, i + 1)
    ss(state, S_DRAGX, gx)
    ss(state, S_DRAGY, gy)
}

fn drag_end_pub(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    ss(state, S_DRAG, 0)
    drag_end(state, i, win_x(state, i), win_y(state, i))
}

// Die drei Schalter. Jeder ist zugleich seine Staerke; 0 heisst aus.
// Sie fragen ZUERST `anim_off`: wer "Animationen reduzieren" gesetzt
// hat, hat damit auch das hier gemeint, und zwei Stellen, an denen man
// Bewegung abschaltet, sind eine zu viel.
fn drag_lift_on(state: u64) -> u64 {
    if anim_off(state) {
        return 0
    }
    return form(state, FM_LIFT)
}

fn drag_tilt_on(state: u64) -> u64 {
    if anim_off(state) {
        return 0
    }
    return form(state, FM_TILT)
}

fn drag_swing_on(state: u64) -> u64 {
    if anim_off(state) {
        return 0
    }
    return form(state, FM_SWING)
}

// Die Skalierung, mit der ein gezogenes Fenster gemalt wird, in
// Tausendsteln. 1000 heisst unveraendert -- und dann malt der
// gewoehnliche Weg, ohne einen Bildpunkt Mehrkosten.
fn drag_scale(state: u64, i: u64) -> u64 {
    if !is_dragged(state, i) {
        return 1000
    }
    return 1000 + drag_lift_on(state)
}

// Wie viele Bildpunkte das Fenster durch das Aufheben breiter wird.
// Nur fuer die Messung und fuer `damage`: wer groesser malt, muss auch
// groesser schmutzig melden, sonst bleibt ein Rand stehen.
fn lift_px(state: u64, i: u64) -> i64 {
    let sk: u64 = drag_scale(state, i)
    if sk <= 1000 {
        return 0
    }
    let w: i64 = outer_w(state, i) as i64
    let h: i64 = outer_h(state, i) as i64
    let dw: i64 = w * (sk - 1000) as i64 / 1000
    let dh: i64 = h * (sk - 1000) as i64 / 1000
    return imax(dw, dh) + 1
}

// Der Nachzug, vorzeichenbehaftet gelesen.
fn swing_dx(state: u64, i: u64) -> i64 {
    return wg(state, i, W_SWX) as i64
}

fn swing_dy(state: u64, i: u64) -> i64 {
    return wg(state, i, W_SWY) as i64
}

// EIN TICK DES NACHZUGS, und er gehoert in denselben Zeitgeber wie
// `anim_tick` -- aus dem Grund, den Runde VSYNC schon aufgeschrieben
// hat: eine Bewegung, die im Zeichnen tickt, laeuft auf einer
// langsamen Maschine langsamer.
//
// Er macht zwei Dinge. Haengt das Fenster am Zeiger, waechst der
// Versatz mit der Geschwindigkeit (die Differenz der Lage seit dem
// letzten Tick) -- das ist die Traegheit. Haengt es nicht mehr, faellt
// der Versatz je Tick um SWING_DECAY Tausendstel gegen null -- das ist
// das Auspendeln. Beides ist am Deckel SWING_MAX_PX abgeschnitten.
// DAS ABKLINGEN, UND WARUM ES MINDESTENS EINEN BILDPUNKT NIMMT.
//
// `v - v * 250 / 1000` ist ganzzahlig und rundet zur Null: bei v = -3
// ist -3 * 250 / 1000 = 0, und dann bleibt -3 stehen, Tick fuer Tick.
// GEMESSEN an einem Fenster, das am Haken stillstand: von t=105 bis
// t=190 durchgehend sx=-3. Das Bild stand dauerhaft drei Bildpunkte
// neben dem Fenster -- das ist keine Traegheit mehr, sondern ein
// Versatz, der nie zurueckkommt.
//
// Also: ist der Abzug null, aber der Wert nicht, wird EIN Bildpunkt
// abgezogen. Damit erreicht jeder Wert die Null in endlich vielen
// Ticks, und das Auspendeln hat ein Ende statt eines Restes.
fn abklingen(v: i64) -> i64 {
    if v == 0 {
        return 0
    }
    let ab: i64 = v * SWING_DECAY as i64 / 1000
    if ab == 0 {
        if v > 0 {
            return v - 1
        }
        return v + 1
    }
    return v - ab
}

fn swing_tick_win(state: u64, i: u64) -> bool {
    let st: u64 = drag_swing_on(state)
    let x: i64 = win_x(state, i)
    let y: i64 = win_y(state, i)
    var sx: i64 = swing_dx(state, i)
    var sy: i64 = swing_dy(state, i)
    if st == 0 {
        // Abgeschaltet: ein etwa stehengebliebener Versatz wird EINMAL
        // geraeumt, damit kein Fenster mit schiefem Bild zurueckbleibt.
        wsv(state, i, W_DXLAST, x as u64)
        wsv(state, i, W_DYLAST, y as u64)
        if sx == 0 && sy == 0 {
            return false
        }
        wsv(state, i, W_SWX, 0)
        wsv(state, i, W_SWY, 0)
        wsv(state, i, W_SWOFF, 0)
        damage_win_lift(state, i)
        return true
    }
    if is_dragged(state, i) {
        // DIE GESCHWINDIGKEIT FAELLT AUS DER LAGE, nicht aus dem
        // Zeigerweg: `move_win` kann zwischen zwei Ticks mehrmals
        // gelaufen sein, und was das Bild nachziehen soll, ist die
        // Strecke, die das Fenster in DIESER Zeit zurueckgelegt hat.
        let vx: i64 = x - wg(state, i, W_DXLAST) as i64
        let vy: i64 = y - wg(state, i, W_DYLAST) as i64
        // Der Versatz zeigt GEGEN die Bewegung -- das Bild bleibt
        // zurueck. `st` ist die Staerke in Prozent.
        sx = sx - vx * st as i64 / 100
        sy = sy - vy * st as i64 / 100
        // und er laesst zugleich nach, sonst summiert sich ein langer
        // Zug zu einem Bild, das gar nicht mehr zurueckfindet.
        sx = abklingen(sx)
        sy = abklingen(sy)
        // ================================== GEMESSEN UND BEHOBEN
        // DER VERSATZ BLIEB BEI -3 STEHEN, SOLANGE DAS FENSTER HING.
        //
        // Ganzzahlig ist -3 * 250 / 1000 = 0 (Firn rundet zur Null),
        // also sx = -3 - 0 = -3, Tick fuer Tick. Gemessen an einem
        // Fenster, das am Haken STILLSTAND: t=105 bis t=190 alle
        // sx=-3. Das Bild stand damit dauerhaft drei Bildpunkte
        // neben dem Fenster -- keine Traegheit mehr, nur noch ein
        // Versatz, der nie zurueckkommt.
        //
        // Dieselbe Wache wie im Zweig "losgelassen", und aus
        // demselben Grund: unter zwei Bildpunkten ist es kein
        // Nachzug mehr, sondern eine Zahl, die nie null wird.
        // Sie steht HIER und nicht nur dort, weil ein Fenster auch
        // am Haken stillstehen kann -- und dann ist der Nachzug
        // fertig, obwohl noch niemand losgelassen hat.
        if vx == 0 && sx < 2 && sx > -2 {
            sx = 0
        }
        if vy == 0 && sy < 2 && sy > -2 {
            sy = 0
        }
    } else {
        if wg(state, i, W_SWOFF) == 0 && sx == 0 && sy == 0 {
            wsv(state, i, W_DXLAST, x as u64)
            wsv(state, i, W_DYLAST, y as u64)
            return false
        }
        sx = abklingen(sx)
        sy = abklingen(sy)
        // Unter einem Bildpunkt ist es kein Nachzug mehr, sondern eine
        // Zahl, die nie null wird: ganzzahlig geteilt bleibt 1 bei 1.
        if sx < 2 && sx > -2 {
            sx = 0
        }
        if sy < 2 && sy > -2 {
            sy = 0
        }
        if sx == 0 && sy == 0 {
            wsv(state, i, W_SWOFF, 0)
        }
    }
    sx = imin(imax(sx, 0 - SWING_MAX_PX), SWING_MAX_PX)
    sy = imin(imax(sy, 0 - SWING_MAX_PX), SWING_MAX_PX)
    let alt_x: i64 = swing_dx(state, i)
    let alt_y: i64 = swing_dy(state, i)
    wsv(state, i, W_SWX, sx as u64)
    wsv(state, i, W_SWY, sy as u64)
    wsv(state, i, W_DXLAST, x as u64)
    wsv(state, i, W_DYLAST, y as u64)
    if sx != alt_x || sy != alt_y {
        damage_win_lift(state, i)
        return true
    }
    return false
}

// Der Nachzug aller Fenster. Gibt zurueck, wie viele noch pendeln --
// dieselbe Auskunft wie `anim_tick`, damit der Ring weiss, ob er
// weiterzeichnen muss.
fn swing_tick(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    var offen: u64 = 0
    var i: u64 = 0
    while i < MAX_WIN {
        if valid(state, i) {
            if swing_tick_win(state, i) {
                offen = offen + 1
                ss(state, S_SWINGS, gs(state, S_SWINGS) + 1)
            }
        }
        i = i + 1
    }
    return offen
}

// Ein gezogenes Fenster ist GROESSER als seine Fenstertafel sagt und
// steht um den Nachzug versetzt. Wer es schmutzig meldet, muss beides
// mitmelden -- sonst bleibt beim naechsten Bild ein Rand des alten
// Bildes stehen.
fn damage_win_lift(state: u64, i: u64) {
    let extra: i64 = lift_px(state, i) + SWING_MAX_PX
    let wx: i64 = win_x(state, i)
    let wy: i64 = win_y(state, i)
    let ow: i64 = outer_w(state, i) as i64
    let oh: i64 = outer_h(state, i) as i64
    damage(state, wx - extra, wy - extra, wx + ow + extra, wy + oh + extra)
}

// Wird dieses Fenster gerade AUFGEHOBEN gemalt? Nur dann laeuft der
// teure Weg. Die Frage ist absichtlich eine einzige Funktion: sie
// steht in `paint_win` (welcher Weg) und in der Messung (was hat es
// gekostet), und zwei Fassungen davon waeren zwei Antworten.
fn drag_paint_on(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if is_dragged(state, i) {
        return drag_lift_on(state) != 0 || drag_swing_on(state) != 0
    }
    // Losgelassen, aber noch am Auspendeln.
    return swing_dx(state, i) != 0 || swing_dy(state, i) != 0
}

// W-DRAG: THE FRAME, THE TITLE BAR AND THE CAPTION BUTTONS OF A LIFTED WINDOW.
//
// `paint_win_drag` copies only the client area, so a dragged window lost its frame, its title bar and its caption buttons for the whole
// drag and the swing after the release (Justin, Dell 3440x1440, scale 2: "the title bar disappears while I drag"). The old comment said
// nobody needs the bar for half a second -- but the bar is the thing the user HOLDS. It is painted here with the geometry of the lifted
// client rectangle: same height as always (a bar scaled by 105 percent would be a blurred edge), as wide as the lifted client plus the frame.
// `late` = the second call, after the client area: the caption buttons of a window that paints its own strip lie over the strip.
fn paint_drag_chrome(state: u64, i: u64, wx: i64, wy: i64, ow: i64, oh: i64, cx0: i64, cy0: i64, cx1: i64, cy1: i64, late: bool) {
    if !deko(state, i) || fb.nodragbar_an(state) {
        return
    }
    let ax0: i64 = imax(wx, cx0)
    let ay0: i64 = imax(wy, cy0)
    let ax1: i64 = imin(wx + ow, cx1)
    let ay1: i64 = imin(wy + oh, cy1)
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    let aktiv: bool = focus(state) == i
    var rahmen: u64 = deco(state, DK_FRAME)
    var titel: u64 = deco(state, DK_TITLE)
    var schrift: u64 = deco(state, DK_TEXT)
    if aktiv {
        rahmen = deco(state, DK_FRAME_ON)
        titel = deco(state, DK_TITLE_ON)
        schrift = deco(state, DK_TEXT_ON)
    }
    let capc: bool = cap_client(state, i)
    if late {
        if capc {
            if form(state, FM_CAPTION) != 0 {
                paint_caption(state, i, wx, wy, ow, titel, schrift, ax0, ay0, ax1, ay1)
            } else {
                paint_close_classic(state, wx, wy, ow, ax0, ay0, ax1, ay1)
            }
        }
        return
    }
    // The frame colour only where the client area will NOT cover it: four bands (top with the bar, bottom, left, right) through the same
    // rounded fill with a narrower clip each. A fill of the whole outer rectangle cost +0.5 ms a frame in stationaer.sh phase 5.
    let ry: i64 = wy + iny(state, i) as i64
    let rb: i64 = wy + oh - border(state) as i64
    let rl: i64 = wx + border(state) as i64
    let rr: i64 = wx + ow - border(state) as i64
    let rad: u64 = form(state, FM_RADIUS)
    let dal: u64 = deco_alpha(state)
    if imin(cy1, ry) > cy0 {
        fill_round(state, wx, wy, ow, oh, rad, rahmen, dal, cx0, cy0, cx1, imin(cy1, ry))
    }
    if cy1 > imax(cy0, rb) {
        fill_round(state, wx, wy, ow, oh, rad, rahmen, dal, cx0, imax(cy0, rb), cx1, cy1)
    }
    if imin(cy1, rb) > imax(cy0, ry) {
        if imin(cx1, rl) > cx0 {
            fill_round(state, wx, wy, ow, oh, rad, rahmen, dal, cx0, imax(cy0, ry), imin(cx1, rl), imin(cy1, rb))
        }
        if cx1 > imax(cx0, rr) {
            fill_round(state, wx, wy, ow, oh, rad, rahmen, dal, imax(cx0, rr), imax(cy0, ry), cx1, imin(cy1, rb))
        }
    }
    if !capc {
        paint_title(state, i, wx, wy, ow, titel, schrift, ax0, ay0, ax1, ay1)
    }
    var bx: i64 = wx + ow - border(state) as i64 - close_w(state) as i64 - 3
    if form(state, FM_CAPTION) != 0 {
        bx = wx + ow - border(state) as i64 - (CAP_N * cap_w(state)) as i64
        if !capc {
            paint_caption(state, i, wx, wy, ow, titel, schrift, ax0, ay0, ax1, ay1)
        }
    } else if !capc {
        paint_close_classic(state, wx, wy, ow, ax0, ay0, ax1, ay1)
    }
    var before: i64 = 0
    let sicht: u64 = netview.view_of(state, win_owner(state, i))
    if sicht != netview.V_REAL && sicht <= 3 && !capc {
        title_mark(state, sicht - 1, wx + border(state) as i64 + title_pad(state) as i64,
            wy + border(state) as i64 + ((title_h(state) - border(state) - netmark.H) / 2) as i64,
            schrift, ax0, ay0, ax1, ay1)
        before = netmark.W as i64 + 4
    }
    let f: u64 = gs(state, S_FONT_UI)
    if f < ttf.MAX_FONTS && !capc {
        title_text(state, i, f, wx + border(state) as i64 + title_pad(state) as i64 + before,
            wy + title_base(state, f), schrift, ax0, ay0, ax1, ay1, bx)
    }
}

// DAS GEZOGENE FENSTER MALEN -- Versatz und Skalierung um einen
// verschobenen Pivot.
//
// Der Pivot: bei FM_TILT = 0 die Mitte (das Fenster waechst
// gleichmaessig nach allen Seiten), bei 100 die angefasste Stelle. Sie
// steht in S_DRAGX/S_DRAGY, gesetzt beim Anfassen, relativ zur
// AUSSENecke des Fensters -- genau die Zahl, die dieser Rechenweg
// braucht, und sie liegt schon da.
fn paint_win_drag(state: u64, i: u64, cx0: i64, cy0: i64, cx1: i64,
    cy1: i64) {
    let bw: i64 = wg(state, i, W_W) as i64
    let bh: i64 = wg(state, i, W_H) as i64
    if bw <= 0 || bh <= 0 {
        return
    }
    let sk: u64 = drag_scale(state, i)
    var nw: i64 = bw * sk as i64 / 1000
    var nh: i64 = bh * sk as i64 / 1000
    if nw <= 0 || nh <= 0 {
        return
    }
    // Die Malflaeche, wie sie ohne alles laege.
    let ix: i64 = win_x(state, i) + border(state) as i64
    let iy: i64 = win_y(state, i) + iny(state, i) as i64
    // DER PIVOT. `ax`/`ay` ist die angefasste Stelle INNERHALB der
    // Malflaeche; `tl` mischt zwischen Mitte (0) und ihr (100).
    let tl: i64 = drag_tilt_on(state) as i64
    var ax: i64 = bw / 2
    var ay: i64 = bh / 2
    if is_dragged(state, i) {
        let gx: i64 = gs(state, S_DRAGX) as i64 - border(state) as i64
        let gy: i64 = gs(state, S_DRAGY) as i64 - iny(state, i) as i64
        // Ausserhalb der Flaeche angefasst (Titelleiste, Rahmen) wird
        // auf sie geklemmt: ein Pivot ausserhalb des Bildes laesst die
        // Flaeche wegdriften statt wachsen.
        let px: i64 = imin(imax(gx, 0), bw)
        let py: i64 = imin(imax(gy, 0), bh)
        ax = bw / 2 + (px - bw / 2) * tl / 100
        ay = bh / 2 + (py - bh / 2) * tl / 100
    }
    // Um den Pivot skalieren heisst: der Punkt `a` liegt nachher dort,
    // wo er vorher lag. Alles andere waechst von ihm weg.
    var ox: i64 = ix + ax - ax * nw / bw
    var oy: i64 = iy + ay - ay * nh / bh
    // und der Nachzug legt sich darueber.
    ox = ox + swing_dx(state, i)
    oy = oy + swing_dy(state, i)
    // W-DRAG: the frame, title bar and caption buttons go with the lifted window (the client rectangle is the anchor)
    let fr_x: i64 = ox - border(state) as i64
    let fr_y: i64 = oy - iny(state, i) as i64
    let fr_w: i64 = nw + 2 * border(state) as i64
    let fr_h: i64 = nh + iny(state, i) as i64 + border(state) as i64
    paint_drag_chrome(state, i, fr_x, fr_y, fr_w, fr_h, cx0, cy0, cx1, cy1, false)
    let ax0: i64 = imax(ox, cx0)
    let ay0: i64 = imax(oy, cy0)
    let ax1: i64 = imin(ox + nw, cx1)
    let ay1: i64 = imin(oy + nh, cy1)
    if ax1 <= ax0 || ay1 <= ay0 {
        paint_drag_chrome(state, i, fr_x, fr_y, fr_w, fr_h, cx0, cy0, cx1, cy1, true)
        return
    }
    let buf: u64 = wg(state, i, W_BUF)
    let stride: u64 = wg(state, i, W_W)
    // KEINE DECKUNGSMISCHUNG. Ein gezogenes Fenster ist undurchsichtig
    // -- es wird aufgehoben, nicht eingeblendet --, und `pixel` ohne
    // Mischung ist der Weg, auf dem die 0,18 ms der Kostenmessung
    // gemessen sind.
    // r460: ROW BY ROW, NO CALL PER PIXEL. The first version called `fb.pixel` for every pixel (five state reads and three
    // compares each) and divided twice per pixel -- 15 ms for a 860x580 window. Now the clip is cut once, the row start is
    // one address, and the source column steps with an integer remainder (`sx = (x - ox) * bw / nw` exactly, so the picture
    // is the same pixel for pixel; `tools/wm` compares it).
    let sw: i64 = fb.width(state) as i64
    let shh: i64 = fb.height(state) as i64
    var cl0: i64 = imax(ax0, 0)
    var cl1: i64 = imin(ax1, sw)
    var ct0: i64 = imax(ay0, fb.band_lo(state) as i64)
    var ct1: i64 = imin(ay1, shh)
    // the source column also has to stay inside the window picture
    if cl0 < ox {
        cl0 = ox
    }
    if cl1 > ox + nw {
        cl1 = ox + nw
    }
    if cl1 > cl0 && ct1 > ct0 {
        let pitch: u64 = fb.pitch(state)
        let dst0: u64 = fb.draw_at(state)
        // the first source column of the row and its remainder: sx = q, rem = (x - ox) * bw - q * nw
        let num0: i64 = (cl0 - ox) * bw
        let q0: i64 = num0 / nw
        let r0: i64 = num0 - q0 * nw
        let qs: i64 = bw / nw
        let rs: i64 = bw - qs * nw
        // r465: the inner loop is assembly (`tools/blur/blurasm.py`, routine d; 752 + 2000 cases in `asmtest.c`). The old Firn loop
        // cost about 10 ns a pixel (stack code, overflow checks); the column test `0 <= q < bw` is gone because the clip above
        // keeps every x in [ox, ox + nw), which makes q = (x - ox) * bw / nw lie in [0, bw).
        var blk: [u64; 8] = [0 as u64; 8]
        blk[2] = (cl1 - cl0) as u64
        blk[3] = q0 as u64
        blk[4] = r0 as u64
        blk[5] = qs as u64
        blk[6] = rs as u64
        blk[7] = nw as u64
        var y: i64 = ct0
        while y < ct1 {
            let sy: i64 = (y - oy) * bh / nh
            if sy >= 0 && sy < bh {
                blk[0] = buf +% (sy as u64) *% stride *% 4
                blk[1] = dst0 +% (y as u64) *% pitch +% (cl0 as u64) *% 4
                asm("mov rdx,rdi\nmov rcx,[rdx+16]\ntest rcx,rcx\njz 0f\nmov rsi,[rdx]\nmov rdi,[rdx+8]\nmov r8,[rdx+24]\nmov r9,[rdx+32]\nmov r10,[rdx+40]\nmov r11,[rdx+48]\n1:\nmov eax,[rsi+r8*4]\nand eax,16777215\nmov [rdi],eax\nadd rdi,4\nadd r8,r10\nadd r9,r11\ncmp r9,[rdx+56]\njl 2f\nsub r9,[rdx+56]\ninc r8\n2:\ndec rcx\njnz 1b\n0:",
                    in("rdi") (&blk[0]) as u64,
                    clobber("rax"),
                    clobber("rcx"),
                    clobber("rdx"),
                    clobber("rsi"),
                    clobber("rdi"),
                    clobber("r8"),
                    clobber("r9"),
                    clobber("r10"),
                    clobber("r11"),
                    clobber("memory"))
            }
            y = y + 1
        }
    }
    paint_drag_chrome(state, i, fr_x, fr_y, fr_w, fr_h, cx0, cy0, cx1, cy1, true)
    wsv(state, i, W_PAINTS, wg(state, i, W_PAINTS) + 1)
    wsv(state, i, W_PX,
        wg(state, i, W_PX) + ((ax1 - ax0) * (ay1 - ay0)) as u64)
    ss(state, S_DRAGPX,
        gs(state, S_DRAGPX) + ((ax1 - ax0) * (ay1 - ay0)) as u64)
    ss(state, S_ZFLAG, 1)
}

fn paint_win_anim(state: u64, i: u64, cx0: i64, cy0: i64, cx1: i64,
    cy1: i64) {
    let p: u64 = anim_mix(state, i)
    // Die Groesse laeuft von AN_SCALE0 nach 1000, die Deckung von 0
    // nach 255. Beide aus DEMSELBEN p -- zwei Kurven waeren zwei
    // Bewegungen, die nur zufaellig zusammen enden.
    let sk: u64 = AN_SCALE0 + (1000 - AN_SCALE0) * p / 1000
    let a: u64 = 255 * p / 1000
    if a == 0 {
        return
    }
    let bw: i64 = wg(state, i, W_W) as i64
    let bh: i64 = wg(state, i, W_H) as i64
    if bw <= 0 || bh <= 0 {
        return
    }
    // Die verkleinerte Flaeche, mittig zur gewachsenen.
    var nw: i64 = bw * sk as i64 / 1000
    var nh: i64 = bh * sk as i64 / 1000
    if nw <= 0 || nh <= 0 {
        return
    }
    // 24.09.2026: THE INNER OFFSET OF THIS WINDOW, not of a decorated
    // one. `border`/`title_h` put every UNDECORATED window (the login
    // screen, the lock screen, the taskbar) one title bar lower and one
    // border further right while it was animating -- and the damage of a
    // blit, which is in the window's real coordinates, then repainted the
    // wrong rows: the text field showed its top eight rows new and the
    // rest old (Dell 9020: "typing is slow, text appears much later").
    let ix: i64 = win_x(state, i) + inx(state, i) as i64
    let iy: i64 = win_y(state, i) + iny(state, i) as i64
    var ox: i64 = ix + (bw - nw) / 2
    var oy: i64 = iy + (bh - nh) / 2
    // ================================================ RUNDE OBERFLAECHE
    // BEIM MINIMIEREN FLIEGT ES ZUM EIGENEN LEISTENKNOPF.
    //
    // Nur beim Minimieren, nur wenn die Taskleiste ein Ziel gesagt hat
    // (`set_min_rect`), und aus DEMSELBEN `p` wie Groesse und Deckung.
    // `p` laeuft beim Minimieren von 1000 nach 0 (anim_mix spiegelt die
    // Kurve), also ist 1000-p der zurueckgelegte Weg: bei p=1000 steht
    // das Fenster noch an seinem Platz, bei p=0 deckt es den Knopf.
    //
    // Die Flaeche wird dabei bis auf die Knopfgroesse gestaucht statt
    // nur auf AN_SCALE0 -- ein Fenster, das in Originalgroesse hinter
    // die Leiste faehrt, sieht aus wie ein Fehler und nicht wie ein
    // Ablegen.
    if wg(state, i, W_ANK) == AN_MIN && min_rect_w(state, i) != 0 {
        let mxy: u64 = wg(state, i, W_MINXY)
        let mwh: u64 = wg(state, i, W_MINWH)
        let tx: i64 = (mxy & 0xFFFFFFFF) as i64
        let ty: i64 = ((mxy >> 32) & 0xFFFFFFFF) as i64
        let tw: i64 = (mwh & 0xFFFFFFFF) as i64
        let th: i64 = ((mwh >> 32) & 0xFFFFFFFF) as i64
        let weg: i64 = (1000 - p) as i64
        // Groesse: von der vollen Flaeche auf die des Knopfes.
        nw = bw + (tw - bw) * weg / 1000
        nh = bh + (th - bh) * weg / 1000
        if nw <= 0 || nh <= 0 {
            return
        }
        // Lage: von der Fensterecke auf die Knopfecke, beide mittig
        // zur jeweiligen Flaeche gerechnet.
        let vx: i64 = ix + (bw - nw) / 2
        let vy: i64 = iy + (bh - nh) / 2
        let zx: i64 = tx + (tw - nw) / 2
        let zy: i64 = ty + (th - nh) / 2
        ox = vx + (zx - vx) * weg / 1000
        oy = vy + (zy - vy) * weg / 1000
    }
    let ax0: i64 = imax(ox, cx0)
    let ay0: i64 = imax(oy, cy0)
    let ax1: i64 = imin(ox + nw, cx1)
    let ay1: i64 = imin(oy + nh, cy1)
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    let buf: u64 = wg(state, i, W_BUF)
    let stride: u64 = wg(state, i, W_W)
    var y: i64 = ay0
    while y < ay1 {
        // Die Quellzeile: Nachbarabtastung. Ein gewichtetes Mittel
        // waere schoener und kostet bei zwoelf Zwischenbildern mehr,
        // als es zeigt -- die Bewegung dauert 120 ms.
        let sy: i64 = (y - oy) * bh / nh
        if sy >= 0 && sy < bh && y >= 0 {
            // r461: the whole row in one call (`fb.scaled_row_a`), not one `pixel_a` and two divisions per pixel
            fb.scaled_row_a(state, y as u64, ax0, ax1, buf +% (sy as u64) *% stride *% 4, ox, bw, nw, a)
        }
        y = y + 1
    }
    wsv(state, i, W_PAINTS, wg(state, i, W_PAINTS) + 1)
    wsv(state, i, W_PX,
        wg(state, i, W_PX) + ((ax1 - ax0) * (ay1 - ay0)) as u64)
}

// =====================================================================
// RUNDE BLUR: DAS ACRYL
// =====================================================================
//
// WAS HIER WIRKLICH DAS PROBLEM WAR -- und es war nicht der Filter.
//
// Der Auftrag nennt als ersten und eigentlichen Umbau "den Hintergrund
// durchreichen": ein Fenster, das durchscheinen will, braucht Lesezugriff
// auf das, was hinter ihm liegt. Beim Nachsehen stellte sich heraus, dass
// dieser Server das SCHON KANN, ohne es zu wissen:
//
//   `compose` malt den Schreibtisch, dann die Fenster VON UNTEN NACH
//   OBEN, alle in den Zweitpuffer (fb, S_DRAW). Wenn ein Fenster an der
//   Reihe ist, steht alles, was unter ihm liegt, dort bereits fertig.
//   `fb.get_pixel` liest genau aus S_DRAW.
//
// Es braucht also KEINEN Mitschnitt des Hintergrunds, keine zweite
// Flaeche und keinen zusaetzlichen Puffer je Fenster -- der Blur liest
// an Ort und Stelle aus dem Zweitpuffer, bevor das Fenster sich darueber
// malt. Das ist der Grund, warum diese Runde am Ende so wenig Speicher
// braucht. Ein Mitschnitt waere die teurere und die falsche Loesung
// gewesen; die billige war schon da.
//
// WAS GEBLURRT WIRD UND WAS NICHT. Die Kostenmessung ist eindeutig
// (BEFUND-BLUR.md, auf dieser Maschine nachgemessen):
//
//     Benachrichtigung  360x120     0,87 ms     5,2 %
//     Taskleiste       1920x48      1,64 ms     9,8 %
//     Startmenue        320x520     3,16 ms    18,9 %
//     ein Fenster       900x650    10,96 ms    65,6 %
//     Vollbild FHD     1920x1080   37,90 ms   227,0 %
//
// Leiste, Startmenue, Menues, Blasen -- ja. GANZE FENSTER NICHT, und
// zwar gar nicht, auch nicht als Wahlmoeglichkeit: ein einziges Fenster
// frisst zwei Drittel des Bildbudgets, und zwei davon reissen es. Die
// Auswahl trifft deshalb nicht der Geschmack, sondern die EBENE des
// Fensters -- `blur_will` unten laesst L_NORMAL strukturell nicht durch.

// Der zweifache Kastenfilter, und warum nicht Gauss.
//
// Zweimal Kasten hintereinander ist eine Dreiecksfunktion, dreimal waere
// schon fast eine Glocke; optisch ist der Unterschied zu einem echten
// Gauss bei diesen Radien nicht zu sehen. Der Preis ist es umso mehr:
// ein Gauss mit Radius r kostet je Bildpunkt 2r+1 Multiplikationen, der
// Kasten mit gleitender Summe kostet EINE Addition und EINE Subtraktion
// -- unabhaengig vom Radius.
//
// Der Kehrwert statt der Division: je Bildpunkt und Durchgang stand eine
// ganzzahlige Division je Kanal, also zwoelf im ganzen Filter. Gemessen
// hat das den Filter um mehr als das Fuenffache verlangsamt (Startmenue
// 15,32 ms gegen 3,16 ms). `RECIP` haelt 1/n als Festkommazahl, und
// `bdiv` rundet im ZAEHLER -- die erste Fassung rundete im Kehrwert und
// lag dadurch um bis zu 16 Helligkeitsstufen daneben, was man als
// Farbstich sah.
fn recip_of(n: u64) -> u64 {
    if n == 0 {
        return 0
    }
    return (((1 as u64) << RECIP_SHIFT) + n - 1) / n
}

// Eine Summe durch ihre Anzahl, exakt. Siehe RECIP_SHIFT.
fn bdiv(summe: u64, rec: u64) -> u64 {
    return (summe *% rec +% RECIP_RUND) >> RECIP_SHIFT
}

// ------------------------------------------------- die beiden Durchgaenge
//
// WAAGRECHT. Eine Zeile, gleitende Summe ueber 2r+1 Bildpunkte. `n`
// waechst am linken Rand und schrumpft am rechten -- deshalb wird der
// Kehrwert je Bildpunkt aus der Tafel geholt und nicht einmal vorab
// gerechnet.
// r464: THE LOOP IS ASSEMBLY NOW. firnc turns every `+` into a load, an add with an overflow check and a store, so this loop cost
// about 60 ns a pixel and one 640 x 416 menu 77 - 105 ms. `tools/blur/blurasm.py` holds the same arithmetic (same reciprocal table
// `rt`, same rounding, same window) in registers; `tools/blur/asmtest.c` compares it with the old Firn loop on random pictures.
// `rt` points at the 40 words `rt[n] = recip_of(n)` that `blur_flaeche` fills once per filter run.
fn blur_h(quelle: u64, ziel: u64, w: u64, h: u64, r: u64, rt: u64, simd: bool) {
    var blk: [u64; 44] = [0 as u64; 44]   // 12 words + 32 words for the caller's vector registers (routine x)
    blk[0] = quelle
    blk[1] = ziel
    blk[2] = w
    blk[3] = h
    blk[4] = r
    blk[5] = rt
    // r481: four rows at a time in SSE2 (routine x; the interrupts stay off for each group of four rows only), the remaining
    // rows (and every row when the vector unit is off, `fbnosimd`) through the scalar routine h. Same pixels: asmtest.c.
    if simd && h >= 4 {
        let done: u64 = h - (h & 3)
        blk[3] = done
        blk[9] = 1
        asm("mov r11,rdi\nmov rax,[r11+24]\nshr rax,2\njz 0f\nmov [r11+24],rax\nmov rax,[r11+16]\ntest rax,rax\njz 0f\nmovdqu [r11+96],xmm0\nmovdqu [r11+112],xmm1\nmovdqu [r11+128],xmm2\nmovdqu [r11+144],xmm3\nmovdqu [r11+160],xmm4\nmovdqu [r11+176],xmm5\nmovdqu [r11+192],xmm6\nmovdqu [r11+208],xmm7\nmovdqu [r11+224],xmm8\nmovdqu [r11+240],xmm9\nmovdqu [r11+256],xmm10\nmovdqu [r11+272],xmm11\nmovdqu [r11+288],xmm12\nmovdqu [r11+304],xmm13\nmovdqu [r11+320],xmm14\nmovdqu [r11+336],xmm15\nmov r8,[r11]\nmov r9,[r11+8]\nmov rcx,[r11+16]\nshl rcx,2\nlea rdx,[rcx+rcx*2]\n1:\nmov rax,[r11+72]\ntest rax,rax\njz 91f\npushfq\ncli\n91:\npxor xmm15,xmm15\nmov eax,4\nmovd xmm10,eax\npshuflw xmm10,xmm10,0\npshufd xmm10,xmm10,0\npcmpeqd xmm11,xmm11\npsrld xmm11,8\npxor xmm0,xmm0\npxor xmm1,xmm1\nxor eax,eax\nmov [r11+56],rax\nmov [r11+64],rax\nmov rsi,r8\nxor r10d,r10d\n2:\ncmp r10,[r11+16]\njae 3f\ncmp r10,[r11+32]\nja 3f\nmovd xmm6,[rsi]\nmovd xmm4,[rsi+rcx]\npunpckldq xmm6,xmm4\nmovd xmm7,[rsi+rcx*2]\nmovd xmm4,[rsi+rdx]\npunpckldq xmm7,xmm4\npunpcklbw xmm6,xmm15\npunpcklbw xmm7,xmm15\npaddw xmm0,xmm6\npaddw xmm1,xmm7\nadd rsi,4\ninc qword ptr [r11+56]\ninc r10\njmp 2b\n3:\nxor r10d,r10d\n4:\nmov rax,[r11+56]\ncmp rax,[r11+64]\nje 5f\nmov [r11+64],rax\nshl rax,3\nadd rax,[r11+40]\nmov rax,[rax]\nmovzx edi,ax\nmovd xmm8,edi\npshuflw xmm8,xmm8,0\npshufd xmm8,xmm8,0\nshr eax,16\nmovd xmm9,eax\npshuflw xmm9,xmm9,0\npshufd xmm9,xmm9,0\n5:\nmovdqa xmm2,xmm0\npmulhuw xmm2,xmm8\nmovdqa xmm4,xmm0\npmullw xmm4,xmm9\npaddw xmm2,xmm4\npaddw xmm2,xmm10\npsrlw xmm2,3\nmovdqa xmm3,xmm1\npmulhuw xmm3,xmm8\nmovdqa xmm5,xmm1\npmullw xmm5,xmm9\npaddw xmm3,xmm5\npaddw xmm3,xmm10\npsrlw xmm3,3\npackuswb xmm2,xmm3\npand xmm2,xmm11\nlea rax,[r9+r10*4]\nmovd [rax],xmm2\npsrldq xmm2,4\nmovd [rax+rcx],xmm2\npsrldq xmm2,4\nmovd [rax+rcx*2],xmm2\npsrldq xmm2,4\nmovd [rax+rdx],xmm2\nmov rax,r10\nadd rax,[r11+32]\ninc rax\ncmp rax,[r11+16]\njae 6f\nlea rsi,[r8+rax*4]\nmovd xmm6,[rsi]\nmovd xmm4,[rsi+rcx]\npunpckldq xmm6,xmm4\nmovd xmm7,[rsi+rcx*2]\nmovd xmm4,[rsi+rdx]\npunpckldq xmm7,xmm4\npunpcklbw xmm6,xmm15\npunpcklbw xmm7,xmm15\npaddw xmm0,xmm6\npaddw xmm1,xmm7\ninc qword ptr [r11+56]\n6:\ncmp r10,[r11+32]\njb 7f\nmov rax,r10\nsub rax,[r11+32]\nlea rsi,[r8+rax*4]\nmovd xmm6,[rsi]\nmovd xmm4,[rsi+rcx]\npunpckldq xmm6,xmm4\nmovd xmm7,[rsi+rcx*2]\nmovd xmm4,[rsi+rdx]\npunpckldq xmm7,xmm4\npunpcklbw xmm6,xmm15\npunpcklbw xmm7,xmm15\npsubw xmm0,xmm6\npsubw xmm1,xmm7\ndec qword ptr [r11+56]\n7:\ninc r10\ncmp r10,[r11+16]\njb 4b\nmov rax,[r11+72]\ntest rax,rax\njz 92f\npopfq\n92:\nmov rax,rcx\nshl rax,2\nadd r8,rax\nadd r9,rax\nmov rax,[r11+24]\ndec rax\nmov [r11+24],rax\njnz 1b\nmovdqu xmm0,[r11+96]\nmovdqu xmm1,[r11+112]\nmovdqu xmm2,[r11+128]\nmovdqu xmm3,[r11+144]\nmovdqu xmm4,[r11+160]\nmovdqu xmm5,[r11+176]\nmovdqu xmm6,[r11+192]\nmovdqu xmm7,[r11+208]\nmovdqu xmm8,[r11+224]\nmovdqu xmm9,[r11+240]\nmovdqu xmm10,[r11+256]\nmovdqu xmm11,[r11+272]\nmovdqu xmm12,[r11+288]\nmovdqu xmm13,[r11+304]\nmovdqu xmm14,[r11+320]\nmovdqu xmm15,[r11+336]\n0:",
            in("rdi") (&blk[0]) as u64,
            clobber("rax"),
            clobber("rcx"),
            clobber("rdx"),
            clobber("rsi"),
            clobber("rdi"),
            clobber("r8"),
            clobber("r9"),
            clobber("r10"),
            clobber("r11"),
            clobber("memory"))
        blk[9] = 0
        blk[0] = quelle +% done *% w *% 4
        blk[1] = ziel +% done *% w *% 4
        blk[2] = w
        blk[3] = h - done
    }
    asm("mov rdx,rdi\nmov rax,[rdx+24]\ntest rax,rax\njz 0f\nmov rax,[rdx+16]\ntest rax,rax\njz 0f\nmov rsi,[rdx]\nmov rdi,[rdx+8]\n1:\nxor r8d,r8d\nxor r9d,r9d\nxor r10d,r10d\n2:\ncmp r10,[rdx+16]\njae 3f\ncmp r10,[rdx+32]\nja 3f\nmov eax,[rsi+r10*4]\nmov ecx,eax\nand ecx,16711935\nand eax,65280\nshl rax,24\nor rax,rcx\nadd r8,rax\ninc r9\ninc r10\njmp 2b\n3:\nxor r10d,r10d\n4:\nmov rcx,[rdx+40]\nmov rcx,[rcx+r9*8]\nmov rax,r8\nmovzx eax,ax\nimul rax,rcx\nadd rax,262144\nshr rax,19\nmov r11,r8\nshr r11,16\nmovzx r11d,r11w\nimul r11,rcx\nadd r11,262144\nshr r11,19\nshl r11d,16\nor eax,r11d\nmov r11,r8\nshr r11,32\nmovzx r11d,r11w\nimul r11,rcx\nadd r11,262144\nshr r11,19\nshl r11d,8\nor eax,r11d\nmov [rdi+r10*4],eax\nmov rax,[rdx+32]\nlea rax,[rax+r10+1]\ncmp rax,[rdx+16]\njae 5f\nmov eax,[rsi+rax*4]\nmov ecx,eax\nand ecx,16711935\nand eax,65280\nshl rax,24\nor rax,rcx\nadd r8,rax\ninc r9\n5:\ncmp r10,[rdx+32]\njb 6f\nmov rax,r10\nsub rax,[rdx+32]\nmov eax,[rsi+rax*4]\nmov ecx,eax\nand ecx,16711935\nand eax,65280\nshl rax,24\nor rax,rcx\nsub r8,rax\ndec r9\n6:\ninc r10\ncmp r10,[rdx+16]\njb 4b\nmov rax,[rdx+16]\nshl rax,2\nadd rsi,rax\nadd rdi,rax\nmov rax,[rdx+24]\ndec rax\nmov [rdx+24],rax\njnz 1b\n0:",
        in("rdi") (&blk[0]) as u64,
        clobber("rax"),
        clobber("rcx"),
        clobber("rdx"),
        clobber("rsi"),
        clobber("rdi"),
        clobber("r8"),
        clobber("r9"),
        clobber("r10"),
        clobber("r11"),
        clobber("memory"))
}

// SENKRECHT -- ABER ZEILENWEISE GELESEN, und das ist der Unterschied
// zwischen tragbar und untragbar.
//
// Die naheliegende Fassung laeuft Spalte fuer Spalte. Zwei Bildpunkte
// untereinander liegen aber w*4 Oktette auseinander, also faellt je
// Bildpunkt eine eigene Cachezeile an. GEMESSEN: das Startmenue kostete
// so 27,88 ms statt 15,32 ms -- 167 Prozent des Bildbudgets statt 92.
// Der Auftrag nannte 11,9 ms; die spaltenweise Fassung haette die Zahl
// also um mehr als das Doppelte verfehlt, ohne dass am Filter etwas
// falsch gewesen waere.
//
// Also: EINE Zeile gleitender Summen (drei Kanaele mal Breite) im
// Speicher halten und das Bild von oben nach unten durchlaufen. Jeder
// Zugriff ist dann fortlaufend.
fn blur_v(state: u64, quelle: u64, ziel: u64, w: u64, h: u64, r: u64, rt: u64, simd: bool) {
    let sum: u64 = gs(state, S_BC_SUM)
    if sum == 0 {
        return
    }
    // r464: assembly, like `blur_h`; the sums of the row are three 16-bit lanes in ONE word per pixel; the row of zeros lies BLUR_W_MAX words (27520 octets) further on, the number is in the asm text; the block has 12 words (7 - 9 scratch, 10 = interrupts off per row, 11 = the row distance in pixels)
    // r481: a multiple of four columns goes through SSE2 (routine w, each output row with the interrupts off), the other columns (and all of them without the vector unit) through the scalar routine v with the same row distance.
    var blk: [u64; 44] = [0 as u64; 44]
    var c4: u64 = 0
    if simd && w >= 4 {
        c4 = w - (w & 3)
        blk[0] = quelle
        blk[1] = ziel
        blk[2] = c4
        blk[3] = h
        blk[4] = r
        blk[5] = rt
        blk[6] = sum
        blk[10] = 1
        blk[11] = w
        asm("mov r11,rdi\nmov rax,[r11+16]\ntest rax,rax\njz 0f\nmov rax,[r11+24]\ntest rax,rax\njz 0f\nmovdqu [r11+96],xmm0\nmovdqu [r11+112],xmm1\nmovdqu [r11+128],xmm2\nmovdqu [r11+144],xmm3\nmovdqu [r11+160],xmm4\nmovdqu [r11+176],xmm5\nmovdqu [r11+192],xmm6\nmovdqu [r11+208],xmm7\nmovdqu [r11+224],xmm8\nmovdqu [r11+240],xmm9\nmovdqu [r11+256],xmm10\nmovdqu [r11+272],xmm11\nmovdqu [r11+288],xmm12\nmovdqu [r11+304],xmm13\nmovdqu [r11+320],xmm14\nmovdqu [r11+336],xmm15\nmov r8,[r11+48]\ncld\nxor eax,eax\nmov rdi,r8\nmov rcx,[r11+16]\nrep stosq\nlea rdi,[r8+27520]\nmov rcx,[r11+16]\nrep stosq\nxor r10d,r10d\nxor r9d,r9d\n1:\ncmp r10,[r11+32]\nja 4f\ncmp r10,[r11+24]\njae 4f\nmov rsi,r10\nimul rsi,[r11+88]\nmov rax,[r11]\nlea rsi,[rax+rsi*4]\nmov rax,[r11+80]\ntest rax,rax\njz 91f\npushfq\ncli\n91:\npxor xmm15,xmm15\nmov rax,r8\nmov rcx,[r11+16]\nshr rcx,2\n2:\nmovdqu xmm4,[rsi]\nmovdqa xmm5,xmm4\npunpcklbw xmm4,xmm15\npunpckhbw xmm5,xmm15\nmovdqu xmm6,[rax]\npaddw xmm6,xmm4\nmovdqu [rax],xmm6\nmovdqu xmm7,[rax+16]\npaddw xmm7,xmm5\nmovdqu [rax+16],xmm7\nadd rsi,16\nadd rax,32\ndec rcx\njnz 2b\nmov rax,[r11+80]\ntest rax,rax\njz 92f\npopfq\n92:\ninc r9\ninc r10\njmp 1b\n4:\nmov [r11+64],r9\nxor eax,eax\nmov [r11+56],rax\n5:\nmov rax,[r11+80]\ntest rax,rax\njz 91f\npushfq\ncli\n91:\npxor xmm15,xmm15\nmov eax,4\nmovd xmm10,eax\npshuflw xmm10,xmm10,0\npshufd xmm10,xmm10,0\npcmpeqd xmm11,xmm11\npsrld xmm11,8\nmov rax,[r11+40]\nmov rcx,[r11+64]\nmov rax,[rax+rcx*8]\nmovzx ecx,ax\nmovd xmm8,ecx\npshuflw xmm8,xmm8,0\npshufd xmm8,xmm8,0\nshr eax,16\nmovd xmm9,eax\npshuflw xmm9,xmm9,0\npshufd xmm9,xmm9,0\nlea rsi,[r8+27520]\nmov rax,[r11+56]\nadd rax,[r11+32]\ninc rax\ncmp rax,[r11+24]\njae 6f\nimul rax,[r11+88]\nmov rsi,[r11]\nlea rsi,[rsi+rax*4]\n6:\nlea rdi,[r8+27520]\nmov rax,[r11+56]\ncmp rax,[r11+32]\njb 7f\nsub rax,[r11+32]\nimul rax,[r11+88]\nmov rdi,[r11]\nlea rdi,[rdi+rax*4]\n7:\nmov rdx,[r11+8]\nmov rax,r8\nmov rcx,[r11+16]\nshr rcx,2\n3:\nmovdqu xmm0,[rax]\nmovdq