    }
}

// ------------------------------------------------ Toenung und Rauschen
//
// DAS RAUSCHEN IST NICHT DIE ZIERDE, SONDERN DER UNTERSCHIED.
//
// Ohne es sieht eine weichgezeichnete Flaeche aus wie Milchglas: zu
// sauber, zu glatt, sie wirkt wie ein Filter und nicht wie ein Material.
// Windows legt deshalb ein feines Korn darueber, und genau das ist der
// Punkt, an dem Acryl anfaengt, nach Acryl auszusehen.
//
// Der Zufall muss dabei ORTSFEST sein -- er haengt an x und y und nicht
// an einem laufenden Zaehler. Sonst flimmert die Flaeche bei jedem Bild
// neu, und aus dem Korn wird Fernsehschnee. Das ist auch der Grund,
// warum der Zwischenspeicher das Rauschen mitkopieren darf: es ist fuer
// dieselbe Stelle immer dasselbe.
fn blur_noise(x: u64, y: u64, amp: u64) -> u64 {
    if amp == 0 {
        return 0
    }
    // Ein billiger, ortsfester Streuwert. Zwei ungerade Primzahlen,
    // gemischt und gefaltet -- kein Zufallsgenerator mit Zustand, denn
    // ein Zustand waere genau das Flimmern, das hier nicht sein darf.
    var v: u64 = x *% 73856093
    v = v ^ (y *% 19349663)
    v = v ^ (v >> 13)
    v = v *% 2654435761
    v = v ^ (v >> 15)
    return v % (amp *% 2 + 1)
}

// Eine Farbe toenen und koernen. `tint` zieht sie in Richtung `ton`,
// `amp` streut sie um bis zu amp Stufen nach oben oder unten.
fn blur_mix(farbe: u64, ton: u64, tint: u64, amp: u64, x: u64,
    y: u64) -> u64 {
    var c: u64 = farbe
    if tint != 0 {
        c = mix24(c, ton, tint)
    }
    if amp == 0 {
        return c
    }
    let d: u64 = blur_noise(x, y, amp)
    // Der Streuwert liegt in 0..2*amp; die Mitte ist amp, und von dort
    // aus geht es nach beiden Seiten. Ohne diese Verschiebung waere das
    // Rauschen eine reine AUFHELLUNG und die Flaeche wuerde milchig.
    var r: u64 = (c >> 16) & 255
    var g: u64 = (c >> 8) & 255
    var b: u64 = c & 255
    if d >= amp {
        let auf: u64 = d - amp
        r = r + auf
        g = g + auf
        b = b + auf
        if r > 255 {
            r = 255
        }
        if g > 255 {
            g = 255
        }
        if b > 255 {
            b = 255
        }
    } else {
        let ab: u64 = amp - d
        if r > ab {
            r = r - ab
        } else {
            r = 0
        }
        if g > ab {
            g = g - ab
        } else {
            g = 0
        }
        if b > ab {
            b = b - ab
        } else {
            b = 0
        }
    }
    return (r << 16) | (g << 8) | b
}

// =====================================================================
// RUNDE BLUR: DER ZWISCHENSPEICHER -- UND DIE UNGUELTIGKEITSERKLAERUNG
// =====================================================================
//
// WARUM ER PFLICHT IST UND NICHT KUER. Ein Startmenue ueber einem
// STEHENDEN Schreibtisch liefert Bild fuer Bild dasselbe Ergebnis. Ohne
// Zwischenspeicher wuerde es sechzig Mal in der Sekunde neu gerechnet:
// 3,16 ms je Bild, dauerhaft, fuer ein Bild, das sich nicht aendert.
// Mit Zwischenspeicher kostet dasselbe 0,02 ms -- gemessen ein Faktor
// von 157. Genau das macht Windows auch, und ohne diesen Teil ist die
// Sache nicht auslieferbar.
//
// DIE SCHWIERIGE FRAGE IST NICHT DAS KOPIEREN, SONDERN DAS VERWERFEN:
// woran erkennt der Server, dass sich UNTER der Flaeche etwas geaendert
// hat? Die naheliegende Antwort -- "wenn das Fenster schmutzig ist" --
// ist FALSCH, und zwar auf beide Seiten:
//
//   Zu oft: die Taskleiste meldet sich bei jedem Uhrenwechsel
//   schmutzig. Der Schreibtisch darunter hat sich dabei nicht geruehrt.
//   Neu zu rechnen waere Verschwendung.
//
//   Zu selten: ein Fenster, das UNTER dem Startmenue verschoben wird,
//   macht das Menue selbst gar nicht schmutzig -- und trotzdem ist der
//   Blur darunter veraltet. Genau das ist der Fall, der flackert bzw.
//   ein eingefrorenes Bild stehen laesst.
//
// Also wird die Frage dort beantwortet, wo sie hingehoert: AM
// SCHMUTZRECHTECK. `damage` ist die eine Stelle, durch die in diesem
// Server jede Aenderung geht. Sie ruft `blur_touch`, und das zaehlt
// `S_BC_GEN` genau dann hoch, wenn das gemeldete Rechteck die
// zwischengespeicherte Flaeche SCHNEIDET. Ein Schmutzrechteck daneben
// laesst sie gueltig.
//
// Gueltig ist der Speicher damit, wenn DREI Dinge stimmen: dasselbe
// Fenster, dasselbe Rechteck, derselbe Zaehler. Sonst wird gerechnet.
// Das ist die ganze Regel, sie hat keinen Sonderfall, und sie kann
// nicht "manchmal" falsch liegen -- sie haengt an derselben Buchfuehrung
// wie das Zeichnen selbst.

// Schneidet das Schmutzrechteck die gespeicherte Flaeche? Dann ist sie
// hin. Aufgerufen aus `damage`, also aus JEDER Aenderungsmeldung.
fn blur_touch(state: u64, x0: i64, y0: i64, x1: i64, y1: i64, skip: u64) {
    if skip == BT_ALL || pixelguard.bug_is(2) {
        return
    }
    // a change made by window `skip - 1` can only spoil the blur of a window ABOVE it: a blur is made from what lies under its
    // window. The window itself and every window below it (lower `W_Z`) keep their blur.
    var skipz: u64 = 0
    var haveskip: bool = false
    if skip != 0 && skip - 1 < MAX_WIN {
        skipz = wg(state, skip - 1, W_Z)
        haveskip = true
    }
    // EIN ZAEHLER JE PLATZ, und nicht einer fuer alle.
    //
    // Ein gemeinsamer Zaehler waere wieder der Fehler, den die vier
    // Plaetze gerade beheben: eine Aenderung unter dem Startmenue
    // haette auch den Speicher der Leiste am anderen Ende des Schirms
    // fuer ungueltig erklaert. Jeder Platz fuehrt deshalb seinen
    // eigenen Stand, und `blur_touch` hebt NUR die Plaetze an, deren
    // Rechteck das gemeldete wirklich schneidet.
    var k: u64 = 0
    while k < BC_N {
        var spoilable: bool = gs(state, S_BC_WIN + k * 8) != 0
        if spoilable && haveskip {
            let sj: u64 = gs(state, S_BC_WIN + k * 8) - 1
            if sj == skip - 1 || (sj < MAX_WIN && wg(state, sj, W_Z) <= skipz) {
                spoilable = false
            }
        }
        if spoilable {
            let bx0: i64 = gs(state, S_BC_X + k * 8) as i64
            let by0: i64 = gs(state, S_BC_Y + k * 8) as i64
            let bx1: i64 = bx0 + gs(state, S_BC_W + k * 8) as i64
            let by1: i64 = by0 + gs(state, S_BC_H + k * 8) as i64
            if x1 > bx0 && x0 < bx1 && y1 > by0 && y0 < by1 {
                ss(state, S_BC_GEN + k * 8, gs(state, S_BC_GEN + k * 8) + 1)
                if fb.phases_an(state) {
                    // r460: who spoiled this blur (the window whose picture it is, the skip code of the damage, the rectangle)
                    var s_bt: [u8; 16] = "wm: btouch win=\0"
                    var s_bk: [u8; 7] = " skip=\0"
                    var s_br: [u8; 7] = " rect=\0"
                    serial.puts((&s_bt[0]) as u64)
                    serial.dec(gs(state, S_BC_WIN + k * 8))
                    serial.puts((&s_bk[0]) as u64)
                    serial.dec(skip)
                    serial.puts((&s_br[0]) as u64)
                    serial.dec(x0 as u64)
                    serial.put(44 as u8)
                    serial.dec(y0 as u64)
                    serial.put(44 as u8)
                    serial.dec(x1 as u64)
                    serial.put(44 as u8)
                    serial.dec(y1 as u64)
                    serial.nl()
                }
            }
        }
        k = k + 1
    }
}

// Der Platz, auf dem dieses Fenster mit diesem Rechteck liegt -- oder
// BC_N, wenn es ihn nicht gibt.
fn blur_slot(state: u64, i: u64, x0: u64, y0: u64, w: u64,
    h: u64) -> u64 {
    var k: u64 = 0
    while k < BC_N {
        if gs(state, S_BC_WIN + k * 8) == i + 1
            && gs(state, S_BC_X + k * 8) == x0
            && gs(state, S_BC_Y + k * 8) == y0
            && gs(state, S_BC_W + k * 8) == w
            && gs(state, S_BC_H + k * 8) == h {
            return k
        }
        k = k + 1
    }
    return BC_N
}

// Ein freier Platz, sonst der naechste im Ring. Reihum und nicht "der
// aelteste": eine Nutzungszaehlung je Platz waere ein zweiter Zustand,
// der auseinander laufen kann, und bei vier Plaetzen fuer hoechstens
// vier gleichzeitig sichtbare Flaechen trifft der Ring ohnehin fast
// immer einen, der gerade nicht gebraucht wird.
fn blur_freier(state: u64) -> u64 {
    var k: u64 = 0
    while k < BC_N {
        if gs(state, S_BC_WIN + k * 8) == 0 {
            return k
        }
        k = k + 1
    }
    let n: u64 = gs(state, S_BC_NEXT) % BC_N
    ss(state, S_BC_NEXT, n + 1)
    return n
}

// Darf dieses Fenster durchscheinen?
//
// DIE EBENE ENTSCHEIDET, NICHT DER GESCHMACK. Leiste (L_TOP),
// Startmenue (L_MENUE), Klapp- und Kontextmenues (L_POPUP) und Blasen
// (L_TIP) -- ja. L_NORMAL und L_DESK NEIN, und das ist keine
// Voreinstellung, sondern eine Struktur: ein Fenster von 900x650 kostet
// 65,6 Prozent des Bildbudgets, zwei davon reissen es, Vollbild liegt
// bei 227 Prozent. Es gibt deshalb auch keinen Schalter dafuer -- was
// man nicht bezahlen kann, bietet man nicht an.
// 24.09.2026: A WINDOW THAT COVERS THE WHOLE SCREEN IS OPAQUE. The login
// and lock screens are undecorated full-screen windows on the top layer,
// and the top layer is where the acrylic of the taskbar lives: they got
// the glass treatment -- blur, grain, and a window alpha below 100 --
// and every repainted strip showed the grain through the login screen.
// Behind a window that covers everything there is nothing to see through
// to, and behind a LOCK screen there must not be.
fn deckt_schirm(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    // Only ABOVE the ordinary windows: the desktop background (L_DESK)
    // keeps whatever the theme gives it.
    let l: u64 = wg(state, i, W_LAYER)
    if l == L_DESK || l == L_NORMAL {
        return false
    }
    return win_x(state, i) <= 0 && win_y(state, i) <= 0
        && wg(state, i, W_W) >= gs(state, S_SW)
        && wg(state, i, W_H) >= gs(state, S_SH)
}

fn blur_will(state: u64, i: u64) -> bool {
    if form(state, FM_BLUR) == 0 {
        return false
    }
    if !valid(state, i) {
        return false
    }
    if deckt_schirm(state, i) {
        return false
    }
    if (wg(state, i, W_FLAGS) & (F_HIDDEN | F_TABBED)) != 0 {
        return false
    }
    let l: u64 = wg(state, i, W_LAYER)
    // L_TOAST steht hier ABSICHTLICH NICHT: die Einblendung bekommt
    // keinen Blur, und die lange Begruendung dazu steht bei `L_TOAST`.
    if l == L_TOP || l == L_MENUE || l == L_POPUP || l == L_TIP {
        return true
    }
    return false
}

// Die Deckung dieses Fensters, 0..255. 255 = vollstaendig deckend.
fn win_opac(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 255
    }
    let v: u64 = wg(state, i, W_OPAC)
    if v == 0 {
        return 255
    }
    return v - 1
}

fn set_opac(state: u64, i: u64, v: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    var w: u64 = v
    if w > 255 {
        w = 255
    }
    wsv(state, i, W_OPAC, w + 1)
    damage_win(state, i)
    return true
}


// ================================================================== W-WINOPTS S4: THE BRIGHTNESS BEHIND A WINDOW
//
// An app that floats over other windows (the Mini) wants its text black on a light background and white on a dark one. The server knows
// what lies behind the window; the app does not. `backlum` measures the 8 x 4 points of the window's outer rectangle on the picture
// of everything BELOW the window in the stacking order (never the window itself, never what lies above): the desktop colour, then
// every visible window bottom up, each mixed in with its own opacity. A point in the frame of a window with decoration takes the
// frame colours; windows that blur are taken as their buffer (the glass key colour), which is the honest limit of this measurement.
// The result is the mean of the LINEAR luminance (Q16, `fui.backlum`) plus the second brightest and the second darkest sample.
//
// Measured only when asked, and only again when something under the window changed: `bl_touch` (called from `damage_ex`, next to
// `blur_touch`, with the same `skip` rule) clears the cache of every window the changed rectangle touches. The window's own contents
// (skip = itself) and the pointer (BT_ALL) never spoil it. The window moving or growing changes the key and measures again.
const BL_MEAN: u64 = 0
const BL_HI: u64 = 1
const BL_LO: u64 = 2
const BL_RUNS: u64 = 3
const BL_HITS: u64 = 4

fn bl_touch(state: u64, x0: i64, y0: i64, x1: i64, y1: i64, skip: u64) {
    if skip == BT_ALL {
        return
    }
    var skipz: u64 = 0
    var haveskip: bool = false
    if skip != 0 && skip - 1 < MAX_WIN {
        skipz = wg(state, skip - 1, W_Z)
        haveskip = true
    }
    var j: u64 = 0
    while j < MAX_WIN {
        if wg(state, j, W_USED) != 0 && wg(state, j, W_BL_MEAN) != 0 {
            var spoil: bool = true
            if haveskip && (j == skip - 1 || wg(state, j, W_Z) <= skipz) {
                spoil = false
            }
            if spoil {
                let bx0: i64 = win_x(state, j)
                let by0: i64 = win_y(state, j)
                let bx1: i64 = bx0 + outer_w(state, j) as i64
                let by1: i64 = by0 + outer_h(state, j) as i64
                if x1 > bx0 && x0 < bx1 && y1 > by0 && y0 < by1 {
                    wsv(state, j, W_BL_MEAN, 0)
                }
            }
        }
        j = j + 1
    }
}

// the colour of ONE point as it looks with everything below window `i` painted (0x00RRGGBB)
fn bl_pixel(state: u64, i: u64, px: i64, py: i64) -> u64 {
    var c: u64 = gs(state, S_DESK) & RGB24
    let zi: u64 = win_z(state, i)
    var z: u64 = 0
    while z < zi {
        let j: u64 = at_z(state, z)
        z = z + 1
        if j >= MAX_WIN || j == i {
            continue
        }
        if (wg(state, j, W_FLAGS) & (F_HIDDEN | F_TABBED)) != 0 || !darf(state, j) {
            continue
        }
        let ox: i64 = win_x(state, j)
        let oy: i64 = win_y(state, j)
        if px < ox || py < oy || px >= ox + outer_w(state, j) as i64 || py >= oy + outer_h(state, j) as i64 {
            continue
        }
        var p: u64 = 0
        let cx: i64 = px - ox - inx(state, j) as i64
        let cy: i64 = py - oy - iny(state, j) as i64
        if cx >= 0 && cy >= 0 && cx < win_w(state, j) as i64 && cy < win_h(state, j) as i64 {
            p = wget(state, j, cx as u64, cy as u64) & RGB24
        } else if cy < 0 || (py - oy) < iny(state, j) as i64 {
            p = deco_rgb(state, DK_TITLE) & RGB24
        } else {
            p = deco_rgb(state, DK_FRAME) & RGB24
        }
        let a: u64 = win_opac(state, j)
        if a >= 255 {
            c = p
        } else {
            let r: u64 = (((c >> 16) & 0xFF) * (255 - a) + ((p >> 16) & 0xFF) * a) / 255
            let g: u64 = (((c >> 8) & 0xFF) * (255 - a) + ((p >> 8) & 0xFF) * a) / 255
            let b: u64 = ((c & 0xFF) * (255 - a) + (p & 0xFF) * a) / 255
            c = (r << 16) | (g << 8) | b
        }
    }
    return c
}

// measure the 8 x 4 points and fill the cache slots of window `i`
fn bl_measure(state: u64, i: u64, x0: i64, y0: i64, w: u64, h: u64) {
    var sum: u64 = 0
    var hi1: u64 = 0
    var hi2: u64 = 0
    var lo1: u64 = 65536
    var lo2: u64 = 65536
    var iy: u64 = 0
    while iy < BL_NY {
        var ix: u64 = 0
        while ix < BL_NX {
            let px: i64 = x0 + ((2 * ix + 1) * w / (2 * BL_NX)) as i64
            let py: i64 = y0 + ((2 * iy + 1) * h / (2 * BL_NY)) as i64
            let l: u64 = backlum.lum_q16(bl_pixel(state, i, px, py))
            sum = sum + l
            if l > hi1 {
                hi2 = hi1
                hi1 = l
            } else if l > hi2 {
                hi2 = l
            }
            if l < lo1 {
                lo2 = lo1
                lo1 = l
            } else if l < lo2 {
                lo2 = l
            }
            ix = ix + 1
        }
        iy = iy + 1
    }
    wsv(state, i, W_BL_MEAN, sum / (BL_NX * BL_NY) + 1)
    wsv(state, i, W_BL_HI, hi2)
    wsv(state, i, W_BL_LO, lo2)
    wsv(state, i, W_BL_RUNS, wg(state, i, W_BL_RUNS) + 1)
}

// What lies behind window `i`. which: BL_MEAN / BL_HI / BL_LO (Q16 linear luminance, 65536 = white), BL_RUNS / BL_HITS (the counters
// of the cache; they never trigger a measurement). 0 for a window that does not exist.
fn backlum(state: u64, i: u64, which: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    if which == BL_RUNS {
        return wg(state, i, W_BL_RUNS)
    }
    if which == BL_HITS {
        return wg(state, i, W_BL_HITS)
    }
    var x0: i64 = win_x(state, i)
    var y0: i64 = win_y(state, i)
    var x1: i64 = x0 + outer_w(state, i) as i64
    var y1: i64 = y0 + outer_h(state, i) as i64
    if x0 < 0 {
        x0 = 0
    }
    if y0 < 0 {
        y0 = 0
    }
    if x1 > gs(state, S_SW) as i64 {
        x1 = gs(state, S_SW) as i64
    }
    if y1 > gs(state, S_SH) as i64 {
        y1 = gs(state, S_SH) as i64
    }
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    let kxy: u64 = (((x0 + 32768) as u64) << 32) | ((y0 + 32768) as u64)
    let kwh: u64 = (((x1 - x0) as u64) << 32) | ((y1 - y0) as u64)
    if wg(state, i, W_BL_MEAN) != 0 && wg(state, i, W_BL_XY) == kxy && wg(state, i, W_BL_WH) == kwh {
        wsv(state, i, W_BL_HITS, wg(state, i, W_BL_HITS) + 1)
    } else {
        bl_measure(state, i, x0, y0, (x1 - x0) as u64, (y1 - y0) as u64)
        wsv(state, i, W_BL_XY, kxy)
        wsv(state, i, W_BL_WH, kwh)
    }
    if which == BL_HI {
        return wg(state, i, W_BL_HI)
    }
    if which == BL_LO {
        return wg(state, i, W_BL_LO)
    }
    return wg(state, i, W_BL_MEAN) - 1
}

// Scheint dieses Fenster durch? Nur dann muss die teurere Zeile her.
fn win_durch(state: u64, i: u64) -> bool {
    return win_opac(state, i) < 255
}

// EINE ZEILE, GEMISCHT statt kopiert.
//
// `fb_row` schiebt die Zeile wortweise in den Zweitpuffer und ist
// damit die schnellste Zeile, die dieser Server hat -- aber sie DECKT.
// Diese hier liest, was schon dasteht (und das ist nach `blur_flaeche`
// genau die weichgezeichnete Flaeche), und mischt die Fensterzeile mit
// `a` darueber. Sie wird NUR gerufen, wenn ein Fenster wirklich
// durchscheinen will; alle anderen gehen weiter den billigen Weg.
fn fb_row_mix(state: u64, x: u64, y: u64, src: u64, n: u64, a: u64) {
    if y < fb.band_lo(state) {
        return
    }
    if a >= 255 {
        fb_row(state, x, y, src, n)
        return
    }
    let ziel: u64 = fb.draw_at(state) +% y *% fb.pitch(state) +% x *% 4
    comp.mix_row(ziel, src, n, a)
}

fn set_blur_cache(state: u64, on: bool) {
    if on {
        ss(state, S_BC_AUS, 0)
    } else {
        ss(state, S_BC_AUS, 1)
    }
}

fn blur_cache_on(state: u64) -> bool {
    return gs(state, S_BC_AUS) == 0
}

fn blur_an(state: u64) -> bool {
    return form(state, FM_BLUR) != 0
}

fn blur_radius(state: u64) -> u64 {
    return form(state, FM_BLUR)
}

// Die Puffer besorgen. Sie kommen aus `mem.frame_run`, genau wie die
// Fensterpuffer -- und EINMAL, nicht je Bild.
fn blur_buffers(state: u64, bytes: u64) -> bool {
    if gs(state, S_BC_SUM) == 0 {
        let sb: u64 = 3 *% BLUR_W_MAX *% 8
        let sr: u64 = (sb + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
        let sp: u64 = mem.frame_run(state, sr)
        if sp == 0 {
            return false
        }
        ss(state, S_BC_SUM, sp)
    }
    // Die Einheit, mit der gerechnet wird: so gross muss EIN Platz
    // sein. Der Puffer fasst BC_N Plaetze PLUS eine Ablage, die sich
    // alle teilen -- die Ablage lebt nur waehrend eines Filterlaufs.
    if gs(state, S_BC_EIN) >= bytes && gs(state, S_BC_BUF) != 0 {
        return true
    }
    if gs(state, S_BC_BUF) != 0 {
        mem.frame_free_run(state, gs(state, S_BC_BUF),
            gs(state, S_BC_BYTES) / mem.FRAME_SIZE)
        ss(state, S_BC_BUF, 0)
        ss(state, S_BC_BYTES, 0)
        blur_leeren(state)
    }
    let seiten: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    let ein: u64 = seiten *% mem.FRAME_SIZE
    let rahmen: u64 = ein *% (BC_N + 1) / mem.FRAME_SIZE
    let bp: u64 = mem.frame_run(state, rahmen)
    if bp == 0 {
        return false
    }
    ss(state, S_BC_BUF, bp)
    ss(state, S_BC_BYTES, rahmen *% mem.FRAME_SIZE)
    ss(state, S_BC_EIN, ein)
    blur_leeren(state)
    return true
}

// Alle Plaetze fuer ungueltig erklaeren. Nach einem Wechsel der
// Puffergroesse zeigen die alten Angaben auf Speicher, der so nicht
// mehr eingeteilt ist -- ein Treffer darauf waere ein Bild aus fremdem
// Speicher.
fn blur_leeren(state: u64) {
    var k: u64 = 0
    while k < BC_N {
        ss(state, S_BC_WIN + k * 8, 0)
        k = k + 1
    }
    ss(state, S_BC_NEXT, 0)
}

// ---------------------------------------------------------------------
// DIE FLAECHE. Das ist die Stelle, an der alles zusammenkommt.
//
// Ablauf: pruefen, ob der Zwischenspeicher passt -> wenn ja, NUR
// kopieren. Sonst: den Hintergrund aus dem Zweitpuffer holen, zweimal
// Kasten darueber, toenen, koernen, ablegen und ausgeben.
// FLICKER FIX (17.10.2026): is the blur of window `i` a cache hit right now (same slot, same rectangle, nothing spoiled it)? The
// rectangle is built exactly as `blur_flaeche` builds it. Then `compose_rect` need not grow a dirty rectangle over the window.
fn blur_hit_ok(state: u64, i: u64) -> bool {
    if gs(state, S_BC_AUS) != 0 {
        return false
    }
    var x0: i64 = win_x(state, i)
    var y0: i64 = win_y(state, i)
    var x1: i64 = x0 + outer_w(state, i) as i64
    var y1: i64 = y0 + outer_h(state, i) as i64
    if x0 < 0 {
        x0 = 0
    }
    if y0 < fb.band_lo(state) as i64 {
        y0 = fb.band_lo(state) as i64
    }
    if x1 > gs(state, S_SW) as i64 {
        x1 = gs(state, S_SW) as i64
    }
    if y1 > gs(state, S_SH) as i64 {
        y1 = gs(state, S_SH) as i64
    }
    if x1 <= x0 || y1 <= y0 {
        return false
    }
    let tr: u64 = blur_slot(state, i, x0 as u64, y0 as u64, (x1 - x0) as u64, (y1 - y0) as u64)
    if tr >= BC_N {
        return false
    }
    return gs(state, S_BC_HIT + tr * 8) == gs(state, S_BC_GEN + tr * 8)
}

// W-S: mixes `pct` percent white into one 0xAARRGGBB pixel (the edge highlight of a blurred surface).
fn rim_mix(c: u64, pct: u64) -> u64 {
    let r: u64 = (((c >> 16) & 255) *% (100 - pct) + 255 *% pct) / 100
    let g: u64 = (((c >> 8) & 255) *% (100 - pct) + 255 *% pct) / 100
    let b: u64 = ((c & 255) *% (100 - pct) + 255 *% pct) / 100
    return (c & 0xFF000000) | (r << 16) | (g << 8) | b
}

fn blur_flaeche(state: u64, i: u64, bx0: i64, by0: i64, bx1: i64,
    by1: i64, ton: u64, kx0: i64, ky0: i64, kx1: i64, ky1: i64) {
    let r: u64 = form(state, FM_BLUR)
    if r == 0 {
        return
    }
    var x0: i64 = bx0
    var y0: i64 = by0
    var x1: i64 = bx1
    var y1: i64 = by1
    if x0 < 0 {
        x0 = 0
    }
    if y0 < fb.band_lo(state) as i64 {
        y0 = fb.band_lo(state) as i64
    }
    if x1 > gs(state, S_SW) as i64 {
        x1 = gs(state, S_SW) as i64
    }
    if y1 > gs(state, S_SH) as i64 {
        y1 = gs(state, S_SH) as i64
    }
    if x1 <= x0 || y1 <= y0 {
        return
    }
    let w: u64 = (x1 - x0) as u64
    let h: u64 = (y1 - y0) as u64
    if w > BLUR_W_MAX {
        return
    }
    let bytes: u64 = w *% h *% 4
    if !blur_buffers(state, bytes) {
        return
    }
    // Die Ablage liegt HINTER den vier Plaetzen und gehoert keinem --
    // sie lebt nur waehrend dieses einen Filterlaufs.
    let ein: u64 = gs(state, S_BC_EIN)
    let a: u64 = gs(state, S_BC_BUF) +% BC_N *% ein
    // ------------------------------------------------ der Treffer
    //
    // Dasselbe Fenster, dasselbe Rechteck, derselbe Schmutzzaehler --
    // dann steht auf dem Platz noch genau das Bild, das hier hingehoert.
    let refm: bool = pixelguard.rendering()
    var tr: u64 = BC_N
    if !refm {
        tr = blur_slot(state, i, x0 as u64, y0 as u64, w, h)
    }
    if tr < BC_N && gs(state, S_BC_AUS) == 0
        && gs(state, S_BC_HIT + tr * 8) == gs(state, S_BC_GEN + tr * 8) {
        let bq: u64 = gs(state, S_BC_BUF) +% tr *% ein
        // FLICKER FIX (17.10.2026): a hit copies ONLY the part inside the clip (the dirty rectangle). The cached picture is the
        // blurred backdrop of the whole window and stays right outside the clip too, but the window's own contents are painted
        // only inside the clip -- so copying more would smear the old picture over the rest of the window. `compose_rect` no
        // longer grows a dirty rectangle over a window whose blur is a cache hit (`blur_hit_ok`).
        var cx0: i64 = x0
        var cy0: i64 = y0
        var cx1: i64 = x1
        var cy1: i64 = y1
        if kx0 > cx0 {
            cx0 = kx0
        }
        if ky0 > cy0 {
            cy0 = ky0
        }
        if kx1 < cx1 {
            cx1 = kx1
        }
        if ky1 < cy1 {
            cy1 = ky1
        }
        if cx1 > cx0 && cy1 > cy0 {
            let cw: u64 = (cx1 - cx0) as u64
            let off: u64 = (cx0 - x0) as u64
            var yy: u64 = (cy0 - y0) as u64
            let ye: u64 = (cy1 - y0) as u64
            while yy < ye {
                fb_row(state, cx0 as u64, y0 as u64 + yy,
                    bq +% yy *% w *% 4 +% off *% 4, cw)
                yy = yy + 1
            }
        }
        ss(state, S_BLURCACHE, gs(state, S_BLURCACHE) + 1)
        return
    }
    // Kein Treffer: entweder gibt es den Platz schon (dann wird er
    // ueberschrieben) oder es braucht einen neuen.
    var sl: u64 = tr
    var b: u64 = 0
    if refm {
        b = pixelguard.blur_scratch(state, bytes)
        if b == 0 {
            return
        }
    } else {
        if sl >= BC_N {
            sl = blur_freier(state)
        }
        b = gs(state, S_BC_BUF) +% sl *% ein
    }
    // ------------------------------------------------ gerechnet
    let t0: u64 = time.tsc()
    // 1. den Hintergrund aus dem ZWEITPUFFER holen. Hier steht schon
    //    alles, was unter diesem Fenster liegt -- der Schreibtisch und
    //    jedes tiefere Fenster. Das ist der "Hintergrund durchreichen"
    //    des Auftrags, und er kostet nichts extra.
    var yy: u64 = 0
    while yy < h {
        let zeile: u64 = (y0 as u64 + yy) *% fb.pitch(state)
        let quelle: u64 = fb.draw_at(state) +% zeile +% x0 as u64 *% 4
        copy_words(a +% yy *% w *% 4, quelle, w *% 4 / 8)
        if (w & 1) != 0 {
            __mmio_write32((a +% yy *% w *% 4 +% (w - 1) *% 4) as *mut u32,
                __mmio_read32((quelle +% (w - 1) *% 4) as *mut u32))
        }
        yy = yy + 1
    }
    // 2. ZWEIMAL Kasten, jedes Mal waagrecht und senkrecht. Zweimal
    //    hintereinander ist optisch fast ein Gauss und kostet einen
    //    Bruchteil.
    var rt: [u64; 40] = [0 as u64; 40]
    var rk: u64 = 1
    while rk < 40 {
        rt[rk as usize] = recip_of(rk)
        rk = rk + 1
    }
    let rtp: u64 = (&rt[0]) as u64
    let simd: bool = fb.simd_ok(state)
    blur_h(a, b, w, h, r, rtp, simd)
    blur_v(state, b, a, w, h, r, rtp, simd)
    blur_h(a, b, w, h, r, rtp, simd)
    blur_v(state, b, a, w, h, r, rtp, simd)
    // 3. Toenung und Rauschen, und dann hinaus. Beides in EINEM
    //    Durchgang ueber die Flaeche -- und in denselben Puffer `b`
    //    geschrieben, aus dem der naechste Treffer kopiert.
    let tint: u64 = form(state, FM_BLURTINT)
    let amp: u64 = form(state, FM_BLURNOISE)
    let rim: u64 = form(state, FM_BLURRIM)
    // r399 (design audit): THE FROSTING FOLLOWS THE ROUNDED SHAPE. The filter
    // ran over the whole outer rectangle, so a window with rounded corners
    // (the start menu, tooltips) showed a grey blurred square behind each
    // corner: the corner pixels outside the arc are transparent, the blurred
    // rectangle shone through them. Pixels outside the corner arc of the
    // window (radius FM_RADIUS, the same number the frame uses) now keep the
    // unblurred picture that is already in the second buffer.
    var crad: u64 = form(state, FM_RADIUS)
    if crad > RADIUS_MAX {
        crad = RADIUS_MAX
    }
    let wl: i64 = bx0
    let wt: i64 = by0
    let wr: i64 = bx1
    let wb: i64 = by1
    // r464: the middle of every row (all of it, except in the corner rows, where only the part between the two corner columns)
    // goes through ONE assembly loop (`tools/blur/blurasm.py`, block M): tint, grain and clamp in registers, 5 - 10 ns a
    // pixel instead of about 120. The few pixels in the corner columns keep the Firn code below: they decide per pixel
    // whether the frosting follows the rounded shape.
    var mblk: [u64; 56] = [0 as u64; 56]   // 24 words + 32 words for the caller's vector registers (routine s)
    var tclip: u64 = tint
    if tclip > 100 {
        tclip = 100
    }
    mblk[5] = amp
    mblk[6] = amp *% 2 + 1
    mblk[7] = 100 - tclip
    mblk[8] = ((ton >> 16) & 255) *% tclip
    mblk[9] = ((ton >> 8) & 255) *% tclip
    mblk[10] = (ton & 255) *% tclip
    // r466: the grain's modulus as a multiplication: block G writes the magic number and the shift for d = 2 * amp + 1 once per blur
    asm("mov r11,rdi\nmov rcx,[r11+48]\ncmp rcx,3\njb 0f\nbsr rcx,rcx\nmov [r11+104],rcx\nmov edx,1\nshl rdx,cl\nxor eax,eax\nmov rsi,[r11+48]\ndiv rsi\nmov rdi,rdx\nadd rax,rax\nadd rdi,rdi\njc 1f\ncmp rdi,rsi\njb 2f\n1:\ninc rax\n2:\ninc rax\nmov [r11+96],rax\n0:",
        in("rdi") (&mblk[0]) as u64,
        clobber("rax"),
        clobber("rcx"),
        clobber("rdx"),
        clobber("rsi"),
        clobber("rdi"),
        clobber("r8"),
        clobber("r9"),
        clobber("r10"),
        clobber("r11"),
        clobber("memory"))
    var ry: u64 = 0
    while ry < h {
        let qz: u64 = a +% ry *% w *% 4
        let zz: u64 = b +% ry *% w *% 4
        let py: i64 = y0 + ry as i64
        var corner_row: bool = false
        var cyc: i64 = 0
        if crad > 0 {
            if py < wt + crad as i64 {
                corner_row = true
                cyc = wt + crad as i64
            } else if py >= wb - crad as i64 {
                corner_row = true
                cyc = wb - crad as i64
            }
        }
        // [ms, me) = the columns that cannot be inside a corner column: the assembly takes them
        var ms: u64 = 0
        var me: u64 = w
        if corner_row {
            let lo: i64 = wl + crad as i64 - x0
            let hi: i64 = wr - crad as i64 - x0
            if hi <= lo || hi <= 0 || lo >= w as i64 {
                ms = 0
                me = 0
            } else {
                if lo > 0 {
                    ms = lo as u64
                }
                if hi < w as i64 {
                    me = hi as u64
                }
            }
        }
        var rx: u64 = 0
        while rx < w {
            if rx == ms && me > ms {
                mblk[0] = qz +% ms *% 4
                mblk[1] = zz +% ms *% 4
                mblk[2] = me - ms
                mblk[3] = x0 as u64 + ms
                mblk[4] = (y0 as u64 + ry) *% 19349663
                // r481: four pixels at a time in SSE2 (routine s: tint + clamp in vector registers, the grain's hash stays scalar), the
                // rest of the run through the scalar routine m below; the interrupts stay off for the run
                if simd {
                    mblk[15] = 1
                    asm("mov r11,rdi\nmov rax,[r11+16]\nshr rax,2\njz 0f\nmovdqu [r11+192],xmm0\nmovdqu [r11+208],xmm1\nmovdqu [r11+224],xmm2\nmovdqu [r11+240],xmm3\nmovdqu [r11+256],xmm4\nmovdqu [r11+272],xmm5\nmovdqu [r11+288],xmm6\nmovdqu [r11+304],xmm7\nmovdqu [r11+320],xmm8\nmovdqu [r11+336],xmm9\nmovdqu [r11+352],xmm10\nmovdqu [r11+368],xmm11\nmovdqu [r11+384],xmm12\nmovdqu [r11+400],xmm13\nmovdqu [r11+416],xmm14\nmovdqu [r11+432],xmm15\nmov rdi,rax\nmov r8,[r11]\nmov r9,[r11+8]\nmov r10,[r11+24]\nmov rax,[r11+120]\ntest rax,rax\njz 91f\npushfq\ncli\n91:\npxor xmm0,xmm0\nmov rax,[r11+56]\nmovd xmm1,eax\npshuflw xmm1,xmm1,0\npshufd xmm1,xmm1,0\nmov rax,[r11+80]\nmov rcx,[r11+72]\nshl rcx,16\nor rax,rcx\nmov rcx,[r11+64]\nshl rcx,32\nor rax,rcx\nmovq xmm2,rax\npunpcklqdq xmm2,xmm2\nmov eax,5243\nmovd xmm3,eax\npshuflw xmm3,xmm3,0\npshufd xmm3,xmm3,0\npcmpeqd xmm4,xmm4\npsrld xmm4,8\nmov rax,[r11+40]\ntest rax,rax\njz 3f\n1:\nmov rcx,r10\nimul rcx,rcx,73856093\nxor rcx,[r11+32]\nmov rdx,rcx\nshr rdx,13\nxor rcx,rdx\nmov rax,2654435761\nimul rcx,rax\nmov rdx,rcx\nshr rdx,15\nxor rcx,rdx\nmov rsi,rcx\nmov rax,[r11+96]\nmul rcx\nmov rax,rsi\nsub rax,rdx\nshr rax,1\nadd rax,rdx\nmov rcx,[r11+104]\nshr rax,cl\nimul rax,[r11+48]\nsub rsi,rax\nsub rsi,[r11+40]\nmovzx esi,si\nmov rax,0x0001000100010001\nimul rsi,rax\nmov [r11+128],rsi\nlea rcx,[r10+1]\nimul rcx,rcx,73856093\nxor rcx,[r11+32]\nmov rdx,rcx\nshr rdx,13\nxor rcx,rdx\nmov rax,2654435761\nimul rcx,rax\nmov rdx,rcx\nshr rdx,15\nxor rcx,rdx\nmov rsi,rcx\nmov rax,[r11+96]\nmul rcx\nmov rax,rsi\nsub rax,rdx\nshr rax,1\nadd rax,rdx\nmov rcx,[r11+104]\nshr rax,cl\nimul rax,[r11+48]\nsub rsi,rax\nsub rsi,[r11+40]\nmovzx esi,si\nmov rax,0x0001000100010001\nimul rsi,rax\nmov [r11+136],rsi\nlea rcx,[r10+2]\nimul rcx,rcx,73856093\nxor rcx,[r11+32]\nmov rdx,rcx\nshr rdx,13\nxor rcx,rdx\nmov rax,2654435761\nimul rcx,rax\nmov rdx,rcx\nshr rdx,15\nxor rcx,rdx\nmov rsi,rcx\nmov rax,[r11+96]\nmul rcx\nmov rax,rsi\nsub rax,rdx\nshr rax,1\nadd rax,rdx\nmov rcx,[r11+104]\nshr rax,cl\nimul rax,[r11+48]\nsub rsi,rax\nsub rsi,[r11+40]\nmovzx esi,si\nmov rax,0x0001000100010001\nimul rsi,rax\nmov [r11+144],rsi\nlea rcx,[r10+3]\nimul rcx,rcx,73856093\nxor rcx,[r11+32]\nmov rdx,rcx\nshr rdx,13\nxor rcx,rdx\nmov rax,2654435761\nimul rcx,rax\nmov rdx,rcx\nshr rdx,15\nxor rcx,rdx\nmov rsi,rcx\nmov rax,[r11+96]\nmul rcx\nmov rax,rsi\nsub rax,rdx\nshr rax,1\nadd rax,rdx\nmov rcx,[r11+104]\nshr rax,cl\nimul rax,[r11+48]\nsub rsi,rax\nsub rsi,[r11+40]\nmovzx esi,si\nmov rax,0x0001000100010001\nimul rsi,rax\nmov [r11+152],rsi\nmovdqu xmm6,[r8]\nmovdqa xmm7,xmm6\npunpcklbw xmm6,xmm0\npunpckhbw xmm7,xmm0\npmullw xmm6,xmm1\npmullw xmm7,xmm1\npaddw xmm6,xmm2\npaddw xmm7,xmm2\npmulhuw xmm6,xmm3\npmulhuw xmm7,xmm3\npsrlw xmm6,3\npsrlw xmm7,3\nmovdqu xmm8,[r11+128]\nmovdqu xmm9,[r11+144]\npaddw xmm6,xmm8\npaddw xmm7,xmm9\npackuswb xmm6,xmm7\npand xmm6,xmm4\nmovdqu [r9],xmm6\nadd r8,16\nadd r9,16\nadd r10,4\ndec rdi\njnz 1b\njmp 4f\n3:\nmovdqu xmm6,[r8]\nmovdqa xmm7,xmm6\npunpcklbw xmm6,xmm0\npunpckhbw xmm7,xmm0\npmullw xmm6,xmm1\npmullw xmm7,xmm1\npaddw xmm6,xmm2\npaddw xmm7,xmm2\npmulhuw xmm6,xmm3\npmulhuw xmm7,xmm3\npsrlw xmm6,3\npsrlw xmm7,3\npackuswb xmm6,xmm7\npand xmm6,xmm4\nmovdqu [r9],xmm6\nadd r8,16\nadd r9,16\nadd r10,4\ndec rdi\njnz 3b\n4:\nmov rax,[r11+120]\ntest rax,rax\njz 92f\npopfq\n92:\nmovdqu xmm0,[r11+192]\nmovdqu xmm1,[r11+208]\nmovdqu xmm2,[r11+224]\nmovdqu xmm3,[r11+240]\nmovdqu xmm4,[r11+256]\nmovdqu xmm5,[r11+272]\nmovdqu xmm6,[r11+288]\nmovdqu xmm7,[r11+304]\nmovdqu xmm8,[r11+320]\nmovdqu xmm9,[r11+336]\nmovdqu xmm10,[r11+352]\nmovdqu xmm11,[r11+368]\nmovdqu xmm12,[r11+384]\nmovdqu xmm13,[r11+400]\nmovdqu xmm14,[r11+416]\nmovdqu xmm15,[r11+432]\nmov [r11],r8\nmov [r11+8],r9\nmov [r11+24],r10\nmov rax,[r11+16]\nand rax,3\nmov [r11+16],rax\n0:",
                        in("rdi") (&mblk[0]) as u64,
                        clobber("rax"),
                        clobber("rcx"),
                        clobber("rdx"),
                        clobber("rsi"),
                        clobber("rdi"),
                        clobber("r8"),
                        clobber("r9"),
                        clobber("r10"),
                        clobber("r11"),
                        clobber("memory"))
                }
                asm("mov r11,rdi\nmov rax,[r11+16]\ntest rax,rax\njz 0f\nmov r8,[r11]\nmov r9,[r11+8]\nmov r10,[r11+24]\n1:\nmov rcx,[r11+40]\ntest rcx,rcx\njz 2f\nmov rcx,r10\nimul rcx,rcx,73856093\nxor rcx,[r11+32]\nmov rdx,rcx\nshr rdx,13\nxor rcx,rdx\nmov rax,2654435761\nimul rcx,rax\nmov rdx,rcx\nshr rdx,15\nxor rcx,rdx\nmov rsi,rcx\nmov rax,[r11+96]\nmul rcx\nmov rax,rsi\nsub rax,rdx\nshr rax,1\nadd rax,rdx\nmov rcx,[r11+104]\nshr rax,cl\nimul rax,[r11+48]\nsub rsi,rax\nsub rsi,[r11+40]\nmov [r11+88],rsi\n2:\nmov eax,[r8]\nmov esi,eax\nshr esi,16\nand esi,255\nmov edi,eax\nshr edi,8\nand edi,255\nmov ecx,eax\nand ecx,255\nimul rsi,[r11+56]\nadd rsi,[r11+64]\nimul rsi,rsi,5243\nshr rsi,19\nimul rdi,[r11+56]\nadd rdi,[r11+72]\nimul rdi,rdi,5243\nshr rdi,19\nimul rcx,[r11+56]\nadd rcx,[r11+80]\nimul rcx,rcx,5243\nshr rcx,19\nmov rdx,[r11+40]\ntest rdx,rdx\njz 3f\nmov rdx,[r11+88]\nadd rsi,rdx\nxor eax,eax\ntest rsi,rsi\ncmovs rsi,rax\nmov eax,255\ncmp rsi,rax\ncmova rsi,rax\nadd rdi,rdx\nxor eax,eax\ntest rdi,rdi\ncmovs rdi,rax\nmov eax,255\ncmp rdi,rax\ncmova rdi,rax\nadd rcx,rdx\nxor eax,eax\ntest rcx,rcx\ncmovs rcx,rax\nmov eax,255\ncmp rcx,rax\ncmova rcx,rax\n3:\nshl rsi,16\nshl rdi,8\nor rsi,rdi\nor rsi,rcx\nmov [r9],esi\nadd r8,4\nadd r9,4\ninc r10\nmov rax,[r11+16]\ndec rax\nmov [r11+16],rax\njnz 1b\n0:",
                    in("rdi") (&mblk[0]) as u64,
                    clobber("rax"),
        clobber("rcx"),
        clobber("rdx"),
        clobber("rsi"),
        clobber("rdi"),
        clobber("r8"),
        clobber("r9"),
        clobber("r10"),
        clobber("r11"),
        clobber("memory"))
                rx = me
            } else {
                let c: u64 = __mmio_read32((qz +% rx *% 4) as *mut u32) as u64
                var keep: bool = false
                if corner_row {
                    let pxx: i64 = x0 + rx as i64
                    var cxc: i64 = 0
                    var in_col: bool = false
                    if pxx < wl + crad as i64 {
                        in_col = true
                        cxc = wl + crad as i64
                    } else if pxx >= wr - crad as i64 {
                        in_col = true
                        cxc = wr - crad as i64
                    }
                    if in_col {
                        let ddx: i64 = 2 * (pxx - cxc) + 1
                        let ddy: i64 = 2 * (py - cyc) + 1
                        let rr2: i64 = 4 * (crad as i64) * (crad as i64)
                        if ddx * ddx + ddy * ddy > rr2 {
                            keep = true
                        }
                    }
                }
                if keep {
                    let orow: u64 = fb.draw_at(state) +% (y0 as u64 + ry) *% fb.pitch(state)
                    let orig: u64 = orow +% (x0 as u64 + rx) *% 4
                    __mmio_write32((zz +% rx *% 4) as *mut u32,
                        __mmio_read32(orig as *mut u32))
                } else {
                    __mmio_write32((zz +% rx *% 4) as *mut u32,
                        blur_mix(c, ton, tint, amp, x0 as u64 + rx,
                            y0 as u64 + ry) as u32)
                }
                rx = rx + 1
            }
        }
        // W-S edge highlight: white is mixed into the outermost top row (between the corner arcs) and the two side columns of the
        // window, inside the cached picture, so a cache hit brings it along.
        if rim > 0 {
            if py == wt {
                var hx: i64 = wl + crad as i64
                while hx < wr - crad as i64 {
                    if hx >= x0 && hx < x1 {
                        let hp: u64 = zz +% (hx - x0) as u64 *% 4
                        __mmio_write32(hp as *mut u32, rim_mix(__mmio_read32(hp as *mut u32) as u64, rim) as u32)
                    }
                    hx = hx + 1
                }
            } else if py > wt + crad as i64 && py < wb - crad as i64 {
                if wl >= x0 && wl < x1 {
                    let hp: u64 = zz +% (wl - x0) as u64 *% 4
                    __mmio_write32(hp as *mut u32, rim_mix(__mmio_read32(hp as *mut u32) as u64, rim) as u32)
                }
                if wr - 1 >= x0 && wr - 1 < x1 {
                    let hp: u64 = zz +% (wr - 1 - x0) as u64 *% 4
                    __mmio_write32(hp as *mut u32, rim_mix(__mmio_read32(hp as *mut u32) as u64, rim) as u32)
                }
            }
        }
        fb_row(state, x0 as u64, y0 as u64 + ry, zz, w)
        ry = ry + 1
    }
    // 4. den Speicher anschreiben -- mit dem Zaehlerstand VON JETZT.
    if refm {
        return
    }
    ss(state, S_BC_WIN + sl * 8, i + 1)
    ss(state, S_BC_X + sl * 8, x0 as u64)
    ss(state, S_BC_Y + sl * 8, y0 as u64)
    ss(state, S_BC_W + sl * 8, w)
    ss(state, S_BC_H + sl * 8, h)
    ss(state, S_BC_HIT + sl * 8, gs(state, S_BC_GEN + sl * 8))
    ss(state, S_BC_STAMP + sl * 8, gs(state, S_FRAME))
    ss(state, S_BLURS, gs(state, S_BLURS) + 1)
    ss(state, S_BLURPX, gs(state, S_BLURPX) + w *% h)
    let kh: u64 = time.khz(state)
    if kh >= 1000 {
        let t1: u64 = time.tsc()
        if t1 > t0 {
            ss(state, S_BLURUS, gs(state, S_BLURUS) + (t1 - t0) / (kh / 1000))
            // r460: one line per computed blur when the kernel word `phases` is on (which window, how big, how long, and why it
            // was not a cache hit: 0 = no slot yet / other rectangle, 1 = the slot's picture was spoiled)
            if fb.phases_an(state) {
                var s_bl: [u8; 15] = "wm: blurrun i=\0"
                var s_bw: [u8; 4] = " w=\0"
                var s_bh: [u8; 4] = " h=\0"
                var s_bu: [u8; 5] = " us=\0"
                var s_bm: [u8; 7] = " miss=\0"
                var s_bs: [u8; 7] = " simd=\0"
                serial.puts((&s_bl[0]) as u64)
                serial.dec(i)
                serial.puts((&s_bw[0]) as u64)
                serial.dec(w)
                serial.puts((&s_bh[0]) as u64)
                serial.dec(h)
                serial.puts((&s_bu[0]) as u64)
                serial.dec((t1 - t0) / (kh / 1000))
                serial.puts((&s_bm[0]) as u64)
                if tr < BC_N {
                    serial.dec(1)
                } else {
                    serial.dec(0)
                }
                serial.puts((&s_bs[0]) as u64)
                if simd {
                    serial.dec(1)
                } else {
                    serial.dec(0)
                }
                serial.nl()
            }
        }
    }
}

// ---------------------------------------------------------- die Ableser
fn blurs(state: u64) -> u64 {
    return gs(state, S_BLURS)
}

fn blur_cached(state: u64) -> u64 {
    return gs(state, S_BLURCACHE)
}

fn blur_px(state: u64) -> u64 {
    return gs(state, S_BLURPX)
}

fn blur_us(state: u64) -> u64 {
    return gs(state, S_BLURUS)
}

fn blur_treffer(state: u64) -> u64 {
    return gs(state, S_BLURCACHE)
}

fn blur_fehl(state: u64) -> u64 {
    return gs(state, S_BLURS)
}

// Die Trefferquote in Prozent -- kopiert von allen Flaechen zusammen.
// Sie steht hier und nicht im Auswerter, weil sie AUS ZWEI Zahlen
// besteht und zwei Zahlen an zwei Stellen auseinander laufen.
fn blur_quote(state: u64) -> u64 {
    let ganz: u64 = gs(state, S_BLURS) + gs(state, S_BLURCACHE)
    if ganz == 0 {
        return 0
    }
    return gs(state, S_BLURCACHE) *% 100 / ganz
}

fn blur_frn(state: u64) -> u64 {
    return gs(state, S_BLURS) + gs(state, S_BLURCACHE)
}

fn blur_frus(state: u64) -> u64 {
    return gs(state, S_BLURUS)
}

fn blur_frmax(state: u64) -> u64 {
    return gs(state, S_BLURPX)
}

fn blur_reset(state: u64) {
    ss(state, S_BLURS, 0)
    ss(state, S_BLURCACHE, 0)
    ss(state, S_BLURPX, 0)
    ss(state, S_BLURUS, 0)
}

// The old red close box of the classic shape (FM_CAPTION = 0): the same loop as before, in a function of its own so that a
// window with a client strip (r454) can paint it AFTER its client area.
fn paint_close_classic(state: u64, wx: i64, wy: i64, ow: i64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let bx: i64 = wx + ow - border(state) as i64 - close_w(state) as i64 - 3
    let by: i64 = wy + 4
    if bx + close_w(state) as i64 > ax0 && bx < ax1
        && by + close_w(state) as i64 > ay0 {
        let rot: u64 = deco(state, DK_CLOSE)
        fb.fill(state, bx as u64, by as u64, close_w(state), close_w(state), rot)
        let weiss: u64 = deco(state, DK_CLOSE_MARK)
        var k: u64 = 3
        while k < close_w(state) - 3 {
            fb.pixel(state, (bx + k as i64) as u64,
                (by + k as i64) as u64, weiss)
            fb.pixel(state, (bx + k as i64) as u64,
                (by + (close_w(state) - 1 - k) as i64) as u64, weiss)
            k = k + 1
        }
    }
}

fn paint_win(state: u64, i: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let wx: i64 = win_x(state, i)
    let wy: i64 = win_y(state, i)
    let ow: i64 = outer_w(state, i) as i64
    let oh: i64 = outer_h(state, i) as i64
    let ax0: i64 = imax(wx, cx0 as i64)
    let ay0: i64 = imax(wy, cy0 as i64)
    let ax1: i64 = imin(wx + ow, cx1 as i64)
    let ay1: i64 = imin(wy + oh, cy1 as i64)
    if ax1 <= ax0 || ay1 <= ay0 {
        // S6a: the clip may lie ONLY in the shadow ring around this window (a repaint of the wallpaper, an icon, a toast next to it): the
        // background was just filled there, so the shadow must be laid over it again, or the ring keeps a hole until the window moves.
        // (Found by `tools/comp/shadow.sh`: the judge saw 1387 pixels of the top strip missing after a repaint.)
        if wg(state, i, W_ANK) == 0 && !drag_paint_on(state, i) && deko(state, i) {
            var rr: i64 = form(state, FM_SHADOW_R) as i64
            let rr2: i64 = form(state, FM_SHADOW_R2) as i64
            if rr2 > rr {
                rr = rr2
            }
            rr = rr + 1
            if rr > 1 && imin(wx + ow + rr, cx1 as i64) > imax(wx - rr, cx0 as i64)
                && imin(wy + oh + rr, cy1 as i64) > imax(wy - rr, cy0 as i64) {
                paint_shadow(state, i, cx0 as i64, cy0 as i64, cx1 as i64, cy1 as i64)
            }
        }
        return
    }
    // RUNDE VSYNC: laeuft eine Oeffnungs- oder Schliessbewegung, wird
    // das Fenster ANDERS gemalt -- skaliert und durchscheinend -- und
    // der gewoehnliche Weg entfaellt vollstaendig.
    if wg(state, i, W_ANK) != 0 {
        paint_win_anim(state, i, cx0 as i64, cy0 as i64, cx1 as i64,
            cy1 as i64)
        return
    }
    // RUNDE ZIEH: wird es gerade aufgehoben (oder pendelt es noch
    // aus), gilt derselbe Vorrang -- skaliert, versetzt, ohne Schmuck.
    // Der Schmuck faellt weg, weil ein mitskalierter Rahmen bei 105
    // Prozent eine unscharfe Kante ist; das Fenster haengt am Zeiger,
    // seine Titelleiste braucht in dieser halben Sekunde niemand.
    if drag_paint_on(state, i) {
        let ph_t: u64 = time.tsc()
        paint_win_drag(state, i, cx0 as i64, cy0 as i64, cx1 as i64,
            cy1 as i64)
        ph_add(state, S_PH_DRAG, ph_t, time.tsc())
        return
    }
    // RUNDE MESSTAFEL: AB HIER WIRD GEMALT. Der Zaehler steht vor der
    // Verzweigung nach `deko`, weil beide Zweige malen -- ein Zaehler je
    // Zweig waere zweimal dieselbe Aussage mit doppelter Fehlerquelle.
    wsv(state, i, W_PAINTS, wg(state, i, W_PAINTS) + 1)
    wsv(state, i, W_PX,
        wg(state, i, W_PX) + ((ax1 - ax0) * (ay1 - ay0)) as u64)
    // ====================================================== RUNDE BLUR
    // DAS ACRYL LIEGT UNTER DEM FENSTER UND UEBER ALLEM, WAS SCHON
    // GEMALT IST -- also genau hier: nach allen tieferen Fenstern und
    // vor der ersten eigenen Fuellung. Dieselbe Stelle, an der Runde
    // PAINT den Schatten einsetzt, und aus demselben Grund.
    //
    // Gemalt wird das AEUSSERE Rechteck des Fensters; was das Fenster
    // danach selbst deckend darueber malt, verdeckt den Blur ohnehin.
    // Sichtbar bleibt er dort, wo die Anwendung durchscheinen laesst --
    // und die Leiste dieses Systems tut das.
    if blur_will(state, i) {
        let ph_t: u64 = time.tsc()
        blur_flaeche(state, i, wx, wy, wx + ow, wy + oh,
            deco(state, DK_TITLE), cx0 as i64, cy0 as i64, cx1 as i64,
            cy1 as i64)
        ph_add(state, S_PH_BLUR, ph_t, time.tsc())
    }
    // OHNE SCHMUCK: kein Rahmen, keine Titelleiste, kein Schliessfeld.
    // Die Flaeche der Anwendung faengt am aeusseren Rechteck an, und der
    // ganze Rest dieser Funktion entfaellt. Ein Schreibtisch mit
    // Titelleiste waere keiner.
    if !deko(state, i) {
        let bx0: i64 = imax(wx, cx0 as i64)
        let by0: i64 = imax(wy, cy0 as i64)
        let bx1: i64 = imin(wx + wg(state, i, W_W) as i64, cx1 as i64)
        let by1: i64 = imin(wy + wg(state, i, W_H) as i64, cy1 as i64)
        if bx1 <= bx0 || by1 <= by0 {
            return
        }
        let bw: u64 = wg(state, i, W_W)
        let bq: u64 = wg(state, i, W_BUF)
        let bn: u64 = (bx1 - bx0) as u64
        // ZUSAMMENFUEHRUNG VON BLUR UND GLAS AN DER EINEN ZEILE, DIE
        // EINEN PUFFER IN DEN ANDEREN KOPIERT.
        //
        // Beide Runden haben genau hier gearbeitet, und beide aus
        // demselben Grund: ein Fenster ohne Schmuck deckte seinen
        // Untergrund bedingungslos zu. BLUR brauchte das, damit die
        // Leiste die Weichzeichnung nicht zudeckt, die sie selbst
        // ausgeloest hat; GLAS brauchte es fuer `taskbar_alpha`.
        //
        // Die Mechanik von GLAS gewinnt, weil sie MEHR kann: sie
        // mischt je Bildpunkt gegen eine Schluesselfarbe und laesst
        // dabei die Textplatte (`PLATTE_MARKE`) deckend stehen. Die
        // Deckung der Runde BLUR (`win_opac`, aus `W_OPAC`) geht nicht
        // verloren -- sie wird als OBERGRENZE eingefaltet: was das
        // Acryl fuer diese Ebene an Durchsicht vorsieht, kann die
        // Glasdeckung nur noch verringern, nie erhoehen.
        let pw: u64 = panel_win(state)
        var alpha: u64 = form_or(state, FM_WIN_ALPHA, 100)
        if pw < MAX_WIN && i == pw {
            alpha = form_or(state, FM_TB_ALPHA, 100)
        }
        // `win_opac` ist 0..255, `alpha` ist 0..100 Prozent. Der
        // kleinere der beiden gewinnt, in Prozent gerechnet.
        let op: u64 = win_opac(state, i)
        if op < 255 {
            let opp: u64 = op *% 100 / 255
            if opp < alpha {
                alpha = opp
            }
        }
        if deckt_schirm(state, i) {
            alpha = 100
        }
        // ============================================ RUNDE DREI (G-006)
        // DER RADIUS GILT AUCH HIER -- und hier war er nie.
        //
        // `nodeco_radius` gibt 0 zurueck, solange die Form eckig ist
        // oder das Fenster den ganzen Schirm bedeckt; dann laeuft diese
        // Schleife Zeile fuer Zeile weiter wie vorher, und
        // `tools/look/run.sh` misst bildpunktgleich dasselbe.
        let rr: u64 = nodeco_radius(state, i)
        let wh: u64 = wg(state, i, W_H)
        if alpha >= 100 {
            var br: i64 = by0
            while br < by1 {
                // Wie weit ist diese Zeile von der naechsten waagrechten
                // Kante entfernt? Nur in den obersten und untersten `r`
                // Zeilen wird ueberhaupt gerundet.
                var dy: u64 = 0xFFFFFFFFFFFFFFFF
                if rr != 0 {
                    let o: u64 = (br - wy) as u64
                    dy = o
                    if wh > o && wh - 1 - o < dy {
                        dy = wh - 1 - o
                    }
                }
                var ein: u64 = 0
                if rr != 0 && dy < rr {
                    ein = rund_einzug(dy, rr)
                }
                let zr: u64 = bq +% (br - wy) as u64 *% bw *% 4
                var xs: i64 = bx0
                var xe: i64 = bx1
                if ein != 0 {
                    xs = imax(bx0, wx + ein as i64)
                    xe = imin(bx1, wx + bw as i64 - ein as i64)
                }
                if xe > xs {
                    fb_row(state, xs as u64, br as u64,
                        zr +% (xs - wx) as u64 *% 4, (xe - xs) as u64)
                }
                if ein != 0 {
                    rund_saum(state, wx, bx0, bx1, bw, br as u64, zr, dy,
                        rr, true)
                    rund_saum(state, wx, bx0, bx1, bw, br as u64, zr, dy,
                        rr, false)
                }
                br = br + 1
            }
            ss(state, S_BLITS, gs(state, S_BLITS) + 1)
            return
        }
        // Das Milchglas gibt es nur unter der Leiste. Unter einem
        // gewoehnlichen Fenster waere es dasselbe Rechnen fuer jedes
        // Fenster in jedem Bild, und der Streifenpuffer ist einer.
        var grund: u64 = 0
        if pw < MAX_WIN && i == pw && form(state, FM_BLUR) > 0 {
            let ph_g: u64 = time.tsc()
            grund = glass_prepare(state, wx, wy, wg(state, i, W_W),
                wg(state, i, W_H), form(state, FM_BLUR))
            ph_add(state, S_PH_GLASS, ph_g, time.tsc())
        }
        let key: u64 = form(state, FM_GLASS_KEY)
        // Die Zaehlung des wirksamen Alphas gilt der LEISTE; siehe
        // `glass_stat_an`.
        let ist_leiste: bool = pw < MAX_WIN && i == pw
        glass_stat_an(ist_leiste)
        // UND DIE LESBARKEITSSCHRANKE GILT FUER BEIDE, ABER NICHT MIT
        // DERSELBEN ZAHL. Ein Fenster ohne Schmuck ist entweder die
        // Leiste (drei Beschriftungen auf leerer Flaeche, 40 Stufen)
        // oder der Schreibtisch bzw. ein Fenster, das seinen Rahmen
        // selbst malt (Schrift von oben bis unten, 20 Stufen).
        var sch: u64 = SCHLEIER_WIN
        if ist_leiste {
            sch = SCHLEIER
        }
        var gr: i64 = by0
        while gr < by1 {
            var zeile: u64 = 0
            if grund != 0 {
                zeile = grund +% ((gr - wy) as u64 *% wg(state, i, W_W)
                    +% (bx0 - wx) as u64) *% 4
            }
            fb_row_a(state, bx0 as u64, gr as u64,
                bq +% (gr - wy) as u64 *% bw *% 4
                +% (bx0 - wx) as u64 *% 4, bn, alpha, key, zeile, sch)
            gr = gr + 1
        }
        glass_stat_an(false)
        // r368: THE ALPHA LINE FROM THE PLACE WHERE THE BAR IS MIXED.
        //
        // `glas_bericht` writes `wm: glas alpha_soll=..` once, at the START of
        // the hold -- before the task bar (a program in ring 3) has placed
        // itself and before one pixel of it was mixed: `alpha_ist=<knob>
        // px=0`. The acceptance runs photograph the machine as soon as
        // `wm: hold` stands and kill it, so a line written later at the end
        // of the hold never reached them, and the questions "did the veil lift
        // the opacity above the knob" (11d3, 11j) read a zero. Now the line is
        // written when the bar has really been mixed: after its first blit and
        // then every 240th; the last one wins.
        if ist_leiste {
            ga_blits = ga_blits + 1
            if ga_blits == 1 || ga_blits % 240 == 0 {
                glas_alpha_say(state)
            }
        }
        ss(state, S_BLITS, gs(state, S_BLITS) + 1)
        return
    }
    let aktiv: bool = focus(state) == i
    var rahmen: u64 = deco(state, DK_FRAME)
    var titel: u64 = deco(state, DK_TITLE)
    var schrift: u64 = deco(state, DK_TEXT)
    if aktiv {
        rahmen = deco(state, DK_FRAME_ON)
        titel = deco(state, DK_TITLE_ON)
        schrift = deco(state, DK_TEXT_ON)
    }
    // RUNDE PAINT: DER SCHATTEN ZUERST. Er liegt unter dem Fenster und
    // ueber allem, was schon gemalt ist -- also genau hier, vor der
    // ersten Fuellung des Rahmens und nach allen tieferen Fenstern.
    let ph_s: u64 = time.tsc()
    paint_shadow(state, i, cx0 as i64, cy0 as i64, cx1 as i64, cy1 as i64)
    ph_add(state, S_PH_SHADOW, ph_s, time.tsc())
    // Der ganze Aussenbereich in Rahmenfarbe, danach die Leiste und die
    // Flaeche darueber. Das ist ein Rechteck mehr als noetig und spart
    // vier Sonderfaelle an den Ecken.
    //
    // RUNDE PAINT: mit `radius_window` als runde Flaeche. Bei Radius 0
    // ist `fill_round` Aufruf fuer Aufruf das alte `fb.fill` auf dem
    // beschnittenen Rechteck -- `shape=classic` malt bildpunktgleich
    // weiter, und tools/look/run.sh misst das.
    let f_bo: i64 = border(state) as i64
    let f_rad: i64 = form(state, FM_RADIUS) as i64
    let f_inny: i64 = iny(state, i) as i64
    let f_full: bool = form_or(state, FM_WIN_ALPHA, 100) >= 100 && wg(state, i, W_W) as i64 == ow - 2 * f_bo
        && f_inny + wg(state, i, W_H) as i64 == oh - f_bo
    if f_full {
        let f_top: i64 = wy + imax(f_inny, f_rad)
        let f_bot: i64 = wy + oh - imax(f_bo, f_rad)
        let f_cx0: i64 = cx0 as i64
        let f_cy0: i64 = cy0 as i64
        let f_cx1: i64 = cx1 as i64
        let f_cy1: i64 = cy1 as i64
        let f_r: u64 = form(state, FM_RADIUS)
        let f_a: u64 = deco_alpha(state)
        if imin(f_cy1, f_top) > f_cy0 {
            fill_round(state, wx, wy, ow, oh, f_r, rahmen, f_a, f_cx0, f_cy0, f_cx1, imin(f_cy1, f_top))
        }
        if f_cy1 > imax(f_cy0, f_bot) {
            fill_round(state, wx, wy, ow, oh, f_r, rahmen, f_a, f_cx0, imax(f_cy0, f_bot), f_cx1, f_cy1)
        }
        let f_my0: i64 = imax(f_cy0, f_top)
        let f_my1: i64 = imin(f_cy1, f_bot)
        if f_my1 > f_my0 {
            if imin(f_cx1, wx + f_bo) > f_cx0 {
                fill_round(state, wx, wy, ow, oh, f_r, rahmen, f_a, f_cx0, f_my0, imin(f_cx1, wx + f_bo), f_my1)
            }
            if f_cx1 > imax(f_cx0, wx + ow - f_bo) {
                fill_round(state, wx, wy, ow, oh, f_r, rahmen, f_a, imax(f_cx0, wx + ow - f_bo), f_my0, f_cx1, f_my1)
            }
        }
    } else {
        fill_round(state, wx, wy, ow, oh, form(state, FM_RADIUS), rahmen,
            deco_alpha(state), cx0 as i64, cy0 as i64, cx1 as i64, cy1 as i64)
    }
    // RUNDE GLAS (fix-r4-3): und das eben gemalte Rechteck wird
    // GEMELDET, damit die Abnahme alle vier Ecken findet und nicht nur
    // die, deren Koordinaten zufaellig auch das Programm kennt.
    if aktiv {
        rahmen_say(wx, wy, ow, oh, form(state, FM_RADIUS))
    }
    // die Titelleiste
    //
    // RUNDE SOFTUI: SIE IST NICHT MEHR EIN RECHTECK IN EINER FARBE.
    // Zwei Dinge sind dazugekommen, und beide kosten etwas, das in
    // docs/ROUNDSOFTUI.md steht: die oberen Ecken folgen dem
    // Fensterradius (sonst schneidet eine eckige Leiste die runde Ecke
    // ab, die `fill_round` gerade gemalt hat), und ueber die Hoehe
    // laeuft ein Verlauf von wenigen Helligkeitsstufen.
    // r454: a window that paints its own strip gets no title background; the caption buttons follow the client area
    let capc: bool = cap_client(state, i)
    if !capc {
        paint_title(state, i, wx, wy, ow, titel, schrift, ax0, ay0, ax1, ay1)
    }
    // ------------------------------- die Schaltflaechen rechts oben
    //
    // ZWEI FASSUNGEN, UND DIE ALTE BLEIBT WORTGLEICH STEHEN. `classic`
    // schickt FM_CAPTION = 0 und bekommt das rote Schliessfeld mit dem
    // Kreuz, das dieser Server seit Runde K10 malt -- dieselben
    // Koordinaten, dieselbe Schleife. `modern` schickt 1 und bekommt
    // die drei Windows-Schaltflaechen: Strich, Quadrat, Kreuz.
    var bx: i64 = wx + ow - border(state) as i64 - close_w(state) as i64 - 3
    if form(state, FM_CAPTION) != 0 {
        bx = wx + ow - border(state) as i64 - (CAP_N * cap_w(state)) as i64
        if !capc {
            paint_caption(state, i, wx, wy, ow, titel, schrift,
                ax0, ay0, ax1, ay1)
        }
    } else if !capc {
        paint_close_classic(state, wx, wy, ow, ax0, ay0, ax1, ay1)
    }
    // ===================================== RUNDE NETVIEW, NACHTRAG
    //
    // DAS ZEICHEN AM FENSTER SELBST. Die Taskleiste hat es am Knopf;
    // hier steht es am Fenster, weil ein Fenster auch dann sichtbar ist,
    // wenn die Leiste verdeckt, weggeschoben oder ausgeblendet ist --
    // und weil der Satz dieser Runde lautet, dass der Mensch es SEHEN
    // koennen muss.
    //
    // `real` bekommt keines. Ein Zeichen an jedem Fenster waere ein
    // Bildschirm voller Zeichen ohne Aussage.
    var before: i64 = 0
    let sicht: u64 = netview.view_of(state, win_owner(state, i))
    if sicht != netview.V_REAL && sicht <= 3 && !capc {
        title_mark(state, sicht - 1, wx + border(state) as i64 + title_pad(state) as i64,
            wy + border(state) as i64
                + ((title_h(state) - border(state) - netmark.H) / 2) as i64,
            schrift, ax0, ay0, ax1, ay1)
        before = netmark.W as i64 + 4
    }
    // der Titel
    let f: u64 = gs(state, S_FONT_UI)
    if f < ttf.MAX_FONTS && !capc {
        if tt_grouped(state, i) {
            tt_paint(state, i, wx, wy, titel, schrift, ax0, ay0, ax1, ay1, f)
        } else {
            title_text(state, i, f, wx + border(state) as i64 + title_pad(state) as i64 + before,
                wy + title_base(state, f),
                schrift, ax0, ay0, ax1, ay1, bx)
            if wg(state, i, W_KIND) == K_TERM && i < 32 {
                tt_paint_plus(state, i, wx, wy, schrift, ax0, ay0, ax1, ay1, f)
            }
        }
    }
    // die Flaeche der Anwendung
    let px0: i64 = wx + border(state) as i64
    let py0: i64 = wy + iny(state, i) as i64
    let sx0: i64 = imax(px0, ax0)
    let sy0: i64 = imax(py0, ay0)
    let sx1: i64 = imin(px0 + wg(state, i, W_W) as i64, ax1)
    let sy1: i64 = imin(py0 + wg(state, i, W_H) as i64, ay1)
    if sx1 <= sx0 || sy1 <= sy0 {
        return
    }
    let ww: u64 = wg(state, i, W_W)
    let quelle: u64 = wg(state, i, W_BUF)
    // ZUSAMMENFUEHRUNG: auch hier gewinnt die Mechanik von GLAS, und
    // die Deckung der Runde BLUR wird als Obergrenze eingefaltet --
    // dieselbe Rechnung wie in `paint_win`, aus demselben Grund.
    // RUNDE GLAS: die Flaeche der Anwendung mit `window_alpha`.
    //
    // Die Schluesselfarbe ist dieselbe, die die Leiste geschickt hat
    // (`FM_GLASS_KEY`). Das ist eine bewusste Vereinfachung und sie
    // steht hier, damit sie niemand fuer ein Versehen haelt: in allen
    // zehn Vorlagen liegen Leistengrund und Fenstergrund unter dreissig
    // Helligkeitsstufen auseinander, und das Abstandsalpha braucht die
    // Grundfarbe nur auf diese Genauigkeit. Waeren sie einmal weit
    // auseinander, bekaeme die Fensterflaeche zu viel Deckung -- also
    // zu wenig Glas, nie zu wenig Kontrast.
    let wa: u64 = form_or(state, FM_WIN_ALPHA, 100)
    let wkey: u64 = form(state, FM_GLASS_KEY)
    // ======================================== RUNDE GLAS (fix-r4-3)
    //
    // DER UMRISS IST AN ALLEN VIER ECKEN GESCHLOSSEN, und bis hierher
    // war er es an zweien nicht.
    //
    // `fill_round` hat den ganzen Fensterrumpf in Rahmenfarbe MIT
    // Rundung gefuellt -- oben legt die Titelleiste ihre eigene runde
    // Kante darueber, unten aber kopierte die Schleife hier die
    // Anwendungsflaeche ZEILENWEISE UND RECHTECKIG darueber und hat
    // die gerade gemalten Boegen wieder zugeschmiert. Gemessen im Bild
    // 03 (Radius 24): oben links ein sauberer Bogen, unten links ein
    // rechter Winkel -- ein Fenster mit zwei verschiedenen Formen.
    //
    // Die Abhilfe rechnet KEINE zweite Rundung, sie laesst nur die
    // Bildpunkte stehen, die schon rund sind: `ecke.corner_skip` sagt
    // fuer jede der untersten `radius` Zeilen, wie viele Spalten am
    // Rand NICHT vollstaendig innerhalb des Eckkreises liegen; genau
    // die ueberspringt die Kopie, und dort bleibt die
    // kantengeglaettete Fuellung von `fill_round` sichtbar. Ein
    // Bildpunkt weniger Anwendungsflaeche in der Ecke einer Karte ist
    // das, was eine Rundung IST -- und der Innenraum verschiebt sich
    // dabei nicht, denn `sx0` und die Zeilennummer bleiben
    // unveraendert.
    //
    // UND DER INNERSTE TEILGEDECKTE BILDPUNKT BEKOMMT SEINEN ANTEIL.
    // Ohne ihn endete die Anwendungsflaeche an einer harten Kante und
    // der Bogen daneben trug nur die Rahmenfarbe -- gemessen mit
    // `glascheck.py ecke ... ul`: zwoelf Zeilen mit Mischton gegen
    // achtzehn an der oberen Ecke, also sichtbar weniger Glaettung
    // unten als oben. Dieser eine Bildpunkt je Zeile und Seite geht
    // durch `px_clip` und damit durch dieselbe `blend`-Arithmetik wie
    // alles andere; gemischt wird die Farbe, die die Anwendung selbst
    // an diese Stelle gemalt hat.
    let rad: u64 = form(state, FM_RADIUS)
    let bo: i64 = border(state) as i64
    let cw: i64 = wg(state, i, W_W) as i64
    // ======================================== RUNDE GLAS (fix-r4-4)
    //
    // DAS MILCHGLAS GIBT ES AUCH UNTER EINEM DURCHSICHTIGEN FENSTER.
    //
    // Bis hierher lag es nur unter der Leiste, und der Grund stand als
    // Kommentar daneben: "unter einem gewoehnlichen Fenster waere es
    // dasselbe Rechnen fuer jedes Fenster in jedem Bild". Das ist
    // richtig fuer zehn Fenster und falsch fuer die Sache selbst --
    // die Leiste ist 28 Bildpunkte hoch, und auf einem Streifen von 28
    // Bildpunkten SIEHT ein Mensch keinen Weichzeichner, er misst ihn
    // nur. Erst unter einer Flaeche von mehreren hundert Zeilen wird
    // aus "var sinkt" ein Bild, auf das man zeigen kann.
    //
    // Was es kostet und warum es tragbar ist: gerechnet wird NUR, wenn
    // dieses Fenster wirklich durchsichtig ist (`wa < 100`) UND ein
    // Weichzeichner eingestellt ist. Bei `window_alpha=100` -- dem
    // Zustand jedes Laufs, der nicht ausdruecklich Glas bestellt --
    // wird diese Zeile nicht einmal betreten. Der Streifenpuffer ist
    // einer und wird zwischen Leiste und Fenster hin- und
    // hergeschoben; die Trefferquote faellt in einem solchen Lauf, die
    // Zahl dazu steht in `wm: glas ... cache=`.
    var wgrund: u64 = 0
    if wa < 100 && form(state, FM_BLUR) > 0 {
        wgrund = glass_prepare(state, px0, py0, ww, wg(state, i, W_H),
            form(state, FM_BLUR))
    }
    var r: i64 = sy0
    while r < sy1 {
        let zeile: u64 = (r - py0) as u64
        var rx0: i64 = sx0
        var rx1: i64 = sx1
        let dyb: i64 = wy + oh - 1 - r
        if capc && rad > 0 && r - wy < rad as i64 {
            // r454: the strip reaches the top corners: the same skip as at the bottom, counted from the top edge
            let skt: i64 = ecke.corner_skip(rad, (r - wy) as u64) as i64
            if skt > 0 {
                rx0 = imax(rx0, px0 + skt)
                rx1 = imin(rx1, px0 + cw - skt)
            }
        }
        if rad > 0 && dyb >= 0 && dyb < rad as i64 {
            // `skr` zaehlt vom FENSTERRAND, die Flaeche faengt eine
            // Rahmenbreite weiter innen an -- und sie hoert deshalb
            // auch eine Rahmenbreite VOR dem Bogen auf. Ohne dieses
            // `+ bo` stiesse die Anwendungsflaeche in der Ecke
            // unmittelbar an den Bogen, und der Rahmen, der an der
            // geraden Unterkante zwei Bildpunkte breit ist, waere an
            // der Rundung gar nicht da.
            let sk: i64 = ecke.corner_skip(rad, dyb as u64) as i64
            if sk > 0 {
                rx0 = imax(rx0, px0 + sk)
                rx1 = imin(rx1, px0 + cw - sk)
            }
        }
        if rx1 > rx0 {
            let spalte: u64 = (rx0 - px0) as u64
            let n: u64 = (rx1 - rx0) as u64
            if wa >= 100 {
                fb_row(state, rx0 as u64, r as u64,
                    quelle +% zeile *% ww *% 4 +% spalte *% 4, n)
            } else {
                var gz: u64 = 0
                if wgrund != 0 {
                    gz = wgrund +% (zeile *% ww +% spalte) *% 4
                }
                fb_row_a(state, rx0 as u64, r as u64,
                    quelle +% zeile *% ww *% 4 +% spalte *% 4, n, wa, wkey, gz,
                    SCHLEIER_WIN)
            }
        }
        r = r + 1
    }
    // r454: the caption buttons of a window with a client strip lie over the strip: after the client area
    if capc {
        if form(state, FM_CAPTION) != 0 {
            paint_caption(state, i, wx, wy, ow, titel, schrift,
                ax0, ay0, ax1, ay1)
        } else {
            paint_close_classic(state, wx, wy, ow, ax0, ay0, ax1, ay1)
        }
    }
    ss(state, S_BLITS, gs(state, S_BLITS) + 1)
}

// =====================================================================
// RUNDE SOFTUI: DIE TITELLEISTE
// =====================================================================
//
// DER VERLAUF, UND WARUM ER NACH UNTEN HELLER WIRD UND NICHT NACH OBEN.
//
// Justin wollte "dezente Verlaeufe statt Volltonfarbe, nur wenige
// Farbstufen". Die erste Fassung hat den Verlauf VON DER SCHRIFT WEG
// laufen lassen, damit er den Kontrast nie senken kann. Das Bild hat
// die Regel widerlegt: im hellen Schema ist die Titelleiste #ffffff,
// von Weiss aus gibt es kein Heller, und die Leiste kam VOLLKOMMEN FLACH
// heraus -- alle neunzehn Zeilen 255,255,255, nachgemessen. Eine Regel,
// die auf der Haelfte aller Themen nichts tut, ist keine.
//
// Also die andere Richtung, und sie ist auch die richtigere: DIE
// OBERSTE ZEILE IST DIE DUNKELSTE, die unterste traegt die Farbe des
// Themas unveraendert. Das ist ein weicher Eigenschatten an der
// Oberkante, also genau das, was eine gerundete Kante mit Licht von
// oben macht. Nach unten gibt es IMMER Platz (ausser bei Schwarz), und
// wo es ihn nicht gibt, nimmt `grad_room` nur so viel, wie da ist --
// kein Kanal darf anschlagen, sonst kippt der Farbton ins Blaue.
//
// UND DER KONTRAST. Auf hellem Grund mit dunkler Schrift senkt das
// Abdunkeln den Kontrast ein wenig (17,85 auf 17,04 gemessen fuer
// #0f172a auf #ffffff), auf dunklem Grund mit heller Schrift HEBT es
// ihn. Beide Werte liegen weit ueber dem kleinsten Paar des Systems --
// die Titelleiste ist nirgends das bindende Paar --, und
// tools/softui/kontrast.py misst es aus dem Bild statt es zu glauben.
fn lum3(c: u64) -> u64 {
    return ((c >> 16) & 255) + ((c >> 8) & 255) + (c & 255)
}

// Eine Farbe um `d` Stufen je Kanal aufhellen oder abdunkeln, mit
// Anschlag. Kein Mischen mit Weiss -- das verschoebe den Farbton.
fn shade24(c: u64, d: u64, auf: bool) -> u64 {
    var r: u64 = (c >> 16) & 255
    var g: u64 = (c >> 8) & 255
    var b: u64 = c & 255
    if auf {
        r = r + d
        g = g + d
        b = b + d
        if r > 255 {
            r = 255
        }
        if g > 255 {
            g = 255
        }
        if b > 255 {
            b = 255
        }
    } else {
        if r > d {
            r = r - d
        } else {
            r = 0
        }
        if g > d {
            g = g - d
        } else {
            g = 0
        }
        if b > d {
            b = b - d
        } else {
            b = 0
        }
    }
    return (r << 16) | (g << 8) | b
}

// Zwei Farben mischen, `per` Hundertstel von `b`.
fn mix24(a: u64, b: u64, per: u64) -> u64 {
    let r: u64 = (((a >> 16) & 255) * (100 - per) + ((b >> 16) & 255) * per)
        / 100
    let g: u64 = (((a >> 8) & 255) * (100 - per) + ((b >> 8) & 255) * per)
        / 100
    let bl: u64 = ((a & 255) * (100 - per) + (b & 255) * per) / 100
    return (r << 16) | (g << 8) | bl
}

fn paint_title(state: u64, i: u64, wx: i64, wy: i64, ow: i64, titel: u64,
    schrift: u64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    // RUNDE GLAS: die Titelleiste traegt dieselbe Deckkraft wie der
    // Rahmen. Eine deckende Leiste ueber einem durchscheinenden Rahmen
    // saehe nicht nach Glas aus, sondern nach einem Fehler.
    let wal: u64 = deco_alpha(state)
    let x0: i64 = wx + border(state) as i64
    let y0: i64 = wy + border(state) as i64
    let tw: i64 = ow - 2 * border(state) as i64
    let th: i64 = title_h(state) as i64 - 1 - border(state) as i64
    if tw <= 0 || th <= 0 {
        return
    }
    // Der Radius der Leiste ist der des Fensters, um den Rand nach
    // innen gerueckt -- so bleibt die Kurve der Leiste zur Kurve des
    // Rahmens gleichmittig statt sie zu schneiden.
    var tr: u64 = 0
    let rw: u64 = form(state, FM_RADIUS)
    if rw > border(state) {
        tr = rw - border(state)
    }
    if tr as i64 > th {
        tr = th as u64
    }
    let grad: u64 = form(state, FM_GRAD)
    if grad == 0 {
        // Volltonfarbe: EIN Aufruf, wie vor dieser Runde -- nur mit
        // runden oberen Ecken, wenn der Radius es sagt.
        fill_round(state, x0, y0, tw, th, tr, titel, wal, ax0, ay0, ax1, ay1)
        if tr != 0 {
            fill_clip(state, x0, y0 + tr as i64, tw, th - tr as i64,
                titel, wal, ax0, ay0, ax1, ay1)
        }
        return
    }
    // MIT VERLAUF. Die gerundeten obersten Zeilen tragen die
    // Endfarbe des Verlaufs in EINEM `fill_round` -- so bleibt die
    // Kantenglaettung der Ecke richtig gefaerbt --, und darunter
    // laeuft je eine Zeile.
    let grund: u64 = deco_title(state, i)
    let d: u64 = grad_room(grund, grad)
    if d == 0 {
        fill_round(state, x0, y0, tw, th, tr, titel, wal, ax0, ay0, ax1, ay1)
        if tr != 0 {
            fill_clip(state, x0, y0 + tr as i64, tw, th - tr as i64,
                titel, wal, ax0, ay0, ax1, ay1)
        }
        return
    }
    let oben: u64 = rgb24(state, shade24(grund, d, false))
    fill_round(state, x0, y0, tw, th, tr, oben, wal, ax0, ay0, ax1, ay1)
    var j: i64 = tr as i64
    while j < th {
        // linear von `oben` zurueck auf die Grundfarbe
        let rest: u64 = d * (th - 1 - j) as u64 / (th - 1) as u64
        let c: u64 = rgb24(state, shade24(grund, rest, false))
        fill_clip(state, x0, y0 + j, tw, 1, c, wal, ax0, ay0, ax1, ay1)
        j = j + 1
    }
}

// Wieviel Verlauf die Farbe TRAEGT. Der kleinste Kanal setzt die
// Grenze: schlaegt einer an, waehrend die anderen noch Platz haben,
// verschiebt sich der Farbton, und ein Verlauf, der die Farbe wechselt,
// ist keiner mehr.
fn grad_room(c: u64, want: u64) -> u64 {
    var m: u64 = (c >> 16) & 255
    let g: u64 = (c >> 8) & 255
    let b: u64 = c & 255
    if g < m {
        m = g
    }
    if b < m {
        m = b
    }
    if want > m {
        return m
    }
    return want
}

// Die ROHE Titelfarbe (0xRRGGBB) des Fensters -- `shade24` rechnet in
// Kanaelen und nicht im Format des Bildschirms.
fn deco_title(state: u64, i: u64) -> u64 {
    if focus(state) == i {
        return deco_rgb(state, DK_TITLE_ON)
    }
    return deco_rgb(state, DK_TITLE)
}

// =====================================================================
// RUNDE SOFTUI: DIE DREI SCHALTFLAECHEN -- WINDOWS UND NICHT MACOS
// =====================================================================
//
// Justin hat das ausdruecklich verlangt und es ist keine
// Geschmacksfrage: rechts oben, drei Felder, und die Zeichen darin
// sind STRICHE und keine bunten Kreise. Minimieren ein waagerechter
// Strich, Maximieren ein Quadrat (im maximierten Zustand zwei
// versetzte), Schliessen ein Kreuz.
//
// DAS VERHALTEN GEHOERT DAZU. Ein Windows-Knopf hat keinen Rahmen und
// keine Flaeche, bis der Zeiger darauf steht; dann bekommt er eine
// dezente graue Flaeche, und der Schliessen-Knopf eine ROTE mit weissem
// Kreuz. Ohne den Ueberfahr-Zustand sind es drei Zeichen und keine
// Schaltflaechen -- deshalb fuehrt der Server jetzt mit, welche gerade
// unter dem Zeiger liegt (S_CAPHOV), und faerbt genau diese eine.
fn cap_x0(state: u64, i: u64) -> i64 {
    return win_x(state, i) + outer_w(state, i) as i64 - border(state) as i64
        - (CAP_N * cap_w(state)) as i64
}

// Welche Schaltflaeche liegt unter (x, y)? CAP_N = keine.
fn cap_at(state: u64, i: u64, x: i64, y: i64) -> u64 {
    if !valid(state, i) || !deko(state, i) {
        return CAP_N
    }
    if form(state, FM_CAPTION) == 0 {
        return CAP_N
    }
    let bx: i64 = cap_x0(state, i)
    let by: i64 = win_y(state, i) + border(state) as i64
    let h: i64 = title_h(state) as i64 - 1 - border(state) as i64
    if y < by || y >= by + h || x < bx || x >= bx + (CAP_N * cap_w(state)) as i64 {
        return CAP_N
    }
    return ((x - bx) / cap_w(state) as i64) as u64
}

fn paint_caption(state: u64, i: u64, wx: i64, wy: i64, ow: i64,
    titel: u64, schrift: u64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let bx: i64 = wx + ow - border(state) as i64 - (CAP_N * cap_w(state)) as i64
    let by: i64 = wy + border(state) as i64
    let h: i64 = title_h(state) as i64 - 1 - border(state) as i64
    if h <= 0 {
        return
    }
    var tr: u64 = 0
    let rw: u64 = form(state, FM_RADIUS)
    if rw > border(state) {
        tr = rw - border(state)
    }
    let hov: u64 = gs(state, S_CAPHOV)
    let dwn: u64 = gs(state, S_CAPDOWN)
    var n: u64 = 0
    while n < CAP_N {
        let x: i64 = bx + (n * cap_w(state)) as i64
        var mark: u64 = schrift
        if hov != 0 && hov - 1 == i * 4 + n {
            // r402: the held button (pointer still on it) is one step darker / stronger
            let held: bool = dwn == hov
            if n == CAP_CLOSE {
                // ROT MIT WEISSEM KREUZ -- die eine Stelle, an der
                // diese Oberflaeche laut werden darf.
                var rot: u64 = deco(state, DK_CLOSE)
                if held {
                    rot = rgb24(state, mix24(deco_rgb(state, DK_CLOSE), 0, 14))
                }
                cap_face(state, x, by, h, tr, rot, n == CAP_CLOSE,
                    ax0, ay0, ax1, ay1)
                mark = deco(state, DK_CLOSE_MARK)
            } else {
                // Eine dezente graue Flaeche: die Titelfarbe, zwoelf
                // Hundertstel in Richtung der Schrift geschoben. Kein
                // neuer Farbsteckplatz und kein festes Grau -- auf
                // einem dunklen Thema muss sie heller werden und auf
                // einem hellen dunkler, und genau das tut das Mischen.
                var pc: u64 = 12
                if held {
                    pc = 22
                }
                let f: u64 = rgb24(state, mix24(deco_title(state, i),
                    deco_schrift(state, i), pc))
                cap_face(state, x, by, h, tr, f, false,
                    ax0, ay0, ax1, ay1)
            }
        }
        // ======================================== RUNDE MERGE-11: R1
        // DIE FESTE 10 WAR DER GRUND FUER JUSTINS "— [] /".
        //
        // Das Zeichen ist `10 * uisc` gross (cap_glyph, `let d`), hier
        // wurde aber mit der ROHEN 10 zentriert. Bei Vervielfachung 2
        // sitzt es damit 5 Bildpunkte zu weit rechts und unten -- und
        // vom Kreuz, dessen zweite Diagonale genau dort endet, bleibt
        // im Knopffeld ein Schraegstrich uebrig.
        //
        // GEMESSEN am laufenden Fenster, 3440x1440: mit der festen 10
        // meldet Justin "-- [] /", mit `zg` steht ein Kreuz da, in
        // jeder der 19 Zeilen Punkte auf BEIDEN Seiten.
        let zg: i64 = 10 * uisc(state) as i64
        cap_glyph(state, n, x + (cap_w(state) as i64 - zg) / 2,
            by + (h - zg) / 2, mark, i, ax0, ay0, ax1, ay1)
        n = n + 1
    }
}

fn deco_schrift(state: u64, i: u64) -> u64 {
    if focus(state) == i {
        return deco_rgb(state, DK_TEXT_ON)
    }
    return deco_rgb(state, DK_TEXT)
}

// Die Flaeche EINER Schaltflaeche. Nur die rechte -- das Schliessen --
// darf oben rechts der Fensterrundung folgen; die beiden anderen sind
// Rechtecke, weil sie mitten in der Leiste stehen.
fn cap_face(state: u64, x: i64, y: i64, h: i64, tr: u64, farbe: u64,
    rechts: bool, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    // RUNDE GLAS: die Flaeche der Schaltflaeche gehoert zur
    // Titelleiste und bekommt deren Deckkraft. Das ZEICHEN darauf
    // nicht -- `cap_glyph` malt weiter voll deckend, sonst waere ein
    // Kreuz auf einem hellen Hintergrundbild nicht mehr zu sehen.
    let wal: u64 = deco_alpha(state)
    let w: i64 = cap_w(state) as i64
    if !rechts || tr == 0 {
        fill_clip(state, x, y, w, h, farbe, wal, ax0, ay0, ax1, ay1)
        return
    }
    let r: i64 = tr as i64
    fill_round(state, x, y, w, h, tr, farbe, wal, ax0, ay0, ax1, ay1)
    // die drei Ecken wieder eckig machen
    fill_clip(state, x, y, w - r, r, farbe, wal, ax0, ay0, ax1, ay1)
    fill_clip(state, x, y + r, w, h - r, farbe, wal, ax0, ay0, ax1, ay1)
}

// DAS ZEICHEN. Zehn mal zehn Bildpunkte, einen Strich breit.
//
//   CAP_MIN    ein waagerechter Strich auf halber Hoehe
//   CAP_MAX    ein Quadrat -- und im maximierten Zustand ZWEI
//              versetzte, weil der Knopf dann "wiederherstellen"
//              heisst und nicht "maximieren"
//   CAP_CLOSE  ein Kreuz aus zwei Diagonalen
// ==================================================== RUNDE VEKTOR
//
// DIE DREI ZEICHEN, GESTRICHEN STATT GESETZT.
//
// Was hier stand, waren gesetzte Bildpunkte: `cap_px` in einer
// Schleife fuer das Kreuz, `cap_box` aus vier Linien fuer das
// Quadrat -- und alles auf FESTE ZEHN MAL ZEHN Bildpunkte.
//
// Der Fehler daran ist nicht der Geschmack, sondern die Rechnung:
// `cap_w` ist `CAP_W0 * uisc` und waechst mit der Oberflaeche
// (wm.fi:3043), die Zehn hier wuchs nicht mit. Bei Vervielfachung 2
// war die Schaltflaeche sechzig Bildpunkte breit und das Kreuz darin
// zehn -- ein Fliegendreck in einem Feld. Dazu war die Diagonale eine
// Treppe aus einzelnen Punkten, weil eine gesetzte Diagonale nichts
// anderes sein kann.
//
// Jetzt: die Groesse ist `10 * uisc`, und die Striche sind STRICHE --
// `vektor.strichen` mit Breite und runden Enden, gerastert mit
// derselben Kantenglaettung wie alles andere. Der Aufrufer uebergibt
// weiter die linke obere Ecke eines Quadrats; wie gross das ist,
// rechnet diese Funktion selbst.
// ================================================ RUNDE MERGE-11: R1
// DAS SCHLIESSKREUZ WIRD WIEDER DIREKT GEZEICHNET.
//
// Justins Foto vom 10.09. 18:39 (3440x1440): das X ist zerfranst, mit
// einem fetten schraegen Zusatzbalken. Minimieren und Maximieren sind
// sauber. Seine Worte: "so perfekte Buttons waren davor. Jetzt sind
// diese Buttons korrumpiert."
//
// DIE URSACHE, GEMESSEN (tools/design/kreuzcheck.py):
//
//   X, zwei Striche (uisc=1)   54 bedeckt    4 mehrfach
//   X, zwei Striche (uisc=2)  187 bedeckt   12 mehrfach
//   X, zwei Striche (uisc=3)  394 bedeckt   24 mehrfach
//   Gegenprobe: EIN Strich      jeweils      0 mehrfach
//
// Die Vektorfassung rief `strichen(0)` ZWEIMAL -- einmal je Diagonale
// -- und rasterte beide Umrisse zusammen mit NICHTNULL. Wo sich die
// Umrisse kreuzen, addieren sich die Umlaufzahlen, statt sich
// aufzuheben: die Kreuzungsflaeche wird doppelt gedeckt. Und es wird
// mit der Skalierung SCHLIMMER (4 -> 12 -> 24 Bildpunkte), weshalb es
// auf Justins dichtem Schirm auffaellt und im Pruefstand bei kleiner
// Skalierung durchging.
//
// WAS JETZT PASSIERT: zurueck auf die Fassung, die er "perfekt"
// genannt hat -- ein Bildpunkt nach dem anderen, jeder GENAU EINMAL
// geschrieben. Doppelte Deckung ist damit nicht unwahrscheinlich,
// sondern unmoeglich; es gibt keinen Umriss, der sich ueberlappen
// koennte.
//
// DER EINE UNTERSCHIED ZUR ALTEN FASSUNG: sie war auf 10 Bildpunkte
// festgenagelt und waere auf 3440x1440 ein Fliegendreck. Die Groesse
// laeuft jetzt ueber `uisc`, die Strichstaerke ebenso -- gezeichnet
// wird aber weiter direkt, ohne Rasterer.
//
// KEIN RETTUNGSVERSUCH AM VEKTORWEG. Der Auftrag ist eindeutig:
// lieber eine einfache Zeichnung, die sauber aussieht.
fn cap_glyph(state: u64, n: u64, x: i64, y: i64, farbe: u64, i: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let sk: i64 = uisc(state) as i64
    let d: i64 = 10 * sk
    let sb: i64 = sk
    if d <= 0 || sb <= 0 {
        return
    }
    // ================================================== RUNDE KERN-FUI
    //
    // DIESE FUNKTION MALT DIE ZEICHEN NICHT MEHR SELBST.
    //
    // Justin, 10.09.2026: "kann man die fUi-Lib nicht ohne Imports
    // machen, also dass sie im Kernel auch laufen kann?" -- sie ist es
    // bereits: `vendor/firn/lib/fui/core.fi` traegt `profile kernel` in
    // Zeile 1 und wurde genau dafuer geschrieben. Angeschlossen war sie
    // nie; `grep -rln fui kernel/*.fi` fand bis zu dieser Runde nichts.
    //
    // WARUM DAS NICHT KOSMETIK IST, SONDERN EIN GEMESSENER FEHLER.
    // Die alte Fassung hier rechnete EINE Verschiebung fuer beide
    // Achsen:
    //
    //     let off: i64 = (d - (kn + sb - 1)) / 2
    //
    // Das Kreuz belegt aber nicht gleich viel in beiden Richtungen --
    // die Breite ist `kn + sb - 1` (die Laeufe UND die Verbreiterung
    // addieren sich), die Hoehe nur `kn` (die Verbreiterung geht
    // waagerecht). `core.fi` rechnet deshalb ZWEI Verschiebungen und
    // sagt das in seinem Kopf auch woertlich ("A THIRD MISTAKE, FOUND
    // AND MEASURED IN THIS ROUND").
    //
    // GEMESSEN (tools/fui/kernvergleich.py), abweichende Bildpunkte
    // zwischen der alten wm-Fassung und fui.core:
    //
    //     d=10 sb=1     0      d=20 sb=2     0
    //     d=30 sb=3   112      d=40 sb=4   152
    //
    // Bei Vervielfachung 1 und 2 stimmten beide ueberein -- deshalb ist
    // es nie aufgefallen. Ab Vervielfachung 3 klebt das Kreuz oben und
    // laesst unten eine Zeile frei, waehrend das Quadrat daneben mittig
    // sitzt. Das ist genau die Sorte Abweichung, die entsteht, wenn
    // dieselbe Form an zwei Orten steht -- und der dritte Anlauf
    // desselben Fehlers, nach dem ausgefransten Kreuz und dem mit nur
    // einer Diagonale.
    //
    // ============================================ WIE fUi AUF DEN SCHIRM KOMMT
    //
    // NICHT direkt, und das hat zwei nachgepruefte Gruende:
    //
    //  G1 `core.fi` KENNT KEINEN BESCHNITT. Es malt in ein `Target` von
    //     (0,0) bis (w,h); der Server malt in ein SCHMUTZRECHTECK
    //     (ax0..ax1, ay0..ay1) mitten auf dem Schirm. Ein Zeichen ohne
    //     Beschnitt malte ueber fremde Fenster.
    //  G2 DAS PIXELFORMAT IST NICHT FEST. `core.put` legt BGRX ab, fest
    //     verdrahtet. `fb.fi` nimmt die Verschiebungen aus S_RSHIFT/
    //     S_GSHIFT/S_BSHIFT, die der Grafikmodus liefert -- auf einer
    //     Tafel mit anderer Reihenfolge waeren die Farben vertauscht.
    //     Dazu haelt `fb.pixel` das reservierte Band der Messtafel frei
    //     (`band_lo`), was ein roher Schreiber ueberschriebe.
    //
    // ALSO: fUi rastert in `cg_deck` -- den Zwischenpuffer, den Runde
    // VEKTOR angelegt und nie benutzt hat. Dort ist das Format egal,
    // weil nur die DECKUNG zaehlt. Danach traegt diese Funktion den
    // Puffer durch `cap_px` auf den Schirm -- mit Beschnitt, mit dem
    // Band und ueber den Farbwaehler des Servers. Die FORM kommt aus
    // fUi, der WEG auf den Schirm bleibt der des Servers.
    //
    // Damit malt der Fensterserver dieselben Bildpunkte wie jede
    // Anwendung, weil es derselbe Quelltext ist -- und
    // `tools/fui/kernvergleich.py` rechnet es nach.
    let dd: u64 = d as u64
    if dd > CG_KANTE {
        // Mehr als 40x40 passt nicht in ein Fach. Das kann bei
        // uisc <= 4 nicht vorkommen (10 * 4 = 40); steht hier trotzdem,
        // weil ein stiller Ueberlauf in einen statischen Puffer im Kern
        // das Schlimmste ist, was diese Datei tun kann.
        return
    }
    let slot: u64 = cg_slot(state, n, i)
    if !cg_bau(state, slot, n, i, dd, sb as u64) {
        return
    }
    // Der Puffer haelt DECKUNGEN, nicht Farben: != 0 heisst gesetzt.
    // `core.fi` setzt jeden Punkt genau einmal und ohne Mischung (das
    // ist der ganze Unterschied zum Rasterer, an dem das Kreuz zweimal
    // zerbrochen ist) -- ein Vergleich gegen null reicht deshalb.
    var ry: u64 = 0
    while ry < dd {
        var rx: u64 = 0
        while rx < dd {
            if cg_deck[(slot *% CG_FACH +% ry *% dd +% rx) as usize]
                != 0 as u8 {
                cap_px(state, x + rx as i64, y + ry as i64, farbe,
                    ax0, ay0, ax1, ay1)
            }
            rx = rx + 1
        }
        ry = ry + 1
    }
}

// Welches Fach des Zeichenspeichers gehoert zu dieser Schaltflaeche?
// Maximieren hat ZWEI Bilder -- ein Quadrat und zwei versetzte --, also
// braucht es zwei Faecher. Das vierte ist genau dafuer da.
fn cg_slot(state: u64, n: u64, i: u64) -> u64 {
    if n == CAP_MAX && (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0 {
        return 3
    }
    if n >= CG_N {
        return 0
    }
    return n
}

// DAS ZEICHEN IN DEN ZWISCHENPUFFER, EINMAL JE GROESSE.
//
// Liegt es schon in der richtigen Kantenlaenge da, wird nichts gemalt
// -- das ist der Speicher, den Runde VEKTOR angelegt und nie benutzt
// hat. `cg_treffer` und `cg_bauten` zaehlen beides; die zweite Zahl
// muss klein bleiben, sonst wirkt der Speicher nicht.
fn cg_bau(state: u64, slot: u64, n: u64, i: u64, dd: u64, sb: u64) -> bool {
    if slot >= CG_N || dd == 0 || dd > CG_KANTE {
        return false
    }
    if cg_gr == dd && cg_gut[slot as usize] != 0 {
        cg_treffer = cg_treffer + 1
        return true
    }
    // Die Groesse hat gewechselt: ALLE Faecher sind ungueltig, nicht
    // nur dieses. Sonst stuenden Zeichen zweier Vervielfachungen
    // nebeneinander in der Leiste.
    if cg_gr != dd {
        var k: u64 = 0
        while k < CG_N {
            cg_gut[k as usize] = 0
            k = k + 1
        }
        cg_gr = dd
    }
    // DIE FLAECHE, DIE fUi BESCHREIBT.
    //
    // `core.fi` rechnet mit VIER Oktetten je Bildpunkt (`put` schreibt
    // B, G, R, X). Ein Fach ist deshalb `CG_KANTE * CG_KANTE * 4` gross
    // und nicht `CG_KANTE * CG_KANTE` -- 6400 Oktette, viermal, macht
    // 25 600 Oktette fuer den ganzen Speicher. Das ist der ehrliche
    // Preis dafuer, dass hier dieselbe Routine laeuft wie in Ring 3;
    // ihn zu druecken hiesse, `core.fi` eine zweite Ablage
    // beizubringen, und das waere wieder die zweite Umsetzung.
    //
    // Danach wird das Fach AN ORT UND STELLE auf ein Oktett je Punkt
    // eingedampft (`cg_dampf`): Punkt k liegt bei k*4 und soll nach k,
    // und weil k <= k*4 gilt, ueberschreibt der Lauf nie etwas, das er
    // noch braucht. Das spart beim Uebertragen drei Viertel der
    // Leserei, und das Uebertragen laeuft je BILD -- das Rastern nur
    // je Groesse.
    let basis: u64 = ((&cg_deck[0]) as u64) +% slot *% CG_FACH
    var z: core.Target = core.target_new(basis, dd as usize, dd as usize,
        (dd *% 4) as usize)
    core.fill_rect(&z, 0 as usize, 0 as usize, dd as usize, dd as usize,
        0 as u32)
    cg_mal(state, &z, n, i, dd, sb)
    cg_dampf(state, slot, dd)
    cg_gut[slot as usize] = 1
    cg_bauten = cg_bauten + 1
    return true
}

// Vier Oktette je Punkt auf eines eindampfen, im selben Fach.
fn cg_dampf(state: u64, slot: u64, dd: u64) {
    let b: u64 = slot *% CG_FACH
    var k: u64 = 0
    while k < dd *% dd {
        var v: u8 = 0 as u8
        if cg_deck[(b +% k *% 4) as usize] != 0 as u8 {
            v = 255 as u8
        }
        cg_deck[(b +% k) as usize] = v
        k = k + 1
    }
}

// ============================================================ DIE FORM
//
// HIER UND NUR HIER entscheidet sich, WIE ein Fensterzeichen aussieht
// -- und es steht keine einzige Zeile Zeichenkunst darin. Jede Form
// kommt aus `fui.core`, derselben Datei, aus der die Anwendungen ueber
// `fuib.fi` ihre Knoepfe holen.
//
// Die Farbe ist 0xFFFFFF und nicht die echte: der Puffer haelt
// DECKUNGEN. Welche Farbe daraus wird, entscheidet `cap_glyph` beim
// Uebertragen -- und damit der Farbwaehler des Servers, nicht fUi.
fn cg_mal(state: u64, z: *mut core.Target, n: u64, i: u64, dd: u64,
    sb: u64) {
    let weiss: u32 = 0xFFFFFF as u32
    if n == CAP_MIN {
        core.cap_minimize(z, 0 as usize, 0 as usize, dd as usize,
            sb as usize, weiss)
        return
    }
    if n == CAP_MAX {
        if (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0 {
            core.cap_restore(z, 0 as usize, 0 as usize, dd as usize,
                sb as usize, weiss)
            return
        }
        core.cap_maximize(z, 0 as usize, 0 as usize, dd as usize,
            sb as usize, weiss)
        return
    }
    core.cap_close(z, 0 as usize, 0 as usize, dd as usize, sb as usize,
        weiss)
}

// Ein Kasten mit Strichstaerke -- die alte `cap_box` kann nur einen
// Bildpunkt breit. Auch hier gilt: jeder Bildpunkt wird gesetzt, nicht
// aufaddiert; ueberlappende Kanten an den Ecken sind deshalb harmlos.
fn cap_box_thick(state: u64, x: i64, y: i64, w: i64, h: i64, sb: i64,
    farbe: u64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    var t: i64 = 0
    while t < sb {
        cap_h(state, x, y + t, w, farbe, ax0, ay0, ax1, ay1)
        cap_h(state, x, y + h - 1 - t, w, farbe, ax0, ay0, ax1, ay1)
        var k: i64 = 0
        while k < h {
            cap_px(state, x + t, y + k, farbe, ax0, ay0, ax1, ay1)
            cap_px(state, x + w - 1 - t, y + k, farbe, ax0, ay0, ax1, ay1)
            k = k + 1
        }
        t = t + 1
    }
}

// Wie oft ein fertiges Zeichen benutzt und wie oft eines gerastert
// wurde. Die zweite Zahl MUSS klein bleiben -- sie ist der Beleg,
// dass der Speicher wirkt.
fn cap_glyph_treffer() -> u64 {
    return cg_treffer
}

fn cap_glyph_bauten() -> u64 {
    return cg_bauten
}

fn cap_px(state: u64, x: i64, y: i64, farbe: u64, ax0: i64, ay0: i64,
    ax1: i64, ay1: i64) {
    if x < ax0 || y < ay0 || x >= ax1 || y >= ay1 || x < 0 || y < 0 {
        return
    }
    fb.pixel(state, x as u64, y as u64, farbe)
}

fn cap_h(state: u64, x: i64, y: i64, n: i64, farbe: u64, ax0: i64,
    ay0: i64, ax1: i64, ay1: i64) {
    var k: i64 = 0
    while k < n {
        cap_px(state, x + k, y, farbe, ax0, ay0, ax1, ay1)
        k = k + 1
    }
}

fn cap_box(state: u64, x: i64, y: i64, w: i64, h: i64, farbe: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    cap_h(state, x, y, w, farbe, ax0, ay0, ax1, ay1)
    cap_h(state, x, y + h - 1, w, farbe, ax0, ay0, ax1, ay1)
    var k: i64 = 1
    while k < h - 1 {
        cap_px(state, x, y + k, farbe, ax0, ay0, ax1, ay1)
        cap_px(state, x + w - 1, y + k, farbe, ax0, ay0, ax1, ay1)
        k = k + 1
    }
}

// Der Zeiger ist gewandert: welche Schaltflaeche liegt jetzt unter ihm?
// Aendert sich die Antwort, wird die Titelleiste des betroffenen
// Fensters schmutzig -- und nur sie.
// r402: what a caption button does (it used to run on the press itself).
fn cap_act(state: u64, i: u64, cn: u64) {
    if !valid(state, i) || !deko(state, i) {
        return
    }
    ss(state, S_CAPHITS, gs(state, S_CAPHITS) + 1)
    if cn == CAP_CLOSE {
        // RUNDE OBERFLAECHE: UEBER DIE BEWEGUNG. `close_anim` pusht E_CLOSE selbst und ruft
        // `destroy` erst, wenn die Bewegung durch ist -- ist sie abgeschaltet, sofort.
        let _ca: bool = close_anim(state, i)
        return
    }
    if cn == CAP_MIN {
        // Dasselbe fuer das Minimieren: am Ende steht `set_hidden`, aber erst nach der Bewegung.
        let _ma: bool = minimize_anim(state, i)
        return
    }
    let auf: bool = (wg(state, i, W_FLAGS) & F_MAXIMIZED) == 0
    let _m: bool = maximize(state, i, auf)
}

// The left button went up: a held caption button acts if the pointer is still on it.
fn cap_release(state: u64, over: u64, x: i64, y: i64) {
    let d: u64 = gs(state, S_CAPDOWN)
    if d == 0 {
        return
    }
    ss(state, S_CAPDOWN, 0)
    let w: u64 = (d - 1) / 4
    let n: u64 = (d - 1) % 4
    if w >= MAX_WIN || !valid(state, w) {
        return
    }
    damage_caption(state, w)
    if over != w || sperre_an(state) || !darf(state, w) {
        return
    }
    if cap_at(state, w, x, y) == n {
        cap_act(state, w, n)
    }
}

fn cap_track(state: u64, i: u64, x: i64, y: i64) {
    var nv: u64 = 0
    if i < MAX_WIN {
        let n: u64 = cap_at(state, i, x, y)
        if n < CAP_N {
            nv = i * 4 + n + 1
        }
    }
    let alt: u64 = gs(state, S_CAPHOV)
    if nv == alt {
        return
    }
    ss(state, S_CAPHOV, nv)
    if alt != 0 {
        damage_caption(state, (alt - 1) / 4)
    }
    if nv != 0 {
        damage_caption(state, (nv - 1) / 4)
    }
}

fn damage_caption(state: u64, i: u64) {
    if !valid(state, i) || !deko(state, i) {
        return
    }
    let bx: i64 = cap_x0(state, i)
    let by: i64 = win_y(state, i) + border(state) as i64
    damage(state, bx, by, bx + (CAP_N * cap_w(state)) as i64,
        by + title_h(state) as i64 - 1 - border(state) as i64)
}

// Eine Bildzeile aus einem Fensterpuffer in den Zweitpuffer des
// Bildschirms. Ueber `rep movsq`, wie alles andere in `fb.fi` -- eine
// Schleife aus Einzelzugriffen kostete dort gemessen den Faktor acht.
// ==================================================== RUNDE DREI (G-006)
// WELCHES FENSTER OHNE SCHMUCK EINEN RADIUS BEKOMMT -- UND WELCHES NICHT.
//
// Die Frage ist nicht "kann man runden", sondern "gehoert es sich".
// Drei Faelle, und alle drei haben einen Grund:
//
//   * EIN FENSTER, DAS DEN GANZEN SCHIRM BEDECKT, BLEIBT ECKIG.
//     Der Schreibtisch ist der Schirm; eine runde Ecke dort zeigt vier
//     schwarze Zipfel auf nichts. Dasselbe gilt fuer ein Vollbild.
//     Geprueft wird an der GROESSE gegen den Schirm und nicht an einem
//     Merkerbit -- ein Fenster, das zufaellig genau so gross ist,
//     sieht genauso aus.
//
//   * EIN FENSTER, DAS EINEN SCHIRMRAND RESERVIERT (`W_STRUT`, also
//     die Taskleiste), wird nur an den INNEREN Ecken gerundet. Eine
//     Leiste, die unten klebt, hat unten keine sichtbaren Ecken; sie
//     oben UND unten zu runden hiesse, zwei Zipfel an den Bildschirm-
//     rand zu malen. Diese Runde macht dafuer noch keinen Sonderfall
//     und laesst die Leiste deshalb ganz aussen vor -- die Leiste malt
//     ihre eigene Pille bereits selbst (`wlibc.radius`), und zwei
//     Rundungen uebereinander sind eine zuviel.
//
//   * ALLES ANDERE (wmshell, Kontrollzentrum, ein rahmenloser Dialog)
//     bekommt `FM_RADIUS`, also dieselbe Zahl wie jedes gewoehnliche
//     Fenster. Genau das verlangt G-006.
fn nodeco_radius(state: u64, i: u64) -> u64 {
    let r: u64 = form(state, FM_RADIUS)
    if r == 0 {
        return 0
    }
    // Die Leiste rundet sich selbst.
    if wg(state, i, W_STRUT) != 0 {
        return 0
    }
    // So gross wie der Schirm: kein Radius.
    if wg(state, i, W_W) >= gs(state, S_SW)
        && wg(state, i, W_H) >= gs(state, S_SH) {
        return 0
    }
    // Und nie mehr als die halbe Kante -- sonst treffen sich zwei
    // Ecken in der Mitte und die Zeile verschwindet.
    var rr: u64 = r
    if rr * 2 > wg(state, i, W_W) {
        rr = wg(state, i, W_W) / 2
    }
    if rr * 2 > wg(state, i, W_H) {
        rr = wg(state, i, W_H) / 2
    }
    return rr
}

// ==================================================== RUNDE DREI (G-006)
// DER RADIUS FUER FENSTER OHNE SCHMUCK.
//
// Schreibtisch, Taskleiste, wmshell und Kontrollzentrum laufen durch
// den Blit-Pfad in `paint_win` und bekamen NIE einen Radius --
// `fill_round` steht im anderen Zweig, dem mit Rahmen und Titelleiste.
// Die Tokens waren laengst da (`FM_RADIUS`, die Formdatei,
// `RADIUS_MAX`); sie erreichten diese Fenster nur nicht.
//
// WAS GERECHNET WIRD. Eine Zeile des Fensters geht am Stueck in den
// Zweitpuffer (`fb_row`, wortweise). Eine runde Ecke heisst: in den
// obersten und untersten `r` Zeilen faengt die Zeile spaeter an und
// hoert frueher auf, und der schmale Saum dazwischen wird GEMISCHT
// statt gesetzt. Die Deckung dafuer kommt aus `ecke.corner_cov` --
// derselben Funktion, die `fill_round` im dekorierten Zweig benutzt.
// Eine Rundung, zwei Aufrufer, keine zweite Formel.
//
// DER UNTERGRUND WIRD NICHT FLAECHIG GELESEN. `fb.pixel_a` mischt
// genau den einen Bildpunkt, den es gerade schreibt. Das ist dieselbe
// Auflage, unter der die Runde BLUR ihre Maske gebaut hat.
//
// WAS EINE ECKE KOSTET: hoechstens 4 * r * r Bildpunkte je Fenster und
// Bild, unabhaengig von der Fenstergroesse. Bei r = 8 sind das 256 --
// der Schreibtisch allein misst 1 024 000.
//
// DER EINZUG EINER ZEILE. `dy` ist der Abstand vom oberen bzw. unteren
// Fensterrand (0 = die aeusserste Zeile). Der Mittelpunkt des
// Eckkreises liegt `r` Bildpunkte innen; fuer diese Zeile ist der
// senkrechte Abstand dorthin `r - dy`, der waagrechte Halbmesser also
// die Wurzel aus `r^2 - (r-dy)^2`. Soviel Bildpunkte fehlen am Rand:
//
//     dy=0 -> 8     dy=3 -> 2     dy=6 -> 1
//     dy=1 -> 5     dy=4 -> 2     dy=7 -> 1
//     dy=2 -> 3     dy=5 -> 1     dy>=8 -> 0        (bei r = 8)
fn rund_einzug(dy: u64, r: u64) -> u64 {
    return ecke.corner_skip(r, dy)
}

fn rund_saum(state: u64, wx: i64, cx0: i64, cx1: i64, ww: u64, y: u64,
    row: u64, dy: u64, r: u64, links: bool) {
    if r == 0 || dy >= r || ww == 0 {
        return
    }
    var i: u64 = 0
    while i < r && i < ww {
        var sx: u64 = i
        if !links {
            sx = ww - 1 - i
        }
        let x: i64 = wx + sx as i64
        if x >= cx0 && x < cx1 {
            let cov: u64 = ecke.corner_cov(r - 1 - i, r - 1 - dy, r)
            if cov != 0 {
                let c: u64 = __mmio_read32((row +% sx *% 4) as *mut u32) as u64
                fb.pixel_a(state, x as u64, y, c, cov)
            }
        }
        i = i + 1
    }
}

fn fb_row(state: u64, x: u64, y: u64, src: u64, n: u64) {
    // RUNDE BLECHDREI: DIESER WEG GEHT AN `fb.hline` VORBEI -- er
    // kopiert die Fensterflaeche wortweise direkt in den Zweitpuffer.
    // Ohne die Grenze hier waere das reservierte Band der Messtafel
    // genau von dem ueberschrieben worden, der es am haeufigsten
    // ueberschrieben hat: dem Fensterserver.
    if y < fb.band_lo(state) {
        return
    }
    let ziel: u64 = fb.draw_at(state) +% y *% fb.pitch(state) +% x *% 4
    comp.copy_row(ziel, src, n)
}

// =====================================================================
// RUNDE GLAS: DIE DURCHSICHTIGE FLAECHE
// =====================================================================
//
// SCHLUESSELFARBE UND ABSTANDSALPHA -- die eine Rechnung, und warum sie
// nicht einfach "alles mit 40 Prozent" ist.
//
// Ein gleichmaessiges Alpha ueber die ganze Leistenflaeche macht AUCH
// DIE SCHRIFT durchsichtig. Genau daran zerbricht die Zusage "4,5:1"
// der Runde THEME: weisse Leistenschrift, zu 40 Prozent ueber ein
// helles Hintergrundbild gemischt, hat gegen denselben Grund gemessen
// keinen Kontrast mehr, sondern 1,6:1 -- unlesbar, und zwar genau auf
// den Bildern, auf denen Transparenz am huebschesten aussieht.
//
// Deshalb bekommt der Kern mit `FM_GLASS_KEY` die Farbe, mit der Ring 3
// die Flaeche ausgefuellt hat, und mischt NACH ABSTAND ZU IHR:
//
//   d = |dr| + |dg| + |db|                    Abstand zur Grundfarbe
//   a = alpha + (100 - alpha) * min(d,96)/96  Deckung dieses Punktes
//
// Ein Punkt der FLAECHE (d = 0) bekommt genau `alpha` und wird
// durchsichtig. Ein Punkt der SCHRIFT (d gross) bekommt 100 und bleibt
// Zahl fuer Zahl so deckend wie vor dieser Runde. Die kantengeglaetteten
// Raender eines Zeichens liegen dazwischen und bekommen dazwischen --
// deshalb `min(d,96)/96` und keine Schwelle: eine Schwelle haette
// Treppen an jeden Buchstaben gemalt.
//
// 96 ist die Zahl, bei der ein Punkt voll deckend wird. Sie ist so
// gewaehlt, dass der Unterschied zwischen zwei benachbarten Flaechen
// desselben Themas (Leistengrund und Knopfgrund liegen in allen zehn
// Vorlagen unter 30 Stufen auseinander) noch MITGEMISCHT wird, ein
// Buchstabe (ueber 300 Stufen in jedem Thema) aber nicht.
//
// DIESE FUNKTION RECHNET NICHT SELBST, SIE RUFT `blend`. Das ist die
// Zusage "genau eine Stelle mischt": hier steht, WIE DECKEND ein Punkt
// ist, und in `blend` steht, was Mischen heisst.
// `schleier` ist die Untergrenze der Lesbarkeit in Helligkeitsstufen:
// SCHLEIER fuer die Leiste, SCHLEIER_WIN fuer ein gewoehnliches
// Fenster. Sie steht als ARGUMENT und nicht als stille Statische, weil
// sonst der Aufrufer, der sie zuletzt gesetzt hat, ueber das Bild des
// naechsten entscheidet -- derselbe Fehler, den `gaist_an` fuer die
// Zaehlung nur deshalb nicht macht, weil dort jeder Aufrufer sie
// hinterher wieder abschaltet.
fn glass_mix(alt: u64, neu: u64, key: u64, alpha: u64,
    schleier: u64) -> u64 {
    if alpha >= 100 {
        return neu
    }
    // ============================================ RUNDE GLAS (fix-r4-2)
    // DIE TEXTPLATTE STICHT JEDES ALPHA.
    //
    // Ring 3 setzt die Marke `PLATTE_MARKE` in die oberen acht Bit
    // jedes Bildpunktes, auf dem Schrift steht (kernel/user/wlibc.fi,
    // `platte`). Ein markierter Bildpunkt wird nicht gemischt, sondern
    // genommen, wie er ist -- OHNE die Marke, denn in den Bildspeicher
    // gehoert eine Farbe und kein Merkzettel.
    //
    // Das ist die Stelle, an der die Lesbarkeit einer Fensterschrift
    // ab jetzt haengt, und sie kostet einen Vergleich je Bildpunkt.
    // Vorher hing sie am Schleier `SCHLEIER_WIN`, der die GANZE
    // Fensterflaeche deckender machte -- also auch jeden Bildpunkt, auf
    // dem gar nichts steht.
    //
    // VERGLICHEN WIRD DAS GANZE OKTETT UND NICHT EIN BIT: in den
    // oberen acht Bit eines Fensterbildpunktes steht nicht nur diese
    // Marke. Die Vektorbruecke von Ring 3 legt dort das Alpha ihrer
    // eigenen Mischung ab (255 fuer eine gedeckte Flaeche), und eine
    // Abfrage auf "irgendein Bit gesetzt" haette damit jede von ihr
    // gemalte Flaeche fuer eine Textplatte gehalten -- gemessen: die
    // Karten der Seite "Darstellung" blieben bei `window_alpha=55`
    // vollstaendig deckend.
    if (neu >> 24) == (PLATTE_MARKE >> 24) {
        return neu & 0xFFFFFF
    }
    let nr: u64 = (neu >> 16) & 0xFF
    let ng: u64 = (neu >> 8) & 0xFF
    let nb: u64 = neu & 0xFF
    let kr: u64 = (key >> 16) & 0xFF
    let kg: u64 = (key >> 8) & 0xFF
    let kb: u64 = key & 0xFF
    var d: u64 = 0
    if nr > kr {
        d = d + (nr - kr)
    } else {
        d = d + (kr - nr)
    }
    if ng > kg {
        d = d + (ng - kg)
    } else {
        d = d + (kg - ng)
    }
    if nb > kb {
        d = d + (nb - kb)
    } else {
        d = d + (kb - nb)
    }
    if d > 96 {
        d = 96
    }
    var a: u64 = alpha + (100 - alpha) * d / 96
    // ================================================= RUNDE GLAS
    //
    // DER SCHLEIER -- DIE UNTERGRENZE DER LESBARKEIT, UND SIE IST HIER
    // NOETIG, WEIL DAS ABSTANDSALPHA ALLEIN SIE NICHT HAELT.
    //
    // Das Abstandsalpha haelt die SCHRIFT deckend. Der Kontrast einer
    // Schrift misst sich aber gegen den Grund NEBEN ihr, und der ist ab
    // dieser Runde nicht mehr die Themenfarbe, sondern die Mischung aus
    // ihr und dem Hintergrundbild. GEMESSEN am laufenden System: helles
    // Thema (Leiste #ffffff, Schrift #0f172a, Kontrast 17,8:1) bei
    // taskbar_alpha=40 ueber einem DUNKLEN Hintergrundbild -- die
    // Leistenflaeche kam als (114,116,122) heraus und der Kontrast der
    // Schrift dagegen als 3,76:1. Unter der Latte, und zwar genau auf
    // dem Bild, auf dem Transparenz am huebschesten aussieht.
    //
    // Also darf sich die FLAECHE nur begrenzt weit von ihrer eigenen
    // Farbe entfernen. Die Helligkeit einer Mischung ist in dieser
    // Gewichtung linear, also loest sich die Bedingung
    // |L(misch) - L(key)| <= SCHLEIER direkt nach der Deckung auf:
    //
    //     (100 - a) * |L(grund) - L(key)| / 100 <= SCHLEIER
    //     a >= 100 - SCHLEIER * 100 / |L(grund) - L(key)|
    //
    // Das ist kein Deckel auf den Regler: ueber einem Hintergrundbild,
    // das der Leistenfarbe ohnehin nahe ist, greift die Schranke NICHT
    // und die Leiste ist so durchsichtig, wie der Regler sagt. Sie
    // greift genau dort, wo sie muss -- und sie ist Bildpunkt fuer
    // Bildpunkt und nicht fuer die ganze Flaeche, weil ein gemustertes
    // Hintergrundbild beides unter derselben Leiste hat.
    let lg: u64 = hell_von(alt)
    let lk: u64 = hell_von(key)
    var dl: u64 = 0
    if lg > lk {
        dl = lg - lk
    } else {
        dl = lk - lg
    }
    // RUNDE GLAS (fix-r4-2): `schleier == 0` HEISST "KEIN SCHLEIER" UND
    // NICHT "GAR NICHTS DARF DURCH".
    //
    // Die Rechnung darunter loest |L(misch) - L(key)| <= schleier nach
    // der Deckung auf. Fuer schleier = 0 ist die Loesung a = 100 --
    // mathematisch richtig und als Regel genau verkehrt herum: ein
    // Fenster, das seine Lesbarkeit ueber die Textplatte holt und
    // deshalb KEINEN Schleier braucht, waere damit vollstaendig
    // deckend geworden. Gemessen, bevor diese Zeile stand: ein Fenster
    // bei 55 Prozent unterschied sich in 114 von 41 000 abgetasteten
    // Bildpunkten von demselben Fenster bei 100 Prozent.
    if schleier > 0 && dl > schleier {
        let amin: u64 = 100 - schleier * 100 / dl
        if amin > a {
            a = amin
            // ============================== RUNDE GLAS (NACHTRAG)
            // DER SCHLEIER SCHREIBT DEN REGLER STILL UEBER -- ALSO
            // SAGT ER ES JETZT.
            //
            // Bis hierher hob diese Zeile das Alpha an und niemand
            // erfuhr davon: der Regler sagte 40 Prozent, die Leiste
            // stand ueber einem dunklen Bild in Wahrheit bei 83, und
            // die Aufnahme "Leiste bei 40 %" zeigte etwas, das es
            // nicht gab. Eine Untergrenze, die man nicht sieht, ist
            // von einem Fehler nicht zu unterscheiden.
            //
            // Gezaehlt wird hier, wo es passiert, und nicht
            // nachgerechnet: `gaist_hoch` ist die Zahl der
            // angehobenen Bildpunkte, `gaist_max` das groesste
            // wirklich benutzte Alpha. Beides sind zwei Vergleiche je
            // Bildpunkt und steht in der Zeile `wm: glas alpha_soll=
            // alpha_ist=`, die `glas_bericht` am Ende des Laufs
            // schreibt.
            if gaist_an != 0 {
                gaist_hoch = gaist_hoch + 1
            }
        }
    }
    // GEZAEHLT WIRD NUR DIE LEISTE. Dieselbe Funktion mischt auch
    // gewoehnliche Fenster (`window_alpha`); wer beides in eine Zahl
    // wirft, meldet fuer die Leiste einen Wert, der von einem Fenster
    // stammt. `gaist_an` setzt der Aufrufer, und nur er weiss, welches
    // Fenster er gerade mischt.
    if gaist_an != 0 {
        gaist_px = gaist_px + 1
        gaist_sum = gaist_sum + a
        if a > gaist_max {
            gaist_max = a
        }
    }
    return blend(alt, neu, a * 255 / 100)
}

// DIE ZAHLEN ZUM SCHLEIER. Sie liegen in Statischen und nicht im
// Zustandsblock, weil `glass_mix` je Bildpunkt laeuft und kein
// `state` in der Hand hat -- dieselbe Bauart wie `cg_treffer` weiter
// oben.
static mut gaist_max: u64 = 0 // groesstes wirklich benutztes Alpha, Prozent
static mut gaist_sum: u64 = 0 // Summe der benutzten Alphas (fuer den Schnitt)
static mut gaist_hoch: u64 = 0 // Bildpunkte, die der Schleier angehoben hat
static mut gaist_px: u64 = 0 // Bildpunkte, die ueberhaupt gemischt wurden
static mut gaist_an: u64 = 0 // 1, solange die LEISTE gemischt wird
static mut ga_blits: u64 = 0 // r368: wie oft die Leiste gemischt wurde (fuer die Alphazeile)

fn glass_stat_an(on: bool) {
    if on {
        gaist_an = 1
    } else {
        gaist_an = 0
    }
}

// WAS DER REGLER WIRKLICH BEWIRKT. Die Stellung des Reglers ist
// `form_or(FM_TB_ALPHA)`; `tb_alpha_ist` ist das MITTLERE Alpha, mit
// dem die Leistenflaeche in diesem Lauf wirklich gemischt wurde.
//
// Der Schnitt und nicht das Groesste: ueber einem gemusterten Bild
// hebt der Schleier an den fernsten Bildpunkten bis auf 100 an, und
// "100" neben dem Regler waere genauso falsch wie die 40, die vorher
// dastand -- die Leiste scheint ja durch. Der Schnitt ist die Zahl,
// die einem Menschen sagt, wie deckend die Leiste aussieht;
// `alpha_max` steht in der Meldezeile daneben.
fn tb_alpha_ist(state: u64) -> u64 {
    let soll: u64 = form_or(state, FM_TB_ALPHA, 100)
    if gaist_px == 0 {
        return soll
    }
    let m: u64 = gaist_sum / gaist_px
    if m < soll {
        return soll
    }
    return m
}

fn tb_alpha_hoch(state: u64) -> u64 {
    return gaist_hoch
}

// EINE BILDZEILE AUS EINEM FENSTERPUFFER, GEMISCHT.
//
// Das Gegenstueck zu `fb_row` -- und `fb_row` bleibt wortgleich stehen
// und bleibt der Weg bei `alpha >= 100`. Damit ist die Zusage "bei
// voller Deckung malt dieser Server Bildpunkt fuer Bildpunkt wie vorher"
// nicht behauptet, sondern baulich: bei 100 Prozent laeuft dieselbe
// wortweise Kopie wie vor der Runde, und diese Funktion wird nicht
// einmal betreten.
//
// `grund` ist die Zeile, gegen die gemischt wird: 0 heisst "das, was
// schon im Zweitpuffer steht" (Hintergrund und alle tieferen Fenster,
// zu diesem Zeitpunkt fertig gemalt), sonst die Adresse einer Zeile des
// Milchglasstreifens.
// `schleier` reicht die Untergrenze der Lesbarkeit durch: der
// Aufrufer weiss, ob er die LEISTE malt oder ein gewoehnliches
// Fenster, und `glass_mix` soll es nicht raten muessen.
fn fb_row_a(state: u64, x: u64, y: u64, src: u64, n: u64, alpha: u64,
    key: u64, grund: u64, schleier: u64) {
    if y < fb.band_lo(state) {
        return
    }
    let ziel: u64 = fb.draw_at(state) +% y *% fb.pitch(state) +% x *% 4
    var i: u64 = 0
    while i < n {
        let neu: u64 = __mmio_read32((src +% i *% 4) as *mut u32) as u64
        var alt: u64 = 0
        if grund != 0 {
            alt = __mmio_read32((grund +% i *% 4) as *mut u32) as u64
        } else {
            alt = __mmio_read32((ziel +% i *% 4) as *mut u32) as u64
        }
        __mmio_write32((ziel +% i *% 4) as *mut u32,
            glass_mix(alt, neu, key, alpha, schleier) as u32)
        i = i + 1
    }
}

// =====================================================================
// RUNDE GLAS: DAS MILCHGLAS
// =====================================================================
//
// DER STREIFENPUFFER UND SEINE OBERGRENZE.
//
// 3840 mal 64 Bildpunkte, also 960 KiB. Die Breite ist die eines
// 4K-Schirms, die Hoehe das Anderthalbfache der groessten Leiste, die
// dieses System aufsetzt (40 Bildpunkte bei Vervielfachung 1, 60 bei 2
// -- taskbar.fi rechnet sie aus der Schriftgroesse). IST DIE LEISTE
// GROESSER, BLEIBT DAS MILCHGLAS AUS, und zwar ganz: ein Weichzeichner,
// der nur die linken 3840 Spalten erwischt, malt eine sichtbare Kante
// mitten in die Leiste, und ein halb wirkender Schmuck ist schlimmer
// als gar keiner.
const GLASS_W: u64 = 3840
const GLASS_H: u64 = 64
// RUNDE GLAS (fix-r4-4): DIE OBERGRENZE IST EINE FLAECHE, NICHT EINE
// HOEHE.
//
// Solange nur die Leiste Glas bekam, war "3840 mal 64" beides in einem:
// die Breite eines 4K-Schirms und anderthalb Leistenhoehen. Unter einem
// durchsichtigen FENSTER ist die Hoehe eine andere -- das
// Einstellungsfenster dieser Abnahme ist 760 x 566 --, und die Frage
// ist nicht mehr "wie hoch", sondern "passt es in den Puffer". Gezaehlt
// wird deshalb die Flaeche: 460 800 Bildpunkte sind 1,8 MiB je Streifen
// und decken jedes Fenster ab, das auf einen Schirm von 1280 x 800
// passt. Was nicht hineinpasst, bekommt KEIN Glas -- ein halb
// weichgezeichnetes Fenster mit einer Kante in der Mitte waere
// schlimmer als gar keines, und das war schon die Regel der Leiste.
// r368: 655 360 (it was 460 800). The settings window is 760 x 640 since its page
// stands on the scene tree (it was 760 x 566): 486 400 pixels did not fit the
// old strip, `glass_prepare` refused it and the window got NO frosting at all
// (11c4 measured one flat colour where the pattern's edge should have become a
// gradient). 655 360 = 1024 x 640 covers every window of this system on a
// 1280 x 800 screen; the two strips cost 2.5 MiB of `.bss` each and not one
// octet in the image.
const GLASS_PX: u64 = 1048576
// Um wie viele Stufen der weichgezeichnete Untergrund gegen die
// Grundfarbe verschoben wird: heller unter einem hellen Satz, dunkler
// unter einem dunklen. Ohne diesen Schritt bleibt das Glas genau so
// hell wie das, was darunter liegt, und die Leiste verschwindet auf
// einem mittelhellen Hintergrundbild ganz. 24 Stufen sind sichtbar und
// kippen keinen Farbton.
const GLASS_TINT: u64 = 24
static mut gl_puf: [u32; 1048576] = [0 as u32; 1048576]
// DER ZWEITE STREIFEN, UND WARUM ER SICH LOHNT.
//
// Ein Kastendurchgang kann nicht in denselben Puffer schreiben, aus dem
// er noch liest -- die laufende Summe braucht die Quelle noch. Die
// erste Fassung hat deshalb je Linie in eine Zwischenzeile geschrieben
// und danach zurueckkopiert: das sind ZWEI Durchlaeufe ueber jeden
// Bildpunkt statt einem, also 215 040 statt 107 520 Schleifendurchgaengen
// je Vollbild. Mit zwei Streifen, zwischen denen die drei Durchgaenge
// hin und her laufen, faellt das Zurueckkopieren ganz weg; die
// Einfaerbung am Ende ist dann der eine Durchlauf, der ohnehin sein
// musste. Gemessen im Gast (TCG, 896 x 40, r = 8): 52 435 gegen
// 30 000 Mikrosekunden.
static mut gl_alt: [u32; 1048576] = [0 as u32; 1048576]

// EINE LINIE KASTENWEICHZEICHNER MIT LAUFENDER SUMME -- DIE EINE
// STELLE, an der ueberhaupt weichgezeichnet wird. Waagerecht und
// senkrecht sind derselbe Rumpf mit einem anderen Schritt (`sb`, dem
// Abstand zweier Nachbarn in Oktetten); zwei Fassungen waeren zwei Orte
// fuer dieselbe Sache gewesen.
//
// WARUM LAUFENDE SUMME UND NICHT DIE NAIVE SCHLEIFE: naiv kostet ein
// Bildpunkt 2r+1 Additionen, also bei r = 16 das 33-fache. Hier kostet
// er EINE Addition und EINE Subtraktion je Kanal, unabhaengig von r --
// und genau das ist der Unterschied zwischen 60 Bildern und Ruckeln.
// `tools/themestore/run.sh` misst es an der Zeit: `us` bei r = 16 darf
// hoechstens das 1,3-fache von `us` bei r = 4 sein.
//
// Am Rand zaehlt der Randpunkt mehrfach (statt einer Null ausserhalb).
// Eine Null dort haette einen dunklen Saum an jede Kante der Leiste
// gemalt, und der sieht aus wie ein Fehler, weil er einer ist.
//
// MIT ADRESSEN UND NICHT MIT FELDINDIZES, und das ist gemessen: der
// Uebersetzer legt vor jeden Feldzugriff eine Bereichspruefung, und
// dieser Rumpf macht sechs davon je Bildpunkt.
fn blur_line(qadr: u64, zadr: u64, sb: u64, n: u64, r: u64) {
    comp.blur_line(qadr, zadr, sb, n, r)
}

// DREI DURCHGAENGE: waagerecht, senkrecht, waagerecht. Drei Kaesten
// hintereinander sind die uebliche ganzzahlige Annaeherung an eine
// Gaussglocke; einer allein sieht nach Bewegungsunschaerfe aus, weil
// seine Kante hart bleibt.
//
// Der Streifen wandert dabei gl_puf -> gl_alt -> gl_puf -> gl_alt; das
// Ergebnis steht also in `gl_alt`, und der Rufer holt es sich von dort.
fn glass_blur(w: u64, h: u64, r: u64) {
    if r == 0 {
        return
    }
    let a: u64 = (&gl_puf[0]) as u64
    let b: u64 = (&gl_alt[0]) as u64
    var y: u64 = 0
    while y < h {
        blur_line(a +% y *% w *% 4, b +% y *% w *% 4, 4, w, r)
        y = y + 1
    }
    var x: u64 = 0
    while x < w {
        blur_line(b +% x *% 4, a +% x *% 4, w *% 4, h, r)
        x = x + 1
    }
    y = 0
    while y < h {
        blur_line(a +% y *% w *% 4, b +% y *% w *% 4, 4, w, r)
        y = y + 1
    }
}

// Helligkeit einer Farbe in Hundertsteln, nach derselben Gewichtung,
// die `wlibc` fuer die Kontrastrechnung benutzt.
fn hell_von(c: u64) -> u64 {
    return (((c >> 16) & 0xFF) * 299 + ((c >> 8) & 0xFF) * 587
        + (c & 0xFF) * 114) / 1000
}

// DEN AUSSCHNITT UNTER DER LEISTE HOLEN, WEICHZEICHNEN, EINFAERBEN.
//
// Liefert die Adresse des Streifens oder 0, wenn kein Milchglas moeglich
// ist. Der Streifen ist danach der `grund` fuer `fb_row_a`.
//
// DER ZWISCHENSPEICHER UND SEINE BEDINGUNG. Die Uhr in der Leiste malt
// jede Sekunde neu, obwohl sich unter der Leiste nichts geaendert hat;
// ohne Zwischenspeicher waere das Milchglas sechzigmal in der Sekunde
// neu gerechnet worden. `S_GLASSGEN` steigt genau dann, wenn ein
// Fenster UNTER der Leiste gemalt, bewegt, geoeffnet oder geschlossen
// wurde (siehe `glass_touch`). Ist der Stand derselbe und sind
// Rechteck und Radius unveraendert, wird der Streifen wiederverwendet.
static mut gl_src_hash: u64 = 0

fn glass_source_hash(state: u64, gx: u64, gy: u64, w: u64, h: u64,
    key: u64) -> u64 {
    var acc: u64 = key ^ 0x9E3779B97F4A7C15
    let words: u64 = w / 2
    var row: u64 = 0
    while row < h {
        let q: u64 = fb.draw_at(state) +% (gy + row) *% fb.pitch(state) +%
            gx *% 4
        var k: u64 = 0
        while k < words {
            acc = (acc ^ __mmio_read64((q +% k *% 8) as *mut u64))
                *% 0x100000001B3
            acc = acc ^ (acc >> 29)
            k = k + 1
        }
        if (w & 1) != 0 {
            acc = (acc ^ __mmio_read32((q +% (w - 1) *% 4) as *mut u32) as u64)
                *% 0x100000001B3
            acc = acc ^ (acc >> 29)
        }
        row = row + 1
    }
    return acc
}

fn glass_prepare(state: u64, x: i64, y: i64, w: u64, h: u64,
    r: u64) -> u64 {
    if r == 0 || w == 0 || h == 0 {
        return 0
    }
    if w > GLASS_W || w *% h > GLASS_PX {
        return 0
    }
    if x < 0 || y < 0 {
        return 0
    }
    let gx: u64 = x as u64
    let gy: u64 = y as u64
    let basis: u64 = (&gl_puf[0]) as u64
    ss(state, S_GLRUN, gs(state, S_GLRUN) + 1)
    if gs(state, S_GLVALID) != 0 && gs(state, S_GLX) == gx
        && gs(state, S_GLY) == gy && gs(state, S_GLW) == w
        && gs(state, S_GLH) == h && gs(state, S_GLR) == r
        && gs(state, S_GLGEN) == gs(state, S_GLASSGEN) {
        ss(state, S_GLHIT, gs(state, S_GLHIT) + 1)
        // RUNDE GLAS: AUCH EIN TREFFER ZAEHLT FUER DIE MELDUNG.
        //
        // Der Takt der Meldung stand nur im Rechenweg, also wurde
        // `wm: glas ... cache=` genau einmal geschrieben -- beim ersten
        // Streifen, und dort steht zwangslaeufig `cache=0/1`. Damit
        // war die Zusage "wird der Untergrund nicht veraendert, wird
        // nicht neu gerechnet" nirgends als Zahl zu sehen, und eine
        // Zusage ohne Zahl ist in diesem Baum keine. Jetzt zaehlt
        // jeder Durchlauf, und nach sechzig steht die Trefferquote da.
        ss(state, S_GLSAY, gs(state, S_GLSAY) + 1)
        if gs(state, S_GLSAY) >= 60 {
            ss(state, S_GLSAY, 0)
            glas_say(state)
        }
        return basis
    }
    let src_hash: u64 = glass_source_hash(state, gx, gy, w, h,
        form(state, FM_GLASS_KEY))
    if gs(state, S_GLVALID) != 0 && gs(state, S_GLX) == gx
        && gs(state, S_GLY) == gy && gs(state, S_GLW) == w
        && gs(state, S_GLH) == h && gs(state, S_GLR) == r
        && src_hash == gl_src_hash {
        ss(state, S_GLGEN, gs(state, S_GLASSGEN))
        ss(state, S_GLHIT, gs(state, S_GLHIT) + 1)
        return basis
    }
    let t_anfang: u64 = time.tsc()
    // 1. der schon fertig gemalte Untergrund in den Streifen
    let sbas: u64 = (&gl_puf[0]) as u64
    var row: u64 = 0
    while row < h {
        let q: u64 = fb.draw_at(state) +% (gy + row) *% fb.pitch(state) +%
            gx *% 4
        // Wortweise, ueber `rep movsq` wie in `fb_row`: eine Schleife
        // aus Einzelzugriffen kostet hier gemessen den Faktor acht.
        let z: u64 = sbas +% row *% w *% 4
        copy_words(z, q, w *% 4 / 8)
        if (w & 1) != 0 {
            __mmio_write32((z +% (w - 1) *% 4) as *mut u32,
                __mmio_read32((q +% (w - 1) *% 4) as *mut u32))
        }
        row = row + 1
    }
    // 2. drei Durchgaenge mit laufender Summe
    glass_blur(w, h, r)
    // 3. aufhellen oder abdunkeln, je nachdem, ob der laufende Satz
    //    hell oder dunkel ist. `FM_GLASS_KEY` ist die Grundfarbe der
    //    Leiste und sagt es ohne eine weitere Einstellung.
    let dunkel: bool = hell_von(form(state, FM_GLASS_KEY)) < 128
    let qbas: u64 = (&gl_alt[0]) as u64
    var p: u64 = 0
    let n: u64 = w * h
    while p < n {
        let v: u64 = __mmio_read32((qbas +% p *% 4) as *mut u32) as u64
        var cr: u64 = (v >> 16) & 0xFF
        var cg: u64 = (v >> 8) & 0xFF
        var cb: u64 = v & 0xFF
        if dunkel {
            if cr > GLASS_TINT {
                cr = cr - GLASS_TINT
            } else {
                cr = 0
            }
            if cg > GLASS_TINT {
                cg = cg - GLASS_TINT
            } else {
                cg = 0
            }
            if cb > GLASS_TINT {
                cb = cb - GLASS_TINT
            } else {
                cb = 0
            }
        } else {
            cr = cr + GLASS_TINT
            cg = cg + GLASS_TINT
            cb = cb + GLASS_TINT
            if cr > 255 {
                cr = 255
            }
            if cg > 255 {
                cg = 255
            }
            if cb > 255 {
                cb = 255
            }
        }
        __mmio_write32((sbas +% p *% 4) as *mut u32,
            ((cr << 16) | (cg << 8) | cb) as u32)
        p = p + 1
    }
    // Ob sich die Einstellungen geaendert haben, entscheidet, ob die
    // Meldezeile faellig ist -- eine Zeile je Bild waere kein Bericht,
    // sondern ein Wasserfall.
    let neu_form: bool = gs(state, S_GLVALID) == 0 || gs(state, S_GLW) != w
        || gs(state, S_GLH) != h || gs(state, S_GLR) != r
    ss(state, S_GLX, gx)
    ss(state, S_GLY, gy)
    ss(state, S_GLW, w)
    ss(state, S_GLH, h)
    ss(state, S_GLR, r)
    ss(state, S_GLGEN, gs(state, S_GLASSGEN))
    ss(state, S_GLVALID, 1)
    gl_src_hash = src_hash
    let kh: u64 = time.khz(state)
    if kh >= 1000 {
        let t_ende: u64 = time.tsc()
        if t_ende > t_anfang {
            let us: u64 = (t_ende - t_anfang) / (kh / 1000)
            ss(state, S_GLUS, gs(state, S_GLUS) + us)
            ss(state, S_GLN, gs(state, S_GLN) + 1)
            ss(state, S_GLLAST, us)
            if us > gs(state, S_GLMAX) {
                ss(state, S_GLMAX, us)
            }
        }
    }
    ss(state, S_GLSAY, gs(state, S_GLSAY) + 1)
    if neu_form || gs(state, S_GLSAY) >= 60 {
        ss(state, S_GLSAY, 0)
        glas_say(state)
    }
    return basis
}

// DIE ZAHL, DIE DAS MILCHGLAS BELEGT -- eine Zeile, und in ihr steht
// alles, was die Abnahme braucht: der Radius, die Flaeche, die
// gemessene Zeit je Vollbild, die laengste gemessene Zeit und die
// Trefferquote des Zwischenspeichers. `key=` ist die Schluesselfarbe;
// steht dort eine andere Zahl als in `taskbar: glas ... key=`, mischt
// der Kern gegen etwas, das die Leiste nie gemalt hat.
static mut gl_a: [u8; 13] = "wm: glas r=\0\0"
static mut gl_b: [u8; 5] = " px=\0"
static mut gl_c: [u8; 5] = " us=\0"
static mut gl_d: [u8; 6] = " max=\0"
static mut gl_e: [u8; 8] = " cache=\0"
static mut gl_f: [u8; 2] = "/\0"
static mut gl_g: [u8; 6] = " key=\0"
static mut gl_h: [u8; 17] = "0123456789abcdef\0"
static mut gl_x: [u8; 7] = "000000\0"

fn glas_hex6(v: u64) {
    var i: u64 = 0
    while i < 6 {
        let d: u64 = (v >> ((5 - i) * 4)) & 15
        gl_x[(i) as usize] = gl_h[(d) as usize]
        i = i + 1
    }
}

fn glas_say(state: u64) {
    serial.puts((&gl_a[0]) as u64)
    serial.dec(gs(state, S_GLR))
    serial.puts((&gl_b[0]) as u64)
    serial.dec(gs(state, S_GLW) * gs(state, S_GLH))
    serial.puts((&gl_c[0]) as u64)
    serial.dec(gs(state, S_GLLAST))
    serial.puts((&gl_d[0]) as u64)
    serial.dec(gs(state, S_GLMAX))
    serial.puts((&gl_e[0]) as u64)
    serial.dec(gs(state, S_GLHIT))
    serial.puts((&gl_f[0]) as u64)
    serial.dec(gs(state, S_GLRUN))
    serial.puts((&gl_g[0]) as u64)
    glas_hex6(form(state, FM_GLASS_KEY))
    serial.puts((&gl_x[0]) as u64)
    serial.nl()
}

// DER UNTERGRUND HAT SICH GEAENDERT -- und das ist NICHT dasselbe wie
// "die Leiste wird neu gemalt".
//
// `compose` malt in jeder Bildrunde den ganzen Schmutzbereich neu, also
// auch die Flaeche unter der Leiste; dabei kommt aber Bildpunkt fuer
// Bildpunkt dasselbe heraus, solange kein Fenster darunter sich geruehrt
// hat. Deshalb steigt der Stand hier -- an der einen Stelle, durch die
// JEDE Inhalts-, Groessen- und Ortsaenderung eines Fensters geht
// (`flush_win`, `move_win`, `resize_win`, `raise`, `destroy` rufen alle
// `damage_win`) -- und nicht im Zusammensetzen.
// DIE ZAHL ZUR SCHLIERENREGEL. `grow=` ist, wie oft ein Schmutzrechteck
// auf die volle Leiste aufgezogen wurde, `aus=` sagt, ob die Regel
// ueberhaupt an ist (`noglasgrow` schaltet sie ab). Ohne diese beiden
// Zahlen waere "es bleiben keine Schlieren stehen" eine Aussage ueber
// eine Regel, von der niemand weiss, ob sie je gelaufen ist.
static mut sl_a: [u8; 20] = "wm: schlieren grow=\0"
static mut sl_b: [u8; 8] = " alpha=\0"
static mut sl_c: [u8; 7] = " blur=\0"
static mut sl_d: [u8; 6] = " aus=\0"
// RUNDE GLAS (NACHTRAG): die Schnittflaeche mit der Leiste, in
// Bildpunkten. Siehe `unter_leiste_messen`.
static mut sl_e: [u8; 10] = " unterpx=\0"

fn schlieren_say(state: u64) {
    serial.puts((&sl_a[0]) as u64)
    serial.dec(gs(state, S_PANELGROW))
    serial.puts((&sl_b[0]) as u64)
    serial.dec(form_or(state, FM_TB_ALPHA, 100))
    serial.puts((&sl_c[0]) as u64)
    serial.dec(form(state, FM_BLUR))
    serial.puts((&sl_d[0]) as u64)
    serial.dec(gs(state, S_NOGROW))
    serial.puts((&sl_e[0]) as u64)
    serial.dec(gs(state, S_UNTERPX))
    serial.nl()
}

// ================================================ RUNDE GLAS (fix-r4-3)
// DAS AEUSSERE RECHTECK DES FENSTERS UND SEIN RADIUS.
//
//     wm: rahmen x=20 y=3 w=764 h=590 r=24
//
// Ohne diese Zeile kennt die Abnahme nur die OBERE LINKE Ecke: sie
// nimmt `settings: rect name=win`, und das ist die Flaeche, die das
// Programm bekommen hat -- nicht die, die der Server malt. Wer die
// unteren Ecken messen will, braucht die untere Kante, und die weiss
// nur der Server (Rahmenbreite und Titelhoehe sind Formmarken und
// aendern sich mit dem Aussehen). Gemeldet wird nur bei AENDERUNG, und
// nur fuer das Fenster mit dem Fokus: ein Malvorgang je Bildrunde mal
// zwanzig Sekunden waere eine Meldung, die niemand liest.
static mut rh_x: u64 = 0xFFFFFFFFFFFFFFFF
static mut rh_y: u64 = 0
static mut rh_w: u64 = 0
static mut rh_h: u64 = 0
static mut rh_r: u64 = 0
static mut rh_a: [u8; 14] = "wm: rahmen x=\0"
static mut rh_b: [u8; 4] = " y=\0"
static mut rh_c: [u8; 4] = " w=\0"
static mut rh_d: [u8; 4] = " h=\0"
static mut rh_e: [u8; 4] = " r=\0"

fn rahmen_say(x: i64, y: i64, w: i64, h: i64, r: u64) {
    if x < 0 || y < 0 || w <= 0 || h <= 0 {
        return
    }
    let xu: u64 = x as u64
    let yu: u64 = y as u64
    let wu: u64 = w as u64
    let hu: u64 = h as u64
    if rh_x == xu && rh_y == yu && rh_w == wu && rh_h == hu && rh_r == r {
        return
    }
    rh_x = xu
    rh_y = yu
    rh_w = wu
    rh_h = hu
    rh_r = r
    serial.puts((&rh_a[0]) as u64)
    serial.dec(xu)
    serial.puts((&rh_b[0]) as u64)
    serial.dec(yu)
    serial.puts((&rh_c[0]) as u64)
    serial.dec(wu)
    serial.puts((&rh_d[0]) as u64)
    serial.dec(hu)
    serial.puts((&rh_e[0]) as u64)
    serial.dec(r)
    serial.nl()
}

// ================================================ RUNDE GLAS (NACHTRAG)
// WAS DER REGLER SAGT UND WAS WIRKLICH GEMALT WURDE.
//
//     wm: glas alpha_soll=40 alpha_ist=83 hoch=27412 px=35840
//
// `alpha_soll` ist die Stellung des Reglers, `alpha_ist` das groesste
// Alpha, mit dem in diesem Lauf wirklich gemischt wurde, `hoch` die
// Zahl der Bildpunkte, an denen der Schleier (die Lesbarkeitsschranke
// in `glass_mix`) angehoben hat, und `px` die Zahl der gemischten
// Bildpunkte insgesamt. Ohne diese Zeile heisst eine Aufnahme
// "Leiste bei 40 %", obwohl ueber einem dunklen Bild 83 Prozent
// gemalt wurden -- das war der Befund an Bild 11.
static mut al_a: [u8; 22] = "wm: glas alpha_soll=\0\0"
static mut al_b: [u8; 12] = " alpha_ist=\0"
static mut al_c: [u8; 7] = " hoch=\0"
static mut al_d: [u8; 5] = " px=\0"
static mut al_e: [u8; 12] = " alpha_max=\0"

fn glas_alpha_say(state: u64) {
    serial.puts((&al_a[0]) as u64)
    serial.dec(form_or(state, FM_TB_ALPHA, 100))
    serial.puts((&al_b[0]) as u64)
    serial.dec(tb_alpha_ist(state))
    serial.puts((&al_e[0]) as u64)
    serial.dec(gaist_max)
    serial.puts((&al_c[0]) as u64)
    serial.dec(gaist_hoch)
    serial.puts((&al_d[0]) as u64)
    serial.dec(gaist_px)
    serial.nl()
}

// RUNDE GLAS: DIE SCHLUSSZEILE ZUM MILCHGLAS.
//
// `glas_say` schreibt im Betrieb nur alle sechzig Durchlaeufe, sonst
// stuende im Bildtakt ein Wasserfall auf der Leitung. Genau dadurch
// war die Trefferquote des Zwischenspeichers nie zu sehen: die einzige
// Zeile eines Laufs ist die des ERSTEN Streifens, und dort steht
// zwangslaeufig `cache=0/1`. Am Ende eines Laufs -- dort, wo `kgui`
// ohnehin seine Zahlen schreibt -- kostet eine Zeile nichts und sagt,
// wie oft wirklich gerechnet und wie oft wiederverwendet wurde.
fn glas_bericht(state: u64) {
    // DIE ALPHAZEILE STEHT VOR DEM AUSSTIEG. Gemischt wird auch ohne
    // Milchglas (`taskbar_alpha` allein braucht keinen Streifen), und
    // genau dieser Fall -- 40 Prozent ueber einem dunklen Bild -- ist
    // der, in dem der Schleier anhebt und es bisher niemand erfuhr.
    //
    // ZUSAMMENFUEHRUNG: SIE STEHT JETZT IMMER DA, AUCH MIT px=0.
    //
    // Hier stand `if gaist_px > 0`, und das war eine Bedingung ueber
    // den ZUFALL, wie weit der Server in seinem Zeitfenster gekommen
    // ist. Auf diesem Baum dauert ein Vollcompose 1,5 Sekunden (auf
    // dem Zweig GLAS 33 Millisekunden, gemessen mit `wmbench` -- die
    // Zahl gehoert der Runde BLUR und ist aelter als dieses
    // Zusammenfuehren): der Messlauf von `tools/themestore/run.sh`
    // schafft in zwanzig Sekunden genau einen Blit der Leiste, und der
    // faellt HINTER diese Zeile. Die Zeile fehlte dann ganz, und
    // sechzehn Zusagen von Abschnitt 11 lasen eine leere
    // Zeichenkette -- ein Messgeraet, das schweigt, statt eine Null zu
    // melden.
    //
    // `px=0` IST eine Aussage: "in diesem Lauf wurde kein Bildpunkt
    // der Leiste gemischt". Wer sie liest, weiss danach mehr als
    // vorher; eine fehlende Zeile sagt gar nichts. `hoch=0` ist dann
    // ebenfalls wahr -- angehoben wurde nichts, weil nichts gemischt
    // wurde --, und `alpha_ist` liefert schon immer die Reglerstellung,
    // wenn nichts gemessen wurde (siehe `tb_alpha_ist`).
    glas_alpha_say(state)
    // UND DIE SCHLIERENZEILE AM ENDE DES LAUFS. Im Betrieb schreibt
    // sie sich beim ersten Aufziehen und danach alle fuenfhundert --
    // die Schnittflaeche mit der Leiste (`unterpx=`) waechst aber
    // waehrend eines Zuges, und die frueh geschriebene Zeile traegt
    // deshalb eine Null, die nichts bedeutet. Diese hier traegt den
    // Stand, zu dem die Aufnahme entstanden ist.
    schlieren_say(state)
    if gs(state, S_GLRUN) == 0 {
        return
    }
    glas_say(state)
}

fn glass_touch(state: u64, i: u64) {
    if gs(state, S_GLVALID) == 0 {
        return
    }
    let pw: u64 = panel_win(state)
    if pw < MAX_WIN && i == pw {
        return
    }
    if pw >= MAX_WIN {
        ss(state, S_GLASSGEN, gs(state, S_GLASSGEN) + 1)
        return
    }
    if !valid(state, i) {
        ss(state, S_GLASSGEN, gs(state, S_GLASSGEN) + 1)
        return
    }
    // Nur, wenn das Fenster das Leistenrechteck ueberhaupt beruehrt.
    let px0: i64 = win_x(state, pw)
    let py0: i64 = win_y(state, pw)
    let px1: i64 = px0 + outer_w(state, pw) as i64
    let py1: i64 = py0 + outer_h(state, pw) as i64
    let wx0: i64 = win_x(state, i)
    let wy0: i64 = win_y(state, i)
    let wx1: i64 = wx0 + outer_w(state, i) as i64
    let wy1: i64 = wy0 + outer_h(state, i) as i64
    if wx1 <= px0 || wx0 >= px1 || wy1 <= py0 || wy0 >= py1 {
        return
    }
    ss(state, S_GLASSGEN, gs(state, S_GLASSGEN) + 1)
}

// Die Ableser fuer die Abnahme. Sie stehen hier, damit
// `tools/themestore/run.sh` die Zahlen holen kann, ohne die Offsets zu
// kennen.
fn glass_gen(state: u64) -> u64 {
    return gs(state, S_GLASSGEN)
}

// ZUSAMMENFUEHRUNG: DIESE DREI HIESSEN AUF DEM ZWEIG GLAS `blur_us`,
// `blur_us_max` und `blur_runs`. Die Runde BLUR hat einen eigenen
// `blur_us` (die Zeit des Acrylfilters, aus `S_BLURUS`), und zwei
// gleichnamige Ableser auf verschiedenen Zaehlern waeren genau der
// zweite Ort fuer dieselbe Sache, den es hier nicht geben darf. Also
// tragen die Zahlen des GLASSTREIFENS jetzt den Namen ihrer Sache.
fn glas_us(state: u64) -> u64 {
    return gs(state, S_GLLAST)
}

fn glas_us_max(state: u64) -> u64 {
    return gs(state, S_GLMAX)
}

fn glas_runs(state: u64) -> u64 {
    return gs(state, S_GLN)
}

fn glass_hits(state: u64) -> u64 {
    return gs(state, S_GLHIT)
}

fn panel_grows(state: u64) -> u64 {
    return gs(state, S_PANELGROW)
}

fn set_noglasgrow(state: u64, on: bool) {
    ss(state, S_NOGROW, 0)
    if on {
        ss(state, S_NOGROW, 1)
    }
}

// =====================================================================
// RUNDE GLAS: DER SELBSTTEST DER MISCHUNG UND DES WEICHZEICHNERS
// =====================================================================
//
// Er steht NICHT in `wm.selftest`. Der laeuft mitten in einer Zeile,
// die `kgui` schreibt ("wm: selftest " + Zahl), und seine Zahl 30 ist
// in einem halben Dutzend Abnahmeskripten festgenagelt. Also eine
// eigene Zahl in einer eigenen Zeile, gerechnet beim Aufsetzen des
// Fensterservers -- und ohne einen einzigen Bildpunkt auf dem Schirm:
// beide gepruefte Funktionen sind rein.
static mut gt_a: [u8; 16] = "wm: glastest \0\0\0"
static mut gt_b: [u8; 4] = " / \0"

fn selftest_glas(state: u64) -> u64 {
    var n: u64 = 0
    // 1. Alpha 100 laesst den neuen Punkt unveraendert -- das ist die
    //    Zusage "bei voller Deckung wie vorher", hier als Zahl.
    if glass_mix(0x000000, 0x204060, 0x204060, 100, SCHLEIER) == 0x204060 {
        n = n + 1
    }
    // 2. Alpha 0 auf der SCHLUESSELFARBE: der Grund bleibt stehen.
    //    d = 0, also a = 0, also kommt der Untergrund heraus.
    if glass_mix(0x112233, 0x204060, 0x204060, 0, SCHLEIER) == 0x112233 {
        n = n + 1
    }
    // 3. Alpha 50 auf der Schluesselfarbe, von Hand gerechnet. Der
    //    Untergrund liegt dicht an der Schluesselfarbe (Helligkeit 112
    //    gegen 128, also 16 Stufen und damit unter SCHLEIER), also
    //    greift die Untergrenze NICHT und es gilt genau a = 50 %:
    //    a255 = 127, und blend(0x707070, 0x808080, 127) ist je Kanal
    //    (128*127 + 112*128 + 127)/255 = 30719/255 = 120 = 0x78.
    if glass_mix(0x707070, 0x808080, 0x808080, 50, SCHLEIER) == 0x787878 {
        n = n + 1
    }
    // 4. UND DER PUNKT, AN DEM DIE LESBARKEIT HAENGT: ein Punkt, der
    //    weit von der Schluesselfarbe weg liegt (weisse Schrift auf
    //    dunklem Grund, d = 3 * 255 = 765 > 96), bleibt bei Alpha 20
    //    VOLL DECKEND. Waere das nicht so, waere die Leistenschrift
    //    durchsichtig und der Kontrast dahin.
    if glass_mix(0x000000, 0xFFFFFF, 0x202020, 20, SCHLEIER) == 0xFFFFFF {
        n = n + 1
    }
    // 5. Der Weichzeichner gegen eine NAIV gerechnete Mitte. Eine Zeile
    //    aus 64 Punkten, deren linke Haelfte 0 und deren rechte 200 ist;
    //    ein einzelner Kastendurchgang mit r = 4 liefert in der Mitte
    //    den Mittelwert der neun Punkte um sie herum. Naiv gerechnet
    //    sind das bei x = 32 die Punkte 28..36, also vier Nullen und
    //    fuenf Zweihunderter: 1000/9 = 111.
    let qa: u64 = (&gl_puf[0]) as u64
    let za: u64 = (&gl_alt[0]) as u64
    var i: u64 = 0
    while i < 64 {
        var v: u64 = 0
        if i >= 32 {
            v = 200
        }
        gl_puf[(i) as usize] = ((v << 16) | (v << 8) | v) as u32
        i = i + 1
    }
    blur_line(qa, za, 4, 64, 4)
    if (gl_alt[(32) as usize] as u64 & 0xFF) == 111 {
        n = n + 1
    }
    // 6. Und dieselbe Zeile SENKRECHT gelesen muss dieselbe Zahl
    //    liefern -- sonst haette der Schritt (`stride`) einen Fehler,
    //    und der faellt an einer Leiste von 40 Zeilen Hoehe sonst nicht
    //    auf.
    i = 0
    while i < 64 {
        var v2: u64 = 0
        if i >= 32 {
            v2 = 200
        }
        gl_puf[(i * 8) as usize] = ((v2 << 16) | (v2 << 8) | v2) as u32
        i = i + 1
    }
    blur_line(qa, za, 32, 64, 4)
    if (gl_alt[(32 * 8) as usize] as u64 & 0xFF) == 111 {
        n = n + 1
    }
    // 7. UND DER SCHLEIER, von Hand gerechnet. Weisse Leiste (Key
    //    0xffffff, Helligkeit 255) ueber schwarzem Grund (Helligkeit 0):
    //    dl = 255, also amin = 100 - 40*100/255 = 85 Prozent -- und
    //    nicht die 20, die der Regler sagt. a255 = 216, und
    //    blend(0x000000, 0xffffff, 216) ist je Kanal
    //    (255*216 + 0 + 127)/255 = 55207/255 = 216 = 0xd8.
    //    Gegen die dunkle Leistenschrift #0f172a sind das 12,1:1 und
    //    damit ueber der Latte; ohne den Schleier waeren es 1,6:1.
    // NACHTRAG 2: die Zahl steht hier AUSGESCHRIEBEN und nicht mehr als
    // `SCHLEIER`. Geprueft wird die ARITHMETIK der Untergrenze, nicht
    // die Entscheidung, ob die Leiste eine haben soll -- die Leiste hat
    // seit diesem Nachtrag keine mehr (`SCHLEIER` ist 0, ihre
    // Lesbarkeit traegt die Textplatte). Mit der Konstante im Aufruf
    // haette dieser Fall die Politik gemessen und waere beim Umstellen
    // rot geworden, obwohl die Rechnung stimmt.
    if glass_mix(0x000000, 0xFFFFFF, 0xFFFFFF, 20, 40) == 0xD8D8D8 {
        n = n + 1
    }
    // 7b. UND DIE LEISTE SELBST HAT KEINE UNTERGRENZE MEHR: derselbe
    //     Punkt mit `SCHLEIER` bleibt bei zwanzig Prozent, und derselbe
    //     Punkt mit der Marke der Textplatte kommt deckend zurueck.
    //     Das ist die Zusage in zwei Zeilen: die Flaeche ist so
    //     durchsichtig, wie der Regler sagt, die Schrift darauf nicht.
    if glass_mix(0x000000, 0xFFFFFF, 0xFFFFFF, 20, SCHLEIER) == 0x333333
        && glass_mix(0x000000, PLATTE_MARKE | 0xFFFFFF, 0xFFFFFF, 20,
            SCHLEIER) == 0xFFFFFF {
        n = n + 1
    }
    // 8. UND DERSELBE FALL FUER EIN GEWOEHNLICHES FENSTER -- ZWEIMAL,
    //    denn dort hat sich mit fix-r4-2 beides geaendert.
    //
    //    OHNE MARKE: `SCHLEIER_WIN` ist 0, der Schleier greift also
    //    gar nicht mehr (hier stand bis fix-r4-2 eine 20, und die hob
    //    denselben Punkt still auf 93 Prozent an). Zwanzig Prozent
    //    sind damit zwanzig Prozent: a255 = 20*255/100 = 51, und
    //    blend(0x000000, 0xffffff, 51) ist je Kanal
    //    (255*51 + 0 + 127)/255 = 13132/255 = 51 = 0x33.
    //
    //    MIT MARKE: derselbe Punkt, aber mit `PLATTE_MARKE` in den
    //    oberen acht Bit -- also ein Punkt, auf dem Schrift steht. Er
    //    kommt unveraendert zurueck UND OHNE DIE MARKE; stuende sie
    //    noch darin, liefe sie in den Bildspeicher.
    //
    //    Zusammen sind das die zwei Haelften der neuen Zusage: die
    //    Flaeche ist so durchsichtig, wie der Regler sagt, und die
    //    Zeile darauf ist es nicht.
    if glass_mix(0x000000, 0xFFFFFF, 0xFFFFFF, 20, SCHLEIER_WIN)
            == 0x333333
        && glass_mix(0x000000, PLATTE_MARKE | 0xFFFFFF, 0xFFFFFF, 20,
            SCHLEIER_WIN) == 0xFFFFFF {
        n = n + 1
    }
    // Der Streifen ist jetzt Prueffarbe und kein Untergrund mehr.
    ss(state, S_GLVALID, 0)
    return n
}

fn selftest_glas_max() -> u64 {
    // NACHTRAG 2: neun, seit die Leiste ihren eigenen Fall 7b hat.
    return 9
}

fn glastest_say(state: u64) {
    ss(state, S_GLTEST, selftest_glas(state))
    serial.puts((&gt_a[0]) as u64)
    serial.dec(gs(state, S_GLTEST))
    serial.puts((&gt_b[0]) as u64)
    serial.dec(selftest_glas_max())
    serial.nl()
}

// r53: SELF-TEST OF THE DIRTY BOX PROTOCOL (`box_add` / `box_take`, the pair `damage_ex` and `compose_one` use). Pure: it saves the four box
// words and the flag, runs on them, puts them back; no pixel is touched. The race itself (a `damage` held up between its check of `S_DON`
// and its stores while another core takes the frame) needs two cores; what this proves is the half that makes the fix work: after a take a
// new rectangle STARTS a new box (it is never merged into the box of a frame that was already taken, and never lost).
static mut dt_a: [u8; 16] = "wm: damagetest \0"
const DT_MAX: u64 = 8

fn selftest_damage(state: u64) -> u64 {
    let sv0: u64 = gs(state, S_DX0)
    let sv1: u64 = gs(state, S_DY0)
    let sv2: u64 = gs(state, S_DX1)
    let sv3: u64 = gs(state, S_DY1)
    let svd: u64 = gs(state, S_DON)
    var n: u64 = 0
    var o: [u64; 4] = [0 as u64; 4]
    let op: u64 = (&o[0]) as u64
    ss(state, S_DON, 0)
    // 1. nothing pending: no frame
    if !box_take(state, op) {
        n = n + 1
    }
    // 2. one rectangle: it is the box
    box_add(state, 10, 20, 30, 40)
    if gs(state, S_DON) == 1 && gs(state, S_DX0) == 10 && gs(state, S_DY1) == 40 {
        n = n + 1
    }
    // 3. a second one widens it
    box_add(state, 5, 25, 60, 35)
    if gs(state, S_DX0) == 5 && gs(state, S_DY0) == 20 && gs(state, S_DX1) == 60 && gs(state, S_DY1) == 40 {
        n = n + 1
    }
    // 4. the take returns the union and clears the flag
    let t4: bool = box_take(state, op)
    if t4 && gs(state, S_DON) == 0 && o[0] == 5 && o[1] == 20 && o[2] == 60 && o[3] == 40 {
        n = n + 1
    }
    // 5. a rectangle after the take starts a NEW box: not widened by the old numbers
    box_add(state, 100, 200, 110, 210)
    if gs(state, S_DON) == 1 && gs(state, S_DX0) == 100 && gs(state, S_DY0) == 200 && gs(state, S_DX1) == 110 && gs(state, S_DY1) == 210 {
        n = n + 1
    }
    // 6. and the next take gets exactly that rectangle (it was not lost)
    let t6: bool = box_take(state, op)
    if t6 && o[0] == 100 && o[1] == 200 && o[2] == 110 && o[3] == 210 {
        n = n + 1
    }
    // 7. a second take finds nothing
    if !box_take(state, op) {
        n = n + 1
    }
    // 8. the region lock is free again after all of this (no path leaves it taken)
    if rgn_lock(state) {
        rgn_unlock(state)
        n = n + 1
    }
    ss(state, S_DX0, sv0)
    ss(state, S_DY0, sv1)
    ss(state, S_DX1, sv2)
    ss(state, S_DY1, sv3)
    ss(state, S_DON, svd)
    return n
}

fn damagetest_say(state: u64) {
    let r: u64 = selftest_damage(state)
    serial.puts((&dt_a[0]) as u64)
    serial.dec(r)
    serial.puts((&gt_b[0]) as u64)
    serial.dec(DT_MAX)
    serial.nl()
}

// Der Titel, auf die Breite bis zum Schliessfeld beschnitten.
// EIN ZEICHEN AUS `kernel/netmark.fi`, EINFARBIG. Der Fensterserver
// dieses Zweiges kennt keine Farbrollen -- die Runde THEME gibt ihm
// gerade welche (WM_DECO) --, also wird das Zeichen in der Farbe der
// TITELSCHRIFT gemalt, die es hier schon gibt. Das kostet nichts:
// UNTERSCHIEDEN WERDEN DIE DREI ZEICHEN DURCH IHRE FORM UND NICHT DURCH
// IHRE FARBE, und `tools/netview/icons.py` misst genau das (die
// Schattenrisse unterscheiden sich um mindestens ein Drittel der
// eingefaerbten Bildpunkte). Wenn THEME durch ist, wird aus `color`
// eine Rolle und sonst nichts.
fn title_mark(state: u64, m: u64, x: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    var r: u64 = 0
    while r < netmark.H {
        let py: i64 = y + r as i64
        if py >= ay0 && py < ay1 {
            let maske: u64 = netmark.mask_at(m, r)
            var c: u64 = 0
            while c < netmark.W {
                if (maske >> (netmark.W - 1 - c)) & 1 != 0 {
                    let pxx: i64 = x + c as i64
                    if pxx >= ax0 && pxx < ax1 {
                        fb.pixel(state, pxx as u64, py as u64, color)
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

static mut titel_schnitt: u64 = 0
static mut titel_max: u64 = 0
// RUNDE BLECH2: die ALTE Zaehlweise (Schnittfenster beginnt rechts vom
// Titelanfang), nur noch fuer `wm: fen` -- siehe `title_text`.
static mut titel_schnitt_alt: u64 = 0

fn title_clipped() -> u64 {
    return titel_schnitt
}

fn title_old() -> u64 {
    return titel_schnitt_alt
}

fn title_missing() -> u64 {
    return titel_max
}

fn title_text(state: u64, i: u64, f: u64, x: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64, grenze: i64) {
    // RUNDE I18N: derselbe Umbau wie in `text` -- der Titel eines
    // Fensters ist der einzige Text, den der SERVER malt, und wenn er
    // als einziger oktettweise laeuft, sieht ein Fenster namens
    // "Einstellungen" mit echtem Umlaut in der Titelleiste anders aus
    // als sein eigener Knopf.
    let px: u64 = gs(state, S_PX_UI)
    // ADDENDUM TASKBAR, DER FUND DIESES ZWEIGES, UND ER DARF BEIM
    // ZUSAMMENFUEHREN NICHT VERLORENGEHEN: `wat` TRAEGT `kstate.DSK_OFF`
    // SCHON, seit die Runde DESKTOP die Fenstertafel aus WM_OFF
    // herausgezogen hat. Diese eine Stelle hat WM_OFF noch einmal
    // daraufgerechnet und seither Nullen gelesen -- JEDER FENSTERTITEL
    // AUF DEM BILDSCHIRM WAR LEER, und drei Zusagen in
    // tools/wm/run.sh haben es gesagt ("LEER: K l i c k m i c h").
    // `set_title` zwoelfhundert Zeilen weiter oben war berichtigt
    // worden, diese Stelle nicht. Die Runde I18N hat die Schleife
    // darunter auf UTF-8 umgebaut und die falsche Basis dabei
    // uebernommen; hier stehen beide Aenderungen zusammen.
    // ============================================== RUNDE VIELKERN
    // WIRD DER TITEL LINKS ABGESCHNITTEN? DIE ZAHL DAZU.
    //
    // Justin sieht auf mehreren Fotos bei 3440x1440 `inal -- sh` statt
    // `Terminal -- sh`: die ersten vier bis fuenf Zeichen fehlen,
    // waehrend der Rahmen richtig sitzt. Der Verdacht war eine
    // Zeilenbreitenrechnung, die bei 3440 bricht. GEMESSEN und
    // WIDERLEGT (docs/RUNDE-VIELKERN.md): mit pitch 13760 bei 3424
    // Bildpunkten Breite -- genau der Fall echter Firmware -- ist das
    // Bild bildpunktgleich mit dem ungepolsterten Lauf.
    //
    // Bleibt der andere Weg, auf dem Zeichen links verschwinden
    // koennen: das SCHNITTFENSTER. `fb_glyph` laesst jeden Bildpunkt
    // mit `pxx < ax0` aus. Liegt `ax0` rechts vom Titelanfang, fehlt
    // genau der linke Teil des Textes und sonst nichts -- der Rahmen
    // wird in einem anderen Aufruf mit einem anderen Schnitt gemalt
    // und bleibt heil. Das ist keine Behauptung, sondern jetzt eine
    // ZAHL: `TK` auf Tafelzeile 7 sagt, wie oft und wie weit.
    // ====================================================== RUNDE BLECH2
    // TK ZAEHLTE DAS FALSCHE. Justins Tafel: `7 LEISTE ... TK 643`, und
    // auf demselben Foto steht `Terminal -- sh` VOLLSTAENDIG in der
    // Titelleiste. `x < ax0` heisst nur: das Schnittfenster dieses
    // Anstrichs faengt rechts vom Titelanfang an -- und das ist bei
    // JEDEM Teilanstrich so, dessen schmutziges Rechteck nicht am linken
    // Fensterrand beginnt: der Zeiger, der ueber die Fensterflaeche
    // laeuft, ein Fenster, das darueber aufgeht. Die Bildpunkte links
    // vom Schnitt stehen unveraendert im Zweitpuffer und werden mit der
    // Zeile zusammen uebertragen; es fehlt nichts. GEMESSEN in
    // tools/metal2/run.sh: alte Zaehlweise in die Hunderte, Titel im
    // Bild bildpunktgenau vollstaendig (`checkshot.py tkette`).
    //
    // Was einen Titel WIRKLICH verschwinden laesst, ist das Band der
    // Messtafel: `fb.pixel` weist jede Zeile unter `band_lo` ab, still.
    // Ein Fenster, das nach oben in das Band geschoben wird, verliert
    // seinen Titel genau dort. DAS zaehlt TK jetzt: Titelzeilen, die im
    // Band liegen. Die alte Zahl bleibt als `tka=` in `wm: fen`.
    if x < ax0 {
        titel_schnitt_alt = titel_schnitt_alt + 1
    }
    let oben: i64 = y - ttf.ascent(state, f, px)
    let band: i64 = fb.band_lo(state) as i64
    if oben < band {
        titel_schnitt = titel_schnitt + 1
        let fehlt: u64 = (band - oben) as u64
        if fehlt > titel_max {
            titel_max = fehlt
        }
    }
    let tp: u64 = state + wat(i) + W_TITLE
    var cx: i64 = x * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < 31 {
        let v: u64 = utf8.next(tp, 31, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = 31
        } else {
            let gid: u64 = ttf.glyph_of(state, f, c)
            if vorher != 0 {
                cx = cx + ttf.kern26(state, f, vorher, gid, px)
            }
            let slot: u64 = ttf.glyph(state, f, c, px)
            if slot < ttf.SLOTS {
                if (cx >> 6) + ttf.g_w(state, slot) as i64 > grenze - 4 {
                    return
                }
                fb_glyph(state, slot, cx >> 6, y, color, ax0, ay0, ax1, ay1)
                cx = cx + ttf.g_adv(state, slot)
            } else {
                cx = cx + ttf.advance26(state, f, gid, px)
            }
            vorher = gid
            k = k + l
        }
    }
}

// Eine Glyphe unmittelbar in den Zweitpuffer -- fuer alles, was der
// SERVER malt (Titel), nicht die Anwendung.
fn fb_glyph(state: u64, slot: u64, x: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let gw: u64 = ttf.g_w(state, slot)
    let gh: u64 = ttf.g_h(state, slot)
    let x0: i64 = x + ttf.g_left(state, slot)
    let y0: i64 = y - ttf.g_top(state, slot)
    var r: u64 = 0
    while r < gh {
        let py: i64 = y0 + r as i64
        if py >= ay0 && py < ay1 {
            var c: u64 = 0
            while c < gw {
                let pxx: i64 = x0 + c as i64
                if pxx >= ax0 && pxx < ax1 {
                    let a: u64 = ttf.g_pixel(state, slot, c, r)
                    if a != 0 {
                        fb.pixel(state, pxx as u64, py as u64,
                            blend(fb.get_pixel(state, pxx as u64,
                                py as u64), color, a))
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

// ==================================== RUNDE HIDPUNKTE: DIE MESSLEISTE
// ======================================= RUNDE MESSTAFEL: SIEBEN ZEILEN
//
// EINE ANZEIGE, DIE NICHT VOM FENSTERSYSTEM ABHAENGT.
//
// Der Eingabepuls stand bisher IM Terminalfenster. Auf Justins Brett
// war genau dieses Fenster zu schmal und links abgeschnitten -- die
// Diagnose war also da, wo man sie am wenigsten lesen konnte. Diese
// Zeilen werden NACH `compose` unmittelbar in den Rahmenpuffer gemalt,
// mit dem eingebauten Bitmapzeichensatz (kein TTF, kein Fenster, kein
// Puffer, keine Arena). Sie stehen deshalb auch dann da, wenn der
// Fensterserver, die Taskleiste und die Schrift allesamt versagen.
//
// RUNDE MESSTAFEL, UND DAS IST DER GRUND FUER DEN UMBAU: Justin
// fotografiert den Bildschirm mit dem Mobiltelefon AUS ZWEI METERN.
// Eine Zeile mit zwanzig Zahlen in `uisc`-Groesse ist auf so einem
// Foto nicht zu lesen. Also: sieben kurze Zeilen, ein Maszstab GROESSER
// als der der Oberflaeche, und -- das ist das eigentliche Werkzeug --
// JEDE STUFE BEKOMMT EINE FARBE. Gruen heiszt "hier kam etwas an", rot
// heiszt "hier kam nichts an". Die ERSTE ROTE ZEILE ist die Stelle, an
// der der Eingabeweg abreiszt. Das kann man aus zwei Metern erkennen,
// ohne eine einzige Ziffer zu entziffern.
// So breit ist die laengste Tafelzeile (kgui.TAFEL_SPALTEN). Hier
// noch einmal, weil `wm` `kgui` nicht einbinden darf -- der
// Modulgraph ist ein Baum und kgui haengt ueber wm.
// ================================================== RUNDE BLECHDREI
// Justins Foto zeigte "11 USB DEV 0 FUND 3 HUB 0 KBD" -- mitten im
// Wort abgeschnitten. Der Grund war eine ZWEITE Zahl: `kgui` merkt
// sich 40 Zeichen je Zeile, gemalt und uebertragen wurden aber nur
// `MESS_SPALTEN` = 30. Alles ab Zeichen 31 stand im Zweitpuffer und
// kam nie ueber den Bus. Zwei Zahlen fuer eine Sache, und die
// kleinere gewinnt still.
const MESS_SPALTEN: u64 = 48
// Wie viele Zeilen die Tafel hat. Spiegel von `kgui.TAFEL_ZEILEN` --
// `wm` darf `kgui` nicht einbinden (der Modulgraph ist ein Baum).
// ============================================== RUNDE STARTKNOPF
// ZUM DRITTEN MAL DIESELBE ZAHL AN ZWEI STELLEN.
//
// Der Kommentar in `messzeile_x` warnt seit BLECHDREI davor ("Zwei
// Zahlen fuer eine Sache, schon wieder") -- und genau das stand hier
// wieder: `kgui.TAFEL_ZEILEN` war 24, `MESS_ZEILEN` 20. Die Folge:
// `mess_projespalte` rechnete zehn Zeilen je Spalte, waehrend
// `messhoehe` fuer 24 Zeilen ein Band von 582 Bildpunkten reserviert
// hat -- die Zeilen 20..23 landeten auf 10..13, und ein Drittel des
// Bandes blieb schwarz.
// ================================================== RUNDE LEISTE
// ZUM VIERTEN MAL, UND JETZT MIT EINEM RIEGEL DAVOR.
//
// Der Absatz darueber sagt "zum dritten Mal dieselbe Zahl an zwei
// Stellen" -- und beim vierten Mal hat sie den Kern umgebracht:
//
//     *** EXCEPTION 14 #PF  err=0xb  cr2=0x622140
//       rip=0x26d0b7 (fb.fill_words+0xa7)  rsp=0x5096e0
//
// `kgui.TAFEL_ZEILEN` war 24, diese Zahl 20. `messzeile_x` rechnet aus
// ihr die Spalte; fuer die Zeilen 20..23 kam eine Spalte heraus, die
// es nicht gibt, und der Balken, der die Zeile loescht, lief aus dem
// Puffer heraus.
//
// ZWEI DINGE, NICHT EINS. Die Zahl steht jetzt auf 24 -- und weil
// dieselbe Verwechslung viermal passiert ist, gibt es zusaetzlich
// einen RIEGEL: `messzeile` und `messzeile_x` nehmen keine Zeilennummer
// mehr an, die es nicht gibt. Eine falsche Zahl malt dann nichts, und
// nichts malen ist immer besser als woanders hinmalen.
const MEASURE_LINES: u64 = 25

fn messk(state: u64) -> u64 {
    // Eine Stufe groesser als die Oberflaeche, hoechstens 4. Auf
    // 3440x1440 ist `uisc` 2, die Tafel also 3: 24 x 48 Bildpunkte je
    // Zeichen, rund elf Millimeter hoch. Das ist aus zwei Metern
    // dieselbe Winkelgroesse wie 6-mm-Text aus einem Meter.
    // ============================================ RUNDE BLECHDREI
    // AUS DER BILDBREITE, NICHT AUS `uisc`.
    //
    // Zwei Gruende. Erstens steht `uisc` erst nach `surface` fest, die
    // Tafel malt aber schon aus dem Boot-Protokoll heraus -- auf
    // Justins 3440x1440 kam damit k=2 heraus, obwohl dort k=3 gemeint
    // war. Zweitens ist die Frage hier eine andere als bei der
    // Oberflaeche: nicht "wie gross ist ein Knopf", sondern "was kann
    // ein Mensch aus einem Meter mit dem Handy noch fotografieren".
    // 3440 / 900 = 3 -> Zeichen von 24 x 48 Bildpunkten, auf einem
    // 34-Zoll-Schirm rund elf Millimeter hoch.
    var k: u64 = fb.width(state) / 900
    if k < 2 {
        k = 2
    }
    if k > 4 {
        k = 4
    }
    return k
}

fn messhoehe(state: u64, lines: u64) -> u64 {
    var z: u64 = lines
    // RUNDE BLECHDREI: bei mehreren Spalten ist die Tafel nur so hoch
    // wie EINE Spalte. `messleiste` ruft weiter mit einer Zeile.
    if z > 1 {
        z = (z + mess_kol(state) - 1) / mess_kol(state)
    }
    return font.GLYPH_H * messk(state) * z + 2 * messk(state)
}

// DER GRUND WIRD EINMAL GEFUELLT, nicht je Zeile. Sieben schwarze
// Balken ueber die volle Schirmbreite waeren auf 3440 Punkten 1,15
// Millionen Bildpunkte JE RUNDE -- der Grund hoert deshalb dort auf,
// wo die laengste Zeile aufhoert (`spalten` Zeichen).
// RUNDE TAFEL: UEBER DIE VOLLE BREITE, AB BILDPUNKT NULL.
//
// Vorher hoerte der schwarze Grund dort auf, wo die laengste Zeile
// aufhoerte -- 726 von 3440 Bildpunkten. Auf Justins Foto war davon
// nichts zu erkennen: ein schmaler dunkler Streifen links oben sieht
// aus wie ein Fensterrand. Ein Messgeraet, das man fuer Zierat haelt,
// ist keines.
//
// Jetzt: schwarzer Balken ueber die GANZE Breite, ab Bildpunkt 0,
// darunter eine helle Trennlinie. Aus zwei Metern ist das ein Balken
// und kein Fensterrand. `spalten` bleibt in der Aufrufliste, weil die
// einzeilige `messleiste` sie noch benutzt.
// ================================================== RUNDE BLECHZWEI
// Wie breit die Tafel wirklich ist. Bis zu dieser Runde ging der
// schwarze Balken ueber die GANZE Bildbreite -- gut auf einem Foto,
// aber 3440 Bildpunkte je Zeile, und die muessen alle ueber PCIe. Der
// Text ist `spalten` Zeichen breit; der Balken bekommt einen halben
// Zeichenrand dazu und hoert dann auf. Auf 3440 sind das rund 780 statt
// 3440 Bildpunkte, also ein Fuenftel der Uebertragung.
fn measure_width(state: u64, spalten: u64) -> u64 {
    let k: u64 = messk(state)
    var b: u64 = font.GLYPH_W * k * (spalten + 1) + 2 * k
    if b > fb.width(state) {
        b = fb.width(state)
    }
    return b
}

// Wo eine einzelne Tafelzeile anfaengt und wie hoch sie ist. Damit
// uebertraegt `kgui` nur die Zeilen, die sich WIRKLICH geaendert haben.
// ================================================== RUNDE BLECHDREI
// ZWEI SPALTEN NEBENEINANDER, UND WARUM.
//
// Die Tafel bekommt in dieser Runde ein FEST RESERVIERTES Band am
// oberen Rand, das niemand ueberschreibt (`fb.set_band`). Vierzehn
// Zeilen uebereinander waeren auf Justins 3440x1440 aber 14 * 48 =
// 678 Bildpunkte, also fast die halbe Bildhoehe -- ein Messgeraet,
// das den Messgegenstand verdeckt.
//
// Also sieben Zeilen in zwei Spalten: 342 Bildpunkte hoch, 2 * 1182
// breit. Passen zwei Spalten nicht nebeneinander (schmale Schirme der
// Regressionslaeufe), faellt es von selbst auf eine zurueck.
// ============================================ RUNDE BLECHFUENF
// DIE DRITTE SPALTE, UND WARUM SIE SEIN MUSS.
//
// Die Tafel hat zwei Zeilen mehr bekommen (die Tastatur und die Uhr),
// und mit zwanzig Zeilen in ZWEI Spalten wurde das Band 487 Bildpunkte
// hoch. `fb.set_band` lehnt alles ueber einem Drittel des Schirms ab --
// bei 1440 sind das 480 -- und lehnte es AB: `BAND H 0`, gemessen.
// Damit war der Schutz weg, den die Vorrunde eingezogen hat, und die
// Tafel haette wieder uebermalt werden koennen.
//
// Justins Schirm ist 3440 breit; drei Spalten zu 1178 Bildpunkten
// passen zweimal hinein. Sieben Zeilen statt zehn, Band 170 statt 487.
// Die Breite war nie das Problem, die Hoehe ist es.
fn mess_kol(state: u64) -> u64 {
    let b: u64 = measure_width(state, MESS_SPALTEN)
    if 3 * b <= fb.width(state) {
        return 3
    }
    if 2 * b <= fb.width(state) {
        return 2
    }
    return 1
}

// RUNDE LEISTE: die Zahl NACH AUSSEN, damit `kgui` sie mit seiner
// eigenen vergleichen kann. Vier Runden sind daran verlorengegangen,
// dass zwei Dateien dieselbe Zahl getrennt fuehren und niemand merkt,
// wenn sie auseinanderlaufen. `wm` darf `kgui` nicht einbinden -- aber
// `kgui` darf `wm` fragen, und genau das tut es jetzt beim Start.
fn measure_lines() -> u64 {
    return MEASURE_LINES
}

// Zeilen JE SPALTE -- aufgerundet, damit keine Zeile herausfaellt.
fn mess_projespalte(state: u64) -> u64 {
    let k: u64 = mess_kol(state)
    return (MEASURE_LINES + k - 1) / k
}

// Die volle Breite der Tafel: alle Spalten nebeneinander.
fn mess_vollbreite(state: u64) -> u64 {
    var b: u64 = mess_kol(state) * measure_width(state, MESS_SPALTEN)
    if b > fb.width(state) {
        b = fb.width(state)
    }
    return b
}

fn messzeile_x(state: u64, zeile: u64) -> u64 {
    // GEMESSEN UND KORRIGIERT: im ersten Lauf stand `MESS_ZEILEN` auf
    // 14, waehrend `kgui` schon sechzehn Zeilen schickte. Die beiden
    // letzten landeten damit in einer DRITTEN Spalte bei x=2364 --
    // ausserhalb des schwarzen Grundes, mitten auf dem Schreibtisch,
    // gruen auf blau. Zwei Zahlen fuer eine Sache, schon wieder. Die
    // Klemme hier sorgt dafuer, dass eine solche Zeile schlimmstenfalls
    // eine andere ueberschreibt, statt aus der Tafel zu fallen.
    var kol: u64 = zeile / mess_projespalte(state)
    if kol >= mess_kol(state) {
        kol = mess_kol(state) - 1
    }
    return kol * measure_width(state, MESS_SPALTEN)
}

fn messzeile_y(state: u64, zeile: u64) -> u64 {
    let k: u64 = messk(state)
    return k + (zeile % mess_projespalte(state)) * font.GLYPH_H * k
}

fn messzeile_h(state: u64) -> u64 {
    return font.GLYPH_H * messk(state)
}

fn measure_reason(state: u64, lines: u64, spalten: u64) {
    if !fb.ready(state) {
        return
    }
    let k: u64 = messk(state)
    let hoehe: u64 = messhoehe(state, lines)
    if hoehe >= fb.height(state) {
        return
    }
    let breite: u64 = mess_vollbreite(state)
    fb.fill(state, 0, 0, breite, hoehe, fb.rgb(state, 0x00, 0x00, 0x00))
    // Die Trennlinie unten -- damit die Tafel auf einem Foto eine
    // KANTE hat und nicht in den Schreibtisch ausfranst.
    let rand: u64 = fb.rgb(state, 0xFF, 0xE0, 0x00)
    fb.fill(state, 0, hoehe - k, breite, k, rand)
    fb.dirty(state, 0, hoehe)
}

// EINE ZEILE. `zeile` zaehlt ab null, `fg` ist die Farbe.
fn messzeile(state: u64, zeile: u64, p: u64, n: u64, fg: u64) {
    if !fb.ready(state) {
        return
    }
    // RUNDE LEISTE: DER RIEGEL. Eine Zeile, die es nicht gibt, wird
    // nicht gemalt -- statt an einer ausgerechneten Stelle ausserhalb
    // des Bandes zu landen. Siehe MESS_ZEILEN.
    if zeile >= MEASURE_LINES {
        return
    }
    let k: u64 = messk(state)
    let gw: u64 = font.GLYPH_W * k
    let gh: u64 = font.GLYPH_H * k
    let y0: u64 = messzeile_y(state, zeile)
    let x0: u64 = messzeile_x(state, zeile)
    if y0 + gh >= fb.height(state) || x0 >= fb.width(state) {
        return
    }
    // ============ RUNDE BLECHZWEI: DIE ZEILE ZUERST LOESCHEN.
    //
    // Justin fotografiert ein DOPPELBILD: alte und neue Zeichen an
    // derselben Stelle uebereinander. Bis zu dieser Runde loeschte nur
    // `mess_grund` den Grund, und `mess_grund` malt einen Balken ueber
    // ALLE Zeilen -- das ist teuer, und im Streifenbetrieb hat es die
    // Unterbrechung mitten hineingeschlagen (siehe `fb.flush_stripe`).
    // Wird eine Zahl kuerzer ("MAL 130" -> "MAL 61"), stehen die alten
    // Ziffern rechts daneben weiter da.
    //
    // Jetzt loescht JEDE Zeile ihr eigenes Feld, unmittelbar bevor sie
    // gemalt wird. Es kostet einen Balken je Zeile statt einen fuer
    // alle -- dieselbe Flaeche, aber lueckenlos.
    var breite: u64 = measure_width(state, MESS_SPALTEN)
    if x0 + breite > fb.width(state) {
        breite = fb.width(state) - x0
    }
    fb.fill(state, x0, y0, breite, gh, fb.rgb(state, 0x00, 0x00, 0x00))
    var i: u64 = 0
    var x: u64 = x0 + k
    while i < n && x + gw <= x0 + breite {
        let ch: u64 = kstate.get8(p + i)
        var r: u64 = 0
        while r < font.GLYPH_H {
            let bits: u64 = font.row(state + fb.FONT_OFF, ch, r)
            var c: u64 = 0
            while c < font.GLYPH_W {
                if (bits & (1 << (7 - c))) != 0 {
                    var dy: u64 = 0
                    while dy < k {
                        var dx: u64 = 0
                        while dx < k {
                            fb.pixel(state, x + c * k + dx,
                                y0 + r * k + dy, fg)
                            dx = dx + 1
                        }
                        dy = dy + 1
                    }
                }
                c = c + 1
            }
            r = r + 1
        }
        x = x + gw
        i = i + 1
    }
    fb.dirty(state, y0, y0 + gh)
}

// DIE FARBEN DER TAFEL. Gruen: hier kam etwas an. Rot: hier nicht.
fn mess_gruen(state: u64) -> u64 {
    return fb.rgb(state, 0x00, 0xFF, 0x66)
}

fn mess_rot(state: u64) -> u64 {
    return fb.rgb(state, 0xFF, 0x40, 0x40)
}

fn mess_weiss(state: u64) -> u64 {
    return fb.rgb(state, 0xFF, 0xFF, 0xFF)
}

fn mess_gelb(state: u64) -> u64 {
    return fb.rgb(state, 0xFF, 0xE0, 0x00)
}

// Gruen, wenn der Zaehler laeuft -- sonst rot.
fn mess_ampel(state: u64, v: u64) -> u64 {
    if v == 0 {
        return mess_rot(state)
    }
    return mess_gruen(state)
}

// DIE ALTE EINZEILIGE FASSUNG, unveraendert im Verhalten: sie malt
// ihren eigenen Grund und steht in Zeile null. Sie bleibt, weil die
// Runde FASSUNG mit ihr belegt hat, dass eine Zeile ueber `compose`
// hinweg stehenbleibt, und weil ein Kern ohne Tafel (Selbsttest) sie
// weiter braucht.
fn messleiste(state: u64, p: u64, n: u64) {
    measure_reason(state, 1, n + 1)
    messzeile(state, 0, p, n, mess_gruen(state))
}

// ===================================================================
// RUNDE GPU (G-012): DER ZEIGER, DEN DAS GERAET TRAEGT
// ===================================================================
//
// DREI BEDINGUNGEN, UND ALLE DREI MUESSEN STIMMEN:
//   1. der Treiber hat die Zeigerwarteschlange und die Flaeche
//      (`vgpu.cursor_bereit`),
//   2. die Gegenprobe `nohwcur` ist NICHT gesetzt,
//   3. der Zeiger soll ueberhaupt sichtbar sein.
//
// Faellt eine davon, malt `compose` ihn wieder selbst -- derselbe Weg
// wie vor dieser Runde, ohne dass irgendwo etwas umgestellt werden
// muesste. Das ist der saubere Rueckfall, den die Abnahme verlangt.
fn hwcur_moeglich(state: u64) -> bool {
    if kstate.mode_on(state, kstate.M_NOHWCUR) {
        return false
    }
    return vgpu.cursor_usable(state) || vmsvga.cursor_ready(state)
}

// r-vmsvga: the pointer goes to whichever driver carries the screen (virtio-gpu first, then VMSVGA).
fn hw_an(state: u64) -> bool {
    if vgpu.cursor_usable(state) {
        return vgpu.cursor_an(state)
    }
    return vmsvga.cursor_an(state)
}

fn hw_zeigen(state: u64, form: u64, g: u64, x: u64, y: u64, hx: u64, hy: u64, rq: u64) {
    if vgpu.cursor_usable(state) {
        let _a: bool = vgpu.cursor_displayed(state, form, g, x, y, hx, hy, rq)
        return
    }
    let _b: bool = vmsvga.cursor_show(state, form, g, x, y, hx, hy, rq)
}

fn hw_bewegen(state: u64, x: u64, y: u64) {
    if vgpu.cursor_usable(state) {
        let _a: bool = vgpu.cursor_bewegen(state, x, y)
        return
    }
    let _b: bool = vmsvga.cursor_bewegen(state, x, y)
}

// OB DIE HARDWARE DEN ZEIGER TRAEGT -- und zwar AB DEM ERSTEN MAL.
//
// HIER LAG EIN FEHLER, UND ER IST LEHRREICH GENUG, UM AUFGESCHRIEBEN
// ZU WERDEN: zuerst stand hier `&& vgpu.cursor_an(state)`. Damit war
// die Antwort beim ERSTEN Aufruf falsch -- `cursor_an` wird ja erst
// wahr, NACHDEM `cursor_zeigen` einmal gelaufen ist. Also nahm die
// Bewegung den Softwareweg, `cursor_zeigen` kam nie dran, und der
// Zeiger blieb fuer immer im Bild. Die Messung zeigte es sofort:
// null `update_cursor` beim Wirt, obwohl die Flaeche angelegt war.
//
// Richtig ist: sobald der Treiber es KANN, traegt er ihn. Ob er schon
// einmal hinausging, entscheidet nur, OB das Bild mitmuss -- und das
// steht in `hwcur_bewegen`, wo es hingehoert.
fn hwcur_an(state: u64) -> bool {
    return hwcur_moeglich(state)
}

// DEN ZEIGER AN DAS GERAET UEBERGEBEN. Wird gerufen, sobald er sich
// bewegt oder die Form wechselt. Beim ERSTEN Mal geht das Bild mit
// hinaus, danach nur noch der Ort.
fn hwcur_bewegen(state: u64) {
    if !hwcur_moeglich(state) {
        return
    }
    let g: u64 = cur_w(state)
    let form: u64 = gs(state, S_SHAPE)
    // INPUT FOLLOWS THE OUTPUT: the device draws the pointer on the PANEL, so the position goes through the output rotation
    // (fb.logical_to_panel) and the picture + hotspot are turned by the same quarter turns (`rq`).
    let pp: u64 = fb.logical_to_panel(state, gs(state, S_CURX), gs(state, S_CURY))
    let x: u64 = pp >> 32
    let y: u64 = pp & 0xFFFFFFFF
    let rq: u64 = fb.rotation(state) / 90
    let hkey: u64 = gs(state, S_SHAPE) + (rq << 16)
    if !hw_an(state) {
        ss(state, S_HWSHAPE, hkey)
        hw_zeigen(state, form, g, x, y,
            cur_ox(state), cur_oy(state), rq)
        return
    }
    // Die Form kann sich geaendert haben (Pfeil -> Hand -> Groesse).
    // `cursor_zeigen` merkt das selbst und traegt das Bild nur dann
    // neu hinaus; sonst ist es ein reiner Ortswechsel.
    if hkey != gs(state, S_HWSHAPE) {
        ss(state, S_HWSHAPE, hkey)
        hw_zeigen(state, form, g, x, y,
            cur_ox(state), cur_oy(state), rq)
        return
    }
    hw_bewegen(state, x, y)
}

fn paint_cursor(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    // ======================================== RUNDE ECHTHARDWARE-4
    // DREI LAGEN MIT DECKUNG STATT ZWEI BITMASKEN.
    //
    // Vorher: je Bildpunkt ein Bit Fuellung und ein Bit Umriss, jedes
    // Bit bei Vervielfachung 2 zu einem 2x2-Block aufgeblasen. Kein
    // Zwischenwert, also keine Kantenglaettung -- und bei doppelter
    // Vervielfachung doppelt so grobe Treppen.
    //
    // Jetzt liefert `zeiger.fi` je Bildpunkt DREI Deckungen (Kern,
    // Rand, Schatten), gerastert in Zielgroesse mit neun Proben. Sie
    // werden von hinten nach vorn ueber das fertige Bild gelegt:
    //   Schatten, schwarz und schwach -- er hebt den Zeiger ab,
    //   Rand, weiss -- damit er auf dunklem Grund sichtbar bleibt,
    //   Kern, dunkel -- damit er auf hellem Grund sichtbar bleibt.
    let form: u64 = gs(state, S_SHAPE)
    let g: u64 = cur_w(state)
    cursor.build_map(form, g)
    let mx: i64 = gs(state, S_CURX) as i64 - cur_ox(state) as i64
    let my: i64 = gs(state, S_CURY) as i64 - cur_oy(state) as i64
    let dunkel: u64 = rgb24(state, CURSOR_EDGE)
    let hell: u64 = rgb24(state, CURSOR_BODY)
    let schwarz: u64 = rgb24(state, 0)
    var r: u64 = 0
    while r < g {
        let py: i64 = my + r as i64
        if py >= cy0 as i64 && py < cy1 as i64 {
            var c: u64 = 0
            while c < g {
                let pxx: i64 = mx + c as i64
                if pxx >= cx0 as i64 && pxx < cx1 as i64 && pxx >= 0 {
                    let v: u64 = cursor.deck(g, c, r)
                    if v != 0 {
                        let ak: u64 = (v >> 16) & 255
                        let ar: u64 = (v >> 8) & 255
                        let asch: u64 = v & 255
                        // Der Schatten deckt hoechstens zu einem
                        // Drittel. Mehr sieht nach Rand aus, und dann
                        // haette der Zeiger zwei davon.
                        if asch != 0 && ak == 0 && ar == 0 {
                            fb.pixel_a(state, pxx as u64, py as u64,
                                schwarz, asch * 90 / 255)
                        }
                        if ar != 0 {
                            fb.pixel_a(state, pxx as u64, py as u64,
                                hell, ar)
                        }
                        if ak != 0 {
                            fb.pixel_a(state, pxx as u64, py as u64,
                                dunkel, ak)
                        }
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

// ------------------------------------------------------- die Ereignisse

fn ev_at(state: u64, i: u64, k: u64) -> u64 {
    return state + kstate.EVR_OFF + i * EV_RING // DELL ROUND: own pages
        + (k % EV_SLOTS) * EV_BYTES
}

// ================================================== RUNDE EXPLORER-2
//
// WELCHE UMSCHALTTASTEN BEIM KLICK UNTEN WAREN.
//
// Ein Klick trug bis zu dieser Runde nur die Maustasten (Bit 0..2 aus
// `ps2m`). Damit ist Strg-Klick von einem gewoehnlichen Klick nicht zu
// unterscheiden -- und Strg-Klick und Umschalt-Klick sind die beiden
// Griffe, mit denen ein Mensch in JEDEM Dateimanager mehrere Stuecke
// auswaehlt.
//
// Die Tastenmaske hat oberhalb der drei Maustasten Platz; also gehen
// die zwei Umschalttasten in Bit 3 und Bit 4 mit. Kein zweiter Weg,
// kein neues Ereignis -- ein Programm, das die neuen Bits nicht kennt,
// sieht dieselbe Maske wie vorher, weil es nur die unteren drei prueft.
const M_SHIFT: u64 = 8
const M_CTRL: u64 = 16

fn mods_of(state: u64) -> u64 {
    var m: u64 = 0
    if kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1 {
        m = m | M_SHIFT
    }
    if kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 1 {
        m = m | M_CTRL
    }
    return m
}

static mut mv_wid: u64 = 0
static mut mv_lx: i64 = 0
static mut mv_ly: i64 = 0
static mut mv_btn: u64 = 0

fn ev_push(state: u64, i: u64, typ: u64, a: u64, b: u64, c: u64) {
    if !valid(state, i) {
        return
    }
    if typ != E_MOVE && wg(state, i, W_ID) == mv_wid {
        mv_wid = 0
    }
    if typ == E_KEY {
        wsv(state, i, W_KEYS, wg(state, i, W_KEYS) + 1)
    }
    // ====================================================== RUNDE BLECH2
    // EIN RING OHNE ABHOLER IST KEIN RING.
    //
    // Justins Tafel vom 05.09. 22:46: `4 RING 5226 VERL 1283` -- ein
    // Viertel aller Ereignisse aus dem Fensterring gefallen, in QEMU
    // stand dort immer 0. Der Grund ist nicht die Ringgroesse und nicht
    // ein langsamer Abholer, sondern EIN FENSTER OHNE ABHOLER: das
    // Terminalfenster legt der KERN an (`kgui`), seine Tasten gehen
    // ueber `key_tty` an die Zeilendisziplin, und aus seinem Ring holt
    // NIEMAND -- der einzige `ev_pop` sitzt im Systemaufruf WM_EVENT,
    // und dazu braucht es ein Ring-3-Programm mit einem Handle darauf.
    // Jede Bewegung ueber dem Terminal ging trotzdem in den Ring; nach
    // 32 Stueck fiel fuer jede weitere die aelteste heraus, und der
    // Zaehler VERL zaehlte einen Verlust, der keiner war. In QEMU faehrt
    // kein Laeufer die Maus ueber das Terminal -- deshalb dort 0.
    //
    // Ein Terminalfenster mit gebundenem tty (W_TTY) bekommt deshalb
    // nichts eingereiht: gezaehlt (S_EVTERM, und W_KEYS wie bisher),
    // sonst nichts. Das Terminal des Selbsttests hat kein tty und
    // verhaelt sich wie vorher.
    if wg(state, i, W_KIND) == K_TERM && wg(state, i, W_TTY) != 0 {
        ss(state, S_EVTERM, gs(state, S_EVTERM) + 1)
        if typ == E_MOVE {
            frameprof.hover_term()
        }
        return
    }
    let kopf: u64 = wg(state, i, W_EHEAD)
    let schwanz: u64 = wg(state, i, W_ETAIL)
    let daten: u64 = ((a & 0xFFFF) << 32) | ((b & 0xFFFF) << 16)
        | (c & 0xFFFF)
    // KOALESZENZ DER BEWEGUNG. Eine Maus mit 1000 Berichten je Sekunde
    // legt in die 25 ms, die die Leiste zwischen zwei Abholrunden
    // schlaeft, 25 Bewegungen -- der Ring hat 32 Plaetze, und ein
    // Anstrich dazwischen reicht fuer den Ueberlauf. Von einer Bewegung
    // interessiert eine Anwendung aber nur die LETZTE Stelle: liegt als
    // juengstes, noch nicht abgeholtes Ereignis schon ein E_MOVE, wird
    // es ueberschrieben statt eines neuen eingereiht. Tasten, Klicks,
    // Schliessen, Fokus, Groesse: jedes ein eigener Platz, nie verworfen.
    //
    // Der Abholer liest Art und Daten eines Platzes und rueckt danach
    // den Schwanz vor; wird das Datenwort waehrenddessen ueberschrieben,
    // liest er die neuere Stelle -- auch das ist die richtige.
    if typ == E_MOVE {
        frameprof.hover_push(i, a, b)
    }
    if typ == E_MOVE && kopf > schwanz {
        let letzt: u64 = ev_at(state, i, kopf - 1)
        if kstate.get(letzt, 0) == E_MOVE {
            kstate.set(letzt, 8, daten)
            ss(state, S_EVKOAL, gs(state, S_EVKOAL) + 1)
            frameprof.hover_coal()
            return
        }
    }
    if kopf - schwanz >= EV_SLOTS {
        // ============================================ RUNDE ECHTHARDWARE-3
        // WENN DER RING VOLL IST, FLIEGT KEINE TASTE MEHR RAUS.
        //
        // Justins Tafel: `4 RING 3663 VERL 151`. Bis hierher verlor
        // ein voller Ring IMMER das aelteste Ereignis -- und weil in
        // einem vollen Ring fast nur Mausbewegungen liegen (die Maus
        // meldet tausendmal je Sekunde, ein Mensch tippt fuenfmal),
        // war das aelteste fast immer eine Bewegung. Fast immer, aber
        // eben nicht immer: stand vorn ein TASTENDRUCK, war er weg,
        // und der Mensch sieht einen verschluckten Buchstaben.
        //
        // Eine Bewegung darf man verlieren -- die naechste sagt
        // dasselbe und mehr. Eine TASTE nicht: sie kommt nie wieder.
        // Also wird der Ring von vorn nach der ersten BEWEGUNG
        // durchsucht und die geopfert; nur wenn wirklich keine drin
        // steht (32 Tasten ohne eine Abholrunde -- ein Programm, das
        // steht), faellt das aelteste Ereignis.
        var op: u64 = schwanz
        var weg: u64 = kopf // kopf = "nichts gefunden"
        while op < kopf {
            if kstate.get(ev_at(state, i, op), 0) == E_MOVE {
                weg = op
                op = kopf
            } else {
                op = op + 1
            }
        }
        if weg < kopf {
            // Die Bewegung herausnehmen und alles danach eine Stelle
            // nach vorn ruecken. Der Kopf sinkt um eins, der Schwanz
            // bleibt -- die Reihenfolge der Tasten bleibt erhalten.
            var q: u64 = weg
            while q + 1 < kopf {
                let a1: u64 = ev_at(state, i, q)
                let b1: u64 = ev_at(state, i, q + 1)
                kstate.set(a1, 0, kstate.get(b1, 0))
                kstate.set(a1, 8, kstate.get(b1, 8))
                q = q + 1
            }
            wsv(state, i, W_EHEAD, kopf - 1)
            ss(state, S_EVKOAL, gs(state, S_EVKOAL) + 1)
        } else {
            // ================================ RUNDE ECHTHARDWARE-5
            // WER VERLIERT, WIRD BEIM NAMEN GENANNT.
            //
            // Justins Tafel: `RING 917 VERL 29`. `VERL` sagt nur, DASS
            // etwas verlorenging -- nicht, WESSEN Ring ueberlief, und
            // ohne das ist der Befund nicht zu beheben. Ein Verlust
            // hier heisst: der Ring dieses Fensters ist voll UND es
            // steht keine einzige Bewegung darin, die man opfern
            // koennte. Das ist immer ein Fenster, das seine Ereignisse
            // NICHT ABHOLT -- 32 Tasten/Klicks ohne eine Abholrunde.
            //
            // Die Zeile nennt Fenster, Kennung, Art und wie viele
            // Ereignisse anstehen. Damit ist der Schuldige eine
            // Ablesung und keine Vermutung.
            // ==================================== RUNDE ECHTHARDWARE-6
            // DIESE ZEILE WIRD GEDECKELT -- SIE WAR SELBST EIN TEIL
            // DES FEHLERS, DEN SIE MELDET.
            //
            // Justins Tafel nach 42 Minuten: `RING 23320 VERL 8908
            // KOAL 57944`. Achttausendneunhundert Verluste heissen
            // achttausendneunhundert Zeilen ueber die serielle
            // Leitung -- byteweise, blockierend, und zwar AUS
            // `ev_push`, das aus dem Unterbrechungsweg der Maus
            // gerufen wird. Jede gemeldete verlorene Bewegung kostet
            // dabei so viel Zeit, dass die naechsten Bewegungen
            // ebenfalls nicht abgeholt werden. Die Meldung erzeugt
            // also genau den Zustand, den sie beschreibt.
            //
            // Dasselbe Muster wie beim Taskmanager in dieser Runde:
            // ein Messausgang, der im Normalbetrieb laeuft, misst vor
            // allem sich selbst.
            //
            // Die ersten VERL_SAGEN Verluste werden weiter voll
            // gemeldet -- damit bleibt der Schuldige eine Ablesung und
            // keine Vermutung, und genau dafuer ist die Zeile da.
            // Danach zaehlt nur noch `S_EVDROP`, und die Zahl steht
            // auf der Tafel.
            if gs(state, S_EVDROP) < VERL_SAY {
            var s_vl: [u8; 19] = "wm: RINGVERLUST i=\0"
            var s_vid: [u8; 5] = " id=\0"
            var s_vt: [u8; 6] = " typ=\0"
            var s_vk: [u8; 7] = " kind=\0"
            var s_vn: [u8; 5] = " an=\0"
            serial.puts((&s_vl[0]) as u64)
            serial.dec(i)
            serial.puts((&s_vid[0]) as u64)
            serial.dec(wg(state, i, W_ID))
            serial.puts((&s_vt[0]) as u64)
            serial.dec(typ)
            serial.puts((&s_vk[0]) as u64)
            serial.dec(wg(state, i, W_KIND))
            serial.puts((&s_vn[0]) as u64)
            serial.dec(kopf - schwanz)
            serial.nl()
            }
            wsv(state, i, W_ETAIL, schwanz + 1)
            ss(state, S_EVDROP, gs(state, S_EVDROP) + 1)
        }
    }
    let kopf2: u64 = wg(state, i, W_EHEAD)
    let p: u64 = ev_at(state, i, kopf2)
    kstate.set(p, 0, typ)
    kstate.set(p, 8, daten)
    wsv(state, i, W_EHEAD, kopf2 + 1)
    // RUNDE MESSTAFEL, Stufe 4a: hier verlaesst das Ereignis den Kern.
    ss(state, S_EVPUSH, gs(state, S_EVPUSH) + 1)
}

fn ev_waiting(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return wg(state, i, W_EHEAD) - wg(state, i, W_ETAIL)
}

// Holt ein Ereignis. `out` bekommt zwei Achtoktettworte: Art und Daten.
fn ev_pop(state: u64, i: u64, out: u64) -> bool {
    if ev_waiting(state, i) == 0 {
        return false
    }
    let schwanz: u64 = wg(state, i, W_ETAIL)
    let p: u64 = ev_at(state, i, schwanz)
    kstate.set(out, 0, kstate.get(p, 0))
    kstate.set(out, 8, kstate.get(p, 8))
    if kstate.get(p, 0) == E_MOVE {
        frameprof.hover_pop()
    }
    wsv(state, i, W_ETAIL, schwanz + 1)
    // RUNDE MESSTAFEL, Stufe 4b: und hier holt es ein Programm ab.
    // Diese Zeile ist der einzige Beleg dafuer, dass ueberhaupt noch
    // ein Ring-3-Prozess laeuft.
    ss(state, S_EVPOP, gs(state, S_EVPOP) + 1)
    return true
}

// ------------------------------------------------------- die Eingabe

// Welches Fenster liegt an dieser Stelle -- das OBERSTE. Gibt MAX_WIN,
// wenn dort der Hintergrund ist.
fn hit(state: u64, x: i64, y: i64) -> u64 {
    var z: u64 = gs(state, S_COUNT)
    while z > 0 {
        z = z - 1
        let i: u64 = at_z(state, z)
        // ================================== RUNDE ECHTHARDWARE-3
        // EINE BLASE NIMMT KEINEN KLICK. Sie liegt ueber allem, damit
        // man sie SIEHT -- wer dorthin klickt, meint das, was darunter
        // liegt. Ohne diese Bedingung faengt die Blase den Klick weg,
        // und der Knopf darunter tut nichts.
        // RUNDE DREI (S-006): DIE EINBLENDUNG AUCH NICHT. Sie steht
        // vier Sekunden rechts oben; wer in dieser Zeit dorthin klickt,
        // meint das Fenster darunter. Waere sie hier nicht genannt,
        // fraesse sie in genau diesen vier Sekunden jeden Klick in
        // ihrer Ecke -- und zwar unsichtbar, weil sie danach weg ist.
        if i < MAX_WIN && wg(state, i, W_LAYER) != L_TIP
            && wg(state, i, W_LAYER) != L_TOAST
            && (wg(state, i, W_FLAGS) & (F_HIDDEN | F_TABBED)) == 0 {
            let rx: i64 = win_x(state, i) + outer_w(state, i) as i64
            let ry: i64 = win_y(state, i) + outer_h(state, i) as i64
            if x >= win_x(state, i) && y >= win_y(state, i) {
                if x < rx && y < ry {
                    return i
                }
            }
        }
    }
    return MAX_WIN
}

// Der Zeiger hat sich bewegt oder eine Taste gewechselt. Wird aus der
// Unterbrechungsbehandlung heraus gerufen; alles, was hier passiert,
// muss ohne Warten auskommen.
static mut cp_pb: u64 = 0 // COMPOSITOR S5: the buttons of the last report (a change is an event for the compositor)
static mut wh_seen: u64 = 0 // ROUND FV-W24: the driver's wheel sum as far as it was handed out

// ROUND FV-W24: the wheel notches since the last call, to the window under
// the pointer. Not while the trusted dialog is up or the screen is locked
// (`darf`); the sum is taken either way so nothing is replayed later.
fn wheel_out(state: u64, x: u64, y: u64) {
    let sum: u64 = ps2m.wheel(state)
    if sum == wh_seen {
        return
    }
    var d: i64 = (wh_seen as i64) - (sum as i64)
    wh_seen = sum
    if d > 127 {
        d = 127
    }
    if d < 0 - 127 {
        d = 0 - 127
    }
    if d == 0 || td_live(state) {
        return
    }
    let i: u64 = hit(state, x as i64, y as i64)
    if i >= MAX_WIN || !darf(state, i) {
        return
    }
    let lx: i64 = (x as i64) - win_x(state, i) - inx(state, i) as i64
    let ly: i64 = (y as i64) - win_y(state, i) - iny(state, i) as i64
    if lx < 0 || ly < 0 {
        return
    }
    input_seen(state)
    if wg(state, i, W_KIND) == K_TERM {
        sb_wheel(state, i, d)
        return
    }
    ev_push(state, i, E_WHEEL, lx as u64, ly as u64, (d as u64) & 0xFFFF)
}

static mut hwh_seen: u64 = 0 // r804: the driver's horizontal wheel sum as far as it was handed out

// r804: horizontal wheel notches since the last call, to the window under the pointer (same rules as wheel_out).
fn hwheel_out(state: u64, x: u64, y: u64) {
    let sum: u64 = ps2m.hwheel(state)
    if sum == hwh_seen {
        return
    }
    var d: i64 = (sum as i64) - (hwh_seen as i64)
    hwh_seen = sum
    if d > 127 {
        d = 127
    }
    if d < 0 - 127 {
        d = 0 - 127
    }
    if d == 0 || td_live(state) {
        return
    }
    let i: u64 = hit(state, x as i64, y as i64)
    if i >= MAX_WIN || !darf(state, i) {
        return
    }
    let lx: i64 = (x as i64) - win_x(state, i) - inx(state, i) as i64
    let ly: i64 = (y as i64) - win_y(state, i) - iny(state, i) as i64
    if lx < 0 || ly < 0 {
        return
    }
    input_seen(state)
    ev_push(state, i, E_HWHEEL, lx as u64, ly as u64, (d as u64) & 0xFFFF)
}

// 0x0B8 in the mouse state (ps2m.S_PRESSED): buttons that went down since the last look
const MOUSE_PRESSED_OFF: u64 = 0x0B8

// ============================================================ W-DND
// DRAG AND DROP IN THE WINDOW SERVER. The payload lives on the bus (`slots.drag_*`: the source puts it there when a
// drag starts, a target takes it on release). A drag RUNS while the left button is down and the slot is full. What the
// server adds:
//   - hover-raise: ~600 ms over a background window raises it (and gives it the focus), so one can drop there; the
//     taskbar does the same for its window buttons (taskbar.fi `dnd_bar_step`).
//   - Esc cancels: the slot is emptied, the release then drops nothing.
//   - the pointer shows "forbidden" over the desktop (nobody takes a drop there).
//   - a K_TERM window with a tty takes a PATH as typed text (`dnd_take_paste`, pumped by kgui).
//   - a fresh left press empties a stale slot (a drag nobody took).
// Witness lines on the serial port: `wm: dndraise id=N`, `wm: dndcancel`, `wm: dndterm tty=T`.
static mut dh_win: u64 = 0     // window under the pointer + 1 while a drag runs, 0 = none / not raisable
static mut dh_t: u64 = 0       // mono_ns when the pointer came to that window
static mut dh_raised: u64 = 0  // window + 1 raised for the current hover
static mut dh_live: u64 = 0    // 1 = a drag runs (left down, slot full)
static mut dh_prev: u64 = 0    // left button of the last look
static mut dh_tty: u64 = 0     // tty + 1 waiting to be typed a dropped path, 0 = none
static mut dh_src: u64 = 0     // window + 1 under the pointer at the left press (the drag source), 0 = none
static mut dh_nraise: u64 = 0
static mut dh_ncancel: u64 = 0
const DH_DELAY_NS: u64 = 600000000

fn dnd_say(state: u64, which: u64, v: u64) {
    var s_r: [u8; 17] = "wm: dndraise id=\0"
    var s_c: [u8; 14] = "wm: dndcancel\0"
    var s_t: [u8; 17] = "wm: dndterm tty=\0"
    var s_s: [u8; 16] = "wm: dndsrc id=\0\0"
    if which == 3 {
        serial.puts((&s_s[0]) as u64)
        serial.dec(v)
    } else if which == 0 {
        serial.puts((&s_r[0]) as u64)
        serial.dec(v)
    } else if which == 1 {
        serial.puts((&s_c[0]) as u64)
    } else {
        serial.puts((&s_t[0]) as u64)
        serial.dec(v)
    }
    serial.nl()
}

// Called with every pointer look (`i` = window under the pointer, MAX_WIN = none).
fn dnd_hover(state: u64, i: u64, btn: u64) {
    let left: u64 = btn & ps2m.B_LEFT
    let was: u64 = dh_prev
    dh_prev = left
    if left != 0 && was == 0 {
        // a new press: a payload nobody took is stale
        if slots.drag_active(state) != 0 {
            let _c: u64 = slots.drag_clear(state)
        }
        dh_live = 0
        dh_win = 0
        dh_raised = 0
        dh_src = 0
        if i < MAX_WIN && valid(state, i) {
            dh_src = i + 1
        }
        return
    }
    if left == 0 {
        // The release goes to the window under the pointer. The SOURCE of a live drag never sees it otherwise and
        // keeps its drag chip; tell it with a release far outside its own area (nothing there to hit).
        if was != 0 && dh_live != 0 && dh_src != 0 && dh_src != i + 1 && valid(state, dh_src - 1) {
            ev_push(state, dh_src - 1, E_UP, 0x7FFF, 0x7FFF, ps2m.B_LEFT)
            dnd_say(state, 3, wg(state, dh_src - 1, W_ID))
        }
        dh_src = 0
        if was != 0 && dh_live != 0 && i < MAX_WIN && valid(state, i) && darf(state, i)
            && wg(state, i, W_KIND) == K_TERM && slots.drag_active(state) != 0
            && (slots.drag_types(state) & bus.T_PATH) != 0 {
            let t: u64 = tty_of(state, i)
            if t != NO_TTY {
                dh_tty = t + 1
                dnd_say(state, 2, t)
            }
        }
        dh_live = 0
        dh_win = 0
        dh_raised = 0
        return
    }
    if slots.drag_active(state) == 0 {
        dh_live = 0
        dh_win = 0
        dh_raised = 0
        return
    }
    dh_live = 1
    if i >= MAX_WIN || !valid(state, i) || !darf(state, i)
        || (wg(state, i, W_LAYER) != L_NORMAL && wg(state, i, W_LAYER) != L_FLOAT) {
        dh_win = 0
        return
    }
    if dh_win != i + 1 {
        dh_win = i + 1
        dh_t = time.mono_ns(state)
        if dh_raised != i + 1 {
            dh_raised = 0
        }
    }
}

// Every tick: has the pointer rested long enough on a background window?
fn dnd_tick(state: u64) {
    if dh_live == 0 || dh_win == 0 || dh_raised == dh_win {
        return
    }
    if time.mono_ns(state) - dh_t < DH_DELAY_NS {
        return
    }
    let i: u64 = dh_win - 1
    dh_raised = dh_win
    if i >= MAX_WIN || !valid(state, i) || focus(state) == i {
        return
    }
    raise_win(state, i)
    set_focus(state, i)
    dh_nraise = dh_nraise + 1
    dnd_say(state, 0, wg(state, i, W_ID))
}

// Esc while a drag runs: the payload goes, the release drops nothing. True = the key is consumed.
fn dnd_cancel(state: u64) -> bool {
    if dh_prev == 0 || slots.drag_active(state) == 0 {
        return false
    }
    let _c: u64 = slots.drag_clear(state)
    dh_live = 0
    dh_win = 0
    dh_raised = 0
    dh_ncancel = dh_ncancel + 1
    dnd_say(state, 1, 0)
    return true
}

// kgui pumps this: a path dropped on a terminal window. Copies "<path> " to `out` (max bytes), returns
// (tty << 32) | length, 0 = nothing waits. The slot is emptied.
fn dnd_take_paste(state: u64, out: u64, max: u64) -> u64 {
    if dh_tty == 0 {
        return 0
    }
    let t: u64 = dh_tty - 1
    dh_tty = 0
    if max < 4 {
        return 0
    }
    var n: u64 = slots.drag_get(state, out, max - 2, 0)
    let _c: u64 = slots.drag_clear(state)
    if n == 0 || n >= max - 2 {
        return 0
    }
    kstate.set8(out + n, 32)
    n = n + 1
    return (t << 32) | n
}

fn dnd_live_pub() -> u64 {
    return dh_live
}

fn dnd_nraise_pub() -> u64 {
    return dh_nraise
}

fn dnd_ncancel_pub() -> u64 {
    return dh_ncancel
}

// "forbidden" shape wanted? A drag runs and the pointer is over the desktop (or no window).
fn dnd_forbidden(state: u64, i: u64) -> bool {
    if dh_live == 0 {
        return false
    }
    if i >= MAX_WIN || !valid(state, i) {
        return true
    }
    return wg(state, i, W_LAYER) == L_DESK
}

fn on_mouse(state: u64) {
    if !ready(state) {
        return
    }
    // A press AND its release that both landed before this look leave the button state unchanged ("never
    // pressed"): the click is lost (toolbar buttons that ignored a click under host load). The driver remembers
    // the press; replay it as its own step, then handle the real state (the release).
    let pend: u64 = kstate.get(state + kstate.MOUSE_OFF, MOUSE_PRESSED_OFF)
    kstate.set(state + kstate.MOUSE_OFF, MOUSE_PRESSED_OFF, 0)
    let now: u64 = ps2m.buttons(state)
    let seen: u64 = gs(state, S_KEYS) & 7
    let lost: u64 = pend & ~now & ~seen & 7
    if lost != 0 {
        on_mouse_btn(state, seen | lost)
    }
    on_mouse_btn(state, now)
}

// A button went down: every popup menu (L_POPUP) the press did not land on is dismissed, like Esc. The owner reads E_CLOSE in
// its wlib step, answers "dismissed" (0xFFFF) and closes the menu window itself (the window stays until then, so the event is never
// lost); the press itself still goes to the window under the pointer.
fn popup_outside(state: u64, hit_win: u64) {
    var j: u64 = 0
    var menu_open: bool = false
    while j < MAX_WIN {
        if valid(state, j) && wg(state, j, W_LAYER) == L_MENUE && (wg(state, j, W_FLAGS) & F_HIDDEN) == 0 {
            menu_open = true
        }
        j = j + 1
    }
    // the start menu closes when it loses the focus; the bare desktop takes the focus only when a start menu stands (a press there is
    // an outside press for it) -- otherwise typing into the window keeps working after a click on the wallpaper
    if menu_open && hit_win < MAX_WIN && valid(state, hit_win) && wg(state, hit_win, W_LAYER) == L_DESK {
        set_focus(state, hit_win)
    }
    j = 0
    while j < MAX_WIN {
        if j != hit_win && valid(state, j) && wg(state, j, W_LAYER) == L_POPUP {
            ev_push(state, j, E_CLOSE, 0, 0, 0)
        }
        j = j + 1
    }
}

fn on_mouse_btn(state: u64, btn: u64) {
    let nx: u64 = ps2m.x(state)
    let ny: u64 = ps2m.y(state)
    let ox: u64 = gs(state, S_CURX)
    let oy: u64 = gs(state, S_CURY)
    wheel_out(state, nx, ny)
    hwheel_out(state, nx, ny)
    // COMPOSITOR S5: the input-to-picture clock starts at the interrupt, and the compositor gets a copy of the pointer (not while locked)
    if nx != ox || ny != oy {
        frameprof.hover_in()
        if !hwcur_an(state) {
            cp_in(state)
        }
        cp_event(state, CP_EV_MOVE, 0, btn, nx, ny, 0)
    }
    if btn != cp_pb {
        cp_pb = btn
        cp_event(state, CP_EV_BTN, 0, btn, nx, ny, 0)
    }
    if nx != ox || ny != oy {
        // DIE WIEDERHERSTELLUNG DES HINTERGRUNDS. Beide Rechtecke --
        // das alte und das neue -- werden schmutzig; `compose` malt
        // dort den Hintergrund und die Fenster neu und danach den
        // Zeiger. Ein gerettetes Rechteck waere der zweite Weg dahin
        // und muesste bei jedem Fensterwechsel nachgezogen werden.
        // RUNDE ECHTHARDWARE-4: der Griffpunkt gehoert in beide
        // Rechtecke. Ohne ihn bliebe bei jeder Form ausser dem Pfeil
        // ein Streifen des alten Bildes stehen -- genau die "Spuren",
        // nach denen Justin gefragt hat.
        let gx: u64 = cur_ox(state)
        let gy: u64 = cur_oy(state)
        let gw: u64 = cur_w(state)
        // ================================ RUNDE GPU (G-012)
        // HIER WIRD DIE ARBEIT WIRKLICH GESPART. Traegt die Hardware
        // den Zeiger, wird KEIN Rechteck schmutzig: weder das alte
        // noch das neue. `compose` laeuft fuer die Bewegung gar nicht
        // mehr an, und `present` traegt nichts hinaus -- die Bewegung
        // kostet einen Befehl von 56 Oktetten statt zweier Rechtecke
        // Bildpunkte. Das ist die Zahl, die diese Runde misst.
        if hwcur_an(state) {
            ss(state, S_CURX, nx)
            ss(state, S_CURY, ny)
            hwcur_bewegen(state)
        } else {
            if !pixelguard.bug_is(3) {
                damage_ex(state, ox as i64 - gx as i64, oy as i64 - gy as i64,
                    (ox + gw) as i64 - gx as i64, (oy + gw) as i64 - gy as i64, BT_ALL)
            }
            ss(state, S_CURX, nx)
            ss(state, S_CURY, ny)
            damage_ex(state, nx as i64 - gx as i64, ny as i64 - gy as i64,
                (nx + gw) as i64 - gx as i64, (ny + gw) as i64 - gy as i64, BT_ALL)
        }
    }
    let x: i64 = nx as i64
    let y: i64 = ny as i64
    // ROUND ACTION-BUS-5 (AB-004): while the trusted dialog is up the
    // mouse belongs to it -- a press on a button answers it, nothing
    // reaches a window below
    if td_live(state) {
        if (btn & ps2m.B_LEFT) != 0 && (td_mb & ps2m.B_LEFT) == 0 {
            td_click(state, nx, ny)
        }
        td_mb = btn
        return
    }
    td_mb = btn
    // r382 LOCK SEAL: a drag or a resize that was running when the lock
    // came is ended; nothing moves a window while the screen is locked.
    if sperre_an(state) {
        if gs(state, S_DRAG) != 0 {
            ss(state, S_DRAG, 0)
        }
        if gs(state, S_SIZING) != 0 {
            ss(state, S_SIZING, 0)
        }
    }
    // Ziehen
    if gs(state, S_DRAG) != 0 {
        let i: u64 = gs(state, S_DRAG) - 1
        if (btn & ps2m.B_LEFT) == 0 {
            ss(state, S_DRAG, 0)
            drag_end(state, i, x, y)
        } else {
            if (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0 && wg(state, i, W_NODE) == 0 && !fb.nosnap_an(state) {
                let ddx: i64 = x - win_x(state, i) - gs(state, S_DRAGX) as i64
                let ddy: i64 = y - win_y(state, i) - gs(state, S_DRAGY) as i64
                let thr: i64 = 5 * uisc(state) as i64
                if ddx > thr || ddx < 0 - thr || ddy > thr || ddy < 0 - thr {
                    if !float_unmax(state, i, x, y) {
                        move_win(state, i, x - gs(state, S_DRAGX) as i64,
                            y - gs(state, S_DRAGY) as i64)
                    }
                    drag_hover(state, i, x, y)
                }
                return
            }
            move_win(state, i, x - gs(state, S_DRAGX) as i64,
                y - gs(state, S_DRAGY) as i64)
            drag_hover(state, i, x, y)
            return
        }
    }
    if gs(state, S_SIZING) != 0 {
        let i: u64 = gs(state, S_SIZING) - 1
        if (btn & ps2m.B_LEFT) == 0 {
            ss(state, S_SIZING, 0)
            // DELL ROUND: the end of a resize, on the wire (a runner reads it)
            if i < MAX_WIN && valid(state, i) {
                var s_gz: [u8; 17] = "wm: gezogen id=\0\0"
                var s_gx: [u8; 4] = " x=\0"
                var s_gy: [u8; 4] = " y=\0"
                var s_gw: [u8; 4] = " w=\0"
                var s_gh: [u8; 4] = " h=\0"
                serial.puts((&s_gz[0]) as u64)
                serial.dec(wg(state, i, W_ID))
                serial.puts((&s_gx[0]) as u64)
                serial.dec(win_x(state, i) as u64)
                serial.puts((&s_gy[0]) as u64)
                serial.dec(win_y(state, i) as u64)
                serial.puts((&s_gw[0]) as u64)
                serial.dec(wg(state, i, W_W))
                serial.puts((&s_gh[0]) as u64)
                serial.dec(wg(state, i, W_H))
                serial.nl()
            }
        } else {
            // RUNDE TILING: ein Fenster IM BAUM wird nicht frei
            // gezogen -- es verschiebt die Trennlinie.
            if wg(state, i, W_NODE) != 0 {
                tile_drag_resize(state, i, x, y)
                return
            }
            // RUNDE DESKTOP: der Rand kommt aus `inx`/`iny` und nicht
            // aus BORDER/TITLE_H -- ein Fenster ohne Schmuck (F_NODECO,
            // Schreibtisch und Taskleiste) hat keinen.
            // ==================================== RUNDE ECHTHARDWARE-5
            // GEGEN DEN ANKER RECHNEN, NICHT GEGEN DIE LINKE OBERE ECKE.
            //
            // Hier stand `x - win_x(...)`: die neue Breite war immer der
            // Abstand vom LINKEN Rand zum Zeiger. Fuer die rechte Kante
            // ist das richtig; fuer die linke ist es genau verkehrt
            // herum, und fuer die obere ebenso. Das ist der ganze Grund,
            // warum bei Justin nur rechts (und unten) etwas passierte.
            //
            // Jetzt: die angefasste Kante folgt dem Zeiger, die
            // GEGENUEBERLIEGENDE steht fest. Aus beiden ergibt sich die
            // Groesse -- und, wenn links oder oben gezogen wurde, ein
            // neuer Ursprung. Beides wird in EINEM Schritt gesetzt,
            // sonst zappelt das Fenster.
            let kanten: u64 = gs(state, S_SZEDGE)
            let ax: i64 = gs(state, S_SZAX) as i64
            let ay: i64 = gs(state, S_SZAY) as i64
            let ix: i64 = inx(state, i) as i64
            let iy: i64 = iny(state, i) as i64
            var nw: i64 = gs(state, S_SZAW) as i64
            var nh: i64 = gs(state, S_SZAH) as i64
            var nx: i64 = win_x(state, i)
            var ny: i64 = win_y(state, i)
            // RUNDE ECHTHARDWARE-6: der Zustand VOR dem Zug, fuer die
            // Meldung weiter unten.
            let alt_w: u64 = wg(state, i, W_W)
            let alt_h: u64 = wg(state, i, W_H)
            let alt_x: i64 = win_x(state, i)
            let alt_y: i64 = win_y(state, i)
            let offx: i64 = gs(state, S_SZOFFX) as i64
            let offy: i64 = gs(state, S_SZOFFY) as i64
            if (kanten & SZ_R) != 0 {
                nw = (x - offx) - (win_x(state, i) + ix)
            } else if (kanten & SZ_L) != 0 {
                // Die rechte Kante steht bei `ax`; der Zeiger ist die
                // neue linke. Die Breite ist der Abstand dazwischen.
                nw = ax - (x - offx)
            }
            if (kanten & SZ_B) != 0 {
                nh = (y - offy) - (win_y(state, i) + iy)
            } else if (kanten & SZ_T) != 0 {
                // DELL ROUND: `y - offy` is the OUTER top edge; the
                // content starts `iy` (the title bar) below it.
                nh = ay - ((y - offy) + iy)
            }
            // DIE MINDESTGROESSE, UND ZWAR VOR DEM VERSCHIEBEN.
            // Wer sie erst danach begrenzt, laesst das Fenster beim
            // Unterschreiten weiterwandern, obwohl es nicht mehr
            // schrumpft -- das ist das "Springen", das Justin
            // ausdruecklich nicht will.
            // DIESELBE UNTERGRENZE, DIE `resize_win` SELBST ZIEHT
            // (32x16 mit Schmuck, 1x1 ohne) -- hier noch einmal, weil
            // sie VOR dem Verschieben gebraucht wird und nicht erst
            // beim Ablehnen.
            var minw: i64 = 32
            var minh: i64 = 16
            if !win_deco(state, i) {
                minw = 1
                minh = 1
            }
            if nw < minw {
                nw = minw
            }
            if nh < minh {
                nh = minh
            }
            if (kanten & SZ_L) != 0 {
                nx = ax - nw - ix
            }
            if (kanten & SZ_T) != 0 {
                ny = ay - nh - iy
            }
            // ==================================== RUNDE ECHTHARDWARE-5
            // NICHT UEBER DEN LINKEN ODER OBEREN RAND HINAUS.
            //
            // GEMESSEN in dieser Runde: zieht man die linke Kante ueber
            // den Bildschirmrand, wird `nx` negativ (der Server meldete
            // `x=18446744073709551608`, also -8 als Zweierkomplement),
            // und der naechste Anstrich rechnet mit einer Adresse
            // ausserhalb des Rahmenpuffers. Ein Fenster, das man aus
            // dem Schirm herausziehen kann, ist kein Fenster mehr.
            //
            // Also: der Ursprung bleibt auf dem Schirm, und die Breite
            // wird entsprechend gekappt -- die angefasste Kante bleibt
            // damit unter dem Zeiger, bis der Rand erreicht ist, und
            // steht dann still.
            if (kanten & SZ_L) != 0 && nx < 0 {
                nw = nw + nx
                nx = 0
                if nw < minw {
                    nw = minw
                }
            }
            if (kanten & SZ_T) != 0 && ny < 0 {
                nh = nh + ny
                ny = 0
                if nh < minh {
                    nh = minh
                }
            }
            // RUNDE ECHTHARDWARE-5: die Spur des Ziehens. Ohne sie
            // ist "die Groesse aendert sich nicht" nicht von "die
            // Kante wurde nie angefasst" zu unterscheiden.
            var s_sz: [u8; 12] = "wm: zieh k=\0"
            var s_szw: [u8; 5] = " w=\0\0"
            var s_szh: [u8; 5] = " h=\0\0"
            var s_szx: [u8; 5] = " x=\0\0"
            var s_szr: [u8; 6] = " rc=\0\0"
            serial.puts((&s_sz[0]) as u64)
            serial.dec(kanten)
            serial.puts((&s_szw[0]) as u64)
            serial.dec(nw as u64)
            serial.puts((&s_szh[0]) as u64)
            serial.dec(nh as u64)
            serial.puts((&s_szx[0]) as u64)
            serial.dec(nx as u64)
            let ok: bool = resize_win(state, i, nw as u64, nh as u64)
            // ==================================== RUNDE ECHTHARDWARE-6
            // WAS DAS FENSTER VORHER WAR. Ohne diese vier Zahlen ist
            // `rc=1` nur eine Zusage: `resize_win` gibt auch dann true,
            // wenn es die Groesse auf die Untergrenze gekappt hat, und
            // von aussen sieht "gekappt" wie "nicht gewirkt" aus.
            // Justins Befund B ist genau diese Unterscheidung.
            var s_va: [u8; 8] = " vorw=\0\0"
            var s_vb: [u8; 8] = " vorh=\0\0"
            var s_vx: [u8; 8] = " vorx=\0\0"
            var s_vy: [u8; 8] = " vory=\0\0"
            serial.puts((&s_va[0]) as u64)
            serial.dec(alt_w)
            serial.puts((&s_vb[0]) as u64)
            serial.dec(alt_h)
            serial.puts((&s_vx[0]) as u64)
            serial.dec(alt_x as u64)
            serial.puts((&s_vy[0]) as u64)
            serial.dec(alt_y as u64)
            serial.puts((&s_szr[0]) as u64)
            if ok {
                serial.dec(1)
            } else {
                serial.dec(0)
            }
            serial.nl()
            if ok {
                if (kanten & SZ_L) != 0 || (kanten & SZ_T) != 0 {
                    move_win(state, i, nx, ny)
                }
            }
            return
        }
    }
    ss(state, S_MOVES, gs(state, S_MOVES) + 1)
    let i: u64 = hit(state, x, y)
    if (btn & ~(gs(state, S_KEYS) & 7) & 7) != 0 {
        popup_outside(state, i)
    }
    // RUNDE SOFTUI: der Ueberfahr-Zustand der drei Schaltflaechen. Er
    // steht VOR dem Ausstieg fuer "kein Fenster getroffen", denn genau
    // dann muss er zurueckgesetzt werden -- sonst bleibt der rote
    // Schliessen-Knopf rot, nachdem der Zeiger das Fenster verlassen
    // hat.
    cap_track(state, i, x, y)
    dnd_hover(state, i, btn) // W-DND
    if gs(state, S_CAPDOWN) != 0 && (btn & ps2m.B_LEFT) == 0 {
        cap_release(state, i, x, y)
    }
    // RUNDE ECHTHARDWARE-4: die Form des Zeigers folgt dem, worueber
    // er steht. Der Aufruf steht VOR dem Ausstieg fuer "kein Fenster
    // getroffen" -- sonst bliebe der Doppelpfeil stehen, wenn man vom
    // Fensterrand auf den Schreibtisch faehrt.
    // r382 LOCK SEAL: the edges of a window that is not on the screen
    // must not show in the pointer shape either.
    if i < MAX_WIN && !darf(state, i) {
        margin_cursor(state, MAX_WIN, x, y)
    } else {
        margin_cursor(state, i, x, y)
    }
    if i >= MAX_WIN {
        return
    }
    // RUNDE ALLTAG: waehrend die Sperre steht, bekommt nur der Sperrer
    // etwas. Die Bewegung des Zeigers selbst laeuft weiter (sonst
    // klebte er fest), die EREIGNISSE gehen nicht hinaus.
    input_seen(state)
    if !darf(state, i) {
        return
    }
    ss(state, S_HITS, gs(state, S_HITS) + 1)
    let lokal_x: i64 = x - win_x(state, i) - inx(state, i) as i64
    let lokal_y: i64 = y - win_y(state, i) - iny(state, i) as i64
    let mit_schmuck: bool = deko(state, i)
    // Tastenwechsel erkennen: `ps2m` fuehrt den Zustand, hier steht der
    // zuletzt GESEHENE.
    let alt: u64 = gs(state, S_KEYS) & 7
    if btn != alt {
        ss(state, S_KEYS, (gs(state, S_KEYS) & ~7) | btn)
        if (btn & ps2m.B_LEFT) != 0 && (alt & ps2m.B_LEFT) == 0 {
            raise_win(state, i)
            // RUNDE DESKTOP: SCHREIBTISCH UND TASKLEISTE NEHMEN DIE
            // TASTATUR NICHT. Wer auf die Leiste klickt, will ein
            // Fenster wechseln und nicht in die Leiste tippen -- und
            // ein Schreibtisch, der den Fokus an sich zieht, macht
            // jeden Tastendruck danach wirkungslos.
            // RUNDE ECHTHARDWARE-1: ... ODER WENN DAS FENSTER
            // AUSDRUECKLICH DARUM GEBETEN HAT (F_KEYS).
            if wg(state, i, W_LAYER) == L_NORMAL
                || (wg(state, i, W_FLAGS) & F_KEYS) != 0 {
                set_focus(state, i)
            }
            if mit_schmuck {
                // RUNDE SOFTUI: die drei Schaltflaechen, wenn die Form
                // sie verlangt. Sie liegen VOR dem Ziehen der Leiste --
                // wer auf das Kreuz klickt, will nicht schieben.
                let cn: u64 = cap_at(state, i, x, y)
                if cn < CAP_N {
                    // r402: the press only HOLDS the button (painted darker); the action
                    // is `cap_act`, on release over the same button (`cap_release`).
                    ss(state, S_CAPDOWN, i * 4 + cn + 1)
                    damage_caption(state, i)
                    return
                }
                // Schliessfeld?
                let bx: i64 = win_x(state, i) + outer_w(state, i) as i64
                    - border(state) as i64 - close_w(state) as i64 - 3
                let by: i64 = win_y(state, i) + 4
                let im_feld: bool = form(state, FM_CAPTION) == 0
                    && x >= bx && x < bx + close_w(state) as i64
                let im_feld2: bool = y >= by && y < by + close_w(state) as i64
                if im_feld && im_feld2 {
                    ev_push(state, i, E_CLOSE, 0, 0, 0)
                    destroy(state, i)
                    return
                }
                // ================================ RUNDE ECHTHARDWARE-5
                // ALLE VIER KANTEN UND ALLE VIER ECKEN.
                //
                // Justins Befund D, woertlich: "Ziehen funktioniert nur
                // an der rechten Kante." Hier stand `am_rechts ||
                // am_unten` -- die linke und die obere Kante wurden gar
                // nicht erst angefasst. Und sie HAETTEN auch nicht
                // funktionieren koennen: `resize_win` rechnet die neue
                // Groesse aus der linken oberen Ecke, die beim Ziehen an
                // der linken Kante ja gerade die ist, die sich bewegt.
                //
                // Also wird jetzt gemerkt, WELCHE Kanten angefasst
                // wurden (Bitmaske) und WO die gegenueberliegende Kante
                // steht (`S_SZAX`/`S_SZAY`). Die Bewegung rechnet dann
                // gegen diesen Anker: die festgehaltene Kante bleibt
                // stehen, das Fenster springt nicht, und eine Ecke
                // aendert beide Achsen zugleich, weil zwei Bits gesetzt
                // sind.
                //
                // DIESE PRUEFUNG STEHT VOR DEM ZIEHEN DER TITELLEISTE,
                // und das ist der eigentliche Fix. Stuende sie danach,
                // waere die OBERE Kante nie erreichbar: `lokal_y < 0`
                // ist die Titelleiste, und die faengt jeden Klick dort
                // ab. Ein Mensch, der ein Fenster oben groesser ziehen
                // will, greift genau dorthin.
                //
                // `lokal_y` ist relativ zur ARBEITSFLAECHE: 0 ist deren
                // Oberkante, die Titelleiste liegt bei negativem
                // `lokal_y`, und der aeussere Rahmen noch darueber. Die
                // obere Greifkante ist deshalb der schmale Streifen
                // GANZ OBEN im Schmuck -- nicht die ganze Titelleiste,
                // sonst liesse sich das Fenster nicht mehr schieben.
                let iw: i64 = wg(state, i, W_W) as i64
                let ih: i64 = wg(state, i, W_H) as i64
                // DELL ROUND: one test for press and cursor (`grip_mask`).
                let kanten: u64 = grip_mask(state, i, lokal_x, lokal_y)
                let im_rahmen: bool = kanten != 0
                if im_rahmen && kanten != 0 {
                    ss(state, S_SIZING, i + 1)
                    ss(state, S_SZEDGE, kanten)
                    // Die Kante, die STEHENBLEIBT, in Bildschirmmass.
                    ss(state, S_SZAX,
                        (win_x(state, i) + inx(state, i) as i64 + iw) as u64)
                    ss(state, S_SZAY,
                        (win_y(state, i) + iny(state, i) as i64 + ih) as u64)
                    ss(state, S_SZAW, iw as u64)
                    ss(state, S_SZAH, ih as u64)
                    // DELL ROUND: the grab offsets (see S_SZOFFX).
                    var ox: i64 = 0
                    var oy: i64 = 0
                    if (kanten & SZ_L) != 0 {
                        ox = x - (win_x(state, i) + inx(state, i) as i64)
                    } else if (kanten & SZ_R) != 0 {
                        ox = x - (win_x(state, i) + inx(state, i) as i64 + iw)
                    }
                    if (kanten & SZ_T) != 0 {
                        oy = y - win_y(state, i)
                    } else if (kanten & SZ_B) != 0 {
                        oy = y - (win_y(state, i) + iny(state, i) as i64 + ih)
                    }
                    if fb.winfix_aus(state) {
                        // counter-proof: the old rule (pointer = content edge)
                        ox = 0
                        oy = 0
                        if (kanten & SZ_T) != 0 {
                            oy = 0 - iny(state, i) as i64
                        }
                    }
                    ss(state, S_SZOFFX, ox as u64)
                    ss(state, S_SZOFFY, oy as u64)
                    return
                }
                // r1014: terminal tabs: a press on an inactive tab, a tab's 'x' or the '+' is the strip's, not the title bar's
                if lokal_y < 0 && wg(state, i, W_KIND) == K_TERM && tt_press(state, i, x, y) {
                    return
                }
                // r454: the strip of a window that paints its own title bar. The empty part (the drag region the program
                // declared) is the title bar: a press moves the window, a second press within one second (the system-wide double click time of wlib) maximises or restores
                // it. The rest of the strip -- the tabs, the plus button -- is the program's: the press goes to it as a
                // normal click (below). The caption buttons were tested above, the lock was tested before all of this.
                if cap_client(state, i) && lokal_y >= 0 && lokal_y < strip_h(state) as i64
                    && strip_drag_at(state, i, lokal_x) {
                    let nowt: u64 = time.mono_ns(state)
                    if gs(state, S_STRIPWIN) == i + 1 && nowt - gs(state, S_STRIPT) < 1000000000 {
                        ss(state, S_STRIPWIN, 0)
                        cap_act(state, i, CAP_MAX)
                        return
                    }
                    ss(state, S_STRIPWIN, i + 1)
                    ss(state, S_STRIPT, nowt)
                    drag_begin(state, i)
                    ss(state, S_DRAG, i + 1)
                    ss(state, S_DRAGX, (x - win_x(state, i)) as u64)
                    ss(state, S_DRAGY, (y - win_y(state, i)) as u64)
                    return
                }
                if lokal_y < 0 {
                    // die Titelleiste: ziehen
                    // RUNDE TILING: wer aus dem Baum gezogen wird, muss
                    // sich merken, dass er darin war.
                    drag_begin(state, i)
                    ss(state, S_DRAG, i + 1)
                    ss(state, S_DRAGX, (x - win_x(state, i)) as u64)
                    ss(state, S_DRAGY, (y - win_y(state, i)) as u64)
                    return
                }
                // ==================================== RUNDE ECHTHARDWARE-3
                // DER GRIFF WAR EIN QUADRAT VON ZWOELF BILDPUNKTEN.
                //
                // Justins Befund: "Fenstergroesse aendern funktioniert
                // nicht". Es funktionierte -- aber nur in der EINEN
                // Ecke unten rechts, und dort auf 12x12 Bildpunkten
                // (GRIP0). Auf seinem 2560x1440-Schirm mit uiscale 2
                // sind das 24x24, also ein knapper Millimeter Ziel:
                // wer den nicht trifft, ZIEHT DAS FENSTER, weil der
                // Klick daneben ein gewoehnlicher Klick ist. Das sieht
                // aus, als ginge es nicht.
                //
                // Jetzt ist der ganze RAND ein Griff: die rechte
                // Kante, die untere Kante und die Ecke dazwischen.
                // Das ist die Bedienung, die jedes andere System hat.
            }
            if wg(state, i, W_KIND) == K_TERM && lokal_x >= 0 && lokal_y >= 0 {
                term_mouse(state, i, 0, lokal_x as u64, lokal_y as u64, btn)
            }
            ss(state, S_DOWNS, gs(state, S_DOWNS) + 1)
            // RUNDE TON: der Klickton. HIER, im Fensterserver, weil
            // hier JEDER Druck der linken Taste vorbeikommt -- kein
            // Programm muss dafuer etwas tun, und keines kann ihn
            // vergessen. Ohne das Wort `audio` ist es ein Vergleich.
            audio.click(state)
            ev_push(state, i, E_DOWN, lokal_x as u64, lokal_y as u64,
                btn | mods_of(state))
            return
        }
        if (btn & ps2m.B_LEFT) == 0 && (alt & ps2m.B_LEFT) != 0 {
            if wg(state, i, W_KIND) == K_TERM && lokal_x >= 0 && lokal_y >= 0 {
                term_mouse(state, i, 1, lokal_x as u64, lokal_y as u64, btn)
            }
            ev_push(state, i, E_UP, lokal_x as u64, lokal_y as u64, alt)
            return
        }
        // RUNDE K15: DIE RECHTE TASTE. Runde K10 sah nur die linke an --
        // sie brauchte nicht mehr, und der Rest lief still ueber die
        // Zustandsmaske. Ein Kontextmenue gibt es ohne rechte Taste
        // nicht, also kommt sie hier dazu: dieselben zwei Ereignisse,
        // dieselben Ortskoordinaten, und die Tastenmaske steht wie bei
        // der linken im dritten Wort. KEIN Heben und KEIN Fokuswechsel
        // dabei -- ein Rechtsklick soll das Fenster nicht umsortieren,
        // sondern nur fragen.
        if (btn & ps2m.B_RIGHT) != 0 && (alt & ps2m.B_RIGHT) == 0 {
            if lokal_x >= 0 && lokal_y >= 0 {
                if wg(state, i, W_KIND) == K_TERM {
                    term_mouse(state, i, 3, lokal_x as u64, lokal_y as u64, btn)
                }
                ss(state, S_DOWNS, gs(state, S_DOWNS) + 1)
                ev_push(state, i, E_DOWN, lokal_x as u64, lokal_y as u64,
                    btn | mods_of(state))
            }
            return
        }
        if (btn & ps2m.B_RIGHT) == 0 && (alt & ps2m.B_RIGHT) != 0 {
            if lokal_x >= 0 && lokal_y >= 0 {
                ev_push(state, i, E_UP, lokal_x as u64, lokal_y as u64,
                    alt)
            }
            return
        }
        // The MIDDLE button, like the right one: same two events, same local
        // coordinates, the button mask in the third word. No raise and no focus
        // change. Without this a remote-desktop viewer never saw a middle
        // click (gui_input: "mouse-middle" had 0 events); programs that do not
        // look at bit 4 ignore the event.
        if (btn & ps2m.B_MIDDLE) != 0 && (alt & ps2m.B_MIDDLE) == 0 {
            if lokal_x >= 0 && lokal_y >= 0 {
                if wg(state, i, W_KIND) == K_TERM {
                    term_mouse(state, i, 4, lokal_x as u64, lokal_y as u64, btn)
                }
                ss(state, S_DOWNS, gs(state, S_DOWNS) + 1)
                ev_push(state, i, E_DOWN, lokal_x as u64, lokal_y as u64,
                    btn | mods_of(state))
            }
            return
        }
        if (btn & ps2m.B_MIDDLE) == 0 && (alt & ps2m.B_MIDDLE) != 0 {
            if lokal_x >= 0 && lokal_y >= 0 {
                ev_push(state, i, E_UP, lokal_x as u64, lokal_y as u64,
                    alt)
            }
            return
        }
    }
    if lokal_x >= 0 && lokal_y >= 0 {
        if (btn & ps2m.B_LEFT) != 0 && wg(state, i, W_KIND) == K_TERM {
            term_mouse(state, i, 2, lokal_x as u64, lokal_y as u64, btn)
        }
        let wid: u64 = wg(state, i, W_ID)
        if wid != mv_wid || lokal_x != mv_lx || lokal_y != mv_ly || btn != mv_btn {
            mv_wid = wid
            mv_lx = lokal_x
            mv_ly = lokal_y
            mv_btn = btn
            ev_push(state, i, E_MOVE, lokal_x as u64, lokal_y as u64, btn)
        }
    }
}

// Eine Taste. Sie geht an das Fenster mit dem EINGABEFOKUS -- und mit
// `nofocus` an alle, damit die Zusage darueber etwas wert ist.
// ============================================ RUNDE ALLTAG: DIE SPERRE
//
// Sie steht hier, wo die Eingabe ihren Weg zu einem Fenster nimmt --
// das ist die einzige Stelle, an der sie WIRKT. Ein Sperrbildschirm,
// der nur ein Fenster ganz vorne ist, ist ein Vorhang: das Fenster
// darunter bekommt jede Taste weiter, und wer den Vorhang abschiesst,
// steht in der Sitzung. Hier bekommt es sie nicht.
fn sperre_an(state: u64) -> bool {
    return kstate.get(state, kstate.K11_OFF + kstate.SP_ON) != 0
}

// ============================================ ROUND ACTION-BUS-5 (AB-004)
// THE TRUSTED CONFIRMATION DIALOG.
//
// Until this round a parked call of the action bus was confirmed with
// `act confirm <no>` on a shell -- a line of text any program could fake
// on the screen, and a question the person had to go and look for. Now
// the broker asks HERE (sys.WM_TRUST) and the window server paints the
// question itself, in `compose`, AFTER every window and before the
// pointer: no window, no panel, no plugin can draw over it. The answer
// comes from `on_key` and `on_mouse` only -- the paths of the real
// keyboard and mouse. A program that types into windows (WM_FWIN) puts
// events into the ring of a WINDOW; the dialog is none, so no program
// can press its buttons, the broker's own adapters included.
//
//   J / Y or a click on "Erlauben"  -> yes
//   N / Escape or "Ablehnen"        -> no
//
// Keys and clicks in the first 400 ms after it appears are ignored, so a
// key already on its way (someone typing when it pops up) cannot answer
// it; Enter is NOT an answer for the same reason. While the screen is
// locked the dialog waits invisibly: the lock screen owns keyboard and
// screen, and a question over it would show who wants what to anyone
// standing at the machine. One dialog at a time; the broker queues.
const TD_COLS: u64 = 60
const TD_HEAD_MAX: u64 = 6
const TD_DET_MAX: u64 = 6
const TD_BTN: u64 = 18
const TD_IN: u64 = 704
const TD_RS: u64 = 30
static mut td_on: u64 = 0
static mut td_no: u64 = 0
static mut td_ans: u64 = 0
static mut td_ansno: u64 = 0
static mut td_t0: u64 = 0
static mut td_mb: u64 = 0
static mut td_shown: u64 = 0
static mut td_focus: u64 = 1
static mut td_nhead: u64 = 0
static mut td_ndet: u64 = 0
static mut td_open: u64 = 0
static mut td_txt: [u8; 768] = [0 as u8; 768]
static mut td_in: [u8; 704] = [0 as u8; 704]
static mut td_title: [u8; 72] = [0 as u8; 72]
static mut td_yes: [u8; 24] = [0 as u8; 24]
static mut td_nol: [u8; 24] = [0 as u8; 24]
static mut td_hint: [u8; 72] = [0 as u8; 72]
static mut td_dlab: [u8; 48] = [0 as u8; 48]

fn td_line(l: u64) -> u64 {
    return ((&td_txt[0]) as u64) + l * 64
}

fn td_inp() -> u64 {
    return (&td_in[0]) as u64
}

fn td_norm(p: u64, n: u64) -> u64 {
    var o: u64 = 0
    var k: u64 = 0
    while k < n && o + 2 < TD_IN {
        let ch: u64 = kstate.get8(p + k)
        k = k + 1
        if ch == 0 {
            k = n
        } else if ch == TD_RS || ch == 10 || (ch >= 32 && ch <= 126) {
            kstate.set8(td_inp() + o, ch as u8)
            o = o + 1
        } else if ch == 0xC3 && k < n {
            let nx: u64 = kstate.get8(p + k)
            k = k + 1
            var a: u64 = 63
            var b: u64 = 0
            if nx == 0xA4 {
                a = 97
                b = 101
            } else if nx == 0xB6 {
                a = 111
                b = 101
            } else if nx == 0xBC {
                a = 117
                b = 101
            } else if nx == 0x9F {
                a = 115
                b = 115
            } else if nx == 0x84 {
                a = 65
                b = 101
            } else if nx == 0x96 {
                a = 79
                b = 101
            } else if nx == 0x9C {
                a = 85
                b = 101
            }
            kstate.set8(td_inp() + o, a as u8)
            o = o + 1
            if b != 0 {
                kstate.set8(td_inp() + o, b as u8)
                o = o + 1
            }
        } else if ch >= 0x80 && ch < 0xC0 {
            o = o
        } else {
            kstate.set8(td_inp() + o, 63 as u8)
            o = o + 1
        }
    }
    kstate.set8(td_inp() + o, 0 as u8)
    return o
}

fn td_seps(n: u64) -> u64 {
    var c: u64 = 0
    var i: u64 = 0
    while i < n {
        if kstate.get8(td_inp() + i) == TD_RS {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn td_fstart(n: u64, idx: u64) -> u64 {
    var f: u64 = 0
    var i: u64 = 0
    while f < idx && i < n {
        if kstate.get8(td_inp() + i) == TD_RS {
            f = f + 1
        }
        i = i + 1
    }
    if f < idx {
        return n + 1
    }
    return i
}

fn td_fend(n: u64, s: u64) -> u64 {
    var i: u64 = s
    while i < n && kstate.get8(td_inp() + i) != TD_RS {
        i = i + 1
    }
    return i
}

fn td_cpz(dst: u64, src: u64, max: u64) {
    var i: u64 = 0
    while i + 1 < max && kstate.get8(src + i) != 0 {
        kstate.set8(dst + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(dst + i, 0 as u8)
}

fn td_cpn(dst: u64, a: u64, b: u64, max: u64) {
    var i: u64 = 0
    while a + i < b && i + 1 < max {
        let ch: u64 = kstate.get8(td_inp() + a + i)
        if ch == 10 {
            kstate.set8(dst + i, 32 as u8)
        } else {
            kstate.set8(dst + i, ch as u8)
        }
        i = i + 1
    }
    kstate.set8(dst + i, 0 as u8)
}

fn td_pick(n: u64, idx: u64, dst: u64, max: u64, def: u64) {
    let s: u64 = td_fstart(n, idx)
    if s <= n {
        let e: u64 = td_fend(n, s)
        if e > s {
            td_cpn(dst, s, e, max)
            return
        }
    }
    td_cpz(dst, def, max)
}

fn td_wrap(a: u64, b: u64, l0: u64, maxl: u64) -> u64 {
    var l: u64 = 0
    var c: u64 = 0
    var last: u64 = 0
    var any: u64 = 0
    var k: u64 = a
    while k < b {
        let ch: u64 = kstate.get8(td_inp() + k)
        k = k + 1
        if ch == 10 {
            l = l + 1
            c = 0
        } else {
            if c >= TD_COLS {
                var sp: u64 = TD_COLS
                while sp > 0 && kstate.get8(td_line(l0 + l) + sp - 1) != 32 {
                    sp = sp - 1
                }
                var nc: u64 = 0
                if sp > TD_COLS / 2 && l + 1 < maxl {
                    var q: u64 = sp
                    while q < TD_COLS {
                        kstate.set8(td_line(l0 + l + 1) + nc, kstate.get8(td_line(l0 + l) + q) as u8)
                        kstate.set8(td_line(l0 + l) + q, 0 as u8)
                        nc = nc + 1
                        q = q + 1
                    }
                }
                l = l + 1
                c = nc
            }
            if l < maxl {
                kstate.set8(td_line(l0 + l) + c, ch as u8)
                c = c + 1
                any = 1
                last = l
            }
        }
    }
    if any == 0 {
        return 0
    }
    return last + 1
}

fn td_body() -> u64 {
    var b: u64 = td_nhead
    if b == 0 {
        b = 1
    }
    if td_ndet > 0 {
        b = b + 1
        if td_open != 0 {
            b = b + td_ndet
        }
    }
    return b
}

fn td_head_rows() -> u64 {
    if td_nhead == 0 {
        return 1
    }
    return td_nhead
}

fn td_layout_line(state: u64) {
    var s_tl: [u8; 29] = "wm: trusted dialog layout y=\0"
    var s_tl1: [u8; 7] = " hint=\0"
    var s_tl2: [u8; 6] = " btn=\0"
    var s_tl3: [u8; 4] = " h=\0"
    var s_tl4: [u8; 7] = " body=\0"
    var s_tl5: [u8; 4] = " x=\0"
    var s_tl6: [u8; 4] = " w=\0"
    serial.puts((&s_tl[0]) as u64)
    serial.dec(td_y(state))
    serial.puts((&s_tl4[0]) as u64)
    serial.dec(td_row(state, 3))
    serial.put(45 as u8)
    serial.dec(td_row(state, 3 + td_body()))
    serial.puts((&s_tl1[0]) as u64)
    serial.dec(td_row(state, td_body() + 4))
    serial.puts((&s_tl2[0]) as u64)
    serial.dec(td_by(state))
    serial.puts((&s_tl3[0]) as u64)
    serial.dec(td_h(state))
    serial.puts((&s_tl5[0]) as u64)
    serial.dec(td_x(state))
    serial.puts((&s_tl6[0]) as u64)
    serial.dec(td_w(state))
    serial.nl()
}

fn trust_ask(state: u64, no: u64, p: u64, n: u64) -> bool {
    if td_on != 0 || no == 0 {
        return false
    }
    var i: u64 = 0
    while i < 768 {
        kstate.set8(td_line(0) + i, 0 as u8)
        i = i + 1
    }
    let m: u64 = td_norm(p, n)
    var d_tit: [u8; 72] = [0 as u8; 72]
    var d_tsf: [u8; 29] = " - Bestätigung (vom System)\0"
    brand.append((&d_tit[0]) as u64, brand.append((&d_tit[0]) as u64, 0, brand.product(), 71), (&d_tsf[0]) as u64, 71)
    var d_yes: [u8; 13] = "[J] Erlauben\0"
    var d_no: [u8; 13] = "[N] Ablehnen\0"
    var d_hnt: [u8; 54] = "Nur echte Tastatur/Maus:  J = erlauben   N = ablehnen\0"
    var d_det: [u8; 8] = "Details\0"
    var hs: u64 = 0
    var he: u64 = m
    td_ndet = 0
    td_open = 0
    td_cpz((&td_dlab[0]) as u64, (&d_det[0]) as u64, 48)
    if td_seps(m) > 0 {
        td_pick(m, 0, (&td_title[0]) as u64, 72, (&d_tit[0]) as u64)
        td_pick(m, 3, (&td_yes[0]) as u64, 24, (&d_yes[0]) as u64)
        td_pick(m, 4, (&td_nol[0]) as u64, 24, (&d_no[0]) as u64)
        td_pick(m, 5, (&td_hint[0]) as u64, 72, (&d_hnt[0]) as u64)
        hs = td_fstart(m, 1)
        if hs > m {
            hs = m
        }
        he = td_fend(m, hs)
        let ds: u64 = td_fstart(m, 2)
        if ds <= m {
            let de: u64 = td_fend(m, ds)
            var le: u64 = ds
            while le < de && kstate.get8(td_inp() + le) != 10 {
                le = le + 1
            }
            if le > ds {
                td_cpn((&td_dlab[0]) as u64, ds, le, 48)
            }
            if le + 1 < de {
                td_ndet = td_wrap(le + 1, de, TD_HEAD_MAX, TD_DET_MAX)
            }
        }
    } else {
        td_cpz((&td_title[0]) as u64, (&d_tit[0]) as u64, 72)
        td_cpz((&td_yes[0]) as u64, (&d_yes[0]) as u64, 24)
        td_cpz((&td_nol[0]) as u64, (&d_no[0]) as u64, 24)
        td_cpz((&td_hint[0]) as u64, (&d_hnt[0]) as u64, 72)
    }
    td_nhead = td_wrap(hs, he, 0, TD_HEAD_MAX)
    td_no = no
    td_ans = 0
    td_ansno = 0
    td_focus = 1
    td_t0 = time.mono_ns(state)
    td_on = 1
    td_shown = td_shown + 1
    damage_all(state)
    var s_td: [u8; 26] = "wm: trusted dialog up no=\0"
    serial.puts((&s_td[0]) as u64)
    serial.dec(no)
    serial.nl()
    td_layout_line(state)
    return true
}

fn td_toggle(state: u64) {
    if td_ndet == 0 {
        return
    }
    td_open = 1 - td_open
    damage_all(state)
    var s_tg: [u8; 33] = "wm: trusted dialog details open=\0"
    serial.puts((&s_tg[0]) as u64)
    serial.dec(td_open)
    serial.nl()
}

fn trust_poll(state: u64, no: u64) -> u64 {
    if no != 0 && td_ansno == no && td_ans != 0 {
        return td_ans
    }
    if td_on != 0 && td_no == no {
        return 0
    }
    return 3
}

fn trust_cancel(state: u64, no: u64) {
    if td_on != 0 && td_no == no {
        td_on = 0
        damage_all(state)
        var s_tc: [u8; 28] = "wm: trusted dialog down no=\0"
        serial.puts((&s_tc[0]) as u64)
        serial.dec(no)
        serial.nl()
    }
}

fn td_answer(state: u64, v: u64) {
    td_ans = v
    td_ansno = td_no
    td_on = 0
    damage_all(state)
    var s_ta: [u8; 27] = "wm: trusted dialog answer=\0"
    var s_tn: [u8; 5] = " no=\0"
    serial.puts((&s_ta[0]) as u64)
    serial.dec(v)
    serial.puts((&s_tn[0]) as u64)
    serial.dec(td_no)
    serial.nl()
}

fn td_live(state: u64) -> bool {
    return td_on != 0 && !sperre_an(state)
}

fn td_armed(state: u64) -> bool {
    return time.mono_ns(state) - td_t0 >= 400000000
}

fn trust_key(state: u64, c: u64) -> bool {
    if !td_live(state) {
        return false
    }
    if !td_armed(state) {
        return true
    }
    if c == 106 || c == 74 || c == 121 || c == 89 {
        td_answer(state, 1)
    } else if c == 110 || c == 78 || c == 27 {
        td_answer(state, 2)
    } else if c == 100 || c == 68 {
        td_toggle(state)
    } else if c == 9 {
        td_focus = 1 - td_focus
        damage_all(state)
    } else if c == 13 || c == 10 || c == 32 {
        td_answer(state, td_focus + 1)
    }
    return true
}

fn td_k(state: u64) -> u64 {
    if fb.width(state) >= 1600 {
        return 2
    }
    return 1
}

fn td_gw(state: u64) -> u64 {
    return font.GLYPH_W * td_k(state)
}

fn td_gh(state: u64) -> u64 {
    return font.GLYPH_H * td_k(state)
}

fn td_w(state: u64) -> u64 {
    return (TD_COLS + 4) * td_gw(state)
}

fn td_h(state: u64) -> u64 {
    return (td_body() + 9) * td_gh(state)
}

fn td_x(state: u64) -> u64 {
    if td_w(state) >= fb.width(state) {
        return 0
    }
    return (fb.width(state) - td_w(state)) / 2
}

fn td_y(state: u64) -> u64 {
    if td_h(state) >= fb.height(state) {
        return 0
    }
    return (fb.height(state) - td_h(state)) / 3
}

fn td_row(state: u64, r: u64) -> u64 {
    return td_y(state) + r * td_gh(state)
}

// the buttons: 0 = yes (left), 1 = no (right)
fn td_bx(state: u64, b: u64) -> u64 {
    if b == 0 {
        return td_x(state) + 2 * td_gw(state)
    }
    return td_x(state) + (TD_COLS + 2 - TD_BTN) * td_gw(state)
}

fn td_by(state: u64) -> u64 {
    return td_row(state, td_body() + 6)
}

fn td_bh(state: u64) -> u64 {
    return 2 * td_gh(state)
}

fn td_click(state: u64, x: u64, y: u64) {
    if !td_armed(state) {
        return
    }
    let tr: u64 = td_row(state, 3 + td_head_rows())
    if td_ndet > 0 && y >= tr && y < tr + td_gh(state) && x >= td_x(state) && x < td_x(state) + td_w(state) {
        td_toggle(state)
        return
    }
    if y < td_by(state) || y >= td_by(state) + td_bh(state) {
        return
    }
    var b: u64 = 0
    while b < 2 {
        let bx: u64 = td_bx(state, b)
        if x >= bx && x < bx + TD_BTN * td_gw(state) {
            td_answer(state, b + 1)
            b = 2
        } else {
            b = b + 1
        }
    }
}

fn td_str(state: u64, x: u64, y: u64, p: u64, n: u64, fg: u64) {
    let k: u64 = td_k(state)
    let gw: u64 = td_gw(state)
    var i: u64 = 0
    var cx: u64 = x
    while i < n && cx + gw <= fb.width(state) {
        let ch: u64 = kstate.get8(p + i)
        if ch == 0 {
            i = n
        } else {
            var r: u64 = 0
            while r < font.GLYPH_H {
                let bits: u64 = font.row(state + fb.FONT_OFF, ch, r)
                var c: u64 = 0
                while c < font.GLYPH_W {
                    if (bits & (1 << (7 - c))) != 0 {
                        if k == 1 {
                            fb.pixel(state, cx + c, y + r, fg)
                        } else {
                            fb.fill(state, cx + c * k, y + r * k, k, k, fg)
                        }
                    }
                    c = c + 1
                }
                r = r + 1
            }
            cx = cx + gw
            i = i + 1
        }
    }
}

fn td_paint(state: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if !td_live(state) {
        return
    }
    let x: u64 = td_x(state)
    let y: u64 = td_y(state)
    let w: u64 = td_w(state)
    let h: u64 = td_h(state)
    if x1 <= x || x0 >= x + w || y1 <= y || y0 >= y + h {
        return
    }
    let k: u64 = td_k(state)
    let gw: u64 = td_gw(state)
    let gh: u64 = td_gh(state)
    let rand: u64 = fb.rgb(state, 0x5A, 0x64, 0x80)
    let cx0: i64 = x0 as i64
    let cy0: i64 = y0 as i64
    let cx1: i64 = x1 as i64
    let cy1: i64 = y1 as i64
    fill_round(state, x as i64, y as i64, w as i64, h as i64, 8 * k, rand, 255, cx0, cy0, cx1, cy1)
    fill_round(state, (x + k) as i64, (y + k) as i64, (w - 2 * k) as i64, (h - 2 * k) as i64, 7 * k,
        fb.rgb(state, 0x20, 0x22, 0x2C), 255, cx0, cy0, cx1, cy1)
    td_str(state, x + 2 * gw, td_row(state, 1), (&td_title[0]) as u64, 72,
        fb.rgb(state, 0x60, 0xA8, 0xF0))
    let nh: u64 = td_head_rows()
    var l: u64 = 0
    while l < td_nhead {
        td_str(state, x + 2 * gw, td_row(state, 3 + l), td_line(l), 64,
            fb.rgb(state, 0xE8, 0xE8, 0xE8))
        l = l + 1
    }
    if td_ndet > 0 {
        var s_dk: [u8; 4] = "[D]\0"
        var s_dm: [u8; 2] = "-\0"
        var s_dp: [u8; 2] = "+\0"
        let trow: u64 = td_row(state, 3 + nh)
        td_str(state, x + 2 * gw, trow, (&s_dk[0]) as u64, 5, fb.rgb(state, 0x9A, 0xA0, 0xB0))
        td_str(state, x + 7 * gw, trow, (&td_dlab[0]) as u64, 48, fb.rgb(state, 0x9A, 0xA0, 0xB0))
        if td_open != 0 {
            td_str(state, x + (TD_COLS - 1) * gw, trow, (&s_dm[0]) as u64, 2, fb.rgb(state, 0x9A, 0xA0, 0xB0))
        } else {
            td_str(state, x + (TD_COLS - 1) * gw, trow, (&s_dp[0]) as u64, 2, fb.rgb(state, 0x9A, 0xA0, 0xB0))
        }
        if td_open != 0 {
            var d: u64 = 0
            while d < td_ndet {
                td_str(state, x + 4 * gw, td_row(state, 4 + nh + d), td_line(TD_HEAD_MAX + d), 64,
                    fb.rgb(state, 0xB4, 0xBA, 0xC8))
                d = d + 1
            }
        }
    }
    td_str(state, x + 2 * gw, td_row(state, td_body() + 4),
        (&td_hint[0]) as u64, 72, fb.rgb(state, 0x9A, 0xA0, 0xB0))
    let by: u64 = td_by(state)
    let bh: u64 = td_bh(state)
    let bw: u64 = TD_BTN * gw
    fill_round(state, (td_bx(state, td_focus) - 2 * k) as i64, (by - 2 * k) as i64, (bw + 4 * k) as i64, (bh + 4 * k) as i64,
        6 * k, fb.rgb(state, 0xF0, 0xF0, 0xF0), 255, cx0, cy0, cx1, cy1)
    fill_round(state, td_bx(state, 0) as i64, by as i64, bw as i64, bh as i64, 4 * k, fb.rgb(state, 0x0F, 0x6C, 0xBD), 255, cx0, cy0, cx1, cy1)
    fill_round(state, td_bx(state, 1) as i64, by as i64, bw as i64, bh as i64, 4 * k, fb.rgb(state, 0x4A, 0x4E, 0x5A), 255, cx0, cy0, cx1, cy1)
    let ty: u64 = by + gh / 2
    td_str(state, td_bx(state, 0) + gw, ty, (&td_yes[0]) as u64, 24,
        fb.rgb(state, 0xFF, 0xFF, 0xFF))
    td_str(state, td_bx(state, 1) + gw, ty, (&td_nol[0]) as u64, 24,
        fb.rgb(state, 0xFF, 0xFF, 0xFF))
}

fn sperrer(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.SP_PID)
}

// Der PLATZ des Sperrers in der Aufgabentafel -- das ist die Zahl, die
// in `W_OWNER` steht. Die Prozessnummer daneben ist die, die Ring 3
// sieht; sie sind NICHT dasselbe, und der erste Anlauf hat sie
// verwechselt: der Sperrbildschirm war danach unsichtbar, weil sein
// eigenes Fenster ihm nicht zu gehoeren schien.
fn lock_space(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.SP_SLOT)
}

// Darf dieses Fenster jetzt etwas bekommen? Ohne Sperre: jedes. Mit
// Sperre: nur, was dem Sperrer gehoert.
fn darf(state: u64, i: u64) -> bool {
    if !sperre_an(state) {
        return true
    }
    let p: u64 = lock_space(state)
    if sperrer(state) == 0 {
        return false
    }
    return wg(state, i, W_OWNER) == p
}

fn input_seen(state: u64) {
    kstate.set(state, kstate.K11_OFF + kstate.SP_LAST, time.mono_ns(state))
}

fn on_key(state: u64, c: u64) {
    if !ready(state) || c == 0 {
        return
    }
    input_seen(state)
    lj_input(state) // r1049: a key starts the active stretch too (only the pointer did)
    // W-DND: Esc cancels a running drag
    if c == 27 && dnd_cancel(state) {
        ss(state, S_KSWAL, 1)
        return
    }
    // W1d: while the Alt+Tab panel is open, Esc closes it and no key reaches a window
    if sw_open != 0 {
        if c == 27 {
            sw_cancel(state)
        }
        ss(state, S_KSWAL, 1)
        return
    }
    // ROUND ACTION-BUS-5 (AB-004): the trusted dialog takes the key
    // FIRST -- before a plugin, before the focus, and not for the
    // terminal either
    if trust_key(state, c) {
        ss(state, S_KSWAL, 1)
        return
    }
    // RUNDE MESSTAFEL, Stufe 3 fuer die Tastatur.
    ss(state, S_KEYIN, gs(state, S_KEYIN) + 1)
    // COMPOSITOR S5: the compositor sees THAT a key came, and its code only while Alt or the Windows key is held (a shortcut)
    if cp_shortcut(state) != 0 {
        cp_event(state, CP_EV_KEY, 1, 0, 0, 0, c)
    } else {
        cp_event(state, CP_EV_KEY, 0, 0, 0, 0, 0)
    }
    // ================================================ RUNDE WMPLUGIN
    // ERST DAS PLUGIN, DANN DAS FENSTER -- und zwar in dieser Reihe.
    //
    // Ein Kuerzel, das ein Plugin belegt hat, darf das Fenster NICHT
    // mehr sehen: sonst tippt der Zoom-Effekt sein `z` zusaetzlich in
    // den Texteditor darunter. Der Kern fragt dafuer eine Tafel ab
    // (acht Vergleiche), legt bei einem Treffer ein Ereignis ab und
    // kehrt zurueck. ER RUFT DABEI KEIN PLUGIN UND WARTET AUF KEINES;
    // ob das Plugin sein Ereignis je abholt, aendert an diesem Pfad
    // nichts -- holt es nicht ab, wirft es die Frist hinaus.
    var mods: u64 = 0
    if kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1 {
        mods = mods | 2
    }
    if kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 1 {
        mods = mods | 4
    }
    // r382 LOCK SEAL: while locked no plugin gets the key (its shortcut
    // could act on windows behind the lock); it goes to the locker only.
    if !sperre_an(state) && wmplug.key_owner(state, c, mods) < wmplug.MAX_PLUG {
        wmplug.notify(state, wmplug.E_KEY, c, mods, 0)
        ss(state, S_KPLUG, gs(state, S_KPLUG) + 1)
        // Und AUCH nicht an das Terminal des Fokusfensters: `key_tty`
        // liest diesen Merker unmittelbar nach uns.
        ss(state, S_KSWAL, 1)
        var s_pk: [u8; 16] = "wm: plugkey c=\0\0"
        var s_pm: [u8; 6] = " mod=\0"
        serial.puts((&s_pk[0]) as u64)
        serial.dec(c)
        serial.puts((&s_pm[0]) as u64)
        serial.dec(mods)
        serial.nl()
        return
    }
    if gs(state, S_NOFOCUS) != 0 {
        var i: u64 = 0
        while i < MAX_WIN {
            if wg(state, i, W_USED) != 0 && darf(state, i) {
                ev_push(state, i, E_KEY, c, 0, 0)
            }
            i = i + 1
        }
        return
    }
    // RUNDE ALLTAG: WAEHREND DER SPERRE GEHT DIE TASTE AN DEN SPERRER,
    // ohne nach dem Fokus zu fragen.
    //
    // Sein Fenster liegt auf der obersten Ebene, und Fenster dieser
    // Ebene bekommen den Fokus mit Absicht NICHT (das ist die Regel,
    // die die Taskleiste braucht). Der erste Anlauf hat deshalb jede
    // Taste weggeworfen: der Sperrbildschirm stand da und nahm kein
    // Kennwort an. Gemessen mit `sendkey`.
    if sperre_an(state) {
        var k: u64 = 0
        while k < MAX_WIN {
            if wg(state, k, W_USED) != 0 && darf(state, k) {
                ev_push(state, k, E_KEY, c, 0, 0)
                k = MAX_WIN
            } else {
                k = k + 1
            }
        }
        return
    }
    let f: u64 = focus(state)
    if f < MAX_WIN && darf(state, f) {
        ev_push(state, f, E_KEY, c, 0, 0)
    }
}

// r1129b: when may the PS/2 fallback look at the controller? (see the comment in `poll`)
const PS2_WD_TICKS: u64 = 10 // watchdog period while IRQ 12 works: 100 ms
const PS2_FALL_TICKS: u64 = 200 // after a rescued byte: poll every tick for 2 s
static mut ps2_wd_at: u64 = 0
static mut ps2_fall_until: u64 = 0
fn ps2_poll_due(now: u64) -> bool {
    if now < ps2_fall_until {
        return true
    }
    if now - ps2_wd_at >= PS2_WD_TICKS || now < ps2_wd_at {
        ps2_wd_at = now
        return true
    }
    return false
}

// Wird aus der Hauptschleife gerufen: hat sich am Zeiger etwas getan?
fn poll(state: u64) -> bool {
    if !ready(state) {
        return false
    }
    // ================================================ RUNDE WMPLUGIN
    // DER KEHRBESEN HAENGT NICHT AM BILD, SONDERN AN DER UHR.
    //
    // Gemessen: ein Plugin, das nach dem Anmelden in eine Endlosschleife
    // lief, blieb auf seinem Platz stehen -- weil auf einem RUHIGEN
    // Schreibtisch gar nicht zusammengesetzt wird und `compose` seinen
    // Kehrbesen deshalb nie erreichte. Eine Frist, die nur greift,
    // solange sich etwas bewegt, ist keine.
    //
    // Also einmal je TICK, aus dem Abfragepfad heraus. Der Preis ist
    // EIN Vergleich je Durchlauf (der Tick hat sich fast nie geaendert)
    // und acht Vergleiche je Hundertstelsekunde. Gewartet wird auch
    // hier auf niemanden.
    let jetzt: u64 = kstate.get(state, kstate.TICKS)
    var tick_new: bool = false
    if jetzt != gs(state, S_SWTICK) {
        tick_new = true
        ss(state, S_SWTICK, jetzt)
        wmplug.sweep(state)
        tcur_tick(state) // r1014: terminal cursor blink
    }
    // RUNDE TILING: erst die Tastenkuerzel. Sie liegen im Ring, den
    // `kbd.irq` fuellt, wenn Alt gehalten wird -- der Fensterserver
    // HOLT sie ab, statt dass die Tastatur ihn kennt.
    hotkeys(state)
    sw_tick(state) // W1d: Alt released -> the Alt+Tab switcher commits
    dnd_tick(state) // W-DND: hover-raise after the delay
    // DER RUECKFALL AUF ABFRAGE, und er steht hier mit Begruendung.
    //
    // Der Baustein meldet ueber IRQ 12, und das ist der Weg, den dieser
    // Treiber geht. Es gibt aber einen Zustand, in dem die Unterbrechung
    // AUSBLEIBT und trotzdem ein Oktett bereitliegt: das Zustandstor
    // sagt dann "Ausgabepuffer voll" (Bit 0) und "vom zweiten Anschluss"
    // (Bit 5). Wer nur auf die Unterbrechung wartet, hat dann einen
    // Zeiger, der stehenbleibt, und keinen Hinweis darauf, warum.
    //
    // Also wird hier NACHGESEHEN. Wie viele Oktette auf welchem der
    // beiden Wege kamen, steht in `irqs` und `polls` und wird gemeldet
    // -- eine Abfrage, die als Unterbrechung ausgegeben wird, waere eine
    // Luege ueber den Treiber.
    // r1122: ONCE PER TICK. The fallback looks at port 0x64 (a trapped port read, one VM exit in VirtualBox) and the
    // loop above runs more often than the clock ticks; IRQ 12 brings packets in time, the poll only rescues a lost one.
    // r1129b: WATCHDOG, NOT A POLL. Every look at port 0x64 is a trapped port read (one VM exit in VirtualBox, ~34-100 per second
    // before). While IRQ 12 delivers (the poll finds nothing) the controller is only looked at every PS2_WD_TICKS ticks. A look
    // that FINDS a byte means the IRQ was lost: from then on every tick polls again for PS2_FALL_TICKS ticks, then back to the watchdog.
    // W-INPUTHANG: the same watchdog look also covers the KEYBOARD byte (kbd.rescue; `nokbdpoll` = counter-proof without it) and no longer
    // needs a PS/2 mouse to be present: a machine with only a keyboard on the i8042 has the same lost-edge failure.
    let wd_due: bool = tick_new && ps2_poll_due(jetzt)
    if wd_due && !kstate.mode_on(state, kstate.M_NOKBDPOLL) {
        var kn: u64 = 0
        while kn < 16 && kbd.rescue(state) {
            kn = kn + 1
        }
        if kn != 0 {
            ps2_fall_until = jetzt + PS2_FALL_TICKS
        }
    }
    if wd_due && ps2m.present(state) && ps2m.polling(state) {
        let polls0: u64 = ps2m.polls(state)
        var n: u64 = 0
        while n < 64 && ps2m.poll_one(state) {
            // NACH JEDEM VOLLSTAENDIGEN PAKET, nicht am Ende des
            // Stapels: ein Druck und das Loslassen danach sind zwei
            // Pakete, und wer beide zusammen abholt und DANN nachsieht,
            // findet die Taste wieder oben und hat den Klick verloren.
            if ps2m.changed(state) {
                ps2m.take_change(state)
                on_mouse(state)
                lj_input(state)
            }
            n = n + 1
        }
        if ps2m.polls(state) != polls0 {
            ps2_fall_until = jetzt + PS2_FALL_TICKS
        }
    }
    if !ps2m.changed(state) {
        return false
    }
    ps2m.take_change(state)
    on_mouse(state)
    lj_input(state)
    return true
}

// ------------------------------------------------------ das Terminal
//
// Ein Fenster mit einem ZEICHENRASTER. Die Anwendung schickt Oktette,
// der Server fuehrt dieselbe Zustandsmaschine wie `fb.putc` (Umbruch,
// Rollen, Tabulator, Ruecktaste) und malt die Zellen mit der
// Festbreitenschrift. Damit kann eine Shell in einem Fenster laufen,
// ohne von Schriften etwas zu wissen.

fn term_setup(state: u64, i: u64) {
    tc_reset(i)
    let f: u64 = gs(state, S_FONT_MONO)
    var cw: u64 = 8
    var ch: u64 = 16
    if f < ttf.MAX_FONTS {
        let px: u64 = gs(state, S_PX_MONO)
        let gid: u64 = ttf.glyph_of(state, f, 0x4D) // 'M'
        cw = ((ttf.advance26(state, f, gid, px) + 63) >> 6) as u64
        ch = ttf.line_height(state, f, px)
    }
    if cw == 0 {
        cw = 8
    }
    if ch == 0 {
        ch = 16
    }
    if i < 32 {
        tp_sbv[(i) as usize] = 0
    }
    let alt_cols: u64 = wg(state, i, W_COLS)
    let alt_rows: u64 = wg(state, i, W_ROWS)
    let alt_cy: u64 = wg(state, i, W_CY)
    let alt_cx: u64 = wg(state, i, W_CX)
    wsv(state, i, W_CELLW, cw)
    wsv(state, i, W_CELLH, ch)
    let cols: u64 = wg(state, i, W_W) / cw
    let rows: u64 = wg(state, i, W_H) / ch
    wsv(state, i, W_COLS, cols)
    wsv(state, i, W_ROWS, rows)
    let neu_gitter: bool = wg(state, i, W_GRID) == 0
    if neu_gitter {
        // r400: two frames -- the first holds the characters, the second one attribute
        // octet per cell (bit 0 = reverse video, set by the VT subset `term_csi`).
        // r462: six frames -- characters, attributes, colours, and the same three of the main screen while the alternate
        // screen is up (frames 3 .. 5)
        let g0: u64 = mem.frame_run(state, TG_FRAMES)
        wsv(state, i, W_GRID, g0)
        tp_reset(i)
        sb_free(state, i)
    }
    let g: u64 = wg(state, i, W_GRID)
    // ================================================== RUNDE ECHT
    // DER TEXT BLEIBT STEHEN, WENN MAN DAS FENSTER ZIEHT.
    //
    // Justins Befund am echten Geraet: "Terminal auf, Ausgabe da,
    // Fenster groesser ziehen -> Inhalt weg." Er hat recht, und die
    // Ursache stand genau hier: diese Funktion hat das GANZE
    // Zeichenraster mit Leerzeichen ueberschrieben und den Cursor auf
    // 0,0 gesetzt -- bei JEDEM Aufruf. `resize_win` ruft sie bei jeder
    // Groessenaenderung. Der Text war also nicht falsch umgebrochen,
    // er war GELOESCHT.
    //
    // Ein Terminal, dessen Fenster sich aendert, behaelt seinen Inhalt
    // -- das tut jedes Terminal, seit es Terminals gibt. Die Zeilen
    // werden in das neue Raster UMKOPIERT, Zeile fuer Zeile, so weit
    // sie hineinpassen. Was nicht mehr hineinpasst (schmaleres
    // Fenster), wird rechts abgeschnitten; das ist dasselbe, was xterm
    // ohne Neuumbruch tut, und es ist ehrlicher, als den Rest zu
    // loeschen.
    //
    // NUR EIN FRISCHES GITTER WIRD GELEERT. Das ist der Fall, fuer den
    // die Leerung urspruenglich gedacht war: ein neu angelegtes
    // Terminal, dessen Rahmen noch beliebigen Speicher traegt.
    if g != 0 {
        if neu_gitter || alt_cols == 0 || alt_rows == 0 {
            var k: u64 = 0
            while k < cols * rows && k < TG {
                kstate.set8(g + k, 32 as u8)
                k = k + 1
            }
            attr_clear(g)
            wsv(state, i, W_CX, 0)
            wsv(state, i, W_CY, 0)
        } else if cols != alt_cols || rows != alt_rows {
            attr_clear(g)
            // r462: the saved main screen and the scroll region belong to the old grid
            tp_alt[(i) as usize] = 0
            tp_top[(i) as usize] = 0
            tp_bot1[(i) as usize] = 0
            tp_wrap[(i) as usize] = 0
            // UMKOPIEREN, VON UNTEN NACH OBEN ODER VON OBEN NACH
            // UNTEN -- je nachdem, wohin geschoben wird, damit sich
            // Quelle und Ziel im selben Rahmen nicht ueberholen.
            // Zielzeile r liegt bei r*cols, Quellzeile bei r*alt_cols.
            // Wird das Raster BREITER, wandert jede Zeile nach hinten:
            // dann von der letzten Zeile an arbeiten.
            var lines: u64 = alt_rows
            if rows < lines {
                lines = rows
            }
            var wide: u64 = alt_cols
            if cols < wide {
                wide = cols
            }
            if cols > alt_cols {
                var r: u64 = lines
                while r > 0 {
                    r = r - 1
                    var c: u64 = wide
                    while c > 0 {
                        c = c - 1
                        let src: u64 = r * alt_cols + c
                        let dst: u64 = r * cols + c
                        if src < TG && dst < TG {
                            kstate.set8(g + dst, kstate.get8(g + src) as u8)
                        }
                    }
                    // den Rest der Zielzeile leeren
                    var c2: u64 = wide
                    while c2 < cols {
                        let d2: u64 = r * cols + c2
                        if d2 < TG {
                            kstate.set8(g + d2, 32 as u8)
                        }
                        c2 = c2 + 1
                    }
                }
            } else {
                var r2: u64 = 0
                while r2 < lines {
                    var c3: u64 = 0
                    while c3 < wide {
                        let s3: u64 = r2 * alt_cols + c3
                        let d3: u64 = r2 * cols + c3
                        if s3 < TG && d3 < TG {
                            kstate.set8(g + d3, kstate.get8(g + s3) as u8)
                        }
                        c3 = c3 + 1
                    }
                    var c4: u64 = wide
                    while c4 < cols {
                        let d4: u64 = r2 * cols + c4
                        if d4 < TG {
                            kstate.set8(g + d4, 32 as u8)
                        }
                        c4 = c4 + 1
                    }
                    r2 = r2 + 1
                }
            }
            // die neuen Zeilen unten sind leer
            var r5: u64 = lines
            while r5 < rows {
                var c5: u64 = 0
                while c5 < cols {
                    let d5: u64 = r5 * cols + c5
                    if d5 < TG {
                        kstate.set8(g + d5, 32 as u8)
                    }
                    c5 = c5 + 1
                }
                r5 = r5 + 1
            }
            // DER CURSOR BLEIBT, WO ER WAR -- nur in das neue Raster
            // hineingezwungen. Sonst schriebe die naechste Ausgabe
            // mitten in den stehengebliebenen Text.
            var ncx: u64 = alt_cx
            var ncy: u64 = alt_cy
            if ncx >= cols {
                ncx = cols - 1
            }
            if ncy >= rows {
                ncy = rows - 1
            }
            wsv(state, i, W_CX, ncx)
            wsv(state, i, W_CY, ncy)
        }
    }
    fill(state, i, 0, 0, wg(state, i, W_W), wg(state, i, W_H),
        wg(state, i, W_BG))
    // UND DER TEXT WIEDER AUF DIE FLAECHE. `fill` hat gerade den
    // ganzen Puffer mit der Hintergrundfarbe ueberschrieben -- ohne
    // diese Zeile stuende der gerettete Inhalt zwar im Raster, waere
    // aber nicht zu sehen, und der Fehler saehe genauso aus wie
    // vorher. Bei einem frischen Gitter malt sie lauter Leerzeichen,
    // kostet also nichts.
    term_redraw(state, i)
}

fn cell_set(state: u64, i: u64, c: u64, r: u64, ch: u64) {
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 {
        return
    }
    let k: u64 = r * wg(state, i, W_COLS) + c
    if k >= TG {
        return
    }
    kstate.set8(g + k, ch as u8)
}

// r400: the attribute octet of a cell (bit 0 = reverse video), in the second frame of the grid.
fn attr_clear(g: u64) {
    var k: u64 = 0
    while k < TG {
        kstate.set8(g + TG + k, 0 as u8)
        kstate.set8(g + 2 * TG + k, 0 as u8)
        k = k + 1
    }
}

fn cell_attr(state: u64, i: u64, c: u64, r: u64) -> u64 {
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 {
        return 0
    }
    let k: u64 = r * wg(state, i, W_COLS) + c
    if k >= TG {
        return 0
    }
    return kstate.get8(g + TG + k)
}

fn cell_attr_set(state: u64, i: u64, c: u64, r: u64, a: u64) {
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 {
        return
    }
    let k: u64 = r * wg(state, i, W_COLS) + c
    if k >= TG {
        return
    }
    kstate.set8(g + TG + k, a as u8)
}

// r462: the colour octet of a cell (low nibble foreground, high nibble background; 0 = the window's own colour), third frame
fn cell_col(state: u64, i: u64, c: u64, r: u64) -> u64 {
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 {
        return 0
    }
    let k: u64 = r * wg(state, i, W_COLS) + c
    if k >= TG {
        return 0
    }
    return kstate.get8(g + 2 * TG + k)
}

fn cell_col_set(state: u64, i: u64, c: u64, r: u64, v: u64) {
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 {
        return
    }
    let k: u64 = r * wg(state, i, W_COLS) + c
    if k >= TG {
        return
    }
    kstate.set8(g + 2 * TG + k, v as u8)
}

fn cell_get(state: u64, i: u64, c: u64, r: u64) -> u64 {
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 {
        return 32
    }
    let k: u64 = r * wg(state, i, W_COLS) + c
    if k >= TG {
        return 32
    }
    return kstate.get8(g + k)
}

// ==================================================== RUNDE ECHTHARDWARE-5
// DEN INHALT EINES TERMINALFENSTERS AUF DIE SERIELLE LEITUNG.
//
// Der Beleg fuer Justins Befund B ist ein BILD, und ein Bild von
// Text ist mit einem Programm schlecht zu lesen -- ich habe in dieser
// Runde zweimal versucht, aus Bildpunkten Buchstaben zu raten, und
// beide Male stand am Ende ein Muster, das man so oder so lesen kann.
//
// Das Fenster weiss selbst, was in ihm steht: sein Zellenraster. Diese
// Funktion schreibt es Zeile fuer Zeile hinaus, und damit ist "im
// Terminal steht eine Eingabeaufforderung" eine ABLESUNG und keine
// Deutung eines Rasters. Leerzeilen am Ende faellt sie weg.
// r462: the size of the window's grid, rows << 16 | columns -- what `TIOCGWINSZ` of the tty bound to this window answers
fn term_size(state: u64, i: u64) -> u64 {
    if !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return 0
    }
    return (wg(state, i, W_ROWS) << 16) | wg(state, i, W_COLS)
}

fn term_dump(state: u64, i: u64) {
    if !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return
    }
    var s_k: [u8; 15] = "wm: termzeile \0"
    var s_g: [u8; 4] = " [\0\0"
    var s_z: [u8; 2] = "]\0"
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    // r486: where the grid stands on the screen and what colours it has, for the pictures of tools/comp/termshare.sh (the cells below are
    // the kernel's own state, a witness that does not go through the window buffer)
    var s_geo: [u8; 17] = "wm: termgeo cx=\0\0"
    var s_cy: [u8; 5] = " cy=\0"
    var s_cw: [u8; 5] = " cw=\0"
    var s_ch: [u8; 5] = " ch=\0"
    var s_co: [u8; 7] = " cols=\0"
    var s_ro: [u8; 7] = " rows=\0"
    var s_bg: [u8; 5] = " bg=\0"
    var s_fg: [u8; 5] = " fg=\0"
    var s_sh: [u8; 9] = " shared=\0"
    serial.puts((&s_geo[0]) as u64)
    serial.dec((win_x(state, i) + inx(state, i) as i64) as u64)
    serial.puts((&s_cy[0]) as u64)
    serial.dec((win_y(state, i) + iny(state, i) as i64) as u64)
    serial.puts((&s_cw[0]) as u64)
    serial.dec(wg(state, i, W_CELLW))
    serial.puts((&s_ch[0]) as u64)
    serial.dec(wg(state, i, W_CELLH))
    serial.puts((&s_co[0]) as u64)
    serial.dec(cols)
    serial.puts((&s_ro[0]) as u64)
    serial.dec(rows)
    serial.puts((&s_bg[0]) as u64)
    serial.dec(wg(state, i, W_BG) & RGB24)
    serial.puts((&s_fg[0]) as u64)
    serial.dec(wg(state, i, W_FG) & RGB24)
    serial.puts((&s_sh[0]) as u64)
    serial.dec(wg(state, i, W_SHM))
    serial.nl()
    var r: u64 = 0
    while r < rows {
        // Wie weit steht in dieser Zeile ueberhaupt etwas?
        var letzte: u64 = 0
        var c0: u64 = 0
        while c0 < cols {
            if cell_get(state, i, c0, r) > 32 {
                letzte = c0 + 1
            }
            c0 = c0 + 1
        }
        if letzte != 0 {
            serial.puts((&s_k[0]) as u64)
            serial.dec(r)
            serial.puts((&s_g[0]) as u64)
            var c: u64 = 0
            while c < letzte {
                let z: u64 = cell_get(state, i, c, r)
                if z >= 32 && z < 127 {
                    serial.put(z as u8)
                } else {
                    serial.put(32 as u8)
                }
                c = c + 1
            }
            serial.puts((&s_z[0]) as u64)
            serial.nl()
        }
        r = r + 1
    }
    // r1014 witness: the cursor / selection / clipboard state of this window
    if i < 32 {
        var s_tc: [u8; 14] = "wm: tcur win=\0"
        var s_on: [u8; 5] = " on=\0"
        var s_tg: [u8; 9] = " toggle=\0"
        var s_hd: [u8; 7] = " hide=\0"
        var s_se: [u8; 6] = " sel=\0"
        var s_cp: [u8; 9] = " copies=\0"
        var s_ps: [u8; 9] = " pastes=\0"
        serial.puts((&s_tc[0]) as u64)
        serial.dec(i)
        serial.puts((&s_on[0]) as u64)
        serial.dec(tc_on[(i) as usize])
        serial.puts((&s_tg[0]) as u64)
        serial.dec(tc_toggles[0])
        serial.puts((&s_hd[0]) as u64)
        serial.dec(tc_hide[(i) as usize])
        serial.puts((&s_se[0]) as u64)
        if tsel_shown(i) {
            serial.dec(1)
        } else {
            serial.dec(0)
        }
        serial.puts((&s_cp[0]) as u64)
        serial.dec(tc_copies[0])
        serial.puts((&s_ps[0]) as u64)
        serial.dec(tc_pastes[0])
        serial.nl()
    }
    sb_dump(state, i)
}

// r5xx: ONE LINE PER TERMINAL WINDOW plus the text of its cells, for the multi-terminal check (tools/term/multi.sh).
// `term_dump` only reports the FIRST terminal window; with several windows open the check has to see each of them:
//   wm: termwin win=<slot> tty=<n> focus=<0|1> cols=<c> rows=<r>
//   wm: tw<slot> <row> [text]
fn term_dump_all(state: u64) {
    var s_h: [u8; 17] = "wm: termwin win=\0"
    var s_t: [u8; 6] = " tty=\0"
    var s_f: [u8; 8] = " focus=\0"
    var s_c: [u8; 7] = " cols=\0"
    var s_r: [u8; 7] = " rows=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_p: [u8; 7] = "wm: tw\0"
    var s_g: [u8; 3] = " [\0"
    var s_z: [u8; 2] = "]\0"
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_KIND) == K_TERM {
            let cols: u64 = wg(state, i, W_COLS)
            let rows: u64 = wg(state, i, W_ROWS)
            serial.puts((&s_h[0]) as u64)
            serial.dec(i)
            serial.puts((&s_t[0]) as u64)
            serial.dec(tty_of(state, i))
            serial.puts((&s_f[0]) as u64)
            if gs(state, S_FOCUS) == i + 1 {
                serial.dec(1)
            } else {
                serial.dec(0)
            }
            serial.puts((&s_c[0]) as u64)
            serial.dec(cols)
            serial.puts((&s_r[0]) as u64)
            serial.dec(rows)
            serial.puts((&s_x[0]) as u64)
            serial.dec(win_x(state, i) as u64)
            serial.puts((&s_y[0]) as u64)
            serial.dec(win_y(state, i) as u64)
            serial.nl()
            var r: u64 = 0
            while r < rows {
                var last: u64 = 0
                var c0: u64 = 0
                while c0 < cols {
                    if cell_get(state, i, c0, r) > 32 {
                        last = c0 + 1
                    }
                    c0 = c0 + 1
                }
                if last != 0 {
                    serial.puts((&s_p[0]) as u64)
                    serial.dec(i)
                    serial.put(32 as u8)
                    serial.dec(r)
                    serial.puts((&s_g[0]) as u64)
                    var c: u64 = 0
                    while c < last {
                        let z: u64 = cell_get(state, i, c, r)
                        if z >= 32 && z < 127 {
                            serial.put(z as u8)
                        } else {
                            serial.put(32 as u8)
                        }
                        c = c + 1
                    }
                    serial.puts((&s_z[0]) as u64)
                    serial.nl()
                }
                r = r + 1
            }
        }
        i = i + 1
    }
}

// the 16 colours of the terminal (0xRRGGBB): the eight of the standard and their bright forms
fn term_palette(k: u64) -> u64 {
    if k == 0 { return 0x000000 }
    if k == 1 { return 0xCD3131 }
    if k == 2 { return 0x0DBC79 }
    if k == 3 { return 0xE5E510 }
    if k == 4 { return 0x2472C8 }
    if k == 5 { return 0xBC3FBC }
    if k == 6 { return 0x11A8CD }
    if k == 7 { return 0xE5E5E5 }
    if k == 8 { return 0x666666 }
    if k == 9 { return 0xF14C4C }
    if k == 10 { return 0x23D18B }
    if k == 11 { return 0xF5F543 }
    if k == 12 { return 0x3B8EEA }
    if k == 13 { return 0xD670D6 }
    if k == 14 { return 0x29B8DB }
    return 0xFFFFFF
}

fn term_color(state: u64, k: u64) -> u64 {
    let v: u64 = term_palette(k)
    return fb.rgb(state, (v >> 16) & 255, (v >> 8) & 255, v & 255)
}

// ==================================================== r1014: TERMINAL CURSOR, SELECTION, COPY, PASTE
// The cursor is a block (the cell with reverse video). It is drawn only in the focused terminal window and blinks with
// BLINK_TICKS (the timer runs in `poll`, once per tick; an idle desktop costs one compare per tick and one cell repaint per
// half second). `tc_on` says which cell shows the cursor right now, `cell_paint` reads it, so every repaint path agrees.
// Selection: left press + drag in the live grid marks a stream of cells (tc_sa .. tc_sb, row-major); Ctrl+Shift+C (or
// Ctrl+C while a selection stands) copies it, Ctrl+Shift+V / right click without selection / middle click paste. The
// system clipboard itself lives in kgui (`termclip_pump`: this module cannot see wig).
const BLINK_TICKS: u64 = 53
const TC_BUF: u64 = 4096
static mut tc_on: [u64; 32] = [0 as u64; 32]    // 1 = the cursor is painted at (tc_cc, tc_cr)
static mut tc_cc: [u64; 32] = [0 as u64; 32]
static mut tc_cr: [u64; 32] = [0 as u64; 32]
static mut tc_hide: [u64; 32] = [0 as u64; 32]  // 1 = the program hid the cursor (CSI ? 25 l)
static mut tc_sel: [u64; 32] = [0 as u64; 32]   // 0 none, 1 dragging, 2 set
static mut tc_sa: [u64; 32] = [0 as u64; 32]    // anchor cell (row * cols + col)
static mut tc_sb: [u64; 32] = [0 as u64; 32]    // moving end
static mut tc_phase: [u64; 1] = [1 as u64; 1]   // 1 = visible half of the blink
static mut tc_next: [u64; 1] = [0 as u64; 1]    // tick of the next toggle
static mut tc_toggles: [u64; 1] = [0 as u64; 1]
static mut tc_buf: [u8; 4104] = [0 as u8; 4104] // the copied text, waiting for kgui
static mut tc_cn: [u64; 1] = [0 as u64; 1]      // its length (0 = nothing waits)
static mut tc_paste: [u64; 1] = [0 as u64; 1]   // tty + 1 that waits for a paste, 0 = none
static mut tc_copies: [u64; 1] = [0 as u64; 1]
static mut tc_pastes: [u64; 1] = [0 as u64; 1]

fn tc_reset(i: u64) {
    if i >= 32 {
        return
    }
    tc_on[(i) as usize] = 0
    tc_hide[(i) as usize] = 0
    tc_sel[(i) as usize] = 0
}

fn tsel_lo(i: u64) -> u64 {
    if tc_sa[(i) as usize] < tc_sb[(i) as usize] {
        return tc_sa[(i) as usize]
    }
    return tc_sb[(i) as usize]
}

fn tsel_hi(i: u64) -> u64 {
    if tc_sa[(i) as usize] < tc_sb[(i) as usize] {
        return tc_sb[(i) as usize]
    }
    return tc_sa[(i) as usize]
}

// a selection that is visible: set, or dragged over at least two cells
fn tsel_shown(i: u64) -> bool {
    if i >= 32 || tc_sel[(i) as usize] == 0 {
        return false
    }
    if tc_sel[(i) as usize] == 2 {
        return true
    }
    return tc_sa[(i) as usize] != tc_sb[(i) as usize]
}

fn tsel_has(state: u64, i: u64, c: u64, r: u64) -> bool {
    if !tsel_shown(i) {
        return false
    }
    let k: u64 = r * wg(state, i, W_COLS) + c
    return k >= tsel_lo(i) && k <= tsel_hi(i)
}

fn cell_paint(state: u64, i: u64, c: u64, r: u64) {
    var at: u64 = cell_attr(state, i, c, r)
    if i < 32 {
        if tsel_has(state, i, c, r) {
            at = at ^ 1
        }
        if tc_on[(i) as usize] != 0 && tc_cc[(i) as usize] == c && tc_cr[(i) as usize] == r {
            at = at ^ 1
        }
    }
    cell_paint_v(state, i, c, r, cell_get(state, i, c, r), at, cell_col(state, i, c, r))
}

fn tcur_dmg(state: u64, i: u64, c: u64, r: u64) {
    let cw: u64 = wg(state, i, W_CELLW)
    let ch: u64 = wg(state, i, W_CELLH)
    let _d: u64 = damage_rect(state, i, c * cw, r * ch, cw, ch)
}

// take the cursor off the grid (before output moves things under it)
fn tcur_off(state: u64, i: u64) {
    if i >= 32 || tc_on[(i) as usize] == 0 {
        return
    }
    tc_on[(i) as usize] = 0
    cell_paint(state, i, tc_cc[(i) as usize], tc_cr[(i) as usize])
    tcur_dmg(state, i, tc_cc[(i) as usize], tc_cr[(i) as usize])
}

fn tcur_want(state: u64, i: u64) -> bool {
    if tc_hide[(i) as usize] != 0 || tc_phase[0] == 0 || gs(state, S_FOCUS) != i + 1 {
        return false
    }
    if tp_sbv[(i) as usize] != 0 || wg(state, i, W_GRID) == 0 {
        return false
    }
    return wg(state, i, W_CX) < wg(state, i, W_COLS) && wg(state, i, W_CY) < wg(state, i, W_ROWS)
}

// bring the painted cursor in line with the wanted one
fn tcur_sync(state: u64, i: u64) {
    if i >= 32 || !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return
    }
    let want: bool = tcur_want(state, i)
    let cx: u64 = wg(state, i, W_CX)
    let cy: u64 = wg(state, i, W_CY)
    if tc_on[(i) as usize] != 0 && (!want || tc_cc[(i) as usize] != cx || tc_cr[(i) as usize] != cy) {
        tcur_off(state, i)
    }
    if want && tc_on[(i) as usize] == 0 {
        tc_on[(i) as usize] = 1
        tc_cc[(i) as usize] = cx
        tc_cr[(i) as usize] = cy
        cell_paint(state, i, cx, cy)
        tcur_dmg(state, i, cx, cy)
    }
}

// once per tick from `poll`
fn tcur_tick(state: u64) {
    let now: u64 = kstate.get(state, kstate.TICKS)
    if now < tc_next[0] {
        return
    }
    tc_next[0] = now + BLINK_TICKS
    if tc_phase[0] == 0 {
        tc_phase[0] = 1
    } else {
        tc_phase[0] = 0
    }
    tc_toggles[0] = tc_toggles[0] + 1
    var i: u64 = 0
    while i < 32 && i < MAX_WIN {
        tcur_sync(state, i)
        i = i + 1
    }
}

// output or a key: the cursor shows solid again for a whole period
fn tcur_solid(state: u64) {
    tc_phase[0] = 1
    tc_next[0] = kstate.get(state, kstate.TICKS) + BLINK_TICKS
}

fn tcur_toggles_pub() -> u64 {
    return tc_toggles[0]
}

fn tcur_shown_pub(i: u64) -> u64 {
    if i >= 32 {
        return 0
    }
    return tc_on[(i) as usize]
}

// repaint the cells k0 .. k1 (row-major indices)
fn tsel_paint(state: u64, i: u64, k0: u64, k1: u64) {
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    if cols == 0 {
        return
    }
    var k: u64 = k0
    while k <= k1 && k < cols * rows {
        cell_paint(state, i, k % cols, k / cols)
        k = k + 1
    }
    damage_win(state, i)
}

fn tsel_clear(state: u64, i: u64) {
    if i >= 32 || tc_sel[(i) as usize] == 0 {
        return
    }
    let lo: u64 = tsel_lo(i)
    let hi: u64 = tsel_hi(i)
    let was: bool = tsel_shown(i)
    tc_sel[(i) as usize] = 0
    if was {
        tsel_paint(state, i, lo, hi)
    }
}

// the selected text -> tc_buf (UTF-8, trailing blanks of a row cut, rows joined by LF). Returns the length.
fn tsel_text(state: u64, i: u64) -> u64 {
    let cols: u64 = wg(state, i, W_COLS)
    if cols == 0 || !tsel_shown(i) {
        return 0
    }
    let lo: u64 = tsel_lo(i)
    let hi: u64 = tsel_hi(i)
    let r0: u64 = lo / cols
    let r1: u64 = hi / cols
    var n: u64 = 0
    var r: u64 = r0
    while r <= r1 {
        var c0: u64 = 0
        var c1: u64 = cols - 1
        if r == r0 {
            c0 = lo % cols
        }
        if r == r1 {
            c1 = hi % cols
        }
        // cut the trailing blanks
        var e: u64 = c1 + 1
        while e > c0 && cell_get(state, i, e - 1, r) <= 32 {
            e = e - 1
        }
        var c: u64 = c0
        while c < e && n + 3 < TC_BUF {
            var z: u64 = cell_get(state, i, c, r)
            if z < 32 {
                z = 32
            }
            if z < 128 {
                tc_buf[(n) as usize] = z as u8
                n = n + 1
            } else if z < 256 {
                tc_buf[(n) as usize] = (0xC0 | (z >> 6)) as u8
                tc_buf[(n + 1) as usize] = (0x80 | (z & 63)) as u8
                n = n + 2
            } else {
                tc_buf[(n) as usize] = 63
                n = n + 1
            }
            c = c + 1
        }
        if r < r1 && n + 1 < TC_BUF {
            tc_buf[(n) as usize] = 10
            n = n + 1
        }
        r = r + 1
    }
    return n
}

fn tsel_copy(state: u64, i: u64) {
    let n: u64 = tsel_text(state, i)
    if n == 0 {
        return
    }
    tc_cn[0] = n
    tc_copies[0] = tc_copies[0] + 1
    var s_c: [u8; 14] = "wm: tcopy n=\0\0"
    serial.puts((&s_c[0]) as u64)
    serial.dec(n)
    serial.put(32 as u8)
    serial.put(91 as u8)
    var q: u64 = 0
    while q < n && q < 80 {
        let ch: u64 = tc_buf[(q) as usize] as u64
        if ch == 10 {
            serial.put(124 as u8)
        } else if ch >= 32 && ch < 127 {
            serial.put(ch as u8)
        } else {
            serial.put(63 as u8)
        }
        q = q + 1
    }
    serial.put(93 as u8)
    serial.nl()
}

// kgui pumps: the copied text waits here. Copies it to `out`, returns the length (0 = nothing), empties the slot.
fn term_copy_take(state: u64, out: u64, max: u64) -> u64 {
    var n: u64 = tc_cn[0]
    if n == 0 {
        return 0
    }
    tc_cn[0] = 0
    if n > max {
        n = max
    }
    var k: u64 = 0
    while k < n {
        kstate.set8(out + k, tc_buf[(k) as usize])
        k = k + 1
    }
    return n
}

// kgui pumps: a paste waits for tty T (returns T + 1, 0 = none)
fn term_paste_take(state: u64) -> u64 {
    let t: u64 = tc_paste[0]
    tc_paste[0] = 0
    return t
}

static mut tp_buf: [u8; 4096] = [0 as u8; 4096]
static mut tp_cn: [u64; 1] = [0 as u64; 1]
static mut tc_psel: [u64; 1] = [0 as u64; 1]

fn tsel_primary(state: u64, i: u64) {
    let n: u64 = tsel_text(state, i)
    if n == 0 {
        return
    }
    var k: u64 = 0
    while k < n {
        tp_buf[(k) as usize] = tc_buf[(k) as usize]
        k = k + 1
    }
    tp_cn[0] = n
}

fn term_primary_take(state: u64, out: u64, max: u64) -> u64 {
    var n: u64 = tp_cn[0]
    if n == 0 {
        return 0
    }
    tp_cn[0] = 0
    if n > max {
        n = max
    }
    var k: u64 = 0
    while k < n {
        kstate.set8(out + k, tp_buf[(k) as usize])
        k = k + 1
    }
    return n
}

fn term_paste_sel(state: u64) -> u64 {
    let v: u64 = tc_psel[0]
    tc_psel[0] = 0
    return v
}

fn tcopies_pub() -> u64 {
    return tc_copies[0]
}

fn tpastes_pub() -> u64 {
    return tc_pastes[0]
}

// Z9 finding: Ctrl+Shift+V typed the text into the tty, but the window showed it only after the NEXT mouse click. A paste
// comes out of the poll, not out of a key event, so nothing told the compositor ring or the idle timer that the user did
// something (`on_key` does both for every real key). `kgui.termclip_pump` calls this once after the text went into the tty:
// the focused terminal window is damaged and the same two notices a key makes are given.
static mut tc_kicks: [u64; 1] = [0 as u64; 1]

fn term_paste_done(state: u64) {
    if !ready(state) {
        return
    }
    input_seen(state)
    cp_event(state, CP_EV_KEY, 0, 0, 0, 0, 0)
    let f: u64 = focus(state)
    if f < MAX_WIN && valid(state, f) && wg(state, f, W_KIND) == K_TERM {
        damage_win(state, f)
    }
    tc_kicks[0] = tc_kicks[0] + 1
    var s_k: [u8; 17] = "wm: tpaste kick=\0"
    serial.puts((&s_k[0]) as u64)
    serial.dec(tc_kicks[0])
    serial.nl()
}

fn tkicks_pub() -> u64 {
    return tc_kicks[0]
}

fn tpaste_ask(state: u64, i: u64) {
    let t: u64 = tty_of(state, i)
    if t == NO_TTY {
        return
    }
    tc_paste[0] = t + 1
    tc_pastes[0] = tc_pastes[0] + 1
    var s_p: [u8; 14] = "wm: tpaste t=\0"
    serial.puts((&s_p[0]) as u64)
    serial.dec(t)
    serial.nl()
}

// the mouse over a terminal window. kind: 0 left press, 1 left release, 2 move, 3 right press, 4 middle press.
// lx / ly are window-local pixels (>= 0).
fn term_mouse(state: u64, i: u64, kind: u64, lx: u64, ly: u64, btn: u64) {
    if i >= 32 || !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return
    }
    let cw: u64 = wg(state, i, W_CELLW)
    let ch: u64 = wg(state, i, W_CELLH)
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    if cw == 0 || ch == 0 || cols == 0 || rows == 0 {
        return
    }
    var c: u64 = lx / cw
    var r: u64 = ly / ch
    if c >= cols {
        c = cols - 1
    }
    if r >= rows {
        r = rows - 1
    }
    let k: u64 = r * cols + c
    if kind == 0 {
        if tp_sbv[(i) as usize] != 0 {
            return
        }
        tsel_clear(state, i)
        tc_sel[(i) as usize] = 1
        tc_sa[(i) as usize] = k
        tc_sb[(i) as usize] = k
        return
    }
    if kind == 2 {
        if tc_sel[(i) as usize] != 1 || (btn & ps2m.B_LEFT) == 0 {
            return
        }
        let old: u64 = tc_sb[(i) as usize]
        if old == k {
            return
        }
        tc_sb[(i) as usize] = k
        var a: u64 = old
        var b: u64 = k
        if k < old {
            a = k
            b = old
        }
        tsel_paint(state, i, a, b)
        return
    }
    if kind == 1 {
        if tc_sel[(i) as usize] != 1 {
            return
        }
        if tc_sa[(i) as usize] == tc_sb[(i) as usize] {
            tc_sel[(i) as usize] = 0
        } else {
            tc_sel[(i) as usize] = 2
            tsel_primary(state, i)
        }
        return
    }
    if kind == 3 {
        if tsel_shown(i) {
            tsel_copy(state, i)
            tsel_clear(state, i)
        } else {
            tpaste_ask(state, i)
        }
        return
    }
    if kind == 4 {
        tpaste_ask(state, i)
        tc_psel[0] = 1
    }
}

// a key with Ctrl held, from the keyboard layer. True = consumed (the shell does not see it).
//   Ctrl+Shift+C  copy the selection        Ctrl+Shift+V  paste        Ctrl+C with a selection standing: copy
// MON-3: Ctrl+Shift+F flips the developer overlay (the bar draws it; it reads the switch from /proc/frames)
fn mon_hotkey(state: u64) {
    let on: bool = frameprof.mon_toggle()
    var s_on: [u8; 13] = "wm: monov on\0"
    var s_off: [u8; 14] = "wm: monov off\0"
    if on {
        serial.puts((&s_on[0]) as u64)
    } else {
        serial.puts((&s_off[0]) as u64)
    }
    serial.nl()
}

fn term_key(state: u64, c: u64, shift: bool) -> bool {
    if !ready(state) {
        return false
    }
    if shift && (c == 70 || c == 102) && !sperre_an(state) {
        mon_hotkey(state)
        return true
    }
    let f: u64 = focus(state)
    if f >= MAX_WIN || f >= 32 || wg(state, f, W_KIND) != K_TERM || !darf(state, f) {
        // r1309: Ctrl+Shift+T is a global "new terminal" when no terminal window has the focus (desktop, other program, the terminal was
        // closed or minimised): it used to fall through to the focused program as a plain ^T and nothing opened. Not while the screen is locked.
        if shift && (c == 84 || c == 116) && !sperre_an(state) {
            tt_request_free(state)
            return true
        }
        return false
    }
    let is_c: bool = c == 67 || c == 99
    let is_v: bool = c == 86 || c == 118
    // r1014 tabs: Ctrl+Shift+T new tab, Ctrl+Shift+W close, Ctrl+Tab / Ctrl+Shift+Tab next / previous
    if c == 9 {
        if tt_grouped(state, f) {
            tt_step(state, f, !shift)
            return true
        }
        return false
    }
    if shift && (c == 84 || c == 116) {
        tt_request(state, f)
        return true
    }
    if shift && (c == 87 || c == 119) {
        tt_close_tab(state, f)
        return true
    }
    if shift {
        if is_c {
            if tsel_shown(f) {
                tsel_copy(state, f)
            }
            return true
        }
        if is_v {
            tpaste_ask(state, f)
            return true
        }
        return false
    }
    if is_c && tsel_shown(f) {
        tsel_copy(state, f)
        tsel_clear(state, f)
        return true
    }
    return false
}


// r838: paint the cell at screen position (c, r) with the given character / attribute / colour octets (the scrollback view
// paints history cells here, the live grid goes through `cell_paint`)
fn cell_paint_v(state: u64, i: u64, c: u64, r: u64, z: u64, at: u64, co: u64) {
    let cw: u64 = wg(state, i, W_CELLW)
    let ch: u64 = wg(state, i, W_CELLH)
    let f: u64 = gs(state, S_FONT_MONO)
    // r400: reverse video swaps the two colours of the cell
    var cbg: u64 = wg(state, i, W_BG)
    var cfg: u64 = wg(state, i, W_FG)
    // r462: colours (the nibbles of the colour octet), bright forms by bold / the 9x and 10x codes, underline
    if (co & 15) != 0 {
        var kf: u64 = (co & 15) - 1
        if (at & 10) != 0 {
            kf = kf + 8
        }
        cfg = term_color(state, kf)
    }
    if (co >> 4) != 0 {
        var kb: u64 = (co >> 4) - 1
        if (at & 16) != 0 {
            kb = kb + 8
        }
        cbg = term_color(state, kb)
    }
    if (at & 1) != 0 {
        let sw: u64 = cbg
        cbg = cfg
        cfg = sw
    }
    fill(state, i, c * cw, r * ch, cw, ch, cbg)
    if (at & 4) != 0 && ch > 2 {
        fill(state, i, c * cw, r * ch + ch - 2, cw, 1, cfg)
    }
    if z <= 32 || f >= ttf.MAX_FONTS {
        return
    }
    let px: u64 = gs(state, S_PX_MONO)
    let slot: u64 = ttf.glyph(state, f, z, px)
    if slot < ttf.SLOTS {
        draw_glyph_clip(state, i, slot, (c * cw) as i64,
            (r * ch) as i64 + ttf.ascent(state, f, px), cfg,
            (c * cw) as i64, ((c + 1) * cw) as i64)
    }
}

// ==================================================== RUNDE FARBE
// DAS GANZE RASTER NOCH EINMAL MALEN.
//
// Gebraucht wird das genau einmal: wenn die Taskleiste die beiden
// Terminalfarben setzt, NACHDEM das Fenster schon steht (siehe
// `set_deco_colour`). `cell_paint` fuellt je Zelle erst den Grund in
// `W_BG` und setzt dann das Zeichen in `W_FG` -- beides sind die
// NEUEN Farben, sobald sie im Fenster stehen. Also ist "alles neu
// malen" genau "jede Zelle neu malen", und es braucht keinen zweiten
// Zeichenweg, der mit dem ersten auseinanderlaufen koennte.
fn term_redraw(state: u64, i: u64) {
    if !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return
    }
    if i < 32 && tp_sbv[(i) as usize] != 0 {
        sb_redraw(state, i)
        return
    }
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    var r: u64 = 0
    while r < rows {
        var c: u64 = 0
        while c < cols {
            cell_paint(state, i, c, r)
            c = c + 1
        }
        r = r + 1
    }
}

// ============================================ r838: TERMINAL SCROLLBACK
// Lines that scroll off the top of a full-screen scroll (main screen, region = whole screen) go into a ring of SB_LINES lines
// per terminal window (kernel frames, taken on the first scrolled line, given back when the window closes). Each line holds
// the three planes (character, attribute, colour) for SB_W columns. The mouse wheel over the window moves the view
// (`tp_sbv` = lines scrolled back, SB_STEP per notch); any output or key snaps back to the live screen.
const SB_LINES: u64 = 256
const SB_W: u64 = 256
const SB_STRIDE: u64 = 768 // 3 planes x SB_W
const SB_FRAMES: u64 = 48  // SB_LINES * SB_STRIDE / 4096
const SB_STEP: u64 = 3
static mut tp_sb: [u64; 32] = [0 as u64; 32]  // base of the ring (0 = none yet)
static mut tp_sbn: [u64; 32] = [0 as u64; 32] // lines stored
static mut tp_sbh: [u64; 32] = [0 as u64; 32] // next slot to write
static mut tp_sbv: [u64; 32] = [0 as u64; 32] // lines the view is scrolled back (0 = live)

fn sb_free(state: u64, i: u64) {
    if i >= 32 {
        return
    }
    if tp_sb[(i) as usize] != 0 {
        mem.frame_free_run(state, tp_sb[(i) as usize], SB_FRAMES)
    }
    tp_sb[(i) as usize] = 0
    tp_sbn[(i) as usize] = 0
    tp_sbh[(i) as usize] = 0
    tp_sbv[(i) as usize] = 0
}

// push grid row r (about to scroll off the top) into the ring
fn sb_push(state: u64, i: u64, r: u64) {
    if i >= 32 {
        return
    }
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 {
        return
    }
    var b: u64 = tp_sb[(i) as usize]
    if b == 0 {
        b = mem.frame_run(state, SB_FRAMES)
        if b == 0 {
            return
        }
        tp_sb[(i) as usize] = b
        tp_sbn[(i) as usize] = 0
        tp_sbh[(i) as usize] = 0
    }
    let cols: u64 = wg(state, i, W_COLS)
    let dst: u64 = b + tp_sbh[(i) as usize] * SB_STRIDE
    var c: u64 = 0
    while c < SB_W {
        var z: u64 = 32
        var at: u64 = 0
        var co: u64 = 0
        if c < cols && r * cols + c < TG {
            let k: u64 = r * cols + c
            z = kstate.get8(g + k)
            at = kstate.get8(g + TG + k)
            co = kstate.get8(g + 2 * TG + k)
        }
        kstate.set8(dst + c, z as u8)
        kstate.set8(dst + SB_W + c, at as u8)
        kstate.set8(dst + 2 * SB_W + c, co as u8)
        c = c + 1
    }
    tp_sbh[(i) as usize] = (tp_sbh[(i) as usize] + 1) % SB_LINES
    if tp_sbn[(i) as usize] < SB_LINES {
        tp_sbn[(i) as usize] = tp_sbn[(i) as usize] + 1
    }
}

// address of history line h (0 = oldest stored)
fn sb_line(i: u64, h: u64) -> u64 {
    let slot: u64 = (tp_sbh[(i) as usize] + SB_LINES - tp_sbn[(i) as usize] + h) % SB_LINES
    return tp_sb[(i) as usize] + slot * SB_STRIDE
}

// the character shown at screen cell (c, r) while the view is scrolled back
fn sb_view_char(state: u64, i: u64, c: u64, r: u64) -> u64 {
    let v: u64 = tp_sbv[(i) as usize]
    if r >= v {
        return cell_get(state, i, c, r - v)
    }
    if c >= SB_W {
        return 32
    }
    return kstate.get8(sb_line(i, tp_sbn[(i) as usize] - v + r) + c)
}

fn sb_redraw(state: u64, i: u64) {
    let v: u64 = tp_sbv[(i) as usize]
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    var r: u64 = 0
    while r < rows {
        var c: u64 = 0
        while c < cols {
            if r >= v {
                cell_paint_v(state, i, c, r, cell_get(state, i, c, r - v), cell_attr(state, i, c, r - v), cell_col(state, i, c, r - v))
            } else if c >= SB_W {
                cell_paint_v(state, i, c, r, 32, 0, 0)
            } else {
                let ln: u64 = sb_line(i, tp_sbn[(i) as usize] - v + r)
                cell_paint_v(state, i, c, r, kstate.get8(ln + c), kstate.get8(ln + SB_W + c), kstate.get8(ln + 2 * SB_W + c))
            }
            c = c + 1
        }
        r = r + 1
    }
}

// back to the live screen (called before any output, on a key, on a resize)
fn sb_snap(state: u64, i: u64) {
    if i >= 32 || tp_sbv[(i) as usize] == 0 {
        return
    }
    tp_sbv[(i) as usize] = 0
    term_redraw(state, i)
}

// wheel notches over a terminal window: d > 0 = wheel up = older lines
fn sb_wheel(state: u64, i: u64, d: i64) {
    if i >= 32 || !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return
    }
    sb_move(state, i, d * (SB_STEP as i64))
}

// Move the view by `dl` lines (+ = back into the history), clamped to what is stored.
fn sb_move(state: u64, i: u64, dl: i64) {
    if i >= 32 || !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return
    }
    let n: u64 = tp_sbn[(i) as usize]
    var v: i64 = (tp_sbv[(i) as usize] as i64) + dl
    if v < 0 {
        v = 0
    }
    if v > (n as i64) {
        v = n as i64
    }
    if (v as u64) == tp_sbv[(i) as usize] {
        return
    }
    tp_sbv[(i) as usize] = v as u64
    term_redraw(state, i)
    damage_win(state, i)
}

// serial witness for tools/term/scroll.sh
fn sb_dump(state: u64, i: u64) {
    var s_a: [u8; 18] = "wm: termsb lines=\0"
    var s_b: [u8; 7] = " view=\0"
    var s_c: [u8; 14] = "wm: termview \0"
    var s_g: [u8; 4] = " [\0\0"
    var s_z: [u8; 2] = "]\0"
    if i >= 32 {
        return
    }
    serial.puts((&s_a[0]) as u64)
    serial.dec(tp_sbn[(i) as usize])
    serial.puts((&s_b[0]) as u64)
    serial.dec(tp_sbv[(i) as usize])
    serial.nl()
    if tp_sbv[(i) as usize] == 0 {
        return
    }
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    var r: u64 = 0
    while r < rows {
        var last: u64 = 0
        var c0: u64 = 0
        while c0 < cols {
            if sb_view_char(state, i, c0, r) > 32 {
                last = c0 + 1
            }
            c0 = c0 + 1
        }
        if last != 0 {
            serial.puts((&s_c[0]) as u64)
            serial.dec(r)
            serial.puts((&s_g[0]) as u64)
            var c: u64 = 0
            while c < last {
                let z: u64 = sb_view_char(state, i, c, r)
                if z >= 32 && z < 127 {
                    serial.put(z as u8)
                } else {
                    serial.put(32 as u8)
                }
                c = c + 1
            }
            serial.puts((&s_z[0]) as u64)
            serial.nl()
        }
        r = r + 1
    }
}

// ============================================ RUNDE GLAS (nachtrag)
// DAS TERMINAL SPRACH KEIN UTF-8 -- UND HAT DIE UMLAUTE STILL
// WEGGEWORFEN.
//
// Justins Befund am Bild 04 dieser Runde: im Terminalfenster stand
// "KEIN EINZIGES GERT!". Die Quelle (kernel/ui/kgui.fi, `usb_bericht`)
// schreibt "GERAET" mit einem richtigen UTF-8-Ä, also die zwei Oktette
// 0xC3 0x84 -- und die Zeile `if ch < 32 || ch > 126 { return }`
// darunter hat beide verschluckt. Nicht als Kaestchen, nicht als
// Fragezeichen: spurlos. Genau dieselbe Klasse Fehler, die Runde
// UMLAUT2 fuer die Bedienoberflaeche abgestellt hat; der Weg ins
// Terminalfenster war der letzte, der sie noch hatte.
//
// EIN Oktett Zustand reicht, weil genau EIN Fall zu behandeln ist: die
// zweioktettige Folge C2..DF / 80..BF traegt U+0080..U+07FF, und alles
// davon, was eine Zelle (ein Oktett) fassen kann, ist Latin-1, also
// U+00A0..U+00FF -- Ä, ö, ß, °, µ. Die Zelle bleibt damit ein Oktett
// breit und `cell_paint` gibt ihre Zahl unveraendert als Zeichennummer
// an `ttf.glyph` weiter, das seit Runde GLYPHE nach Zeichennummer und
// nicht nach Oktett sucht. Drei- und vieroktettige Folgen (CJK,
// Emoji) passen NICHT in ein Oktett; sie werden als ein Fragezeichen
// gesetzt, weil ein sichtbarer Platzhalter der einzige Befund ist, der
// sich spaeter noch melden laesst.
// r462: THE TERMINAL EXECUTES THE CONTROL SEQUENCES OF FULL-SCREEN PROGRAMS (Justin, Dell photo 07.10.2026 19:05: the editor showed
// `~[19;1H[K`, `[7m`, `[24;1H[K^O Write`, `[?25h[?25l` as text). Two causes, both fixed: (1) an image from before the VT subset of
// r400 printed the sequences; (2) with the subset, `/bin/edit` still drew an 80 x 24 screen into a 72 x 19 window, because nobody ever
// told the tty the size of its window (`TIOCGWINSZ` answered the default): see `term_size`, `tty.do_ioctl`, `kgui.winch_wache`.
//
// WHAT THE MACHINE UNDERSTANDS (a subset of VT100 / xterm, enough for editors, pagers and `top`-like programs):
//   cursor        CSI n A B C D E F G d ` H f, save / restore (ESC 7, ESC 8, CSI s, CSI u), ESC D / E / M, CR LF BS
//   erase         CSI J (0 1 2 3), CSI K (0 1 2), CSI n X (erase characters)
//   edit          CSI n @ (insert characters), P (delete characters), L (insert lines), M (delete lines), S / T (scroll up / down)
//   region        CSI t ; b r (scroll region); line feed at its bottom scrolls only the region
//   attributes    CSI m: 0 reset, 1 bold (bright colour), 4 underline, 7 reverse, 22 24 27 off, 30-37 40-47 colours,
//                 38 / 48 ; 5 ; n (the 16 first) , 39 49 default, 90-97 100-107 bright
//   modes         CSI ? 1049 h / l (alternate screen: the main screen is saved and comes back), ?47 ?1047 the same without
//                 the cursor, ?7 wrap on / off; ?25 (cursor), ?1 ?12 ?2004 and every other mode are accepted and dropped
//   strings       OSC / DCS / APC / PM up to BEL or ESC \ are swallowed (window titles must not become text)
// EVERYTHING ELSE after ESC, ESC [ is swallowed up to its final octet: an unknown sequence never shows up as characters.
// The automatic wrap is DEFERRED like on a real terminal: the 80th character of a row does not scroll the screen yet.
//
// The state is per window (a second terminal window must not inherit half a sequence of the first).
static mut tp_esc: [u64; 32] = [0 as u64; 32]   // 0 plain, 1 after ESC, 2 inside CSI, 3 inside a string, 4 one octet to drop, 5 ESC inside a string
static mut tp_np: [u64; 32] = [0 as u64; 32]    // index of the parameter being read
static mut tp_priv: [u64; 32] = [0 as u64; 32]  // 1 = `?` marker, 2 = another marker (< = >)
static mut tp_par: [u64; 256] = [0 as u64; 256] // TP_NP (8) parameters of each window
static mut tp_has: [u64; 256] = [0 as u64; 256]
static mut tp_attr: [u64; 32] = [0 as u64; 32]  // 1 reverse, 2 bold, 4 underline, 8 bright foreground, 16 bright background
static mut tp_col: [u64; 32] = [0 as u64; 32]   // low nibble foreground, high nibble background: 0 default, 1 .. 8 = colour 0 .. 7
static mut tp_utf: [u64; 32] = [0 as u64; 32]   // the UTF-8 lead octet that waits for its follower
static mut tp_wrap: [u64; 32] = [0 as u64; 32]  // 1 = the cursor stands behind the last column (the wrap is pending)
static mut tp_nowrap: [u64; 32] = [0 as u64; 32] // 1 = ?7 l: no wrap
static mut tp_scx: [u64; 32] = [0 as u64; 32]   // the saved cursor
static mut tp_scy: [u64; 32] = [0 as u64; 32]
static mut tp_sat: [u64; 32] = [0 as u64; 32]
static mut tp_sco: [u64; 32] = [0 as u64; 32]
static mut tp_top: [u64; 32] = [0 as u64; 32]   // the scroll region: first row, and last row + 1 (0 = to the end of the screen)
static mut tp_bot1: [u64; 32] = [0 as u64; 32]
static mut tp_alt: [u64; 32] = [0 as u64; 32]   // 1 = the alternate screen is up (the main one lies in frames 3 .. 5 of the grid)
const TP_NP: u64 = 8

fn tp_reset(i: u64) {
    if i >= 32 {
        return
    }
    tp_esc[(i) as usize] = 0
    tp_np[(i) as usize] = 0
    tp_priv[(i) as usize] = 0
    tp_attr[(i) as usize] = 0
    tp_col[(i) as usize] = 0
    tp_utf[(i) as usize] = 0
    tp_wrap[(i) as usize] = 0
    tp_nowrap[(i) as usize] = 0
    tp_scx[(i) as usize] = 0
    tp_scy[(i) as usize] = 0
    tp_sat[(i) as usize] = 0
    tp_sco[(i) as usize] = 0
    tp_top[(i) as usize] = 0
    tp_bot1[(i) as usize] = 0
    tp_alt[(i) as usize] = 0
}

// the last row of the scroll region (a region that does not fit the screen is the whole screen)
fn tp_bot(state: u64, i: u64) -> u64 {
    let rows: u64 = wg(state, i, W_ROWS)
    let b1: u64 = tp_bot1[(i) as usize]
    if b1 == 0 || b1 > rows || tp_top[(i) as usize] + 1 >= b1 {
        return rows - 1
    }
    return b1 - 1
}

fn tp_first(state: u64, i: u64) -> u64 {
    let rows: u64 = wg(state, i, W_ROWS)
    let b1: u64 = tp_bot1[(i) as usize]
    if b1 == 0 || b1 > rows || tp_top[(i) as usize] + 1 >= b1 {
        return 0
    }
    return tp_top[(i) as usize]
}

// the parameter k of the sequence (dflt when it was not given)
fn tp_p(i: u64, k: u64, dflt: u64) -> u64 {
    if k < TP_NP && tp_has[(i * TP_NP + k) as usize] != 0 {
        return tp_par[(i * TP_NP + k) as usize]
    }
    return dflt
}

// a count parameter: missing or 0 means 1
fn tp_n(i: u64) -> u64 {
    let v: u64 = tp_p(i, 0, 1)
    if v == 0 {
        return 1
    }
    return v
}

// the cells of one row and nothing else: character, attribute, colour
fn grid_row_copy(state: u64, i: u64, rdst: u64, rsrc: u64) {
    let g: u64 = wg(state, i, W_GRID)
    let cols: u64 = wg(state, i, W_COLS)
    if g == 0 {
        return
    }
    var c: u64 = 0
    while c < cols {
        let d: u64 = rdst * cols + c
        let s: u64 = rsrc * cols + c
        if d < TG && s < TG {
            kstate.set8(g + d, kstate.get8(g + s) as u8)
            kstate.set8(g + TG + d, kstate.get8(g + TG + s) as u8)
            kstate.set8(g + 2 * TG + d, kstate.get8(g + 2 * TG + s) as u8)
        }
        c = c + 1
    }
}

fn grid_row_clear(state: u64, i: u64, r: u64) {
    let g: u64 = wg(state, i, W_GRID)
    let cols: u64 = wg(state, i, W_COLS)
    if g == 0 {
        return
    }
    var c: u64 = 0
    while c < cols {
        let d: u64 = r * cols + c
        if d < TG {
            kstate.set8(g + d, 32 as u8)
            kstate.set8(g + TG + d, 0 as u8)
            kstate.set8(g + 2 * TG + d, 0 as u8)
        }
        c = c + 1
    }
}

fn term_repaint_row(state: u64, i: u64, r: u64) {
    let cols: u64 = wg(state, i, W_COLS)
    var c: u64 = 0
    while c < cols {
        cell_paint(state, i, c, r)
        c = c + 1
    }
}

// Scroll the rows `top ..= bot` up (up = true) or down by n rows: the cells and the picture move, the rows that come free are blank.
fn term_scroll_region(state: u64, i: u64, top: u64, bot: u64, n: u64, up: bool) {
    let rows: u64 = wg(state, i, W_ROWS)
    if rows == 0 || top >= rows || bot >= rows || bot < top || n == 0 {
        return
    }
    var k: u64 = n
    if k > bot - top + 1 {
        k = bot - top + 1
    }
    // r838: lines that leave the top of the whole screen go to the scrollback (not on the alternate screen)
    if up && top == 0 && bot + 1 == rows && i < 32 && tp_alt[(i) as usize] == 0 {
        var q: u64 = 0
        while q < k {
            sb_push(state, i, q)
            q = q + 1
        }
    }
    // the cells
    if up {
        var r: u64 = top
        while r + k <= bot {
            grid_row_copy(state, i, r, r + k)
            r = r + 1
        }
        var rc: u64 = bot + 1 - k
        while rc <= bot {
            grid_row_clear(state, i, rc)
            rc = rc + 1
        }
    } else {
        var r2: u64 = bot + 1
        while r2 > top + k {
            r2 = r2 - 1
            grid_row_copy(state, i, r2, r2 - k)
        }
        var rc2: u64 = top
        while rc2 < top + k {
            grid_row_clear(state, i, rc2)
            rc2 = rc2 + 1
        }
    }
    // the picture: copy whole pixel rows (the window is as wide as its buffer), then blank the rows that came free
    let ch: u64 = wg(state, i, W_CELLH)
    let ww: u64 = wg(state, i, W_W)
    let buf: u64 = wg(state, i, W_BUF)
    if buf == 0 || ww == 0 || ch == 0 {
        return
    }
    let y0: u64 = top * ch
    let y1: u64 = (bot + 1) * ch
    let shift: u64 = k * ch
    if up {
        var y: u64 = y0
        while y + shift < y1 {
            copy_words(buf +% y *% ww *% 4, buf +% (y + shift) *% ww *% 4, ww *% 4 / 8)
            y = y + 1
        }
        fill(state, i, 0, y1 - shift, ww, shift, wg(state, i, W_BG))
    } else {
        var y2: u64 = y1 - shift
        while y2 > y0 {
            y2 = y2 - 1
            copy_words(buf +% (y2 + shift) *% ww *% 4, buf +% y2 *% ww *% 4, ww *% 4 / 8)
        }
        fill(state, i, 0, y0, ww, shift, wg(state, i, W_BG))
    }
}

// the scroll at the end of the screen (the old `term_scroll`): the region up by one row
fn term_scroll(state: u64, i: u64) {
    term_scroll_region(state, i, tp_first(state, i), tp_bot(state, i), 1, true)
}

// a line feed: down one row, or the region scrolls when the cursor stands on its last row
fn term_lf(state: u64, i: u64) {
    let rows: u64 = wg(state, i, W_ROWS)
    let cy: u64 = wg(state, i, W_CY)
    if cy == tp_bot(state, i) {
        term_scroll_region(state, i, tp_first(state, i), tp_bot(state, i), 1, true)
    } else if cy + 1 < rows {
        wsv(state, i, W_CY, cy + 1)
    }
}

// the reverse index: up one row, or the region scrolls down when the cursor stands on its first row
fn term_ri(state: u64, i: u64) {
    let cy: u64 = wg(state, i, W_CY)
    if cy == tp_first(state, i) {
        term_scroll_region(state, i, tp_first(state, i), tp_bot(state, i), 1, false)
    } else if cy > 0 {
        wsv(state, i, W_CY, cy - 1)
    }
}

fn term_clear_rect(state: u64, i: u64, c0: u64, r0: u64, c1: u64, r1: u64) {
    // blank the cells from (c0, r0) up to but excluding (c1, r1), row-major
    let cols: u64 = wg(state, i, W_COLS)
    var r: u64 = r0
    var c: u64 = c0
    while r < r1 || (r == r1 && c < c1) {
        cell_set(state, i, c, r, 32)
        cell_attr_set(state, i, c, r, 0)
        cell_col_set(state, i, c, r, 0)
        cell_paint(state, i, c, r)
        c = c + 1
        if c >= cols {
            c = 0
            r = r + 1
        }
    }
}

fn term_set_cursor(state: u64, i: u64, c: u64, r: u64) {
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    var cc: u64 = c
    var rr: u64 = r
    if cc >= cols {
        cc = cols - 1
    }
    if rr >= rows {
        rr = rows - 1
    }
    wsv(state, i, W_CX, cc)
    wsv(state, i, W_CY, rr)
    tp_wrap[(i) as usize] = 0
}

fn term_save_cursor(state: u64, i: u64) {
    tp_scx[(i) as usize] = wg(state, i, W_CX)
    tp_scy[(i) as usize] = wg(state, i, W_CY)
    tp_sat[(i) as usize] = tp_attr[(i) as usize]
    tp_sco[(i) as usize] = tp_col[(i) as usize]
}

fn term_restore_cursor(state: u64, i: u64) {
    term_set_cursor(state, i, tp_scx[(i) as usize], tp_scy[(i) as usize])
    tp_attr[(i) as usize] = tp_sat[(i) as usize]
    tp_col[(i) as usize] = tp_sco[(i) as usize]
}

// the whole screen blank, the cursor home
fn term_blank_screen(state: u64, i: u64) {
    let rows: u64 = wg(state, i, W_ROWS)
    var r: u64 = 0
    while r < rows {
        grid_row_clear(state, i, r)
        r = r + 1
    }
    fill(state, i, 0, 0, wg(state, i, W_W), wg(state, i, W_H), wg(state, i, W_BG))
}

// ESC c: back to the state of a new window
fn term_full_reset(state: u64, i: u64) {
    tcur_off(state, i)
    tc_hide[(i) as usize] = 0
    term_blank_screen(state, i)
    tp_reset(i)
    wsv(state, i, W_CX, 0)
    wsv(state, i, W_CY, 0)
}

// The alternate screen: the main screen (cells, attributes, colours) is copied to frames 3 .. 5 of the grid and comes back
// when the program leaves. `save_cursor` is the ?1049 form that also keeps the cursor.
fn term_alt_enter(state: u64, i: u64, save_cursor: bool) {
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 || tp_alt[(i) as usize] != 0 {
        return
    }
    if save_cursor {
        term_save_cursor(state, i)
    }
    copy_words(g + 3 * TG, g, TG_ALT_WORDS)
    tp_alt[(i) as usize] = 1
    term_blank_screen(state, i)
    tp_top[(i) as usize] = 0
    tp_bot1[(i) as usize] = 0
    term_set_cursor(state, i, 0, 0)
}

fn term_alt_leave(state: u64, i: u64, restore_cursor: bool) {
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 || tp_alt[(i) as usize] == 0 {
        return
    }
    copy_words(g, g + 3 * TG, TG_ALT_WORDS)
    tp_alt[(i) as usize] = 0
    tp_top[(i) as usize] = 0
    tp_bot1[(i) as usize] = 0
    fill(state, i, 0, 0, wg(state, i, W_W), wg(state, i, W_H), wg(state, i, W_BG))
    term_redraw(state, i)
    if restore_cursor {
        term_restore_cursor(state, i)
    }
}

// CSI ? n h / l: the modes
fn term_mode(state: u64, i: u64, on: bool) {
    var k: u64 = 0
    var cnt: u64 = tp_np[(i) as usize]
    if cnt == 0 {
        cnt = 1
    }
    while k < cnt && k < TP_NP {
        let m: u64 = tp_p(i, k, 0)
        if m == 1049 {
            if on {
                term_alt_enter(state, i, true)
            } else {
                term_alt_leave(state, i, true)
            }
        } else if m == 47 || m == 1047 {
            if on {
                term_alt_enter(state, i, false)
            } else {
                term_alt_leave(state, i, false)
            }
        } else if m == 7 {
            if on {
                tp_nowrap[(i) as usize] = 0
            } else {
                tp_nowrap[(i) as usize] = 1
            }
        } else if m == 25 {
            // r1014: the text cursor (DECTCEM)
            if on {
                tc_hide[(i) as usize] = 0
            } else {
                tc_hide[(i) as usize] = 1
            }
        }
        // 1, 12, 2004 ...: accepted and dropped
        k = k + 1
    }
}

// CSI m: the attributes and colours
fn term_sgr(i: u64) {
    var q: u64 = 0
    var cnt: u64 = tp_np[(i) as usize]
    if cnt == 0 {
        cnt = 1
    }
    while q < cnt && q < TP_NP {
        let v: u64 = tp_p(i, q, 0)
        if v == 0 {
            tp_attr[(i) as usize] = 0
            tp_col[(i) as usize] = 0
        } else if v == 1 {
            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 2
        } else if v == 4 {
            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 4
        } else if v == 7 {
            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 1
        } else if v == 22 {
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xFD
        } else if v == 24 {
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xFB
        } else if v == 27 {
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xFE
        } else if v >= 30 && v <= 37 {
            tp_col[(i) as usize] = (tp_col[(i) as usize] & 0xF0) | (v - 30 + 1)
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xF7
        } else if v == 39 {
            tp_col[(i) as usize] = tp_col[(i) as usize] & 0xF0
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xF7
        } else if v >= 40 && v <= 47 {
            tp_col[(i) as usize] = (tp_col[(i) as usize] & 0x0F) | ((v - 40 + 1) << 4)
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xEF
        } else if v == 49 {
            tp_col[(i) as usize] = tp_col[(i) as usize] & 0x0F
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xEF
        } else if v >= 90 && v <= 97 {
            tp_col[(i) as usize] = (tp_col[(i) as usize] & 0xF0) | (v - 90 + 1)
            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 8
        } else if v >= 100 && v <= 107 {
            tp_col[(i) as usize] = (tp_col[(i) as usize] & 0x0F) | ((v - 100 + 1) << 4)
            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 16
        } else if v == 38 || v == 48 {
            // 38 ; 5 ; n  (the 16 first colours of the 256 are used, the rest is dropped)  and  38 ; 2 ; r ; g ; b (dropped)
            let mode: u64 = tp_p(i, q + 1, 0)
            if mode == 5 {
                let nn: u64 = tp_p(i, q + 2, 0)
                if nn < 16 {
                    var idx: u64 = nn
                    var br: u64 = 0
                    if nn >= 8 {
                        idx = nn - 8
                        br = 1
                    }
                    if v == 38 {
                        tp_col[(i) as usize] = (tp_col[(i) as usize] & 0xF0) | (idx + 1)
                        if br != 0 {
                            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 8
                        } else {
                            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xF7
                        }
                    } else {
                        tp_col[(i) as usize] = (tp_col[(i) as usize] & 0x0F) | ((idx + 1) << 4)
                        if br != 0 {
                            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 16
                        } else {
                            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xEF
                        }
                    }
                }
                q = q + 2
            } else if mode == 2 {
                q = q + 4
            }
        }
        q = q + 1
    }
}

// the final octet of a CSI: do it
fn term_csi(state: u64, i: u64, fin: u64) {
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    let cx: u64 = wg(state, i, W_CX)
    let cy: u64 = wg(state, i, W_CY)
    let pv: u64 = tp_priv[(i) as usize]
    if pv != 0 {
        // CSI ? ... h / l: the modes; every other private sequence is dropped
        if pv == 1 && (fin == 104 || fin == 108) {
            term_mode(state, i, fin == 104)
        }
        return
    }
    if fin == 72 || fin == 102 {
        // H / f: row ; column, one based
        var r: u64 = tp_p(i, 0, 1)
        var c: u64 = tp_p(i, 1, 1)
        if r == 0 {
            r = 1
        }
        if c == 0 {
            c = 1
        }
        term_set_cursor(state, i, c - 1, r - 1)
    } else if fin == 65 {
        let n: u64 = tp_n(i)
        var top: u64 = 0
        if cy >= tp_first(state, i) {
            top = tp_first(state, i)
        }
        var to: u64 = 0
        if cy > top + n {
            to = cy - n
        } else {
            to = top
        }
        term_set_cursor(state, i, cx, to)
    } else if fin == 66 || fin == 101 {
        let n2: u64 = tp_n(i)
        var lim: u64 = rows - 1
        if cy <= tp_bot(state, i) {
            lim = tp_bot(state, i)
        }
        var to2: u64 = cy + n2
        if to2 > lim {
            to2 = lim
        }
        term_set_cursor(state, i, cx, to2)
    } else if fin == 67 || fin == 97 {
        let n3: u64 = tp_n(i)
        term_set_cursor(state, i, cx + n3, cy)
    } else if fin == 68 {
        let n4: u64 = tp_n(i)
        var to4: u64 = 0
        if cx > n4 {
            to4 = cx - n4
        }
        term_set_cursor(state, i, to4, cy)
    } else if fin == 69 {
        // E: next line, column 1
        let n5: u64 = tp_n(i)
        term_set_cursor(state, i, 0, cy + n5)
    } else if fin == 70 {
        // F: previous line, column 1
        let n6: u64 = tp_n(i)
        var to6: u64 = 0
        if cy > n6 {
            to6 = cy - n6
        }
        term_set_cursor(state, i, 0, to6)
    } else if fin == 71 || fin == 96 {
        var c7: u64 = tp_p(i, 0, 1)
        if c7 == 0 {
            c7 = 1
        }
        term_set_cursor(state, i, c7 - 1, cy)
    } else if fin == 100 {
        var r8: u64 = tp_p(i, 0, 1)
        if r8 == 0 {
            r8 = 1
        }
        term_set_cursor(state, i, cx, r8 - 1)
    } else if fin == 75 {
        // K: erase in line (0 = cursor to end, 1 = start to cursor, 2 = all)
        let m: u64 = tp_p(i, 0, 0)
        if m == 0 {
            term_clear_rect(state, i, cx, cy, 0, cy + 1)
        } else if m == 1 {
            term_clear_rect(state, i, 0, cy, cx + 1, cy)
        } else if m == 2 {
            term_clear_rect(state, i, 0, cy, 0, cy + 1)
        }
    } else if fin == 74 {
        // J: erase in display
        let m2: u64 = tp_p(i, 0, 0)
        if m2 == 0 {
            term_clear_rect(state, i, cx, cy, 0, rows)
        } else if m2 == 1 {
            term_clear_rect(state, i, 0, 0, cx + 1, cy)
        } else if m2 == 2 || m2 == 3 {
            term_clear_rect(state, i, 0, 0, 0, rows)
        }
    } else if fin == 88 {
        // X: erase n characters from the cursor
        var n9: u64 = tp_n(i)
        if cx + n9 > cols {
            n9 = cols - cx
        }
        term_clear_rect(state, i, cx, cy, cx + n9, cy)
    } else if fin == 64 {
        // @: insert n blank characters, the rest of the row moves right
        var n10: u64 = tp_n(i)
        if n10 > cols - cx {
            n10 = cols - cx
        }
        var c10: u64 = cols
        while c10 > cx + n10 {
            c10 = c10 - 1
            cell_set(state, i, c10, cy, cell_get(state, i, c10 - n10, cy))
            cell_attr_set(state, i, c10, cy, cell_attr(state, i, c10 - n10, cy))
            cell_col_set(state, i, c10, cy, cell_col(state, i, c10 - n10, cy))
        }
        var b10: u64 = cx
        while b10 < cx + n10 {
            cell_set(state, i, b10, cy, 32)
            cell_attr_set(state, i, b10, cy, 0)
            cell_col_set(state, i, b10, cy, 0)
            b10 = b10 + 1
        }
        term_repaint_row(state, i, cy)
    } else if fin == 80 {
        // P: delete n characters, the rest of the row moves left
        var n11: u64 = tp_n(i)
        if n11 > cols - cx {
            n11 = cols - cx
        }
        var c11: u64 = cx
        while c11 + n11 < cols {
            cell_set(state, i, c11, cy, cell_get(state, i, c11 + n11, cy))
            cell_attr_set(state, i, c11, cy, cell_attr(state, i, c11 + n11, cy))
            cell_col_set(state, i, c11, cy, cell_col(state, i, c11 + n11, cy))
            c11 = c11 + 1
        }
        while c11 < cols {
            cell_set(state, i, c11, cy, 32)
            cell_attr_set(state, i, c11, cy, 0)
            cell_col_set(state, i, c11, cy, 0)
            c11 = c11 + 1
        }
        term_repaint_row(state, i, cy)
    } else if fin == 76 {
        // L: insert n blank rows at the cursor row (inside the region), the rows below move down
        if cy >= tp_first(state, i) && cy <= tp_bot(state, i) {
            term_scroll_region(state, i, cy, tp_bot(state, i), tp_n(i), false)
            term_set_cursor(state, i, 0, cy)
        }
    } else if fin == 77 {
        // M: delete n rows at the cursor row, the rows below move up
        if cy >= tp_first(state, i) && cy <= tp_bot(state, i) {
            term_scroll_region(state, i, cy, tp_bot(state, i), tp_n(i), true)
            term_set_cursor(state, i, 0, cy)
        }
    } else if fin == 83 {
        term_scroll_region(state, i, tp_first(state, i), tp_bot(state, i), tp_n(i), true)
    } else if fin == 84 {
        term_scroll_region(state, i, tp_first(state, i), tp_bot(state, i), tp_n(i), false)
    } else if fin == 114 {
        // r: the scroll region, top ; bottom (one based); a bad pair resets it. The cursor goes home.
        var t: u64 = tp_p(i, 0, 1)
        var b: u64 = tp_p(i, 1, rows)
        if t == 0 {
            t = 1
        }
        if b == 0 || b > rows {
            b = rows
        }
        if t < b {
            tp_top[(i) as usize] = t - 1
            if b == rows && t == 1 {
                tp_bot1[(i) as usize] = 0
            } else {
                tp_bot1[(i) as usize] = b
            }
        } else {
            tp_top[(i) as usize] = 0
            tp_bot1[(i) as usize] = 0
        }
        term_set_cursor(state, i, 0, 0)
    } else if fin == 115 {
        term_save_cursor(state, i)
    } else if fin == 117 {
        term_restore_cursor(state, i)
    } else if fin == 109 {
        term_sgr(i)
    }
    // h / l without `?` (the ANSI modes), n (status request), c (attributes request), t, ... : accepted and dropped
}

// The escape machine in front of `term_putc`. Answers true when it took the octet.
fn term_esc_take(state: u64, i: u64, ch: u64) -> bool {
    if i >= 32 {
        return false
    }
    let st: u64 = tp_esc[(i) as usize]
    if st == 0 {
        if ch == 27 {
            tp_esc[(i) as usize] = 1
            return true
        }
        return false
    }
    if st == 3 {
        // inside OSC / DCS / PM / APC: up to BEL, or ESC \
        if ch == 7 {
            tp_esc[(i) as usize] = 0
        } else if ch == 27 {
            tp_esc[(i) as usize] = 5
        }
        return true
    }
    if st == 5 {
        tp_esc[(i) as usize] = 0
        return true
    }
    if st == 4 {
        tp_esc[(i) as usize] = 0
        return true
    }
    if st == 1 {
        tp_esc[(i) as usize] = 0
        if ch == 91 {
            tp_esc[(i) as usize] = 2
            tp_np[(i) as usize] = 0
            tp_priv[(i) as usize] = 0
            var k: u64 = 0
            while k < TP_NP {
                tp_par[(i * TP_NP + k) as usize] = 0
                tp_has[(i * TP_NP + k) as usize] = 0
                k = k + 1
            }
            return true
        }
        if ch == 93 || ch == 80 || ch == 94 || ch == 95 || ch == 88 {
            // ] P ^ _ X: the string sequences
            tp_esc[(i) as usize] = 3
            return true
        }
        if ch == 40 || ch == 41 || ch == 42 || ch == 43 || ch == 35 || ch == 37 {
            // ESC ( B, ESC # 8 ...: one more octet belongs to it
            tp_esc[(i) as usize] = 4
            return true
        }
        if ch == 99 {
            term_full_reset(state, i)
            return true
        }
        if ch == 55 {
            term_save_cursor(state, i)
            return true
        }
        if ch == 56 {
            term_restore_cursor(state, i)
            return true
        }
        if ch == 68 {
            term_lf(state, i)
            return true
        }
        if ch == 69 {
            wsv(state, i, W_CX, 0)
            tp_wrap[(i) as usize] = 0
            term_lf(state, i)
            return true
        }
        if ch == 77 {
            term_ri(state, i)
            return true
        }
        if ch == 27 {
            tp_esc[(i) as usize] = 1
            return true
        }
        if ch >= 48 && ch <= 126 {
            // ESC = ESC > ESC H ESC Z ...: the other two-octet escapes are dropped
            return true
        }
        if ch < 32 {
            // a control octet after a lone ESC: handled as itself
            return false
        }
        return true
    }
    // inside ESC [
    if ch >= 48 && ch <= 57 {
        let np: u64 = tp_np[(i) as usize]
        if np < TP_NP {
            let at: u64 = i * TP_NP + np
            tp_par[(at) as usize] = tp_par[(at) as usize] * 10 + (ch - 48)
            if tp_par[(at) as usize] > 9999 {
                tp_par[(at) as usize] = 9999
            }
            tp_has[(at) as usize] = 1
        }
        return true
    }
    if ch == 59 || ch == 58 {
        // ; and the sub-parameter colon
        if tp_np[(i) as usize] + 1 < TP_NP {
            tp_np[(i) as usize] = tp_np[(i) as usize] + 1
        }
        return true
    }
    if ch == 63 {
        tp_priv[(i) as usize] = 1
        return true
    }
    if ch == 60 || ch == 61 || ch == 62 {
        tp_priv[(i) as usize] = 2
        return true
    }
    if ch >= 64 && ch <= 126 {
        // the final octet: the number of parameters is the one after the last `;`
        let np2: u64 = tp_np[(i) as usize]
        if tp_has[(i * TP_NP + np2) as usize] != 0 || np2 > 0 {
            tp_np[(i) as usize] = np2 + 1
        }
        tp_esc[(i) as usize] = 0
        term_csi(state, i, ch)
        return true
    }
    if ch == 27 {
        tp_esc[(i) as usize] = 1
        return true
    }
    if ch == 24 || ch == 26 {
        // CAN, SUB: the sequence is cancelled
        tp_esc[(i) as usize] = 0
        return true
    }
    if ch < 32 {
        // a control octet inside a sequence is carried out and the sequence goes on (ECMA-48)
        return false
    }
    // intermediate octets (space .. /): swallowed
    return true
}

fn term_putc(state: u64, i: u64, ch: u64) {
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    if cols == 0 || rows == 0 || i >= 32 {
        return
    }
    if ch < 256 && term_esc_take(state, i, ch) {
        return
    }
    // Ein Steuerzeichen beendet jede angefangene Folge: ein halb
    // gelesenes Zeichen ueber einen Zeilenumbruch hinweg gibt es
    // nicht, und ein haengengebliebenes Fuehrungsoktett wuerde das
    // NAECHSTE Zeichen verschlucken.
    if ch < 32 {
        tp_utf[(i) as usize] = 0
    }
    var cx: u64 = wg(state, i, W_CX)
    var cy: u64 = wg(state, i, W_CY)
    if ch == 13 {
        wsv(state, i, W_CX, 0)
        tp_wrap[(i) as usize] = 0
        return
    }
    if ch == 10 {
        wsv(state, i, W_CX, 0)
        tp_wrap[(i) as usize] = 0
        term_lf(state, i)
        return
    }
    if ch == 8 {
        tp_wrap[(i) as usize] = 0
        if cx > 0 {
            cx = cx - 1
            wsv(state, i, W_CX, cx)
            cell_set(state, i, cx, cy, 32)
            cell_attr_set(state, i, cx, cy, 0)
            cell_col_set(state, i, cx, cy, 0)
            cell_paint(state, i, cx, cy)
        }
        return
    }
    // 0x108: the WRAPPING backspace of the live line echo (tty ECHOWIN).
    // A plain 8 stops at the left edge; a line typed past the right edge
    // has to be wiped back into the row above.
    if ch == 0x108 {
        tp_wrap[(i) as usize] = 0
        if cx > 0 {
            cx = cx - 1
        } else if cy > 0 {
            cy = cy - 1
            cx = cols - 1
        } else {
            return
        }
        wsv(state, i, W_CX, cx)
        wsv(state, i, W_CY, cy)
        cell_set(state, i, cx, cy, 32)
        cell_attr_set(state, i, cx, cy, 0)
        cell_col_set(state, i, cx, cy, 0)
        cell_paint(state, i, cx, cy)
        return
    }
    if ch == 9 {
        var n: u64 = 8 - (cx & 7)
        while n > 0 {
            term_putc(state, i, 32)
            n = n - 1
        }
        return
    }
    // DER UTF-8-WEG. `z` ist die Zeichennummer, die in die Zelle geht.
    var z: u64 = ch
    if tp_utf[(i) as usize] != 0 {
        let lead: u64 = tp_utf[(i) as usize]
        tp_utf[(i) as usize] = 0
        if ch < 128 || ch > 191 {
            // Kein Folgeoktett: die angefangene Folge war Schrott.
            // Das Oktett hier wird trotzdem noch als sich selbst
            // versucht -- Schrott einmal zu melden ist genug.
            z = ch
        } else {
            z = (lead - 192) * 64 + (ch - 128)
            if z > 255 {
                z = 63 // '?' -- passt nicht in eine Zelle
            }
        }
    } else if ch >= 194 && ch <= 223 {
        tp_utf[(i) as usize] = ch
        return
    } else if ch >= 224 && ch <= 244 {
        // Drei oder vier Oktette: der Rest der Folge sind Folge-
        // oktette (80..BF), die unten von selbst durchfallen.
        z = 63
    } else if ch > 127 {
        return
    }
    // 0x7F..0x9F ist nicht druckbar (C1), 0xA0 ist ein Leerzeichen.
    if z < 32 || (z > 126 && z < 160) {
        return
    }
    // r462: THE WRAP IS DEFERRED. The character that fills the last column leaves the cursor there and only the NEXT printable
    // character moves to the next row (and scrolls when that row is below the region). Before, the 80th character of a row
    // scrolled the screen at once, and an editor that fills its last row (the help line) pushed its whole screen up by one row.
    if tp_wrap[(i) as usize] != 0 {
        tp_wrap[(i) as usize] = 0
        wsv(state, i, W_CX, 0)
        term_lf(state, i)
        cx = 0
        cy = wg(state, i, W_CY)
    }
    cell_set(state, i, cx, cy, z)
    cell_attr_set(state, i, cx, cy, tp_attr[(i) as usize])
    cell_col_set(state, i, cx, cy, tp_col[(i) as usize])
    cell_paint(state, i, cx, cy)
    if cx + 1 >= cols {
        if tp_nowrap[(i) as usize] == 0 {
            tp_wrap[(i) as usize] = 1
        }
        wsv(state, i, W_CX, cols - 1)
    } else {
        wsv(state, i, W_CX, cx + 1)
    }
}

fn term_write(state: u64, i: u64, p: u64, n: u64) -> u64 {
    if !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return 0
    }
    sb_snap(state, i)
    tsel_clear(state, i)
    tcur_off(state, i)
    var k: u64 = 0
    while k < n {
        term_putc(state, i, kstate.get8(p + k))
        k = k + 1
    }
    tcur_solid(state)
    tcur_sync(state, i)
    damage_win(state, i)
    return n
}

// ------------------------------------------------------------ Zusagen

// Ein Terminalfenster an ein Terminal binden. Von da an geht `tty.emit`
// mit SINK_WINDOW hierher.
fn bind_tty(state: u64, i: u64, t: u64) {
    if !valid(state, i) {
        return
    }
    wsv(state, i, W_TTY, t + 1)
}

fn tty_of(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return NO_TTY
    }
    let t: u64 = wg(state, i, W_TTY)
    if t == 0 {
        return NO_TTY
    }
    return t - 1
}

// An WELCHES Terminal eine Taste geht: an das des Fensters mit dem
// Eingabefokus, wenn das ein Terminalfenster ist -- sonst an gar keines.
// Das ist die eine Zeile, die aus einem Bildschirm eine BEDIENBARE
// Oberflaeche macht.
// Shift+PageUp / Shift+PageDown on a focused terminal window: one page (rows - 1 lines) through the history. True: the
// key was consumed (kbd.fi then does not send it to the shell).
fn term_page(state: u64, up: bool) -> bool {
    if !ready(state) {
        return false
    }
    let f: u64 = focus(state)
    if f >= MAX_WIN || wg(state, f, W_KIND) != K_TERM || !darf(state, f) {
        return false
    }
    var page: i64 = (wg(state, f, W_ROWS) as i64) - 1
    if page < 1 {
        page = 1
    }
    if up {
        sb_move(state, f, page)
    } else {
        sb_move(state, f, 0 - page)
    }
    return true
}

fn key_tty(state: u64) -> u64 {
    if !ready(state) {
        return NO_TTY
    }
    // RUNDE WMPLUGIN: hat gerade ein Plugin diese Taste bekommen, geht
    // sie an KEIN Terminal. Der Merker gilt fuer genau eine Taste und
    // wird hier geloescht -- er darf nicht die naechste mitnehmen.
    if gs(state, S_KSWAL) != 0 {
        ss(state, S_KSWAL, 0)
        return NO_TTY
    }
    let f: u64 = focus(state)
    if f >= MAX_WIN || wg(state, f, W_KIND) != K_TERM {
        return NO_TTY
    }
    // WHILE THE SCREEN IS LOCKED (sign-in screen included) THE KEY
    // BELONGS TO THE LOCKER ONLY. `on_key` already sends it there and
    // nowhere else -- but this path asked only for the focus, so the
    // terminal that had the focus before the lock got every key too:
    // on the Dell (27.09.2026) the password typed at sign-in showed up
    // as `sh: cannot run startkennwort` in the terminal behind it.
    if !darf(state, f) {
        return NO_TTY
    }
    sb_snap(state, f)
    return tty_of(state, f)
}

// EIN Oktett in ein Terminalfenster. Der Weg von `tty.emit`.
fn term_out(state: u64, i: u64, c: u64) {
    ss(state, S_TOUT, gs(state, S_TOUT) + 1)
    if !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return
    }
    ss(state, S_TPUT, gs(state, S_TPUT) + 1)
    sb_snap(state, i)
    tsel_clear(state, i)
    tcur_off(state, i)
    term_putc(state, i, c)
    tcur_solid(state)
    tcur_sync(state, i)
    if term_hold_n != 0 {
        term_hold_mask = term_hold_mask | (1 << i)
        return
    }
    damage_win(state, i)
}

static mut term_hold_n: u64 = 0
static mut term_hold_mask: u64 = 0

fn term_hold(state: u64) {
    __atomic_add((&term_hold_n) as *mut u64, 1 as u64)
}

fn term_release(state: u64) {
    if term_hold_n == 0 {
        return
    }
    __atomic_add((&term_hold_n) as *mut u64, 0 -% 1)
    if term_hold_n != 0 {
        return
    }
    let m: u64 = term_hold_mask
    term_hold_mask = 0
    var i: u64 = 0
    while i < MAX_WIN {
        if ((m >> i) & 1) != 0 && valid(state, i) {
            damage_win(state, i)
        }
        i = i + 1
    }
}

// Die zwei Zaehler nach aussen, fuer die Tafel und die Abnahme.
fn term_outs(state: u64) -> u64 {
    return gs(state, S_TOUT)
}

fn term_puts_n(state: u64) -> u64 {
    return gs(state, S_TPUT)
}

fn diag1(state: u64) -> u64 {
    return gs(state, S_DIAG1)
}
fn diag2(state: u64) -> u64 {
    return gs(state, S_DIAG2)
}
fn failbits(state: u64) -> u64 {
    return gs(state, S_FAIL)
}
fn pass_ok(state: u64, nr: u64) {
    ss(state, S_FAIL, gs(state, S_FAIL) & ~(1 << nr))
}
fn selftest(state: u64) -> u64 {
    // Siehe `fokus_still`: der Selbsttest laeuft mitten in einer Zeile,
    // die `kgui` schreibt.
    fokus_still = 1
    if !ready(state) {
        return 0
    }
    var n: u64 = 0
    ss(state, S_FAIL, 0x7FFFFFFE)
    var t1: [u8; 5] = "eins\0"
    var t2: [u8; 5] = "zwei\0"
    // 1. Ein Fenster entsteht und hat eine Flaeche.
    let a: u64 = create(state, 0, 40, 40, 200, 100, K_RAW, (&t1[0]) as u64)
    if a < MAX_WIN && win_buf(state, a) != 0 {
        n = n + 1
        pass_ok(state, 1)
    }
    // 2. Ein zweites liegt DARUEBER -- die Stapelreihenfolge waechst.
    let b: u64 = create(state, 0, 100, 70, 200, 100, K_RAW, (&t2[0]) as u64)
    if b < MAX_WIN && win_z(state, b) > win_z(state, a) {
        n = n + 1
        pass_ok(state, 2)
    }
    // 3. Der Treffer an einer Stelle, an der sich beide ueberschneiden,
    //    ist das OBERE. Das ist die ganze Stapelreihenfolge in einer
    //    Zeile.
    if hit(state, 150, 100) == b {
        n = n + 1
        pass_ok(state, 3)
    }
    // 4. ... und daneben das untere.
    if hit(state, 50, 60) == a {
        n = n + 1
        pass_ok(state, 4)
    }
    // 5. Der Hintergrund ist kein Fenster.
    if hit(state, 700, 500) == MAX_WIN {
        n = n + 1
        pass_ok(state, 5)
    }
    // 6. Heben aendert die Reihenfolge wirklich.
    raise_win(state, a)
    if hit(state, 150, 100) == a && win_z(state, a) > win_z(state, b) {
        n = n + 1
        pass_ok(state, 6)
    }
    // 7. Der Fokus liegt bei genau EINEM Fenster.
    set_focus(state, b)
    if focus(state) == b {
        n = n + 1
        pass_ok(state, 7)
    }
    // 8. Eine Taste kommt beim Fenster mit dem Fokus an -- und NUR
    //    dort. Das ist die Zusage, die `nofocus` zum Einsturz bringt.
    let va: u64 = ev_waiting(state, a)
    let vb: u64 = ev_waiting(state, b)
    on_key(state, 0x41)
    if gs(state, S_NOFOCUS) == 0 {
        if ev_waiting(state, b) == vb + 1 && ev_waiting(state, a) == va {
            n = n + 1
            pass_ok(state, 8)
        }
    } else {
        if ev_waiting(state, b) == vb + 1 && ev_waiting(state, a) == va + 1 {
            n = n + 1
            pass_ok(state, 9)
        }
    }
    // 9. Und das Ereignis traegt das Zeichen, das gedrueckt wurde.
    var aus: [u8; 16] = [0 as u8; 16]
    var gefunden: bool = false
    while ev_pop(state, b, (&aus[0]) as u64) {
        if kstate.get(((&aus[0]) as u64), 0) == E_KEY {
            if (kstate.get(((&aus[0]) as u64), 8) >> 32) == 0x41 {
                gefunden = true
            }
        }
    }
    if gefunden {
        n = n + 1
        pass_ok(state, 10)
    }
    // 10. Das Malen bleibt IM Fenster: ein Bildpunkt jenseits der Kante
    //     wird nicht geschrieben, und der letzte darin schon.
    fill(state, a, 0, 0, 200, 100, 0)
    wpixel(state, a, 199, 99, PROBE_IN)
    wpixel(state, a, 200, 99, PROBE_OUT)
    if wget(state, a, 199, 99) == PROBE_IN && wget(state, a, 0, 0) == 0 {
        n = n + 1
        pass_ok(state, 11)
    }
    // 11. Verschieben aendert die Stelle, nicht den Inhalt.
    move_win(state, a, 300, 200)
    if win_x(state, a) == 300 && wget(state, a, 199, 99) == PROBE_IN {
        n = n + 1
        pass_ok(state, 12)
    }
    // 12. Der schmutzige Bereich deckt beide Stellen -- die alte und
    //     die neue. Ohne das bliebe ein Fenstergespenst stehen.
    if gs(state, S_NODIRTY) == 0 {
        if dirty_x0(state) <= 40 && dirty_x1(state) >= 300 {
            n = n + 1
            pass_ok(state, 13)
        }
    } else {
        if dirty_x0(state) == 0 && dirty_x1(state) == gs(state, S_SW) {
            n = n + 1
            pass_ok(state, 14)
        }
    }
    // 13. Ein Terminalfenster hat ein Raster, und ein Zeichen landet in
    //     der Zelle, in der es landen soll.
    var t3: [u8; 5] = "term\0"
    // RUNDE SCHIRM: die Groesse in ZELLEN, nicht in Bildpunkten. Bei
    // doppelter Oberflaechenschrift ist eine Zelle 20x38 statt 10x19,
    // und ein starres 200x100-Fenster hatte nur noch zwei Zeilen --
    // der Test schlug fehl, obwohl das Raster stimmte.
    let t: u64 = create(state, 0, 10, 300, 200 * uisc(state),
        100 * uisc(state), K_TERM,
        (&t3[0]) as u64)
    if t < MAX_WIN && term_cols(state, t) > 4 && term_rows(state, t) > 2 {
        n = n + 1
        pass_ok(state, 15)
    }
    // 14. Zeilenvorschub und Umbruch bewegen die Schreibmarke.
    if t < MAX_WIN {
        var txt: [u8; 5] = "ab\nc\0"
        term_write(state, t, (&txt[0]) as u64, 4)
        if term_cx(state, t) == 1 && term_cy(state, t) == 1 {
            n = n + 1
            pass_ok(state, 16)
        }
    }
    // 15. Schliessen gibt den Platz frei und schliesst die Luecke in der
    //     Stapelreihenfolge.
    let vorher: u64 = count(state)
    destroy(state, b)
    if count(state) == vorher - 1 && !valid(state, b) {
        var luecke: bool = false
        var z: u64 = 0
        while z < count(state) {
            if at_z(state, z) >= MAX_WIN {
                luecke = true
            }
            z = z + 1
        }
        if !luecke {
            n = n + 1
            pass_ok(state, 17)
        }
    }
    // 16. GROESSE AENDERN. Der Puffer wurde beim Anlegen fuer die
    //     angefragte Flaeche geholt; kleiner geht immer, groesser nur
    //     bis dorthin. Ein Fenster, das ueber seinen eigenen Puffer
    //     hinauswaechst, waere ein Schreibzugriff daneben -- und der
    //     faellt erst auf, wenn er etwas Wichtiges trifft.
    if resize_win(state, a, 120, 60) && win_w(state, a) == 120 {
        if !resize_win(state, a, 4096, 4096) && win_w(state, a) == 120 {
            n = n + 1
            pass_ok(state, 18)
        }
    }
    // 17. Und ein Terminalfenster rechnet sein Raster dabei NEU.
    if t < MAX_WIN {
        let vorher_cols: u64 = term_cols(state, t)
        if resize_win(state, t, 100, 60) {
            if term_cols(state, t) < vorher_cols && term_cols(state, t) > 0 {
                n = n + 1
                pass_ok(state, 19)
            }
        }
    }
    if t < MAX_WIN {
        destroy(state, t)
    }
    // ---------------------------------------------- RUNDE DESKTOP
    // 18. Ein Fenster der Ebene L_DESK liegt UNTER einem gewoehnlichen,
    //     obwohl es SPAETER angelegt wurde. Ohne Ebenen ist das
    //     unmoeglich, und genau das stand in Logbuch K15.
    var td: [u8; 6] = "tisch\0"
    let d: u64 = create(state, 0, 0, 0, 320, 200, K_RAW, (&td[0]) as u64)
    if d < MAX_WIN {
        set_layer(state, d, L_DESK)
        if win_z(state, d) < win_z(state, a) {
            n = n + 1
            pass_ok(state, 20)
        }
        // 19. Und ein Klick darauf hebt ihn NICHT ueber das andere.
        raise_win(state, d)
        if win_z(state, d) < win_z(state, a) || gs(state, S_NOLAYER) != 0 {
            n = n + 1
            pass_ok(state, 21)
        }
        // 20. Verbergen nimmt ein Fenster aus der Trefferpruefung --
        //     und Wiederherstellen bringt es zurueck. Der Puffer bleibt
        //     dabei derselbe: minimiert ist nicht geschlossen.
        let puf: u64 = win_buf(state, a)
        let vorher: u64 = hit(state, 60, 60)
        set_hidden(state, a, true)
        let nachher: u64 = hit(state, 60, 60)
        set_hidden(state, a, false)
        if gs(state, S_NOMIN) == 0 {
            if vorher == a && nachher != a && win_buf(state, a) == puf {
                n = n + 1
                pass_ok(state, 22)
            }
        } else {
            if vorher == a && nachher == a {
                n = n + 1
                pass_ok(state, 23)
            }
        }
        // 21. Ohne Schmuck ist das aeussere Rechteck die Malflaeche --
        //     keine Titelleiste, kein Rahmen.
        set_deco(state, d, false)
        if outer_w(state, d) == win_w(state, d)
            && outer_h(state, d) == win_h(state, d) && iny(state, d) == 0 {
            n = n + 1
            pass_ok(state, 24)
        }
        destroy(state, d)
    }
    // -------------------------------- ADDENDUM TASKBAR: struts and work
    // `bar` plays the taskbar, `mw` is the window that gets maximized.
    // A WINDOW OF ITS OWN AND NOT `a`, and the reason is a measurement:
    // `a` was created 200 x 100, a window never gets a bigger buffer
    // than it was created with, and `maximize` therefore refused it --
    // correctly. Five of these nine claims failed on that, and the
    // server was right every time.
    var tb: [u8; 4] = "bar\0"
    var tm: [u8; 4] = "max\0"
    let sw2: u64 = gs(state, S_SW)
    let sh2: u64 = gs(state, S_SH)
    // THIS SECTION MEASURES THE STRUTS AND THEREFORE HAS TO SWITCH THEM
    // ON, even when the machine was started with the counter-test
    // `nostrut`. It puts the setting back afterwards -- the first
    // version did not, and left the whole system with the struts
    // enabled after a `nostrut` run, so the counter-test proved nothing
    // and looked like it passed.
    let strut_was: bool = nostrut(state)
    set_nostrut(state, false)
    // 22. WITHOUT A STRUT THE WORK AREA IS THE SCREEN. Anything else
    //     and every number after this one measures the wrong rectangle.
    if work_x(state) == 0 && work_y(state) == 0
        && work_w(state) == sw2 && work_h(state) == sh2 {
        n = n + 1
        pass_ok(state, 25)
    }
    let bar: u64 = create(state, 0, 0, (sh2 - 28) as i64, sw2, 28, K_RAW,
        (&tb[0]) as u64)
    if bar < MAX_WIN {
        set_deco(state, bar, false)
        // 23. A BOTTOM STRUT OF 28 TAKES 28 ROWS OFF THE BOTTOM -- and
        //     off the bottom only. The origin does not move.
        let s23: bool = set_strut(state, bar, EDGE_BOTTOM, 28)
        if s23 && work_x(state) == 0 && work_y(state) == 0
            && work_w(state) == sw2 && work_h(state) == sh2 - 28 {
            n = n + 1
            pass_ok(state, 26)
        }
        // 24. MAXIMIZE FILLS THE WORK AREA, NOT THE SCREEN. Compared on
        //     the OUTER rectangle, because that is what covers pixels.
        let mw: u64 = create(state, 0, 40, 40, max_w(state), max_h(state),
            K_RAW,
            (&tm[0]) as u64)
        ss(state, S_DIAG1, mw)
        ss(state, S_DIAG2, 0)
        if mw < MAX_WIN {
            if maximize(state, mw, true) {
                ss(state, S_DIAG2, 1)
            }
        }
        if mw < MAX_WIN && gs(state, S_DIAG2) == 1 {
            let ox: i64 = win_x(state, mw)
            let oy: i64 = win_y(state, mw)
            let ow: u64 = outer_w(state, mw)
            let oh: u64 = outer_h(state, mw)
            if ox == work_x(state) as i64 && oy == work_y(state) as i64
                && ow == work_w(state) && oh == work_h(state) {
                n = n + 1
                pass_ok(state, 27)
            }
            // 25. AND IT DOES NOT TOUCH THE BAR. The two rectangles are
            //     disjoint: the bottom of the window is at or above the
            //     top of the bar. This is the claim of the whole
            //     addendum, and it is one comparison.
            if oy + oh as i64 <= win_y(state, bar) {
                n = n + 1
                pass_ok(state, 28)
            }
        }
        // 26. THE BAR MOVES TO THE LEFT EDGE AND THE WINDOW FOLLOWS.
        //     Nobody calls `maximize` again -- `set_strut` refits.
        move_win(state, bar, 0, 0)
        let s26: bool = resize_win(state, bar, 44, sh2)
        let _u26: bool = s26
        if set_strut(state, bar, EDGE_LEFT, 44) {
            if work_x(state) == 44 && work_y(state) == 0
                && work_w(state) == sw2 - 44 && work_h(state) == sh2 {
                n = n + 1
                pass_ok(state, 29)
            }
            if win_x(state, mw) == 44 && outer_w(state, mw) == sw2 - 44
                && outer_h(state, mw) == sh2 {
                n = n + 1
                pass_ok(state, 30)
            }
        }
        // 27. THE COUNTER-TEST: with `nostrut` the work area is the
        //     whole screen again and the maximized window covers the
        //     bar. That is the state this addendum removes.
        set_nostrut(state, true)
        let deckt: bool = win_x(state, mw) == 0
            && outer_w(state, mw) == sw2
        set_nostrut(state, false)
        if deckt && win_x(state, mw) == 44 {
            n = n + 1
            pass_ok(state, 31)
        }
        // 28. CLEARING THE STRUT GIVES THE EDGE BACK.
        let _s28: bool = set_strut(state, bar, EDGE_LEFT, 0)
        if work_x(state) == 0 && work_w(state) == sw2 {
            n = n + 1
            pass_ok(state, 32)
        }
        // 29. AND SO DOES DYING. Set it once more, then destroy.
        let _s29: bool = set_strut(state, bar, EDGE_TOP, 30)
        let vorher: u64 = work_y(state)
        destroy(state, bar)
        if vorher == 30 && work_y(state) == 0 && work_h(state) == sh2 {
            n = n + 1
            pass_ok(state, 33)
        }
        // 30. RESTORING PUTS THE WINDOW BACK WHERE IT WAS: it was
        //     created at (40, 40) with the full screen and has been
        //     maximized to two different work areas since.
        let _m30: bool = maximize(state, mw, false)
        if win_x(state, mw) == 40 && win_y(state, mw) == 40
            && win_w(state, mw) == max_w(state)
            && win_h(state, mw) == max_h(state)
            && !is_max(state, mw) {
            n = n + 1
            pass_ok(state, 34)
        }
        if mw < MAX_WIN {
            destroy(state, mw)
        }
    }
    destroy(state, a)
    set_nostrut(state, strut_was)
    damage_all(state)
    // Und die Fokusmeldung wieder an -- sie ist der Beleg fuer Alt+Tab
    // und darf nach dem Selbsttest nicht stumm bleiben.
    fokus_still = 0
    return n
}

// r400: the VT subset of the terminal, checked on a window of its own. Seven checks, a separate
// count (`wm: vttest n / m`) so that `selftest 30 / 30` stays what the other runs expect.
fn vt_feed(state: u64, t: u64, a: u64, n: u64) {
    term_write(state, t, a, n)
}

fn vt_selftest(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    fokus_still = 1
    // the window of this test must not take an id away from the windows of the machine: the runs
    // that name the boot terminal by its id (`id=7`) must find it where it always was
    let nid0: u64 = gs(state, S_NEXTID)
    var tt: [u8; 3] = "vt\0"
    let t: u64 = create(state, 0, 10, 300, 200 * uisc(state),
        160 * uisc(state), K_TERM, (&tt[0]) as u64)
    if t >= MAX_WIN || term_cols(state, t) < 12 || term_rows(state, t) < 4 {
        if t < MAX_WIN {
            destroy(state, t)
        }
        ss(state, S_NEXTID, nid0)
        fokus_still = 0
        return 0
    }
    var n: u64 = 0
    var clr: [u8; 16] = [27 as u8, 91 as u8, 50 as u8, 74 as u8, 27 as u8, 91 as u8, 72 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    // 1. ESC[3;5H X: the cell (4, 2) holds X and the cursor stands behind it
    vt_feed(state, t, (&clr[0]) as u64, 7)
    var a1: [u8; 16] = [27 as u8, 91 as u8, 51 as u8, 59 as u8, 53 as u8, 72 as u8, 88 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&a1[0]) as u64, 7)
    if cell_get(state, t, 4, 2) == 88 && term_cx(state, t) == 5 && term_cy(state, t) == 2 {
        n = n + 1
    }
    // 2. "hello", ESC[1;3H, ESC[K: "he" stays, the rest of the row is blank
    vt_feed(state, t, (&clr[0]) as u64, 7)
    var a2: [u8; 16] = [104 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8, 27 as u8, 91 as u8,
        49 as u8, 59 as u8, 51 as u8, 72 as u8, 27 as u8, 91 as u8, 75 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&a2[0]) as u64, 14)
    if cell_get(state, t, 0, 0) == 104 && cell_get(state, t, 1, 0) == 101
        && cell_get(state, t, 2, 0) == 32 && cell_get(state, t, 4, 0) == 32 {
        n = n + 1
    }
    // 3. ESC[7m R ESC[m N: the first cell is reverse, the second is plain
    vt_feed(state, t, (&clr[0]) as u64, 7)
    var a3: [u8; 16] = [27 as u8, 91 as u8, 55 as u8, 109 as u8, 82 as u8, 27 as u8, 91 as u8,
        109 as u8, 78 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&a3[0]) as u64, 9)
    if cell_get(state, t, 0, 0) == 82 && cell_attr(state, t, 0, 0) == 1
        && cell_get(state, t, 1, 0) == 78 && cell_attr(state, t, 1, 0) == 0 {
        n = n + 1
    }
    // 4. ESC[2J clears the cells and the attributes
    vt_feed(state, t, (&clr[0]) as u64, 7)
    if cell_get(state, t, 0, 0) == 32 && cell_attr(state, t, 0, 0) == 0
        && cell_get(state, t, 4, 2) == 32 && term_cx(state, t) == 0 && term_cy(state, t) == 0 {
        n = n + 1
    }
    // 5. ESC[?25l is swallowed: Z lands in the first cell, no "25l" in the row
    var a5: [u8; 16] = [27 as u8, 91 as u8, 63 as u8, 50 as u8, 53 as u8, 108 as u8, 90 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&a5[0]) as u64, 7)
    if cell_get(state, t, 0, 0) == 90 && cell_get(state, t, 1, 0) == 32 {
        n = n + 1
    }
    // 6. a sequence cut in two writes: ESC | [1;1H Q
    vt_feed(state, t, (&clr[0]) as u64, 7)
    var a6: [u8; 16] = [27 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    var a6b: [u8; 16] = [91 as u8, 50 as u8, 59 as u8, 50 as u8, 72 as u8, 81 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&a6[0]) as u64, 1)
    vt_feed(state, t, (&a6b[0]) as u64, 6)
    if cell_get(state, t, 1, 1) == 81 {
        n = n + 1
    }
    // 7. an unknown sequence (ESC[5;6;7q) is dropped whole, W stays
    vt_feed(state, t, (&clr[0]) as u64, 7)
    var a7: [u8; 16] = [27 as u8, 91 as u8, 53 as u8, 59 as u8, 54 as u8, 59 as u8, 55 as u8,
        113 as u8, 87 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&a7[0]) as u64, 9)
    if cell_get(state, t, 0, 0) == 87 && cell_get(state, t, 1, 0) == 32 {
        n = n + 1
    }
    // the machine is left plain (the VT state is global, like the UTF-8 one)
    var rs: [u8; 16] = [27 as u8, 91 as u8, 109 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&rs[0]) as u64, 3)
    destroy(state, t)
    ss(state, S_NEXTID, nid0)
    fokus_still = 0
    return n
}

fn vt_selftest_max() -> u64 {
    return 7
}

// r462: the VT subset, the rest of it. `|` stands for ESC, `~` for BEL, `^` for LF, `$` for a backslash in the strings of the cases:
// the placeholders keep the strings readable. Each case starts with ESC c (full reset) and ends in a check of cells, attributes,
// colours and cursor. A separate count (`wm: vttest2 n / m`), like `vttest`.
fn vt_str(state: u64, t: u64, p: u64) {
    var k: u64 = 0
    while kstate.get8(p + k) != 0 {
        var b: u64 = kstate.get8(p + k)
        if b == 124 {
            b = 27
        } else if b == 126 {
            b = 7
        } else if b == 94 {
            b = 10
        } else if b == 36 {
            b = 92
        }
        term_write_one(state, t, b)
        k = k + 1
    }
}

fn term_write_one(state: u64, t: u64, b: u64) {
    term_putc(state, t, b)
}

fn vt2_selftest(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    fokus_still = 1
    let nid0: u64 = gs(state, S_NEXTID)
    var tt: [u8; 4] = "vt2\0"
    let t: u64 = create(state, 0, 10, 300, 240 * uisc(state), 180 * uisc(state), K_TERM, (&tt[0]) as u64)
    if t >= MAX_WIN || term_cols(state, t) < 16 || term_rows(state, t) < 6 {
        if t < MAX_WIN {
            destroy(state, t)
        }
        ss(state, S_NEXTID, nid0)
        fokus_still = 0
        return 0
    }
    let COLS: u64 = term_cols(state, t)
    let ROWS: u64 = term_rows(state, t)
    var n: u64 = 0
    // 1. cursor up / forward: CSI 5;5H, 2A, 3C
    var v0: [u8; 17] = "|c|[5;5H|[2A|[3C\0"
    vt_str(state, t, (&v0[0]) as u64)
    if term_cx(state, t) == 7 && term_cy(state, t) == 2 {
        n = n + 1
    }
    // 2. cursor down / back: 2B, 4D
    var v1: [u8; 25] = "|c|[5;5H|[2A|[3C|[2B|[4D\0"
    vt_str(state, t, (&v1[0]) as u64)
    if term_cx(state, t) == 3 && term_cy(state, t) == 4 {
        n = n + 1
    }
    // 3. CHA and VPA: 10G, 3d
    var v2: [u8; 12] = "|c|[10G|[3d\0"
    vt_str(state, t, (&v2[0]) as u64)
    if term_cx(state, t) == 9 && term_cy(state, t) == 2 {
        n = n + 1
    }
    // 4. EL 1: erase from the start of the row to the cursor
    var v3: [u8; 24] = "|c|[1;1HXXXXX|[1;3H|[1K\0"
    vt_str(state, t, (&v3[0]) as u64)
    if cell_get(state, t, 0, 0) == 32 && cell_get(state, t, 1, 0) == 32 && cell_get(state, t, 2, 0) == 32 && cell_get(state, t, 3, 0) == 88 && cell_get(state, t, 4, 0) == 88 {
        n = n + 1
    }
    // 5. EL 0: erase from the cursor to the end of the row
    var v4: [u8; 24] = "|c|[1;1HXXXXX|[1;3H|[0K\0"
    vt_str(state, t, (&v4[0]) as u64)
    if cell_get(state, t, 1, 0) == 88 && cell_get(state, t, 2, 0) == 32 && cell_get(state, t, 4, 0) == 32 {
        n = n + 1
    }
    // 6. ED 0: erase from the cursor to the end of the screen
    var v5: [u8; 46] = "|c|[1;1HXXXXX|[2;1HYYYYY|[3;1HZZZZZ|[2;3H|[0J\0"
    vt_str(state, t, (&v5[0]) as u64)
    if cell_get(state, t, 0, 0) == 88 && cell_get(state, t, 1, 1) == 89 && cell_get(state, t, 2, 1) == 32 && cell_get(state, t, 0, 2) == 32 {
        n = n + 1
    }
    // 7. ED 1: erase from the start of the screen to the cursor
    var v6: [u8; 35] = "|c|[1;1HXXXXX|[2;1HYYYYY|[2;3H|[1J\0"
    vt_str(state, t, (&v6[0]) as u64)
    if cell_get(state, t, 0, 0) == 32 && cell_get(state, t, 0, 1) == 32 && cell_get(state, t, 2, 1) == 32 && cell_get(state, t, 3, 1) == 89 {
        n = n + 1
    }
    // 8. ECH: erase two characters
    var v7: [u8; 24] = "|c|[1;1HABCDE|[1;2H|[2X\0"
    vt_str(state, t, (&v7[0]) as u64)
    if cell_get(state, t, 0, 0) == 65 && cell_get(state, t, 1, 0) == 32 && cell_get(state, t, 2, 0) == 32 && cell_get(state, t, 3, 0) == 68 {
        n = n + 1
    }
    // 9. ICH: insert two blanks, the rest moves right
    var v8: [u8; 24] = "|c|[1;1HABCDE|[1;2H|[2@\0"
    vt_str(state, t, (&v8[0]) as u64)
    if cell_get(state, t, 0, 0) == 65 && cell_get(state, t, 1, 0) == 32 && cell_get(state, t, 2, 0) == 32 && cell_get(state, t, 3, 0) == 66 && cell_get(state, t, 6, 0) == 69 {
        n = n + 1
    }
    // 10. DCH: delete two characters, the rest moves left
    var v9: [u8; 24] = "|c|[1;1HABCDE|[1;2H|[2P\0"
    vt_str(state, t, (&v9[0]) as u64)
    if cell_get(state, t, 0, 0) == 65 && cell_get(state, t, 1, 0) == 68 && cell_get(state, t, 2, 0) == 69 && cell_get(state, t, 3, 0) == 32 {
        n = n + 1
    }
    // 11. IL: a blank row at the cursor, the rows below move down
    var v10: [u8; 40] = "|c|[1;1H1|[2;1H2|[3;1H3|[4;1H4|[2;1H|[L\0"
    vt_str(state, t, (&v10[0]) as u64)
    if cell_get(state, t, 0, 0) == 49 && cell_get(state, t, 0, 1) == 32 && cell_get(state, t, 0, 2) == 50 && cell_get(state, t, 0, 3) == 51 && cell_get(state, t, 0, 4) == 52 && term_cx(state, t) == 0 && term_cy(state, t) == 1 {
        n = n + 1
    }
    // 12. DL: the row at the cursor goes, the rows below move up
    var v11: [u8; 40] = "|c|[1;1H1|[2;1H2|[3;1H3|[4;1H4|[2;1H|[M\0"
    vt_str(state, t, (&v11[0]) as u64)
    if cell_get(state, t, 0, 0) == 49 && cell_get(state, t, 0, 1) == 51 && cell_get(state, t, 0, 2) == 52 && cell_get(state, t, 0, 3) == 32 {
        n = n + 1
    }
    // 13. scroll region 2..4: a line feed on its last row scrolls the region only
    var v12: [u8; 51] = "|c|[1;1HA|[2;1HB|[3;1HC|[4;1HD|[5;1HE|[2;4r|[4;1H^\0"
    vt_str(state, t, (&v12[0]) as u64)
    if cell_get(state, t, 0, 0) == 65 && cell_get(state, t, 0, 1) == 67 && cell_get(state, t, 0, 2) == 68 && cell_get(state, t, 0, 3) == 32 && cell_get(state, t, 0, 4) == 69 {
        n = n + 1
    }
    // 14. reverse index on the first row of the region scrolls it down
    var v13: [u8; 52] = "|c|[1;1HA|[2;1HB|[3;1HC|[4;1HD|[5;1HE|[2;4r|[2;1H|M\0"
    vt_str(state, t, (&v13[0]) as u64)
    if cell_get(state, t, 0, 0) == 65 && cell_get(state, t, 0, 1) == 32 && cell_get(state, t, 0, 2) == 66 && cell_get(state, t, 0, 3) == 67 && cell_get(state, t, 0, 4) == 69 {
        n = n + 1
    }
    // 15. SU: the screen scrolls up one row
    var v14: [u8; 21] = "|c|[1;1HA|[2;1HB|[1S\0"
    vt_str(state, t, (&v14[0]) as u64)
    if cell_get(state, t, 0, 0) == 66 && cell_get(state, t, 0, 1) == 32 {
        n = n + 1
    }
    // 16. SD: the screen scrolls down one row
    var v15: [u8; 21] = "|c|[1;1HA|[2;1HB|[1T\0"
    vt_str(state, t, (&v15[0]) as u64)
    if cell_get(state, t, 0, 0) == 32 && cell_get(state, t, 0, 1) == 65 && cell_get(state, t, 0, 2) == 66 {
        n = n + 1
    }
    // 17. SGR colours, bold, reset
    var v16: [u8; 22] = "|c|[31mR|[42;1mG|[0mN\0"
    vt_str(state, t, (&v16[0]) as u64)
    if cell_col(state, t, 0, 0) == 2 && cell_col(state, t, 1, 0) == 50 && (cell_attr(state, t, 1, 0) & 2) == 2 && cell_col(state, t, 2, 0) == 0 && cell_attr(state, t, 2, 0) == 0 {
        n = n + 1
    }
    // 18. SGR reverse and underline, and their off codes
    var v17: [u8; 25] = "|c|[7mR|[27mN|[4mU|[24mV\0"
    vt_str(state, t, (&v17[0]) as u64)
    if cell_attr(state, t, 0, 0) == 1 && cell_attr(state, t, 1, 0) == 0 && cell_attr(state, t, 2, 0) == 4 && cell_attr(state, t, 3, 0) == 0 {
        n = n + 1
    }
    // 19. SGR 38;5;9 is bright red, 38;2 is dropped
    var v18: [u8; 34] = "|c|[38;5;9mB|[0m|[38;2;10;20;30mQ\0"
    vt_str(state, t, (&v18[0]) as u64)
    if cell_col(state, t, 0, 0) == 2 && (cell_attr(state, t, 0, 0) & 8) == 8 && cell_get(state, t, 1, 0) == 81 && cell_col(state, t, 1, 0) == 0 {
        n = n + 1
    }
    // 20. save and restore the cursor: ESC 7 / ESC 8
    var v19: [u8; 19] = "|c|[3;4H|7|[1;1H|8\0"
    vt_str(state, t, (&v19[0]) as u64)
    if term_cx(state, t) == 3 && term_cy(state, t) == 2 {
        n = n + 1
    }
    // 21. save and restore the cursor: CSI s / CSI u
    var v20: [u8; 21] = "|c|[3;4H|[s|[1;1H|[u\0"
    vt_str(state, t, (&v20[0]) as u64)
    if term_cx(state, t) == 3 && term_cy(state, t) == 2 {
        n = n + 1
    }
    // 22. alternate screen: the main screen and the cursor come back
    var v21: [u8; 38] = "|c|[1;1HMAIN|[2;5H|[?1049hALT|[?1049l\0"
    vt_str(state, t, (&v21[0]) as u64)
    if cell_get(state, t, 0, 0) == 77 && cell_get(state, t, 3, 0) == 78 && cell_get(state, t, 1, 0) == 65 && term_cx(state, t) == 4 && term_cy(state, t) == 1 {
        n = n + 1
    }
    // 23. OSC up to BEL is swallowed (the window title is no text)
    var v22: [u8; 16] = "|c|]0;a title~Z\0"
    vt_str(state, t, (&v22[0]) as u64)
    if cell_get(state, t, 0, 0) == 90 && cell_get(state, t, 1, 0) == 32 {
        n = n + 1
    }
    // 24. OSC up to ESC backslash is swallowed
    var v23: [u8; 11] = "|c|]2;t|$Z\0"
    vt_str(state, t, (&v23[0]) as u64)
    if cell_get(state, t, 0, 0) == 90 && cell_get(state, t, 1, 0) == 32 {
        n = n + 1
    }
    // 25. unknown sequences are dropped whole, ESC ( B takes its octet
    var v24: [u8; 28] = "|c|[?2004h|[>c|[5;6;7qW|(BV\0"
    vt_str(state, t, (&v24[0]) as u64)
    if cell_get(state, t, 0, 0) == 87 && cell_get(state, t, 1, 0) == 86 && cell_get(state, t, 2, 0) == 32 {
        n = n + 1
    }
    // 26. a cursor position beyond the screen is clamped
    var v25: [u8; 13] = "|c|[999;999H\0"
    vt_str(state, t, (&v25[0]) as u64)
    if term_cx(state, t) == COLS - 1 && term_cy(state, t) == ROWS - 1 {
        n = n + 1
    }
    // 27. CNL: next line, column 1
    var v26: [u8; 13] = "|c|[3;5H|[2E\0"
    vt_str(state, t, (&v26[0]) as u64)
    if term_cx(state, t) == 0 && term_cy(state, t) == 4 {
        n = n + 1
    }
    // 28. CPL: previous line, column 1
    var v27: [u8; 13] = "|c|[3;5H|[1F\0"
    vt_str(state, t, (&v27[0]) as u64)
    if term_cx(state, t) == 0 && term_cy(state, t) == 1 {
        n = n + 1
    }
    // 29. a bad scroll region (top below bottom) is the whole screen
    var v28: [u8; 27] = "|c|[4;2r|[1;1HA|[2;1HB|[1S\0"
    vt_str(state, t, (&v28[0]) as u64)
    if cell_get(state, t, 0, 0) == 66 {
        n = n + 1
    }
    // 30. the wrap is deferred: a row filled to the last column does not scroll, the next character opens the next row
    var w0: [u8; 3] = "|c\0"
    vt_str(state, t, (&w0[0]) as u64)
    var q: u64 = 0
    while q < COLS {
        term_putc(state, t, 97)
        q = q + 1
    }
    let at_end: bool = term_cx(state, t) == COLS - 1 && term_cy(state, t) == 0 && cell_get(state, t, COLS - 1, 0) == 97
    term_putc(state, t, 98)
    if at_end && cell_get(state, t, 0, 1) == 98 && term_cy(state, t) == 1 && cell_get(state, t, 0, 0) == 97 {
        n = n + 1
    }
    // 31. ?7 l: no wrap, the last column is overwritten; ?7 h puts the wrap back
    var w1: [u8; 8] = "|c|[?7l\0"
    vt_str(state, t, (&w1[0]) as u64)
    q = 0
    while q < COLS + 3 {
        term_putc(state, t, 120)
        q = q + 1
    }
    term_putc(state, t, 121)
    var w2: [u8; 8] = "|[?7h\0\0\0"
    vt_str(state, t, (&w2[0]) as u64)
    if term_cy(state, t) == 0 && term_cx(state, t) == COLS - 1 && cell_get(state, t, COLS - 1, 0) == 121 && cell_get(state, t, 0, 1) == 32 {
        n = n + 1
    }
    // 32. the grid size the tty reports: rows << 16 | columns
    if term_size(state, t) == (ROWS << 16) | COLS {
        n = n + 1
    }
    // the machine is left plain
    var rs: [u8; 3] = "|c\0"
    vt_str(state, t, (&rs[0]) as u64)
    destroy(state, t)
    ss(state, S_NEXTID, nid0)
    fokus_still = 0
    return n
}

fn vt2_selftest_max() -> u64 {
    return 32
}

fn selftest_max() -> u64 {
    return 30
}

// ===================================================== RUNDE TILING
//
// DER FENSTERBAUM AM FENSTERSERVER. Die Rechnung selbst steht in
// `kernel/tile.fi` und weiss von Fenstern nichts; was hier steht, ist
// die NAHT: welches Blatt gehoert zu welchem Fenster, wie kommt ein
// Rechteck aus dem Baum in einen Fenstersatz, wer malt die Reiterzeilen,
// und was passiert, wenn man ein Fenster mit der Maus irgendwohin zieht.
//
// BEIDE WELTEN NEBENEINANDER, und das ist Absicht: ein Fenster mit
// W_NODE == 0 SCHWEBT wie vor dieser Runde, eines mit W_NODE != 0 haengt
// im Baum. Ein Dialog will schweben, eine Textkonsole will kacheln.
// `tile_float` schiebt ein Fenster von der einen Welt in die andere und
// zurueck; die schwebende Lage wird dabei in W_SAVXY/W_SAVWH aufgehoben,
// sonst steht der Dialog nach dem Zurueckholen in der Ecke.

// ===================================================== r839 TILE TREE PER HEAD
// One tree per head. The tree of the primary head is the old tree (the pages at kstate.TILE_OFF, `state` itself is
// its "tile state"). Every other head gets its own 4-frame tree the first time a window is tiled onto it; the tile
// module only ever computes `state + kstate.TILE_OFF + ...`, so a tree is addressed by the fake state
// `frames - TILE_OFF` (`tl_state`). `W_NODE` = (node + 1) | (tree tag << 8); tag 0 = the main tree, tag h >= 1 = the
// tree of head h. The CURRENT tree (`tl_cur`, answered by `tt(state)`) is a plain global: every entry point selects
// it first (`tl_use` may allocate the tree, `tl_sel` only selects an existing one), every `tile.*` call below uses
// `tt(state)`. With fewer than two heads tag 0 is the only one and nothing changes.
static mut tl_cur: u64 = 0
static mut tl_alt: [u64; 8] = [0 as u64; 8]
static mut tl_mask: u64 = 1
static mut tl_prim: u64 = 0
static mut tl_drop_tag: u64 = 0
static mut tl_re: [u8; 32] = [0 as u8; 32]

fn nd_node(v: u64) -> u64 {
    return (v & 0xFF) - 1
}

fn nd_tag(v: u64) -> u64 {
    return v >> 8
}

fn nd_val(n: u64) -> u64 {
    return (n + 1) | (tl_cur << 8)
}

fn tl_state(state: u64, tag: u64) -> u64 {
    if tag == 0 || tag >= HD_MAX {
        return state
    }
    let b: u64 = tl_alt[tag as usize]
    if b == 0 {
        return state
    }
    return b - kstate.TILE_OFF
}

fn tt(state: u64) -> u64 {
    return tl_state(state, tl_cur)
}

// Select an EXISTING tree (tag 0 when there is none).
fn tl_sel(state: u64, tag: u64) {
    if tag != 0 && (tag >= HD_MAX || tl_alt[tag as usize] == 0) {
        tl_cur = 0
        return
    }
    tl_cur = tag
}

// Tree tag of a head: 0 for the primary head (and always on a single screen).
fn tl_tag_head(state: u64, hd: u64) -> u64 {
    if !hd_multi(state) || hd >= HD_MAX || hd == hd_primary(state) {
        return 0
    }
    return hd
}

// Select the tree of `tag`, making it first when it does not exist yet. False: no such head / no memory (then the
// main tree is selected).
fn tl_use(state: u64, tag: u64) -> bool {
    tl_cur = 0
    if tag == 0 {
        return true
    }
    if tag >= HD_MAX || !hd_present(state, tag) {
        return false
    }
    if tl_alt[tag as usize] == 0 {
        let b: u64 = mem.frame_run(state, 4)
        if b == 0 {
            return false
        }
        if b <= kstate.TILE_OFF {
            mem.frame_free_run(state, b, 4)
            return false
        }
        var o: u64 = 0
        while o < kstate.TILE_MAX {
            kstate.set(b, o, 0)
            o = o + 8
        }
        let p: u64 = head_work(state, tag)
        if !tile.init(b - kstate.TILE_OFF, hw_x(p), hw_y(p), hw_w(p), hw_h(p)) {
            mem.frame_free_run(state, b, 4)
            return false
        }
        tl_alt[tag as usize] = b
    }
    tl_cur = tag
    return true
}

fn tl_use_win(state: u64, i: u64) {
    let v: u64 = wg(state, i, W_NODE)
    if v == 0 {
        tl_cur = 0
        return
    }
    tl_sel(state, nd_tag(v))
}

fn tl_free(state: u64, tag: u64) {
    if tag == 0 || tag >= HD_MAX {
        return
    }
    let b: u64 = tl_alt[tag as usize]
    if b != 0 {
        mem.frame_free_run(state, b, 4)
        tl_alt[tag as usize] = 0
    }
}

// Tree state of the focused window's tree (for the ring-3 queries); the main tree when it is not tiled.
fn tile_focus_state(state: u64) -> u64 {
    let f: u64 = focus(state)
    if f < MAX_WIN && valid(state, f) && wg(state, f, W_NODE) != 0 {
        return tl_state(state, nd_tag(wg(state, f, W_NODE)))
    }
    return state
}

fn tile_nodes_all(state: u64) -> u64 {
    var n: u64 = tile.nodes(state)
    var h: u64 = 1
    while h < HD_MAX {
        if tl_alt[h as usize] != 0 {
            n = n + tile.nodes(tl_state(state, h))
        }
        h = h + 1
    }
    return n
}

fn tile_leaves_all(state: u64) -> u64 {
    var n: u64 = tile.leaves(state)
    var h: u64 = 1
    while h < HD_MAX {
        if tl_alt[h as usize] != 0 {
            n = n + tile.leaves(tl_state(state, h))
        }
        h = h + 1
    }
    return n
}

// Heads came or went (called from heads_sync, after the windows were moved onto heads that exist): a tree whose head
// is gone gives its windows back (they are tiled again onto the head they are on now); when the PRIMARY head
// changed, the main tree changed owner, so every tiled window is re-tiled. Trees of new heads need nothing: they
// are made when the first window lands there.
fn tl_heads_changed(state: u64) {
    var mask: u64 = 1
    var prim: u64 = 0
    if hd_multi(state) {
        mask = 0
        var hd: u64 = 0
        while hd < HD_MAX {
            if hd_present(state, hd) {
                let bit: u64 = 1
                mask = mask | (bit << hd)
            }
            hd = hd + 1
        }
        prim = hd_primary(state)
    }
    let full: bool = prim != tl_prim
    var gone: u64 = 0
    var h: u64 = 1
    while h < HD_MAX {
        let bit2: u64 = 1
        if tl_alt[h as usize] != 0 && (mask & (bit2 << h)) == 0 {
            gone = gone | (bit2 << h)
        }
        h = h + 1
    }
    tl_mask = mask
    if !full && gone == 0 {
        return
    }
    var i: u64 = 0
    while i < MAX_WIN {
        tl_re[i as usize] = 0
        let v: u64 = wg(state, i, W_NODE)
        if wg(state, i, W_USED) != 0 && v != 0 {
            let t: u64 = nd_tag(v)
            let bit3: u64 = 1
            if full || (t != 0 && (gone & (bit3 << t)) != 0) {
                tile_release(state, i)
                tl_re[i as usize] = 1
            }
        }
        i = i + 1
    }
    h = 1
    while h < HD_MAX {
        let bit4: u64 = 1
        if full || (gone & (bit4 << h)) != 0 {
            tl_free(state, h)
        }
        h = h + 1
    }
    tl_prim = prim
    tl_cur = 0
    i = 0
    while i < MAX_WIN {
        if tl_re[i as usize] != 0 {
            let _t: bool = tile_take(state, i)
        }
        i = i + 1
    }
}

fn tile_tree_tag(state: u64, i: u64) -> u64 {
    if !valid(state, i) || wg(state, i, W_NODE) == 0 {
        return 0
    }
    return nd_tag(wg(state, i, W_NODE))
}

fn tile_on(state: u64) -> bool {
    return gs(state, S_TILE) != 0
}

fn tiled(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    return wg(state, i, W_NODE) != 0
}

fn tile_node(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return tile.NONE
    }
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return tile.NONE
    }
    return nd_node(nd)
}

// RUNDE TILING: LIEGT DIESES FENSTER HINTER EINEM REITER. Diese
// Funktion hiess in der Runde TILING `win_hidden` -- genau wie die
// Funktion der Runde DESKTOP, die "ist minimiert" beantwortet. Zwei
// Fragen, zwei Antworten, ein Name: der Uebersetzer hat es gemeldet,
// und ein Leser haette es nicht gemerkt. Sie heisst jetzt `win_tabbed`.
fn win_tabbed(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_TABBED) != 0
}

fn hotkeys_seen(state: u64) -> u64 {
    return gs(state, S_HOTS)
}

// RUNDE WMPLUGIN: WIE VIELE TASTEN EIN PLUGIN BEKOMMEN HAT -- und
// damit, wie viele KEIN Fenster bekommen hat. Ohne diese Zahl liesse
// sich "das Kuerzel wurde geschluckt" nicht von "die Taste kam nie an"
// unterscheiden, und das sind zwei verschiedene Fehler.
fn plugkeys(state: u64) -> u64 {
    return gs(state, S_KPLUG)
}

// Der Bereich, den die letzte Baumoperation angefasst hat -- und NUR
// der. Das ist die Zahl, die `notiledirty` kaputt macht.
fn damage_tile(state: u64) {
    let x: u64 = tile.last_x(tt(state))
    let y: u64 = tile.last_y(tt(state))
    let w: u64 = tile.last_w(tt(state))
    let h: u64 = tile.last_h(tt(state))
    if w == 0 || h == 0 {
        return
    }
    damage(state, x as i64, y as i64, (x + w) as i64, (y + h) as i64)
}

fn set_tile_on(state: u64, on: bool) {
    if !ready(state) {
        return
    }
    if on {
        ss(state, S_TILE, 1)
        // ================================================ RUNDE ECHTHARDWARE-3
        // NICHT ALLES, WAS OFFEN IST, GEHOERT IN DEN BAUM.
        //
        // Justins Befund: "Tiling ein-/ausschalten zerschiesst den
        // Zustand -- danach geht fast gar nichts mehr." Hier stand
        // "Alles, was jetzt schon offen ist, kommt in den Baum", und
        // das war woertlich gemeint: der SCHREIBTISCH (L_DESK, deckt
        // den ganzen Schirm), die TASKLEISTE (L_TOP, reserviert eine
        // Kante), das Startmenue, ein Klappmenue, eine Blase -- alle
        // wurden zu Kacheln.
        //
        // Was daraus folgt, ist genau das, was er sieht: die Leiste
        // bekommt eine halbe Bildschirmflaeche zugeteilt und liegt
        // nicht mehr an ihrer Kante, der Schreibtisch wird zur Kachel
        // neben ihr, und `restore_geom` beim Ausschalten setzt beide
        // auf Masse zurueck, die inzwischen nichts mehr bedeuten --
        // die Leiste ist weg, der Schreibtisch sitzt schief, und ohne
        // Leiste gibt es keinen Knopf mehr, mit dem man es zuruecknimmt.
        //
        // GEKACHELT WIRD, WAS EIN MENSCH ALS FENSTER BENUTZT: die
        // Ebene L_NORMAL, sichtbar, und ohne reservierte Kante.
        var i: u64 = 0
        while i < MAX_WIN {
            if wg(state, i, W_USED) != 0 && wg(state, i, W_NODE) == 0
                && wg(state, i, W_LAYER) == L_NORMAL
                && wg(state, i, W_STRUT) == 0
                && (wg(state, i, W_FLAGS) & F_HIDDEN) == 0 {
                save_geom(state, i)
                tile_take(state, i)
            }
            i = i + 1
        }
    } else {
        ss(state, S_TILE, 0)
        var k: u64 = 0
        while k < MAX_WIN {
            if wg(state, k, W_USED) != 0 && wg(state, k, W_NODE) != 0 {
                tile_release(state, k)
                restore_geom(state, k)
            }
            k = k + 1
        }
    }
    damage_all(state)
}

fn save_geom(state: u64, i: u64) {
    var x: u64 = wg(state, i, W_X) & 0xFFFFFFFF
    var y: u64 = wg(state, i, W_Y) & 0xFFFFFFFF
    wsv(state, i, W_SAVXY, (x << 32) | y)
    wsv(state, i, W_SAVWH, (wg(state, i, W_W) << 32) | wg(state, i, W_H))
}

fn restore_geom(state: u64, i: u64) {
    let wh: u64 = wg(state, i, W_SAVWH)
    if wh == 0 {
        return
    }
    let xy: u64 = wg(state, i, W_SAVXY)
    wsv(state, i, W_X, xy >> 32)
    wsv(state, i, W_Y, xy & 0xFFFFFFFF)
    let w: u64 = wh >> 32
    let h: u64 = wh & 0xFFFFFFFF
    if w >= 32 && h >= 16 {
        if reframe(state, i, w, h) {
            wsv(state, i, W_W, w)
            wsv(state, i, W_H, h)
            if wg(state, i, W_KIND) == K_TERM {
                term_setup(state, i)
            } else {
                fill(state, i, 0, 0, w, h, wg(state, i, W_BG))
            }
            ev_push(state, i, E_RESIZE, w, h, 0)
        }
    }
    wsv(state, i, W_FLAGS, wg(state, i, W_FLAGS) & ~F_TABBED)
}

// EIN GROESSERER PUFFER, WENN DER BAUM MEHR PLATZ GIBT. Runde K10 hat
// den Puffer beim Anlegen geholt und `resize_win` verweigert seitdem
// jedes Wachsen darueber hinaus -- mit Recht, denn sonst waere es ein
// Schreibzugriff daneben. Beim Kacheln ist Wachsen aber der Normalfall:
// wer von vier Fenstern zwei schliesst, verdoppelt die uebrigen. Also
// wird hier ein neuer Lauf Rahmen geholt und der alte zurueckgegeben.
fn reframe(state: u64, i: u64, w: u64, h: u64) -> bool {
    let bytes: u64 = w * h * 4
    if wg(state, i, W_KIND) == K_TERM && wg(state, i, W_SHM) != 0 {
        return term_fit(state, i, bytes)
    }
    if wg(state, i, W_SHM) != 0 {
        return detach_buf(state, i, bytes)
    }
    if bytes <= wg(state, i, W_BUFBYTES) {
        return true
    }
    let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    let neu: u64 = mem.frame_run(state, rahmen)
    if neu == 0 {
        return false
    }
    let alt: u64 = wg(state, i, W_BUF)
    let altr: u64 = wg(state, i, W_BUFBYTES) / mem.FRAME_SIZE
    wsv(state, i, W_BUF, neu)
    wsv(state, i, W_BUFBYTES, rahmen * mem.FRAME_SIZE)
    if alt != 0 {
        mem.frame_free_run(state, alt, altr)
    }
    return true
}

// Ein Blatt des Baumes auf einen Fenstersatz. Der Baum fuehrt das
// AEUSSERE Rechteck (mit Rahmen und Titelleiste) -- die Malflaeche ist
// das, was davon uebrigbleibt.
fn place_win(state: u64, i: u64, n: u64) {
    let ow: u64 = tile.n_w(tt(state), n)
    let oh: u64 = tile.n_h(tt(state), n)
    var w: u64 = 32
    if ow > border(state) * 2 + 32 {
        w = ow - border(state) * 2
    }
    var h: u64 = 16
    if oh > iny(state, i) + border(state) + 16 {
        h = oh - iny(state, i) - border(state)
    }
    // RUNDE SCHIRM-ECHT: DIE DRITTE 2048 -- dieselbe vergessene Zahl,
    // die `resize_win` schon losgeworden ist. Beim Kacheln bekommt ein
    // Blatt die Flaeche des Baumes, und die ist auf einem 2560er Schirm
    // breiter als 2048; das Fenster blieb dann kleiner als sein Platz
    // und liess einen Streifen Schreibtisch stehen. Die echte Grenze
    // ist der Puffer, und um den kuemmert sich `reframe` zwei Zeilen
    // tiefer.
    if w > MAX_W_HARD {
        w = MAX_W_HARD
    }
    if h > MAX_H_HARD {
        h = MAX_H_HARD
    }
    wsv(state, i, W_X, tile.n_x(tt(state), n))
    wsv(state, i, W_Y, tile.n_y(tt(state), n))
    if w == wg(state, i, W_W) && h == wg(state, i, W_H) {
        return
    }
    if !reframe(state, i, w, h) {
        return
    }
    wsv(state, i, W_W, w)
    wsv(state, i, W_H, h)
    if wg(state, i, W_KIND) == K_TERM {
        term_setup(state, i)
    } else {
        fill(state, i, 0, 0, w, h, wg(state, i, W_BG))
    }
    ev_push(state, i, E_RESIZE, w, h, 0)
}

// Den ganzen Baum auf die Fenster uebertragen. Ohne `damage` -- der
// Rufer beschmutzt EINMAL den Bereich, den der Baum als geaendert
// meldet, und genau das ist der Unterschied, den diese Runde misst.
fn tile_apply_one(state: u64) -> bool {
    let r: u64 = tile.root(tt(state))
    if r == tile.NONE {
        return false
    }
    var n: u64 = r
    var guard: u64 = 0
    while n != tile.NONE && guard <= tile.MAX_NODES {
        guard = guard + 1
        if tile.n_kind(tt(state), n) == tile.K_LEAF {
            let cl: u64 = tile.n_client(tt(state), n)
            if cl != 0 && cl <= MAX_WIN {
                let i: u64 = cl - 1
                if wg(state, i, W_USED) != 0 {
                    // AUCH VERDECKTE REITER BEKOMMEN IHR RECHTECK. Sie
                    // werden nicht gemalt, aber sie muessen die richtige
                    // Groesse haben, wenn man den Reiter wechselt --
                    // sonst zuckt das Fenster beim Umschalten einmal
                    // durch, weil erst dann neu gerechnet wird.
                    place_win(state, i, n)
                    if tile.visible(tt(state), n) {
                        wsv(state, i, W_FLAGS,
                            wg(state, i, W_FLAGS) & ~F_TABBED)
                    } else {
                        wsv(state, i, W_FLAGS,
                            wg(state, i, W_FLAGS) | F_TABBED)
                    }
                }
            }
        }
        n = tile.dfs_next(tt(state), n, r)
    }
    // ================================================ RUNDE WMPLUGIN
    // DER KACHELBAUM HAT SICH BEWEGT. Diese eine Stelle meldet es, und
    // sie ist die richtige: JEDE Aenderung am Baum -- einfuegen,
    // herausnehmen, teilen, ziehen, Reiter wechseln -- laeuft durch
    // `tile_apply`, weil jede davon die Rechtecke neu verteilt.
    //
    // Zwei Zahlen gehen mit: Knoten und Blaetter. Sie genuegen, um "es
    // ist ein Fenster dazugekommen" von "die Kante wurde gezogen" zu
    // unterscheiden, und sie kosten den Kern zwei Ablesungen.
    // NICHT aus `compose` gerufen -- der Bildpfad bleibt frei davon.
    return true
}

fn tile_apply(state: u64) {
    let keep: u64 = tl_cur
    tl_cur = 0
    var did: bool = tile_apply_one(state)
    var h: u64 = 1
    while h < HD_MAX {
        if tl_alt[h as usize] != 0 {
            tl_cur = h
            if tile_apply_one(state) {
                did = true
            }
        }
        h = h + 1
    }
    tl_cur = keep
    if did {
        wmplug.notify(state, wmplug.E_TILE, tile_nodes_all(state),
            tile_leaves_all(state), 0)
    }
}

fn kachelbar(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if wg(state, i, W_LAYER) != L_NORMAL {
        return false
    }
    if wg(state, i, W_STRUT) != 0 {
        return false
    }
    // ==================================== RUNDE ECHTHARDWARE-4
    // EIN FENSTER OHNE SCHMUCK IST KEINE KACHEL.
    //
    // Justins Wort zum Kachelbetrieb war "Muell", und einer der
    // Gruende steht hier: `F_NODECO` traegt alles, was KEIN
    // gewoehnliches Fenster ist -- das Startmenue, ein Klappmenue,
    // eine Blase, ein rahmenloser Dialog. Ebene und Kantenreservierung
    // haben Schreibtisch und Leiste schon herausgehalten; das
    // Startmenue liegt aber auf der normalen Ebene und reserviert
    // nichts, also WAERE es gekachelt worden. Ein Startmenue, das
    // beim Aufgehen die Fenster daneben umsortiert, ist genau die Art
    // Automatismus, die in dieser Runde ausdruecklich nicht mehr
    // vorkommen darf.
    if (wg(state, i, W_FLAGS) & F_NODECO) != 0 {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_HIDDEN) == 0
}

fn tile_take(state: u64, i: u64) -> bool {
    if !valid(state, i) || wg(state, i, W_NODE) != 0 {
        return false
    }
    if !kachelbar(state, i) {
        return false
    }
    // r839: the tree of the head the window is on (the main tree on a single screen or when that tree cannot be made)
    let _u: bool = tl_use(state, tl_tag_head(state, win_head(state, i)))
    let n: u64 = tile.insert(tt(state), i + 1)
    if n == tile.NONE {
        return false // kein Platz im Baum -- das Fenster schwebt weiter
    }
    wsv(state, i, W_NODE, nd_val(n))
    tile_apply(state)
    damage_tile(state)
    return true
}

fn tile_release(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return false
    }
    wsv(state, i, W_NODE, 0)
    wsv(state, i, W_FLAGS, wg(state, i, W_FLAGS) & ~F_TABBED)
    tl_sel(state, nd_tag(nd))
    tile.remove(tt(state), nd_node(nd))
    tile_apply(state)
    damage_tile(state)
    return true
}

fn tile_float(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if wg(state, i, W_NODE) != 0 {
        tile_release(state, i)
        restore_geom(state, i)
        raise_win(state, i)
        damage_win(state, i)
        return true
    }
    save_geom(state, i)
    return tile_take(state, i)
}

fn tile_snap(state: u64, i: u64, where: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if wg(state, i, W_NODE) == 0 {
        save_geom(state, i)
        if !tile_take(state, i) {
            return false
        }
    }
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return false
    }
    tl_sel(state, nd_tag(nd))
    tile.snap(tt(state), nd_node(nd), where)
    tile_apply(state)
    damage_tile(state)
    return true
}

// EIN WECHSEL DER BILDSCHIRMAUFLOESUNG. Der Baum wird NEU AUSGEMESSEN
// und nicht neu aufgebaut -- die Verhaeltnisse stehen als Anteile da und
// nicht als Bildpunkte, also ueberlebt jede Aufteilung den Wechsel.
fn on_screen_resize(state: u64, w: u64, h: u64) -> bool {
    if !ready(state) || w == 0 || h == 0 {
        return false
    }
    ss(state, S_SW, w)
    ss(state, S_SH, h)
    // RUNDE VOLLBILD: der Baum bekommt die ARBEITSFLAECHE. Hier stand
    // `0, 0, w, h` -- der ganze Schirm -- und damit reichte jedes
    // gekachelte Fenster unter die Leiste. `recalc_work` rechnet die
    // Flaeche aus dem neuen Schirm und den Struts; danach steht sie in
    // S_WORK_*, und der Baum folgt ihr.
    recalc_work(state)
    tile_area_work(state)
    tile_apply(state)
    // r1004: the pointer limits, the maximized windows and every window that now sticks out of the screen follow the new size
    ps2m.set_bounds(state, w, h)
    screen_fit_windows(state, w, h)
    damage_all(state)
    return true
}

// r1004: after a resolution change a maximized window gets the new work area; every other normal-layer window is pulled back
// inside the screen (moved first, shrunk only when it is bigger than the screen). Desk, bar (strut) and hidden windows stay alone.
fn screen_fit_windows(state: u64, w: u64, h: u64) {
    var i: u64 = 0
    while i < MAX_WIN {
        if valid(state, i) && wg(state, i, W_STRUT) == 0 {
            let f: u64 = wg(state, i, W_FLAGS)
            let lay: u64 = win_layer(state, i)
            if (f & F_MAXIMIZED) != 0 {
                let _fw: bool = fit_work(state, i)
            } else if lay == L_NORMAL {
                var ow: u64 = outer_w(state, i)
                var oh: u64 = outer_h(state, i)
                var x: i64 = win_x(state, i)
                var y: i64 = win_y(state, i)
                // r1061: a floating window that was shrunk by an earlier, smaller screen remembers the size it had (W_SAVWH, tag bit 63;
                // a tiled window uses the same word for its own purpose, so only W_NODE == 0 counts). When the screen grows again
                // (800x600 -> auto revert -> 1024x768) the window gets that size back, as far as it fits.
                var tw: u64 = wg(state, i, W_W)
                var th: u64 = wg(state, i, W_H)
                let sv: u64 = wg(state, i, W_SAVWH)
                let floating: bool = wg(state, i, W_NODE) == 0
                if floating && (sv >> 63) != 0 {
                    let rw: u64 = (sv >> 32) & 0xFFFF
                    let rh: u64 = sv & 0xFFFF
                    if rw >= tw && rh >= th {
                        tw = rw
                        th = rh
                    }
                }
                let dw: u64 = ow - wg(state, i, W_W)
                let dh: u64 = oh - wg(state, i, W_H)
                var nw: u64 = tw
                var nh: u64 = th
                if tw + dw > w && tw + dw - w < tw {
                    nw = tw - (tw + dw - w)
                }
                if th + dh > h && th + dh - h < th {
                    nh = th - (th + dh - h)
                }
                if nw != wg(state, i, W_W) || nh != wg(state, i, W_H) {
                    let _rs: bool = resize_win(state, i, nw, nh)
                    ow = outer_w(state, i)
                    oh = outer_h(state, i)
                }
                if floating {
                    if nw < tw || nh < th {
                        wsv(state, i, W_SAVWH, 0x8000000000000000 | ((tw & 0xFFFF) << 32) | (th & 0xFFFF))
                    } else if (sv >> 63) != 0 {
                        wsv(state, i, W_SAVWH, 0)
                    }
                }
                if x + (ow as i64) > (w as i64) {
                    x = (w as i64) - (ow as i64)
                }
                if y + (oh as i64) > (h as i64) {
                    y = (h as i64) - (oh as i64)
                }
                if x < 0 {
                    x = 0
                }
                if y < 0 {
                    y = 0
                }
                if x != win_x(state, i) || y != win_y(state, i) {
                    move_win(state, i, x, y)
                }
            }
        }
        i = i + 1
    }
}

// r1004: THE WINDOW SERVER FOLLOWS THE SCREEN. Nobody called `on_screen_resize`: a host resize hint switched the card (vmode), the window
// server went on with the old size (work area, tile tree, damage box), and the desktop stayed black. One check at the head of every
// compose covers every path that switches the mode (host hint, Settings, dispctl). Several heads keep their own tables: left alone.
fn screen_follow(state: u64) {
    let fw: u64 = fb.width(state)
    let fh: u64 = fb.height(state)
    if fw == 0 || fh == 0 || hd_multi(state) {
        return
    }
    if fw != gs(state, S_SW) || fh != gs(state, S_SH) {
        let _r: bool = on_screen_resize(state, fw, fh)
    }
    // INPUT FOLLOWS THE OUTPUT: the hardware pointer sits in PANEL pixels, so a rotation / scale change moves it even when the
    // pointer itself did not (hwcur_bewegen only talks to the device when form, rotation or panel position changed).
    if hwcur_moeglich(state) && hw_an(state) {
        hwcur_bewegen(state)
    }
}

// ================================================== RUNDE VOLLBILD
// DER KACHELBAUM FOLGT DER ARBEITSFLAECHE.
//
// An EINER Stelle, weil es zwei Anlaesse gibt, sie zu setzen: ein
// Wechsel der Aufloesung und ein Wechsel der Struts (die Leiste zieht
// an eine andere Kante, wird versteckt, kommt zurueck). Stuende die
// Rechnung an beiden, waere sie eine Gelegenheit, sie an einer zu
// vergessen -- so wie sie bis zu dieser Runde ganz fehlte.
fn tile_area_work(state: u64) {
    let _a: bool = tile.set_area(state, gs(state, S_WORK_X),
        gs(state, S_WORK_Y), gs(state, S_WORK_W), gs(state, S_WORK_H))
    // r839: the trees of the other heads follow the work area of their head
    var h: u64 = 1
    while h < HD_MAX {
        if tl_alt[h as usize] != 0 && hd_multi(state) && hd_present(state, h) {
            let p: u64 = head_work(state, h)
            let _b: bool = tile.set_area(tl_state(state, h), hw_x(p), hw_y(p), hw_w(p), hw_h(p))
        }
        h = h + 1
    }
}

// ------------------------------------------------ die Reiterzeilen
//
// Sie werden vom SERVER gemalt, wie die Titelleiste -- eine Anwendung
// darf nicht wissen, dass sie in einem Reiter liegt, und sie kann es
// auch nicht malen: die Zeile liegt AUSSERHALB ihres Rechtecks. Der
// Baum hat ihre Hoehe von der Flaeche der Kinder schon abgezogen, also
// ueberschneidet sich hier nichts.
fn paint_bar_of(state: u64, n: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let f: u64 = gs(state, S_FONT_UI)
    let px: u64 = gs(state, S_PX_UI)
    var idx: u64 = 0
    var c: u64 = tile.n_first(tt(state), n)
    while c != tile.NONE && idx <= tile.MAX_NODES {
        let tx: i64 = tile.tab_x(tt(state), n, idx) as i64
        let ty: i64 = tile.tab_y(tt(state), n, idx) as i64
        let tw: i64 = tile.tab_w(tt(state), n, idx) as i64
        let th: i64 = tile.tab_h(tt(state), n, idx) as i64
        let aktiv: bool = tile.n_active(tt(state), n) == c
        // ROUND MERGE: THESE WERE FIVE RAW COLOURS. Round TILING wrote
        // the tab bar with the values that stood in the drawing code
        // BEFORE round THEME, and round THEME's whole promise is that no
        // painting routine names a colour -- tests/theme/rawcolour.py
        // measures exactly that and found eight. A tab bar that keeps
        // its own dark blue in a light theme is the same bug the
        // terminal window had, and THEME's script says so in its header.
        // The four slots are the ones the title bar already uses: a tab
        // IS a title bar, and the active tab is the focused one.
        var grund: u64 = deco(state, DK_TITLE)
        var schrift: u64 = deco(state, DK_TEXT)
        if aktiv {
            grund = deco(state, DK_TITLE_ON)
            schrift = deco(state, DK_TEXT_ON)
        }
        let ax0: i64 = imax(tx, cx0 as i64)
        let ay0: i64 = imax(ty, cy0 as i64)
        let ax1: i64 = imin(tx + tw, cx1 as i64)
        let ay1: i64 = imin(ty + th, cy1 as i64)
        if ax1 > ax0 && ay1 > ay0 {
            fb.fill(state, ax0 as u64, ay0 as u64, (ax1 - ax0) as u64,
                (ay1 - ay0) as u64, grund)
            // eine Trennlinie am rechten beziehungsweise unteren Rand
            let rand: u64 = deco(state, DK_FRAME)
            if tw > 1 && tx + tw - 1 < cx1 as i64 && tx + tw - 1 >= cx0 as i64 {
                fb.fill(state, (tx + tw - 1) as u64, ay0 as u64, 1,
                    (ay1 - ay0) as u64, rand)
            }
            if th > 1 && ty + th - 1 < cy1 as i64 && ty + th - 1 >= cy0 as i64 {
                fb.fill(state, ax0 as u64, (ty + th - 1) as u64,
                    (ax1 - ax0) as u64, 1, rand)
            }
            if f < ttf.MAX_FONTS {
                let l: u64 = tile.first_leaf(tt(state), c)
                if l != tile.NONE {
                    let cl: u64 = tile.n_client(tt(state), l)
                    if cl != 0 && cl <= MAX_WIN {
                        title_text(state, cl - 1, f, tx + 6,
                            ty + 3 + ttf.ascent(state, f, px), schrift,
                            ax0, ay0, ax1, ay1, tx + tw - 4)
                    }
                }
            }
        }
        idx = idx + 1
        c = tile.n_next(tt(state), c)
    }
}

fn paint_bars(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let keep: u64 = tl_cur
    tl_cur = 0
    paint_bars_one(state, cx0, cy0, cx1, cy1)
    var h: u64 = 1
    while h < HD_MAX {
        if tl_alt[h as usize] != 0 {
            tl_cur = h
            paint_bars_one(state, cx0, cy0, cx1, cy1)
        }
        h = h + 1
    }
    tl_cur = keep
}

fn paint_bars_one(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let r: u64 = tile.root(tt(state))
    if r == tile.NONE {
        return
    }
    var n: u64 = r
    var guard: u64 = 0
    while n != tile.NONE && guard <= tile.MAX_NODES {
        guard = guard + 1
        if tile.n_kind(tt(state), n) == tile.K_BOX {
            if tile.n_layout(tt(state), n) != tile.LAY_SPLIT {
                paint_bar_of(state, n, cx0, cy0, cx1, cy1)
            }
        }
        n = tile.dfs_next(tt(state), n, r)
    }
}

// ------------------------------------------- das Vorschaurechteck
//
// Beim Ziehen zeigt ein Rahmen, WO das Fenster landen wird -- nicht
// wo der Zeiger ist. Ohne das ist ein Ablegen im Baum Raten: die
// linke Haelfte eines Fensters und sein oberes Viertel sind zwei
// verschiedene Ziele, und man sieht dem Zeiger nicht an, welches
// gemeint ist.
fn paint_preview(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let x: i64 = gs(state, S_PVX) as i64
    let y: i64 = gs(state, S_PVY) as i64
    let w: i64 = gs(state, S_PVW) as i64
    let h: i64 = gs(state, S_PVH) as i64
    if w <= 0 || h <= 0 {
        return
    }
    // ROUND MERGE: 0x4C9AE8 is exactly deco_fallback(DK_FRAME_ON) --
    // round TILING copied the number instead of asking for the slot, so
    // the drag preview kept the old accent in every other theme.
    let farbe: u64 = deco(state, DK_FRAME_ON)
    var k: i64 = 0
    while k < 3 {
        pv_line(state, x + k, y + k, w - 2 * k, 1, farbe, cx0, cy0, cx1, cy1)
        pv_line(state, x + k, y + h - 1 - k, w - 2 * k, 1, farbe, cx0, cy0,
            cx1, cy1)
        pv_line(state, x + k, y + k, 1, h - 2 * k, farbe, cx0, cy0, cx1, cy1)
        pv_line(state, x + w - 1 - k, y + k, 1, h - 2 * k, farbe, cx0, cy0,
            cx1, cy1)
        k = k + 1
    }
}

fn pv_line(state: u64, x: i64, y: i64, w: i64, h: i64, farbe: u64,
    cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let ax0: i64 = imax(x, cx0 as i64)
    let ay0: i64 = imax(y, cy0 as i64)
    let ax1: i64 = imin(x + w, cx1 as i64)
    let ay1: i64 = imin(y + h, cy1 as i64)
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    fb.fill(state, ax0 as u64, ay0 as u64, (ax1 - ax0) as u64,
        (ay1 - ay0) as u64, farbe)
}

fn preview_damage(state: u64) {
    if gs(state, S_PVON) == 0 {
        return
    }
    let x: i64 = gs(state, S_PVX) as i64
    let y: i64 = gs(state, S_PVY) as i64
    damage(state, x, y, x + gs(state, S_PVW) as i64,
        y + gs(state, S_PVH) as i64)
}

fn set_preview(state: u64, x: u64, y: u64, w: u64, h: u64) {
    ss(state, S_PVX, x)
    ss(state, S_PVY, y)
    ss(state, S_PVW, w)
    ss(state, S_PVH, h)
    ss(state, S_PVON, 1)
}

// Welches Blatt liegt an dieser Stelle? Der Baum weiss es genauer als
// die Stapelreihenfolge -- er kennt auch die Stellen, an denen KEIN
// Fenster liegt, weil dort eine Reiterzeile ist.
fn leaf_at(state: u64, x: i64, y: i64) -> u64 {
    let r: u64 = tile.root(tt(state))
    if r == tile.NONE {
        return tile.NONE
    }
    var n: u64 = r
    var guard: u64 = 0
    while n != tile.NONE && guard <= tile.MAX_NODES {
        guard = guard + 1
        if tile.n_kind(tt(state), n) == tile.K_LEAF && tile.visible(tt(state), n) {
            let nx: i64 = tile.n_x(tt(state), n) as i64
            let ny: i64 = tile.n_y(tt(state), n) as i64
            if x >= nx && y >= ny {
                if x < nx + tile.n_w(tt(state), n) as i64 {
                    if y < ny + tile.n_h(tt(state), n) as i64 {
                        return n
                    }
                }
            }
        }
        n = tile.dfs_next(tt(state), n, r)
    }
    return tile.NONE
}

fn drag_begin(state: u64, i: u64) {
    // RUNDE ZIEH: das Fenster wird von jetzt an GROESSER gemalt. Der
    // Nachzug faengt bei null an -- er soll aus der Bewegung
    // entstehen und nicht aus dem Anfassen --, und die Lage des
    // letzten Ticks ist die jetzige, sonst liest der erste Tick eine
    // Geschwindigkeit, die es nie gab (das Fenster stand vorher
    // irgendwo, und die Differenz waere der ganze Weg dorthin).
    wsv(state, i, W_SWX, 0)
    wsv(state, i, W_SWY, 0)
    wsv(state, i, W_DXLAST, win_x(state, i) as u64)
    wsv(state, i, W_DYLAST, win_y(state, i) as u64)
    wsv(state, i, W_SWOFF, 0)
    damage_win_lift(state, i)
    ss(state, S_DRAGT, 0)
    ss(state, S_DROPN, 0)
    ss(state, S_DROPE, 0)
    if wg(state, i, W_NODE) == 0 {
        return
    }
    // Wer gezogen wird, ist waehrenddessen NICHT im Baum -- sonst
    // rechnet der Baum ihn bei jeder Zeigerbewegung neu an seinen alten
    // Platz. So macht es i3 auch.
    save_geom(state, i)
    tile_release(state, i)
    ss(state, S_DRAGT, 1)
}

// r828: EDGE DOCKING ON A NON-PRIMARY HEAD. The tile tree is one tree for the primary head (a tree per head is a
// separate step), so on another head a window dropped at an outer edge of its work area just takes the half of that
// work area -- floating, outside the tree. S_DROPE 5..8 = left/right/top/bottom half of the head under the pointer.
// An edge shared with another head (the seam between two monitors) is not a docking edge.
fn snap_part(p: u64, e: u64) -> u64 {
    var x: u64 = hw_x(p)
    var y: u64 = hw_y(p)
    var w: u64 = hw_w(p)
    var h: u64 = hw_h(p)
    if e == 1 {
        w = w / 2
    } else if e == 2 {
        x = x + w - w / 2
        w = w / 2
    } else if e == 3 {
        h = h / 2
    } else if e == 4 {
        y = y + h - h / 2
        h = h / 2
    }
    return (x << 48) | (y << 32) | (w << 16) | h
}


// Put window `i` on the packed rect (outer size, like `fit_work` does for the work area).
fn fit_rect(state: u64, i: u64, r: u64) -> bool {
    var iw: u64 = hw_w(r)
    var ih: u64 = hw_h(r)
    if deko(state, i) {
        if iw <= border(state) * 2 || ih <= iny(state, i) + border(state) {
            return false
        }
        iw = iw - border(state) * 2
        ih = ih - iny(state, i) - border(state)
    }
    if !resize_win(state, i, iw, ih) {
        return false
    }
    move_win(state, i, hw_x(r) as i64, hw_y(r) as i64)
    return true
}

// W-WIN11: SNAP OF A FLOATING WINDOW (Windows 11 behaviour). Dragging the title bar to a screen edge shows a preview and the drop
// docks the window: left / right edge = half, top edge = maximize, a corner = quarter. Codes in S_DROPE: 1 left, 2 right, 3 top
// (maximize), 9 top-left, 10 top-right, 11 bottom-left, 12 bottom-right (5..8 are the halves of a non-primary head, `snap_part`).
fn snap_rect(wk: u64, code: u64) -> u64 {
    let x: u64 = hw_x(wk)
    let y: u64 = hw_y(wk)
    let w: u64 = hw_w(wk)
    let h: u64 = hw_h(wk)
    let hw2: u64 = w / 2
    let hh2: u64 = h / 2
    if code == 1 {
        return (x << 48) | (y << 32) | (hw2 << 16) | h
    }
    if code == 2 {
        return ((x + w - hw2) << 48) | (y << 32) | (hw2 << 16) | h
    }
    if code == 9 {
        return (x << 48) | (y << 32) | (hw2 << 16) | hh2
    }
    if code == 10 {
        return ((x + w - hw2) << 48) | (y << 32) | (hw2 << 16) | hh2
    }
    if code == 11 {
        return (x << 48) | ((y + h - hh2) << 32) | (hw2 << 16) | hh2
    }
    if code == 12 {
        return ((x + w - hw2) << 48) | ((y + h - hh2) << 32) | (hw2 << 16) | hh2
    }
    return wk
}

fn snap_ok(state: u64, i: u64) -> bool {
    if fb.nosnap_an(state) || !valid(state, i) {
        return false
    }
    if !deko(state, i) || wg(state, i, W_LAYER) != L_NORMAL || wg(state, i, W_NODE) != 0 {
        return false
    }
    return true
}

// the zone code (0 = none) of the pointer on the work area `wk`; the flags say which edges are real screen edges
fn snap_zone(state: u64, wk: u64, x: i64, y: i64, nl: bool, nr: bool, nt: bool, nb: bool) -> u64 {
    let wx0: i64 = hw_x(wk) as i64
    let wy0: i64 = hw_y(wk) as i64
    let sw: i64 = hw_w(wk) as i64
    let sh: i64 = hw_h(wk) as i64
    let rand: i64 = 2 * uisc(state) as i64
    var cs: i64 = 64 * uisc(state) as i64
    if cs > sh / 4 {
        cs = sh / 4
    }
    if x < wx0 + rand && nl {
        if y < wy0 + cs {
            return 9
        }
        if y >= wy0 + sh - cs {
            return 11
        }
        return 1
    }
    if x >= wx0 + sw - rand && nr {
        if y < wy0 + cs {
            return 10
        }
        if y >= wy0 + sh - cs {
            return 12
        }
        return 2
    }
    if y < wy0 + rand && nt {
        if x < wx0 + cs {
            return 9
        }
        if x >= wx0 + sw - cs {
            return 10
        }
        return 3
    }
    if y >= wy0 + sh - rand && nb {
        if x < wx0 + cs {
            return 11
        }
        if x >= wx0 + sw - cs {
            return 12
        }
    }
    return 0
}

fn float_hover(state: u64, i: u64, x: i64, y: i64) {
    preview_damage(state)
    ss(state, S_PVON, 0)
    ss(state, S_DROPE, 0)
    if !snap_ok(state, i) {
        return
    }
    var wk: u64 = (gs(state, S_WORK_X) << 48) | (gs(state, S_WORK_Y) << 32) | (gs(state, S_WORK_W) << 16) | gs(state, S_WORK_H)
    var nl: bool = true
    var nr: bool = true
    var nt: bool = true
    var nb: bool = true
    if hd_multi(state) {
        let hd: u64 = hd_at(state, x, y)
        if hd >= HD_MAX {
            return
        }
        wk = head_work(state, hd)
        let hx: i64 = hd_x(state, hd) as i64
        let hy: i64 = hd_y(state, hd) as i64
        nl = hd_at(state, hx - 1, y) == HD_MAX
        nr = hd_at(state, hx + hd_w(state, hd) as i64, y) == HD_MAX
        nt = hd_at(state, x, hy - 1) == HD_MAX
        nb = hd_at(state, x, hy + hd_h(state, hd) as i64) == HD_MAX
    }
    let code: u64 = snap_zone(state, wk, x, y, nl, nr, nt, nb)
    if code == 0 {
        return
    }
    let r: u64 = snap_rect(wk, code)
    ss(state, S_DROPE, code)
    set_preview(state, hw_x(r), hw_y(r), hw_w(r), hw_h(r))
    preview_damage(state)
}

// the drop: dock the window on the preview rectangle (the way back is saved like `maximize` does, once)
fn float_drop(state: u64, i: u64, code: u64) {
    if !snap_ok(state, i) {
        return
    }
    let r: u64 = (gs(state, S_PVX) << 48) | (gs(state, S_PVY) << 32) | (gs(state, S_PVW) << 16) | gs(state, S_PVH)
    let f: u64 = wg(state, i, W_FLAGS)
    if code == 3 {
        let _m: bool = maximize(state, i, true)
        let _w: bool = fit_work(state, i)
        snap_say(state, i, code)
        return
    }
    if (f & F_MAXIMIZED) == 0 {
        let sx: u64 = ((win_x(state, i) + 4096) as u64) & 0xFFFF
        let sy: u64 = ((win_y(state, i) + 4096) as u64) & 0xFFFF
        wsv(state, i, W_SAVE, (sx << 48) | (sy << 32)
            | ((wg(state, i, W_W) & 0xFFFF) << 16)
            | (wg(state, i, W_H) & 0xFFFF))
        wsv(state, i, W_FLAGS, f | F_MAXIMIZED)
    }
    if !fit_rect(state, i, r) {
        wsv(state, i, W_FLAGS, f)
        return
    }
    damage_all(state)
    snap_say(state, i, code)
}

// W-WIN11 gate line: where a snapped window ended up -- `wm: snap id= zone= x= y= w= h=` (zone: 1 left, 2 right, 3 top = maximize, 9..12 corners)
fn snap_say(state: u64, i: u64, code: u64) {
    var s_sn: [u8; 13] = "wm: snap id=\0"
    var s_snz: [u8; 7] = " zone=\0"
    var s_snx: [u8; 4] = " x=\0"
    var s_sny: [u8; 4] = " y=\0"
    var s_snw: [u8; 4] = " w=\0"
    var s_snh: [u8; 4] = " h=\0"
    serial.puts((&s_sn[0]) as u64)
    serial.dec(wg(state, i, W_ID))
    serial.puts((&s_snz[0]) as u64)
    serial.dec(code)
    serial.puts((&s_snx[0]) as u64)
    serial.dec(win_x(state, i) as u64)
    serial.puts((&s_sny[0]) as u64)
    serial.dec(win_y(state, i) as u64)
    serial.puts((&s_snw[0]) as u64)
    serial.dec(outer_w(state, i))
    serial.puts((&s_snh[0]) as u64)
    serial.dec(outer_h(state, i))
    serial.nl()
}

// a maximized / snapped window that is dragged far enough comes back to its old size, the pointer keeping its place on the title bar
fn float_unmax(state: u64, i: u64, x: i64, y: i64) -> bool {
    if fb.nosnap_an(state) || !valid(state, i) || gs(state, S_TILE) != 0 || wg(state, i, W_NODE) != 0 {
        return false
    }
    if (wg(state, i, W_FLAGS) & F_MAXIMIZED) == 0 || wg(state, i, W_LAYER) != L_NORMAL {
        return false
    }
    if (wg(state, i, W_SAVE) & 0xFFFFFFFF) == 0 {
        return false
    }
    let ow: i64 = outer_w(state, i) as i64
    let off: i64 = x - win_x(state, i)
    let dy: i64 = gs(state, S_DRAGY) as i64
    if !maximize(state, i, false) {
        return false
    }
    let nw: i64 = outer_w(state, i) as i64
    var nx: i64 = x
    if ow > 0 {
        nx = x - off * nw / ow
    }
    move_win(state, i, nx, y - dy)
    ss(state, S_DRAGX, (x - win_x(state, i)) as u64)
    damage_all(state)
    return true
}

fn drag_hover(state: u64, i: u64, x: i64, y: i64) {
    if gs(state, S_TILE) == 0 {
        float_hover(state, i, x, y)
        return
    }
    preview_damage(state)
    ss(state, S_PVON, 0)
    ss(state, S_DROPN, 0)
    ss(state, S_DROPE, 0)
    // r826: edge docking works on the primary head's work area only; on another head there is no preview and no drop.
    var wx0: i64 = gs(state, S_WORK_X) as i64
    var wy0: i64 = gs(state, S_WORK_Y) as i64
    var sw: i64 = gs(state, S_WORK_W) as i64
    var sh: i64 = gs(state, S_WORK_H) as i64
    // r839: with several heads the head under the pointer is the drop target (its work area, its tree); an edge that
    // touches the next head (the seam) is no docking edge
    var nl: bool = true
    var nr: bool = true
    var nt: bool = true
    var nb: bool = true
    tl_drop_tag = 0
    if hd_multi(state) {
        let hd: u64 = hd_at(state, x, y)
        if hd >= HD_MAX {
            return
        }
        let hp: u64 = head_work(state, hd)
        wx0 = hw_x(hp) as i64
        wy0 = hw_y(hp) as i64
        sw = hw_w(hp) as i64
        sh = hw_h(hp) as i64
        let hx: i64 = hd_x(state, hd) as i64
        let hy: i64 = hd_y(state, hd) as i64
        nl = hd_at(state, hx - 1, y) == HD_MAX
        nr = hd_at(state, hx + hd_w(state, hd) as i64, y) == HD_MAX
        nt = hd_at(state, x, hy - 1) == HD_MAX
        nb = hd_at(state, x, hy + hd_h(state, hd) as i64) == HD_MAX
        tl_drop_tag = tl_tag_head(state, hd)
    }
    // DELL ROUND (04.10.2026): the snap strip was 16 px, so a window that
    // was only pushed a little over the edge snapped to half the screen
    // (or jumped back). Now 2 px at scale 1: the pointer must be AT the
    // screen edge.
    var rand: i64 = 2 * uisc(state) as i64
    if fb.winfix_aus(state) {
        rand = 16
    }
    // 1. AM BILDSCHIRMRAND: die Windows-artige Schnellablage. Sie ist
    //    ein Sonderfall des Baumes und kein zweites System.
    if x < wx0 + rand && nl {
        ss(state, S_DROPE, 1)
        set_preview(state, wx0 as u64, wy0 as u64, (sw / 2) as u64,
            sh as u64)
        preview_damage(state)
        return
    }
    if x >= wx0 + sw - rand && nr {
        ss(state, S_DROPE, 2)
        set_preview(state, (wx0 + sw - sw / 2) as u64, wy0 as u64,
            (sw / 2) as u64, sh as u64)
        preview_damage(state)
        return
    }
    if y < wy0 + rand && nt {
        ss(state, S_DROPE, 3)
        set_preview(state, wx0 as u64, wy0 as u64, sw as u64,
            (sh / 2) as u64)
        preview_damage(state)
        return
    }
    if y >= wy0 + sh - rand && nb {
        ss(state, S_DROPE, 4)
        set_preview(state, wx0 as u64, (wy0 + sh - sh / 2) as u64,
            sw as u64, (sh / 2) as u64)
        preview_damage(state)
        return
    }
    // 2. AUF EINEM ANDEREN FENSTER: das Viertel, in dem der Zeiger
    //    steht, sagt die Seite. Die Mitte heisst REITER.
    // the tree of that head (none yet: nothing to drop onto)
    if tl_drop_tag != 0 && tl_alt[tl_drop_tag as usize] == 0 {
        return
    }
    tl_sel(state, tl_drop_tag)
    let n: u64 = leaf_at(state, x, y)
    if n == tile.NONE {
        return
    }
    let nx: u64 = tile.n_x(tt(state), n)
    let ny: u64 = tile.n_y(tt(state), n)
    let w: u64 = tile.n_w(tt(state), n)
    let h: u64 = tile.n_h(tt(state), n)
    let fx: u64 = (x - nx as i64) as u64
    let fy: u64 = (y - ny as i64) as u64
    var page: u64 = 4
    if fx * 4 < w {
        page = tile.D_LEFT
    } else {
        if fx * 4 >= w * 3 {
            page = tile.D_RIGHT
        } else {
            if fy * 4 < h {
                page = tile.D_UP
            } else {
                if fy * 4 >= h * 3 {
                    page = tile.D_DOWN
                }
            }
        }
    }
    ss(state, S_DROPN, n + 1)
    ss(state, S_DROPS, page)
    if page == tile.D_LEFT {
        set_preview(state, nx, ny, w / 2, h)
    }
    if page == tile.D_RIGHT {
        set_preview(state, nx + w - w / 2, ny, w / 2, h)
    }
    if page == tile.D_UP {
        set_preview(state, nx, ny, w, h / 2)
    }
    if page == tile.D_DOWN {
        set_preview(state, nx, ny + h - h / 2, w, h / 2)
    }
    if page == 4 {
        set_preview(state, nx, ny, w, h)
    }
    preview_damage(state)
}

// ============================================== RUNDE GLAS (fix-r4-2)
// DIE ENDLAGE LIEGT AUF DER ARBEITSFLAECHE -- GEZOGEN WIRD UEBERALL.
//
// Beim ZIEHEN darf ein Fenster unter die Leiste wandern; genau daran
// misst die Abnahme, dass die Leiste ihren Untergrund neu mischt
// (`unter_leiste_messen`, Abschnitt 11f). Beim LOSLASSEN darf es dort
// nicht liegen bleiben: was unter der Leiste endet, ist nicht mehr
// anzufassen, und was unter der unteren Schirmkante endet, ist gar
// nicht mehr da. Auf der Aufnahme 15 der Runde hing das untere Drittel
// des Fensters ausserhalb des Schirms -- `shotcheck.py` zaehlte dreizehn
// Beschriftungen als `ausserhalb`, und der Reglerblock der Seite
// "Darstellung" war nicht mehr zu sehen.
//
// Geklemmt wird die AEUSSERE Huelle (Rahmen und Titelzeile mitgezaehlt)
// auf die Arbeitsflaeche, und zwar nur nach unten und rechts bzw. oben
// und links -- die Groesse des Fensters bleibt unangetastet. Ist das
// Fenster groesser als die Arbeitsflaeche, gewinnt die obere linke
// Ecke: lieber unten abgeschnitten als oben, denn oben sitzt die
// Titelzeile, an der man es wieder anfassen kann.
fn drag_klemmen(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    let wx0: i64 = win_x(state, i)
    let wy0: i64 = win_y(state, i)
    let aw: i64 = outer_w(state, i) as i64
    let ah: i64 = outer_h(state, i) as i64
    // r826: the work area of the window's HOME head (the plain one on a single screen)
    let kwk: u64 = win_work(state, i)
    let ax0: i64 = hw_x(kwk) as i64
    let ay0: i64 = hw_y(kwk) as i64
    let ax1: i64 = ax0 + hw_w(kwk) as i64
    let ay1: i64 = ay0 + hw_h(kwk) as i64
    // DELL ROUND (04.10.2026, Justin): "a window pushed a little over the
    // screen edge jumps right back". The old rule kept the WHOLE window
    // on the work area. Now it may stick out on the left, right and
    // bottom: it only has to keep a strip it can be grabbed by --
    //   * the title bar must stay on the work area vertically (top
    //     edge >= work top, top edge <= work bottom - title bar);
    //   * horizontally at least VIS_MIN px of the window stay in sight.
    // A window that is fully inside is never touched.
    var vis: i64 = (VIS_MIN0 * uisc(state)) as i64
    if vis > aw {
        vis = aw
    }
    var tb: i64 = title_h(state) as i64
    if fb.winfix_aus(state) {
        // counter-proof: the old rule, the whole window stays on the work area
        vis = aw
        tb = ah
    }
    var nx: i64 = wx0
    var ny: i64 = wy0
    if nx > ax1 - vis {
        nx = ax1 - vis
    }
    if nx + aw < ax0 + vis {
        nx = ax0 + vis - aw
    }
    if ny > ay1 - tb {
        ny = ay1 - tb
    }
    if ny < ay0 {
        ny = ay0
    }
    if nx == wx0 && ny == wy0 {
        return
    }
    move_win(state, i, nx, ny)
    // UND ES WIRD GESAGT. Eine Endlage, die der Server selbst gesetzt
    // hat, ist fuer jeden Laeufer sonst ein Raetsel: er hat nach
    // `400,600` gezogen und findet das Fenster bei `400,512`.
    // Und die Stelle VOR dem Klemmen steht daneben: aus ihr rechnet
    // `tools/themestore/run.sh` die Schnittflaeche mit der Leiste noch
    // einmal nach, und zwar auf dem Wirt. Ohne sie gaebe es fuer die
    // Flaeche, die der Server waehrend des Zuges gesehen hat, nur noch
    // seine eigene Zahl -- und eine Zahl, die sich selbst bestaetigt,
    // ist in dieser Abnahme keine.
    var s_k: [u8; 17] = "wm: geklemmt id=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_vx: [u8; 7] = " vorx=\0"
    var s_vy: [u8; 7] = " vory=\0"
    var s_aw: [u8; 4] = " w=\0"
    var s_ah: [u8; 4] = " h=\0"
    serial.puts((&s_k[0]) as u64)
    serial.dec(wg(state, i, W_ID))
    serial.puts((&s_x[0]) as u64)
    serial.dec(nx as u64)
    serial.puts((&s_y[0]) as u64)
    serial.dec(ny as u64)
    serial.puts((&s_vx[0]) as u64)
    serial.dec(wx0 as u64)
    serial.puts((&s_vy[0]) as u64)
    serial.dec(wy0 as u64)
    serial.puts((&s_aw[0]) as u64)
    serial.dec(aw as u64)
    serial.puts((&s_ah[0]) as u64)
    serial.dec(ah as u64)
    serial.nl()
}

// UND DER RUMPF WIRD SCHMUTZIG -- BEIM LOSLASSEN, NICHT BEI JEDEM
// MILLIMETER.
//
// Ein verschobenes Fenster behaelt seinen Puffer, der Server malt ihn
// an der neuen Stelle, und bis hierher erfuhr das PROGRAMM davon
// nichts. Es meldete seine Beschriftungen deshalb weiter zu dem
// Ursprung, an dem es zuletzt gemalt hatte -- auf der Aufnahme 15 der
// Runde lagen sie 590 Bildpunkte ueber ihrer wirklichen Stelle, und
// `shotcheck.py` zaehlte acht leere Beschriftungen, wo in Wahrheit
// keine fehlte. Der Nachtrag zu 8.1 hat den Ursprung in
// `wlib.flush_win` nachfragen lassen; gerufen wird `flush_win` aber
// nur, wenn das Programm ueberhaupt malt.
//
// Also bekommt es nach dem Zug einen Grund dazu: dasselbe Ereignis,
// mit dem eine Groessenaenderung ankommt, mit der UNVERAENDERTEN
// Groesse. `wlib` macht daraufhin den ganzen Rumpf schmutzig, malt ihn
// und meldet dabei jedes Rechteck zu der Stelle, an der das Fenster
// jetzt wirklich steht.
//
// HIER und nicht in `move_win`: `move_win` laeuft bei jeder
// Zeigerbewegung des Zuges, das waeren dreissig Vollanstriche je
// Sekunde fuer eine Stelle, die sich im naechsten Millimeter wieder
// aendert.
fn rumpf_neu(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    ev_push(state, i, E_RESIZE, wg(state, i, W_W), wg(state, i, W_H), 0)
    damage_win(state, i)
}

fn drag_end(state: u64, i: u64, x: i64, y: i64) {
    // RUNDE ZIEH: LOSGELASSEN. Das Fenster steht ab sofort wieder in
    // seiner wahren Groesse; was noch laeuft, ist der Nachzug, der
    // gegen null pendelt (`swing_tick`, Zweig "nicht mehr gezogen").
    // `W_SWOFF` haelt fest, dass da noch etwas auszupendeln ist --
    // auch wenn der Versatz in diesem Augenblick zufaellig 0 ist.
    wsv(state, i, W_SWOFF, kstate.get(state, kstate.TICKS) + 1)
    damage_win_lift(state, i)
    preview_damage(state)
    ss(state, S_PVON, 0)
    drag_klemmen(state, i)
    // DELL ROUND: where the window ended up (after the clamp), so a runner
    // can tell "sticks out a little" from "jumped back".
    var s_ab: [u8; 18] = "wm: abgelegt id=\0\0"
    var s_abx: [u8; 4] = " x=\0"
    var s_aby: [u8; 4] = " y=\0"
    var s_abw: [u8; 4] = " w=\0"
    var s_abh: [u8; 4] = " h=\0"
    serial.puts((&s_ab[0]) as u64)
    serial.dec(wg(state, i, W_ID))
    serial.puts((&s_abx[0]) as u64)
    serial.dec(win_x(state, i) as u64)
    serial.puts((&s_aby[0]) as u64)
    serial.dec(win_y(state, i) as u64)
    serial.puts((&s_abw[0]) as u64)
    serial.dec(outer_w(state, i))
    serial.puts((&s_abh[0]) as u64)
    serial.dec(outer_h(state, i))
    serial.nl()
    rumpf_neu(state, i)
    if gs(state, S_TILE) == 0 {
        let fe: u64 = gs(state, S_DROPE)
        if fe != 0 {
            float_drop(state, i, fe)
        }
        ss(state, S_DROPE, 0)
        ss(state, S_DRAGT, 0)
        return
    }
    let e: u64 = gs(state, S_DROPE)
    if e != 0 {
        let _u: bool = tl_use(state, tl_drop_tag)
        let n: u64 = tile.insert(tt(state), i + 1)
        if n != tile.NONE {
            wsv(state, i, W_NODE, nd_val(n))
            var wo: u64 = tile.SNAP_LEFT
            if e == 2 {
                wo = tile.SNAP_RIGHT
            }
            if e == 3 {
                wo = tile.SNAP_TOP
            }
            if e == 4 {
                wo = tile.SNAP_BOTTOM
            }
            tile.snap(tt(state), n, wo)
            tile_apply(state)
            damage_all(state)
        }
        ss(state, S_DRAGT, 0)
        ss(state, S_DROPE, 0)
        return
    }
    let d: u64 = gs(state, S_DROPN)
    if d != 0 {
        let ziel: u64 = d - 1
        let page: u64 = gs(state, S_DROPS)
        tl_sel(state, tl_drop_tag)
        var n: u64 = tile.NONE
        if page == 4 {
            n = tile.insert_at(tt(state), ziel, tile.D_RIGHT, i + 1)
            if n != tile.NONE {
                tile.set_layout(tt(state), n, tile.LAY_TABBED)
            }
        } else {
            n = tile.insert_at(tt(state), ziel, page, i + 1)
        }
        if n != tile.NONE {
            wsv(state, i, W_NODE, nd_val(n))
            tile_apply(state)
            damage_all(state)
        }
    } else {
        if gs(state, S_DRAGT) != 0 {
            tile_take(state, i)
            damage_all(state)
        }
    }
    ss(state, S_DRAGT, 0)
    ss(state, S_DROPN, 0)
}

// Der Griff unten rechts an einem GEKACHELTEN Fenster verschiebt das
// Verhaeltnis am inneren Knoten -- nicht die Groesse des Fensters. Alles
// andere waere eine Luecke.
fn tile_drag_resize(state: u64, i: u64, x: i64, y: i64) {
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return
    }
    tl_sel(state, nd_tag(nd))
    let n: u64 = nd_node(nd)
    let p: u64 = tile.n_parent(tt(state), n)
    if p == tile.NONE || tile.n_layout(tt(state), p) != tile.LAY_SPLIT {
        return
    }
    var total: u64 = tile.n_h(tt(state), p)
    var will: i64 = y - tile.n_y(tt(state), n) as i64
    var ist: i64 = tile.n_h(tt(state), n) as i64
    if tile.n_dir(tt(state), p) == tile.DIR_H {
        total = tile.n_w(tt(state), p)
        will = x - tile.n_x(tt(state), n) as i64
        ist = tile.n_w(tt(state), n) as i64
    }
    if total == 0 {
        return
    }
    let dpx: i64 = will - ist
    if dpx == 0 {
        return
    }
    let d: i64 = dpx * tile.FRAC_ONE as i64 / total as i64
    if d == 0 {
        return
    }
    if tile.resize_at(tt(state), n, d) {
        tile_apply(state)
        damage_tile(state)
    }
}

// -------------------------------------------------- die Tastenkuerzel

fn hot_take_raw(state: u64) -> u64 {
    let kopf: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_HHEAD)
    let schwanz: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_HTAIL)
    if kopf == schwanz {
        return 0
    }
    let p: u64 = state + kstate.K11_OFF + kstate.KB_HOT + (schwanz % 16) * 2
    let c: u64 = kstate.get8(p)
    let m: u64 = kstate.get8(p + 1)
    kstate.set(state, kstate.K11_OFF + kstate.KB_HTAIL, schwanz + 1)
    return (m << 8) | c
}

// W1 (hotkeys): put a floating window on the left/right half of its work area. The way back (position + size) is saved
// the way `maximize` saves it and the window carries F_MAXIMIZED, so Win+Down (maximize off) restores it.
fn snap_half(state: u64, i: u64, right: bool) -> bool {
    if !valid(state, i) {
        return false
    }
    let f: u64 = wg(state, i, W_FLAGS)
    if (f & F_MAXIMIZED) == 0 {
        let sx: u64 = ((win_x(state, i) + 4096) as u64) & 0xFFFF
        let sy: u64 = ((win_y(state, i) + 4096) as u64) & 0xFFFF
        wsv(state, i, W_SAVE, (sx << 48) | (sy << 32)
            | ((wg(state, i, W_W) & 0xFFFF) << 16)
            | (wg(state, i, W_H) & 0xFFFF))
        wsv(state, i, W_FLAGS, f | F_MAXIMIZED)
    }
    let hwk: u64 = win_work(state, i)
    let half: u64 = hw_w(hwk) / 2
    var iw: u64 = half
    var ih: u64 = hw_h(hwk)
    if deko(state, i) {
        if iw <= border(state) * 2 || ih <= iny(state, i) + border(state) {
            wsv(state, i, W_FLAGS, f)
            return false
        }
        iw = iw - border(state) * 2
        ih = ih - iny(state, i) - border(state)
    }
    if !resize_win(state, i, iw, ih) {
        wsv(state, i, W_FLAGS, f)
        return false
    }
    var nx: u64 = hw_x(hwk)
    if right {
        nx = nx + half
    }
    move_win(state, i, nx as i64, hw_y(hwk) as i64)
    return true
}

fn snap_near(a: i64, b: i64) -> bool {
    var d: i64 = a - b
    if d < 0 {
        d = 0 - d
    }
    return d <= 2
}

fn snap_code_of(state: u64, i: u64) -> u64 {
    if (wg(state, i, W_FLAGS) & F_MAXIMIZED) == 0 {
        return 0
    }
    let wk: u64 = win_work(state, i)
    var n: u64 = 0
    while n < 6 {
        var c: u64 = n + 7
        if n < 2 {
            c = n + 1
        }
        let r: u64 = snap_rect(wk, c)
        if snap_near(win_x(state, i), hw_x(r) as i64) && snap_near(win_y(state, i), hw_y(r) as i64)
            && snap_near(outer_w(state, i) as i64, hw_w(r) as i64) && snap_near(outer_h(state, i) as i64, hw_h(r) as i64) {
            return c
        }
        n = n + 1
    }
    return 0
}

fn snap_key_target(cur: u64, key: u64) -> u64 {
    if key == 0x83 {
        if cur == 1 {
            return 9
        }
        if cur == 2 {
            return 10
        }
        if cur == 11 {
            return 1
        }
        if cur == 12 {
            return 2
        }
    }
    if key == 0x84 {
        if cur == 1 {
            return 11
        }
        if cur == 2 {
            return 12
        }
        if cur == 9 {
            return 1
        }
        if cur == 10 {
            return 2
        }
    }
    if key == 0x81 {
        if cur == 10 {
            return 9
        }
        if cur == 12 {
            return 11
        }
    }
    if key == 0x82 {
        if cur == 9 {
            return 10
        }
        if cur == 11 {
            return 12
        }
    }
    return 0
}

fn snap_to_code(state: u64, i: u64, code: u64) -> bool {
    if code == 1 || code == 2 {
        let ok: bool = snap_half(state, i, code == 2)
        if ok {
            snap_say(state, i, code)
        }
        return ok
    }
    if !fit_rect(state, i, snap_rect(win_work(state, i), code)) {
        return false
    }
    damage_all(state)
    snap_say(state, i, code)
    return true
}

// W1 (hotkeys): Win+Left/Right = snap to a half, Win+Up = maximize, Win+Down = restore (tiled/maximized) or minimize.
// A second press while snapped moves between half and quarter (Windows 11): half + Up/Down = top/bottom quarter, quarter + Left/Right = the other side, quarter + opposite vertical = half again.
fn win_arrow(state: u64, key: u64) -> bool {
    let i: u64 = focus(state)
    if i >= MAX_WIN {
        return false
    }
    if !deko(state, i) || wg(state, i, W_LAYER) != L_NORMAL || !darf(state, i) {
        return false
    }
    if wg(state, i, W_NODE) == 0 {
        let tgt: u64 = snap_key_target(snap_code_of(state, i), key)
        if tgt != 0 && snap_to_code(state, i, tgt) {
            return true
        }
    }
    if key == 0x81 || key == 0x82 {
        if wg(state, i, W_NODE) != 0 {
            let _t: bool = tile_float(state, i)
        }
        return snap_half(state, i, key == 0x82)
    }
    if key == 0x83 {
        if wg(state, i, W_NODE) != 0 {
            let _f: bool = tile_float(state, i)
        }
        if !maximize(state, i, true) {
            return false
        }
        // a half-snapped window carries F_MAXIMIZED too (it saves the way back there): grow it to the whole work area
        return fit_work(state, i)
    }
    if key == 0x84 {
        if wg(state, i, W_NODE) != 0 {
            return tile_float(state, i)
        }
        if (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0 {
            return maximize(state, i, false)
        }
        return minimize_anim(state, i)
    }
    return false
}

fn hotkeys(state: u64) -> u64 {
    var n: u64 = 0
    var weiter: bool = true
    var guard: u64 = 0
    while weiter && guard < 16 {
        guard = guard + 1
        let v: u64 = hot_take_raw(state)
        if v == 0 {
            weiter = false
        } else {
            n = n + 1
            ss(state, S_HOTS, gs(state, S_HOTS) + 1)
            // r382 LOCK SEAL: WHILE THE SCREEN IS LOCKED A SHORTCUT DOES
            // NOTHING -- not Alt+Tab (raised and focused a window behind
            // the lock), not close (destroyed it), not full screen, snap,
            // tile; and no plugin hears it. The key is taken off the ring
            // and thrown away, and the line below says so.
            if sperre_an(state) {
                var s_hl: [u8; 20] = "wm: hot gesperrt c=\0"
                var s_hn: [u8; 6] = " mod=\0"
                serial.puts((&s_hl[0]) as u64)
                serial.dec(v & 0xFF)
                serial.puts((&s_hn[0]) as u64)
                serial.dec((v >> 8) & 0xFF)
                serial.nl()
            } else
            if sw_open != 0 && (v & 0xFF) == 27 {
                sw_cancel(state)
            } else
            // FPS-OV: Ctrl+Alt+F (mods 5 = Alt + Ctrl, 7 with Shift) switches the frame-rate overlay
            if ((v & 0xFF) == 102 || (v & 0xFF) == 70) && ((v >> 8) & 0xFD) == 5 {
                fps_hotkey(state)
            } else
            // REPAINT-1: Ctrl+Alt+R recomposes the whole screen from the window buffers (reference picture of the stale-pixel gate)
            if ((v & 0xFF) == 114 || (v & 0xFF) == 82) && ((v >> 8) & 0xFD) == 5 {
                repaint_hotkey(state)
            } else
            // W1 (hotkeys): WIN+ARROWS (mod 8) -- the focused window snaps / maximizes / restores, before any binding.
            if ((v >> 8) & 0xFF) == 8 {
                let wa: bool = win_arrow(state, v & 0xFF)
                var s_wh: [u8; 18] = "wm: winarrow key=\0"
                var s_wg: [u8; 8] = " getan=\0"
                serial.puts((&s_wh[0]) as u64)
                serial.dec(v & 0xFF)
                serial.puts((&s_wg[0]) as u64)
                if wa {
                    serial.dec(1)
                } else {
                    serial.dec(0)
                }
                serial.nl()
            } else
            // RUNDE WMPLUGIN: DAS PLUGIN KOMMT VOR DER BINDUNG DES
            // KACHELBAUMS. Wer ein Kuerzel belegt hat, bekommt es --
            // und `tile_action` laeuft dafuer gar nicht erst an. Sonst
            // taete Alt+2 zweierlei auf einmal, je nachdem, was gerade
            // geladen ist, und das ist genau die Art Ueberraschung, die
            // ein Erweiterungssystem nicht haben darf.
            if wmplug.key_owner(state, v & 0xFF, (v >> 8) & 0xFF)
                < wmplug.MAX_PLUG {
                wmplug.notify(state, wmplug.E_KEY, v & 0xFF,
                    (v >> 8) & 0xFF, 0)
                ss(state, S_KPLUG, gs(state, S_KPLUG) + 1)
                var s_ph: [u8; 17] = "wm: plughot c=\0\0\0"
                var s_pj: [u8; 6] = " mod=\0"
                serial.puts((&s_ph[0]) as u64)
                serial.dec(v & 0xFF)
                serial.puts((&s_pj[0]) as u64)
                serial.dec((v >> 8) & 0xFF)
                serial.nl()
            } else {
                var act: u64 = tile.bind_lookup(state, v & 0xFF, (v >> 8) & 0xFF)
                // W1d: Alt+Shift+Tab goes backwards through the switcher (only while Alt+Tab is the stock next-window binding)
                if act == tile.A_NONE && (v & 0xFF) == 9 && ((v >> 8) & 0xFF) == 3
                    && tile.bind_lookup(state, 9, 1) == tile.A_NEXT_WIN {
                    act = ACT_PREV_WIN
                }
                // RUNDE TUERSCHLOSS: WAS DER RING HERGAB UND WAS DARAUS
                // WURDE. Drei Zahlen, und sie trennen die drei Faelle, die
                // sonst gleich aussehen: Taste kam nicht an (keine Zeile),
                // Taste kam an, aber keine Bindung (act=0), Bindung da, aber
                // die Handlung tat nichts (getan=0).
                var s_hk: [u8; 12] = "wm: hot c=\0\0"
                var s_hm: [u8; 6] = " mod=\0"
                var s_ha: [u8; 6] = " act=\0"
                serial.puts((&s_hk[0]) as u64)
                serial.dec(v & 0xFF)
                serial.puts((&s_hm[0]) as u64)
                serial.dec((v >> 8) & 0xFF)
                serial.puts((&s_ha[0]) as u64)
                serial.dec(act)
                // DIE ZEILE WIRD ZUERST FERTIG. `tile_action` ruft
                // `set_focus`, und das schreibt seit dieser Runde selbst auf
                // die Leitung -- mitten in diese Zeile hinein. Gemessen:
                //     wm: hot c=9 mod=1 act=30wm: fokus id=7 vor=15
                // Beide Angaben stimmen, aber `act=30` und die Fokuszeile
                // kleben aneinander, und ein Muster, das auf das Zeilenende
                // wartet, findet keines von beiden. Also: Zeilenumbruch vor
                // der Handlung, das Ergebnis kommt in eine eigene Zeile.
                serial.nl()
                let getan: bool = tile_action(state, act)
                var s_hr: [u8; 15] = "wm: hot getan=\0"
                serial.puts((&s_hr[0]) as u64)
                if getan {
                    serial.dec(1)
                } else {
                    serial.dec(0)
                }
                serial.nl()
                if getan {
                    ss(state, S_ACTS, gs(state, S_ACTS) + 1)
                }
            }
        }
    }
    return n
}

// RUNDE TUERSCHLOSS: DAS NAECHSTE FENSTER, das ein Mensch meint.
//
// WELCHE FENSTER MITZAEHLEN. Nicht jedes Fenster ist eines, zu dem man
// wechseln will: der Schreibtisch (`L_DESK`) ist der Hintergrund, die
// Taskleiste (`L_TOP`) ist Bedienung, und ein verborgenes (`F_HIDDEN`)
// steht nicht auf dem Schirm. Es bleiben die gewoehnlichen Anwendungen
// auf `L_NORMAL` -- genau die, die auch eine Titelleiste tragen.
//
// WARUM IM KREIS AB DEM FOKUS und nicht immer von vorn: sonst wechselt
// Alt+Tab bei drei Fenstern ewig zwischen den ersten beiden. Der Ring
// laeuft `von+1 .. von+MAX_WIN` und rechnet modulo -- damit kommt jedes
// Fenster genau einmal vorbei, und das eigene zuletzt.
//
// Der Rueckgabewert sagt, ob sich WIRKLICH etwas geaendert hat: bei
// einem einzigen Fenster ist Alt+Tab folgenlos, und das ist kein
// Fehler, sondern die Wahrheit.
fn wechselbar(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if (wg(state, i, W_FLAGS) & F_HIDDEN) != 0 {
        return false
    }
    return wg(state, i, W_LAYER) == L_NORMAL
}

fn next_window(state: u64, von: u64) -> bool {
    var k: u64 = 1
    while k <= MAX_WIN {
        let j: u64 = (von + k) % MAX_WIN
        if wechselbar(state, j) && j != von {
            raise_win(state, j)
            set_focus(state, j)
            damage_win(state, j)
            return true
        }
        k = k + 1
    }
    return false
}

fn prev_window(state: u64, von: u64) -> bool {
    var k: u64 = 1
    while k <= MAX_WIN {
        let j: u64 = (von + MAX_WIN - (k % MAX_WIN)) % MAX_WIN
        if wechselbar(state, j) && j != von {
            raise_win(state, j)
            set_focus(state, j)
            damage_win(state, j)
            return true
        }
        k = k + 1
    }
    return false
}


// ===================================================================================================================
// W1d: THE ALT+TAB SWITCHER (Windows 11 style). One overlay panel with a tile per switchable window (a scaled picture of
// the window + its title). Alt+Tab opens it with the SECOND window (most recently used) selected, every further Tab moves
// right, Shift+Tab moves left, releasing Alt switches to the selected window, Esc closes it without a change.
// The list is the z-order from the top (= most recently used: raising a window is what focusing does), the focused window
// first. While the panel is open nothing is raised or focused -- the switch happens on release, like on Windows.
// Alt release is read from the keyboard state (kbd KB_OLD) once per tick; if Alt is already up when the first Tab is
// handled (a quick tap, e.g. a test harness) the panel opens and commits in the same call.
// ===================================================================================================================
static mut sw_open: u64 = 0
static mut sw_n: u64 = 0
static mut sw_sel: u64 = 0
static mut sw_list: [u64; 32] = [0 as u64; 32]
static mut sw_commits: u64 = 0
const ACT_PREV_WIN: u64 = 64

fn sw_alt_held(state: u64) -> bool {
    return kstate.get(state, kstate.K11_OFF + kstate.KB_OLD) == 1
}

fn sw_say(state: u64, ev: u64) {
    var s_o: [u8; 21] = "wm: switcher open n=\0"
    var s_s: [u8; 21] = "wm: switcher step n=\0"
    var s_c: [u8; 23] = "wm: switcher commit n=\0"
    var s_x: [u8; 23] = "wm: switcher cancel n=\0"
    var s_l: [u8; 6] = " sel=\0"
    var s_w: [u8; 6] = " win=\0"
    var s_h: [u8; 6] = " hid=\0"
    var s_m: [u8; 7] = " mins=\0"
    if ev == 0 {
        serial.puts((&s_o[0]) as u64)
    } else if ev == 1 {
        serial.puts((&s_s[0]) as u64)
    } else if ev == 2 {
        serial.puts((&s_c[0]) as u64)
    } else {
        serial.puts((&s_x[0]) as u64)
    }
    serial.dec(sw_n)
    serial.puts((&s_l[0]) as u64)
    serial.dec(sw_sel)
    serial.puts((&s_w[0]) as u64)
    var wid: u64 = 99
    if sw_sel < sw_n {
        wid = sw_list[sw_sel as usize]
    }
    serial.dec(wid)
    // X1: hid = the selected tile is a minimized window, mins = how many minimized windows the panel lists
    serial.puts((&s_h[0]) as u64)
    if wid < MAX_WIN && sw_minimized(state, wid) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_m[0]) as u64)
    var mc: u64 = 0
    var t: u64 = 0
    while t < sw_n {
        if sw_minimized(state, sw_list[t as usize]) {
            mc = mc + 1
        }
        t = t + 1
    }
    serial.dec(mc)
    serial.nl()
}

// the panel geometry: out[0..9] = x, y, w, h, cell w, cell h, gap, pad, cols, scale percent
static mut sw_g: [i64; 10] = [0 as i64; 10]

fn sw_dim(state: u64, v: i64, k: i64) -> i64 {
    return v * (uisc(state) as i64) * k / 100
}

fn sw_geom(state: u64) {
    let wx: i64 = gs(state, S_WORK_X) as i64
    let wy: i64 = gs(state, S_WORK_Y) as i64
    let ww: i64 = gs(state, S_WORK_W) as i64
    let wh: i64 = gs(state, S_WORK_H) as i64
    let n: i64 = sw_n as i64
    var k: i64 = 100
    var cw: i64 = 0
    var ch: i64 = 0
    var gap: i64 = 0
    var pad: i64 = 0
    var cols: i64 = 1
    var rows: i64 = 1
    var pw: i64 = 0
    var ph: i64 = 0
    var go: bool = true
    while go {
        cw = sw_dim(state, 208, k)
        ch = sw_dim(state, 164, k)
        gap = sw_dim(state, 8, k)
        pad = sw_dim(state, 20, k)
        cols = (ww - sw_dim(state, 64, k) - 2 * pad + gap) / (cw + gap)
        if cols < 1 {
            cols = 1
        }
        if cols > n {
            cols = n
        }
        if cols < 1 {
            cols = 1
        }
        rows = (n + cols - 1) / cols
        pw = cols * cw + (cols - 1) * gap + 2 * pad
        ph = rows * ch + (rows - 1) * gap + 2 * pad
        if (ph <= wh - sw_dim(state, 64, k) && pw <= ww) || k <= 40 {
            go = false
        } else {
            k = k - 10
        }
    }
    sw_g[0 as usize] = wx + (ww - pw) / 2
    sw_g[1 as usize] = wy + (wh - ph) / 2
    sw_g[2 as usize] = pw
    sw_g[3 as usize] = ph
    sw_g[4 as usize] = cw
    sw_g[5 as usize] = ch
    sw_g[6 as usize] = gap
    sw_g[7 as usize] = pad
    sw_g[8 as usize] = cols
    sw_g[9 as usize] = k
}

fn sw_damage(state: u64) {
    sw_geom(state)
    let x: i64 = sw_g[0 as usize]
    let y: i64 = sw_g[1 as usize]
    damage(state, x - 2, y - 2, x + sw_g[2 as usize] + 2, y + sw_g[3 as usize] + 2)
}

// X1: a minimized window (F_HIDDEN, normal layer, with a frame, not behind a tab) is listed too; committing it restores it.
fn sw_minimized(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    let f: u64 = wg(state, i, W_FLAGS)
    if (f & F_HIDDEN) == 0 || (f & F_TABBED) != 0 || (f & F_NODECO) != 0 || tt_is_bg(state, i) {
        return false
    }
    return wg(state, i, W_LAYER) == L_NORMAL
}

fn sw_listable(state: u64, i: u64) -> bool {
    return wechselbar(state, i) || sw_minimized(state, i)
}

fn sw_build(state: u64) {
    sw_n = 0
    let fo: u64 = focus(state)
    if fo < MAX_WIN && sw_listable(state, fo) {
        sw_list[0 as usize] = fo
        sw_n = 1
    }
    var z: u64 = gs(state, S_COUNT)
    while z > 0 && sw_n < 32 {
        z = z - 1
        let w: u64 = at_z(state, z)
        if w < MAX_WIN && sw_listable(state, w) && w != fo {
            sw_list[sw_n as usize] = w
            sw_n = sw_n + 1
        }
    }
}

fn sw_close(state: u64) {
    if sw_open == 0 {
        return
    }
    sw_damage(state)
    sw_open = 0
}

fn sw_commit(state: u64) {
    if sw_open == 0 {
        return
    }
    sw_say(state, 2)
    var j: u64 = MAX_WIN
    if sw_sel < sw_n {
        j = sw_list[sw_sel as usize]
    }
    sw_close(state)
    if j < MAX_WIN && sw_minimized(state, j) {
        set_hidden(state, j, false) // X1: a minimized tile restores the window
    }
    if j < MAX_WIN && wechselbar(state, j) {
        raise_win(state, j)
        set_focus(state, j)
        damage_win(state, j)
        sw_commits = sw_commits + 1
    }
}

fn sw_cancel(state: u64) {
    if sw_open == 0 {
        return
    }
    sw_say(state, 3)
    sw_close(state)
}

// one Alt+Tab (back = false) or Alt+Shift+Tab (back = true). Returns true if the panel is (or was just) open.
fn sw_step(state: u64, back: bool) -> bool {
    if sw_open == 0 {
        sw_build(state)
        if sw_n < 2 {
            return false
        }
        if back {
            sw_sel = sw_n - 1
        } else {
            sw_sel = 1
        }
        sw_open = 1
        sw_say(state, 0)
        sw_damage(state)
        if !sw_alt_held(state) {
            sw_commit(state)
        }
        return true
    }
    if back {
        sw_sel = (sw_sel + sw_n - 1) % sw_n
    } else {
        sw_sel = (sw_sel + 1) % sw_n
    }
    sw_say(state, 1)
    sw_damage(state)
    return true
}

// once per tick: Alt released -> switch; screen locked -> close; the list lost windows -> drop them
fn sw_tick(state: u64) {
    if sw_open == 0 {
        return
    }
    if sperre_an(state) {
        sw_cancel(state)
        return
    }
    if !sw_alt_held(state) {
        sw_commit(state)
    }
}

fn paint_switcher(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    if sw_open == 0 || sw_n == 0 {
        return
    }
    sw_geom(state)
    let c0: i64 = cx0 as i64
    let r0: i64 = cy0 as i64
    let c1: i64 = cx1 as i64
    let r1: i64 = cy1 as i64
    let k: i64 = sw_g[9 as usize]
    let px: i64 = sw_g[0 as usize]
    let py: i64 = sw_g[1 as usize]
    let cw: i64 = sw_g[4 as usize]
    let ch: i64 = sw_g[5 as usize]
    let gap: i64 = sw_g[6 as usize]
    let pad: i64 = sw_g[7 as usize]
    let cols: i64 = sw_g[8 as usize]
    if px + sw_g[2 as usize] <= c0 || py + sw_g[3 as usize] <= r0 || px >= c1 || py >= r1 {
        return
    }
    fill_round(state, px, py, sw_g[2 as usize], sw_g[3 as usize], sw_dim(state, 12, k) as u64, 0x202020, 240, c0, r0, c1, r1)
    let f: u64 = gs(state, S_FONT_UI)
    let pxui: u64 = gs(state, S_PX_UI)
    let accent: u64 = deco(state, DK_FRAME_ON)
    let n: i64 = sw_n as i64
    var t: i64 = 0
    while t < n {
        let w: u64 = sw_list[t as usize]
        let row: i64 = t / cols
        var inrow: i64 = n - row * cols
        if inrow > cols {
            inrow = cols
        }
        let off: i64 = (cols - inrow) * (cw + gap) / 2
        let tx: i64 = px + pad + off + (t % cols) * (cw + gap)
        let ty: i64 = py + pad + row * (ch + gap)
        if valid(state, w) && tx < c1 && ty < r1 && tx + cw > c0 && ty + ch > r0 {
            if (t as u64) == sw_sel {
                fill_round(state, tx, ty, cw, ch, sw_dim(state, 8, k) as u64, accent, 255, c0, r0, c1, r1)
                let b: i64 = sw_dim(state, 3, k)
                fill_round(state, tx + b, ty + b, cw - 2 * b, ch - 2 * b, sw_dim(state, 6, k) as u64, 0x2E2E2E, 255, c0, r0, c1, r1)
            }
            let m: i64 = sw_dim(state, 10, k)
            let thx: i64 = tx + m
            let thy: i64 = ty + m
            let thw: i64 = cw - 2 * m
            let thh: i64 = ch - 2 * m - sw_dim(state, 26, k)
            let bw: i64 = wg(state, w, W_W) as i64
            let bh: i64 = wg(state, w, W_H) as i64
            let buf: u64 = wg(state, w, W_BUF)
            // X1: no black letterbox -- the picture is scaled to its own aspect and centred, the tile colour shows around it.
            // Only a window without a buffer gets a dark placeholder box.
            if !(bw > 0 && bh > 0 && buf != 0) {
                fill_clip(state, thx, thy, thw, thh, 0x101010, 255, c0, r0, c1, r1)
            }
            if bw > 0 && bh > 0 && buf != 0 && thw > 0 && thh > 0 {
                var nw: i64 = thw
                var nh: i64 = bh * thw / bw
                if nh > thh {
                    nh = thh
                    nw = bw * thh / bh
                }
                if nw > 0 && nh > 0 {
                    let ox: i64 = thx + (thw - nw) / 2
                    let oy: i64 = thy + (thh - nh) / 2
                    let ax0: i64 = imax(ox, c0)
                    let ax1: i64 = imin(ox + nw, c1)
                    let ay0: i64 = imax(oy, r0)
                    let ay1: i64 = imin(oy + nh, r1)
                    let stride: u64 = wg(state, w, W_W)
                    var y: i64 = ay0
                    while y < ay1 && ax1 > ax0 {
                        let sy: i64 = (y - oy) * bh / nh
                        if sy >= 0 && sy < bh && y >= 0 {
                            fb.scaled_row_a(state, y as u64, ax0, ax1, buf +% (sy as u64) *% stride *% 4, ox, bw, nw, 255)
                        }
                        y = y + 1
                    }
                }
            }
            var lead_x: i64 = thx
            let an: u64 = win_app(state, w)
            if an != 0 && f < ttf.MAX_FONTS && (__mmio_read8((an) as *mut u8)) != 0 as u8 {
                // ROUND W-ICON: the program's tile in front of the title -- same colour and letter as the bar,
                // the start menu and the task manager (lib/appicon.fi)
                let ts: i64 = sw_dim(state, 16, k)
                let ty2: i64 = thy + thh + sw_dim(state, 4, k)
                fill_round(state, thx, ty2, ts, ts, sw_dim(state, 4, k) as u64, appicon.color_of(an), 255, c0, r0, c1, r1)
                let cp: u64 = appicon.letter_cp(an, 0)
                if cp != 0 {
                    let gs_: u64 = ttf.glyph(state, f, cp, pxui)
                    if gs_ < ttf.SLOTS {
                        let gw_: i64 = ttf.g_w(state, gs_) as i64
                        let gh_: i64 = ttf.g_h(state, gs_) as i64
                        fb_glyph(state, gs_, thx + (ts - gw_) / 2 - ttf.g_left(state, gs_),
                            ty2 + (ts - gh_) / 2 + ttf.g_top(state, gs_), 0xFFFFFF,
                            imax(thx, c0), imax(ty, r0), imin(tx + cw, c1), imin(ty + ch, r1))
                    }
                }
                lead_x = thx + ts + sw_dim(state, 4, k)
            }
            if f < ttf.MAX_FONTS {
                title_text(state, w, f, lead_x, thy + thh + sw_dim(state, 4, k) + ttf.ascent(state, f, pxui), 0xFFFFFF,
                    imax(thx, c0), imax(ty, r0), imin(tx + cw, c1), imin(ty + ch, r1), tx + cw - m)
            }
        }
        t = t + 1
    }
}

// r804: the touchpad swipe (lib/touchgest, via hidin -> gfx.mouse_swipe) as a window switch. dir: 1 left, 2 right,
// 3 up, 4 down; n = fingers (>= 3). Left = next window, right = previous (like Alt+Tab / Alt+Shift+Tab). Up/down
// have no consumer yet. Never while the screen is locked or the trusted dialog is up. Returns true if the focus moved.
static mut sw_done: u64 = 0 // swipes that moved the focus
fn swipe_do(state: u64, dir: u64, n: u64) -> bool {
    if n < 3 || !ready(state) || sperre_an(state) || td_live(state) {
        return false
    }
    let i: u64 = focus(state)
    var moved: bool = false
    if dir == 1 {
        moved = next_window(state, i)
    } else if dir == 2 {
        moved = prev_window(state, i)
    }
    if moved {
        sw_done = sw_done + 1
    }
    return moved
}

fn swipes_done() -> u64 {
    return sw_done
}

// W-TPSET2: a touchpad gesture action (lib/touchgest A_*, already resolved from the swipe mode in hidin) that
// the window server owns: 1 = next window, 2 = previous window (same focus walk as Alt+Tab / Alt+Shift+Tab).
// Show / restore desktop go over the Win+D key of the taskbar (hidin); task view and virtual desktops do not
// exist yet, so those codes (3, 6, 7) do nothing. Never while the screen is locked or the trusted dialog is up.
fn gest_action(state: u64, act: u64, n: u64) -> bool {
    if act == 1 {
        return swipe_do(state, 1, n)
    }
    if act == 2 {
        return swipe_do(state, 2, n)
    }
    return false
}

// EINE HANDLUNG AUSFUEHREN. Welche Taste welche Handlung ausloest, steht
// NICHT hier, sondern in der Tabelle, die aus
// /users/<name>/config/tiling.conf gelesen wurde. Hier steht nur, was
// eine Handlung TUT.
fn tile_action(state: u64, act: u64) -> bool {
    if act == tile.A_NONE || !ready(state) {
        return false
    }
    // r382 LOCK SEAL: second lock, for the callers that do not come over
    // the key ring (the syscall WM_TILEDO): no action on any window while
    // the screen is locked.
    if sperre_an(state) {
        return false
    }
    if act == tile.A_TILE_TOGGLE {
        set_tile_on(state, gs(state, S_TILE) == 0)
        return true
    }
    // RUNDE FENSTER: die MESSTASTE. Sie veraendert nichts -- sie legt die Arbeitsflaeche und die
    // ganze Fensterliste auf die Leitung. r402: VOR der Frage nach dem Fokus -- sie braucht weder
    // ein Fenster noch den Baum (nach Alt+F4 auf dem letzten Fenster gab es keinen Fokus mehr, und
    // die Messtaste blieb stumm).
    if act == tile.A_SAY {
        work_say(state)
        wins_say(state)
        return true
    }
    let i: u64 = focus(state)
    if i >= MAX_WIN {
        return false
    }
    if act == tile.A_CLOSE {
        ev_push(state, i, E_CLOSE, 0, 0, 0)
        destroy(state, i)
        return true
    }
    // r402: Alt+F4 -- a window with a frame, on the normal layer, closed like its close button
    if act == tile.A_CLOSE_WIN {
        if !deko(state, i) || wg(state, i, W_LAYER) != L_NORMAL || !darf(state, i) {
            return false
        }
        return close_anim(state, i)
    }
    if act == tile.A_FLOAT {
        return tile_float(state, i)
    }
    if act >= tile.A_SNAP_LEFT && act <= tile.A_SNAP_BR {
        return tile_snap(state, i, act - tile.A_SNAP_LEFT)
    }
    // ================================================ RUNDE TUERSCHLOSS
    //
    // ALT+TAB. Diese Abfrage steht VOR `let nd = wg(state, i, W_NODE)`
    // und dessen `if nd == 0 { return false }` -- und das ist der ganze
    // Grund, warum sie wirkt.
    //
    // GEMESSEN (Runde DURCHKLICK, 4.3): `focus=1` stand ueber 137
    // Meldungen still. Die vorhandenen Fokushandlungen fragen alle den
    // KACHELBAUM (`dir_search`); ein schwebendes Fenster hat `W_NODE ==
    // 0` und faellt aus jeder von ihnen heraus, bevor irgendetwas
    // passiert. Auf dem Schreibtisch dieses Systems schwebt aber jedes
    // Fenster -- der Kachelmodus ist standardmaessig aus.
    //
    // Alt+Tab geht deshalb durch die FENSTERLISTE DES SERVERS und nicht
    // durch den Baum: ab dem Fenster mit dem Fokus aufwaerts, im Kreis,
    // und nimmt das erste, das ein Mensch auch anklicken koennte.
    if act == tile.A_NEXT_WIN {
        return sw_step(state, false)
    }
    if act == ACT_PREV_WIN {
        return sw_step(state, true)
    }
    // ================================================== RUNDE VOLLBILD
    // F11 UMSCHALTEN. Steht aus demselben Grund hier oben wie Alt+Tab:
    // das Vollbild betrifft EIN Fenster und nicht den Kachelbaum -- ein
    // schwebendes Fenster (der Normalfall auf diesem Schreibtisch) hat
    // `W_NODE == 0` und fiele durch die Abfrage darunter heraus, bevor
    // irgendetwas passiert.
    //
    // UMSCHALTEN und nicht EINSCHALTEN: dieselbe Taste zurueck ist das,
    // was Windows und jeder Browser tun.
    if act == tile.A_FULL {
        let an: bool = (wg(state, i, W_FLAGS) & F_FULL) == 0
        let ok: bool = fullscreen(state, i, an)
        if ok {
            full_say(state, i)
        }
        return ok
    }
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return false
    }
    tl_sel(state, nd_tag(nd))
    let n: u64 = nd_node(nd)
    if act <= tile.A_FOCUS_DOWN {
        let z: u64 = tile.dir_search(tt(state), n, act - tile.A_FOCUS_LEFT)
        if z == tile.NONE {
            return false
        }
        tile.set_focus(tt(state), z)
        let cl: u64 = tile.n_client(tt(state), z)
        if cl != 0 && cl <= MAX_WIN {
            raise_win(state, cl - 1)
            set_focus(state, cl - 1)
        }
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act <= tile.A_MOVE_DOWN {
        if tile.move_dir(tt(state), n, act - tile.A_MOVE_LEFT) {
            tile_apply(state)
            damage_tile(state)
            return true
        }
        return false
    }
    if act == tile.A_SPLIT_H {
        tile.set_next_split(tt(state), 1)
        return true
    }
    if act == tile.A_SPLIT_V {
        tile.set_next_split(tt(state), 2)
        return true
    }
    if act >= tile.A_LAYOUT_SPLIT && act <= tile.A_LAYOUT_STACKED {
        if tile.set_layout(tt(state), n, act - tile.A_LAYOUT_SPLIT) {
            tile_apply(state)
            damage_tile(state)
            return true
        }
        return false
    }
    if act == tile.A_ROTATE {
        tile.rotate(tt(state), tile.root(tt(state)), 1)
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act == tile.A_MIRROR {
        tile.mirror(tt(state), tile.root(tt(state)), 0)
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act == tile.A_BALANCE {
        tile.balance(tt(state), tile.root(tt(state)))
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act == tile.A_GROW || act == tile.A_SHRINK {
        var d: i64 = tile.MIN_FRAC as i64
        if act == tile.A_SHRINK {
            d = 0 - d
        }
        if tile.resize_at(tt(state), n, d) {
            tile_apply(state)
            damage_tile(state)
            return true
        }
        return false
    }
    return false
}

// ==================================================================
// ROUND A11Y-2 (S-008) -- THE MAGNIFIER
//
// A CUT-OUT, TWICE ENLARGED, IN A FIXED PANEL of 200 x 150 at the top
// right. Not the whole screen enlarged (macOS' zoom): that needs a second
// composition of the WHOLE picture per movement and takes away the
// overview. A panel shows both.
//
// IT FOLLOWS THE FOCUS AND THE POINTER, whichever moved last. The focus
// comes from the accessibility tree: the focused node of the focused
// window, in screen coordinates (window corner + frame + the node's
// place). So a person who works with the keyboard sees the control that
// Tab just reached, magnified, without moving a mouse.
//
// THE PANEL GIVES WAY. If the cut-out would overlap the panel at the top
// right, the panel goes to the top left -- otherwise it would magnify
// itself and the picture would be a spiral. The rule is hard, not soft:
// a test must be able to compute where the panel is, and the kernel says
// it on the serial line (`ax: mag ...`) so the test does not need a
// second copy of this arithmetic.
const MAG_W: u64 = 200
const MAG_H: u64 = 150
const MAG_F: u64 = 2

// The centre of the cut-out, in screen coordinates. Updates the mode.
fn mag_centre(state: u64) -> u64 {
    let px: u64 = gs(state, S_CURX)
    let py: u64 = gs(state, S_CURY)
    if px != gs(state, S_MAGPX) || py != gs(state, S_MAGPY) {
        ss(state, S_MAGPX, px)
        ss(state, S_MAGPY, py)
        ss(state, S_MAGMODE, 0)
    }
    let fs: u64 = ax.fseq(state)
    if fs != gs(state, S_MAGFS) {
        ss(state, S_MAGFS, fs)
        ss(state, S_MAGMODE, 1)
    }
    var cx: u64 = px
    var cy: u64 = py
    if gs(state, S_MAGMODE) == 1 {
        let f: u64 = focus(state)
        if f < MAX_WIN && valid(state, f) {
            let n: u64 = ax.focus_node(state, f)
            if n < ax.MAX_NODES {
                var wx: i64 = win_x(state, f) + inx(state, f) as i64
                var wy: i64 = win_y(state, f) + iny(state, f) as i64
                if wx < 0 {
                    wx = 0
                }
                if wy < 0 {
                    wy = 0
                }
                // a wide control (an entry, a check box row) is centred
                // on its START, where its text begins -- the middle of
                // a 400-pixel field is empty
                var half: u64 = ax.node_w(state, n) / 2
                if half > MAG_W / MAG_F / 2 - 5 {
                    half = MAG_W / MAG_F / 2 - 5
                }
                cx = wx as u64 + ax.node_x(state, n) + half
                cy = wy as u64 + ax.node_y(state, n) + ax.node_h(state, n) / 2
            }
        }
    }
    ss(state, S_MAGCX, cx)
    ss(state, S_MAGCY, cy)
    return cx
}

// The top left of the CUT-OUT. k = 0: x, 1: y.
fn mag_src(state: u64, k: u64) -> u64 {
    let sw: u64 = gs(state, S_SW)
    let sh: u64 = gs(state, S_SH)
    let qw: u64 = MAG_W / MAG_F
    let qh: u64 = MAG_H / MAG_F
    var c: u64 = gs(state, S_MAGCX)
    var lim: u64 = sw
    var q: u64 = qw
    if k == 1 {
        c = gs(state, S_MAGCY)
        lim = sh
        q = qh
    }
    if lim <= q || c < q / 2 {
        return 0
    }
    if c + q / 2 >= lim {
        return lim - q
    }
    return c - q / 2
}

// Where the panel stands: top right, unless the cut-out reaches into it.
fn mag_x(state: u64) -> u64 {
    let sw: u64 = gs(state, S_SW)
    if sw <= MAG_W * 2 {
        return 0
    }
    let sx: u64 = mag_src(state, 0)
    let sy: u64 = mag_src(state, 1)
    if sx + MAG_W / MAG_F > sw - MAG_W && sy < MAG_H {
        return 0
    }
    return sw - MAG_W
}

// Only when something is dirty anyway or the centre moved -- `compose`
// runs from the idle loop too, and an unchanged panel costs nothing.
fn mag_damage(state: u64) {
    let ocx: u64 = gs(state, S_MAGCX)
    let ocy: u64 = gs(state, S_MAGCY)
    let _c: u64 = mag_centre(state)
    if gs(state, S_DON) == 0 && ocx == gs(state, S_MAGCX)
        && ocy == gs(state, S_MAGCY) && gs(state, S_MAGLX) != 0 {
        return
    }
    let px: u64 = mag_x(state)
    let last: u64 = gs(state, S_MAGLX)
    if last != 0 && last - 1 != px {
        damage(state, (last - 1) as i64, 0, (last - 1 + MAG_W) as i64,
            MAG_H as i64)
    }
    ss(state, S_MAGLX, px + 1)
    damage(state, px as i64, 0, (px + MAG_W) as i64, MAG_H as i64)
}

fn paint_mag(state: u64) {
    let sw: u64 = gs(state, S_SW)
    let sh: u64 = gs(state, S_SH)
    if sw < MAG_W * 2 || sh < MAG_H * 2 {
        return
    }
    let px: u64 = mag_x(state)
    let sx: u64 = mag_src(state, 0)
    let sy: u64 = mag_src(state, 1)
    // READ, THEN WRITE: the cut-out never overlaps the panel (mag_x), so
    // no pixel is read after it was written.
    var r: u64 = 0
    while r < MAG_H {
        var c: u64 = 0
        while c < MAG_W {
            fb.pixel(state, px + c, r,
                fb.get_pixel(state, sx + c / MAG_F, sy + r / MAG_F))
            c = c + 1
        }
        r = r + 1
    }
    // A frame in the colour of the active title bar -- from the scheme,
    // not a number (no raw colour in drawing code since round THEME), and
    // it goes along with high contrast.
    let rim: u64 = deco(state, DK_TITLE_ON)
    var k: u64 = 0
    while k < MAG_W {
        fb.pixel(state, px + k, 0, rim)
        fb.pixel(state, px + k, 1, rim)
        fb.pixel(state, px + k, MAG_H - 2, rim)
        fb.pixel(state, px + k, MAG_H - 1, rim)
        k = k + 1
    }
    k = 0
    while k < MAG_H {
        fb.pixel(state, px, k, rim)
        fb.pixel(state, px + 1, k, rim)
        fb.pixel(state, px + MAG_W - 2, k, rim)
        fb.pixel(state, px + MAG_W - 1, k, rim)
        k = k + 1
    }
    ss(state, S_MAGN, gs(state, S_MAGN) + 1)
}

// `ax: mag ...` on the serial line: where the panel and the cut-out are,
// so a test checks the PICTURE against the kernel's own numbers.
fn say_mag(state: u64) {
    var s_a: [u8; 12] = "ax: mag px=\0"
    var s_b: [u8; 5] = " sx=\0"
    var s_c: [u8; 5] = " sy=\0"
    var s_d: [u8; 5] = " cx=\0"
    var s_e: [u8; 5] = " cy=\0"
    var s_f: [u8; 7] = " mode=\0"
    var s_g: [u8; 9] = " frames=\0"
    var s_h: [u8; 6] = " rim=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(mag_x(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(mag_src(state, 0))
    serial.puts((&s_c[0]) as u64)
    serial.dec(mag_src(state, 1))
    serial.puts((&s_d[0]) as u64)
    serial.dec(gs(state, S_MAGCX))
    serial.puts((&s_e[0]) as u64)
    serial.dec(gs(state, S_MAGCY))
    serial.puts((&s_f[0]) as u64)
    serial.dec(gs(state, S_MAGMODE))
    serial.puts((&s_g[0]) as u64)
    serial.dec(gs(state, S_MAGN))
    serial.puts((&s_h[0]) as u64)
    serial.hex(deco(state, DK_TITLE_ON))
    serial.nl()
}


// ================================================================ W-E (17.10.2026): frame cadence + debug FPS overlay
// The kernel desktop loop (kgui wait_wm) calls `cadence_note` once per round, after compose and BEFORE the frame boundary
// (`gfx.bild_fertig`). A round counts as a painted frame when compose composed something or the card still has a pending box
// (wmd's CP_PRESENT path). Interval = TSC distance of two painted frames: the real frame cadence, not the compose cost.
// Intervals above 100 ms are idle gaps, not cadence. F12 prints `wm: cadence ...` and zeroes the counters; the overlay switch is
// the config key `fps=true` (settings key debug.fps, /etc/mouse.conf, re-read about once a second by ptrcfg.poll).
static mut cad_v: [u64; 16] = [0 as u64; 16]
static mut cad_h: [u64; 8] = [0 as u64; 8]
const CV_LASTTSC: u64 = 0
const CV_LASTCOMP: u64 = 1
const CV_N: u64 = 2 // intervals <= 100 ms since the last F12
const CV_SUM: u64 = 3 // microseconds summed
const CV_MAX: u64 = 4
const CV_IDLE: u64 = 5 // gaps above 100 ms
const CV_WT0: u64 = 6 // one-second window start (TSC)
const CV_WN: u64 = 7 // painted frames in the window
const CV_WSUM: u64 = 8
const CV_WK: u64 = 9
const CV_FPS: u64 = 10 // last full window
const CV_MS10: u64 = 11 // mean interval of that window, tenths of ms
const CV_DRAWN: u64 = 12 // key of the text the overlay drew last
const CV_TOTAL: u64 = 13 // painted frames since boot
const CV_OVER: u64 = 14 // intervals above 17.5 ms
const CV_DRAWS: u64 = 15 // overlay paints since boot

fn last_paint_tsc(state: u64) -> u64 {
    return cad_v[CV_LASTTSC as usize]
}

fn cad_bucket(us: u64) -> u64 {
    if us < 8000 {
        return 0
    }
    if us < 12000 {
        return 1
    }
    if us < 15500 {
        return 2
    }
    if us < 17500 {
        return 3
    }
    if us < 21000 {
        return 4
    }
    if us < 34000 {
        return 5
    }
    if us < 51000 {
        return 6
    }
    return 7
}

fn cad_dec(buf: u64, at: u64, v: u64) -> u64 {
    var tmp: [u8; 20] = [0 as u8; 20]
    var k: u64 = 0
    var x: u64 = v
    if x == 0 {
        tmp[0] = 48 as u8
        k = 1
    }
    while x > 0 {
        tmp[k as usize] = (48 + x % 10) as u8
        x = x / 10
        k = k + 1
    }
    var i: u64 = 0
    var p: u64 = at
    while i < k {
        kstate.set8(buf + p, tmp[(k - 1 - i) as usize])
        p = p + 1
        i = i + 1
    }
    return p
}

fn cad_str(buf: u64, at: u64, src: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < n {
        kstate.set8(buf + at + i, (kstate.get8(src + i)) as u8)
        i = i + 1
    }
    return at + n
}

// ---------------------------------------------------------------- FPS-OV (20.10.2026): the FPS / frame time overlay, top right
// Three clocks, all from the real paths (no model):
//   * painted frames: `cadence_note` stamps every round that composed something (or had a pending box) into the ring `fo_t`.
//   * frame time: the interval between the last two painted frames; mean / max over the intervals of the last 1000 ms (gaps above
//     100 ms are idle, not frame time).
//   * present clock: the driver's own counter (VMSVGA `present_frames` = UPDATE rectangles sent, virtio-gpu `transfers`), sampled
//     once per round; every counted step gets a stamp in `fo_p`. The overlay's own repaint is a present too -- those are
//     subtracted (`FO_OVONLY`), otherwise an idle screen would show 4 "presents" a second made by the overlay itself.
// All numbers are a SLIDING window of the last 1000 ms. The text is rebuilt every 250 ms (readable), but painted again in every painted
// round (the compose may have covered it). No painted frame for 1 s -> "FPS 0 IDLE" and the overlay stops painting (a silent screen
// stays silent). Switch: Ctrl+Alt+F (hotkeys -> fps_hotkey) or the Settings page (key debug.fps, /etc/mouse.conf fps=).
static mut fo_t: [u64; 256] = [0 as u64; 256]
static mut fo_p: [u64; 128] = [0 as u64; 128]
static mut fo_v: [u64; 24] = [0 as u64; 24]
static mut fo_txt: [u8; 112] = [32 as u8; 112]
const FO_FH: u64 = 0 // painted frames stamped since boot (ring head)
const FO_PH: u64 = 1 // real presents stamped since boot
const FO_LASTPC: u64 = 2 // driver present counter at the last sample
const FO_OVONLY: u64 = 3 // presents the overlay's own repaint is going to cause (to subtract)
const FO_STATT: u64 = 4 // TSC of the last text rebuild
const FO_KEY: u64 = 5 // hash of the text last built
const FO_SAYT: u64 = 6 // TSC of the last serial line
const FO_ON: u64 = 7 // the overlay was on in the last round
const FO_RX: u64 = 8 // rectangle of the last paint (pixels); width 0 = nothing painted
const FO_RY: u64 = 9
const FO_RW: u64 = 10
const FO_RH: u64 = 11
const FO_LASTFT: u64 = 12 // last frame interval, microseconds
const FO_PTOTAL: u64 = 13 // real presents since boot
const FO_DRAWS: u64 = 14 // overlay paints since boot
const FO_FPS: u64 = 15 // last results (microseconds / counts), for the serial line and the tests
const FO_AVG: u64 = 16
const FO_MAX: u64 = 17
const FO_PRES: u64 = 18
const FO_NINT: u64 = 19
const FO_W: u64 = 26 // text columns of the overlay
const FO_ROWS: u64 = 4

fn present_driver(state: u64) -> bool {
    return vgpu.usable(state) || vmsvga.is_ready(state)
}

// the number of pictures the card driver has been told about (a counter of the driver itself); 0 without a driver
fn present_count(state: u64) -> u64 {
    if vgpu.usable(state) {
        return vgpu.transfers(state)
    }
    if vmsvga.is_ready(state) {
        return vmsvga.present_frames(state)
    }
    return 0
}

// one round: look at the driver's counter, stamp the steps that were not caused by the overlay itself
fn fo_sample_present(state: u64, now: u64) {
    let pc: u64 = present_count(state)
    let lastpc: u64 = fo_v[FO_LASTPC as usize]
    let sub: u64 = fo_v[FO_OVONLY as usize]
    fo_v[FO_OVONLY as usize] = 0
    fo_v[FO_LASTPC as usize] = pc
    if pc <= lastpc {
        return
    }
    var real: u64 = pc - lastpc
    if real > sub {
        real = real - sub
    } else {
        real = 0
    }
    if real > 4 {
        real = 4
    }
    var k: u64 = 0
    while k < real {
        fo_p[(fo_v[FO_PH as usize] % 128) as usize] = now
        fo_v[FO_PH as usize] = fo_v[FO_PH as usize] + 1
        fo_v[FO_PTOTAL as usize] = fo_v[FO_PTOTAL as usize] + 1
        k = k + 1
    }
}

// the sliding window: results into fo_v[FO_FPS..FO_NINT]
fn fo_stats(now: u64, kh: u64) {
    let per_us: u64 = kh / 1000
    var ws: u64 = 0
    if now > kh * 1000 {
        ws = now - kh * 1000
    }
    var n: u64 = 0
    var cnt: u64 = 0
    var sum: u64 = 0
    var mx: u64 = 0
    var newer: u64 = 0
    var k: u64 = 0
    let head: u64 = fo_v[FO_FH as usize]
    while k < 256 && k < head {
        let t: u64 = fo_t[((head - 1 - k) % 256) as usize]
        if t < ws {
            break
        }
        n = n + 1
        if newer != 0 && newer > t {
            let us: u64 = (newer - t) / per_us
            if us <= 100000 {
                sum = sum + us
                cnt = cnt + 1
                if us > mx {
                    mx = us
                }
            }
        }
        newer = t
        k = k + 1
    }
    var pn: u64 = 0
    let ph: u64 = fo_v[FO_PH as usize]
    k = 0
    while k < 128 && k < ph {
        let t: u64 = fo_p[((ph - 1 - k) % 128) as usize]
        if t < ws {
            break
        }
        pn = pn + 1
        k = k + 1
    }
    fo_v[FO_FPS as usize] = n
    fo_v[FO_NINT as usize] = cnt
    fo_v[FO_AVG as usize] = 0
    if cnt != 0 {
        fo_v[FO_AVG as usize] = sum / cnt
    }
    fo_v[FO_MAX as usize] = mx
    fo_v[FO_PRES as usize] = pn
}

// microseconds as "12.3" (tenths of a millisecond, rounded down)
fn fo_ms(buf: u64, at: u64, us: u64) -> u64 {
    var p: u64 = cad_dec(buf, at, us / 1000)
    kstate.set8(buf + p, 46 as u8)
    p = cad_dec(buf, p + 1, (us % 1000) / 100)
    return p
}

// one text line into fo_txt row r: padded with blanks to FO_W columns, closed with a 0
fn fo_line_end(buf: u64, n: u64) {
    var i: u64 = n
    while i < FO_W {
        kstate.set8(buf + i, 32 as u8)
        i = i + 1
    }
    kstate.set8(buf + FO_W, 0 as u8)
}

// rebuild the four lines from fo_v; returns the key of the text (a change = the text has to be painted)
fn fo_build(state: u64, w: u64, h: u64) -> u64 {
    var t_fps: [u8; 5] = "FPS \0"
    var t_ft: [u8; 6] = "  FT \0"
    var t_ms: [u8; 4] = " ms\0"
    var t_idle: [u8; 12] = "FPS 0  IDLE\0"
    var t_avg: [u8; 5] = "AVG \0"
    var t_max: [u8; 7] = "  MAX \0"
    var t_none: [u8; 13] = "AVG -  MAX -\0"
    var t_pres: [u8; 9] = "PRESENT \0"
    var t_ps: [u8; 3] = "/s\0"
    var t_na: [u8; 21] = "PRESENT n/a (direct)\0"
    let b: u64 = (&fo_txt[0]) as u64
    let fps: u64 = fo_v[FO_FPS as usize]
    var n: u64 = 0
    // row 0: fps and the last frame interval
    var l0: u64 = b
    if fps == 0 {
        n = cad_str(l0, 0, (&t_idle[0]) as u64, 11)
    } else {
        n = cad_str(l0, 0, (&t_fps[0]) as u64, 4)
        n = cad_dec(l0, n, fps)
        n = cad_str(l0, n, (&t_ft[0]) as u64, 5)
        n = fo_ms(l0, n, fo_v[FO_LASTFT as usize])
        n = cad_str(l0, n, (&t_ms[0]) as u64, 3)
    }
    fo_line_end(l0, n)
    // row 1: mean / max of the window
    let l1: u64 = b + FO_W + 2
    if fo_v[FO_NINT as usize] == 0 {
        n = cad_str(l1, 0, (&t_none[0]) as u64, 12)
    } else {
        n = cad_str(l1, 0, (&t_avg[0]) as u64, 4)
        n = fo_ms(l1, n, fo_v[FO_AVG as usize])
        n = cad_str(l1, n, (&t_max[0]) as u64, 6)
        n = fo_ms(l1, n, fo_v[FO_MAX as usize])
    }
    fo_line_end(l1, n)
    // row 2: the present clock
    let l2: u64 = b + (FO_W + 2) * 2
    if present_driver(state) {
        n = cad_str(l2, 0, (&t_pres[0]) as u64, 8)
        n = cad_dec(l2, n, fo_v[FO_PRES as usize])
        n = cad_str(l2, n, (&t_ps[0]) as u64, 2)
    } else {
        n = cad_str(l2, 0, (&t_na[0]) as u64, 20)
    }
    fo_line_end(l2, n)
    // row 3: resolution
    let l3: u64 = b + (FO_W + 2) * 3
    n = cad_dec(l3, 0, w)
    kstate.set8(l3 + n, 120 as u8)
    n = cad_dec(l3, n + 1, h)
    fo_line_end(l3, n)
    return fps * 1000000007 + fo_v[FO_LASTFT as usize] / 100 * 10007 + fo_v[FO_AVG as usize] / 100 * 331 + fo_v[FO_MAX as usize] / 100 * 17 + fo_v[FO_PRES as usize] * 3 + w / 8
}

fn fps_overlay(state: u64, painted: bool, now: u64, kh: u64) {
    if !fb.ready(state) {
        return
    }
    let w: u64 = fb.width(state)
    let h: u64 = fb.height(state)
    var changed: bool = false
    let st: u64 = fo_v[FO_STATT as usize]
    if st == 0 || now < st || (now - st) / kh >= 250 {
        fo_v[FO_STATT as usize] = now
        fo_stats(now, kh)
        let key: u64 = fo_build(state, w, h)
        if key != fo_v[FO_KEY as usize] {
            fo_v[FO_KEY as usize] = key
            changed = true
        }
        // the serial line, once a second, only with the kernel word `phases` (the gates read it)
        let sy: u64 = fo_v[FO_SAYT as usize]
        if fb.phases_an(state) && (sy == 0 || now < sy || (now - sy) / kh >= 1000) {
            fo_v[FO_SAYT as usize] = now
            var s_a: [u8; 15] = "wm: fpsov fps=\0"
            var s_b: [u8; 5] = " ft=\0"
            var s_c: [u8; 6] = " avg=\0"
            var s_d: [u8; 6] = " max=\0"
            var s_e: [u8; 7] = " pres=\0"
            var s_f: [u8; 7] = " drv=\0\0"
            serial.puts((&s_a[0]) as u64)
            serial.dec(fo_v[FO_FPS as usize])
            serial.puts((&s_b[0]) as u64)
            serial.dec(fo_v[FO_LASTFT as usize])
            serial.puts((&s_c[0]) as u64)
            serial.dec(fo_v[FO_AVG as usize])
            serial.puts((&s_d[0]) as u64)
            serial.dec(fo_v[FO_MAX as usize])
            serial.puts((&s_e[0]) as u64)
            serial.dec(fo_v[FO_PRES as usize])
            serial.puts((&s_f[0]) as u64)
            if present_driver(state) {
                serial.dec(1)
            } else {
                serial.dec(0)
            }
            serial.nl()
        }
    }
    if !painted && !changed && fo_v[FO_RW as usize] != 0 {
        return
    }
    fo_v[FO_DRAWS as usize] = fo_v[FO_DRAWS as usize] + 1
    var sc: u64 = fb.scale(state)
    if sc == 0 {
        sc = 1
    }
    var col: u64 = 0
    if fb.cols(state) > FO_W {
        col = fb.cols(state) - FO_W
    }
    fb.set_color(state, fb.rgb(state, 0, 255, 0), fb.rgb(state, 0, 0, 0))
    var r: u64 = 0
    while r < FO_ROWS {
        fb.goto(state, col, r)
        fb.puts(state, ((&fo_txt[0]) as u64) + r * (FO_W + 2))
        r = r + 1
    }
    var fw: u64 = FO_W * 8 * sc
    if fw > w {
        fw = w
    }
    let fx: u64 = col * 8 * sc
    fb.flush_rect(state, fx, 0, fw, FO_ROWS * 16 * sc)
    fo_v[FO_RX as usize] = fx
    fo_v[FO_RY as usize] = 0
    fo_v[FO_RW as usize] = fw
    fo_v[FO_RH as usize] = FO_ROWS * 16 * sc
    // the repaint reaches the card in this round's present: it is no new picture of the desktop
    if !painted {
        fo_v[FO_OVONLY as usize] = fo_v[FO_OVONLY as usize] + 1
    }
}

// switched off: give the covered pixels back (the compose paints the desktop there again)
fn fps_overlay_off(state: u64) {
    if fo_v[FO_ON as usize] == 0 {
        return
    }
    fo_v[FO_ON as usize] = 0
    let rw: u64 = fo_v[FO_RW as usize]
    if rw != 0 {
        let rx: u64 = fo_v[FO_RX as usize]
        let ry: u64 = fo_v[FO_RY as usize]
        damage(state, rx as i64, ry as i64, (rx + rw) as i64, (ry + fo_v[FO_RH as usize]) as i64)
    }
    fo_v[FO_RW as usize] = 0
    fo_v[FO_KEY as usize] = 0
}

// Ctrl+Alt+R
fn repaint_hotkey(state: u64) {
    var s_rp: [u8; 17] = "wm: fullrepaint\0\0"
    damage_all(state)
    serial.puts((&s_rp[0]) as u64)
    serial.nl()
}

// Ctrl+Alt+F
fn fps_hotkey(state: u64) {
    let on: bool = ptrcfg.fps_toggle(state)
    ptrcfg.fps_flush(state)
    var s_on: [u8; 19] = "wm: fps overlay on\0"
    var s_off: [u8; 20] = "wm: fps overlay off\0"
    if on {
        serial.puts((&s_on[0]) as u64)
    } else {
        serial.puts((&s_off[0]) as u64)
    }
    serial.nl()
}

fn mon_apply(state: u64) {
    let e: u64 = ptrcfg.mon_take(state)
    if e == 2 {
        frameprof.mon_set(true)
    } else if e == 1 {
        frameprof.mon_set(false)
    }
    let pe: u64 = ptrcfg.pg_take(state)
    if pe == 2 {
        pixelguard.set_mode(pixelguard.MODE_SAMPLE)
    } else if pe == 1 {
        pixelguard.set_mode(pixelguard.MODE_OFF)
        pixelguard.release(state)
    }
}

fn cadence_note(state: u64, pending: bool) {
    ptrcfg.poll(state)
    mon_apply(state)
    let kh: u64 = time.khz(state)
    if kh < 1000 {
        return
    }
    let now: u64 = time.tsc()
    let per_us: u64 = kh / 1000
    let comp: u64 = composites(state)
    let painted: bool = pending || comp != cad_v[CV_LASTCOMP as usize]
    cad_v[CV_LASTCOMP as usize] = comp
    if painted {
        let last: u64 = cad_v[CV_LASTTSC as usize]
        if last != 0 && now > last {
            let us: u64 = (now - last) / per_us
            if us <= 100000 {
                let bk: u64 = cad_bucket(us)
                cad_h[bk as usize] = cad_h[bk as usize] + 1
                cad_v[CV_N as usize] = cad_v[CV_N as usize] + 1
                cad_v[CV_SUM as usize] = cad_v[CV_SUM as usize] + us
                if us > cad_v[CV_MAX as usize] {
                    cad_v[CV_MAX as usize] = us
                }
                if us > 17500 {
                    cad_v[CV_OVER as usize] = cad_v[CV_OVER as usize] + 1
                }
                cad_v[CV_WSUM as usize] = cad_v[CV_WSUM as usize] + us
                cad_v[CV_WK as usize] = cad_v[CV_WK as usize] + 1
            } else {
                cad_v[CV_IDLE as usize] = cad_v[CV_IDLE as usize] + 1
            }
        }
        if last != 0 && now > last {
            fo_v[FO_LASTFT as usize] = (now - last) / per_us
        }
        fo_t[(fo_v[FO_FH as usize] % 256) as usize] = now
        fo_v[FO_FH as usize] = fo_v[FO_FH as usize] + 1
        cad_v[CV_LASTTSC as usize] = now
        cad_v[CV_WN as usize] = cad_v[CV_WN as usize] + 1
        cad_v[CV_TOTAL as usize] = cad_v[CV_TOTAL as usize] + 1
    }
    let w0: u64 = cad_v[CV_WT0 as usize]
    if w0 == 0 || now < w0 {
        cad_v[CV_WT0 as usize] = now
    } else {
        let el_ms: u64 = (now - w0) / kh
        if el_ms >= 1000 {
            cad_v[CV_FPS as usize] = (cad_v[CV_WN as usize] * 1000 + el_ms / 2) / el_ms
            var m10: u64 = 0
            if cad_v[CV_WK as usize] != 0 {
                m10 = (cad_v[CV_WSUM as usize] / cad_v[CV_WK as usize]) / 100
            }
            cad_v[CV_MS10 as usize] = m10
            cad_v[CV_WT0 as usize] = now
            cad_v[CV_WN as usize] = 0
            cad_v[CV_WSUM as usize] = 0
            cad_v[CV_WK as usize] = 0
        }
    }
    fo_sample_present(state, now)
    if ptrcfg.fps_on(state) {
        fo_v[FO_ON as usize] = 1
        fps_overlay(state, painted, now, kh)
    } else {
        fps_overlay_off(state)
    }
}

fn cadence_say_reset(state: u64) {
    var s_c: [u8; 16] = "wm: cadence n=\0\0"
    var s_m: [u8; 9] = " mittel=\0"
    var s_x: [u8; 6] = " max=\0"
    var s_o: [u8; 10] = " ueber17=\0"
    var s_i: [u8; 7] = " idle=\0"
    var s_f: [u8; 7] = " fach=\0"
    var s_t: [u8; 8] = " total=\0"
    let n: u64 = cad_v[CV_N as usize]
    serial.puts((&s_c[0]) as u64)
    serial.dec(n)
    serial.puts((&s_m[0]) as u64)
    if n != 0 {
        serial.dec(cad_v[CV_SUM as usize] / n)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_x[0]) as u64)
    serial.dec(cad_v[CV_MAX as usize])
    serial.puts((&s_o[0]) as u64)
    serial.dec(cad_v[CV_OVER as usize])
    serial.puts((&s_i[0]) as u64)
    serial.dec(cad_v[CV_IDLE as usize])
    serial.puts((&s_f[0]) as u64)
    var k: u64 = 0
    while k < 8 {
        serial.dec(cad_h[k as usize])
        if k < 7 {
            serial.put(32 as u8)
        }
        cad_h[k as usize] = 0
        k = k + 1
    }
    serial.puts((&s_t[0]) as u64)
    serial.dec(cad_v[CV_TOTAL as usize])
    serial.nl()
    cad_v[CV_N as usize] = 0
    cad_v[CV_SUM as usize] = 0
    cad_v[CV_MAX as usize] = 0
    cad_v[CV_OVER as usize] = 0
    cad_v[CV_IDLE as usize] = 0
}

// ==================================================== r1014: TERMINAL TABS
// Every tab is its own K_TERM window (own tty + shell, made by /bin/term like any other terminal). A GROUP is the set of
// windows that share one place: only the ACTIVE one is shown, the others are hidden (F_HIDDEN, `tt_bg` = 1) and left out of
// the task bar and Alt+Tab. The title bar of the active window shows the tab strip (this server paints the terminal title
// itself, so the strip is painted here: tabs, a close 'x' on each tab and a '+'). A switch copies the place and size of the
// active window to the tab that comes forward. Keys: Ctrl+Shift+T new tab, Ctrl+Tab / Ctrl+Shift+Tab next / previous,
// Ctrl+Shift+W close. A new tab is requested here (`tt_request`) and made by the desktop loop in kgui (it starts /bin/term);
// `gfx.term_new` then calls `tt_src` (take the place of the asking window) and `tt_join`.
static mut tt_grp: [u64; 32] = [0 as u64; 32]   // group id of the window, 0 = not in a group
static mut tt_ord: [u64; 32] = [0 as u64; 32]   // creation order inside the group (1, 2, 3 ...)
static mut tt_bg: [u64; 32] = [0 as u64; 32]    // 1 = background tab (hidden behind the active one)
static mut tt_cnt: [u64; 8] = [0 as u64; 8]     // 0 group ids given, 1 orders given, 2 request (window + 1), 3 request tick, 4 spawn asked, 5 joins, 6 switches, 7 closes
static mut tt_lab: [u8; 16] = [0 as u8; 16]

fn tt_grp_of(state: u64, i: u64) -> u64 {
    if i >= 32 || !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return 0
    }
    return tt_grp[(i) as usize]
}

fn tt_count(state: u64, g: u64) -> u64 {
    if g == 0 {
        return 0
    }
    var n: u64 = 0
    var k: u64 = 0
    while k < 32 {
        if valid(state, k) && tt_grp[(k) as usize] == g {
            n = n + 1
        }
        k = k + 1
    }
    return n
}

fn tt_grouped(state: u64, i: u64) -> bool {
    let g: u64 = tt_grp_of(state, i)
    return g != 0 && tt_count(state, g) >= 2
}

// is window `i` a tab behind the active one? (task bar and Alt+Tab skip it)
fn tt_is_bg(state: u64, i: u64) -> bool {
    if i >= 32 || !valid(state, i) {
        return false
    }
    return tt_grp[(i) as usize] != 0 && tt_bg[(i) as usize] != 0
}

// the n-th window of group `g` in creation order (0 = first), MAX_WIN if there is none
fn tt_nth(state: u64, g: u64, n: u64) -> u64 {
    var last: u64 = 0
    var found: u64 = MAX_WIN
    var step: u64 = 0
    while step <= n {
        var best: u64 = MAX_WIN
        var bo: u64 = 0xFFFFFFFFFFFF
        var k: u64 = 0
        while k < 32 {
            if valid(state, k) && tt_grp[(k) as usize] == g
                && tt_ord[(k) as usize] > last && tt_ord[(k) as usize] < bo {
                best = k
                bo = tt_ord[(k) as usize]
            }
            k = k + 1
        }
        if best == MAX_WIN {
            return MAX_WIN
        }
        found = best
        last = bo
        step = step + 1
    }
    return found
}

fn tt_pos(state: u64, g: u64, i: u64) -> u64 {
    let n: u64 = tt_count(state, g)
    var k: u64 = 0
    while k < n {
        if tt_nth(state, g, k) == i {
            return k
        }
        k = k + 1
    }
    return 0
}

// the shown tab of group `g` (the one that is not a background tab)
fn tt_active(state: u64, g: u64) -> u64 {
    var k: u64 = 0
    while k < 32 {
        if valid(state, k) && tt_grp[(k) as usize] == g && tt_bg[(k) as usize] == 0 {
            return k
        }
        k = k + 1
    }
    return tt_nth(state, g, 0)
}

fn tt_say(state: u64, kind: u64, w: u64, g: u64) {
    var s_new: [u8; 13] = "tt: new win=\0"
    var s_sw: [u8; 16] = "tt: switch win=\0"
    var s_cl: [u8; 15] = "tt: close win=\0"
    var s_g: [u8; 6] = " grp=\0"
    var s_t: [u8; 7] = " tabs=\0"
    if kind == 0 {
        serial.puts((&s_new[0]) as u64)
    } else if kind == 1 {
        serial.puts((&s_sw[0]) as u64)
    } else {
        serial.puts((&s_cl[0]) as u64)
    }
    serial.dec(w)
    serial.puts((&s_g[0]) as u64)
    serial.dec(g)
    serial.puts((&s_t[0]) as u64)
    serial.dec(tt_count(state, g))
    serial.nl()
}

// the tab that comes forward takes over place, size and maximised state of the one that goes back
fn tt_sync(state: u64, from: u64, to: u64) {
    if !valid(state, from) || !valid(state, to) {
        return
    }
    let mx: u64 = wg(state, from, W_FLAGS) & F_MAXIMIZED
    wsv(state, to, W_FLAGS, (wg(state, to, W_FLAGS) & ~F_MAXIMIZED) | mx)
    wsv(state, to, W_SAVXY, wg(state, from, W_SAVXY))
    wsv(state, to, W_SAVWH, wg(state, from, W_SAVWH))
    // W-X2: the way back of a maximised window lives in W_SAVE; without it the tab that comes forward restored to 0x0 at -4096,-4096 (gone)
    wsv(state, to, W_SAVE, wg(state, from, W_SAVE))
    let w: u64 = wg(state, from, W_W)
    let h: u64 = wg(state, from, W_H)
    if wg(state, to, W_W) != w || wg(state, to, W_H) != h {
        let _r: bool = resize_win(state, to, w, h)
    }
    move_win(state, to, win_x(state, from), win_y(state, from))
}

// bring tab `to` forward (and put the shown one of its group back)
fn tt_switch(state: u64, to: u64) {
    let g: u64 = tt_grp_of(state, to)
    if g == 0 {
        return
    }
    let from: u64 = tt_active(state, g)
    if from == to {
        return
    }
    tt_sync(state, from, to)
    tt_bg[(to) as usize] = 0
    set_hidden(state, to, false)
    raise_win(state, to)
    if from < MAX_WIN {
        tt_bg[(from) as usize] = 1
        set_hidden(state, from, true)
    }
    set_focus(state, to)
    tt_cnt[6] = tt_cnt[6] + 1
    tt_say(state, 1, to, g)
    damage_all(state)
}

fn tt_step(state: u64, i: u64, fwd: bool) {
    let g: u64 = tt_grp_of(state, i)
    let n: u64 = tt_count(state, g)
    if g == 0 || n < 2 {
        return
    }
    let p: u64 = tt_pos(state, g, i)
    var q: u64 = 0
    if fwd {
        q = (p + 1) % n
    } else {
        q = (p + n - 1) % n
    }
    let t: u64 = tt_nth(state, g, q)
    if t < MAX_WIN {
        tt_switch(state, t)
    }
}

fn tt_close_tab(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    tt_cnt[7] = tt_cnt[7] + 1
    tt_say(state, 2, i, tt_grp_of(state, i))
    ev_push(state, i, E_CLOSE, 0, 0, 0)
    destroy(state, i)
}

// called by `destroy` before the window goes: a shown tab leaves, the one before it (or the next) comes forward
fn tt_forget(state: u64, i: u64) {
    if i >= 32 {
        return
    }
    let g: u64 = tt_grp[(i) as usize]
    if g == 0 {
        return
    }
    if tt_bg[(i) as usize] == 0 && tt_count(state, g) >= 2 {
        let p: u64 = tt_pos(state, g, i)
        var q: u64 = 1
        if p > 0 {
            q = p - 1
        }
        let s: u64 = tt_nth(state, g, q)
        if s < MAX_WIN && s != i {
            tt_sync(state, i, s)
            tt_bg[(s) as usize] = 0
            set_hidden(state, s, false)
            raise_win(state, s)
        }
    }
    tt_grp[(i) as usize] = 0
    tt_ord[(i) as usize] = 0
    tt_bg[(i) as usize] = 0
}

// ---- a new tab: asked here, made by the desktop loop (/bin/term), joined by gfx.term_new
fn tt_request(state: u64, f: u64) {
    if tt_cnt[2] == 0 && f < 32 {
        tt_cnt[2] = f + 1
        tt_cnt[3] = kstate.get(state, kstate.TICKS)
        tt_cnt[4] = 0
    }
}

// r1309: a new terminal asked for with no terminal window to take the place of (request slot 32 = "no source": gfx.term_new makes it at
// the cascade place and does not join a group)
fn tt_request_free(state: u64) {
    if tt_cnt[2] == 0 {
        tt_cnt[2] = 33
        tt_cnt[3] = kstate.get(state, kstate.TICKS)
        tt_cnt[4] = 0
    }
}

// the terminal of a free request (no source window) is made: the request is over
fn tt_free_done(state: u64, w: u64) {
    if tt_cnt[2] == 33 && tt_cnt[4] != 0 {
        tt_cnt[2] = 0
        tt_cnt[4] = 0
        var s_fr: [u8; 14] = "tt: free win=\0"
        serial.puts((&s_fr[0]) as u64)
        serial.dec(w)
        serial.nl()
    }
}

// true ONCE per request: the desktop loop should start /bin/term now
fn tt_want_spawn(state: u64) -> bool {
    if tt_cnt[2] == 0 {
        return false
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if now > tt_cnt[3] + 1500 {
        tt_cnt[2] = 0
        tt_cnt[4] = 0
        return false
    }
    if tt_cnt[4] != 0 {
        return false
    }
    tt_cnt[4] = 1
    return true
}

fn tt_cancel(state: u64) {
    tt_cnt[2] = 0
    tt_cnt[4] = 0
}

// the window that asked for the tab being made now (MAX_WIN = none)
fn tt_src(state: u64) -> u64 {
    if tt_cnt[2] != 0 && tt_cnt[4] != 0 {
        let s: u64 = tt_cnt[2] - 1
        if s < 32 && valid(state, s) && wg(state, s, W_KIND) == K_TERM {
            return s
        }
    }
    return MAX_WIN
}

// window `n` (just made) becomes the shown tab of the group of `src`
fn tt_join(state: u64, n: u64, src: u64) {
    if n >= 32 || src >= 32 || n == src || !valid(state, n) || !valid(state, src) {
        return
    }
    var g: u64 = tt_grp[(src) as usize]
    if g == 0 {
        tt_cnt[0] = tt_cnt[0] + 1
        g = tt_cnt[0]
        tt_grp[(src) as usize] = g
        tt_cnt[1] = tt_cnt[1] + 1
        tt_ord[(src) as usize] = tt_cnt[1]
    }
    tt_cnt[1] = tt_cnt[1] + 1
    tt_grp[(n) as usize] = g
    tt_ord[(n) as usize] = tt_cnt[1]
    tt_bg[(n) as usize] = 0
    wsv(state, n, W_FLAGS, (wg(state, n, W_FLAGS) & ~F_MAXIMIZED) | (wg(state, src, W_FLAGS) & F_MAXIMIZED))
    wsv(state, n, W_SAVXY, wg(state, src, W_SAVXY))
    wsv(state, n, W_SAVWH, wg(state, src, W_SAVWH))
    wsv(state, n, W_SAVE, wg(state, src, W_SAVE))
    tt_bg[(src) as usize] = 1
    set_hidden(state, src, true)
    tt_cnt[5] = tt_cnt[5] + 1
    tt_cnt[2] = 0
    tt_cnt[4] = 0
    tt_say(state, 0, n, g)
    damage_all(state)
}

// ---- the strip: geometry (relative to the left / top edge of the window) and painter
fn tt_lo(state: u64) -> i64 {
    return (border(state) + title_pad(state)) as i64
}

// right end of the free part of the title bar: left of the three caption buttons (the classic close box)
fn tt_hi(state: u64, i: u64) -> i64 {
    let ow: i64 = outer_w(state, i) as i64
    var bx: i64 = ow - border(state) as i64 - close_w(state) as i64 - 3
    if form(state, FM_CAPTION) != 0 {
        bx = ow - border(state) as i64 - (CAP_N * cap_w(state)) as i64
    }
    return bx - 4 * uisc(state) as i64
}

fn tt_sq(state: u64) -> i64 {
    return title_h(state) as i64 - border(state) as i64 - 1
}

// width of one tab (n tabs share the bar left of the '+')
fn tt_tabw(state: u64, i: u64, n: u64) -> i64 {
    if n == 0 {
        return 0
    }
    let region: i64 = tt_hi(state, i) - tt_lo(state) - tt_sq(state)
    var w: i64 = region / (n as i64)
    let mx: i64 = (gs(state, S_PX_UI) * 10) as i64
    if w > mx {
        w = mx
    }
    if w < 8 {
        w = 8
    }
    return w
}

// the label of tab `k` into tt_lab, its length. mode 0 = "Terminal k", 1 = "Term k", 2 = "T k", 3 = "k" (narrow tabs keep the NUMBER,
// z11 showed three narrow tabs all reading "Term")
fn tt_label(k: u64, mode: u64) -> u64 {
    var w: [u8; 10] = "Terminal \0"
    var keep: u64 = 9
    if mode == 1 {
        keep = 5
    } else if mode == 2 {
        keep = 2
    } else if mode >= 3 {
        keep = 0
    }
    var j: u64 = 0
    while j < keep {
        tt_lab[(j) as usize] = w[(j) as usize]
        j = j + 1
    }
    var n: u64 = keep
    if k >= 10 {
        tt_lab[(n) as usize] = (48 + (k / 10) % 10) as u8
        n = n + 1
    }
    tt_lab[(n) as usize] = (48 + k % 10) as u8
    n = n + 1
    tt_lab[(n) as usize] = 0 as u8
    return n
}

// width in pixels of the first `len` octets of tt_lab
fn tt_measure(state: u64, f: u64, len: u64) -> i64 {
    let px: u64 = gs(state, S_PX_UI)
    var cx: i64 = 0
    var k: u64 = 0
    while k < len {
        let gid: u64 = ttf.glyph_of(state, f, tt_lab[(k) as usize] as u64)
        cx = cx + ttf.advance26(state, f, gid, px)
        k = k + 1
    }
    return cx >> 6
}

// the longest label of tab `k` that fits into `avail` pixels (into tt_lab, its length)
fn tt_fit_label(state: u64, f: u64, k: u64, avail: i64) -> u64 {
    var mode: u64 = 0
    var len: u64 = tt_label(k, 0)
    while mode < 3 && tt_measure(state, f, len) > avail {
        mode = mode + 1
        len = tt_label(k, mode)
    }
    return len
}

// ASCII text at x (baseline y), left to right, stops before `grenze`; returns the x behind the last glyph
fn tt_text(state: u64, f: u64, p: u64, len: u64, x: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64, grenze: i64) -> i64 {
    let px: u64 = gs(state, S_PX_UI)
    var cx: i64 = x * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < len {
        let c: u64 = kstate.get8(p + k) as u64
        let gid: u64 = ttf.glyph_of(state, f, c)
        if vorher != 0 {
            cx = cx + ttf.kern26(state, f, vorher, gid, px)
        }
        let slot: u64 = ttf.glyph(state, f, c, px)
        if slot < ttf.SLOTS {
            if (cx >> 6) + ttf.g_w(state, slot) as i64 > grenze {
                return cx >> 6
            }
            fb_glyph(state, slot, cx >> 6, y, color, ax0, ay0, ax1, ay1)
            cx = cx + ttf.g_adv(state, slot)
        } else {
            cx = cx + ttf.advance26(state, f, gid, px)
        }
        vorher = gid
        k = k + 1
    }
    return cx >> 6
}

// one glyph centred in the box [x0, x0 + w)
fn tt_glyph_mid(state: u64, f: u64, c: u64, x0: i64, w: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let px: u64 = gs(state, S_PX_UI)
    let gid: u64 = ttf.glyph_of(state, f, c)
    let adv: i64 = ttf.advance26(state, f, gid, px) >> 6
    tt_lab[12] = c as u8
    tt_lab[13] = 0 as u8
    let _e: i64 = tt_text(state, f, (&tt_lab[12]) as u64, 1, x0 + (w - adv) / 2, y, color,
        ax0, ay0, ax1, ay1, x0 + w + 4)
}

// the tab strip of the shown tab `i` (instead of the title text); wx / wy = window origin on the screen
fn tt_paint(state: u64, i: u64, wx: i64, wy: i64, titel: u64, schrift: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64, f: u64) {
    let g: u64 = tt_grp_of(state, i)
    let n: u64 = tt_count(state, g)
    if n == 0 {
        return
    }
    let uk: i64 = uisc(state) as i64
    let ty: i64 = wy + border(state) as i64 + 3 * uk
    let tbot: i64 = wy + title_h(state) as i64 - 1
    let tbh: i64 = tbot - ty
    if tbh <= 4 {
        return
    }
    let base: i64 = wy + title_base(state, f)
    let tw: i64 = tt_tabw(state, i, n)
    let lo: i64 = tt_lo(state)
    let sq: i64 = tt_sq(state)
    let cy1: i64 = imin(ay1, tbot)
    var k: u64 = 0
    while k < n {
        let wi: u64 = tt_nth(state, g, k)
        let x0: i64 = wx + lo + (k as i64) * tw
        let x1: i64 = x0 + tw - 2 * uk
        var col: u64 = 0
        if wi == i {
            fill_round(state, x0, ty, x1 - x0, tbh + 8 * uk, (6 * uk) as u64, wg(state, i, W_BG), 255,
                ax0, ay0, ax1, cy1)
            // z11: the shown tab was only white against grey. An accent bar under its label (the colour of the active frame) says "this one".
            fill_round(state, x0 + 6 * uk, tbot - 3 * uk, x1 - x0 - 12 * uk, 3 * uk, uk as u64, deco(state, DK_FRAME_ON), 255,
                ax0, ay0, ax1, cy1)
            col = wg(state, i, W_FG)
        } else {
            fill_round(state, x0, ty, x1 - x0, tbh + 8 * uk, (6 * uk) as u64, blend(titel, schrift, 40), 255,
                ax0, ay0, ax1, cy1)
            col = schrift
        }
        let len: u64 = tt_fit_label(state, f, k + 1, x1 - sq - (x0 + 8 * uk) - 2 * uk)
        let _t: i64 = tt_text(state, f, (&tt_lab[0]) as u64, len, x0 + 8 * uk, base, col,
            ax0, ay0, ax1, ay1, x1 - sq)
        tt_glyph_mid(state, f, 120, x1 - sq, sq, base, col, ax0, ay0, ax1, ay1)
        k = k + 1
    }
    // the '+' button behind the last tab
    let px0: i64 = wx + lo + (n as i64) * tw
    tt_glyph_mid(state, f, 43, px0, sq, base, schrift, ax0, ay0, ax1, ay1)
}

// a left press on the title bar of terminal window `i` at screen (x, y). True = consumed (a tab, its 'x', the '+').
// The shown tab itself and the empty bar are NOT consumed: they stay the window's title bar (drag, double click).
fn tt_press(state: u64, i: u64, x: i64, y: i64) -> bool {
    if i >= 32 || !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return false
    }
    let ry: i64 = y - win_y(state, i)
    if ry < border(state) as i64 || ry >= title_h(state) as i64 - 1 {
        return false
    }
    let lx: i64 = x - win_x(state, i)
    let g: u64 = tt_grp_of(state, i)
    let n: u64 = tt_count(state, g)
    let lo: i64 = tt_lo(state)
    let sq: i64 = tt_sq(state)
    if n >= 2 {
        let tw: i64 = tt_tabw(state, i, n)
        let uk: i64 = uisc(state) as i64
        var k: u64 = 0
        while k < n {
            let x0: i64 = lo + (k as i64) * tw
            let x1: i64 = x0 + tw - 2 * uk
            if lx >= x0 && lx < x1 {
                let wi: u64 = tt_nth(state, g, k)
                if lx >= x1 - sq {
                    tt_close_tab(state, wi)
                    return true
                }
                if wi != i {
                    tt_switch(state, wi)
                    return true
                }
                return false
            }
            k = k + 1
        }
        let px0: i64 = lo + (n as i64) * tw
        if lx >= px0 && lx < px0 + sq {
            tt_request(state, i)
            return true
        }
        return false
    }
    // a lone terminal: only the '+' at the right end of the bar
    let hi: i64 = tt_hi(state, i)
    if lx >= hi - sq && lx < hi {
        tt_request(state, i)
        return true
    }
    return false
}

// the '+' of a lone terminal (no tabs yet): at the right end of the free part of the title bar
fn tt_paint_plus(state: u64, i: u64, wx: i64, wy: i64, schrift: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64, f: u64) {
    let sq: i64 = tt_sq(state)
    let base: i64 = wy + title_base(state, f)
    tt_glyph_mid(state, f, 43, wx + tt_hi(state, i) - sq, sq, base, schrift, ax0, ay0, ax1, ay1)
}
