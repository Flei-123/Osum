            in("rdi") (&blk[0]) as u64,
            clobber("rax"),
            clobber("rcx"),
            clobber("rdx"),
            clobber("rsi"),
            clobber("rdi"),
            clobber("r8"),
            clobber("r9"),
            clobber("r10"),
            clobber("r11"),
            clobber("memory"))
    }
    if c4 < w {
