const EV_OFF: u64 = 0x4000 // (unused since the DELL ROUND: the event rings are at kstate.EVR_OFF)
const EV_SLOTS: u64 = 32
const EV_BYTES: u64 = 16
const EV_RING: u64 = 512 // EV_SLOTS * EV_BYTES
// RUNDE ECHTHARDWARE-6: so viele Ringverluste werden EINZELN gemeldet,
// danach nur noch gezaehlt. Siehe die Begruendung bei `ev_push`.
const VERL_SAY: u64 = 32
// RUNDE ECHTHARDWARE-3: 12 -> 8, aber jetzt am GANZEN Rand statt nur
// in der Ecke. Multipliziert mit `uisc` sind das auf Justins Schirm 16
// Bildpunkte Rand -- breit genug zum Treffen, schmal genug, dass ein
// Klick in die Flaeche noch ein Klick in die Flaeche ist.
// DELL ROUND: how much of a window must stay in sight when it is pushed
// over the left or right screen edge (base pixels, times uisc).
const VIS_MIN0: u64 = 96

// Z rank of a layer: the layer number doubled, and L_FLOAT in the gap between L_NORMAL (2) and L_TOP (4).
fn layer_rank(l: u64) -> u64 {
    if l == wmlayout.L_FLOAT {
        return 3
    }
    return l * 2
}

// ADDENDUM TASKBAR: the four screen edges. The numbers are written to
// /etc/taskbar.conf as words ("bottom", "top", "left", "right") and
// they are the same four numbers in the kernel, in the taskbar and in
// the settings application -- there is no translation table.
const EDGE_BOTTOM: u64 = 0
const EDGE_TOP: u64 = 1
const EDGE_LEFT: u64 = 2
const EDGE_RIGHT: u64 = 3

// ------------------------------- RUNDE VEKTOR: DIE ZEICHEN LIEGEN FERTIG
//
// Ein Fensterzeichen ist in jedem Bild dasselbe: dieselbe Form,
// dieselbe Groesse, dieselbe Kantenglaettung. Es JE BILD neu zu
// rastern -- Bezier zerlegen, Kanten bauen, vier Abtastzeilen je
// Bildzeile -- ist Arbeit, deren Ergebnis schon dasteht.
//
// GEMESSEN, warum das noetig ist: ohne diesen Speicher stieg bei
// 2560x1440 und Vervielfachung 2 die mittlere Bildzeit von 4234 auf
// 5211 Mikrosekunden, und im Betrieb rutschten sechsundzwanzig Bilder
// aus dem Fach 4..8 ms in das Fach 8..16 ms. Die Formen sind billig,
// aber sie sind es NICHT dreimal je Fenster und Bild.
//
// Vier Zeichen: Minimieren, Maximieren, Wiederherstellen, Schliessen.
// Je Zeichen die Deckung als ein Oktett pro Bildpunkt, hoechstens
// 40x40 (10 * Vervielfachung 4).
const CG_N: u64 = 4
// RUNDE KERN-FUI: EIN FACH HAELT JETZT VIER OKTETTE JE BILDPUNKT.
//
// `fui.core` schreibt BGRX (`core.put`), also vier Oktette -- es in ein
// Oktett je Punkt malen zu lassen ginge nur, indem man `core.fi` eine
// zweite Ablage beibringt, und das waere wieder die zweite Umsetzung,
// die diese Runde gerade abschafft. Also bekommt fUi, was es erwartet,
// und der Puffer waechst von 6400 auf 25 600 Oktette.
//
// Nach dem Rastern wird das Fach an Ort und Stelle auf ein Oktett je
// Punkt eingedampft (`cg_dampf`) -- das Uebertragen laeuft je BILD und
// liest dann ein Viertel.
const CG_KANTE: u64 = 40      // 10 * Vervielfachung 4
const CG_FACH: u64 = 6400     // 40 * 40 * 4 Oktette je Zeichen
const CG_MAX: u64 = 1600      // 40 * 40 Punkte

// RUNDE VEKTOR: die vier gerasterten Zeichen. `cg_gr` ist die
// Kantenlaenge, mit der sie gerastert wurden -- wechselt die
// Vervielfachung, gilt der Speicher nicht mehr.
static mut cg_deck: [u8; 25600] = [0 as u8; 25600]
static mut cg_gut: [u64; 4] = [0 as u64; 4]
static mut cg_gr: u64 = 0
static mut cg_w: [u64; 4] = [0 as u64; 4]
static mut cg_h: [u64; 4] = [0 as u64; 4]
static mut cg_treffer: u64 = 0
static mut cg_bauten: u64 = 0
// Ein Tick sind zehn Millisekunden, weil `time.TICK_HZ` 100 ist. Die
// Zahl steht hier als Konstante und nicht als Division im Quelltext,
// damit ein Takt von 250 Hz an EINER Stelle nachgezogen wird.
const MS_PRO_TICK: u64 = 10
// Wie hoch der Signaturstreifen ist. Vier Zeilen sind im PPM sicher zu
// finden und im Bild klein genug, um den Rest nicht zu verdecken.
const SIG_H: u64 = 4
// Die groesste Strebe, die ein Fenster anmelden darf. Sie steht hier,
// weil 0xFFFFFF mitten in einer Bedingung wie eine Farbe aussieht und
// keine ist.
const STRUT_MAX: u64 = 0x00FFFFFF
// Die beiden Prueffarben des Selbsttests. Sie faerben nichts, was ein
// Mensch sieht: sie werden geschrieben und wieder gelesen.
const PROBE_IN: u64 = 0x0000FF00
const PROBE_OUT: u64 = 0x00FF0000
// Terminal grid: six planes (characters, attributes, colours, and the same three for the saved main screen), each one holds
// TG cells. 16384 cells = 192 x 85, enough for a 1920 x 1080 window with a 10 x 19 cell (r468: the old 4096 cut the screen
// of a maximised terminal after 21 rows).
const TG: u64 = 16384
const TG_FRAMES: u64 = 24
const TG_ALT_WORDS: u64 = 6144
const APP_LEN: u64 = 24

// "kein Terminal". Absichtlich eine Zahl und kein Ruf nach `tty.fi`:
// dieses Modul darf `tty` NICHT einbinden, weil `tty` es einbindet
// (SINK_WINDOW). Der Abhaengigkeitsgraph bleibt ein Baum, und die
// Richtung ist die richtige -- der Fensterserver weiss nichts von
// Zeilendisziplinen, das Terminal weiss, wohin es schreibt.
const NO_TTY: u64 = 255

fn set_deco_colour(state: u64, i: u64, v: u64) -> bool {
    if i >= wmbase.DECO_SLOTS {
        return false
    }
    wmlayout.ss(state, wmlayout.S_DECO + i * 8, (v & wmdraw.RGB24) + 1)
    wmlayout.ss(state, wmlayout.S_DECON, wmlayout.gs(state, wmlayout.S_DECON) + 1)
    if i == wmlayout.DK_DESK {
        wmlayout.ss(state, wmlayout.S_DESK, wmbase.deco(state, wmlayout.DK_DESK))
    }
    // EIN TERMINALFENSTER, DAS SCHON OFFEN IST, ZIEHT MIT. Seine
    // beiden Farben stehen im Fenster und nicht im Server, weil jedes
    // Terminal seine eigenen haben darf; wer nur die Voreinstellung
    // aendert, aendert sonst nur die Fenster, die es noch nicht gibt.
    if i == wmlayout.DK_TERM_FG || i == wmlayout.DK_TERM_BG {
        var k: u64 = 0
        while k < wmbase.MAX_WIN {
            if wmlayout.wg(state, k, wmlayout.W_USED) != 0 && wmlayout.wg(state, k, wmlayout.W_KIND) == wmlayout.K_TERM {
                if i == wmlayout.DK_TERM_FG {
                    wmlayout.wsv(state, k, wmlayout.W_FG, wmbase.deco(state, wmlayout.DK_TERM_FG))
                } else {
                    wmlayout.wsv(state, k, wmlayout.W_BG, wmbase.deco(state, wmlayout.DK_TERM_BG))
                    // ==================================== RUNDE FARBE
                    // DIE NEUE FARBE MUSS AUCH GEMALT WERDEN.
                    //
                    // Hier wurde bis zu dieser Runde NUR `W_BG`
                    // gesetzt. Das ist die Farbe, mit der das Terminal
                    // KUENFTIG loescht -- die Bildpunkte, die schon im
                    // Puffer stehen, behalten die alte. Ein Terminal,
                    // das beim Start des Systems entsteht (der
                    // Schreibtisch macht genau das) und dessen Flaeche
                    // sich danach nicht mehr ganz erneuert, bleibt
                    // deshalb fuer immer in der eingebauten Farbe.
                    //
                    // GEMESSEN (1280x800, mode=dark, dieser Runde):
                    // #10141a auf 20,4 Prozent der Bildflaeche,
                    // Blaustich B-R = +10, waehrend der Rest des
                    // Schirms schon auf der neutralen Rampe stand
                    // (#18181b, B-R = +3). Genau das Fenster, von dem
                    // Justin sagt, es sei "immer noch blau".
                    //
                    // Der Reihenfolge wegen ist das kein Sonderfall,
                    // sondern die Regel: die Leiste schickt ihre elf
                    // Farben, WENN sie laeuft -- und das ist immer
                    // NACH dem ersten Fenster.
                    wmdraw.fill(state, k, 0, 0, wmlayout.wg(state, k, wmlayout.W_W),
                        wmlayout.wg(state, k, wmlayout.W_H), wmbase.deco(state, wmlayout.DK_TERM_BG))
                    term_redraw(state, k)
                    wmdamage.damage_win(state, k)
                }
            }
            k = k + 1
        }
    }
    return true
}

// DIE GEGENPROBE ZU DIESER RUNDE, und sie ist der einzige Grund, warum
// `ring_round` und der alte Schattenweg stehenbleiben duerfen.
//
// Ein "vorher/nachher" aus ZWEI Laeufen ist zwei Maschinen: anderer
// Wirt, andere Last, anderer Zeitgeber. Mit diesem Schalter laufen
// beide Fassungen in EINEM Bild nacheinander, auf demselben Fenster
// und mit demselben Zaehler -- und der Unterschied ist dann wirklich
// der Unterschied.
fn set_shadow_old(state: u64, on: bool) {
    if on {
        wmlayout.ss(state, wmlayout.S_SHOLD, 1)
    } else {
        wmlayout.ss(state, wmlayout.S_SHOLD, 0)
    }
}

fn cap_hover(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_CAPHOV)
}

fn cap_hits(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_CAPHITS)
}

// =====================================================================
// DIE VORBERECHNETE SCHATTENMASKE -- der Kern dieser Runde.
// =====================================================================
//
// WAS AM ALTEN WEG TEUER WAR, und es waren nicht die Bildpunkte.
//
// `ring_round` tastet jede Ecke jedes Rings neu ab: fuer jeden der
// (r+k)^2 Punkte eines Eckquadrats ZWEI Aufrufe von `corner_cov`, und
// jeder davon bis zu sechzehn Unterproben. Bei r=10 und reach=6 sind
// das je Fenster 4 * sum_{k=1..6}(10+k)^2 = 4444 Eckpunkte mal zwei
// Abtastungen -- BEI JEDEM BILD, obwohl sich an der Ecke zwischen zwei
// Bildern nichts aendert. Ein Schatten ist eine Funktion der FORM und
// nicht der Zeit.
//
// ALSO EINMAL RECHNEN. Der Schatten ist punktsymmetrisch in seinen vier
// Ecken und in seinen vier geraden Stuecken konstant je Abstand. Damit
// zerfaellt er in genau zwei Tafeln:
//
//   * EIN Eckquadrat mit S = r + reach Kanten laenge, das viermal
//     gespiegelt gemalt wird,
//   * EIN Streifen von `reach` Deckungswerten fuer oben, unten, links
//     und rechts.
//
// Das ist die Neun-Felder-Zerlegung, die jedes Fenstersystem fuer
// Rahmenbilder benutzt, nur mit Deckung statt Farbe. Sie haengt NICHT
// an der Fenstergroesse: eine Maske bedient jedes Fenster auf dem
// Schirm.
//
// UND SIE LIEST DEN UNTERGRUND NICHT. Das ist die Auflage dieser Runde
// und zugleich der Grund, warum das hier ueberhaupt geht: in der Maske
// steht Deckung, keine Farbe. Was darunter liegt, kommt erst beim
// Mischen dazu -- `fb.pixel_a` liest genau den einen Bildpunkt, den es
// gerade schreibt, und niemals eine Flaeche. Ein Backdrop-Readback
// waere das Gegenteil: erst den ganzen Bereich lesen, dann rechnen.
//
// WAS DIE MASKE GENAUER MACHT ALS DIE RINGE. Die Ringe liegen auf
// ganzen Bildpunkten; ihre Boegen ueberlappen sich an den Diagonalen
// und lassen an den Achsen Luecken. Die Maske rechnet den ECHTEN
// Abstand zum Fensterrand in Sechzehnteln eines Bildpunktes und liest
// den Abfall an dieser Stelle ab. An ganzzahligen Abstaenden kommt
// dasselbe heraus wie vorher -- die Rampe ist dieselbe Formel --,
// dazwischen etwas Besseres.
// RUNDE GLAS: DIE DECKKRAFT DES FENSTERSCHMUCKS, als 0..255.
//
// Rahmen, Titelleiste und die Flaechen der Schaltflaechen gehen durch
// diese eine Zahl. Sie steht in einer Funktion und nicht an sechs
// Stellen im Quelltext, weil sonst die naechste Runde fuenf davon
// nachzieht und eine vergisst.
fn deco_alpha(state: u64) -> u64 {
    return wmbase.form_or(state, wmlayout.FM_WIN_ALPHA, 100) * 255 / 100
}

fn deco_writes(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_DECON)
}

fn count(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_COUNT)
}

// W-X1: every frame that reached the card (composes + pointer-only blits); the desktop loop compares it to see "something was painted".
fn frames_total(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_COMPOSITES) + lj_cp_n
}

// W-X1: the pointer / key path is hot (input in the last LJ_ACTIVE_US); the quiet backoff of the desktop loop never applies then.
fn input_hot(state: u64) -> bool {
    return lj_active(state)
}

// RUNDE MESSTAFEL -- die fuenf Stufen, von aussen lesbar.
fn evpush(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_EVPUSH)
}

fn evpop(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_EVPOP)
}

fn keyin(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_KEYIN)
}

fn evdrops(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_EVDROP)
}

// RUNDE BLECH2: zusammengefasste Bewegungen und Ereignisse an das
// abholerlose Terminal des Kerns -- beides KEIN Verlust, beides eine
// Zahl auf Tafelzeile 4 bzw. in `wm: fen`.
fn evkoal(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_EVKOAL)
}

fn evterm(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_EVTERM)
}

fn win_paints(state: u64, i: u64) -> u64 {
    if !wmbase.valid(state, i) {
        return 0
    }
    return wmlayout.wg(state, i, wmlayout.W_PAINTS)
}

fn win_px(state: u64, i: u64) -> u64 {
    if !wmbase.valid(state, i) {
        return 0
    }
    return wmlayout.wg(state, i, wmlayout.W_PX)
}

fn win_flags(state: u64, i: u64) -> u64 {
    if !wmbase.valid(state, i) {
        return 0
    }
    return wmlayout.wg(state, i, wmlayout.W_FLAGS)
}

// DAS FENSTER DER TASKLEISTE, ohne dass der Kern die Leiste kennen muss:
// das oberste benutzte Fenster auf der Ebene L_TOP. Genau dorthin legt
// `taskbar.fi` sich (`WS_LAYER = L_TOP`), und sonst nichts.
// RUNDE LEISTE: NICHT MEHR FUER DIE LEISTE BENUTZEN -- dafuer gibt es
// `panel_win`. Diese hier liefert das oberste Fenster der obersten
// Ebene, was seit dem Startmenue etwas anderes ist.
fn top_layer_win(state: u64) -> u64 {
    var z: u64 = wmlayout.gs(state, wmlayout.S_COUNT)
    while z > 0 {
        z = z - 1
        let i: u64 = wmbase.at_z(state, z)
        if i < wmbase.MAX_WIN && wmlayout.wg(state, i, wmlayout.W_USED) != 0 {
            if wmlayout.wg(state, i, wmlayout.W_LAYER) == wmlayout.L_TOP {
                return i
            }
        }
    }
    return wmbase.MAX_WIN
}

// ================== RUNDE MESSTAFEL: DIE FENSTERLISTE AUF DIE LEITUNG
//
// Eine Zeile je Fenster, mit ALLEM, was zwischen "angelegt" und
// "sichtbar" schiefgehen kann: Kennung, Lage, Groesse, Ebene, die
// Merkerbits, der Platz in der Stapelfolge -- und die beiden neuen
// Zaehler. Wer diese Liste hat, muss ueber die Taskleiste nicht mehr
// raten.
// r402 (docs/COMPOSITOR.md S0): THE FRAME TIME SINCE THE LAST F12, by bucket. The counters of the frame
// time (`S_FRUS ...`, the same ones `bildzeit:` prints at the end of a run) are printed and set to
// zero, so that a runner can measure one PHASE after the boot (idle, pointer, menu, window drag)
// and not the mean over a whole run that is dominated by the start.
fn bild_say_reset(state: u64) {
    wmoverlay.cadence_say_reset(state)
    var s_b: [u8; 12] = "wm: bild n=\0"
    var s_m: [u8; 9] = " mittel=\0"
    var s_x: [u8; 6] = " max=\0"
    var s_u: [u8; 10] = " ueber16=\0"
    var s_f: [u8; 7] = " fach=\0"
    let n: u64 = wmlayout.gs(state, wmlayout.S_FRN)
    serial.puts((&s_b[0]) as u64)
    serial.dec(n)
    serial.puts((&s_m[0]) as u64)
    if n != 0 {
        serial.dec(wmlayout.gs(state, wmlayout.S_FRUS) / n)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_x[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_FRMAX))
    serial.puts((&s_u[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_FRUEBER))
    serial.puts((&s_f[0]) as u64)
    var k: u64 = 0
    while k < 8 {
        serial.dec(wmlayout.gs(state, wmlayout.S_FRH + k * 8))
        if k < 7 {
            serial.put(32 as u8)
        }
        wmlayout.ss(state, wmlayout.S_FRH + k * 8, 0)
        k = k + 1
    }
    serial.nl()
    if fb.phases_an(state) {
        lj_say_reset(state)
    }
    // r460: where the time of those frames went (microseconds summed; divide by n for the mean per frame). `blurs= bhits= blurus=`
    // are running totals of the blur counters (NOT reset here: the acceptance runs read them); a runner takes differences.
    var s_p: [u8; 14] = "wm: phase n=\0\0"
    var s_p1: [u8; 5] = " bg=\0"
    var s_p2: [u8; 6] = " win=\0"
    var s_p3: [u8; 7] = " drag=\0"
    var s_p4: [u8; 6] = " top=\0"
    var s_p5: [u8; 7] = " pend=\0"
    var s_p6: [u8; 5] = " px=\0"
    var s_p7: [u8; 7] = " blur=\0"
    var s_p8: [u8; 8] = " glass=\0"
    var s_p9: [u8; 9] = " shadow=\0"
    var s_pa: [u8; 6] = " rgn=\0"
    var s_pb: [u8; 8] = " saved=\0"
    var s_pc: [u8; 8] = " blurs=\0"
    var s_pd: [u8; 8] = " bhits=\0"
    var s_pe: [u8; 9] = " blurus=\0"
    // only when the kernel word `phases` is on: this line is long, and the acceptance runs that press F12 for the window table
    // must not get a second long serial line to interleave with (lockseal reads a program's line in the same window)
    if fb.phases_an(state) {
        serial.puts((&s_p[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_PH_N))
        serial.puts((&s_p1[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_PH_BG))
        serial.puts((&s_p2[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_PH_WIN))
        serial.puts((&s_p3[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_PH_DRAG))
        serial.puts((&s_p4[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_PH_TOP))
        serial.puts((&s_p5[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_PH_PEND))
        serial.puts((&s_p6[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_PH_PX))
        serial.puts((&s_p7[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_PH_BLUR))
        serial.puts((&s_p8[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_PH_GLASS))
        serial.puts((&s_p9[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_PH_SHADOW))
        serial.puts((&s_pa[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_RFRAMES))
        serial.puts((&s_pb[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_RSAVED))
        serial.puts((&s_pc[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_BLURS))
        serial.puts((&s_pd[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_BLURCACHE))
        serial.puts((&s_pe[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_BLURUS))
        serial.nl()
    }
    cp_say_reset(state)
    // COMPOSITOR S3: what the clients' pixels cost since the last F12. `blitpx` are the pixels the kernel copied out of a client (WIG_BLIT),
    // `shpx` the pixels of shared windows that were named dirty WITHOUT a copy. Printed only once a shared window or a blit happened.
    if wmlayout.gs(state, wmlayout.S_BL_PX) != 0 || wmlayout.gs(state, wmlayout.S_SH_DMG) != 0 {
        var s_s: [u8; 14] = "wm: shared n=\0"
        var s_s1: [u8; 9] = " blitpx=\0"
        var s_s2: [u8; 8] = " blits=\0"
        var s_s3: [u8; 7] = " shpx=\0"
        var s_s4: [u8; 8] = " shdmg=\0"
        var s_s5: [u8; 9] = " attach=\0"
        var s_s6: [u8; 9] = " detach=\0"
        serial.puts((&s_s[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_FRN))
        serial.puts((&s_s1[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_BL_PX))
        serial.puts((&s_s2[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_BL_N))
        serial.puts((&s_s3[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_SH_PX))
        serial.puts((&s_s4[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_SH_DMG))
        serial.puts((&s_s5[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_SH_ATT))
        serial.puts((&s_s6[0]) as u64)
        serial.dec(wmlayout.gs(state, wmlayout.S_SH_DET))
        serial.nl()
        wmlayout.ss(state, wmlayout.S_BL_PX, 0)
        wmlayout.ss(state, wmlayout.S_BL_N, 0)
        wmlayout.ss(state, wmlayout.S_SH_PX, 0)
        wmlayout.ss(state, wmlayout.S_SH_DMG, 0)
    }
    wmlayout.ss(state, wmlayout.S_RFRAMES, 0)
    wmlayout.ss(state, wmlayout.S_RSAVED, 0)
    wmlayout.ss(state, wmlayout.S_PH_BLUR, 0)
    wmlayout.ss(state, wmlayout.S_PH_GLASS, 0)
    wmlayout.ss(state, wmlayout.S_PH_SHADOW, 0)
    wmlayout.ss(state, wmlayout.S_PH_N, 0)
    wmlayout.ss(state, wmlayout.S_PH_BG, 0)
    wmlayout.ss(state, wmlayout.S_PH_WIN, 0)
    wmlayout.ss(state, wmlayout.S_PH_DRAG, 0)
    wmlayout.ss(state, wmlayout.S_PH_TOP, 0)
    wmlayout.ss(state, wmlayout.S_PH_PEND, 0)
    wmlayout.ss(state, wmlayout.S_PH_PX, 0)
    wmlayout.ss(state, wmlayout.S_FRUS, 0)
    wmlayout.ss(state, wmlayout.S_FRN, 0)
    wmlayout.ss(state, wmlayout.S_FRMAX, 0)
    wmlayout.ss(state, wmlayout.S_FRUEBER, 0)
    // W-PRESENT: what the copies to the card cost since the last F12 (n copies, microseconds summed, the longest one), and the running
    // octets those copies pushed (measured around the copy, so the board and the console do not count) and the running rectangle total.
    var s_w0: [u8; 14] = "wm: flush n=\0\0"
    var s_w1: [u8; 5] = " us=\0"
    var s_w2: [u8; 6] = " max=\0"
    var s_w3: [u8; 6] = " okt=\0"
    var s_w4: [u8; 7] = " rect=\0"
    serial.puts((&s_w0[0]) as u64)
    serial.dec(fb.flush_us_n(state))
    serial.puts((&s_w1[0]) as u64)
    serial.dec(fb.flush_us_sum(state))
    serial.puts((&s_w2[0]) as u64)
    serial.dec(fb.flush_us_max(state))
    serial.puts((&s_w3[0]) as u64)
    serial.dec(fb.flush_okt(state))
    serial.puts((&s_w4[0]) as u64)
    serial.dec(fb.tx_rects(state))
    serial.nl()
    var s_b0: [u8; 13] = "wm: beam on=\0"
    var s_b1: [u8; 7] = " pipe=\0"
    var s_b2: [u8; 5] = " vt=\0"
    var s_b3: [u8; 6] = " mhz=\0"
    var s_b4: [u8; 9] = " copies=\0"
    var s_b5: [u8; 8] = " waits=\0"
    var s_b6: [u8; 5] = " to=\0"
    var s_b7: [u8; 6] = " big=\0"
    var s_b8: [u8; 9] = " waitus=\0"
    var s_b9: [u8; 8] = " maxus=\0"
    var s_ba: [u8; 6] = " rin=\0"
    var s_bb: [u8; 7] = " rout=\0"
    serial.puts((&s_b0[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_ON))
    serial.puts((&s_b1[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_PIPE))
    serial.puts((&s_b2[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_VT))
    serial.puts((&s_b3[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_MHZ))
    serial.puts((&s_b4[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_COPY))
    serial.puts((&s_b5[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_WAITS))
    serial.puts((&s_b6[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_TO))
    serial.puts((&s_b7[0]) as u64)
    serial.dec(fb.bm(state, fb.S_BM_BIG))
    serial.puts((&s_b8[0]) as u64)
    serial.dec(time_us(state, fb.bm(state, fb.S_BM_WCYC)))
    serial.puts((&s_b9[0]) as u64)
    serial.dec(time_us(state, fb.bm(state, fb.S_BM_WMAX)))
    serial.puts((&s_ba[0]) as u64)
    serial.dec(fb.bm(state, fb.S_RM_IN))
    serial.puts((&s_bb[0]) as u64)
    serial.dec(fb.bm(state, fb.S_RM_OUT))
    serial.nl()
    beam.say(state)
    pixelguard.say()
    fb.flush_reset(state)
}

fn wins_say(state: u64) {
    if !wmbase.ready(state) {
        return
    }
    // r402: a marker in front of every dump, so that a runner can tell one dump from the next
    var s_fl: [u8; 14] = "wm: fenliste\0\0"
    serial.puts((&s_fl[0]) as u64)
    serial.nl()
    bild_say_reset(state)
    var s_h: [u8; 11] = "wm: fen i=\0"
    var s_id: [u8; 5] = " id=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var s_l: [u8; 6] = " lay=\0"
    var s_f: [u8; 5] = " fl=\0"
    var s_z: [u8; 4] = " z=\0"
    var s_p: [u8; 8] = " malen=\0"
    var s_px: [u8; 5] = " px=\0"
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmlayout.wg(state, i, wmlayout.W_USED) != 0 {
            serial.puts((&s_h[0]) as u64)
            serial.dec(i)
            serial.puts((&s_id[0]) as u64)
            serial.dec(wmlayout.wg(state, i, wmlayout.W_ID))
            serial.puts((&s_x[0]) as u64)
            serial.dec(wmbase.win_x(state, i) as u64)
            serial.puts((&s_y[0]) as u64)
            serial.dec(wmbase.win_y(state, i) as u64)
            serial.puts((&s_w[0]) as u64)
            serial.dec(wmlayout.wg(state, i, wmlayout.W_W))
            serial.puts((&s_hh[0]) as u64)
            serial.dec(wmlayout.wg(state, i, wmlayout.W_H))
            serial.puts((&s_l[0]) as u64)
            serial.dec(wmlayout.wg(state, i, wmlayout.W_LAYER))
            serial.puts((&s_f[0]) as u64)
            serial.dec(wmlayout.wg(state, i, wmlayout.W_FLAGS))
            serial.puts((&s_z[0]) as u64)
            serial.dec(wmlayout.wg(state, i, wmlayout.W_Z))
            serial.puts((&s_p[0]) as u64)
            serial.dec(wmlayout.wg(state, i, wmlayout.W_PAINTS))
            serial.puts((&s_px[0]) as u64)
            serial.dec(wmlayout.wg(state, i, wmlayout.W_PX))
            // ============================================== RUNDE BLECH2
            // WO DER TITEL STEHT, damit ein Laeufer ihn im Bild
            // bildpunktgenau nachrechnen kann (tools/metal2/run.sh mit
            // `checkshot.py tkette`): Anfang, Grundlinie, Schriftgroesse,
            // Schrift- und Leistenfarbe -- und `tka`, die alte
            // TK-Zaehlweise, zum Vergleich mit dem Bild.
            if wmbase.deko(state, i) {
                var s_tx: [u8; 5] = " tx=\0"
                var s_tb: [u8; 5] = " tb=\0"
                var s_tp: [u8; 5] = " tp=\0"
                var s_tf: [u8; 5] = " tf=\0"
                var s_tg: [u8; 5] = " tg=\0"
                var s_tk: [u8; 6] = " tka=\0"
                let f: u64 = wmlayout.gs(state, wmlayout.S_FONT_UI)
                let px: u64 = wmlayout.gs(state, wmlayout.S_PX_UI)
                var before: i64 = 0
                let sicht: u64 = netview.view_of(state, wmbase.win_owner(state, i))
                if sicht != netview.V_REAL && sicht <= 3 {
                    before = netmark.W as i64 + 4
                }
                var tf: u64 = wmbase.deco_rgb(state, wmlayout.DK_TEXT)
                var tg: u64 = wmbase.deco_rgb(state, wmlayout.DK_TITLE)
                if wmbase.focus(state) == i {
                    tf = wmbase.deco_rgb(state, wmlayout.DK_TEXT_ON)
                    tg = wmbase.deco_rgb(state, wmlayout.DK_TITLE_ON)
                }
                var tb: i64 = wmbase.win_y(state, i) + wmgeom.border(state) as i64
                if f < ttf.MAX_FONTS {
                    tb = wmbase.win_y(state, i) + wmgeom.title_base(state, f)
                }
                serial.puts((&s_tx[0]) as u64)
                serial.dec((wmbase.win_x(state, i) + wmgeom.border(state) as i64 + wmgeom.title_pad(state) as i64 + before) as u64)
                serial.puts((&s_tb[0]) as u64)
                serial.dec(tb as u64)
                serial.puts((&s_tp[0]) as u64)
                serial.dec(px)
                serial.puts((&s_tf[0]) as u64)
                serial.hex(tf)
                serial.puts((&s_tg[0]) as u64)
                serial.hex(tg)
                serial.puts((&s_tk[0]) as u64)
                serial.dec(titel_schnitt_alt)
                // r402: the measures of the chrome, so that a runner can place the three
                // caption buttons without a constant of its own
                var s_br: [u8; 6] = " bar=\0"
                var s_cw: [u8; 7] = " capw=\0"
                var s_fr: [u8; 5] = " fr=\0"
                serial.puts((&s_br[0]) as u64)
                serial.dec(wmgeom.title_h(state) - 1 - wmgeom.border(state))
                serial.puts((&s_cw[0]) as u64)
                serial.dec(wmgeom.cap_w(state))
                serial.puts((&s_fr[0]) as u64)
                serial.dec(wmgeom.border(state))
            }
            serial.nl()
        }
        i = i + 1
    }
}

fn blits(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_BLITS)
}

fn pixels(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_PIXELS)
}

fn last_us(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_LASTUS)
}

fn font_ui(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_FONT_UI)
}

fn font_mono(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_FONT_MONO)
}

fn px_ui(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_PX_UI)
}

fn px_mono(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_PX_MONO)
}

fn set_fonts(state: u64, ui: u64, pui: u64, mono: u64, pmono: u64) {
    wmlayout.ss(state, wmlayout.S_FONT_UI, ui)
    wmlayout.ss(state, wmlayout.S_PX_UI, pui)
    wmlayout.ss(state, wmlayout.S_FONT_MONO, mono)
    wmlayout.ss(state, wmlayout.S_PX_MONO, pmono)
}

fn win_buf(state: u64, i: u64) -> u64 {
    return wmlayout.wg(state, i, wmlayout.W_BUF)
}

fn win_kind(state: u64, i: u64) -> u64 {
    return wmlayout.wg(state, i, wmlayout.W_KIND)
}

fn win_id(state: u64, i: u64) -> u64 {
    return wmlayout.wg(state, i, wmlayout.W_ID)
}

// r454: does this window paint its own title strip?
fn cap_client(state: u64, i: u64) -> bool {
    if i >= wmbase.MAX_WIN || !wmbase.valid(state, i) || !wmbase.deko(state, i) {
        return false
    }
    return (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_CAPCLIENT) != 0
}

// r454: the height of the strip in buffer rows: the title bar and the line under it (what the buffer grows by)
fn strip_h(state: u64) -> u64 {
    return wmgeom.title_h(state) - wmgeom.border(state)
}

// r454: the width the three caption buttons (and the frame) take at the right end of the strip
fn cap_strip_w(state: u64) -> u64 {
    return wmlayout.CAP_N * wmgeom.cap_w(state) + wmgeom.border(state)
}

// r454: is the client x inside the declared drag region of the strip? (the caption buttons are tested before this)
fn strip_drag_at(state: u64, i: u64, x: i64) -> bool {
    let r: u64 = wmlayout.wg(state, i, wmlayout.W_DRAGX)
    let x0: u64 = r & 0xFFFFFFFF
    let x1: u64 = r >> 32
    if x1 <= x0 || x < 0 {
        return false
    }
    return (x as u64) >= x0 && (x as u64) < x1
}

// r454: the program declares the empty part of its strip: [x0, x1) in client coordinates (0, 0 = none)
fn set_strip_drag(state: u64, i: u64, x0: u64, x1: u64) -> bool {
    if !cap_client(state, i) {
        return false
    }
    wmlayout.wsv(state, i, wmlayout.W_DRAGX, (x0 & 0xFFFFFFFF) | (x1 << 32))
    return true
}

// r454: switch the client strip on or off. The buffer grows (shrinks) by the strip height so that the OUTER size of the window
// stays what it was; the program gets an E_RESIZE with the new size and lays itself out again.
fn set_cap_client(state: u64, i: u64, on: bool) -> bool {
    if !wmbase.valid(state, i) || !wmbase.deko(state, i) {
        return false
    }
    // the counter-proof of tools/tabstrip: the server says no, the program keeps its old layout
    if on && fb.nostrip_an(state) {
        return false
    }
    let has: bool = (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_CAPCLIENT) != 0
    if on == has {
        return true
    }
    let sh: u64 = strip_h(state)
    let w: u64 = wmlayout.wg(state, i, wmlayout.W_W)
    let h: u64 = wmlayout.wg(state, i, wmlayout.W_H)
    let f: u64 = wmlayout.wg(state, i, wmlayout.W_FLAGS)
    if on {
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, f | wmlayout.F_CAPCLIENT)
        wmlayout.wsv(state, i, wmlayout.W_DRAGX, 0)
        if !resize_win(state, i, w, h + sh) {
            wmlayout.wsv(state, i, wmlayout.W_FLAGS, f)
            return false
        }
        return true
    }
    if h <= sh + 16 {
        return false
    }
    wmlayout.wsv(state, i, wmlayout.W_FLAGS, f & ~wmlayout.F_CAPCLIENT)
    wmlayout.wsv(state, i, wmlayout.W_DRAGX, 0)
    if !resize_win(state, i, w, h - sh) {
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, f)
        return false
    }
    return true
}

fn win_layer(state: u64, i: u64) -> u64 {
    if i >= wmbase.MAX_WIN {
        return wmlayout.L_NORMAL
    }
    return wmlayout.wg(state, i, wmlayout.W_LAYER)
}

fn win_hidden(state: u64, i: u64) -> bool {
    if i >= wmbase.MAX_WIN {
        return false
    }
    return (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) != 0
}

fn win_deco(state: u64, i: u64) -> bool {
    if i >= wmbase.MAX_WIN {
        return false
    }
    return wmbase.deko(state, i)
}

// Die Adresse des Titels IM KERNEL. Nur `sys.fi` benutzt sie, um ihn
// nach Ring 3 zu kopieren -- die Taskleiste braucht Namen.
fn win_title(state: u64, i: u64) -> u64 {
    if i >= wmbase.MAX_WIN {
        return 0
    }
    return state + wmlayout.wat(i) + wmlayout.W_TITLE
}

// Das Fenster mit dieser Nummer. Die Taskleiste kennt FREMDE Fenster
// nur ueber ihre Nummer -- ein Handle bekommt sie nicht, und ein Platz
// in der Tafel waere eine Zahl, die sich unter ihr aendert.
fn by_id(state: u64, id: u64) -> u64 {
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmlayout.wg(state, i, wmlayout.W_USED) != 0 && wmlayout.wg(state, i, wmlayout.W_ID) == id {
            return i
        }
        i = i + 1
    }
    return wmbase.MAX_WIN
}

fn hides(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_HIDES)
}

fn shows(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_SHOWS)
}

fn nolayer(state: u64) -> bool {
    return wmlayout.gs(state, wmlayout.S_NOLAYER) != 0
}

fn nomin(state: u64) -> bool {
    return wmlayout.gs(state, wmlayout.S_NOMIN) != 0
}

fn set_nolayer(state: u64, on: bool) {
    if on {
        wmlayout.ss(state, wmlayout.S_NOLAYER, 1)
    } else {
        wmlayout.ss(state, wmlayout.S_NOLAYER, 0)
    }
}

fn set_nomin(state: u64, on: bool) {
    if on {
        wmlayout.ss(state, wmlayout.S_NOMIN, 1)
    } else {
        wmlayout.ss(state, wmlayout.S_NOMIN, 0)
    }
}

fn term_cols(state: u64, i: u64) -> u64 {
    return wmlayout.wg(state, i, wmlayout.W_COLS)
}

fn term_rows(state: u64, i: u64) -> u64 {
    return wmlayout.wg(state, i, wmlayout.W_ROWS)
}

fn term_cx(state: u64, i: u64) -> u64 {
    return wmlayout.wg(state, i, wmlayout.W_CX)
}

fn term_cy(state: u64, i: u64) -> u64 {
    return wmlayout.wg(state, i, wmlayout.W_CY)
}

// ====================================== RUNDE GLAS (nachtrag)
// WO EINE ZELLE WIRKLICH LIEGT -- gefragt von aussen.
//
// `wm: term win=0 cols= rows= cell=` hat die Zellengroesse bis zu
// dieser Runde aus zwei festen Zahlen GETEILT (560/cols, 380/rows),
// und das stimmte genau fuer den einen Aufbau, in dem es geschrieben
// wurde. Wer eine Zeile des Terminals bildpunktgenau nachrastern will
// -- tools/look/umlaut.py tut das seit dem Nachtrag --, braucht die
// echten Zahlen: Zellenbreite, Zellenhoehe und den Aufsteiger der
// Festbreitenschrift, denn die Grundlinie der Zeile r liegt bei
// y + r * Zellenhoehe + Aufsteiger. Geraten wird hier nichts mehr.
fn term_cellw(state: u64, i: u64) -> u64 {
    return wmlayout.wg(state, i, wmlayout.W_CELLW)
}

fn term_cellh(state: u64, i: u64) -> u64 {
    return wmlayout.wg(state, i, wmlayout.W_CELLH)
}

fn term_asc(state: u64) -> u64 {
    let f: u64 = wmlayout.gs(state, wmlayout.S_FONT_MONO)
    if f >= ttf.MAX_FONTS {
        return 0
    }
    // `ttf.ascent` rechnet in i64 (ein Aufsteiger kann rechnerisch
    // negativ werden); hier ist er eine Hoehe in Bildpunkten.
    return ttf.ascent(state, f, wmlayout.gs(state, wmlayout.S_PX_MONO)) as u64
}

fn term_px(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_PX_MONO)
}

// ------------------------------------------------------------- Start

fn init(state: u64, w: u64, h: u64, nodirty: bool, nofocus: bool) -> bool {
    if w == 0 || h == 0 {
        return false
    }
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        wmlayout.wsv(state, i, wmlayout.W_USED, 0)
        wmlayout.wsv(state, i, wmlayout.W_EHEAD, 0)
        wmlayout.wsv(state, i, wmlayout.W_ETAIL, 0)
        wmlayout.wsv(state, i, wmlayout.W_LAYER, wmlayout.L_NORMAL)
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, 0)
        wmlayout.wsv(state, i, wmlayout.W_STRUT, 0)
        wmlayout.wsv(state, i, wmlayout.W_SAVE, 0)
        i = i + 1
    }
    wmlayout.ss(state, wmlayout.S_COUNT, 0)
    wmlayout.ss(state, wmlayout.S_FOCUS, 0)
    wmlayout.ss(state, wmlayout.S_NEXTID, 1)
    wmlayout.ss(state, wmlayout.S_SW, w)
    wmlayout.ss(state, wmlayout.S_SH, h)
    wmlayout.ss(state, wmlayout.S_DRAG, 0)
    wmlayout.ss(state, wmlayout.S_SIZING, 0)
    wmlayout.ss(state, wmlayout.S_CURON, 1)
    wmlayout.ss(state, wmlayout.S_CURX, w / 2)
    wmlayout.ss(state, wmlayout.S_CURY, h / 2)
    wmlayout.ss(state, wmlayout.S_COMPOSITES, 0)
    wmlayout.ss(state, wmlayout.S_BLITS, 0)
    wmlayout.ss(state, wmlayout.S_PIXELS, 0)
    wmlayout.ss(state, wmlayout.S_KEYS, 0)
    wmlayout.ss(state, wmlayout.S_EVDROP, 0)
    wmlayout.ss(state, wmlayout.S_LASTUS, 0)
    wmlayout.ss(state, wmlayout.S_DON, 0)
    wmlayout.ss(state, wmlayout.S_CLOCK, 0)
    wmlayout.ss(state, wmlayout.S_RLOCK, 0)
    wmlayout.ss(state, wmlayout.S_RBAD, 0)
    region.region_clear(state + kstate.WM_OFF + wmlayout.S_RGN)
    wmlayout.ss(state, wmlayout.S_NODIRTY, 0)
    if nodirty {
        wmlayout.ss(state, wmlayout.S_NODIRTY, 1)
    }
    wmlayout.ss(state, wmlayout.S_NOFOCUS, 0)
    if nofocus {
        wmlayout.ss(state, wmlayout.S_NOFOCUS, 1)
    }
    wmlayout.ss(state, wmlayout.S_HIDES, 0)
    wmlayout.ss(state, wmlayout.S_SHOWS, 0)
    // ADDENDUM TASKBAR: before the first strut the work area IS the
    // screen. `recalc_work` reads S_SW and S_SH, so it has to run after
    // both are set -- they are, twelve lines above this one.
    wmlayout.ss(state, wmlayout.S_NOSTRUT, 0)
    wmlayout.ss(state, wmlayout.S_STRUTS, 0)
    wmlayout.ss(state, wmlayout.S_WORKCALC, 0)
    recalc_work(state)
    wmlayout.ss(state, wmlayout.S_DESK, wmbase.deco(state, wmlayout.DK_DESK))
    wmlayout.ss(state, wmlayout.S_FONT_UI, ttf.MAX_FONTS)
    wmlayout.ss(state, wmlayout.S_FONT_MONO, ttf.MAX_FONTS)
    wmlayout.ss(state, wmlayout.S_TILE, 0)
    wmlayout.ss(state, wmlayout.S_PVON, 0)
    wmlayout.ss(state, wmlayout.S_DROPN, 0)
    wmlayout.ss(state, wmlayout.S_DROPE, 0)
    wmlayout.ss(state, wmlayout.S_DRAGT, 0)
    wmlayout.ss(state, wmlayout.S_HOTS, 0)
    wmlayout.ss(state, wmlayout.S_ACTS, 0)
    wmlayout.ss(state, wmlayout.S_READY, 1)
    // RUNDE TILING: der Baum bekommt dieselbe Flaeche wie der Schirm.
    // Er ist erst einmal LEER und schaltet nichts um -- ohne das Wort
    // `tile` verhaelt sich der Fensterserver wie vorher.
    tile.init(state, 0, 0, w, h)
    // RUNDE WMPLUGIN: die Plugintafel. Ohne das Wort `wmplug` (und mit
    // `plugaus` erst recht) bleibt sie ZU -- dann weist `plug_call`
    // jede Anmeldung mit E_UNSUPPORTED ab und dieser Fensterserver
    // verhaelt sich Zeile fuer Zeile wie vor der Runde.
    wmplug.init(state)
    if !kstate.mode_on(state, kstate.M_WMPLUG)
        || kstate.mode_on(state, kstate.M_PLUGAUS) {
        wmplug.set_ready(state, false)
    }
    // RUNDE GLAS: der Selbsttest der Mischung und des Weichzeichners.
    // Er steht HIER und nicht in `selftest`, weil der dort mitten in
    // einer Zeile laeuft, die `kgui` schreibt -- siehe `fokus_still`.
    wmglass.glastest_say(state)
    wmglass.damagetest_say(state)
    wmlayout.ss(state, wmlayout.S_GLASSGEN, 1)
    wmlayout.ss(state, wmlayout.S_GLVALID, 0)
    wmlayout.ss(state, wmlayout.S_PANELGROW, 0)
    wmlayout.ss(state, wmlayout.S_GLHIT, 0)
    wmlayout.ss(state, wmlayout.S_GLRUN, 0)
    wmlayout.ss(state, wmlayout.S_GLUS, 0)
    wmlayout.ss(state, wmlayout.S_GLN, 0)
    wmlayout.ss(state, wmlayout.S_GLMAX, 0)
    wmlayout.ss(state, wmlayout.S_GLLAST, 0)
    wmlayout.ss(state, wmlayout.S_GLSAY, 0)
    wmglass.set_noglasgrow(state, fb.glasgrow_aus(state))
    // Die Gegenprobe meldet sich von selbst: ein Lauf, in dem die Regel
    // abgeschaltet ist, muss das in seiner eigenen Ausgabe sagen und
    // nicht nur auf der Befehlszeile.
    if wmlayout.gs(state, wmlayout.S_NOGROW) != 0 {
        wmbase.schlieren_say(state)
    }
    wmbase.damage_all(state)
    return true
}

fn rgn_add(state: u64, a: i64, b: i64, c: i64, d: i64) {
    if !wmbase.rgn_lock(state) {
        wmlayout.ss(state, wmlayout.S_RBAD, 1)
        return
    }
    region.region_add(state + kstate.WM_OFF + wmlayout.S_RGN, a, b, c, d)
    wmbase.rgn_unlock(state)
}

// Take the region out for one frame: copy its rectangles to `out` (4 words each) and empty it. Returns the number of rectangles,
// or 0 when the frame should use the box: the region was marked bad, it is empty, it does not agree with the box (a racing
// `damage`), it has one rectangle, or it covers more than three quarters of the box (cutting costs more than it saves).
fn rgn_take(state: u64, out: u64, bx0: u64, by0: u64, bx1: u64, by1: u64) -> u64 {
    if !wmbase.rgn_lock(state) {
        return 0
    }
    let off: bool = fb.rgn_aus(state)
    let r: u64 = state + kstate.WM_OFF + wmlayout.S_RGN
    var n: u64 = region.region_count(r)
    let bad: u64 = wmlayout.gs(state, wmlayout.S_RBAD)
    if off || bad != 0 || n < 2 || region.region_bounds(r, 0) != bx0 as i64 || region.region_bounds(r, 1) != by0 as i64
        || region.region_bounds(r, 2) != bx1 as i64 || region.region_bounds(r, 3) != by1 as i64 {
        n = 0
    }
    let box_area: u64 = (bx1 - bx0) * (by1 - by0)
    let area: u64 = region.region_area(r)
    if n != 0 && area * 100 > box_area * 75 {
        n = 0
    }
    if n != 0 {
        var i: u64 = 0
        while i < n {
            var k: u64 = 0
            while k < 4 {
                __mmio_write64((out + (i * 4 + k) * 8) as *mut u64, region.region_rect(r, i, k) as u64)
                k = k + 1
            }
            i = i + 1
        }
        wmlayout.ss(state, wmlayout.S_RSAVED, wmlayout.gs(state, wmlayout.S_RSAVED) + (box_area - area))
        if pixelguard.bug_is(5) && n >= 2 {
            var bk: u64 = 0
            while bk < 4 {
                __mmio_write64((out + (4 + bk) * 8) as *mut u64, __mmio_read64((out + ((n - 1) * 4 + bk) * 8) as *mut u64))
                bk = bk + 1
            }
            n = n - 1
        }
    }
    region.region_clear(r)
    wmlayout.ss(state, wmlayout.S_RBAD, 0)
    wmbase.rgn_unlock(state)
    return n
}

fn dirty_x0(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_DX0)
}

fn dirty_y0(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_DY0)
}

fn dirty_x1(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_DX1)
}

fn dirty_y1(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_DY1)
}

// ------------------------------------------------------ die Fenster

fn create(state: u64, owner: u64, x: i64, y: i64, w: u64, h: u64,
    kind: u64, title: u64) -> u64 {
    return create_ex(state, owner, x, y, w, h, kind, title, 0, 0, 0)
}

// `sbase` != 0: the buffer is the run of frames of shared object `sidx` (`sbytes` long, one reference taken for the window) and not
// a run of the server's own -- the client paints into it and the compositor reads it from there (docs/COMPOSITOR.md S3).
fn create_ex(state: u64, owner: u64, x: i64, y: i64, w: u64, h: u64,
    kind: u64, title: u64, sbase: u64, sbytes: u64, sidx: u64) -> u64 {
    if !wmbase.ready(state) || w < 32 || h < 16 || w > wmgeom.MAX_W_HARD
        || h > wmgeom.MAX_H_HARD {
        return wmbase.MAX_WIN
    }
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmlayout.wg(state, i, wmlayout.W_USED) == 0 {
            let bytes: u64 = w * h * 4
            var rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
            var buf: u64 = 0
            var kshm: u64 = 0
            if sbase != 0 {
                if sbytes < bytes || kind == wmlayout.K_TERM {
                    return wmbase.MAX_WIN
                }
                buf = sbase
                rahmen = sbytes / mem.FRAME_SIZE
            } else {
                // COMPOSITOR r486 (terminal): the grid is painted by the kernel into the window's buffer; the buffer is a shared object the
                // kernel made itself, so the compositor in ring 3 can map it read-only (WM_BUFFD) and judge the terminal as a plain window.
                // The word `noshare` (or no object / no contiguous run to be had) leaves the old private run of frames.
                if kind == wmlayout.K_TERM {
                    kshm = kern_shared(state, bytes)
                    if kshm != 0 {
                        buf = unixsock.shm_frame(state, kshm - 1, 0)
                        rahmen = unixsock.shm_pages(state, kshm - 1)
                    }
                }
                if buf == 0 {
                    buf = mem.frame_run(state, rahmen)
                }
            }
            if buf == 0 {
                return wmbase.MAX_WIN
            }
            wmlayout.wsv(state, i, wmlayout.W_USED, 1)
            wmlayout.wsv(state, i, wmlayout.W_ANK, 0)
            wmlayout.wsv(state, i, wmlayout.W_ANMS, 0)
            wmlayout.wsv(state, i, wmlayout.W_ID, wmlayout.gs(state, wmlayout.S_NEXTID))
            wmlayout.ss(state, wmlayout.S_NEXTID, wmlayout.gs(state, wmlayout.S_NEXTID) + 1)
            wmlayout.wsv(state, i, wmlayout.W_OWNER, owner)
            // ==================================== RUNDE BLECHDREI
            // EIN FENSTER FAENGT UNTER DER ARBEITSFLAECHE AN.
            //
            // Der Schreibtisch legt sein Terminalfenster auf feste
            // Koordinaten (x=24, y=40). Mit dem reservierten Band der
            // Messtafel lag es damit VOLLSTAENDIG darunter und wurde von
            // `fb` weggeschnitten -- ein Fenster, das es gibt, das man
            // aber nicht sieht. Ein Strut, den nur die Maximierung
            // beachtet, ist keiner.
            //
            // Nur nach UNTEN geschoben, nie verkleinert, und nur wenn es
            // ein Band gibt: bei `nostrut` und auf schmalen Schirmen ist
            // `work_y` null und diese Zeilen tun nichts. Deshalb sehen
            // die Laeufe in tools/wm/run.sh dieselben Koordinaten wie
            // vorher.
            var wy: i64 = y
            let oben: i64 = wmlayout.gs(state, wmlayout.S_WORK_Y) as i64
            if wy < oben {
                wy = oben
            }
            wmlayout.wsv(state, i, wmlayout.W_X, x as u64)
            wmlayout.wsv(state, i, wmlayout.W_Y, wy as u64)
            wmlayout.wsv(state, i, wmlayout.W_W, w)
            wmlayout.wsv(state, i, wmlayout.W_H, h)
            wmlayout.wsv(state, i, wmlayout.W_BUF, buf)
            wmlayout.wsv(state, i, wmlayout.W_BUFBYTES, rahmen * mem.FRAME_SIZE)
            wmlayout.wsv(state, i, wmlayout.W_SHM, 0)
            wmlayout.wsv(state, i, wmlayout.W_CURSOR, 0)
            wmlayout.wsv(state, i, wmlayout.W_BL_MEAN, 0)
            wmlayout.wsv(state, i, wmlayout.W_BL_RUNS, 0)
            wmlayout.wsv(state, i, wmlayout.W_BL_HITS, 0)
            if sbase != 0 {
                unixsock.shm_ref(state, sidx)
                wmlayout.wsv(state, i, wmlayout.W_SHM, sidx + 1)
                wmlayout.ss(state, wmlayout.S_SH_ATT, wmlayout.gs(state, wmlayout.S_SH_ATT) + 1)
            } else if kshm != 0 {
                // the object's first reference is the window's own (no client holds one)
                wmlayout.wsv(state, i, wmlayout.W_SHM, kshm)
                wmlayout.ss(state, wmlayout.S_TM_SH, wmlayout.gs(state, wmlayout.S_TM_SH) + 1)
            }
            wmlayout.wsv(state, i, wmlayout.W_KIND, kind)
            wmlayout.wsv(state, i, wmlayout.W_EHEAD, 0)
            wmlayout.wsv(state, i, wmlayout.W_ETAIL, 0)
            wmlayout.wsv(state, i, wmlayout.W_FG, wmbase.deco(state, wmlayout.DK_TERM_FG))
            wmlayout.wsv(state, i, wmlayout.W_BG, wmbase.deco(state, wmlayout.DK_TERM_BG))
            wmlayout.wsv(state, i, wmlayout.W_GRID, 0)
            wmlayout.wsv(state, i, wmlayout.W_KEYS, 0)
            wmlayout.wsv(state, i, wmlayout.W_LAYER, wmlayout.L_NORMAL)
            wmlayout.wsv(state, i, wmlayout.W_FLAGS, 0)
            wmlayout.wsv(state, i, wmlayout.W_STRUT, 0)
            wmlayout.wsv(state, i, wmlayout.W_SAVE, 0)
            // RUNDE PAINT: ein wiederverwendeter Platz erbt sonst den
            // Buendelnamen des VORIGEN Fensters -- und damit sein
            // Symbol. Genau die Sorte Fehler, die man erst sieht, wenn
            // das sechzehnte Fenster aufgeht.
            let _cl: bool = set_app(state, i, 0)
            // ====================================== RUNDE ZIEH
            // UND DER NACHZUG DES VORIGEN FENSTERS AUCH NICHT.
            //
            // Derselbe Grund wie beim Buendelnamen eine Zeile
            // darueber: ein wiederverwendeter Platz erbt sonst den
            // Bildversatz des Fensters, das hier vorher lag -- und
            // das neue Fenster erschiene beim ersten Bild um bis zu
            // 48 Bildpunkte verschoben, ohne dass es je jemand
            // gezogen haette. Die Sorte Fehler, die man erst beim
            // sechzehnten Fenster sieht.
            wmlayout.wsv(state, i, wmlayout.W_SWX, 0)
            wmlayout.wsv(state, i, wmlayout.W_SWY, 0)
            wmlayout.wsv(state, i, wmlayout.W_SWOFF, 0)
            // RUNDE BLUR: und die Deckung auch nicht -- ein
            // wiederverwendeter Platz waere sonst durchsichtig, ohne
            // dass es jemand bestellt hat.
            wmlayout.wsv(state, i, wmlayout.W_OPAC, 0)
            wmlayout.wsv(state, i, wmlayout.W_DRAGX, 0)
            wmlayout.wsv(state, i, wmlayout.W_DXLAST, 0)
            wmlayout.wsv(state, i, wmlayout.W_DYLAST, 0)
            wmlayout.wsv(state, i, wmlayout.W_Z, wmlayout.gs(state, wmlayout.S_COUNT))
            wmlayout.ss(state, wmlayout.S_COUNT, wmlayout.gs(state, wmlayout.S_COUNT) + 1)
            // RUNDE DESKTOP: ein neues Fenster kommt an die Oberkante
            // SEINER Ebene und nicht an die Oberkante von allem. Solange
            // es keine Taskleiste gibt, ist das dasselbe; sobald es eine
            // gibt, ist es der Unterschied zwischen einer Leiste und
            // einem Fenster, das sie verdeckt.
            raise_win(state, i)
            set_title(state, i, title)
            wmdraw.fill(state, i, 0, 0, w, h, wmlayout.wg(state, i, wmlayout.W_BG))
            if kind == wmlayout.K_TERM {
                term_setup(state, i)
            }
            set_focus(state, i)
            wmdamage.damage_win(state, i)
            if wmlayout.gs(state, wmlayout.S_TILE) != 0 {
                save_geom(state, i)
                tile_take(state, i)
            }
            // RUNDE WMPLUGIN: ABLEGEN UND WEITERGEHEN. `notify` schreibt
            // in hoechstens acht Ringe und kehrt zurueck -- hier wird
            // auf kein Ring-3-Programm gewartet, auch nicht kurz.
            wmplug.notify(state, wmplug.E_WIN_OPEN, wmlayout.wg(state, i, wmlayout.W_ID),
                wmlayout.wg(state, i, wmlayout.W_LAYER), 0)
            return i
        }
        i = i + 1
    }
    return wmbase.MAX_WIN
}

// RUNDE PAINT: der Buendelname des Fensters. Wie `set_title`
// abgeschnitten statt abgelehnt -- ein zu langer Name ist kein Grund,
// ein Fenster zu verweigern -- und immer nullterminiert.
fn set_app(state: u64, i: u64, p: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    var k: u64 = 0
    while k < APP_LEN - 1 {
        var c: u64 = 0
        if p != 0 {
            c = kstate.get8(p + k)
        }
        kstate.set8(state + wmlayout.wat(i) + wmlayout.W_APP + k, c as u8)
        if c == 0 {
            k = APP_LEN - 1
        } else {
            k = k + 1
        }
    }
    kstate.set8(state + wmlayout.wat(i) + wmlayout.W_APP + APP_LEN - 1, 0 as u8)
    return true
}

fn win_app(state: u64, i: u64) -> u64 {
    if i >= wmbase.MAX_WIN {
        return 0
    }
    return state + wmlayout.wat(i) + wmlayout.W_APP
}

fn set_title(state: u64, i: u64, p: u64) {
    var k: u64 = 0
    while k < 31 {
        var c: u64 = 0
        if p != 0 {
            c = kstate.get8(p + k)
        }
        kstate.set8(state + wmlayout.wat(i) + wmlayout.W_TITLE + k, c as u8)
        if c == 0 {
            k = 31
        } else {
            k = k + 1
        }
    }
    kstate.set8(state + wmlayout.wat(i) + wmlayout.W_TITLE + 31, 0 as u8)
}

fn destroy(state: u64, i: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    frameprof.reset(i)
    tt_forget(state, i)
    tile_release(state, i)
    wmdamage.damage_win(state, i)
    wmplug.notify(state, wmplug.E_WIN_CLOSE, wmlayout.wg(state, i, wmlayout.W_ID), 0, 0)
    // Stirbt der Prozess EINES PLUGINS, faellt sein Fenster hier durch.
    // Der Platz in der Plugintafel haengt aber am Prozess und nicht am
    // Fenster -- aufgeraeumt wird er von `wmplug.sweep` und vom
    // Prozessende in `sysgui.fi`.
    let z: u64 = wmlayout.wg(state, i, wmlayout.W_Z)
    // ADDENDUM TASKBAR: a window that reserved a screen edge gives the
    // edge back when it dies. Without this the work area would stay
    // small after the taskbar exits, and every window maximized after
    // that would leave a strip of empty desktop.
    let hatte_strut: bool = wmlayout.wg(state, i, wmlayout.W_STRUT) != 0
    wmlayout.wsv(state, i, wmlayout.W_STRUT, 0)
    wmlayout.wsv(state, i, wmlayout.W_USED, 0)
    wmlayout.wsv(state, i, wmlayout.W_ANK, 0)
    wmlayout.wsv(state, i, wmlayout.W_ANMS, 0)
    if wmlayout.wg(state, i, wmlayout.W_BUF) != 0 {
        if wmlayout.wg(state, i, wmlayout.W_SHM) != 0 {
            // a shared buffer belongs to its object: the window gives back its reference, the client's mapping keeps the frames until it lets go
            unixsock.shm_unref(state, wmlayout.wg(state, i, wmlayout.W_SHM) - 1)
            wmlayout.wsv(state, i, wmlayout.W_SHM, 0)
        } else {
            mem.frame_free_run(state, wmlayout.wg(state, i, wmlayout.W_BUF),
                wmlayout.wg(state, i, wmlayout.W_BUFBYTES) / mem.FRAME_SIZE)
        }
        wmlayout.wsv(state, i, wmlayout.W_BUF, 0)
    }
    if wmlayout.wg(state, i, wmlayout.W_GRID) != 0 {
        mem.frame_free_run(state, wmlayout.wg(state, i, wmlayout.W_GRID), TG_FRAMES)
        wmlayout.wsv(state, i, wmlayout.W_GRID, 0)
    }
    sb_free(state, i)
    // Die Stapelreihenfolge schliesst sich: wer ueber dem geschlossenen
    // Fenster lag, rutscht eine Stufe herunter. Ohne das entstehen
    // Luecken, und `compose` findet auf einer Stufe kein Fenster mehr.
    var k: u64 = 0
    while k < wmbase.MAX_WIN {
        if wmlayout.wg(state, k, wmlayout.W_USED) != 0 && wmlayout.wg(state, k, wmlayout.W_Z) > z {
            wmlayout.wsv(state, k, wmlayout.W_Z, wmlayout.wg(state, k, wmlayout.W_Z) - 1)
        }
        k = k + 1
    }
    wmlayout.ss(state, wmlayout.S_COUNT, wmlayout.gs(state, wmlayout.S_COUNT) - 1)
    if wmbase.focus(state) == i {
        wmlayout.ss(state, wmlayout.S_FOCUS, 0)
        // Der Fokus geht an das oberste verbliebene SICHTBARE Fenster
        // der normalen Ebene -- nicht an den Schreibtisch und nicht an
        // die Taskleiste.
        let o: u64 = top_visible(state)
        if o < wmbase.MAX_WIN {
            set_focus(state, o)
        }
    }
    if wmlayout.gs(state, wmlayout.S_DRAG) == i + 1 {
        wmlayout.ss(state, wmlayout.S_DRAG, 0)
    }
    if wmlayout.gs(state, wmlayout.S_SIZING) == i + 1 {
        wmlayout.ss(state, wmlayout.S_SIZING, 0)
    }
    // ==================================== RUNDE BLECHFUENF
    // WAS SONST NOCH AUF DIESES FENSTER ZEIGT.
    //
    // Justin klickt auf das Kreuz, und danach ist die Maschine weg.
    // `S_DRAG` und `S_SIZING` waren gedacht, `S_CAPHOV` nicht -- und
    // GENAU DAS ist der Zustand nach einem Klick auf das Kreuz: der
    // Zeiger stand ueber dem Knopf, also stand dort die Nummer dieses
    // Fensters, und der naechste `cap_track` faerbt eine Schaltflaeche
    // an einem Fenster, das es nicht mehr gibt. Wird der Platz danach
    // neu vergeben, faerbt er die des NEUEN.
    if wmlayout.gs(state, wmlayout.S_CAPHOV) != 0 && (wmlayout.gs(state, wmlayout.S_CAPHOV) - 1) / 4 == i {
        wmlayout.ss(state, wmlayout.S_CAPHOV, 0)
    }
    // UND DIE MASSE AUF NULL. `destroy` hat den Puffer freigegeben und
    // W_BUF genullt, die BREITE und HOEHE aber stehen gelassen. Ein
    // Weg, der die Gueltigkeit nicht prueft, rechnet damit ein
    // plausibles Rechteck aus und schreibt es an die Anschrift null --
    // also mitten in die Seitentafeln des Kerns. Mit Nullen kommt er
    // ueber die erste Schleifenbedingung nicht hinaus.
    wmlayout.wsv(state, i, wmlayout.W_W, 0)
    wmlayout.wsv(state, i, wmlayout.W_H, 0)
    wmlayout.wsv(state, i, wmlayout.W_COLS, 0)
    wmlayout.wsv(state, i, wmlayout.W_ROWS, 0)
    wmlayout.wsv(state, i, wmlayout.W_CX, 0)
    wmlayout.wsv(state, i, wmlayout.W_CY, 0)
    wmlayout.wsv(state, i, wmlayout.W_KIND, 0)
    wmlayout.wsv(state, i, wmlayout.W_CURSOR, 0)
    wmlayout.wsv(state, i, wmlayout.W_BL_MEAN, 0)
    wmlayout.wsv(state, i, wmlayout.W_BL_RUNS, 0)
    wmlayout.wsv(state, i, wmlayout.W_BL_HITS, 0)
    wmlayout.wsv(state, i, wmlayout.W_EHEAD, 0)
    wmlayout.wsv(state, i, wmlayout.W_ETAIL, 0)
    if hatte_strut {
        recalc_work(state)
    }
    return true
}

// ============================================ RUNDE BLECHFUENF
// DAS OBERSTE FENSTER ZUMACHEN -- GENAU SO WIE DAS KREUZ.
//
// Kein zweiter Weg neben `on_mouse`, sondern DIESELBEN ZWEI ZEILEN:
// erst das Ereignis in den Ring des Fensters, dann `destroy`. Waere es
// ein anderer Weg, waere die Gegenprobe wertlos.
// DIE MITTE DES SCHLIESSKREUZES eines Fensters, gepackt (x << 32) | y.
// Damit kann die Gegenprobe wirklich DORTHIN klicken, wo Justin
// geklickt hat -- und nicht einen zweiten Schliessweg neben dem Kreuz
// benutzen, der die Haelfte der Arbeit auslaesst.
fn cross_point(state: u64, i: u64) -> u64 {
    if !wmbase.valid(state, i) {
        return 0
    }
    let bx: i64 = cap_x0(state, i) + (wmlayout.CAP_CLOSE * wmgeom.cap_w(state)) as i64
        + (wmgeom.cap_w(state) / 2) as i64
    let by: i64 = wmbase.win_y(state, i) + wmgeom.border(state) as i64
        + ((wmgeom.title_h(state) - 1 - wmgeom.border(state)) / 2) as i64
    if bx < 0 || by < 0 {
        return 0
    }
    return ((bx as u64) << 32) | (by as u64)
}

fn term_win(state: u64) -> u64 {
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmlayout.wg(state, i, wmlayout.W_USED) != 0 && wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM {
            return i
        }
        i = i + 1
    }
    return wmbase.MAX_WIN
}

// Schliessen ueber die Bewegung. Das Fenster verschwindet erst, wenn
// sie durch ist -- `anim_tick` ruft dann `destroy`. Ohne Bewegung
// geschieht genau das sofort.
fn close_anim(state: u64, i: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    ev_push(state, i, wmlayout.E_CLOSE, 0, 0, 0)
    if !wmanim.anim_start(state, i, wmanim.AN_CLOSE) {
        destroy(state, i)
        return false
    }
    return true
}

// Minimieren ueber die Bewegung. Dasselbe Bild wie beim Schliessen,
// aber am Ende steht `set_hidden` und nicht `destroy`.
fn minimize_anim(state: u64, i: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    if !wmanim.anim_start(state, i, wmanim.AN_MIN) {
        set_hidden(state, i, true)
        return false
    }
    return true
}

fn close_top(state: u64) -> u64 {
    let i: u64 = top_visible(state)
    if i >= wmbase.MAX_WIN {
        return wmbase.MAX_WIN
    }
    ev_push(state, i, wmlayout.E_CLOSE, 0, 0, 0)
    destroy(state, i)
    return i
}

// DAS TERMINALFENSTER. Justins Foto zeigt "Terminal -- sh" mit dem
// Kreuz, auf das er geklickt hat -- also ist DAS das Fenster, das die
// Gegenprobe zuerst zumachen muss und nicht irgendeines.
fn close_term(state: u64) -> u64 {
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmlayout.wg(state, i, wmlayout.W_USED) != 0 && wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM {
            ev_push(state, i, wmlayout.E_CLOSE, 0, 0, 0)
            destroy(state, i)
            return i
        }
        i = i + 1
    }
    return wmbase.MAX_WIN
}

fn topmost(state: u64) -> u64 {
    var beste: u64 = wmbase.MAX_WIN
    var bz: u64 = 0
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmlayout.wg(state, i, wmlayout.W_USED) != 0 {
            if beste == wmbase.MAX_WIN || wmlayout.wg(state, i, wmlayout.W_Z) >= bz {
                beste = i
                bz = wmlayout.wg(state, i, wmlayout.W_Z)
            }
        }
        i = i + 1
    }
    return beste
}

// DAS OBERSTE SICHTBARE FENSTER DER NORMALEN EBENE. Es ist das, an das
// der Fokus faellt, wenn eines geschlossen oder minimiert wird -- und
// es ist ausdruecklich NICHT der Schreibtisch und NICHT die
// Taskleiste. Beide nehmen die Tastatur nicht an; wer in einer
// Taskleiste tippt, hat kein Fenster mehr, in dem der Text landet.
fn top_visible(state: u64) -> u64 {
    var beste: u64 = wmbase.MAX_WIN
    var bz: u64 = 0
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmlayout.wg(state, i, wmlayout.W_USED) != 0 && wmlayout.wg(state, i, wmlayout.W_LAYER) == wmlayout.L_NORMAL {
            if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) == 0 {
                if beste == wmbase.MAX_WIN || wmlayout.wg(state, i, wmlayout.W_Z) >= bz {
                    beste = i
                    bz = wmlayout.wg(state, i, wmlayout.W_Z)
                }
            }
        }
        i = i + 1
    }
    return beste
}

// AUF WELCHE STUFE GEHOERT EIN FENSTER DER EBENE `l` GANZ OBEN. Gezaehlt
// werden alle belegten Fenster mit kleinerer ODER GLEICHER Ebene --
// einschliesslich des Fensters selbst, wenn es schon belegt ist. Die
// gesuchte Stufe ist eine weniger.
fn zslot(state: u64, l: u64) -> u64 {
    var n: u64 = 0
    var k: u64 = 0
    while k < wmbase.MAX_WIN {
        if wmlayout.wg(state, k, wmlayout.W_USED) != 0 && layer_rank(wmlayout.wg(state, k, wmlayout.W_LAYER)) <= layer_rank(l) {
            n = n + 1
        }
        k = k + 1
    }
    return n
}

// EIN FENSTER AUF EINE ANDERE STUFE, in beide Richtungen. Runde K10
// hatte nur `raise_win`, und das konnte nur nach oben: es zog alles
// ueber dem Fenster eine Stufe herunter und setzte es an die Spitze.
// Mit Ebenen muss ein Fenster auch SINKEN koennen (ein Schreibtisch,
// der als letztes entsteht, gehoert nach ganz hinten), und das ist die
// andere Haelfte derselben Verschiebung.
fn move_to_z(state: u64, i: u64, ziel: u64) {
    let z: u64 = wmlayout.wg(state, i, wmlayout.W_Z)
    if ziel == z || ziel >= wmlayout.gs(state, wmlayout.S_COUNT) {
        return
    }
    var k: u64 = 0
    while k < wmbase.MAX_WIN {
        if wmlayout.wg(state, k, wmlayout.W_USED) != 0 && k != i {
            let kz: u64 = wmlayout.wg(state, k, wmlayout.W_Z)
            if z < ziel {
                if kz > z && kz <= ziel {
                    wmlayout.wsv(state, k, wmlayout.W_Z, kz - 1)
                }
            } else {
                if kz >= ziel && kz < z {
                    wmlayout.wsv(state, k, wmlayout.W_Z, kz + 1)
                }
            }
        }
        k = k + 1
    }
    wmlayout.wsv(state, i, wmlayout.W_Z, ziel)
    wmdamage.damage_win(state, i)
}

// HEBEN HEISST SEIT DER RUNDE DESKTOP: an die Oberkante SEINER EBENE.
// Mit `nolayer` ist es wieder die Oberkante von allem -- und genau
// dann verdeckt der Schreibtisch beim ersten Klick den ganzen
// Bildschirm. Das ist die Gegenprobe, und sie ist eine Zeile.
fn raise_win(state: u64, i: u64) {
    if !wmbase.valid(state, i) {
        return
    }
    var ziel: u64 = wmlayout.gs(state, wmlayout.S_COUNT) - 1
    if wmlayout.gs(state, wmlayout.S_NOLAYER) == 0 {
        ziel = zslot(state, wmlayout.wg(state, i, wmlayout.W_LAYER)) - 1
    }
    move_to_z(state, i, ziel)
}

// DIE EBENE EINES FENSTERS SETZEN. Danach wandert es sofort an die
// Oberkante der neuen Ebene -- ein Schreibtisch, der seine Ebene
// bekommt und liegen bleibt, wo er war, waere kein Schreibtisch.
static mut layer_guard: u64 = 0

fn set_layer(state: u64, i: u64, l: u64) {
    if !wmbase.valid(state, i) || l > wmlayout.L_MAX {
        return
    }
    if wmlayout.wg(state, i, wmlayout.W_LAYER) == l {
        return
    }
    wmlayout.wsv(state, i, wmlayout.W_LAYER, l)
    if l != wmlayout.L_NORMAL && l != wmlayout.L_FULL && l != wmlayout.L_FLOAT && wmlayout.wg(state, i, wmlayout.W_NODE) != 0 {
        tile_release(state, i)
        restore_geom(state, i)
    }
    layer_guard = i + 1
    // Ein Fenster, das aus der normalen Ebene verschwindet, darf den
    // Eingabefokus nicht mitnehmen.
    //
    // RUNDE VOLLBILD: AUSSER ES IST DAS VOLLBILD. Ein Vollbildfenster
    // liegt auf L_FULL und ist trotzdem das Fenster, in dem der Mensch
    // arbeitet -- naehme man ihm hier den Fokus, ginge das zweite F11
    // ins Leere und der Schirm waere gesperrt. Genau der Fall, den
    // Justin als "sonst ist der Schirm gesperrt" benannt hat.
    if l != wmlayout.L_NORMAL && l != wmlayout.L_FULL && wmbase.focus(state) == i
        && (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_KEYS) == 0 {
        wmlayout.ss(state, wmlayout.S_FOCUS, 0)
        // RUNDE ECHTHARDWARE-4: ZURUECK ZU DEM, DER IHN HATTE.
        // Der Grund steht bei S_FOCUS_PREV. `top_visible` bleibt der
        // zweite Weg -- fuer den Fall, dass der Vorbesitzer inzwischen
        // weg oder verborgen ist.
        let before: u64 = wmlayout.gs(state, wmlayout.S_FOCUS_PREV)
        if before != 0 && before - 1 != i && wmbase.valid(state, before - 1)
            && (wmlayout.wg(state, before - 1, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) == 0 {
            set_focus(state, before - 1)
        } else {
            let o: u64 = top_visible(state)
            if o < wmbase.MAX_WIN {
                set_focus(state, o)
            }
        }
    }
    layer_guard = 0
    raise_win(state, i)
    wmbase.damage_all(state)
}

// MINIMIEREN UND WIEDERHERSTELLEN. Ein verborgenes Fenster wird nicht
// zusammengesetzt und nimmt keinen Klick an -- es LEBT aber weiter, sein
// Puffer bleibt liegen, seine Ereignisse laufen weiter auf. Das ist der
// ganze Unterschied zu `destroy`, und er ist der Grund, warum ein
// Leistenknopf ein Fenster zurueckholen kann.
//
// `nomin` ist die Gegenprobe und tut hier NICHTS -- und deshalb bleibt
// das Fenster dann stehen, obwohl der Knopf gedrueckt wurde.
fn set_hidden(state: u64, i: u64, h: bool) {
    if !wmbase.valid(state, i) {
        return
    }
    if wmlayout.gs(state, wmlayout.S_NOMIN) != 0 {
        return
    }
    let f: u64 = wmlayout.wg(state, i, wmlayout.W_FLAGS)
    if h {
        if (f & wmlayout.F_HIDDEN) != 0 {
            return
        }
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, f | wmlayout.F_HIDDEN)
        // RUNDE OBERFLAECHE: EINE LAUFENDE BEWEGUNG ENDET HIER.
        //
        // Das Startmenue legt sein Fenster an und verbirgt es sofort
        // wieder. Mit der Oeffnungsbewegung aus WM_CREATE lief danach
        // eine Bewegung auf einem Fenster, das niemand sieht -- und
        // beim naechsten Aufklappen stand `W_ANK` noch, also malte
        // `paint_win_anim` das Menue geschrumpft und durchscheinend
        // statt fertig. Gemessen als `fl=19` dort, wo `fl=18` stehen
        // muss (tools/logind, Abschnitt 5).
        //
        // `W_ANP` bleibt auf 1000: wer nicht mehr in Bewegung ist,
        // ist FERTIG und nicht auf halbem Weg.
        wmlayout.wsv(state, i, wmlayout.W_ANK, 0)
        wmlayout.wsv(state, i, wmlayout.W_ANP, 1000)
        // ====================================== RUNDE ZIEH
        // UND DER NACHZUG ENDET HIER EBENSO.
        //
        // Genau dieselbe Lehre, die der Kommentar darueber aus der
        // vorigen Runde zieht: was ein Fenster aus dem Bild nimmt,
        // muss JEDE laufende Bewegung daran beenden -- nicht nur die,
        // die es gestartet hat. Bliebe der Versatz stehen, kaeme das
        // Fenster beim naechsten Zeigen um bis zu 48 Bildpunkte
        // verschoben zurueck, und `swing_tick` wuerde ihn erst ueber
        // mehrere Bilder wieder einfangen.
        wmlayout.wsv(state, i, wmlayout.W_SWX, 0)
        wmlayout.wsv(state, i, wmlayout.W_SWY, 0)
        wmlayout.wsv(state, i, wmlayout.W_SWOFF, 0)
        wmlayout.ss(state, wmlayout.S_HIDES, wmlayout.gs(state, wmlayout.S_HIDES) + 1)
        // ADDENDUM TASKBAR: a window nobody can see reserves nothing.
        if wmlayout.wg(state, i, wmlayout.W_STRUT) != 0 {
            recalc_work(state)
        }
        wmdamage.damage_win(state, i)
        if wmbase.focus(state) == i {
            wmlayout.ss(state, wmlayout.S_FOCUS, 0)
            let o: u64 = top_visible(state)
            if o < wmbase.MAX_WIN {
                set_focus(state, o)
            }
        }
        if wmlayout.gs(state, wmlayout.S_DRAG) == i + 1 {
            wmlayout.ss(state, wmlayout.S_DRAG, 0)
        }
        if wmlayout.gs(state, wmlayout.S_SIZING) == i + 1 {
            wmlayout.ss(state, wmlayout.S_SIZING, 0)
        }
    } else {
        if (f & wmlayout.F_HIDDEN) == 0 {
            return
        }
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, f & ~wmlayout.F_HIDDEN)
        // Und dasselbe beim Zeigen: ein Fenster, das aus der Leiste
        // zurueckkommt, steht sofort ganz da.
        wmlayout.wsv(state, i, wmlayout.W_ANK, 0)
        wmlayout.wsv(state, i, wmlayout.W_ANP, 1000)
        wmlayout.ss(state, wmlayout.S_SHOWS, wmlayout.gs(state, wmlayout.S_SHOWS) + 1)
        if wmlayout.wg(state, i, wmlayout.W_STRUT) != 0 {
            recalc_work(state)
        }
        wmdamage.damage_win(state, i)
    }
}

fn set_deco(state: u64, i: u64, on: bool) {
    if !wmbase.valid(state, i) {
        return
    }
    let f: u64 = wmlayout.wg(state, i, wmlayout.W_FLAGS)
    wmdamage.damage_win(state, i) // das ALTE Rechteck, samt Rahmen
    if on {
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, f & ~wmlayout.F_NODECO)
    } else {
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, f | wmlayout.F_NODECO)
    }
    wmdamage.damage_win(state, i) // und das neue, ohne
}

fn work_x(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_WORK_X)
}

fn work_y(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_WORK_Y)
}

fn work_w(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_WORK_W)
}

fn work_h(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_WORK_H)
}

// ================================================== RUNDE FENSTER
// DIE ARBEITSFLAECHE ALS ZAHLEN -- und daneben der ganze Schirm.
//
// Justins Frage lautet, ob ein maximiertes Fenster die Leiste
// beruehrt. Diese Frage ist nur zu beantworten, wenn beide Rechtecke
// auf der Leitung stehen: die Arbeitsflaeche (wo maximiert enden
// MUSS) und der Schirm (wo Vollbild enden DARF). Die Taskleiste
// meldet ihre Sicht als `taskbar: work` -- diese Zeile ist die des
// Fensterverwalters, und wenn die beiden auseinanderlaufen, ist genau
// das der Fehler.
//
//     wm: work x=0 y=0 w=3440 h=1360  schirm=3440x1440 struts=1
fn work_say(state: u64) {
    var s_h: [u8; 12] = "wm: work x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var s_s: [u8; 10] = "  schirm=\0"
    var s_x2: [u8; 2] = "x\0"
    var s_st: [u8; 9] = " struts=\0"
    serial.puts((&s_h[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_WORK_X))
    serial.puts((&s_y[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_WORK_Y))
    serial.puts((&s_w[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_WORK_W))
    serial.puts((&s_hh[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_WORK_H))
    serial.puts((&s_s[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_SW))
    serial.puts((&s_x2[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_SH))
    serial.puts((&s_st[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_STRUTS))
    serial.nl()
}

fn struts(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_STRUTS)
}

fn workcalcs(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_WORKCALC)
}

fn nostrut(state: u64) -> bool {
    return wmlayout.gs(state, wmlayout.S_NOSTRUT) != 0
}

fn win_strut_edge(state: u64, i: u64) -> u64 {
    if i >= wmbase.MAX_WIN {
        return EDGE_BOTTOM
    }
    let v: u64 = wmlayout.wg(state, i, wmlayout.W_STRUT)
    if v == 0 {
        return EDGE_BOTTOM
    }
    return (v & 0xFF) - 1
}

fn win_strut_size(state: u64, i: u64) -> u64 {
    if i >= wmbase.MAX_WIN {
        return 0
    }
    return wmlayout.wg(state, i, wmlayout.W_STRUT) >> 8
}

// ================================================== r826 WINDOW SERVER PER OUTPUT
// An extended desktop is ONE wide framebuffer; each output (head) shows one rect of it. The head rects live in
// ONE place, the pointer driver's head table (ps2m.set_head), fed by `heads_sync` from the vgpu extend table. With
// fewer than two heads in that table nothing below changes anything: `hd_x/y/w/h` answer with the whole screen,
// `win_head` is 0 and `head_work` is the old work area.
//
// THE RULES. (1) A window's HOME head is the head its outer rect overlaps most (none: the first existing head).
// (2) The work area is per head: a strut counts for a head only if the strut window overlaps that head's rect.
// (3) Maximize, fullscreen and the drag clamp use the home head's rect/work area. (4) The tile tree and the
// `work_*` scalars stay on the primary head. No new WM scalars (the page is full): the work area of a head is
// computed from scratch and returned packed (x, y, w, h as four 16-bit fields).
const HD_MAX: u64 = 8

fn hd_multi(state: u64) -> bool {
    return ps2m.heads(state) >= 2
}

fn hd_present(state: u64, hd: u64) -> bool {
    return hd < HD_MAX && ps2m.head_w(state, hd) != 0
}

// The first head that exists (the primary one); 0 when there is none.
fn hd_primary(state: u64) -> u64 {
    var hd: u64 = 0
    while hd < HD_MAX {
        if ps2m.head_w(state, hd) != 0 {
            return hd
        }
        hd = hd + 1
    }
    return 0
}

// Number of heads that exist (1 on a plain screen).
fn hd_count(state: u64) -> u64 {
    if !hd_multi(state) {
        return 1
    }
    var n: u64 = 0
    var hd: u64 = 0
    while hd < HD_MAX {
        if ps2m.head_w(state, hd) != 0 {
            n = n + 1
        }
        hd = hd + 1
    }
    return n
}

fn hd_x(state: u64, hd: u64) -> u64 {
    if !hd_multi(state) {
        return 0
    }
    return ps2m.head_x(state, hd)
}

fn hd_y(state: u64, hd: u64) -> u64 {
    if !hd_multi(state) {
        return 0
    }
    return ps2m.head_y(state, hd)
}

// r815: suggested UI scale of a head in percent (100..300) from its EDID (vgpu output table); 100 when unknown.
fn hd_scale(state: u64, hd: u64) -> u64 {
    if !hd_multi(state) {
        return vgpu.head_scale(state, 0)
    }
    return vgpu.head_scale(state, hd)
}

fn hd_w(state: u64, hd: u64) -> u64 {
    if !hd_multi(state) {
        return wmlayout.gs(state, wmlayout.S_SW)
    }
    return ps2m.head_w(state, hd)
}

fn hd_h(state: u64, hd: u64) -> u64 {
    if !hd_multi(state) {
        return wmlayout.gs(state, wmlayout.S_SH)
    }
    return ps2m.head_h(state, hd)
}

// Overlap area (px) of head `hd` with the rect [x0,x1) x [y0,y1).
fn hd_overlap(state: u64, hd: u64, x0: i64, y0: i64, x1: i64, y1: i64) -> u64 {
    if !hd_present(state, hd) {
        return 0
    }
    let hx: i64 = ps2m.head_x(state, hd) as i64
    let hy: i64 = ps2m.head_y(state, hd) as i64
    let hx1: i64 = hx + ps2m.head_w(state, hd) as i64
    let hy1: i64 = hy + ps2m.head_h(state, hd) as i64
    var ax: i64 = x0
    if hx > ax {
        ax = hx
    }
    var ay: i64 = y0
    if hy > ay {
        ay = hy
    }
    var bx: i64 = x1
    if hx1 < bx {
        bx = hx1
    }
    var by: i64 = y1
    if hy1 < by {
        by = hy1
    }
    if bx <= ax || by <= ay {
        return 0
    }
    return ((bx - ax) as u64) * ((by - ay) as u64)
}

// The head that shows point (x, y); HD_MAX when none.
fn hd_at(state: u64, x: i64, y: i64) -> u64 {
    var hd: u64 = 0
    while hd < HD_MAX {
        if hd_overlap(state, hd, x, y, x + 1, y + 1) != 0 {
            return hd
        }
        hd = hd + 1
    }
    return HD_MAX
}

// HOME HEAD of a window: the head its outer rect overlaps most; with no overlap at all the primary head.
fn win_head(state: u64, i: u64) -> u64 {
    if !hd_multi(state) || !wmbase.valid(state, i) {
        return 0
    }
    let x0: i64 = wmbase.win_x(state, i)
    let y0: i64 = wmbase.win_y(state, i)
    let x1: i64 = x0 + wmbase.outer_w(state, i) as i64
    let y1: i64 = y0 + wmbase.outer_h(state, i) as i64
    var best: u64 = HD_MAX
    var ba: u64 = 0
    var hd: u64 = 0
    while hd < HD_MAX {
        let a: u64 = hd_overlap(state, hd, x0, y0, x1, y1)
        if a > ba {
            ba = a
            best = hd
        }
        hd = hd + 1
    }
    if best == HD_MAX {
        return hd_primary(state)
    }
    return best
}

fn hw_x(p: u64) -> u64 {
    return (p >> 48) & 0xFFFF
}

fn hw_y(p: u64) -> u64 {
    return (p >> 32) & 0xFFFF
}

fn hw_w(p: u64) -> u64 {
    return (p >> 16) & 0xFFFF
}

fn hw_h(p: u64) -> u64 {
    return p & 0xFFFF
}

// THE WORK AREA OF ONE HEAD, from scratch (see `recalc_work` for why nothing is cached). Packed x|y|w|h, 16 bits each.
// On a plain screen this is exactly the old rectangle; with several heads a strut counts only on the heads its window
// overlaps, and the measuring band only on the head at the desktop origin.
fn head_work(state: u64, hd: u64) -> u64 {
    let multi: bool = hd_multi(state)
    let hx: u64 = hd_x(state, hd)
    let hy: u64 = hd_y(state, hd)
    let hw: u64 = hd_w(state, hd)
    let hh: u64 = hd_h(state, hd)
    var x0: u64 = hx
    var y0: u64 = hy
    var x1: u64 = hx + hw
    var y1: u64 = hy + hh
    if wmlayout.gs(state, wmlayout.S_NOSTRUT) == 0 {
        if hx == 0 && hy == 0 {
            let band: u64 = fb.band(state)
            if band > y0 {
                y0 = band
            }
        }
        var i: u64 = 0
        while i < wmbase.MAX_WIN {
            if wmlayout.wg(state, i, wmlayout.W_USED) != 0 && wmlayout.wg(state, i, wmlayout.W_STRUT) != 0
                && (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) == 0 {
                var on: bool = true
                if multi {
                    let sx: i64 = wmbase.win_x(state, i)
                    let sy: i64 = wmbase.win_y(state, i)
                    on = hd_overlap(state, hd, sx, sy, sx + wmbase.outer_w(state, i) as i64,
                        sy + wmbase.outer_h(state, i) as i64) != 0
                }
                if on {
                    let e: u64 = (wmlayout.wg(state, i, wmlayout.W_STRUT) & 0xFF) - 1
                    let n: u64 = wmlayout.wg(state, i, wmlayout.W_STRUT) >> 8
                    if e == EDGE_TOP {
                        if hy + n > y0 {
                            y0 = hy + n
                        }
                    } else if e == EDGE_BOTTOM {
                        if n < hh && hy + hh - n < y1 {
                            y1 = hy + hh - n
                        }
                    } else if e == EDGE_LEFT {
                        if hx + n > x0 {
                            x0 = hx + n
                        }
                    } else {
                        if n < hw && hx + hw - n < x1 {
                            x1 = hx + hw - n
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    // a strut that eats the head is refused, same rule as the plain work area
    if x1 < x0 + 64 || y1 < y0 + 64 {
        x0 = hx
        y0 = hy
        x1 = hx + hw
        y1 = hy + hh
    }
    return ((x0 & 0xFFFF) << 48) | ((y0 & 0xFFFF) << 32) | (((x1 - x0) & 0xFFFF) << 16) | ((y1 - y0) & 0xFFFF)
}

// The work area a window is maximized to: that of its home head (the primary work area on a plain screen).
fn win_work(state: u64, i: u64) -> u64 {
    if !hd_multi(state) {
        return ((wmlayout.gs(state, wmlayout.S_WORK_X) & 0xFFFF) << 48) | ((wmlayout.gs(state, wmlayout.S_WORK_Y) & 0xFFFF) << 32)
            | ((wmlayout.gs(state, wmlayout.S_WORK_W) & 0xFFFF) << 16) | (wmlayout.gs(state, wmlayout.S_WORK_H) & 0xFFFF)
    }
    return head_work(state, win_head(state, i))
}


// r826: show one head line on the serial port (the gate parses these): `wm: head N rect=X,Y WxH work=X,Y WxH`.
fn hd_say(state: u64, hd: u64) {
    var s_h: [u8; 10] = "wm: head \0"
    var s_r: [u8; 7] = " rect=\0"
    var s_c: [u8; 2] = ",\0"
    var s_x: [u8; 2] = "x\0"
    var s_w: [u8; 7] = " work=\0"
    var s_s: [u8; 2] = " \0"
    let p: u64 = head_work(state, hd)
    serial.puts((&s_h[0]) as u64)
    serial.dec(hd)
    serial.puts((&s_r[0]) as u64)
    serial.dec(hd_x(state, hd))
    serial.puts((&s_c[0]) as u64)
    serial.dec(hd_y(state, hd))
    serial.puts((&s_s[0]) as u64)
    serial.dec(hd_w(state, hd))
    serial.puts((&s_x[0]) as u64)
    serial.dec(hd_h(state, hd))
    serial.puts((&s_w[0]) as u64)
    serial.dec(hw_x(p))
    serial.puts((&s_c[0]) as u64)
    serial.dec(hw_y(p))
    serial.puts((&s_s[0]) as u64)
    serial.dec(hw_w(p))
    serial.puts((&s_x[0]) as u64)
    serial.dec(hw_h(p))
    serial.nl()
}

// r815: "wm: hscale N=P" -- the EDID scale suggestion (percent) of head N next to the UI scale the desktop really uses.
fn hd_say_scale(state: u64, hd: u64) {
    var s_h: [u8; 12] = "wm: hscale \0"
    var s_e: [u8; 2] = "=\0"
    var s_u: [u8; 4] = " u=\0"
    serial.puts((&s_h[0]) as u64)
    serial.dec(hd)
    serial.puts((&s_e[0]) as u64)
    serial.dec(hd_scale(state, hd))
    serial.puts((&s_u[0]) as u64)
    serial.dec(fb.uiscale(state))
    serial.nl()
}

// THE HEAD TABLE FOLLOWS THE OUTPUTS. Called after the window server is up and from `gfx.gpu_ereignis` after every
// successful re-layout (hot-plug): copy the extend rects of the vgpu driver into the pointer driver's table, bring
// windows that sit on no head any more to the primary head, keep the others in sight (title bar reachable), refit
// fullscreen windows to their home head, recompute the work areas (this refits maximized windows and the tile
// tree) and put the pointer back onto a head. With extend off the table is empty and the model is off.
fn heads_sync(state: u64) {
    if !wmbase.ready(state) {
        return
    }
    let act: bool = vgpu.ext_active(state)
    var n: u64 = 0
    var hd: u64 = 0
    while hd < HD_MAX {
        var w: u64 = 0
        if act {
            w = vgpu.ext_w(state, hd)
        }
        ps2m.set_head(state, hd, vgpu.ext_x(state, hd), vgpu.ext_y(state, hd), w, vgpu.ext_h(state, hd))
        if w != 0 {
            n = hd + 1
        }
        hd = hd + 1
    }
    if act && n < 2 {
        n = 2
    }
    if !act {
        n = 0
    }
    ps2m.set_heads(state, n)
    if n >= 2 {
        let p0: u64 = head_work(state, hd_primary(state))
        var i: u64 = 0
        while i < wmbase.MAX_WIN {
            let f: u64 = wmlayout.wg(state, i, wmlayout.W_FLAGS)
            if wmlayout.wg(state, i, wmlayout.W_USED) != 0 && (f & wmlayout.F_HIDDEN) == 0 {
                if (f & wmlayout.F_FULL) != 0 {
                    let fh: u64 = win_head(state, i)
                    if resize_win(state, i, hd_w(state, fh), hd_h(state, fh)) {
                        move_win(state, i, hd_x(state, fh) as i64, hd_y(state, fh) as i64)
                    }
                } else if wmbase.deko(state, i) && (f & wmlayout.F_MAXIMIZED) == 0 {
                    var ov: u64 = 0
                    let ox: i64 = wmbase.win_x(state, i)
                    let oy: i64 = wmbase.win_y(state, i)
                    var h2: u64 = 0
                    while h2 < HD_MAX {
                        ov = ov + hd_overlap(state, h2, ox, oy, ox + wmbase.outer_w(state, i) as i64,
                            oy + wmbase.outer_h(state, i) as i64)
                        h2 = h2 + 1
                    }
                    if ov == 0 {
                        move_win(state, i, (hw_x(p0) + 24) as i64, (hw_y(p0) + 24) as i64)
                    }
                    drag_klemmen(state, i)
                }
            }
            i = i + 1
        }
        ps2m.set_pos(state, ps2m.x(state), ps2m.y(state))
    }
    tl_heads_changed(state)
    recalc_work(state)
    wmlayout.ss(state, wmlayout.S_HD_SYNCS, wmlayout.gs(state, wmlayout.S_HD_SYNCS) + 1)
    wmlayout.ss(state, wmlayout.S_HD_GEN, vgpu.hot_gen(state))
    var s_n: [u8; 13] = "wm: heads n=\0"
    var s_p: [u8; 10] = " present=\0"
    var s_g: [u8; 6] = " gen=\0"
    var s_y: [u8; 8] = " syncs=\0"
    serial.puts((&s_n[0]) as u64)
    serial.dec(n)
    serial.puts((&s_p[0]) as u64)
    serial.dec(hd_count(state))
    serial.puts((&s_g[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_HD_GEN))
    serial.puts((&s_y[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_HD_SYNCS))
    serial.nl()
    hd = 0
    while hd < HD_MAX {
        if hd_present(state, hd) {
            hd_say(state, hd)
            hd_say_scale(state, hd)
        }
        hd = hd + 1
    }
}

fn hd_say_mode(state: u64, tag: u64) {
    var s_a: [u8; 5] = "hd: \0"
    var s_m: [u8; 9] = " mirror=\0"
    var s_c: [u8; 12] = " connected=\0"
    var s_p: [u8; 10] = " present=\0"
    let mode: u64 = display_mode(state)
    serial.puts((&s_a[0]) as u64)
    serial.puts(tag)
    serial.puts((&s_m[0]) as u64)
    serial.dec((mode >> 8) & 1)
    serial.puts((&s_c[0]) as u64)
    serial.dec(mode & 255)
    serial.puts((&s_p[0]) as u64)
    serial.dec(hd_count(state))
    serial.nl()
}

fn display_mode(state: u64) -> u64 {
    var mirrored: u64 = 0
    if vgpu.mirror_active(state) {
        mirrored = 1
    }
    return (mirrored << 8) | vgpu.head_count(state)
}

fn set_display_mode(state: u64, mirror: bool) -> bool {
    if !vgpu.set_mirror(state, mirror) {
        return false
    }
    heads_sync(state)
    return true
}

fn head_syncs(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_HD_SYNCS)
}

// One `hd:` line: a window's outer rect.
fn hd_say_win(state: u64, i: u64, tag: u64) {
    var s_a: [u8; 5] = "hd: \0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_h: [u8; 4] = " h=\0"
    var s_k: [u8; 7] = " head=\0"
    var s_f: [u8; 5] = " fl=\0"
    serial.puts((&s_a[0]) as u64)
    serial.puts(tag)
    serial.puts((&s_x[0]) as u64)
    serial.dec(wmbase.win_x(state, i) as u64)
    serial.puts((&s_y[0]) as u64)
    serial.dec(wmbase.win_y(state, i) as u64)
    serial.puts((&s_w[0]) as u64)
    serial.dec(wmbase.outer_w(state, i))
    serial.puts((&s_h[0]) as u64)
    serial.dec(wmbase.outer_h(state, i))
    serial.puts((&s_k[0]) as u64)
    serial.dec(win_head(state, i))
    serial.puts((&s_f[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_FLAGS))
    serial.nl()
}

// TEST BED for `hdtest` / `hdhot` (tools/wmheads): windows and struts on two heads, printed as `hd:` lines.
// Needs an extended desktop (vgpuextend with two heads). With `hot` it also unplugs head 1 and plugs it back.
// r828: edge docking on head 1 (floating halves): right/top/bottom of head 1, a seam edge (no docking), a drop
// in the middle (no docking). Needs the docking switch on; restored afterwards.
// r804 TEST BED for `hwheeltest`: horizontal wheel steps to the window under a point (event type + notches in the
// window ring), a miss over the empty desktop, and 3-finger swipes as window switch. Prints `hw:` lines.
static mut hw_out: [u64; 2] = [0 as u64; 2]

fn hw_drain(state: u64, i: u64) {
    var n: u64 = 0
    while n < 64 && ev_pop(state, i, (&hw_out[0 as usize]) as u64) {
        n = n + 1
    }
}

fn hw_say_ev(state: u64, i: u64, tag: u64) {
    var s_p: [u8; 5] = "hw: \0"
    var s_t: [u8; 7] = " type=\0"
    var s_c: [u8; 4] = " c=\0"
    var s_n: [u8; 7] = " empty\0"
    serial.puts((&s_p[0]) as u64)
    serial.puts(tag)
    if !ev_pop(state, i, (&hw_out[0 as usize]) as u64) {
        serial.puts((&s_n[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_t[0]) as u64)
    serial.dec(hw_out[0 as usize])
    serial.puts((&s_c[0]) as u64)
    serial.hex(hw_out[1 as usize] & 0xFFFF)
    serial.nl()
}

fn hw_say_sw(state: u64, tag: u64, moved: bool, fc: u64, wa: u64, wb: u64) {
    var s_p: [u8; 5] = "hw: \0"
    var s_m: [u8; 8] = " moved=\0"
    var s_f: [u8; 8] = " focus=\0"
    serial.puts((&s_p[0]) as u64)
    serial.puts(tag)
    serial.puts((&s_m[0]) as u64)
    if moved {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_f[0]) as u64)
    if fc == wa {
        serial.put(97 as u8)
    } else if fc == wb {
        serial.put(98 as u8)
    } else {
        serial.put(63 as u8)
    }
    serial.nl()
}

fn hw_demo(state: u64) {
    var t_a: [u8; 5] = "hw-a\0"
    var t_b: [u8; 5] = "hw-b\0"
    var g_r: [u8; 12] = "right2 on-a\0"
    var g_l: [u8; 11] = "left1 on-a\0"
    var g_g: [u8; 11] = "gap no-win\0"
    var g_b: [u8; 12] = "right1 on-b\0"
    var g_a2: [u8; 12] = "on-a after \0"
    var g_s1: [u8; 11] = "swipe left\0"
    var g_s2: [u8; 12] = "swipe right\0"
    var g_s3: [u8; 12] = "swipe 2 fin\0"
    var g_s4: [u8; 9] = "swipe up\0"
    if !wmbase.ready(state) {
        return
    }
    let wa: u64 = create(state, 0, 40, 40, 300, 200, wmlayout.K_RAW, (&t_a[0]) as u64)
    let wb: u64 = create(state, 0, 400, 40, 300, 200, wmlayout.K_RAW, (&t_b[0]) as u64)
    if wa >= wmbase.MAX_WIN || wb >= wmbase.MAX_WIN {
        return
    }
    hw_drain(state, wa)
    hw_drain(state, wb)
    wh_seen = ps2m.wheel(state)
    hwh_seen = ps2m.hwheel(state)
    // two steps right over window a: ONE event, c = 2
    ps2m.hwheel_add(state, 1)
    ps2m.hwheel_add(state, 1)
    hwheel_out(state, 150, 150)
    hw_say_ev(state, wa, (&g_r[0]) as u64)
    // one step left: c = 0xFFFF (-1)
    ps2m.hwheel_add(state, 0 - 1)
    hwheel_out(state, 150, 150)
    hw_say_ev(state, wa, (&g_l[0]) as u64)
    // over the gap between the windows: the sum is taken, nobody gets an event
    ps2m.hwheel_add(state, 1)
    hwheel_out(state, 370, 150)
    hw_say_ev(state, wa, (&g_g[0]) as u64)
    hw_say_ev(state, wb, (&g_g[0]) as u64)
    // over window b: b gets it, a does not
    ps2m.hwheel_add(state, 1)
    hwheel_out(state, 500, 150)
    hw_say_ev(state, wb, (&g_b[0]) as u64)
    hw_say_ev(state, wa, (&g_a2[0]) as u64)
    // swipes: with two windows left = the other window, right = back, 2 fingers and up = nothing
    raise_win(state, wa)
    set_focus(state, wa)
    let m1: bool = swipe_do(state, 1, 3)
    hw_say_sw(state, (&g_s1[0]) as u64, m1, wmbase.focus(state), wa, wb)
    let m2: bool = swipe_do(state, 2, 3)
    hw_say_sw(state, (&g_s2[0]) as u64, m2, wmbase.focus(state), wa, wb)
    let m3: bool = swipe_do(state, 1, 2)
    hw_say_sw(state, (&g_s3[0]) as u64, m3, wmbase.focus(state), wa, wb)
    let m4: bool = swipe_do(state, 3, 3)
    hw_say_sw(state, (&g_s4[0]) as u64, m4, wmbase.focus(state), wa, wb)
}

fn hd_say_tree(state: u64, i: u64, tag: u64) {
    var s_a: [u8; 10] = "hd: tree \0"
    var s_t: [u8; 7] = " tree=\0"
    var s_n: [u8; 8] = " tiled=\0"
    serial.puts((&s_a[0]) as u64)
    serial.puts(tag)
    serial.puts((&s_t[0]) as u64)
    serial.dec(tile_tree_tag(state, i))
    serial.puts((&s_n[0]) as u64)
    if tiled(state, i) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()
}

fn hd_say_drop(state: u64, pos: u64) {
    var s_e: [u8; 11] = "hd: drope=\0"
    var s_p: [u8; 6] = " pos=\0"
    serial.puts((&s_e[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_DROPE))
    serial.puts((&s_p[0]) as u64)
    serial.puts(pos)
    serial.nl()
}

fn hd_say_trees(state: u64, tag: u64) {
    var s_a: [u8; 11] = "hd: trees \0"
    var s_n: [u8; 8] = " nodes=\0"
    var s_l: [u8; 9] = " leaves=\0"
    serial.puts((&s_a[0]) as u64)
    serial.puts(tag)
    serial.puts((&s_n[0]) as u64)
    serial.dec(tile_nodes_all(state))
    serial.puts((&s_l[0]) as u64)
    serial.dec(tile_leaves_all(state))
    serial.nl()
}

// r839: tile tree per head. Tiling is switched on WITHOUT taking the windows that exist (ss, not set_tile_on).
fn hd_demo_tile(state: u64, hot: bool, wa: u64, wb: u64, bar: u64) {
    var t_c1: [u8; 8] = "tile-c1\0"
    var t_c0: [u8; 8] = "tile-c0\0"
    var t_c2: [u8; 8] = "tile-c2\0"
    var t_c1b: [u8; 9] = "split-c1\0"
    var t_c2b: [u8; 9] = "split-c2\0"
    var t_c0t: [u8; 7] = "top-c0\0"
    var t_c1t: [u8; 7] = "top-c1\0"
    var t_c2t: [u8; 7] = "top-c2\0"
    var t_top: [u8; 5] = "top1\0"
    var t_sm: [u8; 5] = "seam\0"
    var t_mid: [u8; 7] = "middle\0"
    var t_off: [u8; 4] = "off\0"
    var t_u0: [u8; 10] = "unplug-c0\0"
    var t_u1: [u8; 10] = "unplug-c1\0"
    var t_u2: [u8; 10] = "unplug-c2\0"
    var t_c3: [u8; 10] = "replug-c3\0"
    var t_n0: [u8; 6] = "start\0"
    var t_n1: [u8; 5] = "full\0"
    var t_n2: [u8; 7] = "unplug\0"
    var t_n3: [u8; 7] = "replug\0"
    var t_n4: [u8; 4] = "end\0"
    var t_f: [u8; 5] = "tile\0"
    if !hd_multi(state) {
        return
    }
    // a clean slate: nothing tiled, no strut, the full head rects are the work areas
    set_tile_on(state, false)
    let _d1: bool = destroy(state, wa)
    let _d2: bool = destroy(state, wb)
    let _d3: bool = destroy(state, bar)
    let h1x: i64 = hd_x(state, 1) as i64
    let hw: i64 = hd_w(state, 1) as i64
    wmlayout.ss(state, wmlayout.S_TILE, 1)
    hd_say_trees(state, (&t_n0[0]) as u64)
    // a new window lands on the head it is on: its own tree, filling that head's work area
    let c1: u64 = create(state, 0, h1x + 60, 60, 300, 200, wmlayout.K_RAW, (&t_f[0]) as u64)
    hd_say_win(state, c1, (&t_c1[0]) as u64)
    hd_say_tree(state, c1, (&t_c1[0]) as u64)
    let c0: u64 = create(state, 0, 60, 60, 300, 200, wmlayout.K_RAW, (&t_f[0]) as u64)
    hd_say_win(state, c0, (&t_c0[0]) as u64)
    hd_say_tree(state, c0, (&t_c0[0]) as u64)
    hd_say_trees(state, (&t_n1[0]) as u64)
    // the second window on head 1 splits ONLY head 1's tree
    let c2: u64 = create(state, 0, h1x + 100, 100, 300, 200, wmlayout.K_RAW, (&t_f[0]) as u64)
    hd_say_win(state, c1, (&t_c1b[0]) as u64)
    hd_say_win(state, c2, (&t_c2b[0]) as u64)
    hd_say_win(state, c0, (&t_c0[0]) as u64)
    hd_say_tree(state, c2, (&t_c2[0]) as u64)
    // drag c0 over to the top edge of head 1: tiled as the upper half of head 1's tree
    drag_begin(state, c0)
    hd_say_tree(state, c0, (&t_c0t[0]) as u64)
    drag_hover(state, c0, h1x + hw / 2, 0)
    hd_say_drop(state, (&t_top[0]) as u64)
    drag_end(state, c0, h1x + hw / 2, 0)
    hd_say_win(state, c0, (&t_c0t[0]) as u64)
    hd_say_win(state, c1, (&t_c1t[0]) as u64)
    hd_say_win(state, c2, (&t_c2t[0]) as u64)
    hd_say_tree(state, c0, (&t_c0t[0]) as u64)
    hd_say_trees(state, (&t_n2[0]) as u64)
    // the seam between the heads is no docking edge; the middle of a tile: no edge either; switch off: nothing
    drag_hover(state, c0, h1x, 100)
    hd_say_drop(state, (&t_sm[0]) as u64)
    drag_hover(state, c0, h1x + hw / 2, 300)
    hd_say_drop(state, (&t_mid[0]) as u64)
    wmlayout.ss(state, wmlayout.S_DROPN, 0)
    wmlayout.ss(state, wmlayout.S_DROPE, 0)
    wmlayout.ss(state, wmlayout.S_PVON, 0)
    wmlayout.ss(state, wmlayout.S_TILE, 0)
    drag_hover(state, c0, h1x + hw - 1, 100)
    hd_say_drop(state, (&t_off[0]) as u64)
    wmlayout.ss(state, wmlayout.S_TILE, 1)
    if hot {
        let _t1: bool = vgpu.hot_toggle(state, 1)
        heads_sync(state)
        hd_say_win(state, c0, (&t_u0[0]) as u64)
        hd_say_win(state, c1, (&t_u1[0]) as u64)
        hd_say_win(state, c2, (&t_u2[0]) as u64)
        hd_say_tree(state, c0, (&t_u0[0]) as u64)
        hd_say_tree(state, c1, (&t_u1[0]) as u64)
        hd_say_tree(state, c2, (&t_u2[0]) as u64)
        hd_say_trees(state, (&t_n2[0]) as u64)
        let _t2: bool = vgpu.hot_toggle(state, 1)
        heads_sync(state)
        let c3: u64 = create(state, 0, h1x + 80, 80, 300, 200, wmlayout.K_RAW, (&t_f[0]) as u64)
        hd_say_win(state, c3, (&t_c3[0]) as u64)
        hd_say_tree(state, c3, (&t_c3[0]) as u64)
        hd_say_trees(state, (&t_n3[0]) as u64)
    }
    set_tile_on(state, false)
    hd_say_trees(state, (&t_n4[0]) as u64)
    if hot {
        var t_mp: [u8; 11] = "mirror-pre\0"
        var t_mo: [u8; 10] = "mirror-on\0"
        var t_mf: [u8; 11] = "mirror-off\0"
        var t_gn: [u8; 8] = "mode-on\0"
        var t_gf: [u8; 9] = "mode-off\0"
        let c4: u64 = create(state, 0, h1x + 120, 120, 200, 150, wmlayout.K_RAW, (&t_mp[0]) as u64)
        hd_say_win(state, c4, (&t_mp[0]) as u64)
        let _s1: bool = set_display_mode(state, true)
        hd_say_mode(state, (&t_gn[0]) as u64)
        hd_say_win(state, c4, (&t_mo[0]) as u64)
        let _s2: bool = set_display_mode(state, false)
        hd_say_mode(state, (&t_gf[0]) as u64)
        hd_say_win(state, c4, (&t_mf[0]) as u64)
    }
}

fn hd_demo(state: u64, hot: bool) {
    var t_bar: [u8; 4] = "bar\0"
    var t_a: [u8; 6] = "win-a\0"
    var t_b: [u8; 6] = "win-b\0"
    var t_m1: [u8; 5] = "max1\0"
    var t_m0: [u8; 5] = "max0\0"
    var t_f1: [u8; 6] = "full1\0"
    var t_un: [u8; 7] = "unmax1\0"
    var t_u1: [u8; 9] = "unplug-a\0"
    var t_u2: [u8; 11] = "unplug-bar\0"
    var t_pl: [u8; 9] = "replug-a\0"
    var t_pb: [u8; 11] = "replug-bar\0"
    var s_no: [u8; 14] = "hd: no extend\0"
    var s_cl: [u8; 13] = "hd: clamp x=\0"
    var s_cy: [u8; 4] = " y=\0"
    var s_wk: [u8; 24] = "hd: after unplug work0 \0"
    if !hd_multi(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    let sw: u64 = wmlayout.gs(state, wmlayout.S_SW)
    let sh: u64 = wmlayout.gs(state, wmlayout.S_SH)
    // 1. a 28 px bar over the bottom edge of the whole desktop: one strut per head it touches
    var s_sc: [u8; 12] = "hd: screen \0"
    serial.puts((&s_sc[0]) as u64)
    serial.dec(sw)
    serial.put(120 as u8)
    serial.dec(sh)
    serial.nl()
    let bar: u64 = create(state, 0, 0, (sh - 28) as i64, sw, 28, wmlayout.K_RAW, (&t_bar[0]) as u64)
    if bar >= wmbase.MAX_WIN {
        return
    }
    set_deco(state, bar, false)
    let _s: bool = set_strut(state, bar, EDGE_BOTTOM, 28)
    hd_say(state, 0)
    hd_say(state, 1)
    // 2. a window on head 1, maximized: fills the work area of head 1
    let wa: u64 = create(state, 0, (hd_x(state, 1) + 60) as i64, 60, 300, 200, wmlayout.K_RAW, (&t_a[0]) as u64)
    let _m1: bool = maximize(state, wa, true)
    hd_say_win(state, wa, (&t_m1[0]) as u64)
    // 3. a window on head 0, maximized: fills the work area of head 0
    let wb: u64 = create(state, 0, 40, 50, 300, 200, wmlayout.K_RAW, (&t_b[0]) as u64)
    let _m0: bool = maximize(state, wb, true)
    hd_say_win(state, wb, (&t_m0[0]) as u64)
    // 4. back to normal: the saved rect is restored on the head it came from
    let _u: bool = maximize(state, wa, false)
    hd_say_win(state, wa, (&t_un[0]) as u64)
    // 5. fullscreen of the window on head 1: exactly head 1, not the desktop
    let _f: bool = fullscreen(state, wa, true)
    hd_say_win(state, wa, (&t_f1[0]) as u64)
    let _f2: bool = fullscreen(state, wa, false)
    // 6. pointer clamp with heads of different height: head 1 only 240 high -> a point below it goes back onto it
    let h1x: u64 = ps2m.head_x(state, 1)
    let h1y: u64 = ps2m.head_y(state, 1)
    let h1w: u64 = ps2m.head_w(state, 1)
    let h1h: u64 = ps2m.head_h(state, 1)
    ps2m.set_head(state, 1, h1x, h1y, h1w, 240)
    ps2m.set_pos(state, h1x + 60, 250)
    serial.puts((&s_cl[0]) as u64)
    serial.dec(ps2m.x(state))
    serial.puts((&s_cy[0]) as u64)
    serial.dec(ps2m.y(state))
    serial.nl()
    ps2m.set_head(state, 1, h1x, h1y, h1w, h1h)
    if !hot {
        hd_demo_tile(state, hot, wa, wb, bar)
        return
    }
    let _m2: bool = maximize(state, wa, true)
    // 7. unplug head 1: the window on it comes to head 0 (and is maximized there if it was), head 1's strut is gone
    let _t1: bool = vgpu.hot_toggle(state, 1)
    heads_sync(state)
    hd_say_win(state, wa, (&t_u1[0]) as u64)
    hd_say_win(state, bar, (&t_u2[0]) as u64)
    // 8. plug it back: head 1 is there again with its work area
    let _t2: bool = vgpu.hot_toggle(state, 1)
    heads_sync(state)
    hd_say_win(state, wa, (&t_pl[0]) as u64)
    hd_say_win(state, bar, (&t_pb[0]) as u64)
    hd_demo_tile(state, hot, wa, wb, bar)
}

// THE WORK AREA, recomputed from scratch. Not incrementally: an
// incremental work area is a cache, and a cache of four numbers that
// three modules write is the kind of thing that is right in every test
// and wrong on the machine.
fn recalc_work(state: u64) {
    if hd_multi(state) {
        // r826: several heads -- the work_* scalars (and with them the tile tree) belong to the primary head.
        let p: u64 = head_work(state, hd_primary(state))
        wmlayout.ss(state, wmlayout.S_WORK_X, hw_x(p))
        wmlayout.ss(state, wmlayout.S_WORK_Y, hw_y(p))
        wmlayout.ss(state, wmlayout.S_WORK_W, hw_w(p))
        wmlayout.ss(state, wmlayout.S_WORK_H, hw_h(p))
        wmlayout.ss(state, wmlayout.S_WORKCALC, wmlayout.gs(state, wmlayout.S_WORKCALC) + 1)
        refit_max(state)
        tile_area_work(state)
        tile_apply(state)
        return
    }
    let sw: u64 = wmlayout.gs(state, wmlayout.S_SW)
    let sh: u64 = wmlayout.gs(state, wmlayout.S_SH)
    var x0: u64 = 0
    var y0: u64 = 0
    var x1: u64 = sw
    var y1: u64 = sh
    if wmlayout.gs(state, wmlayout.S_NOSTRUT) == 0 {
        // RUNDE BLECHDREI: das reservierte Band der Messtafel ist ein
        // Strut wie jeder andere -- nur einer, den kein Fenster haelt.
        // Ohne diese Zeile legte der Schreibtisch seine Fenster unter
        // die Tafel, und `fb` schnitte sie dort ab.
        y0 = fb.band(state)
        var i: u64 = 0
        while i < wmbase.MAX_WIN {
            if wmlayout.wg(state, i, wmlayout.W_USED) != 0 && wmlayout.wg(state, i, wmlayout.W_STRUT) != 0 {
                if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) == 0 {
                    let e: u64 = (wmlayout.wg(state, i, wmlayout.W_STRUT) & 0xFF) - 1
                    let n: u64 = wmlayout.wg(state, i, wmlayout.W_STRUT) >> 8
                    if e == EDGE_TOP {
                        if n > y0 {
                            y0 = n
                        }
                    } else if e == EDGE_BOTTOM {
                        if n < sh && sh - n < y1 {
                            y1 = sh - n
                        }
                    } else if e == EDGE_LEFT {
                        if n > x0 {
                            x0 = n
                        }
                    } else {
                        if n < sw && sw - n < x1 {
                            x1 = sw - n
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    // A STRUT THAT EATS THE SCREEN IS NOT A STRUT. The smallest window
    // this server will make is 32 x 16 (see `resize_win`), plus the
    // decoration; below 64 x 64 of work area nothing can be laid out at
    // all, and the honest answer is to refuse the reservation rather
    // than to hand out a rectangle nobody can use.
    if x1 < x0 + 64 || y1 < y0 + 64 {
        x0 = 0
        y0 = 0
        x1 = sw
        y1 = sh
    }
    wmlayout.ss(state, wmlayout.S_WORK_X, x0)
    wmlayout.ss(state, wmlayout.S_WORK_Y, y0)
    wmlayout.ss(state, wmlayout.S_WORK_W, x1 - x0)
    wmlayout.ss(state, wmlayout.S_WORK_H, y1 - y0)
    wmlayout.ss(state, wmlayout.S_WORKCALC, wmlayout.gs(state, wmlayout.S_WORKCALC) + 1)
    refit_max(state)
    // RUNDE VOLLBILD: UND DER KACHELBAUM FOLGT MIT. `refit_max` zieht
    // die maximierten Fenster nach, der Baum blieb bisher stehen -- ein
    // gekacheltes Fenster behielt die Flaeche von vor dem Strut und lag
    // damit unter der Leiste. Dieselbe Begruendung wie bei `refit_max`
    // eine Zeile darueber: ein Strut, den nur die Haelfte beachtet, ist
    // keiner.
    tile_area_work(state)
    tile_apply(state)
}

fn set_nostrut(state: u64, on: bool) {
    if on {
        wmlayout.ss(state, wmlayout.S_NOSTRUT, 1)
    } else {
        wmlayout.ss(state, wmlayout.S_NOSTRUT, 0)
    }
    recalc_work(state)
}

fn set_strut(state: u64, i: u64, edge: u64, size: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    if edge > EDGE_RIGHT {
        return false
    }
    if size > STRUT_MAX {
        return false
    }
    if size == 0 {
        wmlayout.wsv(state, i, wmlayout.W_STRUT, 0)
    } else {
        wmlayout.wsv(state, i, wmlayout.W_STRUT, (edge + 1) | (size << 8))
    }
    wmlayout.ss(state, wmlayout.S_STRUTS, wmlayout.gs(state, wmlayout.S_STRUTS) + 1)
    recalc_work(state)
    return true
}

fn is_max(state: u64, i: u64) -> bool {
    if i >= wmbase.MAX_WIN {
        return false
    }
    return (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED) != 0
}

// PUT A WINDOW ON THE WORK AREA. The OUTER rectangle of the window --
// frame, title bar and all -- becomes the work area exactly; the
// drawing surface is that minus the decoration. A window without
// decoration (desktop, taskbar) has no such difference, which is why
// this goes through `deko` and not through BORDER and TITLE_H.
fn fit_work(state: u64, i: u64) -> bool {
    let hwk: u64 = win_work(state, i)
    var iw: u64 = hw_w(hwk)
    var ih: u64 = hw_h(hwk)
    if wmbase.deko(state, i) {
        if iw <= wmgeom.border(state) * 2 || ih <= wmbase.iny(state, i) + wmgeom.border(state) {
            return false
        }
        iw = iw - wmgeom.border(state) * 2
        ih = ih - wmbase.iny(state, i) - wmgeom.border(state)
    }
    if !resize_win(state, i, iw, ih) {
        return false
    }
    move_win(state, i, hw_x(hwk) as i64, hw_y(hwk) as i64)
    return true
}

// EVERY MAXIMIZED WINDOW FOLLOWS THE WORK AREA. This is the whole point
// of the flag: the taskbar moves from the bottom edge to the left edge,
// the work area changes, and the windows that were filling it fill the
// new one. Without this they would keep the old rectangle and half of
// them would sit under the taskbar.
fn refit_max(state: u64) {
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmlayout.wg(state, i, wmlayout.W_USED) != 0 {
            if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED) != 0 {
                let _r: bool = fit_work(state, i)
            }
        }
        i = i + 1
    }
}

fn maximize(state: u64, i: u64, on: bool) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    let f: u64 = wmlayout.wg(state, i, wmlayout.W_FLAGS)
    if on {
        if (f & wmlayout.F_MAXIMIZED) != 0 {
            return true
        }
        // Where to go back to. Biased by 4096 because a window may sit
        // at a negative coordinate and these are sixteen unsigned bits.
        let sx: u64 = ((wmbase.win_x(state, i) + 4096) as u64) & 0xFFFF
        let sy: u64 = ((wmbase.win_y(state, i) + 4096) as u64) & 0xFFFF
        wmlayout.wsv(state, i, wmlayout.W_SAVE, (sx << 48) | (sy << 32)
            | ((wmlayout.wg(state, i, wmlayout.W_W) & 0xFFFF) << 16)
            | (wmlayout.wg(state, i, wmlayout.W_H) & 0xFFFF))
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, f | wmlayout.F_MAXIMIZED)
        if !fit_work(state, i) {
            // It did not fit -- most often because the buffer this
            // window was created with is smaller than the work area
            // (`resize_win` refuses to grow past it). Then it is NOT
            // maximized, and saying so is the whole difference between
            // a measurement and a claim.
            wmlayout.wsv(state, i, wmlayout.W_FLAGS, f)
            return false
        }
        return true
    }
    if (f & wmlayout.F_MAXIMIZED) == 0 {
        return true
    }
    let v: u64 = wmlayout.wg(state, i, wmlayout.W_SAVE)
    wmlayout.wsv(state, i, wmlayout.W_FLAGS, f & ~wmlayout.F_MAXIMIZED)
    let _r: bool = resize_win(state, i, (v >> 16) & 0xFFFF, v & 0xFFFF)
    let bx: i64 = ((v >> 48) & 0xFFFF) as i64 - 4096
    let by: i64 = ((v >> 32) & 0xFFFF) as i64 - 4096
    move_win(state, i, bx, by)
    return true
}

// ================================================== RUNDE VOLLBILD
// F11: DER GANZE SCHIRM, OHNE LEISTE UND OHNE SCHMUCK.
//
// Der Unterschied zu `maximize` in Zahlen (3440x1440, Leiste 80 hoch):
//
//     maximiert:  x=0 y=0   w=3440 h=1360   Leiste sichtbar, Titel da
//     Vollbild:   x=0 y=0   w=3440 h=1440   Leiste weg,      kein Titel
//
// WAS GESICHERT WIRD UND WARUM SO VIEL. Zurueck muss nicht nur die
// Groesse, sondern auch die LAGE und der ZUSTAND -- war das Fenster
// vorher maximiert, ist es hinterher wieder maximiert und nicht
// normal. F_MAXIMIZED wird deshalb NICHT geloescht, sondern
// stehengelassen und beim Verlassen ausgewertet.
//
// WARUM DIE LEISTE NICHT "VERSTECKT" WIRD. Ein `F_HIDDEN` auf der
// Leiste waere der naheliegende Weg und der falsche: die Leiste
// haelt einen Strut, `recalc_work` liefe, die Arbeitsflaeche
// waechst auf den ganzen Schirm, und JEDES maximierte Fenster
// dahinter wuerde mitwachsen. Beim Verlassen muesste alles
// zurueckgerechnet werden. Stattdessen liegt das Vollbildfenster
// einfach UEBER der Leiste (Ebene L_FULL) -- die Leiste bleibt, was
// sie ist, sie ist nur verdeckt. Das ist auch, was Windows tut.
fn fullscreen(state: u64, i: u64, on: bool) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    let f: u64 = wmlayout.wg(state, i, wmlayout.W_FLAGS)
    if on {
        if (f & wmlayout.F_FULL) != 0 {
            return true
        }
        // Lage und Groesse sichern -- mit demselben Versatz von 4096
        // wie `maximize`, weil ein Fenster negativ liegen darf.
        let sx: u64 = ((wmbase.win_x(state, i) + 4096) as u64) & 0xFFFF
        let sy: u64 = ((wmbase.win_y(state, i) + 4096) as u64) & 0xFFFF
        wmlayout.wsv(state, i, wmlayout.W_FSXY, (sx << 32) | sy)
        wmlayout.wsv(state, i, wmlayout.W_FSWH, ((wmlayout.wg(state, i, wmlayout.W_W) & 0xFFFF) << 32)
            | (wmlayout.wg(state, i, wmlayout.W_H) & 0xFFFF))
        // Der Schmuck faellt weg. Ob er vorher da war, steht im
        // gesicherten Merkerwort -- deshalb wird F_NODECO gesetzt und
        // nicht getauscht.
        let hatte_deko: bool = wmbase.deko(state, i)
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, f | wmlayout.F_FULL | wmlayout.F_NODECO)
        // r826: the whole HOME head (the whole screen on a plain one)
        let fh: u64 = win_head(state, i)
        let sw: u64 = hd_w(state, fh)
        let sh: u64 = hd_h(state, fh)
        if !resize_win(state, i, sw, sh) {
            // Passt nicht -- dann ist es NICHT im Vollbild, und das
            // zu sagen ist der Unterschied zwischen einer Messung und
            // einer Behauptung (dieselbe Regel wie in `maximize`).
            var back: u64 = f
            if !hatte_deko {
                back = back | wmlayout.F_NODECO
            }
            wmlayout.wsv(state, i, wmlayout.W_FLAGS, back)
            return false
        }
        move_win(state, i, hd_x(state, fh) as i64, hd_y(state, fh) as i64)
        // UEBER die Leiste. Die Ebene ist die einzige Stelle, an der
        // "vor der Leiste" ueberhaupt ausgedrueckt werden kann.
        set_layer(state, i, wmlayout.L_FULL)
        raise_win(state, i)
        return true
    }
    if (f & wmlayout.F_FULL) == 0 {
        return true
    }
    // Zurueck auf die normale Ebene, BEVOR die Groesse kommt: sonst
    // malt ein Anstrich dazwischen das Fenster noch ganz oben.
    set_layer(state, i, wmlayout.L_NORMAL)
    let xy: u64 = wmlayout.wg(state, i, wmlayout.W_FSXY)
    let wh: u64 = wmlayout.wg(state, i, wmlayout.W_FSWH)
    // Der Schmuck kommt zurueck -- ausser das Fenster hatte nie
    // welchen (Schreibtisch, Leiste).
    var nf: u64 = f & ~wmlayout.F_FULL & ~wmlayout.F_NODECO
    wmlayout.wsv(state, i, wmlayout.W_FLAGS, nf)
    // WAR ES VORHER MAXIMIERT, wird es das wieder -- und zwar ueber
    // `fit_work`, damit es die AKTUELLE Arbeitsflaeche bekommt und
    // nicht die von damals. Das ist der Fall, der ohne eigene
    // Sicherungsplaetze kaputtginge.
    if (nf & wmlayout.F_MAXIMIZED) != 0 {
        if fit_work(state, i) {
            return true
        }
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, nf & ~wmlayout.F_MAXIMIZED)
    }
    let _r: bool = resize_win(state, i, (wh >> 32) & 0xFFFF, wh & 0xFFFF)
    let bx: i64 = ((xy >> 32) & 0xFFFF) as i64 - 4096
    let by: i64 = (xy & 0xFFFF) as i64 - 4096
    move_win(state, i, bx, by)
    return true
}

// ================================================== RUNDE VOLLBILD
// WAS DAS VOLLBILD MIT DEM FENSTER GEMACHT HAT, ALS ZAHLEN.
//
// Justin will die Geometrie in ALLEN DREI Zustaenden sehen und den
// Rueckweg geprueft haben. Ohne diese Zeile muesste man sie aus dem
// Bild schaetzen -- und ein Zustandswechsel, den man nur sieht, ist
// keiner, den man nachrechnen kann.
//
//     wm: voll id=7 an=1 x=0 y=0 w=3440 h=1440 fl=34 lay=3
//
// `fl` traegt beide Merker: 32 ist F_FULL, 4 waere zusaetzlich
// F_MAXIMIZED -- daran liest ein Pruefer ab, ob der Rueckweg auf
// "maximiert" oder auf "normal" fuehren muss.
fn full_say(state: u64, i: u64) {
    if !wmbase.valid(state, i) {
        return
    }
    var s_h: [u8; 13] = "wm: voll id=\0"
    var s_a: [u8; 5] = " an=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var s_f: [u8; 5] = " fl=\0"
    var s_l: [u8; 6] = " lay=\0"
    serial.puts((&s_h[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_ID))
    serial.puts((&s_a[0]) as u64)
    if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_FULL) != 0 {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_x[0]) as u64)
    serial.dec(wmbase.win_x(state, i) as u64)
    serial.puts((&s_y[0]) as u64)
    serial.dec(wmbase.win_y(state, i) as u64)
    serial.puts((&s_w[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_W))
    serial.puts((&s_hh[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_H))
    serial.puts((&s_f[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_FLAGS))
    serial.puts((&s_l[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_LAYER))
    serial.nl()
}

fn is_full(state: u64, i: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    return (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_FULL) != 0
}

// ======================================================= RUNDE TUERSCHLOSS
// WAEHREND DES SELBSTTESTS SAGT DER FOKUS NICHTS.
//
// `set_focus` meldet seit dieser Runde jeden Wechsel als
// `wm: fokus id=<neu> vor=<alt>` -- und das ist der Beleg, ohne den
// Alt+Tab nicht messbar waere. Der Selbsttest ruft `set_focus` aber in
// seiner Zusage 7 auf, und zwar MITTEN in die Zeile hinein, die
// `kgui` gerade schreibt:
//
//     wm: selftest wm: fokus id=1 vor=0
//
// Damit war die Zahl hinter `selftest` weg, und tools/wm/run.sh meldete
// "keine Zahl gefunden (erwartet eq 30)" -- ein Fehler, den diese Runde
// selbst gebaut hat. Eine Diagnosezeile, die eine andere zerschneidet,
// ist keine Diagnose.
static mut fokus_still: u64 = 0

// RUNDE ECHTHARDWARE-1: das Fenster sagt, ob es die Tastatur will.
//
// Wird es JETZT gesetzt und das Fenster liegt schon oben und ist
// sichtbar, bekommt es den Fokus sofort -- sonst muesste man es erst
// noch einmal anklicken, und genau dieser zweite Klick war der Punkt,
// an dem Justins Startmenue "nichts tut" aussah.
fn set_keys(state: u64, i: u64, an: bool) {
    if !wmbase.valid(state, i) {
        return
    }
    if an {
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, wmlayout.wg(state, i, wmlayout.W_FLAGS) | wmlayout.F_KEYS)
        if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) == 0 {
            set_focus(state, i)
        }
    } else {
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, wmlayout.wg(state, i, wmlayout.W_FLAGS) & ~wmlayout.F_KEYS)
    }
}

fn popups_dismiss_on_focus(state: u64, target: u64) {
    let layer: u64 = wmlayout.wg(state, target, wmlayout.W_LAYER)
    if layer == wmlayout.L_POPUP || layer == wmlayout.L_TIP || layer == wmlayout.L_TOAST {
        return
    }
    var j: u64 = 0
    while j < wmbase.MAX_WIN {
        if j != target && j + 1 != layer_guard && wmbase.valid(state, j) && wmlayout.wg(state, j, wmlayout.W_LAYER) == wmlayout.L_POPUP && (wmlayout.wg(state, j, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) == 0 {
            ev_push(state, j, wmlayout.E_CLOSE, 0, 0, 0)
        }
        j = j + 1
    }
}

fn set_focus(state: u64, i: u64) {
    if !wmbase.valid(state, i) {
        return
    }
    // Ein verborgenes Fenster bekommt die Tastatur nicht. Sonst tippt
    // man in etwas, das nicht auf dem Schirm steht.
    if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) != 0 {
        return
    }
    let alt: u64 = wmbase.focus(state)
    if alt == i {
        return
    }
    popups_dismiss_on_focus(state, i)
    if alt < wmbase.MAX_WIN {
        wmdamage.damage_win(state, alt)
        ev_push(state, alt, wmlayout.E_FOCUS, 0, 0, 0)
    }
    if alt < wmbase.MAX_WIN {
        wmlayout.ss(state, wmlayout.S_FOCUS_PREV, alt + 1)
    }
    wmlayout.ss(state, wmlayout.S_FOCUS, i + 1)
    wmplug.notify(state, wmplug.E_FOCUS, wmlayout.wg(state, i, wmlayout.W_ID), 0, 0)
    // ================================================ RUNDE TUERSCHLOSS
    //
    // DER FOKUSWECHSEL WIRD GESAGT, und ohne diese Zeile war Punkt 4.3
    // der Vorrunde gar nicht messbar.
    //
    // Runde DURCHKLICK schrieb "`focus=1` bleibt ueber 137 Meldungen
    // konstant" und belegte damit, dass Alt+Tab nichts tut. Nachgesehen:
    // das `focus=1` in jenen Mitschnitten stammt aus
    // `taskbar: btn ... hidden=0 focus=1` -- der KNOPFLISTE der Leiste --
    // und aus `wm: 1280x800 ... focus=1`, der EINSCHALTMELDUNG des
    // Servers. Keines von beiden ist der Eingabefokus. Der Befund war
    // richtig, sein Beleg zeigte aber auf etwas anderes.
    //
    // Der Eingabefokus stand nirgends auf der Leitung. Jetzt steht er
    // da: eine Zeile je WIRKLICHEM Wechsel (die Abfrage `alt == i`
    // weiter oben laesst Wiederholungen gar nicht bis hierher), mit dem
    // Fenster davor und danach.
    if fokus_still == 0 {
        var s_fk: [u8; 14] = "wm: fokus id=\0"
        var s_fv: [u8; 7] = " vor=\0\0"
        serial.puts((&s_fk[0]) as u64)
        serial.dec(wmlayout.wg(state, i, wmlayout.W_ID))
        serial.puts((&s_fv[0]) as u64)
        if alt < wmbase.MAX_WIN {
            serial.dec(wmlayout.wg(state, alt, wmlayout.W_ID))
        } else {
            serial.dec(0)
        }
        serial.nl()
    }
    ev_push(state, i, wmlayout.E_FOCUS, 0, 0, 1)
    // RUNDE TILING: DER BAUM FUEHRT SEINEN EIGENEN FOKUS, und die beiden
    // muessen derselbe sein. Ohne diese zwei Zeilen teilt ein neues
    // Fenster nicht das ANGEKLICKTE, sondern das zuletzt angelegte -- ein
    // Fehler, der aussieht wie ein kaputter Baum und keiner ist.
    if wmlayout.wg(state, i, wmlayout.W_NODE) != 0 {
        tl_sel(state, nd_tag(wmlayout.wg(state, i, wmlayout.W_NODE)))
        tile.set_focus(tt(state), nd_node(wmlayout.wg(state, i, wmlayout.W_NODE)))
    }
    wmdamage.damage_win(state, i)
}

fn move_win(state: u64, i: u64, x: i64, y: i64) {
    if !wmbase.valid(state, i) {
        return
    }
    // RUNDE ZIEH: WER GROESSER MALT, MUSS GROESSER SCHMUTZIG MELDEN.
    //
    // Ein aufgehobenes Fenster deckt mehr Flaeche als seine
    // Fenstertafel angibt (Skalierung plus Nachzug). Meldete diese
    // Stelle weiter nur `damage_win`, bliebe beim Ziehen ein Rand des
    // vorigen Bildes stehen -- ein Schmierstreifen, der aussieht wie
    // ein Fehler im Zeichnen und keiner ist.
    let hebt: bool = wmanim.drag_paint_on(state, i)
    if hebt {
        wmanim.damage_win_lift(state, i)
    } else {
        wmdamage.damage_win(state, i) // die alte Stelle wird wiederhergestellt
    }
    wmlayout.wsv(state, i, wmlayout.W_X, x as u64)
    wmlayout.wsv(state, i, wmlayout.W_Y, y as u64)
    if hebt {
        wmanim.damage_win_lift(state, i)
    } else {
        wmdamage.damage_win(state, i) // und die neue gemalt
    }
    unter_leiste_messen(state, i)
}

// ================================================ RUNDE GLAS (NACHTRAG)
//
// WIE GROSS DIE SCHNITTFLAECHE MIT DER LEISTE IST -- gemessen an der
// Stelle, durch die jede Bewegung geht.
//
// `tools/themestore/run.sh` belegte "keine Schlieren" mit `diff 0` auf
// dem Leistenstreifen. Diese Zahl ist 0, solange die Leiste mit sich
// selbst verglichen wird, und sie ist AUCH 0, wenn das Fenster nie
// unter die Leiste gekommen ist -- ein gruener Haken ueber einem
// leeren Schnitt. Seit diesem Nachtrag steht die Schnittflaeche
// daneben: ist sie 0, hat die Probe nichts geprueft, und der Laeufer
// zaehlt sie rot.
fn unter_leiste_messen(state: u64, i: u64) {
    let pw: u64 = wmbase.panel_win(state)
    if pw >= wmbase.MAX_WIN || i == pw || !wmbase.valid(state, i) {
        return
    }
    let px0: i64 = wmbase.win_x(state, pw)
    let py0: i64 = wmbase.win_y(state, pw)
    let px1: i64 = px0 + wmbase.outer_w(state, pw) as i64
    let py1: i64 = py0 + wmbase.outer_h(state, pw) as i64
    var a: i64 = wmbase.win_x(state, i)
    var b: i64 = wmbase.win_y(state, i)
    var c: i64 = a + wmbase.outer_w(state, i) as i64
    var d: i64 = b + wmbase.outer_h(state, i) as i64
    if a < px0 {
        a = px0
    }
    if b < py0 {
        b = py0
    }
    if c > px1 {
        c = px1
    }
    if d > py1 {
        d = py1
    }
    if c <= a || d <= b {
        return
    }
    let f: u64 = ((c - a) * (d - b)) as u64
    if f > wmlayout.gs(state, wmlayout.S_UNTERPX) {
        wmlayout.ss(state, wmlayout.S_UNTERPX, f)
        // GEMELDET WIRD BEIM WACHSEN UND NICHT AM ENDE DES LAUFS.
        // Die Schlusszeilen dieses Servers stehen bei `wm: hold`, also
        // BEVOR der Laeufer ueberhaupt klickt; eine Zahl, die erst
        // waehrend des Zuges entsteht, kommt dort nie an. Bei einem Zug
        // sind das eine Handvoll Zeilen (je neuer Groesstwert eine),
        // und der Laeufer nimmt die letzte.
        wmbase.schlieren_say(state)
    }
}

fn unter_leiste_px(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_UNTERPX)
}

fn resize_win(state: u64, i: u64, w: u64, h: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    // RUNDE SCHIRM: DIE ZWEI 2048 WAREN DER GRUND, WARUM AUF EINEM
    // 2560x1440-SCHIRM NICHTS MEHR MAXIMIERTE.
    //
    // Gemessen: `wm: selftest 26 / 30  failed=0x58c04200  mw=2  max=0`
    // -- das Fenster entstand (mw=2), aber `maximize` gab false. Der
    // Weg dahin ist fit_work -> resize_win, und dort stand ein fester
    // Deckel von 2048, den jeder Schirm ueber 2048 Bildpunkten Breite
    // reisst. Die Grenze, die es wirklich gibt, ist der PUFFER des
    // Fensters, und die steht zwei Zeilen tiefer.
    // ================================================== RUNDE GRIFF
    // WARUM DIE LEISTE SICH NICHT AUF IHREN SPALT ZUSAMMENZIEHEN KANN.
    //
    // GEMESSEN (Justins Blech, 2560x1440, ECHTHARDWARE-2):
    //
    //     taskbar: size w=2560 h=2 rc=-4
    //
    // `-4` ist E_INVALID und kommt aus genau dieser Zeile: die
    // Taskleiste mit `autohide=1` will sich auf ihren SLIVER von zwei
    // Bildpunkten zurueckziehen (kernel/user/taskbar.fi, `SLIVER`),
    // und `h < 16` weist das ab. Die Leiste bleibt in voller Hoehe
    // stehen -- das automatische Verbergen ist damit gebaut, gemeldet
    // und wirkungslos.
    //
    // WOFUER DIE 32x16 DA SIND: fuer ein Fenster MIT SCHMUCK. Unter
    // einer Titelleiste plus zwei Rahmen ist ein Fenster von 8x8
    // sinnlos, und `wm_strut` beruft sich weiter oben ausdruecklich auf
    // diese Zahl. Fuer ein Fenster OHNE Schmuck gilt die Begruendung
    // nicht: ein Spalt am Bildschirmrand IST die richtige Groesse.
    //
    // Also gilt die Untergrenze weiter -- aber sie fragt vorher, ob das
    // Fenster ueberhaupt Schmuck traegt. Ein undekoriertes Fenster darf
    // bis auf 1x1 herunter; kleiner als ein Bildpunkt ist nichts, und
    // `w * h * 4` weiter unten bleibt damit wohldefiniert.
    var keep_buf: u64 = 0
    var keep_w: u64 = 0
    var keep_h: u64 = 0
    var keep_free: u64 = 0
    var min_w: u64 = 32
    var min_h: u64 = 16
    if !win_deco(state, i) {
        min_w = 1
        min_h = 1
    }
    if w < min_w || h < min_h || w > wmgeom.MAX_W_HARD || h > wmgeom.MAX_H_HARD {
        return false
    }
    // RUNDE HIDPUNKTE: HIER STAND "OHNE NEUEN PUFFER NICHT GROESSER ALS
    // ANGELEGT", UND DAS WAR DER GRUND, WARUM AUF EINEM ULTRAWIDE-SCHIRM
    // KEINE TASKLEISTE ZU SEHEN IST.
    //
    // Gemessen auf 3440x1440: die Leiste entsteht klein, will auf
    // `w=3440 h=56` wachsen (770 560 Oktett) und bekommt `rc=-4`. Sie
    // behaelt ihren alten Puffer von 128 Bildpunkten Breite -- und
    // genau 128 Bildpunkte breit ist sie danach auf dem Schirm
    // (nachgemessen im Bildschirmfoto, `docs/shots/hidpunkte/`). Auf
    // 1280x800 passte der Wunsch zufaellig in den vorhandenen Puffer,
    // deshalb ist das nie aufgefallen.
    //
    // Ein Fenster, das waechst, bekommt jetzt einen groesseren Puffer.
    // Der alte wird NICHT freigegeben -- `mem.frame_run` hat kein
    // Gegenstueck in diesem Kern, und ein Rahmen, der zurueckgegeben
    // wird, ohne dass es einen Weg dafuer gibt, ist schlimmer als einer,
    // der liegen bleibt. Bei sechzehn Fenstern ist das begrenzt.
    // W-C3f: a resize to the size the window already has must NOT take the shared buffer away. The client compares the new size with its
    // own (equal -> nothing to re-attach), so a detach here left the window on a private, blank buffer for good (the taskbar after a
    // repeated apply, QEMU gate line `a resize step detached more windows than were re-attached`).
    if wmlayout.wg(state, i, wmlayout.W_SHM) != 0 && wmlayout.wg(state, i, wmlayout.W_W) == w && wmlayout.wg(state, i, wmlayout.W_H) == h && wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM {
        return true
    }
    if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM && wmlayout.wg(state, i, wmlayout.W_SHM) != 0 {
        // COMPOSITOR r486: the terminal's buffer belongs to the kernel, which paints it with the new row length itself
        if !term_fit(state, i, w * h * 4) {
            return false
        }
    } else if wmlayout.wg(state, i, wmlayout.W_SHM) != 0 {
        // COMPOSITOR S3: a shared buffer has the row length of the old width. The window leaves it (the client keeps its mapping alive)
        // and gets a buffer of its own; the client takes the new size from E_RESIZE and attaches a new shared buffer (WM_SETBUF).
        keep_buf = wmlayout.wg(state, i, wmlayout.W_BUF)
        keep_w = wmlayout.wg(state, i, wmlayout.W_W)
        keep_h = wmlayout.wg(state, i, wmlayout.W_H)
        if !detach_buf(state, i, w * h * 4) {
            return false
        }
    } else if wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM && wmlayout.wg(state, i, wmlayout.W_BUF) != 0 && !resize_clear_an(state) {
        // W-FLICKER: a window on a kernel-own buffer (the client has not re-attached yet, or never will) gets fresh frames at every size so
        // that the old picture can be copied over with the new row length (the old way re-used the buffer and cleared it to the background)
        let bytes: u64 = w * h * 4
        let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
        let neu: u64 = mem.frame_run(state, rahmen)
        if neu == 0 {
            return false
        }
        keep_buf = wmlayout.wg(state, i, wmlayout.W_BUF)
        keep_w = wmlayout.wg(state, i, wmlayout.W_W)
        keep_h = wmlayout.wg(state, i, wmlayout.W_H)
        keep_free = wmlayout.wg(state, i, wmlayout.W_BUFBYTES) / mem.FRAME_SIZE
        wmlayout.wsv(state, i, wmlayout.W_BUF, neu)
        wmlayout.wsv(state, i, wmlayout.W_BUFBYTES, rahmen * mem.FRAME_SIZE)
    } else if w * h * 4 > wmlayout.wg(state, i, wmlayout.W_BUFBYTES) {
        let bytes: u64 = w * h * 4
        let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
        let neu: u64 = mem.frame_run(state, rahmen)
        if neu == 0 {
            return false // wirklich kein Speicher -- dann ehrlich nein
        }
        wmlayout.wsv(state, i, wmlayout.W_BUF, neu)
        wmlayout.wsv(state, i, wmlayout.W_BUFBYTES, rahmen * mem.FRAME_SIZE)
    }
    wmdamage.damage_win(state, i)
    wmlayout.wsv(state, i, wmlayout.W_W, w)
    wmlayout.wsv(state, i, wmlayout.W_H, h)
    // r1061: any resize (user, program, screen fit) drops the remembered pre-shrink size; screen_fit_windows sets it again afterwards
    if (wmlayout.wg(state, i, wmlayout.W_SAVWH) >> 63) != 0 {
        wmlayout.wsv(state, i, wmlayout.W_SAVWH, 0)
    }
    if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM {
        term_setup(state, i)
    } else if keep_buf != 0 && !resize_clear_an(state) {
        keep_resized(state, i, keep_buf, keep_w, keep_h)
        if keep_free != 0 {
            mem.frame_free_run(state, keep_buf, keep_free)
        }
    } else {
        wmdraw.fill(state, i, 0, 0, w, h, wmlayout.wg(state, i, wmlayout.W_BG))
    }
    ev_push(state, i, wmlayout.E_RESIZE, w, h, 0)
    wmdamage.damage_win(state, i)
    return true
}

// W-FLICKER (resize): THE OLD PICTURE STAYS UNTIL THE CLIENT HAS PAINTED THE NEW ONE.
// Before: a resize filled the window's new kernel buffer with the background colour, the compositor showed that flat window until the client
// had taken E_RESIZE, mapped a new shared buffer and painted (tens of ms on slow hardware = a visible flash on every step of a drag).
// Now the overlap of the old and the new size is copied over (row by row, the row lengths differ), only the newly exposed strips get the
// background colour. `old` is the buffer the window just left: the client still maps it, so it is alive.
fn resize_clear_an(state: u64) -> bool {
    return kstate.mode_on(state, kstate.M_RESCLEAR)
}

fn keep_resized(state: u64, i: u64, old: u64, ow: u64, oh: u64) {
    let nw: u64 = wmlayout.wg(state, i, wmlayout.W_W)
    let nh: u64 = wmlayout.wg(state, i, wmlayout.W_H)
    let nb: u64 = wmlayout.wg(state, i, wmlayout.W_BUF)
    if nb == 0 || old == 0 {
        wmdraw.fill(state, i, 0, 0, nw, nh, wmlayout.wg(state, i, wmlayout.W_BG))
        return
    }
    var cw: u64 = ow
    if nw < cw {
        cw = nw
    }
    var ch: u64 = oh
    if nh < ch {
        ch = nh
    }
    var y: u64 = 0
    while y < ch {
        wmdraw.copy_words(nb +% y *% nw *% 4, old +% y *% ow *% 4, cw / 2)
        if (cw & 1) != 0 {
            __mmio_write32((nb +% y *% nw *% 4 +% (cw - 1) *% 4) as *mut u32,
                __mmio_read32((old +% y *% ow *% 4 +% (cw - 1) *% 4) as *mut u32))
        }
        y = y + 1
    }
    if nw > cw {
        wmdraw.fill(state, i, cw, 0, nw - cw, ch, wmlayout.wg(state, i, wmlayout.W_BG))
    }
    if nh > ch {
        wmdraw.fill(state, i, 0, ch, nw, nh - ch, wmlayout.wg(state, i, wmlayout.W_BG))
    }
}

// ================================================= COMPOSITOR S3 (docs/COMPOSITOR.md)
//
// SHARED WINDOW BUFFERS. Until now a client painted into memory of its own and `WIG_BLIT` copied the pixels into the server's buffer on every
// frame (two copies in the kernel, one more in the client's strip). A window can now take over the run of frames of a memfd
// (`memfd_create(MFD_FRAMES)`): the client maps it, paints into it, and `WM_DAMAGE` only names the rectangle that changed. The compositor
// reads the same frames -- 0 copies of the client's pixels per frame.

// the kernel word `noshare` switches it off: the counter-proof of tools/comp/shared.sh (clients fall back to WIG_BLIT)
fn shared_ok(state: u64) -> bool {
    return !fb.noshare_an(state)
}

// 0 = the window paints into frames of the server's own, else the shared object + 1
fn win_shm(state: u64, i: u64) -> u64 {
    if !wmbase.valid(state, i) {
        return 0
    }
    return wmlayout.wg(state, i, wmlayout.W_SHM)
}

// COMPOSITOR r486 (terminal): a shared object the KERNEL makes for a window buffer of `bytes` (the server paints the terminal grid into it
// itself; nobody else holds a descriptor). Returns the object + 1 with its one reference, or 0 (noshare, no slot, no contiguous run).
fn kern_shared(state: u64, bytes: u64) -> u64 {
    if !shared_ok(state) {
        return 0
    }
    let pages: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    if pages == 0 || pages > unixsock.SHM_PAGES_CONTIG {
        return 0
    }
    let k: u64 = unixsock.shm_new_contig(state)
    if k >= unixsock.USHM_MAX {
        return 0
    }
    if unixsock.shm_grow(state, k, pages) != 0 {
        unixsock.shm_unref(state, k)
        return 0
    }
    unixsock.shm_set_size(state, k, pages * mem.FRAME_SIZE)
    return k + 1
}

// The terminal window `i` (its buffer is a kernel-made shared object) is going to be `bytes` big: keep the buffer when it fits (the server
// paints with the new row length), else a new object; when no object can be had the window goes back to a private run of frames.
fn term_fit(state: u64, i: u64, bytes: u64) -> bool {
    if bytes <= wmlayout.wg(state, i, wmlayout.W_BUFBYTES) {
        return true
    }
    let o: u64 = kern_shared(state, bytes)
    if o == 0 {
        return detach_buf(state, i, bytes)
    }
    unixsock.shm_unref(state, wmlayout.wg(state, i, wmlayout.W_SHM) - 1)
    wmlayout.wsv(state, i, wmlayout.W_SHM, o)
    wmlayout.wsv(state, i, wmlayout.W_BUF, unixsock.shm_frame(state, o - 1, 0))
    wmlayout.wsv(state, i, wmlayout.W_BUFBYTES, unixsock.shm_pages(state, o - 1) * mem.FRAME_SIZE)
    wmlayout.ss(state, wmlayout.S_TM_SH, wmlayout.gs(state, wmlayout.S_TM_SH) + 1)
    return true
}

// W-C3f: one serial line per buffer change of a shared window (rare: only on resizes). kind 0 = detach failed (no contiguous frames),
// 1 = detach, 2 = attach. Gate tools/vmsvgaresize reads them next to `wm: shared`.
fn wm_note(state: u64, kind: u64, i: u64, bytes: u64) {
    var s_a: [u8; 12] = "wm: bufchg \0"
    var s_w: [u8; 6] = " win=\0"
    var s_b: [u8; 8] = " bytes=\0"
    var s_k: [u8; 6] = " own=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(kind)
    serial.puts((&s_w[0]) as u64)
    serial.dec(i)
    serial.puts((&s_b[0]) as u64)
    serial.dec(bytes)
    serial.puts((&s_k[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_OWNER))
    serial.nl()
}

// A shared window gets a buffer of its own of `bytes` and lets go of the shared one.
fn detach_buf(state: u64, i: u64, bytes: u64) -> bool {
    let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    let neu: u64 = mem.frame_run(state, rahmen)
    if neu == 0 {
        wm_note(state, 0, i, bytes)
        return false
    }
    wm_note(state, 1, i, bytes)
    unixsock.shm_unref(state, wmlayout.wg(state, i, wmlayout.W_SHM) - 1)
    wmlayout.wsv(state, i, wmlayout.W_SHM, 0)
    wmlayout.wsv(state, i, wmlayout.W_BUF, neu)
    wmlayout.wsv(state, i, wmlayout.W_BUFBYTES, rahmen * mem.FRAME_SIZE)
    wmlayout.ss(state, wmlayout.S_SH_DET, wmlayout.gs(state, wmlayout.S_SH_DET) + 1)
    return true
}

// Window `i` now paints from the run of frames of shared object `sidx` (WM_SETBUF). The old buffer (own frames or an older shared
// object) is given back. false when the run is smaller than the window or the window is a terminal (the server paints those).
fn attach_buf(state: u64, i: u64, sbase: u64, sbytes: u64, sidx: u64) -> bool {
    if !wmbase.valid(state, i) || sbase == 0 {
        return false
    }
    if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM || sbytes < wmlayout.wg(state, i, wmlayout.W_W) * wmlayout.wg(state, i, wmlayout.W_H) * 4 {
        return false
    }
    if wmlayout.wg(state, i, wmlayout.W_BUF) == sbase {
        return true
    }
    // W-FLICKER (resize): the new shared buffer starts out empty; the window keeps showing the picture it had (kept by `keep_resized`)
    // until the client paints into the new buffer. Copy it over BEFORE the old frames go (a client that painted first is not asked: WM_SETBUF
    // comes right after the buffer is made, in `win_reshare`).
    if wmlayout.wg(state, i, wmlayout.W_SHM) == 0 && wmlayout.wg(state, i, wmlayout.W_BUF) != 0 && !resize_clear_an(state) {
        let cb: u64 = wmlayout.wg(state, i, wmlayout.W_W) * wmlayout.wg(state, i, wmlayout.W_H) * 4
        if cb <= wmlayout.wg(state, i, wmlayout.W_BUFBYTES) {
            wmdraw.copy_words(sbase, wmlayout.wg(state, i, wmlayout.W_BUF), cb / 8)
            var ci: u64 = (cb / 8) * 8
            while ci < cb {
                __mmio_write32((sbase +% ci) as *mut u32, __mmio_read32((wmlayout.wg(state, i, wmlayout.W_BUF) +% ci) as *mut u32))
                ci = ci + 4
            }
        }
    }
    if wmlayout.wg(state, i, wmlayout.W_SHM) != 0 {
        unixsock.shm_unref(state, wmlayout.wg(state, i, wmlayout.W_SHM) - 1)
    } else if wmlayout.wg(state, i, wmlayout.W_BUF) != 0 {
        mem.frame_free_run(state, wmlayout.wg(state, i, wmlayout.W_BUF), wmlayout.wg(state, i, wmlayout.W_BUFBYTES) / mem.FRAME_SIZE)
    }
    unixsock.shm_ref(state, sidx)
    wm_note(state, 2, i, sbytes)
    wmlayout.wsv(state, i, wmlayout.W_SHM, sidx + 1)
    wmlayout.wsv(state, i, wmlayout.W_BUF, sbase)
    wmlayout.wsv(state, i, wmlayout.W_BUFBYTES, sbytes)
    wmlayout.ss(state, wmlayout.S_SH_ATT, wmlayout.gs(state, wmlayout.S_SH_ATT) + 1)
    wmdamage.damage_win(state, i)
    return true
}

// The client painted a rectangle of its shared buffer (window coordinates): only that rectangle is dirty (the same rectangle
// `wig.blit` names after its copy). Returns the pixels named.
fn damage_rect(state: u64, i: u64, x: u64, y: u64, w: u64, h: u64) -> u64 {
    if !wmbase.valid(state, i) || w == 0 || h == 0 {
        return 0
    }
    let ww: u64 = wmlayout.wg(state, i, wmlayout.W_W)
    let wh: u64 = wmlayout.wg(state, i, wmlayout.W_H)
    if x >= ww || y >= wh {
        return 0
    }
    var bw: u64 = w
    var bh: u64 = h
    if x + bw > ww {
        bw = ww - x
    }
    if y + bh > wh {
        bh = wh - y
    }
    let sx: i64 = wmbase.win_x(state, i) + wmbase.inx(state, i) as i64 + x as i64
    let sy: i64 = wmbase.win_y(state, i) + wmbase.iny(state, i) as i64 + y as i64
    if wmlayout.gs(state, wmlayout.S_PL_ON) != 0 {
        pl_damage(state)
    }
    if win_hidden(state, i) && !fb.nohidskip_an(state) {
        return bw * bh
    }
    wmbase.damage_ex(state, sx, sy, sx + bw as i64, sy + bh as i64, i + 1)
    wmlayout.ss(state, wmlayout.S_SH_DMG, wmlayout.gs(state, wmlayout.S_SH_DMG) + 1)
    wmlayout.ss(state, wmlayout.S_SH_PX, wmlayout.gs(state, wmlayout.S_SH_PX) + bw * bh)
    return bw * bh
}

// THE WINDOW TABLE PAGE. One 4 KiB frame the kernel keeps up to date and any process may map READ-ONLY (WM_TABLE): who owns which
// window, where it stands, in which layer and order, with which flags, and where its pixels are. The compositor in ring 3 (`wmd`, S4)
// reads it; nobody can write it (the object is SMF_RO), so a program cannot forge an owner. All words are u64, little endian:
//
//   word 0   magic 0x42415457 ("WTAB") | version 1 << 32
//   word 1   sequence number: odd while the kernel writes, even when the page is consistent (read it before and after; equal and even = good)
//   word 2   number of rows         word 3  screen width | height << 32       word 4  focused window id (0 = none)
//   word 5   number of frames composed (`composites`) when the table was written      word 6  words per row (12)      word 7  1 while the screen is locked
//   from word 16, one row per used window, TAB_ROW words each:
//     +0 id | slot << 32        +1 owner (task number)    +2 x (outer, i64)   +3 y (outer, i64)
//     +4 client width           +5 client height          +6 z | layer << 16 | kind << 24
//     +7 flags (W_FLAGS)        +8 inx | iny << 32 (client area inside the frame)
//     +9 shared object + 1 (0 = the buffer is the server's own)      +10 row length in octets
//     +11 opacity (W_OPAC) in the low 32 bits; bit 32 = PLAIN: right now the server paints this window's client area as a plain copy of its
//         buffer (no opening/closing motion, no lifting, no blur, no glass, no translucency) -- the only windows a shadow compositor can
//         reproduce exactly before the chrome and the effects move to it (S6); bit 33 = SHADOW: the window has a shadow under its frame (S6a)
//   words 8 and 9 (S6a): the shadow numbers, see `tab_publish`
const TAB_MAGIC: u64 = 0x42415457
const TAB_ROW: u64 = 12
const TAB_HEAD: u64 = 16

// Does `compose` paint the client area of window `i` as a plain copy of its buffer right now? (The same decisions `paint_win` takes.)
fn tab_plain(state: u64, i: u64) -> bool {
    if win_hidden(state, i) {
        return false
    }
    if wmlayout.wg(state, i, wmlayout.W_ANK) != 0 || wmanim.drag_paint_on(state, i) || wmblur.blur_will(state, i) {
        return false
    }
    var alpha: u64 = wmbase.form_or(state, wmlayout.FM_WIN_ALPHA, 100)
    // a window with a frame is painted with the window alpha only (`paint_win`, the framed branch): no opacity, no full-screen rule
    if wmbase.deko(state, i) {
        return alpha >= 100
    }
    let pw: u64 = wmbase.panel_win(state)
    if pw < wmbase.MAX_WIN && i == pw {
        alpha = wmbase.form_or(state, wmlayout.FM_TB_ALPHA, 100)
    }
    let op: u64 = wmblur.win_opac(state, i)
    if op < 255 {
        let opp: u64 = op *% 100 / 255
        if opp < alpha {
            alpha = opp
        }
    }
    if wmblur.deckt_schirm(state, i) {
        alpha = 100
    }
    return alpha >= 100
}

fn tab_object(state: u64) -> u64 {
    if wmlayout.gs(state, wmlayout.S_TABI) != 0 {
        return wmlayout.gs(state, wmlayout.S_TABI) - 1
    }
    let f: u64 = mem.frame_alloc(state)
    if f == 0 {
        return unixsock.USHM_MAX
    }
    var o: u64 = 0
    while o < mem.FRAME_SIZE / 8 {
        __mmio_write64((f + o * 8) as *mut u64, 0)
        o = o + 1
    }
    let k: u64 = unixsock.shm_wrap(state, f, 1, unixsock.SMF_RO)
    if k >= unixsock.USHM_MAX {
        mem.frame_free(state, f)
        return unixsock.USHM_MAX
    }
    wmlayout.ss(state, wmlayout.S_TABF, f)
    wmlayout.ss(state, wmlayout.S_TABI, k + 1)
    tab_publish(state)
    return k
}

// S6b: THE CHROME PAGE. A second read-only frame, ROOT ONLY (WM_TABLE with argument 1): everything the compositor in ring 3 needs to paint the frame, the
// title bar, the caption buttons and the title text of a framed window exactly as `paint_win` does -- the colours of the decoration, the measures,
// the hover state and the titles. Titles are private (the window table page has none), so this page is for the compositor only and its title
// words are zero while the screen is locked. Written by `tab_publish` inside the same odd/even bracket as the window table, so a reader that
// sees the table consistent sees this page consistent too. All words u64:
//   0 magic "WCHR" | 1 << 32      1 the table's sequence number it was written with      2 valid (1)
//   3, 4, 5  fb.rgb(255,0,0), fb.rgb(0,255,0), fb.rgb(0,0,255): the compositor refuses to compose when they are not 0xFF0000, 0xFF00, 0xFF
//   6..13    the colours (0xRRGGBB): frame, title, text, frame (focused), title (focused), text (focused), close, close mark
//   14 radius  15 gradient  16 caption style (0 = old red close box)  17 border  18 title height (frame + bar + line)  19 caption button width
//   20 ui scale  21 decoration alpha (0..255)  22 hovered caption button ((slot * 4 + n) + 1)  23 held caption button (same coding)
//   24 ui font  25 ui font size  26 title padding  27 title baseline offset from the window top (i64)  28 netmark width | height << 16
//   29 1 when the title font exists (the server paints a title only then)
//   from word 32: four words of title per table row (31 octets and a zero);  from word 192: one word per table row: the netmark (1..3) or 0
const CHR_MAGIC: u64 = 0x52484357
const CHR_TITLE: u64 = 32
const CHR_MARK: u64 = 192

fn chrome_object(state: u64) -> u64 {
    // the table first: the chrome page is written by `tab_publish`, which runs only once the table exists
    let kt: u64 = tab_object(state)
    if kt >= unixsock.USHM_MAX {
        return kt
    }
    if wmlayout.gs(state, wmlayout.S_CHRI) != 0 {
        return wmlayout.gs(state, wmlayout.S_CHRI) - 1
    }
    let f: u64 = mem.frame_alloc(state)
    if f == 0 {
        return unixsock.USHM_MAX
    }
    var o: u64 = 0
    while o < mem.FRAME_SIZE / 8 {
        __mmio_write64((f + o * 8) as *mut u64, 0)
        o = o + 1
    }
    let k: u64 = unixsock.shm_wrap(state, f, 1, unixsock.SMF_RO)
    if k >= unixsock.USHM_MAX {
        mem.frame_free(state, f)
        return unixsock.USHM_MAX
    }
    wmlayout.ss(state, wmlayout.S_CHRF, f)
    wmlayout.ss(state, wmlayout.S_CHRI, k + 1)
    tab_publish(state)
    return k
}

// Write the table (only when somebody asked for it once: `tab_object`). Called by `compose` before the frame.
fn tab_publish(state: u64) {
    let f: u64 = wmlayout.gs(state, wmlayout.S_TABF)
    if f == 0 {
        return
    }
    let seq: u64 = wmlayout.gs(state, wmlayout.S_TABSEQ) + 1
    wmlayout.ss(state, wmlayout.S_TABSEQ, seq)
    arch.atomic_store(f + 8, seq) // odd: being written (a locked store: a full barrier, also on a core that reorders)
    var n: u64 = 0
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmlayout.wg(state, i, wmlayout.W_USED) != 0 {
            let r: u64 = TAB_HEAD + n * TAB_ROW
            wmanim.tw(f, r + 0, wmlayout.wg(state, i, wmlayout.W_ID) | (i << 32))
            wmanim.tw(f, r + 1, wmlayout.wg(state, i, wmlayout.W_OWNER))
            wmanim.tw(f, r + 2, wmlayout.wg(state, i, wmlayout.W_X))
            wmanim.tw(f, r + 3, wmlayout.wg(state, i, wmlayout.W_Y))
            wmanim.tw(f, r + 4, wmlayout.wg(state, i, wmlayout.W_W))
            wmanim.tw(f, r + 5, wmlayout.wg(state, i, wmlayout.W_H))
            wmanim.tw(f, r + 6, wmlayout.wg(state, i, wmlayout.W_Z) | (wmlayout.wg(state, i, wmlayout.W_LAYER) << 16) | (wmlayout.wg(state, i, wmlayout.W_KIND) << 24))
            wmanim.tw(f, r + 7, wmlayout.wg(state, i, wmlayout.W_FLAGS))
            wmanim.tw(f, r + 8, wmbase.inx(state, i) | (wmbase.iny(state, i) << 32))
            wmanim.tw(f, r + 9, wmlayout.wg(state, i, wmlayout.W_SHM))
            wmanim.tw(f, r + 10, wmlayout.wg(state, i, wmlayout.W_W) * 4)
            var plain: u64 = 0
            if tab_plain(state, i) {
                plain = 1
            }
            // S6a: bit 33 = this window gets a shadow under its frame (a framed window that is on the screen): `paint_win` calls `paint_shadow`
            var shad: u64 = 0
            if wmbase.deko(state, i) && !win_hidden(state, i) {
                shad = 1
            }
            wmanim.tw(f, r + 11, (wmlayout.wg(state, i, wmlayout.W_OPAC) & 0xFFFFFFFF) | (plain << 32) | (shad << 33))
            // S6b: the title and the netmark of this row go to the chrome page (never while the screen is locked)
            let cf: u64 = wmlayout.gs(state, wmlayout.S_CHRF)
            if cf != 0 {
                var t0: u64 = 0
                var t1: u64 = 0
                var t2: u64 = 0
                var t3: u64 = 0
                var mk: u64 = 0
                if !wmgate.sperre_an(state) {
                    let tp: u64 = state + wmlayout.wat(i) + wmlayout.W_TITLE
                    t0 = __mmio_read64(tp as *mut u64)
                    t1 = __mmio_read64((tp + 8) as *mut u64)
                    t2 = __mmio_read64((tp + 16) as *mut u64)
                    t3 = __mmio_read64((tp + 24) as *mut u64) & 0x00FFFFFFFFFFFFFF
                    let sicht: u64 = netview.view_of(state, wmbase.win_owner(state, i))
                    if sicht != netview.V_REAL && sicht <= 3 {
                        mk = sicht
                    }
                }
                wmanim.tw(cf, CHR_TITLE + n * 4, t0)
                wmanim.tw(cf, CHR_TITLE + n * 4 + 1, t1)
                wmanim.tw(cf, CHR_TITLE + n * 4 + 2, t2)
                wmanim.tw(cf, CHR_TITLE + n * 4 + 3, t3)
                wmanim.tw(cf, CHR_MARK + n, mk)
            }
            n = n + 1
        }
        i = i + 1
    }
    wmanim.tw(f, 0, TAB_MAGIC | (1 << 32))
    wmanim.tw(f, 2, n)
    wmanim.tw(f, 3, wmlayout.gs(state, wmlayout.S_SW) | (wmlayout.gs(state, wmlayout.S_SH) << 32))
    var fo: u64 = 0
    let fi: u64 = wmlayout.gs(state, wmlayout.S_FOCUS)
    if fi != 0 {
        fo = wmlayout.wg(state, fi - 1, wmlayout.W_ID)
    }
    wmanim.tw(f, 4, fo)
    // S6a: what the compositor needs to paint the window shadow exactly (the same numbers `shadow_build` takes, already scaled by the window
    // alpha): word 8 = strength of the focused window | its reach << 8 | strength of the others << 16 | their reach << 24 | corner radius << 32;
    // word 9 = shadow colour (rgb24) | 1 << 32 (the words are valid) | 1 << 33 when the old ring painter is on
    var sold: u64 = 0
    if wmlayout.gs(state, wmlayout.S_SHOLD) != 0 {
        sold = 1
    }
    wmanim.tw(f, 8, wmshadow.shadow_staerke(state, wmlayout.FM_SHADOW) | (wmgeom.form(state, wmlayout.FM_SHADOW_R) << 8) | (wmshadow.shadow_staerke(state, wmlayout.FM_SHADOW2) << 16)
        | (wmgeom.form(state, wmlayout.FM_SHADOW_R2) << 24) | (wmgeom.form(state, wmlayout.FM_RADIUS) << 32))
    wmanim.tw(f, 9, wmbase.rgb24(state, wmgeom.form(state, wmlayout.FM_SHADOW_C)) | (1 << 32) | (sold << 33))
    // S6b: the numbers of the chrome (see `chrome_object`)
    let cf2: u64 = wmlayout.gs(state, wmlayout.S_CHRF)
    if cf2 != 0 {
        wmanim.tw(cf2, 0, CHR_MAGIC | (1 << 32))
        wmanim.tw(cf2, 2, 1)
        wmanim.tw(cf2, 3, fb.rgb(state, 255, 0, 0))
        wmanim.tw(cf2, 4, fb.rgb(state, 0, 255, 0))
        wmanim.tw(cf2, 5, fb.rgb(state, 0, 0, 255))
        wmanim.tw(cf2, 6, wmbase.deco_rgb(state, wmlayout.DK_FRAME))
        wmanim.tw(cf2, 7, wmbase.deco_rgb(state, wmlayout.DK_TITLE))
        wmanim.tw(cf2, 8, wmbase.deco_rgb(state, wmlayout.DK_TEXT))
        wmanim.tw(cf2, 9, wmbase.deco_rgb(state, wmlayout.DK_FRAME_ON))
        wmanim.tw(cf2, 10, wmbase.deco_rgb(state, wmlayout.DK_TITLE_ON))
        wmanim.tw(cf2, 11, wmbase.deco_rgb(state, wmlayout.DK_TEXT_ON))
        wmanim.tw(cf2, 12, wmbase.deco_rgb(state, wmlayout.DK_CLOSE))
        wmanim.tw(cf2, 13, wmbase.deco_rgb(state, wmlayout.DK_CLOSE_MARK))
        wmanim.tw(cf2, 14, wmgeom.form(state, wmlayout.FM_RADIUS))
        wmanim.tw(cf2, 15, wmgeom.form(state, wmlayout.FM_GRAD))
        wmanim.tw(cf2, 16, wmgeom.form(state, wmlayout.FM_CAPTION))
        wmanim.tw(cf2, 17, wmgeom.border(state))
        wmanim.tw(cf2, 18, wmgeom.title_h(state))
        wmanim.tw(cf2, 19, wmgeom.cap_w(state))
        wmanim.tw(cf2, 20, wmgeom.uisc(state))
        wmanim.tw(cf2, 21, deco_alpha(state))
        wmanim.tw(cf2, 22, wmlayout.gs(state, wmlayout.S_CAPHOV))
        wmanim.tw(cf2, 23, wmlayout.gs(state, wmlayout.S_CAPDOWN))
        let fu: u64 = wmlayout.gs(state, wmlayout.S_FONT_UI)
        wmanim.tw(cf2, 24, fu)
        wmanim.tw(cf2, 25, wmlayout.gs(state, wmlayout.S_PX_UI))
        wmanim.tw(cf2, 26, wmgeom.title_pad(state))
        var tbase: i64 = 0
        if fu < ttf.MAX_FONTS {
            tbase = wmgeom.title_base(state, fu)
        }
        wmanim.tw(cf2, 27, tbase as u64)
        wmanim.tw(cf2, 28, netmark.W | (netmark.H << 16))
        var fok: u64 = 0
        if fu < ttf.MAX_FONTS {
            fok = 1
        }
        wmanim.tw(cf2, 29, fok)
    }
    wmlayout.ss(state, wmlayout.S_TAB_N, wmlayout.gs(state, wmlayout.S_TAB_N) + 1)
    wmanim.tw(f, 5, wmlayout.gs(state, wmlayout.S_COMPOSITES))
    wmanim.tw(f, 6, TAB_ROW)
    var lk: u64 = 0
    if wmgate.sperre_an(state) {
        lk = 1
    }
    wmanim.tw(f, 7, lk)
    let cf3: u64 = wmlayout.gs(state, wmlayout.S_CHRF)
    if cf3 != 0 {
        wmanim.tw(cf3, 1, seq + 1)
    }
    arch.atomic_store(f + 8, seq + 1) // even: consistent
    wmlayout.ss(state, wmlayout.S_TABSEQ, seq + 1)
}

// numbers for the F12 line and the tests: 0 attached, 1 damage calls, 2 pixels named, 3 rows blitted, 4 pixels blitted, 5 detached, 6 table pages
fn sh_stat(state: u64, k: u64) -> u64 {
    if k == 0 {
        return wmlayout.gs(state, wmlayout.S_SH_ATT)
    }
    if k == 1 {
        return wmlayout.gs(state, wmlayout.S_SH_DMG)
    }
    if k == 2 {
        return wmlayout.gs(state, wmlayout.S_SH_PX)
    }
    if k == 3 {
        return wmlayout.gs(state, wmlayout.S_BL_N)
    }
    if k == 4 {
        return wmlayout.gs(state, wmlayout.S_BL_PX)
    }
    if k == 5 {
        return wmlayout.gs(state, wmlayout.S_SH_DET)
    }
    return wmlayout.gs(state, wmlayout.S_TAB_N)
}

// ===========================================================================================================================
// COMPOSITOR S5 (docs/COMPOSITOR.md section 4): THE COMPOSITOR IN RING 3 TAKES THE SCAN-OUT, THE KERNEL KEEPS A WATCHDOG
//
// `wmd` (kernel/user/wmd.fi) attaches with WM_COMP. From then on `compose` still paints the whole picture into the draw target,
// but it does NOT push it to the card: the finished rectangle is HANDED OVER (cp_hand) and the compositor is woken (cp_kick).
// The compositor calls WM_COMP / CP_PRESENT, and only then does the card get the rectangle (cp_flush_locked) -- the card belongs to the
// kernel, the decision WHEN a frame is shown belongs to ring 3. What stays in the kernel on purpose: the framebuffer and the flip, the
// lock (while it stands the compositor gets no input and no key), the trusted dialog, and THE WATCHDOG:
//
//   * a rectangle that waits longer than CP_LIMIT_MS for the compositor is pushed to the card by the kernel (a MISS);
//   * CP_MAXMISS misses in a row, or the death of the task, detach the compositor: the kernel presents every frame itself again,
//     exactly as before S5 (that is the fall-back path, it is the old code);
//   * the word `nowatch` switches the watchdog off (the counter-proof: a compositor that hangs then freezes the screen);
//   * the word `nocomp` refuses the attach (the counter-proof: the kernel presents, the compositor's presents stay at 0).
//
// The INPUT COPY RING: the compositor needs pointer and key events for chrome (move, hover, Alt+Tab). The kernel keeps routing input
// itself (`darf`, the lock) and writes a COPY into a read-only page (WM_COMP / CP_PAGE): pointer moves, button changes, and keys ONLY
// while Alt or the Windows key is held (a shortcut) -- the code of an ordinary key is never copied, so a password typed into a window is
// not seen. While the screen is locked or the trusted dialog is up NOTHING is copied.
//
// The compositor page (u64 words): 0 magic | version << 32, 1 attached (0 / 1), 2 events written (head), 3 events refused (lock / dialog),
// 4 frames handed over, 5 frames presented, 6 a rectangle waits, 7..10 its x0 y0 x1 y1, 11 screen locked, 12 cycles per millisecond.
// From word 16 a ring of CP_RING entries of 4 words: 0 type | mods << 8 | buttons << 16 | (index + 1) << 32, 1 x | y << 32, 2 key code,
// 3 time stamp counter at the interrupt. A reader keeps its own tail; an entry is good when word 0 >> 32 == its index + 1 before and after.
const CP_MAGIC: u64 = 0x504D4357
const CP_LIMIT_MS: u64 = 50
const CP_MAXMISS: u64 = 3
const CP_RING: u64 = 64
const CP_RING_AT: u64 = 16
const CP_NOT: u64 = 0xFFFFFFFFFFFFFFFF // the caller is not the attached compositor
const CP_BUSY: u64 = 0xFFFFFFFFFFFFFFFE // the compose lock did not come free in time: try again
const CP_EV_MOVE: u64 = 1
const CP_EV_BTN: u64 = 2
const CP_EV_KEY: u64 = 3

fn cp_on(state: u64) -> bool {
    return wmlayout.gs(state, wmlayout.S_CP_TASK) != 0
}

fn cp_lock(state: u64) -> bool {
    let lk: u64 = state + kstate.WM_OFF + wmlayout.S_CLOCK
    var n: u64 = 0
    while n < 200000 {
        let was: u64 = __atomic_swap(lk as *mut u64, 0 as u64, 1 as u64)
        if was == 0 {
            return true
        }
        n = n + 1
    }
    return false
}

fn cp_unlock(state: u64) {
    arch.atomic_store(state + kstate.WM_OFF + wmlayout.S_CLOCK, 0)
}

// the compositor page: made at the first WM_COMP / CP_PAGE, read-only for everybody (SMF_RO)
fn cp_page_object(state: u64) -> u64 {
    if wmlayout.gs(state, wmlayout.S_CP_PAGEI) != 0 {
        return wmlayout.gs(state, wmlayout.S_CP_PAGEI) - 1
    }
    let f: u64 = mem.frame_alloc(state)
    if f == 0 {
        return unixsock.USHM_MAX
    }
    var o: u64 = 0
    while o < mem.FRAME_SIZE / 8 {
        __mmio_write64((f + o * 8) as *mut u64, 0)
        o = o + 1
    }
    let k: u64 = unixsock.shm_wrap(state, f, 1, unixsock.SMF_RO)
    if k >= unixsock.USHM_MAX {
        mem.frame_free(state, f)
        return unixsock.USHM_MAX
    }
    wmlayout.ss(state, wmlayout.S_CP_PAGEF, f)
    wmlayout.ss(state, wmlayout.S_CP_PAGEI, k + 1)
    wmanim.tw(f, 0, CP_MAGIC | (1 << 32))
    wmanim.tw(f, 12, time.khz(state))
    cp_sync(state)
    return k
}

// the header words of the page (no sequence number: every word is a single aligned store)
fn cp_sync(state: u64) {
    let f: u64 = wmlayout.gs(state, wmlayout.S_CP_PAGEF)
    if f == 0 {
        return
    }
    var on: u64 = 0
    if cp_on(state) {
        on = 1
    }
    wmanim.tw(f, 1, on)
    wmanim.tw(f, 3, wmlayout.gs(state, wmlayout.S_CP_EVREF))
    wmanim.tw(f, 4, wmlayout.gs(state, wmlayout.S_CP_FSEQ))
    wmanim.tw(f, 5, wmlayout.gs(state, wmlayout.S_CP_ASEQ))
    wmanim.tw(f, 6, wmlayout.gs(state, wmlayout.S_CP_PEND))
    wmanim.tw(f, 7, wmlayout.gs(state, wmlayout.S_CP_X0))
    wmanim.tw(f, 8, wmlayout.gs(state, wmlayout.S_CP_Y0))
    wmanim.tw(f, 9, wmlayout.gs(state, wmlayout.S_CP_X1))
    wmanim.tw(f, 10, wmlayout.gs(state, wmlayout.S_CP_Y1))
    var lk: u64 = 0
    if wmgate.sperre_an(state) {
        lk = 1
    }
    wmanim.tw(f, 11, lk)
}

// ================== W-J (17.10.2026): INPUT -> PICTURE LATENCY
//
// Boss: "every interaction feels slow". The desktop loop (kgui wait_wm) slept `sleep_ticks(1)` + `idle_wait`: a round every 10-20 ms,
// so a pointer packet waited up to 20 ms BEFORE wm.poll even saw it (USB HID is polled in that loop), then up to one more round for
// the frame. Two clocks, printed with the word `phases` on every F12 as `wm: lat ...` (running since the last F12):
//   gap*: time between two input polls while the desktop is ACTIVE (input or a frame in the last 200 ms). A packet arrives at a random
//         point of a gap, so the mean wait before the poll is  sum(gap^2) / (2 * sum(gap))  -> `gapwait`.
//   lat*: from wm.poll consuming pointer input to the frame being on the card (compose + present of the same round).
// Input -> picture (mean) = gapwait + latmean. The fast path (ACTIVE only; `nolatfix` = old loop): rounds of ~1 ms (yield-spin),
// composes at most every LJ_MIN_US after the last painted frame, the first frame after rest is never delayed.
const LJ_ACTIVE_US: u64 = 200000
const LJ_MIN_US: u64 = 6000
static mut lj_last_round: u64 = 0
static mut lj_act: u64 = 0
// r1049: last INPUT (pointer or key). Painted frames extend the active stretch only within LJ_CHAIN_US of it, so a timer frame at rest
// (terminal cursor blink, clock) never starts a 200 ms yield-spin (it did: 45 % of the core at idle).
static mut lj_inp: u64 = 0
const LJ_CHAIN_US: u64 = 1000000
static mut lj_in0: u64 = 0
static mut lj_in_comp: u64 = 0
static mut lj_last_comp: u64 = 0
static mut lj_comp_tsc: u64 = 0
// W-L: pointer-only frames (blit of the cursor box, cp_lat) never bump S_COMPOSITES -- the poll -> picture clock stayed open until some unrelated
// compose and read 60-180 ms on 2+ CPUs. `lj_cp_n` counts every frame that reached the card; lj_in_comp / lj_done compare against composes + it.
static mut lj_cp_n: u64 = 0
static mut lj_gap: [u64; 8] = [0 as u64; 8]
static mut lj_lat: [u64; 8] = [0 as u64; 8]

fn lj_us(state: u64, d: u64) -> u64 {
    let kh: u64 = time.khz(state)
    if kh < 1000 {
        return 0
    }
    return d / (kh / 1000)
}

fn lj_active(state: u64) -> bool {
    if lj_act == 0 {
        return false
    }
    let now: u64 = time.tsc()
    if now < lj_act {
        return true
    }
    return lj_us(state, now - lj_act) < LJ_ACTIVE_US
}

// called once per desktop round right after the input poll
fn lj_round(state: u64) {
    let now: u64 = time.tsc()
    if lj_last_round != 0 && now > lj_last_round && lj_active(state) {
        let g: u64 = lj_us(state, now - lj_last_round)
        lj_gap[0] = lj_gap[0] + 1
        lj_gap[1] = lj_gap[1] + g
        lj_gap[2] = lj_gap[2] + g * g
        if g > lj_gap[3] {
            lj_gap[3] = g
        }
        if g > 8000 {
            lj_gap[4] = lj_gap[4] + 1
        }
        if g > 16000 {
            lj_gap[5] = lj_gap[5] + 1
        }
        if g > 33000 {
            lj_gap[6] = lj_gap[6] + 1
        }
    }
    lj_last_round = now
}

// wm.poll consumed pointer input (move / button): start the poll -> picture clock, keep the fast path on
fn lj_input(state: u64) {
    let now: u64 = time.tsc()
    lj_act = now
    lj_inp = now
    if lj_in0 == 0 {
        lj_in0 = now
        lj_in_comp = wmlayout.gs(state, wmlayout.S_COMPOSITES) + lj_cp_n
    }
}

// after compose + present of a round: a frame was painted -> close the clock
fn lj_done(state: u64) {
    let c: u64 = wmlayout.gs(state, wmlayout.S_COMPOSITES)
    let now: u64 = time.tsc()
    if c != lj_last_comp {
        lj_last_comp = c
        lj_comp_tsc = now
        // r1049: a frame extends the active stretch only while the last input is recent (animation after a click / key), never from rest
        if lj_inp != 0 && (now < lj_inp || lj_us(state, now - lj_inp) < LJ_CHAIN_US) {
            lj_act = now
        }
    }
    if lj_in0 != 0 && c + lj_cp_n != lj_in_comp {
        if now > lj_in0 {
            let l: u64 = lj_us(state, now - lj_in0)
            // an input that changed nothing visible waits for some unrelated frame: ignore those (> 250 ms)
            if l < 250000 {
                lj_lat[0] = lj_lat[0] + 1
                lj_lat[1] = lj_lat[1] + l
                if l > lj_lat[2] {
                    lj_lat[2] = l
                }
                if l > 16000 {
                    lj_lat[3] = lj_lat[3] + 1
                }
                if l > 33000 {
                    lj_lat[4] = lj_lat[4] + 1
                }
            }
        }
        lj_in0 = 0
    }
}

// the fast path may compose now? (rest: always; active: not sooner than LJ_MIN_US after the last painted frame)
fn lj_may_compose(state: u64) -> bool {
    if kstate.mode_on(state, kstate.M_NOLATFIX) {
        return true
    }
    if !lj_active(state) {
        return true
    }
    let now: u64 = time.tsc()
    if lj_comp_tsc == 0 || now < lj_comp_tsc {
        return true
    }
    return lj_us(state, now - lj_comp_tsc) >= LJ_MIN_US
}

fn lj_fast(state: u64) -> bool {
    if kstate.mode_on(state, kstate.M_NOLATFIX) {
        return false
    }
    return lj_active(state)
}

fn lj_say_reset(state: u64) {
    var s_l: [u8; 14] = "wm: lat gapn=\0"
    var s_1: [u8; 10] = " gapmean=\0"
    var s_2: [u8; 10] = " gapwait=\0"
    var s_3: [u8; 9] = " gapmax=\0"
    var s_4: [u8; 7] = " gap8=\0"
    var s_5: [u8; 8] = " gap16=\0"
    var s_6: [u8; 8] = " gap33=\0"
    var s_7: [u8; 8] = " latn=\0\0"
    var s_8: [u8; 10] = " latmean=\0"
    var s_9: [u8; 9] = " latmax=\0"
    var s_a: [u8; 8] = " lat16=\0"
    var s_b: [u8; 8] = " lat33=\0"
    let n: u64 = lj_gap[0]
    serial.puts((&s_l[0]) as u64)
    serial.dec(n)
    serial.puts((&s_1[0]) as u64)
    if n != 0 {
        serial.dec(lj_gap[1] / n)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_2[0]) as u64)
    if lj_gap[1] != 0 {
        serial.dec(lj_gap[2] / (2 * lj_gap[1]))
    } else {
        serial.dec(0)
    }
    serial.puts((&s_3[0]) as u64)
    serial.dec(lj_gap[3])
    serial.puts((&s_4[0]) as u64)
    serial.dec(lj_gap[4])
    serial.puts((&s_5[0]) as u64)
    serial.dec(lj_gap[5])
    serial.puts((&s_6[0]) as u64)
    serial.dec(lj_gap[6])
    let m: u64 = lj_lat[0]
    serial.puts((&s_7[0]) as u64)
    serial.dec(m)
    serial.puts((&s_8[0]) as u64)
    if m != 0 {
        serial.dec(lj_lat[1] / m)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_9[0]) as u64)
    serial.dec(lj_lat[2])
    serial.puts((&s_a[0]) as u64)
    serial.dec(lj_lat[3])
    serial.puts((&s_b[0]) as u64)
    serial.dec(lj_lat[4])
    serial.nl()
    var z: u64 = 0
    while z < 8 {
        lj_gap[z as usize] = 0
        lj_lat[z as usize] = 0
        z = z + 1
    }
}

// the first pointer movement that has not reached the card yet (the start of the input-to-picture clock)
fn cp_in(state: u64) {
    if wmlayout.gs(state, wmlayout.S_CP_IN0) == 0 {
        wmlayout.ss(state, wmlayout.S_CP_IN0, time.tsc())
    }
}

fn cp_stat3(state: u64, at: u64, us: u64) {
    wmlayout.ss(state, at, wmlayout.gs(state, at) + 1)
    wmlayout.ss(state, at + 8, wmlayout.gs(state, at + 8) + us)
    if us > wmlayout.gs(state, at + 16) {
        wmlayout.ss(state, at + 16, us)
    }
}

// the frame reached the card: close the clocks. `by_comp` says who put it there.
fn cp_lat(state: u64, by_comp: bool) {
    lj_cp_n = lj_cp_n + 1
    let kh: u64 = time.khz(state)
    if kh < 1000 {
        wmlayout.ss(state, wmlayout.S_CP_IN0, 0)
        return
    }
    let now: u64 = time.tsc()
    let t0: u64 = wmlayout.gs(state, wmlayout.S_CP_IN0)
    wmlayout.ss(state, wmlayout.S_CP_IN0, 0)
    if t0 != 0 && now > t0 {
        if by_comp {
            cp_stat3(state, wmlayout.S_CP_WLAT, (now - t0) / (kh / 1000))
        } else {
            cp_stat3(state, wmlayout.S_CP_KLAT, (now - t0) / (kh / 1000))
        }
    }
}

// A finished rectangle (compose holds the lock): it waits for the compositor instead of going to the card.
fn cp_hand(state: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if wmlayout.gs(state, wmlayout.S_CP_PEND) == 0 {
        wmlayout.ss(state, wmlayout.S_CP_X0, x0)
        wmlayout.ss(state, wmlayout.S_CP_Y0, y0)
        wmlayout.ss(state, wmlayout.S_CP_X1, x1)
        wmlayout.ss(state, wmlayout.S_CP_Y1, y1)
        wmlayout.ss(state, wmlayout.S_CP_PEND, 1)
        wmlayout.ss(state, wmlayout.S_CP_T0, time.tsc())
    } else {
        if x0 < wmlayout.gs(state, wmlayout.S_CP_X0) {
            wmlayout.ss(state, wmlayout.S_CP_X0, x0)
        }
        if y0 < wmlayout.gs(state, wmlayout.S_CP_Y0) {
            wmlayout.ss(state, wmlayout.S_CP_Y0, y0)
        }
        if x1 > wmlayout.gs(state, wmlayout.S_CP_X1) {
            wmlayout.ss(state, wmlayout.S_CP_X1, x1)
        }
        if y1 > wmlayout.gs(state, wmlayout.S_CP_Y1) {
            wmlayout.ss(state, wmlayout.S_CP_Y1, y1)
        }
    }
    wmlayout.ss(state, wmlayout.S_CP_NEW, 1)
    wmlayout.ss(state, wmlayout.S_CP_NHAND, wmlayout.gs(state, wmlayout.S_CP_NHAND) + 1)
}

// Wake the compositor, once per `compose`, after everything was handed over (lock held).
fn cp_kick(state: u64) {
    if wmlayout.gs(state, wmlayout.S_CP_TASK) == 0 || wmlayout.gs(state, wmlayout.S_CP_NEW) == 0 {
        return
    }
    wmlayout.ss(state, wmlayout.S_CP_NEW, 0)
    wmlayout.ss(state, wmlayout.S_CP_FSEQ, wmlayout.gs(state, wmlayout.S_CP_FSEQ) + 1)
    cp_sync(state)
    sched.poll_kick_one(state, wmlayout.gs(state, wmlayout.S_CP_TASK) - 1)
}

// Push the waiting rectangle to the card (lock held): the one place where a handed-over frame becomes visible. Returns its pixels.
fn cp_flush_locked(state: u64, by_comp: bool) -> u64 {
    if wmlayout.gs(state, wmlayout.S_CP_PEND) == 0 {
        return 0
    }
    let x0: u64 = wmlayout.gs(state, wmlayout.S_CP_X0)
    let y0: u64 = wmlayout.gs(state, wmlayout.S_CP_Y0)
    let x1: u64 = wmlayout.gs(state, wmlayout.S_CP_X1)
    let y1: u64 = wmlayout.gs(state, wmlayout.S_CP_Y1)
    let t0: u64 = wmlayout.gs(state, wmlayout.S_CP_T0)
    wmlayout.ss(state, wmlayout.S_CP_PEND, 0)
    wmlayout.ss(state, wmlayout.S_CP_T0, 0)
    var area: u64 = 0
    var pl_t0: u64 = 0
    if wmlayout.gs(state, wmlayout.S_PL_ON) != 0 {
        pl_t0 = time.tsc()
    }
    if x1 > x0 && y1 > y0 {
        if wmlayout.gs(state, wmlayout.S_VSYNC) != 0 {
            // the same two ways `present` takes
            if fb.flip_on(state) {
                fb.flush_rect(state, 0, 0, wmlayout.gs(state, wmlayout.S_SW), wmlayout.gs(state, wmlayout.S_SH))
                fb.flip(state)
            } else {
                fb.flush_rect(state, x0, y0, x1 - x0, y1 - y0)
            }
            wmlayout.ss(state, wmlayout.S_PRESENTS, wmlayout.gs(state, wmlayout.S_PRESENTS) + 1)
            fb.frame_done(state)
        } else {
            flush_box(state, x0, y0, x1, y1)
        }
        area = (x1 - x0) * (y1 - y0)
        wmlayout.ss(state, wmlayout.S_PXSUM, wmlayout.gs(state, wmlayout.S_PXSUM) +% area)
    }
    wmlayout.ss(state, wmlayout.S_CP_ASEQ, wmlayout.gs(state, wmlayout.S_CP_FSEQ))
    if pl_t0 != 0 && x1 > x0 && y1 > y0 {
        var pl_kind: u64 = PL_F_WDOG
        if by_comp {
            pl_kind = PL_F_COMP
        }
        pl_record(state, pl_kind, x0, y0, x1, y1, pl_t0, t0)
    }
    if by_comp {
        let kh: u64 = time.khz(state)
        let now: u64 = time.tsc()
        if kh >= 1000 && t0 != 0 && now > t0 {
            cp_stat3(state, wmlayout.S_CP_HOP, (now - t0) / (kh / 1000))
        }
        wmlayout.ss(state, wmlayout.S_CP_NPRES, wmlayout.gs(state, wmlayout.S_CP_NPRES) + 1)
    }
    cp_lat(state, by_comp)
    cp_sync(state)
    return area
}

fn cp_detach_locked(state: u64, why: u64) {
    if wmlayout.gs(state, wmlayout.S_CP_TASK) == 0 {
        return
    }
    var s_cd: [u8; 29] = "wm: compositor detached why=\0"
    serial.puts((&s_cd[0]) as u64)
    serial.dec(why)
    serial.nl()
    // whatever waits goes to the card now; from the next frame on the kernel presents itself
    let _px: u64 = cp_flush_locked(state, false)
    wmlayout.ss(state, wmlayout.S_CP_TASK, 0)
    wmlayout.ss(state, wmlayout.S_CP_PID, 0)
    wmlayout.ss(state, wmlayout.S_CP_NDET, wmlayout.gs(state, wmlayout.S_CP_NDET) + 1)
    cp_sync(state)
}

// THE WATCHDOG (compose calls it with the lock held, at the start of every run, and the desktop loop runs `compose` all the time):
// a dead compositor is detached at once; a rectangle that waits longer than CP_LIMIT_MS is pushed by the kernel.
fn cp_watch(state: u64) {
    let tk: u64 = wmlayout.gs(state, wmlayout.S_CP_TASK)
    if tk == 0 {
        return
    }
    let idx: u64 = tk - 1
    let st: u64 = sched.tget(state, idx, sched.T_STATE)
    if st == sched.S_ZOMBIE || st == sched.S_FREE || sched.tget(state, idx, sched.T_PID) != wmlayout.gs(state, wmlayout.S_CP_PID) {
        cp_detach_locked(state, 1)
        return
    }
    if fb.nowatch_an(state) {
        return
    }
    if wmlayout.gs(state, wmlayout.S_CP_PEND) == 0 {
        return
    }
    let kh: u64 = time.khz(state)
    let t0: u64 = wmlayout.gs(state, wmlayout.S_CP_T0)
    let now: u64 = time.tsc()
    if kh >= 1000 && t0 != 0 && now > t0 && (now - t0) / kh >= CP_LIMIT_MS {
        let _px: u64 = cp_flush_locked(state, false)
        wmlayout.ss(state, wmlayout.S_CP_NMISS, wmlayout.gs(state, wmlayout.S_CP_NMISS) + 1)
        wmlayout.ss(state, wmlayout.S_CP_MISS, wmlayout.gs(state, wmlayout.S_CP_MISS) + 1)
        if wmlayout.gs(state, wmlayout.S_CP_MISS) >= CP_MAXMISS {
            cp_detach_locked(state, 2)
        }
    }
}


// ===========================================================================================================================
// PRESENT LOG (W-DELLFLICK, 14.10.2026): ONE RECORD PER PRESENT, OFF BY DEFAULT, ONE WORD COMPARED WHEN OFF.
//
// Why: on the real Dell (Intel I219, real GPU framebuffer, real timing) the sign-in screen flickered (middle area pale for 1-3 frames every
// 1-2 s) and no VM reproduces it. This log records, for every rectangle that reaches the card, what the VM cannot show us:
// which core composed it, which core presented it, which core made the last WM_DAMAGE call (= the core the client painted on), how long the
// hand-over waited, whether the compositor or the watchdog presented, and whether a CLIENT BUFFER CHANGED WHILE THE FRAME WAS COMPOSED.
//
// Switch: WM_COMP / CP_LOG (stride), root only: the program `presentlog` (kernel/user/presentlog.fi) does it and writes the records to
// /var/log/presentlog.txt. stride 0 = off. With the switch off, every hook is `if gs(state, S_PL_ON) != 0` -- one load, no store.
//
// The torn-buffer test: before the desktop is filled and after the last window was copied, a hash of every shared client buffer is taken
// (every stride-th 64-bit word). When the two hashes differ a client wrote into its buffer WHILE the frame was composed -- the frame holds a mix
// of two client pictures: flag TORN. Flag DMGMID: a WM_DAMAGE arrived during the compose (the client finished a picture mid-frame).
//
// The page (SMF_RO, one frame, u64 words): 0 magic | version << 32, 1 stride (0 = off), 2 head (records written), 3 ring size | words per record << 32,
// 4 cycles per ms, 5 environment bits (0 double buffered, 1 uncached, 2 page flip, 3 vsync, 4 compositor attached), 6 suspected torn presents (total),
// 7 presents logged (total). From word 16 a ring of PL_RING records of 8 words (a record is good when word 0 >> 32 == its index + 1 before AND after
// the read):
//   0 (index + 1) << 32 | flags   (bit 0 compositor presented, bit 1 watchdog presented, bit 2 TORN, bit 3 DMGMID, bit 4 several composes merged,
//                                  bit 5 painted straight on the card (no back buffer))
//   1 time stamp counter when the present began     2 x0 | y0 << 16 | x1 << 32 | y1 << 48
//   3 compose core | present core << 8 | damage core << 16 | composes << 24 | hand-over to present, microseconds << 32
//   4 compose duration (us, the longest) | present (copy) duration us << 32
//   5 hash before | hash after << 32 (of the last compose; 32 bits each)
//   6 damage calls (total, low 32 bits) | damage-to-present us << 32      7 microseconds since the previous present
const PL_MAGIC: u64 = 0x474C5250
const PL_RING: u64 = 60
const PL_AT: u64 = 16
const PL_ENT: u64 = 8
const PL_F_COMP: u64 = 1
const PL_F_WDOG: u64 = 2
const PL_F_TORN: u64 = 4
const PL_F_DMGMID: u64 = 8
const PL_F_MULTI: u64 = 16
const PL_F_DIRECT: u64 = 32

fn pl_on(state: u64) -> bool {
    return wmlayout.gs(state, wmlayout.S_PL_ON) != 0
}

// the APIC id of the core this runs on (cpuid leaf 1, ebx bits 31..24)
fn pl_core() -> u64 {
    var v: u64 = 0
    asm("push rbx\nmov eax, 1\ncpuid\nmov eax, ebx\nshr eax, 24\npop rbx",
        out("rax") & v, clobber("rcx"), clobber("rdx"))
    return (v >> 0) & 0xFF
}

// Hash of every shared client buffer (every stride-th word). Reads only; never called with the log off.
fn pl_hash(state: u64) -> u64 {
    var stride: u64 = wmlayout.gs(state, wmlayout.S_PL_ON)
    if stride == 0 {
        stride = 16
    }
    var h: u64 = 0xCBF29CE484222325
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if win_shm(state, i) != 0 && !win_hidden(state, i) {
            let b: u64 = wmlayout.wg(state, i, wmlayout.W_BUF)
            let n: u64 = wmlayout.wg(state, i, wmlayout.W_BUFBYTES) / 8
            if b != 0 {
                var k: u64 = 0
                while k < n {
                    h = (h ^ __mmio_read64((b + k * 8) as *mut u64)) *% 0x100000001B3
                    k = k + stride
                }
            }
        }
        i = i + 1
    }
    return h
}

// WM_DAMAGE hook: who finished a picture, on which core, when.
fn pl_damage(state: u64) {
    wmlayout.ss(state, wmlayout.S_PL_DSEQ, wmlayout.gs(state, wmlayout.S_PL_DSEQ) + 1)
    wmlayout.ss(state, wmlayout.S_PL_DCORE, pl_core())
    wmlayout.ss(state, wmlayout.S_PL_DTSC, time.tsc())
}

// compose_rect hooks: `pl_compose_begin` returns the hash and the damage counter; `pl_compose_end` compares.
fn pl_compose_begin(state: u64, outp: u64) {
    __mmio_write64(outp as *mut u64, pl_hash(state))
    __mmio_write64((outp + 8) as *mut u64, wmlayout.gs(state, wmlayout.S_PL_DSEQ))
    __mmio_write64((outp + 16) as *mut u64, time.tsc())
}

fn pl_compose_end(state: u64, inp: u64) {
    let hb: u64 = __mmio_read64(inp as *mut u64)
    let d0: u64 = __mmio_read64((inp + 8) as *mut u64)
    let t0: u64 = __mmio_read64((inp + 16) as *mut u64)
    let ha: u64 = pl_hash(state)
    var fl: u64 = wmlayout.gs(state, wmlayout.S_PL_FLAGS)
    if ha != hb {
        fl = fl | PL_F_TORN
    }
    if wmlayout.gs(state, wmlayout.S_PL_DSEQ) != d0 {
        fl = fl | PL_F_DMGMID
    }
    if wmlayout.gs(state, wmlayout.S_PL_NCOMP) != 0 {
        fl = fl | PL_F_MULTI
    }
    wmlayout.ss(state, wmlayout.S_PL_FLAGS, fl)
    wmlayout.ss(state, wmlayout.S_PL_NCOMP, wmlayout.gs(state, wmlayout.S_PL_NCOMP) + 1)
    wmlayout.ss(state, wmlayout.S_PL_CCORE, pl_core())
    wmlayout.ss(state, wmlayout.S_PL_HASH, (hb & 0xFFFFFFFF) | (ha << 32))
    let us: u64 = ph_us(state, t0, time.tsc())
    if us > wmlayout.gs(state, wmlayout.S_PL_CDUR) {
        wmlayout.ss(state, wmlayout.S_PL_CDUR, us)
    }
}

// the log page: made at the first CP_LOG, read-only for everybody
fn pl_page_object(state: u64) -> u64 {
    if wmlayout.gs(state, wmlayout.S_PL_PAGEI) != 0 {
        return wmlayout.gs(state, wmlayout.S_PL_PAGEI) - 1
    }
    let f: u64 = mem.frame_alloc(state)
    if f == 0 {
        return unixsock.USHM_MAX
    }
    var o: u64 = 0
    while o < mem.FRAME_SIZE / 8 {
        __mmio_write64((f + o * 8) as *mut u64, 0)
        o = o + 1
    }
    let k: u64 = unixsock.shm_wrap(state, f, 1, unixsock.SMF_RO)
    if k >= unixsock.USHM_MAX {
        mem.frame_free(state, f)
        return unixsock.USHM_MAX
    }
    wmlayout.ss(state, wmlayout.S_PL_PAGEF, f)
    wmlayout.ss(state, wmlayout.S_PL_PAGEI, k + 1)
    wmanim.tw(f, 0, PL_MAGIC | (1 << 32))
    wmanim.tw(f, 3, PL_RING | (PL_ENT << 32))
    wmanim.tw(f, 4, time.khz(state))
    return k
}

fn pl_env_bits(state: u64) -> u64 {
    var e: u64 = 0
    if fb.double_buffered(state) {
        e = e | 1
    }
    if fb.uncached(state) {
        e = e | 2
    }
    if fb.flip_on(state) {
        e = e | 4
    }
    if wmlayout.gs(state, wmlayout.S_VSYNC) != 0 {
        e = e | 8
    }
    if cp_on(state) {
        e = e | 16
    }
    return e
}

// WM_COMP / CP_LOG: root (`presentlog`) switches the log on (stride > 0) or off (0) and gets the page. CP_BUSY (0 for the caller) = switched off.
fn cp_log(state: u64, me: u64, stride: u64) -> u64 {
    // root only (WM_COMP is root only in sysgui); no compositor needed: the Dell shown the kernel path, `wmd present` is not running there
    if stride == 0 {
        wmlayout.ss(state, wmlayout.S_PL_ON, 0)
        let f0: u64 = wmlayout.gs(state, wmlayout.S_PL_PAGEF)
        if f0 != 0 {
            wmanim.tw(f0, 1, 0)
        }
        return CP_BUSY
    }
    let k: u64 = pl_page_object(state)
    if k >= unixsock.USHM_MAX {
        return k
    }
    let f: u64 = wmlayout.gs(state, wmlayout.S_PL_PAGEF)
    wmanim.tw(f, 1, stride)
    wmanim.tw(f, 5, pl_env_bits(state))
    wmlayout.ss(state, wmlayout.S_PL_FLAGS, 0)
    wmlayout.ss(state, wmlayout.S_PL_NCOMP, 0)
    wmlayout.ss(state, wmlayout.S_PL_CDUR, 0)
    wmlayout.ss(state, wmlayout.S_PL_TPREV, time.tsc())
    wmlayout.ss(state, wmlayout.S_PL_ON, stride)
    return k
}

// One record, written after the rectangle reached the card. `kind`: PL_F_COMP / PL_F_WDOG / 0 (kernel path); `t0` = the time stamp
// when the present began; `hand_t0` = when the rectangle was handed over (0 = unknown).
fn pl_record(state: u64, kind: u64, x0: u64, y0: u64, x1: u64, y1: u64, t0: u64, hand_t0: u64) {
    let f: u64 = wmlayout.gs(state, wmlayout.S_PL_PAGEF)
    if f == 0 {
        return
    }
    let t1: u64 = time.tsc()
    var fl: u64 = wmlayout.gs(state, wmlayout.S_PL_FLAGS) | kind
    if !fb.double_buffered(state) {
        fl = fl | PL_F_DIRECT
    }
    if (fl & PL_F_TORN) != 0 {
        wmlayout.ss(state, wmlayout.S_PL_NTORN, wmlayout.gs(state, wmlayout.S_PL_NTORN) + 1)
    }
    let idx: u64 = wmlayout.gs(state, wmlayout.S_PL_HEAD)
    let at: u64 = PL_AT + (idx % PL_RING) * PL_ENT
    wmanim.tw(f, at, 0)
    wmanim.tw(f, at + 1, t0)
    wmanim.tw(f, at + 2, (x0 & 0xFFFF) | ((y0 & 0xFFFF) << 16) | ((x1 & 0xFFFF) << 32) | ((y1 & 0xFFFF) << 48))
    var hop: u64 = 0
    if hand_t0 != 0 && t0 > hand_t0 {
        hop = ph_us(state, hand_t0, t0)
    }
    wmanim.tw(f, at + 3, (wmlayout.gs(state, wmlayout.S_PL_CCORE) & 0xFF) | ((pl_core() & 0xFF) << 8) | ((wmlayout.gs(state, wmlayout.S_PL_DCORE) & 0xFF) << 16)
        | ((wmlayout.gs(state, wmlayout.S_PL_NCOMP) & 0xFF) << 24) | ((hop & 0xFFFFFFFF) << 32))
    wmanim.tw(f, at + 4, (wmlayout.gs(state, wmlayout.S_PL_CDUR) & 0xFFFFFFFF) | ((ph_us(state, t0, t1) & 0xFFFFFFFF) << 32))
    wmanim.tw(f, at + 5, wmlayout.gs(state, wmlayout.S_PL_HASH))
    var dus: u64 = 0
    if wmlayout.gs(state, wmlayout.S_PL_DTSC) != 0 && t1 > wmlayout.gs(state, wmlayout.S_PL_DTSC) {
        dus = ph_us(state, wmlayout.gs(state, wmlayout.S_PL_DTSC), t1)
    }
    wmanim.tw(f, at + 6, (wmlayout.gs(state, wmlayout.S_PL_DSEQ) & 0xFFFFFFFF) | ((dus & 0xFFFFFFFF) << 32))
    var since: u64 = 0
    if wmlayout.gs(state, wmlayout.S_PL_TPREV) != 0 && t0 > wmlayout.gs(state, wmlayout.S_PL_TPREV) {
        since = ph_us(state, wmlayout.gs(state, wmlayout.S_PL_TPREV), t0)
    }
    wmanim.tw(f, at + 7, since)
    wmanim.tw(f, at, ((idx + 1) << 32) | fl)
    wmlayout.ss(state, wmlayout.S_PL_HEAD, idx + 1)
    wmlayout.ss(state, wmlayout.S_PL_NREC, wmlayout.gs(state, wmlayout.S_PL_NREC) + 1)
    wmlayout.ss(state, wmlayout.S_PL_TPREV, t0)
    wmlayout.ss(state, wmlayout.S_PL_FLAGS, 0)
    wmlayout.ss(state, wmlayout.S_PL_NCOMP, 0)
    wmlayout.ss(state, wmlayout.S_PL_CDUR, 0)
    wmanim.tw(f, 2, idx + 1)
    wmanim.tw(f, 6, wmlayout.gs(state, wmlayout.S_PL_NTORN))
    wmanim.tw(f, 7, wmlayout.gs(state, wmlayout.S_PL_NREC))
}

// WM_COMP / CP_ATTACH. 0 = attached, 1 = refused (`nocomp`), 2 = another live compositor is attached, 3 = busy.
fn cp_attach(state: u64, me: u64) -> u64 {
    if fb.nocomp_an(state) {
        return 1
    }
    if !cp_lock(state) {
        return 3
    }
    let cur: u64 = wmlayout.gs(state, wmlayout.S_CP_TASK)
    if cur != 0 && cur != me + 1 {
        let idx: u64 = cur - 1
        let st: u64 = sched.tget(state, idx, sched.T_STATE)
        if st != sched.S_ZOMBIE && st != sched.S_FREE && sched.tget(state, idx, sched.T_PID) == wmlayout.gs(state, wmlayout.S_CP_PID) {
            cp_unlock(state)
            return 2
        }
        cp_detach_locked(state, 1)
    }
    wmlayout.ss(state, wmlayout.S_CP_TASK, me + 1)
    wmlayout.ss(state, wmlayout.S_CP_PID, sched.tget(state, me, sched.T_PID))
    wmlayout.ss(state, wmlayout.S_CP_MISS, 0)
    wmlayout.ss(state, wmlayout.S_CP_NATT, wmlayout.gs(state, wmlayout.S_CP_NATT) + 1)
    cp_sync(state)
    cp_unlock(state)
    // a first complete frame for the new compositor to show
    wmbase.damage_all(state)
    return 0
}

fn cp_detach(state: u64, me: u64) -> u64 {
    if wmlayout.gs(state, wmlayout.S_CP_TASK) != me + 1 {
        return CP_NOT
    }
    if !cp_lock(state) {
        return CP_BUSY
    }
    cp_detach_locked(state, 3)
    cp_unlock(state)
    return 0
}

// WM_COMP / CP_PRESENT: show what waits. Returns the pixels (0 = nothing waited).
fn cp_present(state: u64, me: u64) -> u64 {
    if wmlayout.gs(state, wmlayout.S_CP_TASK) != me + 1 {
        return CP_NOT
    }
    if !cp_lock(state) {
        return CP_BUSY
    }
    var px: u64 = 0
    if wmlayout.gs(state, wmlayout.S_CP_TASK) == me + 1 {
        px = cp_flush_locked(state, true)
        if px != 0 {
            wmlayout.ss(state, wmlayout.S_CP_MISS, 0)
        }
    }
    cp_unlock(state)
    return px
}

// WM_COMP / CP_WAIT: sleep until a frame newer than `seen` was handed over, for at most `ms`. Returns the number of the newest frame.
// The wake-up is the one `poll` uses: the sequence is read BEFORE the look, `poll_sleep` sleeps only if it has not moved.
fn cp_wait(state: u64, me: u64, seen: u64, ms: u64) -> u64 {
    if wmlayout.gs(state, wmlayout.S_CP_TASK) != me + 1 {
        return CP_NOT
    }
    let ps: u64 = sched.poll_seq(state)
    if wmlayout.gs(state, wmlayout.S_CP_FSEQ) != seen {
        return wmlayout.gs(state, wmlayout.S_CP_FSEQ)
    }
    sched.poll_sleep(state, ps, kstate.get(state, kstate.TICKS) + ms / 10 + 1)
    return wmlayout.gs(state, wmlayout.S_CP_FSEQ)
}

// the input copy: see the header. `a`, `b`, `c` as in the page description.
fn cp_event(state: u64, typ: u64, mods: u64, btn: u64, x: u64, y: u64, code: u64) {
    let f: u64 = wmlayout.gs(state, wmlayout.S_CP_PAGEF)
    if f == 0 || wmlayout.gs(state, wmlayout.S_CP_TASK) == 0 {
        return
    }
    if wmgate.sperre_an(state) || td_live(state) {
        wmlayout.ss(state, wmlayout.S_CP_EVREF, wmlayout.gs(state, wmlayout.S_CP_EVREF) + 1)
        return
    }
    let h: u64 = wmlayout.gs(state, wmlayout.S_CP_HEAD)
    let at: u64 = CP_RING_AT + (h % CP_RING) * 4
    wmanim.tw(f, at + 1, x | (y << 32))
    wmanim.tw(f, at + 2, code)
    wmanim.tw(f, at + 3, time.tsc())
    wmanim.tw(f, at, typ | (mods << 8) | (btn << 16) | ((h + 1) << 32))
    wmlayout.ss(state, wmlayout.S_CP_HEAD, h + 1)
    arch.atomic_store(f + 16, h + 1)
}

// the modifiers that make a key a shortcut (Alt or the Windows key): 1 = shortcut
fn cp_shortcut(state: u64) -> u64 {
    if kstate.get(state, kstate.K11_OFF + kstate.KB_OLD) != 0 || kstate.get(state, kstate.K11_OFF + kstate.KB_SUPER) != 0 {
        return 1
    }
    return 0
}

fn cp_stat(state: u64, k: u64) -> u64 {
    if k == 0 {
        return wmlayout.gs(state, wmlayout.S_CP_NATT)
    }
    if k == 1 {
        return wmlayout.gs(state, wmlayout.S_CP_NDET)
    }
    if k == 2 {
        return wmlayout.gs(state, wmlayout.S_CP_NMISS)
    }
    if k == 3 {
        return wmlayout.gs(state, wmlayout.S_CP_NPRES)
    }
    if k == 4 {
        return wmlayout.gs(state, wmlayout.S_CP_NKP)
    }
    if k == 5 {
        return wmlayout.gs(state, wmlayout.S_CP_NHAND)
    }
    if k == 6 {
        return wmlayout.gs(state, wmlayout.S_CP_HEAD)
    }
    if k == 7 {
        return wmlayout.gs(state, wmlayout.S_CP_EVREF)
    }
    return 0
}

// F12: one line, only when a compositor ever attached or the word `phases` is on (the input-to-picture clock of the kernel path is wanted there).
fn cp_say_reset(state: u64) {
    if wmlayout.gs(state, wmlayout.S_CP_NATT) == 0 && !fb.phases_an(state) {
        return
    }
    var s_c0: [u8; 13] = "wm: comp on=\0"
    var s_c1: [u8; 6] = " att=\0"
    var s_c2: [u8; 6] = " det=\0"
    var s_c3: [u8; 7] = " miss=\0"
    var s_c4: [u8; 7] = " hand=\0"
    var s_c5: [u8; 7] = " pres=\0"
    var s_c6: [u8; 8] = " kpres=\0"
    var s_c7: [u8; 5] = " ev=\0"
    var s_c8: [u8; 8] = " evref=\0"
    var s_h0: [u8; 7] = " hopn=\0"
    var s_h1: [u8; 9] = " hopavg=\0"
    var s_h2: [u8; 9] = " hopmax=\0"
    var s_w0: [u8; 8] = " wlatn=\0"
    var s_w1: [u8; 10] = " wlatavg=\0"
    var s_w2: [u8; 10] = " wlatmax=\0"
    var s_k0: [u8; 8] = " klatn=\0"
    var s_k1: [u8; 10] = " klatavg=\0"
    var s_k2: [u8; 10] = " klatmax=\0"
    serial.puts((&s_c0[0]) as u64)
    if cp_on(state) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_c1[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_CP_NATT))
    serial.puts((&s_c2[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_CP_NDET))
    serial.puts((&s_c3[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_CP_NMISS))
    serial.puts((&s_c4[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_CP_NHAND))
    serial.puts((&s_c5[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_CP_NPRES))
    serial.puts((&s_c6[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_CP_NKP))
    serial.puts((&s_c7[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_CP_HEAD))
    serial.puts((&s_c8[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_CP_EVREF))
    var n: u64 = wmlayout.gs(state, wmlayout.S_CP_HOP)
    serial.puts((&s_h0[0]) as u64)
    serial.dec(n)
    serial.puts((&s_h1[0]) as u64)
    if n != 0 {
        serial.dec(wmlayout.gs(state, wmlayout.S_CP_HOP + 8) / n)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_h2[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_CP_HOP + 16))
    n = wmlayout.gs(state, wmlayout.S_CP_WLAT)
    serial.puts((&s_w0[0]) as u64)
    serial.dec(n)
    serial.puts((&s_w1[0]) as u64)
    if n != 0 {
        serial.dec(wmlayout.gs(state, wmlayout.S_CP_WLAT + 8) / n)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_w2[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_CP_WLAT + 16))
    n = wmlayout.gs(state, wmlayout.S_CP_KLAT)
    serial.puts((&s_k0[0]) as u64)
    serial.dec(n)
    serial.puts((&s_k1[0]) as u64)
    if n != 0 {
        serial.dec(wmlayout.gs(state, wmlayout.S_CP_KLAT + 8) / n)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_k2[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_CP_KLAT + 16))
    serial.nl()
    // the clocks start again for the next phase; the totals above (att, det, miss, hand, pres, kpres, ev) are running
    var z: u64 = 0
    while z < 3 {
        wmlayout.ss(state, wmlayout.S_CP_HOP + z * 8, 0)
        wmlayout.ss(state, wmlayout.S_CP_WLAT + z * 8, 0)
        wmlayout.ss(state, wmlayout.S_CP_KLAT + z * 8, 0)
        z = z + 1
    }
}

fn flush_win(state: u64, i: u64) {
    if !wmbase.valid(state, i) {
        return
    }
    // vboxlag: a HIDDEN (minimized / popup-not-shown) window is not composed, so its repaint changes nothing on the screen. Before this,
    // the hidden tray / calendar / mini windows made the whole window rectangle dirty about five times a second at idle
    // (1.3 MB per frame to the card). Showing a window damages it anyway (`show_win`), so nothing is lost; `nohidskip` is the counter-proof.
    if win_hidden(state, i) && !fb.nohidskip_an(state) {
        return
    }
    // the client painted new contents: its own blur (made from what is under it) is still good
    wmdamage.damage_win_ex(state, i, i + 1)
}

// ------------------------------------------------- das Zusammensetzen

// Der Zeiger. Achtzehn Zeilen zu zwoelf Bildpunkten, als zwei
// Bitmasken je Zeile: Umriss und Fuellung. Warum von Hand und nicht als
// Bilddatei: es sind 72 Oktette, und ein Zeiger, der aus einer Datei
// kommt, fehlt genau dann, wenn man ihn zum Suchen des Fehlers braucht.
const CUR_W: u64 = 12

fn anims(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_ANIMS)
}

// EIN TICK DER BEWEGUNGEN, und er gehoert in den Zeitgeber und nicht
// ins Zeichnen. Er macht drei Dinge: abgelaufene Bewegungen beenden,
// laufende schmutzig machen (sonst zeichnet `compose` sie nicht), und
// beim Ende einer Schliessbewegung das Fenster WIRKLICH wegnehmen.
// Gibt zurueck, wie viele Bewegungen noch laufen.
fn anim_tick(state: u64) -> u64 {
    if !wmbase.ready(state) {
        return 0
    }
    wmlayout.ss(state, wmlayout.S_TICKS, wmlayout.gs(state, wmlayout.S_TICKS) + 1)
    var offen: u64 = 0
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmbase.valid(state, i) && wmlayout.wg(state, i, wmlayout.W_ANK) != 0 {
            let p: u64 = wmanim.anim_p(state, i)
            let art: u64 = wmlayout.wg(state, i, wmlayout.W_ANK)
            // Der Bereich wird IMMER schmutzig, auch wenn der
            // Fortschritt gleich blieb -- am Ende der Bewegung steht
            // sonst das letzte Zwischenbild auf dem Schirm.
            // r461: a window that opens or closes cannot spoil the blur of the windows below it
            wmdamage.damage_win_ex(state, i, i + 1)
            if p >= 1000 {
                wmlayout.wsv(state, i, wmlayout.W_ANK, 0)
                wmlayout.wsv(state, i, wmlayout.W_ANP, 1000)
                // DAS FENSTER GEHT ERST JETZT. Waere es beim Klick
                // verschwunden, haette die Bewegung nichts mehr zu
                // zeigen gehabt -- das ist der ganze Grund, warum
                // Schliessen ueber diesen Umweg laeuft.
                if art == wmanim.AN_CLOSE {
                    destroy(state, i)
                } else {
                    if art == wmanim.AN_MIN {
                        set_hidden(state, i, true)
                    }
                }
            } else {
                wmlayout.wsv(state, i, wmlayout.W_ANP, p)
                wmlayout.ss(state, wmlayout.S_ANFRAMES, wmlayout.gs(state, wmlayout.S_ANFRAMES) + 1)
                offen = offen + 1
            }
        }
        i = i + 1
    }
    return offen
}

// ---------------------------------------------------- DIE BILDGRENZE

fn set_vsync(state: u64, on: bool) {
    wmlayout.ss(state, wmlayout.S_VSYNC, 0)
    if on {
        wmlayout.ss(state, wmlayout.S_VSYNC, 1)
    }
}

fn vsync_on(state: u64) -> bool {
    return wmlayout.gs(state, wmlayout.S_VSYNC) != 0
}

fn pxsum(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_PXSUM)
}

fn presents(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_PRESENTS)
}

fn skipped(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_SKIPPED)
}

// Das gezeichnete Rechteck vormerken, statt es zu uebertragen. Mehrere
// `compose`-Laeufe zwischen zwei Ticks wachsen so zu EINEM Rechteck
// zusammen, und der Schirm sieht sie zusammen oder gar nicht.
fn pend_add(state: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if wmlayout.gs(state, wmlayout.S_PEND) == 0 {
        wmlayout.ss(state, wmlayout.S_PX0, x0)
        wmlayout.ss(state, wmlayout.S_PY0, y0)
        wmlayout.ss(state, wmlayout.S_PX1, x1)
        wmlayout.ss(state, wmlayout.S_PY1, y1)
        wmlayout.ss(state, wmlayout.S_PEND, 1)
        return
    }
    if x0 < wmlayout.gs(state, wmlayout.S_PX0) {
        wmlayout.ss(state, wmlayout.S_PX0, x0)
    }
    if y0 < wmlayout.gs(state, wmlayout.S_PY0) {
        wmlayout.ss(state, wmlayout.S_PY0, y0)
    }
    if x1 > wmlayout.gs(state, wmlayout.S_PX1) {
        wmlayout.ss(state, wmlayout.S_PX1, x1)
    }
    if y1 > wmlayout.gs(state, wmlayout.S_PY1) {
        wmlayout.ss(state, wmlayout.S_PY1, y1)
    }
}

// DAS BILD ZEIGEN. Eine Uebertragung, ein Rechteck -- und der Zaehler
// steigt nur, wenn wirklich etwas anlag. Wer das im Takt ruft, hat
// genau die Bildgrenze, die vorher fehlte.
fn present(state: u64) -> u64 {
    if !wmbase.ready(state) || !fb.ready(state) {
        return 0
    }
    if wmlayout.gs(state, wmlayout.S_PEND) == 0 {
        return 0
    }
    let x0: u64 = wmlayout.gs(state, wmlayout.S_PX0)
    let y0: u64 = wmlayout.gs(state, wmlayout.S_PY0)
    let x1: u64 = wmlayout.gs(state, wmlayout.S_PX1)
    let y1: u64 = wmlayout.gs(state, wmlayout.S_PY1)
    wmlayout.ss(state, wmlayout.S_PEND, 0)
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    // COMPOSITOR S5: with a compositor the rectangle is handed over, the compositor shows it
    if cp_on(state) && cp_lock(state) {
        cp_hand(state, x0, y0, x1, y1)
        cp_kick(state)
        cp_unlock(state)
        return (x1 - x0) * (y1 - y0)
    }
    // `flush_rect` statt `flush`: nur die Spalten, die wirklich
    // schmutzig waren. `flush` haette die ganze Bildbreite genommen,
    // weil es nur Zeilen kennt.
    // MIT SEITENUMSCHALTUNG MUSS DIE GANZE SEITE STIMMEN, nicht nur
    // das schmutzige Rechteck: gezeigt wird gleich die ANDERE Haelfte,
    // und in der steht das vorletzte Bild. Was seitdem woanders
    // gemalt wurde, fehlte dort. Also die volle Flaeche kopieren --
    // sie ist unsichtbar, solange nicht umgeschaltet ist, und der
    // Preis dafuer steht in docs/VSYNC.md.
    if fb.flip_on(state) {
        fb.flush_rect(state, 0, 0, wmlayout.gs(state, wmlayout.S_SW), wmlayout.gs(state, wmlayout.S_SH))
        fb.flip(state)
    } else {
        beam.wait(state, x0, y0, x1 - x0, y1 - y0)
        fb.flush_rect(state, x0, y0, x1 - x0, y1 - y0)
    }
    wmlayout.ss(state, wmlayout.S_PRESENTS, wmlayout.gs(state, wmlayout.S_PRESENTS) + 1)
    // RUNDE VIRTIOGPU: DIE BILDGRENZE IST HIER UND SONST NIRGENDS.
    // `flushes` zaehlt Uebertragungen, und davon gibt es mehrere je
    // Bild. Wer "Oktette je Bild" ausrechnen will, braucht die Zahl
    // der BILDER -- und ein Bild ist genau ein Durchlauf hier.
    fb.frame_done(state)
    let flaeche: u64 = (x1 - x0) * (y1 - y0)
    wmlayout.ss(state, wmlayout.S_PXSUM, wmlayout.gs(state, wmlayout.S_PXSUM) +% flaeche)
    return flaeche
}

// ------------------------------------------- DER ABLESER (SCANOUT)
//
// WARUM ES DIESEN ABLESER GEBEN MUSS, UND WARUM ER IM KERNEL SITZT.
//
// Die erste Fassung der Zerreissprobe hat von aussen fotografiert und
// die Signaturen im Bild verglichen. Sie fand NIE ein zerrissenes Bild
// -- auch dann nicht, wenn die Bildgrenze ausdruecklich abgeschaltet
// war (`nopresent`) und es also reissen MUSSTE. Der Grund liegt in
// QEMU: `screendump` liest die Bildflaeche in EINEM Zug, waehrend
// niemand schreibt. Ein halb uebertragenes Bild ist darin nicht zu
// sehen. Eine Messung, die auch bei abgeschalteter Zusage gruen
// bleibt, misst nichts -- also war sie zu verwerfen.
//
// Der Ableser stellt dieselbe Frage an der Stelle, an der sie
// beantwortbar ist: er liest den VORDERPUFFER (die Karte), oben und
// unten, GENAU SO, wie ein Bildschirm ihn ausliest -- und er tut es
// waehrend der Server malt. Findet er oben und unten verschiedene
// Signaturen, hat er ein halbes Bild in der Hand.
//
// Das ist keine Nachbildung des Reissens, sondern das Reissen selbst:
// ein Bildschirm, der in diesem Augenblick abgelesen haette, haette
// dasselbe gesehen.
fn set_leser(state: u64, on: bool) {
    wmlayout.ss(state, wmlayout.S_LESER, 0)
    if on {
        wmlayout.ss(state, wmlayout.S_LESER, 1)
    }
}

fn liest(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_LIEST)
}

fn risse(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_TEAR)
}

fn tear_top(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_R0)
}

fn tear_bottom(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_R1)
}

fn without_sig(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_KEIN)
}

fn riss_y0(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_RY0)
}

fn riss_y1(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_RY1)
}

fn riss_frame(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_RFR)
}

// Wie viele Ablesungen verworfen wurden, weil zwischen ihren beiden
// Punkten umgeschaltet wurde. Sie sind KEIN Riss -- die Zahl steht
// daneben, damit man sieht, wie oft es vorkam.
fn verworfen(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_VERWORF)
}

// Die drei Zahlen der Vorfuehrung, von `kgui` gelesen und gesetzt.
fn before_t0(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_VT0)
}

fn set_before_t0(state: u64, v: u64) {
    wmlayout.ss(state, wmlayout.S_VT0, v)
}

fn before_step(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_VSTEP)
}

fn set_before_step(state: u64, v: u64) {
    wmlayout.ss(state, wmlayout.S_VSTEP, v)
}

fn before_win(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_VWIN)
}

fn set_before_win(state: u64, v: u64) {
    wmlayout.ss(state, wmlayout.S_VWIN, v)
}

// Welche Farbnummer steht an dieser Stelle? MAX_SIG heisst "keine der
// acht" -- dort steht dann Fensterinhalt oder Hintergrund, und das ist
// kein Widerspruch, sondern nur nichts zu vergleichen.
fn sig_nr(c: u64) -> u64 {
    var k: u64 = 0
    while k < 8 {
        if sig_colour(k) == (c & wmdraw.RGB24) {
            return k
        }
        k = k + 1
    }
    return 8
}

// EINMAL ABLESEN. Er nimmt das oberste sichtbare Fenster, liest dessen
// oberen und unteren Signaturstreifen aus dem VORDERPUFFER und
// vergleicht. Der Aufrufer ruft das dicht -- je dichter, desto eher
// erwischt er die Uebertragung mitten im Lauf.
fn leser_tick(state: u64) {
    if wmlayout.gs(state, wmlayout.S_LESER) == 0 || wmlayout.gs(state, wmlayout.S_SIG) == 0 {
        return
    }
    let i: u64 = top_visible(state)
    if i >= wmbase.MAX_WIN {
        return
    }
    // NUR AN EINEM FENSTER, DAS SICH GERADE NICHT BEWEGT UND NICHT
    // AUFGEHT. Waehrend einer Oeffnungsbewegung wird die Flaeche
    // skaliert und gemischt gemalt -- die Signaturstreifen liegen dann
    // nicht dort, wo dieser Ableser sie aus `win_x`/`win_y` errechnet,
    // und was er findet, ist wieder eine Aussage ueber die Messung.
    // Dasselbe gilt fuer ein gezogenes Fenster.
    if wmlayout.wg(state, i, wmlayout.W_ANK) != 0 || wmlayout.gs(state, wmlayout.S_DRAG) != 0 {
        return
    }
    let wx: i64 = wmbase.win_x(state, i)
    let wy: i64 = wmbase.win_y(state, i)
    let ow: i64 = wmbase.outer_w(state, i) as i64
    let oh: i64 = wmbase.outer_h(state, i) as i64
    if ow <= 0 || oh < 2 * SIG_H as i64 || wx < 0 || wy < 0 {
        return
    }
    // DIE STELLE WIRD AUS EINER EINZIGEN ABLESUNG DES ORTES GERECHNET.
    //
    // Der Ableser rechnete sie zuerst bei jeder Ablesung frisch aus
    // `win_x`/`win_y` -- und zwar ZWEIMAL, einmal fuer oben und einmal
    // fuer unten. Waehrend eines Zuges wandert das Fenster dazwischen,
    // und dann las er oben an der neuen und unten an der alten Stelle:
    // zwei Signaturen, die nichts miteinander zu tun hatten. GEMESSEN
    // als 97 Prozent "Risse" bei stehender Bildgrenze, waehrend
    // derselbe Ableser am STEHENDEN Bild null fand. Der Fehler lag in
    // der Messung.
    //
    // Eine feste Stelle war die naechste Fassung und auch falsch: das
    // Fenster wandert unter ihr weg, und dann misst sie Hintergrund
    // (gemessen: 1 165 276 Ablesungen ohne Signatur von 1 210 449).
    //
    // Richtig ist: den Ort EINMAL lesen und BEIDE Punkte daraus
    // rechnen. Bewegt sich das Fenster danach, gehoert die Ablesung
    // eben zum vorigen Ort -- aber zu EINEM Ort, und genau darauf
    // kommt es an.
    let x: u64 = (wx + ow / 2) as u64
    let y0: u64 = (wy + 1) as u64
    let y1: u64 = (wy + oh - 2) as u64
    // BEIDE PUNKTE AUS DERSELBEN BILDSEITE, in einem Zug. Zwei
    // getrennte Ablesungen haetten den Seitenwechsel dazwischen
    // erwischt und einen Riss gemeldet, den es nicht gab -- siehe
    // `fb.front_paar`.
    let puffer: u64 = state + kstate.WM_OFF + wmlayout.S_LPAAR
    // BIS ZU DREI VERSUCHE. `front_paar` sagt `false`, wenn zwischen
    // den beiden Punkten die Bildseite gewechselt wurde -- dann hat die
    // Ablesung KEINE Aussage (siehe die Begruendung dort). Ein neuer
    // Versuch trifft die naechste ruhige Spanne; klappt es dreimal
    // nicht, wird gar nichts gezaehlt. Eine verworfene Ablesung ist
    // KEIN Riss, und sie als einen zu zaehlen waere die eine Zahl, auf
    // die sich diese Runde nicht verlassen duerfte.
    var versuch: u64 = 0
    var gut: bool = false
    while versuch < 3 && !gut {
        gut = fb.front_paar(state, x, y0, y1, puffer)
        versuch = versuch + 1
    }
    if !gut {
        wmlayout.ss(state, wmlayout.S_VERWORF, wmlayout.gs(state, wmlayout.S_VERWORF) + 1)
        return
    }
    let a: u64 = kstate.get(state, kstate.WM_OFF + wmlayout.S_LPAAR)
    let b: u64 = kstate.get(state, kstate.WM_OFF + wmlayout.S_LPAAR + 8)
    let ka: u64 = sig_nr(a)
    let kb: u64 = sig_nr(b)
    wmlayout.ss(state, wmlayout.S_LIEST, wmlayout.gs(state, wmlayout.S_LIEST) + 1)
    // Nur wenn BEIDE eine Signatur tragen, ist die Frage gestellt.
    // Steht an einer Stelle Fensterinhalt, wurde dort gerade nichts
    // uebertragen -- das ist kein Riss.
    if ka < 8 && kb < 8 && ka != kb {
        wmlayout.ss(state, wmlayout.S_TEAR, wmlayout.gs(state, wmlayout.S_TEAR) + 1)
        // Die ERSTE Beobachtung festhalten: welche zwei Signaturen,
        // an welchen Zeilen. Ohne sie ist "es reisst" eine Zahl ohne
        // Anhalt, und die Suche nach dem Grund faengt bei null an.
        if wmlayout.gs(state, wmlayout.S_R0) == 0 {
            wmlayout.ss(state, wmlayout.S_R0, ka + 1)
            wmlayout.ss(state, wmlayout.S_R1, kb + 1)
            // Und WO es passiert ist: die Zeilen und die Bildnummer.
            // Ohne sie bleibt "es reisst noch ein bisschen" eine Zahl
            // ohne Anhalt.
            wmlayout.ss(state, wmlayout.S_RY0, y0)
            wmlayout.ss(state, wmlayout.S_RY1, y1)
            wmlayout.ss(state, wmlayout.S_RFR, wmlayout.gs(state, wmlayout.S_FRAME))
        }
    }
    if ka >= 8 || kb >= 8 {
        wmlayout.ss(state, wmlayout.S_KEIN, wmlayout.gs(state, wmlayout.S_KEIN) + 1)
    }
}

// ---------------------------------------------------- DIE SIGNATUR

fn set_sig(state: u64, on: bool) {
    wmlayout.ss(state, wmlayout.S_SIG, 0)
    if on {
        wmlayout.ss(state, wmlayout.S_SIG, 1)
    }
}

fn sig_on(state: u64) -> bool {
    return wmlayout.gs(state, wmlayout.S_SIG) != 0
}

fn frame_no(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_FRAME)
}

// Die Farbe einer Bildnummer. Acht gut unterscheidbare Volltoene --
// keine Rechnung mit kleinen Unterschieden, denn ein Foto wird
// maschinell gelesen und ein Unterschied von eins waere keiner.
fn sig_colour(n: u64) -> u64 {
    let k: u64 = n & 7
    if k == 0 {
        return 0xFF0000
    }
    if k == 1 {
        return 0x00FF00
    }
    if k == 2 {
        return 0x0000FF
    }
    if k == 3 {
        return 0xFFFF00
    }
    if k == 4 {
        return 0xFF00FF
    }
    if k == 5 {
        return 0x00FFFF
    }
    if k == 6 {
        return 0xFF8000
    }
    return 0xFFFFFF
}

// DIE ZERREISSPROBE, und warum sie so und nicht anders aussieht.
//
// Reissen ist unter QEMU nicht zu sehen: `screendump` liest die
// Bildflaeche, nachdem der Bildaufbau fertig ist, und ein halb
// uebertragenes Bild sieht dabei aus wie ein ganzes. Also wird die
// Frage umgestellt. Jedes Bild traegt eine Nummer; im Signaturbetrieb
// malt der Server einen Streifen dieser Farbe an den OBEREN und einen
// an den UNTEREN Rand jedes Fensters. Beide Streifen entstehen im
// SELBEN `compose`-Lauf und tragen deshalb dieselbe Farbe.
//
// Wird nun mitten in der Uebertragung abgelesen, steht oben noch das
// alte und unten schon das neue Bild -- ZWEI Farben in einem Fenster.
// Das ist Reissen, und ein Programm kann es zaehlen. Steht die
// Bildgrenze, MUSS jedes Foto in jedem Fenster genau eine Farbe zeigen.
fn paint_sig(state: u64, i: u64, cx0: i64, cy0: i64, cx1: i64,
    cy1: i64) {
    if wmlayout.gs(state, wmlayout.S_SIG) == 0 {
        return
    }
    let farbe: u64 = sig_colour(wmlayout.gs(state, wmlayout.S_FRAME))
    let wx: i64 = wmbase.win_x(state, i)
    let wy: i64 = wmbase.win_y(state, i)
    let ow: i64 = wmbase.outer_w(state, i) as i64
    let oh: i64 = wmbase.outer_h(state, i) as i64
    if oh < 2 * SIG_H as i64 {
        return
    }
    wmdraw.fill_clip(state, wx, wy, ow, SIG_H as i64, farbe, 255, cx0, cy0, cx1, cy1)
    wmdraw.fill_clip(state, wx, wy + oh - SIG_H as i64, ow, SIG_H as i64, farbe, 255,
        cx0, cy0, cx1, cy1)
}

// The microseconds between two clock readings (0 while the clock is not calibrated or after a world switch).
fn ph_us(state: u64, t0: u64, t1: u64) -> u64 {
    let kh: u64 = time.khz(state)
    if kh < 1000 || t1 <= t0 {
        return 0
    }
    return (t1 - t0) / (kh / 1000)
}

fn ph_add(state: u64, slot: u64, t0: u64, t1: u64) {
    wmlayout.ss(state, slot, wmlayout.gs(state, slot) + ph_us(state, t0, t1))
}

fn pg_window_at(state: u64, x: u64, y: u64) -> u64 {
    var z: u64 = wmlayout.gs(state, wmlayout.S_COUNT)
    while z > 0 {
        z = z - 1
        let i: u64 = wmbase.at_z(state, z)
        if i < wmbase.MAX_WIN && (wmlayout.wg(state, i, wmlayout.W_FLAGS) & (wmlayout.F_HIDDEN | wmlayout.F_TABBED)) == 0 {
            let wx: i64 = wmbase.win_x(state, i)
            let wy: i64 = wmbase.win_y(state, i)
            if (x as i64) >= wx && (x as i64) < wx + wmbase.outer_w(state, i) as i64
                && (y as i64) >= wy && (y as i64) < wy + wmbase.outer_h(state, i) as i64 {
                return i + 1
            }
        }
    }
    return 0
}

fn pg_ready(state: u64) -> bool {
    if ax.mag(state) || fb.transformed(state) || fb.on_vgpu(state) || fb.flip_on(state) {
        return false
    }
    if fb.back(state) == 0 || fb.draw_at(state) != fb.back(state) {
        return false
    }
    if wmlayout.gs(state, wmlayout.S_VSYNC) != 0 || cp_on(state) {
        return false
    }
    return true
}

fn pg_render(state: u64, slot: u64) -> bool {
    if !pixelguard.begin(state, slot) {
        return false
    }
    compose_rect(state, 0, 0, wmlayout.gs(state, wmlayout.S_SW), wmlayout.gs(state, wmlayout.S_SH), 0)
    pixelguard.finish(state)
    return true
}

fn pg_box(state: u64, out: u64) {
    var k: u64 = 0
    while k < 4 {
        __mmio_write64((out + k * 8) as *mut u64, 0 as u64)
        k = k + 1
    }
    if wmlayout.gs(state, wmlayout.S_DON) != 0 {
        __mmio_write64(out as *mut u64, wmlayout.gs(state, wmlayout.S_DX0))
        __mmio_write64((out + 8) as *mut u64, wmlayout.gs(state, wmlayout.S_DY0))
        __mmio_write64((out + 16) as *mut u64, wmlayout.gs(state, wmlayout.S_DX1))
        __mmio_write64((out + 24) as *mut u64, wmlayout.gs(state, wmlayout.S_DY1))
    }
}

fn pg_compare(state: u64, slot: u64) -> u64 {
    var bx: [u64; 4] = [0 as u64; 4]
    pg_box(state, (&bx[0]) as u64)
    return pixelguard.compare(state, slot, bx[0], bx[1], bx[2], bx[3])
}

fn pg_cursor(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_CURX) * 65536 + wmlayout.gs(state, wmlayout.S_CURY)
}

fn pg_check(state: u64, painted: u64, cur0: u64) {
    if !pixelguard.due(state, painted) {
        return
    }
    if !pg_ready(state) {
        pixelguard.count(pixelguard.ST_SKIPPED)
        return
    }
    let t0: u64 = time.tsc()
    let pl: u64 = wmlayout.gs(state, wmlayout.S_PL_ON)
    let zf: u64 = wmlayout.gs(state, wmlayout.S_ZFLAG)
    let p0: u64 = wmlayout.gs(state, wmlayout.S_PH_BG)
    let p1: u64 = wmlayout.gs(state, wmlayout.S_PH_WIN)
    let p2: u64 = wmlayout.gs(state, wmlayout.S_PH_DRAG)
    let p3: u64 = wmlayout.gs(state, wmlayout.S_PH_TOP)
    let p4: u64 = wmlayout.gs(state, wmlayout.S_PH_PEND)
    let p5: u64 = wmlayout.gs(state, wmlayout.S_PH_BLUR)
    let p6: u64 = wmlayout.gs(state, wmlayout.S_PH_GLASS)
    let p7: u64 = wmlayout.gs(state, wmlayout.S_PH_SHADOW)
    wmlayout.ss(state, wmlayout.S_PL_ON, 0)
    if pg_render(state, 0) {
        pixelguard.count(pixelguard.ST_CHECKS)
        let bad: u64 = pg_compare(state, 0)
        if bad == 0 {
            pixelguard.clear_cand(0)
        }
        if bad != 0 && pg_cursor(state) != cur0 {
            pixelguard.count(pixelguard.ST_PENDING)
        } else if bad != 0 {
            if pg_render(state, 1) {
                let bad2: u64 = pg_compare(state, 1)
                if bad2 == 0 {
                    pixelguard.count(pixelguard.ST_PENDING)
                } else if pixelguard.compare_refs(state, pixelguard.cmp_get(pixelguard.CMP_X0), pixelguard.cmp_get(pixelguard.CMP_Y0),
                    pixelguard.cmp_get(pixelguard.CMP_X1), pixelguard.cmp_get(pixelguard.CMP_Y1)) != 0 {
                    pixelguard.count(pixelguard.ST_UNSTABLE)
                } else if !pixelguard.confirm(0, pixelguard.cmp_get(pixelguard.CMP_X0), pixelguard.cmp_get(pixelguard.CMP_Y0),
                    pixelguard.cmp_get(pixelguard.CMP_X1), pixelguard.cmp_get(pixelguard.CMP_Y1)) {
                    pixelguard.count(pixelguard.ST_PENDING)
                } else {
                    let win: u64 = pg_window_at(state, pixelguard.cmp_get(pixelguard.CMP_FX), pixelguard.cmp_get(pixelguard.CMP_FY))
                    pixelguard.report(state, 0, win, pixelguard.ref_addr(1), fb.back(state))
                }
            }
        }
    }
    if !fb.stripe(state) {
        pixelguard.count(pixelguard.ST_CARD_CHECKS)
        let cbad: u64 = pixelguard.card_compare(state)
        if cbad == 0 {
            pixelguard.clear_cand(1)
        }
        if cbad != 0 && !pixelguard.confirm(1, pixelguard.cmp_get(pixelguard.CMP_X0), pixelguard.cmp_get(pixelguard.CMP_Y0),
            pixelguard.cmp_get(pixelguard.CMP_X1), pixelguard.cmp_get(pixelguard.CMP_Y1)) {
            pixelguard.count(pixelguard.ST_PENDING)
        } else if cbad != 0 {
            let cwin: u64 = pg_window_at(state, pixelguard.cmp_get(pixelguard.CMP_FX), pixelguard.cmp_get(pixelguard.CMP_FY))
            pixelguard.report(state, 1, cwin, fb.back(state), fb.addr(state))
        }
    }
    wmlayout.ss(state, wmlayout.S_PL_ON, pl)
    wmlayout.ss(state, wmlayout.S_ZFLAG, zf)
    wmlayout.ss(state, wmlayout.S_PH_BG, p0)
    wmlayout.ss(state, wmlayout.S_PH_WIN, p1)
    wmlayout.ss(state, wmlayout.S_PH_DRAG, p2)
    wmlayout.ss(state, wmlayout.S_PH_TOP, p3)
    wmlayout.ss(state, wmlayout.S_PH_PEND, p4)
    wmlayout.ss(state, wmlayout.S_PH_BLUR, p5)
    wmlayout.ss(state, wmlayout.S_PH_GLASS, p6)
    wmlayout.ss(state, wmlayout.S_PH_SHADOW, p7)
    pixelguard.set_last(pixelguard.ST_US, time_us(state, time.tsc() - t0))
}

fn compose(state: u64) -> u64 {
    let lk: u64 = state + kstate.WM_OFF + wmlayout.S_CLOCK
    let alt: u64 = __atomic_swap(lk as *mut u64, 0 as u64, 1 as u64)
    if alt != 0 {
        return 0
    }
    if pixelguard.frozen() {
        arch.atomic_store(lk, 0)
        return 0
    }
    screen_follow(state)
    cp_watch(state)
    tab_publish(state)
    let cur0: u64 = pg_cursor(state)
    let r: u64 = compose_one(state)
    pg_check(state, r, cur0)
    cp_kick(state)
    arch.atomic_store(lk, 0)
    return r
}

// W-PRESENT: PUSH ONE FINISHED RECTANGLE TO THE CARD WITHOUT THE PAGE FLIP (the path of every frame when `vsync` is off, i.e. the shipping
// configuration). Only the changed columns are copied (`fb.flush_region`); the word `fullrows` brings the old whole-row copy back as the counter-proof.
// The copy is timed with the TSC: F12 prints sum / max / count (`wm: flush`), because the time the card holds a half-copied frame is the time
// a scan-out can tear it.
fn time_us(state: u64, cyc: u64) -> u64 {
    let kh: u64 = time.khz(state)
    if kh < 1000 {
        return 0
    }
    return cyc / (kh / 1000)
}

fn flush_box(state: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    // W-VBLANK: with a working scan-line counter the copy waits until the raster is out of the rows it writes (returns at once otherwise)
    beam.wait(state, x0, y0, x1 - x0, y1 - y0)
    let t0: u64 = time.tsc()
    let o0: u64 = fb.tx_octets(state)
    if fb.fullrows_an(state) {
        fb.dirty(state, y0, y1)
        fb.flush(state)
    } else {
        var fw: u64 = x1 - x0
        if pixelguard.bug_is(4) && fw > 1 {
            fw = fw - 1
        }
        fb.flush_region(state, x0, y0, fw, y1 - y0)
    }
    let t1: u64 = time.tsc()
    if wmlayout.gs(state, wmlayout.S_PL_ON) != 0 {
        pl_record(state, 0, x0, y0, x1, y1, t0, 0)
    }
    fb.flush_note(state, ph_us(state, t0, t1), fb.tx_octets(state) - o0)
    beam.note(state, ph_us(state, t0, t1), fb.tx_octets(state) - o0)
}

// W-VBLANK: merge the rectangles of one frame. Two rectangles become one when they overlap, or when the union is at most a quarter larger than
// the two together (a few more octets copied, one pass instead of two). `rs` holds `n` rectangles of 4 words (x0, y0, x1, y1); returns the new count.
fn rects_merge(rs: u64, n0: u64) -> u64 {
    var n: u64 = n0
    var again: bool = true
    while again && n > 1 {
        again = false
        var i: u64 = 0
        while i < n && !again {
            var j: u64 = i + 1
            while j < n && !again {
                let ax0: u64 = __mmio_read64((rs + (i * 4) * 8) as *mut u64)
                let ay0: u64 = __mmio_read64((rs + (i * 4 + 1) * 8) as *mut u64)
                let ax1: u64 = __mmio_read64((rs + (i * 4 + 2) * 8) as *mut u64)
                let ay1: u64 = __mmio_read64((rs + (i * 4 + 3) * 8) as *mut u64)
                let bx0: u64 = __mmio_read64((rs + (j * 4) * 8) as *mut u64)
                let by0: u64 = __mmio_read64((rs + (j * 4 + 1) * 8) as *mut u64)
                let bx1: u64 = __mmio_read64((rs + (j * 4 + 2) * 8) as *mut u64)
                let by1: u64 = __mmio_read64((rs + (j * 4 + 3) * 8) as *mut u64)
                var ux0: u64 = ax0
                if bx0 < ux0 {
                    ux0 = bx0
                }
                var uy0: u64 = ay0
                if by0 < uy0 {
                    uy0 = by0
                }
                var ux1: u64 = ax1
                if bx1 > ux1 {
                    ux1 = bx1
                }
                var uy1: u64 = ay1
                if by1 > uy1 {
                    uy1 = by1
                }
                let aa: u64 = (ax1 - ax0) * (ay1 - ay0)
                let ba: u64 = (bx1 - bx0) * (by1 - by0)
                let ua: u64 = (ux1 - ux0) * (uy1 - uy0)
                var join: bool = false
                if ax0 < bx1 && bx0 < ax1 && ay0 < by1 && by0 < ay1 {
                    join = true
                } else if ua * 100 <= (aa + ba) * 125 {
                    join = true
                }
                if join {
                    __mmio_write64((rs + (i * 4) * 8) as *mut u64, ux0)
                    __mmio_write64((rs + (i * 4 + 1) * 8) as *mut u64, uy0)
                    __mmio_write64((rs + (i * 4 + 2) * 8) as *mut u64, ux1)
                    __mmio_write64((rs + (i * 4 + 3) * 8) as *mut u64, uy1)
                    // the last rectangle takes the place of j
                    var k: u64 = 0
                    while k < 4 {
                        __mmio_write64((rs + (j * 4 + k) * 8) as *mut u64, __mmio_read64((rs + ((n - 1) * 4 + k) * 8) as *mut u64))
                        k = k + 1
                    }
                    n = n - 1
                    again = true
                }
                j = j + 1
            }
            i = i + 1
        }
    }
    return n
}

// W-VBLANK: ONE PASS FOR ALL RECTANGLES OF A FRAME. Every rectangle was painted into the back buffer first; now they go to the card
// back to back (each held back for the raster when beam sync works), and the dirty-row marks the painters left are spent once at the end.
fn flush_many(state: u64, rs: u64, n: u64) {
    var us_sum: u64 = 0
    var okt_sum: u64 = 0
    var ylo: u64 = 0xFFFFFFFF
    var yhi: u64 = 0
    var i: u64 = 0
    while i < n {
        let x0: u64 = __mmio_read64((rs + (i * 4) * 8) as *mut u64)
        let y0: u64 = __mmio_read64((rs + (i * 4 + 1) * 8) as *mut u64)
        let x1: u64 = __mmio_read64((rs + (i * 4 + 2) * 8) as *mut u64)
        let y1: u64 = __mmio_read64((rs + (i * 4 + 3) * 8) as *mut u64)
        if x1 > x0 && y1 > y0 {
            beam.wait(state, x0, y0, x1 - x0, y1 - y0)
            let ta: u64 = time.tsc()
            let oa: u64 = fb.tx_octets(state)
            var fw: u64 = x1 - x0
            if pixelguard.bug_is(4) && fw > 1 {
                fw = fw - 1
            }
            fb.flush_rect(state, x0, y0, fw, y1 - y0)
            if wmlayout.gs(state, wmlayout.S_PL_ON) != 0 {
                pl_record(state, 0, x0, y0, x1, y1, ta, 0)
            }
            us_sum = us_sum + ph_us(state, ta, time.tsc())
            okt_sum = okt_sum + (fb.tx_octets(state) - oa)
            if y0 < ylo {
                ylo = y0
            }
            if y1 > yhi {
                yhi = y1
            }
        }
        i = i + 1
    }
    if yhi > ylo {
        let tb: u64 = time.tsc()
        let ob: u64 = fb.tx_octets(state)
        fb.flush_done(state, ylo, yhi)
        us_sum = us_sum + ph_us(state, tb, time.tsc())
        okt_sum = okt_sum + (fb.tx_octets(state) - ob)
    }
    fb.flush_note(state, us_sum, okt_sum)
    beam.note(state, us_sum, okt_sum)
}

// One rectangle of the frame: grow it over the blurring windows it touches, then the desktop, the windows from bottom to top,
// the layers above them, the pointer and the hand-over to `present`. Returns the number of pixels of the (grown) rectangle.
fn compose_rect(state: u64, bx0: u64, by0: u64, bx1: u64, by1: u64, outr: u64) -> u64 {
    var x0: u64 = bx0
    var y0: u64 = by0
    var x1: u64 = bx1
    var y1: u64 = by1
    // ============================== FIX 04.10.2026: THE MENU BLUR BAND
    //
    // Justin, Dell: moving the mouse over the start menu smeared a band of
    // it (the window's own text, blurred). THE SAME RULE AS THE BAR'S
    // (see `damage`), FOR EVERY WINDOW THAT BLURS. `paint_win` blurs the
    // WHOLE outer rectangle of such a window from what stands in the second
    // buffer, but paints the window itself only inside the dirty
    // rectangle. A pointer or a hover row dirties a small strip: the blur
    // then read the window's OLD pixels (the rest of the window was not
    // repainted from the desktop up) and wrote them blurred over the full
    // width of the window; the text came back only inside the strip.
    // So a dirty rectangle that touches a blurring window grows to that
    // window's whole rectangle: the desktop is repainted under all of it,
    // the blur reads a clean background, the window is painted over all
    // of it. Grown windows can touch further ones, so up to three rounds.
    // `noglasgrow` switches this off (the counter-proof of the tests).
    if wmlayout.gs(state, wmlayout.S_NOGROW) == 0 && wmgeom.form(state, wmlayout.FM_BLUR) > 0 {
        var rounds: u64 = 0
        var grew: bool = true
        while grew && rounds < 3 {
            grew = false
            rounds = rounds + 1
            var wi: u64 = 0
            while wi < wmbase.MAX_WIN {
                if wmblur.blur_will(state, wi) && !wmblur.blur_hit_ok(state, wi) {
                    var qx0: i64 = wmbase.win_x(state, wi)
                    var qy0: i64 = wmbase.win_y(state, wi)
                    var qx1: i64 = qx0 + wmbase.outer_w(state, wi) as i64
                    var qy1: i64 = qy0 + wmbase.outer_h(state, wi) as i64
                    if qx0 < 0 {
                        qx0 = 0
                    }
                    if qy0 < 0 {
                        qy0 = 0
                    }
                    if qx1 > wmlayout.gs(state, wmlayout.S_SW) as i64 {
                        qx1 = wmlayout.gs(state, wmlayout.S_SW) as i64
                    }
                    if qy1 > wmlayout.gs(state, wmlayout.S_SH) as i64 {
                        qy1 = wmlayout.gs(state, wmlayout.S_SH) as i64
                    }
                    if qx1 > x0 as i64 && qx0 < x1 as i64
                        && qy1 > y0 as i64 && qy0 < y1 as i64 {
                        if (qx0 as u64) < x0 {
                            x0 = qx0 as u64
                            grew = true
                        }
                        if (qy0 as u64) < y0 {
                            y0 = qy0 as u64
                            grew = true
                        }
                        if (qx1 as u64) > x1 {
                            x1 = qx1 as u64
                            grew = true
                        }
                        if (qy1 as u64) > y1 {
                            y1 = qy1 as u64
                            grew = true
                        }
                    }
                }
                wi = wi + 1
            }
        }
    }
    // PRESENT LOG: hash of the shared client buffers before the frame is composed (see pl_compose_begin)
    var pl_b: [u64; 3] = [0 as u64; 3]
    let pl_on_here: bool = wmlayout.gs(state, wmlayout.S_PL_ON) != 0
    if pl_on_here {
        pl_compose_begin(state, (&pl_b[0]) as u64)
    }
    let ph_a0: u64 = time.tsc()
    // 1. der Hintergrund
    fb.fill(state, x0, y0, x1 - x0, y1 - y0, wmlayout.gs(state, wmlayout.S_DESK))
    // 1b. die Reiter- und Stapelzeilen des Baumes. Sie liegen UNTER den
    //     Fenstern und ueberschneiden sie nicht -- der Baum hat ihre
    //     Hoehe von der Flaeche der Kinder abgezogen.
    if wmlayout.gs(state, wmlayout.S_TILE) != 0 {
        paint_bars(state, x0, y0, x1, y1)
    }
    ph_add(state, wmlayout.S_PH_BG, ph_a0, time.tsc())
    // 2. die Fenster, von unten nach oben
    let ph_b: u64 = time.tsc()
    var z: u64 = 0
    while z < wmlayout.gs(state, wmlayout.S_COUNT) {
        let i: u64 = wmbase.at_z(state, z)
        // RUNDE DESKTOP: ein minimiertes Fenster wird uebergangen. Es
        // ist der einzige Unterschied zwischen "minimiert" und
        // "geschlossen", den das Zusammensetzen sieht.
        // RUNDE TILING: und ein Fenster, das hinter einem Reiter liegt,
        // ebenfalls. Zwei Gruende, nicht zu malen, ZWEI Bits -- die
        // Runde TILING hatte dafuer ein eigenes Wort, aber "minimiert"
        // und "hinter einem Reiter" muessen sich getrennt aufheben
        // lassen.
        // RUNDE ALLTAG: WAEHREND DER SPERRE WIRD NUR DER SPERRER
        // GEMALT. Eine Ebene ueber allem waere zu wenig: der Starter
        // liegt auch oben, und im ersten Anlauf stand er im Bild des
        // Sperrbildschirms. Was nicht dem Sperrer gehoert, ist waehrend
        // der Sperre nicht auf dem Schirm -- und der Inhalt eines
        // fremden Fensters ist damit auch nicht ablesbar.
        if i < wmbase.MAX_WIN && (wmlayout.wg(state, i, wmlayout.W_FLAGS) & (wmlayout.F_HIDDEN | wmlayout.F_TABBED)) == 0
            && wmgate.darf(state, i) {
            let pw_t: u64 = time.tsc()
            paint_win(state, i, x0, y0, x1, y1)
            if fb.phases_an(state) {
                let pw_us: u64 = ph_us(state, pw_t, time.tsc())
                if pw_us > 8000 {
                    var s_pw: [u8; 17] = "wm: slowwin win=\0"
                    var s_pw2: [u8; 5] = " us=\0"
                    var s_pw3: [u8; 5] = " px=\0"
                    serial.puts((&s_pw[0]) as u64)
                    serial.dec(i)
                    serial.puts((&s_pw2[0]) as u64)
                    serial.dec(pw_us)
                    serial.puts((&s_pw3[0]) as u64)
                    serial.dec(wmlayout.wg(state, i, wmlayout.W_PX))
                    serial.nl()
                }
            }
        }
        z = z + 1
    }
    let ph_c: u64 = time.tsc()
    ph_add(state, wmlayout.S_PH_WIN, ph_b, ph_c)
    if pl_on_here {
        pl_compose_end(state, (&pl_b[0]) as u64)
    }
    // 2a. RUNDE VSYNC: die Signatur der Zerreissprobe, ueber der
    //     Fensterflaeche und unter allem, was darueber liegt. Sie wird
    //     je Fenster gemalt, damit ein Foto sie JE FENSTER vergleichen
    //     kann -- ein Streifen quer ueber den Schirm haette nicht
    //     gezeigt, welches Fenster zerrissen ist.
    if wmlayout.gs(state, wmlayout.S_SIG) != 0 {
        var zs: u64 = 0
        while zs < wmlayout.gs(state, wmlayout.S_COUNT) {
            let si: u64 = wmbase.at_z(state, zs)
            if si < wmbase.MAX_WIN
                && (wmlayout.wg(state, si, wmlayout.W_FLAGS) & (wmlayout.F_HIDDEN | wmlayout.F_TABBED)) == 0 {
                paint_sig(state, si, x0 as i64, y0 as i64, x1 as i64,
                    y1 as i64)
            }
            zs = zs + 1
        }
    }
    let tp_sig: u64 = time.tsc()
    // 2b. das Vorschaurechteck beim Ziehen -- ueber den Fenstern, unter
    //     dem Zeiger.
    if wmlayout.gs(state, wmlayout.S_PVON) != 0 {
        paint_preview(state, x0, y0, x1, y1)
    }
    // 2c. ROUND ACTION-BUS-5 (AB-004): the trusted dialog, over every
    //     window and under the pointer only
    let tp_pv: u64 = time.tsc()
    paint_switcher(state, x0, y0, x1, y1) // W1d: the Alt+Tab panel, over the windows
    td_paint(state, x0, y0, x1, y1)
    let tp_td: u64 = time.tsc()
    // 3. der Zeiger, ganz oben
    //
    // RUNDE GPU (G-012): NUR NOCH, WENN IHN NIEMAND ANDERES TRAEGT.
    // Liegt der Zeiger als eigene Flaeche auf dem Geraet, waere dieses
    // Malen nicht nur ueberfluessig, sondern falsch -- man saehe ihn
    // DOPPELT, einmal im Bild und einmal darueber. `hwcur_an` ist
    // deshalb die Bedingung fuer BEIDES: fuer das Malen hier und fuer
    // den Schaden bei der Bewegung.
    if wmlayout.gs(state, wmlayout.S_CURON) != 0 && !wmcursor.hwcur_an(state) {
        wmcursor.paint_cursor(state, x0, y0, x1, y1)
    }
    let tp_cur: u64 = time.tsc()
    // 4. ROUND A11Y-2: THE MAGNIFIER, ON TOP OF EVERYTHING -- after the
    //    pointer, so the pointer is in the magnified picture too. It
    //    reads from the finished picture (`fb.get_pixel` reads the draw
    //    target), so it magnifies what is ON THE SCREEN, not one window.
    if ax.mag(state) {
        wmmag.paint_mag(state)
    }
    // RUNDE VSYNC: DIE WEICHE. Mit Bildgrenze wird das Rechteck nur
    // VORGEMERKT -- `present` uebertraegt es im Takt, und zwar als
    // Ganzes. Ohne (die Gegenprobe `nopresent`) geht es den alten Weg
    // und wird sofort geschoben; dann MUSS die Zerreissprobe wieder
    // gemischte Signaturen finden.
    let ph_d: u64 = time.tsc()
    ph_add(state, wmlayout.S_PH_TOP, ph_c, ph_d)
    // r481: with `phases`, a frame whose top layer took over 8 ms says which part it was (signature, preview, trusted dialog, pointer, magnifier)
    if ph_us(state, ph_c, ph_d) > 8000 && fb.phases_an(state) {
        var s_t0: [u8; 13] = "wm: toplong \0"
        var s_t1: [u8; 6] = " sig=\0"
        var s_t2: [u8; 5] = " pv=\0"
        var s_t3: [u8; 5] = " td=\0"
        var s_t4: [u8; 6] = " cur=\0"
        var s_t5: [u8; 6] = " mag=\0"
        serial.puts((&s_t0[0]) as u64)
        serial.puts((&s_t1[0]) as u64)
        serial.dec(ph_us(state, ph_c, tp_sig))
        serial.puts((&s_t2[0]) as u64)
        serial.dec(ph_us(state, tp_sig, tp_pv))
        serial.puts((&s_t3[0]) as u64)
        serial.dec(ph_us(state, tp_pv, tp_td))
        serial.puts((&s_t4[0]) as u64)
        serial.dec(ph_us(state, tp_td, tp_cur))
        serial.puts((&s_t5[0]) as u64)
        serial.dec(ph_us(state, tp_cur, ph_d))
        serial.nl()
    }
    // vboxlag: with `phases`, a composed rectangle over 16384 px is printed with the dirty box it grew from
    if fb.phases_an(state) && (x1 - x0) * (y1 - y0) > 16384 {
        var s_c0: [u8; 11] = "wm: crect \0"
        var s_c1: [u8; 6] = " in= \0"
        serial.puts((&s_c0[0]) as u64)
        serial.dec(x0)
        serial.put(32 as u8)
        serial.dec(y0)
        serial.put(32 as u8)
        serial.dec(x1)
        serial.put(32 as u8)
        serial.dec(y1)
        serial.puts((&s_c1[0]) as u64)
        serial.dec(bx0)
        serial.put(32 as u8)
        serial.dec(by0)
        serial.put(32 as u8)
        serial.dec(bx1)
        serial.put(32 as u8)
        serial.dec(by1)
        serial.nl()
    }
    if pixelguard.rendering() {
        return (x1 - x0) * (y1 - y0)
    }
    if wmlayout.gs(state, wmlayout.S_VSYNC) != 0 {
        pend_add(state, x0, y0, x1, y1)
        wmlayout.ss(state, wmlayout.S_SKIPPED, wmlayout.gs(state, wmlayout.S_SKIPPED) + 1)
    } else if cp_on(state) {
        // COMPOSITOR S5: the finished rectangle waits for the compositor in ring 3 (the watchdog pushes it when it takes too long)
        cp_hand(state, x0, y0, x1, y1)
    } else if outr != 0 {
        // W-VBLANK: the caller collects the finished rectangles of the frame and copies them together
        __mmio_write64(outr as *mut u64, x0)
        __mmio_write64((outr + 8) as *mut u64, y0)
        __mmio_write64((outr + 16) as *mut u64, x1)
        __mmio_write64((outr + 24) as *mut u64, y1)
    } else {
        flush_box(state, x0, y0, x1, y1)
        wmlayout.ss(state, wmlayout.S_CP_NKP, wmlayout.gs(state, wmlayout.S_CP_NKP) + 1)
        cp_lat(state, false)
    }
    ph_add(state, wmlayout.S_PH_PEND, ph_d, time.tsc())
    return (x1 - x0) * (y1 - y0)
}

// One frame of the composed picture: the dirty box or its rectangles are painted by `compose_rect` (background, then every window
// from the bottom to the top that touches the rectangle), and the frame time is counted here.
fn compose_one(state: u64) -> u64 {
    if !wmbase.ready(state) || !fb.ready(state) {
        return 0
    }
    // ROUND A11Y-2: WITH THE MAGNIFIER ITS PANEL IS ALWAYS PART OF THE
    // DIRTY AREA -- and so is the place it stood last time, if it moved.
    // Without this the panel would be painted and not transferred, or
    // its old picture would stay on the screen.
    if ax.mag(state) {
        wmmag.mag_damage(state)
    } else if wmlayout.gs(state, wmlayout.S_MAGLX) != 0 {
        // switched off: the old panel goes away
        let ox: u64 = wmlayout.gs(state, wmlayout.S_MAGLX) - 1
        wmlayout.ss(state, wmlayout.S_MAGLX, 0)
        wmbase.damage(state, ox as i64, 0, (ox + wmmag.MAG_W) as i64, wmmag.MAG_H as i64)
    }
    var bt: [u64; 4] = [0 as u64; 4]
    if !wmglass.box_take(state, (&bt[0]) as u64) {
        return 0
    }
    let x0: u64 = bt[0]
    let y0: u64 = bt[1]
    let x1: u64 = bt[2]
    let y1: u64 = bt[3]
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    // ROUND VSYNC: THE FRAME NUMBER RISES HERE and not when the picture is
    // transferred. Everything painted in this run belongs to ONE frame and
    // carries the same signature.
    wmlayout.ss(state, wmlayout.S_FRAME, wmlayout.gs(state, wmlayout.S_FRAME) + 1)
    // ROUND WMPLUGIN: THE BROOM, ONCE A FRAME. Eight comparisons, no
    // waiting, no allocation -- it throws out whoever was called and does
    // not come. THIS IS THE ONLY PLACE IN THE COMPOSE PATH that knows
    // anything about plug-ins.
    wmplug.sweep(state)
    // ROUND VEKTOR: the clock for this frame.
    let t_start: u64 = time.tsc()
    // r481: where the time of a slow frame went (only with the kernel word `phases`; see the `wm: slow` line below)
    let sl_bg: u64 = wmlayout.gs(state, wmlayout.S_PH_BG)
    let sl_win: u64 = wmlayout.gs(state, wmlayout.S_PH_WIN)
    let sl_top: u64 = wmlayout.gs(state, wmlayout.S_PH_TOP)
    let sl_pend: u64 = wmlayout.gs(state, wmlayout.S_PH_PEND)
    let sl_blur: u64 = wmlayout.gs(state, wmlayout.S_PH_BLUR)
    let sl_shd: u64 = wmlayout.gs(state, wmlayout.S_PH_SHADOW)
    let sl_drg: u64 = wmlayout.gs(state, wmlayout.S_PH_DRAG)
    let sl_gls: u64 = wmlayout.gs(state, wmlayout.S_PH_GLASS)
    // r461: with a region of several rectangles, paint them one by one (never with the magnifier: it paints one panel over
    // the finished picture and must see the whole picture once)
    var rs: [u64; 64] = [0 as u64; 64]
    var nr: u64 = 0
    if !ax.mag(state) {
        nr = rgn_take(state, (&rs[0]) as u64, x0, y0, x1, y1)
    } else {
        nr = 0
    }
    var painted: u64 = 0
    if nr == 0 {
        painted = compose_rect(state, x0, y0, x1, y1, 0)
    } else {
        wmlayout.ss(state, wmlayout.S_RFRAMES, wmlayout.gs(state, wmlayout.S_RFRAMES) + 1)
        // W-VBLANK: in the shipping path (no frame boundary, no compositor) the rectangles are painted one after the other into the back buffer and
        // then merged and copied to the card in ONE pass; `fullrows` keeps the old copy per rectangle (counter-proof).
        let collect: bool = wmlayout.gs(state, wmlayout.S_VSYNC) == 0 && !cp_on(state) && !fb.fullrows_an(state)
        var ri: u64 = 0
        while ri < nr {
            var outp: u64 = 0
            if collect {
                outp = (&rs[(ri * 4) as usize]) as u64
            }
            var rx1: u64 = rs[(ri * 4 + 2) as usize]
            if pixelguard.bug_is(1) && rx1 > rs[(ri * 4) as usize] + 1 {
                rx1 = rx1 - 1
            }
            painted = painted + compose_rect(state, rs[(ri * 4) as usize], rs[(ri * 4 + 1) as usize],
                rx1, rs[(ri * 4 + 3) as usize], outp)
            ri = ri + 1
        }
        if collect {
            // compose_rect wrote the grown rectangle over its own slot (the arguments were read before the call)
            let nm: u64 = rects_merge((&rs[0]) as u64, nr)
            fb.bm_add(state, fb.S_RM_IN, nr)
            fb.bm_add(state, fb.S_RM_OUT, nm)
            flush_many(state, (&rs[0]) as u64, nm)
            wmlayout.ss(state, wmlayout.S_CP_NKP, wmlayout.gs(state, wmlayout.S_CP_NKP) + nm)
            cp_lat(state, false)
        }
    }
    wmlayout.ss(state, wmlayout.S_PH_PX, wmlayout.gs(state, wmlayout.S_PH_PX) + painted)
    wmlayout.ss(state, wmlayout.S_PH_N, wmlayout.gs(state, wmlayout.S_PH_N) + 1)
    wmlayout.ss(state, wmlayout.S_COMPOSITES, wmlayout.gs(state, wmlayout.S_COMPOSITES) + 1)
    wmlayout.ss(state, wmlayout.S_PIXELS, wmlayout.gs(state, wmlayout.S_PIXELS) + painted)
    // RUNDE VEKTOR: die Bildzeit. `khz` ist die Zyklenzahl je
    // Millisekunde; geteilt durch 1000 sind es die je Mikrosekunde.
    // Ist die Uhr noch nicht geeicht (khz == 0), wird nichts gezaehlt
    // -- eine Division durch null waere hier ein Absturz im Bildtakt.
    let kh: u64 = time.khz(state)
    if kh >= 1000 {
        let t_ende: u64 = time.tsc()
        // Als Subtraktion auf der Seite, die gross genug ist: der
        // Zyklenzaehler kann zwischen zwei Ablesungen nicht kleiner
        // werden, aber ein Weltwechsel in eine Gastmaschine kann ihn
        // zuruecksetzen. Dann wird dieses eine Bild nicht gezaehlt.
        if t_ende > t_start {
            let us: u64 = (t_ende - t_start) / (kh / 1000)
            wmlayout.ss(state, wmlayout.S_FRUS, wmlayout.gs(state, wmlayout.S_FRUS) + us)
            wmlayout.ss(state, wmlayout.S_FRN, wmlayout.gs(state, wmlayout.S_FRN) + 1)
            wmlayout.ss(state, wmlayout.S_FRLAST, us)
            if us > wmlayout.gs(state, wmlayout.S_FRMAX) {
                wmlayout.ss(state, wmlayout.S_FRMAX, us)
            }
            if us > 16000 {
                wmlayout.ss(state, wmlayout.S_FRUEBER, wmlayout.gs(state, wmlayout.S_FRUEBER) + 1)
                if fb.phases_an(state) {
                    var s_sl: [u8; 13] = "wm: slow us=\0"
                    var s_s1: [u8; 5] = " bg=\0"
                    var s_s2: [u8; 6] = " win=\0"
                    var s_s3: [u8; 6] = " top=\0"
                    var s_s4: [u8; 7] = " pend=\0"
                    var s_s5: [u8; 7] = " blur=\0"
                    var s_s6: [u8; 6] = " shd=\0"
                    var s_s7: [u8; 6] = " drg=\0"
                    var s_s8: [u8; 6] = " gls=\0"
                    var s_s9: [u8; 5] = " px=\0"
                    serial.puts((&s_sl[0]) as u64)
                    serial.dec(us)
                    serial.puts((&s_s1[0]) as u64)
                    serial.dec(wmlayout.gs(state, wmlayout.S_PH_BG) -% sl_bg)
                    serial.puts((&s_s2[0]) as u64)
                    serial.dec(wmlayout.gs(state, wmlayout.S_PH_WIN) -% sl_win)
                    serial.puts((&s_s3[0]) as u64)
                    serial.dec(wmlayout.gs(state, wmlayout.S_PH_TOP) -% sl_top)
                    serial.puts((&s_s4[0]) as u64)
                    serial.dec(wmlayout.gs(state, wmlayout.S_PH_PEND) -% sl_pend)
                    serial.puts((&s_s5[0]) as u64)
                    serial.dec(wmlayout.gs(state, wmlayout.S_PH_BLUR) -% sl_blur)
                    serial.puts((&s_s6[0]) as u64)
                    serial.dec(wmlayout.gs(state, wmlayout.S_PH_SHADOW) -% sl_shd)
                    serial.puts((&s_s7[0]) as u64)
                    serial.dec(wmlayout.gs(state, wmlayout.S_PH_DRAG) -% sl_drg)
                    serial.puts((&s_s8[0]) as u64)
                    serial.dec(wmlayout.gs(state, wmlayout.S_PH_GLASS) -% sl_gls)
                    serial.puts((&s_s9[0]) as u64)
                    serial.dec(painted)
                    serial.nl()
                }
            }
            // RUNDE ZIEH: dasselbe Bild noch einmal, aber nur,
            // wenn in ihm ein Fenster AUFGEHOBEN gemalt wurde.
            // `zieh_frame` wird von `compose` gesetzt und hier
            // wieder geloescht -- so zaehlt genau das Bild, das den
            // teuren Weg gegangen ist, und keines daneben.
            if wmlayout.gs(state, wmlayout.S_ZFLAG) == 0 {
                // Ein Bild ohne aufgehobenes Fenster -- die
                // Grundlast derselben Maschine im selben Lauf.
                wmlayout.ss(state, wmlayout.S_OFRN, wmlayout.gs(state, wmlayout.S_OFRN) + 1)
                wmlayout.ss(state, wmlayout.S_OFRUS, wmlayout.gs(state, wmlayout.S_OFRUS) + us)
                if us > wmlayout.gs(state, wmlayout.S_OFRMAX) {
                    wmlayout.ss(state, wmlayout.S_OFRMAX, us)
                }
            }
            if wmlayout.gs(state, wmlayout.S_ZFLAG) != 0 {
                wmlayout.ss(state, wmlayout.S_ZFLAG, 0)
                wmlayout.ss(state, wmlayout.S_ZFRN, wmlayout.gs(state, wmlayout.S_ZFRN) + 1)
                wmlayout.ss(state, wmlayout.S_ZFRUS, wmlayout.gs(state, wmlayout.S_ZFRUS) + us)
                if us > wmlayout.gs(state, wmlayout.S_ZFRMAX) {
                    wmlayout.ss(state, wmlayout.S_ZFRMAX, us)
                }
                if us > 16700 {
                    wmlayout.ss(state, wmlayout.S_ZFRUE, wmlayout.gs(state, wmlayout.S_ZFRUE) + 1)
                }
            }
            // Das Fach: die Verdoppelung, in der diese Zeit liegt.
            var fach: u64 = 0
            var g: u64 = 1000
            while fach < 7 && us >= g {
                g = g * 2
                fach = fach + 1
            }
            wmlayout.ss(state, wmlayout.S_FRH + fach * 8, wmlayout.gs(state, wmlayout.S_FRH + fach * 8) + 1)
            // Und dasselbe noch einmal, aber erst ab dem elften Bild.
            if wmlayout.gs(state, wmlayout.S_FRN) > 10 {
                if us > wmlayout.gs(state, wmlayout.S_FRMAXW) {
                    wmlayout.ss(state, wmlayout.S_FRMAXW, us)
                }
                if us > 16000 {
                    wmlayout.ss(state, wmlayout.S_FRUEBERW, wmlayout.gs(state, wmlayout.S_FRUEBERW) + 1)
                }
            }
        }
    }
    return painted
}

// ------------------------------------------- RUNDE VEKTOR: DIE BILDZEIT
//
// Fuenf Ableser, damit die Abnahme die Zahlen holen kann, ohne die
// Offsets zu kennen.

fn frame_us_sum(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_FRUS)
}

fn frame_us_n(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_FRN)
}

fn frame_us_max(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_FRMAX)
}

fn frame_us_last(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_FRLAST)
}

fn frame_ueber16(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_FRUEBER)
}

// Ein Fach des Histogramms, 0..7.
fn frame_fach(state: u64, i: u64) -> u64 {
    if i > 7 {
        return 0
    }
    return wmlayout.gs(state, wmlayout.S_FRH + i * 8)
}

// Der Betrieb, also ohne die ersten zehn Bilder.
fn frame_us_maxw(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_FRMAXW)
}

fn frame_ueber16w(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_FRUEBERW)
}

// WIE VIELE TASTEN BEI DIESEM FENSTER ANGEKOMMEN SIND. Die Zahl ist die
// Gegenprobe zum Eingabefokus: mit Fokus MUSS sie beim unbeteiligten
// Fenster null sein, mit `nofocus` MUSS sie es nicht sein. Ohne diese
// zwei Zahlen waere "die Taste geht an das richtige Fenster" eine
// Behauptung ueber etwas, das man im Bild nicht sieht.
fn win_keys(state: u64, i: u64) -> u64 {
    if i >= wmbase.MAX_WIN {
        return 0
    }
    return wmlayout.wg(state, i, wmlayout.W_KEYS)
}

fn downs(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_DOWNS)
}

fn moves_seen(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_MOVES)
}

fn hits_seen(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_HITS)
}

// DIE VORFUEHRUNG FASST AN UND LAESST LOS -- ueber dieselben zwei
// Wege wie der Zeiger.
//
// Sie stehen hier und nicht in `kgui.fi`, weil `S_DRAG`, `S_DRAGX`
// und `S_DRAGY` diesem Modul gehoeren. Ein zweiter Ort, der sie
// setzt, waere ein zweiter Ort, an dem der Zustand des Ziehens
// falsch sein kann -- und genau daran ist die Oeffnungsbewegung des
// Startmenues in der vorigen Runde gescheitert.
// Die wahre Lage, oeffentlich -- fuer die Vorfuehrung, die sie in
// die serielle Leitung schreibt. `win_x`/`win_y` sind modulintern.
fn win_x_pub(state: u64, i: u64) -> i64 {
    return wmbase.win_x(state, i)
}

fn win_y_pub(state: u64, i: u64) -> i64 {
    return wmbase.win_y(state, i)
}

fn drag_begin_pub(state: u64, i: u64, gx: u64, gy: u64) {
    if !wmbase.valid(state, i) {
        return
    }
    drag_begin(state, i)
    wmlayout.ss(state, wmlayout.S_DRAG, i + 1)
    wmlayout.ss(state, wmlayout.S_DRAGX, gx)
    wmlayout.ss(state, wmlayout.S_DRAGY, gy)
}

fn drag_end_pub(state: u64, i: u64) {
    if !wmbase.valid(state, i) {
        return
    }
    wmlayout.ss(state, wmlayout.S_DRAG, 0)
    drag_end(state, i, wmbase.win_x(state, i), wmbase.win_y(state, i))
}

// W-DRAG: THE FRAME, THE TITLE BAR AND THE CAPTION BUTTONS OF A LIFTED WINDOW.
//
// `paint_win_drag` copies only the client area, so a dragged window lost its frame, its title bar and its caption buttons for the whole
// drag and the swing after the release (Justin, Dell 3440x1440, scale 2: "the title bar disappears while I drag"). The old comment said
// nobody needs the bar for half a second -- but the bar is the thing the user HOLDS. It is painted here with the geometry of the lifted
// client rectangle: same height as always (a bar scaled by 105 percent would be a blurred edge), as wide as the lifted client plus the frame.
// `late` = the second call, after the client area: the caption buttons of a window that paints its own strip lie over the strip.
fn paint_drag_chrome(state: u64, i: u64, wx: i64, wy: i64, ow: i64, oh: i64, cx0: i64, cy0: i64, cx1: i64, cy1: i64, late: bool) {
    if !wmbase.deko(state, i) || fb.nodragbar_an(state) {
        return
    }
    let ax0: i64 = wmbase.imax(wx, cx0)
    let ay0: i64 = wmbase.imax(wy, cy0)
    let ax1: i64 = wmbase.imin(wx + ow, cx1)
    let ay1: i64 = wmbase.imin(wy + oh, cy1)
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    let aktiv: bool = wmbase.focus(state) == i
    var rahmen: u64 = wmbase.deco(state, wmlayout.DK_FRAME)
    var titel: u64 = wmbase.deco(state, wmlayout.DK_TITLE)
    var schrift: u64 = wmbase.deco(state, wmlayout.DK_TEXT)
    if aktiv {
        rahmen = wmbase.deco(state, wmlayout.DK_FRAME_ON)
        titel = wmbase.deco(state, wmlayout.DK_TITLE_ON)
        schrift = wmbase.deco(state, wmlayout.DK_TEXT_ON)
    }
    let capc: bool = cap_client(state, i)
    if late {
        if capc {
            if wmgeom.form(state, wmlayout.FM_CAPTION) != 0 {
                paint_caption(state, i, wx, wy, ow, titel, schrift, ax0, ay0, ax1, ay1)
            } else {
                paint_close_classic(state, wx, wy, ow, ax0, ay0, ax1, ay1)
            }
        }
        return
    }
    // The frame colour only where the client area will NOT cover it: four bands (top with the bar, bottom, left, right) through the same
    // rounded fill with a narrower clip each. A fill of the whole outer rectangle cost +0.5 ms a frame in stationaer.sh phase 5.
    let ry: i64 = wy + wmbase.iny(state, i) as i64
    let rb: i64 = wy + oh - wmgeom.border(state) as i64
    let rl: i64 = wx + wmgeom.border(state) as i64
    let rr: i64 = wx + ow - wmgeom.border(state) as i64
    let rad: u64 = wmgeom.form(state, wmlayout.FM_RADIUS)
    let dal: u64 = deco_alpha(state)
    if wmbase.imin(cy1, ry) > cy0 {
        wmdraw.fill_round(state, wx, wy, ow, oh, rad, rahmen, dal, cx0, cy0, cx1, wmbase.imin(cy1, ry))
    }
    if cy1 > wmbase.imax(cy0, rb) {
        wmdraw.fill_round(state, wx, wy, ow, oh, rad, rahmen, dal, cx0, wmbase.imax(cy0, rb), cx1, cy1)
    }
    if wmbase.imin(cy1, rb) > wmbase.imax(cy0, ry) {
        if wmbase.imin(cx1, rl) > cx0 {
            wmdraw.fill_round(state, wx, wy, ow, oh, rad, rahmen, dal, cx0, wmbase.imax(cy0, ry), wmbase.imin(cx1, rl), wmbase.imin(cy1, rb))
        }
        if cx1 > wmbase.imax(cx0, rr) {
            wmdraw.fill_round(state, wx, wy, ow, oh, rad, rahmen, dal, wmbase.imax(cx0, rr), wmbase.imax(cy0, ry), cx1, wmbase.imin(cy1, rb))
        }
    }
    if !capc {
        paint_title(state, i, wx, wy, ow, titel, schrift, ax0, ay0, ax1, ay1)
    }
    var bx: i64 = wx + ow - wmgeom.border(state) as i64 - wmgeom.close_w(state) as i64 - 3
    if wmgeom.form(state, wmlayout.FM_CAPTION) != 0 {
        bx = wx + ow - wmgeom.border(state) as i64 - (wmlayout.CAP_N * wmgeom.cap_w(state)) as i64
        if !capc {
            paint_caption(state, i, wx, wy, ow, titel, schrift, ax0, ay0, ax1, ay1)
        }
    } else if !capc {
        paint_close_classic(state, wx, wy, ow, ax0, ay0, ax1, ay1)
    }
    var before: i64 = 0
    let sicht: u64 = netview.view_of(state, wmbase.win_owner(state, i))
    if sicht != netview.V_REAL && sicht <= 3 && !capc {
        title_mark(state, sicht - 1, wx + wmgeom.border(state) as i64 + wmgeom.title_pad(state) as i64,
            wy + wmgeom.border(state) as i64 + ((wmgeom.title_h(state) - wmgeom.border(state) - netmark.H) / 2) as i64,
            schrift, ax0, ay0, ax1, ay1)
        before = netmark.W as i64 + 4
    }
    let f: u64 = wmlayout.gs(state, wmlayout.S_FONT_UI)
    if f < ttf.MAX_FONTS && !capc {
        title_text(state, i, f, wx + wmgeom.border(state) as i64 + wmgeom.title_pad(state) as i64 + before,
            wy + wmgeom.title_base(state, f), schrift, ax0, ay0, ax1, ay1, bx)
    }
}

// DAS GEZOGENE FENSTER MALEN -- Versatz und Skalierung um einen
// verschobenen Pivot.
//
// Der Pivot: bei FM_TILT = 0 die Mitte (das Fenster waechst
// gleichmaessig nach allen Seiten), bei 100 die angefasste Stelle. Sie
// steht in S_DRAGX/S_DRAGY, gesetzt beim Anfassen, relativ zur
// AUSSENecke des Fensters -- genau die Zahl, die dieser Rechenweg
// braucht, und sie liegt schon da.
fn paint_win_drag(state: u64, i: u64, cx0: i64, cy0: i64, cx1: i64,
    cy1: i64) {
    let bw: i64 = wmlayout.wg(state, i, wmlayout.W_W) as i64
    let bh: i64 = wmlayout.wg(state, i, wmlayout.W_H) as i64
    if bw <= 0 || bh <= 0 {
        return
    }
    let sk: u64 = wmanim.drag_scale(state, i)
    var nw: i64 = bw * sk as i64 / 1000
    var nh: i64 = bh * sk as i64 / 1000
    if nw <= 0 || nh <= 0 {
        return
    }
    // Die Malflaeche, wie sie ohne alles laege.
    let ix: i64 = wmbase.win_x(state, i) + wmgeom.border(state) as i64
    let iy: i64 = wmbase.win_y(state, i) + wmbase.iny(state, i) as i64
    // DER PIVOT. `ax`/`ay` ist die angefasste Stelle INNERHALB der
    // Malflaeche; `tl` mischt zwischen Mitte (0) und ihr (100).
    let tl: i64 = wmanim.drag_tilt_on(state) as i64
    var ax: i64 = bw / 2
    var ay: i64 = bh / 2
    if wmanim.is_dragged(state, i) {
        let gx: i64 = wmlayout.gs(state, wmlayout.S_DRAGX) as i64 - wmgeom.border(state) as i64
        let gy: i64 = wmlayout.gs(state, wmlayout.S_DRAGY) as i64 - wmbase.iny(state, i) as i64
        // Ausserhalb der Flaeche angefasst (Titelleiste, Rahmen) wird
        // auf sie geklemmt: ein Pivot ausserhalb des Bildes laesst die
        // Flaeche wegdriften statt wachsen.
        let px: i64 = wmbase.imin(wmbase.imax(gx, 0), bw)
        let py: i64 = wmbase.imin(wmbase.imax(gy, 0), bh)
        ax = bw / 2 + (px - bw / 2) * tl / 100
        ay = bh / 2 + (py - bh / 2) * tl / 100
    }
    // Um den Pivot skalieren heisst: der Punkt `a` liegt nachher dort,
    // wo er vorher lag. Alles andere waechst von ihm weg.
    var ox: i64 = ix + ax - ax * nw / bw
    var oy: i64 = iy + ay - ay * nh / bh
    // und der Nachzug legt sich darueber.
    ox = ox + wmanim.swing_dx(state, i)
    oy = oy + wmanim.swing_dy(state, i)
    // W-DRAG: the frame, title bar and caption buttons go with the lifted window (the client rectangle is the anchor)
    let fr_x: i64 = ox - wmgeom.border(state) as i64
    let fr_y: i64 = oy - wmbase.iny(state, i) as i64
    let fr_w: i64 = nw + 2 * wmgeom.border(state) as i64
    let fr_h: i64 = nh + wmbase.iny(state, i) as i64 + wmgeom.border(state) as i64
    paint_drag_chrome(state, i, fr_x, fr_y, fr_w, fr_h, cx0, cy0, cx1, cy1, false)
    let ax0: i64 = wmbase.imax(ox, cx0)
    let ay0: i64 = wmbase.imax(oy, cy0)
    let ax1: i64 = wmbase.imin(ox + nw, cx1)
    let ay1: i64 = wmbase.imin(oy + nh, cy1)
    if ax1 <= ax0 || ay1 <= ay0 {
        paint_drag_chrome(state, i, fr_x, fr_y, fr_w, fr_h, cx0, cy0, cx1, cy1, true)
        return
    }
    let buf: u64 = wmlayout.wg(state, i, wmlayout.W_BUF)
    let stride: u64 = wmlayout.wg(state, i, wmlayout.W_W)
    // KEINE DECKUNGSMISCHUNG. Ein gezogenes Fenster ist undurchsichtig
    // -- es wird aufgehoben, nicht eingeblendet --, und `pixel` ohne
    // Mischung ist der Weg, auf dem die 0,18 ms der Kostenmessung
    // gemessen sind.
    // r460: ROW BY ROW, NO CALL PER PIXEL. The first version called `fb.pixel` for every pixel (five state reads and three
    // compares each) and divided twice per pixel -- 15 ms for a 860x580 window. Now the clip is cut once, the row start is
    // one address, and the source column steps with an integer remainder (`sx = (x - ox) * bw / nw` exactly, so the picture
    // is the same pixel for pixel; `tools/wm` compares it).
    let sw: i64 = fb.width(state) as i64
    let shh: i64 = fb.height(state) as i64
    var cl0: i64 = wmbase.imax(ax0, 0)
    var cl1: i64 = wmbase.imin(ax1, sw)
    var ct0: i64 = wmbase.imax(ay0, fb.band_lo(state) as i64)
    var ct1: i64 = wmbase.imin(ay1, shh)
    // the source column also has to stay inside the window picture
    if cl0 < ox {
        cl0 = ox
    }
    if cl1 > ox + nw {
        cl1 = ox + nw
    }
    if cl1 > cl0 && ct1 > ct0 {
        let pitch: u64 = fb.pitch(state)
        let dst0: u64 = fb.draw_at(state)
        // the first source column of the row and its remainder: sx = q, rem = (x - ox) * bw - q * nw
        let num0: i64 = (cl0 - ox) * bw
        let q0: i64 = num0 / nw
        let r0: i64 = num0 - q0 * nw
        let qs: i64 = bw / nw
        let rs: i64 = bw - qs * nw
        // r465: the inner loop is assembly (`tools/blur/blurasm.py`, routine d; 752 + 2000 cases in `asmtest.c`). The old Firn loop
        // cost about 10 ns a pixel (stack code, overflow checks); the column test `0 <= q < bw` is gone because the clip above
        // keeps every x in [ox, ox + nw), which makes q = (x - ox) * bw / nw lie in [0, bw).
        var blk: [u64; 8] = [0 as u64; 8]
        blk[2] = (cl1 - cl0) as u64
        blk[3] = q0 as u64
        blk[4] = r0 as u64
        blk[5] = qs as u64
        blk[6] = rs as u64
        blk[7] = nw as u64
        var y: i64 = ct0
        while y < ct1 {
            let sy: i64 = (y - oy) * bh / nh
            if sy >= 0 && sy < bh {
                blk[0] = buf +% (sy as u64) *% stride *% 4
                blk[1] = dst0 +% (y as u64) *% pitch +% (cl0 as u64) *% 4
                asm("mov rdx,rdi\nmov rcx,[rdx+16]\ntest rcx,rcx\njz 0f\nmov rsi,[rdx]\nmov rdi,[rdx+8]\nmov r8,[rdx+24]\nmov r9,[rdx+32]\nmov r10,[rdx+40]\nmov r11,[rdx+48]\n1:\nmov eax,[rsi+r8*4]\nand eax,16777215\nmov [rdi],eax\nadd rdi,4\nadd r8,r10\nadd r9,r11\ncmp r9,[rdx+56]\njl 2f\nsub r9,[rdx+56]\ninc r8\n2:\ndec rcx\njnz 1b\n0:",
                    in("rdi") (&blk[0]) as u64,
                    clobber("rax"),
                    clobber("rcx"),
                    clobber("rdx"),
                    clobber("rsi"),
                    clobber("rdi"),
                    clobber("r8"),
                    clobber("r9"),
                    clobber("r10"),
                    clobber("r11"),
                    clobber("memory"))
            }
            y = y + 1
        }
    }
    paint_drag_chrome(state, i, fr_x, fr_y, fr_w, fr_h, cx0, cy0, cx1, cy1, true)
    wmlayout.wsv(state, i, wmlayout.W_PAINTS, wmlayout.wg(state, i, wmlayout.W_PAINTS) + 1)
    wmlayout.wsv(state, i, wmlayout.W_PX,
        wmlayout.wg(state, i, wmlayout.W_PX) + ((ax1 - ax0) * (ay1 - ay0)) as u64)
    wmlayout.ss(state, wmlayout.S_DRAGPX,
        wmlayout.gs(state, wmlayout.S_DRAGPX) + ((ax1 - ax0) * (ay1 - ay0)) as u64)
    wmlayout.ss(state, wmlayout.S_ZFLAG, 1)
}

fn set_blur_cache(state: u64, on: bool) {
    if on {
        wmlayout.ss(state, wmlayout.S_BC_AUS, 0)
    } else {
        wmlayout.ss(state, wmlayout.S_BC_AUS, 1)
    }
}

// ---------------------------------------------------------- die Ableser
fn blurs(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_BLURS)
}

// The old red close box of the classic shape (FM_CAPTION = 0): the same loop as before, in a function of its own so that a
// window with a client strip (r454) can paint it AFTER its client area.
fn paint_close_classic(state: u64, wx: i64, wy: i64, ow: i64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let bx: i64 = wx + ow - wmgeom.border(state) as i64 - wmgeom.close_w(state) as i64 - 3
    let by: i64 = wy + 4
    if bx + wmgeom.close_w(state) as i64 > ax0 && bx < ax1
        && by + wmgeom.close_w(state) as i64 > ay0 {
        let rot: u64 = wmbase.deco(state, wmlayout.DK_CLOSE)
        fb.fill(state, bx as u64, by as u64, wmgeom.close_w(state), wmgeom.close_w(state), rot)
        let weiss: u64 = wmbase.deco(state, wmlayout.DK_CLOSE_MARK)
        var k: u64 = 3
        while k < wmgeom.close_w(state) - 3 {
            fb.pixel(state, (bx + k as i64) as u64,
                (by + k as i64) as u64, weiss)
            fb.pixel(state, (bx + k as i64) as u64,
                (by + (wmgeom.close_w(state) - 1 - k) as i64) as u64, weiss)
            k = k + 1
        }
    }
}

fn paint_win(state: u64, i: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let wx: i64 = wmbase.win_x(state, i)
    let wy: i64 = wmbase.win_y(state, i)
    let ow: i64 = wmbase.outer_w(state, i) as i64
    let oh: i64 = wmbase.outer_h(state, i) as i64
    let ax0: i64 = wmbase.imax(wx, cx0 as i64)
    let ay0: i64 = wmbase.imax(wy, cy0 as i64)
    let ax1: i64 = wmbase.imin(wx + ow, cx1 as i64)
    let ay1: i64 = wmbase.imin(wy + oh, cy1 as i64)
    if ax1 <= ax0 || ay1 <= ay0 {
        // S6a: the clip may lie ONLY in the shadow ring around this window (a repaint of the wallpaper, an icon, a toast next to it): the
        // background was just filled there, so the shadow must be laid over it again, or the ring keeps a hole until the window moves.
        // (Found by `tools/comp/shadow.sh`: the judge saw 1387 pixels of the top strip missing after a repaint.)
        if wmlayout.wg(state, i, wmlayout.W_ANK) == 0 && !wmanim.drag_paint_on(state, i) && wmbase.deko(state, i) {
            var rr: i64 = wmgeom.form(state, wmlayout.FM_SHADOW_R) as i64
            let rr2: i64 = wmgeom.form(state, wmlayout.FM_SHADOW_R2) as i64
            if rr2 > rr {
                rr = rr2
            }
            rr = rr + 1
            if rr > 1 && wmbase.imin(wx + ow + rr, cx1 as i64) > wmbase.imax(wx - rr, cx0 as i64)
                && wmbase.imin(wy + oh + rr, cy1 as i64) > wmbase.imax(wy - rr, cy0 as i64) {
                wmshadow.paint_shadow(state, i, cx0 as i64, cy0 as i64, cx1 as i64, cy1 as i64)
            }
        }
        return
    }
    // RUNDE VSYNC: laeuft eine Oeffnungs- oder Schliessbewegung, wird
    // das Fenster ANDERS gemalt -- skaliert und durchscheinend -- und
    // der gewoehnliche Weg entfaellt vollstaendig.
    if wmlayout.wg(state, i, wmlayout.W_ANK) != 0 {
        wmanim.paint_win_anim(state, i, cx0 as i64, cy0 as i64, cx1 as i64,
            cy1 as i64)
        return
    }
    // RUNDE ZIEH: wird es gerade aufgehoben (oder pendelt es noch
    // aus), gilt derselbe Vorrang -- skaliert, versetzt, ohne Schmuck.
    // Der Schmuck faellt weg, weil ein mitskalierter Rahmen bei 105
    // Prozent eine unscharfe Kante ist; das Fenster haengt am Zeiger,
    // seine Titelleiste braucht in dieser halben Sekunde niemand.
    if wmanim.drag_paint_on(state, i) {
        let ph_t: u64 = time.tsc()
        paint_win_drag(state, i, cx0 as i64, cy0 as i64, cx1 as i64,
            cy1 as i64)
        ph_add(state, wmlayout.S_PH_DRAG, ph_t, time.tsc())
        return
    }
    // RUNDE MESSTAFEL: AB HIER WIRD GEMALT. Der Zaehler steht vor der
    // Verzweigung nach `deko`, weil beide Zweige malen -- ein Zaehler je
    // Zweig waere zweimal dieselbe Aussage mit doppelter Fehlerquelle.
    wmlayout.wsv(state, i, wmlayout.W_PAINTS, wmlayout.wg(state, i, wmlayout.W_PAINTS) + 1)
    wmlayout.wsv(state, i, wmlayout.W_PX,
        wmlayout.wg(state, i, wmlayout.W_PX) + ((ax1 - ax0) * (ay1 - ay0)) as u64)
    // ====================================================== RUNDE BLUR
    // DAS ACRYL LIEGT UNTER DEM FENSTER UND UEBER ALLEM, WAS SCHON
    // GEMALT IST -- also genau hier: nach allen tieferen Fenstern und
    // vor der ersten eigenen Fuellung. Dieselbe Stelle, an der Runde
    // PAINT den Schatten einsetzt, und aus demselben Grund.
    //
    // Gemalt wird das AEUSSERE Rechteck des Fensters; was das Fenster
    // danach selbst deckend darueber malt, verdeckt den Blur ohnehin.
    // Sichtbar bleibt er dort, wo die Anwendung durchscheinen laesst --
    // und die Leiste dieses Systems tut das.
    if wmblur.blur_will(state, i) {
        let ph_t: u64 = time.tsc()
        wmblur.blur_flaeche(state, i, wx, wy, wx + ow, wy + oh,
            wmbase.deco(state, wmlayout.DK_TITLE), cx0 as i64, cy0 as i64, cx1 as i64,
            cy1 as i64)
        ph_add(state, wmlayout.S_PH_BLUR, ph_t, time.tsc())
    }
    // OHNE SCHMUCK: kein Rahmen, keine Titelleiste, kein Schliessfeld.
    // Die Flaeche der Anwendung faengt am aeusseren Rechteck an, und der
    // ganze Rest dieser Funktion entfaellt. Ein Schreibtisch mit
    // Titelleiste waere keiner.
    if !wmbase.deko(state, i) {
        let bx0: i64 = wmbase.imax(wx, cx0 as i64)
        let by0: i64 = wmbase.imax(wy, cy0 as i64)
        let bx1: i64 = wmbase.imin(wx + wmlayout.wg(state, i, wmlayout.W_W) as i64, cx1 as i64)
        let by1: i64 = wmbase.imin(wy + wmlayout.wg(state, i, wmlayout.W_H) as i64, cy1 as i64)
        if bx1 <= bx0 || by1 <= by0 {
            return
        }
        let bw: u64 = wmlayout.wg(state, i, wmlayout.W_W)
        let bq: u64 = wmlayout.wg(state, i, wmlayout.W_BUF)
        let bn: u64 = (bx1 - bx0) as u64
        // ZUSAMMENFUEHRUNG VON BLUR UND GLAS AN DER EINEN ZEILE, DIE
        // EINEN PUFFER IN DEN ANDEREN KOPIERT.
        //
        // Beide Runden haben genau hier gearbeitet, und beide aus
        // demselben Grund: ein Fenster ohne Schmuck deckte seinen
        // Untergrund bedingungslos zu. BLUR brauchte das, damit die
        // Leiste die Weichzeichnung nicht zudeckt, die sie selbst
        // ausgeloest hat; GLAS brauchte es fuer `taskbar_alpha`.
        //
        // Die Mechanik von GLAS gewinnt, weil sie MEHR kann: sie
        // mischt je Bildpunkt gegen eine Schluesselfarbe und laesst
        // dabei die Textplatte (`PLATTE_MARKE`) deckend stehen. Die
        // Deckung der Runde BLUR (`win_opac`, aus `W_OPAC`) geht nicht
        // verloren -- sie wird als OBERGRENZE eingefaltet: was das
        // Acryl fuer diese Ebene an Durchsicht vorsieht, kann die
        // Glasdeckung nur noch verringern, nie erhoehen.
        let pw: u64 = wmbase.panel_win(state)
        var alpha: u64 = wmbase.form_or(state, wmlayout.FM_WIN_ALPHA, 100)
        if pw < wmbase.MAX_WIN && i == pw {
            alpha = wmbase.form_or(state, wmlayout.FM_TB_ALPHA, 100)
        }
        // `win_opac` ist 0..255, `alpha` ist 0..100 Prozent. Der
        // kleinere der beiden gewinnt, in Prozent gerechnet.
        let op: u64 = wmblur.win_opac(state, i)
        if op < 255 {
            let opp: u64 = op *% 100 / 255
            if opp < alpha {
                alpha = opp
            }
        }
        if wmblur.deckt_schirm(state, i) {
            alpha = 100
        }
        // ============================================ RUNDE DREI (G-006)
        // DER RADIUS GILT AUCH HIER -- und hier war er nie.
        //
        // `nodeco_radius` gibt 0 zurueck, solange die Form eckig ist
        // oder das Fenster den ganzen Schirm bedeckt; dann laeuft diese
        // Schleife Zeile fuer Zeile weiter wie vorher, und
        // `tools/look/run.sh` misst bildpunktgleich dasselbe.
        let rr: u64 = nodeco_radius(state, i)
        let wh: u64 = wmlayout.wg(state, i, wmlayout.W_H)
        if alpha >= 100 {
            var br: i64 = by0
            while br < by1 {
                // Wie weit ist diese Zeile von der naechsten waagrechten
                // Kante entfernt? Nur in den obersten und untersten `r`
                // Zeilen wird ueberhaupt gerundet.
                var dy: u64 = 0xFFFFFFFFFFFFFFFF
                if rr != 0 {
                    let o: u64 = (br - wy) as u64
                    dy = o
                    if wh > o && wh - 1 - o < dy {
                        dy = wh - 1 - o
                    }
                }
                var ein: u64 = 0
                if rr != 0 && dy < rr {
                    ein = rund_einzug(dy, rr)
                }
                let zr: u64 = bq +% (br - wy) as u64 *% bw *% 4
                var xs: i64 = bx0
                var xe: i64 = bx1
                if ein != 0 {
                    xs = wmbase.imax(bx0, wx + ein as i64)
                    xe = wmbase.imin(bx1, wx + bw as i64 - ein as i64)
                }
                if xe > xs {
                    wmdraw.fb_row(state, xs as u64, br as u64,
                        zr +% (xs - wx) as u64 *% 4, (xe - xs) as u64)
                }
                if ein != 0 {
                    rund_saum(state, wx, bx0, bx1, bw, br as u64, zr, dy,
                        rr, true)
                    rund_saum(state, wx, bx0, bx1, bw, br as u64, zr, dy,
                        rr, false)
                }
                br = br + 1
            }
            wmlayout.ss(state, wmlayout.S_BLITS, wmlayout.gs(state, wmlayout.S_BLITS) + 1)
            return
        }
        // Das Milchglas gibt es nur unter der Leiste. Unter einem
        // gewoehnlichen Fenster waere es dasselbe Rechnen fuer jedes
        // Fenster in jedem Bild, und der Streifenpuffer ist einer.
        var grund: u64 = 0
        if pw < wmbase.MAX_WIN && i == pw && wmgeom.form(state, wmlayout.FM_BLUR) > 0 {
            let ph_g: u64 = time.tsc()
            grund = wmglass.glass_prepare(state, wx, wy, wmlayout.wg(state, i, wmlayout.W_W),
                wmlayout.wg(state, i, wmlayout.W_H), wmgeom.form(state, wmlayout.FM_BLUR))
            ph_add(state, wmlayout.S_PH_GLASS, ph_g, time.tsc())
        }
        let key: u64 = wmgeom.form(state, wmlayout.FM_GLASS_KEY)
        // Die Zaehlung des wirksamen Alphas gilt der LEISTE; siehe
        // `glass_stat_an`.
        let ist_leiste: bool = pw < wmbase.MAX_WIN && i == pw
        wmglass.glass_stat_an(ist_leiste)
        // UND DIE LESBARKEITSSCHRANKE GILT FUER BEIDE, ABER NICHT MIT
        // DERSELBEN ZAHL. Ein Fenster ohne Schmuck ist entweder die
        // Leiste (drei Beschriftungen auf leerer Flaeche, 40 Stufen)
        // oder der Schreibtisch bzw. ein Fenster, das seinen Rahmen
        // selbst malt (Schrift von oben bis unten, 20 Stufen).
        var sch: u64 = wmglass.SCHLEIER_WIN
        if ist_leiste {
            sch = wmglass.SCHLEIER
        }
        var gr: i64 = by0
        while gr < by1 {
            var zeile: u64 = 0
            if grund != 0 {
                zeile = grund +% ((gr - wy) as u64 *% wmlayout.wg(state, i, wmlayout.W_W)
                    +% (bx0 - wx) as u64) *% 4
            }
            wmglass.fb_row_a(state, bx0 as u64, gr as u64,
                bq +% (gr - wy) as u64 *% bw *% 4
                +% (bx0 - wx) as u64 *% 4, bn, alpha, key, zeile, sch)
            gr = gr + 1
        }
        wmglass.glass_stat_an(false)
        // r368: THE ALPHA LINE FROM THE PLACE WHERE THE BAR IS MIXED.
        //
        // `glas_bericht` writes `wm: glas alpha_soll=..` once, at the START of
        // the hold -- before the task bar (a program in ring 3) has placed
        // itself and before one pixel of it was mixed: `alpha_ist=<knob>
        // px=0`. The acceptance runs photograph the machine as soon as
        // `wm: hold` stands and kill it, so a line written later at the end
        // of the hold never reached them, and the questions "did the veil lift
        // the opacity above the knob" (11d3, 11j) read a zero. Now the line is
        // written when the bar has really been mixed: after its first blit and
        // then every 240th; the last one wins.
        if ist_leiste {
            ga_blits = ga_blits + 1
            if ga_blits == 1 || ga_blits % 240 == 0 {
                wmglass.glas_alpha_say(state)
            }
        }
        wmlayout.ss(state, wmlayout.S_BLITS, wmlayout.gs(state, wmlayout.S_BLITS) + 1)
        return
    }
    let aktiv: bool = wmbase.focus(state) == i
    var rahmen: u64 = wmbase.deco(state, wmlayout.DK_FRAME)
    var titel: u64 = wmbase.deco(state, wmlayout.DK_TITLE)
    var schrift: u64 = wmbase.deco(state, wmlayout.DK_TEXT)
    if aktiv {
        rahmen = wmbase.deco(state, wmlayout.DK_FRAME_ON)
        titel = wmbase.deco(state, wmlayout.DK_TITLE_ON)
        schrift = wmbase.deco(state, wmlayout.DK_TEXT_ON)
    }
    // RUNDE PAINT: DER SCHATTEN ZUERST. Er liegt unter dem Fenster und
    // ueber allem, was schon gemalt ist -- also genau hier, vor der
    // ersten Fuellung des Rahmens und nach allen tieferen Fenstern.
    let ph_s: u64 = time.tsc()
    wmshadow.paint_shadow(state, i, cx0 as i64, cy0 as i64, cx1 as i64, cy1 as i64)
    ph_add(state, wmlayout.S_PH_SHADOW, ph_s, time.tsc())
    // Der ganze Aussenbereich in Rahmenfarbe, danach die Leiste und die
    // Flaeche darueber. Das ist ein Rechteck mehr als noetig und spart
    // vier Sonderfaelle an den Ecken.
    //
    // RUNDE PAINT: mit `radius_window` als runde Flaeche. Bei Radius 0
    // ist `fill_round` Aufruf fuer Aufruf das alte `fb.fill` auf dem
    // beschnittenen Rechteck -- `shape=classic` malt bildpunktgleich
    // weiter, und tools/look/run.sh misst das.
    let f_bo: i64 = wmgeom.border(state) as i64
    let f_rad: i64 = wmgeom.form(state, wmlayout.FM_RADIUS) as i64
    let f_inny: i64 = wmbase.iny(state, i) as i64
    let f_full: bool = wmbase.form_or(state, wmlayout.FM_WIN_ALPHA, 100) >= 100 && wmlayout.wg(state, i, wmlayout.W_W) as i64 == ow - 2 * f_bo
        && f_inny + wmlayout.wg(state, i, wmlayout.W_H) as i64 == oh - f_bo
    if f_full {
        let f_top: i64 = wy + wmbase.imax(f_inny, f_rad)
        let f_bot: i64 = wy + oh - wmbase.imax(f_bo, f_rad)
        let f_cx0: i64 = cx0 as i64
        let f_cy0: i64 = cy0 as i64
        let f_cx1: i64 = cx1 as i64
        let f_cy1: i64 = cy1 as i64
        let f_r: u64 = wmgeom.form(state, wmlayout.FM_RADIUS)
        let f_a: u64 = deco_alpha(state)
        if wmbase.imin(f_cy1, f_top) > f_cy0 {
            wmdraw.fill_round(state, wx, wy, ow, oh, f_r, rahmen, f_a, f_cx0, f_cy0, f_cx1, wmbase.imin(f_cy1, f_top))
        }
        if f_cy1 > wmbase.imax(f_cy0, f_bot) {
            wmdraw.fill_round(state, wx, wy, ow, oh, f_r, rahmen, f_a, f_cx0, wmbase.imax(f_cy0, f_bot), f_cx1, f_cy1)
        }
        let f_my0: i64 = wmbase.imax(f_cy0, f_top)
        let f_my1: i64 = wmbase.imin(f_cy1, f_bot)
        if f_my1 > f_my0 {
            if wmbase.imin(f_cx1, wx + f_bo) > f_cx0 {
                wmdraw.fill_round(state, wx, wy, ow, oh, f_r, rahmen, f_a, f_cx0, f_my0, wmbase.imin(f_cx1, wx + f_bo), f_my1)
            }
            if f_cx1 > wmbase.imax(f_cx0, wx + ow - f_bo) {
                wmdraw.fill_round(state, wx, wy, ow, oh, f_r, rahmen, f_a, wmbase.imax(f_cx0, wx + ow - f_bo), f_my0, f_cx1, f_my1)
            }
        }
    } else {
        wmdraw.fill_round(state, wx, wy, ow, oh, wmgeom.form(state, wmlayout.FM_RADIUS), rahmen,
            deco_alpha(state), cx0 as i64, cy0 as i64, cx1 as i64, cy1 as i64)
    }
    // RUNDE GLAS (fix-r4-3): und das eben gemalte Rechteck wird
    // GEMELDET, damit die Abnahme alle vier Ecken findet und nicht nur
    // die, deren Koordinaten zufaellig auch das Programm kennt.
    if aktiv {
        wmglass.rahmen_say(wx, wy, ow, oh, wmgeom.form(state, wmlayout.FM_RADIUS))
    }
    // die Titelleiste
    //
    // RUNDE SOFTUI: SIE IST NICHT MEHR EIN RECHTECK IN EINER FARBE.
    // Zwei Dinge sind dazugekommen, und beide kosten etwas, das in
    // docs/ROUNDSOFTUI.md steht: die oberen Ecken folgen dem
    // Fensterradius (sonst schneidet eine eckige Leiste die runde Ecke
    // ab, die `fill_round` gerade gemalt hat), und ueber die Hoehe
    // laeuft ein Verlauf von wenigen Helligkeitsstufen.
    // r454: a window that paints its own strip gets no title background; the caption buttons follow the client area
    let capc: bool = cap_client(state, i)
    if !capc {
        paint_title(state, i, wx, wy, ow, titel, schrift, ax0, ay0, ax1, ay1)
    }
    // ------------------------------- die Schaltflaechen rechts oben
    //
    // ZWEI FASSUNGEN, UND DIE ALTE BLEIBT WORTGLEICH STEHEN. `classic`
    // schickt FM_CAPTION = 0 und bekommt das rote Schliessfeld mit dem
    // Kreuz, das dieser Server seit Runde K10 malt -- dieselben
    // Koordinaten, dieselbe Schleife. `modern` schickt 1 und bekommt
    // die drei Windows-Schaltflaechen: Strich, Quadrat, Kreuz.
    var bx: i64 = wx + ow - wmgeom.border(state) as i64 - wmgeom.close_w(state) as i64 - 3
    if wmgeom.form(state, wmlayout.FM_CAPTION) != 0 {
        bx = wx + ow - wmgeom.border(state) as i64 - (wmlayout.CAP_N * wmgeom.cap_w(state)) as i64
        if !capc {
            paint_caption(state, i, wx, wy, ow, titel, schrift,
                ax0, ay0, ax1, ay1)
        }
    } else if !capc {
        paint_close_classic(state, wx, wy, ow, ax0, ay0, ax1, ay1)
    }
    // ===================================== RUNDE NETVIEW, NACHTRAG
    //
    // DAS ZEICHEN AM FENSTER SELBST. Die Taskleiste hat es am Knopf;
    // hier steht es am Fenster, weil ein Fenster auch dann sichtbar ist,
    // wenn die Leiste verdeckt, weggeschoben oder ausgeblendet ist --
    // und weil der Satz dieser Runde lautet, dass der Mensch es SEHEN
    // koennen muss.
    //
    // `real` bekommt keines. Ein Zeichen an jedem Fenster waere ein
    // Bildschirm voller Zeichen ohne Aussage.
    var before: i64 = 0
    let sicht: u64 = netview.view_of(state, wmbase.win_owner(state, i))
    if sicht != netview.V_REAL && sicht <= 3 && !capc {
        title_mark(state, sicht - 1, wx + wmgeom.border(state) as i64 + wmgeom.title_pad(state) as i64,
            wy + wmgeom.border(state) as i64
                + ((wmgeom.title_h(state) - wmgeom.border(state) - netmark.H) / 2) as i64,
            schrift, ax0, ay0, ax1, ay1)
        before = netmark.W as i64 + 4
    }
    // der Titel
    let f: u64 = wmlayout.gs(state, wmlayout.S_FONT_UI)
    if f < ttf.MAX_FONTS && !capc {
        if tt_grouped(state, i) {
            tt_paint(state, i, wx, wy, titel, schrift, ax0, ay0, ax1, ay1, f)
        } else {
            title_text(state, i, f, wx + wmgeom.border(state) as i64 + wmgeom.title_pad(state) as i64 + before,
                wy + wmgeom.title_base(state, f),
                schrift, ax0, ay0, ax1, ay1, bx)
            if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM && i < 32 {
                tt_paint_plus(state, i, wx, wy, schrift, ax0, ay0, ax1, ay1, f)
            }
        }
    }
    // die Flaeche der Anwendung
    let px0: i64 = wx + wmgeom.border(state) as i64
    let py0: i64 = wy + wmbase.iny(state, i) as i64
    let sx0: i64 = wmbase.imax(px0, ax0)
    let sy0: i64 = wmbase.imax(py0, ay0)
    let sx1: i64 = wmbase.imin(px0 + wmlayout.wg(state, i, wmlayout.W_W) as i64, ax1)
    let sy1: i64 = wmbase.imin(py0 + wmlayout.wg(state, i, wmlayout.W_H) as i64, ay1)
    if sx1 <= sx0 || sy1 <= sy0 {
        return
    }
    let ww: u64 = wmlayout.wg(state, i, wmlayout.W_W)
    let quelle: u64 = wmlayout.wg(state, i, wmlayout.W_BUF)
    // ZUSAMMENFUEHRUNG: auch hier gewinnt die Mechanik von GLAS, und
    // die Deckung der Runde BLUR wird als Obergrenze eingefaltet --
    // dieselbe Rechnung wie in `paint_win`, aus demselben Grund.
    // RUNDE GLAS: die Flaeche der Anwendung mit `window_alpha`.
    //
    // Die Schluesselfarbe ist dieselbe, die die Leiste geschickt hat
    // (`FM_GLASS_KEY`). Das ist eine bewusste Vereinfachung und sie
    // steht hier, damit sie niemand fuer ein Versehen haelt: in allen
    // zehn Vorlagen liegen Leistengrund und Fenstergrund unter dreissig
    // Helligkeitsstufen auseinander, und das Abstandsalpha braucht die
    // Grundfarbe nur auf diese Genauigkeit. Waeren sie einmal weit
    // auseinander, bekaeme die Fensterflaeche zu viel Deckung -- also
    // zu wenig Glas, nie zu wenig Kontrast.
    let wa: u64 = wmbase.form_or(state, wmlayout.FM_WIN_ALPHA, 100)
    let wkey: u64 = wmgeom.form(state, wmlayout.FM_GLASS_KEY)
    // ======================================== RUNDE GLAS (fix-r4-3)
    //
    // DER UMRISS IST AN ALLEN VIER ECKEN GESCHLOSSEN, und bis hierher
    // war er es an zweien nicht.
    //
    // `fill_round` hat den ganzen Fensterrumpf in Rahmenfarbe MIT
    // Rundung gefuellt -- oben legt die Titelleiste ihre eigene runde
    // Kante darueber, unten aber kopierte die Schleife hier die
    // Anwendungsflaeche ZEILENWEISE UND RECHTECKIG darueber und hat
    // die gerade gemalten Boegen wieder zugeschmiert. Gemessen im Bild
    // 03 (Radius 24): oben links ein sauberer Bogen, unten links ein
    // rechter Winkel -- ein Fenster mit zwei verschiedenen Formen.
    //
    // Die Abhilfe rechnet KEINE zweite Rundung, sie laesst nur die
    // Bildpunkte stehen, die schon rund sind: `ecke.corner_skip` sagt
    // fuer jede der untersten `radius` Zeilen, wie viele Spalten am
    // Rand NICHT vollstaendig innerhalb des Eckkreises liegen; genau
    // die ueberspringt die Kopie, und dort bleibt die
    // kantengeglaettete Fuellung von `fill_round` sichtbar. Ein
    // Bildpunkt weniger Anwendungsflaeche in der Ecke einer Karte ist
    // das, was eine Rundung IST -- und der Innenraum verschiebt sich
    // dabei nicht, denn `sx0` und die Zeilennummer bleiben
    // unveraendert.
    //
    // UND DER INNERSTE TEILGEDECKTE BILDPUNKT BEKOMMT SEINEN ANTEIL.
    // Ohne ihn endete die Anwendungsflaeche an einer harten Kante und
    // der Bogen daneben trug nur die Rahmenfarbe -- gemessen mit
    // `glascheck.py ecke ... ul`: zwoelf Zeilen mit Mischton gegen
    // achtzehn an der oberen Ecke, also sichtbar weniger Glaettung
    // unten als oben. Dieser eine Bildpunkt je Zeile und Seite geht
    // durch `px_clip` und damit durch dieselbe `blend`-Arithmetik wie
    // alles andere; gemischt wird die Farbe, die die Anwendung selbst
    // an diese Stelle gemalt hat.
    let rad: u64 = wmgeom.form(state, wmlayout.FM_RADIUS)
    let bo: i64 = wmgeom.border(state) as i64
    let cw: i64 = wmlayout.wg(state, i, wmlayout.W_W) as i64
    // ======================================== RUNDE GLAS (fix-r4-4)
    //
    // DAS MILCHGLAS GIBT ES AUCH UNTER EINEM DURCHSICHTIGEN FENSTER.
    //
    // Bis hierher lag es nur unter der Leiste, und der Grund stand als
    // Kommentar daneben: "unter einem gewoehnlichen Fenster waere es
    // dasselbe Rechnen fuer jedes Fenster in jedem Bild". Das ist
    // richtig fuer zehn Fenster und falsch fuer die Sache selbst --
    // die Leiste ist 28 Bildpunkte hoch, und auf einem Streifen von 28
    // Bildpunkten SIEHT ein Mensch keinen Weichzeichner, er misst ihn
    // nur. Erst unter einer Flaeche von mehreren hundert Zeilen wird
    // aus "var sinkt" ein Bild, auf das man zeigen kann.
    //
    // Was es kostet und warum es tragbar ist: gerechnet wird NUR, wenn
    // dieses Fenster wirklich durchsichtig ist (`wa < 100`) UND ein
    // Weichzeichner eingestellt ist. Bei `window_alpha=100` -- dem
    // Zustand jedes Laufs, der nicht ausdruecklich Glas bestellt --
    // wird diese Zeile nicht einmal betreten. Der Streifenpuffer ist
    // einer und wird zwischen Leiste und Fenster hin- und
    // hergeschoben; die Trefferquote faellt in einem solchen Lauf, die
    // Zahl dazu steht in `wm: glas ... cache=`.
    var wgrund: u64 = 0
    if wa < 100 && wmgeom.form(state, wmlayout.FM_BLUR) > 0 {
        wgrund = wmglass.glass_prepare(state, px0, py0, ww, wmlayout.wg(state, i, wmlayout.W_H),
            wmgeom.form(state, wmlayout.FM_BLUR))
    }
    var r: i64 = sy0
    while r < sy1 {
        let zeile: u64 = (r - py0) as u64
        var rx0: i64 = sx0
        var rx1: i64 = sx1
        let dyb: i64 = wy + oh - 1 - r
        if capc && rad > 0 && r - wy < rad as i64 {
            // r454: the strip reaches the top corners: the same skip as at the bottom, counted from the top edge
            let skt: i64 = ecke.corner_skip(rad, (r - wy) as u64) as i64
            if skt > 0 {
                rx0 = wmbase.imax(rx0, px0 + skt)
                rx1 = wmbase.imin(rx1, px0 + cw - skt)
            }
        }
        if rad > 0 && dyb >= 0 && dyb < rad as i64 {
            // `skr` zaehlt vom FENSTERRAND, die Flaeche faengt eine
            // Rahmenbreite weiter innen an -- und sie hoert deshalb
            // auch eine Rahmenbreite VOR dem Bogen auf. Ohne dieses
            // `+ bo` stiesse die Anwendungsflaeche in der Ecke
            // unmittelbar an den Bogen, und der Rahmen, der an der
            // geraden Unterkante zwei Bildpunkte breit ist, waere an
            // der Rundung gar nicht da.
            let sk: i64 = ecke.corner_skip(rad, dyb as u64) as i64
            if sk > 0 {
                rx0 = wmbase.imax(rx0, px0 + sk)
                rx1 = wmbase.imin(rx1, px0 + cw - sk)
            }
        }
        if rx1 > rx0 {
            let spalte: u64 = (rx0 - px0) as u64
            let n: u64 = (rx1 - rx0) as u64
            if wa >= 100 {
                wmdraw.fb_row(state, rx0 as u64, r as u64,
                    quelle +% zeile *% ww *% 4 +% spalte *% 4, n)
            } else {
                var gz: u64 = 0
                if wgrund != 0 {
                    gz = wgrund +% (zeile *% ww +% spalte) *% 4
                }
                wmglass.fb_row_a(state, rx0 as u64, r as u64,
                    quelle +% zeile *% ww *% 4 +% spalte *% 4, n, wa, wkey, gz,
                    wmglass.SCHLEIER_WIN)
            }
        }
        r = r + 1
    }
    // r454: the caption buttons of a window with a client strip lie over the strip: after the client area
    if capc {
        if wmgeom.form(state, wmlayout.FM_CAPTION) != 0 {
            paint_caption(state, i, wx, wy, ow, titel, schrift,
                ax0, ay0, ax1, ay1)
        } else {
            paint_close_classic(state, wx, wy, ow, ax0, ay0, ax1, ay1)
        }
    }
    wmlayout.ss(state, wmlayout.S_BLITS, wmlayout.gs(state, wmlayout.S_BLITS) + 1)
}

// =====================================================================
// RUNDE SOFTUI: DIE TITELLEISTE
// =====================================================================
//
// DER VERLAUF, UND WARUM ER NACH UNTEN HELLER WIRD UND NICHT NACH OBEN.
//
// Justin wollte "dezente Verlaeufe statt Volltonfarbe, nur wenige
// Farbstufen". Die erste Fassung hat den Verlauf VON DER SCHRIFT WEG
// laufen lassen, damit er den Kontrast nie senken kann. Das Bild hat
// die Regel widerlegt: im hellen Schema ist die Titelleiste #ffffff,
// von Weiss aus gibt es kein Heller, und die Leiste kam VOLLKOMMEN FLACH
// heraus -- alle neunzehn Zeilen 255,255,255, nachgemessen. Eine Regel,
// die auf der Haelfte aller Themen nichts tut, ist keine.
//
// Also die andere Richtung, und sie ist auch die richtigere: DIE
// OBERSTE ZEILE IST DIE DUNKELSTE, die unterste traegt die Farbe des
// Themas unveraendert. Das ist ein weicher Eigenschatten an der
// Oberkante, also genau das, was eine gerundete Kante mit Licht von
// oben macht. Nach unten gibt es IMMER Platz (ausser bei Schwarz), und
// wo es ihn nicht gibt, nimmt `grad_room` nur so viel, wie da ist --
// kein Kanal darf anschlagen, sonst kippt der Farbton ins Blaue.
//
// UND DER KONTRAST. Auf hellem Grund mit dunkler Schrift senkt das
// Abdunkeln den Kontrast ein wenig (17,85 auf 17,04 gemessen fuer
// #0f172a auf #ffffff), auf dunklem Grund mit heller Schrift HEBT es
// ihn. Beide Werte liegen weit ueber dem kleinsten Paar des Systems --
// die Titelleiste ist nirgends das bindende Paar --, und
// tools/softui/kontrast.py misst es aus dem Bild statt es zu glauben.
fn lum3(c: u64) -> u64 {
    return ((c >> 16) & 255) + ((c >> 8) & 255) + (c & 255)
}

// Eine Farbe um `d` Stufen je Kanal aufhellen oder abdunkeln, mit
// Anschlag. Kein Mischen mit Weiss -- das verschoebe den Farbton.
fn shade24(c: u64, d: u64, auf: bool) -> u64 {
    var r: u64 = (c >> 16) & 255
    var g: u64 = (c >> 8) & 255
    var b: u64 = c & 255
    if auf {
        r = r + d
        g = g + d
        b = b + d
        if r > 255 {
            r = 255
        }
        if g > 255 {
            g = 255
        }
        if b > 255 {
            b = 255
        }
    } else {
        if r > d {
            r = r - d
        } else {
            r = 0
        }
        if g > d {
            g = g - d
        } else {
            g = 0
        }
        if b > d {
            b = b - d
        } else {
            b = 0
        }
    }
    return (r << 16) | (g << 8) | b
}

fn paint_title(state: u64, i: u64, wx: i64, wy: i64, ow: i64, titel: u64,
    schrift: u64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    // RUNDE GLAS: die Titelleiste traegt dieselbe Deckkraft wie der
    // Rahmen. Eine deckende Leiste ueber einem durchscheinenden Rahmen
    // saehe nicht nach Glas aus, sondern nach einem Fehler.
    let wal: u64 = deco_alpha(state)
    let x0: i64 = wx + wmgeom.border(state) as i64
    let y0: i64 = wy + wmgeom.border(state) as i64
    let tw: i64 = ow - 2 * wmgeom.border(state) as i64
    let th: i64 = wmgeom.title_h(state) as i64 - 1 - wmgeom.border(state) as i64
    if tw <= 0 || th <= 0 {
        return
    }
    // Der Radius der Leiste ist der des Fensters, um den Rand nach
    // innen gerueckt -- so bleibt die Kurve der Leiste zur Kurve des
    // Rahmens gleichmittig statt sie zu schneiden.
    var tr: u64 = 0
    let rw: u64 = wmgeom.form(state, wmlayout.FM_RADIUS)
    if rw > wmgeom.border(state) {
        tr = rw - wmgeom.border(state)
    }
    if tr as i64 > th {
        tr = th as u64
    }
    let grad: u64 = wmgeom.form(state, wmlayout.FM_GRAD)
    if grad == 0 {
        // Volltonfarbe: EIN Aufruf, wie vor dieser Runde -- nur mit
        // runden oberen Ecken, wenn der Radius es sagt.
        wmdraw.fill_round(state, x0, y0, tw, th, tr, titel, wal, ax0, ay0, ax1, ay1)
        if tr != 0 {
            wmdraw.fill_clip(state, x0, y0 + tr as i64, tw, th - tr as i64,
                titel, wal, ax0, ay0, ax1, ay1)
        }
        return
    }
    // MIT VERLAUF. Die gerundeten obersten Zeilen tragen die
    // Endfarbe des Verlaufs in EINEM `fill_round` -- so bleibt die
    // Kantenglaettung der Ecke richtig gefaerbt --, und darunter
    // laeuft je eine Zeile.
    let grund: u64 = deco_title(state, i)
    let d: u64 = grad_room(grund, grad)
    if d == 0 {
        wmdraw.fill_round(state, x0, y0, tw, th, tr, titel, wal, ax0, ay0, ax1, ay1)
        if tr != 0 {
            wmdraw.fill_clip(state, x0, y0 + tr as i64, tw, th - tr as i64,
                titel, wal, ax0, ay0, ax1, ay1)
        }
        return
    }
    let oben: u64 = wmbase.rgb24(state, shade24(grund, d, false))
    wmdraw.fill_round(state, x0, y0, tw, th, tr, oben, wal, ax0, ay0, ax1, ay1)
    var j: i64 = tr as i64
    while j < th {
        // linear von `oben` zurueck auf die Grundfarbe
        let rest: u64 = d * (th - 1 - j) as u64 / (th - 1) as u64
        let c: u64 = wmbase.rgb24(state, shade24(grund, rest, false))
        wmdraw.fill_clip(state, x0, y0 + j, tw, 1, c, wal, ax0, ay0, ax1, ay1)
        j = j + 1
    }
}

// Wieviel Verlauf die Farbe TRAEGT. Der kleinste Kanal setzt die
// Grenze: schlaegt einer an, waehrend die anderen noch Platz haben,
// verschiebt sich der Farbton, und ein Verlauf, der die Farbe wechselt,
// ist keiner mehr.
fn grad_room(c: u64, want: u64) -> u64 {
    var m: u64 = (c >> 16) & 255
    let g: u64 = (c >> 8) & 255
    let b: u64 = c & 255
    if g < m {
        m = g
    }
    if b < m {
        m = b
    }
    if want > m {
        return m
    }
    return want
}

// Die ROHE Titelfarbe (0xRRGGBB) des Fensters -- `shade24` rechnet in
// Kanaelen und nicht im Format des Bildschirms.
fn deco_title(state: u64, i: u64) -> u64 {
    if wmbase.focus(state) == i {
        return wmbase.deco_rgb(state, wmlayout.DK_TITLE_ON)
    }
    return wmbase.deco_rgb(state, wmlayout.DK_TITLE)
}

// =====================================================================
// RUNDE SOFTUI: DIE DREI SCHALTFLAECHEN -- WINDOWS UND NICHT MACOS
// =====================================================================
//
// Justin hat das ausdruecklich verlangt und es ist keine
// Geschmacksfrage: rechts oben, drei Felder, und die Zeichen darin
// sind STRICHE und keine bunten Kreise. Minimieren ein waagerechter
// Strich, Maximieren ein Quadrat (im maximierten Zustand zwei
// versetzte), Schliessen ein Kreuz.
//
// DAS VERHALTEN GEHOERT DAZU. Ein Windows-Knopf hat keinen Rahmen und
// keine Flaeche, bis der Zeiger darauf steht; dann bekommt er eine
// dezente graue Flaeche, und der Schliessen-Knopf eine ROTE mit weissem
// Kreuz. Ohne den Ueberfahr-Zustand sind es drei Zeichen und keine
// Schaltflaechen -- deshalb fuehrt der Server jetzt mit, welche gerade
// unter dem Zeiger liegt (S_CAPHOV), und faerbt genau diese eine.
fn cap_x0(state: u64, i: u64) -> i64 {
    return wmbase.win_x(state, i) + wmbase.outer_w(state, i) as i64 - wmgeom.border(state) as i64
        - (wmlayout.CAP_N * wmgeom.cap_w(state)) as i64
}

// Welche Schaltflaeche liegt unter (x, y)? CAP_N = keine.
fn cap_at(state: u64, i: u64, x: i64, y: i64) -> u64 {
    if !wmbase.valid(state, i) || !wmbase.deko(state, i) {
        return wmlayout.CAP_N
    }
    if wmgeom.form(state, wmlayout.FM_CAPTION) == 0 {
        return wmlayout.CAP_N
    }
    let bx: i64 = cap_x0(state, i)
    let by: i64 = wmbase.win_y(state, i) + wmgeom.border(state) as i64
    let h: i64 = wmgeom.title_h(state) as i64 - 1 - wmgeom.border(state) as i64
    if y < by || y >= by + h || x < bx || x >= bx + (wmlayout.CAP_N * wmgeom.cap_w(state)) as i64 {
        return wmlayout.CAP_N
    }
    return ((x - bx) / wmgeom.cap_w(state) as i64) as u64
}

fn paint_caption(state: u64, i: u64, wx: i64, wy: i64, ow: i64,
    titel: u64, schrift: u64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let bx: i64 = wx + ow - wmgeom.border(state) as i64 - (wmlayout.CAP_N * wmgeom.cap_w(state)) as i64
    let by: i64 = wy + wmgeom.border(state) as i64
    let h: i64 = wmgeom.title_h(state) as i64 - 1 - wmgeom.border(state) as i64
    if h <= 0 {
        return
    }
    var tr: u64 = 0
    let rw: u64 = wmgeom.form(state, wmlayout.FM_RADIUS)
    if rw > wmgeom.border(state) {
        tr = rw - wmgeom.border(state)
    }
    let hov: u64 = wmlayout.gs(state, wmlayout.S_CAPHOV)
    let dwn: u64 = wmlayout.gs(state, wmlayout.S_CAPDOWN)
    var n: u64 = 0
    while n < wmlayout.CAP_N {
        let x: i64 = bx + (n * wmgeom.cap_w(state)) as i64
        var mark: u64 = schrift
        if hov != 0 && hov - 1 == i * 4 + n {
            // r402: the held button (pointer still on it) is one step darker / stronger
            let held: bool = dwn == hov
            if n == wmlayout.CAP_CLOSE {
                // ROT MIT WEISSEM KREUZ -- die eine Stelle, an der
                // diese Oberflaeche laut werden darf.
                var rot: u64 = wmbase.deco(state, wmlayout.DK_CLOSE)
                if held {
                    rot = wmbase.rgb24(state, wmdraw.mix24(wmbase.deco_rgb(state, wmlayout.DK_CLOSE), 0, 14))
                }
                cap_face(state, x, by, h, tr, rot, n == wmlayout.CAP_CLOSE,
                    ax0, ay0, ax1, ay1)
                mark = wmbase.deco(state, wmlayout.DK_CLOSE_MARK)
            } else {
                // Eine dezente graue Flaeche: die Titelfarbe, zwoelf
                // Hundertstel in Richtung der Schrift geschoben. Kein
                // neuer Farbsteckplatz und kein festes Grau -- auf
                // einem dunklen Thema muss sie heller werden und auf
                // einem hellen dunkler, und genau das tut das Mischen.
                var pc: u64 = 12
                if held {
                    pc = 22
                }
                let f: u64 = wmbase.rgb24(state, wmdraw.mix24(deco_title(state, i),
                    deco_schrift(state, i), pc))
                cap_face(state, x, by, h, tr, f, false,
                    ax0, ay0, ax1, ay1)
            }
        }
        // ======================================== RUNDE MERGE-11: R1
        // DIE FESTE 10 WAR DER GRUND FUER JUSTINS "— [] /".
        //
        // Das Zeichen ist `10 * uisc` gross (cap_glyph, `let d`), hier
        // wurde aber mit der ROHEN 10 zentriert. Bei Vervielfachung 2
        // sitzt es damit 5 Bildpunkte zu weit rechts und unten -- und
        // vom Kreuz, dessen zweite Diagonale genau dort endet, bleibt
        // im Knopffeld ein Schraegstrich uebrig.
        //
        // GEMESSEN am laufenden Fenster, 3440x1440: mit der festen 10
        // meldet Justin "-- [] /", mit `zg` steht ein Kreuz da, in
        // jeder der 19 Zeilen Punkte auf BEIDEN Seiten.
        let zg: i64 = 10 * wmgeom.uisc(state) as i64
        cap_glyph(state, n, x + (wmgeom.cap_w(state) as i64 - zg) / 2,
            by + (h - zg) / 2, mark, i, ax0, ay0, ax1, ay1)
        n = n + 1
    }
}

fn deco_schrift(state: u64, i: u64) -> u64 {
    if wmbase.focus(state) == i {
        return wmbase.deco_rgb(state, wmlayout.DK_TEXT_ON)
    }
    return wmbase.deco_rgb(state, wmlayout.DK_TEXT)
}

// Die Flaeche EINER Schaltflaeche. Nur die rechte -- das Schliessen --
// darf oben rechts der Fensterrundung folgen; die beiden anderen sind
// Rechtecke, weil sie mitten in der Leiste stehen.
fn cap_face(state: u64, x: i64, y: i64, h: i64, tr: u64, farbe: u64,
    rechts: bool, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    // RUNDE GLAS: die Flaeche der Schaltflaeche gehoert zur
    // Titelleiste und bekommt deren Deckkraft. Das ZEICHEN darauf
    // nicht -- `cap_glyph` malt weiter voll deckend, sonst waere ein
    // Kreuz auf einem hellen Hintergrundbild nicht mehr zu sehen.
    let wal: u64 = deco_alpha(state)
    let w: i64 = wmgeom.cap_w(state) as i64
    if !rechts || tr == 0 {
        wmdraw.fill_clip(state, x, y, w, h, farbe, wal, ax0, ay0, ax1, ay1)
        return
    }
    let r: i64 = tr as i64
    wmdraw.fill_round(state, x, y, w, h, tr, farbe, wal, ax0, ay0, ax1, ay1)
    // die drei Ecken wieder eckig machen
    wmdraw.fill_clip(state, x, y, w - r, r, farbe, wal, ax0, ay0, ax1, ay1)
    wmdraw.fill_clip(state, x, y + r, w, h - r, farbe, wal, ax0, ay0, ax1, ay1)
}

// DAS ZEICHEN. Zehn mal zehn Bildpunkte, einen Strich breit.
//
//   CAP_MIN    ein waagerechter Strich auf halber Hoehe
//   CAP_MAX    ein Quadrat -- und im maximierten Zustand ZWEI
//              versetzte, weil der Knopf dann "wiederherstellen"
//              heisst und nicht "maximieren"
//   CAP_CLOSE  ein Kreuz aus zwei Diagonalen
// ==================================================== RUNDE VEKTOR
//
// DIE DREI ZEICHEN, GESTRICHEN STATT GESETZT.
//
// Was hier stand, waren gesetzte Bildpunkte: `cap_px` in einer
// Schleife fuer das Kreuz, `cap_box` aus vier Linien fuer das
// Quadrat -- und alles auf FESTE ZEHN MAL ZEHN Bildpunkte.
//
// Der Fehler daran ist nicht der Geschmack, sondern die Rechnung:
// `cap_w` ist `CAP_W0 * uisc` und waechst mit der Oberflaeche
// (wm.fi:3043), die Zehn hier wuchs nicht mit. Bei Vervielfachung 2
// war die Schaltflaeche sechzig Bildpunkte breit und das Kreuz darin
// zehn -- ein Fliegendreck in einem Feld. Dazu war die Diagonale eine
// Treppe aus einzelnen Punkten, weil eine gesetzte Diagonale nichts
// anderes sein kann.
//
// Jetzt: die Groesse ist `10 * uisc`, und die Striche sind STRICHE --
// `vektor.strichen` mit Breite und runden Enden, gerastert mit
// derselben Kantenglaettung wie alles andere. Der Aufrufer uebergibt
// weiter die linke obere Ecke eines Quadrats; wie gross das ist,
// rechnet diese Funktion selbst.
// ================================================ RUNDE MERGE-11: R1
// DAS SCHLIESSKREUZ WIRD WIEDER DIREKT GEZEICHNET.
//
// Justins Foto vom 10.09. 18:39 (3440x1440): das X ist zerfranst, mit
// einem fetten schraegen Zusatzbalken. Minimieren und Maximieren sind
// sauber. Seine Worte: "so perfekte Buttons waren davor. Jetzt sind
// diese Buttons korrumpiert."
//
// DIE URSACHE, GEMESSEN (tools/design/kreuzcheck.py):
//
//   X, zwei Striche (uisc=1)   54 bedeckt    4 mehrfach
//   X, zwei Striche (uisc=2)  187 bedeckt   12 mehrfach
//   X, zwei Striche (uisc=3)  394 bedeckt   24 mehrfach
//   Gegenprobe: EIN Strich      jeweils      0 mehrfach
//
// Die Vektorfassung rief `strichen(0)` ZWEIMAL -- einmal je Diagonale
// -- und rasterte beide Umrisse zusammen mit NICHTNULL. Wo sich die
// Umrisse kreuzen, addieren sich die Umlaufzahlen, statt sich
// aufzuheben: die Kreuzungsflaeche wird doppelt gedeckt. Und es wird
// mit der Skalierung SCHLIMMER (4 -> 12 -> 24 Bildpunkte), weshalb es
// auf Justins dichtem Schirm auffaellt und im Pruefstand bei kleiner
// Skalierung durchging.
//
// WAS JETZT PASSIERT: zurueck auf die Fassung, die er "perfekt"
// genannt hat -- ein Bildpunkt nach dem anderen, jeder GENAU EINMAL
// geschrieben. Doppelte Deckung ist damit nicht unwahrscheinlich,
// sondern unmoeglich; es gibt keinen Umriss, der sich ueberlappen
// koennte.
//
// DER EINE UNTERSCHIED ZUR ALTEN FASSUNG: sie war auf 10 Bildpunkte
// festgenagelt und waere auf 3440x1440 ein Fliegendreck. Die Groesse
// laeuft jetzt ueber `uisc`, die Strichstaerke ebenso -- gezeichnet
// wird aber weiter direkt, ohne Rasterer.
//
// KEIN RETTUNGSVERSUCH AM VEKTORWEG. Der Auftrag ist eindeutig:
// lieber eine einfache Zeichnung, die sauber aussieht.
fn cap_glyph(state: u64, n: u64, x: i64, y: i64, farbe: u64, i: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let sk: i64 = wmgeom.uisc(state) as i64
    let d: i64 = 10 * sk
    let sb: i64 = sk
    if d <= 0 || sb <= 0 {
        return
    }
    // ================================================== RUNDE KERN-FUI
    //
    // DIESE FUNKTION MALT DIE ZEICHEN NICHT MEHR SELBST.
    //
    // Justin, 10.09.2026: "kann man die fUi-Lib nicht ohne Imports
    // machen, also dass sie im Kernel auch laufen kann?" -- sie ist es
    // bereits: `vendor/firn/lib/fui/core.fi` traegt `profile kernel` in
    // Zeile 1 und wurde genau dafuer geschrieben. Angeschlossen war sie
    // nie; `grep -rln fui kernel/*.fi` fand bis zu dieser Runde nichts.
    //
    // WARUM DAS NICHT KOSMETIK IST, SONDERN EIN GEMESSENER FEHLER.
    // Die alte Fassung hier rechnete EINE Verschiebung fuer beide
    // Achsen:
    //
    //     let off: i64 = (d - (kn + sb - 1)) / 2
    //
    // Das Kreuz belegt aber nicht gleich viel in beiden Richtungen --
    // die Breite ist `kn + sb - 1` (die Laeufe UND die Verbreiterung
    // addieren sich), die Hoehe nur `kn` (die Verbreiterung geht
    // waagerecht). `core.fi` rechnet deshalb ZWEI Verschiebungen und
    // sagt das in seinem Kopf auch woertlich ("A THIRD MISTAKE, FOUND
    // AND MEASURED IN THIS ROUND").
    //
    // GEMESSEN (tools/fui/kernvergleich.py), abweichende Bildpunkte
    // zwischen der alten wm-Fassung und fui.core:
    //
    //     d=10 sb=1     0      d=20 sb=2     0
    //     d=30 sb=3   112      d=40 sb=4   152
    //
    // Bei Vervielfachung 1 und 2 stimmten beide ueberein -- deshalb ist
    // es nie aufgefallen. Ab Vervielfachung 3 klebt das Kreuz oben und
    // laesst unten eine Zeile frei, waehrend das Quadrat daneben mittig
    // sitzt. Das ist genau die Sorte Abweichung, die entsteht, wenn
    // dieselbe Form an zwei Orten steht -- und der dritte Anlauf
    // desselben Fehlers, nach dem ausgefransten Kreuz und dem mit nur
    // einer Diagonale.
    //
    // ============================================ WIE fUi AUF DEN SCHIRM KOMMT
    //
    // NICHT direkt, und das hat zwei nachgepruefte Gruende:
    //
    //  G1 `core.fi` KENNT KEINEN BESCHNITT. Es malt in ein `Target` von
    //     (0,0) bis (w,h); der Server malt in ein SCHMUTZRECHTECK
    //     (ax0..ax1, ay0..ay1) mitten auf dem Schirm. Ein Zeichen ohne
    //     Beschnitt malte ueber fremde Fenster.
    //  G2 DAS PIXELFORMAT IST NICHT FEST. `core.put` legt BGRX ab, fest
    //     verdrahtet. `fb.fi` nimmt die Verschiebungen aus S_RSHIFT/
    //     S_GSHIFT/S_BSHIFT, die der Grafikmodus liefert -- auf einer
    //     Tafel mit anderer Reihenfolge waeren die Farben vertauscht.
    //     Dazu haelt `fb.pixel` das reservierte Band der Messtafel frei
    //     (`band_lo`), was ein roher Schreiber ueberschriebe.
    //
    // ALSO: fUi rastert in `cg_deck` -- den Zwischenpuffer, den Runde
    // VEKTOR angelegt und nie benutzt hat. Dort ist das Format egal,
    // weil nur die DECKUNG zaehlt. Danach traegt diese Funktion den
    // Puffer durch `cap_px` auf den Schirm -- mit Beschnitt, mit dem
    // Band und ueber den Farbwaehler des Servers. Die FORM kommt aus
    // fUi, der WEG auf den Schirm bleibt der des Servers.
    //
    // Damit malt der Fensterserver dieselben Bildpunkte wie jede
    // Anwendung, weil es derselbe Quelltext ist -- und
    // `tools/fui/kernvergleich.py` rechnet es nach.
    let dd: u64 = d as u64
    if dd > CG_KANTE {
        // Mehr als 40x40 passt nicht in ein Fach. Das kann bei
        // uisc <= 4 nicht vorkommen (10 * 4 = 40); steht hier trotzdem,
        // weil ein stiller Ueberlauf in einen statischen Puffer im Kern
        // das Schlimmste ist, was diese Datei tun kann.
        return
    }
    let slot: u64 = cg_slot(state, n, i)
    if !cg_bau(state, slot, n, i, dd, sb as u64) {
        return
    }
    // Der Puffer haelt DECKUNGEN, nicht Farben: != 0 heisst gesetzt.
    // `core.fi` setzt jeden Punkt genau einmal und ohne Mischung (das
    // ist der ganze Unterschied zum Rasterer, an dem das Kreuz zweimal
    // zerbrochen ist) -- ein Vergleich gegen null reicht deshalb.
    var ry: u64 = 0
    while ry < dd {
        var rx: u64 = 0
        while rx < dd {
            if cg_deck[(slot *% CG_FACH +% ry *% dd +% rx) as usize]
                != 0 as u8 {
                cap_px(state, x + rx as i64, y + ry as i64, farbe,
                    ax0, ay0, ax1, ay1)
            }
            rx = rx + 1
        }
        ry = ry + 1
    }
}

// Welches Fach des Zeichenspeichers gehoert zu dieser Schaltflaeche?
// Maximieren hat ZWEI Bilder -- ein Quadrat und zwei versetzte --, also
// braucht es zwei Faecher. Das vierte ist genau dafuer da.
fn cg_slot(state: u64, n: u64, i: u64) -> u64 {
    if n == wmlayout.CAP_MAX && (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED) != 0 {
        return 3
    }
    if n >= CG_N {
        return 0
    }
    return n
}

// DAS ZEICHEN IN DEN ZWISCHENPUFFER, EINMAL JE GROESSE.
//
// Liegt es schon in der richtigen Kantenlaenge da, wird nichts gemalt
// -- das ist der Speicher, den Runde VEKTOR angelegt und nie benutzt
// hat. `cg_treffer` und `cg_bauten` zaehlen beides; die zweite Zahl
// muss klein bleiben, sonst wirkt der Speicher nicht.
fn cg_bau(state: u64, slot: u64, n: u64, i: u64, dd: u64, sb: u64) -> bool {
    if slot >= CG_N || dd == 0 || dd > CG_KANTE {
        return false
    }
    if cg_gr == dd && cg_gut[slot as usize] != 0 {
        cg_treffer = cg_treffer + 1
        return true
    }
    // Die Groesse hat gewechselt: ALLE Faecher sind ungueltig, nicht
    // nur dieses. Sonst stuenden Zeichen zweier Vervielfachungen
    // nebeneinander in der Leiste.
    if cg_gr != dd {
        var k: u64 = 0
        while k < CG_N {
            cg_gut[k as usize] = 0
            k = k + 1
        }
        cg_gr = dd
    }
    // DIE FLAECHE, DIE fUi BESCHREIBT.
    //
    // `core.fi` rechnet mit VIER Oktetten je Bildpunkt (`put` schreibt
    // B, G, R, X). Ein Fach ist deshalb `CG_KANTE * CG_KANTE * 4` gross
    // und nicht `CG_KANTE * CG_KANTE` -- 6400 Oktette, viermal, macht
    // 25 600 Oktette fuer den ganzen Speicher. Das ist der ehrliche
    // Preis dafuer, dass hier dieselbe Routine laeuft wie in Ring 3;
    // ihn zu druecken hiesse, `core.fi` eine zweite Ablage
    // beizubringen, und das waere wieder die zweite Umsetzung.
    //
    // Danach wird das Fach AN ORT UND STELLE auf ein Oktett je Punkt
    // eingedampft (`cg_dampf`): Punkt k liegt bei k*4 und soll nach k,
    // und weil k <= k*4 gilt, ueberschreibt der Lauf nie etwas, das er
    // noch braucht. Das spart beim Uebertragen drei Viertel der
    // Leserei, und das Uebertragen laeuft je BILD -- das Rastern nur
    // je Groesse.
    let basis: u64 = ((&cg_deck[0]) as u64) +% slot *% CG_FACH
    var z: core.Target = core.target_new(basis, dd as usize, dd as usize,
        (dd *% 4) as usize)
    core.fill_rect(&z, 0 as usize, 0 as usize, dd as usize, dd as usize,
        0 as u32)
    cg_mal(state, &z, n, i, dd, sb)
    cg_dampf(state, slot, dd)
    cg_gut[slot as usize] = 1
    cg_bauten = cg_bauten + 1
    return true
}

// Vier Oktette je Punkt auf eines eindampfen, im selben Fach.
fn cg_dampf(state: u64, slot: u64, dd: u64) {
    let b: u64 = slot *% CG_FACH
    var k: u64 = 0
    while k < dd *% dd {
        var v: u8 = 0 as u8
        if cg_deck[(b +% k *% 4) as usize] != 0 as u8 {
            v = 255 as u8
        }
        cg_deck[(b +% k) as usize] = v
        k = k + 1
    }
}

// ============================================================ DIE FORM
//
// HIER UND NUR HIER entscheidet sich, WIE ein Fensterzeichen aussieht
// -- und es steht keine einzige Zeile Zeichenkunst darin. Jede Form
// kommt aus `fui.core`, derselben Datei, aus der die Anwendungen ueber
// `fuib.fi` ihre Knoepfe holen.
//
// Die Farbe ist 0xFFFFFF und nicht die echte: der Puffer haelt
// DECKUNGEN. Welche Farbe daraus wird, entscheidet `cap_glyph` beim
// Uebertragen -- und damit der Farbwaehler des Servers, nicht fUi.
fn cg_mal(state: u64, z: *mut core.Target, n: u64, i: u64, dd: u64,
    sb: u64) {
    let weiss: u32 = 0xFFFFFF as u32
    if n == wmlayout.CAP_MIN {
        core.cap_minimize(z, 0 as usize, 0 as usize, dd as usize,
            sb as usize, weiss)
        return
    }
    if n == wmlayout.CAP_MAX {
        if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED) != 0 {
            core.cap_restore(z, 0 as usize, 0 as usize, dd as usize,
                sb as usize, weiss)
            return
        }
        core.cap_maximize(z, 0 as usize, 0 as usize, dd as usize,
            sb as usize, weiss)
        return
    }
    core.cap_close(z, 0 as usize, 0 as usize, dd as usize, sb as usize,
        weiss)
}

// Ein Kasten mit Strichstaerke -- die alte `cap_box` kann nur einen
// Bildpunkt breit. Auch hier gilt: jeder Bildpunkt wird gesetzt, nicht
// aufaddiert; ueberlappende Kanten an den Ecken sind deshalb harmlos.
fn cap_box_thick(state: u64, x: i64, y: i64, w: i64, h: i64, sb: i64,
    farbe: u64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    var t: i64 = 0
    while t < sb {
        cap_h(state, x, y + t, w, farbe, ax0, ay0, ax1, ay1)
        cap_h(state, x, y + h - 1 - t, w, farbe, ax0, ay0, ax1, ay1)
        var k: i64 = 0
        while k < h {
            cap_px(state, x + t, y + k, farbe, ax0, ay0, ax1, ay1)
            cap_px(state, x + w - 1 - t, y + k, farbe, ax0, ay0, ax1, ay1)
            k = k + 1
        }
        t = t + 1
    }
}

// Wie oft ein fertiges Zeichen benutzt und wie oft eines gerastert
// wurde. Die zweite Zahl MUSS klein bleiben -- sie ist der Beleg,
// dass der Speicher wirkt.
fn cap_glyph_treffer() -> u64 {
    return cg_treffer
}

fn cap_glyph_bauten() -> u64 {
    return cg_bauten
}

fn cap_px(state: u64, x: i64, y: i64, farbe: u64, ax0: i64, ay0: i64,
    ax1: i64, ay1: i64) {
    if x < ax0 || y < ay0 || x >= ax1 || y >= ay1 || x < 0 || y < 0 {
        return
    }
    fb.pixel(state, x as u64, y as u64, farbe)
}

fn cap_h(state: u64, x: i64, y: i64, n: i64, farbe: u64, ax0: i64,
    ay0: i64, ax1: i64, ay1: i64) {
    var k: i64 = 0
    while k < n {
        cap_px(state, x + k, y, farbe, ax0, ay0, ax1, ay1)
        k = k + 1
    }
}

fn cap_box(state: u64, x: i64, y: i64, w: i64, h: i64, farbe: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    cap_h(state, x, y, w, farbe, ax0, ay0, ax1, ay1)
    cap_h(state, x, y + h - 1, w, farbe, ax0, ay0, ax1, ay1)
    var k: i64 = 1
    while k < h - 1 {
        cap_px(state, x, y + k, farbe, ax0, ay0, ax1, ay1)
        cap_px(state, x + w - 1, y + k, farbe, ax0, ay0, ax1, ay1)
        k = k + 1
    }
}

// Der Zeiger ist gewandert: welche Schaltflaeche liegt jetzt unter ihm?
// Aendert sich die Antwort, wird die Titelleiste des betroffenen
// Fensters schmutzig -- und nur sie.
// r402: what a caption button does (it used to run on the press itself).
fn cap_act(state: u64, i: u64, cn: u64) {
    if !wmbase.valid(state, i) || !wmbase.deko(state, i) {
        return
    }
    wmlayout.ss(state, wmlayout.S_CAPHITS, wmlayout.gs(state, wmlayout.S_CAPHITS) + 1)
    if cn == wmlayout.CAP_CLOSE {
        // RUNDE OBERFLAECHE: UEBER DIE BEWEGUNG. `close_anim` pusht E_CLOSE selbst und ruft
        // `destroy` erst, wenn die Bewegung durch ist -- ist sie abgeschaltet, sofort.
        let _ca: bool = close_anim(state, i)
        return
    }
    if cn == wmlayout.CAP_MIN {
        // Dasselbe fuer das Minimieren: am Ende steht `set_hidden`, aber erst nach der Bewegung.
        let _ma: bool = minimize_anim(state, i)
        return
    }
    let auf: bool = (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED) == 0
    let _m: bool = maximize(state, i, auf)
}

// The left button went up: a held caption button acts if the pointer is still on it.
fn cap_release(state: u64, over: u64, x: i64, y: i64) {
    let d: u64 = wmlayout.gs(state, wmlayout.S_CAPDOWN)
    if d == 0 {
        return
    }
    wmlayout.ss(state, wmlayout.S_CAPDOWN, 0)
    let w: u64 = (d - 1) / 4
    let n: u64 = (d - 1) % 4
    if w >= wmbase.MAX_WIN || !wmbase.valid(state, w) {
        return
    }
    damage_caption(state, w)
    if over != w || wmgate.sperre_an(state) || !wmgate.darf(state, w) {
        return
    }
    if cap_at(state, w, x, y) == n {
        cap_act(state, w, n)
    }
}

fn cap_track(state: u64, i: u64, x: i64, y: i64) {
    var nv: u64 = 0
    if i < wmbase.MAX_WIN {
        let n: u64 = cap_at(state, i, x, y)
        if n < wmlayout.CAP_N {
            nv = i * 4 + n + 1
        }
    }
    let alt: u64 = wmlayout.gs(state, wmlayout.S_CAPHOV)
    if nv == alt {
        return
    }
    wmlayout.ss(state, wmlayout.S_CAPHOV, nv)
    if alt != 0 {
        damage_caption(state, (alt - 1) / 4)
    }
    if nv != 0 {
        damage_caption(state, (nv - 1) / 4)
    }
}

fn damage_caption(state: u64, i: u64) {
    if !wmbase.valid(state, i) || !wmbase.deko(state, i) {
        return
    }
    let bx: i64 = cap_x0(state, i)
    let by: i64 = wmbase.win_y(state, i) + wmgeom.border(state) as i64
    wmbase.damage(state, bx, by, bx + (wmlayout.CAP_N * wmgeom.cap_w(state)) as i64,
        by + wmgeom.title_h(state) as i64 - 1 - wmgeom.border(state) as i64)
}

// Eine Bildzeile aus einem Fensterpuffer in den Zweitpuffer des
// Bildschirms. Ueber `rep movsq`, wie alles andere in `fb.fi` -- eine
// Schleife aus Einzelzugriffen kostete dort gemessen den Faktor acht.
// ==================================================== RUNDE DREI (G-006)
// WELCHES FENSTER OHNE SCHMUCK EINEN RADIUS BEKOMMT -- UND WELCHES NICHT.
//
// Die Frage ist nicht "kann man runden", sondern "gehoert es sich".
// Drei Faelle, und alle drei haben einen Grund:
//
//   * EIN FENSTER, DAS DEN GANZEN SCHIRM BEDECKT, BLEIBT ECKIG.
//     Der Schreibtisch ist der Schirm; eine runde Ecke dort zeigt vier
//     schwarze Zipfel auf nichts. Dasselbe gilt fuer ein Vollbild.
//     Geprueft wird an der GROESSE gegen den Schirm und nicht an einem
//     Merkerbit -- ein Fenster, das zufaellig genau so gross ist,
//     sieht genauso aus.
//
//   * EIN FENSTER, DAS EINEN SCHIRMRAND RESERVIERT (`W_STRUT`, also
//     die Taskleiste), wird nur an den INNEREN Ecken gerundet. Eine
//     Leiste, die unten klebt, hat unten keine sichtbaren Ecken; sie
//     oben UND unten zu runden hiesse, zwei Zipfel an den Bildschirm-
//     rand zu malen. Diese Runde macht dafuer noch keinen Sonderfall
//     und laesst die Leiste deshalb ganz aussen vor -- die Leiste malt
//     ihre eigene Pille bereits selbst (`wlibc.radius`), und zwei
//     Rundungen uebereinander sind eine zuviel.
//
//   * ALLES ANDERE (wmshell, Kontrollzentrum, ein rahmenloser Dialog)
//     bekommt `FM_RADIUS`, also dieselbe Zahl wie jedes gewoehnliche
//     Fenster. Genau das verlangt G-006.
fn nodeco_radius(state: u64, i: u64) -> u64 {
    let r: u64 = wmgeom.form(state, wmlayout.FM_RADIUS)
    if r == 0 {
        return 0
    }
    // Die Leiste rundet sich selbst.
    if wmlayout.wg(state, i, wmlayout.W_STRUT) != 0 {
        return 0
    }
    // So gross wie der Schirm: kein Radius.
    if wmlayout.wg(state, i, wmlayout.W_W) >= wmlayout.gs(state, wmlayout.S_SW)
        && wmlayout.wg(state, i, wmlayout.W_H) >= wmlayout.gs(state, wmlayout.S_SH) {
        return 0
    }
    // Und nie mehr als die halbe Kante -- sonst treffen sich zwei
    // Ecken in der Mitte und die Zeile verschwindet.
    var rr: u64 = r
    if rr * 2 > wmlayout.wg(state, i, wmlayout.W_W) {
        rr = wmlayout.wg(state, i, wmlayout.W_W) / 2
    }
    if rr * 2 > wmlayout.wg(state, i, wmlayout.W_H) {
        rr = wmlayout.wg(state, i, wmlayout.W_H) / 2
    }
    return rr
}

// ==================================================== RUNDE DREI (G-006)
// DER RADIUS FUER FENSTER OHNE SCHMUCK.
//
// Schreibtisch, Taskleiste, wmshell und Kontrollzentrum laufen durch
// den Blit-Pfad in `paint_win` und bekamen NIE einen Radius --
// `fill_round` steht im anderen Zweig, dem mit Rahmen und Titelleiste.
// Die Tokens waren laengst da (`FM_RADIUS`, die Formdatei,
// `RADIUS_MAX`); sie erreichten diese Fenster nur nicht.
//
// WAS GERECHNET WIRD. Eine Zeile des Fensters geht am Stueck in den
// Zweitpuffer (`fb_row`, wortweise). Eine runde Ecke heisst: in den
// obersten und untersten `r` Zeilen faengt die Zeile spaeter an und
// hoert frueher auf, und der schmale Saum dazwischen wird GEMISCHT
// statt gesetzt. Die Deckung dafuer kommt aus `ecke.corner_cov` --
// derselben Funktion, die `fill_round` im dekorierten Zweig benutzt.
// Eine Rundung, zwei Aufrufer, keine zweite Formel.
//
// DER UNTERGRUND WIRD NICHT FLAECHIG GELESEN. `fb.pixel_a` mischt
// genau den einen Bildpunkt, den es gerade schreibt. Das ist dieselbe
// Auflage, unter der die Runde BLUR ihre Maske gebaut hat.
//
// WAS EINE ECKE KOSTET: hoechstens 4 * r * r Bildpunkte je Fenster und
// Bild, unabhaengig von der Fenstergroesse. Bei r = 8 sind das 256 --
// der Schreibtisch allein misst 1 024 000.
//
// DER EINZUG EINER ZEILE. `dy` ist der Abstand vom oberen bzw. unteren
// Fensterrand (0 = die aeusserste Zeile). Der Mittelpunkt des
// Eckkreises liegt `r` Bildpunkte innen; fuer diese Zeile ist der
// senkrechte Abstand dorthin `r - dy`, der waagrechte Halbmesser also
// die Wurzel aus `r^2 - (r-dy)^2`. Soviel Bildpunkte fehlen am Rand:
//
//     dy=0 -> 8     dy=3 -> 2     dy=6 -> 1
//     dy=1 -> 5     dy=4 -> 2     dy=7 -> 1
//     dy=2 -> 3     dy=5 -> 1     dy>=8 -> 0        (bei r = 8)
fn rund_einzug(dy: u64, r: u64) -> u64 {
    return ecke.corner_skip(r, dy)
}

fn rund_saum(state: u64, wx: i64, cx0: i64, cx1: i64, ww: u64, y: u64,
    row: u64, dy: u64, r: u64, links: bool) {
    if r == 0 || dy >= r || ww == 0 {
        return
    }
    var i: u64 = 0
    while i < r && i < ww {
        var sx: u64 = i
        if !links {
            sx = ww - 1 - i
        }
        let x: i64 = wx + sx as i64
        if x >= cx0 && x < cx1 {
            let cov: u64 = ecke.corner_cov(r - 1 - i, r - 1 - dy, r)
            if cov != 0 {
                let c: u64 = __mmio_read32((row +% sx *% 4) as *mut u32) as u64
                fb.pixel_a(state, x as u64, y, c, cov)
            }
        }
        i = i + 1
    }
}
static mut ga_blits: u64 = 0 // r368: wie oft die Leiste gemischt wurde (fuer die Alphazeile)

// Der Titel, auf die Breite bis zum Schliessfeld beschnitten.
// EIN ZEICHEN AUS `kernel/netmark.fi`, EINFARBIG. Der Fensterserver
// dieses Zweiges kennt keine Farbrollen -- die Runde THEME gibt ihm
// gerade welche (WM_DECO) --, also wird das Zeichen in der Farbe der
// TITELSCHRIFT gemalt, die es hier schon gibt. Das kostet nichts:
// UNTERSCHIEDEN WERDEN DIE DREI ZEICHEN DURCH IHRE FORM UND NICHT DURCH
// IHRE FARBE, und `tools/netview/icons.py` misst genau das (die
// Schattenrisse unterscheiden sich um mindestens ein Drittel der
// eingefaerbten Bildpunkte). Wenn THEME durch ist, wird aus `color`
// eine Rolle und sonst nichts.
fn title_mark(state: u64, m: u64, x: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    var r: u64 = 0
    while r < netmark.H {
        let py: i64 = y + r as i64
        if py >= ay0 && py < ay1 {
            let maske: u64 = netmark.mask_at(m, r)
            var c: u64 = 0
            while c < netmark.W {
                if (maske >> (netmark.W - 1 - c)) & 1 != 0 {
                    let pxx: i64 = x + c as i64
                    if pxx >= ax0 && pxx < ax1 {
                        fb.pixel(state, pxx as u64, py as u64, color)
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

static mut titel_schnitt: u64 = 0
static mut titel_max: u64 = 0
// RUNDE BLECH2: die ALTE Zaehlweise (Schnittfenster beginnt rechts vom
// Titelanfang), nur noch fuer `wm: fen` -- siehe `title_text`.
static mut titel_schnitt_alt: u64 = 0

fn title_clipped() -> u64 {
    return titel_schnitt
}

fn title_old() -> u64 {
    return titel_schnitt_alt
}

fn title_missing() -> u64 {
    return titel_max
}

fn title_text(state: u64, i: u64, f: u64, x: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64, grenze: i64) {
    // RUNDE I18N: derselbe Umbau wie in `text` -- der Titel eines
    // Fensters ist der einzige Text, den der SERVER malt, und wenn er
    // als einziger oktettweise laeuft, sieht ein Fenster namens
    // "Einstellungen" mit echtem Umlaut in der Titelleiste anders aus
    // als sein eigener Knopf.
    let px: u64 = wmlayout.gs(state, wmlayout.S_PX_UI)
    // ADDENDUM TASKBAR, DER FUND DIESES ZWEIGES, UND ER DARF BEIM
    // ZUSAMMENFUEHREN NICHT VERLORENGEHEN: `wat` TRAEGT `kstate.DSK_OFF`
    // SCHON, seit die Runde DESKTOP die Fenstertafel aus WM_OFF
    // herausgezogen hat. Diese eine Stelle hat WM_OFF noch einmal
    // daraufgerechnet und seither Nullen gelesen -- JEDER FENSTERTITEL
    // AUF DEM BILDSCHIRM WAR LEER, und drei Zusagen in
    // tools/wm/run.sh haben es gesagt ("LEER: K l i c k m i c h").
    // `set_title` zwoelfhundert Zeilen weiter oben war berichtigt
    // worden, diese Stelle nicht. Die Runde I18N hat die Schleife
    // darunter auf UTF-8 umgebaut und die falsche Basis dabei
    // uebernommen; hier stehen beide Aenderungen zusammen.
    // ============================================== RUNDE VIELKERN
    // WIRD DER TITEL LINKS ABGESCHNITTEN? DIE ZAHL DAZU.
    //
    // Justin sieht auf mehreren Fotos bei 3440x1440 `inal -- sh` statt
    // `Terminal -- sh`: die ersten vier bis fuenf Zeichen fehlen,
    // waehrend der Rahmen richtig sitzt. Der Verdacht war eine
    // Zeilenbreitenrechnung, die bei 3440 bricht. GEMESSEN und
    // WIDERLEGT (docs/RUNDE-VIELKERN.md): mit pitch 13760 bei 3424
    // Bildpunkten Breite -- genau der Fall echter Firmware -- ist das
    // Bild bildpunktgleich mit dem ungepolsterten Lauf.
    //
    // Bleibt der andere Weg, auf dem Zeichen links verschwinden
    // koennen: das SCHNITTFENSTER. `fb_glyph` laesst jeden Bildpunkt
    // mit `pxx < ax0` aus. Liegt `ax0` rechts vom Titelanfang, fehlt
    // genau der linke Teil des Textes und sonst nichts -- der Rahmen
    // wird in einem anderen Aufruf mit einem anderen Schnitt gemalt
    // und bleibt heil. Das ist keine Behauptung, sondern jetzt eine
    // ZAHL: `TK` auf Tafelzeile 7 sagt, wie oft und wie weit.
    // ====================================================== RUNDE BLECH2
    // TK ZAEHLTE DAS FALSCHE. Justins Tafel: `7 LEISTE ... TK 643`, und
    // auf demselben Foto steht `Terminal -- sh` VOLLSTAENDIG in der
    // Titelleiste. `x < ax0` heisst nur: das Schnittfenster dieses
    // Anstrichs faengt rechts vom Titelanfang an -- und das ist bei
    // JEDEM Teilanstrich so, dessen schmutziges Rechteck nicht am linken
    // Fensterrand beginnt: der Zeiger, der ueber die Fensterflaeche
    // laeuft, ein Fenster, das darueber aufgeht. Die Bildpunkte links
    // vom Schnitt stehen unveraendert im Zweitpuffer und werden mit der
    // Zeile zusammen uebertragen; es fehlt nichts. GEMESSEN in
    // tools/metal2/run.sh: alte Zaehlweise in die Hunderte, Titel im
    // Bild bildpunktgenau vollstaendig (`checkshot.py tkette`).
    //
    // Was einen Titel WIRKLICH verschwinden laesst, ist das Band der
    // Messtafel: `fb.pixel` weist jede Zeile unter `band_lo` ab, still.
    // Ein Fenster, das nach oben in das Band geschoben wird, verliert
    // seinen Titel genau dort. DAS zaehlt TK jetzt: Titelzeilen, die im
    // Band liegen. Die alte Zahl bleibt als `tka=` in `wm: fen`.
    if x < ax0 {
        titel_schnitt_alt = titel_schnitt_alt + 1
    }
    let oben: i64 = y - ttf.ascent(state, f, px)
    let band: i64 = fb.band_lo(state) as i64
    if oben < band {
        titel_schnitt = titel_schnitt + 1
        let fehlt: u64 = (band - oben) as u64
        if fehlt > titel_max {
            titel_max = fehlt
        }
    }
    let tp: u64 = state + wmlayout.wat(i) + wmlayout.W_TITLE
    var cx: i64 = x * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < 31 {
        let v: u64 = utf8.next(tp, 31, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = 31
        } else {
            let gid: u64 = ttf.glyph_of(state, f, c)
            if vorher != 0 {
                cx = cx + ttf.kern26(state, f, vorher, gid, px)
            }
            let slot: u64 = ttf.glyph(state, f, c, px)
            if slot < ttf.SLOTS {
                if (cx >> 6) + ttf.g_w(state, slot) as i64 > grenze - 4 {
                    return
                }
                wmdraw.fb_glyph(state, slot, cx >> 6, y, color, ax0, ay0, ax1, ay1)
                cx = cx + ttf.g_adv(state, slot)
            } else {
                cx = cx + ttf.advance26(state, f, gid, px)
            }
            vorher = gid
            k = k + l
        }
    }
}

// ------------------------------------------------------- die Ereignisse

fn ev_at(state: u64, i: u64, k: u64) -> u64 {
    return state + kstate.EVR_OFF + i * EV_RING // DELL ROUND: own pages
        + (k % EV_SLOTS) * EV_BYTES
}

static mut mv_wid: u64 = 0
static mut mv_lx: i64 = 0
static mut mv_ly: i64 = 0
static mut mv_btn: u64 = 0

fn ev_push(state: u64, i: u64, typ: u64, a: u64, b: u64, c: u64) {
    if !wmbase.valid(state, i) {
        return
    }
    if typ != wmlayout.E_MOVE && wmlayout.wg(state, i, wmlayout.W_ID) == mv_wid {
        mv_wid = 0
    }
    if typ == wmlayout.E_KEY {
        wmlayout.wsv(state, i, wmlayout.W_KEYS, wmlayout.wg(state, i, wmlayout.W_KEYS) + 1)
    }
    // ====================================================== RUNDE BLECH2
    // EIN RING OHNE ABHOLER IST KEIN RING.
    //
    // Justins Tafel vom 05.09. 22:46: `4 RING 5226 VERL 1283` -- ein
    // Viertel aller Ereignisse aus dem Fensterring gefallen, in QEMU
    // stand dort immer 0. Der Grund ist nicht die Ringgroesse und nicht
    // ein langsamer Abholer, sondern EIN FENSTER OHNE ABHOLER: das
    // Terminalfenster legt der KERN an (`kgui`), seine Tasten gehen
    // ueber `key_tty` an die Zeilendisziplin, und aus seinem Ring holt
    // NIEMAND -- der einzige `ev_pop` sitzt im Systemaufruf WM_EVENT,
    // und dazu braucht es ein Ring-3-Programm mit einem Handle darauf.
    // Jede Bewegung ueber dem Terminal ging trotzdem in den Ring; nach
    // 32 Stueck fiel fuer jede weitere die aelteste heraus, und der
    // Zaehler VERL zaehlte einen Verlust, der keiner war. In QEMU faehrt
    // kein Laeufer die Maus ueber das Terminal -- deshalb dort 0.
    //
    // Ein Terminalfenster mit gebundenem tty (W_TTY) bekommt deshalb
    // nichts eingereiht: gezaehlt (S_EVTERM, und W_KEYS wie bisher),
    // sonst nichts. Das Terminal des Selbsttests hat kein tty und
    // verhaelt sich wie vorher.
    if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM && wmlayout.wg(state, i, wmlayout.W_TTY) != 0 {
        wmlayout.ss(state, wmlayout.S_EVTERM, wmlayout.gs(state, wmlayout.S_EVTERM) + 1)
        if typ == wmlayout.E_MOVE {
            frameprof.hover_term()
        }
        return
    }
    let kopf: u64 = wmlayout.wg(state, i, wmlayout.W_EHEAD)
    let schwanz: u64 = wmlayout.wg(state, i, wmlayout.W_ETAIL)
    let daten: u64 = ((a & 0xFFFF) << 32) | ((b & 0xFFFF) << 16)
        | (c & 0xFFFF)
    // KOALESZENZ DER BEWEGUNG. Eine Maus mit 1000 Berichten je Sekunde
    // legt in die 25 ms, die die Leiste zwischen zwei Abholrunden
    // schlaeft, 25 Bewegungen -- der Ring hat 32 Plaetze, und ein
    // Anstrich dazwischen reicht fuer den Ueberlauf. Von einer Bewegung
    // interessiert eine Anwendung aber nur die LETZTE Stelle: liegt als
    // juengstes, noch nicht abgeholtes Ereignis schon ein E_MOVE, wird
    // es ueberschrieben statt eines neuen eingereiht. Tasten, Klicks,
    // Schliessen, Fokus, Groesse: jedes ein eigener Platz, nie verworfen.
    //
    // Der Abholer liest Art und Daten eines Platzes und rueckt danach
    // den Schwanz vor; wird das Datenwort waehrenddessen ueberschrieben,
    // liest er die neuere Stelle -- auch das ist die richtige.
    if typ == wmlayout.E_MOVE {
        frameprof.hover_push(i, a, b)
    }
    if typ == wmlayout.E_MOVE && kopf > schwanz {
        let letzt: u64 = ev_at(state, i, kopf - 1)
        if kstate.get(letzt, 0) == wmlayout.E_MOVE {
            kstate.set(letzt, 8, daten)
            wmlayout.ss(state, wmlayout.S_EVKOAL, wmlayout.gs(state, wmlayout.S_EVKOAL) + 1)
            frameprof.hover_coal()
            return
        }
    }
    if kopf - schwanz >= EV_SLOTS {
        // ============================================ RUNDE ECHTHARDWARE-3
        // WENN DER RING VOLL IST, FLIEGT KEINE TASTE MEHR RAUS.
        //
        // Justins Tafel: `4 RING 3663 VERL 151`. Bis hierher verlor
        // ein voller Ring IMMER das aelteste Ereignis -- und weil in
        // einem vollen Ring fast nur Mausbewegungen liegen (die Maus
        // meldet tausendmal je Sekunde, ein Mensch tippt fuenfmal),
        // war das aelteste fast immer eine Bewegung. Fast immer, aber
        // eben nicht immer: stand vorn ein TASTENDRUCK, war er weg,
        // und der Mensch sieht einen verschluckten Buchstaben.
        //
        // Eine Bewegung darf man verlieren -- die naechste sagt
        // dasselbe und mehr. Eine TASTE nicht: sie kommt nie wieder.
        // Also wird der Ring von vorn nach der ersten BEWEGUNG
        // durchsucht und die geopfert; nur wenn wirklich keine drin
        // steht (32 Tasten ohne eine Abholrunde -- ein Programm, das
        // steht), faellt das aelteste Ereignis.
        var op: u64 = schwanz
        var weg: u64 = kopf // kopf = "nichts gefunden"
        while op < kopf {
            if kstate.get(ev_at(state, i, op), 0) == wmlayout.E_MOVE {
                weg = op
                op = kopf
            } else {
                op = op + 1
            }
        }
        if weg < kopf {
            // Die Bewegung herausnehmen und alles danach eine Stelle
            // nach vorn ruecken. Der Kopf sinkt um eins, der Schwanz
            // bleibt -- die Reihenfolge der Tasten bleibt erhalten.
            var q: u64 = weg
            while q + 1 < kopf {
                let a1: u64 = ev_at(state, i, q)
                let b1: u64 = ev_at(state, i, q + 1)
                kstate.set(a1, 0, kstate.get(b1, 0))
                kstate.set(a1, 8, kstate.get(b1, 8))
                q = q + 1
            }
            wmlayout.wsv(state, i, wmlayout.W_EHEAD, kopf - 1)
            wmlayout.ss(state, wmlayout.S_EVKOAL, wmlayout.gs(state, wmlayout.S_EVKOAL) + 1)
        } else {
            // ================================ RUNDE ECHTHARDWARE-5
            // WER VERLIERT, WIRD BEIM NAMEN GENANNT.
            //
            // Justins Tafel: `RING 917 VERL 29`. `VERL` sagt nur, DASS
            // etwas verlorenging -- nicht, WESSEN Ring ueberlief, und
            // ohne das ist der Befund nicht zu beheben. Ein Verlust
            // hier heisst: der Ring dieses Fensters ist voll UND es
            // steht keine einzige Bewegung darin, die man opfern
            // koennte. Das ist immer ein Fenster, das seine Ereignisse
            // NICHT ABHOLT -- 32 Tasten/Klicks ohne eine Abholrunde.
            //
            // Die Zeile nennt Fenster, Kennung, Art und wie viele
            // Ereignisse anstehen. Damit ist der Schuldige eine
            // Ablesung und keine Vermutung.
            // ==================================== RUNDE ECHTHARDWARE-6
            // DIESE ZEILE WIRD GEDECKELT -- SIE WAR SELBST EIN TEIL
            // DES FEHLERS, DEN SIE MELDET.
            //
            // Justins Tafel nach 42 Minuten: `RING 23320 VERL 8908
            // KOAL 57944`. Achttausendneunhundert Verluste heissen
            // achttausendneunhundert Zeilen ueber die serielle
            // Leitung -- byteweise, blockierend, und zwar AUS
            // `ev_push`, das aus dem Unterbrechungsweg der Maus
            // gerufen wird. Jede gemeldete verlorene Bewegung kostet
            // dabei so viel Zeit, dass die naechsten Bewegungen
            // ebenfalls nicht abgeholt werden. Die Meldung erzeugt
            // also genau den Zustand, den sie beschreibt.
            //
            // Dasselbe Muster wie beim Taskmanager in dieser Runde:
            // ein Messausgang, der im Normalbetrieb laeuft, misst vor
            // allem sich selbst.
            //
            // Die ersten VERL_SAGEN Verluste werden weiter voll
            // gemeldet -- damit bleibt der Schuldige eine Ablesung und
            // keine Vermutung, und genau dafuer ist die Zeile da.
            // Danach zaehlt nur noch `S_EVDROP`, und die Zahl steht
            // auf der Tafel.
            if wmlayout.gs(state, wmlayout.S_EVDROP) < VERL_SAY {
            var s_vl: [u8; 19] = "wm: RINGVERLUST i=\0"
            var s_vid: [u8; 5] = " id=\0"
            var s_vt: [u8; 6] = " typ=\0"
            var s_vk: [u8; 7] = " kind=\0"
            var s_vn: [u8; 5] = " an=\0"
            serial.puts((&s_vl[0]) as u64)
            serial.dec(i)
            serial.puts((&s_vid[0]) as u64)
            serial.dec(wmlayout.wg(state, i, wmlayout.W_ID))
            serial.puts((&s_vt[0]) as u64)
            serial.dec(typ)
            serial.puts((&s_vk[0]) as u64)
            serial.dec(wmlayout.wg(state, i, wmlayout.W_KIND))
            serial.puts((&s_vn[0]) as u64)
            serial.dec(kopf - schwanz)
            serial.nl()
            }
            wmlayout.wsv(state, i, wmlayout.W_ETAIL, schwanz + 1)
            wmlayout.ss(state, wmlayout.S_EVDROP, wmlayout.gs(state, wmlayout.S_EVDROP) + 1)
        }
    }
    let kopf2: u64 = wmlayout.wg(state, i, wmlayout.W_EHEAD)
    let p: u64 = ev_at(state, i, kopf2)
    kstate.set(p, 0, typ)
    kstate.set(p, 8, daten)
    wmlayout.wsv(state, i, wmlayout.W_EHEAD, kopf2 + 1)
    // RUNDE MESSTAFEL, Stufe 4a: hier verlaesst das Ereignis den Kern.
    wmlayout.ss(state, wmlayout.S_EVPUSH, wmlayout.gs(state, wmlayout.S_EVPUSH) + 1)
}

fn ev_waiting(state: u64, i: u64) -> u64 {
    if !wmbase.valid(state, i) {
        return 0
    }
    return wmlayout.wg(state, i, wmlayout.W_EHEAD) - wmlayout.wg(state, i, wmlayout.W_ETAIL)
}

// Holt ein Ereignis. `out` bekommt zwei Achtoktettworte: Art und Daten.
fn ev_pop(state: u64, i: u64, out: u64) -> bool {
    if ev_waiting(state, i) == 0 {
        return false
    }
    let schwanz: u64 = wmlayout.wg(state, i, wmlayout.W_ETAIL)
    let p: u64 = ev_at(state, i, schwanz)
    kstate.set(out, 0, kstate.get(p, 0))
    kstate.set(out, 8, kstate.get(p, 8))
    if kstate.get(p, 0) == wmlayout.E_MOVE {
        frameprof.hover_pop()
    }
    wmlayout.wsv(state, i, wmlayout.W_ETAIL, schwanz + 1)
    // RUNDE MESSTAFEL, Stufe 4b: und hier holt es ein Programm ab.
    // Diese Zeile ist der einzige Beleg dafuer, dass ueberhaupt noch
    // ein Ring-3-Prozess laeuft.
    wmlayout.ss(state, wmlayout.S_EVPOP, wmlayout.gs(state, wmlayout.S_EVPOP) + 1)
    return true
}

// Der Zeiger hat sich bewegt oder eine Taste gewechselt. Wird aus der
// Unterbrechungsbehandlung heraus gerufen; alles, was hier passiert,
// muss ohne Warten auskommen.
static mut cp_pb: u64 = 0 // COMPOSITOR S5: the buttons of the last report (a change is an event for the compositor)
static mut wh_seen: u64 = 0 // ROUND FV-W24: the driver's wheel sum as far as it was handed out

// ROUND FV-W24: the wheel notches since the last call, to the window under
// the pointer. Not while the trusted dialog is up or the screen is locked
// (`darf`); the sum is taken either way so nothing is replayed later.
fn wheel_out(state: u64, x: u64, y: u64) {
    let sum: u64 = ps2m.wheel(state)
    if sum == wh_seen {
        return
    }
    var d: i64 = (wh_seen as i64) - (sum as i64)
    wh_seen = sum
    if d > 127 {
        d = 127
    }
    if d < 0 - 127 {
        d = 0 - 127
    }
    if d == 0 || td_live(state) {
        return
    }
    let i: u64 = wmgate.hit(state, x as i64, y as i64)
    if i >= wmbase.MAX_WIN || !wmgate.darf(state, i) {
        return
    }
    let lx: i64 = (x as i64) - wmbase.win_x(state, i) - wmbase.inx(state, i) as i64
    let ly: i64 = (y as i64) - wmbase.win_y(state, i) - wmbase.iny(state, i) as i64
    if lx < 0 || ly < 0 {
        return
    }
    input_seen(state)
    if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM {
        sb_wheel(state, i, d)
        return
    }
    ev_push(state, i, wmlayout.E_WHEEL, lx as u64, ly as u64, (d as u64) & 0xFFFF)
}

static mut hwh_seen: u64 = 0 // r804: the driver's horizontal wheel sum as far as it was handed out

// r804: horizontal wheel notches since the last call, to the window under the pointer (same rules as wheel_out).
fn hwheel_out(state: u64, x: u64, y: u64) {
    let sum: u64 = ps2m.hwheel(state)
    if sum == hwh_seen {
        return
    }
    var d: i64 = (sum as i64) - (hwh_seen as i64)
    hwh_seen = sum
    if d > 127 {
        d = 127
    }
    if d < 0 - 127 {
        d = 0 - 127
    }
    if d == 0 || td_live(state) {
        return
    }
    let i: u64 = wmgate.hit(state, x as i64, y as i64)
    if i >= wmbase.MAX_WIN || !wmgate.darf(state, i) {
        return
    }
    let lx: i64 = (x as i64) - wmbase.win_x(state, i) - wmbase.inx(state, i) as i64
    let ly: i64 = (y as i64) - wmbase.win_y(state, i) - wmbase.iny(state, i) as i64
    if lx < 0 || ly < 0 {
        return
    }
    input_seen(state)
    ev_push(state, i, wmlayout.E_HWHEEL, lx as u64, ly as u64, (d as u64) & 0xFFFF)
}

// 0x0B8 in the mouse state (ps2m.S_PRESSED): buttons that went down since the last look
const MOUSE_PRESSED_OFF: u64 = 0x0B8

// ============================================================ W-DND
// DRAG AND DROP IN THE WINDOW SERVER. The payload lives on the bus (`slots.drag_*`: the source puts it there when a
// drag starts, a target takes it on release). A drag RUNS while the left button is down and the slot is full. What the
// server adds:
//   - hover-raise: ~600 ms over a background window raises it (and gives it the focus), so one can drop there; the
//     taskbar does the same for its window buttons (taskbar.fi `dnd_bar_step`).
//   - Esc cancels: the slot is emptied, the release then drops nothing.
//   - the pointer shows "forbidden" over the desktop (nobody takes a drop there).
//   - a K_TERM window with a tty takes a PATH as typed text (`dnd_take_paste`, pumped by kgui).
//   - a fresh left press empties a stale slot (a drag nobody took).
// Witness lines on the serial port: `wm: dndraise id=N`, `wm: dndcancel`, `wm: dndterm tty=T`.
static mut dh_win: u64 = 0     // window under the pointer + 1 while a drag runs, 0 = none / not raisable
static mut dh_t: u64 = 0       // mono_ns when the pointer came to that window
static mut dh_raised: u64 = 0  // window + 1 raised for the current hover
static mut dh_prev: u64 = 0    // left button of the last look
static mut dh_tty: u64 = 0     // tty + 1 waiting to be typed a dropped path, 0 = none
static mut dh_src: u64 = 0     // window + 1 under the pointer at the left press (the drag source), 0 = none
static mut dh_nraise: u64 = 0
static mut dh_ncancel: u64 = 0
const DH_DELAY_NS: u64 = 600000000

fn dnd_say(state: u64, which: u64, v: u64) {
    var s_r: [u8; 17] = "wm: dndraise id=\0"
    var s_c: [u8; 14] = "wm: dndcancel\0"
    var s_t: [u8; 17] = "wm: dndterm tty=\0"
    var s_s: [u8; 16] = "wm: dndsrc id=\0\0"
    if which == 3 {
        serial.puts((&s_s[0]) as u64)
        serial.dec(v)
    } else if which == 0 {
        serial.puts((&s_r[0]) as u64)
        serial.dec(v)
    } else if which == 1 {
        serial.puts((&s_c[0]) as u64)
    } else {
        serial.puts((&s_t[0]) as u64)
        serial.dec(v)
    }
    serial.nl()
}

// Called with every pointer look (`i` = window under the pointer, MAX_WIN = none).
fn dnd_hover(state: u64, i: u64, btn: u64) {
    let left: u64 = btn & ps2m.B_LEFT
    let was: u64 = dh_prev
    dh_prev = left
    if left != 0 && was == 0 {
        // a new press: a payload nobody took is stale
        if slots.drag_active(state) != 0 {
            let _c: u64 = slots.drag_clear(state)
        }
        wmgate.dh_live = 0
        dh_win = 0
        dh_raised = 0
        dh_src = 0
        if i < wmbase.MAX_WIN && wmbase.valid(state, i) {
            dh_src = i + 1
        }
        return
    }
    if left == 0 {
        // The release goes to the window under the pointer. The SOURCE of a live drag never sees it otherwise and
        // keeps its drag chip; tell it with a release far outside its own area (nothing there to hit).
        if was != 0 && wmgate.dh_live != 0 && dh_src != 0 && dh_src != i + 1 && wmbase.valid(state, dh_src - 1) {
            ev_push(state, dh_src - 1, wmlayout.E_UP, 0x7FFF, 0x7FFF, ps2m.B_LEFT)
            dnd_say(state, 3, wmlayout.wg(state, dh_src - 1, wmlayout.W_ID))
        }
        dh_src = 0
        if was != 0 && wmgate.dh_live != 0 && i < wmbase.MAX_WIN && wmbase.valid(state, i) && wmgate.darf(state, i)
            && wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM && slots.drag_active(state) != 0
            && (slots.drag_types(state) & bus.T_PATH) != 0 {
            let t: u64 = tty_of(state, i)
            if t != NO_TTY {
                dh_tty = t + 1
                dnd_say(state, 2, t)
            }
        }
        wmgate.dh_live = 0
        dh_win = 0
        dh_raised = 0
        return
    }
    if slots.drag_active(state) == 0 {
        wmgate.dh_live = 0
        dh_win = 0
        dh_raised = 0
        return
    }
    wmgate.dh_live = 1
    if i >= wmbase.MAX_WIN || !wmbase.valid(state, i) || !wmgate.darf(state, i)
        || (wmlayout.wg(state, i, wmlayout.W_LAYER) != wmlayout.L_NORMAL && wmlayout.wg(state, i, wmlayout.W_LAYER) != wmlayout.L_FLOAT) {
        dh_win = 0
        return
    }
    if dh_win != i + 1 {
        dh_win = i + 1
        dh_t = time.mono_ns(state)
        if dh_raised != i + 1 {
            dh_raised = 0
        }
    }
}

// Every tick: has the pointer rested long enough on a background window?
fn dnd_tick(state: u64) {
    if wmgate.dh_live == 0 || dh_win == 0 || dh_raised == dh_win {
        return
    }
    if time.mono_ns(state) - dh_t < DH_DELAY_NS {
        return
    }
    let i: u64 = dh_win - 1
    dh_raised = dh_win
    if i >= wmbase.MAX_WIN || !wmbase.valid(state, i) || wmbase.focus(state) == i {
        return
    }
    raise_win(state, i)
    set_focus(state, i)
    dh_nraise = dh_nraise + 1
    dnd_say(state, 0, wmlayout.wg(state, i, wmlayout.W_ID))
}

// Esc while a drag runs: the payload goes, the release drops nothing. True = the key is consumed.
fn dnd_cancel(state: u64) -> bool {
    if dh_prev == 0 || slots.drag_active(state) == 0 {
        return false
    }
    let _c: u64 = slots.drag_clear(state)
    wmgate.dh_live = 0
    dh_win = 0
    dh_raised = 0
    dh_ncancel = dh_ncancel + 1
    dnd_say(state, 1, 0)
    return true
}

// kgui pumps this: a path dropped on a terminal window. Copies "<path> " to `out` (max bytes), returns
// (tty << 32) | length, 0 = nothing waits. The slot is emptied.
fn dnd_take_paste(state: u64, out: u64, max: u64) -> u64 {
    if dh_tty == 0 {
        return 0
    }
    let t: u64 = dh_tty - 1
    dh_tty = 0
    if max < 4 {
        return 0
    }
    var n: u64 = slots.drag_get(state, out, max - 2, 0)
    let _c: u64 = slots.drag_clear(state)
    if n == 0 || n >= max - 2 {
        return 0
    }
    kstate.set8(out + n, 32)
    n = n + 1
    return (t << 32) | n
}

fn dnd_live_pub() -> u64 {
    return wmgate.dh_live
}

fn dnd_nraise_pub() -> u64 {
    return dh_nraise
}

fn dnd_ncancel_pub() -> u64 {
    return dh_ncancel
}

fn on_mouse(state: u64) {
    if !wmbase.ready(state) {
        return
    }
    // A press AND its release that both landed before this look leave the button state unchanged ("never
    // pressed"): the click is lost (toolbar buttons that ignored a click under host load). The driver remembers
    // the press; replay it as its own step, then handle the real state (the release).
    let pend: u64 = kstate.get(state + kstate.MOUSE_OFF, MOUSE_PRESSED_OFF)
    kstate.set(state + kstate.MOUSE_OFF, MOUSE_PRESSED_OFF, 0)
    let now: u64 = ps2m.buttons(state)
    let seen: u64 = wmlayout.gs(state, wmlayout.S_KEYS) & 7
    let lost: u64 = pend & ~now & ~seen & 7
    if lost != 0 {
        on_mouse_btn(state, seen | lost)
    }
    on_mouse_btn(state, now)
}

// A button went down: every popup menu (L_POPUP) the press did not land on is dismissed, like Esc. The owner reads E_CLOSE in
// its wlib step, answers "dismissed" (0xFFFF) and closes the menu window itself (the window stays until then, so the event is never
// lost); the press itself still goes to the window under the pointer.
fn popup_outside(state: u64, hit_win: u64) {
    var j: u64 = 0
    var menu_open: bool = false
    while j < wmbase.MAX_WIN {
        if wmbase.valid(state, j) && wmlayout.wg(state, j, wmlayout.W_LAYER) == wmlayout.L_MENU && (wmlayout.wg(state, j, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) == 0 {
            menu_open = true
        }
        j = j + 1
    }
    // the start menu closes when it loses the focus; the bare desktop takes the focus only when a start menu stands (a press there is
    // an outside press for it) -- otherwise typing into the window keeps working after a click on the wallpaper
    if menu_open && hit_win < wmbase.MAX_WIN && wmbase.valid(state, hit_win) && wmlayout.wg(state, hit_win, wmlayout.W_LAYER) == wmlayout.L_DESK {
        set_focus(state, hit_win)
    }
    j = 0
    while j < wmbase.MAX_WIN {
        if j != hit_win && wmbase.valid(state, j) && wmlayout.wg(state, j, wmlayout.W_LAYER) == wmlayout.L_POPUP {
            ev_push(state, j, wmlayout.E_CLOSE, 0, 0, 0)
        }
        j = j + 1
    }
}

fn on_mouse_btn(state: u64, btn: u64) {
    let nx: u64 = ps2m.x(state)
    let ny: u64 = ps2m.y(state)
    let ox: u64 = wmlayout.gs(state, wmlayout.S_CURX)
    let oy: u64 = wmlayout.gs(state, wmlayout.S_CURY)
    wheel_out(state, nx, ny)
    hwheel_out(state, nx, ny)
    // COMPOSITOR S5: the input-to-picture clock starts at the interrupt, and the compositor gets a copy of the pointer (not while locked)
    if nx != ox || ny != oy {
        frameprof.hover_in()
        if !wmcursor.hwcur_an(state) {
            cp_in(state)
        }
        cp_event(state, CP_EV_MOVE, 0, btn, nx, ny, 0)
    }
    if btn != cp_pb {
        cp_pb = btn
        cp_event(state, CP_EV_BTN, 0, btn, nx, ny, 0)
    }
    if nx != ox || ny != oy {
        // DIE WIEDERHERSTELLUNG DES HINTERGRUNDS. Beide Rechtecke --
        // das alte und das neue -- werden schmutzig; `compose` malt
        // dort den Hintergrund und die Fenster neu und danach den
        // Zeiger. Ein gerettetes Rechteck waere der zweite Weg dahin
        // und muesste bei jedem Fensterwechsel nachgezogen werden.
        // RUNDE ECHTHARDWARE-4: der Griffpunkt gehoert in beide
        // Rechtecke. Ohne ihn bliebe bei jeder Form ausser dem Pfeil
        // ein Streifen des alten Bildes stehen -- genau die "Spuren",
        // nach denen Justin gefragt hat.
        let gx: u64 = wmcursor.cur_ox(state)
        let gy: u64 = wmcursor.cur_oy(state)
        let gw: u64 = wmcursor.cur_w(state)
        // ================================ RUNDE GPU (G-012)
        // HIER WIRD DIE ARBEIT WIRKLICH GESPART. Traegt die Hardware
        // den Zeiger, wird KEIN Rechteck schmutzig: weder das alte
        // noch das neue. `compose` laeuft fuer die Bewegung gar nicht
        // mehr an, und `present` traegt nichts hinaus -- die Bewegung
        // kostet einen Befehl von 56 Oktetten statt zweier Rechtecke
        // Bildpunkte. Das ist die Zahl, die diese Runde misst.
        if wmcursor.hwcur_an(state) {
            wmlayout.ss(state, wmlayout.S_CURX, nx)
            wmlayout.ss(state, wmlayout.S_CURY, ny)
            wmcursor.hwcur_bewegen(state)
        } else {
            if !pixelguard.bug_is(3) {
                wmbase.damage_ex(state, ox as i64 - gx as i64, oy as i64 - gy as i64,
                    (ox + gw) as i64 - gx as i64, (oy + gw) as i64 - gy as i64, wmbase.BT_ALL)
            }
            wmlayout.ss(state, wmlayout.S_CURX, nx)
            wmlayout.ss(state, wmlayout.S_CURY, ny)
            wmbase.damage_ex(state, nx as i64 - gx as i64, ny as i64 - gy as i64,
                (nx + gw) as i64 - gx as i64, (ny + gw) as i64 - gy as i64, wmbase.BT_ALL)
        }
    }
    let x: i64 = nx as i64
    let y: i64 = ny as i64
    // ROUND ACTION-BUS-5 (AB-004): while the trusted dialog is up the
    // mouse belongs to it -- a press on a button answers it, nothing
    // reaches a window below
    if td_live(state) {
        if (btn & ps2m.B_LEFT) != 0 && (td_mb & ps2m.B_LEFT) == 0 {
            td_click(state, nx, ny)
        }
        td_mb = btn
        return
    }
    td_mb = btn
    // r382 LOCK SEAL: a drag or a resize that was running when the lock
    // came is ended; nothing moves a window while the screen is locked.
    if wmgate.sperre_an(state) {
        if wmlayout.gs(state, wmlayout.S_DRAG) != 0 {
            wmlayout.ss(state, wmlayout.S_DRAG, 0)
        }
        if wmlayout.gs(state, wmlayout.S_SIZING) != 0 {
            wmlayout.ss(state, wmlayout.S_SIZING, 0)
        }
    }
    // Ziehen
    if wmlayout.gs(state, wmlayout.S_DRAG) != 0 {
        let i: u64 = wmlayout.gs(state, wmlayout.S_DRAG) - 1
        if (btn & ps2m.B_LEFT) == 0 {
            wmlayout.ss(state, wmlayout.S_DRAG, 0)
            drag_end(state, i, x, y)
        } else {
            if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED) != 0 && wmlayout.wg(state, i, wmlayout.W_NODE) == 0 && !fb.nosnap_an(state) {
                let ddx: i64 = x - wmbase.win_x(state, i) - wmlayout.gs(state, wmlayout.S_DRAGX) as i64
                let ddy: i64 = y - wmbase.win_y(state, i) - wmlayout.gs(state, wmlayout.S_DRAGY) as i64
                let thr: i64 = 5 * wmgeom.uisc(state) as i64
                if ddx > thr || ddx < 0 - thr || ddy > thr || ddy < 0 - thr {
                    if !float_unmax(state, i, x, y) {
                        move_win(state, i, x - wmlayout.gs(state, wmlayout.S_DRAGX) as i64,
                            y - wmlayout.gs(state, wmlayout.S_DRAGY) as i64)
                    }
                    drag_hover(state, i, x, y)
                }
                return
            }
            move_win(state, i, x - wmlayout.gs(state, wmlayout.S_DRAGX) as i64,
                y - wmlayout.gs(state, wmlayout.S_DRAGY) as i64)
            drag_hover(state, i, x, y)
            return
        }
    }
    if wmlayout.gs(state, wmlayout.S_SIZING) != 0 {
        let i: u64 = wmlayout.gs(state, wmlayout.S_SIZING) - 1
        if (btn & ps2m.B_LEFT) == 0 {
            wmlayout.ss(state, wmlayout.S_SIZING, 0)
            // DELL ROUND: the end of a resize, on the wire (a runner reads it)
            if i < wmbase.MAX_WIN && wmbase.valid(state, i) {
                var s_gz: [u8; 17] = "wm: gezogen id=\0\0"
                var s_gx: [u8; 4] = " x=\0"
                var s_gy: [u8; 4] = " y=\0"
                var s_gw: [u8; 4] = " w=\0"
                var s_gh: [u8; 4] = " h=\0"
                serial.puts((&s_gz[0]) as u64)
                serial.dec(wmlayout.wg(state, i, wmlayout.W_ID))
                serial.puts((&s_gx[0]) as u64)
                serial.dec(wmbase.win_x(state, i) as u64)
                serial.puts((&s_gy[0]) as u64)
                serial.dec(wmbase.win_y(state, i) as u64)
                serial.puts((&s_gw[0]) as u64)
                serial.dec(wmlayout.wg(state, i, wmlayout.W_W))
                serial.puts((&s_gh[0]) as u64)
                serial.dec(wmlayout.wg(state, i, wmlayout.W_H))
                serial.nl()
            }
        } else {
            // RUNDE TILING: ein Fenster IM BAUM wird nicht frei
            // gezogen -- es verschiebt die Trennlinie.
            if wmlayout.wg(state, i, wmlayout.W_NODE) != 0 {
                tile_drag_resize(state, i, x, y)
                return
            }
            // RUNDE DESKTOP: der Rand kommt aus `inx`/`iny` und nicht
            // aus BORDER/TITLE_H -- ein Fenster ohne Schmuck (F_NODECO,
            // Schreibtisch und Taskleiste) hat keinen.
            // ==================================== RUNDE ECHTHARDWARE-5
            // GEGEN DEN ANKER RECHNEN, NICHT GEGEN DIE LINKE OBERE ECKE.
            //
            // Hier stand `x - win_x(...)`: die neue Breite war immer der
            // Abstand vom LINKEN Rand zum Zeiger. Fuer die rechte Kante
            // ist das richtig; fuer die linke ist es genau verkehrt
            // herum, und fuer die obere ebenso. Das ist der ganze Grund,
            // warum bei Justin nur rechts (und unten) etwas passierte.
            //
            // Jetzt: die angefasste Kante folgt dem Zeiger, die
            // GEGENUEBERLIEGENDE steht fest. Aus beiden ergibt sich die
            // Groesse -- und, wenn links oder oben gezogen wurde, ein
            // neuer Ursprung. Beides wird in EINEM Schritt gesetzt,
            // sonst zappelt das Fenster.
            let kanten: u64 = wmlayout.gs(state, wmlayout.S_SZEDGE)
            let ax: i64 = wmlayout.gs(state, wmlayout.S_SZAX) as i64
            let ay: i64 = wmlayout.gs(state, wmlayout.S_SZAY) as i64
            let ix: i64 = wmbase.inx(state, i) as i64
            let iy: i64 = wmbase.iny(state, i) as i64
            var nw: i64 = wmlayout.gs(state, wmlayout.S_SZAW) as i64
            var nh: i64 = wmlayout.gs(state, wmlayout.S_SZAH) as i64
            var nx: i64 = wmbase.win_x(state, i)
            var ny: i64 = wmbase.win_y(state, i)
            // RUNDE ECHTHARDWARE-6: der Zustand VOR dem Zug, fuer die
            // Meldung weiter unten.
            let alt_w: u64 = wmlayout.wg(state, i, wmlayout.W_W)
            let alt_h: u64 = wmlayout.wg(state, i, wmlayout.W_H)
            let alt_x: i64 = wmbase.win_x(state, i)
            let alt_y: i64 = wmbase.win_y(state, i)
            let offx: i64 = wmlayout.gs(state, wmlayout.S_SZOFFX) as i64
            let offy: i64 = wmlayout.gs(state, wmlayout.S_SZOFFY) as i64
            if (kanten & wmcursor.SZ_R) != 0 {
                nw = (x - offx) - (wmbase.win_x(state, i) + ix)
            } else if (kanten & wmcursor.SZ_L) != 0 {
                // Die rechte Kante steht bei `ax`; der Zeiger ist die
                // neue linke. Die Breite ist der Abstand dazwischen.
                nw = ax - (x - offx)
            }
            if (kanten & wmcursor.SZ_B) != 0 {
                nh = (y - offy) - (wmbase.win_y(state, i) + iy)
            } else if (kanten & wmcursor.SZ_T) != 0 {
                // DELL ROUND: `y - offy` is the OUTER top edge; the
                // content starts `iy` (the title bar) below it.
                nh = ay - ((y - offy) + iy)
            }
            // DIE MINDESTGROESSE, UND ZWAR VOR DEM VERSCHIEBEN.
            // Wer sie erst danach begrenzt, laesst das Fenster beim
            // Unterschreiten weiterwandern, obwohl es nicht mehr
            // schrumpft -- das ist das "Springen", das Justin
            // ausdruecklich nicht will.
            // DIESELBE UNTERGRENZE, DIE `resize_win` SELBST ZIEHT
            // (32x16 mit Schmuck, 1x1 ohne) -- hier noch einmal, weil
            // sie VOR dem Verschieben gebraucht wird und nicht erst
            // beim Ablehnen.
            var minw: i64 = 32
            var minh: i64 = 16
            if !win_deco(state, i) {
                minw = 1
                minh = 1
            }
            if nw < minw {
                nw = minw
            }
            if nh < minh {
                nh = minh
            }
            if (kanten & wmcursor.SZ_L) != 0 {
                nx = ax - nw - ix
            }
            if (kanten & wmcursor.SZ_T) != 0 {
                ny = ay - nh - iy
            }
            // ==================================== RUNDE ECHTHARDWARE-5
            // NICHT UEBER DEN LINKEN ODER OBEREN RAND HINAUS.
            //
            // GEMESSEN in dieser Runde: zieht man die linke Kante ueber
            // den Bildschirmrand, wird `nx` negativ (der Server meldete
            // `x=18446744073709551608`, also -8 als Zweierkomplement),
            // und der naechste Anstrich rechnet mit einer Adresse
            // ausserhalb des Rahmenpuffers. Ein Fenster, das man aus
            // dem Schirm herausziehen kann, ist kein Fenster mehr.
            //
            // Also: der Ursprung bleibt auf dem Schirm, und die Breite
            // wird entsprechend gekappt -- die angefasste Kante bleibt
            // damit unter dem Zeiger, bis der Rand erreicht ist, und
            // steht dann still.
            if (kanten & wmcursor.SZ_L) != 0 && nx < 0 {
                nw = nw + nx
                nx = 0
                if nw < minw {
                    nw = minw
                }
            }
            if (kanten & wmcursor.SZ_T) != 0 && ny < 0 {
                nh = nh + ny
                ny = 0
                if nh < minh {
                    nh = minh
                }
            }
            // RUNDE ECHTHARDWARE-5: die Spur des Ziehens. Ohne sie
            // ist "die Groesse aendert sich nicht" nicht von "die
            // Kante wurde nie angefasst" zu unterscheiden.
            var s_sz: [u8; 12] = "wm: zieh k=\0"
            var s_szw: [u8; 5] = " w=\0\0"
            var s_szh: [u8; 5] = " h=\0\0"
            var s_szx: [u8; 5] = " x=\0\0"
            var s_szr: [u8; 6] = " rc=\0\0"
            serial.puts((&s_sz[0]) as u64)
            serial.dec(kanten)
            serial.puts((&s_szw[0]) as u64)
            serial.dec(nw as u64)
            serial.puts((&s_szh[0]) as u64)
            serial.dec(nh as u64)
            serial.puts((&s_szx[0]) as u64)
            serial.dec(nx as u64)
            let ok: bool = resize_win(state, i, nw as u64, nh as u64)
            // ==================================== RUNDE ECHTHARDWARE-6
            // WAS DAS FENSTER VORHER WAR. Ohne diese vier Zahlen ist
            // `rc=1` nur eine Zusage: `resize_win` gibt auch dann true,
            // wenn es die Groesse auf die Untergrenze gekappt hat, und
            // von aussen sieht "gekappt" wie "nicht gewirkt" aus.
            // Justins Befund B ist genau diese Unterscheidung.
            var s_va: [u8; 8] = " vorw=\0\0"
            var s_vb: [u8; 8] = " vorh=\0\0"
            var s_vx: [u8; 8] = " vorx=\0\0"
            var s_vy: [u8; 8] = " vory=\0\0"
            serial.puts((&s_va[0]) as u64)
            serial.dec(alt_w)
            serial.puts((&s_vb[0]) as u64)
            serial.dec(alt_h)
            serial.puts((&s_vx[0]) as u64)
            serial.dec(alt_x as u64)
            serial.puts((&s_vy[0]) as u64)
            serial.dec(alt_y as u64)
            serial.puts((&s_szr[0]) as u64)
            if ok {
                serial.dec(1)
            } else {
                serial.dec(0)
            }
            serial.nl()
            if ok {
                if (kanten & wmcursor.SZ_L) != 0 || (kanten & wmcursor.SZ_T) != 0 {
                    move_win(state, i, nx, ny)
                }
            }
            return
        }
    }
    wmlayout.ss(state, wmlayout.S_MOVES, wmlayout.gs(state, wmlayout.S_MOVES) + 1)
    let i: u64 = wmgate.hit(state, x, y)
    if (btn & ~(wmlayout.gs(state, wmlayout.S_KEYS) & 7) & 7) != 0 {
        popup_outside(state, i)
    }
    // RUNDE SOFTUI: der Ueberfahr-Zustand der drei Schaltflaechen. Er
    // steht VOR dem Ausstieg fuer "kein Fenster getroffen", denn genau
    // dann muss er zurueckgesetzt werden -- sonst bleibt der rote
    // Schliessen-Knopf rot, nachdem der Zeiger das Fenster verlassen
    // hat.
    cap_track(state, i, x, y)
    dnd_hover(state, i, btn) // W-DND
    if wmlayout.gs(state, wmlayout.S_CAPDOWN) != 0 && (btn & ps2m.B_LEFT) == 0 {
        cap_release(state, i, x, y)
    }
    // RUNDE ECHTHARDWARE-4: die Form des Zeigers folgt dem, worueber
    // er steht. Der Aufruf steht VOR dem Ausstieg fuer "kein Fenster
    // getroffen" -- sonst bliebe der Doppelpfeil stehen, wenn man vom
    // Fensterrand auf den Schreibtisch faehrt.
    // r382 LOCK SEAL: the edges of a window that is not on the screen
    // must not show in the pointer shape either.
    if i < wmbase.MAX_WIN && !wmgate.darf(state, i) {
        wmcursor.margin_cursor(state, wmbase.MAX_WIN, x, y)
    } else {
        wmcursor.margin_cursor(state, i, x, y)
    }
    if i >= wmbase.MAX_WIN {
        return
    }
    // RUNDE ALLTAG: waehrend die Sperre steht, bekommt nur der Sperrer
    // etwas. Die Bewegung des Zeigers selbst laeuft weiter (sonst
    // klebte er fest), die EREIGNISSE gehen nicht hinaus.
    input_seen(state)
    if !wmgate.darf(state, i) {
        return
    }
    wmlayout.ss(state, wmlayout.S_HITS, wmlayout.gs(state, wmlayout.S_HITS) + 1)
    let lokal_x: i64 = x - wmbase.win_x(state, i) - wmbase.inx(state, i) as i64
    let lokal_y: i64 = y - wmbase.win_y(state, i) - wmbase.iny(state, i) as i64
    let mit_schmuck: bool = wmbase.deko(state, i)
    // Tastenwechsel erkennen: `ps2m` fuehrt den Zustand, hier steht der
    // zuletzt GESEHENE.
    let alt: u64 = wmlayout.gs(state, wmlayout.S_KEYS) & 7
    if btn != alt {
        wmlayout.ss(state, wmlayout.S_KEYS, (wmlayout.gs(state, wmlayout.S_KEYS) & ~7) | btn)
        if (btn & ps2m.B_LEFT) != 0 && (alt & ps2m.B_LEFT) == 0 {
            raise_win(state, i)
            // RUNDE DESKTOP: SCHREIBTISCH UND TASKLEISTE NEHMEN DIE
            // TASTATUR NICHT. Wer auf die Leiste klickt, will ein
            // Fenster wechseln und nicht in die Leiste tippen -- und
            // ein Schreibtisch, der den Fokus an sich zieht, macht
            // jeden Tastendruck danach wirkungslos.
            // RUNDE ECHTHARDWARE-1: ... ODER WENN DAS FENSTER
            // AUSDRUECKLICH DARUM GEBETEN HAT (F_KEYS).
            if wmlayout.wg(state, i, wmlayout.W_LAYER) == wmlayout.L_NORMAL
                || (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_KEYS) != 0 {
                set_focus(state, i)
            }
            if mit_schmuck {
                // RUNDE SOFTUI: die drei Schaltflaechen, wenn die Form
                // sie verlangt. Sie liegen VOR dem Ziehen der Leiste --
                // wer auf das Kreuz klickt, will nicht schieben.
                let cn: u64 = cap_at(state, i, x, y)
                if cn < wmlayout.CAP_N {
                    // r402: the press only HOLDS the button (painted darker); the action
                    // is `cap_act`, on release over the same button (`cap_release`).
                    wmlayout.ss(state, wmlayout.S_CAPDOWN, i * 4 + cn + 1)
                    damage_caption(state, i)
                    return
                }
                // Schliessfeld?
                let bx: i64 = wmbase.win_x(state, i) + wmbase.outer_w(state, i) as i64
                    - wmgeom.border(state) as i64 - wmgeom.close_w(state) as i64 - 3
                let by: i64 = wmbase.win_y(state, i) + 4
                let im_feld: bool = wmgeom.form(state, wmlayout.FM_CAPTION) == 0
                    && x >= bx && x < bx + wmgeom.close_w(state) as i64
                let im_feld2: bool = y >= by && y < by + wmgeom.close_w(state) as i64
                if im_feld && im_feld2 {
                    ev_push(state, i, wmlayout.E_CLOSE, 0, 0, 0)
                    destroy(state, i)
                    return
                }
                // ================================ RUNDE ECHTHARDWARE-5
                // ALLE VIER KANTEN UND ALLE VIER ECKEN.
                //
                // Justins Befund D, woertlich: "Ziehen funktioniert nur
                // an der rechten Kante." Hier stand `am_rechts ||
                // am_unten` -- die linke und die obere Kante wurden gar
                // nicht erst angefasst. Und sie HAETTEN auch nicht
                // funktionieren koennen: `resize_win` rechnet die neue
                // Groesse aus der linken oberen Ecke, die beim Ziehen an
                // der linken Kante ja gerade die ist, die sich bewegt.
                //
                // Also wird jetzt gemerkt, WELCHE Kanten angefasst
                // wurden (Bitmaske) und WO die gegenueberliegende Kante
                // steht (`S_SZAX`/`S_SZAY`). Die Bewegung rechnet dann
                // gegen diesen Anker: die festgehaltene Kante bleibt
                // stehen, das Fenster springt nicht, und eine Ecke
                // aendert beide Achsen zugleich, weil zwei Bits gesetzt
                // sind.
                //
                // DIESE PRUEFUNG STEHT VOR DEM ZIEHEN DER TITELLEISTE,
                // und das ist der eigentliche Fix. Stuende sie danach,
                // waere die OBERE Kante nie erreichbar: `lokal_y < 0`
                // ist die Titelleiste, und die faengt jeden Klick dort
                // ab. Ein Mensch, der ein Fenster oben groesser ziehen
                // will, greift genau dorthin.
                //
                // `lokal_y` ist relativ zur ARBEITSFLAECHE: 0 ist deren
                // Oberkante, die Titelleiste liegt bei negativem
                // `lokal_y`, und der aeussere Rahmen noch darueber. Die
                // obere Greifkante ist deshalb der schmale Streifen
                // GANZ OBEN im Schmuck -- nicht die ganze Titelleiste,
                // sonst liesse sich das Fenster nicht mehr schieben.
                let iw: i64 = wmlayout.wg(state, i, wmlayout.W_W) as i64
                let ih: i64 = wmlayout.wg(state, i, wmlayout.W_H) as i64
                // DELL ROUND: one test for press and cursor (`grip_mask`).
                let kanten: u64 = wmcursor.grip_mask(state, i, lokal_x, lokal_y)
                let im_rahmen: bool = kanten != 0
                if im_rahmen && kanten != 0 {
                    wmlayout.ss(state, wmlayout.S_SIZING, i + 1)
                    wmlayout.ss(state, wmlayout.S_SZEDGE, kanten)
                    // Die Kante, die STEHENBLEIBT, in Bildschirmmass.
                    wmlayout.ss(state, wmlayout.S_SZAX,
                        (wmbase.win_x(state, i) + wmbase.inx(state, i) as i64 + iw) as u64)
                    wmlayout.ss(state, wmlayout.S_SZAY,
                        (wmbase.win_y(state, i) + wmbase.iny(state, i) as i64 + ih) as u64)
                    wmlayout.ss(state, wmlayout.S_SZAW, iw as u64)
                    wmlayout.ss(state, wmlayout.S_SZAH, ih as u64)
                    // DELL ROUND: the grab offsets (see S_SZOFFX).
                    var ox: i64 = 0
                    var oy: i64 = 0
                    if (kanten & wmcursor.SZ_L) != 0 {
                        ox = x - (wmbase.win_x(state, i) + wmbase.inx(state, i) as i64)
                    } else if (kanten & wmcursor.SZ_R) != 0 {
                        ox = x - (wmbase.win_x(state, i) + wmbase.inx(state, i) as i64 + iw)
                    }
                    if (kanten & wmcursor.SZ_T) != 0 {
                        oy = y - wmbase.win_y(state, i)
                    } else if (kanten & wmcursor.SZ_B) != 0 {
                        oy = y - (wmbase.win_y(state, i) + wmbase.iny(state, i) as i64 + ih)
                    }
                    if fb.winfix_aus(state) {
                        // counter-proof: the old rule (pointer = content edge)
                        ox = 0
                        oy = 0
                        if (kanten & wmcursor.SZ_T) != 0 {
                            oy = 0 - wmbase.iny(state, i) as i64
                        }
                    }
                    wmlayout.ss(state, wmlayout.S_SZOFFX, ox as u64)
                    wmlayout.ss(state, wmlayout.S_SZOFFY, oy as u64)
                    return
                }
                // r1014: terminal tabs: a press on an inactive tab, a tab's 'x' or the '+' is the strip's, not the title bar's
                if lokal_y < 0 && wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM && tt_press(state, i, x, y) {
                    return
                }
                // r454: the strip of a window that paints its own title bar. The empty part (the drag region the program
                // declared) is the title bar: a press moves the window, a second press within one second (the system-wide double click time of wlib) maximises or restores
                // it. The rest of the strip -- the tabs, the plus button -- is the program's: the press goes to it as a
                // normal click (below). The caption buttons were tested above, the lock was tested before all of this.
                if cap_client(state, i) && lokal_y >= 0 && lokal_y < strip_h(state) as i64
                    && strip_drag_at(state, i, lokal_x) {
                    let nowt: u64 = time.mono_ns(state)
                    if wmlayout.gs(state, wmlayout.S_STRIPWIN) == i + 1 && nowt - wmlayout.gs(state, wmlayout.S_STRIPT) < 1000000000 {
                        wmlayout.ss(state, wmlayout.S_STRIPWIN, 0)
                        cap_act(state, i, wmlayout.CAP_MAX)
                        return
                    }
                    wmlayout.ss(state, wmlayout.S_STRIPWIN, i + 1)
                    wmlayout.ss(state, wmlayout.S_STRIPT, nowt)
                    drag_begin(state, i)
                    wmlayout.ss(state, wmlayout.S_DRAG, i + 1)
                    wmlayout.ss(state, wmlayout.S_DRAGX, (x - wmbase.win_x(state, i)) as u64)
                    wmlayout.ss(state, wmlayout.S_DRAGY, (y - wmbase.win_y(state, i)) as u64)
                    return
                }
                if lokal_y < 0 {
                    // die Titelleiste: ziehen
                    // RUNDE TILING: wer aus dem Baum gezogen wird, muss
                    // sich merken, dass er darin war.
                    drag_begin(state, i)
                    wmlayout.ss(state, wmlayout.S_DRAG, i + 1)
                    wmlayout.ss(state, wmlayout.S_DRAGX, (x - wmbase.win_x(state, i)) as u64)
                    wmlayout.ss(state, wmlayout.S_DRAGY, (y - wmbase.win_y(state, i)) as u64)
                    return
                }
                // ==================================== RUNDE ECHTHARDWARE-3
                // DER GRIFF WAR EIN QUADRAT VON ZWOELF BILDPUNKTEN.
                //
                // Justins Befund: "Fenstergroesse aendern funktioniert
                // nicht". Es funktionierte -- aber nur in der EINEN
                // Ecke unten rechts, und dort auf 12x12 Bildpunkten
                // (GRIP0). Auf seinem 2560x1440-Schirm mit uiscale 2
                // sind das 24x24, also ein knapper Millimeter Ziel:
                // wer den nicht trifft, ZIEHT DAS FENSTER, weil der
                // Klick daneben ein gewoehnlicher Klick ist. Das sieht
                // aus, als ginge es nicht.
                //
                // Jetzt ist der ganze RAND ein Griff: die rechte
                // Kante, die untere Kante und die Ecke dazwischen.
                // Das ist die Bedienung, die jedes andere System hat.
            }
            if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM && lokal_x >= 0 && lokal_y >= 0 {
                term_mouse(state, i, 0, lokal_x as u64, lokal_y as u64, btn)
            }
            wmlayout.ss(state, wmlayout.S_DOWNS, wmlayout.gs(state, wmlayout.S_DOWNS) + 1)
            // RUNDE TON: der Klickton. HIER, im Fensterserver, weil
            // hier JEDER Druck der linken Taste vorbeikommt -- kein
            // Programm muss dafuer etwas tun, und keines kann ihn
            // vergessen. Ohne das Wort `audio` ist es ein Vergleich.
            audio.click(state)
            ev_push(state, i, wmlayout.E_DOWN, lokal_x as u64, lokal_y as u64,
                btn | wmgate.mods_of(state))
            return
        }
        if (btn & ps2m.B_LEFT) == 0 && (alt & ps2m.B_LEFT) != 0 {
            if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM && lokal_x >= 0 && lokal_y >= 0 {
                term_mouse(state, i, 1, lokal_x as u64, lokal_y as u64, btn)
            }
            ev_push(state, i, wmlayout.E_UP, lokal_x as u64, lokal_y as u64, alt)
            return
        }
        // RUNDE K15: DIE RECHTE TASTE. Runde K10 sah nur die linke an --
        // sie brauchte nicht mehr, und der Rest lief still ueber die
        // Zustandsmaske. Ein Kontextmenue gibt es ohne rechte Taste
        // nicht, also kommt sie hier dazu: dieselben zwei Ereignisse,
        // dieselben Ortskoordinaten, und die Tastenmaske steht wie bei
        // der linken im dritten Wort. KEIN Heben und KEIN Fokuswechsel
        // dabei -- ein Rechtsklick soll das Fenster nicht umsortieren,
        // sondern nur fragen.
        if (btn & ps2m.B_RIGHT) != 0 && (alt & ps2m.B_RIGHT) == 0 {
            if lokal_x >= 0 && lokal_y >= 0 {
                if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM {
                    term_mouse(state, i, 3, lokal_x as u64, lokal_y as u64, btn)
                }
                wmlayout.ss(state, wmlayout.S_DOWNS, wmlayout.gs(state, wmlayout.S_DOWNS) + 1)
                ev_push(state, i, wmlayout.E_DOWN, lokal_x as u64, lokal_y as u64,
                    btn | wmgate.mods_of(state))
            }
            return
        }
        if (btn & ps2m.B_RIGHT) == 0 && (alt & ps2m.B_RIGHT) != 0 {
            if lokal_x >= 0 && lokal_y >= 0 {
                ev_push(state, i, wmlayout.E_UP, lokal_x as u64, lokal_y as u64,
                    alt)
            }
            return
        }
        // The MIDDLE button, like the right one: same two events, same local
        // coordinates, the button mask in the third word. No raise and no focus
        // change. Without this a remote-desktop viewer never saw a middle
        // click (gui_input: "mouse-middle" had 0 events); programs that do not
        // look at bit 4 ignore the event.
        if (btn & ps2m.B_MIDDLE) != 0 && (alt & ps2m.B_MIDDLE) == 0 {
            if lokal_x >= 0 && lokal_y >= 0 {
                if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM {
                    term_mouse(state, i, 4, lokal_x as u64, lokal_y as u64, btn)
                }
                wmlayout.ss(state, wmlayout.S_DOWNS, wmlayout.gs(state, wmlayout.S_DOWNS) + 1)
                ev_push(state, i, wmlayout.E_DOWN, lokal_x as u64, lokal_y as u64,
                    btn | wmgate.mods_of(state))
            }
            return
        }
        if (btn & ps2m.B_MIDDLE) == 0 && (alt & ps2m.B_MIDDLE) != 0 {
            if lokal_x >= 0 && lokal_y >= 0 {
                ev_push(state, i, wmlayout.E_UP, lokal_x as u64, lokal_y as u64,
                    alt)
            }
            return
        }
    }
    if lokal_x >= 0 && lokal_y >= 0 {
        if (btn & ps2m.B_LEFT) != 0 && wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM {
            term_mouse(state, i, 2, lokal_x as u64, lokal_y as u64, btn)
        }
        let wid: u64 = wmlayout.wg(state, i, wmlayout.W_ID)
        if wid != mv_wid || lokal_x != mv_lx || lokal_y != mv_ly || btn != mv_btn {
            mv_wid = wid
            mv_lx = lokal_x
            mv_ly = lokal_y
            mv_btn = btn
            ev_push(state, i, wmlayout.E_MOVE, lokal_x as u64, lokal_y as u64, btn)
        }
    }
}

// ============================================ ROUND ACTION-BUS-5 (AB-004)
// THE TRUSTED CONFIRMATION DIALOG.
//
// Until this round a parked call of the action bus was confirmed with
// `act confirm <no>` on a shell -- a line of text any program could fake
// on the screen, and a question the person had to go and look for. Now
// the broker asks HERE (sys.WM_TRUST) and the window server paints the
// question itself, in `compose`, AFTER every window and before the
// pointer: no window, no panel, no plugin can draw over it. The answer
// comes from `on_key` and `on_mouse` only -- the paths of the real
// keyboard and mouse. A program that types into windows (WM_FWIN) puts
// events into the ring of a WINDOW; the dialog is none, so no program
// can press its buttons, the broker's own adapters included.
//
//   J / Y or a click on "Erlauben"  -> yes
//   N / Escape or "Ablehnen"        -> no
//
// Keys and clicks in the first 400 ms after it appears are ignored, so a
// key already on its way (someone typing when it pops up) cannot answer
// it; Enter is NOT an answer for the same reason. While the screen is
// locked the dialog waits invisibly: the lock screen owns keyboard and
// screen, and a question over it would show who wants what to anyone
// standing at the machine. One dialog at a time; the broker queues.
const TD_COLS: u64 = 60
const TD_HEAD_MAX: u64 = 6
const TD_DET_MAX: u64 = 6
const TD_BTN: u64 = 18
const TD_IN: u64 = 704
const TD_RS: u64 = 30
static mut td_on: u64 = 0
static mut td_no: u64 = 0
static mut td_ans: u64 = 0
static mut td_ansno: u64 = 0
static mut td_t0: u64 = 0
static mut td_mb: u64 = 0
static mut td_shown: u64 = 0
static mut td_focus: u64 = 1
static mut td_nhead: u64 = 0
static mut td_ndet: u64 = 0
static mut td_open: u64 = 0
static mut td_txt: [u8; 768] = [0 as u8; 768]
static mut td_in: [u8; 704] = [0 as u8; 704]
static mut td_title: [u8; 72] = [0 as u8; 72]
static mut td_yes: [u8; 24] = [0 as u8; 24]
static mut td_nol: [u8; 24] = [0 as u8; 24]
static mut td_hint: [u8; 72] = [0 as u8; 72]
static mut td_dlab: [u8; 48] = [0 as u8; 48]

fn td_line(l: u64) -> u64 {
    return ((&td_txt[0]) as u64) + l * 64
}

fn td_inp() -> u64 {
    return (&td_in[0]) as u64
}

fn td_norm(p: u64, n: u64) -> u64 {
    var o: u64 = 0
    var k: u64 = 0
    while k < n && o + 2 < TD_IN {
        let ch: u64 = kstate.get8(p + k)
        k = k + 1
        if ch == 0 {
            k = n
        } else if ch == TD_RS || ch == 10 || (ch >= 32 && ch <= 126) {
            kstate.set8(td_inp() + o, ch as u8)
            o = o + 1
        } else if ch == 0xC3 && k < n {
            let nx: u64 = kstate.get8(p + k)
            k = k + 1
            var a: u64 = 63
            var b: u64 = 0
            if nx == 0xA4 {
                a = 97
                b = 101
            } else if nx == 0xB6 {
                a = 111
                b = 101
            } else if nx == 0xBC {
                a = 117
                b = 101
            } else if nx == 0x9F {
                a = 115
                b = 115
            } else if nx == 0x84 {
                a = 65
                b = 101
            } else if nx == 0x96 {
                a = 79
                b = 101
            } else if nx == 0x9C {
                a = 85
                b = 101
            }
            kstate.set8(td_inp() + o, a as u8)
            o = o + 1
            if b != 0 {
                kstate.set8(td_inp() + o, b as u8)
                o = o + 1
            }
        } else if ch >= 0x80 && ch < 0xC0 {
            o = o
        } else {
            kstate.set8(td_inp() + o, 63 as u8)
            o = o + 1
        }
    }
    kstate.set8(td_inp() + o, 0 as u8)
    return o
}

fn td_seps(n: u64) -> u64 {
    var c: u64 = 0
    var i: u64 = 0
    while i < n {
        if kstate.get8(td_inp() + i) == TD_RS {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn td_fstart(n: u64, idx: u64) -> u64 {
    var f: u64 = 0
    var i: u64 = 0
    while f < idx && i < n {
        if kstate.get8(td_inp() + i) == TD_RS {
            f = f + 1
        }
        i = i + 1
    }
    if f < idx {
        return n + 1
    }
    return i
}

fn td_fend(n: u64, s: u64) -> u64 {
    var i: u64 = s
    while i < n && kstate.get8(td_inp() + i) != TD_RS {
        i = i + 1
    }
    return i
}

fn td_cpz(dst: u64, src: u64, max: u64) {
    var i: u64 = 0
    while i + 1 < max && kstate.get8(src + i) != 0 {
        kstate.set8(dst + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    kstate.set8(dst + i, 0 as u8)
}

fn td_cpn(dst: u64, a: u64, b: u64, max: u64) {
    var i: u64 = 0
    while a + i < b && i + 1 < max {
        let ch: u64 = kstate.get8(td_inp() + a + i)
        if ch == 10 {
            kstate.set8(dst + i, 32 as u8)
        } else {
            kstate.set8(dst + i, ch as u8)
        }
        i = i + 1
    }
    kstate.set8(dst + i, 0 as u8)
}

fn td_pick(n: u64, idx: u64, dst: u64, max: u64, def: u64) {
    let s: u64 = td_fstart(n, idx)
    if s <= n {
        let e: u64 = td_fend(n, s)
        if e > s {
            td_cpn(dst, s, e, max)
            return
        }
    }
    td_cpz(dst, def, max)
}

fn td_wrap(a: u64, b: u64, l0: u64, maxl: u64) -> u64 {
    var l: u64 = 0
    var c: u64 = 0
    var last: u64 = 0
    var any: u64 = 0
    var k: u64 = a
    while k < b {
        let ch: u64 = kstate.get8(td_inp() + k)
        k = k + 1
        if ch == 10 {
            l = l + 1
            c = 0
        } else {
            if c >= TD_COLS {
                var sp: u64 = TD_COLS
                while sp > 0 && kstate.get8(td_line(l0 + l) + sp - 1) != 32 {
                    sp = sp - 1
                }
                var nc: u64 = 0
                if sp > TD_COLS / 2 && l + 1 < maxl {
                    var q: u64 = sp
                    while q < TD_COLS {
                        kstate.set8(td_line(l0 + l + 1) + nc, kstate.get8(td_line(l0 + l) + q) as u8)
                        kstate.set8(td_line(l0 + l) + q, 0 as u8)
                        nc = nc + 1
                        q = q + 1
                    }
                }
                l = l + 1
                c = nc
            }
            if l < maxl {
                kstate.set8(td_line(l0 + l) + c, ch as u8)
                c = c + 1
                any = 1
                last = l
            }
        }
    }
    if any == 0 {
        return 0
    }
    return last + 1
}

fn td_body() -> u64 {
    var b: u64 = td_nhead
    if b == 0 {
        b = 1
    }
    if td_ndet > 0 {
        b = b + 1
        if td_open != 0 {
            b = b + td_ndet
        }
    }
    return b
}

fn td_head_rows() -> u64 {
    if td_nhead == 0 {
        return 1
    }
    return td_nhead
}

fn td_layout_line(state: u64) {
    var s_tl: [u8; 29] = "wm: trusted dialog layout y=\0"
    var s_tl1: [u8; 7] = " hint=\0"
    var s_tl2: [u8; 6] = " btn=\0"
    var s_tl3: [u8; 4] = " h=\0"
    var s_tl4: [u8; 7] = " body=\0"
    var s_tl5: [u8; 4] = " x=\0"
    var s_tl6: [u8; 4] = " w=\0"
    serial.puts((&s_tl[0]) as u64)
    serial.dec(td_y(state))
    serial.puts((&s_tl4[0]) as u64)
    serial.dec(td_row(state, 3))
    serial.put(45 as u8)
    serial.dec(td_row(state, 3 + td_body()))
    serial.puts((&s_tl1[0]) as u64)
    serial.dec(td_row(state, td_body() + 4))
    serial.puts((&s_tl2[0]) as u64)
    serial.dec(td_by(state))
    serial.puts((&s_tl3[0]) as u64)
    serial.dec(td_h(state))
    serial.puts((&s_tl5[0]) as u64)
    serial.dec(td_x(state))
    serial.puts((&s_tl6[0]) as u64)
    serial.dec(td_w(state))
    serial.nl()
}

fn trust_ask(state: u64, no: u64, p: u64, n: u64) -> bool {
    if td_on != 0 || no == 0 {
        return false
    }
    var i: u64 = 0
    while i < 768 {
        kstate.set8(td_line(0) + i, 0 as u8)
        i = i + 1
    }
    let m: u64 = td_norm(p, n)
    var d_tit: [u8; 72] = [0 as u8; 72]
    var d_tsf: [u8; 29] = " - Bestätigung (vom System)\0"
    brand.append((&d_tit[0]) as u64, brand.append((&d_tit[0]) as u64, 0, brand.product(), 71), (&d_tsf[0]) as u64, 71)
    var d_yes: [u8; 13] = "[J] Erlauben\0"
    var d_no: [u8; 13] = "[N] Ablehnen\0"
    var d_hnt: [u8; 54] = "Nur echte Tastatur/Maus:  J = erlauben   N = ablehnen\0"
    var d_det: [u8; 8] = "Details\0"
    var hs: u64 = 0
    var he: u64 = m
    td_ndet = 0
    td_open = 0
    td_cpz((&td_dlab[0]) as u64, (&d_det[0]) as u64, 48)
    if td_seps(m) > 0 {
        td_pick(m, 0, (&td_title[0]) as u64, 72, (&d_tit[0]) as u64)
        td_pick(m, 3, (&td_yes[0]) as u64, 24, (&d_yes[0]) as u64)
        td_pick(m, 4, (&td_nol[0]) as u64, 24, (&d_no[0]) as u64)
        td_pick(m, 5, (&td_hint[0]) as u64, 72, (&d_hnt[0]) as u64)
        hs = td_fstart(m, 1)
        if hs > m {
            hs = m
        }
        he = td_fend(m, hs)
        let ds: u64 = td_fstart(m, 2)
        if ds <= m {
            let de: u64 = td_fend(m, ds)
            var le: u64 = ds
            while le < de && kstate.get8(td_inp() + le) != 10 {
                le = le + 1
            }
            if le > ds {
                td_cpn((&td_dlab[0]) as u64, ds, le, 48)
            }
            if le + 1 < de {
                td_ndet = td_wrap(le + 1, de, TD_HEAD_MAX, TD_DET_MAX)
            }
        }
    } else {
        td_cpz((&td_title[0]) as u64, (&d_tit[0]) as u64, 72)
        td_cpz((&td_yes[0]) as u64, (&d_yes[0]) as u64, 24)
        td_cpz((&td_nol[0]) as u64, (&d_no[0]) as u64, 24)
        td_cpz((&td_hint[0]) as u64, (&d_hnt[0]) as u64, 72)
    }
    td_nhead = td_wrap(hs, he, 0, TD_HEAD_MAX)
    td_no = no
    td_ans = 0
    td_ansno = 0
    td_focus = 1
    td_t0 = time.mono_ns(state)
    td_on = 1
    td_shown = td_shown + 1
    wmbase.damage_all(state)
    var s_td: [u8; 26] = "wm: trusted dialog up no=\0"
    serial.puts((&s_td[0]) as u64)
    serial.dec(no)
    serial.nl()
    td_layout_line(state)
    return true
}

fn td_toggle(state: u64) {
    if td_ndet == 0 {
        return
    }
    td_open = 1 - td_open
    wmbase.damage_all(state)
    var s_tg: [u8; 33] = "wm: trusted dialog details open=\0"
    serial.puts((&s_tg[0]) as u64)
    serial.dec(td_open)
    serial.nl()
}

fn trust_poll(state: u64, no: u64) -> u64 {
    if no != 0 && td_ansno == no && td_ans != 0 {
        return td_ans
    }
    if td_on != 0 && td_no == no {
        return 0
    }
    return 3
}

fn trust_cancel(state: u64, no: u64) {
    if td_on != 0 && td_no == no {
        td_on = 0
        wmbase.damage_all(state)
        var s_tc: [u8; 28] = "wm: trusted dialog down no=\0"
        serial.puts((&s_tc[0]) as u64)
        serial.dec(no)
        serial.nl()
    }
}

fn td_answer(state: u64, v: u64) {
    td_ans = v
    td_ansno = td_no
    td_on = 0
    wmbase.damage_all(state)
    var s_ta: [u8; 27] = "wm: trusted dialog answer=\0"
    var s_tn: [u8; 5] = " no=\0"
    serial.puts((&s_ta[0]) as u64)
    serial.dec(v)
    serial.puts((&s_tn[0]) as u64)
    serial.dec(td_no)
    serial.nl()
}

fn td_live(state: u64) -> bool {
    return td_on != 0 && !wmgate.sperre_an(state)
}

fn td_armed(state: u64) -> bool {
    return time.mono_ns(state) - td_t0 >= 400000000
}

fn trust_key(state: u64, c: u64) -> bool {
    if !td_live(state) {
        return false
    }
    if !td_armed(state) {
        return true
    }
    if c == 106 || c == 74 || c == 121 || c == 89 {
        td_answer(state, 1)
    } else if c == 110 || c == 78 || c == 27 {
        td_answer(state, 2)
    } else if c == 100 || c == 68 {
        td_toggle(state)
    } else if c == 9 {
        td_focus = 1 - td_focus
        wmbase.damage_all(state)
    } else if c == 13 || c == 10 || c == 32 {
        td_answer(state, td_focus + 1)
    }
    return true
}

fn td_k(state: u64) -> u64 {
    if fb.width(state) >= 1600 {
        return 2
    }
    return 1
}

fn td_gw(state: u64) -> u64 {
    return font.GLYPH_W * td_k(state)
}

fn td_gh(state: u64) -> u64 {
    return font.GLYPH_H * td_k(state)
}

fn td_w(state: u64) -> u64 {
    return (TD_COLS + 4) * td_gw(state)
}

fn td_h(state: u64) -> u64 {
    return (td_body() + 9) * td_gh(state)
}

fn td_x(state: u64) -> u64 {
    if td_w(state) >= fb.width(state) {
        return 0
    }
    return (fb.width(state) - td_w(state)) / 2
}

fn td_y(state: u64) -> u64 {
    if td_h(state) >= fb.height(state) {
        return 0
    }
    return (fb.height(state) - td_h(state)) / 3
}

fn td_row(state: u64, r: u64) -> u64 {
    return td_y(state) + r * td_gh(state)
}

// the buttons: 0 = yes (left), 1 = no (right)
fn td_bx(state: u64, b: u64) -> u64 {
    if b == 0 {
        return td_x(state) + 2 * td_gw(state)
    }
    return td_x(state) + (TD_COLS + 2 - TD_BTN) * td_gw(state)
}

fn td_by(state: u64) -> u64 {
    return td_row(state, td_body() + 6)
}

fn td_bh(state: u64) -> u64 {
    return 2 * td_gh(state)
}

fn td_click(state: u64, x: u64, y: u64) {
    if !td_armed(state) {
        return
    }
    let tr: u64 = td_row(state, 3 + td_head_rows())
    if td_ndet > 0 && y >= tr && y < tr + td_gh(state) && x >= td_x(state) && x < td_x(state) + td_w(state) {
        td_toggle(state)
        return
    }
    if y < td_by(state) || y >= td_by(state) + td_bh(state) {
        return
    }
    var b: u64 = 0
    while b < 2 {
        let bx: u64 = td_bx(state, b)
        if x >= bx && x < bx + TD_BTN * td_gw(state) {
            td_answer(state, b + 1)
            b = 2
        } else {
            b = b + 1
        }
    }
}

fn td_str(state: u64, x: u64, y: u64, p: u64, n: u64, fg: u64) {
    let k: u64 = td_k(state)
    let gw: u64 = td_gw(state)
    var i: u64 = 0
    var cx: u64 = x
    while i < n && cx + gw <= fb.width(state) {
        let ch: u64 = kstate.get8(p + i)
        if ch == 0 {
            i = n
        } else {
            var r: u64 = 0
            while r < font.GLYPH_H {
                let bits: u64 = font.row(state + fb.FONT_OFF, ch, r)
                var c: u64 = 0
                while c < font.GLYPH_W {
                    if (bits & (1 << (7 - c))) != 0 {
                        if k == 1 {
                            fb.pixel(state, cx + c, y + r, fg)
                        } else {
                            fb.fill(state, cx + c * k, y + r * k, k, k, fg)
                        }
                    }
                    c = c + 1
                }
                r = r + 1
            }
            cx = cx + gw
            i = i + 1
        }
    }
}

fn td_paint(state: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if !td_live(state) {
        return
    }
    let x: u64 = td_x(state)
    let y: u64 = td_y(state)
    let w: u64 = td_w(state)
    let h: u64 = td_h(state)
    if x1 <= x || x0 >= x + w || y1 <= y || y0 >= y + h {
        return
    }
    let k: u64 = td_k(state)
    let gw: u64 = td_gw(state)
    let gh: u64 = td_gh(state)
    let rand: u64 = fb.rgb(state, 0x5A, 0x64, 0x80)
    let cx0: i64 = x0 as i64
    let cy0: i64 = y0 as i64
    let cx1: i64 = x1 as i64
    let cy1: i64 = y1 as i64
    wmdraw.fill_round(state, x as i64, y as i64, w as i64, h as i64, 8 * k, rand, 255, cx0, cy0, cx1, cy1)
    wmdraw.fill_round(state, (x + k) as i64, (y + k) as i64, (w - 2 * k) as i64, (h - 2 * k) as i64, 7 * k,
        fb.rgb(state, 0x20, 0x22, 0x2C), 255, cx0, cy0, cx1, cy1)
    td_str(state, x + 2 * gw, td_row(state, 1), (&td_title[0]) as u64, 72,
        fb.rgb(state, 0x60, 0xA8, 0xF0))
    let nh: u64 = td_head_rows()
    var l: u64 = 0
    while l < td_nhead {
        td_str(state, x + 2 * gw, td_row(state, 3 + l), td_line(l), 64,
            fb.rgb(state, 0xE8, 0xE8, 0xE8))
        l = l + 1
    }
    if td_ndet > 0 {
        var s_dk: [u8; 4] = "[D]\0"
        var s_dm: [u8; 2] = "-\0"
        var s_dp: [u8; 2] = "+\0"
        let trow: u64 = td_row(state, 3 + nh)
        td_str(state, x + 2 * gw, trow, (&s_dk[0]) as u64, 5, fb.rgb(state, 0x9A, 0xA0, 0xB0))
        td_str(state, x + 7 * gw, trow, (&td_dlab[0]) as u64, 48, fb.rgb(state, 0x9A, 0xA0, 0xB0))
        if td_open != 0 {
            td_str(state, x + (TD_COLS - 1) * gw, trow, (&s_dm[0]) as u64, 2, fb.rgb(state, 0x9A, 0xA0, 0xB0))
        } else {
            td_str(state, x + (TD_COLS - 1) * gw, trow, (&s_dp[0]) as u64, 2, fb.rgb(state, 0x9A, 0xA0, 0xB0))
        }
        if td_open != 0 {
            var d: u64 = 0
            while d < td_ndet {
                td_str(state, x + 4 * gw, td_row(state, 4 + nh + d), td_line(TD_HEAD_MAX + d), 64,
                    fb.rgb(state, 0xB4, 0xBA, 0xC8))
                d = d + 1
            }
        }
    }
    td_str(state, x + 2 * gw, td_row(state, td_body() + 4),
        (&td_hint[0]) as u64, 72, fb.rgb(state, 0x9A, 0xA0, 0xB0))
    let by: u64 = td_by(state)
    let bh: u64 = td_bh(state)
    let bw: u64 = TD_BTN * gw
    wmdraw.fill_round(state, (td_bx(state, td_focus) - 2 * k) as i64, (by - 2 * k) as i64, (bw + 4 * k) as i64, (bh + 4 * k) as i64,
        6 * k, fb.rgb(state, 0xF0, 0xF0, 0xF0), 255, cx0, cy0, cx1, cy1)
    wmdraw.fill_round(state, td_bx(state, 0) as i64, by as i64, bw as i64, bh as i64, 4 * k, fb.rgb(state, 0x0F, 0x6C, 0xBD), 255, cx0, cy0, cx1, cy1)
    wmdraw.fill_round(state, td_bx(state, 1) as i64, by as i64, bw as i64, bh as i64, 4 * k, fb.rgb(state, 0x4A, 0x4E, 0x5A), 255, cx0, cy0, cx1, cy1)
    let ty: u64 = by + gh / 2
    td_str(state, td_bx(state, 0) + gw, ty, (&td_yes[0]) as u64, 24,
        fb.rgb(state, 0xFF, 0xFF, 0xFF))
    td_str(state, td_bx(state, 1) + gw, ty, (&td_nol[0]) as u64, 24,
        fb.rgb(state, 0xFF, 0xFF, 0xFF))
}

fn input_seen(state: u64) {
    kstate.set(state, kstate.K11_OFF + kstate.SP_LAST, time.mono_ns(state))
}

fn on_key(state: u64, c: u64) {
    if !wmbase.ready(state) || c == 0 {
        return
    }
    input_seen(state)
    lj_input(state) // r1049: a key starts the active stretch too (only the pointer did)
    // W-DND: Esc cancels a running drag
    if c == 27 && dnd_cancel(state) {
        wmlayout.ss(state, wmlayout.S_KSWAL, 1)
        return
    }
    // W1d: while the Alt+Tab panel is open, Esc closes it and no key reaches a window
    if sw_open != 0 {
        if c == 27 {
            sw_cancel(state)
        }
        wmlayout.ss(state, wmlayout.S_KSWAL, 1)
        return
    }
    // ROUND ACTION-BUS-5 (AB-004): the trusted dialog takes the key
    // FIRST -- before a plugin, before the focus, and not for the
    // terminal either
    if trust_key(state, c) {
        wmlayout.ss(state, wmlayout.S_KSWAL, 1)
        return
    }
    // RUNDE MESSTAFEL, Stufe 3 fuer die Tastatur.
    wmlayout.ss(state, wmlayout.S_KEYIN, wmlayout.gs(state, wmlayout.S_KEYIN) + 1)
    // COMPOSITOR S5: the compositor sees THAT a key came, and its code only while Alt or the Windows key is held (a shortcut)
    if cp_shortcut(state) != 0 {
        cp_event(state, CP_EV_KEY, 1, 0, 0, 0, c)
    } else {
        cp_event(state, CP_EV_KEY, 0, 0, 0, 0, 0)
    }
    // ================================================ RUNDE WMPLUGIN
    // ERST DAS PLUGIN, DANN DAS FENSTER -- und zwar in dieser Reihe.
    //
    // Ein Kuerzel, das ein Plugin belegt hat, darf das Fenster NICHT
    // mehr sehen: sonst tippt der Zoom-Effekt sein `z` zusaetzlich in
    // den Texteditor darunter. Der Kern fragt dafuer eine Tafel ab
    // (acht Vergleiche), legt bei einem Treffer ein Ereignis ab und
    // kehrt zurueck. ER RUFT DABEI KEIN PLUGIN UND WARTET AUF KEINES;
    // ob das Plugin sein Ereignis je abholt, aendert an diesem Pfad
    // nichts -- holt es nicht ab, wirft es die Frist hinaus.
    var mods: u64 = 0
    if kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1 {
        mods = mods | 2
    }
    if kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 1 {
        mods = mods | 4
    }
    // r382 LOCK SEAL: while locked no plugin gets the key (its shortcut
    // could act on windows behind the lock); it goes to the locker only.
    if !wmgate.sperre_an(state) && wmplug.key_owner(state, c, mods) < wmplug.MAX_PLUG {
        wmplug.notify(state, wmplug.E_KEY, c, mods, 0)
        wmlayout.ss(state, wmlayout.S_KPLUG, wmlayout.gs(state, wmlayout.S_KPLUG) + 1)
        // Und AUCH nicht an das Terminal des Fokusfensters: `key_tty`
        // liest diesen Merker unmittelbar nach uns.
        wmlayout.ss(state, wmlayout.S_KSWAL, 1)
        var s_pk: [u8; 16] = "wm: plugkey c=\0\0"
        var s_pm: [u8; 6] = " mod=\0"
        serial.puts((&s_pk[0]) as u64)
        serial.dec(c)
        serial.puts((&s_pm[0]) as u64)
        serial.dec(mods)
        serial.nl()
        return
    }
    if wmlayout.gs(state, wmlayout.S_NOFOCUS) != 0 {
        var i: u64 = 0
        while i < wmbase.MAX_WIN {
            if wmlayout.wg(state, i, wmlayout.W_USED) != 0 && wmgate.darf(state, i) {
                ev_push(state, i, wmlayout.E_KEY, c, 0, 0)
            }
            i = i + 1
        }
        return
    }
    // RUNDE ALLTAG: WAEHREND DER SPERRE GEHT DIE TASTE AN DEN SPERRER,
    // ohne nach dem Fokus zu fragen.
    //
    // Sein Fenster liegt auf der obersten Ebene, und Fenster dieser
    // Ebene bekommen den Fokus mit Absicht NICHT (das ist die Regel,
    // die die Taskleiste braucht). Der erste Anlauf hat deshalb jede
    // Taste weggeworfen: der Sperrbildschirm stand da und nahm kein
    // Kennwort an. Gemessen mit `sendkey`.
    if wmgate.sperre_an(state) {
        var k: u64 = 0
        while k < wmbase.MAX_WIN {
            if wmlayout.wg(state, k, wmlayout.W_USED) != 0 && wmgate.darf(state, k) {
                ev_push(state, k, wmlayout.E_KEY, c, 0, 0)
                k = wmbase.MAX_WIN
            } else {
                k = k + 1
            }
        }
        return
    }
    let f: u64 = wmbase.focus(state)
    if f < wmbase.MAX_WIN && wmgate.darf(state, f) {
        ev_push(state, f, wmlayout.E_KEY, c, 0, 0)
    }
}

// r1129b: when may the PS/2 fallback look at the controller? (see the comment in `poll`)
const PS2_WD_TICKS: u64 = 10 // watchdog period while IRQ 12 works: 100 ms
const PS2_FALL_TICKS: u64 = 200 // after a rescued byte: poll every tick for 2 s
static mut ps2_wd_at: u64 = 0
static mut ps2_fall_until: u64 = 0
fn ps2_poll_due(now: u64) -> bool {
    if now < ps2_fall_until {
        return true
    }
    if now - ps2_wd_at >= PS2_WD_TICKS || now < ps2_wd_at {
        ps2_wd_at = now
        return true
    }
    return false
}

// Wird aus der Hauptschleife gerufen: hat sich am Zeiger etwas getan?
fn poll(state: u64) -> bool {
    if !wmbase.ready(state) {
        return false
    }
    // ================================================ RUNDE WMPLUGIN
    // DER KEHRBESEN HAENGT NICHT AM BILD, SONDERN AN DER UHR.
    //
    // Gemessen: ein Plugin, das nach dem Anmelden in eine Endlosschleife
    // lief, blieb auf seinem Platz stehen -- weil auf einem RUHIGEN
    // Schreibtisch gar nicht zusammengesetzt wird und `compose` seinen
    // Kehrbesen deshalb nie erreichte. Eine Frist, die nur greift,
    // solange sich etwas bewegt, ist keine.
    //
    // Also einmal je TICK, aus dem Abfragepfad heraus. Der Preis ist
    // EIN Vergleich je Durchlauf (der Tick hat sich fast nie geaendert)
    // und acht Vergleiche je Hundertstelsekunde. Gewartet wird auch
    // hier auf niemanden.
    let jetzt: u64 = kstate.get(state, kstate.TICKS)
    var tick_new: bool = false
    if jetzt != wmlayout.gs(state, wmlayout.S_SWTICK) {
        tick_new = true
        wmlayout.ss(state, wmlayout.S_SWTICK, jetzt)
        wmplug.sweep(state)
        tcur_tick(state) // r1014: terminal cursor blink
    }
    // RUNDE TILING: erst die Tastenkuerzel. Sie liegen im Ring, den
    // `kbd.irq` fuellt, wenn Alt gehalten wird -- der Fensterserver
    // HOLT sie ab, statt dass die Tastatur ihn kennt.
    hotkeys(state)
    sw_tick(state) // W1d: Alt released -> the Alt+Tab switcher commits
    dnd_tick(state) // W-DND: hover-raise after the delay
    // DER RUECKFALL AUF ABFRAGE, und er steht hier mit Begruendung.
    //
    // Der Baustein meldet ueber IRQ 12, und das ist der Weg, den dieser
    // Treiber geht. Es gibt aber einen Zustand, in dem die Unterbrechung
    // AUSBLEIBT und trotzdem ein Oktett bereitliegt: das Zustandstor
    // sagt dann "Ausgabepuffer voll" (Bit 0) und "vom zweiten Anschluss"
    // (Bit 5). Wer nur auf die Unterbrechung wartet, hat dann einen
    // Zeiger, der stehenbleibt, und keinen Hinweis darauf, warum.
    //
    // Also wird hier NACHGESEHEN. Wie viele Oktette auf welchem der
    // beiden Wege kamen, steht in `irqs` und `polls` und wird gemeldet
    // -- eine Abfrage, die als Unterbrechung ausgegeben wird, waere eine
    // Luege ueber den Treiber.
    // r1122: ONCE PER TICK. The fallback looks at port 0x64 (a trapped port read, one VM exit in VirtualBox) and the
    // loop above runs more often than the clock ticks; IRQ 12 brings packets in time, the poll only rescues a lost one.
    // r1129b: WATCHDOG, NOT A POLL. Every look at port 0x64 is a trapped port read (one VM exit in VirtualBox, ~34-100 per second
    // before). While IRQ 12 delivers (the poll finds nothing) the controller is only looked at every PS2_WD_TICKS ticks. A look
    // that FINDS a byte means the IRQ was lost: from then on every tick polls again for PS2_FALL_TICKS ticks, then back to the watchdog.
    // W-INPUTHANG: the same watchdog look also covers the KEYBOARD byte (kbd.rescue; `nokbdpoll` = counter-proof without it) and no longer
    // needs a PS/2 mouse to be present: a machine with only a keyboard on the i8042 has the same lost-edge failure.
    let wd_due: bool = tick_new && ps2_poll_due(jetzt)
    if wd_due && !kstate.mode_on(state, kstate.M_NOKBDPOLL) {
        var kn: u64 = 0
        while kn < 16 && kbd.rescue(state) {
            kn = kn + 1
        }
        if kn != 0 {
            ps2_fall_until = jetzt + PS2_FALL_TICKS
        }
    }
    if wd_due && ps2m.present(state) && ps2m.polling(state) {
        let polls0: u64 = ps2m.polls(state)
        var n: u64 = 0
        while n < 64 && ps2m.poll_one(state) {
            // NACH JEDEM VOLLSTAENDIGEN PAKET, nicht am Ende des
            // Stapels: ein Druck und das Loslassen danach sind zwei
            // Pakete, und wer beide zusammen abholt und DANN nachsieht,
            // findet die Taste wieder oben und hat den Klick verloren.
            if ps2m.changed(state) {
                ps2m.take_change(state)
                on_mouse(state)
                lj_input(state)
            }
            n = n + 1
        }
        if ps2m.polls(state) != polls0 {
            ps2_fall_until = jetzt + PS2_FALL_TICKS
        }
    }
    if !ps2m.changed(state) {
        return false
    }
    ps2m.take_change(state)
    on_mouse(state)
    lj_input(state)
    return true
}

// ------------------------------------------------------ das Terminal
//
// Ein Fenster mit einem ZEICHENRASTER. Die Anwendung schickt Oktette,
// der Server fuehrt dieselbe Zustandsmaschine wie `fb.putc` (Umbruch,
// Rollen, Tabulator, Ruecktaste) und malt die Zellen mit der
// Festbreitenschrift. Damit kann eine Shell in einem Fenster laufen,
// ohne von Schriften etwas zu wissen.

fn term_setup(state: u64, i: u64) {
    tc_reset(i)
    let f: u64 = wmlayout.gs(state, wmlayout.S_FONT_MONO)
    var cw: u64 = 8
    var ch: u64 = 16
    if f < ttf.MAX_FONTS {
        let px: u64 = wmlayout.gs(state, wmlayout.S_PX_MONO)
        let gid: u64 = ttf.glyph_of(state, f, 0x4D) // 'M'
        cw = ((ttf.advance26(state, f, gid, px) + 63) >> 6) as u64
        ch = ttf.line_height(state, f, px)
    }
    if cw == 0 {
        cw = 8
    }
    if ch == 0 {
        ch = 16
    }
    if i < 32 {
        tp_sbv[(i) as usize] = 0
    }
    let alt_cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    let alt_rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    let alt_cy: u64 = wmlayout.wg(state, i, wmlayout.W_CY)
    let alt_cx: u64 = wmlayout.wg(state, i, wmlayout.W_CX)
    wmlayout.wsv(state, i, wmlayout.W_CELLW, cw)
    wmlayout.wsv(state, i, wmlayout.W_CELLH, ch)
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_W) / cw
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_H) / ch
    wmlayout.wsv(state, i, wmlayout.W_COLS, cols)
    wmlayout.wsv(state, i, wmlayout.W_ROWS, rows)
    let neu_gitter: bool = wmlayout.wg(state, i, wmlayout.W_GRID) == 0
    if neu_gitter {
        // r400: two frames -- the first holds the characters, the second one attribute
        // octet per cell (bit 0 = reverse video, set by the VT subset `term_csi`).
        // r462: six frames -- characters, attributes, colours, and the same three of the main screen while the alternate
        // screen is up (frames 3 .. 5)
        let g0: u64 = mem.frame_run(state, TG_FRAMES)
        wmlayout.wsv(state, i, wmlayout.W_GRID, g0)
        tp_reset(i)
        sb_free(state, i)
    }
    let g: u64 = wmlayout.wg(state, i, wmlayout.W_GRID)
    // ================================================== RUNDE ECHT
    // DER TEXT BLEIBT STEHEN, WENN MAN DAS FENSTER ZIEHT.
    //
    // Justins Befund am echten Geraet: "Terminal auf, Ausgabe da,
    // Fenster groesser ziehen -> Inhalt weg." Er hat recht, und die
    // Ursache stand genau hier: diese Funktion hat das GANZE
    // Zeichenraster mit Leerzeichen ueberschrieben und den Cursor auf
    // 0,0 gesetzt -- bei JEDEM Aufruf. `resize_win` ruft sie bei jeder
    // Groessenaenderung. Der Text war also nicht falsch umgebrochen,
    // er war GELOESCHT.
    //
    // Ein Terminal, dessen Fenster sich aendert, behaelt seinen Inhalt
    // -- das tut jedes Terminal, seit es Terminals gibt. Die Zeilen
    // werden in das neue Raster UMKOPIERT, Zeile fuer Zeile, so weit
    // sie hineinpassen. Was nicht mehr hineinpasst (schmaleres
    // Fenster), wird rechts abgeschnitten; das ist dasselbe, was xterm
    // ohne Neuumbruch tut, und es ist ehrlicher, als den Rest zu
    // loeschen.
    //
    // NUR EIN FRISCHES GITTER WIRD GELEERT. Das ist der Fall, fuer den
    // die Leerung urspruenglich gedacht war: ein neu angelegtes
    // Terminal, dessen Rahmen noch beliebigen Speicher traegt.
    if g != 0 {
        if neu_gitter || alt_cols == 0 || alt_rows == 0 {
            var k: u64 = 0
            while k < cols * rows && k < TG {
                kstate.set8(g + k, 32 as u8)
                k = k + 1
            }
            attr_clear(g)
            wmlayout.wsv(state, i, wmlayout.W_CX, 0)
            wmlayout.wsv(state, i, wmlayout.W_CY, 0)
        } else if cols != alt_cols || rows != alt_rows {
            attr_clear(g)
            // r462: the saved main screen and the scroll region belong to the old grid
            tp_alt[(i) as usize] = 0
            tp_top[(i) as usize] = 0
            tp_bot1[(i) as usize] = 0
            tp_wrap[(i) as usize] = 0
            // UMKOPIEREN, VON UNTEN NACH OBEN ODER VON OBEN NACH
            // UNTEN -- je nachdem, wohin geschoben wird, damit sich
            // Quelle und Ziel im selben Rahmen nicht ueberholen.
            // Zielzeile r liegt bei r*cols, Quellzeile bei r*alt_cols.
            // Wird das Raster BREITER, wandert jede Zeile nach hinten:
            // dann von der letzten Zeile an arbeiten.
            var lines: u64 = alt_rows
            if rows < lines {
                lines = rows
            }
            var wide: u64 = alt_cols
            if cols < wide {
                wide = cols
            }
            if cols > alt_cols {
                var r: u64 = lines
                while r > 0 {
                    r = r - 1
                    var c: u64 = wide
                    while c > 0 {
                        c = c - 1
                        let src: u64 = r * alt_cols + c
                        let dst: u64 = r * cols + c
                        if src < TG && dst < TG {
                            kstate.set8(g + dst, kstate.get8(g + src) as u8)
                        }
                    }
                    // den Rest der Zielzeile leeren
                    var c2: u64 = wide
                    while c2 < cols {
                        let d2: u64 = r * cols + c2
                        if d2 < TG {
                            kstate.set8(g + d2, 32 as u8)
                        }
                        c2 = c2 + 1
                    }
                }
            } else {
                var r2: u64 = 0
                while r2 < lines {
                    var c3: u64 = 0
                    while c3 < wide {
                        let s3: u64 = r2 * alt_cols + c3
                        let d3: u64 = r2 * cols + c3
                        if s3 < TG && d3 < TG {
                            kstate.set8(g + d3, kstate.get8(g + s3) as u8)
                        }
                        c3 = c3 + 1
                    }
                    var c4: u64 = wide
                    while c4 < cols {
                        let d4: u64 = r2 * cols + c4
                        if d4 < TG {
                            kstate.set8(g + d4, 32 as u8)
                        }
                        c4 = c4 + 1
                    }
                    r2 = r2 + 1
                }
            }
            // die neuen Zeilen unten sind leer
            var r5: u64 = lines
            while r5 < rows {
                var c5: u64 = 0
                while c5 < cols {
                    let d5: u64 = r5 * cols + c5
                    if d5 < TG {
                        kstate.set8(g + d5, 32 as u8)
                    }
                    c5 = c5 + 1
                }
                r5 = r5 + 1
            }
            // DER CURSOR BLEIBT, WO ER WAR -- nur in das neue Raster
            // hineingezwungen. Sonst schriebe die naechste Ausgabe
            // mitten in den stehengebliebenen Text.
            var ncx: u64 = alt_cx
            var ncy: u64 = alt_cy
            if ncx >= cols {
                ncx = cols - 1
            }
            if ncy >= rows {
                ncy = rows - 1
            }
            wmlayout.wsv(state, i, wmlayout.W_CX, ncx)
            wmlayout.wsv(state, i, wmlayout.W_CY, ncy)
        }
    }
    wmdraw.fill(state, i, 0, 0, wmlayout.wg(state, i, wmlayout.W_W), wmlayout.wg(state, i, wmlayout.W_H),
        wmlayout.wg(state, i, wmlayout.W_BG))
    // UND DER TEXT WIEDER AUF DIE FLAECHE. `fill` hat gerade den
    // ganzen Puffer mit der Hintergrundfarbe ueberschrieben -- ohne
    // diese Zeile stuende der gerettete Inhalt zwar im Raster, waere
    // aber nicht zu sehen, und der Fehler saehe genauso aus wie
    // vorher. Bei einem frischen Gitter malt sie lauter Leerzeichen,
    // kostet also nichts.
    term_redraw(state, i)
}

fn cell_set(state: u64, i: u64, c: u64, r: u64, ch: u64) {
    let g: u64 = wmlayout.wg(state, i, wmlayout.W_GRID)
    if g == 0 {
        return
    }
    let k: u64 = r * wmlayout.wg(state, i, wmlayout.W_COLS) + c
    if k >= TG {
        return
    }
    kstate.set8(g + k, ch as u8)
}

// r400: the attribute octet of a cell (bit 0 = reverse video), in the second frame of the grid.
fn attr_clear(g: u64) {
    var k: u64 = 0
    while k < TG {
        kstate.set8(g + TG + k, 0 as u8)
        kstate.set8(g + 2 * TG + k, 0 as u8)
        k = k + 1
    }
}

fn cell_attr(state: u64, i: u64, c: u64, r: u64) -> u64 {
    let g: u64 = wmlayout.wg(state, i, wmlayout.W_GRID)
    if g == 0 {
        return 0
    }
    let k: u64 = r * wmlayout.wg(state, i, wmlayout.W_COLS) + c
    if k >= TG {
        return 0
    }
    return kstate.get8(g + TG + k)
}

fn cell_attr_set(state: u64, i: u64, c: u64, r: u64, a: u64) {
    let g: u64 = wmlayout.wg(state, i, wmlayout.W_GRID)
    if g == 0 {
        return
    }
    let k: u64 = r * wmlayout.wg(state, i, wmlayout.W_COLS) + c
    if k >= TG {
        return
    }
    kstate.set8(g + TG + k, a as u8)
}

// r462: the colour octet of a cell (low nibble foreground, high nibble background; 0 = the window's own colour), third frame
fn cell_col(state: u64, i: u64, c: u64, r: u64) -> u64 {
    let g: u64 = wmlayout.wg(state, i, wmlayout.W_GRID)
    if g == 0 {
        return 0
    }
    let k: u64 = r * wmlayout.wg(state, i, wmlayout.W_COLS) + c
    if k >= TG {
        return 0
    }
    return kstate.get8(g + 2 * TG + k)
}

fn cell_col_set(state: u64, i: u64, c: u64, r: u64, v: u64) {
    let g: u64 = wmlayout.wg(state, i, wmlayout.W_GRID)
    if g == 0 {
        return
    }
    let k: u64 = r * wmlayout.wg(state, i, wmlayout.W_COLS) + c
    if k >= TG {
        return
    }
    kstate.set8(g + 2 * TG + k, v as u8)
}

fn cell_get(state: u64, i: u64, c: u64, r: u64) -> u64 {
    let g: u64 = wmlayout.wg(state, i, wmlayout.W_GRID)
    if g == 0 {
        return 32
    }
    let k: u64 = r * wmlayout.wg(state, i, wmlayout.W_COLS) + c
    if k >= TG {
        return 32
    }
    return kstate.get8(g + k)
}

// ==================================================== RUNDE ECHTHARDWARE-5
// DEN INHALT EINES TERMINALFENSTERS AUF DIE SERIELLE LEITUNG.
//
// Der Beleg fuer Justins Befund B ist ein BILD, und ein Bild von
// Text ist mit einem Programm schlecht zu lesen -- ich habe in dieser
// Runde zweimal versucht, aus Bildpunkten Buchstaben zu raten, und
// beide Male stand am Ende ein Muster, das man so oder so lesen kann.
//
// Das Fenster weiss selbst, was in ihm steht: sein Zellenraster. Diese
// Funktion schreibt es Zeile fuer Zeile hinaus, und damit ist "im
// Terminal steht eine Eingabeaufforderung" eine ABLESUNG und keine
// Deutung eines Rasters. Leerzeilen am Ende faellt sie weg.
// r462: the size of the window's grid, rows << 16 | columns -- what `TIOCGWINSZ` of the tty bound to this window answers
fn term_size(state: u64, i: u64) -> u64 {
    if !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM {
        return 0
    }
    return (wmlayout.wg(state, i, wmlayout.W_ROWS) << 16) | wmlayout.wg(state, i, wmlayout.W_COLS)
}

fn term_dump(state: u64, i: u64) {
    if !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM {
        return
    }
    var s_k: [u8; 15] = "wm: termzeile \0"
    var s_g: [u8; 4] = " [\0\0"
    var s_z: [u8; 2] = "]\0"
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    // r486: where the grid stands on the screen and what colours it has, for the pictures of tools/comp/termshare.sh (the cells below are
    // the kernel's own state, a witness that does not go through the window buffer)
    var s_geo: [u8; 17] = "wm: termgeo cx=\0\0"
    var s_cy: [u8; 5] = " cy=\0"
    var s_cw: [u8; 5] = " cw=\0"
    var s_ch: [u8; 5] = " ch=\0"
    var s_co: [u8; 7] = " cols=\0"
    var s_ro: [u8; 7] = " rows=\0"
    var s_bg: [u8; 5] = " bg=\0"
    var s_fg: [u8; 5] = " fg=\0"
    var s_sh: [u8; 9] = " shared=\0"
    serial.puts((&s_geo[0]) as u64)
    serial.dec((wmbase.win_x(state, i) + wmbase.inx(state, i) as i64) as u64)
    serial.puts((&s_cy[0]) as u64)
    serial.dec((wmbase.win_y(state, i) + wmbase.iny(state, i) as i64) as u64)
    serial.puts((&s_cw[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_CELLW))
    serial.puts((&s_ch[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_CELLH))
    serial.puts((&s_co[0]) as u64)
    serial.dec(cols)
    serial.puts((&s_ro[0]) as u64)
    serial.dec(rows)
    serial.puts((&s_bg[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_BG) & wmdraw.RGB24)
    serial.puts((&s_fg[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_FG) & wmdraw.RGB24)
    serial.puts((&s_sh[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_SHM))
    serial.nl()
    var r: u64 = 0
    while r < rows {
        // Wie weit steht in dieser Zeile ueberhaupt etwas?
        var letzte: u64 = 0
        var c0: u64 = 0
        while c0 < cols {
            if cell_get(state, i, c0, r) > 32 {
                letzte = c0 + 1
            }
            c0 = c0 + 1
        }
        if letzte != 0 {
            serial.puts((&s_k[0]) as u64)
            serial.dec(r)
            serial.puts((&s_g[0]) as u64)
            var c: u64 = 0
            while c < letzte {
                let z: u64 = cell_get(state, i, c, r)
                if z >= 32 && z < 127 {
                    serial.put(z as u8)
                } else {
                    serial.put(32 as u8)
                }
                c = c + 1
            }
            serial.puts((&s_z[0]) as u64)
            serial.nl()
        }
        r = r + 1
    }
    // r1014 witness: the cursor / selection / clipboard state of this window
    if i < 32 {
        var s_tc: [u8; 14] = "wm: tcur win=\0"
        var s_on: [u8; 5] = " on=\0"
        var s_tg: [u8; 9] = " toggle=\0"
        var s_hd: [u8; 7] = " hide=\0"
        var s_se: [u8; 6] = " sel=\0"
        var s_cp: [u8; 9] = " copies=\0"
        var s_ps: [u8; 9] = " pastes=\0"
        serial.puts((&s_tc[0]) as u64)
        serial.dec(i)
        serial.puts((&s_on[0]) as u64)
        serial.dec(tc_on[(i) as usize])
        serial.puts((&s_tg[0]) as u64)
        serial.dec(tc_toggles[0])
        serial.puts((&s_hd[0]) as u64)
        serial.dec(tc_hide[(i) as usize])
        serial.puts((&s_se[0]) as u64)
        if tsel_shown(i) {
            serial.dec(1)
        } else {
            serial.dec(0)
        }
        serial.puts((&s_cp[0]) as u64)
        serial.dec(tc_copies[0])
        serial.puts((&s_ps[0]) as u64)
        serial.dec(tc_pastes[0])
        serial.nl()
    }
    sb_dump(state, i)
}

// r5xx: ONE LINE PER TERMINAL WINDOW plus the text of its cells, for the multi-terminal check (tools/term/multi.sh).
// `term_dump` only reports the FIRST terminal window; with several windows open the check has to see each of them:
//   wm: termwin win=<slot> tty=<n> focus=<0|1> cols=<c> rows=<r>
//   wm: tw<slot> <row> [text]
fn term_dump_all(state: u64) {
    var s_h: [u8; 17] = "wm: termwin win=\0"
    var s_t: [u8; 6] = " tty=\0"
    var s_f: [u8; 8] = " focus=\0"
    var s_c: [u8; 7] = " cols=\0"
    var s_r: [u8; 7] = " rows=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_p: [u8; 7] = "wm: tw\0"
    var s_g: [u8; 3] = " [\0"
    var s_z: [u8; 2] = "]\0"
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmlayout.wg(state, i, wmlayout.W_USED) != 0 && wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM {
            let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
            let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
            serial.puts((&s_h[0]) as u64)
            serial.dec(i)
            serial.puts((&s_t[0]) as u64)
            serial.dec(tty_of(state, i))
            serial.puts((&s_f[0]) as u64)
            if wmlayout.gs(state, wmlayout.S_FOCUS) == i + 1 {
                serial.dec(1)
            } else {
                serial.dec(0)
            }
            serial.puts((&s_c[0]) as u64)
            serial.dec(cols)
            serial.puts((&s_r[0]) as u64)
            serial.dec(rows)
            serial.puts((&s_x[0]) as u64)
            serial.dec(wmbase.win_x(state, i) as u64)
            serial.puts((&s_y[0]) as u64)
            serial.dec(wmbase.win_y(state, i) as u64)
            serial.nl()
            var r: u64 = 0
            while r < rows {
                var last: u64 = 0
                var c0: u64 = 0
                while c0 < cols {
                    if cell_get(state, i, c0, r) > 32 {
                        last = c0 + 1
                    }
                    c0 = c0 + 1
                }
                if last != 0 {
                    serial.puts((&s_p[0]) as u64)
                    serial.dec(i)
                    serial.put(32 as u8)
                    serial.dec(r)
                    serial.puts((&s_g[0]) as u64)
                    var c: u64 = 0
                    while c < last {
                        let z: u64 = cell_get(state, i, c, r)
                        if z >= 32 && z < 127 {
                            serial.put(z as u8)
                        } else {
                            serial.put(32 as u8)
                        }
                        c = c + 1
                    }
                    serial.puts((&s_z[0]) as u64)
                    serial.nl()
                }
                r = r + 1
            }
        }
        i = i + 1
    }
}

// the 16 colours of the terminal (0xRRGGBB): the eight of the standard and their bright forms
fn term_palette(k: u64) -> u64 {
    if k == 0 { return 0x000000 }
    if k == 1 { return 0xCD3131 }
    if k == 2 { return 0x0DBC79 }
    if k == 3 { return 0xE5E510 }
    if k == 4 { return 0x2472C8 }
    if k == 5 { return 0xBC3FBC }
    if k == 6 { return 0x11A8CD }
    if k == 7 { return 0xE5E5E5 }
    if k == 8 { return 0x666666 }
    if k == 9 { return 0xF14C4C }
    if k == 10 { return 0x23D18B }
    if k == 11 { return 0xF5F543 }
    if k == 12 { return 0x3B8EEA }
    if k == 13 { return 0xD670D6 }
    if k == 14 { return 0x29B8DB }
    return 0xFFFFFF
}

fn term_color(state: u64, k: u64) -> u64 {
    let v: u64 = term_palette(k)
    return fb.rgb(state, (v >> 16) & 255, (v >> 8) & 255, v & 255)
}

// ==================================================== r1014: TERMINAL CURSOR, SELECTION, COPY, PASTE
// The cursor is a block (the cell with reverse video). It is drawn only in the focused terminal window and blinks with
// BLINK_TICKS (the timer runs in `poll`, once per tick; an idle desktop costs one compare per tick and one cell repaint per
// half second). `tc_on` says which cell shows the cursor right now, `cell_paint` reads it, so every repaint path agrees.
// Selection: left press + drag in the live grid marks a stream of cells (tc_sa .. tc_sb, row-major); Ctrl+Shift+C (or
// Ctrl+C while a selection stands) copies it, Ctrl+Shift+V / right click without selection / middle click paste. The
// system clipboard itself lives in kgui (`termclip_pump`: this module cannot see wig).
const BLINK_TICKS: u64 = 53
const TC_BUF: u64 = 4096
static mut tc_on: [u64; 32] = [0 as u64; 32]    // 1 = the cursor is painted at (tc_cc, tc_cr)
static mut tc_cc: [u64; 32] = [0 as u64; 32]
static mut tc_cr: [u64; 32] = [0 as u64; 32]
static mut tc_hide: [u64; 32] = [0 as u64; 32]  // 1 = the program hid the cursor (CSI ? 25 l)
static mut tc_sel: [u64; 32] = [0 as u64; 32]   // 0 none, 1 dragging, 2 set
static mut tc_sa: [u64; 32] = [0 as u64; 32]    // anchor cell (row * cols + col)
static mut tc_sb: [u64; 32] = [0 as u64; 32]    // moving end
static mut tc_phase: [u64; 1] = [1 as u64; 1]   // 1 = visible half of the blink
static mut tc_next: [u64; 1] = [0 as u64; 1]    // tick of the next toggle
static mut tc_toggles: [u64; 1] = [0 as u64; 1]
static mut tc_buf: [u8; 4104] = [0 as u8; 4104] // the copied text, waiting for kgui
static mut tc_cn: [u64; 1] = [0 as u64; 1]      // its length (0 = nothing waits)
static mut tc_paste: [u64; 1] = [0 as u64; 1]   // tty + 1 that waits for a paste, 0 = none
static mut tc_copies: [u64; 1] = [0 as u64; 1]
static mut tc_pastes: [u64; 1] = [0 as u64; 1]

fn tc_reset(i: u64) {
    if i >= 32 {
        return
    }
    tc_on[(i) as usize] = 0
    tc_hide[(i) as usize] = 0
    tc_sel[(i) as usize] = 0
}

fn tsel_lo(i: u64) -> u64 {
    if tc_sa[(i) as usize] < tc_sb[(i) as usize] {
        return tc_sa[(i) as usize]
    }
    return tc_sb[(i) as usize]
}

fn tsel_hi(i: u64) -> u64 {
    if tc_sa[(i) as usize] < tc_sb[(i) as usize] {
        return tc_sb[(i) as usize]
    }
    return tc_sa[(i) as usize]
}

// a selection that is visible: set, or dragged over at least two cells
fn tsel_shown(i: u64) -> bool {
    if i >= 32 || tc_sel[(i) as usize] == 0 {
        return false
    }
    if tc_sel[(i) as usize] == 2 {
        return true
    }
    return tc_sa[(i) as usize] != tc_sb[(i) as usize]
}

fn tsel_has(state: u64, i: u64, c: u64, r: u64) -> bool {
    if !tsel_shown(i) {
        return false
    }
    let k: u64 = r * wmlayout.wg(state, i, wmlayout.W_COLS) + c
    return k >= tsel_lo(i) && k <= tsel_hi(i)
}

fn cell_paint(state: u64, i: u64, c: u64, r: u64) {
    var at: u64 = cell_attr(state, i, c, r)
    if i < 32 {
        if tsel_has(state, i, c, r) {
            at = at ^ 1
        }
        if tc_on[(i) as usize] != 0 && tc_cc[(i) as usize] == c && tc_cr[(i) as usize] == r {
            at = at ^ 1
        }
    }
    cell_paint_v(state, i, c, r, cell_get(state, i, c, r), at, cell_col(state, i, c, r))
}

fn tcur_dmg(state: u64, i: u64, c: u64, r: u64) {
    let cw: u64 = wmlayout.wg(state, i, wmlayout.W_CELLW)
    let ch: u64 = wmlayout.wg(state, i, wmlayout.W_CELLH)
    let _d: u64 = damage_rect(state, i, c * cw, r * ch, cw, ch)
}

// take the cursor off the grid (before output moves things under it)
fn tcur_off(state: u64, i: u64) {
    if i >= 32 || tc_on[(i) as usize] == 0 {
        return
    }
    tc_on[(i) as usize] = 0
    cell_paint(state, i, tc_cc[(i) as usize], tc_cr[(i) as usize])
    tcur_dmg(state, i, tc_cc[(i) as usize], tc_cr[(i) as usize])
}

fn tcur_want(state: u64, i: u64) -> bool {
    if tc_hide[(i) as usize] != 0 || tc_phase[0] == 0 || wmlayout.gs(state, wmlayout.S_FOCUS) != i + 1 {
        return false
    }
    if tp_sbv[(i) as usize] != 0 || wmlayout.wg(state, i, wmlayout.W_GRID) == 0 {
        return false
    }
    return wmlayout.wg(state, i, wmlayout.W_CX) < wmlayout.wg(state, i, wmlayout.W_COLS) && wmlayout.wg(state, i, wmlayout.W_CY) < wmlayout.wg(state, i, wmlayout.W_ROWS)
}

// bring the painted cursor in line with the wanted one
fn tcur_sync(state: u64, i: u64) {
    if i >= 32 || !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM {
        return
    }
    let want: bool = tcur_want(state, i)
    let cx: u64 = wmlayout.wg(state, i, wmlayout.W_CX)
    let cy: u64 = wmlayout.wg(state, i, wmlayout.W_CY)
    if tc_on[(i) as usize] != 0 && (!want || tc_cc[(i) as usize] != cx || tc_cr[(i) as usize] != cy) {
        tcur_off(state, i)
    }
    if want && tc_on[(i) as usize] == 0 {
        tc_on[(i) as usize] = 1
        tc_cc[(i) as usize] = cx
        tc_cr[(i) as usize] = cy
        cell_paint(state, i, cx, cy)
        tcur_dmg(state, i, cx, cy)
    }
}

// once per tick from `poll`
fn tcur_tick(state: u64) {
    let now: u64 = kstate.get(state, kstate.TICKS)
    if now < tc_next[0] {
        return
    }
    tc_next[0] = now + BLINK_TICKS
    if tc_phase[0] == 0 {
        tc_phase[0] = 1
    } else {
        tc_phase[0] = 0
    }
    tc_toggles[0] = tc_toggles[0] + 1
    var i: u64 = 0
    while i < 32 && i < wmbase.MAX_WIN {
        tcur_sync(state, i)
        i = i + 1
    }
}

// output or a key: the cursor shows solid again for a whole period
fn tcur_solid(state: u64) {
    tc_phase[0] = 1
    tc_next[0] = kstate.get(state, kstate.TICKS) + BLINK_TICKS
}

fn tcur_toggles_pub() -> u64 {
    return tc_toggles[0]
}

fn tcur_shown_pub(i: u64) -> u64 {
    if i >= 32 {
        return 0
    }
    return tc_on[(i) as usize]
}

// repaint the cells k0 .. k1 (row-major indices)
fn tsel_paint(state: u64, i: u64, k0: u64, k1: u64) {
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    if cols == 0 {
        return
    }
    var k: u64 = k0
    while k <= k1 && k < cols * rows {
        cell_paint(state, i, k % cols, k / cols)
        k = k + 1
    }
    wmdamage.damage_win(state, i)
}

fn tsel_clear(state: u64, i: u64) {
    if i >= 32 || tc_sel[(i) as usize] == 0 {
        return
    }
    let lo: u64 = tsel_lo(i)
    let hi: u64 = tsel_hi(i)
    let was: bool = tsel_shown(i)
    tc_sel[(i) as usize] = 0
    if was {
        tsel_paint(state, i, lo, hi)
    }
}

// the selected text -> tc_buf (UTF-8, trailing blanks of a row cut, rows joined by LF). Returns the length.
fn tsel_text(state: u64, i: u64) -> u64 {
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    if cols == 0 || !tsel_shown(i) {
        return 0
    }
    let lo: u64 = tsel_lo(i)
    let hi: u64 = tsel_hi(i)
    let r0: u64 = lo / cols
    let r1: u64 = hi / cols
    var n: u64 = 0
    var r: u64 = r0
    while r <= r1 {
        var c0: u64 = 0
        var c1: u64 = cols - 1
        if r == r0 {
            c0 = lo % cols
        }
        if r == r1 {
            c1 = hi % cols
        }
        // cut the trailing blanks
        var e: u64 = c1 + 1
        while e > c0 && cell_get(state, i, e - 1, r) <= 32 {
            e = e - 1
        }
        var c: u64 = c0
        while c < e && n + 3 < TC_BUF {
            var z: u64 = cell_get(state, i, c, r)
            if z < 32 {
                z = 32
            }
            if z < 128 {
                tc_buf[(n) as usize] = z as u8
                n = n + 1
            } else if z < 256 {
                tc_buf[(n) as usize] = (0xC0 | (z >> 6)) as u8
                tc_buf[(n + 1) as usize] = (0x80 | (z & 63)) as u8
                n = n + 2
            } else {
                tc_buf[(n) as usize] = 63
                n = n + 1
            }
            c = c + 1
        }
        if r < r1 && n + 1 < TC_BUF {
            tc_buf[(n) as usize] = 10
            n = n + 1
        }
        r = r + 1
    }
    return n
}

fn tsel_copy(state: u64, i: u64) {
    let n: u64 = tsel_text(state, i)
    if n == 0 {
        return
    }
    tc_cn[0] = n
    tc_copies[0] = tc_copies[0] + 1
    var s_c: [u8; 14] = "wm: tcopy n=\0\0"
    serial.puts((&s_c[0]) as u64)
    serial.dec(n)
    serial.put(32 as u8)
    serial.put(91 as u8)
    var q: u64 = 0
    while q < n && q < 80 {
        let ch: u64 = tc_buf[(q) as usize] as u64
        if ch == 10 {
            serial.put(124 as u8)
        } else if ch >= 32 && ch < 127 {
            serial.put(ch as u8)
        } else {
            serial.put(63 as u8)
        }
        q = q + 1
    }
    serial.put(93 as u8)
    serial.nl()
}

// kgui pumps: the copied text waits here. Copies it to `out`, returns the length (0 = nothing), empties the slot.
fn term_copy_take(state: u64, out: u64, max: u64) -> u64 {
    var n: u64 = tc_cn[0]
    if n == 0 {
        return 0
    }
    tc_cn[0] = 0
    if n > max {
        n = max
    }
    var k: u64 = 0
    while k < n {
        kstate.set8(out + k, tc_buf[(k) as usize])
        k = k + 1
    }
    return n
}

// kgui pumps: a paste waits for tty T (returns T + 1, 0 = none)
fn term_paste_take(state: u64) -> u64 {
    let t: u64 = tc_paste[0]
    tc_paste[0] = 0
    return t
}

static mut tp_buf: [u8; 4096] = [0 as u8; 4096]
static mut tp_cn: [u64; 1] = [0 as u64; 1]
static mut tc_psel: [u64; 1] = [0 as u64; 1]

fn tsel_primary(state: u64, i: u64) {
    let n: u64 = tsel_text(state, i)
    if n == 0 {
        return
    }
    var k: u64 = 0
    while k < n {
        tp_buf[(k) as usize] = tc_buf[(k) as usize]
        k = k + 1
    }
    tp_cn[0] = n
}

fn term_primary_take(state: u64, out: u64, max: u64) -> u64 {
    var n: u64 = tp_cn[0]
    if n == 0 {
        return 0
    }
    tp_cn[0] = 0
    if n > max {
        n = max
    }
    var k: u64 = 0
    while k < n {
        kstate.set8(out + k, tp_buf[(k) as usize])
        k = k + 1
    }
    return n
}

fn term_paste_sel(state: u64) -> u64 {
    let v: u64 = tc_psel[0]
    tc_psel[0] = 0
    return v
}

fn tcopies_pub() -> u64 {
    return tc_copies[0]
}

fn tpastes_pub() -> u64 {
    return tc_pastes[0]
}

// Z9 finding: Ctrl+Shift+V typed the text into the tty, but the window showed it only after the NEXT mouse click. A paste
// comes out of the poll, not out of a key event, so nothing told the compositor ring or the idle timer that the user did
// something (`on_key` does both for every real key). `kgui.termclip_pump` calls this once after the text went into the tty:
// the focused terminal window is damaged and the same two notices a key makes are given.
static mut tc_kicks: [u64; 1] = [0 as u64; 1]

fn term_paste_done(state: u64) {
    if !wmbase.ready(state) {
        return
    }
    input_seen(state)
    cp_event(state, CP_EV_KEY, 0, 0, 0, 0, 0)
    let f: u64 = wmbase.focus(state)
    if f < wmbase.MAX_WIN && wmbase.valid(state, f) && wmlayout.wg(state, f, wmlayout.W_KIND) == wmlayout.K_TERM {
        wmdamage.damage_win(state, f)
    }
    tc_kicks[0] = tc_kicks[0] + 1
    var s_k: [u8; 17] = "wm: tpaste kick=\0"
    serial.puts((&s_k[0]) as u64)
    serial.dec(tc_kicks[0])
    serial.nl()
}

fn tkicks_pub() -> u64 {
    return tc_kicks[0]
}

fn tpaste_ask(state: u64, i: u64) {
    let t: u64 = tty_of(state, i)
    if t == NO_TTY {
        return
    }
    tc_paste[0] = t + 1
    tc_pastes[0] = tc_pastes[0] + 1
    var s_p: [u8; 14] = "wm: tpaste t=\0"
    serial.puts((&s_p[0]) as u64)
    serial.dec(t)
    serial.nl()
}

// the mouse over a terminal window. kind: 0 left press, 1 left release, 2 move, 3 right press, 4 middle press.
// lx / ly are window-local pixels (>= 0).
fn term_mouse(state: u64, i: u64, kind: u64, lx: u64, ly: u64, btn: u64) {
    if i >= 32 || !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM {
        return
    }
    let cw: u64 = wmlayout.wg(state, i, wmlayout.W_CELLW)
    let ch: u64 = wmlayout.wg(state, i, wmlayout.W_CELLH)
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    if cw == 0 || ch == 0 || cols == 0 || rows == 0 {
        return
    }
    var c: u64 = lx / cw
    var r: u64 = ly / ch
    if c >= cols {
        c = cols - 1
    }
    if r >= rows {
        r = rows - 1
    }
    let k: u64 = r * cols + c
    if kind == 0 {
        if tp_sbv[(i) as usize] != 0 {
            return
        }
        tsel_clear(state, i)
        tc_sel[(i) as usize] = 1
        tc_sa[(i) as usize] = k
        tc_sb[(i) as usize] = k
        return
    }
    if kind == 2 {
        if tc_sel[(i) as usize] != 1 || (btn & ps2m.B_LEFT) == 0 {
            return
        }
        let old: u64 = tc_sb[(i) as usize]
        if old == k {
            return
        }
        tc_sb[(i) as usize] = k
        var a: u64 = old
        var b: u64 = k
        if k < old {
            a = k
            b = old
        }
        tsel_paint(state, i, a, b)
        return
    }
    if kind == 1 {
        if tc_sel[(i) as usize] != 1 {
            return
        }
        if tc_sa[(i) as usize] == tc_sb[(i) as usize] {
            tc_sel[(i) as usize] = 0
        } else {
            tc_sel[(i) as usize] = 2
            tsel_primary(state, i)
        }
        return
    }
    if kind == 3 {
        if tsel_shown(i) {
            tsel_copy(state, i)
            tsel_clear(state, i)
        } else {
            tpaste_ask(state, i)
        }
        return
    }
    if kind == 4 {
        tpaste_ask(state, i)
        tc_psel[0] = 1
    }
}

// a key with Ctrl held, from the keyboard layer. True = consumed (the shell does not see it).
//   Ctrl+Shift+C  copy the selection        Ctrl+Shift+V  paste        Ctrl+C with a selection standing: copy
// MON-3: Ctrl+Shift+F flips the developer overlay (the bar draws it; it reads the switch from /proc/frames)
fn mon_hotkey(state: u64) {
    let on: bool = frameprof.mon_toggle()
    var s_on: [u8; 13] = "wm: monov on\0"
    var s_off: [u8; 14] = "wm: monov off\0"
    if on {
        serial.puts((&s_on[0]) as u64)
    } else {
        serial.puts((&s_off[0]) as u64)
    }
    serial.nl()
}

fn term_key(state: u64, c: u64, shift: bool) -> bool {
    if !wmbase.ready(state) {
        return false
    }
    if shift && (c == 70 || c == 102) && !wmgate.sperre_an(state) {
        mon_hotkey(state)
        return true
    }
    let f: u64 = wmbase.focus(state)
    if f >= wmbase.MAX_WIN || f >= 32 || wmlayout.wg(state, f, wmlayout.W_KIND) != wmlayout.K_TERM || !wmgate.darf(state, f) {
        // r1309: Ctrl+Shift+T is a global "new terminal" when no terminal window has the focus (desktop, other program, the terminal was
        // closed or minimised): it used to fall through to the focused program as a plain ^T and nothing opened. Not while the screen is locked.
        if shift && (c == 84 || c == 116) && !wmgate.sperre_an(state) {
            tt_request_free(state)
            return true
        }
        return false
    }
    let is_c: bool = c == 67 || c == 99
    let is_v: bool = c == 86 || c == 118
    // r1014 tabs: Ctrl+Shift+T new tab, Ctrl+Shift+W close, Ctrl+Tab / Ctrl+Shift+Tab next / previous
    if c == 9 {
        if tt_grouped(state, f) {
            tt_step(state, f, !shift)
            return true
        }
        return false
    }
    if shift && (c == 84 || c == 116) {
        tt_request(state, f)
        return true
    }
    if shift && (c == 87 || c == 119) {
        tt_close_tab(state, f)
        return true
    }
    if shift {
        if is_c {
            if tsel_shown(f) {
                tsel_copy(state, f)
            }
            return true
        }
        if is_v {
            tpaste_ask(state, f)
            return true
        }
        return false
    }
    if is_c && tsel_shown(f) {
        tsel_copy(state, f)
        tsel_clear(state, f)
        return true
    }
    return false
}


// r838: paint the cell at screen position (c, r) with the given character / attribute / colour octets (the scrollback view
// paints history cells here, the live grid goes through `cell_paint`)
fn cell_paint_v(state: u64, i: u64, c: u64, r: u64, z: u64, at: u64, co: u64) {
    let cw: u64 = wmlayout.wg(state, i, wmlayout.W_CELLW)
    let ch: u64 = wmlayout.wg(state, i, wmlayout.W_CELLH)
    let f: u64 = wmlayout.gs(state, wmlayout.S_FONT_MONO)
    // r400: reverse video swaps the two colours of the cell
    var cbg: u64 = wmlayout.wg(state, i, wmlayout.W_BG)
    var cfg: u64 = wmlayout.wg(state, i, wmlayout.W_FG)
    // r462: colours (the nibbles of the colour octet), bright forms by bold / the 9x and 10x codes, underline
    if (co & 15) != 0 {
        var kf: u64 = (co & 15) - 1
        if (at & 10) != 0 {
            kf = kf + 8
        }
        cfg = term_color(state, kf)
    }
    if (co >> 4) != 0 {
        var kb: u64 = (co >> 4) - 1
        if (at & 16) != 0 {
            kb = kb + 8
        }
        cbg = term_color(state, kb)
    }
    if (at & 1) != 0 {
        let sw: u64 = cbg
        cbg = cfg
        cfg = sw
    }
    wmdraw.fill(state, i, c * cw, r * ch, cw, ch, cbg)
    if (at & 4) != 0 && ch > 2 {
        wmdraw.fill(state, i, c * cw, r * ch + ch - 2, cw, 1, cfg)
    }
    if z <= 32 || f >= ttf.MAX_FONTS {
        return
    }
    let px: u64 = wmlayout.gs(state, wmlayout.S_PX_MONO)
    let slot: u64 = ttf.glyph(state, f, z, px)
    if slot < ttf.SLOTS {
        wmdraw.draw_glyph_clip(state, i, slot, (c * cw) as i64,
            (r * ch) as i64 + ttf.ascent(state, f, px), cfg,
            (c * cw) as i64, ((c + 1) * cw) as i64)
    }
}

// ==================================================== RUNDE FARBE
// DAS GANZE RASTER NOCH EINMAL MALEN.
//
// Gebraucht wird das genau einmal: wenn die Taskleiste die beiden
// Terminalfarben setzt, NACHDEM das Fenster schon steht (siehe
// `set_deco_colour`). `cell_paint` fuellt je Zelle erst den Grund in
// `W_BG` und setzt dann das Zeichen in `W_FG` -- beides sind die
// NEUEN Farben, sobald sie im Fenster stehen. Also ist "alles neu
// malen" genau "jede Zelle neu malen", und es braucht keinen zweiten
// Zeichenweg, der mit dem ersten auseinanderlaufen koennte.
fn term_redraw(state: u64, i: u64) {
    if !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM {
        return
    }
    if i < 32 && tp_sbv[(i) as usize] != 0 {
        sb_redraw(state, i)
        return
    }
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    var r: u64 = 0
    while r < rows {
        var c: u64 = 0
        while c < cols {
            cell_paint(state, i, c, r)
            c = c + 1
        }
        r = r + 1
    }
}

// ============================================ r838: TERMINAL SCROLLBACK
// Lines that scroll off the top of a full-screen scroll (main screen, region = whole screen) go into a ring of SB_LINES lines
// per terminal window (kernel frames, taken on the first scrolled line, given back when the window closes). Each line holds
// the three planes (character, attribute, colour) for SB_W columns. The mouse wheel over the window moves the view
// (`tp_sbv` = lines scrolled back, SB_STEP per notch); any output or key snaps back to the live screen.
const SB_LINES: u64 = 256
const SB_W: u64 = 256
const SB_STRIDE: u64 = 768 // 3 planes x SB_W
const SB_FRAMES: u64 = 48  // SB_LINES * SB_STRIDE / 4096
const SB_STEP: u64 = 3
static mut tp_sb: [u64; 32] = [0 as u64; 32]  // base of the ring (0 = none yet)
static mut tp_sbn: [u64; 32] = [0 as u64; 32] // lines stored
static mut tp_sbh: [u64; 32] = [0 as u64; 32] // next slot to write
static mut tp_sbv: [u64; 32] = [0 as u64; 32] // lines the view is scrolled back (0 = live)

fn sb_free(state: u64, i: u64) {
    if i >= 32 {
        return
    }
    if tp_sb[(i) as usize] != 0 {
        mem.frame_free_run(state, tp_sb[(i) as usize], SB_FRAMES)
    }
    tp_sb[(i) as usize] = 0
    tp_sbn[(i) as usize] = 0
    tp_sbh[(i) as usize] = 0
    tp_sbv[(i) as usize] = 0
}

// push grid row r (about to scroll off the top) into the ring
fn sb_push(state: u64, i: u64, r: u64) {
    if i >= 32 {
        return
    }
    let g: u64 = wmlayout.wg(state, i, wmlayout.W_GRID)
    if g == 0 {
        return
    }
    var b: u64 = tp_sb[(i) as usize]
    if b == 0 {
        b = mem.frame_run(state, SB_FRAMES)
        if b == 0 {
            return
        }
        tp_sb[(i) as usize] = b
        tp_sbn[(i) as usize] = 0
        tp_sbh[(i) as usize] = 0
    }
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    let dst: u64 = b + tp_sbh[(i) as usize] * SB_STRIDE
    var c: u64 = 0
    while c < SB_W {
        var z: u64 = 32
        var at: u64 = 0
        var co: u64 = 0
        if c < cols && r * cols + c < TG {
            let k: u64 = r * cols + c
            z = kstate.get8(g + k)
            at = kstate.get8(g + TG + k)
            co = kstate.get8(g + 2 * TG + k)
        }
        kstate.set8(dst + c, z as u8)
        kstate.set8(dst + SB_W + c, at as u8)
        kstate.set8(dst + 2 * SB_W + c, co as u8)
        c = c + 1
    }
    tp_sbh[(i) as usize] = (tp_sbh[(i) as usize] + 1) % SB_LINES
    if tp_sbn[(i) as usize] < SB_LINES {
        tp_sbn[(i) as usize] = tp_sbn[(i) as usize] + 1
    }
}

// address of history line h (0 = oldest stored)
fn sb_line(i: u64, h: u64) -> u64 {
    let slot: u64 = (tp_sbh[(i) as usize] + SB_LINES - tp_sbn[(i) as usize] + h) % SB_LINES
    return tp_sb[(i) as usize] + slot * SB_STRIDE
}

// the character shown at screen cell (c, r) while the view is scrolled back
fn sb_view_char(state: u64, i: u64, c: u64, r: u64) -> u64 {
    let v: u64 = tp_sbv[(i) as usize]
    if r >= v {
        return cell_get(state, i, c, r - v)
    }
    if c >= SB_W {
        return 32
    }
    return kstate.get8(sb_line(i, tp_sbn[(i) as usize] - v + r) + c)
}

fn sb_redraw(state: u64, i: u64) {
    let v: u64 = tp_sbv[(i) as usize]
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    var r: u64 = 0
    while r < rows {
        var c: u64 = 0
        while c < cols {
            if r >= v {
                cell_paint_v(state, i, c, r, cell_get(state, i, c, r - v), cell_attr(state, i, c, r - v), cell_col(state, i, c, r - v))
            } else if c >= SB_W {
                cell_paint_v(state, i, c, r, 32, 0, 0)
            } else {
                let ln: u64 = sb_line(i, tp_sbn[(i) as usize] - v + r)
                cell_paint_v(state, i, c, r, kstate.get8(ln + c), kstate.get8(ln + SB_W + c), kstate.get8(ln + 2 * SB_W + c))
            }
            c = c + 1
        }
        r = r + 1
    }
}

// back to the live screen (called before any output, on a key, on a resize)
fn sb_snap(state: u64, i: u64) {
    if i >= 32 || tp_sbv[(i) as usize] == 0 {
        return
    }
    tp_sbv[(i) as usize] = 0
    term_redraw(state, i)
}

// wheel notches over a terminal window: d > 0 = wheel up = older lines
fn sb_wheel(state: u64, i: u64, d: i64) {
    if i >= 32 || !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM {
        return
    }
    sb_move(state, i, d * (SB_STEP as i64))
}

// Move the view by `dl` lines (+ = back into the history), clamped to what is stored.
fn sb_move(state: u64, i: u64, dl: i64) {
    if i >= 32 || !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM {
        return
    }
    let n: u64 = tp_sbn[(i) as usize]
    var v: i64 = (tp_sbv[(i) as usize] as i64) + dl
    if v < 0 {
        v = 0
    }
    if v > (n as i64) {
        v = n as i64
    }
    if (v as u64) == tp_sbv[(i) as usize] {
        return
    }
    tp_sbv[(i) as usize] = v as u64
    term_redraw(state, i)
    wmdamage.damage_win(state, i)
}

// serial witness for tools/term/scroll.sh
fn sb_dump(state: u64, i: u64) {
    var s_a: [u8; 18] = "wm: termsb lines=\0"
    var s_b: [u8; 7] = " view=\0"
    var s_c: [u8; 14] = "wm: termview \0"
    var s_g: [u8; 4] = " [\0\0"
    var s_z: [u8; 2] = "]\0"
    if i >= 32 {
        return
    }
    serial.puts((&s_a[0]) as u64)
    serial.dec(tp_sbn[(i) as usize])
    serial.puts((&s_b[0]) as u64)
    serial.dec(tp_sbv[(i) as usize])
    serial.nl()
    if tp_sbv[(i) as usize] == 0 {
        return
    }
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    var r: u64 = 0
    while r < rows {
        var last: u64 = 0
        var c0: u64 = 0
        while c0 < cols {
            if sb_view_char(state, i, c0, r) > 32 {
                last = c0 + 1
            }
            c0 = c0 + 1
        }
        if last != 0 {
            serial.puts((&s_c[0]) as u64)
            serial.dec(r)
            serial.puts((&s_g[0]) as u64)
            var c: u64 = 0
            while c < last {
                let z: u64 = sb_view_char(state, i, c, r)
                if z >= 32 && z < 127 {
                    serial.put(z as u8)
                } else {
                    serial.put(32 as u8)
                }
                c = c + 1
            }
            serial.puts((&s_z[0]) as u64)
            serial.nl()
        }
        r = r + 1
    }
}

// ============================================ RUNDE GLAS (nachtrag)
// DAS TERMINAL SPRACH KEIN UTF-8 -- UND HAT DIE UMLAUTE STILL
// WEGGEWORFEN.
//
// Justins Befund am Bild 04 dieser Runde: im Terminalfenster stand
// "KEIN EINZIGES GERT!". Die Quelle (kernel/ui/kgui.fi, `usb_bericht`)
// schreibt "GERAET" mit einem richtigen UTF-8-Ä, also die zwei Oktette
// 0xC3 0x84 -- und die Zeile `if ch < 32 || ch > 126 { return }`
// darunter hat beide verschluckt. Nicht als Kaestchen, nicht als
// Fragezeichen: spurlos. Genau dieselbe Klasse Fehler, die Runde
// UMLAUT2 fuer die Bedienoberflaeche abgestellt hat; der Weg ins
// Terminalfenster war der letzte, der sie noch hatte.
//
// EIN Oktett Zustand reicht, weil genau EIN Fall zu behandeln ist: die
// zweioktettige Folge C2..DF / 80..BF traegt U+0080..U+07FF, und alles
// davon, was eine Zelle (ein Oktett) fassen kann, ist Latin-1, also
// U+00A0..U+00FF -- Ä, ö, ß, °, µ. Die Zelle bleibt damit ein Oktett
// breit und `cell_paint` gibt ihre Zahl unveraendert als Zeichennummer
// an `ttf.glyph` weiter, das seit Runde GLYPHE nach Zeichennummer und
// nicht nach Oktett sucht. Drei- und vieroktettige Folgen (CJK,
// Emoji) passen NICHT in ein Oktett; sie werden als ein Fragezeichen
// gesetzt, weil ein sichtbarer Platzhalter der einzige Befund ist, der
// sich spaeter noch melden laesst.
// r462: THE TERMINAL EXECUTES THE CONTROL SEQUENCES OF FULL-SCREEN PROGRAMS (Justin, Dell photo 07.10.2026 19:05: the editor showed
// `~[19;1H[K`, `[7m`, `[24;1H[K^O Write`, `[?25h[?25l` as text). Two causes, both fixed: (1) an image from before the VT subset of
// r400 printed the sequences; (2) with the subset, `/bin/edit` still drew an 80 x 24 screen into a 72 x 19 window, because nobody ever
// told the tty the size of its window (`TIOCGWINSZ` answered the default): see `term_size`, `tty.do_ioctl`, `kgui.winch_wache`.
//
// WHAT THE MACHINE UNDERSTANDS (a subset of VT100 / xterm, enough for editors, pagers and `top`-like programs):
//   cursor        CSI n A B C D E F G d ` H f, save / restore (ESC 7, ESC 8, CSI s, CSI u), ESC D / E / M, CR LF BS
//   erase         CSI J (0 1 2 3), CSI K (0 1 2), CSI n X (erase characters)
//   edit          CSI n @ (insert characters), P (delete characters), L (insert lines), M (delete lines), S / T (scroll up / down)
//   region        CSI t ; b r (scroll region); line feed at its bottom scrolls only the region
//   attributes    CSI m: 0 reset, 1 bold (bright colour), 4 underline, 7 reverse, 22 24 27 off, 30-37 40-47 colours,
//                 38 / 48 ; 5 ; n (the 16 first) , 39 49 default, 90-97 100-107 bright
//   modes         CSI ? 1049 h / l (alternate screen: the main screen is saved and comes back), ?47 ?1047 the same without
//                 the cursor, ?7 wrap on / off; ?25 (cursor), ?1 ?12 ?2004 and every other mode are accepted and dropped
//   strings       OSC / DCS / APC / PM up to BEL or ESC \ are swallowed (window titles must not become text)
// EVERYTHING ELSE after ESC, ESC [ is swallowed up to its final octet: an unknown sequence never shows up as characters.
// The automatic wrap is DEFERRED like on a real terminal: the 80th character of a row does not scroll the screen yet.
//
// The state is per window (a second terminal window must not inherit half a sequence of the first).
static mut tp_esc: [u64; 32] = [0 as u64; 32]   // 0 plain, 1 after ESC, 2 inside CSI, 3 inside a string, 4 one octet to drop, 5 ESC inside a string
static mut tp_np: [u64; 32] = [0 as u64; 32]    // index of the parameter being read
static mut tp_priv: [u64; 32] = [0 as u64; 32]  // 1 = `?` marker, 2 = another marker (< = >)
static mut tp_par: [u64; 256] = [0 as u64; 256] // TP_NP (8) parameters of each window
static mut tp_has: [u64; 256] = [0 as u64; 256]
static mut tp_attr: [u64; 32] = [0 as u64; 32]  // 1 reverse, 2 bold, 4 underline, 8 bright foreground, 16 bright background
static mut tp_col: [u64; 32] = [0 as u64; 32]   // low nibble foreground, high nibble background: 0 default, 1 .. 8 = colour 0 .. 7
static mut tp_utf: [u64; 32] = [0 as u64; 32]   // the UTF-8 lead octet that waits for its follower
static mut tp_wrap: [u64; 32] = [0 as u64; 32]  // 1 = the cursor stands behind the last column (the wrap is pending)
static mut tp_nowrap: [u64; 32] = [0 as u64; 32] // 1 = ?7 l: no wrap
static mut tp_scx: [u64; 32] = [0 as u64; 32]   // the saved cursor
static mut tp_scy: [u64; 32] = [0 as u64; 32]
static mut tp_sat: [u64; 32] = [0 as u64; 32]
static mut tp_sco: [u64; 32] = [0 as u64; 32]
static mut tp_top: [u64; 32] = [0 as u64; 32]   // the scroll region: first row, and last row + 1 (0 = to the end of the screen)
static mut tp_bot1: [u64; 32] = [0 as u64; 32]
static mut tp_alt: [u64; 32] = [0 as u64; 32]   // 1 = the alternate screen is up (the main one lies in frames 3 .. 5 of the grid)
const TP_NP: u64 = 8

fn tp_reset(i: u64) {
    if i >= 32 {
        return
    }
    tp_esc[(i) as usize] = 0
    tp_np[(i) as usize] = 0
    tp_priv[(i) as usize] = 0
    tp_attr[(i) as usize] = 0
    tp_col[(i) as usize] = 0
    tp_utf[(i) as usize] = 0
    tp_wrap[(i) as usize] = 0
    tp_nowrap[(i) as usize] = 0
    tp_scx[(i) as usize] = 0
    tp_scy[(i) as usize] = 0
    tp_sat[(i) as usize] = 0
    tp_sco[(i) as usize] = 0
    tp_top[(i) as usize] = 0
    tp_bot1[(i) as usize] = 0
    tp_alt[(i) as usize] = 0
}

// the last row of the scroll region (a region that does not fit the screen is the whole screen)
fn tp_bot(state: u64, i: u64) -> u64 {
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    let b1: u64 = tp_bot1[(i) as usize]
    if b1 == 0 || b1 > rows || tp_top[(i) as usize] + 1 >= b1 {
        return rows - 1
    }
    return b1 - 1
}

fn tp_first(state: u64, i: u64) -> u64 {
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    let b1: u64 = tp_bot1[(i) as usize]
    if b1 == 0 || b1 > rows || tp_top[(i) as usize] + 1 >= b1 {
        return 0
    }
    return tp_top[(i) as usize]
}

// the parameter k of the sequence (dflt when it was not given)
fn tp_p(i: u64, k: u64, dflt: u64) -> u64 {
    if k < TP_NP && tp_has[(i * TP_NP + k) as usize] != 0 {
        return tp_par[(i * TP_NP + k) as usize]
    }
    return dflt
}

// a count parameter: missing or 0 means 1
fn tp_n(i: u64) -> u64 {
    let v: u64 = tp_p(i, 0, 1)
    if v == 0 {
        return 1
    }
    return v
}

// the cells of one row and nothing else: character, attribute, colour
fn grid_row_copy(state: u64, i: u64, rdst: u64, rsrc: u64) {
    let g: u64 = wmlayout.wg(state, i, wmlayout.W_GRID)
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    if g == 0 {
        return
    }
    var c: u64 = 0
    while c < cols {
        let d: u64 = rdst * cols + c
        let s: u64 = rsrc * cols + c
        if d < TG && s < TG {
            kstate.set8(g + d, kstate.get8(g + s) as u8)
            kstate.set8(g + TG + d, kstate.get8(g + TG + s) as u8)
            kstate.set8(g + 2 * TG + d, kstate.get8(g + 2 * TG + s) as u8)
        }
        c = c + 1
    }
}

fn grid_row_clear(state: u64, i: u64, r: u64) {
    let g: u64 = wmlayout.wg(state, i, wmlayout.W_GRID)
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    if g == 0 {
        return
    }
    var c: u64 = 0
    while c < cols {
        let d: u64 = r * cols + c
        if d < TG {
            kstate.set8(g + d, 32 as u8)
            kstate.set8(g + TG + d, 0 as u8)
            kstate.set8(g + 2 * TG + d, 0 as u8)
        }
        c = c + 1
    }
}

fn term_repaint_row(state: u64, i: u64, r: u64) {
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    var c: u64 = 0
    while c < cols {
        cell_paint(state, i, c, r)
        c = c + 1
    }
}

// Scroll the rows `top ..= bot` up (up = true) or down by n rows: the cells and the picture move, the rows that come free are blank.
fn term_scroll_region(state: u64, i: u64, top: u64, bot: u64, n: u64, up: bool) {
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    if rows == 0 || top >= rows || bot >= rows || bot < top || n == 0 {
        return
    }
    var k: u64 = n
    if k > bot - top + 1 {
        k = bot - top + 1
    }
    // r838: lines that leave the top of the whole screen go to the scrollback (not on the alternate screen)
    if up && top == 0 && bot + 1 == rows && i < 32 && tp_alt[(i) as usize] == 0 {
        var q: u64 = 0
        while q < k {
            sb_push(state, i, q)
            q = q + 1
        }
    }
    // the cells
    if up {
        var r: u64 = top
        while r + k <= bot {
            grid_row_copy(state, i, r, r + k)
            r = r + 1
        }
        var rc: u64 = bot + 1 - k
        while rc <= bot {
            grid_row_clear(state, i, rc)
            rc = rc + 1
        }
    } else {
        var r2: u64 = bot + 1
        while r2 > top + k {
            r2 = r2 - 1
            grid_row_copy(state, i, r2, r2 - k)
        }
        var rc2: u64 = top
        while rc2 < top + k {
            grid_row_clear(state, i, rc2)
            rc2 = rc2 + 1
        }
    }
    // the picture: copy whole pixel rows (the window is as wide as its buffer), then blank the rows that came free
    let ch: u64 = wmlayout.wg(state, i, wmlayout.W_CELLH)
    let ww: u64 = wmlayout.wg(state, i, wmlayout.W_W)
    let buf: u64 = wmlayout.wg(state, i, wmlayout.W_BUF)
    if buf == 0 || ww == 0 || ch == 0 {
        return
    }
    let y0: u64 = top * ch
    let y1: u64 = (bot + 1) * ch
    let shift: u64 = k * ch
    if up {
        var y: u64 = y0
        while y + shift < y1 {
            wmdraw.copy_words(buf +% y *% ww *% 4, buf +% (y + shift) *% ww *% 4, ww *% 4 / 8)
            y = y + 1
        }
        wmdraw.fill(state, i, 0, y1 - shift, ww, shift, wmlayout.wg(state, i, wmlayout.W_BG))
    } else {
        var y2: u64 = y1 - shift
        while y2 > y0 {
            y2 = y2 - 1
            wmdraw.copy_words(buf +% (y2 + shift) *% ww *% 4, buf +% y2 *% ww *% 4, ww *% 4 / 8)
        }
        wmdraw.fill(state, i, 0, y0, ww, shift, wmlayout.wg(state, i, wmlayout.W_BG))
    }
}

// the scroll at the end of the screen (the old `term_scroll`): the region up by one row
fn term_scroll(state: u64, i: u64) {
    term_scroll_region(state, i, tp_first(state, i), tp_bot(state, i), 1, true)
}

// a line feed: down one row, or the region scrolls when the cursor stands on its last row
fn term_lf(state: u64, i: u64) {
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    let cy: u64 = wmlayout.wg(state, i, wmlayout.W_CY)
    if cy == tp_bot(state, i) {
        term_scroll_region(state, i, tp_first(state, i), tp_bot(state, i), 1, true)
    } else if cy + 1 < rows {
        wmlayout.wsv(state, i, wmlayout.W_CY, cy + 1)
    }
}

// the reverse index: up one row, or the region scrolls down when the cursor stands on its first row
fn term_ri(state: u64, i: u64) {
    let cy: u64 = wmlayout.wg(state, i, wmlayout.W_CY)
    if cy == tp_first(state, i) {
        term_scroll_region(state, i, tp_first(state, i), tp_bot(state, i), 1, false)
    } else if cy > 0 {
        wmlayout.wsv(state, i, wmlayout.W_CY, cy - 1)
    }
}

fn term_clear_rect(state: u64, i: u64, c0: u64, r0: u64, c1: u64, r1: u64) {
    // blank the cells from (c0, r0) up to but excluding (c1, r1), row-major
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    var r: u64 = r0
    var c: u64 = c0
    while r < r1 || (r == r1 && c < c1) {
        cell_set(state, i, c, r, 32)
        cell_attr_set(state, i, c, r, 0)
        cell_col_set(state, i, c, r, 0)
        cell_paint(state, i, c, r)
        c = c + 1
        if c >= cols {
            c = 0
            r = r + 1
        }
    }
}

fn term_set_cursor(state: u64, i: u64, c: u64, r: u64) {
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    var cc: u64 = c
    var rr: u64 = r
    if cc >= cols {
        cc = cols - 1
    }
    if rr >= rows {
        rr = rows - 1
    }
    wmlayout.wsv(state, i, wmlayout.W_CX, cc)
    wmlayout.wsv(state, i, wmlayout.W_CY, rr)
    tp_wrap[(i) as usize] = 0
}

fn term_save_cursor(state: u64, i: u64) {
    tp_scx[(i) as usize] = wmlayout.wg(state, i, wmlayout.W_CX)
    tp_scy[(i) as usize] = wmlayout.wg(state, i, wmlayout.W_CY)
    tp_sat[(i) as usize] = tp_attr[(i) as usize]
    tp_sco[(i) as usize] = tp_col[(i) as usize]
}

fn term_restore_cursor(state: u64, i: u64) {
    term_set_cursor(state, i, tp_scx[(i) as usize], tp_scy[(i) as usize])
    tp_attr[(i) as usize] = tp_sat[(i) as usize]
    tp_col[(i) as usize] = tp_sco[(i) as usize]
}

// the whole screen blank, the cursor home
fn term_blank_screen(state: u64, i: u64) {
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    var r: u64 = 0
    while r < rows {
        grid_row_clear(state, i, r)
        r = r + 1
    }
    wmdraw.fill(state, i, 0, 0, wmlayout.wg(state, i, wmlayout.W_W), wmlayout.wg(state, i, wmlayout.W_H), wmlayout.wg(state, i, wmlayout.W_BG))
}

// ESC c: back to the state of a new window
fn term_full_reset(state: u64, i: u64) {
    tcur_off(state, i)
    tc_hide[(i) as usize] = 0
    term_blank_screen(state, i)
    tp_reset(i)
    wmlayout.wsv(state, i, wmlayout.W_CX, 0)
    wmlayout.wsv(state, i, wmlayout.W_CY, 0)
}

// The alternate screen: the main screen (cells, attributes, colours) is copied to frames 3 .. 5 of the grid and comes back
// when the program leaves. `save_cursor` is the ?1049 form that also keeps the cursor.
fn term_alt_enter(state: u64, i: u64, save_cursor: bool) {
    let g: u64 = wmlayout.wg(state, i, wmlayout.W_GRID)
    if g == 0 || tp_alt[(i) as usize] != 0 {
        return
    }
    if save_cursor {
        term_save_cursor(state, i)
    }
    wmdraw.copy_words(g + 3 * TG, g, TG_ALT_WORDS)
    tp_alt[(i) as usize] = 1
    term_blank_screen(state, i)
    tp_top[(i) as usize] = 0
    tp_bot1[(i) as usize] = 0
    term_set_cursor(state, i, 0, 0)
}

fn term_alt_leave(state: u64, i: u64, restore_cursor: bool) {
    let g: u64 = wmlayout.wg(state, i, wmlayout.W_GRID)
    if g == 0 || tp_alt[(i) as usize] == 0 {
        return
    }
    wmdraw.copy_words(g, g + 3 * TG, TG_ALT_WORDS)
    tp_alt[(i) as usize] = 0
    tp_top[(i) as usize] = 0
    tp_bot1[(i) as usize] = 0
    wmdraw.fill(state, i, 0, 0, wmlayout.wg(state, i, wmlayout.W_W), wmlayout.wg(state, i, wmlayout.W_H), wmlayout.wg(state, i, wmlayout.W_BG))
    term_redraw(state, i)
    if restore_cursor {
        term_restore_cursor(state, i)
    }
}

// CSI ? n h / l: the modes
fn term_mode(state: u64, i: u64, on: bool) {
    var k: u64 = 0
    var cnt: u64 = tp_np[(i) as usize]
    if cnt == 0 {
        cnt = 1
    }
    while k < cnt && k < TP_NP {
        let m: u64 = tp_p(i, k, 0)
        if m == 1049 {
            if on {
                term_alt_enter(state, i, true)
            } else {
                term_alt_leave(state, i, true)
            }
        } else if m == 47 || m == 1047 {
            if on {
                term_alt_enter(state, i, false)
            } else {
                term_alt_leave(state, i, false)
            }
        } else if m == 7 {
            if on {
                tp_nowrap[(i) as usize] = 0
            } else {
                tp_nowrap[(i) as usize] = 1
            }
        } else if m == 25 {
            // r1014: the text cursor (DECTCEM)
            if on {
                tc_hide[(i) as usize] = 0
            } else {
                tc_hide[(i) as usize] = 1
            }
        }
        // 1, 12, 2004 ...: accepted and dropped
        k = k + 1
    }
}

// CSI m: the attributes and colours
fn term_sgr(i: u64) {
    var q: u64 = 0
    var cnt: u64 = tp_np[(i) as usize]
    if cnt == 0 {
        cnt = 1
    }
    while q < cnt && q < TP_NP {
        let v: u64 = tp_p(i, q, 0)
        if v == 0 {
            tp_attr[(i) as usize] = 0
            tp_col[(i) as usize] = 0
        } else if v == 1 {
            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 2
        } else if v == 4 {
            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 4
        } else if v == 7 {
            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 1
        } else if v == 22 {
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xFD
        } else if v == 24 {
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xFB
        } else if v == 27 {
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xFE
        } else if v >= 30 && v <= 37 {
            tp_col[(i) as usize] = (tp_col[(i) as usize] & 0xF0) | (v - 30 + 1)
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xF7
        } else if v == 39 {
            tp_col[(i) as usize] = tp_col[(i) as usize] & 0xF0
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xF7
        } else if v >= 40 && v <= 47 {
            tp_col[(i) as usize] = (tp_col[(i) as usize] & 0x0F) | ((v - 40 + 1) << 4)
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xEF
        } else if v == 49 {
            tp_col[(i) as usize] = tp_col[(i) as usize] & 0x0F
            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xEF
        } else if v >= 90 && v <= 97 {
            tp_col[(i) as usize] = (tp_col[(i) as usize] & 0xF0) | (v - 90 + 1)
            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 8
        } else if v >= 100 && v <= 107 {
            tp_col[(i) as usize] = (tp_col[(i) as usize] & 0x0F) | ((v - 100 + 1) << 4)
            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 16
        } else if v == 38 || v == 48 {
            // 38 ; 5 ; n  (the 16 first colours of the 256 are used, the rest is dropped)  and  38 ; 2 ; r ; g ; b (dropped)
            let mode: u64 = tp_p(i, q + 1, 0)
            if mode == 5 {
                let nn: u64 = tp_p(i, q + 2, 0)
                if nn < 16 {
                    var idx: u64 = nn
                    var br: u64 = 0
                    if nn >= 8 {
                        idx = nn - 8
                        br = 1
                    }
                    if v == 38 {
                        tp_col[(i) as usize] = (tp_col[(i) as usize] & 0xF0) | (idx + 1)
                        if br != 0 {
                            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 8
                        } else {
                            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xF7
                        }
                    } else {
                        tp_col[(i) as usize] = (tp_col[(i) as usize] & 0x0F) | ((idx + 1) << 4)
                        if br != 0 {
                            tp_attr[(i) as usize] = tp_attr[(i) as usize] | 16
                        } else {
                            tp_attr[(i) as usize] = tp_attr[(i) as usize] & 0xEF
                        }
                    }
                }
                q = q + 2
            } else if mode == 2 {
                q = q + 4
            }
        }
        q = q + 1
    }
}

// the final octet of a CSI: do it
fn term_csi(state: u64, i: u64, fin: u64) {
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    let cx: u64 = wmlayout.wg(state, i, wmlayout.W_CX)
    let cy: u64 = wmlayout.wg(state, i, wmlayout.W_CY)
    let pv: u64 = tp_priv[(i) as usize]
    if pv != 0 {
        // CSI ? ... h / l: the modes; every other private sequence is dropped
        if pv == 1 && (fin == 104 || fin == 108) {
            term_mode(state, i, fin == 104)
        }
        return
    }
    if fin == 72 || fin == 102 {
        // H / f: row ; column, one based
        var r: u64 = tp_p(i, 0, 1)
        var c: u64 = tp_p(i, 1, 1)
        if r == 0 {
            r = 1
        }
        if c == 0 {
            c = 1
        }
        term_set_cursor(state, i, c - 1, r - 1)
    } else if fin == 65 {
        let n: u64 = tp_n(i)
        var top: u64 = 0
        if cy >= tp_first(state, i) {
            top = tp_first(state, i)
        }
        var to: u64 = 0
        if cy > top + n {
            to = cy - n
        } else {
            to = top
        }
        term_set_cursor(state, i, cx, to)
    } else if fin == 66 || fin == 101 {
        let n2: u64 = tp_n(i)
        var lim: u64 = rows - 1
        if cy <= tp_bot(state, i) {
            lim = tp_bot(state, i)
        }
        var to2: u64 = cy + n2
        if to2 > lim {
            to2 = lim
        }
        term_set_cursor(state, i, cx, to2)
    } else if fin == 67 || fin == 97 {
        let n3: u64 = tp_n(i)
        term_set_cursor(state, i, cx + n3, cy)
    } else if fin == 68 {
        let n4: u64 = tp_n(i)
        var to4: u64 = 0
        if cx > n4 {
            to4 = cx - n4
        }
        term_set_cursor(state, i, to4, cy)
    } else if fin == 69 {
        // E: next line, column 1
        let n5: u64 = tp_n(i)
        term_set_cursor(state, i, 0, cy + n5)
    } else if fin == 70 {
        // F: previous line, column 1
        let n6: u64 = tp_n(i)
        var to6: u64 = 0
        if cy > n6 {
            to6 = cy - n6
        }
        term_set_cursor(state, i, 0, to6)
    } else if fin == 71 || fin == 96 {
        var c7: u64 = tp_p(i, 0, 1)
        if c7 == 0 {
            c7 = 1
        }
        term_set_cursor(state, i, c7 - 1, cy)
    } else if fin == 100 {
        var r8: u64 = tp_p(i, 0, 1)
        if r8 == 0 {
            r8 = 1
        }
        term_set_cursor(state, i, cx, r8 - 1)
    } else if fin == 75 {
        // K: erase in line (0 = cursor to end, 1 = start to cursor, 2 = all)
        let m: u64 = tp_p(i, 0, 0)
        if m == 0 {
            term_clear_rect(state, i, cx, cy, 0, cy + 1)
        } else if m == 1 {
            term_clear_rect(state, i, 0, cy, cx + 1, cy)
        } else if m == 2 {
            term_clear_rect(state, i, 0, cy, 0, cy + 1)
        }
    } else if fin == 74 {
        // J: erase in display
        let m2: u64 = tp_p(i, 0, 0)
        if m2 == 0 {
            term_clear_rect(state, i, cx, cy, 0, rows)
        } else if m2 == 1 {
            term_clear_rect(state, i, 0, 0, cx + 1, cy)
        } else if m2 == 2 || m2 == 3 {
            term_clear_rect(state, i, 0, 0, 0, rows)
        }
    } else if fin == 88 {
        // X: erase n characters from the cursor
        var n9: u64 = tp_n(i)
        if cx + n9 > cols {
            n9 = cols - cx
        }
        term_clear_rect(state, i, cx, cy, cx + n9, cy)
    } else if fin == 64 {
        // @: insert n blank characters, the rest of the row moves right
        var n10: u64 = tp_n(i)
        if n10 > cols - cx {
            n10 = cols - cx
        }
        var c10: u64 = cols
        while c10 > cx + n10 {
            c10 = c10 - 1
            cell_set(state, i, c10, cy, cell_get(state, i, c10 - n10, cy))
            cell_attr_set(state, i, c10, cy, cell_attr(state, i, c10 - n10, cy))
            cell_col_set(state, i, c10, cy, cell_col(state, i, c10 - n10, cy))
        }
        var b10: u64 = cx
        while b10 < cx + n10 {
            cell_set(state, i, b10, cy, 32)
            cell_attr_set(state, i, b10, cy, 0)
            cell_col_set(state, i, b10, cy, 0)
            b10 = b10 + 1
        }
        term_repaint_row(state, i, cy)
    } else if fin == 80 {
        // P: delete n characters, the rest of the row moves left
        var n11: u64 = tp_n(i)
        if n11 > cols - cx {
            n11 = cols - cx
        }
        var c11: u64 = cx
        while c11 + n11 < cols {
            cell_set(state, i, c11, cy, cell_get(state, i, c11 + n11, cy))
            cell_attr_set(state, i, c11, cy, cell_attr(state, i, c11 + n11, cy))
            cell_col_set(state, i, c11, cy, cell_col(state, i, c11 + n11, cy))
            c11 = c11 + 1
        }
        while c11 < cols {
            cell_set(state, i, c11, cy, 32)
            cell_attr_set(state, i, c11, cy, 0)
            cell_col_set(state, i, c11, cy, 0)
            c11 = c11 + 1
        }
        term_repaint_row(state, i, cy)
    } else if fin == 76 {
        // L: insert n blank rows at the cursor row (inside the region), the rows below move down
        if cy >= tp_first(state, i) && cy <= tp_bot(state, i) {
            term_scroll_region(state, i, cy, tp_bot(state, i), tp_n(i), false)
            term_set_cursor(state, i, 0, cy)
        }
    } else if fin == 77 {
        // M: delete n rows at the cursor row, the rows below move up
        if cy >= tp_first(state, i) && cy <= tp_bot(state, i) {
            term_scroll_region(state, i, cy, tp_bot(state, i), tp_n(i), true)
            term_set_cursor(state, i, 0, cy)
        }
    } else if fin == 83 {
        term_scroll_region(state, i, tp_first(state, i), tp_bot(state, i), tp_n(i), true)
    } else if fin == 84 {
        term_scroll_region(state, i, tp_first(state, i), tp_bot(state, i), tp_n(i), false)
    } else if fin == 114 {
        // r: the scroll region, top ; bottom (one based); a bad pair resets it. The cursor goes home.
        var t: u64 = tp_p(i, 0, 1)
        var b: u64 = tp_p(i, 1, rows)
        if t == 0 {
            t = 1
        }
        if b == 0 || b > rows {
            b = rows
        }
        if t < b {
            tp_top[(i) as usize] = t - 1
            if b == rows && t == 1 {
                tp_bot1[(i) as usize] = 0
            } else {
                tp_bot1[(i) as usize] = b
            }
        } else {
            tp_top[(i) as usize] = 0
            tp_bot1[(i) as usize] = 0
        }
        term_set_cursor(state, i, 0, 0)
    } else if fin == 115 {
        term_save_cursor(state, i)
    } else if fin == 117 {
        term_restore_cursor(state, i)
    } else if fin == 109 {
        term_sgr(i)
    }
    // h / l without `?` (the ANSI modes), n (status request), c (attributes request), t, ... : accepted and dropped
}

// The escape machine in front of `term_putc`. Answers true when it took the octet.
fn term_esc_take(state: u64, i: u64, ch: u64) -> bool {
    if i >= 32 {
        return false
    }
    let st: u64 = tp_esc[(i) as usize]
    if st == 0 {
        if ch == 27 {
            tp_esc[(i) as usize] = 1
            return true
        }
        return false
    }
    if st == 3 {
        // inside OSC / DCS / PM / APC: up to BEL, or ESC \
        if ch == 7 {
            tp_esc[(i) as usize] = 0
        } else if ch == 27 {
            tp_esc[(i) as usize] = 5
        }
        return true
    }
    if st == 5 {
        tp_esc[(i) as usize] = 0
        return true
    }
    if st == 4 {
        tp_esc[(i) as usize] = 0
        return true
    }
    if st == 1 {
        tp_esc[(i) as usize] = 0
        if ch == 91 {
            tp_esc[(i) as usize] = 2
            tp_np[(i) as usize] = 0
            tp_priv[(i) as usize] = 0
            var k: u64 = 0
            while k < TP_NP {
                tp_par[(i * TP_NP + k) as usize] = 0
                tp_has[(i * TP_NP + k) as usize] = 0
                k = k + 1
            }
            return true
        }
        if ch == 93 || ch == 80 || ch == 94 || ch == 95 || ch == 88 {
            // ] P ^ _ X: the string sequences
            tp_esc[(i) as usize] = 3
            return true
        }
        if ch == 40 || ch == 41 || ch == 42 || ch == 43 || ch == 35 || ch == 37 {
            // ESC ( B, ESC # 8 ...: one more octet belongs to it
            tp_esc[(i) as usize] = 4
            return true
        }
        if ch == 99 {
            term_full_reset(state, i)
            return true
        }
        if ch == 55 {
            term_save_cursor(state, i)
            return true
        }
        if ch == 56 {
            term_restore_cursor(state, i)
            return true
        }
        if ch == 68 {
            term_lf(state, i)
            return true
        }
        if ch == 69 {
            wmlayout.wsv(state, i, wmlayout.W_CX, 0)
            tp_wrap[(i) as usize] = 0
            term_lf(state, i)
            return true
        }
        if ch == 77 {
            term_ri(state, i)
            return true
        }
        if ch == 27 {
            tp_esc[(i) as usize] = 1
            return true
        }
        if ch >= 48 && ch <= 126 {
            // ESC = ESC > ESC H ESC Z ...: the other two-octet escapes are dropped
            return true
        }
        if ch < 32 {
            // a control octet after a lone ESC: handled as itself
            return false
        }
        return true
    }
    // inside ESC [
    if ch >= 48 && ch <= 57 {
        let np: u64 = tp_np[(i) as usize]
        if np < TP_NP {
            let at: u64 = i * TP_NP + np
            tp_par[(at) as usize] = tp_par[(at) as usize] * 10 + (ch - 48)
            if tp_par[(at) as usize] > 9999 {
                tp_par[(at) as usize] = 9999
            }
            tp_has[(at) as usize] = 1
        }
        return true
    }
    if ch == 59 || ch == 58 {
        // ; and the sub-parameter colon
        if tp_np[(i) as usize] + 1 < TP_NP {
            tp_np[(i) as usize] = tp_np[(i) as usize] + 1
        }
        return true
    }
    if ch == 63 {
        tp_priv[(i) as usize] = 1
        return true
    }
    if ch == 60 || ch == 61 || ch == 62 {
        tp_priv[(i) as usize] = 2
        return true
    }
    if ch >= 64 && ch <= 126 {
        // the final octet: the number of parameters is the one after the last `;`
        let np2: u64 = tp_np[(i) as usize]
        if tp_has[(i * TP_NP + np2) as usize] != 0 || np2 > 0 {
            tp_np[(i) as usize] = np2 + 1
        }
        tp_esc[(i) as usize] = 0
        term_csi(state, i, ch)
        return true
    }
    if ch == 27 {
        tp_esc[(i) as usize] = 1
        return true
    }
    if ch == 24 || ch == 26 {
        // CAN, SUB: the sequence is cancelled
        tp_esc[(i) as usize] = 0
        return true
    }
    if ch < 32 {
        // a control octet inside a sequence is carried out and the sequence goes on (ECMA-48)
        return false
    }
    // intermediate octets (space .. /): swallowed
    return true
}

fn term_putc(state: u64, i: u64, ch: u64) {
    let cols: u64 = wmlayout.wg(state, i, wmlayout.W_COLS)
    let rows: u64 = wmlayout.wg(state, i, wmlayout.W_ROWS)
    if cols == 0 || rows == 0 || i >= 32 {
        return
    }
    if ch < 256 && term_esc_take(state, i, ch) {
        return
    }
    // Ein Steuerzeichen beendet jede angefangene Folge: ein halb
    // gelesenes Zeichen ueber einen Zeilenumbruch hinweg gibt es
    // nicht, und ein haengengebliebenes Fuehrungsoktett wuerde das
    // NAECHSTE Zeichen verschlucken.
    if ch < 32 {
        tp_utf[(i) as usize] = 0
    }
    var cx: u64 = wmlayout.wg(state, i, wmlayout.W_CX)
    var cy: u64 = wmlayout.wg(state, i, wmlayout.W_CY)
    if ch == 13 {
        wmlayout.wsv(state, i, wmlayout.W_CX, 0)
        tp_wrap[(i) as usize] = 0
        return
    }
    if ch == 10 {
        wmlayout.wsv(state, i, wmlayout.W_CX, 0)
        tp_wrap[(i) as usize] = 0
        term_lf(state, i)
        return
    }
    if ch == 8 {
        tp_wrap[(i) as usize] = 0
        if cx > 0 {
            cx = cx - 1
            wmlayout.wsv(state, i, wmlayout.W_CX, cx)
            cell_set(state, i, cx, cy, 32)
            cell_attr_set(state, i, cx, cy, 0)
            cell_col_set(state, i, cx, cy, 0)
            cell_paint(state, i, cx, cy)
        }
        return
    }
    // 0x108: the WRAPPING backspace of the live line echo (tty ECHOWIN).
    // A plain 8 stops at the left edge; a line typed past the right edge
    // has to be wiped back into the row above.
    if ch == 0x108 {
        tp_wrap[(i) as usize] = 0
        if cx > 0 {
            cx = cx - 1
        } else if cy > 0 {
            cy = cy - 1
            cx = cols - 1
        } else {
            return
        }
        wmlayout.wsv(state, i, wmlayout.W_CX, cx)
        wmlayout.wsv(state, i, wmlayout.W_CY, cy)
        cell_set(state, i, cx, cy, 32)
        cell_attr_set(state, i, cx, cy, 0)
        cell_col_set(state, i, cx, cy, 0)
        cell_paint(state, i, cx, cy)
        return
    }
    if ch == 9 {
        var n: u64 = 8 - (cx & 7)
        while n > 0 {
            term_putc(state, i, 32)
            n = n - 1
        }
        return
    }
    // DER UTF-8-WEG. `z` ist die Zeichennummer, die in die Zelle geht.
    var z: u64 = ch
    if tp_utf[(i) as usize] != 0 {
        let lead: u64 = tp_utf[(i) as usize]
        tp_utf[(i) as usize] = 0
        if ch < 128 || ch > 191 {
            // Kein Folgeoktett: die angefangene Folge war Schrott.
            // Das Oktett hier wird trotzdem noch als sich selbst
            // versucht -- Schrott einmal zu melden ist genug.
            z = ch
        } else {
            z = (lead - 192) * 64 + (ch - 128)
            if z > 255 {
                z = 63 // '?' -- passt nicht in eine Zelle
            }
        }
    } else if ch >= 194 && ch <= 223 {
        tp_utf[(i) as usize] = ch
        return
    } else if ch >= 224 && ch <= 244 {
        // Drei oder vier Oktette: der Rest der Folge sind Folge-
        // oktette (80..BF), die unten von selbst durchfallen.
        z = 63
    } else if ch > 127 {
        return
    }
    // 0x7F..0x9F ist nicht druckbar (C1), 0xA0 ist ein Leerzeichen.
    if z < 32 || (z > 126 && z < 160) {
        return
    }
    // r462: THE WRAP IS DEFERRED. The character that fills the last column leaves the cursor there and only the NEXT printable
    // character moves to the next row (and scrolls when that row is below the region). Before, the 80th character of a row
    // scrolled the screen at once, and an editor that fills its last row (the help line) pushed its whole screen up by one row.
    if tp_wrap[(i) as usize] != 0 {
        tp_wrap[(i) as usize] = 0
        wmlayout.wsv(state, i, wmlayout.W_CX, 0)
        term_lf(state, i)
        cx = 0
        cy = wmlayout.wg(state, i, wmlayout.W_CY)
    }
    cell_set(state, i, cx, cy, z)
    cell_attr_set(state, i, cx, cy, tp_attr[(i) as usize])
    cell_col_set(state, i, cx, cy, tp_col[(i) as usize])
    cell_paint(state, i, cx, cy)
    if cx + 1 >= cols {
        if tp_nowrap[(i) as usize] == 0 {
            tp_wrap[(i) as usize] = 1
        }
        wmlayout.wsv(state, i, wmlayout.W_CX, cols - 1)
    } else {
        wmlayout.wsv(state, i, wmlayout.W_CX, cx + 1)
    }
}

fn term_write(state: u64, i: u64, p: u64, n: u64) -> u64 {
    if !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM {
        return 0
    }
    sb_snap(state, i)
    tsel_clear(state, i)
    tcur_off(state, i)
    var k: u64 = 0
    while k < n {
        term_putc(state, i, kstate.get8(p + k))
        k = k + 1
    }
    tcur_solid(state)
    tcur_sync(state, i)
    wmdamage.damage_win(state, i)
    return n
}

// ------------------------------------------------------------ Zusagen

// Ein Terminalfenster an ein Terminal binden. Von da an geht `tty.emit`
// mit SINK_WINDOW hierher.
fn bind_tty(state: u64, i: u64, t: u64) {
    if !wmbase.valid(state, i) {
        return
    }
    wmlayout.wsv(state, i, wmlayout.W_TTY, t + 1)
}

fn tty_of(state: u64, i: u64) -> u64 {
    if !wmbase.valid(state, i) {
        return NO_TTY
    }
    let t: u64 = wmlayout.wg(state, i, wmlayout.W_TTY)
    if t == 0 {
        return NO_TTY
    }
    return t - 1
}

// An WELCHES Terminal eine Taste geht: an das des Fensters mit dem
// Eingabefokus, wenn das ein Terminalfenster ist -- sonst an gar keines.
// Das ist die eine Zeile, die aus einem Bildschirm eine BEDIENBARE
// Oberflaeche macht.
// Shift+PageUp / Shift+PageDown on a focused terminal window: one page (rows - 1 lines) through the history. True: the
// key was consumed (kbd.fi then does not send it to the shell).
fn term_page(state: u64, up: bool) -> bool {
    if !wmbase.ready(state) {
        return false
    }
    let f: u64 = wmbase.focus(state)
    if f >= wmbase.MAX_WIN || wmlayout.wg(state, f, wmlayout.W_KIND) != wmlayout.K_TERM || !wmgate.darf(state, f) {
        return false
    }
    var page: i64 = (wmlayout.wg(state, f, wmlayout.W_ROWS) as i64) - 1
    if page < 1 {
        page = 1
    }
    if up {
        sb_move(state, f, page)
    } else {
        sb_move(state, f, 0 - page)
    }
    return true
}

fn key_tty(state: u64) -> u64 {
    if !wmbase.ready(state) {
        return NO_TTY
    }
    // RUNDE WMPLUGIN: hat gerade ein Plugin diese Taste bekommen, geht
    // sie an KEIN Terminal. Der Merker gilt fuer genau eine Taste und
    // wird hier geloescht -- er darf nicht die naechste mitnehmen.
    if wmlayout.gs(state, wmlayout.S_KSWAL) != 0 {
        wmlayout.ss(state, wmlayout.S_KSWAL, 0)
        return NO_TTY
    }
    let f: u64 = wmbase.focus(state)
    if f >= wmbase.MAX_WIN || wmlayout.wg(state, f, wmlayout.W_KIND) != wmlayout.K_TERM {
        return NO_TTY
    }
    // WHILE THE SCREEN IS LOCKED (sign-in screen included) THE KEY
    // BELONGS TO THE LOCKER ONLY. `on_key` already sends it there and
    // nowhere else -- but this path asked only for the focus, so the
    // terminal that had the focus before the lock got every key too:
    // on the Dell (27.09.2026) the password typed at sign-in showed up
    // as `sh: cannot run startkennwort` in the terminal behind it.
    if !wmgate.darf(state, f) {
        return NO_TTY
    }
    sb_snap(state, f)
    return tty_of(state, f)
}

// EIN Oktett in ein Terminalfenster. Der Weg von `tty.emit`.
fn term_out(state: u64, i: u64, c: u64) {
    wmlayout.ss(state, wmlayout.S_TOUT, wmlayout.gs(state, wmlayout.S_TOUT) + 1)
    if !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM {
        return
    }
    wmlayout.ss(state, wmlayout.S_TPUT, wmlayout.gs(state, wmlayout.S_TPUT) + 1)
    sb_snap(state, i)
    tsel_clear(state, i)
    tcur_off(state, i)
    term_putc(state, i, c)
    tcur_solid(state)
    tcur_sync(state, i)
    if term_hold_n != 0 {
        term_hold_mask = term_hold_mask | (1 << i)
        return
    }
    wmdamage.damage_win(state, i)
}

static mut term_hold_n: u64 = 0
static mut term_hold_mask: u64 = 0

fn term_hold(state: u64) {
    __atomic_add((&term_hold_n) as *mut u64, 1 as u64)
}

fn term_release(state: u64) {
    if term_hold_n == 0 {
        return
    }
    __atomic_add((&term_hold_n) as *mut u64, 0 -% 1)
    if term_hold_n != 0 {
        return
    }
    let m: u64 = term_hold_mask
    term_hold_mask = 0
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if ((m >> i) & 1) != 0 && wmbase.valid(state, i) {
            wmdamage.damage_win(state, i)
        }
        i = i + 1
    }
}

// Die zwei Zaehler nach aussen, fuer die Tafel und die Abnahme.
fn term_outs(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_TOUT)
}

fn term_puts_n(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_TPUT)
}

// ===================================================== RUNDE TILING
//
// DER FENSTERBAUM AM FENSTERSERVER. Die Rechnung selbst steht in
// `kernel/tile.fi` und weiss von Fenstern nichts; was hier steht, ist
// die NAHT: welches Blatt gehoert zu welchem Fenster, wie kommt ein
// Rechteck aus dem Baum in einen Fenstersatz, wer malt die Reiterzeilen,
// und was passiert, wenn man ein Fenster mit der Maus irgendwohin zieht.
//
// BEIDE WELTEN NEBENEINANDER, und das ist Absicht: ein Fenster mit
// W_NODE == 0 SCHWEBT wie vor dieser Runde, eines mit W_NODE != 0 haengt
// im Baum. Ein Dialog will schweben, eine Textkonsole will kacheln.
// `tile_float` schiebt ein Fenster von der einen Welt in die andere und
// zurueck; die schwebende Lage wird dabei in W_SAVXY/W_SAVWH aufgehoben,
// sonst steht der Dialog nach dem Zurueckholen in der Ecke.

// ===================================================== r839 TILE TREE PER HEAD
// One tree per head. The tree of the primary head is the old tree (the pages at kstate.TILE_OFF, `state` itself is
// its "tile state"). Every other head gets its own 4-frame tree the first time a window is tiled onto it; the tile
// module only ever computes `state + kstate.TILE_OFF + ...`, so a tree is addressed by the fake state
// `frames - TILE_OFF` (`tl_state`). `W_NODE` = (node + 1) | (tree tag << 8); tag 0 = the main tree, tag h >= 1 = the
// tree of head h. The CURRENT tree (`tl_cur`, answered by `tt(state)`) is a plain global: every entry point selects
// it first (`tl_use` may allocate the tree, `tl_sel` only selects an existing one), every `tile.*` call below uses
// `tt(state)`. With fewer than two heads tag 0 is the only one and nothing changes.
static mut tl_cur: u64 = 0
static mut tl_alt: [u64; 8] = [0 as u64; 8]
static mut tl_mask: u64 = 1
static mut tl_prim: u64 = 0
static mut tl_drop_tag: u64 = 0
static mut tl_re: [u8; 32] = [0 as u8; 32]

fn nd_node(v: u64) -> u64 {
    return (v & 0xFF) - 1
}

fn nd_tag(v: u64) -> u64 {
    return v >> 8
}

fn nd_val(n: u64) -> u64 {
    return (n + 1) | (tl_cur << 8)
}

fn tl_state(state: u64, tag: u64) -> u64 {
    if tag == 0 || tag >= HD_MAX {
        return state
    }
    let b: u64 = tl_alt[tag as usize]
    if b == 0 {
        return state
    }
    return b - kstate.TILE_OFF
}

fn tt(state: u64) -> u64 {
    return tl_state(state, tl_cur)
}

// Select an EXISTING tree (tag 0 when there is none).
fn tl_sel(state: u64, tag: u64) {
    if tag != 0 && (tag >= HD_MAX || tl_alt[tag as usize] == 0) {
        tl_cur = 0
        return
    }
    tl_cur = tag
}

// Tree tag of a head: 0 for the primary head (and always on a single screen).
fn tl_tag_head(state: u64, hd: u64) -> u64 {
    if !hd_multi(state) || hd >= HD_MAX || hd == hd_primary(state) {
        return 0
    }
    return hd
}

// Select the tree of `tag`, making it first when it does not exist yet. False: no such head / no memory (then the
// main tree is selected).
fn tl_use(state: u64, tag: u64) -> bool {
    tl_cur = 0
    if tag == 0 {
        return true
    }
    if tag >= HD_MAX || !hd_present(state, tag) {
        return false
    }
    if tl_alt[tag as usize] == 0 {
        let b: u64 = mem.frame_run(state, 4)
        if b == 0 {
            return false
        }
        if b <= kstate.TILE_OFF {
            mem.frame_free_run(state, b, 4)
            return false
        }
        var o: u64 = 0
        while o < kstate.TILE_MAX {
            kstate.set(b, o, 0)
            o = o + 8
        }
        let p: u64 = head_work(state, tag)
        if !tile.init(b - kstate.TILE_OFF, hw_x(p), hw_y(p), hw_w(p), hw_h(p)) {
            mem.frame_free_run(state, b, 4)
            return false
        }
        tl_alt[tag as usize] = b
    }
    tl_cur = tag
    return true
}

fn tl_use_win(state: u64, i: u64) {
    let v: u64 = wmlayout.wg(state, i, wmlayout.W_NODE)
    if v == 0 {
        tl_cur = 0
        return
    }
    tl_sel(state, nd_tag(v))
}

fn tl_free(state: u64, tag: u64) {
    if tag == 0 || tag >= HD_MAX {
        return
    }
    let b: u64 = tl_alt[tag as usize]
    if b != 0 {
        mem.frame_free_run(state, b, 4)
        tl_alt[tag as usize] = 0
    }
}

// Tree state of the focused window's tree (for the ring-3 queries); the main tree when it is not tiled.
fn tile_focus_state(state: u64) -> u64 {
    let f: u64 = wmbase.focus(state)
    if f < wmbase.MAX_WIN && wmbase.valid(state, f) && wmlayout.wg(state, f, wmlayout.W_NODE) != 0 {
        return tl_state(state, nd_tag(wmlayout.wg(state, f, wmlayout.W_NODE)))
    }
    return state
}

fn tile_nodes_all(state: u64) -> u64 {
    var n: u64 = tile.nodes(state)
    var h: u64 = 1
    while h < HD_MAX {
        if tl_alt[h as usize] != 0 {
            n = n + tile.nodes(tl_state(state, h))
        }
        h = h + 1
    }
    return n
}

fn tile_leaves_all(state: u64) -> u64 {
    var n: u64 = tile.leaves(state)
    var h: u64 = 1
    while h < HD_MAX {
        if tl_alt[h as usize] != 0 {
            n = n + tile.leaves(tl_state(state, h))
        }
        h = h + 1
    }
    return n
}

// Heads came or went (called from heads_sync, after the windows were moved onto heads that exist): a tree whose head
// is gone gives its windows back (they are tiled again onto the head they are on now); when the PRIMARY head
// changed, the main tree changed owner, so every tiled window is re-tiled. Trees of new heads need nothing: they
// are made when the first window lands there.
fn tl_heads_changed(state: u64) {
    var mask: u64 = 1
    var prim: u64 = 0
    if hd_multi(state) {
        mask = 0
        var hd: u64 = 0
        while hd < HD_MAX {
            if hd_present(state, hd) {
                let bit: u64 = 1
                mask = mask | (bit << hd)
            }
            hd = hd + 1
        }
        prim = hd_primary(state)
    }
    let full: bool = prim != tl_prim
    var gone: u64 = 0
    var h: u64 = 1
    while h < HD_MAX {
        let bit2: u64 = 1
        if tl_alt[h as usize] != 0 && (mask & (bit2 << h)) == 0 {
            gone = gone | (bit2 << h)
        }
        h = h + 1
    }
    tl_mask = mask
    if !full && gone == 0 {
        return
    }
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        tl_re[i as usize] = 0
        let v: u64 = wmlayout.wg(state, i, wmlayout.W_NODE)
        if wmlayout.wg(state, i, wmlayout.W_USED) != 0 && v != 0 {
            let t: u64 = nd_tag(v)
            let bit3: u64 = 1
            if full || (t != 0 && (gone & (bit3 << t)) != 0) {
                tile_release(state, i)
                tl_re[i as usize] = 1
            }
        }
        i = i + 1
    }
    h = 1
    while h < HD_MAX {
        let bit4: u64 = 1
        if full || (gone & (bit4 << h)) != 0 {
            tl_free(state, h)
        }
        h = h + 1
    }
    tl_prim = prim
    tl_cur = 0
    i = 0
    while i < wmbase.MAX_WIN {
        if tl_re[i as usize] != 0 {
            let _t: bool = tile_take(state, i)
        }
        i = i + 1
    }
}

fn tile_tree_tag(state: u64, i: u64) -> u64 {
    if !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_NODE) == 0 {
        return 0
    }
    return nd_tag(wmlayout.wg(state, i, wmlayout.W_NODE))
}

fn tile_on(state: u64) -> bool {
    return wmlayout.gs(state, wmlayout.S_TILE) != 0
}

fn tiled(state: u64, i: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    return wmlayout.wg(state, i, wmlayout.W_NODE) != 0
}

fn tile_node(state: u64, i: u64) -> u64 {
    if !wmbase.valid(state, i) {
        return tile.NONE
    }
    let nd: u64 = wmlayout.wg(state, i, wmlayout.W_NODE)
    if nd == 0 {
        return tile.NONE
    }
    return nd_node(nd)
}

// RUNDE TILING: LIEGT DIESES FENSTER HINTER EINEM REITER. Diese
// Funktion hiess in der Runde TILING `win_hidden` -- genau wie die
// Funktion der Runde DESKTOP, die "ist minimiert" beantwortet. Zwei
// Fragen, zwei Antworten, ein Name: der Uebersetzer hat es gemeldet,
// und ein Leser haette es nicht gemerkt. Sie heisst jetzt `win_tabbed`.
fn win_tabbed(state: u64, i: u64) -> bool {
    if i >= wmbase.MAX_WIN {
        return false
    }
    return (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_TABBED) != 0
}

fn hotkeys_seen(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_HOTS)
}

// RUNDE WMPLUGIN: WIE VIELE TASTEN EIN PLUGIN BEKOMMEN HAT -- und
// damit, wie viele KEIN Fenster bekommen hat. Ohne diese Zahl liesse
// sich "das Kuerzel wurde geschluckt" nicht von "die Taste kam nie an"
// unterscheiden, und das sind zwei verschiedene Fehler.
fn plugkeys(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_KPLUG)
}

// Der Bereich, den die letzte Baumoperation angefasst hat -- und NUR
// der. Das ist die Zahl, die `notiledirty` kaputt macht.
fn damage_tile(state: u64) {
    let x: u64 = tile.last_x(tt(state))
    let y: u64 = tile.last_y(tt(state))
    let w: u64 = tile.last_w(tt(state))
    let h: u64 = tile.last_h(tt(state))
    if w == 0 || h == 0 {
        return
    }
    wmbase.damage(state, x as i64, y as i64, (x + w) as i64, (y + h) as i64)
}

fn set_tile_on(state: u64, on: bool) {
    if !wmbase.ready(state) {
        return
    }
    if on {
        wmlayout.ss(state, wmlayout.S_TILE, 1)
        // ================================================ RUNDE ECHTHARDWARE-3
        // NICHT ALLES, WAS OFFEN IST, GEHOERT IN DEN BAUM.
        //
        // Justins Befund: "Tiling ein-/ausschalten zerschiesst den
        // Zustand -- danach geht fast gar nichts mehr." Hier stand
        // "Alles, was jetzt schon offen ist, kommt in den Baum", und
        // das war woertlich gemeint: der SCHREIBTISCH (L_DESK, deckt
        // den ganzen Schirm), die TASKLEISTE (L_TOP, reserviert eine
        // Kante), das Startmenue, ein Klappmenue, eine Blase -- alle
        // wurden zu Kacheln.
        //
        // Was daraus folgt, ist genau das, was er sieht: die Leiste
        // bekommt eine halbe Bildschirmflaeche zugeteilt und liegt
        // nicht mehr an ihrer Kante, der Schreibtisch wird zur Kachel
        // neben ihr, und `restore_geom` beim Ausschalten setzt beide
        // auf Masse zurueck, die inzwischen nichts mehr bedeuten --
        // die Leiste ist weg, der Schreibtisch sitzt schief, und ohne
        // Leiste gibt es keinen Knopf mehr, mit dem man es zuruecknimmt.
        //
        // GEKACHELT WIRD, WAS EIN MENSCH ALS FENSTER BENUTZT: die
        // Ebene L_NORMAL, sichtbar, und ohne reservierte Kante.
        var i: u64 = 0
        while i < wmbase.MAX_WIN {
            if wmlayout.wg(state, i, wmlayout.W_USED) != 0 && wmlayout.wg(state, i, wmlayout.W_NODE) == 0
                && wmlayout.wg(state, i, wmlayout.W_LAYER) == wmlayout.L_NORMAL
                && wmlayout.wg(state, i, wmlayout.W_STRUT) == 0
                && (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) == 0 {
                save_geom(state, i)
                tile_take(state, i)
            }
            i = i + 1
        }
    } else {
        wmlayout.ss(state, wmlayout.S_TILE, 0)
        var k: u64 = 0
        while k < wmbase.MAX_WIN {
            if wmlayout.wg(state, k, wmlayout.W_USED) != 0 && wmlayout.wg(state, k, wmlayout.W_NODE) != 0 {
                tile_release(state, k)
                restore_geom(state, k)
            }
            k = k + 1
        }
    }
    wmbase.damage_all(state)
}

fn save_geom(state: u64, i: u64) {
    var x: u64 = wmlayout.wg(state, i, wmlayout.W_X) & 0xFFFFFFFF
    var y: u64 = wmlayout.wg(state, i, wmlayout.W_Y) & 0xFFFFFFFF
    wmlayout.wsv(state, i, wmlayout.W_SAVXY, (x << 32) | y)
    wmlayout.wsv(state, i, wmlayout.W_SAVWH, (wmlayout.wg(state, i, wmlayout.W_W) << 32) | wmlayout.wg(state, i, wmlayout.W_H))
}

fn restore_geom(state: u64, i: u64) {
    let wh: u64 = wmlayout.wg(state, i, wmlayout.W_SAVWH)
    if wh == 0 {
        return
    }
    let xy: u64 = wmlayout.wg(state, i, wmlayout.W_SAVXY)
    wmlayout.wsv(state, i, wmlayout.W_X, xy >> 32)
    wmlayout.wsv(state, i, wmlayout.W_Y, xy & 0xFFFFFFFF)
    let w: u64 = wh >> 32
    let h: u64 = wh & 0xFFFFFFFF
    if w >= 32 && h >= 16 {
        if reframe(state, i, w, h) {
            wmlayout.wsv(state, i, wmlayout.W_W, w)
            wmlayout.wsv(state, i, wmlayout.W_H, h)
            if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM {
                term_setup(state, i)
            } else {
                wmdraw.fill(state, i, 0, 0, w, h, wmlayout.wg(state, i, wmlayout.W_BG))
            }
            ev_push(state, i, wmlayout.E_RESIZE, w, h, 0)
        }
    }
    wmlayout.wsv(state, i, wmlayout.W_FLAGS, wmlayout.wg(state, i, wmlayout.W_FLAGS) & ~wmlayout.F_TABBED)
}

// EIN GROESSERER PUFFER, WENN DER BAUM MEHR PLATZ GIBT. Runde K10 hat
// den Puffer beim Anlegen geholt und `resize_win` verweigert seitdem
// jedes Wachsen darueber hinaus -- mit Recht, denn sonst waere es ein
// Schreibzugriff daneben. Beim Kacheln ist Wachsen aber der Normalfall:
// wer von vier Fenstern zwei schliesst, verdoppelt die uebrigen. Also
// wird hier ein neuer Lauf Rahmen geholt und der alte zurueckgegeben.
fn reframe(state: u64, i: u64, w: u64, h: u64) -> bool {
    let bytes: u64 = w * h * 4
    if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM && wmlayout.wg(state, i, wmlayout.W_SHM) != 0 {
        return term_fit(state, i, bytes)
    }
    if wmlayout.wg(state, i, wmlayout.W_SHM) != 0 {
        return detach_buf(state, i, bytes)
    }
    if bytes <= wmlayout.wg(state, i, wmlayout.W_BUFBYTES) {
        return true
    }
    let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    let neu: u64 = mem.frame_run(state, rahmen)
    if neu == 0 {
        return false
    }
    let alt: u64 = wmlayout.wg(state, i, wmlayout.W_BUF)
    let altr: u64 = wmlayout.wg(state, i, wmlayout.W_BUFBYTES) / mem.FRAME_SIZE
    wmlayout.wsv(state, i, wmlayout.W_BUF, neu)
    wmlayout.wsv(state, i, wmlayout.W_BUFBYTES, rahmen * mem.FRAME_SIZE)
    if alt != 0 {
        mem.frame_free_run(state, alt, altr)
    }
    return true
}

// Ein Blatt des Baumes auf einen Fenstersatz. Der Baum fuehrt das
// AEUSSERE Rechteck (mit Rahmen und Titelleiste) -- die Malflaeche ist
// das, was davon uebrigbleibt.
fn place_win(state: u64, i: u64, n: u64) {
    let ow: u64 = tile.n_w(tt(state), n)
    let oh: u64 = tile.n_h(tt(state), n)
    var w: u64 = 32
    if ow > wmgeom.border(state) * 2 + 32 {
        w = ow - wmgeom.border(state) * 2
    }
    var h: u64 = 16
    if oh > wmbase.iny(state, i) + wmgeom.border(state) + 16 {
        h = oh - wmbase.iny(state, i) - wmgeom.border(state)
    }
    // RUNDE SCHIRM-ECHT: DIE DRITTE 2048 -- dieselbe vergessene Zahl,
    // die `resize_win` schon losgeworden ist. Beim Kacheln bekommt ein
    // Blatt die Flaeche des Baumes, und die ist auf einem 2560er Schirm
    // breiter als 2048; das Fenster blieb dann kleiner als sein Platz
    // und liess einen Streifen Schreibtisch stehen. Die echte Grenze
    // ist der Puffer, und um den kuemmert sich `reframe` zwei Zeilen
    // tiefer.
    if w > wmgeom.MAX_W_HARD {
        w = wmgeom.MAX_W_HARD
    }
    if h > wmgeom.MAX_H_HARD {
        h = wmgeom.MAX_H_HARD
    }
    wmlayout.wsv(state, i, wmlayout.W_X, tile.n_x(tt(state), n))
    wmlayout.wsv(state, i, wmlayout.W_Y, tile.n_y(tt(state), n))
    if w == wmlayout.wg(state, i, wmlayout.W_W) && h == wmlayout.wg(state, i, wmlayout.W_H) {
        return
    }
    if !reframe(state, i, w, h) {
        return
    }
    wmlayout.wsv(state, i, wmlayout.W_W, w)
    wmlayout.wsv(state, i, wmlayout.W_H, h)
    if wmlayout.wg(state, i, wmlayout.W_KIND) == wmlayout.K_TERM {
        term_setup(state, i)
    } else {
        wmdraw.fill(state, i, 0, 0, w, h, wmlayout.wg(state, i, wmlayout.W_BG))
    }
    ev_push(state, i, wmlayout.E_RESIZE, w, h, 0)
}

// Den ganzen Baum auf die Fenster uebertragen. Ohne `damage` -- der
// Rufer beschmutzt EINMAL den Bereich, den der Baum als geaendert
// meldet, und genau das ist der Unterschied, den diese Runde misst.
fn tile_apply_one(state: u64) -> bool {
    let r: u64 = tile.root(tt(state))
    if r == tile.NONE {
        return false
    }
    var n: u64 = r
    var guard: u64 = 0
    while n != tile.NONE && guard <= tile.MAX_NODES {
        guard = guard + 1
        if tile.n_kind(tt(state), n) == tile.K_LEAF {
            let cl: u64 = tile.n_client(tt(state), n)
            if cl != 0 && cl <= wmbase.MAX_WIN {
                let i: u64 = cl - 1
                if wmlayout.wg(state, i, wmlayout.W_USED) != 0 {
                    // AUCH VERDECKTE REITER BEKOMMEN IHR RECHTECK. Sie
                    // werden nicht gemalt, aber sie muessen die richtige
                    // Groesse haben, wenn man den Reiter wechselt --
                    // sonst zuckt das Fenster beim Umschalten einmal
                    // durch, weil erst dann neu gerechnet wird.
                    place_win(state, i, n)
                    if tile.visible(tt(state), n) {
                        wmlayout.wsv(state, i, wmlayout.W_FLAGS,
                            wmlayout.wg(state, i, wmlayout.W_FLAGS) & ~wmlayout.F_TABBED)
                    } else {
                        wmlayout.wsv(state, i, wmlayout.W_FLAGS,
                            wmlayout.wg(state, i, wmlayout.W_FLAGS) | wmlayout.F_TABBED)
                    }
                }
            }
        }
        n = tile.dfs_next(tt(state), n, r)
    }
    // ================================================ RUNDE WMPLUGIN
    // DER KACHELBAUM HAT SICH BEWEGT. Diese eine Stelle meldet es, und
    // sie ist die richtige: JEDE Aenderung am Baum -- einfuegen,
    // herausnehmen, teilen, ziehen, Reiter wechseln -- laeuft durch
    // `tile_apply`, weil jede davon die Rechtecke neu verteilt.
    //
    // Zwei Zahlen gehen mit: Knoten und Blaetter. Sie genuegen, um "es
    // ist ein Fenster dazugekommen" von "die Kante wurde gezogen" zu
    // unterscheiden, und sie kosten den Kern zwei Ablesungen.
    // NICHT aus `compose` gerufen -- der Bildpfad bleibt frei davon.
    return true
}

fn tile_apply(state: u64) {
    let keep: u64 = tl_cur
    tl_cur = 0
    var did: bool = tile_apply_one(state)
    var h: u64 = 1
    while h < HD_MAX {
        if tl_alt[h as usize] != 0 {
            tl_cur = h
            if tile_apply_one(state) {
                did = true
            }
        }
        h = h + 1
    }
    tl_cur = keep
    if did {
        wmplug.notify(state, wmplug.E_TILE, tile_nodes_all(state),
            tile_leaves_all(state), 0)
    }
}

fn kachelbar(state: u64, i: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    if wmlayout.wg(state, i, wmlayout.W_LAYER) != wmlayout.L_NORMAL {
        return false
    }
    if wmlayout.wg(state, i, wmlayout.W_STRUT) != 0 {
        return false
    }
    // ==================================== RUNDE ECHTHARDWARE-4
    // EIN FENSTER OHNE SCHMUCK IST KEINE KACHEL.
    //
    // Justins Wort zum Kachelbetrieb war "Muell", und einer der
    // Gruende steht hier: `F_NODECO` traegt alles, was KEIN
    // gewoehnliches Fenster ist -- das Startmenue, ein Klappmenue,
    // eine Blase, ein rahmenloser Dialog. Ebene und Kantenreservierung
    // haben Schreibtisch und Leiste schon herausgehalten; das
    // Startmenue liegt aber auf der normalen Ebene und reserviert
    // nichts, also WAERE es gekachelt worden. Ein Startmenue, das
    // beim Aufgehen die Fenster daneben umsortiert, ist genau die Art
    // Automatismus, die in dieser Runde ausdruecklich nicht mehr
    // vorkommen darf.
    if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_NODECO) != 0 {
        return false
    }
    return (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) == 0
}

fn tile_take(state: u64, i: u64) -> bool {
    if !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_NODE) != 0 {
        return false
    }
    if !kachelbar(state, i) {
        return false
    }
    // r839: the tree of the head the window is on (the main tree on a single screen or when that tree cannot be made)
    let _u: bool = tl_use(state, tl_tag_head(state, win_head(state, i)))
    let n: u64 = tile.insert(tt(state), i + 1)
    if n == tile.NONE {
        return false // kein Platz im Baum -- das Fenster schwebt weiter
    }
    wmlayout.wsv(state, i, wmlayout.W_NODE, nd_val(n))
    tile_apply(state)
    damage_tile(state)
    return true
}

fn tile_release(state: u64, i: u64) -> bool {
    if i >= wmbase.MAX_WIN {
        return false
    }
    let nd: u64 = wmlayout.wg(state, i, wmlayout.W_NODE)
    if nd == 0 {
        return false
    }
    wmlayout.wsv(state, i, wmlayout.W_NODE, 0)
    wmlayout.wsv(state, i, wmlayout.W_FLAGS, wmlayout.wg(state, i, wmlayout.W_FLAGS) & ~wmlayout.F_TABBED)
    tl_sel(state, nd_tag(nd))
    tile.remove(tt(state), nd_node(nd))
    tile_apply(state)
    damage_tile(state)
    return true
}

fn tile_float(state: u64, i: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    if wmlayout.wg(state, i, wmlayout.W_NODE) != 0 {
        tile_release(state, i)
        restore_geom(state, i)
        raise_win(state, i)
        wmdamage.damage_win(state, i)
        return true
    }
    save_geom(state, i)
    return tile_take(state, i)
}

fn tile_snap(state: u64, i: u64, where: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    if wmlayout.wg(state, i, wmlayout.W_NODE) == 0 {
        save_geom(state, i)
        if !tile_take(state, i) {
            return false
        }
    }
    let nd: u64 = wmlayout.wg(state, i, wmlayout.W_NODE)
    if nd == 0 {
        return false
    }
    tl_sel(state, nd_tag(nd))
    tile.snap(tt(state), nd_node(nd), where)
    tile_apply(state)
    damage_tile(state)
    return true
}

// EIN WECHSEL DER BILDSCHIRMAUFLOESUNG. Der Baum wird NEU AUSGEMESSEN
// und nicht neu aufgebaut -- die Verhaeltnisse stehen als Anteile da und
// nicht als Bildpunkte, also ueberlebt jede Aufteilung den Wechsel.
fn on_screen_resize(state: u64, w: u64, h: u64) -> bool {
    if !wmbase.ready(state) || w == 0 || h == 0 {
        return false
    }
    wmlayout.ss(state, wmlayout.S_SW, w)
    wmlayout.ss(state, wmlayout.S_SH, h)
    // RUNDE VOLLBILD: der Baum bekommt die ARBEITSFLAECHE. Hier stand
    // `0, 0, w, h` -- der ganze Schirm -- und damit reichte jedes
    // gekachelte Fenster unter die Leiste. `recalc_work` rechnet die
    // Flaeche aus dem neuen Schirm und den Struts; danach steht sie in
    // S_WORK_*, und der Baum folgt ihr.
    recalc_work(state)
    tile_area_work(state)
    tile_apply(state)
    // r1004: the pointer limits, the maximized windows and every window that now sticks out of the screen follow the new size
    ps2m.set_bounds(state, w, h)
    screen_fit_windows(state, w, h)
    wmbase.damage_all(state)
    return true
}

// r1004: after a resolution change a maximized window gets the new work area; every other normal-layer window is pulled back
// inside the screen (moved first, shrunk only when it is bigger than the screen). Desk, bar (strut) and hidden windows stay alone.
fn screen_fit_windows(state: u64, w: u64, h: u64) {
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmbase.valid(state, i) && wmlayout.wg(state, i, wmlayout.W_STRUT) == 0 {
            let f: u64 = wmlayout.wg(state, i, wmlayout.W_FLAGS)
            let lay: u64 = win_layer(state, i)
            if (f & wmlayout.F_MAXIMIZED) != 0 {
                let _fw: bool = fit_work(state, i)
            } else if lay == wmlayout.L_NORMAL {
                var ow: u64 = wmbase.outer_w(state, i)
                var oh: u64 = wmbase.outer_h(state, i)
                var x: i64 = wmbase.win_x(state, i)
                var y: i64 = wmbase.win_y(state, i)
                // r1061: a floating window that was shrunk by an earlier, smaller screen remembers the size it had (W_SAVWH, tag bit 63;
                // a tiled window uses the same word for its own purpose, so only W_NODE == 0 counts). When the screen grows again
                // (800x600 -> auto revert -> 1024x768) the window gets that size back, as far as it fits.
                var tw: u64 = wmlayout.wg(state, i, wmlayout.W_W)
                var th: u64 = wmlayout.wg(state, i, wmlayout.W_H)
                let sv: u64 = wmlayout.wg(state, i, wmlayout.W_SAVWH)
                let floating: bool = wmlayout.wg(state, i, wmlayout.W_NODE) == 0
                if floating && (sv >> 63) != 0 {
                    let rw: u64 = (sv >> 32) & 0xFFFF
                    let rh: u64 = sv & 0xFFFF
                    if rw >= tw && rh >= th {
                        tw = rw
                        th = rh
                    }
                }
                let dw: u64 = ow - wmlayout.wg(state, i, wmlayout.W_W)
                let dh: u64 = oh - wmlayout.wg(state, i, wmlayout.W_H)
                var nw: u64 = tw
                var nh: u64 = th
                if tw + dw > w && tw + dw - w < tw {
                    nw = tw - (tw + dw - w)
                }
                if th + dh > h && th + dh - h < th {
                    nh = th - (th + dh - h)
                }
                if nw != wmlayout.wg(state, i, wmlayout.W_W) || nh != wmlayout.wg(state, i, wmlayout.W_H) {
                    let _rs: bool = resize_win(state, i, nw, nh)
                    ow = wmbase.outer_w(state, i)
                    oh = wmbase.outer_h(state, i)
                }
                if floating {
                    if nw < tw || nh < th {
                        wmlayout.wsv(state, i, wmlayout.W_SAVWH, 0x8000000000000000 | ((tw & 0xFFFF) << 32) | (th & 0xFFFF))
                    } else if (sv >> 63) != 0 {
                        wmlayout.wsv(state, i, wmlayout.W_SAVWH, 0)
                    }
                }
                if x + (ow as i64) > (w as i64) {
                    x = (w as i64) - (ow as i64)
                }
                if y + (oh as i64) > (h as i64) {
                    y = (h as i64) - (oh as i64)
                }
                if x < 0 {
                    x = 0
                }
                if y < 0 {
                    y = 0
                }
                if x != wmbase.win_x(state, i) || y != wmbase.win_y(state, i) {
                    move_win(state, i, x, y)
                }
            }
        }
        i = i + 1
    }
}

// r1004: THE WINDOW SERVER FOLLOWS THE SCREEN. Nobody called `on_screen_resize`: a host resize hint switched the card (vmode), the window
// server went on with the old size (work area, tile tree, damage box), and the desktop stayed black. One check at the head of every
// compose covers every path that switches the mode (host hint, Settings, dispctl). Several heads keep their own tables: left alone.
fn screen_follow(state: u64) {
    let fw: u64 = fb.width(state)
    let fh: u64 = fb.height(state)
    if fw == 0 || fh == 0 || hd_multi(state) {
        return
    }
    if fw != wmlayout.gs(state, wmlayout.S_SW) || fh != wmlayout.gs(state, wmlayout.S_SH) {
        let _r: bool = on_screen_resize(state, fw, fh)
    }
    // INPUT FOLLOWS THE OUTPUT: the hardware pointer sits in PANEL pixels, so a rotation / scale change moves it even when the
    // pointer itself did not (hwcur_bewegen only talks to the device when form, rotation or panel position changed).
    if wmcursor.hwcur_moeglich(state) && wmcursor.hw_an(state) {
        wmcursor.hwcur_bewegen(state)
    }
}

// ================================================== RUNDE VOLLBILD
// DER KACHELBAUM FOLGT DER ARBEITSFLAECHE.
//
// An EINER Stelle, weil es zwei Anlaesse gibt, sie zu setzen: ein
// Wechsel der Aufloesung und ein Wechsel der Struts (die Leiste zieht
// an eine andere Kante, wird versteckt, kommt zurueck). Stuende die
// Rechnung an beiden, waere sie eine Gelegenheit, sie an einer zu
// vergessen -- so wie sie bis zu dieser Runde ganz fehlte.
fn tile_area_work(state: u64) {
    let _a: bool = tile.set_area(state, wmlayout.gs(state, wmlayout.S_WORK_X),
        wmlayout.gs(state, wmlayout.S_WORK_Y), wmlayout.gs(state, wmlayout.S_WORK_W), wmlayout.gs(state, wmlayout.S_WORK_H))
    // r839: the trees of the other heads follow the work area of their head
    var h: u64 = 1
    while h < HD_MAX {
        if tl_alt[h as usize] != 0 && hd_multi(state) && hd_present(state, h) {
            let p: u64 = head_work(state, h)
            let _b: bool = tile.set_area(tl_state(state, h), hw_x(p), hw_y(p), hw_w(p), hw_h(p))
        }
        h = h + 1
    }
}

// ------------------------------------------------ die Reiterzeilen
//
// Sie werden vom SERVER gemalt, wie die Titelleiste -- eine Anwendung
// darf nicht wissen, dass sie in einem Reiter liegt, und sie kann es
// auch nicht malen: die Zeile liegt AUSSERHALB ihres Rechtecks. Der
// Baum hat ihre Hoehe von der Flaeche der Kinder schon abgezogen, also
// ueberschneidet sich hier nichts.
fn paint_bar_of(state: u64, n: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let f: u64 = wmlayout.gs(state, wmlayout.S_FONT_UI)
    let px: u64 = wmlayout.gs(state, wmlayout.S_PX_UI)
    var idx: u64 = 0
    var c: u64 = tile.n_first(tt(state), n)
    while c != tile.NONE && idx <= tile.MAX_NODES {
        let tx: i64 = tile.tab_x(tt(state), n, idx) as i64
        let ty: i64 = tile.tab_y(tt(state), n, idx) as i64
        let tw: i64 = tile.tab_w(tt(state), n, idx) as i64
        let th: i64 = tile.tab_h(tt(state), n, idx) as i64
        let aktiv: bool = tile.n_active(tt(state), n) == c
        // ROUND MERGE: THESE WERE FIVE RAW COLOURS. Round TILING wrote
        // the tab bar with the values that stood in the drawing code
        // BEFORE round THEME, and round THEME's whole promise is that no
        // painting routine names a colour -- tests/theme/rawcolour.py
        // measures exactly that and found eight. A tab bar that keeps
        // its own dark blue in a light theme is the same bug the
        // terminal window had, and THEME's script says so in its header.
        // The four slots are the ones the title bar already uses: a tab
        // IS a title bar, and the active tab is the focused one.
        var grund: u64 = wmbase.deco(state, wmlayout.DK_TITLE)
        var schrift: u64 = wmbase.deco(state, wmlayout.DK_TEXT)
        if aktiv {
            grund = wmbase.deco(state, wmlayout.DK_TITLE_ON)
            schrift = wmbase.deco(state, wmlayout.DK_TEXT_ON)
        }
        let ax0: i64 = wmbase.imax(tx, cx0 as i64)
        let ay0: i64 = wmbase.imax(ty, cy0 as i64)
        let ax1: i64 = wmbase.imin(tx + tw, cx1 as i64)
        let ay1: i64 = wmbase.imin(ty + th, cy1 as i64)
        if ax1 > ax0 && ay1 > ay0 {
            fb.fill(state, ax0 as u64, ay0 as u64, (ax1 - ax0) as u64,
                (ay1 - ay0) as u64, grund)
            // eine Trennlinie am rechten beziehungsweise unteren Rand
            let rand: u64 = wmbase.deco(state, wmlayout.DK_FRAME)
            if tw > 1 && tx + tw - 1 < cx1 as i64 && tx + tw - 1 >= cx0 as i64 {
                fb.fill(state, (tx + tw - 1) as u64, ay0 as u64, 1,
                    (ay1 - ay0) as u64, rand)
            }
            if th > 1 && ty + th - 1 < cy1 as i64 && ty + th - 1 >= cy0 as i64 {
                fb.fill(state, ax0 as u64, (ty + th - 1) as u64,
                    (ax1 - ax0) as u64, 1, rand)
            }
            if f < ttf.MAX_FONTS {
                let l: u64 = tile.first_leaf(tt(state), c)
                if l != tile.NONE {
                    let cl: u64 = tile.n_client(tt(state), l)
                    if cl != 0 && cl <= wmbase.MAX_WIN {
                        title_text(state, cl - 1, f, tx + 6,
                            ty + 3 + ttf.ascent(state, f, px), schrift,
                            ax0, ay0, ax1, ay1, tx + tw - 4)
                    }
                }
            }
        }
        idx = idx + 1
        c = tile.n_next(tt(state), c)
    }
}

fn paint_bars(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let keep: u64 = tl_cur
    tl_cur = 0
    paint_bars_one(state, cx0, cy0, cx1, cy1)
    var h: u64 = 1
    while h < HD_MAX {
        if tl_alt[h as usize] != 0 {
            tl_cur = h
            paint_bars_one(state, cx0, cy0, cx1, cy1)
        }
        h = h + 1
    }
    tl_cur = keep
}

fn paint_bars_one(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let r: u64 = tile.root(tt(state))
    if r == tile.NONE {
        return
    }
    var n: u64 = r
    var guard: u64 = 0
    while n != tile.NONE && guard <= tile.MAX_NODES {
        guard = guard + 1
        if tile.n_kind(tt(state), n) == tile.K_BOX {
            if tile.n_layout(tt(state), n) != tile.LAY_SPLIT {
                paint_bar_of(state, n, cx0, cy0, cx1, cy1)
            }
        }
        n = tile.dfs_next(tt(state), n, r)
    }
}

// ------------------------------------------- das Vorschaurechteck
//
// Beim Ziehen zeigt ein Rahmen, WO das Fenster landen wird -- nicht
// wo der Zeiger ist. Ohne das ist ein Ablegen im Baum Raten: die
// linke Haelfte eines Fensters und sein oberes Viertel sind zwei
// verschiedene Ziele, und man sieht dem Zeiger nicht an, welches
// gemeint ist.
fn paint_preview(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let x: i64 = wmlayout.gs(state, wmlayout.S_PVX) as i64
    let y: i64 = wmlayout.gs(state, wmlayout.S_PVY) as i64
    let w: i64 = wmlayout.gs(state, wmlayout.S_PVW) as i64
    let h: i64 = wmlayout.gs(state, wmlayout.S_PVH) as i64
    if w <= 0 || h <= 0 {
        return
    }
    // ROUND MERGE: 0x4C9AE8 is exactly deco_fallback(DK_FRAME_ON) --
    // round TILING copied the number instead of asking for the slot, so
    // the drag preview kept the old accent in every other theme.
    let farbe: u64 = wmbase.deco(state, wmlayout.DK_FRAME_ON)
    var k: i64 = 0
    while k < 3 {
        pv_line(state, x + k, y + k, w - 2 * k, 1, farbe, cx0, cy0, cx1, cy1)
        pv_line(state, x + k, y + h - 1 - k, w - 2 * k, 1, farbe, cx0, cy0,
            cx1, cy1)
        pv_line(state, x + k, y + k, 1, h - 2 * k, farbe, cx0, cy0, cx1, cy1)
        pv_line(state, x + w - 1 - k, y + k, 1, h - 2 * k, farbe, cx0, cy0,
            cx1, cy1)
        k = k + 1
    }
}

fn pv_line(state: u64, x: i64, y: i64, w: i64, h: i64, farbe: u64,
    cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let ax0: i64 = wmbase.imax(x, cx0 as i64)
    let ay0: i64 = wmbase.imax(y, cy0 as i64)
    let ax1: i64 = wmbase.imin(x + w, cx1 as i64)
    let ay1: i64 = wmbase.imin(y + h, cy1 as i64)
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    fb.fill(state, ax0 as u64, ay0 as u64, (ax1 - ax0) as u64,
        (ay1 - ay0) as u64, farbe)
}

fn preview_damage(state: u64) {
    if wmlayout.gs(state, wmlayout.S_PVON) == 0 {
        return
    }
    let x: i64 = wmlayout.gs(state, wmlayout.S_PVX) as i64
    let y: i64 = wmlayout.gs(state, wmlayout.S_PVY) as i64
    wmbase.damage(state, x, y, x + wmlayout.gs(state, wmlayout.S_PVW) as i64,
        y + wmlayout.gs(state, wmlayout.S_PVH) as i64)
}

fn set_preview(state: u64, x: u64, y: u64, w: u64, h: u64) {
    wmlayout.ss(state, wmlayout.S_PVX, x)
    wmlayout.ss(state, wmlayout.S_PVY, y)
    wmlayout.ss(state, wmlayout.S_PVW, w)
    wmlayout.ss(state, wmlayout.S_PVH, h)
    wmlayout.ss(state, wmlayout.S_PVON, 1)
}

// Welches Blatt liegt an dieser Stelle? Der Baum weiss es genauer als
// die Stapelreihenfolge -- er kennt auch die Stellen, an denen KEIN
// Fenster liegt, weil dort eine Reiterzeile ist.
fn leaf_at(state: u64, x: i64, y: i64) -> u64 {
    let r: u64 = tile.root(tt(state))
    if r == tile.NONE {
        return tile.NONE
    }
    var n: u64 = r
    var guard: u64 = 0
    while n != tile.NONE && guard <= tile.MAX_NODES {
        guard = guard + 1
        if tile.n_kind(tt(state), n) == tile.K_LEAF && tile.visible(tt(state), n) {
            let nx: i64 = tile.n_x(tt(state), n) as i64
            let ny: i64 = tile.n_y(tt(state), n) as i64
            if x >= nx && y >= ny {
                if x < nx + tile.n_w(tt(state), n) as i64 {
                    if y < ny + tile.n_h(tt(state), n) as i64 {
                        return n
                    }
                }
            }
        }
        n = tile.dfs_next(tt(state), n, r)
    }
    return tile.NONE
}

fn drag_begin(state: u64, i: u64) {
    // RUNDE ZIEH: das Fenster wird von jetzt an GROESSER gemalt. Der
    // Nachzug faengt bei null an -- er soll aus der Bewegung
    // entstehen und nicht aus dem Anfassen --, und die Lage des
    // letzten Ticks ist die jetzige, sonst liest der erste Tick eine
    // Geschwindigkeit, die es nie gab (das Fenster stand vorher
    // irgendwo, und die Differenz waere der ganze Weg dorthin).
    wmlayout.wsv(state, i, wmlayout.W_SWX, 0)
    wmlayout.wsv(state, i, wmlayout.W_SWY, 0)
    wmlayout.wsv(state, i, wmlayout.W_DXLAST, wmbase.win_x(state, i) as u64)
    wmlayout.wsv(state, i, wmlayout.W_DYLAST, wmbase.win_y(state, i) as u64)
    wmlayout.wsv(state, i, wmlayout.W_SWOFF, 0)
    wmanim.damage_win_lift(state, i)
    wmlayout.ss(state, wmlayout.S_DRAGT, 0)
    wmlayout.ss(state, wmlayout.S_DROPN, 0)
    wmlayout.ss(state, wmlayout.S_DROPE, 0)
    if wmlayout.wg(state, i, wmlayout.W_NODE) == 0 {
        return
    }
    // Wer gezogen wird, ist waehrenddessen NICHT im Baum -- sonst
    // rechnet der Baum ihn bei jeder Zeigerbewegung neu an seinen alten
    // Platz. So macht es i3 auch.
    save_geom(state, i)
    tile_release(state, i)
    wmlayout.ss(state, wmlayout.S_DRAGT, 1)
}

// r828: EDGE DOCKING ON A NON-PRIMARY HEAD. The tile tree is one tree for the primary head (a tree per head is a
// separate step), so on another head a window dropped at an outer edge of its work area just takes the half of that
// work area -- floating, outside the tree. S_DROPE 5..8 = left/right/top/bottom half of the head under the pointer.
// An edge shared with another head (the seam between two monitors) is not a docking edge.
fn snap_part(p: u64, e: u64) -> u64 {
    var x: u64 = hw_x(p)
    var y: u64 = hw_y(p)
    var w: u64 = hw_w(p)
    var h: u64 = hw_h(p)
    if e == 1 {
        w = w / 2
    } else if e == 2 {
        x = x + w - w / 2
        w = w / 2
    } else if e == 3 {
        h = h / 2
    } else if e == 4 {
        y = y + h - h / 2
        h = h / 2
    }
    return (x << 48) | (y << 32) | (w << 16) | h
}


// Put window `i` on the packed rect (outer size, like `fit_work` does for the work area).
fn fit_rect(state: u64, i: u64, r: u64) -> bool {
    var iw: u64 = hw_w(r)
    var ih: u64 = hw_h(r)
    if wmbase.deko(state, i) {
        if iw <= wmgeom.border(state) * 2 || ih <= wmbase.iny(state, i) + wmgeom.border(state) {
            return false
        }
        iw = iw - wmgeom.border(state) * 2
        ih = ih - wmbase.iny(state, i) - wmgeom.border(state)
    }
    if !resize_win(state, i, iw, ih) {
        return false
    }
    move_win(state, i, hw_x(r) as i64, hw_y(r) as i64)
    return true
}

// W-WIN11: SNAP OF A FLOATING WINDOW (Windows 11 behaviour). Dragging the title bar to a screen edge shows a preview and the drop
// docks the window: left / right edge = half, top edge = maximize, a corner = quarter. Codes in S_DROPE: 1 left, 2 right, 3 top
// (maximize), 9 top-left, 10 top-right, 11 bottom-left, 12 bottom-right (5..8 are the halves of a non-primary head, `snap_part`).
fn snap_rect(wk: u64, code: u64) -> u64 {
    let x: u64 = hw_x(wk)
    let y: u64 = hw_y(wk)
    let w: u64 = hw_w(wk)
    let h: u64 = hw_h(wk)
    let hw2: u64 = w / 2
    let hh2: u64 = h / 2
    if code == 1 {
        return (x << 48) | (y << 32) | (hw2 << 16) | h
    }
    if code == 2 {
        return ((x + w - hw2) << 48) | (y << 32) | (hw2 << 16) | h
    }
    if code == 9 {
        return (x << 48) | (y << 32) | (hw2 << 16) | hh2
    }
    if code == 10 {
        return ((x + w - hw2) << 48) | (y << 32) | (hw2 << 16) | hh2
    }
    if code == 11 {
        return (x << 48) | ((y + h - hh2) << 32) | (hw2 << 16) | hh2
    }
    if code == 12 {
        return ((x + w - hw2) << 48) | ((y + h - hh2) << 32) | (hw2 << 16) | hh2
    }
    return wk
}

fn snap_ok(state: u64, i: u64) -> bool {
    if fb.nosnap_an(state) || !wmbase.valid(state, i) {
        return false
    }
    if !wmbase.deko(state, i) || wmlayout.wg(state, i, wmlayout.W_LAYER) != wmlayout.L_NORMAL || wmlayout.wg(state, i, wmlayout.W_NODE) != 0 {
        return false
    }
    return true
}

// the zone code (0 = none) of the pointer on the work area `wk`; the flags say which edges are real screen edges
fn snap_zone(state: u64, wk: u64, x: i64, y: i64, nl: bool, nr: bool, nt: bool, nb: bool) -> u64 {
    let wx0: i64 = hw_x(wk) as i64
    let wy0: i64 = hw_y(wk) as i64
    let sw: i64 = hw_w(wk) as i64
    let sh: i64 = hw_h(wk) as i64
    let rand: i64 = 2 * wmgeom.uisc(state) as i64
    var cs: i64 = 64 * wmgeom.uisc(state) as i64
    if cs > sh / 4 {
        cs = sh / 4
    }
    if x < wx0 + rand && nl {
        if y < wy0 + cs {
            return 9
        }
        if y >= wy0 + sh - cs {
            return 11
        }
        return 1
    }
    if x >= wx0 + sw - rand && nr {
        if y < wy0 + cs {
            return 10
        }
        if y >= wy0 + sh - cs {
            return 12
        }
        return 2
    }
    if y < wy0 + rand && nt {
        if x < wx0 + cs {
            return 9
        }
        if x >= wx0 + sw - cs {
            return 10
        }
        return 3
    }
    if y >= wy0 + sh - rand && nb {
        if x < wx0 + cs {
            return 11
        }
        if x >= wx0 + sw - cs {
            return 12
        }
    }
    return 0
}

fn float_hover(state: u64, i: u64, x: i64, y: i64) {
    preview_damage(state)
    wmlayout.ss(state, wmlayout.S_PVON, 0)
    wmlayout.ss(state, wmlayout.S_DROPE, 0)
    if !snap_ok(state, i) {
        return
    }
    var wk: u64 = (wmlayout.gs(state, wmlayout.S_WORK_X) << 48) | (wmlayout.gs(state, wmlayout.S_WORK_Y) << 32) | (wmlayout.gs(state, wmlayout.S_WORK_W) << 16) | wmlayout.gs(state, wmlayout.S_WORK_H)
    var nl: bool = true
    var nr: bool = true
    var nt: bool = true
    var nb: bool = true
    if hd_multi(state) {
        let hd: u64 = hd_at(state, x, y)
        if hd >= HD_MAX {
            return
        }
        wk = head_work(state, hd)
        let hx: i64 = hd_x(state, hd) as i64
        let hy: i64 = hd_y(state, hd) as i64
        nl = hd_at(state, hx - 1, y) == HD_MAX
        nr = hd_at(state, hx + hd_w(state, hd) as i64, y) == HD_MAX
        nt = hd_at(state, x, hy - 1) == HD_MAX
        nb = hd_at(state, x, hy + hd_h(state, hd) as i64) == HD_MAX
    }
    let code: u64 = snap_zone(state, wk, x, y, nl, nr, nt, nb)
    if code == 0 {
        return
    }
    let r: u64 = snap_rect(wk, code)
    wmlayout.ss(state, wmlayout.S_DROPE, code)
    set_preview(state, hw_x(r), hw_y(r), hw_w(r), hw_h(r))
    preview_damage(state)
}

// the drop: dock the window on the preview rectangle (the way back is saved like `maximize` does, once)
fn float_drop(state: u64, i: u64, code: u64) {
    if !snap_ok(state, i) {
        return
    }
    let r: u64 = (wmlayout.gs(state, wmlayout.S_PVX) << 48) | (wmlayout.gs(state, wmlayout.S_PVY) << 32) | (wmlayout.gs(state, wmlayout.S_PVW) << 16) | wmlayout.gs(state, wmlayout.S_PVH)
    let f: u64 = wmlayout.wg(state, i, wmlayout.W_FLAGS)
    if code == 3 {
        let _m: bool = maximize(state, i, true)
        let _w: bool = fit_work(state, i)
        snap_say(state, i, code)
        return
    }
    if (f & wmlayout.F_MAXIMIZED) == 0 {
        let sx: u64 = ((wmbase.win_x(state, i) + 4096) as u64) & 0xFFFF
        let sy: u64 = ((wmbase.win_y(state, i) + 4096) as u64) & 0xFFFF
        wmlayout.wsv(state, i, wmlayout.W_SAVE, (sx << 48) | (sy << 32)
            | ((wmlayout.wg(state, i, wmlayout.W_W) & 0xFFFF) << 16)
            | (wmlayout.wg(state, i, wmlayout.W_H) & 0xFFFF))
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, f | wmlayout.F_MAXIMIZED)
    }
    if !fit_rect(state, i, r) {
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, f)
        return
    }
    wmbase.damage_all(state)
    snap_say(state, i, code)
}

// W-WIN11 gate line: where a snapped window ended up -- `wm: snap id= zone= x= y= w= h=` (zone: 1 left, 2 right, 3 top = maximize, 9..12 corners)
fn snap_say(state: u64, i: u64, code: u64) {
    var s_sn: [u8; 13] = "wm: snap id=\0"
    var s_snz: [u8; 7] = " zone=\0"
    var s_snx: [u8; 4] = " x=\0"
    var s_sny: [u8; 4] = " y=\0"
    var s_snw: [u8; 4] = " w=\0"
    var s_snh: [u8; 4] = " h=\0"
    serial.puts((&s_sn[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_ID))
    serial.puts((&s_snz[0]) as u64)
    serial.dec(code)
    serial.puts((&s_snx[0]) as u64)
    serial.dec(wmbase.win_x(state, i) as u64)
    serial.puts((&s_sny[0]) as u64)
    serial.dec(wmbase.win_y(state, i) as u64)
    serial.puts((&s_snw[0]) as u64)
    serial.dec(wmbase.outer_w(state, i))
    serial.puts((&s_snh[0]) as u64)
    serial.dec(wmbase.outer_h(state, i))
    serial.nl()
}

// a maximized / snapped window that is dragged far enough comes back to its old size, the pointer keeping its place on the title bar
fn float_unmax(state: u64, i: u64, x: i64, y: i64) -> bool {
    if fb.nosnap_an(state) || !wmbase.valid(state, i) || wmlayout.gs(state, wmlayout.S_TILE) != 0 || wmlayout.wg(state, i, wmlayout.W_NODE) != 0 {
        return false
    }
    if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED) == 0 || wmlayout.wg(state, i, wmlayout.W_LAYER) != wmlayout.L_NORMAL {
        return false
    }
    if (wmlayout.wg(state, i, wmlayout.W_SAVE) & 0xFFFFFFFF) == 0 {
        return false
    }
    let ow: i64 = wmbase.outer_w(state, i) as i64
    let off: i64 = x - wmbase.win_x(state, i)
    let dy: i64 = wmlayout.gs(state, wmlayout.S_DRAGY) as i64
    if !maximize(state, i, false) {
        return false
    }
    let nw: i64 = wmbase.outer_w(state, i) as i64
    var nx: i64 = x
    if ow > 0 {
        nx = x - off * nw / ow
    }
    move_win(state, i, nx, y - dy)
    wmlayout.ss(state, wmlayout.S_DRAGX, (x - wmbase.win_x(state, i)) as u64)
    wmbase.damage_all(state)
    return true
}

fn drag_hover(state: u64, i: u64, x: i64, y: i64) {
    if wmlayout.gs(state, wmlayout.S_TILE) == 0 {
        float_hover(state, i, x, y)
        return
    }
    preview_damage(state)
    wmlayout.ss(state, wmlayout.S_PVON, 0)
    wmlayout.ss(state, wmlayout.S_DROPN, 0)
    wmlayout.ss(state, wmlayout.S_DROPE, 0)
    // r826: edge docking works on the primary head's work area only; on another head there is no preview and no drop.
    var wx0: i64 = wmlayout.gs(state, wmlayout.S_WORK_X) as i64
    var wy0: i64 = wmlayout.gs(state, wmlayout.S_WORK_Y) as i64
    var sw: i64 = wmlayout.gs(state, wmlayout.S_WORK_W) as i64
    var sh: i64 = wmlayout.gs(state, wmlayout.S_WORK_H) as i64
    // r839: with several heads the head under the pointer is the drop target (its work area, its tree); an edge that
    // touches the next head (the seam) is no docking edge
    var nl: bool = true
    var nr: bool = true
    var nt: bool = true
    var nb: bool = true
    tl_drop_tag = 0
    if hd_multi(state) {
        let hd: u64 = hd_at(state, x, y)
        if hd >= HD_MAX {
            return
        }
        let hp: u64 = head_work(state, hd)
        wx0 = hw_x(hp) as i64
        wy0 = hw_y(hp) as i64
        sw = hw_w(hp) as i64
        sh = hw_h(hp) as i64
        let hx: i64 = hd_x(state, hd) as i64
        let hy: i64 = hd_y(state, hd) as i64
        nl = hd_at(state, hx - 1, y) == HD_MAX
        nr = hd_at(state, hx + hd_w(state, hd) as i64, y) == HD_MAX
        nt = hd_at(state, x, hy - 1) == HD_MAX
        nb = hd_at(state, x, hy + hd_h(state, hd) as i64) == HD_MAX
        tl_drop_tag = tl_tag_head(state, hd)
    }
    // DELL ROUND (04.10.2026): the snap strip was 16 px, so a window that
    // was only pushed a little over the edge snapped to half the screen
    // (or jumped back). Now 2 px at scale 1: the pointer must be AT the
    // screen edge.
    var rand: i64 = 2 * wmgeom.uisc(state) as i64
    if fb.winfix_aus(state) {
        rand = 16
    }
    // 1. AM BILDSCHIRMRAND: die Windows-artige Schnellablage. Sie ist
    //    ein Sonderfall des Baumes und kein zweites System.
    if x < wx0 + rand && nl {
        wmlayout.ss(state, wmlayout.S_DROPE, 1)
        set_preview(state, wx0 as u64, wy0 as u64, (sw / 2) as u64,
            sh as u64)
        preview_damage(state)
        return
    }
    if x >= wx0 + sw - rand && nr {
        wmlayout.ss(state, wmlayout.S_DROPE, 2)
        set_preview(state, (wx0 + sw - sw / 2) as u64, wy0 as u64,
            (sw / 2) as u64, sh as u64)
        preview_damage(state)
        return
    }
    if y < wy0 + rand && nt {
        wmlayout.ss(state, wmlayout.S_DROPE, 3)
        set_preview(state, wx0 as u64, wy0 as u64, sw as u64,
            (sh / 2) as u64)
        preview_damage(state)
        return
    }
    if y >= wy0 + sh - rand && nb {
        wmlayout.ss(state, wmlayout.S_DROPE, 4)
        set_preview(state, wx0 as u64, (wy0 + sh - sh / 2) as u64,
            sw as u64, (sh / 2) as u64)
        preview_damage(state)
        return
    }
    // 2. AUF EINEM ANDEREN FENSTER: das Viertel, in dem der Zeiger
    //    steht, sagt die Seite. Die Mitte heisst REITER.
    // the tree of that head (none yet: nothing to drop onto)
    if tl_drop_tag != 0 && tl_alt[tl_drop_tag as usize] == 0 {
        return
    }
    tl_sel(state, tl_drop_tag)
    let n: u64 = leaf_at(state, x, y)
    if n == tile.NONE {
        return
    }
    let nx: u64 = tile.n_x(tt(state), n)
    let ny: u64 = tile.n_y(tt(state), n)
    let w: u64 = tile.n_w(tt(state), n)
    let h: u64 = tile.n_h(tt(state), n)
    let fx: u64 = (x - nx as i64) as u64
    let fy: u64 = (y - ny as i64) as u64
    var page: u64 = 4
    if fx * 4 < w {
        page = tile.D_LEFT
    } else {
        if fx * 4 >= w * 3 {
            page = tile.D_RIGHT
        } else {
            if fy * 4 < h {
                page = tile.D_UP
            } else {
                if fy * 4 >= h * 3 {
                    page = tile.D_DOWN
                }
            }
        }
    }
    wmlayout.ss(state, wmlayout.S_DROPN, n + 1)
    wmlayout.ss(state, wmlayout.S_DROPS, page)
    if page == tile.D_LEFT {
        set_preview(state, nx, ny, w / 2, h)
    }
    if page == tile.D_RIGHT {
        set_preview(state, nx + w - w / 2, ny, w / 2, h)
    }
    if page == tile.D_UP {
        set_preview(state, nx, ny, w, h / 2)
    }
    if page == tile.D_DOWN {
        set_preview(state, nx, ny + h - h / 2, w, h / 2)
    }
    if page == 4 {
        set_preview(state, nx, ny, w, h)
    }
    preview_damage(state)
}

// ============================================== RUNDE GLAS (fix-r4-2)
// DIE ENDLAGE LIEGT AUF DER ARBEITSFLAECHE -- GEZOGEN WIRD UEBERALL.
//
// Beim ZIEHEN darf ein Fenster unter die Leiste wandern; genau daran
// misst die Abnahme, dass die Leiste ihren Untergrund neu mischt
// (`unter_leiste_messen`, Abschnitt 11f). Beim LOSLASSEN darf es dort
// nicht liegen bleiben: was unter der Leiste endet, ist nicht mehr
// anzufassen, und was unter der unteren Schirmkante endet, ist gar
// nicht mehr da. Auf der Aufnahme 15 der Runde hing das untere Drittel
// des Fensters ausserhalb des Schirms -- `shotcheck.py` zaehlte dreizehn
// Beschriftungen als `ausserhalb`, und der Reglerblock der Seite
// "Darstellung" war nicht mehr zu sehen.
//
// Geklemmt wird die AEUSSERE Huelle (Rahmen und Titelzeile mitgezaehlt)
// auf die Arbeitsflaeche, und zwar nur nach unten und rechts bzw. oben
// und links -- die Groesse des Fensters bleibt unangetastet. Ist das
// Fenster groesser als die Arbeitsflaeche, gewinnt die obere linke
// Ecke: lieber unten abgeschnitten als oben, denn oben sitzt die
// Titelzeile, an der man es wieder anfassen kann.
fn drag_klemmen(state: u64, i: u64) {
    if !wmbase.valid(state, i) {
        return
    }
    let wx0: i64 = wmbase.win_x(state, i)
    let wy0: i64 = wmbase.win_y(state, i)
    let aw: i64 = wmbase.outer_w(state, i) as i64
    let ah: i64 = wmbase.outer_h(state, i) as i64
    // r826: the work area of the window's HOME head (the plain one on a single screen)
    let kwk: u64 = win_work(state, i)
    let ax0: i64 = hw_x(kwk) as i64
    let ay0: i64 = hw_y(kwk) as i64
    let ax1: i64 = ax0 + hw_w(kwk) as i64
    let ay1: i64 = ay0 + hw_h(kwk) as i64
    // DELL ROUND (04.10.2026, Justin): "a window pushed a little over the
    // screen edge jumps right back". The old rule kept the WHOLE window
    // on the work area. Now it may stick out on the left, right and
    // bottom: it only has to keep a strip it can be grabbed by --
    //   * the title bar must stay on the work area vertically (top
    //     edge >= work top, top edge <= work bottom - title bar);
    //   * horizontally at least VIS_MIN px of the window stay in sight.
    // A window that is fully inside is never touched.
    var vis: i64 = (VIS_MIN0 * wmgeom.uisc(state)) as i64
    if vis > aw {
        vis = aw
    }
    var tb: i64 = wmgeom.title_h(state) as i64
    if fb.winfix_aus(state) {
        // counter-proof: the old rule, the whole window stays on the work area
        vis = aw
        tb = ah
    }
    var nx: i64 = wx0
    var ny: i64 = wy0
    if nx > ax1 - vis {
        nx = ax1 - vis
    }
    if nx + aw < ax0 + vis {
        nx = ax0 + vis - aw
    }
    if ny > ay1 - tb {
        ny = ay1 - tb
    }
    if ny < ay0 {
        ny = ay0
    }
    if nx == wx0 && ny == wy0 {
        return
    }
    move_win(state, i, nx, ny)
    // UND ES WIRD GESAGT. Eine Endlage, die der Server selbst gesetzt
    // hat, ist fuer jeden Laeufer sonst ein Raetsel: er hat nach
    // `400,600` gezogen und findet das Fenster bei `400,512`.
    // Und die Stelle VOR dem Klemmen steht daneben: aus ihr rechnet
    // `tools/themestore/run.sh` die Schnittflaeche mit der Leiste noch
    // einmal nach, und zwar auf dem Wirt. Ohne sie gaebe es fuer die
    // Flaeche, die der Server waehrend des Zuges gesehen hat, nur noch
    // seine eigene Zahl -- und eine Zahl, die sich selbst bestaetigt,
    // ist in dieser Abnahme keine.
    var s_k: [u8; 17] = "wm: geklemmt id=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_vx: [u8; 7] = " vorx=\0"
    var s_vy: [u8; 7] = " vory=\0"
    var s_aw: [u8; 4] = " w=\0"
    var s_ah: [u8; 4] = " h=\0"
    serial.puts((&s_k[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_ID))
    serial.puts((&s_x[0]) as u64)
    serial.dec(nx as u64)
    serial.puts((&s_y[0]) as u64)
    serial.dec(ny as u64)
    serial.puts((&s_vx[0]) as u64)
    serial.dec(wx0 as u64)
    serial.puts((&s_vy[0]) as u64)
    serial.dec(wy0 as u64)
    serial.puts((&s_aw[0]) as u64)
    serial.dec(aw as u64)
    serial.puts((&s_ah[0]) as u64)
    serial.dec(ah as u64)
    serial.nl()
}

// UND DER RUMPF WIRD SCHMUTZIG -- BEIM LOSLASSEN, NICHT BEI JEDEM
// MILLIMETER.
//
// Ein verschobenes Fenster behaelt seinen Puffer, der Server malt ihn
// an der neuen Stelle, und bis hierher erfuhr das PROGRAMM davon
// nichts. Es meldete seine Beschriftungen deshalb weiter zu dem
// Ursprung, an dem es zuletzt gemalt hatte -- auf der Aufnahme 15 der
// Runde lagen sie 590 Bildpunkte ueber ihrer wirklichen Stelle, und
// `shotcheck.py` zaehlte acht leere Beschriftungen, wo in Wahrheit
// keine fehlte. Der Nachtrag zu 8.1 hat den Ursprung in
// `wlib.flush_win` nachfragen lassen; gerufen wird `flush_win` aber
// nur, wenn das Programm ueberhaupt malt.
//
// Also bekommt es nach dem Zug einen Grund dazu: dasselbe Ereignis,
// mit dem eine Groessenaenderung ankommt, mit der UNVERAENDERTEN
// Groesse. `wlib` macht daraufhin den ganzen Rumpf schmutzig, malt ihn
// und meldet dabei jedes Rechteck zu der Stelle, an der das Fenster
// jetzt wirklich steht.
//
// HIER und nicht in `move_win`: `move_win` laeuft bei jeder
// Zeigerbewegung des Zuges, das waeren dreissig Vollanstriche je
// Sekunde fuer eine Stelle, die sich im naechsten Millimeter wieder
// aendert.
fn rumpf_neu(state: u64, i: u64) {
    if !wmbase.valid(state, i) {
        return
    }
    ev_push(state, i, wmlayout.E_RESIZE, wmlayout.wg(state, i, wmlayout.W_W), wmlayout.wg(state, i, wmlayout.W_H), 0)
    wmdamage.damage_win(state, i)
}

fn drag_end(state: u64, i: u64, x: i64, y: i64) {
    // RUNDE ZIEH: LOSGELASSEN. Das Fenster steht ab sofort wieder in
    // seiner wahren Groesse; was noch laeuft, ist der Nachzug, der
    // gegen null pendelt (`swing_tick`, Zweig "nicht mehr gezogen").
    // `W_SWOFF` haelt fest, dass da noch etwas auszupendeln ist --
    // auch wenn der Versatz in diesem Augenblick zufaellig 0 ist.
    wmlayout.wsv(state, i, wmlayout.W_SWOFF, kstate.get(state, kstate.TICKS) + 1)
    wmanim.damage_win_lift(state, i)
    preview_damage(state)
    wmlayout.ss(state, wmlayout.S_PVON, 0)
    drag_klemmen(state, i)
    // DELL ROUND: where the window ended up (after the clamp), so a runner
    // can tell "sticks out a little" from "jumped back".
    var s_ab: [u8; 18] = "wm: abgelegt id=\0\0"
    var s_abx: [u8; 4] = " x=\0"
    var s_aby: [u8; 4] = " y=\0"
    var s_abw: [u8; 4] = " w=\0"
    var s_abh: [u8; 4] = " h=\0"
    serial.puts((&s_ab[0]) as u64)
    serial.dec(wmlayout.wg(state, i, wmlayout.W_ID))
    serial.puts((&s_abx[0]) as u64)
    serial.dec(wmbase.win_x(state, i) as u64)
    serial.puts((&s_aby[0]) as u64)
    serial.dec(wmbase.win_y(state, i) as u64)
    serial.puts((&s_abw[0]) as u64)
    serial.dec(wmbase.outer_w(state, i))
    serial.puts((&s_abh[0]) as u64)
    serial.dec(wmbase.outer_h(state, i))
    serial.nl()
    rumpf_neu(state, i)
    if wmlayout.gs(state, wmlayout.S_TILE) == 0 {
        let fe: u64 = wmlayout.gs(state, wmlayout.S_DROPE)
        if fe != 0 {
            float_drop(state, i, fe)
        }
        wmlayout.ss(state, wmlayout.S_DROPE, 0)
        wmlayout.ss(state, wmlayout.S_DRAGT, 0)
        return
    }
    let e: u64 = wmlayout.gs(state, wmlayout.S_DROPE)
    if e != 0 {
        let _u: bool = tl_use(state, tl_drop_tag)
        let n: u64 = tile.insert(tt(state), i + 1)
        if n != tile.NONE {
            wmlayout.wsv(state, i, wmlayout.W_NODE, nd_val(n))
            var wo: u64 = tile.SNAP_LEFT
            if e == 2 {
                wo = tile.SNAP_RIGHT
            }
            if e == 3 {
                wo = tile.SNAP_TOP
            }
            if e == 4 {
                wo = tile.SNAP_BOTTOM
            }
            tile.snap(tt(state), n, wo)
            tile_apply(state)
            wmbase.damage_all(state)
        }
        wmlayout.ss(state, wmlayout.S_DRAGT, 0)
        wmlayout.ss(state, wmlayout.S_DROPE, 0)
        return
    }
    let d: u64 = wmlayout.gs(state, wmlayout.S_DROPN)
    if d != 0 {
        let ziel: u64 = d - 1
        let page: u64 = wmlayout.gs(state, wmlayout.S_DROPS)
        tl_sel(state, tl_drop_tag)
        var n: u64 = tile.NONE
        if page == 4 {
            n = tile.insert_at(tt(state), ziel, tile.D_RIGHT, i + 1)
            if n != tile.NONE {
                tile.set_layout(tt(state), n, tile.LAY_TABBED)
            }
        } else {
            n = tile.insert_at(tt(state), ziel, page, i + 1)
        }
        if n != tile.NONE {
            wmlayout.wsv(state, i, wmlayout.W_NODE, nd_val(n))
            tile_apply(state)
            wmbase.damage_all(state)
        }
    } else {
        if wmlayout.gs(state, wmlayout.S_DRAGT) != 0 {
            tile_take(state, i)
            wmbase.damage_all(state)
        }
    }
    wmlayout.ss(state, wmlayout.S_DRAGT, 0)
    wmlayout.ss(state, wmlayout.S_DROPN, 0)
}

// Der Griff unten rechts an einem GEKACHELTEN Fenster verschiebt das
// Verhaeltnis am inneren Knoten -- nicht die Groesse des Fensters. Alles
// andere waere eine Luecke.
fn tile_drag_resize(state: u64, i: u64, x: i64, y: i64) {
    let nd: u64 = wmlayout.wg(state, i, wmlayout.W_NODE)
    if nd == 0 {
        return
    }
    tl_sel(state, nd_tag(nd))
    let n: u64 = nd_node(nd)
    let p: u64 = tile.n_parent(tt(state), n)
    if p == tile.NONE || tile.n_layout(tt(state), p) != tile.LAY_SPLIT {
        return
    }
    var total: u64 = tile.n_h(tt(state), p)
    var will: i64 = y - tile.n_y(tt(state), n) as i64
    var ist: i64 = tile.n_h(tt(state), n) as i64
    if tile.n_dir(tt(state), p) == tile.DIR_H {
        total = tile.n_w(tt(state), p)
        will = x - tile.n_x(tt(state), n) as i64
        ist = tile.n_w(tt(state), n) as i64
    }
    if total == 0 {
        return
    }
    let dpx: i64 = will - ist
    if dpx == 0 {
        return
    }
    let d: i64 = dpx * tile.FRAC_ONE as i64 / total as i64
    if d == 0 {
        return
    }
    if tile.resize_at(tt(state), n, d) {
        tile_apply(state)
        damage_tile(state)
    }
}

// -------------------------------------------------- die Tastenkuerzel

fn hot_take_raw(state: u64) -> u64 {
    let kopf: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_HHEAD)
    let schwanz: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_HTAIL)
    if kopf == schwanz {
        return 0
    }
    let p: u64 = state + kstate.K11_OFF + kstate.KB_HOT + (schwanz % 16) * 2
    let c: u64 = kstate.get8(p)
    let m: u64 = kstate.get8(p + 1)
    kstate.set(state, kstate.K11_OFF + kstate.KB_HTAIL, schwanz + 1)
    return (m << 8) | c
}

// W1 (hotkeys): put a floating window on the left/right half of its work area. The way back (position + size) is saved
// the way `maximize` saves it and the window carries F_MAXIMIZED, so Win+Down (maximize off) restores it.
fn snap_half(state: u64, i: u64, right: bool) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    let f: u64 = wmlayout.wg(state, i, wmlayout.W_FLAGS)
    if (f & wmlayout.F_MAXIMIZED) == 0 {
        let sx: u64 = ((wmbase.win_x(state, i) + 4096) as u64) & 0xFFFF
        let sy: u64 = ((wmbase.win_y(state, i) + 4096) as u64) & 0xFFFF
        wmlayout.wsv(state, i, wmlayout.W_SAVE, (sx << 48) | (sy << 32)
            | ((wmlayout.wg(state, i, wmlayout.W_W) & 0xFFFF) << 16)
            | (wmlayout.wg(state, i, wmlayout.W_H) & 0xFFFF))
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, f | wmlayout.F_MAXIMIZED)
    }
    let hwk: u64 = win_work(state, i)
    let half: u64 = hw_w(hwk) / 2
    var iw: u64 = half
    var ih: u64 = hw_h(hwk)
    if wmbase.deko(state, i) {
        if iw <= wmgeom.border(state) * 2 || ih <= wmbase.iny(state, i) + wmgeom.border(state) {
            wmlayout.wsv(state, i, wmlayout.W_FLAGS, f)
            return false
        }
        iw = iw - wmgeom.border(state) * 2
        ih = ih - wmbase.iny(state, i) - wmgeom.border(state)
    }
    if !resize_win(state, i, iw, ih) {
        wmlayout.wsv(state, i, wmlayout.W_FLAGS, f)
        return false
    }
    var nx: u64 = hw_x(hwk)
    if right {
        nx = nx + half
    }
    move_win(state, i, nx as i64, hw_y(hwk) as i64)
    return true
}

fn snap_near(a: i64, b: i64) -> bool {
    var d: i64 = a - b
    if d < 0 {
        d = 0 - d
    }
    return d <= 2
}

fn snap_code_of(state: u64, i: u64) -> u64 {
    if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED) == 0 {
        return 0
    }
    let wk: u64 = win_work(state, i)
    var n: u64 = 0
    while n < 6 {
        var c: u64 = n + 7
        if n < 2 {
            c = n + 1
        }
        let r: u64 = snap_rect(wk, c)
        if snap_near(wmbase.win_x(state, i), hw_x(r) as i64) && snap_near(wmbase.win_y(state, i), hw_y(r) as i64)
            && snap_near(wmbase.outer_w(state, i) as i64, hw_w(r) as i64) && snap_near(wmbase.outer_h(state, i) as i64, hw_h(r) as i64) {
            return c
        }
        n = n + 1
    }
    return 0
}

fn snap_key_target(cur: u64, key: u64) -> u64 {
    if key == 0x83 {
        if cur == 1 {
            return 9
        }
        if cur == 2 {
            return 10
        }
        if cur == 11 {
            return 1
        }
        if cur == 12 {
            return 2
        }
    }
    if key == 0x84 {
        if cur == 1 {
            return 11
        }
        if cur == 2 {
            return 12
        }
        if cur == 9 {
            return 1
        }
        if cur == 10 {
            return 2
        }
    }
    if key == 0x81 {
        if cur == 10 {
            return 9
        }
        if cur == 12 {
            return 11
        }
    }
    if key == 0x82 {
        if cur == 9 {
            return 10
        }
        if cur == 11 {
            return 12
        }
    }
    return 0
}

fn snap_to_code(state: u64, i: u64, code: u64) -> bool {
    if code == 1 || code == 2 {
        let ok: bool = snap_half(state, i, code == 2)
        if ok {
            snap_say(state, i, code)
        }
        return ok
    }
    if !fit_rect(state, i, snap_rect(win_work(state, i), code)) {
        return false
    }
    wmbase.damage_all(state)
    snap_say(state, i, code)
    return true
}

// W1 (hotkeys): Win+Left/Right = snap to a half, Win+Up = maximize, Win+Down = restore (tiled/maximized) or minimize.
// A second press while snapped moves between half and quarter (Windows 11): half + Up/Down = top/bottom quarter, quarter + Left/Right = the other side, quarter + opposite vertical = half again.
fn win_arrow(state: u64, key: u64) -> bool {
    let i: u64 = wmbase.focus(state)
    if i >= wmbase.MAX_WIN {
        return false
    }
    if !wmbase.deko(state, i) || wmlayout.wg(state, i, wmlayout.W_LAYER) != wmlayout.L_NORMAL || !wmgate.darf(state, i) {
        return false
    }
    if wmlayout.wg(state, i, wmlayout.W_NODE) == 0 {
        let tgt: u64 = snap_key_target(snap_code_of(state, i), key)
        if tgt != 0 && snap_to_code(state, i, tgt) {
            return true
        }
    }
    if key == 0x81 || key == 0x82 {
        if wmlayout.wg(state, i, wmlayout.W_NODE) != 0 {
            let _t: bool = tile_float(state, i)
        }
        return snap_half(state, i, key == 0x82)
    }
    if key == 0x83 {
        if wmlayout.wg(state, i, wmlayout.W_NODE) != 0 {
            let _f: bool = tile_float(state, i)
        }
        if !maximize(state, i, true) {
            return false
        }
        // a half-snapped window carries F_MAXIMIZED too (it saves the way back there): grow it to the whole work area
        return fit_work(state, i)
    }
    if key == 0x84 {
        if wmlayout.wg(state, i, wmlayout.W_NODE) != 0 {
            return tile_float(state, i)
        }
        if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED) != 0 {
            return maximize(state, i, false)
        }
        return minimize_anim(state, i)
    }
    return false
}

fn hotkeys(state: u64) -> u64 {
    var n: u64 = 0
    var weiter: bool = true
    var guard: u64 = 0
    while weiter && guard < 16 {
        guard = guard + 1
        let v: u64 = hot_take_raw(state)
        if v == 0 {
            weiter = false
        } else {
            n = n + 1
            wmlayout.ss(state, wmlayout.S_HOTS, wmlayout.gs(state, wmlayout.S_HOTS) + 1)
            // r382 LOCK SEAL: WHILE THE SCREEN IS LOCKED A SHORTCUT DOES
            // NOTHING -- not Alt+Tab (raised and focused a window behind
            // the lock), not close (destroyed it), not full screen, snap,
            // tile; and no plugin hears it. The key is taken off the ring
            // and thrown away, and the line below says so.
            if wmgate.sperre_an(state) {
                var s_hl: [u8; 20] = "wm: hot gesperrt c=\0"
                var s_hn: [u8; 6] = " mod=\0"
                serial.puts((&s_hl[0]) as u64)
                serial.dec(v & 0xFF)
                serial.puts((&s_hn[0]) as u64)
                serial.dec((v >> 8) & 0xFF)
                serial.nl()
            } else
            if sw_open != 0 && (v & 0xFF) == 27 {
                sw_cancel(state)
            } else
            // FPS-OV: Ctrl+Alt+F (mods 5 = Alt + Ctrl, 7 with Shift) switches the frame-rate overlay
            if ((v & 0xFF) == 102 || (v & 0xFF) == 70) && ((v >> 8) & 0xFD) == 5 {
                wmoverlay.fps_hotkey(state)
            } else
            // REPAINT-1: Ctrl+Alt+R recomposes the whole screen from the window buffers (reference picture of the stale-pixel gate)
            if ((v & 0xFF) == 114 || (v & 0xFF) == 82) && ((v >> 8) & 0xFD) == 5 {
                wmoverlay.repaint_hotkey(state)
            } else
            // W1 (hotkeys): WIN+ARROWS (mod 8) -- the focused window snaps / maximizes / restores, before any binding.
            if ((v >> 8) & 0xFF) == 8 {
                let wa: bool = win_arrow(state, v & 0xFF)
                var s_wh: [u8; 18] = "wm: winarrow key=\0"
                var s_wg: [u8; 8] = " getan=\0"
                serial.puts((&s_wh[0]) as u64)
                serial.dec(v & 0xFF)
                serial.puts((&s_wg[0]) as u64)
                if wa {
                    serial.dec(1)
                } else {
                    serial.dec(0)
                }
                serial.nl()
            } else
            // RUNDE WMPLUGIN: DAS PLUGIN KOMMT VOR DER BINDUNG DES
            // KACHELBAUMS. Wer ein Kuerzel belegt hat, bekommt es --
            // und `tile_action` laeuft dafuer gar nicht erst an. Sonst
            // taete Alt+2 zweierlei auf einmal, je nachdem, was gerade
            // geladen ist, und das ist genau die Art Ueberraschung, die
            // ein Erweiterungssystem nicht haben darf.
            if wmplug.key_owner(state, v & 0xFF, (v >> 8) & 0xFF)
                < wmplug.MAX_PLUG {
                wmplug.notify(state, wmplug.E_KEY, v & 0xFF,
                    (v >> 8) & 0xFF, 0)
                wmlayout.ss(state, wmlayout.S_KPLUG, wmlayout.gs(state, wmlayout.S_KPLUG) + 1)
                var s_ph: [u8; 17] = "wm: plughot c=\0\0\0"
                var s_pj: [u8; 6] = " mod=\0"
                serial.puts((&s_ph[0]) as u64)
                serial.dec(v & 0xFF)
                serial.puts((&s_pj[0]) as u64)
                serial.dec((v >> 8) & 0xFF)
                serial.nl()
            } else {
                var act: u64 = tile.bind_lookup(state, v & 0xFF, (v >> 8) & 0xFF)
                // W1d: Alt+Shift+Tab goes backwards through the switcher (only while Alt+Tab is the stock next-window binding)
                if act == tile.A_NONE && (v & 0xFF) == 9 && ((v >> 8) & 0xFF) == 3
                    && tile.bind_lookup(state, 9, 1) == tile.A_NEXT_WIN {
                    act = ACT_PREV_WIN
                }
                // RUNDE TUERSCHLOSS: WAS DER RING HERGAB UND WAS DARAUS
                // WURDE. Drei Zahlen, und sie trennen die drei Faelle, die
                // sonst gleich aussehen: Taste kam nicht an (keine Zeile),
                // Taste kam an, aber keine Bindung (act=0), Bindung da, aber
                // die Handlung tat nichts (getan=0).
                var s_hk: [u8; 12] = "wm: hot c=\0\0"
                var s_hm: [u8; 6] = " mod=\0"
                var s_ha: [u8; 6] = " act=\0"
                serial.puts((&s_hk[0]) as u64)
                serial.dec(v & 0xFF)
                serial.puts((&s_hm[0]) as u64)
                serial.dec((v >> 8) & 0xFF)
                serial.puts((&s_ha[0]) as u64)
                serial.dec(act)
                // DIE ZEILE WIRD ZUERST FERTIG. `tile_action` ruft
                // `set_focus`, und das schreibt seit dieser Runde selbst auf
                // die Leitung -- mitten in diese Zeile hinein. Gemessen:
                //     wm: hot c=9 mod=1 act=30wm: fokus id=7 vor=15
                // Beide Angaben stimmen, aber `act=30` und die Fokuszeile
                // kleben aneinander, und ein Muster, das auf das Zeilenende
                // wartet, findet keines von beiden. Also: Zeilenumbruch vor
                // der Handlung, das Ergebnis kommt in eine eigene Zeile.
                serial.nl()
                let getan: bool = tile_action(state, act)
                var s_hr: [u8; 15] = "wm: hot getan=\0"
                serial.puts((&s_hr[0]) as u64)
                if getan {
                    serial.dec(1)
                } else {
                    serial.dec(0)
                }
                serial.nl()
                if getan {
                    wmlayout.ss(state, wmlayout.S_ACTS, wmlayout.gs(state, wmlayout.S_ACTS) + 1)
                }
            }
        }
    }
    return n
}

// RUNDE TUERSCHLOSS: DAS NAECHSTE FENSTER, das ein Mensch meint.
//
// WELCHE FENSTER MITZAEHLEN. Nicht jedes Fenster ist eines, zu dem man
// wechseln will: der Schreibtisch (`L_DESK`) ist der Hintergrund, die
// Taskleiste (`L_TOP`) ist Bedienung, und ein verborgenes (`F_HIDDEN`)
// steht nicht auf dem Schirm. Es bleiben die gewoehnlichen Anwendungen
// auf `L_NORMAL` -- genau die, die auch eine Titelleiste tragen.
//
// WARUM IM KREIS AB DEM FOKUS und nicht immer von vorn: sonst wechselt
// Alt+Tab bei drei Fenstern ewig zwischen den ersten beiden. Der Ring
// laeuft `von+1 .. von+MAX_WIN` und rechnet modulo -- damit kommt jedes
// Fenster genau einmal vorbei, und das eigene zuletzt.
//
// Der Rueckgabewert sagt, ob sich WIRKLICH etwas geaendert hat: bei
// einem einzigen Fenster ist Alt+Tab folgenlos, und das ist kein
// Fehler, sondern die Wahrheit.
fn wechselbar(state: u64, i: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) != 0 {
        return false
    }
    return wmlayout.wg(state, i, wmlayout.W_LAYER) == wmlayout.L_NORMAL
}

fn next_window(state: u64, von: u64) -> bool {
    var k: u64 = 1
    while k <= wmbase.MAX_WIN {
        let j: u64 = (von + k) % wmbase.MAX_WIN
        if wechselbar(state, j) && j != von {
            raise_win(state, j)
            set_focus(state, j)
            wmdamage.damage_win(state, j)
            return true
        }
        k = k + 1
    }
    return false
}

fn prev_window(state: u64, von: u64) -> bool {
    var k: u64 = 1
    while k <= wmbase.MAX_WIN {
        let j: u64 = (von + wmbase.MAX_WIN - (k % wmbase.MAX_WIN)) % wmbase.MAX_WIN
        if wechselbar(state, j) && j != von {
            raise_win(state, j)
            set_focus(state, j)
            wmdamage.damage_win(state, j)
            return true
        }
        k = k + 1
    }
    return false
}


// ===================================================================================================================
// W1d: THE ALT+TAB SWITCHER (Windows 11 style). One overlay panel with a tile per switchable window (a scaled picture of
// the window + its title). Alt+Tab opens it with the SECOND window (most recently used) selected, every further Tab moves
// right, Shift+Tab moves left, releasing Alt switches to the selected window, Esc closes it without a change.
// The list is the z-order from the top (= most recently used: raising a window is what focusing does), the focused window
// first. While the panel is open nothing is raised or focused -- the switch happens on release, like on Windows.
// Alt release is read from the keyboard state (kbd KB_OLD) once per tick; if Alt is already up when the first Tab is
// handled (a quick tap, e.g. a test harness) the panel opens and commits in the same call.
// ===================================================================================================================
static mut sw_open: u64 = 0
static mut sw_n: u64 = 0
static mut sw_sel: u64 = 0
static mut sw_list: [u64; 32] = [0 as u64; 32]
static mut sw_commits: u64 = 0
const ACT_PREV_WIN: u64 = 64

fn sw_alt_held(state: u64) -> bool {
    return kstate.get(state, kstate.K11_OFF + kstate.KB_OLD) == 1
}

fn sw_say(state: u64, ev: u64) {
    var s_o: [u8; 21] = "wm: switcher open n=\0"
    var s_s: [u8; 21] = "wm: switcher step n=\0"
    var s_c: [u8; 23] = "wm: switcher commit n=\0"
    var s_x: [u8; 23] = "wm: switcher cancel n=\0"
    var s_l: [u8; 6] = " sel=\0"
    var s_w: [u8; 6] = " win=\0"
    var s_h: [u8; 6] = " hid=\0"
    var s_m: [u8; 7] = " mins=\0"
    if ev == 0 {
        serial.puts((&s_o[0]) as u64)
    } else if ev == 1 {
        serial.puts((&s_s[0]) as u64)
    } else if ev == 2 {
        serial.puts((&s_c[0]) as u64)
    } else {
        serial.puts((&s_x[0]) as u64)
    }
    serial.dec(sw_n)
    serial.puts((&s_l[0]) as u64)
    serial.dec(sw_sel)
    serial.puts((&s_w[0]) as u64)
    var wid: u64 = 99
    if sw_sel < sw_n {
        wid = sw_list[sw_sel as usize]
    }
    serial.dec(wid)
    // X1: hid = the selected tile is a minimized window, mins = how many minimized windows the panel lists
    serial.puts((&s_h[0]) as u64)
    if wid < wmbase.MAX_WIN && sw_minimized(state, wid) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_m[0]) as u64)
    var mc: u64 = 0
    var t: u64 = 0
    while t < sw_n {
        if sw_minimized(state, sw_list[t as usize]) {
            mc = mc + 1
        }
        t = t + 1
    }
    serial.dec(mc)
    serial.nl()
}

// the panel geometry: out[0..9] = x, y, w, h, cell w, cell h, gap, pad, cols, scale percent
static mut sw_g: [i64; 10] = [0 as i64; 10]

fn sw_dim(state: u64, v: i64, k: i64) -> i64 {
    return v * (wmgeom.uisc(state) as i64) * k / 100
}

fn sw_geom(state: u64) {
    let wx: i64 = wmlayout.gs(state, wmlayout.S_WORK_X) as i64
    let wy: i64 = wmlayout.gs(state, wmlayout.S_WORK_Y) as i64
    let ww: i64 = wmlayout.gs(state, wmlayout.S_WORK_W) as i64
    let wh: i64 = wmlayout.gs(state, wmlayout.S_WORK_H) as i64
    let n: i64 = sw_n as i64
    var k: i64 = 100
    var cw: i64 = 0
    var ch: i64 = 0
    var gap: i64 = 0
    var pad: i64 = 0
    var cols: i64 = 1
    var rows: i64 = 1
    var pw: i64 = 0
    var ph: i64 = 0
    var go: bool = true
    while go {
        cw = sw_dim(state, 208, k)
        ch = sw_dim(state, 164, k)
        gap = sw_dim(state, 8, k)
        pad = sw_dim(state, 20, k)
        cols = (ww - sw_dim(state, 64, k) - 2 * pad + gap) / (cw + gap)
        if cols < 1 {
            cols = 1
        }
        if cols > n {
            cols = n
        }
        if cols < 1 {
            cols = 1
        }
        rows = (n + cols - 1) / cols
        pw = cols * cw + (cols - 1) * gap + 2 * pad
        ph = rows * ch + (rows - 1) * gap + 2 * pad
        if (ph <= wh - sw_dim(state, 64, k) && pw <= ww) || k <= 40 {
            go = false
        } else {
            k = k - 10
        }
    }
    sw_g[0 as usize] = wx + (ww - pw) / 2
    sw_g[1 as usize] = wy + (wh - ph) / 2
    sw_g[2 as usize] = pw
    sw_g[3 as usize] = ph
    sw_g[4 as usize] = cw
    sw_g[5 as usize] = ch
    sw_g[6 as usize] = gap
    sw_g[7 as usize] = pad
    sw_g[8 as usize] = cols
    sw_g[9 as usize] = k
}

fn sw_damage(state: u64) {
    sw_geom(state)
    let x: i64 = sw_g[0 as usize]
    let y: i64 = sw_g[1 as usize]
    wmbase.damage(state, x - 2, y - 2, x + sw_g[2 as usize] + 2, y + sw_g[3 as usize] + 2)
}

// X1: a minimized window (F_HIDDEN, normal layer, with a frame, not behind a tab) is listed too; committing it restores it.
fn sw_minimized(state: u64, i: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    let f: u64 = wmlayout.wg(state, i, wmlayout.W_FLAGS)
    if (f & wmlayout.F_HIDDEN) == 0 || (f & wmlayout.F_TABBED) != 0 || (f & wmlayout.F_NODECO) != 0 || tt_is_bg(state, i) {
        return false
    }
    return wmlayout.wg(state, i, wmlayout.W_LAYER) == wmlayout.L_NORMAL
}

fn sw_listable(state: u64, i: u64) -> bool {
    return wechselbar(state, i) || sw_minimized(state, i)
}

fn sw_build(state: u64) {
    sw_n = 0
    let fo: u64 = wmbase.focus(state)
    if fo < wmbase.MAX_WIN && sw_listable(state, fo) {
        sw_list[0 as usize] = fo
        sw_n = 1
    }
    var z: u64 = wmlayout.gs(state, wmlayout.S_COUNT)
    while z > 0 && sw_n < 32 {
        z = z - 1
        let w: u64 = wmbase.at_z(state, z)
        if w < wmbase.MAX_WIN && sw_listable(state, w) && w != fo {
            sw_list[sw_n as usize] = w
            sw_n = sw_n + 1
        }
    }
}

fn sw_close(state: u64) {
    if sw_open == 0 {
        return
    }
    sw_damage(state)
    sw_open = 0
}

fn sw_commit(state: u64) {
    if sw_open == 0 {
        return
    }
    sw_say(state, 2)
    var j: u64 = wmbase.MAX_WIN
    if sw_sel < sw_n {
        j = sw_list[sw_sel as usize]
    }
    sw_close(state)
    if j < wmbase.MAX_WIN && sw_minimized(state, j) {
        set_hidden(state, j, false) // X1: a minimized tile restores the window
    }
    if j < wmbase.MAX_WIN && wechselbar(state, j) {
        raise_win(state, j)
        set_focus(state, j)
        wmdamage.damage_win(state, j)
        sw_commits = sw_commits + 1
    }
}

fn sw_cancel(state: u64) {
    if sw_open == 0 {
        return
    }
    sw_say(state, 3)
    sw_close(state)
}

// one Alt+Tab (back = false) or Alt+Shift+Tab (back = true). Returns true if the panel is (or was just) open.
fn sw_step(state: u64, back: bool) -> bool {
    if sw_open == 0 {
        sw_build(state)
        if sw_n < 2 {
            return false
        }
        if back {
            sw_sel = sw_n - 1
        } else {
            sw_sel = 1
        }
        sw_open = 1
        sw_say(state, 0)
        sw_damage(state)
        if !sw_alt_held(state) {
            sw_commit(state)
        }
        return true
    }
    if back {
        sw_sel = (sw_sel + sw_n - 1) % sw_n
    } else {
        sw_sel = (sw_sel + 1) % sw_n
    }
    sw_say(state, 1)
    sw_damage(state)
    return true
}

// once per tick: Alt released -> switch; screen locked -> close; the list lost windows -> drop them
fn sw_tick(state: u64) {
    if sw_open == 0 {
        return
    }
    if wmgate.sperre_an(state) {
        sw_cancel(state)
        return
    }
    if !sw_alt_held(state) {
        sw_commit(state)
    }
}

fn paint_switcher(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    if sw_open == 0 || sw_n == 0 {
        return
    }
    sw_geom(state)
    let c0: i64 = cx0 as i64
    let r0: i64 = cy0 as i64
    let c1: i64 = cx1 as i64
    let r1: i64 = cy1 as i64
    let k: i64 = sw_g[9 as usize]
    let px: i64 = sw_g[0 as usize]
    let py: i64 = sw_g[1 as usize]
    let cw: i64 = sw_g[4 as usize]
    let ch: i64 = sw_g[5 as usize]
    let gap: i64 = sw_g[6 as usize]
    let pad: i64 = sw_g[7 as usize]
    let cols: i64 = sw_g[8 as usize]
    if px + sw_g[2 as usize] <= c0 || py + sw_g[3 as usize] <= r0 || px >= c1 || py >= r1 {
        return
    }
    wmdraw.fill_round(state, px, py, sw_g[2 as usize], sw_g[3 as usize], sw_dim(state, 12, k) as u64, 0x202020, 240, c0, r0, c1, r1)
    let f: u64 = wmlayout.gs(state, wmlayout.S_FONT_UI)
    let pxui: u64 = wmlayout.gs(state, wmlayout.S_PX_UI)
    let accent: u64 = wmbase.deco(state, wmlayout.DK_FRAME_ON)
    let n: i64 = sw_n as i64
    var t: i64 = 0
    while t < n {
        let w: u64 = sw_list[t as usize]
        let row: i64 = t / cols
        var inrow: i64 = n - row * cols
        if inrow > cols {
            inrow = cols
        }
        let off: i64 = (cols - inrow) * (cw + gap) / 2
        let tx: i64 = px + pad + off + (t % cols) * (cw + gap)
        let ty: i64 = py + pad + row * (ch + gap)
        if wmbase.valid(state, w) && tx < c1 && ty < r1 && tx + cw > c0 && ty + ch > r0 {
            if (t as u64) == sw_sel {
                wmdraw.fill_round(state, tx, ty, cw, ch, sw_dim(state, 8, k) as u64, accent, 255, c0, r0, c1, r1)
                let b: i64 = sw_dim(state, 3, k)
                wmdraw.fill_round(state, tx + b, ty + b, cw - 2 * b, ch - 2 * b, sw_dim(state, 6, k) as u64, 0x2E2E2E, 255, c0, r0, c1, r1)
            }
            let m: i64 = sw_dim(state, 10, k)
            let thx: i64 = tx + m
            let thy: i64 = ty + m
            let thw: i64 = cw - 2 * m
            let thh: i64 = ch - 2 * m - sw_dim(state, 26, k)
            let bw: i64 = wmlayout.wg(state, w, wmlayout.W_W) as i64
            let bh: i64 = wmlayout.wg(state, w, wmlayout.W_H) as i64
            let buf: u64 = wmlayout.wg(state, w, wmlayout.W_BUF)
            // X1: no black letterbox -- the picture is scaled to its own aspect and centred, the tile colour shows around it.
            // Only a window without a buffer gets a dark placeholder box.
            if !(bw > 0 && bh > 0 && buf != 0) {
                wmdraw.fill_clip(state, thx, thy, thw, thh, 0x101010, 255, c0, r0, c1, r1)
            }
            if bw > 0 && bh > 0 && buf != 0 && thw > 0 && thh > 0 {
                var nw: i64 = thw
                var nh: i64 = bh * thw / bw
                if nh > thh {
                    nh = thh
                    nw = bw * thh / bh
                }
                if nw > 0 && nh > 0 {
                    let ox: i64 = thx + (thw - nw) / 2
                    let oy: i64 = thy + (thh - nh) / 2
                    let ax0: i64 = wmbase.imax(ox, c0)
                    let ax1: i64 = wmbase.imin(ox + nw, c1)
                    let ay0: i64 = wmbase.imax(oy, r0)
                    let ay1: i64 = wmbase.imin(oy + nh, r1)
                    let stride: u64 = wmlayout.wg(state, w, wmlayout.W_W)
                    var y: i64 = ay0
                    while y < ay1 && ax1 > ax0 {
                        let sy: i64 = (y - oy) * bh / nh
                        if sy >= 0 && sy < bh && y >= 0 {
                            fb.scaled_row_a(state, y as u64, ax0, ax1, buf +% (sy as u64) *% stride *% 4, ox, bw, nw, 255)
                        }
                        y = y + 1
                    }
                }
            }
            var lead_x: i64 = thx
            let an: u64 = win_app(state, w)
            if an != 0 && f < ttf.MAX_FONTS && (__mmio_read8((an) as *mut u8)) != 0 as u8 {
                // ROUND W-ICON: the program's tile in front of the title -- same colour and letter as the bar,
                // the start menu and the task manager (lib/appicon.fi)
                let ts: i64 = sw_dim(state, 16, k)
                let ty2: i64 = thy + thh + sw_dim(state, 4, k)
                wmdraw.fill_round(state, thx, ty2, ts, ts, sw_dim(state, 4, k) as u64, appicon.color_of(an), 255, c0, r0, c1, r1)
                let cp: u64 = appicon.letter_cp(an, 0)
                if cp != 0 {
                    let gs_: u64 = ttf.glyph(state, f, cp, pxui)
                    if gs_ < ttf.SLOTS {
                        let gw_: i64 = ttf.g_w(state, gs_) as i64
                        let gh_: i64 = ttf.g_h(state, gs_) as i64
                        wmdraw.fb_glyph(state, gs_, thx + (ts - gw_) / 2 - ttf.g_left(state, gs_),
                            ty2 + (ts - gh_) / 2 + ttf.g_top(state, gs_), 0xFFFFFF,
                            wmbase.imax(thx, c0), wmbase.imax(ty, r0), wmbase.imin(tx + cw, c1), wmbase.imin(ty + ch, r1))
                    }
                }
                lead_x = thx + ts + sw_dim(state, 4, k)
            }
            if f < ttf.MAX_FONTS {
                title_text(state, w, f, lead_x, thy + thh + sw_dim(state, 4, k) + ttf.ascent(state, f, pxui), 0xFFFFFF,
                    wmbase.imax(thx, c0), wmbase.imax(ty, r0), wmbase.imin(tx + cw, c1), wmbase.imin(ty + ch, r1), tx + cw - m)
            }
        }
        t = t + 1
    }
}

// r804: the touchpad swipe (lib/touchgest, via hidin -> gfx.mouse_swipe) as a window switch. dir: 1 left, 2 right,
// 3 up, 4 down; n = fingers (>= 3). Left = next window, right = previous (like Alt+Tab / Alt+Shift+Tab). Up/down
// have no consumer yet. Never while the screen is locked or the trusted dialog is up. Returns true if the focus moved.
static mut sw_done: u64 = 0 // swipes that moved the focus
fn swipe_do(state: u64, dir: u64, n: u64) -> bool {
    if n < 3 || !wmbase.ready(state) || wmgate.sperre_an(state) || td_live(state) {
        return false
    }
    let i: u64 = wmbase.focus(state)
    var moved: bool = false
    if dir == 1 {
        moved = next_window(state, i)
    } else if dir == 2 {
        moved = prev_window(state, i)
    }
    if moved {
        sw_done = sw_done + 1
    }
    return moved
}

fn swipes_done() -> u64 {
    return sw_done
}

// W-TPSET2: a touchpad gesture action (lib/touchgest A_*, already resolved from the swipe mode in hidin) that
// the window server owns: 1 = next window, 2 = previous window (same focus walk as Alt+Tab / Alt+Shift+Tab).
// Show / restore desktop go over the Win+D key of the taskbar (hidin); task view and virtual desktops do not
// exist yet, so those codes (3, 6, 7) do nothing. Never while the screen is locked or the trusted dialog is up.
fn gest_action(state: u64, act: u64, n: u64) -> bool {
    if act == 1 {
        return swipe_do(state, 1, n)
    }
    if act == 2 {
        return swipe_do(state, 2, n)
    }
    return false
}

// EINE HANDLUNG AUSFUEHREN. Welche Taste welche Handlung ausloest, steht
// NICHT hier, sondern in der Tabelle, die aus
// /users/<name>/config/tiling.conf gelesen wurde. Hier steht nur, was
// eine Handlung TUT.
fn tile_action(state: u64, act: u64) -> bool {
    if act == tile.A_NONE || !wmbase.ready(state) {
        return false
    }
    // r382 LOCK SEAL: second lock, for the callers that do not come over
    // the key ring (the syscall WM_TILEDO): no action on any window while
    // the screen is locked.
    if wmgate.sperre_an(state) {
        return false
    }
    if act == tile.A_TILE_TOGGLE {
        set_tile_on(state, wmlayout.gs(state, wmlayout.S_TILE) == 0)
        return true
    }
    // RUNDE FENSTER: die MESSTASTE. Sie veraendert nichts -- sie legt die Arbeitsflaeche und die
    // ganze Fensterliste auf die Leitung. r402: VOR der Frage nach dem Fokus -- sie braucht weder
    // ein Fenster noch den Baum (nach Alt+F4 auf dem letzten Fenster gab es keinen Fokus mehr, und
    // die Messtaste blieb stumm).
    if act == tile.A_SAY {
        work_say(state)
        wins_say(state)
        return true
    }
    let i: u64 = wmbase.focus(state)
    if i >= wmbase.MAX_WIN {
        return false
    }
    if act == tile.A_CLOSE {
        ev_push(state, i, wmlayout.E_CLOSE, 0, 0, 0)
        destroy(state, i)
        return true
    }
    // r402: Alt+F4 -- a window with a frame, on the normal layer, closed like its close button
    if act == tile.A_CLOSE_WIN {
        if !wmbase.deko(state, i) || wmlayout.wg(state, i, wmlayout.W_LAYER) != wmlayout.L_NORMAL || !wmgate.darf(state, i) {
            return false
        }
        return close_anim(state, i)
    }
    if act == tile.A_FLOAT {
        return tile_float(state, i)
    }
    if act >= tile.A_SNAP_LEFT && act <= tile.A_SNAP_BR {
        return tile_snap(state, i, act - tile.A_SNAP_LEFT)
    }
    // ================================================ RUNDE TUERSCHLOSS
    //
    // ALT+TAB. Diese Abfrage steht VOR `let nd = wg(state, i, W_NODE)`
    // und dessen `if nd == 0 { return false }` -- und das ist der ganze
    // Grund, warum sie wirkt.
    //
    // GEMESSEN (Runde DURCHKLICK, 4.3): `focus=1` stand ueber 137
    // Meldungen still. Die vorhandenen Fokushandlungen fragen alle den
    // KACHELBAUM (`dir_search`); ein schwebendes Fenster hat `W_NODE ==
    // 0` und faellt aus jeder von ihnen heraus, bevor irgendetwas
    // passiert. Auf dem Schreibtisch dieses Systems schwebt aber jedes
    // Fenster -- der Kachelmodus ist standardmaessig aus.
    //
    // Alt+Tab geht deshalb durch die FENSTERLISTE DES SERVERS und nicht
    // durch den Baum: ab dem Fenster mit dem Fokus aufwaerts, im Kreis,
    // und nimmt das erste, das ein Mensch auch anklicken koennte.
    if act == tile.A_NEXT_WIN {
        return sw_step(state, false)
    }
    if act == ACT_PREV_WIN {
        return sw_step(state, true)
    }
    // ================================================== RUNDE VOLLBILD
    // F11 UMSCHALTEN. Steht aus demselben Grund hier oben wie Alt+Tab:
    // das Vollbild betrifft EIN Fenster und nicht den Kachelbaum -- ein
    // schwebendes Fenster (der Normalfall auf diesem Schreibtisch) hat
    // `W_NODE == 0` und fiele durch die Abfrage darunter heraus, bevor
    // irgendetwas passiert.
    //
    // UMSCHALTEN und nicht EINSCHALTEN: dieselbe Taste zurueck ist das,
    // was Windows und jeder Browser tun.
    if act == tile.A_FULL {
        let an: bool = (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_FULL) == 0
        let ok: bool = fullscreen(state, i, an)
        if ok {
            full_say(state, i)
        }
        return ok
    }
    let nd: u64 = wmlayout.wg(state, i, wmlayout.W_NODE)
    if nd == 0 {
        return false
    }
    tl_sel(state, nd_tag(nd))
    let n: u64 = nd_node(nd)
    if act <= tile.A_FOCUS_DOWN {
        let z: u64 = tile.dir_search(tt(state), n, act - tile.A_FOCUS_LEFT)
        if z == tile.NONE {
            return false
        }
        tile.set_focus(tt(state), z)
        let cl: u64 = tile.n_client(tt(state), z)
        if cl != 0 && cl <= wmbase.MAX_WIN {
            raise_win(state, cl - 1)
            set_focus(state, cl - 1)
        }
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act <= tile.A_MOVE_DOWN {
        if tile.move_dir(tt(state), n, act - tile.A_MOVE_LEFT) {
            tile_apply(state)
            damage_tile(state)
            return true
        }
        return false
    }
    if act == tile.A_SPLIT_H {
        tile.set_next_split(tt(state), 1)
        return true
    }
    if act == tile.A_SPLIT_V {
        tile.set_next_split(tt(state), 2)
        return true
    }
    if act >= tile.A_LAYOUT_SPLIT && act <= tile.A_LAYOUT_STACKED {
        if tile.set_layout(tt(state), n, act - tile.A_LAYOUT_SPLIT) {
            tile_apply(state)
            damage_tile(state)
            return true
        }
        return false
    }
    if act == tile.A_ROTATE {
        tile.rotate(tt(state), tile.root(tt(state)), 1)
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act == tile.A_MIRROR {
        tile.mirror(tt(state), tile.root(tt(state)), 0)
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act == tile.A_BALANCE {
        tile.balance(tt(state), tile.root(tt(state)))
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act == tile.A_GROW || act == tile.A_SHRINK {
        var d: i64 = tile.MIN_FRAC as i64
        if act == tile.A_SHRINK {
            d = 0 - d
        }
        if tile.resize_at(tt(state), n, d) {
            tile_apply(state)
            damage_tile(state)
            return true
        }
        return false
    }
    return false
}

// `ax: mag ...` on the serial line: where the panel and the cut-out are,
// so a test checks the PICTURE against the kernel's own numbers.
fn say_mag(state: u64) {
    var s_a: [u8; 12] = "ax: mag px=\0"
    var s_b: [u8; 5] = " sx=\0"
    var s_c: [u8; 5] = " sy=\0"
    var s_d: [u8; 5] = " cx=\0"
    var s_e: [u8; 5] = " cy=\0"
    var s_f: [u8; 7] = " mode=\0"
    var s_g: [u8; 9] = " frames=\0"
    var s_h: [u8; 6] = " rim=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(wmmag.mag_x(state))
    serial.puts((&s_b[0]) as u64)
    serial.dec(wmmag.mag_src(state, 0))
    serial.puts((&s_c[0]) as u64)
    serial.dec(wmmag.mag_src(state, 1))
    serial.puts((&s_d[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_MAGCX))
    serial.puts((&s_e[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_MAGCY))
    serial.puts((&s_f[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_MAGMODE))
    serial.puts((&s_g[0]) as u64)
    serial.dec(wmlayout.gs(state, wmlayout.S_MAGN))
    serial.puts((&s_h[0]) as u64)
    serial.hex(wmbase.deco(state, wmlayout.DK_TITLE_ON))
    serial.nl()
}
const CV_DRAWN: u64 = 12 // key of the text the overlay drew last
const CV_DRAWS: u64 = 15 // overlay paints since boot

// ==================================================== r1014: TERMINAL TABS
// Every tab is its own K_TERM window (own tty + shell, made by /bin/term like any other terminal). A GROUP is the set of
// windows that share one place: only the ACTIVE one is shown, the others are hidden (F_HIDDEN, `tt_bg` = 1) and left out of
// the task bar and Alt+Tab. The title bar of the active window shows the tab strip (this server paints the terminal title
// itself, so the strip is painted here: tabs, a close 'x' on each tab and a '+'). A switch copies the place and size of the
// active window to the tab that comes forward. Keys: Ctrl+Shift+T new tab, Ctrl+Tab / Ctrl+Shift+Tab next / previous,
// Ctrl+Shift+W close. A new tab is requested here (`tt_request`) and made by the desktop loop in kgui (it starts /bin/term);
// `gfx.term_new` then calls `tt_src` (take the place of the asking window) and `tt_join`.
static mut tt_grp: [u64; 32] = [0 as u64; 32]   // group id of the window, 0 = not in a group
static mut tt_ord: [u64; 32] = [0 as u64; 32]   // creation order inside the group (1, 2, 3 ...)
static mut tt_bg: [u64; 32] = [0 as u64; 32]    // 1 = background tab (hidden behind the active one)
static mut tt_cnt: [u64; 8] = [0 as u64; 8]     // 0 group ids given, 1 orders given, 2 request (window + 1), 3 request tick, 4 spawn asked, 5 joins, 6 switches, 7 closes
static mut tt_lab: [u8; 16] = [0 as u8; 16]

fn tt_grp_of(state: u64, i: u64) -> u64 {
    if i >= 32 || !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM {
        return 0
    }
    return tt_grp[(i) as usize]
}

fn tt_count(state: u64, g: u64) -> u64 {
    if g == 0 {
        return 0
    }
    var n: u64 = 0
    var k: u64 = 0
    while k < 32 {
        if wmbase.valid(state, k) && tt_grp[(k) as usize] == g {
            n = n + 1
        }
        k = k + 1
    }
    return n
}

fn tt_grouped(state: u64, i: u64) -> bool {
    let g: u64 = tt_grp_of(state, i)
    return g != 0 && tt_count(state, g) >= 2
}

// is window `i` a tab behind the active one? (task bar and Alt+Tab skip it)
fn tt_is_bg(state: u64, i: u64) -> bool {
    if i >= 32 || !wmbase.valid(state, i) {
        return false
    }
    return tt_grp[(i) as usize] != 0 && tt_bg[(i) as usize] != 0
}

// the n-th window of group `g` in creation order (0 = first), MAX_WIN if there is none
fn tt_nth(state: u64, g: u64, n: u64) -> u64 {
    var last: u64 = 0
    var found: u64 = wmbase.MAX_WIN
    var step: u64 = 0
    while step <= n {
        var best: u64 = wmbase.MAX_WIN
        var bo: u64 = 0xFFFFFFFFFFFF
        var k: u64 = 0
        while k < 32 {
            if wmbase.valid(state, k) && tt_grp[(k) as usize] == g
                && tt_ord[(k) as usize] > last && tt_ord[(k) as usize] < bo {
                best = k
                bo = tt_ord[(k) as usize]
            }
            k = k + 1
        }
        if best == wmbase.MAX_WIN {
            return wmbase.MAX_WIN
        }
        found = best
        last = bo
        step = step + 1
    }
    return found
}

fn tt_pos(state: u64, g: u64, i: u64) -> u64 {
    let n: u64 = tt_count(state, g)
    var k: u64 = 0
    while k < n {
        if tt_nth(state, g, k) == i {
            return k
        }
        k = k + 1
    }
    return 0
}

// the shown tab of group `g` (the one that is not a background tab)
fn tt_active(state: u64, g: u64) -> u64 {
    var k: u64 = 0
    while k < 32 {
        if wmbase.valid(state, k) && tt_grp[(k) as usize] == g && tt_bg[(k) as usize] == 0 {
            return k
        }
        k = k + 1
    }
    return tt_nth(state, g, 0)
}

fn tt_say(state: u64, kind: u64, w: u64, g: u64) {
    var s_new: [u8; 13] = "tt: new win=\0"
    var s_sw: [u8; 16] = "tt: switch win=\0"
    var s_cl: [u8; 15] = "tt: close win=\0"
    var s_g: [u8; 6] = " grp=\0"
    var s_t: [u8; 7] = " tabs=\0"
    if kind == 0 {
        serial.puts((&s_new[0]) as u64)
    } else if kind == 1 {
        serial.puts((&s_sw[0]) as u64)
    } else {
        serial.puts((&s_cl[0]) as u64)
    }
    serial.dec(w)
    serial.puts((&s_g[0]) as u64)
    serial.dec(g)
    serial.puts((&s_t[0]) as u64)
    serial.dec(tt_count(state, g))
    serial.nl()
}

// the tab that comes forward takes over place, size and maximised state of the one that goes back
fn tt_sync(state: u64, from: u64, to: u64) {
    if !wmbase.valid(state, from) || !wmbase.valid(state, to) {
        return
    }
    let mx: u64 = wmlayout.wg(state, from, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED
    wmlayout.wsv(state, to, wmlayout.W_FLAGS, (wmlayout.wg(state, to, wmlayout.W_FLAGS) & ~wmlayout.F_MAXIMIZED) | mx)
    wmlayout.wsv(state, to, wmlayout.W_SAVXY, wmlayout.wg(state, from, wmlayout.W_SAVXY))
    wmlayout.wsv(state, to, wmlayout.W_SAVWH, wmlayout.wg(state, from, wmlayout.W_SAVWH))
    // W-X2: the way back of a maximised window lives in W_SAVE; without it the tab that comes forward restored to 0x0 at -4096,-4096 (gone)
    wmlayout.wsv(state, to, wmlayout.W_SAVE, wmlayout.wg(state, from, wmlayout.W_SAVE))
    let w: u64 = wmlayout.wg(state, from, wmlayout.W_W)
    let h: u64 = wmlayout.wg(state, from, wmlayout.W_H)
    if wmlayout.wg(state, to, wmlayout.W_W) != w || wmlayout.wg(state, to, wmlayout.W_H) != h {
        let _r: bool = resize_win(state, to, w, h)
    }
    move_win(state, to, wmbase.win_x(state, from), wmbase.win_y(state, from))
}

// bring tab `to` forward (and put the shown one of its group back)
fn tt_switch(state: u64, to: u64) {
    let g: u64 = tt_grp_of(state, to)
    if g == 0 {
        return
    }
    let from: u64 = tt_active(state, g)
    if from == to {
        return
    }
    tt_sync(state, from, to)
    tt_bg[(to) as usize] = 0
    set_hidden(state, to, false)
    raise_win(state, to)
    if from < wmbase.MAX_WIN {
        tt_bg[(from) as usize] = 1
        set_hidden(state, from, true)
    }
    set_focus(state, to)
    tt_cnt[6] = tt_cnt[6] + 1
    tt_say(state, 1, to, g)
    wmbase.damage_all(state)
}

fn tt_step(state: u64, i: u64, fwd: bool) {
    let g: u64 = tt_grp_of(state, i)
    let n: u64 = tt_count(state, g)
    if g == 0 || n < 2 {
        return
    }
    let p: u64 = tt_pos(state, g, i)
    var q: u64 = 0
    if fwd {
        q = (p + 1) % n
    } else {
        q = (p + n - 1) % n
    }
    let t: u64 = tt_nth(state, g, q)
    if t < wmbase.MAX_WIN {
        tt_switch(state, t)
    }
}

fn tt_close_tab(state: u64, i: u64) {
    if !wmbase.valid(state, i) {
        return
    }
    tt_cnt[7] = tt_cnt[7] + 1
    tt_say(state, 2, i, tt_grp_of(state, i))
    ev_push(state, i, wmlayout.E_CLOSE, 0, 0, 0)
    destroy(state, i)
}

// called by `destroy` before the window goes: a shown tab leaves, the one before it (or the next) comes forward
fn tt_forget(state: u64, i: u64) {
    if i >= 32 {
        return
    }
    let g: u64 = tt_grp[(i) as usize]
    if g == 0 {
        return
    }
    if tt_bg[(i) as usize] == 0 && tt_count(state, g) >= 2 {
        let p: u64 = tt_pos(state, g, i)
        var q: u64 = 1
        if p > 0 {
            q = p - 1
        }
        let s: u64 = tt_nth(state, g, q)
        if s < wmbase.MAX_WIN && s != i {
            tt_sync(state, i, s)
            tt_bg[(s) as usize] = 0
            set_hidden(state, s, false)
            raise_win(state, s)
        }
    }
    tt_grp[(i) as usize] = 0
    tt_ord[(i) as usize] = 0
    tt_bg[(i) as usize] = 0
}

// ---- a new tab: asked here, made by the desktop loop (/bin/term), joined by gfx.term_new
fn tt_request(state: u64, f: u64) {
    if tt_cnt[2] == 0 && f < 32 {
        tt_cnt[2] = f + 1
        tt_cnt[3] = kstate.get(state, kstate.TICKS)
        tt_cnt[4] = 0
    }
}

// r1309: a new terminal asked for with no terminal window to take the place of (request slot 32 = "no source": gfx.term_new makes it at
// the cascade place and does not join a group)
fn tt_request_free(state: u64) {
    if tt_cnt[2] == 0 {
        tt_cnt[2] = 33
        tt_cnt[3] = kstate.get(state, kstate.TICKS)
        tt_cnt[4] = 0
    }
}

// the terminal of a free request (no source window) is made: the request is over
fn tt_free_done(state: u64, w: u64) {
    if tt_cnt[2] == 33 && tt_cnt[4] != 0 {
        tt_cnt[2] = 0
        tt_cnt[4] = 0
        var s_fr: [u8; 14] = "tt: free win=\0"
        serial.puts((&s_fr[0]) as u64)
        serial.dec(w)
        serial.nl()
    }
}

// true ONCE per request: the desktop loop should start /bin/term now
fn tt_want_spawn(state: u64) -> bool {
    if tt_cnt[2] == 0 {
        return false
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if now > tt_cnt[3] + 1500 {
        tt_cnt[2] = 0
        tt_cnt[4] = 0
        return false
    }
    if tt_cnt[4] != 0 {
        return false
    }
    tt_cnt[4] = 1
    return true
}

fn tt_cancel(state: u64) {
    tt_cnt[2] = 0
    tt_cnt[4] = 0
}

// the window that asked for the tab being made now (MAX_WIN = none)
fn tt_src(state: u64) -> u64 {
    if tt_cnt[2] != 0 && tt_cnt[4] != 0 {
        let s: u64 = tt_cnt[2] - 1
        if s < 32 && wmbase.valid(state, s) && wmlayout.wg(state, s, wmlayout.W_KIND) == wmlayout.K_TERM {
            return s
        }
    }
    return wmbase.MAX_WIN
}

// window `n` (just made) becomes the shown tab of the group of `src`
fn tt_join(state: u64, n: u64, src: u64) {
    if n >= 32 || src >= 32 || n == src || !wmbase.valid(state, n) || !wmbase.valid(state, src) {
        return
    }
    var g: u64 = tt_grp[(src) as usize]
    if g == 0 {
        tt_cnt[0] = tt_cnt[0] + 1
        g = tt_cnt[0]
        tt_grp[(src) as usize] = g
        tt_cnt[1] = tt_cnt[1] + 1
        tt_ord[(src) as usize] = tt_cnt[1]
    }
    tt_cnt[1] = tt_cnt[1] + 1
    tt_grp[(n) as usize] = g
    tt_ord[(n) as usize] = tt_cnt[1]
    tt_bg[(n) as usize] = 0
    wmlayout.wsv(state, n, wmlayout.W_FLAGS, (wmlayout.wg(state, n, wmlayout.W_FLAGS) & ~wmlayout.F_MAXIMIZED) | (wmlayout.wg(state, src, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED))
    wmlayout.wsv(state, n, wmlayout.W_SAVXY, wmlayout.wg(state, src, wmlayout.W_SAVXY))
    wmlayout.wsv(state, n, wmlayout.W_SAVWH, wmlayout.wg(state, src, wmlayout.W_SAVWH))
    wmlayout.wsv(state, n, wmlayout.W_SAVE, wmlayout.wg(state, src, wmlayout.W_SAVE))
    tt_bg[(src) as usize] = 1
    set_hidden(state, src, true)
    tt_cnt[5] = tt_cnt[5] + 1
    tt_cnt[2] = 0
    tt_cnt[4] = 0
    tt_say(state, 0, n, g)
    wmbase.damage_all(state)
}

// ---- the strip: geometry (relative to the left / top edge of the window) and painter
fn tt_lo(state: u64) -> i64 {
    return (wmgeom.border(state) + wmgeom.title_pad(state)) as i64
}

// right end of the free part of the title bar: left of the three caption buttons (the classic close box)
fn tt_hi(state: u64, i: u64) -> i64 {
    let ow: i64 = wmbase.outer_w(state, i) as i64
    var bx: i64 = ow - wmgeom.border(state) as i64 - wmgeom.close_w(state) as i64 - 3
    if wmgeom.form(state, wmlayout.FM_CAPTION) != 0 {
        bx = ow - wmgeom.border(state) as i64 - (wmlayout.CAP_N * wmgeom.cap_w(state)) as i64
    }
    return bx - 4 * wmgeom.uisc(state) as i64
}

fn tt_sq(state: u64) -> i64 {
    return wmgeom.title_h(state) as i64 - wmgeom.border(state) as i64 - 1
}

// width of one tab (n tabs share the bar left of the '+')
fn tt_tabw(state: u64, i: u64, n: u64) -> i64 {
    if n == 0 {
        return 0
    }
    let region: i64 = tt_hi(state, i) - tt_lo(state) - tt_sq(state)
    var w: i64 = region / (n as i64)
    let mx: i64 = (wmlayout.gs(state, wmlayout.S_PX_UI) * 10) as i64
    if w > mx {
        w = mx
    }
    if w < 8 {
        w = 8
    }
    return w
}

// the label of tab `k` into tt_lab, its length. mode 0 = "Terminal k", 1 = "Term k", 2 = "T k", 3 = "k" (narrow tabs keep the NUMBER,
// z11 showed three narrow tabs all reading "Term")
fn tt_label(k: u64, mode: u64) -> u64 {
    var w: [u8; 10] = "Terminal \0"
    var keep: u64 = 9
    if mode == 1 {
        keep = 5
    } else if mode == 2 {
        keep = 2
    } else if mode >= 3 {
        keep = 0
    }
    var j: u64 = 0
    while j < keep {
        tt_lab[(j) as usize] = w[(j) as usize]
        j = j + 1
    }
    var n: u64 = keep
    if k >= 10 {
        tt_lab[(n) as usize] = (48 + (k / 10) % 10) as u8
        n = n + 1
    }
    tt_lab[(n) as usize] = (48 + k % 10) as u8
    n = n + 1
    tt_lab[(n) as usize] = 0 as u8
    return n
}

// width in pixels of the first `len` octets of tt_lab
fn tt_measure(state: u64, f: u64, len: u64) -> i64 {
    let px: u64 = wmlayout.gs(state, wmlayout.S_PX_UI)
    var cx: i64 = 0
    var k: u64 = 0
    while k < len {
        let gid: u64 = ttf.glyph_of(state, f, tt_lab[(k) as usize] as u64)
        cx = cx + ttf.advance26(state, f, gid, px)
        k = k + 1
    }
    return cx >> 6
}

// the longest label of tab `k` that fits into `avail` pixels (into tt_lab, its length)
fn tt_fit_label(state: u64, f: u64, k: u64, avail: i64) -> u64 {
    var mode: u64 = 0
    var len: u64 = tt_label(k, 0)
    while mode < 3 && tt_measure(state, f, len) > avail {
        mode = mode + 1
        len = tt_label(k, mode)
    }
    return len
}

// ASCII text at x (baseline y), left to right, stops before `grenze`; returns the x behind the last glyph
fn tt_text(state: u64, f: u64, p: u64, len: u64, x: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64, grenze: i64) -> i64 {
    let px: u64 = wmlayout.gs(state, wmlayout.S_PX_UI)
    var cx: i64 = x * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < len {
        let c: u64 = kstate.get8(p + k) as u64
        let gid: u64 = ttf.glyph_of(state, f, c)
        if vorher != 0 {
            cx = cx + ttf.kern26(state, f, vorher, gid, px)
        }
        let slot: u64 = ttf.glyph(state, f, c, px)
        if slot < ttf.SLOTS {
            if (cx >> 6) + ttf.g_w(state, slot) as i64 > grenze {
                return cx >> 6
            }
            wmdraw.fb_glyph(state, slot, cx >> 6, y, color, ax0, ay0, ax1, ay1)
            cx = cx + ttf.g_adv(state, slot)
        } else {
            cx = cx + ttf.advance26(state, f, gid, px)
        }
        vorher = gid
        k = k + 1
    }
    return cx >> 6
}

// one glyph centred in the box [x0, x0 + w)
fn tt_glyph_mid(state: u64, f: u64, c: u64, x0: i64, w: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let px: u64 = wmlayout.gs(state, wmlayout.S_PX_UI)
    let gid: u64 = ttf.glyph_of(state, f, c)
    let adv: i64 = ttf.advance26(state, f, gid, px) >> 6
    tt_lab[12] = c as u8
    tt_lab[13] = 0 as u8
    let _e: i64 = tt_text(state, f, (&tt_lab[12]) as u64, 1, x0 + (w - adv) / 2, y, color,
        ax0, ay0, ax1, ay1, x0 + w + 4)
}

// the tab strip of the shown tab `i` (instead of the title text); wx / wy = window origin on the screen
fn tt_paint(state: u64, i: u64, wx: i64, wy: i64, titel: u64, schrift: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64, f: u64) {
    let g: u64 = tt_grp_of(state, i)
    let n: u64 = tt_count(state, g)
    if n == 0 {
        return
    }
    let uk: i64 = wmgeom.uisc(state) as i64
    let ty: i64 = wy + wmgeom.border(state) as i64 + 3 * uk
    let tbot: i64 = wy + wmgeom.title_h(state) as i64 - 1
    let tbh: i64 = tbot - ty
    if tbh <= 4 {
        return
    }
    let base: i64 = wy + wmgeom.title_base(state, f)
    let tw: i64 = tt_tabw(state, i, n)
    let lo: i64 = tt_lo(state)
    let sq: i64 = tt_sq(state)
    let cy1: i64 = wmbase.imin(ay1, tbot)
    var k: u64 = 0
    while k < n {
        let wi: u64 = tt_nth(state, g, k)
        let x0: i64 = wx + lo + (k as i64) * tw
        let x1: i64 = x0 + tw - 2 * uk
        var col: u64 = 0
        if wi == i {
            wmdraw.fill_round(state, x0, ty, x1 - x0, tbh + 8 * uk, (6 * uk) as u64, wmlayout.wg(state, i, wmlayout.W_BG), 255,
                ax0, ay0, ax1, cy1)
            // z11: the shown tab was only white against grey. An accent bar under its label (the colour of the active frame) says "this one".
            wmdraw.fill_round(state, x0 + 6 * uk, tbot - 3 * uk, x1 - x0 - 12 * uk, 3 * uk, uk as u64, wmbase.deco(state, wmlayout.DK_FRAME_ON), 255,
                ax0, ay0, ax1, cy1)
            col = wmlayout.wg(state, i, wmlayout.W_FG)
        } else {
            wmdraw.fill_round(state, x0, ty, x1 - x0, tbh + 8 * uk, (6 * uk) as u64, wmdraw.blend(titel, schrift, 40), 255,
                ax0, ay0, ax1, cy1)
            col = schrift
        }
        let len: u64 = tt_fit_label(state, f, k + 1, x1 - sq - (x0 + 8 * uk) - 2 * uk)
        let _t: i64 = tt_text(state, f, (&tt_lab[0]) as u64, len, x0 + 8 * uk, base, col,
            ax0, ay0, ax1, ay1, x1 - sq)
        tt_glyph_mid(state, f, 120, x1 - sq, sq, base, col, ax0, ay0, ax1, ay1)
        k = k + 1
    }
    // the '+' button behind the last tab
    let px0: i64 = wx + lo + (n as i64) * tw
    tt_glyph_mid(state, f, 43, px0, sq, base, schrift, ax0, ay0, ax1, ay1)
}

// a left press on the title bar of terminal window `i` at screen (x, y). True = consumed (a tab, its 'x', the '+').
// The shown tab itself and the empty bar are NOT consumed: they stay the window's title bar (drag, double click).
fn tt_press(state: u64, i: u64, x: i64, y: i64) -> bool {
    if i >= 32 || !wmbase.valid(state, i) || wmlayout.wg(state, i, wmlayout.W_KIND) != wmlayout.K_TERM {
        return false
    }
    let ry: i64 = y - wmbase.win_y(state, i)
    if ry < wmgeom.border(state) as i64 || ry >= wmgeom.title_h(state) as i64 - 1 {
        return false
    }
    let lx: i64 = x - wmbase.win_x(state, i)
    let g: u64 = tt_grp_of(state, i)
    let n: u64 = tt_count(state, g)
    let lo: i64 = tt_lo(state)
    let sq: i64 = tt_sq(state)
    if n >= 2 {
        let tw: i64 = tt_tabw(state, i, n)
        let uk: i64 = wmgeom.uisc(state) as i64
        var k: u64 = 0
        while k < n {
            let x0: i64 = lo + (k as i64) * tw
            let x1: i64 = x0 + tw - 2 * uk
            if lx >= x0 && lx < x1 {
                let wi: u64 = tt_nth(state, g, k)
                if lx >= x1 - sq {
                    tt_close_tab(state, wi)
                    return true
                }
                if wi != i {
                    tt_switch(state, wi)
                    return true
                }
                return false
            }
            k = k + 1
        }
        let px0: i64 = lo + (n as i64) * tw
        if lx >= px0 && lx < px0 + sq {
            tt_request(state, i)
            return true
        }
        return false
    }
    // a lone terminal: only the '+' at the right end of the bar
    let hi: i64 = tt_hi(state, i)
    if lx >= hi - sq && lx < hi {
        tt_request(state, i)
        return true
    }
    return false
}

// the '+' of a lone terminal (no tabs yet): at the right end of the free part of the title bar
fn tt_paint_plus(state: u64, i: u64, wx: i64, wy: i64, schrift: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64, f: u64) {
    let sq: i64 = tt_sq(state)
    let base: i64 = wy + wmgeom.title_base(state, f)
    tt_glyph_mid(state, f, 43, wx + tt_hi(state, i) - sq, sq, base, schrift, ax0, ay0, ax1, ay1)
}
