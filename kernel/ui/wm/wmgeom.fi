profile kernel

import gfx.fb
import gfx.ttf
import lib.kstate
import ui.wm.wmlayout

const TITLE_H0: u64 = 22

const BORDER0: u64 = 2

const GRIP0: u64 = 8

const CLOSE_W0: u64 = 14

const TITLE_PAD0: u64 = 10

const MAX_W_HARD: u64 = 4096

const MAX_H_HARD: u64 = 2304

const FORM_SLOTS: u64 = 22

fn form(state: u64, i: u64) -> u64 {
    if i >= FORM_SLOTS {
        return 0
    }
    let v: u64 = wmlayout.gs(state, wmlayout.S_FORM + i * 8)
    if v == 0 {
        return 0
    }
    return v - 1
}

fn uisc(state: u64) -> u64 {
    let v: u64 = wmlayout.gs(state, wmlayout.S_UISC)
    if v == 0 || v > 4 {
        return 1
    }
    return v
}

fn set_uiscale(state: u64, v: u64) {
    if v >= 1 && v <= 4 {
        wmlayout.ss(state, wmlayout.S_UISC, v)
    }
}

fn frame_d(state: u64) -> u64 {
    let v: u64 = form(state, wmlayout.FM_FRAME)
    if v == 0 {
        return BORDER0
    }
    return v
}

fn bar_d(state: u64) -> u64 {
    let v: u64 = form(state, wmlayout.FM_TITLE_BAR)
    if v == 0 {
        return TITLE_H0 - 1 - BORDER0
    }
    return v
}

fn fpct(state: u64, i: u64) -> u64 {
    if i >= wmlayout.FPCT_SLOTS {
        return uisc(state) * 100
    }
    let v: u64 = kstate.get8(state + kstate.WM_OFF + wmlayout.S_FPCT + i)
    if v == 0 {
        return uisc(state) * 100
    }
    return v * 5
}

fn set_fpct(state: u64, i: u64, pct: u64) -> bool {
    if i >= wmlayout.FPCT_SLOTS || pct < 100 || pct > 1200 {
        return false
    }
    let old: u64 = fpct(state, i)
    kstate.set8(state + kstate.WM_OFF + wmlayout.S_FPCT + i, (pct / 5) as u8)
    return fpct(state, i) != old
}

fn clear_fpct(state: u64, i: u64) {
    if i < wmlayout.FPCT_SLOTS {
        kstate.set8(state + kstate.WM_OFF + wmlayout.S_FPCT + i, 0 as u8)
    }
}

fn fs(state: u64, i: u64, v: u64) -> u64 {
    return (v * fpct(state, i) + 50) / 100
}

fn uk(state: u64, i: u64) -> u64 {
    let k: u64 = (fpct(state, i) + 50) / 100
    if k < 1 {
        return 1
    }
    return k
}

fn title_h(state: u64, i: u64) -> u64 {
    return fs(state, i, frame_d(state) + bar_d(state) + 1)
}

fn border(state: u64, i: u64) -> u64 {
    return fs(state, i, frame_d(state))
}

fn title_pad(state: u64, i: u64) -> u64 {
    return fs(state, i, TITLE_PAD0)
}

fn title_base(state: u64, i: u64, f: u64) -> i64 {
    let px: u64 = wmlayout.gs(state, wmlayout.S_PX_UI)
    let asc: i64 = ttf.ascent(state, f, px)
    if fb.winfix_aus(state) {
        return border(state, i) as i64 + asc
    }
    let desc: i64 = ttf.descent(state, f, px)
    let ink: i64 = ((px * 4 + 2) / 5) as i64
    let bar: i64 = title_h(state, i) as i64 - border(state, i) as i64
    var base: i64 = border(state, i) as i64 + (bar + ink) / 2

    let lowest: i64 = title_h(state, i) as i64 - 1 - desc
    if base > lowest {
        base = lowest
    }
    if base < asc {
        base = asc
    }
    return base
}

fn grip(state: u64, i: u64) -> u64 {
    return fs(state, i, GRIP0)
}

fn grip_top(state: u64, i: u64) -> u64 {
    if fb.winfix_aus(state) {
        return border(state, i) + fs(state, i, 2)
    }
    return border(state, i) + fs(state, i, 3)
}

fn close_w(state: u64, i: u64) -> u64 {
    return fs(state, i, CLOSE_W0)
}

fn cap_w(state: u64, i: u64) -> u64 {
    let v: u64 = form(state, wmlayout.FM_CAP_W)
    if v == 0 {
        return fs(state, i, wmlayout.CAP_W0)
    }
    return fs(state, i, v)
}

fn max_w(state: u64) -> u64 {
    var v: u64 = wmlayout.gs(state, wmlayout.S_SW)
    if v == 0 || v > MAX_W_HARD {
        v = MAX_W_HARD
    }
    return v
}

fn max_h(state: u64) -> u64 {
    var v: u64 = wmlayout.gs(state, wmlayout.S_SH)
    if v == 0 || v > MAX_H_HARD {
        v = MAX_H_HARD
    }
    return v
}
