profile kernel

import lib.kstate
import gfx.fb
import gfx.font
import ui.wm.wmlayout
import ui.wm.wmgeom

const MEASURE_COLUMNS: u64 = 48

const MEASURE_LINES: u64 = 25

fn measure_scale(state: u64) -> u64 {

    var k: u64 = fb.width(state) / 900
    if k < 2 {
        k = 2
    }
    if k > 4 {
        k = 4
    }
    return k
}

fn measure_height(state: u64, lines: u64) -> u64 {
    var z: u64 = lines

    if z > 1 {
        z = (z + measure_col(state) - 1) / measure_col(state)
    }
    return font.GLYPH_H * measure_scale(state) * z + 2 * measure_scale(state)
}

fn measure_width(state: u64, columns: u64) -> u64 {
    let k: u64 = measure_scale(state)
    var b: u64 = font.GLYPH_W * k * (columns + 1) + 2 * k
    if b > fb.width(state) {
        b = fb.width(state)
    }
    return b
}

fn measure_col(state: u64) -> u64 {
    let b: u64 = measure_width(state, MEASURE_COLUMNS)
    if 3 * b <= fb.width(state) {
        return 3
    }
    if 2 * b <= fb.width(state) {
        return 2
    }
    return 1
}

fn measure_lines() -> u64 {
    return MEASURE_LINES
}

fn measure_per_column(state: u64) -> u64 {
    let k: u64 = measure_col(state)
    return (MEASURE_LINES + k - 1) / k
}

fn measure_full_width(state: u64) -> u64 {
    var b: u64 = measure_col(state) * measure_width(state, MEASURE_COLUMNS)
    if b > fb.width(state) {
        b = fb.width(state)
    }
    return b
}

fn measure_row_x(state: u64, row: u64) -> u64 {

    var kol: u64 = row / measure_per_column(state)
    if kol >= measure_col(state) {
        kol = measure_col(state) - 1
    }
    return kol * measure_width(state, MEASURE_COLUMNS)
}

fn measure_row_y(state: u64, row: u64) -> u64 {
    let k: u64 = measure_scale(state)
    return k + (row % measure_per_column(state)) * font.GLYPH_H * k
}

fn measure_row_h(state: u64) -> u64 {
    return font.GLYPH_H * measure_scale(state)
}

fn measure_reason(state: u64, lines: u64, columns: u64) {
    if !fb.ready(state) {
        return
    }
    let k: u64 = measure_scale(state)
    let height: u64 = measure_height(state, lines)
    if height >= fb.height(state) {
        return
    }
    let width: u64 = measure_full_width(state)
    fb.fill(state, 0, 0, width, height, fb.rgb(state, 0x00, 0x00, 0x00))

    let margin: u64 = fb.rgb(state, 0xFF, 0xE0, 0x00)
    fb.fill(state, 0, height - k, width, k, margin)
    fb.dirty(state, 0, height)
}

fn measure_row(state: u64, row: u64, p: u64, n: u64, fg: u64) {
    if !fb.ready(state) {
        return
    }

    if row >= MEASURE_LINES {
        return
    }
    let k: u64 = measure_scale(state)
    let gw: u64 = font.GLYPH_W * k
    let gh: u64 = font.GLYPH_H * k
    let y0: u64 = measure_row_y(state, row)
    let x0: u64 = measure_row_x(state, row)
    if y0 + gh >= fb.height(state) || x0 >= fb.width(state) {
        return
    }

    var width: u64 = measure_width(state, MEASURE_COLUMNS)
    if x0 + width > fb.width(state) {
        width = fb.width(state) - x0
    }
    fb.fill(state, x0, y0, width, gh, fb.rgb(state, 0x00, 0x00, 0x00))
    var i: u64 = 0
    var x: u64 = x0 + k
    while i < n && x + gw <= x0 + width {
        let ch: u64 = kstate.get8(p + i)
        var r: u64 = 0
        while r < font.GLYPH_H {
            let bits: u64 = font.row(state + fb.FONT_OFF, ch, r)
            var c: u64 = 0
            while c < font.GLYPH_W {
                if (bits & (1 << (7 - c))) != 0 {
                    var dy: u64 = 0
                    while dy < k {
                        var dx: u64 = 0
                        while dx < k {
                            fb.pixel(state, x + c * k + dx,
                                y0 + r * k + dy, fg)
                            dx = dx + 1
                        }
                        dy = dy + 1
                    }
                }
                c = c + 1
            }
            r = r + 1
        }
        x = x + gw
        i = i + 1
    }
    fb.dirty(state, y0, y0 + gh)
}

fn measure_green(state: u64) -> u64 {
    return fb.rgb(state, 0x00, 0xFF, 0x66)
}

fn measure_red(state: u64) -> u64 {
    return fb.rgb(state, 0xFF, 0x40, 0x40)
}

fn measure_white(state: u64) -> u64 {
    return fb.rgb(state, 0xFF, 0xFF, 0xFF)
}

fn measure_yellow(state: u64) -> u64 {
    return fb.rgb(state, 0xFF, 0xE0, 0x00)
}

fn measure_light(state: u64, v: u64) -> u64 {
    if v == 0 {
        return measure_red(state)
    }
    return measure_green(state)
}

fn measure_bar(state: u64, p: u64, n: u64) {
    measure_reason(state, 1, n + 1)
    measure_row(state, 0, p, n, measure_green(state))
}
