    wm.term_putc(state, t, 121)
    var w2: [u8; 8] = "|[?7h\0\0\0"
    vt_str(state, t, (&w2[0]) as u64)
    if wm.term_cy(state, t) == 0 && wm.term_cx(state, t) == COLS - 1 && wm.cell_get(state, t, COLS - 1, 0) == 121 && wm.cell_get(state, t, 0, 1) == 32 {
        n = n + 1
    }

    if wm.term_size(state, t) == (ROWS << 16) | COLS {
        n = n + 1
    }

    var rs: [u8; 3] = "|c\0"
    vt_str(state, t, (&rs[0]) as u64)
    wm.destroy(state, t)
    wmlayout.ss(state, wmlayout.S_NEXTID, nid0)
    wm.fokus_still = 0
    return n
}

fn vt2_selftest_max() -> u64 {
    return 32
}

fn selftest_max() -> u64 {
    return 30
}

