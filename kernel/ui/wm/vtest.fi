    }

    var v22: [u8; 16] = "|c|]0;a title~Z\0"
    vt_str(state, t, (&v22[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 90 && wm.cell_get(state, t, 1, 0) == 32 {
