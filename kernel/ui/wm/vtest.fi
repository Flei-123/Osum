    var v27: [u8; 13] = "|c|[3;5H|[1F\0"
    vt_str(state, t, (&v27[0]) as u64)
    if wm.term_cx(state, t) == 0 && wm.term_cy(state, t) == 1 {
        n = n + 1
    }

    var v28: [u8; 27] = "|c|[4;2r|[1;1HA|[2;1HB|[1S\0"
    vt_str(state, t, (&v28[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 66 {
        n = n + 1
    }

    var w0: [u8; 3] = "|c\0"
    vt_str(state, t, (&w0[0]) as u64)
    var q: u64 = 0
    while q < COLS {
        wm.term_putc(state, t, 97)
        q = q + 1
    }
    let at_end: bool = wm.term_cx(state, t) == COLS - 1 && wm.term_cy(state, t) == 0 && wm.cell_get(state, t, COLS - 1, 0) == 97
    wm.term_putc(state, t, 98)
    if at_end && wm.cell_get(state, t, 0, 1) == 98 && wm.term_cy(state, t) == 1 && wm.cell_get(state, t, 0, 0) == 97 {
        n = n + 1
    }

    var w1: [u8; 8] = "|c|[?7l\0"
    vt_str(state, t, (&w1[0]) as u64)
    q = 0
    while q < COLS + 3 {
        wm.term_putc(state, t, 120)
        q = q + 1
