    var v20: [u8; 21] = "|c|[3;4H|[s|[1;1H|[u\0"
    vt_str(state, t, (&v20[0]) as u64)
    if wm.term_cx(state, t) == 3 && wm.term_cy(state, t) == 2 {
        n = n + 1
    }

    var v21: [u8; 38] = "|c|[1;1HMAIN|[2;5H|[?1049hALT|[?1049l\0"
    vt_str(state, t, (&v21[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 77 && wm.cell_get(state, t, 3, 0) == 78 && wm.cell_get(state, t, 1, 0) == 65 && wm.term_cx(state, t) == 4 && wm.term_cy(state, t) == 1 {
