    }

    var v24: [u8; 28] = "|c|[?2004h|[>c|[5;6;7qW|(BV\0"
    vt_str(state, t, (&v24[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 87 && wm.cell_get(state, t, 1, 0) == 86 && wm.cell_get(state, t, 2, 0) == 32 {
        n = n + 1
    }

    var v25: [u8; 13] = "|c|[999;999H\0"
    vt_str(state, t, (&v25[0]) as u64)
    if wm.term_cx(state, t) == COLS - 1 && wm.term_cy(state, t) == ROWS - 1 {
        n = n + 1
    }

    var v26: [u8; 13] = "|c|[3;5H|[2E\0"
    vt_str(state, t, (&v26[0]) as u64)
    if wm.term_cx(state, t) == 0 && wm.term_cy(state, t) == 4 {
        n = n + 1
