    }

    var v10: [u8; 40] = "|c|[1;1H1|[2;1H2|[3;1H3|[4;1H4|[2;1H|[L\0"
    vt_str(state, t, (&v10[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 49 && wm.cell_get(state, t, 0, 1) == 32 && wm.cell_get(state, t, 0, 2) == 50 && wm.cell_get(state, t, 0, 3) == 51 && wm.cell_get(state, t, 0, 4) == 52 && wm.term_cx(state, t) == 0 && wm.term_cy(state, t) == 1 {
        n = n + 1
    }

    var v11: [u8; 40] = "|c|[1;1H1|[2;1H2|[3;1H3|[4;1H4|[2;1H|[M\0"
    vt_str(state, t, (&v11[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 49 && wm.cell_get(state, t, 0, 1) == 51 && wm.cell_get(state, t, 0, 2) == 52 && wm.cell_get(state, t, 0, 3) == 32 {
        n = n + 1
    }

    var v12: [u8; 51] = "|c|[1;1HA|[2;1HB|[3;1HC|[4;1HD|[5;1HE|[2;4r|[4;1H^\0"
    vt_str(state, t, (&v12[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 65 && wm.cell_get(state, t, 0, 1) == 67 && wm.cell_get(state, t, 0, 2) == 68 && wm.cell_get(state, t, 0, 3) == 32 && wm.cell_get(state, t, 0, 4) == 69 {
        n = n + 1
    }

    var v13: [u8; 52] = "|c|[1;1HA|[2;1HB|[3;1HC|[4;1HD|[5;1HE|[2;4r|[2;1H|M\0"
    vt_str(state, t, (&v13[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 65 && wm.cell_get(state, t, 0, 1) == 32 && wm.cell_get(state, t, 0, 2) == 66 && wm.cell_get(state, t, 0, 3) == 67 && wm.cell_get(state, t, 0, 4) == 69 {
        n = n + 1
    }

    var v14: [u8; 21] = "|c|[1;1HA|[2;1HB|[1S\0"
    vt_str(state, t, (&v14[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 66 && wm.cell_get(state, t, 0, 1) == 32 {
        n = n + 1
    }

    var v15: [u8; 21] = "|c|[1;1HA|[2;1HB|[1T\0"
    vt_str(state, t, (&v15[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 32 && wm.cell_get(state, t, 0, 1) == 65 && wm.cell_get(state, t, 0, 2) == 66 {
        n = n + 1
    }

    var v16: [u8; 22] = "|c|[31mR|[42;1mG|[0mN\0"
    vt_str(state, t, (&v16[0]) as u64)
    if wm.cell_col(state, t, 0, 0) == 2 && wm.cell_col(state, t, 1, 0) == 50 && (wm.cell_attr(state, t, 1, 0) & 2) == 2 && wm.cell_col(state, t, 2, 0) == 0 && wm.cell_attr(state, t, 2, 0) == 0 {
        n = n + 1
    }

    var v17: [u8; 25] = "|c|[7mR|[27mN|[4mU|[24mV\0"
    vt_str(state, t, (&v17[0]) as u64)
    if wm.cell_attr(state, t, 0, 0) == 1 && wm.cell_attr(state, t, 1, 0) == 0 && wm.cell_attr(state, t, 2, 0) == 4 && wm.cell_attr(state, t, 3, 0) == 0 {
        n = n + 1
    }

    var v18: [u8; 34] = "|c|[38;5;9mB|[0m|[38;2;10;20;30mQ\0"
    vt_str(state, t, (&v18[0]) as u64)
    if wm.cell_col(state, t, 0, 0) == 2 && (wm.cell_attr(state, t, 0, 0) & 8) == 8 && wm.cell_get(state, t, 1, 0) == 81 && wm.cell_col(state, t, 1, 0) == 0 {
        n = n + 1
    }

    var v19: [u8; 19] = "|c|[3;4H|7|[1;1H|8\0"
    vt_str(state, t, (&v19[0]) as u64)
    if wm.term_cx(state, t) == 3 && wm.term_cy(state, t) == 2 {
