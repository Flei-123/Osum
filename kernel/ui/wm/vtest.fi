profile kernel

import lib.kstate
import ui.wm
import ui.wm.wmdraw
import ui.wm.wmlayout
import ui.wm.wmgeom
import ui.wm.wmbase

fn diag1(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_DIAG1)
}

fn diag2(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_DIAG2)
}

fn failbits(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_FAIL)
}

fn pass_ok(state: u64, nr: u64) {
    wmlayout.ss(state, wmlayout.S_FAIL, wmlayout.gs(state, wmlayout.S_FAIL) & ~(1 << nr))
}

fn selftest(state: u64) -> u64 {

    wm.fokus_still = 1
    if !wmbase.ready(state) {
        return 0
    }
    var n: u64 = 0
    wmlayout.ss(state, wmlayout.S_FAIL, 0x7FFFFFFE)
    var t1: [u8; 5] = "eins\0"
    var t2: [u8; 5] = "zwei\0"

    let a: u64 = wm.create(state, 0, 40, 40, 200, 100, wmlayout.K_RAW, (&t1[0]) as u64)
    if a < wm.MAX_WIN && wm.win_buf(state, a) != 0 {
        n = n + 1
        pass_ok(state, 1)
    }

    let b: u64 = wm.create(state, 0, 100, 70, 200, 100, wmlayout.K_RAW, (&t2[0]) as u64)
    if b < wm.MAX_WIN && wm.win_z(state, b) > wm.win_z(state, a) {
        n = n + 1
        pass_ok(state, 2)
    }

    if wm.hit(state, 150, 100) == b {
        n = n + 1
        pass_ok(state, 3)
    }

    if wm.hit(state, 50, 60) == a {
        n = n + 1
        pass_ok(state, 4)
    }

    if wm.hit(state, 700, 500) == wm.MAX_WIN {
        n = n + 1
        pass_ok(state, 5)
    }

    wm.raise_win(state, a)
    if wm.hit(state, 150, 100) == a && wm.win_z(state, a) > wm.win_z(state, b) {
        n = n + 1
        pass_ok(state, 6)
    }

    wm.set_focus(state, b)
    if wmbase.focus(state) == b {
        n = n + 1
        pass_ok(state, 7)
    }

    let va: u64 = wm.ev_waiting(state, a)
    let vb: u64 = wm.ev_waiting(state, b)
    wm.on_key(state, 0x41)
    if wmlayout.gs(state, wmlayout.S_NOFOCUS) == 0 {
        if wm.ev_waiting(state, b) == vb + 1 && wm.ev_waiting(state, a) == va {
            n = n + 1
            pass_ok(state, 8)
        }
    } else {
        if wm.ev_waiting(state, b) == vb + 1 && wm.ev_waiting(state, a) == va + 1 {
            n = n + 1
            pass_ok(state, 9)
        }
    }

    var aus: [u8; 16] = [0 as u8; 16]
    var gefunden: bool = false
    while wm.ev_pop(state, b, (&aus[0]) as u64) {
        if kstate.get(((&aus[0]) as u64), 0) == wm.E_KEY {
            if (kstate.get(((&aus[0]) as u64), 8) >> 32) == 0x41 {
                gefunden = true
            }
        }
    }
    if gefunden {
        n = n + 1
        pass_ok(state, 10)
    }

    wmdraw.fill(state, a, 0, 0, 200, 100, 0)
    wmdraw.wpixel(state, a, 199, 99, wm.PROBE_IN)
    wmdraw.wpixel(state, a, 200, 99, wm.PROBE_OUT)
    if wmdraw.wget(state, a, 199, 99) == wm.PROBE_IN && wmdraw.wget(state, a, 0, 0) == 0 {
        n = n + 1
        pass_ok(state, 11)
    }

    wm.move_win(state, a, 300, 200)
    if wmbase.win_x(state, a) == 300 && wmdraw.wget(state, a, 199, 99) == wm.PROBE_IN {
        n = n + 1
        pass_ok(state, 12)
    }

    if wmlayout.gs(state, wmlayout.S_NODIRTY) == 0 {
        if wm.dirty_x0(state) <= 40 && wm.dirty_x1(state) >= 300 {
            n = n + 1
            pass_ok(state, 13)
        }
    } else {
        if wm.dirty_x0(state) == 0 && wm.dirty_x1(state) == wmlayout.gs(state, wmlayout.S_SW) {
            n = n + 1
            pass_ok(state, 14)
        }
    }

    var t3: [u8; 5] = "term\0"

    let t: u64 = wm.create(state, 0, 10, 300, 200 * wmgeom.uisc(state),
        100 * wmgeom.uisc(state), wm.K_TERM,
        (&t3[0]) as u64)
    if t < wm.MAX_WIN && wm.term_cols(state, t) > 4 && wm.term_rows(state, t) > 2 {
        n = n + 1
        pass_ok(state, 15)
    }

    if t < wm.MAX_WIN {
        var txt: [u8; 5] = "ab\nc\0"
        wm.term_write(state, t, (&txt[0]) as u64, 4)
        if wm.term_cx(state, t) == 1 && wm.term_cy(state, t) == 1 {
            n = n + 1
            pass_ok(state, 16)
        }
    }

    let vorher: u64 = wm.count(state)
    wm.destroy(state, b)
    if wm.count(state) == vorher - 1 && !wmbase.valid(state, b) {
        var has_gap: bool = false
        var z: u64 = 0
        while z < wm.count(state) {
            if wmbase.at_z(state, z) >= wm.MAX_WIN {
                has_gap = true
            }
            z = z + 1
        }
        if !has_gap {
            n = n + 1
            pass_ok(state, 17)
        }
    }

    if wm.resize_win(state, a, 120, 60) && wm.win_w(state, a) == 120 {
        if !wm.resize_win(state, a, 4096, 4096) && wm.win_w(state, a) == 120 {
            n = n + 1
            pass_ok(state, 18)
        }
    }

    if t < wm.MAX_WIN {
        let vorher_cols: u64 = wm.term_cols(state, t)
        if wm.resize_win(state, t, 100, 60) {
            if wm.term_cols(state, t) < vorher_cols && wm.term_cols(state, t) > 0 {
                n = n + 1
                pass_ok(state, 19)
            }
        }
    }
    if t < wm.MAX_WIN {
        wm.destroy(state, t)
    }

    var td: [u8; 6] = "tisch\0"
    let d: u64 = wm.create(state, 0, 0, 0, 320, 200, wmlayout.K_RAW, (&td[0]) as u64)
    if d < wm.MAX_WIN {
        wm.set_layer(state, d, wm.L_DESK)
        if wm.win_z(state, d) < wm.win_z(state, a) {
            n = n + 1
            pass_ok(state, 20)
        }

        wm.raise_win(state, d)
        if wm.win_z(state, d) < wm.win_z(state, a) || wmlayout.gs(state, wmlayout.S_NOLAYER) != 0 {
            n = n + 1
            pass_ok(state, 21)
        }

        let puf: u64 = wm.win_buf(state, a)
        let vorher: u64 = wm.hit(state, 60, 60)
        wm.set_hidden(state, a, true)
        let nachher: u64 = wm.hit(state, 60, 60)
        wm.set_hidden(state, a, false)
        if wmlayout.gs(state, wmlayout.S_NOMIN) == 0 {
            if vorher == a && nachher != a && wm.win_buf(state, a) == puf {
                n = n + 1
                pass_ok(state, 22)
            }
        } else {
            if vorher == a && nachher == a {
                n = n + 1
                pass_ok(state, 23)
            }
        }

        wm.set_deco(state, d, false)
        if wmbase.outer_w(state, d) == wm.win_w(state, d)
            && wmbase.outer_h(state, d) == wm.win_h(state, d) && wmbase.iny(state, d) == 0 {
            n = n + 1
            pass_ok(state, 24)
        }
        wm.destroy(state, d)
    }

    var tb: [u8; 4] = "bar\0"
    var tm: [u8; 4] = "max\0"
    let sw2: u64 = wmlayout.gs(state, wmlayout.S_SW)
    let sh2: u64 = wmlayout.gs(state, wmlayout.S_SH)

    let strut_was: bool = wm.nostrut(state)
    wm.set_nostrut(state, false)

    if wm.work_x(state) == 0 && wm.work_y(state) == 0
        && wm.work_w(state) == sw2 && wm.work_h(state) == sh2 {
        n = n + 1
        pass_ok(state, 25)
    }
    let bar: u64 = wm.create(state, 0, 0, (sh2 - 28) as i64, sw2, 28, wmlayout.K_RAW,
        (&tb[0]) as u64)
    if bar < wm.MAX_WIN {
        wm.set_deco(state, bar, false)

        let s23: bool = wm.set_strut(state, bar, wm.EDGE_BOTTOM, 28)
        if s23 && wm.work_x(state) == 0 && wm.work_y(state) == 0
            && wm.work_w(state) == sw2 && wm.work_h(state) == sh2 - 28 {
            n = n + 1
            pass_ok(state, 26)
        }

        let mw: u64 = wm.create(state, 0, 40, 40, wmgeom.max_w(state), wmgeom.max_h(state),
            wmlayout.K_RAW,
            (&tm[0]) as u64)
        wmlayout.ss(state, wmlayout.S_DIAG1, mw)
        wmlayout.ss(state, wmlayout.S_DIAG2, 0)
        if mw < wm.MAX_WIN {
            if wm.maximize(state, mw, true) {
                wmlayout.ss(state, wmlayout.S_DIAG2, 1)
            }
        }
        if mw < wm.MAX_WIN && wmlayout.gs(state, wmlayout.S_DIAG2) == 1 {
            let ox: i64 = wmbase.win_x(state, mw)
            let oy: i64 = wmbase.win_y(state, mw)
            let ow: u64 = wmbase.outer_w(state, mw)
            let oh: u64 = wmbase.outer_h(state, mw)
            if ox == wm.work_x(state) as i64 && oy == wm.work_y(state) as i64
                && ow == wm.work_w(state) && oh == wm.work_h(state) {
                n = n + 1
                pass_ok(state, 27)
            }

            if oy + oh as i64 <= wmbase.win_y(state, bar) {
                n = n + 1
                pass_ok(state, 28)
            }
        }

        wm.move_win(state, bar, 0, 0)
        let s26: bool = wm.resize_win(state, bar, 44, sh2)
        let _u26: bool = s26
        if wm.set_strut(state, bar, wm.EDGE_LEFT, 44) {
            if wm.work_x(state) == 44 && wm.work_y(state) == 0
                && wm.work_w(state) == sw2 - 44 && wm.work_h(state) == sh2 {
                n = n + 1
                pass_ok(state, 29)
            }
            if wmbase.win_x(state, mw) == 44 && wmbase.outer_w(state, mw) == sw2 - 44
                && wmbase.outer_h(state, mw) == sh2 {
                n = n + 1
                pass_ok(state, 30)
            }
        }

        wm.set_nostrut(state, true)
        let deckt: bool = wmbase.win_x(state, mw) == 0
            && wmbase.outer_w(state, mw) == sw2
        wm.set_nostrut(state, false)
        if deckt && wmbase.win_x(state, mw) == 44 {
            n = n + 1
            pass_ok(state, 31)
        }

        let _s28: bool = wm.set_strut(state, bar, wm.EDGE_LEFT, 0)
        if wm.work_x(state) == 0 && wm.work_w(state) == sw2 {
            n = n + 1
            pass_ok(state, 32)
        }

        let _s29: bool = wm.set_strut(state, bar, wm.EDGE_TOP, 30)
        let vorher: u64 = wm.work_y(state)
        wm.destroy(state, bar)
        if vorher == 30 && wm.work_y(state) == 0 && wm.work_h(state) == sh2 {
            n = n + 1
            pass_ok(state, 33)
        }

        let _m30: bool = wm.maximize(state, mw, false)
        if wmbase.win_x(state, mw) == 40 && wmbase.win_y(state, mw) == 40
            && wm.win_w(state, mw) == wmgeom.max_w(state)
            && wm.win_h(state, mw) == wmgeom.max_h(state)
            && !wm.is_max(state, mw) {
            n = n + 1
            pass_ok(state, 34)
        }
        if mw < wm.MAX_WIN {
            wm.destroy(state, mw)
        }
    }
    wm.destroy(state, a)
    wm.set_nostrut(state, strut_was)
    wmbase.damage_all(state)

    wm.fokus_still = 0
    return n
}

fn vt_feed(state: u64, t: u64, a: u64, n: u64) {
    wm.term_write(state, t, a, n)
}

fn vt_selftest(state: u64) -> u64 {
    if !wmbase.ready(state) {
        return 0
    }
    wm.fokus_still = 1

    let nid0: u64 = wmlayout.gs(state, wmlayout.S_NEXTID)
    var tt: [u8; 3] = "vt\0"
    let t: u64 = wm.create(state, 0, 10, 300, 200 * wmgeom.uisc(state),
        160 * wmgeom.uisc(state), wm.K_TERM, (&tt[0]) as u64)
    if t >= wm.MAX_WIN || wm.term_cols(state, t) < 12 || wm.term_rows(state, t) < 4 {
        if t < wm.MAX_WIN {
            wm.destroy(state, t)
        }
        wmlayout.ss(state, wmlayout.S_NEXTID, nid0)
        wm.fokus_still = 0
        return 0
    }
    var n: u64 = 0
    var clr: [u8; 16] = [27 as u8, 91 as u8, 50 as u8, 74 as u8, 27 as u8, 91 as u8, 72 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]

    vt_feed(state, t, (&clr[0]) as u64, 7)
    var a1: [u8; 16] = [27 as u8, 91 as u8, 51 as u8, 59 as u8, 53 as u8, 72 as u8, 88 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&a1[0]) as u64, 7)
    if wm.cell_get(state, t, 4, 2) == 88 && wm.term_cx(state, t) == 5 && wm.term_cy(state, t) == 2 {
        n = n + 1
    }

    vt_feed(state, t, (&clr[0]) as u64, 7)
    var a2: [u8; 16] = [104 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8, 27 as u8, 91 as u8,
        49 as u8, 59 as u8, 51 as u8, 72 as u8, 27 as u8, 91 as u8, 75 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&a2[0]) as u64, 14)
    if wm.cell_get(state, t, 0, 0) == 104 && wm.cell_get(state, t, 1, 0) == 101
        && wm.cell_get(state, t, 2, 0) == 32 && wm.cell_get(state, t, 4, 0) == 32 {
        n = n + 1
    }

    vt_feed(state, t, (&clr[0]) as u64, 7)
    var a3: [u8; 16] = [27 as u8, 91 as u8, 55 as u8, 109 as u8, 82 as u8, 27 as u8, 91 as u8,
        109 as u8, 78 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&a3[0]) as u64, 9)
    if wm.cell_get(state, t, 0, 0) == 82 && wm.cell_attr(state, t, 0, 0) == 1
        && wm.cell_get(state, t, 1, 0) == 78 && wm.cell_attr(state, t, 1, 0) == 0 {
        n = n + 1
    }

    vt_feed(state, t, (&clr[0]) as u64, 7)
    if wm.cell_get(state, t, 0, 0) == 32 && wm.cell_attr(state, t, 0, 0) == 0
        && wm.cell_get(state, t, 4, 2) == 32 && wm.term_cx(state, t) == 0 && wm.term_cy(state, t) == 0 {
        n = n + 1
    }

    var a5: [u8; 16] = [27 as u8, 91 as u8, 63 as u8, 50 as u8, 53 as u8, 108 as u8, 90 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&a5[0]) as u64, 7)
    if wm.cell_get(state, t, 0, 0) == 90 && wm.cell_get(state, t, 1, 0) == 32 {
        n = n + 1
    }

    vt_feed(state, t, (&clr[0]) as u64, 7)
    var a6: [u8; 16] = [27 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    var a6b: [u8; 16] = [91 as u8, 50 as u8, 59 as u8, 50 as u8, 72 as u8, 81 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&a6[0]) as u64, 1)
    vt_feed(state, t, (&a6b[0]) as u64, 6)
    if wm.cell_get(state, t, 1, 1) == 81 {
        n = n + 1
    }

    vt_feed(state, t, (&clr[0]) as u64, 7)
    var a7: [u8; 16] = [27 as u8, 91 as u8, 53 as u8, 59 as u8, 54 as u8, 59 as u8, 55 as u8,
        113 as u8, 87 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&a7[0]) as u64, 9)
    if wm.cell_get(state, t, 0, 0) == 87 && wm.cell_get(state, t, 1, 0) == 32 {
        n = n + 1
    }

    var rs: [u8; 16] = [27 as u8, 91 as u8, 109 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    vt_feed(state, t, (&rs[0]) as u64, 3)
    wm.destroy(state, t)
    wmlayout.ss(state, wmlayout.S_NEXTID, nid0)
    wm.fokus_still = 0
    return n
}

fn vt_selftest_max() -> u64 {
    return 7
}

fn vt_str(state: u64, t: u64, p: u64) {
    var k: u64 = 0
    while kstate.get8(p + k) != 0 {
        var b: u64 = kstate.get8(p + k)
        if b == 124 {
            b = 27
        } else if b == 126 {
            b = 7
        } else if b == 94 {
            b = 10
        } else if b == 36 {
            b = 92
        }
        term_write_one(state, t, b)
        k = k + 1
    }
}

fn term_write_one(state: u64, t: u64, b: u64) {
    wm.term_putc(state, t, b)
}

fn vt2_selftest(state: u64) -> u64 {
    if !wmbase.ready(state) {
        return 0
    }
    wm.fokus_still = 1
    let nid0: u64 = wmlayout.gs(state, wmlayout.S_NEXTID)
    var tt: [u8; 4] = "vt2\0"
    let t: u64 = wm.create(state, 0, 10, 300, 240 * wmgeom.uisc(state), 180 * wmgeom.uisc(state), wm.K_TERM, (&tt[0]) as u64)
    if t >= wm.MAX_WIN || wm.term_cols(state, t) < 16 || wm.term_rows(state, t) < 6 {
        if t < wm.MAX_WIN {
            wm.destroy(state, t)
        }
        wmlayout.ss(state, wmlayout.S_NEXTID, nid0)
        wm.fokus_still = 0
        return 0
    }
    let COLS: u64 = wm.term_cols(state, t)
    let ROWS: u64 = wm.term_rows(state, t)
    var n: u64 = 0

    var v0: [u8; 17] = "|c|[5;5H|[2A|[3C\0"
    vt_str(state, t, (&v0[0]) as u64)
    if wm.term_cx(state, t) == 7 && wm.term_cy(state, t) == 2 {
        n = n + 1
    }

    var v1: [u8; 25] = "|c|[5;5H|[2A|[3C|[2B|[4D\0"
    vt_str(state, t, (&v1[0]) as u64)
    if wm.term_cx(state, t) == 3 && wm.term_cy(state, t) == 4 {
        n = n + 1
    }

    var v2: [u8; 12] = "|c|[10G|[3d\0"
    vt_str(state, t, (&v2[0]) as u64)
    if wm.term_cx(state, t) == 9 && wm.term_cy(state, t) == 2 {
        n = n + 1
    }

    var v3: [u8; 24] = "|c|[1;1HXXXXX|[1;3H|[1K\0"
    vt_str(state, t, (&v3[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 32 && wm.cell_get(state, t, 1, 0) == 32 && wm.cell_get(state, t, 2, 0) == 32 && wm.cell_get(state, t, 3, 0) == 88 && wm.cell_get(state, t, 4, 0) == 88 {
        n = n + 1
    }

    var v4: [u8; 24] = "|c|[1;1HXXXXX|[1;3H|[0K\0"
    vt_str(state, t, (&v4[0]) as u64)
    if wm.cell_get(state, t, 1, 0) == 88 && wm.cell_get(state, t, 2, 0) == 32 && wm.cell_get(state, t, 4, 0) == 32 {
        n = n + 1
    }

    var v5: [u8; 46] = "|c|[1;1HXXXXX|[2;1HYYYYY|[3;1HZZZZZ|[2;3H|[0J\0"
    vt_str(state, t, (&v5[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 88 && wm.cell_get(state, t, 1, 1) == 89 && wm.cell_get(state, t, 2, 1) == 32 && wm.cell_get(state, t, 0, 2) == 32 {
        n = n + 1
    }

    var v6: [u8; 35] = "|c|[1;1HXXXXX|[2;1HYYYYY|[2;3H|[1J\0"
    vt_str(state, t, (&v6[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 32 && wm.cell_get(state, t, 0, 1) == 32 && wm.cell_get(state, t, 2, 1) == 32 && wm.cell_get(state, t, 3, 1) == 89 {
        n = n + 1
    }

    var v7: [u8; 24] = "|c|[1;1HABCDE|[1;2H|[2X\0"
    vt_str(state, t, (&v7[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 65 && wm.cell_get(state, t, 1, 0) == 32 && wm.cell_get(state, t, 2, 0) == 32 && wm.cell_get(state, t, 3, 0) == 68 {
        n = n + 1
    }

    var v8: [u8; 24] = "|c|[1;1HABCDE|[1;2H|[2@\0"
    vt_str(state, t, (&v8[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 65 && wm.cell_get(state, t, 1, 0) == 32 && wm.cell_get(state, t, 2, 0) == 32 && wm.cell_get(state, t, 3, 0) == 66 && wm.cell_get(state, t, 6, 0) == 69 {
        n = n + 1
    }

    var v9: [u8; 24] = "|c|[1;1HABCDE|[1;2H|[2P\0"
    vt_str(state, t, (&v9[0]) as u64)
    if wm.cell_get(state, t, 0, 0) == 65 && wm.cell_get(state, t, 1, 0) == 68 && wm.cell_get(state, t, 2, 0) == 69 && wm.cell_get(state, t, 3, 0) == 32 {
