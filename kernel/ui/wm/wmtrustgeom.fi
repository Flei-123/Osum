profile kernel

import gfx.fb
import ui.wm.wmtruststate

const W: u64 = 456
const PAD: u64 = 24
const SMALL_H: u64 = 36
const SMALL_PX: u64 = 12
const Q_LINE: u64 = 28
const Q_PX: u64 = 20
const HEAD_PAD: u64 = 14
const BODY_TOP: u64 = 26
const ICON: u64 = 40
const NAME_LINE: u64 = 24
const NAME_PX: u64 = 18
const ICON_GAP: u64 = 16
const GAP: u64 = 18
const ROW: u64 = 22
const ROW_PX: u64 = 14
const DESC_GAP: u64 = 6
const LINK_GAP: u64 = 18
const DET_GAP: u64 = 6
const DET_ROW: u64 = 18
const DET_PX: u64 = 12
const BODY_BOTTOM: u64 = 22
const FOOT_TOP: u64 = 22
const FOOT_BOTTOM: u64 = 22
const REM_H: u64 = 22
const REM_GAP: u64 = 14
const BTN_H: u64 = 32
const BTN_PX: u64 = 14
const BTN_GAP: u64 = 16
const BTN_W: u64 = 196
const CLOSE_W: u64 = 44
const CLOSE_GLYPH: u64 = 10
const SHIELD: u64 = 14
const RADIUS: u64 = 8
const DETAIL_INDENT: u64 = 16

fn scale(state: u64) -> u64 {
    var s: u64 = fb.uiscale(state)
    while s > 1 && (W + 16) * s > fb.width(state) {
        s = s - 1
    }
    return s
}

fn name_rows() -> u64 {
    if wmtruststate.td_nname == 0 {
        return 1
    }
    return wmtruststate.td_nname
}

fn q_rows() -> u64 {
    if wmtruststate.td_nq == 0 {
        return 1
    }
    return wmtruststate.td_nq
}

fn name_block() -> u64 {
    let rows: u64 = name_rows() * NAME_LINE
    if rows > ICON {
        return rows
    }
    return ICON
}

fn has_link() -> bool {
    return wmtruststate.td_ndet > 0
}

fn head_units() -> u64 {
    return SMALL_H + q_rows() * Q_LINE + HEAD_PAD
}

fn body_units() -> u64 {
    var u: u64 = BODY_TOP + BODY_BOTTOM
    if wmtruststate.td_plain == 0 {
        u = u + name_block() + GAP + 2 * ROW
        if wmtruststate.td_ndesc > 0 {
            u = u + DESC_GAP
        }
    }
    u = u + wmtruststate.td_ndesc * ROW
    if has_link() {
        u = u + LINK_GAP + ROW
        if wmtruststate.td_open != 0 {
            u = u + DET_GAP + wmtruststate.td_ndet * DET_ROW
        }
    }
    return u
}

fn foot_units() -> u64 {
    var u: u64 = FOOT_TOP + BTN_H + FOOT_BOTTOM
    if wmtruststate.td_rem != 0 {
        u = u + REM_H + REM_GAP
    }
    return u
}

fn dw(state: u64) -> u64 {
    return W * scale(state)
}

fn dh(state: u64) -> u64 {
    return (head_units() + body_units() + foot_units()) * scale(state)
}

fn dx(state: u64) -> u64 {
    if dw(state) >= fb.width(state) {
        return 0
    }
    return (fb.width(state) - dw(state)) / 2
}

fn dy(state: u64) -> u64 {
    if dh(state) >= fb.height(state) {
        return 0
    }
    return (fb.height(state) - dh(state)) / 2
}

fn head_bottom(state: u64) -> u64 {
    return dy(state) + head_units() * scale(state)
}

fn foot_top(state: u64) -> u64 {
    return head_bottom(state) + body_units() * scale(state)
}

fn q_top(state: u64, i: u64) -> u64 {
    return dy(state) + (SMALL_H + i * Q_LINE) * scale(state)
}

fn block_top(state: u64) -> u64 {
    return head_bottom(state) + BODY_TOP * scale(state)
}

fn icon_top(state: u64) -> u64 {
    return block_top(state) + (name_block() - ICON) * scale(state) / 2
}

fn name_top(state: u64) -> u64 {
    return block_top(state) + (name_block() - name_rows() * NAME_LINE) * scale(state) / 2
}

fn text_x(state: u64) -> u64 {
    return dx(state) + PAD * scale(state)
}

fn name_x(state: u64) -> u64 {
    return text_x(state) + (ICON + ICON_GAP) * scale(state)
}

fn name_wrap_w(state: u64) -> u64 {
    return (W - 2 * PAD - ICON - ICON_GAP) * scale(state)
}

fn pub_top(state: u64) -> u64 {
    return block_top(state) + (name_block() + GAP) * scale(state)
}

fn origin_top(state: u64) -> u64 {
    return pub_top(state) + ROW * scale(state)
}

fn desc_top(state: u64, i: u64) -> u64 {
    if wmtruststate.td_plain != 0 {
        return block_top(state) + i * ROW * scale(state)
    }
    return origin_top(state) + (ROW + DESC_GAP + i * ROW) * scale(state)
}

fn link_top(state: u64) -> u64 {
    var below: u64 = origin_top(state) + ROW * scale(state)
    if wmtruststate.td_plain != 0 {
        below = block_top(state)
    }
    if wmtruststate.td_ndesc > 0 {
        below = desc_top(state, wmtruststate.td_ndesc)
    }
    return below + LINK_GAP * scale(state)
}

fn det_top(state: u64, i: u64) -> u64 {
    return link_top(state) + (ROW + DET_GAP + i * DET_ROW) * scale(state)
}

fn rem_top(state: u64) -> u64 {
    return foot_top(state) + FOOT_TOP * scale(state)
}

fn btn_top(state: u64) -> u64 {
    var t: u64 = foot_top(state) + FOOT_TOP * scale(state)
    if wmtruststate.td_rem != 0 {
        t = t + (REM_H + REM_GAP) * scale(state)
    }
    return t
}

fn btn_x(state: u64, b: u64) -> u64 {
    if b == 0 {
        return dx(state) + PAD * scale(state)
    }
    return dx(state) + (PAD + BTN_W + BTN_GAP) * scale(state)
}

fn btn_w(state: u64) -> u64 {
    return BTN_W * scale(state)
}

fn btn_h(state: u64) -> u64 {
    return BTN_H * scale(state)
}

fn close_x(state: u64) -> u64 {
    return dx(state) + (W - CLOSE_W) * scale(state)
}

fn in_box(px: u64, py: u64, bx: u64, by: u64, bw: u64, bh: u64) -> bool {
    return px >= bx && px < bx + bw && py >= by && py < by + bh
}
