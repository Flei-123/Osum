profile kernel

import gfx.fb
import ui.wm.wmbase
import ui.wm.wmlayout

const DARK_LUMA_LIMIT: u64 = 128

const LIGHT_HEAD: u64 = 0xE6E6E6
const LIGHT_BODY: u64 = 0xFFFFFF
const LIGHT_FOOT: u64 = 0xF0F0F0
const LIGHT_BORDER: u64 = 0x9A9A9A
const LIGHT_TEXT: u64 = 0x1B1B1B
const LIGHT_MUTED: u64 = 0x5C5C5C
const LIGHT_ACCENT: u64 = 0x0067C0
const LIGHT_ON_ACCENT: u64 = 0xFFFFFF
const LIGHT_BUTTON: u64 = 0xFBFBFB
const LIGHT_BUTTON_EDGE: u64 = 0xD1D1D1
const LIGHT_RING: u64 = 0x1B1B1B
const LIGHT_WARN: u64 = 0xF2B600
const LIGHT_WARN_TEXT: u64 = 0x8A5A00

const DARK_HEAD: u64 = 0x383838
const DARK_BODY: u64 = 0x202020
const DARK_FOOT: u64 = 0x2B2B2B
const DARK_BORDER: u64 = 0x5A5A5A
const DARK_TEXT: u64 = 0xFFFFFF
const DARK_MUTED: u64 = 0xC5C5C5
const DARK_ACCENT: u64 = 0x4CC2FF
const DARK_ON_ACCENT: u64 = 0x000000
const DARK_BUTTON: u64 = 0x3A3A3A
const DARK_BUTTON_EDGE: u64 = 0x5A5A5A
const DARK_RING: u64 = 0xFFFFFF
const DARK_WARN: u64 = 0xFCE100
const DARK_WARN_TEXT: u64 = 0xFCE100

const P_HEAD: u64 = 0
const P_BODY: u64 = 1
const P_FOOT: u64 = 2
const P_BORDER: u64 = 3
const P_TEXT: u64 = 4
const P_MUTED: u64 = 5
const P_ACCENT: u64 = 6
const P_ON_ACCENT: u64 = 7
const P_BUTTON: u64 = 8
const P_BUTTON_EDGE: u64 = 9
const P_RING: u64 = 10
const P_WARN: u64 = 11
const P_WARN_TEXT: u64 = 12

fn luma(c: u64) -> u64 {
    return (((c >> 16) & 255) * 30 + ((c >> 8) & 255) * 59 + (c & 255) * 11) / 100
}

fn is_dark(state: u64) -> bool {
    return luma(wmbase.deco_rgb(state, wmlayout.DK_TITLE)) < DARK_LUMA_LIMIT
}

fn light_rgb(role: u64) -> u64 {
    if role == P_HEAD {
        return LIGHT_HEAD
    }
    if role == P_BODY {
        return LIGHT_BODY
    }
    if role == P_FOOT {
        return LIGHT_FOOT
    }
    if role == P_BORDER {
        return LIGHT_BORDER
    }
    if role == P_TEXT {
        return LIGHT_TEXT
    }
    if role == P_MUTED {
        return LIGHT_MUTED
    }
    if role == P_ACCENT {
        return LIGHT_ACCENT
    }
    if role == P_ON_ACCENT {
        return LIGHT_ON_ACCENT
    }
    if role == P_BUTTON {
        return LIGHT_BUTTON
    }
    if role == P_BUTTON_EDGE {
        return LIGHT_BUTTON_EDGE
    }
    if role == P_RING {
        return LIGHT_RING
    }
    if role == P_WARN {
        return LIGHT_WARN
    }
    return LIGHT_WARN_TEXT
}

fn dark_rgb(role: u64) -> u64 {
    if role == P_HEAD {
        return DARK_HEAD
    }
    if role == P_BODY {
        return DARK_BODY
    }
    if role == P_FOOT {
        return DARK_FOOT
    }
    if role == P_BORDER {
        return DARK_BORDER
    }
    if role == P_TEXT {
        return DARK_TEXT
    }
    if role == P_MUTED {
        return DARK_MUTED
    }
    if role == P_ACCENT {
        return DARK_ACCENT
    }
    if role == P_ON_ACCENT {
        return DARK_ON_ACCENT
    }
    if role == P_BUTTON {
        return DARK_BUTTON
    }
    if role == P_BUTTON_EDGE {
        return DARK_BUTTON_EDGE
    }
    if role == P_RING {
        return DARK_RING
    }
    if role == P_WARN {
        return DARK_WARN
    }
    return DARK_WARN_TEXT
}

fn rgb(state: u64, role: u64) -> u64 {
    if is_dark(state) {
        return dark_rgb(role)
    }
    return light_rgb(role)
}

fn colour(state: u64, role: u64) -> u64 {
    let v: u64 = rgb(state, role)
    return fb.rgb(state, (v >> 16) & 255, (v >> 8) & 255, v & 255)
}
