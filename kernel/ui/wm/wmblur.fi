const BLUR_W_MAX: u64 = 3440

const RECIP_SHIFT: u64 = 19

const RECIP_RUND: u64 = 262144

const BL_NX: u64 = 8

const BL_NY: u64 = 4

fn win_w(state: u64, i: u64) -> u64 {
    return wmlayout.wg(state, i, wmlayout.W_W)
}

fn win_h(state: u64, i: u64) -> u64 {
    return wmlayout.wg(state, i, wmlayout.W_H)
}

fn win_z(state: u64, i: u64) -> u64 {
    return wmlayout.wg(state, i, wmlayout.W_Z)
}

fn recip_of(n: u64) -> u64 {
    if n == 0 {
        return 0
    }
    return (((1 as u64) << RECIP_SHIFT) + n - 1) / n
}

fn bdiv(total: u64, rec: u64) -> u64 {
    return (total *% rec +% RECIP_RUND) >> RECIP_SHIFT
}

fn blur_h(source: u64, target: u64, w: u64, h: u64, r: u64, rt: u64, simd: bool) {
    var blk: [u64; 44] = [0 as u64; 44]
    blk[0] = source
    blk[1] = target
    blk[2] = w
    blk[3] = h
    blk[4] = r
    blk[5] = rt

    if simd && h >= 4 {
        let done: u64 = h - (h & 3)
        blk[3] = done
        blk[9] = 1
        asm("mov r11,rdi\nmov rax,[r11+24]\nshr rax,2\njz 0f\nmov [r11+24],rax\nmov rax,[r11+16]\ntest rax,rax\njz 0f\nmovdqu [r11+96],xmm0\nmovdqu [r11+112],xmm1\nmovdqu [r11+128],xmm2\nmovdqu [r11+144],xmm3\nmovdqu [r11+160],xmm4\nmovdqu [r11+176],xmm5\nmovdqu [r11+192],xmm6\nmovdqu [r11+208],xmm7\nmovdqu [r11+224],xmm8\nmovdqu [r11+240],xmm9\nmovdqu [r11+256],xmm10\nmovdqu [r11+272],xmm11\nmovdqu [r11+288],xmm12\nmovdqu [r11+304],xmm13\nmovdqu [r11+320],xmm14\nmovdqu [r11+336],xmm15\nmov r8,[r11]\nmov r9,[r11+8]\nmov rcx,[r11+16]\nshl rcx,2\nlea rdx,[rcx+rcx*2]\n1:\nmov rax,[r11+72]\ntest rax,rax\njz 91f\npushfq\ncli\n91:\npxor xmm15,xmm15\nmov eax,4\nmovd xmm10,eax\npshuflw xmm10,xmm10,0\npshufd xmm10,xmm10,0\npcmpeqd xmm11,xmm11\npsrld xmm11,8\npxor xmm0,xmm0\npxor xmm1,xmm1\nxor eax,eax\nmov [r11+56],rax\nmov [r11+64],rax\nmov rsi,r8\nxor r10d,r10d\n2:\ncmp r10,[r11+16]\njae 3f\ncmp r10,[r11+32]\nja 3f\nmovd xmm6,[rsi]\nmovd xmm4,[rsi+rcx]\npunpckldq xmm6,xmm4\nmovd xmm7,[rsi+rcx*2]\nmovd xmm4,[rsi+rdx]\npunpckldq xmm7,xmm4\npunpcklbw xmm6,xmm15\npunpcklbw xmm7,xmm15\npaddw xmm0,xmm6\npaddw xmm1,xmm7\nadd rsi,4\ninc qword ptr [r11+56]\ninc r10\njmp 2b\n3:\nxor r10d,r10d\n4:\nmov rax,[r11+56]\ncmp rax,[r11+64]\nje 5f\nmov [r11+64],rax\nshl rax,3\nadd rax,[r11+40]\nmov rax,[rax]\nmovzx edi,ax\nmovd xmm8,edi\npshuflw xmm8,xmm8,0\npshufd xmm8,xmm8,0\nshr eax,16\nmovd xmm9,eax\npshuflw xmm9,xmm9,0\npshufd xmm9,xmm9,0\n5:\nmovdqa xmm2,xmm0\npmulhuw xmm2,xmm8\nmovdqa xmm4,xmm0\npmullw xmm4,xmm9\npaddw xmm2,xmm4\npaddw xmm2,xmm10\npsrlw xmm2,3\nmovdqa xmm3,xmm1\npmulhuw xmm3,xmm8\nmovdqa xmm5,xmm1\npmullw xmm5,xmm9\npaddw xmm3,xmm5\npaddw xmm3,xmm10\npsrlw xmm3,3\npackuswb xmm2,xmm3\npand xmm2,xmm11\nlea rax,[r9+r10*4]\nmovd [rax],xmm2\npsrldq xmm2,4\nmovd [rax+rcx],xmm2\npsrldq xmm2,4\nmovd [rax+rcx*2],xmm2\npsrldq xmm2,4\nmovd [rax+rdx],xmm2\nmov rax,r10\nadd rax,[r11+32]\ninc rax\ncmp rax,[r11+16]\njae 6f\nlea rsi,[r8+rax*4]\nmovd xmm6,[rsi]\nmovd xmm4,[rsi+rcx]\npunpckldq xmm6,xmm4\nmovd xmm7,[rsi+rcx*2]\nmovd xmm4,[rsi+rdx]\npunpckldq xmm7,xmm4\npunpcklbw xmm6,xmm15\npunpcklbw xmm7,xmm15\npaddw xmm0,xmm6\npaddw xmm1,xmm7\ninc qword ptr [r11+56]\n6:\ncmp r10,[r11+32]\njb 7f\nmov rax,r10\nsub rax,[r11+32]\nlea rsi,[r8+rax*4]\nmovd xmm6,[rsi]\nmovd xmm4,[rsi+rcx]\npunpckldq xmm6,xmm4\nmovd xmm7,[rsi+rcx*2]\nmovd xmm4,[rsi+rdx]\npunpckldq xmm7,xmm4\npunpcklbw xmm6,xmm15\npunpcklbw xmm7,xmm15\npsubw xmm0,xmm6\npsubw xmm1,xmm7\ndec qword ptr [r11+56]\n7:\ninc r10\ncmp r10,[r11+16]\njb 4b\nmov rax,[r11+72]\ntest rax,rax\njz 92f\npopfq\n92:\nmov rax,rcx\nshl rax,2\nadd r8,rax\nadd r9,rax\nmov rax,[r11+24]\ndec rax\nmov [r11+24],rax\njnz 1b\nmovdqu xmm0,[r11+96]\nmovdqu xmm1,[r11+112]\nmovdqu xmm2,[r11+128]\nmovdqu xmm3,[r11+144]\nmovdqu xmm4,[r11+160]\nmovdqu xmm5,[r11+176]\nmovdqu xmm6,[r11+192]\nmovdqu xmm7,[r11+208]\nmovdqu xmm8,[r11+224]\nmovdqu xmm9,[r11+240]\nmovdqu xmm10,[r11+256]\nmovdqu xmm11,[r11+272]\nmovdqu xmm12,[r11+288]\nmovdqu xmm13,[r11+304]\nmovdqu xmm14,[r11+320]\nmovdqu xmm15,[r11+336]\n0:",
            in("rdi") (&blk[0]) as u64,
            clobber("rax"),
            clobber("rcx"),
            clobber("rdx"),
            clobber("rsi"),
            clobber("rdi"),
            clobber("r8"),
            clobber("r9"),
            clobber("r10"),
            clobber("r11"),
            clobber("memory"))
        blk[9] = 0
        blk[0] = source +% done *% w *% 4
        blk[1] = target +% done *% w *% 4
        blk[2] = w
        blk[3] = h - done
    }
    asm("mov rdx,rdi\nmov rax,[rdx+24]\ntest rax,rax\njz 0f\nmov rax,[rdx+16]\ntest rax,rax\njz 0f\nmov rsi,[rdx]\nmov rdi,[rdx+8]\n1:\nxor r8d,r8d\nxor r9d,r9d\nxor r10d,r10d\n2:\ncmp r10,[rdx+16]\njae 3f\ncmp r10,[rdx+32]\nja 3f\nmov eax,[rsi+r10*4]\nmov ecx,eax\nand ecx,16711935\nand eax,65280\nshl rax,24\nor rax,rcx\nadd r8,rax\ninc r9\ninc r10\njmp 2b\n3:\nxor r10d,r10d\n4:\nmov rcx,[rdx+40]\nmov rcx,[rcx+r9*8]\nmov rax,r8\nmovzx eax,ax\nimul rax,rcx\nadd rax,262144\nshr rax,19\nmov r11,r8\nshr r11,16\nmovzx r11d,r11w\nimul r11,rcx\nadd r11,262144\nshr r11,19\nshl r11d,16\nor eax,r11d\nmov r11,r8\nshr r11,32\nmovzx r11d,r11w\nimul r11,rcx\nadd r11,262144\nshr r11,19\nshl r11d,8\nor eax,r11d\nmov [rdi+r10*4],eax\nmov rax,[rdx+32]\nlea rax,[rax+r10+1]\ncmp rax,[rdx+16]\njae 5f\nmov eax,[rsi+rax*4]\nmov ecx,eax\nand ecx,16711935\nand eax,65280\nshl rax,24\nor rax,rcx\nadd r8,rax\ninc r9\n5:\ncmp r10,[rdx+32]\njb 6f\nmov rax,r10\nsub rax,[rdx+32]\nmov eax,[rsi+rax*4]\nmov ecx,eax\nand ecx,16711935\nand eax,65280\nshl rax,24\nor rax,rcx\nsub r8,rax\ndec r9\n6:\ninc r10\ncmp r10,[rdx+16]\njb 4b\nmov rax,[rdx+16]\nshl rax,2\nadd rsi,rax\nadd rdi,rax\nmov rax,[rdx+24]\ndec rax\nmov [rdx+24],rax\njnz 1b\n0:",
        in("rdi") (&blk[0]) as u64,
        clobber("rax"),
        clobber("rcx"),
        clobber("rdx"),
        clobber("rsi"),
        clobber("rdi"),
        clobber("r8"),
        clobber("r9"),
        clobber("r10"),
        clobber("r11"),
        clobber("memory"))
}

fn blur_v(state: u64, source: u64, target: u64, w: u64, h: u64, r: u64, rt: u64, simd: bool) {
    let sum: u64 = wmlayout.gs(state, wmlayout.S_BC_SUM)
    if sum == 0 {
        return
    }

    var blk: [u64; 44] = [0 as u64; 44]
    var c4: u64 = 0
    if simd && w >= 4 {
        c4 = w - (w & 3)
        blk[0] = source
        blk[1] = target
        blk[2] = c4
        blk[3] = h
        blk[4] = r
        blk[5] = rt
        blk[6] = sum
        blk[10] = 1
        blk[11] = w
        asm("mov r11,rdi\nmov rax,[r11+16]\ntest rax,rax\njz 0f\nmov rax,[r11+24]\ntest rax,rax\njz 0f\nmovdqu [r11+96],xmm0\nmovdqu [r11+112],xmm1\nmovdqu [r11+128],xmm2\nmovdqu [r11+144],xmm3\nmovdqu [r11+160],xmm4\nmovdqu [r11+176],xmm5\nmovdqu [r11+192],xmm6\nmovdqu [r11+208],xmm7\nmovdqu [r11+224],xmm8\nmovdqu [r11+240],xmm9\nmovdqu [r11+256],xmm10\nmovdqu [r11+272],xmm11\nmovdqu [r11+288],xmm12\nmovdqu [r11+304],xmm13\nmovdqu [r11+320],xmm14\nmovdqu [r11+336],xmm15\nmov r8,[r11+48]\ncld\nxor eax,eax\nmov rdi,r8\nmov rcx,[r11+16]\nrep stosq\nlea rdi,[r8+27520]\nmov rcx,[r11+16]\nrep stosq\nxor r10d,r10d\nxor r9d,r9d\n1:\ncmp r10,[r11+32]\nja 4f\ncmp r10,[r11+24]\njae 4f\nmov rsi,r10\nimul rsi,[r11+88]\nmov rax,[r11]\nlea rsi,[rax+rsi*4]\nmov rax,[r11+80]\ntest rax,rax\njz 91f\npushfq\ncli\n91:\npxor xmm15,xmm15\nmov rax,r8\nmov rcx,[r11+16]\nshr rcx,2\n2:\nmovdqu xmm4,[rsi]\nmovdqa xmm5,xmm4\npunpcklbw xmm4,xmm15\npunpckhbw xmm5,xmm15\nmovdqu xmm6,[rax]\npaddw xmm6,xmm4\nmovdqu [rax],xmm6\nmovdqu xmm7,[rax+16]\npaddw xmm7,xmm5\nmovdqu [rax+16],xmm7\nadd rsi,16\nadd rax,32\ndec rcx\njnz 2b\nmov rax,[r11+80]\ntest rax,rax\njz 92f\npopfq\n92:\ninc r9\ninc r10\njmp 1b\n4:\nmov [r11+64],r9\nxor eax,eax\nmov [r11+56],rax\n5:\nmov rax,[r11+80]\ntest rax,rax\njz 91f\npushfq\ncli\n91:\npxor xmm15,xmm15\nmov eax,4\nmovd xmm10,eax\npshuflw xmm10,xmm10,0\npshufd xmm10,xmm10,0\npcmpeqd xmm11,xmm11\npsrld xmm11,8\nmov rax,[r11+40]\nmov rcx,[r11+64]\nmov rax,[rax+rcx*8]\nmovzx ecx,ax\nmovd xmm8,ecx\npshuflw xmm8,xmm8,0\npshufd xmm8,xmm8,0\nshr eax,16\nmovd xmm9,eax\npshuflw xmm9,xmm9,0\npshufd xmm9,xmm9,0\nlea rsi,[r8+27520]\nmov rax,[r11+56]\nadd rax,[r11+32]\ninc rax\ncmp rax,[r11+24]\njae 6f\nimul rax,[r11+88]\nmov rsi,[r11]\nlea rsi,[rsi+rax*4]\n6:\nlea rdi,[r8+27520]\nmov rax,[r11+56]\ncmp rax,[r11+32]\njb 7f\nsub rax,[r11+32]\nimul rax,[r11+88]\nmov rdi,[r11]\nlea rdi,[rdi+rax*4]\n7:\nmov rdx,[r11+8]\nmov rax,r8\nmov rcx,[r11+16]\nshr rcx,2\n3:\nmovdqu xmm0,[rax]\nmovdqu xmm1,[rax+16]\nmovdqa xmm2,xmm0\npmulhuw xmm2,xmm8\nmovdqa xmm4,xmm0\npmullw xmm4,xmm9\npaddw xmm2,xmm4\npaddw xmm2,xmm10\npsrlw xmm2,3\nmovdqa xmm3,xmm1\npmulhuw xmm3,xmm8\nmovdqa xmm5,xmm1\npmullw xmm5,xmm9\npaddw xmm3,xmm5\npaddw xmm3,xmm10\npsrlw xmm3,3\npackuswb xmm2,xmm3\npand xmm2,xmm11\nmovdqu [rdx],xmm2\nmovdqu xmm4,[rsi]\nmovdqa xmm5,xmm4\npunpcklbw xmm4,xmm15\npunpckhbw xmm5,xmm15\npaddw xmm0,xmm4\npaddw xmm1,xmm5\nmovdqu xmm4,[rdi]\nmovdqa xmm5,xmm4\npunpcklbw xmm4,xmm15\npunpckhbw xmm5,xmm15\npsubw xmm0,xmm4\npsubw xmm1,xmm5\nmovdqu [rax],xmm0\nmovdqu [rax+16],xmm1\nadd rax,32\nadd rdx,16\nadd rsi,16\nadd rdi,16\ndec rcx\njnz 3b\nmov rax,[r11+80]\ntest rax,rax\njz 92f\npopfq\n92:\nmov rax,[r11+56]\nadd rax,[r11+32]\ninc rax\ncmp rax,[r11+24]\njae 8f\nmov rax,[r11+64]\ninc rax\nmov [r11+64],rax\n8:\nmov rax,[r11+56]\ncmp rax,[r11+32]\njb 9f\nmov rax,[r11+64]\ndec rax\nmov [r11+64],rax\n9:\nmov rax,[r11+88]\nshl rax,2\nadd [r11+8],rax\nmov rax,[r11+56]\ninc rax\nmov [r11+56],rax\ncmp rax,[r11+24]\njb 5b\nmovdqu xmm0,[r11+96]\nmovdqu xmm1,[r11+112]\nmovdqu xmm2,[r11+128]\nmovdqu xmm3,[r11+144]\nmovdqu xmm4,[r11+160]\nmovdqu xmm5,[r11+176]\nmovdqu xmm6,[r11+192]\nmovdqu xmm7,[r11+208]\nmovdqu xmm8,[r11+224]\nmovdqu xmm9,[r11+240]\nmovdqu xmm10,[r11+256]\nmovdqu xmm11,[r11+272]\nmovdqu xmm12,[r11+288]\nmovdqu xmm13,[r11+304]\nmovdqu xmm14,[r11+320]\nmovdqu xmm15,[r11+336]\n0:",
            in("rdi") (&blk[0]) as u64,
            clobber("rax"),
            clobber("rcx"),
            clobber("rdx"),
            clobber("rsi"),
            clobber("rdi"),
            clobber("r8"),
            clobber("r9"),
            clobber("r10"),
            clobber("r11"),
            clobber("memory"))
    }
    if c4 < w {
        blk[0] = source +% c4 *% 4
        blk[1] = target +% c4 *% 4
        blk[2] = w - c4
        blk[3] = h
        blk[4] = r
        blk[5] = rt
        blk[6] = sum +% c4 *% 8
        blk[10] = 0
        blk[11] = w
        asm("mov rdx,rdi\nmov rax,[rdx+24]\ntest rax,rax\njz 0f\nmov rax,[rdx+16]\ntest rax,rax\njz 0f\nmov r8,[rdx+48]\ncld\nxor eax,eax\nmov rdi,r8\nmov rcx,[rdx+16]\nrep stosq\nlea rdi,[r8+27520]\nmov rcx,[rdx+16]\nrep stosq\nxor r10d,r10d\nxor r9d,r9d\n1:\ncmp r10,[rdx+32]\nja 4f\ncmp r10,[rdx+24]\njae 4f\nmov rsi,r10\nimul rsi,[rdx+88]\nmov rax,[rdx]\nlea rsi,[rax+rsi*4]\nxor edi,edi\n2:\nmov eax,[rsi+rdi*4]\nmov ecx,eax\nand ecx,16711935\nand eax,65280\nshl rax,24\nor rax,rcx\nadd [r8+rdi*8],rax\ninc rdi\ncmp rdi,[rdx+16]\njb 2b\ninc r9\ninc r10\njmp 1b\n4:\nmov [rdx+64],r9\nxor eax,eax\nmov [rdx+56],rax\n5:\nmov rax,[rdx+40]\nmov rcx,[rdx+64]\nmov rax,[rax+rcx*8]\nmov [rdx+72],rax\nmov rax,[rdx+56]\nadd rax,[rdx+32]\ninc rax\nlea rsi,[r8+27520]\ncmp rax,[rdx+24]\njae 6f\nimul rax,[rdx+88]\nmov rsi,[rdx]\nlea rsi,[rsi+rax*4]\n6:\nlea r9,[r8+27520]\nmov rax,[rdx+56]\ncmp rax,[rdx+32]\njb 7f\nsub rax,[rdx+32]\nimul rax,[rdx+88]\nmov r9,[rdx]\nlea r9,[r9+rax*4]\n7:\nmov r10,[rdx+8]\nxor edi,edi\n8:\nmov rax,[r8+rdi*8]\nmovzx ecx,ax\nimul rcx,[rdx+72]\nadd rcx,262144\nshr rcx,19\nmov r11,rax\nshr r11,16\nmovzx r11d,r11w\nimul r11,[rdx+72]\nadd r11,262144\nshr r11,19\nshl r11d,16\nor ecx,r11d\nshr rax,32\nmovzx eax,ax\nimul rax,[rdx+72]\nadd rax,262144\nshr rax,19\nshl eax,8\nor eax,ecx\nmov [r10+rdi*4],eax\nmov rax,[r8+rdi*8]\nmov ecx,[rsi+rdi*4]\nmov r11d,ecx\nand ecx,16711935\nand r11d,65280\nshl r11,24\nor rcx,r11\nadd rax,rcx\nmov ecx,[r9+rdi*4]\nmov r11d,ecx\nand ecx,16711935\nand r11d,65280\nshl r11,24\nor rcx,r11\nsub rax,rcx\nmov [r8+rdi*8],rax\ninc rdi\ncmp rdi,[rdx+16]\njb 8b\nmov rax,[rdx+56]\nadd rax,[rdx+32]\ninc rax\ncmp rax,[rdx+24]\njae 9f\nmov rax,[rdx+64]\ninc rax\nmov [rdx+64],rax\n9:\nmov rax,[rdx+56]\ncmp rax,[rdx+32]\njb 3f\nmov rax,[rdx+64]\ndec rax\nmov [rdx+64],rax\n3:\nmov rax,[rdx+88]\nshl rax,2\nadd [rdx+8],rax\nmov rax,[rdx+56]\ninc rax\nmov [rdx+56],rax\ncmp rax,[rdx+24]\njb 5b\n0:",
            in("rdi") (&blk[0]) as u64,
            clobber("rax"),
            clobber("rcx"),
            clobber("rdx"),
            clobber("rsi"),
            clobber("rdi"),
            clobber("r8"),
            clobber("r9"),
            clobber("r10"),
            clobber("r11"),
            clobber("memory"))
    }
}

fn blur_noise(x: u64, y: u64, amp: u64) -> u64 {
    if amp == 0 {
        return 0
    }

    var v: u64 = x *% 73856093
    v = v ^ (y *% 19349663)
    v = v ^ (v >> 13)
    v = v *% 2654435761
    v = v ^ (v >> 15)
    return v % (amp *% 2 + 1)
}

fn blur_mix(colour: u64, ton: u64, tint: u64, amp: u64, x: u64,
    y: u64) -> u64 {
    var c: u64 = colour
    if tint != 0 {
        c = wmdraw.mix24(c, ton, tint)
    }
    if amp == 0 {
        return c
    }
    let d: u64 = blur_noise(x, y, amp)

    var r: u64 = (c >> 16) & 255
    var g: u64 = (c >> 8) & 255
    var b: u64 = c & 255
    if d >= amp {
        let auf: u64 = d - amp
        r = r + auf
        g = g + auf
        b = b + auf
        if r > 255 {
            r = 255
        }
        if g > 255 {
            g = 255
        }
        if b > 255 {
            b = 255
        }
    } else {
        let ab: u64 = amp - d
        if r > ab {
            r = r - ab
        } else {
            r = 0
        }
        if g > ab {
            g = g - ab
        } else {
            g = 0
        }
        if b > ab {
            b = b - ab
        } else {
            b = 0
        }
    }
    return (r << 16) | (g << 8) | b
}

fn blur_slot(state: u64, i: u64, x0: u64, y0: u64, w: u64,
    h: u64) -> u64 {
    var k: u64 = 0
    while k < wmbase.BC_N {
        if wmlayout.gs(state, wmlayout.S_BC_WIN + k * 8) == i + 1
            && wmlayout.gs(state, wmlayout.S_BC_X + k * 8) == x0
            && wmlayout.gs(state, wmlayout.S_BC_Y + k * 8) == y0
            && wmlayout.gs(state, wmlayout.S_BC_W + k * 8) == w
            && wmlayout.gs(state, wmlayout.S_BC_H + k * 8) == h {
            return k
        }
        k = k + 1
    }
    return wmbase.BC_N
}

fn blur_free(state: u64) -> u64 {
    var k: u64 = 0
    while k < wmbase.BC_N {
        if wmlayout.gs(state, wmlayout.S_BC_WIN + k * 8) == 0 {
            return k
        }
        k = k + 1
    }
    let n: u64 = wmlayout.gs(state, wmlayout.S_BC_NEXT) % wmbase.BC_N
    wmlayout.ss(state, wmlayout.S_BC_NEXT, n + 1)
    return n
}

fn covers_screen(state: u64, i: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }

    let l: u64 = wmlayout.wg(state, i, wmlayout.W_LAYER)
    if l == wmlayout.L_DESK || l == wmlayout.L_NORMAL {
        return false
    }
    return wmbase.win_x(state, i) <= 0 && wmbase.win_y(state, i) <= 0
        && wmlayout.wg(state, i, wmlayout.W_W) >= wmlayout.gs(state, wmlayout.S_SW)
        && wmlayout.wg(state, i, wmlayout.W_H) >= wmlayout.gs(state, wmlayout.S_SH)
}

fn blur_will(state: u64, i: u64) -> bool {
    if wmgeom.form(state, wmlayout.FM_BLUR) == 0 {
        return false
    }
    if !wmbase.valid(state, i) {
        return false
    }
    if covers_screen(state, i) {
        return false
    }
    if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & (wmlayout.F_HIDDEN | wmlayout.F_TABBED)) != 0 {
        return false
    }
    let l: u64 = wmlayout.wg(state, i, wmlayout.W_LAYER)

    if l == wmlayout.L_TOP || l == wmlayout.L_MENU || l == wmlayout.L_POPUP || l == wmlayout.L_TIP {
        return true
    }
    return false
}

fn win_opac(state: u64, i: u64) -> u64 {
    if !wmbase.valid(state, i) {
        return 255
    }
    let v: u64 = wmlayout.wg(state, i, wmlayout.W_OPAC)
    if v == 0 {
        return 255
    }
    return v - 1
}

fn set_opac(state: u64, i: u64, v: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    var w: u64 = v
    if w > 255 {
        w = 255
    }
    wmlayout.wsv(state, i, wmlayout.W_OPAC, w + 1)
    wmdamage.damage_win(state, i)
    return true
}

const BL_MEAN: u64 = 0

const BL_HI: u64 = 1

const BL_LO: u64 = 2

const BL_RUNS: u64 = 3

const BL_HITS: u64 = 4

fn bl_pixel(state: u64, i: u64, px: i64, py: i64) -> u64 {
    var c: u64 = wmlayout.gs(state, wmlayout.S_DESK) & wmdraw.RGB24
    let zi: u64 = win_z(state, i)
    var z: u64 = 0
    while z < zi {
        let j: u64 = wmbase.at_z(state, z)
        z = z + 1
        if j >= wmbase.MAX_WIN || j == i {
            continue
        }
        if (wmlayout.wg(state, j, wmlayout.W_FLAGS) & (wmlayout.F_HIDDEN | wmlayout.F_TABBED)) != 0 || !wmgate.input_allowed(state, j) {
            continue
        }
        let ox: i64 = wmbase.win_x(state, j)
        let oy: i64 = wmbase.win_y(state, j)
        if px < ox || py < oy || px >= ox + wmbase.outer_w(state, j) as i64 || py >= oy + wmbase.outer_h(state, j) as i64 {
            continue
        }
        var p: u64 = 0
        let cx: i64 = px - ox - wmbase.inx(state, j) as i64
        let cy: i64 = py - oy - wmbase.iny(state, j) as i64
        if cx >= 0 && cy >= 0 && cx < win_w(state, j) as i64 && cy < win_h(state, j) as i64 {
            p = wmdraw.wget(state, j, cx as u64, cy as u64) & wmdraw.RGB24
        } else if cy < 0 || (py - oy) < wmbase.iny(state, j) as i64 {
            p = wmbase.deco_rgb(state, wmlayout.DK_TITLE) & wmdraw.RGB24
        } else {
            p = wmbase.deco_rgb(state, wmlayout.DK_FRAME) & wmdraw.RGB24
        }
        let a: u64 = win_opac(state, j)
        if a >= 255 {
            c = p
        } else {
            let r: u64 = (((c >> 16) & 0xFF) * (255 - a) + ((p >> 16) & 0xFF) * a) / 255
            let g: u64 = (((c >> 8) & 0xFF) * (255 - a) + ((p >> 8) & 0xFF) * a) / 255
            let b: u64 = ((c & 0xFF) * (255 - a) + (p & 0xFF) * a) / 255
            c = (r << 16) | (g << 8) | b
        }
    }
    return c
}

fn bl_measure(state: u64, i: u64, x0: i64, y0: i64, w: u64, h: u64) {
    var sum: u64 = 0
    var hi1: u64 = 0
    var hi2: u64 = 0
    var lo1: u64 = 65536
    var lo2: u64 = 65536
    var iy: u64 = 0
    while iy < BL_NY {
        var ix: u64 = 0
        while ix < BL_NX {
            let px: i64 = x0 + ((2 * ix + 1) * w / (2 * BL_NX)) as i64
            let py: i64 = y0 + ((2 * iy + 1) * h / (2 * BL_NY)) as i64
            let l: u64 = backlum.lum_q16(bl_pixel(state, i, px, py))
            sum = sum + l
            if l > hi1 {
                hi2 = hi1
                hi1 = l
            } else if l > hi2 {
                hi2 = l
            }
            if l < lo1 {
                lo2 = lo1
                lo1 = l
            } else if l < lo2 {
                lo2 = l
            }
            ix = ix + 1
        }
        iy = iy + 1
    }
    wmlayout.wsv(state, i, wmlayout.W_BL_MEAN, sum / (BL_NX * BL_NY) + 1)
    wmlayout.wsv(state, i, wmlayout.W_BL_HI, hi2)
    wmlayout.wsv(state, i, wmlayout.W_BL_LO, lo2)
    wmlayout.wsv(state, i, wmlayout.W_BL_RUNS, wmlayout.wg(state, i, wmlayout.W_BL_RUNS) + 1)
}

fn backlum(state: u64, i: u64, which: u64) -> u64 {
    if !wmbase.valid(state, i) {
        return 0
    }
    if which == BL_RUNS {
        return wmlayout.wg(state, i, wmlayout.W_BL_RUNS)
    }
    if which == BL_HITS {
        return wmlayout.wg(state, i, wmlayout.W_BL_HITS)
    }
    var x0: i64 = wmbase.win_x(state, i)
    var y0: i64 = wmbase.win_y(state, i)
    var x1: i64 = x0 + wmbase.outer_w(state, i) as i64
    var y1: i64 = y0 + wmbase.outer_h(state, i) as i64
    if x0 < 0 {
        x0 = 0
    }
    if y0 < 0 {
        y0 = 0
    }
    if x1 > wmlayout.gs(state, wmlayout.S_SW) as i64 {
        x1 = wmlayout.gs(state, wmlayout.S_SW) as i64
    }
    if y1 > wmlayout.gs(state, wmlayout.S_SH) as i64 {
        y1 = wmlayout.gs(state, wmlayout.S_SH) as i64
    }
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    let kxy: u64 = (((x0 + 32768) as u64) << 32) | ((y0 + 32768) as u64)
    let kwh: u64 = (((x1 - x0) as u64) << 32) | ((y1 - y0) as u64)
    if wmlayout.wg(state, i, wmlayout.W_BL_MEAN) != 0 && wmlayout.wg(state, i, wmlayout.W_BL_XY) == kxy && wmlayout.wg(state, i, wmlayout.W_BL_WH) == kwh {
        wmlayout.wsv(state, i, wmlayout.W_BL_HITS, wmlayout.wg(state, i, wmlayout.W_BL_HITS) + 1)
    } else {
        bl_measure(state, i, x0, y0, (x1 - x0) as u64, (y1 - y0) as u64)
        wmlayout.wsv(state, i, wmlayout.W_BL_XY, kxy)
        wmlayout.wsv(state, i, wmlayout.W_BL_WH, kwh)
    }
    if which == BL_HI {
        return wmlayout.wg(state, i, wmlayout.W_BL_HI)
    }
    if which == BL_LO {
        return wmlayout.wg(state, i, wmlayout.W_BL_LO)
    }
    return wmlayout.wg(state, i, wmlayout.W_BL_MEAN) - 1
}

fn win_durch(state: u64, i: u64) -> bool {
    return win_opac(state, i) < 255
}

fn fb_row_mix(state: u64, x: u64, y: u64, src: u64, n: u64, a: u64) {
    if y < fb.band_lo(state) {
        return
    }
    if a >= 255 {
        wmdraw.fb_row(state, x, y, src, n)
        return
    }
    let target: u64 = fb.draw_at(state) +% y *% fb.pitch(state) +% x *% 4
    comp.mix_row(target, src, n, a)
}

fn blur_cache_on(state: u64) -> bool {
    return wmlayout.gs(state, wmlayout.S_BC_AUS) == 0
}

fn blur_an(state: u64) -> bool {
    return wmgeom.form(state, wmlayout.FM_BLUR) != 0
}

fn blur_radius(state: u64) -> u64 {
    return wmgeom.form(state, wmlayout.FM_BLUR)
}

fn blur_buffers(state: u64, bytes: u64) -> bool {
    if wmlayout.gs(state, wmlayout.S_BC_SUM) == 0 {
        let sb: u64 = 3 *% BLUR_W_MAX *% 8
        let sr: u64 = (sb + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
        let sp: u64 = mem.frame_run(state, sr)
        if sp == 0 {
            return false
        }
        wmlayout.ss(state, wmlayout.S_BC_SUM, sp)
    }

    if wmlayout.gs(state, wmlayout.S_BC_EIN) >= bytes && wmlayout.gs(state, wmlayout.S_BC_BUF) != 0 {
        return true
    }
    if wmlayout.gs(state, wmlayout.S_BC_BUF) != 0 {
        mem.frame_free_run(state, wmlayout.gs(state, wmlayout.S_BC_BUF),
            wmlayout.gs(state, wmlayout.S_BC_BYTES) / mem.FRAME_SIZE)
        wmlayout.ss(state, wmlayout.S_BC_BUF, 0)
        wmlayout.ss(state, wmlayout.S_BC_BYTES, 0)
        blur_clear(state)
    }
    let seiten: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    let ein: u64 = seiten *% mem.FRAME_SIZE
    let frame: u64 = ein *% (wmbase.BC_N + 1) / mem.FRAME_SIZE
    let bp: u64 = mem.frame_run(state, frame)
    if bp == 0 {
        return false
    }
    wmlayout.ss(state, wmlayout.S_BC_BUF, bp)
    wmlayout.ss(state, wmlayout.S_BC_BYTES, frame *% mem.FRAME_SIZE)
    wmlayout.ss(state, wmlayout.S_BC_EIN, ein)
    blur_clear(state)
    return true
}

fn blur_clear(state: u64) {
    var k: u64 = 0
    while k < wmbase.BC_N {
        wmlayout.ss(state, wmlayout.S_BC_WIN + k * 8, 0)
        k = k + 1
    }
    wmlayout.ss(state, wmlayout.S_BC_NEXT, 0)
}

fn blur_hit_ok(state: u64, i: u64) -> bool {
    if wmlayout.gs(state, wmlayout.S_BC_AUS) != 0 {
        return false
    }
    var x0: i64 = wmbase.win_x(state, i)
    var y0: i64 = wmbase.win_y(state, i)
    var x1: i64 = x0 + wmbase.outer_w(state, i) as i64
    var y1: i64 = y0 + wmbase.outer_h(state, i) as i64
    if x0 < 0 {
        x0 = 0
    }
    if y0 < fb.band_lo(state) as i64 {
        y0 = fb.band_lo(state) as i64
    }
    if x1 > wmlayout.gs(state, wmlayout.S_SW) as i64 {
        x1 = wmlayout.gs(state, wmlayout.S_SW) as i64
    }
    if y1 > wmlayout.gs(state, wmlayout.S_SH) as i64 {
        y1 = wmlayout.gs(state, wmlayout.S_SH) as i64
    }
    if x1 <= x0 || y1 <= y0 {
        return false
    }
    let tr: u64 = blur_slot(state, i, x0 as u64, y0 as u64, (x1 - x0) as u64, (y1 - y0) as u64)
    if tr >= wmbase.BC_N {
        return false
    }
    return wmlayout.gs(state, wmlayout.S_BC_HIT + tr * 8) == wmlayout.gs(state, wmlayout.S_BC_GEN + tr * 8)
}

fn rim_mix(c: u64, pct: u64) -> u64 {
    let r: u64 = (((c >> 16) & 255) *% (100 - pct) + 255 *% pct) / 100
    let g: u64 = (((c >> 8) & 255) *% (100 - pct) + 255 *% pct) / 100
    let b: u64 = ((c & 255) *% (100 - pct) + 255 *% pct) / 100
    return (c & 0xFF000000) | (r << 16) | (g << 8) | b
}

fn blur_area(state: u64, i: u64, bx0: i64, by0: i64, bx1: i64,
    by1: i64, ton: u64, kx0: i64, ky0: i64, kx1: i64, ky1: i64) {
    let r: u64 = wmgeom.form(state, wmlayout.FM_BLUR)
    if r == 0 {
        return
    }
    var x0: i64 = bx0
    var y0: i64 = by0
    var x1: i64 = bx1
    var y1: i64 = by1
    if x0 < 0 {
        x0 = 0
    }
    if y0 < fb.band_lo(state) as i64 {
        y0 = fb.band_lo(state) as i64
    }
    if x1 > wmlayout.gs(state, wmlayout.S_SW) as i64 {
        x1 = wmlayout.gs(state, wmlayout.S_SW) as i64
    }
    if y1 > wmlayout.gs(state, wmlayout.S_SH) as i64 {
        y1 = wmlayout.gs(state, wmlayout.S_SH) as i64
    }
    if x1 <= x0 || y1 <= y0 {
        return
    }
    let w: u64 = (x1 - x0) as u64
    let h: u64 = (y1 - y0) as u64
    if w > BLUR_W_MAX {
        return
    }
    let bytes: u64 = w *% h *% 4
    if !blur_buffers(state, bytes) {
        return
    }

    let ein: u64 = wmlayout.gs(state, wmlayout.S_BC_EIN)
    let a: u64 = wmlayout.gs(state, wmlayout.S_BC_BUF) +% wmbase.BC_N *% ein

    let refm: bool = pixelguard.rendering()
    var tr: u64 = wmbase.BC_N
    if !refm {
        tr = blur_slot(state, i, x0 as u64, y0 as u64, w, h)
    }
    if tr < wmbase.BC_N && wmlayout.gs(state, wmlayout.S_BC_AUS) == 0
        && wmlayout.gs(state, wmlayout.S_BC_HIT + tr * 8) == wmlayout.gs(state, wmlayout.S_BC_GEN + tr * 8) {
        let bq: u64 = wmlayout.gs(state, wmlayout.S_BC_BUF) +% tr *% ein

        var cx0: i64 = x0
        var cy0: i64 = y0
        var cx1: i64 = x1
        var cy1: i64 = y1
        if kx0 > cx0 {
            cx0 = kx0
        }
        if ky0 > cy0 {
            cy0 = ky0
        }
        if kx1 < cx1 {
            cx1 = kx1
        }
        if ky1 < cy1 {
            cy1 = ky1
        }
        if cx1 > cx0 && cy1 > cy0 {
            let cw: u64 = (cx1 - cx0) as u64
            let off: u64 = (cx0 - x0) as u64
            var yy: u64 = (cy0 - y0) as u64
            let ye: u64 = (cy1 - y0) as u64
            while yy < ye {
                wmdraw.fb_row(state, cx0 as u64, y0 as u64 + yy,
                    bq +% yy *% w *% 4 +% off *% 4, cw)
                yy = yy + 1
            }
        }
        wmlayout.ss(state, wmlayout.S_BLURCACHE, wmlayout.gs(state, wmlayout.S_BLURCACHE) + 1)
        return
    }

    var sl: u64 = tr
    var b: u64 = 0
    if refm {
        b = pixelguard.blur_scratch(state, bytes)
        if b == 0 {
            return
        }
    } else {
        if sl >= wmbase.BC_N {
            sl = blur_free(state)
        }
        b = wmlayout.gs(state, wmlayout.S_BC_BUF) +% sl *% ein
    }

    let t0: u64 = time.tsc()

    var yy: u64 = 0
    while yy < h {
        let row: u64 = (y0 as u64 + yy) *% fb.pitch(state)
        let source: u64 = fb.draw_at(state) +% row +% x0 as u64 *% 4
        wmdraw.copy_words(a +% yy *% w *% 4, source, w *% 4 / 8)
        if (w & 1) != 0 {
            __mmio_write32((a +% yy *% w *% 4 +% (w - 1) *% 4) as *mut u32,
                __mmio_read32((source +% (w - 1) *% 4) as *mut u32))
        }
        yy = yy + 1
    }

    var rt: [u64; 40] = [0 as u64; 40]
    var rk: u64 = 1
    while rk < 40 {
        rt[rk as usize] = recip_of(rk)
        rk = rk + 1
    }
    let rtp: u64 = (&rt[0]) as u64
    let simd: bool = fb.simd_ok(state)
    blur_h(a, b, w, h, r, rtp, simd)
    blur_v(state, b, a, w, h, r, rtp, simd)
    blur_h(a, b, w, h, r, rtp, simd)
    blur_v(state, b, a, w, h, r, rtp, simd)

    let tint: u64 = wmgeom.form(state, wmlayout.FM_BLURTINT)
    let amp: u64 = wmgeom.form(state, wmlayout.FM_BLURNOISE)
    let rim: u64 = wmgeom.form(state, wmlayout.FM_BLURRIM)

    var crad: u64 = wmgeom.form(state, wmlayout.FM_RADIUS)
    if crad > wmdraw.RADIUS_MAX {
        crad = wmdraw.RADIUS_MAX
    }
    let wl: i64 = bx0
    let wt: i64 = by0
    let wr: i64 = bx1
    let wb: i64 = by1

    var mblk: [u64; 56] = [0 as u64; 56]
    var tclip: u64 = tint
    if tclip > 100 {
        tclip = 100
    }
    mblk[5] = amp
    mblk[6] = amp *% 2 + 1
    mblk[7] = 100 - tclip
    mblk[8] = ((ton >> 16) & 255) *% tclip
    mblk[9] = ((ton >> 8) & 255) *% tclip
    mblk[10] = (ton & 255) *% tclip

    asm("mov r11,rdi\nmov rcx,[r11+48]\ncmp rcx,3\njb 0f\nbsr rcx,rcx\nmov [r11+104],rcx\nmov edx,1\nshl rdx,cl\nxor eax,eax\nmov rsi,[r11+48]\ndiv rsi\nmov rdi,rdx\nadd rax,rax\nadd rdi,rdi\njc 1f\ncmp rdi,rsi\njb 2f\n1:\ninc rax\n2:\ninc rax\nmov [r11+96],rax\n0:",
        in("rdi") (&mblk[0]) as u64,
        clobber("rax"),
        clobber("rcx"),
        clobber("rdx"),
        clobber("rsi"),
        clobber("rdi"),
        clobber("r8"),
        clobber("r9"),
        clobber("r10"),
        clobber("r11"),
        clobber("memory"))
    var ry: u64 = 0
    while ry < h {
        let qz: u64 = a +% ry *% w *% 4
        let zz: u64 = b +% ry *% w *% 4
        let py: i64 = y0 + ry as i64
        var corner_row: bool = false
        var cyc: i64 = 0
        if crad > 0 {
            if py < wt + crad as i64 {
                corner_row = true
                cyc = wt + crad as i64
            } else if py >= wb - crad as i64 {
                corner_row = true
                cyc = wb - crad as i64
            }
        }

        var ms: u64 = 0
        var me: u64 = w
        if corner_row {
            let lo: i64 = wl + crad as i64 - x0
            let hi: i64 = wr - crad as i64 - x0
            if hi <= lo || hi <= 0 || lo >= w as i64 {
                ms = 0
                me = 0
            } else {
                if lo > 0 {
                    ms = lo as u64
                }
                if hi < w as i64 {
                    me = hi as u64
                }
            }
        }
        var rx: u64 = 0
        while rx < w {
            if rx == ms && me > ms {
                mblk[0] = qz +% ms *% 4
                mblk[1] = zz +% ms *% 4
                mblk[2] = me - ms
                mblk[3] = x0 as u64 + ms
                mblk[4] = (y0 as u64 + ry) *% 19349663

                if simd {
                    mblk[15] = 1
                    asm("mov r11,rdi\nmov rax,[r11+16]\nshr rax,2\njz 0f\nmovdqu [r11+192],xmm0\nmovdqu [r11+208],xmm1\nmovdqu [r11+224],xmm2\nmovdqu [r11+240],xmm3\nmovdqu [r11+256],xmm4\nmovdqu [r11+272],xmm5\nmovdqu [r11+288],xmm6\nmovdqu [r11+304],xmm7\nmovdqu [r11+320],xmm8\nmovdqu [r11+336],xmm9\nmovdqu [r11+352],xmm10\nmovdqu [r11+368],xmm11\nmovdqu [r11+384],xmm12\nmovdqu [r11+400],xmm13\nmovdqu [r11+416],xmm14\nmovdqu [r11+432],xmm15\nmov rdi,rax\nmov r8,[r11]\nmov r9,[r11+8]\nmov r10,[r11+24]\nmov rax,[r11+120]\ntest rax,rax\njz 91f\npushfq\ncli\n91:\npxor xmm0,xmm0\nmov rax,[r11+56]\nmovd xmm1,eax\npshuflw xmm1,xmm1,0\npshufd xmm1,xmm1,0\nmov rax,[r11+80]\nmov rcx,[r11+72]\nshl rcx,16\nor rax,rcx\nmov rcx,[r11+64]\nshl rcx,32\nor rax,rcx\nmovq xmm2,rax\npunpcklqdq xmm2,xmm2\nmov eax,5243\nmovd xmm3,eax\npshuflw xmm3,xmm3,0\npshufd xmm3,xmm3,0\npcmpeqd xmm4,xmm4\npsrld xmm4,8\nmov rax,[r11+40]\ntest rax,rax\njz 3f\n1:\nmov rcx,r10\nimul rcx,rcx,73856093\nxor rcx,[r11+32]\nmov rdx,rcx\nshr rdx,13\nxor rcx,rdx\nmov rax,2654435761\nimul rcx,rax\nmov rdx,rcx\nshr rdx,15\nxor rcx,rdx\nmov rsi,rcx\nmov rax,[r11+96]\nmul rcx\nmov rax,rsi\nsub rax,rdx\nshr rax,1\nadd rax,rdx\nmov rcx,[r11+104]\nshr rax,cl\nimul rax,[r11+48]\nsub rsi,rax\nsub rsi,[r11+40]\nmovzx esi,si\nmov rax,0x0001000100010001\nimul rsi,rax\nmov [r11+128],rsi\nlea rcx,[r10+1]\nimul rcx,rcx,73856093\nxor rcx,[r11+32]\nmov rdx,rcx\nshr rdx,13\nxor rcx,rdx\nmov rax,2654435761\nimul rcx,rax\nmov rdx,rcx\nshr rdx,15\nxor rcx,rdx\nmov rsi,rcx\nmov rax,[r11+96]\nmul rcx\nmov rax,rsi\nsub rax,rdx\nshr rax,1\nadd rax,rdx\nmov rcx,[r11+104]\nshr rax,cl\nimul rax,[r11+48]\nsub rsi,rax\nsub rsi,[r11+40]\nmovzx esi,si\nmov rax,0x0001000100010001\nimul rsi,rax\nmov [r11+136],rsi\nlea rcx,[r10+2]\nimul rcx,rcx,73856093\nxor rcx,[r11+32]\nmov rdx,rcx\nshr rdx,13\nxor rcx,rdx\nmov rax,2654435761\nimul rcx,rax\nmov rdx,rcx\nshr rdx,15\nxor rcx,rdx\nmov rsi,rcx\nmov rax,[r11+96]\nmul rcx\nmov rax,rsi\nsub rax,rdx\nshr rax,1\nadd rax,rdx\nmov rcx,[r11+104]\nshr rax,cl\nimul rax,[r11+48]\nsub rsi,rax\nsub rsi,[r11+40]\nmovzx esi,si\nmov rax,0x0001000100010001\nimul rsi,rax\nmov [r11+144],rsi\nlea rcx,[r10+3]\nimul rcx,rcx,73856093\nxor rcx,[r11+32]\nmov rdx,rcx\nshr rdx,13\nxor rcx,rdx\nmov rax,2654435761\nimul rcx,rax\nmov rdx,rcx\nshr rdx,15\nxor rcx,rdx\nmov rsi,rcx\nmov rax,[r11+96]\nmul rcx\nmov rax,rsi\nsub rax,rdx\nshr rax,1\nadd rax,rdx\nmov rcx,[r11+104]\nshr rax,cl\nimul rax,[r11+48]\nsub rsi,rax\nsub rsi,[r11+40]\nmovzx esi,si\nmov rax,0x0001000100010001\nimul rsi,rax\nmov [r11+152],rsi\nmovdqu xmm6,[r8]\nmovdqa xmm7,xmm6\npunpcklbw xmm6,xmm0\npunpckhbw xmm7,xmm0\npmullw xmm6,xmm1\npmullw xmm7,xmm1\npaddw xmm6,xmm2\npaddw xmm7,xmm2\npmulhuw xmm6,xmm3\npmulhuw xmm7,xmm3\npsrlw xmm6,3\npsrlw xmm7,3\nmovdqu xmm8,[r11+128]\nmovdqu xmm9,[r11+144]\npaddw xmm6,xmm8\npaddw xmm7,xmm9\npackuswb xmm6,xmm7\npand xmm6,xmm4\nmovdqu [r9],xmm6\nadd r8,16\nadd r9,16\nadd r10,4\ndec rdi\njnz 1b\njmp 4f\n3:\nmovdqu xmm6,[r8]\nmovdqa xmm7,xmm6\npunpcklbw xmm6,xmm0\npunpckhbw xmm7,xmm0\npmullw xmm6,xmm1\npmullw xmm7,xmm1\npaddw xmm6,xmm2\npaddw xmm7,xmm2\npmulhuw xmm6,xmm3\npmulhuw xmm7,xmm3\npsrlw xmm6,3\npsrlw xmm7,3\npackuswb xmm6,xmm7\npand xmm6,xmm4\nmovdqu [r9],xmm6\nadd r8,16\nadd r9,16\nadd r10,4\ndec rdi\njnz 3b\n4:\nmov rax,[r11+120]\ntest rax,rax\njz 92f\npopfq\n92:\nmovdqu xmm0,[r11+192]\nmovdqu xmm1,[r11+208]\nmovdqu xmm2,[r11+224]\nmovdqu xmm3,[r11+240]\nmovdqu xmm4,[r11+256]\nmovdqu xmm5,[r11+272]\nmovdqu xmm6,[r11+288]\nmovdqu xmm7,[r11+304]\nmovdqu xmm8,[r11+320]\nmovdqu xmm9,[r11+336]\nmovdqu xmm10,[r11+352]\nmovdqu xmm11,[r11+368]\nmovdqu xmm12,[r11+384]\nmovdqu xmm13,[r11+400]\nmovdqu xmm14,[r11+416]\nmovdqu xmm15,[r11+432]\nmov [r11],r8\nmov [r11+8],r9\nmov [r11+24],r10\nmov rax,[r11+16]\nand rax,3\nmov [r11+16],rax\n0:",
                        in("rdi") (&mblk[0]) as u64,
                        clobber("rax"),
                        clobber("rcx"),
                        clobber("rdx"),
                        clobber("rsi"),
                        clobber("rdi"),
                        clobber("r8"),
                        clobber("r9"),
                        clobber("r10"),
                        clobber("r11"),
                        clobber("memory"))
                }
                asm("mov r11,rdi\nmov rax,[r11+16]\ntest rax,rax\njz 0f\nmov r8,[r11]\nmov r9,[r11+8]\nmov r10,[r11+24]\n1:\nmov rcx,[r11+40]\ntest rcx,rcx\njz 2f\nmov rcx,r10\nimul rcx,rcx,73856093\nxor rcx,[r11+32]\nmov rdx,rcx\nshr rdx,13\nxor rcx,rdx\nmov rax,2654435761\nimul rcx,rax\nmov rdx,rcx\nshr rdx,15\nxor rcx,rdx\nmov rsi,rcx\nmov rax,[r11+96]\nmul rcx\nmov rax,rsi\nsub rax,rdx\nshr rax,1\nadd rax,rdx\nmov rcx,[r11+104]\nshr rax,cl\nimul rax,[r11+48]\nsub rsi,rax\nsub rsi,[r11+40]\nmov [r11+88],rsi\n2:\nmov eax,[r8]\nmov esi,eax\nshr esi,16\nand esi,255\nmov edi,eax\nshr edi,8\nand edi,255\nmov ecx,eax\nand ecx,255\nimul rsi,[r11+56]\nadd rsi,[r11+64]\nimul rsi,rsi,5243\nshr rsi,19\nimul rdi,[r11+56]\nadd rdi,[r11+72]\nimul rdi,rdi,5243\nshr rdi,19\nimul rcx,[r11+56]\nadd rcx,[r11+80]\nimul rcx,rcx,5243\nshr rcx,19\nmov rdx,[r11+40]\ntest rdx,rdx\njz 3f\nmov rdx,[r11+88]\nadd rsi,rdx\nxor eax,eax\ntest rsi,rsi\ncmovs rsi,rax\nmov eax,255\ncmp rsi,rax\ncmova rsi,rax\nadd rdi,rdx\nxor eax,eax\ntest rdi,rdi\ncmovs rdi,rax\nmov eax,255\ncmp rdi,rax\ncmova rdi,rax\nadd rcx,rdx\nxor eax,eax\ntest rcx,rcx\ncmovs rcx,rax\nmov eax,255\ncmp rcx,rax\ncmova rcx,rax\n3:\nshl rsi,16\nshl rdi,8\nor rsi,rdi\nor rsi,rcx\nmov [r9],esi\nadd r8,4\nadd r9,4\ninc r10\nmov rax,[r11+16]\ndec rax\nmov [r11+16],rax\njnz 1b\n0:",
                    in("rdi") (&mblk[0]) as u64,
                    clobber("rax"),
        clobber("rcx"),
        clobber("rdx"),
        clobber("rsi"),
        clobber("rdi"),
        clobber("r8"),
        clobber("r9"),
        clobber("r10"),
        clobber("r11"),
        clobber("memory"))
                rx = me
            } else {
                let c: u64 = __mmio_read32((qz +% rx *% 4) as *mut u32) as u64
                var keep: bool = false
                if corner_row {
                    let pxx: i64 = x0 + rx as i64
                    var cxc: i64 = 0
                    var in_col: bool = false
                    if pxx < wl + crad as i64 {
                        in_col = true
                        cxc = wl + crad as i64
                    } else if pxx >= wr - crad as i64 {
                        in_col = true
                        cxc = wr - crad as i64
                    }
                    if in_col {
                        let ddx: i64 = 2 * (pxx - cxc) + 1
                        let ddy: i64 = 2 * (py - cyc) + 1
                        let rr2: i64 = 4 * (crad as i64) * (crad as i64)
                        if ddx * ddx + ddy * ddy > rr2 {
                            keep = true
                        }
                    }
                }
                if keep {
                    let orow: u64 = fb.draw_at(state) +% (y0 as u64 + ry) *% fb.pitch(state)
                    let orig: u64 = orow +% (x0 as u64 + rx) *% 4
                    __mmio_write32((zz +% rx *% 4) as *mut u32,
                        __mmio_read32(orig as *mut u32))
                } else {
                    __mmio_write32((zz +% rx *% 4) as *mut u32,
                        blur_mix(c, ton, tint, amp, x0 as u64 + rx,
                            y0 as u64 + ry) as u32)
                }
                rx = rx + 1
            }
        }

        if rim > 0 {
            if py == wt {
                var hx: i64 = wl + crad as i64
                while hx < wr - crad as i64 {
                    if hx >= x0 && hx < x1 {
                        let hp: u64 = zz +% (hx - x0) as u64 *% 4
                        __mmio_write32(hp as *mut u32, rim_mix(__mmio_read32(hp as *mut u32) as u64, rim) as u32)
                    }
                    hx = hx + 1
                }
            } else if py > wt + crad as i64 && py < wb - crad as i64 {
                if wl >= x0 && wl < x1 {
                    let hp: u64 = zz +% (wl - x0) as u64 *% 4
                    __mmio_write32(hp as *mut u32, rim_mix(__mmio_read32(hp as *mut u32) as u64, rim) as u32)
                }
                if wr - 1 >= x0 && wr - 1 < x1 {
                    let hp: u64 = zz +% (wr - 1 - x0) as u64 *% 4
                    __mmio_write32(hp as *mut u32, rim_mix(__mmio_read32(hp as *mut u32) as u64, rim) as u32)
                }
            }
        }
        wmdraw.fb_row(state, x0 as u64, y0 as u64 + ry, zz, w)
        ry = ry + 1
    }

    if refm {
        return
    }
    wmlayout.ss(state, wmlayout.S_BC_WIN + sl * 8, i + 1)
    wmlayout.ss(state, wmlayout.S_BC_X + sl * 8, x0 as u64)
    wmlayout.ss(state, wmlayout.S_BC_Y + sl * 8, y0 as u64)
    wmlayout.ss(state, wmlayout.S_BC_W + sl * 8, w)
    wmlayout.ss(state, wmlayout.S_BC_H + sl * 8, h)
    wmlayout.ss(state, wmlayout.S_BC_HIT + sl * 8, wmlayout.gs(state, wmlayout.S_BC_GEN + sl * 8))
    wmlayout.ss(state, wmlayout.S_BC_STAMP + sl * 8, wmlayout.gs(state, wmlayout.S_FRAME))
    wmlayout.ss(state, wmlayout.S_BLURS, wmlayout.gs(state, wmlayout.S_BLURS) + 1)
    wmlayout.ss(state, wmlayout.S_BLURPX, wmlayout.gs(state, wmlayout.S_BLURPX) + w *% h)
    let kh: u64 = time.khz(state)
    if kh >= 1000 {
        let t1: u64 = time.tsc()
        if t1 > t0 {
            wmlayout.ss(state, wmlayout.S_BLURUS, wmlayout.gs(state, wmlayout.S_BLURUS) + (t1 - t0) / (kh / 1000))

            if fb.phases_an(state) {
                var s_bl: [u8; 15] = "wm: blurrun i=\0"
                var s_bw: [u8; 4] = " w=\0"
                var s_bh: [u8; 4] = " h=\0"
                var s_bu: [u8; 5] = " us=\0"
                var s_bm: [u8; 7] = " miss=\0"
                var s_bs: [u8; 7] = " simd=\0"
                serial.puts((&s_bl[0]) as u64)
                serial.dec(i)
                serial.puts((&s_bw[0]) as u64)
                serial.dec(w)
                serial.puts((&s_bh[0]) as u64)
                serial.dec(h)
                serial.puts((&s_bu[0]) as u64)
                serial.dec((t1 - t0) / (kh / 1000))
                serial.puts((&s_bm[0]) as u64)
                if tr < wmbase.BC_N {
                    serial.dec(1)
                } else {
                    serial.dec(0)
                }
                serial.puts((&s_bs[0]) as u64)
                if simd {
                    serial.dec(1)
                } else {
                    serial.dec(0)
                }
                serial.nl()
            }
        }
    }
}

fn blur_cached(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_BLURCACHE)
}

fn blur_px(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_BLURPX)
}

fn blur_us(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_BLURUS)
}

fn blur_treffer(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_BLURCACHE)
}

fn blur_miss(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_BLURS)
}

fn blur_quote(state: u64) -> u64 {
    let ganz: u64 = wmlayout.gs(state, wmlayout.S_BLURS) + wmlayout.gs(state, wmlayout.S_BLURCACHE)
    if ganz == 0 {
        return 0
    }
    return wmlayout.gs(state, wmlayout.S_BLURCACHE) *% 100 / ganz
}

fn blur_frn(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_BLURS) + wmlayout.gs(state, wmlayout.S_BLURCACHE)
}

fn blur_frus(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_BLURUS)
}

fn blur_frmax(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_BLURPX)
}

fn blur_reset(state: u64) {
    wmlayout.ss(state, wmlayout.S_BLURS, 0)
    wmlayout.ss(state, wmlayout.S_BLURCACHE, 0)
    wmlayout.ss(state, wmlayout.S_BLURPX, 0)
    wmlayout.ss(state, wmlayout.S_BLURUS, 0)
}

fn blur_line(qadr: u64, zadr: u64, sb: u64, n: u64, r: u64) {
    comp.blur_line(qadr, zadr, sb, n, r)
}
