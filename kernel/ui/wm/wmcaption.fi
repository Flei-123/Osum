profile kernel

import fui.core
import gfx.fb
import ui.wm.wmbase
import ui.wm.wmdraw
import ui.wm.wmgeom
import ui.wm.wmlayout

const CG_N: u64 = 4

const CG_EDGE: u64 = 40

const CG_FACH: u64 = 6400

static mut cg_deck: [u8; 25600] = [0 as u8; 25600]

static mut cg_gut: [u64; 4] = [0 as u64; 4]

static mut cg_gr: u64 = 0

static mut cg_treffer: u64 = 0

static mut cg_bauten: u64 = 0

fn deco_alpha(state: u64) -> u64 {
    return wmbase.form_or(state, wmlayout.FM_WIN_ALPHA, 100) * 255 / 100
}

fn paint_close_classic(state: u64, i: u64, wx: i64, wy: i64, ow: i64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let bx: i64 = wx + ow - wmgeom.border(state, i) as i64 - wmgeom.close_w(state, i) as i64 - 3
    let by: i64 = wy + 4
    if bx + wmgeom.close_w(state, i) as i64 > ax0 && bx < ax1
        && by + wmgeom.close_w(state, i) as i64 > ay0 {
        let rot: u64 = wmbase.deco(state, wmlayout.DK_CLOSE)
        fb.fill(state, bx as u64, by as u64, wmgeom.close_w(state, i), wmgeom.close_w(state, i), rot)
        let weiss: u64 = wmbase.deco(state, wmlayout.DK_CLOSE_MARK)
        var k: u64 = 3
        while k < wmgeom.close_w(state, i) - 3 {
            fb.pixel(state, (bx + k as i64) as u64,
                (by + k as i64) as u64, weiss)
            fb.pixel(state, (bx + k as i64) as u64,
                (by + (wmgeom.close_w(state, i) - 1 - k) as i64) as u64, weiss)
            k = k + 1
        }
    }
}

fn shade24(c: u64, d: u64, auf: bool) -> u64 {
    var r: u64 = (c >> 16) & 255
    var g: u64 = (c >> 8) & 255
    var b: u64 = c & 255
    if auf {
        r = r + d
        g = g + d
        b = b + d
        if r > 255 {
            r = 255
        }
        if g > 255 {
            g = 255
        }
        if b > 255 {
            b = 255
        }
    } else {
        if r > d {
            r = r - d
        } else {
            r = 0
        }
        if g > d {
            g = g - d
        } else {
            g = 0
        }
        if b > d {
            b = b - d
        } else {
            b = 0
        }
    }
    return (r << 16) | (g << 8) | b
}

fn paint_title(state: u64, i: u64, wx: i64, wy: i64, ow: i64, title_color: u64,
    text_color: u64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {

    let wal: u64 = deco_alpha(state)
    let x0: i64 = wx + wmgeom.border(state, i) as i64
    let y0: i64 = wy + wmgeom.border(state, i) as i64
    let tw: i64 = ow - 2 * wmgeom.border(state, i) as i64
    let th: i64 = wmgeom.title_h(state, i) as i64 - 1 - wmgeom.border(state, i) as i64
    if tw <= 0 || th <= 0 {
        return
    }

    var tr: u64 = 0
    let rw: u64 = wmgeom.form(state, wmlayout.FM_RADIUS)
    if rw > wmgeom.border(state, i) {
        tr = rw - wmgeom.border(state, i)
    }
    if tr as i64 > th {
        tr = th as u64
    }
    let grad: u64 = wmgeom.form(state, wmlayout.FM_GRAD)
    if grad == 0 {

        wmdraw.fill_round(state, x0, y0, tw, th, tr, title_color, wal, ax0, ay0, ax1, ay1)
        if tr != 0 {
            wmdraw.fill_clip(state, x0, y0 + tr as i64, tw, th - tr as i64,
                title_color, wal, ax0, ay0, ax1, ay1)
        }
        return
    }

    let base_color: u64 = deco_title(state, i)
    let d: u64 = grad_room(base_color, grad)
    if d == 0 {
        wmdraw.fill_round(state, x0, y0, tw, th, tr, title_color, wal, ax0, ay0, ax1, ay1)
        if tr != 0 {
            wmdraw.fill_clip(state, x0, y0 + tr as i64, tw, th - tr as i64,
                title_color, wal, ax0, ay0, ax1, ay1)
        }
        return
    }
    let top_color: u64 = wmbase.rgb24(state, shade24(base_color, d, false))
    wmdraw.fill_round(state, x0, y0, tw, th, tr, top_color, wal, ax0, ay0, ax1, ay1)
    var j: i64 = tr as i64
    while j < th {

        let rest: u64 = d * (th - 1 - j) as u64 / (th - 1) as u64
        let c: u64 = wmbase.rgb24(state, shade24(base_color, rest, false))
        wmdraw.fill_clip(state, x0, y0 + j, tw, 1, c, wal, ax0, ay0, ax1, ay1)
        j = j + 1
    }
}

fn grad_room(c: u64, want: u64) -> u64 {
    var m: u64 = (c >> 16) & 255
    let g: u64 = (c >> 8) & 255
    let b: u64 = c & 255
    if g < m {
        m = g
    }
    if b < m {
        m = b
    }
    if want > m {
        return m
    }
    return want
}

fn deco_title(state: u64, i: u64) -> u64 {
    if wmbase.focus(state) == i {
        return wmbase.deco_rgb(state, wmlayout.DK_TITLE_ON)
    }
    return wmbase.deco_rgb(state, wmlayout.DK_TITLE)
}

fn paint_caption(state: u64, i: u64, wx: i64, wy: i64, ow: i64,
    title_color: u64, text_color: u64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let bx: i64 = wx + ow - wmgeom.border(state, i) as i64 - (wmlayout.CAP_N * wmgeom.cap_w(state, i)) as i64
    let by: i64 = wy + wmgeom.border(state, i) as i64
    let h: i64 = wmgeom.title_h(state, i) as i64 - 1 - wmgeom.border(state, i) as i64
    if h <= 0 {
        return
    }
    var tr: u64 = 0
    let rw: u64 = wmgeom.form(state, wmlayout.FM_RADIUS)
    if rw > wmgeom.border(state, i) {
        tr = rw - wmgeom.border(state, i)
    }
    let hov: u64 = wmlayout.gs(state, wmlayout.S_CAPHOV)
    let dwn: u64 = wmlayout.gs(state, wmlayout.S_CAPDOWN)
    var n: u64 = 0
    while n < wmlayout.CAP_N {
        let x: i64 = bx + (n * wmgeom.cap_w(state, i)) as i64
        var mark: u64 = text_color
        if hov != 0 && hov - 1 == i * 4 + n {

            let held: bool = dwn == hov
            if n == wmlayout.CAP_CLOSE {

                var rot: u64 = wmbase.deco(state, wmlayout.DK_CLOSE)
                if held {
                    rot = wmbase.rgb24(state, wmdraw.mix24(wmbase.deco_rgb(state, wmlayout.DK_CLOSE), 0, 14))
                }
                cap_face(state, i, x, by, h, tr, rot, n == wmlayout.CAP_CLOSE,
                    ax0, ay0, ax1, ay1)
                mark = wmbase.deco(state, wmlayout.DK_CLOSE_MARK)
            } else {

                var pc: u64 = 12
                if held {
                    pc = 22
                }
                let f: u64 = wmbase.rgb24(state, wmdraw.mix24(deco_title(state, i),
                    deco_text(state, i), pc))
                cap_face(state, i, x, by, h, tr, f, false,
                    ax0, ay0, ax1, ay1)
            }
        }

        let zg: i64 = 10 * wmgeom.uk(state, i) as i64
        cap_glyph(state, n, x + (wmgeom.cap_w(state, i) as i64 - zg) / 2,
            by + (h - zg) / 2, mark, i, ax0, ay0, ax1, ay1)
        n = n + 1
    }
}

fn deco_text(state: u64, i: u64) -> u64 {
    if wmbase.focus(state) == i {
        return wmbase.deco_rgb(state, wmlayout.DK_TEXT_ON)
    }
    return wmbase.deco_rgb(state, wmlayout.DK_TEXT)
}

fn cap_face(state: u64, i: u64, x: i64, y: i64, h: i64, tr: u64, color: u64,
    right_side: bool, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {

    let wal: u64 = deco_alpha(state)
    let w: i64 = wmgeom.cap_w(state, i) as i64
    if !right_side || tr == 0 {
        wmdraw.fill_clip(state, x, y, w, h, color, wal, ax0, ay0, ax1, ay1)
        return
    }
    let r: i64 = tr as i64
    wmdraw.fill_round(state, x, y, w, h, tr, color, wal, ax0, ay0, ax1, ay1)

    wmdraw.fill_clip(state, x, y, w - r, r, color, wal, ax0, ay0, ax1, ay1)
    wmdraw.fill_clip(state, x, y + r, w, h - r, color, wal, ax0, ay0, ax1, ay1)
}

fn cap_glyph(state: u64, n: u64, x: i64, y: i64, color: u64, i: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let sk: i64 = wmgeom.uk(state, i) as i64
    let d: i64 = 10 * sk
    let sb: i64 = sk
    if d <= 0 || sb <= 0 {
        return
    }

    let dd: u64 = d as u64
    if dd > CG_EDGE {

        return
    }
    let slot: u64 = cg_slot(state, n, i)
    if !cg_bau(state, slot, n, i, dd, sb as u64) {
        return
    }

    var ry: u64 = 0
    while ry < dd {
        var rx: u64 = 0
        while rx < dd {
            if cg_deck[(slot *% CG_FACH +% ry *% dd +% rx) as usize]
                != 0 as u8 {
                cap_px(state, x + rx as i64, y + ry as i64, color,
                    ax0, ay0, ax1, ay1)
            }
            rx = rx + 1
        }
        ry = ry + 1
    }
}

fn cg_slot(state: u64, n: u64, i: u64) -> u64 {
    if n == wmlayout.CAP_MAX && (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED) != 0 {
        return 3
    }
    if n >= CG_N {
        return 0
    }
    return n
}

fn cg_bau(state: u64, slot: u64, n: u64, i: u64, dd: u64, sb: u64) -> bool {
    if slot >= CG_N || dd == 0 || dd > CG_EDGE {
        return false
    }
    if cg_gr == dd && cg_gut[slot as usize] != 0 {
        cg_treffer = cg_treffer + 1
        return true
    }

    if cg_gr != dd {
        var k: u64 = 0
        while k < CG_N {
            cg_gut[k as usize] = 0
            k = k + 1
        }
        cg_gr = dd
    }

    let basis: u64 = ((&cg_deck[0]) as u64) +% slot *% CG_FACH
    var z: core.Target = core.target_new(basis, dd as usize, dd as usize,
        (dd *% 4) as usize)
    core.fill_rect(&z, 0 as usize, 0 as usize, dd as usize, dd as usize,
        0 as u32)
    cg_mal(state, &z, n, i, dd, sb)
    cg_dampf(state, slot, dd)
    cg_gut[slot as usize] = 1
    cg_bauten = cg_bauten + 1
    return true
}

fn cg_dampf(state: u64, slot: u64, dd: u64) {
    let b: u64 = slot *% CG_FACH
    var k: u64 = 0
    while k < dd *% dd {
        var v: u8 = 0 as u8
        if cg_deck[(b +% k *% 4) as usize] != 0 as u8 {
            v = 255 as u8
        }
        cg_deck[(b +% k) as usize] = v
        k = k + 1
    }
}

fn cg_mal(state: u64, z: *mut core.Target, n: u64, i: u64, dd: u64,
    sb: u64) {
    let weiss: u32 = 0xFFFFFF as u32
    if n == wmlayout.CAP_MIN {
        core.cap_minimize(z, 0 as usize, 0 as usize, dd as usize,
            sb as usize, weiss)
        return
    }
    if n == wmlayout.CAP_MAX {
        if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_MAXIMIZED) != 0 {
            core.cap_restore(z, 0 as usize, 0 as usize, dd as usize,
                sb as usize, weiss)
            return
        }
        core.cap_maximize(z, 0 as usize, 0 as usize, dd as usize,
            sb as usize, weiss)
        return
    }
    core.cap_close(z, 0 as usize, 0 as usize, dd as usize, sb as usize,
        weiss)
}

fn cap_px(state: u64, x: i64, y: i64, color: u64, ax0: i64, ay0: i64,
    ax1: i64, ay1: i64) {
    if x < ax0 || y < ay0 || x >= ax1 || y >= ay1 || x < 0 || y < 0 {
        return
    }
    fb.pixel(state, x as u64, y as u64, color)
}
