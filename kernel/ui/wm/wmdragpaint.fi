profile kernel

import gfx.fb
import net.netmark
import net.netview
import gfx.ttf
import ui.wm.wmanim
import ui.wm.wmbase
import ui.wm.wmcaption
import ui.wm.wmdraw
import ui.wm.wmgeom
import ui.wm.wmlayout
import ui.wm.wmtitle
import libc.numeric

fn paint_drag_chrome(state: u64, i: u64, wx: i64, wy: i64, ow: i64, oh: i64, cx0: i64, cy0: i64, cx1: i64, cy1: i64, late: bool) {
    if !wmbase.deko(state, i) || fb.nodragbar_an(state) {
        return
    }
    let ax0: i64 = numeric.imax(wx, cx0)
    let ay0: i64 = numeric.imax(wy, cy0)
    let ax1: i64 = numeric.imin(wx + ow, cx1)
    let ay1: i64 = numeric.imin(wy + oh, cy1)
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    let active: bool = wmbase.focus(state) == i
    var frame_color: u64 = wmbase.deco(state, wmlayout.DK_FRAME)
    var title_color: u64 = wmbase.deco(state, wmlayout.DK_TITLE)
    var text_color: u64 = wmbase.deco(state, wmlayout.DK_TEXT)
    if active {
        frame_color = wmbase.deco(state, wmlayout.DK_FRAME_ON)
        title_color = wmbase.deco(state, wmlayout.DK_TITLE_ON)
        text_color = wmbase.deco(state, wmlayout.DK_TEXT_ON)
    }
    let capc: bool = wmtitle.cap_client(state, i)
    if late {
        if capc {
            if wmgeom.form(state, wmlayout.FM_CAPTION) != 0 {
                wmcaption.paint_caption(state, i, wx, wy, ow, title_color, text_color, ax0, ay0, ax1, ay1)
            } else {
                wmcaption.paint_close_classic(state, i, wx, wy, ow, ax0, ay0, ax1, ay1)
            }
        }
        return
    }

    let ry: i64 = wy + wmbase.iny(state, i) as i64
    let rb: i64 = wy + oh - wmgeom.border(state, i) as i64
    let rl: i64 = wx + wmgeom.border(state, i) as i64
    let rr: i64 = wx + ow - wmgeom.border(state, i) as i64
    let rad: u64 = wmgeom.form(state, wmlayout.FM_RADIUS)
    let dal: u64 = wmcaption.deco_alpha(state)
    if numeric.imin(cy1, ry) > cy0 {
        wmdraw.fill_round(state, wx, wy, ow, oh, rad, frame_color, dal, cx0, cy0, cx1, numeric.imin(cy1, ry))
    }
    if cy1 > numeric.imax(cy0, rb) {
        wmdraw.fill_round(state, wx, wy, ow, oh, rad, frame_color, dal, cx0, numeric.imax(cy0, rb), cx1, cy1)
    }
    if numeric.imin(cy1, rb) > numeric.imax(cy0, ry) {
        if numeric.imin(cx1, rl) > cx0 {
            wmdraw.fill_round(state, wx, wy, ow, oh, rad, frame_color, dal, cx0, numeric.imax(cy0, ry), numeric.imin(cx1, rl), numeric.imin(cy1, rb))
        }
        if cx1 > numeric.imax(cx0, rr) {
            wmdraw.fill_round(state, wx, wy, ow, oh, rad, frame_color, dal, numeric.imax(cx0, rr), numeric.imax(cy0, ry), cx1, numeric.imin(cy1, rb))
        }
    }
    if !capc {
        wmcaption.paint_title(state, i, wx, wy, ow, title_color, text_color, ax0, ay0, ax1, ay1)
    }
    var bx: i64 = wx + ow - wmgeom.border(state, i) as i64 - wmgeom.close_w(state, i) as i64 - 3
    if wmgeom.form(state, wmlayout.FM_CAPTION) != 0 {
        bx = wx + ow - wmgeom.border(state, i) as i64 - (wmlayout.CAP_N * wmgeom.cap_w(state, i)) as i64
        if !capc {
            wmcaption.paint_caption(state, i, wx, wy, ow, title_color, text_color, ax0, ay0, ax1, ay1)
        }
    } else if !capc {
        wmcaption.paint_close_classic(state, i, wx, wy, ow, ax0, ay0, ax1, ay1)
    }
    var before: i64 = 0
    let sicht: u64 = netview.view_of(state, wmbase.win_owner(state, i))
    if sicht != netview.V_REAL && sicht <= 3 && !capc {
        wmtitle.title_mark(state, sicht - 1, wx + wmgeom.border(state, i) as i64 + wmgeom.title_pad(state, i) as i64,
            wy + wmgeom.border(state, i) as i64 + ((wmgeom.title_h(state, i) - wmgeom.border(state, i) - netmark.H) / 2) as i64,
            text_color, ax0, ay0, ax1, ay1)
        before = netmark.W as i64 + 4
    }
    let f: u64 = wmlayout.gs(state, wmlayout.S_FONT_UI)
    if f < ttf.MAX_FONTS && !capc {
        wmtitle.title_text(state, i, f, wx + wmgeom.border(state, i) as i64 + wmgeom.title_pad(state, i) as i64 + before,
            wy + wmgeom.title_base(state, i, f), text_color, ax0, ay0, ax1, ay1, bx)
    }
}

fn paint_win_drag(state: u64, i: u64, cx0: i64, cy0: i64, cx1: i64,
    cy1: i64) {
    let bw: i64 = wmlayout.wg(state, i, wmlayout.W_W) as i64
    let bh: i64 = wmlayout.wg(state, i, wmlayout.W_H) as i64
    if bw <= 0 || bh <= 0 {
        return
    }
    let sk: u64 = wmanim.drag_scale(state, i)
    var nw: i64 = bw * sk as i64 / 1000
    var nh: i64 = bh * sk as i64 / 1000
    if nw <= 0 || nh <= 0 {
        return
    }

    let ix: i64 = wmbase.win_x(state, i) + wmgeom.border(state, i) as i64
    let iy: i64 = wmbase.win_y(state, i) + wmbase.iny(state, i) as i64

    let tl: i64 = wmanim.drag_tilt_on(state) as i64
    var ax: i64 = bw / 2
    var ay: i64 = bh / 2
    if wmanim.is_dragged(state, i) {
        let gx: i64 = wmlayout.gs(state, wmlayout.S_DRAGX) as i64 - wmgeom.border(state, i) as i64
        let gy: i64 = wmlayout.gs(state, wmlayout.S_DRAGY) as i64 - wmbase.iny(state, i) as i64

        let px: i64 = numeric.imin(numeric.imax(gx, 0), bw)
        let py: i64 = numeric.imin(numeric.imax(gy, 0), bh)
        ax = bw / 2 + (px - bw / 2) * tl / 100
        ay = bh / 2 + (py - bh / 2) * tl / 100
    }

    var ox: i64 = ix + ax - ax * nw / bw
    var oy: i64 = iy + ay - ay * nh / bh

    ox = ox + wmanim.swing_dx(state, i)
    oy = oy + wmanim.swing_dy(state, i)

    let fr_x: i64 = ox - wmgeom.border(state, i) as i64
    let fr_y: i64 = oy - wmbase.iny(state, i) as i64
    let fr_w: i64 = nw + 2 * wmgeom.border(state, i) as i64
    let fr_h: i64 = nh + wmbase.iny(state, i) as i64 + wmgeom.border(state, i) as i64
    paint_drag_chrome(state, i, fr_x, fr_y, fr_w, fr_h, cx0, cy0, cx1, cy1, false)
    let ax0: i64 = numeric.imax(ox, cx0)
    let ay0: i64 = numeric.imax(oy, cy0)
    let ax1: i64 = numeric.imin(ox + nw, cx1)
    let ay1: i64 = numeric.imin(oy + nh, cy1)
    if ax1 <= ax0 || ay1 <= ay0 {
        paint_drag_chrome(state, i, fr_x, fr_y, fr_w, fr_h, cx0, cy0, cx1, cy1, true)
        return
    }
    let buf: u64 = wmlayout.wg(state, i, wmlayout.W_BUF)
    let stride: u64 = wmlayout.wg(state, i, wmlayout.W_W)

    let sw: i64 = fb.width(state) as i64
    let shh: i64 = fb.height(state) as i64
    var cl0: i64 = numeric.imax(ax0, 0)
    var cl1: i64 = numeric.imin(ax1, sw)
    var ct0: i64 = numeric.imax(ay0, fb.band_lo(state) as i64)
    var ct1: i64 = numeric.imin(ay1, shh)

    if cl0 < ox {
        cl0 = ox
    }
    if cl1 > ox + nw {
        cl1 = ox + nw
    }
    if cl1 > cl0 && ct1 > ct0 {
        let pitch: u64 = fb.pitch(state)
        let dst0: u64 = fb.draw_at(state)

        let num0: i64 = (cl0 - ox) * bw
        let q0: i64 = num0 / nw
        let r0: i64 = num0 - q0 * nw
        let qs: i64 = bw / nw
        let rs: i64 = bw - qs * nw

        var blk: [u64; 8] = [0 as u64; 8]
        blk[2] = (cl1 - cl0) as u64
        blk[3] = q0 as u64
        blk[4] = r0 as u64
        blk[5] = qs as u64
        blk[6] = rs as u64
        blk[7] = nw as u64
        var y: i64 = ct0
        while y < ct1 {
            let sy: i64 = (y - oy) * bh / nh
            if sy >= 0 && sy < bh {
                blk[0] = buf +% (sy as u64) *% stride *% 4
                blk[1] = dst0 +% (y as u64) *% pitch +% (cl0 as u64) *% 4
                asm("mov rdx,rdi\nmov rcx,[rdx+16]\ntest rcx,rcx\njz 0f\nmov rsi,[rdx]\nmov rdi,[rdx+8]\nmov r8,[rdx+24]\nmov r9,[rdx+32]\nmov r10,[rdx+40]\nmov r11,[rdx+48]\n1:\nmov eax,[rsi+r8*4]\nand eax,16777215\nmov [rdi],eax\nadd rdi,4\nadd r8,r10\nadd r9,r11\ncmp r9,[rdx+56]\njl 2f\nsub r9,[rdx+56]\ninc r8\n2:\ndec rcx\njnz 1b\n0:",
                    in("rdi") (&blk[0]) as u64,
                    clobber("rax"),
                    clobber("rcx"),
                    clobber("rdx"),
                    clobber("rsi"),
                    clobber("rdi"),
                    clobber("r8"),
                    clobber("r9"),
                    clobber("r10"),
                    clobber("r11"),
                    clobber("memory"))
            }
            y = y + 1
        }
    }
    paint_drag_chrome(state, i, fr_x, fr_y, fr_w, fr_h, cx0, cy0, cx1, cy1, true)
    wmlayout.wsv(state, i, wmlayout.W_PAINTS, wmlayout.wg(state, i, wmlayout.W_PAINTS) + 1)
    wmlayout.wsv(state, i, wmlayout.W_PX,
        wmlayout.wg(state, i, wmlayout.W_PX) + ((ax1 - ax0) * (ay1 - ay0)) as u64)
    wmlayout.ss(state, wmlayout.S_DRAGPX,
        wmlayout.gs(state, wmlayout.S_DRAGPX) + ((ax1 - ax0) * (ay1 - ay0)) as u64)
    wmlayout.ss(state, wmlayout.S_ZFLAG, 1)
}
