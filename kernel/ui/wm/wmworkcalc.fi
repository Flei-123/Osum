profile kernel

import gfx.fb
import ui.wm.tiling
import ui.wm.wmbase
import ui.wm.wmhead
import ui.wm.wmlayout
import ui.wm.wmworkarea

fn recalc_work(state: u64) {
    if wmhead.hd_multi(state) {

        let p: u64 = wmhead.head_work(state, wmhead.hd_primary(state))
        wmlayout.ss(state, wmlayout.S_WORK_X, wmhead.hw_x(p))
        wmlayout.ss(state, wmlayout.S_WORK_Y, wmhead.hw_y(p))
        wmlayout.ss(state, wmlayout.S_WORK_W, wmhead.hw_w(p))
        wmlayout.ss(state, wmlayout.S_WORK_H, wmhead.hw_h(p))
        wmlayout.ss(state, wmlayout.S_WORKCALC, wmlayout.gs(state, wmlayout.S_WORKCALC) + 1)
        wmworkarea.refit_max(state)
        tiling.tile_area_work(state)
        tiling.tile_apply(state)
        return
    }
    let sw: u64 = wmlayout.gs(state, wmlayout.S_SW)
    let sh: u64 = wmlayout.gs(state, wmlayout.S_SH)
    var x0: u64 = 0
    var y0: u64 = 0
    var x1: u64 = sw
    var y1: u64 = sh
    if wmlayout.gs(state, wmlayout.S_NOSTRUT) == 0 {

        y0 = fb.band(state)
        var i: u64 = 0
        while i < wmbase.MAX_WIN {
            if wmlayout.wg(state, i, wmlayout.W_USED) != 0 && wmlayout.wg(state, i, wmlayout.W_STRUT) != 0 {
                if (wmlayout.wg(state, i, wmlayout.W_FLAGS) & wmlayout.F_HIDDEN) == 0 {
                    let e: u64 = (wmlayout.wg(state, i, wmlayout.W_STRUT) & 0xFF) - 1
                    let n: u64 = wmlayout.wg(state, i, wmlayout.W_STRUT) >> 8
                    if e == wmhead.EDGE_TOP {
                        if n > y0 {
                            y0 = n
                        }
                    } else if e == wmhead.EDGE_BOTTOM {
                        if n < sh && sh - n < y1 {
                            y1 = sh - n
                        }
                    } else if e == wmhead.EDGE_LEFT {
                        if n > x0 {
                            x0 = n
                        }
                    } else {
                        if n < sw && sw - n < x1 {
                            x1 = sw - n
                        }
                    }
                }
            }
            i = i + 1
        }
    }

    if x1 < x0 + 64 || y1 < y0 + 64 {
        x0 = 0
        y0 = 0
        x1 = sw
        y1 = sh
    }
    wmlayout.ss(state, wmlayout.S_WORK_X, x0)
    wmlayout.ss(state, wmlayout.S_WORK_Y, y0)
    wmlayout.ss(state, wmlayout.S_WORK_W, x1 - x0)
    wmlayout.ss(state, wmlayout.S_WORK_H, y1 - y0)
    wmlayout.ss(state, wmlayout.S_WORKCALC, wmlayout.gs(state, wmlayout.S_WORKCALC) + 1)
    wmworkarea.refit_max(state)

    tiling.tile_area_work(state)
    tiling.tile_apply(state)
}
