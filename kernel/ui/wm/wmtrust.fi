profile kernel

import lib.kstate
import serial
import sched.time
import ipc.tip
import ui.wm.wmbase
import ui.wm.wmgate
import ui.wm.wmtruststate
import ui.wm.wmtrustgeom
import ui.wm.wmtrustmsg

const TD_INJECT_GUARD_NS: u64 = 1500000000
const TD_ARM_NS: u64 = 400000000
const TD_ANSWER_YES: u64 = 1
const TD_ANSWER_NO: u64 = 2
const TD_ANSWER_YES_REMEMBER: u64 = 4
const TD_POLL_NONE: u64 = 3
const ICON_MAGIC: u64 = 0x4D59534F

static mut L_HEAD: [u8; 29] = "wm: trusted dialog layout y=\0"
static mut L_BODY: [u8; 7] = " body=\0"
static mut L_FOOT: [u8; 7] = " foot=\0"
static mut L_BTN: [u8; 6] = " btn=\0"
static mut L_BH: [u8; 5] = " bh=\0"
static mut L_H: [u8; 4] = " h=\0"
static mut L_X: [u8; 4] = " x=\0"
static mut L_W: [u8; 4] = " w=\0"
static mut L_YES: [u8; 6] = " yes=\0"
static mut L_NO: [u8; 5] = " no=\0"
static mut L_BW: [u8; 5] = " bw=\0"
static mut L_K: [u8; 4] = " k=\0"
static mut L_REM: [u8; 6] = " rem=\0"
static mut L_TITLE: [u8; 8] = " title=\0"
static mut L_UP: [u8; 26] = "wm: trusted dialog up no=\0"
static mut L_DOWN: [u8; 28] = "wm: trusted dialog down no=\0"
static mut L_ANS: [u8; 27] = "wm: trusted dialog answer=\0"
static mut L_NOW: [u8; 5] = " no=\0"
static mut L_DET: [u8; 33] = "wm: trusted dialog details open=\0"
static mut L_REFUSE: [u8; 42] = "wm: trusted dialog refused injected input\0"

fn put_kv(label: u64, v: u64) {
    serial.puts(label)
    serial.dec(v)
}

fn td_layout_line(state: u64) {
    put_kv((&L_HEAD[0]) as u64, wmtrustgeom.dy(state))
    put_kv((&L_BODY[0]) as u64, wmtrustgeom.head_bottom(state))
    serial.put(45 as u8)
    serial.dec(wmtrustgeom.foot_top(state))
    put_kv((&L_FOOT[0]) as u64, wmtrustgeom.foot_top(state))
    put_kv((&L_BTN[0]) as u64, wmtrustgeom.btn_top(state))
    put_kv((&L_BH[0]) as u64, wmtrustgeom.btn_h(state))
    put_kv((&L_H[0]) as u64, wmtrustgeom.dh(state))
    put_kv((&L_X[0]) as u64, wmtrustgeom.dx(state))
    put_kv((&L_W[0]) as u64, wmtrustgeom.dw(state))
    put_kv((&L_YES[0]) as u64, wmtrustgeom.btn_x(state, 0))
    put_kv((&L_NO[0]) as u64, wmtrustgeom.btn_x(state, 1))
    put_kv((&L_BW[0]) as u64, wmtrustgeom.btn_w(state))
    put_kv((&L_K[0]) as u64, wmtrustgeom.scale(state))
    put_kv((&L_REM[0]) as u64, wmtruststate.td_rem)
    serial.puts((&L_TITLE[0]) as u64)
    serial.puts((&wmtruststate.td_title[0]) as u64)
    serial.nl()
}

fn trust_ask(state: u64, no: u64, p: u64, n: u64) -> bool {
    if wmtruststate.td_on != 0 || no == 0 {
        return false
    }
    wmtrustmsg.parse(state, p, n)
    wmtruststate.td_no = no
    wmtruststate.td_ans = 0
    wmtruststate.td_ansno = 0
    wmtruststate.td_focus = 1
    wmtruststate.td_t0 = time.mono_ns(state)
    wmtruststate.td_on = 1
    wmtruststate.td_shown = wmtruststate.td_shown + 1
    wmbase.damage_all(state)
    put_kv((&L_UP[0]) as u64, no)
    serial.nl()
    td_layout_line(state)
    return true
}

fn trust_icon_buf() -> u64 {
    if wmtruststate.td_on != 0 {
        return 0
    }
    return wmtruststate.td_icon_ptr()
}

fn trust_icon_done(no: u64, n: u64) {
    let p: u64 = wmtruststate.td_icon_ptr()
    var magic: u64 = 0
    var i: u64 = 0
    while i < 4 {
        magic = magic | (kstate.get8(p + i) << (i * 8))
        i = i + 1
    }
    wmtruststate.td_icon_no = no
    wmtruststate.td_icon_len = n
    if magic != ICON_MAGIC || n < wmtruststate.TD_ICON_BYTES {
        wmtruststate.td_icon_len = 0
    }
}

fn td_toggle(state: u64) {
    if wmtruststate.td_ndet == 0 {
        return
    }
    wmtruststate.td_open = 1 - wmtruststate.td_open
    wmbase.damage_all(state)
    put_kv((&L_DET[0]) as u64, wmtruststate.td_open)
    serial.nl()
}

fn trust_poll(state: u64, no: u64) -> u64 {
    if no != 0 && wmtruststate.td_ansno == no && wmtruststate.td_ans != 0 {
        return wmtruststate.td_ans
    }
    if wmtruststate.td_on != 0 && wmtruststate.td_no == no {
        return 0
    }
    return TD_POLL_NONE
}

fn trust_cancel(state: u64, no: u64) {
    if wmtruststate.td_on != 0 && wmtruststate.td_no == no {
        wmtruststate.td_on = 0
        wmbase.damage_all(state)
        put_kv((&L_DOWN[0]) as u64, no)
        serial.nl()
    }
}

fn td_pick_answer(v: u64) -> u64 {
    if v == TD_ANSWER_YES && wmtruststate.td_rem_on != 0 {
        return TD_ANSWER_YES_REMEMBER
    }
    return v
}

fn td_toggle_remember(state: u64) {
    if wmtruststate.td_rem == 0 {
        return
    }
    wmtruststate.td_rem_on = 1 - wmtruststate.td_rem_on
    wmbase.damage_all(state)
}

fn td_audit_remote(state: u64) {
    if !tip.remote_within(state, TD_INJECT_GUARD_NS * 4) {
        return
    }
    var s_ar: [u8; 52] = "wm: trusted dialog answered by authenticated remote\0"
    serial.puts((&s_ar[0]) as u64)
    serial.nl()
}

fn td_answer(state: u64, v: u64) {
    wmtruststate.td_ans = td_pick_answer(v)
    wmtruststate.td_ansno = wmtruststate.td_no
    td_audit_remote(state)
    wmtruststate.td_on = 0
    wmbase.damage_all(state)
    put_kv((&L_ANS[0]) as u64, wmtruststate.td_ans)
    put_kv((&L_NOW[0]) as u64, wmtruststate.td_no)
    serial.nl()
}

fn td_live(state: u64) -> bool {
    return wmtruststate.td_on != 0 && !wmgate.lock_active(state)
}

fn td_injected(state: u64) -> bool {
    return tip.injected_within(state, TD_INJECT_GUARD_NS)
}

fn td_refuse(state: u64) {
    serial.puts((&L_REFUSE[0]) as u64)
    serial.nl()
}

fn td_armed(state: u64) -> bool {
    return time.mono_ns(state) - wmtruststate.td_t0 >= TD_ARM_NS
}

fn trust_key(state: u64, c: u64) -> bool {
    if !td_live(state) {
        return false
    }
    if !td_armed(state) {
        return true
    }
    if td_injected(state) {
        td_refuse(state)
        return true
    }
    if c == 106 || c == 74 || c == 121 || c == 89 {
        td_answer(state, TD_ANSWER_YES)
    } else if c == 110 || c == 78 || c == 27 {
        td_answer(state, TD_ANSWER_NO)
    } else if c == 100 || c == 68 {
        td_toggle(state)
    } else if c == 114 || c == 82 {
        td_toggle_remember(state)
    } else if c == 9 {
        wmtruststate.td_focus = 1 - wmtruststate.td_focus
        wmbase.damage_all(state)
    } else if c == 13 || c == 10 || c == 32 {
        td_answer(state, wmtruststate.td_focus + 1)
    }
    return true
}

fn td_click_buttons(state: u64, px: u64, py: u64) {
    if !wmtrustgeom.in_box(px, py, wmtrustgeom.btn_x(state, 0), wmtrustgeom.btn_top(state), wmtrustgeom.btn_w(state), wmtrustgeom.btn_h(state)) {
        if wmtrustgeom.in_box(px, py, wmtrustgeom.btn_x(state, 1), wmtrustgeom.btn_top(state), wmtrustgeom.btn_w(state), wmtrustgeom.btn_h(state)) {
            td_answer(state, TD_ANSWER_NO)
        }
        return
    }
    td_answer(state, TD_ANSWER_YES)
}

fn td_click(state: u64, px: u64, py: u64) {
    if !td_armed(state) {
        return
    }
    if td_injected(state) {
        td_refuse(state)
        return
    }
    let k: u64 = wmtrustgeom.scale(state)
    let full: u64 = wmtrustgeom.dw(state)
    if wmtrustgeom.in_box(px, py, wmtrustgeom.close_x(state), wmtrustgeom.dy(state), wmtrustgeom.CLOSE_W * k, wmtrustgeom.SMALL_H * k) {
        td_answer(state, TD_ANSWER_NO)
        return
    }
    if wmtruststate.td_ndet > 0 && wmtrustgeom.in_box(px, py, wmtrustgeom.text_x(state), wmtrustgeom.link_top(state), full / 2, wmtrustgeom.ROW * k) {
        td_toggle(state)
        return
    }
    if wmtruststate.td_rem != 0 && wmtrustgeom.in_box(px, py, wmtrustgeom.text_x(state), wmtrustgeom.rem_top(state), full / 2, wmtrustgeom.REM_H * k) {
        td_toggle_remember(state)
        return
    }
    td_click_buttons(state, px, py)
}
