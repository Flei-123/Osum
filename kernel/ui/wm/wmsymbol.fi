profile kernel

import iconbox
import mm.mmframe
import ui.wm.wmbase
import ui.wm.wmlayout

const PICTURE_BYTES: u64 = iconbox.SLOT_BYTES

const RUN_FRAMES: u64 = 33

const READY: u64 = 0x8000000000000000

const ID_MASK: u64 = 0xFFFFFFFF

const GEN_SHIFT: u64 = 32

const GEN_MASK: u64 = 0xFFFF

const HEAD_BYTES: u64 = 8

fn base(state: u64) -> u64 {
    return wmlayout.gs(state, wmlayout.S_SYMF)
}

fn head_at(state: u64, i: u64) -> u64 {
    return base(state) + i * HEAD_BYTES
}

fn pixels_at(state: u64, i: u64) -> u64 {
    return base(state) + mmframe.FRAME_SIZE * (1 + i)
}

fn head(state: u64, i: u64) -> u64 {
    if i >= wmbase.MAX_WIN || base(state) == 0 {
        return 0
    }
    return __mmio_read64(head_at(state, i) as *mut u64)
}

fn live(state: u64, i: u64) -> u64 {
    let h: u64 = head(state, i)
    if (h & READY) == 0 {
        return 0
    }
    if (h & ID_MASK) != (wmlayout.wg(state, i, wmlayout.W_ID) & ID_MASK) {
        return 0
    }
    return h
}

fn gen_of(h: u64) -> u64 {
    return (h >> GEN_SHIFT) & GEN_MASK
}

fn begin(state: u64, i: u64) -> u64 {
    if i >= wmbase.MAX_WIN || base(state) == 0 {
        return 0
    }
    __mmio_write64(head_at(state, i) as *mut u64, head(state, i) & ~READY)
    return pixels_at(state, i)
}

fn commit(state: u64, i: u64) {
    let gen: u64 = (gen_of(head(state, i)) + 1) & GEN_MASK
    __mmio_write64(head_at(state, i) as *mut u64, READY | (gen << GEN_SHIFT) | (wmlayout.wg(state, i, wmlayout.W_ID) & ID_MASK))
}

fn clear(state: u64, i: u64) {
    if i >= wmbase.MAX_WIN || base(state) == 0 {
        return
    }
    __mmio_write64(head_at(state, i) as *mut u64, head(state, i) & ~READY)
}
