profile kernel

import ui.wm.wmbase
import ui.wm.wmdamage
import ui.wm.wmlayout

fn set_flag(state: u64, i: u64, on: bool) {
    let f: u64 = wmlayout.wg(state, i, wmlayout.W_FLAGS)
    var nf: u64 = f & ~wmlayout.F_PEEK
    if on {
        nf = f | wmlayout.F_PEEK
    }
    if nf == f {
        return
    }
    wmlayout.wsv(state, i, wmlayout.W_FLAGS, nf)
    wmdamage.damage_win(state, i)
}

fn peek_set(state: u64, target: u64) {
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmbase.valid(state, i) {
            let other: bool = i != target && wmlayout.wg(state, i, wmlayout.W_LAYER) == wmlayout.L_NORMAL
            set_flag(state, i, other)
        }
        i = i + 1
    }
}

fn peek_clear(state: u64) {
    var i: u64 = 0
    while i < wmbase.MAX_WIN {
        if wmbase.valid(state, i) {
            set_flag(state, i, false)
        }
        i = i + 1
    }
}
