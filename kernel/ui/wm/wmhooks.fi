profile kernel

const H_CREATE: u64 = 0
const H_DESTROY: u64 = 1
const H_FOCUS: u64 = 2
const H_LAYER_LEAVE: u64 = 3
const H_WORKAREA: u64 = 4
const H_SAY_WINDOWS: u64 = 5
const H_COUNT: u64 = 6

static mut table: [u64; 6] = [0 as u64; 6]

fn register(slot: u64, handler: u64) {
    if slot < H_COUNT {
        table[slot as usize] = handler
    }
}

fn fire_window(slot: u64, state: u64, i: u64) {
    let handler: u64 = table[slot as usize]
    if handler != 0 {
        let call: fn(u64, u64) = handler as fn(u64, u64)
        call(state, i)
    }
}

fn fire_create(state: u64, i: u64) {
    fire_window(H_CREATE, state, i)
}

fn fire_destroy(state: u64, i: u64) {
    fire_window(H_DESTROY, state, i)
}

fn fire_focus(state: u64, i: u64) {
    fire_window(H_FOCUS, state, i)
}

fn fire_layer_leave(state: u64, i: u64) {
    fire_window(H_LAYER_LEAVE, state, i)
}

fn fire_state(slot: u64, state: u64) {
    let handler: u64 = table[slot as usize]
    if handler != 0 {
        let call: fn(u64) = handler as fn(u64)
        call(state)
    }
}

fn fire_workarea(state: u64) {
    fire_state(H_WORKAREA, state)
}

fn fire_say_windows(state: u64) {
    fire_state(H_SAY_WINDOWS, state)
}
