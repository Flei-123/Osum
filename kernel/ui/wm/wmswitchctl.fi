profile kernel

import ui.wm.wmbase
import ui.wm.wmcore
import ui.wm.wmdamage
import ui.wm.wmgate
import ui.wm.wmswitch
import ui.wm.wmtrust

fn next_window(state: u64, von: u64) -> bool {
    var k: u64 = 1
    while k <= wmbase.MAX_WIN {
        let j: u64 = (von + k) % wmbase.MAX_WIN
        if wmswitch.wechselbar(state, j) && j != von {
            wmcore.raise_win(state, j)
            wmcore.set_focus(state, j)
            wmdamage.damage_win(state, j)
            return true
        }
        k = k + 1
    }
    return false
}

fn prev_window(state: u64, von: u64) -> bool {
    var k: u64 = 1
    while k <= wmbase.MAX_WIN {
        let j: u64 = (von + wmbase.MAX_WIN - (k % wmbase.MAX_WIN)) % wmbase.MAX_WIN
        if wmswitch.wechselbar(state, j) && j != von {
            wmcore.raise_win(state, j)
            wmcore.set_focus(state, j)
            wmdamage.damage_win(state, j)
            return true
        }
        k = k + 1
    }
    return false
}

fn sw_commit(state: u64) {
    if wmswitch.sw_open == 0 {
        return
    }
    wmswitch.sw_say(state, 2)
    var j: u64 = wmbase.MAX_WIN
    if wmswitch.sw_sel < wmswitch.sw_n {
        j = wmswitch.sw_list[wmswitch.sw_sel as usize]
    }
    wmswitch.sw_close(state)
    if j < wmbase.MAX_WIN && wmswitch.sw_minimized(state, j) {
        wmcore.set_hidden(state, j, false)
    }
    if j < wmbase.MAX_WIN && wmswitch.wechselbar(state, j) {
        wmcore.raise_win(state, j)
        wmcore.set_focus(state, j)
        wmdamage.damage_win(state, j)
        wmswitch.sw_commits = wmswitch.sw_commits + 1
    }
}

fn sw_step(state: u64, back: bool) -> bool {
    if wmswitch.sw_open == 0 {
        wmswitch.sw_build(state)
        if wmswitch.sw_n < 2 {
            return false
        }
        if back {
            wmswitch.sw_sel = wmswitch.sw_n - 1
        } else {
            wmswitch.sw_sel = 1
        }
        wmswitch.sw_open = 1
        wmswitch.sw_say(state, 0)
        wmswitch.sw_damage(state)
        if !wmswitch.sw_alt_held(state) {
            sw_commit(state)
        }
        return true
    }
    if back {
        wmswitch.sw_sel = (wmswitch.sw_sel + wmswitch.sw_n - 1) % wmswitch.sw_n
    } else {
        wmswitch.sw_sel = (wmswitch.sw_sel + 1) % wmswitch.sw_n
    }
    wmswitch.sw_say(state, 1)
    wmswitch.sw_damage(state)
    return true
}

fn sw_tick(state: u64) {
    if wmswitch.sw_open == 0 {
        return
    }
    if wmgate.lock_active(state) {
        wmswitch.sw_cancel(state)
        return
    }
    if !wmswitch.sw_alt_held(state) {
        sw_commit(state)
    }
}

fn swipe_do(state: u64, dir: u64, n: u64) -> bool {
    if n < 3 || !wmbase.ready(state) || wmgate.lock_active(state) || wmtrust.td_live(state) {
        return false
    }
    let i: u64 = wmbase.focus(state)
    var moved: bool = false
    if dir == 1 {
        moved = next_window(state, i)
    } else if dir == 2 {
        moved = prev_window(state, i)
    }
    if moved {
        wmswitch.sw_done = wmswitch.sw_done + 1
    }
    return moved
}
