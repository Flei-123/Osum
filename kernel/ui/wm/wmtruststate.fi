profile kernel

const TD_LINE_BYTES: u64 = 64

const TD_Q_AT: u64 = 0
const TD_Q_MAX: u64 = 3
const TD_NAME_AT: u64 = 3
const TD_NAME_MAX: u64 = 2
const TD_DESC_AT: u64 = 5
const TD_DESC_MAX: u64 = 6
const TD_DET_AT: u64 = 11
const TD_DET_MAX: u64 = 8
const TD_LINES: u64 = 19

const TD_IN_BYTES: u64 = 1104
const TD_ICON_BYTES: u64 = 16396
const TD_ICON_SIDE: u64 = 64
const TD_ICON_HEAD: u64 = 12

static mut td_on: u64 = 0
static mut td_no: u64 = 0
static mut td_ans: u64 = 0
static mut td_ansno: u64 = 0
static mut td_t0: u64 = 0
static mut td_mb: u64 = 0
static mut td_shown: u64 = 0
static mut td_focus: u64 = 1
static mut td_nq: u64 = 0
static mut td_nname: u64 = 0
static mut td_ndesc: u64 = 0
static mut td_ndet: u64 = 0
static mut td_open: u64 = 0
static mut td_rem: u64 = 0
static mut td_rem_on: u64 = 0
static mut td_verified: u64 = 0
static mut td_plain: u64 = 0
static mut td_icon_no: u64 = 0
static mut td_icon_len: u64 = 0

static mut td_txt: [u8; 1280] = [0 as u8; 1280]
static mut td_in: [u8; 1104] = [0 as u8; 1104]
static mut td_icon: [u8; 16400] = [0 as u8; 16400]
static mut td_title: [u8; 72] = [0 as u8; 72]
static mut td_pub: [u8; 96] = [0 as u8; 96]
static mut td_origin: [u8; 96] = [0 as u8; 96]
static mut td_link: [u8; 48] = [0 as u8; 48]
static mut td_hide: [u8; 48] = [0 as u8; 48]
static mut td_yes: [u8; 24] = [0 as u8; 24]
static mut td_nol: [u8; 24] = [0 as u8; 24]
static mut td_rlab: [u8; 48] = [0 as u8; 48]

fn td_line(l: u64) -> u64 {
    return ((&td_txt[0]) as u64) + l * TD_LINE_BYTES
}

fn td_inp() -> u64 {
    return (&td_in[0]) as u64
}

fn td_icon_ptr() -> u64 {
    return (&td_icon[0]) as u64
}

fn td_icon_ready() -> bool {
    return td_icon_no != 0 && td_icon_no == td_no && td_icon_len >= TD_ICON_BYTES
}
