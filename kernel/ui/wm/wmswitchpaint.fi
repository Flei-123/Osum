profile kernel

import appicon
import gfx.fb
import gfx.ttf
import ui.wm.wmbase
import ui.wm.wmcore
import ui.wm.wmdraw
import ui.wm.wmlayout
import ui.wm.wmswitch
import ui.wm.wmtitle

fn paint_switcher(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    if wmswitch.sw_open == 0 || wmswitch.sw_n == 0 {
        return
    }
    wmswitch.sw_geom(state)
    let c0: i64 = cx0 as i64
    let r0: i64 = cy0 as i64
    let c1: i64 = cx1 as i64
    let r1: i64 = cy1 as i64
    let k: i64 = wmswitch.sw_g[9 as usize]
    let px: i64 = wmswitch.sw_g[0 as usize]
    let py: i64 = wmswitch.sw_g[1 as usize]
    let cw: i64 = wmswitch.sw_g[4 as usize]
    let ch: i64 = wmswitch.sw_g[5 as usize]
    let gap: i64 = wmswitch.sw_g[6 as usize]
    let pad: i64 = wmswitch.sw_g[7 as usize]
    let cols: i64 = wmswitch.sw_g[8 as usize]
    if px + wmswitch.sw_g[2 as usize] <= c0 || py + wmswitch.sw_g[3 as usize] <= r0 || px >= c1 || py >= r1 {
        return
    }
    wmdraw.fill_round(state, px, py, wmswitch.sw_g[2 as usize], wmswitch.sw_g[3 as usize], wmswitch.sw_dim(state, 12, k) as u64, 0x202020, 240, c0, r0, c1, r1)
    let f: u64 = wmlayout.gs(state, wmlayout.S_FONT_UI)
    let pxui: u64 = wmlayout.gs(state, wmlayout.S_PX_UI)
    let accent: u64 = wmbase.deco(state, wmlayout.DK_FRAME_ON)
    let n: i64 = wmswitch.sw_n as i64
    var t: i64 = 0
    while t < n {
        let w: u64 = wmswitch.sw_list[t as usize]
        let row: i64 = t / cols
        var inrow: i64 = n - row * cols
        if inrow > cols {
            inrow = cols
        }
        let off: i64 = (cols - inrow) * (cw + gap) / 2
        let tx: i64 = px + pad + off + (t % cols) * (cw + gap)
        let ty: i64 = py + pad + row * (ch + gap)
        if wmbase.valid(state, w) && tx < c1 && ty < r1 && tx + cw > c0 && ty + ch > r0 {
            if (t as u64) == wmswitch.sw_sel {
                wmdraw.fill_round(state, tx, ty, cw, ch, wmswitch.sw_dim(state, 8, k) as u64, accent, 255, c0, r0, c1, r1)
                let b: i64 = wmswitch.sw_dim(state, 3, k)
                wmdraw.fill_round(state, tx + b, ty + b, cw - 2 * b, ch - 2 * b, wmswitch.sw_dim(state, 6, k) as u64, 0x2E2E2E, 255, c0, r0, c1, r1)
            }
            let m: i64 = wmswitch.sw_dim(state, 10, k)
            let thx: i64 = tx + m
            let thy: i64 = ty + m
            let thw: i64 = cw - 2 * m
            let thh: i64 = ch - 2 * m - wmswitch.sw_dim(state, 26, k)
            let bw: i64 = wmlayout.wg(state, w, wmlayout.W_W) as i64
            let bh: i64 = wmlayout.wg(state, w, wmlayout.W_H) as i64
            let buf: u64 = wmlayout.wg(state, w, wmlayout.W_BUF)

            if !(bw > 0 && bh > 0 && buf != 0) {
                wmdraw.fill_clip(state, thx, thy, thw, thh, 0x101010, 255, c0, r0, c1, r1)
            }
            if bw > 0 && bh > 0 && buf != 0 && thw > 0 && thh > 0 {
                var nw: i64 = thw
                var nh: i64 = bh * thw / bw
                if nh > thh {
                    nh = thh
                    nw = bw * thh / bh
                }
                if nw > 0 && nh > 0 {
                    let ox: i64 = thx + (thw - nw) / 2
                    let oy: i64 = thy + (thh - nh) / 2
                    let ax0: i64 = wmbase.imax(ox, c0)
                    let ax1: i64 = wmbase.imin(ox + nw, c1)
                    let ay0: i64 = wmbase.imax(oy, r0)
                    let ay1: i64 = wmbase.imin(oy + nh, r1)
                    let stride: u64 = wmlayout.wg(state, w, wmlayout.W_W)
                    var y: i64 = ay0
                    while y < ay1 && ax1 > ax0 {
                        let sy: i64 = (y - oy) * bh / nh
                        if sy >= 0 && sy < bh && y >= 0 {
                            fb.scaled_row_a(state, y as u64, ax0, ax1, buf +% (sy as u64) *% stride *% 4, ox, bw, nw, 255)
                        }
                        y = y + 1
                    }
                }
            }
            var lead_x: i64 = thx
            let an: u64 = wmcore.win_app(state, w)
            if an != 0 && f < ttf.MAX_FONTS && (__mmio_read8((an) as *mut u8)) != 0 as u8 {

                let ts: i64 = wmswitch.sw_dim(state, 16, k)
                let ty2: i64 = thy + thh + wmswitch.sw_dim(state, 4, k)
                wmdraw.fill_round(state, thx, ty2, ts, ts, wmswitch.sw_dim(state, 4, k) as u64, appicon.color_of(an), 255, c0, r0, c1, r1)
                let cp: u64 = appicon.letter_cp(an, 0)
                if cp != 0 {
                    let gs_: u64 = ttf.glyph(state, f, cp, pxui)
                    if gs_ < ttf.SLOTS {
                        let gw_: i64 = ttf.g_w(state, gs_) as i64
                        let gh_: i64 = ttf.g_h(state, gs_) as i64
                        wmdraw.fb_glyph(state, gs_, thx + (ts - gw_) / 2 - ttf.g_left(state, gs_),
                            ty2 + (ts - gh_) / 2 + ttf.g_top(state, gs_), 0xFFFFFF,
                            wmbase.imax(thx, c0), wmbase.imax(ty, r0), wmbase.imin(tx + cw, c1), wmbase.imin(ty + ch, r1))
                    }
                }
                lead_x = thx + ts + wmswitch.sw_dim(state, 4, k)
            }
            if f < ttf.MAX_FONTS {
                wmtitle.title_text(state, w, f, lead_x, thy + thh + wmswitch.sw_dim(state, 4, k) + ttf.ascent(state, f, pxui), 0xFFFFFF,
                    wmbase.imax(thx, c0), wmbase.imax(ty, r0), wmbase.imin(tx + cw, c1), wmbase.imin(ty + ch, r1), tx + cw - m)
            }
        }
        t = t + 1
    }
}
