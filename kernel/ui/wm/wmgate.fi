profile kernel

import lib.kstate
import ui.wm.wmbase
import ui.wm.wmlayout

const M_SHIFT: u64 = 8

const M_CTRL: u64 = 16

fn mods_of(state: u64) -> u64 {
    var m: u64 = 0
    if kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1 {
        m = m | M_SHIFT
    }
    if kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 1 {
        m = m | M_CTRL
    }
    return m
}

fn hit(state: u64, x: i64, y: i64) -> u64 {
    var z: u64 = wmlayout.gs(state, wmlayout.S_COUNT)
    while z > 0 {
        z = z - 1
        let i: u64 = wmbase.at_z(state, z)

        if i < wmbase.MAX_WIN && wmlayout.wg(state, i, wmlayout.W_LAYER) != wmlayout.L_TIP
            && wmlayout.wg(state, i, wmlayout.W_LAYER) != wmlayout.L_TOAST
            && (wmlayout.wg(state, i, wmlayout.W_FLAGS) & (wmlayout.F_HIDDEN | wmlayout.F_TABBED)) == 0 {
            let rx: i64 = wmbase.win_x(state, i) + wmbase.outer_w(state, i) as i64
            let ry: i64 = wmbase.win_y(state, i) + wmbase.outer_h(state, i) as i64
            if x >= wmbase.win_x(state, i) && y >= wmbase.win_y(state, i) {
                if x < rx && y < ry {
                    return i
                }
            }
        }
    }
    return wmbase.MAX_WIN
}

static mut dh_live: u64 = 0

fn dnd_forbidden(state: u64, i: u64) -> bool {
    if dh_live == 0 {
        return false
    }
    if i >= wmbase.MAX_WIN || !wmbase.valid(state, i) {
        return true
    }
    return wmlayout.wg(state, i, wmlayout.W_LAYER) == wmlayout.L_DESK
}

fn sperre_an(state: u64) -> bool {
    return kstate.get(state, kstate.K11_OFF + kstate.SP_ON) != 0
}

fn sperrer(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.SP_PID)
}

fn lock_space(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.SP_SLOT)
}

fn darf(state: u64, i: u64) -> bool {
    if !sperre_an(state) {
        return true
    }
    let p: u64 = lock_space(state)
    if sperrer(state) == 0 {
        return false
    }
    return wmlayout.wg(state, i, wmlayout.W_OWNER) == p
}
