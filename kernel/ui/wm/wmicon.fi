profile kernel

import appicon
import gfx.ttf
import libc.numeric
import ui.wm.wmbase
import ui.wm.wmcore
import ui.wm.wmdraw
import ui.wm.wmgate
import ui.wm.wmgeom
import ui.wm.wmlayout
import ui.wm.wmtabs
import ui.wm.wmtitle

const BASE_PX: u64 = 16

const GAP_PX: u64 = 8

const RADIUS_DIV: u64 = 4

const LETTER_NUM: u64 = 3

const LETTER_DEN: u64 = 4

const PRESENT: u64 = 0x8000000000000000

const CP_SHIFT: u64 = 24

const COLOUR_MASK: u64 = 0xFFFFFF

const LETTER_RGB: u64 = 0xFFFFFF

fn size(state: u64, i: u64) -> u64 {
    return wmgeom.fs(state, i, BASE_PX)
}

fn gap(state: u64, i: u64) -> u64 {
    return wmgeom.fs(state, i, GAP_PX)
}

fn word(state: u64, i: u64) -> u64 {
    if i >= wmbase.MAX_WIN || wmgate.lock_active(state) || wmtabs.tt_strip(state, i) || wmtitle.cap_client(state, i) {
        return 0
    }
    let name: u64 = wmcore.win_app(state, i)
    if name == 0 || (__mmio_read8((name) as *mut u8)) == 0 as u8 {
        return 0
    }
    let cp: u64 = appicon.letter_cp(name, 0)
    if cp == 0 {
        return 0
    }
    return PRESENT | (cp << CP_SHIFT) | (appicon.color_of(name) & COLOUR_MASK)
}

fn advance(state: u64, i: u64) -> i64 {
    if word(state, i) == 0 {
        return 0
    }
    return (size(state, i) + gap(state, i)) as i64
}

fn top(state: u64, i: u64) -> i64 {
    let bar: i64 = wmgeom.title_h(state, i) as i64 - 1 - wmgeom.border(state, i) as i64
    return wmgeom.border(state, i) as i64 + numeric.imax(0, bar - size(state, i) as i64) / 2
}

fn left(state: u64, i: u64) -> i64 {
    return wmgeom.border(state, i) as i64 + wmgeom.title_pad(state, i) as i64
}

fn paint(state: u64, i: u64, wx: i64, wy: i64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let w: u64 = word(state, i)
    let f: u64 = wmlayout.gs(state, wmlayout.S_FONT_UI)
    if w == 0 || f >= ttf.MAX_FONTS {
        return
    }
    let sz: i64 = size(state, i) as i64
    let x: i64 = wx + left(state, i)
    let y: i64 = wy + top(state, i)
    wmdraw.fill_round(state, x, y, sz, sz, size(state, i) / RADIUS_DIV, w & COLOUR_MASK, 255, ax0, ay0, ax1, ay1)
    let slot: u64 = ttf.glyph(state, f, (w >> CP_SHIFT) & 0x1FFFFF, size(state, i) * LETTER_NUM / LETTER_DEN)
    if slot >= ttf.SLOTS {
        return
    }
    let gw: i64 = ttf.g_w(state, slot) as i64
    let gh: i64 = ttf.g_h(state, slot) as i64
    wmdraw.fb_glyph(state, slot, x + (sz - gw) / 2 - ttf.g_left(state, slot), y + (sz - gh) / 2 + ttf.g_top(state, slot),
        LETTER_RGB, ax0, ay0, ax1, ay1)
}
