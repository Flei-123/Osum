profile kernel

import ui.wm.wmbase
import ui.wm.wmgeom
import ui.wm.wmlayout

fn damage_win(state: u64, i: u64) {
    damage_win_ex(state, i, 0)
}

fn damage_win_ex(state: u64, i: u64, skip: u64) {

    glass_touch(state, i)

    var r: i64 = wmgeom.form(state, wmlayout.FM_SHADOW_R) as i64
    let r2: i64 = wmgeom.form(state, wmlayout.FM_SHADOW_R2) as i64
    if r2 > r {
        r = r2
    }
    if wmgeom.form(state, wmlayout.FM_SHADOW) == 0 && wmgeom.form(state, wmlayout.FM_SHADOW2) == 0 {
        r = 0
    }
    if !wmbase.deko(state, i) {
        r = 0
    }
    var x0: i64 = wmbase.win_x(state, i) - r
    var y0: i64 = wmbase.win_y(state, i) - r
    if x0 < 0 {
        x0 = 0
    }
    if y0 < 0 {
        y0 = 0
    }
    wmbase.damage_ex(state, x0, y0,
        wmbase.win_x(state, i) + wmbase.outer_w(state, i) as i64 + r + 1,
        wmbase.win_y(state, i) + wmbase.outer_h(state, i) as i64 + r + 1, skip)
}

fn glass_touch(state: u64, i: u64) {
    if wmlayout.gs(state, wmlayout.S_GLVALID) == 0 {
        return
    }
    let pw: u64 = wmbase.panel_win(state)
    if pw < wmbase.MAX_WIN && i == pw {
        return
    }
    if pw >= wmbase.MAX_WIN {
        wmlayout.ss(state, wmlayout.S_GLASSGEN, wmlayout.gs(state, wmlayout.S_GLASSGEN) + 1)
        return
    }
    if !wmbase.valid(state, i) {
        wmlayout.ss(state, wmlayout.S_GLASSGEN, wmlayout.gs(state, wmlayout.S_GLASSGEN) + 1)
        return
    }

    let px0: i64 = wmbase.win_x(state, pw)
    let py0: i64 = wmbase.win_y(state, pw)
    let px1: i64 = px0 + wmbase.outer_w(state, pw) as i64
    let py1: i64 = py0 + wmbase.outer_h(state, pw) as i64
    let wx0: i64 = wmbase.win_x(state, i)
    let wy0: i64 = wmbase.win_y(state, i)
    let wx1: i64 = wx0 + wmbase.outer_w(state, i) as i64
    let wy1: i64 = wy0 + wmbase.outer_h(state, i) as i64
    if wx1 <= px0 || wx0 >= px1 || wy1 <= py0 || wy0 >= py1 {
        return
    }
    wmlayout.ss(state, wmlayout.S_GLASSGEN, wmlayout.gs(state, wmlayout.S_GLASSGEN) + 1)
}
