// SPDX-License-Identifier: GPL-2.0-only
// kernel/usb.fi -- Runde K17: der Kern ueber dem Regler, und die drei
// Klassen, die ein Rechner wirklich braucht.
//
// `xhci.fi` weiss, was ein Steckplatz und ein Endpunkt ist. Diese Datei
// weiss, was ein GERAET ist -- und das ist etwas anderes: ein Geraet
// beschreibt sich selbst, und zwar in einer festen Reihenfolge, die man
// nicht abkuerzen kann.
//
//   1. ANSCHLUSS EINSCHALTEN UND ZURUECKSETZEN. Ein USB-2-Geraet meldet
//      sich erst nach einer Ruecksetzung; ein USB-3-Geraet richtet die
//      Verbindung selbst ein und ist danach schon freigeschaltet. Beide
//      Faelle stehen hier, weil `qemu-xhci` beide anbietet -- die
//      vorderen Anschluesse sind USB 2, die hinteren USB 3.
//   2. STECKPLATZ ANFORDERN und einen Geraetezusammenhang dafuer
//      hinterlegen.
//   3. ADRESSE VERGEBEN. Bis hierher hoert das Geraet auf Adresse 0; der
//      Befehl `Address Device` gibt ihm eine eigene.
//   4. DESKRIPTOREN LESEN, und zwar in ZWEI Schritten: erst acht Oktett
//      des Geraetedeskriptors, weil in Oktett 7 steht, wie gross ein
//      Paket auf dem Steuerungsendpunkt sein darf -- und ein
//      langsameres Geraet sagt dort acht, wo der Treiber vierundsechzig
//      angenommen hat. Dann der ganze.
//   5. KONFIGURATIONSDESKRIPTOR, auch in zwei Schritten: die ersten neun
//      Oktett sagen, wie lang das Ganze ist. Darin stehen die
//      SCHNITTSTELLEN und ihre ENDPUNKTE -- eine Kette von Bloecken
//      hintereinander, jeder mit seiner Laenge im ersten Oktett.
//   6. ENDPUNKTE EINRICHTEN (`Configure Endpoint`) und dann
//      `SET_CONFIGURATION`. In dieser Reihenfolge: der Regler muss die
//      Bandbreite kennen, bevor das Geraet zu senden anfaengt.
//   7. TREIBER ZUORDNEN, an der KLASSE der Schnittstelle und an nichts
//      sonst. Ein Treiber, der an Hersteller- und Geraetenummer haengt,
//      kennt genau die Geraete, die sein Schreiber besass.
//
// DIE TASTATUR UND DIE MAUS MUENDEN IN DEN BESTEHENDEN EINGABEWEG, und
// das ist woertlich gemeint: der Tastaturtreiber uebersetzt den
// HID-Gebrauchscode in einen PS/2-ABTASTCODE (Satz 1) und ruft damit
// `kbd.on_code` -- dieselbe Funktion, die die Unterbrechung von IRQ 1
// ruft. Es gibt keinen zweiten Weg in die Zeilendisziplin, keinen
// zweiten Fokus im Fensterserver und keine zweite Tabelle fuer
// Umschalt und Steuerung. Die Maus baut aus dem HID-Bericht ein
// PS/2-PAKET und gibt es an `ps2m.usb_packet`. Damit gilt fuer Shell,
// Fensterserver und Widgets: sie merken nicht, woher die Taste kam --
// und genau das misst `tools/k17/run.sh`, indem es DENSELBEN Testlauf
// einmal mit `-device usb-kbd` und einmal mit PS/2 faehrt und die
// Ausgaben Oktett fuer Oktett vergleicht.
//
// DER STICK IST EIN BLOCKGERAET, und auch das ist woertlich gemeint: er
// haengt als `blk.DEV_USB` an derselben Schnittstelle wie RAM-Platte,
// ATA und NVMe (`kernel/blk.fi`, Runde 62). `fs.fi`, `vfs.fi` und
// `fat.fi` aendern dafuer keine Zeile -- dieselbe Zusage wie bei NVMe in
// Runde K2, und dieselbe Art, sie zu pruefen: das Abbild wird nach dem
// Lauf VON AUSSEN gelesen.
//
// WAS DIESE DATEI NICHT TUT: sie kennt keine HID-Berichtsbeschreibung.
// Tastatur und Maus laufen im BOOT-PROTOKOLL (`SET_PROTOCOL 0`), in dem
// das Berichtsformat festgelegt ist -- acht Oktett bei der Tastatur,
// drei oder vier bei der Maus. Das ist kein Kniff: es ist der Grund,
// warum jedes BIOS eine USB-Tastatur bedienen kann, ohne einen Zerleger
// fuer Berichtsbeschreibungen zu haben. Ein Geraet ohne Boot-Protokoll
// (Schnittstellenunterklasse != 1) wird deshalb ausdruecklich ABGELEHNT
// und nicht stillschweigend falsch gelesen.

profile kernel

import serial
import lib.kstate
import block.wlock
import klog
import wlan.usbchip
import usbnet.rndis
import usbnet.ncm
import usbnet.ch397
import usbnet.ax88772
import usbnet.ax88772_drv
import drv.net.usbnet
import drv.net.usbvnic
import drv.usb.xhci
import usb.scsi
import drv.usb.chdiag
import drv.usb.usbdiag
import drv.hid.kbd
import drv.hid.inreg
import drv.hid.hidmode
import touchev.inmode
import touchev.quirk
import drv.hid.hidrep
import drv.hid.hidin
import gfx.gfx

export {
    resume, stage, irq, service, poll, say, report, ready, count,
    msc_ready, msc_blocks, msc_bsize,
    // RUNDE HOTPLUG-2: dasselbe JE PLATZ. `i` ist der Platz in der
    // Liste der Massenspeicher und zugleich `blk.DEV_USB0 + i`.
    msc_ready_at, msc_blocks_at, msc_bsize_at, msc_read_at, msc_write_at,
    msc_count, MAX_MSC, msc_sync_at,
    probe, unplug_check, unplug_now, keys, reports, enums, hotplugs, unplugs,
    // RUNDE HIDWEG: die Zahlen von `hidin`, durch diese Tuer. `kgui`
    // darf `hidin` NICHT einbinden -- hidin -> gfx -> kgui waere ein
    // Kreis im Modulgraphen, und der bleibt ein Baum.
    hid_keys, hid_los, hid_bew,
    dev_reps, dev_arms, dev_cc, dev_dci, dev_iface, dev_generic, dev_roh, dev_rohw, dev_rohn,
    silence_check, wachen, wiedern, kbd_taugt, mouse_works,
    stat,
    have_kbd, have_mouse, msc_errors, msc_ios, selftest,
    // RUNDE HOTPLUG: die zwei Flanken des Wechseldatentraegers.
    msc_gen, msc_weg,
    rangtest, rangtest_max,
    // RUNDE HIDPUNKTE: die Punktzahl je Regler und die getroffene Wahl.
    punkte, pkt_get, choice,
    DRV_NONE, DRV_KBD, DRV_MOUSE, DRV_MSC, DRV_HIDGEN, DRV_HUB, DRV_ECM, DRV_RNDIS, DRV_NCM, DRV_CH336, DRV_AX88772, DRV_AX88179, DRV_RTL8153,
    // ============================== RUNDE BLECHEINGABE
    // Was der Kern WIRKLICH sieht -- fuer den Bericht auf dem Schirm.
    // Justin kann nur fotografieren; eine Diagnose auf der seriellen
    // Leitung ist fuer ihn keine.
    fund_count, fund_port, fund_hub, fund_speed, fund_vid, fund_pid,
    fund_dcls, fund_dsub, fund_dpro, fund_icls, fund_isub, fund_ipro,
    fund_ifaces, fund_flags, fund_driver,
    F_ADDR, F_DESC, F_CFG, F_BOUND,
    hubs, hubports, fails, attached_map,
    // Die Lampen der Tastatur und der Herzschlag darueber.
    set_leds, led_service, beat_leds, leds_sent, leds_fail, leds_last,
    leds_try, kbd_dev, mouse_dev,
    dev_errs, dev_heal, dev_epstate, dev_slot, dev_intdci, heilungen, ch_diag,
    CK_LIVE, CK_PRESENT, CK_VID, CK_PID, CK_SPEED, CK_ROUTE, CK_NCFG, CK_CFG, CK_RC, CK_CLASS, CK_SUB, CK_PROTO, CK_IFACE, CK_INDCI, CK_OUTDCI, CK_INT, CK_BULKMPS, CK_STEP, CK_RESULT, CK_SET, CK_ALT, CK_ALTSCAN, CK_SETIF,
    without_space,
    // Aufzaehlen NICHT mehr aus dem Zeitgeber.
    port_watch, hotplug_work, pending,
    // RUNDE BLECHDREI: laeuft gerade eine Aufzaehlung?
    busy
}

// ---------------------------------------------- der Platz dieser Runde
//
// Die zwei Kilooktett hinter dem Kommandoring von `xhci.fi` -- derselbe
// Vorrat 0x50000..0x58000, kein Byte darueber hinaus.

// RUNDE BLECHEINGABE: die Skalare brauchen 0x180 statt 0x100 (acht
// neue Zaehler), das Geraetefeld 0x400 statt 0x300 und die Fundliste
// 0x280. Zusammen 0x800 -- genau der Vorrat 0x51800..0x52000, der
// zwischen dem Kommandoring (endet 0x51800) und dem Ereignisring
// (faengt 0x52000 an) liegt. Kein Oktett darueber hinaus.
const USCAL_OFF: u64 = 0x51800
// RUNDE BLECHEINGABE: 192 waren voll (D_GENERIC = 184 war das letzte
// Feld). Ein Geraet hinter einem Hub braucht mehr: den Wegweiser
// (Route-String), den Steckplatz des Hubs, seinen Anschluss dort, die
// Zahl der Schnittstellen und ob `SET_CONFIGURATION` quittiert wurde.
// RUNDE HOTPLUG-2: die alte Rechnung "256 * 4 = 1 KiB" stimmt seit
// Runde BLECHFUENF nicht mehr -- `DEV_BYTES` ist 384. Das Feld reicht
// von 0x51980 bis 0x51F80 und hat den Vorrat bis 0x52000 fast auf.
// Die Fundliste, die frueher auf 0x51D80 mittendrin lag, ist deshalb
// in die Pufferseite gezogen (siehe FUND_OFF).
// RUNDE HOTPLUG-2: das Geraetefeld ruecke um 0x80 nach hinten, weil der
// Skalarvorrat zu klein war. Er reichte von 0x51800 bis hierher, also
// 0x180 Oktette -- und `S_MSCWEG` steht auf 0x180. Der Zaehler der
// fallenden Flanke und `dev0.D_USED` (Feldanfang, Offset 0) waren
// DIESELBE ZELLE: jedes Abziehen schrieb die Belegtmarke des ersten
// Geraets. Jetzt hat der Vorrat 0x200, und die Liste der
// Massenspeicher (0x188..0x1A8) liegt sicher darin.
const UDEV_OFF: u64 = 0x51A00
const DEV_BYTES: u64 = 384 // RUNDE BLECHFUENF: Platz fuer D_REPS/D_LASTCC/D_ARMS
const MAX_DEV: u64 = 4

// ================================================ RUNDE BLECHEINGABE
// ================================ DIE FUNDLISTE, UND WARUM ES SIE GIBT
//
// Justin fragt zu Recht als ERSTES: "Sag, WAS DER KERN UEBERHAUPT
// SIEHT." Bis zu dieser Runde konnte der Kern das nicht sagen. Der
// Grund steht in `attach`: schlaegt `configure` fehl -- und es schlaegt
// fehl, sobald KEINE Schnittstelle zu diesem Kern passt --, dann ruft
// `attach` `drop_dev`, und das Geraet ist SPURLOS weg. Ein Hub (Klasse
// 09) fiel damit heraus, eine Tastatur mit unbekanntem Aufbau ebenso.
// Auf dem Bildschirm stand dann "devices=0", und das ist keine Diagnose,
// sondern ihr Gegenteil.
//
// Die Fundliste ist deshalb GETRENNT vom Geraetefeld: hier steht JEDES
// Geraet, das ueberhaupt geantwortet hat -- mit Anschluss,
// Geschwindigkeit, Hersteller/Erzeugnis, Klasse des Geraets UND der
// gewaehlten Schnittstelle, Zahl der Schnittstellen und einer Fahne je
// Stufe, die geglueckt ist. Sie wird NIE geleert.
// RUNDE HOTPLUG-2: DIE FUNDLISTE ZOG UM, WEIL SIE UEBERSCHRIEBEN WURDE.
//
// Sie lag auf 0x51D80 -- MITTEN IM GERAETEFELD. Der Kommentar bei
// UDEV_OFF rechnet noch mit 256 Oktett je Geraet; seit Runde BLECHFUENF
// sind es 384 (`DEV_BYTES`). Damit reicht das Geraetefeld bis 0x51F80
// und ueberlappt die Fundliste um 512 Oktette. `alloc_dev` nullt
// `DEV_BYTES` am Stueck, also loeschte
//   das DRITTE Geraet (dev2) die Fundeintraege 0..1,
//   das VIERTE  (dev3) die Fundeintraege 2..7.
// Gemerkt hat es niemand, weil bis heute selten vier USB-Geraete
// zugleich steckten -- ZWEI STICKS plus Hub plus Tastatur sind genau
// vier. Der Fehler ist AELTER als diese Runde; gefunden hat ihn die
// Bestandsaufnahme, nicht ein Absturz.
//
// Sie liegt jetzt hinter dem Hub-Puffer in der Pufferseite: `HUB_OFF`
// braucht 40 Oktette (Deskriptor + Anschlusszustand bei +32), der Rest
// der Seite bis 0x57000 war unbenutzt. Der Skalarvorrat
// 0x51800..0x52000 gehoert damit allein den Skalaren und dem
// Geraetefeld.
const FUND_OFF: u64 = 0x56700
const FUND_BYTES: u64 = 64
const MAX_FUND: u64 = 10

const F_USED: u64 = 0
const F_PORT: u64 = 8 // Wurzelanschluss | Hubanschluss << 8
const F_SPEED: u64 = 16
const F_ID: u64 = 24 // VID << 16 | PID
const F_DCLS: u64 = 32 // Geraeteklasse << 16 | Unterklasse << 8 | Protokoll
const F_ICLS: u64 = 40 // dasselbe fuer die GEWAEHLTE Schnittstelle
const F_IFACES: u64 = 48 // wie viele Schnittstellen die Konfiguration hat
const F_FLAGS: u64 = 56 // welche Stufe geglueckt ist, plus der Treiber

// Die Stufen. Justin sieht auf dem Schirm, WIE WEIT ein Geraet kam.
const F_ADDR: u64 = 1 // `Address Device` quittiert
const F_DESC: u64 = 2 // Geraetedeskriptor gelesen
const F_CFG: u64 = 4 // SET_CONFIGURATION quittiert
const F_BOUND: u64 = 8 // ein Treiber hat es genommen

// Der Hub-Deskriptor und die Anschlusszustaende dahinter.
const HUB_OFF: u64 = 0x56600

// Die Puffer, die ein GERAET beschreibt. Sie liegen in `kdata`, weil der
// Regler sie ueber den Bus erreicht und der Haldenallokator nichts
// darueber verspricht, wo etwas liegt.
const DESC_OFF: u64 = 0x56000 // Deskriptoren, 512
const REPORT_OFF: u64 = 0x56200 // vier Berichte zu 64
const CBW_OFF: u64 = 0x56300 // der Befehlsblock, 64
const CSW_OFF: u64 = 0x56340 // die Quittung, 64
const BLK_OFF: u64 = 0x56400 // ein Datenblock, 512

const S_READY: u64 = 0x00
const S_NDEV: u64 = 0x08
const S_ENUMS: u64 = 0x10
const S_KBD: u64 = 0x18 // Platz + 1, 0 = keine
const S_MOUSE: u64 = 0x20
// 0x28 war `S_MSC`, die EINE Zelle fuer den einen Massenspeicher.
// Seit HOTPLUG-2 steht die Liste auf 0x188 (siehe `S_MSCTAB`), weil
// hier zwischen 0x28 und `S_TAG` (0x40) nur drei Plaetze frei waren
// und ein vierter `S_TAG` ueberschrieben haette -- die Laufnummer des
// Bulk-Only-Transports, also ausgerechnet die Zahl, an der jede
// Quittung haengt.
// 0x30 und 0x38 gehoeren seit HOTPLUG-2 zur Liste oben (Platz 1 und 2).
// Die Groesse steht je Geraet in `D_MSCBLK`/`D_MSCBS`.
const S_TAG: u64 = 0x40
const S_REPORTS: u64 = 0x48
const S_KEYS: u64 = 0x50
const S_MOVES: u64 = 0x58
const S_UNPLUGS: u64 = 0x60
const S_HOTPLUGS: u64 = 0x68
const S_MSCERR: u64 = 0x70
const S_MSCIO: u64 = 0x78
const S_FAILS: u64 = 0x80
const S_ATTACHED: u64 = 0x88 // Bitkarte der Anschluesse mit Geraet
const S_NOHID: u64 = 0x90
const S_NOMSC: u64 = 0x98
const S_LASTDATA: u64 = 0xA0 // Oktette im Datenteil der letzten BOT-Runde
const S_GEN: u64 = 0xA8 // 1 = der generische Weg ist erlaubt (Modus `hid`)
const S_GENDEV: u64 = 0xB0 // wie viele Geraete wirklich darueber laufen
const S_RDFAIL: u64 = 0xB8 // Beschreibung nicht zu holen/zu zerlegen
const S_RDLEN: u64 = 0xC0 // Oktette der zuletzt geholten Beschreibung
// RUNDE BLECH-HID: 1, solange DIESER Baum selbst aufzaehlt. Siehe
// `unplug_check` -- der Zeitgeber darf dem Aufzaehlen nicht ins Wort
// fallen.
const S_BUSY: u64 = 0xC8
// RUNDE BLECHEINGABE.
const S_FUNDN: u64 = 0xF8 // Eintraege in der Fundliste
const S_HUBS: u64 = 0x100 // gefundene Hubs
const S_HUBPORTS: u64 = 0x108 // Anschluesse hinter allen Hubs zusammen
const S_LEDS: u64 = 0x110 // was zuletzt an die Tastatur ging
const S_LEDOK: u64 = 0x118 // erfolgreiche SET_REPORT
const S_LEDBAD: u64 = 0x120 // fehlgeschlagene
const S_PEND: u64 = 0x128 // Bitkarte der Anschluesse mit offenem Wechsel
const S_HUBDUE: u64 = 0xD8
const S_HUBTRY: u64 = 0xE0
const S_HUBHITS: u64 = 0xE8
const HUB_TRY_MAX: u64 = 48
const S_PENDN: u64 = 0x130 // wie oft der Zeitgeber einen Wechsel sah
const S_LEDHERZ: u64 = 0x138 // die Lampe, die der Herzschlag gerade legt
// RUNDE BLECHZWEI: wie oft es VERSUCHT wurde. `LED 0` allein sagt
// nicht, ob es keine Tastatur gab oder ob der Steuertransfer
// scheiterte -- das sind zwei verschiedene Fehler.
const S_LEDTRY: u64 = 0x140
// 1, solange ein SET_REPORT laeuft. Der Zeitgeber und die
// Schreibtischschleife greifen sonst gleichzeitig auf den
// Steuerungsring desselben Steckplatzes zu.
const S_LEDBUSY: u64 = 0x148
// ============================================== RUNDE STARTKNOPF
// Wie oft ein Unterbrechungsendpunkt wiederbelebt werden musste.
const S_HEAL: u64 = 0x150
// 1, solange `service` laeuft. Die Wiederbelebung eines Endpunkts
// wartet auf Antworten des Reglers; faellt in diese Wartezeit eine
// zweite Meldung, stuenden zwei Durchlaeufe auf demselben Ring.
const S_SVCBUSY: u64 = 0x158
// RUNDE ECHTHARDWARE-6: wie oft der Wachhund nachgesehen hat.
const S_WACHN: u64 = 0x168
const S_WIEDERN: u64 = 0x170 // neu bestueckte stumme Endpunkte

// ====================================== RUNDE HOTPLUG
// DIE ZAEHLER, AN DENEN EIN ANDERER DIE FLANKE SIEHT.
//
// Dieser Baum darf NICHTS von Partitionen, Dateisystemen und Pfaden
// wissen -- `tools/k17/run.sh`, Abschnitt 1, misst genau das, und der
// Kopf dieser Datei sagt seit Runde K17, warum. Der Stick ist hier ein
// BLOCKGERAET und sonst nichts.
//
// Damit trotzdem jemand merken kann, DASS einer gekommen oder gegangen
// ist, zaehlt dieser Baum zwei Flanken mit -- zwei Zahlen, mehr nicht.
// Wer sie liest (`kernel/kgui.fi`, die Schreibtischschleife), vergleicht
// sie mit dem, was er beim letzten Blick gesehen hat, und macht die
// Arbeit selbst. Das ist derselbe Griff, mit dem `port_watch` und
// `hotplug_work` zusammenarbeiten: der eine merkt, der andere handelt.
//
// WARUM NICHT EIN RUECKRUF: ein Funktionszeiger aus `usb.fi` in eine
// Schicht darueber waere derselbe Kreis im Modulgraphen, nur
// verschleiert. Eine Zahl kennt niemanden.
const S_MSCGEN: u64 = 0x178 // +1, sobald ein Massenspeicher bereit ist
const S_MSCWEG: u64 = 0x180 // +1, sobald einer verschwunden ist

// ===================================== RUNDE HOTPLUG-2
// DIE LISTE DER MASSENSPEICHER, und warum sie eine Liste ist.
//
// Vier Plaetze zu 8 Oktett, 0x188..0x1A8. `S_MSCTAB + n * 8` haelt
// `Geraetenummer + 1` des n-ten Massenspeichers, 0 = frei. Der Platz n
// ist die Nummer, die nach aussen geht: `blk.DEV_USB0 + n`.
//
// WARUM DER PLATZ UND NICHT DIE GERAETENUMMER nach aussen geht: die
// Geraetenummer ist ein Platz im USB-Geraetefeld und wird nach dem
// Abziehen sofort wieder vergeben (`alloc_dev` nimmt den ersten
// freien). Wer zwei Sticks steckt, einen abzieht und einen neuen
// steckt, bekaeme sonst fuer den neuen Stick die Nummer des alten --
// und `wechsel.fi` haelt die Einhaengung an genau dieser Nummer fest.
// Der Platz in DIESER Liste wird dagegen erst frei, wenn der
// Massenspeicher geht, und `blk.fi` kennt nur ihn.
const S_MSCTAB: u64 = 0x188
const MAX_MSC: u64 = 4
// Wie oft `alloc_dev` leer war -- ein Geraet, fuer das kein Platz mehr
// da ist, verschwindet sonst spurlos. Justins Brett meldet FUND 5 bei
// MAX_DEV 4; ob das je angeschlagen hat, stand nirgends.
const S_NOPLATZ: u64 = 0x160

// RUNDE HIDPUNKTE: DIE PUNKTZAHL JE REGLER, und sie ist der ganze
// Unterschied zwischen "Justin kann tippen" und "Justin kann nicht
// tippen". Bis zu dieser Runde gewann der ERSTE Regler, an dem
// IRGENDEIN Eingabegeraet hing. Auf Justins Brett haengt an hc0 ein
// Stick und ein HID OHNE Boot-Protokoll (Kingston 0951:16df), an hc1
// seine Tastatur und seine Maus -- und damit gewann hc0 mit einem
// Geraet, das keine Taste liefert, waehrend hc1 nie aufgesetzt wurde.
// Gemessen und nachgestellt in `tools/hidpunkte/run.sh`.
const S_PKT: u64 = 0xD0 // vier Regler zu 8 Oktett: 0xD0..0xF0
const S_WAHL: u64 = 0xF0 // welcher Regler behalten wurde
const MAX_HC_PKT: u64 = 4

const D_USED: u64 = 0
const D_SLOT: u64 = 8
const D_PORT: u64 = 16
const D_SPEED: u64 = 24
const D_VID: u64 = 32
const D_PID: u64 = 40
const D_CLASS: u64 = 48
const D_SUB: u64 = 56
const D_PROTO: u64 = 64
const D_DRIVER: u64 = 72
const D_INTDCI: u64 = 80
const D_INDCI: u64 = 88
const D_OUTDCI: u64 = 96
const D_INTLEN: u64 = 104
const D_SEQ: u64 = 112
const D_PREV: u64 = 120
const D_IFACE: u64 = 128
const D_CONFIG: u64 = 136
const D_MPS0: u64 = 144
const D_INTMPS: u64 = 152
const D_INTIVL: u64 = 160
const D_BULKMPS: u64 = 168
// RUNDE HID: die Laenge der Berichtsbeschreibung, wie der HID-Deskriptor
// (Art 0x21) sie ansagt, und ob dieses Geraet ueber den Zerleger laeuft.
const D_RDLEN: u64 = 176
const D_GENERIC: u64 = 184
// RUNDE BLECHEINGABE: alles, was ein Geraet HINTER EINEM HUB braucht.
const D_ROUTE: u64 = 192 // der Wegweiser, 20 Bit, 0 = direkt am Wurzelanschluss
const D_PARENT: u64 = 200 // Steckplatz des Hubs davor, 0 = keiner
const D_HUBPORT: u64 = 208 // Anschluss AN DIESEM Hub, 0 = Wurzel
const D_PORTS: u64 = 216 // ein Hub: wie viele Anschluesse er hat
const D_IFACES: u64 = 224 // Schnittstellen der Konfiguration
const D_FUND: u64 = 232 // Platz in der Fundliste + 1
const D_TTSLOT: u64 = 240 // Steckplatz des Uebersetzers (TT), 0 = keiner
const D_TTPORT: u64 = 248
// ============================================ RUNDE BLECHFUENF
// WAS JEDES GERAET FUER SICH GEMELDET HAT.
//
// Justins Tafel sagt "KBD 2 TAS 0": eine Tastatur ist da, und keine
// Taste kommt an. Damit ist NICHT entschieden, ob der
// Unterbrechungstransfer der Tastatur ueberhaupt fertig wird -- die
// Zahl `ber=` ist die SUMME ueber alle Geraete, und die Maus allein
// hat davon 6186 von 6188. Zwei Geraete in einem Zaehler sind eine
// Zahl ohne Aussage.
//
// Ab hier zaehlt JEDES Geraet fuer sich, und der zuletzt empfangene
// Bericht steht in den ersten acht Oktett auf der Tafel. Damit
// entscheidet EIN Foto die Frage: aendern sich die Oktett, wenn Justin
// eine Taste drueckt, kommt der Bericht an und der Zerleger ist
// schuld. Bleiben sie stehen, kommt gar nichts an.
const D_REPS: u64 = 256 // fertige Unterbrechungstransfers dieses Geraets
const D_LASTCC: u64 = 264 // der letzte Fertigmeldungscode
const D_ARMS: u64 = 272 // wie oft ein Block auf den Ring gelegt wurde
// ============================================== RUNDE STARTKNOPF
// FEHLER UND WIEDERBELEBUNGEN, JE GERAET.
const D_ERRS: u64 = 280 // Transfers mit schlechtem Fertigmeldungscode
const D_HEAL: u64 = 288 // wie oft der Endpunkt wiederbelebt wurde
// ====================================================== RUNDE VIELKERN
// DER LETZTE BERICHT, DER NICHT LEER WAR -- UND WARUM DAS DER
// UNTERSCHIED ZWISCHEN EINEM MESSGERAET UND EINER NULL IST.
//
// `dev_roh` las bisher den DMA-Puffer, also das, was die Karte ZULETZT
// hineingeschrieben hat. Eine USB-Tastatur im Boot-Protokoll schickt
// beim LOSLASSEN einen Bericht aus acht Nullen. Nach jedem normalen
// Tastendruck steht dort also 0000000000000000 -- die Tafel zeigte
// getreulich den Zustand "gerade wird keine Taste gehalten".
//
// Damit war die Zeile genau dann leer, wenn man sie liest, und Justins
// Anleitung dazu lautete folgerichtig "eine Taste druecken und HALTEN,
// dann fotografieren". Ein Messgeraet, das eine dritte Hand braucht,
// ist keins. Gemerkt wird deshalb der letzte Bericht, der NICHT nur
// Nullen war, und wie viele davon es gab.
const D_ROHW: u64 = 296 // die ersten acht Oktett, als ein Wort
const D_ROHN: u64 = 304 // wie viele nicht-leere Berichte es gab
// RUNDE ECHTHARDWARE-6: der letzte Stand von D_REPS, den der Wachhund
// gesehen hat. Bewegt er sich zwischen zwei Blicken nicht, wird einmal
// nachgesehen. Siehe `stille_pruefen`.
const D_WACH: u64 = 312
// RUNDE ECHTHARDWARE-6: wie viele Blicke lang dieses Geraet noch KEINEN
// einzigen Bericht geliefert hat, und wie oft sein Ring deshalb neu
// bestueckt wurde.
const D_STUMM: u64 = 320
const D_AGAIN: u64 = 328

// ===================================== RUNDE HOTPLUG-2
// DIE GROESSE DES STICKS GEHOERT ZUM STICK, NICHT ZUM BAUM.
//
// Bis zu dieser Runde standen Bloecke und Blockgroesse in den Skalaren
// (`S_BLOCKS`, `S_BSIZE`) -- also EINMAL fuer den ganzen Rechner. Beim
// zweiten Stick ueberschrieb `msc_start` die Zahlen des ersten, und
// `blk.blocks_on` haette danach fuer BEIDE die Groesse des zuletzt
// gesteckten gemeldet. Das ist der Grund, warum die Vorrunde den
// zweiten Stick lieber abgelehnt hat.
//
// Hier ist Platz: 384 Oktett je Geraet, benutzt waren 336.
const D_MSCBLK: u64 = 336 // Bloecke dieses Massenspeichers
const D_MSCBS: u64 = 344 // Oktette je Block (immer 512, sonst abgelehnt)
// Vier Blicke je Sekunde -> rund fuenf Sekunden Stille.
const WACH_GRENZE: u64 = 20
const AGAIN_MAX: u64 = 3

const DRV_NONE: u64 = 0
const DRV_KBD: u64 = 1
const DRV_MOUSE: u64 = 2
const DRV_MSC: u64 = 3
// RUNDE HID: eine HID-Schnittstelle OHNE Boot-Protokoll. Was sie ist --
// Tastatur, Maus, Touchpad -- steht nicht in ihrer Klasse, sondern in
// ihrer Berichtsbeschreibung; entschieden wird deshalb erst in
// `hid_start`, nachdem die geholt und zerlegt ist.
const DRV_HIDGEN: u64 = 4
// RUNDE BLECHEINGABE: der Hub. `grep -i hub kernel/usb.fi kernel/xhci.fi`
// hatte bis zu dieser Runde NULL Treffer -- der Kern sah ausschliesslich
// Geraete, die DIREKT an einem Wurzelanschluss hingen. Auf einem
// heutigen Brett haengen die hinteren Buchsen regelmaessig an internen
// Hubs, und eine Spieletastatur bringt oft ihren eigenen mit
// (Durchschleifbuchse). Das ist die Zeile zwischen "startet auf einem
// Rechner" und "startet auf DIESEM Rechner".
const DRV_HUB: u64 = 5
// L-015: CDC-ECM network function (USB tethering, QEMU usb-net CDC config).
const DRV_ECM: u64 = 6
// r811: RNDIS network function (Android tethering, QEMU usb-net RNDIS configuration). Used ONLY when the device
// offers no CDC-ECM configuration (ECM is preferred), or when the kernel word `rndisonly` forces it (test gate).
const DRV_RNDIS: u64 = 7
const DRV_ISOTEST: u64 = 8
// r811: CDC-NCM network function (class 02/0D; many Android phones and every modern USB LAN dongle with NTB framing).
// Last resort like RNDIS (pass 2 of `configure`): ECM is preferred. No QEMU model exists: only the host gate
// tools/ncm covers the framing, the bring-up path is verified on real hardware.
const DRV_NCM: u64 = 9
// LW-1a: WCH CH336/CH339/CH396/CH397 USB Ethernet (vendor class FF/FF/FF, Justin's 1A86:5394 dongle). Taken only for
// the vendor/product ids lib/usbnet/ch397.fi `supported` lists; framing unverified on silicon.
const DRV_CH336: u64 = 10
// r1607: ASIX AX88772/772B (0B95:7720/772A/772B/7E2B): vendor-class function taken by id, bring-up in `ax88772_start`; unverified on silicon.
const DRV_AX88772: u64 = 11
const DRV_AX88179: u64 = 12
const DRV_RTL8153: u64 = 13
const S_AXOK: u64 = 0x1D0 // 1 = a vendor-class interface may be picked in `wanted` (ASIX dongle)
// Scratch cells of the USB state page (inside the 0x200 bytes that `stage` clears).
const S_RNDISOK: u64 = 0x1E0 // 1 = RNDIS control interfaces may be picked in `wanted`
const S_NOECM: u64 = 0x1E8 // 1 = CDC-ECM is refused (word `rndisonly`)
// r813: isochronous test bed (word `isoctest`). One audio streaming alt setting is remembered here (packed, see `iso_data`).
const S_CHOK: u64 = 0x1D8 // 1 = a vendor-class FF/FF/FF interface may be picked in `wanted` (WCH dongle)
const S_ISOOK: u64 = 0x1F0 // 1 = the audio control interface may be picked in `wanted`
const S_CHDEV: u64 = 0x1B8 // device index + 1 of the WCH dongle (0 = none)
const S_CHRC: u64 = 0x1C0 // SET_CONFIGURATION result of the WCH dongle (signed)
const S_CHSTEP: u64 = 0x1C8 // bring-up step reached | result << 8 (1 ok, 2 failed)
const S_CHINT: u64 = 0x1A8 // interrupt endpoint of the WCH dongle: dci | mps << 8 | interval << 24
const S_CHSET: u64 = 0x1B0 // WCH dongle: bit0 SET_CONFIGURATION sent, bits 8-15 alt, bit16 alt scan used, bit17 SET_INTERFACE sent, bit18 failed, bits 24-31 error
const S_ISOA: u64 = 0x1F8 // dci | iface << 8 | alt << 16 | binterval << 24 | wMaxPacketSize << 32 (0 = none found)
const ISO_BUF_OFF: u64 = 0x56A00 // 8 packet buffers of 192 bytes (48 kHz, 16 bit, stereo, 1 ms)
const ISO_BUFS: u64 = 8
const ISO_PKT: u64 = 192
const ISO_TDS: u64 = 200
const CLS_CDC: u64 = 2
const D_NCFG: u64 = 352 // bNumConfigurations of the device descriptor
const D_MACSTR: u64 = 360 // ECM: string index of the MAC address
const D_DATAIF: u64 = 368 // ECM: number of the data interface (union descriptor)
const D_DATAALT: u64 = 376 // ECM: alternate setting that carries the bulk pipes

// Die Standardanforderungen. Sie stehen im Kapitel 9 der Spezifikation
// und in jedem Geraet der Welt gleich.
const REQ_GET_DESCRIPTOR: u64 = 6
const REQ_SET_CONFIGURATION: u64 = 9
const REQ_CLEAR_FEATURE: u64 = 1
const REQ_SET_FEATURE: u64 = 3
const REQ_GET_STATUS: u64 = 0
// RUNDE BLECHEINGABE: der Ausgabebericht. DAS ist die Anforderung, die
// eine Lampe an einer Tastatur umschaltet, und sie fehlte in diesem
// Baum vollstaendig.
const REQ_SET_REPORT: u64 = 9
const D_DEVICE: u64 = 1
const D_CONFIGURATION: u64 = 2
// Der Hub-Deskriptor: 0x29 fuer USB 2, 0x2A fuer SuperSpeed.
const D_HUB: u64 = 0x29
const D_HUB_SS: u64 = 0x2A

// Die Anschlussmerkmale eines Hubs (USB 2.0, Tabelle 11-17).
const PF_ENABLE: u64 = 1
const PF_RESET: u64 = 4
const PF_POWER: u64 = 8
const PF_C_CONNECTION: u64 = 16
const PF_C_ENABLE: u64 = 17
const PF_C_RESET: u64 = 20

const CLS_HID: u64 = 3
const CLS_MSC: u64 = 8
const CLS_HUB: u64 = 9

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state + USCAL_OFF, off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state + USCAL_OFF, off, v)
}

fn dev_at(state: u64, i: u64) -> u64 {
    return state + UDEV_OFF + i * DEV_BYTES
}

fn dg(state: u64, i: u64, f: u64) -> u64 {
    return __mmio_read64((dev_at(state, i) + f) as *mut u64)
}

fn ds(state: u64, i: u64, f: u64, v: u64) {
    __mmio_write64((dev_at(state, i) + f) as *mut u64, v)
}

fn ready(state: u64) -> bool {
    return g(state, S_READY) != 0
}

fn count(state: u64) -> u64 {
    return g(state, S_NDEV)
}

fn keys(state: u64) -> u64 {
    return g(state, S_KEYS)
}

fn reports(state: u64) -> u64 {
    return g(state, S_REPORTS)
}

fn enums(state: u64) -> u64 {
    return g(state, S_ENUMS)
}

fn hotplugs(state: u64) -> u64 {
    return g(state, S_HOTPLUGS)
}

fn unplugs(state: u64) -> u64 {
    return g(state, S_UNPLUGS)
}

fn have_kbd(state: u64) -> bool {
    return g(state, S_KBD) != 0
}

fn have_mouse(state: u64) -> bool {
    return g(state, S_MOUSE) != 0
}

fn msc_errors(state: u64) -> u64 {
    return g(state, S_MSCERR)
}

fn msc_ios(state: u64) -> u64 {
    return g(state, S_MSCIO)
}

// RUNDE HOTPLUG: wie oft ein Massenspeicher BEREIT geworden ist, und
// wie oft einer verschwunden ist. Beide Zahlen laufen nur nach oben;
// wer sie liest, merkt sich seinen letzten Stand.
fn msc_gen(state: u64) -> u64 {
    return g(state, S_MSCGEN)
}

fn msc_weg(state: u64) -> u64 {
    return g(state, S_MSCWEG)
}

fn b8(p: u64, i: u64) -> u64 {
    return kstate.get8(p + i)
}

fn b16(p: u64, i: u64) -> u64 {
    return b8(p, i) | (b8(p, i + 1) << 8)
}

fn wr32(at: u64, v: u64) {
    __mmio_write32(at as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n / 8 {
        __mmio_write64((p + i * 8) as *mut u64, 0)
        i = i + 1
    }
}

fn yes(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

// -------------------------------------------------------- der Aufbau

fn stage(state: u64) {
    var s_skip: [u8; 13] = "usb: skipped\0"
    var s_no: [u8; 19] = "usb: no controller\0"
    var s_fail: [u8; 18] = "usb: init failed\0\0"
    var s_hc: [u8; 12] = "usb: xhci \0\0"
    var s_slots: [u8; 7] = "slots=\0"
    var s_ports: [u8; 9] = "  ports=\0"
    var s_ctx: [u8; 7] = "  ctx=\0"
    var s_msix: [u8; 7] = "  irq=\0"
    var s_off: [u8; 12] = "usb: nousb\0\0"

    if !kstate.mode_on(state, kstate.M_USB) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    // RUNDE HOTPLUG-2: 0x200 statt 256. Geloescht wurden bisher nur
    // 0x000..0x0FF -- alles ab `S_HUBS` (0x100) ueberlebte eine neue
    // Aufzaehlung, darunter `S_MSCGEN`/`S_MSCWEG`, an denen die
    // Schicht darueber ihre Flanken misst.
    zero(state + USCAL_OFF, 0x200)
    zero(state + UDEV_OFF, MAX_DEV * DEV_BYTES)
    if kstate.mode_on(state, kstate.M_NOHID) {
        s(state, S_NOHID, 1)
    }
    // r811: `rndisonly` forces the RNDIS configuration of a device that offers both (test bed of the RNDIS driver).
    if kstate.mode_on(state, kstate.M_USBRNDIS) {
        s(state, S_RNDISOK, 1)
        s(state, S_NOECM, 1)
    }
    // r813: `isoctest` lets the audio control interface through `wanted`.
    if kstate.mode_on(state, kstate.M_USBISOC) {
        s(state, S_ISOOK, 1)
    }
    // RUNDE HID: der generische Weg. `nohidrep` ist die GEGENPROBE --
    // damit laeuft alles wie vor dieser Runde, im Boot-Protokoll, und
    // ein Geraet ohne Boot-Protokoll wird wieder abgelehnt. Der
    // Unterschied zwischen den beiden Laeufen ist die ganze Runde.
    if kstate.mode_on(state, kstate.M_HID)
        && !kstate.mode_on(state, kstate.M_NURBOOT) {
        s(state, S_GEN, 1)
    }
    hidin.stage(state)
    // RUNDE HIDWEG: die Rangfolge der Schnittstellen, gemessen an einem
    // gebauten Deskriptor. Steht hier und nicht in einem eigenen
    // Menueeintrag, weil sie keinen Regler braucht und weil die Zahl
    // damit auf JEDEM Foto steht, auf dem `usb:` steht.
    var s_rang: [u8; 15] = "usb: rang ok=\0\0"
    var s_von2: [u8; 4] = " / \0"
    serial.puts((&s_rang[0]) as u64)
    serial.dec(rangtest(state))
    serial.puts((&s_von2[0]) as u64)
    serial.dec(rangtest_max())
    serial.nl()
    if kstate.mode_on(state, kstate.M_NOMSC) {
        s(state, S_NOMSC, 1)
    }
    // DIE GEGENPROBE, die alles fallen laesst: kein Regler, kein Kern,
    // keine Klasse. Jede Zusage dieser Runde MUSS damit zusammenbrechen.
    if kstate.mode_on(state, kstate.M_NOUSB) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    if !xhci.present(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    let armed: bool = !kstate.mode_on(state, kstate.M_NOUSBIRQ)
    // ================================= RUNDE BLECH-HID: JEDER REGLER
    //
    // Bis hierher wurde GENAU EINER aufgesetzt, und zwar der erste, den
    // `pci.find_class` fand. Auf Justins Brett sind es zwei
    // (1022:43d5 und 1022:149c), und niemand kann wissen, an welchem
    // seine Tastatur steckt. Also werden sie der Reihe nach probiert,
    // und der ERSTE, an dem ein Eingabegeraet haengt, bleibt stehen.
    //
    // WARUM NICHT BEIDE GLEICHZEITIG: der Vorrat dieses Treibers
    // (0x50000..0x58000, Ringe, Zusammenhaenge, Endpunkttafel) ist
    // EINMAL da. Zwei Regler gleichzeitig zu fahren hiesse, ihn zu
    // verdoppeln -- eine eigene Runde. Was diese Runde tut, ist das,
    // was den Unterschied zwischen "gar keine Eingabe" und "Eingabe"
    // ausmacht; und der Bericht sagt fuer JEDEN Regler, was an seinen
    // Anschluessen steht, damit ein Mensch Tastatur und Maus notfalls
    // an denselben stecken kann.
    chdiag.arm(state)
    usbdiag.reset_all()
    let anzahl: u64 = xhci.count_hc(state)
    // ================================= RUNDE HIDPUNKTE: DER BESTE, NICHT DER ERSTE
    //
    // JEDER Regler wird aufgesetzt und aufgezaehlt, und JEDER bekommt
    // eine Punktzahl (`punkte`). Danach wird der BESTE noch einmal
    // aufgesetzt und bleibt stehen. Das kostet auf einer Maschine mit
    // zwei Reglern ein zusaetzliches Aufsetzen (etwa 300 ms) und ist
    // der Unterschied zwischen einer toten und einer lebenden Tastatur.
    //
    // WARUM NICHT BEIDE GLEICHZEITIG: der Vorrat dieses Treibers
    // (0x50000..0x58000, Ringe, Zusammenhaenge, Endpunkttafel) ist
    // EINMAL da; zwei Regler gleichzeitig zu fahren hiesse, ihn zu
    // verdoppeln und jeden Zugriff reglerrelativ zu machen -- eine
    // eigene Runde. Was DIESE Runde leistet, ist, dass der Regler mit
    // der Tastatur gewinnt und nicht der mit dem Stick.
    var u: u64 = 0
    var bester: u64 = 0
    var bestp: u64 = 0
    while u < anzahl && u < MAX_HC_PKT {
        let p: u64 = versuch(state, u, armed)
        pkt_set(state, u, p)
        if p > bestp {
            bestp = p
            bester = u
        }
        u = u + 1
    }
    // Der beste wird noch einmal aufgesetzt -- ausser er war ohnehin
    // der letzte, dann steht er schon.
    let letzter: u64 = anzahl - 1
    if anzahl > 0 && bester != letzter {
        let _wieder: u64 = versuch(state, bester, armed)
    }
    s(state, S_WAHL, bester)
    usbdiag.set_choice(bester)
    usbdiag.set_t0(kstate.get(state, kstate.TICKS) + 1)
    // EINE ZEILE FUER EIN FOTO: welcher Regler wie viele Punkte hatte
    // und welcher gewonnen hat. Ohne sie ist "die Tastatur geht nicht"
    // nicht von "die Tastatur haengt am anderen Regler" zu trennen.
    var s_w1: [u8; 11] = "usb: wahl \0"
    var s_w2: [u8; 3] = "hc\0"
    var s_w3: [u8; 2] = "=\0"
    var s_w4: [u8; 6] = " -> h\0"
    var s_w5: [u8; 2] = "c\0"
    serial.puts((&s_w1[0]) as u64)
    var v: u64 = 0
    while v < anzahl && v < MAX_HC_PKT {
        serial.puts((&s_w2[0]) as u64)
        serial.dec(v)
        serial.puts((&s_w3[0]) as u64)
        serial.dec(pkt_get(state, v))
        serial.put(32 as u8)
        v = v + 1
    }
    serial.puts((&s_w4[0]) as u64)
    serial.puts((&s_w5[0]) as u64)
    serial.dec(bester)
    serial.nl()
}

fn usbdiag_snap_all(state: u64, h: u64, kind: u64) {
    let n: u64 = xhci.ports(state)
    var p: u64 = 1
    while p <= n && p <= usbdiag.MAX_PORT {
        usbdiag.snap(h, kind, p, xhci.portsc(state, p))
        p = p + 1
    }
}

fn usbdiag_open(state: u64, h: u64) {
    usbdiag.set_info(h, usbdiag.I_STATE, 1)
    usbdiag.set_info(h, usbdiag.I_PORTS, xhci.ports(state))
    usbdiag.set_info(h, usbdiag.I_SLOTS, xhci.slots(state))
    usbdiag.set_info(h, usbdiag.I_BDF, xhci.bdf(state))
    var p: u64 = 1
    while p <= xhci.ports(state) && p <= usbdiag.MAX_PORT {
        usbdiag.set_proto(h, p, xhci.port_major(state, p))
        p = p + 1
    }
    usbdiag_snap_all(state, h, usbdiag.SNAP_PRE)
}

fn usbdiag_close(state: u64, h: u64) {
    usbdiag_snap_all(state, h, usbdiag.SNAP_FINAL)
    usbdiag.set_info(h, usbdiag.I_STS, xhci.usbsts_raw(state))
    usbdiag.set_info(h, usbdiag.I_CMDS, xhci.cmds(state))
    usbdiag.set_info(h, usbdiag.I_EVENTS, xhci.events(state))
    usbdiag.set_info(h, usbdiag.I_ERRORS, xhci.errors(state))
    usbdiag.set_info(h, usbdiag.I_NDEV, g(state, S_NDEV))
    usbdiag.set_info(h, usbdiag.I_RESETFAIL, xhci.reset_fails(state))
    var pend: u64 = 0
    var p: u64 = 1
    while p <= xhci.ports(state) {
        if xhci.port_link_pending(state, p) {
            pend = pend + 1
        }
        p = p + 1
    }
    usbdiag.set_info(h, usbdiag.I_PENDING, pend)
}

// EIN REGLER: aufsetzen, Anschluesse einschalten, aufzaehlen, berichten.
// Gibt zurueck, ob an ihm eine Tastatur oder eine Maus haengt.
fn versuch(state: u64, einheit: u64, armed: bool) -> u64 {
    var s_fail: [u8; 22] = "usb: init fehlt hc\0\0\0\0"
    var s_hc: [u8; 12] = "usb: xhci \0\0"
    var s_slots: [u8; 7] = "slots=\0"
    var s_ports: [u8; 9] = "  ports=\0"
    var s_ctx: [u8; 7] = "  ctx=\0"
    var s_msix: [u8; 7] = "  irq=\0"
    var s_hcn: [u8; 6] = "  hc=\0"
    // Der Regler, der vorher lief, wird ANGEHALTEN, bevor der naechste
    // aufgesetzt wird -- sonst liest ein laufender Regler weiter aus
    // Ringen, die gleich neu beschrieben werden.
    xhci.teardown(state)
    chdiag.bump(state, chdiag.F_PASSES)
    chdiag.set64(state, chdiag.F_UNIT, einheit)
    usbdiag.begin_pass(einheit)
    s(state, S_READY, 0)
    zero(state + UDEV_OFF, MAX_DEV * DEV_BYTES)
    s(state, S_NDEV, 0)
    s(state, S_KBD, 0)
    s(state, S_MOUSE, 0)
    // RUNDE HOTPLUG-2: die ganze Liste leeren, nicht die eine Zelle.
    var mi: u64 = 0
    while mi < MAX_MSC {
        msc_slot_set(state, mi, 0)
        mi = mi + 1
    }
    s(state, S_ATTACHED, 0)
    if !xhci.init_at(state, einheit, armed) {
        usbdiag.set_info(einheit, usbdiag.I_STATE, 2)
        serial.puts((&s_fail[0]) as u64)
        serial.dec(einheit)
        serial.nl()
        // Auch ein Regler, der sich nicht aufsetzen laesst, bekommt
        // seine Zeile im Bericht -- sonst ist "nichts passiert" von
        // "es gibt ihn nicht" nicht zu unterscheiden.
        return 0
    }
    serial.puts((&s_hc[0]) as u64)
    serial.puts((&s_slots[0]) as u64)
    serial.dec(xhci.slots(state))
    serial.puts((&s_ports[0]) as u64)
    serial.dec(xhci.ports(state))
    serial.puts((&s_ctx[0]) as u64)
    serial.dec(xhci.ctx_size(state))
    serial.puts((&s_msix[0]) as u64)
    serial.dec(yes(armed))
    serial.puts((&s_hcn[0]) as u64)
    serial.dec(einheit)
    serial.nl()
    s(state, S_READY, 1)
    usbdiag_open(state, einheit)
    scan(state)
    usbdiag_close(state, einheit)
    xhci.bericht(state)
    say(state)
    return punkte(state)
}

// Alle Anschluesse einschalten und dann durchsehen. In zwei Durchgaengen,
// weil ein Anschluss nach dem Einschalten der Versorgung einen
// Augenblick braucht, bevor er eine Verbindung meldet -- und ein
// Treiber, der beides in einer Schleife tut, findet das erste Geraet
// und das zweite nicht.
// Enumeration trace: "usb: t <step> <value>" on the serial line, one line per step.
// Steps: 1 scan power on, 2 power done (ports with PP), 3 port connected (port),
// 4 port reset ok (speed), 5 port reset failed (portsc), 6 slot enabled (slot),
// 7 slot enable failed, 8 address ok, 9 address failed (cc), 10 descriptor ok,
// 11 descriptor failed, 12 configure ok, 13 configure failed, 14 second pass.
fn tr(state: u64, step: u64, v: u64) {
    usbdiag.step(step, v)
    if !kstate.mode_on(state, kstate.M_USBTRACE) {
        return
    }
    var t_hd: [u8; 9] = "usb: t \0\0"
    serial.puts((&t_hd[0]) as u64)
    serial.dec(step)
    serial.put(32 as u8)
    serial.dec(v)
    serial.nl()
}

// Diagnostic line for one input device: "usb: t probe <dev> st=<ep state> deq=<ctrl ring pos> enq=<our pos> ps=<portsc>".
static mut probe_n: u64 = 0

fn probe(state: u64) {
    if probe_n >= 12 || !kstate.mode_on(state, kstate.M_USBTRACE) {
        return
    }
    probe_n = probe_n + 1
    var t_p: [u8; 14] = "usb: t probe \0"
    var t_s: [u8; 5] = " st=\0"
    var t_d: [u8; 6] = " deq=\0"
    var t_e: [u8; 6] = " seq=\0"
    var t_c: [u8; 5] = " ps=\0"
    var t_x: [u8; 6] = " sts=\0"
    if g(state, S_READY) == 0 {
        return
    }
    var d: u64 = 0
    while d < 2 {
        let slot: u64 = dg(state, d, D_SLOT)
        let dci: u64 = dg(state, d, D_INTDCI)
        if slot != 0 && dci != 0 {
            let i: u64 = xhci.ep_find(state, slot, dci)
            serial.puts((&t_p[0]) as u64)
            serial.dec(d)
            serial.puts((&t_s[0]) as u64)
            serial.dec(xhci.ep_state(state, slot, dci))
            serial.puts((&t_d[0]) as u64)
            let dq: u64 = xhci.ep_deq(state, slot, dci) & 0xFFFFFFFE
            let rg: u64 = xhci.ep_ring(state, i)
            if dq >= rg {
                serial.dec(dq - rg)
            } else {
                serial.dec(99999)
            }
            serial.puts((&t_e[0]) as u64)
            serial.dec(xhci.ep_seq(state, i))
            serial.puts((&t_c[0]) as u64)
            serial.dec(xhci.portsc(state, dg(state, d, D_PORT)))
            serial.puts((&t_x[0]) as u64)
            serial.dec(xhci.usbsts(state))
            serial.nl()
        }
        d = d + 1
    }
}

fn scan(state: u64) {
    // ============================================= RUNDE BLECH-HID
    //
    // WARUM HIER EIN SCHLOSS STEHT. Seit dieser Runde WARTET das
    // Aufzaehlen wirklich -- zweihundert Millisekunden, bis an den
    // Anschluessen Spannung steht. In dieser Zeit laeuft der Zeitgeber,
    // und der ruft viermal je Sekunde `unplug_check`. Der sieht
    // Anschluesse mit gesetztem Aenderungsbit, findet sie nicht in der
    // Bitkarte -- und zaehlt drei ANSTECKUNGEN IM BETRIEB fuer
    // Tastatur, Maus und Stick, die von Anfang an steckten.
    //
    // `tools/k17/run.sh` hat genau das gemeldet ("Anstecken im Betrieb
    // im Regellauf (darf nicht anschlagen): 3"), und die Zusage hat
    // recht: ein Zaehler, der ohne Stecker hochlaeuft, ist Rauschen.
    // Waehrend der Baum SELBST aufzaehlt, faehrt ihm der Zeitgeber
    // nicht dazwischen.
    s(state, S_BUSY, 1)
    let n: u64 = xhci.ports(state)
    // RUNDE BLECH-HID: einschalten UND warten, bis wirklich Spannung
    // ansteht. `power_all` gibt zurueck, an wie vielen Anschluessen PP
    // danach steht -- das ist die Zahl, an der eine Maus, die nicht
    // leuchtet, abzulesen ist.
    tr(state, 1, n)
    let _mit: u64 = xhci.power_all(state)
    tr(state, 2, _mit)
    usbdiag_snap_all(state, xhci.unit(state), usbdiag.SNAP_POWER)
    xhci.drain(state)
    var p: u64 = 1
    while p <= n {
        if xhci.port_link_pending(state, p) {
            let _up: bool = xhci.settle_usb3(state, p)
        }
        if xhci.port_connected(state, p) {
            tr(state, 3, p)
            mark(state, p)
            attach(state, p)
        }
        p = p + 1
    }
    // ZWEITER DURCHGANG -- UND NUR, WENN DER ERSTE NICHTS FAND.
    //
    // Ein Geraet mit langsamem Netzteil meldet sich spaeter, als der
    // Regler antwortet, und beim Start sammelt niemand nach. Also wird
    // noch einmal nachgesehen.
    //
    // ABER NUR ALS RUECKFALL, und das ist gemessen: der zweite Durchgang
    // wartet dreihundert Millisekunden, und in dieser Zeit laeuft der
    // Zeitgeber, der `unplug_check` ruft. Der sieht einen Anschluss mit
    // gesetztem Aenderungsbit, findet ihn nicht in der Bitkarte und
    // zaehlt ein ANSTECKEN IM BETRIEB. `tools/k17/run.sh` hat genau das
    // gemeldet ("Anstecken im Betrieb im Regellauf (darf nicht
    // anschlagen): 1") -- und die Zusage hat recht: in einem Lauf, in
    // dem niemand etwas ansteckt, darf der Zaehler nicht anschlagen.
    // Wurde beim ersten Mal etwas gefunden, ist die Wartezeit ohnehin
    // ueberfluessig; auf Justins Brett, wo nichts gefunden wurde, ist
    // sie der ganze Zweck.
    var late: bool = false
    p = 1
    while p <= n {
        if xhci.port_link_pending(state, p) {
            late = true
        }
        p = p + 1
    }
    if g(state, S_NDEV) == 0 || late {
        tr(state, 14, 0)
        xhci.udelay(state, 300000)
        xhci.drain(state)
        p = 1
        while p <= n {
            if xhci.port_link_pending(state, p) {
                let _up2: bool = xhci.settle_usb3(state, p)
            }
            if xhci.port_connected(state, p) && !was_there(state, p) {
                tr(state, 3, p)
                mark(state, p)
                attach(state, p)
            }
            p = p + 1
        }
    }
    // Und jetzt darf der Zeitgeber wieder. Die Aenderungsbits der
    // eigenen Aufzaehlung sind quittiert (`port_reset` ->
    // `port_clear_changes`); was von hier an anschlaegt, hat wirklich
    // jemand gesteckt.
    s(state, S_BUSY, 0)
    if kstate.mode_on(state, kstate.M_USBSTALL) {
        stall_test(state)
    }
}

// Word `usbstall`: send one control request the device must STALL (unknown standard request 0x7E), report whether endpoint 0 is
// left Halted, then send a valid request (SET_IDLE). A driver without the Halted recovery times out on the second one.
// Line: `usb: stalltest r1=<100+rc> halted=<0|1> r2=<100+rc>` -- good = r1 below 100, halted=0, r2 >= 100.
fn stall_test(state: u64) {
    var t_a: [u8; 19] = "usb: stalltest r1=\0"
    var t_b: [u8; 9] = " halted=\0"
    var t_c: [u8; 5] = " r2=\0"
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_SLOT) != 0 {
            let slot: u64 = dg(state, d, D_SLOT)
            let r1: i64 = xhci.control(state, slot, 0x00, 0x7E, 0, 0, 0, 0, false)
            var h: u64 = 0
            if xhci.ep_halted(state, slot, 1) {
                h = 1
            }
            let r2: i64 = xhci.control(state, slot, 0x21, 0x0A, 0, dg(state, d, D_IFACE), 0, 0, false)
            serial.puts((&t_a[0]) as u64)
            serial.dec((r1 + 100) as u64)
            serial.puts((&t_b[0]) as u64)
            serial.dec(h)
            serial.puts((&t_c[0]) as u64)
            serial.dec((r2 + 100) as u64)
            serial.nl()
            return
        }
        d = d + 1
    }
}

fn mark(state: u64, p: u64) {
    s(state, S_ATTACHED, g(state, S_ATTACHED) | (1 << (p & 63)))
}

fn unmark(state: u64, p: u64) {
    s(state, S_ATTACHED, g(state, S_ATTACHED) & (~(1 << (p & 63))))
}

fn was_there(state: u64, p: u64) -> bool {
    return (g(state, S_ATTACHED) & (1 << (p & 63))) != 0
}

fn alloc_dev(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_DEV {
        if dg(state, i, D_USED) == 0 {
            zero(dev_at(state, i), DEV_BYTES)
            ds(state, i, D_USED, 1)
            return i
        }
        i = i + 1
    }
    s(state, S_NOPLATZ, g(state, S_NOPLATZ) + 1)
    return MAX_DEV
}

fn mps0_of(speed: u64) -> u64 {
    if speed == 3 {
        return 64 // hohe Geschwindigkeit
    }
    if speed >= 4 {
        return 512 // Super und darueber
    }
    return 8 // voll und langsam
}

// ------------------------------------------------- ein Geraet aufnehmen

fn attach(state: u64, port: u64) -> bool {
    return attach_at(state, port, 0, MAX_DEV, 0, false, 0)
}

// ================================================ RUNDE BLECHEINGABE
// EIN GERAET AUFNEHMEN -- AM WURZELANSCHLUSS ODER HINTER EINEM HUB.
//
// `rootport` ist IMMER der Anschluss am Regler; `route` ist der
// Wegweiser (xHCI 1.2, 4.5.2: fuenf Nibbles, eines je Etage), `hubdev`
// der Hub davor (MAX_DEV = keiner), `hubport` sein Anschluss. Steht
// `mitspeed`, kommt die Geschwindigkeit aus dem Anschlusszustand des
// Hubs -- ein Hub hat kein PORTSC.
//
// UND JEDES GERAET WIRD NOTIERT, AUCH WENN ES SCHEITERT. Bis zu dieser
// Runde loeschte `drop_dev` jede Spur, sobald `configure` fehlschlug --
// und `configure` schlaegt fehl, sobald keine Schnittstelle passt. Ein
// Hub, eine unbekannte Tastatur, ein Kartenleser: alle unsichtbar, und
// auf dem Schirm stand "devices=0". Das war der Grund, warum drei
// Runden lang niemand sagen konnte, WAS an Justins Brett haengt.
// RUNDE PROTOKOLL: die Quelle dieses Treibers im Ring. Siehe `nvme.lq`.
// Der Name liegt als `static mut` im Modul und nicht als `var` in
// dieser Funktion: eine lokale Zeichenkette stirbt mit dem Rahmen,
// und firnc faengt genau das ab ("the address of the local escapes
// through the return value"). Der Protokollring liest den Namen
// erst im Aufruf danach.
static mut q_usb: [u8; 4] = "usb\0"

fn lq() -> u64 {
    return (&q_usb[0]) as u64
}

fn slot_owned(state: u64, slot: u64) -> bool {
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_SLOT) == slot {
            return true
        }
        d = d + 1
    }
    return false
}

fn net_reclaim(state: u64) {
    let owner: u64 = usbnet.owner_slot(state)
    if owner != 0 && !slot_owned(state, owner) {
        usbnet.unplug_slot(state, owner)
    }
}

fn attach_at(state: u64, rootport: u64, route: u64, hubdev: u64,
    hubport: u64, mitspeed: bool, vorspeed: u64) -> bool {
    var l_rst: [u8; 42] = "Anschluss lässt sich nicht zurücksetzen\0"
    var l_neu: [u8; 32] = "Geraet am Anschluss, port/speed\0"

    var s_dev: [u8; 11] = "usb: port=\0"
    var s_sp: [u8; 8] = " speed=\0"
    var s_id: [u8; 5] = " id=\0"
    var s_cls: [u8; 8] = " class=\0"
    var s_drv: [u8; 9] = " driver=\0"
    var s_slot: [u8; 7] = " slot=\0"
    var s_rt: [u8; 8] = " route=\0"

    net_reclaim(state)
    usbdiag.set_cur(usbdiag.cur_hc(), rootport)
    var speed: u64 = vorspeed
    if !mitspeed {
        if !xhci.port_reset(state, rootport) {
            tr(state, 5, xhci.portsc(state, rootport))
            klog.sayn(state, klog.L_INFO, lq(), (&l_rst[0]) as u64,
                rootport)
            s(state, S_FAILS, g(state, S_FAILS) + 1)
            return false
        }
        speed = xhci.port_speed(state, rootport)
        tr(state, 4, speed)
    }
    let slot: u64 = xhci.slot_enable(state)
    if slot == 0 {
        tr(state, 7, xhci.last_rc_get())
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return false
    }
    let d: u64 = alloc_dev(state)
    if d >= MAX_DEV {
        xhci.slot_disable(state, slot)
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return false
    }
    ds(state, d, D_SLOT, slot)
    ds(state, d, D_PORT, rootport)
    ds(state, d, D_SPEED, speed)
    ds(state, d, D_MPS0, mps0_of(speed))
    ds(state, d, D_ROUTE, route)
    ds(state, d, D_HUBPORT, hubport)
    if hubdev < MAX_DEV {
        ds(state, d, D_PARENT, dg(state, hubdev, D_SLOT))
        // DER UEBERSETZER. Ein langsames oder volles Geraet hinter einem
        // schnellen Hub spricht nicht die Sprache des Busses; der Hub
        // uebersetzt (Transaction Translator), und der Regler muss
        // wissen, WELCHER. Ohne diese zwei Zahlen antwortet eine
        // Tastatur an einem USB-2-Hub nie -- xHCI 1.2, 4.5.2.
        if speed < 3 && dg(state, hubdev, D_SPEED) == 3 {
            ds(state, d, D_TTSLOT, dg(state, hubdev, D_SLOT))
            ds(state, d, D_TTPORT, hubport)
        } else {
            ds(state, d, D_TTSLOT, dg(state, hubdev, D_TTSLOT))
            ds(state, d, D_TTPORT, dg(state, hubdev, D_TTPORT))
        }
    }
    // Der Platz in der Fundliste, JETZT -- damit auch ein Geraet, das
    // gleich an `address` scheitert, auf dem Schirm steht.
    let f: u64 = found_new(state, rootport, hubport, speed)
    ds(state, d, D_FUND, f + 1)
    tr(state, 6, slot)

    if !address(state, d) {
        tr(state, 9, xhci.last_rc_get())
        drop_dev(state, d)
        return false
    }
    tr(state, 8, slot)
    fund_flag(state, f, F_ADDR)
    if !describe(state, d) {
        tr(state, 11, xhci.last_ctl_get())
        drop_dev(state, d)
        return false
    }
    tr(state, 10, slot)
    fund_flag(state, f, F_DESC)
    fund_id(state, f, dg(state, d, D_VID), dg(state, d, D_PID))
    let cfg_ok: bool = configure(state, d)
    chdiag.set_active(state, false)
    if !cfg_ok {
        tr(state, 13, xhci.last_ctl_get())
        drop_dev(state, d)
        return false
    }
    tr(state, 12, slot)
    fund_flag(state, f, F_CFG)
    s(state, S_ENUMS, g(state, S_ENUMS) + 1)
    s(state, S_NDEV, g(state, S_NDEV) + 1)

    // ==================================================== RUNDE HIDWEG
    //
    // ERST BINDEN, DANN BERICHTEN -- UND DIE ZEILE AM STUECK.
    //
    // Bis hierher stand die Zeile VOR `bind`, und damit stand darin,
    // was `driver_for` aus der Klasse GERATEN hatte, nicht, was der
    // Baum daraus gemacht hat. Auf Justins Brett las sich das als
    //   `usb: port=10 ... id=0951:16df class=03:00:00 driver=none`,
    // und "none" war schlicht falsch: das Geraet war ueber seine
    // BERICHTSBESCHREIBUNG angenommen worden (`hidrep: dev=1 ok=1
    // felder=15`) und lief ueber den generischen Weg. `drv_name`
    // kannte DRV_HIDGEN nur nicht.
    //
    // `bind` druckt SELBST (die Zerlegerzeile, die Blockzahl des
    // Sticks). Deshalb steht der ganze Bericht dahinter und nicht
    // halb davor -- sonst schiebt sich eine fremde Zeile mitten in
    // diese hinein, und auf einem Foto ist das nicht zu entwirren.
    bind(state, d)
    let ff: u64 = dg(state, d, D_FUND)
    if ff != 0 {
        fund_driver_set(state, ff - 1, dg(state, d, D_DRIVER))
        if dg(state, d, D_DRIVER) != DRV_NONE {
            fund_flag(state, ff - 1, F_BOUND)
        }
    }
    serial.puts((&s_dev[0]) as u64)
    serial.dec(rootport)
    serial.puts((&s_rt[0]) as u64)
    serial.dec(route)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(speed)
    serial.puts((&s_slot[0]) as u64)
    serial.dec(slot)
    serial.puts((&s_id[0]) as u64)
    hex4(dg(state, d, D_VID))
    serial.put(58 as u8)
    hex4(dg(state, d, D_PID))
    serial.puts((&s_cls[0]) as u64)
    hex2(dg(state, d, D_CLASS))
    serial.put(58 as u8)
    hex2(dg(state, d, D_SUB))
    serial.put(58 as u8)
    hex2(dg(state, d, D_PROTO))
    serial.puts((&s_drv[0]) as u64)
    drv_name(dg(state, d, D_DRIVER))
    serial.nl()
    wlan_melden(dg(state, d, D_VID), dg(state, d, D_PID))
    return true
}

// RUNDE WLAN-2: DIE ZEILE, DIE JUSTIN FOTOGRAFIEREN SOLL.
//
// In seinem Rechner steckt ein USB-WLAN-Stick, dessen Chip niemand
// kennt -- und ohne diese Auskunft ist jeder Treiber geraten, weil die
// USB-WLAN-Welt sechs Familien hat, die untereinander nichts gemeinsam
// haben. Ein Stick, der bisher als
//
//     usb: ... id=0bda:8812 cls=ff:ff:ff drv=none
//
// durchlief, war nicht von einem beliebigen anderen Geraet zu
// unterscheiden. Ab jetzt sagt die Maschine, WAS sie nicht fahren
// kann:
//
//     wifi-usb: Realtek RTL8812AU (0bda:8812), kein Treiber
//
// Das ist derselbe Gedanke wie bei HWNET (RTL8168) und BLECH (I225):
// der Unterschied zwischen einem Rechner, der kaputt ist, und einem,
// der sagt, was ihm fehlt. Die Tabelle steht in lib/wlan/usbchip.fi
// und ist damit auch auf dem Wirt messbar.
//
// Hier wird NICHTS gebunden. Es gibt keinen Treiber, und diese Zeile
// behauptet auch keinen.
fn wlan_melden(vid: u64, pid: u64) {
    if !usbchip.ist_wlan_stick(vid, pid) {
        return
    }
    var s_w: [u8; 11] = "wifi-usb: \0"
    var s_k: [u8; 16] = "), kein Treiber\0"
    var name: [u8; 32] = [0; 32]
    usbchip.name_get(vid, pid, (&name[0]) as u64)
    serial.puts((&s_w[0]) as u64)
    serial.puts((&name[0]) as u64)
    serial.put(32 as u8)
    serial.put(40 as u8)
    hex4(vid)
    serial.put(58 as u8)
    hex4(pid)
    serial.puts((&s_k[0]) as u64)
    serial.nl()
}

// RUNDE HIDPUNKTE: WAS EIN REGLER WERT IST.
//
// Nicht "hat er irgendein HID", sondern WIE GUT. Eine Tastatur mit
// Boot-Protokoll ist das, woran ein Mensch tippt; ein Geraet, das nur
// ueber seine Berichtsbeschreibung als Zeigegeraet durchgeht (ein
// Touchpad, QEMUs `usb-tablet`, Justins Kingston), ist ein schwacher
// Hinweis. Wer beide gleich zaehlt, waehlt den falschen Regler --
// genau das ist auf Justins Brett passiert.
//
// Der Massenspeicher zaehlt ABSICHTLICH null: Kern und Wurzelabbild
// sind zu diesem Zeitpunkt laengst geladen (Multiboot-Module), der
// Stick wird nicht mehr gebraucht, und ein Regler ohne Eingabe ist ein
// Regler ohne Nutzen fuer einen Menschen vor dem Schirm.
fn punkte(state: u64) -> u64 {
    var p: u64 = 0
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 {
            let k: u64 = dg(state, d, D_DRIVER)
            // Was ein Geraet IST, steht in seiner Schnittstelle, nicht
            // darin, auf welchem Weg der Kern es gerade liest. Mit
            // `hidgen` laeuft AUCH eine Boot-Tastatur ueber den
            // generischen Zerleger; wer nach `D_GENERIC` unterscheidet,
            // zaehlt sie dann wie ein Touchpad. Also nach Unterklasse 1
            // und Protokoll 1/2 -- das ist die Boot-Schnittstelle, und
            // die hat kein Lautstaerkeregler und kein Kartenleser.
            let boot: bool = dg(state, d, D_SUB) == 1
                && (dg(state, d, D_PROTO) == 1 || dg(state, d, D_PROTO) == 2)
            if k == DRV_KBD || k == DRV_MOUSE {
                if boot {
                    p = p + 8
                } else {
                    p = p + 3
                }
            } else if k == DRV_HIDGEN {
                p = p + 1
            } else if k == DRV_CH336 || k == DRV_ECM || k == DRV_NCM || k == DRV_RNDIS || k == DRV_AX88772
                || k == DRV_AX88179 || k == DRV_RTL8153 {
                p = p + 2
            }
        }
        d = d + 1
    }
    return p
}

fn pkt_get(state: u64, u: u64) -> u64 {
    if u >= MAX_HC_PKT {
        return 0
    }
    return g(state, S_PKT + u * 8)
}

fn pkt_set(state: u64, u: u64, v: u64) {
    if u < MAX_HC_PKT {
        s(state, S_PKT + u * 8, v)
    }
}

fn choice(state: u64) -> u64 {
    return g(state, S_WAHL)
}

fn hex2(v: u64) {
    var i: u64 = 2
    while i > 0 {
        i = i - 1
        let x: u64 = (v >> (i * 4)) & 15
        if x < 10 {
            serial.put((48 + x) as u8)
        } else {
            serial.put((87 + x) as u8)
        }
    }
}

fn hex4(v: u64) {
    hex2(v >> 8)
    hex2(v & 0xFF)
}

fn drv_name(k: u64) {
    var s_k: [u8; 4] = "kbd\0"
    var s_m: [u8; 6] = "mouse\0"
    var s_s: [u8; 4] = "msc\0"
    var s_n: [u8; 5] = "none\0"
    var s_g: [u8; 7] = "hidgen\0"
    var s_h: [u8; 4] = "hub\0"
    var s_e: [u8; 4] = "ecm\0"
    var s_r: [u8; 6] = "rndis\0"
    var s_i: [u8; 5] = "isoc\0"
    var s_c: [u8; 4] = "ncm\0"
    var s_w: [u8; 6] = "ch336\0"
    var s_ax: [u8; 8] = "ax88772\0"
    var s_a9: [u8; 8] = "ax88179\0"
    var s_rt: [u8; 8] = "rtl8153\0"
    if k == DRV_AX88179 {
        serial.puts((&s_a9[0]) as u64)
        return
    }
    if k == DRV_RTL8153 {
        serial.puts((&s_rt[0]) as u64)
        return
    }
    if k == DRV_CH336 {
        serial.puts((&s_w[0]) as u64)
        return
    }
    if k == DRV_AX88772 {
        serial.puts((&s_ax[0]) as u64)
        return
    }
    if k == DRV_ISOTEST {
        serial.puts((&s_i[0]) as u64)
        return
    }
    if k == DRV_NCM {
        serial.puts((&s_c[0]) as u64)
        return
    }
    if k == DRV_ECM {
        serial.puts((&s_e[0]) as u64)
        return
    }
    if k == DRV_RNDIS {
        serial.puts((&s_r[0]) as u64)
        return
    }
    if k == DRV_KBD {
        serial.puts((&s_k[0]) as u64)
    } else if k == DRV_MOUSE {
        serial.puts((&s_m[0]) as u64)
    } else if k == DRV_MSC {
        serial.puts((&s_s[0]) as u64)
    } else if k == DRV_HIDGEN {
        serial.puts((&s_g[0]) as u64)
    } else if k == DRV_HUB {
        serial.puts((&s_h[0]) as u64)
    } else {
        serial.puts((&s_n[0]) as u64)
    }
}

// Den Steckplatz mit einem Zusammenhang versehen und die Adresse
// vergeben. Der Eingabezusammenhang traegt zwei Bloecke: den des
// Steckplatzes und den des Steuerungsendpunkts.
fn address(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let dc: u64 = xhci.devctx(state, slot)
    zero(dc, 1024)
    xhci.dcbaa_set(state, slot, dc)
    let ep0: u64 = xhci.ep_open(state, slot, 1)
    if ep0 >= xhci.MAX_EP {
        return false
    }
    build_slot(state, d, 1)
    build_ep0(state, d, ep0)
    let ic: u64 = xhci.in_control(state)
    wr32(ic, 0) // nichts fallen lassen
    wr32(ic + 4, 3) // Steckplatz und Endpunkt 0 aufnehmen
    if xhci.address_device(state, slot, false) != xhci.CC_SUCCESS {
        return false
    }
    return true
}

// ================================================ RUNDE BLECHEINGABE
// DER STECKPLATZZUSAMMENHANG, JETZT MIT WEGWEISER UND UEBERSETZER.
//
// Bis zu dieser Runde standen hier zwei Zahlen: Geschwindigkeit und
// Wurzelanschluss. Das reicht fuer ein Geraet, das DIREKT am Regler
// haengt, und fuer kein anderes. Ein Geraet hinter einem Hub braucht
//
//   * den WEGWEISER (Route String, xHCI 1.2, 4.5.2): fuenf Nibbles,
//     eines je Etage, das erste unten. Ohne ihn schickt der Regler die
//     Pakete an den Hub statt durch ihn hindurch.
//   * bei langsamer oder voller Geschwindigkeit hinter einem SCHNELLEN
//     Hub den UEBERSETZER (TT): Steckplatz und Anschluss des Hubs, der
//     uebersetzt. Ohne ihn antwortet eine Tastatur an einem USB-2-Hub
//     nie -- und genau so eine haengt an vielen heutigen Brettern.
//   * ist das Geraet SELBST ein Hub: die Hub-Fahne und die Zahl seiner
//     Anschluesse. Die setzt `hub_slot_update` nach, sobald der
//     Hub-Deskriptor gelesen ist -- vorher weiss niemand davon.
fn build_slot(state: u64, d: u64, entries: u64) {
    let sc: u64 = xhci.in_slot(state)
    zero(sc, xhci.ctx_size(state))
    var dw0: u64 = (dg(state, d, D_ROUTE) & 0xFFFFF)
        | (dg(state, d, D_SPEED) << 20) | (entries << 27)
    if dg(state, d, D_DRIVER) == DRV_HUB {
        dw0 = dw0 | (1 << 26)
    }
    var dw1: u64 = (dg(state, d, D_PORT) & 0xFF) << 16
    if dg(state, d, D_DRIVER) == DRV_HUB {
        dw1 = dw1 | ((dg(state, d, D_PORTS) & 0xFF) << 24)
    }
    let dw2: u64 = (dg(state, d, D_TTSLOT) & 0xFF)
        | ((dg(state, d, D_TTPORT) & 0xFF) << 8)
    wr32(sc, dw0)
    wr32(sc + 4, dw1)
    wr32(sc + 8, dw2)
    wr32(sc + 12, 0)
}

fn build_ep0(state: u64, d: u64, i: u64) {
    let ec: u64 = xhci.in_ep(state, 1)
    zero(ec, xhci.ctx_size(state))
    wr32(ec, 0)
    // CErr = 3, Art 4 (Steuerung), Paketgroesse oben.
    wr32(ec + 4, (3 << 1) | (4 << 3) | (dg(state, d, D_MPS0) << 16))
    __mmio_write64((ec + 8) as *mut u64, xhci.ep_ring(state, i) | 1)
    wr32(ec + 16, 8)
}

// Die Deskriptoren. Erst acht Oktett -- nur so erfaehrt der Treiber die
// wirkliche Paketgroesse des Steuerungsendpunkts, und nur mit ihr
// stimmen alle weiteren Uebertragungen.
fn describe(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let buf: u64 = state + DESC_OFF
    zero(buf, 64)
    if xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
        (D_DEVICE << 8), 0, 8, buf, true) < 8 {
        return false
    }
    let mps: u64 = b8(buf, 7)
    if mps >= 8 && mps != dg(state, d, D_MPS0) {
        ds(state, d, D_MPS0, mps)
        let ep0: u64 = xhci.ep_find(state, slot, 1)
        if ep0 < xhci.MAX_EP {
            build_ep0(state, d, ep0)
            let ic: u64 = xhci.in_control(state)
            wr32(ic, 0)
            wr32(ic + 4, 2)
            xhci.evaluate_context(state, slot)
        }
    }
    zero(buf, 64)
    if xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
        (D_DEVICE << 8), 0, 18, buf, true) < 18 {
        return false
    }
    ds(state, d, D_VID, b16(buf, 8))
    ds(state, d, D_PID, b16(buf, 10))
    ds(state, d, D_NCFG, b8(buf, 17))
    if ch397.supported(b16(buf, 8), b16(buf, 10)) {
        chdiag.note_device(state, buf,
            dg(state, d, D_SLOT) | (dg(state, d, D_SPEED) << 8) | (dg(state, d, D_ROUTE) << 16)
            | (dg(state, d, D_PORT) << 40) | (dg(state, d, D_HUBPORT) << 48),
            (b16(buf, 8) << 16) | b16(buf, 10))
    }
    // RUNDE BLECHEINGABE: die Klasse des GERAETS (Oktett 4..6). Bei
    // einem Hub steht sie hier (09) und nicht erst in der
    // Schnittstelle; bei einem Verbundgeraet steht hier 0x00 und die
    // Wahrheit erst eine Etage tiefer. Beides gehoert auf den Schirm.
    let f: u64 = dg(state, d, D_FUND)
    if f != 0 {
        fund_dev_class(state, f - 1, b8(buf, 4), b8(buf, 5), b8(buf, 6))
    }
    return true
}

// Den Konfigurationsdeskriptor holen und die Schnittstelle waehlen, die
// dieser Kernel bedienen kann. Die Kette wird EINMAL durchgegangen; die
// erste Schnittstelle mit einer bekannten Klasse gewinnt, und alles, was
// danach an Endpunkten kommt, gehoert ihr -- bis die naechste
// Schnittstelle anfaengt.
// Walk the configurations of the device until one has an interface this kernel serves (a device with one
// configuration behaves as before). Returns the length of the last configuration read, 0 on a transfer error.
fn walk_configs(state: u64, d: u64, buf: u64) -> u64 {
    let slot: u64 = dg(state, d, D_SLOT)
    var ncfg: u64 = dg(state, d, D_NCFG)
    if ncfg < 1 {
        ncfg = 1
    }
    if ncfg > 4 {
        ncfg = 4
    }
    var total: u64 = 0
    var ci: u64 = 0
    while ci < ncfg {
        zero(buf, 512)
        if xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
            (D_CONFIGURATION << 8) | ci, 0, 9, buf, true) < 9 {
            return 0
        }
        total = b16(buf, 2)
        if total < 9 {
            return 0
        }
        if total > 512 {
            total = 512
        }
        ds(state, d, D_CONFIG, b8(buf, 5))
        ds(state, d, D_IFACES, b8(buf, 4))
        let f0: u64 = dg(state, d, D_FUND)
        if f0 != 0 {
            fs(state, f0 - 1, F_IFACES, b8(buf, 4))
        }
        zero(buf, 512)
        let got: i64 = xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
            (D_CONFIGURATION << 8) | ci, 0, total, buf, true)
        chdiag.note_config(state, ci, total, got as u64, buf)
        if got < (total as i64) {
            return 0
        }
        parse(state, d, buf, total)
        if dg(state, d, D_DRIVER) != DRV_NONE {
            ci = ncfg
        } else {
            ci = ci + 1
        }
    }
    return total
}

fn configure(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let buf: u64 = state + DESC_OFF
    // L-015: a device may offer several configurations (QEMU usb-net has RNDIS, CDC-ECM and Subset).
    // r811: first pass WITHOUT RNDIS (ECM is preferred); a second pass accepts RNDIS when nothing else matched.
    if ch397.supported(dg(state, d, D_VID), dg(state, d, D_PID)) {
        s(state, S_CHOK, 1)
    }
    let ax: bool = ax88772.supported(dg(state, d, D_VID), dg(state, d, D_PID))
    let vchip: u64 = usbvnic.chip_for(dg(state, d, D_VID), dg(state, d, D_PID))
    if ax || vchip != usbvnic.CHIP_NONE {
        s(state, S_AXOK, 1)
    }
    let noecm0: u64 = g(state, S_NOECM)
    let prefer_vendor: bool = ch397.supported(dg(state, d, D_VID), dg(state, d, D_PID)) || vchip != usbvnic.CHIP_NONE
    if prefer_vendor {
        s(state, S_NOECM, 1)
    }
    var total: u64 = walk_configs(state, d, buf)
    if prefer_vendor {
        s(state, S_NOECM, noecm0)
        if total != 0 && dg(state, d, D_DRIVER) == DRV_NONE {
            total = walk_configs(state, d, buf)
        }
    }
    s(state, S_CHOK, 0)
    s(state, S_AXOK, 0)
    if total == 0 {
        return false
    }
    if dg(state, d, D_DRIVER) == DRV_CH336 {
        ch_alt(state, d, buf, total)
        s(state, S_CHINT, dg(state, d, D_INTDCI) | (dg(state, d, D_INTMPS) << 8) | (dg(state, d, D_INTIVL) << 24))
        ds(state, d, D_INTDCI, 0)
        if ax {
            ds(state, d, D_DRIVER, DRV_AX88772)
        } else if vchip == usbvnic.CHIP_AX88179 {
            ds(state, d, D_DRIVER, DRV_AX88179)
        } else if vchip == usbvnic.CHIP_RTL8153 {
            ds(state, d, D_DRIVER, DRV_RTL8153)
        }
    }
    if dg(state, d, D_DRIVER) == DRV_NONE && g(state, S_RNDISOK) == 0 {
        s(state, S_RNDISOK, 1)
        total = walk_configs(state, d, buf)
        s(state, S_RNDISOK, 0)
        if total == 0 {
            return false
        }
    }
    if dg(state, d, D_DRIVER) == DRV_ECM {
        ecm_data(state, d, buf, total)
    }
    if dg(state, d, D_DRIVER) == DRV_RNDIS {
        rndis_data(state, d, buf, total)
    }
    if dg(state, d, D_DRIVER) == DRV_NCM {
        // NCM data interface = same layout as ECM: class 0A, bulk pipes in alternate setting >= 1.
        ecm_data(state, d, buf, total)
    }
    if dg(state, d, D_DRIVER) == DRV_ISOTEST {
        iso_data(state, d, buf, total)
    }
    // RUNDE BLECHEINGABE: die Klasse der GEWAEHLTEN Schnittstelle steht
    // auf dem Schirm -- und wenn keine gewaehlt wurde, die der ersten.
    // "Klasse 09 an Anschluss 7" ist die Auskunft, die Justin braucht.
    let f1: u64 = dg(state, d, D_FUND)
    if f1 != 0 {
        if dg(state, d, D_DRIVER) != DRV_NONE {
            fund_if_class(state, f1 - 1, dg(state, d, D_CLASS),
                dg(state, d, D_SUB), dg(state, d, D_PROTO))
        } else {
            first_iface(state, f1 - 1, buf, total)
        }
    }
    if dg(state, d, D_DRIVER) == DRV_NONE {
        return false
    }
    if !endpoints(state, d) {
        return false
    }
    let src: i64 = xhci.control(state, slot, 0, REQ_SET_CONFIGURATION,
        dg(state, d, D_CONFIG), 0, 0, 0, false)
    if dg(state, d, D_DRIVER) == DRV_CH336 {
        s(state, S_CHSET, g(state, S_CHSET) | 1)
        s(state, S_CHRC, src as u64)
    }
    if src < 0 {
        return false
    }
    return true
}

const CH_INT_OPEN: u64 = 0x100000000
const CH_INT_FAILED: u64 = 0x200000000

fn ch_int_info(state: u64) -> u64 {
    let v: u64 = g(state, S_CHINT)
    if (v & CH_INT_OPEN) == 0 {
        return 0
    }
    return v & 0xFFFFFFFF
}

fn ch_int_wanted(state: u64, d: u64) -> bool {
    if dg(state, d, D_DRIVER) != DRV_CH336 || kstate.mode_on(state, kstate.M_NOCHINTR) {
        return false
    }
    let v: u64 = g(state, S_CHINT)
    if (v & CH_INT_FAILED) != 0 {
        return false
    }
    return (v & 255) != 0 && ((v >> 8) & 0xFFFF) != 0
}

const CH_ALT_SCAN: u64 = 0x10000
const CH_SETIF_SENT: u64 = 0x20000
const CH_SETIF_FAIL: u64 = 0x40000
const ALT_ANY_VENDOR: u64 = 0x100

fn alt_group_ok(mask: u64, cls: u64, iface: u64, want: u64) -> bool {
    if mask != 3 {
        return false
    }
    if want == ALT_ANY_VENDOR {
        return cls == 0xFF
    }
    return iface == want
}

fn alt_find(buf: u64, total: u64, want: u64) -> u64 {
    var at: u64 = 0
    var mask: u64 = 0
    var iface: u64 = 0
    var alt: u64 = 0
    var cls: u64 = 0
    var have: bool = false
    var found: u64 = 0
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        if len < 2 || at + len > total {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                if have && found == 0 && alt_group_ok(mask, cls, iface, want) {
                    found = iface | (alt << 8) | CH_ALT_SCAN
                }
                have = true
                mask = 0
                iface = b8(buf, at + 2)
                alt = b8(buf, at + 3)
                cls = b8(buf, at + 5)
            } else if kind == 5 && len >= 7 && have {
                if (b8(buf, at + 3) & 3) == 2 {
                    if (b8(buf, at + 2) & 0x80) != 0 {
                        mask = mask | 1
                    } else {
                        mask = mask | 2
                    }
                }
            }
            at = at + len
        }
    }
    if have && found == 0 && alt_group_ok(mask, cls, iface, want) {
        found = iface | (alt << 8) | CH_ALT_SCAN
    }
    return found
}

fn alt_take(state: u64, d: u64, buf: u64, total: u64, iface: u64, alt: u64) {
    ds(state, d, D_INTDCI, 0)
    ds(state, d, D_INDCI, 0)
    ds(state, d, D_OUTDCI, 0)
    var at: u64 = 0
    var mine: bool = false
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        if len < 2 || at + len > total {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                mine = b8(buf, at + 2) == iface && b8(buf, at + 3) == alt
            } else if kind == 5 && len >= 7 && mine {
                take_ep(state, d, buf, at)
            }
            at = at + len
        }
    }
}

fn ch_alt(state: u64, d: u64, buf: u64, total: u64) {
    s(state, S_CHSET, 0)
    ds(state, d, D_DATAALT, 0)
    if kstate.mode_on(state, kstate.M_NOCHALT) {
        return
    }
    if dg(state, d, D_INDCI) != 0 && dg(state, d, D_OUTDCI) != 0 {
        return
    }
    var found: u64 = alt_find(buf, total, dg(state, d, D_IFACE))
    if found == 0 {
        found = alt_find(buf, total, ALT_ANY_VENDOR)
    }
    if found == 0 {
        return
    }
    let iface: u64 = found & 0xFF
    let alt: u64 = (found >> 8) & 0xFF
    alt_take(state, d, buf, total, iface, alt)
    ds(state, d, D_IFACE, iface)
    ds(state, d, D_DATAALT, alt)
    s(state, S_CHSET, CH_ALT_SCAN | (alt << 8))
}

fn ch_set_interface(state: u64, d: u64, slot: u64) {
    if kstate.mode_on(state, kstate.M_NOSETIF) {
        return
    }
    let rc: i64 = xhci.control(state, slot, 0x01, 0x0B, dg(state, d, D_DATAALT),
        dg(state, d, D_IFACE), 0, 0, false)
    var v: u64 = g(state, S_CHSET) | CH_SETIF_SENT
    if rc < 0 {
        v = v | CH_SETIF_FAIL | (((0 - rc) as u64 & 0xFF) << 24)
    }
    s(state, S_CHSET, v)
    xhci.udelay(state, 10000)
}

const CK_PRESENT: u64 = 0
const CK_VID: u64 = 1
const CK_PID: u64 = 2
const CK_SPEED: u64 = 3
const CK_ROUTE: u64 = 4
const CK_NCFG: u64 = 5
const CK_CFG: u64 = 6
const CK_RC: u64 = 7
const CK_CLASS: u64 = 8
const CK_SUB: u64 = 9
const CK_PROTO: u64 = 10
const CK_IFACE: u64 = 11
const CK_INDCI: u64 = 12
const CK_OUTDCI: u64 = 13
const CK_INT: u64 = 14
const CK_BULKMPS: u64 = 15
const CK_STEP: u64 = 16
const CK_RESULT: u64 = 17
const CK_SET: u64 = 18
const CK_ALT: u64 = 19
const CK_ALTSCAN: u64 = 20
const CK_SETIF: u64 = 21
const CK_LIVE: u64 = 22

fn ch_diag(state: u64, key: u64) -> u64 {
    let dv: u64 = g(state, S_CHDEV)
    if key == CK_PRESENT { return dv }
    if dv == 0 { return 0 }
    let d: u64 = dv - 1
    if key == CK_VID { return dg(state, d, D_VID) }
    if key == CK_PID { return dg(state, d, D_PID) }
    if key == CK_SPEED { return dg(state, d, D_SPEED) }
    if key == CK_ROUTE { return dg(state, d, D_ROUTE) }
    if key == CK_NCFG { return dg(state, d, D_NCFG) }
    if key == CK_CFG { return dg(state, d, D_CONFIG) }
    if key == CK_RC { return g(state, S_CHRC) }
    if key == CK_CLASS { return dg(state, d, D_CLASS) }
    if key == CK_SUB { return dg(state, d, D_SUB) }
    if key == CK_PROTO { return dg(state, d, D_PROTO) }
    if key == CK_IFACE { return dg(state, d, D_IFACE) }
    if key == CK_INDCI { return dg(state, d, D_INDCI) }
    if key == CK_OUTDCI { return dg(state, d, D_OUTDCI) }
    if key == CK_INT { return g(state, S_CHINT) }
    if key == CK_BULKMPS { return dg(state, d, D_BULKMPS) }
    if key == CK_STEP { return g(state, S_CHSTEP) & 255 }
    if key == CK_RESULT { return (g(state, S_CHSTEP) >> 8) & 255 }
    if key == CK_SET { return g(state, S_CHSET) & 1 }
    if key == CK_ALT { return dg(state, d, D_DATAALT) }
    if key == CK_ALTSCAN { return (g(state, S_CHSET) >> 16) & 1 }
    if key == CK_LIVE {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_VID) != 0 { return 1 }
        return 2
    }
    if key == CK_SETIF {
        let v: u64 = g(state, S_CHSET)
        if (v & CH_SETIF_SENT) == 0 { return 0 }
        if (v & CH_SETIF_FAIL) == 0 { return 1 }
        return 2 + ((v >> 24) & 0xFF)
    }
    return 0
}

// ======================================================= RUNDE HIDWEG
//
// WELCHE SCHNITTSTELLE EINES GERAETS GENOMMEN WIRD.
//
// Ein Geraet hat oft mehrere. Eine Spieletastatur bringt regelmaessig
// drei mit: eine ohne Boot-Protokoll mit allen Tasten gleichzeitig
// (03:00:00), eine Boot-Tastatur (03:01:01) und eine
// Verbrauchersteuerung fuer die Medientasten (auch 03:00:00). Welche
// davon zuerst im Konfigurationsdeskriptor steht, entscheidet der
// Hersteller und niemand sonst.
//
// Bis zu dieser Runde nahm `parse` die ERSTE, die durch `wanted` kam --
// also die erste in der Reihenfolge des Herstellers. Auf Justins Brett
// war das bei 0951:16df eine mit `top=0xc0001`, einer
// VERBRAUCHERSTEUERUNG: die Beschreibung wurde sauber zerlegt
// (`felder=15`), das Geraet lief -- und meldete Lautstaerketasten statt
// Buchstaben.
//
// Jetzt wird ZWEIMAL gelesen. Der erste Durchgang sucht den besten
// Rang, der zweite nimmt die erste Schnittstelle mit genau diesem Rang.
// Damit gewinnt eine Boot-Tastatur gegen eine Verbrauchersteuerung
// DESSELBEN Geraets, egal in welcher Reihenfolge sie dastehen.
//
// Der Rang ist ausdruecklich eine Rangfolge und keine Wertung: eine
// Schnittstelle ohne Boot-Protokoll bleibt annehmbar (Rang 1) -- das
// Praezisions-Touchpad eines Laptops hat gar nichts anderes.
fn iface_rang(state: u64, cls: u64, sub: u64, pro: u64) -> u64 {
    if !wanted(state, cls, sub, pro) {
        return 0
    }
    // Ein HUB steht ueber allem: hinter ihm koennen Tastatur und Maus
    // erst hervorkommen. Wer ihn nicht nimmt, sieht die Haelfte der
    // Buchsen eines heutigen Bretts nicht.
    if cls == CLS_HUB {
        return 5
    }
    if cls == CLS_HID && sub == 1 && pro == 1 {
        return 4
    }
    if cls == CLS_HID && sub == 1 && pro == 2 {
        return 3
    }
    if cls == CLS_MSC {
        return 2
    }
    return 1
}

fn best_rang(state: u64, buf: u64, total: u64) -> u64 {
    var at: u64 = 0
    var best: u64 = 0
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        // TOCTOU audit F-05: a descriptor must lie inside the buffer (bLength is chosen by the device)
        if len < 2 || at + len > total {
            at = total
        } else {
            if b8(buf, at + 1) == 4 && len >= 9 && b8(buf, at + 3) == 0 {
                let r: u64 = iface_rang(state, b8(buf, at + 5),
                    b8(buf, at + 6), b8(buf, at + 7))
                if r > best {
                    best = r
                }
            }
            at = at + len
        }
    }
    return best
}

// ================================ DER SELBSTTEST ZUR RANGFOLGE
//
// Ein zusammengesetztes Geraet gibt es in QEMU nicht: `-device usb-kbd`
// hat GENAU EINE Schnittstelle. Die Rangfolge liesse sich damit
// ueberhaupt nicht messen -- und eine Aenderung an der Auswahl, die
// niemand misst, ist eine Behauptung.
//
// Also wird der Konfigurationsdeskriptor HIER GEBAUT, Oktett fuer
// Oktett, genau so, wie eine Spieletastatur ihn liefert: zuerst eine
// Schnittstelle OHNE Boot-Protokoll (03:00:00), danach die
// Boot-Tastatur (03:01:01). Der alte Weg nahm die erste. Der neue muss
// die zweite nehmen -- mit ihrer Schnittstellennummer, ihrer
// Beschreibungslaenge (63 statt 52) und ihrem Endpunkt (0x82 -> DCI 5).
//
// Gibt zurueck, wie viele der sechs Zusagen halten.
fn rangtest(state: u64) -> u64 {
    let buf: u64 = state + DESC_OFF
    zero(buf, 64)
    var i: u64 = 0
    var q: [u8; 59] = [
        9 as u8, 2 as u8, 59 as u8, 0 as u8, 2 as u8, 1 as u8, 0 as u8,
        0x80 as u8, 50 as u8,
        // Schnittstelle 0: HID, kein Boot-Protokoll
        9 as u8, 4 as u8, 0 as u8, 0 as u8, 1 as u8, 3 as u8, 0 as u8,
        0 as u8, 0 as u8,
        9 as u8, 0x21 as u8, 0x11 as u8, 1 as u8, 0 as u8, 1 as u8,
        0x22 as u8, 52 as u8, 0 as u8,
        7 as u8, 5 as u8, 0x81 as u8, 3 as u8, 8 as u8, 0 as u8, 10 as u8,
        // Schnittstelle 1: die Boot-Tastatur
        9 as u8, 4 as u8, 1 as u8, 0 as u8, 1 as u8, 3 as u8, 1 as u8,
        1 as u8, 0 as u8,
        9 as u8, 0x21 as u8, 0x11 as u8, 1 as u8, 0 as u8, 1 as u8,
        0x22 as u8, 63 as u8, 0 as u8,
        7 as u8, 5 as u8, 0x82 as u8, 3 as u8, 8 as u8, 0 as u8, 10 as u8
    ]
    while i < 59 {
        __mmio_write8((buf + i) as *mut u8, q[i as usize])
        i = i + 1
    }
    var n: u64 = 0
    if best_rang(state, buf, 59) == 4 {
        n = n + 1
    }
    if iface_rang(state, CLS_HID, 1, 2) == 3 {
        n = n + 1
    }
    if iface_rang(state, CLS_MSC, 6, 0x50) == 2 {
        n = n + 1
    }
    zero(state + UDEV_OFF, DEV_BYTES)
    parse(state, 0, buf, 59)
    if dg(state, 0, D_IFACE) == 1 {
        n = n + 1
    }
    if dg(state, 0, D_RDLEN) == 63 && dg(state, 0, D_PROTO) == 1 {
        n = n + 1
    }
    if dg(state, 0, D_INTDCI) == 5 {
        n = n + 1
    }
    zero(state + UDEV_OFF, DEV_BYTES)
    return n
}

fn rangtest_max() -> u64 {
    return 6
}

fn parse(state: u64, d: u64, buf: u64, total: u64) {
    var at: u64 = 0
    var mine: bool = false
    var picked: bool = false
    let ziel: u64 = best_rang(state, buf, total)
    if ziel == 0 {
        return
    }
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        // TOCTOU audit F-05: a descriptor must lie inside the buffer (bLength is chosen by the device)
        if len < 2 || at + len > total {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                // Eine Schnittstelle. Alternative Einstellungen ausser 0
                // werden uebergangen -- die Vorgabe ist das, was ohne
                // `SET_INTERFACE` gilt.
                mine = false
                if !picked && b8(buf, at + 3) == 0 {
                    let cls: u64 = b8(buf, at + 5)
                    let sub: u64 = b8(buf, at + 6)
                    let pro: u64 = b8(buf, at + 7)
                    if iface_rang(state, cls, sub, pro) == ziel {
                        ds(state, d, D_CLASS, cls)
                        ds(state, d, D_SUB, sub)
                        ds(state, d, D_PROTO, pro)
                        ds(state, d, D_IFACE, b8(buf, at + 2))
                        ds(state, d, D_DRIVER, driver_for(cls, sub, pro))
                        mine = true
                        picked = true
                    }
                }
            } else if kind == 0x21 && len >= 9 && mine {
                // DER HID-DESKRIPTOR. Er steht zwischen der
                // Schnittstelle und ihren Endpunkten und sagt, WIE LANG
                // die Berichtsbeschreibung ist -- ohne diese Zahl laesst
                // sie sich nicht holen, denn ein Kontrolltransfer will
                // die Laenge vorher wissen. Ab Oktett 6 stehen Paare
                // (Art, Laenge); genommen wird das erste mit Art 0x22.
                var k: u64 = 0
                let nd: u64 = b8(buf, at + 5)
                while k < nd && 6 + k * 3 + 2 < len {
                    if b8(buf, at + 6 + k * 3) == 0x22 {
                        ds(state, d, D_RDLEN, b16(buf, at + 7 + k * 3))
                        k = nd
                    } else {
                        k = k + 1
                    }
                }
            } else if kind == 0x24 && len >= 4 && mine {
                // CDC functional descriptors of the ECM control interface:
                // 0x06 union (slave interface = data interface), 0x0F
                // ethernet networking (MAC address string index).
                let sub: u64 = b8(buf, at + 2)
                if sub == 6 && len >= 5 {
                    ds(state, d, D_DATAIF, b8(buf, at + 4))
                }
                if sub == 0x0F && len >= 13 {
                    ds(state, d, D_MACSTR, b8(buf, at + 3))
                }
            } else if kind == 5 && len >= 7 && mine {
                take_ep(state, d, buf, at)
            }
            at = at + len
        }
    }
}

// ECM: the bulk pipes live in an ALTERNATE setting (>= 1) of the data
// interface, which `parse` skips. Find it, take its endpoints, and forget the
// notification endpoint of the control interface (not used by the driver).
fn ecm_data(state: u64, d: u64, buf: u64, total: u64) {
    ds(state, d, D_INTDCI, 0)
    ds(state, d, D_INDCI, 0)
    ds(state, d, D_OUTDCI, 0)
    var at: u64 = 0
    var mine: bool = false
    let dif: u64 = dg(state, d, D_DATAIF)
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        if len < 2 || at + len > total {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                mine = b8(buf, at + 2) == dif && b8(buf, at + 3) != 0
                    && b8(buf, at + 5) == 0x0A && dg(state, d, D_INDCI) == 0
                if mine {
                    ds(state, d, D_DATAALT, b8(buf, at + 3))
                }
            } else if kind == 5 && len >= 7 && mine {
                take_ep(state, d, buf, at)
            }
            at = at + len
        }
    }
}

// Welche Schnittstellen dieser Kernel annimmt. Eine HID-Schnittstelle
// OHNE Boot-Protokoll (Unterklasse 1) wird ABGELEHNT und nicht falsch
// gelesen: ihr Berichtsformat steht in einer Berichtsbeschreibung, und
// die zerlegt diese Runde nicht.
fn wanted(state: u64, cls: u64, sub: u64, pro: u64) -> bool {
    if cls == CLS_HUB {
        return !kstate.mode_on(state, kstate.M_NOHUB)
    }
    if cls == CLS_HID {
        if g(state, S_NOHID) != 0 {
            return false
        }
        if sub == 1 && (pro == 1 || pro == 2) {
            return true
        }
        // RUNDE HID: eine Schnittstelle OHNE Boot-Protokoll. Bis zu
        // dieser Runde stand hier `return false` mit der Begruendung
        // "ihr Berichtsformat steht in einer Berichtsbeschreibung, und
        // die zerlegt diese Runde nicht". Jetzt zerlegt sie sie.
        // DAS IST DER FALL EINES LAPTOPS: ein Praezisions-Touchpad hat
        // kein Boot-Protokoll, und `-device usb-tablet` in QEMU auch
        // nicht.
        return g(state, S_GEN) != 0
    }
    if cls == CLS_MSC {
        if g(state, S_NOMSC) != 0 {
            return false
        }
        return sub == 6 && pro == 0x50
    }
    // r813: audio control interface (class 01, subclass 01), test bed only.
    if cls == 1 && sub == 1 {
        return g(state, S_ISOOK) != 0
    }
    if cls == CLS_CDC {
        if sub == 2 && pro == 0xFF {
            return g(state, S_RNDISOK) != 0
        }
        // r811: CDC-NCM (subclass 0D) is a last resort like RNDIS: only in pass 2.
        if sub == 0x0D {
            return g(state, S_RNDISOK) != 0
        }
        return sub == 6 && g(state, S_NOECM) == 0
    }
    // r811: RNDIS control interface of Android (E0/01/03) and of Windows-compatible gadgets (EF/04/01).
    if (cls == 0xE0 && sub == 1 && pro == 3) || (cls == 0xEF && sub == 4 && pro == 1) {
        return g(state, S_RNDISOK) != 0
    }
    if cls == 0xFF && g(state, S_AXOK) != 0 {
        return true
    }
    if cls == 0xFF && sub == 0xFF && pro == 0xFF {
        return g(state, S_CHOK) != 0
    }
    return false
}

fn driver_for(cls: u64, sub: u64, pro: u64) -> u64 {
    if cls == CLS_HUB {
        return DRV_HUB
    }
    if cls == CLS_HID && sub == 1 && pro == 1 {
        return DRV_KBD
    }
    if cls == CLS_HID && sub == 1 && pro == 2 {
        return DRV_MOUSE
    }
    if cls == CLS_HID {
        return DRV_HIDGEN
    }
    if cls == CLS_MSC {
        return DRV_MSC
    }
    if cls == 1 && sub == 1 {
        return DRV_ISOTEST
    }
    if cls == CLS_CDC && sub == 6 {
        return DRV_ECM
    }
    if cls == CLS_CDC && sub == 0x0D {
        return DRV_NCM
    }
    if (cls == CLS_CDC && sub == 2 && pro == 0xFF) || (cls == 0xE0 && sub == 1 && pro == 3)
        || (cls == 0xEF && sub == 4 && pro == 1) {
        return DRV_RNDIS
    }
    if cls == 0xFF {
        return DRV_CH336
    }
    return DRV_NONE
}

fn take_ep(state: u64, d: u64, buf: u64, at: u64) {
    let addr: u64 = b8(buf, at + 2)
    let attrs: u64 = b8(buf, at + 3) & 3
    let mps: u64 = b16(buf, at + 4) & 0x7FF
    let ivl: u64 = b8(buf, at + 6)
    let num: u64 = addr & 0xF
    var dci: u64 = num * 2
    if (addr & 0x80) != 0 {
        dci = dci + 1
    }
    if attrs == 3 && (addr & 0x80) != 0 && dg(state, d, D_INTDCI) == 0 {
        ds(state, d, D_INTDCI, dci)
        ds(state, d, D_INTMPS, mps)
        ds(state, d, D_INTIVL, ivl)
        // RUNDE HID: BIS ZU DIESER RUNDE STANDEN HIER ACHT.
        // Acht ist die Groesse eines Boot-Tastaturberichts, und
        // solange es nur die gab, war die Zahl richtig. Ein
        // Praezisions-Touchpad schickt 29 Oktett und `-device
        // usb-tablet` sechs bis acht; wer bei acht abschneidet,
        // bekommt von einem Touchpad die ersten anderthalb Finger
        // und sonst nichts. Die Grenze ist jetzt der Platz, den
        // `report_buf` je Geraet hat (64), und nicht eine Bauform.
        var want: u64 = mps
        if want > 64 {
            want = 64
        }
        ds(state, d, D_INTLEN, want)
        return
    }
    if attrs == 2 {
        // DIE PAKETGROSSE KOMMT AUS DEM DESKRIPTOR UND NICHT AUS DEM
        // KOPF DES TREIBERS. Ein Massenendpunkt hat bei voller
        // Geschwindigkeit 64, bei hoher 512 und bei Super 1024 Oktett --
        // und `qemu-xhci` haengt einen Stick an einen USB-3-Anschluss,
        // wenn einer frei ist. Eine geratene 512 waere dort schlicht
        // falsch.
        ds(state, d, D_BULKMPS, mps)
        if (addr & 0x80) != 0 {
            if dg(state, d, D_INDCI) == 0 {
                ds(state, d, D_INDCI, dci)
            }
        } else {
            if dg(state, d, D_OUTDCI) == 0 {
                ds(state, d, D_OUTDCI, dci)
            }
        }
    }
}

// Ein Endpunktzusammenhang. `art` ist die xHCI-Nummer: 2 Masse aus,
// 6 Masse ein, 7 Unterbrechung ein.
fn build_ep(state: u64, dci: u64, art: u64, mps: u64, ivl: u64, ring: u64,
    avg: u64) {
    let ec: u64 = xhci.in_ep(state, dci)
    zero(ec, xhci.ctx_size(state))
    wr32(ec, ivl << 16)
    wr32(ec + 4, (3 << 1) | (art << 3) | (mps << 16))
    __mmio_write64((ec + 8) as *mut u64, ring | 1)
    var esit: u64 = 0
    if art == 7 {
        esit = mps << 16
    }
    wr32(ec + 16, avg | esit)
}

// Das Zeitraster einer Unterbrechungsmeldung. Bei hoher Geschwindigkeit
// steht in `bInterval` schon ein Logarithmus, bei voller und langsamer
// stehen dort MILLISEKUNDEN -- und xHCI will in beiden Faellen einen
// Exponenten zur Basis 125 Mikrosekunden. Wer das verwechselt, bekommt
// eine Tastatur, die achtmal zu selten oder achtmal zu oft meldet.
fn interval_of(speed: u64, binterval: u64) -> u64 {
    if speed >= 3 {
        if binterval == 0 {
            return 0
        }
        var v: u64 = binterval - 1
        if v > 15 {
            v = 15
        }
        return v
    }
    var ms: u64 = binterval
    if ms == 0 {
        ms = 1
    }
    var n: u64 = 3
    while n < 10 && (1 << (n - 3)) < ms {
        n = n + 1
    }
    return n
}

fn endpoints(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    var top: u64 = 1
    var add: u64 = 1 // der Steckplatz selbst
    let ic: u64 = xhci.in_control(state)
    // Alle Endpunktbloecke des Eingabezusammenhangs leeren: was von
    // einem frueheren Geraet stehenbliebe, waere ein Endpunkt, den
    // niemand bestellt hat.
    zero(xhci.in_ep(state, 1), 31 * xhci.ctx_size(state))

    let idci: u64 = dg(state, d, D_INTDCI)
    if idci != 0 {
        let i: u64 = xhci.ep_open(state, slot, idci)
        if i >= xhci.MAX_EP {
            return false
        }
        build_ep(state, idci, 7, dg(state, d, D_INTMPS),
            interval_of(dg(state, d, D_SPEED), dg(state, d, D_INTIVL)),
            xhci.ep_ring(state, i), dg(state, d, D_INTMPS))
        add = add | (1 << idci)
        if idci > top {
            top = idci
        }
    }
    let indci: u64 = dg(state, d, D_INDCI)
    if indci != 0 {
        let i: u64 = xhci.ep_open(state, slot, indci)
        if i >= xhci.MAX_EP {
            return false
        }
        build_ep(state, indci, 6, dg(state, d, D_BULKMPS), 0,
            xhci.ep_ring(state, i), 512)
        add = add | (1 << indci)
        if indci > top {
            top = indci
        }
    }
    let outdci: u64 = dg(state, d, D_OUTDCI)
    if outdci != 0 {
        let i: u64 = xhci.ep_open(state, slot, outdci)
        if i >= xhci.MAX_EP {
            return false
        }
        build_ep(state, outdci, 2, dg(state, d, D_BULKMPS), 0,
            xhci.ep_ring(state, i), 512)
        add = add | (1 << outdci)
        if outdci > top {
            top = outdci
        }
    }
    // r813: the isochronous endpoint of the test driver.
    if dg(state, d, D_DRIVER) == DRV_ISOTEST && g(state, S_ISOA) != 0 {
        let a: u64 = g(state, S_ISOA)
        let adci: u64 = a & 0xFF
        let i: u64 = xhci.isoc_open(state, slot, adci, false, dg(state, d, D_SPEED),
            (a >> 32) & 0xFFFF, 0, 0, (a >> 24) & 0xFF)
        if i >= xhci.MAX_EP || !xhci.isoc_fill_ctx(state, slot, adci) {
            return false
        }
        add = add | (1 << adci)
        if adci > top {
            top = adci
        }
    }
    if ch_int_wanted(state, d) {
        let cv: u64 = g(state, S_CHINT)
        let cdci: u64 = cv & 255
        let ci: u64 = xhci.ep_open(state, slot, cdci)
        if ci < xhci.MAX_EP {
            let cmps: u64 = (cv >> 8) & 0xFFFF
            build_ep(state, cdci, 7, cmps, interval_of(dg(state, d, D_SPEED), (cv >> 24) & 255),
                xhci.ep_ring(state, ci), cmps)
            add = add | (1 << cdci)
            if cdci > top {
                top = cdci
            }
            s(state, S_CHINT, cv | CH_INT_OPEN)
        }
    }
    build_slot(state, d, top)
    wr32(ic, 0)
    wr32(ic + 4, add)
    let crc: u64 = xhci.configure_endpoint(state, slot)
    if crc != xhci.CC_SUCCESS && (g(state, S_CHINT) & CH_INT_OPEN) != 0 {
        s(state, S_CHINT, (g(state, S_CHINT) & 0xFFFFFFFF) | CH_INT_FAILED)
        return endpoints(state, d)
    }
    return crc == xhci.CC_SUCCESS
}

fn drop_dev(state: u64, d: u64) {
    let slot: u64 = dg(state, d, D_SLOT)
    if slot != 0 {
        xhci.forget_slot(state, slot)
        xhci.slot_disable(state, slot)
        xhci.dcbaa_set(state, slot, 0)
    }
    zero(dev_at(state, d), DEV_BYTES)
}

// ------------------------------------------------------- die Zuordnung

// ============================================== RUNDE ECHTHARDWARE-6
// TAUGT DER EINTRAG, DER SCHON DASTEHT?
//
// "Taugen" heisst hier genau zweierlei, und beides ist nachpruefbar:
// der Platz ist ueberhaupt belegt, UND das Geraet auf diesem Platz ist
// noch benutzt und hat einen Unterbrechungsendpunkt. Ein Geraet, das
// abgezogen wurde, wird in `port_gone` ohnehin auf 0 gesetzt; diese
// Pruefung faengt zusaetzlich den Fall ab, dass dort eine Leiche steht.
//
// Ohne diese Frage waere die Regel "der erste gewinnt" zu streng: eine
// Tastatur, die beim Aufsetzen scheitert, wuerde den Platz fuer immer
// blockieren, und keine spaeter eingesteckte kaeme mehr durch.
fn dev_taugt(state: u64, e: u64) -> bool {
    if e == 0 {
        return false
    }
    let d: u64 = e - 1
    if d >= MAX_DEV {
        return false
    }
    return dg(state, d, D_USED) != 0 && dg(state, d, D_INTDCI) != 0
}

fn kbd_taugt(state: u64) -> bool {
    return dev_taugt(state, g(state, S_KBD))
}

fn mouse_works(state: u64) -> bool {
    return dev_taugt(state, g(state, S_MOUSE))
}

fn bind(state: u64, d: u64) {
    let k: u64 = dg(state, d, D_DRIVER)
    if k == DRV_HIDGEN {
        hid_start(state, d)
        return
    }
    // ============================================ RUNDE ECHTHARDWARE-6
    // HIER STAND `s(state, S_KBD, d + 1)` OHNE JEDE BEDINGUNG -- UND
    // DAS IST DIE TOTE TASTATUR AUS JUSTINS TAFELZEILE 18.
    //
    // Sein Foto sagt woertlich
    //     18 KEYS  D 2 BER 0 ARM 1 CC 0 RK 00000000 N 0
    //     20 ENDP  KBD EP1 F0 H0
    // Das ist ein Widerspruch, solange man `D` fuer die Tastatur haelt:
    // der Endpunkt LAEUFT (EP1), hat KEINEN Fehler (F0) und musste nie
    // wiederbelebt werden (H0) -- trotzdem ist nie ein Bericht fertig
    // geworden. Ein angehaltener Endpunkt sieht anders aus (EP2/EP4),
    // ein Zerlegerfehler auch (BER stiege, N bliebe 0).
    //
    // Die Aufloesung steht in `D` selbst. `S_KBD` ist der Geraeteplatz
    // PLUS EINS, `D 2` heisst also Platz 1 -- das ZWEITE Geraet. Auf
    // Justins Brett ist Platz 0 die Tastatur und Platz 1 die zweite
    // HID-Schnittstelle seines Tastatur/Maus-Gespanns. Die Tafel zeigte
    // die Zahlen eines Geraets, das nie eine Tastatur war: dort wurde
    // genau einmal ein Block gelegt (ARM 1) und nichts kam zurueck.
    //
    // WIE `S_KBD` DORT HINKAM: `hid_start` weiter unten holt die
    // Berichtsbeschreibung, ruft `hid_claim` -- und `hid_claim` setzt
    // `S_KBD` KORREKT, naemlich nur, wenn noch keine Tastatur steht
    // (usb.fi, `if g(state, S_KBD) == 0`). Danach kam diese Zeile und
    // hat das Ergebnis BEDINGUNGSLOS ueberschrieben. Jedes spaeter
    // aufgesetzte Geraet, dessen Klasse `kbd` sagt, hat damit die
    // laufende Tastatur von der Tafel UND aus `hidin` verdraengt.
    //
    // In QEMU faellt das nie auf: dort gibt es genau EIN Geraet mit
    // Tastaturklasse, also ueberschreibt es sich selbst mit demselben
    // Wert. Gemessen in genau diesem Baum, `tools/design/eh6.sh`:
    //     usb: port=5 ... class=03:01:01 driver=kbd
    //     tafel: 18 KEYS  D 1 BER 12 ARM 13 CC 1 RK 00170000 N 6
    // Ein Brett mit zwei HID-Schnittstellen an einem Gehaeuse -- also
    // jede Spieletastatur mit Multimediatasten -- trifft es sofort.
    //
    // AB HIER GILT DIESELBE REGEL WIE IN `hid_claim`: DER ERSTE, DER
    // WIRKLICH LAEUFT, BLEIBT. Ein zweiter Fund wird nur genommen, wenn
    // der Platz frei ist oder der bisherige Eintrag nicht mehr taugt.
    if k == DRV_KBD {
        hid_start(state, d)
        tr(state, 27, d)
        if !kbd_taugt(state) {
            s(state, S_KBD, d + 1)
        }
        return
    }
    if k == DRV_MOUSE {
        hid_start(state, d)
        if !mouse_works(state) {
            s(state, S_MOUSE, d + 1)
        }
        return
    }
    if k == DRV_MSC {
        if msc_start(state, d) {
            // RUNDE HOTPLUG-2: einen PLATZ nehmen statt der einen
            // Zelle. Ist keiner mehr frei, ist das Geraet aufgezaehlt
            // und traegt seine Groesse -- es bekommt nur keine
            // Blockgeraetenummer, und das wird gemeldet statt still
            // uebergangen.
            let mi: u64 = msc_alloc(state)
            if mi >= MAX_MSC {
                var s_voll: [u8; 30] = "usb: msc kein Platz mehr frei\0"
                serial.puts((&s_voll[0]) as u64)
                serial.nl()
                return
            }
            msc_slot_set(state, mi, d + 1)
            // RUNDE HOTPLUG: die STEIGENDE Flanke. Erst hier ist der
            // Stick wirklich bereit -- INQUIRY beantwortet, TEST UNIT
            // READY durch, Groesse und Blockgroesse bekannt. Wer frueher
            // einhaengte, laese in ein Geraet, das noch anlaeuft.
            s(state, S_MSCGEN, g(state, S_MSCGEN) + 1)
        }
        return
    }
    if k == DRV_HUB {
        hub_start(state, d)
        return
    }
    if k == DRV_ECM {
        ecm_start(state, d)
        return
    }
    if k == DRV_RNDIS {
        rndis_start(state, d)
        return
    }
    if k == DRV_NCM {
        ncm_start(state, d)
        return
    }
    if k == DRV_CH336 {
        ch336_start(state, d)
        return
    }
    if k == DRV_AX88772 {
        ax88772_start(state, d)
        return
    }
    if k == DRV_AX88179 || k == DRV_RTL8153 {
        usbvnic.start(state, k - DRV_AX88772, dg(state, d, D_SLOT), dg(state, d, D_INDCI), dg(state, d, D_OUTDCI),
            dg(state, d, D_BULKMPS), dg(state, d, D_SPEED), state + DESC_OFF)
        return
    }
    if k == DRV_ISOTEST {
        iso_start(state, d)
    }
}

// ============================================================ r813: isoc test bed
//
// Scan the configuration for the first audio STREAMING interface (class 01,
// subclass 02) alternate setting >= 1 that has an isochronous OUT endpoint, and
// remember it packed in S_ISOA. QEMU `usb-audio` offers exactly that (alt 1,
// 192 bytes per 1 ms frame, full speed).
fn iso_data(state: u64, d: u64, buf: u64, total: u64) {
    s(state, S_ISOA, 0)
    var at: u64 = 0
    var iface: u64 = 0
    var alt: u64 = 0
    var mine: bool = false
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        if len < 2 || at + len > total {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                iface = b8(buf, at + 2)
                alt = b8(buf, at + 3)
                mine = b8(buf, at + 5) == 1 && b8(buf, at + 6) == 2 && alt != 0
                    && g(state, S_ISOA) == 0
            } else if kind == 5 && len >= 7 && mine {
                let addr: u64 = b8(buf, at + 2)
                if (b8(buf, at + 3) & 3) == 1 && (addr & 0x80) == 0 {
                    let dci: u64 = (addr & 0xF) * 2
                    s(state, S_ISOA, dci | (iface << 8) | (alt << 16)
                        | (b8(buf, at + 6) << 24) | (b16(buf, at + 4) << 32))
                    mine = false
                }
            }
            at = at + len
        }
    }
}

// Fill one packet buffer with a 1 kHz square wave (48 frames per period, 16 bit stereo).
fn iso_fill(state: u64, n: u64) {
    let p: u64 = state + ISO_BUF_OFF + (n % ISO_BUFS) * ISO_PKT
    var f: u64 = 0
    while f < 48 {
        var v: u64 = 0x1F40
        if f >= 24 {
            v = 0xE0C0
        }
        wr32(p + f * 4, v | (v << 16))
        f = f + 1
    }
}

// Select the streaming alt setting, then feed ISO_TDS TDs (one per frame) and
// count what the controller reports. One status line on the serial port.
fn iso_start(state: u64, d: u64) {
    var s_head: [u8; 16] = "usb: isoc alt=\0\0"
    var s_fail: [u8; 18] = "usb: isoc failed\0\0"
    var s_q: [u8; 9] = " queued=\0"
    var s_e: [u8; 9] = " events=\0"
    var s_b: [u8; 8] = " bytes=\0"
    var s_u: [u8; 8] = " under=\0"
    var s_m: [u8; 9] = " missed=\0"
    var s_x: [u8; 6] = " err=\0"
    var s_mps: [u8; 6] = " mps=\0"
    let slot: u64 = dg(state, d, D_SLOT)
    let a: u64 = g(state, S_ISOA)
    if a == 0 {
        serial.puts((&s_fail[0]) as u64)
        serial.nl()
        return
    }
    let dci: u64 = a & 0xFF
    if xhci.control(state, slot, 0x01, 0x0B, (a >> 16) & 0xFF, (a >> 8) & 0xFF,
        0, 0, false) < 0 {
        serial.puts((&s_fail[0]) as u64)
        serial.nl()
        return
    }
    var n: u64 = 0
    var spin: u64 = 0
    while n < ISO_BUFS {
        iso_fill(state, n)
        if xhci.isoc_queue(state, slot, dci, state + ISO_BUF_OFF + n * ISO_PKT, ISO_PKT) {
            n = n + 1
        } else {
            n = ISO_BUFS
        }
    }
    n = xhci.isoc_stat(state, slot, dci, xhci.ISO_QUEUED)
    while spin < 4000 && xhci.isoc_stat(state, slot, dci, xhci.ISO_EVENTS) < ISO_TDS {
        xhci.drain(state)
        while n < ISO_TDS && xhci.isoc_pending(state, slot, dci) < ISO_BUFS {
            iso_fill(state, n)
            if !xhci.isoc_queue(state, slot, dci, state + ISO_BUF_OFF + (n % ISO_BUFS) * ISO_PKT, ISO_PKT) {
                break
            }
            n = n + 1
        }
        xhci.udelay(state, 500)
        spin = spin + 1
    }
    xhci.drain(state)
    serial.puts((&s_head[0]) as u64)
    serial.dec((a >> 16) & 0xFF)
    serial.puts((&s_mps[0]) as u64)
    serial.dec((a >> 32) & 0x7FF)
    serial.puts((&s_q[0]) as u64)
    serial.dec(xhci.isoc_stat(state, slot, dci, xhci.ISO_QUEUED))
    serial.puts((&s_e[0]) as u64)
    serial.dec(xhci.isoc_stat(state, slot, dci, xhci.ISO_EVENTS))
    serial.puts((&s_b[0]) as u64)
    serial.dec(xhci.isoc_stat(state, slot, dci, xhci.ISO_BYTES))
    serial.puts((&s_u[0]) as u64)
    serial.dec(xhci.isoc_stat(state, slot, dci, xhci.ISO_UNDER))
    serial.puts((&s_m[0]) as u64)
    serial.dec(xhci.isoc_stat(state, slot, dci, xhci.ISO_MISSED))
    serial.puts((&s_x[0]) as u64)
    serial.dec(xhci.isoc_stat(state, slot, dci, xhci.ISO_ERR))
    serial.nl()
}

// L-015: bring a CDC-ECM function up. MAC from the string descriptor,
// SET_INTERFACE to the data alternate setting, then hand the slot and the
// bulk endpoints to the network driver.
fn ecm_start(state: u64, d: u64) {
    var s_ok: [u8; 17] = "usb: ecm mac=ok\0\0"
    var s_bad: [u8; 17] = "usb: ecm failed \0"
    var s_mac: [u8; 10] = "usb: ecm \0"
    let slot: u64 = dg(state, d, D_SLOT)
    let buf: u64 = state + DESC_OFF
    zero(buf, 64)
    let n: i64 = xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
        (3 << 8) | dg(state, d, D_MACSTR), 0x0409, 64, buf, true)
    var macb: u64 = state + DESC_OFF + 128
    zero(macb, 8)
    if n < 26 || dg(state, d, D_MACSTR) == 0
        || !rndis.cdc_mac_from_string(buf, n as u64, macb) {
        serial.puts((&s_bad[0]) as u64)
        serial.puts((&s_mac[0]) as u64)
        serial.nl()
        return
    }
    if xhci.control(state, slot, 0x01, 0x0B, dg(state, d, D_DATAALT),
        dg(state, d, D_DATAIF), 0, 0, false) < 0 {
        serial.puts((&s_bad[0]) as u64)
        serial.nl()
        return
    }
    var mac: u64 = 0
    var i: u64 = 0
    while i < 6 {
        mac = mac | (b8(macb, i) << (i * 8))
        i = i + 1
    }
    if !usbnet.attach(state, slot, dg(state, d, D_INDCI), dg(state, d, D_OUTDCI),
        dg(state, d, D_BULKMPS), mac) {
        serial.puts((&s_bad[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_mac[0]) as u64)
    hex2(mac & 0xFF)
    var k: u64 = 1
    while k < 6 {
        serial.put(58 as u8)
        hex2((mac >> (k * 8)) & 0xFF)
        k = k + 1
    }
    serial.nl()
}

// r811: RNDIS. The bulk pipes live in the DATA interface (class 0A), normally in alternate setting 0 (QEMU, Android);
// an alternate setting >= 1 is taken when that is where the pipes are. The data interface comes from the union
// descriptor, else it is the interface behind the control interface. The notification endpoint is not used
// (responses are fetched by polling GET_ENCAPSULATED_RESPONSE).
fn rndis_data(state: u64, d: u64, buf: u64, total: u64) {
    ds(state, d, D_INTDCI, 0)
    ds(state, d, D_INDCI, 0)
    ds(state, d, D_OUTDCI, 0)
    ds(state, d, D_DATAALT, 0)
    var dif: u64 = dg(state, d, D_DATAIF)
    if dif == 0 {
        dif = dg(state, d, D_IFACE) + 1
    }
    ds(state, d, D_DATAIF, dif)
    var at: u64 = 0
    var mine: bool = false
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        if len < 2 || at + len > total {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                mine = b8(buf, at + 2) == dif && b8(buf, at + 5) == 0x0A
                    && dg(state, d, D_INDCI) == 0 && b8(buf, at + 4) >= 2
                if mine {
                    ds(state, d, D_DATAALT, b8(buf, at + 3))
                }
            } else if kind == 5 && len >= 7 && mine {
                take_ep(state, d, buf, at)
            }
            at = at + len
        }
    }
}

// One RNDIS control exchange: SEND_ENCAPSULATED_COMMAND with `n` bytes at `cmd`, then poll
// GET_ENCAPSULATED_RESPONSE until the answer of type `want` (completion type) arrives. Indications and
// keepalives in between are skipped. Returns the answer length (0 = none/invalid); the answer is at `rsp`.
fn rndis_exchange(state: u64, d: u64, cmd: u64, n: u64, rsp: u64, want: u64) -> u64 {
    let slot: u64 = dg(state, d, D_SLOT)
    let iface: u64 = dg(state, d, D_IFACE)
    if xhci.control(state, slot, 0x21, 0x00, 0, iface, n, cmd, false) < 0 {
        return 0
    }
    var tries: u64 = 0
    while tries < 64 {
        zero(rsp, 128)
        let got: i64 = xhci.control(state, slot, 0xA1, 0x01, 0, iface, 128, rsp, true)
        if got >= 12 && rndis.msg_type(rsp, got as u64) == want {
            return rndis.msg_len(rsp, got as u64)
        }
        tries = tries + 1
    }
    return 0
}

// r811: bring an RNDIS function up: INITIALIZE, QUERY permanent MAC, SET packet filter, then hand the slot and
// the bulk pipes to the network driver (mode RNDIS).
fn rndis_start(state: u64, d: u64) {
    var s_bad: [u8; 19] = "usb: rndis failed \0"
    var s_mac: [u8; 12] = "usb: rndis \0"
    var s_step: [u8; 7] = "step=\0\0"
    let slot: u64 = dg(state, d, D_SLOT)
    let cmd: u64 = state + DESC_OFF
    let rsp: u64 = state + DESC_OFF + 192
    var step: u64 = 0
    zero(cmd, 160)
    var n: u64 = rndis.build_init(cmd, 1, 2048)
    var l: u64 = rndis_exchange(state, d, cmd, n, rsp, rndis.MSG_INIT_C)
    step = 1
    var ok: bool = l != 0 && rndis.init_c_ok(rsp, l)
    if ok {
        step = 2
        zero(cmd, 64)
        n = rndis.build_query(cmd, 2, rndis.OID_802_3_PERMANENT_ADDRESS)
        l = rndis_exchange(state, d, cmd, n, rsp, rndis.MSG_QUERY_C)
        ok = l != 0 && rndis.query_c_info_len(rsp, l) == 6
    }
    var mac: u64 = 0
    if ok {
        let off: u64 = rndis.query_c_info_off(rsp, l)
        var i: u64 = 0
        while i < 6 {
            mac = mac | (b8(rsp, off + i) << (i * 8))
            i = i + 1
        }
        step = 3
        zero(cmd, 64)
        n = rndis.build_set_filter(cmd, 3,
            rndis.FILTER_DIRECTED | rndis.FILTER_MULTICAST | rndis.FILTER_BROADCAST)
        l = rndis_exchange(state, d, cmd, n, rsp, rndis.MSG_SET_C)
        ok = l != 0 && rndis.msg_status(rsp, l) == rndis.STATUS_SUCCESS
    }
    if ok && dg(state, d, D_DATAALT) != 0 {
        step = 4
        ok = xhci.control(state, slot, 0x01, 0x0B, dg(state, d, D_DATAALT),
            dg(state, d, D_DATAIF), 0, 0, false) >= 0
    }
    if ok {
        step = 5
        ok = usbnet.attach_rndis(state, slot, dg(state, d, D_INDCI), dg(state, d, D_OUTDCI),
            dg(state, d, D_BULKMPS), mac, dg(state, d, D_IFACE))
    }
    if !ok {
        serial.puts((&s_bad[0]) as u64)
        serial.puts((&s_step[0]) as u64)
        serial.dec(step)
        serial.nl()
        return
    }
    serial.puts((&s_mac[0]) as u64)
    hex2(mac & 0xFF)
    var k: u64 = 1
    while k < 6 {
        serial.put(58 as u8)
        hex2((mac >> (k * 8)) & 0xFF)
        k = k + 1
    }
    serial.nl()
}

// LW-1a: bring a WCH CH336-family dongle up. Vendor control reads (lib/usbnet/ch397.fi: REQ_INFO, REQ_READ_REG)
// give the chip info and the MAC; the bulk pipes come from the interface descriptor (`parse`). HYPOTHESIS: the
// register map is from one out-of-tree driver and not yet confirmed on a real chip, so nothing is written to the chip.
// Serial lines: `usb: ch336 info=<8 octets>`, `usb: ch336 <mac>`, or `usb: ch336 failed step=N` (1 info, 2 mac, 3 attach).
fn ch336_start(state: u64, d: u64) {
    var s_bad: [u8; 18] = "usb: ch336 failed\0"
    var s_step: [u8; 7] = "step=\0\0"
    var s_inf: [u8; 17] = "usb: ch336 info=\0"
    var s_mac: [u8; 11] = "usb: ch336\0"
    let slot: u64 = dg(state, d, D_SLOT)
    let buf: u64 = state + DESC_OFF
    var step: u64 = 1
    s(state, S_CHDEV, d + 1)
    s(state, S_CHSTEP, 1)
    chdiag.bump(state, chdiag.F_STARTS)
    chdiag.set64(state, chdiag.F_START, dg(state, d, D_INDCI) | (dg(state, d, D_OUTDCI) << 8)
        | ((g(state, S_CHINT) & 255) << 16) | (dg(state, d, D_BULKMPS) << 24)
        | (dg(state, d, D_IFACE) << 40) | (dg(state, d, D_DATAALT) << 48) | (dg(state, d, D_CONFIG) << 56))
    chdiag.set64(state, chdiag.F_REC, (d + 1) | (slot << 8) | (dg(state, d, D_SPEED) << 16))
    ch_set_interface(state, d, slot)
    zero(buf, 64)
    var ok: bool = xhci.control(state, slot, 0xC0, ch397.REQ_INFO, 0, 0, 8, buf, true) >= 8
    xhci.udelay(state, 10000)
    var fwver: u64 = 0
    if ok {
        fwver = b8(buf, 2)
        serial.puts((&s_inf[0]) as u64)
        var k: u64 = 0
        while k < 8 {
            hex2(b8(buf, k))
            k = k + 1
        }
        serial.nl()
        step = 2
        s(state, S_CHSTEP, 2)
        zero(buf, 64)
        let lo: u64 = ch397.REG_MAC_L
        ok = xhci.control(state, slot, 0xC0, ch397.REQ_READ_REG, lo & 0xFFFF, lo >> 16, 4, buf, true) >= 4
        xhci.udelay(state, 10000)
        if ok {
            let hi: u64 = ch397.REG_MAC_H
            ok = xhci.control(state, slot, 0xC0, ch397.REQ_READ_REG, hi & 0xFFFF, hi >> 16, 2, buf + 8, true) >= 2
            xhci.udelay(state, 10000)
        }
    }
    var mac: u64 = 0
    if ok {
        var i: u64 = 0
        while i < 4 {
            mac = mac | (b8(buf, i) << (i * 8))
            i = i + 1
        }
        mac = mac | (b8(buf, 8) << 32) | (b8(buf, 9) << 40)
        ok = mac != 0 && (mac & 1) == 0
    }
    if ok {
        step = 3
        s(state, S_CHSTEP, 3)
        ok = usbnet.attach_ch336(state, slot, dg(state, d, D_INDCI), dg(state, d, D_OUTDCI),
            dg(state, d, D_BULKMPS), mac)
    }
    if ok {
        step = 4
        s(state, S_CHSTEP, 4)
        ok = usbnet.ch_bringup(state, fwver, ch_int_info(state))
    }
    if ok {
        s(state, S_CHSTEP, 4 | (1 << 8))
    } else {
        s(state, S_CHSTEP, step | (2 << 8))
    }
    if !ok {
        serial.puts((&s_bad[0]) as u64)
        serial.puts((&s_step[0]) as u64)
        serial.dec(step)
        serial.nl()
        return
    }
    serial.puts((&s_mac[0]) as u64)
    serial.put(32 as u8)
    hex2(mac & 0xFF)
    var q: u64 = 1
    while q < 6 {
        serial.put(58 as u8)
        hex2((mac >> (q * 8)) & 0xFF)
        q = q + 1
    }
    serial.nl()
}

fn ax_ctl(state: u64, slot: u64, bm: u64, req: u64, value: u64, index: u64, len: u64, buf: u64) -> i64 {
    return xhci.control(state, slot, bm, req, value, index, len, buf, bm >= 0x80)
}

fn ax_delay(state: u64, us: u64) {
    xhci.udelay(state, us)
}

// r1607: bring an ASIX AX88772/772B dongle up (lib/usbnet/ax88772_drv.fi sequence, host gate tools/ax88772drv with a fake device).
// Serial lines: `usb: ax88772 <mac>` or `usb: ax88772 failed step=N` (1 phy .. 8 rx on, 9 MAC implausible, 10 attach).
fn ax88772_start(state: u64, d: u64) {
    var s_bad: [u8; 20] = "usb: ax88772 failed\0"
    var s_step: [u8; 7] = "step=\0\0"
    var s_mac: [u8; 13] = "usb: ax88772\0"
    let slot: u64 = dg(state, d, D_SLOT)
    var step: u64 = 0
    let mac: u64 = ax88772_drv.bringup(state, slot, ax_ctl, ax_delay, state + DESC_OFF, &step)
    var ok: bool = mac != 0
    if ok {
        step = 10
        ok = usbnet.attach_ax88772(state, slot, dg(state, d, D_INDCI), dg(state, d, D_OUTDCI), dg(state, d, D_BULKMPS), mac)
    }
    if !ok {
        serial.puts((&s_bad[0]) as u64)
        serial.put(32 as u8)
        serial.puts((&s_step[0]) as u64)
        serial.dec(step)
        serial.nl()
        return
    }
    serial.puts((&s_mac[0]) as u64)
    serial.put(32 as u8)
    hex2(mac & 0xFF)
    var q: u64 = 1
    while q < 6 {
        serial.put(58 as u8)
        hex2((mac >> (q * 8)) & 0xFF)
        q = q + 1
    }
    serial.nl()
}

// r811: bring a CDC-NCM function up (NTB16, no CRC): MAC from the string descriptor, GET_NTB_PARAMETERS,
// SET_NTB_INPUT_SIZE (2048: the RX buffer of the network driver), SET_INTERFACE to the data alternate setting,
// then hand the slot, the bulk pipes and the device's TX framing rules to the network driver (mode NCM).
// Failure prints `usb: ncm failed step=N` (1 MAC, 2 parameters, 3 input size, 4 interface, 5 attach).
fn ncm_start(state: u64, d: u64) {
    var s_bad: [u8; 16] = "usb: ncm failed\0"
    var s_step: [u8; 7] = "step=\0\0"
    var s_mac: [u8; 9] = "usb: ncm\0"
    let slot: u64 = dg(state, d, D_SLOT)
    let iface: u64 = dg(state, d, D_IFACE)
    let buf: u64 = state + DESC_OFF
    var step: u64 = 1
    zero(buf, 64)
    let n: i64 = xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
        (3 << 8) | dg(state, d, D_MACSTR), 0x0409, 64, buf, true)
    var macb: u64 = state + DESC_OFF + 128
    zero(macb, 8)
    var ok: bool = n >= 26 && dg(state, d, D_MACSTR) != 0
        && rndis.cdc_mac_from_string(buf, n as u64, macb)
    let par: u64 = state + DESC_OFF + 192
    if ok {
        step = 2
        zero(par, 32)
        let got: i64 = xhci.control(state, slot, ncm.REQT_GET, ncm.REQ_GET_NTB_PARAMETERS, 0, iface,
            ncm.PARAMS_LEN, par, true)
        ok = got >= 28 && ncm.params_ok(par, got as u64) && ncm.params_supports_ntb16(par)
    }
    if ok {
        step = 3
        // A device may refuse this request; its default input size could then exceed our buffer, which the
        // host controller truncates (babble error, counted and dropped) instead of overflowing.
        let sz: u64 = state + DESC_OFF + 160
        zero(sz, 8)
        let m: u64 = ncm.build_set_input_size(sz, 2048)
        xhci.control(state, slot, ncm.REQT_SET, ncm.REQ_SET_NTB_INPUT_SIZE, 0, iface, m, sz, false)
        step = 4
        ok = xhci.control(state, slot, 0x01, 0x0B, dg(state, d, D_DATAALT),
            dg(state, d, D_DATAIF), 0, 0, false) >= 0
    }
    var mac: u64 = 0
    if ok {
        step = 5
        var i: u64 = 0
        while i < 6 {
            mac = mac | (b8(macb, i) << (i * 8))
            i = i + 1
        }
        ok = usbnet.attach_ncm(state, slot, dg(state, d, D_INDCI), dg(state, d, D_OUTDCI),
            dg(state, d, D_BULKMPS), mac, ncm.params_out_div(par), ncm.params_out_rem(par),
            ncm.params_out_align(par), ncm.params_out_max(par))
    }
    if !ok {
        serial.puts((&s_bad[0]) as u64)
        serial.put(32 as u8)
        serial.puts((&s_step[0]) as u64)
        serial.dec(step)
        serial.nl()
        return
    }
    serial.puts((&s_mac[0]) as u64)
    serial.put(32 as u8)
    hex2(mac & 0xFF)
    var k: u64 = 1
    while k < 6 {
        serial.put(58 as u8)
        hex2((mac >> (k * 8)) & 0xFF)
        k = k + 1
    }
    serial.nl()
}

// ------------------------------------------------------------ HID
//
// Boot-Protokoll einschalten, Wiederholung abschalten, und dann liegt
// dauerhaft GENAU EIN Block auf dem Unterbrechungsring. Wird er fertig,
// kommt eine Meldung; der Behandler wertet den Bericht aus und legt
// sofort den naechsten hin. Ein Ring ohne offenen Block ist eine
// Tastatur, die einmal getippt hat.

fn hid_start(state: u64, d: u64) {
    tr(state, 20, d)
    let slot: u64 = dg(state, d, D_SLOT)
    let iface: u64 = dg(state, d, D_IFACE)
    // RUNDE HID: ZUERST DIE BERICHTSBESCHREIBUNG VERSUCHEN.
    //
    // Geht sie zu holen UND zu zerlegen, laeuft dieses Geraet im
    // BERICHTSPROTOKOLL (SET_PROTOCOL 1) und seine Berichte gehen durch
    // `hidin.report` -- dann sind alle Tasten da, alle Knoepfe, das Rad
    // steht da, wo die Beschreibung es hinlegt, und ein Touchpad
    // funktioniert ueberhaupt erst.
    //
    // Geht sie NICHT, bleibt alles wie vorher: Boot-Protokoll. Das ist
    // kein Rest, sondern der Rueckfallweg, und er ist der Grund, warum
    // jedes BIOS eine USB-Tastatur bedienen kann. Ein Geraet, das man
    // nach dieser Runde NICHT mehr bedienen koennte, waere ein
    // Rueckschritt.
    // DER PLATZ IM ZERLEGER IST DER GERAETEPLATZ HIER -- mit EINER
    // Ausnahme: der letzte gehoert `i2chid.fi`. Ein Laptop hat sein
    // Touchpad an I2C und kann daneben vier USB-Geraete haben; ohne
    // diese Grenze wuerde das vierte USB-Geraet die Beschreibung des
    // Touchpads ueberschreiben, und der Zeiger waere weg, sobald jemand
    // einen Stick zu viel einsteckt.
    var generisch: bool = false
    if g(state, S_GEN) != 0 && d < hidrep.USB_DEV_MAX {
        generisch = hid_descriptor(state, d, slot, iface)
    }
    ds(state, d, D_GENERIC, 0)
    tr(state, 21, yes(generisch))
    if generisch {
        ds(state, d, D_GENERIC, 1)
        s(state, S_GENDEV, g(state, S_GENDEV) + 1)
        // SET_PROTOCOL 1 = Berichtsprotokoll.
        let r1: i64 = xhci.control(state, slot, 0x21, 0x0B, 1, iface, 0, 0, false)
        tr(state, 22, (r1 + 100) as u64)
        tr(state, 28, xhci.ep_code(state, xhci.ep_find(state, slot, 1)))
        let r2: i64 = xhci.control(state, slot, 0x21, 0x0A, 0, iface, 0, 0, false)
        tr(state, 23, (r2 + 100) as u64)
        hid_claim(state, d)
        tr(state, 24, dg(state, d, D_DRIVER))
        ds(state, d, D_PREV, 0)
        let i2: u64 = xhci.ep_find(state, slot, dg(state, d, D_INTDCI))
        if i2 < xhci.MAX_EP {
            ds(state, d, D_SEQ, xhci.ep_seq(state, i2))
        }
        tr(state, 25, d)
        arm(state, d)
        tr(state, 26, d)
        return
    }
    if dg(state, d, D_DRIVER) == DRV_HIDGEN {
        // Kein Boot-Protokoll UND keine brauchbare Beschreibung: dieses
        // Geraet bleibt liegen. Gezaehlt, nicht geraten.
        ds(state, d, D_DRIVER, DRV_NONE)
        return
    }
    // SET_PROTOCOL 0 = Boot. Klasse, Schnittstelle, Wirt an Geraet.
    xhci.control(state, slot, 0x21, 0x0B, 0, iface, 0, 0, false)
    // SET_IDLE 0 = nur melden, wenn sich etwas aendert.
    xhci.control(state, slot, 0x21, 0x0A, 0, iface, 0, 0, false)
    ds(state, d, D_PREV, 0)
    let i: u64 = xhci.ep_find(state, slot, dg(state, d, D_INTDCI))
    if i < xhci.MAX_EP {
        ds(state, d, D_SEQ, xhci.ep_seq(state, i))
    }
    arm(state, d)
}

// DIE BERICHTSBESCHREIBUNG HOLEN UND ZERLEGEN.
//
// GET_DESCRIPTOR mit bmRequestType 0x81 -- Geraet an Wirt, STANDARD,
// Empfaenger SCHNITTSTELLE. Das letzte ist der Punkt: eine
// Berichtsbeschreibung gehoert der Schnittstelle und nicht dem Geraet,
// und wer sie mit 0x80 anfordert, bekommt von manchem Geraet einen
// Stall und von manchem etwas anderes.
//
// Die Laenge steht im HID-Deskriptor der Konfiguration (`parse`, Art
// 0x21). Ohne sie wird gar nicht erst gefragt -- eine geratene Laenge
// waere entweder zu kurz (halbe Beschreibung) oder zu lang (Stall).
fn hid_descriptor(state: u64, d: u64, slot: u64, iface: u64) -> bool {
    let n: u64 = dg(state, d, D_RDLEN)
    if n == 0 || n > hidrep.RAW_MAX {
        s(state, S_RDFAIL, g(state, S_RDFAIL) + 1)
        return false
    }
    let dst: u64 = hidrep.raw_of(state, d)
    zero(dst, n)
    if xhci.control(state, slot, 0x81, REQ_GET_DESCRIPTOR,
        (0x22 << 8), iface, n, dst, true) < (n as i64) {
        s(state, S_RDFAIL, g(state, S_RDFAIL) + 1)
        return false
    }
    s(state, S_RDLEN, n)
    if hidrep.parse(state, d, dst, n) != hidrep.E_OK {
        s(state, S_RDFAIL, g(state, S_RDFAIL) + 1)
        return false
    }
    hidrep.say(state, d)
    let _q: u64 = inreg.register(d, quirk.B_USB, dg(state, d, D_VID), dg(state, d, D_PID))
    hid_set_modes(state, d, slot, iface)
    return true
}

fn hid_set_modes(state: u64, d: u64, slot: u64, iface: u64) {
    if (hidrep.kind(state, d) & (hidrep.K_PAD | hidrep.K_TOUCH)) == 0 {
        return
    }
    let n: u64 = hidmode.plan(state, d)
    let p: u64 = state + HUB_OFF + 0x60
    var i: u64 = 0
    while i < n {
        let rid: u64 = hidmode.rid_at(i)
        kstate.set8(p, rid as u8)
        let plen: u64 = hidmode.build(state, d, i, p + 1)
        if plen > 0 {
            let _r: i64 = xhci.control(state, slot, 0x21, REQ_SET_REPORT, inmode.usb_wvalue(rid), iface, plen + 1, p, false)
        }
        i = i + 1
    }
}

// Was das Geraet IST, steht in seiner Beschreibung und nicht in seiner
// Klasse. Ein Geraet kann beides sein (viele Tastaturen melden neben
// den Tasten eine Verbrauchersteuerung); dann zaehlt es hier als
// Tastatur UND meldet die Multimediatasten mit.
fn hid_claim(state: u64, d: u64) {
    let art: u64 = hidrep.kind(state, d)
    if (art & hidrep.K_KBD) != 0 {
        ds(state, d, D_DRIVER, DRV_KBD)
        if g(state, S_KBD) == 0 {
            s(state, S_KBD, d + 1)
        }
        return
    }
    if (art & (hidrep.K_MOUSE | hidrep.K_PAD | hidrep.K_TOUCH | hidrep.K_PEN)) != 0 {
        ds(state, d, D_DRIVER, DRV_MOUSE)
        if g(state, S_MOUSE) == 0 {
            s(state, S_MOUSE, d + 1)
        }
        return
    }
    // Etwas anderes (reine Verbrauchersteuerung zum Beispiel). Die
    // Berichte gehen trotzdem durch den Zerleger; was `hidin` darin
    // nicht kennt, faellt weg, statt falsch gedeutet zu werden.
    ds(state, d, D_DRIVER, DRV_HIDGEN)
}

fn arm(state: u64, d: u64) {
    ds(state, d, D_ARMS, dg(state, d, D_ARMS) + 1)
    xhci.int_queue(state, dg(state, d, D_SLOT), dg(state, d, D_INTDCI),
        report_buf(state, d), dg(state, d, D_INTLEN))
}

fn raw_remember(state: u64, d: u64) {
    let b: u64 = report_buf(state, d)
    var w: u64 = 0
    var k: u64 = 0
    while k < 8 {
        w = w | ((kstate.get8(b + k) as u64) << (k * 8))
        k = k + 1
    }
    if w != 0 {
        ds(state, d, D_ROHW, w)
        ds(state, d, D_ROHN, dg(state, d, D_ROHN) + 1)
    }
}

fn dev_rohw(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_ROHW)
}

fn dev_rohn(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_ROHN)
}

fn report_buf(state: u64, d: u64) -> u64 {
    return state + REPORT_OFF + d * 64
}

// Der Unterbrechungsweg. `trap.fi` ruft das; alles darunter ist die
// Kette, die ein Tastendruck bis in die Zeilendisziplin nimmt.
fn irq(state: u64) {
    xhci.irq(state)
    service(state)
}

// Was seit dem letzten Blick fertig wurde. Wird aus der Unterbrechung
// gerufen UND aus dem Abfragebetrieb der Gegenprobe -- beide Wege enden
// hier, und deshalb misst die Gegenprobe wirklich dieselbe Auswertung.
fn service(state: u64) {
    if g(state, S_READY) == 0 {
        return
    }
    // RUNDE STARTKNOPF: die Wiederbelebung eines Endpunkts wartet auf
    // den Regler. `service` kommt aus der Unterbrechung UND aus
    // `poll` -- ohne diese Sperre liefen zwei Durchlaeufe auf
    // demselben Ring, und beide warteten auf eine Antwort, die nur
    // einmal kommt.
    if g(state, S_SVCBUSY) != 0 {
        return
    }
    s(state, S_SVCBUSY, 1)
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_INTDCI) != 0 {
            let i: u64 = xhci.ep_find(state, dg(state, d, D_SLOT),
                dg(state, d, D_INTDCI))
            if i < xhci.MAX_EP {
                let seq: u64 = xhci.ep_seq(state, i)
                if seq != dg(state, d, D_SEQ) {
                    ds(state, d, D_SEQ, seq)
                    let cc: u64 = xhci.ep_code(state, i)
                    ds(state, d, D_LASTCC, cc)
                    if cc == xhci.CC_SUCCESS || cc == xhci.CC_SHORT {
                        s(state, S_REPORTS, g(state, S_REPORTS) + 1)
                        ds(state, d, D_REPS, dg(state, d, D_REPS) + 1)
                        // RUNDE VIELKERN: den Bericht MERKEN, bevor
                        // der naechste ihn ueberschreibt -- und nur,
                        // wenn er etwas sagt. Siehe D_ROHW.
                        raw_remember(state, d)
                        deliver(state, d)
                    } else {
                        // ==================== RUNDE STARTKNOPF
                        // EIN ANGEHALTENER ENDPUNKT KOMMT VON SELBST
                        // NICHT ZURUECK.
                        //
                        // HIER STAND NUR `arm`. Das ist der Fehler, und
                        // er erklaert die Beobachtung genau: die MAUS
                        // laeuft (sie hat nie einen Fehler), die
                        // TASTATUR liefert nichts (ein einziger
                        // Uebertragungsfehler genuegt). Nach einem
                        // Stall (6) oder einem Uebertragungsfehler (4)
                        // steht der Endpunkt im Zustand `halted`, und
                        // xHCI 1.2, 4.6.8 ist dabei eindeutig: der
                        // Regler nimmt DANN KEINEN BLOCK MEHR AN. Man
                        // darf klingeln, so oft man will -- `ARM` laeuft
                        // hoch, `BER` steht. Genau dieses Zahlenbild
                        // meldet Justins Tafel.
                        //
                        // In QEMU kommt es nie vor: ein nachgebildetes
                        // Geraet erzeugt keine Uebertragungsfehler. Auf
                        // Blech, an einem echten Kabel, mit einer echten
                        // Spieletastatur, kommen sie.
                        //
                        // Die Wiederbelebung ist die vorgeschriebene:
                        // `Reset Endpoint` an den Regler,
                        // CLEAR_FEATURE(ENDPOINT_HALT) an das Geraet,
                        // `Set TR Dequeue Pointer` auf den frischen
                        // Ring. `unstall` tut genau das und wurde
                        // bisher nur vom Massenspeicher gerufen.
                        ds(state, d, D_ERRS, dg(state, d, D_ERRS) + 1)
                        if xhci.ep_halted(state, dg(state, d, D_SLOT),
                            dg(state, d, D_INTDCI)) {
                            unstall(state, d, dg(state, d, D_INTDCI))
                            ds(state, d, D_HEAL, dg(state, d, D_HEAL) + 1)
                            s(state, S_HEAL, g(state, S_HEAL) + 1)
                        }
                    }
                    arm(state, d)
                }
            }
        }
        d = d + 1
    }
    // RUNDE BLECHEINGABE: hat eine Feststelltaste den Zustand umgelegt,
    // geht er JETZT an das Geraet zurueck. Hier und nicht im Zeitgeber:
    // hier ist gerade ohnehin ein Bericht durchgelaufen, das Geraet
    // antwortet also.
    led_service(state)
    s(state, S_SVCBUSY, 0)
}

// DER ZWEITE WEG ZU DENSELBEN BERICHTEN, und er ist eine GEGENPROBE und
// kein Ersatz. Mit `usbnoirq` bleibt der Meldevektor maskiert: der
// Regler bewegt die Daten weiterhin, aber niemand sagt es dem Kernel --
// und dann kommt keine Taste an. Mit `usbpoll` sieht der Kernel selbst
// nach, und dieselben Tasten kommen an. Der Unterschied zwischen den
// beiden Laeufen ist der Beweis, dass die Meldung wirklich das ist, was
// die Eingabe traegt, und nicht eine Verzierung neben einer
// Abfrageschleife.
fn poll(state: u64) {
    if g(state, S_READY) == 0 {
        return
    }
    xhci.drain(state)
    service(state)
}

fn deliver(state: u64, d: u64) {
    // RUNDE HID: EINE WEICHE UND ZWEI WEGE, DIE BEIDE IN `hidin.fi`
    // ENDEN. Oben der generische -- der Bericht wird nach seiner
    // Beschreibung gelesen. Unten der Rueckfallweg mit dem festen
    // Format des Boot-Protokolls. Was danach kommt (Abtastcode,
    // Zeilendisziplin, Fensterfokus, PS/2-Paket), ist fuer beide
    // dasselbe und steht nur einmal da.
    if dg(state, d, D_GENERIC) == 1 {
        hidin.report(state, d, report_buf(state, d), dg(state, d, D_INTLEN))
        return
    }
    if dg(state, d, D_DRIVER) == DRV_KBD {
        kbd_report(state, d)
        return
    }
    if dg(state, d, D_DRIVER) == DRV_MOUSE {
        mouse_report(state, d)
    }
}

// Acht Oktett: ein Zusatztastenfeld, ein leeres, sechs Gebrauchscodes.
// Was NEU dabei ist, ist gedrueckt worden. Was fehlt, ist losgelassen --
// und das interessiert nur bei Umschalt und Steuerung, weil der
// PS/2-Weg fuer alles andere ohnehin nur die Druecken-Codes ansieht.
fn kbd_report(state: u64, d: u64) {
    let before: u64 = hidin.keys(state)
    hidin.kbd_report_boot(state, d, report_buf(state, d))
    // `usb: keys=N` zaehlt seit Runde K17 die Tasten, die WIRKLICH
    // durch den USB-Weg gegangen sind, und `tools/k17/run.sh` haengt
    // daran. Die Zahl bleibt, auch wenn die Auswertung eine Etage
    // tiefer gewandert ist.
    s(state, S_KEYS, g(state, S_KEYS) + (hidin.keys(state) - before))
}

// RUNDE HIDWEG: was `hidin` gezaehlt hat, fuer den Eingabepuls des
// Schreibtischs. Drei Weiterreichungen und keine eigene Buchfuehrung --
// zwei Zaehler ueber dieselbe Sache waeren zwei Wahrheiten.
fn hid_keys(state: u64) -> u64 {
    return hidin.keys(state)
}

fn hid_los(state: u64) -> u64 {
    return hidin.releases(state)
}

fn hid_bew(state: u64) -> u64 {
    return hidin.moves(state)
}

fn press(state: u64, u: u64) {
    hidin.press(state, u)
    s(state, S_KEYS, g(state, S_KEYS) + 1)
}

fn mouse_report(state: u64, d: u64) {
    hidin.mouse_report_boot(state, d, report_buf(state, d),
        dg(state, d, D_INTLEN))
    s(state, S_MOVES, g(state, S_MOVES) + 1)
}

// ------------------------------------------------------ Massenspeicher
//
// Bulk-Only-Transport: ein Befehlsblock hin, Daten hin oder her, eine
// Quittung zurueck. Darin steckt ein SCSI-Befehl -- derselbe, den eine
// SATA-Platte auch verstuende. Das ist der Grund, warum ein Stick
// ueberhaupt an `blk.fi` passt: er spricht Bloecke.

const CBW_SIG: u64 = 0x43425355
const CSW_SIG: u64 = 0x53425355

// ============================== RUNDE HOTPLUG-2: JE PLATZ, NICHT JE BAUM
//
// Jede dieser Fragen gilt einem BESTIMMTEN Massenspeicher. `i` ist der
// Platz in der Liste (0..MAX_MSC-1) und zugleich die Nummer, die
// `blk.fi` als `DEV_USB0 + i` fuehrt.

// Der Platz haelt `Geraetenummer + 1`; 0 heisst frei.
fn msc_slot(state: u64, i: u64) -> u64 {
    if i >= MAX_MSC {
        return 0
    }
    return g(state, S_MSCTAB + i * 8)
}

fn msc_slot_set(state: u64, i: u64, v: u64) {
    if i < MAX_MSC {
        s(state, S_MSCTAB + i * 8, v)
    }
}

fn msc_ready_at(state: u64, i: u64) -> bool {
    return msc_slot(state, i) != 0
}

fn msc_dev_at(state: u64, i: u64) -> u64 {
    return msc_slot(state, i) - 1
}

fn msc_blocks_at(state: u64, i: u64) -> u64 {
    if !msc_ready_at(state, i) {
        return 0
    }
    return dg(state, msc_dev_at(state, i), D_MSCBLK)
}

fn msc_bsize_at(state: u64, i: u64) -> u64 {
    if !msc_ready_at(state, i) {
        return 0
    }
    return dg(state, msc_dev_at(state, i), D_MSCBS)
}

// Wie viele Plaetze belegt sind. Fuer Meldungen und die Abnahme.
fn msc_count(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < MAX_MSC {
        if msc_slot(state, i) != 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Einen freien Platz nehmen, MAX_MSC wenn keiner mehr da ist.
fn msc_alloc(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_MSC {
        if msc_slot(state, i) == 0 {
            return i
        }
        i = i + 1
    }
    return MAX_MSC
}

// Der Platz, auf dem dieses Geraet liegt -- MAX_MSC, wenn keiner.
fn msc_slot_of_dev(state: u64, d: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_MSC {
        if msc_slot(state, i) == d + 1 {
            return i
        }
        i = i + 1
    }
    return MAX_MSC
}

// ----------------------------------------------------------------
// DIE ALTEN NAMEN, damit die Schichten darueber unveraendert laufen.
// Sie meinen den ERSTEN belegten Platz. `rootsel.fi` sucht so seine
// Wurzel, und `blkdev.fi` fragt so, ob ueberhaupt ein Stick da ist.
fn msc_first(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_MSC {
        if msc_slot(state, i) != 0 {
            return i
        }
        i = i + 1
    }
    return MAX_MSC
}

fn msc_ready(state: u64) -> bool {
    return msc_first(state) < MAX_MSC
}

fn msc_blocks(state: u64) -> u64 {
    return msc_blocks_at(state, msc_first(state))
}

fn msc_bsize(state: u64) -> u64 {
    return msc_bsize_at(state, msc_first(state))
}

fn msc_dev(state: u64) -> u64 {
    return msc_dev_at(state, msc_first(state))
}

fn set8(p: u64, i: u64, v: u64) {
    __mmio_write8((p + i) as *mut u8, (v & 0xFF) as u8)
}

fn set32le(p: u64, i: u64, v: u64) {
    set8(p, i, v)
    set8(p, i + 1, v >> 8)
    set8(p, i + 2, v >> 16)
    set8(p, i + 3, v >> 24)
}

fn be32(p: u64, i: u64) -> u64 {
    return (b8(p, i) << 24) | (b8(p, i + 1) << 16) | (b8(p, i + 2) << 8)
        | b8(p, i + 3)
}

// Ein Befehl. `cdb` steht schon im Befehlsblock ab Oktett 15; hier wird
// nur der Kopf gefuellt, gesendet, Daten bewegt und die Quittung
// geprueft. Rueckgabe: true, wenn das Geraet 0 gemeldet hat.
fn bot(state: u64, d: u64, cdb_len: u64, data: u64, dlen: u64,
    dir_in: bool) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let cbw: u64 = state + CBW_OFF
    let csw: u64 = state + CSW_OFF
    s(state, S_LASTDATA, 0)
    let tag: u64 = g(state, S_TAG) + 1
    s(state, S_TAG, tag)
    set32le(cbw, 0, CBW_SIG)
    set32le(cbw, 4, tag)
    set32le(cbw, 8, dlen)
    var flags: u64 = 0
    if dir_in {
        flags = 0x80
    }
    set8(cbw, 12, flags)
    set8(cbw, 13, 0) // Einheit 0
    set8(cbw, 14, cdb_len)
    s(state, S_MSCIO, g(state, S_MSCIO) + 1)
    if xhci.bulk(state, slot, dg(state, d, D_OUTDCI), cbw, 31) != 31 {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        return false
    }
    if dlen > 0 {
        var dci: u64 = dg(state, d, D_OUTDCI)
        if dir_in {
            dci = dg(state, d, D_INDCI)
        }
        let n: i64 = xhci.bulk(state, slot, dci, data, dlen)
        if n > 0 {
            s(state, S_LASTDATA, n as u64)
        } else {
            s(state, S_LASTDATA, 0)
        }
        if n < 0 {
            // Ein STALL im Datenteil ist kein Weltuntergang -- das
            // Protokoll sieht ihn vor. Der Endpunkt wird
            // zurueckgesetzt, und die Quittung wird trotzdem geholt;
            // sie sagt, was wirklich war.
            unstall(state, d, dci)
        }
    }
    zero(csw, 16)
    if xhci.bulk(state, slot, dg(state, d, D_INDCI), csw, 13) != 13 {
        unstall(state, d, dg(state, d, D_INDCI))
        if xhci.bulk(state, slot, dg(state, d, D_INDCI), csw, 13) != 13 {
            s(state, S_MSCERR, g(state, S_MSCERR) + 1)
            return false
        }
    }
    if b8(csw, 0) != (CSW_SIG & 0xFF) || b8(csw, 1) != ((CSW_SIG >> 8) & 0xFF)
        || b8(csw, 2) != ((CSW_SIG >> 16) & 0xFF) || b8(csw, 3) != ((CSW_SIG >> 24) & 0xFF)
        || (b8(csw, 4) | (b8(csw, 5) << 8) | (b8(csw, 6) << 16) | (b8(csw, 7) << 24)) != tag {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        reset_recovery(state, d)
        return false
    }
    let status: u64 = b8(csw, 12)
    if status == 2 {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        reset_recovery(state, d)
        return false
    }
    if status != 0 {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        return false
    }
    return true
}

fn reset_recovery(state: u64, d: u64) {
    let slot: u64 = dg(state, d, D_SLOT)
    xhci.control(state, slot, 0x21, 0xFF, 0, dg(state, d, D_IFACE), 0, 0, false)
    unstall(state, d, dg(state, d, D_INDCI))
    unstall(state, d, dg(state, d, D_OUTDCI))
}

fn unstall(state: u64, d: u64, dci: u64) {
    let slot: u64 = dg(state, d, D_SLOT)
    let i: u64 = xhci.ep_find(state, slot, dci)
    if i >= xhci.MAX_EP {
        return
    }
    // CLEAR_FEATURE(ENDPOINT_HALT) an das GERAET und `Reset Endpoint` an
    // den REGLER: beide Seiten haben den Anschlag gemerkt, und beide
    // muessen ihn vergessen.
    var epaddr: u64 = dci / 2
    if (dci & 1) != 0 {
        epaddr = epaddr | 0x80
    }
    xhci.reset_endpoint(state, slot, dci)
    xhci.control(state, slot, 0x02, REQ_CLEAR_FEATURE, 0, epaddr, 0, 0, false)
    xhci.set_dequeue(state, slot, dci, i)
}

fn cdb(state: u64) -> u64 {
    return state + CBW_OFF + 15
}

fn msc_start(state: u64, d: u64) -> bool {
    var s_msc: [u8; 11] = "usb: msc \0\0"
    var s_blk: [u8; 8] = "blocks=\0"
    var s_bs: [u8; 9] = "  bsize=\0"
    var s_inq: [u8; 7] = "  inq=\0"
    var s_bad: [u8; 26] = "usb: msc unusable bsize=\0\0"

    if dg(state, d, D_INDCI) == 0 || dg(state, d, D_OUTDCI) == 0 {
        return false
    }
    let buf: u64 = state + DESC_OFF
    // INQUIRY: 36 Oktett, und die Oktette 8..15 sind der Hersteller --
    // die einzige Stelle, an der ein Stick sagt, wer er ist.
    zero(buf, 64)
    let inq_cdb: u64 = scsi.inquiry(cdb(state), 36)
    if !bot(state, d, inq_cdb, buf, 36, true) {
        return false
    }
    let inq_len: u64 = g(state, S_LASTDATA)
    // TEST UNIT READY, bis zu fuenfmal. Ein Stick, der gerade erst
    // angesteckt wurde, meldet beim ersten Mal oft "nicht bereit"; das
    // ist kein Fehler, sondern der Grund, warum es diesen Befehl gibt.
    var tries: u64 = 0
    var up: bool = false
    while tries < 5 && !up {
        let tur_cdb: u64 = scsi.test_unit_ready(cdb(state))
        if bot(state, d, tur_cdb, 0, 0, false) {
            up = true
        } else {
            sense(state, d)
        }
        tries = tries + 1
    }
    if !up {
        return false
    }
    // Die Antwort auf READ CAPACITY kommt in einen EIGENEN Puffer.
    // Der erste Entwurf schrieb sie ueber die INQUIRY-Antwort, und
    // danach war der Herstellername in der Meldung leer -- ein Fehler,
    // der nur in der AUSGABE stand und nicht im Treiber, und der genau
    // deshalb eine Stunde gekostet haette, wenn ihn niemand gemeldet
    // haette.
    let cap: u64 = buf + 128
    zero(cap, 32)
    let cap_cdb: u64 = scsi.read_capacity10(cdb(state))
    if !bot(state, d, cap_cdb, cap, 8, true) {
        return false
    }
    var last: u64 = be32(cap, 0)
    var bs: u64 = be32(cap, 4)
    if last == 0xFFFFFFFF {
        zero(cap, 32)
        let cap16_cdb: u64 = scsi.read_capacity16(cdb(state), 32)
        if !bot(state, d, cap16_cdb, cap, 32, true) {
            return false
        }
        last = (be32(cap, 0) << 32) | be32(cap, 4)
        bs = be32(cap, 8)
    }
    if bs != 512 {
        // Ehrlich statt still: `blk.fi` spricht 512 Oktett je Block,
        // und ein Stick mit 4096 waere ein anderer Treiber. Er wird
        // gemeldet und NICHT eingehaengt.
        serial.puts((&s_bad[0]) as u64)
        serial.dec(bs)
        serial.nl()
        return false
    }
    // RUNDE HOTPLUG-2: die Groesse gehoert zum GERAET, nicht zum Baum.
    ds(state, d, D_MSCBLK, last + 1)
    ds(state, d, D_MSCBS, bs)
    serial.puts((&s_msc[0]) as u64)
    serial.puts((&s_blk[0]) as u64)
    serial.dec(last + 1)
    serial.puts((&s_bs[0]) as u64)
    serial.dec(bs)
    serial.puts((&s_inq[0]) as u64)
    serial.dec(inq_len)
    serial.put(32 as u8)
    var i: u64 = 8
    while i < 16 {
        let c: u64 = b8(buf, i)
        if c >= 32 && c < 127 {
            serial.put(c as u8)
        }
        i = i + 1
    }
    serial.nl()
    return true
}

fn sense(state: u64, d: u64) -> u64 {
    let buf: u64 = state + DESC_OFF + 256
    zero(buf, 32)
    let sense_cdb: u64 = scsi.request_sense(cdb(state), 18)
    if !bot(state, d, sense_cdb, buf, 18, true) {
        return 0
    }
    return scsi.sense_key(buf)
}

fn msc_sync_at(state: u64, i: u64) -> bool {
    var s_sync: [u8; 18] = "usb: msc sync ok=\0"
    if !msc_ready_at(state, i) {
        return false
    }
    let d: u64 = msc_dev_at(state, i)
    let sync_cdb: u64 = scsi.sync_cache(cdb(state))
    var done: bool = bot(state, d, sync_cdb, 0, 0, false)
    if !done {
        done = sense(state, d) == scsi.KEY_ILLEGAL_REQUEST
    }
    serial.puts((&s_sync[0]) as u64)
    serial.dec(yes(done))
    serial.nl()
    return done
}

// Die zwei Zeilen, an denen `blk.fi` haengt. Ein Block, 512 Oktett, und
// die Schicht darueber erfaehrt nicht, dass er ueber vier Endpunkte und
// drei Uebertragungen gekommen ist.
// RUNDE HOTPLUG-2: MIT PLATZNUMMER. `i` sagt, WELCHER Stick gemeint
// ist; `bot` nahm die Geraetenummer schon immer entgegen und holt
// Steckplatz und Endpunkte aus dem Geraetefeld -- der Transport war
// also nie einzelgeraetig, nur die Zeile darueber.
fn msc_read_at(state: u64, i: u64, lba: u64, dst: u64) -> bool {
    if !msc_ready_at(state, i) {
        return false
    }
    let d: u64 = msc_dev_at(state, i)
    let tmp: u64 = state + BLK_OFF
    let read_cdb: u64 = scsi.read_blocks(cdb(state), lba, 1)
    if !bot(state, d, read_cdb, tmp, 512, true) {
        return false
    }
    copy(tmp, dst, 512)
    return true
}

fn msc_blk_dev(i: u64) -> u64 {
    if i == 0 {
        return wlock.D_USB0
    }
    return wlock.D_USB1 + i - 1
}

fn msc_write_at(state: u64, i: u64, lba: u64, src: u64) -> bool {
    if !wlock.allowed(msc_blk_dev(i)) {
        return false
    }
    if !msc_ready_at(state, i) {
        return false
    }
    let d: u64 = msc_dev_at(state, i)
    let tmp: u64 = state + BLK_OFF
    copy(src, tmp, 512)
    let write_cdb: u64 = scsi.write_blocks(cdb(state), lba, 1)
    return bot(state, d, write_cdb, tmp, 512, false)
}

fn copy(from: u64, to: u64, n: u64) {
    var i: u64 = 0
    while i < n / 8 {
        __mmio_write64((to + i * 8) as *mut u64,
            __mmio_read64((from + i * 8) as *mut u64))
        i = i + 1
    }
}

// ------------------------------------------------------ abziehen

// Nachsehen, ob ein Geraet verschwunden ist. Wird aus dem Zeitgeber
// gerufen und aus der Gegenprobe -- und der Unterschied zwischen
// "abgezogen" und "war nie da" steht in der Bitkarte S_ATTACHED.
fn unplug_check(state: u64) {
    if g(state, S_READY) == 0 || g(state, S_BUSY) != 0 {
        return
    }
    let n: u64 = xhci.ports(state)
    var p: u64 = 1
    while p <= n {
        if xhci.port_has_change(state, p) {
            xhci.port_clear_changes(state, p)
            let now: bool = xhci.port_connected(state, p)
            if was_there(state, p) && !now {
                gone(state, p)
            } else if !was_there(state, p) && now {
                s(state, S_HOTPLUGS, g(state, S_HOTPLUGS) + 1)
                mark(state, p)
                attach(state, p)
            }
        }
        p = p + 1
    }
}

fn unplug_dev(state: u64, d: u64) {
    var s_gone: [u8; 18] = "usb: unplug port=\0"
    var s_drv: [u8; 9] = " driver=\0"
    serial.puts((&s_gone[0]) as u64)
    serial.dec(dg(state, d, D_PORT))
    serial.puts((&s_drv[0]) as u64)
    drv_name(dg(state, d, D_DRIVER))
    serial.nl()
    if g(state, S_KBD) == d + 1 {
        s(state, S_KBD, 0)
    }
    if g(state, S_MOUSE) == d + 1 {
        s(state, S_MOUSE, 0)
    }
    let mi: u64 = msc_slot_of_dev(state, d)
    if mi < MAX_MSC {
        msc_slot_set(state, mi, 0)
        ds(state, d, D_MSCBLK, 0)
        ds(state, d, D_MSCBS, 0)
        s(state, S_MSCWEG, g(state, S_MSCWEG) + 1)
    }
    usbnet.unplug_slot(state, dg(state, d, D_SLOT))
    drop_dev(state, d)
    s(state, S_NDEV, g(state, S_NDEV) - 1)
    s(state, S_UNPLUGS, g(state, S_UNPLUGS) + 1)
}

fn unplug_below(state: u64, slot: u64) {
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_PARENT) == slot {
            let child: u64 = dg(state, d, D_SLOT)
            let is_hub: bool = dg(state, d, D_DRIVER) == DRV_HUB
            unplug_dev(state, d)
            if is_hub {
                unplug_below(state, child)
            }
        }
        d = d + 1
    }
}

fn gone(state: u64, p: u64) {
    unmark(state, p)
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_PORT) == p {
            unplug_dev(state, d)
        }
        d = d + 1
    }
}

// DIE GEGENPROBE ZUM ABZIEHEN, ohne dass jemand am Stecker zieht: der
// Anschluss wird fuer weg erklaert. Genau das, was passiert, wenn eine
// Hand den Stick herauszieht -- der Regler meldet einen Anschlusswechsel
// und CCS faellt auf null. Hier wird nur der zweite Teil nachgestellt,
// und was danach geschieht (kein Panik, ENODEV auf offenen Deskriptoren)
// ist dasselbe.
fn unplug_now(state: u64) {
    if g(state, S_READY) == 0 {
        return
    }
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 {
            gone(state, dg(state, d, D_PORT))
        }
        d = d + 1
    }
}

// ------------------------------------------------------- die Auskunft

fn say(state: u64) {
    var s_h: [u8; 14] = "usb: devices=\0"
    var s_k: [u8; 6] = " kbd=\0"
    var s_m: [u8; 8] = " mouse=\0"
    var s_s: [u8; 6] = " msc=\0"
    var s_e: [u8; 8] = " enums=\0"
    var s_f: [u8; 8] = " fails=\0"
    var s_ev: [u8; 9] = " events=\0"
    var s_i: [u8; 7] = " irqs=\0"
    var s_c: [u8; 7] = " cmds=\0"
    serial.puts((&s_h[0]) as u64)
    serial.dec(g(state, S_NDEV))
    serial.puts((&s_k[0]) as u64)
    serial.dec(yes(have_kbd(state)))
    serial.puts((&s_m[0]) as u64)
    serial.dec(yes(have_mouse(state)))
    serial.puts((&s_s[0]) as u64)
    serial.dec(yes(msc_ready(state)))
    serial.puts((&s_e[0]) as u64)
    serial.dec(g(state, S_ENUMS))
    serial.puts((&s_f[0]) as u64)
    serial.dec(g(state, S_FAILS))
    serial.puts((&s_ev[0]) as u64)
    serial.dec(xhci.events(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(xhci.irqs(state))
    serial.puts((&s_c[0]) as u64)
    serial.dec(xhci.cmds(state))
    serial.nl()
}

// WAS DER BAUM IN DIESEM LAUF WIRKLICH GETAN HAT. Diese Zeile steht am
// ENDE des Laufs, nicht am Anfang -- alles darin ist eine Zahl, die
// waehrend der Arbeit entstanden ist, und `tools/k17/run.sh` liest jede
// einzelne zurueck. Eine Runde, die eine Tastatur baut und nicht sagen
// kann, wie viele Tasten ueber sie gekommen sind, hat nichts vorzuweisen.
//
// `keys` ist dabei die wichtigste: sie zaehlt NUR die Tasten, die durch
// `usb.press` gegangen sind. Steht dort null und in der Shell trotzdem
// Text, dann hat die PS/2-Tastatur getippt und nicht die USB-Tastatur --
// genau der Selbstbetrug, gegen den diese Zahl da ist.
fn report(state: u64) {
    var s_h: [u8; 11] = "usb: keys=\0"
    var s_r: [u8; 10] = " reports=\0"
    var s_m: [u8; 8] = " moves=\0"
    var s_e: [u8; 9] = " events=\0"
    var s_i: [u8; 7] = " irqs=\0"
    var s_x: [u8; 10] = " xhcierr=\0"
    var s_o: [u8; 8] = " mscio=\0"
    var s_c: [u8; 9] = " mscerr=\0"
    var s_u: [u8; 10] = " unplugs=\0"
    var s_p: [u8; 11] = " hotplugs=\0"
    var s_d: [u8; 10] = " devices=\0"
    var s_t: [u8; 11] = " selftest=\0"
    var s_mx: [u8; 5] = " mx=\0"
    var s_my: [u8; 5] = " my=\0"
    var s_mb: [u8; 7] = " mbtn=\0"
    var s_mp: [u8; 7] = " mpkt=\0"
    var s_mc: [u8; 7] = " mclk=\0"
    if g(state, S_READY) == 0 {
        return
    }
    serial.puts((&s_h[0]) as u64)
    serial.dec(g(state, S_KEYS))
    serial.puts((&s_r[0]) as u64)
    serial.dec(g(state, S_REPORTS))
    serial.puts((&s_m[0]) as u64)
    serial.dec(g(state, S_MOVES))
    serial.puts((&s_e[0]) as u64)
    serial.dec(xhci.events(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(xhci.irqs(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(xhci.errors(state))
    serial.puts((&s_o[0]) as u64)
    serial.dec(g(state, S_MSCIO))
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, S_MSCERR))
    serial.puts((&s_u[0]) as u64)
    serial.dec(g(state, S_UNPLUGS))
    serial.puts((&s_p[0]) as u64)
    serial.dec(g(state, S_HOTPLUGS))
    serial.puts((&s_d[0]) as u64)
    serial.dec(g(state, S_NDEV))
    serial.puts((&s_t[0]) as u64)
    serial.dec(selftest(state))
    // Wo der Zeiger steht, welche Taste haengt und wie viele Pakete
    // durchgegangen sind. Die drei Zahlen kommen aus `ps2m` und NICHT
    // aus diesem Treiber -- das ist der Sinn der Sache: eine USB-Maus,
    // die ihre eigene Position fuehrte, waere ein zweites Zeigegeraet
    // und kein Geraet am selben Zeiger.
    serial.puts((&s_mx[0]) as u64)
    serial.dec(gfx.mouse_x(state))
    serial.puts((&s_my[0]) as u64)
    serial.dec(gfx.mouse_y(state))
    serial.puts((&s_mb[0]) as u64)
    serial.dec(gfx.mouse_buttons(state))
    serial.puts((&s_mp[0]) as u64)
    serial.dec(gfx.mouse_packets(state))
    serial.puts((&s_mc[0]) as u64)
    serial.dec(gfx.mouse_clicks(state))
    serial.nl()
    hid_report(state)
}

// RUNDE HID: EINE EIGENE ZEILE, und das mit Absicht. Die Zeile `usb:`
// wird seit K17 von `tools/k17/run.sh` Wort fuer Wort gelesen; wer eine
// Zahl dazwischenschiebt, bricht einen Test, der mit dieser Runde
// nichts zu tun hat.
fn hid_report(state: u64) {
    var s_a: [u8; 10] = "hid: gen=\0"
    var s_b: [u8; 8] = " rdlen=\0"
    var s_c: [u8; 9] = " rdfail=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(g(state, S_GENDEV))
    serial.puts((&s_b[0]) as u64)
    serial.dec(g(state, S_RDLEN))
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, S_RDFAIL))
    serial.nl()
    hidin.say(state)
}

// WAS RING 3 UEBER DIESEN BAUM ERFAHREN DARF. Eine Zahl je Frage, ueber
// SYS_OSUM_USBSTAT (1701) -- damit `/bin/k17` jede Zusage dieser Runde
// von AUSSEN messen kann und nicht aus der seriellen Leitung des Kerns
// abschreiben muss. Dieselbe Bauart wie SYS_OSUM_MNTSTAT aus Runde K14.
fn stat(state: u64, what: u64) -> u64 {
    if what == 0 {
        return yes(ready(state))
    }
    if what == 1 {
        return g(state, S_NDEV)
    }
    if what == 2 {
        return yes(have_kbd(state))
    }
    if what == 3 {
        return yes(have_mouse(state))
    }
    if what == 4 {
        return yes(msc_ready(state))
    }
    // RUNDE HOTPLUG-2: die Groesse des ERSTEN Sticks. Die Zahlen sind
    // eine Auskunft fuer den Schirm; wer einen bestimmten Stick meint,
    // fragt `blk.blocks_on(DEV_USB0 + n)`.
    if what == 5 {
        return msc_blocks(state)
    }
    if what == 6 {
        return msc_bsize(state)
    }
    if what == 7 {
        return g(state, S_KEYS)
    }
    if what == 8 {
        return g(state, S_REPORTS)
    }
    if what == 9 {
        return g(state, S_MOVES)
    }
    if what == 10 {
        return xhci.events(state)
    }
    if what == 11 {
        return xhci.irqs(state)
    }
    if what == 12 {
        return g(state, S_ENUMS)
    }
    if what == 13 {
        return g(state, S_UNPLUGS)
    }
    if what == 14 {
        return g(state, S_HOTPLUGS)
    }
    if what == 15 {
        return g(state, S_MSCIO)
    }
    if what == 16 {
        return g(state, S_MSCERR)
    }
    if what == 17 {
        return xhci.errors(state)
    }
    if what == 18 {
        return xhci.ports(state)
    }
    if what == 19 {
        return xhci.slots(state)
    }
    if what == 20 {
        return xhci.ctx_size(state)
    }
    if what == 21 {
        return xhci.cmds(state)
    }
    if what == 22 {
        return selftest(state)
    }
    if what == 23 {
        return g(state, S_FAILS)
    }
    return 0
}

// Der Selbsttest dieser Schicht: Zusagen, die sie ueber sich selbst
// machen kann, ohne dass ein Testlaeufer sie ihr vorsagt. Rueckgabe: wie
// viele davon halten.
fn selftest(state: u64) -> u64 {
    var n: u64 = 0
    if xhci.ready(state) {
        n = n + 1
    }
    if xhci.ports(state) > 0 && xhci.ports(state) < 256 {
        n = n + 1
    }
    if xhci.slots(state) > 0 {
        n = n + 1
    }
    if xhci.ctx_size(state) == 32 || xhci.ctx_size(state) == 64 {
        n = n + 1
    }
    if xhci.cmds(state) > 0 {
        n = n + 1
    }
    if xhci.events(state) >= xhci.cmds(state) {
        n = n + 1
    }
    if g(state, S_NDEV) <= MAX_DEV {
        n = n + 1
    }
    if xhci.errors(state) == 0 {
        n = n + 1
    }
    return n
}


// ####################################################################
// ############################################ RUNDE BLECHEINGABE
// ####################################################################
//
// DREI DINGE, DIE IN DIESEM BAUM NICHT VORHANDEN WAREN, und alle drei
// hat Justin durch Nachsehen im Quelltext gefunden, nicht durch Raten:
//
//   1. `grep -i hub kernel/usb.fi kernel/xhci.fi` -> NULL TREFFER.
//      Der Kern sah ausschliesslich Geraete an einem WURZELANSCHLUSS.
//   2. `grep 'SET_REPORT|LED|numlock' kernel/` -> NULL TREFFER.
//      Der Kern konnte eine Lampe an einer Tastatur nicht setzen.
//   3. Ein Geraet, das nicht passte, verschwand SPURLOS (`drop_dev`).
//      Auf dem Schirm stand "devices=0", und das ist keine Auskunft.

// ==================================================== DIE FUNDLISTE

fn fund_at(state: u64, i: u64) -> u64 {
    return state + FUND_OFF + i * FUND_BYTES
}

fn fg(state: u64, i: u64, off: u64) -> u64 {
    return kstate.get(fund_at(state, i), off)
}

fn fs(state: u64, i: u64, off: u64, v: u64) {
    kstate.set(fund_at(state, i), off, v)
}

fn found_new(state: u64, port: u64, hubport: u64, speed: u64) -> u64 {
    let n: u64 = g(state, S_FUNDN)
    if n >= MAX_FUND {
        return MAX_FUND - 1
    }
    zero(fund_at(state, n), FUND_BYTES)
    fs(state, n, F_USED, 1)
    fs(state, n, F_PORT, (port & 0xFF) | ((hubport & 0xFF) << 8))
    fs(state, n, F_SPEED, speed)
    s(state, S_FUNDN, n + 1)
    return n
}

fn fund_flag(state: u64, i: u64, bit: u64) {
    if i < MAX_FUND {
        fs(state, i, F_FLAGS, fg(state, i, F_FLAGS) | bit)
    }
}

fn fund_id(state: u64, i: u64, vid: u64, pid: u64) {
    if i < MAX_FUND {
        fs(state, i, F_ID, ((vid & 0xFFFF) << 16) | (pid & 0xFFFF))
    }
}

fn fund_dev_class(state: u64, i: u64, c: u64, u: u64, pr: u64) {
    if i < MAX_FUND {
        fs(state, i, F_DCLS, ((c & 0xFF) << 16) | ((u & 0xFF) << 8) | (pr & 0xFF))
    }
}

fn fund_if_class(state: u64, i: u64, c: u64, u: u64, pr: u64) {
    if i < MAX_FUND {
        fs(state, i, F_ICLS, ((c & 0xFF) << 16) | ((u & 0xFF) << 8) | (pr & 0xFF))
    }
}

fn fund_driver_set(state: u64, i: u64, k: u64) {
    if k != 0 {
        usbdiag.bound()
    }
    if i < MAX_FUND {
        fs(state, i, F_FLAGS, (fg(state, i, F_FLAGS) & 0xFF) | (k << 8))
    }
}

// Wurde KEINE Schnittstelle genommen, steht die ERSTE auf dem Schirm --
// sonst waere die Zeile leer, und "leer" ist genau die Auskunft, die
// nicht weiterhilft. `Klasse 09` an dieser Stelle heisst: dort sitzt ein
// Hub, den dieser Kern nicht bedient.
fn first_iface(state: u64, i: u64, buf: u64, total: u64) {
    var at: u64 = 0
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        // TOCTOU audit F-05: a descriptor must lie inside the buffer (bLength is chosen by the device)
        if len < 2 || at + len > total {
            at = total
        } else {
            if b8(buf, at + 1) == 4 && len >= 9 {
                fund_if_class(state, i, b8(buf, at + 5), b8(buf, at + 6),
                    b8(buf, at + 7))
                at = total
            } else {
                at = at + len
            }
        }
    }
}

fn fund_count(state: u64) -> u64 {
    return g(state, S_FUNDN)
}

fn fund_port(state: u64, i: u64) -> u64 {
    return fg(state, i, F_PORT) & 0xFF
}

fn fund_hub(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_PORT) >> 8) & 0xFF
}

fn fund_speed(state: u64, i: u64) -> u64 {
    return fg(state, i, F_SPEED)
}

fn fund_vid(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_ID) >> 16) & 0xFFFF
}

fn fund_pid(state: u64, i: u64) -> u64 {
    return fg(state, i, F_ID) & 0xFFFF
}

fn fund_dcls(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_DCLS) >> 16) & 0xFF
}

fn fund_dsub(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_DCLS) >> 8) & 0xFF
}

fn fund_dpro(state: u64, i: u64) -> u64 {
    return fg(state, i, F_DCLS) & 0xFF
}

fn fund_icls(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_ICLS) >> 16) & 0xFF
}

fn fund_isub(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_ICLS) >> 8) & 0xFF
}

fn fund_ipro(state: u64, i: u64) -> u64 {
    return fg(state, i, F_ICLS) & 0xFF
}

fn fund_ifaces(state: u64, i: u64) -> u64 {
    return fg(state, i, F_IFACES)
}

fn fund_flags(state: u64, i: u64) -> u64 {
    return fg(state, i, F_FLAGS) & 0xFF
}

fn fund_driver(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_FLAGS) >> 8) & 0xFF
}

fn hubs(state: u64) -> u64 {
    return g(state, S_HUBS)
}

fn hubports(state: u64) -> u64 {
    return g(state, S_HUBPORTS)
}

fn fails(state: u64) -> u64 {
    return g(state, S_FAILS)
}

fn attached_map(state: u64) -> u64 {
    return g(state, S_ATTACHED)
}

fn pending(state: u64) -> u64 {
    return g(state, S_PENDN)
}

// ============================================ DIE LAMPEN DER TASTATUR
//
// SET_REPORT, Ausgabebericht: bmRequestType 0x21 (Wirt an Geraet,
// KLASSE, Empfaenger SCHNITTSTELLE), bRequest 0x09, wValue
// (2 << 8) | ReportID 0, wIndex = die Schnittstellennummer, ein Oktett
// Nutzlast: Bit 0 Nummernfeststell, Bit 1 Feststell, Bit 2 Rollen.
//
// DAS IST JUSTINS PRUEFSTEIN: druecken, Lampe wechselt -- dann steht
// die ganze Kette Tastatur -> Regler -> Kern -> Regler -> Tastatur.
// Bleibt sie stehen, weiss man, dass sie NICHT steht, und das ist mehr
// als bisher.
fn set_leds(state: u64, mask: u64) -> bool {
    let k: u64 = g(state, S_KBD)
    if k == 0 {
        return false
    }
    let d: u64 = k - 1
    if dg(state, d, D_USED) == 0 {
        return false
    }
    // RUNDE BLECHZWEI: NICHT ZWEIMAL GLEICHZEITIG AUF DENSELBEN RING.
    //
    // `herz_leds` kommt aus dem Zeitgeberbehandler, `led_service` aus
    // der Meldung des Geraets und aus `usb.poll` in der
    // Schreibtischschleife. Beide legen Bloecke auf den
    // Steuerungsendpunkt DESSELBEN Steckplatzes. Faellt die
    // Unterbrechung einer laufenden Uebertragung ins Wort, warten
    // danach beide auf eine Meldung, die nur einmal kommt -- und beide
    // zaehlen einen Fehlschlag.
    if g(state, S_LEDBUSY) != 0 {
        return false
    }
    s(state, S_LEDBUSY, 1)
    s(state, S_LEDTRY, g(state, S_LEDTRY) + 1)
    let p: u64 = state + HUB_OFF
    kstate.set8(p, (mask & 7) as u8)
    let r: i64 = xhci.control(state, dg(state, d, D_SLOT), 0x21,
        REQ_SET_REPORT, (2 << 8), dg(state, d, D_IFACE), 1, p, false)
    s(state, S_LEDS, mask & 7)
    s(state, S_LEDBUSY, 0)
    if r < 0 {
        s(state, S_LEDBAD, g(state, S_LEDBAD) + 1)
        return false
    }
    s(state, S_LEDOK, g(state, S_LEDOK) + 1)
    return true
}

// Wie oft es VERSUCHT wurde, und ob es ueberhaupt eine Tastatur gibt.
// `LED 0` allein ist zweideutig: keine Tastatur, oder Tastatur da und
// der Transfer scheitert. Zwei Zahlen, zwei Antworten.
fn leds_try(state: u64) -> u64 {
    return g(state, S_LEDTRY)
}

fn kbd_dev(state: u64) -> u64 {
    return g(state, S_KBD)
}

// Dasselbe fuer die Maus. Sie ist der FUNKTIONIERENDE Zweig auf
// Justins Brett und damit die Vergleichszahl: was bei ihr steht und
// bei der Tastatur nicht, ist der Unterschied.
fn mouse_dev(state: u64) -> u64 {
    return g(state, S_MOUSE)
}

// RUNDE BLECHFUENF: was EIN Geraet fuer sich gemeldet hat.
fn dev_reps(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_REPS)
}

fn dev_arms(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_ARMS)
}

fn dev_cc(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_LASTCC)
}

fn dev_dci(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_INTDCI)
}

fn dev_iface(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_IFACE)
}

fn dev_generic(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_GENERIC)
}

// EIN OKTETT DES ZULETZT EMPFANGENEN BERICHTS. Das ist die Zahl, die
// Justins Tastendruck sichtbar macht -- oder eben nicht.
fn dev_roh(state: u64, d: u64, k: u64) -> u64 {
    if d >= MAX_DEV || k >= 64 {
        return 0
    }
    return kstate.get8(report_buf(state, d) + k)
}

fn dev_errs(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_ERRS)
}

fn dev_heal(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_HEAL)
}

fn dev_slot(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_SLOT)
}

fn dev_intdci(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_INTDCI)
}

// Der Endpunktzustand, wie der REGLER ihn in den Geraetezusammenhang
// schreibt. 1 = laeuft, 2 = angehalten, 4 = Fehler, 0 = gar nicht da.
fn dev_epstate(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return xhci.ep_state(state, dg(state, d, D_SLOT), dg(state, d, D_INTDCI))
}

fn heilungen(state: u64) -> u64 {
    return g(state, S_HEAL)
}

fn without_space(state: u64) -> u64 {
    return g(state, S_NOPLATZ)
}

// ================================================== RUNDE BLECHDREI
// LAEUFT GERADE EINE AUFZAEHLUNG?
//
// Justins Brett meldete im vorigen Lauf `kbd=1 mouse=1` und im
// naechsten, mit demselben Kern, `kbd=0 mouse=0` -- ohne dass eine
// einzige Zeile am Aufzaehlen geaendert worden waere (der Unterschied
// zwischen bdc0d0f und f513165 an `usb.fi` sind 35 Zeilen, und alle
// betreffen die Lampen). Was sich geaendert hat, ist die ZEIT: seit der
// Runde HAENGER malt die Messtafel aus dem Zeitgeberbehandler, und seit
// BLECHZWEI haelt sie dabei `slot_remap` und `copy_words` unter
// `irq_save` zusammen. Auf einem gestreiften Rahmenpuffer (Justins
// 3060, 19,8 MB durch EIN 2-MiB-Fenster) sind das lange Fenster mit
// abgeschalteten Unterbrechungen -- mitten in `port_reset` und den
// Wartezeiten des Aufzaehlens.
//
// Also malt die Tafel nicht, solange aufgezaehlt wird. Sie hat danach
// den Rest der Laufzeit dafuer Zeit.
fn busy(state: u64) -> u64 {
    return g(state, S_BUSY)
}

// Hat eine Feststelltaste den Zustand umgelegt, geht er hinaus. Der
// Zustand liegt in `kbd.fi` -- der EINEN Stelle, durch die PS/2 und USB
// beide gehen; zwei Zustaende waeren zwei Wahrheiten.
fn led_service(state: u64) {
    if g(state, S_READY) == 0 || g(state, S_KBD) == 0 {
        return
    }
    if kbd.locks_dirty() == 0 {
        return
    }
    kbd.locks_clean()
    set_leds(state, kbd.locks(state) ^ (g(state, S_LEDHERZ) & 7))
}

fn leds_sent(state: u64) -> u64 {
    return g(state, S_LEDOK)
}

fn leds_fail(state: u64) -> u64 {
    return g(state, S_LEDBAD)
}

fn leds_last(state: u64) -> u64 {
    return g(state, S_LEDS)
}

// DER HERZSCHLAG AUF DER LAMPE. Aus dem Zeitgeberbehandler, einmal je
// Sekunde: die ROLLEN-Lampe wird ueber den Tastenzustand gelegt und
// wieder abgenommen. Blinkt sie, laeuft der Zeitgeber -- und das ist
// die Aussage, die weder Bildschirm noch serielle Leitung braucht.
//
// Der Tastenzustand bleibt dabei unberuehrt: gelegt wird mit `xor`,
// und was der Mensch mit Feststell und Nummernfeststell eingestellt
// hat, steht weiter in `kbd.fi`.
fn beat_leds(state: u64, an: u64) {
    if g(state, S_READY) == 0 || g(state, S_KBD) == 0 {
        return
    }
    var h: u64 = 0
    if an != 0 {
        h = kbd.LK_SCROLL
    }
    if h == g(state, S_LEDHERZ) {
        return
    }
    s(state, S_LEDHERZ, h)
    set_leds(state, kbd.locks(state) ^ h)
}

// ==================================================== DER HUB-TREIBER
//
// Ein Hub ist ein Geraet wie jedes andere -- bis auf eine Kleinigkeit:
// hinter ihm haengen weitere. Er beantwortet KLASSENANFRAGEN an sich
// selbst (bmRequestType 0xA0) und an seine Anschluesse (0xA3/0x23),
// und der Regler muss von ihm wissen, sonst schickt er die Pakete an
// den Hub statt durch ihn hindurch.
//
// DIE REIHENFOLGE, und keine Stufe laesst sich ueberspringen:
//   1. Hub-Deskriptor holen  -> wie viele Anschluesse, wie lange bis
//      Spannung steht (bPwrOn2PwrGood, in 2-ms-Schritten).
//   2. Dem REGLER sagen, dass dies ein Hub ist (Hub-Fahne und
//      Anschlusszahl im Steckplatzzusammenhang, `Configure Endpoint`).
//   3. Jeden Anschluss EINSCHALTEN und die angesagte Zeit warten.
//   4. Zustand lesen; wo etwas steckt: Ruecksetzen, Geschwindigkeit
//      ablesen, und das Geraet mit WEGWEISER am Regler anmelden.

fn hub_desc(state: u64, d: u64) -> bool {
    let p: u64 = state + HUB_OFF
    zero(p, 64)
    var art: u64 = D_HUB
    if dg(state, d, D_SPEED) >= 4 {
        art = D_HUB_SS
    }
    if xhci.control(state, dg(state, d, D_SLOT), 0xA0, REQ_GET_DESCRIPTOR,
        (art << 8), 0, 9, p, true) < 9 {
        return false
    }
    let n: u64 = b8(p, 2)
    if n == 0 || n > 15 {
        return false
    }
    ds(state, d, D_PORTS, n)
    return true
}

// Dem Regler sagen, dass hinter diesem Steckplatz ein Hub sitzt.
// `Configure Endpoint` mit NUR dem Steckplatzblock -- so macht es jeder
// Treiber, und `Evaluate Context` kann es laut xHCI 1.2, 4.6.7 nicht
// (das wertet nur Interrupter Target und Max Exit Latency aus).
fn hub_slot_update(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let sc: u64 = xhci.dev_slot_ctx(state, slot)
    let entries: u64 = (kstate.get32(sc) >> 27) & 0x1F
    build_slot(state, d, entries)
    let ic: u64 = xhci.in_control(state)
    wr32(ic, 0)
    wr32(ic + 4, 1) // nur der Steckplatzblock
    return xhci.configure_endpoint(state, slot) == xhci.CC_SUCCESS
}

fn hub_feature(state: u64, d: u64, setzen: bool, merkmal: u64,
    port: u64) -> bool {
    var req: u64 = REQ_CLEAR_FEATURE
    if setzen {
        req = REQ_SET_FEATURE
    }
    return xhci.control(state, dg(state, d, D_SLOT), 0x23, req,
        merkmal, port, 0, 0, false) >= 0
}

// wPortStatus in den unteren 16 Bit, wPortChange in den oberen.
const HUB_STATUS_ERR: u64 = 0xFFFFFFFFFFFFFFFF

fn hub_port_read(state: u64, d: u64, port: u64) -> u64 {
    let p: u64 = state + HUB_OFF + 32
    zero(p, 8)
    if xhci.control(state, dg(state, d, D_SLOT), 0xA3, REQ_GET_STATUS,
        0, port, 4, p, true) < 4 {
        return HUB_STATUS_ERR
    }
    return b16(p, 0) | (b16(p, 2) << 16)
}

fn hub_port_status(state: u64, d: u64, port: u64) -> u64 {
    let v: u64 = hub_port_read(state, d, port)
    if v == HUB_STATUS_ERR {
        return 0
    }
    return v
}

fn hub_child_at(state: u64, d: u64, p: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_DEV {
        if dg(state, i, D_USED) != 0 && dg(state, i, D_PARENT) == dg(state, d, D_SLOT)
            && dg(state, i, D_HUBPORT) == p {
            return i + 1
        }
        i = i + 1
    }
    return 0
}

fn hub_child_gone(state: u64, d: u64, p: u64) {
    let c: u64 = hub_child_at(state, d, p)
    if c == 0 {
        return
    }
    let child: u64 = c - 1
    let slot: u64 = dg(state, child, D_SLOT)
    let is_hub: bool = dg(state, child, D_DRIVER) == DRV_HUB
    unplug_dev(state, child)
    if is_hub {
        unplug_below(state, slot)
    }
}

// Aus dem Anschlusszustand die Geschwindigkeit, in der Zaehlweise des
// Reglers: 1 voll, 2 langsam, 3 hoch, 4 Super.
fn hub_speed(state: u64, d: u64, st: u64) -> u64 {
    if dg(state, d, D_SPEED) >= 4 {
        return 4
    }
    if (st & (1 << 10)) != 0 {
        return 3
    }
    if (st & (1 << 9)) != 0 {
        return 2
    }
    return 1
}

fn hub_port_reset(state: u64, d: u64, port: u64) -> bool {
    if !hub_feature(state, d, true, PF_RESET, port) {
        return false
    }
    var ms: u64 = 0
    var fertig: bool = false
    while ms < 800 {
        let st: u64 = hub_port_status(state, d, port)
        // C_PORT_RESET (Wechselbit 4) heisst: das Ruecksetzen ist durch.
        if (st & (1 << (16 + 4))) != 0 {
            fertig = true
            ms = 800
        } else {
            xhci.udelay(state, 1000)
            ms = ms + 1
        }
    }
    if !fertig {
        return false
    }
    hub_feature(state, d, false, PF_C_RESET, port)
    // Erholungszeit, USB 2.0, 7.1.7.5 (TRSTRCY = 10 ms).
    xhci.udelay(state, 20000)
    return (hub_port_status(state, d, port) & 2) != 0
}

fn hub_start(state: u64, d: u64) {
    var s_h: [u8; 12] = "usb: hub p=\0"
    var s_n: [u8; 8] = " ports=\0"
    var s_ok: [u8; 8] = " slot=\0\0"
    var s_bad: [u8; 21] = "usb: hub descr FEHLT\0"
    if !hub_desc(state, d) {
        serial.puts((&s_bad[0]) as u64)
        serial.nl()
        return
    }
    usbdiag.hub_seen(xhci.unit(state), dg(state, d, D_PORT), dg(state, d, D_PORTS))
    s(state, S_HUBS, g(state, S_HUBS) + 1)
    s(state, S_HUBPORTS, g(state, S_HUBPORTS) + dg(state, d, D_PORTS))
    let ok: bool = hub_slot_update(state, d)
    serial.puts((&s_h[0]) as u64)
    serial.dec(dg(state, d, D_PORT))
    serial.puts((&s_n[0]) as u64)
    serial.dec(dg(state, d, D_PORTS))
    serial.puts((&s_ok[0]) as u64)
    serial.dec(dg(state, d, D_SLOT))
    if !ok {
        var s_e: [u8; 12] = " CFG FEHLT\0\0"
        serial.puts((&s_e[0]) as u64)
    }
    serial.nl()
    hub_scan(state, d)
}

// DIE ANSCHLUESSE HINTER DEM HUB. Erst alle einschalten und WIRKLICH
// warten (der Hub sagt in bPwrOn2PwrGood selbst, wie lange), dann
// nachsehen. Wer sofort nachsieht, sieht nichts -- und genau daran ist
// die Vorrunde am Wurzelanschluss schon einmal gescheitert.
fn hub_scan(state: u64, d: u64) {
    let n: u64 = dg(state, d, D_PORTS)
    let p0: u64 = state + HUB_OFF
    var warten: u64 = b8(p0, 5) * 2000 // bPwrOn2PwrGood, 2-ms-Schritte
    if warten < 100000 {
        warten = 100000
    }
    if warten > 400000 {
        warten = 400000
    }
    var p: u64 = 1
    while p <= n {
        hub_feature(state, d, true, PF_POWER, p)
        p = p + 1
    }
    xhci.udelay(state, warten)
    p = 1
    while p <= n {
        let st: u64 = hub_port_status(state, d, p)
        let hidx: u64 = usbdiag.info(xhci.unit(state), usbdiag.I_HUBS) - 1
        usbdiag.hub_port(xhci.unit(state), hidx, p, st, 2)
        if (st & (1 << 16)) != 0 {
            hub_feature(state, d, false, PF_C_CONNECTION, p)
        }
        hub_probe_port(state, d, p, hidx, st)
        p = p + 1
    }
}

fn hub_probe_port(state: u64, d: u64, p: u64, hidx: u64, st: u64) -> bool {
    if (st & 1) == 0 {
        return false
    }
    xhci.udelay(state, 100000)
    let hrst: bool = hub_port_reset(state, d, p)
    var hrv: u64 = 0
    if hrst {
        hrv = 1
    }
    usbdiag.hub_port(xhci.unit(state), hidx, p, st, hrv)
    if !hrst {
        return false
    }
    let st2: u64 = hub_port_status(state, d, p)
    let sp: u64 = hub_speed(state, d, st2)
    var rt: u64 = dg(state, d, D_ROUTE)
    var schicht: u64 = 0
    while schicht < 5 && ((rt >> (schicht * 4)) & 0xF) != 0 {
        schicht = schicht + 1
    }
    var pn: u64 = p
    if pn > 15 {
        pn = 15
    }
    if schicht < 5 {
        rt = rt | (pn << (schicht * 4))
    }
    return attach_at(state, dg(state, d, D_PORT), rt, d, p, true, sp)
}

fn hub_child_present(state: u64, d: u64, p: u64) -> bool {
    var i: u64 = 0
    while i < MAX_DEV {
        if dg(state, i, D_USED) != 0 && dg(state, i, D_PARENT) == dg(state, d, D_SLOT)
            && dg(state, i, D_HUBPORT) == p {
            return true
        }
        i = i + 1
    }
    return false
}

fn hub_rescan(state: u64) {
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_DRIVER) == DRV_HUB {
            if dg(state, d, D_PORTS) == 0 {
                if g(state, S_HUBTRY) < HUB_TRY_MAX {
                    s(state, S_HUBTRY, g(state, S_HUBTRY) + 1)
                    hub_start(state, d)
                }
            } else {
                hub_rescan_ports(state, d)
            }
        }
        d = d + 1
    }
}

fn hub_rescan_ports(state: u64, d: u64) {
    let n: u64 = dg(state, d, D_PORTS)
    let hidx: u64 = usbdiag.info(xhci.unit(state), usbdiag.I_HUBS) - 1
    var p: u64 = 1
    while p <= n {
        if hub_child_present(state, d, p) {
            let live: u64 = hub_port_read(state, d, p)
            if live != HUB_STATUS_ERR && (live & 1) == 0 {
                if (live & (1 << 16)) != 0 {
                    hub_feature(state, d, false, PF_C_CONNECTION, p)
                }
                hub_child_gone(state, d, p)
            }
        }
        if !hub_child_present(state, d, p) && g(state, S_HUBTRY) < HUB_TRY_MAX {
            let st: u64 = hub_port_status(state, d, p)
            if (st & (1 << 16)) != 0 {
                hub_feature(state, d, false, PF_C_CONNECTION, p)
            }
            if (st & 1) != 0 {
                s(state, S_HUBTRY, g(state, S_HUBTRY) + 1)
                s(state, S_HUBHITS, g(state, S_HUBHITS) + 1)
                hub_probe_port(state, d, p, hidx, st)
            }
        }
        p = p + 1
    }
}

// ======================= DAS AUFZAEHLEN GEHOERT NICHT IN DEN ZEITGEBER
//
// HIER STAND EIN ECHTER FEHLER, und er erklaert ein eingefrorenes Bild
// besser als alles andere: `trap.fi` rief viermal je Sekunde
// `unplug_check` AUS DEM ZEITGEBERBEHANDLER -- mit abgeschalteten
// Unterbrechungen. Und `unplug_check` ruft `attach`, und `attach` ruft
// `xhci.port_reset`, und darin stehen `udelay(100000)`, eine Schleife
// von bis zu 500 ms und noch einmal `udelay(20000)`. Das sind
// ZEHNTELSEKUNDEN BIS SEKUNDEN IM ZEITGEBERBEHANDLER, in denen der
// Zeitgeber selbst nicht schlaegt, niemand geweckt wird und kein Bild
// mehr entsteht. Kommt ein Anschluss dabei nicht zur Ruhe, steht der
// Rechner endgueltig -- Uhr eingefroren, keine Eingabe, keine Tafel.
//
// Jetzt macht der Zeitgeber nur noch das, was ein
// Unterbrechungsbehandler darf: EIN Lesezugriff je Anschluss, das
// Wechselbit quittieren, den Anschluss vormerken. Die Arbeit selbst
// (Ruecksetzen, Deskriptoren, Hub) macht `hotplug_work` in der
// Schreibtischschleife, wo sie schlafen und dauern darf.
fn port_watch(state: u64) {
    if g(state, S_READY) == 0 || g(state, S_BUSY) != 0 {
        return
    }
    if kstate.mode_on(state, kstate.M_USBSAFE) {
        return
    }
    let n: u64 = xhci.ports(state)
    let due: u64 = usbdiag.timed_due(kstate.get(state, kstate.TICKS))
    if due != 0 {
        usbdiag_snap_all(state, xhci.unit(state), due)
    }
    var rescan: bool = usbdiag.rescan_due(kstate.get(state, kstate.TICKS))
    if kstate.mode_on(state, kstate.M_NOUSBRESCAN) {
        rescan = false
    }
    if rescan && g(state, S_HUBS) != 0 {
        s(state, S_HUBDUE, 1)
    }
    var p: u64 = 1
    while p <= n && p < 64 {
        if rescan && xhci.port_connected(state, p) && !was_there(state, p) {
            s(state, S_PEND, g(state, S_PEND) | (1 << p))
        }
        if xhci.port_has_change(state, p) {
            usbdiag.event(p, xhci.portsc(state, p))
            usbdiag.log(kstate.get(state, kstate.TICKS), usbdiag.LK_PSC, p, xhci.portsc(state, p))
            xhci.port_clear_changes(state, p)
            s(state, S_PEND, g(state, S_PEND) | (1 << p))
            s(state, S_PENDN, g(state, S_PENDN) + 1)
        }
        p = p + 1
    }
}

// ============================================== RUNDE ECHTHARDWARE-6
// DER WACHHUND FUER EINEN RING, DER STILL GEWORDEN IST.
//
// Der Fehler in `bind` erklaert, warum die Tafel das FALSCHE Geraet
// zeigte. Er erklaert nicht den zweiten, unabhaengigen Fall: ein
// Unterbrechungsblock liegt auf dem Ring, die Meldung dazu geht
// verloren (verlorene MSI, ein Regler, der nach dem Aufwachen keine
// mehr schickt), und dann wartet `service` auf eine Fertigmeldung, die
// nie kommt. Danach legt niemand mehr einen Block nach, denn genau das
// tut `service` -- der einzige Ort, an dem `arm` gerufen wird.
//
// Das ist eine SELBSTHALTENDE Stille: ein einziges verlorenes
// Ereignis legt die Tastatur fuer den Rest der Sitzung still, und von
// aussen sieht es aus wie `ARM n, BER n-1` bei laufendem Endpunkt.
// Genau dieses Zahlenbild stand auf Justins Foto.
//
// Der Wachhund haengt am selben Zeitgeber wie `port_watch` (alle 25
// Schlaege, also rund viermal je Sekunde bei 100 Hz). Er sieht nach,
// ob sich der Zaehler eines HID-Geraets seit dem letzten Blick bewegt
// hat. Bewegt er sich nicht, wird EINMAL nachgesehen (`xhci.drain` +
// `service`) -- das kostet nichts, wenn ohnehin nichts anliegt, und
// holt eine verlorene Meldung nach, wenn eine verloren ging.
//
// WICHTIG, UND DESHALB STEHT ES HIER: NICHT einfach `arm` rufen. Ein
// zweiter Block auf einem Ring, auf dem schon einer liegt, ist ein
// Fehler und kein Rueckfall -- deshalb geht der Weg ueber `service`,
// das den Ring liest und nur nachlegt, wenn wirklich etwas fertig
// wurde. Wer hier `arm` schriebe, bekaeme `ARM` ins Unendliche und
// haette den Fehler, den diese Runde beseitigt, nur verschoben.
fn silence_check(state: u64) {
    if g(state, S_READY) == 0 || g(state, S_BUSY) != 0 {
        return
    }
    var still: bool = false
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_INTDCI) != 0 {
            let jetzt: u64 = dg(state, d, D_REPS)
            if jetzt == dg(state, d, D_WACH) {
                still = true
            }
            ds(state, d, D_WACH, jetzt)
        }
        d = d + 1
    }
    if still {
        s(state, S_WACHN, g(state, S_WACHN) + 1)
        xhci.drain(state)
        service(state)
    }
    // ========================================== RUNDE ECHTHARDWARE-6
    // UND WENN AUCH DAS NICHTS HILFT: DEN ENDPUNKT NEU AUFSETZEN.
    //
    // Justins zweites Foto (15:39, nach 42 Minuten) zeigt
    // `USB BER 122651` -- die Tastatur lief. Beim Start davor stand
    // `BER 0`. Der Fehler ist also NICHT dauerhaft, sondern haengt am
    // Startablauf, und das ist schlimmer als ein harter Fehler: mal
    // geht sie, mal nicht.
    //
    // `drain`+`service` holt eine VERLORENE Meldung nach. Es hilft
    // nicht, wenn gar kein Block auf dem Ring liegt -- dann gibt es
    // nichts, was fertig werden koennte, und der Zaehler steht fuer
    // immer. Genau dieses Bild ist `ARM 1 BER 0` bei laufendem
    // Endpunkt.
    //
    // Deshalb die zweite Stufe: bleibt EIN Geraet mit
    // Unterbrechungsendpunkt WACH_GRENZE Blicke lang stumm (bei vier
    // Blicken je Sekunde sind das rund fuenf Sekunden), wird sein
    // Endpunkt einmal frisch bestueckt. `arm` ist hier richtig und
    // oben falsch: oben lag moeglicherweise noch ein Block, hier ist
    // seit fuenf Sekunden nachweislich nichts passiert.
    //
    // EINMAL, NICHT IMMER WIEDER: `D_WIEDER` zaehlt die Versuche je
    // Geraet und deckelt sie. Ein Ring, der sich nach drei Anlaeufen
    // nicht bewegt, ist kein Ring mehr, den man durch Klingeln
    // ueberzeugt -- dann ist die Zahl auf der Tafel die Auskunft.
    var e: u64 = 0
    while e < MAX_DEV {
        if dg(state, e, D_USED) != 0 && dg(state, e, D_INTDCI) != 0
            && dg(state, e, D_REPS) == 0 {
            ds(state, e, D_STUMM, dg(state, e, D_STUMM) + 1)
            if dg(state, e, D_STUMM) >= WACH_GRENZE
                && dg(state, e, D_AGAIN) < AGAIN_MAX {
                ds(state, e, D_AGAIN, dg(state, e, D_AGAIN) + 1)
                ds(state, e, D_STUMM, 0)
                s(state, S_WIEDERN, g(state, S_WIEDERN) + 1)
                // Der Endpunkt kann angehalten sein, ohne dass je ein
                // Transfer fertig wurde -- dann hat `service` den
                // Fehlercode nie gesehen. Also erst fragen, dann
                // wiederbeleben, dann neu bestuecken.
                if xhci.ep_halted(state, dg(state, e, D_SLOT),
                    dg(state, e, D_INTDCI)) {
                    unstall(state, e, dg(state, e, D_INTDCI))
                    ds(state, e, D_HEAL, dg(state, e, D_HEAL) + 1)
                    s(state, S_HEAL, g(state, S_HEAL) + 1)
                }
                let ix: u64 = xhci.ep_find(state, dg(state, e, D_SLOT),
                    dg(state, e, D_INTDCI))
                if ix < xhci.MAX_EP {
                    ds(state, e, D_SEQ, xhci.ep_seq(state, ix))
                }
                arm(state, e)
            }
        } else {
            ds(state, e, D_STUMM, 0)
        }
        e = e + 1
    }
}

// Wie oft ein stummer Endpunkt neu bestueckt wurde. Auf der Tafel
// steht die Zahl als `NEU` in Zeile 18 -- laeuft sie hoch und `BER`
// bleibt null, hat das Geraet wirklich nichts zu sagen; laeuft sie
// einmal hoch und `BER` steigt danach, hat die Wiederherstellung
// gegriffen.
fn wiedern(state: u64) -> u64 {
    return g(state, S_WIEDERN)
}

// Wie oft der Wachhund nachgesehen hat. Steht diese Zahl still und die
// Tastatur laeuft, hat er nie eingreifen muessen; laeuft sie hoch,
// waehrend `BER` steigt, holt er wirklich Meldungen nach.
fn wachen(state: u64) -> u64 {
    return g(state, S_WACHN)
}

// AUS DER SCHREIBTISCHSCHLEIFE, in Aufgabenkontext. Hier darf es dauern.
fn hotplug_work(state: u64) {
    if g(state, S_READY) == 0 || g(state, S_BUSY) != 0 {
        return
    }
    let offen: u64 = g(state, S_PEND)
    let hubdue: u64 = g(state, S_HUBDUE)
    if offen == 0 && hubdue == 0 {
        return
    }
    s(state, S_PEND, 0)
    s(state, S_HUBDUE, 0)
    if offen != 0 {
        chdiag.bump(state, chdiag.F_PASSES)
    }
    s(state, S_BUSY, 1)
    let n: u64 = xhci.ports(state)
    var p: u64 = 1
    while p <= n && p < 64 {
        if (offen & (1 << p)) != 0 {
            let jetzt: bool = xhci.port_connected(state, p)
            if was_there(state, p) && !jetzt {
                gone(state, p)
            } else if !was_there(state, p) && jetzt {
                s(state, S_HOTPLUGS, g(state, S_HOTPLUGS) + 1)
                mark(state, p)
                attach(state, p)
            }
        }
        p = p + 1
    }
    if hubdue != 0 {
        hub_rescan(state)
    }
    s(state, S_BUSY, 0)
}

// ===================================================== DD-12: AFTER S3
// The controller lost its state: set it up again and enumerate again --
// the same `versuch` the first start used on the controller it kept
// (keyboard, mouse, sticks come back as new devices). False if there was
// no controller up before.
fn resume(state: u64) -> bool {
    if !ready(state) {
        return false
    }
    let armed: bool = !kstate.mode_on(state, kstate.M_NOUSBIRQ)
    let _p: u64 = versuch(state, g(state, S_WAHL), armed)
    return ready(state)
}
