const USCAL_OFF: u64 = 0x51800
const UDEV_OFF: u64 = 0x51A00
const DEV_BYTES: u64 = 384
const MAX_DEV: u64 = 4

const FUND_OFF: u64 = 0x56700
const FUND_BYTES: u64 = 64
const MAX_FUND: u64 = 10

const F_USED: u64 = 0
const F_PORT: u64 = 8 // Wurzelanschluss | Hubanschluss << 8
const F_SPEED: u64 = 16
const F_ID: u64 = 24 // VID << 16 | PID
const F_DCLS: u64 = 32 // Geraeteklasse << 16 | Unterklasse << 8 | Protokoll
const F_ICLS: u64 = 40
const F_IFACES: u64 = 48
const F_FLAGS: u64 = 56

const F_ADDR: u64 = 1 // `Address Device` quittiert
const F_DESC: u64 = 2 // Geraetedeskriptor gelesen
const F_CFG: u64 = 4 // SET_CONFIGURATION quittiert
const F_BOUND: u64 = 8

const HUB_OFF: u64 = 0x56600

const DESC_OFF: u64 = 0x56000 // Deskriptoren, 512
const REPORT_OFF: u64 = 0x56200
const CBW_OFF: u64 = 0x56300 // der Befehlsblock, 64
const CSW_OFF: u64 = 0x56340 // die Quittung, 64
const BLK_OFF: u64 = 0x56400 // ein Datenblock, 512

const S_READY: u64 = 0x00
const S_NDEV: u64 = 0x08
const S_ENUMS: u64 = 0x10
const S_KBD: u64 = 0x18 // Platz + 1, 0 = keine
const S_MOUSE: u64 = 0x20
const S_TAG: u64 = 0x40
const S_REPORTS: u64 = 0x48
const S_KEYS: u64 = 0x50
const S_MOVES: u64 = 0x58
const S_UNPLUGS: u64 = 0x60
const S_HOTPLUGS: u64 = 0x68
const S_MSCERR: u64 = 0x70
const S_MSCIO: u64 = 0x78
const S_FAILS: u64 = 0x80
const S_ATTACHED: u64 = 0x88
const S_NOHID: u64 = 0x90
const S_NOMSC: u64 = 0x98
const S_LASTDATA: u64 = 0xA0
const S_GEN: u64 = 0xA8
const S_GENDEV: u64 = 0xB0
const S_RDFAIL: u64 = 0xB8
const S_RDLEN: u64 = 0xC0 // Oktette der zuletzt geholten Beschreibung
const S_BUSY: u64 = 0xC8
// RUNDE BLECHEINGABE.
const S_FUNDN: u64 = 0xF8 // Eintraege in der Fundliste
const S_HUBS: u64 = 0x100 // gefundene Hubs
const S_HUBPORTS: u64 = 0x108 // Anschluesse hinter allen Hubs zusammen
const S_LEDS: u64 = 0x110 // was zuletzt an die Tastatur ging
const S_LEDOK: u64 = 0x118 // erfolgreiche SET_REPORT
const S_LEDBAD: u64 = 0x120 // fehlgeschlagene
const S_PEND: u64 = 0x128
const S_HUBDUE: u64 = 0xD8
const S_HUBTRY: u64 = 0xE0
const S_HUBHITS: u64 = 0xE8
const HUB_TRY_MAX: u64 = 48
const S_PENDN: u64 = 0x130
const S_LEDHERZ: u64 = 0x138
const S_LEDTRY: u64 = 0x140
const S_LEDBUSY: u64 = 0x148
const S_HEAL: u64 = 0x150
const S_SVCBUSY: u64 = 0x158
const S_WACHN: u64 = 0x168
const S_WIEDERN: u64 = 0x170 // neu bestueckte stumme Endpunkte

const S_MSCGEN: u64 = 0x178
const S_MSCWEG: u64 = 0x180

const S_MSCTAB: u64 = 0x188
const MAX_MSC: u64 = 4
const S_NOPLATZ: u64 = 0x160

const S_PKT: u64 = 0xD0
const S_CHOICE: u64 = 0xF0 // welcher Regler behalten wurde
const MAX_HC_PKT: u64 = 4

const D_USED: u64 = 0
const D_SLOT: u64 = 8
const D_PORT: u64 = 16
const D_SPEED: u64 = 24
const D_VID: u64 = 32
const D_PID: u64 = 40
const D_CLASS: u64 = 48
const D_SUB: u64 = 56
const D_PROTO: u64 = 64
const D_DRIVER: u64 = 72
const D_INTDCI: u64 = 80
const D_INDCI: u64 = 88
const D_OUTDCI: u64 = 96
const D_INTLEN: u64 = 104
const D_SEQ: u64 = 112
const D_PREV: u64 = 120
const D_IFACE: u64 = 128
const D_CONFIG: u64 = 136
const D_MPS0: u64 = 144
const D_INTMPS: u64 = 152
const D_INTIVL: u64 = 160
const D_BULKMPS: u64 = 168
const D_RDLEN: u64 = 176
const D_GENERIC: u64 = 184
const D_ROUTE: u64 = 192
const D_PARENT: u64 = 200
const D_HUBPORT: u64 = 208 // Anschluss AN DIESEM Hub, 0 = Wurzel
const D_PORTS: u64 = 216
const D_IFACES: u64 = 224 // Schnittstellen der Konfiguration
const D_FUND: u64 = 232
const D_TTSLOT: u64 = 240
const D_TTPORT: u64 = 248
const D_REPS: u64 = 256 // fertige Unterbrechungstransfers dieses Geraets
const D_LASTCC: u64 = 264
const D_ARMS: u64 = 272
const D_ERRS: u64 = 280 // Transfers mit schlechtem Fertigmeldungscode
const D_HEAL: u64 = 288
const D_ROHW: u64 = 296
const D_ROHN: u64 = 304
const D_WACH: u64 = 312
const D_STUMM: u64 = 320
const D_AGAIN: u64 = 328

const D_MSCBLK: u64 = 336 // Bloecke dieses Massenspeichers
const D_MSCBS: u64 = 344 // Oktette je Block (immer 512, sonst abgelehnt)
const WATCH_LIMIT: u64 = 20
const AGAIN_MAX: u64 = 3

const DRV_NONE: u64 = 0
const DRV_KBD: u64 = 1
const DRV_MOUSE: u64 = 2
const DRV_MSC: u64 = 3
const DRV_HIDGEN: u64 = 4
const DRV_HUB: u64 = 5
// L-015: CDC-ECM network function (USB tethering, QEMU usb-net CDC config).
const DRV_ECM: u64 = 6
// r811: RNDIS network function (Android tethering, QEMU usb-net RNDIS configuration). Used ONLY when the device
// offers no CDC-ECM configuration (ECM is preferred), or when the kernel word `rndisonly` forces it (test gate).
const DRV_RNDIS: u64 = 7
const DRV_ISOTEST: u64 = 8
// r811: CDC-NCM network function (class 02/0D; many Android phones and every modern USB LAN dongle with NTB framing).
// Last resort like RNDIS (pass 2 of `configure`): ECM is preferred. No QEMU model exists: only the host gate
// tools/ncm covers the framing, the bring-up path is verified on real hardware.
const DRV_NCM: u64 = 9
// LW-1a: WCH CH336/CH339/CH396/CH397 USB Ethernet (vendor class FF/FF/FF, Justin's 1A86:5394 dongle). Taken only for
// the vendor/product ids lib/usbnet/ch397.fi `supported` lists; framing unverified on silicon.
const DRV_CH336: u64 = 10
// r1607: ASIX AX88772/772B (0B95:7720/772A/772B/7E2B): vendor-class function taken by id, bring-up in `ax88772_start`; unverified on silicon.
const DRV_AX88772: u64 = 11
const DRV_AX88179: u64 = 12
const DRV_RTL8153: u64 = 13
const DRV_BT: u64 = 14
const S_AXOK: u64 = 0x1D0 // 1 = a vendor-class interface may be picked in `wanted` (ASIX dongle)
// Scratch cells of the USB state page (inside the 0x200 bytes that `stage` clears).
const S_RNDISOK: u64 = 0x1E0 // 1 = RNDIS control interfaces may be picked in `wanted`
const S_NOECM: u64 = 0x1E8 // 1 = CDC-ECM is refused (word `rndisonly`)
// r813: isochronous test bed (word `isoctest`). One audio streaming alt setting is remembered here (packed, see `iso_data`).
const S_CHOK: u64 = 0x1D8 // 1 = a vendor-class FF/FF/FF interface may be picked in `wanted` (WCH dongle)
const S_ISOOK: u64 = 0x1F0 // 1 = the audio control interface may be picked in `wanted`
const S_CHDEV: u64 = 0x1B8 // device index + 1 of the WCH dongle (0 = none)
const S_CHRC: u64 = 0x1C0 // SET_CONFIGURATION result of the WCH dongle (signed)
const S_CHSTEP: u64 = 0x1C8 // bring-up step reached | result << 8 (1 ok, 2 failed)
const S_CHINT: u64 = 0x1A8 // interrupt endpoint of the WCH dongle: dci | mps << 8 | interval << 24
const S_CHSET: u64 = 0x1B0 // WCH dongle: bit0 SET_CONFIGURATION sent, bits 8-15 alt, bit16 alt scan used, bit17 SET_INTERFACE sent, bit18 failed, bits 24-31 error
const S_ISOA: u64 = 0x1F8 // dci | iface << 8 | alt << 16 | binterval << 24 | wMaxPacketSize << 32 (0 = none found)
const ISO_BUF_OFF: u64 = 0x56A00 // 8 packet buffers of 192 bytes (48 kHz, 16 bit, stereo, 1 ms)
const ISO_BUFS: u64 = 8
const ISO_PKT: u64 = 192
const ISO_TDS: u64 = 200
const CLS_CDC: u64 = 2
const D_NCFG: u64 = 352 // bNumConfigurations of the device descriptor
const D_MACSTR: u64 = 360 // ECM: string index of the MAC address
const D_DATAIF: u64 = 368 // ECM: number of the data interface (union descriptor)
const D_DATAALT: u64 = 376 // ECM: alternate setting that carries the bulk pipes

const REQ_GET_DESCRIPTOR: u64 = 6
const REQ_SET_CONFIGURATION: u64 = 9
const REQ_CLEAR_FEATURE: u64 = 1
const REQ_SET_FEATURE: u64 = 3
const REQ_GET_STATUS: u64 = 0
const REQ_SET_REPORT: u64 = 9
const D_DEVICE: u64 = 1
const D_CONFIGURATION: u64 = 2
const D_HUB: u64 = 0x29
const D_HUB_SS: u64 = 0x2A

const PF_ENABLE: u64 = 1
const PF_RESET: u64 = 4
const PF_POWER: u64 = 8
const PF_C_CONNECTION: u64 = 16
const PF_C_ENABLE: u64 = 17
const PF_C_RESET: u64 = 20

const CLS_HID: u64 = 3
const CLS_MSC: u64 = 8
const CLS_HUB: u64 = 9

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state + USCAL_OFF, off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state + USCAL_OFF, off, v)
}

fn dev_at(state: u64, i: u64) -> u64 {
    return state + UDEV_OFF + i * DEV_BYTES
}

fn dg(state: u64, i: u64, f: u64) -> u64 {
    return __mmio_read64((dev_at(state, i) + f) as *mut u64)
}

fn ds(state: u64, i: u64, f: u64, v: u64) {
    __mmio_write64((dev_at(state, i) + f) as *mut u64, v)
}

fn ready(state: u64) -> bool {
    return g(state, S_READY) != 0
}

fn count(state: u64) -> u64 {
    return g(state, S_NDEV)
}

fn keys(state: u64) -> u64 {
    return g(state, S_KEYS)
}

fn reports(state: u64) -> u64 {
    return g(state, S_REPORTS)
}

fn enums(state: u64) -> u64 {
    return g(state, S_ENUMS)
}

fn hotplugs(state: u64) -> u64 {
    return g(state, S_HOTPLUGS)
}

fn unplugs(state: u64) -> u64 {
    return g(state, S_UNPLUGS)
}

fn have_kbd(state: u64) -> bool {
    return g(state, S_KBD) != 0
}

fn have_mouse(state: u64) -> bool {
    return g(state, S_MOUSE) != 0
}

fn msc_errors(state: u64) -> u64 {
    return g(state, S_MSCERR)
}

fn msc_ios(state: u64) -> u64 {
    return g(state, S_MSCIO)
}

fn msc_gen(state: u64) -> u64 {
    return g(state, S_MSCGEN)
}

fn msc_gone(state: u64) -> u64 {
    return g(state, S_MSCWEG)
}

fn b8(p: u64, i: u64) -> u64 {
    return kstate.get8(p + i)
}

fn b16(p: u64, i: u64) -> u64 {
    return b8(p, i) | (b8(p, i + 1) << 8)
}

fn wr32(at: u64, v: u64) {
    __mmio_write32(at as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n / 8 {
        __mmio_write64((p + i * 8) as *mut u64, 0)
        i = i + 1
    }
}

fn yes(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

// -------------------------------------------------------- der Aufbau

fn stage(state: u64) {
    var s_skip: [u8; 13] = "usb: skipped\0"
    var s_no: [u8; 19] = "usb: no controller\0"
    var s_fail: [u8; 18] = "usb: init failed\0\0"
    var s_hc: [u8; 12] = "usb: xhci \0\0"
    var s_slots: [u8; 7] = "slots=\0"
    var s_ports: [u8; 9] = "  ports=\0"
    var s_ctx: [u8; 7] = "  ctx=\0"
    var s_msix: [u8; 7] = "  irq=\0"
    var s_off: [u8; 12] = "usb: nousb\0\0"

    if !kstate.mode_on(state, kstate.M_USB) {
        serial.puts((&s_skip[0]) as u64)
        serial.nl()
        return
    }
    zero(state + USCAL_OFF, 0x200)
    zero(state + UDEV_OFF, MAX_DEV * DEV_BYTES)
    if kstate.mode_on(state, kstate.M_NOHID) {
        s(state, S_NOHID, 1)
    }
    // r811: `rndisonly` forces the RNDIS configuration of a device that offers both (test bed of the RNDIS driver).
    if kstate.mode_on(state, kstate.M_USBRNDIS) {
        s(state, S_RNDISOK, 1)
        s(state, S_NOECM, 1)
    }
    // r813: `isoctest` lets the audio control interface through `wanted`.
    if kstate.mode_on(state, kstate.M_USBISOC) {
        s(state, S_ISOOK, 1)
    }
    if kstate.mode_on(state, kstate.M_HID)
        && !kstate.mode_on(state, kstate.M_NURBOOT) {
        s(state, S_GEN, 1)
    }
    hidin.stage(state)
    var s_rang: [u8; 15] = "usb: rang ok=\0\0"
    var s_von2: [u8; 4] = " / \0"
    serial.puts((&s_rang[0]) as u64)
    serial.dec(rangtest(state))
    serial.puts((&s_von2[0]) as u64)
    serial.dec(rangtest_max())
    serial.nl()
    if kstate.mode_on(state, kstate.M_NOMSC) {
        s(state, S_NOMSC, 1)
    }
    if kstate.mode_on(state, kstate.M_NOUSB) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    if !xhci.present(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    let armed: bool = !kstate.mode_on(state, kstate.M_NOUSBIRQ)
    // ================================= RUNDE BLECH-HID: JEDER REGLER
    chdiag.arm(state)
    usbdiag.reset_all()
    let cur_count: u64 = xhci.count_hc(state)
    var u: u64 = 0
    var bester: u64 = 0
    var bestp: u64 = 0
    while u < cur_count && u < MAX_HC_PKT {
        let p: u64 = versuch(state, u, armed)
        pkt_set(state, u, p)
        if p > bestp {
            bestp = p
            bester = u
        }
        u = u + 1
    }
    let last: u64 = cur_count - 1
    if cur_count > 0 && bester != last {
        let _again: u64 = versuch(state, bester, armed)
    }
    s(state, S_CHOICE, bester)
    usbdiag.set_choice(bester)
    usbdiag.set_t0(kstate.get(state, kstate.TICKS) + 1)
    var s_w1: [u8; 11] = "usb: wahl \0"
    var s_w2: [u8; 3] = "hc\0"
    var s_w3: [u8; 2] = "=\0"
    var s_w4: [u8; 6] = " -> h\0"
    var s_w5: [u8; 2] = "c\0"
    serial.puts((&s_w1[0]) as u64)
    var v: u64 = 0
    while v < cur_count && v < MAX_HC_PKT {
        serial.puts((&s_w2[0]) as u64)
        serial.dec(v)
        serial.puts((&s_w3[0]) as u64)
        serial.dec(pkt_get(state, v))
        serial.put(32 as u8)
        v = v + 1
    }
    serial.puts((&s_w4[0]) as u64)
    serial.puts((&s_w5[0]) as u64)
    serial.dec(bester)
    serial.nl()
}

fn usbdiag_snap_all(state: u64, h: u64, kind: u64) {
    let n: u64 = xhci.ports(state)
    var p: u64 = 1
    while p <= n && p <= usbdiag.MAX_PORT {
        usbdiag.snap(h, kind, p, xhci.portsc(state, p))
        p = p + 1
    }
}

fn usbdiag_open(state: u64, h: u64) {
    usbdiag.set_info(h, usbdiag.I_STATE, 1)
    usbdiag.set_info(h, usbdiag.I_PORTS, xhci.ports(state))
    usbdiag.set_info(h, usbdiag.I_SLOTS, xhci.slots(state))
    usbdiag.set_info(h, usbdiag.I_BDF, xhci.bdf(state))
    var p: u64 = 1
    while p <= xhci.ports(state) && p <= usbdiag.MAX_PORT {
        usbdiag.set_proto(h, p, xhci.port_major(state, p))
        p = p + 1
    }
    usbdiag_snap_all(state, h, usbdiag.SNAP_PRE)
}

fn usbdiag_close(state: u64, h: u64) {
    usbdiag_snap_all(state, h, usbdiag.SNAP_FINAL)
    usbdiag.set_info(h, usbdiag.I_STS, xhci.usbsts_raw(state))
    usbdiag.set_info(h, usbdiag.I_CMDS, xhci.cmds(state))
    usbdiag.set_info(h, usbdiag.I_EVENTS, xhci.events(state))
    usbdiag.set_info(h, usbdiag.I_ERRORS, xhci.errors(state))
    usbdiag.set_info(h, usbdiag.I_NDEV, g(state, S_NDEV))
    usbdiag.set_info(h, usbdiag.I_RESETFAIL, xhci.reset_fails(state))
    var pend: u64 = 0
    var p: u64 = 1
    while p <= xhci.ports(state) {
        if xhci.port_link_pending(state, p) {
            pend = pend + 1
        }
        p = p + 1
    }
    usbdiag.set_info(h, usbdiag.I_PENDING, pend)
}

fn versuch(state: u64, einheit: u64, armed: bool) -> u64 {
    var s_fail: [u8; 22] = "usb: init fehlt hc\0\0\0\0"
    var s_hc: [u8; 12] = "usb: xhci \0\0"
    var s_slots: [u8; 7] = "slots=\0"
    var s_ports: [u8; 9] = "  ports=\0"
    var s_ctx: [u8; 7] = "  ctx=\0"
    var s_msix: [u8; 7] = "  irq=\0"
    var s_hcn: [u8; 6] = "  hc=\0"
    xhci.teardown(state)
    chdiag.bump(state, chdiag.F_PASSES)
    chdiag.set64(state, chdiag.F_UNIT, einheit)
    usbdiag.begin_pass(einheit)
    s(state, S_READY, 0)
    zero(state + UDEV_OFF, MAX_DEV * DEV_BYTES)
    s(state, S_NDEV, 0)
    s(state, S_KBD, 0)
    s(state, S_MOUSE, 0)
    var mi: u64 = 0
    while mi < MAX_MSC {
        msc_slot_set(state, mi, 0)
        mi = mi + 1
    }
    s(state, S_ATTACHED, 0)
    if !xhci.init_at(state, einheit, armed) {
        usbdiag.set_info(einheit, usbdiag.I_STATE, 2)
        serial.puts((&s_fail[0]) as u64)
        serial.dec(einheit)
        serial.nl()
        return 0
    }
    serial.puts((&s_hc[0]) as u64)
    serial.puts((&s_slots[0]) as u64)
    serial.dec(xhci.slots(state))
    serial.puts((&s_ports[0]) as u64)
    serial.dec(xhci.ports(state))
    serial.puts((&s_ctx[0]) as u64)
    serial.dec(xhci.ctx_size(state))
    serial.puts((&s_msix[0]) as u64)
    serial.dec(yes(armed))
    serial.puts((&s_hcn[0]) as u64)
    serial.dec(einheit)
    serial.nl()
    s(state, S_READY, 1)
    usbdiag_open(state, einheit)
    scan(state)
    usbdiag_close(state, einheit)
    xhci.bericht(state)
    say(state)
    return points(state)
}

fn tr(state: u64, step: u64, v: u64) {
    usbdiag.step(step, v)
    if !kstate.mode_on(state, kstate.M_USBTRACE) {
        return
    }
    var t_hd: [u8; 9] = "usb: t \0\0"
    serial.puts((&t_hd[0]) as u64)
    serial.dec(step)
    serial.put(32 as u8)
    serial.dec(v)
    serial.nl()
}

// Diagnostic line for one input device: "usb: t probe <dev> st=<ep state> deq=<ctrl ring pos> enq=<our pos> ps=<portsc>".
static mut probe_n: u64 = 0

fn probe(state: u64) {
    if probe_n >= 12 || !kstate.mode_on(state, kstate.M_USBTRACE) {
        return
    }
    probe_n = probe_n + 1
    var t_p: [u8; 14] = "usb: t probe \0"
    var t_s: [u8; 5] = " st=\0"
    var t_d: [u8; 6] = " deq=\0"
    var t_e: [u8; 6] = " seq=\0"
    var t_c: [u8; 5] = " ps=\0"
    var t_x: [u8; 6] = " sts=\0"
    if g(state, S_READY) == 0 {
        return
    }
    var d: u64 = 0
    while d < 2 {
        let slot: u64 = dg(state, d, D_SLOT)
        let dci: u64 = dg(state, d, D_INTDCI)
        if slot != 0 && dci != 0 {
            let i: u64 = xhci.ep_find(state, slot, dci)
            serial.puts((&t_p[0]) as u64)
            serial.dec(d)
            serial.puts((&t_s[0]) as u64)
            serial.dec(xhci.ep_state(state, slot, dci))
            serial.puts((&t_d[0]) as u64)
            let dq: u64 = xhci.ep_deq(state, slot, dci) & 0xFFFFFFFE
            let rg: u64 = xhci.ep_ring(state, i)
            if dq >= rg {
                serial.dec(dq - rg)
            } else {
                serial.dec(99999)
            }
            serial.puts((&t_e[0]) as u64)
            serial.dec(xhci.ep_seq(state, i))
            serial.puts((&t_c[0]) as u64)
            serial.dec(xhci.portsc(state, dg(state, d, D_PORT)))
            serial.puts((&t_x[0]) as u64)
            serial.dec(xhci.usbsts(state))
            serial.nl()
        }
        d = d + 1
    }
}

fn scan(state: u64) {
    // ============================================= RUNDE BLECH-HID
    s(state, S_BUSY, 1)
    let n: u64 = xhci.ports(state)
    tr(state, 1, n)
    let _mit: u64 = xhci.power_all(state)
    tr(state, 2, _mit)
    usbdiag_snap_all(state, xhci.unit(state), usbdiag.SNAP_POWER)
    xhci.drain(state)
    var p: u64 = 1
    while p <= n {
        if xhci.port_link_pending(state, p) {
            let _up: bool = xhci.settle_usb3(state, p)
        }
        if xhci.port_connected(state, p) {
            tr(state, 3, p)
            mark(state, p)
            attach(state, p)
        }
        p = p + 1
    }
    var late: bool = false
    p = 1
    while p <= n {
        if xhci.port_link_pending(state, p) {
            late = true
        }
        p = p + 1
    }
    if g(state, S_NDEV) == 0 || late {
        tr(state, 14, 0)
        xhci.udelay(state, 300000)
        xhci.drain(state)
        p = 1
        while p <= n {
            if xhci.port_link_pending(state, p) {
                let _up2: bool = xhci.settle_usb3(state, p)
            }
            if xhci.port_connected(state, p) && !was_there(state, p) {
                tr(state, 3, p)
                mark(state, p)
                attach(state, p)
            }
            p = p + 1
        }
    }
    s(state, S_BUSY, 0)
    if kstate.mode_on(state, kstate.M_USBSTALL) {
        stall_test(state)
    }
}

// Word `usbstall`: send one control request the device must STALL (unknown standard request 0x7E), report whether endpoint 0 is
// left Halted, then send a valid request (SET_IDLE). A driver without the Halted recovery times out on the second one.
// Line: `usb: stalltest r1=<100+rc> halted=<0|1> r2=<100+rc>` -- good = r1 below 100, halted=0, r2 >= 100.
fn stall_test(state: u64) {
    var t_a: [u8; 19] = "usb: stalltest r1=\0"
    var t_b: [u8; 9] = " halted=\0"
    var t_c: [u8; 5] = " r2=\0"
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_SLOT) != 0 {
            let slot: u64 = dg(state, d, D_SLOT)
            let r1: i64 = xhci.control(state, slot, 0x00, 0x7E, 0, 0, 0, 0, false)
            var h: u64 = 0
            if xhci.ep_halted(state, slot, 1) {
                h = 1
            }
            let r2: i64 = xhci.control(state, slot, 0x21, 0x0A, 0, dg(state, d, D_IFACE), 0, 0, false)
            serial.puts((&t_a[0]) as u64)
            serial.dec((r1 + 100) as u64)
            serial.puts((&t_b[0]) as u64)
            serial.dec(h)
            serial.puts((&t_c[0]) as u64)
            serial.dec((r2 + 100) as u64)
            serial.nl()
            return
        }
        d = d + 1
    }
}

fn mark(state: u64, p: u64) {
    s(state, S_ATTACHED, g(state, S_ATTACHED) | (1 << (p & 63)))
}

fn unmark(state: u64, p: u64) {
    s(state, S_ATTACHED, g(state, S_ATTACHED) & (~(1 << (p & 63))))
}

fn was_there(state: u64, p: u64) -> bool {
    return (g(state, S_ATTACHED) & (1 << (p & 63))) != 0
}

fn alloc_dev(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_DEV {
        if dg(state, i, D_USED) == 0 {
            zero(dev_at(state, i), DEV_BYTES)
            ds(state, i, D_USED, 1)
            return i
        }
        i = i + 1
    }
    s(state, S_NOPLATZ, g(state, S_NOPLATZ) + 1)
    return MAX_DEV
}

fn mps0_of(speed: u64) -> u64 {
    if speed == 3 {
        return 64 // hohe Geschwindigkeit
    }
    if speed >= 4 {
        return 512 // Super und darueber
    }
    return 8
}

fn attach(state: u64, port: u64) -> bool {
    return attach_at(state, port, 0, MAX_DEV, 0, false, 0)
}

static mut q_usb: [u8; 4] = "usb\0"

fn lq() -> u64 {
    return (&q_usb[0]) as u64
}

fn slot_owned(state: u64, slot: u64) -> bool {
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_SLOT) == slot {
            return true
        }
        d = d + 1
    }
    return false
}

fn net_reclaim(state: u64) {
    let owner: u64 = usbnet.owner_slot(state)
    if owner != 0 && !slot_owned(state, owner) {
        usbnet.unplug_slot(state, owner)
    }
}

fn attach_at(state: u64, rootport: u64, route: u64, hubdev: u64,
    hubport: u64, mitspeed: bool, vorspeed: u64) -> bool {
    var l_rst: [u8; 21] = "port cannot be reset\0"
    var l_fresh: [u8; 31] = "device on the port, port/speed\0"

    var s_dev: [u8; 11] = "usb: port=\0"
    var s_sp: [u8; 8] = " speed=\0"
    var s_id: [u8; 5] = " id=\0"
    var s_cls: [u8; 8] = " class=\0"
    var s_drv: [u8; 9] = " driver=\0"
    var s_slot: [u8; 7] = " slot=\0"
    var s_rt: [u8; 8] = " route=\0"

    net_reclaim(state)
    usbdiag.set_cur(usbdiag.cur_hc(), rootport)
    var speed: u64 = vorspeed
    if !mitspeed {
        if !xhci.port_reset(state, rootport) {
            tr(state, 5, xhci.portsc(state, rootport))
            klog.sayn(state, klog.L_INFO, lq(), (&l_rst[0]) as u64,
                rootport)
            s(state, S_FAILS, g(state, S_FAILS) + 1)
            return false
        }
        speed = xhci.port_speed(state, rootport)
        tr(state, 4, speed)
    }
    let slot: u64 = xhci.slot_enable(state)
    if slot == 0 {
        tr(state, 7, xhci.last_rc_get())
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return false
    }
    let d: u64 = alloc_dev(state)
    if d >= MAX_DEV {
        xhci.slot_disable(state, slot)
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return false
    }
    ds(state, d, D_SLOT, slot)
    ds(state, d, D_PORT, rootport)
    ds(state, d, D_SPEED, speed)
    ds(state, d, D_MPS0, mps0_of(speed))
    ds(state, d, D_ROUTE, route)
    ds(state, d, D_HUBPORT, hubport)
    if hubdev < MAX_DEV {
        ds(state, d, D_PARENT, dg(state, hubdev, D_SLOT))
        if speed < 3 && dg(state, hubdev, D_SPEED) == 3 {
            ds(state, d, D_TTSLOT, dg(state, hubdev, D_SLOT))
            ds(state, d, D_TTPORT, hubport)
        } else {
            ds(state, d, D_TTSLOT, dg(state, hubdev, D_TTSLOT))
            ds(state, d, D_TTPORT, dg(state, hubdev, D_TTPORT))
        }
    }
    let f: u64 = found_new(state, rootport, hubport, speed)
    ds(state, d, D_FUND, f + 1)
    tr(state, 6, slot)

    if !address(state, d) {
        tr(state, 9, xhci.last_rc_get())
        drop_dev(state, d)
        return false
    }
    tr(state, 8, slot)
    fund_flag(state, f, F_ADDR)
    if !describe(state, d) {
        tr(state, 11, xhci.last_ctl_get())
        drop_dev(state, d)
        return false
    }
    tr(state, 10, slot)
    fund_flag(state, f, F_DESC)
    fund_id(state, f, dg(state, d, D_VID), dg(state, d, D_PID))
    let cfg_ok: bool = configure(state, d)
    chdiag.set_active(state, false)
    if !cfg_ok {
        tr(state, 13, xhci.last_ctl_get())
        drop_dev(state, d)
        return false
    }
    tr(state, 12, slot)
    fund_flag(state, f, F_CFG)
    s(state, S_ENUMS, g(state, S_ENUMS) + 1)
    s(state, S_NDEV, g(state, S_NDEV) + 1)

    // ==================================================== RUNDE HIDWEG
    bind(state, d)
    let ff: u64 = dg(state, d, D_FUND)
    if ff != 0 {
        fund_driver_set(state, ff - 1, dg(state, d, D_DRIVER))
        if dg(state, d, D_DRIVER) != DRV_NONE {
            fund_flag(state, ff - 1, F_BOUND)
        }
    }
    serial.puts((&s_dev[0]) as u64)
    serial.dec(rootport)
    serial.puts((&s_rt[0]) as u64)
    serial.dec(route)
    serial.puts((&s_sp[0]) as u64)
    serial.dec(speed)
    serial.puts((&s_slot[0]) as u64)
    serial.dec(slot)
    serial.puts((&s_id[0]) as u64)
    hex4(dg(state, d, D_VID))
    serial.put(58 as u8)
    hex4(dg(state, d, D_PID))
    serial.puts((&s_cls[0]) as u64)
    hex2(dg(state, d, D_CLASS))
    serial.put(58 as u8)
    hex2(dg(state, d, D_SUB))
    serial.put(58 as u8)
    hex2(dg(state, d, D_PROTO))
    serial.puts((&s_drv[0]) as u64)
    drv_name(dg(state, d, D_DRIVER))
    serial.nl()
    post_event(state, d, uevent.ACT_ADD)
    wlan_report(dg(state, d, D_VID), dg(state, d, D_PID))
    return true
}

//     usb: ... id=0bda:8812 cls=ff:ff:ff drv=none
//     wifi-usb: Realtek RTL8812AU (0bda:8812), kein Treiber
fn wlan_report(vid: u64, pid: u64) {
    if !usbchip.ist_wlan_stick(vid, pid) {
        return
    }
    var s_w: [u8; 11] = "wifi-usb: \0"
    var s_k: [u8; 16] = "), kein Treiber\0"
    var name: [u8; 32] = [0; 32]
    usbchip.name_get(vid, pid, (&name[0]) as u64)
    serial.puts((&s_w[0]) as u64)
    serial.puts((&name[0]) as u64)
    serial.put(32 as u8)
    serial.put(40 as u8)
    hex4(vid)
    serial.put(58 as u8)
    hex4(pid)
    serial.puts((&s_k[0]) as u64)
    serial.nl()
}

fn points(state: u64) -> u64 {
    var p: u64 = 0
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 {
            let k: u64 = dg(state, d, D_DRIVER)
            let boot: bool = dg(state, d, D_SUB) == 1
                && (dg(state, d, D_PROTO) == 1 || dg(state, d, D_PROTO) == 2)
            if k == DRV_KBD || k == DRV_MOUSE {
                if boot {
                    p = p + 8
                } else {
                    p = p + 3
                }
            } else if k == DRV_HIDGEN {
                p = p + 1
            } else if k == DRV_CH336 || k == DRV_ECM || k == DRV_NCM || k == DRV_RNDIS || k == DRV_AX88772
                || k == DRV_AX88179 || k == DRV_RTL8153 {
                p = p + 2
            }
        }
        d = d + 1
    }
    return p
}

fn pkt_get(state: u64, u: u64) -> u64 {
    if u >= MAX_HC_PKT {
        return 0
    }
    return g(state, S_PKT + u * 8)
}

fn pkt_set(state: u64, u: u64, v: u64) {
    if u < MAX_HC_PKT {
        s(state, S_PKT + u * 8, v)
    }
}

fn choice(state: u64) -> u64 {
    return g(state, S_CHOICE)
}

fn hex2(v: u64) {
    var i: u64 = 2
    while i > 0 {
        i = i - 1
        let x: u64 = (v >> (i * 4)) & 15
        if x < 10 {
            serial.put((48 + x) as u8)
        } else {
            serial.put((87 + x) as u8)
        }
    }
}

fn hex4(v: u64) {
    hex2(v >> 8)
    hex2(v & 0xFF)
}

fn drv_name(k: u64) {
    var s_k: [u8; 4] = "kbd\0"
    var s_m: [u8; 6] = "mouse\0"
    var s_s: [u8; 4] = "msc\0"
    var s_n: [u8; 5] = "none\0"
    var s_g: [u8; 7] = "hidgen\0"
    var s_h: [u8; 4] = "hub\0"
    var s_e: [u8; 4] = "ecm\0"
    var s_r: [u8; 6] = "rndis\0"
    var s_i: [u8; 5] = "isoc\0"
    var s_c: [u8; 4] = "ncm\0"
    var s_w: [u8; 6] = "ch336\0"
    var s_bt: [u8; 6] = "btusb\0"
    var s_ax: [u8; 8] = "ax88772\0"
    var s_a9: [u8; 8] = "ax88179\0"
    var s_rt: [u8; 8] = "rtl8153\0"
    if k == DRV_AX88179 {
        serial.puts((&s_a9[0]) as u64)
        return
    }
    if k == DRV_BT {
        serial.puts((&s_bt[0]) as u64)
        return
    }
    if k == DRV_RTL8153 {
        serial.puts((&s_rt[0]) as u64)
        return
    }
    if k == DRV_CH336 {
        serial.puts((&s_w[0]) as u64)
        return
    }
    if k == DRV_AX88772 {
        serial.puts((&s_ax[0]) as u64)
        return
    }
    if k == DRV_ISOTEST {
        serial.puts((&s_i[0]) as u64)
        return
    }
    if k == DRV_NCM {
        serial.puts((&s_c[0]) as u64)
        return
    }
    if k == DRV_ECM {
        serial.puts((&s_e[0]) as u64)
        return
    }
    if k == DRV_RNDIS {
        serial.puts((&s_r[0]) as u64)
        return
    }
    if k == DRV_KBD {
        serial.puts((&s_k[0]) as u64)
    } else if k == DRV_MOUSE {
        serial.puts((&s_m[0]) as u64)
    } else if k == DRV_MSC {
        serial.puts((&s_s[0]) as u64)
    } else if k == DRV_HIDGEN {
        serial.puts((&s_g[0]) as u64)
    } else if k == DRV_HUB {
        serial.puts((&s_h[0]) as u64)
    } else {
        serial.puts((&s_n[0]) as u64)
    }
}

fn address(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let dc: u64 = xhci.devctx(state, slot)
    zero(dc, 1024)
    xhci.dcbaa_set(state, slot, dc)
    let ep0: u64 = xhci.ep_open(state, slot, 1)
    if ep0 >= xhci.MAX_EP {
        return false
    }
    build_slot(state, d, 1)
    build_ep0(state, d, ep0)
    let ic: u64 = xhci.in_control(state)
    wr32(ic, 0) // nichts fallen lassen
    wr32(ic + 4, 3) // Steckplatz und Endpunkt 0 aufnehmen
    if xhci.address_device(state, slot, false) != xhci.CC_SUCCESS {
        return false
    }
    return true
}

fn build_slot(state: u64, d: u64, entries: u64) {
    let sc: u64 = xhci.in_slot(state)
    zero(sc, xhci.ctx_size(state))
    var dw0: u64 = (dg(state, d, D_ROUTE) & 0xFFFFF)
        | (dg(state, d, D_SPEED) << 20) | (entries << 27)
    if dg(state, d, D_DRIVER) == DRV_HUB {
        dw0 = dw0 | (1 << 26)
    }
    var dw1: u64 = (dg(state, d, D_PORT) & 0xFF) << 16
    if dg(state, d, D_DRIVER) == DRV_HUB {
        dw1 = dw1 | ((dg(state, d, D_PORTS) & 0xFF) << 24)
    }
    let dw2: u64 = (dg(state, d, D_TTSLOT) & 0xFF)
        | ((dg(state, d, D_TTPORT) & 0xFF) << 8)
    wr32(sc, dw0)
    wr32(sc + 4, dw1)
    wr32(sc + 8, dw2)
    wr32(sc + 12, 0)
}

fn build_ep0(state: u64, d: u64, i: u64) {
    let ec: u64 = xhci.in_ep(state, 1)
    zero(ec, xhci.ctx_size(state))
    wr32(ec, 0)
    wr32(ec + 4, (3 << 1) | (4 << 3) | (dg(state, d, D_MPS0) << 16))
    __mmio_write64((ec + 8) as *mut u64, xhci.ep_ring(state, i) | 1)
    wr32(ec + 16, 8)
}

fn describe(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let buf: u64 = state + DESC_OFF
    zero(buf, 64)
    if xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
        (D_DEVICE << 8), 0, 8, buf, true) < 8 {
        return false
    }
    let mps: u64 = b8(buf, 7)
    if mps >= 8 && mps != dg(state, d, D_MPS0) {
        ds(state, d, D_MPS0, mps)
        let ep0: u64 = xhci.ep_find(state, slot, 1)
        if ep0 < xhci.MAX_EP {
            build_ep0(state, d, ep0)
            let ic: u64 = xhci.in_control(state)
            wr32(ic, 0)
            wr32(ic + 4, 2)
            xhci.evaluate_context(state, slot)
        }
    }
    zero(buf, 64)
    if xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
        (D_DEVICE << 8), 0, 18, buf, true) < 18 {
        return false
    }
    ds(state, d, D_VID, b16(buf, 8))
    ds(state, d, D_PID, b16(buf, 10))
    ds(state, d, D_NCFG, b8(buf, 17))
    if ch397.supported(b16(buf, 8), b16(buf, 10)) {
        chdiag.note_device(state, buf,
            dg(state, d, D_SLOT) | (dg(state, d, D_SPEED) << 8) | (dg(state, d, D_ROUTE) << 16)
            | (dg(state, d, D_PORT) << 40) | (dg(state, d, D_HUBPORT) << 48),
            (b16(buf, 8) << 16) | b16(buf, 10))
    }
    let f: u64 = dg(state, d, D_FUND)
    if f != 0 {
        fund_dev_class(state, f - 1, b8(buf, 4), b8(buf, 5), b8(buf, 6))
    }
    return true
}

fn walk_configs(state: u64, d: u64, buf: u64) -> u64 {
    let slot: u64 = dg(state, d, D_SLOT)
    var ncfg: u64 = dg(state, d, D_NCFG)
    if ncfg < 1 {
        ncfg = 1
    }
    if ncfg > 4 {
        ncfg = 4
    }
    var total: u64 = 0
    var ci: u64 = 0
    while ci < ncfg {
        zero(buf, 512)
        if xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
            (D_CONFIGURATION << 8) | ci, 0, 9, buf, true) < 9 {
            return 0
        }
        total = b16(buf, 2)
        if total < 9 {
            return 0
        }
        if total > 512 {
            total = 512
        }
        ds(state, d, D_CONFIG, b8(buf, 5))
        ds(state, d, D_IFACES, b8(buf, 4))
        let f0: u64 = dg(state, d, D_FUND)
        if f0 != 0 {
            fs(state, f0 - 1, F_IFACES, b8(buf, 4))
        }
        zero(buf, 512)
        let got: i64 = xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
            (D_CONFIGURATION << 8) | ci, 0, total, buf, true)
        chdiag.note_config(state, ci, total, got as u64, buf)
        if got < (total as i64) {
            return 0
        }
        parse(state, d, buf, total)
        if dg(state, d, D_DRIVER) != DRV_NONE {
            ci = ncfg
        } else {
            ci = ci + 1
        }
    }
    return total
}

fn configure(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let buf: u64 = state + DESC_OFF
    // L-015: a device may offer several configurations (QEMU usb-net has RNDIS, CDC-ECM and Subset).
    // r811: first pass WITHOUT RNDIS (ECM is preferred); a second pass accepts RNDIS when nothing else matched.
    if ch397.supported(dg(state, d, D_VID), dg(state, d, D_PID)) {
        s(state, S_CHOK, 1)
    }
    let ax: bool = ax88772.supported(dg(state, d, D_VID), dg(state, d, D_PID))
    let vchip: u64 = usbvnic.chip_for(dg(state, d, D_VID), dg(state, d, D_PID))
    if ax || vchip != usbvnic.CHIP_NONE {
        s(state, S_AXOK, 1)
    }
    let noecm0: u64 = g(state, S_NOECM)
    let prefer_vendor: bool = ch397.supported(dg(state, d, D_VID), dg(state, d, D_PID)) || vchip != usbvnic.CHIP_NONE
    if prefer_vendor {
        s(state, S_NOECM, 1)
    }
    var total: u64 = walk_configs(state, d, buf)
    if prefer_vendor {
        s(state, S_NOECM, noecm0)
        if total != 0 && dg(state, d, D_DRIVER) == DRV_NONE {
            total = walk_configs(state, d, buf)
        }
    }
    s(state, S_CHOK, 0)
    s(state, S_AXOK, 0)
    if total == 0 {
        return false
    }
    if dg(state, d, D_DRIVER) == DRV_CH336 {
        ch_alt(state, d, buf, total)
        s(state, S_CHINT, dg(state, d, D_INTDCI) | (dg(state, d, D_INTMPS) << 8) | (dg(state, d, D_INTIVL) << 24))
        ds(state, d, D_INTDCI, 0)
        if ax {
            ds(state, d, D_DRIVER, DRV_AX88772)
        } else if vchip == usbvnic.CHIP_AX88179 {
            ds(state, d, D_DRIVER, DRV_AX88179)
        } else if vchip == usbvnic.CHIP_RTL8153 {
            ds(state, d, D_DRIVER, DRV_RTL8153)
        }
    }
    if dg(state, d, D_DRIVER) == DRV_NONE && g(state, S_RNDISOK) == 0 {
        s(state, S_RNDISOK, 1)
        total = walk_configs(state, d, buf)
        s(state, S_RNDISOK, 0)
        if total == 0 {
            return false
        }
    }
    if dg(state, d, D_DRIVER) == DRV_ECM {
        ecm_data(state, d, buf, total)
    }
    if dg(state, d, D_DRIVER) == DRV_RNDIS {
        rndis_data(state, d, buf, total)
    }
    if dg(state, d, D_DRIVER) == DRV_NCM {
        // NCM data interface = same layout as ECM: class 0A, bulk pipes in alternate setting >= 1.
        ecm_data(state, d, buf, total)
    }
    if dg(state, d, D_DRIVER) == DRV_ISOTEST {
        iso_data(state, d, buf, total)
    }
    let f1: u64 = dg(state, d, D_FUND)
    if f1 != 0 {
        if dg(state, d, D_DRIVER) != DRV_NONE {
            fund_if_class(state, f1 - 1, dg(state, d, D_CLASS),
                dg(state, d, D_SUB), dg(state, d, D_PROTO))
        } else {
            first_iface(state, f1 - 1, buf, total)
        }
    }
    if dg(state, d, D_DRIVER) == DRV_NONE {
        return false
    }
    if !endpoints(state, d) {
        return false
    }
    let src: i64 = xhci.control(state, slot, 0, REQ_SET_CONFIGURATION,
        dg(state, d, D_CONFIG), 0, 0, 0, false)
    if dg(state, d, D_DRIVER) == DRV_CH336 {
        s(state, S_CHSET, g(state, S_CHSET) | 1)
        s(state, S_CHRC, src as u64)
    }
    if src < 0 {
        return false
    }
    return true
}

const CH_INT_OPEN: u64 = 0x100000000
const CH_INT_FAILED: u64 = 0x200000000

fn ch_int_info(state: u64) -> u64 {
    let v: u64 = g(state, S_CHINT)
    if (v & CH_INT_OPEN) == 0 {
        return 0
    }
    return v & 0xFFFFFFFF
}

fn ch_int_wanted(state: u64, d: u64) -> bool {
    if dg(state, d, D_DRIVER) != DRV_CH336 || kstate.mode_on(state, kstate.M_NOCHINTR) {
        return false
    }
    let v: u64 = g(state, S_CHINT)
    if (v & CH_INT_FAILED) != 0 {
        return false
    }
    return (v & 255) != 0 && ((v >> 8) & 0xFFFF) != 0
}

const CH_ALT_SCAN: u64 = 0x10000
const CH_SETIF_SENT: u64 = 0x20000
const CH_SETIF_FAIL: u64 = 0x40000
const ALT_ANY_VENDOR: u64 = 0x100

fn alt_group_ok(mask: u64, cls: u64, iface: u64, want: u64) -> bool {
    if mask != 3 {
        return false
    }
    if want == ALT_ANY_VENDOR {
        return cls == 0xFF
    }
    return iface == want
}

fn alt_find(buf: u64, total: u64, want: u64) -> u64 {
    var at: u64 = 0
    var mask: u64 = 0
    var iface: u64 = 0
    var alt: u64 = 0
    var cls: u64 = 0
    var have: bool = false
    var found: u64 = 0
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        if len < 2 || at + len > total {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                if have && found == 0 && alt_group_ok(mask, cls, iface, want) {
                    found = iface | (alt << 8) | CH_ALT_SCAN
                }
                have = true
                mask = 0
                iface = b8(buf, at + 2)
                alt = b8(buf, at + 3)
                cls = b8(buf, at + 5)
            } else if kind == 5 && len >= 7 && have {
                if (b8(buf, at + 3) & 3) == 2 {
                    if (b8(buf, at + 2) & 0x80) != 0 {
                        mask = mask | 1
                    } else {
                        mask = mask | 2
                    }
                }
            }
            at = at + len
        }
    }
    if have && found == 0 && alt_group_ok(mask, cls, iface, want) {
        found = iface | (alt << 8) | CH_ALT_SCAN
    }
    return found
}

fn alt_take(state: u64, d: u64, buf: u64, total: u64, iface: u64, alt: u64) {
    ds(state, d, D_INTDCI, 0)
    ds(state, d, D_INDCI, 0)
    ds(state, d, D_OUTDCI, 0)
    var at: u64 = 0
    var mine: bool = false
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        if len < 2 || at + len > total {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                mine = b8(buf, at + 2) == iface && b8(buf, at + 3) == alt
            } else if kind == 5 && len >= 7 && mine {
                take_ep(state, d, buf, at)
            }
            at = at + len
        }
    }
}

fn ch_alt(state: u64, d: u64, buf: u64, total: u64) {
    s(state, S_CHSET, 0)
    ds(state, d, D_DATAALT, 0)
    if kstate.mode_on(state, kstate.M_NOCHALT) {
        return
    }
    if dg(state, d, D_INDCI) != 0 && dg(state, d, D_OUTDCI) != 0 {
        return
    }
    var found: u64 = alt_find(buf, total, dg(state, d, D_IFACE))
    if found == 0 {
        found = alt_find(buf, total, ALT_ANY_VENDOR)
    }
    if found == 0 {
        return
    }
    let iface: u64 = found & 0xFF
    let alt: u64 = (found >> 8) & 0xFF
    alt_take(state, d, buf, total, iface, alt)
    ds(state, d, D_IFACE, iface)
    ds(state, d, D_DATAALT, alt)
    s(state, S_CHSET, CH_ALT_SCAN | (alt << 8))
}

fn ch_set_interface(state: u64, d: u64, slot: u64) {
    if kstate.mode_on(state, kstate.M_NOSETIF) {
        return
    }
    let rc: i64 = xhci.control(state, slot, 0x01, 0x0B, dg(state, d, D_DATAALT),
        dg(state, d, D_IFACE), 0, 0, false)
    var v: u64 = g(state, S_CHSET) | CH_SETIF_SENT
    if rc < 0 {
        v = v | CH_SETIF_FAIL | (((0 - rc) as u64 & 0xFF) << 24)
    }
    s(state, S_CHSET, v)
    xhci.udelay(state, 10000)
}

const CK_PRESENT: u64 = 0
const CK_VID: u64 = 1
const CK_PID: u64 = 2
const CK_SPEED: u64 = 3
const CK_ROUTE: u64 = 4
const CK_NCFG: u64 = 5
const CK_CFG: u64 = 6
const CK_RC: u64 = 7
const CK_CLASS: u64 = 8
const CK_SUB: u64 = 9
const CK_PROTO: u64 = 10
const CK_IFACE: u64 = 11
const CK_INDCI: u64 = 12
const CK_OUTDCI: u64 = 13
const CK_INT: u64 = 14
const CK_BULKMPS: u64 = 15
const CK_STEP: u64 = 16
const CK_RESULT: u64 = 17
const CK_SET: u64 = 18
const CK_ALT: u64 = 19
const CK_ALTSCAN: u64 = 20
const CK_SETIF: u64 = 21
const CK_LIVE: u64 = 22

fn ch_diag(state: u64, key: u64) -> u64 {
    let dv: u64 = g(state, S_CHDEV)
    if key == CK_PRESENT { return dv }
    if dv == 0 { return 0 }
    let d: u64 = dv - 1
    if key == CK_VID { return dg(state, d, D_VID) }
    if key == CK_PID { return dg(state, d, D_PID) }
    if key == CK_SPEED { return dg(state, d, D_SPEED) }
    if key == CK_ROUTE { return dg(state, d, D_ROUTE) }
    if key == CK_NCFG { return dg(state, d, D_NCFG) }
    if key == CK_CFG { return dg(state, d, D_CONFIG) }
    if key == CK_RC { return g(state, S_CHRC) }
    if key == CK_CLASS { return dg(state, d, D_CLASS) }
    if key == CK_SUB { return dg(state, d, D_SUB) }
    if key == CK_PROTO { return dg(state, d, D_PROTO) }
    if key == CK_IFACE { return dg(state, d, D_IFACE) }
    if key == CK_INDCI { return dg(state, d, D_INDCI) }
    if key == CK_OUTDCI { return dg(state, d, D_OUTDCI) }
    if key == CK_INT { return g(state, S_CHINT) }
    if key == CK_BULKMPS { return dg(state, d, D_BULKMPS) }
    if key == CK_STEP { return g(state, S_CHSTEP) & 255 }
    if key == CK_RESULT { return (g(state, S_CHSTEP) >> 8) & 255 }
    if key == CK_SET { return g(state, S_CHSET) & 1 }
    if key == CK_ALT { return dg(state, d, D_DATAALT) }
    if key == CK_ALTSCAN { return (g(state, S_CHSET) >> 16) & 1 }
    if key == CK_LIVE {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_VID) != 0 { return 1 }
        return 2
    }
    if key == CK_SETIF {
        let v: u64 = g(state, S_CHSET)
        if (v & CH_SETIF_SENT) == 0 { return 0 }
        if (v & CH_SETIF_FAIL) == 0 { return 1 }
        return 2 + ((v >> 24) & 0xFF)
    }
    return 0
}

// ======================================================= RUNDE HIDWEG
//
// WELCHE SCHNITTSTELLE EINES GERAETS GENOMMEN WIRD.
fn iface_rang(state: u64, cls: u64, sub: u64, pro: u64) -> u64 {
    if !wanted(state, cls, sub, pro) {
        return 0
    }
    if cls == CLS_HUB {
        return 5
    }
    if cls == CLS_HID && sub == 1 && pro == 1 {
        return 4
    }
    if cls == CLS_HID && sub == 1 && pro == 2 {
        return 3
    }
    if cls == CLS_MSC {
        return 2
    }
    return 1
}

fn best_rang(state: u64, buf: u64, total: u64) -> u64 {
    var at: u64 = 0
    var best: u64 = 0
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        // TOCTOU audit F-05: a descriptor must lie inside the buffer (bLength is chosen by the device)
        if len < 2 || at + len > total {
            at = total
        } else {
            if b8(buf, at + 1) == 4 && len >= 9 && b8(buf, at + 3) == 0 {
                let r: u64 = iface_rang(state, b8(buf, at + 5),
                    b8(buf, at + 6), b8(buf, at + 7))
                if r > best {
                    best = r
                }
            }
            at = at + len
        }
    }
    return best
}

fn rangtest(state: u64) -> u64 {
    let buf: u64 = state + DESC_OFF
    zero(buf, 64)
    var i: u64 = 0
    var q: [u8; 59] = [
        9 as u8, 2 as u8, 59 as u8, 0 as u8, 2 as u8, 1 as u8, 0 as u8,
        0x80 as u8, 50 as u8,
        // Schnittstelle 0: HID, kein Boot-Protokoll
        9 as u8, 4 as u8, 0 as u8, 0 as u8, 1 as u8, 3 as u8, 0 as u8,
        0 as u8, 0 as u8,
        9 as u8, 0x21 as u8, 0x11 as u8, 1 as u8, 0 as u8, 1 as u8,
        0x22 as u8, 52 as u8, 0 as u8,
        7 as u8, 5 as u8, 0x81 as u8, 3 as u8, 8 as u8, 0 as u8, 10 as u8,
        // Schnittstelle 1: die Boot-Tastatur
        9 as u8, 4 as u8, 1 as u8, 0 as u8, 1 as u8, 3 as u8, 1 as u8,
        1 as u8, 0 as u8,
        9 as u8, 0x21 as u8, 0x11 as u8, 1 as u8, 0 as u8, 1 as u8,
        0x22 as u8, 63 as u8, 0 as u8,
        7 as u8, 5 as u8, 0x82 as u8, 3 as u8, 8 as u8, 0 as u8, 10 as u8
    ]
    while i < 59 {
        __mmio_write8((buf + i) as *mut u8, q[i as usize])
        i = i + 1
    }
    var n: u64 = 0
    if best_rang(state, buf, 59) == 4 {
        n = n + 1
    }
    if iface_rang(state, CLS_HID, 1, 2) == 3 {
        n = n + 1
    }
    if iface_rang(state, CLS_MSC, 6, 0x50) == 2 {
        n = n + 1
    }
    zero(state + UDEV_OFF, DEV_BYTES)
    parse(state, 0, buf, 59)
    if dg(state, 0, D_IFACE) == 1 {
        n = n + 1
    }
    if dg(state, 0, D_RDLEN) == 63 && dg(state, 0, D_PROTO) == 1 {
        n = n + 1
    }
    if dg(state, 0, D_INTDCI) == 5 {
        n = n + 1
    }
    zero(state + UDEV_OFF, DEV_BYTES)
    return n
}

fn rangtest_max() -> u64 {
    return 6
}

fn parse(state: u64, d: u64, buf: u64, total: u64) {
    var at: u64 = 0
    var mine: bool = false
    var picked: bool = false
    let target: u64 = best_rang(state, buf, total)
    if target == 0 {
        return
    }
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        // TOCTOU audit F-05: a descriptor must lie inside the buffer (bLength is chosen by the device)
        if len < 2 || at + len > total {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                mine = false
                if !picked && b8(buf, at + 3) == 0 {
                    let cls: u64 = b8(buf, at + 5)
                    let sub: u64 = b8(buf, at + 6)
                    let pro: u64 = b8(buf, at + 7)
                    if iface_rang(state, cls, sub, pro) == target {
                        ds(state, d, D_CLASS, cls)
                        ds(state, d, D_SUB, sub)
                        ds(state, d, D_PROTO, pro)
                        ds(state, d, D_IFACE, b8(buf, at + 2))
                        ds(state, d, D_DRIVER, driver_for(cls, sub, pro))
                        mine = true
                        picked = true
                    }
                }
            } else if kind == 0x21 && len >= 9 && mine {
                var k: u64 = 0
                let nd: u64 = b8(buf, at + 5)
                while k < nd && 6 + k * 3 + 2 < len {
                    if b8(buf, at + 6 + k * 3) == 0x22 {
                        ds(state, d, D_RDLEN, b16(buf, at + 7 + k * 3))
                        k = nd
                    } else {
                        k = k + 1
                    }
                }
            } else if kind == 0x24 && len >= 4 && mine {
                // CDC functional descriptors of the ECM control interface:
                // 0x06 union (slave interface = data interface), 0x0F
                // ethernet networking (MAC address string index).
                let sub: u64 = b8(buf, at + 2)
                if sub == 6 && len >= 5 {
                    ds(state, d, D_DATAIF, b8(buf, at + 4))
                }
                if sub == 0x0F && len >= 13 {
                    ds(state, d, D_MACSTR, b8(buf, at + 3))
                }
            } else if kind == 5 && len >= 7 && mine {
                take_ep(state, d, buf, at)
            }
            at = at + len
        }
    }
}

// ECM: the bulk pipes live in an ALTERNATE setting (>= 1) of the data
// interface, which `parse` skips. Find it, take its endpoints, and forget the
// notification endpoint of the control interface (not used by the driver).
fn ecm_data(state: u64, d: u64, buf: u64, total: u64) {
    ds(state, d, D_INTDCI, 0)
    ds(state, d, D_INDCI, 0)
    ds(state, d, D_OUTDCI, 0)
    var at: u64 = 0
    var mine: bool = false
    let dif: u64 = dg(state, d, D_DATAIF)
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        if len < 2 || at + len > total {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                mine = b8(buf, at + 2) == dif && b8(buf, at + 3) != 0
                    && b8(buf, at + 5) == 0x0A && dg(state, d, D_INDCI) == 0
                if mine {
                    ds(state, d, D_DATAALT, b8(buf, at + 3))
                }
            } else if kind == 5 && len >= 7 && mine {
                take_ep(state, d, buf, at)
            }
            at = at + len
        }
    }
}

fn wanted(state: u64, cls: u64, sub: u64, pro: u64) -> bool {
    if cls == CLS_HUB {
        return !kstate.mode_on(state, kstate.M_NOHUB)
    }
    if cls == CLS_HID {
        if g(state, S_NOHID) != 0 {
            return false
        }
        if sub == 1 && (pro == 1 || pro == 2) {
            return true
        }
        return g(state, S_GEN) != 0
    }
    if cls == CLS_MSC {
        if g(state, S_NOMSC) != 0 {
            return false
        }
        return sub == 6 && pro == 0x50
    }
    // r813: audio control interface (class 01, subclass 01), test bed only.
    if cls == 1 && sub == 1 {
        return g(state, S_ISOOK) != 0
    }
    if cls == CLS_CDC {
        if sub == 2 && pro == 0xFF {
            return g(state, S_RNDISOK) != 0
        }
        // r811: CDC-NCM (subclass 0D) is a last resort like RNDIS: only in pass 2.
        if sub == 0x0D {
            return g(state, S_RNDISOK) != 0
        }
        return sub == 6 && g(state, S_NOECM) == 0
    }
    if cls == 0xE0 && sub == 1 && pro == 1 {
        return true
    }
    // r811: RNDIS control interface of Android (E0/01/03) and of Windows-compatible gadgets (EF/04/01).
    if (cls == 0xE0 && sub == 1 && pro == 3) || (cls == 0xEF && sub == 4 && pro == 1) {
        return g(state, S_RNDISOK) != 0
    }
    if cls == 0xFF && g(state, S_AXOK) != 0 {
        return true
    }
    if cls == 0xFF && sub == 0xFF && pro == 0xFF {
        return g(state, S_CHOK) != 0
    }
    return false
}

fn driver_for(cls: u64, sub: u64, pro: u64) -> u64 {
    if cls == CLS_HUB {
        return DRV_HUB
    }
    if cls == CLS_HID && sub == 1 && pro == 1 {
        return DRV_KBD
    }
    if cls == CLS_HID && sub == 1 && pro == 2 {
        return DRV_MOUSE
    }
    if cls == CLS_HID {
        return DRV_HIDGEN
    }
    if cls == CLS_MSC {
        return DRV_MSC
    }
    if cls == 1 && sub == 1 {
        return DRV_ISOTEST
    }
    if cls == CLS_CDC && sub == 6 {
        return DRV_ECM
    }
    if cls == CLS_CDC && sub == 0x0D {
        return DRV_NCM
    }
    if (cls == CLS_CDC && sub == 2 && pro == 0xFF) || (cls == 0xE0 && sub == 1 && pro == 3)
        || (cls == 0xEF && sub == 4 && pro == 1) {
        return DRV_RNDIS
    }
    if cls == 0xE0 && sub == 1 && pro == 1 {
        return DRV_BT
    }
    if cls == 0xFF {
        return DRV_CH336
    }
    return DRV_NONE
}

fn take_ep(state: u64, d: u64, buf: u64, at: u64) {
    let addr: u64 = b8(buf, at + 2)
    let attrs: u64 = b8(buf, at + 3) & 3
    let mps: u64 = b16(buf, at + 4) & 0x7FF
    let ivl: u64 = b8(buf, at + 6)
    let num: u64 = addr & 0xF
    var dci: u64 = num * 2
    if (addr & 0x80) != 0 {
        dci = dci + 1
    }
    if attrs == 3 && (addr & 0x80) != 0 && dg(state, d, D_INTDCI) == 0 {
        ds(state, d, D_INTDCI, dci)
        ds(state, d, D_INTMPS, mps)
        ds(state, d, D_INTIVL, ivl)
        var want: u64 = mps
        if want > 64 {
            want = 64
        }
        ds(state, d, D_INTLEN, want)
        return
    }
    if attrs == 2 {
        ds(state, d, D_BULKMPS, mps)
        if (addr & 0x80) != 0 {
            if dg(state, d, D_INDCI) == 0 {
                ds(state, d, D_INDCI, dci)
            }
        } else {
            if dg(state, d, D_OUTDCI) == 0 {
                ds(state, d, D_OUTDCI, dci)
            }
        }
    }
}

fn build_ep(state: u64, dci: u64, art: u64, mps: u64, ivl: u64, ring: u64,
    avg: u64) {
    let ec: u64 = xhci.in_ep(state, dci)
    zero(ec, xhci.ctx_size(state))
    wr32(ec, ivl << 16)
    wr32(ec + 4, (3 << 1) | (art << 3) | (mps << 16))
    __mmio_write64((ec + 8) as *mut u64, ring | 1)
    var esit: u64 = 0
    if art == 7 {
        esit = mps << 16
    }
    wr32(ec + 16, avg | esit)
}

fn interval_of(speed: u64, binterval: u64) -> u64 {
    if speed >= 3 {
        if binterval == 0 {
            return 0
        }
        var v: u64 = binterval - 1
        if v > 15 {
            v = 15
        }
        return v
    }
    var ms: u64 = binterval
    if ms == 0 {
        ms = 1
    }
    var n: u64 = 3
    while n < 10 && (1 << (n - 3)) < ms {
        n = n + 1
    }
    return n
}

fn endpoints(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    var top: u64 = 1
    var add: u64 = 1
    let ic: u64 = xhci.in_control(state)
    zero(xhci.in_ep(state, 1), 31 * xhci.ctx_size(state))

    let idci: u64 = dg(state, d, D_INTDCI)
    if idci != 0 {
        let i: u64 = xhci.ep_open(state, slot, idci)
        if i >= xhci.MAX_EP {
            return false
        }
        build_ep(state, idci, 7, dg(state, d, D_INTMPS),
            interval_of(dg(state, d, D_SPEED), dg(state, d, D_INTIVL)),
            xhci.ep_ring(state, i), dg(state, d, D_INTMPS))
        add = add | (1 << idci)
        if idci > top {
            top = idci
        }
    }
    let indci: u64 = dg(state, d, D_INDCI)
    if indci != 0 {
        let i: u64 = xhci.ep_open(state, slot, indci)
        if i >= xhci.MAX_EP {
            return false
        }
        build_ep(state, indci, 6, dg(state, d, D_BULKMPS), 0,
            xhci.ep_ring(state, i), 512)
        add = add | (1 << indci)
        if indci > top {
            top = indci
        }
    }
    let outdci: u64 = dg(state, d, D_OUTDCI)
    if outdci != 0 {
        let i: u64 = xhci.ep_open(state, slot, outdci)
        if i >= xhci.MAX_EP {
            return false
        }
        build_ep(state, outdci, 2, dg(state, d, D_BULKMPS), 0,
            xhci.ep_ring(state, i), 512)
        add = add | (1 << outdci)
        if outdci > top {
            top = outdci
        }
    }
    // r813: the isochronous endpoint of the test driver.
    if dg(state, d, D_DRIVER) == DRV_ISOTEST && g(state, S_ISOA) != 0 {
        let a: u64 = g(state, S_ISOA)
        let adci: u64 = a & 0xFF
        let i: u64 = xhci.isoc_open(state, slot, adci, false, dg(state, d, D_SPEED),
            (a >> 32) & 0xFFFF, 0, 0, (a >> 24) & 0xFF)
        if i >= xhci.MAX_EP || !xhci.isoc_fill_ctx(state, slot, adci) {
            return false
        }
        add = add | (1 << adci)
        if adci > top {
            top = adci
        }
    }
    if ch_int_wanted(state, d) {
        let cv: u64 = g(state, S_CHINT)
        let cdci: u64 = cv & 255
        let ci: u64 = xhci.ep_open(state, slot, cdci)
        if ci < xhci.MAX_EP {
            let cmps: u64 = (cv >> 8) & 0xFFFF
            build_ep(state, cdci, 7, cmps, interval_of(dg(state, d, D_SPEED), (cv >> 24) & 255),
                xhci.ep_ring(state, ci), cmps)
            add = add | (1 << cdci)
            if cdci > top {
                top = cdci
            }
            s(state, S_CHINT, cv | CH_INT_OPEN)
        }
    }
    build_slot(state, d, top)
    wr32(ic, 0)
    wr32(ic + 4, add)
    let crc: u64 = xhci.configure_endpoint(state, slot)
    if crc != xhci.CC_SUCCESS && (g(state, S_CHINT) & CH_INT_OPEN) != 0 {
        s(state, S_CHINT, (g(state, S_CHINT) & 0xFFFFFFFF) | CH_INT_FAILED)
        return endpoints(state, d)
    }
    return crc == xhci.CC_SUCCESS
}

fn drop_dev(state: u64, d: u64) {
    let slot: u64 = dg(state, d, D_SLOT)
    if slot != 0 {
        xhci.forget_slot(state, slot)
        xhci.slot_disable(state, slot)
        xhci.dcbaa_set(state, slot, 0)
    }
    zero(dev_at(state, d), DEV_BYTES)
}

// ------------------------------------------------------- die Zuordnung

fn dev_suitable(state: u64, e: u64) -> bool {
    if e == 0 {
        return false
    }
    let d: u64 = e - 1
    if d >= MAX_DEV {
        return false
    }
    return dg(state, d, D_USED) != 0 && dg(state, d, D_INTDCI) != 0
}

fn kbd_suitable(state: u64) -> bool {
    return dev_suitable(state, g(state, S_KBD))
}

fn mouse_works(state: u64) -> bool {
    return dev_suitable(state, g(state, S_MOUSE))
}

fn bind(state: u64, d: u64) {
    let k: u64 = dg(state, d, D_DRIVER)
    if k == DRV_HIDGEN {
        hid_start(state, d)
        return
    }
    if k == DRV_KBD {
        hid_start(state, d)
        tr(state, 27, d)
        if !kbd_suitable(state) {
            s(state, S_KBD, d + 1)
        }
        return
    }
    if k == DRV_MOUSE {
        hid_start(state, d)
        if !mouse_works(state) {
            s(state, S_MOUSE, d + 1)
        }
        return
    }
    if k == DRV_MSC {
        if msc_start(state, d) {
            let mi: u64 = msc_alloc(state)
            if mi >= MAX_MSC {
                var s_voll: [u8; 27] = "usb: msc no free slot left\0"
                serial.puts((&s_voll[0]) as u64)
                serial.nl()
                return
            }
            msc_slot_set(state, mi, d + 1)
            s(state, S_MSCGEN, g(state, S_MSCGEN) + 1)
        }
        return
    }
    if k == DRV_HUB {
        hub_start(state, d)
        return
    }
    if k == DRV_ECM {
        ecm_start(state, d)
        return
    }
    if k == DRV_RNDIS {
        rndis_start(state, d)
        return
    }
    if k == DRV_NCM {
        ncm_start(state, d)
        return
    }
    if k == DRV_CH336 {
        ch336_start(state, d)
        return
    }
    if k == DRV_BT {
        bt_start(state, d)
        return
    }
    if k == DRV_AX88772 {
        ax88772_start(state, d)
        return
    }
    if k == DRV_AX88179 || k == DRV_RTL8153 {
        usbvnic.start(state, k - DRV_AX88772, dg(state, d, D_SLOT), dg(state, d, D_INDCI), dg(state, d, D_OUTDCI),
            dg(state, d, D_BULKMPS), dg(state, d, D_SPEED), state + DESC_OFF)
        return
    }
    if k == DRV_ISOTEST {
        iso_start(state, d)
    }
}

// ============================================================ r813: isoc test bed
//
// Scan the configuration for the first audio STREAMING interface (class 01,
// subclass 02) alternate setting >= 1 that has an isochronous OUT endpoint, and
// remember it packed in S_ISOA. QEMU `usb-audio` offers exactly that (alt 1,
// 192 bytes per 1 ms frame, full speed).
fn iso_data(state: u64, d: u64, buf: u64, total: u64) {
    s(state, S_ISOA, 0)
    var at: u64 = 0
    var iface: u64 = 0
    var alt: u64 = 0
    var mine: bool = false
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        if len < 2 || at + len > total {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                iface = b8(buf, at + 2)
                alt = b8(buf, at + 3)
                mine = b8(buf, at + 5) == 1 && b8(buf, at + 6) == 2 && alt != 0
                    && g(state, S_ISOA) == 0
            } else if kind == 5 && len >= 7 && mine {
                let addr: u64 = b8(buf, at + 2)
                if (b8(buf, at + 3) & 3) == 1 && (addr & 0x80) == 0 {
                    let dci: u64 = (addr & 0xF) * 2
                    s(state, S_ISOA, dci | (iface << 8) | (alt << 16)
                        | (b8(buf, at + 6) << 24) | (b16(buf, at + 4) << 32))
                    mine = false
                }
            }
            at = at + len
        }
    }
}

// Fill one packet buffer with a 1 kHz square wave (48 frames per period, 16 bit stereo).
fn iso_fill(state: u64, n: u64) {
    let p: u64 = state + ISO_BUF_OFF + (n % ISO_BUFS) * ISO_PKT
    var f: u64 = 0
    while f < 48 {
        var v: u64 = 0x1F40
        if f >= 24 {
            v = 0xE0C0
        }
        wr32(p + f * 4, v | (v << 16))
        f = f + 1
    }
}

// Select the streaming alt setting, then feed ISO_TDS TDs (one per frame) and
// count what the controller reports. One status line on the serial port.
fn iso_start(state: u64, d: u64) {
    var s_head: [u8; 16] = "usb: isoc alt=\0\0"
    var s_fail: [u8; 18] = "usb: isoc failed\0\0"
    var s_q: [u8; 9] = " queued=\0"
    var s_e: [u8; 9] = " events=\0"
    var s_b: [u8; 8] = " bytes=\0"
    var s_u: [u8; 8] = " under=\0"
    var s_m: [u8; 9] = " missed=\0"
    var s_x: [u8; 6] = " err=\0"
    var s_mps: [u8; 6] = " mps=\0"
    let slot: u64 = dg(state, d, D_SLOT)
    let a: u64 = g(state, S_ISOA)
    if a == 0 {
        serial.puts((&s_fail[0]) as u64)
        serial.nl()
        return
    }
    let dci: u64 = a & 0xFF
    if xhci.control(state, slot, 0x01, 0x0B, (a >> 16) & 0xFF, (a >> 8) & 0xFF,
        0, 0, false) < 0 {
        serial.puts((&s_fail[0]) as u64)
        serial.nl()
        return
    }
    var n: u64 = 0
    var spin: u64 = 0
    while n < ISO_BUFS {
        iso_fill(state, n)
        if xhci.isoc_queue(state, slot, dci, state + ISO_BUF_OFF + n * ISO_PKT, ISO_PKT) {
            n = n + 1
        } else {
            n = ISO_BUFS
        }
    }
    n = xhci.isoc_stat(state, slot, dci, xhci.ISO_QUEUED)
    while spin < 4000 && xhci.isoc_stat(state, slot, dci, xhci.ISO_EVENTS) < ISO_TDS {
        xhci.drain(state)
        while n < ISO_TDS && xhci.isoc_pending(state, slot, dci) < ISO_BUFS {
            iso_fill(state, n)
            if !xhci.isoc_queue(state, slot, dci, state + ISO_BUF_OFF + (n % ISO_BUFS) * ISO_PKT, ISO_PKT) {
                break
            }
            n = n + 1
        }
        xhci.udelay(state, 500)
        spin = spin + 1
    }
    xhci.drain(state)
    serial.puts((&s_head[0]) as u64)
    serial.dec((a >> 16) & 0xFF)
    serial.puts((&s_mps[0]) as u64)
    serial.dec((a >> 32) & 0x7FF)
    serial.puts((&s_q[0]) as u64)
    serial.dec(xhci.isoc_stat(state, slot, dci, xhci.ISO_QUEUED))
    serial.puts((&s_e[0]) as u64)
    serial.dec(xhci.isoc_stat(state, slot, dci, xhci.ISO_EVENTS))
    serial.puts((&s_b[0]) as u64)
    serial.dec(xhci.isoc_stat(state, slot, dci, xhci.ISO_BYTES))
    serial.puts((&s_u[0]) as u64)
    serial.dec(xhci.isoc_stat(state, slot, dci, xhci.ISO_UNDER))
    serial.puts((&s_m[0]) as u64)
    serial.dec(xhci.isoc_stat(state, slot, dci, xhci.ISO_MISSED))
    serial.puts((&s_x[0]) as u64)
    serial.dec(xhci.isoc_stat(state, slot, dci, xhci.ISO_ERR))
    serial.nl()
}

// L-015: bring a CDC-ECM function up. MAC from the string descriptor,
// SET_INTERFACE to the data alternate setting, then hand the slot and the
// bulk endpoints to the network driver.
fn ecm_start(state: u64, d: u64) {
    var s_ok: [u8; 17] = "usb: ecm mac=ok\0\0"
    var s_bad: [u8; 17] = "usb: ecm failed \0"
    var s_mac: [u8; 10] = "usb: ecm \0"
    let slot: u64 = dg(state, d, D_SLOT)
    let buf: u64 = state + DESC_OFF
    zero(buf, 64)
    let n: i64 = xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
        (3 << 8) | dg(state, d, D_MACSTR), 0x0409, 64, buf, true)
    var macb: u64 = state + DESC_OFF + 128
    zero(macb, 8)
    if n < 26 || dg(state, d, D_MACSTR) == 0
        || !rndis.cdc_mac_from_string(buf, n as u64, macb) {
        serial.puts((&s_bad[0]) as u64)
        serial.puts((&s_mac[0]) as u64)
        serial.nl()
        return
    }
    if xhci.control(state, slot, 0x01, 0x0B, dg(state, d, D_DATAALT),
        dg(state, d, D_DATAIF), 0, 0, false) < 0 {
        serial.puts((&s_bad[0]) as u64)
        serial.nl()
        return
    }
    var mac: u64 = 0
    var i: u64 = 0
    while i < 6 {
        mac = mac | (b8(macb, i) << (i * 8))
        i = i + 1
    }
    if !usbnet.attach(state, slot, dg(state, d, D_INDCI), dg(state, d, D_OUTDCI),
        dg(state, d, D_BULKMPS), mac) {
        serial.puts((&s_bad[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_mac[0]) as u64)
    hex2(mac & 0xFF)
    var k: u64 = 1
    while k < 6 {
        serial.put(58 as u8)
        hex2((mac >> (k * 8)) & 0xFF)
        k = k + 1
    }
    serial.nl()
}

// r811: RNDIS. The bulk pipes live in the DATA interface (class 0A), normally in alternate setting 0 (QEMU, Android);
// an alternate setting >= 1 is taken when that is where the pipes are. The data interface comes from the union
// descriptor, else it is the interface behind the control interface. The notification endpoint is not used
// (responses are fetched by polling GET_ENCAPSULATED_RESPONSE).
fn rndis_data(state: u64, d: u64, buf: u64, total: u64) {
    ds(state, d, D_INTDCI, 0)
    ds(state, d, D_INDCI, 0)
    ds(state, d, D_OUTDCI, 0)
    ds(state, d, D_DATAALT, 0)
    var dif: u64 = dg(state, d, D_DATAIF)
    if dif == 0 {
        dif = dg(state, d, D_IFACE) + 1
    }
    ds(state, d, D_DATAIF, dif)
    var at: u64 = 0
    var mine: bool = false
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        let kind: u64 = b8(buf, at + 1)
        if len < 2 || at + len > total {
            at = total
        } else {
            if kind == 4 && len >= 9 {
                mine = b8(buf, at + 2) == dif && b8(buf, at + 5) == 0x0A
                    && dg(state, d, D_INDCI) == 0 && b8(buf, at + 4) >= 2
                if mine {
                    ds(state, d, D_DATAALT, b8(buf, at + 3))
                }
            } else if kind == 5 && len >= 7 && mine {
                take_ep(state, d, buf, at)
            }
            at = at + len
        }
    }
}

// One RNDIS control exchange: SEND_ENCAPSULATED_COMMAND with `n` bytes at `cmd`, then poll
// GET_ENCAPSULATED_RESPONSE until the answer of type `want` (completion type) arrives. Indications and
// keepalives in between are skipped. Returns the answer length (0 = none/invalid); the answer is at `rsp`.
fn rndis_exchange(state: u64, d: u64, cmd: u64, n: u64, rsp: u64, want: u64) -> u64 {
    let slot: u64 = dg(state, d, D_SLOT)
    let iface: u64 = dg(state, d, D_IFACE)
    if xhci.control(state, slot, 0x21, 0x00, 0, iface, n, cmd, false) < 0 {
        return 0
    }
    var tries: u64 = 0
    while tries < 64 {
        zero(rsp, 128)
        let got: i64 = xhci.control(state, slot, 0xA1, 0x01, 0, iface, 128, rsp, true)
        if got >= 12 && rndis.msg_type(rsp, got as u64) == want {
            return rndis.msg_len(rsp, got as u64)
        }
        tries = tries + 1
    }
    return 0
}

// r811: bring an RNDIS function up: INITIALIZE, QUERY permanent MAC, SET packet filter, then hand the slot and
// the bulk pipes to the network driver (mode RNDIS).
fn rndis_start(state: u64, d: u64) {
    var s_bad: [u8; 19] = "usb: rndis failed \0"
    var s_mac: [u8; 12] = "usb: rndis \0"
    var s_step: [u8; 7] = "step=\0\0"
    let slot: u64 = dg(state, d, D_SLOT)
    let cmd: u64 = state + DESC_OFF
    let rsp: u64 = state + DESC_OFF + 192
    var step: u64 = 0
    zero(cmd, 160)
    var n: u64 = rndis.build_init(cmd, 1, 2048)
    var l: u64 = rndis_exchange(state, d, cmd, n, rsp, rndis.MSG_INIT_C)
    step = 1
    var ok: bool = l != 0 && rndis.init_c_ok(rsp, l)
    if ok {
        step = 2
        zero(cmd, 64)
        n = rndis.build_query(cmd, 2, rndis.OID_802_3_PERMANENT_ADDRESS)
        l = rndis_exchange(state, d, cmd, n, rsp, rndis.MSG_QUERY_C)
        ok = l != 0 && rndis.query_c_info_len(rsp, l) == 6
    }
    var mac: u64 = 0
    if ok {
        let off: u64 = rndis.query_c_info_off(rsp, l)
        var i: u64 = 0
        while i < 6 {
            mac = mac | (b8(rsp, off + i) << (i * 8))
            i = i + 1
        }
        step = 3
        zero(cmd, 64)
        n = rndis.build_set_filter(cmd, 3,
            rndis.FILTER_DIRECTED | rndis.FILTER_MULTICAST | rndis.FILTER_BROADCAST)
        l = rndis_exchange(state, d, cmd, n, rsp, rndis.MSG_SET_C)
        ok = l != 0 && rndis.msg_status(rsp, l) == rndis.STATUS_SUCCESS
    }
    if ok && dg(state, d, D_DATAALT) != 0 {
        step = 4
        ok = xhci.control(state, slot, 0x01, 0x0B, dg(state, d, D_DATAALT),
            dg(state, d, D_DATAIF), 0, 0, false) >= 0
    }
    if ok {
        step = 5
        ok = usbnet.attach_rndis(state, slot, dg(state, d, D_INDCI), dg(state, d, D_OUTDCI),
            dg(state, d, D_BULKMPS), mac, dg(state, d, D_IFACE))
    }
    if !ok {
        serial.puts((&s_bad[0]) as u64)
        serial.puts((&s_step[0]) as u64)
        serial.dec(step)
        serial.nl()
        return
    }
    serial.puts((&s_mac[0]) as u64)
    hex2(mac & 0xFF)
    var k: u64 = 1
    while k < 6 {
        serial.put(58 as u8)
        hex2((mac >> (k * 8)) & 0xFF)
        k = k + 1
    }
    serial.nl()
}

// LW-1a: bring a WCH CH336-family dongle up. Vendor control reads (lib/usbnet/ch397.fi: REQ_INFO, REQ_READ_REG)
// give the chip info and the MAC; the bulk pipes come from the interface descriptor (`parse`). HYPOTHESIS: the
// register map is from one out-of-tree driver and not yet confirmed on a real chip, so nothing is written to the chip.
// Serial lines: `usb: ch336 info=<8 octets>`, `usb: ch336 <mac>`, or `usb: ch336 failed step=N` (1 info, 2 mac, 3 attach).
fn bt_start(state: u64, d: u64) {
    let dci: u64 = dg(state, d, D_INTDCI)
    ds(state, d, D_INTDCI, 0)
    if dci == 0 {
        return
    }
    let _ok: bool = btusb.attach(state, dg(state, d, D_SLOT), dci)
}

fn ch336_start(state: u64, d: u64) {
    var s_bad: [u8; 18] = "usb: ch336 failed\0"
    var s_step: [u8; 7] = "step=\0\0"
    var s_inf: [u8; 17] = "usb: ch336 info=\0"
    var s_mac: [u8; 11] = "usb: ch336\0"
    let slot: u64 = dg(state, d, D_SLOT)
    let buf: u64 = state + DESC_OFF
    var step: u64 = 1
    s(state, S_CHDEV, d + 1)
    s(state, S_CHSTEP, 1)
    chdiag.bump(state, chdiag.F_STARTS)
    chdiag.set64(state, chdiag.F_START, dg(state, d, D_INDCI) | (dg(state, d, D_OUTDCI) << 8)
        | ((g(state, S_CHINT) & 255) << 16) | (dg(state, d, D_BULKMPS) << 24)
        | (dg(state, d, D_IFACE) << 40) | (dg(state, d, D_DATAALT) << 48) | (dg(state, d, D_CONFIG) << 56))
    chdiag.set64(state, chdiag.F_REC, (d + 1) | (slot << 8) | (dg(state, d, D_SPEED) << 16))
    ch_set_interface(state, d, slot)
    zero(buf, 64)
    var ok: bool = xhci.control(state, slot, 0xC0, ch397.REQ_INFO, 0, 0, 8, buf, true) >= 8
    xhci.udelay(state, 10000)
    var fwver: u64 = 0
    if ok {
        fwver = b8(buf, 2)
        serial.puts((&s_inf[0]) as u64)
        var k: u64 = 0
        while k < 8 {
            hex2(b8(buf, k))
            k = k + 1
        }
        serial.nl()
        step = 2
        s(state, S_CHSTEP, 2)
        zero(buf, 64)
        let lo: u64 = ch397.REG_MAC_L
        ok = xhci.control(state, slot, 0xC0, ch397.REQ_READ_REG, lo & 0xFFFF, lo >> 16, 4, buf, true) >= 4
        xhci.udelay(state, 10000)
        if ok {
            let hi: u64 = ch397.REG_MAC_H
            ok = xhci.control(state, slot, 0xC0, ch397.REQ_READ_REG, hi & 0xFFFF, hi >> 16, 2, buf + 8, true) >= 2
            xhci.udelay(state, 10000)
        }
    }
    var mac: u64 = 0
    if ok {
        var i: u64 = 0
        while i < 4 {
            mac = mac | (b8(buf, i) << (i * 8))
            i = i + 1
        }
        mac = mac | (b8(buf, 8) << 32) | (b8(buf, 9) << 40)
        ok = mac != 0 && (mac & 1) == 0
    }
    if ok {
        step = 3
        s(state, S_CHSTEP, 3)
        ok = usbnet.attach_ch336(state, slot, dg(state, d, D_INDCI), dg(state, d, D_OUTDCI),
            dg(state, d, D_BULKMPS), mac)
    }
    if ok {
        step = 4
        s(state, S_CHSTEP, 4)
        ok = usbnet.ch_bringup(state, fwver, ch_int_info(state))
    }
    if ok {
        s(state, S_CHSTEP, 4 | (1 << 8))
    } else {
        s(state, S_CHSTEP, step | (2 << 8))
    }
    if !ok {
        serial.puts((&s_bad[0]) as u64)
        serial.puts((&s_step[0]) as u64)
        serial.dec(step)
        serial.nl()
        return
    }
    serial.puts((&s_mac[0]) as u64)
    serial.put(32 as u8)
    hex2(mac & 0xFF)
    var q: u64 = 1
    while q < 6 {
        serial.put(58 as u8)
        hex2((mac >> (q * 8)) & 0xFF)
        q = q + 1
    }
    serial.nl()
}

fn ax_ctl(state: u64, slot: u64, bm: u64, req: u64, value: u64, index: u64, len: u64, buf: u64) -> i64 {
    return xhci.control(state, slot, bm, req, value, index, len, buf, bm >= 0x80)
}

fn ax_delay(state: u64, us: u64) {
    xhci.udelay(state, us)
}

// r1607: bring an ASIX AX88772/772B dongle up (lib/usbnet/ax88772_drv.fi sequence, host gate tools/ax88772drv with a fake device).
// Serial lines: `usb: ax88772 <mac>` or `usb: ax88772 failed step=N` (1 phy .. 8 rx on, 9 MAC implausible, 10 attach).
fn ax88772_start(state: u64, d: u64) {
    var s_bad: [u8; 20] = "usb: ax88772 failed\0"
    var s_step: [u8; 7] = "step=\0\0"
    var s_mac: [u8; 13] = "usb: ax88772\0"
    let slot: u64 = dg(state, d, D_SLOT)
    var step: u64 = 0
    let mac: u64 = ax88772_drv.bringup(state, slot, ax_ctl, ax_delay, state + DESC_OFF, &step)
    var ok: bool = mac != 0
    if ok {
        step = 10
        ok = usbnet.attach_ax88772(state, slot, dg(state, d, D_INDCI), dg(state, d, D_OUTDCI), dg(state, d, D_BULKMPS), mac)
    }
    if !ok {
        serial.puts((&s_bad[0]) as u64)
        serial.put(32 as u8)
        serial.puts((&s_step[0]) as u64)
        serial.dec(step)
        serial.nl()
        return
    }
    serial.puts((&s_mac[0]) as u64)
    serial.put(32 as u8)
    hex2(mac & 0xFF)
    var q: u64 = 1
    while q < 6 {
        serial.put(58 as u8)
        hex2((mac >> (q * 8)) & 0xFF)
        q = q + 1
    }
    serial.nl()
}

// r811: bring a CDC-NCM function up (NTB16, no CRC): MAC from the string descriptor, GET_NTB_PARAMETERS,
// SET_NTB_INPUT_SIZE (2048: the RX buffer of the network driver), SET_INTERFACE to the data alternate setting,
// then hand the slot, the bulk pipes and the device's TX framing rules to the network driver (mode NCM).
// Failure prints `usb: ncm failed step=N` (1 MAC, 2 parameters, 3 input size, 4 interface, 5 attach).
fn ncm_start(state: u64, d: u64) {
    var s_bad: [u8; 16] = "usb: ncm failed\0"
    var s_step: [u8; 7] = "step=\0\0"
    var s_mac: [u8; 9] = "usb: ncm\0"
    let slot: u64 = dg(state, d, D_SLOT)
    let iface: u64 = dg(state, d, D_IFACE)
    let buf: u64 = state + DESC_OFF
    var step: u64 = 1
    zero(buf, 64)
    let n: i64 = xhci.control(state, slot, 0x80, REQ_GET_DESCRIPTOR,
        (3 << 8) | dg(state, d, D_MACSTR), 0x0409, 64, buf, true)
    var macb: u64 = state + DESC_OFF + 128
    zero(macb, 8)
    var ok: bool = n >= 26 && dg(state, d, D_MACSTR) != 0
        && rndis.cdc_mac_from_string(buf, n as u64, macb)
    let par: u64 = state + DESC_OFF + 192
    if ok {
        step = 2
        zero(par, 32)
        let got: i64 = xhci.control(state, slot, ncm.REQT_GET, ncm.REQ_GET_NTB_PARAMETERS, 0, iface,
            ncm.PARAMS_LEN, par, true)
        ok = got >= 28 && ncm.params_ok(par, got as u64) && ncm.params_supports_ntb16(par)
    }
    if ok {
        step = 3
        // A device may refuse this request; its default input size could then exceed our buffer, which the
        // host controller truncates (babble error, counted and dropped) instead of overflowing.
        let sz: u64 = state + DESC_OFF + 160
        zero(sz, 8)
        let m: u64 = ncm.build_set_input_size(sz, 2048)
        xhci.control(state, slot, ncm.REQT_SET, ncm.REQ_SET_NTB_INPUT_SIZE, 0, iface, m, sz, false)
        step = 4
        ok = xhci.control(state, slot, 0x01, 0x0B, dg(state, d, D_DATAALT),
            dg(state, d, D_DATAIF), 0, 0, false) >= 0
    }
    var mac: u64 = 0
    if ok {
        step = 5
        var i: u64 = 0
        while i < 6 {
            mac = mac | (b8(macb, i) << (i * 8))
            i = i + 1
        }
        ok = usbnet.attach_ncm(state, slot, dg(state, d, D_INDCI), dg(state, d, D_OUTDCI),
            dg(state, d, D_BULKMPS), mac, ncm.params_out_div(par), ncm.params_out_rem(par),
            ncm.params_out_align(par), ncm.params_out_max(par))
    }
    if !ok {
        serial.puts((&s_bad[0]) as u64)
        serial.put(32 as u8)
        serial.puts((&s_step[0]) as u64)
        serial.dec(step)
        serial.nl()
        return
    }
    serial.puts((&s_mac[0]) as u64)
    serial.put(32 as u8)
    hex2(mac & 0xFF)
    var k: u64 = 1
    while k < 6 {
        serial.put(58 as u8)
        hex2((mac >> (k * 8)) & 0xFF)
        k = k + 1
    }
    serial.nl()
}

// ------------------------------------------------------------ HID

fn hid_start(state: u64, d: u64) {
    tr(state, 20, d)
    let slot: u64 = dg(state, d, D_SLOT)
    let iface: u64 = dg(state, d, D_IFACE)
    // RUNDE HID: ZUERST DIE BERICHTSBESCHREIBUNG VERSUCHEN.
    var generisch: bool = false
    if g(state, S_GEN) != 0 && d < hidrep.USB_DEV_MAX {
        generisch = hid_descriptor(state, d, slot, iface)
    }
    ds(state, d, D_GENERIC, 0)
    tr(state, 21, yes(generisch))
    if generisch {
        ds(state, d, D_GENERIC, 1)
        s(state, S_GENDEV, g(state, S_GENDEV) + 1)
        // SET_PROTOCOL 1 = Berichtsprotokoll.
        let r1: i64 = xhci.control(state, slot, 0x21, 0x0B, 1, iface, 0, 0, false)
        tr(state, 22, (r1 + 100) as u64)
        tr(state, 28, xhci.ep_code(state, xhci.ep_find(state, slot, 1)))
        let r2: i64 = xhci.control(state, slot, 0x21, 0x0A, 0, iface, 0, 0, false)
        tr(state, 23, (r2 + 100) as u64)
        hid_claim(state, d)
        tr(state, 24, dg(state, d, D_DRIVER))
        ds(state, d, D_PREV, 0)
        let i2: u64 = xhci.ep_find(state, slot, dg(state, d, D_INTDCI))
        if i2 < xhci.MAX_EP {
            ds(state, d, D_SEQ, xhci.ep_seq(state, i2))
            ring_fresh(d)
        }
        tr(state, 25, d)
        arm(state, d)
        tr(state, 26, d)
        return
    }
    if dg(state, d, D_DRIVER) == DRV_HIDGEN {
        ds(state, d, D_DRIVER, DRV_NONE)
        return
    }
    // SET_PROTOCOL 0 = Boot. Klasse, Schnittstelle, Wirt an Geraet.
    xhci.control(state, slot, 0x21, 0x0B, 0, iface, 0, 0, false)
    xhci.control(state, slot, 0x21, 0x0A, 0, iface, 0, 0, false)
    ds(state, d, D_PREV, 0)
    let i: u64 = xhci.ep_find(state, slot, dg(state, d, D_INTDCI))
    if i < xhci.MAX_EP {
        ds(state, d, D_SEQ, xhci.ep_seq(state, i))
        ring_fresh(d)
    }
    arm(state, d)
}

fn hid_descriptor(state: u64, d: u64, slot: u64, iface: u64) -> bool {
    let n: u64 = dg(state, d, D_RDLEN)
    if n == 0 || n > hidrep.RAW_MAX {
        s(state, S_RDFAIL, g(state, S_RDFAIL) + 1)
        return false
    }
    let dst: u64 = hidrep.raw_of(state, d)
    zero(dst, n)
    if xhci.control(state, slot, 0x81, REQ_GET_DESCRIPTOR,
        (0x22 << 8), iface, n, dst, true) < (n as i64) {
        s(state, S_RDFAIL, g(state, S_RDFAIL) + 1)
        return false
    }
    s(state, S_RDLEN, n)
    if hidrep.parse(state, d, dst, n) != hidrep.E_OK {
        s(state, S_RDFAIL, g(state, S_RDFAIL) + 1)
        return false
    }
    hidrep.say(state, d)
    let _q: u64 = inreg.register(d, quirk.B_USB, dg(state, d, D_VID), dg(state, d, D_PID))
    hid_set_modes(state, d, slot, iface)
    return true
}

fn hid_set_modes(state: u64, d: u64, slot: u64, iface: u64) {
    if (hidrep.kind(state, d) & (hidrep.K_PAD | hidrep.K_TOUCH)) == 0 {
        return
    }
    let n: u64 = hidmode.plan(state, d)
    let p: u64 = state + HUB_OFF + 0x60
    var i: u64 = 0
    while i < n {
        let rid: u64 = hidmode.rid_at(i)
        kstate.set8(p, rid as u8)
        let plen: u64 = hidmode.build(state, d, i, p + 1)
        if plen > 0 {
            let _r: i64 = xhci.control(state, slot, 0x21, REQ_SET_REPORT, inmode.usb_wvalue(rid), iface, plen + 1, p, false)
        }
        i = i + 1
    }
}

fn hid_claim(state: u64, d: u64) {
    let art: u64 = hidrep.kind(state, d)
    if (art & hidrep.K_KBD) != 0 {
        ds(state, d, D_DRIVER, DRV_KBD)
        if g(state, S_KBD) == 0 {
            s(state, S_KBD, d + 1)
        }
        return
    }
    if (art & (hidrep.K_MOUSE | hidrep.K_PAD | hidrep.K_TOUCH | hidrep.K_PEN)) != 0 {
        ds(state, d, D_DRIVER, DRV_MOUSE)
        if g(state, S_MOUSE) == 0 {
            s(state, S_MOUSE, d + 1)
        }
        return
    }
    ds(state, d, D_DRIVER, DRV_HIDGEN)
}

fn arm(state: u64, d: u64) {
    ds(state, d, D_ARMS, dg(state, d, D_ARMS) + 1)
    if d < MAX_DEV {
        ring_out[d as usize] = ring_out[d as usize] + 1
        if ring_out[d as usize] > ring_peak {
            ring_peak = ring_out[d as usize]
        }
    }
    xhci.int_queue(state, dg(state, d, D_SLOT), dg(state, d, D_INTDCI),
        report_buf(state, d), dg(state, d, D_INTLEN))
}

fn raw_remember(state: u64, d: u64) {
    let b: u64 = report_buf(state, d)
    var w: u64 = 0
    var k: u64 = 0
    while k < 8 {
        w = w | ((kstate.get8(b + k) as u64) << (k * 8))
        k = k + 1
    }
    if w != 0 {
        ds(state, d, D_ROHW, w)
        ds(state, d, D_ROHN, dg(state, d, D_ROHN) + 1)
    }
}

fn dev_rohw(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_ROHW)
}

fn dev_rohn(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_ROHN)
}

fn report_buf(state: u64, d: u64) -> u64 {
    return state + REPORT_OFF + d * 64
}

fn irq(state: u64) {
    xhci.irq(state)
    service(state)
}

fn service(state: u64) {
    if g(state, S_READY) == 0 {
        return
    }
    let me: u64 = cpu.here(state)
    if me < 64 {
        svc_cpus = svc_cpus | (1 << me)
    }
    if atomic.cas(state + USCAL_OFF + S_SVCBUSY, 0, me + 1) != 0 {
        svc_skips = svc_skips + 1
        return
    }
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_INTDCI) != 0 {
            let i: u64 = xhci.ep_find(state, dg(state, d, D_SLOT),
                dg(state, d, D_INTDCI))
            if i < xhci.MAX_EP {
                let seq: u64 = xhci.ep_seq(state, i)
                if seq != dg(state, d, D_SEQ) {
                    let done: u64 = seq -% dg(state, d, D_SEQ)
                    if done > 1 {
                        seq_jumps = seq_jumps + 1
                        seq_jump_say(state, d, i, seq)
                    }
                    ring_done(d, done)
                    ds(state, d, D_SEQ, seq)
                    let cc: u64 = xhci.ep_code(state, i)
                    ds(state, d, D_LASTCC, cc)
                    if cc == xhci.CC_SUCCESS || cc == xhci.CC_SHORT {
                        s(state, S_REPORTS, g(state, S_REPORTS) + 1)
                        ds(state, d, D_REPS, dg(state, d, D_REPS) + 1)
                        raw_remember(state, d)
                        deliver(state, d)
                    } else {
                        ds(state, d, D_ERRS, dg(state, d, D_ERRS) + 1)
                        if xhci.ep_halted(state, dg(state, d, D_SLOT),
                            dg(state, d, D_INTDCI)) {
                            unstall(state, d, dg(state, d, D_INTDCI))
                            ds(state, d, D_HEAL, dg(state, d, D_HEAL) + 1)
                            s(state, S_HEAL, g(state, S_HEAL) + 1)
                        }
                    }
                    arm(state, d)
                }
            }
        }
        d = d + 1
    }
    led_service(state)
    btusb.pump(state)
    atomic.store(state + USCAL_OFF + S_SVCBUSY, 0)
}

static mut svc_cpus: u64 = 0

fn seq_jump_say(state: u64, d: u64, i: u64, seq: u64) {
    var m0: [u8; 20] = "usb: seq jump dev=\0\0"
    var m1: [u8; 6] = " was=\0"
    var m2: [u8; 5] = " now\0"
    var m3: [u8; 7] = " arms=\0"
    var m4: [u8; 7] = " reps=\0"
    var m5: [u8; 7] = " last=\0"
    var m6: [u8; 7] = " prev=\0"
    var m7: [u8; 6] = " enq=\0"
    serial.puts((&m0[0]) as u64)
    serial.dec(d)
    serial.puts((&m1[0]) as u64)
    serial.dec(dg(state, d, D_SEQ))
    serial.puts((&m2[0]) as u64)
    serial.dec(seq)
    serial.puts((&m3[0]) as u64)
    serial.dec(dg(state, d, D_ARMS))
    serial.puts((&m4[0]) as u64)
    serial.dec(dg(state, d, D_REPS))
    serial.puts((&m5[0]) as u64)
    serial.dec(xhci.ep_last_ptrs(i, 0))
    serial.puts((&m6[0]) as u64)
    serial.dec(xhci.ep_last_ptrs(i, 1))
    serial.puts((&m7[0]) as u64)
    serial.dec(xhci.ep_enq(state, i))
    serial.nl()
}
static mut svc_skips: u64 = 0
static mut seq_jumps: u64 = 0
static mut ring_out: [u64; 4] = [0 as u64; 4]
static mut ring_peak: u64 = 0
static mut w_usbstack: [u8; 9] = "usbstack\0"

fn ring_done(d: u64, n: u64) {
    if d >= MAX_DEV {
        return
    }
    if ring_out[d as usize] > n {
        ring_out[d as usize] = ring_out[d as usize] - n
    } else {
        ring_out[d as usize] = 0
    }
}

fn ring_fresh(d: u64) {
    if d < MAX_DEV {
        ring_out[d as usize] = 0
    }
}

fn ring_peak_get() -> u64 {
    return ring_peak
}

fn service_cpus() -> u64 {
    return svc_cpus
}

fn service_skips() -> u64 {
    return svc_skips
}

fn service_seq_jumps() -> u64 {
    return seq_jumps
}

fn poll(state: u64) {
    if g(state, S_READY) == 0 {
        return
    }
    xhci.drain(state)
    service(state)
}

fn deliver(state: u64, d: u64) {
    if dg(state, d, D_GENERIC) == 1 {
        hidin.report(state, d, report_buf(state, d), dg(state, d, D_INTLEN))
        return
    }
    if dg(state, d, D_DRIVER) == DRV_KBD {
        kbd_report(state, d)
        return
    }
    if dg(state, d, D_DRIVER) == DRV_MOUSE {
        mouse_report(state, d)
    }
}

fn kbd_report(state: u64, d: u64) {
    let before: u64 = hidin.keys(state)
    hidin.kbd_report_boot(state, d, report_buf(state, d))
    s(state, S_KEYS, g(state, S_KEYS) + (hidin.keys(state) - before))
}

fn hid_keys(state: u64) -> u64 {
    return hidin.keys(state)
}

fn hid_los(state: u64) -> u64 {
    return hidin.releases(state)
}

fn hid_bew(state: u64) -> u64 {
    return hidin.moves(state)
}

fn press(state: u64, u: u64) {
    hidin.press(state, u)
    s(state, S_KEYS, g(state, S_KEYS) + 1)
}

fn mouse_report(state: u64, d: u64) {
    hidin.mouse_report_boot(state, d, report_buf(state, d),
        dg(state, d, D_INTLEN))
    s(state, S_MOVES, g(state, S_MOVES) + 1)
}

// ------------------------------------------------------ Massenspeicher

const CBW_SIG: u64 = 0x43425355
const CSW_SIG: u64 = 0x53425355

fn msc_slot(state: u64, i: u64) -> u64 {
    if i >= MAX_MSC {
        return 0
    }
    return g(state, S_MSCTAB + i * 8)
}

fn msc_slot_set(state: u64, i: u64, v: u64) {
    if i < MAX_MSC {
        s(state, S_MSCTAB + i * 8, v)
    }
}

fn msc_ready_at(state: u64, i: u64) -> bool {
    return msc_slot(state, i) != 0
}

fn msc_dev_at(state: u64, i: u64) -> u64 {
    return msc_slot(state, i) - 1
}

fn msc_blocks_at(state: u64, i: u64) -> u64 {
    if !msc_ready_at(state, i) {
        return 0
    }
    return dg(state, msc_dev_at(state, i), D_MSCBLK)
}

fn msc_bsize_at(state: u64, i: u64) -> u64 {
    if !msc_ready_at(state, i) {
        return 0
    }
    return dg(state, msc_dev_at(state, i), D_MSCBS)
}

fn msc_count(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < MAX_MSC {
        if msc_slot(state, i) != 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn msc_alloc(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_MSC {
        if msc_slot(state, i) == 0 {
            return i
        }
        i = i + 1
    }
    return MAX_MSC
}

fn msc_slot_of_dev(state: u64, d: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_MSC {
        if msc_slot(state, i) == d + 1 {
            return i
        }
        i = i + 1
    }
    return MAX_MSC
}

fn msc_first(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_MSC {
        if msc_slot(state, i) != 0 {
            return i
        }
        i = i + 1
    }
    return MAX_MSC
}

fn msc_ready(state: u64) -> bool {
    return msc_first(state) < MAX_MSC
}

fn msc_blocks(state: u64) -> u64 {
    return msc_blocks_at(state, msc_first(state))
}

fn msc_bsize(state: u64) -> u64 {
    return msc_bsize_at(state, msc_first(state))
}

fn msc_dev(state: u64) -> u64 {
    return msc_dev_at(state, msc_first(state))
}

fn set8(p: u64, i: u64, v: u64) {
    __mmio_write8((p + i) as *mut u8, (v & 0xFF) as u8)
}

fn set32le(p: u64, i: u64, v: u64) {
    set8(p, i, v)
    set8(p, i + 1, v >> 8)
    set8(p, i + 2, v >> 16)
    set8(p, i + 3, v >> 24)
}

fn be32(p: u64, i: u64) -> u64 {
    return (b8(p, i) << 24) | (b8(p, i + 1) << 16) | (b8(p, i + 2) << 8)
        | b8(p, i + 3)
}

fn bot(state: u64, d: u64, cdb_len: u64, data: u64, dlen: u64,
    dir_in: bool) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let cbw: u64 = state + CBW_OFF
    let csw: u64 = state + CSW_OFF
    s(state, S_LASTDATA, 0)
    let tag: u64 = g(state, S_TAG) + 1
    s(state, S_TAG, tag)
    set32le(cbw, 0, CBW_SIG)
    set32le(cbw, 4, tag)
    set32le(cbw, 8, dlen)
    var flags: u64 = 0
    if dir_in {
        flags = 0x80
    }
    set8(cbw, 12, flags)
    set8(cbw, 13, 0) // Einheit 0
    set8(cbw, 14, cdb_len)
    s(state, S_MSCIO, g(state, S_MSCIO) + 1)
    if xhci.bulk(state, slot, dg(state, d, D_OUTDCI), cbw, 31) != 31 {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        return false
    }
    if dlen > 0 {
        var dci: u64 = dg(state, d, D_OUTDCI)
        if dir_in {
            dci = dg(state, d, D_INDCI)
        }
        let n: i64 = xhci.bulk(state, slot, dci, data, dlen)
        if n > 0 {
            s(state, S_LASTDATA, n as u64)
        } else {
            s(state, S_LASTDATA, 0)
        }
        if n < 0 {
            unstall(state, d, dci)
        }
    }
    zero(csw, 16)
    if xhci.bulk(state, slot, dg(state, d, D_INDCI), csw, 13) != 13 {
        unstall(state, d, dg(state, d, D_INDCI))
        if xhci.bulk(state, slot, dg(state, d, D_INDCI), csw, 13) != 13 {
            s(state, S_MSCERR, g(state, S_MSCERR) + 1)
            return false
        }
    }
    if b8(csw, 0) != (CSW_SIG & 0xFF) || b8(csw, 1) != ((CSW_SIG >> 8) & 0xFF)
        || b8(csw, 2) != ((CSW_SIG >> 16) & 0xFF) || b8(csw, 3) != ((CSW_SIG >> 24) & 0xFF)
        || (b8(csw, 4) | (b8(csw, 5) << 8) | (b8(csw, 6) << 16) | (b8(csw, 7) << 24)) != tag {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        reset_recovery(state, d)
        return false
    }
    let status: u64 = b8(csw, 12)
    if status == 2 {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        reset_recovery(state, d)
        return false
    }
    if status != 0 {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        return false
    }
    return true
}

fn reset_recovery(state: u64, d: u64) {
    let slot: u64 = dg(state, d, D_SLOT)
    xhci.control(state, slot, 0x21, 0xFF, 0, dg(state, d, D_IFACE), 0, 0, false)
    unstall(state, d, dg(state, d, D_INDCI))
    unstall(state, d, dg(state, d, D_OUTDCI))
}

fn unstall(state: u64, d: u64, dci: u64) {
    let slot: u64 = dg(state, d, D_SLOT)
    let i: u64 = xhci.ep_find(state, slot, dci)
    if i >= xhci.MAX_EP {
        return
    }
    var epaddr: u64 = dci / 2
    if (dci & 1) != 0 {
        epaddr = epaddr | 0x80
    }
    xhci.reset_endpoint(state, slot, dci)
    xhci.control(state, slot, 0x02, REQ_CLEAR_FEATURE, 0, epaddr, 0, 0, false)
    xhci.set_dequeue(state, slot, dci, i)
    ring_fresh(d)
}

fn refill(state: u64, d: u64) -> bool {
    let me: u64 = cpu.here(state)
    if atomic.cas(state + USCAL_OFF + S_SVCBUSY, 0, me + 1) != 0 {
        return false
    }
    let slot: u64 = dg(state, d, D_SLOT)
    let dci: u64 = dg(state, d, D_INTDCI)
    let i: u64 = xhci.ep_find(state, slot, dci)
    if i < xhci.MAX_EP {
        if xhci.ep_halted(state, slot, dci) {
            unstall(state, d, dci)
            ds(state, d, D_HEAL, dg(state, d, D_HEAL) + 1)
            s(state, S_HEAL, g(state, S_HEAL) + 1)
        } else if !cmdopt.has(state, (&w_usbstack[0]) as u64) {
            xhci.stop_endpoint(state, slot, dci)
            xhci.set_dequeue(state, slot, dci, i)
            ring_fresh(d)
        }
        ds(state, d, D_SEQ, xhci.ep_seq(state, i))
        arm(state, d)
    }
    atomic.store(state + USCAL_OFF + S_SVCBUSY, 0)
    return true
}

fn cdb(state: u64) -> u64 {
    return state + CBW_OFF + 15
}

fn msc_start(state: u64, d: u64) -> bool {
    var s_msc: [u8; 11] = "usb: msc \0\0"
    var s_blk: [u8; 8] = "blocks=\0"
    var s_bs: [u8; 9] = "  bsize=\0"
    var s_inq: [u8; 7] = "  inq=\0"
    var s_bad: [u8; 26] = "usb: msc unusable bsize=\0\0"

    if dg(state, d, D_INDCI) == 0 || dg(state, d, D_OUTDCI) == 0 {
        return false
    }
    let buf: u64 = state + DESC_OFF
    zero(buf, 64)
    let inq_cdb: u64 = scsi.inquiry(cdb(state), 36)
    if !bot(state, d, inq_cdb, buf, 36, true) {
        return false
    }
    let inq_len: u64 = g(state, S_LASTDATA)
    var tries: u64 = 0
    var up: bool = false
    while tries < 5 && !up {
        let tur_cdb: u64 = scsi.test_unit_ready(cdb(state))
        if bot(state, d, tur_cdb, 0, 0, false) {
            up = true
        } else {
            sense(state, d)
        }
        tries = tries + 1
    }
    if !up {
        return false
    }
    let cap: u64 = buf + 128
    zero(cap, 32)
    let cap_cdb: u64 = scsi.read_capacity10(cdb(state))
    if !bot(state, d, cap_cdb, cap, 8, true) {
        return false
    }
    var last: u64 = be32(cap, 0)
    var bs: u64 = be32(cap, 4)
    if last == 0xFFFFFFFF {
        zero(cap, 32)
        let cap16_cdb: u64 = scsi.read_capacity16(cdb(state), 32)
        if !bot(state, d, cap16_cdb, cap, 32, true) {
            return false
        }
        last = (be32(cap, 0) << 32) | be32(cap, 4)
        bs = be32(cap, 8)
    }
    if bs != 512 {
        serial.puts((&s_bad[0]) as u64)
        serial.dec(bs)
        serial.nl()
        return false
    }
    ds(state, d, D_MSCBLK, last + 1)
    ds(state, d, D_MSCBS, bs)
    serial.puts((&s_msc[0]) as u64)
    serial.puts((&s_blk[0]) as u64)
    serial.dec(last + 1)
    serial.puts((&s_bs[0]) as u64)
    serial.dec(bs)
    serial.puts((&s_inq[0]) as u64)
    serial.dec(inq_len)
    serial.put(32 as u8)
    var i: u64 = 8
    while i < 16 {
        let c: u64 = b8(buf, i)
        if c >= 32 && c < 127 {
            serial.put(c as u8)
        }
        i = i + 1
    }
    serial.nl()
    return true
}

fn sense(state: u64, d: u64) -> u64 {
    let buf: u64 = state + DESC_OFF + 256
    zero(buf, 32)
    let sense_cdb: u64 = scsi.request_sense(cdb(state), 18)
    if !bot(state, d, sense_cdb, buf, 18, true) {
        return 0
    }
    return scsi.sense_key(buf)
}

fn msc_sync_at(state: u64, i: u64) -> bool {
    var s_sync: [u8; 18] = "usb: msc sync ok=\0"
    if !msc_ready_at(state, i) {
        return false
    }
    let d: u64 = msc_dev_at(state, i)
    let sync_cdb: u64 = scsi.sync_cache(cdb(state))
    var done: bool = bot(state, d, sync_cdb, 0, 0, false)
    if !done {
        done = sense(state, d) == scsi.KEY_ILLEGAL_REQUEST
    }
    serial.puts((&s_sync[0]) as u64)
    serial.dec(yes(done))
    serial.nl()
    return done
}

fn msc_read_at(state: u64, i: u64, lba: u64, dst: u64) -> bool {
    if !msc_ready_at(state, i) {
        return false
    }
    let d: u64 = msc_dev_at(state, i)
    let tmp: u64 = state + BLK_OFF
    let read_cdb: u64 = scsi.read_blocks(cdb(state), lba, 1)
    if !bot(state, d, read_cdb, tmp, 512, true) {
        return false
    }
    copy(tmp, dst, 512)
    return true
}

fn msc_blk_dev(i: u64) -> u64 {
    if i == 0 {
        return wlock.D_USB0
    }
    return wlock.D_USB1 + i - 1
}

fn msc_write_at(state: u64, i: u64, lba: u64, src: u64) -> bool {
    if !wlock.allowed(msc_blk_dev(i)) {
        return false
    }
    if !msc_ready_at(state, i) {
        return false
    }
    let d: u64 = msc_dev_at(state, i)
    let tmp: u64 = state + BLK_OFF
    copy(src, tmp, 512)
    let write_cdb: u64 = scsi.write_blocks(cdb(state), lba, 1)
    return bot(state, d, write_cdb, tmp, 512, false)
}

fn copy(from: u64, to: u64, n: u64) {
    var i: u64 = 0
    while i < n / 8 {
        __mmio_write64((to + i * 8) as *mut u64,
            __mmio_read64((from + i * 8) as *mut u64))
        i = i + 1
    }
}

// ------------------------------------------------------ abziehen

fn unplug_check(state: u64) {
    if g(state, S_READY) == 0 || g(state, S_BUSY) != 0 {
        return
    }
    let n: u64 = xhci.ports(state)
    var p: u64 = 1
    while p <= n {
        if xhci.port_has_change(state, p) {
            xhci.port_clear_changes(state, p)
            let now: bool = xhci.port_connected(state, p)
            if was_there(state, p) && !now {
                gone(state, p)
            } else if !was_there(state, p) && now {
                s(state, S_HOTPLUGS, g(state, S_HOTPLUGS) + 1)
                mark(state, p)
                attach(state, p)
            }
        }
        p = p + 1
    }
}

fn event_class(drv: u64) -> u64 {
    if drv == DRV_MSC {
        return drvclass.CLS_BLOCK
    }
    if drv == DRV_ECM || drv == DRV_RNDIS || drv == DRV_NCM || drv == DRV_CH336
        || drv == DRV_AX88772 || drv == DRV_AX88179 || drv == DRV_RTL8153 {
        return drvclass.CLS_NET_ETH
    }
    if drv == DRV_KBD || drv == DRV_MOUSE || drv == DRV_HIDGEN {
        return drvclass.CLS_INPUT
    }
    return drvclass.CLS_NONE
}

fn post_event(state: u64, d: u64, action: u64) {
    let cls: u64 = event_class(dg(state, d, D_DRIVER))
    if cls == drvclass.CLS_NONE {
        return
    }
    let ids: u64 = (dg(state, d, D_VID) << 16) | (dg(state, d, D_PID) & 0xFFFF)
    let path: u64 = (dg(state, d, D_PORT) << 20) | (dg(state, d, D_ROUTE) & 0xFFFFF)
    let _q: u64 = uevent.post(state, action, cls, uevent.BUS_USB, ids, path, dg(state, d, D_SLOT))
}

fn unplug_dev(state: u64, d: u64) {
    var s_gone: [u8; 18] = "usb: unplug port=\0"
    var s_drv: [u8; 9] = " driver=\0"
    serial.puts((&s_gone[0]) as u64)
    serial.dec(dg(state, d, D_PORT))
    serial.puts((&s_drv[0]) as u64)
    drv_name(dg(state, d, D_DRIVER))
    serial.nl()
    if g(state, S_KBD) == d + 1 {
        s(state, S_KBD, 0)
    }
    if g(state, S_MOUSE) == d + 1 {
        s(state, S_MOUSE, 0)
    }
    let mi: u64 = msc_slot_of_dev(state, d)
    if mi < MAX_MSC {
        msc_slot_set(state, mi, 0)
        ds(state, d, D_MSCBLK, 0)
        ds(state, d, D_MSCBS, 0)
        s(state, S_MSCWEG, g(state, S_MSCWEG) + 1)
    }
    usbnet.unplug_slot(state, dg(state, d, D_SLOT))
    btusb.unplug_slot(state, dg(state, d, D_SLOT))
    post_event(state, d, uevent.ACT_REMOVE)
    drop_dev(state, d)
    s(state, S_NDEV, g(state, S_NDEV) - 1)
    s(state, S_UNPLUGS, g(state, S_UNPLUGS) + 1)
}

fn unplug_below(state: u64, slot: u64) {
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_PARENT) == slot {
            let child: u64 = dg(state, d, D_SLOT)
            let is_hub: bool = dg(state, d, D_DRIVER) == DRV_HUB
            unplug_dev(state, d)
            if is_hub {
                unplug_below(state, child)
            }
        }
        d = d + 1
    }
}

fn gone(state: u64, p: u64) {
    unmark(state, p)
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_PORT) == p {
            unplug_dev(state, d)
        }
        d = d + 1
    }
}

fn unplug_now(state: u64) {
    if g(state, S_READY) == 0 {
        return
    }
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 {
            gone(state, dg(state, d, D_PORT))
        }
        d = d + 1
    }
}

// ------------------------------------------------------- die Auskunft

fn say(state: u64) {
    var s_h: [u8; 14] = "usb: devices=\0"
    var s_k: [u8; 6] = " kbd=\0"
    var s_m: [u8; 8] = " mouse=\0"
    var s_s: [u8; 6] = " msc=\0"
    var s_e: [u8; 8] = " enums=\0"
    var s_f: [u8; 8] = " fails=\0"
    var s_ev: [u8; 9] = " events=\0"
    var s_i: [u8; 7] = " irqs=\0"
    var s_c: [u8; 7] = " cmds=\0"
    serial.puts((&s_h[0]) as u64)
    serial.dec(g(state, S_NDEV))
    serial.puts((&s_k[0]) as u64)
    serial.dec(yes(have_kbd(state)))
    serial.puts((&s_m[0]) as u64)
    serial.dec(yes(have_mouse(state)))
    serial.puts((&s_s[0]) as u64)
    serial.dec(yes(msc_ready(state)))
    serial.puts((&s_e[0]) as u64)
    serial.dec(g(state, S_ENUMS))
    serial.puts((&s_f[0]) as u64)
    serial.dec(g(state, S_FAILS))
    serial.puts((&s_ev[0]) as u64)
    serial.dec(xhci.events(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(xhci.irqs(state))
    serial.puts((&s_c[0]) as u64)
    serial.dec(xhci.cmds(state))
    serial.nl()
}

fn report(state: u64) {
    var s_h: [u8; 11] = "usb: keys=\0"
    var s_r: [u8; 10] = " reports=\0"
    var s_m: [u8; 8] = " moves=\0"
    var s_e: [u8; 9] = " events=\0"
    var s_i: [u8; 7] = " irqs=\0"
    var s_x: [u8; 10] = " xhcierr=\0"
    var s_o: [u8; 8] = " mscio=\0"
    var s_c: [u8; 9] = " mscerr=\0"
    var s_u: [u8; 10] = " unplugs=\0"
    var s_p: [u8; 11] = " hotplugs=\0"
    var s_d: [u8; 10] = " devices=\0"
    var s_t: [u8; 11] = " selftest=\0"
    var s_mx: [u8; 5] = " mx=\0"
    var s_my: [u8; 5] = " my=\0"
    var s_mb: [u8; 7] = " mbtn=\0"
    var s_mp: [u8; 7] = " mpkt=\0"
    var s_mc: [u8; 7] = " mclk=\0"
    if g(state, S_READY) == 0 {
        return
    }
    serial.puts((&s_h[0]) as u64)
    serial.dec(g(state, S_KEYS))
    serial.puts((&s_r[0]) as u64)
    serial.dec(g(state, S_REPORTS))
    serial.puts((&s_m[0]) as u64)
    serial.dec(g(state, S_MOVES))
    serial.puts((&s_e[0]) as u64)
    serial.dec(xhci.events(state))
    serial.puts((&s_i[0]) as u64)
    serial.dec(xhci.irqs(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(xhci.errors(state))
    serial.puts((&s_o[0]) as u64)
    serial.dec(g(state, S_MSCIO))
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, S_MSCERR))
    serial.puts((&s_u[0]) as u64)
    serial.dec(g(state, S_UNPLUGS))
    serial.puts((&s_p[0]) as u64)
    serial.dec(g(state, S_HOTPLUGS))
    serial.puts((&s_d[0]) as u64)
    serial.dec(g(state, S_NDEV))
    serial.puts((&s_t[0]) as u64)
    serial.dec(selftest(state))
    serial.puts((&s_mx[0]) as u64)
    serial.dec(gfx.mouse_x(state))
    serial.puts((&s_my[0]) as u64)
    serial.dec(gfx.mouse_y(state))
    serial.puts((&s_mb[0]) as u64)
    serial.dec(gfx.mouse_buttons(state))
    serial.puts((&s_mp[0]) as u64)
    serial.dec(gfx.mouse_packets(state))
    serial.puts((&s_mc[0]) as u64)
    serial.dec(gfx.mouse_clicks(state))
    serial.nl()
    hid_report(state)
}

fn hid_report(state: u64) {
    var s_a: [u8; 10] = "hid: gen=\0"
    var s_b: [u8; 8] = " rdlen=\0"
    var s_c: [u8; 9] = " rdfail=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(g(state, S_GENDEV))
    serial.puts((&s_b[0]) as u64)
    serial.dec(g(state, S_RDLEN))
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, S_RDFAIL))
    serial.nl()
    hidin.say(state)
}

fn stat(state: u64, what: u64) -> u64 {
    if what == 0 {
        return yes(ready(state))
    }
    if what == 1 {
        return g(state, S_NDEV)
    }
    if what == 2 {
        return yes(have_kbd(state))
    }
    if what == 3 {
        return yes(have_mouse(state))
    }
    if what == 4 {
        return yes(msc_ready(state))
    }
    if what == 5 {
        return msc_blocks(state)
    }
    if what == 6 {
        return msc_bsize(state)
    }
    if what == 7 {
        return g(state, S_KEYS)
    }
    if what == 8 {
        return g(state, S_REPORTS)
    }
    if what == 9 {
        return g(state, S_MOVES)
    }
    if what == 10 {
        return xhci.events(state)
    }
    if what == 11 {
        return xhci.irqs(state)
    }
    if what == 12 {
        return g(state, S_ENUMS)
    }
    if what == 13 {
        return g(state, S_UNPLUGS)
    }
    if what == 14 {
        return g(state, S_HOTPLUGS)
    }
    if what == 15 {
        return g(state, S_MSCIO)
    }
    if what == 16 {
        return g(state, S_MSCERR)
    }
    if what == 17 {
        return xhci.errors(state)
    }
    if what == 18 {
        return xhci.ports(state)
    }
    if what == 19 {
        return xhci.slots(state)
    }
    if what == 20 {
        return xhci.ctx_size(state)
    }
    if what == 21 {
        return xhci.cmds(state)
    }
    if what == 22 {
        return selftest(state)
    }
    if what == 23 {
        return g(state, S_FAILS)
    }
    return 0
}

fn selftest(state: u64) -> u64 {
    var n: u64 = 0
    if xhci.ready(state) {
        n = n + 1
    }
    if xhci.ports(state) > 0 && xhci.ports(state) < 256 {
        n = n + 1
    }
    if xhci.slots(state) > 0 {
        n = n + 1
    }
    if xhci.ctx_size(state) == 32 || xhci.ctx_size(state) == 64 {
        n = n + 1
    }
    if xhci.cmds(state) > 0 {
        n = n + 1
    }
    if xhci.events(state) >= xhci.cmds(state) {
        n = n + 1
    }
    if g(state, S_NDEV) <= MAX_DEV {
        n = n + 1
    }
    if xhci.errors(state) == 0 {
        n = n + 1
    }
    return n
}

// ####################################################################
// ############################################ RUNDE BLECHEINGABE
// ####################################################################

// ==================================================== DIE FUNDLISTE

fn fund_at(state: u64, i: u64) -> u64 {
    return state + FUND_OFF + i * FUND_BYTES
}

fn fg(state: u64, i: u64, off: u64) -> u64 {
    return kstate.get(fund_at(state, i), off)
}

fn fs(state: u64, i: u64, off: u64, v: u64) {
    kstate.set(fund_at(state, i), off, v)
}

fn found_new(state: u64, port: u64, hubport: u64, speed: u64) -> u64 {
    let n: u64 = g(state, S_FUNDN)
    if n >= MAX_FUND {
        return MAX_FUND - 1
    }
    zero(fund_at(state, n), FUND_BYTES)
    fs(state, n, F_USED, 1)
    fs(state, n, F_PORT, (port & 0xFF) | ((hubport & 0xFF) << 8))
    fs(state, n, F_SPEED, speed)
    s(state, S_FUNDN, n + 1)
    return n
}

fn fund_flag(state: u64, i: u64, bit: u64) {
    if i < MAX_FUND {
        fs(state, i, F_FLAGS, fg(state, i, F_FLAGS) | bit)
    }
}

fn fund_id(state: u64, i: u64, vid: u64, pid: u64) {
    if i < MAX_FUND {
        fs(state, i, F_ID, ((vid & 0xFFFF) << 16) | (pid & 0xFFFF))
    }
}

fn fund_dev_class(state: u64, i: u64, c: u64, u: u64, pr: u64) {
    if i < MAX_FUND {
        fs(state, i, F_DCLS, ((c & 0xFF) << 16) | ((u & 0xFF) << 8) | (pr & 0xFF))
    }
}

fn fund_if_class(state: u64, i: u64, c: u64, u: u64, pr: u64) {
    if i < MAX_FUND {
        fs(state, i, F_ICLS, ((c & 0xFF) << 16) | ((u & 0xFF) << 8) | (pr & 0xFF))
    }
}

fn fund_driver_set(state: u64, i: u64, k: u64) {
    if k != 0 {
        usbdiag.bound()
    }
    if i < MAX_FUND {
        fs(state, i, F_FLAGS, (fg(state, i, F_FLAGS) & 0xFF) | (k << 8))
    }
}

fn first_iface(state: u64, i: u64, buf: u64, total: u64) {
    var at: u64 = 0
    while at + 2 <= total {
        let len: u64 = b8(buf, at)
        // TOCTOU audit F-05: a descriptor must lie inside the buffer (bLength is chosen by the device)
        if len < 2 || at + len > total {
            at = total
        } else {
            if b8(buf, at + 1) == 4 && len >= 9 {
                fund_if_class(state, i, b8(buf, at + 5), b8(buf, at + 6),
                    b8(buf, at + 7))
                at = total
            } else {
                at = at + len
            }
        }
    }
}

fn fund_count(state: u64) -> u64 {
    return g(state, S_FUNDN)
}

fn fund_port(state: u64, i: u64) -> u64 {
    return fg(state, i, F_PORT) & 0xFF
}

fn fund_hub(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_PORT) >> 8) & 0xFF
}

fn fund_speed(state: u64, i: u64) -> u64 {
    return fg(state, i, F_SPEED)
}

fn fund_vid(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_ID) >> 16) & 0xFFFF
}

fn fund_pid(state: u64, i: u64) -> u64 {
    return fg(state, i, F_ID) & 0xFFFF
}

fn fund_dcls(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_DCLS) >> 16) & 0xFF
}

fn fund_dsub(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_DCLS) >> 8) & 0xFF
}

fn fund_dpro(state: u64, i: u64) -> u64 {
    return fg(state, i, F_DCLS) & 0xFF
}

fn fund_icls(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_ICLS) >> 16) & 0xFF
}

fn fund_isub(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_ICLS) >> 8) & 0xFF
}

fn fund_ipro(state: u64, i: u64) -> u64 {
    return fg(state, i, F_ICLS) & 0xFF
}

fn fund_ifaces(state: u64, i: u64) -> u64 {
    return fg(state, i, F_IFACES)
}

fn fund_flags(state: u64, i: u64) -> u64 {
    return fg(state, i, F_FLAGS) & 0xFF
}

fn fund_driver(state: u64, i: u64) -> u64 {
    return (fg(state, i, F_FLAGS) >> 8) & 0xFF
}

fn hubs(state: u64) -> u64 {
    return g(state, S_HUBS)
}

fn hubports(state: u64) -> u64 {
    return g(state, S_HUBPORTS)
}

fn fails(state: u64) -> u64 {
    return g(state, S_FAILS)
}

fn attached_map(state: u64) -> u64 {
    return g(state, S_ATTACHED)
}

fn pending(state: u64) -> u64 {
    return g(state, S_PENDN)
}

fn set_leds(state: u64, mask: u64) -> bool {
    let k: u64 = g(state, S_KBD)
    if k == 0 {
        return false
    }
    let d: u64 = k - 1
    if dg(state, d, D_USED) == 0 {
        return false
    }
    if g(state, S_LEDBUSY) != 0 {
        return false
    }
    s(state, S_LEDBUSY, 1)
    s(state, S_LEDTRY, g(state, S_LEDTRY) + 1)
    let p: u64 = state + HUB_OFF
    kstate.set8(p, (mask & 7) as u8)
    let r: i64 = xhci.control(state, dg(state, d, D_SLOT), 0x21,
        REQ_SET_REPORT, (2 << 8), dg(state, d, D_IFACE), 1, p, false)
    s(state, S_LEDS, mask & 7)
    s(state, S_LEDBUSY, 0)
    if r < 0 {
        s(state, S_LEDBAD, g(state, S_LEDBAD) + 1)
        return false
    }
    s(state, S_LEDOK, g(state, S_LEDOK) + 1)
    return true
}

fn leds_try(state: u64) -> u64 {
    return g(state, S_LEDTRY)
}

fn kbd_dev(state: u64) -> u64 {
    return g(state, S_KBD)
}

fn mouse_dev(state: u64) -> u64 {
    return g(state, S_MOUSE)
}

fn dev_reps(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_REPS)
}

fn dev_arms(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_ARMS)
}

fn dev_cc(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_LASTCC)
}

fn dev_dci(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_INTDCI)
}

fn dev_iface(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_IFACE)
}

fn dev_generic(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_GENERIC)
}

fn dev_roh(state: u64, d: u64, k: u64) -> u64 {
    if d >= MAX_DEV || k >= 64 {
        return 0
    }
    return kstate.get8(report_buf(state, d) + k)
}

fn dev_errs(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_ERRS)
}

fn dev_heal(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_HEAL)
}

fn dev_slot(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_SLOT)
}

fn dev_intdci(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return dg(state, d, D_INTDCI)
}

fn dev_epstate(state: u64, d: u64) -> u64 {
    if d >= MAX_DEV {
        return 0
    }
    return xhci.ep_state(state, dg(state, d, D_SLOT), dg(state, d, D_INTDCI))
}

fn heilungen(state: u64) -> u64 {
    return g(state, S_HEAL)
}

fn without_space(state: u64) -> u64 {
    return g(state, S_NOPLATZ)
}

// ================================================== RUNDE BLECHDREI
// LAEUFT GERADE EINE AUFZAEHLUNG?
fn busy(state: u64) -> u64 {
    return g(state, S_BUSY)
}

fn led_service(state: u64) {
    if g(state, S_READY) == 0 || g(state, S_KBD) == 0 {
        return
    }
    if kbd.locks_dirty() == 0 {
        return
    }
    kbd.locks_clean()
    set_leds(state, kbd.locks(state) ^ (g(state, S_LEDHERZ) & 7))
}

fn leds_sent(state: u64) -> u64 {
    return g(state, S_LEDOK)
}

fn leds_fail(state: u64) -> u64 {
    return g(state, S_LEDBAD)
}

fn leds_last(state: u64) -> u64 {
    return g(state, S_LEDS)
}

fn beat_leds(state: u64, an: u64) {
    if g(state, S_READY) == 0 || g(state, S_KBD) == 0 {
        return
    }
    var h: u64 = 0
    if an != 0 {
        h = kbd.LK_SCROLL
    }
    if h == g(state, S_LEDHERZ) {
        return
    }
    s(state, S_LEDHERZ, h)
    set_leds(state, kbd.locks(state) ^ h)
}

// ==================================================== DER HUB-TREIBER

fn hub_desc(state: u64, d: u64) -> bool {
    let p: u64 = state + HUB_OFF
    zero(p, 64)
    var art: u64 = D_HUB
    if dg(state, d, D_SPEED) >= 4 {
        art = D_HUB_SS
    }
    if xhci.control(state, dg(state, d, D_SLOT), 0xA0, REQ_GET_DESCRIPTOR,
        (art << 8), 0, 9, p, true) < 9 {
        return false
    }
    let n: u64 = b8(p, 2)
    if n == 0 || n > 15 {
        return false
    }
    ds(state, d, D_PORTS, n)
    return true
}

fn hub_slot_update(state: u64, d: u64) -> bool {
    let slot: u64 = dg(state, d, D_SLOT)
    let sc: u64 = xhci.dev_slot_ctx(state, slot)
    let entries: u64 = (kstate.get32(sc) >> 27) & 0x1F
    build_slot(state, d, entries)
    let ic: u64 = xhci.in_control(state)
    wr32(ic, 0)
    wr32(ic + 4, 1)
    return xhci.configure_endpoint(state, slot) == xhci.CC_SUCCESS
}

fn hub_feature(state: u64, d: u64, assign: bool, merkmal: u64,
    port: u64) -> bool {
    var req: u64 = REQ_CLEAR_FEATURE
    if assign {
        req = REQ_SET_FEATURE
    }
    return xhci.control(state, dg(state, d, D_SLOT), 0x23, req,
        merkmal, port, 0, 0, false) >= 0
}

const HUB_STATUS_ERR: u64 = 0xFFFFFFFFFFFFFFFF

fn hub_port_read(state: u64, d: u64, port: u64) -> u64 {
    let p: u64 = state + HUB_OFF + 32
    zero(p, 8)
    if xhci.control(state, dg(state, d, D_SLOT), 0xA3, REQ_GET_STATUS,
        0, port, 4, p, true) < 4 {
        return HUB_STATUS_ERR
    }
    return b16(p, 0) | (b16(p, 2) << 16)
}

fn hub_port_status(state: u64, d: u64, port: u64) -> u64 {
    let v: u64 = hub_port_read(state, d, port)
    if v == HUB_STATUS_ERR {
        return 0
    }
    return v
}

fn hub_child_at(state: u64, d: u64, p: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_DEV {
        if dg(state, i, D_USED) != 0 && dg(state, i, D_PARENT) == dg(state, d, D_SLOT)
            && dg(state, i, D_HUBPORT) == p {
            return i + 1
        }
        i = i + 1
    }
    return 0
}

fn hub_child_gone(state: u64, d: u64, p: u64) {
    let c: u64 = hub_child_at(state, d, p)
    if c == 0 {
        return
    }
    let child: u64 = c - 1
    let slot: u64 = dg(state, child, D_SLOT)
    let is_hub: bool = dg(state, child, D_DRIVER) == DRV_HUB
    unplug_dev(state, child)
    if is_hub {
        unplug_below(state, slot)
    }
}

fn hub_speed(state: u64, d: u64, st: u64) -> u64 {
    if dg(state, d, D_SPEED) >= 4 {
        return 4
    }
    if (st & (1 << 10)) != 0 {
        return 3
    }
    if (st & (1 << 9)) != 0 {
        return 2
    }
    return 1
}

fn hub_port_reset(state: u64, d: u64, port: u64) -> bool {
    if !hub_feature(state, d, true, PF_RESET, port) {
        return false
    }
    var ms: u64 = 0
    var fertig: bool = false
    while ms < 800 {
        let st: u64 = hub_port_status(state, d, port)
        if (st & (1 << (16 + 4))) != 0 {
            fertig = true
            ms = 800
        } else {
            xhci.udelay(state, 1000)
            ms = ms + 1
        }
    }
    if !fertig {
        return false
    }
    hub_feature(state, d, false, PF_C_RESET, port)
    // Erholungszeit, USB 2.0, 7.1.7.5 (TRSTRCY = 10 ms).
    xhci.udelay(state, 20000)
    return (hub_port_status(state, d, port) & 2) != 0
}

fn hub_start(state: u64, d: u64) {
    var s_h: [u8; 12] = "usb: hub p=\0"
    var s_n: [u8; 8] = " ports=\0"
    var s_ok: [u8; 8] = " slot=\0\0"
    var s_bad: [u8; 21] = "usb: hub descr FEHLT\0"
    if !hub_desc(state, d) {
        serial.puts((&s_bad[0]) as u64)
        serial.nl()
        return
    }
    usbdiag.hub_seen(xhci.unit(state), dg(state, d, D_PORT), dg(state, d, D_PORTS))
    s(state, S_HUBS, g(state, S_HUBS) + 1)
    s(state, S_HUBPORTS, g(state, S_HUBPORTS) + dg(state, d, D_PORTS))
    let ok: bool = hub_slot_update(state, d)
    serial.puts((&s_h[0]) as u64)
    serial.dec(dg(state, d, D_PORT))
    serial.puts((&s_n[0]) as u64)
    serial.dec(dg(state, d, D_PORTS))
    serial.puts((&s_ok[0]) as u64)
    serial.dec(dg(state, d, D_SLOT))
    if !ok {
        var s_e: [u8; 12] = " CFG FEHLT\0\0"
        serial.puts((&s_e[0]) as u64)
    }
    serial.nl()
    hub_scan(state, d)
}

fn hub_scan(state: u64, d: u64) {
    let n: u64 = dg(state, d, D_PORTS)
    let p0: u64 = state + HUB_OFF
    var wait_for: u64 = b8(p0, 5) * 2000 // bPwrOn2PwrGood, 2-ms-Schritte
    if wait_for < 100000 {
        wait_for = 100000
    }
    if wait_for > 400000 {
        wait_for = 400000
    }
    var p: u64 = 1
    while p <= n {
        hub_feature(state, d, true, PF_POWER, p)
        p = p + 1
    }
    xhci.udelay(state, wait_for)
    p = 1
    while p <= n {
        let st: u64 = hub_port_status(state, d, p)
        let hidx: u64 = usbdiag.info(xhci.unit(state), usbdiag.I_HUBS) - 1
        usbdiag.hub_port(xhci.unit(state), hidx, p, st, 2)
        if (st & (1 << 16)) != 0 {
            hub_feature(state, d, false, PF_C_CONNECTION, p)
        }
        hub_probe_port(state, d, p, hidx, st)
        p = p + 1
    }
}

fn hub_probe_port(state: u64, d: u64, p: u64, hidx: u64, st: u64) -> bool {
    if (st & 1) == 0 {
        return false
    }
    xhci.udelay(state, 100000)
    let hrst: bool = hub_port_reset(state, d, p)
    var hrv: u64 = 0
    if hrst {
        hrv = 1
    }
    usbdiag.hub_port(xhci.unit(state), hidx, p, st, hrv)
    if !hrst {
        return false
    }
    let st2: u64 = hub_port_status(state, d, p)
    let sp: u64 = hub_speed(state, d, st2)
    var rt: u64 = dg(state, d, D_ROUTE)
    var schicht: u64 = 0
    while schicht < 5 && ((rt >> (schicht * 4)) & 0xF) != 0 {
        schicht = schicht + 1
    }
    var pn: u64 = p
    if pn > 15 {
        pn = 15
    }
    if schicht < 5 {
        rt = rt | (pn << (schicht * 4))
    }
    return attach_at(state, dg(state, d, D_PORT), rt, d, p, true, sp)
}

fn hub_child_present(state: u64, d: u64, p: u64) -> bool {
    var i: u64 = 0
    while i < MAX_DEV {
        if dg(state, i, D_USED) != 0 && dg(state, i, D_PARENT) == dg(state, d, D_SLOT)
            && dg(state, i, D_HUBPORT) == p {
            return true
        }
        i = i + 1
    }
    return false
}

fn hub_rescan(state: u64) {
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_DRIVER) == DRV_HUB {
            if dg(state, d, D_PORTS) == 0 {
                if g(state, S_HUBTRY) < HUB_TRY_MAX {
                    s(state, S_HUBTRY, g(state, S_HUBTRY) + 1)
                    hub_start(state, d)
                }
            } else {
                hub_rescan_ports(state, d)
            }
        }
        d = d + 1
    }
}

fn hub_rescan_ports(state: u64, d: u64) {
    let n: u64 = dg(state, d, D_PORTS)
    let hidx: u64 = usbdiag.info(xhci.unit(state), usbdiag.I_HUBS) - 1
    var p: u64 = 1
    while p <= n {
        if hub_child_present(state, d, p) {
            let live: u64 = hub_port_read(state, d, p)
            if live != HUB_STATUS_ERR && (live & 1) == 0 {
                if (live & (1 << 16)) != 0 {
                    hub_feature(state, d, false, PF_C_CONNECTION, p)
                }
                hub_child_gone(state, d, p)
            }
        }
        if !hub_child_present(state, d, p) && g(state, S_HUBTRY) < HUB_TRY_MAX {
            let st: u64 = hub_port_status(state, d, p)
            if (st & (1 << 16)) != 0 {
                hub_feature(state, d, false, PF_C_CONNECTION, p)
            }
            if (st & 1) != 0 {
                s(state, S_HUBTRY, g(state, S_HUBTRY) + 1)
                s(state, S_HUBHITS, g(state, S_HUBHITS) + 1)
                hub_probe_port(state, d, p, hidx, st)
            }
        }
        p = p + 1
    }
}

fn port_watch(state: u64) {
    if g(state, S_READY) == 0 || g(state, S_BUSY) != 0 {
        return
    }
    if kstate.mode_on(state, kstate.M_USBSAFE) {
        return
    }
    let n: u64 = xhci.ports(state)
    let due: u64 = usbdiag.timed_due(kstate.get(state, kstate.TICKS))
    if due != 0 {
        usbdiag_snap_all(state, xhci.unit(state), due)
    }
    var rescan: bool = usbdiag.rescan_due(kstate.get(state, kstate.TICKS))
    if kstate.mode_on(state, kstate.M_NOUSBRESCAN) {
        rescan = false
    }
    if rescan && g(state, S_HUBS) != 0 {
        s(state, S_HUBDUE, 1)
    }
    var p: u64 = 1
    while p <= n && p < 64 {
        if rescan && xhci.port_connected(state, p) && !was_there(state, p) {
            s(state, S_PEND, g(state, S_PEND) | (1 << p))
        }
        if xhci.port_has_change(state, p) {
            usbdiag.event(p, xhci.portsc(state, p))
            usbdiag.log(kstate.get(state, kstate.TICKS), usbdiag.LK_PSC, p, xhci.portsc(state, p))
            xhci.port_clear_changes(state, p)
            s(state, S_PEND, g(state, S_PEND) | (1 << p))
            s(state, S_PENDN, g(state, S_PENDN) + 1)
        }
        p = p + 1
    }
}

fn silence_check(state: u64) {
    if g(state, S_READY) == 0 || g(state, S_BUSY) != 0 {
        return
    }
    var still: bool = false
    var d: u64 = 0
    while d < MAX_DEV {
        if dg(state, d, D_USED) != 0 && dg(state, d, D_INTDCI) != 0 {
            let now: u64 = dg(state, d, D_REPS)
            if now == dg(state, d, D_WACH) {
                still = true
            }
            ds(state, d, D_WACH, now)
        }
        d = d + 1
    }
    if still {
        s(state, S_WACHN, g(state, S_WACHN) + 1)
        xhci.drain(state)
        service(state)
    }
    var e: u64 = 0
    while e < MAX_DEV {
        if dg(state, e, D_USED) != 0 && dg(state, e, D_INTDCI) != 0
            && dg(state, e, D_REPS) == 0 {
            ds(state, e, D_STUMM, dg(state, e, D_STUMM) + 1)
            if dg(state, e, D_STUMM) >= WATCH_LIMIT
                && dg(state, e, D_AGAIN) < AGAIN_MAX {
                if refill(state, e) {
                    ds(state, e, D_AGAIN, dg(state, e, D_AGAIN) + 1)
                    ds(state, e, D_STUMM, 0)
                    s(state, S_WIEDERN, g(state, S_WIEDERN) + 1)
                }
            }
        } else {
            ds(state, e, D_STUMM, 0)
        }
        e = e + 1
    }
}

fn wiedern(state: u64) -> u64 {
    return g(state, S_WIEDERN)
}

fn wachen(state: u64) -> u64 {
    return g(state, S_WACHN)
}

fn hotplug_work(state: u64) {
    if g(state, S_READY) == 0 || g(state, S_BUSY) != 0 {
        return
    }
    let is_open: u64 = g(state, S_PEND)
    let hubdue: u64 = g(state, S_HUBDUE)
    if is_open == 0 && hubdue == 0 {
        return
    }
    s(state, S_PEND, 0)
    s(state, S_HUBDUE, 0)
    if is_open != 0 {
        chdiag.bump(state, chdiag.F_PASSES)
    }
    s(state, S_BUSY, 1)
    let n: u64 = xhci.ports(state)
    var p: u64 = 1
    while p <= n && p < 64 {
        if (is_open & (1 << p)) != 0 {
            let now: bool = xhci.port_connected(state, p)
            if was_there(state, p) && !now {
                gone(state, p)
            } else if !was_there(state, p) && now {
                s(state, S_HOTPLUGS, g(state, S_HOTPLUGS) + 1)
                mark(state, p)
                attach(state, p)
            }
        }
        p = p + 1
    }
    if hubdue != 0 {
        hub_rescan(state)
    }
    s(state, S_BUSY, 0)
}

// ===================================================== DD-12: AFTER S3
// The controller lost its state: set it up again and enumerate again --
// the same `versuch` the first start used on the controller it kept
// (keyboard, mouse, sticks come back as new devices). False if there was
// no controller up before.
fn resume(state: u64) -> bool {
    if !ready(state) {
        return false
    }
    let armed: bool = !kstate.mode_on(state, kstate.M_NOUSBIRQ)
    let _p: u64 = versuch(state, g(state, S_CHOICE), armed)
    return ready(state)
}
