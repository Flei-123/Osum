profile kernel

import drv.usb.chdiag
import lib.kstate
import drv.usb.usbdiag
import drv.usb.xhci
import usb.usb.usbbase
import usb.usb.usbbind
import usb.usb.usbdev
import usb.usb.usbwatch

const S_PEND: u64 = 0x128

const S_HUBTRY: u64 = 0xE0

const S_HUBHITS: u64 = 0xE8

const HUB_TRY_MAX: u64 = 48

const S_WACHN: u64 = 0x168

const S_WIEDERN: u64 = 0x170 // neu bestueckte stumme Endpunkte

const D_WACH: u64 = 312

const D_STUMM: u64 = 320

const D_AGAIN: u64 = 328

const WATCH_LIMIT: u64 = 20

const AGAIN_MAX: u64 = 3

// ------------------------------------------------------ abziehen

const PSC_CSC_BIT: u64 = 131072

const RETRY_MAX: u64 = 3

const RETRY_TICKS: u64 = 100

static mut csc_mask: u64 = 0

static mut retry_mask: u64 = 0

static mut retry_due: u64 = 0

static mut retry_n: [u64; 64] = [0 as u64; 64]

fn note_change(state: u64, p: u64) {
    if (xhci.portsc(state, p) & PSC_CSC_BIT) != 0 {
        csc_mask = csc_mask | (1 << p)
    }
}

fn attach_port(state: u64, p: u64) {
    usbdev.s(state, usbbase.S_HOTPLUGS, usbdev.g(state, usbbase.S_HOTPLUGS) + 1)
    usbdev.s(state, S_HUBTRY, 0)
    usbdev.mark(state, p)
    if usbbind.attach(state, p) {
        retry_n[p as usize] = 0
        return
    }
    usbdev.unmark(state, p)
    if retry_n[p as usize] < RETRY_MAX {
        retry_n[p as usize] = retry_n[p as usize] + 1
        retry_mask = retry_mask | (1 << p)
        retry_due = kstate.get(state, kstate.TICKS) + RETRY_TICKS
    } else {
        retry_n[p as usize] = 0
    }
}

fn sync_port(state: u64, p: u64) {
    let now: bool = xhci.port_connected(state, p)
    var there: bool = usbdev.was_there(state, p)
    let replug: bool = (csc_mask & (1 << p)) != 0
    csc_mask = csc_mask & (~(1 << p))
    if there && (!now || replug) {
        usbdev.s(state, S_HUBTRY, 0)
        usbbind.gone(state, p)
        there = false
    }
    if !there && now {
        attach_port(state, p)
    }
}

fn retry_pending(state: u64) -> u64 {
    if retry_mask != 0 && kstate.get(state, kstate.TICKS) >= retry_due {
        let m: u64 = retry_mask
        retry_mask = 0
        return m
    }
    return 0
}

fn unplug_check(state: u64) {
    if usbdev.g(state, usbbase.S_READY) == 0 || usbdev.g(state, usbbase.S_BUSY) != 0 {
        return
    }
    let n: u64 = xhci.ports(state)
    var p: u64 = 1
    while p <= n && p < 64 {
        let hot: bool = xhci.psc_take(state, p)
        if hot || xhci.port_has_change(state, p) {
            note_change(state, p)
            xhci.port_clear_changes(state, p)
            sync_port(state, p)
        }
        p = p + 1
    }
}

fn hub_rescan(state: u64) -> u64 {
    var found: u64 = 0
    var d: u64 = 0
    while d < usbbase.MAX_DEV {
        if usbdev.dg(state, d, usbbase.D_USED) != 0 && usbdev.dg(state, d, usbbase.D_DRIVER) == usbbase.DRV_HUB {
            if usbdev.dg(state, d, usbbase.D_PORTS) == 0 {
                if usbdev.g(state, S_HUBTRY) < HUB_TRY_MAX {
                    usbdev.s(state, S_HUBTRY, usbdev.g(state, S_HUBTRY) + 1)
                    usbbind.hub_start(state, d)
                }
            } else {
                found = found + hub_rescan_ports(state, d)
            }
        }
        d = d + 1
    }
    return found
}

fn hub_rescan_ports(state: u64, d: u64) -> u64 {
    var found: u64 = 0
    let n: u64 = usbdev.dg(state, d, usbbase.D_PORTS)
    let hidx: u64 = usbdiag.info(xhci.unit(state), usbdiag.I_HUBS) - 1
    var p: u64 = 1
    while p <= n {
        if usbbind.hub_child_present(state, d, p) {
            let live: u64 = usbbind.hub_port_read(state, d, p)
            if live != usbbase.HUB_STATUS_ERR {
                found = found + usbbind.hub_ack(state, d, p, live)
            }
            if live != usbbase.HUB_STATUS_ERR && ((live & 1) == 0 || (live & (1 << 16)) != 0) {
                if (live & (1 << 16)) != 0 {
                    usbbind.hub_feature(state, d, false, usbbase.PF_C_CONNECTION, p)
                }
                usbdev.s(state, S_HUBTRY, 0)
                usbbind.hub_child_gone(state, d, p)
                found = found + 1
            }
        }
        if !usbbind.hub_child_present(state, d, p) && usbdev.g(state, S_HUBTRY) < HUB_TRY_MAX {
            let st: u64 = usbbind.hub_port_status(state, d, p)
            found = found + usbbind.hub_ack(state, d, p, st)
            if (st & (1 << 16)) != 0 {
                usbbind.hub_feature(state, d, false, usbbase.PF_C_CONNECTION, p)
                found = found + 1
            }
            if (st & 1) != 0 {
                found = found + 1
                usbdev.s(state, S_HUBTRY, usbdev.g(state, S_HUBTRY) + 1)
                usbdev.s(state, S_HUBHITS, usbdev.g(state, S_HUBHITS) + 1)
                usbbind.hub_probe_port(state, d, p, hidx, st)
            }
        }
        p = p + 1
    }
    return found
}

const HUB_MISS_MAX: u64 = 3

fn hubs_covered(state: u64) -> bool {
    if usbdev.g(state, usbbase.S_HUBMISS) >= HUB_MISS_MAX || usbbind.hub_int_disabled() {
        return false
    }
    var live: u64 = 0
    var d: u64 = 0
    while d < usbbase.MAX_DEV {
        if usbdev.dg(state, d, usbbase.D_USED) != 0 && usbdev.dg(state, d, usbbase.D_DRIVER) == usbbase.DRV_HUB {
            live = live + 1
            if !usbbind.hub_int_armed(state, d) {
                return false
            }
        }
        d = d + 1
    }
    return live != 0
}

fn port_watch(state: u64) {
    if usbdev.g(state, usbbase.S_READY) == 0 || usbdev.g(state, usbbase.S_BUSY) != 0 {
        return
    }
    if kstate.mode_on(state, kstate.M_USBSAFE) {
        return
    }
    if usbwatch.check(state) {
        return
    }
    let n: u64 = xhci.ports(state)
    let due: u64 = usbdiag.timed_due(kstate.get(state, kstate.TICKS))
    if due != 0 {
        usbdev.usbdiag_snap_all(state, xhci.unit(state), due)
    }
    var rescan: bool = usbdiag.rescan_due(kstate.get(state, kstate.TICKS), usbdev.g(state, usbbase.S_HUBS), hubs_covered(state))
    if kstate.mode_on(state, kstate.M_NOUSBRESCAN) {
        rescan = false
    }
    if rescan && usbdev.g(state, usbbase.S_HUBS) != 0 {
        usbdev.s(state, usbbase.S_HUBDUE, 1)
    }
    var p: u64 = 1
    while p <= n && p < 64 {
        if rescan && xhci.port_connected(state, p) && !usbdev.was_there(state, p) {
            usbdev.s(state, S_PEND, usbdev.g(state, S_PEND) | (1 << p))
        }
        let hot: bool = xhci.psc_take(state, p)
        if hot || xhci.port_has_change(state, p) {
            note_change(state, p)
            usbdiag.event(p, xhci.portsc(state, p))
            xhci.ev(state, usbdiag.EK_PSC_POLL, p << 20, 0)
            usbdiag.log(kstate.get(state, kstate.TICKS), usbdiag.LK_PSC, p, xhci.portsc(state, p))
            xhci.port_clear_changes(state, p)
            usbdev.s(state, S_PEND, usbdev.g(state, S_PEND) | (1 << p))
            usbdev.s(state, usbbase.S_PENDN, usbdev.g(state, usbbase.S_PENDN) + 1)
        }
        p = p + 1
    }
}

fn silence_check(state: u64) {
    if usbdev.g(state, usbbase.S_READY) == 0 || usbdev.g(state, usbbase.S_BUSY) != 0 {
        return
    }
    var still: bool = false
    var d: u64 = 0
    while d < usbbase.MAX_DEV {
        if usbdev.dg(state, d, usbbase.D_USED) != 0 && usbdev.dg(state, d, usbbase.D_INTDCI) != 0
            && usbdev.dg(state, d, usbbase.D_DRIVER) != usbbase.DRV_HUB {
            let now: u64 = usbdev.dg(state, d, usbbase.D_REPS)
            if now == usbdev.dg(state, d, D_WACH) {
                still = true
            }
            usbdev.ds(state, d, D_WACH, now)
        }
        d = d + 1
    }
    if still {
        usbdev.s(state, S_WACHN, usbdev.g(state, S_WACHN) + 1)
        xhci.drain(state)
        usbbind.service(state)
    }
    var e: u64 = 0
    while e < usbbase.MAX_DEV {
        if usbdev.dg(state, e, usbbase.D_USED) != 0 && usbdev.dg(state, e, usbbase.D_INTDCI) != 0
            && usbdev.dg(state, e, usbbase.D_DRIVER) != usbbase.DRV_HUB
            && usbdev.dg(state, e, usbbase.D_REPS) == 0 {
            usbdev.ds(state, e, D_STUMM, usbdev.dg(state, e, D_STUMM) + 1)
            if usbdev.dg(state, e, D_STUMM) >= WATCH_LIMIT
                && usbdev.dg(state, e, D_AGAIN) < AGAIN_MAX {
                if usbbind.refill(state, e) {
                    usbdev.ds(state, e, D_AGAIN, usbdev.dg(state, e, D_AGAIN) + 1)
                    usbdev.ds(state, e, D_STUMM, 0)
                    usbdev.s(state, S_WIEDERN, usbdev.g(state, S_WIEDERN) + 1)
                }
            }
        } else {
            usbdev.ds(state, e, D_STUMM, 0)
        }
        e = e + 1
    }
}

fn wiedern(state: u64) -> u64 {
    return usbdev.g(state, S_WIEDERN)
}

fn wachen(state: u64) -> u64 {
    return usbdev.g(state, S_WACHN)
}

fn hotplug_work(state: u64) {
    if usbwatch.retry_due(state) {
        let _r: bool = reinit(state)
    }
    if usbdev.g(state, usbbase.S_READY) == 0 || usbdev.g(state, usbbase.S_BUSY) != 0 {
        return
    }
    let is_open: u64 = usbdev.g(state, S_PEND) | retry_pending(state)
    let hubdue: u64 = usbdev.g(state, usbbase.S_HUBDUE)
    if is_open == 0 && hubdue == 0 {
        return
    }
    usbdev.s(state, S_PEND, 0)
    usbdev.s(state, usbbase.S_HUBDUE, 0)
    if is_open != 0 {
        chdiag.bump(state, chdiag.F_PASSES)
    }
    usbdev.s(state, usbbase.S_BUSY, 1)
    let n: u64 = xhci.ports(state)
    var p: u64 = 1
    while p <= n && p < 64 {
        if (is_open & (1 << p)) != 0 {
            sync_port(state, p)
        }
        p = p + 1
    }
    if hubdue != 0 {
        let waiting: u64 = usbbind.hub_waiting()
        let found: u64 = hub_rescan(state)
        if waiting != 0 {
            usbbind.hub_rearm(state, found)
        } else if found != 0 {
            usbdev.s(state, usbbase.S_HUBMISS, usbdev.g(state, usbbase.S_HUBMISS) + 1)
        }
    }
    usbdev.s(state, usbbase.S_BUSY, 0)
}

// ===================================================== DD-12: AFTER S3
// The controller lost its state: set it up again and enumerate again --
// the same `versuch` the first start used on the controller it kept
// (keyboard, mouse, sticks come back as new devices). False if there was
// no controller up before.
fn resume(state: u64) -> bool {
    if !usbdev.ready(state) {
        return false
    }
    return reinit(state)
}

fn reinit(state: u64) -> bool {
    let armed: bool = !kstate.mode_on(state, kstate.M_NOUSBIRQ)
    let _p: u64 = usbbind.versuch(state, usbdev.g(state, usbbase.S_CHOICE), armed)
    let ok: bool = usbdev.ready(state)
    usbwatch.reinit_done(state, ok)
    return ok
}
