profile kernel

import block.mscbind
import usb.usb

export { install }

fn hook_ready_at(state: u64, i: u64) -> u64 {
    if usb.msc_ready_at(state, i) {
        return 1
    }
    return 0
}

fn hook_blocks_at(state: u64, i: u64) -> u64 {
    return usb.msc_blocks_at(state, i)
}

fn hook_sync_at(state: u64, i: u64) -> u64 {
    if usb.msc_sync_at(state, i) {
        return 1
    }
    return 0
}

fn hook_read_at(state: u64, i: u64, lba: u64, dst: u64) -> u64 {
    if usb.msc_read_at(state, i, lba, dst) {
        return 1
    }
    return 0
}

fn hook_read_run_at(state: u64, i: u64, lba: u64, n: u64, dst: u64) -> u64 {
    if usb.msc_read_run_at(state, i, lba, n, dst) {
        return 1
    }
    return 0
}

fn hook_write_at(state: u64, i: u64, lba: u64, src: u64) -> u64 {
    if usb.msc_write_at(state, i, lba, src) {
        return 1
    }
    return 0
}

fn install() {
    mscbind.bind(mscbind.H_READY_AT, hook_ready_at as u64)
    mscbind.bind(mscbind.H_BLOCKS_AT, hook_blocks_at as u64)
    mscbind.bind(mscbind.H_SYNC_AT, hook_sync_at as u64)
    mscbind.bind(mscbind.H_READ_AT, hook_read_at as u64)
    mscbind.bind(mscbind.H_READ_RUN_AT, hook_read_run_at as u64)
    mscbind.bind(mscbind.H_WRITE_AT, hook_write_at as u64)
}
