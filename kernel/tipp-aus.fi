// SPDX-License-Identifier: GPL-2.0-only
// kernel/tipp-aus.fi -- DER KERN OHNE DIE BRUECKE.
//
// Justins Vorgabe zur Runde BRUECKE lautet wie die zur Runde TUNNEL:
//
//     „Bau das so, dass ein `--ohne-bruecke` beim Kernelbau sie
//      komplett weglaesst, nach dem Muster von gfx.fi/gfx-aus.fi und
//      wg.fi/wg-aus.fi."
//
// Das ist bei der Bruecke wichtiger als beim Tunnel, und zwar aus
// einem Grund, der nichts mit Sparsamkeit zu tun hat: DIE BRUECKE IST
// EIN FERNZUGRIFF. Ein VPN, das nicht eingerichtet ist, liegt still
// herum; ein Fernzugriff, der im Abbild steckt, ist eine Tuer, die
// jemand aufmachen KANN. Wer ein Osum ausliefert, das niemand
// fernbedienen soll -- ein Geraet in fremder Hand, eine Vorfuehrung,
// ein Kiosk --, will nicht einen abgeschalteten Fernzugriff, sondern
// GAR KEINEN.
//
// Und genau das ist der Unterschied, den diese Datei macht:
//
//   MIT `tipp.fi`      Der Aufruf 1843 gibt es. Ohne Schein antwortet
//                      er -EPERM. Das ist ein SCHLOSS.
//   MIT `tipp-aus.fi`  Den Aufruf gibt es nicht; `sysgui.tipp_call`
//                      antwortet -ENOSYS, und `/bin/bruecke` findet
//                      beim Start heraus, dass dieser Kern das nicht
//                      kann, und sagt es. Das ist eine ABWESENHEIT.
//
// Ein Schloss kann falsch zugehen. Eine Abwesenheit nicht.
//
// WAS DIESE DATEI NICHT IST: kein zweites Verhalten. Jede Funktion
// hier sagt „es gibt keinen Tippschein", und zwar in derselben Form,
// in der `kernel/tipp.fi` es sagt, solange niemand einen ausgestellt
// hat. `sysgui.fi` und `kgui.fi` brauchen deshalb keine
// Fallunterscheidung -- sie rufen dieselben Namen, und die Antworten
// bedeuten dasselbe.
//
// DIE ZAEHLER BLEIBEN, und das ist Absicht: `aktiv()` ist die Frage,
// die die Taskleiste stellt, um ihr Zeichen zu zeichnen. Sie muss
// auch in einem Abbild ohne Bruecke eine Antwort bekommen, und die
// Antwort ist „nein, niemand tippt". Eine Leiste, die diese Frage
// nicht stellen darf, muesste selbst zwei Fassungen haben.

profile kernel

import kstate

export {
    init, arm, armed, arm_pid, drop, may_inject, note,
    aktiv, eingespeist, denied, deny, arms, last_pid, gebaut,
    TIPP_NS, MAX_ANSCHLAEGE
}

// NEIN -- und das ist die eine Zeile, die diese Datei von
// `kernel/tipp.fi` unterscheidet, ohne dass irgendein Aufrufer eine
// Fallunterscheidung braucht. `sysgui.tipp_call` fragt sie als
// ERSTES und antwortet dann -ENOSYS: "diesen Aufruf gibt es hier
// nicht". Das ist etwas anderes als -EPERM ("es gibt ihn, du darfst
// nicht"), und ein Mensch, der eine Fehlermeldung liest, muss die
// beiden unterscheiden koennen.
fn gebaut() -> bool {
    return false
}

// Dieselben Namen, damit niemand sie in zwei Fassungen pflegen muss.
// Die Zahlen sind bedeutungslos, solange nichts eingespeist werden
// kann -- sie stehen hier, weil `sys.fi` sie herausgibt (TQ_MAX).
const TIPP_NS: u64 = 0
const MAX_ANSCHLAEGE: u64 = 0

fn init(state: u64) {
}

fn arm(state: u64, pid: u64) {
}

fn armed(state: u64) -> bool {
    return false
}

fn arm_pid(state: u64) -> u64 {
    return 0
}

// Die Frage der Taskleiste. Ohne Bruecke tippt nie jemand von aussen,
// also gibt es auch nie ein Zeichen zu zeichnen.
fn aktiv(state: u64) -> u64 {
    return 0
}

fn drop(state: u64) {
}

fn may_inject(state: u64, pid: u64) -> bool {
    return false
}

fn note(state: u64) {
}

fn deny(state: u64) {
}

fn eingespeist(state: u64) -> u64 {
    return 0
}

fn denied(state: u64) -> u64 {
    return 0
}

fn arms(state: u64) -> u64 {
    return 0
}

fn last_pid(state: u64) -> u64 {
    return 0
}
