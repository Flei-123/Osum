// SPDX-License-Identifier: GPL-2.0-only
// kernel/netmark.fi -- ERZEUGT AUS assets/netview/mark-*.txt.
//
// NICHT VON HAND AENDERN. `tools/netview/icons.py kern` schreibt diese
// Datei, und `tools/netview/run.sh` baut sie im Abnahmelauf noch einmal
// und vergleicht sie Oktett fuer Oktett mit der, die im Baum liegt.
// Weicht sie ab, faellt der Lauf durch.
//
// WARUM ES SIE UEBERHAUPT GIBT. Dasselbe Zeichen steht an zwei Stellen
// auf dem Schirm: am Fensterknopf in der Taskleiste (Ring 3, liest die
// OSYM-Datei von der Platte) und in der TITELLEISTE (der Fensterserver,
// mitten im Zeichnen eines Fensters, ohne Dateisystem). Zwei Stellen
// duerfen nicht zwei Zeichnungen bedeuten -- also ist die Zeichnung die
// Quelle und diese Datei ihr Abdruck.
//
// EINE REIHE JE BILDZEILE: `maske` traegt je Bildpunkt ein Bit,
// hoechstwertiges Bit links; `rollen` traegt je Bildpunkt vier Bit mit
// der Farbrolle (1 ink, 2 dim, 3 accent, 4 warn, 5 panel), niedrigstes
// Nibble ganz links.

profile kernel

export { W, H, COUNT, M_FILTERED, M_FAKED, M_NONE, mask_at, role_at }

const W: u64 = 12
const H: u64 = 12
const COUNT: u64 = 3

// Die Reihenfolge ist die der Sichten in `kernel/netview.fi`, ohne
// `real` -- der Normalfall bekommt kein Zeichen.
const M_FILTERED: u64 = 0
const M_FAKED: u64 = 1
const M_NONE: u64 = 2

fn mask_at(m: u64, y: u64) -> u64 {
    if m >= COUNT || y >= H {
        return 0
    }
    if m == 0 && y == 0 {
        return 0xF0
    }
    if m == 0 && y == 1 {
        return 0x30C
    }
    if m == 0 && y == 2 {
        return 0x402
    }
    if m == 0 && y == 3 {
        return 0xBFD
    }
    if m == 0 && y == 4 {
        return 0x9F9
    }
    if m == 0 && y == 5 {
        return 0x8F1
    }
    if m == 0 && y == 6 {
        return 0x861
    }
    if m == 0 && y == 7 {
        return 0x861
    }
    if m == 0 && y == 8 {
        return 0x801
    }
    if m == 0 && y == 9 {
        return 0x402
    }
    if m == 0 && y == 10 {
        return 0x30C
    }
    if m == 0 && y == 11 {
        return 0xF0
    }
    if m == 1 && y == 0 {
        return 0xF0
    }
    if m == 1 && y == 1 {
        return 0x30C
    }
    if m == 1 && y == 2 {
        return 0x402
    }
    if m == 1 && y == 3 {
        return 0x801
    }
    if m == 1 && y == 4 {
        return 0x985
    }
    if m == 1 && y == 5 {
        return 0xBCD
    }
    if m == 1 && y == 6 {
        return 0xA7D
    }
    if m == 1 && y == 7 {
        return 0x831
    }
    if m == 1 && y == 8 {
        return 0x801
    }
    if m == 1 && y == 9 {
        return 0x402
    }
    if m == 1 && y == 10 {
        return 0x30C
    }
    if m == 1 && y == 11 {
        return 0xF0
    }
    if m == 2 && y == 0 {
        return 0xF0
    }
    if m == 2 && y == 1 {
        return 0x31C
    }
    if m == 2 && y == 2 {
        return 0x43A
    }
    if m == 2 && y == 3 {
        return 0x871
    }
    if m == 2 && y == 4 {
        return 0x8E1
    }
    if m == 2 && y == 5 {
        return 0x9C1
    }
    if m == 2 && y == 6 {
        return 0xB81
    }
    if m == 2 && y == 7 {
        return 0xB01
    }
    if m == 2 && y == 8 {
        return 0xE01
    }
    if m == 2 && y == 9 {
        return 0x402
    }
    if m == 2 && y == 10 {
        return 0x30C
    }
    if m == 2 && y == 11 {
        return 0xF0
    }
    return 0
}

fn role_at(m: u64, y: u64) -> u64 {
    if m >= COUNT || y >= H {
        return 0
    }
    if m == 0 && y == 0 {
        return 0x11110000
    }
    if m == 0 && y == 1 {
        return 0x1100001100
    }
    if m == 0 && y == 2 {
        return 0x10000000010
    }
    if m == 0 && y == 3 {
        return 0x101111111101
    }
    if m == 0 && y == 4 {
        return 0x100111111001
    }
    if m == 0 && y == 5 {
        return 0x100011110001
    }
    if m == 0 && y == 6 {
        return 0x100001100001
    }
    if m == 0 && y == 7 {
        return 0x100001100001
    }
    if m == 0 && y == 8 {
        return 0x100000000001
    }
    if m == 0 && y == 9 {
        return 0x10000000010
    }
    if m == 0 && y == 10 {
        return 0x1100001100
    }
    if m == 0 && y == 11 {
        return 0x11110000
    }
    if m == 1 && y == 0 {
        return 0x11110000
    }
    if m == 1 && y == 1 {
        return 0x1100001100
    }
    if m == 1 && y == 2 {
        return 0x10000000010
    }
    if m == 1 && y == 3 {
        return 0x100000000001
    }
    if m == 1 && y == 4 {
        return 0x104000044001
    }
    if m == 1 && y == 5 {
        return 0x104400444401
    }
    if m == 1 && y == 6 {
        return 0x104444400401
    }
    if m == 1 && y == 7 {
        return 0x100044000001
    }
    if m == 1 && y == 8 {
        return 0x100000000001
    }
    if m == 1 && y == 9 {
        return 0x10000000010
    }
    if m == 1 && y == 10 {
        return 0x1100001100
    }
    if m == 1 && y == 11 {
        return 0x11110000
    }
    if m == 2 && y == 0 {
        return 0x11110000
    }
    if m == 2 && y == 1 {
        return 0x1120001100
    }
    if m == 2 && y == 2 {
        return 0x10222000010
    }
    if m == 2 && y == 3 {
        return 0x100022200001
    }
    if m == 2 && y == 4 {
        return 0x100002220001
    }
    if m == 2 && y == 5 {
        return 0x100000222001
    }
    if m == 2 && y == 6 {
        return 0x100000022201
    }
    if m == 2 && y == 7 {
        return 0x100000002201
    }
    if m == 2 && y == 8 {
        return 0x100000000221
    }
    if m == 2 && y == 9 {
        return 0x10000000010
    }
    if m == 2 && y == 10 {
        return 0x1100001100
    }
    if m == 2 && y == 11 {
        return 0x11110000
    }
    return 0
}
