profile kernel

import bus.drvnull

export { DisplayOps, null_ops, n_na, NA, KIND_NONE, KIND_FB, KIND_VGPU, KIND_VMSVGA }

const NA: u64 = 0xFFFFFFFFFFFFFFFF
const KIND_NONE: u64 = 0
const KIND_FB: u64 = 1
const KIND_VGPU: u64 = 2
const KIND_VMSVGA: u64 = 3

struct DisplayOps {
    ready: fn(u64) -> bool,
    present: fn(u64) -> bool,
    panic_present: fn(u64),
    frames: fn(u64) -> u64,
    present_bytes: fn(u64) -> u64,
    vram_total: fn(u64) -> u64,
    vram_used: fn(u64) -> u64,
    hw_cursor: fn(u64) -> bool,
    host_pending: fn(u64) -> u64,
    kind: u64,
    tag: u64
}

fn n_na(state: u64) -> u64 {
    return NA
}

fn null_ops() -> DisplayOps {
    return DisplayOps {
        ready: drvnull.n_false,
        present: drvnull.n_false,
        panic_present: drvnull.n_noop,
        frames: n_na,
        present_bytes: n_na,
        vram_total: n_na,
        vram_used: n_na,
        hw_cursor: drvnull.n_false,
        host_pending: drvnull.n_zero,
        kind: KIND_NONE,
        tag: 0
    }
}
