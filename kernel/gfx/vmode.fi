// ------------------------------------------------------------ Zahlen

const MAX_MODES: u64 = 48
const LIST_OFF: u64 = 0x200 // im DISP-Bereich, je Modus acht Oktette
const WHY_OFF: u64 = 0x400
const LUT_OFF: u64 = 0x000 // im DLUT-Bereich, 3 x 256 Oktette
const EDID_OFF: u64 = 0x400 // im DLUT-Bereich, EDID_BYTES Oktette
const EDID_BYTES: u64 = 384

const CONFIRM_MS: u64 = 15000

const S_READY: u64 = 0x000
const S_COUNT: u64 = 0x008
const S_VRAM: u64 = 0x010
const S_BUS: u64 = 0x018
const S_DEV: u64 = 0x020
const S_FUN: u64 = 0x028
const S_LFB: u64 = 0x030
const S_MMIO: u64 = 0x038
const S_EDID: u64 = 0x040
const S_EDIDWHY: u64 = 0x048 // warum nicht, siehe `edid_why`
const S_NATW: u64 = 0x050
const S_NATH: u64 = 0x058
const S_CUR: u64 = 0x060
const S_PEND: u64 = 0x068
const S_DEADLINE: u64 = 0x070
const S_OLDW: u64 = 0x078
const S_OLDH: u64 = 0x080
const S_SWITCHES: u64 = 0x088
const S_FAILS: u64 = 0x090
const S_REVERTS: u64 = 0x098
const S_CONFIRMS: u64 = 0x0A0
const S_DEPTHS: u64 = 0x0A8 // Bitmaske: 1<<4, 1<<8, 1<<15, 1<<16, 1<<24, 1<<32
const S_REFUSED: u64 = 0x0B0
const S_TOOBIG: u64 = 0x0B8
const S_PROBED: u64 = 0x0C0 // wie viele ueberhaupt gefragt wurden
const S_BRIGHT: u64 = 0x0C8 // 0..200, 100 = unberuehrt
const S_CONTRAST: u64 = 0x0D0 // 0..200
const S_GAMMA: u64 = 0x0D8 // 30..300, 100 = 1,00
const S_MAPLIMIT: u64 = 0x0E0
const S_UNMAPPABLE: u64 = 0x0E8
const S_MODEBITS: u64 = 0x0F0
const S_NIGHT: u64 = 0x168
const NIGHT_G_DROP: u64 = 35
const NIGHT_B_DROP: u64 = 70
const NIGHT_MAX: u64 = 100

// ===================================================== RUNDE CUSTOMRES
const CW_OK: u64 = 0
const CW_REGS: u64 = 1
const CW_VRAM: u64 = 2
const CW_LIMIT: u64 = 3
const CW_DEPTH: u64 = 4
const CW_UNSINN: u64 = 5
const CW_NOCARD: u64 = 6

const MIN_W: u64 = 320
const MIN_H: u64 = 200
const MAX_W: u64 = 8192
const MAX_H: u64 = 8192

const S_CUSTW: u64 = 0x0F8
const S_CUSTH: u64 = 0x100
const S_CUSTB: u64 = 0x108
const S_CUSTWHY: u64 = 0x110 // CW_*
const S_CUSTNUM: u64 = 0x118
const S_CUSTOM: u64 = 0x120
const S_BUSY: u64 = 0x128

const S_SAVEOK: u64 = 0x130
const S_SAVEW: u64 = 0x138
const S_SAVEH: u64 = 0x140
const S_SAVEB: u64 = 0x148
const S_SAVETRY: u64 = 0x150
const S_SAVEWHY: u64 = 0x158 // SW_*
const S_SAVEAPP: u64 = 0x160 // 1 = in diesem Start wirklich angewandt

const SW_OK: u64 = 0
const SW_KEINE: u64 = 1
const SW_BROKEN: u64 = 2
const SW_OPEN: u64 = 3
const SW_ABGELEHNT: u64 = 4
const SW_OFF: u64 = 5

const E_OK: u64 = 0
const E_NOCARD: u64 = 1
const E_NOMODE: u64 = 2
const E_NOMEM: u64 = 3
const E_SETFAIL: u64 = 4
const E_MAPFAIL: u64 = 5
const E_DEPTH: u64 = 6
const E_VRAM: u64 = 7
const E_LIMIT: u64 = 8

// --------------------------------------------------------- Bochs-VBE
const VBE_INDEX: u16 = 0x01CE
const VBE_DATA: u16 = 0x01CF
const VBE_ID: u64 = 0
const VBE_XRES: u64 = 1
const VBE_YRES: u64 = 2
const VBE_BPP: u64 = 3
const VBE_ENABLE: u64 = 4
const VBE_BANK: u64 = 5
const VBE_VWIDTH: u64 = 6
const VBE_VHEIGHT: u64 = 7
const VBE_XOFF: u64 = 8
const VBE_YOFF: u64 = 9
const VBE_VRAM64K: u64 = 10
const VBE_DISABLED: u64 = 0
const VBE_ENABLED: u64 = 0x01
const VBE_LFB: u64 = 0x40
const VBE_ID_LO: u64 = 0xB0C0
const VBE_ID_HI: u64 = 0xB0C5

const PCI_ADDR: u16 = 0xCF8
const PCI_DATA: u16 = 0xCFC
const CFG_VENDOR: u64 = 0x00
const CFG_COMMAND: u64 = 0x04
const CFG_CLASS: u64 = 0x08
const CFG_HEADER: u64 = 0x0C
const CFG_BAR0: u64 = 0x10
const CFG_BAR2: u64 = 0x18
const CMD_MEM: u64 = 0x2
const CLASS_VGA: u64 = 0x03

fn out16(port: u16, v: u16) {
    asm("out dx, ax", in("dx") port, in("ax") v)
}

fn in16(port: u16) -> u64 {
    return asm("in ax, dx\nmovzx eax, ax", out("rax"), in("dx") port)
}

fn out32(port: u16, v: u32) {
    asm("out dx, eax", in("dx") port, in("eax") v)
}

fn in32(port: u16) -> u64 {
    return asm("in eax, dx", out("rax"), in("dx") port)
}

fn vbe_write(index: u64, value: u64) {
    out16(VBE_INDEX, index as u16)
    out16(VBE_DATA, value as u16)
}

fn vbe_read(index: u64) -> u64 {
    out16(VBE_INDEX, index as u16)
    return in16(VBE_DATA)
}

fn vbe_present() -> bool {
    let id: u64 = vbe_read(VBE_ID)
    return id >= VBE_ID_LO && id <= VBE_ID_HI
}

fn cfg_addr(bus: u64, dev: u64, fun: u64, off: u64) -> u32 {
    return (0x80000000 | (bus << 16) | (dev << 11) | (fun << 8)
        | (off & 0xFC)) as u32
}

fn cfg32(bus: u64, dev: u64, fun: u64, off: u64) -> u64 {
    out32(PCI_ADDR, cfg_addr(bus, dev, fun, off))
    return in32(PCI_DATA)
}

fn cfg32_write(bus: u64, dev: u64, fun: u64, off: u64, v: u64) {
    out32(PCI_ADDR, cfg_addr(bus, dev, fun, off))
    out32(PCI_DATA, v as u32)
}

// ------------------------------------------------------ die Kandidaten
fn cand_count() -> u64 {
    return 22
}

fn cand(i: u64) -> u64 {
    if i == 0 {
        return (320 << 16) | 200
    }
    if i == 1 {
        return (640 << 16) | 400
    }
    if i == 2 {
        return (640 << 16) | 480
    }
    if i == 3 {
        return (800 << 16) | 600
    }
    if i == 4 {
        return (1024 << 16) | 768
    }
    if i == 5 {
        return (1152 << 16) | 864
    }
    if i == 6 {
        return (1280 << 16) | 720
    }
    if i == 7 {
        return (1280 << 16) | 800
    }
    if i == 8 {
        return (1280 << 16) | 1024
    }
    if i == 9 {
        return (1360 << 16) | 768
    }
    if i == 10 {
        return (1366 << 16) | 768
    }
    if i == 11 {
        return (1440 << 16) | 900
    }
    if i == 12 {
        return (1600 << 16) | 900
    }
    if i == 13 {
        return (1600 << 16) | 1200
    }
    if i == 14 {
        return (1680 << 16) | 1050
    }
    if i == 15 {
        return (1920 << 16) | 1080
    }
    if i == 16 {
        return (1920 << 16) | 1200
    }
    if i == 17 {
        return (2048 << 16) | 1152
    }
    if i == 18 {
        return (2560 << 16) | 1080
    }
    if i == 19 {
        return (2560 << 16) | 1440
    }
    if i == 20 {
        return (2560 << 16) | 1600
    }
    return (3840 << 16) | 2160
}

// ------------------------------------------------------------- Zugriff

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.DISP_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.DISP_OFF + off, v)
}

fn ready(state: u64) -> bool {
    return g(state, S_READY) != 0
}

fn count(state: u64) -> u64 {
    return g(state, S_COUNT)
}

fn mode_at(state: u64, i: u64) -> u64 {
    if i >= g(state, S_COUNT) {
        return 0
    }
    return kstate.get(state, kstate.DISP_OFF + LIST_OFF + i * 8)
}

fn mode_w(state: u64, i: u64) -> u64 {
    return (mode_at(state, i) >> 32) & 0xFFFF
}

fn mode_h(state: u64, i: u64) -> u64 {
    return (mode_at(state, i) >> 16) & 0xFFFF
}

fn mode_bpp(state: u64, i: u64) -> u64 {
    return mode_at(state, i) & 0xFFFF
}

fn find_mode(state: u64, w: u64, h: u64, bpp: u64) -> u64 {
    var i: u64 = 0
    while i < g(state, S_COUNT) {
        if mode_w(state, i) == w && mode_h(state, i) == h {
            if mode_bpp(state, i) == bpp {
                return i
            }
        }
        i = i + 1
    }
    return MAX_MODES
}

fn cand_w(i: u64) -> u64 {
    return (cand(i) >> 16) & 0xFFFF
}

fn cand_h(i: u64) -> u64 {
    return cand(i) & 0xFFFF
}

fn cand_why(state: u64, i: u64) -> u64 {
    if i >= cand_count() {
        return 0
    }
    return kstate.get8(state + kstate.DISP_OFF + WHY_OFF + i)
}

fn vram(state: u64) -> u64 {
    return g(state, S_VRAM)
}

fn depths(state: u64) -> u64 {
    return g(state, S_DEPTHS)
}

fn refused(state: u64) -> u64 {
    return g(state, S_REFUSED)
}

fn toobig(state: u64) -> u64 {
    return g(state, S_TOOBIG)
}

fn probed(state: u64) -> u64 {
    return g(state, S_PROBED)
}

fn map_limit(state: u64) -> u64 {
    return g(state, S_MAPLIMIT)
}

fn cust_w(state: u64) -> u64 {
    return g(state, S_CUSTW)
}

fn cust_h(state: u64) -> u64 {
    return g(state, S_CUSTH)
}

fn cust_bpp(state: u64) -> u64 {
    return g(state, S_CUSTB)
}

fn cust_why(state: u64) -> u64 {
    return g(state, S_CUSTWHY)
}

fn cust_num(state: u64) -> u64 {
    return g(state, S_CUSTNUM)
}

fn save_found(state: u64) -> bool {
    return g(state, S_SAVEOK) != 0
}

fn save_w(state: u64) -> u64 {
    return g(state, S_SAVEW)
}

fn save_h(state: u64) -> u64 {
    return g(state, S_SAVEH)
}

fn save_bpp(state: u64) -> u64 {
    return g(state, S_SAVEB)
}

fn save_try(state: u64) -> u64 {
    return g(state, S_SAVETRY)
}

fn save_why(state: u64) -> u64 {
    return g(state, S_SAVEWHY)
}

fn save_applied(state: u64) -> bool {
    return g(state, S_SAVEAPP) != 0
}

fn set_saved(state: u64, w: u64, h: u64, bpp: u64, v: u64) {
    s(state, S_SAVEOK, 1)
    s(state, S_SAVEW, w)
    s(state, S_SAVEH, h)
    s(state, S_SAVEB, bpp)
    s(state, S_SAVETRY, v)
}

fn set_save_why(state: u64, why: u64) {
    s(state, S_SAVEWHY, why)
}

fn set_applied(state: u64, v: u64) {
    s(state, S_SAVEAPP, v)
}

fn customs(state: u64) -> u64 {
    return g(state, S_CUSTOM)
}

fn need_bytes(w: u64, h: u64, bpp: u64) -> u64 {
    return w * h * (bpp / 8)
}

fn current(state: u64) -> u64 {
    let c: u64 = g(state, S_CUR)
    if c == 0 {
        return MAX_MODES
    }
    return c - 1
}

fn switches(state: u64) -> u64 {
    return g(state, S_SWITCHES)
}

fn fails(state: u64) -> u64 {
    return g(state, S_FAILS)
}

fn reverts(state: u64) -> u64 {
    return g(state, S_REVERTS)
}

fn confirms(state: u64) -> u64 {
    return g(state, S_CONFIRMS)
}

// ------------------------------------------------------------- Erkunden

fn find_card(state: u64) -> bool {
    var dev: u64 = 0
    while dev < 32 {
        var fun: u64 = 0
        var last: u64 = 0
        while fun <= last {
            let id: u64 = cfg32(0, dev, fun, CFG_VENDOR)
            if (id & 0xFFFF) != 0xFFFF {
                if fun == 0 {
                    if (cfg32(0, dev, 0, CFG_HEADER) & 0x00800000) != 0 {
                        last = 7
                    }
                }
                let cls: u64 = (cfg32(0, dev, fun, CFG_CLASS) >> 24) & 0xFF
                if cls == CLASS_VGA {
                    let cmd: u64 = cfg32(0, dev, fun, CFG_COMMAND)
                    if (cmd & CMD_MEM) == 0 {
                        cfg32_write(0, dev, fun, CFG_COMMAND, cmd | CMD_MEM)
                    }
                    let b0: u64 = cfg32(0, dev, fun, CFG_BAR0)
                    let b2: u64 = cfg32(0, dev, fun, CFG_BAR2)
                    if (b0 & 1) == 0 && (b0 & 0xFFFFFFF0) != 0 {
                        s(state, S_BUS, 0)
                        s(state, S_DEV, dev)
                        s(state, S_FUN, fun)
                        s(state, S_LFB, b0 & 0xFFFFFFF0)
                        if (b2 & 1) == 0 {
                            s(state, S_MMIO, b2 & 0xFFFFFFF0)
                        } else {
                            s(state, S_MMIO, 0)
                        }
                        return true
                    }
                }
            }
            fun = fun + 1
        }
        dev = dev + 1
    }
    return false
}

fn accepts(index: u64, anker: u64, value: u64) -> bool {
    vbe_write(index, anker)
    if vbe_read(index) != anker {
        return false
    }
    vbe_write(index, value)
    return vbe_read(index) == value
}

fn probe_depths() -> u64 {
    var m: u64 = 0
    if accepts(VBE_BPP, 32, 4) {
        m = m | (1 << 4)
    }
    if accepts(VBE_BPP, 32, 8) {
        m = m | (1 << 8)
    }
    if accepts(VBE_BPP, 32, 15) {
        m = m | (1 << 15)
    }
    if accepts(VBE_BPP, 32, 16) {
        m = m | (1 << 16)
    }
    if accepts(VBE_BPP, 32, 24) {
        m = m | (1 << 24)
    }
    if accepts(VBE_BPP, 8, 32) {
        m = m | (1 << 32)
    }
    return m
}

// VMSVGA backend of `probe`: the same candidate list, filtered by what the SVGA II device takes (limits, VRAM) and what this
// kernel can map. The scan-out address is VRAM + FB_OFFSET. No EDID (QEMU/VirtualBox SVGA II have none). Only 640x480 and up.
fn probe_vmsvga(state: u64) -> u64 {
    s(state, S_LFB, vmsvga.fb_phys(state))
    s(state, S_VRAM, vmsvga.vram_bytes(state))
    s(state, S_MMIO, 0)
    s(state, S_DEPTHS, 1 << 32)
    s(state, S_EDID, 0)
    s(state, S_NATW, 0)
    s(state, S_NATH, 0)
    s(state, S_EDIDWHY, 1)
    let lauf: u64 = fb.longest_run(state)
    let offset: u64 = g(state, S_LFB) & (fb.huge_size() - 1)
    var limit: u64 = 0
    if lauf * fb.huge_size() > offset {
        limit = lauf * fb.huge_size() - offset
    }
    s(state, S_MAPLIMIT, limit)
    var n: u64 = 0
    var i: u64 = 0
    while i < cand_count() && n < MAX_MODES {
        let c: u64 = cand(i)
        let w: u64 = (c >> 16) & 0xFFFF
        let h: u64 = c & 0xFFFF
        s(state, S_PROBED, g(state, S_PROBED) + 1)
        var reason: u64 = 0
        var ok: bool = true
        if w < 640 || h < 480 || !vmsvga.size_ok(state, w, h) {
            s(state, S_REFUSED, g(state, S_REFUSED) + 1)
            reason = 1
            ok = false
        }
        if ok {
            if limit == 0 || w * h * 4 > limit {
                s(state, S_UNMAPPABLE, g(state, S_UNMAPPABLE) + 1)
                reason = 3
                ok = false
            }
        }
        if ok {
            kstate.set(state, kstate.DISP_OFF + LIST_OFF + n * 8, (w << 32) | (h << 16) | 32)
            n = n + 1
        }
        kstate.set8(state + kstate.DISP_OFF + WHY_OFF + i, reason as u8)
        i = i + 1
    }
    s(state, S_COUNT, n)
    let cur: u64 = find_mode(state, fb.panel_w(state), fb.panel_h(state), 32)
    if cur < MAX_MODES {
        s(state, S_CUR, cur + 1)
    } else {
        s(state, S_CUR, 0)
    }
    s(state, S_READY, 1)
    build_lut(state)
    return n
}

// Set the mode through the active backend (VMSVGA or Bochs VBE). Returns the stride, 0 = refused.
fn backend_set(state: u64, w: u64, h: u64) -> u64 {
    if vmsvga.is_ready(state) {
        if !vmsvga.resize(state, w, h) {
            return 0
        }
        s(state, S_LFB, vmsvga.fb_phys(state))
        return vmsvga.pitch(state)
    }
    return vbe_set(w, h, 32)
}

fn probe(state: u64) -> u64 {
    s(state, S_READY, 0)
    s(state, S_COUNT, 0)
    s(state, S_REFUSED, 0)
    s(state, S_TOOBIG, 0)
    s(state, S_UNMAPPABLE, 0)
    s(state, S_PROBED, 0)
    s(state, S_BRIGHT, 100)
    s(state, S_CONTRAST, 100)
    s(state, S_GAMMA, 100)
    // VMSVGA carries the picture: its own mode list, no Bochs registers touched
    if vmsvga.is_ready(state) {
        return probe_vmsvga(state)
    }
    if !find_card(state) {
        return 0
    }
    if !vbe_present() {
        return 0
    }

    let a_x: u64 = vbe_read(VBE_XRES)
    let a_y: u64 = vbe_read(VBE_YRES)
    let a_b: u64 = vbe_read(VBE_BPP)
    let a_e: u64 = vbe_read(VBE_ENABLE)

    let k64: u64 = vbe_read(VBE_VRAM64K)
    var vm: u64 = k64 * 65536
    s(state, S_VRAM, vm)
    s(state, S_DEPTHS, probe_depths())

    edid_probe(state)

    let lauf: u64 = fb.longest_run(state)
    let offset: u64 = g(state, S_LFB) & (fb.huge_size() - 1)
    var limit: u64 = 0
    if lauf * fb.huge_size() > offset {
        limit = lauf * fb.huge_size() - offset
    }
    s(state, S_MAPLIMIT, limit)

    var n: u64 = 0
    var i: u64 = 0
    while i < cand_count() && n < MAX_MODES {
        let c: u64 = cand(i)
        let w: u64 = (c >> 16) & 0xFFFF
        let h: u64 = c & 0xFFFF
        s(state, S_PROBED, g(state, S_PROBED) + 1)
        var ok: bool = true
        if !accepts(VBE_XRES, 640, w) {
            ok = false
        }
        if ok {
            if !accepts(VBE_YRES, 480, h) {
                ok = false
            }
        }
        var reason: u64 = 0
        if !ok {
            s(state, S_REFUSED, g(state, S_REFUSED) + 1)
            reason = 1
        } else {
            let n_bytes: u64 = w * h * 4
            if vm != 0 && n_bytes > vm {
                s(state, S_TOOBIG, g(state, S_TOOBIG) + 1)
                reason = 2
                ok = false
            }
        }
        if ok {
            if limit == 0 || w * h * 4 > limit {
                s(state, S_UNMAPPABLE, g(state, S_UNMAPPABLE) + 1)
                reason = 3
                ok = false
            }
        }
        if ok {
            kstate.set(state, kstate.DISP_OFF + LIST_OFF + n * 8,
                (w << 32) | (h << 16) | 32)
            n = n + 1
        }
        kstate.set8(state + kstate.DISP_OFF + WHY_OFF + i, reason as u8)
        i = i + 1
    }
    s(state, S_COUNT, n)

    again_to(state, a_x, a_y, a_b, a_e)

    let cur: u64 = find_mode(state, fb.panel_w(state), fb.panel_h(state), 32)
    if cur < MAX_MODES {
        s(state, S_CUR, cur + 1)
    } else {
        s(state, S_CUR, 0)
    }
    s(state, S_READY, 1)
    build_lut(state)
    return n
}

fn again_to(state: u64, a_x: u64, a_y: u64, a_b: u64, a_e: u64) {
    if (a_e & VBE_ENABLED) != 0 && a_x != 0 && a_y != 0 {
        let fresh_pt: u64 = vbe_set(a_x, a_y, a_b)
        if fresh_pt != 0 {
            if fresh_pt != fb.panel_pitch(state) || a_x != fb.panel_w(state)
                || a_y != fb.panel_h(state) {
                fb.remap(state, g(state, S_LFB), a_x, a_y, fresh_pt,
                    fb.uncached(state))
            }
        }
        fb.dirty_all(state)
        fb.flush(state)
    } else {
        vbe_write(VBE_XRES, a_x)
        vbe_write(VBE_YRES, a_y)
        vbe_write(VBE_BPP, a_b)
        vbe_write(VBE_ENABLE, a_e)
    }
}

// ============================================== RUNDE CUSTOMRES
fn card_accepts(state: u64, w: u64, h: u64) -> u64 {
    if vmsvga.is_ready(state) {
        // limits only: nothing is written to the device
        if vmsvga.size_ok(state, w, h) {
            return 0
        }
        return 640
    }
    let a_x: u64 = vbe_read(VBE_XRES)
    let a_y: u64 = vbe_read(VBE_YRES)
    let a_b: u64 = vbe_read(VBE_BPP)
    let a_e: u64 = vbe_read(VBE_ENABLE)
    var blieb: u64 = 0
    if !accepts(VBE_XRES, 640, w) {
        blieb = vbe_read(VBE_XRES)
        if blieb == 0 {
            blieb = 640
        }
    }
    if blieb == 0 {
        if !accepts(VBE_YRES, 480, h) {
            blieb = vbe_read(VBE_YRES)
            if blieb == 0 {
                blieb = 480
            }
        }
    }
    again_to(state, a_x, a_y, a_b, a_e)
    return blieb
}

fn check_custom(state: u64, w: u64, h: u64, bpp: u64) -> u64 {
    s(state, S_CUSTW, w)
    s(state, S_CUSTH, h)
    s(state, S_CUSTB, bpp)
    s(state, S_CUSTNUM, 0)
    if !ready(state) || !fb.ready(state) {
        s(state, S_CUSTWHY, CW_NOCARD)
        return CW_NOCARD
    }
    if w < MIN_W || w > MAX_W {
        s(state, S_CUSTNUM, w)
        s(state, S_CUSTWHY, CW_UNSINN)
        return CW_UNSINN
    }
    if h < MIN_H || h > MAX_H {
        s(state, S_CUSTNUM, h)
        s(state, S_CUSTWHY, CW_UNSINN)
        return CW_UNSINN
    }
    if bpp != 32 {
        s(state, S_CUSTNUM, bpp)
        s(state, S_CUSTWHY, CW_DEPTH)
        return CW_DEPTH
    }
    let noetig: u64 = need_bytes(w, h, bpp)
    let vm: u64 = g(state, S_VRAM)
    if vm != 0 && noetig > vm {
        s(state, S_CUSTNUM, noetig)
        s(state, S_CUSTWHY, CW_VRAM)
        return CW_VRAM
    }
    let limit: u64 = g(state, S_MAPLIMIT)
    if limit == 0 || noetig > limit {
        s(state, S_CUSTNUM, noetig)
        s(state, S_CUSTWHY, CW_LIMIT)
        return CW_LIMIT
    }
    // W-C3: map_run also keeps DEVICES_FREE tiles free and counts the tiles other devices hold. Predict that here (fb.tile_room),
    // otherwise the switch happens, remap fails and the screen jumps back (VirtualBox: anything above 7 tiles = 14.7 MB).
    let inner: u64 = g(state, S_LFB) & (fb.huge_size() - 1)
    let tiles: u64 = (inner + noetig + fb.huge_size() - 1) / fb.huge_size()
    if tiles > fb.tile_room(state) {
        s(state, S_CUSTNUM, noetig)
        s(state, S_CUSTWHY, CW_LIMIT)
        return CW_LIMIT
    }
    // W-L2: and the tiles must be contiguous (a device tile splits the window)
    if !fb.run_room(state, tiles) {
        s(state, S_CUSTNUM, noetig)
        s(state, S_CUSTWHY, CW_LIMIT)
        return CW_LIMIT
    }
    let blieb: u64 = card_accepts(state, w, h)
    if blieb != 0 {
        s(state, S_CUSTNUM, blieb)
        s(state, S_CUSTWHY, CW_REGS)
        return CW_REGS
    }
    s(state, S_CUSTNUM, noetig)
    s(state, S_CUSTWHY, CW_OK)
    return CW_OK
}

fn why_to_e(why: u64) -> u64 {
    if why == CW_REGS {
        return E_SETFAIL
    }
    if why == CW_VRAM {
        return E_VRAM
    }
    if why == CW_LIMIT {
        return E_LIMIT
    }
    if why == CW_DEPTH {
        return E_DEPTH
    }
    if why == CW_NOCARD {
        return E_NOCARD
    }
    return E_NOMODE
}

fn set_custom(state: u64, w: u64, h: u64, bpp: u64) -> u64 {
    let why: u64 = check_custom(state, w, h, bpp)
    if why != CW_OK {
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return why_to_e(why)
    }
    let r: u64 = switch_to(state, w, h, true)
    if r == E_OK {
        if list_insert(state, w, h) {
            s(state, S_CUSTOM, g(state, S_CUSTOM) + 1)
        }
        let cur: u64 = find_mode(state, fb.panel_w(state),
            fb.panel_h(state), 32)
        if cur < MAX_MODES {
            s(state, S_CUR, cur + 1)
        } else {
            s(state, S_CUR, 0)
        }
    }
    return r
}

fn list_insert(state: u64, w: u64, h: u64) -> bool {
    if find_mode(state, w, h, 32) < MAX_MODES {
        return false
    }
    let n: u64 = g(state, S_COUNT)
    if n >= MAX_MODES {
        return false
    }
    let key: u64 = (w << 16) | h
    var i: u64 = 0
    var slot: u64 = n
    while i < n {
        let k: u64 = (mode_w(state, i) << 16) | mode_h(state, i)
        if k > key && slot == n {
            slot = i
        }
        i = i + 1
    }
    var j: u64 = n
    while j > slot {
        kstate.set(state, kstate.DISP_OFF + LIST_OFF + j * 8,
            kstate.get(state, kstate.DISP_OFF + LIST_OFF + (j - 1) * 8))
        j = j - 1
    }
    kstate.set(state, kstate.DISP_OFF + LIST_OFF + slot * 8,
        (w << 32) | (h << 16) | 32)
    s(state, S_COUNT, n + 1)
    return true
}

// ---------------------------------------------------------------- EDID
fn dtd_scan(basis: u64, start: u64, cur_count: u64, bisher: u64) -> u64 {
    var best: u64 = bisher
    var d: u64 = 0
    while d < cur_count {
        let p: u64 = basis + start + d * 18
        if (kstate.get8(p) | kstate.get8(p + 1)) != 0 {
            let hw: u64 = kstate.get8(p + 2) | ((kstate.get8(p + 4) >> 4) << 8)
            let vh: u64 = kstate.get8(p + 5) | ((kstate.get8(p + 7) >> 4) << 8)
            if hw >= 640 && vh >= 400 && hw <= 8192 && vh <= 4608 {
                if hw * vh > (best >> 16) * (best & 0xFFFF) {
                    best = (hw << 16) | vh
                }
            }
        }
        d = d + 1
    }
    return best
}

fn std_scan(dst: u64) -> u64 {
    var best: u64 = 0
    var i: u64 = 0
    while i < 8 {
        let b0: u64 = kstate.get8(dst + 38 + i * 2)
        let b1: u64 = kstate.get8(dst + 39 + i * 2)
        if b0 != 0x01 || b1 != 0x01 {
            let w: u64 = (b0 + 31) * 8
            let a: u64 = b1 >> 6
            var h: u64 = 0
            if a == 0 {
                h = w * 10 / 16
            }
            if a == 1 {
                h = w * 3 / 4
            }
            if a == 2 {
                h = w * 4 / 5
            }
            if a == 3 {
                h = w * 9 / 16
            }
            if w >= 640 && h >= 400 && w <= 8192 && h <= 4608 {
                if w * h > (best >> 16) * (best & 0xFFFF) {
                    best = (w << 16) | h
                }
            }
        }
        i = i + 1
    }
    return best
}

fn edid_probe(state: u64) {
    s(state, S_EDID, 0)
    s(state, S_NATW, 0)
    s(state, S_NATH, 0)
    let mmio: u64 = g(state, S_MMIO)
    if mmio == 0 {
        s(state, S_EDIDWHY, 1)
        return
    }
    let v: u64 = apic.map_device(state, mmio)
    if v == 0 {
        s(state, S_EDIDWHY, 2)
        return
    }
    let dst: u64 = state + kstate.DLUT_OFF + EDID_OFF
    var i: u64 = 0
    while i < EDID_BYTES {
        let w32: u64 = __mmio_read32((v +% i) as *mut u32) as u64
        kstate.set8(dst + i, (w32 & 0xFF) as u8)
        kstate.set8(dst + i + 1, ((w32 >> 8) & 0xFF) as u8)
        kstate.set8(dst + i + 2, ((w32 >> 16) & 0xFF) as u8)
        kstate.set8(dst + i + 3, ((w32 >> 24) & 0xFF) as u8)
        i = i + 4
    }
    if kstate.get8(dst) != 0 || kstate.get8(dst + 7) != 0 {
        s(state, S_EDIDWHY, 3)
        fb.unmap_slot(state, v)
        return
    }
    i = 1
    while i < 7 {
        if kstate.get8(dst + i) != 0xFF {
            s(state, S_EDIDWHY, 3)
            fb.unmap_slot(state, v)
            return
        }
        i = i + 1
    }
    var sum: u64 = 0
    i = 0
    while i < 128 {
        sum = (sum + kstate.get8(dst + i)) & 0xFF
        i = i + 1
    }
    if sum != 0 {
        s(state, S_EDIDWHY, 4)
        fb.unmap_slot(state, v)
        return
    }
    fb.unmap_slot(state, v)
    s(state, S_EDIDWHY, 0)
    s(state, S_EDID, 1)
    //     fb: nat=0x1034  (statt 3840x2160)
    //     fb: 800x600x32  quelle=0
    var best: u64 = 0
    best = dtd_scan(dst, 54, 4, best)
    var ext: u64 = kstate.get8(dst + 126)
    if ext > 2 {
        ext = 2
    }
    var e: u64 = 0
    while e < ext {
        let base: u64 = dst + 128 + e * 128
        var sum2: u64 = 0
        var k: u64 = 0
        while k < 128 {
            sum2 = (sum2 + kstate.get8(base + k)) & 0xFF
            k = k + 1
        }
        if sum2 == 0 && kstate.get8(base) == 0x02 {
            let doff: u64 = kstate.get8(base + 2)
            if doff >= 4 && doff < 127 {
                best = dtd_scan(base, doff, (127 - doff) / 18, best)
            }
        }
        e = e + 1
    }
    if best == 0 {
        best = std_scan(dst)
    }
    s(state, S_NATW, best >> 16)
    s(state, S_NATH, best & 0xFFFF)
}

//     disp: edid ok  nat=1920x1080  ven=RHT  mod=QEMU Monitor
//     fb: 800x600x32 ...
// Rueckgabe (w << 16) | h, 0 = keine brauchbare Auskunft.
fn native(state: u64) -> u64 {
    if !find_card(state) {
        return 0
    }
    edid_probe(state)
    if !edid_ok(state) {
        return 0
    }
    let w: u64 = g(state, S_NATW)
    let h: u64 = g(state, S_NATH)
    if w < 640 || h < 400 || w > 8192 || h > 4608 {
        return 0
    }
    return (w << 16) | h
}

fn edid_mm_w(state: u64) -> u64 {
    if !edid_ok(state) {
        return 0
    }
    return kstate.get8(state + kstate.DLUT_OFF + EDID_OFF + 21) * 10
}

fn edid_mm_h(state: u64) -> u64 {
    if !edid_ok(state) {
        return 0
    }
    return kstate.get8(state + kstate.DLUT_OFF + EDID_OFF + 22) * 10
}

fn dpi_scale(state: u64, w: u64) -> u64 {
    let mm: u64 = edid_mm_w(state)
    if mm < 100 || mm > 2000 || w == 0 {
        return 0
    }
    let dpi: u64 = w * 254 / (mm * 10)
    if dpi >= 280 {
        return 3
    }
    if dpi >= 150 {
        return 2
    }
    return 1
}

fn edid_ok(state: u64) -> bool {
    return g(state, S_EDID) != 0
}

fn edid_why(state: u64) -> u64 {
    return g(state, S_EDIDWHY)
}

fn edid_native_w(state: u64) -> u64 {
    return g(state, S_NATW)
}

fn edid_native_h(state: u64) -> u64 {
    return g(state, S_NATH)
}

fn edid_bytes() -> u64 {
    return 128
}

fn edid_at(state: u64, i: u64) -> u64 {
    if i >= 128 {
        return 0
    }
    return kstate.get8(state + kstate.DLUT_OFF + EDID_OFF + i)
}

fn vendor_at(state: u64, i: u64) -> u64 {
    if !edid_ok(state) || i >= 3 {
        return 0
    }
    let dst: u64 = state + kstate.DLUT_OFF + EDID_OFF
    let w: u64 = (kstate.get8(dst + 8) << 8) | kstate.get8(dst + 9)
    let sh: u64 = 10 - i * 5
    let c: u64 = (w >> sh) & 0x1F
    if c == 0 || c > 26 {
        return 63 // '?'
    }
    return 64 + c
}

fn model_at(state: u64, i: u64) -> u64 {
    if !edid_ok(state) || i >= 13 {
        return 0
    }
    let dst: u64 = state + kstate.DLUT_OFF + EDID_OFF
    var d: u64 = 0
    while d < 4 {
        let p: u64 = dst + 54 + d * 18
        if kstate.get8(p) == 0 && kstate.get8(p + 1) == 0 {
            if kstate.get8(p + 3) == 0xFC {
                let c: u64 = kstate.get8(p + 5 + i)
                if c == 0x0A {
                    return 0
                }
                return c
            }
        }
        d = d + 1
    }
    return 0
}

// -------------------------------------------------------- Moduswechsel
fn set_mode(state: u64, w: u64, h: u64, bpp: u64) -> u64 {
    if !ready(state) || !fb.ready(state) {
        return E_NOCARD
    }
    if bpp != 32 {
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return E_DEPTH
    }
    let idx: u64 = find_mode(state, w, h, 32)
    if idx >= MAX_MODES {
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return E_NOMODE
    }
    return switch_to(state, w, h, true)
}

fn switch_to(state: u64, w: u64, h: u64, arm: bool) -> u64 {
    if !ready(state) || !fb.ready(state) {
        return E_NOCARD
    }
    if w == fb.panel_w(state) && h == fb.panel_h(state) {
        let da: u64 = find_mode(state, w, h, 32)
        if da < MAX_MODES {
            s(state, S_CUR, da + 1)
        }
        return E_OK
    }

    let alt_w: u64 = fb.panel_w(state)
    let alt_h: u64 = fb.panel_h(state)
    let alt_pt: u64 = fb.panel_pitch(state)
    let alt_p: u64 = fb.phys(state)
    let alt_back: u64 = fb.back(state)
    let alt_bytes: u64 = fb.back_bytes(state)
    let alt_rot: u64 = fb.rotation(state)
    let uc: bool = fb.uncached(state)

    let noetig: u64 = w * h * 4
    var fresh_back: u64 = alt_back
    var fresh_bytes: u64 = alt_bytes
    var geholt: u64 = 0
    var geholt_n: u64 = 0
    if alt_back == 0 || alt_bytes < noetig {
        let frame: u64 = (noetig + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE + 8
        geholt = mem.frame_run(state, frame)
        if geholt == 0 {
            s(state, S_FAILS, g(state, S_FAILS) + 1)
            return E_NOMEM
        }
        geholt_n = frame
        fresh_back = geholt
        fresh_bytes = frame * mem.FRAME_SIZE
    }

    fb.set_rotation(state, 0)
    fb.set_logical(state, 0, 0)

    let pt: u64 = backend_set(state, w, h)
    if pt == 0 {
        backend_set(state, alt_w, alt_h)
        if geholt != 0 {
            mem.frame_free_run(state, geholt, geholt_n)
        }
        fb.set_rotation(state, alt_rot)
        fb.dirty_all(state)
        fb.flush(state)
        vmsvga.resized(state)
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return E_SETFAIL
    }

    if !fb.remap(state, g(state, S_LFB), w, h, pt, uc) {
        backend_set(state, alt_w, alt_h)
        fb.remap(state, alt_p, alt_w, alt_h, alt_pt, uc)
        if geholt != 0 {
            mem.frame_free_run(state, geholt, geholt_n)
        }
        fb.set_rotation(state, alt_rot)
        fb.dirty_all(state)
        fb.flush(state)
        vmsvga.resized(state)
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return E_MAPFAIL
    }

    let alt_sh: u64 = fb.shadow_addr(state)
    let alt_sh_bytes: u64 = fb.shadow_bytes(state)
    fb.set_backbuf(state, fresh_back, fresh_bytes)
    if geholt != 0 {
        // a bigger back buffer needs a bigger shadow copy of the card (diff flush); without one the diff stays off
        let new_sh: u64 = mem.frame_run(state, geholt_n)
        // no new one: switch the diff off BEFORE the old one is freed
        fb.set_shadow(state, new_sh, fresh_bytes)
        if alt_sh != 0 && alt_sh_bytes != 0 {
            mem.frame_free_run(state, alt_sh, alt_sh_bytes / mem.FRAME_SIZE)
        }
    }
    if geholt != 0 && alt_back != 0 {
        let alt_n: u64 = alt_bytes / mem.FRAME_SIZE
        mem.frame_free_run(state, alt_back, alt_n)
    }
    fb.set_rotation(state, alt_rot)
    // virtio-gpu scans out a resource of the back buffer's size: rebuild it for the new size (no-op without the driver)
    let _vg: bool = vgpu.resize(state, fb.width(state), fb.height(state))
    fb.clear(state, 0)
    fb.dirty_all(state)
    fb.flush(state)
    vmsvga.resized(state) // (no-op without the driver)
    let idx: u64 = find_mode(state, w, h, 32)
    if idx < MAX_MODES {
        s(state, S_CUR, idx + 1)
    } else {
        s(state, S_CUR, 0)
    }
    s(state, S_SWITCHES, g(state, S_SWITCHES) + 1)

    if arm {
        s(state, S_OLDW, alt_w)
        s(state, S_OLDH, alt_h)
        s(state, S_PEND, 1)
        s(state, S_DEADLINE, now_ms(state) + CONFIRM_MS)
    }
    return E_OK
}

fn follow_host(state: u64, w: u64, h: u64) -> u64 {
    if !ready(state) || !fb.ready(state) {
        return E_NOCARD
    }
    if w < 640 || h < 480 {
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return E_NOMODE
    }
    var why: u64 = check_custom(state, w, h, 32)
    // A host screen bigger than the card memory, the card's register limit (QEMU 2368x1770) or this kernel's map window (4K full screen,
    // 150 % scaling): shrink the request
    // by 1/16 steps, same aspect ratio, until it fits -- the host scales the picture, the guest stays usable.
    var tries: u64 = 0
    var nw: u64 = w
    var nh: u64 = h
    while (why == CW_VRAM || why == CW_LIMIT || why == CW_REGS) && tries < 40 {
        nw = nw * 15 / 16
        nh = nh * 15 / 16
        if nw < 640 || nh < 480 {
            break
        }
        why = check_custom(state, nw, nh, 32)
        tries = tries + 1
    }
    if why != CW_OK {
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        return why_to_e(why)
    }
    // W-C3: a switch that still fails (no contiguous frames for the back buffer, card refusal, map failure) is retried 1/16 smaller
    // instead of leaving the guest on the old size for good.
    var rc: u64 = switch_to(state, nw, nh, false)
    var again: u64 = 0
    while (rc == E_NOMEM || rc == E_SETFAIL || rc == E_MAPFAIL) && again < 6 {
        nw = nw * 15 / 16
        nh = nh * 15 / 16
        if nw < 640 || nh < 480 {
            break
        }
        if check_custom(state, nw, nh, 32) != CW_OK {
            again = again + 1
            continue
        }
        rc = switch_to(state, nw, nh, false)
        again = again + 1
    }
    return rc
}

// W-EDID: the next smaller boot size after the card (or the framebuffer window) refused w x h: (w << 16) | h, 0 = nothing smaller left.
// A width that is not a multiple of 8 (EDID 1366x768; the Bochs card reads back 1360) first loses only the odd pixels; after that 15/16
// steps keep the aspect ratio. Never below 640x480: a smaller screen is no desktop, so the last step before giving up is 640x480 itself.
fn boot_step(w: u64, h: u64) -> u64 {
    var nw: u64 = w
    var nh: u64 = h
    if (w & 7) != 0 {
        nw = w & (~7)
    } else {
        nw = (w * 15 / 16) & (~7)
        nh = h * 15 / 16
    }
    if nw < 640 || nh < 480 {
        if w > 640 || h > 480 {
            return (640 << 16) | 480
        }
        return 0
    }
    return (nw << 16) | nh
}

// r1183: the video memory of a Bochs/QEMU/VirtualBox VBE card in bytes, 0 = no such card or no plausible answer. Read BEFORE fb.init
// (vmode.probe runs after it), so the boot ladder can jump straight to a size the card holds instead of asking the card per step.
fn boot_vram() -> u64 {
    if !vbe_present() {
        return 0
    }
    let v: u64 = vbe_read(VBE_VRAM64K) * 65536
    if v < 262144 || v > 4294967296 {
        return 0
    }
    return v
}

// r1183: the boot size for a card with `vram` bytes of video memory: the largest size on the boot_step ladder (width divisible by 8, 15/16
// steps, aspect kept, never below 640x480) whose w * h * 4 fits. Pure (no hardware): w x h unchanged when vram == 0 or it fits and its
// width is divisible by 8 (the Bochs card reads other widths back rounded down -> that is the old retry 1366 -> 1360, now done here too).
// (w << 16) | h. Cannot fit even 640x480 -> 640x480 (the caller tries it once and ends in one clean "kein Rahmenpuffer" line).
fn boot_fit(w: u64, h: u64, vram: u64) -> u64 {
    if vram == 0 {
        return (w << 16) | h
    }
    var cw: u64 = w
    var ch: u64 = h
    if (cw & 7) != 0 && cw > 640 {
        cw = cw & (~7)
    }
    var guard: u64 = 0
    while cw * ch * 4 > vram && guard < 64 {
        let nx: u64 = boot_step(cw, ch)
        if nx == 0 {
            break
        }
        cw = nx >> 16
        ch = nx & 0xFFFF
        guard = guard + 1
    }
    return (cw << 16) | ch
}

// W-C3: the integer UI scale for a screen of this size when nothing better is known (no EDID size, no `uiscale=`). 2400x1350 and up
// (a 14" 2496x1664 laptop, 4K) gets 2; below stays 1. A fractional scale (125 %, 150 %) does not exist in this kernel.
fn auto_scale(w: u64, h: u64) -> u64 {
    if w >= 2400 && h >= 1350 {
        return 2
    }
    return 1
}

fn revert(state: u64) -> u64 {
    if g(state, S_PEND) == 0 {
        return E_NOMODE
    }
    let w: u64 = g(state, S_OLDW)
    let h: u64 = g(state, S_OLDH)
    s(state, S_PEND, 0)
    let r: u64 = switch_to(state, w, h, false)
    s(state, S_PEND, 0)
    s(state, S_REVERTS, g(state, S_REVERTS) + 1)
    return r
}

fn confirm(state: u64) {
    if g(state, S_PEND) != 0 {
        s(state, S_PEND, 0)
        s(state, S_CONFIRMS, g(state, S_CONFIRMS) + 1)
    }
}

fn pending(state: u64) -> bool {
    return g(state, S_PEND) != 0
}

fn deadline(state: u64) -> u64 {
    return g(state, S_DEADLINE)
}

fn remaining(state: u64) -> u64 {
    if g(state, S_PEND) == 0 {
        return 0
    }
    let now: u64 = now_ms(state)
    let bis: u64 = g(state, S_DEADLINE)
    if now >= bis {
        return 0
    }
    return bis - now
}

fn poll(state: u64) -> bool {
    if g(state, S_PEND) == 0 {
        return false
    }
    if now_ms(state) < g(state, S_DEADLINE) {
        return false
    }
    if g(state, S_BUSY) != 0 {
        return false
    }
    s(state, S_BUSY, 1)
    revert(state)
    s(state, S_BUSY, 0)
    return true
}

fn now_ms(state: u64) -> u64 {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return 0
    }
    return apic.tsc() / (hz / 1000)
}

fn vbe_set(w: u64, h: u64, bpp: u64) -> u64 {
    vbe_write(VBE_ENABLE, VBE_DISABLED)
    vbe_write(VBE_XRES, w)
    vbe_write(VBE_YRES, h)
    vbe_write(VBE_BPP, bpp)
    vbe_write(VBE_BANK, 0)
    vbe_write(VBE_XOFF, 0)
    vbe_write(VBE_YOFF, 0)
    vbe_write(VBE_ENABLE, VBE_ENABLED | VBE_LFB)
    if vbe_read(VBE_XRES) != w || vbe_read(VBE_YRES) != h {
        return 0
    }
    if vbe_read(VBE_BPP) != bpp {
        return 0
    }
    if (vbe_read(VBE_ENABLE) & VBE_ENABLED) == 0 {
        return 0
    }
    var vw: u64 = vbe_read(VBE_VWIDTH)
    if vw < w {
        vw = w
    }
    return vw * (bpp / 8)
}

fn set_picture(state: u64, bright: u64, contrast: u64, gam: u64) -> bool {
    if bright > 200 || contrast > 200 {
        return false
    }
    if gam < 30 || gam > 300 {
        return false
    }
    s(state, S_BRIGHT, bright)
    s(state, S_CONTRAST, contrast)
    s(state, S_GAMMA, gam)
    build_lut(state)
    return true
}

fn brightness(state: u64) -> u64 {
    return g(state, S_BRIGHT)
}

fn contrast(state: u64) -> u64 {
    return g(state, S_CONTRAST)
}

fn gamma(state: u64) -> u64 {
    return g(state, S_GAMMA)
}

fn lut_addr(state: u64) -> u64 {
    return state + kstate.DLUT_OFF + LUT_OFF
}

fn ipow_frac(x: u64, gam: u64) -> u64 {
    if x == 0 {
        return 0
    }
    if gam == 100 {
        return x
    }
    if x >= 255 {
        return 255
    }
    var lo: u64 = 0
    var hi: u64 = 255
    var i: u64 = 0
    while i < 16 {
        let mid: u64 = (lo + hi + 1) / 2
        if pow_q16(mid, gam) <= pow_q16_of_x(x) {
            lo = mid
        } else {
            hi = mid - 1
        }
        if lo >= hi {
            i = 16
        } else {
            i = i + 1
        }
    }
    return lo
}

fn pow_q16(v: u64, gam: u64) -> u64 {
    var basis: u64 = (v << 16) / 255
    if basis == 0 {
        return 0
    }
    var e: u64 = gam
    var erg: u64 = 65536
    // Ganzzahliger Teil.
    var int: u64 = e / 100
    while int > 0 {
        erg = (erg * basis) >> 16
        int = int - 1
    }
    var rest: u64 = e - (e / 100) * 100
    var w: u64 = basis
    var part: u64 = 50
    var k: u64 = 0
    while k < 7 {
        w = isqrt_q16(w)
        if rest >= part {
            erg = (erg * w) >> 16
            rest = rest - part
        }
        part = part / 2
        k = k + 1
    }
    return erg
}

fn pow_q16_of_x(x: u64) -> u64 {
    return (x << 16) / 255
}

fn isqrt_q16(v: u64) -> u64 {
    if v == 0 {
        return 0
    }
    var r: u64 = v
    var i: u64 = 0
    while i < 24 {
        let n: u64 = (r + (v << 16) / r) / 2
        if n == r {
            i = 24
        } else {
            r = n
            i = i + 1
        }
    }
    return r
}

fn clamp255(v: u64) -> u64 {
    if v > 255 {
        return 255
    }
    return v
}

fn night(state: u64) -> u64 {
    return g(state, S_NIGHT)
}

fn picture_neutral(state: u64) -> bool {
    if g(state, S_NIGHT) != 0 {
        return false
    }
    return g(state, S_BRIGHT) == 100 && g(state, S_CONTRAST) == 100
        && g(state, S_GAMMA) == 100
}

fn set_night(state: u64, strength: u64) -> bool {
    if strength > NIGHT_MAX {
        return false
    }
    s(state, S_NIGHT, strength)
    build_lut(state)
    return true
}

fn build_lut(state: u64) {
    let tab: u64 = lut_addr(state)
    var br: u64 = g(state, S_BRIGHT)
    var ct: u64 = g(state, S_CONTRAST)
    var gm: u64 = g(state, S_GAMMA)
    if br == 0 && ct == 0 && gm == 0 {
        br = 100
        ct = 100
        gm = 100
    }
    let nt: u64 = g(state, S_NIGHT)
    let gain_g: u64 = 100 - nt * NIGHT_G_DROP / 100
    let gain_b: u64 = 100 - nt * NIGHT_B_DROP / 100
    var i: u64 = 0
    while i < 256 {
        var v: u64 = 0
        if i >= 128 {
            v = 128 + (i - 128) * ct / 100
        } else {
            let d: u64 = (128 - i) * ct / 100
            if d < 128 {
                v = 128 - d
            }
        }
        v = clamp255(v)
        // 2. Helligkeit. 100 = unberuehrt, 0 = schwarz, 200 = doppelt.
        v = clamp255(v * br / 100)
        // 3. Gamma.
        let e: u64 = clamp255(ipow_frac(v, gm))
        kstate.set8(tab + i, e as u8)
        kstate.set8(tab + 256 + i, (e * gain_g / 100) as u8)
        kstate.set8(tab + 512 + i, (e * gain_b / 100) as u8)
        i = i + 1
    }
}

// ---------------------------------------------------------- die Zusagen

fn selftest(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    var n: u64 = 0
    if count(state) > 0 && count(state) <= cand_count() {
        n = n + 1
    }
    if vram(state) >= fb.panel_w(state) * fb.panel_h(state) * 4 {
        n = n + 1
    }
    var i: u64 = 0
    var gut: bool = true
    while i < count(state) {
        let w: u64 = mode_w(state, i)
        let h: u64 = mode_h(state, i)
        if w == 0 || h == 0 {
            gut = false
        }
        if w * h * 4 > vram(state) {
            gut = false
        }
        if w * h * 4 > map_limit(state) {
            gut = false
        }
        i = i + 1
    }
    if gut {
        n = n + 1
    }
    i = 1
    gut = true
    while i < count(state) {
        let a: u64 = (mode_w(state, i - 1) << 16) | mode_h(state, i - 1)
        let b: u64 = (mode_w(state, i) << 16) | mode_h(state, i)
        if b <= a {
            gut = false
        }
        i = i + 1
    }
    if gut {
        n = n + 1
    }
    if find_mode(state, fb.panel_w(state), fb.panel_h(state), 32) < MAX_MODES {
        n = n + 1
    }
    if find_mode(state, 777, 333, 32) >= MAX_MODES {
        n = n + 1
    }
    let vor_w: u64 = fb.panel_w(state)
    if set_mode(state, 777, 333, 32) == E_NOMODE {
        if fb.panel_w(state) == vor_w && fb.ready(state) {
            n = n + 1
        }
    }
    if set_mode(state, fb.panel_w(state), fb.panel_h(state), 16) == E_DEPTH {
        n = n + 1
    }
    if (depths(state) & (1 << 32)) != 0 {
        n = n + 1
    }
    set_picture(state, 100, 100, 100)
    let tab: u64 = lut_addr(state)
    gut = true
    i = 0
    while i < 256 {
        if kstate.get8(tab + i) != i {
            gut = false
        }
        i = i + 1
    }
    if gut {
        n = n + 1
    }
    set_picture(state, 0, 100, 100)
    gut = true
    i = 0
    while i < 256 {
        if kstate.get8(tab + i) != 0 {
            gut = false
        }
        i = i + 1
    }
    if gut {
        n = n + 1
    }
    set_picture(state, 100, 100, 220)
    if kstate.get8(tab) == 0 && kstate.get8(tab + 255) == 255 {
        if kstate.get8(tab + 128) > 150 {
            n = n + 1
        }
    }
    set_picture(state, 100, 100, 45)
    if kstate.get8(tab) == 0 && kstate.get8(tab + 255) == 255 {
        if kstate.get8(tab + 128) < 90 {
            n = n + 1
        }
    }
    set_picture(state, 100, 100, 100)
    if !set_picture(state, 300, 100, 100) && brightness(state) == 100 {
        n = n + 1
    }
    set_picture(state, 100, 130, 120)
    gut = true
    i = 1
    while i < 256 {
        if kstate.get8(tab + i) < kstate.get8(tab + i - 1) {
            gut = false
        }
        i = i + 1
    }
    if gut {
        n = n + 1
    }
    set_picture(state, 100, 100, 100)
    return n
}

fn selftest_max() -> u64 {
    return 15
}

fn selftest_custom(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    var n: u64 = 0
    let vor_w: u64 = fb.panel_w(state)
    let vor_h: u64 = fb.panel_h(state)

    if check_custom(state, 8, 600, 32) == CW_UNSINN {
        if cust_num(state) == 8 {
            n = n + 1
        }
    }
    if check_custom(state, 800, 9000, 32) == CW_UNSINN {
        if cust_num(state) == 9000 {
            n = n + 1
        }
    }
    if check_custom(state, 800, 600, 16) == CW_DEPTH {
        if cust_num(state) == 16 {
            n = n + 1
        }
    }
    let bw: u64 = 3840
    var bh: u64 = map_limit(state) / (bw * 4) + 1
    if bh > MAX_H {
        bh = MAX_H
    }
    let large: u64 = need_bytes(bw, bh, 32)
    let vm2: u64 = vram(state)
    if vm2 != 0 && vm2 <= map_limit(state) {
        n = n + 1
    } else if large > map_limit(state) {
        if check_custom(state, bw, bh, 32) == CW_LIMIT {
            if cust_num(state) == large {
                n = n + 1
            }
        }
    }
    var w2: u64 = 4096
    while w2 <= MAX_W && need_bytes(w2, 4096, 32) <= vram(state) {
        w2 = w2 + 1024
    }
    if w2 <= MAX_W {
        if check_custom(state, w2, 4096, 32) == CW_VRAM {
            if cust_num(state) == need_bytes(w2, 4096, 32) {
                n = n + 1
            }
        }
    }
    if fb.panel_w(state) == vor_w && fb.panel_h(state) == vor_h {
        if fb.ready(state) {
            n = n + 1
        }
    }
    var i: u64 = 0
    var gefunden: bool = false
    while i < cand_count() {
        if cand_w(i) == 1400 && cand_h(i) == 1050 {
            gefunden = true
        }
        i = i + 1
    }
    if !gefunden {
        if need_bytes(1400, 1050, 32) <= map_limit(state) {
            if check_custom(state, 1400, 1050, 32) == CW_OK {
                n = n + 1
            }
        }
    }
    let vorher: u64 = count(state)
    if list_insert(state, 1400, 1050) {
        var gut: bool = count(state) == vorher + 1
        i = 1
        while i < count(state) {
            let a: u64 = (mode_w(state, i - 1) << 16) | mode_h(state, i - 1)
            let b: u64 = (mode_w(state, i) << 16) | mode_h(state, i)
            if b <= a {
                gut = false
            }
            i = i + 1
        }
        if find_mode(state, 1400, 1050, 32) >= MAX_MODES {
            gut = false
        }
        if gut {
            n = n + 1
        }
        list_remove(state, 1400, 1050)
    }
    if count(state) == vorher {
        if find_mode(state, 1400, 1050, 32) >= MAX_MODES {
            n = n + 1
        }
    }
    return n
}

fn selftest_custom_max() -> u64 {
    return 9
}

fn list_remove(state: u64, w: u64, h: u64) -> bool {
    let idx: u64 = find_mode(state, w, h, 32)
    if idx >= MAX_MODES {
        return false
    }
    let n: u64 = g(state, S_COUNT)
    var j: u64 = idx
    while j + 1 < n {
        kstate.set(state, kstate.DISP_OFF + LIST_OFF + j * 8,
            kstate.get(state, kstate.DISP_OFF + LIST_OFF + (j + 1) * 8))
        j = j + 1
    }
    s(state, S_COUNT, n - 1)
    return true
}

const M_DISP: u64 = 1
const M_BIG: u64 = 2
const M_BACK: u64 = 4
const M_BAD: u64 = 8
const M_BENCH: u64 = 16
const M_ROT: u64 = 32
const M_CONFIRM: u64 = 64
const M_EDID: u64 = 128
const M_OWN: u64 = 256
const M_EIGENBAD: u64 = 512
const M_EIGENFRIST: u64 = 1024
// `deskrot90|180|270`: start the DESKTOP with the output rotated (tools/rotinput gate -- input must follow the output).
const M_DESKROT1: u64 = 2048
const M_DESKROT2: u64 = 4096
const M_DESKROT3: u64 = 8192

fn find_word(heu: u64, nadel: u64, n: u64) -> u64 {
    if heu == 0 || n == 0 {
        return 0
    }
    var i: u64 = 0
    while true {
        let c: u64 = kstate.get8(heu + i)
        if c == 0 {
            return 0
        }
        var fits: bool = true
        if i > 0 {
            let v: u64 = kstate.get8(heu + i - 1)
            if v != 32 && v != 9 {
                fits = false
            }
        }
        if fits {
            var k: u64 = 0
            while k < n {
                let a: u64 = kstate.get8(heu + i + k)
                if a == 0 || a != kstate.get8(nadel + k) {
                    fits = false
                    k = n
                } else {
                    k = k + 1
                }
            }
        }
        if fits {
            let e: u64 = kstate.get8(heu + i + n)
            if e == 0 || e == 32 || e == 9 {
                return heu + i
            }
        }
        i = i + 1
    }
    return 0
}

fn find(heu: u64, nadel: u64, n: u64) -> u64 {
    if heu == 0 || n == 0 {
        return 0
    }
    var i: u64 = 0
    while true {
        let c: u64 = kstate.get8(heu + i)
        if c == 0 {
            return 0
        }
        var k: u64 = 0
        var same: bool = true
        while k < n {
            let a: u64 = kstate.get8(heu + i + k)
            if a == 0 || a != kstate.get8(nadel + k) {
                same = false
                k = n
            } else {
                k = k + 1
            }
        }
        if same {
            return heu + i
        }
        i = i + 1
    }
    return 0
}

fn parse(state: u64, cmd: u64) {
    var w_disp: [u8; 5] = "disp\0"
    var w_big: [u8; 8] = "dispbig\0"
    var w_back: [u8; 9] = "dispback\0"
    var w_bad: [u8; 8] = "dispbad\0"
    var w_bench: [u8; 10] = "dispbench\0"
    var w_rot: [u8; 8] = "disprot\0"
    var w_conf: [u8; 12] = "dispconfirm\0"
    var w_edid: [u8; 9] = "dispedid\0"
    var w_own: [u8; 11] = "dispeigen\0\0"
    var w_eigb: [u8; 14] = "dispeigenbad\0\0"
    var w_eigf: [u8; 16] = "dispeigenfrist\0\0"
    var w_dr1: [u8; 10] = "deskrot90\0"
    var w_dr2: [u8; 11] = "deskrot180\0"
    var w_dr3: [u8; 11] = "deskrot270\0"
    var m: u64 = 0
    if cmd != 0 {
        if find_word(cmd, (&w_dr1[0]) as u64, 9) != 0 {
            m = m | M_DESKROT1
        }
        if find_word(cmd, (&w_dr2[0]) as u64, 10) != 0 {
            m = m | M_DESKROT2
        }
        if find_word(cmd, (&w_dr3[0]) as u64, 10) != 0 {
            m = m | M_DESKROT3
        }
        if find_word(cmd, (&w_disp[0]) as u64, 4) != 0 {
            m = m | M_DISP
        }
        if find_word(cmd, (&w_big[0]) as u64, 7) != 0 {
            m = m | M_BIG
        }
        if find_word(cmd, (&w_back[0]) as u64, 8) != 0 {
            m = m | M_BACK
        }
        if find_word(cmd, (&w_bad[0]) as u64, 7) != 0 {
            m = m | M_BAD
        }
        if find_word(cmd, (&w_bench[0]) as u64, 9) != 0 {
            m = m | M_BENCH
        }
        if find_word(cmd, (&w_rot[0]) as u64, 7) != 0 {
            m = m | M_ROT
        }
        if find_word(cmd, (&w_conf[0]) as u64, 11) != 0 {
            m = m | M_CONFIRM
        }
        if find_word(cmd, (&w_edid[0]) as u64, 8) != 0 {
            m = m | M_EDID
        }
        if find_word(cmd, (&w_own[0]) as u64, 9) != 0 {
            m = m | M_OWN
        }
        if find_word(cmd, (&w_eigb[0]) as u64, 12) != 0 {
            m = m | M_EIGENBAD
        }
        if find_word(cmd, (&w_eigf[0]) as u64, 14) != 0 {
            m = m | M_EIGENFRIST
        }
    }
    s(state, S_MODEBITS, m)
}

fn mode(state: u64) -> u64 {
    return g(state, S_MODEBITS)
}

fn want(state: u64, bit: u64) -> bool {
    return (g(state, S_MODEBITS) & bit) != 0
}
