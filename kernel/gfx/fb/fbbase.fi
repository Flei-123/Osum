profile kernel

const FB_OFF: u64 = 0x3C000

const FONT_OFF: u64 = 0x3C100

const S_READY: u64 = 0x000

const S_ADDR: u64 = 0x008

const S_PHYS: u64 = 0x010

const S_WIDTH: u64 = 0x018

const S_HEIGHT: u64 = 0x020

const S_PITCH: u64 = 0x028 // Oktette je Bildzeile

const S_BPP: u64 = 0x030 // Bit je Bildpunkt

const S_COLS: u64 = 0x038 // Zeichen je Textzeile

const S_ROWS: u64 = 0x040

const S_CX: u64 = 0x048 // Schreibmarke, Spalte

const S_CY: u64 = 0x050 // Schreibmarke, Zeile

const S_FG: u64 = 0x058

const S_BG: u64 = 0x060

const S_BACK: u64 = 0x068

const S_DRAW: u64 = 0x070

const S_SOURCE: u64 = 0x078 // SRC_MB oder SRC_VBE

const S_BYTES: u64 = 0x080 // pitch * height

const S_FLUSHES: u64 = 0x088

const S_CHARS: u64 = 0x090

const S_CURSOR: u64 = 0x0A0 // 1 = Textmarke sichtbar

const S_RSHIFT: u64 = 0x0A8

const S_GSHIFT: u64 = 0x0B0

const S_BSHIFT: u64 = 0x0B8

const S_ECHO: u64 = 0x0C0 // 1 = `serial.put` spiegelt hierher

const S_BLOCK: u64 = 0x0C8

const S_OFFSET: u64 = 0x0D0 // Adresse minus Block

const S_HUGES: u64 = 0x0D8

const S_DIRTY_LO: u64 = 0x0E0 // erste geaenderte Bildzeile

const S_DIRTY_HI: u64 = 0x0E8 // letzte + 1

const S_UNCACHED: u64 = 0x0F0

const S_WC: u64 = 0x7C8

const S_SLOT0: u64 = 0x738

const S_BACKBYTES: u64 = 0x740

// ================================================= RUNDE PAINT
const S_BLENDS: u64 = 0x760

const S_BLENDR: u64 = 0x768

const S_FSCALE: u64 = 0x778 // Vervielfachung der Konsolenschrift, >= 1

const S_UISCALE: u64 = 0x780

const S_STRIPE: u64 = 0x788

const S_SLOTV: u64 = 0x790

const S_RESW: u64 = 0x798

const S_RESH: u64 = 0x7A0

const S_FAIL: u64 = 0x7B0

const S_MAPPED: u64 = 0x7F0

const S_SIMDPX: u64 = 0x800

// W-PRESENT: what one frame's copy to the card cost: sum / max (microseconds) and the number of copies timed
const S_FLUS: u64 = 0x850

const S_FLMAX: u64 = 0x858

const S_FLN: u64 = 0x860

const S_FLOK: u64 = 0x868

const S_SHADOW: u64 = 0x918 // shadow buffer (same layout as the back buffer), 0 = none

const S_SHVALID: u64 = 0x920 // 1 = the shadow equals what the card shows

const S_SHBYTES: u64 = 0x928 // size of the shadow buffer

const S_DIFFSKIP: u64 = 0x930 // octets the diff did NOT write (sum)

const SCALE_FULL: u64 = 0

const SCALE_NONE: u64 = 2

const SRC_VBE: u64 = 2

const EXT_PRESENT: u64 = 0
const EXT_DRAW: u64 = 1
const EXT_SHOWN: u64 = 2

// --------------------------------------------------- Multiboot 1, 3.3

const MB_FLAGS: u64 = 0

const MB_FB_FLAG: u64 = 0x1000 // Bit 12

const MB_FB_ADDR: u64 = 88 // 64 Bit

const MB_FB_PITCH: u64 = 96

const MB_FB_WIDTH: u64 = 100

const MB_FB_HEIGHT: u64 = 104

const MB_FB_BPP: u64 = 108 // ein Oktett

const MB_FB_TYPE: u64 = 109

const MB_FB_RGB: u64 = 1 // Typ 1 = direkte Farbe

const PAGE_PWT: u64 = 8

const PAGE_PCD: u64 = 16

const PAGE_PAT_HUGE: u64 = 0x1000

const IA32_PAT: u64 = 0x277

const PAT_WC: u64 = 0x01 // Write-Combining

const ADDR_MASK: u64 = 0x000FFFFFFFFFF000

//   *** EXCEPTION 14 #PF  err=0x2  cr2=0x3f600000
//   kspur: fb.fb_bits (fb.fi:675) <- fb.slot_remap (fb.fi:3364)
const WIN_SLOTS: u64 = 16

const WIN_FIRST: u64 = 496

const WIN_VIRT: u64 = 496 * 0x200000

const HUGE_SIZE: u64 = 0x200000

const WIN_LIST: u64 = 0x12000 + 0x080 // pci.K2_SCALARS + apic.S_WIN

static mut pad_wunsch: u64 = 0

static mut rgb_want: u64 = 0

static mut canon_want: u64 = 0

const BEAT_H: u64 = 56
