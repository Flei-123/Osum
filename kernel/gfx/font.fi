
profile kernel

import lib.kstate

export { load, row, GLYPH_W, GLYPH_H, FIRST, LAST, BYTES, glyphs }

const GLYPH_W: u64 = 8
const GLYPH_H: u64 = 16
const FIRST: u64 = 0x20
const LAST: u64 = 0x7E
const BYTES: u64 = 1520 // (LAST - FIRST + 1) * GLYPH_H

fn glyphs() -> u64 {
    return LAST - FIRST + 1
}

fn put(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(dst + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
}

