fn load(base: u64) {
    part0(base + 0)
    part1(base + 152)
    part2(base + 304)
    part3(base + 456)
    part4(base + 608)
    part5(base + 760)
    part6(base + 912)
    part7(base + 1064)
    part8(base + 1216)
    part9(base + 1368)
}

fn row(base: u64, ch: u64, r: u64) -> u64 {
    if r >= GLYPH_H {
        return 0
    }
    var c: u64 = ch
    if c < FIRST || c > LAST {
        c = 0x3F // '?'
    }
    return kstate.get8(base + (c - FIRST) * GLYPH_H + r)
}
