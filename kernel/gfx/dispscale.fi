profile kernel

export { pct_for_dpi, snap_pct, whole_for_pct, PCT_MIN, PCT_MAX }

const PCT_MIN: u64 = 100
const PCT_MAX: u64 = 300
const DPI_125: u64 = 120
const DPI_150: u64 = 144
const DPI_200: u64 = 192
const DPI_250: u64 = 240
const DPI_300: u64 = 288

fn pct_for_dpi(dpi: u64) -> u64 {
    if dpi >= DPI_300 {
        return 300
    }
    if dpi >= DPI_250 {
        return 250
    }
    if dpi >= DPI_200 {
        return 200
    }
    if dpi >= DPI_150 {
        return 150
    }
    if dpi >= DPI_125 {
        return 125
    }
    return 100
}

fn snap_pct(pct: u64) -> u64 {
    if pct <= 112 {
        return 100
    }
    if pct <= 137 {
        return 125
    }
    if pct <= 162 {
        return 150
    }
    if pct <= 187 {
        return 175
    }
    if pct <= 225 {
        return 200
    }
    if pct <= 275 {
        return 250
    }
    return PCT_MAX
}

fn whole_for_pct(pct: u64) -> u64 {
    let w: u64 = (pct + 49) / 100
    if w < 1 {
        return 1
    }
    if w > 4 {
        return 4
    }
    return w
}
