// ONE MORE TERMINAL WINDOW for tty `t` (Dell 9020, 27.09.2026: Justin
// could open exactly one terminal; "Terminal" in the menu only started a
// second shell inside the kernel's console window, and while a program
// ran in the foreground there was nowhere left to type). Same size rule
// as the console window in kgui (560x380 scaled, kept on screen), each
// new one shifted by 32*k so they do not stack exactly. Owner 0 -- the
// kernel -- like the console window; the shell never reads window
// events, closing is noticed through `term_alive`.
static mut TERM_NTH: u64 = 0
fn term_new(state: u64, t: u64) -> u64 {
    if !wmbase.ready(state) {
        return 0xFFFFFFFF
    }
    let k: u64 = wmgeom.uisc(state)
    let sw: u64 = fb.width(state)
    let sh: u64 = fb.height(state)
    TERM_NTH = TERM_NTH + 1
    let shift: u64 = (TERM_NTH % 6) * 32 * k
    var x: u64 = 24 * k + 60 * k + shift
    var y: u64 = 40 * k + 40 * k + shift
    // r5xx: the window server pushes every window below the reserved band (`work_y`, the measurement board) and the
    // fixed start y of 80*k lies inside it -- all new terminals then landed on the SAME y, 32 px apart in x, and hid
    // each other almost completely. The cascade starts below the band instead.
    let band: u64 = wm.work_y(state)
    if !fb.nocascade_an(state) && y < band + 16 * k + shift {
        y = band + 16 * k + shift
    }
    var w: u64 = 560 * k
    var h: u64 = 380 * k
    if w + 48 > sw {
        w = sw - 48
    }
    if h + 80 > sh {
        h = sh - 80
    }
    if x + w + 24 > sw {
        x = 24
    }
    if y + h + 40 > sh {
        y = 40
    }
    // r1014 tabs: a terminal asked for by Ctrl+Shift+T / the '+' takes the place and size of the asking window
    let tsrc: u64 = wmtabs.tt_src(state)
    var ix: i64 = x as i64
    var iy: i64 = y as i64
    var iw: u64 = w
    var ih: u64 = h
    if tsrc < wm.MAX_WIN {
        ix = wmbase.win_x(state, tsrc)
        iy = wmbase.win_y(state, tsrc)
        iw = wmblur.win_w(state, tsrc)
        ih = wmblur.win_h(state, tsrc)
    }
    var title: [u8; 16] = "Terminal -- sh\0\0"
    let i: u64 = wm.create(state, 0, ix, iy, iw, ih, wm.K_TERM,
        (&title[0]) as u64)
    if i >= wm.MAX_WIN {
        return 0xFFFFFFFF
    }
    var app: [u8; 9] = "terminal\0"
    let _a: bool = wm.set_app(state, i, (&app[0]) as u64)
    wmterm.bind_tty(state, i, t)
    if tsrc < wm.MAX_WIN {
        wm.tt_join(state, i, tsrc)
    } else {
        wmtabs.tt_free_done(state, i)
    }
    wm.set_focus(state, i)
    return i
}

// Is window `i` still the terminal window of tty `t`? False once the
// user closed it (the slot is free or was reused by another window).
fn term_alive(state: u64, i: u64, t: u64) -> bool {
    if !wmbase.valid(state, i) {
        return false
    }
    return wmterm.tty_of(state, i) == t
}

