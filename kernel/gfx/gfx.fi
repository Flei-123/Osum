// ------------------------------------------------- der Grafiktreiber

fn gpu_ready(state: u64) -> bool {
    return vgpu.usable(state)
}

fn frame_done(state: u64) {
    if !vgpu.usable(state) {
        // VMSVGA: one UPDATE rectangle for what the copy sites wrote into VRAM (a nothing without that driver)
        if vmsvga.is_ready(state) {
            let _u: bool = vmsvga.present(state)
        }
        return
    }
    let _ok: bool = vgpu.present(state)
}

// r967: THE PANIC SCREEN MUST REACH THE HOST. trap.fi calls this after it stopped every other core: the picture is in the card's
// memory, and a driver that has to be TOLD (VMSVGA under VirtualBox with TRACES=0) needs its UPDATE now -- nobody else will ever
// call `bild_fertig` again. virtio-gpu is left alone: its present takes the command queue, which a stopped core may hold.
fn panik_present(state: u64) {
    if vgpu.usable(state) {
        return
    }
    if vmsvga.is_ready(state) {
        vmsvga.panic_present(state)
    }
}

fn gpu_event(state: u64) -> bool {
    // VMSVGA: poll the host's display hint (rate limited inside; QEMU never has one) and follow it like a custom mode
    if vmsvga.is_ready(state) && !vgpu.usable(state) {
        let hp: u64 = vmsvga.host_pending(state)
        if hp != 0 {
            let _hf: u64 = vmode.follow_host(state, hp / 65536, hp % 65536)
        }
        return false
    }
    let r: bool = vgpu.event_check(state)
    // r826: a successful re-layout of an extended desktop (head came or went) -> the window server follows
    if r && vgpu.ext_active(state) {
        wm.heads_sync(state)
    }
    // the host dragged the VM window: follow its size (single head; vmode rebuilds the scan-out through vgpu.resize)
    if r && !vgpu.ext_active(state) {
        let p: u64 = vgpu.host_pending(state)
        if p != 0 {
            let _f: u64 = vmode.follow_host(state, p / 65536, p % 65536)
        }
    }
    return r
}

// --------------------------------------------------------- der Schirm

fn ready(state: u64) -> bool {
    return fb.ready(state)
}

fn soft_backlight(state: u64, level: u64) -> bool {
    if !fb.ready(state) {
        return false
    }
    if !vmode.set_picture(state, level, 100, 100) {
        return false
    }
    if level == 100 {
        fb.set_lut(state, 0)
    } else {
        fb.set_lut(state, vmode.lut_addr(state))
    }
    fb.dirty_all(state)
    fb.flush(state)
    return true
}

fn fbperf(state: u64, which: u64) -> u64 {
    if which == 0 {
        return fb.cache_mode(state)
    }
    if which == 1 {
        return fb.pat_roh(state)
    }
    if which == 2 {
        return fb.pde_roh(state)
    }
    if which == 3 {
        return fb.perf_get(state, fb.PF_MTRR)
    }
    if which == 4 {
        return fb.perf_get(state, fb.PF_FBW)
    }
    if which == 5 {
        return fb.perf_get(state, fb.PF_FBW0)
    }
    if which == 6 {
        return fb.perf_get(state, fb.PF_COPY)
    }
    if which == 7 {
        return fb.perf_get(state, fb.PF_RAM)
    }
    if which == 8 {
        return fb.flush_us_n(state)
    }
    if which == 9 {
        return fb.flush_us_sum(state)
    }
    if which == 10 {
        return fb.flush_us_max(state)
    }
    if which == 11 {
        return fb.flush_okt(state)
    }
    return 0
}

