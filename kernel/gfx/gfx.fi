const GPU_NA: u64 = 0xFFFFFFFFFFFFFFFF

fn gpu_backend(state: u64) -> u64 {
    if vgpu.usable(state) {
        return 2
    }
    if vmsvga.is_ready(state) {
        return 3
    }
    if fb.ready(state) {
        return 1
    }
    return 0
}

fn gpu_frames(state: u64) -> u64 {
    let b: u64 = gpu_backend(state)
    if b == 2 {
        return vgpu.flushes(state)
    }
    if b == 3 {
        return vmsvga.present_frames(state)
    }
    if b == 1 {
        return fb.presents(state)
    }
    return GPU_NA
}

fn gpu_present_bytes(state: u64) -> u64 {
    if gpu_backend(state) == 2 {
        return vgpu.oktette(state)
    }
    return GPU_NA
}

fn gpu_vram_total(state: u64) -> u64 {
    let b: u64 = gpu_backend(state)
    if b == 3 && vmsvga.vram_bytes(state) != 0 {
        return vmsvga.vram_bytes(state)
    }
    if b == 1 && fb.bytes(state) != 0 {
        return fb.bytes(state)
    }
    return GPU_NA
}

fn gpu_vram_used(state: u64) -> u64 {
    let b: u64 = gpu_backend(state)
    if (b == 1 || b == 3) && fb.bytes(state) != 0 {
        return fb.bytes(state)
    }
    return GPU_NA
}

fn gpu_hw_cursor(state: u64) -> u64 {
    let b: u64 = gpu_backend(state)
    if b == 2 {
        if vgpu.cursor_an(state) {
            return 1
        }
        return 0
    }
    if b == 3 {
        if vmsvga.cursor_ready(state) {
            return 1
        }
        return 0
    }
    return 0
}
