fn sys_wm(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64,
    a3: u64, a4: u64) -> u64 {
    // r1138: one window server, one lock (see atomic.L_GUI)
    atomic.lock_take(state, atomic.L_GUI, cpu.here(state))
    let r: u64 = sysgui.wm_call(state, me, number, a0, a1, a2, a3, a4)
    atomic.lock_give(state, atomic.L_GUI)
    return r
}

fn sys_wig(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64,
    a3: u64, a4: u64) -> u64 {
    atomic.lock_take(state, atomic.L_GUI, cpu.here(state))
    let r: u64 = sysgui.wig_call(state, me, number, a0, a1, a2, a3, a4)
    atomic.lock_give(state, atomic.L_GUI)
    return r
}

