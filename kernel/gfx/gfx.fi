// ------------------------------------------------------ das Zeigegeraet

fn mouse_adopt(state: u64, w: u64, h: u64) {
    ps2m.adopt(state, w, h)
}

fn mouse_packet(state: u64, b0: u64, b1: u64, b2: u64, b3: u64,
    four: bool) {
    ps2m.usb_packet(state, b0, b1, b2, b3, four)
}

// W1 (input): absolute pointer (tablet) -- put the pointer on a screen position, the window server sees it at once.
fn mouse_set_pos(state: u64, x: u64, y: u64) {
    ps2m.set_pos(state, x, y)
    mouse_now(state)
}

// r804: horizontal wheel step (+1 right, -1 left) from the HID layer; the window server sees it at once.
fn mouse_hwheel(state: u64, r: i64) {
    ps2m.hwheel_add(state, r)
    mouse_now(state)
}

fn mouse_swipe(state: u64, dir: u64, n: u64) -> bool {
    return wm.swipe_do(state, dir, n)
}

// W-TPSET2: a touchpad gesture action (lib/touchgest A_*) for the window server.
fn mouse_gest_action(state: u64, act: u64, n: u64) -> bool {
    return wm.gest_action(state, act, n)
}

fn mouse_irq(state: u64) {
    ps2m.irq(state)
}

fn wm_poll(state: u64) -> bool {
    kgui.dnd_pump(state) // W-DND: a path dropped on a terminal
    kgui.termclip_pump(state) // r1014: terminal copy / paste
    return wm.poll(state)
}

fn mouse_now(state: u64) {
    if ps2m.changed(state) {
        let _c: bool = ps2m.take_change(state)
        wm.on_mouse(state)
    }
}

fn disp_poll(state: u64) -> bool {
    // ROUND LAP1: re-read /etc/mouse.conf when it changed (idle task)
    ptrcfg.poll(state)
    return vmode.poll(state)
}

fn disp_restore(state: u64) {
    dispsave.anwenden(state)
    // ROUND LAP1: pointer speed/accel from /etc/mouse.conf
    let _pc: bool = ptrcfg.load(state)
}

fn table_tick(state: u64) {
    kgui.board_tick(state)
}

