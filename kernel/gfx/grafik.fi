//     grafik: weg tafel=2560x1440 bild=2560x1440 gezogen=NEIN ...

profile kernel

import serial
import lib.kstate
import bus.pci
import gfx.gfx

export {
    bericht, stage, wanted,
    gpu_index, gpu_count, ist_grafik,
    HERST_INTEL, HERST_AMD, HERST_NVIDIA, HERST_QEMU, HERST_VMWARE,
    HERST_VIRTIO, HERST_ANDERE
}

// ------------------------------------------------------- die Klassen
const CLASS_DISPLAY: u64 = 0x03
const SUB_VGA: u64 = 0x00
const SUB_XGA: u64 = 0x01
const SUB_3D: u64 = 0x02

const V_INTEL: u64 = 0x8086
const V_AMD: u64 = 0x1002 // die Grafiksparte, ehemals ATI
const V_AMD_CPU: u64 = 0x1022
const V_NVIDIA: u64 = 0x10DE
const V_QEMU: u64 = 0x1234 // der Bochs-VBE-Aufsatz, QEMUs Standardkarte
const V_VMWARE: u64 = 0x15AD
const V_VIRTIO: u64 = 0x1AF4 // virtio-gpu
const V_REDHAT: u64 = 0x1B36

const HERST_ANDERE: u64 = 0
const HERST_INTEL: u64 = 1
const HERST_AMD: u64 = 2
const HERST_NVIDIA: u64 = 3
const HERST_QEMU: u64 = 4
const HERST_VMWARE: u64 = 5
const HERST_VIRTIO: u64 = 6

fn hersteller_von(v: u64) -> u64 {
    if v == V_INTEL {
        return HERST_INTEL
    }
    if v == V_AMD || v == V_AMD_CPU {
        return HERST_AMD
    }
    if v == V_NVIDIA {
        return HERST_NVIDIA
    }
    if v == V_QEMU {
        return HERST_QEMU
    }
    if v == V_VMWARE {
        return HERST_VMWARE
    }
    if v == V_VIRTIO || v == V_REDHAT {
        return HERST_VIRTIO
    }
    return HERST_ANDERE
}

fn hersteller_name(h: u64) {
    var s_i: [u8; 6] = "Intel\0"
    var s_a: [u8; 4] = "AMD\0"
    var s_n: [u8; 7] = "NVIDIA\0"
    var s_q: [u8; 15] = "QEMU/Bochs-VBE\0"
    var s_v: [u8; 7] = "VMware\0"
    var s_o: [u8; 7] = "virtio\0"
    var s_u: [u8; 10] = "unbekannt\0"
    if h == HERST_INTEL {
        serial.puts((&s_i[0]) as u64)
        return
    }
    if h == HERST_AMD {
        serial.puts((&s_a[0]) as u64)
        return
    }
    if h == HERST_NVIDIA {
        serial.puts((&s_n[0]) as u64)
        return
    }
    if h == HERST_QEMU {
        serial.puts((&s_q[0]) as u64)
        return
    }
    if h == HERST_VMWARE {
        serial.puts((&s_v[0]) as u64)
        return
    }
    if h == HERST_VIRTIO {
        serial.puts((&s_o[0]) as u64)
        return
    }
    serial.puts((&s_u[0]) as u64)
}

// ------------------------------------------------------- die Ausgabe

fn tag() {
    var s: [u8; 9] = "grafik: \0"
    serial.puts((&s[0]) as u64)
}

fn line(p: u64) {
    tag()
    serial.puts(p)
    serial.nl()
}

// ------------------------------------------------------- das Finden

fn ist_grafik(state: u64, i: u64) -> bool {
    return pci.get(state, i, pci.E_CLASS) == CLASS_DISPLAY
}

fn gpu_count(state: u64) -> u64 {
    let n: u64 = pci.count(state)
    var c: u64 = 0
    var i: u64 = 0
    while i < n {
        if ist_grafik(state, i) {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn gpu_index(state: u64) -> u64 {
    let n: u64 = pci.count(state)
    var i: u64 = 0
    while i < n {
        if ist_grafik(state, i) {
            if pci.get(state, i, pci.E_SUBCLASS) == SUB_VGA {
                return i
            }
        }
        i = i + 1
    }
    i = 0
    while i < n {
        if ist_grafik(state, i) {
            return i
        }
        i = i + 1
    }
    return pci.MAX_DEV
}

// ------------------------------------------------------- die Zeilen

fn gpu_line(state: u64, i: u64) {
    var s_gpu: [u8; 8] = "gpu bdf\0"
    var s_eq: [u8; 2] = "=\0"
    var s_id: [u8; 6] = "  id=\0"
    var s_her: [u8; 8] = "  herst\0"
    var s_kl: [u8; 9] = "  klasse\0"
    var s_rev: [u8; 7] = "  rev=\0"
    let bdf: u64 = pci.get(state, i, pci.E_BDF)
    tag()
    serial.puts((&s_gpu[0]) as u64)
    serial.puts((&s_eq[0]) as u64)
    pci.hexn(pci.bdf_bus(bdf), 2)
    serial.put(58 as u8) // ':'
    pci.hexn(pci.bdf_dev(bdf), 2)
    serial.put(46 as u8) // '.'
    pci.hexn(pci.bdf_fn(bdf), 1)
    serial.puts((&s_id[0]) as u64)
    pci.hexn(pci.get(state, i, pci.E_VENDOR), 4)
    serial.put(58 as u8)
    pci.hexn(pci.get(state, i, pci.E_DEVICE), 4)
    serial.puts((&s_her[0]) as u64)
    serial.puts((&s_eq[0]) as u64)
    hersteller_name(hersteller_von(pci.get(state, i, pci.E_VENDOR)))
    serial.puts((&s_kl[0]) as u64)
    serial.puts((&s_eq[0]) as u64)
    pci.hexn(pci.get(state, i, pci.E_CLASS), 2)
    serial.put(58 as u8)
    pci.hexn(pci.get(state, i, pci.E_SUBCLASS), 2)
    serial.put(58 as u8)
    pci.hexn(pci.get(state, i, pci.E_PROGIF), 2)
    serial.puts((&s_rev[0]) as u64)
    pci.hexn(pci.cfg_read8(bdf, 0x08), 2)
    serial.nl()
}

fn bar_lines(state: u64, i: u64) {
    var s_bar: [u8; 8] = "gpu bar\0"
    var s_eq: [u8; 2] = "=\0"
    var s_sz: [u8; 8] = "  gross\0"
    var s_io: [u8; 8] = "  (tor)\0"
    var s_mm: [u8; 11] = "  (speich\0\0"
    var s_64: [u8; 6] = ", 64\0\0"
    var s_32: [u8; 6] = ", 32\0\0"
    var s_pf: [u8; 12] = ", vorlad)\0\0\0"
    var s_np: [u8; 3] = ")\0\0"
    var s_kib: [u8; 5] = " KiB\0"
    var s_mib: [u8; 5] = " MiB\0"
    var s_okt: [u8; 9] = " Oktett\0\0"
    var b: u64 = 0
    while b < 6 {
        let sz: u64 = pci.bar_size(state, i, b)
        if sz != 0 {
            let fl: u64 = pci.bar_flags(state, i, b)
            tag()
            serial.puts((&s_bar[0]) as u64)
            serial.dec(b)
            serial.puts((&s_eq[0]) as u64)
            serial.hex(pci.bar(state, i, b))
            serial.puts((&s_sz[0]) as u64)
            serial.puts((&s_eq[0]) as u64)
            if sz >= 1048576 {
                serial.dec(sz / 1048576)
                serial.puts((&s_mib[0]) as u64)
            } else if sz >= 1024 {
                serial.dec(sz / 1024)
                serial.puts((&s_kib[0]) as u64)
            } else {
                serial.dec(sz)
                serial.puts((&s_okt[0]) as u64)
            }
            if pci.bar_is_io(state, i, b) {
                serial.puts((&s_io[0]) as u64)
            } else {
                serial.puts((&s_mm[0]) as u64)
                // Bit 1-2: 00 = 32 Bit, 10 = 64 Bit. Bit 3: vorladbar.
                if ((fl >> 1) & 3) == 2 {
                    serial.puts((&s_64[0]) as u64)
                } else {
                    serial.puts((&s_32[0]) as u64)
                }
                if (fl & 8) != 0 {
                    serial.puts((&s_pf[0]) as u64)
                } else {
                    serial.puts((&s_np[0]) as u64)
                }
            }
            serial.nl()
        }
        b = b + 1
    }
}

fn gpu_lines(state: u64) {
    var s_no: [u8; 47] = "gpu=NONE -- no class 03 device on this bus\0\0\0\0\0"
    var s_n: [u8; 15] = "gpu anzahl=\0\0\0\0"
    var s_main: [u8; 25] = "  (the first is the VGA)\0"
    let n: u64 = pci.count(state)
    let c: u64 = gpu_count(state)
    if c == 0 {
        line((&s_no[0]) as u64)
        return
    }
    tag()
    serial.puts((&s_n[0]) as u64)
    serial.dec(c)
    if c > 1 {
        serial.puts((&s_main[0]) as u64)
    }
    serial.nl()
    var i: u64 = 0
    while i < n {
        if ist_grafik(state, i) {
            gpu_line(state, i)
            bar_lines(state, i)
        }
        i = i + 1
    }
}

// ------------------------------------------------- der Anzeigeweg
fn gone_line(state: u64) {
    var s_w: [u8; 5] = "weg \0"
    var s_t: [u8; 7] = "tafel=\0"
    var s_b: [u8; 8] = "  bild=\0"
    var s_x: [u8; 2] = "x\0"
    var s_g: [u8; 12] = "  gezogen=\0\0"
    var s_ja: [u8; 3] = "JA\0"
    var s_ne: [u8; 5] = "NEIN\0"
    var s_p: [u8; 10] = "  pitch=\0\0"
    var s_sl: [u8; 2] = "/\0"
    if !gfx.ready(state) {
        return
    }
    let bw: u64 = gfx.width(state)
    let bh: u64 = gfx.height(state)
    let tw: u64 = gfx.fb_panel_w(state)
    let th: u64 = gfx.fb_panel_h(state)
    tag()
    serial.puts((&s_w[0]) as u64)
    serial.puts((&s_t[0]) as u64)
    serial.dec(tw)
    serial.puts((&s_x[0]) as u64)
    serial.dec(th)
    serial.puts((&s_b[0]) as u64)
    serial.dec(bw)
    serial.puts((&s_x[0]) as u64)
    serial.dec(bh)
    serial.puts((&s_g[0]) as u64)
    if tw != bw || th != bh {
        serial.puts((&s_ja[0]) as u64)
    } else {
        serial.puts((&s_ne[0]) as u64)
    }
    serial.puts((&s_p[0]) as u64)
    serial.dec(gfx.fb_panel_pitch(state))
    serial.puts((&s_sl[0]) as u64)
    serial.dec(gfx.fb_pitch(state))
    serial.nl()
}

fn buffer_line(state: u64) {
    var s_p: [u8; 8] = "puffer \0"
    var s_zw: [u8; 8] = "zweit=\0\0"
    var s_ja: [u8; 3] = "ja\0"
    var s_ne: [u8; 6] = "nein\0\0"
    var s_st: [u8; 12] = "  streifen=\0"
    var s_uc: [u8; 12] = "  uncached=\0"
    var s_ui: [u8; 11] = "  uiskala=\0"
    var s_pr: [u8; 13] = "  presents=\0\0"
    if !gfx.ready(state) {
        return
    }
    tag()
    serial.puts((&s_p[0]) as u64)
    serial.puts((&s_zw[0]) as u64)
    if gfx.fb_double_buffered(state) {
        serial.puts((&s_ja[0]) as u64)
    } else {
        serial.puts((&s_ne[0]) as u64)
    }
    serial.puts((&s_st[0]) as u64)
    if gfx.fb_stripe(state) {
        serial.puts((&s_ja[0]) as u64)
    } else {
        serial.puts((&s_ne[0]) as u64)
    }
    serial.puts((&s_uc[0]) as u64)
    if gfx.fb_uncached(state) {
        serial.puts((&s_ja[0]) as u64)
    } else {
        serial.puts((&s_ne[0]) as u64)
    }
    serial.puts((&s_ui[0]) as u64)
    serial.dec(gfx.fb_uiscale(state))
    serial.puts((&s_pr[0]) as u64)
    serial.dec(gfx.fb_presents(state))
    serial.nl()
}

fn source_line(state: u64) {
    var s_q: [u8; 8] = "quelle \0"
    var s_mb: [u8; 41] = "multiboot (the loader, UEFI-GOP or VESA)\0"
    var s_vbe: [u8; 32] = "vbe (the kernel set the mode \0\0\0"
    var s_vbe2: [u8; 8] = "itself)\0"
    var s_no: [u8; 31] = "NONE -- no framebuffer present\0"
    var s_ph: [u8; 10] = "  phys=\0\0\0"
    var s_by: [u8; 11] = "  oktette=\0"
    var s_bp: [u8; 8] = "  bpp=\0\0"
    if !gfx.ready(state) {
        line((&s_no[0]) as u64)
        return
    }
    tag()
    serial.puts((&s_q[0]) as u64)
    if gfx.fb_from_multiboot(state) {
        serial.puts((&s_mb[0]) as u64)
    } else {
        serial.puts((&s_vbe[0]) as u64)
        serial.puts((&s_vbe2[0]) as u64)
    }
    serial.puts((&s_ph[0]) as u64)
    serial.hex(gfx.fb_phys(state))
    serial.puts((&s_by[0]) as u64)
    serial.dec(gfx.fb_bytes(state))
    serial.puts((&s_bp[0]) as u64)
    serial.dec(gfx.fb_bpp(state))
    serial.nl()
}

fn mapping_line(state: u64) {
    var s_z: [u8; 12] = "zuordnung \0\0"
    var s_in: [u8; 20] = "bildspeicher in bar\0"
    var s_der: [u8; 12] = " der gpu\0\0\0\0"
    var s_kein: [u8; 47] = "bildspeicher in KEINEM bar der gpu (Firmware)\0\0"
    var s_without: [u8; 27] = "no gpu, no assignment\0\0\0\0\0\0"
    if !gfx.ready(state) {
        return
    }
    let g: u64 = gpu_index(state)
    if g >= pci.MAX_DEV {
        line((&s_without[0]) as u64)
        return
    }
    let p: u64 = gfx.fb_phys(state)
    var b: u64 = 0
    while b < 6 {
        let sz: u64 = pci.bar_size(state, g, b)
        if sz != 0 {
            if !pci.bar_is_io(state, g, b) {
                let a: u64 = pci.bar(state, g, b)
                if p >= a {
                    if p - a < sz {
                        tag()
                        serial.puts((&s_in[0]) as u64)
                        serial.dec(b)
                        serial.puts((&s_der[0]) as u64)
                        serial.nl()
                        return
                    }
                }
            }
        }
        b = b + 1
    }
    line((&s_kein[0]) as u64)
}

fn state_line() {
    var s1: [u8; 62] = "stand treiber=KEINER  3d=KEINES  opengl=NEIN  vulkan=NEIN\0\0\0\0\0"
    var s2: [u8; 65] = "state: everything is drawn by the main processor (kernel/fb)\0\0\0\0\0"
    line((&s1[0]) as u64)
    line((&s2[0]) as u64)
}

// ------------------------------------------------------- der Bericht

fn bericht(state: u64) {
    var s_top: [u8; 65] = "-------------------- OSUM GRAFIK-ERHEBUNG --------------------\0\0\0"
    var s_end: [u8; 65] = "-------------------- ENDE DER ERHEBUNG -----------------------\0\0\0"
    line((&s_top[0]) as u64)
    gpu_lines(state)
    source_line(state)
    gone_line(state)
    buffer_line(state)
    mapping_line(state)
    state_line()
    line((&s_end[0]) as u64)
}

fn wanted(cmd: u64) -> bool {
    var w: [u8; 7] = "grafik\0"
    if cmd == 0 {
        return false
    }
    return find(cmd, (&w[0]) as u64, 6) != 0
}

fn find(heu: u64, nadel: u64, n: u64) -> u64 {
    if heu == 0 || n == 0 {
        return 0
    }
    var i: u64 = 0
    while true {
        let c: u64 = kstate.get8(heu + i)
        if c == 0 {
            return 0
        }
        var k: u64 = 0
        var same: bool = true
        while k < n {
            let a: u64 = kstate.get8(heu + i + k)
            if a == 0 || a != kstate.get8(nadel + k) {
                same = false
                k = n
            } else {
                k = k + 1
            }
        }
        if same {
            return heu + i
        }
        i = i + 1
    }
    return 0
}

fn stage(state: u64, cmd: u64) {
    if !wanted(cmd) {
        return
    }
    bericht(state)
}
