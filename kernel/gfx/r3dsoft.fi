// SPDX-License-Identifier: GPL-2.0-only
// kernel/r3dsoft.fi -- RUNDE GRAFIK-1, ETAPPE C: DREIECKE IN SOFTWARE.

profile kernel

import lib.kstate
import mm.mem
import serial

export {
    start, end, active, clear, matrix, licht, textur, dreieck,
    dreiecke, points, bildpunkte, name, sin_fx, last_brightness,
    einheitsmatrix, mat_mul, proj_set, rot_x, rot_y, verschieben,
    selbsttest
}

// ---------------------------------------------------- der Zustand
const R3D_OFF: u64 = 0xAC000
const R3D_MAX: u64 = 16384

const S_ACTIVE: u64 = 0x000
const S_TARGET: u64 = 0x008
const S_W: u64 = 0x010
const S_H: u64 = 0x018
const S_PITCH: u64 = 0x020
const S_TIEFE: u64 = 0x028 // der Tiefenpuffer
const S_TIEFE_N: u64 = 0x030
const S_TEX: u64 = 0x038
const S_TEXW: u64 = 0x040
const S_TEXH: u64 = 0x048
const S_TEXMW: u64 = 0x050 // Maske = w-1
const S_TEXMH: u64 = 0x058
const S_LX: u64 = 0x060 // Lichtrichtung, 16.16, normiert
const S_LY: u64 = 0x068
const S_LZ: u64 = 0x070
const S_LSTAERKE: u64 = 0x078
const S_LGRUND: u64 = 0x080
const S_DREIECKE: u64 = 0x088
const S_POINTS: u64 = 0x090
const S_BILDPUNKTE: u64 = 0x098
const S_SIN: u64 = 0x0A0 // die Sinustabelle, 1024 Woerter
const S_SIN_N: u64 = 0x0A8
const S_TEX_OWN: u64 = 0x0B0
const S_TEX_N: u64 = 0x0B8
const S_LETZTHELL: u64 = 0x0C0

const S_MAT: u64 = 0x100
const MAT_WORTE: u64 = 16
const MAT_OKTETTE: u64 = 128

const FIX_SHIFT: u64 = 16
const FIX_ONE: u64 = 65536
const SIN_N: u64 = 1024

const M_MODELL: u64 = 0
const M_VIEW: u64 = 1
const M_PROJ: u64 = 2

const TIEFE_FERN: u64 = 0x7FFFFFFFFFFFFFFF

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, R3D_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, R3D_OFF + off, v)
}

fn name() {
    var n: [u8; 24] = "software (r3dsoft.fi)\0\0\0"
    serial.puts((&n[0]) as u64)
}

fn active(state: u64) -> bool {
    return g(state, S_ACTIVE) != 0
}

// ---------------------------------------------------- Festkomma

fn fx_mul(a: u64, b: u64) -> u64 {
    let na: bool = (a >> 63) != 0
    let nb: bool = (b >> 63) != 0
    var ua: u64 = a
    var ub: u64 = b
    if na {
        ua = 0 -% a
    }
    if nb {
        ub = 0 -% b
    }
    let p: u64 = (ua *% ub) >> FIX_SHIFT
    if na != nb {
        return 0 -% p
    }
    return p
}

fn fx_div(a: u64, b: u64) -> u64 {
    if b == 0 {
        return 0
    }
    let na: bool = (a >> 63) != 0
    let nb: bool = (b >> 63) != 0
    var ua: u64 = a
    var ub: u64 = b
    if na {
        ua = 0 -% a
    }
    if nb {
        ub = 0 -% b
    }
    if ub == 0 {
        return 0
    }
    let q: u64 = (ua << FIX_SHIFT) / ub
    if na != nb {
        return 0 -% q
    }
    return q
}

fn ist_neg(x: u64) -> bool {
    return (x >> 63) != 0
}

fn slt(a: u64, b: u64) -> bool {
    let na: bool = ist_neg(a)
    let nb: bool = ist_neg(b)
    if na != nb {
        return na
    }
    return a < b
}

// -------------------------------------------------- die Sinustabelle
//     x' = x*c - y*s
//     y' = x*s + y*c
const SCHRITT_COS: u64 = 4294959042
const SCHRITT_SIN: u64 = 26353589

fn build_sin_table(state: u64) {
    let t: u64 = g(state, S_SIN)
    if t == 0 {
        return
    }
    // In 32.32 rechnen: x = 1.0, y = 0.0
    var x: u64 = 1 << 32
    var y: u64 = 0
    var i: u64 = 0
    while i < SIN_N {
        var w: u64 = 0
        if ist_neg(y) {
            w = 0 -% ((0 -% y) >> 16)
        } else {
            w = y >> 16
        }
        kstate.set(t, i * 8, w)
        // einen Schritt weiterdrehen, in 32.32
        let nx: u64 = mul3232(x, SCHRITT_COS) -% mul3232(y, SCHRITT_SIN)
        let ny: u64 = mul3232(x, SCHRITT_SIN) +% mul3232(y, SCHRITT_COS)
        x = nx
        y = ny
        i = i + 1
    }
    kstate.set(t, 0, 0)
    kstate.set(t, 256 * 8, FIX_ONE)
    kstate.set(t, 512 * 8, 0)
    kstate.set(t, 768 * 8, 0 -% FIX_ONE)
}

fn mul3232(a: u64, b: u64) -> u64 {
    let na: bool = ist_neg(a)
    let nb: bool = ist_neg(b)
    var ua: u64 = a
    var ub: u64 = b
    if na {
        ua = 0 -% a
    }
    if nb {
        ub = 0 -% b
    }
    let p: u64 = (ua >> 16) *% (ub >> 16)
    if na != nb {
        return 0 -% p
    }
    return p
}

fn sin_fx(state: u64, schritt: u64) -> u64 {
    let t: u64 = g(state, S_SIN)
    if t == 0 {
        return 0
    }
    return kstate.get(t, (schritt & (SIN_N - 1)) * 8)
}

// ------------------------------------------------------- Matrizen

fn mat_at(state: u64, art: u64) -> u64 {
    return state + R3D_OFF + S_MAT + art * MAT_OKTETTE
}

fn mget(m: u64, r: u64, c: u64) -> u64 {
    return kstate.get(m, (r * 4 + c) * 8)
}

fn mset(m: u64, r: u64, c: u64, v: u64) {
    kstate.set(m, (r * 4 + c) * 8, v)
}

fn einheitsmatrix(m: u64) {
    var r: u64 = 0
    while r < 4 {
        var c: u64 = 0
        while c < 4 {
            if r == c {
                mset(m, r, c, FIX_ONE)
            } else {
                mset(m, r, c, 0)
            }
            c = c + 1
        }
        r = r + 1
    }
}

fn mat_mul(target: u64, a: u64, b: u64) {
    var r: u64 = 0
    while r < 4 {
        var c: u64 = 0
        while c < 4 {
            var sum: u64 = 0
            var k: u64 = 0
            while k < 4 {
                sum = sum +% fx_mul(mget(a, r, k), mget(b, k, c))
                k = k + 1
            }
            mset(target, r, c, sum)
            c = c + 1
        }
        r = r + 1
    }
}

fn rot_x(m: u64, sinw: u64, cosw: u64) {
    einheitsmatrix(m)
    mset(m, 1, 1, cosw)
    mset(m, 1, 2, 0 -% sinw)
    mset(m, 2, 1, sinw)
    mset(m, 2, 2, cosw)
}

//     [  cos  0  -sin ]
//     [   0   1    0  ]
//     [  sin  0   cos ]
fn rot_y(m: u64, sinw: u64, cosw: u64) {
    einheitsmatrix(m)
    mset(m, 0, 0, cosw)
    mset(m, 0, 2, 0 -% sinw)
    mset(m, 2, 0, sinw)
    mset(m, 2, 2, cosw)
}

fn verschieben(m: u64, tx: u64, ty: u64, tz: u64) {
    einheitsmatrix(m)
    mset(m, 3, 0, tx)
    mset(m, 3, 1, ty)
    mset(m, 3, 2, tz)
}

fn proj_set(m: u64, f: u64, ar: u64, nah: u64, fern: u64) {
    einheitsmatrix(m)
    mset(m, 0, 0, fx_div(f, ar))
    mset(m, 1, 1, f)
    if fern != nah {
        mset(m, 2, 2, fx_div(fern, fern -% nah))
        mset(m, 3, 2, fx_div(0 -% fx_mul(fern, nah), fern -% nah))
    }
    mset(m, 2, 3, FIX_ONE)
    mset(m, 3, 3, 0)
}

// ------------------------------------------------------- der Aufbau

fn start(state: u64, target: u64, w: u64, h: u64, pitch: u64) -> bool {
    if target == 0 || w == 0 || h == 0 {
        return false
    }
    if pitch < w * 4 {
        return false
    }
    let n: u64 = w * h * 8
    let frame: u64 = (n + 4095) / 4096
    let t: u64 = mem.frame_run(state, frame)
    if t == 0 {
        return false
    }
    var st: u64 = g(state, S_SIN)
    if st == 0 {
        let sr: u64 = mem.frame_run(state, 2)
        if sr == 0 {
            mem.frame_free_run(state, t, frame)
            return false
        }
        s(state, S_SIN, sr)
        s(state, S_SIN_N, 2)
        build_sin_table(state)
    }
    s(state, S_TARGET, target)
    s(state, S_W, w)
    s(state, S_H, h)
    s(state, S_PITCH, pitch)
    s(state, S_TIEFE, t)
    s(state, S_TIEFE_N, frame)
    s(state, S_DREIECKE, 0)
    s(state, S_POINTS, 0)
    s(state, S_BILDPUNKTE, 0)
    s(state, S_TEX, 0)
    s(state, S_TEX_OWN, 0)
    s(state, S_LX, 0)
    s(state, S_LY, 0)
    s(state, S_LZ, 0 -% FIX_ONE)
    s(state, S_LSTAERKE, FIX_ONE)
    s(state, S_LGRUND, FIX_ONE / 4)
    einheitsmatrix(mat_at(state, M_MODELL))
    einheitsmatrix(mat_at(state, M_VIEW))
    einheitsmatrix(mat_at(state, M_PROJ))
    s(state, S_ACTIVE, 1)
    return true
}

fn end(state: u64) {
    if !active(state) {
        return
    }
    let t: u64 = g(state, S_TIEFE)
    if t != 0 {
        mem.frame_free_run(state, t, g(state, S_TIEFE_N))
    }
    s(state, S_TIEFE, 0)
    let tx: u64 = g(state, S_TEX)
    if tx != 0 && g(state, S_TEX_OWN) != 0 {
        mem.frame_free_run(state, tx, g(state, S_TEX_N))
    }
    s(state, S_TEX, 0)
    s(state, S_TEX_OWN, 0)
    s(state, S_ACTIVE, 0)
}

fn clear(state: u64, color: u64) {
    if !active(state) {
        return
    }
    let w: u64 = g(state, S_W)
    let h: u64 = g(state, S_H)
    let target: u64 = g(state, S_TARGET)
    let pitch: u64 = g(state, S_PITCH)
    let tiefe: u64 = g(state, S_TIEFE)
    var y: u64 = 0
    while y < h {
        let row: u64 = target +% y *% pitch
        var x: u64 = 0
        while x < w {
            __mmio_write32((row +% x *% 4) as *mut u32, color as u32)
            x = x + 1
        }
        let tz: u64 = tiefe +% y *% w *% 8
        x = 0
        while x < w {
            kstate.set(tz, x * 8, TIEFE_FERN)
            x = x + 1
        }
        y = y + 1
    }
}

fn matrix(state: u64, art: u64, m: u64) {
    if art > M_PROJ {
        return
    }
    let z: u64 = mat_at(state, art)
    var i: u64 = 0
    while i < MAT_WORTE {
        kstate.set(z, i * 8, kstate.get(m, i * 8))
        i = i + 1
    }
}

fn licht(state: u64, rx: u64, ry: u64, rz: u64, staerke: u64, base: u64) {
    let q: u64 = fx_mul(rx, rx) +% fx_mul(ry, ry) +% fx_mul(rz, rz)
    let l: u64 = root_fx(q)
    if l == 0 {
        return
    }
    s(state, S_LX, fx_div(rx, l))
    s(state, S_LY, fx_div(ry, l))
    s(state, S_LZ, fx_div(rz, l))
    s(state, S_LSTAERKE, staerke)
    s(state, S_LGRUND, base)
}

fn root_fx(x: u64) -> u64 {
    if x == 0 {
        return 0
    }
    if ist_neg(x) {
        return 0
    }
    var r: u64 = x
    if r < FIX_ONE {
        r = FIX_ONE
    }
    var i: u64 = 0
    while i < 8 {
        if r == 0 {
            return 0
        }
        r = (r +% fx_div(x, r)) >> 1
        i = i + 1
    }
    return r
}

fn textur(state: u64, data: u64, w: u64, h: u64) -> bool {
    if data == 0 || w == 0 || h == 0 {
        return false
    }
    if (w & (w - 1)) != 0 {
        return false
    }
    if (h & (h - 1)) != 0 {
        return false
    }
    s(state, S_TEX, data)
    s(state, S_TEXW, w)
    s(state, S_TEXH, h)
    s(state, S_TEXMW, w - 1)
    s(state, S_TEXMH, h - 1)
    return true
}

// ------------------------------------------------- ein Eckpunkt

const V_WORTE: u64 = 9
const V_X: u64 = 0
const V_Y: u64 = 1
const V_Z: u64 = 2
const V_U: u64 = 3
const V_V: u64 = 4
const V_R: u64 = 5
const V_G: u64 = 6
const V_B: u64 = 7

fn point_draw_matrix(m: u64, x: u64, y: u64, z: u64, aus: u64) {
    var c: u64 = 0
    while c < 4 {
        var sum: u64 = fx_mul(x, mget(m, 0, c))
        sum = sum +% fx_mul(y, mget(m, 1, c))
        sum = sum +% fx_mul(z, mget(m, 2, c))
        sum = sum +% mget(m, 3, c)
        kstate.set(aus, c * 8, sum)
        c = c + 1
    }
}

// ---------------------------------------------------- das Dreieck

fn edge(ax: u64, ay: u64, bx: u64, by: u64, cx: u64, cy: u64) -> u64 {
    let d1x: u64 = bx -% ax
    let d1y: u64 = by -% ay
    let d2x: u64 = cx -% ax
    let d2y: u64 = cy -% ay
    return fx_mul(d1x, d2y) -% fx_mul(d1y, d2x)
}

fn min3(a: u64, b: u64, c: u64) -> u64 {
    var m: u64 = a
    if slt(b, m) {
        m = b
    }
    if slt(c, m) {
        m = c
    }
    return m
}

fn max3(a: u64, b: u64, c: u64) -> u64 {
    var m: u64 = a
    if slt(m, b) {
        m = b
    }
    if slt(m, c) {
        m = c
    }
    return m
}

fn dreieck(state: u64, p: u64) {
    if !active(state) {
        return
    }
    kstate.set(state + R3D_OFF + S_DREIECKE, 0,
        g(state, S_DREIECKE) + 1)

    let w: u64 = g(state, S_W)
    let h: u64 = g(state, S_H)

    var mv: [u64; 16] = [0 as u64; 16]
    var mvp: [u64; 16] = [0 as u64; 16]
    let pmv: u64 = (&mv[0]) as u64
    let pmvp: u64 = (&mvp[0]) as u64
    mat_mul(pmv, mat_at(state, M_MODELL), mat_at(state, M_VIEW))
    mat_mul(pmvp, pmv, mat_at(state, M_PROJ))

    var sx: [u64; 3] = [0 as u64; 3]
    var sy: [u64; 3] = [0 as u64; 3]
    var sz: [u64; 3] = [0 as u64; 3]
    var siw: [u64; 3] = [0 as u64; 3]
    var tmp: [u64; 4] = [0 as u64; 4]
    let ptmp: u64 = (&tmp[0]) as u64

    var i: u64 = 0
    while i < 3 {
        let v: u64 = p + i * V_WORTE * 8
        point_draw_matrix(pmvp, kstate.get(v, V_X * 8),
            kstate.get(v, V_Y * 8), kstate.get(v, V_Z * 8), ptmp)
        let cw: u64 = kstate.get(ptmp, 3 * 8)
        if ist_neg(cw) || cw < 256 {
            return
        }
        let cx: u64 = kstate.get(ptmp, 0)
        let cy: u64 = kstate.get(ptmp, 8)
        let cz: u64 = kstate.get(ptmp, 16)
        let ndx: u64 = fx_div(cx, cw)
        let ndy: u64 = fx_div(cy, cw)
        kstate.set((&sx[0]) as u64, i * 8,
            fx_mul(ndx +% FIX_ONE, (w << FIX_SHIFT) / 2))
        kstate.set((&sy[0]) as u64, i * 8,
            fx_mul(FIX_ONE -% ndy, (h << FIX_SHIFT) / 2))
        kstate.set((&sz[0]) as u64, i * 8, fx_div(cz, cw))
        kstate.set((&siw[0]) as u64, i * 8, fx_div(FIX_ONE, cw))
        i = i + 1
    }

    let ax: u64 = kstate.get((&sx[0]) as u64, 0)
    let ay: u64 = kstate.get((&sy[0]) as u64, 0)
    let bx: u64 = kstate.get((&sx[0]) as u64, 8)
    let by: u64 = kstate.get((&sy[0]) as u64, 8)
    let ccx: u64 = kstate.get((&sx[0]) as u64, 16)
    let ccy: u64 = kstate.get((&sy[0]) as u64, 16)

    let face: u64 = edge(ax, ay, bx, by, ccx, ccy)
    if ist_neg(face) || face == 0 {
        return
    }

    var x0: u64 = fx_to_int_s(min3(ax, bx, ccx))
    var y0: u64 = fx_to_int_s(min3(ay, by, ccy))
    var x1: u64 = fx_to_int_s(max3(ax, bx, ccx)) + 1
    var y1: u64 = fx_to_int_s(max3(ay, by, ccy)) + 1
    if ist_neg(x0) {
        x0 = 0
    }
    if ist_neg(y0) {
        y0 = 0
    }
    if ist_neg(x1) {
        return
    }
    if ist_neg(y1) {
        return
    }
    if x1 > w {
        x1 = w
    }
    if y1 > h {
        y1 = h
    }
    if x0 >= x1 || y0 >= y1 {
        return
    }

    let bright: u64 = brightness(state, p)
    s(state, S_LETZTHELL, bright)

    let px0: u64 = fx_from_int_s(x0) +% (FIX_ONE / 2)
    let py0: u64 = fx_from_int_s(y0) +% (FIX_ONE / 2)

    let e0dx: u64 = ay -% by
    let e0dy: u64 = bx -% ax
    let e1dx: u64 = by -% ccy
    let e1dy: u64 = ccx -% bx
    let e2dx: u64 = ccy -% ay
    let e2dy: u64 = ax -% ccx

    var e0z: u64 = edge(ax, ay, bx, by, px0, py0)
    var e1z: u64 = edge(bx, by, ccx, ccy, px0, py0)
    var e2z: u64 = edge(ccx, ccy, ax, ay, px0, py0)

    let target: u64 = g(state, S_TARGET)
    let pitch: u64 = g(state, S_PITCH)
    let tiefe: u64 = g(state, S_TIEFE)
    let face_t: u64 = face

    let z0: u64 = kstate.get((&sz[0]) as u64, 0)
    let z1v: u64 = kstate.get((&sz[0]) as u64, 8)
    let z2v: u64 = kstate.get((&sz[0]) as u64, 16)

    var gemalt: u64 = 0
    let tex: u64 = g(state, S_TEX)
    let texw: u64 = g(state, S_TEXW)
    let texh: u64 = g(state, S_TEXH)
    let texmw: u64 = g(state, S_TEXMW)
    let texmh: u64 = g(state, S_TEXMH)
    let v0p: u64 = p
    let v1p: u64 = p + V_WORTE * 8
    let v2p: u64 = p + 2 * V_WORTE * 8
    let u0: u64 = kstate.get(v0p, V_U * 8)
    let u1: u64 = kstate.get(v1p, V_U * 8)
    let u2: u64 = kstate.get(v2p, V_U * 8)
    let tv0: u64 = kstate.get(v0p, V_V * 8)
    let tv1: u64 = kstate.get(v1p, V_V * 8)
    let tv2: u64 = kstate.get(v2p, V_V * 8)
    let r0: u64 = kstate.get(v0p, V_R * 8)
    let r1: u64 = kstate.get(v1p, V_R * 8)
    let r2: u64 = kstate.get(v2p, V_R * 8)
    let g0: u64 = kstate.get(v0p, V_G * 8)
    let g1: u64 = kstate.get(v1p, V_G * 8)
    let g2: u64 = kstate.get(v2p, V_G * 8)
    let b0: u64 = kstate.get(v0p, V_B * 8)
    let b1: u64 = kstate.get(v1p, V_B * 8)
    let b2: u64 = kstate.get(v2p, V_B * 8)
    let texwf: u64 = texw << FIX_SHIFT
    let texhf: u64 = texh << FIX_SHIFT

    var y: u64 = y0
    while y < y1 {
        var e0: u64 = e0z
        var e1: u64 = e1z
        var e2: u64 = e2z
        let row: u64 = target +% y *% pitch
        let tz: u64 = tiefe +% y *% w *% 8
        var x: u64 = x0
        while x < x1 {
            if ((e0 | e1 | e2) >> 63) == 0 {
                let l0: u64 = (e1 << FIX_SHIFT) / face_t
                let l1: u64 = (e2 << FIX_SHIFT) / face_t
                let l2: u64 = (e0 << FIX_SHIFT) / face_t
                var zz: u64 = 0
                if (z0 >> 63) != 0 {
                    zz = zz -% (((0 -% z0) *% l0) >> FIX_SHIFT)
                } else {
                    zz = zz +% ((z0 *% l0) >> FIX_SHIFT)
                }
                if (z1v >> 63) != 0 {
                    zz = zz -% (((0 -% z1v) *% l1) >> FIX_SHIFT)
                } else {
                    zz = zz +% ((z1v *% l1) >> FIX_SHIFT)
                }
                if (z2v >> 63) != 0 {
                    zz = zz -% (((0 -% z2v) *% l2) >> FIX_SHIFT)
                } else {
                    zz = zz +% ((z2v *% l2) >> FIX_SHIFT)
                }
                let alt: u64 = __mmio_read64((tz +% x *% 8) as *mut u64)
                // Vorzeichenbehafteter Vergleich, ausgeschrieben.
                var naeher: bool = false
                let nz: u64 = zz >> 63
                let na: u64 = alt >> 63
                if nz != na {
                    naeher = nz != 0
                } else {
                    naeher = zz < alt
                }
                if naeher {
                    __mmio_write64((tz +% x *% 8) as *mut u64, zz)
                    var cr: u64 = 0
                    var cg: u64 = 0
                    var cb: u64 = 0
                    if tex != 0 {
                        let uu: u64 = ((u0 *% l0) >> FIX_SHIFT) +% ((u1 *% l1) >> FIX_SHIFT) +% ((u2 *% l2) >> FIX_SHIFT)
                        let vv: u64 = ((tv0 *% l0) >> FIX_SHIFT) +% ((tv1 *% l1) >> FIX_SHIFT) +% ((tv2 *% l2) >> FIX_SHIFT)
                        let tu: u64 = ((uu *% texwf) >> (FIX_SHIFT * 2))
                            & texmw
                        let tvv: u64 = ((vv *% texhf) >> (FIX_SHIFT * 2))
                            & texmh
                        let px: u64 = __mmio_read32(
                            (tex +% (tvv *% texw +% tu) *% 4) as *mut u32) as u64
                        cr = (px >> 16) & 255
                        cg = (px >> 8) & 255
                        cb = px & 255
                    } else {
                        cr = (((r0 *% l0) >> FIX_SHIFT) +% ((r1 *% l1) >> FIX_SHIFT) +% ((r2 *% l2) >> FIX_SHIFT)) >> FIX_SHIFT
                        cg = (((g0 *% l0) >> FIX_SHIFT) +% ((g1 *% l1) >> FIX_SHIFT) +% ((g2 *% l2) >> FIX_SHIFT)) >> FIX_SHIFT
                        cb = (((b0 *% l0) >> FIX_SHIFT) +% ((b1 *% l1) >> FIX_SHIFT) +% ((b2 *% l2) >> FIX_SHIFT)) >> FIX_SHIFT
                    }
                    cr = (cr *% bright) >> FIX_SHIFT
                    cg = (cg *% bright) >> FIX_SHIFT
                    cb = (cb *% bright) >> FIX_SHIFT
                    if cr > 255 {
                        cr = 255
                    }
                    if cg > 255 {
                        cg = 255
                    }
                    if cb > 255 {
                        cb = 255
                    }
                    __mmio_write32((row +% x *% 4) as *mut u32,
                        ((cr << 16) | (cg << 8) | cb) as u32)
                    gemalt = gemalt + 1
                }
            }
            e0 = e0 +% e0dx
            e1 = e1 +% e1dx
            e2 = e2 +% e2dx
            x = x + 1
        }
        e0z = e0z +% e0dy
        e1z = e1z +% e1dy
        e2z = e2z +% e2dy
        y = y + 1
    }
    s(state, S_BILDPUNKTE, g(state, S_BILDPUNKTE) + gemalt)
    s(state, S_POINTS, g(state, S_POINTS) + 3)
}

fn fx_from_int_s(n: u64) -> u64 {
    if ist_neg(n) {
        return 0 -% ((0 -% n) << FIX_SHIFT)
    }
    return n << FIX_SHIFT
}

fn fx_to_int_s(x: u64) -> u64 {
    if ist_neg(x) {
        return 0 -% ((0 -% x) >> FIX_SHIFT)
    }
    return x >> FIX_SHIFT
}

fn brightness(state: u64, p: u64) -> u64 {
    let v0: u64 = p
    let v1: u64 = p + V_WORTE * 8
    let v2: u64 = p + 2 * V_WORTE * 8
    let ux: u64 = kstate.get(v1, V_X * 8) -% kstate.get(v0, V_X * 8)
    let uy: u64 = kstate.get(v1, V_Y * 8) -% kstate.get(v0, V_Y * 8)
    let uz: u64 = kstate.get(v1, V_Z * 8) -% kstate.get(v0, V_Z * 8)
    let vx: u64 = kstate.get(v2, V_X * 8) -% kstate.get(v0, V_X * 8)
    let vy: u64 = kstate.get(v2, V_Y * 8) -% kstate.get(v0, V_Y * 8)
    let vz: u64 = kstate.get(v2, V_Z * 8) -% kstate.get(v0, V_Z * 8)
    var nx: u64 = fx_mul(uy, vz) -% fx_mul(uz, vy)
    var ny: u64 = fx_mul(uz, vx) -% fx_mul(ux, vz)
    var nz: u64 = fx_mul(ux, vy) -% fx_mul(uy, vx)
    let mm: u64 = mat_at(state, M_MODELL)
    let wx: u64 = fx_mul(nx, mget(mm, 0, 0)) +% fx_mul(ny, mget(mm, 1, 0)) +% fx_mul(nz, mget(mm, 2, 0))
    let wy: u64 = fx_mul(nx, mget(mm, 0, 1)) +% fx_mul(ny, mget(mm, 1, 1)) +% fx_mul(nz, mget(mm, 2, 1))
    let wz: u64 = fx_mul(nx, mget(mm, 0, 2)) +% fx_mul(ny, mget(mm, 1, 2)) +% fx_mul(nz, mget(mm, 2, 2))
    nx = wx
    ny = wy
    nz = wz
    let q: u64 = fx_mul(nx, nx) +% fx_mul(ny, ny) +% fx_mul(nz, nz)
    let l: u64 = root_fx(q)
    if l == 0 {
        return g(state, S_LGRUND)
    }
    nx = fx_div(nx, l)
    ny = fx_div(ny, l)
    nz = fx_div(nz, l)
    var d: u64 = 0 -% (fx_mul(nx, g(state, S_LX)) +% fx_mul(ny, g(state, S_LY)) +% fx_mul(nz, g(state, S_LZ)))
    if ist_neg(d) {
        d = 0
    }
    var bright: u64 = g(state, S_LGRUND) +% fx_mul(d, g(state, S_LSTAERKE))
    if bright > FIX_ONE {
        bright = FIX_ONE
    }
    return bright
}

fn color_on(state: u64, p: u64, l0: u64, l1: u64, l2: u64,
    bright: u64) -> u64 {
    let v0: u64 = p
    let v1: u64 = p + V_WORTE * 8
    let v2: u64 = p + 2 * V_WORTE * 8
    var r: u64 = 0
    var gr: u64 = 0
    var b: u64 = 0
    let tex: u64 = g(state, S_TEX)
    if tex != 0 {
        let u: u64 = fx_mul(l0, kstate.get(v0, V_U * 8)) +% fx_mul(l1, kstate.get(v1, V_U * 8)) +% fx_mul(l2, kstate.get(v2, V_U * 8))
        let v: u64 = fx_mul(l0, kstate.get(v0, V_V * 8)) +% fx_mul(l1, kstate.get(v1, V_V * 8)) +% fx_mul(l2, kstate.get(v2, V_V * 8))
        let tw: u64 = g(state, S_TEXW)
        let th: u64 = g(state, S_TEXH)
        let tu: u64 = (fx_to_int_s(fx_mul(u, fx_from_int_s(tw))))
            & g(state, S_TEXMW)
        let tv: u64 = (fx_to_int_s(fx_mul(v, fx_from_int_s(th))))
            & g(state, S_TEXMH)
        let px: u64 = __mmio_read32((tex +% (tv *% tw +% tu) *% 4)
            as *mut u32) as u64
        r = (px >> 16) & 255
        gr = (px >> 8) & 255
        b = px & 255
    } else {
        r = fx_to_int_s(fx_mul(l0, kstate.get(v0, V_R * 8)) +% fx_mul(l1, kstate.get(v1, V_R * 8)) +% fx_mul(l2, kstate.get(v2, V_R * 8)))
        gr = fx_to_int_s(fx_mul(l0, kstate.get(v0, V_G * 8)) +% fx_mul(l1, kstate.get(v1, V_G * 8)) +% fx_mul(l2, kstate.get(v2, V_G * 8)))
        b = fx_to_int_s(fx_mul(l0, kstate.get(v0, V_B * 8)) +% fx_mul(l1, kstate.get(v1, V_B * 8)) +% fx_mul(l2, kstate.get(v2, V_B * 8)))
    }
    // Licht anlegen.
    r = (r *% bright) >> FIX_SHIFT
    gr = (gr *% bright) >> FIX_SHIFT
    b = (b *% bright) >> FIX_SHIFT
    if r > 255 {
        r = 255
    }
    if gr > 255 {
        gr = 255
    }
    if b > 255 {
        b = 255
    }
    return (r << 16) | (gr << 8) | b
}

fn dreiecke(state: u64) -> u64 {
    return g(state, S_DREIECKE)
}

fn points(state: u64) -> u64 {
    return g(state, S_POINTS)
}

fn bildpunkte(state: u64) -> u64 {
    return g(state, S_BILDPUNKTE)
}

// ------------------------------------------------------ der Selbsttest
fn selbsttest(state: u64) -> u64 {
    var err: u64 = 0

    // 1. Festkomma: 2.0 * 3.0 = 6.0
    if fx_mul(2 * FIX_ONE, 3 * FIX_ONE) != 6 * FIX_ONE {
        err = err | 1
    }
    // 2. Vorzeichen: -2.0 * 3.0 = -6.0
    if fx_mul(0 -% (2 * FIX_ONE), 3 * FIX_ONE) != 0 -% (6 * FIX_ONE) {
        err = err | 2
    }
    // 3. Teilung: 6.0 / 3.0 = 2.0
    if fx_div(6 * FIX_ONE, 3 * FIX_ONE) != 2 * FIX_ONE {
        err = err | 4
    }
    let wz: u64 = root_fx(4 * FIX_ONE)
    if wz > 2 * FIX_ONE + 64 || wz < 2 * FIX_ONE - 64 {
        err = err | 8
    }
    // 5. Sinustabelle: sin(0)=0, sin(90)=1, sin(180)=0, sin(270)=-1
    if g(state, S_SIN) != 0 {
        if sin_fx(state, 0) != 0 {
            err = err | 16
        }
        if sin_fx(state, 256) != FIX_ONE {
            err = err | 32
        }
        if sin_fx(state, 768) != 0 -% FIX_ONE {
            err = err | 64
        }
        let s45: u64 = sin_fx(state, 128)
        if s45 < 45800 || s45 > 46900 {
            err = err | 128
        }
    }
    let e_a: u64 = edge(0, 0, 0, FIX_ONE, 0 -% FIX_ONE, 0)
    let e_b: u64 = edge(0, 0, 0, FIX_ONE, FIX_ONE, 0)
    if ist_neg(e_a) == ist_neg(e_b) {
        err = err | 256
    }
    var m1: [u64; 16] = [0 as u64; 16]
    var m2: [u64; 16] = [0 as u64; 16]
    var m3: [u64; 16] = [0 as u64; 16]
    einheitsmatrix((&m1[0]) as u64)
    einheitsmatrix((&m2[0]) as u64)
    mat_mul((&m3[0]) as u64, (&m1[0]) as u64, (&m2[0]) as u64)
    if mget((&m3[0]) as u64, 0, 0) != FIX_ONE {
        err = err | 512
    }
    if mget((&m3[0]) as u64, 0, 1) != 0 {
        err = err | 1024
    }
    if mget((&m3[0]) as u64, 3, 3) != FIX_ONE {
        err = err | 2048
    }
    var mv: [u64; 16] = [0 as u64; 16]
    var aus: [u64; 4] = [0 as u64; 4]
    verschieben((&mv[0]) as u64, FIX_ONE, 2 * FIX_ONE, 3 * FIX_ONE)
    point_draw_matrix((&mv[0]) as u64, 0, 0, 0, (&aus[0]) as u64)
    if kstate.get((&aus[0]) as u64, 0) != FIX_ONE {
        err = err | 4096
    }
    if kstate.get((&aus[0]) as u64, 16) != 3 * FIX_ONE {
        err = err | 8192
    }
    var md: [u64; 16] = [0 as u64; 16]
    if g(state, S_SIN) != 0 {
        rot_y((&md[0]) as u64, sin_fx(state, 256), sin_fx(state, 512))
        point_draw_matrix((&md[0]) as u64, FIX_ONE, 0, 0, (&aus[0]) as u64)
        let rx: u64 = kstate.get((&aus[0]) as u64, 0)
        let rz: u64 = kstate.get((&aus[0]) as u64, 16)
        if rx > 256 && rx < 0 -% 256 {
            err = err | 16384
        }
        if rz != 0 -% FIX_ONE {
            err = err | 32768
        }
    }
    return err
}

fn last_brightness(state: u64) -> u64 {
    return g(state, S_LETZTHELL)
}
