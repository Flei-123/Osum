
profile kernel

import lib.kstate

export {
    FORMEN, RASTER, MAXPX,
    F_PFEIL, F_TEXT, F_HAND, F_WIDTH, F_HEIGHT, F_DIAG1, F_DIAG2,
    F_CROSS, F_WAITING, F_NO, F_COPY, F_MOVE,
    size, griff_x, griff_y, build_map, deck, deck_rot, rot_hot_x, rot_hot_y, kern_a, margin_a,
    schatten_a, alpha_map_shape, alpha_map_size, bauten
}

const FORMEN: u64 = 12
const RASTER: u64 = 24   // das Entwurfsraster, in Einheiten
const VIERTEL: u64 = 96
const S: u64 = 4
const MAXPX: u64 = 48
const MAXS: u64 = 192    // MAXPX * S

const F_PFEIL: u64 = 0
const F_TEXT: u64 = 1
const F_HAND: u64 = 2
const F_WIDTH: u64 = 3
const F_HEIGHT: u64 = 4
const F_DIAG1: u64 = 5
const F_DIAG2: u64 = 6
const F_CROSS: u64 = 7
const F_WAITING: u64 = 8
const F_NO: u64 = 9       // forbidden: ring with a slash
const F_COPY: u64 = 10    // drag and drop with Ctrl: a plus sign
const F_MOVE: u64 = 11    // drag and drop: a down arrow (drop here)

static mut header: [u8; 48] = [0 as u8; 48]
static mut points: [u8; 362] = [0 as u8; 362]
static mut geladen: u64 = 0

static mut hires: [u8; 36864] = [0 as u8; 36864]
static mut nah: [u8; 36864] = [0 as u8; 36864]

static mut alpha_map: [u8; 6912] = [0 as u8; 6912]
static mut k_form: u64 = 9999
static mut k_gr: u64 = 0
static mut n_bauten: u64 = 0
// r481: the finished table of every shape, kept per shape (and the size it was built for). Building a table costs 16 - 40 ms (three
// rasterisations of up to 192 x 192 samples with a point-in-polygon test each, in Firn), and it happened at EVERY change of the pointer's
// shape -- the frame that showed the hand or the text bar over a start-menu item was the slowest frame of the whole menu run. With the
// copy a shape that was seen once costs about 20 us when it comes back. The pixels are the same bytes.
static mut kcache: [u8; 82944] = [0 as u8; 82944]   // FORMEN * MAXPX * MAXPX * 3
static mut kc_gr: [u64; 12] = [0 as u64; 12]

fn load() {
    if geladen == 1 {
        return
    }
    var tk: [u8; 48] = b"\x00\x07\x08\x08\x07\x0c\x30\x30\x13\x15\x21\x0a\x28\x0a\x30\x30\x32\x0a\x30\x30\x3c\x0a\x30\x30\x46\x0a\x30\x30\x50\x18\x30\x30\x68\x0c\x30\x30\x74\x2e\x30\x30\xa2\x0c\x30\x30\xae\x07\x30\x30"
    var tp: [u8; 362] = b"\x08\x08\x08\x4c\x19\x3c\x24\x56\x2e\x51\x24\x38\x36\x38\x22\x0e\x3e\x0e\x3e\x14\x34\x14\x34\x4c\x3e\x4c\x3e\x52\x22\x52\x22\x4c\x2c\x4c\x2c\x14\x22\x14\x1c\x0a\x26\x0a\x2a\x0e\x2a\x2e\x2e\x2a\x38\x2a\x3b\x2e\x3e\x2c\x46\x2c\x49\x2f\x4a\x2e\x51\x2e\x54\x31\x54\x46\x4e\x56\x2e\x56\x22\x4a\x12\x3a\x12\x34\x18\x31\x1c\x32\x06\x30\x1c\x1d\x1c\x29\x44\x29\x44\x1d\x5a\x30\x44\x43\x44\x37\x1c\x37\x1c\x43\x30\x06\x43\x1c\x37\x1c\x37\x44\x43\x44\x30\x5a\x1d\x44\x29\x44\x29\x1c\x1d\x1c\x12\x12\x2f\x14\x27\x1d\x43\x39\x4c\x31\x4e\x4e\x31\x4c\x39\x43\x1d\x27\x14\x2f\x12\x4e\x14\x31\x1d\x39\x39\x1d\x31\x14\x4e\x12\x4c\x2f\x43\x27\x27\x43\x2f\x4c\x30\x06\x40\x18\x36\x18\x36\x2a\x48\x2a\x48\x20\x5a\x30\x48\x40\x48\x36\x36\x36\x36\x48\x40\x48\x30\x5a\x20\x48\x2a\x48\x2a\x36\x18\x36\x18\x40\x06\x30\x18\x20\x18\x2a\x2a\x2a\x2a\x18\x20\x18\x1a\x0a\x46\x0a\x46\x14\x35\x2d\x35\x33\x46\x4c\x46\x56\x1a\x56\x1a\x4c\x2b\x33\x2b\x2d\x1a\x14\x45\x53\x3b\x57\x31\x59\x26\x58\x1c\x54\x14\x4e\x0d\x45\x09\x3c\x07\x32\x08\x27\x0c\x1d\x12\x15\x1a\x0e\x20\x18\x48\x40\x4c\x37\x4d\x2d\x4a\x24\x45\x1c\x3d\x17\x34\x14\x2b\x14\x22\x17\x1b\x0d\x25\x09\x2f\x07\x3a\x08\x44\x0c\x4c\x12\x53\x1b\x57\x24\x59\x2e\x58\x39\x54\x43\x4e\x4b\x46\x52\x40\x48\x18\x20\x14\x29\x13\x33\x16\x3c\x1b\x44\x23\x49\x2c\x4c\x35\x4c\x3e\x49\x28\x0c\x38\x0c\x38\x28\x54\x28\x54\x38\x38\x38\x38\x54\x28\x54\x28\x38\x0c\x38\x0c\x28\x28\x28\x28\x0a\x38\x0a\x38\x32\x46\x32\x30\x4c\x1a\x32\x28\x32"
    var i: u64 = 0
    while i < 48 {
        header[(i) as usize] = tk[(i) as usize]
        i = i + 1
    }
    i = 0
    while i < 362 {
        points[(i) as usize] = tp[(i) as usize]
        i = i + 1
    }
    geladen = 1
}

fn size(uisc: u64) -> u64 {
    var g: u64 = RASTER * uisc
    if uisc == 0 {
        g = RASTER
    }
    if g > MAXPX {
        g = MAXPX
    }
    return g
}

fn ecken(form: u64) -> u64 {
    load()
    if form >= FORMEN {
        return 0
    }
    return header[((form * 4 + 1)) as usize] as u64
}

fn first(form: u64) -> u64 {
    load()
    return header[((form * 4)) as usize] as u64
}

fn px(form: u64, i: u64) -> i64 {
    return points[(((first(form) + i) * 2)) as usize] as i64
}

fn py(form: u64, i: u64) -> i64 {
    return points[(((first(form) + i) * 2 + 1)) as usize] as i64
}

fn griff_x(form: u64, g: u64) -> u64 {
    load()
    if form >= FORMEN {
        return 0
    }
    return (header[((form * 4 + 2)) as usize] as u64) * g / VIERTEL
}

fn griff_y(form: u64, g: u64) -> u64 {
    load()
    if form >= FORMEN {
        return 0
    }
    return (header[((form * 4 + 3)) as usize] as u64) * g / VIERTEL
}

fn inside(form: u64, xn: i64, yn: i64, d: i64) -> bool {
    let n: u64 = ecken(form)
    if n < 3 {
        return false
    }
    var yes: bool = false
    var i: u64 = 0
    var j: u64 = n - 1
    while i < n {
        let xi: i64 = px(form, i) * d
        let yi: i64 = py(form, i) * d
        let xj: i64 = px(form, j) * d
        let yj: i64 = py(form, j) * d
        if (yi > yn) != (yj > yn) {
            // xn < xi + (xj - xi) * (yn - yi) / (yj - yi)
            let dy: i64 = yj - yi
            let left: i64 = (xn - xi) * dy
            let right: i64 = (xj - xi) * (yn - yi)
            if dy > 0 {
                if left < right {
                    yes = !yes
                }
            } else {
                if left > right {
                    yes = !yes
                }
            }
        }
        j = i
        i = i + 1
    }
    return yes
}

fn width(n: u64, ab: u64, close_path: u64) {
    var r: u64 = 0
    while r < n {
        // waagrecht: nah <- max(nah[r][c-ab .. c+zu])
        var c: u64 = 0
        while c < n {
            var v: u64 = 0
            var k: u64 = 0
            var a: u64 = 0
            if c > ab {
                a = c - ab
            }
            k = a
            var e: u64 = c + close_path
            if e >= n {
                e = n - 1
            }
            while k <= e {
                if (nah[((r * n + k)) as usize] as u64) > v {
                    v = nah[((r * n + k)) as usize] as u64
                }
                k = k + 1
            }
            hires[((r * n + c)) as usize] = v as u8
            c = c + 1
        }
        r = r + 1
    }
    var c2: u64 = 0
    while c2 < n {
        var r2: u64 = 0
        while r2 < n {
            var v: u64 = 0
            var a: u64 = 0
            if r2 > ab {
                a = r2 - ab
            }
            var e: u64 = r2 + close_path
            if e >= n {
                e = n - 1
            }
            var k: u64 = a
            while k <= e {
                if (hires[((k * n + c2)) as usize] as u64) > v {
                    v = hires[((k * n + c2)) as usize] as u64
                }
                k = k + 1
            }
            nah[((r2 * n + c2)) as usize] = v as u8
            r2 = r2 + 1
        }
        c2 = c2 + 1
    }
}

fn build_map(form: u64, g: u64) {
    if form >= FORMEN || g == 0 || g > MAXPX {
        return
    }
    if k_form == form && k_gr == g {
        return
    }
    if kc_gr[form as usize] == g {
        let ko: u64 = form * 6912
        let kn: u64 = g * g * 3
        var ki: u64 = 0
        while ki < kn {
            alpha_map[ki as usize] = kcache[(ko + ki) as usize]
            ki = ki + 1
        }
        k_form = form
        k_gr = g
        return
    }
    load()
    let n: u64 = g * S
    let d: i64 = (2 * n) as i64
    var r: u64 = 0
    while r < n {
        let yn: i64 = ((2 * r + 1) * VIERTEL) as i64
        var c: u64 = 0
        while c < n {
            let xn: i64 = ((2 * c + 1) * VIERTEL) as i64
            var v: u64 = 0
            if inside(form, xn, yn, d) {
                v = 1
            }
            nah[((r * n + c)) as usize] = v as u8
            c = c + 1
        }
        r = r + 1
    }
    var rr: u64 = n / 18
    if rr < 1 {
        rr = 1
    }
    width(n, 0, rr * 2)
    var p: u64 = 0
    while p < n * n {
        hires[(p) as usize] = 0 as u8
        if (nah[(p) as usize] as u64) != 0 {
            hires[(p) as usize] = 1 as u8
        }
        p = p + 1
    }
    r = 0
    while r < n {
        let yn: i64 = ((2 * r + 1) * VIERTEL) as i64
        var c: u64 = 0
        while c < n {
            let xn: i64 = ((2 * c + 1) * VIERTEL) as i64
            var v: u64 = 0
            if inside(form, xn, yn, d) {
                v = 1
            }
            nah[((r * n + c)) as usize] = v as u8
            c = c + 1
        }
        r = r + 1
    }
    width(n, rr, rr)
    p = 0
    while p < n * n {
        if (nah[(p) as usize] as u64) != 0 {
            hires[(p) as usize] = 2 as u8
        }
        p = p + 1
    }
    r = 0
    while r < n {
        let yn: i64 = ((2 * r + 1) * VIERTEL) as i64
        var c: u64 = 0
        while c < n {
            let xn: i64 = ((2 * c + 1) * VIERTEL) as i64
            if inside(form, xn, yn, d) {
                hires[((r * n + c)) as usize] = 3 as u8
            }
            c = c + 1
        }
        r = r + 1
    }
    // 3. mitteln: neun Proben je Bildpunkt, drei Deckungen.
    var y: u64 = 0
    while y < g {
        var x: u64 = 0
        while x < g {
            var n3: u64 = 0
            var n2: u64 = 0
            var n1: u64 = 0
            var sy: u64 = 0
            while sy < S {
                var sx: u64 = 0
                while sx < S {
                    let v: u64 = hires[(((y * S + sy) * n + x * S + sx))
                        as usize] as u64
                    if v == 3 {
                        n3 = n3 + 1
                    } else if v == 2 {
                        n2 = n2 + 1
                    } else if v == 1 {
                        n1 = n1 + 1
                    }
                    sx = sx + 1
                }
                sy = sy + 1
            }
            let o: u64 = (y * g + x) * 3
            alpha_map[(o) as usize] = (n3 * 255 / (S * S)) as u8
            alpha_map[((o + 1)) as usize] = (n2 * 255 / (S * S)) as u8
            alpha_map[((o + 2)) as usize] = (n1 * 255 / (S * S)) as u8
            x = x + 1
        }
        y = y + 1
    }
    {
        let ko: u64 = form * 6912
        let kn: u64 = g * g * 3
        var ki: u64 = 0
        while ki < kn {
            kcache[(ko + ki) as usize] = alpha_map[ki as usize]
            ki = ki + 1
        }
        kc_gr[form as usize] = g
    }
    k_form = form
    k_gr = g
    n_bauten = n_bauten + 1
}

fn kern_a(g: u64, x: u64, y: u64) -> u64 {
    if x >= g || y >= g || g > MAXPX {
        return 0
    }
    return alpha_map[(((y * g + x) * 3)) as usize] as u64
}

fn margin_a(g: u64, x: u64, y: u64) -> u64 {
    if x >= g || y >= g || g > MAXPX {
        return 0
    }
    return alpha_map[(((y * g + x) * 3 + 1)) as usize] as u64
}

fn schatten_a(g: u64, x: u64, y: u64) -> u64 {
    if x >= g || y >= g || g > MAXPX {
        return 0
    }
    return alpha_map[(((y * g + x) * 3 + 2)) as usize] as u64
}

fn deck(g: u64, x: u64, y: u64) -> u64 {
    if x >= g || y >= g || g > MAXPX {
        return 0
    }
    let o: u64 = (y * g + x) * 3
    return ((alpha_map[(o) as usize] as u64) << 16)
        | ((alpha_map[((o + 1)) as usize] as u64) << 8)
        | (alpha_map[((o + 2)) as usize] as u64)
}

// The hardware cursor lives on the PANEL, so its picture is turned with the output: rq = quarter turns (0..3) of the output
// rotation. `deck_rot` answers for the DESTINATION cell (c, r) of the turned g x g picture; the hotspot turns with it.
fn deck_rot(g: u64, rq: u64, c: u64, r: u64) -> u64 {
    if g == 0 || c >= g || r >= g || rq == 0 {
        return deck(g, c, r)
    }
    if rq == 1 {
        return deck(g, r, g - 1 - c)
    }
    if rq == 2 {
        return deck(g, g - 1 - c, g - 1 - r)
    }
    return deck(g, g - 1 - r, c)
}

fn rot_hot_x(g: u64, rq: u64, hx0: u64, hy0: u64) -> u64 {
    var hx: u64 = hx0
    var hy: u64 = hy0
    if g == 0 {
        return hx
    }
    if hx >= g {
        hx = g - 1
    }
    if hy >= g {
        hy = g - 1
    }
    if rq == 1 {
        return g - 1 - hy
    }
    if rq == 2 {
        return g - 1 - hx
    }
    if rq == 3 {
        return hy
    }
    return hx
}

fn rot_hot_y(g: u64, rq: u64, hx0: u64, hy0: u64) -> u64 {
    var hx: u64 = hx0
    var hy: u64 = hy0
    if g == 0 {
        return hy
    }
    if hx >= g {
        hx = g - 1
    }
    if hy >= g {
        hy = g - 1
    }
    if rq == 1 {
        return hx
    }
    if rq == 2 {
        return g - 1 - hy
    }
    if rq == 3 {
        return g - 1 - hx
    }
    return hy
}

fn alpha_map_shape() -> u64 {
    return k_form
}

fn alpha_map_size() -> u64 {
    return k_gr
}

fn bauten() -> u64 {
    return n_bauten
}
