fn class_vram_total(state: u64) -> u64 {
    if bytes(state) != 0 {
        return bytes(state)
    }
    return displayclass.NA
}

fn ops() -> displayclass.DisplayOps {
    var o: displayclass.DisplayOps = displayclass.null_ops()
    o.ready = ready
    o.present = drvnull.n_false
    o.frames = presents
    o.vram_total = class_vram_total
    o.vram_used = class_vram_total
    o.kind = displayclass.KIND_FB
    o.tag = 0x6266
    return o
}
