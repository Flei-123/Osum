// ------------------------------------------------------- Bochs-VBE

const VBE_INDEX: u16 = 0x01CE
const VBE_DATA: u16 = 0x01CF

const VBE_ID: u64 = 0
const VBE_XRES: u64 = 1
const VBE_YRES: u64 = 2
const VBE_BPP: u64 = 3
const VBE_ENABLE: u64 = 4
const VBE_BANK: u64 = 5
const VBE_VWIDTH: u64 = 6
const VBE_VHEIGHT: u64 = 7
const VBE_XOFF: u64 = 8
const VBE_YOFF: u64 = 9

const VBE_DISABLED: u64 = 0
const VBE_ENABLED: u64 = 0x01
const VBE_LFB: u64 = 0x40

const VBE_ID_LO: u64 = 0xB0C0
const VBE_ID_HI: u64 = 0xB0C5

// ------------------------------------------------ PCI und Seitentafel

const PCI_ADDR: u16 = 0xCF8
const PCI_DATA: u16 = 0xCFC
const CFG_VENDOR: u64 = 0x00
const CFG_COMMAND: u64 = 0x04
const CFG_CLASS: u64 = 0x08 // Revision, ProgIF, Unterklasse, Klasse
const CFG_HEADER: u64 = 0x0C
const CFG_BAR0: u64 = 0x10
const CMD_MEM: u64 = 0x2 // Speicherbereiche des Geraets anschalten
const CLASS_VGA: u64 = 0x03

const PAGE_PRESENT: u64 = 1
const PAGE_WRITE: u64 = 2
const PAGE_PWT: u64 = 8
const PAGE_PCD: u64 = 16
const PAGE_HUGE: u64 = 0x80
const PAGE_PAT_HUGE: u64 = 0x1000
const IA32_PAT: u64 = 0x277
const PAT_WC: u64 = 0x01 // Write-Combining
const ADDR_MASK: u64 = 0x000FFFFFFFFFF000

//   *** EXCEPTION 14 #PF  err=0x2  cr2=0x3f600000
//   kspur: fb.fb_bits (fb.fi:675) <- fb.slot_remap (fb.fi:3364)
const WIN_SLOTS: u64 = 16
const WIN_FIRST: u64 = 496
const WIN_VIRT: u64 = 496 * 0x200000
const HUGE_SIZE: u64 = 0x200000
const WIN_LIST: u64 = 0x12000 + 0x080 // pci.K2_SCALARS + apic.S_WIN

const USER_BASE: u64 = 0x40200000

// ------------------------------------------------------- Torbefehle

fn out16(port: u16, v: u16) {
    asm("out dx, ax", in("dx") port, in("ax") v)
}

fn in16(port: u16) -> u64 {
    return asm("in ax, dx\nmovzx eax, ax", out("rax"), in("dx") port)
}

fn out32(port: u16, v: u32) {
    asm("out dx, eax", in("dx") port, in("eax") v)
}

fn in32(port: u16) -> u64 {
    return asm("in eax, dx", out("rax"), in("dx") port)
}

// ------------------------------------------------------ PCI, das Noetige

fn cfg_addr(bus: u64, dev: u64, fun: u64, off: u64) -> u32 {
    return (0x80000000 | (bus << 16) | (dev << 11) | (fun << 8)
        | (off & 0xFC)) as u32
}

fn cfg32(bus: u64, dev: u64, fun: u64, off: u64) -> u64 {
    out32(PCI_ADDR, cfg_addr(bus, dev, fun, off))
    return in32(PCI_DATA)
}

fn cfg32_write(bus: u64, dev: u64, fun: u64, off: u64, v: u64) {
    out32(PCI_ADDR, cfg_addr(bus, dev, fun, off))
    out32(PCI_DATA, v as u32)
}

fn find_lfb() -> u64 {
    var dev: u64 = 0
    while dev < 32 {
        var fun: u64 = 0
        var last: u64 = 0
        while fun <= last {
            let id: u64 = cfg32(0, dev, fun, CFG_VENDOR)
            if (id & 0xFFFF) != 0xFFFF {
                if fun == 0 {
                    if (cfg32(0, dev, 0, CFG_HEADER) & 0x00800000) != 0 {
                        last = 7 // mehrfunktionales Geraet
                    }
                }
                let cls: u64 = (cfg32(0, dev, fun, CFG_CLASS) >> 24) & 0xFF
                if cls == CLASS_VGA {
                    let cmd: u64 = cfg32(0, dev, fun, CFG_COMMAND)
                    if (cmd & CMD_MEM) == 0 {
                        cfg32_write(0, dev, fun, CFG_COMMAND, cmd | CMD_MEM)
                    }
                    let bar: u64 = cfg32(0, dev, fun, CFG_BAR0)
                    if (bar & 1) == 0 {
                        let base: u64 = bar & 0xFFFFFFF0
                        if base != 0 {
                            return base
                        }
                    }
                }
            }
            fun = fun + 1
        }
        dev = dev + 1
    }
    return 0
}

// ------------------------------------------------------- der Modus

fn vbe_write(index: u64, value: u64) {
    out16(VBE_INDEX, index as u16)
    out16(VBE_DATA, value as u16)
}

fn vbe_read(index: u64) -> u64 {
    out16(VBE_INDEX, index as u16)
    return in16(VBE_DATA)
}

fn vbe_present() -> bool {
    let id: u64 = vbe_read(VBE_ID)
    return id >= VBE_ID_LO && id <= VBE_ID_HI
}

fn vbe_set(w: u64, h: u64) -> u64 {
    vbe_write(VBE_ENABLE, VBE_DISABLED)
    vbe_write(VBE_XRES, w)
    vbe_write(VBE_YRES, h)
    vbe_write(VBE_BPP, 32)
    vbe_write(VBE_BANK, 0)
    vbe_write(VBE_XOFF, 0)
    vbe_write(VBE_YOFF, 0)
    vbe_write(VBE_ENABLE, VBE_ENABLED | VBE_LFB)
    if virt_want >= w {
        vbe_write(VBE_VWIDTH, virt_want)
    }
    if vbe_read(VBE_XRES) != w || vbe_read(VBE_YRES) != h {
        return 0
    }
    if vbe_read(VBE_BPP) != 32 {
        return 0
    }
    var vw: u64 = vbe_read(VBE_VWIDTH)
    if vw < w {
        vw = w
    }
    return vw * 4
}

fn slot_used(state: u64, i: u64) -> u64 {
    return kstate.get(state, WIN_LIST + i * 8)
}

fn wc(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_WC)
}

fn pat_setup(state: u64) -> bool {
    let alt: u64 = msr.rd0(state, IA32_PAT)
    if alt == 0 {
        return false
    }
    let maske: u64 = 255 << 32
    let fresh: u64 = (alt & (~maske)) | (PAT_WC << 32)
    if !msr.wr(state, IA32_PAT, fresh) {
        return false
    }
    let c: u64 = asm("mov rax, cr3", out("rax"))
    asm("mov cr3, rax", in("rax") c)
    let ok: bool = msr.rd0(state, IA32_PAT) == fresh
    if ok {
        // vboxlag: PAT is PER CORE. The other cores were started before the screen (smp.stage) and still have the power-on value
        // (index 4 = write-back): a write to the card from core 1 or 2 would go through a write-back mapping of the same pages.
        // They pick the value up in their next timer tick (`sched.pat_here`).
        kstate.set(state, FB_OFF + S_PATDONE, 1)
        kstate.set(state, FB_OFF + S_PATVAL, fresh)
    }
    return ok
}

fn fb_bits(state: u64, uncached: bool) -> u64 {
    var bits: u64 = PAGE_PRESENT | PAGE_WRITE | PAGE_HUGE
    if uncached {
        return bits | PAGE_PCD | PAGE_PWT
    }
    if kstate.get(state, FB_OFF + S_WC) != 0 {
        return bits | PAGE_PAT_HUGE
    }
    return bits
}

// ================================================ RUNDE MERGE-11: R5-e1000
// DER RAHMENPUFFER LAESST GERAETEN IHRE PLAETZE.
const DEVICES_FREE: u64 = 2

// W-C3: how many 2 MiB tiles the framebuffer may take AT MOST: map_run refuses when (tiles held by other devices) + n + DEVICES_FREE
// > WIN_SLOTS. The framebuffer's own tiles do not count (remap frees them first). vmode.check_custom asks this BEFORE a mode is set, so a
// host hint that would not map is shrunk in one clean step instead of switching, failing in remap and rolling back (VirtualBox z16:
// 2496x1575 = 8 tiles failed, 7 tiles = 2400x1500 worked).
fn tile_room(state: u64) -> u64 {
    return tile_room_in(room_used(state), room_first(state), room_nfb(state))
}

// W-EDID: bit i = window tile i is held (by the framebuffer or a device).
fn room_used(state: u64) -> u64 {
    var m: u64 = 0
    var i: u64 = 0
    while i < WIN_SLOTS {
        if slot_used(state, i) != 0 {
            m = m | (1 << i)
        }
        i = i + 1
    }
    return m
}

// First tile of the framebuffer's own window (WIN_SLOTS = it has none) and how many tiles it holds.
fn room_first(state: u64) -> u64 {
    let s0: u64 = kstate.get(state, FB_OFF + S_SLOT0)
    if s0 == 0 {
        return WIN_SLOTS
    }
    return s0 - 1
}

fn room_nfb(state: u64) -> u64 {
    if kstate.get(state, FB_OFF + S_SLOT0) == 0 {
        return 0
    }
    return kstate.get(state, FB_OFF + S_HUGES)
}

// Pure form of tile_room (no state): `used` = held tiles, the framebuffer's own tiles [first, first + n_fb) do not count.
fn tile_room_in(used: u64, first: u64, n_fb: u64) -> u64 {
    var others: u64 = 0
    var i: u64 = 0
    while i < WIN_SLOTS {
        if ((used >> i) & 1) != 0 && !(i >= first && i < first + n_fb) {
            others = others + 1
        }
        i = i + 1
    }
    if others + DEVICES_FREE >= WIN_SLOTS {
        return 0
    }
    return WIN_SLOTS - DEVICES_FREE - others
}

// W-L2: true when map_run would find a CONTIGUOUS run of `n` free tiles once the framebuffer's own tiles are released (remap frees them
// first). tile_room only counts tiles; a device tile in the middle (EDID block) splits the window, so a hint that passed tile_room could
// still fail in map_run -> mode switch, failed remap, rollback through the old mode (z22 VirtualBox: 2496x1507 -> 1280 -> 2340, white
// screen, host CPU 100 %, once a kernel #GP). Asked by vmode.check_custom BEFORE the mode is set.
fn run_room(state: u64, n: u64) -> bool {
    return run_room_in(room_used(state), room_first(state), room_nfb(state), n,
        kstate.mode_on(state, kstate.M_ROOMOLD))
}

// Pure form of run_room. `count_only` is the counter-proof (`roomold`): the pre-W-L2 rule that only counts free tiles.
fn run_room_in(used: u64, first: u64, n_fb: u64, n: u64, count_only: bool) -> bool {
    if n == 0 || n > WIN_SLOTS {
        return false
    }
    var run: u64 = 0
    var total: u64 = 0
    var i: u64 = 0
    while i < WIN_SLOTS {
        if ((used >> i) & 1) == 0 || (i >= first && i < first + n_fb) {
            run = run + 1
            total = total + 1
            if !count_only && run >= n {
                return true
            }
        } else {
            run = 0
        }
        i = i + 1
    }
    if count_only {
        return total >= n
    }
    return false
}

// W-EDID: twelve promises about the window-room rules, on synthetic tile masks (no page table is touched). WIN_SLOTS = 16, DEVICES_FREE = 2.
fn selftest5(state: u64) -> u64 {
    var n: u64 = 0
    let old: bool = kstate.mode_on(state, kstate.M_ROOMOLD)
    // 1 empty window, no framebuffer: all 16 tiles are one run; 17 and 0 never fit
    if run_room_in(0, WIN_SLOTS, 0, 16, old) && !run_room_in(0, WIN_SLOTS, 0, 17, old) && !run_room_in(0, WIN_SLOTS, 0, 0, old) {
        n = n + 1
    }
    // 2 one device tile in the middle (slot 8) splits 16 into 8 + 7: 8 fits, 9 does not (the W-L2 case)
    if run_room_in(1 << 8, WIN_SLOTS, 0, 8, old) {
        n = n + 1
    }
    if !run_room_in(1 << 8, WIN_SLOTS, 0, 9, old) {
        n = n + 1
    }
    // 4 the framebuffer's own tiles count as free (remap releases them): fb at 2..5, devices at 1 and 6 -> run 2..5 = 4, 7..15 = 9
    let u3: u64 = (1 << 1) | (3 << 2) | (3 << 4) | (1 << 6)
    if run_room_in(u3, 2, 4, 9, old) && !run_room_in(u3, 2, 4, 10, old) {
        n = n + 1
    }
    // 5 every second tile held: single tiles only
    if run_room_in(0x5555, WIN_SLOTS, 0, 1, old) && !run_room_in(0x5555, WIN_SLOTS, 0, 2, old) {
        n = n + 1
    }
    // 6 a full window has no room, unless the framebuffer itself holds 3 of the tiles
    if !run_room_in(0xFFFF, WIN_SLOTS, 0, 1, old) {
        n = n + 1
    }
    if run_room_in(0xFFFF, 4, 3, 3, old) && !run_room_in(0xFFFF, 4, 3, 4, old) {
        n = n + 1
    }
    // 8 tile_room counts: empty = 14 (16 - 2 kept free for later devices), 3 devices = 11, own fb tiles do not count, full = 0
    if tile_room_in(0, WIN_SLOTS, 0) == 14 && tile_room_in(7 << 3, WIN_SLOTS, 0) == 11 {
        n = n + 1
    }
    if tile_room_in((15 << 2) | (7 << 8), 2, 4) == 11 && tile_room_in(0xFFFF, WIN_SLOTS, 0) == 0 {
        n = n + 1
    }
    // 10 the two rules together: one device tile at slot 8 -> tile_room says 13, but 13 contiguous tiles do NOT exist
    if tile_room_in(1 << 8, WIN_SLOTS, 0) == 13 && !run_room_in(1 << 8, WIN_SLOTS, 0, 13, old) {
        n = n + 1
    }
    // 11 and the live state agrees with its own mask: the framebuffer's tiles are inside [first, first + n_fb)
    if room_nfb(state) <= WIN_SLOTS && (room_nfb(state) == 0 || room_first(state) + room_nfb(state) <= WIN_SLOTS) {
        n = n + 1
    }
    // 12 the mode that is on screen right now always fits (its tiles are released first)
    if !ready(state) || room_nfb(state) == 0 || run_room(state, room_nfb(state)) {
        n = n + 1
    }
    return n
}

fn selftest5_max() -> u64 {
    return 12
}

fn map_run(state: u64, block: u64, n: u64, uncached: bool) -> u64 {
    if n == 0 || n > WIN_SLOTS {
        return 0
    }
    var belegt: u64 = 0
    var b: u64 = 0
    while b < WIN_SLOTS {
        if slot_used(state, b) != 0 {
            belegt = belegt + 1
        }
        b = b + 1
    }
    if belegt + n + DEVICES_FREE > WIN_SLOTS {
        return 0
    }
    let pd: u64 = kernel_pd(state)
    if pd == 0 {
        return 0
    }
    var start: u64 = 0
    while start + n <= WIN_SLOTS {
        var k: u64 = 0
        var free: bool = true
        while k < n {
            if slot_used(state, start + k) != 0 {
                free = false
                k = n
            } else {
                k = k + 1
            }
        }
        if free {
            let bits: u64 = fb_bits(state, uncached)
            var j: u64 = 0
            while j < n {
                __mmio_write64((pd + (WIN_FIRST + start + j) * 8) as *mut u64,
                    (block + j * HUGE_SIZE) | bits)
                kstate.set(state, WIN_LIST + (start + j) * 8,
                    block + j * HUGE_SIZE + 1)
                j = j + 1
            }
            let c: u64 = asm("mov rax, cr3", out("rax"))
            asm("mov cr3, rax", in("rax") c)
            return WIN_VIRT + start * HUGE_SIZE
        }
        start = start + 1
    }
    return 0
}

fn kernel_pd(state: u64) -> u64 {
    var pml4: u64 = kstate.get(state, kstate.KPML4)
    if pml4 == 0 {
        pml4 = asm("mov rax, cr3", out("rax")) & ADDR_MASK
    }
    let pdpt: u64 = __mmio_read64(pml4 as *mut u64) & ADDR_MASK
    if pdpt == 0 {
        return 0
    }
    return __mmio_read64(pdpt as *mut u64) & ADDR_MASK
}

// ------------------------------------------------------------ Start

//     fb: 1920x1080x32  pitch=7680  src=mb  ...  back=none
fn need_bytes(mbi: u64, want_w: u64, want_h: u64) -> u64 {
    if mbi != 0 {
        if (kstate.get32(mbi + MB_FLAGS) & MB_FB_FLAG) != 0 {
            if kstate.get8(mbi + MB_FB_TYPE) == MB_FB_RGB {
                let p: u64 = __mmio_read64((mbi + MB_FB_ADDR) as *mut u64)
                let pt: u64 = kstate.get32(mbi + MB_FB_PITCH)
                let w: u64 = kstate.get32(mbi + MB_FB_WIDTH)
                let h: u64 = kstate.get32(mbi + MB_FB_HEIGHT)
                let bp: u64 = kstate.get8(mbi + MB_FB_BPP)
                if p != 0 && w != 0 && h != 0 && bp == 32 && pt >= w * 4 {
                    return pt * h
                }
            }
        }
    }
    if want_w == 0 || want_h == 0 {
        return 0
    }
    return want_w * 4 * want_h
}

fn scale_for(w: u64, h: u64) -> u64 {
    if h >= 2600 || w >= 4600 {
        return 3
    }
    if h >= 1600 || w >= 2800 {
        return 2
    }
    return 1
}

static mut pad_wunsch: u64 = 0
static mut virt_want: u64 = 0
static mut rgb_want: u64 = 0
static mut canon_want: u64 = 0
static mut noswz_want: u64 = 0
static mut nopitch_want: u64 = 0

fn canon_probe(state: u64) {
    if canon_want == 0 || !ready(state) {
        return
    }
    fill(state, 500, 0, 100, 100, 0xFF0000)
    fill(state, 600, 0, 100, 100, 0x00FF00)
    fill(state, 700, 0, 100, 100, 0x0000FF)
    fill(state, 800, 0, 100, 100, 0x102030)
}

fn virt_set(n: u64) {
    virt_want = n
}

fn rgb_set(n: u64) {
    rgb_want = n
}

fn pad_set(n: u64) {
    pad_wunsch = n
}

fn pad_value() -> u64 {
    return pad_wunsch
}

fn init(state: u64, mbi: u64, want_w: u64, want_h: u64,
    back: u64, back_bytes: u64, uncached: bool) -> bool {
    font.load(state + FONT_OFF)

    var cur_source: u64 = SRC_NONE
    var p: u64 = 0
    var w: u64 = 0
    var h: u64 = 0
    var pt: u64 = 0
    var bp: u64 = 32
    var rs: u64 = 16
    var gs: u64 = 8
    var bs: u64 = 0

    if mbi != 0 {
        if (kstate.get32(mbi + MB_FLAGS) & MB_FB_FLAG) != 0 {
            if kstate.get8(mbi + MB_FB_TYPE) == MB_FB_RGB {
                p = __mmio_read64((mbi + MB_FB_ADDR) as *mut u64)
                pt = kstate.get32(mbi + MB_FB_PITCH)
                w = kstate.get32(mbi + MB_FB_WIDTH)
                h = kstate.get32(mbi + MB_FB_HEIGHT)
                bp = kstate.get8(mbi + MB_FB_BPP)
                rs = kstate.get8(mbi + MB_FB_RPOS)
                gs = kstate.get8(mbi + MB_FB_GPOS)
                bs = kstate.get8(mbi + MB_FB_BPOS)
                if p != 0 && w != 0 && h != 0 && bp == 32 {
                    cur_source = SRC_MB
                }
            }
        }
    }

    if cur_source == SRC_NONE {
        if vbe_present() {
            let lfb: u64 = find_lfb()
            if lfb != 0 {
                let gemessen: u64 = vbe_set(want_w, want_h)
                if gemessen != 0 {
                    p = lfb
                    w = want_w
                    h = want_h
                    pt = gemessen
                    bp = 32
                    rs = 16
                    gs = 8
                    bs = 0
                    cur_source = SRC_VBE
                }
            }
        }
    }

    if cur_source == SRC_NONE {
        return false
    }

    if nopitch_want != 0 && pt > w * (bp / 8) {
        pt = w * (bp / 8)
    }
    if pt < w * (bp / 8) {
        return false
    }

    let n: u64 = pt * h
    let blk: u64 = p & (~(HUGE_SIZE - 1))
    let inner: u64 = p - blk
    var nn: u64 = n
    if want(state, M_FLIP) && !want(state, M_NOFLIP) {
        nn = n * 2
    }
    var kacheln: u64 = (inner + nn + HUGE_SIZE - 1) / HUGE_SIZE
    // RUNDE ZWISCHENSPEICHER: PAT ZUERST, DANN ABBILDEN.
    var wc: u64 = 0
    if !uncached && !want(state, M_WB) {
        if pat_setup(state) {
            wc = 1
        }
    }
    kstate.set(state, FB_OFF + S_WC, wc)
    var window: u64 = map_run(state, blk, kacheln, uncached)
    var streifen: u64 = 0
    // RUNDE ECHTHARDWARE-6: `fbstreifen` erzwingt Justins Weg.
    if want(state, M_STRIPE) {
        window = 0
    }
    if window == 0 {
        if back == 0 || back_bytes < n {
            return false
        }
        window = map_run(state, blk, 1, uncached)
        if window == 0 {
            return false
        }
        kacheln = 1
        streifen = 1
    }

    if pad_wunsch != 0 && w > pad_wunsch + 320 {
        w = w - pad_wunsch
    }
    kstate.set(state, FB_OFF + S_PHYS, p)
    kstate.set(state, FB_OFF + S_ADDR, window + inner)
    kstate.set(state, FB_OFF + S_BLOCK, blk)
    kstate.set(state, FB_OFF + S_OFFSET, inner)
    kstate.set(state, FB_OFF + S_HUGES, kacheln)
    kstate.set(state, FB_OFF + S_WIDTH, w)
    kstate.set(state, FB_OFF + S_HEIGHT, h)
    kstate.set(state, FB_OFF + S_PITCH, pt)
    kstate.set(state, FB_OFF + S_PWIDTH, w)
    kstate.set(state, FB_OFF + S_PHEIGHT, h)
    kstate.set(state, FB_OFF + S_PPITCH, pt)
    kstate.set(state, FB_OFF + S_SLOT0, (window - WIN_VIRT) / HUGE_SIZE + 1)
    kstate.set(state, FB_OFF + S_STRIPE, streifen)
    kstate.set(state, FB_OFF + S_SLOTV, window)
    kstate.set(state, FB_OFF + S_LUT, 0)
    kstate.set(state, FB_OFF + S_ROT, 0)
    kstate.set(state, FB_OFF + S_SCALE, SCALE_FULL)
    kstate.set(state, FB_OFF + S_SAT, 100)
    kstate.set(state, FB_OFF + S_PRESENTS, 0)
    kstate.set(state, FB_OFF + S_BPP, bp)
    kstate.set(state, FB_OFF + S_BYTES, n)
    kstate.set(state, FB_OFF + S_MAPPED, kacheln *% HUGE_SIZE -% inner)
    kstate.set(state, FB_OFF + S_SOURCE, cur_source)
    if rgb_want != 0 {
        rs = 0
        gs = 8
        bs = 16
    }
    kstate.set(state, FB_OFF + S_PRS, rs)
    kstate.set(state, FB_OFF + S_PGS, gs)
    kstate.set(state, FB_OFF + S_PBS, bs)
    if back != 0 && streifen == 0 && bp == 32 && noswz_want == 0 {
        rs = 16
        gs = 8
        bs = 0
    }
    kstate.set(state, FB_OFF + S_RSHIFT, rs)
    kstate.set(state, FB_OFF + S_GSHIFT, gs)
    kstate.set(state, FB_OFF + S_BSHIFT, bs)
    var us: u64 = kstate.get(state, FB_OFF + S_UIWANT)
    if us == 0 || us > 4 {
        us = scale_for(w, h)
    }
    kstate.set(state, FB_OFF + S_UISCALE, us)
    kstate.set(state, FB_OFF + S_FSCALE, us)
    kstate.set(state, FB_OFF + S_COLS, w / (font.GLYPH_W * us))
    kstate.set(state, FB_OFF + S_ROWS, h / (font.GLYPH_H * us))
    kstate.set(state, FB_OFF + S_UNCACHED, bool_num(uncached))

    if back != 0 && back_bytes >= n {
        kstate.set(state, FB_OFF + S_BACK, back)
        kstate.set(state, FB_OFF + S_BACKBYTES, back_bytes)
        kstate.set(state, FB_OFF + S_DRAW, back)
    } else {
        kstate.set(state, FB_OFF + S_BACK, 0)
        kstate.set(state, FB_OFF + S_DRAW, window + inner)
    }

    kstate.set(state, FB_OFF + S_FG, rgb(state, 0xC8, 0xD0, 0xD8))
    kstate.set(state, FB_OFF + S_BG, 0)
    kstate.set(state, FB_OFF + S_CX, 0)
    kstate.set(state, FB_OFF + S_CY, 0)
    kstate.set(state, FB_OFF + S_CURSOR, 1)
    kstate.set(state, FB_OFF + S_READY, 1)
    clear(state, 0)
    flush(state)
    return true
}

fn bool_num(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

// -------------------------------------------------------- die Zahlen

fn band(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_BAND)
}

fn band_lo(state: u64) -> u64 {
    if kstate.get(state, FB_OFF + S_BANDOPEN) != 0 {
        return 0
    }
    return kstate.get(state, FB_OFF + S_BAND)
}

fn band_open(state: u64, on: bool) {
    var v: u64 = 0
    if on {
        v = 1
    }
    kstate.set(state, FB_OFF + S_BANDOPEN, v)
}

fn set_band(state: u64, px: u64) -> bool {
    let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    if h == 0 {
        return false
    }
    var n: u64 = px
    if n * 2 >= h {
        n = 0
    }
    if n != 0 {
        let w0: u64 = kstate.get(state, FB_OFF + S_WIDTH)
        let pitch: u64 = kstate.get(state, FB_OFF + S_PITCH)
        let basis: u64 = kstate.get(state, FB_OFF + S_DRAW)
        let hh0: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
        if w0 != 0 && pitch != 0 && basis != 0 && n <= hh0 {
            var lines: u64 = n
            let bb: u64 = kstate.get(state, FB_OFF + S_BACKBYTES)
            if kstate.get(state, FB_OFF + S_BACK) == basis && bb != 0 {
                let fits: u64 = bb / pitch
                if fits < lines {
                    lines = fits
                }
            }
            var yy: u64 = 0
            while yy < lines {
                fill_words(basis +% yy *% pitch, 0, (w0 *% 4) / 8)
                yy = yy + 1
            }
        }
    }
    kstate.set(state, FB_OFF + S_BAND, n)
    let zh: u64 = font.GLYPH_H * fscale(state)
    if zh != 0 && h > n {
        kstate.set(state, FB_OFF + S_ROWS, (h - n) / zh)
    }
    kstate.set(state, FB_OFF + S_CX, 0)
    kstate.set(state, FB_OFF + S_CY, 0)
    return n != 0
}

fn ready(state: u64) -> bool {
    return kstate.get(state, FB_OFF + S_READY) != 0
}

fn width(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_WIDTH)
}

fn height(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_HEIGHT)
}

fn pitch(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_PITCH)
}

fn bpp(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_BPP)
}

fn bytes(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_BYTES)
}

fn addr(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_ADDR)
}

fn phys(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_PHYS)
}

fn block(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_BLOCK)
}

fn offset(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_OFFSET)
}

fn huges(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_HUGES)
}

fn source(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_SOURCE)
}

fn back(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_BACK)
}

fn draw_at(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_DRAW)
}

fn draw_set(state: u64, v: u64) {
    kstate.set(state, FB_OFF + S_DRAW, v)
}

fn dirty_lo(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_DIRTY_LO)
}

fn dirty_hi(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_DIRTY_HI)
}

fn dirty_put(state: u64, lo: u64, hi: u64) {
    kstate.set(state, FB_OFF + S_DIRTY_LO, lo)
    kstate.set(state, FB_OFF + S_DIRTY_HI, hi)
}

fn cols(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_COLS)
}

fn rows(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_ROWS)
}

fn cx(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_CX)
}

fn cy(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_CY)
}

fn chars(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_CHARS)
}

fn flushes(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_FLUSHES)
}

fn scrolls(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_SCROLLS)
}

fn double_buffered(state: u64) -> bool {
    return kstate.get(state, FB_OFF + S_BACK) != 0
}

fn uncached(state: u64) -> bool {
    return kstate.get(state, FB_OFF + S_UNCACHED) != 0
}

fn cursor_on(state: u64) -> bool {
    return kstate.get(state, FB_OFF + S_CURSOR) != 0
}

fn echo_on(state: u64) -> bool {
    return kstate.get(state, FB_OFF + S_ECHO) != 0
}

fn fscale(state: u64) -> u64 {
    let v: u64 = kstate.get(state, FB_OFF + S_FSCALE)
    if v == 0 {
        return 1
    }
    return v
}

fn uiscale(state: u64) -> u64 {
    let v: u64 = kstate.get(state, FB_OFF + S_UISCALE)
    if v == 0 {
        return 1
    }
    return v
}

fn set_uiscale(state: u64, v: u64) -> bool {
    if v < 1 || v > 4 {
        return false
    }
    kstate.set(state, FB_OFF + S_UISCALE, v)
    kstate.set(state, FB_OFF + S_FSCALE, v)
    relayout(state)
    home(state)
    return true
}

fn stripe(state: u64) -> bool {
    return kstate.get(state, FB_OFF + S_STRIPE) != 0
}

fn res_w(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_RESW)
}

fn res_h(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_RESH)
}

fn geometry_ok(state: u64) -> bool {
    if !ready(state) {
        return false
    }
    let w: u64 = width(state)
    let h: u64 = height(state)
    if w == 0 || h == 0 {
        return false
    }
    if pitch(state) < w * (bpp(state) / 8) {
        return false
    }
    if bytes(state) != panel_pitch(state) * panel_h(state) {
        return false
    }
    if panel_pitch(state) < panel_w(state) * (bpp(state) / 8) {
        return false
    }
    if cols(state) != w / font.GLYPH_W {
        return false
    }
    return rows(state) == h / font.GLYPH_H
}

// ------------------------------------------------------ die Farben

fn rgb(state: u64, r: u64, g: u64, b: u64) -> u64 {
    return ((r & 0xFF) << kstate.get(state, FB_OFF + S_RSHIFT))
        | ((g & 0xFF) << kstate.get(state, FB_OFF + S_GSHIFT))
        | ((b & 0xFF) << kstate.get(state, FB_OFF + S_BSHIFT))
}

fn set_color(state: u64, fg: u64, bg: u64) {
    kstate.set(state, FB_OFF + S_FG, fg)
    kstate.set(state, FB_OFF + S_BG, bg)
}

fn set_cursor(state: u64, on: bool) {
    kstate.set(state, FB_OFF + S_CURSOR, bool_num(on))
}

fn set_echo(state: u64, on: bool) {
    kstate.set(state, FB_OFF + S_ECHO, bool_num(on))
}

// ------------------------------------------------- die Zeichengrundlagen

// ---------------------------------------------- die beiden Blockbefehle

fn fill_words(p: u64, value: u64, words: u64) {
    if words == 0 {
        return
    }
    asm("cld\nrep stosq", in("rdi") p, in("rax") value, in("rcx") words,
        clobber("rdi"), clobber("rcx"), clobber("memory"))
}

fn copy_words(dst: u64, src: u64, words: u64) {
    if words == 0 {
        return
    }
    asm("cld\nrep movsq", in("rdi") dst, in("rsi") src, in("rcx") words,
        clobber("rdi"), clobber("rsi"), clobber("rcx"), clobber("memory"))
}

fn twice(color: u64) -> u64 {
    let c: u64 = color & 0xFFFFFFFF
    return (c << 32) | c
}

fn spot(state: u64, x: u64, y: u64) -> u64 {
    return y *% kstate.get(state, FB_OFF + S_PITCH) +% x *% 4
}

fn pixel(state: u64, x: u64, y: u64, color: u64) {
    if x >= kstate.get(state, FB_OFF + S_WIDTH) {
        return
    }
    if y >= kstate.get(state, FB_OFF + S_HEIGHT) {
        return
    }
    if y < band_lo(state) {
        return
    }
    __mmio_write32((kstate.get(state, FB_OFF + S_DRAW) +% spot(state, x, y))
        as *mut u32, color as u32)
}

fn flip_setup(state: u64) -> bool {
    if kstate.get(state, FB_OFF + S_SOURCE) != SRC_VBE {
        return false
    }
    if !vbe_present() {
        return false
    }
    let w: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    let pt: u64 = kstate.get(state, FB_OFF + S_PITCH)
    vbe_write(VBE_VHEIGHT, h * 2)
    if vbe_read(VBE_VHEIGHT) < h * 2 {
        return false
    }
    if kstate.get(state, FB_OFF + S_MAPPED) < h * 2 *% pt {
        return false
    }
    if kstate.get(state, FB_OFF + S_STRIPE) != 0 {
        return false
    }
    let _u: u64 = w
    kstate.set(state, FB_OFF + S_VH, h * 2)
    kstate.set(state, FB_OFF + S_PAGE, 1)
    kstate.set(state, FB_OFF + S_FLIPS, 0)
    kstate.set(state, FB_OFF + S_FLIP, 1)
    vbe_write(VBE_YOFF, 0)
    return true
}

fn flip_on(state: u64) -> bool {
    return kstate.get(state, FB_OFF + S_FLIP) != 0
}

fn flips(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_FLIPS)
}

fn page(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_PAGE)
}

fn draw_base(state: u64) -> u64 {
    let basis: u64 = kstate.get(state, FB_OFF + S_ADDR)
    if kstate.get(state, FB_OFF + S_FLIP) == 0 {
        return basis
    }
    let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    let pt: u64 = kstate.get(state, FB_OFF + S_PITCH)
    return basis +% kstate.get(state, FB_OFF + S_PAGE) *% h *% pt
}

fn flip(state: u64) {
    if kstate.get(state, FB_OFF + S_FLIP) == 0 {
        return
    }
    let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    let s: u64 = kstate.get(state, FB_OFF + S_PAGE)
    kstate.add(state, FB_OFF + S_SEQ, 1)
    arch.barrier_write()
    nachspuelen(state)
    vbe_write(VBE_YOFF, s *% h)
    kstate.set(state, FB_OFF + S_PAGE, 1 - s)
    kstate.add(state, FB_OFF + S_FLIPS, 1)
    arch.barrier_write()
    kstate.add(state, FB_OFF + S_SEQ, 1)
}

fn front_paar(state: u64, x: u64, y0: u64, y1: u64, aus: u64) -> bool {
    let w: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    if x >= w || y0 >= h || y1 >= h {
        return false
    }
    if kstate.get(state, FB_OFF + S_STRIPE) != 0 {
        return false
    }
    let basis: u64 = kstate.get(state, FB_OFF + S_ADDR)
    if basis == 0 {
        return false
    }
    let pt: u64 = kstate.get(state, FB_OFF + S_PITCH)
    //     flips=1     (fast nie umgeschaltet)  0 Risse in 2 892 193
    //     flips~4700  (staendig umgeschaltet)  ~2 Risse in ~1 200 000
    let f0: u64 = kstate.get(state, FB_OFF + S_SEQ)
    if (f0 & 1) != 0 {
        return false
    }
    arch.barrier_read()
    var off: u64 = 0
    if kstate.get(state, FB_OFF + S_FLIP) != 0 {
        off = (1 - kstate.get(state, FB_OFF + S_PAGE)) *% h
    }
    let a: u64 = __mmio_read32((basis +% (y0 +% off) *% pt
        +% x *% 4) as *mut u32) as u64
    let b: u64 = __mmio_read32((basis +% (y1 +% off) *% pt
        +% x *% 4) as *mut u32) as u64
    arch.barrier_read()
    if kstate.get(state, FB_OFF + S_SEQ) != f0 {
        return false
    }
    __mmio_write64(aus as *mut u64, a)
    __mmio_write64((aus + 8) as *mut u64, b)
    return true
}

fn front_pixel(state: u64, x: u64, y: u64) -> u64 {
    if x >= kstate.get(state, FB_OFF + S_WIDTH) {
        return 0xFFFFFFFF
    }
    if y >= kstate.get(state, FB_OFF + S_HEIGHT) {
        return 0xFFFFFFFF
    }
    if kstate.get(state, FB_OFF + S_STRIPE) != 0 {
        return 0xFFFFFFFF
    }
    let basis: u64 = kstate.get(state, FB_OFF + S_ADDR)
    if basis == 0 {
        return 0xFFFFFFFF
    }
    let pt: u64 = kstate.get(state, FB_OFF + S_PITCH)
    var vy: u64 = y
    if kstate.get(state, FB_OFF + S_FLIP) != 0 {
        let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
        vy = y +% (1 - kstate.get(state, FB_OFF + S_PAGE)) *% h
    }
    return __mmio_read32((basis +% vy *% pt +% x *% 4) as *mut u32) as u64
}

fn get_pixel(state: u64, x: u64, y: u64) -> u64 {
    if x >= kstate.get(state, FB_OFF + S_WIDTH) {
        return 0
    }
    if y >= kstate.get(state, FB_OFF + S_HEIGHT) {
        return 0
    }
    return __mmio_read32((kstate.get(state, FB_OFF + S_DRAW)
        +% spot(state, x, y)) as *mut u32) as u64
}

// src-over mit vorbelegter Deckung a (0..255):
//
//     out = (src * a + dst * (255 - a)) / 255
//     Division   526 Takte je Bildpunkt   Abbild 2 846 920 Oktette
//     Schieben   646 Takte je Bildpunkt   Abbild 2 846 920 Oktette
fn mix8(dst: u64, src: u64, a: u64, ia: u64) -> u64 {
    return (src *% a +% dst *% ia +% 127) / 255
}

fn blend(state: u64, dst: u64, src: u64, a: u64) -> u64 {
    if a == 0 {
        kstate.set(state, FB_OFF + S_BLENDS0,
            kstate.get(state, FB_OFF + S_BLENDS0) +% 1)
        return dst
    }
    if a >= 255 {
        kstate.set(state, FB_OFF + S_BLENDS0,
            kstate.get(state, FB_OFF + S_BLENDS0) +% 1)
        return src
    }
    let ia: u64 = 255 - a
    let r: u64 = mix8((dst >> 16) & 0xFF, (src >> 16) & 0xFF, a, ia)
    let g: u64 = mix8((dst >> 8) & 0xFF, (src >> 8) & 0xFF, a, ia)
    let b: u64 = mix8(dst & 0xFF, src & 0xFF, a, ia)
    kstate.set(state, FB_OFF + S_BLENDS,
        kstate.get(state, FB_OFF + S_BLENDS) +% 1)
    return (r << 16) | (g << 8) | b
}

fn scaled_row_a(state: u64, y: u64, x0: i64, x1: i64, src_row: u64, ox: i64, bw: i64, nw: i64, a: u64) {
    if a == 0 || nw <= 0 || bw <= 0 {
        return
    }
    if y >= kstate.get(state, FB_OFF + S_HEIGHT) || y < band_lo(state) {
        return
    }
    var c0: i64 = x0
    var c1: i64 = x1
    if c0 < ox {
        c0 = ox
    }
    if c0 < 0 {
        c0 = 0
    }
    let sw: i64 = kstate.get(state, FB_OFF + S_WIDTH) as i64
    if c1 > sw {
        c1 = sw
    }
    if c1 > ox + nw {
        c1 = ox + nw
    }
    if c1 <= c0 {
        return
    }
    let num0: i64 = (c0 - ox) * bw
    var q: i64 = num0 / nw
    var r: i64 = num0 - q * nw
    let qs: i64 = bw / nw
    let rs: i64 = bw - qs * nw
    var out: u64 = kstate.get(state, FB_OFF + S_DRAW) +% spot(state, c0 as u64, y)
    var n: i64 = c1 - c0
    var drawn: u64 = 0
    let ia: u64 = 255 - a
    while n > 0 {
        if q >= 0 && q < bw {
            let c: u64 = (__mmio_read32((src_row +% (q as u64) *% 4) as *mut u32) as u64) & 0x00FFFFFF
            if a >= 255 {
                __mmio_write32(out as *mut u32, c as u32)
            } else {
                let alt: u64 = __mmio_read32(out as *mut u32) as u64
                let rr: u64 = mix8((alt >> 16) & 0xFF, (c >> 16) & 0xFF, a, ia)
                let gg: u64 = mix8((alt >> 8) & 0xFF, (c >> 8) & 0xFF, a, ia)
                let bb: u64 = mix8(alt & 0xFF, c & 0xFF, a, ia)
                __mmio_write32(out as *mut u32, ((rr << 16) | (gg << 8) | bb) as u32)
            }
            drawn = drawn + 1
        }
        out = out +% 4
        q = q + qs
        r = r + rs
        if r >= nw {
            r = r - nw
            q = q + 1
        }
        n = n - 1
    }
    if drawn == 0 {
        return
    }
    if a >= 255 {
        kstate.set(state, FB_OFF + S_BLENDS0, kstate.get(state, FB_OFF + S_BLENDS0) +% drawn)
    } else {
        kstate.set(state, FB_OFF + S_BLENDR, kstate.get(state, FB_OFF + S_BLENDR) +% drawn)
        kstate.set(state, FB_OFF + S_BLENDS, kstate.get(state, FB_OFF + S_BLENDS) +% drawn)
    }
    dirty_x(state, c0 as u64, c1 as u64, y, y + 1)
}

fn pixel_a(state: u64, x: u64, y: u64, color: u64, a: u64) {
    if a == 0 {
        kstate.set(state, FB_OFF + S_BLENDS0,
            kstate.get(state, FB_OFF + S_BLENDS0) +% 1)
        return
    }
    if x >= kstate.get(state, FB_OFF + S_WIDTH) {
        return
    }
    if y >= kstate.get(state, FB_OFF + S_HEIGHT) {
        return
    }
    if y < band_lo(state) {
        return
    }
    if a >= 255 {
        kstate.set(state, FB_OFF + S_BLENDS0,
            kstate.get(state, FB_OFF + S_BLENDS0) +% 1)
        __mmio_write32((kstate.get(state, FB_OFF + S_DRAW)
            +% spot(state, x, y)) as *mut u32, color as u32)
        dirty_x(state, x, x + 1, y, y + 1)
        return
    }
    let p: u64 = kstate.get(state, FB_OFF + S_DRAW) +% spot(state, x, y)
    let alt: u64 = __mmio_read32(p as *mut u32) as u64
    kstate.set(state, FB_OFF + S_BLENDR,
        kstate.get(state, FB_OFF + S_BLENDR) +% 1)
    __mmio_write32(p as *mut u32, blend(state, alt, color, a) as u32)
    dirty_x(state, x, x + 1, y, y + 1)
}

fn hline_mask(state: u64, x: u64, y: u64, n: u64, color: u64, maske: u64,
    schritt: i64) {
    if n == 0 {
        return
    }
    let w: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    if y >= kstate.get(state, FB_OFF + S_HEIGHT) || x >= w {
        return
    }
    if y < band_lo(state) {
        return
    }
    var len: u64 = n
    if x + len > w {
        len = w - x
    }
    let sr: u64 = (color >> 16) & 0xFF
    let sg: u64 = (color >> 8) & 0xFF
    let sb: u64 = color & 0xFF
    var p: u64 = kstate.get(state, FB_OFF + S_DRAW) +% spot(state, x, y)
    var m: u64 = maske
    var k: u64 = 0
    var gemischt: u64 = 0
    while k < len {
        let a: u64 = __mmio_read8(m as *mut u8) as u64
        if a != 0 {
            if a >= 255 {
                __mmio_write32(p as *mut u32, color as u32)
            } else {
                let ia: u64 = 255 - a
                let alt: u64 = __mmio_read32(p as *mut u32) as u64
                let r: u64 = mix8((alt >> 16) & 0xFF, sr, a, ia)
                let g: u64 = mix8((alt >> 8) & 0xFF, sg, a, ia)
                let b: u64 = mix8(alt & 0xFF, sb, a, ia)
                __mmio_write32(p as *mut u32,
                    ((r << 16) | (g << 8) | b) as u32)
            }
            gemischt = gemischt + 1
        }
        p = p +% 4
        if schritt < 0 {
            m = m -% 1
        } else {
            m = m +% 1
        }
        k = k + 1
    }
    kstate.set(state, FB_OFF + S_BLENDS,
        kstate.get(state, FB_OFF + S_BLENDS) +% gemischt)
    kstate.set(state, FB_OFF + S_BLENDR,
        kstate.get(state, FB_OFF + S_BLENDR) +% gemischt)
    if gemischt != 0 {
        dirty(state, y, y + 1)
    }
}

//     1280x800    fill=442/1000 Takte je Punkt   fill_a=53929/1000
//     1920x1080   fill=849/1000                  fill_a=53788/1000
//     3440x1440   fill=1602/1000                 fill_a=62479/1000
const SIMD_MIN: u64 = 8

fn simd_ok(state: u64) -> bool {
    if want(state, M_NOSIMD) {
        return false
    }
    return fpu.enabled(state)
}

fn hline_a_simd(p0: u64, len: u64, color: u64, a: u64) -> u64 {
    let four: u64 = len / 4
    if four == 0 {
        return 0
    }
    var konst: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
    let c: u64 = color & 0xFFFFFFFF
    let ia: u64 = 255 - a
    let a16: u64 = (a << 48) | (a << 32) | (a << 16) | a
    let i16: u64 = (ia << 48) | (ia << 32) | (ia << 16) | ia
    let a128: u64 = (128 << 48) | (128 << 32) | (128 << 16) | 128
    konst[0] = (c << 32) | c
    konst[1] = (c << 32) | c
    konst[2] = a16
    konst[3] = a16
    konst[4] = i16
    konst[5] = i16
    konst[6] = a128
    konst[7] = a128

    asm("pxor xmm3,xmm3\nmovdqu xmm4,[rax]\nmovdqu xmm5,[rax+16]\nmovdqu xmm6,[rax+32]\nmovdqu xmm7,[rax+48]\nmovdqa xmm8,xmm4\npunpcklbw xmm4,xmm3\npunpckhbw xmm8,xmm3\npmullw xmm4,xmm5\npmullw xmm8,xmm5",
        in("rax") (&konst[0]) as u64, clobber("memory"))
    asm("test rcx,rcx\njz 2f\n1:\nmovdqu xmm0,[rdi]\nmovdqa xmm1,xmm0\npunpcklbw xmm0,xmm3\npunpckhbw xmm1,xmm3\npmullw xmm0,xmm6\npmullw xmm1,xmm6\npaddw xmm0,xmm4\npaddw xmm1,xmm8\npaddw xmm0,xmm7\npaddw xmm1,xmm7\nmovdqa xmm2,xmm0\npsrlw xmm2,8\npaddw xmm0,xmm2\npsrlw xmm0,8\nmovdqa xmm2,xmm1\npsrlw xmm2,8\npaddw xmm1,xmm2\npsrlw xmm1,8\npackuswb xmm0,xmm1\nmovdqu [rdi],xmm0\nadd rdi,16\ndec rcx\njnz 1b\n2:",
        in("rdi") p0, in("rcx") four,
        clobber("rdi"), clobber("rcx"), clobber("memory"))
    return four * 4
}

fn hline_a(state: u64, x: u64, y: u64, n: u64, color: u64, a: u64) {
    if a == 0 || n == 0 {
        return
    }
    let w: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    if y >= kstate.get(state, FB_OFF + S_HEIGHT) || x >= w {
        return
    }
    if y < band_lo(state) {
        return
    }
    var len: u64 = n
    if x + len > w {
        len = w - x
    }
    if a >= 255 {
        hline(state, x, y, len, color)
        return
    }
    let ia: u64 = 255 - a
    let sr: u64 = (color >> 16) & 0xFF
    let sg: u64 = (color >> 8) & 0xFF
    let sb: u64 = color & 0xFF
    var p: u64 = kstate.get(state, FB_OFF + S_DRAW) +% spot(state, x, y)
    var k: u64 = 0
    if simd_ok(state) && len >= SIMD_MIN {
        let fl: u64 = arch.irq_save()
        k = hline_a_simd(p, len, color, a)
        arch.irq_restore(fl)
        p = p +% k *% 4
        kstate.set(state, FB_OFF + S_SIMDPX,
            kstate.get(state, FB_OFF + S_SIMDPX) +% k)
    }
    while k < len {
        let alt: u64 = __mmio_read32(p as *mut u32) as u64
        let r: u64 = mix8((alt >> 16) & 0xFF, sr, a, ia)
        let g: u64 = mix8((alt >> 8) & 0xFF, sg, a, ia)
        let b: u64 = mix8(alt & 0xFF, sb, a, ia)
        __mmio_write32(p as *mut u32, ((r << 16) | (g << 8) | b) as u32)
        p = p +% 4
        k = k + 1
    }
    kstate.set(state, FB_OFF + S_BLENDS,
        kstate.get(state, FB_OFF + S_BLENDS) +% len)
    kstate.set(state, FB_OFF + S_BLENDR,
        kstate.get(state, FB_OFF + S_BLENDR) +% len)
    dirty_x(state, x, x + len, y, y + 1)
}

fn fill_a(state: u64, x: u64, y: u64, w: u64, h: u64, color: u64, a: u64) {
    var row: u64 = 0
    while row < h {
        hline_a(state, x, y + row, w, color, a)
        row = row + 1
    }
}

fn glasgrow_aus(state: u64) -> bool {
    return (mode(state) & M_NOGLAS) != 0
}

fn winfix_aus(state: u64) -> bool {
    return (mode(state) & M_NOWINFIX) != 0
}

fn zreap_aus(state: u64) -> bool {
    return (mode(state) & M_NOZREAP) != 0
}

fn nohidskip_an(state: u64) -> bool {
    return (mode(state) & M_NOHIDSKIP) != 0
}

fn nodiff_an(state: u64) -> bool {
    return (mode(state) & M_NODIFF) != 0
}

// VMSVGA full-update path: switch the diff flush off (whole rectangles to the card) and forget the shadow.
fn nodiff_force(state: u64) {
    kstate.set(state, FB_OFF + S_MODE, mode(state) | M_NODIFF)
    kstate.set(state, FB_OFF + S_SHVALID, 0)
}

fn phases_an(state: u64) -> bool {
    return (mode(state) & M_PHASES) != 0
}

fn beam_trust(state: u64) -> bool {
    return (mode(state) & M_KEEPMARKS) == 0
}

fn nobeam_an(state: u64) -> bool {
    return (mode(state) & M_NOBEAM) != 0
}

fn bm(state: u64, off: u64) -> u64 {
    return kstate.get(state, FB_OFF + off)
}

fn bm_set(state: u64, off: u64, v: u64) {
    kstate.set(state, FB_OFF + off, v)
}

fn bm_add(state: u64, off: u64, v: u64) {
    kstate.add(state, FB_OFF + off, v)
}

fn fullrows_an(state: u64) -> bool {
    return (mode(state) & M_FULLROWS) != 0
}

fn termdump_an(state: u64) -> bool {
    return (mode(state) & M_TERMDUMP) != 0
}

fn noshare_an(state: u64) -> bool {
    return (mode(state) & M_NOSHARE) != 0
}

fn nocomp_an(state: u64) -> bool {
    return (mode(state) & M_NOCOMP) != 0
}

fn nosnap_an(state: u64) -> bool {
    return (mode(state) & M_NOSNAP) != 0
}

fn nomtrr_an(state: u64) -> bool {
    return (mode(state) & M_NOMTRR) != 0
}

fn mtrrsim_an(state: u64) -> bool {
    return (mode(state) & M_MTRRSIM) != 0
}

fn mtrrstrict_an(state: u64) -> bool {
    return (mode(state) & M_MTRRSTRICT) != 0
}

fn noshapes_an(state: u64) -> bool {
    return (mode(state) & M_NOSHAPES) != 0
}

fn nowatch_an(state: u64) -> bool {
    return (mode(state) & M_NOWATCH) != 0
}

fn nocascade_an(state: u64) -> bool {
    return (mode(state) & M_NOCASCADE) != 0
}

fn nodragbar_an(state: u64) -> bool {
    return (mode(state) & M_NODRAGBAR) != 0
}

fn nostrip_an(state: u64) -> bool {
    return (mode(state) & M_NOSTRIP) != 0
}

fn rgn_aus(state: u64) -> bool {
    return (mode(state) & M_NORGN) != 0
}

fn hlt_aus(state: u64) -> bool {
    return (mode(state) & M_NOHLT) != 0
}

fn sweep_aus(state: u64) -> bool {
    return (mode(state) & M_NOSWEEP) != 0
}

fn blends(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_BLENDS)
}

fn blend_reads(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_BLENDR)
}

fn blend_skips(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_BLENDS0)
}

fn simd_px(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_SIMDPX)
}

fn blend_reset(state: u64) {
    kstate.set(state, FB_OFF + S_BLENDS, 0)
    kstate.set(state, FB_OFF + S_BLENDR, 0)
    kstate.set(state, FB_OFF + S_BLENDS0, 0)
    kstate.set(state, FB_OFF + S_SIMDPX, 0)
}

fn hline(state: u64, x: u64, y: u64, n: u64, color: u64) {
    let w: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    if y >= kstate.get(state, FB_OFF + S_HEIGHT) || x >= w {
        return
    }
    if y < band_lo(state) {
        return
    }
    var len: u64 = n
    if x + len > w {
        len = w - x
    }
    let sp_x0: u64 = x
    let sp_x1: u64 = x + len
    var p: u64 = kstate.get(state, FB_OFF + S_DRAW) +% spot(state, x, y)
    if (p & 7) != 0 && len > 0 {
        __mmio_write32(p as *mut u32, color as u32)
        p = p +% 4
        len = len - 1
    }
    let paare: u64 = len / 2
    fill_words(p, twice(color), paare)
    p = p +% paare *% 8
    len = len - paare * 2
    while len > 0 {
        __mmio_write32(p as *mut u32, color as u32)
        p = p +% 4
        len = len - 1
    }
    dirty_x(state, sp_x0, sp_x1, y, y + 1)
}

fn fill(state: u64, x: u64, y: u64, w: u64, h: u64, color: u64) {
    var row: u64 = 0
    while row < h {
        hline(state, x, y + row, w, color)
        row = row + 1
    }
}

fn line(state: u64, x0: u64, y0: u64, x1: u64, y1: u64, color: u64) {
    var dx: u64 = 0
    var sx: bool = true
    if x1 >= x0 {
        dx = x1 - x0
    } else {
        dx = x0 - x1
        sx = false
    }
    var dy: u64 = 0
    var sy: bool = true
    if y1 >= y0 {
        dy = y1 - y0
    } else {
        dy = y0 - y1
        sy = false
    }
    var n: u64 = dx
    if dy > n {
        n = dy
    }
    if n == 0 {
        pixel(state, x0, y0, color)
        return
    }
    var i: u64 = 0
    while i <= n {
        let ox: u64 = (dx * i + n / 2) / n
        let oy: u64 = (dy * i + n / 2) / n
        var x: u64 = 0
        if sx {
            x = x0 + ox
        } else {
            if ox > x0 {
                return
            }
            x = x0 - ox
        }
        var y: u64 = 0
        if sy {
            y = y0 + oy
        } else {
            if oy > y0 {
                return
            }
            y = y0 - oy
        }
        pixel(state, x, y, color)
        i = i + 1
    }
    dirty_x(state, min2(x0, x1), max2(x0, x1) + 1,
        min2(y0, y1), max2(y0, y1) + 1)
}

fn min2(a: u64, b: u64) -> u64 {
    if a < b {
        return a
    }
    return b
}

fn max2(a: u64, b: u64) -> u64 {
    if a > b {
        return a
    }
    return b
}

fn blit(state: u64, sx: u64, sy: u64, dx: u64, dy: u64, w: u64, h: u64) {
    let base: u64 = kstate.get(state, FB_OFF + S_DRAW)
    let n: u64 = w *% 4
    let worte: u64 = n / 8
    let rest: u64 = n - worte * 8
    let bl: u64 = band_lo(state)
    var r: u64 = 0
    while r < h {
        if dy + r >= bl {
            let s: u64 = base +% spot(state, sx, sy + r)
            let d: u64 = base +% spot(state, dx, dy + r)
            copy_words(d, s, worte)
            if rest != 0 {
                __mmio_write32((d +% worte *% 8) as *mut u32,
                    __mmio_read32((s +% worte *% 8) as *mut u32))
            }
        }
        r = r + 1
    }
}

fn clear(state: u64, color: u64) {
    let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    var y: u64 = 0
    while y < h {
        hline(state, 0, y, kstate.get(state, FB_OFF + S_WIDTH), color)
        y = y + 1
    }
    kstate.set(state, FB_OFF + S_CX, 0)
    kstate.set(state, FB_OFF + S_CY, 0)
    dirty_all(state)
}

fn flush_us_sum(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_FLUS)
}

fn flush_us_max(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_FLMAX)
}

fn flush_okt(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_FLOK)
}

fn flush_us_n(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_FLN)
}

fn tx_octets(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_TXOCT)
}

fn tx_rects(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_TXRECT)
}

fn frames(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_FRAMES)
}

fn tx_add(state: u64, oktette: u64) {
    kstate.add(state, FB_OFF + S_TXOCT, oktette)
    kstate.add(state, FB_OFF + S_TXRECT, 1)
}

// ================================================ RUNDE VMSVGA
// The VMware SVGA II driver (drv/gpu/vmsvga.fi) tells the host ONE update rectangle per frame. The copy sites of this file note
// the box they really wrote here. The state page and the words below mirror vmsvga.fi (S_READY, S_ACC_*); memmap.py checks
// the page. Without a ready driver this is a single compare and nothing else.
const VMS_OFF: u64 = 0x170000
const VMS_READY: u64 = 0x08
const VMS_ACC_VALID: u64 = 0x100
const VMS_ACC_X0: u64 = 0x108
const VMS_LOCK: u64 = 0x1A8 // spin lock word (vmsvga.fi S_LOCK)
const VMS_DROPN: u64 = 0x1B0 // notes seen (word vmsvgadrop swallows every 7th)

fn vms_note(state: u64, x: u64, y: u64, w: u64, h: u64) {
    if kstate.get(state, VMS_OFF + VMS_READY) == 0 || w == 0 || h == 0 {
        return
    }
    if kstate.mode_on(state, kstate.M_VMSVGADROP) {
        // gate negative control: lose every 7th note (the rectangle way must then show wrong pictures)
        kstate.add(state, VMS_OFF + VMS_DROPN, 1)
        if kstate.get(state, VMS_OFF + VMS_DROPN) % 7 == 0 {
            return
        }
    }
    let x1: u64 = x + w
    let y1: u64 = y + h
    // irq_save only excludes this core: with several cores two notes (or a note and the driver's take) could lose a box.
    let fl: u64 = arch.irq_save()
    let lk: *mut u64 = (state + VMS_OFF + VMS_LOCK) as *mut u64
    var got: u64 = __atomic_swap(lk, 0, 1)
    while got != 0 {
        arch.pause()
        got = __atomic_swap(lk, 0, 1)
    }
    if kstate.get(state, VMS_OFF + VMS_ACC_VALID) == 0 {
        kstate.set(state, VMS_OFF + VMS_ACC_X0, x)
        kstate.set(state, VMS_OFF + VMS_ACC_X0 + 8, y)
        kstate.set(state, VMS_OFF + VMS_ACC_X0 + 16, x1)
        kstate.set(state, VMS_OFF + VMS_ACC_X0 + 24, y1)
        kstate.set(state, VMS_OFF + VMS_ACC_VALID, 1)
    } else {
        if x < kstate.get(state, VMS_OFF + VMS_ACC_X0) {
            kstate.set(state, VMS_OFF + VMS_ACC_X0, x)
        }
        if y < kstate.get(state, VMS_OFF + VMS_ACC_X0 + 8) {
            kstate.set(state, VMS_OFF + VMS_ACC_X0 + 8, y)
        }
        if x1 > kstate.get(state, VMS_OFF + VMS_ACC_X0 + 16) {
            kstate.set(state, VMS_OFF + VMS_ACC_X0 + 16, x1)
        }
        if y1 > kstate.get(state, VMS_OFF + VMS_ACC_X0 + 24) {
            kstate.set(state, VMS_OFF + VMS_ACC_X0 + 24, y1)
        }
    }
    __mmio_write64(lk, 0)
    arch.irq_restore(fl)
}

fn frame_done(state: u64) {
    kstate.add(state, FB_OFF + S_FRAMES, 1)
}

fn tx_reset(state: u64) {
    kstate.set(state, FB_OFF + S_TXOCT, 0)
    kstate.set(state, FB_OFF + S_TXRECT, 0)
    kstate.set(state, FB_OFF + S_FRAMES, 0)
}

fn dirty_rect(state: u64, x: u64, y: u64, w: u64, h: u64) {
    if w == 0 || h == 0 {
        return
    }
    let x1: u64 = x + w
    let y1: u64 = y + h
    if kstate.get(state, FB_OFF + S_RVALID) == 0 {
        kstate.set(state, FB_OFF + S_RX0, x)
        kstate.set(state, FB_OFF + S_RY0, y)
        kstate.set(state, FB_OFF + S_RX1, x1)
        kstate.set(state, FB_OFF + S_RY1, y1)
        kstate.set(state, FB_OFF + S_RVALID, 1)
        return
    }
    if x < kstate.get(state, FB_OFF + S_RX0) {
        kstate.set(state, FB_OFF + S_RX0, x)
    }
    if y < kstate.get(state, FB_OFF + S_RY0) {
        kstate.set(state, FB_OFF + S_RY0, y)
    }
    if x1 > kstate.get(state, FB_OFF + S_RX1) {
        kstate.set(state, FB_OFF + S_RX1, x1)
    }
    if y1 > kstate.get(state, FB_OFF + S_RY1) {
        kstate.set(state, FB_OFF + S_RY1, y1)
    }
}

fn rect_valid(state: u64) -> bool {
    return kstate.get(state, FB_OFF + S_RVALID) != 0
}

fn rect_x0(state: u64) -> u64 { return kstate.get(state, FB_OFF + S_RX0) }
fn rect_y0(state: u64) -> u64 { return kstate.get(state, FB_OFF + S_RY0) }
fn rect_x1(state: u64) -> u64 { return kstate.get(state, FB_OFF + S_RX1) }
fn rect_y1(state: u64) -> u64 { return kstate.get(state, FB_OFF + S_RY1) }

fn rect_take(state: u64, x0: *mut u64, y0: *mut u64, x1: *mut u64,
    y1: *mut u64) -> bool {
    let fl: u64 = arch.irq_save()
    let gueltig: bool = kstate.get(state, FB_OFF + S_RVALID) != 0
    if gueltig {
        __mmio_write64(x0, kstate.get(state, FB_OFF + S_RX0))
        __mmio_write64(y0, kstate.get(state, FB_OFF + S_RY0))
        __mmio_write64(x1, kstate.get(state, FB_OFF + S_RX1))
        __mmio_write64(y1, kstate.get(state, FB_OFF + S_RY1))
        kstate.set(state, FB_OFF + S_RVALID, 0)
    }
    arch.irq_restore(fl)
    return gueltig
}

fn set_vgpu(state: u64, an: bool) {
    var v: u64 = 0
    if an {
        v = 1
    }
    kstate.set(state, FB_OFF + S_VGPU, v)
}

fn on_vgpu(state: u64) -> bool {
    return kstate.get(state, FB_OFF + S_VGPU) != 0
}

fn dirty_all(state: u64) {
    kstate.set(state, FB_OFF + S_DIRTY_LO, 0)
    kstate.set(state, FB_OFF + S_DIRTY_HI, kstate.get(state, FB_OFF + S_HEIGHT))
    dirty_rect(state, 0, 0, kstate.get(state, FB_OFF + S_WIDTH),
        kstate.get(state, FB_OFF + S_HEIGHT))
}

fn dirty_x(state: u64, x0: u64, x1: u64, y0: u64, y1: u64) {
    if y1 > y0 && x1 > x0 {
        dirty_rect(state, x0, y0, x1 - x0, y1 - y0)
    }
    dirty(state, y0, y1)
}

fn dirty(state: u64, y0: u64, y1: u64) {
    if kstate.get(state, FB_OFF + S_DIRTY_HI) == 0 {
        kstate.set(state, FB_OFF + S_DIRTY_LO, y0)
        kstate.set(state, FB_OFF + S_DIRTY_HI, y1)
        return
    }
    if y0 < kstate.get(state, FB_OFF + S_DIRTY_LO) {
        kstate.set(state, FB_OFF + S_DIRTY_LO, y0)
    }
    if y1 > kstate.get(state, FB_OFF + S_DIRTY_HI) {
        kstate.set(state, FB_OFF + S_DIRTY_HI, y1)
    }
}

fn flush_stripe(state: u64, lo: u64, hi: u64) {
    if hi > lo {
        vms_note(state, 0, lo, kstate.get(state, FB_OFF + S_WIDTH), hi - lo)
    }
    let b: u64 = kstate.get(state, FB_OFF + S_BACK)
    let basis: u64 = kstate.get(state, FB_OFF + S_SLOTV)
    if b == 0 || basis == 0 {
        return
    }
    let pt: u64 = kstate.get(state, FB_OFF + S_PITCH)
    let uc: bool = kstate.get(state, FB_OFF + S_UNCACHED) != 0
    let phys0: u64 = kstate.get(state, FB_OFF + S_PHYS)
    var off: u64 = lo *% pt
    let ende: u64 = hi *% pt
    while off < ende {
        let p: u64 = phys0 +% off
        let blk: u64 = p & (~(HUGE_SIZE - 1))
        let inner: u64 = p - blk
        var n: u64 = HUGE_SIZE - inner
        if n > ende - off {
            n = ende - off
        }
        let fl: u64 = arch.irq_save()
        if !slot_remap(state, basis, blk, uc) {
            arch.irq_restore(fl)
            return
        }
        let dst: u64 = basis +% inner
        let src: u64 = b +% off
        let worte: u64 = n / 8
        copy_words(dst, src, worte)
        var i: u64 = worte * 8
        while i + 4 <= n {
            __mmio_write32((dst +% i) as *mut u32,
                __mmio_read32((src +% i) as *mut u32))
            i = i + 4
        }
        arch.barrier_write()
        arch.irq_restore(fl)
        shadow_copy(state, off, n)
        // RUNDE VIRTIOGPU: der Streifenweg wiegt jeden Block.
        tx_add(state, n)
        off = off +% n
    }
    arch.barrier_write()
    nachspuelen(state)
}

// ================= RUNDE BLECHEINGABE: DER SCHALTER `fbflush`.
fn nachspuelen(state: u64) {
    if kstate.mode_on(state, kstate.M_FBFLUSH) {
        arch.cache_writeback()
    }
}

fn flush(state: u64) {
    let b: u64 = kstate.get(state, FB_OFF + S_BACK)
    if b == 0 {
        return
    }
    if on_vgpu(state) {
        return
    }

    if transformed(state) {
        present(state)
        return
    }
    let flr: u64 = arch.irq_save()
    var lo: u64 = kstate.get(state, FB_OFF + S_DIRTY_LO)
    var hi: u64 = kstate.get(state, FB_OFF + S_DIRTY_HI)
    kstate.set(state, FB_OFF + S_DIRTY_LO, 0)
    kstate.set(state, FB_OFF + S_DIRTY_HI, 0)
    arch.irq_restore(flr)
    if hi <= lo {
        return
    }
    let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    if hi > h {
        hi = h
    }
    if kstate.get(state, FB_OFF + S_STRIPE) != 0 {
        flush_stripe(state, lo, hi)
        kstate.add(state, FB_OFF + S_FLUSHES, 1)
        return
    }
    let pt: u64 = kstate.get(state, FB_OFF + S_PITCH)
    vms_note(state, 0, lo, kstate.get(state, FB_OFF + S_WIDTH), hi - lo)
    let von: u64 = lo *% pt
    let n: u64 = (hi - lo) *% pt
    // RUNDE VSYNC: dieselbe Weiche wie in `flush_rect`.
    let dst: u64 = draw_base(state) +% von
    let src: u64 = b +% von
    let worte: u64 = n / 8
    copy_words(dst, src, worte)
    var i: u64 = worte * 8
    while i + 4 <= n {
        __mmio_write32((dst +% i) as *mut u32,
            __mmio_read32((src +% i) as *mut u32))
        i = i + 4
    }
    shadow_copy(state, von, n)
    tx_add(state, n)
    arch.barrier_write()
    nachspuelen(state)
    kstate.add(state, FB_OFF + S_FLUSHES, 1)
}

fn write_bytes(state: u64, off: u64, src: u64, n: u64) -> u64 {
    if kstate.get(state, FB_OFF + S_READY) == 0 {
        return 0
    }
    let int: u64 = kstate.get(state, FB_OFF + S_BYTES)
    if off >= int {
        return 0
    }
    var len: u64 = n
    if off + len > int {
        len = int - off
    }
    var basis: u64 = kstate.get(state, FB_OFF + S_ADDR)
    if kstate.get(state, FB_OFF + S_STRIPE) != 0 {
        basis = kstate.get(state, FB_OFF + S_DRAW)
    } else {
        // vboxlag: this write goes to the card behind the shadow's back
        kstate.set(state, FB_OFF + S_SHVALID, 0)
    }
    let dst: u64 = basis +% off
    let worte: u64 = len / 8
    copy_words(dst, src, worte)
    var i: u64 = worte * 8
    while i < len {
        kstate.set8(dst +% i, kstate.get8(src + i) as u8)
        i = i + 1
    }
    return len
}

fn read_bytes(state: u64, off: u64, dst: u64, n: u64) -> u64 {
    if kstate.get(state, FB_OFF + S_READY) == 0 {
        return 0
    }
    let int: u64 = kstate.get(state, FB_OFF + S_BYTES)
    if off >= int {
        return 0
    }
    var len: u64 = n
    if off + len > int {
        len = int - off
    }
    var basis2: u64 = kstate.get(state, FB_OFF + S_ADDR)
    if kstate.get(state, FB_OFF + S_STRIPE) != 0 {
        basis2 = kstate.get(state, FB_OFF + S_DRAW)
    }
    let src: u64 = basis2 +% off
    var i: u64 = 0
    while i < len {
        kstate.set8(dst + i, kstate.get8(src +% i) as u8)
        i = i + 1
    }
    return len
}

// -------------------------------------------------------- die Konsole

fn cell_x(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_CX) *% (font.GLYPH_W * fscale(state))
}

fn cell_y(state: u64) -> u64 {
    let bd: u64 = kstate.get(state, FB_OFF + S_BAND)
    let zh: u64 = font.GLYPH_H * fscale(state)
    return bd +% kstate.get(state, FB_OFF + S_CY) *% zh
}

fn mark(state: u64, on: bool) {
    if kstate.get(state, FB_OFF + S_CURSOR) == 0 {
        return
    }
    var c: u64 = kstate.get(state, FB_OFF + S_BG)
    if on {
        c = kstate.get(state, FB_OFF + S_FG)
    }
    let fs: u64 = fscale(state)
    let y: u64 = cell_y(state) + font.GLYPH_H * fs - 2 * fs
    fill(state, cell_x(state), y, font.GLYPH_W * fs, 2 * fs, c)
    dirty(state, y, y + 2 * fs)
}

fn glyph(state: u64, ch: u64) {
    let px: u64 = cell_x(state)
    let py: u64 = cell_y(state)
    if py < band_lo(state) {
        return
    }
    let fg: u64 = kstate.get(state, FB_OFF + S_FG)
    let bg: u64 = kstate.get(state, FB_OFF + S_BG)
    let base: u64 = state + FONT_OFF
    let w: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    let fs: u64 = fscale(state)
    let gw: u64 = font.GLYPH_W * fs
    let gh: u64 = font.GLYPH_H * fs
    if px + gw > w || py + gh > h {
        var r2: u64 = 0
        while r2 < font.GLYPH_H {
            let b2: u64 = font.row(base, ch, r2)
            var c2: u64 = 0
            while c2 < font.GLYPH_W {
                var f2: u64 = bg
                if ((b2 >> (7 - c2)) & 1) != 0 {
                    f2 = fg
                }
                var sy: u64 = 0
                while sy < fs {
                    var sx: u64 = 0
                    while sx < fs {
                        pixel(state, px + c2 * fs + sx, py + r2 * fs + sy, f2)
                        sx = sx + 1
                    }
                    sy = sy + 1
                }
                c2 = c2 + 1
            }
            r2 = r2 + 1
        }
        dirty(state, py, py + gh)
        return
    }
    let pt: u64 = kstate.get(state, FB_OFF + S_PITCH)
    var cur_row: u64 = kstate.get(state, FB_OFF + S_DRAW) +% py *% pt +% px *% 4
    var r: u64 = 0
    while r < font.GLYPH_H {
        let bits: u64 = font.row(base, ch, r)
        var wdh: u64 = 0
        while wdh < fs {
            var q: u64 = cur_row
            var c: u64 = 0
            while c < font.GLYPH_W {
                var color: u64 = bg
                if ((bits >> (7 - c)) & 1) != 0 {
                    color = fg
                }
                var k: u64 = 0
                while k < fs {
                    __mmio_write32(q as *mut u32, color as u32)
                    q = q +% 4
                    k = k + 1
                }
                c = c + 1
            }
            cur_row = cur_row +% pt
            wdh = wdh + 1
        }
        r = r + 1
    }
    dirty(state, py, py + gh)
}

fn scroll(state: u64) {
    let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    let w: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    let zh: u64 = font.GLYPH_H * fscale(state)
    if h <= zh {
        clear(state, kstate.get(state, FB_OFF + S_BG))
        return
    }
    let bd: u64 = kstate.get(state, FB_OFF + S_BAND)
    let rest: u64 = kstate.get(state, FB_OFF + S_ROWS) *% zh - zh
    if bd + rest + zh > h {
        clear(state, kstate.get(state, FB_OFF + S_BG))
        return
    }
    blit(state, 0, bd + zh, 0, bd, w, rest)
    fill(state, 0, bd + rest, w, h - bd - rest,
        kstate.get(state, FB_OFF + S_BG))
    dirty_all(state)
    kstate.add(state, FB_OFF + S_SCROLLS, 1)
}

fn nl(state: u64) {
    kstate.set(state, FB_OFF + S_CX, 0)
    let y: u64 = kstate.get(state, FB_OFF + S_CY) + 1
    if y >= kstate.get(state, FB_OFF + S_ROWS) {
        scroll(state)
        kstate.set(state, FB_OFF + S_CY, kstate.get(state, FB_OFF + S_ROWS) - 1)
    } else {
        kstate.set(state, FB_OFF + S_CY, y)
    }
}

fn advance(state: u64) {
    let x: u64 = kstate.get(state, FB_OFF + S_CX) + 1
    if x >= kstate.get(state, FB_OFF + S_COLS) {
        nl(state)
    } else {
        kstate.set(state, FB_OFF + S_CX, x)
    }
}

fn putc(state: u64, c: u64) {
    if kstate.get(state, FB_OFF + S_READY) == 0 {
        return
    }
    mark(state, false)
    if c == 10 {
        nl(state)
        mark(state, true)
        flush(state)
        return
    }
    if c == 13 {
        kstate.set(state, FB_OFF + S_CX, 0)
        mark(state, true)
        return
    }
    if c == 8 {
        let x: u64 = kstate.get(state, FB_OFF + S_CX)
        if x > 0 {
            kstate.set(state, FB_OFF + S_CX, x - 1)
            glyph(state, 32)
        }
        mark(state, true)
        return
    }
    if c == 9 {
        let x: u64 = kstate.get(state, FB_OFF + S_CX)
        var n: u64 = 8 - (x & 7)
        while n > 0 {
            glyph(state, 32)
            advance(state)
            n = n - 1
        }
        mark(state, true)
        return
    }
    glyph(state, c)
    advance(state)
    kstate.add(state, FB_OFF + S_CHARS, 1)
    mark(state, true)
}

fn puts(state: u64, p: u64) {
    var i: u64 = 0
    while true {
        let c: u64 = kstate.get8(p + i)
        if c == 0 {
            return
        }
        putc(state, c)
        i = i + 1
    }
}

fn text(state: u64, p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        putc(state, kstate.get8(p + i))
        i = i + 1
    }
}

fn home(state: u64) {
    kstate.set(state, FB_OFF + S_CX, 0)
    kstate.set(state, FB_OFF + S_CY, 0)
}

fn goto(state: u64, c: u64, r: u64) {
    var x: u64 = c
    var y: u64 = r
    if x >= kstate.get(state, FB_OFF + S_COLS) {
        x = kstate.get(state, FB_OFF + S_COLS) - 1
    }
    if y >= kstate.get(state, FB_OFF + S_ROWS) {
        y = kstate.get(state, FB_OFF + S_ROWS) - 1
    }
    kstate.set(state, FB_OFF + S_CX, x)
    kstate.set(state, FB_OFF + S_CY, y)
}

// ------------------------------------------------------- der Spiegel

fn kdata() -> u64 {
    return asm("lea rax, [rip + kdata]", out("rax"))
}

fn echo(c: u8) {
    let state: u64 = kdata()
    if kstate.get(state, FB_OFF + S_ECHO) == 0 {
        return
    }
    putc(state, c as u64)
}

// ----------------------------------------------------- die Kommandozeile

fn find(heu: u64, nadel: u64, n: u64) -> u64 {
    if heu == 0 || n == 0 {
        return 0
    }
    var i: u64 = 0
    while true {
        let c: u64 = kstate.get8(heu + i)
        if c == 0 {
            return 0
        }
        var k: u64 = 0
        var same: bool = true
        while k < n {
            let a: u64 = kstate.get8(heu + i + k)
            if a == 0 || a != kstate.get8(nadel + k) {
                same = false
                k = n
            } else {
                k = k + 1
            }
        }
        if same {
            return heu + i
        }
        i = i + 1
    }
    return 0
}

fn parse(state: u64, cmd: u64) {
    var w_gfx: [u8; 4] = "gfx\0"
    var w_nodbl: [u8; 6] = "nodbl\0"
    var w_uc: [u8; 5] = "fbuc\0"
    var w_big: [u8; 6] = "fbbig\0"
    var w_nocur: [u8; 9] = "nocursor\0"
    var w_hold: [u8; 7] = "fbhold\0"
    var w_pat: [u8; 7] = "fbtest\0"
    var w_usr: [u8; 7] = "fbuser\0"
    var w_res: [u8; 7] = "fbres=\0"
    var w_pad: [u8; 7] = "fbpad=\0"
    var w_wb: [u8; 5] = "fbwb\0"
    var w_nosimd: [u8; 9] = "fbnosimd\0"
    var w_str: [u8; 12] = "fbstreifen\0\0"
    var w_ngg: [u8; 12] = "noglasgrow\0\0"
    var w_nsw: [u8; 12] = "nowinsweep\0\0"
    var w_nhl: [u8; 12] = "nohltidle\0\0\0"
    var w_nwf: [u8; 10] = "nowinfix\0\0"
    var w_nzr: [u8; 9] = "nozreap\0\0"
    var w_nrg: [u8; 6] = "norgn\0"
    var w_nph: [u8; 7] = "phases\0"
    var w_ndf: [u8; 7] = "nodiff\0"
    var w_nhs: [u8; 10] = "nohidskip\0"
    var w_nst: [u8; 8] = "nostrip\0"
    var w_nsh: [u8; 8] = "noshare\0"
    var w_ncp: [u8; 7] = "nocomp\0"
    var w_nwa: [u8; 8] = "nowatch\0"
    var w_ncs: [u8; 10] = "nocascade\0"
    var w_ndb: [u8; 10] = "nodragbar\0"
    var w_fur: [u8; 9] = "fullrows\0"
    var w_nbm: [u8; 7] = "nobeam\0"
    var w_kpm: [u8; 10] = "keepmarks\0"
    var w_nsp: [u8; 9] = "noshapes␀"
    var w_tdp: [u8; 9] = "termdump\0"
    var w_nsn: [u8; 7] = "nosnap\0"
    var w_nmt: [u8; 9] = "fbnomtrr\0"
    var w_msm: [u8; 10] = "fbmtrrsim\0"
    var w_mst: [u8; 13] = "fbmtrrstrict\0"
    var m: u64 = 0
    if cmd != 0 {
        pad_set(num_after(state, cmd, (&w_pad[0]) as u64, 6))
        var w_virt: [u8; 8] = "fbvirt=\0"
        var w_rgbo: [u8; 6] = "fbrgb\0"
        virt_set(num_after(state, cmd, (&w_virt[0]) as u64, 7))
        if find(cmd, (&w_rgbo[0]) as u64, 5) != 0 {
            rgb_set(1)
        }
        var w_canon: [u8; 8] = "fbcanon\0"
        var w_noswz: [u8; 8] = "fbnoswz\0"
        var w_nopit: [u8; 10] = "fbnopitch\0"
        if find(cmd, (&w_canon[0]) as u64, 7) != 0 {
            canon_want = 1
        }
        if find(cmd, (&w_noswz[0]) as u64, 7) != 0 {
            noswz_want = 1
        }
        if find(cmd, (&w_nopit[0]) as u64, 9) != 0 {
            nopitch_want = 1
        }
        if find(cmd, (&w_gfx[0]) as u64, 3) != 0 {
            m = m | M_GFX
        }
        if find(cmd, (&w_nodbl[0]) as u64, 5) != 0 {
            m = m | M_NODBL
        }
        if find(cmd, (&w_uc[0]) as u64, 4) != 0 {
            m = m | M_UC
        }
        if find(cmd, (&w_wb[0]) as u64, 4) != 0 {
            m = m | M_WB
        }
        if find(cmd, (&w_str[0]) as u64, 10) != 0 {
            m = m | M_STRIPE
        }
        if find(cmd, (&w_ngg[0]) as u64, 10) != 0 {
            m = m | M_NOGLAS
        }
        if find(cmd, (&w_nsw[0]) as u64, 10) != 0 {
            m = m | M_NOSWEEP
        }
        if find(cmd, (&w_nhl[0]) as u64, 9) != 0 {
            m = m | M_NOHLT
        }
        if find(cmd, (&w_nwf[0]) as u64, 8) != 0 {
            m = m | M_NOWINFIX
        }
        if find(cmd, (&w_nzr[0]) as u64, 7) != 0 {
            m = m | M_NOZREAP
        }
        if find(cmd, (&w_nrg[0]) as u64, 5) != 0 {
            m = m | M_NORGN
        }
        if find(cmd, (&w_nph[0]) as u64, 6) != 0 {
            m = m | M_PHASES
        }
        if find(cmd, (&w_ndf[0]) as u64, 6) != 0 {
            m = m | M_NODIFF
        }
        if find(cmd, (&w_nhs[0]) as u64, 9) != 0 {
            m = m | M_NOHIDSKIP
        }
        if find(cmd, (&w_nst[0]) as u64, 7) != 0 {
            m = m | M_NOSTRIP
        }
        if find(cmd, (&w_nsh[0]) as u64, 7) != 0 {
            m = m | M_NOSHARE
        }
        if find(cmd, (&w_ncp[0]) as u64, 6) != 0 {
            m = m | M_NOCOMP
        }
        if find(cmd, (&w_ncs[0]) as u64, 9) != 0 {
            m = m | M_NOCASCADE
        }
        if find(cmd, (&w_ndb[0]) as u64, 9) != 0 {
            m = m | M_NODRAGBAR
        }
        if find(cmd, (&w_fur[0]) as u64, 8) != 0 {
            m = m | M_FULLROWS
        }
        if find(cmd, (&w_nbm[0]) as u64, 6) != 0 {
            m = m | M_NOBEAM
        }
        if find(cmd, (&w_kpm[0]) as u64, 9) != 0 {
            m = m | M_KEEPMARKS
        }
        if find(cmd, (&w_nsp[0]) as u64, 8) != 0 {
            m = m | M_NOSHAPES
        }
        if find(cmd, (&w_nwa[0]) as u64, 7) != 0 {
            m = m | M_NOWATCH
        }
        if find(cmd, (&w_tdp[0]) as u64, 8) != 0 {
            m = m | M_TERMDUMP
        }
        if find(cmd, (&w_nsn[0]) as u64, 6) != 0 {
            m = m | M_NOSNAP
        }
        if find(cmd, (&w_nmt[0]) as u64, 8) != 0 {
            m = m | M_NOMTRR
        }
        if find(cmd, (&w_msm[0]) as u64, 9) != 0 {
            m = m | M_MTRRSIM
        }
        if find(cmd, (&w_mst[0]) as u64, 12) != 0 {
            m = m | M_MTRRSTRICT
        }
        if find(cmd, (&w_nosimd[0]) as u64, 8) != 0 {
            m = m | M_NOSIMD
        }
        if find(cmd, (&w_big[0]) as u64, 5) != 0 {
            m = m | M_BIG
        }
        if find(cmd, (&w_nocur[0]) as u64, 8) != 0 {
            m = m | M_NOCUR
        }
        if find(cmd, (&w_hold[0]) as u64, 6) != 0 {
            m = m | M_HOLD
        }
        if find(cmd, (&w_pat[0]) as u64, 6) != 0 {
            m = m | M_PATTERN
        }
        if find(cmd, (&w_usr[0]) as u64, 6) != 0 {
            m = m | M_USER
        }
        var w_flip: [u8; 5] = "flip\0"
        var w_nofl: [u8; 7] = "noflip\0"
        if find(cmd, (&w_flip[0]) as u64, 4) != 0 {
            m = m | M_FLIP
        }
        if find(cmd, (&w_nofl[0]) as u64, 6) != 0 {
            m = m | M_NOFLIP
        }
    }
    if find(cmd, (&w_res[0]) as u64, 6) != 0 {
        if parse_zahlenpaar(state, cmd, (&w_res[0]) as u64, 6) {
            m = m | M_RES
        }
    }
    if cmd != 0 {
        var w_ui: [u8; 9] = "uiscale=\0"
        let a: u64 = find(cmd, (&w_ui[0]) as u64, 8)
        if a != 0 {
            let v: u64 = num_at(a + 8)
            if v >= 1 && v <= 4 {
                kstate.set(state, FB_OFF + S_UIWANT, v)
            }
        }
    }
    kstate.set(state, FB_OFF + S_MODE, m)
}

fn num_at(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    var lauf: bool = true
    while lauf {
        let c: u64 = kstate.get8(p + i)
        if c >= 0x30 && c <= 0x39 && i < 6 {
            v = v * 10 + (c - 0x30)
            i = i + 1
        } else {
            lauf = false
        }
    }
    if i == 0 {
        return 0
    }
    return v
}

fn ziffern_ab(p: u64) -> u64 {
    var i: u64 = 0
    var lauf: bool = true
    while lauf {
        let c: u64 = kstate.get8(p + i)
        if c >= 0x30 && c <= 0x39 && i < 6 {
            i = i + 1
        } else {
            lauf = false
        }
    }
    return i
}

fn parse_zahlenpaar(state: u64, cmd: u64, word: u64, wlen: u64) -> bool {
    kstate.set(state, FB_OFF + S_RESW, 0)
    kstate.set(state, FB_OFF + S_RESH, 0)
    let a: u64 = find(cmd, word, wlen)
    if a == 0 {
        return false
    }
    let p1: u64 = a + wlen
    let n1: u64 = ziffern_ab(p1)
    if n1 == 0 {
        return false
    }
    if kstate.get8(p1 + n1) != 0x78 {
        return false
    }
    let p2: u64 = p1 + n1 + 1
    let n2: u64 = ziffern_ab(p2)
    if n2 == 0 {
        return false
    }
    let w: u64 = num_at(p1)
    let h: u64 = num_at(p2)
    if w < 320 || h < 200 || w > 8192 || h > 4608 {
        return false
    }
    kstate.set(state, FB_OFF + S_RESW, w)
    kstate.set(state, FB_OFF + S_RESH, h)
    return true
}

//     fb: 3440x1440x32  pitch=13760      (13760 = 3440 * 4)
fn num_after(state: u64, cmd: u64, word: u64, wlen: u64) -> u64 {
    if cmd == 0 {
        return 0
    }
    let a: u64 = find(cmd, word, wlen)
    if a == 0 {
        return 0
    }
    let p1: u64 = a + wlen
    if ziffern_ab(p1) == 0 {
        return 0
    }
    return num_at(p1)
}

fn mode(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_MODE)
}

fn want(state: u64, bit: u64) -> bool {
    return (kstate.get(state, FB_OFF + S_MODE) & bit) != 0
}

fn set_backbuf(state: u64, b: u64, n: u64) {
    // vboxlag: a new back buffer of another size: the shadow no longer fits (a mode change leaves the diff off)
    if kstate.get(state, FB_OFF + S_SHBYTES) < n {
        kstate.set(state, FB_OFF + S_SHADOW, 0)
    }
    kstate.set(state, FB_OFF + S_SHVALID, 0)
    kstate.set(state, FB_OFF + S_BACK, b)
    kstate.set(state, FB_OFF + S_BACKBYTES, n)
    relayout(state)
}

fn back_bytes(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_BACKBYTES)
}

fn set_back(state: u64, b: u64) {
    kstate.set(state, FB_OFF + S_SHVALID, 0)
    if b == 0 && kstate.get(state, FB_OFF + S_STRIPE) != 0 {
        return
    }
    kstate.set(state, FB_OFF + S_BACK, b)
    if b != 0 {
        kstate.set(state, FB_OFF + S_DRAW, b)
    } else {
        kstate.set(state, FB_OFF + S_DRAW, kstate.get(state, FB_OFF + S_ADDR))
    }
    dirty_all(state)
}

// ---------------------------------------------------------- die Zusagen

fn failbits(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_FAIL)
}
fn pass_ok(state: u64, nr: u64) {
    kstate.set(state, FB_OFF + S_FAIL,
        kstate.get(state, FB_OFF + S_FAIL) & ~(1 << nr))
}
fn selftest(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    var n: u64 = 0
    kstate.set(state, FB_OFF + S_FAIL, 0x3ffe)
    let rot: u64 = rgb(state, 0xFF, 0, 0)
    let gruen: u64 = rgb(state, 0, 0xFF, 0)
    let blau: u64 = rgb(state, 0, 0, 0xFF)

    if rot != gruen && gruen != blau && rot != blau {
        n = n + 1
        pass_ok(state, 1)
    }
    // 2. Geschriebener Bildpunkt = gelesener Bildpunkt.
    pixel(state, 0, 0, rot)
    pixel(state, 1, 0, gruen)
    pixel(state, 0, 1, blau)
    if get_pixel(state, 0, 0) == rot && get_pixel(state, 1, 0) == gruen {
        if get_pixel(state, 0, 1) == blau {
            n = n + 1
            pass_ok(state, 2)
        }
    }
    let w: u64 = width(state)
    let h: u64 = height(state)
    pixel(state, w - 1, h - 1, gruen)
    if get_pixel(state, w - 1, h - 1) == gruen {
        n = n + 1
        pass_ok(state, 3)
    }
    pixel(state, w, h, rot)
    if get_pixel(state, w, h) == 0 && get_pixel(state, w, 0) == 0 {
        n = n + 1
        pass_ok(state, 4)
    }
    clear(state, 0)
    fill(state, 10, 10, 20, 20, blau)
    if get_pixel(state, 10, 10) == blau && get_pixel(state, 29, 29) == blau {
        if get_pixel(state, 9, 10) == 0 && get_pixel(state, 30, 29) == 0 {
            n = n + 1
            pass_ok(state, 5)
        }
    }
    line(state, 40, 40, 140, 90, rot)
    if get_pixel(state, 40, 40) == rot && get_pixel(state, 140, 90) == rot {
        n = n + 1
        pass_ok(state, 6)
    }
    blit(state, 10, 10, 200, 100, 20, 20)
    if get_pixel(state, 200, 100) == blau && get_pixel(state, 219, 119) == blau {
        n = n + 1
        pass_ok(state, 7)
    }
    if font.row(state + FONT_OFF, 0x41, 3) == 0x18 {
        n = n + 1
        pass_ok(state, 8)
    }
    clear(state, 0)
    home(state)
    set_color(state, rot, 0)
    set_cursor(state, false)
    putc(state, 0x41) // 'A'
    let fs: u64 = fscale(state)
    if get_pixel(state, 3 * fs, 3 * fs) == rot
        && get_pixel(state, 4 * fs, 3 * fs) == rot {
        if get_pixel(state, 0, 3 * fs) == 0
            && get_pixel(state, 7 * fs + fs - 1, 3 * fs) == 0 {
            n = n + 1
            pass_ok(state, 9)
        }
    }
    if cx(state) == 1 && cy(state) == 0 {
        n = n + 1
        pass_ok(state, 10)
    }
    putc(state, 10)
    if cx(state) == 0 && cy(state) == 1 {
        n = n + 1
        pass_ok(state, 11)
    }
    clear(state, 0)
    home(state)
    fill(state, 0, font.GLYPH_H * fscale(state), 8, 8, gruen)
    scroll(state)
    if get_pixel(state, 0, 0) == gruen && get_pixel(state, 7, 7) == gruen {
        n = n + 1
        pass_ok(state, 12)
    }
    if get_pixel(state, 0,
        rows(state) * font.GLYPH_H * fscale(state) - 1) == 0 {
        n = n + 1
        pass_ok(state, 13)
    }
    clear(state, 0)
    home(state)
    set_color(state, rgb(state, 0xC8, 0xD0, 0xD8), 0)
    return n
}

fn selftest_max() -> u64 {
    return 13
}

// ==================================================== RUNDE DISPLAY

fn win_slots() -> u64 {
    return WIN_SLOTS
}

fn huge_size() -> u64 {
    return HUGE_SIZE
}

fn slot0(state: u64) -> u64 {
    let v: u64 = kstate.get(state, FB_OFF + S_SLOT0)
    if v == 0 {
        return WIN_SLOTS
    }
    return v - 1
}

fn free_slots(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < WIN_SLOTS {
        if slot_used(state, i) == 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn map_span(p: u64, n: u64) -> u64 {
    let blk: u64 = p & (~(HUGE_SIZE - 1))
    let inner: u64 = p - blk
    return (inner + n + HUGE_SIZE - 1) / HUGE_SIZE
}

fn unmap(state: u64) {
    let s0: u64 = kstate.get(state, FB_OFF + S_SLOT0)
    if s0 == 0 {
        return
    }
    let first: u64 = s0 - 1
    let n: u64 = kstate.get(state, FB_OFF + S_HUGES)
    let pd: u64 = kernel_pd(state)
    if pd == 0 {
        return
    }
    var j: u64 = 0
    while j < n {
        if first + j < WIN_SLOTS {
            __mmio_write64((pd + (WIN_FIRST + first + j) * 8) as *mut u64, 0)
            kstate.set(state, WIN_LIST + (first + j) * 8, 0)
        }
        j = j + 1
    }
    let c: u64 = asm("mov rax, cr3", out("rax"))
    asm("mov cr3, rax", in("rax") c)
    kstate.set(state, FB_OFF + S_SLOT0, 0)
    kstate.set(state, FB_OFF + S_ADDR, 0)
}

fn remap(state: u64, p: u64, w: u64, h: u64, pt: u64, uncached: bool) -> bool {
    if w == 0 || h == 0 || p == 0 {
        return false
    }
    if pt < w * 4 {
        return false
    }
    let n: u64 = pt * h
    let blk: u64 = p & (~(HUGE_SIZE - 1))
    let inner: u64 = p - blk
    let kacheln: u64 = (inner + n + HUGE_SIZE - 1) / HUGE_SIZE
    if kacheln > WIN_SLOTS {
        return false
    }
    unmap(state)
    let window: u64 = map_run(state, blk, kacheln, uncached)
    if window == 0 {
        return false
    }
    kstate.set(state, FB_OFF + S_PHYS, p)
    kstate.set(state, FB_OFF + S_ADDR, window + inner)
    kstate.set(state, FB_OFF + S_BLOCK, blk)
    kstate.set(state, FB_OFF + S_OFFSET, inner)
    kstate.set(state, FB_OFF + S_HUGES, kacheln)
    kstate.set(state, FB_OFF + S_SLOT0, (window - WIN_VIRT) / HUGE_SIZE + 1)
    kstate.set(state, FB_OFF + S_PWIDTH, w)
    kstate.set(state, FB_OFF + S_PHEIGHT, h)
    kstate.set(state, FB_OFF + S_PPITCH, pt)
    kstate.set(state, FB_OFF + S_BYTES, n)
    kstate.set(state, FB_OFF + S_UNCACHED, bool_num(uncached))
    relayout(state)
    return true
}

fn slot_remap(state: u64, virt: u64, block: u64, uncached: bool) -> bool {
    if virt < WIN_VIRT {
        return false
    }
    let i: u64 = (virt - WIN_VIRT) / HUGE_SIZE
    if i >= WIN_SLOTS {
        return false
    }
    let pd: u64 = kernel_pd(state)
    if pd == 0 {
        return false
    }
    let bits: u64 = fb_bits(state, uncached)
    // W-PRESENT: ALREADY POINTING THERE -- NOTHING TO DO. The rectangle copy remaps once per ROW; without this every row paid a page
    // table write, a full TLB flush (CR3) and a write-combining drain, 600 times for a window. The entry is read back (not a list kept
    // on the side), so an interrupt that moved the slot in between is seen. The accessed/dirty bits (0x20, 0x40) are set by the machine.
    let cur: u64 = __mmio_read64((pd + (WIN_FIRST + i) * 8) as *mut u64)
    if (cur & (~(0x60 as u64))) == ((block | bits) & (~(0x60 as u64))) {
        return true
    }
    arch.barrier_write()
    __mmio_write64((pd + (WIN_FIRST + i) * 8) as *mut u64, block | bits)
    kstate.set(state, WIN_LIST + i * 8, block + 1)
    let c: u64 = asm("mov rax, cr3", out("rax"))
    asm("mov cr3, rax", in("rax") c)
    return true
}

fn unmap_slot(state: u64, virt: u64) {
    if virt < WIN_VIRT {
        return
    }
    let i: u64 = (virt - WIN_VIRT) / HUGE_SIZE
    if i >= WIN_SLOTS {
        return
    }
    let pd: u64 = kernel_pd(state)
    if pd == 0 {
        return
    }
    arch.barrier_write()
    __mmio_write64((pd + (WIN_FIRST + i) * 8) as *mut u64, 0)
    kstate.set(state, WIN_LIST + i * 8, 0)
    let c: u64 = asm("mov rax, cr3", out("rax"))
    asm("mov cr3, rax", in("rax") c)
}

fn longest_run(state: u64) -> u64 {
    let s0: u64 = kstate.get(state, FB_OFF + S_SLOT0)
    var first: u64 = WIN_SLOTS
    var n_fb: u64 = 0
    if s0 != 0 {
        first = s0 - 1
        n_fb = kstate.get(state, FB_OFF + S_HUGES)
    }
    var best: u64 = 0
    var lauf: u64 = 0
    var i: u64 = 0
    while i < WIN_SLOTS {
        var free: bool = slot_used(state, i) == 0
        if i >= first && i < first + n_fb {
            free = true
        }
        if free {
            lauf = lauf + 1
            if lauf > best {
                best = lauf
            }
        } else {
            lauf = 0
        }
        i = i + 1
    }
    return best
}

fn panel_w(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_PWIDTH)
}

fn panel_h(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_PHEIGHT)
}

fn panel_pitch(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_PPITCH)
}

fn rotation(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_ROT)
}

fn scale(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_SCALE)
}

fn lut(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_LUT)
}

fn saturation(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_SAT)
}

fn presents(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_PRESENTS)
}

fn swizzled(state: u64) -> bool {
    if kstate.get(state, FB_OFF + S_PRS) != kstate.get(state, FB_OFF + S_RSHIFT) {
        return true
    }
    if kstate.get(state, FB_OFF + S_PGS) != kstate.get(state, FB_OFF + S_GSHIFT) {
        return true
    }
    return kstate.get(state, FB_OFF + S_PBS) != kstate.get(state, FB_OFF + S_BSHIFT)
}

fn panel_order(state: u64) -> u64 {
    let r: u64 = kstate.get(state, FB_OFF + S_PRS)
    let g: u64 = kstate.get(state, FB_OFF + S_PGS)
    let b: u64 = kstate.get(state, FB_OFF + S_PBS)
    if r == 16 && g == 8 && b == 0 {
        return 1
    }
    if r == 0 && g == 8 && b == 16 {
        return 2
    }
    return 3
}

fn transformed(state: u64) -> bool {
    if kstate.get(state, FB_OFF + S_ROT) != 0 {
        return true
    }
    if swizzled(state) {
        return true
    }
    if kstate.get(state, FB_OFF + S_LUT) != 0 {
        return true
    }
    if kstate.get(state, FB_OFF + S_SAT) != 100 {
        return true
    }
    if kstate.get(state, FB_OFF + S_WIDTH)
        != kstate.get(state, FB_OFF + S_PWIDTH) {
        return true
    }
    return kstate.get(state, FB_OFF + S_HEIGHT)
        != kstate.get(state, FB_OFF + S_PHEIGHT)
}

fn relayout(state: u64) {
    kstate.set(state, FB_OFF + S_SHVALID, 0)
    let pw: u64 = kstate.get(state, FB_OFF + S_PWIDTH)
    let ph: u64 = kstate.get(state, FB_OFF + S_PHEIGHT)
    let rot: u64 = kstate.get(state, FB_OFF + S_ROT)
    var lw: u64 = kstate.get(state, FB_OFF + S_LOGW)
    var lh: u64 = kstate.get(state, FB_OFF + S_LOGH)
    if lw == 0 || lh == 0 {
        lw = pw
        lh = ph
        if rot == 90 || rot == 270 {
            lw = ph
            lh = pw
        }
    }
    kstate.set(state, FB_OFF + S_WIDTH, lw)
    kstate.set(state, FB_OFF + S_HEIGHT, lh)
    let back: u64 = kstate.get(state, FB_OFF + S_BACK)
    if transformed(state) {
        kstate.set(state, FB_OFF + S_PITCH, lw * 4)
        kstate.set(state, FB_OFF + S_DRAW, back)
    } else {
        kstate.set(state, FB_OFF + S_PITCH,
            kstate.get(state, FB_OFF + S_PPITCH))
        if back != 0 {
            kstate.set(state, FB_OFF + S_DRAW, back)
        } else {
            kstate.set(state, FB_OFF + S_DRAW,
                kstate.get(state, FB_OFF + S_ADDR))
        }
    }
    let fs: u64 = fscale(state)
    kstate.set(state, FB_OFF + S_COLS, lw / (font.GLYPH_W * fs))
    kstate.set(state, FB_OFF + S_ROWS, lh / (font.GLYPH_H * fs))
    if kstate.get(state, FB_OFF + S_CX) >= lw / (font.GLYPH_W * fs) {
        kstate.set(state, FB_OFF + S_CX, 0)
    }
    if kstate.get(state, FB_OFF + S_CY) >= lh / (font.GLYPH_H * fs) {
        kstate.set(state, FB_OFF + S_CY, 0)
    }
    dirty_all(state)
}

fn logical_ok(state: u64, lw: u64, lh: u64) -> bool {
    let back: u64 = kstate.get(state, FB_OFF + S_BACK)
    if back == 0 {
        return false
    }
    if lw == 0 || lh == 0 {
        return false
    }
    if lw > 16384 || lh > 16384 {
        return false
    }
    return lw * 4 * lh <= kstate.get(state, FB_OFF + S_BACKBYTES)
}

fn dims_at_rotation(state: u64, rot: u64) -> u64 {
    var lw: u64 = kstate.get(state, FB_OFF + S_LOGW)
    var lh: u64 = kstate.get(state, FB_OFF + S_LOGH)
    if lw == 0 || lh == 0 {
        lw = kstate.get(state, FB_OFF + S_PWIDTH)
        lh = kstate.get(state, FB_OFF + S_PHEIGHT)
        if rot == 90 || rot == 270 {
            lw = kstate.get(state, FB_OFF + S_PHEIGHT)
            lh = kstate.get(state, FB_OFF + S_PWIDTH)
        }
    }
    return (lw << 32) | lh
}

fn set_rotation(state: u64, rot: u64) -> bool {
    if rot != 0 && rot != 90 && rot != 180 && rot != 270 {
        return false
    }
    if rot != 0 {
        let m: u64 = dims_at_rotation(state, rot)
        if !logical_ok(state, m >> 32, m & 0xFFFFFFFF) {
            return false
        }
    }
    kstate.set(state, FB_OFF + S_ROT, rot)
    relayout(state)
    return true
}

// ------------------------------------------------------------------
// INPUT FOLLOWS THE OUTPUT (rotation 0/90/180/270 + scale mode).
// `present` maps a logical pixel (lx, ly) to a panel pixel; a tablet or
// touch screen reports PANEL positions, and the hardware cursor is
// placed in PANEL pixels. These two functions are the same maths as
// `present`, forwards and backwards, so a click lands on the button
// that is drawn. Results are packed: x << 32 | y.
// ------------------------------------------------------------------

// Size of the rotated image on the panel (dw << 32 | dh) -- the same
// rules as the head of `present`.
fn fit_dims(state: u64) -> u64 {
    let pw: u64 = kstate.get(state, FB_OFF + S_PWIDTH)
    let ph: u64 = kstate.get(state, FB_OFF + S_PHEIGHT)
    let lw: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    let lh: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    let rot: u64 = kstate.get(state, FB_OFF + S_ROT)
    var rw: u64 = lw
    var rh: u64 = lh
    if rot == 90 || rot == 270 {
        rw = lh
        rh = lw
    }
    let art: u64 = kstate.get(state, FB_OFF + S_SCALE)
    var dw: u64 = pw
    var dh: u64 = ph
    if art == SCALE_NONE {
        dw = min2(rw, pw)
        dh = min2(rh, ph)
    } else if art == SCALE_ASPECT && rw != 0 && rh != 0 {
        if rw * ph <= pw * rh {
            dh = ph
            dw = rw * ph / rh
        } else {
            dw = pw
            dh = rh * pw / rw
        }
        if dw == 0 {
            dw = 1
        }
        if dh == 0 {
            dh = 1
        }
        if dw > pw {
            dw = pw
        }
        if dh > ph {
            dh = ph
        }
    }
    return (dw << 32) | dh
}

// A panel pixel -> the logical pixel drawn there.
fn panel_to_logical(state: u64, px: u64, py: u64) -> u64 {
    let pw: u64 = kstate.get(state, FB_OFF + S_PWIDTH)
    let ph: u64 = kstate.get(state, FB_OFF + S_PHEIGHT)
    let lw: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    let lh: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    let rot: u64 = kstate.get(state, FB_OFF + S_ROT)
    let fd: u64 = fit_dims(state)
    let dw: u64 = fd >> 32
    let dh: u64 = fd & 0xFFFFFFFF
    if pw == 0 || ph == 0 || lw == 0 || lh == 0 || dw == 0 || dh == 0 {
        return (px << 32) | py
    }
    var rw: u64 = lw
    var rh: u64 = lh
    if rot == 90 || rot == 270 {
        rw = lh
        rh = lw
    }
    let dx0: u64 = (pw - dw) / 2
    let dy0: u64 = (ph - dh) / 2
    var ix: u64 = 0
    if px > dx0 {
        ix = px - dx0
    }
    var iy: u64 = 0
    if py > dy0 {
        iy = py - dy0
    }
    if ix >= dw {
        ix = dw - 1
    }
    if iy >= dh {
        iy = dh - 1
    }
    var ux: u64 = (ix * ((rw << 16) / dw)) >> 16
    var uy: u64 = (iy * ((rh << 16) / dh)) >> 16
    if ux >= rw {
        ux = rw - 1
    }
    if uy >= rh {
        uy = rh - 1
    }
    var lx: u64 = ux
    var ly: u64 = uy
    if rot == 180 {
        lx = lw - 1 - ux
        ly = lh - 1 - uy
    } else if rot == 90 {
        lx = uy
        ly = lh - 1 - ux
    } else if rot == 270 {
        lx = lw - 1 - uy
        ly = ux
    }
    return (lx << 32) | ly
}

// A logical pixel -> the panel pixel it is drawn on (centre of the cell).
fn logical_to_panel(state: u64, lx0: u64, ly0: u64) -> u64 {
    let pw: u64 = kstate.get(state, FB_OFF + S_PWIDTH)
    let ph: u64 = kstate.get(state, FB_OFF + S_PHEIGHT)
    let lw: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    let lh: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    let rot: u64 = kstate.get(state, FB_OFF + S_ROT)
    let fd: u64 = fit_dims(state)
    let dw: u64 = fd >> 32
    let dh: u64 = fd & 0xFFFFFFFF
    if pw == 0 || ph == 0 || lw == 0 || lh == 0 || dw == 0 || dh == 0 {
        return (lx0 << 32) | ly0
    }
    var lx: u64 = lx0
    var ly: u64 = ly0
    if lx >= lw {
        lx = lw - 1
    }
    if ly >= lh {
        ly = lh - 1
    }
    var rw: u64 = lw
    var rh: u64 = lh
    var ux: u64 = lx
    var uy: u64 = ly
    if rot == 180 {
        ux = lw - 1 - lx
        uy = lh - 1 - ly
    } else if rot == 90 {
        rw = lh
        rh = lw
        ux = lh - 1 - ly
        uy = lx
    } else if rot == 270 {
        rw = lh
        rh = lw
        ux = ly
        uy = lw - 1 - lx
    }
    let dx0: u64 = (pw - dw) / 2
    let dy0: u64 = (ph - dh) / 2
    var px: u64 = dx0 + ((2 * ux + 1) * dw) / (2 * rw)
    var py: u64 = dy0 + ((2 * uy + 1) * dh) / (2 * rh)
    if px >= dx0 + dw {
        px = dx0 + dw - 1
    }
    if py >= dy0 + dh {
        py = dy0 + dh - 1
    }
    return (px << 32) | py
}

fn set_logical(state: u64, lw: u64, lh: u64) -> bool {
    if lw == 0 && lh == 0 {
        kstate.set(state, FB_OFF + S_LOGW, 0)
        kstate.set(state, FB_OFF + S_LOGH, 0)
        relayout(state)
        return true
    }
    if !logical_ok(state, lw, lh) {
        return false
    }
    kstate.set(state, FB_OFF + S_LOGW, lw)
    kstate.set(state, FB_OFF + S_LOGH, lh)
    relayout(state)
    return true
}

fn set_scale(state: u64, s: u64) -> bool {
    if s > SCALE_NONE {
        return false
    }
    kstate.set(state, FB_OFF + S_SCALE, s)
    dirty_all(state)
    return true
}

fn set_lut(state: u64, p: u64) {
    kstate.set(state, FB_OFF + S_LUT, p)
    relayout(state)
}

fn set_saturation(state: u64, s: u64) -> bool {
    if s > 200 {
        return false
    }
    if s != 100 && kstate.get(state, FB_OFF + S_BACK) == 0 {
        return false
    }
    kstate.set(state, FB_OFF + S_SAT, s)
    relayout(state)
    return true
}

fn panel_hline(state: u64, x: u64, y: u64, n: u64, color: u64) {
    if n == 0 {
        return
    }
    let addr: u64 = kstate.get(state, FB_OFF + S_ADDR)
    var p: u64 = addr +% y *% kstate.get(state, FB_OFF + S_PPITCH) +% x *% 4
    var len: u64 = n
    if (p & 7) != 0 {
        __mmio_write32(p as *mut u32, color as u32)
        p = p +% 4
        len = len - 1
    }
    let paare: u64 = len / 2
    fill_words(p, twice(color), paare)
    p = p +% paare *% 8
    len = len - paare * 2
    while len > 0 {
        __mmio_write32(p as *mut u32, color as u32)
        p = p +% 4
        len = len - 1
    }
}

fn lut_color(state: u64, tab: u64, c: u64) -> u64 {
    let rs: u64 = kstate.get(state, FB_OFF + S_RSHIFT)
    let gs: u64 = kstate.get(state, FB_OFF + S_GSHIFT)
    let bs: u64 = kstate.get(state, FB_OFF + S_BSHIFT)
    let r: u64 = kstate.get8(tab + ((c >> rs) & 0xFF))
    let g: u64 = kstate.get8(tab + 256 + ((c >> gs) & 0xFF))
    let b: u64 = kstate.get8(tab + 512 + ((c >> bs) & 0xFF))
    return (r << rs) | (g << gs) | (b << bs)
}

fn sat_channel(v: u64, grau: u64, s: u64) -> u64 {
    if v >= grau {
        let d: u64 = (v - grau) * s / 100
        if grau + d > 255 {
            return 255
        }
        return grau + d
    }
    let d: u64 = (grau - v) * s / 100
    if d >= grau {
        return 0
    }
    return grau - d
}

fn sat_color(state: u64, c: u64, s: u64) -> u64 {
    let rs: u64 = kstate.get(state, FB_OFF + S_RSHIFT)
    let gs: u64 = kstate.get(state, FB_OFF + S_GSHIFT)
    let bs: u64 = kstate.get(state, FB_OFF + S_BSHIFT)
    let r: u64 = (c >> rs) & 0xFF
    let g: u64 = (c >> gs) & 0xFF
    let b: u64 = (c >> bs) & 0xFF
    let grau: u64 = (77 * r + 150 * g + 29 * b) >> 8
    return (sat_channel(r, grau, s) << rs) | (sat_channel(g, grau, s) << gs)
        | (sat_channel(b, grau, s) << bs)
}

fn present(state: u64) {
    kstate.set(state, FB_OFF + S_SHVALID, 0)
    vms_note(state, 0, 0, kstate.get(state, FB_OFF + S_PWIDTH), kstate.get(state, FB_OFF + S_PHEIGHT))
    let b: u64 = kstate.get(state, FB_OFF + S_BACK)
    if b == 0 {
        return
    }
    let addr: u64 = kstate.get(state, FB_OFF + S_ADDR)
    if addr == 0 {
        return
    }
    let pw: u64 = kstate.get(state, FB_OFF + S_PWIDTH)
    let ph: u64 = kstate.get(state, FB_OFF + S_PHEIGHT)
    let ppt: u64 = kstate.get(state, FB_OFF + S_PPITCH)
    let lw: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    let lh: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    let lpt: u64 = kstate.get(state, FB_OFF + S_PITCH)
    let rot: u64 = kstate.get(state, FB_OFF + S_ROT)
    let tab: u64 = kstate.get(state, FB_OFF + S_LUT)
    let sat: u64 = kstate.get(state, FB_OFF + S_SAT)
    if pw == 0 || ph == 0 || lw == 0 || lh == 0 {
        return
    }

    var rw: u64 = lw
    var rh: u64 = lh
    if rot == 90 || rot == 270 {
        rw = lh
        rh = lw
    }

    let art: u64 = kstate.get(state, FB_OFF + S_SCALE)
    var dw: u64 = pw
    var dh: u64 = ph
    if art == SCALE_NONE {
        dw = min2(rw, pw)
        dh = min2(rh, ph)
    } else if art == SCALE_ASPECT {
        if rw * ph <= pw * rh {
            dh = ph
            dw = rw * ph / rh
        } else {
            dw = pw
            dh = rh * pw / rw
        }
        if dw == 0 {
            dw = 1
        }
        if dh == 0 {
            dh = 1
        }
        if dw > pw {
            dw = pw
        }
        if dh > ph {
            dh = ph
        }
    }
    let dx0: u64 = (pw - dw) / 2
    let dy0: u64 = (ph - dh) / 2

    if dw != pw || dh != ph {
        var yy: u64 = 0
        while yy < ph {
            if yy < dy0 || yy >= dy0 + dh {
                panel_hline(state, 0, yy, pw, 0)
            } else {
                panel_hline(state, 0, yy, dx0, 0)
                panel_hline(state, dx0 + dw, yy, pw - dx0 - dw, 0)
            }
            yy = yy + 1
        }
    }

    let stepx: u64 = (rw << 16) / dw
    let stepy: u64 = (rh << 16) / dh

    let rs: u64 = kstate.get(state, FB_OFF + S_RSHIFT)
    let gs: u64 = kstate.get(state, FB_OFF + S_GSHIFT)
    let bs: u64 = kstate.get(state, FB_OFF + S_BSHIFT)
    let ors: u64 = kstate.get(state, FB_OFF + S_PRS)
    let ogs: u64 = kstate.get(state, FB_OFF + S_PGS)
    let obs: u64 = kstate.get(state, FB_OFF + S_PBS)
    let swz: bool = swizzled(state)
    let tabr: u64 = tab
    let tabg: u64 = tab + 256
    let tabb: u64 = tab + 512

    if rot == 0 && dw == rw && dh == rh && (tab != 0 || swz) && sat == 100 {
        var lo: u64 = kstate.get(state, FB_OFF + S_DIRTY_LO)
        var hi: u64 = kstate.get(state, FB_OFF + S_DIRTY_HI)
        if hi > lh {
            hi = lh
        }
        if hi > lo {
            var y: u64 = lo
            while y < hi {
                var src: u64 = b +% y *% lpt
                var dst: u64 = addr +% (dy0 + y) *% ppt +% dx0 *% 4
                var x: u64 = 0
                while x < dw {
                    let c: u64 = __mmio_read32(src as *mut u32) as u64
                    var v: u64 = 0
                    if tab != 0 {
                        v = ((__mmio_read8((tabr + ((c >> rs) & 0xFF)) as *mut u8)
                                as u64) << ors)
                            | ((__mmio_read8((tabg + ((c >> gs) & 0xFF))
                                as *mut u8) as u64) << ogs)
                            | ((__mmio_read8((tabb + ((c >> bs) & 0xFF))
                                as *mut u8) as u64) << obs)
                    } else {
                        v = (((c >> rs) & 0xFF) << ors)
                            | (((c >> gs) & 0xFF) << ogs)
                            | (((c >> bs) & 0xFF) << obs)
                    }
                    __mmio_write32(dst as *mut u32, v as u32)
                    src = src +% 4
                    dst = dst +% 4
                    x = x + 1
                }
                y = y + 1
            }
        }
        kstate.set(state, FB_OFF + S_DIRTY_LO, 0)
        kstate.set(state, FB_OFF + S_DIRTY_HI, 0)
        kstate.add(state, FB_OFF + S_FLUSHES, 1)
        kstate.add(state, FB_OFF + S_PRESENTS, 1)
        tx_add(state, kstate.get(state, FB_OFF + S_PPITCH)
            *% kstate.get(state, FB_OFF + S_PHEIGHT))
        return
    }

    var py: u64 = 0
    while py < dh {
        let ry: u64 = (py * stepy) >> 16
        var basis: u64 = 0
        var einheit: u64 = 4
        var bound: u64 = lw
        var rueck: bool = false
        if rot == 0 {
            basis = b +% ry *% lpt
        } else if rot == 180 {
            basis = b +% (lh - 1 - ry) *% lpt
            rueck = true
        } else if rot == 90 {
            basis = b +% ry *% 4
            einheit = lpt
            bound = lh
            rueck = true
        } else {
            basis = b +% (lw - 1 - ry) *% 4
            einheit = lpt
            bound = lh
        }
        var dst: u64 = addr +% (dy0 + py) *% ppt +% dx0 *% 4
        var px: u64 = 0
        if tab == 0 && sat == 100 && !swz {
            while px < dw {
                var idx: u64 = (px * stepx) >> 16
                if idx >= bound {
                    idx = bound - 1
                }
                if rueck {
                    idx = bound - 1 - idx
                }
                __mmio_write32(dst as *mut u32,
                    __mmio_read32((basis +% idx *% einheit) as *mut u32))
                dst = dst +% 4
                px = px + 1
            }
        } else if sat == 100 {
            while px < dw {
                var idx: u64 = (px * stepx) >> 16
                if idx >= bound {
                    idx = bound - 1
                }
                if rueck {
                    idx = bound - 1 - idx
                }
                let c: u64 = __mmio_read32((basis +% idx *% einheit)
                    as *mut u32) as u64
                var v: u64 = 0
                if tab != 0 {
                    v = ((__mmio_read8((tabr + ((c >> rs) & 0xFF)) as *mut u8)
                            as u64) << ors)
                        | ((__mmio_read8((tabg + ((c >> gs) & 0xFF)) as *mut u8)
                            as u64) << ogs)
                        | ((__mmio_read8((tabb + ((c >> bs) & 0xFF)) as *mut u8)
                            as u64) << obs)
                } else {
                    v = (((c >> rs) & 0xFF) << ors)
                        | (((c >> gs) & 0xFF) << ogs)
                        | (((c >> bs) & 0xFF) << obs)
                }
                __mmio_write32(dst as *mut u32, v as u32)
                dst = dst +% 4
                px = px + 1
            }
        } else {
            while px < dw {
                var idx: u64 = (px * stepx) >> 16
                if idx >= bound {
                    idx = bound - 1
                }
                if rueck {
                    idx = bound - 1 - idx
                }
                var c: u64 = __mmio_read32((basis +% idx *% einheit)
                    as *mut u32) as u64
                if tab != 0 {
                    c = ((__mmio_read8((tabr + ((c >> rs) & 0xFF))
                        as *mut u8) as u64) << rs)
                        | ((__mmio_read8((tabg + ((c >> gs) & 0xFF))
                        as *mut u8) as u64) << gs)
                        | ((__mmio_read8((tabb + ((c >> bs) & 0xFF))
                        as *mut u8) as u64) << bs)
                }
                let r: u64 = (c >> rs) & 0xFF
                let gr: u64 = (c >> gs) & 0xFF
                let bl: u64 = (c >> bs) & 0xFF
                let grau: u64 = (77 * r + 150 * gr + 29 * bl) >> 8
                let v: u64 = (sat_channel(r, grau, sat) << ors)
                    | (sat_channel(gr, grau, sat) << ogs)
                    | (sat_channel(bl, grau, sat) << obs)
                __mmio_write32(dst as *mut u32, v as u32)
                dst = dst +% 4
                px = px + 1
            }
        }
        py = py + 1
    }
    kstate.set(state, FB_OFF + S_DIRTY_LO, 0)
    kstate.set(state, FB_OFF + S_DIRTY_HI, 0)
    kstate.add(state, FB_OFF + S_FLUSHES, 1)
    kstate.add(state, FB_OFF + S_PRESENTS, 1)
    tx_add(state, kstate.get(state, FB_OFF + S_PPITCH)
        *% kstate.get(state, FB_OFF + S_PHEIGHT))
}

fn selftest2(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    if kstate.get(state, FB_OFF + S_BACK) == 0 {
        return 0
    }
    // stripe mode (`fbstreifen` or a real card with too little window space): the panel is only mapped through one 2 MiB slot,
    // `get_panel` would read past it (page fault). The promises cannot be judged here: report 0, never a fake pass.
    if stripe(state) {
        return 0
    }
    var n: u64 = 0
    let rot_alt: u64 = rotation(state)
    let sat_alt: u64 = saturation(state)
    let lut_alt: u64 = lut(state)
    let art_alt: u64 = scale(state)
    set_lut(state, 0)
    set_saturation(state, 100)
    set_rotation(state, 0)
    set_scale(state, SCALE_FULL)
    set_logical(state, 0, 0)

    let rot: u64 = rgb(state, 0xFF, 0, 0)
    let gruen: u64 = rgb(state, 0, 0xFF, 0)
    let pw: u64 = panel_w(state)
    let ph: u64 = panel_h(state)

    if !transformed(state) {
        n = n + 1
    }
    if width(state) == pw && height(state) == ph {
        n = n + 1
    }
    if !set_rotation(state, 45) && rotation(state) == 0 {
        n = n + 1
    }
    clear(state, 0)
    pixel(state, 0, 0, rot)
    if set_rotation(state, 180) {
        dirty_all(state)
        present(state)
        if get_panel(state, pw - 1, ph - 1) == rot {
            n = n + 1
        }
        if get_panel(state, 0, 0) == 0 {
            n = n + 1
        }
    }
    if set_rotation(state, 90) {
        if width(state) == ph && height(state) == pw {
            n = n + 1
        }
        clear(state, 0)
        pixel(state, 0, 0, gruen)
        dirty_all(state)
        present(state)
        if get_panel(state, pw - 1, 0) == gruen {
            n = n + 1
        }
    }
    set_rotation(state, 0)
    let tab: u64 = state + kstate.DLUT_OFF
    var i: u64 = 0
    while i < LUT_BYTES {
        kstate.set8(tab + i, 0)
        i = i + 1
    }
    clear(state, 0)
    fill(state, 0, 0, 8, 8, rot)
    set_lut(state, tab)
    dirty_all(state)
    present(state)
    if get_panel(state, 0, 0) == 0 && get_pixel(state, 0, 0) == rot {
        n = n + 1
    }
    i = 0
    while i < 256 {
        kstate.set8(tab + i, i as u8)
        kstate.set8(tab + 256 + i, i as u8)
        kstate.set8(tab + 512 + i, i as u8)
        i = i + 1
    }
    dirty_all(state)
    present(state)
    if get_panel(state, 0, 0) == rot {
        n = n + 1
    }
    set_lut(state, 0)
    if set_logical(state, pw / 2, ph / 2) {
        set_scale(state, SCALE_NONE)
        clear(state, gruen)
        dirty_all(state)
        present(state)
        if get_panel(state, 0, 0) == 0 && get_panel(state, pw / 2, ph / 2)
            == gruen {
            n = n + 1
        }
        set_scale(state, SCALE_FULL)
        dirty_all(state)
        present(state)
        if get_panel(state, 0, 0) == gruen
            && get_panel(state, pw - 1, ph - 1) == gruen {
            n = n + 1
        }
    }
    set_logical(state, 0, 0)
    set_scale(state, art_alt)
    set_saturation(state, sat_alt)
    set_lut(state, lut_alt)
    set_rotation(state, rot_alt)
    clear(state, 0)
    home(state)
    dirty_all(state)
    flush(state)
    return n
}

fn selftest2_max() -> u64 {
    return 11
}

fn selftest3(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    var n: u64 = 0
    let weiss: u64 = rgb(state, 0xFF, 0xFF, 0xFF)
    let schwarz: u64 = rgb(state, 0, 0, 0)
    let rot: u64 = rgb(state, 0xFF, 0, 0)

    if blend(state, weiss, schwarz, 0) == weiss {
        n = n + 1
    }
    if blend(state, weiss, schwarz, 255) == schwarz {
        n = n + 1
    }
    if blend(state, weiss, schwarz, 128) == rgb(state, 127, 127, 127) {
        n = n + 1
    }
    if blend(state, schwarz, weiss, 127) == rgb(state, 127, 127, 127) {
        n = n + 1
    }
    let h: u64 = blend(state, schwarz, rot, 128)
    if h == rgb(state, 128, 0, 0) {
        n = n + 1
    }
    let blau: u64 = rgb(state, 0, 0, 0xFF)
    let m: u64 = blend(state, rot, blau, 128)
    if m == rgb(state, 127, 0, 128) {
        n = n + 1
    }
    let v: u64 = blends(state)
    blend(state, rot, blau, 10)
    blend(state, rot, blau, 20)
    blend(state, rot, blau, 30)
    if blends(state) == v + 3 {
        n = n + 1
    }
    let v2: u64 = blends(state)
    let s2: u64 = blend_skips(state)
    blend(state, rot, blau, 0)
    blend(state, rot, blau, 255)
    if blends(state) == v2 && blend_skips(state) == s2 + 2 {
        n = n + 1
    }
    pixel(state, 0, 0, weiss)
    pixel_a(state, 1, 0, weiss, 255)
    if get_pixel(state, 1, 0) == weiss {
        n = n + 1
    }
    pixel(state, 2, 0, rot)
    pixel_a(state, 2, 0, weiss, 0)
    if get_pixel(state, 2, 0) == rot {
        n = n + 1
    }
    pixel(state, 3, 0, schwarz)
    pixel_a(state, 3, 0, weiss, 128)
    if get_pixel(state, 3, 0) == rgb(state, 128, 128, 128) {
        n = n + 1
    }
    pixel_a(state, 3, 0, weiss, 128)
    if get_pixel(state, 3, 0) == rgb(state, 192, 192, 192) {
        n = n + 1
    }
    fill(state, 0, 1, 8, 1, schwarz)
    hline_a(state, 0, 1, 8, weiss, 77)
    pixel(state, 0, 2, schwarz)
    pixel_a(state, 0, 2, weiss, 77)
    var same: bool = true
    var k: u64 = 0
    while k < 8 {
        if get_pixel(state, k, 1) != get_pixel(state, 0, 2) {
            same = false
        }
        k = k + 1
    }
    if same {
        n = n + 1
    }
    fill(state, 0, 3, 4, 2, schwarz)
    let d0: u64 = kstate.get(state, FB_OFF + S_DIRTY_LO)
    fill_a(state, 0, 3, 4, 2, weiss, 77)
    if get_pixel(state, 3, 4) == get_pixel(state, 0, 2)
        && kstate.get(state, FB_OFF + S_DIRTY_LO) <= d0 {
        n = n + 1
    }
    return n
}

fn selftest3_max() -> u64 {
    return 14
}

fn get_panel(state: u64, x: u64, y: u64) -> u64 {
    if x >= kstate.get(state, FB_OFF + S_PWIDTH) {
        return 0
    }
    if y >= kstate.get(state, FB_OFF + S_PHEIGHT) {
        return 0
    }
    let addr: u64 = kstate.get(state, FB_OFF + S_ADDR)
    return __mmio_read32((addr +% y *% kstate.get(state, FB_OFF + S_PPITCH)
        +% x *% 4) as *mut u32) as u64
}

// ------------------------------------------------- RUNDE SCHIRM: Proben
fn selftest4(state: u64) -> u64 {
    var n: u64 = 0
    if scale_for(1024, 768) == 1 {
        n = n + 1
    }
    if scale_for(1920, 1080) == 1 {
        n = n + 1
    }
    if scale_for(3840, 2160) == 2 {
        n = n + 1
    }
    if scale_for(7680, 4320) == 3 {
        n = n + 1
    }
    if need_bytes(0, 1920, 1080) == 1920 * 4 * 1080 {
        n = n + 1
    }
    if need_bytes(0, 0, 0) == 0 {
        n = n + 1
    }
    if fscale(state) >= 1 && uiscale(state) >= 1 {
        n = n + 1
    }
    if ready(state) {
        let fs: u64 = fscale(state)
        if cols(state) == width(state) / (font.GLYPH_W * fs) {
            n = n + 1
        }
        if rows(state) == height(state) / (font.GLYPH_H * fs) {
            n = n + 1
        }
    }
    var probe: [u8; 24] = "gfx fbres=1280x1024 wm\0\0"
    var saved_w: u64 = kstate.get(state, FB_OFF + S_RESW)
    var saved_h: u64 = kstate.get(state, FB_OFF + S_RESH)
    var word: [u8; 7] = "fbres=\0"
    if parse_zahlenpaar(state, (&probe[0]) as u64, (&word[0]) as u64, 6) {
        if kstate.get(state, FB_OFF + S_RESW) == 1280
            && kstate.get(state, FB_OFF + S_RESH) == 1024 {
            n = n + 1
        }
    }
    var probe2: [u8; 20] = "gfx fbres=9999x1 wm\0"
    if !parse_zahlenpaar(state, (&probe2[0]) as u64, (&word[0]) as u64, 6) {
        n = n + 1
    }
    var probe3: [u8; 18] = "gfx fbres=1280 wm\0"
    if !parse_zahlenpaar(state, (&probe3[0]) as u64, (&word[0]) as u64, 6) {
        n = n + 1
    }
    kstate.set(state, FB_OFF + S_RESW, saved_w)
    kstate.set(state, FB_OFF + S_RESH, saved_h)
    return n
}

fn selftest4_max() -> u64 {
    return 12
}

const BEAT_W: u64 = 56
const BEAT_H: u64 = 56

fn beat_x(state: u64, field: u64) -> u64 {
    let w: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    if w < 320 {
        return 0
    }
    if field == 0 {
        return w - 136
    }
    return w - 68
}

fn beat_y(state: u64) -> u64 {
    let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    if h < 2 * BEAT_H {
        return 0
    }
    return h / 2 - BEAT_H / 2
}

fn flush_rows(state: u64, lo: u64, hi: u64) {
    let b: u64 = kstate.get(state, FB_OFF + S_BACK)
    if b == 0 {
        return
    }
    if on_vgpu(state) {
        dirty_rect(state, 0, lo, kstate.get(state, FB_OFF + S_WIDTH),
            hi - lo)
        return
    }
    if transformed(state) {
        dirty(state, lo, hi)
        present(state)
        return
    }
    var o: u64 = lo
    var u: u64 = hi
    let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    if u > h {
        u = h
    }
    if u <= o {
        return
    }
    vms_note(state, 0, o, kstate.get(state, FB_OFF + S_WIDTH), u - o)
    if kstate.get(state, FB_OFF + S_STRIPE) != 0 {
        flush_stripe(state, o, u)
        return
    }
    let pt: u64 = kstate.get(state, FB_OFF + S_PITCH)
    let von: u64 = o *% pt
    let n: u64 = (u - o) *% pt
    let dst: u64 = draw_base(state) +% von
    let src: u64 = b +% von
    copy_words(dst, src, n / 8)
    arch.barrier_write()
    shadow_copy(state, von, n)
    tx_add(state, n)
    nachspuelen(state)
}

fn beat(state: u64, field: u64, an: u64) {
    if kstate.get(state, FB_OFF + S_READY) == 0 {
        return
    }
    let x0: u64 = beat_x(state, field)
    let y0: u64 = beat_y(state)
    if x0 == 0 || y0 == 0 {
        return
    }
    var bright: u64 = rgb(state, 0x00, 0xFF, 0x66) // links: gruen
    if field == 1 {
        bright = rgb(state, 0xFF, 0xE0, 0x00) // rechts: gelb
    }
    var color: u64 = rgb(state, 0x10, 0x10, 0x10)
    if an != 0 {
        color = bright
    }
    if field == 0 {
        fill(state, x0, y0, BEAT_W, BEAT_H, color)
        flush_rect(state, x0, y0, BEAT_W, BEAT_H)
        return
    }
    if kstate.get(state, FB_OFF + S_STRIPE) != 0 {
        fill(state, x0, y0, BEAT_W, BEAT_H, color)
        flush_rect(state, x0, y0, BEAT_W, BEAT_H)
        return
    }
    fill(state, x0, y0, BEAT_W, BEAT_H, color)
    let basis: u64 = draw_base(state)
    if basis == 0 {
        return
    }
    let pt: u64 = kstate.get(state, FB_OFF + S_PITCH)
    var r: u64 = 0
    while r < BEAT_H {
        let row: u64 = basis +% (y0 + r) *% pt +% x0 *% 4
        var c: u64 = 0
        while c < BEAT_W {
            __mmio_write32((row +% c * 4) as *mut u32, color as u32)
            c = c + 1
        }
        r = r + 1
    }
    arch.barrier_write()
    nachspuelen(state)
}

// Measured (tools/vboxlag): an idle desktop copied 1.27 MB per frame to the card and the pointer 1.1 MB, where the pixels that really
// change are a few KB. A rectangle that the damage rules grow (glass bar, blur window) is painted again in the back buffer, but
// most of its pixels come out the same. Writing them anyway costs every write-combined page; a virtual card (VirtualBox) tracks
// each written page. So: keep a shadow copy of what the card shows, compare each row of the rectangle word by word and write only
// the span from the first to the last changed word (into the card AND the shadow, from the same word read once, so the two cannot
// differ).
//
// The shadow is valid only after one full copy (`shadow_sync_all`). Everything that writes the card behind the back buffer's
// back (rotation, /dev/fb direct write, mode change, page flip) calls `shadow_inval`; the next rectangle then copies the whole
// frame once and the shadow is valid again. Writers that copy back-buffer rows to the card (`flush`, `flush_stripe`, `flush_rows`)
// keep the shadow in step with `shadow_copy`.
fn set_shadow(state: u64, addr: u64, bytes: u64) {
    kstate.set(state, FB_OFF + S_SHADOW, addr)
    kstate.set(state, FB_OFF + S_SHBYTES, bytes)
    kstate.set(state, FB_OFF + S_SHVALID, 0)
}

fn shadow_inval(state: u64) {
    kstate.set(state, FB_OFF + S_SHVALID, 0)
}

fn shadow_addr(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_SHADOW)
}

fn shadow_bytes(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_SHBYTES)
}

fn diff_skipped(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_DIFFSKIP)
}

// keep the shadow in step with a span the card just received from the back buffer
fn shadow_copy(state: u64, off: u64, n: u64) {
    let sh: u64 = kstate.get(state, FB_OFF + S_SHADOW)
    if sh == 0 || kstate.get(state, FB_OFF + S_SHVALID) == 0 {
        return
    }
    let b: u64 = kstate.get(state, FB_OFF + S_BACK)
    if b == 0 || flip_on(state) || off + n > kstate.get(state, FB_OFF + S_SHBYTES) {
        kstate.set(state, FB_OFF + S_SHVALID, 0)
        return
    }
    copy_words(sh +% off, b +% off, n / 8)
    var k: u64 = (n / 8) * 8
    while k + 4 <= n {
        __mmio_write32((sh +% off +% k) as *mut u32, __mmio_read32((b +% off +% k) as *mut u32))
        k = k + 4
    }
}

// the first and last (exclusive) differing byte of one row of `n` bytes, packed as (first << 32) | last; 0 = rows equal
fn row_diff(a: u64, b: u64, n: u64) -> u64 {
    let words: u64 = n / 8
    var i: u64 = 0
    var go: bool = true
    while go {
        if i >= words {
            go = false
        } else if __mmio_read64((a +% i *% 8) as *mut u64) != __mmio_read64((b +% i *% 8) as *mut u64) {
            go = false
        } else {
            i = i + 1
        }
    }
    var tail_diff: bool = false
    if n - words * 8 >= 4 {
        if __mmio_read32((a +% words *% 8) as *mut u32) != __mmio_read32((b +% words *% 8) as *mut u32) {
            tail_diff = true
        }
    }
    if i >= words && !tail_diff {
        return 0
    }
    let first: u64 = i * 8
    var last: u64 = n
    if !tail_diff {
        var j: u64 = words
        var go2: bool = true
        while go2 {
            if j <= i {
                go2 = false
            } else if __mmio_read64((a +% (j - 1) *% 8) as *mut u64) != __mmio_read64((b +% (j - 1) *% 8) as *mut u64) {
                go2 = false
            } else {
                j = j - 1
            }
        }
        last = j * 8
    }
    return (first << 32) | last
}

// write n bytes (multiple of 4) from the back buffer to the card and the shadow, every word read ONCE
fn span_put(card: u64, shadow: u64, back: u64, n: u64) {
    var k: u64 = 0
    while k + 8 <= n {
        let v: u64 = __mmio_read64((back +% k) as *mut u64)
        __mmio_write64((card +% k) as *mut u64, v)
        __mmio_write64((shadow +% k) as *mut u64, v)
        k = k + 8
    }
    if k + 4 <= n {
        let v4: u32 = __mmio_read32((back +% k) as *mut u32)
        __mmio_write32((card +% k) as *mut u32, v4)
        __mmio_write32((shadow +% k) as *mut u32, v4)
    }
}

// the whole back buffer to the card and the shadow once; afterwards the shadow is valid
fn shadow_sync_all(state: u64) {
    let sh: u64 = kstate.get(state, FB_OFF + S_SHADOW)
    let b: u64 = kstate.get(state, FB_OFF + S_BACK)
    let h: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    let pt: u64 = kstate.get(state, FB_OFF + S_PITCH)
    if sh == 0 || b == 0 || h *% pt > kstate.get(state, FB_OFF + S_SHBYTES) {
        return
    }
    vms_note(state, 0, 0, kstate.get(state, FB_OFF + S_WIDTH), h)
    // shadow first: if the back buffer changes meanwhile, the card gets the newer word and the shadow the older (the diff then
    // writes it again); the other order could leave the shadow newer than the card
    copy_words(sh, b, (h *% pt) / 8)
    if kstate.get(state, FB_OFF + S_STRIPE) != 0 {
        flush_stripe(state, 0, h)
    } else {
        let basis: u64 = draw_base(state)
        copy_words(basis, b, (h *% pt) / 8)
        arch.barrier_write()
        tx_add(state, h *% pt)
    }
    kstate.set(state, FB_OFF + S_SHVALID, 1)
}

fn flush_rect(state: u64, x: u64, y: u64, w: u64, h: u64) {
    let b: u64 = kstate.get(state, FB_OFF + S_BACK)
    if b == 0 {
        return
    }
    if on_vgpu(state) {
        dirty_rect(state, x, y, w, h)
        return
    }
    if transformed(state) {
        dirty(state, y, y + h)
        present(state)
        return
    }
    let bw: u64 = kstate.get(state, FB_OFF + S_WIDTH)
    let bh: u64 = kstate.get(state, FB_OFF + S_HEIGHT)
    if x >= bw || y >= bh {
        return
    }
    var ww: u64 = w
    if x + ww > bw {
        ww = bw - x
    }
    var hh: u64 = h
    if y + hh > bh {
        hh = bh - y
    }
    if ww == 0 || hh == 0 {
        return
    }
    vms_note(state, x, y, ww, hh)
    let pt: u64 = kstate.get(state, FB_OFF + S_PITCH)
    let n: u64 = ww *% 4
    // vboxlag: the diff path (needs a shadow, no page flip, no word `nodiff`)
    let shd: u64 = kstate.get(state, FB_OFF + S_SHADOW)
    if shd != 0 && !flip_on(state) && !nodiff_an(state) && (y + hh) *% pt <= kstate.get(state, FB_OFF + S_SHBYTES) {
        if kstate.get(state, FB_OFF + S_SHVALID) == 0 {
            shadow_sync_all(state)
            nachspuelen(state)
            return
        }
        var wrote: u64 = 0
        let stripe: bool = kstate.get(state, FB_OFF + S_STRIPE) != 0
        let basis_s: u64 = kstate.get(state, FB_OFF + S_SLOTV)
        let uc_s: bool = kstate.get(state, FB_OFF + S_UNCACHED) != 0
        let phys_s: u64 = kstate.get(state, FB_OFF + S_PHYS)
        let draw_s: u64 = draw_base(state)
        var rr: u64 = 0
        while rr < hh {
            let roff: u64 = (y + rr) *% pt +% x *% 4
            let d: u64 = row_diff(b +% roff, shd +% roff, n)
            let first: u64 = d >> 32
            let last: u64 = d & 0xFFFFFFFF
            if last > first {
                let f4: u64 = first & (~3)
                let l4: u64 = last & (~3)
                var cnt: u64 = l4 - f4
                if cnt == 0 {
                    cnt = 4
                }
                let goff: u64 = roff +% f4
                if stripe {
                    var rest: u64 = cnt
                    var off: u64 = goff
                    while rest > 0 {
                        let p: u64 = phys_s +% off
                        let blk: u64 = p & (~(HUGE_SIZE - 1))
                        let inner: u64 = p - blk
                        var seg: u64 = HUGE_SIZE - inner
                        if seg > rest {
                            seg = rest
                        }
                        let fl: u64 = arch.irq_save()
                        if slot_remap(state, basis_s, blk, uc_s) {
                            span_put(basis_s +% inner, shd +% off, b +% off, seg)
                            tx_add(state, seg)
                            wrote = wrote + seg
                        }
                        arch.irq_restore(fl)
                        off = off +% seg
                        rest = rest - seg
                    }
                } else {
                    span_put(draw_s +% goff, shd +% goff, b +% goff, cnt)
                    tx_add(state, cnt)
                    wrote = wrote + cnt
                }
            }
            rr = rr + 1
        }
        arch.barrier_write()
        if wrote < n *% hh {
            kstate.add(state, FB_OFF + S_DIFFSKIP, n *% hh - wrote)
        }
        nachspuelen(state)
        return
    }
    // the old whole-rectangle copy below does not keep the shadow in step
    if shd != 0 {
        kstate.set(state, FB_OFF + S_SHVALID, 0)
    }
    if kstate.get(state, FB_OFF + S_STRIPE) != 0 {
        let basis: u64 = kstate.get(state, FB_OFF + S_SLOTV)
        let uc: bool = kstate.get(state, FB_OFF + S_UNCACHED) != 0
        let phys0: u64 = kstate.get(state, FB_OFF + S_PHYS)
        var r: u64 = 0
        while r < hh {
            // W-VBLANK: a row segment that crosses a 2 MiB block is copied in two pieces (it used to be skipped and left to the
            // whole-row `flush` that followed; with only the rectangle copied every row of it must be copied here).
            var rest: u64 = n
            var off: u64 = (y + r) *% pt +% x *% 4
            while rest > 0 {
                let p: u64 = phys0 +% off
                let blk: u64 = p & (~(HUGE_SIZE - 1))
                let inner: u64 = p - blk
                var seg: u64 = HUGE_SIZE - inner
                if seg > rest {
                    seg = rest
                }
                let fl: u64 = arch.irq_save()
                if slot_remap(state, basis, blk, uc) {
                    copy_words(basis +% inner, b +% off, seg / 8)
                    var k: u64 = (seg / 8) * 8
                    while k + 4 <= seg {
                        __mmio_write32((basis +% inner +% k) as *mut u32,
                            __mmio_read32((b +% off +% k) as *mut u32))
                        k = k + 4
                    }
                    arch.barrier_write()
                    tx_add(state, seg)
                }
                arch.irq_restore(fl)
                off = off +% seg
                rest = rest - seg
            }
            r = r + 1
        }
        nachspuelen(state)
        return
    }
    let basis: u64 = draw_base(state)
    var r2: u64 = 0
    while r2 < hh {
        let off: u64 = (y + r2) *% pt +% x *% 4
        copy_words(basis +% off, b +% off, n / 8)
        var k: u64 = (n / 8) * 8
        while k + 4 <= n {
            __mmio_write32((basis +% off +% k) as *mut u32,
                __mmio_read32((b +% off +% k) as *mut u32))
            k = k + 4
        }
        r2 = r2 + 1
    }
    arch.barrier_write()
    tx_add(state, n *% hh)
    nachspuelen(state)
}

// W-PRESENT: ONE FRAME'S COPY TO THE CARD -- only the rectangle the frame changed.
//
// Before: after every composed frame `fb.dirty(y0, y1); fb.flush()` pushed WHOLE screen rows between the first and the last changed
// row. A window dragged across a 3440x1440 screen is ~1500 points wide, so 55 % of every row was copied for nothing, and on the real
// card (write-combining over PCIe, no vblank, no page flip in the stripe mode) the copy takes as long as the bytes are many: while it
// runs, the scan-out reads the upper rows of the NEW frame and the lower rows of the OLD one -- the horizontal tear and the "lagging
// lower half" Justin sees when he drags a window quickly. The picture is exposed to the scan-out for as long as the copy lasts, so the
// fix is to make the copy as short as it can be: only the columns of the changed rectangle.
// Rows other code marked dirty (board, console) are still taken by the trailing `flush` (it returns at once when nothing is marked).
fn flush_region(state: u64, x: u64, y: u64, w: u64, h: u64) {
    if on_vgpu(state) || transformed(state) {
        flush_rect(state, x, y, w, h)
        return
    }
    flush_rect(state, x, y, w, h)
    flush_done(state, y, y + h)
}

// W-VBLANK: the end of a frame's copies. The painters (fill, blit, glyphs) mark the ROWS they touch as dirty for the old whole-row `flush`;
// the rectangles were copied by `flush_rect`, so the marks that lie wholly inside the copied rows are spent and are dropped here. Before this,
// the trailing `flush` copied the whole rows again (measured: 9.45 MB per copy at 1920x1080, more than a full frame of 8.3 MB). Marks that reach
// outside the copied rows (the board, the console) still go the old way.
fn flush_done(state: u64, y0: u64, y1: u64) {
    if on_vgpu(state) || transformed(state) {
        return
    }
    let fl: u64 = arch.irq_save()
    let lo: u64 = kstate.get(state, FB_OFF + S_DIRTY_LO)
    let hi: u64 = kstate.get(state, FB_OFF + S_DIRTY_HI)
    // MEASURED: the Messtafel / console leave their row marks standing after their own rectangle copies; with the covered-rows rule
    // only, the trailing `flush` copied those rows whole again. by default the rectangles are trusted and every mark is dropped (`keepmarks` = old rule).
    if hi > lo && ((lo >= y0 && hi <= y1) || beam_trust(state)) {
        kstate.set(state, FB_OFF + S_DIRTY_LO, 0)
        kstate.set(state, FB_OFF + S_DIRTY_HI, 0)
    }
    arch.irq_restore(fl)
    flush(state)
}

fn flush_reset(state: u64) {
    kstate.set(state, FB_OFF + S_FLUS, 0)
    kstate.set(state, FB_OFF + S_FLMAX, 0)
    kstate.set(state, FB_OFF + S_FLN, 0)
    kstate.set(state, FB_OFF + S_FLOK, 0)
}

// Cost of one frame's copy in microseconds (the window server times it with the TSC): sum, max and count for F12.
fn flush_note(state: u64, us: u64, oktette: u64) {
    kstate.add(state, FB_OFF + S_FLOK, oktette)
    kstate.add(state, FB_OFF + S_FLUS, us)
    kstate.add(state, FB_OFF + S_FLN, 1)
    if us > kstate.get(state, FB_OFF + S_FLMAX) {
        kstate.set(state, FB_OFF + S_FLMAX, us)
    }
}

fn pde_roh(state: u64) -> u64 {
    let pd: u64 = kernel_pd(state)
    if pd == 0 {
        return 0
    }
    let s0: u64 = kstate.get(state, FB_OFF + S_SLOT0)
    if s0 == 0 {
        return 0
    }
    return __mmio_read64((pd + (WIN_FIRST + s0 - 1) * 8) as *mut u64)
}

fn pat_roh(state: u64) -> u64 {
    return msr.rd0(state, IA32_PAT)
}

fn stripe_slots(state: u64) -> u64 {
    return kstate.get(state, FB_OFF + S_HUGES)
}

const PF_BASE: u64 = 0x948
const PF_FBW: u64 = 0
const PF_COPY: u64 = 1
const PF_RAM: u64 = 2
const PF_MTRR: u64 = 3
const PF_DONE: u64 = 4
const PF_BYTES: u64 = 5
const PF_ROUNDS: u64 = 6
const PF_FBW0: u64 = 7

const MSR_MTRRCAP: u64 = 0xFE
const MSR_MTRR_DEF: u64 = 0x2FF
const MSR_MTRR_BASE0: u64 = 0x200

fn perf_set(state: u64, i: u64, v: u64) {
    if i < 8 {
        kstate.set(state, FB_OFF + PF_BASE + i * 8, v)
    }
}

fn perf_get(state: u64, i: u64) -> u64 {
    if i >= 8 {
        return 0
    }
    return kstate.get(state, FB_OFF + PF_BASE + i * 8)
}

fn cache_mode(state: u64) -> u64 {
    let pde: u64 = pde_roh(state)
    if pde == 0 {
        return 3
    }
    if (pde & (PAGE_PWT | PAGE_PCD)) == (PAGE_PWT | PAGE_PCD) {
        return 0
    }
    if (pde & PAGE_PAT_HUGE) != 0 && ((msr.rd0(state, IA32_PAT) >> 32) & 255) == PAT_WC {
        return 1
    }
    return 2
}

fn mtrr_probe(state: u64) {
    let phys: u64 = kstate.get(state, FB_OFF + S_PHYS)
    let cap: u64 = msr.rd0(state, MSR_MTRRCAP)
    let def: u64 = msr.rd0(state, MSR_MTRR_DEF)
    let vcnt: u64 = cap & 255
    var ty: u64 = 255
    var hits: u64 = 0
    var i: u64 = 0
    while i < vcnt && i < 16 {
        let base: u64 = msr.rd0(state, MSR_MTRR_BASE0 + i * 2)
        let mask: u64 = msr.rd0(state, MSR_MTRR_BASE0 + i * 2 + 1)
        if (mask & 0x800) != 0 {
            let m: u64 = mask & ADDR_MASK
            if (phys & m) == (base & m) {
                let t: u64 = base & 255
                hits = hits + 1
                if ty == 255 {
                    ty = t
                } else if ty == 0 || t == 0 {
                    ty = 0
                } else if ty != t {
                    ty = 0
                }
            }
        }
        i = i + 1
    }
    if ty == 255 {
        ty = 0
        if (def & 0x800) != 0 {
            ty = def & 255
        }
    }
    let wcbit: u64 = (cap >> 10) & 1
    let en: u64 = (def >> 11) & 1
    perf_set(state, PF_MTRR, ty | (hits << 8) | (vcnt << 16) | ((def & 255) << 24) | (en << 32) | (wcbit << 33))
}
