// W-VBLANK: beam sync (drv/gpu/beam.fi). The Intel display pipe's scan-line counter tells where the scan-out is; the window server holds the
// copy of a rectangle back until the raster is out of the way. 0x870..0x910 belong to it.
const S_BM_ON: u64 = 0x870 // 0 = not probed yet, 1 = on, 2 = off (no register that counts), 3 = switched off by the guard, 4 = switched off by `nobeam`
const S_BM_BASE: u64 = 0x878 // virtual address of the pipe register block (PIPE_DSL at +0)
const S_BM_VT: u64 = 0x880 // lines per frame (vtotal) as measured
const S_BM_LINE: u64 = 0x888 // TSC cycles per scan line
const S_BM_FRAME: u64 = 0x890 // TSC cycles per frame
const S_BM_RATE: u64 = 0x898 // copy speed in octets per microsecond, times 64 (running average)
const S_BM_WAITS: u64 = 0x8A0 // copies that went through the wait
const S_BM_WCYC: u64 = 0x8A8 // TSC cycles spent waiting, summed
const S_BM_WMAX: u64 = 0x8B0 // longest single wait, TSC cycles
const S_BM_TO: u64 = 0x8B8 // waits that hit the deadline (copied anyway)
const S_BM_CONS: u64 = 0x8C0 // timeouts in a row (the guard switches beam sync off at 8)
const S_BM_BIG: u64 = 0x8C8 // copies too tall to hide behind the raster (copied at once)
const S_BM_TRIES: u64 = 0x8D0 // probe attempts
const S_BM_MHZ: u64 = 0x8D8 // refresh rate in millihertz, from the DSL wraps
const S_BM_DMIN: u64 = 0x8E0 // smallest DSL seen by the probe
const S_BM_DMAX: u64 = 0x8E8 // largest DSL seen by the probe
const S_BM_PIPE: u64 = 0x8F0 // pipe the probe settled on (0 = A)
const S_BM_MHZF: u64 = 0x8F8 // refresh rate in millihertz, from the frame counter (0 = no counter)
const S_BM_COPY: u64 = 0x900 // copies of rectangles since boot (the denominator of the wait counters)
const S_RM_IN: u64 = 0x908 // rectangles painted in frames that were merged (before the merge)
const S_RM_OUT: u64 = 0x910 // ... and what was left after the merge
// vboxlag: DIFF FLUSH. A shadow copy of what was last written to the card; `flush_rect` writes only the words that differ from it.
const S_PATVAL: u64 = 0x938 // the PAT value the boot core set (WC at index 4); every other core copies it in `sched.on_tick`
const S_PATDONE: u64 = 0x940 // bit per core: this core has the value (bit 0 = the boot core)
const S_PRS: u64 = 0x988 // panel red shift (what the card scans); S_RSHIFT is the shift of the back buffer
const S_PGS: u64 = 0x990 // panel green shift
const S_PBS: u64 = 0x998 // panel blue shift
const S_SHADOW: u64 = 0x918 // shadow buffer (same layout as the back buffer), 0 = none
const S_SHVALID: u64 = 0x920 // 1 = the shadow equals what the card shows
const S_SHBYTES: u64 = 0x928 // size of the shadow buffer
const S_DIFFSKIP: u64 = 0x930 // octets the diff did NOT write (sum)
