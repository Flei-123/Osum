profile kernel

import ipc.cap

export {
    bind_sys, wm, wig, disp, tile, float_check, ax, shot, tipp,
    H_WM, H_WIG, H_DISP, H_TILE, H_FLOAT, H_AX, H_SHOT, H_TIPP
}

const H_WM: u64 = 0
const H_WIG: u64 = 1
const H_DISP: u64 = 2
const H_TILE: u64 = 3
const H_FLOAT: u64 = 4
const H_AX: u64 = 5
const H_SHOT: u64 = 6
const H_TIPP: u64 = 7
const H_COUNT: u64 = 8

static mut table: [u64; 8] = [0 as u64; 8]

fn bind_sys(slot: u64, handler: u64) {
    if slot < H_COUNT {
        table[slot as usize] = handler
    }
}

fn unbound() -> u64 {
    return cap.err(cap.E_UNSUPPORTED)
}

fn wm(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64,
    a3: u64, a4: u64) -> u64 {
    let handler: u64 = table[H_WM as usize]
    if handler == 0 {
        return unbound()
    }
    let call: fn(u64, u64, u64, u64, u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64, u64, u64, u64, u64) -> u64
    return call(state, me, number, a0, a1, a2, a3, a4)
}

fn wig(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64,
    a3: u64, a4: u64) -> u64 {
    let handler: u64 = table[H_WIG as usize]
    if handler == 0 {
        return unbound()
    }
    let call: fn(u64, u64, u64, u64, u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64, u64, u64, u64, u64) -> u64
    return call(state, me, number, a0, a1, a2, a3, a4)
}

fn disp(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    let handler: u64 = table[H_DISP as usize]
    if handler == 0 {
        return unbound()
    }
    let call: fn(u64, u64, u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64, u64, u64) -> u64
    return call(state, me, number, a0, a1, a2)
}

fn tile(state: u64, me: u64, number: u64, a0: u64, a1: u64) -> u64 {
    let handler: u64 = table[H_TILE as usize]
    if handler == 0 {
        return unbound()
    }
    let call: fn(u64, u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64, u64) -> u64
    return call(state, me, number, a0, a1)
}

fn float_check(state: u64) -> u64 {
    let handler: u64 = table[H_FLOAT as usize]
    if handler == 0 {
        return 0
    }
    let call: fn(u64) -> u64 = handler as fn(u64) -> u64
    return call(state)
}

fn ax(state: u64, me: u64, number: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    let handler: u64 = table[H_AX as usize]
    if handler == 0 {
        return unbound()
    }
    let call: fn(u64, u64, u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64, u64, u64) -> u64
    return call(state, me, number, a0, a1, a2)
}

fn shot(state: u64, me: u64, what: u64, a1: u64, a2: u64) -> u64 {
    let handler: u64 = table[H_SHOT as usize]
    if handler == 0 {
        return unbound()
    }
    let call: fn(u64, u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64, u64) -> u64
    return call(state, me, what, a1, a2)
}

fn tipp(state: u64, me: u64, what: u64, a1: u64, a2: u64) -> u64 {
    let handler: u64 = table[H_TIPP as usize]
    if handler == 0 {
        return unbound()
    }
    let call: fn(u64, u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64, u64) -> u64
    return call(state, me, what, a1, a2)
}
