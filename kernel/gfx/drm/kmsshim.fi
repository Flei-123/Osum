profile kernel

import lib.ksym
import fs.unixsock
import gfx.drm.kmsreg

export { init, register_c, unregister_c }

const OPS_WORDS: u64 = 7
const OPS_READY: u64 = 0
const OPS_WIDTH: u64 = 1
const OPS_HEIGHT: u64 = 2
const OPS_REFRESH: u64 = 3
const OPS_SCANOUT: u64 = 4
const OPS_RELEASE: u64 = 5
const OPS_TAG: u64 = 6
const WORD_BYTES: u64 = 8

fn word(table: u64, index: u64) -> u64 {
    return __mmio_read64((table + index * WORD_BYTES) as *mut u64)
}

fn register_c(table: u64) -> u64 {
    if table == 0 {
        return 0
    }
    var index: u64 = 0
    while index < OPS_TAG {
        if ksym.from_c(word(table, index)) == 0 {
            return 0
        }
        index = index + 1
    }
    let ready: u64 = ksym.from_c(word(table, OPS_READY))
    let width: u64 = ksym.from_c(word(table, OPS_WIDTH))
    let height: u64 = ksym.from_c(word(table, OPS_HEIGHT))
    let refresh: u64 = ksym.from_c(word(table, OPS_REFRESH))
    let scanout: u64 = ksym.from_c(word(table, OPS_SCANOUT))
    let release: u64 = ksym.from_c(word(table, OPS_RELEASE))
    let ok: bool = kmsreg.register(kmsreg.KmsOps {
        ready: ready as fn(u64) -> bool,
        width: width as fn(u64) -> u64,
        height: height as fn(u64) -> u64,
        refresh: refresh as fn(u64) -> u64,
        scanout: scanout as fn(u64, u64, u64, u64, u64) -> bool,
        release: release as fn(u64),
        tag: word(table, OPS_TAG)
    })
    if ok {
        return 1
    }
    return 0
}

fn unregister_c(tag: u64) {
    kmsreg.unregister(tag)
}

fn shm_frame_c(state: u64, shm: u64, index: u64) -> u64 {
    return unixsock.shm_frame(state, shm, index)
}

fn init() {
    ksym.hw_set(ksym.H_KMS_REGISTER, ksym.addr_1u(register_c))
    ksym.hw_set(ksym.H_KMS_UNREGISTER, ksym.addr_1v(unregister_c))
    ksym.hw_set(ksym.H_KMS_SHM_FRAME, ksym.addr_3u(shm_frame_c))
}
