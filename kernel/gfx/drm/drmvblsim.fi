profile kernel

import lib.kstate
import sched.time
import gfx.drm.kmsvbl

export { tick }

const SIM_PERIOD_NS: u64 = 33333333

static mut next_ns: u64 = 0

fn tick(state: u64) {
    if !kstate.mode_on(state, kstate.M_DRMVBLSIM) {
        return
    }
    let now: u64 = time.mono_ns(state)
    if now < next_ns {
        return
    }
    next_ns = now + SIM_PERIOD_NS
    kmsvbl.report(state, now)
}
