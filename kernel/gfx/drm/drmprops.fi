profile kernel

import lib.errno
import gfx.drm.drmuapi

export { get_plane_resources, get_object_properties }

fn get_plane_resources(a: u64) -> u64 {
    drmuapi.w32(a + 8, 0)
    return 0
}

fn known_object(id: u64) -> bool {
    return id == drmuapi.CONNECTOR_ID || id == drmuapi.ENCODER_ID || id == drmuapi.CRTC_ID || id == drmuapi.PLANE_ID
}

fn get_object_properties(a: u64) -> u64 {
    if !known_object(drmuapi.r32(a + 20)) {
        return errno.E_NOENT
    }
    drmuapi.w32(a + 16, 0)
    return 0
}
