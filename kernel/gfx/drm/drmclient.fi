profile kernel

import gfx.drm.drmgone
import gfx.drm.drmgem
import gfx.drm.drmfb
import gfx.drm.kmscrtc
import gfx.drm.kmsgfx
import gfx.drm.drmevent
import gfx.drm.drmsync

export { open, reap, is_render, is_master, set_master, drop_master, live }

static mut used: [u64; 16] = [0 as u64; 16]
static mut render: [u64; 16] = [0 as u64; 16]
static mut master: u64 = 0

fn valid(client: u64) -> bool {
    return client >= 1 && client <= drmgone.MAX_CLIENTS && used[(client - 1) as usize] != 0
}

fn release(state: u64, client: u64) {
    drmfb.drop_client(state, client)
    drmgem.drop_client(state, client)
    drmsync.drop_client(client)
    drmevent.drop_client(client)
    if drmfb.find(kmscrtc.current_fb()) == drmfb.NONE {
        kmscrtc.fb_gone(state, kmscrtc.current_fb())
    }
    if master == client {
        master = 0
    }
    used[(client - 1) as usize] = 0
    render[(client - 1) as usize] = 0
}

fn reap(state: u64) {
    drmsync.reap_fds()
    var c: u64 = 1
    while c <= drmgone.MAX_CLIENTS {
        if drmgone.take(c) && used[(c - 1) as usize] != 0 {
            release(state, c)
        }
        c = c + 1
    }
}

fn open(state: u64, render_node: bool) -> u64 {
    reap(state)
    let _attached: bool = kmsgfx.attach(state)
    var c: u64 = 1
    while c <= drmgone.MAX_CLIENTS {
        if used[(c - 1) as usize] == 0 {
            used[(c - 1) as usize] = 1
            render[(c - 1) as usize] = 0
            if render_node {
                render[(c - 1) as usize] = 1
            } else if master == 0 {
                master = c
            }
            return c
        }
        c = c + 1
    }
    return 0
}

fn live(client: u64) -> bool {
    return valid(client)
}

fn is_render(client: u64) -> bool {
    return valid(client) && render[(client - 1) as usize] != 0
}

fn is_master(client: u64) -> bool {
    return valid(client) && master == client
}

fn set_master(client: u64) -> bool {
    if is_render(client) || (master != 0 && master != client) {
        return false
    }
    master = client
    return true
}

fn drop_master(client: u64) -> bool {
    if master != client {
        return false
    }
    master = 0
    return true
}
