profile kernel

import sync.atomic
import sched.sched
import sched.time
import gfx.drm.drmvblsim

export { arm, tick }

static mut next_due: u64 = 0

fn arm(due_ns: u64) {
    let p: u64 = (&next_due) as u64
    var cur: u64 = atomic.load(p)
    while cur == 0 || due_ns < cur {
        if atomic.cas(p, cur, due_ns) == cur {
            return
        }
        cur = atomic.load(p)
    }
}

fn tick(state: u64) {
    drmvblsim.tick(state)
    let p: u64 = (&next_due) as u64
    let due: u64 = atomic.load(p)
    if due == 0 || time.mono_ns(state) < due {
        return
    }
    if atomic.cas(p, due, 0) == due {
        sched.poll_kick(state)
    }
}
