profile kernel

import lib.kstate
import sched.time

export { PERIOD_NS, now_ns, seq_now, seq_ns, wake_tick }

const PERIOD_NS: u64 = 16666667

fn now_ns(state: u64) -> u64 {
    return time.mono_ns(state)
}

fn seq_now(state: u64) -> u64 {
    return time.mono_ns(state) / PERIOD_NS
}

fn seq_ns(seq: u64) -> u64 {
    return seq * PERIOD_NS
}

fn wake_tick(state: u64, due_ns: u64) -> u64 {
    let now: u64 = time.mono_ns(state)
    let ticks: u64 = kstate.get(state, kstate.TICKS)
    if due_ns <= now {
        return ticks
    }
    return ticks + (due_ns - now + time.TICK_NS - 1) / time.TICK_NS
}
