profile kernel

export {
    IOC_TYPE, ARG_MAX, NR_VERSION, NR_GET_UNIQUE, NR_GEM_CLOSE, NR_GET_CAP, NR_SET_CLIENT_CAP,
    NR_SET_MASTER, NR_DROP_MASTER, NR_GETRESOURCES, NR_GETCRTC, NR_SETCRTC, NR_GETENCODER,
    NR_GETCONNECTOR, NR_ADDFB, NR_RMFB, NR_PAGE_FLIP, NR_DIRTYFB, NR_CREATE_DUMB, NR_MAP_DUMB,
    NR_DESTROY_DUMB, NR_ADDFB2,
    NR_PRIME_HANDLE_TO_FD, NR_PRIME_FD_TO_HANDLE, NR_WAIT_VBLANK, NR_CRTC_GET_SEQUENCE, NR_CRTC_QUEUE_SEQUENCE,
    NR_SYNCOBJ_CREATE, NR_SYNCOBJ_DESTROY, NR_SYNCOBJ_HANDLE_TO_FD, NR_SYNCOBJ_FD_TO_HANDLE, NR_SYNCOBJ_WAIT,
    NR_SYNCOBJ_RESET, NR_SYNCOBJ_SIGNAL, NR_SYNCOBJ_TIMELINE_WAIT, NR_SYNCOBJ_QUERY, NR_SYNCOBJ_TRANSFER,
    NR_SYNCOBJ_TIMELINE_SIGNAL, NR_GETPLANERESOURCES, NR_OBJ_GETPROPERTIES,
    CAP_DUMB_BUFFER, CAP_VBLANK_HIGH_CRTC, CAP_DUMB_PREFERRED_DEPTH, CAP_DUMB_PREFER_SHADOW, CAP_PRIME,
    CAP_TIMESTAMP_MONOTONIC, CAP_ASYNC_PAGE_FLIP, CAP_ADDFB2_MODIFIERS, CAP_CRTC_IN_VBLANK_EVENT, CAP_SYNCOBJ,
    CAP_SYNCOBJ_TIMELINE,
    CONNECTOR_ID, ENCODER_ID, CRTC_ID, PLANE_ID, FB_ID_BASE, FORMAT_XRGB8888, FORMAT_ARGB8888,
    r16, r32, r64, w16, w32, w64
}

const IOC_TYPE: u64 = 0x64
const ARG_MAX: u64 = 128

const NR_VERSION: u64 = 0x00
const NR_GET_UNIQUE: u64 = 0x01
const NR_GEM_CLOSE: u64 = 0x09
const NR_GET_CAP: u64 = 0x0C
const NR_SET_CLIENT_CAP: u64 = 0x0D
const NR_SET_MASTER: u64 = 0x1E
const NR_DROP_MASTER: u64 = 0x1F
const NR_GETRESOURCES: u64 = 0xA0
const NR_GETCRTC: u64 = 0xA1
const NR_SETCRTC: u64 = 0xA2
const NR_GETENCODER: u64 = 0xA6
const NR_GETCONNECTOR: u64 = 0xA7
const NR_ADDFB: u64 = 0xAE
const NR_RMFB: u64 = 0xAF
const NR_PAGE_FLIP: u64 = 0xB0
const NR_DIRTYFB: u64 = 0xB1
const NR_CREATE_DUMB: u64 = 0xB2
const NR_MAP_DUMB: u64 = 0xB3
const NR_DESTROY_DUMB: u64 = 0xB4
const NR_ADDFB2: u64 = 0xB8
const NR_GETPLANERESOURCES: u64 = 0xB5
const NR_OBJ_GETPROPERTIES: u64 = 0xB9
const NR_PRIME_HANDLE_TO_FD: u64 = 0x2D
const NR_PRIME_FD_TO_HANDLE: u64 = 0x2E
const NR_WAIT_VBLANK: u64 = 0x3A
const NR_CRTC_GET_SEQUENCE: u64 = 0x3B
const NR_CRTC_QUEUE_SEQUENCE: u64 = 0x3C
const NR_SYNCOBJ_CREATE: u64 = 0xBF
const NR_SYNCOBJ_DESTROY: u64 = 0xC0
const NR_SYNCOBJ_HANDLE_TO_FD: u64 = 0xC1
const NR_SYNCOBJ_FD_TO_HANDLE: u64 = 0xC2
const NR_SYNCOBJ_WAIT: u64 = 0xC3
const NR_SYNCOBJ_RESET: u64 = 0xC4
const NR_SYNCOBJ_SIGNAL: u64 = 0xC5
const NR_SYNCOBJ_TIMELINE_WAIT: u64 = 0xCA
const NR_SYNCOBJ_QUERY: u64 = 0xCB
const NR_SYNCOBJ_TRANSFER: u64 = 0xCC
const NR_SYNCOBJ_TIMELINE_SIGNAL: u64 = 0xCD

const CAP_DUMB_BUFFER: u64 = 1
const CAP_VBLANK_HIGH_CRTC: u64 = 2
const CAP_DUMB_PREFERRED_DEPTH: u64 = 3
const CAP_PRIME: u64 = 5
const CAP_ASYNC_PAGE_FLIP: u64 = 7
const CAP_ADDFB2_MODIFIERS: u64 = 0x10
const CAP_CRTC_IN_VBLANK_EVENT: u64 = 0x12
const CAP_SYNCOBJ: u64 = 0x13
const CAP_SYNCOBJ_TIMELINE: u64 = 0x14
const CAP_DUMB_PREFER_SHADOW: u64 = 4
const CAP_TIMESTAMP_MONOTONIC: u64 = 6

const CONNECTOR_ID: u64 = 0x30
const ENCODER_ID: u64 = 0x31
const CRTC_ID: u64 = 0x32
const PLANE_ID: u64 = 0x33
const FB_ID_BASE: u64 = 0x100

const FORMAT_XRGB8888: u64 = 0x34325258
const FORMAT_ARGB8888: u64 = 0x34325241

fn r16(p: u64) -> u64 {
    return (*(p as *mut u16)) as u64
}

fn r32(p: u64) -> u64 {
    return (*(p as *mut u32)) as u64
}

fn r64(p: u64) -> u64 {
    return *(p as *mut u64)
}

fn w16(p: u64, v: u64) {
    *(p as *mut u16) = v as u16
}

fn w32(p: u64, v: u64) {
    *(p as *mut u32) = v as u32
}

fn w64(p: u64, v: u64) {
    *(p as *mut u64) = v
}
