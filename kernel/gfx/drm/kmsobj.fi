profile kernel

import lib.errno
import sys.sysuser
import gfx.drm.drmfb
import gfx.drm.drmuapi
import gfx.drm.kmsmode
import gfx.drm.kmsreg

export { get_resources, get_connector, get_encoder, put_id }

const MAX_SIDE: u64 = 8192
const CONNECTOR_VIRTUAL: u64 = 15
const ENCODER_VIRTUAL: u64 = 5
const CONNECTED: u64 = 1

static mut mode_buf: [u8; 68] = [0 as u8; 68]

fn put_id(state: u64, me: u64, ptr: u64, room: u64, id: u64) -> bool {
    if ptr == 0 || room == 0 {
        return true
    }
    return sysuser.put32(state, me, ptr, id)
}

fn put_fb_ids(state: u64, me: u64, client: u64, ptr: u64, room: u64) -> bool {
    let total: u64 = drmfb.count_of(client)
    var i: u64 = 0
    while ptr != 0 && i < total && i < room {
        if !sysuser.put32(state, me, ptr + i * 4, drmfb.nth_id(client, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn get_resources(state: u64, me: u64, client: u64, a: u64) -> u64 {
    if !kmsreg.ready(state) {
        return errno.E_NODEV
    }
    let ok: bool = put_fb_ids(state, me, client, drmuapi.r64(a), drmuapi.r32(a + 32))
        && put_id(state, me, drmuapi.r64(a + 8), drmuapi.r32(a + 36), drmuapi.CRTC_ID)
        && put_id(state, me, drmuapi.r64(a + 16), drmuapi.r32(a + 40), drmuapi.CONNECTOR_ID)
        && put_id(state, me, drmuapi.r64(a + 24), drmuapi.r32(a + 44), drmuapi.ENCODER_ID)
    if !ok {
        return errno.E_FAULT
    }
    drmuapi.w32(a + 32, drmfb.count_of(client))
    drmuapi.w32(a + 36, 1)
    drmuapi.w32(a + 40, 1)
    drmuapi.w32(a + 44, 1)
    drmuapi.w32(a + 48, 1)
    drmuapi.w32(a + 52, MAX_SIDE)
    drmuapi.w32(a + 56, 1)
    drmuapi.w32(a + 60, MAX_SIDE)
    return 0
}

fn put_mode(state: u64, me: u64, ptr: u64, room: u64) -> bool {
    if ptr == 0 || room == 0 {
        return true
    }
    let m: u64 = (&mode_buf[0]) as u64
    kmsmode.fill(state, m)
    return sysuser.copy_out(state, me, ptr, m, kmsmode.SIZE)
}

fn get_connector(state: u64, me: u64, a: u64) -> u64 {
    if !kmsreg.ready(state) || drmuapi.r32(a + 48) != drmuapi.CONNECTOR_ID {
        return errno.E_NOENT
    }
    let ok: bool = put_id(state, me, drmuapi.r64(a), drmuapi.r32(a + 40), drmuapi.ENCODER_ID)
        && put_mode(state, me, drmuapi.r64(a + 8), drmuapi.r32(a + 32))
    if !ok {
        return errno.E_FAULT
    }
    drmuapi.w32(a + 32, 1)
    drmuapi.w32(a + 36, 0)
    drmuapi.w32(a + 40, 1)
    drmuapi.w32(a + 44, drmuapi.ENCODER_ID)
    drmuapi.w32(a + 52, CONNECTOR_VIRTUAL)
    drmuapi.w32(a + 56, 1)
    drmuapi.w32(a + 60, CONNECTED)
    drmuapi.w32(a + 64, 0)
    drmuapi.w32(a + 68, 0)
    drmuapi.w32(a + 72, 0)
    return 0
}

fn get_encoder(state: u64, me: u64, a: u64) -> u64 {
    if !kmsreg.ready(state) || drmuapi.r32(a) != drmuapi.ENCODER_ID {
        return errno.E_NOENT
    }
    drmuapi.w32(a + 4, ENCODER_VIRTUAL)
    drmuapi.w32(a + 8, drmuapi.CRTC_ID)
    drmuapi.w32(a + 12, 1)
    drmuapi.w32(a + 16, 0)
    return 0
}
