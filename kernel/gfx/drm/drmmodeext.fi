profile kernel

import lib.errno
import gfx.drm.drmuapi
import gfx.drm.drmprop
import gfx.drm.drmprops
import gfx.drm.drmblob
import gfx.drm.drmatomic
import gfx.drm.kmsplane

export { owns, needs_master, run }

fn owns(nr: u64) -> bool {
    return nr == drmuapi.NR_GETPLANERESOURCES || nr == drmuapi.NR_OBJ_GETPROPERTIES || nr == drmuapi.NR_GETPROPERTY
        || nr == drmuapi.NR_GETPROPBLOB || nr == drmuapi.NR_GETPLANE || nr == drmuapi.NR_SETPLANE
        || nr == drmuapi.NR_ATOMIC || nr == drmuapi.NR_CREATEPROPBLOB || nr == drmuapi.NR_DESTROYPROPBLOB
}

fn needs_master(nr: u64) -> bool {
    return nr == drmuapi.NR_SETPLANE || nr == drmuapi.NR_ATOMIC
}

fn run(state: u64, me: u64, c: u64, nr: u64, a: u64) -> u64 {
    if nr == drmuapi.NR_GETPLANERESOURCES {
        return drmprops.get_plane_resources(state, me, c, a)
    }
    if nr == drmuapi.NR_OBJ_GETPROPERTIES {
        return drmprops.get_object_properties(state, me, a)
    }
    if nr == drmuapi.NR_GETPROPERTY {
        return drmprop.get_property(state, me, a)
    }
    if nr == drmuapi.NR_GETPROPBLOB {
        return drmblob.get(state, me, a)
    }
    if nr == drmuapi.NR_GETPLANE {
        return kmsplane.get_plane(state, me, a)
    }
    if nr == drmuapi.NR_SETPLANE {
        return drmatomic.set_plane(state, c, a)
    }
    if nr == drmuapi.NR_ATOMIC {
        return drmatomic.atomic(state, me, c, a)
    }
    if nr == drmuapi.NR_CREATEPROPBLOB {
        return drmblob.create(state, me, c, a)
    }
    return drmblob.destroy(c, a)
}
