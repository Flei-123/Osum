profile kernel

import lib.errno
import sys.sysuser
import gfx.drm.drmuapi

export { version, get_unique, get_cap, set_client_cap }

const VERSION_MAJOR: u64 = 1
const VERSION_MINOR: u64 = 0
const PREFERRED_DEPTH: u64 = 24
const CLIENT_CAP_UNIVERSAL_PLANES: u64 = 2

static mut name_text: [u8; 4] = "osum"
static mut date_text: [u8; 8] = "20261115"
static mut desc_text: [u8; 8] = "Osum DRM"

fn put_text(state: u64, me: u64, a: u64, len_off: u64, src: u64, n: u64) -> bool {
    let room: u64 = drmuapi.r64(a + len_off)
    let dst: u64 = drmuapi.r64(a + len_off + 8)
    drmuapi.w64(a + len_off, n)
    if dst == 0 || room == 0 {
        return true
    }
    var k: u64 = n
    if k > room {
        k = room
    }
    return sysuser.copy_out(state, me, dst, src, k)
}

fn version(state: u64, me: u64, a: u64) -> u64 {
    drmuapi.w32(a, VERSION_MAJOR)
    drmuapi.w32(a + 4, VERSION_MINOR)
    drmuapi.w32(a + 8, 0)
    let ok: bool = put_text(state, me, a, 16, (&name_text[0]) as u64, 4)
        && put_text(state, me, a, 32, (&date_text[0]) as u64, 8)
        && put_text(state, me, a, 48, (&desc_text[0]) as u64, 8)
    if !ok {
        return errno.E_FAULT
    }
    return 0
}

fn get_unique(state: u64, me: u64, a: u64) -> u64 {
    drmuapi.w64(a, 0)
    return 0
}

fn cap_value(cap: u64) -> u64 {
    if cap == drmuapi.CAP_DUMB_BUFFER || cap == drmuapi.CAP_TIMESTAMP_MONOTONIC {
        return 1
    }
    if cap == drmuapi.CAP_DUMB_PREFERRED_DEPTH {
        return PREFERRED_DEPTH
    }
    if cap == drmuapi.CAP_DUMB_PREFER_SHADOW {
        return 0
    }
    return 0xFFFFFFFFFFFFFFFF
}

fn get_cap(state: u64, a: u64) -> u64 {
    let v: u64 = cap_value(drmuapi.r64(a))
    if v == 0xFFFFFFFFFFFFFFFF {
        return errno.E_INVAL
    }
    drmuapi.w64(a + 8, v)
    return 0
}

fn set_client_cap(state: u64, a: u64) -> u64 {
    if drmuapi.r64(a) == CLIENT_CAP_UNIVERSAL_PLANES && drmuapi.r64(a + 8) <= 1 {
        return 0
    }
    return errno.E_INVAL
}
