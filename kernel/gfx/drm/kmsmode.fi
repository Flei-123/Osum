profile kernel

import gfx.drm.drmuapi
import gfx.drm.kmsreg

export { SIZE, fill }

const SIZE: u64 = 68
const H_FRONT: u64 = 8
const H_SYNC: u64 = 32
const H_BLANK: u64 = 80
const V_FRONT: u64 = 1
const V_SYNC: u64 = 3
const V_BLANK: u64 = 20
const TYPE_PREFERRED_DRIVER: u64 = 0x48
const NAME_OFF: u64 = 36
const NAME_LEN: u64 = 32

fn put_dec(p: u64, at: u64, v: u64) -> u64 {
    var digits: [u8; 8] = [0 as u8; 8]
    var n: u64 = 0
    var x: u64 = v
    while n == 0 || (x != 0 && n < 8) {
        digits[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    var i: u64 = 0
    while i < n {
        *((p + at + i) as *mut u8) = digits[(n - 1 - i) as usize]
        i = i + 1
    }
    return at + n
}

fn put_name(p: u64, w: u64, h: u64) {
    var i: u64 = 0
    while i < NAME_LEN {
        *((p + NAME_OFF + i) as *mut u8) = 0 as u8
        i = i + 1
    }
    let at: u64 = put_dec(p + NAME_OFF, 0, w)
    *((p + NAME_OFF + at) as *mut u8) = 120 as u8
    let _end: u64 = put_dec(p + NAME_OFF, at + 1, h)
}

fn fill(state: u64, p: u64) {
    let w: u64 = kmsreg.width(state)
    let h: u64 = kmsreg.height(state)
    let hz: u64 = kmsreg.refresh(state)
    let htotal: u64 = w + H_BLANK
    let vtotal: u64 = h + V_BLANK
    drmuapi.w32(p, htotal * vtotal * hz / 1000)
    drmuapi.w16(p + 4, w)
    drmuapi.w16(p + 6, w + H_FRONT)
    drmuapi.w16(p + 8, w + H_FRONT + H_SYNC)
    drmuapi.w16(p + 10, htotal)
    drmuapi.w16(p + 12, 0)
    drmuapi.w16(p + 14, h)
    drmuapi.w16(p + 16, h + V_FRONT)
    drmuapi.w16(p + 18, h + V_FRONT + V_SYNC)
    drmuapi.w16(p + 20, vtotal)
    drmuapi.w16(p + 22, 0)
    drmuapi.w32(p + 24, hz)
    drmuapi.w32(p + 28, 0)
    drmuapi.w32(p + 32, TYPE_PREFERRED_DRIVER)
    put_name(p, w, h)
}
