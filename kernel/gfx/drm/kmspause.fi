profile kernel

import sync.atomic

export { hold, drop, held, take_resume }

static mut held_flag: u64 = 0
static mut resume_flag: u64 = 0

fn hold() {
    atomic.store((&held_flag) as u64, 1)
}

fn drop() {
    if atomic.cas((&held_flag) as u64, 1, 0) == 1 {
        atomic.store((&resume_flag) as u64, 1)
    }
}

fn held() -> bool {
    return atomic.load((&held_flag) as u64) != 0
}

fn take_resume() -> bool {
    return atomic.cas((&resume_flag) as u64, 1, 0) == 1
}
