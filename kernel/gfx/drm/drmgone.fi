profile kernel

import sync.atomic

export { MAX_CLIENTS, mark, take, mark_sync, take_sync }

const MAX_CLIENTS: u64 = 16

static mut gone: [u64; 16] = [0 as u64; 16]
static mut sync_gone: [u64; 64] = [0 as u64; 64]

fn mark(client: u64) {
    if client >= 1 && client <= MAX_CLIENTS {
        atomic.store((&gone[(client - 1) as usize]) as u64, 1)
    }
}

fn take(client: u64) -> bool {
    if client < 1 || client > MAX_CLIENTS {
        return false
    }
    let p: u64 = (&gone[(client - 1) as usize]) as u64
    return atomic.cas(p, 1, 0) == 1
}

fn mark_sync(obj: u64) {
    if obj < 64 {
        atomic.fetch_add((&sync_gone[obj as usize]) as u64, 1)
    }
}

fn take_sync(obj: u64) -> u64 {
    if obj >= 64 {
        return 0
    }
    let p: u64 = (&sync_gone[obj as usize]) as u64
    var v: u64 = atomic.load(p)
    while v != 0 {
        if atomic.cas(p, v, 0) == v {
            return v
        }
        v = atomic.load(p)
    }
    return 0
}
