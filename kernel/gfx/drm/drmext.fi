profile kernel

import lib.errno
import gfx.drm.drmuapi
import gfx.drm.drmprime
import gfx.drm.drmsync
import gfx.drm.drmsyncops
import gfx.drm.drmsyncwait
import gfx.drm.drmsyncfd
import gfx.drm.drmvbl
import gfx.drm.drmmodeext
import gfx.drm.drmsyncevent

export { owns, render_ok, needs_master, run }

fn is_sync(nr: u64) -> bool {
    return (nr >= drmuapi.NR_SYNCOBJ_CREATE && nr <= drmuapi.NR_SYNCOBJ_SIGNAL)
        || (nr >= drmuapi.NR_SYNCOBJ_TIMELINE_WAIT && nr <= drmuapi.NR_SYNCOBJ_TIMELINE_SIGNAL)
        || nr == drmuapi.NR_SYNCOBJ_EVENTFD
}

fn is_prime(nr: u64) -> bool {
    return nr == drmuapi.NR_PRIME_HANDLE_TO_FD || nr == drmuapi.NR_PRIME_FD_TO_HANDLE
}

fn is_vblank(nr: u64) -> bool {
    return nr >= drmuapi.NR_WAIT_VBLANK && nr <= drmuapi.NR_CRTC_QUEUE_SEQUENCE
}

fn needs_master(nr: u64) -> bool {
    return drmmodeext.needs_master(nr)
}

fn owns(nr: u64) -> bool {
    return is_sync(nr) || is_prime(nr) || is_vblank(nr) || drmmodeext.owns(nr)
}

fn render_ok(nr: u64) -> bool {
    return is_sync(nr) || is_prime(nr)
}

fn run_sync(state: u64, me: u64, c: u64, nr: u64, a: u64) -> u64 {
    if nr == drmuapi.NR_SYNCOBJ_CREATE {
        return drmsync.create(c, a)
    }
    if nr == drmuapi.NR_SYNCOBJ_DESTROY {
        return drmsync.destroy(c, a)
    }
    if nr == drmuapi.NR_SYNCOBJ_HANDLE_TO_FD {
        return drmsyncfd.handle_to_fd(state, me, c, a)
    }
    if nr == drmuapi.NR_SYNCOBJ_FD_TO_HANDLE {
        return drmsyncfd.fd_to_handle(state, me, c, a)
    }
    if nr == drmuapi.NR_SYNCOBJ_WAIT {
        return drmsyncwait.wait(state, me, c, a)
    }
    if nr == drmuapi.NR_SYNCOBJ_RESET {
        return drmsyncops.reset(state, me, c, a)
    }
    if nr == drmuapi.NR_SYNCOBJ_SIGNAL {
        return drmsyncops.signal(state, me, c, a)
    }
    if nr == drmuapi.NR_SYNCOBJ_TIMELINE_WAIT {
        return drmsyncwait.timeline_wait(state, me, c, a)
    }
    if nr == drmuapi.NR_SYNCOBJ_QUERY {
        return drmsyncops.query(state, me, c, a)
    }
    if nr == drmuapi.NR_SYNCOBJ_TRANSFER {
        return drmsyncops.transfer(state, me, c, a)
    }
    if nr == drmuapi.NR_SYNCOBJ_EVENTFD {
        return drmsyncevent.eventfd(state, me, c, a)
    }
    return drmsyncops.timeline_signal(state, me, c, a)
}

fn run(state: u64, me: u64, c: u64, nr: u64, a: u64) -> u64 {
    if is_sync(nr) {
        return run_sync(state, me, c, nr, a)
    }
    if nr == drmuapi.NR_PRIME_HANDLE_TO_FD {
        return drmprime.handle_to_fd(state, me, c, a)
    }
    if nr == drmuapi.NR_PRIME_FD_TO_HANDLE {
        return drmprime.fd_to_handle(state, me, c, a)
    }
    if drmmodeext.owns(nr) {
        return drmmodeext.run(state, me, c, nr, a)
    }
    if nr == drmuapi.NR_WAIT_VBLANK {
        return drmvbl.wait_vblank(state, c, a)
    }
    if nr == drmuapi.NR_CRTC_GET_SEQUENCE {
        return drmvbl.get_sequence(state, a)
    }
    return drmvbl.queue_sequence(state, c, a)
}
