profile kernel

import lib.errno
import gfx.drm.drmuapi
import gfx.drm.drmfb
import gfx.drm.kmsmode
import gfx.drm.kmsreg
import gfx.drm.drmevent
import gfx.drm.drmvblank

export { get_crtc, set_crtc, page_flip, dirty, fb_gone, current_fb }

const FLIP_EVENT: u64 = 1
const FLIP_ASYNC: u64 = 2
const FLIP_TARGET_ABSOLUTE: u64 = 4
const FLIP_TARGET_RELATIVE: u64 = 8
const FLIP_KNOWN: u64 = 15

static mut crtc_fb: u64 = 0

fn current_fb() -> u64 {
    return crtc_fb
}

fn show(state: u64, id: u64) -> u64 {
    let slot: u64 = drmfb.find(id)
    if slot == drmfb.NONE {
        return errno.E_NOENT
    }
    if !kmsreg.scanout(state, drmfb.shm_of(slot), drmfb.width_of(slot), drmfb.height_of(slot), drmfb.pitch_of(slot)) {
        return errno.E_NODEV
    }
    crtc_fb = id
    return 0
}

fn get_crtc(state: u64, a: u64) -> u64 {
    if !kmsreg.ready(state) || drmuapi.r32(a + 12) != drmuapi.CRTC_ID {
        return errno.E_NOENT
    }
    drmuapi.w32(a + 16, crtc_fb)
    drmuapi.w32(a + 20, 0)
    drmuapi.w32(a + 24, 0)
    drmuapi.w32(a + 28, 0)
    if crtc_fb == 0 {
        drmuapi.w32(a + 32, 0)
        return 0
    }
    drmuapi.w32(a + 32, 1)
    kmsmode.fill(state, a + 36)
    return 0
}

fn set_crtc(state: u64, a: u64) -> u64 {
    if !kmsreg.ready(state) || drmuapi.r32(a + 12) != drmuapi.CRTC_ID {
        return errno.E_NOENT
    }
    let id: u64 = drmuapi.r32(a + 16)
    if id == 0 {
        crtc_fb = 0
        kmsreg.release(state)
        return 0
    }
    if drmuapi.r32(a + 20) != 0 || drmuapi.r32(a + 24) != 0 {
        return errno.E_INVAL
    }
    return show(state, id)
}

fn flip_target(state: u64, flags: u64, requested: u64) -> u64 {
    let now: u64 = drmvblank.seq_now(state)
    if (flags & FLIP_TARGET_ABSOLUTE) != 0 {
        return requested
    }
    if (flags & FLIP_TARGET_RELATIVE) != 0 {
        return now + requested
    }
    return now + 1
}

fn page_flip(state: u64, c: u64, a: u64) -> u64 {
    let flags: u64 = drmuapi.r32(a + 8)
    if drmuapi.r32(a) != drmuapi.CRTC_ID || crtc_fb == 0 || (flags & ~FLIP_KNOWN) != 0 {
        return errno.E_INVAL
    }
    if (flags & FLIP_TARGET_ABSOLUTE) != 0 && (flags & FLIP_TARGET_RELATIVE) != 0 {
        return errno.E_INVAL
    }
    if (flags & FLIP_EVENT) != 0 && !drmevent.room(c) {
        return errno.E_BUSY
    }
    let r: u64 = show(state, drmuapi.r32(a + 4))
    if r != 0 || (flags & FLIP_EVENT) == 0 {
        return r
    }
    let target: u64 = flip_target(state, flags, drmuapi.r32(a + 12))
    let _queued: bool = drmevent.push(c, drmevent.TYPE_FLIP, drmuapi.r64(a + 16), target)
    return 0
}

fn dirty(state: u64, a: u64) -> u64 {
    let id: u64 = drmuapi.r32(a)
    if drmfb.find(id) == drmfb.NONE {
        return errno.E_NOENT
    }
    if id != crtc_fb {
        return 0
    }
    return show(state, id)
}

fn fb_gone(state: u64, id: u64) {
    if crtc_fb == id {
        crtc_fb = 0
        kmsreg.release(state)
    }
}
