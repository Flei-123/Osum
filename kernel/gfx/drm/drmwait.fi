profile kernel

export { RETRY, begin, resume, retry, wake_ns, next_resume }

const RETRY: u64 = 0x4000000000000000

static mut cur_resume: u64 = 0
static mut cur_wake: u64 = 0
static mut cur_next: u64 = 0

fn begin(res: u64) {
    cur_resume = res
    cur_wake = 0
    cur_next = 0
}

fn resume() -> u64 {
    return cur_resume
}

fn retry(wake: u64, res: u64) -> u64 {
    cur_wake = wake
    cur_next = res
    return RETRY
}

fn wake_ns() -> u64 {
    return cur_wake
}

fn next_resume() -> u64 {
    return cur_next
}
