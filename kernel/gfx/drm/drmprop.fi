profile kernel

import lib.errno
import sys.sysuser
import gfx.drm.drmuapi

export {
    COUNT, PLANE_FIRST, PLANE_COUNT, CRTC_FIRST, CONN_FIRST, KIND_PLANE, KIND_CRTC, KIND_CONN, KIND_ENCODER,
    P_TYPE, P_FB_ID, P_PLANE_CRTC_ID, P_SRC_X, P_SRC_Y, P_SRC_W, P_SRC_H, P_CRTC_X, P_CRTC_Y, P_CRTC_W, P_CRTC_H,
    P_ACTIVE, P_MODE_ID, P_DPMS, P_CONN_CRTC_ID, ID_BASE,
    kind_of, count_of, prop_at, index_of, belongs, get_property
}

const ID_BASE: u64 = 0x200
const COUNT: u64 = 15
const PLANE_FIRST: u64 = 0
const PLANE_COUNT: u64 = 11
const CRTC_FIRST: u64 = 11
const CONN_FIRST: u64 = 13
const KIND_PLANE: u64 = 1
const KIND_CRTC: u64 = 2
const KIND_CONN: u64 = 3
const KIND_ENCODER: u64 = 4

const P_TYPE: u64 = 0
const P_FB_ID: u64 = 1
const P_PLANE_CRTC_ID: u64 = 2
const P_SRC_X: u64 = 3
const P_SRC_Y: u64 = 4
const P_SRC_W: u64 = 5
const P_SRC_H: u64 = 6
const P_CRTC_X: u64 = 7
const P_CRTC_Y: u64 = 8
const P_CRTC_W: u64 = 9
const P_CRTC_H: u64 = 10
const P_ACTIVE: u64 = 11
const P_MODE_ID: u64 = 12
const P_DPMS: u64 = 13
const P_CONN_CRTC_ID: u64 = 14

const FLAG_RANGE: u64 = 2
const FLAG_IMMUTABLE: u64 = 4
const FLAG_ENUM: u64 = 8
const FLAG_BLOB: u64 = 16
const FLAG_OBJECT: u64 = 0x40
const FLAG_SIGNED_RANGE: u64 = 0x80
const FLAG_ATOMIC: u64 = 0x80000000

const OBJECT_FB: u64 = 0xFBFBFBFB
const OBJECT_CRTC: u64 = 0xCCCCCCCC
const MAX_U32: u64 = 0xFFFFFFFF
const MAX_S32: u64 = 0x7FFFFFFF
const MIN_S32: u64 = 0xFFFFFFFF80000000
const NAME_STRIDE: u64 = 8
const NAME_ROOM: u64 = 32
const ENUM_BYTES: u64 = 40
const ENUM_PLANE_FIRST: u64 = 0
const ENUM_PLANE_COUNT: u64 = 3
const ENUM_DPMS_FIRST: u64 = 3
const ENUM_DPMS_COUNT: u64 = 4

static mut prop_names: [u8; 120] = "type    FB_ID   CRTC_ID SRC_X   SRC_Y   SRC_W   SRC_H   CRTC_X  CRTC_Y  CRTC_W  CRTC_H  ACTIVE  MODE_ID DPMS    CRTC_ID "
static mut enum_names: [u8; 56] = "Overlay Primary Cursor  On      Standby Suspend Off     "
static mut enum_buf: [u8; 40] = [0 as u8; 40]

fn kind_of(id: u64) -> u64 {
    if id == drmuapi.PLANE_ID || id == drmuapi.CURSOR_PLANE_ID {
        return KIND_PLANE
    }
    if id == drmuapi.CRTC_ID {
        return KIND_CRTC
    }
    if id == drmuapi.CONNECTOR_ID {
        return KIND_CONN
    }
    if id == drmuapi.ENCODER_ID {
        return KIND_ENCODER
    }
    return 0
}

fn count_of(kind: u64) -> u64 {
    if kind == KIND_PLANE {
        return PLANE_COUNT
    }
    if kind == KIND_CRTC || kind == KIND_CONN {
        return 2
    }
    return 0
}

fn first_of(kind: u64) -> u64 {
    if kind == KIND_PLANE {
        return PLANE_FIRST
    }
    if kind == KIND_CRTC {
        return CRTC_FIRST
    }
    return CONN_FIRST
}

fn prop_at(kind: u64, i: u64) -> u64 {
    return ID_BASE + first_of(kind) + i
}

fn index_of(id: u64) -> u64 {
    if id < ID_BASE || id >= ID_BASE + COUNT {
        return COUNT
    }
    return id - ID_BASE
}

fn belongs(kind: u64, idx: u64) -> bool {
    let first: u64 = first_of(kind)
    return idx < COUNT && idx >= first && idx < first + count_of(kind)
}

fn flags_of(idx: u64) -> u64 {
    if idx == P_TYPE {
        return FLAG_ENUM | FLAG_IMMUTABLE
    }
    if idx == P_FB_ID || idx == P_PLANE_CRTC_ID || idx == P_CONN_CRTC_ID {
        return FLAG_OBJECT | FLAG_ATOMIC
    }
    if idx == P_CRTC_X || idx == P_CRTC_Y {
        return FLAG_SIGNED_RANGE | FLAG_ATOMIC
    }
    if idx == P_MODE_ID {
        return FLAG_BLOB | FLAG_ATOMIC
    }
    if idx == P_DPMS {
        return FLAG_ENUM
    }
    return FLAG_RANGE | FLAG_ATOMIC
}

fn is_enum(idx: u64) -> bool {
    return idx == P_TYPE || idx == P_DPMS
}

fn enum_first(idx: u64) -> u64 {
    if idx == P_TYPE {
        return ENUM_PLANE_FIRST
    }
    return ENUM_DPMS_FIRST
}

fn enum_count(idx: u64) -> u64 {
    if idx == P_TYPE {
        return ENUM_PLANE_COUNT
    }
    if idx == P_DPMS {
        return ENUM_DPMS_COUNT
    }
    return 0
}

fn value_count(idx: u64) -> u64 {
    let f: u64 = flags_of(idx)
    if is_enum(idx) {
        return enum_count(idx)
    }
    if (f & FLAG_BLOB) != 0 {
        return 0
    }
    if (f & FLAG_OBJECT) != 0 {
        return 1
    }
    return 2
}

fn range_min(idx: u64) -> u64 {
    if idx == P_CRTC_X || idx == P_CRTC_Y {
        return MIN_S32
    }
    return 0
}

fn range_max(idx: u64) -> u64 {
    if idx == P_ACTIVE {
        return 1
    }
    if idx >= P_SRC_X && idx <= P_SRC_H {
        return MAX_U32
    }
    return MAX_S32
}

fn value_at(idx: u64, n: u64) -> u64 {
    if is_enum(idx) {
        return n
    }
    if idx == P_FB_ID {
        return OBJECT_FB
    }
    if idx == P_PLANE_CRTC_ID || idx == P_CONN_CRTC_ID {
        return OBJECT_CRTC
    }
    if n == 0 {
        return range_min(idx)
    }
    return range_max(idx)
}

fn fill_name(dst: u64, base: u64, at: u64) {
    var i: u64 = 0
    var live: bool = true
    while i < NAME_ROOM {
        var ch: u64 = 0
        if live && i < NAME_STRIDE {
            ch = (*((base + at * NAME_STRIDE + i) as *mut u8)) as u64
            if ch == 32 {
                ch = 0
                live = false
            }
        }
        *((dst + i) as *mut u8) = ch as u8
        i = i + 1
    }
}

fn put_values(state: u64, me: u64, ptr: u64, idx: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if !sysuser.put64(state, me, ptr + i * 8, value_at(idx, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn put_enums(state: u64, me: u64, ptr: u64, idx: u64, n: u64) -> bool {
    let buf: u64 = (&enum_buf[0]) as u64
    let names: u64 = (&enum_names[0]) as u64
    var i: u64 = 0
    while i < n {
        drmuapi.w64(buf, i)
        fill_name(buf + 8, names, enum_first(idx) + i)
        if !sysuser.copy_out(state, me, ptr + i * ENUM_BYTES, buf, ENUM_BYTES) {
            return false
        }
        i = i + 1
    }
    return true
}

fn get_property(state: u64, me: u64, a: u64) -> u64 {
    let idx: u64 = index_of(drmuapi.r32(a + 16))
    if idx >= COUNT {
        return errno.E_NOENT
    }
    let nvals: u64 = value_count(idx)
    var nenums: u64 = 0
    if is_enum(idx) {
        nenums = enum_count(idx)
    }
    var ok: bool = true
    if drmuapi.r64(a) != 0 && drmuapi.r32(a + 56) >= nvals {
        ok = put_values(state, me, drmuapi.r64(a), idx, nvals)
    }
    if ok && nenums != 0 && drmuapi.r64(a + 8) != 0 && drmuapi.r32(a + 60) >= nenums {
        ok = put_enums(state, me, drmuapi.r64(a + 8), idx, nenums)
    }
    if !ok {
        return errno.E_FAULT
    }
    drmuapi.w32(a + 20, flags_of(idx))
    fill_name(a + 24, (&prop_names[0]) as u64, idx)
    drmuapi.w32(a + 56, nvals)
    drmuapi.w32(a + 60, nenums)
    return 0
}
