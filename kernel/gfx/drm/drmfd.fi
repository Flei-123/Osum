profile kernel

import lib.errno
import fs.file

export { FAIL, install }

const FAIL: u64 = 0x10000000000

fn install(state: u64, me: u64, kind: u64, ino: u64, flags: u64) -> u64 {
    let of: u64 = file.open_alloc(state, kind, ino, flags)
    if of >= file.MAX_OPEN {
        return FAIL | errno.E_NFILE
    }
    let fd: u64 = file.fd_alloc(state, me, 0)
    if fd >= file.MAX_FD {
        file.open_unref(state, of)
        return FAIL | errno.E_MFILE
    }
    file.fd_set(state, me, fd, of)
    return fd
}
