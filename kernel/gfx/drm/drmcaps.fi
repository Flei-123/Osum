profile kernel

export { UNIVERSAL_PLANES, ATOMIC, set, universal, atomic, drop }

const UNIVERSAL_PLANES: u64 = 2
const ATOMIC: u64 = 3
const MAX_CLIENTS: u64 = 16

static mut f_universal: [u64; 16] = [0 as u64; 16]
static mut f_atomic: [u64; 16] = [0 as u64; 16]

fn valid(client: u64) -> bool {
    return client >= 1 && client <= MAX_CLIENTS
}

fn set(client: u64, cap: u64, value: u64) -> bool {
    if !valid(client) || value > 1 {
        return false
    }
    let i: usize = (client - 1) as usize
    if cap == UNIVERSAL_PLANES {
        f_universal[i] = value
        return true
    }
    if cap == ATOMIC {
        f_atomic[i] = value
        if value == 1 {
            f_universal[i] = 1
        }
        return true
    }
    return false
}

fn universal(client: u64) -> bool {
    return valid(client) && f_universal[(client - 1) as usize] != 0
}

fn atomic(client: u64) -> bool {
    return valid(client) && f_atomic[(client - 1) as usize] != 0
}

fn drop(client: u64) {
    if valid(client) {
        f_universal[(client - 1) as usize] = 0
        f_atomic[(client - 1) as usize] = 0
    }
}
