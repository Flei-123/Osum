profile kernel

export {
    bind_ui, stage_graphics, stage_surface, stage_hold, board_tick, beat_tick, stall_tick, leser_tick, wm_on_key, wm_poll, crash, grace_ready, grace_soll, grace_core, grace_cold, parse, panikbild,
    H_STAGE_GRAPHICS, H_STAGE_SURFACE, H_STAGE_HOLD, H_BOARD_TICK, H_BEAT_TICK, H_STALL_TICK, H_LESER_TICK, H_WM_ON_KEY, H_WM_POLL, H_CRASH, H_GRACE_READY, H_GRACE_SOLL, H_GRACE_CORE, H_GRACE_COLD, H_PARSE, H_PANIKBILD
}

const H_STAGE_GRAPHICS: u64 = 0
const H_STAGE_SURFACE: u64 = 1
const H_STAGE_HOLD: u64 = 2
const H_BOARD_TICK: u64 = 3
const H_BEAT_TICK: u64 = 4
const H_STALL_TICK: u64 = 5
const H_LESER_TICK: u64 = 6
const H_WM_ON_KEY: u64 = 7
const H_WM_POLL: u64 = 8
const H_CRASH: u64 = 9
const H_GRACE_READY: u64 = 10
const H_GRACE_SOLL: u64 = 11
const H_GRACE_CORE: u64 = 12
const H_GRACE_COLD: u64 = 13
const H_PARSE: u64 = 14
const H_PANIKBILD: u64 = 15
const H_COUNT: u64 = 16

static mut table: [u64; 16] = [0 as u64; 16]

fn bind_ui(slot: u64, handler: u64) {
    if slot < H_COUNT {
        table[slot as usize] = handler
    }
}

fn stage_graphics(state: u64, mbi: u64) {
    let handler: u64 = table[H_STAGE_GRAPHICS as usize]
    if handler == 0 {
        return
    }
    let call: fn(u64, u64) = handler as fn(u64, u64)
    call(state, mbi)
}

fn stage_surface(state: u64) {
    let handler: u64 = table[H_STAGE_SURFACE as usize]
    if handler == 0 {
        return
    }
    let call: fn(u64) = handler as fn(u64)
    call(state)
}

fn stage_hold(state: u64) {
    let handler: u64 = table[H_STAGE_HOLD as usize]
    if handler == 0 {
        return
    }
    let call: fn(u64) = handler as fn(u64)
    call(state)
}

fn board_tick(state: u64) {
    let handler: u64 = table[H_BOARD_TICK as usize]
    if handler == 0 {
        return
    }
    let call: fn(u64) = handler as fn(u64)
    call(state)
}

fn beat_tick(state: u64) {
    let handler: u64 = table[H_BEAT_TICK as usize]
    if handler == 0 {
        return
    }
    let call: fn(u64) = handler as fn(u64)
    call(state)
}

fn stall_tick(state: u64) {
    let handler: u64 = table[H_STALL_TICK as usize]
    if handler == 0 {
        return
    }
    let call: fn(u64) = handler as fn(u64)
    call(state)
}

fn leser_tick(state: u64) {
    let handler: u64 = table[H_LESER_TICK as usize]
    if handler == 0 {
        return
    }
    let call: fn(u64) = handler as fn(u64)
    call(state)
}

fn wm_on_key(state: u64, c: u64) {
    let handler: u64 = table[H_WM_ON_KEY as usize]
    if handler == 0 {
        return
    }
    let call: fn(u64, u64) = handler as fn(u64, u64)
    call(state, c)
}

fn wm_poll(state: u64) -> bool {
    let handler: u64 = table[H_WM_POLL as usize]
    if handler == 0 {
        return false
    }
    let call: fn(u64) -> bool = handler as fn(u64) -> bool
    return call(state)
}

fn crash(state: u64, vec: u64, err: u64, rip: u64, cr2: u64, rsp: u64, cs: u64, kern: u64, trace: u64, spurn: u64, gestoppt: u64) {
    let handler: u64 = table[H_CRASH as usize]
    if handler == 0 {
        return
    }
    let call: fn(u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = handler as fn(u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64)
    call(state, vec, err, rip, cr2, rsp, cs, kern, trace, spurn, gestoppt)
}

fn grace_ready(state: u64) -> u64 {
    let handler: u64 = table[H_GRACE_READY as usize]
    if handler == 0 {
        return 0
    }
    let call: fn(u64) -> u64 = handler as fn(u64) -> u64
    return call(state)
}

fn grace_soll(state: u64, index: u64) -> u64 {
    let handler: u64 = table[H_GRACE_SOLL as usize]
    if handler == 0 {
        return 0
    }
    let call: fn(u64, u64) -> u64 = handler as fn(u64, u64) -> u64
    return call(state, index)
}

fn grace_core(state: u64, index: u64, runden: u64, soll: u64) -> u64 {
    let handler: u64 = table[H_GRACE_CORE as usize]
    if handler == 0 {
        return 0
    }
    let call: fn(u64, u64, u64, u64) -> u64 = handler as fn(u64, u64, u64, u64) -> u64
    return call(state, index, runden, soll)
}

fn grace_cold(state: u64) {
    let handler: u64 = table[H_GRACE_COLD as usize]
    if handler == 0 {
        return
    }
    let call: fn(u64) = handler as fn(u64)
    call(state)
}

fn parse(state: u64, cmd: u64) {
    let handler: u64 = table[H_PARSE as usize]
    if handler == 0 {
        return
    }
    let call: fn(u64, u64) = handler as fn(u64, u64)
    call(state, cmd)
}

fn panikbild(state: u64, vec: u64, err: u64, rip: u64, cr2: u64, rsp: u64, cs: u64, flg: u64, ss: u64, kern: u64, regs: u64, trace: u64, spurn: u64, cur_file: u64) {
    let handler: u64 = table[H_PANIKBILD as usize]
    if handler == 0 {
        return
    }
    let call: fn(u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) = handler as fn(u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64)
    call(state, vec, err, rip, cr2, rsp, cs, flg, ss, kern, regs, trace, spurn, cur_file)
}
