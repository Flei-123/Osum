// SPDX-License-Identifier: GPL-2.0-only
// kernel/hidrep.fi -- Runde HID: DER ZERLEGER FUER BERICHTSBESCHREIBUNGEN.
//
// Bis zu dieser Runde konnte Osum genau zwei HID-Geraete: eine Tastatur
// und eine Maus, beide im BOOT-PROTOKOLL. Das Boot-Protokoll ist eine
// Abmachung aus der Zeit, als ein BIOS eine USB-Tastatur bedienen
// koennen musste, ohne einen Zerleger zu haben: acht Oktett Tastatur,
// drei oder vier Oktett Maus, die Bedeutung jedes Bits steht in der
// Spezifikation und nicht im Geraet.
//
// JEDES ANDERE HID-GERAET SAGT SELBST, WIE SEINE BERICHTE AUSSEHEN.
// Es liefert eine BERICHTSBESCHREIBUNG -- eine Folge von Posten, aus
// der hervorgeht, welches Bit welches Feld ist, was das Feld bedeutet
// (Gebrauchsseite und Gebrauch), wie gross es ist und welchen
// Wertebereich es hat. Wer die lesen kann, braucht fuer das naechste
// Geraet keinen neuen Treiber. Wer sie nicht lesen kann, hat auf einem
// gewoehnlichen Laptop von 2026 GAR KEINE EINGABE: dort haengen
// Tastatur und Touchpad an I2C-HID, und ein Praezisions-Touchpad meldet
// ausschliesslich ueber seine Berichtsbeschreibung.
//
// ------------------------------------------------------- DIE POSTEN
//
// Ein KURZER POSTEN ist ein Kopfoktett plus 0, 1, 2 oder 4 Datenoktette:
//
//     Bit 0..1  bSize   0,1,2 -> so viele Oktette, 3 -> VIER
//     Bit 2..3  bType   0 Haupt, 1 Global, 2 Lokal, 3 vorbehalten
//     Bit 4..7  bTag    welcher Posten
//
// Ein LANGER POSTEN faengt mit 0xFE an. Es gibt bis heute keinen
// vergebenen langen Posten; hier wird er als DEFINIERTER FEHLER
// abgelehnt (E_LONG) und nicht stillschweigend uebersprungen -- wer ihn
// ueberspringt, verschiebt alle folgenden Bitlagen und liest danach
// jedes Feld falsch.
//
// HAUPTPOSTEN (bType 0):
//     0x8 Eingabe      erzeugt Felder in einem Eingabebericht
//     0x9 Ausgabe      erzeugt Felder in einem Ausgabebericht
//     0xB Eigenschaft  erzeugt Felder in einem Eigenschaftsbericht
//     0xA Sammlung     macht eine Sammlung auf
//     0xC Sammlungsende
//
// GLOBALE POSTEN (bType 1) gelten weiter, bis sie neu gesetzt werden:
//     0x0 Gebrauchsseite  0x1 log. Minimum   0x2 log. Maximum
//     0x3 phys. Minimum   0x4 phys. Maximum  0x5 Einheitenexponent
//     0x6 Einheit         0x7 Berichtsgroesse 0x8 Berichtsnummer
//     0x9 Berichtsanzahl  0xA Ablegen (Push) 0xB Holen (Pop)
//
// LOKALE POSTEN (bType 2) gelten NUR bis zum naechsten Hauptposten:
//     0x0 Gebrauch  0x1 Gebrauch-Minimum  0x2 Gebrauch-Maximum
//
// DAS IST DIE STELLE, AN DER DIE MEISTEN ZERLEGER FALSCH SIND: die
// lokalen Posten werden nach JEDEM Hauptposten geloescht, auch nach
// einer Sammlung und einem Sammlungsende, die globalen NICHT. Wer die
// lokalen stehen laesst, gibt dem naechsten Feld den Gebrauch des
// vorigen -- und dann meldet ein Touchpad die y-Achse als x.
//
// ------------------------------------------ WAS HERAUSKOMMT: FELDER
//
// Aus der Beschreibung wird EINE TABELLE, und ab da interessiert die
// Beschreibung niemanden mehr. Ein Feldeintrag sagt: in welchem Bericht
// (Berichtsnummer), welcher Art (Eingabe/Ausgabe/Eigenschaft), ab
// welchem BIT, wie viele Bit breit, wie oft hintereinander, welche
// Gebrauchsseite, welcher Gebrauch, und welchen Wertebereich.
//
// DIE BITLAGE ZAEHLT AB DEM ERSTEN OKTETT NACH DER BERICHTSNUMMER.
// Benutzt ein Geraet ueberhaupt keine Berichtsnummern (kein Posten
// 0x85), steht kein Nummernoktett im Bericht und die Lage zaehlt ab
// Oktett 0. Das ist keine Auslegungssache: die Spezifikation sagt, das
// Nummernoktett gehoert nicht zum Bericht.
//
// ZWEI FELDER WERDEN ZUSAMMENGEFASST, und das ist kein Sparen, sondern
// die Zusage, an der `hidin.fi` haengt: EIN EINTRAG MIT ANZAHL > 1 UND
// GESETZTEM VARIABEL-BIT BEDEUTET AUFEINANDERFOLGENDE GEBRAEUCHE ab
// F_USAGE. Damit werden aus "Knopf 1 bis Knopf 5" ein Eintrag statt
// fuenf, und aus den 120 Bit einer Tastatur ohne Anschlagsgrenze
// (NKRO) ein Eintrag statt hundertzwanzig. Wo die Gebraeuche NICHT
// aufeinanderfolgen (ein Touchpad zaehlt Zuversicht 0x47 und
// Spitzenschalter 0x42 nebeneinander auf), gibt es einen Eintrag JE
// GEBRAUCH -- sonst waere die Zusage gelogen.
//
// ------------------------------------------------- WAS NICHT PASSIERT
//
// KEIN ABSTURZ AN EINER KAPUTTEN BESCHREIBUNG. Eine Beschreibung kommt
// von einem Geraet, das jemand angesteckt hat; sie ist Eingabe von
// aussen und wird wie Eingabe von aussen behandelt. Abgeschnitten,
// Sammlung nie geschlossen, Sammlungsende ohne Sammlung, Holen ohne
// Ablegen, Berichtsgroesse 255, mehr Felder als Platz -- fuer jeden
// dieser Faelle gibt es EINE Fehlernummer, die Stelle im Oktettstrom
// steht daneben, und kein Zugriff geht neben den Puffer. Die
// Gegenprobe dazu faehrt `tools/hid/run.sh`.

profile kernel

import kstate
import serial
import hidtest

export {
    parse, reset, ok, err, errpos, fields, nrid, hasid, top_usage, kind,
    dlen, items, maxdepth,
    f_rid, f_kind, f_flags, f_bitoff, f_bitsz, f_count, f_page,
    f_usage, f_umax, f_lmin, f_lmax,
    rid_at, rid_inbits, rid_outbits, rid_featbits, in_bytes_of,
    raw_of, RAW_MAX, MAX_DEV, MAX_FIELDS, MAX_RIDS,
    E_OK, E_TRUNC, E_NEST, E_FIELDS, E_RIDS, E_PUSH, E_SIZE, E_USAGE,
    E_LONG, E_EMPTY, E_BIG,
    KIND_IN, KIND_OUT, KIND_FEAT,
    K_KBD, K_MOUSE, K_PAD, K_CONSUMER,
    FL_CONST, FL_VAR, FL_REL,
    UP_DESKTOP, UP_KEYBOARD, UP_LED, UP_BUTTON, UP_CONSUMER, UP_DIGITIZER,
    US_X, US_Y, US_WHEEL, US_TIPSW, US_CONTACTID, US_CONTACTCOUNT,
    US_CONFIDENCE, US_SCANTIME, US_ACPAN,
    say, say_as, say_fields, selbsttest
}

// ------------------------------------------------------- der Speicher
//
// Neun Seiten aus dem Rest, den `kstate.fi` nach Merge 2 als frei
// ausweist (0x92000..0xA0000, 56 KiB). Diese Datei nimmt sechs davon,
// `hidin.fi` eine und `i2chid.fi` zwei; eingetragen in
// `tools/kernel/memmap.py`, damit der Kartenpruefer die naechste Runde
// warnt statt sie auf dieselbe Adresse laufen zu lassen.
const FLD_OFF: u64 = 0x92000 // Feldtabellen, MAX_DEV * 0x1000
const SUM_OFF: u64 = 0x96000 // Kopfsaetze, MAX_DEV * SUM_BYTES
const RAW_OFF: u64 = 0x97000 // die rohen Beschreibungen, MAX_DEV * RAW_MAX

const MAX_DEV: u64 = 4
const MAX_FIELDS: u64 = 64
const FLD_BYTES: u64 = 64
const SUM_BYTES: u64 = 1024
const RAW_MAX: u64 = 1024
const MAX_RIDS: u64 = 16
const MAX_USAGES: u64 = 32
const MAX_DEPTH: u64 = 8
const MAX_PUSH: u64 = 8

// Ein Feldeintrag, acht Woerter.
const F_HEAD: u64 = 0 // Nummer | Art << 8 | Merker << 16
const F_BITOFF: u64 = 8
const F_BITSZ: u64 = 16
const F_COUNT: u64 = 24
const F_PAGE: u64 = 32
const F_USAGE: u64 = 40 // Gebrauch unten 32 Bit, Gebrauch-Max oben 32 Bit
const F_LMIN: u64 = 48 // vorzeichenerweitert auf 64 Bit
const F_LMAX: u64 = 56

// Der Kopfsatz je Geraet.
const S_OK: u64 = 0x00
const S_ERR: u64 = 0x08
const S_ERRPOS: u64 = 0x10
const S_NF: u64 = 0x18
const S_NRID: u64 = 0x20
const S_HASID: u64 = 0x28
const S_TOP: u64 = 0x30 // Seite << 16 | Gebrauch der ersten Sammlung
const S_KIND: u64 = 0x38 // Bitkarte: was in dieser Beschreibung steht
const S_LEN: u64 = 0x40
const S_ITEMS: u64 = 0x48
const S_DEPTH: u64 = 0x50
const S_RIDTAB: u64 = 0x100 // MAX_RIDS Eintraege zu 32 Oktett

const R_ID: u64 = 0
const R_IN: u64 = 8
const R_OUT: u64 = 16
const R_FEAT: u64 = 24
const R_BYTES: u64 = 32

// Die Fehlernummern. Jede steht fuer GENAU EINE Art, kaputt zu sein.
const E_OK: u64 = 0
const E_TRUNC: u64 = 1 // ein Posten reicht ueber das Ende hinaus
const E_NEST: u64 = 2 // Sammlung nie geschlossen, Ende ohne Anfang, zu tief
const E_FIELDS: u64 = 3 // mehr Felder als die Tabelle fasst
const E_RIDS: u64 = 4 // mehr Berichtsnummern als die Tabelle fasst
const E_PUSH: u64 = 5 // Ablegen zu tief oder Holen ohne Ablegen
const E_SIZE: u64 = 6 // unsinnige Berichtsgroesse oder -anzahl
const E_USAGE: u64 = 7 // mehr lokale Gebraeuche als Platz
const E_LONG: u64 = 8 // langer Posten -- es gibt keinen vergebenen
const E_EMPTY: u64 = 9 // Laenge 0 oder groesser als der Puffer
const E_BIG: u64 = 10 // ein Bericht waere groesser als ein Puffer

const KIND_IN: u64 = 1
const KIND_OUT: u64 = 2
const KIND_FEAT: u64 = 3

// Die Merker eines Eingabe-/Ausgabe-/Eigenschaftspostens.
const FL_CONST: u64 = 1
const FL_VAR: u64 = 2
const FL_REL: u64 = 4

// Gebrauchsseiten, die dieser Kernel benennt.
const UP_DESKTOP: u64 = 0x01
const UP_KEYBOARD: u64 = 0x07
const UP_LED: u64 = 0x08
const UP_BUTTON: u64 = 0x09
const UP_CONSUMER: u64 = 0x0C
const UP_DIGITIZER: u64 = 0x0D

// Gebraeuche, auf die `hidin.fi` und `i2chid.fi` sich berufen.
const US_X: u64 = 0x30
const US_Y: u64 = 0x31
const US_WHEEL: u64 = 0x38
const US_ACPAN: u64 = 0x0238 // Gebrauchsseite Verbraucher: waagrechtes Rollen
const US_TIPSW: u64 = 0x42
const US_CONFIDENCE: u64 = 0x47
const US_CONTACTID: u64 = 0x51
const US_CONTACTCOUNT: u64 = 0x54
const US_SCANTIME: u64 = 0x56

// Die Bitkarte der Geraetearten in EINER Beschreibung. Ein Laptop
// meldet oft Tastatur UND Verbrauchersteuerung unter einer Kennung;
// deshalb eine Karte und kein einzelner Wert.
const K_KBD: u64 = 1
const K_MOUSE: u64 = 2
const K_PAD: u64 = 4
const K_CONSUMER: u64 = 8

// ------------------------------------------------------ die Zugriffe

fn sum(state: u64, dev: u64) -> u64 {
    return state + SUM_OFF + dev * SUM_BYTES
}

fn sg(state: u64, dev: u64, off: u64) -> u64 {
    return kstate.get(sum(state, dev), off)
}

fn ss(state: u64, dev: u64, off: u64, v: u64) {
    kstate.set(sum(state, dev), off, v)
}

fn fld(state: u64, dev: u64, i: u64) -> u64 {
    return state + FLD_OFF + dev * 0x1000 + i * FLD_BYTES
}

fn fg(state: u64, dev: u64, i: u64, off: u64) -> u64 {
    return kstate.get(fld(state, dev, i), off)
}

fn fs(state: u64, dev: u64, i: u64, off: u64, v: u64) {
    kstate.set(fld(state, dev, i), off, v)
}

fn rid_ent(state: u64, dev: u64, i: u64) -> u64 {
    return sum(state, dev) + S_RIDTAB + i * R_BYTES
}

// Der Platz fuer die ROHE Beschreibung. Wer sie zerlegt, will sie
// hinterher noch einmal ansehen koennen -- und `tools/hid/run.sh`
// vergleicht die Zahl der Oktette, die wirklich geholt wurden.
fn raw_of(state: u64, dev: u64) -> u64 {
    return state + RAW_OFF + dev * RAW_MAX
}

// ------------------------------------------------------- das Ergebnis

fn ok(state: u64, dev: u64) -> bool {
    if dev >= MAX_DEV {
        return false
    }
    return sg(state, dev, S_OK) == 1
}

fn err(state: u64, dev: u64) -> u64 {
    if dev >= MAX_DEV {
        return E_EMPTY
    }
    return sg(state, dev, S_ERR)
}

fn errpos(state: u64, dev: u64) -> u64 {
    return sg(state, dev, S_ERRPOS)
}

fn fields(state: u64, dev: u64) -> u64 {
    if dev >= MAX_DEV {
        return 0
    }
    return sg(state, dev, S_NF)
}

fn nrid(state: u64, dev: u64) -> u64 {
    return sg(state, dev, S_NRID)
}

fn hasid(state: u64, dev: u64) -> bool {
    return sg(state, dev, S_HASID) == 1
}

fn top_usage(state: u64, dev: u64) -> u64 {
    return sg(state, dev, S_TOP)
}

fn kind(state: u64, dev: u64) -> u64 {
    if dev >= MAX_DEV {
        return 0
    }
    return sg(state, dev, S_KIND)
}

fn dlen(state: u64, dev: u64) -> u64 {
    return sg(state, dev, S_LEN)
}

fn items(state: u64, dev: u64) -> u64 {
    return sg(state, dev, S_ITEMS)
}

fn maxdepth(state: u64, dev: u64) -> u64 {
    return sg(state, dev, S_DEPTH)
}

fn f_rid(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_HEAD) & 0xFF
}

fn f_kind(state: u64, dev: u64, i: u64) -> u64 {
    return (fg(state, dev, i, F_HEAD) >> 8) & 0xFF
}

fn f_flags(state: u64, dev: u64, i: u64) -> u64 {
    return (fg(state, dev, i, F_HEAD) >> 16) & 0xFFFF
}

fn f_bitoff(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_BITOFF)
}

fn f_bitsz(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_BITSZ)
}

fn f_count(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_COUNT)
}

fn f_page(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_PAGE)
}

fn f_usage(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_USAGE) & 0xFFFFFFFF
}

fn f_umax(state: u64, dev: u64, i: u64) -> u64 {
    return (fg(state, dev, i, F_USAGE) >> 32) & 0xFFFFFFFF
}

fn f_lmin(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_LMIN)
}

fn f_lmax(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_LMAX)
}

fn rid_at(state: u64, dev: u64, i: u64) -> u64 {
    if i >= MAX_RIDS {
        return 0
    }
    return kstate.get(rid_ent(state, dev, i), R_ID)
}

fn rid_inbits(state: u64, dev: u64, i: u64) -> u64 {
    if i >= MAX_RIDS {
        return 0
    }
    return kstate.get(rid_ent(state, dev, i), R_IN)
}

fn rid_outbits(state: u64, dev: u64, i: u64) -> u64 {
    if i >= MAX_RIDS {
        return 0
    }
    return kstate.get(rid_ent(state, dev, i), R_OUT)
}

fn rid_featbits(state: u64, dev: u64, i: u64) -> u64 {
    if i >= MAX_RIDS {
        return 0
    }
    return kstate.get(rid_ent(state, dev, i), R_FEAT)
}

// Wie viele Oktett ein Eingabebericht dieser Nummer hat, OHNE das
// Nummernoktett. Aufgerundet, weil ein Bericht immer ganze Oktette
// belegt -- ein Touchpad mit 7 Bit Kontaktzahl und 1 Bit Knopf hat ein
// volles Oktett dafuer.
fn in_bytes_of(state: u64, dev: u64, rid: u64) -> u64 {
    var i: u64 = 0
    let n: u64 = sg(state, dev, S_NRID)
    while i < n {
        if kstate.get(rid_ent(state, dev, i), R_ID) == rid {
            let b: u64 = kstate.get(rid_ent(state, dev, i), R_IN)
            return (b + 7) / 8
        }
        i = i + 1
    }
    return 0
}

// ------------------------------------------------------- das Zerlegen

fn reset(state: u64, dev: u64) {
    if dev >= MAX_DEV {
        return
    }
    var i: u64 = 0
    while i < SUM_BYTES / 8 {
        kstate.set(sum(state, dev), i * 8, 0)
        i = i + 1
    }
}

// Vorzeichen erweitern. Ein logisches Minimum von -127 steht als 0x81
// in EINEM Oktett; ohne diese Erweiterung ist es 129 und jedes Feld
// gilt als vorzeichenlos.
fn sx(v: u64, n: u64) -> u64 {
    if n == 1 {
        if (v & 0x80) != 0 {
            return v | 0xFFFFFFFFFFFFFF00
        }
        return v & 0xFF
    }
    if n == 2 {
        if (v & 0x8000) != 0 {
            return v | 0xFFFFFFFFFFFF0000
        }
        return v & 0xFFFF
    }
    if n == 4 {
        if (v & 0x80000000) != 0 {
            return v | 0xFFFFFFFF00000000
        }
        return v & 0xFFFFFFFF
    }
    return 0
}

// Einen Platz fuer diese Berichtsnummer finden oder anlegen. Gibt
// MAX_RIDS zurueck, wenn kein Platz mehr da ist -- der Aufrufer macht
// daraus E_RIDS.
fn rid_slot(state: u64, dev: u64, rid: u64) -> u64 {
    var i: u64 = 0
    let n: u64 = sg(state, dev, S_NRID)
    while i < n {
        if kstate.get(rid_ent(state, dev, i), R_ID) == rid {
            return i
        }
        i = i + 1
    }
    if n >= MAX_RIDS {
        return MAX_RIDS
    }
    kstate.set(rid_ent(state, dev, n), R_ID, rid)
    kstate.set(rid_ent(state, dev, n), R_IN, 0)
    kstate.set(rid_ent(state, dev, n), R_OUT, 0)
    kstate.set(rid_ent(state, dev, n), R_FEAT, 0)
    ss(state, dev, S_NRID, n + 1)
    return n
}

fn bitpos_get(state: u64, dev: u64, slot: u64, kd: u64) -> u64 {
    if kd == KIND_IN {
        return kstate.get(rid_ent(state, dev, slot), R_IN)
    }
    if kd == KIND_OUT {
        return kstate.get(rid_ent(state, dev, slot), R_OUT)
    }
    return kstate.get(rid_ent(state, dev, slot), R_FEAT)
}

fn bitpos_set(state: u64, dev: u64, slot: u64, kd: u64, v: u64) {
    if kd == KIND_IN {
        kstate.set(rid_ent(state, dev, slot), R_IN, v)
        return
    }
    if kd == KIND_OUT {
        kstate.set(rid_ent(state, dev, slot), R_OUT, v)
        return
    }
    kstate.set(rid_ent(state, dev, slot), R_FEAT, v)
}

// Einen Feldeintrag schreiben. false = die Tabelle ist voll.
fn put(state: u64, dev: u64, rid: u64, kd: u64, flags: u64, bitoff: u64,
    bitsz: u64, cnt: u64, page: u64, usage: u64, umax: u64,
    lmin: u64, lmax: u64) -> bool {
    let i: u64 = sg(state, dev, S_NF)
    if i >= MAX_FIELDS {
        return false
    }
    fs(state, dev, i, F_HEAD,
        (rid & 0xFF) | ((kd & 0xFF) << 8) | ((flags & 0xFFFF) << 16))
    fs(state, dev, i, F_BITOFF, bitoff)
    fs(state, dev, i, F_BITSZ, bitsz)
    fs(state, dev, i, F_COUNT, cnt)
    fs(state, dev, i, F_PAGE, page)
    fs(state, dev, i, F_USAGE, (usage & 0xFFFFFFFF) | ((umax & 0xFFFFFFFF) << 32))
    fs(state, dev, i, F_LMIN, lmin)
    fs(state, dev, i, F_LMAX, lmax)
    ss(state, dev, S_NF, i + 1)
    return true
}

// Aus der Gebrauchsseite und dem Gebrauch einer Sammlung auf der
// obersten Ebene die Geraeteart ableiten. Nur die obersten Sammlungen
// zaehlen -- eine physische Sammlung "Zeiger" INNERHALB einer Maus
// macht daraus kein zweites Geraet.
fn kind_of(page: u64, usage: u64) -> u64 {
    if page == UP_DESKTOP {
        if usage == 0x06 {
            return K_KBD
        }
        if usage == 0x02 {
            return K_MOUSE
        }
    }
    if page == UP_DIGITIZER {
        // 0x05 Touchpad, 0x04 Beruehrungsschirm.
        if usage == 0x05 || usage == 0x04 {
            return K_PAD
        }
    }
    if page == UP_CONSUMER {
        if usage == 0x01 {
            return K_CONSUMER
        }
    }
    return 0
}

fn fail(state: u64, dev: u64, code: u64, pos: u64) -> u64 {
    ss(state, dev, S_OK, 0)
    ss(state, dev, S_ERR, code)
    ss(state, dev, S_ERRPOS, pos)
    return code
}

// ----------------------------------------------------------------------
// DIE HAUPTSCHLEIFE.
//
// `buf` zeigt auf `len` Oktette Berichtsbeschreibung, `dev` ist der
// Platz, in den das Ergebnis geht. Rueckgabe ist E_OK oder eine der
// Fehlernummern; im Fehlerfall steht die Stelle im Oktettstrom in
// `errpos`, und was bis dahin erkannt wurde, bleibt lesbar stehen --
// das ist beim Suchen mehr wert als eine geloeschte Tabelle.
fn parse(state: u64, dev: u64, buf: u64, len: u64) -> u64 {
    if dev >= MAX_DEV {
        return E_EMPTY
    }
    reset(state, dev)
    ss(state, dev, S_LEN, len)
    if len == 0 || len > RAW_MAX {
        return fail(state, dev, E_EMPTY, 0)
    }

    // Die globalen Posten. Reihenfolge wie die Tags, damit Ablegen und
    // Holen eine Schleife sind und keine zwoelf Zuweisungen.
    var gl: [u64; 10] = [0 as u64; 10]
    var stk: [u64; 80] = [0 as u64; 80]
    var sp: u64 = 0

    // Die lokalen Posten.
    var ul: [u64; 32] = [0 as u64; 32]
    var nu: u64 = 0
    var umin: u64 = 0
    var umax: u64 = 0
    var range: bool = false

    var p: u64 = 0
    var depth: u64 = 0
    var maxd: u64 = 0
    var nitems: u64 = 0
    var karte: u64 = 0

    while p < len {
        let start: u64 = p
        let b0: u64 = kstate.get8(buf + p)
        p = p + 1
        if b0 == 0xFE {
            return fail(state, dev, E_LONG, start)
        }
        var bsize: u64 = b0 & 3
        if bsize == 3 {
            bsize = 4
        }
        let btype: u64 = (b0 >> 2) & 3
        let btag: u64 = (b0 >> 4) & 0xF
        if p + bsize > len {
            return fail(state, dev, E_TRUNC, start)
        }
        var data: u64 = 0
        var k: u64 = 0
        while k < bsize {
            data = data | (kstate.get8(buf + p + k) << (k * 8))
            k = k + 1
        }
        p = p + bsize
        nitems = nitems + 1

        // ------------------------------------------------ GLOBAL
        if btype == 1 {
            if btag == 0 {
                gl[0 as usize] = data & 0xFFFF
            }
            if btag == 1 {
                gl[1 as usize] = sx(data, bsize)
            }
            if btag == 2 {
                // Das logische Maximum wird NUR dann vorzeichenerweitert,
                // wenn das Minimum negativ ist. Sonst waere ein Maximum
                // von 255 in einem Oktett ploetzlich -1 -- und genau
                // daran scheitern Zerleger an Touchpads, deren Achsen
                // bis 0xFFFF gehen.
                if (gl[1 as usize] >> 63) != 0 {
                    gl[2 as usize] = sx(data, bsize)
                } else {
                    gl[2 as usize] = data
                }
            }
            if btag == 3 {
                gl[3 as usize] = sx(data, bsize)
            }
            if btag == 4 {
                gl[4 as usize] = sx(data, bsize)
            }
            if btag == 5 {
                gl[5 as usize] = data
            }
            if btag == 6 {
                gl[6 as usize] = data
            }
            if btag == 7 {
                gl[7 as usize] = data
            }
            if btag == 8 {
                if data == 0 || data > 255 {
                    return fail(state, dev, E_SIZE, start)
                }
                gl[8 as usize] = data
                ss(state, dev, S_HASID, 1)
            }
            if btag == 9 {
                gl[9 as usize] = data
            }
            if btag == 10 {
                if sp >= MAX_PUSH {
                    return fail(state, dev, E_PUSH, start)
                }
                var q: u64 = 0
                while q < 10 {
                    stk[(sp * 10 + q) as usize] = gl[q as usize]
                    q = q + 1
                }
                sp = sp + 1
            }
            if btag == 11 {
                if sp == 0 {
                    return fail(state, dev, E_PUSH, start)
                }
                sp = sp - 1
                var q2: u64 = 0
                while q2 < 10 {
                    gl[q2 as usize] = stk[(sp * 10 + q2) as usize]
                    q2 = q2 + 1
                }
            }
        }

        // ------------------------------------------------- LOKAL
        if btype == 2 {
            // Ein Gebrauch mit VIER Datenoktetten traegt die Seite in
            // den oberen sechzehn Bit mit sich; das ist der Weg, auf dem
            // ein Touchpad das waagrechte Rollen der Verbraucherseite
            // mitten in einer Digitizer-Sammlung nennt.
            if btag == 0 {
                if nu >= MAX_USAGES {
                    return fail(state, dev, E_USAGE, start)
                }
                if bsize == 4 {
                    ul[nu as usize] = data
                } else {
                    ul[nu as usize] = (gl[0 as usize] << 16) | (data & 0xFFFF)
                }
                nu = nu + 1
            }
            if btag == 1 {
                if bsize == 4 {
                    umin = data
                } else {
                    umin = (gl[0 as usize] << 16) | (data & 0xFFFF)
                }
                range = true
            }
            if btag == 2 {
                if bsize == 4 {
                    umax = data
                } else {
                    umax = (gl[0 as usize] << 16) | (data & 0xFFFF)
                }
                range = true
            }
        }

        // -------------------------------------------------- HAUPT
        if btype == 0 {
            if btag == 0xA {
                depth = depth + 1
                if depth > MAX_DEPTH {
                    return fail(state, dev, E_NEST, start)
                }
                if depth > maxd {
                    maxd = depth
                }
                // Die erste Sammlung auf der obersten Ebene sagt, was
                // das Geraet ist. Jede weitere oberste Sammlung kommt
                // in die Karte dazu.
                if depth == 1 {
                    var tu: u64 = 0
                    if nu > 0 {
                        tu = ul[0 as usize]
                    } else {
                        if range {
                            tu = umin
                        }
                    }
                    if sg(state, dev, S_TOP) == 0 {
                        ss(state, dev, S_TOP, tu)
                    }
                    karte = karte | kind_of((tu >> 16) & 0xFFFF, tu & 0xFFFF)
                }
            }
            if btag == 0xC {
                if depth == 0 {
                    return fail(state, dev, E_NEST, start)
                }
                depth = depth - 1
            }
            if btag == 0x8 || btag == 0x9 || btag == 0xB {
                var kd: u64 = KIND_IN
                if btag == 0x9 {
                    kd = KIND_OUT
                }
                if btag == 0xB {
                    kd = KIND_FEAT
                }
                let rsize: u64 = gl[7 as usize]
                let rcount: u64 = gl[9 as usize]
                // WAS UNSINNIG IST. Ueber 32 Bit je Feld kann dieser
                // Kernel nicht rechnen (ein Wort ist 64 Bit und die
                // Vorzeichenerweiterung braucht Platz), ueber 1024
                // Felder je Posten hat kein Geraet, und ein Bericht
                // ueber 4096 Bit passt in keinen Puffer, den `usb.fi`
                // oder `i2chid.fi` bereithalten.
                if rsize > 32 {
                    return fail(state, dev, E_SIZE, start)
                }
                if rcount > 1024 {
                    return fail(state, dev, E_SIZE, start)
                }
                if rsize * rcount > 4096 {
                    return fail(state, dev, E_BIG, start)
                }
                let slot: u64 = rid_slot(state, dev, gl[8 as usize])
                if slot >= MAX_RIDS {
                    return fail(state, dev, E_RIDS, start)
                }
                let base: u64 = bitpos_get(state, dev, slot, kd)
                if base + rsize * rcount > 4096 {
                    return fail(state, dev, E_BIG, start)
                }
                if !emit(state, dev, gl[8 as usize], kd, data & 0xFFFF,
                    base, rsize, rcount, gl[0 as usize],
                    (&ul[0]) as u64, nu, umin, umax, range,
                    gl[1 as usize], gl[2 as usize]) {
                    return fail(state, dev, E_FIELDS, start)
                }
                bitpos_set(state, dev, slot, kd, base + rsize * rcount)
            }
            // NACH JEDEM HAUPTPOSTEN sind die lokalen Posten weg. Auch
            // nach Sammlung und Sammlungsende -- das ist die Stelle,
            // an der ein Zerleger dem naechsten Feld sonst den
            // Gebrauch des vorigen gibt.
            nu = 0
            umin = 0
            umax = 0
            range = false
        }
    }

    if depth != 0 {
        return fail(state, dev, E_NEST, len)
    }
    ss(state, dev, S_ITEMS, nitems)
    ss(state, dev, S_DEPTH, maxd)
    ss(state, dev, S_KIND, karte)
    ss(state, dev, S_OK, 1)
    ss(state, dev, S_ERR, E_OK)
    return E_OK
}

// Die Felder EINES Hauptpostens in die Tabelle schreiben.
//
// DREI FAELLE, und die Unterscheidung ist der ganze Zerleger:
//
//   1. KONSTANT (Fuellbits). Kein Gebrauch, keine Bedeutung, nur Platz.
//      EIN Eintrag mit der vollen Anzahl -- wer das aufspaltet, hat bei
//      einem Touchpad dreissig Eintraege fuer nichts.
//   2. VARIABEL. Jedes Feld ist EIN Wert mit EINEM Gebrauch. Folgen die
//      Gebraeuche aufeinander (aus Gebrauch-Min/Max oder weil die
//      aufgezaehlte Liste zufaellig fortlaufend ist), wird EIN Eintrag
//      mit Anzahl > 1 daraus; sonst einer je Gebrauch.
//   3. FELDGRUPPE (Array). Jedes Feld traegt EINEN Gebrauchscode aus
//      dem Bereich Gebrauch-Min..Gebrauch-Max -- so meldet eine
//      Boot-Tastatur ihre sechs Tasten. EIN Eintrag mit der vollen
//      Anzahl; `hidin.fi` liest die Codes daraus.
fn emit(state: u64, dev: u64, rid: u64, kd: u64, flags: u64, base: u64,
    rsize: u64, rcount: u64, page: u64, ulp: u64, nu: u64,
    umin: u64, umax: u64, range: bool, lmin: u64, lmax: u64) -> bool {
    if rcount == 0 || rsize == 0 {
        return true
    }
    if (flags & FL_CONST) != 0 {
        return put(state, dev, rid, kd, flags, base, rsize, rcount,
            page, 0, 0, lmin, lmax)
    }
    if (flags & FL_VAR) == 0 {
        // Feldgruppe. Der Gebrauchsbereich gehoert zum Eintrag, nicht
        // zu einem einzelnen Feld.
        var gmin: u64 = umin
        var gmax: u64 = umax
        if !range && nu > 0 {
            gmin = kstate.get(ulp, 0)
            gmax = gmin
        }
        return put(state, dev, rid, kd, flags, base, rsize, rcount,
            page, gmin & 0xFFFF, gmax & 0xFFFF, lmin, lmax)
    }
    // Variabel und ein Bereich: ein Eintrag, fortlaufende Gebraeuche.
    if range {
        return put(state, dev, rid, kd, flags, base, rsize, rcount,
            page, umin & 0xFFFF, umax & 0xFFFF, lmin, lmax)
    }
    if nu == 0 {
        return put(state, dev, rid, kd, flags, base, rsize, rcount,
            page, 0, 0, lmin, lmax)
    }
    // Variabel mit aufgezaehlten Gebraeuchen. Fortlaufende Laeufe
    // werden zusammengefasst; ein Sprung faengt einen neuen Eintrag an.
    var i: u64 = 0
    while i < rcount {
        var j: u64 = i
        if i >= nu {
            // Mehr Felder als Gebraeuche: der letzte gilt fuer den
            // Rest (so sagt es die Spezifikation). Ein Eintrag.
            let last: u64 = kstate.get(ulp, (nu - 1) * 8)
            return put(state, dev, rid, kd, flags,
                base + i * rsize, rsize, rcount - i,
                (last >> 16) & 0xFFFF, last & 0xFFFF, 0, lmin, lmax)
        }
        let u0: u64 = kstate.get(ulp, i * 8)
        // Wie weit folgen die Gebraeuche aufeinander, auf derselben
        // Seite?
        while j + 1 < rcount && j + 1 < nu {
            let ua: u64 = kstate.get(ulp, j * 8)
            let ub: u64 = kstate.get(ulp, (j + 1) * 8)
            if ub != ua + 1 {
                break
            }
            j = j + 1
        }
        let n: u64 = j - i + 1
        if !put(state, dev, rid, kd, flags, base + i * rsize, rsize, n,
            (u0 >> 16) & 0xFFFF, u0 & 0xFFFF, (u0 + n - 1) & 0xFFFF,
            lmin, lmax) {
            return false
        }
        i = j + 1
    }
    return true
}

// --------------------------------------------------------- die Meldung
//
// EINE Zeile je Geraet, damit ein Testlaeufer sie mit `grep` findet und
// niemand sie aus einem Fliesstext heraussuchen muss.
//
//     hidrep: dev=0 ok=1 err=0 felder=5 rids=1 hasid=0 top=00010006
//             art=1 bits=64 posten=32 tiefe=1
fn say(state: u64, dev: u64) {
    say_as(state, dev, dev)
}

fn say_as(state: u64, dev: u64, label: u64) {
    var s_a: [u8; 13] = "hidrep: dev=\0"
    var s_ok: [u8; 5] = " ok=\0"
    var s_er: [u8; 6] = " err=\0"
    var s_ep: [u8; 8] = " errat=\0"
    var s_f: [u8; 9] = " felder=\0"
    var s_r: [u8; 7] = " rids=\0"
    var s_h: [u8; 8] = " hasid=\0"
    var s_t: [u8; 6] = " top=\0"
    var s_k: [u8; 6] = " art=\0"
    var s_b: [u8; 7] = " bits=\0"
    var s_i: [u8; 9] = " posten=\0"
    var s_d: [u8; 8] = " tiefe=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(label)
    serial.puts((&s_ok[0]) as u64)
    var o: u64 = 0
    if ok(state, dev) {
        o = 1
    }
    serial.dec(o)
    serial.puts((&s_er[0]) as u64)
    serial.dec(err(state, dev))
    serial.puts((&s_ep[0]) as u64)
    serial.dec(errpos(state, dev))
    serial.puts((&s_f[0]) as u64)
    serial.dec(fields(state, dev))
    serial.puts((&s_r[0]) as u64)
    serial.dec(nrid(state, dev))
    serial.puts((&s_h[0]) as u64)
    var h: u64 = 0
    if hasid(state, dev) {
        h = 1
    }
    serial.dec(h)
    serial.puts((&s_t[0]) as u64)
    serial.hex(top_usage(state, dev))
    serial.puts((&s_k[0]) as u64)
    serial.dec(kind(state, dev))
    serial.puts((&s_b[0]) as u64)
    serial.dec(rid_inbits(state, dev, 0))
    serial.puts((&s_i[0]) as u64)
    serial.dec(items(state, dev))
    serial.puts((&s_d[0]) as u64)
    serial.dec(maxdepth(state, dev))
    serial.nl()
}

// EINE ZEILE JE FELD, damit `tools/hid/run.sh` sie gegen den zweiten
// Zerleger in `tools/hid/descs.py` halten kann. Nicht "die Zahl der
// Felder stimmt" -- JEDES Feld, mit Bitlage, Groesse, Anzahl,
// Gebrauchsseite, Gebrauch und Wertebereich. Eine Zahl, die stimmt,
// waehrend die Felder daneben liegen, hat dieses Projekt schon einmal
// gehabt (Runde K7B).
fn say_fields(state: u64, dev: u64, label: u64) {
    var s_a: [u8; 7] = "hidf: \0"
    var s_r: [u8; 6] = " rid=\0"
    var s_k: [u8; 6] = " art=\0"
    var s_m: [u8; 6] = " mrk=\0"
    var s_b: [u8; 6] = " bit=\0"
    var s_g: [u8; 5] = " gr=\0"
    var s_n: [u8; 6] = " anz=\0"
    var s_s: [u8; 8] = " seite=\0"
    var s_u: [u8; 6] = " geb=\0"
    var s_x: [u8; 7] = " gmax=\0"
    var s_lo: [u8; 7] = " lmin=\0"
    var s_hi: [u8; 7] = " lmax=\0"
    var s_sp: [u8; 2] = " \0"
    var i: u64 = 0
    let n: u64 = fields(state, dev)
    while i < n {
        serial.puts((&s_a[0]) as u64)
        serial.dec(label)
        serial.puts((&s_sp[0]) as u64)
        serial.dec(i)
        serial.puts((&s_r[0]) as u64)
        serial.dec(f_rid(state, dev, i))
        serial.puts((&s_k[0]) as u64)
        serial.dec(f_kind(state, dev, i))
        serial.puts((&s_m[0]) as u64)
        serial.hex(f_flags(state, dev, i))
        serial.puts((&s_b[0]) as u64)
        serial.dec(f_bitoff(state, dev, i))
        serial.puts((&s_g[0]) as u64)
        serial.dec(f_bitsz(state, dev, i))
        serial.puts((&s_n[0]) as u64)
        serial.dec(f_count(state, dev, i))
        serial.puts((&s_s[0]) as u64)
        serial.hex(f_page(state, dev, i))
        serial.puts((&s_u[0]) as u64)
        serial.hex(f_usage(state, dev, i))
        serial.puts((&s_x[0]) as u64)
        serial.hex(f_umax(state, dev, i))
        serial.puts((&s_lo[0]) as u64)
        serial.hex(f_lmin(state, dev, i))
        serial.puts((&s_hi[0]) as u64)
        serial.hex(f_lmax(state, dev, i))
        serial.nl()
        i = i + 1
    }
}

// ----------------------------------------------------------------------
// DER SELBSTTEST (Modus `hidrep`).
//
// Zwanzig Beschreibungen aus `kernel/hidtest.fi` -- sechs echte und
// vierzehn kaputte -- werden der Reihe nach in DENSELBEN Platz 0
// geladen und zerlegt. Das ist Absicht: ein Zerleger, der nur beim
// ersten Mal richtig liegt, weil noch alles genullt war, faellt hier
// auf.
//
// Was der Kern hier ausgibt, wird NICHT im Kern geprueft. Es geht
// Zeile fuer Zeile gegen `tools/hid/descs.py`, einen zweiten Zerleger
// in einer anderen Sprache. Waere die Pruefung hier drin, pruefte sich
// diese Datei selbst.
fn selbsttest(state: u64) {
    var s_e: [u8; 16] = "hidrep: ende n=\0"
    var i: u64 = 0
    let n: u64 = hidtest.count()
    while i < n {
        let len: u64 = hidtest.load(i, raw_of(state, 0))
        parse(state, 0, raw_of(state, 0), len)
        say_as(state, 0, i)
        if ok(state, 0) {
            say_fields(state, 0, i)
        }
        i = i + 1
    }
    serial.puts((&s_e[0]) as u64)
    serial.dec(n)
    serial.nl()
}
