
profile kernel

import lib.kstate
import sync.atomic
import arch.cpu
import serial
import sched.time

export {
    init, ready,
    say, sayn, sayh, say2, emit,
    L_DEBUG, L_INFO, L_WARN, L_ERROR,
    min_level, set_min, ser_level, set_ser,
    seq, kept, filtered, lost, N_ENT, E_BYTES,
    slot_of, e_seq, e_ns, e_pid, e_core, e_level, e_len, e_src, e_text,
    level_char, first_seq, line_at, dump_tail, mode_parse,
    bench, verify, race_line
}

const L_DEBUG: u64 = 0
const L_INFO: u64 = 1
const L_WARN: u64 = 2
const L_ERROR: u64 = 3

const E_BYTES: u64 = 128
const HDR: u64 = 256
const N_ENT: u64 = 510

const H_SEQ: u64 = 0
const H_MIN: u64 = 8
const H_SER: u64 = 16
const H_LK: u64 = 24
const H_READY: u64 = 32
const H_LOST: u64 = 40
const H_FILT: u64 = 64

const E_SEQ: u64 = 0
const E_NS: u64 = 8
const E_PID: u64 = 16
const E_CORE: u64 = 24
const E_LVL: u64 = 25
const E_LEN: u64 = 26
const E_SRC: u64 = 32
const E_SRCMAX: u64 = 8
const E_TXT: u64 = 40
const E_TXTMAX: u64 = 88

fn base(state: u64) -> u64 {
    return state + kstate.LOG_OFF
}

fn slot_of(state: u64, i: u64) -> u64 {
    return base(state) + HDR + (i % N_ENT) * E_BYTES
}

fn init(state: u64) {
    kstate.set(state, kstate.LOG_OFF + H_SEQ, 0)
    kstate.set(state, kstate.LOG_OFF + H_LK, 0)
    kstate.set(state, kstate.LOG_OFF + H_LOST, 0)
    kstate.set(state, kstate.LOG_OFF + H_MIN, L_INFO)
    kstate.set(state, kstate.LOG_OFF + H_SER, L_WARN)
    var i: u64 = 0
    while i < kstate.MAX_CPUS {
        kstate.set(state, kstate.LOG_OFF + H_FILT + i * 8, 0)
        i = i + 1
    }
    var j: u64 = 0
    while j < N_ENT {
        __mmio_write64((slot_of(state, j) + E_SEQ) as *mut u64, 0)
        j = j + 1
    }
    kstate.set(state, kstate.LOG_OFF + H_READY, 1)
}

fn ready(state: u64) -> bool {
    return kstate.get(state, kstate.LOG_OFF + H_READY) != 0
}

fn min_level(state: u64) -> u64 {
    return kstate.get(state, kstate.LOG_OFF + H_MIN)
}

fn set_min(state: u64, v: u64) {
    kstate.set(state, kstate.LOG_OFF + H_MIN, v)
}

fn ser_level(state: u64) -> u64 {
    return kstate.get(state, kstate.LOG_OFF + H_SER)
}

fn set_ser(state: u64, v: u64) {
    kstate.set(state, kstate.LOG_OFF + H_SER, v)
}

fn seq(state: u64) -> u64 {
    return kstate.get(state, kstate.LOG_OFF + H_SEQ)
}

fn kept(state: u64) -> u64 {
    return kstate.get(state, kstate.LOG_OFF + H_SEQ)
}

fn lost(state: u64) -> u64 {
    return kstate.get(state, kstate.LOG_OFF + H_LOST)
}

fn filtered(state: u64) -> u64 {
    var i: u64 = 0
    var n: u64 = 0
    while i < kstate.MAX_CPUS {
        n = n + kstate.get(state, kstate.LOG_OFF + H_FILT + i * 8)
        i = i + 1
    }
    return n
}

fn first_seq(state: u64) -> u64 {
    let s: u64 = seq(state)
    if s <= N_ENT {
        return 1
    }
    return s - N_ENT + 1
}

fn irq_save() -> u64 {
    return asm("pushfq\npop rax\ncli", out("rax"))
}

fn irq_restore(flags: u64) {
    if (flags & 0x200) != 0 {
        asm("sti")
    }
}

fn hold(state: u64) -> u64 {
    let flags: u64 = irq_save()
    let me: u64 = cpu.here(state)
    let a: u64 = base(state) + H_LK
    if atomic.load(a) == me + 1 {
        return flags | 0x8000000000000000
    }
    while atomic.cas(a, 0, me + 1) != 0 {
        atomic.pause()
    }
    return flags
}

fn give(state: u64, flags: u64) {
    if (flags & 0x8000000000000000) == 0 {
        atomic.store(base(state) + H_LK, 0)
    }
    irq_restore(flags & 0x7FFFFFFFFFFFFFFF)
}

fn drop_it(state: u64, level: u64) -> bool {
    if level >= __mmio_read64((state + kstate.LOG_OFF + H_MIN) as *mut u64) {
        return false
    }
    let p: u64 = state + kstate.LOG_OFF + H_FILT
    __mmio_write64(p as *mut u64, __mmio_read64(p as *mut u64) + 1)
    return true
}

fn say(state: u64, level: u64, src: u64, msg: u64) {
    if level < __mmio_read64((state + kstate.LOG_OFF + H_MIN) as *mut u64) {
        let p: u64 = state + kstate.LOG_OFF + H_FILT
        __mmio_write64(p as *mut u64, __mmio_read64(p as *mut u64) + 1)
        return
    }
    emit(state, level, src, msg, 0, 0, 0)
}

fn sayn(state: u64, level: u64, src: u64, msg: u64, n: u64) {
    if drop_it(state, level) {
        return
    }
    emit(state, level, src, msg, 1, n, 0)
}

fn sayh(state: u64, level: u64, src: u64, msg: u64, v: u64) {
    if drop_it(state, level) {
        return
    }
    emit(state, level, src, msg, 2, v, 0)
}

fn say2(state: u64, level: u64, src: u64, msg: u64, a: u64, b: u64) {
    if drop_it(state, level) {
        return
    }
    emit(state, level, src, msg, 3, a, b)
}

fn emit(state: u64, level: u64, src: u64, msg: u64, art: u64,
        a: u64, b: u64) {
    if level < __mmio_read64((state + kstate.LOG_OFF + H_MIN) as *mut u64) {
        return
    }
    let flags: u64 = hold(state)
    let s: u64 = kstate.get(state, kstate.LOG_OFF + H_SEQ) + 1
    kstate.set(state, kstate.LOG_OFF + H_SEQ, s)
    if s > N_ENT {
        kstate.set(state, kstate.LOG_OFF + H_LOST,
            kstate.get(state, kstate.LOG_OFF + H_LOST) + 1)
    }
    let e: u64 = slot_of(state, s - 1)
    __mmio_write64((e + E_NS) as *mut u64, now_ns(state))
    __mmio_write64((e + E_PID) as *mut u64, pid_here(state))
    kstate.set8(e + E_CORE, (cpu.here(state) & 0xFF) as u8)
    kstate.set8(e + E_LVL, (level & 0xFF) as u8)
    copy_fix(e + E_SRC, src, E_SRCMAX)
    let n: u64 = fill_text(e + E_TXT, msg, art, a, b)
    kstate.set8(e + E_LEN, (n & 0xFF) as u8)
    __mmio_write64((e + E_SEQ) as *mut u64, s)
    if level >= kstate.get(state, kstate.LOG_OFF + H_SER) {
        ser_line(state, e)
    }
    give(state, flags)
}

fn now_ns(state: u64) -> u64 {
    if kstate.get(state, kstate.TIME_KHZ) == 0 {
        return 0
    }
    return time.mono_ns(state)
}

fn pid_here(state: u64) -> u64 {
    let cur: u64 = kstate.get(state, kstate.CURRENT)
    if cur >= kstate.MAX_TASKS {
        return 0
    }
    return kstate.get(state, kstate.TASK_OFF + cur * kstate.TASK_BYTES + 8)
}

fn copy_fix(dst: u64, src: u64, max: u64) {
    var i: u64 = 0
    if src != 0 {
        while i < max {
            let c: u64 = kstate.get8(src + i)
            if c == 0 {
                break
            }
            kstate.set8(dst + i, (c & 0xFF) as u8)
            i = i + 1
        }
    }
    while i < max {
        kstate.set8(dst + i, 0 as u8)
        i = i + 1
    }
}

fn len_of(p: u64, max: u64) -> u64 {
    var i: u64 = 0
    while i < max {
        if kstate.get8(p + i) == 0 {
            return i
        }
        i = i + 1
    }
    return max
}

fn fill_text(dst: u64, msg: u64, art: u64, a: u64, b: u64) -> u64 {
    var n: u64 = 0
    if msg != 0 {
        while n < E_TXTMAX {
            let c: u64 = kstate.get8(msg + n)
            if c == 0 {
                break
            }
            kstate.set8(dst + n, (c & 0xFF) as u8)
            n = n + 1
        }
    }
    if art == 1 {
        n = put_dec(dst, n, a)
    }
    if art == 2 {
        n = put_hex(dst, n, a)
    }
    if art == 3 {
        n = put_dec(dst, n, a)
        n = put_ch(dst, n, 32)
        n = put_dec(dst, n, b)
    }
    var j: u64 = n
    while j < E_TXTMAX {
        kstate.set8(dst + j, 0 as u8)
        j = j + 1
    }
    return n
}

fn put_ch(dst: u64, at: u64, c: u64) -> u64 {
    if at >= E_TXTMAX {
        return at
    }
    kstate.set8(dst + at, (c & 0xFF) as u8)
    return at + 1
}

fn put_dec(dst: u64, at: u64, v: u64) -> u64 {
    var buf: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        buf[0 as usize] = 48 as u8
        n = 1
    }
    while x > 0 {
        buf[n as usize] = (48 + (x % 10)) as u8
        x = x / 10
        n = n + 1
    }
    var i: u64 = n
    var p: u64 = at
    while i > 0 {
        p = put_ch(dst, p, buf[(i - 1) as usize] as u64)
        i = i - 1
    }
    return p
}

fn put_hex(dst: u64, at: u64, v: u64) -> u64 {
    var p: u64 = put_ch(dst, at, 48)
    p = put_ch(dst, p, 120)
    var i: u64 = 16
    var seen: bool = false
    while i > 0 {
        let d: u64 = (v >> ((i - 1) * 4)) & 0xF
        if d != 0 || seen || i == 1 {
            seen = true
            if d < 10 {
                p = put_ch(dst, p, 48 + d)
            } else {
                p = put_ch(dst, p, 87 + d)
            }
        }
        i = i - 1
    }
    return p
}

fn e_seq(state: u64, i: u64) -> u64 {
    return __mmio_read64((slot_of(state, i) + E_SEQ) as *mut u64)
}

fn e_ns(state: u64, i: u64) -> u64 {
    return __mmio_read64((slot_of(state, i) + E_NS) as *mut u64)
}

fn e_pid(state: u64, i: u64) -> u64 {
    return __mmio_read64((slot_of(state, i) + E_PID) as *mut u64)
}

fn e_core(state: u64, i: u64) -> u64 {
    return kstate.get8(slot_of(state, i) + E_CORE)
}

fn e_level(state: u64, i: u64) -> u64 {
    return kstate.get8(slot_of(state, i) + E_LVL)
}

fn e_len(state: u64, i: u64) -> u64 {
    return kstate.get8(slot_of(state, i) + E_LEN)
}

fn e_src(state: u64, i: u64) -> u64 {
    return slot_of(state, i) + E_SRC
}

fn e_text(state: u64, i: u64) -> u64 {
    return slot_of(state, i) + E_TXT
}

fn level_char(level: u64) -> u64 {
    if level == L_DEBUG {
        return 68
    }
    if level == L_INFO {
        return 73
    }
    if level == L_WARN {
        return 87
    }
    return 69
}

fn ser_line(state: u64, e: u64) {
    var s_ob: [u8; 2] = "[\0"
    var s_cb: [u8; 3] = "] \0"
    var s_sl: [u8; 2] = "/\0"
    var s_sp: [u8; 2] = " \0"
    var s_co: [u8; 3] = ": \0"
    let z: u64 = serial.line_at()
    serial.puts((&s_ob[0 as usize]) as u64)
    serial.pad_dec(__mmio_read64((e + E_NS) as *mut u64) / 1000, 10)
    serial.puts((&s_cb[0 as usize]) as u64)
    serial.dec(kstate.get8(e + E_CORE))
    serial.puts((&s_sl[0 as usize]) as u64)
    serial.dec(__mmio_read64((e + E_PID) as *mut u64))
    serial.puts((&s_sp[0 as usize]) as u64)
    serial.put((level_char(kstate.get8(e + E_LVL)) & 0xFF) as u8)
    serial.puts((&s_sp[0 as usize]) as u64)
    serial.text(e + E_SRC, len_of(e + E_SRC, E_SRCMAX))
    serial.puts((&s_co[0 as usize]) as u64)
    serial.text(e + E_TXT, kstate.get8(e + E_LEN))
    serial.nl()
    serial.line_clear(z)
}

fn line_at(state: u64, s: u64, out: u64, max: u64) -> u64 {
    if s == 0 || s > seq(state) || s < first_seq(state) {
        return 0
    }
    let i: u64 = s - 1
    if e_seq(state, i) != s {
        return 0
    }
    var n: u64 = 0
    n = o_ch(out, n, max, 91)
    n = o_dec(out, n, max, e_ns(state, i) / 1000, 10)
    n = o_ch(out, n, max, 93)
    n = o_ch(out, n, max, 32)
    n = o_dec(out, n, max, e_core(state, i), 0)
    n = o_ch(out, n, max, 47)
    n = o_dec(out, n, max, e_pid(state, i), 0)
    n = o_ch(out, n, max, 32)
    n = o_ch(out, n, max, level_char(e_level(state, i)))
    n = o_ch(out, n, max, 32)
    var k: u64 = 0
    let sl: u64 = len_of(e_src(state, i), E_SRCMAX)
    while k < sl {
        n = o_ch(out, n, max, kstate.get8(e_src(state, i) + k))
        k = k + 1
    }
    n = o_ch(out, n, max, 58)
    n = o_ch(out, n, max, 32)
    var t: u64 = 0
    let tl: u64 = e_len(state, i)
    while t < tl {
        n = o_ch(out, n, max, kstate.get8(e_text(state, i) + t))
        t = t + 1
    }
    n = o_ch(out, n, max, 10)
    return n
}

fn o_ch(out: u64, at: u64, max: u64, c: u64) -> u64 {
    if at >= max {
        return at
    }
    kstate.set8(out + at, (c & 0xFF) as u8)
    return at + 1
}

fn o_dec(out: u64, at: u64, max: u64, v: u64, width: u64) -> u64 {
    var buf: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        buf[0 as usize] = 48 as u8
        n = 1
    }
    while x > 0 {
        buf[n as usize] = (48 + (x % 10)) as u8
        x = x / 10
        n = n + 1
    }
    var p: u64 = at
    var w: u64 = n
    while w < width {
        p = o_ch(out, p, max, 32)
        w = w + 1
    }
    var i: u64 = n
    while i > 0 {
        p = o_ch(out, p, max, buf[(i - 1) as usize] as u64)
        i = i - 1
    }
    return p
}

fn dump_tail(state: u64, n: u64) {
    let last: u64 = seq(state)
    if last == 0 {
        return
    }
    var from: u64 = 1
    if last > n {
        from = last - n + 1
    }
    if from < first_seq(state) {
        from = first_seq(state)
    }
    var s: u64 = from
    while s <= last {
        let i: u64 = s - 1
        if e_seq(state, i) == s {
            ser_line(state, slot_of(state, i))
        }
        s = s + 1
    }
}

fn mode_parse(state: u64, word: u64) -> bool {
    var w1: [u8; 9] = "logdebug\0"
    var w2: [u8; 9] = "logquiet\0"
    var w3: [u8; 7] = "logall\0"
    if streq(word, (&w1[0 as usize]) as u64) {
        set_min(state, L_DEBUG)
        set_ser(state, L_DEBUG)
        return true
    }
    if streq(word, (&w2[0 as usize]) as u64) {
        set_min(state, L_INFO)
        set_ser(state, L_ERROR)
        return true
    }
    if streq(word, (&w3[0 as usize]) as u64) {
        set_min(state, L_DEBUG)
        set_ser(state, L_WARN)
        return true
    }
    return false
}

fn streq(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while true {
        let x: u64 = kstate.get8(a + i)
        let y: u64 = kstate.get8(b + i)
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn bench(state: u64, n: u64) -> u64 {
    var s_src: [u8; 6] = "bench\0"
    var s_msg: [u8; 11] = "a hot loop\0"
    let alt: u64 = min_level(state)
    set_min(state, L_INFO)
    let t0: u64 = now_ns(state)
    var i: u64 = 0
    while i < n {
        say(state, L_DEBUG, (&s_src[0 as usize]) as u64,
            (&s_msg[0 as usize]) as u64)
        i = i + 1
    }
    let t1: u64 = now_ns(state)
    set_min(state, alt)
    if t1 < t0 {
        return 0
    }
    return t1 - t0
}

fn verify(state: u64) -> u64 {
    var s_race: [u8; 5] = "race\0"
    let last: u64 = seq(state)
    var s: u64 = first_seq(state)
    var bad: u64 = 0
    while s <= last {
        let i: u64 = s - 1
        if e_seq(state, i) != s {
            bad = bad + 1
        } else {
            if streq_n(e_src(state, i), (&s_race[0 as usize]) as u64, 4) {
                if first_num(e_text(state, i), e_len(state, i))
                        != e_core(state, i) {
                    bad = bad + 1
                }
            }
        }
        s = s + 1
    }
    return bad
}

fn race_line(state: u64, core: u64, i: u64) {
    var s_src: [u8; 5] = "race\0"
    var s_msg: [u8; 1] = "\0"
    say2(state, L_DEBUG, (&s_src[0 as usize]) as u64,
        (&s_msg[0 as usize]) as u64, core, i)
}

fn streq_n(a: u64, b: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get8(a + i) != kstate.get8(b + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn first_num(p: u64, len: u64) -> u64 {
    var i: u64 = 0
    var v: u64 = 0
    var seen: bool = false
    while i < len {
        let c: u64 = kstate.get8(p + i)
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
            seen = true
        } else {
            if seen {
                return v
            }
        }
        i = i + 1
    }
    if seen {
        return v
    }
    return 0xFFFFFFFF
}
