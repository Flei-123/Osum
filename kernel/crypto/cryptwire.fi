profile kernel

import crypto.cryptbind
import crypto.krypto

export { install }

fn install(state: u64) {
    cryptbind.bind_cipher(cryptbind.H_ENCRYPT, krypto.encrypt_sector as u64)
    cryptbind.bind_cipher(cryptbind.H_DECRYPT, krypto.decrypt_sector as u64)
}
