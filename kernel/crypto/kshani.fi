
import lib.kstate
import serial
import lib.kutil
import arch.x86_64.fpu
import crypto.sha256
import crypto.shani
import libc.numeric

export { apply, report, selftest, have, used }

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, off)
}

fn apply(state: u64) {
    let hat: bool = shani.usable()
    kstate.set(state, kstate.SHA_HAVE, numeric.yes(hat))

    var an: bool = hat
    if !fpu.enabled(state) {
        an = false
    }
    if kstate.mode_on(state, kstate.M_NOSHANI) {
        an = false
    }
    sha256.use_shani(an)
    kstate.set(state, kstate.SHA_USED, numeric.yes(an))
}

fn have(state: u64) -> bool {
    return g(state, kstate.SHA_HAVE) != 0
}

fn used(state: u64) -> bool {
    return g(state, kstate.SHA_USED) != 0
}

fn report(state: u64) {
    var s_h: [u8; 8] = "shani: \0"
    var s_have: [u8; 6] = "have=\0"
    var s_used: [u8; 8] = "  used=\0"
    var s_fpu: [u8; 7] = "  fpu=\0"
    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_have[0]) as u64)
    serial.dec(g(state, kstate.SHA_HAVE))
    serial.puts((&s_used[0]) as u64)
    serial.dec(g(state, kstate.SHA_USED))
    serial.puts((&s_fpu[0]) as u64)
    serial.dec(numeric.yes(fpu.enabled(state)))
    serial.nl()
}

fn selftest(state: u64) {
    var s_h: [u8; 16] = "shani: kreis g=\0"
    var s_u: [u8; 9] = "  ungl=\0\0"
    var buffer: [u8; 1024] = [0 as u8; 1024]
    var x: u64 = 88172645463325252
    var i: usize = 0
    while i < 1024 {
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        buffer[i] = ((x >> 24) & 255) as u8
        i = i + 1
    }
    var a: [u8; 32] = [0 as u8; 32]
    var b: [u8; 32] = [0 as u8; 32]
    var same: u64 = 0
    var ungleich: u64 = 0
    var n: usize = 0
    while n <= 300 {
        sha256.use_shani(false)
        sha256.hash((&buffer[0]) as u64, n, (&a[0]) as u64)
        sha256.use_shani(true)
        sha256.hash((&buffer[0]) as u64, n, (&b[0]) as u64)
        var k: usize = 0
        var bad: bool = false
        while k < 32 {
            if a[k] != b[k] {
                bad = true
            }
            k = k + 1
        }
        if bad {
            ungleich = ungleich + 1
        } else {
            same = same + 1
        }
        n = n + 1
    }
    var m: usize = 512
    while m <= 1024 {
        sha256.use_shani(false)
        sha256.hash((&buffer[0]) as u64, m, (&a[0]) as u64)
        sha256.use_shani(true)
        sha256.hash((&buffer[0]) as u64, m, (&b[0]) as u64)
        var k2: usize = 0
        var bad2: bool = false
        while k2 < 32 {
            if a[k2] != b[k2] {
                bad2 = true
            }
            k2 = k2 + 1
        }
        if bad2 {
            ungleich = ungleich + 1
        } else {
            same = same + 1
        }
        m = m + 1
    }
    sha256.use_shani(used(state))
    kstate.set(state, kstate.SHA_KREIS, same)
    kstate.set(state, kstate.SHA_UNGL, ungleich)
    serial.puts((&s_h[0]) as u64)
    serial.dec(same)
    serial.puts((&s_u[0]) as u64)
    serial.dec(ungleich)
    serial.nl()
}
