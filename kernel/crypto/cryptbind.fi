profile kernel

export { bind_cipher, encrypt_sector, decrypt_sector, H_ENCRYPT, H_DECRYPT }

const H_ENCRYPT: u64 = 0
const H_DECRYPT: u64 = 1
const H_COUNT: u64 = 2

static mut table: [u64; 2] = [0 as u64; 2]

fn bind_cipher(slot: u64, handler: u64) {
    if slot < H_COUNT {
        table[slot as usize] = handler
    }
}

fn encrypt_sector(state: u64, lba: u64, src: u64, dst: u64) -> bool {
    let handler: u64 = table[H_ENCRYPT as usize]
    if handler == 0 {
        return false
    }
    let call: fn(u64, u64, u64, u64) -> bool = handler as fn(u64, u64, u64, u64) -> bool
    return call(state, lba, src, dst)
}

fn decrypt_sector(state: u64, lba: u64, src: u64, dst: u64) -> bool {
    let handler: u64 = table[H_DECRYPT as usize]
    if handler == 0 {
        return false
    }
    let call: fn(u64, u64, u64, u64) -> bool = handler as fn(u64, u64, u64, u64) -> bool
    return call(state, lba, src, dst)
}
