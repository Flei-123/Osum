// SPDX-License-Identifier: GPL-2.0-only
// kernel/kaesni.fi -- RUNDE AESNI (K-020): die Kernseite.
//
// WARUM `kaesni` UND NICHT `aesni`: die Rechnung heisst
// `lib/crypto/aesni.fi`, und der Kern uebersetzt beide Baeume in
// EINEN Namensraum. Zwei Module mit demselben Namen sind dort nicht
// zwei Module, sondern eines -- der Uebersetzer sagt dann "module
// 'aesni' has no element 'Enc'", und zwar in `xts.fi`, das mit dem
// Kern nichts zu tun hat. Der Kern-Vorsatz `k` ist dieselbe Loesung,
// die `kjson`, `kutil` und `kgui` schon tragen.
//
// ================================================== WAS HIER STEHT
//
// `lib/crypto/aesni.fi` ist die Rechnung und kennt den Kern nicht --
// dieselbe Datei laeuft im Orakel auf dem Wirt. Diese hier ist die
// Naht: sie fragt `cpuid`, prueft die Freischaltung der Vektoreinheit,
// stellt den Schalter in `xts.fi` und schreibt die Befunde in die
// Seite, die dieser Runde zugeteilt ist (0x120000).
//
// ============================== DIE DREI FRAGEN, IN DIESER REIHENFOLGE
//
// Sie stehen hier zusammen, weil die zweite ohne die erste sinnlos ist
// und die dritte ohne die zweite toedlich:
//
//   1. HAT DIE MASCHINE DIE BEFEHLE? `cpuid` Blatt 1, ECX Bit 25.
//      Ohne sie ist jedes `aesenc` ein #UD -- in Ring 0 der Tod des
//      Kerns. Gegengeprueft mit `qemu-x86_64 -cpu qemu64`: dort meldet
//      dasselbe `cpuid` "nein", und ein UNGESICHERTES `aesenc` stirbt
//      wirklich mit "Illegal instruction" (docs/RUNDE-AESNI.md 1.3).
//
//   2. IST DIE VEKTOREINHEIT FREIGESCHALTET? AES-NI rechnet in xmm,
//      und xmm ist ohne CR4.OSFXSR ein #UD -- auch mit AES-NI im
//      `cpuid`. Der Riegel heisst `fpu.enabled(state)` und kommt aus
//      Runde AVX. DIESE RUNDE SCHALTET NICHTS SELBST FREI: sie fragt
//      nur. Ist der Riegel zu (Kernwort `nofpu`), bleibt es bei der
//      Tabelle.
//
//   3. WERDEN DIE REGISTER BEIM KONTEXTWECHSEL GESICHERT? Das ist die
//      gefaehrlichste der drei, und sie ist die einzige, die diese
//      Runde NICHT selbst beantworten musste: Runde AVX hat den
//      Kontextwechsel gebaut (`fpu.save`/`restore`, eager, ein Rahmen
//      je Aufgabe) UND die Gegenprobe dazu (`nofpuswitch` -> `vec:
//      clean=0`). Ohne diese Sicherung wuerde AES im Kern still die
//      xmm-Register laufender Ring-3-Prozesse zerstoeren.
//
// WAS DARAUS FOLGT, und es steht hier, damit es niemand uebersieht:
// der schnelle Weg haengt an `fpu.enabled`. Wer die Vektoreinheit
// abschaltet, schaltet AES-NI mit ab -- nicht weil es sein muesste,
// sondern weil das Gegenteil ein stiller Datenverlust in fremden
// Prozessen waere.
//
// ============================================= WARUM KEIN EIGENER PUFFER
//
// Die Seite 0x120000 haelt nur Zaehler. Die Schluesselplaene (drei mal
// 240 Oktette) liegen in `lib/crypto/xts.fi` als Modulvariablen, und
// das ist Absicht: dieselbe Datei muss ohne `kstate` laufen. Geloescht
// werden sie von `krypto.lock_down` ueber `xts.forget` -- wer die
// Platte zusperrt, laesst hier keine Kopie zurueck.

import lib.kstate
import serial
import lib.kutil
import sched.time
import arch.x86_64.fpu
import crypto.aes
import crypto.aesni
import crypto.xts

export { apply, report, selftest, bench, have, used }

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, off, v)
}

// Die Befunde einsammeln und den Schalter stellen. Laeuft EINMAL beim
// Hochlauf, hinter `fpu.apply` -- vorher waere `fpu.enabled` noch
// nicht entschieden.
fn apply(state: u64) {
    let hat: bool = aesni.usable()
    let pcl: bool = aesni.pclmul_usable()
    s(state, kstate.AES_HAVE, kutil.yes(hat))
    s(state, kstate.AES_PCLMUL, kutil.yes(pcl))

    // Die drei Bedingungen. Jede einzeln abschaltbar, und jede mit
    // einem Grund.
    var an: bool = hat
    if !fpu.enabled(state) {
        // Punkt 2: ohne freigeschaltete Vektoreinheit waere schon das
        // erste `movdqu` ein #UD in Ring 0.
        an = false
    }
    if kstate.mode_on(state, kstate.M_NOAESNI) {
        // Die Gegenprobe von Hand -- damit sich auf DIESER Maschine
        // messen laesst, was der schnelle Weg bringt.
        an = false
    }
    xts.use_aesni(an)
    s(state, kstate.AES_USED, kutil.yes(an))
}

fn have(state: u64) -> bool {
    return g(state, kstate.AES_HAVE) != 0
}

fn used(state: u64) -> bool {
    return g(state, kstate.AES_USED) != 0
}

fn report(state: u64) {
    var s_a: [u8; 12] = "aesni: have\0"
    var s_b: [u8; 10] = "  pclmul=\0"
    var s_c: [u8; 8] = "  used=\0"
    var s_d: [u8; 7] = "  fpu=\0"
    var s_e: [u8; 2] = "=\0"
    serial.puts((&s_a[0]) as u64)
    serial.puts((&s_e[0]) as u64)
    serial.dec(g(state, kstate.AES_HAVE))
    serial.puts((&s_b[0]) as u64)
    serial.dec(g(state, kstate.AES_PCLMUL))
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, kstate.AES_USED))
    serial.puts((&s_d[0]) as u64)
    serial.dec(kutil.yes(fpu.enabled(state)))
    serial.nl()
}

// ===================================================== DIE KREISPROBE
//
// DIESELBEN EINGABEN DURCH BEIDE WEGE, byteweise verglichen. Das ist
// die Auflage dieser Runde, und sie laeuft IM KERN und nicht nur auf
// dem Wirt -- der Kern ist die Maschine, auf der es darauf ankommt.
//
// Geprueft werden alle drei Schluessellaengen und, als erstes, der
// Vektor aus FIPS 197 Anhang C.3 (AES-256). Ein Fehler in `dec_from`
// (das vergessene AESIMC) faellt genau dort auf.
fn selftest(state: u64) -> bool {
    if !used(state) {
        // Kein schneller Weg, nichts zu vergleichen. Das ist KEIN
        // Fehler -- auf einer Maschine ohne AES-NI ist die Tabelle der
        // richtige und einzige Weg.
        return true
    }
    var gleich: u64 = 0
    var ungleich: u64 = 0

    // FIPS 197 C.3: Schluessel 00..1f, Klartext 00112233..ff,
    // Geheimtext 8ea2b7ca516745bfeafc49904b496089.
    var key: [u8; 32] = [0 as u8; 32]
    var pt: [u8; 16] = [0 as u8; 16]
    var i: usize = 0
    while i < 32 {
        key[i] = i as u8
        i = i + 1
    }
    i = 0
    while i < 16 {
        pt[i] = (i * 0x11) as u8
        i = i + 1
    }
    var soll: [u8; 16] = [0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf,
        0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89]
    var k: aes.Key = aes.key_new()
    if !aes.key_set(&k, (&key[0]) as u64, 32) {
        return false
    }
    var e: aesni.Enc = aesni.enc_from((&k.rk[0]) as u64, k.nr)
    var got: [u8; 16] = [0 as u8; 16]
    if !aesni.encrypt_block(&e, (&pt[0]) as u64, (&got[0]) as u64) {
        return false
    }
    var diff: u64 = 0
    i = 0
    while i < 16 {
        diff = diff | ((got[i] as u64) ^ (soll[i] as u64))
        i = i + 1
    }
    if diff != 0 {
        s(state, kstate.AES_UNGL, 1)
        return false
    }
    gleich = gleich + 1

    // Und jetzt beide Wege gegeneinander, ueber alle drei Laengen und
    // ueber wechselnde Daten. Der Zufall ist ein xorshift -- er muss
    // nicht gut sein, er muss die Bloecke verschieden machen.
    var z: u64 = 0x9E3779B97F4A7C15
    var klen: usize = 16
    while klen <= 32 {
        var runde: usize = 0
        while runde < 64 {
            i = 0
            while i < klen {
                z = z ^ (z << 13)
                z = z ^ (z >> 7)
                z = z ^ (z << 17)
                key[i] = (z & 255) as u8
                i = i + 1
            }
            i = 0
            while i < 16 {
                z = z ^ (z << 13)
                z = z ^ (z >> 7)
                z = z ^ (z << 17)
                pt[i] = (z & 255) as u8
                i = i + 1
            }
            var kk: aes.Key = aes.key_new()
            if !aes.key_set(&kk, (&key[0]) as u64, klen) {
                ungleich = ungleich + 1
                runde = runde + 1
                continue
            }
            var tab: [u8; 16] = [0 as u8; 16]
            aes.encrypt_block(&kk, (&pt[0]) as u64, (&tab[0]) as u64)
            var ee: aesni.Enc = aesni.enc_from((&kk.rk[0]) as u64, kk.nr)
            var ni: [u8; 16] = [0 as u8; 16]
            aesni.encrypt_block(&ee, (&pt[0]) as u64, (&ni[0]) as u64)
            diff = 0
            i = 0
            while i < 16 {
                diff = diff | ((tab[i] as u64) ^ (ni[i] as u64))
                i = i + 1
            }
            if diff != 0 {
                ungleich = ungleich + 1
            } else {
                gleich = gleich + 1
            }
            // Und zurueck, ueber `dec_from`.
            var dd: aesni.Dec = aesni.dec_from((&kk.rk[0]) as u64, kk.nr)
            var back: [u8; 16] = [0 as u8; 16]
            aesni.decrypt_block(&dd, (&ni[0]) as u64, (&back[0]) as u64)
            diff = 0
            i = 0
            while i < 16 {
                diff = diff | ((back[i] as u64) ^ (pt[i] as u64))
                i = i + 1
            }
            if diff != 0 {
                ungleich = ungleich + 1
            } else {
                gleich = gleich + 1
            }
            runde = runde + 1
        }
        klen = klen + 8
    }
    s(state, kstate.AES_KREIS, gleich)
    s(state, kstate.AES_UNGL, ungleich)

    var s_k: [u8; 16] = "aesni: gleich=\0\0"
    var s_u: [u8; 12] = "  ungleich=\0"
    serial.puts((&s_k[0]) as u64)
    serial.dec(gleich)
    serial.puts((&s_u[0]) as u64)
    serial.dec(ungleich)
    serial.nl()
    return ungleich == 0
}

// ======================================================== DAS TEMPO
//
// EIN SEKTOR, so oft wie noetig. Gemessen wird der Weg, der WIRKLICH
// eingeschaltet ist -- mit `noaesni` misst dieselbe Zeile die Tabelle,
// und genau daraus wird der Faktor.
//
// GEZAEHLT WIRD IN TAKTEN (`rdtsc`) UND NICHT IN NANOSEKUNDEN, und das
// ist kein Geschmack: `time.mono_ns` braucht `TIME_KHZ`, und das steht
// an dieser Stelle des Hochlaufs noch auf null -- die erste Fassung
// dieser Messung meldete darum treu `ns512=0`. Takte gibt `rdtsc`
// immer her. Wer Sekunden will, teilt durch die Frequenz; der
// Abnahmelauf rechnet den Faktor ohnehin aus zwei Taktzahlen, und
// dafuer kuerzt sich die Frequenz heraus.
fn bench(state: u64) {
    var key: [u8; 64] = [0 as u8; 64]
    var i: usize = 0
    while i < 32 {
        key[i] = i as u8
        key[i + 32] = (0x40 + i) as u8
        i = i + 1
    }
    var buf: [u8; 512] = [0 as u8; 512]
    var out: [u8; 512] = [0 as u8; 512]
    i = 0
    while i < 512 {
        buf[i] = (i & 255) as u8
        i = i + 1
    }
    // Wenige Runden auf dem langsamen Weg, viele auf dem schnellen --
    // sonst dauert die Messung mit der Tabelle Minuten.
    var runden: u64 = 2000
    if !used(state) {
        runden = 20
    }
    let t0: u64 = time.tsc()
    var r: u64 = 0
    while r < runden {
        xts.sector_encrypt((&key[0]) as u64, r, (&buf[0]) as u64,
            (&out[0]) as u64, 512)
        r = r + 1
    }
    let t1: u64 = time.tsc()
    let je: u64 = (t1 -% t0) / runden
    s(state, kstate.AES_NS, je)
    // Wenn die Uhr schon geeicht ist, steht daneben auch MiB/s mal
    // hundert. Ist sie es nicht (TIME_KHZ == 0, der Normalfall an
    // dieser Stelle), bleibt die Zahl null und die Takte gelten.
    var mibs: u64 = 0
    let khz: u64 = time.khz(state)
    if je > 0 && khz > 0 {
        // Takte je Sektor -> Oktette je Sekunde -> MiB/s * 100.
        let bps: u64 = (512 *% khz *% 1000) / je
        mibs = (bps *% 100) / 1048576
    }
    s(state, kstate.AES_MIBS, mibs)
    var s_a: [u8; 16] = "aesni: takt512=\0"
    var s_b: [u8; 12] = "  mibs100=\0\0"
    var s_c: [u8; 8] = "  weg=\0\0"
    var s_d: [u8; 10] = "  runden=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(je)
    serial.puts((&s_b[0]) as u64)
    serial.dec(mibs)
    serial.puts((&s_d[0]) as u64)
    serial.dec(runden)
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, kstate.AES_USED))
    serial.nl()
}
