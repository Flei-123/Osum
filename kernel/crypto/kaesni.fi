
import lib.kstate
import serial
import lib.kutil
import sched.time
import arch.x86_64.fpu
import crypto.aes
import crypto.aesni
import crypto.xts
import libc.numeric

export { apply, report, selftest, bench, have, used }

fn apply(state: u64) {
    let hat: bool = aesni.usable()
    let pcl: bool = aesni.pclmul_usable()
    kstate.set(state, kstate.AES_HAVE, numeric.yes(hat))
    kstate.set(state, kstate.AES_PCLMUL, numeric.yes(pcl))

    var an: bool = hat
    if !fpu.enabled(state) {
        an = false
    }
    if kstate.mode_on(state, kstate.M_NOAESNI) {
        an = false
    }
    xts.use_aesni(an)
    kstate.set(state, kstate.AES_USED, numeric.yes(an))
}

fn have(state: u64) -> bool {
    return kstate.get(state, kstate.AES_HAVE) != 0
}

fn used(state: u64) -> bool {
    return kstate.get(state, kstate.AES_USED) != 0
}

fn report(state: u64) {
    var s_a: [u8; 12] = "aesni: have\0"
    var s_b: [u8; 10] = "  pclmul=\0"
    var s_c: [u8; 8] = "  used=\0"
    var s_d: [u8; 7] = "  fpu=\0"
    var s_e: [u8; 2] = "=\0"
    serial.puts((&s_a[0]) as u64)
    serial.puts((&s_e[0]) as u64)
    serial.dec(kstate.get(state, kstate.AES_HAVE))
    serial.puts((&s_b[0]) as u64)
    serial.dec(kstate.get(state, kstate.AES_PCLMUL))
    serial.puts((&s_c[0]) as u64)
    serial.dec(kstate.get(state, kstate.AES_USED))
    serial.puts((&s_d[0]) as u64)
    serial.dec(numeric.yes(fpu.enabled(state)))
    serial.nl()
}

fn selftest(state: u64) -> bool {
    if !used(state) {
        return true
    }
    var same: u64 = 0
    var ungleich: u64 = 0

    var key: [u8; 32] = [0 as u8; 32]
    var pt: [u8; 16] = [0 as u8; 16]
    var i: usize = 0
    while i < 32 {
        key[i] = i as u8
        i = i + 1
    }
    i = 0
    while i < 16 {
        pt[i] = (i * 0x11) as u8
        i = i + 1
    }
    var soll: [u8; 16] = [0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf,
        0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89]
    var k: aes.Key = aes.key_new()
    if !aes.key_set(&k, (&key[0]) as u64, 32) {
        return false
    }
    var e: aesni.Enc = aesni.enc_from((&k.rk[0]) as u64, k.nr)
    var got: [u8; 16] = [0 as u8; 16]
    if !aesni.encrypt_block(&e, (&pt[0]) as u64, (&got[0]) as u64) {
        return false
    }
    var diff: u64 = 0
    i = 0
    while i < 16 {
        diff = diff | ((got[i] as u64) ^ (soll[i] as u64))
        i = i + 1
    }
    if diff != 0 {
        kstate.set(state, kstate.AES_UNGL, 1)
        return false
    }
    same = same + 1

    var z: u64 = 0x9E3779B97F4A7C15
    var klen: usize = 16
    while klen <= 32 {
        var runde: usize = 0
        while runde < 64 {
            i = 0
            while i < klen {
                z = z ^ (z << 13)
                z = z ^ (z >> 7)
                z = z ^ (z << 17)
                key[i] = (z & 255) as u8
                i = i + 1
            }
            i = 0
            while i < 16 {
                z = z ^ (z << 13)
                z = z ^ (z >> 7)
                z = z ^ (z << 17)
                pt[i] = (z & 255) as u8
                i = i + 1
            }
            var kk: aes.Key = aes.key_new()
            if !aes.key_set(&kk, (&key[0]) as u64, klen) {
                ungleich = ungleich + 1
                runde = runde + 1
                continue
            }
            var tab: [u8; 16] = [0 as u8; 16]
            aes.encrypt_block(&kk, (&pt[0]) as u64, (&tab[0]) as u64)
            var ee: aesni.Enc = aesni.enc_from((&kk.rk[0]) as u64, kk.nr)
            var ni: [u8; 16] = [0 as u8; 16]
            aesni.encrypt_block(&ee, (&pt[0]) as u64, (&ni[0]) as u64)
            diff = 0
            i = 0
            while i < 16 {
                diff = diff | ((tab[i] as u64) ^ (ni[i] as u64))
                i = i + 1
            }
            if diff != 0 {
                ungleich = ungleich + 1
            } else {
                same = same + 1
            }
            var dd: aesni.Dec = aesni.dec_from((&kk.rk[0]) as u64, kk.nr)
            var back: [u8; 16] = [0 as u8; 16]
            aesni.decrypt_block(&dd, (&ni[0]) as u64, (&back[0]) as u64)
            diff = 0
            i = 0
            while i < 16 {
                diff = diff | ((back[i] as u64) ^ (pt[i] as u64))
                i = i + 1
            }
            if diff != 0 {
                ungleich = ungleich + 1
            } else {
                same = same + 1
            }
            runde = runde + 1
        }
        klen = klen + 8
    }
    kstate.set(state, kstate.AES_KREIS, same)
    kstate.set(state, kstate.AES_UNGL, ungleich)

    var s_k: [u8; 16] = "aesni: gleich=\0\0"
    var s_u: [u8; 12] = "  ungleich=\0"
    serial.puts((&s_k[0]) as u64)
    serial.dec(same)
    serial.puts((&s_u[0]) as u64)
    serial.dec(ungleich)
    serial.nl()
    return ungleich == 0
}

fn bench(state: u64) {
    var key: [u8; 64] = [0 as u8; 64]
    var i: usize = 0
    while i < 32 {
        key[i] = i as u8
        key[i + 32] = (0x40 + i) as u8
        i = i + 1
    }
    var buf: [u8; 512] = [0 as u8; 512]
    var out: [u8; 512] = [0 as u8; 512]
    i = 0
    while i < 512 {
        buf[i] = (i & 255) as u8
        i = i + 1
    }
    var runden: u64 = 2000
    if !used(state) {
        runden = 20
    }
    let t0: u64 = time.tsc()
    var r: u64 = 0
    while r < runden {
        xts.sector_encrypt((&key[0]) as u64, r, (&buf[0]) as u64,
            (&out[0]) as u64, 512)
        r = r + 1
    }
    let t1: u64 = time.tsc()
    let je: u64 = (t1 -% t0) / runden
    kstate.set(state, kstate.AES_NS, je)
    var mibs: u64 = 0
    let khz: u64 = time.khz(state)
    if je > 0 && khz > 0 {
        let bps: u64 = (512 *% khz *% 1000) / je
        mibs = (bps *% 100) / 1048576
    }
    kstate.set(state, kstate.AES_MIBS, mibs)
    var s_a: [u8; 16] = "aesni: takt512=\0"
    var s_b: [u8; 12] = "  mibs100=\0\0"
    var s_c: [u8; 8] = "  weg=\0\0"
    var s_d: [u8; 10] = "  rounds=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(je)
    serial.puts((&s_b[0]) as u64)
    serial.dec(mibs)
    serial.puts((&s_d[0]) as u64)
    serial.dec(runden)
    serial.puts((&s_c[0]) as u64)
    serial.dec(kstate.get(state, kstate.AES_USED))
    serial.nl()
}
