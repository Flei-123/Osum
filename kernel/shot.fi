// SPDX-License-Identifier: GPL-2.0-only
// kernel/shot.fi -- Runde FEEDBACK: DAS BILDSCHIRMFOTO, VON INNEN.
//
// WARUM ES DAS BIS HIERHER NICHT GAB. Osum wird seit Runde K7 in
// Bildern gemessen, und JEDES dieser Bilder kommt von AUSSEN: `tools/*`
// sagen QEMU ueber den Monitor `screendump`, und QEMU legt ein PPM
// neben die virtuelle Maschine. Das ist fuer eine Abnahme genau
// richtig -- der Wirt sieht, was die Karte zeigt, und kann nicht von
// einem Fehler im Kern belogen werden. Fuer einen Menschen, der einen
// Fehler MELDEN will, ist es nichts wert: er hat keinen QEMU-Monitor,
// er hat einen Bildschirm.
//
// ES GIBT AUCH KEINEN UMWEG. Ring 3 kommt an den Rahmenpuffer nur
// ueber `mmap` auf `/dev/fb` (Runde K7, `fb.USER_BASE`), und das ist
// ein Geraet, das der Wurzel gehoert -- und es liefert die TAFEL, nicht
// das zusammengesetzte Bild: bei doppelter Pufferung (Runde DISPLAY)
// steht dort, was zuletzt uebertragen wurde, und waehrend eines
// Durchlaufs des Fensterservers auch nur die halbe Wahrheit. Was ein
// Bildschirmfoto zeigen soll, ist das, WORAUF GEZEICHNET WIRD
// (`fb.draw_at`), und das kennt nur der Kern.
//
// ====================================================================
// DIE SICHERHEITSFRAGE, ausdruecklich und zuerst.
// ====================================================================
//
// Ein Aufruf, der den Bildschirminhalt herausgibt, ist der maechtigste
// Lesezugriff, den ein System hat. Auf dem Bildschirm steht das
// Passwortfeld, die Nachricht, die gerade offen ist, der Kontostand.
// Ein beliebiges Programm darf das NICHT bekommen, und "es fragt ja
// vorher" ist keine Antwort, wenn das Fragen dasselbe Programm
// uebernimmt, das mitlesen will.
//
// DREI SCHLOESSER, und ein Bild kommt nur heraus, wenn eines davon
// wirklich aufgeht:
//
//   1. DER SCHEIN (`ARM`). Ein Bildschirmfoto braucht einen EINMALIGEN,
//      BEFRISTETEN Schein, ausgestellt auf EINE Prozessnummer. Wer
//      keinen hat, bekommt -E_RIGHTS, und der Zaehler `denied` geht um
//      eins hoch.
//
//   2. WER EINEN SCHEIN AUSSTELLEN DARF. Nicht das Programm, das
//      fotografieren will. Sondern
//        * die TASKLEISTE -- ein Prozess, der einen Bildschirmrand
//          belegt hat (`WM_STRUT`, und den darf nur die Wurzel). Das
//          ist dieselbe Pruefung, die seit Runde DESKTOP entscheidet,
//          wer fremde Fenstertitel sehen darf (`ist_leiste` in
//          sys.fi), und sie ist hier aus demselben Grund richtig: die
//          Bedienoberflaeche ist die Stelle, die den Menschen fragen
//          KANN, eine Anwendung ist es nicht. Das ist der Gedanke
//          hinter Waylands Portalen, mit den Mitteln, die dieses
//          System hat.
//        * die WURZEL. Wer euid 0 ist, kann ohnehin den Kern lesen;
//          ihm ein Bildschirmfoto zu verweigern waere Theater.
//
//   3. DIE TASTE (`KEY`). Der uebliche Weg auf jeder Maschine: der
//      Mensch drueckt die Bildschirmfoto-Taste. Ein Programm darf sich
//      DANN selbst einen Schein ausstellen -- aber nur, wenn ALLE vier
//      Bedingungen zugleich gelten, und der Kern prueft sie, nicht das
//      Programm:
//        a) der letzte Tastendruck war Super+P,
//        b) er ist weniger als GRACE_NS her (drei Sekunden),
//        c) diese Tastenfolge hat noch KEINEN Schein bekommen -- eine
//           Zaehlernummer, ein Bild,
//        d) der Rufende besitzt das Fenster MIT DEM EINGABEFOKUS. Ein
//           Programm im Hintergrund kann die Taste eines anderen nicht
//           abfangen.
//
// UND ES GESCHIEHT NIE UNBEMERKT. `INFO` gibt jedem Programm und jedem
// Menschen ohne jedes Recht Auskunft: wie viele Bildschirmfotos es seit
// dem Start gab, wer das letzte gemacht hat, ob gerade ein Schein offen
// ist und fuer wen, und wie viele Versuche abgelehnt wurden. Ein
// heimliches Mitlesen gibt es nicht, weil das Mitlesen gezaehlt wird --
// und ausserdem sagt der Kern jedes Bild auf der seriellen Schnittstelle
// an (`shot: pid=... 800x600`), damit es auch im Protokoll steht.
//
// WAS DAS NICHT LEISTET, ehrlich: es gibt KEINE Rueckfrage IM KERN.
// Fragt die Taskleiste den Menschen nicht, bevor sie einen Schein
// ausstellt, dann fragt niemand. Der Kern kann das nicht erzwingen --
// er kann nur festlegen, WER gefragt haben muss, und das tut er. Das
// Programm dieser Runde (`kernel/user/feedback.fi`) zeigt das Bild vor
// dem Senden und schickt ohne Bestaetigung nichts weg.
//
// ==================================================================
// DIE FORM, IN DER DAS BILD HERAUSKOMMT
// ==================================================================
//
// DREI OKTETTE JE BILDPUNKT, R, G, B, zeilenweise von oben links.
// Nicht die vier Oktette der Karte: deren Anordnung haengt von
// `S_RSHIFT`/`S_GSHIFT`/`S_BSHIFT` ab, und ein Programm in Ring 3
// muesste sie kennen, um daraus eine Farbe zu machen. Der Kern weiss
// sie ohnehin und legt sie hier zurecht -- damit ist die Schnittstelle
// dieselbe auf jeder Karte, und sie ist ZUGLEICH genau das, was PNG als
// Farbart 2 verlangt (RFC 2083, 8 Bit je Anteil).
//
// IN BAENDERN, nicht in einem Stueck. 800 x 600 x 3 sind 1 440 000
// Oktette; ein Prozess hat zwischen `proc.IMAGE_BASE` und
// `proc.IMAGE_END` ein Megaoktett. Ein Systemaufruf, der eineinhalb
// Megaoktett am Stueck kopiert, haette ausserdem den Kern fuer die
// Dauer belegt. Also holt der Rufende `MAX_CHUNK` Oktette je Aufruf,
// immer GANZE Zeilen, und der Schein merkt sich, welche Zeile als
// naechstes dran ist. Wer bei Zeile 0 anfaengt und bis zum Ende liest,
// hat ein Bild; wer dazwischen aufhoert, verliert den Schein.
//
// UND WAS SICH WAEHRENDDESSEN BEWEGT, kann in zwei Baendern
// verschieden aussehen. Das ist der Preis der Baender und wird hier
// benannt statt versteckt: `tools/feedback/run.sh` misst mit
// stillstehendem Bild (`wmhold`), und das Programm der Runde fotografiert
// in dem Augenblick, in dem der Mensch den Knopf drueckt -- da bewegt
// sich nichts.

profile kernel

import kstate
import fb
import time
import serial

export {
    init, ready, width, height, row_bytes, image_bytes, rows_per_chunk,
    arm, armed, arm_pid, arm_deadline, next_row, drop, may_grab,
    advance, shots, denied, deny, arms, last_pid, keyseq, set_keyseq,
    rgb_at, say,
    KEY, KEY_UPPER, GRACE_NS, TICKET_NS, MAX_CHUNK
}

// ------------------------------------------------------------ die Zahlen

// Super+P. Klein und gross, weil die Umschalttaste beim Halten von
// Super mitgedrueckt sein kann und der Tastaturtreiber dann `P` latcht.
const KEY: u64 = 112 // 'p'
const KEY_UPPER: u64 = 80 // 'P'

// Wie lange ein Tastendruck einen Schein wert ist. Drei Sekunden: lang
// genug, dass ein Programm zwischen zwei Durchlaeufen seiner Schleife
// nachsieht, kurz genug, dass ein Druck von vorhin keinen Schein mehr
// gibt.
const GRACE_NS: u64 = 3000000000

// Wie lange ein Schein gilt.
//
// RUNDE BRIDGE-2 HAT DIESE ZAHL VERDOPPELT, und zwar aus einer Messung
// und nicht aus Vorsicht. FEEDBACK sagte "zehn Sekunden reichen fuer 600
// Zeilen" -- das galt fuer einen Leser, der die Baender nur einsammelt.
// `jarvisd -f` schreibt sie WAEHREND des Holens auf die Platte, und
// Osums `write` legt hoechstens einen Block (4096 Oktette) je Aufruf ab:
// ein Bild von 1280x800 sind 3 MiB, also 750 Schreibvorgaenge auf eine
// virtuelle IDE-Platte. Gemessen wurden damit 555 von 800 Zeilen, dann
// war der Schein abgelaufen und der Kern hat -- richtigerweise --
// aufgehoert.
//
// SECHZIG SEKUNDEN, und die Zahl ist gemessen und nicht gegriffen.
//
// Der Grund liegt nicht am Bildschirmfoto, sondern an dem, was der
// Rufende damit tut. `jarvisd -f` schreibt die Baender waehrend des
// Holens auf die Platte, und Osums `write` legt hoechstens EINEN Block
// (`fs.BS` = 512 Oktette) je Aufruf ab -- ein Bild von 1280x800 sind
// 3 072 000 Oktette, also sechstausend Schreibaufrufe auf eine
// virtuelle IDE-Platte. Gemessen wurden dabei rund 102 KiB/s, macht
// etwa 30 Sekunden fuer ein Bild; mit einem Schein von 20 Sekunden kam
// das Bild bei 544 von 800 Zeilen zum Stehen (und beim zweiten Lauf bei
// 578 -- eine Zeitgrenze sieht genau so aus).
//
// SECHZIG SEKUNDEN SIND ALSO DAS DOPPELTE DES GEMESSENEN und keine
// runde Zahl aus Vorsicht. Der Schein bleibt, was er war: ein Recht,
// das jemand hat, waehrend er es braucht -- er soll so lange gelten,
// wie das Bild dauert, und keinen Augenblick laenger. Wird das Schreiben
// auf der Platte einmal schneller (ein `write`, das mehr als einen Block
// nimmt), gehoert diese Zahl wieder herunter.
const TICKET_NS: u64 = 60000000000

// Hoechstens so viele Oktette je Aufruf.
const MAX_CHUNK: u64 = 65536

// ------------------------------------------------------------ die Seite
//
// SHOT_OFF ist 0x85000. Eine ganze Seite fuer neun Woerter ist
// verschwenderisch und trotzdem richtig: die Runden K10 und K11 haben
// sich eine Seite geteilt, und Runde NETVIEW hat einen Tag damit
// verbracht, dass zwei Runden auf denselben acht Oktetten standen.
//
// RUNDE BRIDGE-2: DIE ZAHL IST NICHT MEHR DIE VON FEEDBACK. Dort stand
// 0x7B000, weil `kstate.fi` das damals als frei auswies. In `merge6`
// liegt dort der AHCI-Treiber (fuenf Seiten), und HANDLE endet bei
// 0x84380. 0x85000 ist die naechste Seitengrenze dahinter und liegt vor
// TASK_OFF (0x88000) -- gemessen mit tools/kernel/memmap.py, das genau
// diese Art Kollision ausrechnet.

const S_ARMED: u64 = 0x00 // 1 = ein Schein ist offen
const S_APID: u64 = 0x08 // fuer welche Prozessnummer
const S_DEADLINE: u64 = 0x10 // monotone Zeit, ab der er nichts mehr gilt
const S_NEXT: u64 = 0x18 // welche Bildzeile als naechstes geholt werden darf
const S_SHOTS: u64 = 0x20 // fertige Bildschirmfotos seit dem Start
const S_DENIED: u64 = 0x28 // abgelehnte Versuche
const S_ARMS: u64 = 0x30 // ausgestellte Scheine
const S_LASTPID: u64 = 0x38 // wer das letzte Bild bekommen hat
const S_KEYSEQ: u64 = 0x40 // die Tastenfolge, die zuletzt einen Schein gab

// Die drei Farbverschiebungen INNERHALB von `fb.FB_OFF`. Sie stehen so
// in kernel/fb.fi (S_RSHIFT/S_GSHIFT/S_BSHIFT); `fb.fi` gibt sie in
// diesem Zweig nicht heraus, und `tools/bridge/run.sh` rechnet nach,
// dass die drei Zahlen hier und dort dieselben sind.
const FBS_RSHIFT: u64 = 0x0A8
const FBS_GSHIFT: u64 = 0x0B0
const FBS_BSHIFT: u64 = 0x0B8

fn gs(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.SHOT_OFF + off)
}

fn ss(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.SHOT_OFF + off, v)
}

fn init(state: u64) {
    ss(state, S_ARMED, 0)
    ss(state, S_APID, 0)
    ss(state, S_DEADLINE, 0)
    ss(state, S_NEXT, 0)
    ss(state, S_SHOTS, 0)
    ss(state, S_DENIED, 0)
    ss(state, S_ARMS, 0)
    ss(state, S_LASTPID, 0)
    // 0 hiesse "die Tastenfolge 0 hat schon einen Schein bekommen", und
    // der Zaehler in kbd.fi faengt bei 0 an. Ein Wert, den es nie gibt,
    // ist der richtige Anfangswert.
    ss(state, S_KEYSEQ, 0xFFFFFFFFFFFFFFFF)
}

// ------------------------------------------------------------ die Masse

fn ready(state: u64) -> bool {
    if !fb.ready(state) {
        return false
    }
    if fb.bpp(state) != 32 {
        return false
    }
    return fb.width(state) != 0 && fb.height(state) != 0
}

fn width(state: u64) -> u64 {
    return fb.width(state)
}

fn height(state: u64) -> u64 {
    return fb.height(state)
}

// Drei Oktette je Bildpunkt. `*%` ist hier keine Nachlaessigkeit: die
// Breite kommt aus dem Rahmenpuffer und ist keine Zahl, mit der jemand
// rechnet, sondern ein Mass -- und ein Kern, der beim Ausrechnen einer
// Bildzeilenlaenge anhaelt, ist schlimmer als einer ohne Bildschirmfoto.
fn row_bytes(state: u64) -> u64 {
    return fb.width(state) *% 3
}

fn image_bytes(state: u64) -> u64 {
    return row_bytes(state) *% fb.height(state)
}

// Wie viele GANZE Zeilen in ein Band passen. Nie null, solange eine
// Zeile ueberhaupt in MAX_CHUNK passt -- und 800 x 3 = 2400 passt.
fn rows_per_chunk(state: u64) -> u64 {
    let rb: u64 = row_bytes(state)
    if rb == 0 || rb > MAX_CHUNK {
        return 0
    }
    return MAX_CHUNK / rb
}

// --------------------------------------------------------- ein Bildpunkt
//
// Aus dem Wort der Karte werden drei Anteile. Gelesen wird aus dem ZIEL
// des Zeichnens (`fb.get_pixel` nimmt `S_DRAW`) -- also aus dem
// Zweitpuffer, wenn es einen gibt, und das ist genau das Bild, das der
// Fensterserver gerade zusammengesetzt hat.
// RUNDE BRIDGE-2: DIE DREI VERSCHIEBUNGEN KOMMEN AUS DEM ZUSTAND.
// Runde FEEDBACK hatte dafuer `fb.rshift/gshift/bshift` in `fb.fi`
// ergaenzt. In `merge6` gibt es die drei nicht, und `fb.fi` ist dort
// eine Datei, die seit FEEDBACK von mehreren Runden angefasst wurde --
// sie hier zu aendern hiesse, in einen fremden Zweig zu schreiben.
// Also liest diese Datei dieselben drei Skalare selbst. Es sind
// GENAU die, aus denen `fb.rgb` sein Wort baut (fb.fi: `rgb`), also
// keine abgeschriebene Zahl, sondern dieselbe Quelle.
fn rgb_at(state: u64, x: u64, y: u64) -> u64 {
    let v: u64 = fb.get_pixel(state, x, y)
    let r: u64 = (v >> kstate.get(state, fb.FB_OFF + FBS_RSHIFT)) & 0xFF
    let g: u64 = (v >> kstate.get(state, fb.FB_OFF + FBS_GSHIFT)) & 0xFF
    let b: u64 = (v >> kstate.get(state, fb.FB_OFF + FBS_BSHIFT)) & 0xFF
    return (r << 16) | (g << 8) | b
}

// --------------------------------------------------------- der Schein

fn armed(state: u64) -> bool {
    if gs(state, S_ARMED) == 0 {
        return false
    }
    // Ein abgelaufener Schein ist keiner. Er wird beim Nachsehen
    // eingezogen und nicht erst, wenn jemand ihn benutzen will --
    // sonst behauptete `INFO` weiter, es sei einer offen.
    if time.mono_ns(state) > gs(state, S_DEADLINE) {
        drop(state)
        return false
    }
    return true
}

fn arm_pid(state: u64) -> u64 {
    return gs(state, S_APID)
}

fn arm_deadline(state: u64) -> u64 {
    return gs(state, S_DEADLINE)
}

fn next_row(state: u64) -> u64 {
    return gs(state, S_NEXT)
}

// DER SCHEIN WIRD ANGESAGT, NICHT DAS BILD.
//
// Die erste Fassung sagte das fertige Bild an -- und genau das machte
// die Abnahme unmoeglich: die Zeile geht ueber `serial.puts`, und mit
// `gfx` spiegelt `serial.put` jedes Oktett AUF DEN BILDSCHIRM. Sie
// erschien also NACH dem Lesen der letzten Zeile, stand im Bild des
// Wirtes und fehlte im Bild von innen -- zwei Bilder, die sich um genau
// die Zeile unterscheiden, die sagt, dass eines gemacht wurde.
//
// Beim Ausstellen des Scheins steht sie VOR dem Lesen und damit in
// BEIDEN Bildern. Und sie sagt ohnehin das Richtigere: gemeldet gehoert
// der Augenblick, in dem jemand das Recht bekommt, und nicht der, in
// dem er es aufgebraucht hat.
fn arm(state: u64, pid: u64) {
    say(state, pid)
    ss(state, S_ARMED, 1)
    ss(state, S_APID, pid)
    ss(state, S_DEADLINE, time.mono_ns(state) +% TICKET_NS)
    ss(state, S_NEXT, 0)
    kstate.add(state, kstate.SHOT_OFF + S_ARMS, 1)
}

fn drop(state: u64) {
    ss(state, S_ARMED, 0)
    ss(state, S_APID, 0)
    ss(state, S_DEADLINE, 0)
    ss(state, S_NEXT, 0)
}

// Darf DIESE Prozessnummer jetzt bei DIESER Zeile weiterlesen?
fn may_grab(state: u64, pid: u64, from: u64) -> bool {
    if !armed(state) {
        return false
    }
    if gs(state, S_APID) != pid {
        return false
    }
    return gs(state, S_NEXT) == from
}

// Nach einem Band: die Zeilenmarke weiterruecken. War es das letzte
// Band, ist das Bild fertig, der Schein verbraucht und der Zaehler um
// eins hoeher.
fn advance(state: u64, rows: u64) {
    let n: u64 = gs(state, S_NEXT) + rows
    ss(state, S_NEXT, n)
    if n >= fb.height(state) {
        ss(state, S_LASTPID, gs(state, S_APID))
        kstate.add(state, kstate.SHOT_OFF + S_SHOTS, 1)
        drop(state)
    }
}

fn shots(state: u64) -> u64 {
    return gs(state, S_SHOTS)
}

fn denied(state: u64) -> u64 {
    return gs(state, S_DENIED)
}

// Eine Ablehnung wird GEZAEHLT. Das ist die Haelfte von
// "nicht unbemerkt", die den Versuch betrifft und nicht das Bild.
fn deny(state: u64) {
    kstate.add(state, kstate.SHOT_OFF + S_DENIED, 1)
}

fn arms(state: u64) -> u64 {
    return gs(state, S_ARMS)
}

fn last_pid(state: u64) -> u64 {
    return gs(state, S_LASTPID)
}

fn keyseq(state: u64) -> u64 {
    return gs(state, S_KEYSEQ)
}

fn set_keyseq(state: u64, v: u64) {
    ss(state, S_KEYSEQ, v)
}

// Ein Bildschirmfoto steht IM PROTOKOLL. Das ist die zweite Haelfte von
// "es geschieht nicht unbemerkt": `INFO` muss man fragen, diese Zeile
// steht da, ohne dass jemand fragt.
fn say(state: u64, pid: u64) {
    var label: [u8; 12] = "shot: pid=\0\0"
    serial.puts((&label[0]) as u64)
    serial.dec(pid)
    var mid: [u8; 2] = " \0"
    serial.puts((&mid[0]) as u64)
    serial.dec(fb.width(state))
    var x: [u8; 2] = "x\0"
    serial.puts((&x[0]) as u64)
    serial.dec(fb.height(state))
    serial.put(10 as u8)
}
