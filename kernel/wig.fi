// SPDX-License-Identifier: GPL-2.0-only
// kernel/wig.fi -- Runde K15: DIE NAHT ZWISCHEN FENSTERSERVER UND
// ANWENDUNG. Und sie ist absichtlich duenn.
//
// Runde K10 hat den Fensterserver gebaut: eine Anwendung bekommt ein
// Rechteck, malt hinein und holt Ereignisse ab. Was zwischen diesem
// Rechteck und einer Anwendung fehlt, ist alles, was eine Anwendung
// wirklich braucht -- Knoepfe, Beschriftungen, Textfelder, Listen,
// Menues, Reiter, Dialoge, eine Ereignisschleife, eine Anordnung.
//
// DAS GEHOERT NICHT IN DEN KERNEL. Es steht in `kernel/user/wlib.fi`,
// in Ring 3, und wird von jedem Programm mitgebunden, das eine
// Oberflaeche hat. Ein Kernel, der weiss, wie ein Knopf aussieht, ist
// kein Kernel mehr.
//
// WAS DANN HIER STEHT, und warum es hier stehen MUSS -- fuenf Dinge,
// jedes mit einem Grund, den man nicht in Ring 3 aufloesen kann:
//
//   1. EIN RECHTECK AUS DEM SPEICHER DER ANWENDUNG IN DAS FENSTER.
//      Runde K10 gab Ring 3 `WM_FILL` (ein Rechteck einer Farbe) und
//      `WM_TEXT` (eine Zeile). Eine Widget-Bibliothek malt Verlaeufe,
//      Fokusringe, Bildlaufleisten, halbdurchsichtige Auswahlfarben und
//      kantengeglaetteten Text in beliebiger Farbe. Das als Folge von
//      Systemaufrufen zu malen waere je Bildpunktzeile ein Aufruf.
//      Also malt die Bibliothek in IHREN EIGENEN Speicher und schiebt
//      das fertige Rechteck mit EINEM Aufruf hinueber. Der Kernel
//      kopiert und beschmutzt genau dieses Rechteck -- nicht das ganze
//      Fenster; das ist der Unterschied, den `nodirty` sichtbar macht.
//   2. EINE GLYPHE ALS DECKUNGSFELD. Der TrueType-Rasterer liegt im
//      Kernel (`kernel/ttf.fi`), sein Arbeitsbereich ist ein halbes
//      Megabyte aus dem Rahmenverwalter, und sein Zwischenspeicher ist
//      der Grund, warum eine Textzeile 78 Mikrosekunden kostet statt
//      47 Millisekunden. Ring 3 fragt hier nach den DECKUNGSWERTEN
//      einer Glyphe und mischt sie SELBST -- damit gehoert die Farbe,
//      der Beschnitt und der Auswahlhintergrund der Bibliothek, und der
//      Kernel bleibt bei dem, was nur er hat.
//   3. DIE UNTERSCHNEIDUNG. Sie steht in der `kern`-Tabelle der
//      Schrift, die der Kernel gelesen hat. Ohne sie setzt Ring 3 den
//      Text anders als der Server die Titelleiste -- und ein Pruefer,
//      der beides gegen dieselbe zweite Rasterung haelt, faellt.
//   4. DIE ZWISCHENABLAGE. Sie ist per Definition das, was ZWEI
//      Prozesse teilen. In Ring 3 waere sie ein Prozess, den es nicht
//      gibt, oder eine Datei, die kein Prozess dem anderen ankuendigen
//      kann. Vier Kilooktett im Kernel, und der Fall ist erledigt.
//   5. DAS ZEIGERBILD. Der Zeiger wird vom Server gemalt, nicht von der
//      Anwendung -- er liegt UEBER allen Fenstern. Wer ihn ueber einem
//      Textfeld zu einem Balken machen will, muss es dem Server sagen.
//
// WAS HIER NICHT STEHT UND WARUM. Keine Fensterhierarchie, keine
// Unterfenster, kein Beschnittstapel, keine Ereignisverteilung an
// Widgets. Das sind alles Begriffe der Bibliothek; der Kernel kennt
// Fenster und Rechtecke und sonst nichts.
//
// SPEICHER: eine einzige Seitengruppe von `kdata` (kstate.WIG_OFF,
// 0x46000..0x49000, drei Seiten):
//
//   +0x0000  die Skalare
//   +0x1000  die Zwischenablage, 4096 Oktette
//   +0x2000  der Umschlagpuffer -- EINE Bildpunktzeile oder EINE Glyphe
//
// Der Umschlagpuffer ist der Grund, warum diese Runde nichts aus dem
// Kernelhaufen nimmt: er ist 256 KiB gross und gehoert allen.

profile kernel

import kstate
import proc
import arch.x86_64.guard
import wm
import ttf
import arch.arch
// RUNDE MERGE-6: welcher Kern zeichnet gerade -- fuer die Buehnensperre.
import cpu

export {
    init, ready,
    blit, glyph_into, kern_of, clip_set, clip_get, clip_len,
    set_icon_font, icon_font, F_UI, F_MONO, F_ICON, FONT_ROLES,
    shape, set_shape,
    blits, rows_copied, pixels, glyph_calls, clip_writes, clip_reads,
    buehne_verloren, stage_of, glyph_build,
    race_ready, race_soll, race_core, race_char, RACE_PX,
    fetch,
    selftest, selftest_max,
    CLIP_MAX, G_HDR, MAX_ROW, stuecke
}

// ------------------------------------------------------- die Zahlen

const CLIP_OFF: u64 = 0x1000
const CLIP_MAX: u64 = 4096
const STAGE_OFF: u64 = 0x2000
const STAGE_MAX: u64 = 4096

// Wie viele Bildpunkte AUF EINMAL durch den Umschlagpuffer passen.
// 4096 / 4 = 1024. Steht hier als Rechnung und nicht als Zahl, damit
// ein groesserer Puffer nicht vergessen wird.
//
// RUNDE SCHIRM-ECHT: DAS WAR EINMAL DIE BREITESTE ZEILE UEBERHAUPT --
// UND DAMIT DIE HALBE OBERFLAECHE AUF JEDEM SCHIRM UEBER 1024.
//
// `blit` hat bis hierher jede Zeile ABGELEHNT, die breiter war
// (`w > MAX_ROW -> return 0`). Der Kommentar sagte den Grund selbst:
// "und der Bildschirm dieser Runde ist 800 breit". Auf 1280x800 sind
// Schreibtisch und Taskleiste aber 1280 breit; ihr `push` kam nie an,
// ihr Fensterpuffer behielt die Farbe aus `wm.create`, und weil ohne
// Blit auch kein `wm.damage` laeuft, war die Leiste im Bild nicht
// vorhanden. GEMESSEN 03.09.2026: gezeichneter Inhalt 24..650 x 40..443
// von 1280x800 -- genau die beiden Fenster, die SCHMALER als 1024 sind
// (Terminal 564, Starter 444). Mit `fbres=800x600` war alles heil.
//
// Jetzt ist MAX_ROW die Groesse EINES UMSCHLAGS und keine Schranke:
// eine breitere Zeile wird in `stuecke(w)` Umschlaege zerlegt. Der
// Puffer bleibt eine Seite, die Speicherkarte bleibt unberuehrt.
const MAX_ROW: u64 = 1024 // STAGE_MAX / 4

// Wie viele Umschlaege eine Zeile von `w` Bildpunkten braucht. Steht
// als eigene Funktion da, weil der Selbsttest sie nachrechnet -- eine
// Zerlegung, die niemand nachprueft, ist eine Behauptung.
fn stuecke(w: u64) -> u64 {
    if w == 0 {
        return 0
    }
    return (w + MAX_ROW - 1) / MAX_ROW
}

// Der Kopf eines Deckungsfeldes, sechs Woerter, danach w*h Oktette:
//   +0 Breite  +8 Hoehe  +16 links  +24 oben  +32 Laufweite in 26.6
//   +40 Oktette der Deckung
const G_HDR: u64 = 48

// Die Skalare
const S_READY: u64 = 0x000
const S_CLIPLEN: u64 = 0x008
const S_BLITS: u64 = 0x010
const S_ROWS: u64 = 0x018
const S_PIXELS: u64 = 0x020
const S_GLYPHS: u64 = 0x028
const S_CLIPW: u64 = 0x030
const S_CLIPR: u64 = 0x038
const S_SHAPE: u64 = 0x040
// ROUND ICONS: the icon font's slot in the font reader, raised by one
// so that 0 can mean "none loaded".  `kmain` sets it after it has read
// /lib/icons.ttf.
const S_ICONFONT: u64 = 0x048
// RUNDE GLYPHE: die Schrift, mit der der Nachweis zeichnet. Sie
// steht hier und nicht in `wm`, weil der Nachweis VOR dem
// Fensterserver laeuft -- im Hochlauf, aus `smp.stage`.
const S_RACEFONT: u64 = 0x050

// THE THREE FONT ROLES Ring 3 is allowed to name.  They are ROLES and
// not slot numbers: which slot the font reader gave a file depends on
// the order things came up at boot and is none of Ring 3's business.
// A role, by contrast, is a promise -- 0 is the interface font, 1 the
// terminal font, 2 the icons.
const F_UI: u64 = 0
const F_MONO: u64 = 1
const F_ICON: u64 = 2
const FONT_ROLES: u64 = 3

fn base(state: u64) -> u64 {
    return state + kstate.WIG_OFF
}

fn gs(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.WIG_OFF + off)
}

fn ss(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.WIG_OFF + off, v)
}

fn ready(state: u64) -> bool {
    return gs(state, S_READY) != 0
}

fn blits(state: u64) -> u64 {
    return gs(state, S_BLITS)
}

fn rows_copied(state: u64) -> u64 {
    return gs(state, S_ROWS)
}

fn pixels(state: u64) -> u64 {
    return gs(state, S_PIXELS)
}

fn glyph_calls(state: u64) -> u64 {
    return gs(state, S_GLYPHS)
}

fn clip_writes(state: u64) -> u64 {
    return gs(state, S_CLIPW)
}

fn clip_reads(state: u64) -> u64 {
    return gs(state, S_CLIPR)
}

fn clip_len(state: u64) -> u64 {
    return gs(state, S_CLIPLEN)
}

fn shape(state: u64) -> u64 {
    return gs(state, S_SHAPE)
}

fn set_shape(state: u64, s: u64) {
    // RUNDE ECHTHARDWARE-4: neun Formen (kernel/zeiger.fi). Hier stand
    // `s > 2`, und damit kamen Hand, Groessenaenderung, Verschieben und
    // Sanduhr gar nicht erst bis zum Fensterserver.
    if s >= 9 {
        return
    }
    if gs(state, S_SHAPE) == s {
        return
    }
    ss(state, S_SHAPE, s)
    wm.set_shape(state, s)
}

// Die eigenen Bereiche leer, die Zaehler auf null. Wird aus `kmain`
// gerufen, nachdem der Fensterserver steht -- vorher gaebe es kein
// Fenster, in das etwas geschoben werden koennte.
//
// NICHT MEHR DIE GANZEN DREI SEITEN, und der Grund ist ein Fehler dieser
// Runde: der zweite Nachtrag legt in dieselbe erste Seite die Geometrie
// des Dateisystems (0x080) und das Aenderungsjournal (0x100), und beide
// stehen dort, BEVOR die Oberflaeche hochkommt. Wer hier 0x1000 Oktette
// nullt, loescht dem laufenden Kernel die Zahl seiner Inodes weg -- das
// Ergebnis war ein `mount`, das ging, und ein `block_alloc`, das ab dem
// Block 34 vergab, wo die Inode-Tabelle lag. Also nur, was `wig.fi`
// gehoert: die Skalare bis 0x080, die Zwischenablage und der
// Umschlagpuffer.
fn init(state: u64) -> bool {
    var i: u64 = 0
    while i < 0x080 {
        kstate.set8(base(state) + i, 0 as u8)
        i = i + 1
    }
    i = CLIP_OFF
    while i < 0x3000 {
        kstate.set8(base(state) + i, 0 as u8)
        i = i + 1
    }
    ss(state, S_READY, 1)
    return true
}

// ------------------------------------------------ aus Ring 3 herein
//
// DASSELBE WIE `sys.copy_in`, NUR NICHT OKTETTWEISE. Der Kopierer der
// Runde K4 laeuft eine Schleife je Oktett; fuer einen Namen ist das
// richtig, fuer 3200 Oktette Bildpunktzeile ist es der Unterschied
// zwischen einer Oberflaeche und einer Diashow. Gemessen in
// docs/ROUNDK15.md.
//
// Die drei Regeln bleiben genau dieselben:
//   1. `proc.user_ok` -- die Anwendung muss den Bereich besitzen.
//   2. `proc.translate` je Seite -- der Kernel folgt keinem fremden
//      Zeiger, er rechnet ihn um.
//   3. `guard.stac` / `guard.clac` um jeden Zugriff -- SMAP.
fn fetch(state: u64, me: u64, dst: u64, src: u64, len: u64) -> bool {
    if len == 0 {
        return true
    }
    if !proc.user_ok(state, me, src, len) {
        return false
    }
    var n: u64 = 0
    while n < len {
        let phys: u64 = proc.translate(state, me, src + n)
        if phys == 0 {
            return false
        }
        var room: u64 = 4096 - ((src + n) & 4095)
        if room > len - n {
            room = len - n
        }
        guard.stac(state)
        arch.copy_octets(dst +% n, phys, room)
        guard.clac(state)
        n = n + room
    }
    return true
}

fn store(state: u64, me: u64, dst: u64, src: u64, len: u64) -> bool {
    if len == 0 {
        return true
    }
    if !proc.user_ok(state, me, dst, len) {
        return false
    }
    var n: u64 = 0
    while n < len {
        let phys: u64 = proc.translate(state, me, dst + n)
        if phys == 0 {
            return false
        }
        var room: u64 = 4096 - ((dst + n) & 4095)
        if room > len - n {
            room = len - n
        }
        guard.stac(state)
        arch.copy_octets(phys, src +% n, room)
        guard.clac(state)
        n = n + room
    }
    return true
}

// ------------------------------------------------------- 1. das Blit
//
// Ein Rechteck aus dem Speicher der Anwendung in ihr Fenster, Zeile fuer
// Zeile durch den Umschlagpuffer. Danach ist GENAU DIESES RECHTECK
// schmutzig und nicht das Fenster -- `wm.damage` bekommt die Stelle auf
// dem BILDSCHIRM, also Fensterecke plus Rahmen plus Versatz.
//
// Warum zeilenweise und nicht am Stueck: der Umschlagpuffer ist eine
// Seite. Ein Puffer fuer ein ganzes Fenster waere 851 200 Oktette in
// `kdata`, und `kdata` sind 320 KiB.
//
// `stride` ist die Zeilenlaenge der QUELLE in Bildpunkten. Sie ist nicht
// immer `w`: die Bibliothek malt in einen Streifen, der so breit ist wie
// das Fenster, und schiebt daraus ein schmales Rechteck.
fn blit(state: u64, me: u64, i: u64, x: u64, y: u64, w: u64, h: u64,
    src: u64, stride: u64) -> u64 {
    if !wm.valid(state, i) {
        return 0
    }
    if w == 0 || h == 0 {
        return 0
    }
    let ww: u64 = wm.win_w(state, i)
    let wh: u64 = wm.win_h(state, i)
    if x >= ww || y >= wh {
        return 0
    }
    var bw: u64 = w
    var bh: u64 = h
    if x + bw > ww {
        bw = ww - x
    }
    if y + bh > wh {
        bh = wh - y
    }
    // RUNDE GLYPHE: die Buehne DIESES Kerns. Bis hierher stand hier
    // `base(state) + STAGE_OFF` -- EIN Puffer fuer die ganze Maschine,
    // und das war die Haelfte des Fehlers, an dem MERGE-6 gescheitert
    // ist: `glyph_into` hatte eine Sperre, `blit` nicht, und beide
    // schrieben in denselben Puffer.
    let bz: u64 = stage_if_lock(state)
    let stage: u64 = stage_of(state)
    var r: u64 = 0
    while r < bh {
        // RUNDE SCHIRM-ECHT: eine Zeile geht in so vielen Umschlaegen
        // hinueber, wie sie braucht. Bis 1024 Bildpunkte ist das genau
        // einer und damit derselbe Weg wie vorher; darueber sind es
        // `stuecke(bw)` -- und nicht mehr eine Absage.
        var c: u64 = 0
        while c < bw {
            var n: u64 = bw - c
            if n > MAX_ROW {
                n = MAX_ROW
            }
            if !fetch(state, me, stage,
                src +% r *% stride *% 4 +% c *% 4, n *% 4) {
                // Was schon drin steht, bleibt drin -- aber die Zusage
                // "so viele Bildpunkte" wird nicht gegeben.
                ss(state, S_ROWS, gs(state, S_ROWS) + r)
                stage_clear(bz)
                return 0
            }
            wm.blit_in(state, i, stage, x + c, y + r, n, 1)
            c = c + n
        }
        r = r + 1
    }
    stage_clear(bz)
    ss(state, S_BLITS, gs(state, S_BLITS) + 1)
    ss(state, S_ROWS, gs(state, S_ROWS) + bh)
    ss(state, S_PIXELS, gs(state, S_PIXELS) + bw * bh)
    // NUR DAS RECHTECK. Der Unterschied zu `wm.flush_win` ist die ganze
    // Bereichsverfolgung: eine Einfuegemarke, die blinkt, ist 2 x 16
    // Bildpunkte und nicht 560 x 380.
    // RUNDE DESKTOP: `wm.inx`/`wm.iny` UND NICHT `wm.BORDER`/`wm.TITLE_H`.
    // Ein Fenster ohne Schmuck (Schreibtisch, Taskleiste) faengt bei
    // (0,0) an und nicht bei (2,22). Mit den festen Zahlen lag der
    // schmutzige Bereich der Taskleiste 22 Bildpunkte zu tief -- die
    // obersten 22 Zeilen blieben stehen, wo vorher etwas anderes war.
    let sx: i64 = wm.win_x(state, i) + wm.inx(state, i) as i64 + x as i64
    let sy: i64 = wm.win_y(state, i) + wm.iny(state, i) as i64 + y as i64
    wm.damage(state, sx, sy, sx + bw as i64, sy + bh as i64)
    return bw * bh
}

// ---------------------------------------------------- 2. eine Glyphe
//
// Kopf und Deckungsfeld in den Speicher der Anwendung. Der Kernel
// rastert (und speichert zwischen), Ring 3 mischt.
//
// `f` ist 0 fuer die Proportionalschrift der Oberflaeche und 1 fuer die
// Festbreitenschrift -- die beiden, die der Server geladen hat. Eine
// dritte gibt es nicht, und eine Nummer, die auf einen Platz zeigt, der
// nie gefuellt wurde, waere ein Leseversuch in fremdem Speicher.
fn font_of(state: u64, f: u64) -> u64 {
    if f == F_UI {
        return wm.font_ui(state)
    }
    if f == F_ICON {
        // Zero means "no icon font loaded".  The caller then gets
        // MAX_FONTS back and draws nothing -- no substitute letter, no
        // empty box.  A system without /lib/icons.ttf should look like
        // one without icons, not like one with broken ones.
        let n: u64 = gs(state, S_ICONFONT)
        if n == 0 {
            return ttf.MAX_FONTS
        }
        return n - 1
    }
    return wm.font_mono(state)
}

// ROUND ICONS: `kmain` reports here which slot the icon font ended up
// in.  It does NOT live in `wm.fi` next to the other two: the window
// server sets no icons -- it sets titles and terminal text -- and a
// role it never uses does not belong in its state.
fn set_icon_font(state: u64, f: u64) {
    if f >= ttf.MAX_FONTS {
        ss(state, S_ICONFONT, 0)
        return
    }
    ss(state, S_ICONFONT, f + 1)
}

fn icon_font(state: u64) -> u64 {
    let n: u64 = gs(state, S_ICONFONT)
    if n == 0 {
        return ttf.MAX_FONTS
    }
    return n - 1
}

// ==================================================== RUNDE MERGE-6
// DIE BUEHNE GEHOERT DER GANZEN MASCHINE -- UND SIE HAT EIN PROGRAMM
// UMGEBRACHT.
//
// `glyph_into` baut die Antwort in EINEM Puffer der Datenseite
// zusammen (`base(state) + STAGE_OFF`): erst sechs Kopfworte (Breite,
// Hoehe, links, oben, Laufweite, Zahl der Bildpunkte), dann die
// Bildpunkte. Danach wird alles am Stueck nach Ring 3 kopiert.
//
// Solange Ring 3 auf Kern 0 lag, war das richtig. Seit VIELKERN 3
// laufen mehrere Programme mit eigenem Fenster auf verschiedenen
// Kernen, und zwei davon zeichnen Text gleichzeitig. Dann steht im
// Kopf die Breite des einen Zeichens und dahinter die Bildpunkte des
// anderen -- und der Klient in `wlibc.gload` rechnet `gw * gh` auf
// Zahlen, die nicht zusammengehoeren:
//
//     panic: integer overflow in 'u64 * u64' at kernel/user/wlibc.fi:1128:8
//
// GEMESSEN am zusammengefuehrten Stand, vier Kerne, voller
// Schreibtisch: der Aufgabenverwalter starb genau eine Zeile nach
// `taskmgr: start`, jedes Mal. Es sah aus wie ein Fehler in ihm.
//
// DIESELBE SPERRE WIE IN VIELKERN 3, aus denselben zwei Gruenden:
// JE KERN WIEDEREINTRITTSFAEHIG (ein Behandler, der einen zeichnenden
// Kern unterbricht, wartet nie auf sich selbst) und BEGRENZT (ein Kern,
// der mit ihr in der Hand gestorben ist, darf die Oberflaeche der
// anderen nicht einfrieren -- wer zu lange wartet, zeichnet trotzdem,
// und `buehne_verloren` zaehlt es).
//
// Sie deckt AUCH den Zwischenspeicher der Umrisse mit ab: `ttf.glyph`
// legt neue Glyphen in eine gemeinsame Tafel, und `ttf.g_pixel` liest
// unmittelbar danach aus dem Platz, den es dabei bekommen hat.
const BUEHNE_GRENZE: u64 = 20000000

static mut buehne_wer: [u64; 1] = [0 as u64; 1]
static mut buehne_daneben: [u64; 1] = [0 as u64; 1]

fn buehne_an(me: u64) -> u64 {
    let a: u64 = (&buehne_wer[0]) as u64
    if __mmio_read64(a as *mut u64) == me + 1 {
        return 0
    }
    var spins: u64 = 0
    while __atomic_swap(a as *mut u64, 0 as u64, me + 1) != 0 as u64 {
        arch.pause()
        spins = spins + 1
        if spins > BUEHNE_GRENZE {
            buehne_daneben[0] = buehne_daneben[0] + 1
            return 0
        }
    }
    return 1
}

fn stage_clear(hat: u64) {
    if hat != 0 {
        arch.atomic_store((&buehne_wer[0]) as u64, 0)
    }
}

fn buehne_verloren() -> u64 {
    return buehne_daneben[0]
}

// ======================================================= RUNDE GLYPHE
// DIE BUEHNE GEHOERT JETZT DEM KERN, DER AUF IHR ZEICHNET.
//
// Die Sperre oben senkte die Rate und schloss die Luecke nicht -- und
// der Grund steht drei Bildschirme weiter oben in DIESER Datei:
// `wig.blit` benutzt DENSELBEN Puffer (`base(state) + STAGE_OFF`) und
// hat die Sperre NIE genommen. Jede Fensterzeile geht durch `blit`;
// waehrend ein Kern zwischen "Kopf schreiben" und "an Ring 3 geben"
// steht, legt der andere seine Bildpunktzeile darueber. Das ist die
// eine von fuenf Laeufen, an der MERGE-6 gescheitert ist.
//
// Zwei Bauformen sind moeglich, und die Messung hat entschieden
// (docs/RUNDE-GLYPHE.md):
//
//   A `glyphsperre` -- eine Buehne, aber `blit` UND `glyph_into` unter
//     derselben Sperre. Richtig, aber jede Fensterzeile jedes Kerns
//     wartet dann auf jede andere.
//   B die Vorgabe -- JE KERN EINE BUEHNE ueber `kstate.WIGST_OFF`,
//     angesprochen ueber `cpu.here`, so wie `C_KSTACK` ueber die
//     GS-Basis. Keine Sperre, kein Warten.
//
// Sicher ist B, weil der Umschlagpuffer AUSSCHLIESSLICH im
// Systemaufruf angefasst wird und `MSR_SFMASK` IF fuer den ganzen
// Systemaufruf unten haelt: eine Aufgabe kann darin nicht verdraengt
// und auf einem anderen Kern fortgesetzt werden.
fn geteilte_buehne(state: u64) -> bool {
    return kstate.mode_on(state, kstate.M_GBLIND)
        || kstate.mode_on(state, kstate.M_GLOCK)
}

fn stage_of(state: u64) -> u64 {
    if geteilte_buehne(state) {
        // `glyphblind` = der Stand VOR dieser Runde, `glyphsperre` =
        // Bauform A. Beide brauchen die EINE Buehne.
        return base(state) + STAGE_OFF
    }
    var k: u64 = cpu.here(state)
    if k >= kstate.MAX_CPUS {
        k = 0
    }
    return state + kstate.WIGST_OFF + k * STAGE_MAX
}

// DIE SPERRE WIRD NUR NOCH GENOMMEN, WENN ES ETWAS ZU SPERREN GIBT --
// und die zwei Wege nehmen sie NICHT GLEICH, weil sie es vor dieser
// Runde auch nicht taten:
//
//   `glyph_into` nahm sie in MERGE-6 (die Buehnensperre dieser Runde),
//   `blit` nahm sie NIE -- das war die Luecke.
//
// `glyphblind` bildet genau diesen Stand nach: Glyphe gesperrt, Zeile
// frei, eine Buehne. `glyphsperre` ist Bauform A: BEIDE gesperrt.
fn stage_if_split(state: u64) -> u64 {
    if !geteilte_buehne(state) {
        return 0
    }
    return buehne_an(cpu.here(state))
}

fn stage_if_lock(state: u64) -> u64 {
    if !kstate.mode_on(state, kstate.M_GLOCK) {
        return 0
    }
    return buehne_an(cpu.here(state))
}

// DER RUMPF, DEN AUCH DER NACHWEIS RUFT. Er baut die Antwort auf der
// uebergebenen Buehne zusammen und gibt ihre Laenge zurueck; wer sie
// nach Ring 3 traegt, entscheidet der Aufrufer. `font` ist der Platz
// des Schriftlesers, nicht die Rolle -- der Nachweis laeuft vor dem
// Fensterserver und hat keine Rollen.
fn glyph_build(state: u64, stage: u64, font: u64, px: u64, c: u64,
    max: u64) -> u64 {
    if font >= ttf.MAX_FONTS {
        return 0
    }
    let slot: u64 = ttf.glyph(state, font, c, px)
    var gw: u64 = 0
    var gh: u64 = 0
    var gl: i64 = 0
    var gt: i64 = 0
    var ga: i64 = 0
    if slot < ttf.SLOTS {
        gw = ttf.g_w(state, slot)
        gh = ttf.g_h(state, slot)
        gl = ttf.g_left(state, slot)
        gt = ttf.g_top(state, slot)
        ga = ttf.g_adv(state, slot)
    } else {
        // Kein Umriss (Leerzeichen) oder kein Platz mehr im
        // Zwischenspeicher: die LAUFWEITE gilt trotzdem, sonst rutscht
        // die ganze Zeile.
        let gid: u64 = ttf.glyph_of(state, font, c)
        ga = ttf.advance26(state, font, gid, px)
    }
    if gw * gh + G_HDR > STAGE_MAX {
        return 0
    }
    if gw * gh + G_HDR > max {
        return 0
    }
    __mmio_write64((stage + 0) as *mut u64, gw)
    __mmio_write64((stage + 8) as *mut u64, gh)
    __mmio_write64((stage + 16) as *mut u64, gl as u64)
    __mmio_write64((stage + 24) as *mut u64, gt as u64)
    __mmio_write64((stage + 32) as *mut u64, ga as u64)
    __mmio_write64((stage + 40) as *mut u64, gw * gh)
    var r: u64 = 0
    while r < gh {
        var k: u64 = 0
        while k < gw {
            kstate.set8(stage + G_HDR + r * gw + k,
                ttf.g_pixel(state, slot, k, r) as u8)
            k = k + 1
        }
        r = r + 1
    }
    return G_HDR + gw * gh
}

// Der Systemaufruf: Buehne holen, bauen, hinuebertragen.
fn glyph_into(state: u64, me: u64, f: u64, px: u64, c: u64, out: u64,
    max: u64) -> u64 {
    if f >= FONT_ROLES || px == 0 || px > 128 {
        return 0
    }
    let font: u64 = font_of(state, f)
    if font >= ttf.MAX_FONTS {
        return 0
    }
    let bz: u64 = stage_if_split(state)
    let stage: u64 = stage_of(state)
    let n: u64 = glyph_build(state, stage, font, px, c, max)
    if n == 0 {
        stage_clear(bz)
        return 0
    }
    if !store(state, me, out, stage, n) {
        stage_clear(bz)
        return 0
    }
    ss(state, S_GLYPHS, gs(state, S_GLYPHS) + 1)
    stage_clear(bz)
    return n
}

// ================================ RUNDE GLYPHE: DER NACHWEIS, ERZWUNGEN
//
// Dieselbe Bauart wie `fs.race_core` aus MERGE-6: `smp.run_phase`
// startet ALLE Kerne im selben Augenblick, jeder zeichnet SEIN eigenes
// Zeichen und rechnet die Antwort gegen den in Ruhe genommenen
// Sollwert. Gehoert die Buehne allen, muss der eine lesen, was der
// andere hineingelegt hat.
//
// Und weil der wirkliche Zusammenstoss `blit` GEGEN `glyph_into` war,
// legt jeder Kern in derselben Runde AUCH eine Bildpunktzeile auf die
// Buehne und liest sie zurueck -- genau die Reihenfolge, die `blit`
// hat (`fetch` hinein, `wm.blit_in` heraus).
const RACE_PX: u64 = 16

fn race_char(index: u64) -> u64 {
    return 0x41 + index % 26
}

fn race_ready(state: u64, font: u64) {
    ss(state, S_RACEFONT, font)
}

fn race_probe(state: u64, index: u64) -> u64 {
    // GENAU DIE SPERRE, DIE `glyph_into` NIMMT -- sonst misst der
    // Nachweis eine Bauform, die es nicht gibt.
    let bz: u64 = stage_if_split(state)
    let stage: u64 = stage_of(state)
    let n: u64 = glyph_build(state, stage, gs(state, S_RACEFONT), RACE_PX,
        race_char(index), STAGE_MAX)
    if n == 0 {
        stage_clear(bz)
        return 0
    }
    var h: u64 = 1
    var i: u64 = 0
    while i < n {
        h = h *% 31 +% kstate.get8(stage + i) as u64
        i = i + 1
    }
    stage_clear(bz)
    return h
}

// In Ruhe, auf EINEM Kern, vor dem Rennen. Ein Sollwert, der waehrend
// des Rennens genommen wird, ist selbst schon falsch.
fn race_soll(state: u64, index: u64) -> u64 {
    return race_probe(state, index)
}

fn race_line(state: u64, muster: u64) -> u64 {
    // GENAU DIE SPERRE, DIE `blit` NIMMT -- also keine, ausser in
    // Bauform A.
    let bz: u64 = stage_if_lock(state)
    let stage: u64 = stage_of(state)
    var i: u64 = 0
    while i < STAGE_MAX / 8 {
        kstate.set(stage, i * 8, muster +% i)
        i = i + 1
    }
    i = 0
    var fehler: u64 = 0
    while i < STAGE_MAX / 8 {
        if kstate.get(stage, i * 8) != muster +% i {
            fehler = 1
            i = STAGE_MAX / 8
        } else {
            i = i + 1
        }
    }
    stage_clear(bz)
    return fehler
}

fn race_core(state: u64, index: u64, runden: u64, soll: u64) -> u64 {
    if soll == 0 {
        return 0
    }
    let muster: u64 = (index + 1) *% 0x0101010101010101
    var fehler: u64 = 0
    var i: u64 = 0
    while i < runden {
        if race_probe(state, index) != soll {
            fehler = fehler + 1
        }
        fehler = fehler + race_line(state, muster +% i)
        i = i + 1
    }
    return fehler
}

// --------------------------------------------- 3. die Unterschneidung

fn kern_of(state: u64, f: u64, px: u64, c1: u64, c2: u64) -> i64 {
    if f >= FONT_ROLES {
        return 0
    }
    let font: u64 = font_of(state, f)
    if font >= ttf.MAX_FONTS {
        return 0
    }
    let g1: u64 = ttf.glyph_of(state, font, c1)
    let g2: u64 = ttf.glyph_of(state, font, c2)
    return ttf.kern26(state, font, g1, g2, px)
}

// ------------------------------------------- 4. die Zwischenablage

// ======================================================= RUNDE GLYPHE
// DIE ZWISCHENABLAGE IST DER ZWEITE GETEILTE PUFFER DIESER DATEI --
// UND DER ERWEITERTE `onecore.py` HAT SIE GEFUNDEN.
//
// Sie GEHOERT der ganzen Maschine, und das ist richtig so: was das eine
// Programm kopiert, muss das andere einfuegen koennen. Je Kern waere
// hier also FALSCH. Was fehlte, ist die Sperre: `clip_set` kopiert
// `len` Oktette aus Ring 3 hinein und setzt DANACH die Laenge; ein
// `clip_get` auf einem anderen Kern liest in derselben Zeit die ALTE
// Laenge ueber dem NEUEN Inhalt -- oder umgekehrt.
//
// Es ist dieselbe Sperre wie die der Buehne (je Kern
// wiedereintrittsfaehig, begrenzt); sie wird hier IMMER genommen, weil
// es hier keine zweite Bauform gibt. Die Zwischenablage wird selten
// benutzt -- der Preis ist nicht messbar.
fn clip_set(state: u64, me: u64, src: u64, n: u64) -> u64 {
    var len: u64 = n
    if len > CLIP_MAX {
        len = CLIP_MAX
    }
    let bz: u64 = buehne_an(cpu.here(state))
    if len == 0 {
        ss(state, S_CLIPLEN, 0)
        ss(state, S_CLIPW, gs(state, S_CLIPW) + 1)
        stage_clear(bz)
        return 0
    }
    if !fetch(state, me, base(state) + CLIP_OFF, src, len) {
        stage_clear(bz)
        return 0
    }
    ss(state, S_CLIPLEN, len)
    ss(state, S_CLIPW, gs(state, S_CLIPW) + 1)
    stage_clear(bz)
    return len
}

fn clip_get(state: u64, me: u64, dst: u64, max: u64) -> u64 {
    // RUNDE GLYPHE: dieselbe Sperre wie in `clip_set` -- Laenge und
    // Inhalt muessen aus DEMSELBEN Kopiervorgang stammen.
    let bz: u64 = buehne_an(cpu.here(state))
    var len: u64 = gs(state, S_CLIPLEN)
    if len > max {
        len = max
    }
    if len == 0 {
        stage_clear(bz)
        return 0
    }
    if !store(state, me, dst, base(state) + CLIP_OFF, len) {
        stage_clear(bz)
        return 0
    }
    ss(state, S_CLIPR, gs(state, S_CLIPR) + 1)
    stage_clear(bz)
    return len
}

// ------------------------------------------------- was es selbst weiss
//
// Sieben Zusagen, und sie pruefen die Rechnungen, die sonst niemand
// sieht -- die Grenzen des Umschlagpuffers und der Zwischenablage.
fn selftest(state: u64) -> u64 {
    var gut: u64 = 0
    // 1. Der Umschlagpuffer traegt genau eine Bildpunktzeile von
    //    MAX_ROW, und keine breitere.
    if MAX_ROW * 4 == STAGE_MAX {
        gut = gut + 1
    }
    // 2. RUNDE SCHIRM-ECHT: eine Zeile, die breiter ist als der
    //    Umschlagpuffer, wird ZERLEGT und nicht abgelehnt -- und die
    //    Rechnung dahinter stimmt an beiden Kanten. Vorher stand hier
    //    das Gegenteil ("wird abgelehnt"), und genau diese Zusage hat
    //    den halben Schreibtisch auf 1280x800 gruen abgesegnet.
    if stuecke(0) == 0 && stuecke(1) == 1 && stuecke(MAX_ROW) == 1
        && stuecke(MAX_ROW + 1) == 2 && stuecke(2 * MAX_ROW) == 2
        && stuecke(3840) == 4 {
        gut = gut + 1
    }
    // 3. Ein Fenster, das es nicht gibt.
    if blit(state, 0, wm.MAX_WIN, 0, 0, 4, 4, 0, 4) == 0 {
        gut = gut + 1
    }
    // 4. Der Glyphenkopf passt mit dem groessten Deckungsfeld in den
    //    Umschlagpuffer. DIE ERSTE FASSUNG DIESER ZEILE RECHNETE MIT
    //    64 x 64 UND FIEL DURCH -- 48 + 4096 sind mehr als 4096, und
    //    zwar genau um den Kopf. Das ist die Grenze, die hier steht:
    //    ein Zeichen darf bis 48 x 48 gross sein, also bis etwa 48
    //    Bildpunkte Schriftgroesse. Darueber gibt `glyph_into` eine
    //    Null zurueck statt in die naechste Seite zu schreiben.
    if STAGE_MAX >= G_HDR + 48 * 48 {
        gut = gut + 1
    }
    // 5. Die Zwischenablage faengt leer an und der Zaehler stimmt.
    let vorher: u64 = gs(state, S_CLIPLEN)
    ss(state, S_CLIPLEN, 0)
    if clip_len(state) == 0 {
        gut = gut + 1
    }
    ss(state, S_CLIPLEN, vorher)
    // 6. Eine Schriftnummer, die es nicht gibt, gibt keine
    //    Unterschneidung -- statt in einen Platz zu lesen, der nie
    //    gefuellt wurde.
    if kern_of(state, 2, 15, 65, 86) == 0 {
        gut = gut + 1
    }
    // 7. Und die drei Seiten liegen dort, wo die Karte sie fuehrt.
    if kstate.WIG_MAX == 0x3000 {
        gut = gut + 1
    }
    return gut
}

fn selftest_max() -> u64 {
    return 7
}
