// SPDX-License-Identifier: GPL-2.0-only
// kernel/ksymtab.fi -- RUNDE PROTOKOLL: AUS EINER ADRESSE WIRD EIN NAME.
//
// EINE ADRESSE IST KEINE ANTWORT. Die Rueckverfolgung der Runde
// BLECHKERN druckt fuenf Zahlen, und was diese fuenf Zahlen bedeuten,
// weiss nur, wer GENAU DAS ABBILD hat, aus dem der abgestuerzte Kern
// gebaut wurde. Justin hat es nicht -- er hat einen Fotoapparat und ein
// Brett, auf dem eine Fassung von vorgestern laeuft. Die Runde
// EINSPRUNG hat zwei Stunden damit verbracht, GENAU EINE solche Zahl
// zurueckzurechnen, und der Kommentar dort ist der beste Beleg dafuer,
// dass das nicht der Weg sein kann.
//
// Diese Datei macht aus
//
//     kspur:     0x143aa1   0x1621c0   0x11e934
//
// dies:
//
//     kspur:  sched.irq_restore+0x11 (sched.fi:1046)
//             wm.mess_kol+0x79 (wm.fi:4312)
//             ...
//
// ------------------------------------------------------------------
// WO DIE TABELLEN HERKOMMEN
//
// Aus dem Abbild selbst, im Abschnitt `.rodata`, unter dem Symbol
// `osym_tab`. Erzeugt werden sie von `tools/kernel/symtab.py` aus dem
// fertig gebundenen Abbild des ERSTEN Bindedurchgangs; der zweite
// Durchgang bindet sie ein. Warum das gehen MUSS und wie es geprueft
// wird, steht in `kernel/arch/x86_64/osym.s`.
//
// AUS DEM ABBILD UND NICHT VON DER PLATTE, und der Grund ist der
// einzige, der zaehlt: der Panik-Bildschirm entsteht in einem Kern, der
// gerade gestorben ist. Er kann keinen Block mehr lesen, er kann keine
// Sperre mehr nehmen, er kann keinen Speicher mehr anfordern. Was er
// nicht schon im Adressraum hat, hat er nicht.
//
// ------------------------------------------------------------------
// DER ZUGRIFF AUF DAS SYMBOL
//
// Firn kann Bindersymbole nicht benennen. Der Weg dorthin ist derselbe,
// den `ksym.fi` fuer `kdata` und `fb.fi` seit Runde K7B gehen:
//
//     asm("lea rax, [rip + osym_tab]", out("rax"))
//
// Das ist eine Adressberechnung ohne Speicherzugriff und damit auch
// dann gefahrlos, wenn der Kern schon halb tot ist.
//
// ------------------------------------------------------------------
// DER AUFBAU DER TABELLE
//
// Er steht ZWEIMAL, hier und in `tools/kernel/symtab.py`; die Kennung
// im ersten Wort ist der Riegel dagegen, dass die beiden auseinander-
// laufen. Alle Versaetze sind Versaetze VOM ANFANG der Tabelle.
//
//     0   u64 Kennung 'OSYM1' (0x314D59534F)
//     8   u64 Zahl der Symbole
//     16  u64 Zahl der Zeileneintraege
//     24  u64 -> Symboladressen, je u32, aufsteigend sortiert
//     32  u64 -> Namensverweise, je u32 in den Namensblock
//     40  u64 -> Namensblock, nullterminierte Zeichenketten
//     48  u64 -> Zeilentabelle, je 8 Oktett: u32 Adresse, u32 gepackt
//     56  u64 -> Dateiverweise, je u32 in den Dateinamenblock
//     64  u64 Zahl der Dateien
//     72  u64 -> Dateinamenblock
//     80  u64 niedrigste Symboladresse
//     88  u64 hoechste Symboladresse
//
// GEPACKT: (Dateinummer << 20) | Zeilennummer.
//
// ------------------------------------------------------------------
// DIE SUCHE
//
// Zweimal dieselbe Binaersuche ueber ein sortiertes u32-Feld: gesucht
// wird der GROESSTE Eintrag, der nicht ueber der Adresse liegt. Bei den
// Symbolen ist das die Funktion, in der die Adresse steht; bei den
// Zeilen die Quellzeile, deren Maschinencode dort anfaengt.
//
// KEINE SPERRE, KEIN ZUSTAND. Beide Tabellen sind nur lesbar und liegen
// im Abbild. Zwei Kerne, die gleichzeitig eine Panik melden, stoeren
// einander hier nicht -- und ein Kern, der schon eine Sperre haelt,
// kommt hier nicht ins Warten.

profile kernel

import kstate
import serial

export {
    have, n_sym, n_line,
    resolve, sym_addr, sym_name, line_of, line_file, line_nr, file_name,
    say_addr, say_addr_short, tab
}

const MAGIC: u64 = 0x314D59534F

const H_MAGIC: u64 = 0
const H_NSYM: u64 = 8
const H_NLINE: u64 = 16
const H_SADR: u64 = 24
const H_SNAM: u64 = 32
const H_STR: u64 = 40
const H_LINE: u64 = 48
const H_DVER: u64 = 56
const H_NDAT: u64 = 64
const H_DSTR: u64 = 72
const H_LO: u64 = 80
const H_HI: u64 = 88

fn tab() -> u64 {
    return asm("lea rax, [rip + osym_tab]", out("rax"))
}

fn w(off: u64) -> u64 {
    return __mmio_read64((tab() + off) as *mut u64)
}

fn have() -> bool {
    return w(H_MAGIC) == MAGIC
}

fn n_sym() -> u64 {
    if !have() {
        return 0
    }
    return w(H_NSYM)
}

fn n_line() -> u64 {
    if !have() {
        return 0
    }
    return w(H_NLINE)
}

// ------------------------------------------------------------ die Symbole

// Der groesste Eintrag, der nicht ueber `addr` liegt. Zurueck kommt die
// Nummer, oder `n_sym()` wenn die Adresse ausserhalb liegt -- das ist
// die uebliche "gibt es nicht"-Antwort einer Binaersuche und braucht
// keine Sonderzahl.
fn resolve(addr: u64) -> u64 {
    let n: u64 = n_sym()
    if n == 0 || addr < w(H_LO) || addr > w(H_HI) + 0x10000 {
        return n
    }
    let a: u64 = tab() + w(H_SADR)
    var lo: u64 = 0
    var hi: u64 = n
    while lo + 1 < hi {
        let mid: u64 = lo + (hi - lo) / 2
        if kstate.get32(a + mid * 4) <= addr {
            lo = mid
        } else {
            hi = mid
        }
    }
    if kstate.get32(a + lo * 4) > addr {
        return n
    }
    return lo
}

fn sym_addr(i: u64) -> u64 {
    if i >= n_sym() {
        return 0
    }
    return kstate.get32(tab() + w(H_SADR) + i * 4)
}

fn sym_name(i: u64) -> u64 {
    if i >= n_sym() {
        return 0
    }
    return tab() + w(H_STR) + kstate.get32(tab() + w(H_SNAM) + i * 4)
}

// ------------------------------------------------------------ die Zeilen

// Dasselbe noch einmal, ueber die Zeilentabelle. Zurueck kommt das
// GEPACKTE Wort, oder 0 wenn es zu dieser Adresse keine Zeile gibt.
fn line_of(addr: u64) -> u64 {
    let n: u64 = n_line()
    if n == 0 {
        return 0
    }
    let a: u64 = tab() + w(H_LINE)
    if addr < kstate.get32(a) {
        return 0
    }
    var lo: u64 = 0
    var hi: u64 = n
    while lo + 1 < hi {
        let mid: u64 = lo + (hi - lo) / 2
        if kstate.get32(a + mid * 8) <= addr {
            lo = mid
        } else {
            hi = mid
        }
    }
    return kstate.get32(a + lo * 8 + 4)
}

fn line_nr(packed: u64) -> u64 {
    return packed & 0xFFFFF
}

fn line_file(packed: u64) -> u64 {
    return packed >> 20
}

fn file_name(f: u64) -> u64 {
    if !have() || f >= w(H_NDAT) {
        return 0
    }
    return tab() + w(H_DSTR) + kstate.get32(tab() + w(H_DVER) + f * 4)
}

// ------------------------------------------------------------ die Ausgabe

// `sched.irq_restore+0x11 (sched.fi:1046)` -- und wenn es keine Tabelle
// gibt, die rohe Adresse. Eine Zeile, die vorgibt, mehr zu wissen als
// der Kern hat, waere schlimmer als eine Zahl.
fn say_addr(addr: u64) {
    var s_plus: [u8; 2] = "+\0"
    var s_ob: [u8; 3] = " (\0"
    var s_co: [u8; 2] = ":\0"
    var s_cb: [u8; 2] = ")\0"
    let i: u64 = resolve(addr)
    if i >= n_sym() {
        serial.hex(addr)
        return
    }
    serial.puts(sym_name(i))
    serial.puts((&s_plus[0 as usize]) as u64)
    serial.hex(addr - sym_addr(i))
    let p: u64 = line_of(addr)
    if p == 0 {
        return
    }
    let f: u64 = file_name(line_file(p))
    if f == 0 {
        return
    }
    serial.puts((&s_ob[0 as usize]) as u64)
    serial.puts(f)
    serial.puts((&s_co[0 as usize]) as u64)
    serial.dec(line_nr(p))
    serial.puts((&s_cb[0 as usize]) as u64)
}

// Dieselbe Zeile ohne Datei und Zeile -- fuer Stellen, an denen die
// Spalte nicht reicht (das reservierte Band am oberen Bildrand).
fn say_addr_short(addr: u64) {
    var s_plus: [u8; 2] = "+\0"
    let i: u64 = resolve(addr)
    if i >= n_sym() {
        serial.hex(addr)
        return
    }
    serial.puts(sym_name(i))
    serial.puts((&s_plus[0 as usize]) as u64)
    serial.hex(addr - sym_addr(i))
}
