
profile kernel

import gfx.r3dsoft

export {
    start, end, active_v,
    clear, matrix, licht, textur, dreieck,
    backend, backend_name, dreiecke, points_v, bildpunkte,
    FIX_SHIFT, FIX_ONE, fx_mul, fx_div, fx_from_int, fx_to_int,
    sin_fx, cos_fx,
    M_MODELL, M_VIEW, M_PROJ,
    B_SOFT, B_KEINES
}

const FIX_SHIFT: u64 = 16
const FIX_ONE: u64 = 65536

fn fx_mul(a: u64, b: u64) -> u64 {
    let neg_a: bool = (a >> 63) != 0
    let neg_b: bool = (b >> 63) != 0
    var ua: u64 = a
    var ub: u64 = b
    if neg_a {
        ua = (0 -% a)
    }
    if neg_b {
        ub = (0 -% b)
    }
    let p: u64 = (ua *% ub) >> FIX_SHIFT
    if neg_a != neg_b {
        return 0 -% p
    }
    return p
}

fn fx_div(a: u64, b: u64) -> u64 {
    if b == 0 {
        return 0
    }
    let neg_a: bool = (a >> 63) != 0
    let neg_b: bool = (b >> 63) != 0
    var ua: u64 = a
    var ub: u64 = b
    if neg_a {
        ua = (0 -% a)
    }
    if neg_b {
        ub = (0 -% b)
    }
    if ub == 0 {
        return 0
    }
    let q: u64 = (ua << FIX_SHIFT) / ub
    if neg_a != neg_b {
        return 0 -% q
    }
    return q
}

fn fx_from_int(n: u64) -> u64 {
    return n << FIX_SHIFT
}

fn fx_to_int(x: u64) -> u64 {
    if (x >> 63) != 0 {
        return 0 -% ((0 -% x) >> FIX_SHIFT)
    }
    return x >> FIX_SHIFT
}

const SIN_N: u64 = 1024
const SIN_MASK: u64 = 1023
const SIN_VIERTEL: u64 = 256

fn sin_fx(state: u64, schritt: u64) -> u64 {
    return r3dsoft.sin_fx(state, schritt & SIN_MASK)
}

fn cos_fx(state: u64, schritt: u64) -> u64 {
    return r3dsoft.sin_fx(state, (schritt +% SIN_VIERTEL) & SIN_MASK)
}

const B_KEINES: u64 = 0
const B_SOFT: u64 = 1

fn backend(state: u64) -> u64 {
    if r3dsoft.active(state) {
        return B_SOFT
    }
    return B_KEINES
}

fn backend_name(state: u64) {
    r3dsoft.name()
}

const M_MODELL: u64 = 0
const M_VIEW: u64 = 1
const M_PROJ: u64 = 2

fn start(state: u64, dst: u64, w: u64, h: u64, pitch: u64) -> bool {
    return r3dsoft.start(state, dst, w, h, pitch)
}

fn end(state: u64) {
    r3dsoft.end(state)
}

fn active_v(state: u64) -> bool {
    return r3dsoft.active(state)
}

fn clear(state: u64, color: u64) {
    r3dsoft.clear(state, color)
}

fn matrix(state: u64, art: u64, m: u64) {
    r3dsoft.matrix(state, art, m)
}

fn licht(state: u64, rx: u64, ry: u64, rz: u64, staerke: u64, reason: u64) {
    r3dsoft.licht(state, rx, ry, rz, staerke, reason)
}

fn textur(state: u64, data: u64, w: u64, h: u64) -> bool {
    return r3dsoft.textur(state, data, w, h)
}

fn dreieck(state: u64, p: u64) {
    r3dsoft.dreieck(state, p)
}

fn dreiecke(state: u64) -> u64 {
    return r3dsoft.dreiecke(state)
}

fn points_v(state: u64) -> u64 {
    return r3dsoft.points(state)
}

fn bildpunkte(state: u64) -> u64 {
    return r3dsoft.bildpunkte(state)
}
