// SPDX-License-Identifier: GPL-2.0-only
// kernel/gfx-aus.fi -- DIE LEERIMPLEMENTIERUNG DER GRAFIKNAHT.
//
// `tools/build-kernel.sh --gui off` legt diese Datei an die Stelle von
// `kernel/gfx.fi` und LOESCHT dabei `fb.fi`, `wm.fi`, `wig.fi`,
// `font.fi`, `ttf.fi`, `tile.fi`, `vmode.fi`, `ansi.fi`, `ps2m.fi`,
// `kgui.fi` und `sysgui.fi` aus dem Uebersetzungsbaum. Kein Schalter
// zur Laufzeit, keine tote Verzweigung im Abbild: die Grafik ist NICHT
// VORHANDEN. Das ist derselbe Griff, mit dem `--ohne-tunnel` seit
// Runde TUNNEL `wg.fi` durch `wg-aus.fi` ersetzt.
//
// WAS EIN SERVER STATT DESSEN BEKOMMT, und es ist kein Verlust:
//
//   * `echo` tut nichts. Die serielle Leitung hat das Oktett schon --
//     `serial.put` schickt es hinaus UND ruft dann diese Zeile, damit
//     dasselbe auch auf dem Schirm steht. Ohne Schirm faellt der zweite
//     Weg weg, der erste bleibt Oktett fuer Oktett derselbe.
//   * `ready` sagt `false`. Damit gibt `open("/dev/fb")` -ENODEV,
//     `mmap` darauf -ENODEV und `fstat` eine Groesse von null -- die
//     Antworten, die eine Maschine ohne Grafikkarte heute schon gibt.
//   * Die vier Aufrufbereiche der Oberflaeche geben -ENOSYS zurueck,
//     genau wie eine Nummer, die es nicht gibt. Ein Programm, das ein
//     Fenster aufmachen will, bekommt eine Absage und keinen Absturz.
//   * `wm_ready` sagt `false`, und deshalb geht jede Taste den Weg, den
//     sie vor Runde K10 ging: durch die Zeilendisziplin der Konsole.
//
// DIE SIGNATUREN MUESSEN AUF DAS OKTETT ZU `gfx.fi` PASSEN, sonst
// uebersetzt der uebrige Kernel nicht -- und genau das ist die Probe
// darauf, dass die Naht wirklich die ganze Naht ist.

profile kernel

import errno

export {
    ready, width, height, pixel, get_pixel,
    dirty_all, flush, echo, wm_ready, wm_on_key,
    wm_key_tty, wm_term_out, parse, stage_graphics, stage_surface,
    stage_hold, mouse_adopt, mouse_packet, mouse_irq, mouse_x,
    mouse_y, mouse_buttons, mouse_packets, mouse_clicks, wm_poll, mouse_now,
    // RUNDE MODUL: vier Tueren mehr, damit der Kern MESSEN kann, ob es
    // ein Zeigegeraet ueberhaupt gibt. Ohne sie kaeme `kmain.fi` an
    // `ps2m.present` nur vorbei, indem es die Naht umgeht.
    mouse_present, mouse_init, mouse_moves, mouse_id,
    disp_poll, disp_restore, tafel_tick, herz_tick, absturz, panikbild,
    sys_wm, sys_wig, sys_disp, sys_tile, sys_shot, sys_tipp, fb_ready,
    fb_bytes, fb_pitch, fb_block, fb_offset, fb_user_base,
    fb_write_bytes, fb_read_bytes,
    grace_bereit, grace_soll, grace_core, grace_kalt,
    leser_tick,
    // RUNDE MERGE-2: die vier Zahlen der Hardware-Diagnose.
    fb_bpp, fb_phys, fb_cols, fb_rows, fb_from_multiboot,
    // RUNDE GRAFIK-1: dieselben sieben Tueren wie in `gfx.fi`. Ohne
    // Bildschirm gibt es keine Tafel, keinen Zweitpuffer und keinen
    // langen Weg -- also null, null, false.
    fb_panel_w, fb_panel_h, fb_panel_pitch,
    fb_stripe, fb_uncached, fb_double_buffered, fb_uiscale, fb_presents,
    // RUNDE GRAFIK-1: wohin gezeichnet wird. Der Rasterer malt
    // dorthin, wohin auch `fb` malt -- in den Zweitpuffer, wenn es
    // einen gibt. Dann traegt `flush` das Bild hinaus, und der
    // Rasterer muss von Fensterplaetzen und Streifenbetrieb nichts
    // wissen.
    fb_draw_at, fb_back
}

fn ready(state: u64) -> bool {
    return false
}

// RUNDE GLYPHE: ohne Oberflaeche gibt es keinen Zeichenweg und
// damit nichts nachzuweisen. `smp.glyphrace` sieht die Absage an
// der Schriftnummer und schreibt eine Zeile statt zu messen.
// RUNDE VSYNC: ohne Oberflaeche gibt es keinen Vorderpuffer, an dem
// etwas reissen koennte -- und keinen Fensterserver, der ihn ablesen
// wuerde. Also ein Nichts, wie alles andere in dieser Datei.
fn leser_tick(state: u64) {
    let _u: u64 = state
}

