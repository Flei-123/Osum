// RUNDE BLECHFUENF: ohne Rahmenpuffer gibt es keine Absturzanzeige --
// dann bleibt es bei der seriellen Meldung, so wie seit Runde 59.
fn absturz(state: u64, vec: u64, err: u64, rip: u64, cr2: u64, rsp: u64,
    cs: u64, kern: u64, spur: u64, spurn: u64, gestoppt: u64) {
}

// RUNDE PROTOKOLL: ohne Rahmenpuffer kein Panik-Bildschirm. Der Bericht
// geht in diesem Bau ueber die serielle Leitung und nach /var/crash --
// ein Server hat keinen Menschen davor, der etwas fotografieren
// koennte.
fn panikbild(state: u64, vec: u64, err: u64, rip: u64, cr2: u64,
    rsp: u64, cs: u64, flg: u64, ss: u64, kern: u64, regs: u64,
    spur: u64, spurn: u64, datei: u64) {
}

// ... und keinen Herzschlag auf dem Schirm. Die Lampe der Tastatur
