// RUNDE BRIDGE-2: ohne Oberflaeche gibt es kein Bildschirmfoto, und der
// Kern sagt das mit derselben Nummer wie bei allen anderen GUI-Aufrufen.
// Der Helfer (kernel/app/jarvisd.fi) prueft GENAU darauf und faellt
// dann auf seinen Ring-3-Weg zurueck.
fn sys_shot(state: u64, me: u64, what: u64, a1: u64, a2: u64) -> u64 {
    return errno.neg(errno.E_NOSYS)
}

// RUNDE BRUECKE: ohne Fensterserver gibt es keinen Tastaturring, in
// den man etwas einspeisen koennte. -ENOSYS ist die ehrliche Antwort:
// nicht "abgelehnt" (das hiesse, es gaebe den Weg und er ist zu), und
// nicht "geht" (das waere gelogen).
fn sys_tipp(state: u64, me: u64, what: u64, a1: u64, a2: u64) -> u64 {
    return errno.neg(errno.E_NOSYS)
}

