// SPDX-License-Identifier: GPL-2.0-only
// kernel/vgpu.fi -- RUNDE VIRTIOGPU: EIN BILDSCHIRM, DER NICHT MEHR
// DURCH DIE RECHENEINHEIT GEHT.
//
// ===================================================================
// WAS VORHER WAR, UND WARUM ES NICHT REICHT
// ===================================================================
//
// Bis zu dieser Runde malt Osum in einen Zweitpuffer im Arbeitsspeicher
// und KOPIERT ihn danach in den linearen Rahmenpuffer, den die Firmware
// gesetzt hat. Jeder Bildpunkt geht dabei durch die Recheneinheit --
// zweimal sogar, einmal gelesen und einmal geschrieben. Gemessen auf
// diesem Wirt (800x600, bewegter Zeiger, `tools/vgpu/messen.sh`):
//
//     okt=16364288000  rect=8562  bilder=8469  je=1932257
//
// 1 932 257 Oktette JE BILD, bei 1 920 000 Oktetten fuer ein volles
// Bild. Es geht also bei jedem einzelnen Bild der GANZE Puffer ueber
// den Bus, auch wenn sich nur die Uhr in der Leiste geaendert hat.
//
// Der Grund steht in `fb.fi` und ist kein Versehen: der Rahmenpuffer
// der Firmware ist ein Stueck Speicher ohne Verstand. Man kann ihm
// nicht sagen "hier hat sich etwas geaendert" -- man kann nur
// hineinschreiben. Was man auslaesst, bleibt alt.
//
// ===================================================================
// WARUM VIRTIO-GPU UND NICHT INTEL ODER AMD
// ===================================================================
//
// Weil es auf DIESER Maschine messbar ist. Ein Intel-Treiber waere auf
// diesem Wirt nicht einmal startbar -- es gibt keine Intel-Grafik im
// Kasten, also gaebe es Quelltext ohne einen einzigen Messwert
// dahinter. virtio-gpu ist in QEMU vorhanden, vollstaendig, und mit
// Bildern und Zeiten nachpruefbar.
//
// Und es ist kein Spielzeug: VIRTIO 1.2, Abschnitt "GPU Device",
// beschreibt ein Geraet mit Ressourcen, angehaengtem Speicher,
// Teilflaechenuebertragung und einem Ereignis bei Schirmwechsel.
// Genau die Struktur, in die ein Blechtreiber spaeter passt -- ein
// echter Treiber fuer Intel hat DIESELBEN vier Schritte, nur mit
// anderen Registern davor.
//
// ===================================================================
// DIE SECHS SCHRITTE, IN DER REIHENFOLGE, IN DER SIE PASSIEREN
// ===================================================================
//
//   1. FINDEN. Hersteller 0x1AF4, Klasse 03:80 (Anzeige, "andere").
//      Das moderne Geraet meldet 0x1050.
//   2. AUFSETZEN. Dieselben vier Bereiche wie bei virtio-net, dieselbe
//      Aushandlung, dieselbe Warteschlange. DER TRANSPORT IST DERSELBE
//      -- das ist der ganze Sinn von virtio, und deshalb steht hier
//      auch nichts davon noch einmal, was in `virtio.fi` schon steht.
//      Was hier steht, ist die GPU-Seite: welche Befehle es gibt und
//      was sie bedeuten.
//   3. EINE RESSOURCE ANLEGEN (`RESOURCE_CREATE_2D`). Das ist die
//      Bildflaeche, wie das GERAET sie sieht: Breite, Hoehe, Format.
//   4. SPEICHER ANHAENGEN (`RESOURCE_ATTACH_BACKING`). Jetzt bekommt
//      die Ressource den Zweitpuffer des Kerns als Unterlage. AB HIER
//      MALT OSUM UNVERAENDERT WEITER -- derselbe Puffer, dieselben
//      Zeichenroutinen, dieselbe `fb.fi`. Das ist der Grund, warum
//      diese Runde nichts am Zeichnen aendert.
//   5. ANZEIGEN (`SET_SCANOUT`). Der Schirm 0 zeigt ab jetzt diese
//      Ressource.
//   6. UND DANN, JE BILD, NUR NOCH ZWEI BEFEHLE:
//      `TRANSFER_TO_HOST_2D` traegt EIN RECHTECK aus der Unterlage in
//      die Ressource, `RESOURCE_FLUSH` sagt dem Schirm Bescheid.
//      Beide bekommen das Rechteck, das `fb.fi` mitgeschrieben hat.
//
// DER GEWINN LIEGT IN SCHRITT 6 und nirgends sonst. Die Schritte 3 bis
// 5 passieren einmal beim Start.
//
// ===================================================================
// WAS DIESER TREIBER NICHT TUT, AUSDRUECKLICH
// ===================================================================
//
// * KEIN 3D, kein virgl. `VIRTIO_GPU_F_VIRGL` wird ABGELEHNT. Das ist
//   keine Bescheidenheit: 3D braucht einen Uebersetzer fuer
//   OpenGL-Befehlsstroeme, und der ist eine eigene Arbeit von Monaten.
// * KEINE Zeigerwarteschlange. virtio-gpu kann einen Mauszeiger in
//   Hardware ueberlagern (`cursorq`). Osum malt seinen Zeiger heute in
//   den Puffer, und das bleibt so -- sonst waere der Zeiger in zwei
//   Fassungen unterwegs und keine davon die richtige.
// * KEINE Unterbrechung. Der Treiber FRAGT die Warteschlange ab
//   (`warte`). Bei zwei Befehlen je Bild und einer Antwort, die in
//   Mikrosekunden kommt, ist eine Unterbrechung teurer als das Warten
//   -- und sie waere ein zusaetzlicher Vektor, den `trap.fi` kennen
//   muesste. Das ist eine EIGENE Runde wert, wenn die Messung sie
//   verlangt; heute verlangt sie sie nicht.
// * KEINE mehreren Schirme. Der Treiber liest, WIE VIELE es gibt, und
//   nimmt den ersten angeschlossenen. Die Struktur fuer mehr ist da
//   (`S_SCANOUTS`), der Rest ist G-007 und eine eigene Runde.
//
// ===================================================================
// DER RUECKFALL IST DIE WICHTIGSTE ZUSAGE DIESER RUNDE
// ===================================================================
//
// Justins echtes Brett hat KEIN virtio-gpu -- es hat eine Intel-
// Grafikeinheit und einen Rahmenpuffer von der Firmware. Findet dieser
// Treiber kein Geraet, muss ALLES unveraendert weiterlaufen. Deshalb:
//
//   * `init` gibt `false` zurueck und hinterlaesst NICHTS. Kein
//     halb aufgesetztes Geraet, keine veraenderte `fb.fi`.
//   * `bereit()` ist `false`, und `fb.flush`/`flush_rect` nehmen
//     ihren alten Weg, Zeile fuer Zeile wie bisher.
//   * Der Treiber haengt HINTER der Naht `gfx.fi` und nicht daneben.
//     Der uebrige Kern ruft `gfx.flush` wie immer.

profile kernel

import kstate
import mem
import pci
import serial
import fb
import arch.x86_64.apic
import arch.arch

export {
    init, bereit, present, scanout_w, scanout_h, scanouts,
    transfers, flushes, oktette, fehler, bdf, idx,
    ereignis_pruefen, ereignisse, neu_w, neu_h, umgestellt,
    say, shut_down,
    VGPU_OFF, VGPU_MAX
}

// ------------------------------------------------- der Datenbereich
//
// Eine eigene Seite in `kdata`. NICHT in `pci.K2_SCALARS`: die Seite
// ist zwischen pci, apic, nvme, virtio-net, inet und hw schon eng, und
// dieser Treiber braucht mehr als ein paar Zahlen -- er braucht auch
// die Liste der Schirme. `tools/kernel/memmap.py` rechnet nach, dass
// sich der Bereich mit keinem anderen ueberschneidet.
// DIESE ZWEI ZAHLEN SIND EIN SPIEGEL VON `kstate.fi`. Dort steht die
// Karte des Datenbereichs, und `tools/kernel/memmap.py` rechnet nach,
// dass beide Stellen dasselbe sagen und dass sich der Bereich mit
// keinem der 109 anderen ueberschneidet. Dieselbe benannte Doppelung
// wie bei `fb.fi` (FB_OFF) -- und aus demselben Grund: eine Konstante
// aus einem anderen Modul waere hier eine Abhaengigkeit, die der
// Uebersetzer beim Bauen des Baums nicht aufloesen kann.
const VGPU_OFF: u64 = 0xF2000
const VGPU_MAX: u64 = 0x1000

const S_COMMON: u64 = 0x000 // die vier Bereiche, wie der KERN sie sieht
const S_NOTIFY: u64 = 0x008
const S_NMULT: u64 = 0x010
const S_ISR: u64 = 0x018
const S_DEVCFG: u64 = 0x020
const S_BDF: u64 = 0x028
const S_IDX: u64 = 0x030
const S_READY: u64 = 0x038 // 1 = der Treiber traegt das Bild hinaus
const S_RING: u64 = 0x040 // die Seiten der Steuerwarteschlange
const S_DOOR: u64 = 0x048 // wo Warteschlange 0 geklopft wird
const S_AVAIL: u64 = 0x050 // eigene Kopie von avail.idx
const S_USED: u64 = 0x058 // letzter abgearbeiteter used.idx
const S_FEAT: u64 = 0x060
const S_SCANOUTS: u64 = 0x068 // wie viele Schirme das Geraet hat
const S_SW: u64 = 0x070 // Breite des benutzten Schirms
const S_SH: u64 = 0x078
const S_RESID: u64 = 0x080 // Nummer der angelegten Ressource
const S_BACK: u64 = 0x088 // der Zweitpuffer, den wir angehaengt haben
const S_BACKBYTES: u64 = 0x090
const S_TRANSFERS: u64 = 0x098 // wie oft TRANSFER_TO_HOST_2D lief
const S_FLUSHES: u64 = 0x0A0 // wie oft RESOURCE_FLUSH lief
const S_OKT: u64 = 0x0A8 // Oktette, die wirklich uebertragen wurden
const S_FEHLER: u64 = 0x0B0 // Antworten, die kein OK waren
const S_EREIG: u64 = 0x0B8 // wie oft EVENT_DISPLAY kam
const S_NEUW: u64 = 0x0C0 // die Groesse, die das Geraet zuletzt nannte
const S_NEUH: u64 = 0x0C8
const S_UMGESTELLT: u64 = 0x0D0 // wie oft wir darauf umgestellt haben
const S_LASTERR: u64 = 0x0D8 // der letzte Antwortcode, der nicht OK war

// Die Puffer fuer Befehl und Antwort. Sie liegen IM RING-Speicher, weil
// ein Deskriptor eine PHYSISCHE Adresse traegt und der Haldenspeicher
// des Kerns keine Zusage ueber Zusammenhang macht.
const QSIZE: u64 = 16 // 16 Deskriptoren: je Bild braucht es zwei
const DESC_OFF: u64 = 0x0000 // 16 * 16 = 256
const AVAIL_OFF: u64 = 0x1000 // 4 + 16*2 + 2 = 38
const USED_OFF: u64 = 0x2000 // 4 + 16*8 + 2 = 134
const CMD_OFF: u64 = 0x3000 // der Befehlspuffer
const RSP_OFF: u64 = 0x4000 // der Antwortpuffer
// RUNDE VIRTIOGPU, NACHTRAG: EIN ZWEITES PAAR FUER DEN ZUG ZU ZWEIT.
// `present` schickt zwei Befehle je Bild. Wartet es nach jedem, sind
// das ZWEI Umlaeufe zum Wirt; mit zwei Puffern gehen beide zusammen
// heraus und es wird EINMAL gewartet. Warum das noetig ist, steht bei
// `present_paar` -- mit einer gemessenen Zahl dahinter.
const CMD2_OFF: u64 = 0x5000
const RSP2_OFF: u64 = 0x6000
const RING_BYTES: u64 = 0x7000

const CMD_MAX: u64 = 512 // groesster Befehl: ATTACH_BACKING mit Eintraegen
const RSP_MAX: u64 = 512

// ----------------------------------------------------- die Konstanten

const VENDOR_VIRTIO: u64 = 0x1AF4
const CLASS_DISPLAY: u64 = 0x03
const SUB_OTHER: u64 = 0x80

const CAP_VENDOR: u64 = 0x09
const VC_TYPE: u64 = 3
const VC_BAR: u64 = 4
const VC_OFFSET: u64 = 8
const VC_LENGTH: u64 = 12
const VC_NOTIFY_MULT: u64 = 16

const CFG_COMMON: u64 = 1
const CFG_NOTIFY: u64 = 2
const CFG_ISR: u64 = 3
const CFG_DEVICE: u64 = 4

const C_DFSELECT: u64 = 0x00
const C_DFEATURE: u64 = 0x04
const C_GFSELECT: u64 = 0x08
const C_GFEATURE: u64 = 0x0C
const C_MSIX_CFG: u64 = 0x10
const C_NUMQ: u64 = 0x12
const C_STATUS: u64 = 0x14
const C_GENERATION: u64 = 0x15
const C_QSELECT: u64 = 0x16
const C_QSIZE: u64 = 0x18
const C_QMSIX: u64 = 0x1A
const C_QENABLE: u64 = 0x1C
const C_QNOTIFY_OFF: u64 = 0x1E
const C_QDESC: u64 = 0x20
const C_QDRIVER: u64 = 0x28
const C_QDEVICE: u64 = 0x30

const ST_ACK: u64 = 1
const ST_DRIVER: u64 = 2
const ST_DRIVER_OK: u64 = 4
const ST_FEATURES_OK: u64 = 8
const ST_FAILED: u64 = 128

const F_VERSION_1: u64 = 0 // Bit 32 des Ganzen, Bit 0 im hohen Fenster
const F_EDID: u64 = 1 // VIRTIO_GPU_F_EDID -- die Tafelkennung

const NO_VECTOR: u64 = 0xFFFF
const D_NEXT: u64 = 1
const D_WRITE: u64 = 2

// Die Geraetekonfiguration von virtio-gpu (VIRTIO 1.2, 5.7.4).
const G_EVENTS_READ: u64 = 0
const G_EVENTS_CLEAR: u64 = 4
const G_NUM_SCANOUTS: u64 = 8

// Das Ereignisbit: der Wirt hat die Anzeige geaendert.
const EVENT_DISPLAY: u64 = 1

// Die Befehle (VIRTIO 1.2, 5.7.6.7). Nur die, die dieser Treiber
// wirklich schickt -- eine Liste aller Befehle waere eine Abschrift.
const CMD_GET_DISPLAY_INFO: u64 = 0x0100
const CMD_RESOURCE_CREATE_2D: u64 = 0x0101
const CMD_SET_SCANOUT: u64 = 0x0103
const CMD_RESOURCE_FLUSH: u64 = 0x0104
const CMD_TRANSFER_TO_HOST_2D: u64 = 0x0105
const CMD_RESOURCE_ATTACH_BACKING: u64 = 0x0106
const CMD_RESOURCE_UNREF: u64 = 0x0102

const RESP_OK_NODATA: u64 = 0x1100
const RESP_OK_DISPLAY_INFO: u64 = 0x1101

// Das Format. B8G8R8X8 ist das, was `fb.fi` in den Zweitpuffer malt:
// vier Oktette je Bildpunkt, blau im niedrigsten. Ein falsches Format
// hier ist der klassische Fehler, der ein Bild mit vertauschten Farben
// ergibt -- und der beim Bildvergleich sofort auffaellt.
const FMT_B8G8R8X8: u64 = 2

// Die Nummer, unter der die Bildflaeche beim Geraet gefuehrt wird. 0 ist
// verboten (die Spezifikation nennt 0 ausdruecklich ungueltig).
const RES_ID: u64 = 1

const SPIN_LIMIT: u64 = 20000000

// --------------------------------------------------- kleine Helfer

fn s(off: u64) -> u64 {
    return VGPU_OFF + off
}

fn rd8(b: u64, off: u64) -> u64 {
    return __mmio_read8((b + off) as *mut u8) as u64
}

fn wr8(b: u64, off: u64, v: u64) {
    __mmio_write8((b + off) as *mut u8, v as u8)
}

fn rd16(b: u64, off: u64) -> u64 {
    return __mmio_read16((b + off) as *mut u16) as u64
}

fn wr16(b: u64, off: u64, v: u64) {
    __mmio_write16((b + off) as *mut u16, v as u16)
}

fn rd32(b: u64, off: u64) -> u64 {
    return __mmio_read32((b + off) as *mut u32) as u64
}

fn wr32(b: u64, off: u64, v: u64) {
    __mmio_write32((b + off) as *mut u32, v as u32)
}

fn wr64(b: u64, off: u64, v: u64) {
    wr32(b, off, v & 0xFFFFFFFF)
    wr32(b, off + 4, v >> 32)
}

fn common(state: u64) -> u64 {
    return kstate.get(state, s(S_COMMON))
}

fn bereit(state: u64) -> bool {
    return kstate.get(state, s(S_READY)) != 0
}

fn bdf(state: u64) -> u64 { return kstate.get(state, s(S_BDF)) }
fn idx(state: u64) -> u64 { return kstate.get(state, s(S_IDX)) }
fn scanout_w(state: u64) -> u64 { return kstate.get(state, s(S_SW)) }
fn scanout_h(state: u64) -> u64 { return kstate.get(state, s(S_SH)) }
fn scanouts(state: u64) -> u64 { return kstate.get(state, s(S_SCANOUTS)) }
fn transfers(state: u64) -> u64 { return kstate.get(state, s(S_TRANSFERS)) }
fn flushes(state: u64) -> u64 { return kstate.get(state, s(S_FLUSHES)) }
fn oktette(state: u64) -> u64 { return kstate.get(state, s(S_OKT)) }
fn fehler(state: u64) -> u64 { return kstate.get(state, s(S_FEHLER)) }
fn ereignisse(state: u64) -> u64 { return kstate.get(state, s(S_EREIG)) }
fn neu_w(state: u64) -> u64 { return kstate.get(state, s(S_NEUW)) }
fn neu_h(state: u64) -> u64 { return kstate.get(state, s(S_NEUH)) }
fn umgestellt(state: u64) -> u64 { return kstate.get(state, s(S_UMGESTELLT)) }

// ------------------------------------------------ der geteilte Ring
//
// Genau die Bauform aus `virtio.fi`. Sie steht hier noch einmal und
// nicht als Aufruf dorthin, weil `virtio.fi` seine Ringe fuer ZWEI
// Warteschlangen einer NETZKARTE haelt, mit Empfangspuffern und
// Kartennummern -- die Struktur ist dieselbe, die Buchhaltung nicht.
// Eine gemeinsame Ringbibliothek waere die sauberere Loesung und ist
// eine eigene Runde wert; sie hier zu erzwingen hiesse, den
// Netztreiber in derselben Runde umzubauen, in der die Grafik neu ist.

fn desc_set(table: u64, i: u64, addr: u64, len: u64, flags: u64, next: u64) {
    let d: u64 = table + i * 16
    wr64(d, 0, addr)
    wr32(d, 8, len)
    wr16(d, 12, flags)
    wr16(d, 14, next)
}

fn avail_put(a: u64, slot: u64, desc: u64) {
    wr16(a, 4 + slot * 2, desc)
}

// DER INDEX IST SECHZEHN BIT BREIT UND LAEUFT UEBER -- ABSICHTLICH.
//
// VIRTIO 1.2, 2.7.6: `idx` zaehlt frei weiter und wird MODULO 2^16
// gelesen; das Geraet rechnet genauso. Der Treiber muss ihn also
// beschneiden, bevor er ihn schreibt.
//
// GEMESSEN, UND DESHALB STEHT ES HIER: ohne diese Maske lief der Kern
// genau so lange, bis 65536 Befehle heraus waren -- bei zwei Befehlen
// je Bild sind das gut 32000 Bilder, also eine halbe Minute. Dann
// `panic: integer overflow casting 'u64 as u16'`. Ein Fehler, der
// eine halbe Minute braucht, um sich zu zeigen, ist genau der, den
// eine kurze Messung nicht findet -- diese hier hat ihn gefunden,
// weil sie 103420 Bilder lang war.
fn avail_publish(a: u64, v: u64) {
    wr16(a, 2, v & 0xFFFF)
}

fn used_idx(u: u64) -> u64 {
    return rd16(u, 2)
}

fn kick(state: u64) {
    let door: u64 = kstate.get(state, s(S_DOOR))
    if door == 0 {
        return
    }
    wr16(door, 0, 0)
}

// -------------------------------------------------- die Faehigkeiten

fn find_vcap(d: u64, want: u64) -> u64 {
    if (pci.cfg_read16(d, 0x06) & 0x10) == 0 {
        return 0
    }
    var off: u64 = pci.cfg_read8(d, 0x34) & 0xFC
    var guard: u64 = 0
    while off >= 0x40 && guard < 48 {
        if pci.cfg_read8(d, off) == CAP_VENDOR {
            if pci.cfg_read8(d, off + VC_TYPE) == want {
                return off
            }
        }
        off = pci.cfg_read8(d, off + 1) & 0xFC
        guard = guard + 1
    }
    return 0
}

fn region(state: u64, i: u64, d: u64, cap: u64) -> u64 {
    if cap == 0 {
        return 0
    }
    let which: u64 = pci.cfg_read8(d, cap + VC_BAR)
    if which >= 6 {
        return 0
    }
    let phys: u64 = pci.bar(state, i, which)
    if phys == 0 || pci.bar_is_io(state, i, which) {
        return 0
    }
    let off: u64 = pci.cfg_read32(d, cap + VC_OFFSET)
    return apic.map_device(state, phys + off)
}

fn status(state: u64) -> u64 {
    return rd8(common(state), C_STATUS)
}

fn status_add(state: u64, bits: u64) {
    wr8(common(state), C_STATUS, status(state) | bits)
}

fn reset(state: u64) -> bool {
    wr8(common(state), C_STATUS, 0)
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        if rd8(common(state), C_STATUS) == 0 {
            return true
        }
        arch.pause()
        spin = spin + 1
    }
    return false
}

// DAS GERAET FINDEN. Klasse 03:80 -- "Anzeige, anderes". Eine normale
// VGA-Karte meldet 03:00; virtio-gpu meldet ausdruecklich NICHT VGA,
// solange es nicht im Uebergangsbetrieb laeuft. Beides wird genommen,
// weil QEMU je nach Fassung das eine oder das andere zeigt.
fn find(state: u64) -> u64 {
    let n: u64 = pci.count(state)
    var i: u64 = 0
    while i < n {
        if pci.get(state, i, pci.E_VENDOR) == VENDOR_VIRTIO {
            if pci.get(state, i, pci.E_CLASS) == CLASS_DISPLAY {
                return i
            }
        }
        i = i + 1
    }
    return pci.MAX_DEV
}

// ------------------------------------------------------ die Aushandlung

fn negotiate(state: u64) -> bool {
    let b: u64 = common(state)
    wr32(b, C_DFSELECT, 0)
    let dev_lo: u64 = rd32(b, C_DFEATURE)
    wr32(b, C_DFSELECT, 1)
    let dev_hi: u64 = rd32(b, C_DFEATURE)

    // Ohne Bit 32 spraeche das Geraet die alte Anordnung, und jede
    // Adresse, die dieser Treiber ausrechnet, laege falsch.
    if (dev_hi & (1 << F_VERSION_1)) == 0 {
        return false
    }
    // AUSDRUECKLICH NICHTS AUS DEM NIEDRIGEN FENSTER. `VIRGL` (Bit 0)
    // waere 3D und `EDID` (Bit 1) die Tafelkennung -- beides braucht
    // dieser Treiber nicht, und was man nicht braucht, lehnt man ab,
    // statt es mitzunehmen und zu ignorieren.
    let lo: u64 = 0
    let hi: u64 = 1 << F_VERSION_1

    wr32(b, C_GFSELECT, 0)
    wr32(b, C_GFEATURE, lo)
    wr32(b, C_GFSELECT, 1)
    wr32(b, C_GFEATURE, hi)
    kstate.set(state, s(S_FEAT), lo)

    status_add(state, ST_FEATURES_OK)
    if (status(state) & ST_FEATURES_OK) == 0 {
        return false
    }
    return true
}

fn queue_setup(state: u64) -> bool {
    let b: u64 = common(state)
    let r: u64 = kstate.get(state, s(S_RING))
    // Warteschlange 0 ist die Steuerwarteschlange (`controlq`).
    wr16(b, C_QSELECT, 0)
    let offered: u64 = rd16(b, C_QSIZE)
    if offered == 0 {
        return false
    }
    if offered > QSIZE {
        wr16(b, C_QSIZE, QSIZE)
    }
    if rd16(b, C_QSIZE) != QSIZE {
        return false
    }
    wr64(b, C_QDESC, r + DESC_OFF)
    wr64(b, C_QDRIVER, r + AVAIL_OFF)
    wr64(b, C_QDEVICE, r + USED_OFF)
    wr16(b, C_QMSIX, NO_VECTOR)
    let door: u64 = kstate.get(state, s(S_NOTIFY))
        + rd16(b, C_QNOTIFY_OFF) * kstate.get(state, s(S_NMULT))
    kstate.set(state, s(S_DOOR), door)
    wr16(b, C_QENABLE, 1)
    return rd16(b, C_QENABLE) == 1
}

// ===================================================================
// EIN BEFEHL HIN, EINE ANTWORT ZURUECK
// ===================================================================
//
// Jeder virtio-gpu-Befehl ist zwei Puffer: einer, den das GERAET LIEST
// (der Befehl), und einer, in den es SCHREIBT (die Antwort). Also zwei
// Deskriptoren, der erste mit `D_NEXT` auf den zweiten, der zweite mit
// `D_WRITE`.
//
// DIE REIHENFOLGE DER SCHREIBZUGRIFFE IST TEIL DES PROTOKOLLS: der
// Deskriptor muss vollstaendig im Speicher stehen, bevor der
// Verfuegbarkeitsring auf ihn zeigt, und der Ring muss stehen, bevor
// sein Index sich bewegt. Auf x86 werden Schreibzugriffe nicht
// gegeneinander verschoben, also braucht es dafuer keinen Zaun -- was
// es braucht, ist, dass der Uebersetzer sie nicht verschiebt, und
// dafuer geht jeder Zugriff hier durch die fluechtigen Eingriffe.
//
// `laenge` ist die Laenge des Befehls, `erwartet` der Antwortcode, der
// als Erfolg gilt. Rueckgabe: true, wenn die Antwort genau der war.
fn befehl(state: u64, laenge: u64, erwartet: u64) -> bool {
    let r: u64 = kstate.get(state, s(S_RING))
    let desc: u64 = r + DESC_OFF
    let avail: u64 = r + AVAIL_OFF
    let used: u64 = r + USED_OFF
    let cmd: u64 = r + CMD_OFF
    let rsp: u64 = r + RSP_OFF

    // Die Antwort vorher loeschen. Sonst liest ein Fehlschlag den
    // Erfolg des letzten Befehls und meldet ihn als seinen eigenen --
    // der unangenehmste Fehler dieser Art, weil er nur manchmal
    // auftritt.
    var z: u64 = 0
    while z < 32 {
        __mmio_write64((rsp + z) as *mut u64, 0)
        z = z + 8
    }

    // Immer dieselben zwei Deskriptoren, 0 und 1. Der Ring ist 16 lang,
    // aber dieser Treiber hat nie mehr als einen Befehl unterwegs: er
    // wartet auf die Antwort, bevor er den naechsten schickt. Das ist
    // die einfachste Fassung, die richtig ist -- und bei zwei Befehlen
    // je Bild kostet sie nichts Messbares.
    desc_set(desc, 0, cmd, laenge, D_NEXT, 1)
    desc_set(desc, 1, rsp, RSP_MAX, D_WRITE, 0)

    let vor: u64 = used_idx(used)
    var ai: u64 = kstate.get(state, s(S_AVAIL))
    avail_put(avail, ai % QSIZE, 0)
    arch.barrier_write()
    ai = ai + 1
    avail_publish(avail, ai)
    kstate.set(state, s(S_AVAIL), ai)
    arch.barrier_write()
    kick(state)

    // WARTEN, UND ZWAR MIT EINER GRENZE. Ein Geraet, das nie antwortet,
    // darf den Kern nicht anhalten -- sonst haengt die Gegenprobe,
    // statt zusammenzubrechen. Dieselbe Regel wie in `nvme.fi`.
    var spin: u64 = 0
    var da: bool = false
    while spin < SPIN_LIMIT {
        if used_idx(used) != vor {
            da = true
            spin = SPIN_LIMIT
        } else {
            arch.pause()
            spin = spin + 1
        }
    }
    if !da {
        kstate.add(state, s(S_FEHLER), 1)
        return false
    }
    arch.barrier_read()
    kstate.set(state, s(S_USED), used_idx(used))

    let typ: u64 = rd32(rsp, 0)
    if typ != erwartet {
        kstate.add(state, s(S_FEHLER), 1)
        kstate.set(state, s(S_LASTERR), typ)
        return false
    }
    return true
}

// ===================================================================
// ZWEI BEFEHLE, EIN UMLAUF
// ===================================================================
//
// WARUM ES DIESE FUNKTION GEBEN MUSS, UND DIE ZAHL DAZU.
//
// `present` schickt je Bild ZWEI Befehle: `TRANSFER_TO_HOST_2D` und
// danach `RESOURCE_FLUSH`. Die erste Fassung wartete nach jedem auf
// seine Antwort -- also zwei volle Umlaeufe zum Wirt und zurueck.
//
// GEMESSEN, schlimmster Fall (`wmruhe`, der ganze Schirm in jedem
// Takt, 4 s):
//     alt (Kopie)       5458 Bilder
//     neu (zwei Wartungen) 2890 Bilder   -- 47 % WENIGER
//
// Der Treiber war dort LANGSAMER als die Kopie, die er ersetzen soll.
// Bei vollem Schmutz gibt es keine Oktette zu sparen, also blieb nur
// der Preis des Wartens stehen -- und der war hoeher als der Gewinn.
//
// DIE ABHILFE IST NICHT, WENIGER ZU PRUEFEN, sondern beide Befehle
// ZUSAMMEN einzureihen: vier Deskriptoren statt zwei, ein Klopfen,
// eine Wartung auf ZWEI Antworten. Der Wirt arbeitet sie in der
// Reihenfolge des Rings ab, und die ist genau die, die das Protokoll
// verlangt -- erst uebertragen, dann zeigen.
//
// `laenge1`/`laenge2` sind die Laengen der beiden Befehle. Beide
// muessen `RESP_OK_NODATA` antworten; alles andere ist ein Fehler.
fn befehl_paar(state: u64, laenge1: u64, laenge2: u64) -> bool {
    let r: u64 = kstate.get(state, s(S_RING))
    let desc: u64 = r + DESC_OFF
    let avail: u64 = r + AVAIL_OFF
    let used: u64 = r + USED_OFF

    var z: u64 = 0
    while z < 32 {
        __mmio_write64((r + RSP_OFF + z) as *mut u64, 0)
        __mmio_write64((r + RSP2_OFF + z) as *mut u64, 0)
        z = z + 8
    }

    // Kette 1: Deskriptor 0 (Befehl) -> 1 (Antwort).
    desc_set(desc, 0, r + CMD_OFF, laenge1, D_NEXT, 1)
    desc_set(desc, 1, r + RSP_OFF, RSP_MAX, D_WRITE, 0)
    // Kette 2: Deskriptor 2 (Befehl) -> 3 (Antwort).
    desc_set(desc, 2, r + CMD2_OFF, laenge2, D_NEXT, 3)
    desc_set(desc, 3, r + RSP2_OFF, RSP_MAX, D_WRITE, 0)

    let vor: u64 = used_idx(used)
    var ai: u64 = kstate.get(state, s(S_AVAIL))
    // BEIDE Ketten in den Verfuegbarkeitsring, DANN erst den Index
    // bewegen. Bewegte man ihn dazwischen, koennte das Geraet die
    // erste holen, bevor die zweite steht -- richtig waere es auch
    // dann, aber es waeren wieder zwei Umlaeufe.
    avail_put(avail, ai % QSIZE, 0)
    avail_put(avail, (ai + 1) % QSIZE, 2)
    arch.barrier_write()
    ai = ai + 2
    avail_publish(avail, ai)
    kstate.set(state, s(S_AVAIL), ai)
    arch.barrier_write()
    kick(state)

    // Auf ZWEI Rueckgaben warten. `used.idx` zaehlt sie einzeln hoch,
    // also ist die Bedingung "mindestens zwei weiter als vorher" --
    // und sie muss den Ueberlauf bei 2^16 vertragen, sonst haengt der
    // Treiber genau einmal je 65536 Befehlen fuer immer.
    var spin: u64 = 0
    var fertig: bool = false
    while spin < SPIN_LIMIT {
        let jetzt: u64 = used_idx(used)
        if ((jetzt -% vor) & 0xFFFF) >= 2 {
            fertig = true
            spin = SPIN_LIMIT
        } else {
            arch.pause()
            spin = spin + 1
        }
    }
    if !fertig {
        kstate.add(state, s(S_FEHLER), 1)
        return false
    }
    arch.barrier_read()
    kstate.set(state, s(S_USED), used_idx(used))

    let t1: u64 = rd32(r + RSP_OFF, 0)
    let t2: u64 = rd32(r + RSP2_OFF, 0)
    if t1 != RESP_OK_NODATA || t2 != RESP_OK_NODATA {
        kstate.add(state, s(S_FEHLER), 1)
        var schlecht: u64 = t1
        if t1 == RESP_OK_NODATA {
            schlecht = t2
        }
        kstate.set(state, s(S_LASTERR), schlecht)
        return false
    }
    return true
}

// Der Kopf jedes Befehls: 24 Oktette (VIRTIO 1.2, 5.7.6.6).
//   0 type, 4 flags, 8 fence_id (8 Oktette), 16 ctx_id, 20 padding
fn kopf(cmd: u64, typ: u64) {
    var z: u64 = 0
    while z < CMD_MAX {
        __mmio_write64((cmd + z) as *mut u64, 0)
        z = z + 8
    }
    wr32(cmd, 0, typ)
}

// ------------------------------------------------ die sechs Befehle

// WIE GROSS IST DER SCHIRM? Das Geraet fuehrt bis zu 16 Schirme; jeder
// hat ein Rechteck und ein Kennzeichen, ob etwas angeschlossen ist.
// Genommen wird der ERSTE ANGESCHLOSSENE -- nicht einfach der Schirm 0,
// denn der kann abgemeldet sein.
fn display_info(state: u64) -> bool {
    let r: u64 = kstate.get(state, s(S_RING))
    let cmd: u64 = r + CMD_OFF
    let rsp: u64 = r + RSP_OFF
    kopf(cmd, CMD_GET_DISPLAY_INFO)
    if !befehl(state, 24, RESP_OK_DISPLAY_INFO) {
        return false
    }
    // Die Antwort: Kopf (24), dann 16 Eintraege zu je 24 Oktetten
    // (x, y, breite, hoehe, angeschlossen, flags).
    let n: u64 = kstate.get(state, s(S_SCANOUTS))
    var i: u64 = 0
    while i < n && i < 16 {
        let e: u64 = rsp + 24 + i * 24
        let angeschlossen: u64 = rd32(e, 16)
        if angeschlossen != 0 {
            let w: u64 = rd32(e, 8)
            let h: u64 = rd32(e, 12)
            if w != 0 && h != 0 {
                kstate.set(state, s(S_SW), w)
                kstate.set(state, s(S_SH), h)
                return true
            }
        }
        i = i + 1
    }
    return false
}

// EINE BILDFLAECHE ANLEGEN, wie das Geraet sie sieht.
fn resource_create(state: u64, w: u64, h: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    kopf(cmd, CMD_RESOURCE_CREATE_2D)
    wr32(cmd, 24, RES_ID)
    wr32(cmd, 28, FMT_B8G8R8X8)
    wr32(cmd, 32, w)
    wr32(cmd, 36, h)
    return befehl(state, 40, RESP_OK_NODATA)
}

// DEN ZWEITPUFFER DES KERNS ALS UNTERLAGE ANHAENGEN.
//
// HIER LIEGT DER GANZE TRICK DIESER RUNDE. Das Geraet bekommt KEINE
// Kopie, sondern die Adresse des Speichers, in den `fb.fi` ohnehin
// malt. Ab jetzt ist "was Osum gemalt hat" und "was das Geraet lesen
// kann" DASSELBE STUECK SPEICHER -- und `TRANSFER_TO_HOST_2D` sagt nur
// noch, WELCHER TEIL davon neu ist.
//
// Ein Eintrag: Adresse (8), Laenge (4), Fuellung (4). Der Zweitpuffer
// ist EIN zusammenhaengender Lauf von Rahmen (`mem.frame_run` in
// `fb.fi`), also genuegt EIN Eintrag. Waere er zerstueckelt, muessten
// hier viele stehen -- und genau dafuer ist das Feld `nr_entries` da.
fn attach_backing(state: u64, phys: u64, bytes: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    kopf(cmd, CMD_RESOURCE_ATTACH_BACKING)
    wr32(cmd, 24, RES_ID)
    wr32(cmd, 28, 1) // ein einziger Eintrag
    wr64(cmd, 32, phys)
    wr32(cmd, 40, bytes)
    wr32(cmd, 44, 0)
    return befehl(state, 48, RESP_OK_NODATA)
}

// DER SCHIRM ZEIGT AB JETZT DIESE FLAECHE.
fn set_scanout(state: u64, w: u64, h: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    kopf(cmd, CMD_SET_SCANOUT)
    wr32(cmd, 24, 0) // r.x
    wr32(cmd, 28, 0) // r.y
    wr32(cmd, 32, w)
    wr32(cmd, 36, h)
    wr32(cmd, 40, 0) // scanout_id
    wr32(cmd, 44, RES_ID)
    return befehl(state, 48, RESP_OK_NODATA)
}

// EIN RECHTECK AUS DER UNTERLAGE IN DIE RESSOURCE TRAGEN.
//
// `offset` ist die Stelle IM PUFFER, an der die erste Zeile des
// Rechtecks beginnt. Das Geraet rechnet die weiteren Zeilen selbst aus
// der Breite der Ressource aus -- deshalb muss die Zeilenlaenge des
// Puffers und die Breite der Ressource uebereinstimmen, und deshalb
// prueft `init` das, statt es anzunehmen.
fn transfer(state: u64, x: u64, y: u64, w: u64, h: u64, offset: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    kopf(cmd, CMD_TRANSFER_TO_HOST_2D)
    wr32(cmd, 24, x)
    wr32(cmd, 28, y)
    wr32(cmd, 32, w)
    wr32(cmd, 36, h)
    wr64(cmd, 40, offset)
    wr32(cmd, 48, RES_ID)
    wr32(cmd, 52, 0)
    return befehl(state, 56, RESP_OK_NODATA)
}

// UND JETZT ZEIGEN. `RESOURCE_FLUSH` ist der Befehl, nach dem der Wirt
// das Rechteck wirklich auf den Schirm bringt.
fn resource_flush(state: u64, x: u64, y: u64, w: u64, h: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    kopf(cmd, CMD_RESOURCE_FLUSH)
    wr32(cmd, 24, x)
    wr32(cmd, 28, y)
    wr32(cmd, 32, w)
    wr32(cmd, 36, h)
    wr32(cmd, 40, RES_ID)
    wr32(cmd, 44, 0)
    return befehl(state, 48, RESP_OK_NODATA)
}

// ===================================================================
// DAS BILD ZEIGEN -- DIE EINE FUNKTION, UM DIE ES GEHT
// ===================================================================
//
// Wird aus `fb.flush`/`fb.flush_rect` gerufen, also hinter der Naht.
// Sie nimmt das Schmutzrechteck, das `fb.fi` mitgeschrieben hat, und
// traegt GENAU DAS hinaus -- nicht das ganze Bild.
//
// WARUM ZWEI BEFEHLE UND NICHT EINER: `TRANSFER_TO_HOST_2D` bringt die
// Bildpunkte in die Ressource, `RESOURCE_FLUSH` bringt die Ressource
// auf den Schirm. Das Geraet darf zwischen beiden nichts anzeigen, was
// halb fertig ist -- und genau das ist die Zusage, die diesen Weg
// reissfrei macht: der Schirm sieht das Rechteck ENTWEDER ganz alt
// ODER ganz neu, nie zur Haelfte.
fn present(state: u64) -> bool {
    if !bereit(state) {
        return false
    }
    var x0: u64 = 0
    var y0: u64 = 0
    var x1: u64 = 0
    var y1: u64 = 0
    if !fb.rect_take(state, &x0, &y0, &x1, &y1) {
        return true // nichts geaendert: nichts zu tun, und das ist Erfolg
    }
    let sw: u64 = kstate.get(state, s(S_SW))
    let sh: u64 = kstate.get(state, s(S_SH))
    if x1 > sw {
        x1 = sw
    }
    if y1 > sh {
        y1 = sh
    }
    if x1 <= x0 || y1 <= y0 {
        return true
    }
    let w: u64 = x1 - x0
    let h: u64 = y1 - y0
    let pitch: u64 = sw *% 4
    let offset: u64 = y0 *% pitch +% x0 *% 4

    // ============ BEIDE BEFEHLE ZUSAMMEN, EIN UMLAUF.
    // Der erste Puffer bekommt `TRANSFER_TO_HOST_2D`, der zweite
    // `RESOURCE_FLUSH`. Warum nicht nacheinander: siehe `befehl_paar`
    // -- zwei Wartungen je Bild haben den Treiber im schlimmsten Fall
    // langsamer gemacht als die Kopie, die er ersetzt.
    let r: u64 = kstate.get(state, s(S_RING))
    let c1: u64 = r + CMD_OFF
    let c2: u64 = r + CMD2_OFF

    kopf(c1, CMD_TRANSFER_TO_HOST_2D)
    wr32(c1, 24, x0)
    wr32(c1, 28, y0)
    wr32(c1, 32, w)
    wr32(c1, 36, h)
    wr64(c1, 40, offset)
    wr32(c1, 48, RES_ID)
    wr32(c1, 52, 0)

    kopf(c2, CMD_RESOURCE_FLUSH)
    wr32(c2, 24, x0)
    wr32(c2, 28, y0)
    wr32(c2, 32, w)
    wr32(c2, 36, h)
    wr32(c2, 40, RES_ID)
    wr32(c2, 44, 0)

    if !befehl_paar(state, 56, 48) {
        return false
    }
    kstate.add(state, s(S_TRANSFERS), 1)
    kstate.add(state, s(S_FLUSHES), 1)
    // DIE ZAHL, DIE GEZAEHLT WIRD, IST DIE EHRLICHE: Breite mal Hoehe
    // mal vier. Das ist, was das Geraet aus der Unterlage liest. Die
    // Befehlskoepfe selbst (56 + 48 Oktette) sind nicht mitgezaehlt --
    // sie sind bei jedem Bild gleich und stehen in `rect=` als Anzahl.
    kstate.add(state, s(S_OKT), w *% h *% 4)
    fb.tx_add(state, w *% h *% 4)
    return true
}

// ===================================================================
// DER SCHIRMWECHSEL ALS EREIGNIS
// ===================================================================
//
// Das Geraet meldet in seiner Konfiguration ein Bit, wenn sich die
// Anzeige geaendert hat -- in QEMU heisst das: jemand hat das Fenster
// groesser gezogen. Das Bit wird durch SCHREIBEN in `events_clear`
// geloescht, nicht durch Lesen; wer das verwechselt, bekommt dasselbe
// Ereignis fuer immer.
//
// DAS IST ZUGLEICH DER HALBE WEG ZU G-007 (mehrere Schirme, freie
// Skalierung): dieselbe Struktur, dieselbe Abfrage, nur mit mehr als
// einem Eintrag aus `display_info`.
//
// WAS HIER ABSICHTLICH NICHT PASSIERT: der Rahmenpuffer wird NICHT neu
// angelegt. Das hiesse, `fb.fi` mitten im Betrieb einen anderen
// Zweitpuffer unterzuschieben, waehrend der Fensterserver hineinmalt.
// Diese Funktion MERKT sich die neue Groesse und zaehlt sie; wer sie
// uebernehmen will, tut das an einer Stelle, an der gerade niemand
// malt. Ein halber Umbau waere schlimmer als keiner.
fn ereignis_pruefen(state: u64) -> bool {
    if !bereit(state) {
        return false
    }
    let cfg: u64 = kstate.get(state, s(S_DEVCFG))
    if cfg == 0 {
        return false
    }
    let ev: u64 = rd32(cfg, G_EVENTS_READ)
    if (ev & EVENT_DISPLAY) == 0 {
        return false
    }
    // Erst loeschen, dann fragen: kaeme zwischen Frage und Loeschung
    // ein zweites Ereignis, wuerde die Loeschung es verschlucken.
    wr32(cfg, G_EVENTS_CLEAR, EVENT_DISPLAY)
    kstate.add(state, s(S_EREIG), 1)
    let altw: u64 = kstate.get(state, s(S_SW))
    let alth: u64 = kstate.get(state, s(S_SH))
    if display_info(state) {
        let w: u64 = kstate.get(state, s(S_SW))
        let h: u64 = kstate.get(state, s(S_SH))
        kstate.set(state, s(S_NEUW), w)
        kstate.set(state, s(S_NEUH), h)
        if w != altw || h != alth {
            kstate.add(state, s(S_UMGESTELLT), 1)
            // Die gemeldete Groesse wird NICHT uebernommen, solange
            // der Puffer nicht dazu passt -- siehe oben. Die alte
            // bleibt stehen, damit `present` weiter ein gueltiges
            // Rechteck rechnet.
            kstate.set(state, s(S_SW), altw)
            kstate.set(state, s(S_SH), alth)
        }
        return true
    }
    return false
}

// ===================================================================
// DAS AUFSETZEN
// ===================================================================

fn init(state: u64) -> bool {
    kstate.set(state, s(S_READY), 0)
    let i: u64 = find(state)
    if i >= pci.MAX_DEV {
        return false // kein virtio-gpu: der alte Weg bleibt, unveraendert
    }
    let d: u64 = pci.get(state, i, pci.E_BDF)
    kstate.set(state, s(S_IDX), i)
    kstate.set(state, s(S_BDF), d)

    let c_cap: u64 = find_vcap(d, CFG_COMMON)
    let n_cap: u64 = find_vcap(d, CFG_NOTIFY)
    let i_cap: u64 = find_vcap(d, CFG_ISR)
    let v_cap: u64 = find_vcap(d, CFG_DEVICE)
    if c_cap == 0 || n_cap == 0 || v_cap == 0 {
        return false // kein modernes Geraet
    }
    let cbase: u64 = region(state, i, d, c_cap)
    if cbase == 0 {
        return false
    }
    kstate.set(state, s(S_COMMON), cbase)
    kstate.set(state, s(S_NOTIFY), region(state, i, d, n_cap))
    kstate.set(state, s(S_NMULT), pci.cfg_read32(d, n_cap + VC_NOTIFY_MULT))
    kstate.set(state, s(S_ISR), region(state, i, d, i_cap))
    let dcfg: u64 = region(state, i, d, v_cap)
    kstate.set(state, s(S_DEVCFG), dcfg)
    if dcfg == 0 {
        return false
    }

    // Ohne dieses Bit darf das Geraet keinen Deskriptor holen.
    pci.enable_master(d)

    if !reset(state) {
        return false
    }
    status_add(state, ST_ACK)
    status_add(state, ST_DRIVER)
    if !negotiate(state) {
        wr8(cbase, C_STATUS, ST_FAILED)
        return false
    }

    let r: u64 = mem.frame_run(state, RING_BYTES / mem.FRAME_SIZE)
    if r == 0 {
        wr8(cbase, C_STATUS, ST_FAILED)
        return false
    }
    var z: u64 = 0
    while z < RING_BYTES {
        __mmio_write64((r + z) as *mut u64, 0)
        z = z + 8
    }
    kstate.set(state, s(S_RING), r)
    kstate.set(state, s(S_AVAIL), 0)
    kstate.set(state, s(S_USED), 0)

    if !queue_setup(state) {
        wr8(cbase, C_STATUS, ST_FAILED)
        return false
    }
    kstate.set(state, s(S_SCANOUTS), rd32(dcfg, G_NUM_SCANOUTS))

    status_add(state, ST_DRIVER_OK)
    if (status(state) & ST_DRIVER_OK) == 0 {
        return false
    }

    // AB HIER SPRICHT DER TREIBER MIT DEM GERAET. Vorher ging kein
    // Befehl -- die Warteschlange war nicht freigegeben.
    if !display_info(state) {
        return false
    }

    // ============ DIE PRUEFUNG, DIE NICHT FEHLEN DARF
    //
    // Der Puffer, den wir anhaengen, ist der ZWEITPUFFER von `fb.fi`.
    // Seine Zeilenlaenge muss zur Breite der Ressource passen, sonst
    // liest das Geraet die Zeilen versetzt und das Bild steht schief.
    // Das ist der klassische Fehler bei genau diesem Schritt, und er
    // sieht aus wie ein Treppenmuster -- also wird es geprueft und
    // nicht gehofft.
    let back: u64 = fb.back(state)
    if back == 0 {
        return false // ohne Zweitpuffer gibt es nichts anzuhaengen
    }
    let bw: u64 = fb.width(state)
    let bh: u64 = fb.height(state)
    let bp: u64 = fb.pitch(state)
    if bw == 0 || bh == 0 || bp != bw *% 4 {
        return false
    }
    // DIE RESSOURCE BEKOMMT DIE MASSE DES PUFFERS, nicht die des
    // Schirms. Sind sie verschieden, zeigt der Wirt das Bild kleiner
    // oder groesser -- das ist seine Sache und genau das, was
    // freie Skalierung spaeter braucht.
    kstate.set(state, s(S_SW), bw)
    kstate.set(state, s(S_SH), bh)
    let bytes: u64 = bp *% bh
    kstate.set(state, s(S_BACK), back)
    kstate.set(state, s(S_BACKBYTES), bytes)

    if !resource_create(state, bw, bh) {
        return false
    }
    // Der Zweitpuffer liegt im Arbeitsspeicher des Kerns, und der ist
    // eins zu eins abgebildet -- seine Adresse IST seine Adresse auf
    // dem Bus. Waere das nicht so, muesste hier eine Umrechnung stehen.
    if !attach_backing(state, back, bytes) {
        return false
    }
    if !set_scanout(state, bw, bh) {
        return false
    }

    // Das erste Bild ganz hinaustragen: die Ressource ist noch leer,
    // und ein Schmutzrechteck gibt es noch nicht.
    if !transfer(state, 0, 0, bw, bh, 0) {
        return false
    }
    if !resource_flush(state, 0, 0, bw, bh) {
        return false
    }
    kstate.set(state, s(S_READY), 1)
    return true
}

// Das Geraet wieder abgeben. `RESOURCE_UNREF` gibt die Flaeche frei;
// ohne sie behielte der Wirt sie bis zum Ende des Laufs.
fn shut_down(state: u64) {
    if !bereit(state) {
        return
    }
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    kopf(cmd, CMD_RESOURCE_UNREF)
    wr32(cmd, 24, RES_ID)
    wr32(cmd, 28, 0)
    let _ok: bool = befehl(state, 32, RESP_OK_NODATA)
    kstate.set(state, s(S_READY), 0)
}

// ------------------------------------------------------- der Bericht

fn say(state: u64) {
    var s_no: [u8; 22] = "vgpu: kein Geraet\0\0\0\0\0"
    var s_a: [u8; 11] = "vgpu: bdf=\0"
    var s_b: [u8; 10] = "  schirm=\0"
    var s_x: [u8; 2] = "x\0"
    var s_c: [u8; 11] = "  scanout=\0"
    var s_d: [u8; 8] = "  res=\0\0"
    var s_e: [u8; 9] = "  back=\0\0"
    var s_f: [u8; 8] = "  err=\0\0"
    if !bereit(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_a[0]) as u64)
    serial.hex(kstate.get(state, s(S_BDF)))
    serial.puts((&s_b[0]) as u64)
    serial.dec(kstate.get(state, s(S_SW)))
    serial.puts((&s_x[0]) as u64)
    serial.dec(kstate.get(state, s(S_SH)))
    serial.puts((&s_c[0]) as u64)
    serial.dec(kstate.get(state, s(S_SCANOUTS)))
    serial.puts((&s_d[0]) as u64)
    serial.dec(RES_ID)
    serial.puts((&s_e[0]) as u64)
    serial.hex(kstate.get(state, s(S_BACK)))
    serial.puts((&s_f[0]) as u64)
    serial.dec(kstate.get(state, s(S_FEHLER)))
    serial.nl()
}
