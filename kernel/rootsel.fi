// SPDX-License-Identifier: GPL-2.0-only
// kernel/rootsel.fi -- Runde BLECH: WELCHES GERAET TRAEGT DIE WURZEL.
//
// Der Bericht der Runde MERGE-3 sagt es in einem Satz, und der Satz ist
// die halbe Begruendung dieser Datei:
//
//     "Die automatische Treiberwahl beim Start ist nicht gebaut --
//      welches Geraet die Wurzel traegt, entscheidet die Kommandozeile
//      bzw. der Installer."
//
// Nachgelesen im Quelltext, nicht geglaubt: `osum_stage` in `kmain.fi`
// ruft `blk.use_ata(state, kutil.root_blocks(state))` und danach
// `fs.mount`. Schlaegt das fehl, ruft es `root_from_part`, und DAS ruft
// `part.scan(state, blk.DEV_ATA)`. Beide Wege nennen dasselbe Geraet
// beim Namen: DEV_ATA, die Portadresse 0x1F0 von 1986.
//
// Auf einem Rechner mit NVMe-Riegel oder mit einer SATA-Platte an einem
// AHCI-Controller gibt es an 0x1F0 nichts. Der Kern kommt bis
// `osum: no disk` und hoert auf -- obwohl der Treiber, der diese Platte
// lesen koennte, im selben Abbild liegt und im Bericht der Diagnose
// zwei Bildschirmzeilen darueber sogar aufgefuehrt ist. Das ist kein
// fehlender Treiber, das ist eine fehlende ENTSCHEIDUNG.
//
// ------------------------------------------------------ WAS ES TUT
//
// 1. LESEN, NICHT ANFASSEN (`scan`). Die Bustabelle, die `pci.scan`
//    schon gefuellt hat, wird durchgegangen und jedes Geraet der Klasse
//    01 (Massenspeicher) und 0C:03 (USB) eingeordnet. Kein Register
//    wird geschrieben. Heraus kommen zwei Listen:
//      * die BEWERBER, in der Reihenfolge NVMe, AHCI, USB, IDE;
//      * die BEFUNDE -- Controller, fuer die dieser Kern keinen Treiber
//        hat, jeder mit seinen Nummern.
//
// 2. ES SAGEN (`report`). Beide Listen gehen auf die serielle Leitung
//    und damit auch auf den Schirm. Wer eine leere Plattenliste sieht,
//    soll den Grund daneben lesen koennen.
//
// 3. ES TUN (`mount_root`). Die Bewerber werden der Reihe nach
//    PROBIERT: Treiber hochziehen, rohes OFS an Block 0 versuchen,
//    sonst die Partitionstafel lesen und die erste Partition mit
//    unserer Typkennung nehmen. Der erste, dessen Wurzel sich wirklich
//    einhaengen laesst, gewinnt. Ein Bewerber, der nur DA ist, gewinnt
//    nicht -- eine leere NVMe-Platte neben einer IDE-Platte mit dem
//    System darauf muss auf der IDE-Platte landen, und genau diese
//    Lage steht in einem Dutzend bestehender Testlaeufe.
//
// ------------------------------------------------- DER RAID-MODUS
//
// Der haeufigste Fall, in dem ein Notebook mit Osum nicht startet, ist
// KEIN fehlender Treiber: es ist ein SATA-Controller, den die Firmware
// in den RAID-Modus gestellt hat (Intel RST, AMD RAIDXpert -- ab Werk
// eingeschaltet auf sehr vielen Dell- und Lenovo-Geraeten). Ein solcher
// Controller meldet sich als Klasse 01:04 statt 01:06:01. Der
// AHCI-Treiber findet ihn nicht, weil er ihn korrekterweise nicht
// findet, und der Bildschirm bleibt leer.
//
// Diese Datei erkennt genau das und sagt den Satz, der hilft:
//
//     rootsel: 8086:2822 steht im RAID-Modus (Klasse 01:04)
//     rootsel: im BIOS "SATA Mode" von RAID/RST auf AHCI stellen
//
// Eine gute Fehlermeldung ist hier mehr wert als ein halber Treiber:
// ein RST-Treiber muesste die Metadaten des Herstellers verstehen, und
// die sind nicht dokumentiert. Der Umschalter im BIOS ist zwei Klicks.
//
// ------------------------------------------- WAS ES NICHT ENTSCHEIDET
//
// Es waehlt kein Dateisystem (das macht `vfs.fi`), es waehlt keine
// Partition ausser der mit unserer Typkennung, es schreibt nichts, und
// es kehrt die Reihenfolge nicht um, wenn mehrere Platten eine Wurzel
// tragen -- die erste in der Reihenfolge gewinnt, und die Reihenfolge
// steht hier als eine Tabelle und nicht als eine Kette von `if`.

profile kernel

import serial
import kstate
import pci
import blk
import fs
import part
import nvme
import ahci
import usb

export {
    scan, report, mount_root, order_line,
    K_NONE, K_NVME, K_AHCI, K_USB, K_IDE,
    W_RAID, W_SATA_LEGACY, W_SD, W_SAS, W_SCSI, W_OTHER,
    cands, cand_kind, cand_bdf, cand_ven, cand_dev,
    warns, warn_kind, warn_bdf, warn_ven, warn_dev,
    hcs, hc_progif, hc_bdf,
    picked, picked_first, picked_blocks, tried,
    ROOT_OFF, ROOT_MAX
}

// ------------------------------------------------------ der Platz
//
// Eine Seite aus dem Stueck, das `tools/kernel/memmap.py` als frei
// ausweist (0x84380..0x88000, fuenfzehn Kilooktett hinter den Zaehlern
// der Handle-Schicht). Eingetragen ist sie dort unter ROOTSEL.
const ROOT_OFF: u64 = 0x85000
const ROOT_MAX: u64 = 0x1000

const S_SCANNED: u64 = 0x00
const S_NCAND: u64 = 0x08
const S_NWARN: u64 = 0x10
const S_NHC: u64 = 0x18
const S_PICKED: u64 = 0x20
const S_FIRST: u64 = 0x28
const S_BLOCKS: u64 = 0x30
const S_TRIED: u64 = 0x38

// Drei Listen zu je acht Eintraegen mit je vier Woertern. Acht, weil
// `pci.MAX_DEV` zweiunddreissig ist und ein Brett mit acht
// Plattencontrollern ein Server waere, den dieser Kern ohnehin nicht
// bedient -- und weil eine Liste, die ueberlaeuft, dann die letzten
// Eintraege VERSCHWEIGT. Sie tut es nicht still: `report` sagt es.
const MAX_CAND: u64 = 8
const MAX_WARN: u64 = 8
const MAX_HC: u64 = 8
const ENT: u64 = 40

const L_CAND: u64 = 0x100
const L_WARN: u64 = 0x300
const L_HC: u64 = 0x500

const E_KIND: u64 = 0
const E_BDF: u64 = 8
const E_VEN: u64 = 16
const E_DEV: u64 = 24
// Das fuenfte Feld: bei einem Befund die Unterklasse bzw. die
// Schnittstelle, die ihn ausgeloest hat. Es steht HIER und wird nicht
// spaeter aus der Bustabelle nachgeschlagen -- `pci.fi` fuehrt seine
// Funktion `find_bdf` nicht aus, und eine Ausfuhrliste zu erweitern,
// nur um eine Zahl zweimal zu lesen, waere eine Aenderung an einer
// Datei, die diese Runde sonst nicht anfasst.
const E_EXTRA: u64 = 32

// Die Bewerber. Die ZAHLEN sind die Reihenfolge: kleiner zuerst. Das
// ist der ganze Vorrang, und er steht an EINER Stelle.
const K_NONE: u64 = 0
const K_NVME: u64 = 1
const K_AHCI: u64 = 2
const K_USB: u64 = 3
const K_IDE: u64 = 4

// Die Befunde.
const W_RAID: u64 = 1 // Klasse 01:04 -- Intel RST / AMD RAIDXpert
const W_SATA_LEGACY: u64 = 2 // 01:06, aber Schnittstelle nicht AHCI
const W_SD: u64 = 3 // 08:05 -- SD/eMMC-Regler
const W_SAS: u64 = 4 // 01:07
const W_SCSI: u64 = 5 // 01:00
const W_OTHER: u64 = 6 // 01:80 und alles andere in Klasse 01

// PCI-Klassen, die `pci.fi` nicht als Konstante fuehrt.
const SUB_SCSI: u64 = 0x00
const SUB_RAID: u64 = 0x04
const SUB_SAS: u64 = 0x07
const CLASS_SERIAL: u64 = 0x0C
const SUB_USBHC: u64 = 0x03
const CLASS_BASE: u64 = 0x08
const SUB_SD: u64 = 0x05

fn sc(off: u64) -> u64 {
    return ROOT_OFF + off
}

fn ent(list: u64, i: u64, f: u64) -> u64 {
    return ROOT_OFF + list + i * ENT + f
}

// ------------------------------------------------------------ scan

fn add(state: u64, list: u64, cntoff: u64, cap: u64, kind: u64,
    bdf: u64, ven: u64, dev: u64, extra: u64) {
    let n: u64 = kstate.get(state, sc(cntoff))
    if n >= cap {
        // NICHT still. Der Zaehler laeuft weiter, damit `report` sagen
        // kann, wie viele nicht in die Liste gepasst haben.
        kstate.set(state, sc(cntoff), n + 1)
        return
    }
    kstate.set(state, ent(list, n, E_KIND), kind)
    kstate.set(state, ent(list, n, E_BDF), bdf)
    kstate.set(state, ent(list, n, E_VEN), ven)
    kstate.set(state, ent(list, n, E_DEV), dev)
    kstate.set(state, ent(list, n, E_EXTRA), extra)
    kstate.set(state, sc(cntoff), n + 1)
}

// Die Bewerberliste wird SORTIERT gehalten, und zwar beim Einfuegen:
// acht Eintraege, ein Einfuegesortieren, und danach steht die
// Reihenfolge im Speicher und nicht in dem Kopf dessen, der sie liest.
fn add_cand(state: u64, kind: u64, bdf: u64, ven: u64, dev: u64) {
    let n: u64 = kstate.get(state, sc(S_NCAND))
    if n >= MAX_CAND {
        kstate.set(state, sc(S_NCAND), n + 1)
        return
    }
    var i: u64 = n
    while i > 0 {
        if kstate.get(state, ent(L_CAND, i - 1, E_KIND)) <= kind {
            break
        }
        kstate.set(state, ent(L_CAND, i, E_KIND),
            kstate.get(state, ent(L_CAND, i - 1, E_KIND)))
        kstate.set(state, ent(L_CAND, i, E_BDF),
            kstate.get(state, ent(L_CAND, i - 1, E_BDF)))
        kstate.set(state, ent(L_CAND, i, E_VEN),
            kstate.get(state, ent(L_CAND, i - 1, E_VEN)))
        kstate.set(state, ent(L_CAND, i, E_DEV),
            kstate.get(state, ent(L_CAND, i - 1, E_DEV)))
        i = i - 1
    }
    kstate.set(state, ent(L_CAND, i, E_KIND), kind)
    kstate.set(state, ent(L_CAND, i, E_BDF), bdf)
    kstate.set(state, ent(L_CAND, i, E_VEN), ven)
    kstate.set(state, ent(L_CAND, i, E_DEV), dev)
    kstate.set(state, ent(L_CAND, i, E_EXTRA), 0)
    kstate.set(state, sc(S_NCAND), n + 1)
}

// Ein Durchgang durch die Bustabelle. Er schreibt kein Register und
// zieht kein Geraet hoch -- `report` darf deshalb VOR jeder Stufe
// laufen, die etwas anfasst, und tut es auch.
fn scan(state: u64) {
    if kstate.get(state, sc(S_SCANNED)) != 0 {
        return
    }
    kstate.set(state, sc(S_SCANNED), 1)
    kstate.set(state, sc(S_NCAND), 0)
    kstate.set(state, sc(S_NWARN), 0)
    kstate.set(state, sc(S_NHC), 0)
    kstate.set(state, sc(S_PICKED), K_NONE)
    kstate.set(state, sc(S_FIRST), 0)
    kstate.set(state, sc(S_BLOCKS), 0)
    kstate.set(state, sc(S_TRIED), 0)

    let n: u64 = pci.count(state)
    var i: u64 = 0
    while i < n {
        let cls: u64 = pci.get(state, i, pci.E_CLASS)
        let sub: u64 = pci.get(state, i, pci.E_SUBCLASS)
        let pif: u64 = pci.get(state, i, pci.E_PROGIF)
        let bdf: u64 = pci.get(state, i, pci.E_BDF)
        let ven: u64 = pci.get(state, i, pci.E_VENDOR)
        let dev: u64 = pci.get(state, i, pci.E_DEVICE)
        if cls == pci.CLASS_STORAGE {
            if sub == pci.SUB_NVM && pif == pci.PROGIF_NVME {
                add_cand(state, K_NVME, bdf, ven, dev)
            } else if sub == pci.SUB_SATA && pif == pci.PROGIF_AHCI {
                add_cand(state, K_AHCI, bdf, ven, dev)
            } else if sub == pci.SUB_IDE {
                add_cand(state, K_IDE, bdf, ven, dev)
            } else if sub == SUB_RAID {
                add(state, L_WARN, S_NWARN, MAX_WARN, W_RAID, bdf, ven, dev, sub)
            } else if sub == pci.SUB_SATA {
                // Ein SATA-Controller, dessen Schnittstelle NICHT 0x01
                // ist: 0x00 heisst "herstellereigen", 0x02 "Serial
                // Storage Bus". Beides kann dieser Kern nicht.
                add(state, L_WARN, S_NWARN, MAX_WARN, W_SATA_LEGACY,
                    bdf, ven, dev, pif)
            } else if sub == SUB_SAS {
                add(state, L_WARN, S_NWARN, MAX_WARN, W_SAS, bdf, ven, dev, sub)
            } else if sub == SUB_SCSI {
                add(state, L_WARN, S_NWARN, MAX_WARN, W_SCSI, bdf, ven, dev, sub)
            } else {
                add(state, L_WARN, S_NWARN, MAX_WARN, W_OTHER, bdf, ven, dev, sub)
            }
        } else if cls == CLASS_SERIAL && sub == SUB_USBHC {
            add(state, L_HC, S_NHC, MAX_HC, pif, bdf, ven, dev, sub)
        } else if cls == CLASS_BASE && sub == SUB_SD {
            add(state, L_WARN, S_NWARN, MAX_WARN, W_SD, bdf, ven, dev, sub)
        }
        i = i + 1
    }
    // Ein USB-Regler ist ein Bewerber, aber nur EINER: ob ein Stick
    // steckt, weiss erst der Treiber. Die Nummern in der Liste sind die
    // des ersten Reglers, damit der Bericht eine Adresse nennen kann.
    if kstate.get(state, sc(S_NHC)) > 0 {
        add_cand(state, K_USB, kstate.get(state, ent(L_HC, 0, E_BDF)),
            kstate.get(state, ent(L_HC, 0, E_VEN)),
            kstate.get(state, ent(L_HC, 0, E_DEV)))
    }
}

fn cands(state: u64) -> u64 {
    scan(state)
    return kstate.get(state, sc(S_NCAND))
}

fn cand_kind(state: u64, i: u64) -> u64 {
    if i >= MAX_CAND {
        return K_NONE
    }
    return kstate.get(state, ent(L_CAND, i, E_KIND))
}

fn cand_bdf(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_CAND, i, E_BDF))
}

fn cand_ven(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_CAND, i, E_VEN))
}

fn cand_dev(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_CAND, i, E_DEV))
}

fn warns(state: u64) -> u64 {
    scan(state)
    return kstate.get(state, sc(S_NWARN))
}

fn warn_kind(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_WARN, i, E_KIND))
}

fn warn_bdf(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_WARN, i, E_BDF))
}

fn warn_ven(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_WARN, i, E_VEN))
}

fn warn_dev(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_WARN, i, E_DEV))
}

fn hcs(state: u64) -> u64 {
    scan(state)
    return kstate.get(state, sc(S_NHC))
}

fn hc_progif(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_HC, i, E_KIND))
}

fn hc_bdf(state: u64, i: u64) -> u64 {
    return kstate.get(state, ent(L_HC, i, E_BDF))
}

fn picked(state: u64) -> u64 {
    return kstate.get(state, sc(S_PICKED))
}

fn picked_first(state: u64) -> u64 {
    return kstate.get(state, sc(S_FIRST))
}

fn picked_blocks(state: u64) -> u64 {
    return kstate.get(state, sc(S_BLOCKS))
}

fn tried(state: u64) -> u64 {
    return kstate.get(state, sc(S_TRIED))
}

// ---------------------------------------------------------- Ausgabe

fn tag() {
    var s: [u8; 10] = "rootsel: \0"
    serial.puts((&s[0]) as u64)
}

fn kind_name(k: u64) {
    var s_nv: [u8; 5] = "nvme\0"
    var s_ah: [u8; 5] = "ahci\0"
    var s_us: [u8; 4] = "usb\0"
    var s_id: [u8; 4] = "ide\0"
    var s_no: [u8; 6] = "keins\0"
    if k == K_NVME {
        serial.puts((&s_nv[0]) as u64)
        return
    }
    if k == K_AHCI {
        serial.puts((&s_ah[0]) as u64)
        return
    }
    if k == K_USB {
        serial.puts((&s_us[0]) as u64)
        return
    }
    if k == K_IDE {
        serial.puts((&s_id[0]) as u64)
        return
    }
    serial.puts((&s_no[0]) as u64)
}

fn nums(ven: u64, dev: u64) {
    pci.hexn(ven, 4)
    serial.put(58 as u8)
    pci.hexn(dev, 4)
}

// Die Reihenfolge als EINE Zeile, damit ein Foto der seriellen Ausgabe
// reicht, um zu sehen, was der Kern gefunden hat und in welcher Folge er
// es probieren wird.
fn order_line(state: u64) {
    var s_h: [u8; 12] = "reihenfolge\0"
    var s_ar: [u8; 4] = " > \0"
    var s_no: [u8; 44] = "reihenfolge: LEER -- kein Plattencontroller\0"
    scan(state)
    let n: u64 = kstate.get(state, sc(S_NCAND))
    if n == 0 {
        tag()
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    tag()
    serial.puts((&s_h[0]) as u64)
    serial.put(58 as u8)
    serial.put(32 as u8)
    var i: u64 = 0
    var lim: u64 = n
    if lim > MAX_CAND {
        lim = MAX_CAND
    }
    while i < lim {
        if i > 0 {
            serial.puts((&s_ar[0]) as u64)
        }
        kind_name(kstate.get(state, ent(L_CAND, i, E_KIND)))
        i = i + 1
    }
    serial.nl()
}

fn warn_lines(state: u64) {
    var s_raid1: [u8; 29] = " steht im RAID-Modus (01:04)\0"
    var s_raid2: [u8; 62] = "im BIOS \"SATA Mode\" von RAID/RST auf AHCI stellen, dann neu\0\0\0"
    var s_leg: [u8; 45] = " ist SATA, aber nicht AHCI -- Schnittstelle \0"
    var s_sd: [u8; 42] = " ist ein SD/eMMC-Regler -- kein Treiber\0\0\0"
    var s_sas: [u8; 26] = " ist SAS -- kein Treiber\0\0"
    var s_scsi: [u8; 27] = " ist SCSI -- kein Treiber\0\0"
    var s_oth: [u8; 47] = " ist ein Plattencontroller ohne Treiber (01:\0\0\0"
    var s_cl: [u8; 2] = ")\0"
    let n: u64 = kstate.get(state, sc(S_NWARN))
    var i: u64 = 0
    var lim: u64 = n
    if lim > MAX_WARN {
        lim = MAX_WARN
    }
    while i < lim {
        let k: u64 = kstate.get(state, ent(L_WARN, i, E_KIND))
        tag()
        nums(kstate.get(state, ent(L_WARN, i, E_VEN)),
            kstate.get(state, ent(L_WARN, i, E_DEV)))
        if k == W_RAID {
            serial.puts((&s_raid1[0]) as u64)
            serial.nl()
            tag()
            serial.puts((&s_raid2[0]) as u64)
        } else if k == W_SATA_LEGACY {
            serial.puts((&s_leg[0]) as u64)
            pci.hexn(kstate.get(state, ent(L_WARN, i, E_EXTRA)), 2)
        } else if k == W_SD {
            serial.puts((&s_sd[0]) as u64)
        } else if k == W_SAS {
            serial.puts((&s_sas[0]) as u64)
        } else if k == W_SCSI {
            serial.puts((&s_scsi[0]) as u64)
        } else {
            serial.puts((&s_oth[0]) as u64)
            pci.hexn(kstate.get(state, ent(L_WARN, i, E_EXTRA)), 2)
            serial.puts((&s_cl[0]) as u64)
        }
        serial.nl()
        i = i + 1
    }
}

// Die USB-Regler, mit dem Namen ihrer Schnittstelle. Das ist die Zeile,
// aus der hervorgeht, ob ein Rechner ueberhaupt einen Anschluss hat, den
// dieser Kern bedienen kann -- 0x30 ist xHCI (Runde K17), 0x20 ist EHCI
// (Runde BLECH), 0x10 OHCI und 0x00 UHCI, und die letzten beiden kann
// niemand hier.
fn hc_lines(state: u64) {
    var s_x: [u8; 19] = "usb xHCI    bdf=\0\0\0"
    var s_e: [u8; 19] = "usb EHCI    bdf=\0\0\0"
    var s_o: [u8; 19] = "usb OHCI    bdf=\0\0\0"
    var s_u: [u8; 19] = "usb UHCI    bdf=\0\0\0"
    var s_a: [u8; 19] = "usb andere  bdf=\0\0\0"
    var s_nd: [u8; 17] = "  (kein Treiber)\0"
    let n: u64 = kstate.get(state, sc(S_NHC))
    var i: u64 = 0
    var lim: u64 = n
    if lim > MAX_HC {
        lim = MAX_HC
    }
    while i < lim {
        let p: u64 = kstate.get(state, ent(L_HC, i, E_KIND))
        tag()
        if p == 0x30 {
            serial.puts((&s_x[0]) as u64)
        } else if p == 0x20 {
            serial.puts((&s_e[0]) as u64)
        } else if p == 0x10 {
            serial.puts((&s_o[0]) as u64)
        } else if p == 0x00 {
            serial.puts((&s_u[0]) as u64)
        } else {
            serial.puts((&s_a[0]) as u64)
        }
        serial.hex(kstate.get(state, ent(L_HC, i, E_BDF)))
        serial.put(32 as u8)
        nums(kstate.get(state, ent(L_HC, i, E_VEN)),
            kstate.get(state, ent(L_HC, i, E_DEV)))
        if p < 0x20 {
            serial.puts((&s_nd[0]) as u64)
        }
        serial.nl()
        i = i + 1
    }
}

fn report(state: u64) {
    var s_over: [u8; 39] = "mehr Geraete als Plaetze in der Liste\0\0"
    scan(state)
    order_line(state)
    hc_lines(state)
    warn_lines(state)
    if kstate.get(state, sc(S_NCAND)) > MAX_CAND
        || kstate.get(state, sc(S_NWARN)) > MAX_WARN
        || kstate.get(state, sc(S_NHC)) > MAX_HC {
        tag()
        serial.puts((&s_over[0]) as u64)
        serial.nl()
    }
}

// ------------------------------------------------------- mount_root
//
// DIE EINZIGE STELLE, DIE ETWAS ANFASST. Sie laeuft in `kmain.fi` erst,
// wenn der bestehende Weg (ATA an 0x1F0, roh und dann ueber die
// Partitionstafel) NICHT getragen hat. Das ist Absicht und keine
// Vorsicht: jeder der 54 Abnahmeabschnitte haengt heute auf dem alten
// Weg ein, und ein Umbau, der diese Reihenfolge dreht, waere eine
// Aenderung an 54 Messungen statt an einem Startproblem.

const TRY_BLOCKS: u64 = 4096

fn try_mount_on(state: u64, dev: u64, blocks_n: u64) -> bool {
    // Erst roh: eine Platte, die mit `mkfs` unserer Bauart beschrieben
    // wurde, traegt das Dateisystem ab Block 0 und hat gar keine
    // Partitionstafel.
    blk.use_at(state, dev, 0, blocks_n)
    if fs.mount(state) {
        kstate.set(state, sc(S_FIRST), 0)
        kstate.set(state, sc(S_BLOCKS), blocks_n)
        return true
    }
    // Dann die Tafel. `part.find_kind` sucht die erste Partition mit
    // UNSERER Typkennung -- nicht die erste ueberhaupt, sonst landet
    // eine Installation auf der EFI-Partition daneben.
    let n: u64 = part.scan(state, dev)
    if n == 0 {
        return false
    }
    let i: u64 = part.find_kind(state, dev, part.T_OFS)
    if i >= part.MAX_PARTS {
        return false
    }
    let first: u64 = part.start(state, i)
    let cnt: u64 = part.blocks(state, i)
    blk.use_at(state, dev, first, cnt)
    if !fs.mount(state) {
        return false
    }
    kstate.set(state, kstate.ROOT_PART, i)
    kstate.set(state, sc(S_FIRST), first)
    kstate.set(state, sc(S_BLOCKS), cnt)
    return true
}

// Einen Bewerber betriebsbereit machen. Gibt die Geraetenummer aus
// `blk.fi` zurueck oder MAX (0xFF), wenn er nicht hochkommt. Was hier
// NICHT steht, ist genauso wichtig: kein Treiber wird ein zweites Mal
// zurueckgesetzt, wenn `hw.disk` ihn schon aufgebaut hat.
const DEV_BAD: u64 = 0xFF

fn bring_up(state: u64, kind: u64) -> u64 {
    if kind == K_NVME {
        if !nvme.present(state) {
            return DEV_BAD
        }
        // `nvme.fi` fuehrt kein `ready` aus. Die Zahl der Bloecke ist
        // der Beleg: sie steht erst da, wenn IDENTIFY NAMESPACE
        // durchgelaufen ist -- also genau dann, wenn der Controller
        // aufgebaut ist. Null heisst "noch nicht" und heisst nach dem
        // zweiten Versuch "geht nicht".
        if nvme.blocks(state) == 0 {
            if !nvme.init(state, true, true) {
                return DEV_BAD
            }
        }
        if nvme.blocks(state) == 0 {
            return DEV_BAD
        }
        return blk.DEV_NVME
    }
    if kind == K_AHCI {
        if ahci.mode(state) != ahci.MODE_AHCI {
            if !ahci.init(state) {
                return DEV_BAD
            }
        }
        if !ahci.present(state) {
            return DEV_BAD
        }
        return blk.DEV_AHCI
    }
    if kind == K_USB {
        // Der Baum ist zu diesem Zeitpunkt schon aufgezaehlt
        // (`usb_stage` laeuft vor `osum_stage`). Hier wird nur gefragt,
        // ob ein Blockgeraet dabei herausgekommen ist.
        if !usb.msc_ready(state) {
            return DEV_BAD
        }
        return blk.DEV_USB
    }
    if kind == K_IDE {
        if !blk.present(state) {
            return DEV_BAD
        }
        return blk.DEV_ATA
    }
    return DEV_BAD
}

fn blocks_of(state: u64, kind: u64, dev: u64) -> u64 {
    if kind == K_NVME {
        return nvme.blocks(state)
    }
    if kind == K_AHCI {
        return ahci.blocks(state)
    }
    if kind == K_USB {
        return usb.msc_blocks(state)
    }
    let c: u64 = blk.blocks_on(state, dev)
    if c == 0 {
        return TRY_BLOCKS
    }
    return c
}

// Der Reihe nach, und JEDER Versuch steht auf der Leitung. Ein
// Startproblem, das man aus der seriellen Ausgabe nicht ablesen kann,
// ist auf einem fremden Brett nicht zu finden.
// `skip_nvme`/`skip_ahci`: steht `nvme` oder `ahci` auf der
// Kommandozeile, dann gehoert dieser Controller der Stufe `hw.disk`,
// und die FORMATIERT ihn. Eine Wurzel, die diese Datei kurz vorher
// darauf eingehaengt haette, waere zehn Zeilen spaeter ueberschrieben.
// Deshalb wird der Bewerber dann uebersprungen -- und die Zeile sagt
// es, statt ihn stillschweigend auszulassen.
fn mount_root(state: u64, skip_nvme: bool, skip_ahci: bool) -> bool {
    var s_try: [u8; 9] = "versuch \0"
    var s_up: [u8; 16] = " -- kommt nicht\0"
    var s_ok: [u8; 22] = " -- WURZEL, Bloecke=\0\0"
    var s_nx: [u8; 24] = " -- keine Wurzel darauf\0"
    var s_fi: [u8; 10] = "  first=\0\0"
    var s_none: [u8; 45] = "kein Geraet traegt eine Wurzel -- Ende hier\0\0"
    var s_skip: [u8; 35] = " -- uebersprungen, gehoert hw.disk\0"
    scan(state)
    let n: u64 = kstate.get(state, sc(S_NCAND))
    var lim: u64 = n
    if lim > MAX_CAND {
        lim = MAX_CAND
    }
    var i: u64 = 0
    while i < lim {
        let kind: u64 = kstate.get(state, ent(L_CAND, i, E_KIND))
        kstate.set(state, sc(S_TRIED), kstate.get(state, sc(S_TRIED)) + 1)
        // Die Zeile wird HIER geschlossen und nicht erst nach dem
        // Ergebnis: `part.scan` und `nvme.init` drucken selbst, und
        // eine halbe Zeile, in deren Mitte ein anderer Melder schreibt,
        // ist auf einem seriellen Kabel nicht mehr zu lesen. Gemessen:
        // "rootsel: versuch nvmepart: mbr=0  gpt=0  parts=0".
        tag()
        serial.puts((&s_try[0]) as u64)
        kind_name(kind)
        serial.nl()
        var dev: u64 = DEV_BAD
        var gesperrt: bool = false
        if kind == K_NVME && skip_nvme {
            gesperrt = true
        }
        if kind == K_AHCI && skip_ahci {
            gesperrt = true
        }
        if gesperrt {
            tag()
            kind_name(kind)
            serial.puts((&s_skip[0]) as u64)
            serial.nl()
        } else {
            dev = bring_up(state, kind)
        }
        if gesperrt {
            // nichts weiter
        } else if dev == DEV_BAD {
            tag()
            kind_name(kind)
            serial.puts((&s_up[0]) as u64)
            serial.nl()
        } else {
            let cnt: u64 = blocks_of(state, kind, dev)
            if try_mount_on(state, dev, cnt) {
                kstate.set(state, sc(S_PICKED), kind)
                tag()
                kind_name(kind)
                serial.puts((&s_ok[0]) as u64)
                serial.dec(kstate.get(state, sc(S_BLOCKS)))
                serial.puts((&s_fi[0]) as u64)
                serial.dec(kstate.get(state, sc(S_FIRST)))
                serial.nl()
                return true
            }
            tag()
            kind_name(kind)
            serial.puts((&s_nx[0]) as u64)
            serial.nl()
        }
        i = i + 1
    }
    tag()
    serial.puts((&s_none[0]) as u64)
    serial.nl()
    return false
}
