// SPDX-License-Identifier: GPL-2.0-only
// kernel/acpi/aml.fi -- AML ROUND, PART 4: LOADING, `_PRT` AND THE FALLBACK.
//
// ============================================================
// WHY THIS ROUND EXISTS
// ============================================================
//
// Up to here Osum read the interrupt line of a PCI device from register
// 0x3C of its configuration -- "Interrupt Line". That is not a register
// of the device but a NOTE PAD: the firmware enters there which line it
// set up, and nobody forces it to. On most boards the right number is
// in it. On some it is 0, on some 0xFF, and on boards with several PCI
// bridges it holds the line BEFORE the bridge.
//
// The truth is somewhere else: in the AML object `_PRT` of the root
// bridge. For every slot and each of the four pins it says to which line
// of the I/O APIC it is wired -- either as a number or through a LINK
// DEVICE whose `_CRS` names the configured line. Reading it needs an
// interpreter for AML. There was none. Now there is.
//
// ============================================================
// WHAT THIS ROUND DOES NOT BUILD -- so nobody looks for it
// ============================================================
//
// No rebuild of ACPICA. No thermal control. No S4. No S3 (only designed,
// see docs/ROUNDAML.md). No GPE handling at run time. What is here is the
// subset with which `_PRT`, `_CRS`, `_PRS`, `_SRS` and `_STA` can really
// be evaluated -- and every number that comes out is measured and not
// claimed.
//
// ============================================================
// THE FALLBACK PATH IS THE IMPORTANT PART
// ============================================================
//
// An interpreter for FOREIGN code that runs at boot is a new way of
// making a machine not start. Therefore in this file: EVERY error is
// defined, EVERY error is a number, and after EVERY error the old way
// continues -- the interrupt line register. `aml.gsi_or_line` is the
// only place where the drivers fetch their line, and it falls back
// silently. The acceptance run deliberately runs against it (`amlbad`,
// `amlloop`, `amldeep`), and the machine must finish booting every time.

import serial
import lib.kstate
import mm.mem
import bus.pci
import acpi.acpi
import arch.x86_64.apic
import acpi.amlns
import acpi.amlobj
import acpi.amlev
import acpi.amlfail
import acpi.amlskip
import acpi.amlfield
import acpi.amlsys
import sync.atomic

export {
    stage, dump, ready, gsi_for, gsi_or_line, why, route_count,
    node_count, heap_bytes, parse_us, prt_ok,
    // ROUND ACPI-EVENTS: HOLD the namespace instead of discarding it,
    // and evaluate a single node.
    ns_hold, ns_arena, hold_err, hold_bad, eval_node, eval_node_arg, eval_node_args, ns_bytes,
    hold_report, snapshot_boot, fuzz_load, busy_refusals, guard_probe
}

const SNAP_FRAMES: u64 = 256
fn recover_container(state: u64) {
    if load_tolerant != 0 && amlns.err(state) != amlns.ERR_OK
        && hold_tolerable(amlns.err(state)) {
        amlfail.commit(state)
        if h_err == 0 {
            h_err = amlns.err(state)
        }
        h_bad = h_bad + 1
        amlns.err_clear(state)
    }
}

// ------------------------------------------- the slots in `kdata`
//
// `amlns.fi` takes 0..55, `amlev.fi` 56..191. From 192 on this file; the
// route table starts at 512.

const A_TABLES: u64 = 192 // how many tables were really loaded
const A_MS: u64 = 200 // how long loading took, in microseconds
const A_PRTOK: u64 = 208 // 1 = `_PRT` was evaluated
const A_ROUTEN: u64 = 216 // entries in the route table
const A_READY: u64 = 224 // 1 = the namespace stood, even if it is gone
const A_DEVS: u64 = 232 // counted devices
const A_METH: u64 = 240 // counted methods
const A_REGS: u64 = 248 // counted regions
const A_FLDS: u64 = 256 // counted fields
const A_NODESUSED: u64 = 264 // nodes the namespace really had
const A_HEAPUSED: u64 = 272 // heap it really needed
const A_FRAMES0: u64 = 280 // free frames before parsing
const A_FRAMES1: u64 = 288 // free frames after discarding
const A_USPRT: u64 = 480
const A_SPLOAD: u64 = 488 // kernel stack that loading ALONE cost // how long `_PRT` took, in microseconds

// A cache for the link devices. Every board has a handful of them (QEMU:
// five), but `_PRT` names them 128 times. Without this cache `_STA`,
// `_PRS`, `_SRS` and `_CRS` run four hundred times instead of twenty --
// measured 1496 us instead of 249 us and a heap that runs out.
const A_LINKN: u64 = 296
const A_LINK_CACHE: u64 = 304 // 12 * 16 = 192 bytes, up to 496
// (A_USPRT is at 480 -- the cache ends at 496, but only twelve entries
// are possible and QEMU needs five; so that nothing overlaps, it ends
// at 472.)
const LINK_MAX: u64 = 10

// ROUND ACPI-EVENTS: the frame run that `ns_hold` KEEPS.
// 0 = none (then the namespace is gone, as before this round).
const A_HOLD: u64 = 496
const A_HOLDB: u64 = 504 // what it costs, in bytes

const A_ROUTES: u64 = 512
const ROUTE_BYTES: u64 = 16
const ROUTE_MAX: u64 = 128

// How many steps an evaluation may cost at most. QEMU's `_PRT` needs
// about 6000 (128 passes with a good forty terms each); 400000 is plenty
// of air and still a bound that an endless loop reaches in a fraction of
// a second.
const BUDGET: u64 = 400000

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.AML_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.AML_OFF + off, v)
}

fn ready(state: u64) -> bool {
    return g(state, A_READY) != 0
}

fn why(state: u64) -> u64 {
    return amlns.err(state)
}

fn route_count(state: u64) -> u64 {
    return g(state, A_ROUTEN)
}

fn node_count(state: u64) -> u64 {
    return g(state, A_NODESUSED)
}

fn heap_bytes(state: u64) -> u64 {
    return g(state, A_HEAPUSED)
}

fn parse_us(state: u64) -> u64 {
    return g(state, A_MS)
}

fn prt_ok(state: u64) -> bool {
    return g(state, A_PRTOK) != 0
}

// ------------------------------------------------------ the route table
//
// It survives the namespace. That is the whole point: parse, write the
// result into four kilobytes, give the memory back.

fn route_key(bus: u64, dev: u64, pin: u64) -> u64 {
    return (bus << 16) | (dev << 8) | pin
}

fn route_add(state: u64, bus: u64, dev: u64, pin: u64, gsi: u64) {
    let n: u64 = g(state, A_ROUTEN)
    if n >= ROUTE_MAX {
        return
    }
    let at: u64 = kstate.AML_OFF + A_ROUTES + n * ROUTE_BYTES
    kstate.set(state, at, route_key(bus, dev, pin))
    kstate.set(state, at + 8, gsi)
    s(state, A_ROUTEN, n + 1)
}

// The line for slot and pin, or 0xFFFFFFFF.
fn gsi_for(state: u64, bus: u64, dev: u64, pin: u64) -> u64 {
    if g(state, A_PRTOK) == 0 {
        return 0xFFFFFFFF
    }
    let want: u64 = route_key(bus, dev, pin)
    let n: u64 = g(state, A_ROUTEN)
    var i: u64 = 0
    while i < n {
        let at: u64 = kstate.AML_OFF + A_ROUTES + i * ROUTE_BYTES
        if kstate.get(state, at) == want {
            return kstate.get(state, at + 8)
        }
        i = i + 1
    }
    return 0xFFFFFFFF
}

// ============================================================
// THE ONE PLACE WHERE A DRIVER FETCHES ITS LINE
// ============================================================
//
// `idx` is the device's slot in `pci.fi`. First `_PRT`, then the
// interrupt line register. Whoever stands here sees both numbers -- and
// if they differ, the serial line says so.
fn gsi_or_line(state: u64, idx: u64) -> u64 {
    let line: u64 = pci.get(state, idx, pci.E_IRQLINE)
    let bdf: u64 = pci.get(state, idx, pci.E_BDF)
    let pin: u64 = pci.get(state, idx, pci.E_IRQPIN)
    if pin == 0 || pin > 4 {
        return line // the device uses no pin (MSI/MSI-X)
    }
    let from_aml: u64 = gsi_for(state, pci.bdf_bus(bdf), pci.bdf_dev(bdf),
        pin -% 1)
    if from_aml == 0xFFFFFFFF {
        return line
    }
    // THE COUNTER-PROOF FOR THIS WHOLE ROUND. With `amlwrong` the line is
    // entered shifted by one. If the vector still arrives then, the
    // measurement measured nothing -- then it is something else, just not
    // `_PRT`.
    if kstate.mode_on(state, kstate.M_AMLWRONG) {
        return (from_aml + 1) % 24
    }
    return from_aml
}

// ============================================================
// PART 1: THE DECLARATIONS OF A TABLE INTO THE TREE
// ============================================================
//
// On this level there are ONLY declarative opcodes -- Scope, Device,
// Method, Name, OperationRegion, Field and their relatives. A method
// body is NOT read but skipped: it only becomes interesting when someone
// calls it, and a body that nobody calls may well contain opcodes this
// interpreter does not know.

fn load_createfield(state: u64, scope: u64, p: u64, c: u64) -> u64 {
    var out: [u64; 1] = [0 as u64; 1]
    var q: u64 = p + 1
    if c == 0x5B {
        q = p + 2
    }
    let f: u64 = amlev.frame_new(state)
    if f == 0 {
        return 0
    }
    amlev.frame_scope_set(f, scope)
    var a: [u64; 3] = [0 as u64; 3]
    var terms: u64 = 2
    if c == 0x5B {
        terms = 3
    }
    while terms > 0 {
        q = amlev.ev(state, f, q, (&a[0]) as u64)
        if q == 0 {
            return 0
        }
        terms = terms - 1
    }
    let node: u64 = amlns.walk_create(state, scope, q, (&out[0]) as u64,
        amlns.NK_NAME, amlns.NMAX)
    if node != amlns.NONE {
        amlns.set_kind(state, node, amlns.NK_NAME)
        amlns.set_flags(state, node, NF_FIELD_NAME)
        amlns.set_a(state, node, out[0])
        amlns.set_b(state, node, 0)
    }
    return out[0]
}

fn seg4(w: u64) -> u64 {
    return w
}

// Returns the position behind the declaration, or 0 on an error.
//
// THIS FUNCTION IS DELIBERATELY SMALL. It is the only one that reaches
// itself again (through `load_list`), so its frame lies on the kernel
// stack once more for every nesting level of the DSDT. Everything that
// needs temporary slots is in `load_leaf` -- and that is no cosmetics:
// with all branches in ONE function, loading QEMU's DSDT cost a measured
// 26592 bytes of kernel stack, with the split only a fraction of that
// (see docs/ROUNDAML.md).
const REGION_DEFERRED: u64 = 0x7FFFFFFFFFFFFFFF

const NF_FIELD_NAME: u64 = 0x80

fn region_arg_deferred(state: u64, scope: u64, p: u64) -> bool {
    if !amlskip.is_name_lead(amlns.rd8(p)) {
        return false
    }
    var out: [u64; 1] = [0 as u64; 1]
    let n: u64 = amlns.walk(state, scope, p, (&out[0]) as u64)
    if n == amlns.NONE {
        return true
    }
    let k: u64 = amlns.node_kind(state, n)
    if k == amlns.NK_FIELD || k == amlns.NK_BUFFIELD {
        return true
    }
    return k == amlns.NK_NAME && (amlns.node_flags(state, n) & NF_FIELD_NAME) != 0
}

fn region_operand_tolerable(e: u64) -> bool {
    return e == amlns.ERR_OPCODE || e == amlns.ERR_TYPE || e == amlns.ERR_NOTFOUND
        || e == amlns.ERR_ARG || e == amlns.ERR_DEPTH || e == amlns.ERR_TRUNC
        || e == amlns.ERR_REGION || e == amlns.ERR_DIV0
}

fn region_operand(state: u64, f: u64, scope: u64, q: u64, out: u64) -> u64 {
    if region_arg_deferred(state, scope, q) {
        amlfail.defer_add()
        amlns.wr64(out, REGION_DEFERRED)
        return amlskip.term(state, scope, q)
    }
    var a: [u64; 3] = [0 as u64; 3]
    let nq: u64 = amlev.ev(state, f, q, (&a[0]) as u64)
    if nq != 0 {
        amlev.deref(state, (&a[0]) as u64)
        if amlns.err(state) == amlns.ERR_OK {
            amlns.wr64(out, amlobj.to_int((&a[0]) as u64))
            return nq
        }
    }
    if !region_operand_tolerable(amlns.err(state)) {
        return 0
    }
    let sk: u64 = amlskip.term(state, scope, q)
    if sk == 0 {
        return 0
    }
    amlns.err_clear(state)
    amlfail.fallback_add()
    amlns.wr64(out, REGION_DEFERRED)
    return sk
}

fn load_term(state: u64, scope: u64, p: u64, end: u64) -> u64 {
    let c: u64 = amlns.rd8(p)
    if c == 0x10 {
        return load_scope(state, scope, p, end)
    }
    if c == 0x5B {
        let e2: u64 = amlns.rd8(p + 1)
        if e2 == 0x82 || e2 == 0x83 || e2 == 0x84 || e2 == 0x85 {
            return load_container(state, scope, p, end, e2)
        }
    }
    return load_leaf(state, scope, p, end)
}

fn load_scope(state: u64, scope: u64, p: u64, end: u64) -> u64 {
    amlev.seen_mark(state, 0x10)
    var out: [u64; 1] = [0 as u64; 1]
    let ln: u64 = amlns.pkglen(p + 1, (&out[0]) as u64)
    let e: u64 = p + 1 + ln
    if e > end {
        amlns.err_set(state, amlns.ERR_TRUNC)
        return 0
    }
    let node: u64 = amlns.walk_create(state, scope, out[0],
        (&out[0]) as u64, amlns.NK_SCOPE, amlns.NMAX)
    if node == amlns.NONE {
        return 0
    }
    load_list(state, node, out[0], e)
    recover_container(state)
    return e
}

fn load_container(state: u64, scope: u64, p: u64, end: u64, e2: u64) -> u64 {
    amlev.seen_ext_mark(state, e2)
    var out: [u64; 1] = [0 as u64; 1]
    let ln: u64 = amlns.pkglen(p + 2, (&out[0]) as u64)
    let e: u64 = p + 2 + ln
    if e > end {
        amlns.err_set(state, amlns.ERR_TRUNC)
        return 0
    }
    var kind: u64 = amlns.NK_DEVICE
    if e2 == 0x83 {
        kind = amlns.NK_PROC
    }
    if e2 == 0x84 {
        kind = amlns.NK_POWER
    }
    if e2 == 0x85 {
        kind = amlns.NK_TZ
    }
    let node: u64 = amlns.walk_create(state, scope, out[0],
        (&out[0]) as u64, kind, amlns.NMAX)
    if node == amlns.NONE {
        return 0
    }
    amlns.set_kind(state, node, kind)
    if e2 == 0x82 {
        s(state, A_DEVS, g(state, A_DEVS) + 1)
    }
    var body: u64 = out[0]
    if e2 == 0x83 {
        body = body + 6 // ProcID, PblkAddr, PblkLen
    }
    if e2 == 0x84 {
        body = body + 3 // SystemLevel, ResourceOrder
    }
    load_list(state, node, body, e)
    recover_container(state)
    return e
}

// Everything that has NO body of its own with further declarations.
fn load_leaf(state: u64, scope: u64, p: u64, end: u64) -> u64 {
    let c: u64 = amlns.rd8(p)
    var out: [u64; 1] = [0 as u64; 1]

    if c == 0x14 { // Method -- the body is only noted
        amlev.seen_mark(state, c)
        let ln: u64 = amlns.pkglen(p + 1, (&out[0]) as u64)
        let e: u64 = p + 1 + ln
        if e > end {
            amlns.err_set(state, amlns.ERR_TRUNC)
            return 0
        }
        let node: u64 = amlns.walk_create(state, scope, out[0],
            (&out[0]) as u64, amlns.NK_METHOD, amlns.NMAX)
        if node == amlns.NONE {
            return 0
        }
        let flags: u64 = amlns.rd8(out[0])
        amlns.set_kind(state, node, amlns.NK_METHOD)
        amlns.set_flags(state, node, flags & 7)
        amlns.set_a(state, node, out[0] + 1)
        amlns.set_b(state, node, e)
        s(state, A_METH, g(state, A_METH) + 1)
        return e
    }
    if c == 0x08 { // Name -- the value is only computed when it is read
        amlev.seen_mark(state, c)
        let node: u64 = amlns.walk_create(state, scope, p + 1,
            (&out[0]) as u64, amlns.NK_NAME, amlns.NMAX)
        if node == amlns.NONE {
            return 0
        }
        amlns.set_kind(state, node, amlns.NK_NAME)
        amlns.set_a(state, node, out[0])
        amlns.set_b(state, node, 0)
        return skip_data(state, out[0], end)
    }
    if c == 0x06 { // Alias
        amlev.seen_mark(state, c)
        let src: u64 = amlns.walk(state, scope, p + 1, (&out[0]) as u64)
        let node: u64 = amlns.walk_create(state, scope, out[0],
            (&out[0]) as u64, amlns.NK_ALIAS, amlns.NMAX)
        if node != amlns.NONE {
            amlns.set_a(state, node, src)
        }
        return out[0]
    }
    if c == 0x15 { // External -- an announcement, not an object
        let node: u64 = amlns.walk(state, scope, p + 1, (&out[0]) as u64)
        return out[0] + 2
    }
    if c == 0xA0 || c == 0xA1 || c == 0xA2 {
        let ln: u64 = amlns.pkglen(p + 1, (&out[0]) as u64)
        let e: u64 = p + 1 + ln
        if e > end {
            amlns.err_set(state, amlns.ERR_TRUNC)
            return 0
        }
        return e
    }
    if c == 0x8A || c == 0x8B || c == 0x8C || c == 0x8D || c == 0x8F {
        return load_createfield(state, scope, p, c)
    }
    if c == 0x5B {
        let e2: u64 = amlns.rd8(p + 1)
        amlev.seen_ext_mark(state, e2)
        if e2 == 0x13 {
            return load_createfield(state, scope, p, c)
        }
        if e2 == 0x88 {
            var dq: u64 = amlskip.skip_name(p + 2)
            var dk: u64 = 0
            while dk < 3 && dq != 0 {
                dq = skip_data(state, dq, end)
                dk = dk + 1
            }
            return dq
        }
        if e2 == 0x80 { // OperationRegion
            let node: u64 = amlns.walk_create(state, scope, p + 2,
                (&out[0]) as u64, amlns.NK_REGION, amlns.NMAX)
            if node == amlns.NONE {
                return 0
            }
            let space: u64 = amlns.rd8(out[0])
            var q: u64 = out[0] + 1
            let f: u64 = amlev.frame_new(state)
            if f == 0 {
                return 0
            }
            amlev.frame_scope_set(f, scope)
            var av: [u64; 1] = [0 as u64; 1]
            var bv: [u64; 1] = [0 as u64; 1]
            q = region_operand(state, f, scope, q, (&av[0]) as u64)
            if q == 0 {
                return 0
            }
            q = region_operand(state, f, scope, q, (&bv[0]) as u64)
            if q == 0 {
                return 0
            }
            if bv[0] == REGION_DEFERRED {
                av[0] = REGION_DEFERRED
                bv[0] = 0
            }
            amlns.set_kind(state, node, amlns.NK_REGION)
            amlns.set_a(state, node, av[0])
            amlns.set_b(state, node, bv[0])
            amlns.set_c(state, node, space)
            s(state, A_REGS, g(state, A_REGS) + 1)
            return q
        }
        if e2 == 0x81 { // Field
            let ln: u64 = amlns.pkglen(p + 2, (&out[0]) as u64)
            let e: u64 = p + 2 + ln
            if e > end {
                amlns.err_set(state, amlns.ERR_TRUNC)
                return 0
            }
            let region: u64 = amlns.walk(state, scope, out[0],
                (&out[0]) as u64)
            if region == amlns.NONE {
                amlns.err_set(state, amlns.ERR_NOTFOUND)
                return e
            }
            let flags: u64 = amlns.rd8(out[0])
            s(state, A_FLDS, g(state, A_FLDS) + amlfield.create(state, scope, region, flags, out[0] + 1, e))
            return e
        }
        if e2 == 0x86 || e2 == 0x87 { // IndexField, BankField
            // Nothing is created: a field that goes over another field cannot be
            // read by this interpreter, and a node that delivers wrong numbers when
            // read is worse than none. The area is skipped.
            let ln: u64 = amlns.pkglen(p + 2, (&out[0]) as u64)
            return p + 2 + ln
        }
        if e2 == 0x01 || e2 == 0x02 { // Mutex, Event
            var kind: u64 = amlns.NK_MUTEX
            if e2 == 0x02 {
                kind = amlns.NK_EVENT
            }
            let node: u64 = amlns.walk_create(state, scope, p + 2,
                (&out[0]) as u64, kind, amlns.NMAX)
            if node != amlns.NONE {
                amlns.set_kind(state, node, kind)
            }
            var q: u64 = out[0]
            if e2 == 0x01 {
                q = q + 1
            }
            return q
        }
        amlns.err_set(state, amlns.ERR_OPCODE)
        return 0
    }
    amlns.err_set(state, amlns.ERR_OPCODE)
    return 0
}

// Skip a data object behind a `Name` without evaluating it. Only the
// forms that may occur as a name value.
fn skip_data(state: u64, p: u64, end: u64) -> u64 {
    let c: u64 = amlns.rd8(p)
    if c == 0x00 || c == 0x01 || c == 0xFF {
        return p + 1
    }
    if c == 0x0A {
        return p + 2
    }
    if c == 0x0B {
        return p + 3
    }
    if c == 0x0C {
        return p + 5
    }
    if c == 0x0E {
        return p + 9
    }
    if c == 0x0D {
        var n: u64 = 0
        while p + 1 + n < end && amlns.rd8(p + 1 + n) != 0 {
            n = n + 1
        }
        return p + 2 + n
    }
    if c == 0x11 || c == 0x12 || c == 0x13 {
        var out: [u64; 1] = [0 as u64; 1]
        let ln: u64 = amlns.pkglen(p + 1, (&out[0]) as u64)
        return p + 1 + ln
    }
    if c == 0x5B && amlns.rd8(p + 1) == 0x30 { // Revision
        return p + 2
    }
    if amlskip.is_name_lead(c) {
        return amlskip.skip_name(p)
    }
    amlns.err_set(state, amlns.ERR_OPCODE)
    return 0
}

fn load_list(state: u64, scope: u64, p: u64, end: u64) {
    var i: u64 = p
    while i < end {
        if amlns.err(state) != amlns.ERR_OK {
            return
        }
        let q: u64 = load_term(state, scope, i, end)
        if amlns.err(state) != amlns.ERR_OK {
            amlfail.mark(i, scope)
            return
        }
        if q == 0 || q <= i {
            amlfail.mark(i, scope)
            if q <= i && amlns.err(state) == amlns.ERR_OK {
                amlns.err_set(state, amlns.ERR_TRUNC)
            }
            return
        }
        i = q
    }
}

// ============================================================
// PART 2: EVALUATING `_PRT`
// ============================================================

// The bus number of a root node: `_BBN`, otherwise 0.
fn bbn_of(state: u64, node: u64) -> u64 {
    var w: [u8; 5] = "_BBN\0"
    let seg: u64 = amlns.seg_of((&w[0]) as u64)
    let n: u64 = amlns.child(state, node, seg)
    if n == amlns.NONE {
        return 0
    }
    var v: [u64; 1] = [0 as u64; 1]
    if amlobj.const_int(amlns.node_a(state, n), (&v[0]) as u64) == 0 {
        return 0
    }
    return v[0]
}

// Call a method without arguments (or read a name).
fn call0(state: u64, node: u64, dst: u64) -> bool {
    if node == amlns.NONE {
        return false
    }
    if amlns.node_kind(state, node) == amlns.NK_METHOD {
        var none: [u64; 3] = [0 as u64; 3]
        amlev.call_method(state, node, 0, (&none[0]) as u64, dst)
        return amlns.err(state) == amlns.ERR_OK
    }
    let f: u64 = amlev.frame_new(state)
    if f == 0 {
        return false
    }
    amlev.frame_scope_set(f, amlns.node_parent(state, node))
    var o: [u64; 3] = [0 as u64; 3]
    amlobj.oset(dst, amlobj.OT_REF_NODE, node, 0)
    amlev.deref(state, dst)
    return amlns.err(state) == amlns.ERR_OK
}

fn link_cached(state: u64, link: u64) -> u64 {
    let n: u64 = g(state, A_LINKN)
    var i: u64 = 0
    while i < n {
        if kstate.get(state, kstate.AML_OFF + A_LINK_CACHE + i * 16) == link + 1 {
            return kstate.get(state, kstate.AML_OFF + A_LINK_CACHE + i * 16 + 8)
        }
        i = i + 1
    }
    return 0xFFFFFFFE
}

fn link_cache(state: u64, link: u64, gsi: u64) {
    let n: u64 = g(state, A_LINKN)
    if n >= LINK_MAX {
        return
    }
    kstate.set(state, kstate.AML_OFF + A_LINK_CACHE + n * 16, link + 1)
    kstate.set(state, kstate.AML_OFF + A_LINK_CACHE + n * 16 + 8, gsi)
    s(state, A_LINKN, n + 1)
}

// The line that a link device has currently configured.
// 0xFFFFFFFF if it cannot be determined.
fn link_gsi(state: u64, link: u64) -> u64 {
    let seen: u64 = link_cached(state, link)
    if seen != 0xFFFFFFFE {
        return seen
    }
    let r: u64 = link_gsi_slow(state, link)
    link_cache(state, link, r)
    return r
}

fn link_gsi_slow(state: u64, link: u64) -> u64 {
    var w_sta: [u8; 5] = "_STA\0"
    var w_crs: [u8; 5] = "_CRS\0"
    var w_prs: [u8; 5] = "_PRS\0"
    var w_srs: [u8; 5] = "_SRS\0"
    var res: [u64; 3] = [0 as u64; 3]

    // 1. Is the device available at all, and is it switched on?
    //    Bit 0 = present, bit 1 = enabled.
    let sta: u64 = amlns.child(state, link, amlns.seg_of((&w_sta[0]) as u64))
    var enabled: u64 = 1
    if sta != amlns.NONE {
        if call0(state, sta, (&res[0]) as u64) {
            let v: u64 = amlobj.to_int((&res[0]) as u64)
            if (v & 1) == 0 {
                return 0xFFFFFFFF // not present at all
            }
            if (v & 2) == 0 {
                enabled = 0
            }
        }
    }

    // 2. If it is not switched on, it is switched on: set the first
    //    possibility from `_PRS` through `_SRS`. THAT is the case the link
    //    devices exist for in the first place, and without it a line on a
    //    real board stays dead.
    if enabled == 0 {
        let prs: u64 = amlns.child(state, link,
            amlns.seg_of((&w_prs[0]) as u64))
        let srs: u64 = amlns.child(state, link,
            amlns.seg_of((&w_srs[0]) as u64))
        if prs != amlns.NONE && srs != amlns.NONE {
            if call0(state, prs, (&res[0]) as u64) {
                if amlobj.otype((&res[0]) as u64) == amlobj.OT_BUF {
                    let at: u64 = amlobj.ov1((&res[0]) as u64)
                    let ln: u64 = amlobj.ov2((&res[0]) as u64)
                    let want: u64 = amlobj.res_first_irq(state, at, ln)
                    if want != 0xFFFFFFFF {
                        // `_SRS` gets a buffer in the form of `_PRS` in which exactly ONE line
                        // is stated. The simplest correct way: take the `_PRS` buffer and
                        // restrict the choice in it to the first possibility.
                        srs_set(state, srs, (&res[0]) as u64, want)
                    }
                }
            }
        }
    }

    // 3. What is in `_CRS` now?
    let crs: u64 = amlns.child(state, link, amlns.seg_of((&w_crs[0]) as u64))
    if crs == amlns.NONE {
        return 0xFFFFFFFF
    }
    if !call0(state, crs, (&res[0]) as u64) {
        return 0xFFFFFFFF
    }
    if amlobj.otype((&res[0]) as u64) != amlobj.OT_BUF {
        return 0xFFFFFFFF
    }
    let gsi: u64 = amlobj.res_first_irq(state,
        amlobj.ov1((&res[0]) as u64), amlobj.ov2((&res[0]) as u64))
    return gsi
}

// Call `_SRS` with a buffer that names exactly one line.
fn srs_set(state: u64, srs: u64, prsbuf: u64, want: u64) {
    let at: u64 = amlobj.ov1(prsbuf)
    let ln: u64 = amlobj.ov2(prsbuf)
    let o: u64 = amlobj.obj_buf(state, ln)
    if o == 0 {
        return
    }
    let dst: u64 = amlobj.ov1(o)
    var i: u64 = 0
    while i < ln {
        amlns.wr8(dst + i, amlns.rd8(at + i))
        i = i + 1
    }
    // Restrict the choice: in the short form the bit mask to the one line,
    // in the long form the number of entries to one and the first number to
    // `want`.
    var j: u64 = 0
    while j < ln {
        let tag: u64 = amlns.rd8(dst + j)
        if tag == 0x79 {
            break
        }
        if (tag & 0x80) == 0 {
            let l: u64 = tag & 7
            if ((tag >> 3) & 0xF) == 4 && want < 16 {
                amlns.wr8(dst + j + 1, (1 << want) & 0xFF)
                amlns.wr8(dst + j + 2, ((1 << want) >> 8) & 0xFF)
            }
            j = j + 1 + l
        } else {
            let l: u64 = amlns.rd16(dst + j + 1)
            if (tag & 0x7F) == 0x09 {
                amlns.wr8(dst + j + 4, 1)
                amlns.wr8(dst + j + 5, want & 0xFF)
                amlns.wr8(dst + j + 6, (want >> 8) & 0xFF)
                amlns.wr8(dst + j + 7, (want >> 16) & 0xFF)
                amlns.wr8(dst + j + 8, (want >> 24) & 0xFF)
            }
            j = j + 3 + l
        }
    }
    var arg: [u64; 3] = [0 as u64; 3]
    amlobj.ocopy((&arg[0]) as u64, o)
    var res: [u64; 3] = [0 as u64; 3]
    amlev.call_method(state, srs, 1, (&arg[0]) as u64, (&res[0]) as u64)
}

// Go through all `_PRT` in the tree and fill the route table.
fn eval_prt(state: u64, loud: bool) {
    var w_prt: [u8; 5] = "_PRT\0"
    let seg: u64 = amlns.seg_of((&w_prt[0]) as u64)
    let n: u64 = amlns.nodes(state)
    var i: u64 = 1
    var found: u64 = 0
    while i < n {
        if amlns.node_name(state, i) == seg {
            found = found + 1
            eval_one_prt(state, i, loud)
        }
        i = i + 1
    }
    if found == 0 {
        amlns.err_set(state, amlns.ERR_NOPRT)
        return
    }
    if g(state, A_ROUTEN) != 0 {
        s(state, A_PRTOK, 1)
    }
}

fn eval_one_prt(state: u64, node: u64, loud: bool) {
    var s_l: [u8; 12] = "aml: prt b=\0"
    var s_d: [u8; 4] = " d=\0"
    var s_p: [u8; 4] = " p=\0"
    var s_g: [u8; 6] = " gsi=\0"
    var s_s: [u8; 6] = " src=\0"
    let bus: u64 = bbn_of(state, amlns.node_parent(state, node))
    var res: [u64; 3] = [0 as u64; 3]
    if !call0(state, node, (&res[0]) as u64) {
        return
    }
    if amlobj.otype((&res[0]) as u64) != amlobj.OT_PKG {
        amlns.err_set(state, amlns.ERR_TYPE)
        return
    }
    let cnt: u64 = amlobj.ov2((&res[0]) as u64)
    var k: u64 = 0
    while k < cnt {
        let e: u64 = amlobj.pkg_at((&res[0]) as u64, k)
        if amlobj.otype(e) == amlobj.OT_PKG && amlobj.ov2(e) >= 4 {
            var a0: [u64; 3] = [0 as u64; 3]
            var a1: [u64; 3] = [0 as u64; 3]
            var a3: [u64; 3] = [0 as u64; 3]
            amlobj.ocopy((&a0[0]) as u64, amlobj.pkg_at(e, 0))
            amlev.deref(state, (&a0[0]) as u64)
            amlobj.ocopy((&a1[0]) as u64, amlobj.pkg_at(e, 1))
            amlev.deref(state, (&a1[0]) as u64)
            amlobj.ocopy((&a3[0]) as u64, amlobj.pkg_at(e, 3))
            amlev.deref(state, (&a3[0]) as u64)
            let adr: u64 = amlobj.to_int((&a0[0]) as u64)
            let dev: u64 = (adr >> 16) & 0x1F
            let pin: u64 = amlobj.to_int((&a1[0]) as u64)
            let src: u64 = amlobj.pkg_at(e, 2)
            var gsi: u64 = 0xFFFFFFFF
            var linknode: u64 = amlns.NONE
            if amlobj.otype(src) == amlobj.OT_REF_NODE {
                linknode = amlobj.ov1(src)
                gsi = link_gsi(state, linknode)
            } else {
                // No link device: the line is stated directly in the fourth element.
                // That is how it looks on every board whose firmware hard-wires the APIC
                // case.
                gsi = amlobj.to_int((&a3[0]) as u64)
            }
            if gsi != 0xFFFFFFFF && pin < 4 {
                route_add(state, bus, dev, pin, gsi)
                if loud {
                    serial.puts((&s_l[0]) as u64)
                    serial.dec(bus)
                    serial.puts((&s_d[0]) as u64)
                    serial.dec(dev)
                    serial.puts((&s_p[0]) as u64)
                    serial.dec(pin)
                    serial.puts((&s_g[0]) as u64)
                    serial.dec(gsi)
                    if linknode != amlns.NONE {
                        serial.puts((&s_s[0]) as u64)
                        amlns.name_print(amlns.node_name(state, linknode))
                    }
                    serial.nl()
                }
            }
        }
        k = k + 1
    }
}

// ============================================================
// PART 3: THE STAGE
// ============================================================

fn arena_get(state: u64) -> u64 {
    let run: u64 = mem.frame_run(state, amlns.ARENA_FRAMES)
    if run == 0 {
        amlns.err_set(state, amlns.ERR_NOMEM)
        return 0
    }
    amlns.root_reset(state, run, amlns.NMAX,
        run + amlns.ARENA_FRAMES * 4096)
    amlsys.install(state)
    amlev.budget_set(state, BUDGET)
    return run
}

fn arena_put(state: u64, run: u64) {
    if run != 0 {
        mem.frame_free_run(state, run, amlns.ARENA_FRAMES)
    }
}

// A broken copy of the DSDT: the counter-proof `amlbad`. It lies on the
// heap so that the REAL table stays untouched -- `batt.fi` and `power.fi`
// still read it afterwards.
fn broken_copy(state: u64, t: u64) -> u64 {
    let len: u64 = amlns.rd32(t + 4)
    var half: u64 = len / 2
    if half < 40 {
        half = len
    }
    let o: u64 = amlobj.obj_buf(state, half)
    if o == 0 {
        return 0
    }
    let at: u64 = amlobj.ov1(o)
    var i: u64 = 0
    while i < half {
        amlns.wr8(at + i, amlns.rd8(t + i))
        i = i + 1
    }
    // The length in the header keeps lying -- exactly what a truncated table
    // on a broken board does too.
    return at
}

static mut h_err: u64 = 0
static mut h_bad: u64 = 0
static mut load_tolerant: u64 = 0

const HOLD_MIN_NODES: u64 = 16

fn hold_tolerable(e: u64) -> bool {
    return e == amlns.ERR_NODES || e == amlns.ERR_HEAP || e == amlns.ERR_TRUNC
        || e == amlns.ERR_OPCODE || e == amlns.ERR_TYPE || e == amlns.ERR_NOTFOUND
        || e == amlns.ERR_ARG || e == amlns.ERR_DEPTH
}

fn hold_report(state: u64) {
    var s_head: [u8; 12] = "amlhold: e=\0"
    var s_bad: [u8; 6] = " bad=\0"
    var s_nodes: [u8; 8] = " nodes=\0"
    var s_defer: [u8; 8] = " defer=\0"
    var s_skip: [u8; 7] = " skip=\0"
    serial.puts((&s_head[0]) as u64)
    serial.dec(h_err)
    serial.puts((&s_bad[0]) as u64)
    serial.dec(h_bad)
    serial.puts((&s_nodes[0]) as u64)
    serial.dec(amlns.nodes(state))
    serial.puts((&s_defer[0]) as u64)
    serial.dec(amlfail.defer_count())
    serial.puts((&s_skip[0]) as u64)
    serial.dec(amlfail.fallback_count())
    serial.nl()
    amlfail.report_serial()
}

fn hold_err() -> u64 {
    return h_err
}

fn hold_bad() -> u64 {
    return h_bad
}

fn load_all(state: u64, loud: bool) {
    var w_dsdt: [u8; 5] = "DSDT\0"
    var w_ssdt: [u8; 5] = "SSDT\0"
    let n: u64 = acpi.table_count(state)
    var i: u64 = 0
    var done: u64 = 0
    while i < n {
        let t: u64 = acpi.table_at(state, i)
        if t != 0 {
            let sig: u64 = amlns.seg_of(t)
            if sig == amlns.seg_of((&w_dsdt[0]) as u64)
                || sig == amlns.seg_of((&w_ssdt[0]) as u64) {
                var start: u64 = t
                var len: u64 = amlns.rd32(t + 4)
                amlfail.begin(t, sig, len)
                if kstate.mode_on(state, kstate.M_AMLBAD)
                    && sig == amlns.seg_of((&w_dsdt[0]) as u64) {
                    let cp: u64 = broken_copy(state, t)
                    if cp != 0 {
                        start = cp
                        // the length stays the OLD one -- the parser runs into bytes that no
                        // longer exist
                    }
                }
                if len > 36 {
                    load_list(state, 0, start + 36, start + len)
                }
                done = done + 1
                if amlns.err(state) != amlns.ERR_OK {
                    if load_tolerant != 0 && hold_tolerable(amlns.err(state)) {
                        amlfail.commit(state)
                        if h_err == 0 {
                            h_err = amlns.err(state)
                        }
                        h_bad = h_bad + 1
                        amlns.err_clear(state)
                    } else {
                        i = n
                    }
                }
            }
        }
        i = i + 1
    }
    s(state, A_TABLES, done)
    if done == 0 {
        amlns.err_set(state, amlns.ERR_NODSDT)
    }
}

// The two counter-proofs for which there is nothing in any real DSDT: a
// method with a loop that does not end, and one that calls itself. Both
// are WRITTEN OUT here as AML bytes -- that is more honest than an SSDT
// from outside, because then the acceptance run states which bytes are
// meant.
fn selftest_loop(state: u64) {
    var s_t: [u8; 16] = "aml: loop err=\0\0"
    // Method(TSTL, 0) { While(One) { } }
    var code: [u8; 9] = [0 as u8; 9]
    code[0] = 0x14 as u8
    code[1] = 0x09 as u8
    code[2] = 84 as u8 // 'T'
    code[3] = 83 as u8 // 'S'
    code[4] = 84 as u8 // 'T'
    code[5] = 76 as u8 // 'L'
    code[6] = 0x00 as u8
    code[7] = 0xA2 as u8
    code[8] = 0x00 as u8
    // The PkgLength of the loop and its condition follow --
    // 0xA2 0x02 0x01 would be three bytes; they no longer fit into a field of
    // nine, so the body is built right next to it.
    var body: [u8; 3] = [0 as u8; 3]
    body[0] = 0xA2 as u8
    body[1] = 0x02 as u8
    body[2] = 0x01 as u8
    let p: u64 = (&code[0]) as u64
    let node: u64 = amlns.add(state, 0,
        amlns.seg_of((&code[2]) as u64), amlns.NK_METHOD, amlns.NMAX)
    if node == amlns.NONE {
        return
    }
    amlns.set_flags(state, node, 0)
    amlns.set_a(state, node, (&body[0]) as u64)
    amlns.set_b(state, node, (&body[0]) as u64 + 3)
    amlev.budget_set(state, 20000)
    var res: [u64; 3] = [0 as u64; 3]
    var none: [u64; 3] = [0 as u64; 3]
    amlev.call_method(state, node, 0, (&none[0]) as u64, (&res[0]) as u64)
    serial.puts((&s_t[0]) as u64)
    serial.dec(amlns.err(state))
    serial.nl()
}

fn selftest_deep(state: u64) {
    var s_t: [u8; 16] = "aml: deep err=\0\0"
    // Method(TSTR, 0) { TSTR() } -- the body is its own name.
    var nm: [u8; 5] = "TSTR\0"
    let node: u64 = amlns.add(state, 0, amlns.seg_of((&nm[0]) as u64),
        amlns.NK_METHOD, amlns.NMAX)
    if node == amlns.NONE {
        return
    }
    amlns.set_flags(state, node, 0)
    amlns.set_a(state, node, (&nm[0]) as u64)
    amlns.set_b(state, node, (&nm[0]) as u64 + 4)
    amlev.budget_set(state, 200000)
    var res: [u64; 3] = [0 as u64; 3]
    var none: [u64; 3] = [0 as u64; 3]
    amlev.call_method(state, node, 0, (&none[0]) as u64, (&res[0]) as u64)
    serial.puts((&s_t[0]) as u64)
    serial.dec(amlns.err(state))
    serial.nl()
}

fn report(state: u64) {
    var s1: [u8; 14] = "aml: tables=\0\0"
    var s2: [u8; 8] = " nodes=\0"
    var s3: [u8; 7] = " heap=\0"
    var s4: [u8; 5] = " us=\0"
    var s5: [u8; 6] = " err=\0"
    var s6: [u8; 12] = "aml: devs=\0\0"
    var s7: [u8; 10] = " methods=\0"
    var s8: [u8; 10] = " regions=\0"
    var s9: [u8; 9] = " fields=\0"
    var sa: [u8; 14] = "aml: routes=\0\0"
    var sb: [u8; 8] = " prtok=\0"
    var sc: [u8; 9] = " prtus=\0\0"
    var sd: [u8; 9] = " stack=\0\0"
    var se: [u8; 8] = " tiefe=\0"
    var sf: [u8; 10] = " ladest=\0\0"
    serial.puts((&s1[0]) as u64)
    serial.dec(g(state, A_TABLES))
    serial.puts((&s2[0]) as u64)
    serial.dec(g(state, A_NODESUSED))
    serial.puts((&s3[0]) as u64)
    serial.dec(g(state, A_HEAPUSED))
    serial.puts((&s4[0]) as u64)
    serial.dec(g(state, A_MS))
    serial.puts((&s5[0]) as u64)
    serial.dec(amlns.err(state))
    serial.nl()
    serial.puts((&s6[0]) as u64)
    serial.dec(g(state, A_DEVS))
    serial.puts((&s7[0]) as u64)
    serial.dec(g(state, A_METH))
    serial.puts((&s8[0]) as u64)
    serial.dec(g(state, A_REGS))
    serial.puts((&s9[0]) as u64)
    serial.dec(g(state, A_FLDS))
    serial.nl()
    serial.puts((&sa[0]) as u64)
    serial.dec(g(state, A_ROUTEN))
    serial.puts((&sb[0]) as u64)
    serial.dec(g(state, A_PRTOK))
    serial.puts((&sc[0]) as u64)
    serial.dec(g(state, A_USPRT))
    serial.puts((&sd[0]) as u64)
    serial.dec(amlev.stack_high(state))
    serial.puts((&se[0]) as u64)
    serial.dec(amlev.depth_high(state))
    serial.puts((&sf[0]) as u64)
    serial.dec(g(state, A_SPLOAD))
    serial.nl()
}

// Which opcodes the interpreter really touched while reading this
// machine. `tools/aml/run.sh` holds that against the histogram of
// `tools/aml/disasm.py` -- that is the coverage, and it is measured and
// not estimated.
fn report_ops(state: u64) {
    var s_o: [u8; 9] = "aml: op \0"
    var s_e: [u8; 12] = "aml: extop \0"
    var i: u64 = 0
    while i < 256 {
        if amlev.seen_get(state, i) {
            serial.puts((&s_o[0]) as u64)
            serial.hex_width(i, 2)
            serial.nl()
        }
        i = i + 1
    }
    i = 0
    while i < 144 {
        if amlev.seen_ext(state, i) {
            serial.puts((&s_e[0]) as u64)
            serial.hex_width(i, 2)
            serial.nl()
        }
        i = i + 1
    }
}

// ============================================================
// WHAT THIS INTERPRETER CAN DO -- the list against which it is measured
// ============================================================
//
// `tools/aml/run.sh` holds it against the opcode histogram that
// `tools/aml/disasm.py` draws INDEPENDENTLY from the same DSDT. That
// gives the coverage: how many of the opcodes that really occur on this
// machine this interpreter understands.
//
// The test runner ALSO checks that every opcode the interpreter REALLY
// TOUCHED during the run (the `aml: op` lines) is in this list too. A
// list that deviates from reality is thereby noticed instead of
// flattering the coverage.
fn report_can(state: u64) {
    var s_c: [u8; 10] = "aml: can \0"
    var s_e: [u8; 13] = "aml: canext \0"
    var s_p: [u8; 14] = "aml: canpair \0"
    // The simple opcodes. 0x60..0x67 are Local0..7, 0x68..0x6E Arg0..6.
    var ops: [u8; 69] = [0 as u8; 69]
    ops[0] = 0x00 as u8
    ops[1] = 0x01 as u8
    ops[2] = 0x06 as u8
    ops[3] = 0x08 as u8
    ops[4] = 0x0A as u8
    ops[5] = 0x0B as u8
    ops[6] = 0x0C as u8
    ops[7] = 0x0D as u8
    ops[8] = 0x0E as u8
    ops[9] = 0x10 as u8
    ops[10] = 0x11 as u8
    ops[11] = 0x12 as u8
    ops[12] = 0x13 as u8
    ops[13] = 0x14 as u8
    ops[14] = 0x15 as u8
    ops[15] = 0x70 as u8
    ops[16] = 0x71 as u8
    ops[17] = 0x72 as u8
    ops[18] = 0x74 as u8
    ops[19] = 0x75 as u8
    ops[20] = 0x76 as u8
    ops[21] = 0x77 as u8
    ops[22] = 0x78 as u8
    ops[23] = 0x79 as u8
    ops[24] = 0x7A as u8
    ops[25] = 0x7B as u8
    ops[26] = 0x7C as u8
    ops[27] = 0x7D as u8
    ops[28] = 0x7E as u8
    ops[29] = 0x7F as u8
    ops[30] = 0x80 as u8
    ops[31] = 0x81 as u8
    ops[32] = 0x82 as u8
    ops[33] = 0x83 as u8
    ops[34] = 0x85 as u8
    ops[35] = 0x86 as u8
    ops[36] = 0x87 as u8
    ops[37] = 0x88 as u8
    ops[38] = 0x8A as u8
    ops[39] = 0x8B as u8
    ops[40] = 0x8C as u8
    ops[41] = 0x8D as u8
    ops[42] = 0x8E as u8
    ops[43] = 0x8F as u8
    ops[44] = 0x90 as u8
    ops[45] = 0x91 as u8
    ops[46] = 0x92 as u8
    ops[47] = 0x93 as u8
    ops[48] = 0x94 as u8
    ops[49] = 0x95 as u8
    ops[50] = 0x96 as u8
    ops[51] = 0x97 as u8
    ops[52] = 0x98 as u8
    ops[53] = 0x99 as u8
    ops[54] = 0x9D as u8
    ops[55] = 0x9F as u8
    ops[56] = 0xA0 as u8
    ops[57] = 0xA1 as u8
    ops[58] = 0xA2 as u8
    ops[59] = 0xA3 as u8
    ops[60] = 0xA4 as u8
    ops[61] = 0xA5 as u8
    ops[62] = 0xCC as u8
    ops[63] = 0xFF as u8
    var i: u64 = 0
    while i < 64 {
        serial.puts((&s_c[0]) as u64)
        serial.hex_width(ops[i as usize] as u64, 2)
        serial.nl()
        i = i + 1
    }
    // Local0..7 and Arg0..6 individually, so that the list is complete.
    i = 0x60
    while i <= 0x6E {
        serial.puts((&s_c[0]) as u64)
        serial.hex_width(i, 2)
        serial.nl()
        i = i + 1
    }
    var ext: [u8; 20] = [0 as u8; 20]
    ext[0] = 0x01 as u8
    ext[1] = 0x02 as u8
    ext[2] = 0x12 as u8
    ext[3] = 0x13 as u8
    ext[4] = 0x21 as u8
    ext[5] = 0x22 as u8
    ext[6] = 0x23 as u8
    ext[7] = 0x24 as u8
    ext[8] = 0x26 as u8
    ext[9] = 0x27 as u8
    ext[10] = 0x30 as u8
    ext[11] = 0x31 as u8
    ext[12] = 0x33 as u8
    ext[13] = 0x80 as u8
    ext[14] = 0x81 as u8
    ext[15] = 0x82 as u8
    ext[16] = 0x83 as u8
    ext[17] = 0x84 as u8
    ext[18] = 0x85 as u8
    i = 0
    while i < 19 {
        serial.puts((&s_e[0]) as u64)
        serial.hex_width(ext[i as usize] as u64, 2)
        serial.nl()
        i = i + 1
    }
    // The three compound comparisons. In AML they appear as TWO opcodes in a
    // row (0x92 followed by 0x93, 0x94 or 0x95) -- `LNotEqual`,
    // `LLessEqual`, `LGreaterEqual`. They are language forms of their own and
    // are therefore reported separately.
    i = 0x93
    while i <= 0x95 {
        serial.puts((&s_p[0]) as u64)
        serial.hex_width(i, 2)
        serial.nl()
        i = i + 1
    }
}

// The whole namespace, one name per line. Only with `amlprt`, because on
// QEMU that is 350 lines -- and because exactly this list is what
// `tools/aml/run.sh` holds against the independent version in Python.
fn report_ns(state: u64) {
    var s_n: [u8; 9] = "aml: ns \0"
    var s_k: [u8; 3] = " \0\0"
    let n: u64 = amlns.nodes(state)
    // FROM ZERO: the root `\` is a node like any other, and the independent
    // version in Python lists it too. Whoever leaves it out here has to
    // subtract the difference by hand later -- and exactly such corrections
    // are what a real difference can hide behind.
    var i: u64 = 0
    while i < n {
        serial.puts((&s_n[0]) as u64)
        amlns.path_out(state, i)
        serial.puts((&s_k[0]) as u64)
        serial.dec(amlns.node_kind(state, i))
        serial.nl()
        i = i + 1
    }
}

// The comparison this round is about: what does `_PRT` say, and what
// does the register say that was believed until today?
fn report_devices(state: u64) {
    var s_d: [u8; 11] = "aml: gsi \0\0"
    var s_a: [u8; 6] = " aml=\0"
    var s_l: [u8; 7] = " line=\0"
    var s_p: [u8; 6] = " pin=\0"
    let n: u64 = pci.count(state)
    var i: u64 = 0
    while i < n {
        let bdf: u64 = pci.get(state, i, pci.E_BDF)
        let pin: u64 = pci.get(state, i, pci.E_IRQPIN)
        if pin != 0 && pin <= 4 {
            serial.puts((&s_d[0]) as u64)
            pci.hexn(pci.bdf_bus(bdf), 2)
            serial.put(58 as u8)
            pci.hexn(pci.bdf_dev(bdf), 2)
            serial.put(46 as u8)
            pci.hexn(pci.bdf_fn(bdf), 1)
            serial.puts((&s_p[0]) as u64)
            serial.dec(pin)
            serial.puts((&s_a[0]) as u64)
            let a: u64 = gsi_for(state, pci.bdf_bus(bdf), pci.bdf_dev(bdf),
                pin -% 1)
            if a == 0xFFFFFFFF {
                serial.dec(999)
            } else {
                serial.dec(a)
            }
            serial.puts((&s_l[0]) as u64)
            serial.dec(pci.get(state, i, pci.E_IRQLINE))
            serial.nl()
        }
        i = i + 1
    }
}

// ==================================================================
// ROUND ACPI-EVENTS: HOLDING THE NAMESPACE
// ==================================================================
//
// `stage` builds the namespace, evaluates `_PRT` and THROWS IT AWAY --
// keeping the 1 MiB arena for a route table of four kilobytes would be a leak
// with an announcement, and `_PRT` never needs it again.
//
// The events do need it, and constantly: `_LID` and `_BST` are METHODS
// that run again on every lid movement and every battery event. Without
// a namespace there is no `_LID`.
//
// THE DECISION, and it is a trade-off and not a matter of course: the
// namespace is ONLY HELD IF THERE IS SOMETHING TO HOLD. `ns_hold` builds
// it, `acpiev.stage` checks whether there is a lid, a battery, a button
// or a GPE method -- and if not, `ns_drop` gives everything back. A
// server without lid and without battery thereby pays not a single byte,
// a laptop gets full events. Both are measured (`tools/acpiev/run.sh`,
// section "what the namespace costs").
//
// The second build costs what the first one cost -- 1358 us on QEMU.
// That is once at boot and not on every event; keeping it from `stage`
// instead would be faster but would mean that `stage` makes the decision
// before anybody knows whether there are event devices.

fn ns_arena(state: u64) -> u64 {
    return g(state, A_HOLD)
}

fn ns_bytes(state: u64) -> u64 {
    return g(state, A_HOLDB)
}

// Build the namespace a second time and HOLD it. Returns the frame run,
// or 0.
fn ns_hold(state: u64) -> u64 {
    if g(state, A_HOLD) != 0 {
        return g(state, A_HOLD)
    }
    if kstate.mode_on(state, kstate.M_NOAML) {
        return 0
    }
    amlev.stack_base(state)
    let run: u64 = arena_get(state)
    if run == 0 {
        return 0
    }
    h_err = 0
    h_bad = 0
    amlfail.clear()
    load_tolerant = 1
    load_all(state, false)
    load_tolerant = 0
    if kstate.mode_on(state, kstate.M_AML) {
        hold_report(state)
    }
    if amlns.err(state) != amlns.ERR_OK || amlns.nodes(state) < HOLD_MIN_NODES {
        arena_put(state, run)
        return 0
    }
    s(state, A_HOLD, run)
    s(state, A_HOLDB, amlns.ARENA_FRAMES * 4096)
    return run
}

// Give it back after all. `acpiev.stage` calls this when there is
// nothing to handle on this machine.
fn ns_drop(state: u64) {
    let run: u64 = g(state, A_HOLD)
    if run == 0 {
        return
    }
    arena_put(state, run)
    s(state, A_HOLD, 0)
    s(state, A_HOLDB, 0)
}

// EVALUATE A NODE. For `_LID`, `_BST`, `_BIF`, `_PSR` and the GPE
// methods: if it is a method, it is called without arguments; if it is a
// `Name`, its value is taken.
//
// This is `call0` with a public name and one difference: the step budget
// is reset BEFORE EVERY CALL. Without it the budget would be used up
// after a few hundred lid movements and `_LID` would silently return
// nothing any more.
static mut in_use: u64 = 0
static mut refusals: u64 = 0

fn busy_refusals() -> u64 {
    return refusals
}

fn acquire() -> bool {
    if atomic.cas((&in_use) as u64, 0, 1) != 0 {
        refusals = refusals + 1
        return false
    }
    return true
}

fn release() {
    atomic.store((&in_use) as u64, 0)
}

fn guard_probe() -> bool {
    let before: u64 = refusals
    if !acquire() {
        return false
    }
    let second: bool = acquire()
    release()
    let third: bool = acquire()
    release()
    return !second && third && refusals == before + 1
}

fn eval_node(state: u64, node: u64, dst: u64) -> bool {
    if node == amlns.NONE || node == 0 {
        return false
    }
    if g(state, A_HOLD) == 0 || !acquire() {
        return false
    }
    amlev.budget_set(state, BUDGET)
    amlev.depth_reset(state)
    amlev.stack_base(state)
    amlns.err_set(state, amlns.ERR_OK)
    let ok: bool = call0(state, node, dst)
    release()
    return ok
}

fn eval_node_arg(state: u64, node: u64, arg: u64, dst: u64) -> bool {
    if node == amlns.NONE || node == 0 {
        return false
    }
    if g(state, A_HOLD) == 0 || !acquire() {
        return false
    }
    if amlns.node_kind(state, node) != amlns.NK_METHOD {
        release()
        return false
    }
    amlev.budget_set(state, BUDGET)
    amlev.depth_reset(state)
    amlev.stack_base(state)
    amlns.err_set(state, amlns.ERR_OK)
    amlev.call_method(state, node, 1, arg, dst)
    let ok: bool = amlns.err(state) == amlns.ERR_OK
    release()
    return ok
}

// W-TOUCH4: a method with several arguments (argc objects of OBJ_BYTES at argsrc), e.g. _DSM(uuid, rev, func, pkg).
fn eval_node_args(state: u64, node: u64, argc: u64, argsrc: u64, dst: u64) -> bool {
    if node == amlns.NONE || node == 0 {
        return false
    }
    if g(state, A_HOLD) == 0 || !acquire() {
        return false
    }
    if amlns.node_kind(state, node) != amlns.NK_METHOD {
        release()
        return false
    }
    amlev.budget_set(state, BUDGET)
    amlev.depth_reset(state)
    amlev.stack_base(state)
    amlns.err_set(state, amlns.ERR_OK)
    amlev.call_method(state, node, argc, argsrc, dst)
    let ok: bool = amlns.err(state) == amlns.ERR_OK
    release()
    return ok
}

fn evaluate_methods(state: u64, limit: u64) {
    let n: u64 = amlns.nodes(state)
    var done: u64 = 0
    var i: u64 = 1
    amlobj.set_read_only(true)
    while i < n && done < limit {
        if amlns.node_kind(state, i) == amlns.NK_METHOD && (amlns.node_flags(state, i) & 7) == 0 {
            var r: [u64; 3] = [0 as u64; 3]
            amlev.budget_set(state, BUDGET)
            amlev.depth_reset(state)
            amlev.stack_base(state)
            amlns.err_clear(state)
            let _ok: bool = call0(state, i, (&r[0]) as u64)
            done = done + 1
        }
        i = i + 1
    }
    amlobj.set_read_only(false)
}

fn fuzz_load(state: u64, start: u64, len: u64, evals: u64) -> u64 {
    var saved: [u64; 7] = [0 as u64; 7]
    amlns.save(state, (&saved[0]) as u64)
    let tolerant: u64 = load_tolerant
    load_tolerant = 1
    var result: u64 = amlns.ERR_NOMEM
    let run: u64 = arena_get(state)
    if run != 0 {
        amlev.stack_base(state)
        amlns.err_clear(state)
        if len > 36 {
            load_list(state, 0, start + 36, start + len)
        }
        result = amlns.err(state)
        amlns.err_clear(state)
        evaluate_methods(state, evals)
        amlns.err_clear(state)
        arena_put(state, run)
    }
    load_tolerant = tolerant
    amlns.restore(state, (&saved[0]) as u64)
    return result
}

fn snapshot_boot(state: u64) {
    if acpi.snap_count() != 0 {
        return
    }
    let snap: u64 = mem.frame_run(state, SNAP_FRAMES)
    if snap != 0 {
        acpi.snapshot(state, snap, SNAP_FRAMES * 4096)
    }
}

fn stage(state: u64) {
    var s_off: [u8; 16] = "aml: abgestellt\0"
    var s_leak: [u8; 20] = "aml: frames vorher=\0"
    var s_leak2: [u8; 10] = " nachher=\0"
    snapshot_boot(state)
    if kstate.mode_on(state, kstate.M_AMLDUMP) {
        dump(state)
    }
    if kstate.mode_on(state, kstate.M_NOAML) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    amlev.stack_base(state)
    let free0: u64 = mem.frames_free(state)
    s(state, A_FRAMES0, free0)
    let run: u64 = arena_get(state)
    if run == 0 {
        report(state)
        return
    }
    let t0: u64 = apic.tsc()
    load_all(state, false)
    let t1: u64 = apic.tsc()
    s(state, A_SPLOAD, amlev.stack_high(state))
    amlev.stack_clear(state)
    s(state, A_NODESUSED, amlns.nodes(state))
    if amlns.err(state) == amlns.ERR_OK {
        if kstate.mode_on(state, kstate.M_AMLPRT) {
            report_ns(state)
        }
        eval_prt(state, kstate.mode_on(state, kstate.M_AMLPRT))
    }
    let t2: u64 = apic.tsc()
    let hz: u64 = apic.tsc_hz(state)
    if hz > 1000000 {
        s(state, A_MS, (t1 -% t0) / (hz / 1000000))
        s(state, A_USPRT, (t2 -% t1) / (hz / 1000000))
    }
    s(state, A_HEAPUSED, amlns.heap_high(state))
    s(state, A_READY, 1)
    report(state)
    if kstate.mode_on(state, kstate.M_AML) {
        report_devices(state)
        report_ops(state)
        report_can(state)
    }
    if kstate.mode_on(state, kstate.M_AMLLOOP) {
        selftest_loop(state)
    }
    if kstate.mode_on(state, kstate.M_AMLDEEP) {
        selftest_deep(state)
    }
    // THE NAMESPACE IS DISCARDED. Everything that is still needed afterwards
    // is in the route table in `kdata` -- four kilobytes instead of the whole
    // arena, and for good.
    arena_put(state, run)
    let free1: u64 = mem.frames_free(state)
    s(state, A_FRAMES1, free1)
    if kstate.mode_on(state, kstate.M_AMLLEAK) {
        serial.puts((&s_leak[0]) as u64)
        serial.dec(free0)
        serial.puts((&s_leak2[0]) as u64)
        serial.dec(free1)
        serial.nl()
    }
}

// ============================================================
// THE TABLES ONTO THE LINE (for `tools/aml/disasm.py`)
// ============================================================

fn nibble(v: u64) -> u8 {
    if v < 10 {
        return (48 + v) as u8
    }
    return (87 + v) as u8
}

fn hex8(v: u64) {
    serial.put(nibble((v >> 4) & 0xF))
    serial.put(nibble(v & 0xF))
}

fn dump_one(p: u64, len: u64) {
    var s_hex: [u8; 9] = "amlhex \0\0"
    var i: u64 = 0
    while i < len {
        serial.puts((&s_hex[0]) as u64)
        var j: u64 = 0
        while j < 32 && i + j < len {
            hex8(amlns.rd8(p + i + j))
            j = j + 1
        }
        serial.nl()
        i = i + 32
    }
}

fn dump(state: u64) {
    var s_n: [u8; 13] = "amldump: n=\0\0"
    var s_t: [u8; 9] = "amltab \0\0"
    var s_sig: [u8; 7] = " sig=\0\0"
    var s_len: [u8; 7] = " len=\0\0"
    var s_end: [u8; 13] = "amldump: end\0"
    let n: u64 = acpi.table_count(state)
    serial.puts((&s_n[0]) as u64)
    serial.dec(n)
    serial.nl()
    var i: u64 = 0
    while i < n {
        let t: u64 = acpi.table_at(state, i)
        if t != 0 {
            let len: u64 = amlns.rd32(t + 4)
            serial.puts((&s_t[0]) as u64)
            serial.dec(i)
            serial.puts((&s_sig[0]) as u64)
            serial.put(amlns.rd8(t) as u8)
            serial.put(amlns.rd8(t + 1) as u8)
            serial.put(amlns.rd8(t + 2) as u8)
            serial.put(amlns.rd8(t + 3) as u8)
            serial.puts((&s_len[0]) as u64)
            serial.dec(len)
            serial.nl()
            dump_one(t, len)
        }
        i = i + 1
    }
    serial.puts((&s_end[0]) as u64)
    serial.nl()
}
