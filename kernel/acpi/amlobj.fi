// SPDX-License-Identifier: GPL-2.0-only
// kernel/acpi/amlobj.fi -- AML ROUND, PART 2: OBJECTS AND ADDRESS SPACES.
//
// AML knows five kinds of values -- integer, string, buffer, package and
// reference -- and the language has no type declarations: what an
// expression yields is decided while it is evaluated. In a language
// without sum types (Firn, profile `kernel`) a value is therefore ONE
// SLOT OF 24 BYTES:
//
//   +0   the kind (OT_*)
//   +8   v1 -- integer: the value; buffer/string: the address;
//        package: the address of the elements; reference: the target
//   +16  v2 -- length or element count
//
// All slots live in the arena (`amlns.heap_alloc`). They are NOT freed
// one by one; the whole run is given back at once.
//
// THE SECOND PART OF THIS FILE IS THE DANGEROUS ONE. An
// OperationRegion is a window into real memory, real ports or PCI
// configuration space, and a field inside it is a bit slice. A wrong
// calculation here writes into a register that was not meant. Therefore:
//
//   * SystemMemory is read and written ONLY when the address lies in the
//     range the kernel has identity-mapped. The HPET region of a QEMU
//     DSDT sits at 0xFED00000 and thereby falls out -- the result is a
//     defined error and no page fault.
//   * SystemIO goes byte by byte through `serial.in8`/`out8`, with
//     DWordAcc through the same two lines of assembler that `pci.fi` has
//     used since round K2. There is no WordAcc -- half a word on a port
//     is not the same as two bytes, and what cannot be measured is not
//     claimed here.
//   * PCI_Config takes the number from the next `_ADR` above the region
//     and the bus number from the next `_BBN` (without one: bus 0). That
//     is how `\_SB.PRQ0` in QEMU's DSDT finds the PIIX3 register 0x60 in
//     00:01.0.

import lib.kstate
import serial
import mm.mem
import bus.pci
import acpi.amlns
import acpi.ecio

export {
    OT_NONE, OT_INT, OT_STR, OT_BUF, OT_PKG, OT_REF_SLOT, OT_REF_NODE,
    OT_REF_BYTE, OT_DEBUG, OBJ_BYTES,
    otype, ov1, ov2, oset, oint, ocopy, obuf, opkg, pkg_at,
    obj_new, obj_int, obj_buf, obj_pkg,
    const_int, truth, to_int,
    field_read, field_write, field_read_wide, field_write_wide, field_bits, NARROW_BITS, region_check,
    RS_MEM, RS_IO, RS_PCI, RS_EC,
    res_first_irq, res_irq_count, res_irq_at, set_read_only, blocked_writes
}

const OBJ_BYTES: u64 = 24

const OT_NONE: u64 = 0
const OT_INT: u64 = 1
const OT_STR: u64 = 2
const OT_BUF: u64 = 3
const OT_PKG: u64 = 4
const OT_REF_SLOT: u64 = 5 // v1 = address of an object slot
const OT_REF_NODE: u64 = 6 // v1 = node index
const OT_REF_BYTE: u64 = 7 // v1 = address of a byte in a buffer
const OT_DEBUG: u64 = 8

const RS_MEM: u64 = 0
const RS_IO: u64 = 1
const RS_PCI: u64 = 2
const RS_EC: u64 = 3

// ------------------------------------------------------- an object slot

fn otype(o: u64) -> u64 {
    return amlns.rd64(o)
}

fn ov1(o: u64) -> u64 {
    return amlns.rd64(o + 8)
}

fn ov2(o: u64) -> u64 {
    return amlns.rd64(o + 16)
}

fn oset(o: u64, t: u64, a: u64, b: u64) {
    amlns.wr64(o, t)
    amlns.wr64(o + 8, a)
    amlns.wr64(o + 16, b)
}

fn oint(o: u64, v: u64) {
    oset(o, OT_INT, v, 0)
}

fn obuf(o: u64, at: u64, len: u64) {
    oset(o, OT_BUF, at, len)
}

fn opkg(o: u64, at: u64, n: u64) {
    oset(o, OT_PKG, at, n)
}

fn ocopy(dst: u64, src: u64) {
    amlns.wr64(dst, amlns.rd64(src))
    amlns.wr64(dst + 8, amlns.rd64(src + 8))
    amlns.wr64(dst + 16, amlns.rd64(src + 16))
}

// The i-th element of a package.
fn pkg_at(o: u64, i: u64) -> u64 {
    return ov1(o) + i * OBJ_BYTES
}

fn obj_new(state: u64) -> u64 {
    return amlns.heap_alloc(state, OBJ_BYTES)
}

fn obj_int(state: u64, v: u64) -> u64 {
    let o: u64 = obj_new(state)
    if o != 0 {
        oint(o, v)
    }
    return o
}

fn obj_buf(state: u64, len: u64) -> u64 {
    let o: u64 = obj_new(state)
    if o == 0 {
        return 0
    }
    var at: u64 = 0
    if len != 0 {
        at = amlns.heap_alloc(state, len)
        if at == 0 {
            return 0
        }
    }
    obuf(o, at, len)
    return o
}

fn obj_pkg(state: u64, n: u64) -> u64 {
    let o: u64 = obj_new(state)
    if o == 0 {
        return 0
    }
    var at: u64 = 0
    if n != 0 {
        at = amlns.heap_alloc(state, n * OBJ_BYTES)
        if at == 0 {
            return 0
        }
    }
    opkg(o, at, n)
    return o
}

// -------------------------------------------------------- truth and number

// What AML regards as "true": everything except zero.
fn truth(o: u64) -> bool {
    if otype(o) == OT_INT {
        return ov1(o) != 0
    }
    if otype(o) == OT_BUF || otype(o) == OT_STR {
        return ov2(o) != 0
    }
    return false
}

// An integer from an object. A buffer is read as a number (least
// significant byte first, at most eight) -- the specification wants that
// for `ToInteger`, and every interpreter reads a buffer that way in a
// number context.
fn to_int(o: u64) -> u64 {
    let t: u64 = otype(o)
    if t == OT_INT {
        return ov1(o)
    }
    if t == OT_BUF {
        var v: u64 = 0
        var i: u64 = 0
        let n: u64 = ov2(o)
        while i < 8 && i < n {
            v = v | (amlns.rd8(ov1(o) + i) << (i * 8))
            i = i + 1
        }
        return v
    }
    return 0
}

// -------------------------------------------- a constant without context
//
// `_ADR` and `_BBN` are constant numbers on every machine. Reading them
// does not need the evaluator -- and it MUST NOT use it here, otherwise
// the address space depends on the evaluator and the evaluator on the
// address space. Returns 1 if a constant really was there.
fn const_int(p: u64, out: u64) -> u64 {
    let op: u64 = amlns.rd8(p)
    if op == 0x00 {
        amlns.wr64(out, 0)
        return 1
    }
    if op == 0x01 {
        amlns.wr64(out, 1)
        return 1
    }
    if op == 0xFF {
        amlns.wr64(out, 0xFFFFFFFFFFFFFFFF)
        return 1
    }
    if op == 0x0A {
        amlns.wr64(out, amlns.rd8(p + 1))
        return 1
    }
    if op == 0x0B {
        amlns.wr64(out, amlns.rd16(p + 1))
        return 1
    }
    if op == 0x0C {
        amlns.wr64(out, amlns.rd32(p + 1))
        return 1
    }
    if op == 0x0E {
        amlns.wr64(out, amlns.rd64(p + 1))
        return 1
    }
    amlns.wr64(out, 0)
    return 0
}

// ---------------------------------------------------------- ports, 32 bit
//
// The same two lines as in `pci.fi` since round K2. A port is the only
// place where a language does not help.

fn in32(port: u16) -> u64 {
    return asm("in eax, dx", out("rax"), in("dx") port) & 0xFFFFFFFF
}

fn out32(port: u16, value: u64) {
    asm("out dx, eax", in("dx") port, in("eax")(value & 0xFFFFFFFF) as u32)
}

// ------------------------------------------------------- the bus number
//
// The PCI number of a region: from the region's node upwards until a
// device has an `_ADR`. `_ADR` is device << 16 | function.
fn adr_of(state: u64, node: u64) -> u64 {
    var w_adr: [u8; 5] = "_ADR\0"
    var w_bbn: [u8; 5] = "_BBN\0"
    let adr: u64 = amlns.seg_of((&w_adr[0]) as u64)
    let bbn: u64 = amlns.seg_of((&w_bbn[0]) as u64)
    var dev: u64 = 0xFFFFFFFF
    var bus: u64 = 0xFFFFFFFF
    var n: u64 = node
    var v: u64 = 0
    while true {
        let a: u64 = amlns.child(state, n, adr)
        if a != amlns.NONE && dev == 0xFFFFFFFF {
            if amlns.node_kind(state, a) == amlns.NK_NAME {
                if const_int(amlns.node_a(state, a), (&v) as u64) != 0 {
                    dev = v
                }
            }
        }
        let b: u64 = amlns.child(state, n, bbn)
        if b != amlns.NONE && bus == 0xFFFFFFFF {
            if amlns.node_kind(state, b) == amlns.NK_NAME {
                if const_int(amlns.node_a(state, b), (&v) as u64) != 0 {
                    bus = v
                }
            }
        }
        if n == 0 {
            break
        }
        n = amlns.node_parent(state, n)
    }
    if dev == 0xFFFFFFFF {
        dev = 0
    }
    if bus == 0xFFFFFFFF {
        bus = 0
    }
    // bdf as `pci.fi` wants it: bus << 8 | device << 3 | function.
    return ((bus & 0xFF) << 8) | (((dev >> 16) & 0x1F) << 3) | (dev & 0x7)
}

// ------------------------------------------------ a byte from/to a region
//
// Returns 1 if it worked. `space` is the kind, `base` the base address of
// the region, `off` the offset inside it.
fn region_check(state: u64, space: u64, base: u64, len: u64) -> bool {
    if space == RS_IO {
        return base + len <= 0x10000
    }
    if space == RS_PCI {
        return base + len <= 0x1000
    }
    if space == RS_EC {
        return ecio.is_ready() && base + len <= 0x100
    }
    if space == RS_MEM {
        // Only what the kernel has identity-mapped. Anything above would be a
        // page fault with an announcement.
        let gib: u64 = mem.mapped_gib(state)
        if gib == 0 {
            return false
        }
        return base + len <= gib * 0x40000000
    }
    return false
}

fn reg_read8(state: u64, space: u64, node: u64, base: u64, off: u64) -> u64 {
    if space == RS_EC {
        return ecio.read_reg((base + off) & 0xFF)
    }
    if space == RS_IO {
        return serial.in8(((base + off) & 0xFFFF) as u16) as u64
    }
    if space == RS_PCI {
        return pci.cfg_read8(adr_of(state, node), base + off)
    }
    return amlns.rd8(base + off)
}

static mut read_only: bool = false
static mut blocked: u64 = 0

fn set_read_only(on: bool) {
    read_only = on
}

fn blocked_writes() -> u64 {
    return blocked
}

fn write_blocked(space: u64) -> bool {
    if read_only && space != RS_EC {
        blocked = blocked + 1
        return true
    }
    return false
}

fn reg_write8(state: u64, space: u64, node: u64, base: u64, off: u64,
    v: u64) {
    if write_blocked(space) {
        return
    }
    if space == RS_EC {
        ecio.write_reg((base + off) & 0xFF, v & 0xFF)
        return
    }
    if space == RS_IO {
        serial.out8(((base + off) & 0xFFFF) as u16, (v & 0xFF) as u8)
        return
    }
    if space == RS_PCI {
        pci.cfg_write8(adr_of(state, node), base + off, v)
        return
    }
    amlns.wr8(base + off, v)
}

fn reg_read32(state: u64, space: u64, node: u64, base: u64, off: u64) -> u64 {
    if space == RS_EC {
        return ecio.read_reg((base + off) & 0xFF) | (ecio.read_reg((base + off + 1) & 0xFF) << 8)
            | (ecio.read_reg((base + off + 2) & 0xFF) << 16) | (ecio.read_reg((base + off + 3) & 0xFF) << 24)
    }
    if space == RS_IO {
        return in32(((base + off) & 0xFFFF) as u16)
    }
    if space == RS_PCI {
        return pci.cfg_read32(adr_of(state, node), base + off)
    }
    return amlns.rd32(base + off)
}

fn reg_write32(state: u64, space: u64, node: u64, base: u64, off: u64,
    v: u64) {
    if write_blocked(space) {
        return
    }
    if space == RS_EC {
        var k: u64 = 0
        while k < 4 {
            ecio.write_reg((base + off + k) & 0xFF, (v >> (k * 8)) & 0xFF)
            k = k + 1
        }
        return
    }
    if space == RS_IO {
        out32(((base + off) & 0xFFFF) as u16, v)
        return
    }
    if space == RS_PCI {
        pci.cfg_write32(adr_of(state, node), base + off, v)
        return
    }
    amlns.wr8(base + off, v & 0xFF)
    amlns.wr8(base + off + 1, (v >> 8) & 0xFF)
    amlns.wr8(base + off + 2, (v >> 16) & 0xFF)
    amlns.wr8(base + off + 3, (v >> 24) & 0xFF)
}

// ------------------------------------------------------------ a field
//
// `fnode` is a node of kind NK_FIELD:
//   a = node of the region, b = bit offset, c = bit width | access << 32.
//
// INTEGER ACCESS COVERS FIELDS UP TO 64 BITS. That is everything in
// QEMU's DSDT (8 and 32 bits) and everything `_PRT`, `_STA` and `_CRS`
// need. A wider field gives ERR_REGION here instead of half a number;
// the buffer path (`field_read_wide`, `field_write_wide`) handles it.
const CTX_FIELD: u64 = 0x80
const FO_SPACE: u64 = 0
const FO_BASE: u64 = 1
const FO_REGION: u64 = 2
const FO_BITOFF: u64 = 3
const FO_BITS: u64 = 4
const FO_ACC: u64 = 5
const NARROW_BITS: u64 = 64
const ACC_DWORD: u64 = 3
const DWORD_BITS: u64 = 32
const ACC_SHIFT: u64 = 32
const ACC_MASK: u64 = 0xF
const WIDTH_MASK: u64 = 0xFFFFFFFF

fn field_open(state: u64, fnode: u64, out: u64) -> bool {
    let rnode: u64 = amlns.node_a(state, fnode)
    let c: u64 = amlns.node_c(state, fnode)
    let bits: u64 = c & WIDTH_MASK
    if bits == 0 {
        amlns.err_note(state, amlns.CTX_REGION | CTX_FIELD, fnode)
        amlns.err_set(state, amlns.ERR_REGION)
        return false
    }
    let space: u64 = amlns.node_c(state, rnode)
    let base: u64 = amlns.node_a(state, rnode)
    if !region_check(state, space, base, amlns.node_b(state, rnode)) {
        amlns.err_note(state, amlns.CTX_REGION | space, rnode)
        amlns.err_set(state, amlns.ERR_REGION)
        return false
    }
    amlns.wr64(out + FO_SPACE * 8, space)
    amlns.wr64(out + FO_BASE * 8, base)
    amlns.wr64(out + FO_REGION * 8, rnode)
    amlns.wr64(out + FO_BITOFF * 8, amlns.node_b(state, fnode))
    amlns.wr64(out + FO_BITS * 8, bits)
    amlns.wr64(out + FO_ACC * 8, (c >> ACC_SHIFT) & ACC_MASK)
    return true
}

fn field_bits(state: u64, fnode: u64) -> u64 {
    return amlns.node_c(state, fnode) & WIDTH_MASK
}

fn field_read(state: u64, fnode: u64) -> u64 {
    var g: [u64; 6] = [0 as u64; 6]
    if field_bits(state, fnode) > NARROW_BITS {
        amlns.err_note(state, amlns.CTX_REGION | CTX_FIELD, fnode)
        amlns.err_set(state, amlns.ERR_REGION)
        return 0
    }
    if !field_open(state, fnode, (&g[0]) as u64) {
        return 0
    }
    let space: u64 = g[FO_SPACE as usize]
    let base: u64 = g[FO_BASE as usize]
    let rnode: u64 = g[FO_REGION as usize]
    let bitoff: u64 = g[FO_BITOFF as usize]
    let bits: u64 = g[FO_BITS as usize]
    if g[FO_ACC as usize] == ACC_DWORD && bits == DWORD_BITS && (bitoff & 31) == 0 {
        return reg_read32(state, space, rnode, base, bitoff / 8)
    }
    var v: u64 = 0
    var got: u64 = 0
    var b: u64 = bitoff
    while got < bits {
        let byte: u64 = reg_read8(state, space, rnode, base, b / 8)
        let lo: u64 = b & 7
        var take: u64 = 8 -% lo
        if take > bits -% got {
            take = bits -% got
        }
        let mask: u64 = (1 << take) -% 1
        v = v | (((byte >> lo) & mask) << got)
        got = got + take
        b = b + take
    }
    return v
}

fn field_write(state: u64, fnode: u64, val: u64) {
    var g: [u64; 6] = [0 as u64; 6]
    if field_bits(state, fnode) > NARROW_BITS {
        amlns.err_note(state, amlns.CTX_REGION | CTX_FIELD, fnode)
        amlns.err_set(state, amlns.ERR_REGION)
        return
    }
    if !field_open(state, fnode, (&g[0]) as u64) {
        return
    }
    let space: u64 = g[FO_SPACE as usize]
    let base: u64 = g[FO_BASE as usize]
    let rnode: u64 = g[FO_REGION as usize]
    let bitoff: u64 = g[FO_BITOFF as usize]
    let bits: u64 = g[FO_BITS as usize]
    if g[FO_ACC as usize] == ACC_DWORD && bits == DWORD_BITS && (bitoff & 31) == 0 {
        reg_write32(state, space, rnode, base, bitoff / 8, val)
        return
    }
    var done: u64 = 0
    var b: u64 = bitoff
    while done < bits {
        let lo: u64 = b & 7
        var take: u64 = 8 -% lo
        if take > bits -% done {
            take = bits -% done
        }
        let mask: u64 = ((1 << take) -% 1) << lo
        var byte: u64 = 0
        if mask != 0xFF {
            byte = reg_read8(state, space, rnode, base, b / 8)
        }
        byte = (byte & (0xFF -% mask)) | ((((val >> done) << lo)) & mask)
        reg_write8(state, space, rnode, base, b / 8, byte)
        done = done + take
        b = b + take
    }
}

fn field_read_wide(state: u64, fnode: u64, dst: u64, nbytes: u64) {
    var g: [u64; 6] = [0 as u64; 6]
    var i: u64 = 0
    while i < nbytes {
        amlns.wr8(dst + i, 0)
        i = i + 1
    }
    if !field_open(state, fnode, (&g[0]) as u64) {
        return
    }
    let bits: u64 = g[FO_BITS as usize]
    var got: u64 = 0
    var b: u64 = g[FO_BITOFF as usize]
    while got < bits && got / 8 < nbytes {
        let byte: u64 = reg_read8(state, g[FO_SPACE as usize], g[FO_REGION as usize], g[FO_BASE as usize], b / 8)
        let lo: u64 = b & 7
        var take: u64 = 8 -% lo
        if take > bits -% got {
            take = bits -% got
        }
        let chunk: u64 = (byte >> lo) & ((1 << take) -% 1)
        let at: u64 = dst + got / 8
        let pos: u64 = got & 7
        amlns.wr8(at, amlns.rd8(at) | ((chunk << pos) & 0xFF))
        if pos + take > 8 && got / 8 + 1 < nbytes {
            amlns.wr8(at + 1, amlns.rd8(at + 1) | (chunk >> (8 -% pos)))
        }
        got = got + take
        b = b + take
    }
}

fn field_write_wide(state: u64, fnode: u64, src: u64, nbytes: u64) {
    var g: [u64; 6] = [0 as u64; 6]
    if !field_open(state, fnode, (&g[0]) as u64) {
        return
    }
    let bits: u64 = g[FO_BITS as usize]
    var done: u64 = 0
    var b: u64 = g[FO_BITOFF as usize]
    while done < bits {
        let lo: u64 = b & 7
        var take: u64 = 8 -% lo
        if take > bits -% done {
            take = bits -% done
        }
        var bitsrc: u64 = 0
        if done / 8 < nbytes {
            let pos: u64 = done & 7
            bitsrc = amlns.rd8(src + done / 8) >> pos
            if pos + take > 8 && done / 8 + 1 < nbytes {
                bitsrc = bitsrc | (amlns.rd8(src + done / 8 + 1) << (8 -% pos))
            }
        }
        let mask: u64 = ((1 << take) -% 1) << lo
        var byte: u64 = 0
        if mask != 0xFF {
            byte = reg_read8(state, g[FO_SPACE as usize], g[FO_REGION as usize], g[FO_BASE as usize], b / 8)
        }
        byte = (byte & (0xFF -% mask)) | ((bitsrc << lo) & mask)
        reg_write8(state, g[FO_SPACE as usize], g[FO_REGION as usize], g[FO_BASE as usize], b / 8, byte)
        done = done + take
        b = b + take
    }
}

// ------------------------------------------- resource descriptors
//
// What `_CRS` and `_PRS` return is a buffer full of descriptors: short
// ones (bit 7 = 0, kind in bits 6:3, length in bits 2:0) and long ones
// (bit 7 = 1, kind in bits 6:0, then two bytes of length). For this round
// exactly one kind of them counts -- the interrupt:
//
//   0x22/0x23  IRQ, short: a 16-bit mask of the possible lines
//   0x89       Extended Interrupt, long: a count of entries and, after
//              it, four bytes of GSI each
//
// QEMU's `_CRS` of a link device is exactly one 0x89 with one entry, and
// the four bytes at offset 5 are the line the firmware has written into
// the PIIX3 register.

// How many interrupt numbers the buffer names.
fn res_irq_count(state: u64, at: u64, len: u64) -> u64 {
    var i: u64 = 0
    var n: u64 = 0
    while i < len {
        let tag: u64 = amlns.rd8(at + i)
        if tag == 0x79 {
            break
        }
        if (tag & 0x80) == 0 {
            let l: u64 = tag & 7
            let kind: u64 = (tag >> 3) & 0xF
            if kind == 4 { // IRQ, short
                let mask: u64 = amlns.rd16(at + i + 1)
                var b: u64 = 0
                while b < 16 {
                    if (mask & (1 << b)) != 0 {
                        n = n + 1
                    }
                    b = b + 1
                }
            }
            i = i + 1 + l
        } else {
            let l: u64 = amlns.rd16(at + i + 1)
            if (tag & 0x7F) == 0x09 { // Extended Interrupt
                n = n + amlns.rd8(at + i + 4)
            }
            i = i + 3 + l
        }
    }
    return n
}

// The k-th interrupt number, or 0xFFFFFFFF.
fn res_irq_at(state: u64, at: u64, len: u64, k: u64) -> u64 {
    var i: u64 = 0
    var seen: u64 = 0
    while i < len {
        let tag: u64 = amlns.rd8(at + i)
        if tag == 0x79 {
            break
        }
        if (tag & 0x80) == 0 {
            let l: u64 = tag & 7
            let kind: u64 = (tag >> 3) & 0xF
            if kind == 4 {
                let mask: u64 = amlns.rd16(at + i + 1)
                var b: u64 = 0
                while b < 16 {
                    if (mask & (1 << b)) != 0 {
                        if seen == k {
                            return b
                        }
                        seen = seen + 1
                    }
                    b = b + 1
                }
            }
            i = i + 1 + l
        } else {
            let l: u64 = amlns.rd16(at + i + 1)
            if (tag & 0x7F) == 0x09 {
                let cnt: u64 = amlns.rd8(at + i + 4)
                var j: u64 = 0
                while j < cnt {
                    if seen == k {
                        return amlns.rd32(at + i + 5 + j * 4)
                    }
                    seen = seen + 1
                    j = j + 1
                }
            }
            i = i + 3 + l
        }
    }
    return 0xFFFFFFFF
}

fn res_first_irq(state: u64, at: u64, len: u64) -> u64 {
    return res_irq_at(state, at, len, 0)
}
