profile kernel

import acpi.amlns
import acpi.amlobj

export { concat, concat_res, mid, to_string, match_find, to_bcd, from_bcd, order, str_to_int, MATCH_NONE, ORDER_EQUAL, ORDER_GREATER, ORDER_LESS }

const INT_BYTES: u64 = 8
const BYTE_BITS: u64 = 8
const NIBBLE_BITS: u64 = 4
const NIBBLE_MASK: u64 = 0xF
const DECIMAL: u64 = 10
const DIGIT_ZERO: u64 = 48
const HEX_LETTER_BASE: u64 = 55
const SPACE: u64 = 32
const NUL: u64 = 0
const END_TAG: u64 = 0x79
const END_TAG_BYTES: u64 = 2
const LARGE_ITEM: u64 = 0x80
const SMALL_LENGTH_MASK: u64 = 0x07
const SMALL_HEADER_BYTES: u64 = 1
const LARGE_HEADER_BYTES: u64 = 3
const BCD_DIGITS: u64 = 16
const MATCH_NONE: u64 = 0xFFFFFFFFFFFFFFFF
const MATCH_TRUE: u64 = 0
const MATCH_EQ: u64 = 1
const MATCH_LE: u64 = 2
const MATCH_LT: u64 = 3
const MATCH_GE: u64 = 4
const MATCH_GT: u64 = 5
const LENGTH_ALL: u64 = 0xFFFFFFFFFFFFFFFF
const ORDER_EQUAL: u64 = 0
const ORDER_GREATER: u64 = 1
const ORDER_LESS: u64 = 2
const CH_X_LOWER: u64 = 120
const CH_X_UPPER: u64 = 88
const CH_A_UPPER: u64 = 65
const CH_F_UPPER: u64 = 70
const CH_A_LOWER: u64 = 97
const CH_F_LOWER: u64 = 102
const CH_NINE: u64 = 57
const HEX_RADIX: u64 = 16
const TAB: u64 = 9

fn fail_type(state: u64) -> bool {
    amlns.err_set(state, amlns.ERR_TYPE)
    return false
}

fn copy_bytes(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        amlns.wr8(dst + i, amlns.rd8(src + i))
        i = i + 1
    }
}

fn put_int_bytes(at: u64, v: u64) {
    var i: u64 = 0
    while i < INT_BYTES {
        amlns.wr8(at + i, (v >> (i * BYTE_BITS)) & 0xFF)
        i = i + 1
    }
}

fn hex_digit(d: u64) -> u64 {
    if d < DECIMAL {
        return DIGIT_ZERO + d
    }
    return HEX_LETTER_BASE + d
}

fn int_text(v: u64, at: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = BCD_DIGITS
    var lead: bool = true
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * NIBBLE_BITS)) & NIBBLE_MASK
        if d != 0 || !lead || i == 0 {
            lead = false
            amlns.wr8(at + n, hex_digit(d))
            n = n + 1
        }
    }
    return n
}

fn make_string(state: u64, n: u64, dst: u64) -> u64 {
    let o: u64 = amlobj.obj_buf(state, n + 1)
    if o == 0 {
        return 0
    }
    let at: u64 = amlobj.ov1(o)
    amlns.wr8(at + n, NUL)
    amlobj.oset(dst, amlobj.OT_STR, at, n)
    return at
}

fn make_buffer(state: u64, n: u64, dst: u64) -> u64 {
    let o: u64 = amlobj.obj_buf(state, n)
    if o == 0 {
        return 0
    }
    amlobj.ocopy(dst, o)
    return amlobj.ov1(o)
}

fn text_length(state: u64, o: u64) -> u64 {
    let t: u64 = amlobj.otype(o)
    if t == amlobj.OT_STR {
        return amlobj.ov2(o)
    }
    if t == amlobj.OT_INT {
        var tmp: [u8; 24] = [0 as u8; 24]
        return int_text(amlobj.ov1(o), (&tmp[0]) as u64)
    }
    if t == amlobj.OT_BUF {
        let n: u64 = amlobj.ov2(o)
        if n == 0 {
            return 0
        }
        return n * 3 - 1
    }
    return 0
}

fn put_text(o: u64, at: u64) {
    let t: u64 = amlobj.otype(o)
    if t == amlobj.OT_STR {
        copy_bytes(at, amlobj.ov1(o), amlobj.ov2(o))
        return
    }
    if t == amlobj.OT_INT {
        let _n: u64 = int_text(amlobj.ov1(o), at)
        return
    }
    let n: u64 = amlobj.ov2(o)
    var i: u64 = 0
    var w: u64 = 0
    while i < n {
        let b: u64 = amlns.rd8(amlobj.ov1(o) + i)
        amlns.wr8(at + w, hex_digit(b >> NIBBLE_BITS))
        amlns.wr8(at + w + 1, hex_digit(b & NIBBLE_MASK))
        w = w + 2
        if i + 1 < n {
            amlns.wr8(at + w, SPACE)
            w = w + 1
        }
        i = i + 1
    }
}

fn byte_length(o: u64) -> u64 {
    let t: u64 = amlobj.otype(o)
    if t == amlobj.OT_INT {
        return INT_BYTES
    }
    if t == amlobj.OT_STR {
        return amlobj.ov2(o) + 1
    }
    return amlobj.ov2(o)
}

fn put_bytes(o: u64, at: u64) {
    let t: u64 = amlobj.otype(o)
    if t == amlobj.OT_INT {
        put_int_bytes(at, amlobj.ov1(o))
        return
    }
    copy_bytes(at, amlobj.ov1(o), byte_length(o))
}

fn is_data(o: u64) -> bool {
    let t: u64 = amlobj.otype(o)
    return t == amlobj.OT_INT || t == amlobj.OT_STR || t == amlobj.OT_BUF
}

fn concat(state: u64, a: u64, b: u64, dst: u64) -> bool {
    if !is_data(a) || !is_data(b) {
        return fail_type(state)
    }
    let ta: u64 = amlobj.otype(a)
    if ta == amlobj.OT_STR {
        let la: u64 = amlobj.ov2(a)
        let lb: u64 = text_length(state, b)
        let at: u64 = make_string(state, la + lb, dst)
        if at == 0 {
            return false
        }
        put_text(a, at)
        put_text(b, at + la)
        return true
    }
    var la: u64 = byte_length(a)
    if ta == amlobj.OT_INT {
        la = INT_BYTES
    }
    let lb: u64 = byte_length(b)
    let at: u64 = make_buffer(state, la + lb, dst)
    if at == 0 && la + lb != 0 {
        return false
    }
    put_bytes(a, at)
    put_bytes(b, at + la)
    return true
}

fn template_body(o: u64) -> u64 {
    let n: u64 = amlobj.ov2(o)
    let at: u64 = amlobj.ov1(o)
    var i: u64 = 0
    while i < n {
        let tag: u64 = amlns.rd8(at + i)
        if tag == END_TAG {
            return i
        }
        if (tag & LARGE_ITEM) != 0 {
            if i + LARGE_HEADER_BYTES > n {
                return n
            }
            i = i + LARGE_HEADER_BYTES + amlns.rd16(at + i + 1)
        } else {
            i = i + SMALL_HEADER_BYTES + (tag & SMALL_LENGTH_MASK)
        }
    }
    return n
}

fn concat_res(state: u64, a: u64, b: u64, dst: u64) -> bool {
    if amlobj.otype(a) != amlobj.OT_BUF || amlobj.otype(b) != amlobj.OT_BUF {
        return fail_type(state)
    }
    let la: u64 = template_body(a)
    let lb: u64 = amlobj.ov2(b)
    let at: u64 = make_buffer(state, la + lb, dst)
    if at == 0 && la + lb != 0 {
        return false
    }
    copy_bytes(at, amlobj.ov1(a), la)
    copy_bytes(at + la, amlobj.ov1(b), lb)
    return true
}

fn mid(state: u64, src: u64, index: u64, length: u64, dst: u64) -> bool {
    let t: u64 = amlobj.otype(src)
    if t != amlobj.OT_STR && t != amlobj.OT_BUF {
        return fail_type(state)
    }
    let n: u64 = amlobj.ov2(src)
    var start: u64 = index
    if start > n {
        start = n
    }
    var count: u64 = length
    if count > n - start {
        count = n - start
    }
    var at: u64 = 0
    if t == amlobj.OT_STR {
        at = make_string(state, count, dst)
    } else {
        at = make_buffer(state, count, dst)
    }
    if at == 0 && count != 0 {
        return false
    }
    copy_bytes(at, amlobj.ov1(src) + start, count)
    return true
}

fn to_string(state: u64, src: u64, length: u64, dst: u64) -> bool {
    let t: u64 = amlobj.otype(src)
    if t != amlobj.OT_STR && t != amlobj.OT_BUF {
        return fail_type(state)
    }
    let n: u64 = amlobj.ov2(src)
    var count: u64 = 0
    while count < n && count < length && amlns.rd8(amlobj.ov1(src) + count) != NUL {
        count = count + 1
    }
    let at: u64 = make_string(state, count, dst)
    if at == 0 && count != 0 {
        return false
    }
    copy_bytes(at, amlobj.ov1(src), count)
    return true
}

fn match_test(op: u64, item: u64, operand: u64) -> bool {
    if op == MATCH_TRUE {
        return true
    }
    if op == MATCH_EQ {
        return item == operand
    }
    if op == MATCH_LE {
        return item <= operand
    }
    if op == MATCH_LT {
        return item < operand
    }
    if op == MATCH_GE {
        return item >= operand
    }
    if op == MATCH_GT {
        return item > operand
    }
    return false
}

fn match_find(pkg: u64, op1: u64, v1: u64, op2: u64, v2: u64, start: u64) -> u64 {
    if amlobj.otype(pkg) != amlobj.OT_PKG {
        return MATCH_NONE
    }
    let n: u64 = amlobj.ov2(pkg)
    var i: u64 = start
    while i < n {
        let e: u64 = amlobj.pkg_at(pkg, i)
        if amlobj.otype(e) == amlobj.OT_INT {
            let v: u64 = amlobj.ov1(e)
            if match_test(op1, v, v1) && match_test(op2, v, v2) {
                return i
            }
        }
        i = i + 1
    }
    return MATCH_NONE
}

fn to_bcd(v: u64) -> u64 {
    var out: u64 = 0
    var x: u64 = v
    var k: u64 = 0
    while k < BCD_DIGITS {
        out = out | ((x % DECIMAL) << (k * NIBBLE_BITS))
        x = x / DECIMAL
        k = k + 1
    }
    return out
}

fn from_bcd(v: u64) -> u64 {
    var out: u64 = 0
    var scale: u64 = 1
    var k: u64 = 0
    while k < BCD_DIGITS {
        out = out + ((v >> (k * NIBBLE_BITS)) & NIBBLE_MASK) * scale
        if k + 1 < BCD_DIGITS {
            scale = scale * DECIMAL
        }
        k = k + 1
    }
    return out
}

fn order(a: u64, b: u64) -> u64 {
    let ta: u64 = amlobj.otype(a)
    if ta == amlobj.OT_INT {
        let x: u64 = amlobj.ov1(a)
        let y: u64 = amlobj.to_int(b)
        if x == y {
            return ORDER_EQUAL
        }
        if x > y {
            return ORDER_GREATER
        }
        return ORDER_LESS
    }
    let na: u64 = amlobj.ov2(a)
    let nb: u64 = amlobj.ov2(b)
    var i: u64 = 0
    while i < na && i < nb {
        let x: u64 = amlns.rd8(amlobj.ov1(a) + i)
        let y: u64 = amlns.rd8(amlobj.ov1(b) + i)
        if x != y {
            if x > y {
                return ORDER_GREATER
            }
            return ORDER_LESS
        }
        i = i + 1
    }
    if na == nb {
        return ORDER_EQUAL
    }
    if na > nb {
        return ORDER_GREATER
    }
    return ORDER_LESS
}

fn digit_value(c: u64, radix: u64) -> u64 {
    var v: u64 = 0xFF
    if c >= DIGIT_ZERO && c <= CH_NINE {
        v = c - DIGIT_ZERO
    } else if c >= CH_A_UPPER && c <= CH_F_UPPER {
        v = c - CH_A_UPPER + DECIMAL
    } else if c >= CH_A_LOWER && c <= CH_F_LOWER {
        v = c - CH_A_LOWER + DECIMAL
    }
    if v >= radix {
        return 0xFF
    }
    return v
}

fn str_to_int(o: u64) -> u64 {
    if amlobj.otype(o) != amlobj.OT_STR {
        return amlobj.to_int(o)
    }
    let at: u64 = amlobj.ov1(o)
    let n: u64 = amlobj.ov2(o)
    var i: u64 = 0
    while i < n && (amlns.rd8(at + i) == SPACE || amlns.rd8(at + i) == TAB) {
        i = i + 1
    }
    var radix: u64 = DECIMAL
    if i + 1 < n && amlns.rd8(at + i) == DIGIT_ZERO && (amlns.rd8(at + i + 1) == CH_X_LOWER || amlns.rd8(at + i + 1) == CH_X_UPPER) {
        radix = HEX_RADIX
        i = i + 2
    }
    var v: u64 = 0
    while i < n {
        let d: u64 = digit_value(amlns.rd8(at + i), radix)
        if d == 0xFF {
            break
        }
        v = v *% radix +% d
        i = i + 1
    }
    return v
}
