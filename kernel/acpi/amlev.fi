// SPDX-License-Identifier: GPL-2.0-only
// kernel/acpi/amlev.fi -- AML ROUND, PART 3: EXECUTION.
//
// This is where AML really runs. What this file can do is exactly what
// is needed to evaluate `_PRT`, `_CRS`, `_PRS`, `_SRS` and `_STA` on an
// ordinary machine -- no more. A complete rebuild of ACPICA is EXPLICITLY
// NOT the goal of this round; it would be larger than the rest of the
// kernel and could not be measured with what is available here.
//
// TWO LIMITS THAT ARE NOT NEGOTIABLE. A firmware is foreign code that
// this kernel executes. Without limits the first mistyped counter in a
// While loop is a computer that stops at boot, and the first method that
// calls itself is a stack overflow in the kernel.
//
//   BUDGET   Every evaluated term costs one step. When the steps are
//            used up, the evaluation aborts with ERR_BUDGET.
//   DEPTH    Nesting of expressions and method calls is counted. The
//            kernel stack is 65536 bytes (`kernel/arch/x86_64/boot.s`);
//            DEPTH_MAX is chosen so that it does not run out, and the
//            acceptance run runs against it.
//
// WHERE THE INTERMEDIATE RESULTS LIVE. NOT on the heap. Every caller of
// `ev` passes a slot of 24 bytes, and it sits on the Firn stack
// (`var o: [u64; 3]`). That is not stinginess: a loop that does not end
// would otherwise empty the heap before the budget takes effect -- and
// then the acceptance run would report "heap full" where it wanted to
// check "endless loop". Only what has a body goes on the heap: buffers,
// packages, strings and the frames of the methods.

import lib.kstate
import serial
import acpi.amlns
import acpi.amlobj
import acpi.amlstr
import acpi.amlsys
import acpi.amlfield

export {
    ev, ev_target, exec_list, call_method, store_into, deref,
    frame_new, frame_scope_set, frame_ret, frame_ctl,
    budget_set, budget_left, depth_reset, stack_base, stack_high,
    depth_high, stack_clear,
    seen_mark, seen_get, seen_ext, seen_ext_mark, notifies,
    not_count, not_node, not_code, not_clear,
    FRAME_BYTES, DEPTH_MAX, CALL_MAX
}

// --------------------------------------------- the slots in `kdata`
//
// `amlns.fi` uses 0..55, this file 56..191, `aml.fi` from 192 on (route
// table 512..2560). They live in ONE page; whoever adds one enters it
// here. ROUND ACPI-EVENTS additionally takes 2560..2816 for the notify
// ring -- BEHIND the route table, see the reasoning there.

const A_DEPTH: u64 = 56
const A_PERSIST: u64 = 2832
const A_CALLS: u64 = 64
const A_BUDGET: u64 = 72
const A_LASTIF: u64 = 80 // was the condition of the last `If` true?
const A_NOTIFY: u64 = 88 // how often `Notify` was seen
const A_SP0: u64 = 96 // stack pointer when entering the interpreter
const A_SPHI: u64 = 104
const A_DEPTHHI: u64 = 112 // deepest nesting reached // how deep the stack was at most

const A_OPS: u64 = 128 // 4 words: which of the 256 opcodes occurred
const A_EXT: u64 = 168 // 3 words: the same for 0x5B 0x00..0x8F

// ROUND ACPI-EVENTS: WHAT `Notify` REPORTED, and not only HOW OFTEN.
//
// Up to here `ev_notify` incremented a counter and threw both arguments
// away. That was enough for `_PRT` -- there is no `Notify` in it at all.
// For the events it IS the message: the firmware's GPE method `_L1B`
// does nothing but execute `Notify(\_SB.BAT0, 0x80)`, and that is how
// the kernel recognises WHICH device has reported and WHAT it wants to
// say (0x80 = the state has changed, 0x81 = the description).
//
// A RING, not a single slot: one GPE method may issue several `Notify`
// in a row (`_L1B` above reports the battery twice and the adapter once),
// and whoever keeps only the last one loses the other two.
//
// WHERE THE RING LIVES, and why not at 192.
//
// The page `kstate.AML_OFF` is shared by three files: `amlns.fi` 0..55,
// `amlev.fi` 56..191, `aml.fi` from 192 on -- and the latter's route
// table sits at 512 and is 128 * 16 = 2048 bytes long, so it runs up to
// 2560. A ring at 200 would have written INTO the scalars of `aml.fi`
// (A_PRTOK, A_ROUTEN, A_READY ...). That is the same mistake as the page
// collisions in `kstate.fi`, only one level deeper, and it goes unnoticed
// because no tool recalculates the split INSIDE a page.
//
// The ring therefore lives behind the route table: 2560..2816. The page
// is 4096 bytes (kstate.AML_MAX); behind the ring come the error context
// of `amlns.fi` (2816..2831) and A_PERSIST (2832).
const A_NOTN: u64 = 2560 // how many are in the ring
const A_NOTR: u64 = 2568 // NOT_MAX * 16: nodes, then codes
const NOT_MAX: u64 = 16

const DEPTH_MAX: u64 = 64
const CALL_MAX: u64 = 16

// HOW MUCH KERNEL STACK THE INTERPRETER MAY USE.
//
// The DEPTH_MAX above is a cautious limit and NOT a guard: how many
// bytes a nesting level really costs is decided by the compiler, not by
// the source text. `ev_inner` has two dozen temporary slots of 24 bytes,
// and Firn allocates them in the frame whichever branch is taken.
//
// MEASURED, NOT GUESSED: with CALL_MAX 10 and DEPTH_MAX 48 the recursion
// test (`amldeep`) EXCEEDED the kernel stack of 65536 bytes -- the string
// that was meant to report the error was no longer on the stack
// afterwards, and the output broke off in the middle of a word. So the
// stack pointer is measured ITSELF: `stage` remembers where it stood, and
// every nesting level calculates how far it has moved away from it.
// Whoever breaks the limit gets ERR_DEPTH -- the same defined error as
// for too deep recursion, and it now comes from a measurement.
const STACK_LIMIT: u64 = 57344

// A method frame. Seven arguments, eight local variables, one return slot
// and one control word -- all next to each other, so that a frame is ONE
// allocation.
const FRAME_BYTES: u64 = 400
const F_SCOPE: u64 = 0
const F_ARGS: u64 = 8 // 7 * 24
const F_LOCALS: u64 = 176 // 8 * 24
const F_RET: u64 = 368
const F_CTL: u64 = 392

// What the control word says.
const C_NONE: u64 = 0
const C_RETURN: u64 = 1
const C_BREAK: u64 = 2
const C_CONTINUE: u64 = 3

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.AML_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.AML_OFF + off, v)
}

fn budget_set(state: u64, n: u64) {
    s(state, A_BUDGET, n)
    s(state, A_DEPTH, 0)
    s(state, A_CALLS, 0)
}

// Where the stack is. This is the only line of assembler in this file,
// and it reads a register that no language names.
fn sp_now() -> u64 {
    return asm("mov rax, rsp", out("rax"))
}

// This is where the interpreter starts. Everything that goes deeper is
// measured from here.
fn stack_base(state: u64) {
    s(state, A_SP0, sp_now())
    s(state, A_SPHI, 0)
}

// How many bytes of kernel stack the deepest point cost.
fn stack_high(state: u64) -> u64 {
    return g(state, A_SPHI)
}

// Reset the high-water mark -- so that it can be measured WHICH section
// uses the stack: loading or executing.
fn stack_clear(state: u64) {
    s(state, A_SPHI, 0)
}

fn depth_high(state: u64) -> u64 {
    return g(state, A_DEPTHHI)
}

fn budget_left(state: u64) -> u64 {
    return g(state, A_BUDGET)
}

fn depth_reset(state: u64) {
    s(state, A_DEPTH, 0)
    s(state, A_CALLS, 0)
}

fn notifies(state: u64) -> u64 {
    return g(state, A_NOTIFY)
}

// ---------------------------------------- which opcodes occurred
//
// Not decoration: the acceptance run calculates the COVERAGE -- how many
// of the opcodes that really occur in this machine's DSDT this
// interpreter knows. For that it must be able to say which ones it has
// seen.

fn seen_mark(state: u64, op: u64) {
    let w: u64 = A_OPS + (op / 64) * 8
    s(state, w, g(state, w) | (1 << (op & 63)))
}

fn seen_get(state: u64, op: u64) -> bool {
    let w: u64 = A_OPS + (op / 64) * 8
    return (g(state, w) & (1 << (op & 63))) != 0
}

fn seen_ext_mark(state: u64, op: u64) {
    let w: u64 = A_EXT + (op / 64) * 8
    s(state, w, g(state, w) | (1 << (op & 63)))
}

fn seen_ext(state: u64, op: u64) -> bool {
    let w: u64 = A_EXT + (op / 64) * 8
    return (g(state, w) & (1 << (op & 63))) != 0
}

// ------------------------------------------------------------ frame

fn frame_new(state: u64) -> u64 {
    return amlns.heap_alloc(state, FRAME_BYTES)
}

fn frame_scope(f: u64) -> u64 {
    return amlns.rd64(f + F_SCOPE)
}

fn frame_scope_set(f: u64, v: u64) {
    amlns.wr64(f + F_SCOPE, v)
}

fn frame_arg(f: u64, i: u64) -> u64 {
    return f + F_ARGS + i * amlobj.OBJ_BYTES
}

fn frame_local(f: u64, i: u64) -> u64 {
    return f + F_LOCALS + i * amlobj.OBJ_BYTES
}

fn frame_ret(f: u64) -> u64 {
    return f + F_RET
}

fn frame_ctl(f: u64) -> u64 {
    return amlns.rd64(f + F_CTL)
}

fn frame_ctl_set(f: u64, v: u64) {
    amlns.wr64(f + F_CTL, v)
}

// ------------------------------------------------------ bookkeeping

// One step. Returns false when the budget is used up -- and then
// ERR_BUDGET is set, and every loop above aborts.
fn step(state: u64) -> bool {
    let b: u64 = g(state, A_BUDGET)
    if b == 0 {
        amlns.err_set(state, amlns.ERR_BUDGET)
        return false
    }
    s(state, A_BUDGET, b -% 1)
    return true
}

fn enter(state: u64) -> bool {
    let d: u64 = g(state, A_DEPTH)
    if d >= DEPTH_MAX {
        amlns.err_set(state, amlns.ERR_DEPTH)
        return false
    }
    let sp0: u64 = g(state, A_SP0)
    let sp: u64 = sp_now()
    if sp0 != 0 && sp0 > sp {
        let used: u64 = sp0 -% sp
        if used > g(state, A_SPHI) {
            s(state, A_SPHI, used)
        }
        if used > STACK_LIMIT {
            amlns.err_set(state, amlns.ERR_DEPTH)
            return false
        }
    }
    s(state, A_DEPTH, d + 1)
    if d + 1 > g(state, A_DEPTHHI) {
        s(state, A_DEPTHHI, d + 1)
    }
    return true
}

fn leave(state: u64) {
    let d: u64 = g(state, A_DEPTH)
    if d != 0 {
        s(state, A_DEPTH, d -% 1)
    }
}

fn persist(state: u64) {
    s(state, A_PERSIST, g(state, A_PERSIST) + 1)
}

fn bad(state: u64) -> bool {
    return amlns.err(state) != amlns.ERR_OK
}

fn bad_op(state: u64, f: u64, op: u64) {
    amlns.err_note(state, op, frame_scope(f))
    amlns.err_set(state, amlns.ERR_OPCODE)
}

fn deref(state: u64, o: u64) {
    let t: u64 = amlobj.otype(o)
    if t == amlobj.OT_REF_SLOT {
        amlobj.ocopy(o, amlobj.ov1(o))
        return
    }
    if t == amlobj.OT_REF_BYTE {
        amlobj.oint(o, amlns.rd8(amlobj.ov1(o)))
        return
    }
    if t == amlobj.OT_REF_NODE {
        node_value(state, amlobj.ov1(o), o)
        return
    }
}

// Fetch the value of a node.
fn node_value(state: u64, node: u64, dst: u64) {
    if node == amlns.NONE {
        amlobj.oset(dst, amlobj.OT_NONE, 0, 0)
        amlns.err_set(state, amlns.ERR_NOTFOUND)
        return
    }
    let k: u64 = amlns.node_kind(state, node)
    if k == amlns.NK_NAME {
        let cached: u64 = amlns.node_b(state, node)
        if cached != 0 {
            amlobj.ocopy(dst, cached)
            return
        }
        // Never read before: evaluate the AML behind the name and remember the
        // result. A `Name` is constant -- a second read would have to give the
        // same, and the heap is not infinite.
        let f: u64 = frame_new(state)
        if f == 0 {
            amlobj.oset(dst, amlobj.OT_NONE, 0, 0)
            return
        }
        frame_scope_set(f, amlns.node_parent(state, node))
        let o: u64 = amlobj.obj_new(state)
        if o == 0 {
            amlobj.oset(dst, amlobj.OT_NONE, 0, 0)
            return
        }
        ev(state, f, amlns.node_a(state, node), o)
        persist(state)
        amlns.set_b(state, node, o)
        amlobj.ocopy(dst, o)
        return
    }
    if k == amlns.NK_FIELD {
        let width: u64 = amlobj.field_bits(state, node)
        if width > amlobj.NARROW_BITS {
            let o: u64 = amlobj.obj_buf(state, (width + 7) / 8)
            if o == 0 {
                amlobj.oset(dst, amlobj.OT_NONE, 0, 0)
                return
            }
            amlobj.field_read_wide(state, node, amlobj.ov1(o), amlobj.ov2(o))
            amlobj.ocopy(dst, o)
            return
        }
        amlobj.oint(dst, amlobj.field_read(state, node))
        return
    }
    if k == amlns.NK_BUFFIELD {
        amlobj.oint(dst, buffield_read(state, node))
        return
    }
    // Device, scope, region, mutex: the node itself is the value.
    amlobj.oset(dst, amlobj.OT_REF_NODE, node, 0)
}

// ----------------------------------------------- fields in a buffer
//
// `CreateDWordField(PRR0, 5, PRRI)` creates a name that points to four
// bytes INSIDE A BUFFER. The node holds the buffer object, the bit
// offset and the bit width.
fn buffield_read(state: u64, node: u64) -> u64 {
    let bo: u64 = amlns.node_a(state, node)
    let bit: u64 = amlns.node_b(state, node)
    let width: u64 = amlns.node_c(state, node)
    if amlobj.otype(bo) != amlobj.OT_BUF {
        amlns.err_set(state, amlns.ERR_TYPE)
        return 0
    }
    let at: u64 = amlobj.ov1(bo)
    let len: u64 = amlobj.ov2(bo)
    var v: u64 = 0
    var i: u64 = 0
    while i < width {
        let b: u64 = bit + i
        if b / 8 >= len {
            break
        }
        if (amlns.rd8(at + b / 8) & (1 << (b & 7))) != 0 {
            v = v | (1 << i)
        }
        i = i + 1
    }
    return v
}

fn buffield_write(state: u64, node: u64, val: u64) {
    let bo: u64 = amlns.node_a(state, node)
    let bit: u64 = amlns.node_b(state, node)
    let width: u64 = amlns.node_c(state, node)
    if amlobj.otype(bo) != amlobj.OT_BUF {
        amlns.err_set(state, amlns.ERR_TYPE)
        return
    }
    let at: u64 = amlobj.ov1(bo)
    let len: u64 = amlobj.ov2(bo)
    var i: u64 = 0
    while i < width {
        let b: u64 = bit + i
        if b / 8 >= len {
            break
        }
        var byte: u64 = amlns.rd8(at + b / 8)
        if (val & (1 << i)) != 0 {
            byte = byte | (1 << (b & 7))
        } else {
            byte = byte & (0xFF -% (1 << (b & 7)))
        }
        amlns.wr8(at + b / 8, byte)
        i = i + 1
    }
}

// --------------------------------------------------------------- Store

// Put an object into a target. `tgt` is what `ev_target` has delivered.
fn store_wide_field(state: u64, node: u64, src: u64) {
    let t: u64 = amlobj.otype(src)
    if t == amlobj.OT_BUF || t == amlobj.OT_STR {
        amlobj.field_write_wide(state, node, amlobj.ov1(src), amlobj.ov2(src))
        return
    }
    var raw: [u64; 1] = [amlobj.to_int(src)]
    amlobj.field_write_wide(state, node, (&raw[0]) as u64, 8)
}

fn store_into(state: u64, src: u64, tgt: u64) {
    let t: u64 = amlobj.otype(tgt)
    if t == amlobj.OT_NONE {
        return // the target was NullName: the result is discarded
    }
    if t == amlobj.OT_REF_SLOT {
        amlobj.ocopy(amlobj.ov1(tgt), src)
        return
    }
    if t == amlobj.OT_REF_BYTE {
        amlns.wr8(amlobj.ov1(tgt), amlobj.to_int(src))
        return
    }
    if t == amlobj.OT_DEBUG {
        return
    }
    if t != amlobj.OT_REF_NODE {
        amlns.err_set(state, amlns.ERR_TYPE)
        return
    }
    let node: u64 = amlobj.ov1(tgt)
    if node == amlns.NONE {
        amlns.err_set(state, amlns.ERR_NOTFOUND)
        return
    }
    let k: u64 = amlns.node_kind(state, node)
    if k == amlns.NK_FIELD {
        if amlobj.field_bits(state, node) > amlobj.NARROW_BITS {
            store_wide_field(state, node, src)
            return
        }
        amlobj.field_write(state, node, amlobj.to_int(src))
        return
    }
    if k == amlns.NK_BUFFIELD {
        buffield_write(state, node, amlobj.to_int(src))
        return
    }
    if k == amlns.NK_NAME {
        let o: u64 = amlobj.obj_new(state)
        if o == 0 {
            return
        }
        amlobj.ocopy(o, src)
        persist(state)
        amlns.set_b(state, node, o)
        return
    }
    amlns.err_set(state, amlns.ERR_TYPE)
}

// ------------------------------------------------------- reading a target
//
// A target is NOT a value: `Store(Zero, Local0)` wants the SLOT of
// Local0, not its contents. That is why there is this second version of
// `ev`, and why it delivers references.
fn ev_target(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    if !step(state) {
        return 0
    }
    let c: u64 = amlns.rd8(p)
    if c == 0x00 {
        // NullName -- "the result does not matter"
        amlobj.oset(dst, amlobj.OT_NONE, 0, 0)
        return p + 1
    }
    if c >= 0x60 && c <= 0x67 {
        seen_mark(state, c)
        amlobj.oset(dst, amlobj.OT_REF_SLOT, frame_local(f, c -% 0x60), 0)
        return p + 1
    }
    if c >= 0x68 && c <= 0x6E {
        seen_mark(state, c)
        amlobj.oset(dst, amlobj.OT_REF_SLOT, frame_arg(f, c -% 0x68), 0)
        return p + 1
    }
    if c == 0x5B && amlns.rd8(p + 1) == 0x31 {
        seen_ext_mark(state, 0x31)
        amlobj.oset(dst, amlobj.OT_DEBUG, 0, 0)
        return p + 2
    }
    // Index, DerefOf, RefOf may also appear as a target.
    if c == 0x88 || c == 0x83 || c == 0x71 {
        return ev(state, f, p, dst)
    }
    // Otherwise: a name. The SLOT, not the value.
    if c == 0x5C || c == 0x5E || c == 0x2E || c == 0x2F || c == 0x5F
        || (c >= 0x41 && c <= 0x5A) {
        var out: [u64; 1] = [0 as u64; 1]
        let node: u64 = amlns.walk(state, frame_scope(f), p, (&out[0]) as u64)
        amlobj.oset(dst, amlobj.OT_REF_NODE, node, 0)
        if node == amlns.NONE {
            amlns.err_set(state, amlns.ERR_NOTFOUND)
        }
        return out[0]
    }
    bad_op(state, f, c)
    return 0
}

// Read a target and write into it at once. That is the third argument of
// almost every arithmetic instruction (`Add(a, b, TARGET)`).
fn ev_store_target(state: u64, f: u64, p: u64, val: u64) -> u64 {
    var t: [u64; 3] = [0 as u64; 3]
    let q: u64 = ev_target(state, f, p, (&t[0]) as u64)
    if q == 0 {
        return 0
    }
    store_into(state, val, (&t[0]) as u64)
    return q
}

// --------------------------------------------------- fetching two numbers

// Reads two TermArgs and puts them as numbers into a and b.
fn two_ints(state: u64, f: u64, p: u64, a: u64, b: u64) -> u64 {
    var x: [u64; 3] = [0 as u64; 3]
    var y: [u64; 3] = [0 as u64; 3]
    var q: u64 = ev(state, f, p, (&x[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&x[0]) as u64)
    q = ev(state, f, q, (&y[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&y[0]) as u64)
    amlns.wr64(a, amlobj.to_int((&x[0]) as u64))
    amlns.wr64(b, amlobj.to_int((&y[0]) as u64))
    return q
}

// AML calculates modulo 2^64 and shifting by 64 or more gives zero. Both
// are stated ONCE here, so that they are not wrong in twelve places.
fn shl(v: u64, n: u64) -> u64 {
    if n >= 64 {
        return 0
    }
    return v << n
}

fn shr(v: u64, n: u64) -> u64 {
    if n >= 64 {
        return 0
    }
    return v >> n
}

// --------------------------------------------------- the evaluator

// Evaluates ONE term from `p` on and puts the result into `dst`.
// Returns: the position behind it, or 0 on an error.
fn ev(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    if !step(state) {
        return 0
    }
    if !enter(state) {
        return 0
    }
    let r: u64 = ev_inner(state, f, p, dst)
    leave(state)
    return r
}

fn ev_inner(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    let c: u64 = amlns.rd8(p)
    amlobj.oset(dst, amlobj.OT_NONE, 0, 0)

    // ------------------------------------------------ constants
    if c == 0x00 {
        seen_mark(state, c)
        amlobj.oint(dst, 0)
        return p + 1
    }
    if c == 0x01 {
        seen_mark(state, c)
        amlobj.oint(dst, 1)
        return p + 1
    }
    if c == 0xFF {
        seen_mark(state, c)
        amlobj.oint(dst, 0xFFFFFFFFFFFFFFFF)
        return p + 1
    }
    if c == 0x0A {
        seen_mark(state, c)
        amlobj.oint(dst, amlns.rd8(p + 1))
        return p + 2
    }
    if c == 0x0B {
        seen_mark(state, c)
        amlobj.oint(dst, amlns.rd16(p + 1))
        return p + 3
    }
    if c == 0x0C {
        seen_mark(state, c)
        amlobj.oint(dst, amlns.rd32(p + 1))
        return p + 5
    }
    if c == 0x0E {
        seen_mark(state, c)
        amlobj.oint(dst, amlns.rd64(p + 1))
        return p + 9
    }
    if c == 0x0D { // string
        seen_mark(state, c)
        var n: u64 = 0
        while amlns.rd8(p + 1 + n) != 0 {
            n = n + 1
        }
        amlobj.oset(dst, amlobj.OT_STR, p + 1, n)
        return p + 2 + n
    }

    // ------------------------------------------------ Arg and Local
    if c >= 0x60 && c <= 0x67 {
        seen_mark(state, c)
        amlobj.ocopy(dst, frame_local(f, c -% 0x60))
        return p + 1
    }
    if c >= 0x68 && c <= 0x6E {
        seen_mark(state, c)
        amlobj.ocopy(dst, frame_arg(f, c -% 0x68))
        return p + 1
    }

    // ------------------------------------------------ buffer and package
    if c == 0x11 {
        return ev_buffer(state, f, p, dst)
    }
    if c == 0x12 || c == 0x13 {
        return ev_package(state, f, p, dst)
    }

    // ------------------------------------------------ control flow
    if c == 0xA0 {
        return ev_if(state, f, p)
    }
    if c == 0xA1 { // Else without a preceding If: skip
        seen_mark(state, c)
        return skip_pkg(p)
    }
    if c == 0xA2 {
        return ev_while(state, f, p)
    }
    if c == 0xA4 { // Return
        seen_mark(state, c)
        let q: u64 = ev(state, f, p + 1, frame_ret(f))
        if q == 0 {
            return 0
        }
        deref(state, frame_ret(f))
        frame_ctl_set(f, C_RETURN)
        return q
    }
    if c == 0xA5 { // Break
        seen_mark(state, c)
        frame_ctl_set(f, C_BREAK)
        return p + 1
    }
    if c == 0x9F { // Continue
        seen_mark(state, c)
        frame_ctl_set(f, C_CONTINUE)
        return p + 1
    }
    if c == 0xA3 { // Noop
        seen_mark(state, c)
        return p + 1
    }
    if c == 0xCC { // BreakPoint -- the same as Noop for us
        seen_mark(state, c)
        return p + 1
    }

    // ------------------------------------------------ Store
    if c == 0x70 || c == 0x9D {
        return ev_store(state, f, p, dst, c)
    }

    // ------------------------------------------------ arithmetic
    if c == 0x72 || c == 0x74 || c == 0x77 || c == 0x79 || c == 0x7A
        || c == 0x7B || c == 0x7C || c == 0x7D || c == 0x7E || c == 0x7F
        || c == 0x85 {
        return ev_binary(state, f, p, dst, c)
    }
    if c == 0x78 {
        return ev_divide(state, f, p, dst)
    }
    if c == 0x80 || c == 0x81 || c == 0x82 { // Not, FindSetLeft/RightBit
        return ev_unary(state, f, p, dst, c)
    }
    if c == 0x75 || c == 0x76 { // Increment, Decrement
        return ev_incdec(state, f, p, dst, c)
    }

    // ------------------------------------------------ comparing
    if c == 0x90 || c == 0x91 || c == 0x93 || c == 0x94 || c == 0x95 {
        return ev_compare(state, f, p, dst, c, 0)
    }
    if c == 0x92 {
        let nx: u64 = amlns.rd8(p + 1)
        if nx == 0x93 || nx == 0x94 || nx == 0x95 {
            seen_mark(state, c)
            return ev_compare(state, f, p + 1, dst, nx, 1)
        }
        seen_mark(state, c)
        return ev_lnot(state, f, p, dst)
    }

    // ------------------------------------------------ references
    if c == 0x88 {
        return ev_index(state, f, p, dst)
    }
    if c == 0x83 { // DerefOf
        seen_mark(state, c)
        let q: u64 = ev(state, f, p + 1, dst)
        if q == 0 {
            return 0
        }
        deref(state, dst)
        return q
    }
    if c == 0x71 { // RefOf
        seen_mark(state, c)
        return ev_target(state, f, p + 1, dst)
    }
    if c == 0x87 || c == 0x8E { // SizeOf, ObjectType
        return ev_sizeof(state, f, p, dst, c)
    }

    // ------------------------------------------------ converting
    if c == 0x96 || c == 0x99 || c == 0x97 || c == 0x98 {
        return ev_convert(state, f, p, dst, c)
    }

    // ------------------------------------------------ creating names
    if c == 0x08 {
        return ev_name(state, f, p)
    }
    if c == 0x8A || c == 0x8B || c == 0x8C || c == 0x8D || c == 0x8F {
        return ev_createfield(state, f, p, c)
    }

    // ------------------------------------------------ Notify
    if c == 0x86 {
        seen_mark(state, c)
        return ev_notify(state, f, p)
    }

    // ------------------------------------------------ extended opcodes
    if c == 0x5B {
        return ev_ext(state, f, p, dst)
    }

    if c == 0x73 || c == 0x84 {
        return ev_concat(state, f, p, dst, c)
    }
    if c == 0x89 {
        return ev_match(state, f, p, dst)
    }
    if c == 0x9C {
        return ev_tostring(state, f, p, dst)
    }
    if c == 0x9E {
        return ev_mid(state, f, p, dst)
    }

    // ------------------------------------------------ a name
    if c == 0x5C || c == 0x5E || c == 0x2E || c == 0x2F || c == 0x5F
        || (c >= 0x41 && c <= 0x5A) {
        return ev_namestring(state, f, p, dst)
    }

    bad_op(state, f, c)
    return 0
}

// ================================================================
// THE BRANCHES THAT NEED TEMPORARY SLOTS, AS FUNCTIONS OF THEIR OWN
// ================================================================
//
// WHY THEY ARE NOT IN `ev_inner`, where they would belong. Firn
// allocates the temporary slots of ALL branches of a function in ONE
// frame, whichever branch is taken. `ev_inner` with a dozen slots of 24
// bytes each thereby cost about 1600 bytes of kernel stack PER NESTING
// LEVEL -- measured with the stack guard above: 52064 bytes at 48
// levels, with a kernel stack of 65536. That is no theoretical problem:
// the recursion test `amldeep` really overwrote the stack, and the error
// message that should have said so was no longer there afterwards.
//
// Split up, a level costs only the small frame of `ev_inner` plus the ONE
// branch that is really taken.

fn skip_pkg(p: u64) -> u64 {
    var out: [u64; 1] = [0 as u64; 1]
    let ln: u64 = amlns.pkglen(p + 1, (&out[0]) as u64)
    return p + 1 + ln
}

fn ev_store(state: u64, f: u64, p: u64, dst: u64, c: u64) -> u64 {
    seen_mark(state, c)
    var v: [u64; 3] = [0 as u64; 3]
    var q: u64 = ev(state, f, p + 1, (&v[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&v[0]) as u64)
    q = ev_store_target(state, f, q, (&v[0]) as u64)
    if q == 0 {
        return 0
    }
    amlobj.ocopy(dst, (&v[0]) as u64)
    return q
}

fn ev_unary(state: u64, f: u64, p: u64, dst: u64, c: u64) -> u64 {
    seen_mark(state, c)
    var x: [u64; 3] = [0 as u64; 3]
    let q: u64 = ev(state, f, p + 1, (&x[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&x[0]) as u64)
    let v: u64 = amlobj.to_int((&x[0]) as u64)
    var r: u64 = 0
    if c == 0x80 {
        r = ~v
    }
    if c == 0x81 {
        var i: u64 = 64
        while i > 0 {
            if (v & shl(1, i -% 1)) != 0 {
                r = i
                break
            }
            i = i -% 1
        }
    }
    if c == 0x82 {
        var i: u64 = 0
        while i < 64 {
            if (v & shl(1, i)) != 0 {
                r = i + 1
                break
            }
            i = i + 1
        }
    }
    amlobj.oint(dst, r)
    return ev_store_target(state, f, q, dst)
}

fn ev_incdec(state: u64, f: u64, p: u64, dst: u64, c: u64) -> u64 {
    seen_mark(state, c)
    var t: [u64; 3] = [0 as u64; 3]
    var v: [u64; 3] = [0 as u64; 3]
    let q: u64 = ev_target(state, f, p + 1, (&t[0]) as u64)
    if q == 0 {
        return 0
    }
    amlobj.ocopy((&v[0]) as u64, (&t[0]) as u64)
    deref(state, (&v[0]) as u64)
    var n: u64 = amlobj.to_int((&v[0]) as u64)
    if c == 0x75 {
        n = n +% 1
    } else {
        n = n -% 1
    }
    amlobj.oint(dst, n)
    store_into(state, dst, (&t[0]) as u64)
    return q
}

fn ev_lnot(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    var x: [u64; 3] = [0 as u64; 3]
    let q: u64 = ev(state, f, p + 1, (&x[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&x[0]) as u64)
    if amlobj.truth((&x[0]) as u64) {
        amlobj.oint(dst, 0)
    } else {
        amlobj.oint(dst, 0xFFFFFFFFFFFFFFFF)
    }
    return q
}

fn ev_sizeof(state: u64, f: u64, p: u64, dst: u64, c: u64) -> u64 {
    seen_mark(state, c)
    var x: [u64; 3] = [0 as u64; 3]
    let q: u64 = ev(state, f, p + 1, (&x[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&x[0]) as u64)
    if c == 0x87 {
        amlobj.oint(dst, amlobj.ov2((&x[0]) as u64))
    } else {
        amlobj.oint(dst, amlobj.otype((&x[0]) as u64))
    }
    return q
}

// ROUND ACPI-EVENTS: the ring of the messages.
//
// `not_clear` BEFORE executing a GPE method, afterwards `not_count` and
// `not_node`/`not_code` per entry -- that is how the kernel learns what
// the firmware has reported.

fn not_clear(state: u64) {
    s(state, A_NOTN, 0)
}

fn not_count(state: u64) -> u64 {
    var n: u64 = g(state, A_NOTN)
    if n > NOT_MAX {
        n = NOT_MAX
    }
    return n
}

fn not_node(state: u64, i: u64) -> u64 {
    if i >= NOT_MAX {
        return amlns.NONE
    }
    return g(state, A_NOTR + i * 16)
}

fn not_code(state: u64, i: u64) -> u64 {
    if i >= NOT_MAX {
        return 0
    }
    return g(state, A_NOTR + i * 16 + 8)
}

fn ev_notify(state: u64, f: u64, p: u64) -> u64 {
    var a: [u64; 3] = [0 as u64; 3]
    var b: [u64; 3] = [0 as u64; 3]
    var q: u64 = ev_target(state, f, p + 1, (&a[0]) as u64)
    if q == 0 {
        return 0
    }
    q = ev(state, f, q, (&b[0]) as u64)
    if q == 0 {
        return 0
    }
    s(state, A_NOTIFY, g(state, A_NOTIFY) + 1)

    // WHICH device and WHICH code. The first argument is a reference to a
    // node (`Notify(\_SB.LID0, 0x80)`); if something else stands there, the
    // entry is stored with NONE and the code is remembered anyway -- a
    // message that the kernel cannot attribute is still a message.
    var node: u64 = amlns.NONE
    if amlobj.otype((&a[0]) as u64) == amlobj.OT_REF_NODE {
        node = amlobj.ov1((&a[0]) as u64)
    }
    deref(state, (&b[0]) as u64)
    let code: u64 = amlobj.to_int((&b[0]) as u64)
    let n: u64 = g(state, A_NOTN)
    if n < NOT_MAX {
        s(state, A_NOTR + n * 16, node)
        s(state, A_NOTR + n * 16 + 8, code)
    }
    // KEEP COUNTING EVEN IF THE RING IS FULL. `not_count` caps when reading;
    // so `A_NOTN` holds the TRUE number and an overflow shows up in the
    // acceptance run instead of silently disappearing.
    s(state, A_NOTN, n + 1)
    return q
}

// --------------------------------------------------------- the parts

fn ev_buffer(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    seen_mark(state, 0x11)
    var out: [u64; 1] = [0 as u64; 1]
    let ln: u64 = amlns.pkglen(p + 1, (&out[0]) as u64)
    let end: u64 = p + 1 + ln
    var sz: [u64; 3] = [0 as u64; 3]
    let j: u64 = ev(state, f, out[0], (&sz[0]) as u64)
    if j == 0 {
        return 0
    }
    deref(state, (&sz[0]) as u64)
    var want: u64 = amlobj.to_int((&sz[0]) as u64)
    let have: u64 = end -% j
    if want < have {
        want = have
    }
    if want > 0x10000 {
        amlns.err_set(state, amlns.ERR_TYPE)
        return 0
    }
    let o: u64 = amlobj.obj_buf(state, want)
    if o == 0 {
        return 0
    }
    var i: u64 = 0
    while i < have {
        amlns.wr8(amlobj.ov1(o) + i, amlns.rd8(j + i))
        i = i + 1
    }
    amlobj.ocopy(dst, o)
    return end
}

fn ev_package(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    let c: u64 = amlns.rd8(p)
    seen_mark(state, c)
    var out: [u64; 1] = [0 as u64; 1]
    let ln: u64 = amlns.pkglen(p + 1, (&out[0]) as u64)
    let end: u64 = p + 1 + ln
    var j: u64 = out[0]
    var n: u64 = 0
    if c == 0x12 {
        n = amlns.rd8(j)
        j = j + 1
    } else {
        var sz: [u64; 3] = [0 as u64; 3]
        j = ev(state, f, j, (&sz[0]) as u64)
        if j == 0 {
            return 0
        }
        deref(state, (&sz[0]) as u64)
        n = amlobj.to_int((&sz[0]) as u64)
    }
    if n > 512 {
        amlns.err_set(state, amlns.ERR_TYPE)
        return 0
    }
    let o: u64 = amlobj.obj_pkg(state, n)
    if o == 0 {
        return 0
    }
    var i: u64 = 0
    while j < end && i < n {
        j = ev(state, f, j, amlobj.pkg_at(o, i))
        if j == 0 {
            return 0
        }
        i = i + 1
    }
    amlobj.ocopy(dst, o)
    return end
}

fn ev_if(state: u64, f: u64, p: u64) -> u64 {
    seen_mark(state, 0xA0)
    var out: [u64; 1] = [0 as u64; 1]
    let ln: u64 = amlns.pkglen(p + 1, (&out[0]) as u64)
    let end: u64 = p + 1 + ln
    var pr: [u64; 3] = [0 as u64; 3]
    let j: u64 = ev(state, f, out[0], (&pr[0]) as u64)
    if j == 0 {
        return 0
    }
    deref(state, (&pr[0]) as u64)
    if amlobj.truth((&pr[0]) as u64) {
        s(state, A_LASTIF, 1)
        exec_list(state, f, j, end)
    } else {
        s(state, A_LASTIF, 0)
    }
    return end
}

fn ev_while(state: u64, f: u64, p: u64) -> u64 {
    seen_mark(state, 0xA2)
    var out: [u64; 1] = [0 as u64; 1]
    let ln: u64 = amlns.pkglen(p + 1, (&out[0]) as u64)
    let end: u64 = p + 1 + ln
    let pred: u64 = out[0]
    while true {
        if bad(state) {
            break
        }
        var pr: [u64; 3] = [0 as u64; 3]
        let j: u64 = ev(state, f, pred, (&pr[0]) as u64)
        if j == 0 {
            break
        }
        deref(state, (&pr[0]) as u64)
        if !amlobj.truth((&pr[0]) as u64) {
            break
        }
        exec_list(state, f, j, end)
        let ctl: u64 = frame_ctl(f)
        if ctl == C_RETURN {
            break
        }
        if ctl == C_BREAK {
            frame_ctl_set(f, C_NONE)
            break
        }
        if ctl == C_CONTINUE {
            frame_ctl_set(f, C_NONE)
        }
    }
    return end
}

fn ev_binary(state: u64, f: u64, p: u64, dst: u64, c: u64) -> u64 {
    seen_mark(state, c)
    var a: [u64; 1] = [0 as u64; 1]
    var b: [u64; 1] = [0 as u64; 1]
    let q: u64 = two_ints(state, f, p + 1, (&a[0]) as u64, (&b[0]) as u64)
    if q == 0 {
        return 0
    }
    var r: u64 = 0
    if c == 0x72 {
        r = a[0] +% b[0]
    }
    if c == 0x74 {
        r = a[0] -% b[0]
    }
    if c == 0x77 {
        r = a[0] *% b[0]
    }
    if c == 0x79 {
        r = shl(a[0], b[0])
    }
    if c == 0x7A {
        r = shr(a[0], b[0])
    }
    if c == 0x7B {
        r = a[0] & b[0]
    }
    if c == 0x7C {
        r = ~(a[0] & b[0])
    }
    if c == 0x7D {
        r = a[0] | b[0]
    }
    if c == 0x7E {
        r = ~(a[0] | b[0])
    }
    if c == 0x7F {
        r = a[0] ^ b[0]
    }
    if c == 0x85 {
        if b[0] == 0 {
            amlns.err_set(state, amlns.ERR_DIV0)
            return 0
        }
        r = a[0] % b[0]
    }
    amlobj.oint(dst, r)
    return ev_store_target(state, f, q, dst)
}

fn ev_divide(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    seen_mark(state, 0x78)
    var a: [u64; 1] = [0 as u64; 1]
    var b: [u64; 1] = [0 as u64; 1]
    var q: u64 = two_ints(state, f, p + 1, (&a[0]) as u64, (&b[0]) as u64)
    if q == 0 {
        return 0
    }
    if b[0] == 0 {
        amlns.err_set(state, amlns.ERR_DIV0)
        return 0
    }
    var rest: [u64; 3] = [0 as u64; 3]
    amlobj.oint((&rest[0]) as u64, a[0] % b[0])
    q = ev_store_target(state, f, q, (&rest[0]) as u64)
    if q == 0 {
        return 0
    }
    amlobj.oint(dst, a[0] / b[0])
    return ev_store_target(state, f, q, dst)
}

fn ev_compare(state: u64, f: u64, p: u64, dst: u64, c: u64,
    negate: u64) -> u64 {
    seen_mark(state, c)
    var x: [u64; 3] = [0 as u64; 3]
    var y: [u64; 3] = [0 as u64; 3]
    var q: u64 = ev(state, f, p + 1, (&x[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&x[0]) as u64)
    q = ev(state, f, q, (&y[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&y[0]) as u64)
    var r: bool = false
    if c == 0x90 {
        r = amlobj.truth((&x[0]) as u64) && amlobj.truth((&y[0]) as u64)
    } else {
        if c == 0x91 {
            r = amlobj.truth((&x[0]) as u64) || amlobj.truth((&y[0]) as u64)
        } else {
            let t: u64 = amlobj.otype((&x[0]) as u64)
            if t == amlobj.OT_STR || t == amlobj.OT_BUF {
                let ord: u64 = amlstr.order((&x[0]) as u64, (&y[0]) as u64)
                r = (c == 0x93 && ord == amlstr.ORDER_EQUAL) || (c == 0x94 && ord == amlstr.ORDER_GREATER)
                    || (c == 0x95 && ord == amlstr.ORDER_LESS)
            } else {
                let a: u64 = amlobj.to_int((&x[0]) as u64)
                let b: u64 = amlobj.to_int((&y[0]) as u64)
                if c == 0x93 {
                    r = a == b
                }
                if c == 0x94 {
                    r = a > b
                }
                if c == 0x95 {
                    r = a < b
                }
            }
        }
    }
    if negate != 0 {
        r = !r
    }
    if r {
        amlobj.oint(dst, 0xFFFFFFFFFFFFFFFF)
    } else {
        amlobj.oint(dst, 0)
    }
    return q
}

fn ev_index(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    seen_mark(state, 0x88)
    var src: [u64; 3] = [0 as u64; 3]
    var idx: [u64; 3] = [0 as u64; 3]
    var q: u64 = ev(state, f, p + 1, (&src[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&src[0]) as u64)
    q = ev(state, f, q, (&idx[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&idx[0]) as u64)
    let i: u64 = amlobj.to_int((&idx[0]) as u64)
    let t: u64 = amlobj.otype((&src[0]) as u64)
    if t == amlobj.OT_PKG {
        if i >= amlobj.ov2((&src[0]) as u64) {
            amlns.err_set(state, amlns.ERR_TYPE)
            return 0
        }
        amlobj.oset(dst, amlobj.OT_REF_SLOT,
            amlobj.pkg_at((&src[0]) as u64, i), 0)
    } else {
        if t == amlobj.OT_BUF || t == amlobj.OT_STR {
            if i >= amlobj.ov2((&src[0]) as u64) {
                amlns.err_set(state, amlns.ERR_TYPE)
                return 0
            }
            amlobj.oset(dst, amlobj.OT_REF_BYTE,
                amlobj.ov1((&src[0]) as u64) + i, 0)
        } else {
            amlns.err_set(state, amlns.ERR_TYPE)
            return 0
        }
    }
    return ev_store_target(state, f, q, dst)
}

fn ev_convert(state: u64, f: u64, p: u64, dst: u64, c: u64) -> u64 {
    seen_mark(state, c)
    var x: [u64; 3] = [0 as u64; 3]
    let q: u64 = ev(state, f, p + 1, (&x[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&x[0]) as u64)
    if c == 0x99 { // ToInteger
        amlobj.oint(dst, amlstr.str_to_int((&x[0]) as u64))
        return ev_store_target(state, f, q, dst)
    }
    if c == 0x96 { // ToBuffer
        if amlobj.otype((&x[0]) as u64) == amlobj.OT_INT {
            let o: u64 = amlobj.obj_buf(state, 8)
            if o == 0 {
                return 0
            }
            let v: u64 = amlobj.ov1((&x[0]) as u64)
            var i: u64 = 0
            while i < 8 {
                amlns.wr8(amlobj.ov1(o) + i, shr(v, i * 8) & 0xFF)
                i = i + 1
            }
            amlobj.ocopy(dst, o)
        } else {
            amlobj.ocopy(dst, (&x[0]) as u64)
        }
        return ev_store_target(state, f, q, dst)
    }
    // ToHexString and ToDecimalString: a string on the heap.
    let v: u64 = amlobj.to_int((&x[0]) as u64)
    let o: u64 = amlobj.obj_buf(state, 24)
    if o == 0 {
        return 0
    }
    let at: u64 = amlobj.ov1(o)
    var n: u64 = 0
    if c == 0x98 {
        var i: u64 = 16
        var lead: u64 = 1
        while i > 0 {
            let d: u64 = shr(v, (i -% 1) * 4) & 0xF
            if d != 0 || lead == 0 || i == 1 {
                lead = 0
                if d < 10 {
                    amlns.wr8(at + n, 48 + d)
                } else {
                    amlns.wr8(at + n, 55 + d)
                }
                n = n + 1
            }
            i = i -% 1
        }
    } else {
        var div: u64 = 10000000000000000000
        var lead: u64 = 1
        while div > 0 {
            let d: u64 = (v / div) % 10
            if d != 0 || lead == 0 || div == 1 {
                lead = 0
                amlns.wr8(at + n, 48 + d)
                n = n + 1
            }
            div = div / 10
        }
    }
    amlobj.oset(dst, amlobj.OT_STR, at, n)
    return ev_store_target(state, f, q, dst)
}

// `Name(X, value)` IN THE MIDDLE OF A METHOD. That really exists: QEMU's
// `IQCR` creates a fresh buffer `PRR0` on every call and returns it. So
// the node is created (or reused) and its value is calculated AGAIN
// EVERY TIME.
fn ev_name(state: u64, f: u64, p: u64) -> u64 {
    seen_mark(state, 0x08)
    var out: [u64; 1] = [0 as u64; 1]
    let node: u64 = amlns.walk_create(state, frame_scope(f), p + 1,
        (&out[0]) as u64, amlns.NK_NAME, amlns.NMAX)
    if node == amlns.NONE {
        return 0
    }
    amlns.set_kind(state, node, amlns.NK_NAME)
    amlns.set_a(state, node, out[0])
    let o: u64 = amlobj.obj_new(state)
    if o == 0 {
        return 0
    }
    let q: u64 = ev(state, f, out[0], o)
    if q == 0 {
        return 0
    }
    persist(state)
    amlns.set_b(state, node, o)
    return q
}

// CreateByteField/WordField/DWordField/QWordField/BitField.
fn ev_createfield(state: u64, f: u64, p: u64, c: u64) -> u64 {
    seen_mark(state, c)
    var src: [u64; 3] = [0 as u64; 3]
    var idx: [u64; 3] = [0 as u64; 3]
    var q: u64 = ev(state, f, p + 1, (&src[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&src[0]) as u64)
    q = ev(state, f, q, (&idx[0]) as u64)
    if q == 0 {
        return 0
    }
    deref(state, (&idx[0]) as u64)
    if amlobj.otype((&src[0]) as u64) != amlobj.OT_BUF {
        amlns.err_set(state, amlns.ERR_TYPE)
        return 0
    }
    // The buffer object must survive the call -- so a copy of the OBJECT on
    // the heap (not of the data: those are to stay the same, otherwise the
    // field writes into a different buffer than the one the method returns).
    let keep: u64 = amlobj.obj_new(state)
    if keep == 0 {
        return 0
    }
    amlobj.ocopy(keep, (&src[0]) as u64)
    var bit: u64 = amlobj.to_int((&idx[0]) as u64)
    var width: u64 = 8
    if c == 0x8B {
        width = 16
    }
    if c == 0x8A {
        width = 32
    }
    if c == 0x8F {
        width = 64
    }
    if c == 0x8D {
        width = 1
    }
    if c != 0x8D {
        bit = bit * 8 // for all except CreateBitField it is a byte offset
    }
    var out: [u64; 1] = [0 as u64; 1]
    let node: u64 = amlns.walk_create(state, frame_scope(f), q,
        (&out[0]) as u64, amlns.NK_BUFFIELD, amlns.NMAX)
    if node == amlns.NONE {
        return 0
    }
    persist(state)
    amlns.set_kind(state, node, amlns.NK_BUFFIELD)
    amlns.set_a(state, node, keep)
    amlns.set_b(state, node, bit)
    amlns.set_c(state, node, width)
    return out[0]
}

fn ev_ext(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    let e: u64 = amlns.rd8(p + 1)
    seen_ext_mark(state, e)
    if e == 0x31 { // Debug
        amlobj.oset(dst, amlobj.OT_DEBUG, 0, 0)
        return p + 2
    }
    if e == 0x30 { // Revision
        amlobj.oint(dst, 2)
        return p + 2
    }
    if e == 0x33 {
        amlobj.oint(dst, amlsys.timer_100ns(state))
        return p + 2
    }
    if e == 0x23 { // Acquire: one interpreter, one thread -> always at once
        var t: [u64; 3] = [0 as u64; 3]
        let q: u64 = ev_target(state, f, p + 2, (&t[0]) as u64)
        if q == 0 {
            return 0
        }
        amlobj.oint(dst, 0)
        return q + 2 // the two bytes of time limit
    }
    if e == 0x27 {
        var t: [u64; 3] = [0 as u64; 3]
        return ev_target(state, f, p + 2, (&t[0]) as u64)
    }
    if e == 0x24 || e == 0x26 {
        return ev_event_op(state, f, p, e)
    }
    if e == 0x25 {
        return ev_wait(state, f, p, dst)
    }
    if e == 0x21 {
        return ev_stall(state, f, p)
    }
    if e == 0x22 {
        var t: [u64; 3] = [0 as u64; 3]
        return ev(state, f, p + 2, (&t[0]) as u64)
    }
    if e == 0x28 || e == 0x29 {
        return ev_bcd(state, f, p, dst, e)
    }
    if e == 0x32 {
        return ev_fatal(state, f, p)
    }
    if e == 0x80 {
        return ev_opregion(state, f, p)
    }
    if e == 0x81 {
        return ev_field(state, f, p)
    }
    if e == 0x12 { // CondRefOf
        var t: [u64; 3] = [0 as u64; 3]
        var q: u64 = ev_target(state, f, p + 2, (&t[0]) as u64)
        if q == 0 {
            return 0
        }
        var ok: u64 = 0
        if amlobj.otype((&t[0]) as u64) == amlobj.OT_REF_NODE {
            if amlobj.ov1((&t[0]) as u64) != amlns.NONE {
                ok = 1
            }
        }
        if ok == 0 {
            // The name does not exist -- with CondRefOf that is NOT an error.
            kstate.set(state, kstate.AML_OFF + 40, amlns.ERR_OK)
        }
        q = ev_store_target(state, f, q, (&t[0]) as u64)
        if ok != 0 {
            amlobj.oint(dst, 0xFFFFFFFFFFFFFFFF)
        } else {
            amlobj.oint(dst, 0)
        }
        return q
    }
    if e == 0x13 { // CreateField(source, bit, length, name)
        var src: [u64; 3] = [0 as u64; 3]
        var bit: [u64; 3] = [0 as u64; 3]
        var len: [u64; 3] = [0 as u64; 3]
        var q: u64 = ev(state, f, p + 2, (&src[0]) as u64)
        if q == 0 {
            return 0
        }
        deref(state, (&src[0]) as u64)
        q = ev(state, f, q, (&bit[0]) as u64)
        if q == 0 {
            return 0
        }
        deref(state, (&bit[0]) as u64)
        q = ev(state, f, q, (&len[0]) as u64)
        if q == 0 {
            return 0
        }
        deref(state, (&len[0]) as u64)
        let keep: u64 = amlobj.obj_new(state)
        if keep == 0 {
            return 0
        }
        amlobj.ocopy(keep, (&src[0]) as u64)
        var out: [u64; 1] = [0 as u64; 1]
        let node: u64 = amlns.walk_create(state, frame_scope(f), q,
            (&out[0]) as u64, amlns.NK_BUFFIELD, amlns.NMAX)
        if node == amlns.NONE {
            return 0
        }
        persist(state)
        amlns.set_kind(state, node, amlns.NK_BUFFIELD)
        amlns.set_a(state, node, keep)
        amlns.set_b(state, node, amlobj.to_int((&bit[0]) as u64))
        amlns.set_c(state, node, amlobj.to_int((&len[0]) as u64))
        return out[0]
    }
    // Load, Unload, LoadTable and the other extended opcodes: not supported.
    // A defined error is better than a number that nobody can recalculate.
    bad_op(state, f, 0x5B00 | e)
    return 0
}

fn ev_term_value(state: u64, f: u64, p: u64, out: u64) -> u64 {
    let q: u64 = ev(state, f, p, out)
    if q == 0 {
        return 0
    }
    deref(state, out)
    return q
}

fn ev_concat(state: u64, f: u64, p: u64, dst: u64, c: u64) -> u64 {
    seen_mark(state, c)
    var a: [u64; 3] = [0 as u64; 3]
    var b: [u64; 3] = [0 as u64; 3]
    var q: u64 = ev_term_value(state, f, p + 1, (&a[0]) as u64)
    if q == 0 {
        return 0
    }
    q = ev_term_value(state, f, q, (&b[0]) as u64)
    if q == 0 {
        return 0
    }
    var ok: bool = false
    if c == 0x73 {
        ok = amlstr.concat(state, (&a[0]) as u64, (&b[0]) as u64, dst)
    } else {
        ok = amlstr.concat_res(state, (&a[0]) as u64, (&b[0]) as u64, dst)
    }
    if !ok {
        return 0
    }
    return ev_store_target(state, f, q, dst)
}

fn ev_match(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    seen_mark(state, 0x89)
    var pkg: [u64; 3] = [0 as u64; 3]
    var v1: [u64; 3] = [0 as u64; 3]
    var v2: [u64; 3] = [0 as u64; 3]
    var st: [u64; 3] = [0 as u64; 3]
    var q: u64 = ev_term_value(state, f, p + 1, (&pkg[0]) as u64)
    if q == 0 {
        return 0
    }
    let op1: u64 = amlns.rd8(q)
    q = ev_term_value(state, f, q + 1, (&v1[0]) as u64)
    if q == 0 {
        return 0
    }
    let op2: u64 = amlns.rd8(q)
    q = ev_term_value(state, f, q + 1, (&v2[0]) as u64)
    if q == 0 {
        return 0
    }
    q = ev_term_value(state, f, q, (&st[0]) as u64)
    if q == 0 {
        return 0
    }
    amlobj.oint(dst, amlstr.match_find((&pkg[0]) as u64, op1, amlobj.to_int((&v1[0]) as u64),
        op2, amlobj.to_int((&v2[0]) as u64), amlobj.to_int((&st[0]) as u64)))
    return q
}

fn ev_tostring(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    seen_mark(state, 0x9C)
    var src: [u64; 3] = [0 as u64; 3]
    var len: [u64; 3] = [0 as u64; 3]
    var q: u64 = ev_term_value(state, f, p + 1, (&src[0]) as u64)
    if q == 0 {
        return 0
    }
    q = ev_term_value(state, f, q, (&len[0]) as u64)
    if q == 0 {
        return 0
    }
    if !amlstr.to_string(state, (&src[0]) as u64, amlobj.to_int((&len[0]) as u64), dst) {
        return 0
    }
    return ev_store_target(state, f, q, dst)
}

fn ev_mid(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    seen_mark(state, 0x9E)
    var src: [u64; 3] = [0 as u64; 3]
    var idx: [u64; 3] = [0 as u64; 3]
    var len: [u64; 3] = [0 as u64; 3]
    var q: u64 = ev_term_value(state, f, p + 1, (&src[0]) as u64)
    if q == 0 {
        return 0
    }
    q = ev_term_value(state, f, q, (&idx[0]) as u64)
    if q == 0 {
        return 0
    }
    q = ev_term_value(state, f, q, (&len[0]) as u64)
    if q == 0 {
        return 0
    }
    if !amlstr.mid(state, (&src[0]) as u64, amlobj.to_int((&idx[0]) as u64),
        amlobj.to_int((&len[0]) as u64), dst) {
        return 0
    }
    return ev_store_target(state, f, q, dst)
}

fn ev_event_op(state: u64, f: u64, p: u64, e: u64) -> u64 {
    var t: [u64; 3] = [0 as u64; 3]
    let q: u64 = ev_target(state, f, p + 2, (&t[0]) as u64)
    if q == 0 {
        return 0
    }
    if amlobj.otype((&t[0]) as u64) == amlobj.OT_REF_NODE {
        if e == 0x24 {
            amlsys.event_signal(state, amlobj.ov1((&t[0]) as u64))
        } else {
            amlsys.event_reset(state, amlobj.ov1((&t[0]) as u64))
        }
    }
    return q
}

fn ev_wait(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    var t: [u64; 3] = [0 as u64; 3]
    var w: [u64; 3] = [0 as u64; 3]
    var q: u64 = ev_target(state, f, p + 2, (&t[0]) as u64)
    if q == 0 {
        return 0
    }
    q = ev_term_value(state, f, q, (&w[0]) as u64)
    if q == 0 {
        return 0
    }
    var node: u64 = amlns.NONE
    if amlobj.otype((&t[0]) as u64) == amlobj.OT_REF_NODE {
        node = amlobj.ov1((&t[0]) as u64)
    }
    amlobj.oint(dst, amlsys.event_wait(state, node))
    return q
}

fn ev_stall(state: u64, f: u64, p: u64) -> u64 {
    var t: [u64; 3] = [0 as u64; 3]
    let q: u64 = ev_term_value(state, f, p + 2, (&t[0]) as u64)
    if q == 0 {
        return 0
    }
    amlsys.stall_us(state, amlobj.to_int((&t[0]) as u64))
    return q
}

fn ev_bcd(state: u64, f: u64, p: u64, dst: u64, e: u64) -> u64 {
    var x: [u64; 3] = [0 as u64; 3]
    let q: u64 = ev_term_value(state, f, p + 2, (&x[0]) as u64)
    if q == 0 {
        return 0
    }
    let v: u64 = amlobj.to_int((&x[0]) as u64)
    if e == 0x29 {
        amlobj.oint(dst, amlstr.to_bcd(v))
    } else {
        amlobj.oint(dst, amlstr.from_bcd(v))
    }
    return ev_store_target(state, f, q, dst)
}

fn ev_fatal(state: u64, f: u64, p: u64) -> u64 {
    var t: [u64; 3] = [0 as u64; 3]
    let q: u64 = ev_term_value(state, f, p + 7, (&t[0]) as u64)
    if q == 0 {
        return 0
    }
    amlns.err_note(state, 0x5B32, frame_scope(f))
    amlns.err_set(state, amlns.ERR_FATAL)
    return q
}

fn ev_opregion(state: u64, f: u64, p: u64) -> u64 {
    var out: [u64; 1] = [0 as u64; 1]
    var base: [u64; 3] = [0 as u64; 3]
    var len: [u64; 3] = [0 as u64; 3]
    let node: u64 = amlns.walk_create(state, frame_scope(f), p + 2, (&out[0]) as u64,
        amlns.NK_REGION, amlns.NMAX)
    if node == amlns.NONE {
        return 0
    }
    let space: u64 = amlns.rd8(out[0])
    var q: u64 = ev_term_value(state, f, out[0] + 1, (&base[0]) as u64)
    if q == 0 {
        return 0
    }
    q = ev_term_value(state, f, q, (&len[0]) as u64)
    if q == 0 {
        return 0
    }
    amlns.set_kind(state, node, amlns.NK_REGION)
    amlns.set_a(state, node, amlobj.to_int((&base[0]) as u64))
    amlns.set_b(state, node, amlobj.to_int((&len[0]) as u64))
    amlns.set_c(state, node, space)
    return q
}

fn ev_field(state: u64, f: u64, p: u64) -> u64 {
    var out: [u64; 1] = [0 as u64; 1]
    let ln: u64 = amlns.pkglen(p + 2, (&out[0]) as u64)
    let end: u64 = p + 2 + ln
    let region: u64 = amlns.walk(state, frame_scope(f), out[0], (&out[0]) as u64)
    if region == amlns.NONE {
        amlns.err_set(state, amlns.ERR_NOTFOUND)
        return 0
    }
    let flags: u64 = amlns.rd8(out[0])
    let _made: u64 = amlfield.create(state, frame_scope(f), region, flags, out[0] + 1, end)
    return end
}

// A name in the expression: either a method call or a value.
fn ev_namestring(state: u64, f: u64, p: u64, dst: u64) -> u64 {
    var out: [u64; 1] = [0 as u64; 1]
    let node: u64 = amlns.walk(state, frame_scope(f), p, (&out[0]) as u64)
    var q: u64 = out[0]
    if node == amlns.NONE {
        amlns.err_set(state, amlns.ERR_NOTFOUND)
        return 0
    }
    if amlns.node_kind(state, node) != amlns.NK_METHOD {
        node_value(state, node, dst)
        return q
    }
    // A call. The number of arguments is in the node -- without it one could
    // not tell where the call ends.
    let argc: u64 = amlns.node_flags(state, node) & 7
    var args: [u64; 21] = [0 as u64; 21] // 7 * 3 words
    var i: u64 = 0
    while i < argc {
        q = ev(state, f, q, (&args[(i * 3) as usize]) as u64)
        if q == 0 {
            return 0
        }
        deref(state, (&args[(i * 3) as usize]) as u64)
        i = i + 1
    }
    call_method(state, node, argc, (&args[0]) as u64, dst)
    return q
}

// -------------------------------------------------------- calling

// Execute a method. `argsrc` points to `argc` object slots.
fn call_method(state: u64, node: u64, argc: u64, argsrc: u64, dst: u64) {
    amlobj.oset(dst, amlobj.OT_NONE, 0, 0)
    let native: u64 = amlns.node_c(state, node)
    if native != 0 {
        amlsys.native(state, native, argc, argsrc, dst)
        return
    }
    let calls: u64 = g(state, A_CALLS)
    if calls >= CALL_MAX {
        amlns.err_set(state, amlns.ERR_DEPTH)
        return
    }
    s(state, A_CALLS, calls + 1)
    // WHERE THE HEAP STOOD BEFORE THIS CALL TOOK ANYTHING.
    // If the method returns a NUMBER and has not created a new name, then
    // everything it has used belongs to it alone -- and the bump pointer may
    // go back. Without that, each of the four hundred calls while evaluating
    // `_PRT` costs a frame of 400 bytes, and the heap is empty after a
    // hundred slots (measured: 196296 instead of 192 KiB, error ERR_HEAP, 103
    // instead of 128 entries in the route table).
    let mark: u64 = amlns.heap_mark(state)
    let nmark: u64 = amlns.nodes(state)
    let pmark: u64 = g(state, A_PERSIST)
    let f: u64 = frame_new(state)
    if f == 0 {
        s(state, A_CALLS, calls)
        return
    }
    frame_scope_set(f, node)
    var i: u64 = 0
    while i < argc && i < 7 {
        amlobj.ocopy(frame_arg(f, i), argsrc + i * amlobj.OBJ_BYTES)
        i = i + 1
    }
    exec_list(state, f, amlns.node_a(state, node), amlns.node_b(state, node))
    if frame_ctl(f) == C_RETURN {
        amlobj.ocopy(dst, frame_ret(f))
    }
    s(state, A_CALLS, calls)
    let t: u64 = amlobj.otype(dst)
    if (t == amlobj.OT_NONE || t == amlobj.OT_INT)
        && amlns.nodes(state) == nmark && g(state, A_PERSIST) == pmark {
        amlns.heap_reset(state, mark)
    }
}

// A sequence of terms. Stops as soon as `Return`, `Break` or `Continue`
// has been seen or an error is set.
fn exec_list(state: u64, f: u64, p: u64, end: u64) {
    var i: u64 = p
    while i < end {
        if bad(state) {
            return
        }
        if frame_ctl(f) != C_NONE {
            return
        }
        var o: [u64; 3] = [0 as u64; 3]
        let c: u64 = amlns.rd8(i)
        var q: u64 = 0
        if c == 0xA0 {
            q = ev(state, f, i, (&o[0]) as u64)
            // An `Else` immediately behind belongs to this `If`.
            if q != 0 && q < end {
                if amlns.rd8(q) == 0xA1 {
                    seen_mark(state, 0xA1)
                    var out: [u64; 1] = [0 as u64; 1]
                    let ln: u64 = amlns.pkglen(q + 1, (&out[0]) as u64)
                    let eend: u64 = q + 1 + ln
                    if g(state, A_LASTIF) == 0 {
                        exec_list(state, f, out[0], eend)
                    }
                    q = eend
                }
            }
        } else {
            q = ev(state, f, i, (&o[0]) as u64)
        }
        if q == 0 || q <= i {
            if q <= i {
                amlns.err_set(state, amlns.ERR_TRUNC)
            }
            return
        }
        i = q
    }
}
