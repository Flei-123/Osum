profile kernel

export {
    reset, quiet, empty, masked, set_masked, poll_due, empties, storms, polls, EMPTY_LIMIT, POLL_PERIOD_MS
}

const EMPTY_LIMIT: u64 = 256
const POLL_PERIOD_MS: u64 = 10

static mut run: u64 = 0
static mut total_empty: u64 = 0
static mut storm_n: u64 = 0
static mut poll_n: u64 = 0
static mut is_masked: bool = false
static mut next_poll_ms: u64 = 0

fn reset() {
    run = 0
    total_empty = 0
    storm_n = 0
    poll_n = 0
    is_masked = false
    next_poll_ms = 0
}

fn quiet() {
    run = 0
}

fn empty() -> bool {
    run = run + 1
    total_empty = total_empty + 1
    if run >= EMPTY_LIMIT && !is_masked {
        storm_n = storm_n + 1
        return true
    }
    return false
}

fn masked() -> bool {
    return is_masked
}

fn set_masked(now_ms: u64) {
    is_masked = true
    next_poll_ms = now_ms + POLL_PERIOD_MS
}

fn poll_due(now_ms: u64) -> bool {
    if !is_masked || now_ms < next_poll_ms {
        return false
    }
    next_poll_ms = now_ms + POLL_PERIOD_MS
    poll_n = poll_n + 1
    return true
}

fn empties() -> u64 {
    return total_empty
}

fn storms() -> u64 {
    return storm_n
}

fn polls() -> u64 {
    return poll_n
}
