// SPDX-License-Identifier: GPL-2.0-only
// kernel/acpi.fi -- round K5: asking the firmware how many
// processors this machine has.
//
// A kernel cannot count cores by looking. There is no register that says
// "four", no port that answers with a number; the only place the
// information exists is a table the firmware left in memory, and the only
// way to it is a chain of four steps, each of which has to be checked
// because a wrong turn ends in reading random memory as a table:
//
//   1. THE RSDP, "RSD PTR ", eight characters somewhere in two places the
//      specification allows: the first kilobyte of the EBDA (whose
//      segment stands as a 16-bit word at 0x40E) and 0x000E0000 ..
//      0x000FFFFF. Aligned to 16. Its first twenty octets have to sum to
//      zero modulo 256, which is what separates the real one from the
//      same eight characters standing in a BIOS string.
//   2. THE RSDT or, from ACPI 2.0 on, the XSDT -- a header plus an array
//      of pointers to every other table. Four octets per entry in the
//      RSDT, eight in the XSDT, and which one is valid is decided by the
//      revision in the RSDP, not by which pointer looks nicer.
//   3. THE MADT, signature "APIC", found by walking that array. It
//      carries the address of the local APIC and then a list of records
//      of varying length, each with a type and its own length.
//   4. THE RECORDS of type 0 (a local APIC = a processor) and type 9 (the
//      same in the x2APIC form). Flag bit 0 says the processor is usable.
//      A record of type 0 whose flags are zero is a socket that is empty
//      or a core the firmware disabled -- starting it would hang.
//
// EVERY step above is checksummed and every length is taken out of the
// table itself. The counter-check that this is really being read and not
// guessed is in `tools/kernel/run.sh`: the same kernel under `-smp 1`,
// `-smp 2` and `-smp 4` has to report one, two and four processors, and
// nothing in the kernel knows the number beforehand.

import serial
import lib.kstate

export { snapshot, snap_count, snap_bytes, snap_skipped, snap_cap_bytes, rsdp_addr, rsdp_source, root_addr, root_width,
    find, cpus, total, ioapic_addr, lapic_addr, revision, oem, valid, table,
    table_count, table_at, readable, dsdt,
    // ROUND BLECHVIER: from the first process on only the first GiB.
    only_first_give }

// ------------------------------------------------------ the search area

const EBDA_PTR: u64 = 0x40E
const BIOS_LOW: u64 = 0x000E0000
const BIOS_HIGH: u64 = 0x00100000

// Offsets in the RSDP.
// MEASURED AND CORRECTED: the scan first stopped at one GiB. But OVMF
// puts the ACPI tables at the UPPER end of low memory -- with 2 GiB RAM
// around 0x7F000000. How far this kernel really maps is in
// `kstate.MAPPED_GB`.
const GIBIBYTE: u64 = 0x40000000

const P_REVISION: u64 = 15
const P_RSDT: u64 = 16
const P_LENGTH: u64 = 20
const P_XSDT: u64 = 24

// Offsets in every table header.
const H_LENGTH: u64 = 4
const H_REVISION: u64 = 8
const H_OEM: u64 = 10
const H_SIZE: u64 = 36

// Offsets in the MADT.
const M_LAPIC: u64 = 36
const M_ENTRIES: u64 = 44

// Record types inside the MADT.
const E_LAPIC: u64 = 0
const E_IOAPIC: u64 = 1
const E_X2APIC: u64 = 9

// Where what was found is kept: the SMP scalar page, behind the words
// `cpu.fi` uses.
const S_RSDP: u64 = 64
const S_MADT: u64 = 72
const S_LAPIC: u64 = 80
const S_IOAPIC: u64 = 88
const S_REV: u64 = 96
const S_OEM: u64 = 104
const S_VALID: u64 = 112
const S_TOTAL: u64 = 120 // W-SMP2: enabled processor entries the MADT lists (also those this kernel cannot start)

fn sget(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.SMP_OFF + off)
}

fn sset(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.SMP_OFF + off, v)
}

// --------------------------------------------------------- the checksum

// A valid ACPI structure sums to zero over its whole length, one octet at
// a time. Wrapping addition is meant here, not the checked one -- the sum
// of 36 octets goes past 255 on purpose.
fn sum_zero(p: u64, n: u64) -> bool {
    var i: u64 = 0
    var s: u64 = 0
    while i < n {
        s = (s + kstate.get8(p + i)) & 0xFF
        i = i + 1
    }
    return s == 0
}

// Four or eight characters, compared without a string type.
fn tag(p: u64, a: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get8(p + i) != kstate.get8(a + i) {
            return false
        }
        i = i + 1
    }
    return true
}

// --------------------------------------------------------- step 1: RSDP

fn scan_for(from: u64, to: u64, want: u64) -> u64 {
    var p: u64 = from
    while p < to {
        if tag(p, want, 8) {
            if sum_zero(p, 20) {
                return p
            }
        }
        p = p + 16
    }
    return 0
}

// MEASURED AND CORRECTED: the first version fetched the multiboot
// pointer with `kstate.get(0, MBI)` -- that is from absolute address 768
// instead of from the data area. On the finished image it still said
// "acpi=0" afterwards. The state pointer must be passed through.
fn find_rsdp(state: u64) -> u64 {
    limit_set(state)
    var want: [u8; 9] = "RSD PTR \0"
    let w: u64 = (&want[0]) as u64
    // The EBDA. Its segment stands in the BIOS data area as a paragraph
    // number; a machine without one has a zero there.
    let seg: u64 = kstate.get16(EBDA_PTR)
    if seg != 0 {
        let base: u64 = seg * 16
        let hit: u64 = scan_for(base, base + 1024, w)
        if hit != 0 {
            rsdp_src = 1
            return hit
        }
    }
    let alt: u64 = scan_for(BIOS_LOW, BIOS_HIGH, w)
    if alt != 0 {
        rsdp_src = 2
        return alt
    }
    // ================================================ ROUND BLECHVIER
    // ============ UNDER UEFI THE RSDP LIVES ELSEWHERE.
    //
    // MEASURED, not assumed: the same kernel reports "smp: cpus=1 acpi=1"
    // with SeaBIOS (`qemu -kernel`) and "acpi=0" through the loader with
    // OVMF. The reason is three lines further up -- the search covers the
    // EBDA and 0xE0000 to 0x100000, and those are the places where a PC BIOS
    // leaves the pointer. A UEFI firmware does NOT do that: it passes it on
    // through the EFI configuration table and puts the tables itself into
    // memory of type "ACPI reclaim".
    //
    // JUSTIN'S BOARD STARTS UEFI FROM THE STICK. So on it this kernel has
    // NEVER seen an ACPI table: no MADT (and thereby no processor list), no
    // FADT (and thereby no switching off of the GPE bits), no IVRS. That is
    // no small thing -- it is the reason three diagnostics of this round
    // would have stayed empty on his machine.
    //
    // The multiboot loader gives us the memory map, and in it type 3 is
    // EXACTLY the ACPI reclaim memory. The search runs there, and only
    // there -- a scan over the whole gigabyte would touch register windows
    // too.
    let mapped: u64 = rsdp_off_map(state, w)
    if mapped != 0 {
        rsdp_src = 3
    }
    return mapped
}

// The RSDP sits on a 16-byte boundary. The search covers the ranges of
// the memory map that the firmware has marked as ACPI memory (type 3 =
// reclaim, type 4 = NVS) -- and only below the mapped gigabyte, because
// this kernel sees no more.
const MB_FLAGS: u64 = 0
const MB_MMAP_LEN: u64 = 44
const MB_MMAP_ADDR: u64 = 48

fn rsdp_off_map(state: u64, w: u64) -> u64 {
    let mbi: u64 = kstate.get(state, kstate.MBI)
    if mbi == 0 {
        return 0
    }
    if (kstate.get32(mbi + MB_FLAGS) & 64) == 0 {
        return 0
    }
    let len: u64 = kstate.get32(mbi + MB_MMAP_LEN)
    let addr: u64 = kstate.get32(mbi + MB_MMAP_ADDR)
    // MEASURED AND CORRECTED (for the second time, and this time it was the
    // scan itself): this used to be `MAPPED_GB * GIB`. The kernel then
    // scanned 1.6 GiB even when it had long been in a process address space
    // in which only the first one is mapped -- `cr2=0x5fb6c000`, sixteen
    // aligned, so exactly one step of `scan_for`. The SAME bound applies as
    // for the tables; `limit_set` has already set it above.
    var bound: u64 = acpi_bound
    if bound == 0 {
        bound = GIBIBYTE
    }
    var p: u64 = addr
    while p < addr + len {
        let size: u64 = kstate.get32(p)
        let base: u64 = __mmio_read64((p + 4) as *mut u64)
        let area_len: u64 = __mmio_read64((p + 12) as *mut u64)
        let art: u64 = kstate.get32(p + 20)
        if (art == 3 || art == 4) && base < bound && area_len != 0 {
            var von: u64 = base
            var ende: u64 = base + area_len
            if ende > bound {
                ende = bound
            }
            // HP-12 (r1521): OVMF reports an NVS region (0x806000, 8 KiB) INSIDE
            // the kernel image. Those image pages are the embedded ring-3 code
            // (user bit set), so the first supervisor read of the scan hits
            // SMAP: #PF err=1 cr2=0x806000 in acpi.tag. Firmware tables are never
            // inside the loaded kernel, so the scan starts behind the image.
            // Word `acpiold` restores the old scan (counter-proof for the gate).
            if !kstate.mode_on(state, kstate.M_ACPIOLD) {
                let kend: u64 = (kstate.get(state, kstate.KERNEL_END) + 15) & 0xFFFFFFFFFFFFFFF0
                if von < kend {
                    von = kend
                }
            }
            var treffer: u64 = 0
            if von < ende {
                treffer = scan_for(von, ende, w)
            }
            if treffer != 0 {
                return treffer
            }
        }
        if size == 0 {
            p = addr + len
        } else {
            p = p + size + 4
        }
    }
    return 0
}

// ---------------------------------------------- step 2 and 3: the tables

// ================================================== ROUND BLECHVIER
// DO NOT TOUCH A TABLE THAT LIES OUTSIDE THE MAPPED MEMORY.
//
// MEASURED, and it stopped a kernel: as soon as the RSDP was really found
// under UEFI, `batt.fi` went over ALL tables (`table_count`/`table_at`)
// and `header_ok` computed the checksum over each of them. One of them lay
// outside the mapped memory, and the kernel stopped with
//
//     *** EXCEPTION 14 #PF err=0x0 cr2=0x5fb7d00f  rip in kstate.get8
//
// -- immediately after `desk: start`. It never showed before, because
// without an RSDP no table was touched at all.
//
// That is exactly the requirement of this round: EVERY loop over foreign
// data gets a bound. The bound is how far this kernel really maps.
static mut rsdp_src: u64 = 0
static mut snap_base: u64 = 0
static mut snap_cap: u64 = 0
static mut snap_used: u64 = 0
static mut snap_n: u64 = 0
static mut snap_skip: u64 = 0
static mut snap_root: u64 = 0
static mut snap_width: u64 = 0
static mut snap_copy: [u64; 96] = [0 as u64; 96]
static mut acpi_bound: u64 = 0
static mut acpi_eng: u64 = 0

// ================================================== ROUND BLECHVIER
// AND WHY THE BOUND GETS NARROWER LATER THAN AT BOOT.
//
// MEASURED, with a halted kernel and then confirmed in the source:
// `proc.fi:264` gives a process EXACTLY ONE entry of the kernel PDPT --
// the first. Entry 1 of the same PDPT is the process's own area. In
// process context the kernel memory above the FIRST gibibyte is therefore
// not mapped at all, and that is no carelessness but the layout of this
// address space.
//
// OVMF puts the ACPI tables at the upper end of low memory -- with 2 GiB
// RAM around 0x7E000000. As long as only `smp` and `hw.blech_stage` read
// them (both in kernel context, before the first process), that works.
// `batt.fi` goes through them again LATER, out of the desktop loop -- and
// there the kernel falls over with
//
//     *** EXCEPTION 14 #PF err=0x0 cr2=0x5fb7d00f
//
// immediately after `desk: start`. That is exactly how it happened.
//
// So: at boot the full mapped width, from the first process on only the
// first gibibyte. A table above it is then not touched any more -- better
// no answer than a dead kernel.
//
// THE RIGHT SOLUTION would be to copy the tables into low memory at boot
// and afterwards work only with the copies. That is a round of its own and
// is described in docs/RUNDE-BLECHVIER.md.
fn only_first_give() {
    acpi_eng = 1
    acpi_bound = GIBIBYTE
}

fn limit_set(state: u64) {
    if acpi_eng != 0 {
        acpi_bound = GIBIBYTE
        return
    }
    let g: u64 = kstate.get(state, kstate.MAPPED_GB) *% GIBIBYTE
    if g != 0 {
        acpi_bound = g
    }
}

// THE POINTER ITSELF IS THE FIRST THING THAT IS TOUCHED.
//
// MEASURED AND CORRECTED, and the address proved it: the kernel stopped at
// `cr2=0x5fb7d00f`, and 0x0F is EXACTLY `P_REVISION`. So it was not a
// table but the REMEMBERED RSDP itself -- found at boot with the wide
// bound, in ACPI memory at 1.6 GiB, and touched again afterwards from
// process context, where that gibibyte is no longer mapped. A pointer that
// was valid yesterday is not valid in another address space.
fn rsdp_ok(state: u64) -> u64 {
    let p: u64 = sget(state, S_RSDP)
    if p == 0 || !erreichbar(p, 36) {
        return 0
    }
    return p
}

fn erreichbar(p: u64, n: u64) -> bool {
    if p < 0x1000 {
        return false
    }
    if acpi_bound == 0 {
        return true
    }
    if p >= acpi_bound {
        return false
    }
    return p + n <= acpi_bound
}

fn header_ok(p: u64) -> bool {
    if p == 0 {
        return false
    }
    if !erreichbar(p, H_SIZE) {
        return false
    }
    let len: u64 = kstate.get32(p + H_LENGTH)
    if len < H_SIZE || len > 0x100000 {
        return false
    }
    if !erreichbar(p, len) {
        return false
    }
    return sum_zero(p, len)
}

// Walks the pointer array of the RSDT or XSDT and returns the table with
// the wanted signature. `width` is 4 for the RSDT and 8 for the XSDT.
fn table_in(root: u64, width: u64, want: u64) -> u64 {
    if !header_ok(root) {
        return 0
    }
    let len: u64 = kstate.get32(root + H_LENGTH)
    let n: u64 = (len - H_SIZE) / width
    var i: u64 = 0
    while i < n {
        var t: u64 = 0
        if width == 4 {
            t = kstate.get32(root + H_SIZE + i * 4)
        } else {
            t = __mmio_read64((root + H_SIZE + i * 8) as *mut u64)
        }
        if header_ok(t) && tag(t, want, 4) {
            return t
        }
        i = i + 1
    }
    return 0
}

// ROUND K13: A TABLE BY ITS SIGNATURE, from outside. `find` above looks
// for the MADT and keeps the way there to itself; the shutdown needs the
// FADT and the DSDT, and both are in the same list. So the same way is
// walked once more -- four signature bytes in, a pointer out, 0 = not
// there.
fn table(state: u64, want: u64) -> u64 {
    if snap_n != 0 {
        var k: u64 = 1
        while k < snap_n {
            let c: u64 = snap_copy[k as usize]
            if c != 0 && tag(c, want, 4) {
                return c
            }
            k = k + 1
        }
        return 0
    }
    limit_set(state)
    // ROUND K13: IF `find` HAS NOT RUN YET, the pointer is searched here
    // itself. That is no luxury but measured: the shutdown by `init` falls
    // into `kmain.osum`, and `acpi.find` runs only afterwards in `smp.stage`.
    // Without these four lines `power.acpi_off` reported "no FADT" and the
    // machine stayed on.
    var rsdp: u64 = rsdp_ok(state)
    if rsdp == 0 {
        rsdp = find_rsdp(state)
        if rsdp == 0 || !erreichbar(rsdp, 36) {
            return 0
        }
        sset(state, S_RSDP, rsdp)
    }
    let rev: u64 = kstate.get8(rsdp + P_REVISION)
    if rev >= 2 {
        let len: u64 = kstate.get32(rsdp + P_LENGTH)
        if len >= 33 && sum_zero(rsdp, len) {
            let t: u64 = table_in(__mmio_read64((rsdp + P_XSDT) as *mut u64),
                8, want)
            if t != 0 {
                return t
            }
        }
    }
    return table_in(kstate.get32(rsdp + P_RSDT), 4, want)
}

// ------------------------------------------------------------ the whole

// Reads the chain and enters every usable processor. Returns how many
// there are, or 0 when the firmware said nothing -- and then the caller
// keeps the one processor it is standing on, which is the right answer
// for a machine without ACPI.
fn find(state: u64) -> u64 {
    var w_apic: [u8; 5] = "APIC\0"
    let rsdp: u64 = find_rsdp(state)
    sset(state, S_VALID, 0)
    if rsdp == 0 {
        return 0
    }
    sset(state, S_RSDP, rsdp)
    let rev: u64 = kstate.get8(rsdp + P_REVISION)
    sset(state, S_REV, rev)
    sset(state, S_OEM, rsdp + H_OEM - 1)
    var madt: u64 = 0
    if rev >= 2 {
        let len: u64 = kstate.get32(rsdp + P_LENGTH)
        if len >= 33 && sum_zero(rsdp, len) {
            madt = table_in(__mmio_read64((rsdp + P_XSDT) as *mut u64), 8,
                (&w_apic[0]) as u64)
        }
    }
    if madt == 0 {
        madt = table_in(kstate.get32(rsdp + P_RSDT), 4, (&w_apic[0]) as u64)
    }
    if madt == 0 {
        return 0
    }
    sset(state, S_MADT, madt)
    sset(state, S_LAPIC, kstate.get32(madt + M_LAPIC))
    sset(state, S_VALID, 1)
    return walk(state, madt)
}

// The records. Every one carries its own length in its second octet; a
// length of zero would be an endless loop and is what ends the walk.
fn walk(state: u64, madt: u64) -> u64 {
    let end: u64 = madt + kstate.get32(madt + H_LENGTH)
    var p: u64 = madt + M_ENTRIES
    var n: u64 = 0
    var tot: u64 = 0
    sset(state, S_TOTAL, 0)
    while p + 2 <= end {
        let kind: u64 = kstate.get8(p)
        let len: u64 = kstate.get8(p + 1)
        if len < 2 {
            sset(state, S_TOTAL, tot)
            return n
        }
        if kind == E_LAPIC && len >= 8 {
            let flags: u64 = kstate.get32(p + 4)
            if (flags & 1) != 0 {
                tot = tot + 1
            }
            if (flags & 1) != 0 && n < kstate.MAX_CPUS {
                store_cpu(state, n, kstate.get8(p + 3))
                n = n + 1
            }
        }
        if kind == E_X2APIC && len >= 16 {
            let id: u64 = kstate.get32(p + 4)
            let flags: u64 = kstate.get32(p + 8)
            if (flags & 1) != 0 {
                tot = tot + 1
            }
            // This kernel addresses the APIC through its 8-bit id; an
            // x2APIC id above 255 needs the x2APIC mode it does not have.
            if (flags & 1) != 0 && id < 255 && n < kstate.MAX_CPUS {
                if !known(state, n, id) {
                    store_cpu(state, n, id)
                    n = n + 1
                }
            }
        }
        if kind == E_IOAPIC && len >= 12 {
            if sget(state, S_IOAPIC) == 0 {
                sset(state, S_IOAPIC, kstate.get32(p + 4))
            }
        }
        p = p + len
    }
    sset(state, S_TOTAL, tot)
    return n
}

// W-SMP2: how many enabled processors the MADT lists in total (the number `cpus_madt` shows), even if fewer fit the table.
fn total(state: u64) -> u64 {
    return sget(state, S_TOTAL)
}

// The found ids are parked in the SMP page until `smp.probe` copies them
// into the processor table -- this file must not import `cpu.fi`, so that
// the direction of the module graph stays "who reads the hardware" ->
// "who keeps the state" and not the other way round.
const S_IDS: u64 = 128 // eight words

fn store_cpu(state: u64, i: u64, apid: u64) {
    kstate.set(state, kstate.SMP_OFF + S_IDS + i * 8, apid + 1)
}

fn known(state: u64, n: u64, apid: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get(state, kstate.SMP_OFF + S_IDS + i * 8) == apid + 1 {
            return true
        }
        i = i + 1
    }
    return false
}

// The id of the i-th processor the firmware reported, or 256 when there
// is none -- 256 is not an 8-bit APIC id, so it cannot be mistaken for
// processor zero.
fn cpus(state: u64, i: u64) -> u64 {
    let v: u64 = kstate.get(state, kstate.SMP_OFF + S_IDS + i * 8)
    if v == 0 {
        return 256
    }
    return v - 1
}

fn lapic_addr(state: u64) -> u64 {
    return sget(state, S_LAPIC)
}

fn ioapic_addr(state: u64) -> u64 {
    return sget(state, S_IOAPIC)
}

fn revision(state: u64) -> u64 {
    return sget(state, S_REV)
}

fn valid(state: u64) -> bool {
    return sget(state, S_VALID) != 0
}

// The six characters of the OEM id, for the line that shows the table was
// really read and not invented.
fn oem(state: u64) -> u64 {
    return sget(state, S_OEM)
}

// ------------------------------------- ROUND K18: GO THROUGH ALL tables
//
// `table` looks for ONE table by its signature. Round K18 needs the
// opposite: EVERY table in turn, because the object it is looking for (a
// battery, a thermal zone) does not depend on a signature -- it can be in
// the DSDT or in any of the SSDTs, and on a real machine those are a
// dozen.
//
// Counting: slot 0 is the DSDT. It is NOT in the RSDT -- it hangs off
// the FADT, offset 40 -- and would be missing from a pure RSDT walk. The
// slots 1..n are the entries of the RSDT or the XSDT.

const F_DSDT_OFF: u64 = 40
const F_XDSDT_OFF: u64 = 140
const F_XDSDT_END: u64 = 148

fn dsdt_ptr(fadt: u64) -> u64 {
    if kstate.get32(fadt + H_LENGTH) >= F_XDSDT_END {
        let x: u64 = __mmio_read64((fadt + F_XDSDT_OFF) as *mut u64)
        if x != 0 {
            return x
        }
    }
    return kstate.get32(fadt + F_DSDT_OFF)
}

fn readable(state: u64, p: u64, n: u64) -> bool {
    limit_set(state)
    return erreichbar(p, n)
}

fn dsdt(state: u64) -> u64 {
    if snap_n != 0 {
        return snap_copy[0]
    }
    var w_facp: [u8; 5] = "FACP\0"
    let fadt: u64 = table(state, (&w_facp[0]) as u64)
    if fadt == 0 {
        return 0
    }
    let d: u64 = dsdt_ptr(fadt)
    if !header_ok(d) {
        return 0
    }
    return d
}

fn root_of(state: u64, out_width: u64) -> u64 {
    limit_set(state)
    var rsdp: u64 = rsdp_ok(state)
    if rsdp == 0 {
        rsdp = find_rsdp(state)
        if rsdp == 0 || !erreichbar(rsdp, 36) {
            return 0
        }
        sset(state, S_RSDP, rsdp)
    }
    let rev: u64 = kstate.get8(rsdp + P_REVISION)
    if rev >= 2 {
        let len: u64 = kstate.get32(rsdp + P_LENGTH)
        if len >= 33 && sum_zero(rsdp, len) {
            let x: u64 = __mmio_read64((rsdp + P_XSDT) as *mut u64)
            if header_ok(x) {
                __mmio_write64(out_width as *mut u64, 8)
                return x
            }
        }
    }
    let r: u64 = kstate.get32(rsdp + P_RSDT)
    if !header_ok(r) {
        return 0
    }
    __mmio_write64(out_width as *mut u64, 4)
    return r
}

fn table_count(state: u64) -> u64 {
    if snap_n != 0 {
        return snap_n
    }
    var width: u64 = 4
    let root: u64 = root_of(state, (&width) as u64)
    if root == 0 {
        return 0
    }
    let len: u64 = kstate.get32(root + H_LENGTH)
    if len < H_SIZE {
        return 0
    }
    return 1 + (len - H_SIZE) / width
}

fn table_at(state: u64, i: u64) -> u64 {
    if snap_n != 0 {
        if i >= snap_n {
            return 0
        }
        return snap_copy[i as usize]
    }
    if i == 0 {
        var w_facp: [u8; 5] = "FACP\0"
        let fadt: u64 = table(state, (&w_facp[0]) as u64)
        if fadt == 0 {
            return 0
        }
        let d: u64 = dsdt_ptr(fadt)
        if !header_ok(d) {
            return 0
        }
        return d
    }
    var width: u64 = 4
    let root: u64 = root_of(state, (&width) as u64)
    if root == 0 {
        return 0
    }
    let len: u64 = kstate.get32(root + H_LENGTH)
    if len < H_SIZE {
        return 0
    }
    let n: u64 = (len - H_SIZE) / width
    if i - 1 >= n {
        return 0
    }
    var t: u64 = 0
    if width == 4 {
        t = kstate.get32(root + H_SIZE + (i - 1) * 4)
    } else {
        t = __mmio_read64((root + H_SIZE + (i - 1) * 8) as *mut u64)
    }
    if !header_ok(t) {
        return 0
    }
    return t
}


fn copy_table(t: u64) -> u64 {
    let len: u64 = kstate.get32(t + H_LENGTH)
    let need: u64 = (len + 15) & 0xFFFFFFFFFFFFFFF0
    if snap_used + need > snap_cap {
        snap_skip = snap_skip + 1
        return 0
    }
    let dst: u64 = snap_base + snap_used
    var i: u64 = 0
    while i < len {
        kstate.set8(dst + i, kstate.get8(t + i) as u8)
        i = i + 1
    }
    snap_used = snap_used + need
    return dst
}

fn snapshot(state: u64, base: u64, cap: u64) {
    if snap_n != 0 || base == 0 {
        return
    }
    snap_base = base
    snap_cap = cap
    snap_used = 0
    snap_skip = 0
    var width: u64 = 4
    snap_root = root_of(state, (&width) as u64)
    snap_width = width
    let total: u64 = table_count(state)
    var i: u64 = 0
    while i < total && i < 96 {
        let t: u64 = table_at(state, i)
        var c: u64 = 0
        if t != 0 {
            c = copy_table(t)
        }
        snap_copy[i as usize] = c
        i = i + 1
    }
    snap_n = i
}

fn snap_count() -> u64 {
    return snap_n
}

fn snap_bytes() -> u64 {
    return snap_used
}

fn snap_skipped() -> u64 {
    return snap_skip
}

fn snap_cap_bytes() -> u64 {
    return snap_cap
}

fn rsdp_addr(state: u64) -> u64 {
    return sget(state, S_RSDP)
}

fn rsdp_source() -> u64 {
    return rsdp_src
}

fn root_addr() -> u64 {
    return snap_root
}

fn root_width() -> u64 {
    return snap_width
}
