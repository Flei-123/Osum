// SPDX-License-Identifier: GPL-2.0-only
// kernel/acpi.fi -- round K5: asking the firmware how many
// processors this machine has.
//
// A kernel cannot count cores by looking. There is no register that says
// "four", no port that answers with a number; the only place the
// information exists is a table the firmware left in memory, and the only
// way to it is a chain of four steps, each of which has to be checked
// because a wrong turn ends in reading random memory as a table:
//
//   1. THE RSDP, "RSD PTR ", eight characters somewhere in two places the
//      specification allows: the first kilobyte of the EBDA (whose
//      segment stands as a 16-bit word at 0x40E) and 0x000E0000 ..
//      0x000FFFFF. Aligned to 16. Its first twenty octets have to sum to
//      zero modulo 256, which is what separates the real one from the
//      same eight characters standing in a BIOS string.
//   2. THE RSDT or, from ACPI 2.0 on, the XSDT -- a header plus an array
//      of pointers to every other table. Four octets per entry in the
//      RSDT, eight in the XSDT, and which one is valid is decided by the
//      revision in the RSDP, not by which pointer looks nicer.
//   3. THE MADT, signature "APIC", found by walking that array. It
//      carries the address of the local APIC and then a list of records
//      of varying length, each with a type and its own length.
//   4. THE RECORDS of type 0 (a local APIC = a processor) and type 9 (the
//      same in the x2APIC form). Flag bit 0 says the processor is usable.
//      A record of type 0 whose flags are zero is a socket that is empty
//      or a core the firmware disabled -- starting it would hang.
//
// EVERY step above is checksummed and every length is taken out of the
// table itself. The counter-check that this is really being read and not
// guessed is in `tools/kernel/run.sh`: the same kernel under `-smp 1`,
// `-smp 2` and `-smp 4` has to report one, two and four processors, and
// nothing in the kernel knows the number beforehand.

import serial
import lib.kstate

export { find, cpus, ioapic_addr, lapic_addr, revision, oem, valid, table,
    table_count, table_at,
    // RUNDE BLECHVIER: ab dem ersten Prozess nur noch das erste Gibioctet.
    only_first_give }

// ------------------------------------------------------ the search area

const EBDA_PTR: u64 = 0x40E
const BIOS_LOW: u64 = 0x000E0000
const BIOS_HIGH: u64 = 0x00100000

// Offsets in the RSDP.
// GEMESSEN UND KORRIGIERT: der Suchlauf hoerte zuerst bei einem
// Gibioctet auf. OVMF legt die ACPI-Tabellen aber ans OBERE Ende des
// unteren Speichers -- bei 2 GiB RAM um 0x7F000000 herum. Wie weit
// dieser Kern wirklich abbildet, steht in `kstate.MAPPED_GIB`.
const GIB: u64 = 0x40000000

const P_REVISION: u64 = 15
const P_RSDT: u64 = 16
const P_LENGTH: u64 = 20
const P_XSDT: u64 = 24

// Offsets in every table header.
const H_LENGTH: u64 = 4
const H_REVISION: u64 = 8
const H_OEM: u64 = 10
const H_SIZE: u64 = 36

// Offsets in the MADT.
const M_LAPIC: u64 = 36
const M_ENTRIES: u64 = 44

// Record types inside the MADT.
const E_LAPIC: u64 = 0
const E_IOAPIC: u64 = 1
const E_X2APIC: u64 = 9

// Where what was found is kept: the SMP scalar page, behind the words
// `cpu.fi` uses.
const S_RSDP: u64 = 64
const S_MADT: u64 = 72
const S_LAPIC: u64 = 80
const S_IOAPIC: u64 = 88
const S_REV: u64 = 96
const S_OEM: u64 = 104
const S_VALID: u64 = 112

fn sget(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.SMP_OFF + off)
}

fn sset(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.SMP_OFF + off, v)
}

// --------------------------------------------------------- the checksum

// A valid ACPI structure sums to zero over its whole length, one octet at
// a time. Wrapping addition is meant here, not the checked one -- the sum
// of 36 octets goes past 255 on purpose.
fn sum_zero(p: u64, n: u64) -> bool {
    var i: u64 = 0
    var s: u64 = 0
    while i < n {
        s = (s + kstate.get8(p + i)) & 0xFF
        i = i + 1
    }
    return s == 0
}

// Four or eight characters, compared without a string type.
fn tag(p: u64, a: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get8(p + i) != kstate.get8(a + i) {
            return false
        }
        i = i + 1
    }
    return true
}

// --------------------------------------------------------- step 1: RSDP

fn scan_for(from: u64, to: u64, want: u64) -> u64 {
    var p: u64 = from
    while p < to {
        if tag(p, want, 8) {
            if sum_zero(p, 20) {
                return p
            }
        }
        p = p + 16
    }
    return 0
}

// GEMESSEN UND KORRIGIERT: die erste Fassung holte den
// Multiboot-Zeiger mit `kstate.get(0, MBI)` -- also aus der absoluten
// Adresse 768 statt aus dem Datenbereich. Am fertigen Abbild stand
// danach weiter "acpi=0". Der Zustandszeiger muss durchgereicht werden.
fn find_rsdp(state: u64) -> u64 {
    limit_set(state)
    var want: [u8; 9] = "RSD PTR \0"
    let w: u64 = (&want[0]) as u64
    // The EBDA. Its segment stands in the BIOS data area as a paragraph
    // number; a machine without one has a zero there.
    let seg: u64 = kstate.get16(EBDA_PTR)
    if seg != 0 {
        let base: u64 = seg * 16
        let hit: u64 = scan_for(base, base + 1024, w)
        if hit != 0 {
            return hit
        }
    }
    let alt: u64 = scan_for(BIOS_LOW, BIOS_HIGH, w)
    if alt != 0 {
        return alt
    }
    // ================================================ RUNDE BLECHVIER
    // ============ UNTER UEFI LIEGT DER RSDP WOANDERS.
    //
    // GEMESSEN, nicht vermutet: derselbe Kern meldet mit SeaBIOS
    // (`qemu -kernel`) "smp: cpus=1 acpi=1" und ueber den Lader mit
    // OVMF "acpi=0". Der Grund steht drei Zeilen weiter oben -- gesucht
    // wird in der EBDA und zwischen 0xE0000 und 0x100000, und das sind
    // die Orte, an denen ein PC-BIOS den Zeiger hinterlaesst. Eine
    // UEFI-Firmware tut das NICHT: sie reicht ihn ueber die
    // EFI-Konfigurationstabelle weiter und legt die Tabellen selbst in
    // Speicher vom Typ "ACPI reclaim".
    //
    // JUSTINS BRETT STARTET UEFI VOM STICK. Dieser Kern hat dort also
    // noch NIE eine ACPI-Tabelle gesehen: keine MADT (und damit keine
    // Prozessorliste), keine FADT (und damit keine Abschaltung der
    // GPE-Bits), keine IVRS. Das ist keine Kleinigkeit -- es ist der
    // Grund, warum drei Diagnosen dieser Runde auf seinem Rechner leer
    // geblieben waeren.
    //
    // Der Multiboot-Lader gibt uns die Speicherkarte, und darin ist
    // Typ 3 GENAU der ACPI-Reclaim-Speicher. Dort wird gesucht, und nur
    // dort -- ein Suchlauf ueber das ganze Gigabyte wuerde auch
    // Registerfenster anfassen.
    return rsdp_off_map(state, w)
}

// Der RSDP steht auf einer 16-Oktett-Grenze. Gesucht wird in den
// Bereichen der Speicherkarte, die die Firmware als ACPI-Speicher
// ausgewiesen hat (Typ 3 = reclaim, Typ 4 = NVS) -- und nur unterhalb
// des abgebildeten Gigabytes, weil dieser Kern nicht mehr sieht.
const MB_FLAGS: u64 = 0
const MB_MMAP_LEN: u64 = 44
const MB_MMAP_ADDR: u64 = 48

fn rsdp_off_map(state: u64, w: u64) -> u64 {
    let mbi: u64 = kstate.get(state, kstate.MBI)
    if mbi == 0 {
        return 0
    }
    if (kstate.get32(mbi + MB_FLAGS) & 64) == 0 {
        return 0
    }
    let len: u64 = kstate.get32(mbi + MB_MMAP_LEN)
    let addr: u64 = kstate.get32(mbi + MB_MMAP_ADDR)
    // GEMESSEN UND KORRIGIERT (zum zweiten Mal, und diesmal war es der
    // Suchlauf selbst): hier stand `MAPPED_GIB * GIB`. Damit durchsuchte
    // der Kern auch dann noch 1,6 Gibioctete, wenn er laengst in einem
    // Prozessadressraum stand, in dem nur das erste abgebildet ist --
    // `cr2=0x5fb6c000`, sechzehnfach ausgerichtet, also genau ein
    // Schritt von `scan_for`. Es gilt DIESELBE Grenze wie fuer die
    // Tabellen; `grenze_setzen` hat sie oben schon gestellt.
    var grenze: u64 = acpi_grenze
    if grenze == 0 {
        grenze = GIB
    }
    var p: u64 = addr
    while p < addr + len {
        let size: u64 = kstate.get32(p)
        let base: u64 = __mmio_read64((p + 4) as *mut u64)
        let laenge: u64 = __mmio_read64((p + 12) as *mut u64)
        let art: u64 = kstate.get32(p + 20)
        if (art == 3 || art == 4) && base < grenze && laenge != 0 {
            var ende: u64 = base + laenge
            if ende > grenze {
                ende = grenze
            }
            let treffer: u64 = scan_for(base, ende, w)
            if treffer != 0 {
                return treffer
            }
        }
        if size == 0 {
            p = addr + len
        } else {
            p = p + size + 4
        }
    }
    return 0
}

// ---------------------------------------------- step 2 and 3: the tables

// ================================================== RUNDE BLECHVIER
// KEINE TABELLE ANFASSEN, DIE AUSSERHALB DES ABGEBILDETEN LIEGT.
//
// GEMESSEN, und es hat einen Kern angehalten: sobald der RSDP unter
// UEFI wirklich gefunden wurde, ging `batt.fi` ueber ALLE Tabellen
// (`table_count`/`table_at`) und `header_ok` rechnete die Pruefsumme
// ueber jede von ihnen. Eine davon lag ausserhalb des abgebildeten
// Speichers, und der Kern blieb mit
//
//     *** EXCEPTION 14 #PF err=0x0 cr2=0x5fb7d00f  rip in kstate.get8
//
// stehen -- unmittelbar nach `desk: start`. Vorher fiel es nie auf,
// weil ohne RSDP gar keine Tabelle angefasst wurde.
//
// Das ist genau die Auflage dieser Runde: JEDE Schleife ueber fremde
// Daten bekommt eine Grenze. Die Grenze ist, wie weit dieser Kern
// wirklich abbildet.
static mut acpi_grenze: u64 = 0
static mut acpi_eng: u64 = 0

// ================================================== RUNDE BLECHVIER
// UND WARUM DIE GRENZE SPAETER ENGER WIRD ALS BEIM START.
//
// GEMESSEN, mit einem angehaltenen Kern und dann im Quelltext belegt:
// `proc.fi:264` gibt einem Prozess GENAU EINEN Eintrag des
// Kernel-PDPT mit -- den ersten. Eintrag 1 desselben PDPT ist die
// Flaeche des Prozesses selbst. In Prozesskontext ist der
// Kernelspeicher oberhalb des ERSTEN Gibioctets also gar nicht
// abgebildet, und das ist keine Nachlaessigkeit, sondern die
// Aufteilung dieses Adressraums.
//
// OVMF legt die ACPI-Tabellen ans obere Ende des unteren Speichers --
// bei 2 GiB RAM um 0x7E000000. Solange nur `smp` und `hw.blech_stage`
// sie lesen (beide im Kernelkontext, vor dem ersten Prozess), geht das
// gut. `batt.fi` geht sie SPAETER noch einmal durch, aus der
// Schreibtischschleife heraus -- und da faellt der Kern mit
//
//     *** EXCEPTION 14 #PF err=0x0 cr2=0x5fb7d00f
//
// unmittelbar nach `desk: start`. Genau so ist es passiert.
//
// Also: beim Start die volle abgebildete Weite, ab dem ersten Prozess
// nur noch das erste Gibioctet. Eine Tabelle darueber wird dann nicht
// mehr angefasst -- lieber keine Auskunft als ein toter Kern.
//
// DIE RICHTIGE LOESUNG waere, die Tabellen beim Start in den unteren
// Speicher zu kopieren und danach nur noch mit den Kopien zu arbeiten.
// Das ist eine eigene Runde und steht in docs/RUNDE-BLECHVIER.md.
fn only_first_give() {
    acpi_eng = 1
    acpi_grenze = GIB
}

fn limit_set(state: u64) {
    if acpi_eng != 0 {
        acpi_grenze = GIB
        return
    }
    let g: u64 = kstate.get(state, kstate.MAPPED_GIB) *% GIB
    if g != 0 {
        acpi_grenze = g
    }
}

// DER ZEIGER SELBST IST DAS ERSTE, WAS ANGEFASST WIRD.
//
// GEMESSEN UND KORRIGIERT, und die Adresse hat es bewiesen: der Kern
// blieb bei `cr2=0x5fb7d00f` stehen, und 0x0F ist GENAU `P_REVISION`.
// Es war also nicht eine Tabelle, sondern der GEMERKTE RSDP selbst --
// gefunden beim Start mit der weiten Grenze, im ACPI-Speicher bei
// 1,6 GiB, und danach aus Prozesskontext wieder angefasst, wo dieses
// Gibioctet nicht mehr abgebildet ist. Ein Zeiger, der gestern gueltig
// war, ist es in einem anderen Adressraum nicht.
fn rsdp_ok(state: u64) -> u64 {
    let p: u64 = sget(state, S_RSDP)
    if p == 0 || !erreichbar(p, 36) {
        return 0
    }
    return p
}

fn erreichbar(p: u64, n: u64) -> bool {
    if p < 0x1000 {
        return false
    }
    if acpi_grenze == 0 {
        return true
    }
    if p >= acpi_grenze {
        return false
    }
    return p + n <= acpi_grenze
}

fn header_ok(p: u64) -> bool {
    if p == 0 {
        return false
    }
    if !erreichbar(p, H_SIZE) {
        return false
    }
    let len: u64 = kstate.get32(p + H_LENGTH)
    if len < H_SIZE || len > 0x100000 {
        return false
    }
    if !erreichbar(p, len) {
        return false
    }
    return sum_zero(p, len)
}

// Walks the pointer array of the RSDT or XSDT and returns the table with
// the wanted signature. `width` is 4 for the RSDT and 8 for the XSDT.
fn table_in(root: u64, width: u64, want: u64) -> u64 {
    if !header_ok(root) {
        return 0
    }
    let len: u64 = kstate.get32(root + H_LENGTH)
    let n: u64 = (len - H_SIZE) / width
    var i: u64 = 0
    while i < n {
        var t: u64 = 0
        if width == 4 {
            t = kstate.get32(root + H_SIZE + i * 4)
        } else {
            t = __mmio_read64((root + H_SIZE + i * 8) as *mut u64)
        }
        if header_ok(t) && tag(t, want, 4) {
            return t
        }
        i = i + 1
    }
    return 0
}

// RUNDE K13: EINE TABELLE NACH IHRER KENNUNG, von aussen. `find` oben
// sucht die MADT und behaelt den Weg dorthin fuer sich; die Abschaltung
// braucht die FADT und die DSDT, und beide liegen in derselben Liste.
// Also wird derselbe Weg noch einmal gegangen -- vier Oktette Kennung
// herein, ein Zeiger heraus, 0 = nicht da.
fn table(state: u64, want: u64) -> u64 {
    limit_set(state)
    // RUNDE K13: WENN `find` NOCH NICHT GELAUFEN IST, wird der Zeiger
    // hier selbst gesucht. Das ist kein Luxus, sondern gemessen: die
    // Abschaltung durch `init` faellt in `kmain.osum`, und `acpi.find`
    // laeuft erst danach in `smp.stage`. Ohne diese vier Zeilen meldete
    // `power.acpi_off` "keine FADT" und die Maschine blieb an.
    var rsdp: u64 = rsdp_ok(state)
    if rsdp == 0 {
        rsdp = find_rsdp(state)
        if rsdp == 0 || !erreichbar(rsdp, 36) {
            return 0
        }
        sset(state, S_RSDP, rsdp)
    }
    let rev: u64 = kstate.get8(rsdp + P_REVISION)
    if rev >= 2 {
        let len: u64 = kstate.get32(rsdp + P_LENGTH)
        if len >= 33 && sum_zero(rsdp, len) {
            let t: u64 = table_in(__mmio_read64((rsdp + P_XSDT) as *mut u64),
                8, want)
            if t != 0 {
                return t
            }
        }
    }
    return table_in(kstate.get32(rsdp + P_RSDT), 4, want)
}

// ------------------------------------------------------------ the whole

// Reads the chain and enters every usable processor. Returns how many
// there are, or 0 when the firmware said nothing -- and then the caller
// keeps the one processor it is standing on, which is the right answer
// for a machine without ACPI.
fn find(state: u64) -> u64 {
    var w_apic: [u8; 5] = "APIC\0"
    let rsdp: u64 = find_rsdp(state)
    sset(state, S_VALID, 0)
    if rsdp == 0 {
        return 0
    }
    sset(state, S_RSDP, rsdp)
    let rev: u64 = kstate.get8(rsdp + P_REVISION)
    sset(state, S_REV, rev)
    sset(state, S_OEM, rsdp + H_OEM - 1)
    var madt: u64 = 0
    if rev >= 2 {
        let len: u64 = kstate.get32(rsdp + P_LENGTH)
        if len >= 33 && sum_zero(rsdp, len) {
            madt = table_in(__mmio_read64((rsdp + P_XSDT) as *mut u64), 8,
                (&w_apic[0]) as u64)
        }
    }
    if madt == 0 {
        madt = table_in(kstate.get32(rsdp + P_RSDT), 4, (&w_apic[0]) as u64)
    }
    if madt == 0 {
        return 0
    }
    sset(state, S_MADT, madt)
    sset(state, S_LAPIC, kstate.get32(madt + M_LAPIC))
    sset(state, S_VALID, 1)
    return walk(state, madt)
}

// The records. Every one carries its own length in its second octet; a
// length of zero would be an endless loop and is what ends the walk.
fn walk(state: u64, madt: u64) -> u64 {
    let end: u64 = madt + kstate.get32(madt + H_LENGTH)
    var p: u64 = madt + M_ENTRIES
    var n: u64 = 0
    while p + 2 <= end {
        let kind: u64 = kstate.get8(p)
        let len: u64 = kstate.get8(p + 1)
        if len < 2 {
            return n
        }
        if kind == E_LAPIC && len >= 8 {
            let flags: u64 = kstate.get32(p + 4)
            if (flags & 1) != 0 && n < kstate.MAX_CPUS {
                store_cpu(state, n, kstate.get8(p + 3))
                n = n + 1
            }
        }
        if kind == E_X2APIC && len >= 16 {
            let id: u64 = kstate.get32(p + 4)
            let flags: u64 = kstate.get32(p + 8)
            // This kernel addresses the APIC through its 8-bit id; an
            // x2APIC id above 255 needs the x2APIC mode it does not have.
            if (flags & 1) != 0 && id < 255 && n < kstate.MAX_CPUS {
                if !known(state, n, id) {
                    store_cpu(state, n, id)
                    n = n + 1
                }
            }
        }
        if kind == E_IOAPIC && len >= 12 {
            if sget(state, S_IOAPIC) == 0 {
                sset(state, S_IOAPIC, kstate.get32(p + 4))
            }
        }
        p = p + len
    }
    return n
}

// The found ids are parked in the SMP page until `smp.probe` copies them
// into the processor table -- this file must not import `cpu.fi`, so that
// the direction of the module graph stays "who reads the hardware" ->
// "who keeps the state" and not the other way round.
const S_IDS: u64 = 128 // eight words

fn store_cpu(state: u64, i: u64, apid: u64) {
    kstate.set(state, kstate.SMP_OFF + S_IDS + i * 8, apid + 1)
}

fn known(state: u64, n: u64, apid: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get(state, kstate.SMP_OFF + S_IDS + i * 8) == apid + 1 {
            return true
        }
        i = i + 1
    }
    return false
}

// The id of the i-th processor the firmware reported, or 256 when there
// is none -- 256 is not an 8-bit APIC id, so it cannot be mistaken for
// processor zero.
fn cpus(state: u64, i: u64) -> u64 {
    let v: u64 = kstate.get(state, kstate.SMP_OFF + S_IDS + i * 8)
    if v == 0 {
        return 256
    }
    return v - 1
}

fn lapic_addr(state: u64) -> u64 {
    return sget(state, S_LAPIC)
}

fn ioapic_addr(state: u64) -> u64 {
    return sget(state, S_IOAPIC)
}

fn revision(state: u64) -> u64 {
    return sget(state, S_REV)
}

fn valid(state: u64) -> bool {
    return sget(state, S_VALID) != 0
}

// The six characters of the OEM id, for the line that shows the table was
// really read and not invented.
fn oem(state: u64) -> u64 {
    return sget(state, S_OEM)
}

// ------------------------------------- RUNDE K18: ALLE Tabellen durchgehen
//
// `table` sucht EINE Tabelle nach ihrer Signatur. Runde K18 braucht das
// Gegenteil: JEDE Tabelle der Reihe nach, weil das Objekt, das sie sucht
// (ein Akku, eine Thermalzone), nicht an einer Signatur haengt -- es kann
// in der DSDT stehen oder in irgendeiner der SSDTs, und auf einer echten
// Maschine sind das ein Dutzend.
//
// Zaehlung: Platz 0 ist die DSDT. Die steht NICHT in der RSDT -- sie
// haengt an der FADT, Versatz 40 -- und wuerde bei einem reinen
// RSDT-Durchgang fehlen. Die Plaetze 1..n sind die Eintraege der
// RSDT beziehungsweise der XSDT.

const F_DSDT_OFF: u64 = 40

fn root_of(state: u64, out_width: u64) -> u64 {
    limit_set(state)
    var rsdp: u64 = rsdp_ok(state)
    if rsdp == 0 {
        rsdp = find_rsdp(state)
        if rsdp == 0 || !erreichbar(rsdp, 36) {
            return 0
        }
        sset(state, S_RSDP, rsdp)
    }
    let rev: u64 = kstate.get8(rsdp + P_REVISION)
    if rev >= 2 {
        let len: u64 = kstate.get32(rsdp + P_LENGTH)
        if len >= 33 && sum_zero(rsdp, len) {
            let x: u64 = __mmio_read64((rsdp + P_XSDT) as *mut u64)
            if header_ok(x) {
                __mmio_write64(out_width as *mut u64, 8)
                return x
            }
        }
    }
    let r: u64 = kstate.get32(rsdp + P_RSDT)
    if !header_ok(r) {
        return 0
    }
    __mmio_write64(out_width as *mut u64, 4)
    return r
}

fn table_count(state: u64) -> u64 {
    var width: u64 = 4
    let root: u64 = root_of(state, (&width) as u64)
    if root == 0 {
        return 0
    }
    let len: u64 = kstate.get32(root + H_LENGTH)
    if len < H_SIZE {
        return 0
    }
    return 1 + (len - H_SIZE) / width
}

fn table_at(state: u64, i: u64) -> u64 {
    if i == 0 {
        var w_facp: [u8; 5] = "FACP\0"
        let fadt: u64 = table(state, (&w_facp[0]) as u64)
        if fadt == 0 {
            return 0
        }
        let d: u64 = kstate.get32(fadt + F_DSDT_OFF)
        if !header_ok(d) {
            return 0
        }
        return d
    }
    var width: u64 = 4
    let root: u64 = root_of(state, (&width) as u64)
    if root == 0 {
        return 0
    }
    let len: u64 = kstate.get32(root + H_LENGTH)
    if len < H_SIZE {
        return 0
    }
    let n: u64 = (len - H_SIZE) / width
    if i - 1 >= n {
        return 0
    }
    var t: u64 = 0
    if width == 4 {
        t = kstate.get32(root + H_SIZE + (i - 1) * 4)
    } else {
        t = __mmio_read64((root + H_SIZE + (i - 1) * 8) as *mut u64)
    }
    if !header_ok(t) {
        return 0
    }
    return t
}
