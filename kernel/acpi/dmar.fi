profile kernel

import lib.kstate
import lib.procw
import acpi.acpi
import arch.x86_64.apic
import hwinv.dmarparse
import libc.regio

export { render }

const MAX_UNITS: u64 = 8
const R_VER: u64 = 0x00
const R_CAP: u64 = 0x08
const R_ECAP: u64 = 0x10
const R_GSTS: u64 = 0x1C
const GSTS_TES: u64 = 0x80000000
const GSTS_IRES: u64 = 0x02000000
const GSTS_QIES: u64 = 0x04000000

fn onoff(bit: bool) {
    var s_on: [u8; 3] = "on\0"
    var s_off: [u8; 4] = "off\0"
    if bit {
        procw.put_s((&s_on[0]) as u64)
    } else {
        procw.put_s((&s_off[0]) as u64)
    }
}

fn unit_line(state: u64, i: u64, base: u64) {
    var s_u: [u8; 12] = "dmar: unit \0"
    var s_b: [u8; 7] = " base=\0"
    var s_v: [u8; 6] = " ver=\0"
    var s_c: [u8; 6] = " cap=\0"
    var s_e: [u8; 7] = " ecap=\0"
    var s_g: [u8; 7] = " gsts=\0"
    var s_t: [u8; 14] = " translation=\0"
    var s_i: [u8; 13] = " intr_remap=\0"
    var s_q: [u8; 12] = " inv_queue=\0"
    var s_un: [u8; 20] = " unmapped-or-absent\0"
    procw.put_s((&s_u[0]) as u64)
    procw.put_dec(i)
    procw.put_s((&s_b[0]) as u64)
    procw.put_hex(base, 8)
    var v: u64 = 0
    if base != 0 && (base & 0xFFF) == 0 {
        v = apic.map_device(state, base)
    }
    if v == 0 {
        procw.put_s((&s_un[0]) as u64)
        procw.put_c(10)
        return
    }
    let gsts: u64 = regio.read32(v + R_GSTS)
    procw.put_s((&s_v[0]) as u64)
    procw.put_hex(regio.read32(v + R_VER), 2)
    procw.put_s((&s_c[0]) as u64)
    procw.put_hex(__mmio_read64((v + R_CAP) as *mut u64), 16)
    procw.put_s((&s_e[0]) as u64)
    procw.put_hex(__mmio_read64((v + R_ECAP) as *mut u64), 16)
    procw.put_s((&s_g[0]) as u64)
    procw.put_hex(gsts, 8)
    procw.put_s((&s_t[0]) as u64)
    onoff((gsts & GSTS_TES) != 0)
    procw.put_s((&s_i[0]) as u64)
    onoff((gsts & GSTS_IRES) != 0)
    procw.put_s((&s_q[0]) as u64)
    onoff((gsts & GSTS_QIES) != 0)
    procw.put_c(10)
}

fn render(state: u64, out: u64, cap: u64) -> u64 {
    var w_sig: [u8; 5] = "DMAR\0"
    let t: u64 = acpi.table(state, (&w_sig[0]) as u64)
    var n: u64 = dmarparse.render(t, out, cap)
    if !dmarparse.ok(t) {
        return n
    }
    procw.begin_at(out, cap, n)
    var i: u64 = 0
    let units: u64 = dmarparse.drhd_count(t)
    while i < units && i < MAX_UNITS {
        unit_line(state, i, dmarparse.drhd_base(t, i))
        i = i + 1
    }
    return procw.used()
}
