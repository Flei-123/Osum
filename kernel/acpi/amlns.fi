// SPDX-License-Identifier: GPL-2.0-only
// kernel/acpi/amlns.fi -- AML ROUND, PART 1: THE NAMESPACE.
//
// AML is the language in which the firmware describes its devices. It
// sits as a byte stream in the DSDT and in the SSDTs, and it has two
// halves that must be kept apart:
//
//   * THE DECLARATIVE HALF -- Scope, Device, Method, Name,
//     OperationRegion, Field. It builds a TREE of names, and every name
//     is exactly four characters long. That is this file.
//   * THE EXECUTING HALF -- Store, If, While, Add, Index. It runs only
//     when somebody calls a method. That is `kernel/acpi/aml.fi`.
//
// WHY THE TREE IS NOT IN `kdata`. A DSDT from QEMU is 6476 bytes long and
// has 360 names; that of an ordinary laptop has ten times as many. A fixed
// area in `kdata` would either be too small or waste a quarter megabyte on
// every machine that does not need it. So the tree comes from the frame
// allocator (`mem.frame_run`) and goes back there after use -- and that
// is exactly what the acceptance run measures (`tools/aml/run.sh`,
// assertion "no leak").
//
// A NODE IS 32 BYTES:
//
//   +0   the four name bytes as a word ('P','R','Q','0')
//   +4   the parent node (index, 16 bit)
//   +6   the kind (NK_*)
//   +7   extra bits -- for a method the number of arguments
//   +8   a: name -> position in the AML; method -> start of the body;
//           region -> base address; field -> node of the region
//   +16  b: method -> end of the body; region -> length;
//           field -> bit offset; name -> cached object
//   +24  c: region -> address space; field -> bit width | access kind << 32
//
// The root node is index 0 and has no name ("\"). Every other node has a
// parent, and because a name has four bytes, comparing two names is ONE
// word comparison and not a character loop.

import lib.kstate
import serial

export {
    NONE, NODE_BYTES, NMAX, ARENA_FRAMES,
    NK_SCOPE, NK_DEVICE, NK_METHOD, NK_NAME, NK_REGION, NK_FIELD,
    NK_MUTEX, NK_EVENT, NK_PROC, NK_TZ, NK_POWER, NK_BUFFIELD, NK_ALIAS,
    arena, arena_end, nodes, node_at, node_name, node_parent, node_kind,
    node_flags, node_a, node_b, node_c,
    set_kind, set_flags, set_a, set_b, set_c,
    root_reset, child, add, walk, walk_create, path_out, path_write,
    heap_alloc, heap_used, heap_reset, heap_high, heap_mark,
    err, err_set, err_clear, save, restore, SAVED_WORDS, err_note, err_ctx, err_node, err_ctx_clear, CTX_REGION, ERR_OK, ERR_NOMEM, ERR_NODES, ERR_HEAP, ERR_TRUNC,
    ERR_OPCODE, ERR_DEPTH, ERR_BUDGET, ERR_TYPE, ERR_NOTFOUND,
    ERR_REGION, ERR_DIV0, ERR_NOPRT, ERR_NODSDT, ERR_ARG, ERR_FATAL,
    rd8, rd16, rd32, rd64, wr8, wr64,
    pkglen, seg_of, name_print
}

// "no node" -- 0 is the root and therefore a valid index.
// HOW BIG THE NAMESPACE MAY GROW. 8192 nodes are 256 KiB; QEMU's DSDT
// needs 360, the tables of the HP laptop about 5200. The arena is 256
// frames = 1 MiB, so 768 KiB remain as heap for buffers, packages and
// method frames. Both are stated here and nowhere else, and
// `tools/aml/run.sh` reads the numbers from this file instead of writing
// them down a second time.
const NMAX: u64 = 8192
const ARENA_FRAMES: u64 = 256

const NONE: u64 = 0xFFFFFFFF
const NODE_BYTES: u64 = 32

const NK_FREE: u64 = 0
const NK_SCOPE: u64 = 1
const NK_DEVICE: u64 = 2
const NK_METHOD: u64 = 3
const NK_NAME: u64 = 4
const NK_REGION: u64 = 5
const NK_FIELD: u64 = 6
const NK_MUTEX: u64 = 7
const NK_EVENT: u64 = 8
const NK_PROC: u64 = 9
const NK_TZ: u64 = 10
const NK_POWER: u64 = 11
const NK_BUFFIELD: u64 = 12
const NK_ALIAS: u64 = 13
const ALIAS_HOPS: u64 = 8

// The errors. Each is ONE number, and each number has exactly one reason
// -- an interpreter that says "did not work" is worthless on real
// hardware.
const ERR_OK: u64 = 0
const ERR_NOMEM: u64 = 1 // no frame run to be had
const ERR_NODES: u64 = 2 // the node table is full
const ERR_HEAP: u64 = 3 // the interpreter heap is full
const ERR_TRUNC: u64 = 4 // the AML ends in the middle of an object
const ERR_OPCODE: u64 = 5 // an opcode this interpreter does not know
const ERR_DEPTH: u64 = 6 // nested too deeply
const ERR_BUDGET: u64 = 7 // the step limit -- a loop does not end
const ERR_TYPE: u64 = 8 // an object of the wrong kind
const ERR_NOTFOUND: u64 = 9 // a name that does not exist
const ERR_REGION: u64 = 10 // an address space kind that does not exist here
const ERR_DIV0: u64 = 11 // division by zero
const ERR_NOPRT: u64 = 12 // no _PRT found
const ERR_NODSDT: u64 = 13 // no DSDT
const ERR_ARG: u64 = 14 // Arg/Local outside the frame
const ERR_FATAL: u64 = 15

// ---------------------------------------------------- the scalar slots
//
// They live in `kstate.AML_OFF`. The namespace itself lives in the
// arena, whose address is stored here.

const A_ARENA: u64 = 0 // start of the frame run, 0 = none
const A_FRAMES: u64 = 8 // how many frames long it is
const A_NODES: u64 = 16 // how many nodes are in use
const A_HEAP: u64 = 24 // next free byte of the heap (absolute)
const A_HEAPEND: u64 = 32 // end of the heap
const A_ERR: u64 = 40 // the error, see ERR_*
const SAVED_WORDS: u64 = 7
const A_ERRCTX: u64 = 2816
const A_ERRNODE: u64 = 2824
const CTX_REGION: u64 = 0x100000
const A_HEAPHI: u64 = 48 // high-water mark of the heap

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.AML_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.AML_OFF + off, v)
}

fn err(state: u64) -> u64 {
    return g(state, A_ERR)
}

// THE FIRST ERROR STAYS. An error that is overwritten by a later one no
// longer says where it started.
fn err_set(state: u64, e: u64) {
    if g(state, A_ERR) == ERR_OK {
        s(state, A_ERR, e)
    }
}

fn save(state: u64, out: u64) {
    var i: u64 = 0
    while i < SAVED_WORDS {
        wr64(out + i * 8, g(state, i * 8))
        i = i + 1
    }
}

fn restore(state: u64, from: u64) {
    var i: u64 = 0
    while i < SAVED_WORDS {
        s(state, i * 8, rd64(from + i * 8))
        i = i + 1
    }
}

fn err_clear(state: u64) {
    s(state, A_ERR, ERR_OK)
}

fn err_note(state: u64, ctx: u64, node: u64) {
    if g(state, A_ERR) == ERR_OK {
        s(state, A_ERRCTX, ctx)
        s(state, A_ERRNODE, node)
    }
}

fn err_ctx(state: u64) -> u64 {
    return g(state, A_ERRCTX)
}

fn err_node(state: u64) -> u64 {
    return g(state, A_ERRNODE)
}

fn err_ctx_clear(state: u64) {
    s(state, A_ERRCTX, 0)
    s(state, A_ERRNODE, 0)
}

// --------------------------------------------------- bytes and words

fn rd8(p: u64) -> u64 {
    return kstate.get8(p)
}

fn rd16(p: u64) -> u64 {
    return kstate.get8(p) | (kstate.get8(p + 1) << 8)
}

fn rd32(p: u64) -> u64 {
    return kstate.get32(p)
}

fn rd64(p: u64) -> u64 {
    return __mmio_read64(p as *mut u64)
}

fn wr8(p: u64, v: u64) {
    kstate.set8(p, (v & 0xFF) as u8)
}

fn wr64(p: u64, v: u64) {
    __mmio_write64(p as *mut u64, v)
}

// A PkgLength. The upper two bits of the first byte say how many bytes
// follow; at zero the rest of the first byte is already the whole length.
// The length COUNTS ITSELF.
// Returns the length and writes the position behind it to `out`.
fn pkglen(p: u64, out: u64) -> u64 {
    let lead: u64 = rd8(p)
    let extra: u64 = (lead >> 6) & 3
    if extra == 0 {
        wr64(out, p + 1)
        return lead & 0x3F
    }
    var v: u64 = lead & 0x0F
    var i: u64 = 0
    while i < extra {
        v = v | (rd8(p + 1 + i) << (4 + i * 8))
        i = i + 1
    }
    wr64(out, p + 1 + extra)
    return v
}

// Four name bytes as one word.
fn seg_of(p: u64) -> u64 {
    return rd8(p) | (rd8(p + 1) << 8) | (rd8(p + 2) << 16) | (rd8(p + 3) << 24)
}

// ------------------------------------------------------------ the arena

fn arena(state: u64) -> u64 {
    return g(state, A_ARENA)
}

fn arena_end(state: u64) -> u64 {
    return g(state, A_HEAPEND)
}

fn nodes(state: u64) -> u64 {
    return g(state, A_NODES)
}

fn node_at(state: u64, i: u64) -> u64 {
    return g(state, A_ARENA) + i * NODE_BYTES
}

fn node_name(state: u64, i: u64) -> u64 {
    return rd32(node_at(state, i))
}

fn node_parent(state: u64, i: u64) -> u64 {
    if i == 0 {
        return 0
    }
    return rd16(node_at(state, i) + 4)
}

fn node_kind(state: u64, i: u64) -> u64 {
    return rd8(node_at(state, i) + 6)
}

fn node_flags(state: u64, i: u64) -> u64 {
    return rd8(node_at(state, i) + 7)
}

fn node_a(state: u64, i: u64) -> u64 {
    return rd64(node_at(state, i) + 8)
}

fn node_b(state: u64, i: u64) -> u64 {
    return rd64(node_at(state, i) + 16)
}

fn node_c(state: u64, i: u64) -> u64 {
    return rd64(node_at(state, i) + 24)
}

fn set_kind(state: u64, i: u64, v: u64) {
    wr8(node_at(state, i) + 6, v)
}

fn set_flags(state: u64, i: u64, v: u64) {
    wr8(node_at(state, i) + 7, v)
}

fn set_a(state: u64, i: u64, v: u64) {
    wr64(node_at(state, i) + 8, v)
}

fn set_b(state: u64, i: u64, v: u64) {
    wr64(node_at(state, i) + 16, v)
}

fn set_c(state: u64, i: u64, v: u64) {
    wr64(node_at(state, i) + 24, v)
}

// The arena is obtained by `aml.fi` and entered here. `nmax` is the
// number of node slots; the heap starts behind them.
fn root_reset(state: u64, base: u64, nmax: u64, end: u64) {
    s(state, A_ARENA, base)
    s(state, A_NODES, 1)
    s(state, A_HEAP, base + nmax * NODE_BYTES)
    s(state, A_HEAPEND, end)
    s(state, A_HEAPHI, base + nmax * NODE_BYTES)
    s(state, A_ERR, ERR_OK)
    // The root node: no name, no parent, kind Scope.
    var i: u64 = 0
    while i < NODE_BYTES {
        wr8(base + i, 0)
        i = i + 1
    }
    wr8(base + 6, NK_SCOPE)
}

// --------------------------------------------------------------- heap
//
// A BUMP POINTER, NO FREEING. The whole run is given back at once; freeing
// single objects one by one would be a bookkeeping this interpreter does
// not need, and its lifetime questions are exactly the class of errors
// that most kernel exploits of 2023 came from (see docs/HANDLE-STATUS.md).
fn heap_alloc(state: u64, n: u64) -> u64 {
    let want: u64 = (n + 7) / 8 * 8
    let p: u64 = g(state, A_HEAP)
    if p + want > g(state, A_HEAPEND) {
        err_set(state, ERR_HEAP)
        return 0
    }
    s(state, A_HEAP, p + want)
    if p + want > g(state, A_HEAPHI) {
        s(state, A_HEAPHI, p + want)
    }
    var i: u64 = 0
    while i < want {
        wr8(p + i, 0)
        i = i + 1
    }
    return p
}

fn heap_mark(state: u64) -> u64 {
    return g(state, A_HEAP)
}

fn heap_used(state: u64) -> u64 {
    return g(state, A_HEAP) -% (g(state, A_ARENA) + nodes(state) * NODE_BYTES)
}

fn heap_high(state: u64) -> u64 {
    return g(state, A_HEAPHI) -% g(state, A_ARENA)
}

// The bump pointer back to an earlier state. With it a method call gives
// its frame back -- a stack, not a pile.
fn heap_reset(state: u64, p: u64) {
    if p >= g(state, A_ARENA) && p <= g(state, A_HEAP) {
        s(state, A_HEAP, p)
    }
}

// -------------------------------------------------- children and creation

// The child with this name, or NONE.
fn child(state: u64, parent: u64, name: u64) -> u64 {
    let n: u64 = nodes(state)
    var i: u64 = 1
    while i < n {
        if node_parent(state, i) == parent {
            if node_name(state, i) == name {
                return i
            }
        }
        i = i + 1
    }
    return NONE
}

// Create a node. Returns the index, or NONE if the table is full -- and
// then ERR_NODES is set.
fn add(state: u64, parent: u64, name: u64, kind: u64, nmax: u64) -> u64 {
    let n: u64 = nodes(state)
    if n >= nmax {
        err_set(state, ERR_NODES)
        return NONE
    }
    let p: u64 = node_at(state, n)
    var i: u64 = 0
    while i < NODE_BYTES {
        wr8(p + i, 0)
        i = i + 1
    }
    wr8(p, name & 0xFF)
    wr8(p + 1, (name >> 8) & 0xFF)
    wr8(p + 2, (name >> 16) & 0xFF)
    wr8(p + 3, (name >> 24) & 0xFF)
    wr8(p + 4, parent & 0xFF)
    wr8(p + 5, (parent >> 8) & 0xFF)
    wr8(p + 6, kind)
    s(state, A_NODES, n + 1)
    return n
}

// ------------------------------------------------------- a NameString
//
// THE SEARCH RULE OF THE SPECIFICATION (section 5.3). A single name
// segment without a prefix is searched from the current scope UPWARDS to
// the root -- that is why `Return(IQCR(PRQ0))` in `\_SB.LNKA._CRS` finds
// the method `\_SB.IQCR`. A name with '\' in front is absolute, a name
// with '^' goes up that many levels, a name with several segments is
// relative to the current scope.
//
// `out` receives the position behind the name. Returns: the node or NONE.
fn walk(state: u64, scope: u64, p: u64, out: u64) -> u64 {
    var node: u64 = walk_raw(state, scope, p, out)
    var hops: u64 = 0
    while node != NONE && node_kind(state, node) == NK_ALIAS && hops < ALIAS_HOPS {
        node = node_a(state, node)
        hops = hops + 1
    }
    return node
}

fn walk_raw(state: u64, scope: u64, p: u64, out: u64) -> u64 {
    var q: u64 = p
    var base: u64 = scope
    var rooted: u64 = 0
    if rd8(q) == 0x5C {
        base = 0
        rooted = 1
        q = q + 1
    } else {
        while rd8(q) == 0x5E {
            base = node_parent(state, base)
            rooted = 1
            q = q + 1
        }
    }
    let c: u64 = rd8(q)
    var cnt: u64 = 1
    if c == 0x00 {
        wr64(out, q + 1)
        return base
    }
    if c == 0x2E {
        cnt = 2
        q = q + 1
    }
    if c == 0x2F {
        cnt = rd8(q + 1)
        q = q + 2
    }
    wr64(out, q + cnt * 4)
    if cnt == 0 {
        return base
    }
    // A single segment without a prefix: search upwards.
    if rooted == 0 && cnt == 1 {
        let want: u64 = seg_of(q)
        var b: u64 = base
        while true {
            let hit: u64 = child(state, b, want)
            if hit != NONE {
                return hit
            }
            if b == 0 {
                return NONE
            }
            b = node_parent(state, b)
        }
    }
    // Otherwise: walk down the path from `base`.
    var cur: u64 = base
    var i: u64 = 0
    var ok: u64 = 1
    while i < cnt {
        var hit: u64 = child(state, cur, seg_of(q + i * 4))
        // The FIRST step of a relative path may be searched upwards -- the other
        // interpreters do that too, and without it `PCI0.S08` finds nothing when
        // the scope sits deeper than `\_SB`.
        if hit == NONE && i == 0 && rooted == 0 {
            var b: u64 = cur
            while hit == NONE {
                if b == 0 {
                    break
                }
                b = node_parent(state, b)
                hit = child(state, b, seg_of(q))
            }
        }
        if hit == NONE {
            ok = 0
            break
        }
        cur = hit
        i = i + 1
    }
    if ok == 0 {
        return NONE
    }
    return cur
}

// Like `walk`, but creates what is missing. The last node gets `kind`,
// the intermediate nodes become scopes.
fn walk_create(state: u64, scope: u64, p: u64, out: u64, kind: u64,
    nmax: u64) -> u64 {
    var q: u64 = p
    var base: u64 = scope
    if rd8(q) == 0x5C {
        base = 0
        q = q + 1
    } else {
        while rd8(q) == 0x5E {
            base = node_parent(state, base)
            q = q + 1
        }
    }
    let c: u64 = rd8(q)
    var cnt: u64 = 1
    if c == 0x00 {
        wr64(out, q + 1)
        return base
    }
    if c == 0x2E {
        cnt = 2
        q = q + 1
    }
    if c == 0x2F {
        cnt = rd8(q + 1)
        q = q + 2
    }
    wr64(out, q + cnt * 4)
    var cur: u64 = base
    var i: u64 = 0
    while i < cnt {
        let want: u64 = seg_of(q + i * 4)
        var hit: u64 = child(state, cur, want)
        // The FIRST segment of a relative path may be found upwards --
        // `Scope(\_SB.PCI0)` appears three times in QEMU's DSDT and means the
        // same node every time.
        if hit == NONE {
            var k: u64 = kind
            if i + 1 < cnt {
                k = NK_SCOPE
            }
            hit = add(state, cur, want, k, nmax)
            if hit == NONE {
                return NONE
            }
        }
        cur = hit
        i = i + 1
    }
    return cur
}

// ------------------------------------------------------- printing names

fn seg_print(v: u64) {
    // Leave out padding underscores at the END -- "PCI0" stays "PCI0",
    // "_SB_" becomes "_SB". An underscore in the MIDDLE of a name is a
    // character like any other and stays.
    var n: u64 = 4
    while n > 1 {
        if ((v >> ((n -% 1) * 8)) & 0xFF) != 95 {
            break
        }
        n = n -% 1
    }
    var i: u64 = 0
    while i < n {
        serial.put(((v >> (i * 8)) & 0xFF) as u8)
        i = i + 1
    }
}

// The full path of a node onto the line. Recursive over the parents --
// the depth of an ACPI namespace is a single digit.
fn path_out(state: u64, i: u64) {
    if i == 0 {
        serial.put(92 as u8) // '\'
        return
    }
    let par: u64 = node_parent(state, i)
    path_out(state, par)
    if par != 0 {
        serial.put(46 as u8) // '.'
    }
    seg_print(node_name(state, i))
}

const PATH_MAX_DEPTH: u64 = 12
const SEG_BYTES: u64 = 4
const SEG_PAD: u64 = 95
const PATH_ROOT: u64 = 92
const PATH_SEP: u64 = 46

fn seg_len(v: u64) -> u64 {
    var len: u64 = SEG_BYTES
    while len > 1 && ((v >> ((len - 1) * 8)) & 0xFF) == SEG_PAD {
        len = len - 1
    }
    return len
}

fn path_write(state: u64, node: u64, dst: u64, cap: u64) -> u64 {
    var segs: [u64; 12] = [0 as u64; 12]
    var depth: u64 = 0
    var cur: u64 = node
    while cur != 0 && cur != NONE && depth < PATH_MAX_DEPTH {
        segs[depth as usize] = node_name(state, cur)
        depth = depth + 1
        cur = node_parent(state, cur)
    }
    var w: u64 = 0
    wr8(dst, PATH_ROOT)
    w = 1
    var d: u64 = depth
    while d > 0 {
        d = d - 1
        let v: u64 = segs[d as usize]
        let len: u64 = seg_len(v)
        if w + len + 2 >= cap {
            break
        }
        var c: u64 = 0
        while c < len {
            wr8(dst + w, (v >> (c * 8)) & 0xFF)
            w = w + 1
            c = c + 1
        }
        if d > 0 {
            wr8(dst + w, PATH_SEP)
            w = w + 1
        }
    }
    wr8(dst + w, 0)
    return w
}

fn name_print(v: u64) {
    seg_print(v)
}
