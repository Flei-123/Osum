profile kernel

import acpi.amlsweep
import acpi.amlconf
import acpi.amlfuzz
import diag.cmdopt

export { run_if_asked }

fn run_if_asked(state: u64) {
    var w_sweep: [u8; 9] = "amlsweep\0"
    var w_conf: [u8; 8] = "amlconf\0"
    if cmdopt.has(state, (&w_sweep[0]) as u64) {
        amlsweep.run(state)
    }
    if cmdopt.has(state, (&w_conf[0]) as u64) {
        amlconf.run(state)
    }
    amlfuzz.run(state)
}
