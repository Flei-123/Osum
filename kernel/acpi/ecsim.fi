profile kernel

import serial
import pwr.blchain
import pwr.hotkeys
import acpi.ecio

export {
    tick
}

static mut dump: [u8; 2048] = [0 as u8; 2048]
static mut base: u64 = 0

fn tick(state: u64, n: u64) {
    if base == 0 {
        base = n
    }
    let t: u64 = n - base
    if t == 20 {
        blchain.set_percent(state, 50)
        ecio.sim_poke(4, 0x5A)
    }
    if t == 40 {
        ecio.sim_inject(0x11)
    }
    if t == 70 {
        ecio.sim_inject(0x12)
    }
    if t == 100 {
        ecio.sim_inject(0x99)
    }
    if t == 160 {
        var s_p: [u8; 12] = "ecsim: pct=\0"
        var s_o: [u8; 13] = "ecsim: outv=\0"
        var s_d: [u8; 12] = "ecsim: done\0"
        var s_x: [u8; 12] = "ecsim: dump\0"
        serial.puts((&s_o[0]) as u64)
        serial.dec(ecio.sim_peek(8))
        serial.nl()
        serial.puts((&s_x[0]) as u64)
        serial.nl()
        var i: u64 = 0
        while i < 2048 {
            dump[i as usize] = 0 as u8
            i = i + 1
        }
        hotkeys.render(state, (&dump[0]) as u64, 2048)
        serial.puts((&dump[0]) as u64)
        serial.puts((&s_p[0]) as u64)
        serial.dec(blchain.percent(state))
        serial.nl()
        serial.puts((&s_d[0]) as u64)
        serial.nl()
    }
}
