// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import arch.arch

export {
    configure, usable, status, enabled, clear, enable, disable,
    TMR, GBL, PWRBTN, SLPBTN, RTC, PCIEXP_WAKE, WAKE, BUTTON_BITS
}

const TMR: u64 = 0x0001
const GBL: u64 = 0x0020
const PWRBTN: u64 = 0x0100
const SLPBTN: u64 = 0x0200
const RTC: u64 = 0x0400
const PCIEXP_WAKE: u64 = 0x4000
const WAKE: u64 = 0x8000
const BUTTON_BITS: u64 = PWRBTN | SLPBTN | RTC
const WORD_MASK: u64 = 0xFFFF
const HALVES: u64 = 2

static mut sts_a: u64 = 0
static mut sts_b: u64 = 0
static mut half: u64 = 0

fn configure(block_a: u64, block_b: u64, evt_len: u64) {
    sts_a = block_a
    sts_b = block_b
    half = evt_len / HALVES
}

fn usable() -> bool {
    return (sts_a != 0 || sts_b != 0) && half != 0
}

fn rd(port: u64) -> u64 {
    return arch.dev_in16((port & WORD_MASK) as u16) as u64
}

fn wr(port: u64, v: u64) {
    arch.dev_out16((port & WORD_MASK) as u16, (v & WORD_MASK) as u16)
}

fn status() -> u64 {
    var v: u64 = 0
    if sts_a != 0 {
        v = v | rd(sts_a)
    }
    if sts_b != 0 {
        v = v | rd(sts_b)
    }
    return v
}

fn enabled() -> u64 {
    var v: u64 = 0
    if half == 0 {
        return 0
    }
    if sts_a != 0 {
        v = v | rd(sts_a + half)
    }
    if sts_b != 0 {
        v = v | rd(sts_b + half)
    }
    return v
}

fn clear(bits: u64) {
    if sts_a != 0 {
        wr(sts_a, bits)
    }
    if sts_b != 0 {
        wr(sts_b, bits)
    }
}

fn enable(bits: u64) {
    if half == 0 {
        return
    }
    if sts_a != 0 {
        wr(sts_a + half, rd(sts_a + half) | bits)
    }
    if sts_b != 0 {
        wr(sts_b + half, rd(sts_b + half) | bits)
    }
}

fn disable(bits: u64) {
    if half == 0 {
        return
    }
    if sts_a != 0 {
        wr(sts_a + half, rd(sts_a + half) & ~bits)
    }
    if sts_b != 0 {
        wr(sts_b + half, rd(sts_b + half) & ~bits)
    }
}
