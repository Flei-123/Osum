    stage, pump, irq, shared, ready, why, sci_gsi, gpe_armed, events, wakeups,
    lid_state, lid_present, batt_percent, batt_valid, batt_raw_full, batt_raw_rem, batt_full, batt_bif_status, batt_bst_status, batt_state, batt_present,
    ac_online, button_pending, button_take, take_change, changed,
    EV_NONE, EV_BUTTON, EV_LID, EV_BATT, EV_AC,
    LID_OPEN, LID_CLOSED, LID_UNKNOWN,
    report, selftest, wait_loop, ev_fake, fake_all, inject,
    irqs, sci_masked, sci_gsi_flags
}

const E_READY: u64 = 0
const E_WHY: u64 = 8
const E_SCI: u64 = 16
const E_PM1A: u64 = 24
const E_PM1B: u64 = 32
const E_ARMED: u64 = 80
const E_EVENTS: u64 = 88
const E_WAKE: u64 = 96
const E_PEND: u64 = 104
const E_BTN: u64 = 112
const E_CHANGED: u64 = 120
const E_LIDN: u64 = 128
const E_LIDDEV: u64 = 136
const E_LIDV: u64 = 144
const E_BATN: u64 = 152
const E_BSTN: u64 = 160
const E_BIFN: u64 = 168
const E_FULL: u64 = 176
const E_REM: u64 = 184
const E_BSTATE: u64 = 192
const E_PCT: u64 = 200
const E_BATOK: u64 = 208
const E_ACN: u64 = 216
const E_ACDEV: u64 = 224
const E_ACV: u64 = 232
const E_BTNDEV: u64 = 304
const E_ARENA: u64 = 240
const E_BTNSAID: u64 = 248
const E_EVLEN: u64 = 1104
const E_MODE: u64 = 320
const E_BONLY: u64 = 1152
const E_BEMPTY: u64 = 1160
const E_BMASKED: u64 = 1168
const E_BSEEN: u64 = 1176
const E_SHARED: u64 = 1184
const E_COK: u64 = 1192
const E_CPM1A: u64 = 1200
const E_CPM1B: u64 = 1208
const E_CTYPA: u64 = 1216
const E_CTYPB: u64 = 1224
const E_BVALID: u64 = 1232
const E_RAWFULL: u64 = 1240
const E_RAWREM: u64 = 1248
const E_BIFRET: u64 = 1256
const E_BSTRET: u64 = 1264
const E_KNOBS: u64 = 1272
const E_STORMLOG: u64 = 1280
const E_PM1STRAY: u64 = 1288
const E_STRAYBITS: u64 = 1296
const E_SCIFLAGS: u64 = 1304
const E_SCILEVEL: u64 = 1312
const E_SCILOW: u64 = 1320
const E_ECNEXT: u64 = 1328
const E_LIVENEXT: u64 = 1336
const E_SCIIRQ: u64 = 1344
const E_GPESTRAY: u64 = 1352
const E_SCIOVR: u64 = 1360
const BONLY_STORM: u64 = 64
const E_BTNN: u64 = 1144
const E_STSOR: u64 = 1136
const E_PUMPN: u64 = 1128
const E_IFSAID: u64 = 1120
const E_LIDTICK: u64 = 1112
const E_TICK: u64 = 312
const E_IRQN: u64 = 288
const E_LASTSTS: u64 = 296
const E_MN: u64 = 328
const E_MTAB: u64 = 336
const GPE_MAX: u64 = 32

const KNOB_NOSTORM: u64 = 1
const KNOB_NOSTRAY: u64 = 2
const KNOB_NOOVR: u64 = 4
const KNOB_STORMSIM: u64 = 8
const KNOB_GPELEVEL: u64 = 16

const EC_POLL_MS: u64 = 10
const LIVE_PERIOD_MS: u64 = 500
const NS_PER_MS: u64 = 1000000
const SCI_DEFAULT_LEVEL: bool = true
const SCI_DEFAULT_LOW: bool = true

// Why it does not run.
const WHY_OK: u64 = 0
const WHY_NOFADT: u64 = 1
const WHY_NOAML: u64 = 2 // the interpreter is not ready
const WHY_NONS: u64 = 3 // the namespace could not be held
const WHY_OFF: u64 = 4 // switched off with `noacpiev`
const WHY_NOSCI: u64 = 5 // the FADT names no line

// What has changed. A bit field, so that several changes between two
// queries are not lost.
const EV_NONE: u64 = 0
const EV_BUTTON: u64 = 1
const EV_LID: u64 = 2
const EV_BATT: u64 = 4
const EV_AC: u64 = 8

const LID_OPEN: u64 = 1
const LID_CLOSED: u64 = 0
const LID_UNKNOWN: u64 = 2

// The FADT fields this file needs (ACPI 6.4, table 5.9).
// `hw.fi` reads the same table for other fields; the offsets are
// deliberately stated twice, because they are read for DIFFERENT purposes
// and a shared set of constants would tie the two rounds together
// without either of them gaining anything from it.
const F_SCI_INT: u64 = 46
const F_PM1A_EVT: u64 = 56
const F_PM1B_EVT: u64 = 60
const F_GPE0: u64 = 80
const F_GPE1: u64 = 84
const F_PM1_EVT_LEN: u64 = 88
const F_GPE0_LEN: u64 = 92
const F_GPE1_LEN: u64 = 93
const F_GPE1_BASE: u64 = 94
const F_SMI_CMD: u64 = 48
const F_ACPI_ENABLE: u64 = 52
const F_PM1A_CNT: u64 = 64
const F_PM1B_CNT: u64 = 68

// The fixed events in PM1x_STS (ACPI 6.4, table 4.17).
// The same bits in the enable register PM1x_EN. It lies half a register
// length behind the status register -- that is what the specification
// says, and that is why PM1_EVT_LEN is read and not guessed.

// Bit 0 of PM1x_CNT. 1 = the events go to the operating system as SCI,
// 0 = they go to the firmware as SMI.
const SCI_EN: u64 = 1

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.ACPIEV_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.ACPIEV_OFF + off, v)
}

fn ready(state: u64) -> bool {
    return g(state, E_READY) == 1
}

fn why(state: u64) -> u64 {
    return g(state, E_WHY)
}

fn sci_gsi(state: u64) -> u64 {
    return g(state, E_SCI)
}

fn gpe_armed(state: u64) -> u64 {
    return g(state, E_ARMED)
}

fn events(state: u64) -> u64 {
    return g(state, E_EVENTS)
}

fn wakeups(state: u64) -> u64 {
    return g(state, E_WAKE)
}

fn lid_state(state: u64) -> u64 {
    return g(state, E_LIDV)
}

fn lid_present(state: u64) -> bool {
    return g(state, E_LIDN) != amlns.NONE && g(state, E_LIDN) != 0
}

fn batt_present(state: u64) -> bool {
    return g(state, E_BATOK) == 1
}

fn batt_valid(state: u64) -> bool {
    return g(state, E_BVALID) == 1
}

fn batt_raw_full(state: u64) -> u64 {
    return g(state, E_RAWFULL)
}

fn batt_raw_rem(state: u64) -> u64 {
    return g(state, E_RAWREM)
}

fn batt_full(state: u64) -> u64 {
    return g(state, E_FULL)
}

fn batt_bif_status(state: u64) -> u64 {
    return g(state, E_BIFRET)
}

fn batt_bst_status(state: u64) -> u64 {
    return g(state, E_BSTRET)
}

fn batt_percent(state: u64) -> u64 {
    return g(state, E_PCT)
}

fn batt_state(state: u64) -> u64 {
    return g(state, E_BSTATE)
}

fn ac_online(state: u64) -> bool {
    return g(state, E_ACV) == 1
}

fn button_pending(state: u64) -> bool {
    return g(state, E_BTN) != 0
}

// FETCHING the button: it reports ONCE, and whoever fetches it has it.
// Without the reset the energy menu would open again in every pass.
fn button_take(state: u64) -> bool {
    if g(state, E_BTN) == 0 {
        return false
    }
    s(state, E_BTN, 0)
    return true
}

fn changed(state: u64) -> u64 {
    return g(state, E_CHANGED)
}

// The same for the changes: read AND reset in one step. Two separate
// calls would be a race with the interrupt handler -- between `changed`
// and a `clear` an event could slip in that would then be lost.
fn take_change(state: u64) -> u64 {
    let v: u64 = g(state, E_CHANGED)
    if v != 0 {
        s(state, E_CHANGED, 0)
    }
    return v
}

fn mark(state: u64, bit: u64) {
    s(state, E_CHANGED, g(state, E_CHANGED) | bit)
}

// ------------------------------------------------------ the ports

fn in8(port: u64) -> u64 {
    return serial.in8((port & 0xFFFF) as u16) as u64
}

fn out8(port: u64, v: u64) {
    serial.out8((port & 0xFFFF) as u16, (v & 0xFF) as u8)
}

fn in16(port: u64) -> u64 {
    return arch.dev_in16((port & 0xFFFF) as u16) as u64
}

// ==================================================================
// FINDING THE DEVICES IN THE NAMESPACE
// ==================================================================
//
// The search goes by `_HID`, the identifier the specification assigns.
// It stands as a number in the DSDT (EisaId("PNP0C0D") is 0x0D0CD041 --
// the four letters at five bits per character), or as a string
// ("ACPI0003" for the adapter).
//
//   PNP0C0D  the lid
//   PNP0C0C  the power button
//   PNP0C0A  the battery
//   ACPI0003 the adapter
//
// The numbers are the encoding from ACPI 6.4 section 5.6.7 and are
// written out here because a kernel has nothing to calculate at run
// time that is already known. `tools/acpiev/hid.py` calculates the same
// numbers a second time and compares -- the same move as with
// `tools/aml/disasm.py`.
const HID_LID: u64 = 0x0D0CD041
const HID_PWRB: u64 = 0x0C0CD041
const HID_BATT: u64 = 0x0A0CD041
const HID_EC: u64 = 0x090CD041

// A child node with this name, or NONE.
fn child(state: u64, parent: u64, seg: u64) -> u64 {
    let n: u64 = amlns.nodes(state)
    var i: u64 = 1
    while i < n {
        if amlns.node_parent(state, i) == parent
            && amlns.node_name(state, i) == seg {
            return i
        }
        i = i + 1
    }
    return amlns.NONE
}

// The value of a `Name` node as a number. For `_HID`.
fn name_int(state: u64, node: u64) -> u64 {
    if node == amlns.NONE {
        return 0
    }
    var r: [u64; 3] = [0 as u64; 3]
    if !aml.eval_node(state, node, (&r[0]) as u64) {
        return 0
    }
    return amlobj.to_int((&r[0]) as u64)
}

// Look for a device with this `_HID`. Returns the DEVICE NODE.
fn find_hid(state: u64, want: u64) -> u64 {
    var w_hid: [u8; 5] = "_HID\0"
    let seg: u64 = amlns.seg_of((&w_hid[0]) as u64)
    let n: u64 = amlns.nodes(state)
    var i: u64 = 1
    while i < n {
        if amlns.node_kind(state, i) == amlns.NK_DEVICE {
            let h: u64 = child(state, i, seg)
            if h != amlns.NONE {
                if name_int(state, h) == want {
                    return i
                }
            }
        }
        i = i + 1
    }
    return amlns.NONE
}

// The same through a `_HID` as a STRING ("ACPI0003"). The adapter is
// written that way, and a number would be wrong here.
fn find_hid_str(state: u64, txt: u64) -> u64 {
    var w_hid: [u8; 5] = "_HID\0"
    let seg: u64 = amlns.seg_of((&w_hid[0]) as u64)
    let n: u64 = amlns.nodes(state)
    var i: u64 = 1
    while i < n {
        if amlns.node_kind(state, i) == amlns.NK_DEVICE {
            let h: u64 = child(state, i, seg)
            if h != amlns.NONE {
                var r: [u64; 3] = [0 as u64; 3]
                if aml.eval_node(state, h, (&r[0]) as u64) {
                    if amlobj.otype((&r[0]) as u64) == amlobj.OT_STR {
                        if streq(amlobj.ov1((&r[0]) as u64), txt) {
                            return i
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return amlns.NONE
}

fn streq(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while i < 64 {
        let x: u64 = amlns.rd8(a + i)
        let y: u64 = amlns.rd8(b + i)
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

// ==================================================================
// COLLECTING THE GPE METHODS
// ==================================================================
//
// Under `\_GPE` there are methods whose NAME carries the bit number:
// `_L1B` is bit 0x1B, level triggered; `_E03` is bit 0x03, edge
// triggered. Two hex digits, and exactly two.

const M_LEVEL: u64 = 0
const M_EDGE: u64 = 1

fn hexval(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return 0xFF
}

// From a name like `_L1B` the bit number and the kind. Returns 0xFFFF if
// the name is not a GPE method.
fn gpe_of_name(seg: u64) -> u64 {
    if (seg & 0xFF) != 0x5F { // '_'
        return 0xFFFF
    }
    let k: u64 = (seg >> 8) & 0xFF
    var art: u64 = 0xFF
    if k == 0x4C { // 'L'
        art = M_LEVEL
    }
    if k == 0x45 { // 'E'
        art = M_EDGE
    }
    if art == 0xFF {
        return 0xFFFF
    }
    let h: u64 = hexval((seg >> 16) & 0xFF)
    let l: u64 = hexval((seg >> 24) & 0xFF)
    if h == 0xFF || l == 0xFF {
        return 0xFFFF
    }
    return ((h * 16 + l) << 1) | art
}

fn meth_n(state: u64) -> u64 {
    return g(state, E_MN)
}

fn meth_bit(state: u64, i: u64) -> u64 {
    return g(state, E_MTAB + i * 24)
}

fn meth_node(state: u64, i: u64) -> u64 {
    return g(state, E_MTAB + i * 24 + 8)
}

fn meth_art(state: u64, i: u64) -> u64 {
    return g(state, E_MTAB + i * 24 + 16)
}

fn meth_find(state: u64, bit: u64) -> u64 {
    let n: u64 = meth_n(state)
    var i: u64 = 0
    while i < n {
        if meth_bit(state, i) == bit {
            return i
        }
        i = i + 1
    }
    return 0xFFFF
}

// Collect all `_Lxx`/`_Exx` under `\_GPE`.
fn collect_gpe(state: u64) {
    var w_gpe: [u8; 5] = "_GPE\0"
    let gseg: u64 = amlns.seg_of((&w_gpe[0]) as u64)
    let n: u64 = amlns.nodes(state)
    var cnt: u64 = 0
    var i: u64 = 1
    while i < n {
        if amlns.node_kind(state, i) == amlns.NK_METHOD && cnt < GPE_MAX {
            // The parent node must be called `\_GPE`. A method `_L18` anywhere else
            // is NOT a GPE method -- and such methods exist: some firmware names its
            // helper routines that way.
            let par: u64 = amlns.node_parent(state, i)
            if par != amlns.NONE && amlns.node_name(state, par) == gseg {
                let v: u64 = gpe_of_name(amlns.node_name(state, i))
                if v != 0xFFFF {
                    s(state, E_MTAB + cnt * 24, v >> 1)
                    s(state, E_MTAB + cnt * 24 + 8, i)
                    s(state, E_MTAB + cnt * 24 + 16, v & 1)
                    cnt = cnt + 1
                }
            }
        }
        i = i + 1
    }
    s(state, E_MN, cnt)
}

fn now_ms(state: u64) -> u64 {
    return time.mono_ns(state) / NS_PER_MS
}

fn knob(state: u64, mask: u64) -> bool {
    return (g(state, E_KNOBS) & mask) != 0
}

fn read_knobs(state: u64) {
    var w_nostorm: [u8; 11] = "noscistorm\0"
    var w_nostray: [u8; 11] = "noscistray\0"
    var w_noovr: [u8; 9] = "scinoovr\0"
    var w_stormsim: [u8; 9] = "scistorm\0"
    var w_gpelevel: [u8; 9] = "scigpelv\0"
    var k: u64 = 0
    if cmdopt.has(state, (&w_nostorm[0]) as u64) {
        k = k | KNOB_NOSTORM
    }
    if cmdopt.has(state, (&w_nostray[0]) as u64) {
        k = k | KNOB_NOSTRAY
    }
    if cmdopt.has(state, (&w_noovr[0]) as u64) {
        k = k | KNOB_NOOVR
    }
    if cmdopt.has(state, (&w_stormsim[0]) as u64) {
        k = k | KNOB_STORMSIM
    }
    if cmdopt.has(state, (&w_gpelevel[0]) as u64) {
        k = k | KNOB_GPELEVEL
    }
    s(state, E_KNOBS, k)
}

fn button_press(state: u64) {
    s(state, E_BTN, 1)
    s(state, E_BTNN, g(state, E_BTNN) + 1)
    mark(state, EV_BUTTON)
}

fn pend_method(state: u64, bit: u64) -> bool {
    let i: u64 = meth_find(state, bit)
    if i == 0xFFFF {
        return false
    }
    let w: u64 = E_PEND + (i / 64) * 8
    s(state, w, g(state, w) | (1 << (i & 63)))
    hkdiag.add(hkdiag.GPE_FIRED, 1)
    return true
}

fn service_pm1(state: u64) -> bool {
    var found: bool = false
    let sts: u64 = pm1.status()
    let en: u64 = pm1.enabled()
    s(state, E_LASTSTS, sts)
    s(state, E_STSOR, g(state, E_STSOR) | sts)
    if (sts & pm1.PWRBTN) != 0 {
        pm1.clear(pm1.PWRBTN)
        button_press(state)
        found = true
    }
    let quiet_bits: u64 = sts & (pm1.SLPBTN | pm1.RTC)
    if quiet_bits != 0 {
        pm1.clear(quiet_bits)
        found = true
    }
    let stray: u64 = sts & en & ~pm1.BUTTON_BITS
    if stray != 0 && !knob(state, KNOB_NOSTRAY) {
        pm1.clear(stray)
        pm1.disable(stray)
        s(state, E_PM1STRAY, g(state, E_PM1STRAY) + 1)
        s(state, E_STRAYBITS, g(state, E_STRAYBITS) | stray)
        found = true
    }
    return found
}

fn service_gpe(state: u64) -> bool {
    if !gpe.usable() {
        return false
    }
    let before: u64 = gpe.strays()
    let n: u64 = gpe.scan()
    var found: bool = false
    var k: u64 = 0
    while k < n {
        if pend_method(state, gpe.pending_bit(k)) {
            found = true
        }
        k = k + 1
    }
    if gpe.strays() != before {
        s(state, E_GPESTRAY, gpe.strays())
        found = true
    }
    return found
}

fn service(state: u64) -> bool {
    let pm: bool = service_pm1(state)
    let ge: bool = service_gpe(state)
    if pm || ge {
        s(state, E_WAKE, g(state, E_WAKE) + 1)
        return true
    }
    return false
}

fn irq_button_only(state: u64, guard: bool) {
    let sts: u64 = pm1.status()
    s(state, E_LASTSTS, sts)
    s(state, E_STSOR, g(state, E_STSOR) | sts)
    if sts == 0 {
        let e: u64 = g(state, E_BEMPTY) + 1
        s(state, E_BEMPTY, e)
        if guard && e >= BONLY_STORM && g(state, E_BMASKED) == 0 {
            apic.mask_gsi(state, g(state, E_SCI))
            s(state, E_BMASKED, 1)
        }
        return
    }
    s(state, E_BEMPTY, 0)
    pm1.clear(sts)
    if (sts & pm1.PWRBTN) != 0 {
        button_press(state)
        s(state, E_WAKE, g(state, E_WAKE) + 1)
    }
}

fn capture_storm(state: u64) {
    scidiag.snapshot(apic.gsi_entry(state, g(state, E_SCI)))
}

fn storm_cut(state: u64) {
    capture_storm(state)
    apic.mask_gsi(state, g(state, E_SCI))
    scistorm.set_masked(now_ms(state))
    s(state, E_STORMLOG, 1)
}

fn irq_entry(state: u64, guard: bool) {
    s(state, E_IRQN, g(state, E_IRQN) + 1)
    if g(state, E_READY) != 1 {
        if g(state, E_BONLY) == 1 {
            irq_button_only(state, guard)
        }
        return
    }
    if service(state) {
        scistorm.quiet()
        return
    }
    if guard && !knob(state, KNOB_NOSTORM) && scistorm.empty() {
        storm_cut(state)
    }
}

fn irq(state: u64) {
    irq_entry(state, true)
}

fn shared(state: u64, vector: u64) {
    let ready: u64 = g(state, E_READY)
    if ready != 1 && g(state, E_BONLY) != 1 {
        return
    }
    if (apic.gsi_entry(state, g(state, E_SCI)) & 0xFF) != vector {
        return
    }
    s(state, E_SHARED, g(state, E_SHARED) + 1)
    if ready == 1 {
        irq_entry(state, false)
    } else {
        irq_button_only(state, false)
    }
}

fn irqs(state: u64) -> u64 {
    return g(state, E_IRQN)
}

fn sci_masked(state: u64) -> bool {
    return scistorm.masked() || g(state, E_BMASKED) == 1
}

fn sci_gsi_flags(state: u64) -> u64 {
    return g(state, E_SCIFLAGS)
}

// Button-only diagnostics from task context (never from the handler): a line every 5 s and one on every change of the
// entry count, so the counters are on the serial line BEFORE a press as well as after it.
fn bonly_diag(state: u64) {
    let n: u64 = g(state, E_IRQN) + g(state, E_SHARED)
    let tick: u64 = g(state, E_PUMPN)
    if n == g(state, E_BSEEN) && (tick % 500) != 0 {
        return
    }
    if n != g(state, E_BSEEN) && (tick % 10) != 0 {
        return
    }
    s(state, E_BSEEN, n)
    var s_a: [u8; 20] = "acpiev: bonly irqs=\0"
    var s_b: [u8; 8] = " btnn=\0\0"
    var s_c: [u8; 9] = " empty=\0\0"
    var s_d: [u8; 9] = " masked=\0"
    var s_e: [u8; 6] = " sts=\0"
    var s_f: [u8; 7] = " sci=\0\0"
    var s_g: [u8; 9] = " ioapic=\0"
    var s_h: [u8; 7] = " pm1s=\0"
    var s_sh: [u8; 9] = " shared=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(n)
    serial.puts((&s_b[0]) as u64)
    serial.dec(g(state, E_BTNN))
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, E_BEMPTY))
    serial.puts((&s_d[0]) as u64)
    serial.dec(g(state, E_BMASKED))
    serial.puts((&s_e[0]) as u64)
    serial.hex_width(g(state, E_LASTSTS), 4)
    serial.puts((&s_f[0]) as u64)
    serial.dec(g(state, E_SCI))
    serial.puts((&s_g[0]) as u64)
    serial.hex_width(apic.gsi_entry(state, g(state, E_SCI)), 8)
    serial.puts((&s_h[0]) as u64)
    serial.hex_width(pm1.status(), 4)
    serial.puts((&s_sh[0]) as u64)
    serial.dec(g(state, E_SHARED))
    serial.nl()
}

fn pump(state: u64) {
    blchain.service(state)
    // RIGHT AT THE TOP, BEFORE ANY CONDITION. A counter behind the first
    // guard does not measure whether the function is called but whether it
    // gets through -- and that was exactly the difference between "pumpn=0"
    // and "the lines are there after all" while searching.
    s(state, E_PUMPN, g(state, E_PUMPN) + 1)
    if g(state, E_READY) != 1 {
        if g(state, E_BONLY) == 1 {
            bonly_diag(state)
        }
        return
    }
    // THE BUTTON. It is a FIXED event and hangs on no GPE bit; the handler
    // has only noted it.
    // MEASURED AND CORRECTED: here stood `E_BTN == 1`, that is the word that
    // `button_take` CLEARS when fetching. As soon as a program in ring 3
    // queries the button -- the bar does that every pass, the launcher too --
    // it was gone before this line could see it. The output then showed
    // `irqs=1 stsor=0x0101` (the handler HAS read the button bit) and still
    // no `ev taste`: the message hung on a word that somebody else had just
    // fetched.
    //
    // So it is counted with `E_BTNN`, and nobody clears that.
    if g(state, E_BTNN) != g(state, E_BTNSAID) {
        s(state, E_BTNSAID, g(state, E_BTNN))
        s(state, E_EVENTS, g(state, E_EVENTS) + 1)
        var s_b: [u8; 20] = "acpiev: ev taste\0\0\0\0"
        serial.puts((&s_b[0]) as u64)
        serial.nl()
        // ALWAYS, not only with `evdump`: this is THE event of this round, and
        // this line is the acceptance.
        report(state)
    }

    // WITH `evdump` ONE LINE EVERY HUNDRED PASSES. Without it, "nothing
    // arrives" cannot be told from "the handler does not run at all" -- and
    // exactly these two cases had to be separated on the first run of this
    // round.
    if kstate.mode_on(state, kstate.M_EVDUMP) {
        s(state, E_TICK, g(state, E_TICK) + 1)
        if (g(state, E_TICK) % 200) == 0 {
            // RAW PM1a_STS, straight from the port. If bit 8 shows up here, QEMU HAS
            // reported the button and it is the interrupt that is at fault; if it
            // never shows up, QEMU has not reported it at all. That separates the two
            // cases.
            var s_rs: [u8; 16] = "acpiev: pm1sts=\0"
            var s_pk: [u8; 8] = " pumpn=\0"
            var s_ik: [u8; 7] = " irqs=\0"
            serial.puts((&s_rs[0]) as u64)
            serial.hex_width(pm1.status(), 4)
            serial.puts((&s_pk[0]) as u64)
            serial.dec(g(state, E_PUMPN))
            serial.puts((&s_ik[0]) as u64)
            serial.dec(g(state, E_IRQN))
            var s_or: [u8; 8] = " stsor=\0"
            serial.puts((&s_or[0]) as u64)
            serial.hex_width(g(state, E_STSOR), 4)
            serial.nl()
        }
    }
    // Report ONCE whether interrupts are ON at all. Without it, "the SCI does
    // not arrive" cannot be told from "this kernel accepts no interrupts at
    // all" -- and exactly these two cases had to be separated in desktop
    // operation.
    if g(state, E_IFSAID) == 0 {
        s(state, E_IFSAID, 1)
        // ONLY READ, do NOT lock: the versions in klog.fi and audio.fi append a
        // `cli` because they open a lock. Nothing is to be locked here.
        let fl: u64 = asm("pushfq\npop rax", out("rax"))
        var s_if: [u8; 16] = "acpiev: rflags=\0"
        serial.puts((&s_if[0]) as u64)
        serial.hex_width(fl, 4)
        // And at once the entry in the I/O APIC AND the enable register, both NOW
        // and not at setup. Whoever reads both at the right time sees whether a
        // later round has closed them again.
        var s_i2: [u8; 9] = " ioapic=\0"
        var s_p2: [u8; 8] = " pm1en=\0"
        var s_s2: [u8; 6] = " sts=\0"
        serial.puts((&s_i2[0]) as u64)
        serial.hex_width(apic.gsi_entry(state, g(state, E_SCI)), 8)
        serial.puts((&s_p2[0]) as u64)
        serial.hex_width(pm1.enabled(), 4)
        serial.puts((&s_s2[0]) as u64)
        serial.hex_width(pm1.status(), 4)
        serial.nl()
    }
    // ============================== ROUND ACPI-EVENTS: `evlid`
    //
    // CLOSING THE LID BY HAND, ONCE, AFTER A WHILE.
    //
    // QEMU has no lid device -- there is nothing on this machine that would
    // pull the GPE bit. For the PICTURE of the acceptance run (the lock
    // screen must come) it needs a lid that closes while the desktop is
    // already up, though. So the kernel counts the passes and closes it at
    // the two-thousandth -- that is about half a minute after the start, long
    // after everything has been painted.
    //
    // WHAT IS NOT MEASURED BY THIS stands here as everywhere in this round:
    // that a real board pulls the bit. Everything behind it is measured --
    // the method, the `Notify`, `_LID`, and that the lock screen really
    // comes.
    if kstate.mode_on(state, kstate.M_EVLID) {
        s(state, E_LIDTICK, g(state, E_LIDTICK) + 1)
        if g(state, E_LIDTICK) == 2000 {
            fake_set(state, 0, g(state, E_PCT), 1, 0)
            let _l: bool = ev_fake(state, 3)
        }
    }
    poll_masked(state)
    let n: u64 = meth_n(state)
    var i: u64 = 0
    while i < n {
        let w: u64 = E_PEND + (i / 64) * 8
        let m: u64 = 1 << (i & 63)
        if (g(state, w) & m) != 0 {
            s(state, w, g(state, w) & (~m))
            run_gpe(state, i)
            s(state, E_EVENTS, g(state, E_EVENTS) + 1)
            if kstate.mode_on(state, kstate.M_EVDUMP) {
                var s_g: [u8; 18] = "acpiev: ev gpe b=\0"
                serial.puts((&s_g[0]) as u64)
                serial.hex_width(meth_bit(state, i), 2)
                serial.nl()
            }
        }
        i = i + 1
    }
    service_ec(state)
    sync_diag(state)
    report_storm(state)
    thermal.poll(state)
    if kstate.mode_on(state, kstate.M_ECSIM) {
        ecsim.tick(state, g(state, E_PUMPN))
    }
}

fn poll_masked(state: u64) {
    if !scistorm.masked() {
        return
    }
    if scistorm.poll_due(now_ms(state)) {
        if service(state) {
            scistorm.quiet()
        }
    }
}

fn report_storm(state: u64) {
    if g(state, E_STORMLOG) == 0 {
        return
    }
    s(state, E_STORMLOG, 0)
    var s_a: [u8; 23] = "acpiev: sci storm gsi=\0"
    var s_b: [u8; 9] = " empty=\0\0"
    var s_c: [u8; 8] = " irqs=\0\0"
    var s_d: [u8; 8] = " entry=\0"
    var s_e: [u8; 9] = " pm1sts=\0"
    var s_f: [u8; 9] = " pm1en=\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(g(state, E_SCI))
    serial.puts((&s_b[0]) as u64)
    serial.dec(scistorm.empties())
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, E_IRQN))
    serial.puts((&s_d[0]) as u64)
    serial.hex_width(apic.gsi_entry(state, g(state, E_SCI)), 8)
    serial.puts((&s_e[0]) as u64)
    serial.hex_width(pm1.status(), 4)
    serial.puts((&s_f[0]) as u64)
    serial.hex_width(pm1.enabled(), 4)
    serial.nl()
}

fn print_override(prefix: u64, irq: u64, gsi: u64, flags: u64) {
    var s_i: [u8; 6] = " irq=\0"
    var s_g: [u8; 6] = " gsi=\0"
    var s_f: [u8; 8] = " flags=\0"
    serial.puts(prefix)
    serial.puts((&s_i[0]) as u64)
    serial.dec(irq)
    serial.puts((&s_g[0]) as u64)
    serial.dec(gsi)
    serial.puts((&s_f[0]) as u64)
    serial.hex_width(flags, 4)
}

fn report_route(state: u64) {
    var s_r: [u8; 14] = "acpiev: route\0"
    var s_l: [u8; 8] = " level=\0"
    var s_w: [u8; 6] = " low=\0"
    var s_o: [u8; 6] = " ovr=\0"
    var s_p: [u8; 14] = "acpiev: ovr\0\0\0"
    print_override((&s_r[0]) as u64, g(state, E_SCIIRQ), g(state, E_SCI), g(state, E_SCIFLAGS))
    serial.puts((&s_l[0]) as u64)
    serial.dec(g(state, E_SCILEVEL))
    serial.puts((&s_w[0]) as u64)
    serial.dec(g(state, E_SCILOW))
    serial.puts((&s_o[0]) as u64)
    serial.dec(g(state, E_SCIOVR))
    serial.nl()
    var k: u64 = 0
    while k < irqovr.count() {
        let irq: u64 = irqovr.irq_at(k)
        print_override((&s_p[0]) as u64, irq, irqovr.gsi_for(irq), irqovr.flags_for(irq))
        serial.nl()
        k = k + 1
    }
}

fn selftest_xapc(state: u64) {
    var w_x: [u8; 5] = "XAPC\0"
    var s_p: [u8; 15] = "acpiev: xapc\0\0\0"
    let t: u64 = acpi.table(state, (&w_x[0]) as u64)
    if t == 0 {
        return
    }
    let n: u64 = irqovr.parse_table(t)
    var k: u64 = 0
    while k < n {
        let irq: u64 = irqovr.irq_at(k)
        print_override((&s_p[0]) as u64, irq, irqovr.gsi_for(irq), irqovr.flags_for(irq))
        serial.nl()
        k = k + 1
    }
    let _o: u64 = irqovr.parse(state)
}

static mut diag_text: [u8; 1024] = [0 as u8; 1024]

fn dump_diag(state: u64) {
    sync_diag(state)
    procw.begin((&diag_text[0]) as u64, 1024)
    scidiag.render()
    serial.puts((&diag_text[0]) as u64)
}

fn selftest_defer(state: u64) {
    var w_defer: [u8; 9] = "scidefer\0"
    var s_d: [u8; 22] = "acpiev: defer before=\0"
    var s_q: [u8; 9] = " queued=\0"
    var s_a: [u8; 8] = " after=\0"
    if !cmdopt.has(state, (&w_defer[0]) as u64) {
        return
    }
    let _set: u64 = blchain.set_percent(state, 50)
    let _taken: bool = blchain.on_ext_key(state, 0x6F)
    let before: u64 = blchain.percent(state)
    let queued: u64 = blchain.deferred()
    blchain.service(state)
    serial.puts((&s_d[0]) as u64)
    serial.dec(before)
    serial.puts((&s_q[0]) as u64)
    serial.dec(queued)
    serial.puts((&s_a[0]) as u64)
    serial.dec(blchain.percent(state))
    serial.nl()
}

fn selftest_ecrate(state: u64) {
    var s_e: [u8; 26] = "acpiev: selftest ecrate p\0"
    var s_p: [u8; 7] = "olls=\0\0"
    let before: u64 = hkdiag.get(hkdiag.EC_POLLS)
    var k: u64 = 0
    while k < 2000 {
        service_ec(state)
        k = k + 1
    }
    serial.puts((&s_e[0]) as u64)
    serial.puts((&s_p[0]) as u64)
    serial.dec(hkdiag.get(hkdiag.EC_POLLS) - before)
    serial.nl()
}

fn run_gpe(state: u64, idx: u64) {
    let bit: u64 = meth_bit(state, idx)
    if run_node(state, meth_node(state, idx), true) {
        gpe.finish(bit)
        return
    }
    gpe.fail(bit)
    var s_f: [u8; 19] = "acpiev: gpe off b=\0"
    serial.puts((&s_f[0]) as u64)
    serial.hex_width(bit, 2)
    serial.nl()
}

fn run_node(state: u64, node: u64, refresh: bool) -> bool {
    if node == amlns.NONE {
        return false
    }
    amlev.not_clear(state)
    amlev.depth_reset(state)
    var r: [u64; 3] = [0 as u64; 3]
    if !aml.eval_node(state, node, (&r[0]) as u64) {
        // A method that fails must not stop the kernel. The error is in the log,
        // the bit is cleared, the machine keeps running.
        var s_e: [u8; 22] = "acpiev: gpe fehler b=\0"
        serial.puts((&s_e[0]) as u64)
        serial.hex_width(node, 4)
        serial.nl()
        amlns.err_set(state, amlns.ERR_OK)
        return false
    }
    // What did it report?
    let cnt: u64 = amlev.not_count(state)
    var j: u64 = 0
    while j < cnt {
        handle_notify(state, amlev.not_node(state, j),
            amlev.not_code(state, j))
        j = j + 1
    }
    // NO `Notify`, but an event: some firmware relies on the operating system
    // re-reading everything after a GPE anyway. So what belongs to the bit is
    // re-read.
    if cnt == 0 && refresh {
        refresh_all(state)
    }
    return true
}

fn service_ec(state: u64) {
    let now: u64 = now_ms(state)
    if now < g(state, E_ECNEXT) {
        return
    }
    s(state, E_ECNEXT, now + EC_POLL_MS)
    var n: u64 = 0
    while n < 8 {
        let q: u64 = ecio.poll_query()
        if q == ecio.NO_QUERY {
            return
        }
        let node: u64 = ec.query_node(state, q)
        if node == amlns.NONE {
            hkdiag.add(hkdiag.EC_QMISSING, 1)
        } else {
            hkdiag.add(hkdiag.EC_QRUN, 1)
            let _ran: bool = run_node(state, node, false)
        }
        n = n + 1
    }
}

fn sync_diag(state: u64) {
    hkdiag.set(hkdiag.SCI_IRQS, g(state, E_IRQN))
    hkdiag.set(hkdiag.SCI_SHARED, g(state, E_SHARED))
    hkdiag.set(hkdiag.SCI_WAKE, g(state, E_WAKE))
    hkdiag.set(hkdiag.SCI_EVENTS, g(state, E_EVENTS))
    hkdiag.set(hkdiag.GPE_ARMED, g(state, E_ARMED))
    scidiag.set(scidiag.S_GSI, g(state, E_SCI))
    scidiag.set(scidiag.S_IRQ, g(state, E_SCIIRQ))
    scidiag.set(scidiag.S_FLAGS, g(state, E_SCIFLAGS))
    scidiag.set(scidiag.S_LEVEL, g(state, E_SCILEVEL))
    scidiag.set(scidiag.S_LOW, g(state, E_SCILOW))
    scidiag.set(scidiag.S_IRQS, g(state, E_IRQN))
    scidiag.set(scidiag.S_SHARED, g(state, E_SHARED))
    scidiag.set(scidiag.S_STRAY_PM1, g(state, E_PM1STRAY))
    scidiag.set(scidiag.S_STRAY_GPE, g(state, E_GPESTRAY))
    scidiag.set(scidiag.S_ARMED, g(state, E_ARMED))
    scidiag.set(scidiag.S_GPE_MASKED, gpe.masked_total())
    scidiag.set(scidiag.S_GPE_FAILED, gpe.failed())
}

// Attribute a `Notify(device, code)`. The code 0x80 means "have a look"
// for all three, 0x81 for the battery "the description has changed".
fn handle_notify(state: u64, node: u64, code: u64) {
    hkdiag.add(hkdiag.NOTIFY_N, 1)
    hkdiag.set(hkdiag.NOTIFY_LAST, code)
    if node == g(state, E_LIDDEV) && node != amlns.NONE {
        read_lid(state)
        return
    }
    if node == g(state, E_BATN) && node != amlns.NONE {
        // 0x81 means "the description has changed" -- then `_BIF` MUST be read
        // again (a swapped battery has a different full charge). And if it is not
        // known at all yet, likewise: see `refresh_all`.
        if code == 0x81 || g(state, E_FULL) == 0 {
            read_bif(state)
        }
        read_bst(state)
        return
    }
    if node == g(state, E_ACDEV) && node != amlns.NONE {
        read_ac(state)
        // Mains or not changes the battery state as well.
        read_bst(state)
        return
    }
    if node == g(state, E_BTNDEV) && node != amlns.NONE {
        s(state, E_BTN, 1)
        mark(state, EV_BUTTON)
        return
    }
    if code >= 0x85 && code <= 0x88 {
        blchain.on_notify(state, code)
        return
    }
    hotkeys.notify_action(state, code)
    // A device we do not know. Not an error -- a board also reports thermal
    // zones and slots.
}

fn refresh_all(state: u64) {
    read_lid(state)
    // `_BIF` FIRST, AND ALWAYS WHEN THE FULL CHARGE IS STILL MISSING.
    //
    // MEASURED AND CORRECTED. The first version read `_BIF` only on
    // `Notify(..., 0x81)` -- that is what the specification says, and it is
    // also right: 0x80 means "the state has changed", 0x81 "the description".
    // Only no board sends a 0x81 at start, and without `_BIF` there is no
    // last full charge -- and without that no percentage.
    //
    // In the output it looked like this, and it is exactly the kind of
    // number that separates a claim from a measurement:
    //
    //     acpiev: bst node=366 typ=4 n=4 rem=3850 full=0
    //
    // So `_BST` ran, the package was right, the remaining capacity was, to
    // the byte, what the AML method had calculated (77 * 50 = 3850) -- and
    // the percentage stayed 0 anyway, because the denominator was missing.
    if g(state, E_FULL) == 0 {
        read_bif(state)
    }
    read_bst(state)
    read_ac(state)
}

// ------------------------------------------------------ the queries

// The i-th element of a package as a number. A package that is shorter
// than expected gives 0 -- a firmware that returns `_BST` with three
// instead of four elements must not make the kernel read beyond the end
// of the package.
fn pkg_int(state: u64, o: u64, i: u64) -> u64 {
    if amlobj.otype(o) != amlobj.OT_PKG {
        return 0
    }
    if i >= amlobj.ov2(o) {
        return 0
    }
    var e: [u64; 3] = [0 as u64; 3]
    amlobj.ocopy((&e[0]) as u64, amlobj.pkg_at(o, i))
    amlev.deref(state, (&e[0]) as u64)
    return amlobj.to_int((&e[0]) as u64)
}

fn read_lid(state: u64) {
    let m: u64 = g(state, E_LIDN)
    if m == amlns.NONE || m == 0 {
        return
    }
    var r: [u64; 3] = [0 as u64; 3]
    if !aml.eval_node(state, m, (&r[0]) as u64) {
        amlns.err_set(state, amlns.ERR_OK)
        return
    }
    var v: u64 = LID_CLOSED
    if amlobj.to_int((&r[0]) as u64) != 0 {
        v = LID_OPEN
    }
    if v != g(state, E_LIDV) {
        let alt: u64 = g(state, E_LIDV)
        s(state, E_LIDV, v)
        mark(state, EV_LID)
        // ================================ LID CLOSED MEANS LOCK
        //
        // The lock screen has existed since round ANMELDUNG; what was missing was
        // somebody who switches it on when the lid is closed. EXACTLY THE SAME
        // word is set that `idlelock` sets through system call 1870 (op 1) -- no
        // second way past the password check, and no second place where it would
        // be written down what "locked" means.
        //
        // ONLY ON THE TRANSITION OPEN/CLOSED, and only if it really said "open"
        // before. `LID_UNKNOWN` is the state before the first query; a board whose
        // lid is closed at boot (because it hangs on a monitor and runs closed)
        // must not be locked at once because of that.
        if v == LID_CLOSED && alt == LID_OPEN {
            let sp: u64 = kstate.K11_OFF
            if kstate.get(state, sp + kstate.SP_ON) == 0 {
                kstate.set(state, sp + kstate.SP_ON, 1)
                kstate.add(state, sp + kstate.SP_LOCKS, 1)
                var s_l: [u8; 29] = "acpiev: lid closed -- locked\0"
                serial.puts((&s_l[0]) as u64)
                serial.nl()
            }
        }
        // OPENING DOES NOT UNLOCK. A lid that unlocks would be exactly the second
        // way past the password check that `idlelock.fi` rules out in its header.
        if v == LID_OPEN && alt == LID_CLOSED {
            var s_a: [u8; 24] = "acpiev: deckel auf\0\0\0\0\0\0"
            serial.puts((&s_a[0]) as u64)
            serial.nl()
        }
    }
}

fn read_bif(state: u64) {
    let m: u64 = g(state, E_BIFN)
    if m == amlns.NONE || m == 0 {
        return
    }
    var r: [u64; 3] = [0 as u64; 3]
    if !aml.eval_node(state, m, (&r[0]) as u64) {
        s(state, E_BIFRET, 2)
        amlns.err_set(state, amlns.ERR_OK)
        return
    }
    if amlobj.otype((&r[0]) as u64) != amlobj.OT_PKG {
        s(state, E_BIFRET, 3)
        return
    }
    s(state, E_BIFRET, 1)
    // `_BIF` Package(13): index 2 is the last full charge.
    // `_BIX` Package(20+): there it is index 3, because a revision number
    // stands in front. They are told apart by the LENGTH -- that is exactly
    // what the specification provides for it.
    let len: u64 = amlobj.ov2((&r[0]) as u64)
    var idx: u64 = 2
    if len >= 20 {
        idx = 3
    }
    let full: u64 = pkg_int(state, (&r[0]) as u64, idx)
    s(state, E_RAWFULL, full)
    if full != 0 && full != 0xFFFFFFFF {
        s(state, E_FULL, full)
    }
}

fn read_bst(state: u64) {
    let m: u64 = g(state, E_BSTN)
    var s_x: [u8; 12] = "acpiev: bst\0"
    var s_t: [u8; 8] = " typ=\0\0\0"
    var s_l: [u8; 6] = " n=\0\0\0"
    var s_r: [u8; 8] = " rem=\0\0\0"
    var s_f: [u8; 9] = " full=\0\0\0"
    if kstate.mode_on(state, kstate.M_EVDUMP) {
        serial.puts((&s_x[0]) as u64)
    }
    if m == amlns.NONE || m == 0 {
        if kstate.mode_on(state, kstate.M_EVDUMP) {
            serial.nl()
        }
        return
    }
    var r: [u64; 3] = [0 as u64; 3]
    if !aml.eval_node(state, m, (&r[0]) as u64) {
        s(state, E_BSTRET, 2)
        amlns.err_set(state, amlns.ERR_OK)
        return
    }
    if kstate.mode_on(state, kstate.M_EVDUMP) {
        serial.puts((&s_t[0]) as u64)
        serial.dec(amlobj.otype((&r[0]) as u64))
        serial.puts((&s_l[0]) as u64)
        serial.dec(amlobj.ov2((&r[0]) as u64))
    }
    if amlobj.otype((&r[0]) as u64) != amlobj.OT_PKG {
        s(state, E_BSTRET, 3)
        if kstate.mode_on(state, kstate.M_EVDUMP) {
            serial.nl()
        }
        return
    }
    s(state, E_BSTRET, 1)
    // `_BST` Package(4): state, rate, remaining capacity, voltage.
    let zust: u64 = pkg_int(state, (&r[0]) as u64, 0)
    let rem: u64 = pkg_int(state, (&r[0]) as u64, 2)
    if kstate.mode_on(state, kstate.M_EVDUMP) {
        serial.puts((&s_r[0]) as u64)
        serial.dec(rem)
        serial.puts((&s_f[0]) as u64)
        serial.dec(g(state, E_FULL))
        serial.nl()
    }
    let full: u64 = g(state, E_FULL)
    s(state, E_RAWREM, rem)
    var pct: u64 = 0
    var valid: u64 = 0
    if full != 0 && full != 0xFFFFFFFF && rem != 0xFFFFFFFF {
        valid = 1
        pct = (rem * 100) / full
        if pct > 100 {
            pct = 100
        }
    }
    if zust != g(state, E_BSTATE) || pct != g(state, E_PCT) || valid != g(state, E_BVALID) {
        s(state, E_BSTATE, zust)
        s(state, E_REM, rem)
        s(state, E_PCT, pct)
        s(state, E_BVALID, valid)
        mark(state, EV_BATT)
    }
}

fn read_ac(state: u64) {
    let m: u64 = g(state, E_ACN)
    if m == amlns.NONE || m == 0 {
        return
    }
    var r: [u64; 3] = [0 as u64; 3]
    if !aml.eval_node(state, m, (&r[0]) as u64) {
        amlns.err_set(state, amlns.ERR_OK)
        return
    }
    var v: u64 = 0
    if amlobj.to_int((&r[0]) as u64) != 0 {
        v = 1
    }
    if v != g(state, E_ACV) {
        s(state, E_ACV, v)
        mark(state, EV_AC)
    }
}

// ==================================================================
// SETUP
// ==================================================================

// ==================================================================
// SWITCHING ON ACPI -- THE LINE WITHOUT WHICH NOTHING ARRIVES
// ==================================================================
//
// MEASURED AND CORRECTED. The first version of this round entered the SCI
// line, armed the GPE bits, enabled the power button -- and after
// `system_powerdown` at the QEMU monitor counted EXACTLY ZERO interrupts
// (`irqs=0` in the report line, with a correct `pm1a=0x600`).
//
// The reason is in ACPI 6.4 section 16.3.2 and is no bug in the code but
// a missing line: A COMPUTER STARTS IN LEGACY MODE. As long as SCI_EN
// (bit 0 of PM1a_CNT) is not set, the events do NOT go to the operating
// system but as SMI to the firmware -- which handles them as it likes,
// and the kernel never gets to see anything. The way from legacy to ACPI
// mode is ONE write: the value of the FADT field ACPI_ENABLE to the port
// from SMI_CMD.
//
// AFTERWARDS WE WAIT, and that too is in the specification: the switch is
// NOT finished at once. The wait is for SCI_EN itself and not blindly for
// a fixed time -- a firmware that is slower than the guessed deadline
// would otherwise be exactly the bug one searches for a week on real
// metal.
//
// SMI_CMD == 0 IS NO ERROR. The specification explicitly allows it: then
// there is no legacy mode, the machine is already in ACPI mode, and there
// is nothing to do. QEMU with `-machine q35` is such a case, and so is
// every machine that starts through UEFI only.
fn acpi_mode_on(state: u64, facp: u64) -> u64 {
    let cnt: u64 = kstate.get32(facp + F_PM1A_CNT)
    if cnt == 0 {
        return 0
    }
    if (in16(cnt) & SCI_EN) != 0 {
        return 1 // already on
    }
    let smi: u64 = kstate.get32(facp + F_SMI_CMD)
    let val: u64 = kstate.get8(facp + F_ACPI_ENABLE)
    if smi == 0 {
        return 2 // no legacy mode, nothing to do
    }
    out8(smi, val)
    // Wait for SCI_EN. The loop is generous (the specification names 3
    // seconds as the upper limit for the switch), and it ends as soon as the
    // bit is set.
    var i: u64 = 0
    while i < 3000000 {
        if (in16(cnt) & SCI_EN) != 0 {
            return 3 // switched over
        }
        i = i + 1
    }
    return 4 // written, but the bit did not come
}

// The namespace could not be built (VirtualBox: unknown AML opcode), but the power button is a FIXED event and needs no
// AML: arm PM1 PWRBTN and route the SCI so that `button_take` works. READY stays 0, so pump and every AML user stay off.
fn route_sci(state: u64, irq: u64) {
    var flags: u64 = 0
    var gsi: u64 = irq
    if !knob(state, KNOB_NOOVR) {
        flags = irqovr.flags_for(irq)
        gsi = irqovr.gsi_for(irq)
    }
    let level: bool = irqovr.is_level(flags, SCI_DEFAULT_LEVEL)
    let low: bool = irqovr.is_low(flags, SCI_DEFAULT_LOW)
    s(state, E_SCIIRQ, irq)
    s(state, E_SCI, gsi)
    s(state, E_SCIFLAGS, flags)
    s(state, E_SCILEVEL, bool_word(level))
    s(state, E_SCILOW, bool_word(low))
    apic.route(state, gsi, VEC_SCI, apic.id(state), level, low)
}

fn bool_word(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

fn arm_button_only(state: u64) {
    if !pm1.usable() {
        return
    }
    pm1.clear(pm1.PWRBTN | pm1.SLPBTN)
    pm1.enable(pm1.PWRBTN)
    s(state, E_BONLY, 1)
    route_sci(state, g(state, E_SCI))
}

// Cache what power.acpi_off needs while the tables are still reachable.
fn cache_off(state: u64, facp: u64) {
    var vals: [u64; 2] = [0 as u64; 2]
    let pa: u64 = kstate.get32(facp + F_PM1A_CNT)
    if pa == 0 {
        return
    }
    if !power.s5_values(kstate.get32(facp + 40), (&vals[0]) as u64) {
        return
    }
    s(state, E_CPM1A, pa)
    s(state, E_CPM1B, kstate.get32(facp + F_PM1B_CNT))
    s(state, E_CTYPA, vals[0 as usize])
    s(state, E_CTYPB, vals[1 as usize])
    s(state, E_COK, 1)
}

fn stage(state: u64) {
    var w_facp: [u8; 5] = "FACP\0"
    var w_lid: [u8; 5] = "_LID\0"
    var w_bst: [u8; 5] = "_BST\0"
    var w_bif: [u8; 5] = "_BIF\0"
    var w_bix: [u8; 5] = "_BIX\0"
    var w_psr: [u8; 5] = "_PSR\0"
    var w_ac: [u8; 9] = "ACPI0003\0"
    var w_ec: [u8; 8] = "PNP0C09\0"

    s(state, E_LIDN, amlns.NONE)
    s(state, E_LIDDEV, amlns.NONE)
    s(state, E_BATN, amlns.NONE)
    s(state, E_BSTN, amlns.NONE)
    s(state, E_BIFN, amlns.NONE)
    s(state, E_ACN, amlns.NONE)
    s(state, E_ACDEV, amlns.NONE)
    s(state, E_BTNDEV, amlns.NONE)
    s(state, E_LIDV, LID_UNKNOWN)

    if kstate.mode_on(state, kstate.M_NOACPIEV) {
        s(state, E_WHY, WHY_OFF)
        report(state)
        return
    }

    let facp: u64 = acpi.table(state, (&w_facp[0]) as u64)
    if facp == 0 {
        s(state, E_WHY, WHY_NOFADT)
        report(state)
        return
    }

    cache_off(state, facp)

    // The registers from the FADT. PM1x_EVT is in two halves: the first half
    // status, the second enable.
    let evlen: u64 = kstate.get8(facp + F_PM1_EVT_LEN)
    s(state, E_EVLEN, evlen)
    s(state, E_PM1A, kstate.get32(facp + F_PM1A_EVT))
    s(state, E_PM1B, kstate.get32(facp + F_PM1B_EVT))
    pm1.configure(g(state, E_PM1A), g(state, E_PM1B), evlen)
    gpe.configure(kstate.get32(facp + F_GPE0), kstate.get8(facp + F_GPE0_LEN),
        kstate.get32(facp + F_GPE1), kstate.get8(facp + F_GPE1_LEN), kstate.get8(facp + F_GPE1_BASE))
    read_knobs(state)
    let ovr: u64 = irqovr.parse(state)
    s(state, E_SCIOVR, ovr)
    // FIRST INTO ACPI MODE. Before any other line: as long as the machine is
    // in legacy mode, all events go to the firmware, and everything else here
    // would be in vain.
    s(state, E_MODE, acpi_mode_on(state, facp))

    let sci: u64 = kstate.get16(facp + F_SCI_INT)
    s(state, E_SCI, sci)
    if sci == 0 {
        s(state, E_WHY, WHY_NOSCI)
        report(state)
        return
    }

    // THE NAMESPACE. `aml.stage` has built it and discarded it again; here it
    // is built a second time and HELD -- but only if there is something to
    // handle. A server without lid and without battery thereby pays no 1 MiB
    // for nothing.
    var arena: u64 = 0
    if !kstate.mode_on(state, kstate.M_EVNOHOLD) {
        arena = aml.ns_hold(state)
    }
    if arena == 0 {
        s(state, E_WHY, WHY_NONS)
        if !kstate.mode_on(state, kstate.M_EVNOHOLD) {
            arm_button_only(state)
        }
        report(state)
        return
    }
    s(state, E_ARENA, arena)

    // Look for the devices.
    let lidd: u64 = find_hid(state, HID_LID)
    if lidd != amlns.NONE {
        s(state, E_LIDDEV, lidd)
        s(state, E_LIDN, child(state, lidd, amlns.seg_of((&w_lid[0]) as u64)))
    }
    let btn: u64 = find_hid(state, HID_PWRB)
    if btn != amlns.NONE {
        s(state, E_BTNDEV, btn)
    }
    let bat: u64 = find_hid(state, HID_BATT)
    if bat != amlns.NONE {
        s(state, E_BATN, bat)
        s(state, E_BSTN, child(state, bat, amlns.seg_of((&w_bst[0]) as u64)))
        var bif: u64 = child(state, bat, amlns.seg_of((&w_bif[0]) as u64))
        if bif == amlns.NONE {
            bif = child(state, bat, amlns.seg_of((&w_bix[0]) as u64))
        }
        s(state, E_BIFN, bif)
        if g(state, E_BSTN) != amlns.NONE {
            s(state, E_BATOK, 1)
        }
    }
    let acd: u64 = find_hid_str(state, (&w_ac[0]) as u64)
    if acd != amlns.NONE {
        s(state, E_ACDEV, acd)
        s(state, E_ACN, child(state, acd, amlns.seg_of((&w_psr[0]) as u64)))
    }

    // Collect the GPE methods and arm EXACTLY THOSE.
    collect_gpe(state)
    let n: u64 = meth_n(state)
    var armed: u64 = 0
    var i: u64 = 0
    while i < n {
        let bit: u64 = meth_bit(state, i)
        if gpe.sts_port(bit) != 0 {
            // Clear first (something may be pending since boot), then enable.
            gpe.clear(bit)
            gpe.arm(bit, meth_art(state, i) == M_LEVEL || knob(state, KNOB_GPELEVEL))
            armed = armed + 1
        }
        i = i + 1
    }
    s(state, E_ARMED, armed)
    var ecd: u64 = find_hid(state, HID_EC)
    if ecd == amlns.NONE {
        ecd = find_hid_str(state, (&w_ec[0]) as u64)
    }
    ec.setup(state, ecd)
    ec.scan_hw(state)

    if pm1.usable() {
        pm1.clear(pm1.PWRBTN | pm1.SLPBTN)
        pm1.enable(pm1.PWRBTN)
    }
    s(state, E_READY, 1)
    s(state, E_WHY, WHY_OK)
    route_sci(state, sci)
    if knob(state, KNOB_STORMSIM) {
        pm1.enable(pm1.TMR)
    }

    // WITH `evfake` SET THE REBUILT LAPTOP TO A VISIBLE STATE. Without that,
    // the operation region of the rebuilt laptop is all zero -- that is lid
    // closed, zero percent -- and every picture of this round showed an empty
    // battery. The number is deliberately odd: 77 can be neither a default
    // nor a coincidence, it stands that way in `fake_set` and must stand that
    // way in the bar.
    if kstate.mode_on(state, kstate.M_EVFAKE) {
        fake_set(state, 1, 77, 1, 0)
    }

    // Read everything once, so that the taskbar has something to show from
    // the start and not only at the first event.
    refresh_all(state)
    report(state)
    report_route(state)
    amltest.run_if_asked(state)
}

// The vector on which the SCI reports. It stands once more in `trap.fi`;
// `tools/kernel/memmap.py` recalculates the vector table and would find
// two names on one number.
const VEC_SCI: u64 = 37

// ==================================================================
// OPERATING THE REBUILT LAPTOP
// ==================================================================
//
// `tools/acpiev/asl/laptop.asl` puts its values into an operation region
// at 0x9F00 (lid, percentage, state, adapter). On a real board the
// embedded controller writes there; on this machine there is none, and
// the QEMU monitor cannot WRITE into guest memory (`xp` reads, `pmemsave`
// writes into a file, not the other way round).
//
// So the measurement run sets the values ITSELF -- and that is no
// self-confirmation but exactly the separation that matters: HERE a
// number is put into a MEMORY SLOT, and what is measured is whether the
// firmware's AML METHOD finds it, CALCULATES with it and returns the
// result in the right field of the right package. Between the number here
// and the number in `acpiev.batt_percent` lie `_BST`, a `Multiply`, an
// `Index`, a `Store`, the unpacking of the package and the percentage
// calculation against `_BIF`. If 77 stands here and 77 comes out at the
// back, the interpreter has covered the whole way; if somebody writes 40
// here, 40 MUST stand at the back. That is the same relationship as
// between `tools/k18/ssdt.py` and `/bin/power`.
const LPST: u64 = 0x9F00

fn fake_set(state: u64, lid: u64, pct: u64, zust: u64, ac: u64) {
    var s_s: [u8; 20] = "acpiev: setze lid=\0\0"
    var s_p: [u8; 7] = " pct=\0\0"
    var s_z: [u8; 8] = " zust=\0\0"
    var s_a: [u8; 6] = " ac=\0\0"
    kstate.set8(LPST + 0, lid as u8)
    kstate.set8(LPST + 1, pct as u8)
    kstate.set8(LPST + 2, zust as u8)
    kstate.set8(LPST + 3, ac as u8)
    serial.puts((&s_s[0]) as u64)
    serial.dec(lid)
    serial.puts((&s_p[0]) as u64)
    serial.dec(pct)
    serial.puts((&s_z[0]) as u64)
    serial.dec(zust)
    serial.puts((&s_a[0]) as u64)
    serial.dec(ac)
    serial.nl()
}

// ==================================================================
// AN EVENT BY HAND -- WITHOUT HARDWARE
// ==================================================================
//
// WHY THIS EXISTS, and it is a measurement and not a shortcut.
//
// QEMU 7.2 has neither lid nor battery (`-device battery` only came with
// 8.2, a lid device does not exist to this day). So there is NOTHING on
// this machine that would pull a GPE bit for the lid -- and that is a
// valid finding that stands in the report as such.
//
// What can be measured ANYWAY is everything BEHIND the bit: executing the
// firmware's GPE method, evaluating the `Notify` ring, attributing the
// reported device, calling `_LID` or `_BST` and taking over the value.
// That is the whole way except the one line that no emulator pulls.
//
// `ev_fake` therefore executes the method for a bit as if the bit had
// come. It does NOT skip the handler for convenience -- the handler is
// really measured with the power button (irqs=1, sts=0x0101) --, but
// because at this point the hardware is missing and only that.
//
// WHAT IS NOT MEASURED BY THIS, and it belongs in every report of this
// round: that a real board really pulls the bit, that it is the RIGHT bit
// and that clearing prevents the storm. `tools/acpiev/brett.sh` exists
// for that.
fn ev_fake(state: u64, bit: u64) -> bool {
    var s_f: [u8; 20] = "acpiev: fake gpe b=\0"
    let idx: u64 = meth_find(state, bit)
    serial.puts((&s_f[0]) as u64)
    serial.hex_width(bit, 2)
    if idx == 0xFFFF {
        var s_n: [u8; 15] = " keine Methode\0"
        serial.puts((&s_n[0]) as u64)
        serial.nl()
        return false
    }
    serial.nl()
    run_gpe(state, idx)
    s(state, E_EVENTS, g(state, E_EVENTS) + 1)
    return true
}

// Go through all bits for which there is a method. For the measurement
// run: so EVERY GPE method of this machine runs once, and the output says
// what each one reported.
fn fake_all(state: u64) {
    let n: u64 = meth_n(state)
    var i: u64 = 0
    while i < n {
        let _b: bool = ev_fake(state, meth_bit(state, i))
        i = i + 1
    }
}

// L-005..L-007: set the fake laptop's values at RUN time and queue its three GPE methods (lid bit 3,
// battery bit 4, mains+battery bit 5), so the whole chain method -> Notify -> `_LID`/`_BST`/`_PSR` -> value
// is walked by `pump` in normal operation, exactly like a real SCI. Only with `evfake` on the kernel
// line (the machine then has the SSDT of tools/acpiev/asl/laptop.asl); never on a real board.
// `/bin/power inject` (root) is the way in from user space; tools/power/run.sh is the user.
fn inject(state: u64, lid: u64, pct: u64, zust: u64, ac: u64) -> bool {
    if !kstate.mode_on(state, kstate.M_EVFAKE) {
        return false
    }
    if !ready(state) {
        return false
    }
    fake_set(state, lid, pct, zust, ac)
    var bit: u64 = 3
    while bit <= 5 {
        let idx: u64 = meth_find(state, bit)
        if idx != 0xFFFF {
            let w: u64 = E_PEND + (idx / 64) * 8
            s(state, w, g(state, w) | (1 << (idx & 63)))
        }
        bit = bit + 1
    }
    s(state, E_WAKE, g(state, E_WAKE) + 1)
    return true
}

// ==================================================================
// THE MEASUREMENT RUN -- WAITING UNTIL SOMETHING HAPPENS
// ==================================================================
//
// WHY THIS FUNCTION EXISTS, and it is no test scaffold but the
// consequence of a measurement.
//
// The kernel of this acceptance run runs with `-device isa-debug-exit`:
// it sets up, reports and leaves. The idle task, in which `pump` stands,
// NEVER gets its turn that way -- the line `kernel: done` is in the
// output before the first timer tick could select a task. On the first
// run of this round that looked like "the SCI does not arrive" (irqs=0),
// and in truth it was "the kernel was already finished when the button
// was pressed".
//
// `evwait` therefore keeps the kernel for EXACTLY as long as the
// measurement needs, with interrupts on, and pumps in the loop. That is
// the same construction as `sched.sleep` in the measurement runs of
// other rounds.
fn wait_loop(state: u64, ms: u64) {
    var s_w: [u8; 22] = "acpiev: warte ms=\0\0\0\0\0"
    serial.puts((&s_w[0]) as u64)
    serial.dec(ms)
    serial.nl()
    // Interrupts ON. Without this line the loop waits for something that is
    // never delivered.
    asm("sti")
    // WITH `evfake` PLAY THROUGH THE REBUILT LAPTOP. Four steps, and after
    // each one the output says what the kernel made of it -- the ORDER is the
    // measurement.
    if kstate.mode_on(state, kstate.M_EVFAKE) {
        var s_1: [u8; 29] = "acpiev: --- 1 lid open, 77 %\0"
        var s_2: [u8; 25] = "acpiev: --- 2 lid CLOSED\0"
        var s_3: [u8; 29] = "acpiev: --- 3 lid open, 40 %\0"
        var s_4: [u8; 33] = "acpiev: --- 4 on mains, charging\0"
        // 1. Lid open, 77 percent, discharging, no mains.
        serial.puts((&s_1[0]) as u64)
        serial.nl()
        fake_set(state, 1, 77, 1, 0)
        fake_all(state)
        report(state)
        // 2. LID CLOSED. Pull only the lid bit -- as a real board would.
        serial.puts((&s_2[0]) as u64)
        serial.nl()
        fake_set(state, 0, 77, 1, 0)
        let _a: bool = ev_fake(state, 3)
        report(state)
        // 3. Lid open again, and the battery has dropped.
        serial.puts((&s_3[0]) as u64)
        serial.nl()
        fake_set(state, 1, 40, 1, 0)
        let _b: bool = ev_fake(state, 3)
        let _c: bool = ev_fake(state, 4)
        report(state)
        // 4. Adapter plugged in: ONE method, TWO `Notify`.
        serial.puts((&s_4[0]) as u64)
        serial.nl()
        fake_set(state, 1, 41, 2, 1)
        let _d: bool = ev_fake(state, 5)
        report(state)
    }
    let t0: u64 = time.mono_ns(state) / 1000000
    var previous: u64 = 0
    while ((time.mono_ns(state) / 1000000) -% t0) < ms {
        pump(state)
        // Report every change at once, so that the acceptance run shows the
        // ORDER and not only the final state.
        let c: u64 = g(state, E_CHANGED)
        if c != previous {
            previous = c
            report(state)
        }
        asm("hlt")
    }
    serial.puts((&s_w[0]) as u64)
    serial.dec(0)
    serial.nl()
    report(state)
    dump_diag(state)
}

// ==================================================================
// THE REPORT
// ==================================================================

fn report(state: u64) {
    var s_a: [u8; 16] = "acpiev: ready=\0\0"
    var s_w: [u8; 7] = " why=\0\0"
    var s_s: [u8; 7] = " sci=\0\0"
    var s_g: [u8; 9] = " gpearm=\0"
    var s_m: [u8; 8] = " meth=\0\0"
    var s_l: [u8; 7] = " lid=\0\0"
    var s_b: [u8; 8] = " batt=\0\0"
    var s_p: [u8; 7] = " pct=\0\0"
    var s_c: [u8; 6] = " ac=\0\0"
    var s_bt: [u8; 8] = " pwrb=\0\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(g(state, E_READY))
    serial.puts((&s_w[0]) as u64)
    serial.dec(g(state, E_WHY))
    serial.puts((&s_s[0]) as u64)
    serial.dec(g(state, E_SCI))
    serial.puts((&s_g[0]) as u64)
    serial.dec(g(state, E_ARMED))
    serial.puts((&s_m[0]) as u64)
    serial.dec(meth_n(state))
    serial.puts((&s_l[0]) as u64)
    serial.dec(g(state, E_LIDV))
    serial.puts((&s_b[0]) as u64)
    serial.dec(g(state, E_BATOK))
    serial.puts((&s_p[0]) as u64)
    serial.dec(g(state, E_PCT))
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, E_ACV))
    var s_iq: [u8; 8] = " irqs=\0\0"
    var s_st: [u8; 6] = " sts=\0"
    var s_pp: [u8; 7] = " pm1a=\0"
    var s_en: [u8; 8] = " pm1en=\0"
    var s_le: [u8; 9] = " evlen=\0\0"
    var s_io: [u8; 9] = " ioapic=\0"
    var s_md: [u8; 8] = " mode=\0\0"
    var s_pn: [u8; 8] = " pumpn=\0"
    var s_ev: [u8; 6] = " ev=\0\0"
    serial.puts((&s_iq[0]) as u64)
    serial.dec(g(state, E_IRQN))
    serial.puts((&s_st[0]) as u64)
    serial.hex_width(g(state, E_LASTSTS), 4)
    serial.puts((&s_pp[0]) as u64)
    serial.hex_width(g(state, E_PM1A), 4)
    serial.puts((&s_en[0]) as u64)
    serial.hex_width(pm1.enabled(), 4)
    serial.puts((&s_le[0]) as u64)
    serial.dec(g(state, E_EVLEN))
    serial.puts((&s_io[0]) as u64)
    serial.hex_width(apic.gsi_entry(state, g(state, E_SCI)), 8)
    serial.puts((&s_md[0]) as u64)
    serial.dec(g(state, E_MODE))
    serial.puts((&s_pn[0]) as u64)
    serial.dec(g(state, E_PUMPN))
    serial.puts((&s_ev[0]) as u64)
    serial.dec(g(state, E_EVENTS))
    serial.puts((&s_bt[0]) as u64)
    var hat: u64 = 0
    if g(state, E_BTNDEV) != amlns.NONE {
        hat = 1
    }
    serial.dec(hat)
    var s_sy: [u8; 8] = " stray=\0"
    var s_gy: [u8; 9] = " gstray=\0"
    var s_ms: [u8; 9] = " masked=\0"
    var s_sm: [u8; 9] = " storms=\0"
    var s_po: [u8; 8] = " polls=\0"
    var s_em: [u8; 8] = " empty=\0"
    serial.puts((&s_sy[0]) as u64)
    serial.dec(g(state, E_PM1STRAY))
    serial.puts((&s_gy[0]) as u64)
    serial.dec(g(state, E_GPESTRAY))
    serial.puts((&s_ms[0]) as u64)
    serial.dec(bool_word(scistorm.masked()))
    serial.puts((&s_sm[0]) as u64)
    serial.dec(scistorm.storms())
    serial.puts((&s_po[0]) as u64)
    serial.dec(scistorm.polls())
    serial.puts((&s_em[0]) as u64)
    serial.dec(scistorm.empties())
    serial.nl()

    // The GPE methods one by one, so that the acceptance run shows WHICH bits
    // are armed and not only how many.
    var s_e: [u8; 16] = "acpiev: gpe b=\0\0"
    var s_t: [u8; 7] = " art=\0\0"
    var s_o: [u8; 6] = " on=\0\0"
    let n: u64 = meth_n(state)
    var i: u64 = 0
    while i < n {
        serial.puts((&s_e[0]) as u64)
        serial.hex_width(meth_bit(state, i), 2)
        serial.puts((&s_t[0]) as u64)
        serial.dec(meth_art(state, i))
        serial.puts((&s_o[0]) as u64)
        var on: u64 = 0
        if gpe.is_armed(meth_bit(state, i)) {
            on = 1
        }
        serial.dec(on)
        serial.nl()
        i = i + 1
    }
}

// ==================================================================
// THE SELFTEST
// ==================================================================
//
// What can be checked WITHOUT the hardware is checked here: the name
// calculation (`_L1B` -> bit 0x1B, level triggered) and the register
// calculation (which byte, which bit, which block). Both are pure
// calculations, and both would be exactly the kind of bug one searches
// for a week on real metal without a test.

fn selftest(state: u64) {
    var s_n: [u8; 22] = "acpiev: selftest name\0"
    var s_r: [u8; 21] = "acpiev: selftest reg\0"
    var s_ok: [u8; 5] = " ok\0\0"
    var s_bad: [u8; 7] = " FEHL\0\0"
    var w1: [u8; 5] = "_L1B\0"
    var w2: [u8; 5] = "_E03\0"
    var w3: [u8; 5] = "_LID\0"
    var w4: [u8; 5] = "_LFF\0"

    // `_L1B` -> bit 0x1B, kind LEVEL. `_E03` -> bit 3, kind EDGE.
    // `_LID` is NOT a GPE method ('I' is no hex digit) -- that is the most
    // important of the four lines, because `_LID` is in EVERY laptop DSDT,
    // and whoever reads it as GPE bit 0x1D arms a bit that belongs to
    // nobody.
    var gut: bool = true
    if gpe_of_name(amlns.seg_of((&w1[0]) as u64)) != ((0x1B << 1) | M_LEVEL) {
        gut = false
    }
    if gpe_of_name(amlns.seg_of((&w2[0]) as u64)) != ((0x03 << 1) | M_EDGE) {
        gut = false
    }
    if gpe_of_name(amlns.seg_of((&w3[0]) as u64)) != 0xFFFF {
        gut = false
    }
    if gpe_of_name(amlns.seg_of((&w4[0]) as u64)) != ((0xFF << 1) | M_LEVEL) {
        gut = false
    }
    serial.puts((&s_n[0]) as u64)
    if gut {
        serial.puts((&s_ok[0]) as u64)
    } else {
        serial.puts((&s_bad[0]) as u64)
    }
    serial.nl()

    var g2: bool = gpe.selftest()
    serial.puts((&s_r[0]) as u64)
    if g2 {
        serial.puts((&s_ok[0]) as u64)
    } else {
        serial.puts((&s_bad[0]) as u64)
    }
    serial.nl()

    var s_gd: [u8; 23] = "acpiev: selftest guard\0"
    serial.puts((&s_gd[0]) as u64)
    if aml.guard_probe() {
        serial.puts((&s_ok[0]) as u64)
    } else {
        serial.puts((&s_bad[0]) as u64)
    }
    serial.nl()
    selftest_xapc(state)
    selftest_defer(state)
    dump_diag(state)
    selftest_ecrate(state)
    var s_o: [u8; 21] = "acpiev: selftest opt\0"
    serial.puts((&s_o[0]) as u64)
    if cmdopt.selftest(state) {
        serial.puts((&s_ok[0]) as u64)
    } else {
        serial.puts((&s_bad[0]) as u64)
    }
    serial.nl()
}
