// SPDX-License-Identifier: GPL-2.0-only
// kernel/tasks.fi -- round 62: what the kernel tasks do.
//
// `sched.fi` can start and switch tasks; this file is what they run. It
// is deliberately its own module: the scheduler must not know its
// customers, otherwise the module graph would run in a circle.
//
// Every kernel task starts in `main` -- that is the address the linker
// puts into the table of isr.s as `KERNEL_TASK_MAIN`. Which of the bodies
// runs is decided by the `kind` the creator handed over. Stage 0 of Firn
// has no function pointers in the kernel profile, so the dispatch is a
// number, exactly as in the collector of round 47 and the thread
// dispatcher of round 49.
//
// THE WORKER is the proof of the round. Three of them run at the same
// time, each with a priority of its own, and each one does the SAME
// amount of work: `WORK_UNITS` turns of a spin loop, and after every turn
// it writes its counter into its task record. Three things can be read
// off that afterwards:
//
//   * that they really ran interleaved (the trace of the scheduler),
//   * that each one did its full work (the counter and the exit code),
//   * that the priority means something (the one with priority 3 is done
//     first and has spent about three times the ticks of priority 1).

import serial
import kstate
import sched
import inet
import pwr

export { main, WORK_UNITS, SPIN, GRIND_UNITS, GRIND_STEP }

// 40 turns of 20000 spins. In QEMU that is a few hundred milliseconds --
// long enough for the timer at 100 Hz to take the processor away many
// times, short enough for a test that runs under a time limit.
const WORK_UNITS: u64 = 40
const SPIN: u64 = 20000

// `KERNEL_TASK_MAIN` out of isr.s. Arrives through `ret` in
// `context_switch`, on the kernel stack of the new task; the three
// arguments were put into the initial frame by `sched.frame_build`.
fn main(state: u64, index: u64, kind: u64) {
    // ROUND K5, the first line of every kernel task: the core that
    // started this one is holding the run queue lock for it and could not
    // give it back itself. See `sched.frame_build`.
    sched.enter_task(state)
    if kind == sched.K_IDLE {
        idle(state)
    }
    if kind == sched.K_WORKER {
        worker(state, index)
    }
    if kind == sched.K_GRIND {
        grinder(state, index)
    }
    // ROUND K8: and this one never comes back -- `netd_body` is a loop
    // that only ends when the machine does.
    if kind == sched.K_NETD {
        inet.netd_body(state, index)
    }
    // Nothing to do -- and a task that falls out of its body would land
    // on `task_guard`.
    sched.exit_task(state, 0)
}

// The task that runs when nothing else wants to.
//
// RUNDE K18 HAT AUS DIESEN DREI ZEILEN DEN RUHEZUSTAND GEMACHT. Bis
// hierher stand hier `hlt`, und das war schon deutlich besser als eine
// Warteschleife -- aber `hlt` ist C1 und sonst nichts. Wie tief ein Kern
// wirklich schlaeft, sagt ihm `mwait`, und welche Tiefe erlaubt ist,
// entscheidet das Energieprofil. Beides steht in `pwr.idle_wait`; hier
// steht nur noch, WANN es gerufen wird.
//
// Der Rueckfall auf `hlt` ist kein Notnagel, sondern der Normalfall auf
// jeder Maschine ohne MONITOR/MWAIT -- und er ist zugleich die
// Gegenprobe dieser Runde: derselbe Kernel unter einer CPU ohne
// CPUID.01H:ECX Bit 3 zaehlt null Eintritte in mwait und ebenso viele
// in hlt, wie er vorher Durchlaeufe hatte.
fn idle(state: u64) {
    let allow: bool = (kstate.get(state, kstate.MODE)
        & kstate.M_NOCSTATES) == 0
    while true {
        pwr.idle_wait(state, allow)
    }
}

// ROUND K5: the same shape as `worker`, but the inner loop is arithmetic
// instead of `pause`. That is the task the scheduler hands round the
// cores in `smp.schedule_demo`, and the reason for a body of its own is
// in the comment at `sched.K_GRIND`: `pause` measures the emulator, not
// the machine. The wrapping operators are meant -- a hash that does not
// overflow is not a hash (round 72: the plain ones are checked).
const GRIND_UNITS: u64 = 8
const GRIND_STEP: u64 = 1000000

fn grinder(state: u64, index: u64) {
    var acc: u64 = 0x243F6A8885A308D3
    var unit: u64 = 0
    while unit < GRIND_UNITS {
        var i: u64 = 0
        while i < GRIND_STEP {
            acc = acc *% 6364136223846793005
            acc = acc +% 1442695040888963407
            acc = acc ^ (acc >> 33)
            i = i + 1
        }
        unit = unit + 1
        sched.tset(state, index, sched.T_WORK, unit)
    }
    // The accumulator has to leave the function, or an optimizer is
    // within its rights to delete the whole loop.
    sched.tset(state, index, sched.T_WAKE, acc)
    sched.exit_task(state, unit)
}

// The three of them are identical apart from their priority. Whatever
// difference shows up afterwards was made by the scheduler.
fn worker(state: u64, index: u64) {
    var unit: u64 = 0
    while unit < WORK_UNITS {
        var i: u64 = 0
        while i < SPIN {
            asm("pause")
            i = i + 1
        }
        unit = unit + 1
        sched.tset(state, index, sched.T_WORK, unit)
    }
    // The exit code says how much work was done. A worker that was cut
    // short would be visible here.
    sched.exit_task(state, unit)
}
