
import serial
import lib.kstate
import sched.sched
import net.inet
import net.wlan_link
import pwr.pwr
import sys.sys
import gfx.gfx
import drv.usb.ehci
import drv.usb.ehcikbd
import drv.usb.ohci
import acpi.acpiev
import arch.arch
import mm.mmframe
import arch.x86_64.fpu
import crypto.kargon
import sched.serhold

export { main, WORK_UNITS, SPIN, GRIND_UNITS, GRIND_STEP, VEC_ROUNDS,
    YIELD_ROUNDS }

const WORK_UNITS: u64 = 40
const SPIN: u64 = 20000

fn main(state: u64, index: u64, kind: u64) {
    sched.enter_task(state)
    if kind == sched.K_IDLE {
        idle(state)
    }
    if kind == sched.K_WORKER {
        worker(state, index)
    }
    if kind == sched.K_GRIND {
        grinder(state, index)
    }
    if kind == sched.K_VEC {
        vector_task(state, index)
    }
    if kind == sched.K_YIELD {
        yield_task(state, index)
    }
    if kind == sched.K_ARGON {
        kargon.trace_body(state, index)
    }
    if kind == sched.K_AIO {
        sys.aio_worker(state, index)
    }
    if kind == sched.K_NETD {
        inet.netd_body(state, index)
    }
    if kind == sched.K_WLAN {
        wlan_link.task_body(state, index)
    }
    if kind == sched.K_SERHOLD {
        serhold.task_body(state, index)
    }
    sched.exit_task(state, 0)
}

fn idle(state: u64) {
        let allow: bool = !kstate.mode_on(state, kstate.M_NOCSTATES)
    while true {
        pwr.idle_wait(state, allow)
        let _r: bool = gfx.disp_poll(state)
        let _g: bool = gfx.gpu_event(state)
        let _e: bool = ehci.poll(state)
        ehcikbd.pump(state)
        let _o: bool = ohci.poll(state)
        acpiev.pump(state)
    }
}

const GRIND_UNITS: u64 = 8
const GRIND_STEP: u64 = 1000000

fn grinder(state: u64, index: u64) {
    var acc: u64 = 0x243F6A8885A308D3
    var unit: u64 = 0
    while unit < GRIND_UNITS {
        var i: u64 = 0
        while i < GRIND_STEP {
            acc = acc *% 6364136223846793005
            acc = acc +% 1442695040888963407
            acc = acc ^ (acc >> 33)
            i = i + 1
        }
        unit = unit + 1
        sched.tset(state, index, sched.T_WORK, unit)
    }
    sched.tset(state, index, sched.T_WAKE, acc)
    sched.exit_task(state, unit)
}

fn worker(state: u64, index: u64) {
    var unit: u64 = 0
    while unit < WORK_UNITS {
        var i: u64 = 0
        while i < SPIN {
            arch.pause()
            i = i + 1
        }
        unit = unit + 1
        sched.tset(state, index, sched.T_WORK, unit)
    }
    sched.exit_task(state, unit)
}

const VEC_ROUNDS: u64 = 200

fn vector_task(state: u64, index: u64) {
    if !fpu.enabled(state) {
        sched.exit_task(state, 0)
    }
    let buf: u64 = mmframe.frame_alloc(state)
    if buf == 0 {
        sched.exit_task(state, 250)
    }
    let seed: u64 = sched.tget(state, index, sched.T_PID) & 0xFF
    fpu.vec_seed(buf, seed)
    fpu.vec_put(buf)
    var bad: u64 = 0
    var r: u64 = 0
    while r < VEC_ROUNDS {
        sched.yield_now(state)
        fpu.vec_calc()
        fpu.vec_ref(buf)
        sched.yield_now(state)
        fpu.vec_take(buf + fpu.PROBE_BYTES)
        bad = bad + fpu.vec_diff(buf, buf + fpu.PROBE_BYTES)
        sched.tset(state, index, sched.T_WORK, r + 1)
        r = r + 1
    }
    mmframe.frame_free(state, buf)
    if bad > 250 {
        bad = 250
    }
    sched.exit_task(state, bad)
}

const YIELD_ROUNDS: u64 = 20000

fn yield_task(state: u64, index: u64) {
    var r: u64 = 0
    while r < YIELD_ROUNDS {
        sched.yield_now(state)
        r = r + 1
    }
    sched.exit_task(state, 0)
}
