// kernel/signal.fi -- Runde K9: Signale.
//
// Bis zu dieser Runde konnte man einen Prozess in Osum nicht ordentlich
// unterbrechen. Es gab `SYS_OSUM_KILL` aus Runde K6, und das war kein
// `kill`: es machte aus einem Prozess sofort eine Leiche mit einem
// Beendigungscode. Der Prozess erfuhr nichts davon, konnte nichts
// aufraeumen, konnte sich nicht wehren und konnte auch nicht
// weitergemacht werden. Ein Betriebssystem ohne Signale hat keine
// Unterbrechung, kein STRG-C, kein `SIGCHLD` und keinen Weg, aus einem
// Prozessorfehler etwas anderes zu machen als eine Leiche.
//
// WAS EIN SIGNAL WIRKLICH IST, und die Reihenfolge ist die ganze
// Schwierigkeit:
//
//   1. ABSCHICKEN ist billig: ein Bit in `T_SIGPEND` der Zielaufgabe.
//      Mehr passiert beim Absender nicht. Ein Signal, das der Absender
//      selbst zustellen wuerde, muesste in einen fremden Adressraum
//      schreiben, waehrend dessen Besitzer laeuft.
//   2. ZUSTELLEN geschieht IM ZIEL und nur an einer Stelle: kurz bevor es
//      nach Ring 3 zurueckkehrt. Dort -- und nur dort -- steht sein
//      Zusammenhang vollstaendig und unbenutzt im Speicher, und dort
//      laesst er sich auf den Nutzerstapel retten.
//   3. BLOCKIEREN ist eine Maske je Aufgabe. Ein blockiertes Signal
//      bleibt wartend, es geht nicht verloren.
//
// DER RAHMEN AUF DEM NUTZERSTAPEL. Eine Behandlungsroutine laeuft in Ring
// 3, auf dem Stapel des Prozesses, und wenn sie fertig ist, muss der
// Prozess GENAU dort weitermachen, wo er unterbrochen wurde -- mit allen
// sechzehn Registern und den Flaggen. Also legt der Kernel unter den
// Stapelzeiger:
//
//     [rsp]        die Ruecksprungadresse: `sigreturn_tramp` in `.utext`
//     [rsp+8]      das Kennwort, die alte Maske, die Nummer
//     [rsp+32]     zweiundzwanzig Woerter Zusammenhang (isr.s' Form)
//
// und setzt rip auf die Routine, rdi auf die Nummer. Laeuft die Routine
// zu Ende, springt sie in den Trampolinsprung, der `sigreturn` ruft, und
// dieser Aufruf legt den Zusammenhang zurueck. Der Trampolinsprung liegt
// in `.utext` und nicht auf dem Stapel: Stapelseiten tragen seit Runde K1
// das No-Execute-Bit, und ein Kernel, der es dafuer abnimmt, hat die
// Luecke wieder aufgemacht, deretwegen es da ist.
//
// DER ROTE BEREICH. System V erlaubt einer Funktion, 128 Oktette UNTER
// ihrem Stapelzeiger zu benutzen, ohne ihn zu bewegen. Ein Signalrahmen,
// der dort hineingelegt wird, ueberschreibt lebende Daten. Also faengt er
// 128 Oktette tiefer an -- eine Zeile Code und der Unterschied zwischen
// "laeuft" und "laeuft meistens".
//
// DIE GEGENPROBE, und ohne sie zaehlt in diesem Projekt nichts: mit
// `nosig` auf der Kommandozeile wird NICHT zugestellt. Alles andere
// bleibt -- `kill` sagt 0, das Bit wird gesetzt, der Zaehler der
// abgeschickten Signale steigt. Nur ankommen tut nichts. Ein Programm,
// das seine SIGINTs zaehlt, muss dann bei null bleiben, und wenn es das
// nicht tut, hat der Test nie das gemessen, was er zu messen behauptet.

import serial
import kstate
import sched
import proc
import errno
import cpu
import arch.x86_64.guard

export {
    init_task, clear_task, exec_reset, inherit,
    send, send_task, send_pid, send_pgid, fault, alarm_check,
    check_sys, check_trap, pending, deliverable, interrupted,
    do_sigaction, do_sigprocmask, do_sigreturn, do_kill, do_pause,
    do_setpgid, do_getpgid, do_setsid, do_alarm, do_sigpending,
    exiting, stopped_count, handler_of, say_name, signal_of, lethal,
    SIGHUP, SIGINT, SIGQUIT, SIGILL, SIGTRAP, SIGABRT, SIGBUS, SIGFPE,
    SIGKILL, SIGUSR1, SIGSEGV, SIGUSR2, SIGPIPE, SIGALRM, SIGTERM,
    SIGCHLD, SIGCONT, SIGSTOP, SIGTSTP, SIGTTIN, SIGTTOU, SIGWINCH,
    NSIG, SIG_DFL, SIG_IGN, SIG_ERR,
    SIG_BLOCK, SIG_UNBLOCK, SIG_SETMASK,
    SA_NOCLDSTOP, SA_RESTART, SA_NODEFER, SA_RESETHAND, SA_SIGINFO
}

// Die Nummern von Linux x86-64 (`arch/x86/include/uapi/asm/signal.h`).
// Sie sind dieselben wie auf jedem System V der letzten dreissig Jahre;
// eine eigene Nummerierung waere eine Uebersetzungstabelle, die jemand
// pflegen muesste.
const SIGHUP: u64 = 1
const SIGINT: u64 = 2
const SIGQUIT: u64 = 3
const SIGILL: u64 = 4
const SIGTRAP: u64 = 5
const SIGABRT: u64 = 6
const SIGBUS: u64 = 7
const SIGFPE: u64 = 8
const SIGKILL: u64 = 9
const SIGUSR1: u64 = 10
const SIGSEGV: u64 = 11
const SIGUSR2: u64 = 12
const SIGPIPE: u64 = 13
const SIGALRM: u64 = 14
const SIGTERM: u64 = 15
const SIGCHLD: u64 = 17
const SIGCONT: u64 = 18
const SIGSTOP: u64 = 19
const SIGTSTP: u64 = 20
const SIGTTIN: u64 = 21
const SIGTTOU: u64 = 22
const SIGWINCH: u64 = 28
const NSIG: u64 = 32 // 1..31, und Platz 0 bleibt leer

const SIG_DFL: u64 = 0
const SIG_IGN: u64 = 1
const SIG_ERR: u64 = 0xFFFFFFFFFFFFFFFF

const SIG_BLOCK: u64 = 0
const SIG_UNBLOCK: u64 = 1
const SIG_SETMASK: u64 = 2

const SA_NOCLDSTOP: u64 = 1
const SA_SIGINFO: u64 = 4
const SA_RESTART: u64 = 0x10000000
const SA_NODEFER: u64 = 0x40000000
const SA_RESETHAND: u64 = 0x80000000

// Was bei einem Signal ohne eigene Routine geschieht.
const D_TERM: u64 = 0 // beenden
const D_IGN: u64 = 1 // ueberhoeren
const D_CORE: u64 = 2 // beenden, und es war ein Fehler
const D_STOP: u64 = 3 // anhalten
const D_CONT: u64 = 4 // fortsetzen

// Ein Platz je Signal je Aufgabe.
const A_BYTES: u64 = 24
const A_HANDLER: u64 = 0
const A_FLAGS: u64 = 8
const A_MASK: u64 = 16
const A_TASK: u64 = 768 // NSIG * A_BYTES

// Der Rahmen auf dem Nutzerstapel.
const SF_MAGIC: u64 = 0
const SF_MASK: u64 = 8
const SF_SIG: u64 = 16
const SF_CTX: u64 = 24 // 22 Woerter, isr.s' Form
const SF_BYTES: u64 = 200
const MAGIC: u64 = 0x5349474E414C4B39 // "SIGNALK9"

// Der rote Bereich von System V.
const REDZONE: u64 = 128

// Die zweiundzwanzig Woerter, die `iretq` zurueckgibt -- die Form, die
// `isr_common` in isr.s aufbaut.
const C_R15: u64 = 0
const C_R11: u64 = 32
const C_R10: u64 = 40
const C_RDI: u64 = 64
const C_RSI: u64 = 72
const C_RDX: u64 = 96
const C_RCX: u64 = 104
const C_RAX: u64 = 112
const C_VECTOR: u64 = 120
const C_ERROR: u64 = 128
const C_RIP: u64 = 136
const C_CS: u64 = 144
const C_RFLAGS: u64 = 152
const C_RSP: u64 = 160
const C_SS: u64 = 168
const C_WORDS: u64 = 22

// Die Form des Systemaufrufrahmens (`kernel/sys.fi`, F_*).
const F_R15: u64 = 0
const F_R14: u64 = 8
const F_R13: u64 = 16
const F_R12: u64 = 24
const F_RBP: u64 = 32
const F_RBX: u64 = 40
const F_R9: u64 = 48
const F_R8: u64 = 56
const F_R10: u64 = 64
const F_RDX: u64 = 72
const F_RSI: u64 = 80
const F_RDI: u64 = 88
const F_RAX: u64 = 96
const F_RIP: u64 = 104
const F_RFLAGS: u64 = 112
const F_RSP: u64 = 120

// Die Wahlnummern aus isr.s.
const V_TRAMP: u64 = 67
const V_IRET: u64 = 68

// Was `sysret` laedt (`kernel/user.fi`, MSR_STAR): Nutzercode 0x2B,
// Nutzerstapel 0x23. Ein Signal, das aus einem Systemaufruf heraus
// zugestellt wird, hat keine gespeicherten Selektoren -- diese beiden
// sind die einzigen, die ein Prozess dieses Kernels je hat.
const USER_CS: u64 = 0x2B
const USER_SS: u64 = 0x23

fn vector(state: u64, i: u64) -> u64 {
    return __mmio_read64((kstate.get(state, kstate.VECTORS) + i * 8) as *mut u64)
}

fn neg(e: u64) -> u64 {
    return errno.neg(e)
}

fn act(state: u64, task: u64, sig: u64) -> u64 {
    return state + kstate.SIG_OFF + task * A_TASK + sig * A_BYTES
}

fn aget(p: u64) -> u64 {
    return __mmio_read64(p as *mut u64)
}

fn aset(p: u64, v: u64) {
    __mmio_write64(p as *mut u64, v)
}

fn ctx_of(state: u64, task: u64) -> u64 {
    return state + kstate.SIGCTX_OFF + task * kstate.SIGCTX_BYTES
}

fn bit(sig: u64) -> u64 {
    if sig == 0 || sig >= NSIG {
        return 0
    }
    return 1 << (sig - 1)
}

// Zwei Signale kann niemand abfangen, blockieren oder ueberhoeren --
// SIGKILL und SIGSTOP. Das ist keine Bequemlichkeit des Kernels, es ist
// die einzige Zusage, die ein Betreiber gegenueber einem Programm hat,
// das nicht mehr auf sich selbst hoert.
fn uncatchable(sig: u64) -> bool {
    return sig == SIGKILL || sig == SIGSTOP
}

// Das Standardverhalten. Aus SUSv4, Tabelle "Signal Default Actions".
fn default_of(sig: u64) -> u64 {
    if sig == SIGCHLD || sig == SIGWINCH || sig == 23 {
        return D_IGN
    }
    if sig == SIGCONT {
        return D_CONT
    }
    if sig == SIGSTOP || sig == SIGTSTP || sig == SIGTTIN || sig == SIGTTOU {
        return D_STOP
    }
    if sig == SIGQUIT || sig == SIGILL || sig == SIGTRAP || sig == SIGABRT
    || sig == SIGBUS || sig == SIGFPE || sig == SIGSEGV || sig == 31 {
        return D_CORE
    }
    return D_TERM
}

// Vier Oktette je Name, damit der Index eine Multiplikation ist und keine
// Suche -- dieselbe Bauart wie die Ausnahmenamen in `trap.report`.
// Der Name wird GESCHRIEBEN und nicht zurueckgegeben. Firn laesst die
// Adresse eines lokalen Feldes nicht aus einer Funktion heraus (und hat
// recht damit -- sie zeigte auf einen Stapelrahmen, den es dann nicht
// mehr gibt), und das Kernelprofil hat keine globalen Zeichenketten. Also
// steht die Tabelle dort, wo sie benutzt wird.
fn say_name(sig: u64) {
    var names: [u8; 128] = "?  \0HUP\0INT\0QIT\0ILL\0TRP\0ABR\0BUS\0FPE\0KIL\0US1\0SEG\0US2\0PIP\0ALR\0TRM\0STK\0CHL\0CNT\0STP\0TSP\0TIN\0TOU\0URG\0XCP\0XFS\0VTA\0PRF\0WIN\0IO \0PWR\0SYS\0"
    var n: u64 = sig
    if n >= NSIG {
        n = 0
    }
    serial.puts((&names[0]) as u64 + n * 4)
}

// ------------------------------------------------------- je Aufgabe

fn clear_task(state: u64, task: u64) {
    if task >= kstate.MAX_TASKS {
        return
    }
    var i: u64 = 0
    while i < NSIG {
        aset(act(state, task, i) + A_HANDLER, SIG_DFL)
        aset(act(state, task, i) + A_FLAGS, 0)
        aset(act(state, task, i) + A_MASK, 0)
        i = i + 1
    }
    sched.tset(state, task, sched.T_SIGPEND, 0)
    sched.tset(state, task, sched.T_SIGMASK, 0)
    sched.tset(state, task, sched.T_SIGRET, 0)
    sched.tset(state, task, sched.T_ALARM, 0)
    sched.tset(state, task, sched.T_STOPSIG, 0)
}

fn init_task(state: u64, task: u64) {
    clear_task(state, task)
    // Die Prozessgruppe ist die eigene pid, solange niemand etwas anderes
    // sagt -- `setpgid(0, 0)` ist dann ein Nichts und keine Aenderung.
    let pid: u64 = sched.tget(state, task, sched.T_PID)
    sched.tset(state, task, sched.T_PGID, pid)
    sched.tset(state, task, sched.T_SID, pid)
    sched.tset(state, task, sched.T_TGID, pid)
}

// `fork`: das Kind erbt die Routinen und die Maske, aber KEINE wartenden
// Signale. Das steht so in POSIX, und der Grund ist einleuchtend -- ein
// SIGINT, das dem Elternprozess galt, gilt nicht dem Kind, das es im
// Augenblick des Abschickens noch nicht gab.
fn inherit(state: u64, parent: u64, child: u64) {
    var i: u64 = 0
    while i < NSIG {
        aset(act(state, child, i) + A_HANDLER,
            aget(act(state, parent, i) + A_HANDLER))
        aset(act(state, child, i) + A_FLAGS,
            aget(act(state, parent, i) + A_FLAGS))
        aset(act(state, child, i) + A_MASK,
            aget(act(state, parent, i) + A_MASK))
        i = i + 1
    }
    sched.tset(state, child, sched.T_SIGPEND, 0)
    sched.tset(state, child, sched.T_SIGRET, 0)
    sched.tset(state, child, sched.T_SIGMASK,
        sched.tget(state, parent, sched.T_SIGMASK))
    sched.tset(state, child, sched.T_PGID,
        sched.tget(state, parent, sched.T_PGID))
    sched.tset(state, child, sched.T_SID,
        sched.tget(state, parent, sched.T_SID))
    sched.tset(state, child, sched.T_TTY,
        sched.tget(state, parent, sched.T_TTY))
    sched.tset(state, child, sched.T_TGID,
        sched.tget(state, child, sched.T_PID))
}

// `execve`: das neue Abbild hat die Routinen des alten nicht mehr -- ihre
// Adressen zeigen in Code, den es nicht mehr gibt. Was UEBERHOERT wurde,
// bleibt ueberhoert (POSIX), alles andere faellt auf das Standard-
// verhalten zurueck. Die Maske ueberlebt, die Prozessgruppe auch.
fn exec_reset(state: u64, task: u64) {
    var i: u64 = 0
    while i < NSIG {
        if aget(act(state, task, i) + A_HANDLER) != SIG_IGN {
            aset(act(state, task, i) + A_HANDLER, SIG_DFL)
        }
        aset(act(state, task, i) + A_FLAGS, 0)
        aset(act(state, task, i) + A_MASK, 0)
        i = i + 1
    }
    sched.tset(state, task, sched.T_SIGRET, 0)
}

fn handler_of(state: u64, task: u64, sig: u64) -> u64 {
    if sig >= NSIG {
        return SIG_DFL
    }
    return aget(act(state, task, sig) + A_HANDLER)
}

fn pending(state: u64, task: u64) -> u64 {
    return sched.tget(state, task, sched.T_SIGPEND)
}

// Was JETZT zugestellt werden koennte: wartend und nicht blockiert.
fn deliverable(state: u64, task: u64) -> u64 {
    return sched.tget(state, task, sched.T_SIGPEND)
        & (0xFFFFFFFFFFFFFFFF -% sched.tget(state, task, sched.T_SIGMASK))
}

// Wartet etwas, das einen blockierenden Systemaufruf abbrechen muss? Das
// ist die Frage, die aus einem `read` auf der Tastatur ein -EINTR macht,
// und ohne sie wuerde STRG-C in einer Shell, die auf eine Zeile wartet,
// nichts tun.
fn interrupted(state: u64, task: u64) -> bool {
    return deliverable(state, task) != 0
}

fn stopped_count(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if sched.tget(state, i, sched.T_STATE) == sched.S_STOP {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// ------------------------------------------------------------ abschicken

// Ein Signal an eine Aufgabe. Billig und ohne Zustellung: ein Bit, und
// wenn das Ziel schlaeft oder wartet, ein Stups, damit es aufwacht und
// selbst nachsieht.
fn send_task(state: u64, task: u64, sig: u64) -> bool {
    if task >= kstate.MAX_TASKS || sig == 0 || sig >= NSIG {
        return false
    }
    let st: u64 = sched.tget(state, task, sched.T_STATE)
    if st == sched.S_FREE || st == sched.S_ZOMBIE {
        return false
    }
    let flags: u64 = sched.irq_save()
    // SIGCONT loescht die wartenden Anhaltesignale und umgekehrt -- sonst
    // wuerde ein Prozess, dem beides zugleich geschickt wurde, von der
    // Reihenfolge der Zustellung abhaengen.
    var pend: u64 = sched.tget(state, task, sched.T_SIGPEND)
    if sig == SIGCONT {
        pend = pend & (0xFFFFFFFFFFFFFFFF -% (bit(SIGSTOP) | bit(SIGTSTP)
                | bit(SIGTTIN) | bit(SIGTTOU)))
        // Fortsetzen wirkt SOFORT, auch wenn die Routine erst spaeter
        // laeuft: das ist die einzige Art, wie eine angehaltene Aufgabe
        // ueberhaupt wieder dazu kommt, irgendetwas zuzustellen.
        if st == sched.S_STOP {
            sched.tset(state, task, sched.T_STATE, sched.S_READY)
            sched.tset(state, task, sched.T_STOPSIG, 0)
        }
    }
    if sig == SIGSTOP || sig == SIGTSTP || sig == SIGTTIN || sig == SIGTTOU {
        pend = pend & (0xFFFFFFFFFFFFFFFF -% bit(SIGCONT))
    }
    sched.tset(state, task, sched.T_SIGPEND, pend | bit(sig))
    // Ein Schlaefer und ein Wartender werden wach: sie sollen die Frage
    // stellen, ob etwas fuer sie da ist. Ein ANGEHALTENER nicht -- nur
    // SIGCONT weckt den, und das ist oben schon geschehen.
    let now: u64 = sched.tget(state, task, sched.T_STATE)
    if now == sched.S_SLEEP || now == sched.S_WAIT {
        sched.tset(state, task, sched.T_STATE, sched.S_READY)
    }
    // SIGKILL HOLT AUCH EINEN ANGEHALTENEN ZURUECK, und das ist keine
    // Feinheit: ein Prozess, der mit STRG-Z angehalten wurde, stellt
    // nichts mehr zu -- er bekommt den Prozessor nicht. Ein `kill -9`
    // darauf verschwaende sonst still, und wer auf ihn wartet, wartet
    // fuer immer. Genau das ist in dieser Runde einmal passiert: der
    // Selbsttest blieb hinter "job ttin" stehen, weil ein von SIGTTIN
    // angehaltenes Kind sein SIGKILL nie sah.
    if sig == SIGKILL && now == sched.S_STOP {
        sched.tset(state, task, sched.T_STATE, sched.S_READY)
        sched.tset(state, task, sched.T_STOPSIG, 0)
    }
    sched.irq_restore(flags)
    kstate.add(state, kstate.SIG_SENT, 1)
    return true
}

fn send_pid(state: u64, pid: u64, sig: u64) -> u64 {
    let i: u64 = sched.find_pid(state, pid)
    if i >= kstate.MAX_TASKS {
        return neg(errno.E_SRCH)
    }
    if sig == 0 {
        // Nummer null schickt nichts und prueft nur, ob es den Prozess
        // gibt -- der Weg, auf dem jede Shell nachsieht, ob ein Auftrag
        // noch lebt.
        return 0
    }
    if !send_task(state, i, sig) {
        return neg(errno.E_SRCH)
    }
    return 0
}

// An eine ganze Prozessgruppe -- was STRG-C wirklich tut. Gibt zurueck,
// wie viele es getroffen hat.
fn send_pgid(state: u64, pgid: u64, sig: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var hit: u64 = 0
    while i < n {
        let st: u64 = sched.tget(state, i, sched.T_STATE)
        if st != sched.S_FREE && st != sched.S_ZOMBIE
        && sched.tget(state, i, sched.T_KIND) == sched.K_USER
        && sched.tget(state, i, sched.T_PGID) == pgid {
            if send_task(state, i, sig) {
                hit = hit + 1
            }
        }
        i = i + 1
    }
    return hit
}

fn send(state: u64, task: u64, sig: u64) -> bool {
    return send_task(state, task, sig)
}

// SIGCHLD an den Elternprozess. Wird gerufen, BEVOR die Aufgabe zur
// Leiche wird -- danach kennt niemand mehr ihren Elternteil mit
// Sicherheit. `wait4` weckt `sched.exit_task` ohnehin; dieses Signal ist
// das, was ein Programm ohne `wait` davon erfaehrt.
fn exiting(state: u64, task: u64) {
    let p: u64 = sched.tget(state, task, sched.T_PARENT)
    if p >= kstate.MAX_TASKS || p == task {
        return
    }
    if sched.tget(state, p, sched.T_KIND) != sched.K_USER {
        return
    }
    send_task(state, p, SIGCHLD)
}

// ------------------------------------------------- aus einer Ausnahme

// WAS AUS EINEM PROZESSORFEHLER WIRD. Bis zu dieser Runde toetete jede
// Ausnahme in Ring 3 den Prozess auf der Stelle (`sched.kill_current`).
// Das ist die Haelfte der Wahrheit: ein Zugriff daneben IST toedlich,
// solange niemand hinsieht -- aber ein Programm DARF hinsehen. Genau
// dafuer gibt es SIGSEGV, und ein Sprachlaufzeitsystem, das seinen Stapel
// waechst, wenn er anstoesst, haengt daran.
//
// Die Zuordnung ist die von Linux (`arch/x86/kernel/traps.c`):
fn signal_of(v: u64) -> u64 {
    if v == 0 {
        return SIGFPE // #DE, geteilt durch null
    }
    if v == 1 || v == 3 {
        return SIGTRAP
    }
    if v == 4 {
        return SIGSEGV // #OF
    }
    if v == 5 {
        return SIGSEGV // #BR
    }
    if v == 6 {
        return SIGILL // #UD
    }
    if v == 8 || v == 10 || v == 11 || v == 12 || v == 13 {
        return SIGSEGV // #DF, #TS, #NP, #SS, #GP
    }
    if v == 14 {
        return SIGSEGV // #PF
    }
    if v == 16 || v == 19 {
        return SIGFPE // #MF, #XM
    }
    if v == 17 {
        return SIGBUS // #AC
    }
    return SIGSEGV
}

// Ein Fehler aus Ring 3. Gibt zurueck, ob er ZUGESTELLT werden konnte --
// dann geht es im Prozess weiter (mit der Routine oder mit seinem Tod),
// und der Kernel bleibt stehen, wo er ist.
fn fault(state: u64, task: u64, v: u64) -> u64 {
    let sig: u64 = signal_of(v)
    sched.tset(state, task, sched.T_FAULTS,
        sched.tget(state, task, sched.T_FAULTS) + 1)
    // Ein Fehler LAESST SICH NICHT BLOCKIEREN. Wer SIGSEGV blockiert und
    // dann daneben greift, bekommt es trotzdem -- alles andere waere eine
    // Schleife aus derselben Ausnahme fuer immer. Also faellt die Maske
    // fuer dieses eine Signal, so wie es in jedem Unix geschieht.
    let m: u64 = sched.tget(state, task, sched.T_SIGMASK)
    sched.tset(state, task, sched.T_SIGMASK, m & (0xFFFFFFFFFFFFFFFF -% bit(sig)))
    // Und eine eigene Routine gilt nur EINMAL: kehrt sie zurueck, laeuft
    // derselbe Befehl wieder und faellt wieder. Ein Programm, das das
    // will, setzt sie in der Routine neu.
    if handler_of(state, task, sig) != SIG_DFL {
        aset(act(state, task, sig) + A_FLAGS,
            aget(act(state, task, sig) + A_FLAGS) | SA_RESETHAND)
    }
    // Der Beendigungscode, den die Runden 62 bis K6 gemessen haben:
    // 128 + VEKTOR und nicht 128 + Signalnummer. Er gilt nur fuer diesen
    // einen Tod und nur, wenn ihn niemand abfaengt.
    sched.tset(state, task, sched.T_KILLCODE, 128 + v)
    send_task(state, task, sig)
    return sig
}

// Wird dieses Signal den Prozess umbringen? Die Frage, die `trap.fi`
// stellen muss, bevor es "-- process killed" druckt: was abgefangen wird,
// bringt niemanden um.
fn lethal(state: u64, task: u64, sig: u64) -> bool {
    if uncatchable(sig) {
        return sig == SIGKILL
    }
    let h: u64 = handler_of(state, task, sig)
    if h != SIG_DFL {
        return false
    }
    let d: u64 = default_of(sig)
    return d == D_TERM || d == D_CORE
}

// SIGALRM, wenn die Frist abgelaufen ist. Aus dem Zeitgeber gerufen.
fn alarm_check(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    let now: u64 = kstate.get(state, kstate.TICKS)
    var i: u64 = 0
    var fired: u64 = 0
    while i < n {
        let due: u64 = sched.tget(state, i, sched.T_ALARM)
        if due != 0 && due <= now {
            sched.tset(state, i, sched.T_ALARM, 0)
            if send_task(state, i, SIGALRM) {
                fired = fired + 1
            }
        }
        i = i + 1
    }
    return fired
}

// ------------------------------------------------------- der Nutzerstapel

fn poke64(state: u64, task: u64, addr: u64, v: u64) -> bool {
    let phys: u64 = proc.translate(state, task, addr)
    if phys == 0 {
        return false
    }
    // ROUNDE K10: der Signalrahmen wird auf den NUTZERSTAPEL gelegt, und
    // das ist Speicher, den Ring 3 sehen darf. Mit CR4.SMAP braucht auch
    // dieser Weg sein Fenster (`guard.fi`).
    guard.stac(state)
    __mmio_write64(phys as *mut u64, v)
    guard.clac(state)
    return true
}

fn peek64(state: u64, task: u64, addr: u64) -> u64 {
    let phys: u64 = proc.translate(state, task, addr)
    if phys == 0 {
        return 0
    }
    guard.stac(state)
    let v: u64 = __mmio_read64(phys as *mut u64)
    guard.clac(state)
    return v
}

// ----------------------------------------------------------- zustellen

// Die eine Stelle, an der ein Signal wirklich ankommt. `ctx` zeigt auf
// zweiundzwanzig Woerter in der Form von isr.s -- der Aufrufer hat sie
// entweder direkt (aus einer Unterbrechung) oder aus dem
// Systemaufrufrahmen zusammengesetzt. Gibt zurueck, ob rip und rsp
// geaendert wurden; nur dann muss der Aufrufer sie in seinen eigenen
// Rahmen zurueckschreiben.
fn deliver(state: u64, task: u64, sig: u64, ctx: u64) -> bool {
    let h: u64 = handler_of(state, task, sig)
    let old_rsp: u64 = __mmio_read64((ctx + C_RSP) as *mut u64)
    let base: u64 = ((old_rsp -% REDZONE) -% SF_BYTES) & 0xFFFFFFFFFFFFFFF0
    let ret: u64 = base -% 8
    // Der Rahmen muss vollstaendig im Stapel des Prozesses liegen. Ein
    // Stapel, der dafuer zu klein geworden ist, ist der Fall, in dem
    // jedes Unix den Prozess mit SIGSEGV beendet -- und wir tun es hier
    // ohne Umweg, weil ein halb geschriebener Rahmen schlimmer waere.
    if !proc.user_ok(state, task, ret, SF_BYTES + 8) {
        return false
    }
    poke64(state, task, ret, vector(state, V_TRAMP))
    poke64(state, task, base + SF_MAGIC, MAGIC)
    poke64(state, task, base + SF_MASK,
        sched.tget(state, task, sched.T_SIGMASK))
    poke64(state, task, base + SF_SIG, sig)
    var i: u64 = 0
    while i < C_WORDS {
        poke64(state, task, base + SF_CTX + i * 8,
            __mmio_read64((ctx + i * 8) as *mut u64))
        i = i + 1
    }
    // Waehrend die Routine laeuft, ist ihr eigenes Signal blockiert (das
    // ist der Sinn von `sa_mask` plus der Nummer selbst) -- sonst
    // unterbricht ein zweites SIGINT die Behandlung des ersten mitten
    // darin, und der Stapel waechst, solange jemand die Taste haelt.
    let fl: u64 = aget(act(state, task, sig) + A_FLAGS)
    var m: u64 = sched.tget(state, task, sched.T_SIGMASK)
        | aget(act(state, task, sig) + A_MASK)
    if (fl & SA_NODEFER) == 0 {
        m = m | bit(sig)
    }
    sched.tset(state, task, sched.T_SIGMASK, m)
    sched.tset(state, task, sched.T_SIGRET, base)
    // `SA_RESETHAND`: die Routine gilt einmal. `signal()` von C hiess so,
    // bevor `sigaction` es abwaehlbar machte.
    if (fl & SA_RESETHAND) != 0 {
        aset(act(state, task, sig) + A_HANDLER, SIG_DFL)
        aset(act(state, task, sig) + A_FLAGS, fl & (0xFFFFFFFFFFFFFFFF -% SA_RESETHAND))
    }
    // Und der Sprung: rip auf die Routine, rsp auf den Rahmen, rdi auf
    // die Nummer. rsi und rdx waeren siginfo und ucontext -- dieser
    // Kernel gibt sie nicht, und `docs/ROUNDK9.md` sagt das ausdruecklich,
    // statt zwei Zeiger auf nichts zu uebergeben.
    __mmio_write64((ctx + C_RIP) as *mut u64, h)
    __mmio_write64((ctx + C_RSP) as *mut u64, ret)
    __mmio_write64((ctx + C_RDI) as *mut u64, sig)
    __mmio_write64((ctx + C_RSI) as *mut u64, 0)
    __mmio_write64((ctx + C_RDX) as *mut u64, 0)
    sched.tset(state, task, sched.T_SIGDEL,
        sched.tget(state, task, sched.T_SIGDEL) + 1)
    kstate.add(state, kstate.SIG_CAUGHT, 1)
    kstate.add(state, kstate.SIG_DELIVERED, 1)
    return true
}

// Das Standardverhalten. Gibt zurueck, ob die Aufgabe danach noch laeuft.
fn do_default(state: u64, task: u64, sig: u64) -> bool {
    let what: u64 = default_of(sig)
    kstate.add(state, kstate.SIG_DEFAULT, 1)
    kstate.add(state, kstate.SIG_DELIVERED, 1)
    if what == D_IGN || what == D_CONT {
        return true
    }
    if what == D_STOP {
        sched.tset(state, task, sched.T_STOPSIG, sig)
        sched.tset(state, task, sched.T_STATE, sched.S_STOP)
        kstate.add(state, kstate.SIG_STOPS, 1)
        // Der Elternteil erfaehrt es -- so wie er es vom Ende erfaehrt.
        exiting(state, task)
        // Und jetzt die Aufgabe wirklich aus der Hand geben. Kommt zurueck,
        // wenn SIGCONT sie wieder auf S_READY gesetzt hat.
        sched.schedule(state)
        return true
    }
    // Beenden. Der Code ist der, den jede Shell liest: 128 + Nummer.
    // Eine Zeile, wenn ein Signal einen Prozess umbringt -- aber NICHT,
    // wenn es eine Ausnahme war: die hat `trap.fi` schon in der Form
    // gemeldet, die seit Runde 62 gemessen wird, und zwei Meldungen
    // desselben Todes waeren eine zu viel.
    if sched.tget(state, task, sched.T_KILLCODE) == 0 {
        var s_dead: [u8; 15] = "signal: pid=\0\0\0"
        var s_by: [u8; 8] = " SIG\0\0\0\0"
        var s_end: [u8; 11] = " -- killed\0"
        serial.puts((&s_dead[0]) as u64)
        serial.dec(sched.tget(state, task, sched.T_PID))
        serial.puts((&s_by[0]) as u64)
        say_name(sig)
        serial.puts((&s_end[0]) as u64)
        serial.nl()
    }
    sched.tset(state, task, sched.T_SIGLAST, sig)
    kstate.add(state, kstate.KILLED, 1)
    exiting(state, task)
    var code: u64 = 128 + sig
    let forced: u64 = sched.tget(state, task, sched.T_KILLCODE)
    if forced != 0 {
        code = forced
        sched.tset(state, task, sched.T_KILLCODE, 0)
    }
    sched.exit_task(state, code)
    return false // nicht erreicht
}

// Die naechste zustellbare Nummer, oder 0. Kleine Nummern zuerst -- das
// bringt SIGKILL (9) vor SIGTERM (15) und die Fehlersignale vor alles
// andere, was die Reihenfolge ist, die jedes Unix hat.
fn next_signal(state: u64, task: u64) -> u64 {
    let d: u64 = deliverable(state, task)
    if d == 0 {
        return 0
    }
    var s: u64 = 1
    while s < NSIG {
        if (d & bit(s)) != 0 {
            return s
        }
        s = s + 1
    }
    return 0
}

// Der Kern der Zustellung, auf einem fertigen Zusammenhang. Gibt zurueck,
// ob der Zusammenhang veraendert wurde.
fn run_pending(state: u64, task: u64, ctx: u64) -> bool {
    // DIE GEGENPROBE. Mit `nosig` wird nichts zugestellt. Die Bits
    // bleiben stehen, die Zaehler der ABGESCHICKTEN Signale stimmen
    // weiter -- nur ankommen tut nichts, und ein Programm, das seine
    // SIGINTs zaehlt, muss dann bei null bleiben.
    if kstate.mode_on(state, kstate.M_NOSIG) {
        return false
    }
    var changed: bool = false
    var rounds: u64 = 0
    while rounds < NSIG {
        let sig: u64 = next_signal(state, task)
        if sig == 0 {
            return changed
        }
        // Das Bit faellt, BEVOR gehandelt wird: sonst stellt dieselbe
        // Schleife dasselbe Signal noch einmal zu.
        sched.tset(state, task, sched.T_SIGPEND,
            sched.tget(state, task, sched.T_SIGPEND)
            & (0xFFFFFFFFFFFFFFFF -% bit(sig)))
        sched.tset(state, task, sched.T_SIGLAST, sig)
        let h: u64 = handler_of(state, task, sig)
        if uncatchable(sig) {
            do_default(state, task, sig)
        } else {
            if h == SIG_IGN {
                kstate.add(state, kstate.SIG_DELIVERED, 1)
            } else {
                if h == SIG_DFL {
                    do_default(state, task, sig)
                } else {
                    if deliver(state, task, sig, ctx) {
                        // Nur EINE Routine je Rueckkehr. Die naechste
                        // kommt, wenn diese durch `sigreturn` wieder
                        // herausgekommen ist -- alles andere baute
                        // Rahmen auf Rahmen.
                        return true
                    }
                    // Der Stapel gab den Rahmen nicht her: das ist der
                    // Fall, in dem der Prozess stirbt.
                    do_default(state, task, SIGSEGV)
                }
            }
        }
        rounds = rounds + 1
    }
    return changed
}

// Aus einem SYSTEMAUFRUF heraus. Der Rahmen hat sechzehn Woerter in der
// Form von `sys.fi`; daraus wird der vollstaendige Zusammenhang gebaut.
// rcx und r11 sind hier wirklich verloren -- `syscall` hat sie beim
// Eintritt zerstoert, bevor irgendjemand sie sehen konnte.
fn check_sys(state: u64, task: u64, frame: u64) {
    if sched.tget(state, task, sched.T_KIND) != sched.K_USER {
        return
    }
    if deliverable(state, task) == 0 {
        return
    }
    let c: u64 = ctx_of(state, task)
    var i: u64 = 0
    while i < C_WORDS {
        __mmio_write64((c + i * 8) as *mut u64, 0)
        i = i + 1
    }
    __mmio_write64((c + 0) as *mut u64, __mmio_read64((frame + F_R15) as *mut u64))
    __mmio_write64((c + 8) as *mut u64, __mmio_read64((frame + F_R14) as *mut u64))
    __mmio_write64((c + 16) as *mut u64, __mmio_read64((frame + F_R13) as *mut u64))
    __mmio_write64((c + 24) as *mut u64, __mmio_read64((frame + F_R12) as *mut u64))
    __mmio_write64((c + C_R10) as *mut u64, __mmio_read64((frame + F_R10) as *mut u64))
    __mmio_write64((c + 48) as *mut u64, __mmio_read64((frame + F_R9) as *mut u64))
    __mmio_write64((c + 56) as *mut u64, __mmio_read64((frame + F_R8) as *mut u64))
    __mmio_write64((c + C_RDI) as *mut u64, __mmio_read64((frame + F_RDI) as *mut u64))
    __mmio_write64((c + C_RSI) as *mut u64, __mmio_read64((frame + F_RSI) as *mut u64))
    __mmio_write64((c + 80) as *mut u64, __mmio_read64((frame + F_RBP) as *mut u64))
    __mmio_write64((c + 88) as *mut u64, __mmio_read64((frame + F_RBX) as *mut u64))
    __mmio_write64((c + C_RDX) as *mut u64, __mmio_read64((frame + F_RDX) as *mut u64))
    __mmio_write64((c + C_RAX) as *mut u64, __mmio_read64((frame + F_RAX) as *mut u64))
    __mmio_write64((c + C_RIP) as *mut u64, __mmio_read64((frame + F_RIP) as *mut u64))
    __mmio_write64((c + C_CS) as *mut u64, USER_CS)
    __mmio_write64((c + C_RFLAGS) as *mut u64, __mmio_read64((frame + F_RFLAGS) as *mut u64))
    __mmio_write64((c + C_RSP) as *mut u64, __mmio_read64((frame + F_RSP) as *mut u64))
    __mmio_write64((c + C_SS) as *mut u64, USER_SS)
    if !run_pending(state, task, c) {
        return
    }
    // Zurueck in den Systemaufrufrahmen: nur die vier Woerter, die die
    // Zustellung wirklich veraendert hat.
    __mmio_write64((frame + F_RIP) as *mut u64, __mmio_read64((c + C_RIP) as *mut u64))
    __mmio_write64((frame + F_RSP) as *mut u64, __mmio_read64((c + C_RSP) as *mut u64))
    __mmio_write64((frame + F_RDI) as *mut u64, __mmio_read64((c + C_RDI) as *mut u64))
    __mmio_write64((frame + F_RSI) as *mut u64, __mmio_read64((c + C_RSI) as *mut u64))
    __mmio_write64((frame + F_RDX) as *mut u64, __mmio_read64((c + C_RDX) as *mut u64))
}

// Aus einer UNTERBRECHUNG heraus -- und das ist der Fall, den STRG-C in
// einer Endlosschleife braucht: das Programm macht keine Systemaufrufe,
// also gibt es nur einen Augenblick, in dem der Kernel es in der Hand
// hat, und das ist der Zeitgeber. Der Rahmen von `isr_common` HAT bereits
// die richtige Form; er kann unmittelbar benutzt werden.
fn check_trap(state: u64, task: u64, frame: u64) {
    if sched.tget(state, task, sched.T_KIND) != sched.K_USER {
        return
    }
    let cs: u64 = __mmio_read64((frame + C_CS) as *mut u64)
    if (cs & 3) != 3 {
        return
    }
    if deliverable(state, task) == 0 {
        return
    }
    run_pending(state, task, frame)
}

// ------------------------------------------------------ die Systemaufrufe

// `rt_sigaction(sig, act, old, sigsetsize)`. Die Struktur ist Linux':
//   +0 Routine, +8 Flaggen, +16 Wiederherstellung, +24 Maske
// Der `sa_restorer` wird gelesen und verworfen: dieser Kernel hat einen
// eigenen Trampolinsprung in `.utext` und braucht keinen aus der libc --
// und ein Zeiger aus Ring 3, dem der Kernel BLIND folgt, waere genau die
// Art Vertrauen, die dieser Kernel sonst nirgends aufbringt.
fn do_sigaction(state: u64, task: u64, sig: u64, na: u64, oa: u64) -> u64 {
    if sig == 0 || sig >= NSIG {
        return neg(errno.E_INVAL)
    }
    if uncatchable(sig) && na != 0 {
        return neg(errno.E_INVAL)
    }
    if oa != 0 {
        if !proc.user_ok(state, task, oa, 32) {
            return neg(errno.E_FAULT)
        }
        poke64(state, task, oa + 0, aget(act(state, task, sig) + A_HANDLER))
        poke64(state, task, oa + 8, aget(act(state, task, sig) + A_FLAGS))
        poke64(state, task, oa + 16, 0)
        poke64(state, task, oa + 24, aget(act(state, task, sig) + A_MASK))
    }
    if na != 0 {
        if !proc.user_ok(state, task, na, 32) {
            return neg(errno.E_FAULT)
        }
        let h: u64 = peek64(state, task, na + 0)
        let f: u64 = peek64(state, task, na + 8)
        let m: u64 = peek64(state, task, na + 24)
        aset(act(state, task, sig) + A_HANDLER, h)
        aset(act(state, task, sig) + A_FLAGS, f)
        aset(act(state, task, sig) + A_MASK, m)
        // Eine Routine, die auf SIG_IGN gesetzt wird, wirft weg, was
        // wartet -- sonst kaeme das eine Signal noch, das im Augenblick
        // des Umschaltens unterwegs war.
        if h == SIG_IGN {
            sched.tset(state, task, sched.T_SIGPEND,
                sched.tget(state, task, sched.T_SIGPEND)
                & (0xFFFFFFFFFFFFFFFF -% bit(sig)))
        }
    }
    return 0
}

fn do_sigprocmask(state: u64, task: u64, how: u64, set: u64,
    old: u64) -> u64 {
    if old != 0 {
        if !proc.user_ok(state, task, old, 8) {
            return neg(errno.E_FAULT)
        }
        poke64(state, task, old, sched.tget(state, task, sched.T_SIGMASK))
    }
    if set == 0 {
        return 0
    }
    if !proc.user_ok(state, task, set, 8) {
        return neg(errno.E_FAULT)
    }
    let v: u64 = peek64(state, task, set)
    var m: u64 = sched.tget(state, task, sched.T_SIGMASK)
    if how == SIG_BLOCK {
        m = m | v
    } else {
        if how == SIG_UNBLOCK {
            m = m & (0xFFFFFFFFFFFFFFFF -% v)
        } else {
            if how == SIG_SETMASK {
                m = v
            } else {
                return neg(errno.E_INVAL)
            }
        }
    }
    // SIGKILL und SIGSTOP lassen sich nicht blockieren. Ein Programm, das
    // es versucht, bekommt keinen Fehler -- die beiden Bits fallen
    // einfach heraus, so wie in jedem Unix.
    m = m & (0xFFFFFFFFFFFFFFFF -% (bit(SIGKILL) | bit(SIGSTOP)))
    sched.tset(state, task, sched.T_SIGMASK, m)
    return 0
}

fn do_sigpending(state: u64, task: u64, out: u64) -> u64 {
    if !proc.user_ok(state, task, out, 8) {
        return neg(errno.E_FAULT)
    }
    poke64(state, task, out, sched.tget(state, task, sched.T_SIGPEND))
    return 0
}

// `rt_sigreturn`. Kommt aus dem Trampolinsprung, und der Stapelzeiger des
// Aufrufers zeigt genau auf den Rahmen, den `deliver` gelegt hat.
//
// DER KERNEL FOLGT DEM ZEIGER NICHT BLIND. Drei Dinge werden geprueft:
// der Rahmen liegt vollstaendig im Stapel des Prozesses, das Kennwort
// steht darin, und die Adresse ist die, die der Kernel selbst notiert hat
// (`T_SIGRET`). Ohne die dritte koennte ein Programm einen eigenen Rahmen
// bauen und sich damit Flaggen und Selektoren aussuchen -- und cs mit
// zwei Nullbits im Rueckgabewort ist Ring 0.
//
// Diese Funktion KEHRT NICHT ZURUECK: sie springt ueber `user_iret`
// unmittelbar nach Ring 3 zurueck, so wie `user_resume` es fuer das Kind
// eines `fork` tut.
fn do_sigreturn(state: u64, task: u64, frame: u64) -> u64 {
    let base: u64 = __mmio_read64((frame + F_RSP) as *mut u64)
    let noted: u64 = sched.tget(state, task, sched.T_SIGRET)
    if noted == 0 || base != noted {
        return neg(errno.E_FAULT)
    }
    if !proc.user_ok(state, task, base, SF_BYTES) {
        return neg(errno.E_FAULT)
    }
    if peek64(state, task, base + SF_MAGIC) != MAGIC {
        return neg(errno.E_FAULT)
    }
    let c: u64 = ctx_of(state, task)
    var i: u64 = 0
    while i < C_WORDS {
        __mmio_write64((c + i * 8) as *mut u64,
            peek64(state, task, base + SF_CTX + i * 8))
        i = i + 1
    }
    // Die Selektoren und die Flaggen kommen NICHT aus dem Rahmen, sie
    // werden neu gesetzt: was Ring 3 dort hineinschreiben koennte, waere
    // sonst der Weg nach Ring 0. Von den Flaggen bleibt nur, was ein
    // Programm ohnehin setzen darf; IF wird erzwungen, denn ein Prozess
    // mit abgeschalteten Unterbrechungen ist eine stehende Maschine.
    let fl: u64 = __mmio_read64((c + C_RFLAGS) as *mut u64)
    __mmio_write64((c + C_RFLAGS) as *mut u64, (fl & 0x00000CD5) | 0x202)
    __mmio_write64((c + C_CS) as *mut u64, USER_CS)
    __mmio_write64((c + C_SS) as *mut u64, USER_SS)
    sched.tset(state, task, sched.T_SIGMASK,
        peek64(state, task, base + SF_MASK)
        & (0xFFFFFFFFFFFFFFFF -% (bit(SIGKILL) | bit(SIGSTOP))))
    sched.tset(state, task, sched.T_SIGRET, 0)
    // Wartet schon das naechste? Dann sofort, auf demselben
    // Zusammenhang -- der Stapel ist wieder frei.
    run_pending(state, task, c)
    asm("call rax", in("rax") vector(state, V_IRET), in("rdi") c,
        clobber("memory"))
    return 0 // nicht erreicht
}

// `kill(pid, sig)` mit Linux' Bedeutung, und die ist mehr als eine Zahl:
//   pid  > 0   genau dieser Prozess
//   pid == 0   die eigene Prozessgruppe -- was eine Shell fuer STRG-C tut
//   pid  < 0   die Gruppe -pid
fn do_kill(state: u64, task: u64, pid: u64, sig: u64) -> u64 {
    if sig >= NSIG {
        return neg(errno.E_INVAL)
    }
    if pid == 0 {
        let g: u64 = sched.tget(state, task, sched.T_PGID)
        if send_pgid(state, g, sig) == 0 {
            return neg(errno.E_SRCH)
        }
        return 0
    }
    // Negativ heisst hier: das oberste Bit steht. Der Wert ist ein
    // `i64` im Register, und `0 -% pid` ist sein Betrag -- eine
    // Umdeutung, keine Subtraktion.
    if (pid & 0x8000000000000000) != 0 {
        let g: u64 = 0 -% pid
        if g == 1 {
            // -1 heisst "alle" -- in diesem Kernel: jeder Nutzerprozess
            // ausser dem Aufrufer selbst.
            let n: u64 = kstate.get(state, kstate.TASKS)
            var i: u64 = 0
            var hit: u64 = 0
            while i < n {
                if i != task && sched.tget(state, i, sched.T_KIND) == sched.K_USER {
                    if send_task(state, i, sig) {
                        hit = hit + 1
                    }
                }
                i = i + 1
            }
            if hit == 0 {
                return neg(errno.E_SRCH)
            }
            return 0
        }
        if send_pgid(state, g, sig) == 0 {
            return neg(errno.E_SRCH)
        }
        return 0
    }
    return send_pid(state, pid, sig)
}

// `pause()`: schlafen, bis irgendein Signal kommt. Immer -EINTR, so will
// es POSIX -- ein `pause`, das mit 0 zurueckkehrt, hat nichts gesagt.
fn do_pause(state: u64, task: u64) -> u64 {
    var rounds: u64 = 0
    while rounds < 6000 {
        if deliverable(state, task) != 0 {
            return neg(errno.E_INTR)
        }
        sched.sleep_ticks(state, 1)
        rounds = rounds + 1
    }
    return neg(errno.E_INTR)
}

// `alarm(sekunden)`: gibt zurueck, wie viel von einer frueheren Frist noch
// uebrig war.
fn do_alarm(state: u64, task: u64, secs: u64) -> u64 {
    let now: u64 = kstate.get(state, kstate.TICKS)
    let old: u64 = sched.tget(state, task, sched.T_ALARM)
    var left: u64 = 0
    if old > now {
        left = (old -% now) / 100
    }
    if secs == 0 {
        sched.tset(state, task, sched.T_ALARM, 0)
    } else {
        sched.tset(state, task, sched.T_ALARM, now +% (secs *% 100))
    }
    return left
}

// ---------------------------------------------------- die Prozessgruppen

// `setpgid(pid, pgid)`. Beide Nullen heissen "ich" und "meine eigene" --
// die Form, in der eine Shell einen Auftrag in eine Gruppe steckt.
fn do_setpgid(state: u64, task: u64, pid: u64, pgid: u64) -> u64 {
    var t: u64 = task
    if pid != 0 {
        t = sched.find_pid(state, pid)
        if t >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
    }
    var g: u64 = pgid
    if g == 0 {
        g = sched.tget(state, t, sched.T_PID)
    }
    // Ueber Sitzungsgrenzen hinweg geht es nicht -- das ist die einzige
    // Regel, die Prozessgruppen ueberhaupt zu etwas macht.
    if sched.tget(state, t, sched.T_SID) != sched.tget(state, task, sched.T_SID) {
        return neg(errno.E_PERM)
    }
    sched.tset(state, t, sched.T_PGID, g)
    return 0
}

fn do_getpgid(state: u64, task: u64, pid: u64) -> u64 {
    var t: u64 = task
    if pid != 0 {
        t = sched.find_pid(state, pid)
        if t >= kstate.MAX_TASKS {
            return neg(errno.E_SRCH)
        }
    }
    return sched.tget(state, t, sched.T_PGID)
}

// `setsid()`: eine neue Sitzung, eine neue Prozessgruppe, kein Terminal.
fn do_setsid(state: u64, task: u64) -> u64 {
    let pid: u64 = sched.tget(state, task, sched.T_PID)
    if sched.tget(state, task, sched.T_PGID) == pid
    && sched.tget(state, task, sched.T_SID) == pid {
        // Wer schon Fuehrer seiner eigenen Gruppe ist, kann keine neue
        // Sitzung aufmachen (POSIX) -- sonst gaebe es zwei Sitzungen mit
        // derselben Nummer.
        return neg(errno.E_PERM)
    }
    sched.tset(state, task, sched.T_SID, pid)
    sched.tset(state, task, sched.T_PGID, pid)
    sched.tset(state, task, sched.T_TTY, 0)
    return pid
}
