// SPDX-License-Identifier: GPL-2.0-only
// kernel/sercon.fi -- RUNDE SERVERBUILD: DIE SERIELLE LEITUNG WIRD EIN
// TERMINAL.
//
// WAS VORHER WAR, und es gehoert benannt, weil es der ganze Grund
// dieser Datei ist: `kernel/serial.fi` konnte seit Runde 59 SENDEN.
// Jede Bootmeldung, jeder Registerauszug, jede Zahl einer Messung ging
// hinaus, und `tools/*/run.sh` las sie mit `-serial file:` zurueck.
// Herein kam nichts. Getippt wurde entweder auf der PS/2-Tastatur
// (`kbd.fi`, IRQ 1) oder gar nicht -- und weil auch das zu wenig war,
// gibt es `script=` auf der Befehlszeile: eine Zeichenkette, die
// `sys.script_feed` der Shell vorlegt, als haette jemand sie getippt.
//
// Auf einem Server steht keine Tastatur. Da haengt ein Terminal an
// COM1 -- ueber eine IPMI-Konsole, einen Terminalserver oder schlicht
// `qemu -nographic` --, und dieses Terminal TIPPT. Diese Datei ist der
// Rueckweg.
//
// WAS EINE VOLLWERTIGE KONSOLE AUSMACHT, und es sind vier Dinge, von
// denen drei schon da waren:
//
//   1. AUSGABE. Seit Runde 59. Unveraendert.
//   2. EINE ZEILENDISZIPLIN -- Echo, Rueckschritt, STRG-U, STRG-D,
//      roher Modus, Fenstergroesse, Vordergrundgruppe. Die steht seit
//      Runde K9 in `kernel/tty.fi` und ist vollstaendig; sie hatte nur
//      nie eine zweite Quelle. Diese Datei gibt ihr eine.
//   3. STEUERZEICHEN ALS SIGNALE. STRG-C ist ein SIGINT an die
//      Vordergrundgruppe, und das entscheidet `tty.push` -- also
//      passiert es fuer ein Oktett von der Leitung genau so wie fuer
//      eine Taste. Das ist der Gewinn daraus, dass hier NICHT noch
//      einmal eine Zeilenbearbeitung geschrieben wird.
//   4. EINGABE. Diese Datei.
//
// WIE DAS OKTETT HEREINKOMMT. Der 8250 zieht IRQ 4, sobald etwas im
// Empfangsregister steht (IER Bit 0). Der I/O-APIC traegt GSI 4 auf
// Vektor 36 ein (`kernel/hw.fi`), `trap.fi` ruft `irq` hier, und `irq`
// leert die FIFO in die Zeilendisziplin der Konsole. Vierzehn Oktette
// passen in die FIFO; bei 38400 Baud sind das 3,6 Millisekunden Luft.
//
// UND WARUM ES DANEBEN EINEN ABFRAGEWEG GIBT (`poll`). Zwei Gruende,
// und beide sind gemessen und nicht ausgedacht:
//   * Die Gegenprobe `noserirq` nimmt den Eintrag im I/O-APIC weg. Ohne
//     einen zweiten Weg waere die Konsole dann tot statt langsam, und
//     eine Gegenprobe, die alles umbringt, misst nichts.
//   * Ein Kernel, der in einer engen Schleife auf eine Zeile wartet
//     (`sys.tty_read`), kann genauso gut selbst nachsehen. Das kostet
//     ein `in`-Befehl je Durchgang auf einem Weg, der ohnehin schlaeft.
//
// WAS `console=ttyS0` SONST NOCH TUT, und das ist die zweite Haelfte
// dieser Runde: es macht das Warten UNBEGRENZT. Bis hierher gab
// `sys.tty_read` nach 400 Ticks -- vier Sekunden -- eine Null zurueck
// und meldete damit das ENDE DER EINGABE. Das war richtig fuer einen
// Testlauf, der sich selbst beenden muss, und es ist falsch fuer eine
// Konsole, an der ein Mensch nachdenkt. Mit `console=` wartet sie, bis
// etwas kommt oder ein Signal sie unterbricht; ohne bleibt jede
// bestehende Messung auf die Zehntelsekunde genau, wie sie war.

profile kernel

import serial
import lib.kstate
import tty
import sched.rand
import sched.time

export {
    parse, init, irq, poll, active, port_of, rx, irqs, drops, overruns,
    report
}

// ------------------------------------------------------ die Befehlszeile

fn find(hay: u64, needle: u64, n: u64) -> u64 {
    var i: u64 = 0
    while kstate.get8(hay + i) != 0 {
        var k: u64 = 0
        var hit: bool = true
        while k < n {
            if kstate.get8(hay + i + k) != kstate.get8(needle + k) {
                hit = false
                k = n
            } else {
                k = k + 1
            }
        }
        if hit {
            return hay + i
        }
        i = i + 1
    }
    return 0
}

// `console=ttyS0` oder `console=ttyS1`. Mehr nicht: eine Form, die
// niemand schickt, ist eine, die niemand prueft -- derselbe Satz, mit
// dem `ansi.fi` seine Fluchtfolgen begruendet.
//
// Die Geschwindigkeit steht NICHT dabei. `serial.init` stellt seit
// Runde 59 38400 Baud ein, jeder Testlaeufer dieses Projektes liest
// mit dieser Zahl zurueck, und ein Schalter, der sie aendern kann,
// waere eine Art, jede bestehende Messung stillzulegen. Wer sie
// braucht, aendert `serial.init` -- an EINER Stelle.
fn parse(state: u64, cmd: u64) {
    var tag: [u8; 9] = "console=\0"
    var tty0: [u8; 6] = "ttyS0\0"
    var tty1: [u8; 6] = "ttyS1\0"
    kstate.set(state, kstate.SER_PORT, 0)
    if cmd == 0 {
        return
    }
    // Die Gegenproben stehen als eigene Woerter da, damit sie auch
    // ohne `console=` gesetzt werden koennen.
    var w_noirq: [u8; 9] = "noserirq\0"
    var w_poll: [u8; 8] = "serpoll\0"
    if find(cmd, (&w_noirq[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOSERIRQ)
    }
    if find(cmd, (&w_poll[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_SERPOLL)
    }
    let at: u64 = find(cmd, (&tag[0]) as u64, 8)
    if at == 0 {
        return
    }
    let arg: u64 = at + 8
    if find_at(arg, (&tty1[0]) as u64, 5) {
        kstate.set(state, kstate.SER_PORT, serial.COM2 as u64)
        kstate.mode_add(state, kstate.M_SERCON)
        return
    }
    if find_at(arg, (&tty0[0]) as u64, 5) {
        kstate.set(state, kstate.SER_PORT, serial.COM1 as u64)
        kstate.mode_add(state, kstate.M_SERCON)
    }
}

// Ob an DIESER Stelle genau dieses Wort steht -- nicht irgendwo.
// `console=ttyS10` darf nicht als `ttyS1` durchgehen.
fn find_at(p: u64, w: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get8(p + i) != kstate.get8(w + i) {
            return false
        }
        i = i + 1
    }
    let move_to: u64 = kstate.get8(p + n)
    return move_to == 0 || move_to == 32
}

fn active(state: u64) -> bool {
    return kstate.mode_on(state, kstate.M_SERCON)
}

fn port_of(state: u64) -> u64 {
    let p: u64 = kstate.get(state, kstate.SER_PORT)
    if p == 0 {
        return serial.COM1 as u64
    }
    return p
}

// ------------------------------------------------------------ der Start
//
// NACH `tty.init` und nach `hw.stage`. Die Reihenfolge ist keine
// Geschmacksfrage: kaeme ein Oktett, bevor die Zeilendisziplin steht,
// haette `tty.push` kein Terminal, in das es koennte -- deshalb prueft
// `irq` unten TTY_READY, und deshalb wird die FIFO hier einmal geleert.
fn init(state: u64) {
    if !active(state) {
        return
    }
    if !kstate.mode_on(state, kstate.M_NOSERIRQ) {
        serial.rx_on()
    }
    // UND SOFORT EINMAL LEEREN, statt die FIFO wegzuwerfen. Die erste
    // Fassung dieser Zeile hiess `serial.drain_fifo()` und begruendete
    // sich damit, dass Getipptes von vor dem Start nicht in die erste
    // Zeile der Shell gehoert. Ein Lauf hat gezeigt, was das kostet:
    // wer beim Start `echo hallo` schickt, sieht die Shell `cho hallo`
    // ausfuehren -- das `e` lag in der FIFO, als `init` sie leerte.
    // Ein Terminal wirft nichts weg; es hebt auf, was vor dem Start
    // ankam, und liefert es aus, sobald es kann. Genau das tut diese
    // Zeile, und die Oktette gehen durch dieselbe Zeilendisziplin wie
    // alle spaeteren.
    drain(state)
}

// ------------------------------------------------------ die Oktette

// Der gemeinsame Weg von IRQ und Abfrage. Die FIFO wird GELEERT und
// nicht ein Oktett je Ruf abgeholt: der 8250 zieht die Leitung nur
// einmal, und wer dann eines liegen laesst, hoert nie wieder etwas.
fn drain(state: u64) -> u64 {
    var n: u64 = 0
    var going: bool = true
    while going {
        let c: u64 = serial.rx_take()
        if c == 256 {
            going = false
        } else {
            kstate.add(state, kstate.SER_RX, 1)
            n = n + 1
            // Wann ein Mensch tippt, weiss vorher niemand -- dieselbe
            // Entropiequelle, die `kbd.irq` seit Runde K9 anzapft, nur
            // an einem anderen Kabel.
            rand.stir(state, time.tsc())
            if kstate.get(state, kstate.TTY_READY) != 0 {
                tty.push(state, tty.console(), c)
            } else {
                kstate.add(state, kstate.SER_DROPS, 1)
            }
            if n >= 64 {
                going = false
            }
        }
    }
    if serial.overrun() {
        kstate.add(state, kstate.SER_OVERRUNS, 1)
    }
    return n
}

fn irq(state: u64) {
    kstate.add(state, kstate.SER_IRQS, 1)
    drain(state)
}

// Von `sys.tty_read` aus der Warteschleife. Ohne `console=` tut sie
// nichts -- kein bestehender Lauf sieht ein Oktett, das er vorher nicht
// gesehen hat.
fn poll(state: u64) -> u64 {
    if !active(state) {
        return 0
    }
    return drain(state)
}

fn rx(state: u64) -> u64 {
    return kstate.get(state, kstate.SER_RX)
}

fn irqs(state: u64) -> u64 {
    return kstate.get(state, kstate.SER_IRQS)
}

fn drops(state: u64) -> u64 {
    return kstate.get(state, kstate.SER_DROPS)
}

fn overruns(state: u64) -> u64 {
    return kstate.get(state, kstate.SER_OVERRUNS)
}

// Die Zeile, gegen die `tools/server/run.sh` rechnet.
fn report(state: u64) {
    var s_a: [u8; 14] = "sercon: port=\0"
    var s_b: [u8; 6] = "  rx=\0"
    var s_c: [u8; 8] = "  irqs=\0"
    var s_d: [u8; 9] = "  drops=\0"
    var s_e: [u8; 12] = "  overruns=\0"
    var s_off: [u8; 13] = "sercon: off\0\0"
    if !active(state) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_a[0]) as u64)
    serial.hex_width(port_of(state), 3)
    serial.puts((&s_b[0]) as u64)
    serial.dec(rx(state))
    serial.puts((&s_c[0]) as u64)
    serial.dec(irqs(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(drops(state))
    serial.puts((&s_e[0]) as u64)
    serial.dec(overruns(state))
    serial.nl()
}
