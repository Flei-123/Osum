// SPDX-License-Identifier: GPL-2.0-only
// kernel/hw.fi -- round K2: the hardware stage of the kernel.
//
// This file is the seam between the kernel of rounds 59/62 and the three
// files this round added. It exists so that `kmain.fi` gains three lines
// and not thirty: several rounds are working on that file at the same
// time, and a seam is cheaper to merge than a diff spread over a
// thousand lines.
//
// It does three things, in the order the machine needs them:
//
//   1. `stage`  -- read the bus (pci.fi), then move the interrupts from
//      the two 8259s to the APIC (apic.fi). This happens BEFORE the first
//      `sti`, because a controller must not be changed while it is
//      delivering.
//   2. `disk`   -- bring up the NVMe controller (nvme.fi), put the SAME
//      file system on it that ran on the RAM disk and on ATA, and then
//      measure PIO against DMA.
//   3. `timer_off` -- what the counter-check of round 59 needs: whichever
//      timer is running has to be silenceable, and after this round that
//      is not necessarily the PIT any more.
//
// EVERY SWITCH HERE HAS A COUNTER-CHECK IN `tools/pci/run.sh`, and every
// one of them is a run in which the measurement collapses:
//
//   noapic    the PIC keeps the machine -- the ticks still have to arrive
//   noioapic  APIC on, keyboard line NOT entered -- no key may arrive
//   nobm      no bus master bit -- the controller may not fetch its own
//             commands, and the driver has to report that instead of hang
//   noirq     the message vector stays masked -- the transfer works, the
//             interrupt does not, and the difference is measurable
//   nomsix    the same completion over the interrupt pin and the I/O APIC

import serial
import kstate
import pci
import arch.x86_64.apic
import nvme
import ahci
import blk
import fs
import arch.x86_64.idt

export {
    parse, stage, disk, timer_off, mode_of,
    M_NOPCI, M_NOAPIC, M_NVME, M_BENCH, M_AHCI,
    M_NIC, M_NICINTX, M_NICNOIRQ, M_NICNOBM, M_NICTAB, M_NICSELF,
    net_ip, net_prefix, net_gw, net_svc, net_port, net_bytes, net_wait,
    net_fallback,
    on, yes, cmd_copy
}

// The words of the command line this round understands. They are read
// here and not in `kmain.mode_of` for the same reason the stage exists.
const M_NOPCI: u64 = 1
const M_NOAPIC: u64 = 2
const M_NOIOAPIC: u64 = 4
const M_NVME: u64 = 8
const M_NOBM: u64 = 16
const M_NOMSIX: u64 = 32
const M_NOIRQ: u64 = 64
const M_BENCH: u64 = 128
const M_NVPOLL: u64 = 256
// ROUND K8. The word that brings the network card up is `nic` and not
// `net`, and that is not taste: the counter-check runs the SAME command
// line without it, and every parameter of this round (`nip=`, `ngw=`,
// `nsvc=`) carries the three letters `net` inside it. A switch that its
// own arguments turn on again is no switch.
const M_NIC: u64 = 512 // bring the card up at all
const M_NICINTX: u64 = 1024 // the pin through the I/O APIC, not MSI-X
const M_NICNOIRQ: u64 = 2048 // the vector stays masked -- counter-check
const M_NICNOBM: u64 = 4096 // no bus master -- counter-check

// RUNDE AHCI. Ein eigenes Wort, damit dieser Abschnitt NUR laeuft, wenn
// er gemeint ist -- jede Messung aller vorherigen Runden bleibt damit
// Oktett fuer Oktett die, die sie war.
const M_AHCI: u64 = 8192

// RUNDE RTL. Zwei Woerter, die NICHTS am Betrieb aendern und nur Zahlen
// ausgeben -- deshalb duerfen sie in jedem anderen Lauf fehlen, ohne dass
// sich eine einzige Messung frueherer Runden verschiebt.
//   nictab   die Treibertabelle gegen eine eingebaute Nummernliste laufen
//            lassen und je Zeile sagen, welcher Treiber es waere. Das ist
//            der einzige Weg, die Wahl fuer einen I219 oder einen RTL8168
//            zu pruefen, ohne einen zu besitzen.
//   nicself  die Selbstpruefung der Treiber: voller Sendering, zu grosser
//            Rahmen. Beides Faelle, die ein Ping nie ausloest.
const M_NICTAB: u64 = 16384
const M_NICSELF: u64 = 32768

const S_MODE: u64 = 0x0F0 // in the K2 scalar page, between apic and nvme

// ROUND K8. Read out of the command line in `parse`, which happens
// BEFORE the frame allocator hands the command line itself out as heap
// (see the comment there). 0x200 is `virtio.fi`, 0x300 `inet.fi`; this
// is the strip between the seam and its socket table.
const S_NIP: u64 = 0x3A0
const S_NPREFIX: u64 = 0x3A8
const S_NGW: u64 = 0x3B0
const S_NSVC: u64 = 0x3B8
const S_NPORT: u64 = 0x3C0
const S_NBYTES: u64 = 0x3C8
const S_NWAIT: u64 = 0x3D0
// ROUND NETVIEW, second addendum: `nvfall=` -- the systemwide fallback
// this machine boots with. 0 off, 1 when-offline, 2 always; the words
// are in `netview.FB_*` and `docs/NETVIEW.md`. It is read HERE, beside
// the other network parameters, for the reason at `parse`: the command
// line stops existing the moment the heap is put on top of it, and a
// preference that has to survive that cannot be read later.
const S_NVFALL: u64 = 0x3D8

const TIMER_HZ: u64 = 100
const GSI_MOUSE: u64 = 12
const VEC_MOUSE: u64 = 46 // siehe trap.fi -- 44 gehoert dem NVMe-Regler
const GSI_KEYBOARD: u64 = 1
// RUNDE SERVERBUILD: COM1 haengt an IRQ 4, COM2 an IRQ 3. Beide werden
// eingetragen, wenn `console=` da ist -- ein Eintrag ohne Geraet
// dahinter kostet nichts, und ein Eintrag, der davon abhaengt, WELCHE
// der beiden Leitungen genommen wurde, waere eine zweite Art, wie ein
// Lauf sich vom anderen unterscheidet.
const GSI_COM1: u64 = 4
const GSI_COM2: u64 = 3
const VEC_KEYBOARD: u64 = 33
// RUNDE SERVERBUILD -- siehe trap.fi. Die Zahl steht an beiden Orten,
// wie VEC_KEYBOARD und VEC_MOUSE es seit Runde K10 tun, und
// tools/kernel/memmap.py rechnet nach, dass sie dieselbe ist.
const VEC_SERIAL: u64 = 36

const FS_BLOCKS: u64 = 2048 // the same 1 MiB the RAM disk and ATA use
const BENCH_BLOCKS: u64 = 256 // 128 KiB, read once per path
const BENCH_BATCH: u64 = 16 // blocks in ONE command, 8 KiB, two PRPs

fn mode(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_MODE)
}

fn on(state: u64, bit: u64) -> bool {
    return (mode(state) & bit) != 0
}

// ---------------------------------------------------------- stage zero

// Reads the command line and NOTHING else, and it has to happen before
// the frame allocator exists.
//
// This cost half an hour and belongs in a comment. QEMU puts the
// multiboot command line directly BEHIND the kernel image -- in this
// build at 0x184000, with `kernel_end` at 0x183038. `mem.scan` reserves
// the kernel up to `kernel_end` and everything above it is free memory
// as far as the frame allocator is concerned. The first thing the kernel
// asks for is 64 frames for the heap, and it gets 0x184000. From then on
// the command line reads as a heap block header. Round 62 never noticed
// because it read the command line at the top of `kernel_main`; this
// round wanted to read it again further down and found a string that had
// turned into a number.
fn parse(state: u64, cmd: u64) {
    kstate.set(state, pci.K2_SCALARS + S_MODE, mode_of(cmd))
    save_cmd(state, cmd)
    net_parse(state, cmd)
}

// ROUND TUNNEL: A COPY OF THE COMMAND LINE THAT SURVIVES THE HEAP.
//
// The note at `parse` above says the command line stops existing the
// moment the frame allocator hands out the memory it sits on. Round K8
// solved that by reading everything it needed HERE, into scalars. That
// works while the values are numbers.
//
// Round TUNNEL needs 64 character keys and several of them, which are
// not numbers and do not belong in a scalar each. So the command line
// itself is copied, once, at the only moment it is still readable, into
// the same page every other early value lives in. `cmd_copy` hands the
// copy out; `kernel/wg.fi` reads its own words out of it long after the
// original has become a heap block header.
//
// 0xE00..0x1200 of the K2 scalar page: round K2 reaches to 0xB00 and
// round TUNNEL's own scalars sit at 0xC00, so this is the next free
// strip and it ends well below the 0x2000 the page has.
const S_CMD: u64 = 0xE00
const CMD_MAX: u64 = 1023

fn save_cmd(state: u64, cmd: u64) {
    kstate.set8(pci.K2_SCALARS + S_CMD, 0 as u8)
    if cmd == 0 {
        return
    }
    var i: u64 = 0
    while i < CMD_MAX && kstate.get8(cmd + i) != 0 {
        kstate.set8(pci.K2_SCALARS + S_CMD + i, kstate.get8(cmd + i) as u8)
        i = i + 1
    }
    kstate.set8(pci.K2_SCALARS + S_CMD + i, 0 as u8)
}

fn cmd_copy(state: u64) -> u64 {
    if kstate.get8(pci.K2_SCALARS + S_CMD) == 0 {
        return 0
    }
    return pci.K2_SCALARS + S_CMD
}

// ---------------------------------------------- the K8 command line
//
// `nip=10.9.0.2/24 ngw=10.9.0.1 nsvc=1 nport=7 nbytes=1048576 nwait=900`
//
// All of it here and not in `netsvc.fi` for the reason at `parse`: the
// command line is a string that stops existing the moment the heap
// stands on it, and this function runs before that.
fn net_parse(state: u64, cmd: u64) {
    var w_ip: [u8; 5] = "nip=\0"
    var w_gw: [u8; 5] = "ngw=\0"
    var w_svc: [u8; 6] = "nsvc=\0"
    var w_port: [u8; 7] = "nport=\0"
    var w_bytes: [u8; 8] = "nbytes=\0"
    var w_wait: [u8; 7] = "nwait=\0"
    var w_fall: [u8; 8] = "nvfall=\0"
    kstate.set(state, pci.K2_SCALARS + S_NIP, 0)
    kstate.set(state, pci.K2_SCALARS + S_NPREFIX, 24)
    kstate.set(state, pci.K2_SCALARS + S_NGW, 0)
    kstate.set(state, pci.K2_SCALARS + S_NSVC, 0)
    kstate.set(state, pci.K2_SCALARS + S_NPORT, 7)
    kstate.set(state, pci.K2_SCALARS + S_NBYTES, 262144)
    kstate.set(state, pci.K2_SCALARS + S_NWAIT, 0)
    kstate.set(state, pci.K2_SCALARS + S_NVFALL, 0)
    if cmd == 0 {
        return
    }
    let a: u64 = find(cmd, (&w_ip[0]) as u64, 4)
    if a != 0 {
        var after: u64 = 0
        kstate.set(state, pci.K2_SCALARS + S_NIP, ip_of(a + 4, &after))
        if kstate.get8(after) == 47 { // '/'
            var e: u64 = 0
            let p: u64 = dec_of(after + 1, &e)
            if p > 0 && p <= 32 {
                kstate.set(state, pci.K2_SCALARS + S_NPREFIX, p)
            }
        }
    }
    let g: u64 = find(cmd, (&w_gw[0]) as u64, 4)
    if g != 0 {
        var after2: u64 = 0
        kstate.set(state, pci.K2_SCALARS + S_NGW, ip_of(g + 4, &after2))
    }
    num_arg(state, cmd, (&w_svc[0]) as u64, 5, S_NSVC)
    num_arg(state, cmd, (&w_port[0]) as u64, 6, S_NPORT)
    num_arg(state, cmd, (&w_bytes[0]) as u64, 7, S_NBYTES)
    num_arg(state, cmd, (&w_wait[0]) as u64, 6, S_NWAIT)
    num_arg(state, cmd, (&w_fall[0]) as u64, 7, S_NVFALL)
}

fn num_arg(state: u64, cmd: u64, word: u64, n: u64, slot: u64) {
    let a: u64 = find(cmd, word, n)
    if a == 0 {
        return
    }
    var e: u64 = 0
    kstate.set(state, pci.K2_SCALARS + slot, dec_of(a + n, &e))
}

// A decimal number, and where it ended.
fn dec_of(p: u64, endp: *mut u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < 20 {
        let c: u64 = kstate.get8(p + i)
        if c < 48 || c > 57 {
            i = 20
        } else {
            v = v * 10 + (c - 48)
            i = i + 1
        }
    }
    var k: u64 = 0
    while k < 20 {
        let c: u64 = kstate.get8(p + k)
        if c < 48 || c > 57 {
            *endp = p + k
            return v
        }
        k = k + 1
    }
    *endp = p + 20
    return v
}

// Four decimal numbers with three dots between them, packed the way the
// stack wants them: the first octet at the top.
fn ip_of(p: u64, endp: *mut u64) -> u64 {
    var v: u64 = 0
    var at: u64 = p
    var i: u64 = 0
    while i < 4 {
        var e: u64 = 0
        let part: u64 = dec_of(at, &e)
        v = (v << 8) | (part & 0xFF)
        at = e
        if i < 3 {
            if kstate.get8(at) != 46 { // '.'
                *endp = at
                return 0
            }
            at = at + 1
        }
        i = i + 1
    }
    *endp = at
    return v
}

fn net_ip(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NIP)
}

fn net_prefix(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NPREFIX)
}

fn net_gw(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NGW)
}

fn net_svc(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NSVC)
}

fn net_port(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NPORT)
}

fn net_bytes(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NBYTES)
}

fn net_wait(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + S_NWAIT)
}

// A value out of range reads as 0 -- `off`, which is what a machine
// that never heard of this addendum does.
fn net_fallback(state: u64) -> u64 {
    let v: u64 = kstate.get(state, pci.K2_SCALARS + S_NVFALL)
    if v > 2 {
        return 0
    }
    return v
}

// ---------------------------------------------------------- stage one

fn stage(state: u64) {
    var s_off: [u8; 13] = "pci: skipped\0"
    var s_none: [u8; 16] = "apic: not there\0"
    var s_old: [u8; 21] = "apic: off, pic keeps\0"
    var s_on: [u8; 8] = "apic: \0\0"
    var s_id: [u8; 6] = "id=\0\0\0"
    var s_hz: [u8; 8] = "  hz=\0\0\0"
    var s_ent: [u8; 12] = "  ioapic=\0\0\0"
    var s_tick: [u8; 11] = "  tick=\0\0\0\0"
    var s_win: [u8; 10] = "  window=\0"
    var s_kbd: [u8; 24] = "apic: keyboard gsi 1 ->\0"
    var s_nokbd: [u8; 26] = "apic: keyboard NOT routed\0"

    if on(state, M_NOPCI) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
    } else {
        pci.scan(state)
        pci.list(state)
    }

    if on(state, M_NOAPIC) {
        serial.puts((&s_old[0]) as u64)
        serial.nl()
        return
    }
    if !apic.present() {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    if !apic.init(state, TIMER_HZ) {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    // Only now, with the new controller answering, is the old one shut
    // up. The other order leaves a window with no controller at all.
    apic.pic_off()
    serial.puts((&s_on[0]) as u64)
    serial.puts((&s_id[0]) as u64)
    serial.dec(apic.id(state))
    serial.puts((&s_hz[0]) as u64)
    serial.dec(apic.hz(state))
    serial.puts((&s_ent[0]) as u64)
    serial.dec(apic.ioapic_entries(state))
    serial.puts((&s_tick[0]) as u64)
    serial.dec(TIMER_HZ)
    serial.puts((&s_win[0]) as u64)
    serial.dec(apic.window_slots(state))
    serial.nl()

    // The keyboard is the one device line this kernel still has, and it
    // is therefore the proof that the I/O APIC delivers at all. With
    // `noioapic` the entry is deliberately left out: the PIC is mute, the
    // line goes nowhere, and no key may arrive.
    var s_ser: [u8; 21] = "hw: serial gsi 4 ->\0\0"
    if on(state, M_NOIOAPIC) {
        serial.puts((&s_nokbd[0]) as u64)
        serial.nl()
    } else {
        apic.route(state, GSI_KEYBOARD, VEC_KEYBOARD, apic.id(state), false, false)
        serial.puts((&s_kbd[0]) as u64)
        serial.dec(VEC_KEYBOARD)
        serial.nl()
        // ROUNDE K10: der zweite Anschluss desselben Bausteins. Die
        // Leitung wird IMMER eingetragen, auch ohne das Wort `wm` --
        // ein I/O-APIC-Eintrag ohne Geraet dahinter kostet nichts, und
        // ein Eintrag, der von einer Kommandozeile abhaengt, ist eine
        // zweite Art, wie ein Lauf sich vom anderen unterscheidet.
        apic.route(state, GSI_MOUSE, VEC_MOUSE, apic.id(state), false, false)
        // RUNDE SERVERBUILD: die serielle Konsole. Nur mit `console=`,
        // und nicht mit `noserirq` -- das ist die Gegenprobe, die
        // zeigen muss, dass die Oktette WIRKLICH ueber diesen Eintrag
        // kommen und nicht ueber den Abfrageweg daneben.
        if kstate.mode_on(state, kstate.M_SERCON) {
            if !kstate.mode_on(state, kstate.M_NOSERIRQ) {
                apic.route(state, GSI_COM1, VEC_SERIAL, apic.id(state),
                    false, false)
                apic.route(state, GSI_COM2, VEC_SERIAL, apic.id(state),
                    false, false)
                serial.puts((&s_ser[0]) as u64)
                serial.dec(VEC_SERIAL)
                serial.nl()
            }
        }
    }
}

// Whichever clock is running has to be silenceable. Round 59 masked
// IRQ0 at the PIC for that; after this round the timer may be inside the
// processor, where the PIC cannot reach it.
fn timer_off(state: u64) {
    if apic.active(state) {
        apic.timer_stop(state)
        return
    }
    idt.pic_mask(0xFD as u8, 0xFF as u8)
}

// ---------------------------------------------------------- stage two

fn disk(state: u64) {
    // RUNDE AHCI: EIN EIGENER ZWEIG, und er kehrt nicht zurueck. Der
    // NVMe-Abschnitt darunter formatiert seine eigene Platte; beides in
    // einem Lauf waere eine Messung, in der nicht mehr zu sagen ist,
    // welcher Treiber welchen Block geschrieben hat.
    if on(state, M_AHCI) {
        sata(state)
        return
    }
    var s_off: [u8; 14] = "nvme: skipped\0"
    var s_no: [u8; 16] = "nvme: no device\0"
    var s_fail: [u8; 20] = "nvme: init failed\0\0\0"
    var s_up: [u8; 8] = "nvme: \0\0"
    var s_blk: [u8; 8] = "blocks=\0"
    var s_sz: [u8; 10] = "  lbasz=\0\0"
    var s_irq: [u8; 8] = "  irq=\0\0"
    var s_msix: [u8; 6] = "msix\0\0"
    var s_intx: [u8; 6] = "intx\0\0"
    var s_masked: [u8; 9] = " masked\0\0"
    var s_bm: [u8; 12] = "  master=\0\0\0"

    if !on(state, M_NVME) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    if !nvme.present(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    if on(state, M_NVPOLL) {
        nvme.arm_polling(state)
    }
    let use_msix: bool = !on(state, M_NOMSIX)
    let armed: bool = !on(state, M_NOIRQ)
    let ok: bool = nvme.init(state, use_msix, armed)
    // The bus master bit is taken away AFTER the controller was set up,
    // when the counter-check asks for it: `init` itself needs to fetch
    // one command out of memory to learn how big the disk is, and a run
    // that cannot even do that would prove nothing about DMA.
    if on(state, M_NOBM) {
        pci.disable_master(nvme.bdf(state))
    }
    if !ok {
        serial.puts((&s_fail[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_up[0]) as u64)
    serial.puts((&s_blk[0]) as u64)
    serial.dec(nvme.blocks(state))
    serial.puts((&s_sz[0]) as u64)
    serial.dec(1 << nvme.block_shift(state))
    serial.puts((&s_irq[0]) as u64)
    if use_msix {
        serial.puts((&s_msix[0]) as u64)
    } else {
        serial.puts((&s_intx[0]) as u64)
    }
    if !armed {
        serial.puts((&s_masked[0]) as u64)
    }
    serial.puts((&s_bm[0]) as u64)
    serial.dec(yes(pci.master_on(nvme.bdf(state))))
    serial.nl()

    if on(state, M_NOIRQ) {
        // The counter-check that separates the two halves of a DMA
        // driver. The message vector is masked, so the completion
        // interrupt cannot arrive -- but the controller still fetches the
        // command and still moves the data. The first read therefore has
        // to FAIL (it waits three seconds and gives up), the completion
        // has to be lying in the queue afterwards all the same, and the
        // same read has to succeed the moment the driver stops waiting to
        // be told and looks for itself.
        var n1: [u8; 20] = "nvme: noirq  onirq=\0"
        var n2: [u8; 10] = "  found=\0\0"
        var n3: [u8; 11] = "  polled=\0\0"
        var n4: [u8; 8] = "  irqs=\0"
        let buf: u64 = nvme.buffer(state, 0)
        serial.puts((&n1[0]) as u64)
        serial.dec(yes(nvme.read_block(state, 0, buf)))
        serial.puts((&n2[0]) as u64)
        serial.dec(nvme.drain(state))
        nvme.arm_polling(state)
        serial.puts((&n3[0]) as u64)
        serial.dec(yes(nvme.read_block(state, 0, buf)))
        serial.puts((&n4[0]) as u64)
        serial.dec(nvme.irqs(state))
        serial.nl()
        return
    }

    filesystem(state)
    if on(state, M_BENCH) {
        bench(state)
    }
}

// ==================================================================
// RUNDE AHCI: DIE PLATTE, DIE EIN ECHTER PC HAT
// ==================================================================
//
// Vier Messungen, und keine davon glaubt dem Treiber etwas:
//
//   1. WAS DER BUS SAGT. Der Controller wird ueber seine PCI-Klasse
//      gefunden (01:06:01), nicht ueber eine Tabelle. Steht die
//      Firmware auf IDE, meldet dieselbe Stelle `mode=ide` statt
//      stumm nichts zu finden.
//   2. EIN SEKTOR HIN UND ZURUECK. Ein Muster nach LBA 4096
//      geschrieben, gelesen, verglichen. Ein Treiber, der beides
//      nicht tut, sondern nur den Puffer stehen laesst, faellt hier
//      NICHT auf -- deshalb wird der Lesepuffer vorher mit einem
//      ANDEREN Muster gefuellt und zusaetzlich dagegen geprueft.
//   3. ACHT SEKTOREN IN EINEM BEFEHL. Das ist die PRDT-Zeile mit der
//      Laenge minus eins; ein Treiber, der sie falsch hat, liest
//      genau einen Sektor zu wenig, und nur diese Messung sieht das.
//   4. DAS DATEISYSTEM DARAUF. `fs.fi` bekommt kein Argument mehr und
//      keine Zeile geaendert -- zum vierten Mal dieselbe Zusage wie
//      bei DEV_NVME, DEV_ATA1 und DEV_USB. Und der WIRT liest das
//      Abbild danach nach (`tools/ahci/run.sh`), also ist auch das
//      nicht das Wort des Kernels.
const AHCI_LBA1: u64 = 4096 // der einzelne Sektor
const AHCI_LBAN: u64 = 5000 // die acht am Stueck
const AHCI_MANY: u64 = 8

fn sata(state: u64) {
    var s_no: [u8; 16] = "ahci: no device\0"
    var s_ide: [u8; 33] = "ahci: mode=ide  set BIOS to AHCI\0"
    var s_fail: [u8; 19] = "ahci: init failed \0"
    var s_tfd: [u8; 7] = " tfd=\0\0"
    var s_why: [u8; 8] = "  why=\0\0"
    var s_up: [u8; 7] = "ahci: \0"
    var s_blk: [u8; 8] = "blocks=\0"
    var s_sz: [u8; 10] = "  lbasz=\0\0"
    var s_prt: [u8; 8] = "  port=\0"
    var s_seen: [u8; 9] = "  ports=\0"
    var s_slot: [u8; 9] = "  slots=\0"
    var s_bm: [u8; 10] = "  master=\0"
    var s_one: [u8; 14] = "ahci: one wr=\0"
    var s_rd: [u8; 7] = "  rd=\0\0"
    var s_same: [u8; 8] = "  same=\0"
    var s_pre: [u8; 8] = "  pre=\0\0"
    var s_many: [u8; 15] = "ahci: many wr=\0"
    var s_n: [u8; 5] = "  n=\0"
    var s_err: [u8; 9] = "  errs=\0\0"
    var s_cmd: [u8; 9] = "  cmds=\0\0"
    var s_dead: [u8; 9] = "  dead=\0\0"
    var s_live: [u8; 10] = "  alive=\0\0"

    if !ahci.present(state) {
        if ahci.ide_mode(state) {
            serial.puts((&s_ide[0]) as u64)
        } else {
            serial.puts((&s_no[0]) as u64)
        }
        serial.nl()
        return
    }
    if !ahci.init(state) {
        serial.puts((&s_fail[0]) as u64)
        serial.puts((&s_tfd[0]) as u64)
        serial.hex(ahci.last_tfd(state))
        serial.puts((&s_why[0]) as u64)
        serial.dec(ahci.why(state))
        serial.nl()
        return
    }

    // Das Busmaster-Bit wird NACH der Inbetriebnahme weggenommen, wenn
    // die Gegenprobe danach fragt: `init` muss selbst einen Befehl
    // (IDENTIFY) aus dem Speicher holen lassen, um die Groesse zu
    // erfahren, und ein Lauf, der das schon nicht kann, sagt nichts
    // ueber DMA aus. Genau dieselbe Ueberlegung wie in `disk`.
    if on(state, M_NOBM) {
        pci.disable_master(ahci.bdf(state))
    }

    serial.puts((&s_up[0]) as u64)
    serial.puts((&s_blk[0]) as u64)
    serial.dec(ahci.blocks(state))
    serial.puts((&s_sz[0]) as u64)
    serial.dec(1 << ahci.block_shift(state))
    serial.puts((&s_prt[0]) as u64)
    serial.dec(ahci.port(state))
    serial.puts((&s_seen[0]) as u64)
    serial.dec(ahci.ports_seen(state))
    serial.puts((&s_slot[0]) as u64)
    serial.dec(ahci.slots(state))
    serial.puts((&s_bm[0]) as u64)
    serial.dec(yes(pci.master_on(ahci.bdf(state))))
    serial.nl()

    // ---- 2. ein Sektor hin und zurueck
    let wbuf: u64 = ahci.buffer(state, 1)
    let rbuf: u64 = ahci.buffer(state, 0)
    fill(wbuf, 512, 0x5A)
    fill(rbuf, 512, 0xA5)
    let w1: u64 = yes(ahci.write_block(state, AHCI_LBA1, wbuf))
    // `pre` ist die Gegenprobe zum Vergleich darunter: der Lesepuffer
    // steht VOR dem Lesen auf einem anderen Muster. Waere er hinterher
    // immer noch darauf, haette der Controller nichts hineingelegt --
    // und `same` waere trotzdem gruen, wenn beide Puffer nie angefasst
    // wuerden. Erst die beiden Zahlen zusammen sagen etwas.
    let pre: u64 = same(rbuf, wbuf, 512)
    let r1: u64 = yes(ahci.read_block(state, AHCI_LBA1, rbuf))
    serial.puts((&s_one[0]) as u64)
    serial.dec(w1)
    serial.puts((&s_rd[0]) as u64)
    serial.dec(r1)
    serial.puts((&s_pre[0]) as u64)
    serial.dec(pre)
    serial.puts((&s_same[0]) as u64)
    serial.dec(same(rbuf, wbuf, 512))
    serial.nl()

    // ---- 3. acht Sektoren in EINEM Befehl
    let n: u64 = AHCI_MANY * 512
    stripe(wbuf, n)
    fill(rbuf, n, 0)
    let wn: u64 = yes(ahci.write_many(state, AHCI_LBAN, AHCI_MANY, wbuf))
    let rn: u64 = yes(ahci.read_many(state, AHCI_LBAN, AHCI_MANY, rbuf))
    serial.puts((&s_many[0]) as u64)
    serial.dec(wn)
    serial.puts((&s_rd[0]) as u64)
    serial.dec(rn)
    serial.puts((&s_n[0]) as u64)
    serial.dec(n)
    serial.puts((&s_same[0]) as u64)
    serial.dec(same(rbuf, wbuf, n))
    serial.nl()

    // ---- 4. das Dateisystem, ohne eine Zeile in `fs.fi`
    sata_fs(state)

    serial.puts((&s_up[0]) as u64)
    serial.puts((&s_cmd[0]) as u64)
    serial.dec(ahci.cmds(state))
    serial.puts((&s_err[0]) as u64)
    serial.dec(ahci.errs(state))
    serial.puts((&s_dead[0]) as u64)
    serial.dec(ahci.dead(state))
    serial.puts((&s_live[0]) as u64)
    serial.dec(yes(ahci.alive(state)))
    serial.nl()
}

fn sata_fs(state: u64) {
    var s_fmt: [u8; 14] = "ahci: format \0"
    var s_mount: [u8; 10] = "  mount=\0\0"
    var s_io: [u8; 14] = "ahci: wrote=\0\0"
    var s_read: [u8; 8] = "  read=\0"
    var s_same: [u8; 8] = "  same=\0"
    var s_list: [u8; 12] = "ahci: list \0"
    var p_file: [u8; 10] = "/sata.txt\0"
    var p_root: [u8; 2] = "/\0"
    var text: [u8; 31] = "ahci wrote this line over DMA\n\0"

    blk.use_ahci(state, FS_BLOCKS)
    serial.puts((&s_fmt[0]) as u64)
    serial.dec(yes(fs.format(state)))
    serial.puts((&s_mount[0]) as u64)
    serial.dec(yes(fs.mount(state)))
    serial.nl()
    let ino: u64 = fs.create_path(state, (&p_file[0]) as u64, fs.T_FILE)
    let wrote: u64 = fs.write_at(state, ino, 0, (&text[0]) as u64, 30)
    let scratch: u64 = state + kstate.BLOCK_OFF
    let got: u64 = fs.read_at(state, ino, 0, scratch, 64)
    serial.puts((&s_io[0]) as u64)
    serial.dec(wrote)
    serial.puts((&s_read[0]) as u64)
    serial.dec(got)
    serial.puts((&s_same[0]) as u64)
    serial.dec(same(scratch, (&text[0]) as u64, 30))
    serial.nl()
    list_dir(state, (&p_root[0]) as u64, (&s_list[0]) as u64)
}

fn fill(p: u64, n: u64, v: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, (v & 0xFF) as u8)
        i = i + 1
    }
}

// Ein Muster, das je Sektor ANDERS ist. Mit einem einheitlichen Muster
// waere ein Treiber gruen, der achtmal denselben Sektor liest -- und
// genau das ist der Fehler, den ein falscher PRDT-Eintrag macht.
fn stripe(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        kstate.set8(p + i, (((i / 512) * 17 + i) & 0xFF) as u8)
        i = i + 1
    }
}

// The whole point of `blk.fi`: the file system does not learn that the
// blocks now come out of a controller that fetches its own commands. Not
// one line of `fs.fi` changed for this round.
fn filesystem(state: u64) {
    var s_fmt: [u8; 14] = "nvme: format \0"
    var s_mount: [u8; 10] = "  mount=\0\0"
    var s_io: [u8; 14] = "nvme: wrote=\0\0"
    var s_read: [u8; 8] = "  read=\0"
    var s_same: [u8; 8] = "  same=\0"
    var s_list: [u8; 12] = "nvme: list \0"
    var s_irqs: [u8; 8] = "  irqs=\0"
    var s_wait: [u8; 9] = "  waits=\0"
    var p_file: [u8; 10] = "/nvme.txt\0"
    var p_root: [u8; 2] = "/\0"
    var text: [u8; 31] = "nvme wrote this line over DMA\n\0"

    blk.use_nvme(state, FS_BLOCKS)
    let before: u64 = nvme.irqs(state)
    serial.puts((&s_fmt[0]) as u64)
    serial.dec(yes(fs.format(state)))
    serial.puts((&s_mount[0]) as u64)
    serial.dec(yes(fs.mount(state)))
    serial.nl()
    let ino: u64 = fs.create_path(state, (&p_file[0]) as u64, fs.T_FILE)
    let wrote: u64 = fs.write_at(state, ino, 0, (&text[0]) as u64, 30)
    let scratch: u64 = state + kstate.BLOCK_OFF
    let got: u64 = fs.read_at(state, ino, 0, scratch, 64)
    serial.puts((&s_io[0]) as u64)
    serial.dec(wrote)
    serial.puts((&s_read[0]) as u64)
    serial.dec(got)
    serial.puts((&s_same[0]) as u64)
    serial.dec(same(scratch, (&text[0]) as u64, 30))
    // How many completion interrupts the file system cost. Zero would
    // mean the driver polled after all.
    serial.puts((&s_irqs[0]) as u64)
    serial.dec(nvme.irqs(state) - before)
    serial.puts((&s_wait[0]) as u64)
    serial.dec(nvme.waits(state))
    serial.nl()
    list_dir(state, (&p_root[0]) as u64, (&s_list[0]) as u64)
}

// --------------------------------------------------------- the number

// The measurement that justifies this round. The SAME amount of data over
// the SAME interface -- `blk.read`, block by block, 512 octets -- once
// through the processor and once past it. Then once more with sixteen
// blocks in one command, which is what the per-block interface costs.
fn bench(state: u64) {
    var s_ata: [u8; 12] = "bench: ata \0"
    var s_nv: [u8; 13] = "bench: nvme \0"
    var s_many: [u8; 15] = "bench: nvme16 \0"
    var s_blocks: [u8; 8] = "blocks=\0"
    var s_cyc: [u8; 10] = "  cycles=\0"
    var s_us: [u8; 6] = "  us=\0"
    var s_kb: [u8; 11] = "  KiB_s=\0\0\0"
    var s_in: [u8; 12] = "  inwords=\0\0"
    var s_halt: [u8; 10] = "  halts=\0\0"
    var s_ok: [u8; 7] = "  ok=\0\0"
    var s_none: [u8; 26] = "bench: no ata drive, skip\0"
    var s_cmp: [u8; 15] = "bench: faster=\0"
    var s_pm: [u8; 8] = " permil\0"
    var s_hz: [u8; 12] = "bench: tsc=\0"

    let buf: u64 = nvme.buffer(state, 0)
    serial.puts((&s_hz[0]) as u64)
    serial.dec(apic.tsc_hz(state))
    serial.nl()

    if !blk.present(state) {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    // ---- ATA PIO, through the processor.
    blk.use_ata(state, BENCH_BLOCKS)
    let a0: u64 = apic.tsc()
    let aok: u64 = read_run(state, BENCH_BLOCKS, buf)
    let a1: u64 = apic.tsc()
    line(state, (&s_ata[0]) as u64, (&s_blocks[0]) as u64, (&s_cyc[0]) as u64,
        (&s_us[0]) as u64, (&s_kb[0]) as u64, (&s_in[0]) as u64,
        (&s_halt[0]) as u64, (&s_ok[0]) as u64,
        BENCH_BLOCKS, a1 - a0, BENCH_BLOCKS * 256, 0, aok)

    // ---- NVMe, one block per command, the same interface.
    blk.use_nvme(state, BENCH_BLOCKS)
    let h0: u64 = nvme.waits(state)
    let n0: u64 = apic.tsc()
    let nok: u64 = read_run(state, BENCH_BLOCKS, buf)
    let n1: u64 = apic.tsc()
    line(state, (&s_nv[0]) as u64, (&s_blocks[0]) as u64, (&s_cyc[0]) as u64,
        (&s_us[0]) as u64, (&s_kb[0]) as u64, (&s_in[0]) as u64,
        (&s_halt[0]) as u64, (&s_ok[0]) as u64,
        BENCH_BLOCKS, n1 - n0, 0, nvme.waits(state) - h0, nok)

    // ---- NVMe, sixteen blocks per command.
    let m0: u64 = apic.tsc()
    var done: u64 = 0
    var lba: u64 = 0
    while lba < BENCH_BLOCKS {
        if nvme.read_many(state, lba, BENCH_BATCH, buf) {
            done = done + BENCH_BATCH
        }
        lba = lba + BENCH_BATCH
    }
    let m1: u64 = apic.tsc()
    line(state, (&s_many[0]) as u64, (&s_blocks[0]) as u64, (&s_cyc[0]) as u64,
        (&s_us[0]) as u64, (&s_kb[0]) as u64, (&s_in[0]) as u64,
        (&s_halt[0]) as u64, (&s_ok[0]) as u64,
        BENCH_BLOCKS, m1 - m0, 0, 0, done)

    // How much faster, in thousandths, so that a factor below two is
    // still a number and not a rounded-down 1.
    serial.puts((&s_cmp[0]) as u64)
    var factor: u64 = 0
    if (n1 - n0) > 0 {
        factor = (a1 - a0) * 1000 / (n1 - n0)
    }
    serial.dec(factor)
    serial.puts((&s_pm[0]) as u64)
    serial.nl()
}

fn read_run(state: u64, n: u64, buf: u64) -> u64 {
    var i: u64 = 0
    var ok: u64 = 0
    while i < n {
        if blk.read(state, i, buf) {
            ok = ok + 1
        }
        i = i + 1
    }
    return ok
}

// One line of the measurement. Eight labels as arguments because the
// kernel profile has no string type and a local array per label in three
// places would be three places to keep in step.
fn line(state: u64, head: u64, l_blocks: u64, l_cyc: u64, l_us: u64,
    l_kb: u64, l_in: u64, l_halt: u64, l_ok: u64,
    blocks_n: u64, cycles: u64, inwords: u64, halts: u64, ok: u64) {
    let hz: u64 = apic.tsc_hz(state)
    serial.puts(head)
    serial.puts(l_blocks)
    serial.dec(blocks_n)
    serial.puts(l_cyc)
    serial.dec(cycles)
    var us: u64 = 0
    var kib: u64 = 0
    if hz > 0 && cycles > 0 {
        us = cycles * 1000000 / hz
        kib = blocks_n * 512 * hz / cycles / 1024
    }
    serial.puts(l_us)
    serial.dec(us)
    serial.puts(l_kb)
    serial.dec(kib)
    serial.puts(l_in)
    serial.dec(inwords)
    serial.puts(l_halt)
    serial.dec(halts)
    serial.puts(l_ok)
    serial.dec(ok)
    serial.nl()
}

// --------------------------------------------------------- the helpers

fn yes(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

fn same(a: u64, b: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < n {
        if kstate.get8(a + i) != kstate.get8(b + i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn list_dir(state: u64, p: u64, label: u64) {
    var s_sp: [u8; 2] = " \0"
    var s_colon: [u8; 2] = ":\0"
    let dir: u64 = fs.path(state, p)
    serial.puts(label)
    if dir == 0 {
        serial.nl()
        return
    }
    let out: u64 = state + kstate.NAME_OFF + 1024
    var i: u64 = 0
    var going: bool = true
    while going {
        let ino: u64 = fs.entry_at(state, dir, i, out)
        if ino == 0 {
            going = false
        } else {
            serial.puts(out + 8)
            serial.puts((&s_colon[0]) as u64)
            serial.dec(fs.inode_type(state, ino))
            serial.puts((&s_sp[0]) as u64)
            i = i + 1
        }
    }
    serial.nl()
}

// ------------------------------------------------------ the command line

// The same shape as `kmain.mode_of`, for the words this round adds. A
// word that is not there leaves its bit at zero, so a kernel started
// without any of them behaves exactly as round 62 left it -- except that
// the interrupts now come from the APIC, which is the point.
fn mode_of(cmd: u64) -> u64 {
    var w_nopci: [u8; 6] = "nopci\0"
    var w_noapic: [u8; 7] = "noapic\0"
    var w_noio: [u8; 9] = "noioapic\0"
    var w_nvme: [u8; 5] = "nvme\0"
    var w_nobm: [u8; 5] = "nobm\0"
    var w_nomsix: [u8; 7] = "nomsix\0"
    var w_noirq: [u8; 6] = "noirq\0"
    var w_bench: [u8; 6] = "bench\0"
    var w_poll: [u8; 7] = "nvpoll\0"
    var w_nic: [u8; 4] = "nic\0"
    var w_nintx: [u8; 8] = "nicintx\0"
    var w_nnoirq: [u8; 9] = "nicnoirq\0"
    var w_nnobm: [u8; 8] = "nicnobm\0"
    var w_ahci: [u8; 5] = "ahci\0"
    var w_ntab: [u8; 7] = "nictab\0"
    var w_nself: [u8; 8] = "nicself\0"
    if cmd == 0 {
        return 0
    }
    var m: u64 = 0
    if find(cmd, (&w_nopci[0]) as u64, 5) != 0 {
        m = m | M_NOPCI
    }
    if find(cmd, (&w_noapic[0]) as u64, 6) != 0 {
        m = m | M_NOAPIC
    }
    if find(cmd, (&w_noio[0]) as u64, 8) != 0 {
        m = m | M_NOIOAPIC
    }
    if find(cmd, (&w_nvme[0]) as u64, 4) != 0 {
        m = m | M_NVME
    }
    if find(cmd, (&w_nobm[0]) as u64, 4) != 0 {
        m = m | M_NOBM
    }
    if find(cmd, (&w_nomsix[0]) as u64, 6) != 0 {
        m = m | M_NOMSIX
    }
    if find(cmd, (&w_noirq[0]) as u64, 5) != 0 {
        m = m | M_NOIRQ
    }
    if find(cmd, (&w_bench[0]) as u64, 5) != 0 {
        m = m | M_BENCH
    }
    if find(cmd, (&w_poll[0]) as u64, 6) != 0 {
        m = m | M_NVPOLL
    }
    if find(cmd, (&w_nic[0]) as u64, 3) != 0 {
        m = m | M_NIC
    }
    if find(cmd, (&w_nintx[0]) as u64, 7) != 0 {
        m = m | M_NICINTX
    }
    if find(cmd, (&w_nnoirq[0]) as u64, 8) != 0 {
        m = m | M_NICNOIRQ
    }
    if find(cmd, (&w_nnobm[0]) as u64, 7) != 0 {
        m = m | M_NICNOBM
    }
    if find(cmd, (&w_ahci[0]) as u64, 4) != 0 {
        m = m | M_AHCI
    }
    if find(cmd, (&w_ntab[0]) as u64, 6) != 0 {
        m = m | M_NICTAB
    }
    if find(cmd, (&w_nself[0]) as u64, 7) != 0 {
        m = m | M_NICSELF
    }
    return m
}

fn find(hay: u64, needle: u64, n: u64) -> u64 {
    var i: u64 = 0
    while kstate.get8(hay + i) != 0 {
        var k: u64 = 0
        var hit: bool = true
        while k < n {
            if kstate.get8(hay + i + k) != kstate.get8(needle + k) {
                hit = false
                k = n
            } else {
                k = k + 1
            }
        }
        if hit {
            return hay + i
        }
        i = i + 1
    }
    return 0
}
