profile kernel

import diag.crash
import init.bootfs
import init.bootshell
import init.testasync
import init.initstage


fn register() {
    initstage.add(initstage.S_FS, bootfs.filesystem as u64)
    initstage.add(initstage.S_FS, crash.init as u64)
    initstage.add(initstage.S_FS, testasync.asyncs_fs as u64)
    initstage.add(initstage.S_FS, bootshell.shell as u64)
    initstage.add(initstage.S_FS, bootfs.ata_disk as u64)
}
