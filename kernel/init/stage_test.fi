profile kernel

import diag.cmdcopy
import diag.hwdiag
import init.bootmem
import init.testasync
import init.testbus
import init.testproc
import init.testsched
import init.testvec
import init.initstage

fn park_if_asked(state: u64) {
    hwdiag.park_if_asked(state, cmdcopy.cmd_copy(state))
}

fn register() {
    initstage.add(initstage.S_TEST, testsched.provoke as u64)
    initstage.add(initstage.S_TEST, testsched.ticks as u64)
    initstage.add(initstage.S_TEST, testsched.clock as u64)
    initstage.add(initstage.S_TEST, testsched.scheduler as u64)
    initstage.add(initstage.S_TEST, testsched.keyboard as u64)
    initstage.add(initstage.S_TEST, testproc.processes as u64)
    initstage.add(initstage.S_TEST, testproc.capabilities as u64)
    initstage.add(initstage.S_TEST, testproc.handles as u64)
    initstage.add(initstage.S_TEST, testproc.handle_bench as u64)
    initstage.add(initstage.S_TEST, testproc.fuzzer as u64)
    initstage.add(initstage.S_TEST, testasync.asyncs as u64)
    initstage.add(initstage.S_TEST, testasync.async_bench as u64)
    initstage.add(initstage.S_TEST, testvec.vectors as u64)
    initstage.add(initstage.S_TEST, bootmem.speicherdruck as u64)
    initstage.add(initstage.S_TEST, park_if_asked as u64)
    initstage.add(initstage.S_TEST, testproc.users as u64)
    initstage.add(initstage.S_TEST, testbus.busround as u64)
    initstage.add(initstage.S_TEST, testbus.clipdemo as u64)
}
