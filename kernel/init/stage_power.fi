profile kernel

import lib.kstate
import pwr.s3
import bus.ecamdiag
import acpi.acpibl
import pwr.blchain
import drv.wdt.wdt
import drv.hid.hksim
import acpi.aml
import acpi.acpiev
import sched.susp
import diag.hang
import diag.nmiguard
import net.kodb
import init.testpower
import init.initstage

fn event_selftests(state: u64) {
    if kstate.mode_on(state, kstate.M_EVSELF) {
        acpiev.selftest(state)
        acpibl.selftest(state)
        blchain.selftest(state)
        hksim.selftest(state)
    }
    if kstate.mode_on(state, kstate.M_EVWAIT) {
        acpiev.wait_loop(state, 9000)
    }
}

fn register() {
    initstage.add(initstage.S_POWER, testpower.power_stage as u64)
    initstage.add(initstage.S_POWER, aml.stage as u64)
    initstage.add(initstage.S_POWER, acpiev.stage as u64)
    initstage.add(initstage.S_POWER, ecamdiag.aml_probe as u64)
    initstage.add(initstage.S_POWER, susp.stage as u64)
    initstage.add(initstage.S_POWER, s3.stage as u64)
    initstage.add(initstage.S_POWER, acpibl.stage as u64)
    initstage.add(initstage.S_POWER, blchain.stage as u64)
    initstage.add(initstage.S_POWER, wdt.stage as u64)
    initstage.add(initstage.S_POWER, nmiguard.init as u64)
    initstage.add(initstage.S_POWER, kodb.init as u64)
    initstage.add(initstage.S_POWER, hang.init as u64)
    initstage.add(initstage.S_POWER, event_selftests as u64)
    initstage.add(initstage.S_POWER, testpower.power_test as u64)
}
