profile kernel

import serial
import sched.time

const S_EARLY: u64 = 0
const S_CORE: u64 = 1
const S_BUS: u64 = 2
const S_TASK: u64 = 3
const S_TEST: u64 = 4
const S_POWER: u64 = 5
const S_FS: u64 = 6
const S_DEVICE: u64 = 7
const S_ROOT: u64 = 8
const S_SMP: u64 = 9
const S_LATE: u64 = 10
const S_COUNT: u64 = 11
const PER_STAGE: u64 = 64

const C_MBI: u64 = 0
const C_VECTORS: u64 = 1
const C_KERNEL_END: u64 = 2
const C_GDT: u64 = 3
const C_TSS: u64 = 4
const C_CMD: u64 = 5

static mut steps: [u64; 704] = [0 as u64; 704]
static mut counts: [u64; 11] = [0 as u64; 11]
static mut ctx: [u64; 8] = [0 as u64; 8]
static mut step_cycles: [u64; 704] = [0 as u64; 704]

fn add(stage: u64, step: u64) {
    if stage >= S_COUNT || step == 0 {
        return
    }
    let n: u64 = counts[stage as usize]
    if n >= PER_STAGE {
        var s_full: [u8; 18] = "init: stage full\0\0"
        serial.puts((&s_full[0]) as u64)
        serial.nl()
        return
    }
    steps[(stage * PER_STAGE + n) as usize] = step
    counts[stage as usize] = n + 1
}

fn count(stage: u64) -> u64 {
    if stage >= S_COUNT {
        return 0
    }
    return counts[stage as usize]
}

fn run(state: u64, stage: u64) {
    if stage >= S_COUNT {
        return
    }
    var i: u64 = 0
    while i < counts[stage as usize] {
        let call: fn(u64) = steps[(stage * PER_STAGE + i) as usize] as fn(u64)
        let began: u64 = time.tsc()
        call(state)
        step_cycles[(stage * PER_STAGE + i) as usize] = time.tsc() - began
        i = i + 1
    }
}

fn run_all(state: u64) {
    var stage: u64 = 0
    while stage < S_COUNT {
        run(state, stage)
        stage = stage + 1
    }
}

fn set_boot(mbi: u64, vectors: u64, kernel_end: u64, gdt: u64, tss: u64) {
    ctx[C_MBI as usize] = mbi
    ctx[C_VECTORS as usize] = vectors
    ctx[C_KERNEL_END as usize] = kernel_end
    ctx[C_GDT as usize] = gdt
    ctx[C_TSS as usize] = tss
}

fn set_cmd(cmd: u64) {
    ctx[C_CMD as usize] = cmd
}

fn mbi() -> u64 {
    return ctx[C_MBI as usize]
}

fn vectors() -> u64 {
    return ctx[C_VECTORS as usize]
}

fn kernel_end() -> u64 {
    return ctx[C_KERNEL_END as usize]
}

fn gdt() -> u64 {
    return ctx[C_GDT as usize]
}

fn tss() -> u64 {
    return ctx[C_TSS as usize]
}

fn cmd() -> u64 {
    return ctx[C_CMD as usize]
}

fn step_cycles_of(stage: u64, index: u64) -> u64 {
    if stage >= S_COUNT || index >= PER_STAGE {
        return 0
    }
    return step_cycles[(stage * PER_STAGE + index) as usize]
}
