profile kernel

import lib.kstate
import diag.hw
import diag.cmdcopy
import gfx.gfx
import sched.time
import arch.x86_64.fpu
import diag.hwdiag
import gfx.grafik
import gfx.r3dtest
import bus.drvreg
import bus.ecamdiag
import block.blkdev
import drv.net.iwl
import acpi.aml
import init.initstage

fn hw_scan(state: u64) {
    hw.stage(state)
    ecamdiag.stage(state)

    iwl.boot(state)

}

fn hw_diag(state: u64) {
    hw.blech_stage(state)
    aml.snapshot_boot(state)
    drvreg.boot_report(state)

}

fn graphics(state: u64) {
    let mbi: u64 = initstage.mbi()
    fpu.apply(state)
    gfx.stage_graphics(state, mbi)
    kstate.set(state, kstate.BM_BASE + 24, time.tsc())

}

fn screen_diag(state: u64) {
    hwdiag.stage(state, cmdcopy.cmd_copy(state))

    grafik.stage(state, cmdcopy.cmd_copy(state))

    r3dtest.stage(state, cmdcopy.cmd_copy(state))

}

fn block_table(state: u64) {
    if kstate.mode_on(state, kstate.M_BLKTAB) {
        blkdev.print_table(state)
    }

}

fn register() {
    initstage.add(initstage.S_BUS, hw_scan as u64)
    initstage.add(initstage.S_BUS, hw_diag as u64)
    initstage.add(initstage.S_BUS, graphics as u64)
    initstage.add(initstage.S_BUS, screen_diag as u64)
    initstage.add(initstage.S_BUS, block_table as u64)
}
