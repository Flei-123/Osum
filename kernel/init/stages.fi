profile kernel

import init.stage_early
import init.stage_core
import init.stage_bus
import init.stage_task
import init.stage_test
import init.stage_power
import init.stage_fs
import init.stage_device
import init.stage_root
import init.stage_smp
import init.stage_late
import init.initstage

fn register_all() {
    stage_early.register()
    stage_core.register()
    stage_bus.register()
    stage_task.register()
    stage_test.register()
    stage_power.register()
    stage_fs.register()
    stage_device.register()
    stage_root.register()
    stage_smp.register()
    stage_late.register()
}

fn run(state: u64) {
    register_all()
    initstage.run_all(state)
}
