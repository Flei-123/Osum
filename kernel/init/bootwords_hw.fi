profile kernel

import lib.cmdword
import lib.kstate
import init.bootscan

fn gest_word(state: u64, cmd: u64) {
    var w_gest: [u8; 8] = "hidgest\0"
    if cmdword.find(cmd, (&w_gest[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_HIDGEST)
    }
}

fn vgpu_heads_word(state: u64, cmd: u64) {
    var w_vh: [u8; 10] = "vgpuheads\0"
    if cmdword.find(cmd, (&w_vh[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_VGPUHEADS)
    }
    var w_vs: [u8; 10] = "vgpushort\0"
    if cmdword.find(cmd, (&w_vs[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_VGPUSHORT)
    }
    var w_vr: [u8; 14] = "vgpurtmirror\0\0"
    if cmdword.find(cmd, (&w_vr[0]) as u64, 12) != 0 {
        kstate.mode_add(state, kstate.M_VGPURTMIR)
    }
}

fn vgpu_ext_word(state: u64, cmd: u64) {
    var w_ve: [u8; 11] = "vgpuextend\0"
    var w_vm: [u8; 11] = "vgpumirror\0"
    if cmdword.find(cmd, (&w_vm[0]) as u64, 10) == 0 || cmdword.find(cmd, (&w_ve[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_VGPUEXT)
    }
}

fn hd_words(state: u64, cmd: u64) {
    var w_ht: [u8; 7] = "hdtest\0"
    var w_hh: [u8; 6] = "hdhot\0"
    var w_hw: [u8; 11] = "hwheeltest\0"
    var w_i2s: [u8; 7] = "i2csim\0"
    var w_tsim: [u8; 10] = "touchsim\0\0"
    var w_iold: [u8; 7] = "i2cold\0"
    var w_inoa: [u8; 9] = "i2cnoaml\0"
    var w_vhw: [u8; 7] = "vgpuhw\0"
    var w_nvs: [u8; 9] = "novmsvga\0"
    var w_vsh: [u8; 9] = "vmsvgahw\0"
    var w_vsr: [u8; 11] = "vmsvgarect\0"
    var w_vsd: [u8; 11] = "vmsvgadrop\0"
    var w_utr: [u8; 9] = "usbtrace\0"
    var w_xol: [u8; 9] = "xhciold\0\0"
    var w_ust: [u8; 9] = "usbstall\0"
    var w_vhn: [u8; 12] = "vmsvgahints\0"
    var w_vbt: [u8; 12] = "vmsvgaboot\0\0"
    var w_vbg: [u8; 10] = "vmsvgabig\0"
    var w_vod: [u8; 10] = "vmsvgaodd\0"
    var w_nbr: [u8; 12] = "nobootretry\0"
    var w_rmo: [u8; 9] = "roomold\0\0"
    var w_nbf: [u8; 11] = "nobootfit\0\0"
    var w_nki: [u8; 8] = "nokirq\0\0"
    var w_nkp: [u8; 10] = "nokbdpoll\0"
    var w_vfl: [u8; 12] = "vmsvgafull\0\0"
    var w_aco: [u8; 8] = "acpiold\0"
    var w_blp: [u8; 6] = "blpch\0"
    var w_blc: [u8; 6] = "blcpu\0"
    var w_blb: [u8; 6] = "blbad\0"
    var w_bln: [u8; 7] = "blnone\0"
    var w_nkk: [u8; 7] = "nokick\0"
    var w_aps: [u8; 7] = "apslow\0"
    var w_p2g: [u8; 9] = "ps2gone\0\0"
    var w_rcl: [u8; 10] = "resclear\0\0"
    var w_nbt: [u8; 12] = "nobootterm\0\0"
    var w_nlf: [u8; 10] = "nolatfix\0\0"
    var w_vst: [u8; 12] = "vmsvgastale\0"
    var w_vso: [u8; 10] = "vmsvgaold\0"
    var w_ndh: [u8; 9] = "netdhot\0\0"
    var w_nqt: [u8; 9] = "noquiet\0\0"
    var w_nsl: [u8; 10] = "noserline\0"
    var w_xlg: [u8; 8] = "execlog\0"
    var w_abp: [u8; 8] = "abpanic\0"
    var w_odb: [u8; 6] = "odb=1\0"
    if cmdword.find(cmd, (&w_ht[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_HDTEST)
    }
    if cmdword.find(cmd, (&w_hh[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_HDHOT)
    }
    if cmdword.find(cmd, (&w_hw[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_HWTEST)
    }
    if cmdword.find(cmd, (&w_i2s[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_I2CSIM)
    }
    if cmdword.find(cmd, (&w_tsim[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_TOUCHSIM)
    }
    if cmdword.find(cmd, (&w_iold[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_I2COLD)
    }
    if cmdword.find(cmd, (&w_inoa[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_I2CNOAML)
    }
    if cmdword.find(cmd, (&w_vhw[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_VGPUHW)
    }
    if cmdword.find(cmd, (&w_nvs[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOVMSVGA)
    }
    if cmdword.find(cmd, (&w_vsh[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_VMSVGAHW)
    }
    if cmdword.find(cmd, (&w_vsr[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_VMSVGARECT)
    }
    if cmdword.find(cmd, (&w_vsd[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_VMSVGADROP)
    }
    if cmdword.find(cmd, (&w_utr[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_USBTRACE)
    }
    if cmdword.find(cmd, (&w_xol[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_XHCIOLD)
    }
    if cmdword.find(cmd, (&w_ust[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_USBSTALL)
    }
    if cmdword.find(cmd, (&w_vhn[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_VMSVGAHINTS)
    }
    if cmdword.find(cmd, (&w_vbt[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_VMSVGABOOT)
    }
    if cmdword.find(cmd, (&w_vbg[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_VMSVGABIG)
    }
    if cmdword.find(cmd, (&w_vod[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_VMSVGAODD)
    }
    if cmdword.find(cmd, (&w_nbr[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_NOBOOTRETRY)
    }
    if cmdword.find(cmd, (&w_rmo[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_ROOMOLD)
    }
    if cmdword.find(cmd, (&w_vfl[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_VMSVGAFULL)
    }
    if cmdword.find(cmd, (&w_aco[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_ACPIOLD)
    }
    if cmdword.find(cmd, (&w_blp[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_BLPCH)
    }
    if cmdword.find(cmd, (&w_blc[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_BLCPU)
    }
    if cmdword.find(cmd, (&w_blb[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_BLBAD)
    }
    if cmdword.find(cmd, (&w_bln[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_BLNONE)
    }
    if cmdword.find(cmd, (&w_nkk[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_NOKICK)
    }
    if cmdword.find(cmd, (&w_aps[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_APSLOW)
    }
    if cmdword.find(cmd, (&w_p2g[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_PS2GONE)
    }
    if cmdword.find(cmd, (&w_rcl[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_RESCLEAR)
    }
    if cmdword.find(cmd, (&w_nbf[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_NOBOOTFIT)
    }
    if cmdword.find(cmd, (&w_nki[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_NOKIRQ)
    }
    if cmdword.find(cmd, (&w_nkp[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_NOKBDPOLL)
    }
    if cmdword.find(cmd, (&w_nbt[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_NOBOOTTERM)
    }
    if cmdword.find(cmd, (&w_nlf[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOLATFIX)
    }
    if cmdword.find(cmd, (&w_vst[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_VMSVGASTALE)
    }
    if cmdword.find(cmd, (&w_ndh[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NETDHOT)
    }
    if cmdword.find(cmd, (&w_nqt[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOQUIET)
    }
    if cmdword.find(cmd, (&w_xlg[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_EXECLOG)
    }
    if cmdword.find(cmd, (&w_abp[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_ABPANIC)
    }
    if cmdword.find(cmd, (&w_nsl[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_NOSERLINE)
    }
    if cmdword.find(cmd, (&w_odb[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_ODB)
    }
    if cmdword.find(cmd, (&w_vso[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_VMSVGAOLD)
    }
}

fn hotkey_words(state: u64, cmd: u64) {
    var w_nh: [u8; 8] = "nohktab\0"
    var w_ne: [u8; 5] = "noec\0"
    var w_es: [u8; 6] = "ecsim\0"
    if cmdword.find(cmd, (&w_nh[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOHKTAB)
    }
    if cmdword.find(cmd, (&w_ne[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_NOEC)
    }
    if cmdword.find(cmd, (&w_es[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_ECSIM)
    }
}

fn rndis_only_word(state: u64, cmd: u64) {
    var w_ro: [u8; 10] = "rndisonly\0"
    if cmdword.find(cmd, (&w_ro[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_USBRNDIS)
    }
}

fn isoc_test_word(state: u64, cmd: u64) {
    var w_it: [u8; 9] = "isoctest\0"
    if cmdword.find(cmd, (&w_it[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_USBISOC)
    }
}
