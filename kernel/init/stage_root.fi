profile kernel

import lib.kstate
import diag.hwid
import diag.hw
import bus.ecamdiag
import sched.schlaf
import sched.wach
import init.bootroot
import init.bootusb
import init.initstage

fn sleep_wake_checks(state: u64) {
    if kstate.mode_on(state, kstate.M_SCHLAFPRUEF) {
        schlaf.check(state, schlaf.frei_beim_start(state))
    }

    if kstate.mode_on(state, kstate.M_WACHPRUEF) {
        wach.check(state)
    }
    if kstate.mode_on(state, kstate.M_WACHMESS) {
        wach.measure(state)
    }
    if kstate.mode_on(state, kstate.M_WACHARM) {
        var wzyk: u64 = 1
        if kstate.mode_on(state, kstate.M_WACH) {
            wzyk = 2
        }
        wach.arm(state, wzyk)
    }
    if kstate.mode_on(state, kstate.M_SCHLAFARM) {
        schlaf.arm_and_exit(state)
    }

}

fn register() {
    initstage.add(initstage.S_ROOT, bootroot.osum as u64)
    initstage.add(initstage.S_ROOT, ecamdiag.proc_probe as u64)
    initstage.add(initstage.S_ROOT, sleep_wake_checks as u64)
    initstage.add(initstage.S_ROOT, bootusb.usb_hold as u64)
    initstage.add(initstage.S_ROOT, hw.disk as u64)
    initstage.add(initstage.S_ROOT, hwid.late as u64)
}
