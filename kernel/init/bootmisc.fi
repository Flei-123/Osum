profile kernel

import serial
import sched.proc
import net.ebpfhook
import ipc.cap
import lib.kutil
import arch.x86_64.hv

const P_HV: u64 = 15

fn hv_ring3(state: u64) {
    var s_exit: [u8; 17] = "hv: ring 3 exit=\0"
    if !hv.on(state, hv.M_HV) {
        return
    }
    if !hv.ready(state) {
        return
    }
    let rechte: u64 = cap.R_WRITE | cap.R_DUPLICATE | cap.R_INSPECT
    let t: u64 = proc.create_cap(state, P_HV, rechte, 2)
    if t == 0 {
        return
    }
    let e: u64 = kutil.wait_for(state, t)
    serial.puts((&s_exit[0]) as u64)
    serial.dec(e)
    serial.nl()
}

fn ebpfhook_report(state: u64) {
    var s_h: [u8; 7] = "ebpf:\0\0"
    var s_on: [u8; 5] = " on=\0"
    var s_ld: [u8; 8] = " load=\0\0"
    var s_se: [u8; 8] = " sehen=\0"
    var s_dr: [u8; 10] = " verwerf=\0"
    var s_pa: [u8; 9] = " durch=\0\0"
    var s_ab: [u8; 10] = " abbruch=\0"
    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_on[0]) as u64)
    if ebpfhook.on(state) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_ld[0]) as u64)
    serial.dec(ebpfhook.loaded(state))
    serial.puts((&s_se[0]) as u64)
    serial.dec(ebpfhook.seen(state))
    serial.puts((&s_dr[0]) as u64)
    serial.dec(ebpfhook.drops(state))
    serial.puts((&s_pa[0]) as u64)
    serial.dec(ebpfhook.passes(state))
    serial.puts((&s_ab[0]) as u64)
    serial.dec(ebpfhook.aborts(state))
    serial.nl()
}
