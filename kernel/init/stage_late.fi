profile kernel

import serial
import lib.kstate
import pwr.power
import gfx.gfx
import drv.con.sercon
import arch.x86_64.hv
import arch.x86_64.guard
import arch.x86_64.fpu
import ldr.bootmod
import diag.crash
import diag.modedump
import usb.usb
import drv.hid.hidin
import init.bootmisc
import init.testsched
import init.initstage

fn hid_latency(state: u64) {
    if kstate.mode_on(state, kstate.M_HIDLAT) {
        hidin.stage(state)
        hidin.latenz(state)
    }

}

fn crash_knall(state: u64) {
    if kstate.mode_on(state, kstate.M_KRACH)
            && kstate.mode_on(state, kstate.M_KRACHJETZT) {
        crash.knall(state, 0)
    }
}

fn shutdown(state: u64) {
    var s_done: [u8; 13] = "kernel: done\0"
    serial.puts((&s_done[0]) as u64)
    serial.nl()
    power.shutdown(power.EXIT_OK)
}

fn mode_report(state: u64) {
    modedump.report(state)
}

fn register() {
    initstage.add(initstage.S_LATE, mode_report as u64)
    initstage.add(initstage.S_LATE, hv.stage as u64)
    initstage.add(initstage.S_LATE, bootmisc.hv_ring3 as u64)
    initstage.add(initstage.S_LATE, testsched.ring3 as u64)
    initstage.add(initstage.S_LATE, gfx.stage_surface as u64)
    initstage.add(initstage.S_LATE, gfx.stage_hold as u64)
    initstage.add(initstage.S_LATE, guard.report_aps as u64)
    initstage.add(initstage.S_LATE, fpu.report_aps as u64)
    initstage.add(initstage.S_LATE, bootmod.recheck as u64)
    initstage.add(initstage.S_LATE, usb.report as u64)
    initstage.add(initstage.S_LATE, hid_latency as u64)
    initstage.add(initstage.S_LATE, sercon.report as u64)
    initstage.add(initstage.S_LATE, crash_knall as u64)
    initstage.add(initstage.S_LATE, shutdown as u64)
}
