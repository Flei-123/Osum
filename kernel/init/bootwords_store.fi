profile kernel

import lib.cmdword
import lib.kstate
import init.bootscan

fn store_words(state: u64, cmd: u64) {
    var w_ns: [u8; 8] = "nostore\0"
    if cmdword.find(cmd, (&w_ns[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_NOSTORE)
    }
    var w_du: [u8; 10] = "drvunload\0"
    if cmdword.find(cmd, (&w_du[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_DRVUNLOAD)
    }
    var w_fbc: [u8; 12] = "iwlfhbigcal\0"
    if cmdword.find(cmd, (&w_fbc[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHBIGCAL)
    }
    var w_ono: [u8; 12] = "iwloldnotif\0"
    if cmdword.find(cmd, (&w_ono[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDNOTIF)
    }
    var w_oty: [u8; 11] = "iwloldtype\0"
    if cmdword.find(cmd, (&w_oty[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDTYPE)
    }
    var w_oph: [u8; 10] = "iwloldphy\0"
    if cmdword.find(cmd, (&w_oph[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDPHY)
    }
    var w_oin: [u8; 11] = "iwloldinit\0"
    if cmdword.find(cmd, (&w_oin[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDINIT)
    }
    var w_irt: [u8; 7] = "iwlrt=\0"
    let rtv: u64 = bootscan.num_nach(cmd, (&w_irt[0]) as u64, 6, 0)
    if (rtv & 1) != 0 { kstate.mode_add(state, kstate.M_IWLRT0) }
    if (rtv & 2) != 0 { kstate.mode_add(state, kstate.M_IWLRT1) }
    if (rtv & 4) != 0 { kstate.mode_add(state, kstate.M_IWLRT2) }
    var w_ohd: [u8; 10] = "iwloldhdr\0"
    if cmdword.find(cmd, (&w_ohd[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDHDR)
    }
    var w_wtx: [u8; 8] = "wltxoff\0"
    if cmdword.find(cmd, (&w_wtx[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_WLTXOFF)
    }
    var w_wbc: [u8; 10] = "wlbcbytes\0"
    if cmdword.find(cmd, (&w_wbc[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_WLBCBYTES)
    }
    var w_wlq: [u8; 5] = "wllq\0"
    if cmdword.find(cmd, (&w_wlq[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_WLLQ)
    }
    var w_wlplain: [u8; 8] = "wlplain\0"
    if cmdword.find(cmd, (&w_wlplain[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_WLPLAIN)
    }
    var w_wlhwc: [u8; 6] = "wlhwc\0"
    if cmdword.find(cmd, (&w_wlhwc[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_WLHWC)
    }
    var w_wlsta: [u8; 6] = "wlsta\0"
    if cmdword.find(cmd, (&w_wlsta[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_WLSTA)
    }
    var w_wldq: [u8; 5] = "wldq\0"
    if cmdword.find(cmd, (&w_wldq[0]) as u64, 4) != 0 {
        kstate.mode_add(state, kstate.M_WLDQ)
    }
    var w_wlgrp: [u8; 6] = "wlgrp\0"
    if cmdword.find(cmd, (&w_wlgrp[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_WLGRP)
    }
    var w_wlswgrp: [u8; 8] = "wlswgrp\0"
    if cmdword.find(cmd, (&w_wlswgrp[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_WLSWGRP)
    }
    var w_wldtim: [u8; 7] = "wldtim\0"
    if cmdword.find(cmd, (&w_wldtim[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_WLDTIM)
    }
    var w_wlnodefq: [u8; 9] = "wlnodefq\0"
    if cmdword.find(cmd, (&w_wlnodefq[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_WLNODEFQ)
