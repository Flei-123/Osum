    var w_usf: [u8; 10] = "usblossff\0"
    if cmdword.find(cmd, (&w_usf[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_USBLOSSFF)
    }
    var w_nue: [u8; 9] = "nousbevr\0"
    if cmdword.find(cmd, (&w_nue[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOUSBEVR)
    }
    var w_nuw: [u8; 11] = "nousbwatch\0"
    if cmdword.find(cmd, (&w_nuw[0]) as u64, 10) != 0 {
