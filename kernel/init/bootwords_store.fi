    if cmdword.find(cmd, (&w_nwl[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_NOWIRELOCK)
    }
    var w_nbg: [u8; 12] = "noblkguard\0\0"
    if cmdword.find(cmd, (&w_nbg[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_NOBLKGUARD)
    }
    var w_nal: [u8; 12] = "nodrvlock\0\0\0"
    if cmdword.find(cmd, (&w_nal[0]) as u64, 9) != 0 {
