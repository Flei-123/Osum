    if cmdword.find(cmd, (&w_swd[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_SERWIDEN)
    }
    var w_nsi: [u8; 8] = "nosetif\0"
    if cmdword.find(cmd, (&w_nsi[0]) as u64, 7) != 0 {
