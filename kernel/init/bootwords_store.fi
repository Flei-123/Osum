    if cmdword.find(cmd, (&w_wlswtx[0]) as u64, 6) != 0 {
        kstate.mode_add(state, kstate.M_WLSWTX)
    }
    var w_noupprefer: [u8; 11] = "noupprefer\0"
    if cmdword.find(cmd, (&w_noupprefer[0]) as u64, 10) != 0 {
