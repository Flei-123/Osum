profile kernel

import lib.cmdword
import lib.kstate
import init.bootscan

fn iwl_words(state: u64, cmd: u64) {
    var w_ib: [u8; 8] = "iwlboot\0"
    var w_it: [u8; 10] = "iwlfwtest\0"
    if cmdword.find(cmd, (&w_ib[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_IWLBOOT)
    }
    if cmdword.find(cmd, (&w_it[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFWTEST)
    }
    var w_fh: [u8; 10] = "iwlfhtest\0"
    var w_fl: [u8; 10] = "iwlfhlost\0"
    var w_fb: [u8; 9] = "iwlfhbad\0"
    if cmdword.find(cmd, (&w_fh[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHTEST)
    }
    if cmdword.find(cmd, (&w_fl[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHLOST)
    }
    if cmdword.find(cmd, (&w_fb[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHBAD)
    }
    var w_ni: [u8; 6] = "noiwl\0"
    var w_nn: [u8; 11] = "iwlfhnonvm\0"
    var w_nc: [u8; 13] = "iwlfhnoinitc\0"
    var w_na: [u8; 13] = "iwlfhnoalive\0"
    var w_bn: [u8; 12] = "iwlfhbadnvm\0"
    var w_bi: [u8; 10] = "iwlfhbind\0"
    if cmdword.find(cmd, (&w_ni[0]) as u64, 5) != 0 {
        kstate.mode_add(state, kstate.M_NOIWL)
    }
    if cmdword.find(cmd, (&w_nn[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHNONVM)
    }
    if cmdword.find(cmd, (&w_nc[0]) as u64, 12) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHNOINITC)
    }
    if cmdword.find(cmd, (&w_na[0]) as u64, 12) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHNOALIVE)
    }
    if cmdword.find(cmd, (&w_bn[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHBADNVM)
    }
    if cmdword.find(cmd, (&w_bi[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHBIND)
    }
    var w_iwloldscan: [u8; 11] = "iwloldscan\0"
    var w_iwloldslot: [u8; 11] = "iwloldslot\0"
    var w_iwloldssid: [u8; 11] = "iwloldssid\0"
    var w_iwloldmac: [u8; 10] = "iwloldmac\0"
    var w_iwloldtxq: [u8; 10] = "iwloldtxq\0"
    var w_iwloldloss: [u8; 11] = "iwloldloss\0"
    var w_iwloldpbkdf: [u8; 12] = "iwloldpbkdf\0"
    var w_iwlfhdrop: [u8; 10] = "iwlfhdrop\0"
    var w_wlannoloss: [u8; 11] = "wlannoloss\0"
    var w_iwloldrx: [u8; 9] = "iwloldrx\0"
    var w_iwlfhslow: [u8; 10] = "iwlfhslow\0"
    var w_iwloldalive: [u8; 12] = "iwloldalive\0"
    var w_iwlfhrxonly: [u8; 12] = "iwlfhrxonly\0"
    var w_iwlnotrace: [u8; 11] = "iwlnotrace\0"
    var w_iwlfhwake: [u8; 10] = "iwlfhwake\0"
    var w_iwlfhdead: [u8; 10] = "iwlfhdead\0"
    var w_iwlfhrxsilent: [u8; 14] = "iwlfhrxsilent\0"
    var w_iwlnoraw: [u8; 9] = "iwlnoraw\0"
    var w_iwlfhexpwake: [u8; 13] = "iwlfhexpwake\0"
    var w_iwlnorxexp: [u8; 11] = "iwlnorxexp\0"
    var w_iwlfhmsi: [u8; 9] = "iwlfhmsi\0"
    var w_iwlnopoll: [u8; 10] = "iwlnopoll\0"
    var w_iwlnoown: [u8; 9] = "iwlnoown\0"
    if cmdword.find(cmd, (&w_iwloldscan[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDSCAN)
    }
    if cmdword.find(cmd, (&w_iwloldslot[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDSLOT)
    }
    if cmdword.find(cmd, (&w_iwloldssid[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDSSID)
    }
    if cmdword.find(cmd, (&w_iwloldmac[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDMAC)
    }
    if cmdword.find(cmd, (&w_iwloldtxq[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDTXQ)
    }
    if cmdword.find(cmd, (&w_iwloldloss[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDLOSS)
    }
    if cmdword.find(cmd, (&w_iwloldpbkdf[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDPBKDF)
    }
    if cmdword.find(cmd, (&w_iwlfhdrop[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHDROP)
    }
    if cmdword.find(cmd, (&w_wlannoloss[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_WLANNOLOSS)
    }
    if cmdword.find(cmd, (&w_iwloldrx[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDRX)
    }
    if cmdword.find(cmd, (&w_iwlfhslow[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHSLOW)
    }
    if cmdword.find(cmd, (&w_iwloldalive[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLOLDALIVE)
    }
    if cmdword.find(cmd, (&w_iwlfhrxonly[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHRXONLY)
    }
    if cmdword.find(cmd, (&w_iwlnotrace[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLNOTRACE)
    }
    if cmdword.find(cmd, (&w_iwlfhwake[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHWAKE)
    }
    if cmdword.find(cmd, (&w_iwlfhdead[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHDEAD)
    }
    if cmdword.find(cmd, (&w_iwlfhrxsilent[0]) as u64, 13) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHRXSILENT)
    }
    if cmdword.find(cmd, (&w_iwlnoraw[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_IWLNORAW)
    }
    if cmdword.find(cmd, (&w_iwlfhexpwake[0]) as u64, 12) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHEXPWAKE)
    }
    if cmdword.find(cmd, (&w_iwlnorxexp[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLNORXEXP)
    }
    if cmdword.find(cmd, (&w_iwlfhmsi[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHMSI)
    }
    if cmdword.find(cmd, (&w_iwlnopoll[0]) as u64, 9) != 0 {
        kstate.mode_add(state, kstate.M_IWLNOPOLL)
    }
    if cmdword.find(cmd, (&w_iwlnoown[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_IWLNOOWN)
    }
    var w_iwlnoipoll: [u8; 11] = "iwlnoipoll\0"
    if cmdword.find(cmd, (&w_iwlnoipoll[0]) as u64, 10) != 0 {
        kstate.mode_add(state, kstate.M_IWLNOIPOLL)
    }
    var w_iwlfhrfkill: [u8; 12] = "iwlfhrfkill\0"
    if cmdword.find(cmd, (&w_iwlfhrfkill[0]) as u64, 11) != 0 {
        kstate.mode_add(state, kstate.M_IWLFHRFKILL)
    }
}
