profile kernel

import lib.bootword
import lib.procw
import lib.modes.words_locks
import lib.modes.words_idle
import lib.modes.words_diag

export { parse, render }

fn parse(state: u64, cmd: u64) {
    bootword.parse(state, cmd, (&words_locks.names[0]) as u64, (&words_locks.bits[0]) as u64, (&words_locks.meta[0]) as u64, words_locks.COUNT)
    bootword.parse(state, cmd, (&words_idle.names[0]) as u64, (&words_idle.bits[0]) as u64, (&words_idle.meta[0]) as u64, words_idle.COUNT)
    bootword.parse(state, cmd, (&words_diag.names[0]) as u64, (&words_diag.bits[0]) as u64, (&words_diag.meta[0]) as u64, words_diag.COUNT)
}

fn render(state: u64, out: u64, cap: u64) -> u64 {
    procw.begin(out, cap)
    bootword.render(state, (&words_locks.names[0]) as u64, (&words_locks.docs[0]) as u64, (&words_locks.bits[0]) as u64, (&words_locks.meta[0]) as u64, words_locks.COUNT)
    bootword.render(state, (&words_idle.names[0]) as u64, (&words_idle.docs[0]) as u64, (&words_idle.bits[0]) as u64, (&words_idle.meta[0]) as u64, words_idle.COUNT)
    bootword.render(state, (&words_diag.names[0]) as u64, (&words_diag.docs[0]) as u64, (&words_diag.bits[0]) as u64, (&words_diag.meta[0]) as u64, words_diag.COUNT)
    return procw.used()
}
