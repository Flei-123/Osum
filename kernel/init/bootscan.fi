profile kernel

import lib.cmdword
import lib.kstate

fn k_place(cmd: u64, name: u64, n: u64) -> u64 {
    return cmdword.find_key(cmd, name, n)
}

fn k_number(cmd: u64, name: u64, n: u64, vorgabe: u64) -> u64 {
    let f: u64 = k_place(cmd, name, n)
    if f == 0 {
        return vorgabe
    }
    var at: u64 = f + n + 1
    var v: u64 = 0
    var hat: bool = false
    var lese: bool = true
    while lese {
        let c: u64 = kstate.get8(at) as u64
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
            at = at + 1
            hat = true
        } else {
            lese = false
        }
    }
    if !hat {
        return vorgabe
    }
    return v
}

fn k_word(cmd: u64, name: u64, n: u64, dst: u64, cap: u64) -> u64 {
    let f: u64 = k_place(cmd, name, n)
    if f == 0 {
        return 0
    }
    var at: u64 = f + n + 1
    var i: u64 = 0
    var lese: bool = true
    while lese && i < cap {
        let c: u64 = kstate.get8(at) as u64
        if c == 0 || c == 32 {
            lese = false
        } else {
            kstate.set8(dst + i, (c & 255) as u8)
            i = i + 1
            at = at + 1
        }
    }
    return i
}

fn num_nach(cmd: u64, key: u64, n: u64, missing: u64) -> u64 {
    let p: u64 = cmdword.find(cmd, key, n)
    if p == 0 {
        return missing
    }
    var i: u64 = p + n
    var v: u64 = 0
    var places: u64 = 0
    while kstate.get8(i) >= 48 && kstate.get8(i) <= 57 {
        v = v * 10 + (kstate.get8(i) - 48)
        places = places + 1
        i = i + 1
    }
    if places == 0 {
        return missing
    }
    return v
}

