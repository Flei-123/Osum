profile kernel

import lib.kstate

export { PW_BRIGHT, PW_BRIGHTSET, bright }

const PW_BRIGHT: u64 = 224
const PW_BRIGHTSET: u64 = 248

fn bright(state: u64) -> u64 {
    let v: u64 = kstate.get(state, kstate.K18_OFF + PW_BRIGHT)
    if v == 0 && kstate.get(state, kstate.K18_OFF + PW_BRIGHTSET) == 0 {
        return 100
    }
    return v
}
