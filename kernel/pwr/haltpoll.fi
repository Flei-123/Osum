profile kernel

import lib.kstate
import sync.atomic

export { window, spinning, enter, leave, adapt }

const MAX_CPUS: u64 = kstate.MAX_CPUS
const GROW_START_US: u64 = 25
const MAX_US: u64 = 200
const SHRINK_BELOW_US: u64 = 10

static mut windows: [u64; 8] = [0 as u64; 8]
static mut flags: [u64; 8] = [0 as u64; 8]

fn window(me: u64) -> u64 {
    if me >= MAX_CPUS {
        return 0
    }
    return windows[me as usize]
}

fn spinning(me: u64) -> bool {
    if me >= MAX_CPUS {
        return false
    }
    return flags[me as usize] != 0
}

fn enter(me: u64) {
    flags[me as usize] = 1
    atomic.barrier()
}

fn leave(me: u64) {
    flags[me as usize] = 0
    atomic.barrier()
}

fn adapt(me: u64, waited: u64, per_us: u64) {
    if me >= MAX_CPUS || per_us == 0 {
        return
    }
    let current: u64 = windows[me as usize]
    if waited <= current {
        return
    }
    if waited > MAX_US * per_us {
        var shrunk: u64 = current / 2
        if shrunk < SHRINK_BELOW_US * per_us {
            shrunk = 0
        }
        windows[me as usize] = shrunk
        return
    }
    var grown: u64 = current * 2
    if grown < GROW_START_US * per_us {
        grown = GROW_START_US * per_us
    }
    if grown > MAX_US * per_us {
        grown = MAX_US * per_us
    }
    windows[me as usize] = grown
}
