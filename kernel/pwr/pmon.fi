profile kernel

import lib.cmdword
import lib.kstate
import sched.taskconst
import sched.taskslot
import pwr.batt
import pwr.pwbright
import sched.time
import serial

export {
    init, parse, arm, tick, sample, flush, on, set_on, mode_word, report,
    wigapp, wighalt,
    scalar, set_scalar, tget, task_pid, task_alive,
    name_at, name_set, task_clear,
    sample_rate, sample_tick, bucket_at, roll_day, reset_window,
    prog_get, prog_name_at, prog_used,
    PM_ON, PM_MODE, PM_SAMPLES, PM_LASTTICK, PM_HZ, PM_RATE, PM_UNIT,
    PM_RATEOK, PM_BASE, PM_BASEOK, PM_BASEN, PM_BASESUM, PM_BASEMIN,
    PM_ATTRIB, PM_BUSY, PM_IDLE, PM_DEAD, PM_SYSE, PM_ACRATE, PM_ACOK,
    PM_BATRATE, PM_BATOK, PM_HEALTH, PM_HEALTHOK, PM_MINUTES,
    PM_COST, PM_COSTN, PM_MISSES, PM_DAYSTART, PM_HEAD, PM_EVERY,
    PM_MAXRATE, PM_MINRATE, PM_DAYS, PM_WINDOWS, PM_ORPHAN, PM_ORPHANS,
    PM_STAGED, PM_SCALARS,
    PT_TICKS, PT_ENERGY, PT_DAYT, PT_DAYE, PT_LAST, PT_NOW, PT_FIELDS,
    M_NONE, M_EAGER, M_NOFLOOR, M_SAY,
    NSAMPLE, NBUCKET, NPROG, NAME_MAX,
    PR_TICKS, PR_ENERGY, PR_DAYT, PR_DAYE, PR_PROCS, PR_PEND, PR_FIELDS
}

const SCAL: u64 = 0x0000
const TASKS: u64 = 0x0200
const TBYTES: u64 = 96
const BUCKETS: u64 = 0x6200
const BBYTES: u64 = 24
const NBUCKET: u64 = 11
const WAPP: u64 = 0x6340
const WAPP_MAX: u64 = 128
const WSEK: u64 = 0x63C0
const RING: u64 = 0x6400
const RBYTES: u64 = 16
const NSAMPLE: u64 = 256
const PROGS: u64 = 0x7400
const PRBYTES: u64 = 96
const NPROG: u64 = 16

const PM_ON: u64 = 0x00
const PM_MODE: u64 = 0x08
const PM_SAMPLES: u64 = 0x10
const PM_LASTTICK: u64 = 0x18
const PM_HZ: u64 = 0x20
const PM_RATE: u64 = 0x28
const PM_UNIT: u64 = 0x30
const PM_RATEOK: u64 = 0x38
const PM_BASE: u64 = 0x40
const PM_BASEOK: u64 = 0x48
const PM_BASEN: u64 = 0x50
const PM_BASESUM: u64 = 0x58
const PM_BASEMIN: u64 = 0x60
const PM_ATTRIB: u64 = 0x68
const PM_BUSY: u64 = 0x70
const PM_IDLE: u64 = 0x78
const PM_DEAD: u64 = 0x80
const PM_SYSE: u64 = 0x88
const PM_ACRATE: u64 = 0x90
const PM_ACOK: u64 = 0x98
const PM_BATRATE: u64 = 0xA0
const PM_BATOK: u64 = 0xA8
const PM_HEALTH: u64 = 0xB0
const PM_HEALTHOK: u64 = 0xB8
const PM_MINUTES: u64 = 0xC0
const PM_COST: u64 = 0xC8
const PM_COSTN: u64 = 0xD0
const PM_MISSES: u64 = 0xD8
const PM_DAYSTART: u64 = 0xE0
const PM_HEAD: u64 = 0xE8
const PM_EVERY: u64 = 0xF0
const PM_MAXRATE: u64 = 0xF8
const PM_MINRATE: u64 = 0x100
const PM_DAYS: u64 = 0x108
const PM_WINDOWS: u64 = 0x110
const PM_ORPHAN: u64 = 0x118
const PM_ORPHANS: u64 = 0x120
const PM_STAGED: u64 = 0x128
const PM_SCALARS: u64 = 39

const PT_TICKS: u64 = 0
const PT_ENERGY: u64 = 1
const PT_DAYT: u64 = 2
const PT_DAYE: u64 = 3
const PT_LAST: u64 = 4
const PT_NOW: u64 = 5
const PT_FIELDS: u64 = 6

const PT_ROW: u64 = 80
const PT_PIDOF: u64 = 48
const PT_NAME: u64 = 56
const NAME_MAX: u64 = 24

const PR_TICKS: u64 = 0
const PR_ENERGY: u64 = 1
const PR_DAYT: u64 = 2
const PR_DAYE: u64 = 3
const PR_PROCS: u64 = 4
const PR_PEND: u64 = 5
const PR_FIELDS: u64 = 6
const PR_NAME: u64 = 48

const PB_N: u64 = 0
const PB_SUM: u64 = 1
const PB_LEVEL: u64 = 2

fn pm(off: u64) -> u64 {
    return kstate.PMON_OFF + off
}

fn tat(t: u64) -> u64 {
    return pm(TASKS + t * TBYTES)
}

fn bat(b: u64) -> u64 {
    return pm(BUCKETS + b * BBYTES)
}

fn rat(i: u64) -> u64 {
    return pm(RING + i * RBYTES)
}

fn prat(i: u64) -> u64 {
    return pm(PROGS + i * PRBYTES)
}

const M_NONE: u64 = 1
const M_EAGER: u64 = 2
const M_NOFLOOR: u64 = 4
const M_SAY: u64 = 8

fn take_wigapp(state: u64, cmd: u64) {
    var w: [u8; 8] = "wigapp=\0"
    if cmd == 0 {
        return
    }
    let at: u64 = cmdword.find(cmd, (&w[0]) as u64, 7)
    if at == 0 {
        return
    }
    var i: u64 = 0
    while i < WAPP_MAX - 1 {
        let c: u64 = kstate.get8(at + 7 + i)
        if c == 0 || c == 32 {
            i = WAPP_MAX - 1
        } else {
            kstate.set8(state + pm(WAPP) + i, c as u8)
            i = i + 1
        }
    }
}

fn wigapp(state: u64) -> u64 {
    if kstate.get8(state + pm(WAPP)) == 0 {
        return 0
    }
    return state + pm(WAPP)
}

fn take_wighalt(state: u64, cmd: u64) {
    var w: [u8; 9] = "wighalt=\0"
    kstate.set(state, pm(WSEK), 0)
    if cmd == 0 {
        return
    }
    let at: u64 = cmdword.find(cmd, (&w[0]) as u64, 8)
    if at == 0 {
        return
    }
    var v: u64 = 0
    var i: u64 = 0
    var ziffern: u64 = 0
    while i < 6 {
        let c: u64 = kstate.get8(at + 8 + i)
        if c < 48 || c > 57 {
            i = 6
        } else {
            v = v * 10 + (c - 48)
            ziffern = ziffern + 1
            i = i + 1
        }
    }
    if ziffern == 0 {
        return
    }
    if v > 3600 {
        v = 3600
    }
    kstate.set(state, pm(WSEK), v)
}

fn wighalt(state: u64) -> u64 {
    return kstate.get(state, pm(WSEK))
}

fn parse(state: u64, cmd: u64) {
    var w_no: [u8; 11] = "nopowermon\0"
    var w_fast: [u8; 9] = "pmonfast\0"
    var w_nof: [u8; 12] = "pmonnofloor\0"
    var w_say: [u8; 8] = "pmonsay\0"
    var m: u64 = 0
    if cmdword.find(cmd, (&w_no[0]) as u64, 10) != 0 {
        m = m | M_NONE
    }
    if cmdword.find(cmd, (&w_fast[0]) as u64, 8) != 0 {
        m = m | M_EAGER
    }
    if cmdword.find(cmd, (&w_nof[0]) as u64, 11) != 0 {
        m = m | M_NOFLOOR
    }
    if cmdword.find(cmd, (&w_say[0]) as u64, 7) != 0 {
        m = m | M_SAY
    }
    init(state, m)
    take_wigapp(state, cmd)
    take_wighalt(state, cmd)
}

fn init(state: u64, mode: u64) {
    var i: u64 = 0
    while i < kstate.PMON_MAX / 8 {
        kstate.set(state, pm(i * 8), 0)
        i = i + 1
    }
    kstate.set(state, pm(PM_MODE), mode)
    kstate.set(state, pm(PM_HZ), time.TICK_HZ)
    if (mode & M_EAGER) != 0 {
        kstate.set(state, pm(PM_EVERY), 1)
    } else {
        kstate.set(state, pm(PM_EVERY), 10)
    }
    kstate.set(state, pm(PM_ON), 0)
    var b: u64 = 0
    while b < NBUCKET {
        kstate.set(state, bat(b) + PB_LEVEL * 8, b * 10)
        b = b + 1
    }
}

fn arm(state: u64) {
    kstate.set(state, pm(PM_STAGED), 1)
    if (kstate.get(state, pm(PM_MODE)) & M_NONE) != 0 {
        return
    }
    kstate.set(state, pm(PM_ON), 1)
    kstate.set(state, pm(PM_LASTTICK), kstate.get(state, kstate.TICKS))
    kstate.set(state, pm(PM_DAYSTART), kstate.get(state, kstate.TICKS))
}

fn on(state: u64) -> bool {
    return kstate.get(state, pm(PM_ON)) != 0
}

fn set_on(state: u64, v: u64) {
    kstate.set(state, pm(PM_ON), v)
}

fn mode_word(state: u64) -> u64 {
    return kstate.get(state, pm(PM_MODE))
}

fn scalar(state: u64, which: u64) -> u64 {
    if which >= PM_SCALARS {
        return 0
    }
    return kstate.get(state, pm(which * 8))
}

fn set_scalar(state: u64, which: u64, v: u64) {
    if which >= PM_SCALARS {
        return
    }
    kstate.set(state, pm(which * 8), v)
}

fn tget(state: u64, t: u64, field: u64) -> u64 {
    if t >= kstate.MAX_TASKS || field >= PT_FIELDS {
        return 0
    }
    return kstate.get(state, tat(t) + field * 8)
}

fn tadd(state: u64, t: u64, field: u64, n: u64) {
    if t >= kstate.MAX_TASKS || field >= PT_FIELDS {
        return
    }
    kstate.add(state, tat(t) + field * 8, n)
}

fn tset(state: u64, t: u64, field: u64, v: u64) {
    if t >= kstate.MAX_TASKS || field >= PT_FIELDS {
        return
    }
    kstate.set(state, tat(t) + field * 8, v)
}

fn task_pid(state: u64, t: u64) -> u64 {
    if t >= kstate.MAX_TASKS {
        return 0
    }
    return kstate.get(state, tat(t) + PT_PIDOF)
}

fn task_alive(state: u64, t: u64) -> bool {
    if t >= kstate.MAX_TASKS {
        return false
    }
    return taskslot.tget(state, t, taskconst.T_STATE) != taskconst.S_FREE
}

fn task_clear(state: u64, t: u64, pid: u64) {
    if t >= kstate.MAX_TASKS {
        return
    }
    var i: u64 = 0
    while i < TBYTES / 8 {
        kstate.set(state, tat(t) + i * 8, 0)
        i = i + 1
    }
    kstate.set(state, tat(t) + PT_PIDOF, pid)
    kstate.set(state, tat(t) + PT_ROW, 0)
    kstate.set(state, tat(t) + PT_LAST * 8,
        taskslot.tget(state, t, taskconst.T_TICKS))
}

fn name_at(state: u64, t: u64, i: u64) -> u64 {
    if t >= kstate.MAX_TASKS || i >= NAME_MAX {
        return 0
    }
    return kstate.get8(state + tat(t) + PT_NAME + i)
}

fn name_set(state: u64, t: u64, path: u64) {
    if t >= kstate.MAX_TASKS {
        return
    }
    kstate.set(state, tat(t) + PT_ROW, 0)
    var start: u64 = 0
    var i: u64 = 0
    while kstate.get8(path + i) != 0 {
        if kstate.get8(path + i) == 47 {
            start = i + 1
        }
        i = i + 1
    }
    var k: u64 = 0
    while k < NAME_MAX - 1 && kstate.get8(path + start + k) != 0 {
        kstate.set8(state + tat(t) + PT_NAME + k,
            kstate.get8(path + start + k) as u8)
        k = k + 1
    }
    while k < NAME_MAX {
        kstate.set8(state + tat(t) + PT_NAME + k, 0 as u8)
        k = k + 1
    }
}

fn prog_get(state: u64, i: u64, field: u64) -> u64 {
    if i >= NPROG || field >= PR_FIELDS {
        return 0
    }
    return kstate.get(state, prat(i) + field * 8)
}

fn prog_name_at(state: u64, i: u64, k: u64) -> u64 {
    if i >= NPROG || k >= NAME_MAX {
        return 0
    }
    return kstate.get8(state + prat(i) + PR_NAME + k)
}

fn prog_used(state: u64, i: u64) -> bool {
    if i >= NPROG {
        return false
    }
    return kstate.get8(state + prat(i) + PR_NAME) != 0
}

fn same_name(state: u64, row: u64, t: u64) -> bool {
    var k: u64 = 0
    while k < NAME_MAX {
        if kstate.get8(state + prat(row) + PR_NAME + k)
            != kstate.get8(state + tat(t) + PT_NAME + k) {
            return false
        }
        k = k + 1
    }
    return true
}

fn prog_row(state: u64, t: u64) -> u64 {
    let known: u64 = kstate.get(state, tat(t) + PT_ROW)
    if known != 0 {
        return known - 1
    }
    if kstate.get8(state + tat(t) + PT_NAME) == 0 {
        var kn: [u8; 7] = "system\0"
        name_set_row(state, NPROG - 2, (&kn[0]) as u64)
        kstate.set(state, tat(t) + PT_ROW, NPROG - 1)
        kstate.add(state, prat(NPROG - 2) + PR_PROCS * 8, 1)
        return NPROG - 2
    }
    var i: u64 = 0
    while i < NPROG - 2 {
        if kstate.get8(state + prat(i) + PR_NAME) == 0 {
            var k: u64 = 0
            while k < NAME_MAX {
                kstate.set8(state + prat(i) + PR_NAME + k,
                    kstate.get8(state + tat(t) + PT_NAME + k) as u8)
                k = k + 1
            }
            kstate.set(state, tat(t) + PT_ROW, i + 1)
            kstate.add(state, prat(i) + PR_PROCS * 8, 1)
            return i
        }
        if same_name(state, i, t) {
            kstate.set(state, tat(t) + PT_ROW, i + 1)
            kstate.add(state, prat(i) + PR_PROCS * 8, 1)
            return i
        }
        i = i + 1
    }
    var on: [u8; 6] = "other\0"
    name_set_row(state, NPROG - 1, (&on[0]) as u64)
    kstate.set(state, tat(t) + PT_ROW, NPROG)
    kstate.add(state, prat(NPROG - 1) + PR_PROCS * 8, 1)
    return NPROG - 1
}

fn name_set_row(state: u64, i: u64, lit: u64) {
    if kstate.get8(state + prat(i) + PR_NAME) != 0 {
        return
    }
    var k: u64 = 0
    while k < NAME_MAX - 1 && kstate.get8(lit + k) != 0 {
        kstate.set8(state + prat(i) + PR_NAME + k, kstate.get8(lit + k) as u8)
        k = k + 1
    }
    kstate.set8(state + prat(i) + PR_NAME + k, 0 as u8)
}

fn sample_rate(state: u64, i: u64) -> u64 {
    if i >= NSAMPLE {
        return 0
    }
    return kstate.get(state, rat(i))
}

fn sample_tick(state: u64, i: u64) -> u64 {
    if i >= NSAMPLE {
        return 0
    }
    return kstate.get(state, rat(i) + 8)
}

fn ring_push(state: u64, rate: u64, at: u64) {
    let h: u64 = kstate.get(state, pm(PM_HEAD))
    kstate.set(state, rat(h), rate)
    kstate.set(state, rat(h) + 8, at)
    var n: u64 = h + 1
    if n >= NSAMPLE {
        n = 0
    }
    kstate.set(state, pm(PM_HEAD), n)
}

fn bucket_at(state: u64, b: u64, which: u64) -> u64 {
    if b >= NBUCKET || which > 2 {
        return 0
    }
    return kstate.get(state, bat(b) + which * 8)
}

fn sample(state: u64) {
    let now: u64 = kstate.get(state, kstate.TICKS)
    let last: u64 = kstate.get(state, pm(PM_LASTTICK))
    var dt: u64 = 0
    if now > last {
        dt = now -% last
    }
    kstate.set(state, pm(PM_LASTTICK), now)
    kstate.add(state, pm(PM_SAMPLES), 1)

    batt.refresh(state)
    var rate: u64 = 0
    var have: bool = false
    if batt.present(state) {
        rate = batt.value(state, batt.BT_RATE)
        if rate != 0xFFFFFFFF {
            have = true
        } else {
            rate = 0
        }
    }
    if have {
        kstate.set(state, pm(PM_RATE), rate)
        kstate.set(state, pm(PM_RATEOK), 1)
        kstate.set(state, pm(PM_UNIT), batt.value(state, batt.BT_UNIT))
        kstate.set(state, pm(PM_MINUTES), batt.minutes(state))
        if rate > kstate.get(state, pm(PM_MAXRATE)) {
            kstate.set(state, pm(PM_MAXRATE), rate)
        }
        let lo: u64 = kstate.get(state, pm(PM_MINRATE))
        if lo == 0 || rate < lo {
            kstate.set(state, pm(PM_MINRATE), rate)
        }
        if batt.ac_known(state) {
            if batt.ac_online(state) {
                kstate.set(state, pm(PM_ACRATE), rate)
                kstate.set(state, pm(PM_ACOK), 1)
            } else {
                kstate.set(state, pm(PM_BATRATE), rate)
                kstate.set(state, pm(PM_BATOK), 1)
            }
        }
        let full: u64 = batt.value(state, batt.BT_FULL)
        let design: u64 = batt.value(state, batt.BT_DESIGN)
        if full != 0 && design != 0 {
            var h: u64 = (full * 100) / design
            if h > 100 {
                h = 100
            }
            kstate.set(state, pm(PM_HEALTH), h)
            kstate.set(state, pm(PM_HEALTHOK), 1)
        }
        ring_push(state, rate, now)
        var b: u64 = pwbright.bright(state) / 10
        if b >= NBUCKET {
            b = NBUCKET - 1
        }
        kstate.add(state, bat(b) + PB_N * 8, 1)
        kstate.add(state, bat(b) + PB_SUM * 8, rate)
    } else {
        kstate.add(state, pm(PM_MISSES), 1)
        kstate.set(state, pm(PM_RATEOK), 0)
    }

    var busy: u64 = 0
    var idle: u64 = 0
    var t: u64 = 0
    while t < kstate.MAX_TASKS {
        if taskslot.tget(state, t, taskconst.T_STATE) != taskconst.S_FREE {
            let pid: u64 = taskslot.tget(state, t, taskconst.T_PID)
            if task_pid(state, t) != pid {
                task_clear(state, t, pid)
            }
            let cur: u64 = taskslot.tget(state, t, taskconst.T_TICKS)
            let seen: u64 = tget(state, t, PT_LAST)
            var d: u64 = 0
            if cur > seen {
                d = cur -% seen
            }
            tset(state, t, PT_LAST, cur)
            if taskslot.tget(state, t, taskconst.T_KIND) == taskconst.K_IDLE {
                idle = idle + d
                tset(state, t, PT_NOW, 0)
            } else {
                tadd(state, t, PT_NOW, d)
            }
        }
        busy = busy + tget(state, t, PT_NOW)
        t = t + 1
    }
    let orphan: u64 = kstate.get(state, pm(PM_ORPHAN))
    busy = busy + orphan
    kstate.set(state, pm(PM_BUSY), busy)
    kstate.set(state, pm(PM_IDLE), idle)

    if have && busy == 0 && (mode_word(state) & M_NOFLOOR) == 0 {
        kstate.add(state, pm(PM_BASESUM), rate)
        kstate.add(state, pm(PM_BASEN), 1)
        let n: u64 = kstate.get(state, pm(PM_BASEN))
        kstate.set(state, pm(PM_BASE),
            kstate.get(state, pm(PM_BASESUM)) / n)
        kstate.set(state, pm(PM_BASEOK), 1)
        let mn: u64 = kstate.get(state, pm(PM_BASEMIN))
        if mn == 0 || rate < mn {
            kstate.set(state, pm(PM_BASEMIN), rate)
        }
    }

    var base: u64 = 0
    if kstate.get(state, pm(PM_BASEOK)) != 0 {
        base = kstate.get(state, pm(PM_BASE))
    }
    if base > rate {
        base = rate
    }
    var attrib: u64 = 0
    if have {
        attrib = rate -% base
    }
    kstate.set(state, pm(PM_ATTRIB), attrib)
    if dt != 0 && have {
        var sys: u64 = base * dt
        if dt > busy {
            sys = sys + attrib * (dt -% busy)
        }
        kstate.add(state, pm(PM_SYSE), sys)
        if busy != 0 {
            kstate.add(state, pm(PM_WINDOWS), 1)
            var k: u64 = 0
            while k < kstate.MAX_TASKS {
                let d: u64 = tget(state, k, PT_NOW)
                if d != 0 {
                    tadd(state, k, PT_TICKS, d)
                    tadd(state, k, PT_DAYT, d)
                    tadd(state, k, PT_ENERGY, attrib * d)
                    tadd(state, k, PT_DAYE, attrib * d)
                    kstate.add(state, pm(PM_DEAD), attrib * d)
                    let r: u64 = prog_row(state, k)
                    kstate.add(state, prat(r) + PR_TICKS * 8, d)
                    kstate.add(state, prat(r) + PR_DAYT * 8, d)
                    kstate.add(state, prat(r) + PR_ENERGY * 8, attrib * d)
                    kstate.add(state, prat(r) + PR_DAYE * 8, attrib * d)
                }
                k = k + 1
            }
            var pr: u64 = 0
            while pr < NPROG {
                let d2: u64 = kstate.get(state, prat(pr) + PR_PEND * 8)
                if d2 != 0 {
                    kstate.add(state, prat(pr) + PR_TICKS * 8, d2)
                    kstate.add(state, prat(pr) + PR_DAYT * 8, d2)
                    kstate.add(state, prat(pr) + PR_ENERGY * 8, attrib * d2)
                    kstate.add(state, prat(pr) + PR_DAYE * 8, attrib * d2)
                    kstate.add(state, pm(PM_DEAD), attrib * d2)
                    kstate.set(state, prat(pr) + PR_PEND * 8, 0)
                }
                pr = pr + 1
            }
            kstate.set(state, pm(PM_ORPHAN), 0)
        }
    }
    var z: u64 = 0
    while z < kstate.MAX_TASKS {
        tset(state, z, PT_NOW, 0)
        z = z + 1
    }
}

fn flush(state: u64, t: u64) {
    if t >= kstate.MAX_TASKS || kstate.get(state, pm(PM_ON)) == 0 {
        return
    }
    if taskslot.tget(state, t, taskconst.T_KIND) == taskconst.K_IDLE {
        return
    }
    let cur: u64 = taskslot.tget(state, t, taskconst.T_TICKS)
    let seen: u64 = tget(state, t, PT_LAST)
    if cur <= seen {
        return
    }
    let d: u64 = cur -% seen
    tset(state, t, PT_LAST, cur)
    let r: u64 = prog_row(state, t)
    kstate.add(state, prat(r) + PR_PEND * 8, d)
    kstate.add(state, pm(PM_ORPHAN), d)
    kstate.add(state, pm(PM_ORPHANS), 1)
}

fn tick(state: u64) {
    if kstate.get(state, pm(PM_ON)) == 0 {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    let last: u64 = kstate.get(state, pm(PM_LASTTICK))
    let every: u64 = kstate.get(state, pm(PM_EVERY))
    if now < last + every {
        return
    }
    let t0: u64 = time.tsc()
    sample(state)
    let t1: u64 = time.tsc()
    if t1 > t0 {
        kstate.add(state, pm(PM_COST), t1 -% t0)
    }
    kstate.add(state, pm(PM_COSTN), 1)
}

fn roll_day(state: u64) {
    var t: u64 = 0
    while t < kstate.MAX_TASKS {
        tset(state, t, PT_DAYT, 0)
        tset(state, t, PT_DAYE, 0)
        t = t + 1
    }
    var r: u64 = 0
    while r < NPROG {
        kstate.set(state, prat(r) + PR_DAYT * 8, 0)
        kstate.set(state, prat(r) + PR_DAYE * 8, 0)
        r = r + 1
    }
    kstate.set(state, pm(PM_DAYSTART), kstate.get(state, kstate.TICKS))
    kstate.add(state, pm(PM_DAYS), 1)
}

fn reset_window(state: u64) {
    var t: u64 = 0
    while t < kstate.MAX_TASKS {
        tset(state, t, PT_TICKS, 0)
        tset(state, t, PT_ENERGY, 0)
        tset(state, t, PT_DAYT, 0)
        tset(state, t, PT_DAYE, 0)
        t = t + 1
    }
    var r: u64 = 0
    while r < NPROG {
        var f: u64 = 0
        while f < PRBYTES / 8 {
            kstate.set(state, prat(r) + f * 8, 0)
            f = f + 1
        }
        r = r + 1
    }
    var q: u64 = 0
    while q < kstate.MAX_TASKS {
        kstate.set(state, tat(q) + PT_ROW, 0)
        q = q + 1
    }
    kstate.set(state, pm(PM_DEAD), 0)
    kstate.set(state, pm(PM_SYSE), 0)
    kstate.set(state, pm(PM_WINDOWS), 0)
}

fn say(name: u64, v: u64) {
    var pre: [u8; 7] = "pmon: \0"
    var eq: [u8; 2] = "=\0"
    serial.puts((&pre[0]) as u64)
    serial.puts(name)
    serial.puts((&eq[0]) as u64)
    serial.dec(v)
    serial.nl()
}

fn report(state: u64) {
    if (mode_word(state) & M_SAY) == 0 {
        return
    }
    var n_on: [u8; 3] = "on\0"
    var n_sa: [u8; 8] = "samples\0"
    var n_ra: [u8; 5] = "rate\0"
    var n_ro: [u8; 7] = "rateok\0"
    var n_ba: [u8; 5] = "base\0"
    var n_bo: [u8; 7] = "baseok\0"
    var n_bn: [u8; 6] = "basen\0"
    var n_at: [u8; 7] = "attrib\0"
    var n_te: [u8; 7] = "proce\0\0"
    var n_se: [u8; 6] = "syse\0\0"
    var n_hz: [u8; 3] = "hz\0"
    var n_he: [u8; 7] = "health\0"
    var n_ho: [u8; 9] = "healthok\0"
    var n_mi: [u8; 8] = "minutes\0"
    var n_co: [u8; 5] = "cost\0"
    var n_cn: [u8; 6] = "costn\0"
    var n_ms: [u8; 7] = "misses\0"
    var n_wi: [u8; 8] = "windows\0"
    var n_bu: [u8; 5] = "busy\0"
    var n_id: [u8; 5] = "idle\0"
    var n_dy: [u8; 5] = "days\0"
    var n_or: [u8; 8] = "orphans\0"
    var n_un: [u8; 5] = "unit\0"
    say((&n_on[0]) as u64, kstate.get(state, pm(PM_ON)))
    say((&n_hz[0]) as u64, kstate.get(state, pm(PM_HZ)))
    say((&n_sa[0]) as u64, kstate.get(state, pm(PM_SAMPLES)))
    say((&n_ra[0]) as u64, kstate.get(state, pm(PM_RATE)))
    say((&n_ro[0]) as u64, kstate.get(state, pm(PM_RATEOK)))
    say((&n_ba[0]) as u64, kstate.get(state, pm(PM_BASE)))
    say((&n_bo[0]) as u64, kstate.get(state, pm(PM_BASEOK)))
    say((&n_bn[0]) as u64, kstate.get(state, pm(PM_BASEN)))
    say((&n_at[0]) as u64, kstate.get(state, pm(PM_ATTRIB)))
    say((&n_te[0]) as u64, kstate.get(state, pm(PM_DEAD)))
    say((&n_se[0]) as u64, kstate.get(state, pm(PM_SYSE)))
    say((&n_he[0]) as u64, kstate.get(state, pm(PM_HEALTH)))
    say((&n_ho[0]) as u64, kstate.get(state, pm(PM_HEALTHOK)))
    say((&n_mi[0]) as u64, kstate.get(state, pm(PM_MINUTES)))
    say((&n_co[0]) as u64, kstate.get(state, pm(PM_COST)))
    say((&n_cn[0]) as u64, kstate.get(state, pm(PM_COSTN)))
    say((&n_ms[0]) as u64, kstate.get(state, pm(PM_MISSES)))
    say((&n_wi[0]) as u64, kstate.get(state, pm(PM_WINDOWS)))
    say((&n_bu[0]) as u64, kstate.get(state, pm(PM_BUSY)))
    say((&n_id[0]) as u64, kstate.get(state, pm(PM_IDLE)))
    say((&n_dy[0]) as u64, kstate.get(state, pm(PM_DAYS)))
    say((&n_or[0]) as u64, kstate.get(state, pm(PM_ORPHANS)))
    say((&n_un[0]) as u64, kstate.get(state, pm(PM_UNIT)))
    var t: u64 = 0
    while t < kstate.MAX_TASKS {
        if tget(state, t, PT_TICKS) != 0 {
            var pre: [u8; 8] = "pmon: t\0"
            var sep: [u8; 2] = " \0"
            serial.puts((&pre[0]) as u64)
            serial.dec(t)
            serial.puts((&sep[0]) as u64)
            serial.dec(task_pid(state, t))
            serial.puts((&sep[0]) as u64)
            serial.dec(tget(state, t, PT_TICKS))
            serial.puts((&sep[0]) as u64)
            serial.dec(tget(state, t, PT_ENERGY))
            serial.puts((&sep[0]) as u64)
            var i: u64 = 0
            while i < NAME_MAX && name_at(state, t, i) != 0 {
                serial.put(name_at(state, t, i) as u8)
                i = i + 1
            }
            if i == 0 {
                var dash: [u8; 2] = "-\0"
                serial.puts((&dash[0]) as u64)
            }
            serial.nl()
        }
        t = t + 1
    }
    var r: u64 = 0
    while r < NPROG {
        if prog_used(state, r) {
            var pp: [u8; 8] = "pmon: p\0"
            var sp: [u8; 2] = " \0"
            serial.puts((&pp[0]) as u64)
            serial.dec(r)
            serial.puts((&sp[0]) as u64)
            serial.dec(prog_get(state, r, PR_TICKS))
            serial.puts((&sp[0]) as u64)
            serial.dec(prog_get(state, r, PR_ENERGY))
            serial.puts((&sp[0]) as u64)
            serial.dec(prog_get(state, r, PR_PROCS))
            serial.puts((&sp[0]) as u64)
            var j: u64 = 0
            while j < NAME_MAX && prog_name_at(state, r, j) != 0 {
                serial.put(prog_name_at(state, r, j) as u8)
                j = j + 1
            }
            serial.nl()
        }
        r = r + 1
    }
}
