import lib.kstate
import acpi.acpi
import serial

export { shutdown, halt_forever, acpi_off, acpi_reset, off_reason,
         reset_reason, s5_values, EXIT_OK, EXIT_TRAP }

const EXIT_OK: u8 = 10
const EXIT_TRAP: u8 = 31

const DEBUG_EXIT: u16 = 0xF4

fn shutdown(code: u8) {
    asm("out dx, al", in("dx") DEBUG_EXIT, in("al") code)
    halt_forever()
}

fn halt_forever() {
    asm("cli")
    while true {
        asm("hlt")
    }
}

fn off_reason(state: u64) -> u64 {
    return kstate.get(state, kstate.K13_OFF + kstate.U_ACPI)
}

const F_LENGTH: u64 = 4
const F_PM1A_CNT: u64 = 64
const F_PM1B_CNT: u64 = 68
const F_FADT_MIN: u64 = 72

const SLP_EN: u64 = 8192

fn out16(port: u64, v: u64) {
    asm("out dx, ax", in("dx") port as u16, in("ax") v as u16)
}

fn out8(port: u64, v: u64) {
    asm("out dx, al", in("dx") port as u16, in("al") v as u8)
}

const DSDT_HEADER: u64 = 36
const DSDT_MAX: u64 = 0x100000
const S5_TAIL: u64 = 24

fn s5_values(state: u64, dsdt: u64, out: u64) -> bool {
    if dsdt == 0 {
        return false
    }
    if !acpi.readable(state, dsdt, DSDT_HEADER) {
        return false
    }
    let len: u64 = kstate.get32(dsdt + 4)
    if len < DSDT_HEADER + S5_TAIL || len > DSDT_MAX {
        return false
    }
    if !acpi.readable(state, dsdt, len) {
        return false
    }
    var p: u64 = dsdt + DSDT_HEADER
    let end: u64 = dsdt + len - S5_TAIL
    while p < end {
        if kstate.get8(p) == 0x5F && kstate.get8(p + 1) == 0x53 &&
            kstate.get8(p + 2) == 0x35 && kstate.get8(p + 3) == 0x5F {
            var q: u64 = p + 4
            if kstate.get8(q) != 0x12 {
                return false
            }
            q = q + 1
            let lead: u64 = kstate.get8(q)
            q = q + 1 + ((lead >> 6) & 3)
            q = q + 1
            var a: u64 = 0
            var b: u64 = 0
            if kstate.get8(q) == 0x0A {
                a = kstate.get8(q + 1)
                q = q + 2
            } else {
                a = kstate.get8(q) & 7
                q = q + 1
            }
            if kstate.get8(q) == 0x0A {
                b = kstate.get8(q + 1)
            } else {
                b = kstate.get8(q) & 7
            }
            __mmio_write64(out as *mut u64, a)
            __mmio_write64((out + 8) as *mut u64, b)
            return true
        }
        p = p + 1
    }
    return false
}

const C_OK: u64 = 1192
const C_PM1A: u64 = 1200
const C_PM1B: u64 = 1208
const C_TYPA: u64 = 1216
const C_TYPB: u64 = 1224

fn acpi_off(state: u64) -> bool {
    var w_facp: [u8; 5] = "FACP\0"
    var s_try: [u8; 22] = "power: acpi pm1a=0x\0\0\0"
    var s_typ: [u8; 8] = " s5typ=\0"
    var s_no: [u8; 20] = "power: acpi off no \0"
    var s_ca: [u8; 22] = "power: acpi cached \0\0\0"
    kstate.set(state, kstate.K13_OFF + kstate.U_ACPI, 0)
    var pm1a: u64 = 0
    var pm1b: u64 = 0
    var vals: [u64; 2] = [0 as u64; 2]
    var why: u64 = 0
    let fadt: u64 = acpi.table(state, (&w_facp[0]) as u64)
    if fadt == 0 || kstate.get32(fadt + F_LENGTH) < F_FADT_MIN {
        why = 2
    } else {
        pm1a = kstate.get32(fadt + F_PM1A_CNT)
        pm1b = kstate.get32(fadt + F_PM1B_CNT)
        if pm1a == 0 {
            why = 4
        }
        if why == 0 && !s5_values(state, acpi.dsdt(state), (&vals[0]) as u64) {
            why = 3
        }
    }
    if why != 0 {
        let cok: u64 = kstate.get(state, kstate.ACPIEV_OFF + C_OK)
        let cpa: u64 = kstate.get(state, kstate.ACPIEV_OFF + C_PM1A)
        if cok == 1 && cpa != 0 {
            pm1a = cpa
            pm1b = kstate.get(state, kstate.ACPIEV_OFF + C_PM1B)
            vals[0 as usize] = kstate.get(state, kstate.ACPIEV_OFF + C_TYPA)
            vals[1 as usize] = kstate.get(state, kstate.ACPIEV_OFF + C_TYPB)
            serial.puts((&s_ca[0]) as u64)
            serial.dec(why)
            serial.nl()
            why = 0
        }
    }
    if why != 0 {
        kstate.set(state, kstate.K13_OFF + kstate.U_ACPI, why)
        serial.puts((&s_no[0]) as u64)
        serial.dec(why)
        serial.nl()
        return false
    }
    kstate.set(state, kstate.K13_OFF + kstate.U_ACPI, 1)
    serial.puts((&s_try[0]) as u64)
    serial.hex(pm1a)
    serial.puts((&s_typ[0]) as u64)
    serial.dec(vals[0 as usize])
    serial.nl()
    out16(pm1a, ((vals[0 as usize] & 7) << 10) | SLP_EN)
    if pm1b != 0 {
        out16(pm1b, ((vals[1 as usize] & 7) << 10) | SLP_EN)
    }
    var spin: u64 = 0
    while spin < 100000 {
        asm("pause")
        spin = spin + 1
    }
    return false
}

const F_FLAGS: u64 = 112
const F_RESET_REG: u64 = 116
const F_RESET_VAL: u64 = 128
const FL_RESET_SUP: u64 = 1024
const GAS_MEM: u64 = 0
const GAS_IO: u64 = 1
const MAX_PORT: u64 = 0xFFFF
const CF9: u64 = 0xCF9
const KBD_CMD: u64 = 0x64
const KBD_RESET: u64 = 0xFE

fn reset_reason(state: u64) -> u64 {
    return kstate.get(state, kstate.K13_OFF + kstate.U_RESET)
}

fn short_wait() {
    var spin: u64 = 0
    while spin < 2000000 {
        asm("pause")
        spin = spin + 1
    }
}

fn reset_via_fadt(state: u64, fadt: u64) {
    var s_r1: [u8; 24] = "power: reset fadt reg=\0\0"
    var s_v: [u8; 7] = " wert=\0"
    let len: u64 = kstate.get32(fadt + F_LENGTH)
    let flags: u64 = kstate.get32(fadt + F_FLAGS)
    if len < F_RESET_VAL + 1 || (flags & FL_RESET_SUP) == 0 {
        return
    }
    let space: u64 = kstate.get8(fadt + F_RESET_REG)
    let addr: u64 = __mmio_read64((fadt + F_RESET_REG + 4) as *mut u64)
    let val: u64 = kstate.get8(fadt + F_RESET_VAL)
    if addr == 0 {
        return
    }
    if space == GAS_IO && addr > MAX_PORT {
        return
    }
    if space == GAS_MEM && !acpi.readable(state, addr, 1) {
        return
    }
    if space != GAS_IO && space != GAS_MEM {
        return
    }
    kstate.set(state, kstate.K13_OFF + kstate.U_RESET, 1)
    serial.puts((&s_r1[0]) as u64)
    serial.hex(addr)
    serial.puts((&s_v[0]) as u64)
    serial.dec(val)
    serial.nl()
    if space == GAS_IO {
        out8(addr, val)
    } else {
        kstate.set8(addr, val as u8)
    }
    short_wait()
}

fn acpi_reset(state: u64) -> bool {
    var w_facp: [u8; 5] = "FACP\0"
    var s_r2: [u8; 22] = "power: reset 0xCF9\0\0\0\0"
    var s_r3: [u8; 22] = "power: reset 8042\0\0\0\0\0"
    kstate.set(state, kstate.K13_OFF + kstate.U_RESET, 0)
    let fadt: u64 = acpi.table(state, (&w_facp[0]) as u64)
    if fadt != 0 {
        reset_via_fadt(state, fadt)
    }
    kstate.set(state, kstate.K13_OFF + kstate.U_RESET, 2)
    serial.puts((&s_r2[0]) as u64)
    serial.nl()
    out8(CF9, 2)
    out8(CF9, 6)
    short_wait()
    kstate.set(state, kstate.K13_OFF + kstate.U_RESET, 3)
    serial.puts((&s_r3[0]) as u64)
    serial.nl()
    out8(KBD_CMD, KBD_RESET)
    short_wait()
    return false
}
