profile kernel

import sched.time

export { sleep_begin, sleep_end, sleep_cycles }

const MAX_CPUS: u64 = 8

static mut slept: [u64; 8] = [0 as u64; 8]

fn sleep_begin() -> u64 {
    return time.tsc()
}

fn sleep_end(me: u64, began: u64) {
    if me >= MAX_CPUS {
        return
    }
    let now: u64 = time.tsc()
    if now > began {
        slept[me as usize] = slept[me as usize] + (now - began)
    }
}

fn sleep_cycles(me: u64) -> u64 {
    if me >= MAX_CPUS {
        return 0
    }
    return slept[me as usize]
}
