profile kernel

export {
    set, get, add, clear_resume, outcome, ABSENT, FAILED, DONE,
    ATTEMPTS, CYCLES, RESULT, WAKE_STS, RTC_SECS, RTC_ARMED, SLEPT_S, DURATION_MS,
    CORES_BEFORE, CORES_AFTER, NVME_RESUME, AHCI_RESUME, USB_RESUME, USB_DEVICES,
    USB_KBD, NET_CARDS, NET_RESUMED, NET_UP, HDA_RESUME, USBNET_UP, UPLINK_KIND,
    PCI_LOST, PCI_BAD, IMAGE_BACK
}

const CELLS: u64 = 32

const ABSENT: u64 = 0
const FAILED: u64 = 1
const DONE: u64 = 2

const ATTEMPTS: u64 = 0
const CYCLES: u64 = 1
const RESULT: u64 = 2
const WAKE_STS: u64 = 3
const RTC_SECS: u64 = 4
const RTC_ARMED: u64 = 5
const SLEPT_S: u64 = 6
const DURATION_MS: u64 = 7
const CORES_BEFORE: u64 = 8
const CORES_AFTER: u64 = 9
const NVME_RESUME: u64 = 10
const AHCI_RESUME: u64 = 11
const USB_RESUME: u64 = 12
const USB_DEVICES: u64 = 13
const USB_KBD: u64 = 14
const NET_CARDS: u64 = 15
const NET_RESUMED: u64 = 16
const NET_UP: u64 = 17
const HDA_RESUME: u64 = 18
const USBNET_UP: u64 = 19
const UPLINK_KIND: u64 = 20
const PCI_LOST: u64 = 21
const PCI_BAD: u64 = 22
const IMAGE_BACK: u64 = 23

static mut cells: [u64; 32] = [0 as u64; 32]

fn set(key: u64, value: u64) {
    if key < CELLS {
        cells[key as usize] = value
    }
}

fn get(key: u64) -> u64 {
    if key < CELLS {
        return cells[key as usize]
    }
    return 0
}

fn add(key: u64, value: u64) {
    set(key, get(key) + value)
}

fn outcome(present: bool, ok: bool) -> u64 {
    if !present {
        return ABSENT
    }
    if ok {
        return DONE
    }
    return FAILED
}

fn clear_resume() {
    var key: u64 = NVME_RESUME
    while key <= USBNET_UP {
        set(key, 0)
        key = key + 1
    }
}
