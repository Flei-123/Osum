profile kernel

import lib.procw

export {
    raw, add, set, get, render,
    RAW_N, RAW_E0, RAW_E1, KBD_IRQ, KBD_GHOST, KBD_RESCUE, KBD_STATUS, KBD_STATUS_OR, SCI_IRQS, SCI_SHARED, SCI_WAKE, SCI_EVENTS, GPE_ARMED, GPE_FIRED, NOTIFY_N, NOTIFY_LAST, EC_FOUND, EC_DATA, EC_CMD, EC_GPE, EC_STATUS, EC_POLLS, EC_SCI, EC_QUERIES, EC_LASTQ, EC_QRUN, EC_QMISSING, EC_ERRORS, EC_REG, EC_READS, EC_WRITES, WMI_DEVICES, HPQ_DEVICES, I2CHID_DEVICES, EC_DISABLED
}

const RAW_N: u64 = 0
const RAW_E0: u64 = 1
const RAW_E1: u64 = 2
const KBD_IRQ: u64 = 3
const KBD_GHOST: u64 = 4
const KBD_RESCUE: u64 = 5
const KBD_STATUS: u64 = 6
const KBD_STATUS_OR: u64 = 7
const SCI_IRQS: u64 = 8
const SCI_SHARED: u64 = 9
const SCI_WAKE: u64 = 10
const SCI_EVENTS: u64 = 11
const GPE_ARMED: u64 = 12
const GPE_FIRED: u64 = 13
const NOTIFY_N: u64 = 14
const NOTIFY_LAST: u64 = 15
const EC_FOUND: u64 = 16
const EC_DATA: u64 = 17
const EC_CMD: u64 = 18
const EC_GPE: u64 = 19
const EC_STATUS: u64 = 20
const EC_POLLS: u64 = 21
const EC_SCI: u64 = 22
const EC_QUERIES: u64 = 23
const EC_LASTQ: u64 = 24
const EC_QRUN: u64 = 25
const EC_QMISSING: u64 = 26
const EC_ERRORS: u64 = 27
const EC_REG: u64 = 28
const EC_READS: u64 = 29
const EC_WRITES: u64 = 30
const WMI_DEVICES: u64 = 31
const HPQ_DEVICES: u64 = 32
const I2CHID_DEVICES: u64 = 33
const EC_DISABLED: u64 = 34

const SLOTS: u64 = 35
const RAW_RING: u64 = 24

static mut vals: [u64; 35] = [0 as u64; 35]
static mut ring: [u64; 24] = [0 as u64; 24]
static mut ring_n: u64 = 0

fn add(slot: u64, n: u64) {
    if slot < SLOTS {
        vals[slot as usize] = vals[slot as usize] + n
    }
}

fn set(slot: u64, v: u64) {
    if slot < SLOTS {
        vals[slot as usize] = v
    }
}

fn get(slot: u64) -> u64 {
    if slot < SLOTS {
        return vals[slot as usize]
    }
    return 0
}

fn raw(code: u64) {
    ring[(ring_n % RAW_RING) as usize] = code & 0xFF
    ring_n = ring_n + 1
    vals[RAW_N as usize] = vals[RAW_N as usize] + 1
    if code == 0xE0 {
        vals[RAW_E0 as usize] = vals[RAW_E0 as usize] + 1
    }
    if code == 0xE1 {
        vals[RAW_E1 as usize] = vals[RAW_E1 as usize] + 1
    }
}

fn pair(name: u64, slot: u64, hex: bool) {
    procw.put_c(32)
    procw.put_s(name)
    procw.put_c(61)
    if hex {
        procw.put_hex(vals[slot as usize], 4)
    } else {
        procw.put_dec(vals[slot as usize])
    }
}

fn render() {
    var g_kbd: [u8; 4] = "kbd\0"
    var kbd_raw: [u8; 4] = "raw\0"
    var kbd_e0: [u8; 3] = "e0\0"
    var kbd_e1: [u8; 3] = "e1\0"
    var kbd_irq: [u8; 4] = "irq\0"
    var kbd_ghost: [u8; 6] = "ghost\0"
    var kbd_rescue: [u8; 7] = "rescue\0"
    var kbd_st: [u8; 3] = "st\0"
    var kbd_stor: [u8; 5] = "stor\0"
    var g_sci: [u8; 4] = "sci\0"
    var sci_irq: [u8; 4] = "irq\0"
    var sci_shared: [u8; 7] = "shared\0"
    var sci_wake: [u8; 5] = "wake\0"
    var sci_events: [u8; 7] = "events\0"
    var sci_gpe_armed: [u8; 10] = "gpe_armed\0"
    var sci_gpe_fired: [u8; 10] = "gpe_fired\0"
    var sci_notify: [u8; 7] = "notify\0"
    var sci_last: [u8; 5] = "last\0"
    var g_ec: [u8; 3] = "ec\0"
    var ec_found: [u8; 6] = "found\0"
    var ec_data: [u8; 5] = "data\0"
    var ec_cmd: [u8; 4] = "cmd\0"
    var ec_gpe: [u8; 4] = "gpe\0"
    var ec_st: [u8; 3] = "st\0"
    var ec_polls: [u8; 6] = "polls\0"
    var ec_sci: [u8; 4] = "sci\0"
    var ec_queries: [u8; 8] = "queries\0"
    var ec_lastq: [u8; 6] = "lastq\0"
    var ec_run: [u8; 4] = "run\0"
    var ec_missing: [u8; 8] = "missing\0"
    var ec_err: [u8; 4] = "err\0"
    var ec_reg: [u8; 4] = "reg\0"
    var ec_rd: [u8; 3] = "rd\0"
    var ec_wr: [u8; 3] = "wr\0"
    var g_hw: [u8; 3] = "hw\0"
    var hw_wmi: [u8; 4] = "wmi\0"
    var hw_hpq: [u8; 4] = "hpq\0"
    var hw_i2chid: [u8; 7] = "i2chid\0"
    var hw_noec: [u8; 5] = "noec\0"
    var g_raw: [u8; 5] = "raw:\0"
    procw.put_s((&g_kbd[0]) as u64)
    pair((&kbd_raw[0]) as u64, RAW_N, false)
    pair((&kbd_e0[0]) as u64, RAW_E0, false)
    pair((&kbd_e1[0]) as u64, RAW_E1, false)
    pair((&kbd_irq[0]) as u64, KBD_IRQ, false)
    pair((&kbd_ghost[0]) as u64, KBD_GHOST, false)
    pair((&kbd_rescue[0]) as u64, KBD_RESCUE, false)
    pair((&kbd_st[0]) as u64, KBD_STATUS, true)
    pair((&kbd_stor[0]) as u64, KBD_STATUS_OR, true)
    procw.put_c(10)
    procw.put_s((&g_raw[0]) as u64)
    var shown: u64 = ring_n
    if shown > RAW_RING {
        shown = RAW_RING
    }
    var i: u64 = 0
    while i < shown {
        procw.put_c(32)
        procw.put_hex(ring[((ring_n - shown + i) % RAW_RING) as usize], 2)
        i = i + 1
    }
    procw.put_c(10)
    procw.put_s((&g_sci[0]) as u64)
    pair((&sci_irq[0]) as u64, SCI_IRQS, false)
    pair((&sci_shared[0]) as u64, SCI_SHARED, false)
    pair((&sci_wake[0]) as u64, SCI_WAKE, false)
    pair((&sci_events[0]) as u64, SCI_EVENTS, false)
    pair((&sci_gpe_armed[0]) as u64, GPE_ARMED, false)
    pair((&sci_gpe_fired[0]) as u64, GPE_FIRED, false)
    pair((&sci_notify[0]) as u64, NOTIFY_N, false)
    pair((&sci_last[0]) as u64, NOTIFY_LAST, true)
    procw.put_c(10)
    procw.put_s((&g_ec[0]) as u64)
    pair((&ec_found[0]) as u64, EC_FOUND, false)
    pair((&ec_data[0]) as u64, EC_DATA, true)
    pair((&ec_cmd[0]) as u64, EC_CMD, true)
    pair((&ec_gpe[0]) as u64, EC_GPE, true)
    pair((&ec_st[0]) as u64, EC_STATUS, true)
    pair((&ec_polls[0]) as u64, EC_POLLS, false)
    pair((&ec_sci[0]) as u64, EC_SCI, false)
    pair((&ec_queries[0]) as u64, EC_QUERIES, false)
    pair((&ec_lastq[0]) as u64, EC_LASTQ, true)
    pair((&ec_run[0]) as u64, EC_QRUN, false)
    pair((&ec_missing[0]) as u64, EC_QMISSING, false)
    pair((&ec_err[0]) as u64, EC_ERRORS, false)
    pair((&ec_reg[0]) as u64, EC_REG, false)
    pair((&ec_rd[0]) as u64, EC_READS, false)
    pair((&ec_wr[0]) as u64, EC_WRITES, false)
    procw.put_c(10)
    procw.put_s((&g_hw[0]) as u64)
    pair((&hw_wmi[0]) as u64, WMI_DEVICES, false)
    pair((&hw_hpq[0]) as u64, HPQ_DEVICES, false)
    pair((&hw_i2chid[0]) as u64, I2CHID_DEVICES, false)
    pair((&hw_noec[0]) as u64, EC_DISABLED, false)
    procw.put_c(10)
}
