profile kernel

import lib.kstate
import lib.procw
import pwr.hotkeys
import serial
import bus.pci
import acpi.acpibl
import gfx.fb
import gfx.vmode

export {
    stage, set_percent, percent, step, on_notify, on_ext_key, on_key, hw_present, available, source, src_name,
    k_of, set_k, render, selftest, SRC_NONE, SRC_ACPI, SRC_PWM, SRC_EC, SRC_SOFT
}

const SRC_NONE: u64 = 0
const SRC_ACPI: u64 = 1
const SRC_PWM: u64 = 2
const SRC_EC: u64 = 3
const SRC_SOFT: u64 = 4

const PCH_CTL1: u64 = 0xC8250
const PCH_CTL2: u64 = 0xC8254
const CPU_CTL2: u64 = 0x61250
const CPU_CTL1: u64 = 0x61254
const LAY_NONE: u64 = 0
const LAY_PCH: u64 = 1
const LAY_CPU: u64 = 2

const MIN_PCT: u64 = 5
const STEP_PCT: u64 = 10
const MIN_PERIOD: u64 = 16
const MAX_FAILS: u64 = 3
const SOFT_FLOOR: u64 = 25
const GIB: u64 = 0x40000000

static mut c_stage: u64 = 0
static mut c_pwm_base: u64 = 0
static mut c_pwm_lay: u64 = LAY_NONE
static mut c_pwm_ok: u64 = 0
static mut c_pwm_period: u64 = 0
static mut c_pwm_fails: u64 = 0
static mut c_pwm_why: u64 = 0
static mut c_pwm_bdf: u64 = 0
static mut c_pwm_writes: u64 = 0
static mut c_lbb: u64 = 0xFFFF
static mut c_acpi_writes: u64 = 0
static mut c_acpi_noeffect: u64 = 0
static mut c_acpi_dead: u64 = 0
static mut c_soft_writes: u64 = 0
static mut c_src: u64 = SRC_NONE
static mut c_pct: u64 = 100
static mut c_keys: u64 = 0
static mut c_notify: u64 = 0
static mut c_changes: u64 = 0
static mut c_seeded: u64 = 0
static mut c_last_notify: u64 = 0
static mut c_fake: [u64; 128] = [0 as u64; 128]

// c_pwm_why: 0 = ok, 1 = no display device, 2 = BAR unusable, 3 = BAR not mapped, 4 = all-ones (device off/D3),
// 5 = not enabled or implausible period, 6 = disabled by test word, 7 = too many write failures
fn rd(off: u64) -> u64 {
    return kstate.get32(c_pwm_base + off)
}

fn wr(off: u64, v: u64) {
    __mmio_write32((c_pwm_base + off) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn ctl_en() -> u64 {
    if c_pwm_lay == LAY_PCH {
        return PCH_CTL1
    }
    return CPU_CTL2
}

fn ctl_val() -> u64 {
    if c_pwm_lay == LAY_PCH {
        return PCH_CTL2
    }
    return CPU_CTL1
}

fn plausible(en: u64, val: u64) -> bool {
    if en == 0xFFFFFFFF || val == 0xFFFFFFFF || val == 0 {
        return false
    }
    if (en >> 31) == 0 {
        return false
    }
    let period: u64 = val >> 16
    let duty: u64 = val & 0xFFFF
    if period < MIN_PERIOD || duty > period {
        return false
    }
    return true
}

fn fake_base() -> u64 {
    return ((&c_fake[0]) as u64) -% 0xC8000
}

fn fake_seed(lay: u64, bad: bool) {
    var i: u64 = 0
    while i < 128 {
        c_fake[i as usize] = 0
        i = i + 1
    }
    var period: u64 = 0x1388
    if bad {
        period = 0
    }
    let val: u64 = (period << 16) | (period * 6 / 10)
    if lay == LAY_PCH {
        __mmio_write32((((&c_fake[0]) as u64) + 0x250) as *mut u32, 0x80000000 as u32)
        __mmio_write32((((&c_fake[0]) as u64) + 0x254) as *mut u32, val as u32)
    } else {
        __mmio_write32((((&c_fake[0]) as u64) + 0x250) as *mut u32, 0x80000000 as u32)
        __mmio_write32((((&c_fake[0]) as u64) + 0x254) as *mut u32, val as u32)
    }
}

fn probe_layout() -> u64 {
    let en1: u64 = rd(PCH_CTL1)
    let v1: u64 = rd(PCH_CTL2)
    if plausible(en1, v1) {
        return LAY_PCH
    }
    let en2: u64 = rd(CPU_CTL2)
    let v2: u64 = rd(CPU_CTL1)
    if plausible(en2, v2) {
        return LAY_CPU
    }
    if en1 == 0xFFFFFFFF && v1 == 0xFFFFFFFF {
        c_pwm_why = 4
    } else {
        c_pwm_why = 5
    }
    return LAY_NONE
}

fn probe_pwm(state: u64) {
    c_pwm_ok = 0
    c_pwm_lay = LAY_NONE
    c_pwm_why = 1
    if kstate.mode_on(state, kstate.M_BLNONE) {
        c_pwm_why = 6
        return
    }
    if kstate.mode_on(state, kstate.M_BLPCH) || kstate.mode_on(state, kstate.M_BLCPU) {
        var lay: u64 = LAY_PCH
        if kstate.mode_on(state, kstate.M_BLCPU) {
            lay = LAY_CPU
        }
        fake_seed(lay, kstate.mode_on(state, kstate.M_BLBAD))
        if lay == LAY_PCH {
            c_pwm_base = fake_base()
        } else {
            c_pwm_base = ((&c_fake[0]) as u64) -% 0x61000
        }
        c_pwm_bdf = 0xFFFF
        c_pwm_lay = probe_layout()
        if c_pwm_lay != LAY_NONE {
            c_pwm_period = rd(ctl_val()) >> 16
            c_pwm_ok = 1
            c_pwm_why = 0
        }
        return
    }
    let n: u64 = pci.count(state)
    var i: u64 = 0
    while i < n {
        if pci.get(state, i, pci.E_VENDOR) == 0x8086 && pci.get(state, i, pci.E_CLASS) == 0x03 {
            let bar: u64 = pci.bar(state, i, 0)
            c_pwm_bdf = pci.get(state, i, pci.E_BDF)
            if bar == 0 || pci.bar_is_io(state, i, 0) || pci.bar_size(state, i, 0) < 0xC8260 {
                c_pwm_why = 2
                return
            }
            let base: u64 = bar & 0xFFFFFFFFFFFFFFF0
            let gib: u64 = kstate.get(state, kstate.MAPPED_GIB)
            if base + 0xC8260 > gib * GIB {
                c_pwm_why = 3
                return
            }
            c_pwm_base = base
            c_pwm_lay = probe_layout()
            c_lbb = pci.cfg_read16(c_pwm_bdf, 0xF4)
            if c_pwm_lay != LAY_NONE {
                c_pwm_period = rd(ctl_val()) >> 16
                c_pwm_ok = 1
                c_pwm_why = 0
            }
            return
        }
        i = i + 1
    }
}

fn pwm_pct() -> u64 {
    if c_pwm_ok == 0 || c_pwm_period == 0 {
        return 100
    }
    let duty: u64 = rd(ctl_val()) & 0xFFFF
    var p: u64 = (duty * 100 + c_pwm_period / 2) / c_pwm_period
    if p > 100 {
        p = 100
    }
    return p
}

fn pwm_set(pct: u64) -> bool {
    if c_pwm_ok == 0 {
        return false
    }
    let cur: u64 = rd(ctl_val())
    let en: u64 = rd(ctl_en())
    if !plausible(en, cur) {
        c_pwm_fails = c_pwm_fails + 1
        if c_pwm_fails >= MAX_FAILS {
            c_pwm_ok = 0
            c_pwm_why = 7
        }
        return false
    }
    let period: u64 = cur >> 16
    var p: u64 = pct
    if p > 100 {
        p = 100
    }
    if p < MIN_PCT {
        p = MIN_PCT
    }
    var duty: u64 = (period * p + 50) / 100
    if duty < 1 {
        duty = 1
    }
    let nv: u64 = (period << 16) | duty
    wr(ctl_val(), nv)
    c_pwm_writes = c_pwm_writes + 1
    if rd(ctl_val()) != nv {
        wr(ctl_val(), cur)
        c_pwm_fails = c_pwm_fails + 1
        if c_pwm_fails >= MAX_FAILS {
            c_pwm_ok = 0
            c_pwm_why = 7
        }
        return false
    }
    return true
}

fn soft_set(state: u64, pct: u64) -> bool {
    if !fb.ready(state) {
        return false
    }
    var p: u64 = pct
    if p > 100 {
        p = 100
    }
    let b: u64 = SOFT_FLOOR + p * (100 - SOFT_FLOOR) / 100
    if !vmode.set_picture(state, b, 100, 100) {
        return false
    }
    if b == 100 {
        fb.set_lut(state, 0)
    } else {
        fb.set_lut(state, vmode.lut_addr(state))
    }
    fb.dirty_all(state)
    fb.flush(state)
    c_soft_writes = c_soft_writes + 1
    return true
}

fn hw_present() -> bool {
    return (acpibl.ready() && c_acpi_dead == 0) || c_pwm_ok == 1
}

fn available(state: u64) -> bool {
    return hw_present() || fb.ready(state)
}

fn source() -> u64 {
    return c_src
}

fn src_name(s: u64) -> u64 {
    return s
}

fn percent(state: u64) -> u64 {
    if c_src == SRC_PWM && c_pwm_ok == 1 {
        return pwm_pct()
    }
    if c_src == SRC_ACPI && acpibl.ready() {
        return acpibl.percent(state)
    }
    return c_pct
}

fn set_percent(state: u64, pct: u64) -> u64 {
    let src: u64 = apply_percent(state, pct)
    if src != SRC_NONE {
        c_changes = c_changes + 1
    }
    return src
}

fn apply_percent(state: u64, pct: u64) -> u64 {
    var p: u64 = pct
    if p > 100 {
        p = 100
    }
    if p < MIN_PCT {
        p = MIN_PCT
    }
    if acpibl.ready() && c_acpi_dead == 0 {
        let before: u64 = pwm_pct()
        if acpibl.set_percent(state, p) {
            c_acpi_writes = c_acpi_writes + 1
            var moved: bool = true
            if c_pwm_ok == 1 {
                let after: u64 = pwm_pct()
                var d: u64 = 0
                if after > before {
                    d = after - before
                } else {
                    d = before - after
                }
                var want: u64 = 0
                if p > before {
                    want = p - before
                } else {
                    want = before - p
                }
                if want >= 20 && d < 5 {
                    moved = false
                }
            }
            if moved {
                c_src = SRC_ACPI
                c_pct = p
                return SRC_ACPI
            }
            c_acpi_noeffect = c_acpi_noeffect + 1
            if c_acpi_noeffect >= 2 {
                c_acpi_dead = 1
            }
        }
    }
    if pwm_set(p) {
        c_src = SRC_PWM
        c_pct = p
        return SRC_PWM
    }
    if soft_set(state, p) {
        c_src = SRC_SOFT
        c_pct = p
        return SRC_SOFT
    }
    return SRC_NONE
}

fn k_of(state: u64) -> u64 {
    return percent(state) * 2
}

fn set_k(state: u64, k: u64) -> u64 {
    var p: u64 = k / 2
    if p > 100 {
        p = 100
    }
    return set_percent(state, p)
}

fn step(state: u64, up: bool) -> bool {
    var cur: u64 = percent(state)
    var nx: u64 = cur
    if up {
        nx = cur + STEP_PCT
        if nx > 100 {
            nx = 100
        }
    } else {
        if cur > STEP_PCT + MIN_PCT {
            nx = cur - STEP_PCT
        } else {
            nx = MIN_PCT
        }
    }
    return set_percent(state, nx) != SRC_NONE
}

fn apply_action(state: u64, act: u64) -> bool {
    if act == hotkeys.ACT_UP {
        return step(state, true)
    }
    if act == hotkeys.ACT_DOWN {
        return step(state, false)
    }
    if act == hotkeys.ACT_MIN {
        return set_percent(state, MIN_PCT) != SRC_NONE
    }
    if act == hotkeys.ACT_CYCLE {
        if percent(state) >= 100 {
            return set_percent(state, MIN_PCT) != SRC_NONE
        }
        return step(state, true)
    }
    return false
}

fn on_notify(state: u64, code: u64) -> bool {
    let act: u64 = hotkeys.notify_action(state, code)
    if act == hotkeys.ACT_NONE {
        return false
    }
    c_notify = c_notify + 1
    c_last_notify = code
    if !hotkeys.accept(state, hotkeys.SRC_NOTIFY) {
        return true
    }
    return apply_action(state, act)
}

fn on_key(state: u64, ext: bool, code: u64) -> bool {
    let act: u64 = hotkeys.key_action(state, ext, code)
    if act == hotkeys.ACT_NONE {
        return false
    }
    c_keys = c_keys + 1
    if !hotkeys.accept(state, hotkeys.SRC_KEY) {
        return true
    }
    return apply_action(state, act)
}

fn on_ext_key(state: u64, code: u64) -> bool {
    return on_key(state, true, code)
}

fn stage(state: u64) {
    var s_a: [u8; 13] = "blchain: src\0"
    var s_b: [u8; 9] = " pct=\0\0\0\0"
    c_stage = 1
    c_src = SRC_NONE
    c_pwm_fails = 0
    probe_pwm(state)
    if acpibl.ready() {
        c_src = SRC_ACPI
    } else if c_pwm_ok == 1 {
        c_src = SRC_PWM
    }
    if c_pwm_ok == 1 {
        c_pct = pwm_pct()
        if acpibl.ready() && !acpibl.has_query() {
            acpibl.seed(c_pct)
            c_seeded = 1
        }
    }
    serial.puts((&s_a[0]) as u64)
    serial.dec(c_src)
    serial.puts((&s_b[0]) as u64)
    serial.dec(percent(state))
    var s_c: [u8; 8] = " pwm=\0\0\0"
    serial.puts((&s_c[0]) as u64)
    serial.dec(c_pwm_ok)
    var s_d: [u8; 8] = " why=\0\0\0"
    serial.puts((&s_d[0]) as u64)
    serial.dec(c_pwm_why)
    var s_e: [u8; 8] = " lay=\0\0\0"
    serial.puts((&s_e[0]) as u64)
    serial.dec(c_pwm_lay)
    serial.nl()
}

fn render(state: u64, out: u64, cap: u64) -> u64 {
    var k_src: [u8; 8] = "source\0\0"
    var k_pct: [u8; 8] = "percent\0"
    var k_ok: [u8; 8] = "hw.any\0\0"
    var k_acpi: [u8; 10] = "acpi.bcm\0\0"
    var k_aw: [u8; 12] = "acpi.writes\0"
    var k_an: [u8; 14] = "acpi.noeffect\0"
    var k_ad: [u8; 10] = "acpi.dead\0"
    var k_av: [u8; 12] = "acpi.levels\0"
    var k_pok: [u8; 8] = "pwm.ok\0\0"
    var k_pw: [u8; 8] = "pwm.why\0"
    var k_pl: [u8; 8] = "pwm.lay\0"
    var k_pp: [u8; 11] = "pwm.period\0"
    var k_pv: [u8; 9] = "pwm.duty\0"
    var k_pe: [u8; 11] = "pwm.enable\0"
    var k_pf: [u8; 10] = "pwm.fails\0"
    var k_pwr: [u8; 11] = "pwm.writes\0"
    var k_pb: [u8; 8] = "pwm.bdf\0"
    var k_lbb: [u8; 8] = "pci.lbb\0"
    var k_ec: [u8; 9] = "ec.state\0"
    var k_sw: [u8; 12] = "soft.writes\0"
    var k_ky: [u8; 8] = "hotkeys\0"
    var k_nt: [u8; 14] = "acpi.notifies\0"
    var k_nl: [u8; 12] = "acpi.lastnt\0"
    var k_e0: [u8; 10] = "ext.count\0"
    var k_e1: [u8; 10] = "ext.last0\0"
    var k_e2: [u8; 10] = "ext.last1\0"
    var k_e3: [u8; 10] = "ext.last2\0"
    var k_e4: [u8; 10] = "ext.last3\0"
    var k_chg: [u8; 8] = "changes\0"
    var k_sd: [u8; 12] = "acpi.seeded\0"
    procw.begin(out, cap)
    procw.line_num((&k_src[0]) as u64, c_src)
    procw.line_num((&k_pct[0]) as u64, percent(state))
    var any: u64 = 0
    if hw_present() {
        any = 1
    }
    procw.line_num((&k_ok[0]) as u64, any)
    var bc: u64 = 0
    if acpibl.ready() {
        bc = 1
    }
    procw.line_num((&k_acpi[0]) as u64, bc)
    procw.line_num((&k_av[0]) as u64, acpibl.levels())
    procw.line_num((&k_aw[0]) as u64, c_acpi_writes)
    procw.line_num((&k_an[0]) as u64, c_acpi_noeffect)
    procw.line_num((&k_ad[0]) as u64, c_acpi_dead)
    procw.line_num((&k_pok[0]) as u64, c_pwm_ok)
    procw.line_num((&k_pw[0]) as u64, c_pwm_why)
    procw.line_num((&k_pl[0]) as u64, c_pwm_lay)
    procw.line_hex((&k_pb[0]) as u64, c_pwm_bdf, 4)
    procw.line_num((&k_pp[0]) as u64, c_pwm_period)
    if c_pwm_ok == 1 {
        procw.line_num((&k_pv[0]) as u64, rd(ctl_val()) & 0xFFFF)
        procw.line_hex((&k_pe[0]) as u64, rd(ctl_en()), 8)
    }
    procw.line_num((&k_pf[0]) as u64, c_pwm_fails)
    procw.line_num((&k_pwr[0]) as u64, c_pwm_writes)
    procw.line_hex((&k_lbb[0]) as u64, c_lbb, 4)
    procw.line_num((&k_ec[0]) as u64, 0)
    procw.line_num((&k_sw[0]) as u64, c_soft_writes)
    procw.line_num((&k_ky[0]) as u64, c_keys)
    procw.line_num((&k_nt[0]) as u64, c_notify)
    procw.line_hex((&k_nl[0]) as u64, c_last_notify, 2)
    procw.line_num((&k_e0[0]) as u64, hotkeys.unknown_count())
    procw.line_hex((&k_e1[0]) as u64, hotkeys.unknown_last(0), 2)
    procw.line_hex((&k_e2[0]) as u64, hotkeys.unknown_last(1), 2)
    procw.line_hex((&k_e3[0]) as u64, hotkeys.unknown_last(2), 2)
    procw.line_hex((&k_e4[0]) as u64, hotkeys.unknown_last(3), 2)
    procw.line_num((&k_chg[0]) as u64, c_changes)
    procw.line_num((&k_sd[0]) as u64, c_seeded)
    return procw.used()
}

fn selftest(state: u64) {
    var s_a: [u8; 16] = "blchain: test p\0"
    var s_b: [u8; 7] = " src=\0\0"
    var s_c: [u8; 7] = " back=\0"
    var s_d: [u8; 14] = "blchain: done\0"
    var s_e: [u8; 15] = "blchain: key u\0"
    var s_f: [u8; 15] = "blchain: key d\0"
    var s_g: [u8; 16] = "blchain: ext u\0\0"
    var tests: [u64; 4] = [0 as u64; 4]
    tests[0] = 100
    tests[1] = 50
    tests[2] = 0
    tests[3] = 100
    var i: u64 = 0
    while i < 4 {
        let src: u64 = set_percent(state, tests[i as usize])
        serial.puts((&s_a[0]) as u64)
        serial.dec(tests[i as usize])
        serial.puts((&s_b[0]) as u64)
        serial.dec(src)
        serial.puts((&s_c[0]) as u64)
        serial.dec(percent(state))
        serial.nl()
        i = i + 1
    }
    set_percent(state, 50)
    on_notify(state, 0x86)
    serial.puts((&s_e[0]) as u64)
    serial.dec(percent(state))
    serial.nl()
    on_notify(state, 0x87)
    on_notify(state, 0x87)
    serial.puts((&s_f[0]) as u64)
    serial.dec(percent(state))
    serial.nl()
    hotkeys.forget_last()
    on_ext_key(state, 0x6F)
    serial.puts((&s_g[0]) as u64)
    serial.dec(percent(state))
    serial.nl()
    set_percent(state, 100)
    serial.puts((&s_d[0]) as u64)
    serial.nl()
}
