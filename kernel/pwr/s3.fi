
import lib.kstate
import serial
import sched.susp
import drv.wdt.wdt
import arch.arch
import mm.mmframe
import bus.pci
import arch.x86_64.apic
import arch.x86_64.idt
import gfx.gfx
import arch.cpu
import arch.x86_64.smp
import pwr.s3dev
import sched.time
import libc.regio

export { stage, stage_smp, suspend, R_OK_S3, R_NOS3, R_SMP, R_NOMEM_S3, R_NOWAKE, R_PARK, R_RESUME }

const V_S3: u64 = 75

const C_WOKE: u64 = 0xD8
const C_STAGE: u64 = 0x120

const F_SMI_CMD: u64 = 48
const F_ACPI_ENABLE: u64 = 52
const F_PM1A_EVT: u64 = 56
const F_PM1B_EVT: u64 = 60
const FACS_WAKE: u64 = 12
const FACS_XWAKE: u64 = 24

const SLP_EN: u64 = 0x2000
const SLP_TYP_MASK: u64 = 0x1C00
const SCI_EN: u64 = 1
const WAK_STS: u64 = 0x8000

const PCI_WORDS: u64 = 24
const BUF_FRAMES: u64 = 3

fn vec(state: u64, i: u64) -> u64 {
    let table: u64 = __mmio_read64((kstate.get(state, kstate.VECTORS) + V_S3 * 8) as *mut u64)
    return __mmio_read64((table + i * 8) as *mut u64)
}

fn put(buf: u64, i: u64, v: u64) {
    __mmio_write64((buf + i * 8) as *mut u64, v)
}

fn get(buf: u64, i: u64) -> u64 {
    return __mmio_read64((buf + i * 8) as *mut u64)
}

fn kv(t: u64, v: u64) {
    serial.puts(t)
    serial.dec(v)
}

fn kx(t: u64, v: u64) {
    serial.puts(t)
    serial.hex(v)
}

fn drain() {
    let b: u64 = serial.port() as u64
    var spin: u64 = 0
    while spin < 2000000 {
        if (arch.dev_in8((b + 5) as u16) as u64 & 0x40) != 0 {
            return
        }
        spin = spin + 1
    }
}

fn rotl(x: u64, n: u64) -> u64 {
    return (x << n) | (x >> (64 - n))
}

fn fill(frame: u64, seed: u64) {
    var i: u64 = 0
    var x: u64 = seed
    while i < 512 {
        x = rotl(x, 13) ^ (i << 17) ^ 0x5DEECE66D
        put(frame, i, x)
        i = i + 1
    }
}

fn sum(frame: u64) -> u64 {
    var i: u64 = 0
    var h: u64 = 0
    while i < 512 {
        h = rotl(h, 5) +% (get(frame, i) ^ i)
        i = i + 1
    }
    return h
}

fn pci_save(state: u64, buf: u64) -> u64 {
    var n: u64 = pci.count(state)
    if n > pci.MAX_DEV {
        n = pci.MAX_DEV
    }
    var i: u64 = 0
    while i < n {
        let e: u64 = buf + i * PCI_WORDS * 8
        let bdf: u64 = pci.get(state, i, pci.E_BDF)
        put(e, 0, bdf)
        var d: u64 = 1
        while d < 16 {
            put(e, d, pci.cfg_read32(bdf, d * 4))
            d = d + 1
        }
        let msi: u64 = pci.cap_find(bdf, pci.CAP_MSI)
        put(e, 16, msi)
        if msi != 0 {
            let ctl: u64 = pci.cfg_read16(bdf, msi + 2)
            put(e, 17, ctl)
            put(e, 18, pci.cfg_read32(bdf, msi + 4))
            if (ctl & 0x80) != 0 {
                put(e, 19, pci.cfg_read32(bdf, msi + 8))
                put(e, 20, pci.cfg_read16(bdf, msi + 12))
            } else {
                put(e, 19, 0)
                put(e, 20, pci.cfg_read16(bdf, msi + 8))
            }
        }
        i = i + 1
    }
    return n
}

fn pci_lost(state: u64, buf: u64, n: u64) -> u64 {
    var lost: u64 = 0
    var i: u64 = 0
    while i < n {
        let e: u64 = buf + i * PCI_WORDS * 8
        let bdf: u64 = get(e, 0)
        var d: u64 = 4
        while d < 10 {
            if pci.cfg_read32(bdf, d * 4) != get(e, d) {
                lost = lost + 1
            }
            d = d + 1
        }
        if (pci.cfg_read16(bdf, 4) & 0x7) != (get(e, 1) & 0x7) {
            lost = lost + 1
        }
        i = i + 1
    }
    return lost
}

fn pci_restore(state: u64, buf: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < n {
        let e: u64 = buf + i * PCI_WORDS * 8
        let bdf: u64 = get(e, 0)
        var d: u64 = 15
        while d >= 2 {
            pci.cfg_write32(bdf, d * 4, get(e, d))
            d = d - 1
        }
        let msi: u64 = get(e, 16)
        if msi != 0 {
            let ctl: u64 = get(e, 17)
            pci.cfg_write32(bdf, msi + 4, get(e, 18))
            if (ctl & 0x80) != 0 {
                pci.cfg_write32(bdf, msi + 8, get(e, 19))
                pci.cfg_write16(bdf, msi + 12, get(e, 20))
            } else {
                pci.cfg_write16(bdf, msi + 8, get(e, 20))
            }
            pci.cfg_write16(bdf, msi + 2, ctl)
        }
        pci.cfg_write16(bdf, 4, get(e, 1) & 0xFFFF)
        i = i + 1
    }
    var bad: u64 = 0
    i = 0
    while i < n {
        let e: u64 = buf + i * PCI_WORDS * 8
        let bdf: u64 = get(e, 0)
        var d: u64 = 4
        while d < 10 {
            if pci.cfg_read32(bdf, d * 4) != get(e, d) {
                bad = bad + 1
            }
            d = d + 1
        }
        if (pci.cfg_read16(bdf, 4) & 0x7) != (get(e, 1) & 0x7) {
            bad = bad + 1
        }
        i = i + 1
    }
    return bad
}

fn write_slp(port: u64, typ: u64) {
    if port == 0 {
        return
    }
    let cur: u64 = arch.dev_in16((port & 0xFFFF) as u16) as u64
    let v: u64 = (cur & (0xFFFF ^ (SLP_TYP_MASK | SLP_EN))) | ((typ & 7) << 10)
    arch.dev_out16((port & 0xFFFF) as u16, (v & 0xFFFF) as u16)
    arch.dev_out16((port & 0xFFFF) as u16, ((v | SLP_EN) & 0xFFFF) as u16)
}

fn clear_wak(port: u64) {
    if port != 0 {
        arch.dev_out16((port & 0xFFFF) as u16, WAK_STS as u16)
    }
}

const DISPI_IDX: u64 = 0x1CE
const DISPI_DAT: u64 = 0x1CF
const W_VBE: u64 = 500
const W_KBC: u64 = 510

fn dispi_rd(i: u64) -> u64 {
    arch.dev_out16(DISPI_IDX as u16, i as u16)
    return arch.dev_in16(DISPI_DAT as u16) as u64
}

fn dispi_wr(i: u64, v: u64) {
    arch.dev_out16(DISPI_IDX as u16, i as u16)
    arch.dev_out16(DISPI_DAT as u16, (v & 0xFFFF) as u16)
}

fn vbe_save(buf: u64) {
    let id: u64 = dispi_rd(0)
    if id < 0xB0C0 || id > 0xB0CF || (dispi_rd(4) & 1) == 0 {
        put(buf, W_VBE, 0)
        return
    }
    put(buf, W_VBE, 1)
    var i: u64 = 1
    while i <= 9 {
        put(buf, W_VBE + i, dispi_rd(i))
        i = i + 1
    }
}

fn vbe_restore(buf: u64) -> u64 {
    if get(buf, W_VBE) == 0 {
        return 0
    }
    dispi_wr(4, 0)
    var i: u64 = 1
    while i <= 9 {
        if i != 4 {
            dispi_wr(i, get(buf, W_VBE + i))
        }
        i = i + 1
    }
    dispi_wr(4, get(buf, W_VBE + 4) | 0x80)
    return 1
}

fn kbc_wait_in() -> bool {
    var i: u64 = 0
    while i < 1000000 {
        if (arch.dev_in8(0x64 as u16) as u64 & 2) == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn kbc_wait_out() -> bool {
    var i: u64 = 0
    while i < 1000000 {
        if (arch.dev_in8(0x64 as u16) as u64 & 1) != 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn kbc_save(buf: u64) {
    put(buf, W_KBC, 0)
    var n: u64 = 0
    while n < 16 && (arch.dev_in8(0x64 as u16) as u64 & 1) != 0 {
        arch.dev_in8(0x60 as u16)
        n = n + 1
    }
    if !kbc_wait_in() {
        return
    }
    arch.dev_out8(0x64 as u16, 0x20 as u8)
    if !kbc_wait_out() {
        return
    }
    put(buf, W_KBC + 1, arch.dev_in8(0x60 as u16) as u64)
    put(buf, W_KBC, 1)
}

fn kbc_restore(buf: u64) -> u64 {
    if get(buf, W_KBC) == 0 {
        return 0
    }
    let cb: u64 = get(buf, W_KBC + 1)
    if !kbc_wait_in() {
        return 0
    }
    arch.dev_out8(0x64 as u16, 0x60 as u8)
    if !kbc_wait_in() {
        return 0
    }
    arch.dev_out8(0x60 as u16, cb as u8)
    if (cb & 0x20) == 0 {
        if kbc_wait_in() {
            arch.dev_out8(0x64 as u16, 0xA8 as u8)
        }
        if kbc_wait_in() {
            arch.dev_out8(0x64 as u16, 0xD4 as u8)
        }
        if kbc_wait_in() {
            arch.dev_out8(0x60 as u16, 0xF4 as u8)
        }
        if kbc_wait_out() {
            arch.dev_in8(0x60 as u16)
        }
    }
    return 1
}

fn cycle(state: u64, nr: u64, broken: bool, buf: u64, frame: u64) -> bool {
    var s_sl: [u8; 18] = "s3: sleep cycle=\0\0"
    var s_wa: [u8; 17] = "s3: wake cycle=\0\0"
    var s_wo: [u8; 7] = " woke=\0"
    var s_st: [u8; 8] = " stage=\0"
    var s_ng: [u8; 35] = "s3: sleep had no effect (SLP_EN)\0\0\0"
    var s_mem: [u8; 19] = "s3: memory same=\0\0\0"
    var s_su: [u8; 6] = " sum=\0"
    var s_pci: [u8; 17] = "s3: pci devices=\0"
    var s_lo: [u8; 8] = " lost=\0\0"
    var s_ba: [u8; 15] = " wrong-after=\0\0"
    var s_ap: [u8; 16] = "s3: apic lines=\0"
    var s_sci: [u8; 13] = "s3: sci vor=\0"
    var s_na: [u8; 8] = " nach=\0\0"
    var s_ta: [u8; 14] = "s3: duration \0"
    var s_bi: [u8; 15] = "s3: bildmodus=\0"
    var s_kb: [u8; 7] = " 8042=\0"
    var s_dv: [u8; 15] = " dispi-vorher=\0"
    var s_dn: [u8; 12] = " nach-wach=\0"
    var s_dd: [u8; 9] = " danach=\0"
    var s_vo: [u8; 7] = " vor=\0\0"
    var s_ti: [u8; 22] = "s3: ticks in 200 ms=\0\0"
    var s_aus: [u8; 4] = "aus\0"
    var s_tv: [u8; 14] = " vorher-ges=\0\0"
    var s_w5: [u8; 5] = " w5=\0"
    var s_ms: [u8; 4] = " ms\0"

    let fadt: u64 = susp.fadt(state)
    let facs: u64 = susp.facs(state)
    let pm1a: u64 = susp.pm1a(state)
    let pm1b: u64 = susp.pm1b(state)
    let evta: u64 = regio.read32(fadt + F_PM1A_EVT)
    let evtb: u64 = regio.read32(fadt + F_PM1B_EVT)
    let ctx: u64 = vec(state, 3)

    fill(frame, 0xC0FFEE00 + nr)
    let before: u64 = sum(frame)
    let npci: u64 = pci_save(state, buf + 0x1000)
    let napic: u64 = apic.s3_save(state, buf)
    let sci_before: u64 = arch.dev_in16((pm1a & 0xFFFF) as u16) as u64 & SCI_EN
    let imr1: u64 = arch.dev_in8(0x21 as u16) as u64
    let imr2: u64 = arch.dev_in8(0xA1 as u16) as u64

    let blob: u64 = vec(state, 0)
    let blob_end: u64 = vec(state, 1)
    let base: u64 = vec(state, 2)
    var i: u64 = 0
    while i < blob_end - blob {
        kstate.set8(base + i, kstate.get8(blob + i) as u8)
        i = i + 1
    }
    if broken {
        kstate.set8(base, 0xF4 as u8)
    }
    __mmio_write64((ctx + C_WOKE) as *mut u64, 0)
    __mmio_write32((facs + FACS_WAKE) as *mut u32, base as u32)
    if susp.facs_len(state) >= 32 {
        __mmio_write64((facs + FACS_XWAKE) as *mut u64, 0)
    }

    serial.puts((&s_sl[0]) as u64)
    serial.dec(nr)
    serial.nl()
    drain()
    let t0: u64 = apic.tsc()

    var fl: u64 = 0
    asm("pushfq; pop rax", out("rax") & fl)
    let if_on: bool = (fl & 0x200) != 0
    let ticks_before: u64 = kstate.get(state, kstate.TICKS)
    s3dev.prepare(state)
    time.suspend_mark(state)
    asm("cli")
    vbe_save(buf)
    kbc_save(buf)
    var rc: u64 = 0
    let save: u64 = vec(state, 4)
    asm("call rax", in("rax") save, in("rdi") ctx, out("rax") & rc,
        clobber("memory"))
    if rc == 0 {
        asm("wbinvd")
        clear_wak(evta)
        clear_wak(evtb)
        write_slp(pm1a, susp.s3_a(state))
        write_slp(pm1b, susp.s3_b(state))
        var spin: u64 = 0
        while spin < 50000000 {
            asm("pause")
            spin = spin + 1
        }
        serial.puts((&s_ng[0]) as u64)
        serial.nl()
        return false
    }

    serial.init()
    let t1: u64 = apic.tsc()
    serial.puts((&s_wa[0]) as u64)
    serial.dec(nr)
    serial.puts((&s_wo[0]) as u64)
    serial.dec(__mmio_read64((ctx + C_WOKE) as *mut u64))
    serial.puts((&s_st[0]) as u64)
    serial.dec(__mmio_read64((ctx + C_STAGE) as *mut u64))
    serial.nl()

    idt.pic_remap()
    idt.pic_mask(imr1 as u8, imr2 as u8)
    let apic_bad: u64 = apic.s3_restore(state, buf)
    serial.puts((&s_ap[0]) as u64)
    serial.dec(napic)
    serial.puts((&s_ba[0]) as u64)
    serial.dec(apic_bad)
    serial.nl()

    var s_uh: [u8; 19] = "s3: clock sleep=\0\0\0"
    var s_us: [u8; 5] = " s\0\0\0"
    let slept: u64 = time.resume_fix(state)
    serial.puts((&s_uh[0]) as u64)
    serial.dec(slept)
    serial.puts((&s_us[0]) as u64)
    serial.nl()

    let lost: u64 = pci_lost(state, buf + 0x1000, npci)
    let pci_bad: u64 = pci_restore(state, buf + 0x1000, npci)
    serial.puts((&s_pci[0]) as u64)
    serial.dec(npci)
    serial.puts((&s_lo[0]) as u64)
    serial.dec(lost)
    serial.puts((&s_ba[0]) as u64)
    serial.dec(pci_bad)
    serial.nl()

    var image: u64 = 0
    let dispi_after: u64 = dispi_rd(4)
    if gfx.ready(state) {
        gfx.shadow_inval(state)
    }
    if !kstate.mode_on(state, kstate.M_S3NOBILD) {
        image = vbe_restore(buf)
        if image != 0 && gfx.ready(state) {
            gfx.dirty_all(state)
            gfx.flush(state)
        }
    }
    let kbc: u64 = kbc_restore(buf)
    serial.puts((&s_bi[0]) as u64)
    serial.dec(image)
    serial.puts((&s_kb[0]) as u64)
    serial.dec(kbc)
    serial.puts((&s_dv[0]) as u64)
    serial.hex(get(buf, W_VBE + 4))
    serial.puts((&s_dn[0]) as u64)
    serial.hex(dispi_after)
    serial.puts((&s_dd[0]) as u64)
    serial.hex(dispi_rd(4) & 0x7F)
    serial.nl()

    let sci_after: u64 = arch.dev_in16((pm1a & 0xFFFF) as u16) as u64 & SCI_EN
    if sci_before != 0 && sci_after == 0 {
        let smi: u64 = regio.read32(fadt + F_SMI_CMD)
        let en: u64 = kstate.get8(fadt + F_ACPI_ENABLE)
        if smi != 0 && en != 0 {
            arch.dev_out8((smi & 0xFFFF) as u16, en as u8)
            var w: u64 = 0
            while w < 1000000 && (arch.dev_in16((pm1a & 0xFFFF) as u16) as u64 & SCI_EN) == 0 {
                w = w + 1
            }
        }
    }
    serial.puts((&s_sci[0]) as u64)
    serial.dec(sci_before)
    serial.puts((&s_na[0]) as u64)
    serial.dec(arch.dev_in16((pm1a & 0xFFFF) as u16) as u64 & SCI_EN)
    serial.nl()

    let after: u64 = sum(frame)
    serial.puts((&s_mem[0]) as u64)
    if after == before {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_su[0]) as u64)
    serial.hex(after)
    serial.puts((&s_vo[0]) as u64)
    serial.hex(before)
    serial.puts((&s_w5[0]) as u64)
    serial.hex(get(frame, 5))
    serial.nl()

    let hz: u64 = apic.tsc_hz(state)
    serial.puts((&s_ti[0]) as u64)
    if if_on {
        asm("sti")
        let k0: u64 = kstate.get(state, kstate.TICKS)
        let c0: u64 = apic.tsc()
        var w2: u64 = 0
        while w2 < 400000000 {
            if hz != 0 && apic.tsc() - c0 > hz / 5 {
                w2 = 400000000
            }
            asm("pause")
            w2 = w2 + 1
        }
        serial.dec(kstate.get(state, kstate.TICKS) - k0)
    } else {
        serial.puts((&s_aus[0]) as u64)
    }
    serial.puts((&s_tv[0]) as u64)
    serial.dec(ticks_before)
    serial.nl()
    if hz != 0 && t1 > t0 {
        serial.puts((&s_ta[0]) as u64)
        serial.dec((t1 - t0) / (hz / 1000))
        serial.puts((&s_ms[0]) as u64)
        serial.nl()
    }
    s3dev.resume(state, kstate.mode_on(state, kstate.M_S3LOSS))
    return true
}

const R_OK_S3: u64 = 0
const R_NOS3: u64 = 1
const R_SMP: u64 = 2
const R_NOMEM_S3: u64 = 3
const R_NOWAKE: u64 = 4
const R_PARK: u64 = 5
const R_RESUME: u64 = 6

fn cores_report(state: u64, tag: u64) {
    var s_k: [u8; 11] = "s3: kern \0\0"
    var s_on: [u8; 9] = " online=\0"
    var s_ti: [u8; 8] = " ticks=\0"
    var s_id: [u8; 7] = " idle=\0"
    var s_sw: [u8; 5] = " sw=\0"
    var s_ta: [u8; 2] = " \0"
    let n: u64 = cpu.count(state)
    var i: u64 = 0
    while i < n {
        serial.puts((&s_k[0]) as u64)
        serial.puts(tag)
        serial.puts((&s_ta[0]) as u64)
        serial.dec(i)
        serial.puts((&s_on[0]) as u64)
        if cpu.online(state, i) {
            serial.dec(1)
        } else {
            serial.dec(0)
        }
        serial.puts((&s_ti[0]) as u64)
        serial.dec(cpu.get(state, i, cpu.C_TICKS))
        serial.puts((&s_id[0]) as u64)
        serial.dec(cpu.get(state, i, cpu.C_IDLERUNS))
        serial.puts((&s_sw[0]) as u64)
        serial.dec(cpu.get(state, i, cpu.C_SWITCHES))
        serial.nl()
        i = i + 1
    }
}

fn suspend(state: u64) -> u64 {
    if !susp.ready(state) {
        susp.measure(state)
    }
    if !susp.s3_ok(state) || susp.facs(state) == 0 || susp.pm1a(state) == 0 {
        return R_NOS3
    }
    let buf: u64 = mmframe.frame_run(state, BUF_FRAMES)
    if buf == 0 {
        return R_NOMEM_S3
    }
    let frame: u64 = mmframe.frame_run(state, 1)
    if frame == 0 {
        mmframe.frame_free_run(state, buf, BUF_FRAMES)
        return R_NOMEM_S3
    }
    var s_vor: [u8; 5] = "vor\0\0"
    var s_nach: [u8; 7] = "nach\0\0\0"
    var s_pk: [u8; 26] = "s3: cores parked online=\0\0"
    var s_pn: [u8; 24] = "s3: cores not parked\0\0\0\0"
    var s_wk: [u8; 24] = "s3: cores back online=\0\0"
    let multi: bool = cpu.online_count(state) > 1
    let cores: u64 = cpu.count(state)
    if multi {
        cores_report(state, (&s_vor[0]) as u64)
        if !smp.park_all(state) {
            serial.puts((&s_pn[0]) as u64)
            serial.nl()
            mmframe.frame_free_run(state, buf, BUF_FRAMES)
            mmframe.frame_free_run(state, frame, 1)
            return R_PARK
        }
        serial.puts((&s_pk[0]) as u64)
        serial.dec(cpu.online_count(state))
        serial.nl()
    }
    let n: u64 = kstate.get(state, kstate.TICKS)
    wdt.pause(state)
    let back: bool = cycle(state, n, false, buf, frame)
    wdt.resume(state)
    mmframe.frame_free_run(state, buf, BUF_FRAMES)
    mmframe.frame_free_run(state, frame, 1)
    var res: u64 = R_NOWAKE
    if back {
        res = R_OK_S3
    }
    if multi {
        var up: u64 = cpu.online_count(state)
        if !kstate.mode_on(state, kstate.M_S3NOSTART) {
            up = smp.unpark_all(state)
        }
        serial.puts((&s_wk[0]) as u64)
        serial.dec(up)
        serial.nl()
        if back && up != cores {
            res = R_RESUME
        }
        let hz: u64 = apic.tsc_hz(state)
        let c0: u64 = apic.tsc()
        var w: u64 = 0
        while w < 400000000 {
            if hz != 0 && apic.tsc() - c0 > hz * 3 / 10 {
                w = 400000000
            }
            asm("pause")
            w = w + 1
        }
        cores_report(state, (&s_nach[0]) as u64)
    }
    return res
}

fn stage(state: u64) {
    let one: bool = kstate.mode_on(state, kstate.M_S3)
    let two: bool = kstate.mode_on(state, kstate.M_S3_SECOND)
    let broken: bool = kstate.mode_on(state, kstate.M_S3_BROKEN)
    if !one && !two && !broken && !kstate.mode_on(state, kstate.M_S3NOBILD) {
        return
    }
    var s_hd: [u8; 12] = "s3: fadt=\0\0\0"
    var s_fc: [u8; 7] = " facs=\0"
    var s_pa: [u8; 7] = " pm1a=\0"
    var s_pb: [u8; 7] = " pm1b=\0"
    var s_ty: [u8; 7] = " slp3=\0"
    var s_sl: [u8; 2] = "/\0"
    var s_no: [u8; 21] = "s3: geht nicht why=\0\0"
    var s_bl: [u8; 10] = " blob=\0\0\0\0"
    var s_en: [u8; 12] = "s3: fertig\0\0"
    var s_bs: [u8; 18] = "s3: image stands\0\0"

    if !susp.ready(state) {
        susp.measure(state)
    }
    serial.puts((&s_hd[0]) as u64)
    serial.hex(susp.fadt(state))
    serial.puts((&s_fc[0]) as u64)
    serial.hex(susp.facs(state))
    serial.puts((&s_pa[0]) as u64)
    serial.hex(susp.pm1a(state))
    serial.puts((&s_pb[0]) as u64)
    serial.hex(susp.pm1b(state))
    serial.puts((&s_ty[0]) as u64)
    serial.dec(susp.s3_a(state))
    serial.puts((&s_sl[0]) as u64)
    serial.dec(susp.s3_b(state))
    serial.puts((&s_bl[0]) as u64)
    serial.dec(vec(state, 1) - vec(state, 0))
    serial.nl()
    if !susp.s3_ok(state) || susp.facs(state) == 0 || susp.pm1a(state) == 0 {
        serial.puts((&s_no[0]) as u64)
        susp.why_name(susp.why(state))
        serial.nl()
        return
    }
    let buf: u64 = mmframe.frame_run(state, BUF_FRAMES)
    let frame: u64 = mmframe.frame_run(state, 1)
    if buf == 0 || frame == 0 {
        serial.puts((&s_no[0]) as u64)
        serial.dec(0)
        serial.nl()
        return
    }
    var n: u64 = 1
    if two {
        n = 2
    }
    var k: u64 = 1
    while k <= n {
        if !cycle(state, k, broken, buf, frame) {
            k = n
        }
        k = k + 1
    }
    mmframe.frame_free_run(state, buf, BUF_FRAMES)
    mmframe.frame_free_run(state, frame, 1)
    if gfx.ready(state) {
        serial.puts((&s_bs[0]) as u64)
        serial.nl()
        let hz: u64 = apic.tsc_hz(state)
        let c0: u64 = apic.tsc()
        var w: u64 = 0
        while w < 3000000000 {
            if hz != 0 && apic.tsc() - c0 > hz * 3 {
                w = 3000000000
            }
            asm("pause")
            w = w + 1
        }
    }
    serial.puts((&s_en[0]) as u64)
    serial.nl()
}

fn stage_smp(state: u64) {
    if !kstate.mode_on(state, kstate.M_S3SMP) {
        return
    }
    var s_z: [u8; 17] = "s3: smp zyklus=\0\0"
    var s_r: [u8; 6] = " rc=\0\0"
    let hz: u64 = apic.tsc_hz(state)
    var k: u64 = 1
    while k <= 3 {
        asm("sti")
        let c0: u64 = apic.tsc()
        var w: u64 = 0
        while w < 400000000 {
            if hz != 0 && apic.tsc() - c0 > hz * 3 / 10 {
                w = 400000000
            }
            asm("pause")
            w = w + 1
        }
        let r: u64 = suspend(state)
        serial.puts((&s_z[0]) as u64)
        serial.dec(k)
        serial.puts((&s_r[0]) as u64)
        serial.dec(r)
        serial.nl()
        k = k + 1
    }
}
