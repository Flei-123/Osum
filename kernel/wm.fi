// kernel/wm.fi -- Runde K10: der Fensterserver.
//
// Runde K7 gab Osum einen Bildschirm: 800x600 Bildpunkte, eine
// Textkonsole darauf, und `/dev/fb` fuer Ring 3. Sie endete mit einem
// zugegebenen Mangel, und der steht woertlich in `kernel/fb.fi`:
//
//     "Der Preis ist benannt: die Konsole uebertraegt ihre geaenderten
//      Zeilen aus dem Zweitpuffer und uebermalt dabei, was ein Programm
//      in dieselben Zeilen gelegt hat. Zwei Zeichner auf einer Flaeche
//      vertragen sich, solange sie verschiedene Zeilen nehmen. Ein
//      Fenstersystem waere die Antwort darauf und ist nicht diese Runde."
//
// Diese Runde ist es.
//
// WAS EIN FENSTERSERVER WIRKLICH IST, und es sind vier Dinge:
//
//   1. EINE FLAECHE JE ANWENDUNG. Ein Fenster ist ein Speicherbereich,
//      den die Anwendung bemalt und den der Server auf den Schirm
//      zusammensetzt. Die Anwendung sieht den Bildschirm NICHT; sie
//      sieht ihr Rechteck, und sie kann nicht danebenschreiben.
//   2. EINE STAPELREIHENFOLGE. Fenster verdecken einander, und wer oben
//      liegt, gewinnt. Das entscheidet der Server, nicht der Zeichner.
//   3. EIN EINGABEFOKUS. Genau EIN Fenster bekommt die Tastatur. Ohne
//      das tippt man in alle Fenster gleichzeitig -- die Gegenprobe
//      `nofocus` schaltet es ab und muss den Test zum Einsturz bringen.
//   4. NUR DAS NEUE MALEN. Ein Zeiger, der ueber den Schirm faehrt,
//      aendert zwei kleine Rechtecke. Wer dafuer 1,9 MB neu
//      zusammensetzt, hat eine Oberflaeche, die man nicht bedienen kann.
//      Die Bereichsverfolgung ist deshalb keine Feinheit, sondern das,
//      was den Unterschied ausmacht -- gemessen in docs/ROUNDK10.md,
//      und `nodirty` schaltet sie ab, damit die Zahl etwas bedeutet.
//
// WO DER SERVER LAEUFT. Im Kernel. Das ist eine Entscheidung und keine
// Bequemlichkeit, und sie gehoert benannt: ein Fensterserver in Ring 3
// braucht eine Nachrichtenschicht, die Speicher zwischen Prozessen
// TEILT (der Fensterpuffer muss in zwei Adressraeumen liegen), und die
// hat dieser Kernel nicht -- `mmap` kennt anonyme Seiten und den
// Rahmenpuffer, sonst nichts. Ihn hierhin zu legen kostet den Schutz
// zwischen Server und Anwendung; er kostet NICHT den Schutz zwischen den
// Anwendungen, und das ist der, um den es beim Fenstern geht. Der Weg
// nach Ring 3 fuehrt ueber ein Speicherobjekt, das zwei Prozesse
// abbilden koennen; das ist die naechste Runde und steht so in der Doku.
//
// WIE ANWENDUNGEN MIT IHM REDEN: ueber HANDLES aus `kernel/cap.fi`, wie
// die Aufgabe es verlangt, und nicht ueber einen zweiten Weg. Ein
// Fenster ist ein `K_CHANNEL` mit Rechten; wer es nicht hat, hat kein
// Fenster. `R_WRITE` malt, `R_READ` holt Ereignisse, `R_MANAGE`
// verschiebt und schliesst. Ein Handle aus einem anderen Prozess faellt
// am Wuerfelwert der Tabelle, und ein geschlossenes faellt an der
// Generation -- beides hat Runde K6 gebaut und wird hier nur benutzt.
//
// DIE ARITHMETIK-FALLE. Fensterkoordinaten werden negativ, sobald ein
// Fenster ueber den linken Rand geschoben wird, und Ueberschneidungen
// sind Differenzen von Differenzen. Dieses Modul rechnet Rechtecke
// deshalb in `i64` und schneidet ERST beim Zeichnen auf den Bildschirm
// zurecht. Wo ein Bitmuster gemeint ist (Farben), steht `u64`.

profile kernel

import kstate
import mem
import fb
import ttf
import ps2m
import arch.arch
import tile

export {
    init, ready, compose, damage, damage_all, dirty_x0, dirty_y0,
    dirty_x1, dirty_y1,
    create, destroy, valid, count, focus, set_focus, raise_win,
    move_win, resize_win, win_x, win_y, win_w, win_h, win_z, win_buf,
    win_owner, win_kind, win_id, outer_w, outer_h,
    win_layer, set_layer, win_hidden, set_hidden, win_deco, set_deco,
    win_title, by_id, hides, shows, top_visible, deko, inx, iny,
    set_nolayer, set_nomin, nolayer, nomin,
    set_strut, win_strut_edge, win_strut_size, work_x, work_y, work_w,
    work_h, recalc_work, maximize, is_max, struts, workcalcs,
    set_nostrut, nostrut,
    fill, text, blit_in, flush_win, hit,
    ev_push, ev_pop, ev_waiting,
    on_mouse, on_key, term_write, term_out, term_cols, term_rows, term_cx, term_cy,
    bind_tty, key_tty, tty_of, NO_TTY,
    poll, composites, blits, pixels, last_us, cursor_on, set_cursor,
    shape, set_shape,
    downs, moves_seen, hits_seen, win_keys,
    set_fonts, font_ui, font_mono, px_ui, px_mono,
    selftest, selftest_max,
    tile_on, set_tile_on, tile_take, tile_release, tile_apply,
    tile_node, tile_float, tile_snap, tile_action, hotkeys, hotkeys_seen,
    on_screen_resize, win_tabbed, tiled,
    MAX_WIN, K_RAW, K_TERM, TITLE_H, BORDER, GRIP, MAX_W, MAX_H,
    E_KEY, E_DOWN, E_UP, E_MOVE, E_CLOSE, E_FOCUS, E_RESIZE,
    L_DESK, L_NORMAL, L_TOP, F_HIDDEN, F_NODECO, F_TABBED,
    EDGE_BOTTOM, EDGE_TOP, EDGE_LEFT, EDGE_RIGHT, F_MAXIMIZED
}

// ------------------------------------------------------- die Zahlen

// RUNDE DESKTOP: SECHZEHN STATT ACHT, und die Zahl ist keine Laune.
// Ein Schreibtisch (1) mit einer Taskleiste (1), dem Starter (1), dem
// Datei-Explorer samt Kontextmenue und Dialog (3) und den
// Einstellungen samt Dialog (2) sind ACHT Fenster -- das neunte bekam
// -E_EXHAUSTED. Mit sechzehn passen Fenstertafel (0x1000) und
// Ereignisringe (0x2000) nicht mehr in die zwei Seiten von WM_OFF;
// beide liegen deshalb in `kstate.DSK_OFF` (0x54000..0x58000), dem
// Vorrat dieser Runde. In WM_OFF stehen nur noch die Skalare.
const MAX_WIN: u64 = 16
const WIN_BYTES: u64 = 512
const W_OFF: u64 = 0x0 // die Fenstertafel, Versatz IN kstate.DSK_OFF
const EV_OFF: u64 = 0x2000 // die Ereignisringe, ebenfalls in DSK_OFF
const EV_SLOTS: u64 = 32
const EV_BYTES: u64 = 16
const EV_RING: u64 = 512 // EV_SLOTS * EV_BYTES

const TITLE_H: u64 = 22 // die Titelleiste
const BORDER: u64 = 2 // der Rand links, rechts und unten
const GRIP: u64 = 12 // das Feld unten rechts zum Groessenaendern
const CLOSE_W: u64 = 14

const K_RAW: u64 = 0 // die Anwendung malt selbst
const K_TERM: u64 = 1 // ein Zeichenraster, der Server malt

// ADDENDUM TASKBAR: the largest window this server will make. It is
// the screen, and it is exported because whoever wants a window that
// can be maximized to ANY work area has to ask for this size when the
// window is created -- the buffer is never reallocated.
const MAX_W: u64 = 800
const MAX_H: u64 = 600

// ------------------------------------------- RUNDE DESKTOP: die Ebenen
//
// DREI EBENEN, UND SIE SIND DER GRUND, WARUM ES EINEN SCHREIBTISCH
// GEBEN KANN. Bis zu dieser Runde war die Stapelreihenfolge EINE Kette:
// wer angeklickt wurde, kam nach ganz oben. Ein Hintergrundbild ist
// aber ein Fenster, das NIE nach oben darf, und eine Taskleiste ist ein
// Fenster, das IMMER oben bleiben muss -- beides ist in einer einzigen
// Kette nicht ausdrueckbar. Logbuch K15 hat genau das als "geht heute
// nicht" vermerkt.
//
// Die Ordnung ist jetzt zweistufig: erst die Ebene, dann innerhalb der
// Ebene die Reihenfolge. `raise_win` hebt ein Fenster nur bis an die
// Oberkante SEINER Ebene. Die Gegenprobe heisst `nolayer` und schaltet
// genau diese eine Zeile ab -- dann kommt der Schreibtisch beim ersten
// Klick nach vorn und verdeckt alles.
const L_DESK: u64 = 0 // der Schreibtisch, immer ganz hinten
const L_NORMAL: u64 = 1 // gewoehnliche Anwendungen
const L_TOP: u64 = 2 // die Taskleiste, immer ganz vorn

// Die Merkmale eines Fensters.
//   F_HIDDEN  minimiert: es wird nicht zusammengesetzt und nimmt keinen
//             Klick an. Es lebt weiter, sein Puffer bleibt.
//   F_NODECO  ohne Schmuck: kein Rahmen, keine Titelleiste, kein
//             Schliessfeld, kein Groessengriff. Schreibtisch und
//             Taskleiste sind so.
const F_HIDDEN: u64 = 1
const F_NODECO: u64 = 2
// ADDENDUM TASKBAR: a maximized window is not a window that happens to
// be as large as the work area -- it is a window that FOLLOWS the work
// area. Without the flag the server cannot tell the two apart, and a
// taskbar that moves to another edge would leave every window where it
// was.
const F_MAXIMIZED: u64 = 4
// RUNDE TILING: dieses Fenster liegt hinter einem Reiter. Es ist NICHT
// dasselbe wie F_HIDDEN (minimiert): ein Klick auf den Reiter holt es
// zurueck, ein Klick auf den Fensterknopf der Leiste nicht.
const F_TABBED: u64 = 8

// ADDENDUM TASKBAR: the four screen edges. The numbers are written to
// /etc/taskbar.conf as words ("bottom", "top", "left", "right") and
// they are the same four numbers in the kernel, in the taskbar and in
// the settings application -- there is no translation table.
const EDGE_BOTTOM: u64 = 0
const EDGE_TOP: u64 = 1
const EDGE_LEFT: u64 = 2
const EDGE_RIGHT: u64 = 3

const E_KEY: u64 = 1
const E_DOWN: u64 = 2
const E_UP: u64 = 3
const E_MOVE: u64 = 4
const E_CLOSE: u64 = 5
const E_FOCUS: u64 = 6
const E_RESIZE: u64 = 7

// die Skalare
const S_READY: u64 = 0x000
const S_COUNT: u64 = 0x008
const S_FOCUS: u64 = 0x010 // Fenster + 1, 0 = keines
const S_NEXTID: u64 = 0x018
const S_DX0: u64 = 0x020 // der schmutzige Bereich
const S_DY0: u64 = 0x028
const S_DX1: u64 = 0x030
const S_DY1: u64 = 0x038
const S_DON: u64 = 0x040
const S_SW: u64 = 0x048 // Bildschirmgroesse
const S_SH: u64 = 0x050
const S_DRAG: u64 = 0x058 // Fenster + 1, das am Zeiger haengt
const S_DRAGX: u64 = 0x060
const S_DRAGY: u64 = 0x068
const S_SIZING: u64 = 0x070 // Fenster + 1, dessen Groesse gezogen wird
const S_CURON: u64 = 0x078
const S_CURX: u64 = 0x080 // wo der Zeiger zuletzt gemalt wurde
const S_CURY: u64 = 0x088
const S_COMPOSITES: u64 = 0x090
const S_BLITS: u64 = 0x098
const S_PIXELS: u64 = 0x0A0
const S_NODIRTY: u64 = 0x0A8 // GEGENPROBE: immer das ganze Bild
const S_NOFOCUS: u64 = 0x0B0 // GEGENPROBE: Tasten an alle
const S_FONT_UI: u64 = 0x0B8
const S_FONT_MONO: u64 = 0x0C0
const S_PX_UI: u64 = 0x0C8
const S_PX_MONO: u64 = 0x0D0
const S_LASTUS: u64 = 0x0D8
const S_KEYS: u64 = 0x0E0
const S_EVDROP: u64 = 0x0E8
const S_CURSAVE: u64 = 0x0F0 // Rahmen fuer den Zeigergrund
const S_DESK: u64 = 0x0F8
const S_DOWNS: u64 = 0x100
const S_MOVES: u64 = 0x108
const S_HITS: u64 = 0x110 // die Farbe des Hintergrunds
// RUNDE K15: WELCHES ZEIGERBILD. 0 = Pfeil, 1 = Textbalken. Es steht
// hier und nicht in der Anwendung, weil der Zeiger UEBER allen Fenstern
// liegt und vom Server gemalt wird -- eine Anwendung, die ihn selbst
// zeichnete, zeichnete ihn in ihr eigenes Rechteck und damit unter alle
// anderen. `kernel/wig.fi` setzt ihn auf Verlangen aus Ring 3.
const S_SHAPE: u64 = 0x118
// RUNDE DESKTOP. Vier Skalare: die beiden Gegenproben und die beiden
// Zaehler, ohne die "das Fenster wurde minimiert" eine Behauptung
// ueber etwas waere, das man im Bild gerade NICHT sieht.
const S_NOLAYER: u64 = 0x120 // GEGENPROBE: die Ebenen abschalten
const S_NOMIN: u64 = 0x128 // GEGENPROBE: das Verbergen abschalten
const S_HIDES: u64 = 0x130 // wie oft ein Fenster verborgen wurde
const S_SHOWS: u64 = 0x138 // und wie oft es wieder auftauchte
// ADDENDUM TASKBAR: the work area and its two counters. It is kept as
// four scalars and NOT recomputed on demand: `compose` runs sixty
// times a second and would walk the window table each time for an
// answer that changes when a strut changes and at no other moment.
const S_WORK_X: u64 = 0x140
const S_WORK_Y: u64 = 0x148
const S_WORK_W: u64 = 0x150
const S_WORK_H: u64 = 0x158
const S_NOSTRUT: u64 = 0x160 // COUNTER-TEST: ignore every strut
const S_STRUTS: u64 = 0x168 // how often a strut was declared or cleared
const S_WORKCALC: u64 = 0x170 // how often the work area was recomputed
// RUNDE TILING. Die Skalare des Kachelbetriebs. Sie lagen bei 0x120,
// wo die Runden DESKTOP und TASKLEISTE zusammen schon elf Woerter
// stehen haben -- zwei Runden auf denselben Adressen. Sie ziehen
// deshalb hinter deren Block, auf 0x180; vor W_OFF (0x400) ist Platz.
const S_TILE: u64 = 0x180 // 1 = neue Fenster gehen in den Baum
const S_PVON: u64 = 0x188 // ein Vorschaurechteck liegt auf dem Schirm
const S_PVX: u64 = 0x190
const S_PVY: u64 = 0x198
const S_PVW: u64 = 0x1A0
const S_PVH: u64 = 0x1A8
const S_DROPN: u64 = 0x1B0 // Zielknoten + 1 beim Ziehen
const S_DROPS: u64 = 0x1B8 // Seite am Ziel (tile.D_*), 4 = als Reiter
const S_DROPE: u64 = 0x1C0 // Bildschirmrand + 1 statt eines Zielfensters
const S_DRAGT: u64 = 0x1C8 // das gezogene Fenster kam AUS dem Baum
const S_HOTS: u64 = 0x1D0 // wie viele Tastenkuerzel ausgefuehrt wurden
const S_ACTS: u64 = 0x1D8 // wie viele davon wirklich etwas getan haben

// ein Fenster
const W_USED: u64 = 0x00
const W_ID: u64 = 0x08
const W_OWNER: u64 = 0x10
const W_X: u64 = 0x18 // AUSSEN, oben links
const W_Y: u64 = 0x20
const W_W: u64 = 0x28 // die Malflaeche, ohne Rahmen
const W_H: u64 = 0x30
const W_BUF: u64 = 0x38
const W_BUFBYTES: u64 = 0x40
const W_Z: u64 = 0x48
const W_KIND: u64 = 0x50
const W_COLS: u64 = 0x58
const W_ROWS: u64 = 0x60
const W_CX: u64 = 0x68
const W_CY: u64 = 0x70
const W_GRID: u64 = 0x78
const W_EHEAD: u64 = 0x80
const W_ETAIL: u64 = 0x88
const W_FG: u64 = 0x90
const W_BG: u64 = 0x98
const W_CELLW: u64 = 0xA0
const W_CELLH: u64 = 0xA8
// 0xB8 und NICHT 0xA8: dort liegt W_CELLH. Die erste Fassung nahm 0xA8,
// und die Zahl der Tastenereignisse des Terminalfensters war danach
// genau seine Zellenhoehe -- neunzehn, ohne dass eine Taste gedrueckt
// worden waere. Dieselbe Sorte Fehler wie Runde K7B, eine Ebene tiefer.
const W_KEYS: u64 = 0xB8
const W_TTY: u64 = 0xB0 // Runde K10: das Terminal + 1, 0 = keines
const W_TITLE: u64 = 0xC0 // 32 Oktette, bis 0xE0
// RUNDE DESKTOP: die beiden letzten freien Woerter des Satzes. Der
// Satz ist 256 Oktette lang, der Titel endet bei 0xE0 -- vier Woerter
// waren frei, zwei sind es noch.
const W_LAYER: u64 = 0xE0 // L_DESK, L_NORMAL oder L_TOP
const W_FLAGS: u64 = 0xE8 // F_HIDDEN | F_NODECO | F_MAXIMIZED
// ADDENDUM TASKBAR: the last two free words of the record. After this
// the 256 octets are full; the next round that needs a field has to
// enlarge WIN_BYTES, and that moves the window table (see `wat`).
//   W_STRUT  0 = this window reserves nothing.
//            otherwise (edge + 1) | (size << 8).
//   W_SAVE   the rectangle to go back to when a maximized window is
//            restored: x, y, w, h packed into four 16-bit fields, the
//            two coordinates biased by 4096 because a window may sit
//            at a negative one.
const W_STRUT: u64 = 0xF0
const W_SAVE: u64 = 0xF8
// RUNDE TILING, IN EINEN GROESSEREN SATZ. Diese Runde hatte 0xE0, 0xE8,
// 0xF0 und 0xF8 genommen -- dieselben vier Woerter, die DESKTOP und der
// Taskleisten-Nachtrag schon belegt haben, mit anderer Bedeutung. Der
// Satz von 256 Oktetten ist damit wirklich voll, und der Nachtrag hat
// aufgeschrieben, was dann zu tun ist: WIN_BYTES wird groesser, und die
// Fenstertafel wandert. WIN_BYTES ist deshalb 512, die Ereignisringe
// liegen ab 0x2000 statt ab 0x1000, und diese Runde bekommt drei
// Woerter im neuen Teil.
const W_NODE: u64 = 0x100 // Knoten im Fensterbaum + 1, 0 = schwebend
// Wohin ein Fenster zurueckkehrt, wenn es den Baum verlaesst. Zwei
// Woerter statt vier: x und y beziehungsweise Breite und Hoehe in je
// zwei Vierteln. Ein Fenster ist hoechstens 2048 gross, das passt.
const W_SAVXY: u64 = 0x108
const W_SAVWH: u64 = 0x110

// "kein Terminal". Absichtlich eine Zahl und kein Ruf nach `tty.fi`:
// dieses Modul darf `tty` NICHT einbinden, weil `tty` es einbindet
// (SINK_WINDOW). Der Abhaengigkeitsgraph bleibt ein Baum, und die
// Richtung ist die richtige -- der Fensterserver weiss nichts von
// Zeilendisziplinen, das Terminal weiss, wohin es schreibt.
const NO_TTY: u64 = 255

fn gs(state: u64, off: u64) -> u64 {
    return kstate.get(state + kstate.WM_OFF, off)
}

fn ss(state: u64, off: u64, v: u64) {
    kstate.set(state + kstate.WM_OFF, off, v)
}

// DIE FENSTERTAFEL LIEGT SEIT DER RUNDE DESKTOP IN `kstate.DSK_OFF`
// UND NICHT MEHR IN `WM_OFF`. Die Skalare stehen weiter in WM_OFF; das
// ist die einzige Stelle, an der die beiden Bereiche auseinanderfallen,
// und sie steht deshalb hier in einer einzigen Funktion.
fn wat(i: u64) -> u64 {
    return kstate.DSK_OFF + W_OFF + i * WIN_BYTES
}

fn wg(state: u64, i: u64, off: u64) -> u64 {
    return kstate.get(state, wat(i) + off)
}

fn wsv(state: u64, i: u64, off: u64, v: u64) {
    kstate.set(state, wat(i) + off, v)
}

fn ready(state: u64) -> bool {
    return gs(state, S_READY) != 0
}

fn valid(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return wg(state, i, W_USED) != 0
}

fn count(state: u64) -> u64 {
    return gs(state, S_COUNT)
}

fn focus(state: u64) -> u64 {
    let f: u64 = gs(state, S_FOCUS)
    if f == 0 {
        return MAX_WIN
    }
    return f - 1
}

fn composites(state: u64) -> u64 {
    return gs(state, S_COMPOSITES)
}

fn blits(state: u64) -> u64 {
    return gs(state, S_BLITS)
}

fn pixels(state: u64) -> u64 {
    return gs(state, S_PIXELS)
}

fn last_us(state: u64) -> u64 {
    return gs(state, S_LASTUS)
}

fn cursor_on(state: u64) -> bool {
    return gs(state, S_CURON) != 0
}

fn set_cursor(state: u64, on: bool) {
    if on {
        ss(state, S_CURON, 1)
    } else {
        ss(state, S_CURON, 0)
    }
}

fn font_ui(state: u64) -> u64 {
    return gs(state, S_FONT_UI)
}

fn font_mono(state: u64) -> u64 {
    return gs(state, S_FONT_MONO)
}

fn px_ui(state: u64) -> u64 {
    return gs(state, S_PX_UI)
}

fn px_mono(state: u64) -> u64 {
    return gs(state, S_PX_MONO)
}

fn set_fonts(state: u64, ui: u64, pui: u64, mono: u64, pmono: u64) {
    ss(state, S_FONT_UI, ui)
    ss(state, S_PX_UI, pui)
    ss(state, S_FONT_MONO, mono)
    ss(state, S_PX_MONO, pmono)
}

fn win_x(state: u64, i: u64) -> i64 {
    return wg(state, i, W_X) as i64
}

fn win_y(state: u64, i: u64) -> i64 {
    return wg(state, i, W_Y) as i64
}

fn win_w(state: u64, i: u64) -> u64 {
    return wg(state, i, W_W)
}

fn win_h(state: u64, i: u64) -> u64 {
    return wg(state, i, W_H)
}

fn win_z(state: u64, i: u64) -> u64 {
    return wg(state, i, W_Z)
}

fn win_buf(state: u64, i: u64) -> u64 {
    return wg(state, i, W_BUF)
}

fn win_owner(state: u64, i: u64) -> u64 {
    return wg(state, i, W_OWNER)
}

fn win_kind(state: u64, i: u64) -> u64 {
    return wg(state, i, W_KIND)
}

fn win_id(state: u64, i: u64) -> u64 {
    return wg(state, i, W_ID)
}

// HAT DIESES FENSTER SCHMUCK? Rahmen, Titelleiste, Schliessfeld und
// Griff kosten links BORDER und oben TITLE_H. Ein Schreibtisch, der
// zwei Bildpunkte neben dem Bildschirmrand anfaengt, ist kein
// Schreibtisch; eine Taskleiste mit Titelleiste ist keine Taskleiste.
fn deko(state: u64, i: u64) -> bool {
    return (wg(state, i, W_FLAGS) & F_NODECO) == 0
}

// Der Versatz der Malflaeche innerhalb des aeusseren Rechtecks. An
// EINER Stelle, weil dieselbe Rechnung im Zusammensetzen, im Treffer
// und in der Ereignisverteilung vorkommt -- und weil sie in der ersten
// Fassung dieser Runde an zweien davon stand und an der dritten nicht.
fn inx(state: u64, i: u64) -> u64 {
    if deko(state, i) {
        return BORDER
    }
    return 0
}

fn iny(state: u64, i: u64) -> u64 {
    if deko(state, i) {
        return TITLE_H
    }
    return 0
}

fn outer_w(state: u64, i: u64) -> u64 {
    if !deko(state, i) {
        return wg(state, i, W_W)
    }
    return wg(state, i, W_W) + BORDER * 2
}

fn outer_h(state: u64, i: u64) -> u64 {
    if !deko(state, i) {
        return wg(state, i, W_H)
    }
    return wg(state, i, W_H) + TITLE_H + BORDER
}

fn win_layer(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return L_NORMAL
    }
    return wg(state, i, W_LAYER)
}

fn win_hidden(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_HIDDEN) != 0
}

fn win_deco(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return deko(state, i)
}

// Die Adresse des Titels IM KERNEL. Nur `sys.fi` benutzt sie, um ihn
// nach Ring 3 zu kopieren -- die Taskleiste braucht Namen.
fn win_title(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return 0
    }
    return state + wat(i) + W_TITLE
}

// Das Fenster mit dieser Nummer. Die Taskleiste kennt FREMDE Fenster
// nur ueber ihre Nummer -- ein Handle bekommt sie nicht, und ein Platz
// in der Tafel waere eine Zahl, die sich unter ihr aendert.
fn by_id(state: u64, id: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_ID) == id {
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

fn hides(state: u64) -> u64 {
    return gs(state, S_HIDES)
}

fn shows(state: u64) -> u64 {
    return gs(state, S_SHOWS)
}

fn nolayer(state: u64) -> bool {
    return gs(state, S_NOLAYER) != 0
}

fn nomin(state: u64) -> bool {
    return gs(state, S_NOMIN) != 0
}

fn set_nolayer(state: u64, on: bool) {
    if on {
        ss(state, S_NOLAYER, 1)
    } else {
        ss(state, S_NOLAYER, 0)
    }
}

fn set_nomin(state: u64, on: bool) {
    if on {
        ss(state, S_NOMIN, 1)
    } else {
        ss(state, S_NOMIN, 0)
    }
}

fn term_cols(state: u64, i: u64) -> u64 {
    return wg(state, i, W_COLS)
}

fn term_rows(state: u64, i: u64) -> u64 {
    return wg(state, i, W_ROWS)
}

fn term_cx(state: u64, i: u64) -> u64 {
    return wg(state, i, W_CX)
}

fn term_cy(state: u64, i: u64) -> u64 {
    return wg(state, i, W_CY)
}

// ------------------------------------------------------------- Start

fn init(state: u64, w: u64, h: u64, nodirty: bool, nofocus: bool) -> bool {
    if w == 0 || h == 0 {
        return false
    }
    var i: u64 = 0
    while i < MAX_WIN {
        wsv(state, i, W_USED, 0)
        wsv(state, i, W_EHEAD, 0)
        wsv(state, i, W_ETAIL, 0)
        wsv(state, i, W_LAYER, L_NORMAL)
        wsv(state, i, W_FLAGS, 0)
        wsv(state, i, W_STRUT, 0)
        wsv(state, i, W_SAVE, 0)
        i = i + 1
    }
    ss(state, S_COUNT, 0)
    ss(state, S_FOCUS, 0)
    ss(state, S_NEXTID, 1)
    ss(state, S_SW, w)
    ss(state, S_SH, h)
    ss(state, S_DRAG, 0)
    ss(state, S_SIZING, 0)
    ss(state, S_CURON, 1)
    ss(state, S_CURX, w / 2)
    ss(state, S_CURY, h / 2)
    ss(state, S_COMPOSITES, 0)
    ss(state, S_BLITS, 0)
    ss(state, S_PIXELS, 0)
    ss(state, S_KEYS, 0)
    ss(state, S_EVDROP, 0)
    ss(state, S_LASTUS, 0)
    ss(state, S_DON, 0)
    ss(state, S_NODIRTY, 0)
    if nodirty {
        ss(state, S_NODIRTY, 1)
    }
    ss(state, S_NOFOCUS, 0)
    if nofocus {
        ss(state, S_NOFOCUS, 1)
    }
    ss(state, S_HIDES, 0)
    ss(state, S_SHOWS, 0)
    // ADDENDUM TASKBAR: before the first strut the work area IS the
    // screen. `recalc_work` reads S_SW and S_SH, so it has to run after
    // both are set -- they are, twelve lines above this one.
    ss(state, S_NOSTRUT, 0)
    ss(state, S_STRUTS, 0)
    ss(state, S_WORKCALC, 0)
    recalc_work(state)
    ss(state, S_DESK, fb.rgb(state, 0x1E, 0x2A, 0x38))
    ss(state, S_FONT_UI, ttf.MAX_FONTS)
    ss(state, S_FONT_MONO, ttf.MAX_FONTS)
    ss(state, S_TILE, 0)
    ss(state, S_PVON, 0)
    ss(state, S_DROPN, 0)
    ss(state, S_DROPE, 0)
    ss(state, S_DRAGT, 0)
    ss(state, S_HOTS, 0)
    ss(state, S_ACTS, 0)
    ss(state, S_READY, 1)
    // RUNDE TILING: der Baum bekommt dieselbe Flaeche wie der Schirm.
    // Er ist erst einmal LEER und schaltet nichts um -- ohne das Wort
    // `tile` verhaelt sich der Fensterserver wie vorher.
    tile.init(state, 0, 0, w, h)
    damage_all(state)
    return true
}

// ---------------------------------------------------- die Rechtecke

fn damage(state: u64, x0: i64, y0: i64, x1: i64, y1: i64) {
    if !ready(state) {
        return
    }
    if gs(state, S_NODIRTY) != 0 {
        damage_all(state)
        return
    }
    var a: i64 = x0
    var b: i64 = y0
    var c: i64 = x1
    var d: i64 = y1
    if a < 0 {
        a = 0
    }
    if b < 0 {
        b = 0
    }
    if c > gs(state, S_SW) as i64 {
        c = gs(state, S_SW) as i64
    }
    if d > gs(state, S_SH) as i64 {
        d = gs(state, S_SH) as i64
    }
    if c <= a || d <= b {
        return
    }
    if gs(state, S_DON) == 0 {
        ss(state, S_DX0, a as u64)
        ss(state, S_DY0, b as u64)
        ss(state, S_DX1, c as u64)
        ss(state, S_DY1, d as u64)
        ss(state, S_DON, 1)
        return
    }
    if (a as u64) < gs(state, S_DX0) {
        ss(state, S_DX0, a as u64)
    }
    if (b as u64) < gs(state, S_DY0) {
        ss(state, S_DY0, b as u64)
    }
    if (c as u64) > gs(state, S_DX1) {
        ss(state, S_DX1, c as u64)
    }
    if (d as u64) > gs(state, S_DY1) {
        ss(state, S_DY1, d as u64)
    }
}

fn damage_all(state: u64) {
    ss(state, S_DX0, 0)
    ss(state, S_DY0, 0)
    ss(state, S_DX1, gs(state, S_SW))
    ss(state, S_DY1, gs(state, S_SH))
    ss(state, S_DON, 1)
}

fn damage_win(state: u64, i: u64) {
    damage(state, win_x(state, i), win_y(state, i),
        win_x(state, i) + outer_w(state, i) as i64,
        win_y(state, i) + outer_h(state, i) as i64)
}

fn dirty_x0(state: u64) -> u64 {
    return gs(state, S_DX0)
}

fn dirty_y0(state: u64) -> u64 {
    return gs(state, S_DY0)
}

fn dirty_x1(state: u64) -> u64 {
    return gs(state, S_DX1)
}

fn dirty_y1(state: u64) -> u64 {
    return gs(state, S_DY1)
}

// ------------------------------------------------------ die Fenster

fn create(state: u64, owner: u64, x: i64, y: i64, w: u64, h: u64,
    kind: u64, title: u64) -> u64 {
    if !ready(state) || w < 32 || h < 16 || w > 2048 || h > 2048 {
        return MAX_WIN
    }
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) == 0 {
            let bytes: u64 = w * h * 4
            let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
            let buf: u64 = mem.frame_run(state, rahmen)
            if buf == 0 {
                return MAX_WIN
            }
            wsv(state, i, W_USED, 1)
            wsv(state, i, W_ID, gs(state, S_NEXTID))
            ss(state, S_NEXTID, gs(state, S_NEXTID) + 1)
            wsv(state, i, W_OWNER, owner)
            wsv(state, i, W_X, x as u64)
            wsv(state, i, W_Y, y as u64)
            wsv(state, i, W_W, w)
            wsv(state, i, W_H, h)
            wsv(state, i, W_BUF, buf)
            wsv(state, i, W_BUFBYTES, rahmen * mem.FRAME_SIZE)
            wsv(state, i, W_KIND, kind)
            wsv(state, i, W_EHEAD, 0)
            wsv(state, i, W_ETAIL, 0)
            wsv(state, i, W_FG, fb.rgb(state, 0xE0, 0xE6, 0xEC))
            wsv(state, i, W_BG, fb.rgb(state, 0x10, 0x14, 0x1A))
            wsv(state, i, W_GRID, 0)
            wsv(state, i, W_KEYS, 0)
            wsv(state, i, W_LAYER, L_NORMAL)
            wsv(state, i, W_FLAGS, 0)
            wsv(state, i, W_STRUT, 0)
            wsv(state, i, W_SAVE, 0)
            wsv(state, i, W_Z, gs(state, S_COUNT))
            ss(state, S_COUNT, gs(state, S_COUNT) + 1)
            // RUNDE DESKTOP: ein neues Fenster kommt an die Oberkante
            // SEINER Ebene und nicht an die Oberkante von allem. Solange
            // es keine Taskleiste gibt, ist das dasselbe; sobald es eine
            // gibt, ist es der Unterschied zwischen einer Leiste und
            // einem Fenster, das sie verdeckt.
            raise_win(state, i)
            set_title(state, i, title)
            fill(state, i, 0, 0, w, h, wg(state, i, W_BG))
            if kind == K_TERM {
                term_setup(state, i)
            }
            set_focus(state, i)
            damage_win(state, i)
            if gs(state, S_TILE) != 0 {
                tile_take(state, i)
            }
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

fn set_title(state: u64, i: u64, p: u64) {
    var k: u64 = 0
    while k < 31 {
        var c: u64 = 0
        if p != 0 {
            c = kstate.get8(p + k)
        }
        kstate.set8(state + wat(i) + W_TITLE + k, c as u8)
        if c == 0 {
            k = 31
        } else {
            k = k + 1
        }
    }
    kstate.set8(state + wat(i) + W_TITLE + 31, 0 as u8)
}

fn destroy(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    tile_release(state, i)
    damage_win(state, i)
    let z: u64 = wg(state, i, W_Z)
    // ADDENDUM TASKBAR: a window that reserved a screen edge gives the
    // edge back when it dies. Without this the work area would stay
    // small after the taskbar exits, and every window maximized after
    // that would leave a strip of empty desktop.
    let hatte_strut: bool = wg(state, i, W_STRUT) != 0
    wsv(state, i, W_STRUT, 0)
    wsv(state, i, W_USED, 0)
    if wg(state, i, W_BUF) != 0 {
        mem.frame_free_run(state, wg(state, i, W_BUF),
            wg(state, i, W_BUFBYTES) / mem.FRAME_SIZE)
        wsv(state, i, W_BUF, 0)
    }
    if wg(state, i, W_GRID) != 0 {
        mem.frame_free_run(state, wg(state, i, W_GRID), 1)
        wsv(state, i, W_GRID, 0)
    }
    // Die Stapelreihenfolge schliesst sich: wer ueber dem geschlossenen
    // Fenster lag, rutscht eine Stufe herunter. Ohne das entstehen
    // Luecken, und `compose` findet auf einer Stufe kein Fenster mehr.
    var k: u64 = 0
    while k < MAX_WIN {
        if wg(state, k, W_USED) != 0 && wg(state, k, W_Z) > z {
            wsv(state, k, W_Z, wg(state, k, W_Z) - 1)
        }
        k = k + 1
    }
    ss(state, S_COUNT, gs(state, S_COUNT) - 1)
    if focus(state) == i {
        ss(state, S_FOCUS, 0)
        // Der Fokus geht an das oberste verbliebene SICHTBARE Fenster
        // der normalen Ebene -- nicht an den Schreibtisch und nicht an
        // die Taskleiste.
        let o: u64 = top_visible(state)
        if o < MAX_WIN {
            set_focus(state, o)
        }
    }
    if gs(state, S_DRAG) == i + 1 {
        ss(state, S_DRAG, 0)
    }
    if gs(state, S_SIZING) == i + 1 {
        ss(state, S_SIZING, 0)
    }
    if hatte_strut {
        recalc_work(state)
    }
    return true
}

fn topmost(state: u64) -> u64 {
    var beste: u64 = MAX_WIN
    var bz: u64 = 0
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 {
            if beste == MAX_WIN || wg(state, i, W_Z) >= bz {
                beste = i
                bz = wg(state, i, W_Z)
            }
        }
        i = i + 1
    }
    return beste
}

// DAS OBERSTE SICHTBARE FENSTER DER NORMALEN EBENE. Es ist das, an das
// der Fokus faellt, wenn eines geschlossen oder minimiert wird -- und
// es ist ausdruecklich NICHT der Schreibtisch und NICHT die
// Taskleiste. Beide nehmen die Tastatur nicht an; wer in einer
// Taskleiste tippt, hat kein Fenster mehr, in dem der Text landet.
fn top_visible(state: u64) -> u64 {
    var beste: u64 = MAX_WIN
    var bz: u64 = 0
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_LAYER) == L_NORMAL {
            if (wg(state, i, W_FLAGS) & F_HIDDEN) == 0 {
                if beste == MAX_WIN || wg(state, i, W_Z) >= bz {
                    beste = i
                    bz = wg(state, i, W_Z)
                }
            }
        }
        i = i + 1
    }
    return beste
}

// AUF WELCHE STUFE GEHOERT EIN FENSTER DER EBENE `l` GANZ OBEN. Gezaehlt
// werden alle belegten Fenster mit kleinerer ODER GLEICHER Ebene --
// einschliesslich des Fensters selbst, wenn es schon belegt ist. Die
// gesuchte Stufe ist eine weniger.
fn zslot(state: u64, l: u64) -> u64 {
    var n: u64 = 0
    var k: u64 = 0
    while k < MAX_WIN {
        if wg(state, k, W_USED) != 0 && wg(state, k, W_LAYER) <= l {
            n = n + 1
        }
        k = k + 1
    }
    return n
}

// EIN FENSTER AUF EINE ANDERE STUFE, in beide Richtungen. Runde K10
// hatte nur `raise_win`, und das konnte nur nach oben: es zog alles
// ueber dem Fenster eine Stufe herunter und setzte es an die Spitze.
// Mit Ebenen muss ein Fenster auch SINKEN koennen (ein Schreibtisch,
// der als letztes entsteht, gehoert nach ganz hinten), und das ist die
// andere Haelfte derselben Verschiebung.
fn move_to_z(state: u64, i: u64, ziel: u64) {
    let z: u64 = wg(state, i, W_Z)
    if ziel == z || ziel >= gs(state, S_COUNT) {
        return
    }
    var k: u64 = 0
    while k < MAX_WIN {
        if wg(state, k, W_USED) != 0 && k != i {
            let kz: u64 = wg(state, k, W_Z)
            if z < ziel {
                if kz > z && kz <= ziel {
                    wsv(state, k, W_Z, kz - 1)
                }
            } else {
                if kz >= ziel && kz < z {
                    wsv(state, k, W_Z, kz + 1)
                }
            }
        }
        k = k + 1
    }
    wsv(state, i, W_Z, ziel)
    damage_win(state, i)
}

// Das Fenster auf einer Stufe der Stapelreihenfolge.
fn at_z(state: u64, z: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_Z) == z {
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

// HEBEN HEISST SEIT DER RUNDE DESKTOP: an die Oberkante SEINER EBENE.
// Mit `nolayer` ist es wieder die Oberkante von allem -- und genau
// dann verdeckt der Schreibtisch beim ersten Klick den ganzen
// Bildschirm. Das ist die Gegenprobe, und sie ist eine Zeile.
fn raise_win(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    var ziel: u64 = gs(state, S_COUNT) - 1
    if gs(state, S_NOLAYER) == 0 {
        ziel = zslot(state, wg(state, i, W_LAYER)) - 1
    }
    move_to_z(state, i, ziel)
}

// DIE EBENE EINES FENSTERS SETZEN. Danach wandert es sofort an die
// Oberkante der neuen Ebene -- ein Schreibtisch, der seine Ebene
// bekommt und liegen bleibt, wo er war, waere kein Schreibtisch.
fn set_layer(state: u64, i: u64, l: u64) {
    if !valid(state, i) || l > L_TOP {
        return
    }
    if wg(state, i, W_LAYER) == l {
        return
    }
    wsv(state, i, W_LAYER, l)
    // Ein Fenster, das aus der normalen Ebene verschwindet, darf den
    // Eingabefokus nicht mitnehmen.
    if l != L_NORMAL && focus(state) == i {
        ss(state, S_FOCUS, 0)
        let o: u64 = top_visible(state)
        if o < MAX_WIN {
            set_focus(state, o)
        }
    }
    raise_win(state, i)
    damage_all(state)
}

// MINIMIEREN UND WIEDERHERSTELLEN. Ein verborgenes Fenster wird nicht
// zusammengesetzt und nimmt keinen Klick an -- es LEBT aber weiter, sein
// Puffer bleibt liegen, seine Ereignisse laufen weiter auf. Das ist der
// ganze Unterschied zu `destroy`, und er ist der Grund, warum ein
// Leistenknopf ein Fenster zurueckholen kann.
//
// `nomin` ist die Gegenprobe und tut hier NICHTS -- und deshalb bleibt
// das Fenster dann stehen, obwohl der Knopf gedrueckt wurde.
fn set_hidden(state: u64, i: u64, h: bool) {
    if !valid(state, i) {
        return
    }
    if gs(state, S_NOMIN) != 0 {
        return
    }
    let f: u64 = wg(state, i, W_FLAGS)
    if h {
        if (f & F_HIDDEN) != 0 {
            return
        }
        wsv(state, i, W_FLAGS, f | F_HIDDEN)
        ss(state, S_HIDES, gs(state, S_HIDES) + 1)
        // ADDENDUM TASKBAR: a window nobody can see reserves nothing.
        if wg(state, i, W_STRUT) != 0 {
            recalc_work(state)
        }
        damage_win(state, i)
        if focus(state) == i {
            ss(state, S_FOCUS, 0)
            let o: u64 = top_visible(state)
            if o < MAX_WIN {
                set_focus(state, o)
            }
        }
        if gs(state, S_DRAG) == i + 1 {
            ss(state, S_DRAG, 0)
        }
        if gs(state, S_SIZING) == i + 1 {
            ss(state, S_SIZING, 0)
        }
    } else {
        if (f & F_HIDDEN) == 0 {
            return
        }
        wsv(state, i, W_FLAGS, f & ~F_HIDDEN)
        ss(state, S_SHOWS, gs(state, S_SHOWS) + 1)
        if wg(state, i, W_STRUT) != 0 {
            recalc_work(state)
        }
        damage_win(state, i)
    }
}

fn set_deco(state: u64, i: u64, on: bool) {
    if !valid(state, i) {
        return
    }
    let f: u64 = wg(state, i, W_FLAGS)
    damage_win(state, i) // das ALTE Rechteck, samt Rahmen
    if on {
        wsv(state, i, W_FLAGS, f & ~F_NODECO)
    } else {
        wsv(state, i, W_FLAGS, f | F_NODECO)
    }
    damage_win(state, i) // und das neue, ohne
}

// ==================== ADDENDUM TASKBAR: STRUTS AND THE WORK AREA ====
//
// THE PROBLEM, stated plainly. Round DESKTOP gave this system a
// taskbar, and it is a window like any other. A window made as large as
// the screen is therefore drawn OVER it; a window placed under it is
// invisible. As long as the taskbar always sat at the bottom edge one
// could hard-code 28 pixels somewhere and move on. It no longer always
// sits at the bottom.
//
// X11 solved this in 1997 with a window property named `_NET_WM_STRUT`:
// a window declares how many pixels of which screen edge it occupies,
// the window manager subtracts every strut from the screen, and calls
// what is left the WORK AREA. All layout arithmetic uses the work area
// and not the screen. This is the same idea in a form that fits a
// kernel with no properties and no atoms: ONE WORD in the window
// record, and four scalars for the result.
//
// WHY IT LIVES IN THE SERVER AND NOT IN THE TASKBAR. Because the
// taskbar is not the only one who needs the answer. The round TILING
// running in parallel on this tree turns the window system into a tree
// of frames, and the ROOT RECTANGLE of that tree is exactly this work
// area -- not the screen. If the reservation lived inside the taskbar,
// every other client would have to ask the taskbar, and a client that
// does not know a taskbar exists would get it wrong and never find out.
//
// THE INTERFACE, and TILING should need nothing beyond it:
//
//     work_x(state), work_y(state), work_w(state), work_h(state)
//         the free rectangle. Never degenerate: a strut that would eat
//         the screen is refused, see `recalc_work`.
//     set_strut(state, i, edge, size) -> bool
//         declare (size > 0) or clear (size == 0) a reservation.
//         Recomputes the work area and refits every maximized window
//         in the same breath.
//     maximize(state, i, on) -> bool
//         fill the WORK AREA, not the screen, and remember where the
//         window was. This is the one call a tiling layout would
//         replace; the work area underneath it stays as it is.
//
// THE RULE, one sentence: whoever changes a strut, a screen size or the
// visibility of a strut-holding window calls `recalc_work`, and
// `recalc_work` refits the maximized windows. Nobody caches the work
// area anywhere else. There is exactly one copy of this state.
//
// THE COUNTER-TEST is `nostrut` and it is one branch: with it the work
// area is the whole screen again, a maximized window covers the taskbar
// and the taskbar is gone from the picture. That is the state this
// addendum removes, and it has to be reachable to be measurable.

fn work_x(state: u64) -> u64 {
    return gs(state, S_WORK_X)
}

fn work_y(state: u64) -> u64 {
    return gs(state, S_WORK_Y)
}

fn work_w(state: u64) -> u64 {
    return gs(state, S_WORK_W)
}

fn work_h(state: u64) -> u64 {
    return gs(state, S_WORK_H)
}

fn struts(state: u64) -> u64 {
    return gs(state, S_STRUTS)
}

fn workcalcs(state: u64) -> u64 {
    return gs(state, S_WORKCALC)
}

fn nostrut(state: u64) -> bool {
    return gs(state, S_NOSTRUT) != 0
}

fn win_strut_edge(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return EDGE_BOTTOM
    }
    let v: u64 = wg(state, i, W_STRUT)
    if v == 0 {
        return EDGE_BOTTOM
    }
    return (v & 0xFF) - 1
}

fn win_strut_size(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return 0
    }
    return wg(state, i, W_STRUT) >> 8
}

// THE WORK AREA, recomputed from scratch. Not incrementally: an
// incremental work area is a cache, and a cache of four numbers that
// three modules write is the kind of thing that is right in every test
// and wrong on the machine.
fn recalc_work(state: u64) {
    let sw: u64 = gs(state, S_SW)
    let sh: u64 = gs(state, S_SH)
    var x0: u64 = 0
    var y0: u64 = 0
    var x1: u64 = sw
    var y1: u64 = sh
    if gs(state, S_NOSTRUT) == 0 {
        var i: u64 = 0
        while i < MAX_WIN {
            if wg(state, i, W_USED) != 0 && wg(state, i, W_STRUT) != 0 {
                if (wg(state, i, W_FLAGS) & F_HIDDEN) == 0 {
                    let e: u64 = (wg(state, i, W_STRUT) & 0xFF) - 1
                    let n: u64 = wg(state, i, W_STRUT) >> 8
                    if e == EDGE_TOP {
                        if n > y0 {
                            y0 = n
                        }
                    } else if e == EDGE_BOTTOM {
                        if n < sh && sh - n < y1 {
                            y1 = sh - n
                        }
                    } else if e == EDGE_LEFT {
                        if n > x0 {
                            x0 = n
                        }
                    } else {
                        if n < sw && sw - n < x1 {
                            x1 = sw - n
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    // A STRUT THAT EATS THE SCREEN IS NOT A STRUT. The smallest window
    // this server will make is 32 x 16 (see `resize_win`), plus the
    // decoration; below 64 x 64 of work area nothing can be laid out at
    // all, and the honest answer is to refuse the reservation rather
    // than to hand out a rectangle nobody can use.
    if x1 < x0 + 64 || y1 < y0 + 64 {
        x0 = 0
        y0 = 0
        x1 = sw
        y1 = sh
    }
    ss(state, S_WORK_X, x0)
    ss(state, S_WORK_Y, y0)
    ss(state, S_WORK_W, x1 - x0)
    ss(state, S_WORK_H, y1 - y0)
    ss(state, S_WORKCALC, gs(state, S_WORKCALC) + 1)
    refit_max(state)
}

fn set_nostrut(state: u64, on: bool) {
    if on {
        ss(state, S_NOSTRUT, 1)
    } else {
        ss(state, S_NOSTRUT, 0)
    }
    recalc_work(state)
}

fn set_strut(state: u64, i: u64, edge: u64, size: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if edge > EDGE_RIGHT {
        return false
    }
    if size > 0xFFFFFF {
        return false
    }
    if size == 0 {
        wsv(state, i, W_STRUT, 0)
    } else {
        wsv(state, i, W_STRUT, (edge + 1) | (size << 8))
    }
    ss(state, S_STRUTS, gs(state, S_STRUTS) + 1)
    recalc_work(state)
    return true
}

fn is_max(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0
}

// PUT A WINDOW ON THE WORK AREA. The OUTER rectangle of the window --
// frame, title bar and all -- becomes the work area exactly; the
// drawing surface is that minus the decoration. A window without
// decoration (desktop, taskbar) has no such difference, which is why
// this goes through `deko` and not through BORDER and TITLE_H.
fn fit_work(state: u64, i: u64) -> bool {
    var iw: u64 = gs(state, S_WORK_W)
    var ih: u64 = gs(state, S_WORK_H)
    if deko(state, i) {
        if iw <= BORDER * 2 || ih <= TITLE_H + BORDER {
            return false
        }
        iw = iw - BORDER * 2
        ih = ih - TITLE_H - BORDER
    }
    if !resize_win(state, i, iw, ih) {
        return false
    }
    move_win(state, i, gs(state, S_WORK_X) as i64,
        gs(state, S_WORK_Y) as i64)
    return true
}

// EVERY MAXIMIZED WINDOW FOLLOWS THE WORK AREA. This is the whole point
// of the flag: the taskbar moves from the bottom edge to the left edge,
// the work area changes, and the windows that were filling it fill the
// new one. Without this they would keep the old rectangle and half of
// them would sit under the taskbar.
fn refit_max(state: u64) {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 {
            if (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0 {
                let _r: bool = fit_work(state, i)
            }
        }
        i = i + 1
    }
}

fn maximize(state: u64, i: u64, on: bool) -> bool {
    if !valid(state, i) {
        return false
    }
    let f: u64 = wg(state, i, W_FLAGS)
    if on {
        if (f & F_MAXIMIZED) != 0 {
            return true
        }
        // Where to go back to. Biased by 4096 because a window may sit
        // at a negative coordinate and these are sixteen unsigned bits.
        let sx: u64 = ((win_x(state, i) + 4096) as u64) & 0xFFFF
        let sy: u64 = ((win_y(state, i) + 4096) as u64) & 0xFFFF
        wsv(state, i, W_SAVE, (sx << 48) | (sy << 32)
            | ((wg(state, i, W_W) & 0xFFFF) << 16)
            | (wg(state, i, W_H) & 0xFFFF))
        wsv(state, i, W_FLAGS, f | F_MAXIMIZED)
        if !fit_work(state, i) {
            // It did not fit -- most often because the buffer this
            // window was created with is smaller than the work area
            // (`resize_win` refuses to grow past it). Then it is NOT
            // maximized, and saying so is the whole difference between
            // a measurement and a claim.
            wsv(state, i, W_FLAGS, f)
            return false
        }
        return true
    }
    if (f & F_MAXIMIZED) == 0 {
        return true
    }
    let v: u64 = wg(state, i, W_SAVE)
    wsv(state, i, W_FLAGS, f & ~F_MAXIMIZED)
    let _r: bool = resize_win(state, i, (v >> 16) & 0xFFFF, v & 0xFFFF)
    let bx: i64 = ((v >> 48) & 0xFFFF) as i64 - 4096
    let by: i64 = ((v >> 32) & 0xFFFF) as i64 - 4096
    move_win(state, i, bx, by)
    return true
}

fn set_focus(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    // Ein verborgenes Fenster bekommt die Tastatur nicht. Sonst tippt
    // man in etwas, das nicht auf dem Schirm steht.
    if (wg(state, i, W_FLAGS) & F_HIDDEN) != 0 {
        return
    }
    let alt: u64 = focus(state)
    if alt == i {
        return
    }
    if alt < MAX_WIN {
        damage_win(state, alt)
        ev_push(state, alt, E_FOCUS, 0, 0, 0)
    }
    ss(state, S_FOCUS, i + 1)
    ev_push(state, i, E_FOCUS, 0, 0, 1)
    // RUNDE TILING: DER BAUM FUEHRT SEINEN EIGENEN FOKUS, und die beiden
    // muessen derselbe sein. Ohne diese zwei Zeilen teilt ein neues
    // Fenster nicht das ANGEKLICKTE, sondern das zuletzt angelegte -- ein
    // Fehler, der aussieht wie ein kaputter Baum und keiner ist.
    if wg(state, i, W_NODE) != 0 {
        tile.set_focus(state, wg(state, i, W_NODE) - 1)
    }
    damage_win(state, i)
}

fn move_win(state: u64, i: u64, x: i64, y: i64) {
    if !valid(state, i) {
        return
    }
    damage_win(state, i) // die alte Stelle wird wiederhergestellt
    wsv(state, i, W_X, x as u64)
    wsv(state, i, W_Y, y as u64)
    damage_win(state, i) // und die neue gemalt
}

fn resize_win(state: u64, i: u64, w: u64, h: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if w < 32 || h < 16 || w > 2048 || h > 2048 {
        return false
    }
    if w * h * 4 > wg(state, i, W_BUFBYTES) {
        return false // ohne neuen Puffer nicht groesser als angelegt
    }
    damage_win(state, i)
    wsv(state, i, W_W, w)
    wsv(state, i, W_H, h)
    if wg(state, i, W_KIND) == K_TERM {
        term_setup(state, i)
    } else {
        fill(state, i, 0, 0, w, h, wg(state, i, W_BG))
    }
    ev_push(state, i, E_RESIZE, w, h, 0)
    damage_win(state, i)
    return true
}

// ---------------------------------------------------- in ein Fenster

fn wpixel(state: u64, i: u64, x: u64, y: u64, color: u64) {
    let w: u64 = wg(state, i, W_W)
    if x >= w || y >= wg(state, i, W_H) {
        return
    }
    __mmio_write32((wg(state, i, W_BUF) +% y *% w *% 4 +% x *% 4)
        as *mut u32, color as u32)
}

fn wget(state: u64, i: u64, x: u64, y: u64) -> u64 {
    let w: u64 = wg(state, i, W_W)
    if x >= w || y >= wg(state, i, W_H) {
        return 0
    }
    return __mmio_read32((wg(state, i, W_BUF) +% y *% w *% 4 +% x *% 4)
        as *mut u32) as u64
}

fn fill(state: u64, i: u64, x: u64, y: u64, w: u64, h: u64, color: u64) {
    if !valid(state, i) {
        return
    }
    let ww: u64 = wg(state, i, W_W)
    let wh: u64 = wg(state, i, W_H)
    if x >= ww || y >= wh {
        return
    }
    var bw: u64 = w
    var bh: u64 = h
    if x + bw > ww {
        bw = ww - x
    }
    if y + bh > wh {
        bh = wh - y
    }
    var r: u64 = 0
    while r < bh {
        let p: u64 = wg(state, i, W_BUF) +% (y + r) *% ww *% 4 +% x *% 4
        fill_words(p, (color & 0xFFFFFFFF) | ((color & 0xFFFFFFFF) << 32),
            bw / 2)
        if (bw & 1) != 0 {
            __mmio_write32((p +% (bw - 1) *% 4) as *mut u32, color as u32)
        }
        r = r + 1
    }
}

fn fill_words(p: u64, value: u64, words: u64) {
    if words == 0 {
        return
    }
    arch.fill_words(p, value, words)
}

fn copy_words(dst: u64, src: u64, words: u64) {
    if words == 0 {
        return
    }
    arch.copy_words(dst, src, words)
}

// Eine Farbe mit Deckkraft ueber eine andere. Ganzzahlig und ohne
// Rundungsbeiwerk -- `tools/ttf/raster.py` und `tools/gfx/schau.py`
// rechnen dieselbe Zeile, sonst waere ein bildpunktgenauer Vergleich
// eines kantengeglaetteten Zeichens nicht moeglich.
fn blend(alt: u64, neu: u64, a: u64) -> u64 {
    if a == 0 {
        return alt
    }
    if a >= 255 {
        return neu
    }
    let ia: u64 = 255 - a
    let r: u64 = (((alt >> 16) & 0xFF) * ia + ((neu >> 16) & 0xFF) * a) / 255
    let g: u64 = (((alt >> 8) & 0xFF) * ia + ((neu >> 8) & 0xFF) * a) / 255
    let b: u64 = ((alt & 0xFF) * ia + (neu & 0xFF) * a) / 255
    return (r << 16) | (g << 8) | b
}

// Eine Zeile Text in ein Fenster, mit Kantenglaettung und
// Unterschneidung. `y` ist die GRUNDLINIE, nicht die Oberkante -- das
// ist die Groesse, mit der Schriften rechnen, und die einzige, an der
// zwei Schriftgroessen nebeneinander stehen koennen.
fn text(state: u64, i: u64, f: u64, px: u64, x: i64, y: i64, p: u64,
    n: u64, color: u64) -> i64 {
    if !valid(state, i) || f >= ttf.MAX_FONTS {
        return x
    }
    var cx: i64 = x * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let c: u64 = kstate.get8(p + k)
        if c == 0 {
            k = n
        } else {
            let gid: u64 = ttf.glyph_of(state, f, c)
            if vorher != 0 {
                cx = cx + ttf.kern26(state, f, vorher, gid, px)
            }
            let slot: u64 = ttf.glyph(state, f, c, px)
            if slot < ttf.SLOTS {
                draw_glyph(state, i, slot, cx >> 6, y, color)
                cx = cx + ttf.g_adv(state, slot)
            } else {
                cx = cx + ttf.advance26(state, f, gid, px)
            }
            vorher = gid
            k = k + 1
        }
    }
    return cx >> 6
}

fn draw_glyph(state: u64, i: u64, slot: u64, x: i64, y: i64, color: u64) {
    draw_glyph_clip(state, i, slot, x, y, color, 0,
        wg(state, i, W_W) as i64)
}

// EINE GLYPHE, AUF EINEN SENKRECHTEN STREIFEN BESCHNITTEN.
//
// Im Terminal ist der Streifen die ZELLE, und das ist keine Feinheit:
// DejaVu Sans Mono hat bei sechzehn Bildpunkten eine Laufweite von
// 9,625, die Zelle ist also zehn breit -- und 'W', 'V' und 'M' sind
// BREITER als zehn. Ohne Beschnitt ragen sie in die naechste Zelle,
// und sobald dort ein Zeichen geschrieben wird, loescht dessen
// Hintergrund die Haelfte des vorigen wieder weg. Gemessen: von 1413
// Tintenpunkten einer Zeile waren 146 falsch, und alle davon standen am
// rechten Rand eines breiten Buchstabens. Mit Beschnitt sind es null,
// und das Bild zeigt, was ein Terminal zeigt.
fn draw_glyph_clip(state: u64, i: u64, slot: u64, x: i64, y: i64,
    color: u64, cx0: i64, cx1: i64) {
    let gw: u64 = ttf.g_w(state, slot)
    let gh: u64 = ttf.g_h(state, slot)
    if gw == 0 || gh == 0 {
        return
    }
    let x0: i64 = x + ttf.g_left(state, slot)
    let y0: i64 = y - ttf.g_top(state, slot)
    var ww: i64 = wg(state, i, W_W) as i64
    let wh: i64 = wg(state, i, W_H) as i64
    var lo: i64 = cx0
    if lo < 0 {
        lo = 0
    }
    if cx1 < ww {
        ww = cx1
    }
    var r: u64 = 0
    while r < gh {
        let py: i64 = y0 + r as i64
        if py >= 0 && py < wh {
            var c: u64 = 0
            while c < gw {
                let pxx: i64 = x0 + c as i64
                if pxx >= lo && pxx < ww {
                    let a: u64 = ttf.g_pixel(state, slot, c, r)
                    if a != 0 {
                        wpixel(state, i, pxx as u64, py as u64,
                            blend(wget(state, i, pxx as u64, py as u64),
                                color, a))
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

// Ein Rechteck aus fremdem Speicher in ein Fenster -- das, was eine
// Anwendung braucht, die selbst malt.
fn blit_in(state: u64, i: u64, src: u64, x: u64, y: u64, w: u64,
    h: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    let ww: u64 = wg(state, i, W_W)
    if x >= ww || y >= wg(state, i, W_H) {
        return 0
    }
    var bw: u64 = w
    var bh: u64 = h
    if x + bw > ww {
        bw = ww - x
    }
    if y + bh > wg(state, i, W_H) {
        bh = wg(state, i, W_H) - y
    }
    var r: u64 = 0
    while r < bh {
        copy_words(wg(state, i, W_BUF) +% (y + r) *% ww *% 4 +% x *% 4,
            src +% r *% w *% 4, bw *% 4 / 8)
        if (bw & 1) != 0 {
            __mmio_write32((wg(state, i, W_BUF) +% (y + r) *% ww *% 4
                +% (x + bw - 1) *% 4) as *mut u32,
                __mmio_read32((src +% r *% w *% 4 +% (bw - 1) *% 4)
                    as *mut u32))
        }
        r = r + 1
    }
    return bw * bh
}

fn flush_win(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    damage_win(state, i)
}

// ------------------------------------------------- das Zusammensetzen

// Der Zeiger. Achtzehn Zeilen zu zwoelf Bildpunkten, als zwei
// Bitmasken je Zeile: Umriss und Fuellung. Warum von Hand und nicht als
// Bilddatei: es sind 72 Oktette, und ein Zeiger, der aus einer Datei
// kommt, fehlt genau dann, wenn man ihn zum Suchen des Fehlers braucht.
const CUR_W: u64 = 12
const CUR_H: u64 = 18

fn cursor_row(r: u64, fuell: bool) -> u64 {
    return cursor_row_of(0, r, fuell)
}

// RUNDE K15: ZWEI ZEIGERBILDER STATT EINEM. Der Balken ist mechanisch
// aus dem Pfeil-Verfahren entstanden und nicht von Hand gemalt: die
// Fuellung ist der Balken, der Umriss ist die Fuellung um einen
// Bildpunkt geweitet. Damit ist er ueber JEDEM Untergrund zu sehen --
// derselbe Grund, aus dem der Pfeil einen schwarzen Rand hat.
fn cursor_row_of(form: u64, r: u64, fuell: bool) -> u64 {
    // Bit 11 ist links.
    var umriss: [u8; 37] = b"\x08\x00\x0c\x00\x0a\x00\x09\x00\x08\x80\x08\x40\x08\x20\x08\x10\x08\x08\x08\x04\x08\x02\x0b\xff\x0c\x88\x0a\x48\x02\x48\x01\x24\x01\x24\x00\xfc\x00"
    var innen: [u8; 37] = b"\x00\x00\x00\x00\x04\x00\x06\x00\x07\x00\x07\x80\x07\xc0\x07\xe0\x07\xf0\x07\xf8\x07\xfc\x04\x00\x03\x70\x01\xb0\x01\xb0\x00\xd8\x00\xd8\x00\x00\x00"
    var bumriss: [u8; 37] = b"\x03\xfc\x03\xfc\x03\xfc\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x03\xfc\x03\xfc\x03\xfc\x00"
    var binnen: [u8; 37] = b"\x00\x00\x01\xf8\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x01\xf8\x00\x00\x00"
    if r >= CUR_H {
        return 0
    }
    var p: u64 = 0
    if form == 1 {
        if fuell {
            p = (&binnen[0]) as u64 + r * 2
        } else {
            p = (&bumriss[0]) as u64 + r * 2
        }
    } else {
        if fuell {
            p = (&innen[0]) as u64 + r * 2
        } else {
            p = (&umriss[0]) as u64 + r * 2
        }
    }
    return (kstate.get8(p) << 8) | kstate.get8(p + 1)
}

fn shape(state: u64) -> u64 {
    return gs(state, S_SHAPE)
}

// Das Bild wechseln und die STELLE schmutzig machen, an der der Zeiger
// gerade steht -- sonst steht das alte Bild dort, bis sich die Maus
// bewegt.
fn set_shape(state: u64, s: u64) {
    if s > 1 || !ready(state) {
        return
    }
    if gs(state, S_SHAPE) == s {
        return
    }
    ss(state, S_SHAPE, s)
    let mx: i64 = gs(state, S_CURX) as i64
    let my: i64 = gs(state, S_CURY) as i64
    damage(state, mx, my, mx + CUR_W as i64, my + CUR_H as i64)
}

// Eine Bildzeile des zusammengesetzten Bildes. Der Hintergrund, dann
// von unten nach oben jedes Fenster, das diese Stelle beruehrt.
fn compose(state: u64) -> u64 {
    if !ready(state) || !fb.ready(state) {
        return 0
    }
    if gs(state, S_DON) == 0 {
        return 0
    }
    let x0: u64 = gs(state, S_DX0)
    let y0: u64 = gs(state, S_DY0)
    let x1: u64 = gs(state, S_DX1)
    let y1: u64 = gs(state, S_DY1)
    ss(state, S_DON, 0)
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    // 1. der Hintergrund
    fb.fill(state, x0, y0, x1 - x0, y1 - y0, gs(state, S_DESK))
    // 1b. die Reiter- und Stapelzeilen des Baumes. Sie liegen UNTER den
    //     Fenstern und ueberschneiden sie nicht -- der Baum hat ihre
    //     Hoehe von der Flaeche der Kinder abgezogen.
    if gs(state, S_TILE) != 0 {
        paint_bars(state, x0, y0, x1, y1)
    }
    // 2. die Fenster, von unten nach oben
    var z: u64 = 0
    while z < gs(state, S_COUNT) {
        let i: u64 = at_z(state, z)
        // RUNDE DESKTOP: ein minimiertes Fenster wird uebergangen. Es
        // ist der einzige Unterschied zwischen "minimiert" und
        // "geschlossen", den das Zusammensetzen sieht.
        // RUNDE TILING: und ein Fenster, das hinter einem Reiter liegt,
        // ebenfalls. Zwei Gruende, nicht zu malen, ZWEI Bits -- die
        // Runde TILING hatte dafuer ein eigenes Wort, aber "minimiert"
        // und "hinter einem Reiter" muessen sich getrennt aufheben
        // lassen.
        if i < MAX_WIN && (wg(state, i, W_FLAGS) & (F_HIDDEN | F_TABBED)) == 0 {
            paint_win(state, i, x0, y0, x1, y1)
        }
        z = z + 1
    }
    // 2b. das Vorschaurechteck beim Ziehen -- ueber den Fenstern, unter
    //     dem Zeiger.
    if gs(state, S_PVON) != 0 {
        paint_preview(state, x0, y0, x1, y1)
    }
    // 3. der Zeiger, ganz oben
    if gs(state, S_CURON) != 0 {
        paint_cursor(state, x0, y0, x1, y1)
    }
    fb.dirty(state, y0, y1)
    fb.flush(state)
    ss(state, S_COMPOSITES, gs(state, S_COMPOSITES) + 1)
    ss(state, S_PIXELS, gs(state, S_PIXELS) + (x1 - x0) * (y1 - y0))
    return (x1 - x0) * (y1 - y0)
}

// WIE VIELE TASTEN BEI DIESEM FENSTER ANGEKOMMEN SIND. Die Zahl ist die
// Gegenprobe zum Eingabefokus: mit Fokus MUSS sie beim unbeteiligten
// Fenster null sein, mit `nofocus` MUSS sie es nicht sein. Ohne diese
// zwei Zahlen waere "die Taste geht an das richtige Fenster" eine
// Behauptung ueber etwas, das man im Bild nicht sieht.
fn win_keys(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return 0
    }
    return wg(state, i, W_KEYS)
}

fn downs(state: u64) -> u64 {
    return gs(state, S_DOWNS)
}

fn moves_seen(state: u64) -> u64 {
    return gs(state, S_MOVES)
}

fn hits_seen(state: u64) -> u64 {
    return gs(state, S_HITS)
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

// Ein Fenster in den schmutzigen Bereich. Rahmen, Titelleiste,
// Schliessfeld, Groessengriff -- und dann die Flaeche der Anwendung.
fn paint_win(state: u64, i: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let wx: i64 = win_x(state, i)
    let wy: i64 = win_y(state, i)
    let ow: i64 = outer_w(state, i) as i64
    let oh: i64 = outer_h(state, i) as i64
    let ax0: i64 = imax(wx, cx0 as i64)
    let ay0: i64 = imax(wy, cy0 as i64)
    let ax1: i64 = imin(wx + ow, cx1 as i64)
    let ay1: i64 = imin(wy + oh, cy1 as i64)
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    // OHNE SCHMUCK: kein Rahmen, keine Titelleiste, kein Schliessfeld.
    // Die Flaeche der Anwendung faengt am aeusseren Rechteck an, und der
    // ganze Rest dieser Funktion entfaellt. Ein Schreibtisch mit
    // Titelleiste waere keiner.
    if !deko(state, i) {
        let bx0: i64 = imax(wx, cx0 as i64)
        let by0: i64 = imax(wy, cy0 as i64)
        let bx1: i64 = imin(wx + wg(state, i, W_W) as i64, cx1 as i64)
        let by1: i64 = imin(wy + wg(state, i, W_H) as i64, cy1 as i64)
        if bx1 <= bx0 || by1 <= by0 {
            return
        }
        let bw: u64 = wg(state, i, W_W)
        let bq: u64 = wg(state, i, W_BUF)
        let bn: u64 = (bx1 - bx0) as u64
        var br: i64 = by0
        while br < by1 {
            fb_row(state, bx0 as u64, br as u64,
                bq +% (br - wy) as u64 *% bw *% 4
                +% (bx0 - wx) as u64 *% 4, bn)
            br = br + 1
        }
        ss(state, S_BLITS, gs(state, S_BLITS) + 1)
        return
    }
    let aktiv: bool = focus(state) == i
    var rahmen: u64 = fb.rgb(state, 0x3A, 0x46, 0x54)
    var leiste: u64 = fb.rgb(state, 0x2C, 0x38, 0x48)
    var schrift: u64 = fb.rgb(state, 0x90, 0x9C, 0xA8)
    if aktiv {
        rahmen = fb.rgb(state, 0x4C, 0x9A, 0xE8)
        leiste = fb.rgb(state, 0x1C, 0x4E, 0x7E)
        schrift = fb.rgb(state, 0xFF, 0xFF, 0xFF)
    }
    // Der ganze Aussenbereich in Rahmenfarbe, danach die Leiste und die
    // Flaeche darueber. Das ist ein Rechteck mehr als noetig und spart
    // vier Sonderfaelle an den Ecken.
    fb.fill(state, ax0 as u64, ay0 as u64, (ax1 - ax0) as u64,
        (ay1 - ay0) as u64, rahmen)
    // die Titelleiste
    let tx0: i64 = imax(wx + BORDER as i64, ax0)
    let tx1: i64 = imin(wx + ow - BORDER as i64, ax1)
    let ty0: i64 = imax(wy + BORDER as i64, ay0)
    let ty1: i64 = imin(wy + TITLE_H as i64 - 1, ay1)
    if tx1 > tx0 && ty1 > ty0 {
        fb.fill(state, tx0 as u64, ty0 as u64, (tx1 - tx0) as u64,
            (ty1 - ty0) as u64, leiste)
    }
    // das Schliessfeld: ein Kreuz aus zwei Linien in einem Feld
    let bx: i64 = wx + ow - BORDER as i64 - CLOSE_W as i64 - 3
    let by: i64 = wy + 4
    if bx + CLOSE_W as i64 > ax0 && bx < ax1 && by + CLOSE_W as i64 > ay0 {
        let rot: u64 = fb.rgb(state, 0xD0, 0x40, 0x40)
        fb.fill(state, bx as u64, by as u64, CLOSE_W, CLOSE_W, rot)
        let weiss: u64 = fb.rgb(state, 0xFF, 0xFF, 0xFF)
        var k: u64 = 3
        while k < CLOSE_W - 3 {
            fb.pixel(state, (bx + k as i64) as u64, (by + k as i64) as u64,
                weiss)
            fb.pixel(state, (bx + k as i64) as u64,
                (by + (CLOSE_W - 1 - k) as i64) as u64, weiss)
            k = k + 1
        }
    }
    // der Titel
    let f: u64 = gs(state, S_FONT_UI)
    if f < ttf.MAX_FONTS {
        title_text(state, i, f, wx + BORDER as i64 + 5,
            wy + BORDER as i64 + ttf.ascent(state, f, gs(state, S_PX_UI)),
            schrift, ax0, ay0, ax1, ay1, bx)
    }
    // die Flaeche der Anwendung
    let px0: i64 = wx + BORDER as i64
    let py0: i64 = wy + TITLE_H as i64
    let sx0: i64 = imax(px0, ax0)
    let sy0: i64 = imax(py0, ay0)
    let sx1: i64 = imin(px0 + wg(state, i, W_W) as i64, ax1)
    let sy1: i64 = imin(py0 + wg(state, i, W_H) as i64, ay1)
    if sx1 <= sx0 || sy1 <= sy0 {
        return
    }
    let ww: u64 = wg(state, i, W_W)
    let quelle: u64 = wg(state, i, W_BUF)
    let n: u64 = (sx1 - sx0) as u64
    var r: i64 = sy0
    while r < sy1 {
        let zeile: u64 = (r - py0) as u64
        let spalte: u64 = (sx0 - px0) as u64
        fb_row(state, sx0 as u64, r as u64,
            quelle +% zeile *% ww *% 4 +% spalte *% 4, n)
        r = r + 1
    }
    ss(state, S_BLITS, gs(state, S_BLITS) + 1)
}

// Eine Bildzeile aus einem Fensterpuffer in den Zweitpuffer des
// Bildschirms. Ueber `rep movsq`, wie alles andere in `fb.fi` -- eine
// Schleife aus Einzelzugriffen kostete dort gemessen den Faktor acht.
fn fb_row(state: u64, x: u64, y: u64, src: u64, n: u64) {
    let ziel: u64 = fb.draw_at(state) +% y *% fb.pitch(state) +% x *% 4
    copy_words(ziel, src, n *% 4 / 8)
    if (n & 1) != 0 {
        __mmio_write32((ziel +% (n - 1) *% 4) as *mut u32,
            __mmio_read32((src +% (n - 1) *% 4) as *mut u32))
    }
}

// Der Titel, auf die Breite bis zum Schliessfeld beschnitten.
fn title_text(state: u64, i: u64, f: u64, x: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64, grenze: i64) {
    let px: u64 = gs(state, S_PX_UI)
    var cx: i64 = x * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < 31 {
        // `wat` ALREADY CARRIES kstate.DSK_OFF since round DESKTOP moved
        // the window table out of WM_OFF. This one reader kept adding
        // WM_OFF on top of it and has been reading zeros ever since:
        // every window title on the screen was empty, and three claims
        // in tools/wm/run.sh said so ("LEER: K l i c k m i c h").
        // `set_title` twelve hundred lines up was changed, this was not.
        let c: u64 = kstate.get8(state + wat(i) + W_TITLE + k)
        if c == 0 {
            k = 31
        } else {
            let gid: u64 = ttf.glyph_of(state, f, c)
            if vorher != 0 {
                cx = cx + ttf.kern26(state, f, vorher, gid, px)
            }
            let slot: u64 = ttf.glyph(state, f, c, px)
            if slot < ttf.SLOTS {
                if (cx >> 6) + ttf.g_w(state, slot) as i64 > grenze - 4 {
                    return
                }
                fb_glyph(state, slot, cx >> 6, y, color, ax0, ay0, ax1, ay1)
                cx = cx + ttf.g_adv(state, slot)
            } else {
                cx = cx + ttf.advance26(state, f, gid, px)
            }
            vorher = gid
            k = k + 1
        }
    }
}

// Eine Glyphe unmittelbar in den Zweitpuffer -- fuer alles, was der
// SERVER malt (Titel), nicht die Anwendung.
fn fb_glyph(state: u64, slot: u64, x: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let gw: u64 = ttf.g_w(state, slot)
    let gh: u64 = ttf.g_h(state, slot)
    let x0: i64 = x + ttf.g_left(state, slot)
    let y0: i64 = y - ttf.g_top(state, slot)
    var r: u64 = 0
    while r < gh {
        let py: i64 = y0 + r as i64
        if py >= ay0 && py < ay1 {
            var c: u64 = 0
            while c < gw {
                let pxx: i64 = x0 + c as i64
                if pxx >= ax0 && pxx < ax1 {
                    let a: u64 = ttf.g_pixel(state, slot, c, r)
                    if a != 0 {
                        fb.pixel(state, pxx as u64, py as u64,
                            blend(fb.get_pixel(state, pxx as u64,
                                py as u64), color, a))
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

fn paint_cursor(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let mx: i64 = gs(state, S_CURX) as i64
    let my: i64 = gs(state, S_CURY) as i64
    let schwarz: u64 = fb.rgb(state, 0, 0, 0)
    let weiss: u64 = fb.rgb(state, 0xFF, 0xFF, 0xFF)
    var r: u64 = 0
    while r < CUR_H {
        let py: i64 = my + r as i64
        if py >= cy0 as i64 && py < cy1 as i64 {
            let u: u64 = cursor_row_of(gs(state, S_SHAPE), r, false)
            let f: u64 = cursor_row_of(gs(state, S_SHAPE), r, true)
            var c: u64 = 0
            while c < CUR_W {
                let pxx: i64 = mx + c as i64
                if pxx >= cx0 as i64 && pxx < cx1 as i64 {
                    let bit: u64 = 1 << (11 - c)
                    if (f & bit) != 0 {
                        fb.pixel(state, pxx as u64, py as u64, weiss)
                    } else {
                        if (u & bit) != 0 {
                            fb.pixel(state, pxx as u64, py as u64, schwarz)
                        }
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

// ------------------------------------------------------- die Ereignisse

fn ev_at(state: u64, i: u64, k: u64) -> u64 {
    return state + kstate.DSK_OFF + EV_OFF + i * EV_RING
        + (k % EV_SLOTS) * EV_BYTES
}

fn ev_push(state: u64, i: u64, typ: u64, a: u64, b: u64, c: u64) {
    if !valid(state, i) {
        return
    }
    let kopf: u64 = wg(state, i, W_EHEAD)
    if kopf - wg(state, i, W_ETAIL) >= EV_SLOTS {
        // Ein Ring, der ueberlaeuft, verliert das AELTESTE. Eine
        // Anwendung, die nicht abholt, soll nicht den Server anhalten.
        wsv(state, i, W_ETAIL, wg(state, i, W_ETAIL) + 1)
        ss(state, S_EVDROP, gs(state, S_EVDROP) + 1)
    }
    if typ == E_KEY {
        wsv(state, i, W_KEYS, wg(state, i, W_KEYS) + 1)
    }
    let p: u64 = ev_at(state, i, kopf)
    kstate.set(p, 0, typ)
    kstate.set(p, 8, ((a & 0xFFFF) << 32) | ((b & 0xFFFF) << 16) | (c & 0xFFFF))
    wsv(state, i, W_EHEAD, kopf + 1)
}

fn ev_waiting(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return wg(state, i, W_EHEAD) - wg(state, i, W_ETAIL)
}

// Holt ein Ereignis. `out` bekommt zwei Achtoktettworte: Art und Daten.
fn ev_pop(state: u64, i: u64, out: u64) -> bool {
    if ev_waiting(state, i) == 0 {
        return false
    }
    let schwanz: u64 = wg(state, i, W_ETAIL)
    let p: u64 = ev_at(state, i, schwanz)
    kstate.set(out, 0, kstate.get(p, 0))
    kstate.set(out, 8, kstate.get(p, 8))
    wsv(state, i, W_ETAIL, schwanz + 1)
    return true
}

// ------------------------------------------------------- die Eingabe

// Welches Fenster liegt an dieser Stelle -- das OBERSTE. Gibt MAX_WIN,
// wenn dort der Hintergrund ist.
fn hit(state: u64, x: i64, y: i64) -> u64 {
    var z: u64 = gs(state, S_COUNT)
    while z > 0 {
        z = z - 1
        let i: u64 = at_z(state, z)
        if i < MAX_WIN && (wg(state, i, W_FLAGS) & (F_HIDDEN | F_TABBED)) == 0 {
            let rx: i64 = win_x(state, i) + outer_w(state, i) as i64
            let ry: i64 = win_y(state, i) + outer_h(state, i) as i64
            if x >= win_x(state, i) && y >= win_y(state, i) {
                if x < rx && y < ry {
                    return i
                }
            }
        }
    }
    return MAX_WIN
}

// Der Zeiger hat sich bewegt oder eine Taste gewechselt. Wird aus der
// Unterbrechungsbehandlung heraus gerufen; alles, was hier passiert,
// muss ohne Warten auskommen.
fn on_mouse(state: u64) {
    if !ready(state) {
        return
    }
    let nx: u64 = ps2m.x(state)
    let ny: u64 = ps2m.y(state)
    let ox: u64 = gs(state, S_CURX)
    let oy: u64 = gs(state, S_CURY)
    let btn: u64 = ps2m.buttons(state)
    if nx != ox || ny != oy {
        // DIE WIEDERHERSTELLUNG DES HINTERGRUNDS. Beide Rechtecke --
        // das alte und das neue -- werden schmutzig; `compose` malt
        // dort den Hintergrund und die Fenster neu und danach den
        // Zeiger. Ein gerettetes Rechteck waere der zweite Weg dahin
        // und muesste bei jedem Fensterwechsel nachgezogen werden.
        damage(state, ox as i64, oy as i64, (ox + CUR_W) as i64,
            (oy + CUR_H) as i64)
        ss(state, S_CURX, nx)
        ss(state, S_CURY, ny)
        damage(state, nx as i64, ny as i64, (nx + CUR_W) as i64,
            (ny + CUR_H) as i64)
    }
    let x: i64 = nx as i64
    let y: i64 = ny as i64
    // Ziehen
    if gs(state, S_DRAG) != 0 {
        let i: u64 = gs(state, S_DRAG) - 1
        if (btn & ps2m.B_LEFT) == 0 {
            ss(state, S_DRAG, 0)
            drag_end(state, i, x, y)
        } else {
            move_win(state, i, x - gs(state, S_DRAGX) as i64,
                y - gs(state, S_DRAGY) as i64)
            drag_hover(state, i, x, y)
            return
        }
    }
    if gs(state, S_SIZING) != 0 {
        let i: u64 = gs(state, S_SIZING) - 1
        if (btn & ps2m.B_LEFT) == 0 {
            ss(state, S_SIZING, 0)
        } else {
            // RUNDE TILING: ein Fenster IM BAUM wird nicht frei
            // gezogen -- es verschiebt die Trennlinie.
            if wg(state, i, W_NODE) != 0 {
                tile_drag_resize(state, i, x, y)
                return
            }
            // RUNDE DESKTOP: der Rand kommt aus `inx`/`iny` und nicht
            // aus BORDER/TITLE_H -- ein Fenster ohne Schmuck (F_NODECO,
            // Schreibtisch und Taskleiste) hat keinen.
            var nw: i64 = x - win_x(state, i) - inx(state, i) as i64
            var nh: i64 = y - win_y(state, i) - iny(state, i) as i64
            if nw < 32 {
                nw = 32
            }
            if nh < 16 {
                nh = 16
            }
            resize_win(state, i, nw as u64, nh as u64)
            return
        }
    }
    ss(state, S_MOVES, gs(state, S_MOVES) + 1)
    let i: u64 = hit(state, x, y)
    if i >= MAX_WIN {
        return
    }
    ss(state, S_HITS, gs(state, S_HITS) + 1)
    let lokal_x: i64 = x - win_x(state, i) - inx(state, i) as i64
    let lokal_y: i64 = y - win_y(state, i) - iny(state, i) as i64
    let mit_schmuck: bool = deko(state, i)
    // Tastenwechsel erkennen: `ps2m` fuehrt den Zustand, hier steht der
    // zuletzt GESEHENE.
    let alt: u64 = gs(state, S_KEYS) & 7
    if btn != alt {
        ss(state, S_KEYS, (gs(state, S_KEYS) & ~7) | btn)
        if (btn & ps2m.B_LEFT) != 0 && (alt & ps2m.B_LEFT) == 0 {
            raise_win(state, i)
            // RUNDE DESKTOP: SCHREIBTISCH UND TASKLEISTE NEHMEN DIE
            // TASTATUR NICHT. Wer auf die Leiste klickt, will ein
            // Fenster wechseln und nicht in die Leiste tippen -- und
            // ein Schreibtisch, der den Fokus an sich zieht, macht
            // jeden Tastendruck danach wirkungslos.
            if wg(state, i, W_LAYER) == L_NORMAL {
                set_focus(state, i)
            }
            if mit_schmuck {
                // Schliessfeld?
                let bx: i64 = win_x(state, i) + outer_w(state, i) as i64
                    - BORDER as i64 - CLOSE_W as i64 - 3
                let by: i64 = win_y(state, i) + 4
                let im_feld: bool = x >= bx && x < bx + CLOSE_W as i64
                let im_feld2: bool = y >= by && y < by + CLOSE_W as i64
                if im_feld && im_feld2 {
                    ev_push(state, i, E_CLOSE, 0, 0, 0)
                    destroy(state, i)
                    return
                }
                if lokal_y < 0 {
                    // die Titelleiste: ziehen
                    // RUNDE TILING: wer aus dem Baum gezogen wird, muss
                    // sich merken, dass er darin war.
                    drag_begin(state, i)
                    ss(state, S_DRAG, i + 1)
                    ss(state, S_DRAGX, (x - win_x(state, i)) as u64)
                    ss(state, S_DRAGY, (y - win_y(state, i)) as u64)
                    return
                }
                // der Griff unten rechts
                let gx: bool = lokal_x
                    >= wg(state, i, W_W) as i64 - GRIP as i64
                let gy: bool = lokal_y
                    >= wg(state, i, W_H) as i64 - GRIP as i64
                if gx && gy {
                    ss(state, S_SIZING, i + 1)
                    return
                }
            }
            ss(state, S_DOWNS, gs(state, S_DOWNS) + 1)
            ev_push(state, i, E_DOWN, lokal_x as u64, lokal_y as u64, btn)
            return
        }
        if (btn & ps2m.B_LEFT) == 0 && (alt & ps2m.B_LEFT) != 0 {
            ev_push(state, i, E_UP, lokal_x as u64, lokal_y as u64, alt)
            return
        }
        // RUNDE K15: DIE RECHTE TASTE. Runde K10 sah nur die linke an --
        // sie brauchte nicht mehr, und der Rest lief still ueber die
        // Zustandsmaske. Ein Kontextmenue gibt es ohne rechte Taste
        // nicht, also kommt sie hier dazu: dieselben zwei Ereignisse,
        // dieselben Ortskoordinaten, und die Tastenmaske steht wie bei
        // der linken im dritten Wort. KEIN Heben und KEIN Fokuswechsel
        // dabei -- ein Rechtsklick soll das Fenster nicht umsortieren,
        // sondern nur fragen.
        if (btn & ps2m.B_RIGHT) != 0 && (alt & ps2m.B_RIGHT) == 0 {
            if lokal_x >= 0 && lokal_y >= 0 {
                ss(state, S_DOWNS, gs(state, S_DOWNS) + 1)
                ev_push(state, i, E_DOWN, lokal_x as u64, lokal_y as u64,
                    btn)
            }
            return
        }
        if (btn & ps2m.B_RIGHT) == 0 && (alt & ps2m.B_RIGHT) != 0 {
            if lokal_x >= 0 && lokal_y >= 0 {
                ev_push(state, i, E_UP, lokal_x as u64, lokal_y as u64,
                    alt)
            }
            return
        }
    }
    if lokal_x >= 0 && lokal_y >= 0 {
        ev_push(state, i, E_MOVE, lokal_x as u64, lokal_y as u64, btn)
    }
}

// Eine Taste. Sie geht an das Fenster mit dem EINGABEFOKUS -- und mit
// `nofocus` an alle, damit die Zusage darueber etwas wert ist.
fn on_key(state: u64, c: u64) {
    if !ready(state) || c == 0 {
        return
    }
    if gs(state, S_NOFOCUS) != 0 {
        var i: u64 = 0
        while i < MAX_WIN {
            if wg(state, i, W_USED) != 0 {
                ev_push(state, i, E_KEY, c, 0, 0)
            }
            i = i + 1
        }
        return
    }
    let f: u64 = focus(state)
    if f < MAX_WIN {
        ev_push(state, f, E_KEY, c, 0, 0)
    }
}

// Wird aus der Hauptschleife gerufen: hat sich am Zeiger etwas getan?
fn poll(state: u64) -> bool {
    if !ready(state) {
        return false
    }
    // RUNDE TILING: erst die Tastenkuerzel. Sie liegen im Ring, den
    // `kbd.irq` fuellt, wenn Alt gehalten wird -- der Fensterserver
    // HOLT sie ab, statt dass die Tastatur ihn kennt.
    hotkeys(state)
    // DER RUECKFALL AUF ABFRAGE, und er steht hier mit Begruendung.
    //
    // Der Baustein meldet ueber IRQ 12, und das ist der Weg, den dieser
    // Treiber geht. Es gibt aber einen Zustand, in dem die Unterbrechung
    // AUSBLEIBT und trotzdem ein Oktett bereitliegt: das Zustandstor
    // sagt dann "Ausgabepuffer voll" (Bit 0) und "vom zweiten Anschluss"
    // (Bit 5). Wer nur auf die Unterbrechung wartet, hat dann einen
    // Zeiger, der stehenbleibt, und keinen Hinweis darauf, warum.
    //
    // Also wird hier NACHGESEHEN. Wie viele Oktette auf welchem der
    // beiden Wege kamen, steht in `irqs` und `polls` und wird gemeldet
    // -- eine Abfrage, die als Unterbrechung ausgegeben wird, waere eine
    // Luege ueber den Treiber.
    if ps2m.present(state) && ps2m.polling(state) {
        var n: u64 = 0
        while n < 64 && ps2m.poll_one(state) {
            // NACH JEDEM VOLLSTAENDIGEN PAKET, nicht am Ende des
            // Stapels: ein Druck und das Loslassen danach sind zwei
            // Pakete, und wer beide zusammen abholt und DANN nachsieht,
            // findet die Taste wieder oben und hat den Klick verloren.
            if ps2m.changed(state) {
                ps2m.take_change(state)
                on_mouse(state)
            }
            n = n + 1
        }
    }
    if !ps2m.changed(state) {
        return false
    }
    ps2m.take_change(state)
    on_mouse(state)
    return true
}

// ------------------------------------------------------ das Terminal
//
// Ein Fenster mit einem ZEICHENRASTER. Die Anwendung schickt Oktette,
// der Server fuehrt dieselbe Zustandsmaschine wie `fb.putc` (Umbruch,
// Rollen, Tabulator, Ruecktaste) und malt die Zellen mit der
// Festbreitenschrift. Damit kann eine Shell in einem Fenster laufen,
// ohne von Schriften etwas zu wissen.

fn term_setup(state: u64, i: u64) {
    let f: u64 = gs(state, S_FONT_MONO)
    var cw: u64 = 8
    var ch: u64 = 16
    if f < ttf.MAX_FONTS {
        let px: u64 = gs(state, S_PX_MONO)
        let gid: u64 = ttf.glyph_of(state, f, 0x4D) // 'M'
        cw = ((ttf.advance26(state, f, gid, px) + 63) >> 6) as u64
        ch = ttf.line_height(state, f, px)
    }
    if cw == 0 {
        cw = 8
    }
    if ch == 0 {
        ch = 16
    }
    wsv(state, i, W_CELLW, cw)
    wsv(state, i, W_CELLH, ch)
    let cols: u64 = wg(state, i, W_W) / cw
    let rows: u64 = wg(state, i, W_H) / ch
    wsv(state, i, W_COLS, cols)
    wsv(state, i, W_ROWS, rows)
    wsv(state, i, W_CX, 0)
    wsv(state, i, W_CY, 0)
    if wg(state, i, W_GRID) == 0 {
        let g: u64 = mem.frame_run(state, 1)
        wsv(state, i, W_GRID, g)
    }
    let g: u64 = wg(state, i, W_GRID)
    if g != 0 {
        var k: u64 = 0
        while k < cols * rows && k < 4096 {
            kstate.set8(g + k, 32 as u8)
            k = k + 1
        }
    }
    fill(state, i, 0, 0, wg(state, i, W_W), wg(state, i, W_H),
        wg(state, i, W_BG))
}

fn cell_set(state: u64, i: u64, c: u64, r: u64, ch: u64) {
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 {
        return
    }
    let k: u64 = r * wg(state, i, W_COLS) + c
    if k >= 4096 {
        return
    }
    kstate.set8(g + k, ch as u8)
}

fn cell_get(state: u64, i: u64, c: u64, r: u64) -> u64 {
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 {
        return 32
    }
    let k: u64 = r * wg(state, i, W_COLS) + c
    if k >= 4096 {
        return 32
    }
    return kstate.get8(g + k)
}

fn cell_paint(state: u64, i: u64, c: u64, r: u64) {
    let cw: u64 = wg(state, i, W_CELLW)
    let ch: u64 = wg(state, i, W_CELLH)
    let f: u64 = gs(state, S_FONT_MONO)
    fill(state, i, c * cw, r * ch, cw, ch, wg(state, i, W_BG))
    let z: u64 = cell_get(state, i, c, r)
    if z <= 32 || f >= ttf.MAX_FONTS {
        return
    }
    let px: u64 = gs(state, S_PX_MONO)
    let slot: u64 = ttf.glyph(state, f, z, px)
    if slot < ttf.SLOTS {
        draw_glyph_clip(state, i, slot, (c * cw) as i64,
            (r * ch) as i64 + ttf.ascent(state, f, px), wg(state, i, W_FG),
            (c * cw) as i64, ((c + 1) * cw) as i64)
    }
}

fn term_scroll(state: u64, i: u64) {
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    var r: u64 = 1
    while r < rows {
        var c: u64 = 0
        while c < cols {
            cell_set(state, i, c, r - 1, cell_get(state, i, c, r))
            c = c + 1
        }
        r = r + 1
    }
    var c2: u64 = 0
    while c2 < cols {
        cell_set(state, i, c2, rows - 1, 32)
        c2 = c2 + 1
    }
    // Der Bildinhalt wandert mit -- eine Zeile nach oben, statt alle
    // Zellen neu zu malen. Das ist derselbe Griff wie in `fb.scroll`.
    let cw: u64 = wg(state, i, W_CELLW)
    let ch: u64 = wg(state, i, W_CELLH)
    let ww: u64 = wg(state, i, W_W)
    let buf: u64 = wg(state, i, W_BUF)
    var y: u64 = 0
    while y + ch < rows * ch {
        copy_words(buf +% y *% ww *% 4, buf +% (y + ch) *% ww *% 4,
            ww *% 4 / 8)
        y = y + 1
    }
    fill(state, i, 0, (rows - 1) * ch, ww, ch, wg(state, i, W_BG))
}

fn term_putc(state: u64, i: u64, ch: u64) {
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    if cols == 0 || rows == 0 {
        return
    }
    var cx: u64 = wg(state, i, W_CX)
    var cy: u64 = wg(state, i, W_CY)
    if ch == 13 {
        wsv(state, i, W_CX, 0)
        return
    }
    if ch == 10 {
        cx = 0
        cy = cy + 1
        if cy >= rows {
            term_scroll(state, i)
            cy = rows - 1
        }
        wsv(state, i, W_CX, cx)
        wsv(state, i, W_CY, cy)
        return
    }
    if ch == 8 {
        if cx > 0 {
            cx = cx - 1
            wsv(state, i, W_CX, cx)
            cell_set(state, i, cx, cy, 32)
            cell_paint(state, i, cx, cy)
        }
        return
    }
    if ch == 9 {
        var n: u64 = 8 - (cx & 7)
        while n > 0 {
            term_putc(state, i, 32)
            n = n - 1
        }
        return
    }
    if ch < 32 || ch > 126 {
        return
    }
    cell_set(state, i, cx, cy, ch)
    cell_paint(state, i, cx, cy)
    cx = cx + 1
    if cx >= cols {
        cx = 0
        cy = cy + 1
        if cy >= rows {
            term_scroll(state, i)
            cy = rows - 1
        }
        wsv(state, i, W_CY, cy)
    }
    wsv(state, i, W_CX, cx)
}

fn term_write(state: u64, i: u64, p: u64, n: u64) -> u64 {
    if !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return 0
    }
    var k: u64 = 0
    while k < n {
        term_putc(state, i, kstate.get8(p + k))
        k = k + 1
    }
    damage_win(state, i)
    return n
}

// ------------------------------------------------------------ Zusagen

// Ein Terminalfenster an ein Terminal binden. Von da an geht `tty.emit`
// mit SINK_WINDOW hierher.
fn bind_tty(state: u64, i: u64, t: u64) {
    if !valid(state, i) {
        return
    }
    wsv(state, i, W_TTY, t + 1)
}

fn tty_of(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return NO_TTY
    }
    let t: u64 = wg(state, i, W_TTY)
    if t == 0 {
        return NO_TTY
    }
    return t - 1
}

// An WELCHES Terminal eine Taste geht: an das des Fensters mit dem
// Eingabefokus, wenn das ein Terminalfenster ist -- sonst an gar keines.
// Das ist die eine Zeile, die aus einem Bildschirm eine BEDIENBARE
// Oberflaeche macht.
fn key_tty(state: u64) -> u64 {
    if !ready(state) {
        return NO_TTY
    }
    let f: u64 = focus(state)
    if f >= MAX_WIN || wg(state, f, W_KIND) != K_TERM {
        return NO_TTY
    }
    return tty_of(state, f)
}

// EIN Oktett in ein Terminalfenster. Der Weg von `tty.emit`.
fn term_out(state: u64, i: u64, c: u64) {
    if !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return
    }
    term_putc(state, i, c)
    damage_win(state, i)
}

fn selftest(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    var n: u64 = 0
    var t1: [u8; 5] = "eins\0"
    var t2: [u8; 5] = "zwei\0"
    // 1. Ein Fenster entsteht und hat eine Flaeche.
    let a: u64 = create(state, 0, 40, 40, 200, 100, K_RAW, (&t1[0]) as u64)
    if a < MAX_WIN && win_buf(state, a) != 0 {
        n = n + 1
    }
    // 2. Ein zweites liegt DARUEBER -- die Stapelreihenfolge waechst.
    let b: u64 = create(state, 0, 100, 70, 200, 100, K_RAW, (&t2[0]) as u64)
    if b < MAX_WIN && win_z(state, b) > win_z(state, a) {
        n = n + 1
    }
    // 3. Der Treffer an einer Stelle, an der sich beide ueberschneiden,
    //    ist das OBERE. Das ist die ganze Stapelreihenfolge in einer
    //    Zeile.
    if hit(state, 150, 100) == b {
        n = n + 1
    }
    // 4. ... und daneben das untere.
    if hit(state, 50, 60) == a {
        n = n + 1
    }
    // 5. Der Hintergrund ist kein Fenster.
    if hit(state, 700, 500) == MAX_WIN {
        n = n + 1
    }
    // 6. Heben aendert die Reihenfolge wirklich.
    raise_win(state, a)
    if hit(state, 150, 100) == a && win_z(state, a) > win_z(state, b) {
        n = n + 1
    }
    // 7. Der Fokus liegt bei genau EINEM Fenster.
    set_focus(state, b)
    if focus(state) == b {
        n = n + 1
    }
    // 8. Eine Taste kommt beim Fenster mit dem Fokus an -- und NUR
    //    dort. Das ist die Zusage, die `nofocus` zum Einsturz bringt.
    let va: u64 = ev_waiting(state, a)
    let vb: u64 = ev_waiting(state, b)
    on_key(state, 0x41)
    if gs(state, S_NOFOCUS) == 0 {
        if ev_waiting(state, b) == vb + 1 && ev_waiting(state, a) == va {
            n = n + 1
        }
    } else {
        if ev_waiting(state, b) == vb + 1 && ev_waiting(state, a) == va + 1 {
            n = n + 1
        }
    }
    // 9. Und das Ereignis traegt das Zeichen, das gedrueckt wurde.
    var aus: [u8; 16] = [0 as u8; 16]
    var gefunden: bool = false
    while ev_pop(state, b, (&aus[0]) as u64) {
        if kstate.get(((&aus[0]) as u64), 0) == E_KEY {
            if (kstate.get(((&aus[0]) as u64), 8) >> 32) == 0x41 {
                gefunden = true
            }
        }
    }
    if gefunden {
        n = n + 1
    }
    // 10. Das Malen bleibt IM Fenster: ein Bildpunkt jenseits der Kante
    //     wird nicht geschrieben, und der letzte darin schon.
    fill(state, a, 0, 0, 200, 100, 0)
    wpixel(state, a, 199, 99, 0x00FF00)
    wpixel(state, a, 200, 99, 0xFF0000)
    if wget(state, a, 199, 99) == 0x00FF00 && wget(state, a, 0, 0) == 0 {
        n = n + 1
    }
    // 11. Verschieben aendert die Stelle, nicht den Inhalt.
    move_win(state, a, 300, 200)
    if win_x(state, a) == 300 && wget(state, a, 199, 99) == 0x00FF00 {
        n = n + 1
    }
    // 12. Der schmutzige Bereich deckt beide Stellen -- die alte und
    //     die neue. Ohne das bliebe ein Fenstergespenst stehen.
    if gs(state, S_NODIRTY) == 0 {
        if dirty_x0(state) <= 40 && dirty_x1(state) >= 300 {
            n = n + 1
        }
    } else {
        if dirty_x0(state) == 0 && dirty_x1(state) == gs(state, S_SW) {
            n = n + 1
        }
    }
    // 13. Ein Terminalfenster hat ein Raster, und ein Zeichen landet in
    //     der Zelle, in der es landen soll.
    var t3: [u8; 5] = "term\0"
    let t: u64 = create(state, 0, 10, 300, 200, 100, K_TERM,
        (&t3[0]) as u64)
    if t < MAX_WIN && term_cols(state, t) > 4 && term_rows(state, t) > 2 {
        n = n + 1
    }
    // 14. Zeilenvorschub und Umbruch bewegen die Schreibmarke.
    if t < MAX_WIN {
        var txt: [u8; 5] = "ab\nc\0"
        term_write(state, t, (&txt[0]) as u64, 4)
        if term_cx(state, t) == 1 && term_cy(state, t) == 1 {
            n = n + 1
        }
    }
    // 15. Schliessen gibt den Platz frei und schliesst die Luecke in der
    //     Stapelreihenfolge.
    let vorher: u64 = count(state)
    destroy(state, b)
    if count(state) == vorher - 1 && !valid(state, b) {
        var luecke: bool = false
        var z: u64 = 0
        while z < count(state) {
            if at_z(state, z) >= MAX_WIN {
                luecke = true
            }
            z = z + 1
        }
        if !luecke {
            n = n + 1
        }
    }
    // 16. GROESSE AENDERN. Der Puffer wurde beim Anlegen fuer die
    //     angefragte Flaeche geholt; kleiner geht immer, groesser nur
    //     bis dorthin. Ein Fenster, das ueber seinen eigenen Puffer
    //     hinauswaechst, waere ein Schreibzugriff daneben -- und der
    //     faellt erst auf, wenn er etwas Wichtiges trifft.
    if resize_win(state, a, 120, 60) && win_w(state, a) == 120 {
        if !resize_win(state, a, 4096, 4096) && win_w(state, a) == 120 {
            n = n + 1
        }
    }
    // 17. Und ein Terminalfenster rechnet sein Raster dabei NEU.
    if t < MAX_WIN {
        let vorher_cols: u64 = term_cols(state, t)
        if resize_win(state, t, 100, 60) {
            if term_cols(state, t) < vorher_cols && term_cols(state, t) > 0 {
                n = n + 1
            }
        }
    }
    if t < MAX_WIN {
        destroy(state, t)
    }
    // ---------------------------------------------- RUNDE DESKTOP
    // 18. Ein Fenster der Ebene L_DESK liegt UNTER einem gewoehnlichen,
    //     obwohl es SPAETER angelegt wurde. Ohne Ebenen ist das
    //     unmoeglich, und genau das stand in Logbuch K15.
    var td: [u8; 6] = "tisch\0"
    let d: u64 = create(state, 0, 0, 0, 320, 200, K_RAW, (&td[0]) as u64)
    if d < MAX_WIN {
        set_layer(state, d, L_DESK)
        if win_z(state, d) < win_z(state, a) {
            n = n + 1
        }
        // 19. Und ein Klick darauf hebt ihn NICHT ueber das andere.
        raise_win(state, d)
        if win_z(state, d) < win_z(state, a) || gs(state, S_NOLAYER) != 0 {
            n = n + 1
        }
        // 20. Verbergen nimmt ein Fenster aus der Trefferpruefung --
        //     und Wiederherstellen bringt es zurueck. Der Puffer bleibt
        //     dabei derselbe: minimiert ist nicht geschlossen.
        let puf: u64 = win_buf(state, a)
        let vorher: u64 = hit(state, 60, 60)
        set_hidden(state, a, true)
        let nachher: u64 = hit(state, 60, 60)
        set_hidden(state, a, false)
        if gs(state, S_NOMIN) == 0 {
            if vorher == a && nachher != a && win_buf(state, a) == puf {
                n = n + 1
            }
        } else {
            if vorher == a && nachher == a {
                n = n + 1
            }
        }
        // 21. Ohne Schmuck ist das aeussere Rechteck die Malflaeche --
        //     keine Titelleiste, kein Rahmen.
        set_deco(state, d, false)
        if outer_w(state, d) == win_w(state, d)
            && outer_h(state, d) == win_h(state, d) && iny(state, d) == 0 {
            n = n + 1
        }
        destroy(state, d)
    }
    // -------------------------------- ADDENDUM TASKBAR: struts and work
    // `bar` plays the taskbar, `mw` is the window that gets maximized.
    // A WINDOW OF ITS OWN AND NOT `a`, and the reason is a measurement:
    // `a` was created 200 x 100, a window never gets a bigger buffer
    // than it was created with, and `maximize` therefore refused it --
    // correctly. Five of these nine claims failed on that, and the
    // server was right every time.
    var tb: [u8; 4] = "bar\0"
    var tm: [u8; 4] = "max\0"
    let sw2: u64 = gs(state, S_SW)
    let sh2: u64 = gs(state, S_SH)
    // THIS SECTION MEASURES THE STRUTS AND THEREFORE HAS TO SWITCH THEM
    // ON, even when the machine was started with the counter-test
    // `nostrut`. It puts the setting back afterwards -- the first
    // version did not, and left the whole system with the struts
    // enabled after a `nostrut` run, so the counter-test proved nothing
    // and looked like it passed.
    let strut_was: bool = nostrut(state)
    set_nostrut(state, false)
    // 22. WITHOUT A STRUT THE WORK AREA IS THE SCREEN. Anything else
    //     and every number after this one measures the wrong rectangle.
    if work_x(state) == 0 && work_y(state) == 0
        && work_w(state) == sw2 && work_h(state) == sh2 {
        n = n + 1
    }
    let bar: u64 = create(state, 0, 0, (sh2 - 28) as i64, sw2, 28, K_RAW,
        (&tb[0]) as u64)
    if bar < MAX_WIN {
        set_deco(state, bar, false)
        // 23. A BOTTOM STRUT OF 28 TAKES 28 ROWS OFF THE BOTTOM -- and
        //     off the bottom only. The origin does not move.
        let s23: bool = set_strut(state, bar, EDGE_BOTTOM, 28)
        if s23 && work_x(state) == 0 && work_y(state) == 0
            && work_w(state) == sw2 && work_h(state) == sh2 - 28 {
            n = n + 1
        }
        // 24. MAXIMIZE FILLS THE WORK AREA, NOT THE SCREEN. Compared on
        //     the OUTER rectangle, because that is what covers pixels.
        let mw: u64 = create(state, 0, 40, 40, MAX_W, MAX_H, K_RAW,
            (&tm[0]) as u64)
        if mw < MAX_WIN && maximize(state, mw, true) {
            let ox: i64 = win_x(state, mw)
            let oy: i64 = win_y(state, mw)
            let ow: u64 = outer_w(state, mw)
            let oh: u64 = outer_h(state, mw)
            if ox == work_x(state) as i64 && oy == work_y(state) as i64
                && ow == work_w(state) && oh == work_h(state) {
                n = n + 1
            }
            // 25. AND IT DOES NOT TOUCH THE BAR. The two rectangles are
            //     disjoint: the bottom of the window is at or above the
            //     top of the bar. This is the claim of the whole
            //     addendum, and it is one comparison.
            if oy + oh as i64 <= win_y(state, bar) {
                n = n + 1
            }
        }
        // 26. THE BAR MOVES TO THE LEFT EDGE AND THE WINDOW FOLLOWS.
        //     Nobody calls `maximize` again -- `set_strut` refits.
        move_win(state, bar, 0, 0)
        let s26: bool = resize_win(state, bar, 44, sh2)
        let _u26: bool = s26
        if set_strut(state, bar, EDGE_LEFT, 44) {
            if work_x(state) == 44 && work_y(state) == 0
                && work_w(state) == sw2 - 44 && work_h(state) == sh2 {
                n = n + 1
            }
            if win_x(state, mw) == 44 && outer_w(state, mw) == sw2 - 44
                && outer_h(state, mw) == sh2 {
                n = n + 1
            }
        }
        // 27. THE COUNTER-TEST: with `nostrut` the work area is the
        //     whole screen again and the maximized window covers the
        //     bar. That is the state this addendum removes.
        set_nostrut(state, true)
        let deckt: bool = win_x(state, mw) == 0
            && outer_w(state, mw) == sw2
        set_nostrut(state, false)
        if deckt && win_x(state, mw) == 44 {
            n = n + 1
        }
        // 28. CLEARING THE STRUT GIVES THE EDGE BACK.
        let _s28: bool = set_strut(state, bar, EDGE_LEFT, 0)
        if work_x(state) == 0 && work_w(state) == sw2 {
            n = n + 1
        }
        // 29. AND SO DOES DYING. Set it once more, then destroy.
        let _s29: bool = set_strut(state, bar, EDGE_TOP, 30)
        let vorher: u64 = work_y(state)
        destroy(state, bar)
        if vorher == 30 && work_y(state) == 0 && work_h(state) == sh2 {
            n = n + 1
        }
        // 30. RESTORING PUTS THE WINDOW BACK WHERE IT WAS: it was
        //     created at (40, 40) with the full screen and has been
        //     maximized to two different work areas since.
        let _m30: bool = maximize(state, mw, false)
        if win_x(state, mw) == 40 && win_y(state, mw) == 40
            && win_w(state, mw) == MAX_W && win_h(state, mw) == MAX_H
            && !is_max(state, mw) {
            n = n + 1
        }
        if mw < MAX_WIN {
            destroy(state, mw)
        }
    }
    destroy(state, a)
    set_nostrut(state, strut_was)
    damage_all(state)
    return n
}

fn selftest_max() -> u64 {
    return 30
}

// ===================================================== RUNDE TILING
//
// DER FENSTERBAUM AM FENSTERSERVER. Die Rechnung selbst steht in
// `kernel/tile.fi` und weiss von Fenstern nichts; was hier steht, ist
// die NAHT: welches Blatt gehoert zu welchem Fenster, wie kommt ein
// Rechteck aus dem Baum in einen Fenstersatz, wer malt die Reiterzeilen,
// und was passiert, wenn man ein Fenster mit der Maus irgendwohin zieht.
//
// BEIDE WELTEN NEBENEINANDER, und das ist Absicht: ein Fenster mit
// W_NODE == 0 SCHWEBT wie vor dieser Runde, eines mit W_NODE != 0 haengt
// im Baum. Ein Dialog will schweben, eine Textkonsole will kacheln.
// `tile_float` schiebt ein Fenster von der einen Welt in die andere und
// zurueck; die schwebende Lage wird dabei in W_SAVXY/W_SAVWH aufgehoben,
// sonst steht der Dialog nach dem Zurueckholen in der Ecke.

fn tile_on(state: u64) -> bool {
    return gs(state, S_TILE) != 0
}

fn tiled(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    return wg(state, i, W_NODE) != 0
}

fn tile_node(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return tile.NONE
    }
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return tile.NONE
    }
    return nd - 1
}

// RUNDE TILING: LIEGT DIESES FENSTER HINTER EINEM REITER. Diese
// Funktion hiess in der Runde TILING `win_hidden` -- genau wie die
// Funktion der Runde DESKTOP, die "ist minimiert" beantwortet. Zwei
// Fragen, zwei Antworten, ein Name: der Uebersetzer hat es gemeldet,
// und ein Leser haette es nicht gemerkt. Sie heisst jetzt `win_tabbed`.
fn win_tabbed(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_TABBED) != 0
}

fn hotkeys_seen(state: u64) -> u64 {
    return gs(state, S_HOTS)
}

// Der Bereich, den die letzte Baumoperation angefasst hat -- und NUR
// der. Das ist die Zahl, die `notiledirty` kaputt macht.
fn damage_tile(state: u64) {
    let x: u64 = tile.last_x(state)
    let y: u64 = tile.last_y(state)
    let w: u64 = tile.last_w(state)
    let h: u64 = tile.last_h(state)
    if w == 0 || h == 0 {
        return
    }
    damage(state, x as i64, y as i64, (x + w) as i64, (y + h) as i64)
}

fn set_tile_on(state: u64, on: bool) {
    if !ready(state) {
        return
    }
    if on {
        ss(state, S_TILE, 1)
        // Alles, was jetzt schon offen ist, kommt in den Baum.
        var i: u64 = 0
        while i < MAX_WIN {
            if wg(state, i, W_USED) != 0 && wg(state, i, W_NODE) == 0 {
                save_geom(state, i)
                tile_take(state, i)
            }
            i = i + 1
        }
    } else {
        ss(state, S_TILE, 0)
        var k: u64 = 0
        while k < MAX_WIN {
            if wg(state, k, W_USED) != 0 && wg(state, k, W_NODE) != 0 {
                tile_release(state, k)
                restore_geom(state, k)
            }
            k = k + 1
        }
    }
    damage_all(state)
}

fn save_geom(state: u64, i: u64) {
    var x: u64 = wg(state, i, W_X) & 0xFFFFFFFF
    var y: u64 = wg(state, i, W_Y) & 0xFFFFFFFF
    wsv(state, i, W_SAVXY, (x << 32) | y)
    wsv(state, i, W_SAVWH, (wg(state, i, W_W) << 32) | wg(state, i, W_H))
}

fn restore_geom(state: u64, i: u64) {
    let wh: u64 = wg(state, i, W_SAVWH)
    if wh == 0 {
        return
    }
    let xy: u64 = wg(state, i, W_SAVXY)
    wsv(state, i, W_X, xy >> 32)
    wsv(state, i, W_Y, xy & 0xFFFFFFFF)
    let w: u64 = wh >> 32
    let h: u64 = wh & 0xFFFFFFFF
    if w >= 32 && h >= 16 {
        if reframe(state, i, w, h) {
            wsv(state, i, W_W, w)
            wsv(state, i, W_H, h)
            if wg(state, i, W_KIND) == K_TERM {
                term_setup(state, i)
            } else {
                fill(state, i, 0, 0, w, h, wg(state, i, W_BG))
            }
            ev_push(state, i, E_RESIZE, w, h, 0)
        }
    }
    wsv(state, i, W_FLAGS, wg(state, i, W_FLAGS) & ~F_TABBED)
}

// EIN GROESSERER PUFFER, WENN DER BAUM MEHR PLATZ GIBT. Runde K10 hat
// den Puffer beim Anlegen geholt und `resize_win` verweigert seitdem
// jedes Wachsen darueber hinaus -- mit Recht, denn sonst waere es ein
// Schreibzugriff daneben. Beim Kacheln ist Wachsen aber der Normalfall:
// wer von vier Fenstern zwei schliesst, verdoppelt die uebrigen. Also
// wird hier ein neuer Lauf Rahmen geholt und der alte zurueckgegeben.
fn reframe(state: u64, i: u64, w: u64, h: u64) -> bool {
    let bytes: u64 = w * h * 4
    if bytes <= wg(state, i, W_BUFBYTES) {
        return true
    }
    let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    let neu: u64 = mem.frame_run(state, rahmen)
    if neu == 0 {
        return false
    }
    let alt: u64 = wg(state, i, W_BUF)
    let altr: u64 = wg(state, i, W_BUFBYTES) / mem.FRAME_SIZE
    wsv(state, i, W_BUF, neu)
    wsv(state, i, W_BUFBYTES, rahmen * mem.FRAME_SIZE)
    if alt != 0 {
        mem.frame_free_run(state, alt, altr)
    }
    return true
}

// Ein Blatt des Baumes auf einen Fenstersatz. Der Baum fuehrt das
// AEUSSERE Rechteck (mit Rahmen und Titelleiste) -- die Malflaeche ist
// das, was davon uebrigbleibt.
fn place_win(state: u64, i: u64, n: u64) {
    let ow: u64 = tile.n_w(state, n)
    let oh: u64 = tile.n_h(state, n)
    var w: u64 = 32
    if ow > BORDER * 2 + 32 {
        w = ow - BORDER * 2
    }
    var h: u64 = 16
    if oh > TITLE_H + BORDER + 16 {
        h = oh - TITLE_H - BORDER
    }
    if w > 2048 {
        w = 2048
    }
    if h > 2048 {
        h = 2048
    }
    wsv(state, i, W_X, tile.n_x(state, n))
    wsv(state, i, W_Y, tile.n_y(state, n))
    if w == wg(state, i, W_W) && h == wg(state, i, W_H) {
        return
    }
    if !reframe(state, i, w, h) {
        return
    }
    wsv(state, i, W_W, w)
    wsv(state, i, W_H, h)
    if wg(state, i, W_KIND) == K_TERM {
        term_setup(state, i)
    } else {
        fill(state, i, 0, 0, w, h, wg(state, i, W_BG))
    }
    ev_push(state, i, E_RESIZE, w, h, 0)
}

// Den ganzen Baum auf die Fenster uebertragen. Ohne `damage` -- der
// Rufer beschmutzt EINMAL den Bereich, den der Baum als geaendert
// meldet, und genau das ist der Unterschied, den diese Runde misst.
fn tile_apply(state: u64) {
    let r: u64 = tile.root(state)
    if r == tile.NONE {
        return
    }
    var n: u64 = r
    var guard: u64 = 0
    while n != tile.NONE && guard <= tile.MAX_NODES {
        guard = guard + 1
        if tile.n_kind(state, n) == tile.K_LEAF {
            let cl: u64 = tile.n_client(state, n)
            if cl != 0 && cl <= MAX_WIN {
                let i: u64 = cl - 1
                if wg(state, i, W_USED) != 0 {
                    // AUCH VERDECKTE REITER BEKOMMEN IHR RECHTECK. Sie
                    // werden nicht gemalt, aber sie muessen die richtige
                    // Groesse haben, wenn man den Reiter wechselt --
                    // sonst zuckt das Fenster beim Umschalten einmal
                    // durch, weil erst dann neu gerechnet wird.
                    place_win(state, i, n)
                    if tile.visible(state, n) {
                        wsv(state, i, W_FLAGS,
                            wg(state, i, W_FLAGS) & ~F_TABBED)
                    } else {
                        wsv(state, i, W_FLAGS,
                            wg(state, i, W_FLAGS) | F_TABBED)
                    }
                }
            }
        }
        n = tile.dfs_next(state, n, r)
    }
}

fn tile_take(state: u64, i: u64) -> bool {
    if !valid(state, i) || wg(state, i, W_NODE) != 0 {
        return false
    }
    let n: u64 = tile.insert(state, i + 1)
    if n == tile.NONE {
        return false // kein Platz im Baum -- das Fenster schwebt weiter
    }
    wsv(state, i, W_NODE, n + 1)
    tile_apply(state)
    damage_tile(state)
    return true
}

fn tile_release(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return false
    }
    wsv(state, i, W_NODE, 0)
    wsv(state, i, W_FLAGS, wg(state, i, W_FLAGS) & ~F_TABBED)
    tile.remove(state, nd - 1)
    tile_apply(state)
    damage_tile(state)
    return true
}

fn tile_float(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if wg(state, i, W_NODE) != 0 {
        tile_release(state, i)
        restore_geom(state, i)
        raise_win(state, i)
        damage_win(state, i)
        return true
    }
    save_geom(state, i)
    return tile_take(state, i)
}

fn tile_snap(state: u64, i: u64, where: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if wg(state, i, W_NODE) == 0 {
        save_geom(state, i)
        if !tile_take(state, i) {
            return false
        }
    }
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return false
    }
    tile.snap(state, nd - 1, where)
    tile_apply(state)
    damage_tile(state)
    return true
}

// EIN WECHSEL DER BILDSCHIRMAUFLOESUNG. Der Baum wird NEU AUSGEMESSEN
// und nicht neu aufgebaut -- die Verhaeltnisse stehen als Anteile da und
// nicht als Bildpunkte, also ueberlebt jede Aufteilung den Wechsel.
fn on_screen_resize(state: u64, w: u64, h: u64) -> bool {
    if !ready(state) || w == 0 || h == 0 {
        return false
    }
    ss(state, S_SW, w)
    ss(state, S_SH, h)
    tile.set_area(state, 0, 0, w, h)
    tile_apply(state)
    damage_all(state)
    return true
}

// ------------------------------------------------ die Reiterzeilen
//
// Sie werden vom SERVER gemalt, wie die Titelleiste -- eine Anwendung
// darf nicht wissen, dass sie in einem Reiter liegt, und sie kann es
// auch nicht malen: die Zeile liegt AUSSERHALB ihres Rechtecks. Der
// Baum hat ihre Hoehe von der Flaeche der Kinder schon abgezogen, also
// ueberschneidet sich hier nichts.
fn paint_bar_of(state: u64, n: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let f: u64 = gs(state, S_FONT_UI)
    let px: u64 = gs(state, S_PX_UI)
    var idx: u64 = 0
    var c: u64 = tile.n_first(state, n)
    while c != tile.NONE && idx <= tile.MAX_NODES {
        let tx: i64 = tile.tab_x(state, n, idx) as i64
        let ty: i64 = tile.tab_y(state, n, idx) as i64
        let tw: i64 = tile.tab_w(state, n, idx) as i64
        let th: i64 = tile.tab_h(state, n, idx) as i64
        let aktiv: bool = tile.n_active(state, n) == c
        var grund: u64 = fb.rgb(state, 0x22, 0x2C, 0x38)
        var schrift: u64 = fb.rgb(state, 0x90, 0x9C, 0xA8)
        if aktiv {
            grund = fb.rgb(state, 0x1C, 0x4E, 0x7E)
            schrift = fb.rgb(state, 0xFF, 0xFF, 0xFF)
        }
        let ax0: i64 = imax(tx, cx0 as i64)
        let ay0: i64 = imax(ty, cy0 as i64)
        let ax1: i64 = imin(tx + tw, cx1 as i64)
        let ay1: i64 = imin(ty + th, cy1 as i64)
        if ax1 > ax0 && ay1 > ay0 {
            fb.fill(state, ax0 as u64, ay0 as u64, (ax1 - ax0) as u64,
                (ay1 - ay0) as u64, grund)
            // eine Trennlinie am rechten beziehungsweise unteren Rand
            let rand: u64 = fb.rgb(state, 0x10, 0x16, 0x1E)
            if tw > 1 && tx + tw - 1 < cx1 as i64 && tx + tw - 1 >= cx0 as i64 {
                fb.fill(state, (tx + tw - 1) as u64, ay0 as u64, 1,
                    (ay1 - ay0) as u64, rand)
            }
            if th > 1 && ty + th - 1 < cy1 as i64 && ty + th - 1 >= cy0 as i64 {
                fb.fill(state, ax0 as u64, (ty + th - 1) as u64,
                    (ax1 - ax0) as u64, 1, rand)
            }
            if f < ttf.MAX_FONTS {
                let l: u64 = tile.first_leaf(state, c)
                if l != tile.NONE {
                    let cl: u64 = tile.n_client(state, l)
                    if cl != 0 && cl <= MAX_WIN {
                        title_text(state, cl - 1, f, tx + 6,
                            ty + 3 + ttf.ascent(state, f, px), schrift,
                            ax0, ay0, ax1, ay1, tx + tw - 4)
                    }
                }
            }
        }
        idx = idx + 1
        c = tile.n_next(state, c)
    }
}

fn paint_bars(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let r: u64 = tile.root(state)
    if r == tile.NONE {
        return
    }
    var n: u64 = r
    var guard: u64 = 0
    while n != tile.NONE && guard <= tile.MAX_NODES {
        guard = guard + 1
        if tile.n_kind(state, n) == tile.K_BOX {
            if tile.n_layout(state, n) != tile.LAY_SPLIT {
                paint_bar_of(state, n, cx0, cy0, cx1, cy1)
            }
        }
        n = tile.dfs_next(state, n, r)
    }
}

// ------------------------------------------- das Vorschaurechteck
//
// Beim Ziehen zeigt ein Rahmen, WO das Fenster landen wird -- nicht
// wo der Zeiger ist. Ohne das ist ein Ablegen im Baum Raten: die
// linke Haelfte eines Fensters und sein oberes Viertel sind zwei
// verschiedene Ziele, und man sieht dem Zeiger nicht an, welches
// gemeint ist.
fn paint_preview(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let x: i64 = gs(state, S_PVX) as i64
    let y: i64 = gs(state, S_PVY) as i64
    let w: i64 = gs(state, S_PVW) as i64
    let h: i64 = gs(state, S_PVH) as i64
    if w <= 0 || h <= 0 {
        return
    }
    let farbe: u64 = fb.rgb(state, 0x4C, 0x9A, 0xE8)
    var k: i64 = 0
    while k < 3 {
        pv_line(state, x + k, y + k, w - 2 * k, 1, farbe, cx0, cy0, cx1, cy1)
        pv_line(state, x + k, y + h - 1 - k, w - 2 * k, 1, farbe, cx0, cy0,
            cx1, cy1)
        pv_line(state, x + k, y + k, 1, h - 2 * k, farbe, cx0, cy0, cx1, cy1)
        pv_line(state, x + w - 1 - k, y + k, 1, h - 2 * k, farbe, cx0, cy0,
            cx1, cy1)
        k = k + 1
    }
}

fn pv_line(state: u64, x: i64, y: i64, w: i64, h: i64, farbe: u64,
    cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let ax0: i64 = imax(x, cx0 as i64)
    let ay0: i64 = imax(y, cy0 as i64)
    let ax1: i64 = imin(x + w, cx1 as i64)
    let ay1: i64 = imin(y + h, cy1 as i64)
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    fb.fill(state, ax0 as u64, ay0 as u64, (ax1 - ax0) as u64,
        (ay1 - ay0) as u64, farbe)
}

fn preview_damage(state: u64) {
    if gs(state, S_PVON) == 0 {
        return
    }
    let x: i64 = gs(state, S_PVX) as i64
    let y: i64 = gs(state, S_PVY) as i64
    damage(state, x, y, x + gs(state, S_PVW) as i64,
        y + gs(state, S_PVH) as i64)
}

fn set_preview(state: u64, x: u64, y: u64, w: u64, h: u64) {
    ss(state, S_PVX, x)
    ss(state, S_PVY, y)
    ss(state, S_PVW, w)
    ss(state, S_PVH, h)
    ss(state, S_PVON, 1)
}

// Welches Blatt liegt an dieser Stelle? Der Baum weiss es genauer als
// die Stapelreihenfolge -- er kennt auch die Stellen, an denen KEIN
// Fenster liegt, weil dort eine Reiterzeile ist.
fn leaf_at(state: u64, x: i64, y: i64) -> u64 {
    let r: u64 = tile.root(state)
    if r == tile.NONE {
        return tile.NONE
    }
    var n: u64 = r
    var guard: u64 = 0
    while n != tile.NONE && guard <= tile.MAX_NODES {
        guard = guard + 1
        if tile.n_kind(state, n) == tile.K_LEAF && tile.visible(state, n) {
            let nx: i64 = tile.n_x(state, n) as i64
            let ny: i64 = tile.n_y(state, n) as i64
            if x >= nx && y >= ny {
                if x < nx + tile.n_w(state, n) as i64 {
                    if y < ny + tile.n_h(state, n) as i64 {
                        return n
                    }
                }
            }
        }
        n = tile.dfs_next(state, n, r)
    }
    return tile.NONE
}

fn drag_begin(state: u64, i: u64) {
    ss(state, S_DRAGT, 0)
    ss(state, S_DROPN, 0)
    ss(state, S_DROPE, 0)
    if wg(state, i, W_NODE) == 0 {
        return
    }
    // Wer gezogen wird, ist waehrenddessen NICHT im Baum -- sonst
    // rechnet der Baum ihn bei jeder Zeigerbewegung neu an seinen alten
    // Platz. So macht es i3 auch.
    save_geom(state, i)
    tile_release(state, i)
    ss(state, S_DRAGT, 1)
}

fn drag_hover(state: u64, i: u64, x: i64, y: i64) {
    if gs(state, S_TILE) == 0 {
        return
    }
    preview_damage(state)
    ss(state, S_PVON, 0)
    ss(state, S_DROPN, 0)
    ss(state, S_DROPE, 0)
    let sw: i64 = gs(state, S_SW) as i64
    let sh: i64 = gs(state, S_SH) as i64
    let rand: i64 = 16
    // 1. AM BILDSCHIRMRAND: die Windows-artige Schnellablage. Sie ist
    //    ein Sonderfall des Baumes und kein zweites System.
    if x < rand {
        ss(state, S_DROPE, 1)
        set_preview(state, 0, 0, (sw / 2) as u64, sh as u64)
        preview_damage(state)
        return
    }
    if x >= sw - rand {
        ss(state, S_DROPE, 2)
        set_preview(state, (sw - sw / 2) as u64, 0, (sw / 2) as u64,
            sh as u64)
        preview_damage(state)
        return
    }
    if y < rand {
        ss(state, S_DROPE, 3)
        set_preview(state, 0, 0, sw as u64, (sh / 2) as u64)
        preview_damage(state)
        return
    }
    if y >= sh - rand {
        ss(state, S_DROPE, 4)
        set_preview(state, 0, (sh - sh / 2) as u64, sw as u64,
            (sh / 2) as u64)
        preview_damage(state)
        return
    }
    // 2. AUF EINEM ANDEREN FENSTER: das Viertel, in dem der Zeiger
    //    steht, sagt die Seite. Die Mitte heisst REITER.
    let n: u64 = leaf_at(state, x, y)
    if n == tile.NONE {
        return
    }
    let nx: u64 = tile.n_x(state, n)
    let ny: u64 = tile.n_y(state, n)
    let w: u64 = tile.n_w(state, n)
    let h: u64 = tile.n_h(state, n)
    let fx: u64 = (x - nx as i64) as u64
    let fy: u64 = (y - ny as i64) as u64
    var seite: u64 = 4
    if fx * 4 < w {
        seite = tile.D_LEFT
    } else {
        if fx * 4 >= w * 3 {
            seite = tile.D_RIGHT
        } else {
            if fy * 4 < h {
                seite = tile.D_UP
            } else {
                if fy * 4 >= h * 3 {
                    seite = tile.D_DOWN
                }
            }
        }
    }
    ss(state, S_DROPN, n + 1)
    ss(state, S_DROPS, seite)
    if seite == tile.D_LEFT {
        set_preview(state, nx, ny, w / 2, h)
    }
    if seite == tile.D_RIGHT {
        set_preview(state, nx + w - w / 2, ny, w / 2, h)
    }
    if seite == tile.D_UP {
        set_preview(state, nx, ny, w, h / 2)
    }
    if seite == tile.D_DOWN {
        set_preview(state, nx, ny + h - h / 2, w, h / 2)
    }
    if seite == 4 {
        set_preview(state, nx, ny, w, h)
    }
    preview_damage(state)
}

fn drag_end(state: u64, i: u64, x: i64, y: i64) {
    preview_damage(state)
    ss(state, S_PVON, 0)
    if gs(state, S_TILE) == 0 {
        ss(state, S_DRAGT, 0)
        return
    }
    let e: u64 = gs(state, S_DROPE)
    if e != 0 {
        let n: u64 = tile.insert(state, i + 1)
        if n != tile.NONE {
            wsv(state, i, W_NODE, n + 1)
            var wo: u64 = tile.SNAP_LEFT
            if e == 2 {
                wo = tile.SNAP_RIGHT
            }
            if e == 3 {
                wo = tile.SNAP_TOP
            }
            if e == 4 {
                wo = tile.SNAP_BOTTOM
            }
            tile.snap(state, n, wo)
            tile_apply(state)
            damage_all(state)
        }
        ss(state, S_DRAGT, 0)
        ss(state, S_DROPE, 0)
        return
    }
    let d: u64 = gs(state, S_DROPN)
    if d != 0 {
        let ziel: u64 = d - 1
        let seite: u64 = gs(state, S_DROPS)
        var n: u64 = tile.NONE
        if seite == 4 {
            n = tile.insert_at(state, ziel, tile.D_RIGHT, i + 1)
            if n != tile.NONE {
                tile.set_layout(state, n, tile.LAY_TABBED)
            }
        } else {
            n = tile.insert_at(state, ziel, seite, i + 1)
        }
        if n != tile.NONE {
            wsv(state, i, W_NODE, n + 1)
            tile_apply(state)
            damage_all(state)
        }
    } else {
        if gs(state, S_DRAGT) != 0 {
            tile_take(state, i)
            damage_all(state)
        }
    }
    ss(state, S_DRAGT, 0)
    ss(state, S_DROPN, 0)
}

// Der Griff unten rechts an einem GEKACHELTEN Fenster verschiebt das
// Verhaeltnis am inneren Knoten -- nicht die Groesse des Fensters. Alles
// andere waere eine Luecke.
fn tile_drag_resize(state: u64, i: u64, x: i64, y: i64) {
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return
    }
    let n: u64 = nd - 1
    let p: u64 = tile.n_parent(state, n)
    if p == tile.NONE || tile.n_layout(state, p) != tile.LAY_SPLIT {
        return
    }
    var total: u64 = tile.n_h(state, p)
    var will: i64 = y - tile.n_y(state, n) as i64
    var ist: i64 = tile.n_h(state, n) as i64
    if tile.n_dir(state, p) == tile.DIR_H {
        total = tile.n_w(state, p)
        will = x - tile.n_x(state, n) as i64
        ist = tile.n_w(state, n) as i64
    }
    if total == 0 {
        return
    }
    let dpx: i64 = will - ist
    if dpx == 0 {
        return
    }
    let d: i64 = dpx * tile.FRAC_ONE as i64 / total as i64
    if d == 0 {
        return
    }
    if tile.resize_at(state, n, d) {
        tile_apply(state)
        damage_tile(state)
    }
}

// -------------------------------------------------- die Tastenkuerzel

fn hot_take_raw(state: u64) -> u64 {
    let kopf: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_HHEAD)
    let schwanz: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_HTAIL)
    if kopf == schwanz {
        return 0
    }
    let p: u64 = state + kstate.K11_OFF + kstate.KB_HOT + (schwanz % 16) * 2
    let c: u64 = kstate.get8(p)
    let m: u64 = kstate.get8(p + 1)
    kstate.set(state, kstate.K11_OFF + kstate.KB_HTAIL, schwanz + 1)
    return (m << 8) | c
}

fn hotkeys(state: u64) -> u64 {
    var n: u64 = 0
    var weiter: bool = true
    var guard: u64 = 0
    while weiter && guard < 16 {
        guard = guard + 1
        let v: u64 = hot_take_raw(state)
        if v == 0 {
            weiter = false
        } else {
            n = n + 1
            ss(state, S_HOTS, gs(state, S_HOTS) + 1)
            let act: u64 = tile.bind_lookup(state, v & 0xFF, (v >> 8) & 0xFF)
            if tile_action(state, act) {
                ss(state, S_ACTS, gs(state, S_ACTS) + 1)
            }
        }
    }
    return n
}

// EINE HANDLUNG AUSFUEHREN. Welche Taste welche Handlung ausloest, steht
// NICHT hier, sondern in der Tabelle, die aus
// /users/<name>/config/tiling.conf gelesen wurde. Hier steht nur, was
// eine Handlung TUT.
fn tile_action(state: u64, act: u64) -> bool {
    if act == tile.A_NONE || !ready(state) {
        return false
    }
    if act == tile.A_TILE_TOGGLE {
        set_tile_on(state, gs(state, S_TILE) == 0)
        return true
    }
    let i: u64 = focus(state)
    if i >= MAX_WIN {
        return false
    }
    if act == tile.A_CLOSE {
        ev_push(state, i, E_CLOSE, 0, 0, 0)
        destroy(state, i)
        return true
    }
    if act == tile.A_FLOAT {
        return tile_float(state, i)
    }
    if act >= tile.A_SNAP_LEFT && act <= tile.A_SNAP_BR {
        return tile_snap(state, i, act - tile.A_SNAP_LEFT)
    }
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return false
    }
    let n: u64 = nd - 1
    if act <= tile.A_FOCUS_DOWN {
        let z: u64 = tile.dir_search(state, n, act - tile.A_FOCUS_LEFT)
        if z == tile.NONE {
            return false
        }
        tile.set_focus(state, z)
        let cl: u64 = tile.n_client(state, z)
        if cl != 0 && cl <= MAX_WIN {
            raise_win(state, cl - 1)
            set_focus(state, cl - 1)
        }
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act <= tile.A_MOVE_DOWN {
        if tile.move_dir(state, n, act - tile.A_MOVE_LEFT) {
            tile_apply(state)
            damage_tile(state)
            return true
        }
        return false
    }
    if act == tile.A_SPLIT_H {
        tile.set_next_split(state, 1)
        return true
    }
    if act == tile.A_SPLIT_V {
        tile.set_next_split(state, 2)
        return true
    }
    if act >= tile.A_LAYOUT_SPLIT && act <= tile.A_LAYOUT_STACKED {
        if tile.set_layout(state, n, act - tile.A_LAYOUT_SPLIT) {
            tile_apply(state)
            damage_tile(state)
            return true
        }
        return false
    }
    if act == tile.A_ROTATE {
        tile.rotate(state, tile.root(state), 1)
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act == tile.A_MIRROR {
        tile.mirror(state, tile.root(state), 0)
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act == tile.A_BALANCE {
        tile.balance(state, tile.root(state))
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act == tile.A_GROW || act == tile.A_SHRINK {
        var d: i64 = tile.MIN_FRAC as i64
        if act == tile.A_SHRINK {
            d = 0 - d
        }
        if tile.resize_at(state, n, d) {
            tile_apply(state)
            damage_tile(state)
            return true
        }
        return false
    }
    return false
}
