// ------------------------------------------------------- die Zahlen

// RUNDE DESKTOP: SECHZEHN STATT ACHT, und die Zahl ist keine Laune.
// Ein Schreibtisch (1) mit einer Taskleiste (1), dem Starter (1), dem
// Datei-Explorer samt Kontextmenue und Dialog (3) und den
// Einstellungen samt Dialog (2) sind ACHT Fenster -- das neunte bekam
// -E_EXHAUSTED. Mit sechzehn passen Fenstertafel (0x1000) und
// Ereignisringe (0x2000) nicht mehr in die zwei Seiten von WM_OFF;
// beide liegen deshalb in `kstate.DSK_OFF` (0x54000..0x58000), dem
// Vorrat dieser Runde. In WM_OFF stehen nur noch die Skalare.
const MAX_WIN: u64 = 16
const WIN_BYTES: u64 = 512
const W_OFF: u64 = 0x0 // die Fenstertafel, Versatz IN kstate.DSK_OFF
const EV_OFF: u64 = 0x2000 // die Ereignisringe, ebenfalls in DSK_OFF
const EV_SLOTS: u64 = 32
const EV_BYTES: u64 = 16
const EV_RING: u64 = 512 // EV_SLOTS * EV_BYTES
// RUNDE ECHTHARDWARE-6: so viele Ringverluste werden EINZELN gemeldet,
// danach nur noch gezaehlt. Siehe die Begruendung bei `ev_push`.
const VERL_SAY: u64 = 32

// RUNDE SCHIRM -- DIESE VIER ZAHLEN WAREN BILDPUNKTE UND SIND JETZT
// GRUNDMASSE. Eine Titelleiste von 22 Bildpunkten ist auf 1024x768 eine
// Titelleiste und auf 3840x2160 ein Strich: auf einer Tafel mit viermal
// so vielen Bildpunkten je Zoll ist sie physisch ein Viertel so hoch.
// Multipliziert wird mit `uisc(state)`, und der Faktor kommt aus
// `fb.uiscale` -- entweder aus der PHYSISCHEN Groesse der Tafel (EDID,
// Oktett 21) oder, wenn die Tafel dazu schweigt, aus ihrer Bildpunktzahl.
const TITLE_H0: u64 = 22 // die Titelleiste
const BORDER0: u64 = 2 // der Rand links, rechts und unten
// RUNDE ECHTHARDWARE-3: 12 -> 8, aber jetzt am GANZEN Rand statt nur
// in der Ecke. Multipliziert mit `uisc` sind das auf Justins Schirm 16
// Bildpunkte Rand -- breit genug zum Treffen, schmal genug, dass ein
// Klick in die Flaeche noch ein Klick in die Flaeche ist.
const GRIP0: u64 = 8 // der Rand, an dem die Groesse gezogen wird
const CLOSE_W0: u64 = 14
// RUNDE TITELABSTAND (Justin, 13.09.2026): der Titel klebte am Rand.
// Er stand bei BORDER0 + 5 = 7 Bildpunkten, und die 5 war eine nackte
// Zahl an zwei Stellen -- in der Malstelle und in der Serienausgabe,
// die ein Laeufer zum Nachrechnen liest. Jetzt EINE Konstante, und sie
// wird wie alle Grundmasse mit `uisc` multipliziert: bisher wuchs der
// Rand mit der Tafel, der Abstand dahinter aber nicht.
const TITLE_PAD0: u64 = 10

const K_RAW: u64 = 0 // die Anwendung malt selbst
const K_TERM: u64 = 1 // ein Zeichenraster, der Server malt

// ADDENDUM TASKBAR: the largest window this server will make. It is
// the screen, and it is exported because whoever wants a window that
// can be maximized to ANY work area has to ask for this size when the
// window is created -- the buffer is never reallocated.
//
// RUNDE SCHIRM: DAS WAREN ZWEI ZAHLEN IM QUELLTEXT, UND SIE HABEN
// GELOGEN, SOBALD DER SCHIRM GROESSER WAR. Auf 1024x768 fielen genau
// deshalb vier Zusagen des Selbsttests (26/30 statt 30/30): ein Fenster,
// das mit 800x600 entsteht, kann eine Arbeitsflaeche von 1024x740 nicht
// fuellen, `resize_win` waechst nicht ueber seinen Puffer hinaus, und
// `maximize` gibt darum ehrlich `false` zurueck. Auf Justins Blech
// (1280x800 unter UEFI, 1920x1080 unter BIOS) heisst dasselbe:
// "maximieren" macht ein Fenster von 800x600 in der Ecke.
//
// Jetzt sind es die Masse des Schirms, die `init` einmal hinlegt.
// MAX_W_HARD ist nur noch die Obergrenze, an der ein Puffer je Fenster
// unvernuenftig wuerde -- 3840x2160x4 sind 33 MiB, und sechzehn davon
// waeren mehr, als der Rahmenverwalter ueberhaupt verwaltet.
const MAX_W_HARD: u64 = 4096
const MAX_H_HARD: u64 = 2304

// ------------------------------------------- RUNDE DESKTOP: die Ebenen
//
// DREI EBENEN, UND SIE SIND DER GRUND, WARUM ES EINEN SCHREIBTISCH
// GEBEN KANN. Bis zu dieser Runde war die Stapelreihenfolge EINE Kette:
// wer angeklickt wurde, kam nach ganz oben. Ein Hintergrundbild ist
// aber ein Fenster, das NIE nach oben darf, und eine Taskleiste ist ein
// Fenster, das IMMER oben bleiben muss -- beides ist in einer einzigen
// Kette nicht ausdrueckbar. Logbuch K15 hat genau das als "geht heute
// nicht" vermerkt.
//
// Die Ordnung ist jetzt zweistufig: erst die Ebene, dann innerhalb der
// Ebene die Reihenfolge. `raise_win` hebt ein Fenster nur bis an die
// Oberkante SEINER Ebene. Die Gegenprobe heisst `nolayer` und schaltet
// genau diese eine Zeile ab -- dann kommt der Schreibtisch beim ersten
// Klick nach vorn und verdeckt alles.
const L_DESK: u64 = 0 // der Schreibtisch, immer ganz hinten
const L_NORMAL: u64 = 1 // gewoehnliche Anwendungen
const L_TOP: u64 = 2 // die Taskleiste
// ================================================== RUNDE ECHTHARDWARE-3
// DREI EBENEN WAREN ZU WENIG, UND DAS IST DIE WURZEL MEHRERER FEHLER.
//
// Justins Befund vom 09.09.: der Tooltip verschwindet HINTER der
// Taskleiste, das Kontextmenue ist ein echtes Fenster mit Titelleiste
// und Kreuz, und das Startmenue ueberlappt die Leiste. Alle drei sind
// dasselbe Problem: es gab nur `L_TOP`, und wer dort hin musste, lag
// mit der Leiste auf EINER Ebene -- die Reihenfolge entschied dann,
// wer spaeter angelegt wurde, und das ist keine Ordnung, sondern ein
// Zufall.
//
// DIE ORDNUNG, VON UNTEN NACH OBEN, und sie ist ab hier eine ZUSAGE:
//
//     L_DESK    0  Schreibtisch
//     L_NORMAL  1  gewoehnliche Fenster und Dialoge
//     L_TOP     2  die Taskleiste
//     L_MENUE   3  Startmenue/Ueberlagerung -- ueber der Leiste
//     L_POPUP   4  Klappmenues und Kontextmenues
//     L_TIP     5  Blasen, ueber ALLEM
//
// Die Zahlen 0..2 bleiben, was sie waren: jedes Programm, das `L_TOP`
// sagt, meint weiter die Leiste und liegt weiter dort. Neu ist nur,
// dass ueber ihr noch etwas sein KANN.
// ================================================== RUNDE VOLLBILD
// EINE SECHSTE EBENE, UND ZWAR ZWISCHEN LEISTE UND MENUES.
//
// Ein Vollbildfenster muss UEBER der Taskleiste liegen -- sonst
// schimmert sie durch, und genau das hat Justin ausgeschlossen ("die
// Taskleiste darf NICHT durchscheinen"). Es darf aber NICHT ueber
// Kontextmenues und Blasen liegen: ein Menue, das ein Vollbildprogramm
// selbst aufklappt, waere sonst unsichtbar.
//
// Also L_FULL = 3, und die drei darueber ruecken um eins hoch. Die
// Zahlen 0..2 bleiben unangetastet -- das ist die Zusage aus
// ECHTHARDWARE-3, und jedes Programm, das `L_TOP` sagt, liegt weiter
// genau dort.
const L_FULL: u64 = 3 // Vollbild: ueber der Leiste, unter den Menues
const L_MENUE: u64 = 4 // Startmenue: ueber der Leiste, unter den Menues
const L_POPUP: u64 = 5 // Klapp- und Kontextmenue
const L_TIP: u64 = 6 // die Blase, ueber allem
const L_MAX: u64 = 6

// Die Merkmale eines Fensters.
//   F_HIDDEN  minimiert: es wird nicht zusammengesetzt und nimmt keinen
//             Klick an. Es lebt weiter, sein Puffer bleibt.
//   F_NODECO  ohne Schmuck: kein Rahmen, keine Titelleiste, kein
//             Schliessfeld, kein Groessengriff. Schreibtisch und
//             Taskleiste sind so.
const F_HIDDEN: u64 = 1
const F_NODECO: u64 = 2
// ADDENDUM TASKBAR: a maximized window is not a window that happens to
// be as large as the work area -- it is a window that FOLLOWS the work
// area. Without the flag the server cannot tell the two apart, and a
// taskbar that moves to another edge would leave every window where it
// was.
const F_MAXIMIZED: u64 = 4
// RUNDE TILING: dieses Fenster liegt hinter einem Reiter. Es ist NICHT
// dasselbe wie F_HIDDEN (minimiert): ein Klick auf den Reiter holt es
// zurueck, ein Klick auf den Fensterknopf der Leiste nicht.
const F_TABBED: u64 = 8

// ============================================ RUNDE ECHTHARDWARE-1
// EIN FENSTER DER OBERSTEN EBENE, DAS DIE TASTATUR TROTZDEM WILL.
//
// Justins Befund vom 09.09.: im Startmenue laesst sich nichts tippen.
// Die Ursache ist eine Regel, die fuer die Taskleiste richtig ist und
// fuer das Startmenue falsch: `on_mouse` gibt den Fokus NUR an
// Fenster der Ebene L_NORMAL (Runde DESKTOP -- "ein Schreibtisch, der
// den Fokus an sich zieht, macht jeden Tastendruck danach
// wirkungslos"). Der Starter liegt aber auf L_TOP, weil er UEBER allem
// stehen muss -- und bekam damit nie eine Taste.
//
// Die Ebene zu wechseln waere die falsche Abhilfe: dann verschwindet
// das Menue hinter Fenstern. Also sagt das Fenster selbst, was es
// will. Vorgabe ist NEIN, also bleibt die Leiste, was sie war.
const F_KEYS: u64 = 16

// ================================================== RUNDE VOLLBILD
// VOLLBILD IST NICHT MAXIMIERT, UND DAS IST DER GANZE PUNKT.
//
// Justins Vorgabe, und sie deckt sich mit Windows und jedem Browser:
//
//   MAXIMIERT = die ARBEITSFLAECHE. Die Leiste bleibt sichtbar, die
//               Titelleiste bleibt da. Das Fenster BERUEHRT die Leiste
//               nie. Das ist F_MAXIMIZED, und es gibt es schon.
//
//   VOLLBILD  = der GANZE Schirm, die Leistenflaeche eingeschlossen.
//               Keine Titelleiste, kein Rahmen, und die Leiste ist
//               NICHT zu sehen. Das ist F_FULL, und das ist neu.
//
// ZWEI ZUSTAENDE, NICHT EINER. Wer sie in ein Merkerbit legt, kann die
// Frage "war es vorher maximiert?" beim Verlassen nicht mehr
// beantworten -- und genau das ist der Teil, der laut Justin "gerne
// kaputtgeht". Deshalb hat das Vollbild EIGENE Sicherungsplaetze
// (W_FSXY/W_FSWH) und laesst F_MAXIMIZED unangetastet stehen: beim
// Verlassen wird der alte Zustand nicht ERRATEN, sondern GELESEN.
const F_FULL: u64 = 32

// ADDENDUM TASKBAR: the four screen edges. The numbers are written to
// /etc/taskbar.conf as words ("bottom", "top", "left", "right") and
// they are the same four numbers in the kernel, in the taskbar and in
// the settings application -- there is no translation table.
const EDGE_BOTTOM: u64 = 0
const EDGE_TOP: u64 = 1
const EDGE_LEFT: u64 = 2
const EDGE_RIGHT: u64 = 3

const E_KEY: u64 = 1
const E_DOWN: u64 = 2
const E_UP: u64 = 3
const E_MOVE: u64 = 4
const E_CLOSE: u64 = 5
const E_FOCUS: u64 = 6
const E_RESIZE: u64 = 7

// die Skalare
const S_READY: u64 = 0x000
const S_COUNT: u64 = 0x008
const S_FOCUS: u64 = 0x010 // Fenster + 1, 0 = keines
const S_NEXTID: u64 = 0x018
const S_DX0: u64 = 0x020 // der schmutzige Bereich
const S_DY0: u64 = 0x028
const S_DX1: u64 = 0x030
const S_DY1: u64 = 0x038
const S_DON: u64 = 0x040
const S_SW: u64 = 0x048 // Bildschirmgroesse
const S_SH: u64 = 0x050
const S_DRAG: u64 = 0x058 // Fenster + 1, das am Zeiger haengt
const S_DRAGX: u64 = 0x060
const S_DRAGY: u64 = 0x068
const S_SIZING: u64 = 0x070 // Fenster + 1, dessen Groesse gezogen wird
const S_CURON: u64 = 0x078
const S_CURX: u64 = 0x080 // wo der Zeiger zuletzt gemalt wurde
const S_CURY: u64 = 0x088
const S_COMPOSITES: u64 = 0x090
const S_BLITS: u64 = 0x098
const S_PIXELS: u64 = 0x0A0
const S_NODIRTY: u64 = 0x0A8 // GEGENPROBE: immer das ganze Bild
const S_NOFOCUS: u64 = 0x0B0 // GEGENPROBE: Tasten an alle
const S_FONT_UI: u64 = 0x0B8
const S_FONT_MONO: u64 = 0x0C0
const S_PX_UI: u64 = 0x0C8
const S_PX_MONO: u64 = 0x0D0
const S_LASTUS: u64 = 0x0D8
const S_KEYS: u64 = 0x0E0
const S_EVDROP: u64 = 0x0E8
const S_CURSAVE: u64 = 0x0F0 // Rahmen fuer den Zeigergrund
const S_DESK: u64 = 0x0F8
const S_DOWNS: u64 = 0x100
const S_MOVES: u64 = 0x108
const S_HITS: u64 = 0x110 // die Farbe des Hintergrunds
// RUNDE K15: WELCHES ZEIGERBILD. 0 = Pfeil, 1 = Textbalken. Es steht
// hier und nicht in der Anwendung, weil der Zeiger UEBER allen Fenstern
// liegt und vom Server gemalt wird -- eine Anwendung, die ihn selbst
// zeichnete, zeichnete ihn in ihr eigenes Rechteck und damit unter alle
// anderen. `kernel/wig.fi` setzt ihn auf Verlangen aus Ring 3.
const S_SHAPE: u64 = 0x118
// RUNDE DESKTOP. Vier Skalare: die beiden Gegenproben und die beiden
// Zaehler, ohne die "das Fenster wurde minimiert" eine Behauptung
// ueber etwas waere, das man im Bild gerade NICHT sieht.
const S_NOLAYER: u64 = 0x120 // GEGENPROBE: die Ebenen abschalten
const S_NOMIN: u64 = 0x128 // GEGENPROBE: das Verbergen abschalten
const S_HIDES: u64 = 0x130 // wie oft ein Fenster verborgen wurde
const S_SHOWS: u64 = 0x138 // und wie oft es wieder auftauchte
// ADDENDUM TASKBAR: the work area and its two counters. It is kept as
// four scalars and NOT recomputed on demand: `compose` runs sixty
// times a second and would walk the window table each time for an
// answer that changes when a strut changes and at no other moment.
const S_WORK_X: u64 = 0x140
const S_WORK_Y: u64 = 0x148
const S_WORK_W: u64 = 0x150
const S_WORK_H: u64 = 0x158
const S_NOSTRUT: u64 = 0x160 // COUNTER-TEST: ignore every strut
const S_STRUTS: u64 = 0x168 // how often a strut was declared or cleared
const S_WORKCALC: u64 = 0x170 // how often the work area was recomputed
// ============================================ RUNDE ECHTHARDWARE-4
// WELCHE FORM DIE ANWENDUNG WOLLTE.
//
// Ab dieser Runde setzt der Server selbst eine Form, sobald der Zeiger
// ueber einem Fensterrand steht (Doppelpfeil), und nimmt sie zurueck,
// sobald er ihn verlaesst. "Zuruecknehmen" heisst aber nicht "Pfeil":
// eine Anwendung, die ueber ihrem Textfeld die Textmarke gesetzt hat
// (`wig.set_shape` aus Ring 3), bekaeme sonst bei jeder Mausbewegung
// den Pfeil zurueck und die Marke waere nie zu sehen. Also stehen die
// beiden Wuensche NEBENEINANDER: was die Anwendung will, und was der
// Rand gerade verlangt.
const S_SHAPE_APP: u64 = 0x178
// RUNDE TILING. Die Skalare des Kachelbetriebs. Sie lagen bei 0x120,
// wo die Runden DESKTOP und TASKLEISTE zusammen schon elf Woerter
// stehen haben -- zwei Runden auf denselben Adressen. Sie zogen
// deshalb hinter deren Block, auf 0x180.
//
// UND DORT LAG SCHON DIE RUNDE THEME. Runde PAINT hat es gefunden, als
// sie fuer die FORM des Fensters drei freie Woerter suchte:
//
//     const S_TILE: u64 = 0x180      // Runde TILING
//     const S_DECO: u64 = 0x180      // Runde THEME, ELF Woerter
//                                    // (0x180 bis einschliesslich 0x1D0)
//
// Beide werden ueber dasselbe `gs`/`ss` in denselben Block geschrieben.
// Das ist BILDPUNKTGENAU der Fehler aus Runde K7B -- der Zeichensatz
// und die Signaltafel auf 0x2F000 --, nur eine Ebene tiefer: zwei
// Zweige, jeder fuer sich gruen, keine gemeinsame ZEILE, nur eine
// gemeinsame ADRESSE. Ein Textverschmelzer kann das nicht sehen.
//
// WAS ES ANRICHTETE, Wort fuer Wort. `deco_push` in Ring 3 setzt elf
// Farben hintereinander; jede davon landete AUSSERDEM in einem Skalar
// des Kachelbetriebs:
//
//     DK_FRAME + 1     -> S_TILE     Kachelbetrieb sieht "an" aus
//     DK_TITLE + 1     -> S_PVON     ein Vorschaurechteck liegt an
//     DK_TEXT + 1      -> S_PVX      seine Koordinaten sind Farben
//     DK_FRAME_ON + 1  -> S_PVY
//     DK_TITLE_ON + 1  -> S_PVW
//     DK_TEXT_ON + 1   -> S_PVH
//     DK_CLOSE + 1     -> S_DROPN
//     DK_CLOSE_MARK+1  -> S_DROPS
//     DK_DESK + 1      -> S_DROPE
//     DK_TERM_FG + 1   -> S_DRAGT
//     DK_TERM_BG + 1   -> S_HOTS
//
// und umgekehrt: jedes Tastenkuerzel zaehlte S_HOTS hoch und AENDERTE
// DAMIT DIE HINTERGRUNDFARBE EINES TERMINALFENSTERS.
//
// Dazu ein zweiter, kleinerer Treffer in derselben Ecke: `S_DECON`
// stand auf 0x1C0, weil der Block zu seiner Zeit ACHT Woerter hatte
// ("acht Woerter, 0x180 .. 0x1B8" -- der Kommentar steht noch da).
// Runde MERGE hat ihn auf ELF erweitert und S_DECON nicht mitgezogen:
// seither ist 0x1C0 gleichzeitig der Schreibzaehler UND Steckplatz 8,
// die Farbe des Schreibtischgrundes. Jeder gesetzte Farbwert
// ueberschrieb sie mit der Zahl der bisherigen Schreibvorgaenge.
//
// GEFUNDEN HAT DAS `tools/paint/scalars.py`, und zwar mechanisch: es
// liest alle `const S_...: u64 = 0x...` einer Datei und rechnet sie
// paarweise gegeneinander, mit der Laenge aus dem Kommentar oder aus
// einer Laengenkonstante. Dreizehn Ueberschneidungen, alle dreizehn
// hier.
//
// DIE NEUE AUFTEILUNG, mit Luft dazwischen statt auf Kante:
//
//     0x180 .. 0x1D0   THEME, elf Farbsteckplaetze
//     0x1D8            THEME, der Schreibzaehler
//     0x200 .. 0x258   TILING
//     0x280 .. 0x2B0   PAINT, die Form und ihre Zaehler
//
// WM_MAX ist 0x2000; die naechste Runde nimmt 0x300.
const S_TILE: u64 = 0x200 // 1 = neue Fenster gehen in den Baum
const S_PVON: u64 = 0x208 // ein Vorschaurechteck liegt auf dem Schirm
const S_PVX: u64 = 0x210
const S_PVY: u64 = 0x218
const S_PVW: u64 = 0x220
const S_PVH: u64 = 0x228
const S_DROPN: u64 = 0x230 // Zielknoten + 1 beim Ziehen
const S_DROPS: u64 = 0x238 // Seite am Ziel (tile.D_*), 4 = als Reiter
const S_DROPE: u64 = 0x240 // Bildschirmrand + 1 statt eines Zielfensters
const S_DRAGT: u64 = 0x248 // das gezogene Fenster kam AUS dem Baum
const S_HOTS: u64 = 0x250 // wie viele Tastenkuerzel ausgefuehrt wurden
const S_ACTS: u64 = 0x258 // wie viele davon wirklich etwas getan haben

// ===================================== RUNDE MESSTAFEL: DER EINGABEWEG
//
// Drei Zaehler, die es vorher nicht gab, und jeder beantwortet GENAU
// eine Frage aus Justins Kette "wo bleibt mein Tastendruck":
//
//   S_KEYIN   wie oft `on_key` gerufen wurde -- also wie viele Tasten
//             der FENSTERSERVER entgegengenommen hat. Vorher war das
//             nicht zu sehen: `usb.hid_keys` zaehlt, was `hidin` an
//             `kbd` gab, und danach klaffte eine Luecke bis zum Fenster.
//   S_EVPUSH  wie viele Ereignisse in einen Fensterring GELEGT wurden.
//   S_EVPOP   wie viele ein RING-3-PROGRAMM daraus ABGEHOLT hat.
//
// Das letzte Paar ist der Kern der Sache. Stehen beide hoch, arbeitet
// der Schreibtisch. Laeuft `S_EVPUSH` hoch und `S_EVPOP` bleibt null,
// dann liefert der Kern und NIEMAND holt ab -- dann laeuft kein
// Ring-3-Prozess mehr, und das erklaert die tote Eingabe UND die
// unsichtbare Taskleiste mit EINER Ursache statt mit zweien.
//
// Die Luecke 0x260..0x278 war frei; `tools/paint/scalars.py` prueft das
// mechanisch nach und ist nach dieser Aenderung gelaufen.
const S_EVPUSH: u64 = 0x260 // Ereignisse in einen Fensterring gelegt
const S_EVPOP: u64 = 0x268 // Ereignisse von einem Programm abgeholt
const S_KEYIN: u64 = 0x270 // Tasten, die der Fensterserver annahm

// ---------------------------------------------------- RUNDE THEME
//
// DIE ACHT FARBEN DER FENSTERDEKORATION, und der Grund, warum sie hier
// als DATEN stehen und nicht mehr als Zahlen im Zeichencode:
//
// Rahmen und Titelleiste malt der SERVER -- er muss, er setzt das Bild
// zusammen. Damit sass bis zu dieser Runde die einzige Stelle der
// Oberflaeche, die ihre Farbe selbst wusste, im KERNEL: sechs Werte in
// `draw_win`, unerreichbar fuer jedes Schema. Ein helles Thema mit
// dunkelblauer Titelleiste ist kein helles Thema.
//
// Die Loesung ist NICHT, den Kernel das Thema lesen zu lassen -- dann
// haette der Kernel eine Meinung darueber, wie ein Fenster aussieht.
// Sie ist: der Server haelt acht Zahlen, und wer sie setzt, ist Ring 3
// (WM_DECO, `kernel/sys.fi`). Die Farbpolitik bleibt im Userland, der
// Server bekommt das Ergebnis.
//
// GESPEICHERT WIRD WERT + 1. Null heisst "nie gesetzt", und dann gilt
// `deco_fallback` -- sonst waere eine frisch gestartete Maschine, deren
// Taskleiste noch nicht laeuft, schwarz auf schwarz.
// DECO_SLOTS Woerter, 0x180 bis einschliesslich 0x1D0. Der Kommentar
// sagte "acht Woerter, 0x180 .. 0x1B8" und stimmte, bis Runde MERGE
// drei Steckplaetze anhaengte; die Laenge steht deshalb jetzt als
// RECHNUNG neben der Konstante und nicht als Zahl im Kommentar.
const S_DECO: u64 = 0x180 // DECO_SLOTS Woerter
const S_DECON: u64 = 0x1D8 // wie oft ein Wert gesetzt wurde
// ============================================ RUNDE ECHTHARDWARE-4
// WER DEN FOKUS VORHER HATTE.
//
// GEMESSEN an menue-2560/serial.txt dieser Runde:
//     wm: fokus id=11 vor=7      <- das Startmenue bekommt ihn
//     taskbar: startmenue auf
//     wm: fokus id=12 vor=11     <- eine INFOBLASE bekommt ihn
//     wm: fokus id=7 vor=0       <- die Blase geht, und er faellt
//                                   auf das Anwendungsfenster
//     key: ^[                    <- Escape geht ins Leere
//
// Eine Blase ("Start", `wlib.tip_win_open`) wird als gewoehnliches
// Fenster angelegt und bekommt dabei den Fokus; ERST DANACH setzt sie
// ihre Ebene auf L_TIP, und `set_layer` gibt den Fokus dann an
// `top_visible` -- das ist das oberste NORMALE Fenster und nicht das,
// das ihn vorher hatte. Das Startmenue war ihn damit los, ohne dass
// jemand es angeklickt haette, und Escape kam nie bei ihm an.
//
// Also merkt sich der Server, wer ihn zuletzt hatte, und gibt ihn
// DORTHIN zurueck. Das ist dieselbe Regel, die jedes Fenstersystem
// fuer transiente Fenster hat.
const S_FOCUS_PREV: u64 = 0x1E0
const DECO_SLOTS: u64 = 11

// ==================================================== RUNDE PAINT
//
// DIE FORM DES FENSTERS -- vier Zahlen, die der Server bekommt, weil er
// das Fenster malt und die Widget-Bibliothek nicht an es herankommt.
//
// Runde LOOK hat die Formmarken gebaut (Radius, Schatten, Abstaende)
// und in docs/ROUNDLOOK.md ehrlich aufgeschrieben, was sie NICHT
// erreicht: "The top-level window frame is still square, and so is its
// shadow. `radius_window` and the window shadow are read out of the
// shape file, carried through the resolver and NOT DRAWN. Those pixels
// belong to the kernel's compositor, not to the widget library, and
// reaching them means widening a protocol."
//
// Das ist diese Erweiterung. Sie ist so schmal wie WM_DECO und aus
// demselben Grund: der Kernel bekommt KEINE Formdatei und keine
// Meinung, er bekommt vier aufgeloeste Zahlen. Wer sie setzen darf, ist
// wer eine Taskleiste IST -- dasselbe Recht wie bei den Farben.
const S_FORMN: u64 = 0x2A0 // wie oft ein Wert gesetzt wurde
const S_SHADOWPX: u64 = 0x2A8 // gemischte Bildpunkte fuer Schatten
const S_AAPX: u64 = 0x2B0 // Bildpunkte durch den Eckenabtaster
// ===================================================== RUNDE SOFTUI
//
// SECHS WOERTER MEHR, UND DER GRUND, WARUM S_FORM UMZIEHT.
//
// Runde PAINT hat vier Formwoerter auf 0x280 gelegt und den Zaehler
// unmittelbar dahinter auf 0x2A0. Diese Runde braucht acht -- der
// Schatten des UNSCHARFEN Fensters ist ein eigenes Paar (Staerke und
// Reichweite), der Verlauf der Titelleiste eine Zahl, und die Frage,
// ob die Titelleiste drei Windows-Schaltflaechen traegt oder das alte
// Schliessfeld, ist die achte. Acht Woerter ab 0x280 liefen genau in
// S_FORMN hinein; `tools/paint/scalars.py` haette es gemeldet, aber
// erst nach dem Bau. Also zieht der Block dorthin, wo Platz fuer die
// naechste Runde ist, und der Zaehler bleibt, wo er war.
const S_FORM: u64 = 0x300 // FORM_SLOTS Woerter
// Wie oft die Schattenmaske gebaut wurde. DAS IST DER MESSWERT DIESER
// RUNDE: er muss klein und konstant bleiben, waehrend die Zahl der
// Bilder waechst. Steigt er mit jedem Bild, ist die Maske keine.
const S_SHBUILD: u64 = 0x2B8
const S_SHKEY: u64 = 0x2C0 // fuer welche Werte sie gebaut wurde
const S_SHS: u64 = 0x2C8 // die Kantenlaenge des Eckquadrats
const S_SHOLD: u64 = 0x2D0 // GEGENPROBE: wieder mit Ringen malen
const S_CAPHOV: u64 = 0x2D8 // ueberfahrene Schaltflaeche, (Fenster*4+n)+1
const S_CAPHITS: u64 = 0x2E0
// RUNDE SCHIRM: die Vervielfachung des Fensterschmucks. 0 heisst "noch
// nicht gesetzt" und wird als 1 gelesen.
const S_UISC: u64 = 0x2E8 // wie oft eine davon geklickt wurde
// ====================================================== RUNDE BLECH2
// ZWEI ZAEHLER FUER DEN EREIGNISRING, siehe `ev_push`:
//   S_EVKOAL -- Bewegungen, die in ein NOCH NICHT ABGEHOLTES E_MOVE
//               desselben Fensters zusammengefasst wurden. Das ist
//               kein Verlust: die Anwendung bekommt die letzte Stelle,
//               und genau die will sie.
//   S_EVTERM -- Ereignisse an das Terminalfenster des KERNS, das
//               keinen Abholer in Ring 3 hat. Sie werden gezaehlt und
//               nicht eingereiht -- vorher fielen sie nach 32 Stueck
//               als VERL aus dem Ring (Justins 1283).
const S_EVKOAL: u64 = 0x2F0
const S_EVTERM: u64 = 0x2F8
// DIE MASKE SELBST. Zwei Baenke -- aktiv und unscharf -- mal
// SHMASK_SIDE^2 Oktette. 40 ist RADIUS_MAX + SHADOW_MAX, also die
// groesste Ecke, die dieser Server ueberhaupt malen darf.
const S_SHMASK: u64 = 0x400 // 3200 Oktette
const S_SHEDGE: u64 = 0x1080 // 32 Oktette
const S_FAIL: u64 = 0x10A8 // Bitmaske
const S_DIAG1: u64 = 0x10B0 // Diagnose des Selbsttests
const S_DIAG2: u64 = 0x10B8 // Bitmaske der NICHT bestandenen Zusagen

// ================== RUNDE VSYNC: DIE BILDGRENZE UND DIE BEWEGUNG
//
// Bis hierher rief `compose` am Ende `fb.flush`, und `flush` uebertrug
// die schmutzigen Zeilen SOFORT. Bei einer Bewegung liegen zwischen zwei
// Mauspaketen aber mehrere `compose`-Laeufe, und jeder davon schob seinen
// Streifen einzeln auf die Karte. Wer in diesem Augenblick abliest --
// der Bildaufbau des Schirms tut es staendig --, sieht die obere Haelfte
// des Fensters aus dem einen und die untere aus dem naechsten Zustand.
// Das ist das Reissen, und es entsteht NICHT durch einen fehlenden
// Rueckpuffer (den gibt es seit Runde SCHIRM), sondern durch die
// FEHLENDE BILDGRENZE: es war nie gesagt, welche Zeichenschritte
// zusammen EIN Bild sind.
//
// Also wird die Uebertragung von der Zeichnung getrennt:
//
//   `compose`  zeichnet in den Rueckpuffer und merkt den Bereich vor.
//   `present`  uebertraegt EINMAL, im Zeitgebertakt.
//
// S_VSYNC schaltet das an, S_PEND sammelt das Rechteck ueber mehrere
// `compose`-Laeufe hinweg. `nopresent` ist die Gegenprobe: dann geht es
// wieder den alten Weg, und die Zerreissprobe MUSS fehlschlagen.
const S_VSYNC: u64 = 0x10C0 // 1 = Uebertragen erst im Tick
const S_PEND: u64 = 0x10C8 // 1 = es liegt ein ungezeigtes Bild
const S_PX0: u64 = 0x10D0 // das gesammelte Rechteck
const S_PY0: u64 = 0x10D8
const S_PX1: u64 = 0x10E0
const S_PY1: u64 = 0x10E8
const S_PRESENTS: u64 = 0x10F0 // wie oft wirklich uebertragen wurde
const S_SKIPPED: u64 = 0x10F8 // Zeichnungen ohne eigene Uebertragung
// DIE ZERREISSPROBE. Jedes Bild bekommt eine Nummer; malt der Server im
// Signaturbetrieb, faerbt er den oberen und den unteren Rand JEDES
// Fensters mit einer Farbe, die aus dieser Nummer faellt. Ein
// Bildschirmfoto, das im selben Fenster ZWEI verschiedene Signaturen
// zeigt, hat ein halb uebertragenes Bild erwischt -- und genau das ist
// Reissen, sichtbar gemacht.
const S_SIG: u64 = 0x1100 // 1 = Signaturbetrieb
const S_FRAME: u64 = 0x1108 // die laufende Bildnummer
// DIE BEWEGUNG BEIM OEFFNEN UND SCHLIESSEN. Vier Zahlen je Fenster
// liegen im Fenstersatz (W_AN*), hier stehen nur die Zaehler und der
// Takt. Die Zeiten kommen aus den Formmarken (FM_MOTION) und nicht aus
// eigenen Konstanten -- DESIGN-2 hat sie in wlib gesetzt, und zwei
// Wahrheiten ueber dieselbe Dauer waeren eine zu viel.
// DER ABLESER DER ZERREISSPROBE. Er tut, was ein Bildschirm tut: er
// liest den VORDERPUFFER, oben und unten, und vergleicht die beiden
// Signaturen. Sind sie verschieden, hat er ein halb uebertragenes Bild
// erwischt -- und genau das ist Reissen.
const S_LESER: u64 = 0x1130 // 1 = der Ableser laeuft
const S_LIEST: u64 = 0x1138 // wie oft abgelesen wurde
const S_RISS: u64 = 0x1140 // wie oft es dabei nicht zusammenpasste
const S_LX: u64 = 0x1148 // wo abgelesen wird (Fenstermitte)
const S_LY0: u64 = 0x1150 // die obere Zeile
const S_LY1: u64 = 0x1158 // und die untere
const S_R0: u64 = 0x1160 // die erste beobachtete Signatur oben, +1
const S_R1: u64 = 0x1168 // und die untere, +1
const S_KEIN: u64 = 0x1170 // Ablesungen ohne Signatur an einer Stelle
const S_LPAAR: u64 = 0x1178 // zwei Woerter: die beiden abgelesenen Punkte
const S_LFEST: u64 = 0x1188 // 1 = die Ablesestelle steht fest
const S_RY0: u64 = 0x11A8 // wo der erste Riss gesehen wurde
const S_RY1: u64 = 0x11B0
const S_RFR: u64 = 0x11B8 // und bei welcher Bildnummer
const S_VERWORF: u64 = 0x11C0 // Ablesungen ueber eine Bildgrenze hinweg
// Die drei Zahlen der Vorfuehrung (kgui ruft sie). Sie liegen HIER und
// nicht in `kstate`, weil dort jede Seite gezaehlt ist und diese drei
// nur die Oberflaeche etwas angehen.
const S_VT0: u64 = 0x1190 // Tick, an dem das Halten begann
const S_VSTEP: u64 = 0x1198 // wie weit die Vorfuehrung ist
const S_VWIN: u64 = 0x11A0 // das vorgefuehrte Fenster + 1
const S_ANIMS: u64 = 0x1110 // begonnene Bewegungen
const S_ANFRAMES: u64 = 0x1118 // gezeichnete Zwischenbilder
const S_NOANIM: u64 = 0x1120 // GEGENPROBE: keine Bewegung
const S_TICKS: u64 = 0x1128 // wie oft `anim_tick` lief
// RUNDE SCHNELLBILD: die SUMME der uebertragenen Bildpunkte, ueber
// alle Bilder. Zusammen mit S_PRESENTS ergibt das den Anteil, den ein
// Bild wirklich anfasst -- die Zahl, die FREMDSOFTWARE.md 4a mit
// "1 bis 5 Prozent" veranschlagt. `present` gibt die Flaeche schon
// zurueck, aber niemand hat sie bisher aufsummiert, und ohne Summe ist
// der Anteil nicht messbar.
// RUNDE MERGE9: 0x11C8 statt 0x1130. Auf 0x1130 liegt seit Runde
// GLYPHE S_LESER (kernel/wm.fi:554) -- die Runde SCHNELLBILD hat
// S_PXSUM auf ihrem Zweig dorthin gelegt, weil die Stelle DORT frei
// war. Zusammengefuehrt schrieben beide dasselbe Wort: der Ableser
// haette die Pixelsumme als "laeuft/laeuft nicht" gelesen und die
// Summe waere bei jedem Anstrich ueberschrieben worden.
// GEMESSEN von tools/paint/run.sh ("Skalare ueberschneiden sich").
// 0x11C8 ist das erste freie Wort hinter S_VERWORF (0x11C0).
const S_PXSUM: u64 = 0x11C8

// ==================================== ZUSAMMENFUEHRUNG VEKTOR + ECHTHARDWARE-5
// BEIDE RUNDEN HABEN SICH DIESELBEN WORTE GENOMMEN.
//
// ECHTHARDWARE-5 legte S_TOUT/S_TPUT (Terminalzaehler) und die fuenf
// Woerter des Kantenziehens auf 0x11D0..0x1200; die Bildzeitmessung
// dieser Runde lag auf DENSELBEN 0x11D0..0x1248. Sechs Worte
// ueberschnitten sich -- 0x11D0, 0x11D8, 0x11E0, 0x11E8, 0x11F0 und
// 0x1200. Das haette keinen Uebersetzungsfehler gegeben, sondern das
// hier: die Bildzeit haette den Ankerwert der gezogenen Kante
// ueberschrieben, und ein Fenster waere beim Ziehen gesprungen,
// waehrend die Bildzeitfaecher Unsinn zeigen. Genau die Sorte Fehler,
// die man auf einem Foto sieht und im Quelltext nicht.
//
// AUFGELOEST ZUGUNSTEN VON ECHTHARDWARE-5 AN SEINER STELLE: dessen
// Zahlen stehen in einem ausgelieferten Abbild und sind auf echtem
// Blech gemessen; die Bildzeitmessung ist juenger und noch in keinem
// Abbild. Sie zieht deshalb auf 0x1300..0x1378 um, wo nichts liegt
// (WM_MAX ist 0x2000). Keine der beiden Runden verliert ein Feld.

// ==================================================== RUNDE ECHTHARDWARE-5
// WIE VIELE OKTETTE IM TERMINALFENSTER ANGEKOMMEN SIND.
//
// Justins Befund B: das Fenster "Terminal -- sh" ist LEER, obwohl die
// Tafel `sh14` meldet -- die Shell laeuft also. Zwischen der Shell und
// der Zeichenflaeche versickert die Ausgabe, und ohne eine Zahl ist
// nicht zu unterscheiden, ob (a) nie ein Oktett hier ankommt, (b) sie
// ankommen und in kein Feld gemalt werden, oder (c) sie gemalt und
// gleich wieder ueberdeckt werden. Diese zwei Zaehler trennen die
// Faelle: `S_TOUT` zaehlt JEDEN Ruf von `term_out`, `S_TPUT` nur die,
// die wirklich eine Zelle gesetzt haben.
const S_TOUT: u64 = 0x11D0
const S_TPUT: u64 = 0x11D8

// ==================================================== RUNDE ECHTHARDWARE-5
// AN WELCHER KANTE DIE GROESSE GEZOGEN WIRD -- UND WOGEGEN.
//
// Justins Befund D: "Ziehen funktioniert nur an der rechten Kante."
// Das stimmte, und es stand so im Quelltext: `on_mouse` nahm nur
// `am_rechts || am_unten` an, und `resize_win` rechnet die neue
// Groesse IMMER aus der linken oberen Ecke (`x - win_x`). Damit KANN
// die linke und die obere Kante nicht gehen -- eine Bewegung nach
// links macht das Fenster dort schmaler statt breiter.
//
// `S_SZEDGE` ist eine Bitmaske: 1 links, 2 rechts, 4 oben, 8 unten.
// Eine Ecke ist zwei Bits gleichzeitig, und genau das macht "beide
// Achsen zugleich" aus. Die vier Ankerwerte halten die
// GEGENUEBERLIEGENDE Kante fest: zieht man links, bleibt rechts stehen,
// und das Fenster springt nicht.
const S_SZEDGE: u64 = 0x11E0
const S_SZAX: u64 = 0x11E8 // die festgehaltene x-Kante (Bildschirm)
const S_SZAY: u64 = 0x11F0 // die festgehaltene y-Kante
const S_SZAW: u64 = 0x11F8 // Breite beim Anfassen
const S_SZAH: u64 = 0x1200 // Hoehe beim Anfassen

const SZ_L: u64 = 1
const SZ_R: u64 = 2
const SZ_T: u64 = 4
const SZ_B: u64 = 8

// ---------------------------------------------- RUNDE VEKTOR: DIE BILDZEIT
//
// Bis hierher gab es KEINE Zahl fuer "wie lange dauert ein Bild". Es
// gab die Zahl der Bilder und die der Bildpunkte, aber nicht die Zeit
// -- und damit liess sich die Auflage "kein Bild ueber 16 ms" weder
// vorher noch nachher belegen, sondern nur behaupten.
//
// Gemessen wird um `compose` herum, also um das Zusammensetzen des
// Bildes: Hintergrund, Fenster, Leiste, Zeiger. Die Uhr ist der
// Zyklenzaehler (`time.tsc`), umgerechnet ueber `time.khz`.
//
// Vier Zahlen, weil ein Mittelwert allein den schlimmsten Fall
// versteckt -- und der schlimmste Fall ist der, den ein Mensch als
// Ruckeln sieht.
const S_FRUS: u64 = 0x1300    // Summe der Bildzeiten in Mikrosekunden
const S_FRN: u64 = 0x1308     // wie viele Bilder darin stecken
const S_FRMAX: u64 = 0x1310   // die laengste Bildzeit
const S_FRLAST: u64 = 0x1318  // die letzte Bildzeit
// Wie viele Bilder ueber 16 ms lagen. Die Auflage dieser Runde in
// einer Zahl: sie MUSS null bleiben.
const S_FRUEBER: u64 = 0x1320
// Ein Histogramm, acht Faecher, je eine Verdoppelung: <1ms, <2, <4,
// <8, <16, <32, <64, darueber. Ein Mittelwert und ein Groesstwert
// sagen nicht, OB die langen Bilder am Anfang stehen (Moduswechsel,
// kalter Zwischenspeicher) oder mitten im Betrieb -- und genau das
// ist der Unterschied zwischen "faellt niemandem auf" und "ruckelt".
const S_FRH: u64 = 0x1330      // acht Worte, 0x1330..0x1368
// Die laengste Bildzeit NACH den ersten zehn Bildern. Die ersten zehn
// sind der Start: erstes Bild ueberhaupt, erster Moduswechsel, erste
// Schrift. Was danach kommt, ist der Betrieb.
const S_FRMAXW: u64 = 0x1370
const S_FRUEBERW: u64 = 0x1378

// ------------------------------- RUNDE VEKTOR: DIE ZEICHEN LIEGEN FERTIG
//
// Ein Fensterzeichen ist in jedem Bild dasselbe: dieselbe Form,
// dieselbe Groesse, dieselbe Kantenglaettung. Es JE BILD neu zu
// rastern -- Bezier zerlegen, Kanten bauen, vier Abtastzeilen je
// Bildzeile -- ist Arbeit, deren Ergebnis schon dasteht.
//
// GEMESSEN, warum das noetig ist: ohne diesen Speicher stieg bei
// 2560x1440 und Vervielfachung 2 die mittlere Bildzeit von 4234 auf
// 5211 Mikrosekunden, und im Betrieb rutschten sechsundzwanzig Bilder
// aus dem Fach 4..8 ms in das Fach 8..16 ms. Die Formen sind billig,
// aber sie sind es NICHT dreimal je Fenster und Bild.
//
// Vier Zeichen: Minimieren, Maximieren, Wiederherstellen, Schliessen.
// Je Zeichen die Deckung als ein Oktett pro Bildpunkt, hoechstens
// 40x40 (10 * Vervielfachung 4).
const CG_N: u64 = 4
// RUNDE KERN-FUI: EIN FACH HAELT JETZT VIER OKTETTE JE BILDPUNKT.
//
// `fui.core` schreibt BGRX (`core.put`), also vier Oktette -- es in ein
// Oktett je Punkt malen zu lassen ginge nur, indem man `core.fi` eine
// zweite Ablage beibringt, und das waere wieder die zweite Umsetzung,
// die diese Runde gerade abschafft. Also bekommt fUi, was es erwartet,
// und der Puffer waechst von 6400 auf 25 600 Oktette.
//
// Nach dem Rastern wird das Fach an Ort und Stelle auf ein Oktett je
// Punkt eingedampft (`cg_dampf`) -- das Uebertragen laeuft je BILD und
// liest dann ein Viertel.
const CG_KANTE: u64 = 40      // 10 * Vervielfachung 4
const CG_FACH: u64 = 6400     // 40 * 40 * 4 Oktette je Zeichen
const CG_MAX: u64 = 1600      // 40 * 40 Punkte

// RUNDE VEKTOR: die vier gerasterten Zeichen. `cg_gr` ist die
// Kantenlaenge, mit der sie gerastert wurden -- wechselt die
// Vervielfachung, gilt der Speicher nicht mehr.
static mut cg_deck: [u8; 25600] = [0 as u8; 25600]
static mut cg_gut: [u64; 4] = [0 as u64; 4]
static mut cg_gr: u64 = 0
static mut cg_w: [u64; 4] = [0 as u64; 4]
static mut cg_h: [u64; 4] = [0 as u64; 4]
static mut cg_treffer: u64 = 0
static mut cg_bauten: u64 = 0

// Die Arten einer Fensterbewegung. Oeffnen waechst, Schliessen und
// Minimieren schrumpfen -- der Unterschied zwischen den letzten beiden
// liegt NICHT im Bild, sondern darin, was danach passiert.
const AN_OPEN: u64 = 1
const AN_CLOSE: u64 = 2
const AN_MIN: u64 = 3
// Ein Tick sind zehn Millisekunden, weil `time.TICK_HZ` 100 ist. Die
// Zahl steht hier als Konstante und nicht als Division im Quelltext,
// damit ein Takt von 250 Hz an EINER Stelle nachgezogen wird.
const MS_PRO_TICK: u64 = 10
// Die Vorgabe, wenn keine Formmarke da ist: MO_FAST aus wlibc.
const MOTION_DEF: u64 = 120
const MOTION_MAX: u64 = 500
// Wie hoch der Signaturstreifen ist. Vier Zeilen sind im PPM sicher zu
// finden und im Bild klein genug, um den Rest nicht zu verdecken.
const SIG_H: u64 = 4
// Wie klein ein Fenster am Anfang der Oeffnungsbewegung ist, in
// Tausendsteln. 850 heisst: es waechst aus 85 Prozent heraus -- der
// Sprung, den man sieht, ohne dass es zappelt.
const AN_SCALE0: u64 = 850
const SHMASK_SIDE: u64 = 40
const FORM_SLOTS: u64 = 9
const FM_RADIUS: u64 = 0 // Eckenradius des Fensterrahmens, 0 = eckig
const FM_SHADOW: u64 = 1 // Staerke des Schattens, 0..100, 0 = keiner
const FM_SHADOW_R: u64 = 2 // wie weit er reicht, in Bildpunkten
const FM_SHADOW_C: u64 = 3 // seine Farbe, 0xRRGGBB
// RUNDE SOFTUI: DER SCHATTEN DES UNSCHARFEN FENSTERS.
//
// Das ist die eine Stelle, an der man den Fokus SIEHT, ohne dass eine
// Titelleiste dafuer knallblau sein muss: das aktive Fenster steht
// hoeher ueber dem Schreibtisch als die anderen. Zwei Zahlen und nicht
// eine, weil "tiefer" beides ist -- dunkler UND weiter.
const FM_SHADOW2: u64 = 4 // Staerke unter einem unscharfen Fenster
const FM_SHADOW_R2: u64 = 5 // und wie weit die reicht
// Der Verlauf der Titelleiste, in Helligkeitsstufen ueber die ganze
// Hoehe. 0 = Volltonfarbe, also genau das Bild vor dieser Runde.
const FM_GRAD: u64 = 6
// 0 = das alte Schliessfeld (ein rotes Quadrat mit Kreuz), 1 = die
// drei Windows-Schaltflaechen rechts oben.
const FM_CAPTION: u64 = 7
// RUNDE VSYNC: DIE DAUER EINER FENSTERBEWEGUNG, in Millisekunden.
// Sie kommt aus derselben Quelle wie alle anderen Formmarken -- die
// Taskleiste schickt sie beim Start --, damit "Animationen reduzieren"
// EINE Stelle hat und nicht zwei. 0 heisst SOFORT FERTIG und nicht
// uebersprungen: der Endzustand wird in beiden Faellen erreicht.
// Vorgabe ist MO_FAST aus wlibc (120 ms), siehe DESIGN-2.
const FM_MOTION: u64 = 8
// Die Obergrenzen. Sie stehen hier und nicht beim Aufrufer, weil ein
// Radius von 4000 den Rahmen nicht rund macht, sondern den Server in
// eine Schleife ueber vier Millionen Eckpunkte schickt.
const RADIUS_MAX: u64 = 24
const SHADOW_MAX: u64 = 16
// RUNDE SOFTUI: die Obergrenze des Titelverlaufs, in Helligkeitsstufen.
const GRAD_MAX: u64 = 24
// Die drei Schaltflaechen rechts oben, in der Reihenfolge, in der sie
// dort stehen. DIE ZAHLEN SIND EIN PROTOKOLL: `cap_hover` gibt
// (Fenster * 4 + n) + 1 zurueck, und tools/softui/ liest sie.
const CAP_MIN: u64 = 0 // Minimieren -- ein waagerechter Strich
const CAP_MAX: u64 = 1 // Maximieren -- ein Quadrat
const CAP_CLOSE: u64 = 2 // Schliessen -- ein Kreuz
const CAP_N: u64 = 3
// Die Breite einer Schaltflaeche. Windows 11 nimmt 46 auf 1920; hier
// sind es 800 Bildpunkte Schirmbreite und Fenster ab 300, also ist die
// Flaeche auf 30 x (TITLE_H - 2*BORDER) heruntergerechnet -- immer noch
// ein groesseres Ziel als das 14 x 14 grosse Schliessfeld davor.
const CAP_W0: u64 = 30
const DK_FRAME: u64 = 0
const DK_TITLE: u64 = 1
const DK_TEXT: u64 = 2
const DK_FRAME_ON: u64 = 3
const DK_TITLE_ON: u64 = 4
const DK_TEXT_ON: u64 = 5
const DK_CLOSE: u64 = 6
const DK_CLOSE_MARK: u64 = 7
// Drei weitere Flaechen, die der Server selbst faerbt: der Grund unter
// allen Fenstern (sichtbar, solange kein Schreibtisch laeuft) und die
// beiden Farben eines Terminalfensters.
//
// NICHT DABEI IST DER MAUSZEIGER. Er bleibt weiss mit schwarzem Rand,
// und zwar mit Absicht: er liegt ueber den Bildpunkten der Anwendung,
// und was dort steht, bestimmt kein Thema. Ein Zeiger, der sich mit dem
// Thema faerbt, ist ein Zeiger, den man auf dem falschen Bild verliert.
const DK_DESK: u64 = 8
const DK_TERM_FG: u64 = 9
const DK_TERM_BG: u64 = 10
// Die Bitmaske einer 24-Bit-Farbe. Sie hat einen Namen, damit
// tests/theme/rawcolour.py sie nicht als Farbe zaehlt -- und weil eine
// Maske, die wie eine Farbe aussieht, es verdient, eine zu heissen.
const RGB24: u64 = 0x00FFFFFF
// Die groesste Strebe, die ein Fenster anmelden darf. Sie steht hier,
// weil 0xFFFFFF mitten in einer Bedingung wie eine Farbe aussieht und
// keine ist.
const STRUT_MAX: u64 = 0x00FFFFFF
// Die beiden Prueffarben des Selbsttests. Sie faerben nichts, was ein
// Mensch sieht: sie werden geschrieben und wieder gelesen.
const PROBE_IN: u64 = 0x0000FF00
const PROBE_OUT: u64 = 0x00FF0000
// DER MAUSZEIGER IST ABSICHTLICH THEMENFREI. Er liegt ueber den
// Bildpunkten der Anwendung, und was dort steht, bestimmt kein Schema
// -- ein Foto, ein Terminal, ein Spiel. Weiss mit schwarzem Rand ist
// auf jedem Grund zu sehen; eine Zeigerfarbe aus dem Thema ist eine,
// die man auf dem falschen Bild verliert. Deshalb stehen diese beiden
// Werte hier und werden nicht ueber WM_DECO gesetzt.
const CURSOR_BODY: u64 = 0x00FFFFFF
const CURSOR_EDGE: u64 = 0x00000000

// ein Fenster
const W_USED: u64 = 0x00
const W_ID: u64 = 0x08
const W_OWNER: u64 = 0x10
const W_X: u64 = 0x18 // AUSSEN, oben links
const W_Y: u64 = 0x20
const W_W: u64 = 0x28 // die Malflaeche, ohne Rahmen
const W_H: u64 = 0x30
const W_BUF: u64 = 0x38
const W_BUFBYTES: u64 = 0x40
const W_Z: u64 = 0x48
const W_KIND: u64 = 0x50
const W_COLS: u64 = 0x58
const W_ROWS: u64 = 0x60
const W_CX: u64 = 0x68
const W_CY: u64 = 0x70
const W_GRID: u64 = 0x78
const W_EHEAD: u64 = 0x80
const W_ETAIL: u64 = 0x88
const W_FG: u64 = 0x90
const W_BG: u64 = 0x98
const W_CELLW: u64 = 0xA0
const W_CELLH: u64 = 0xA8
// 0xB8 und NICHT 0xA8: dort liegt W_CELLH. Die erste Fassung nahm 0xA8,
// und die Zahl der Tastenereignisse des Terminalfensters war danach
// genau seine Zellenhoehe -- neunzehn, ohne dass eine Taste gedrueckt
// worden waere. Dieselbe Sorte Fehler wie Runde K7B, eine Ebene tiefer.
const W_KEYS: u64 = 0xB8
const W_TTY: u64 = 0xB0 // Runde K10: das Terminal + 1, 0 = keines
const W_TITLE: u64 = 0xC0 // 32 Oktette, bis 0xE0
// RUNDE DESKTOP: die beiden letzten freien Woerter des Satzes. Der
// Satz ist 256 Oktette lang, der Titel endet bei 0xE0 -- vier Woerter
// waren frei, zwei sind es noch.
const W_LAYER: u64 = 0xE0 // L_DESK, L_NORMAL oder L_TOP
const W_FLAGS: u64 = 0xE8 // F_HIDDEN | F_NODECO | F_MAXIMIZED
// ADDENDUM TASKBAR: the last two free words of the record. After this
// the 256 octets are full; the next round that needs a field has to
// enlarge WIN_BYTES, and that moves the window table (see `wat`).
//   W_STRUT  0 = this window reserves nothing.
//            otherwise (edge + 1) | (size << 8).
//   W_SAVE   the rectangle to go back to when a maximized window is
//            restored: x, y, w, h packed into four 16-bit fields, the
//            two coordinates biased by 4096 because a window may sit
//            at a negative one.
const W_STRUT: u64 = 0xF0
const W_SAVE: u64 = 0xF8
// RUNDE TILING, IN EINEN GROESSEREN SATZ. Diese Runde hatte 0xE0, 0xE8,
// 0xF0 und 0xF8 genommen -- dieselben vier Woerter, die DESKTOP und der
// Taskleisten-Nachtrag schon belegt haben, mit anderer Bedeutung. Der
// Satz von 256 Oktetten ist damit wirklich voll, und der Nachtrag hat
// aufgeschrieben, was dann zu tun ist: WIN_BYTES wird groesser, und die
// Fenstertafel wandert. WIN_BYTES ist deshalb 512, die Ereignisringe
// liegen ab 0x2000 statt ab 0x1000, und diese Runde bekommt drei
// Woerter im neuen Teil.
const W_NODE: u64 = 0x100 // Knoten im Fensterbaum + 1, 0 = schwebend
// Wohin ein Fenster zurueckkehrt, wenn es den Baum verlaesst. Zwei
// Woerter statt vier: x und y beziehungsweise Breite und Hoehe in je
// zwei Vierteln. Ein Fenster ist hoechstens 2048 gross, das passt.
const W_SAVXY: u64 = 0x108
const W_SAVWH: u64 = 0x110
// ==================================================== RUNDE PAINT
//
// WELCHEM PROGRAMM DIESES FENSTER GEHOERT -- als BUENDELNAME, nicht als
// Titel.
//
// DIE FRAGE, DIE DAHINTER STEHT: "warum sind Start, Terminal und Suchen
// in der Taskleiste keine Symbole?" Die Symbole EXISTIEREN seit Runde
// K15 (`/apps/<name>.osp/symbol`, Format OSYM). Was fehlte, war die
// Verbindung: ein Fenster hatte einen TITEL und sonst nichts, und ein
// Titel ist uebersetzt, vom Programm frei waehlbar und aendert sich
// waehrend des Laufs ("Terminal -- sh").
//
// ZWEI WEGE WAREN MOEGLICH, und die Wahl ist begruendet:
//
//   1. DER SERVER LEITET ES AUS DEM PROGRAMMPFAD AB. Klingt billiger,
//      ist es nicht. Der Pfad steht nirgends im Aufgabensatz; `procfs`
//      liest argv[0] durch die Seitentabelle des FREMDEN Prozesses
//      (`make_cmdline`), also einmal je Fenster und Neuzeichnen. Und er
//      antwortet falsch, wo es darauf ankommt: `/bin/files` und
//      `/bin/explorer` sind DIESELBE Inode (Runde K15), ein Programm
//      kann per Shell-Skript gestartet sein, und `sh` in einem
//      Terminalfenster ist nicht das Programm, das das Fenster besitzt.
//   2. DAS PROGRAMM SAGT ES SELBST, einmal, beim Oeffnen. Das ist, was
//      X11 `WM_CLASS` nennt und Windows `AppUserModelID`, und aus
//      demselben Grund: nur die Anwendung weiss, als was sie auftreten
//      will.
//
// Also (2). Vierundzwanzig Oktette im Fenstersatz, gesetzt ueber
// WM_APP, ausgeliefert in WM_LIST. Wer nichts sagt, bekommt einen
// leeren Namen und die Taskleiste faellt auf reinen Text zurueck --
// dieselbe Regel wie bei Netz und Akku.
const W_APP: u64 = 0x118 // APP_LEN Oktette

// ================= RUNDE MESSTAFEL: WURDE DIESES FENSTER GEMALT ODER NICHT
//
// Justins Taskleiste meldet Erfolg (`rc=0`, richtige Groesse, richtige
// Kante) und ist trotzdem nicht zu sehen. Zwischen "das Fenster gibt es"
// und "die Bildpunkte stehen auf dem Schirm" lagen bisher vier Stufen
// ohne eine einzige Zahl. Diese beiden Zaehler schliessen die groesste
// Luecke davon:
//
//   W_PAINTS  wie oft `paint_win` dieses Fenster wirklich gemalt hat
//   W_PX      wie viele Bildpunkte dabei zusammenkamen
//
// Steht bei der Leiste PAINTS=0, hat `compose` sie UEBERGANGEN -- dann
// ist sie verborgen, nicht in der Stapelfolge, oder ihr Rechteck liegt
// ausserhalb des schmutzigen Bereichs. Steht PAINTS hoch und man sieht
// sie trotzdem nicht, sind die Bildpunkte gemalt und der Fehler liegt
// DAHINTER (Zweitpuffer, Flush, Zeilenabstand). Das ist der Unterschied,
// den kein Foto bisher machen konnte.
//
// 0x118 + APP_LEN endet bei 0x130, WIN_BYTES ist 512 -- der Platz ist da.
const W_PAINTS: u64 = 0x130 // wie oft compose dieses Fenster malte
const W_PX: u64 = 0x138 // und wie viele Bildpunkte dabei herauskamen

// RUNDE VSYNC: DIE BEWEGUNG EINES FENSTERS. Vier Zahlen, und keine
// davon ist eine Dauer in Bildern: `W_AN0` ist der Tick, an dem sie
// begann, `W_ANMS` die zugesagte Dauer in Millisekunden. Erst
// `anim_p` rechnet daraus den Fortschritt -- dieselbe Trennung wie in
// wlib (DESIGN-2), damit ein Kernel mit TICK_HZ=100 und eine
// Bibliothek, die in Millisekunden zusagt, dieselbe Bewegung meinen.
const W_ANK: u64 = 0x140 // Art: 0 keine, AN_OPEN, AN_CLOSE, AN_MIN
const W_AN0: u64 = 0x148 // Starttick
const W_ANMS: u64 = 0x150 // zugesagte Dauer in Millisekunden
const W_ANP: u64 = 0x158 // zuletzt gezeichneter Fortschritt, 0..1000
// ================================================== RUNDE VOLLBILD
// WOHIN DAS VOLLBILD ZURUECKKEHRT -- eigene Plaetze, NICHT W_SAVE.
//
// W_SAVE gehoert dem Maximieren. Wuerde das Vollbild denselben Platz
// benutzen, zerstoerte der Weg "maximiert -> Vollbild -> zurueck"
// genau die Zahl, auf die das Maximieren zurueckwill: das Fenster
// kaeme als normales Fenster mit den Massen der Arbeitsflaeche
// heraus, und es waere nicht mehr maximiert. Zwei Zustaende, zwei
// Sicherungen.
const W_FSXY: u64 = 0x160
const W_FSWH: u64 = 0x168
const APP_LEN: u64 = 24

// "kein Terminal". Absichtlich eine Zahl und kein Ruf nach `tty.fi`:
// dieses Modul darf `tty` NICHT einbinden, weil `tty` es einbindet
// (SINK_WINDOW). Der Abhaengigkeitsgraph bleibt ein Baum, und die
// Richtung ist die richtige -- der Fensterserver weiss nichts von
// Zeilendisziplinen, das Terminal weiss, wohin es schreibt.
const NO_TTY: u64 = 255

fn gs(state: u64, off: u64) -> u64 {
    return kstate.get(state + kstate.WM_OFF, off)
}

fn ss(state: u64, off: u64, v: u64) {
    kstate.set(state + kstate.WM_OFF, off, v)
}

// RUNDE THEME: DIE ACHT FARBEN DER DEKORATION.
//
// `deco_fallback` ist die EINZIGE Stelle im Server, an der eine Farbe
// als Zahl steht. Sie sind die Werte, die bis zu dieser Runde mitten im
// Zeichencode standen, und sie gelten genau so lange, bis ein Programm
// in Ring 3 etwas anderes sagt.
fn deco_fallback(i: u64) -> u64 {
    if i == DK_FRAME {
        return 0x003A4654
    }
    if i == DK_TITLE {
        return 0x002C3848
    }
    if i == DK_TEXT {
        return 0x00909CA8
    }
    if i == DK_FRAME_ON {
        return 0x004C9AE8
    }
    if i == DK_TITLE_ON {
        return 0x001C4E7E
    }
    if i == DK_TEXT_ON {
        return 0x00FFFFFF
    }
    if i == DK_CLOSE {
        return 0x00D04040
    }
    if i == DK_DESK {
        return 0x001E2A38
    }
    if i == DK_TERM_FG {
        return 0x00E0E6EC
    }
    if i == DK_TERM_BG {
        return 0x0010141A
    }
    return 0x00FFFFFF
}

fn deco_rgb(state: u64, i: u64) -> u64 {
    if i >= DECO_SLOTS {
        return 0
    }
    let v: u64 = gs(state, S_DECO + i * 8)
    if v == 0 {
        return deco_fallback(i)
    }
    return v - 1
}

// 0xRRGGBB im Format des Bildschirms. Der Server rechnet um und nicht
// der Aufrufer: welches Format der Rahmenpuffer hat, weiss `fb`.
fn rgb24(state: u64, v: u64) -> u64 {
    return fb.rgb(state, (v >> 16) & 255, (v >> 8) & 255, v & 255)
}

fn deco(state: u64, i: u64) -> u64 {
    return rgb24(state, deco_rgb(state, i))
}

fn set_deco_colour(state: u64, i: u64, v: u64) -> bool {
    if i >= DECO_SLOTS {
        return false
    }
    ss(state, S_DECO + i * 8, (v & RGB24) + 1)
    ss(state, S_DECON, gs(state, S_DECON) + 1)
    if i == DK_DESK {
        ss(state, S_DESK, deco(state, DK_DESK))
    }
    // EIN TERMINALFENSTER, DAS SCHON OFFEN IST, ZIEHT MIT. Seine
    // beiden Farben stehen im Fenster und nicht im Server, weil jedes
    // Terminal seine eigenen haben darf; wer nur die Voreinstellung
    // aendert, aendert sonst nur die Fenster, die es noch nicht gibt.
    if i == DK_TERM_FG || i == DK_TERM_BG {
        var k: u64 = 0
        while k < MAX_WIN {
            if wg(state, k, W_USED) != 0 && wg(state, k, W_KIND) == K_TERM {
                if i == DK_TERM_FG {
                    wsv(state, k, W_FG, deco(state, DK_TERM_FG))
                } else {
                    wsv(state, k, W_BG, deco(state, DK_TERM_BG))
                    // ==================================== RUNDE FARBE
                    // DIE NEUE FARBE MUSS AUCH GEMALT WERDEN.
                    //
                    // Hier wurde bis zu dieser Runde NUR `W_BG`
                    // gesetzt. Das ist die Farbe, mit der das Terminal
                    // KUENFTIG loescht -- die Bildpunkte, die schon im
                    // Puffer stehen, behalten die alte. Ein Terminal,
                    // das beim Start des Systems entsteht (der
                    // Schreibtisch macht genau das) und dessen Flaeche
                    // sich danach nicht mehr ganz erneuert, bleibt
                    // deshalb fuer immer in der eingebauten Farbe.
                    //
                    // GEMESSEN (1280x800, mode=dark, dieser Runde):
                    // #10141a auf 20,4 Prozent der Bildflaeche,
                    // Blaustich B-R = +10, waehrend der Rest des
                    // Schirms schon auf der neutralen Rampe stand
                    // (#18181b, B-R = +3). Genau das Fenster, von dem
                    // Justin sagt, es sei "immer noch blau".
                    //
                    // Der Reihenfolge wegen ist das kein Sonderfall,
                    // sondern die Regel: die Leiste schickt ihre elf
                    // Farben, WENN sie laeuft -- und das ist immer
                    // NACH dem ersten Fenster.
                    fill(state, k, 0, 0, wg(state, k, W_W),
                        wg(state, k, W_H), deco(state, DK_TERM_BG))
                    term_redraw(state, k)
                    damage_win(state, k)
                }
            }
            k = k + 1
        }
    }
    return true
}

// ==================================================== RUNDE PAINT
//
// DIE FORM DES FENSTERS. Vier Zahlen, gesetzt von dem, der auch die
// Farben setzt, gelesen von `paint_win`.
//
// Wie bei den Farben wird WERT + 1 abgelegt: null heisst "nie gesetzt".
// Der Rueckfall ist ECKIG UND OHNE SCHATTEN, also genau das Bild, das
// dieses System vor dieser Runde gemalt hat. Eine Maschine, deren
// Taskleiste noch nicht laeuft, sieht damit aus wie immer und nicht
// wie ein halb gemaltes Fenster.
fn form(state: u64, i: u64) -> u64 {
    if i >= FORM_SLOTS {
        return 0
    }
    let v: u64 = gs(state, S_FORM + i * 8)
    if v == 0 {
        return 0
    }
    return v - 1
}

fn set_form(state: u64, i: u64, v: u64) -> bool {
    if i >= FORM_SLOTS {
        return false
    }
    var w: u64 = v
    if i == FM_RADIUS && w > RADIUS_MAX {
        w = RADIUS_MAX
    }
    if i == FM_SHADOW && w > 100 {
        w = 100
    }
    if i == FM_SHADOW_R && w > SHADOW_MAX {
        w = SHADOW_MAX
    }
    if i == FM_SHADOW_C {
        w = w & RGB24
    }
    // RUNDE SOFTUI: dieselben Grenzen fuer das zweite Paar, und der
    // Verlauf bekommt eine eigene. GRAD_MAX ist die Zahl, ueber der
    // aus "dezent" ein Farbkeil wird -- 24 Helligkeitsstufen ueber die
    // ganze Titelleiste sind schon mehr, als Windows 11 nimmt.
    if i == FM_SHADOW2 && w > 100 {
        w = 100
    }
    if i == FM_SHADOW_R2 && w > SHADOW_MAX {
        w = SHADOW_MAX
    }
    if i == FM_GRAD && w > GRAD_MAX {
        w = GRAD_MAX
    }
    if i == FM_CAPTION && w > 1 {
        w = 1
    }
    // RUNDE VSYNC: eine halbe Sekunde ist die Obergrenze. Laenger ist
    // keine Rueckmeldung mehr, sondern Warten.
    if i == FM_MOTION && w > MOTION_MAX {
        w = MOTION_MAX
    }
    ss(state, S_FORM + i * 8, w + 1)
    ss(state, S_FORMN, gs(state, S_FORMN) + 1)
    return true
}

fn form_writes(state: u64) -> u64 {
    return gs(state, S_FORMN)
}

fn shadow_px(state: u64) -> u64 {
    return gs(state, S_SHADOWPX)
}

fn aa_px(state: u64) -> u64 {
    return gs(state, S_AAPX)
}

fn paint_reset(state: u64) {
    ss(state, S_SHADOWPX, 0)
    ss(state, S_AAPX, 0)
}

fn shadow_builds(state: u64) -> u64 {
    return gs(state, S_SHBUILD)
}

// DIE GEGENPROBE ZU DIESER RUNDE, und sie ist der einzige Grund, warum
// `ring_round` und der alte Schattenweg stehenbleiben duerfen.
//
// Ein "vorher/nachher" aus ZWEI Laeufen ist zwei Maschinen: anderer
// Wirt, andere Last, anderer Zeitgeber. Mit diesem Schalter laufen
// beide Fassungen in EINEM Bild nacheinander, auf demselben Fenster
// und mit demselben Zaehler -- und der Unterschied ist dann wirklich
// der Unterschied.
fn set_shadow_old(state: u64, on: bool) {
    if on {
        ss(state, S_SHOLD, 1)
    } else {
        ss(state, S_SHOLD, 0)
    }
}

fn cap_hover(state: u64) -> u64 {
    return gs(state, S_CAPHOV)
}

fn cap_hits(state: u64) -> u64 {
    return gs(state, S_CAPHITS)
}

// DIE DECKUNG EINES ECKPUNKTES, sechzehnfach abgetastet.
//
// DIESELBE RECHNUNG WIE `wlibc.corner_cov` IN RING 3, und das ist keine
// Bequemlichkeit: die Widget-Bibliothek malt die runde Ecke eines
// Knopfes, der Server die runde Ecke des Fensters, und wenn die beiden
// verschieden runden, sieht man in einem Dialog zwei verschiedene
// Kruemmungen nebeneinander. `tools/paint/corners.py` haelt beide
// Fassungen Bildpunkt fuer Bildpunkt gegeneinander.
//
// (dx, dy) ist der Abstand der OBEREN LINKEN Ecke des Bildpunktes vom
// Mittelpunkt des Eckkreises, in ganzen Bildpunkten. Zwei billige
// Abkuerzungen tragen die grosse Mehrheit der Punkte: liegt die FERNE
// Ecke des Bildpunktes noch im Kreis, ist er ganz drin; liegt die NAHE
// schon draussen, ist er ganz draussen. Nur der schmale Ring dazwischen
// wird wirklich abgetastet, und nur der zaehlt in `aa_px`.
fn corner_cov(state: u64, dx: u64, dy: u64, r: u64) -> u64 {
    if r == 0 {
        return 255
    }
    let rr: u64 = r *% r
    if (dx + 1) * (dx + 1) + (dy + 1) * (dy + 1) <= rr {
        return 255
    }
    if dx * dx + dy * dy >= rr {
        return 0
    }
    var hits: u64 = 0
    var sy: u64 = 0
    while sy < 4 {
        var sx: u64 = 0
        while sx < 4 {
            let px8: u64 = dx *% 8 +% sx *% 2 +% 1
            let py8: u64 = dy *% 8 +% sy *% 2 +% 1
            if px8 *% px8 +% py8 *% py8 <= (r *% 8) *% (r *% 8) {
                hits = hits + 1
            }
            sx = sx + 1
        }
        sy = sy + 1
    }
    ss(state, S_AAPX, gs(state, S_AAPX) + 1)
    return hits * 255 / 16
}

// Ein Rechteck, auf den schmutzigen Bereich beschnitten. Der Beschnitt
// steht EINMAL hier und nicht sechsmal in `paint_win`.
fn fill_clip(state: u64, x: i64, y: i64, w: i64, h: i64, farbe: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    let ax0: i64 = imax(x, cx0)
    let ay0: i64 = imax(y, cy0)
    let ax1: i64 = imin(x + w, cx1)
    let ay1: i64 = imin(y + h, cy1)
    if ax1 <= ax0 || ay1 <= ay0 || ax1 <= 0 || ay1 <= 0 {
        return
    }
    fb.fill(state, imax(ax0, 0) as u64, imax(ay0, 0) as u64,
        (ax1 - imax(ax0, 0)) as u64, (ay1 - imax(ay0, 0)) as u64, farbe)
}

// Ein GEMISCHTER Bildpunkt, beschnitten. `a == 0` und `a == 255` gehen
// durch `fb.pixel_a`, das beide Abkuerzungen selbst kennt.
fn px_clip(state: u64, x: i64, y: i64, farbe: u64, a: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if x < cx0 || y < cy0 || x >= cx1 || y >= cy1 || x < 0 || y < 0 {
        return
    }
    fb.pixel_a(state, x as u64, y as u64, farbe, a)
}

// EINE GEFUELLTE FLAECHE MIT RUNDEN ECKEN, direkt in den Bildpuffer.
//
// r == 0 ist Aufruf fuer Aufruf das alte `fill_clip`, und das ist keine
// Optimierung, sondern die Zusage: auf `shape=classic` malt dieser
// Server BILDPUNKTGENAU dasselbe wie vor der Runde.
//
// Warum die Ecken GEMISCHT und nicht ausgespart werden: was unter der
// Ecke liegt, steht zu diesem Zeitpunkt schon im Bildpuffer -- der
// Schreibtisch und alle tieferen Fenster sind gemalt. Genau das ist
// der Grund, warum das hier geht und in Ring 3 nicht: die Bibliothek
// malt in IHREN Puffer und weiss nicht, was darunter liegt.
fn fill_round(state: u64, x: i64, y: i64, w: i64, h: i64, r0: u64,
    farbe: u64, cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if w <= 0 || h <= 0 {
        return
    }
    var r: u64 = r0
    if r * 2 > w as u64 {
        r = (w / 2) as u64
    }
    if r * 2 > h as u64 {
        r = (h / 2) as u64
    }
    if r == 0 {
        fill_clip(state, x, y, w, h, farbe, cx0, cy0, cx1, cy1)
        return
    }
    let ri: i64 = r as i64
    fill_clip(state, x, y + ri, w, h - 2 * ri, farbe, cx0, cy0, cx1, cy1)
    fill_clip(state, x + ri, y, w - 2 * ri, ri, farbe, cx0, cy0, cx1, cy1)
    fill_clip(state, x + ri, y + h - ri, w - 2 * ri, ri, farbe,
        cx0, cy0, cx1, cy1)
    var dy: u64 = 0
    while dy < r {
        var dx: u64 = 0
        while dx < r {
            let cov: u64 = corner_cov(state, r - 1 - dx, r - 1 - dy, r)
            if cov != 0 {
                let x0: i64 = x + dx as i64
                let y0: i64 = y + dy as i64
                let x1: i64 = x + w - 1 - dx as i64
                let y1: i64 = y + h - 1 - dy as i64
                px_clip(state, x0, y0, farbe, cov, cx0, cy0, cx1, cy1)
                px_clip(state, x1, y0, farbe, cov, cx0, cy0, cx1, cy1)
                px_clip(state, x0, y1, farbe, cov, cx0, cy0, cx1, cy1)
                px_clip(state, x1, y1, farbe, cov, cx0, cy0, cx1, cy1)
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

// EIN UMRISS VON EINEM BILDPUNKT, rund, gemischt -- der Baustein des
// Schattens. Vier gerade Stuecke und vier Boegen; ein Bildpunkt gehoert
// zum Bogen, wenn er im aeusseren Kreis liegt und im inneren nicht.
fn ring_round(state: u64, x: i64, y: i64, w: i64, h: i64, r0: u64,
    farbe: u64, a: u64, cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if w <= 1 || h <= 1 || a == 0 {
        return
    }
    var r: u64 = r0
    if r * 2 > w as u64 {
        r = (w / 2) as u64
    }
    if r * 2 > h as u64 {
        r = (h / 2) as u64
    }
    let ri: i64 = r as i64
    hline_a_clip(state, x + ri, y, w - 2 * ri, farbe, a, cx0, cy0, cx1, cy1)
    hline_a_clip(state, x + ri, y + h - 1, w - 2 * ri, farbe, a,
        cx0, cy0, cx1, cy1)
    // RUNDE SOFTUI: GEZAEHLT WIRD JETZT JEDER BILDPUNKT. Vorher zaehlte
    // `S_SHADOWPX` nur die waagerechten Laeufe -- die Spalten und die
    // vier Boegen liefen ueber `px_clip` und blieben unsichtbar. Ein
    // Zaehler, der die Haelfte auslaesst, macht die neue Fassung
    // scheinbar teurer als die alte.
    var k: i64 = y + ri
    while k < y + h - ri {
        shadow_px1(state, x, k, farbe, a, cx0, cy0, cx1, cy1)
        shadow_px1(state, x + w - 1, k, farbe, a, cx0, cy0, cx1, cy1)
        k = k + 1
    }
    if r == 0 {
        return
    }
    var innen: u64 = 0
    if r > 1 {
        innen = r - 1
    }
    var dy: u64 = 0
    while dy < r {
        var dx: u64 = 0
        while dx < r {
            let aussen: u64 = corner_cov(state, r - 1 - dx, r - 1 - dy, r)
            var i2: u64 = 0
            if innen > 0 {
                i2 = corner_cov(state, r - 1 - dx, r - 1 - dy, innen)
            }
            var cov: u64 = 0
            if aussen > i2 {
                cov = aussen - i2
            }
            if cov != 0 {
                let d: u64 = cov * a / 255
                let x0: i64 = x + dx as i64
                let y0: i64 = y + dy as i64
                let x1: i64 = x + w - 1 - dx as i64
                let y1: i64 = y + h - 1 - dy as i64
                shadow_px1(state, x0, y0, farbe, d, cx0, cy0, cx1, cy1)
                shadow_px1(state, x1, y0, farbe, d, cx0, cy0, cx1, cy1)
                shadow_px1(state, x0, y1, farbe, d, cx0, cy0, cx1, cy1)
                shadow_px1(state, x1, y1, farbe, d, cx0, cy0, cx1, cy1)
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

fn hline_a_clip(state: u64, x: i64, y: i64, n: i64, farbe: u64, a: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if y < cy0 || y >= cy1 || y < 0 || n <= 0 {
        return
    }
    let x0: i64 = imax(imax(x, cx0), 0)
    let x1: i64 = imin(x + n, cx1)
    if x1 <= x0 {
        return
    }
    fb.hline_a(state, x0 as u64, y as u64, (x1 - x0) as u64, farbe, a)
    ss(state, S_SHADOWPX, gs(state, S_SHADOWPX) + (x1 - x0) as u64)
}

// =====================================================================
// DER FENSTERSCHATTEN -- und warum er hier moeglich ist und in Ring 3
// nicht.
// =====================================================================
//
// docs/ROUNDLOOK.md schrieb, ein weicher Schatten sei nicht gemalt,
// weil "the compositor cannot read what is under a window". Das war
// eine Aussage ueber die WIDGET-BIBLIOTHEK und stimmte dort: sie malt
// in den Puffer IHRES Fensters und sieht nichts darunter.
//
// Fuer den Server stimmt sie nicht, und zwar seit Runde K10: JEDES
// FENSTER HAT SEINEN EIGENEN PUFFER (`W_BUF`, in `create` aus dem
// Rahmenverwalter geholt), und `compose` setzt von unten nach oben
// zusammen -- erst der Schreibtischgrund, dann Fenster fuer Fenster.
// Wenn `paint_win` fuer Fenster i laeuft, steht ALLES, was unter i
// liegt, bereits fertig im Bildpuffer. Der Untergrund ist da; es hat
// ihn nur nie jemand gelesen.
//
// Damit ist der Schatten kein Umbau, sondern ein Aufruf an der
// richtigen Stelle: VOR dem Rahmen von i, NACH allem unter i.
//
// WIE ER GEMALT WIRD. Keine Faltung -- eine Gaussche Unschaerfe
// braeuchte einen zweiten Puffer in Bildschirmgroesse und zwei
// Durchlaeufe darueber. Statt dessen `reach` geschachtelte Umrisse,
// jeder einen Bildpunkt weiter aussen und jeder schwaecher als der
// vorige: ein linearer Abfall. Bei den vier bis sechs Bildpunkten, die
// ein Fensterschatten wirklich benutzt, ist der Unterschied zur
// Gausskurve nicht zu sehen, und der Preis ist `reach` Umrisse statt
// einer Faltung -- also der UMFANG mal `reach` und nicht die FLAECHE.
// Fuer ein Fenster von 796x576 und reach 6 sind das rund 17 000
// gemischte Bildpunkte statt 458 000.
//
// UND ER SITZT TIEFER ALS DAS FENSTER. Ein Bildpunkt Versatz nach unten
// je Ring; das ist es, was das Ding als "darueber" und nicht als
// "leuchtend" lesbar macht.
fn paint_shadow(state: u64, i: u64, cx0: i64, cy0: i64, cx1: i64,
    cy1: i64) {
    // RUNDE SOFTUI: WELCHE BANK. Das Fenster mit dem Fokus steht
    // hoeher; die anderen liegen flacher auf dem Schreibtisch.
    var staerke: u64 = form(state, FM_SHADOW2)
    var reach: u64 = form(state, FM_SHADOW_R2)
    var bank: u64 = 1
    if focus(state) == i {
        staerke = form(state, FM_SHADOW)
        reach = form(state, FM_SHADOW_R)
        bank = 0
    }
    if staerke == 0 || reach == 0 {
        return
    }
    let farbe: u64 = rgb24(state, form(state, FM_SHADOW_C))
    let r: u64 = form(state, FM_RADIUS)
    let wx: i64 = win_x(state, i)
    let wy: i64 = win_y(state, i)
    let ow: i64 = outer_w(state, i) as i64
    let oh: i64 = outer_h(state, i) as i64
    if gs(state, S_SHOLD) != 0 {
        shadow_rings(state, wx, wy, ow, oh, r, staerke, reach, farbe,
            cx0, cy0, cx1, cy1)
        return
    }
    shadow_mask(state, wx, wy, ow, oh, r, reach, bank, farbe,
        cx0, cy0, cx1, cy1)
}

// ---------------------------------------------------- DER ALTE WEG
//
// `reach` geschachtelte Umrisse, jeder einen Bildpunkt weiter aussen
// und jeder schwaecher. Er steht als GEGENPROBE hier und nicht als
// Erbstueck: `set_shadow_old` schaltet ihn an, und dann muss dasselbe
// Bild herauskommen wie mit der Maske. Kaeme etwas anderes heraus,
// waere die Maske falsch und niemand haette es gemerkt.
fn shadow_rings(state: u64, wx: i64, wy: i64, ow: i64, oh: i64, r: u64,
    staerke: u64, reach: u64, farbe: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    var k: u64 = reach
    while k > 0 {
        let a: u64 = staerke * 255 / 100 * (reach + 1 - k) / (reach + 1)
        if a != 0 {
            ring_round(state, wx - k as i64, wy - k as i64 + 1,
                ow + 2 * k as i64, oh + 2 * k as i64, r + k, farbe, a,
                cx0, cy0, cx1, cy1)
        }
        k = k - 1
    }
}

// =====================================================================
// DIE VORBERECHNETE SCHATTENMASKE -- der Kern dieser Runde.
// =====================================================================
//
// WAS AM ALTEN WEG TEUER WAR, und es waren nicht die Bildpunkte.
//
// `ring_round` tastet jede Ecke jedes Rings neu ab: fuer jeden der
// (r+k)^2 Punkte eines Eckquadrats ZWEI Aufrufe von `corner_cov`, und
// jeder davon bis zu sechzehn Unterproben. Bei r=10 und reach=6 sind
// das je Fenster 4 * sum_{k=1..6}(10+k)^2 = 4444 Eckpunkte mal zwei
// Abtastungen -- BEI JEDEM BILD, obwohl sich an der Ecke zwischen zwei
// Bildern nichts aendert. Ein Schatten ist eine Funktion der FORM und
// nicht der Zeit.
//
// ALSO EINMAL RECHNEN. Der Schatten ist punktsymmetrisch in seinen vier
// Ecken und in seinen vier geraden Stuecken konstant je Abstand. Damit
// zerfaellt er in genau zwei Tafeln:
//
//   * EIN Eckquadrat mit S = r + reach Kanten laenge, das viermal
//     gespiegelt gemalt wird,
//   * EIN Streifen von `reach` Deckungswerten fuer oben, unten, links
//     und rechts.
//
// Das ist die Neun-Felder-Zerlegung, die jedes Fenstersystem fuer
// Rahmenbilder benutzt, nur mit Deckung statt Farbe. Sie haengt NICHT
// an der Fenstergroesse: eine Maske bedient jedes Fenster auf dem
// Schirm.
//
// UND SIE LIEST DEN UNTERGRUND NICHT. Das ist die Auflage dieser Runde
// und zugleich der Grund, warum das hier ueberhaupt geht: in der Maske
// steht Deckung, keine Farbe. Was darunter liegt, kommt erst beim
// Mischen dazu -- `fb.pixel_a` liest genau den einen Bildpunkt, den es
// gerade schreibt, und niemals eine Flaeche. Ein Backdrop-Readback
// waere das Gegenteil: erst den ganzen Bereich lesen, dann rechnen.
//
// WAS DIE MASKE GENAUER MACHT ALS DIE RINGE. Die Ringe liegen auf
// ganzen Bildpunkten; ihre Boegen ueberlappen sich an den Diagonalen
// und lassen an den Achsen Luecken. Die Maske rechnet den ECHTEN
// Abstand zum Fensterrand in Sechzehnteln eines Bildpunktes und liest
// den Abfall an dieser Stelle ab. An ganzzahligen Abstaenden kommt
// dasselbe heraus wie vorher -- die Rampe ist dieselbe Formel --,
// dazwischen etwas Besseres.
fn shadow_key(state: u64) -> u64 {
    let r: u64 = form(state, FM_RADIUS)
    let a1: u64 = form(state, FM_SHADOW)
    let r1: u64 = form(state, FM_SHADOW_R)
    let a2: u64 = form(state, FM_SHADOW2)
    let r2: u64 = form(state, FM_SHADOW_R2)
    // Ein Schluessel und kein Zeitstempel: baut die Maske nur neu, wenn
    // sich wirklich eine der fuenf Zahlen geaendert hat. + 1, damit
    // "alles null" nicht wie "nie gebaut" aussieht.
    return ((((r * 17 + r1) * 17 + r2) * 101 + a1) * 101 + a2) + 1
}

// Die ganzzahlige Quadratwurzel, Newton. Sie laeuft NUR beim Bau der
// Maske -- also 1600 mal je Formwechsel und kein einziges Mal beim
// Malen eines Bildes.
fn isqrt(n: u64) -> u64 {
    if n < 2 {
        return n
    }
    var x: u64 = n
    var y: u64 = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

// Der Abfall an einem Abstand `d16` (in Sechzehnteln eines Bildpunktes)
// vom Fensterrand. Bei d16 = 16*k steht hier auf das Oktett genau die
// Zahl, die der alte Ring k bekommen hat.
fn shadow_ramp(staerke: u64, reach: u64, d16: u64) -> u64 {
    let full: u64 = reach * 16 + 16
    if d16 == 0 || d16 >= full {
        return 0
    }
    return staerke * 255 / 100 * (full - d16) / full
}

fn shadow_build(state: u64) {
    let r: u64 = form(state, FM_RADIUS)
    let a1: u64 = form(state, FM_SHADOW)
    let r1: u64 = form(state, FM_SHADOW_R)
    let a2: u64 = form(state, FM_SHADOW2)
    let r2: u64 = form(state, FM_SHADOW_R2)
    var rmax: u64 = r1
    if r2 > rmax {
        rmax = r2
    }
    var side: u64 = r + rmax
    if side > SHMASK_SIDE {
        side = SHMASK_SIDE
    }
    ss(state, S_SHS, side)
    let base: u64 = state + kstate.WM_OFF + S_SHMASK
    let ebase: u64 = state + kstate.WM_OFF + S_SHEDGE
    // die beiden Streifen der geraden Stuecke
    var k: u64 = 0
    while k < SHADOW_MAX {
        var v1: u64 = 0
        var v2: u64 = 0
        if k < r1 {
            v1 = shadow_ramp(a1, r1, (k + 1) * 16)
        }
        if k < r2 {
            v2 = shadow_ramp(a2, r2, (k + 1) * 16)
        }
        kstate.set8(ebase + k, v1 as u8)
        kstate.set8(ebase + SHADOW_MAX + k, v2 as u8)
        k = k + 1
    }
    // das Eckquadrat, einmal fuer beide Baenke
    let bank: u64 = SHMASK_SIDE * SHMASK_SIDE
    var j: u64 = 0
    while j < side {
        var ii: u64 = 0
        while ii < side {
            let dx: u64 = side - ii
            let dy: u64 = side - j
            // 16 * sqrt(dx^2 + dy^2), also der Abstand vom Mittelpunkt
            // des Eckkreises in Sechzehnteln.
            let dist16: u64 = isqrt((dx * dx + dy * dy) * 256)
            var d16: u64 = 0
            if dist16 > r * 16 {
                d16 = dist16 - r * 16
            }
            let o: u64 = j * SHMASK_SIDE + ii
            kstate.set8(base + o, shadow_ramp(a1, r1, d16) as u8)
            kstate.set8(base + bank + o, shadow_ramp(a2, r2, d16) as u8)
            ii = ii + 1
        }
        j = j + 1
    }
    ss(state, S_SHKEY, shadow_key(state))
    ss(state, S_SHBUILD, gs(state, S_SHBUILD) + 1)
}

// Ein Bildpunkt aus der Maske, gemischt und gezaehlt.
fn shadow_px1(state: u64, x: i64, y: i64, farbe: u64, a: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if a == 0 {
        return
    }
    if x < cx0 || y < cy0 || x >= cx1 || y >= cy1 || x < 0 || y < 0 {
        return
    }
    fb.pixel_a(state, x as u64, y as u64, farbe, a)
    ss(state, S_SHADOWPX, gs(state, S_SHADOWPX) + 1)
}

// Ein Lauf aus der Deckungstafel, beschnitten. Die Beschneidung
// passiert HIER und einmal je Lauf -- `fb.hline_mask` prueft nur noch
// den Bildschirmrand.
fn mask_run(state: u64, x: i64, y: i64, n: i64, farbe: u64, m0: u64,
    schritt: i64, cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if n <= 0 || y < cy0 || y >= cy1 || y < 0 {
        return
    }
    var a: i64 = x
    var m: u64 = m0
    var len: i64 = n
    if a < cx0 {
        let weg: i64 = cx0 - a
        if weg >= len {
            return
        }
        a = cx0
        len = len - weg
        if schritt < 0 {
            m = m -% weg as u64
        } else {
            m = m +% weg as u64
        }
    }
    if a + len > cx1 {
        len = cx1 - a
    }
    if len <= 0 || a < 0 {
        return
    }
    fb.hline_mask(state, a as u64, y as u64, len as u64, farbe, m, schritt)
    ss(state, S_SHADOWPX, gs(state, S_SHADOWPX) + len as u64)
}

// Ein Lauf mit EINER Deckung, beschnitten -- die gerade Kante.
fn edge_run(state: u64, x: i64, y: i64, n: i64, farbe: u64, a: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if a == 0 {
        return
    }
    hline_a_clip(state, x, y, n, farbe, a, cx0, cy0, cx1, cy1)
}

// =====================================================================
// DER SCHATTEN, ZEILE FUER ZEILE
// =====================================================================
//
// DIE ERSTE FASSUNG DIESER RUNDE WAR SPALTENWEISE UND DAS WAR DER
// FEHLER. Sie hat die Ecktafel Punkt fuer Punkt ueber `fb.pixel_a`
// abgearbeitet, und gemessen kostete der Schatten damit 1143 us je Bild
// gegen 1268 us mit den alten Ringen -- elf Hundertstel besser, wo
// vier- bis fuenffach zu erwarten war. Die Abtastung war weg, die
// Buchhaltung nicht: sechs Zustandszugriffe je Bildpunkt.
//
// Also nicht "welcher Bildpunkt der Tafel gehoert wohin", sondern
// "welche LAEUFE hat diese Bildzeile". Die Neun-Felder-Zerlegung
// beantwortet das ohne eine einzige Bedingung je Bildpunkt:
//
//   Zeilen ueber dem Fenster   zwei Ecklaeufe + ein gerader Lauf
//   Zeilen an der Fensterecke  zwei Ecklaeufe
//   Zeilen in der Mitte        zwei Randlaeufe aus dem Streifen
//   Zeilen unter dem Fenster   spiegelbildlich zu oben
//
// Die beiden RECHTEN Laeufe lesen dieselbe Tafelzeile RUECKWAERTS
// (`schritt = -1`), die beiden UNTEREN dieselbe Tafel von unten. Eine
// Tafel, vier Ecken, kein Spiegeln zur Laufzeit.
fn shadow_mask(state: u64, wx: i64, wy: i64, ow: i64, oh: i64, r: u64,
    reach: u64, bank: u64, farbe: u64,
    cx0: i64, cy0: i64, cx1: i64, cy1: i64) {
    if gs(state, S_SHKEY) != shadow_key(state) {
        shadow_build(state)
    }
    let side: u64 = gs(state, S_SHS)
    if side == 0 || reach == 0 {
        return
    }
    let base: u64 = state + kstate.WM_OFF + S_SHMASK
        + bank * SHMASK_SIDE * SHMASK_SIDE
    let ebase: u64 = state + kstate.WM_OFF + S_SHEDGE + bank * SHADOW_MAX
    // EIN BILDPUNKT TIEFER. Derselbe Versatz wie beim alten Weg: der
    // Schatten sitzt unter dem Fenster und nicht um es herum.
    let sy: i64 = wy + 1
    let si: i64 = side as i64
    let ri: i64 = r as i64
    let rc: i64 = reach as i64
    // x der vier Ecklaeufe
    let lx: i64 = wx - rc // linke Tafel, vorwaerts
    let rx: i64 = wx + ow - ri // rechte Tafel, rueckwaerts
    let mx: i64 = wx + ri // der gerade Teil dazwischen
    let mw: i64 = ow - 2 * ri
    let my: i64 = sy + ri // erste Zeile des geraden Mittelteils
    let mh: i64 = oh - 2 * ri
    // -------------------------------------------- oben, side Zeilen
    var j: i64 = 0
    while j < si {
        let y: i64 = sy - si + j
        let m: u64 = base + (j * SHMASK_SIDE as i64) as u64
        mask_run(state, lx, y, si, farbe, m, 1, cx0, cy0, cx1, cy1)
        mask_run(state, rx, y, si, farbe, m + (side - 1), -1,
            cx0, cy0, cx1, cy1)
        // Der gerade Teil oben gibt es nur, solange die Zeile noch
        // UEBER dem Fenster liegt.
        if j < rc && mw > 0 {
            let a: u64 = kstate.get8(ebase + (rc - 1 - j) as u64)
            edge_run(state, mx, y, mw, farbe, a, cx0, cy0, cx1, cy1)
        }
        j = j + 1
    }
    // ------------------------------------------- unten, side Zeilen
    j = 0
    while j < si {
        let y: i64 = sy + oh + si - 1 - j
        let m: u64 = base + (j * SHMASK_SIDE as i64) as u64
        mask_run(state, lx, y, si, farbe, m, 1, cx0, cy0, cx1, cy1)
        mask_run(state, rx, y, si, farbe, m + (side - 1), -1,
            cx0, cy0, cx1, cy1)
        if j < rc && mw > 0 {
            let a: u64 = kstate.get8(ebase + (rc - 1 - j) as u64)
            edge_run(state, mx, y, mw, farbe, a, cx0, cy0, cx1, cy1)
        }
        j = j + 1
    }
    // ------------------------------------------------ die Mitte
    //
    // Links laeuft der Streifen von aussen nach innen, rechts von innen
    // nach aussen -- also dieselben `reach` Oktette, einmal vorwaerts
    // und einmal rueckwaerts. Auch hier: EIN Streifen, zwei Seiten.
    if mh > 0 && rc > 0 {
        var q: i64 = 0
        while q < mh {
            let y: i64 = my + q
            mask_run(state, wx - rc, y, rc, farbe, ebase + (reach - 1), -1,
                cx0, cy0, cx1, cy1)
            mask_run(state, wx + ow, y, rc, farbe, ebase, 1,
                cx0, cy0, cx1, cy1)
            q = q + 1
        }
    }
}

fn deco_writes(state: u64) -> u64 {
    return gs(state, S_DECON)
}

// DIE FENSTERTAFEL LIEGT SEIT DER RUNDE DESKTOP IN `kstate.DSK_OFF`
// UND NICHT MEHR IN `WM_OFF`. Die Skalare stehen weiter in WM_OFF; das
// ist die einzige Stelle, an der die beiden Bereiche auseinanderfallen,
// und sie steht deshalb hier in einer einzigen Funktion.
fn wat(i: u64) -> u64 {
    return kstate.DSK_OFF + W_OFF + i * WIN_BYTES
}

fn wg(state: u64, i: u64, off: u64) -> u64 {
    return kstate.get(state, wat(i) + off)
}

fn wsv(state: u64, i: u64, off: u64, v: u64) {
    kstate.set(state, wat(i) + off, v)
}

fn ready(state: u64) -> bool {
    return gs(state, S_READY) != 0
}

fn valid(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return wg(state, i, W_USED) != 0
}

fn count(state: u64) -> u64 {
    return gs(state, S_COUNT)
}

fn focus(state: u64) -> u64 {
    let f: u64 = gs(state, S_FOCUS)
    if f == 0 {
        return MAX_WIN
    }
    return f - 1
}

fn composites(state: u64) -> u64 {
    return gs(state, S_COMPOSITES)
}

// RUNDE MESSTAFEL -- die fuenf Stufen, von aussen lesbar.
fn evpush(state: u64) -> u64 {
    return gs(state, S_EVPUSH)
}

fn evpop(state: u64) -> u64 {
    return gs(state, S_EVPOP)
}

fn keyin(state: u64) -> u64 {
    return gs(state, S_KEYIN)
}

// WO DER ZEIGER LAUT FENSTERSERVER STEHT. Nicht `ps2m.x` -- das ist
// die Stelle, die der Treiber fuehrt. Wenn die beiden auseinander
// laufen, holt der Server nicht ab, und genau das soll man sehen.
fn curx(state: u64) -> u64 {
    return gs(state, S_CURX)
}

fn cury(state: u64) -> u64 {
    return gs(state, S_CURY)
}

fn evdrops(state: u64) -> u64 {
    return gs(state, S_EVDROP)
}

// RUNDE BLECH2: zusammengefasste Bewegungen und Ereignisse an das
// abholerlose Terminal des Kerns -- beides KEIN Verlust, beides eine
// Zahl auf Tafelzeile 4 bzw. in `wm: fen`.
fn evkoal(state: u64) -> u64 {
    return gs(state, S_EVKOAL)
}

fn evterm(state: u64) -> u64 {
    return gs(state, S_EVTERM)
}

fn win_paints(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return wg(state, i, W_PAINTS)
}

fn win_px(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return wg(state, i, W_PX)
}

fn win_flags(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return wg(state, i, W_FLAGS)
}

// ==================================================== RUNDE LEISTE
// DIESE FUNKTION HAT EINE RUNDE LANG DAS FALSCHE FENSTER GEMESSEN.
//
// Der Satz darunter -- "dorthin legt `taskbar.fi` sich, und sonst
// nichts" -- stimmte, als er geschrieben wurde. Seit der Runde
// STARTKNOPF legt sich das STARTMENUE (`launcher.fi`, `window_plain`)
// ebenfalls auf `L_TOP`, und weil es SPAETER kommt, liegt es weiter
// oben im Stapel: `top_layer_win` liefert seitdem den Starter.
//
// Damit hat Tafelzeile 7 die ganze letzte Runde die Anstriche und den
// Aufgabenzustand des STARTMENUES gezeigt und "die Leiste lebt"
// gemeldet, waehrend die Leiste stand. Eine Messung, die auf das
// falsche Ding zeigt, ist schlimmer als keine.
//
// `panel_win` fragt deshalb nach dem, was eine Taskleiste WIRKLICH
// ausmacht und was ein Menue nie tut: sie reserviert eine Kante des
// Schirms (`W_STRUT != 0`). Das ist dieselbe Regel, nach der
// `sysgui.fi` entscheidet, wer eine Leiste sein darf.
fn panel_win(state: u64) -> u64 {
    var z: u64 = gs(state, S_COUNT)
    while z > 0 {
        z = z - 1
        let i: u64 = at_z(state, z)
        if i < MAX_WIN && wg(state, i, W_USED) != 0 {
            if wg(state, i, W_LAYER) == L_TOP && wg(state, i, W_STRUT) != 0 {
                return i
            }
        }
    }
    // Keine Leiste mit Kante: dann taugt die alte Antwort immer noch
    // besser als gar keine -- aber der Rufende sieht am fehlenden
    // Strut, dass es die Leiste nicht ist.
    return MAX_WIN
}

// DAS FENSTER DER TASKLEISTE, ohne dass der Kern die Leiste kennen muss:
// das oberste benutzte Fenster auf der Ebene L_TOP. Genau dorthin legt
// `taskbar.fi` sich (`WS_LAYER = L_TOP`), und sonst nichts.
// RUNDE LEISTE: NICHT MEHR FUER DIE LEISTE BENUTZEN -- dafuer gibt es
// `panel_win`. Diese hier liefert das oberste Fenster der obersten
// Ebene, was seit dem Startmenue etwas anderes ist.
fn top_layer_win(state: u64) -> u64 {
    var z: u64 = gs(state, S_COUNT)
    while z > 0 {
        z = z - 1
        let i: u64 = at_z(state, z)
        if i < MAX_WIN && wg(state, i, W_USED) != 0 {
            if wg(state, i, W_LAYER) == L_TOP {
                return i
            }
        }
    }
    return MAX_WIN
}

// ================== RUNDE MESSTAFEL: DIE FENSTERLISTE AUF DIE LEITUNG
//
// Eine Zeile je Fenster, mit ALLEM, was zwischen "angelegt" und
// "sichtbar" schiefgehen kann: Kennung, Lage, Groesse, Ebene, die
// Merkerbits, der Platz in der Stapelfolge -- und die beiden neuen
// Zaehler. Wer diese Liste hat, muss ueber die Taskleiste nicht mehr
// raten.
fn wins_say(state: u64) {
    if !ready(state) {
        return
    }
    var s_h: [u8; 11] = "wm: fen i=\0"
    var s_id: [u8; 5] = " id=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var s_l: [u8; 6] = " lay=\0"
    var s_f: [u8; 5] = " fl=\0"
    var s_z: [u8; 4] = " z=\0"
    var s_p: [u8; 8] = " malen=\0"
    var s_px: [u8; 5] = " px=\0"
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 {
            serial.puts((&s_h[0]) as u64)
            serial.dec(i)
            serial.puts((&s_id[0]) as u64)
            serial.dec(wg(state, i, W_ID))
            serial.puts((&s_x[0]) as u64)
            serial.dec(win_x(state, i) as u64)
            serial.puts((&s_y[0]) as u64)
            serial.dec(win_y(state, i) as u64)
            serial.puts((&s_w[0]) as u64)
            serial.dec(wg(state, i, W_W))
            serial.puts((&s_hh[0]) as u64)
            serial.dec(wg(state, i, W_H))
            serial.puts((&s_l[0]) as u64)
            serial.dec(wg(state, i, W_LAYER))
            serial.puts((&s_f[0]) as u64)
            serial.dec(wg(state, i, W_FLAGS))
            serial.puts((&s_z[0]) as u64)
            serial.dec(wg(state, i, W_Z))
            serial.puts((&s_p[0]) as u64)
            serial.dec(wg(state, i, W_PAINTS))
            serial.puts((&s_px[0]) as u64)
            serial.dec(wg(state, i, W_PX))
            // ============================================== RUNDE BLECH2
            // WO DER TITEL STEHT, damit ein Laeufer ihn im Bild
            // bildpunktgenau nachrechnen kann (tools/metal2/run.sh mit
            // `checkshot.py tkette`): Anfang, Grundlinie, Schriftgroesse,
            // Schrift- und Leistenfarbe -- und `tka`, die alte
            // TK-Zaehlweise, zum Vergleich mit dem Bild.
            if deko(state, i) {
                var s_tx: [u8; 5] = " tx=\0"
                var s_tb: [u8; 5] = " tb=\0"
                var s_tp: [u8; 5] = " tp=\0"
                var s_tf: [u8; 5] = " tf=\0"
                var s_tg: [u8; 5] = " tg=\0"
                var s_tk: [u8; 6] = " tka=\0"
                let f: u64 = gs(state, S_FONT_UI)
                let px: u64 = gs(state, S_PX_UI)
                var before: i64 = 0
                let sicht: u64 = netview.view_of(state, win_owner(state, i))
                if sicht != netview.V_REAL && sicht <= 3 {
                    before = netmark.W as i64 + 4
                }
                var tf: u64 = deco_rgb(state, DK_TEXT)
                var tg: u64 = deco_rgb(state, DK_TITLE)
                if focus(state) == i {
                    tf = deco_rgb(state, DK_TEXT_ON)
                    tg = deco_rgb(state, DK_TITLE_ON)
                }
                var tb: i64 = win_y(state, i) + border(state) as i64
                if f < ttf.MAX_FONTS {
                    tb = tb + ttf.ascent(state, f, px)
                }
                serial.puts((&s_tx[0]) as u64)
                serial.dec((win_x(state, i) + border(state) as i64 + title_pad(state) as i64 + before) as u64)
                serial.puts((&s_tb[0]) as u64)
                serial.dec(tb as u64)
                serial.puts((&s_tp[0]) as u64)
                serial.dec(px)
                serial.puts((&s_tf[0]) as u64)
                serial.hex(tf)
                serial.puts((&s_tg[0]) as u64)
                serial.hex(tg)
                serial.puts((&s_tk[0]) as u64)
                serial.dec(titel_schnitt_alt)
            }
            serial.nl()
        }
        i = i + 1
    }
}

fn blits(state: u64) -> u64 {
    return gs(state, S_BLITS)
}

fn pixels(state: u64) -> u64 {
    return gs(state, S_PIXELS)
}

fn last_us(state: u64) -> u64 {
    return gs(state, S_LASTUS)
}

fn cursor_on(state: u64) -> bool {
    return gs(state, S_CURON) != 0
}

fn set_cursor(state: u64, on: bool) {
    if on {
        ss(state, S_CURON, 1)
    } else {
        ss(state, S_CURON, 0)
    }
}

fn font_ui(state: u64) -> u64 {
    return gs(state, S_FONT_UI)
}

fn font_mono(state: u64) -> u64 {
    return gs(state, S_FONT_MONO)
}

fn px_ui(state: u64) -> u64 {
    return gs(state, S_PX_UI)
}

fn px_mono(state: u64) -> u64 {
    return gs(state, S_PX_MONO)
}

fn set_fonts(state: u64, ui: u64, pui: u64, mono: u64, pmono: u64) {
    ss(state, S_FONT_UI, ui)
    ss(state, S_PX_UI, pui)
    ss(state, S_FONT_MONO, mono)
    ss(state, S_PX_MONO, pmono)
}

fn win_x(state: u64, i: u64) -> i64 {
    return wg(state, i, W_X) as i64
}

fn win_y(state: u64, i: u64) -> i64 {
    return wg(state, i, W_Y) as i64
}

fn win_w(state: u64, i: u64) -> u64 {
    return wg(state, i, W_W)
}

fn win_h(state: u64, i: u64) -> u64 {
    return wg(state, i, W_H)
}

fn win_z(state: u64, i: u64) -> u64 {
    return wg(state, i, W_Z)
}

fn win_buf(state: u64, i: u64) -> u64 {
    return wg(state, i, W_BUF)
}

fn win_owner(state: u64, i: u64) -> u64 {
    return wg(state, i, W_OWNER)
}

fn win_kind(state: u64, i: u64) -> u64 {
    return wg(state, i, W_KIND)
}

fn win_id(state: u64, i: u64) -> u64 {
    return wg(state, i, W_ID)
}

// HAT DIESES FENSTER SCHMUCK? Rahmen, Titelleiste, Schliessfeld und
// Griff kosten links BORDER und oben TITLE_H. Ein Schreibtisch, der
// zwei Bildpunkte neben dem Bildschirmrand anfaengt, ist kein
// Schreibtisch; eine Taskleiste mit Titelleiste ist keine Taskleiste.
fn deko(state: u64, i: u64) -> bool {
    return (wg(state, i, W_FLAGS) & F_NODECO) == 0
}

// Der Versatz der Malflaeche innerhalb des aeusseren Rechtecks. An
// EINER Stelle, weil dieselbe Rechnung im Zusammensetzen, im Treffer
// und in der Ereignisverteilung vorkommt -- und weil sie in der ersten
// Fassung dieser Runde an zweien davon stand und an der dritten nicht.
fn inx(state: u64, i: u64) -> u64 {
    if deko(state, i) {
        return border(state)
    }
    return 0
}

fn iny(state: u64, i: u64) -> u64 {
    if deko(state, i) {
        return title_h(state)
    }
    return 0
}

fn outer_w(state: u64, i: u64) -> u64 {
    if !deko(state, i) {
        return wg(state, i, W_W)
    }
    return wg(state, i, W_W) + border(state) * 2
}

fn outer_h(state: u64, i: u64) -> u64 {
    if !deko(state, i) {
        return wg(state, i, W_H)
    }
    return wg(state, i, W_H) + title_h(state) + border(state)
}

fn win_layer(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return L_NORMAL
    }
    return wg(state, i, W_LAYER)
}

fn win_hidden(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_HIDDEN) != 0
}

fn win_deco(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return deko(state, i)
}

// Die Adresse des Titels IM KERNEL. Nur `sys.fi` benutzt sie, um ihn
// nach Ring 3 zu kopieren -- die Taskleiste braucht Namen.
fn win_title(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return 0
    }
    return state + wat(i) + W_TITLE
}

// Das Fenster mit dieser Nummer. Die Taskleiste kennt FREMDE Fenster
// nur ueber ihre Nummer -- ein Handle bekommt sie nicht, und ein Platz
// in der Tafel waere eine Zahl, die sich unter ihr aendert.
fn by_id(state: u64, id: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_ID) == id {
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

fn hides(state: u64) -> u64 {
    return gs(state, S_HIDES)
}

fn shows(state: u64) -> u64 {
    return gs(state, S_SHOWS)
}

fn nolayer(state: u64) -> bool {
    return gs(state, S_NOLAYER) != 0
}

fn nomin(state: u64) -> bool {
    return gs(state, S_NOMIN) != 0
}

fn set_nolayer(state: u64, on: bool) {
    if on {
        ss(state, S_NOLAYER, 1)
    } else {
        ss(state, S_NOLAYER, 0)
    }
}

fn set_nomin(state: u64, on: bool) {
    if on {
        ss(state, S_NOMIN, 1)
    } else {
        ss(state, S_NOMIN, 0)
    }
}

fn term_cols(state: u64, i: u64) -> u64 {
    return wg(state, i, W_COLS)
}

fn term_rows(state: u64, i: u64) -> u64 {
    return wg(state, i, W_ROWS)
}

fn term_cx(state: u64, i: u64) -> u64 {
    return wg(state, i, W_CX)
}

fn term_cy(state: u64, i: u64) -> u64 {
    return wg(state, i, W_CY)
}

// ------------------------------------------------------------- Start

fn init(state: u64, w: u64, h: u64, nodirty: bool, nofocus: bool) -> bool {
    if w == 0 || h == 0 {
        return false
    }
    var i: u64 = 0
    while i < MAX_WIN {
        wsv(state, i, W_USED, 0)
        wsv(state, i, W_EHEAD, 0)
        wsv(state, i, W_ETAIL, 0)
        wsv(state, i, W_LAYER, L_NORMAL)
        wsv(state, i, W_FLAGS, 0)
        wsv(state, i, W_STRUT, 0)
        wsv(state, i, W_SAVE, 0)
        i = i + 1
    }
    ss(state, S_COUNT, 0)
    ss(state, S_FOCUS, 0)
    ss(state, S_NEXTID, 1)
    ss(state, S_SW, w)
    ss(state, S_SH, h)
    ss(state, S_DRAG, 0)
    ss(state, S_SIZING, 0)
    ss(state, S_CURON, 1)
    ss(state, S_CURX, w / 2)
    ss(state, S_CURY, h / 2)
    ss(state, S_COMPOSITES, 0)
    ss(state, S_BLITS, 0)
    ss(state, S_PIXELS, 0)
    ss(state, S_KEYS, 0)
    ss(state, S_EVDROP, 0)
    ss(state, S_LASTUS, 0)
    ss(state, S_DON, 0)
    ss(state, S_NODIRTY, 0)
    if nodirty {
        ss(state, S_NODIRTY, 1)
    }
    ss(state, S_NOFOCUS, 0)
    if nofocus {
        ss(state, S_NOFOCUS, 1)
    }
    ss(state, S_HIDES, 0)
    ss(state, S_SHOWS, 0)
    // ADDENDUM TASKBAR: before the first strut the work area IS the
    // screen. `recalc_work` reads S_SW and S_SH, so it has to run after
    // both are set -- they are, twelve lines above this one.
    ss(state, S_NOSTRUT, 0)
    ss(state, S_STRUTS, 0)
    ss(state, S_WORKCALC, 0)
    recalc_work(state)
    ss(state, S_DESK, deco(state, DK_DESK))
    ss(state, S_FONT_UI, ttf.MAX_FONTS)
    ss(state, S_FONT_MONO, ttf.MAX_FONTS)
    ss(state, S_TILE, 0)
    ss(state, S_PVON, 0)
    ss(state, S_DROPN, 0)
    ss(state, S_DROPE, 0)
    ss(state, S_DRAGT, 0)
    ss(state, S_HOTS, 0)
    ss(state, S_ACTS, 0)
    ss(state, S_READY, 1)
    // RUNDE TILING: der Baum bekommt dieselbe Flaeche wie der Schirm.
    // Er ist erst einmal LEER und schaltet nichts um -- ohne das Wort
    // `tile` verhaelt sich der Fensterserver wie vorher.
    tile.init(state, 0, 0, w, h)
    damage_all(state)
    return true
}

// ---------------------------------------------------- die Rechtecke

fn damage(state: u64, x0: i64, y0: i64, x1: i64, y1: i64) {
    if !ready(state) {
        return
    }
    if gs(state, S_NODIRTY) != 0 {
        damage_all(state)
        return
    }
    var a: i64 = x0
    var b: i64 = y0
    var c: i64 = x1
    var d: i64 = y1
    if a < 0 {
        a = 0
    }
    if b < 0 {
        b = 0
    }
    if c > gs(state, S_SW) as i64 {
        c = gs(state, S_SW) as i64
    }
    if d > gs(state, S_SH) as i64 {
        d = gs(state, S_SH) as i64
    }
    if c <= a || d <= b {
        return
    }
    if gs(state, S_DON) == 0 {
        ss(state, S_DX0, a as u64)
        ss(state, S_DY0, b as u64)
        ss(state, S_DX1, c as u64)
        ss(state, S_DY1, d as u64)
        ss(state, S_DON, 1)
        return
    }
    if (a as u64) < gs(state, S_DX0) {
        ss(state, S_DX0, a as u64)
    }
    if (b as u64) < gs(state, S_DY0) {
        ss(state, S_DY0, b as u64)
    }
    if (c as u64) > gs(state, S_DX1) {
        ss(state, S_DX1, c as u64)
    }
    if (d as u64) > gs(state, S_DY1) {
        ss(state, S_DY1, d as u64)
    }
}

fn damage_all(state: u64) {
    ss(state, S_DX0, 0)
    ss(state, S_DY0, 0)
    ss(state, S_DX1, gs(state, S_SW))
    ss(state, S_DY1, gs(state, S_SH))
    ss(state, S_DON, 1)
}

// RUNDE PAINT: DER SCHATTEN GEHOERT ZUM SCHMUTZ.
//
// Ein Schatten liegt AUSSERHALB des Fensterrechtecks. Meldet ein
// Fenster beim Verschieben nur sein eigenes Rechteck als geaendert,
// bleibt der alte Schatten stehen -- eine Spur aus grauen Raendern
// quer ueber den Schreibtisch. Der erste Entwurf dieser Runde tat
// genau das, und man sah es sofort.
//
// Also: der schmutzige Bereich waechst um die Reichweite des Schattens,
// und zwar auf ALLEN VIER SEITEN. Unten und rechts reicht er weiter
// (der Schatten sitzt einen Bildpunkt tiefer), oben und links wird
// trotzdem dieselbe Zahl genommen -- ein Bereich, der einen Bildpunkt
// zu gross ist, kostet eine Bildzeile; einer, der einen zu klein ist,
// kostet eine sichtbare Kante.
fn damage_win(state: u64, i: u64) {
    // RUNDE SOFTUI: DIE GROESSERE DER BEIDEN REICHWEITEN.
    //
    // Es gibt jetzt zwei Schatten -- einen unter dem scharfen Fenster
    // und einen flacheren unter den uebrigen -- und ein Fenster
    // WECHSELT zwischen ihnen. Der schmutzige Bereich muss deshalb den
    // groesseren der beiden fassen, sonst bleibt beim Fokuswechsel der
    // Rest des tieferen Schattens als grauer Saum stehen. Genau diese
    // Sorte Spur hat Runde PAINT schon einmal gejagt.
    var r: i64 = form(state, FM_SHADOW_R) as i64
    let r2: i64 = form(state, FM_SHADOW_R2) as i64
    if r2 > r {
        r = r2
    }
    if form(state, FM_SHADOW) == 0 && form(state, FM_SHADOW2) == 0 {
        r = 0
    }
    if !deko(state, i) {
        r = 0
    }
    var x0: i64 = win_x(state, i) - r
    var y0: i64 = win_y(state, i) - r
    if x0 < 0 {
        x0 = 0
    }
    if y0 < 0 {
        y0 = 0
    }
    damage(state, x0, y0,
        win_x(state, i) + outer_w(state, i) as i64 + r + 1,
        win_y(state, i) + outer_h(state, i) as i64 + r + 1)
}

fn dirty_x0(state: u64) -> u64 {
    return gs(state, S_DX0)
}

fn dirty_y0(state: u64) -> u64 {
    return gs(state, S_DY0)
}

fn dirty_x1(state: u64) -> u64 {
    return gs(state, S_DX1)
}

fn dirty_y1(state: u64) -> u64 {
    return gs(state, S_DY1)
}

// ------------------------------------------------------ die Fenster

fn create(state: u64, owner: u64, x: i64, y: i64, w: u64, h: u64,
    kind: u64, title: u64) -> u64 {
    if !ready(state) || w < 32 || h < 16 || w > MAX_W_HARD
        || h > MAX_H_HARD {
        return MAX_WIN
    }
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) == 0 {
            let bytes: u64 = w * h * 4
            let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
            let buf: u64 = mem.frame_run(state, rahmen)
            if buf == 0 {
                return MAX_WIN
            }
            wsv(state, i, W_USED, 1)
            wsv(state, i, W_ID, gs(state, S_NEXTID))
            ss(state, S_NEXTID, gs(state, S_NEXTID) + 1)
            wsv(state, i, W_OWNER, owner)
            // ==================================== RUNDE BLECHDREI
            // EIN FENSTER FAENGT UNTER DER ARBEITSFLAECHE AN.
            //
            // Der Schreibtisch legt sein Terminalfenster auf feste
            // Koordinaten (x=24, y=40). Mit dem reservierten Band der
            // Messtafel lag es damit VOLLSTAENDIG darunter und wurde von
            // `fb` weggeschnitten -- ein Fenster, das es gibt, das man
            // aber nicht sieht. Ein Strut, den nur die Maximierung
            // beachtet, ist keiner.
            //
            // Nur nach UNTEN geschoben, nie verkleinert, und nur wenn es
            // ein Band gibt: bei `nostrut` und auf schmalen Schirmen ist
            // `work_y` null und diese Zeilen tun nichts. Deshalb sehen
            // die Laeufe in tools/wm/run.sh dieselben Koordinaten wie
            // vorher.
            var wy: i64 = y
            let oben: i64 = gs(state, S_WORK_Y) as i64
            if wy < oben {
                wy = oben
            }
            wsv(state, i, W_X, x as u64)
            wsv(state, i, W_Y, wy as u64)
            wsv(state, i, W_W, w)
            wsv(state, i, W_H, h)
            wsv(state, i, W_BUF, buf)
            wsv(state, i, W_BUFBYTES, rahmen * mem.FRAME_SIZE)
            wsv(state, i, W_KIND, kind)
            wsv(state, i, W_EHEAD, 0)
            wsv(state, i, W_ETAIL, 0)
            wsv(state, i, W_FG, deco(state, DK_TERM_FG))
            wsv(state, i, W_BG, deco(state, DK_TERM_BG))
            wsv(state, i, W_GRID, 0)
            wsv(state, i, W_KEYS, 0)
            wsv(state, i, W_LAYER, L_NORMAL)
            wsv(state, i, W_FLAGS, 0)
            wsv(state, i, W_STRUT, 0)
            wsv(state, i, W_SAVE, 0)
            // RUNDE PAINT: ein wiederverwendeter Platz erbt sonst den
            // Buendelnamen des VORIGEN Fensters -- und damit sein
            // Symbol. Genau die Sorte Fehler, die man erst sieht, wenn
            // das sechzehnte Fenster aufgeht.
            let _cl: bool = set_app(state, i, 0)
            wsv(state, i, W_Z, gs(state, S_COUNT))
            ss(state, S_COUNT, gs(state, S_COUNT) + 1)
            // RUNDE DESKTOP: ein neues Fenster kommt an die Oberkante
            // SEINER Ebene und nicht an die Oberkante von allem. Solange
            // es keine Taskleiste gibt, ist das dasselbe; sobald es eine
            // gibt, ist es der Unterschied zwischen einer Leiste und
            // einem Fenster, das sie verdeckt.
            raise_win(state, i)
            set_title(state, i, title)
            fill(state, i, 0, 0, w, h, wg(state, i, W_BG))
            if kind == K_TERM {
                term_setup(state, i)
            }
            set_focus(state, i)
            damage_win(state, i)
            if gs(state, S_TILE) != 0 {
                tile_take(state, i)
            }
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

// RUNDE PAINT: der Buendelname des Fensters. Wie `set_title`
// abgeschnitten statt abgelehnt -- ein zu langer Name ist kein Grund,
// ein Fenster zu verweigern -- und immer nullterminiert.
fn set_app(state: u64, i: u64, p: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    var k: u64 = 0
    while k < APP_LEN - 1 {
        var c: u64 = 0
        if p != 0 {
            c = kstate.get8(p + k)
        }
        kstate.set8(state + wat(i) + W_APP + k, c as u8)
        if c == 0 {
            k = APP_LEN - 1
        } else {
            k = k + 1
        }
    }
    kstate.set8(state + wat(i) + W_APP + APP_LEN - 1, 0 as u8)
    return true
}

fn win_app(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return 0
    }
    return state + wat(i) + W_APP
}

fn set_title(state: u64, i: u64, p: u64) {
    var k: u64 = 0
    while k < 31 {
        var c: u64 = 0
        if p != 0 {
            c = kstate.get8(p + k)
        }
        kstate.set8(state + wat(i) + W_TITLE + k, c as u8)
        if c == 0 {
            k = 31
        } else {
            k = k + 1
        }
    }
    kstate.set8(state + wat(i) + W_TITLE + 31, 0 as u8)
}

fn destroy(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    tile_release(state, i)
    damage_win(state, i)
    let z: u64 = wg(state, i, W_Z)
    // ADDENDUM TASKBAR: a window that reserved a screen edge gives the
    // edge back when it dies. Without this the work area would stay
    // small after the taskbar exits, and every window maximized after
    // that would leave a strip of empty desktop.
    let hatte_strut: bool = wg(state, i, W_STRUT) != 0
    wsv(state, i, W_STRUT, 0)
    wsv(state, i, W_USED, 0)
    if wg(state, i, W_BUF) != 0 {
        mem.frame_free_run(state, wg(state, i, W_BUF),
            wg(state, i, W_BUFBYTES) / mem.FRAME_SIZE)
        wsv(state, i, W_BUF, 0)
    }
    if wg(state, i, W_GRID) != 0 {
        mem.frame_free_run(state, wg(state, i, W_GRID), 1)
        wsv(state, i, W_GRID, 0)
    }
    // Die Stapelreihenfolge schliesst sich: wer ueber dem geschlossenen
    // Fenster lag, rutscht eine Stufe herunter. Ohne das entstehen
    // Luecken, und `compose` findet auf einer Stufe kein Fenster mehr.
    var k: u64 = 0
    while k < MAX_WIN {
        if wg(state, k, W_USED) != 0 && wg(state, k, W_Z) > z {
            wsv(state, k, W_Z, wg(state, k, W_Z) - 1)
        }
        k = k + 1
    }
    ss(state, S_COUNT, gs(state, S_COUNT) - 1)
    if focus(state) == i {
        ss(state, S_FOCUS, 0)
        // Der Fokus geht an das oberste verbliebene SICHTBARE Fenster
        // der normalen Ebene -- nicht an den Schreibtisch und nicht an
        // die Taskleiste.
        let o: u64 = top_visible(state)
        if o < MAX_WIN {
            set_focus(state, o)
        }
    }
    if gs(state, S_DRAG) == i + 1 {
        ss(state, S_DRAG, 0)
    }
    if gs(state, S_SIZING) == i + 1 {
        ss(state, S_SIZING, 0)
    }
    // ==================================== RUNDE BLECHFUENF
    // WAS SONST NOCH AUF DIESES FENSTER ZEIGT.
    //
    // Justin klickt auf das Kreuz, und danach ist die Maschine weg.
    // `S_DRAG` und `S_SIZING` waren gedacht, `S_CAPHOV` nicht -- und
    // GENAU DAS ist der Zustand nach einem Klick auf das Kreuz: der
    // Zeiger stand ueber dem Knopf, also stand dort die Nummer dieses
    // Fensters, und der naechste `cap_track` faerbt eine Schaltflaeche
    // an einem Fenster, das es nicht mehr gibt. Wird der Platz danach
    // neu vergeben, faerbt er die des NEUEN.
    if gs(state, S_CAPHOV) != 0 && (gs(state, S_CAPHOV) - 1) / 4 == i {
        ss(state, S_CAPHOV, 0)
    }
    // UND DIE MASSE AUF NULL. `destroy` hat den Puffer freigegeben und
    // W_BUF genullt, die BREITE und HOEHE aber stehen gelassen. Ein
    // Weg, der die Gueltigkeit nicht prueft, rechnet damit ein
    // plausibles Rechteck aus und schreibt es an die Anschrift null --
    // also mitten in die Seitentafeln des Kerns. Mit Nullen kommt er
    // ueber die erste Schleifenbedingung nicht hinaus.
    wsv(state, i, W_W, 0)
    wsv(state, i, W_H, 0)
    wsv(state, i, W_COLS, 0)
    wsv(state, i, W_ROWS, 0)
    wsv(state, i, W_CX, 0)
    wsv(state, i, W_CY, 0)
    wsv(state, i, W_KIND, 0)
    wsv(state, i, W_EHEAD, 0)
    wsv(state, i, W_ETAIL, 0)
    if hatte_strut {
        recalc_work(state)
    }
    return true
}

// ============================================ RUNDE BLECHFUENF
// DAS OBERSTE FENSTER ZUMACHEN -- GENAU SO WIE DAS KREUZ.
//
// Kein zweiter Weg neben `on_mouse`, sondern DIESELBEN ZWEI ZEILEN:
// erst das Ereignis in den Ring des Fensters, dann `destroy`. Waere es
// ein anderer Weg, waere die Gegenprobe wertlos.
// DIE MITTE DES SCHLIESSKREUZES eines Fensters, gepackt (x << 32) | y.
// Damit kann die Gegenprobe wirklich DORTHIN klicken, wo Justin
// geklickt hat -- und nicht einen zweiten Schliessweg neben dem Kreuz
// benutzen, der die Haelfte der Arbeit auslaesst.
fn cross_point(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    let bx: i64 = cap_x0(state, i) + (CAP_CLOSE * cap_w(state)) as i64
        + (cap_w(state) / 2) as i64
    let by: i64 = win_y(state, i) + border(state) as i64
        + ((title_h(state) - 1 - border(state)) / 2) as i64
    if bx < 0 || by < 0 {
        return 0
    }
    return ((bx as u64) << 32) | (by as u64)
}

fn term_win(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_KIND) == K_TERM {
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

// ---------------------------------------------------- die drei Anlaesse
//
// DREI EINSTIEGE UND EIN FALLBACK, und der Fallback ist der Kern der
// Sache: ist die Bewegung abgeschaltet (Formmarke motion=0 oder die
// Gegenprobe `noanim`), tut jede dieser Funktionen SOFORT das, was sie
// zusagt. Der Endzustand haengt nie an der Bewegung -- ein Fenster, das
// geschlossen werden soll, wird geschlossen, ob es dabei schrumpft oder
// nicht. Das ist der Unterschied zwischen "reduziert" und "kaputt".

// Ein neues Fenster waechst auf. Der Aufrufer hat es schon angelegt.
fn open_anim(state: u64, i: u64) -> bool {
    return anim_start(state, i, AN_OPEN)
}

// Schliessen ueber die Bewegung. Das Fenster verschwindet erst, wenn
// sie durch ist -- `anim_tick` ruft dann `destroy`. Ohne Bewegung
// geschieht genau das sofort.
fn close_anim(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    ev_push(state, i, E_CLOSE, 0, 0, 0)
    if !anim_start(state, i, AN_CLOSE) {
        destroy(state, i)
        return false
    }
    return true
}

// Minimieren ueber die Bewegung. Dasselbe Bild wie beim Schliessen,
// aber am Ende steht `set_hidden` und nicht `destroy`.
fn minimize_anim(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if !anim_start(state, i, AN_MIN) {
        set_hidden(state, i, true)
        return false
    }
    return true
}

fn close_top(state: u64) -> u64 {
    let i: u64 = top_visible(state)
    if i >= MAX_WIN {
        return MAX_WIN
    }
    ev_push(state, i, E_CLOSE, 0, 0, 0)
    destroy(state, i)
    return i
}

// DAS TERMINALFENSTER. Justins Foto zeigt "Terminal -- sh" mit dem
// Kreuz, auf das er geklickt hat -- also ist DAS das Fenster, das die
// Gegenprobe zuerst zumachen muss und nicht irgendeines.
fn close_term(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_KIND) == K_TERM {
            ev_push(state, i, E_CLOSE, 0, 0, 0)
            destroy(state, i)
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

fn topmost(state: u64) -> u64 {
    var beste: u64 = MAX_WIN
    var bz: u64 = 0
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 {
            if beste == MAX_WIN || wg(state, i, W_Z) >= bz {
                beste = i
                bz = wg(state, i, W_Z)
            }
        }
        i = i + 1
    }
    return beste
}

// DAS OBERSTE SICHTBARE FENSTER DER NORMALEN EBENE. Es ist das, an das
// der Fokus faellt, wenn eines geschlossen oder minimiert wird -- und
// es ist ausdruecklich NICHT der Schreibtisch und NICHT die
// Taskleiste. Beide nehmen die Tastatur nicht an; wer in einer
// Taskleiste tippt, hat kein Fenster mehr, in dem der Text landet.
fn top_visible(state: u64) -> u64 {
    var beste: u64 = MAX_WIN
    var bz: u64 = 0
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_LAYER) == L_NORMAL {
            if (wg(state, i, W_FLAGS) & F_HIDDEN) == 0 {
                if beste == MAX_WIN || wg(state, i, W_Z) >= bz {
                    beste = i
                    bz = wg(state, i, W_Z)
                }
            }
        }
        i = i + 1
    }
    return beste
}

// AUF WELCHE STUFE GEHOERT EIN FENSTER DER EBENE `l` GANZ OBEN. Gezaehlt
// werden alle belegten Fenster mit kleinerer ODER GLEICHER Ebene --
// einschliesslich des Fensters selbst, wenn es schon belegt ist. Die
// gesuchte Stufe ist eine weniger.
fn zslot(state: u64, l: u64) -> u64 {
    var n: u64 = 0
    var k: u64 = 0
    while k < MAX_WIN {
        if wg(state, k, W_USED) != 0 && wg(state, k, W_LAYER) <= l {
            n = n + 1
        }
        k = k + 1
    }
    return n
}

// EIN FENSTER AUF EINE ANDERE STUFE, in beide Richtungen. Runde K10
// hatte nur `raise_win`, und das konnte nur nach oben: es zog alles
// ueber dem Fenster eine Stufe herunter und setzte es an die Spitze.
// Mit Ebenen muss ein Fenster auch SINKEN koennen (ein Schreibtisch,
// der als letztes entsteht, gehoert nach ganz hinten), und das ist die
// andere Haelfte derselben Verschiebung.
fn move_to_z(state: u64, i: u64, ziel: u64) {
    let z: u64 = wg(state, i, W_Z)
    if ziel == z || ziel >= gs(state, S_COUNT) {
        return
    }
    var k: u64 = 0
    while k < MAX_WIN {
        if wg(state, k, W_USED) != 0 && k != i {
            let kz: u64 = wg(state, k, W_Z)
            if z < ziel {
                if kz > z && kz <= ziel {
                    wsv(state, k, W_Z, kz - 1)
                }
            } else {
                if kz >= ziel && kz < z {
                    wsv(state, k, W_Z, kz + 1)
                }
            }
        }
        k = k + 1
    }
    wsv(state, i, W_Z, ziel)
    damage_win(state, i)
}

// Das Fenster auf einer Stufe der Stapelreihenfolge.
fn at_z(state: u64, z: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 && wg(state, i, W_Z) == z {
            return i
        }
        i = i + 1
    }
    return MAX_WIN
}

// HEBEN HEISST SEIT DER RUNDE DESKTOP: an die Oberkante SEINER EBENE.
// Mit `nolayer` ist es wieder die Oberkante von allem -- und genau
// dann verdeckt der Schreibtisch beim ersten Klick den ganzen
// Bildschirm. Das ist die Gegenprobe, und sie ist eine Zeile.
fn raise_win(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    var ziel: u64 = gs(state, S_COUNT) - 1
    if gs(state, S_NOLAYER) == 0 {
        ziel = zslot(state, wg(state, i, W_LAYER)) - 1
    }
    move_to_z(state, i, ziel)
}

// DIE EBENE EINES FENSTERS SETZEN. Danach wandert es sofort an die
// Oberkante der neuen Ebene -- ein Schreibtisch, der seine Ebene
// bekommt und liegen bleibt, wo er war, waere kein Schreibtisch.
fn set_layer(state: u64, i: u64, l: u64) {
    if !valid(state, i) || l > L_MAX {
        return
    }
    if wg(state, i, W_LAYER) == l {
        return
    }
    wsv(state, i, W_LAYER, l)
    // Ein Fenster, das aus der normalen Ebene verschwindet, darf den
    // Eingabefokus nicht mitnehmen.
    //
    // RUNDE VOLLBILD: AUSSER ES IST DAS VOLLBILD. Ein Vollbildfenster
    // liegt auf L_FULL und ist trotzdem das Fenster, in dem der Mensch
    // arbeitet -- naehme man ihm hier den Fokus, ginge das zweite F11
    // ins Leere und der Schirm waere gesperrt. Genau der Fall, den
    // Justin als "sonst ist der Schirm gesperrt" benannt hat.
    if l != L_NORMAL && l != L_FULL && focus(state) == i
        && (wg(state, i, W_FLAGS) & F_KEYS) == 0 {
        ss(state, S_FOCUS, 0)
        // RUNDE ECHTHARDWARE-4: ZURUECK ZU DEM, DER IHN HATTE.
        // Der Grund steht bei S_FOCUS_PREV. `top_visible` bleibt der
        // zweite Weg -- fuer den Fall, dass der Vorbesitzer inzwischen
        // weg oder verborgen ist.
        let before: u64 = gs(state, S_FOCUS_PREV)
        if before != 0 && before - 1 != i && valid(state, before - 1)
            && (wg(state, before - 1, W_FLAGS) & F_HIDDEN) == 0 {
            set_focus(state, before - 1)
        } else {
            let o: u64 = top_visible(state)
            if o < MAX_WIN {
                set_focus(state, o)
            }
        }
    }
    raise_win(state, i)
    damage_all(state)
}

// MINIMIEREN UND WIEDERHERSTELLEN. Ein verborgenes Fenster wird nicht
// zusammengesetzt und nimmt keinen Klick an -- es LEBT aber weiter, sein
// Puffer bleibt liegen, seine Ereignisse laufen weiter auf. Das ist der
// ganze Unterschied zu `destroy`, und er ist der Grund, warum ein
// Leistenknopf ein Fenster zurueckholen kann.
//
// `nomin` ist die Gegenprobe und tut hier NICHTS -- und deshalb bleibt
// das Fenster dann stehen, obwohl der Knopf gedrueckt wurde.
fn set_hidden(state: u64, i: u64, h: bool) {
    if !valid(state, i) {
        return
    }
    if gs(state, S_NOMIN) != 0 {
        return
    }
    let f: u64 = wg(state, i, W_FLAGS)
    if h {
        if (f & F_HIDDEN) != 0 {
            return
        }
        wsv(state, i, W_FLAGS, f | F_HIDDEN)
        ss(state, S_HIDES, gs(state, S_HIDES) + 1)
        // ADDENDUM TASKBAR: a window nobody can see reserves nothing.
        if wg(state, i, W_STRUT) != 0 {
            recalc_work(state)
        }
        damage_win(state, i)
        if focus(state) == i {
            ss(state, S_FOCUS, 0)
            let o: u64 = top_visible(state)
            if o < MAX_WIN {
                set_focus(state, o)
            }
        }
        if gs(state, S_DRAG) == i + 1 {
            ss(state, S_DRAG, 0)
        }
        if gs(state, S_SIZING) == i + 1 {
            ss(state, S_SIZING, 0)
        }
    } else {
        if (f & F_HIDDEN) == 0 {
            return
        }
        wsv(state, i, W_FLAGS, f & ~F_HIDDEN)
        ss(state, S_SHOWS, gs(state, S_SHOWS) + 1)
        if wg(state, i, W_STRUT) != 0 {
            recalc_work(state)
        }
        damage_win(state, i)
    }
}

fn set_deco(state: u64, i: u64, on: bool) {
    if !valid(state, i) {
        return
    }
    let f: u64 = wg(state, i, W_FLAGS)
    damage_win(state, i) // das ALTE Rechteck, samt Rahmen
    if on {
        wsv(state, i, W_FLAGS, f & ~F_NODECO)
    } else {
        wsv(state, i, W_FLAGS, f | F_NODECO)
    }
    damage_win(state, i) // und das neue, ohne
}

// ==================== ADDENDUM TASKBAR: STRUTS AND THE WORK AREA ====
//
// THE PROBLEM, stated plainly. Round DESKTOP gave this system a
// taskbar, and it is a window like any other. A window made as large as
// the screen is therefore drawn OVER it; a window placed under it is
// invisible. As long as the taskbar always sat at the bottom edge one
// could hard-code 28 pixels somewhere and move on. It no longer always
// sits at the bottom.
//
// X11 solved this in 1997 with a window property named `_NET_WM_STRUT`:
// a window declares how many pixels of which screen edge it occupies,
// the window manager subtracts every strut from the screen, and calls
// what is left the WORK AREA. All layout arithmetic uses the work area
// and not the screen. This is the same idea in a form that fits a
// kernel with no properties and no atoms: ONE WORD in the window
// record, and four scalars for the result.
//
// WHY IT LIVES IN THE SERVER AND NOT IN THE TASKBAR. Because the
// taskbar is not the only one who needs the answer. The round TILING
// running in parallel on this tree turns the window system into a tree
// of frames, and the ROOT RECTANGLE of that tree is exactly this work
// area -- not the screen. If the reservation lived inside the taskbar,
// every other client would have to ask the taskbar, and a client that
// does not know a taskbar exists would get it wrong and never find out.
//
// THE INTERFACE, and TILING should need nothing beyond it:
//
//     work_x(state), work_y(state), work_w(state), work_h(state)
//         the free rectangle. Never degenerate: a strut that would eat
//         the screen is refused, see `recalc_work`.
//     set_strut(state, i, edge, size) -> bool
//         declare (size > 0) or clear (size == 0) a reservation.
//         Recomputes the work area and refits every maximized window
//         in the same breath.
//     maximize(state, i, on) -> bool
//         fill the WORK AREA, not the screen, and remember where the
//         window was. This is the one call a tiling layout would
//         replace; the work area underneath it stays as it is.
//
// THE RULE, one sentence: whoever changes a strut, a screen size or the
// visibility of a strut-holding window calls `recalc_work`, and
// `recalc_work` refits the maximized windows. Nobody caches the work
// area anywhere else. There is exactly one copy of this state.
//
// THE COUNTER-TEST is `nostrut` and it is one branch: with it the work
// area is the whole screen again, a maximized window covers the taskbar
// and the taskbar is gone from the picture. That is the state this
// addendum removes, and it has to be reachable to be measurable.

fn uisc(state: u64) -> u64 {
    let v: u64 = gs(state, S_UISC)
    if v == 0 || v > 4 {
        return 1
    }
    return v
}

fn set_uiscale(state: u64, v: u64) {
    if v >= 1 && v <= 4 {
        ss(state, S_UISC, v)
    }
}

fn title_h(state: u64) -> u64 {
    return TITLE_H0 * uisc(state)
}

fn border(state: u64) -> u64 {
    return BORDER0 * uisc(state)
}

fn title_pad(state: u64) -> u64 {
    return TITLE_PAD0 * uisc(state)
}

fn grip(state: u64) -> u64 {
    return GRIP0 * uisc(state)
}

fn close_w(state: u64) -> u64 {
    return CLOSE_W0 * uisc(state)
}

fn cap_w(state: u64) -> u64 {
    return CAP_W0 * uisc(state)
}

// RUNDE SCHIRM: das groesste Fenster, das dieser Server macht -- die
// Masse des Schirms, gedeckelt auf das, was ein Puffer je Fenster noch
// vertraegt.
fn max_w(state: u64) -> u64 {
    var v: u64 = gs(state, S_SW)
    if v == 0 || v > MAX_W_HARD {
        v = MAX_W_HARD
    }
    return v
}

fn max_h(state: u64) -> u64 {
    var v: u64 = gs(state, S_SH)
    if v == 0 || v > MAX_H_HARD {
        v = MAX_H_HARD
    }
    return v
}

fn work_x(state: u64) -> u64 {
    return gs(state, S_WORK_X)
}

fn work_y(state: u64) -> u64 {
    return gs(state, S_WORK_Y)
}

fn work_w(state: u64) -> u64 {
    return gs(state, S_WORK_W)
}

fn work_h(state: u64) -> u64 {
    return gs(state, S_WORK_H)
}

// ================================================== RUNDE FENSTER
// DIE ARBEITSFLAECHE ALS ZAHLEN -- und daneben der ganze Schirm.
//
// Justins Frage lautet, ob ein maximiertes Fenster die Leiste
// beruehrt. Diese Frage ist nur zu beantworten, wenn beide Rechtecke
// auf der Leitung stehen: die Arbeitsflaeche (wo maximiert enden
// MUSS) und der Schirm (wo Vollbild enden DARF). Die Taskleiste
// meldet ihre Sicht als `taskbar: work` -- diese Zeile ist die des
// Fensterverwalters, und wenn die beiden auseinanderlaufen, ist genau
// das der Fehler.
//
//     wm: work x=0 y=0 w=3440 h=1360  schirm=3440x1440 struts=1
fn work_say(state: u64) {
    var s_h: [u8; 12] = "wm: work x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var s_s: [u8; 10] = "  schirm=\0"
    var s_x2: [u8; 2] = "x\0"
    var s_st: [u8; 9] = " struts=\0"
    serial.puts((&s_h[0]) as u64)
    serial.dec(gs(state, S_WORK_X))
    serial.puts((&s_y[0]) as u64)
    serial.dec(gs(state, S_WORK_Y))
    serial.puts((&s_w[0]) as u64)
    serial.dec(gs(state, S_WORK_W))
    serial.puts((&s_hh[0]) as u64)
    serial.dec(gs(state, S_WORK_H))
    serial.puts((&s_s[0]) as u64)
    serial.dec(gs(state, S_SW))
    serial.puts((&s_x2[0]) as u64)
    serial.dec(gs(state, S_SH))
    serial.puts((&s_st[0]) as u64)
    serial.dec(gs(state, S_STRUTS))
    serial.nl()
}

fn struts(state: u64) -> u64 {
    return gs(state, S_STRUTS)
}

fn workcalcs(state: u64) -> u64 {
    return gs(state, S_WORKCALC)
}

fn nostrut(state: u64) -> bool {
    return gs(state, S_NOSTRUT) != 0
}

fn win_strut_edge(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return EDGE_BOTTOM
    }
    let v: u64 = wg(state, i, W_STRUT)
    if v == 0 {
        return EDGE_BOTTOM
    }
    return (v & 0xFF) - 1
}

fn win_strut_size(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return 0
    }
    return wg(state, i, W_STRUT) >> 8
}

// THE WORK AREA, recomputed from scratch. Not incrementally: an
// incremental work area is a cache, and a cache of four numbers that
// three modules write is the kind of thing that is right in every test
// and wrong on the machine.
fn recalc_work(state: u64) {
    let sw: u64 = gs(state, S_SW)
    let sh: u64 = gs(state, S_SH)
    var x0: u64 = 0
    var y0: u64 = 0
    var x1: u64 = sw
    var y1: u64 = sh
    if gs(state, S_NOSTRUT) == 0 {
        // RUNDE BLECHDREI: das reservierte Band der Messtafel ist ein
        // Strut wie jeder andere -- nur einer, den kein Fenster haelt.
        // Ohne diese Zeile legte der Schreibtisch seine Fenster unter
        // die Tafel, und `fb` schnitte sie dort ab.
        y0 = fb.band(state)
        var i: u64 = 0
        while i < MAX_WIN {
            if wg(state, i, W_USED) != 0 && wg(state, i, W_STRUT) != 0 {
                if (wg(state, i, W_FLAGS) & F_HIDDEN) == 0 {
                    let e: u64 = (wg(state, i, W_STRUT) & 0xFF) - 1
                    let n: u64 = wg(state, i, W_STRUT) >> 8
                    if e == EDGE_TOP {
                        if n > y0 {
                            y0 = n
                        }
                    } else if e == EDGE_BOTTOM {
                        if n < sh && sh - n < y1 {
                            y1 = sh - n
                        }
                    } else if e == EDGE_LEFT {
                        if n > x0 {
                            x0 = n
                        }
                    } else {
                        if n < sw && sw - n < x1 {
                            x1 = sw - n
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    // A STRUT THAT EATS THE SCREEN IS NOT A STRUT. The smallest window
    // this server will make is 32 x 16 (see `resize_win`), plus the
    // decoration; below 64 x 64 of work area nothing can be laid out at
    // all, and the honest answer is to refuse the reservation rather
    // than to hand out a rectangle nobody can use.
    if x1 < x0 + 64 || y1 < y0 + 64 {
        x0 = 0
        y0 = 0
        x1 = sw
        y1 = sh
    }
    ss(state, S_WORK_X, x0)
    ss(state, S_WORK_Y, y0)
    ss(state, S_WORK_W, x1 - x0)
    ss(state, S_WORK_H, y1 - y0)
    ss(state, S_WORKCALC, gs(state, S_WORKCALC) + 1)
    refit_max(state)
    // RUNDE VOLLBILD: UND DER KACHELBAUM FOLGT MIT. `refit_max` zieht
    // die maximierten Fenster nach, der Baum blieb bisher stehen -- ein
    // gekacheltes Fenster behielt die Flaeche von vor dem Strut und lag
    // damit unter der Leiste. Dieselbe Begruendung wie bei `refit_max`
    // eine Zeile darueber: ein Strut, den nur die Haelfte beachtet, ist
    // keiner.
    tile_area_work(state)
    tile_apply(state)
}

fn set_nostrut(state: u64, on: bool) {
    if on {
        ss(state, S_NOSTRUT, 1)
    } else {
        ss(state, S_NOSTRUT, 0)
    }
    recalc_work(state)
}

fn set_strut(state: u64, i: u64, edge: u64, size: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if edge > EDGE_RIGHT {
        return false
    }
    if size > STRUT_MAX {
        return false
    }
    if size == 0 {
        wsv(state, i, W_STRUT, 0)
    } else {
        wsv(state, i, W_STRUT, (edge + 1) | (size << 8))
    }
    ss(state, S_STRUTS, gs(state, S_STRUTS) + 1)
    recalc_work(state)
    return true
}

fn is_max(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0
}

// PUT A WINDOW ON THE WORK AREA. The OUTER rectangle of the window --
// frame, title bar and all -- becomes the work area exactly; the
// drawing surface is that minus the decoration. A window without
// decoration (desktop, taskbar) has no such difference, which is why
// this goes through `deko` and not through BORDER and TITLE_H.
fn fit_work(state: u64, i: u64) -> bool {
    var iw: u64 = gs(state, S_WORK_W)
    var ih: u64 = gs(state, S_WORK_H)
    if deko(state, i) {
        if iw <= border(state) * 2 || ih <= title_h(state) + border(state) {
            return false
        }
        iw = iw - border(state) * 2
        ih = ih - title_h(state) - border(state)
    }
    if !resize_win(state, i, iw, ih) {
        return false
    }
    move_win(state, i, gs(state, S_WORK_X) as i64,
        gs(state, S_WORK_Y) as i64)
    return true
}

// EVERY MAXIMIZED WINDOW FOLLOWS THE WORK AREA. This is the whole point
// of the flag: the taskbar moves from the bottom edge to the left edge,
// the work area changes, and the windows that were filling it fill the
// new one. Without this they would keep the old rectangle and half of
// them would sit under the taskbar.
fn refit_max(state: u64) {
    var i: u64 = 0
    while i < MAX_WIN {
        if wg(state, i, W_USED) != 0 {
            if (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0 {
                let _r: bool = fit_work(state, i)
            }
        }
        i = i + 1
    }
}

fn maximize(state: u64, i: u64, on: bool) -> bool {
    if !valid(state, i) {
        return false
    }
    let f: u64 = wg(state, i, W_FLAGS)
    if on {
        if (f & F_MAXIMIZED) != 0 {
            return true
        }
        // Where to go back to. Biased by 4096 because a window may sit
        // at a negative coordinate and these are sixteen unsigned bits.
        let sx: u64 = ((win_x(state, i) + 4096) as u64) & 0xFFFF
        let sy: u64 = ((win_y(state, i) + 4096) as u64) & 0xFFFF
        wsv(state, i, W_SAVE, (sx << 48) | (sy << 32)
            | ((wg(state, i, W_W) & 0xFFFF) << 16)
            | (wg(state, i, W_H) & 0xFFFF))
        wsv(state, i, W_FLAGS, f | F_MAXIMIZED)
        if !fit_work(state, i) {
            // It did not fit -- most often because the buffer this
            // window was created with is smaller than the work area
            // (`resize_win` refuses to grow past it). Then it is NOT
            // maximized, and saying so is the whole difference between
            // a measurement and a claim.
            wsv(state, i, W_FLAGS, f)
            return false
        }
        return true
    }
    if (f & F_MAXIMIZED) == 0 {
        return true
    }
    let v: u64 = wg(state, i, W_SAVE)
    wsv(state, i, W_FLAGS, f & ~F_MAXIMIZED)
    let _r: bool = resize_win(state, i, (v >> 16) & 0xFFFF, v & 0xFFFF)
    let bx: i64 = ((v >> 48) & 0xFFFF) as i64 - 4096
    let by: i64 = ((v >> 32) & 0xFFFF) as i64 - 4096
    move_win(state, i, bx, by)
    return true
}

// ================================================== RUNDE VOLLBILD
// F11: DER GANZE SCHIRM, OHNE LEISTE UND OHNE SCHMUCK.
//
// Der Unterschied zu `maximize` in Zahlen (3440x1440, Leiste 80 hoch):
//
//     maximiert:  x=0 y=0   w=3440 h=1360   Leiste sichtbar, Titel da
//     Vollbild:   x=0 y=0   w=3440 h=1440   Leiste weg,      kein Titel
//
// WAS GESICHERT WIRD UND WARUM SO VIEL. Zurueck muss nicht nur die
// Groesse, sondern auch die LAGE und der ZUSTAND -- war das Fenster
// vorher maximiert, ist es hinterher wieder maximiert und nicht
// normal. F_MAXIMIZED wird deshalb NICHT geloescht, sondern
// stehengelassen und beim Verlassen ausgewertet.
//
// WARUM DIE LEISTE NICHT "VERSTECKT" WIRD. Ein `F_HIDDEN` auf der
// Leiste waere der naheliegende Weg und der falsche: die Leiste
// haelt einen Strut, `recalc_work` liefe, die Arbeitsflaeche
// waechst auf den ganzen Schirm, und JEDES maximierte Fenster
// dahinter wuerde mitwachsen. Beim Verlassen muesste alles
// zurueckgerechnet werden. Stattdessen liegt das Vollbildfenster
// einfach UEBER der Leiste (Ebene L_FULL) -- die Leiste bleibt, was
// sie ist, sie ist nur verdeckt. Das ist auch, was Windows tut.
fn fullscreen(state: u64, i: u64, on: bool) -> bool {
    if !valid(state, i) {
        return false
    }
    let f: u64 = wg(state, i, W_FLAGS)
    if on {
        if (f & F_FULL) != 0 {
            return true
        }
        // Lage und Groesse sichern -- mit demselben Versatz von 4096
        // wie `maximize`, weil ein Fenster negativ liegen darf.
        let sx: u64 = ((win_x(state, i) + 4096) as u64) & 0xFFFF
        let sy: u64 = ((win_y(state, i) + 4096) as u64) & 0xFFFF
        wsv(state, i, W_FSXY, (sx << 32) | sy)
        wsv(state, i, W_FSWH, ((wg(state, i, W_W) & 0xFFFF) << 32)
            | (wg(state, i, W_H) & 0xFFFF))
        // Der Schmuck faellt weg. Ob er vorher da war, steht im
        // gesicherten Merkerwort -- deshalb wird F_NODECO gesetzt und
        // nicht getauscht.
        let hatte_deko: bool = deko(state, i)
        wsv(state, i, W_FLAGS, f | F_FULL | F_NODECO)
        let sw: u64 = gs(state, S_SW)
        let sh: u64 = gs(state, S_SH)
        if !resize_win(state, i, sw, sh) {
            // Passt nicht -- dann ist es NICHT im Vollbild, und das
            // zu sagen ist der Unterschied zwischen einer Messung und
            // einer Behauptung (dieselbe Regel wie in `maximize`).
            var back: u64 = f
            if !hatte_deko {
                back = back | F_NODECO
            }
            wsv(state, i, W_FLAGS, back)
            return false
        }
        move_win(state, i, 0, 0)
        // UEBER die Leiste. Die Ebene ist die einzige Stelle, an der
        // "vor der Leiste" ueberhaupt ausgedrueckt werden kann.
        set_layer(state, i, L_FULL)
        raise_win(state, i)
        return true
    }
    if (f & F_FULL) == 0 {
        return true
    }
    // Zurueck auf die normale Ebene, BEVOR die Groesse kommt: sonst
    // malt ein Anstrich dazwischen das Fenster noch ganz oben.
    set_layer(state, i, L_NORMAL)
    let xy: u64 = wg(state, i, W_FSXY)
    let wh: u64 = wg(state, i, W_FSWH)
    // Der Schmuck kommt zurueck -- ausser das Fenster hatte nie
    // welchen (Schreibtisch, Leiste).
    var nf: u64 = f & ~F_FULL & ~F_NODECO
    wsv(state, i, W_FLAGS, nf)
    // WAR ES VORHER MAXIMIERT, wird es das wieder -- und zwar ueber
    // `fit_work`, damit es die AKTUELLE Arbeitsflaeche bekommt und
    // nicht die von damals. Das ist der Fall, der ohne eigene
    // Sicherungsplaetze kaputtginge.
    if (nf & F_MAXIMIZED) != 0 {
        if fit_work(state, i) {
            return true
        }
        wsv(state, i, W_FLAGS, nf & ~F_MAXIMIZED)
    }
    let _r: bool = resize_win(state, i, (wh >> 32) & 0xFFFF, wh & 0xFFFF)
    let bx: i64 = ((xy >> 32) & 0xFFFF) as i64 - 4096
    let by: i64 = (xy & 0xFFFF) as i64 - 4096
    move_win(state, i, bx, by)
    return true
}

// ================================================== RUNDE VOLLBILD
// WAS DAS VOLLBILD MIT DEM FENSTER GEMACHT HAT, ALS ZAHLEN.
//
// Justin will die Geometrie in ALLEN DREI Zustaenden sehen und den
// Rueckweg geprueft haben. Ohne diese Zeile muesste man sie aus dem
// Bild schaetzen -- und ein Zustandswechsel, den man nur sieht, ist
// keiner, den man nachrechnen kann.
//
//     wm: voll id=7 an=1 x=0 y=0 w=3440 h=1440 fl=34 lay=3
//
// `fl` traegt beide Merker: 32 ist F_FULL, 4 waere zusaetzlich
// F_MAXIMIZED -- daran liest ein Pruefer ab, ob der Rueckweg auf
// "maximiert" oder auf "normal" fuehren muss.
fn full_say(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    var s_h: [u8; 13] = "wm: voll id=\0"
    var s_a: [u8; 5] = " an=\0"
    var s_x: [u8; 4] = " x=\0"
    var s_y: [u8; 4] = " y=\0"
    var s_w: [u8; 4] = " w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var s_f: [u8; 5] = " fl=\0"
    var s_l: [u8; 6] = " lay=\0"
    serial.puts((&s_h[0]) as u64)
    serial.dec(wg(state, i, W_ID))
    serial.puts((&s_a[0]) as u64)
    if (wg(state, i, W_FLAGS) & F_FULL) != 0 {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_x[0]) as u64)
    serial.dec(win_x(state, i) as u64)
    serial.puts((&s_y[0]) as u64)
    serial.dec(win_y(state, i) as u64)
    serial.puts((&s_w[0]) as u64)
    serial.dec(wg(state, i, W_W))
    serial.puts((&s_hh[0]) as u64)
    serial.dec(wg(state, i, W_H))
    serial.puts((&s_f[0]) as u64)
    serial.dec(wg(state, i, W_FLAGS))
    serial.puts((&s_l[0]) as u64)
    serial.dec(wg(state, i, W_LAYER))
    serial.nl()
}

fn is_full(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_FULL) != 0
}

// ======================================================= RUNDE TUERSCHLOSS
// WAEHREND DES SELBSTTESTS SAGT DER FOKUS NICHTS.
//
// `set_focus` meldet seit dieser Runde jeden Wechsel als
// `wm: fokus id=<neu> vor=<alt>` -- und das ist der Beleg, ohne den
// Alt+Tab nicht messbar waere. Der Selbsttest ruft `set_focus` aber in
// seiner Zusage 7 auf, und zwar MITTEN in die Zeile hinein, die
// `kgui` gerade schreibt:
//
//     wm: selftest wm: fokus id=1 vor=0
//
// Damit war die Zahl hinter `selftest` weg, und tools/wm/run.sh meldete
// "keine Zahl gefunden (erwartet eq 30)" -- ein Fehler, den diese Runde
// selbst gebaut hat. Eine Diagnosezeile, die eine andere zerschneidet,
// ist keine Diagnose.
static mut fokus_still: u64 = 0

// RUNDE ECHTHARDWARE-1: das Fenster sagt, ob es die Tastatur will.
//
// Wird es JETZT gesetzt und das Fenster liegt schon oben und ist
// sichtbar, bekommt es den Fokus sofort -- sonst muesste man es erst
// noch einmal anklicken, und genau dieser zweite Klick war der Punkt,
// an dem Justins Startmenue "nichts tut" aussah.
fn set_keys(state: u64, i: u64, an: bool) {
    if !valid(state, i) {
        return
    }
    if an {
        wsv(state, i, W_FLAGS, wg(state, i, W_FLAGS) | F_KEYS)
        if (wg(state, i, W_FLAGS) & F_HIDDEN) == 0 {
            set_focus(state, i)
        }
    } else {
        wsv(state, i, W_FLAGS, wg(state, i, W_FLAGS) & ~F_KEYS)
    }
}

fn set_focus(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    // Ein verborgenes Fenster bekommt die Tastatur nicht. Sonst tippt
    // man in etwas, das nicht auf dem Schirm steht.
    if (wg(state, i, W_FLAGS) & F_HIDDEN) != 0 {
        return
    }
    let alt: u64 = focus(state)
    if alt == i {
        return
    }
    if alt < MAX_WIN {
        damage_win(state, alt)
        ev_push(state, alt, E_FOCUS, 0, 0, 0)
    }
    if alt < MAX_WIN {
        ss(state, S_FOCUS_PREV, alt + 1)
    }
    ss(state, S_FOCUS, i + 1)
    // ================================================ RUNDE TUERSCHLOSS
    //
    // DER FOKUSWECHSEL WIRD GESAGT, und ohne diese Zeile war Punkt 4.3
    // der Vorrunde gar nicht messbar.
    //
    // Runde DURCHKLICK schrieb "`focus=1` bleibt ueber 137 Meldungen
    // konstant" und belegte damit, dass Alt+Tab nichts tut. Nachgesehen:
    // das `focus=1` in jenen Mitschnitten stammt aus
    // `taskbar: btn ... hidden=0 focus=1` -- der KNOPFLISTE der Leiste --
    // und aus `wm: 1280x800 ... focus=1`, der EINSCHALTMELDUNG des
    // Servers. Keines von beiden ist der Eingabefokus. Der Befund war
    // richtig, sein Beleg zeigte aber auf etwas anderes.
    //
    // Der Eingabefokus stand nirgends auf der Leitung. Jetzt steht er
    // da: eine Zeile je WIRKLICHEM Wechsel (die Abfrage `alt == i`
    // weiter oben laesst Wiederholungen gar nicht bis hierher), mit dem
    // Fenster davor und danach.
    if fokus_still == 0 {
        var s_fk: [u8; 14] = "wm: fokus id=\0"
        var s_fv: [u8; 7] = " vor=\0\0"
        serial.puts((&s_fk[0]) as u64)
        serial.dec(wg(state, i, W_ID))
        serial.puts((&s_fv[0]) as u64)
        if alt < MAX_WIN {
            serial.dec(wg(state, alt, W_ID))
        } else {
            serial.dec(0)
        }
        serial.nl()
    }
    ev_push(state, i, E_FOCUS, 0, 0, 1)
    // RUNDE TILING: DER BAUM FUEHRT SEINEN EIGENEN FOKUS, und die beiden
    // muessen derselbe sein. Ohne diese zwei Zeilen teilt ein neues
    // Fenster nicht das ANGEKLICKTE, sondern das zuletzt angelegte -- ein
    // Fehler, der aussieht wie ein kaputter Baum und keiner ist.
    if wg(state, i, W_NODE) != 0 {
        tile.set_focus(state, wg(state, i, W_NODE) - 1)
    }
    damage_win(state, i)
}

fn move_win(state: u64, i: u64, x: i64, y: i64) {
    if !valid(state, i) {
        return
    }
    damage_win(state, i) // die alte Stelle wird wiederhergestellt
    wsv(state, i, W_X, x as u64)
    wsv(state, i, W_Y, y as u64)
    damage_win(state, i) // und die neue gemalt
}

fn resize_win(state: u64, i: u64, w: u64, h: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    // RUNDE SCHIRM: DIE ZWEI 2048 WAREN DER GRUND, WARUM AUF EINEM
    // 2560x1440-SCHIRM NICHTS MEHR MAXIMIERTE.
    //
    // Gemessen: `wm: selftest 26 / 30  failed=0x58c04200  mw=2  max=0`
    // -- das Fenster entstand (mw=2), aber `maximize` gab false. Der
    // Weg dahin ist fit_work -> resize_win, und dort stand ein fester
    // Deckel von 2048, den jeder Schirm ueber 2048 Bildpunkten Breite
    // reisst. Die Grenze, die es wirklich gibt, ist der PUFFER des
    // Fensters, und die steht zwei Zeilen tiefer.
    // ================================================== RUNDE GRIFF
    // WARUM DIE LEISTE SICH NICHT AUF IHREN SPALT ZUSAMMENZIEHEN KANN.
    //
    // GEMESSEN (Justins Blech, 2560x1440, ECHTHARDWARE-2):
    //
    //     taskbar: size w=2560 h=2 rc=-4
    //
    // `-4` ist E_INVALID und kommt aus genau dieser Zeile: die
    // Taskleiste mit `autohide=1` will sich auf ihren SLIVER von zwei
    // Bildpunkten zurueckziehen (kernel/user/taskbar.fi, `SLIVER`),
    // und `h < 16` weist das ab. Die Leiste bleibt in voller Hoehe
    // stehen -- das automatische Verbergen ist damit gebaut, gemeldet
    // und wirkungslos.
    //
    // WOFUER DIE 32x16 DA SIND: fuer ein Fenster MIT SCHMUCK. Unter
    // einer Titelleiste plus zwei Rahmen ist ein Fenster von 8x8
    // sinnlos, und `wm_strut` beruft sich weiter oben ausdruecklich auf
    // diese Zahl. Fuer ein Fenster OHNE Schmuck gilt die Begruendung
    // nicht: ein Spalt am Bildschirmrand IST die richtige Groesse.
    //
    // Also gilt die Untergrenze weiter -- aber sie fragt vorher, ob das
    // Fenster ueberhaupt Schmuck traegt. Ein undekoriertes Fenster darf
    // bis auf 1x1 herunter; kleiner als ein Bildpunkt ist nichts, und
    // `w * h * 4` weiter unten bleibt damit wohldefiniert.
    var min_w: u64 = 32
    var min_h: u64 = 16
    if !win_deco(state, i) {
        min_w = 1
        min_h = 1
    }
    if w < min_w || h < min_h || w > MAX_W_HARD || h > MAX_H_HARD {
        return false
    }
    // RUNDE HIDPUNKTE: HIER STAND "OHNE NEUEN PUFFER NICHT GROESSER ALS
    // ANGELEGT", UND DAS WAR DER GRUND, WARUM AUF EINEM ULTRAWIDE-SCHIRM
    // KEINE TASKLEISTE ZU SEHEN IST.
    //
    // Gemessen auf 3440x1440: die Leiste entsteht klein, will auf
    // `w=3440 h=56` wachsen (770 560 Oktett) und bekommt `rc=-4`. Sie
    // behaelt ihren alten Puffer von 128 Bildpunkten Breite -- und
    // genau 128 Bildpunkte breit ist sie danach auf dem Schirm
    // (nachgemessen im Bildschirmfoto, `docs/shots/hidpunkte/`). Auf
    // 1280x800 passte der Wunsch zufaellig in den vorhandenen Puffer,
    // deshalb ist das nie aufgefallen.
    //
    // Ein Fenster, das waechst, bekommt jetzt einen groesseren Puffer.
    // Der alte wird NICHT freigegeben -- `mem.frame_run` hat kein
    // Gegenstueck in diesem Kern, und ein Rahmen, der zurueckgegeben
    // wird, ohne dass es einen Weg dafuer gibt, ist schlimmer als einer,
    // der liegen bleibt. Bei sechzehn Fenstern ist das begrenzt.
    if w * h * 4 > wg(state, i, W_BUFBYTES) {
        let bytes: u64 = w * h * 4
        let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
        let neu: u64 = mem.frame_run(state, rahmen)
        if neu == 0 {
            return false // wirklich kein Speicher -- dann ehrlich nein
        }
        wsv(state, i, W_BUF, neu)
        wsv(state, i, W_BUFBYTES, rahmen * mem.FRAME_SIZE)
    }
    damage_win(state, i)
    wsv(state, i, W_W, w)
    wsv(state, i, W_H, h)
    if wg(state, i, W_KIND) == K_TERM {
        term_setup(state, i)
    } else {
        fill(state, i, 0, 0, w, h, wg(state, i, W_BG))
    }
    ev_push(state, i, E_RESIZE, w, h, 0)
    damage_win(state, i)
    return true
}

// ---------------------------------------------------- in ein Fenster

fn wpixel(state: u64, i: u64, x: u64, y: u64, color: u64) {
    let w: u64 = wg(state, i, W_W)
    if x >= w || y >= wg(state, i, W_H) {
        return
    }
    __mmio_write32((wg(state, i, W_BUF) +% y *% w *% 4 +% x *% 4)
        as *mut u32, color as u32)
}

fn wget(state: u64, i: u64, x: u64, y: u64) -> u64 {
    let w: u64 = wg(state, i, W_W)
    if x >= w || y >= wg(state, i, W_H) {
        return 0
    }
    return __mmio_read32((wg(state, i, W_BUF) +% y *% w *% 4 +% x *% 4)
        as *mut u32) as u64
}

fn fill(state: u64, i: u64, x: u64, y: u64, w: u64, h: u64, color: u64) {
    // RUNDE BLECHFUENF: KEIN PUFFER, KEIN SCHREIBEN. `valid` prueft den
    // Belegungsmerker; der Puffer ist eine zweite Zusage, und nach
    // `destroy` ist sie null. Eine Fuellung ohne diese Zeile schriebe
    // ab Anschrift null.
    if !valid(state, i) || wg(state, i, W_BUF) == 0 {
        return
    }
    let ww: u64 = wg(state, i, W_W)
    let wh: u64 = wg(state, i, W_H)
    if x >= ww || y >= wh {
        return
    }
    var bw: u64 = w
    var bh: u64 = h
    if x + bw > ww {
        bw = ww - x
    }
    if y + bh > wh {
        bh = wh - y
    }
    var r: u64 = 0
    while r < bh {
        let p: u64 = wg(state, i, W_BUF) +% (y + r) *% ww *% 4 +% x *% 4
        fill_words(p, (color & 0xFFFFFFFF) | ((color & 0xFFFFFFFF) << 32),
            bw / 2)
        if (bw & 1) != 0 {
            __mmio_write32((p +% (bw - 1) *% 4) as *mut u32, color as u32)
        }
        r = r + 1
    }
}

fn fill_words(p: u64, value: u64, words: u64) {
    if words == 0 {
        return
    }
    arch.fill_words(p, value, words)
}

fn copy_words(dst: u64, src: u64, words: u64) {
    if words == 0 {
        return
    }
    arch.copy_words(dst, src, words)
}

// Eine Farbe mit Deckkraft ueber eine andere. Ganzzahlig und ohne
// Rundungsbeiwerk -- `tools/ttf/raster.py` und `tools/gfx/checkshot.py`
// rechnen dieselbe Zeile, sonst waere ein bildpunktgenauer Vergleich
// eines kantengeglaetteten Zeichens nicht moeglich.
fn blend(alt: u64, neu: u64, a: u64) -> u64 {
    if a == 0 {
        return alt
    }
    if a >= 255 {
        return neu
    }
    let ia: u64 = 255 - a
    // ROUND PAINT: the same arithmetic as `fb.blend`, and it is a
    // DIFFERENT ANSWER from the one that stood here.  This line divided
    // by 255 and truncated; measured over all 16 777 216 triples
    // (a, src, dst) against the exact, half-up rounded value, that is
    // off by one on 8 164 890 of them -- 48.67 per cent.
    // `(num + 127) / 255` is exact on every one of the 16.7 million,
    // and measured (see the header of `fb.mix8`) it is also the FASTER
    // of the two exact forms on this machine -- the division-free
    // variant lost by a fifth.
    // tools/paint/blendcheck.py is the measurement, and it checks all
    // FOUR places this line lives in (kernel/fb.fi, kernel/wm.fi,
    // kernel/user/wlibc.fi, tools/gfx/checkshot.py) against each other.
    let r: u64 = mix8((alt >> 16) & 0xFF, (neu >> 16) & 0xFF, a, ia)
    let g: u64 = mix8((alt >> 8) & 0xFF, (neu >> 8) & 0xFF, a, ia)
    let b: u64 = mix8(alt & 0xFF, neu & 0xFF, a, ia)
    return (r << 16) | (g << 8) | b
}

// One channel.  See the header of `fb.mix8` for why it is written this
// way and what it was measured against.
fn mix8(dst: u64, src: u64, a: u64, ia: u64) -> u64 {
    return (src *% a +% dst *% ia +% 127) / 255
}

// Eine Zeile Text in ein Fenster, mit Kantenglaettung und
// Unterschneidung. `y` ist die GRUNDLINIE, nicht die Oberkante -- das
// ist die Groesse, mit der Schriften rechnen, und die einzige, an der
// zwei Schriftgroessen nebeneinander stehen koennen.
fn text(state: u64, i: u64, f: u64, px: u64, x: i64, y: i64, p: u64,
    n: u64, color: u64) -> i64 {
    if !valid(state, i) || f >= ttf.MAX_FONTS {
        return x
    }
    // RUNDE I18N: EIN DURCHLAUF JE ZEICHEN, NICHT JE OKTETT. Vorher
    // stand hier `kstate.get8(p + k)` und `k = k + 1`; fuer die zwei
    // Oktette eines Umlauts hat das zwei Glyphen gesucht, keine
    // gefunden und zwei Leerraeume gemalt. Die Null bleibt das Ende der
    // Zeichenkette -- ein Nulloktett kommt in gueltigem UTF-8 nur als
    // U+0000 vor, und das ist ohnehin das Ende.
    var cx: i64 = x * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < n {
        let v: u64 = utf8.next(p, n, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = n
        } else {
            let gid: u64 = ttf.glyph_of(state, f, c)
            if vorher != 0 {
                cx = cx + ttf.kern26(state, f, vorher, gid, px)
            }
            let slot: u64 = ttf.glyph(state, f, c, px)
            if slot < ttf.SLOTS {
                draw_glyph(state, i, slot, cx >> 6, y, color)
                cx = cx + ttf.g_adv(state, slot)
            } else {
                cx = cx + ttf.advance26(state, f, gid, px)
            }
            vorher = gid
            k = k + l
        }
    }
    return cx >> 6
}

fn draw_glyph(state: u64, i: u64, slot: u64, x: i64, y: i64, color: u64) {
    draw_glyph_clip(state, i, slot, x, y, color, 0,
        wg(state, i, W_W) as i64)
}

// EINE GLYPHE, AUF EINEN SENKRECHTEN STREIFEN BESCHNITTEN.
//
// Im Terminal ist der Streifen die ZELLE, und das ist keine Feinheit:
// DejaVu Sans Mono hat bei sechzehn Bildpunkten eine Laufweite von
// 9,625, die Zelle ist also zehn breit -- und 'W', 'V' und 'M' sind
// BREITER als zehn. Ohne Beschnitt ragen sie in die naechste Zelle,
// und sobald dort ein Zeichen geschrieben wird, loescht dessen
// Hintergrund die Haelfte des vorigen wieder weg. Gemessen: von 1413
// Tintenpunkten einer Zeile waren 146 falsch, und alle davon standen am
// rechten Rand eines breiten Buchstabens. Mit Beschnitt sind es null,
// und das Bild zeigt, was ein Terminal zeigt.
fn draw_glyph_clip(state: u64, i: u64, slot: u64, x: i64, y: i64,
    color: u64, cx0: i64, cx1: i64) {
    let gw: u64 = ttf.g_w(state, slot)
    let gh: u64 = ttf.g_h(state, slot)
    if gw == 0 || gh == 0 {
        return
    }
    let x0: i64 = x + ttf.g_left(state, slot)
    let y0: i64 = y - ttf.g_top(state, slot)
    var ww: i64 = wg(state, i, W_W) as i64
    let wh: i64 = wg(state, i, W_H) as i64
    var lo: i64 = cx0
    if lo < 0 {
        lo = 0
    }
    if cx1 < ww {
        ww = cx1
    }
    var r: u64 = 0
    while r < gh {
        let py: i64 = y0 + r as i64
        if py >= 0 && py < wh {
            var c: u64 = 0
            while c < gw {
                let pxx: i64 = x0 + c as i64
                if pxx >= lo && pxx < ww {
                    let a: u64 = ttf.g_pixel(state, slot, c, r)
                    if a != 0 {
                        wpixel(state, i, pxx as u64, py as u64,
                            blend(wget(state, i, pxx as u64, py as u64),
                                color, a))
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

// Ein Rechteck aus fremdem Speicher in ein Fenster -- das, was eine
// Anwendung braucht, die selbst malt.
fn blit_in(state: u64, i: u64, src: u64, x: u64, y: u64, w: u64,
    h: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    let ww: u64 = wg(state, i, W_W)
    if x >= ww || y >= wg(state, i, W_H) {
        return 0
    }
    var bw: u64 = w
    var bh: u64 = h
    if x + bw > ww {
        bw = ww - x
    }
    if y + bh > wg(state, i, W_H) {
        bh = wg(state, i, W_H) - y
    }
    var r: u64 = 0
    while r < bh {
        copy_words(wg(state, i, W_BUF) +% (y + r) *% ww *% 4 +% x *% 4,
            src +% r *% w *% 4, bw *% 4 / 8)
        if (bw & 1) != 0 {
            __mmio_write32((wg(state, i, W_BUF) +% (y + r) *% ww *% 4
                +% (x + bw - 1) *% 4) as *mut u32,
                __mmio_read32((src +% r *% w *% 4 +% (bw - 1) *% 4)
                    as *mut u32))
        }
        r = r + 1
    }
    return bw * bh
}

fn flush_win(state: u64, i: u64) {
    if !valid(state, i) {
        return
    }
    damage_win(state, i)
}

// ------------------------------------------------- das Zusammensetzen

// Der Zeiger. Achtzehn Zeilen zu zwoelf Bildpunkten, als zwei
// Bitmasken je Zeile: Umriss und Fuellung. Warum von Hand und nicht als
// Bilddatei: es sind 72 Oktette, und ein Zeiger, der aus einer Datei
// kommt, fehlt genau dann, wenn man ihn zum Suchen des Fehlers braucht.
const CUR_W: u64 = 12
const CUR_H: u64 = 18

// RUNDE HIDPUNKTE: DER ZEIGER IST EIN PFEIL -- ER WAR NUR ZU KLEIN,
// UM EINER ZU SEIN.
//
// Die Bitmaske stimmt; aus einem echten Bildschirmfoto (3440x1440)
// herausgeschnitten ist ein sauberer Pfeil mit durchgehendem Schwanz
// und umlaufendem Rand zu sehen -- er ist dort acht mal fuenfzehn
// Bildpunkte gross. Auf einem 34-Zoll-Ultrawide ist das ein Fleck, und
// genau als "einzelner weisser Fleck" hat Justin ihn beschrieben.
//
// Titelleiste, Rand und Schriftgroesse wachsen seit Runde SCHIRM mit
// `uisc(state)`; der Zeiger war das einzige Stueck Oberflaeche, das es
// nicht tat. Jetzt wird jeder Bildpunkt der Maske zu einem Block von
// `uisc` mal `uisc` -- auf 1280x800 (uisc=1) aendert sich damit KEIN
// einziges Bildpunkt, und das ist die Gegenprobe.
// ============================================ RUNDE ECHTHARDWARE-4
// DIE GROESSE KOMMT AUS `zeiger.fi`, UND SIE IST QUADRATISCH.
//
// Bis hierher war der Zeiger 12 mal 18 Bildpunkte mal Vervielfachung.
// Die neun Formen (Pfeil, Textmarke, Hand, zwei Balken, zwei
// Diagonalen, Kreuz, Sanduhr) passen nicht alle in ein hohes Rechteck
// -- der Doppelpfeil ist breiter als hoch --, also ist das Feld
// quadratisch: 24 Bildpunkte bei Vervielfachung 1, 48 bei 2. Justins
// Vorgabe war "rund 24 bei 1, 48 bei 2", und das ist sie.
fn cur_w(state: u64) -> u64 {
    return cursor.size(uisc(state))
}

fn cur_h(state: u64) -> u64 {
    return cursor.size(uisc(state))
}

// DER GRIFFPUNKT. Die Mausposition ist die SPITZE des Pfeils und die
// MITTE der Textmarke -- ein Zeiger, dessen Griff immer in der linken
// oberen Ecke laege, klickte bei jeder anderen Form daneben. Diese
// beiden Zahlen sagen, um wieviel das Bild gegen die Position versetzt
// gemalt wird, und die Schadensrechnung nimmt dieselben.
fn cur_ox(state: u64) -> u64 {
    return cursor.griff_x(gs(state, S_SHAPE), cur_w(state))
}

fn cur_oy(state: u64) -> u64 {
    return cursor.griff_y(gs(state, S_SHAPE), cur_h(state))
}

fn cursor_row(r: u64, fuell: bool) -> u64 {
    return cursor_row_of(0, r, fuell)
}

// RUNDE K15: ZWEI ZEIGERBILDER STATT EINEM. Der Balken ist mechanisch
// aus dem Pfeil-Verfahren entstanden und nicht von Hand gemalt: die
// Fuellung ist der Balken, der Umriss ist die Fuellung um einen
// Bildpunkt geweitet. Damit ist er ueber JEDEM Untergrund zu sehen --
// derselbe Grund, aus dem der Pfeil einen schwarzen Rand hat.
fn cursor_row_of(form: u64, r: u64, fuell: bool) -> u64 {
    // Bit 11 ist links.
    // ================================= RUNDE BLECH-HID: DER PFEIL WAR KEINER.
    //
    // Justin hat den Zeiger auf echtem Blech fotografiert und
    // vergroessert: ein weisses Dreieck, darunter eine LUECKE, darunter
    // zwei getrennte weisse Stummel. Das war kein Rasterfehler und
    // nichts, was die Maschine getan hat -- es stand so in diesen zwei
    // Zeilen:
    //
    //   innen[11] = 0x0400   EIN einziger gesetzter Bildpunkt; genau
    //                        unter der breitesten Zeile (0x07fc) reisst
    //                        der Pfeil damit ab.
    //   innen[12..16] = 0x0370, 0x01b0, 0x01b0, 0x00d8, 0x00d8
    //                        je ZWEI getrennte Bloecke, und der Umriss
    //                        hat die Luecke dazwischen auch noch
    //                        umrandet (0x0c88).
    //
    // Gemeint war der klassische X11-Zeiger, dessen Schwanz sich in zwei
    // Beine gabelt. Von Hand in Hexadezimalzahlen geschrieben sieht das
    // aus wie ein Pfeil; auf dem Schirm sieht es aus wie Bruchstuecke.
    //
    // DER NEUE PFEIL IST NICHT VON HAND GERECHNET. In
    // `tools/wm/zeiger.py` steht eine Silhouette -- je Zeile GENAU EIN
    // Bereich --, und die Fuellung ist ihre EROSION um einen Bildpunkt
    // in den vier Richtungen; was uebrigbleibt, ist der Rand und ist
    // damit ueberall genau einen Bildpunkt breit. Derselbe Laeufer liest
    // diese zwei Masken zurueck, malt sie als ASCII-Bild und rechnet
    // sechs Zusagen nach: eine zusammenhaengende Flaeche, jeder
    // Fuellpunkt rundherum gedeckt, keine Zeile mit zwei Bloecken, kein
    // allein stehender Punkt, keine Ueberschneidung, und die Spitze auf
    // dem Griffpunkt (0,0).
    //
    //    0 |.           |     10 |.#######..  |
    //    1 |..          |     11 |.######.    |
    //    2 |.#.         |     12 | .#####.    |
    //    3 |.##.        |     13 |  .####.    |
    //    4 |.###.       |     14 |   .###.    |
    //    5 |.####.      |     15 |   .###.    |
    //    6 |.#####.     |     16 |   .###.    |
    //    7 |.######.    |     17 |   .....    |
    //    8 |.#######.   |
    //    9 |.########.  |
    var umriss: [u8; 37] = b"\x08\x00\x0c\x00\x0a\x00\x09\x00\x08\x80\x08\x40\x08\x20\x08\x10\x08\x08\x08\x04\x08\x0c\x08\x10\x04\x10\x02\x10\x01\x10\x01\x10\x01\x10\x01\xf0\x00"
    var innen: [u8; 37] = b"\x00\x00\x00\x00\x04\x00\x06\x00\x07\x00\x07\x80\x07\xc0\x07\xe0\x07\xf0\x07\xf8\x07\xf0\x07\xe0\x03\xe0\x01\xe0\x00\xe0\x00\xe0\x00\xe0\x00\x00\x00"
    var bumriss: [u8; 37] = b"\x03\xfc\x03\xfc\x03\xfc\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x00\xf0\x03\xfc\x03\xfc\x03\xfc\x00"
    var binnen: [u8; 37] = b"\x00\x00\x01\xf8\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x00\x60\x01\xf8\x00\x00\x00"
    if r >= CUR_H {
        return 0
    }
    var p: u64 = 0
    if form == 1 {
        if fuell {
            p = (&binnen[0]) as u64 + r * 2
        } else {
            p = (&bumriss[0]) as u64 + r * 2
        }
    } else {
        if fuell {
            p = (&innen[0]) as u64 + r * 2
        } else {
            p = (&umriss[0]) as u64 + r * 2
        }
    }
    return (kstate.get8(p) << 8) | kstate.get8(p + 1)
}

fn shape(state: u64) -> u64 {
    return gs(state, S_SHAPE)
}

// DIESELBE UMSCHALTUNG, ABER OHNE DEN WUNSCH DER ANWENDUNG ZU
// UEBERSCHREIBEN. Nur der Server ruft das -- fuer die Raender.
fn shape_intern(state: u64, s: u64) {
    if s >= cursor.FORMEN || !ready(state) {
        return
    }
    if gs(state, S_SHAPE) == s {
        return
    }
    ss(state, S_SHAPE, s)
    let mx: i64 = gs(state, S_CURX) as i64
    let my: i64 = gs(state, S_CURY) as i64
    let gw: i64 = cur_w(state) as i64
    damage(state, mx - gw, my - gw, mx + gw, my + gw)
}

// ============================================ RUNDE ECHTHARDWARE-4
// DER ZEIGER SAGT, WAS DER RAND KANN.
//
// Seit ECHTHARDWARE-3 ist der GANZE rechte und untere Rand eines
// Fensters ein Griff zum Groessenaendern (vorher waren es zwoelf
// Bildpunkte in einer Ecke). Ein Griff, den man nicht SIEHT, ist
// trotzdem einer, den man nicht findet -- deshalb wechselt der Zeiger
// dort jetzt die Form, genau wie bei jedem anderen System:
//
//   rechte Kante        Doppelpfeil waagrecht
//   untere Kante        Doppelpfeil senkrecht
//   die Ecke dazwischen Doppelpfeil diagonal NW-SO
//   sonst               was die Anwendung wollte
//
// Waehrend gezogen oder in der Groesse geaendert wird, bleibt die Form
// stehen: der Zeiger laeuft dabei aus dem Randstreifen heraus, und ein
// Zeiger, der mitten im Ziehen die Form wechselt, flackert.
fn margin_cursor(state: u64, i: u64, x: i64, y: i64) {
    if gs(state, S_DRAG) != 0 || gs(state, S_SIZING) != 0 {
        return
    }
    var will: u64 = gs(state, S_SHAPE_APP)
    if i < MAX_WIN && valid(state, i) && deko(state, i) {
        let lx: i64 = x - win_x(state, i) - inx(state, i) as i64
        let ly: i64 = y - win_y(state, i) - iny(state, i) as i64
        let rand: i64 = grip(state) as i64
        let rechts: bool = lx >= wg(state, i, W_W) as i64 - rand
            && lx <= wg(state, i, W_W) as i64
        let unten: bool = ly >= wg(state, i, W_H) as i64 - rand
            && ly <= wg(state, i, W_H) as i64
        if lx >= 0 && ly >= 0 {
            if rechts && unten {
                will = cursor.F_DIAG1
            } else if rechts {
                will = cursor.F_WIDTH
            } else if unten {
                will = cursor.F_HEIGHT
            }
        }
    }
    shape_intern(state, will)
}

// Das Bild wechseln und die STELLE schmutzig machen, an der der Zeiger
// gerade steht -- sonst steht das alte Bild dort, bis sich die Maus
// bewegt.
fn set_shape(state: u64, s: u64) {
    // RUNDE ECHTHARDWARE-4: neun Formen. Hier stand `s > 1`, und
    // damit war jede Form ausser Pfeil und Textmarke unerreichbar --
    // auch dann, wenn ein Programm sie gesetzt haette.
    if s >= cursor.FORMEN || !ready(state) {
        return
    }
    // Der Wunsch wird IMMER vermerkt, auch wenn das Bild gerade
    // ohnehin dieses ist: sonst faellt der Zeiger beim Verlassen des
    // Fensterrandes auf einen veralteten Wunsch zurueck.
    ss(state, S_SHAPE_APP, s)
    if gs(state, S_SHAPE) == s {
        return
    }
    ss(state, S_SHAPE, s)
    let mx: i64 = gs(state, S_CURX) as i64
    let my: i64 = gs(state, S_CURY) as i64
    // Beide Formen schmutzig machen -- die alte steht noch da, und
    // die neue kann groesser sein oder einen anderen Griffpunkt haben.
    // Also das groesste Rechteck: Position minus voller Zeiger, plus
    // voller Zeiger.
    let gw: i64 = cur_w(state) as i64
    damage(state, mx - gw, my - gw, mx + gw, my + gw)
}

// ================== RUNDE VSYNC: BEWEGUNG, BILDGRENZE, SIGNATUR

// Die zugesagte Dauer einer Fensterbewegung. Steht keine Formmarke da,
// gilt MO_FAST -- dieselben 120 ms, die wlib seit DESIGN-2 fuer Hover
// und Menue nimmt. Die Zahl steht hier EINMAL; wer sie aendern will,
// aendert die Formmarke und nicht den Quelltext.
fn motion_ms(state: u64) -> u64 {
    if gs(state, S_FORM + FM_MOTION * 8) == 0 {
        return MOTION_DEF
    }
    return form(state, FM_MOTION)
}

// Sind Bewegungen abgeschaltet? Zwei Wege fuehren dahin, und sie
// bedeuten dasselbe: die Formmarke sagt 0 (das ist "Animationen
// reduzieren"), oder die Gegenprobe `noanim` steht auf der
// Befehlszeile. In beiden Faellen ist eine Bewegung SOFORT FERTIG.
fn anim_off(state: u64) -> bool {
    return gs(state, S_NOANIM) != 0 || motion_ms(state) == 0
}

// ease-out, ganzzahlig: 1-(1-t)^2 in Tausendsteln. Dieselbe Kurve wie
// `wlib.ease(EASE_OUT)` -- absichtlich, damit ein Fenster, das
// aufgeht, und ein Knopf, der hell wird, sich gleich anfuehlen.
// Keine Fliesskommazahl: der Kernel rettet in `syscall` kein SSE.
fn ease_out(t: u64) -> u64 {
    var pp: u64 = t
    if pp > 1000 {
        pp = 1000
    }
    let inv: u64 = 1000 - pp
    return 1000 - inv * inv / 1000
}

// Der Fortschritt einer laufenden Bewegung, 0..1000. Er faellt aus der
// VERGANGENEN ZEIT und nicht aus der Zahl der Bilder: bei TICK_HZ=100
// ist ein Tick 10 ms, und eine Zusage von 120 ms sind zwoelf Ticks --
// aber wenn der Server einmal langsamer ist, springt die Bewegung
// weiter, statt sich zu dehnen.
fn anim_p(state: u64, i: u64) -> u64 {
    let ms: u64 = wg(state, i, W_ANMS)
    if ms == 0 {
        return 1000
    }
    let jetzt: u64 = kstate.get(state, kstate.TICKS)
    let ab: u64 = wg(state, i, W_AN0)
    if jetzt <= ab {
        return 0
    }
    let vergangen: u64 = (jetzt - ab) * MS_PRO_TICK
    if vergangen >= ms {
        return 1000
    }
    return vergangen * 1000 / ms
}

// Eine Bewegung anmelden. `art` ist AN_OPEN, AN_CLOSE oder AN_MIN.
// Ist sie abgeschaltet, wird NICHTS angemeldet -- der Aufrufer sieht
// `false` und macht seinen Endzustand sofort.
fn anim_start(state: u64, i: u64, art: u64) -> bool {
    if !valid(state, i) || anim_off(state) {
        return false
    }
    wsv(state, i, W_ANK, art)
    wsv(state, i, W_AN0, kstate.get(state, kstate.TICKS))
    wsv(state, i, W_ANMS, motion_ms(state))
    wsv(state, i, W_ANP, 0)
    ss(state, S_ANIMS, gs(state, S_ANIMS) + 1)
    damage_win(state, i)
    return true
}

fn anim_laeuft(state: u64, i: u64) -> bool {
    return valid(state, i) && wg(state, i, W_ANK) != 0
}

fn anims(state: u64) -> u64 {
    return gs(state, S_ANIMS)
}

fn anim_frames(state: u64) -> u64 {
    return gs(state, S_ANFRAMES)
}

fn anim_ticks(state: u64) -> u64 {
    return gs(state, S_TICKS)
}

fn set_noanim(state: u64, on: bool) {
    ss(state, S_NOANIM, 0)
    if on {
        ss(state, S_NOANIM, 1)
    }
}

// Der Fortschritt, den `paint_win` gerade sehen soll -- schon durch die
// Kurve gelaufen. Beim Schliessen und Minimieren laeuft er rueckwaerts:
// dieselbe Kurve, gespiegelt, statt einer zweiten.
fn anim_mix(state: u64, i: u64) -> u64 {
    let art: u64 = wg(state, i, W_ANK)
    if art == 0 {
        return 1000
    }
    let e: u64 = ease_out(anim_p(state, i))
    if art == AN_OPEN {
        return e
    }
    return 1000 - e
}

// EIN TICK DER BEWEGUNGEN, und er gehoert in den Zeitgeber und nicht
// ins Zeichnen. Er macht drei Dinge: abgelaufene Bewegungen beenden,
// laufende schmutzig machen (sonst zeichnet `compose` sie nicht), und
// beim Ende einer Schliessbewegung das Fenster WIRKLICH wegnehmen.
// Gibt zurueck, wie viele Bewegungen noch laufen.
fn anim_tick(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    ss(state, S_TICKS, gs(state, S_TICKS) + 1)
    var offen: u64 = 0
    var i: u64 = 0
    while i < MAX_WIN {
        if valid(state, i) && wg(state, i, W_ANK) != 0 {
            let p: u64 = anim_p(state, i)
            let art: u64 = wg(state, i, W_ANK)
            // Der Bereich wird IMMER schmutzig, auch wenn der
            // Fortschritt gleich blieb -- am Ende der Bewegung steht
            // sonst das letzte Zwischenbild auf dem Schirm.
            damage_win(state, i)
            if p >= 1000 {
                wsv(state, i, W_ANK, 0)
                wsv(state, i, W_ANP, 1000)
                // DAS FENSTER GEHT ERST JETZT. Waere es beim Klick
                // verschwunden, haette die Bewegung nichts mehr zu
                // zeigen gehabt -- das ist der ganze Grund, warum
                // Schliessen ueber diesen Umweg laeuft.
                if art == AN_CLOSE {
                    destroy(state, i)
                } else {
                    if art == AN_MIN {
                        set_hidden(state, i, true)
                    }
                }
            } else {
                wsv(state, i, W_ANP, p)
                ss(state, S_ANFRAMES, gs(state, S_ANFRAMES) + 1)
                offen = offen + 1
            }
        }
        i = i + 1
    }
    return offen
}

// ---------------------------------------------------- DIE BILDGRENZE

fn set_vsync(state: u64, on: bool) {
    ss(state, S_VSYNC, 0)
    if on {
        ss(state, S_VSYNC, 1)
    }
}

fn vsync_on(state: u64) -> bool {
    return gs(state, S_VSYNC) != 0
}

fn pxsum(state: u64) -> u64 {
    return gs(state, S_PXSUM)
}

fn presents(state: u64) -> u64 {
    return gs(state, S_PRESENTS)
}

fn skipped(state: u64) -> u64 {
    return gs(state, S_SKIPPED)
}

fn pending(state: u64) -> bool {
    return gs(state, S_PEND) != 0
}

// Das gezeichnete Rechteck vormerken, statt es zu uebertragen. Mehrere
// `compose`-Laeufe zwischen zwei Ticks wachsen so zu EINEM Rechteck
// zusammen, und der Schirm sieht sie zusammen oder gar nicht.
fn pend_add(state: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    if gs(state, S_PEND) == 0 {
        ss(state, S_PX0, x0)
        ss(state, S_PY0, y0)
        ss(state, S_PX1, x1)
        ss(state, S_PY1, y1)
        ss(state, S_PEND, 1)
        return
    }
    if x0 < gs(state, S_PX0) {
        ss(state, S_PX0, x0)
    }
    if y0 < gs(state, S_PY0) {
        ss(state, S_PY0, y0)
    }
    if x1 > gs(state, S_PX1) {
        ss(state, S_PX1, x1)
    }
    if y1 > gs(state, S_PY1) {
        ss(state, S_PY1, y1)
    }
}

// DAS BILD ZEIGEN. Eine Uebertragung, ein Rechteck -- und der Zaehler
// steigt nur, wenn wirklich etwas anlag. Wer das im Takt ruft, hat
// genau die Bildgrenze, die vorher fehlte.
fn present(state: u64) -> u64 {
    if !ready(state) || !fb.ready(state) {
        return 0
    }
    if gs(state, S_PEND) == 0 {
        return 0
    }
    let x0: u64 = gs(state, S_PX0)
    let y0: u64 = gs(state, S_PY0)
    let x1: u64 = gs(state, S_PX1)
    let y1: u64 = gs(state, S_PY1)
    ss(state, S_PEND, 0)
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    // `flush_rect` statt `flush`: nur die Spalten, die wirklich
    // schmutzig waren. `flush` haette die ganze Bildbreite genommen,
    // weil es nur Zeilen kennt.
    // MIT SEITENUMSCHALTUNG MUSS DIE GANZE SEITE STIMMEN, nicht nur
    // das schmutzige Rechteck: gezeigt wird gleich die ANDERE Haelfte,
    // und in der steht das vorletzte Bild. Was seitdem woanders
    // gemalt wurde, fehlte dort. Also die volle Flaeche kopieren --
    // sie ist unsichtbar, solange nicht umgeschaltet ist, und der
    // Preis dafuer steht in docs/VSYNC.md.
    if fb.flip_on(state) {
        fb.flush_rect(state, 0, 0, gs(state, S_SW), gs(state, S_SH))
        fb.flip(state)
    } else {
        fb.flush_rect(state, x0, y0, x1 - x0, y1 - y0)
    }
    ss(state, S_PRESENTS, gs(state, S_PRESENTS) + 1)
    // RUNDE VIRTIOGPU: DIE BILDGRENZE IST HIER UND SONST NIRGENDS.
    // `flushes` zaehlt Uebertragungen, und davon gibt es mehrere je
    // Bild. Wer "Oktette je Bild" ausrechnen will, braucht die Zahl
    // der BILDER -- und ein Bild ist genau ein Durchlauf hier.
    fb.frame_done(state)
    let flaeche: u64 = (x1 - x0) * (y1 - y0)
    ss(state, S_PXSUM, gs(state, S_PXSUM) +% flaeche)
    return flaeche
}

// ------------------------------------------- DER ABLESER (SCANOUT)
//
// WARUM ES DIESEN ABLESER GEBEN MUSS, UND WARUM ER IM KERNEL SITZT.
//
// Die erste Fassung der Zerreissprobe hat von aussen fotografiert und
// die Signaturen im Bild verglichen. Sie fand NIE ein zerrissenes Bild
// -- auch dann nicht, wenn die Bildgrenze ausdruecklich abgeschaltet
// war (`nopresent`) und es also reissen MUSSTE. Der Grund liegt in
// QEMU: `screendump` liest die Bildflaeche in EINEM Zug, waehrend
// niemand schreibt. Ein halb uebertragenes Bild ist darin nicht zu
// sehen. Eine Messung, die auch bei abgeschalteter Zusage gruen
// bleibt, misst nichts -- also war sie zu verwerfen.
//
// Der Ableser stellt dieselbe Frage an der Stelle, an der sie
// beantwortbar ist: er liest den VORDERPUFFER (die Karte), oben und
// unten, GENAU SO, wie ein Bildschirm ihn ausliest -- und er tut es
// waehrend der Server malt. Findet er oben und unten verschiedene
// Signaturen, hat er ein halbes Bild in der Hand.
//
// Das ist keine Nachbildung des Reissens, sondern das Reissen selbst:
// ein Bildschirm, der in diesem Augenblick abgelesen haette, haette
// dasselbe gesehen.
fn set_leser(state: u64, on: bool) {
    ss(state, S_LESER, 0)
    if on {
        ss(state, S_LESER, 1)
    }
}

fn liest(state: u64) -> u64 {
    return gs(state, S_LIEST)
}

fn risse(state: u64) -> u64 {
    return gs(state, S_RISS)
}

fn tear_top(state: u64) -> u64 {
    return gs(state, S_R0)
}

fn tear_bottom(state: u64) -> u64 {
    return gs(state, S_R1)
}

fn without_sig(state: u64) -> u64 {
    return gs(state, S_KEIN)
}

fn riss_y0(state: u64) -> u64 {
    return gs(state, S_RY0)
}

fn riss_y1(state: u64) -> u64 {
    return gs(state, S_RY1)
}

fn riss_frame(state: u64) -> u64 {
    return gs(state, S_RFR)
}

// Wie viele Ablesungen verworfen wurden, weil zwischen ihren beiden
// Punkten umgeschaltet wurde. Sie sind KEIN Riss -- die Zahl steht
// daneben, damit man sieht, wie oft es vorkam.
fn verworfen(state: u64) -> u64 {
    return gs(state, S_VERWORF)
}

// Die drei Zahlen der Vorfuehrung, von `kgui` gelesen und gesetzt.
fn before_t0(state: u64) -> u64 {
    return gs(state, S_VT0)
}

fn set_before_t0(state: u64, v: u64) {
    ss(state, S_VT0, v)
}

fn before_step(state: u64) -> u64 {
    return gs(state, S_VSTEP)
}

fn set_before_step(state: u64, v: u64) {
    ss(state, S_VSTEP, v)
}

fn before_win(state: u64) -> u64 {
    return gs(state, S_VWIN)
}

fn set_before_win(state: u64, v: u64) {
    ss(state, S_VWIN, v)
}

// Welche Farbnummer steht an dieser Stelle? MAX_SIG heisst "keine der
// acht" -- dort steht dann Fensterinhalt oder Hintergrund, und das ist
// kein Widerspruch, sondern nur nichts zu vergleichen.
fn sig_nr(c: u64) -> u64 {
    var k: u64 = 0
    while k < 8 {
        if sig_colour(k) == (c & RGB24) {
            return k
        }
        k = k + 1
    }
    return 8
}

// EINMAL ABLESEN. Er nimmt das oberste sichtbare Fenster, liest dessen
// oberen und unteren Signaturstreifen aus dem VORDERPUFFER und
// vergleicht. Der Aufrufer ruft das dicht -- je dichter, desto eher
// erwischt er die Uebertragung mitten im Lauf.
fn leser_tick(state: u64) {
    if gs(state, S_LESER) == 0 || gs(state, S_SIG) == 0 {
        return
    }
    let i: u64 = top_visible(state)
    if i >= MAX_WIN {
        return
    }
    // NUR AN EINEM FENSTER, DAS SICH GERADE NICHT BEWEGT UND NICHT
    // AUFGEHT. Waehrend einer Oeffnungsbewegung wird die Flaeche
    // skaliert und gemischt gemalt -- die Signaturstreifen liegen dann
    // nicht dort, wo dieser Ableser sie aus `win_x`/`win_y` errechnet,
    // und was er findet, ist wieder eine Aussage ueber die Messung.
    // Dasselbe gilt fuer ein gezogenes Fenster.
    if wg(state, i, W_ANK) != 0 || gs(state, S_DRAG) != 0 {
        return
    }
    let wx: i64 = win_x(state, i)
    let wy: i64 = win_y(state, i)
    let ow: i64 = outer_w(state, i) as i64
    let oh: i64 = outer_h(state, i) as i64
    if ow <= 0 || oh < 2 * SIG_H as i64 || wx < 0 || wy < 0 {
        return
    }
    // DIE STELLE WIRD AUS EINER EINZIGEN ABLESUNG DES ORTES GERECHNET.
    //
    // Der Ableser rechnete sie zuerst bei jeder Ablesung frisch aus
    // `win_x`/`win_y` -- und zwar ZWEIMAL, einmal fuer oben und einmal
    // fuer unten. Waehrend eines Zuges wandert das Fenster dazwischen,
    // und dann las er oben an der neuen und unten an der alten Stelle:
    // zwei Signaturen, die nichts miteinander zu tun hatten. GEMESSEN
    // als 97 Prozent "Risse" bei stehender Bildgrenze, waehrend
    // derselbe Ableser am STEHENDEN Bild null fand. Der Fehler lag in
    // der Messung.
    //
    // Eine feste Stelle war die naechste Fassung und auch falsch: das
    // Fenster wandert unter ihr weg, und dann misst sie Hintergrund
    // (gemessen: 1 165 276 Ablesungen ohne Signatur von 1 210 449).
    //
    // Richtig ist: den Ort EINMAL lesen und BEIDE Punkte daraus
    // rechnen. Bewegt sich das Fenster danach, gehoert die Ablesung
    // eben zum vorigen Ort -- aber zu EINEM Ort, und genau darauf
    // kommt es an.
    let x: u64 = (wx + ow / 2) as u64
    let y0: u64 = (wy + 1) as u64
    let y1: u64 = (wy + oh - 2) as u64
    // BEIDE PUNKTE AUS DERSELBEN BILDSEITE, in einem Zug. Zwei
    // getrennte Ablesungen haetten den Seitenwechsel dazwischen
    // erwischt und einen Riss gemeldet, den es nicht gab -- siehe
    // `fb.front_paar`.
    let puffer: u64 = state + kstate.WM_OFF + S_LPAAR
    // BIS ZU DREI VERSUCHE. `front_paar` sagt `false`, wenn zwischen
    // den beiden Punkten die Bildseite gewechselt wurde -- dann hat die
    // Ablesung KEINE Aussage (siehe die Begruendung dort). Ein neuer
    // Versuch trifft die naechste ruhige Spanne; klappt es dreimal
    // nicht, wird gar nichts gezaehlt. Eine verworfene Ablesung ist
    // KEIN Riss, und sie als einen zu zaehlen waere die eine Zahl, auf
    // die sich diese Runde nicht verlassen duerfte.
    var versuch: u64 = 0
    var gut: bool = false
    while versuch < 3 && !gut {
        gut = fb.front_paar(state, x, y0, y1, puffer)
        versuch = versuch + 1
    }
    if !gut {
        ss(state, S_VERWORF, gs(state, S_VERWORF) + 1)
        return
    }
    let a: u64 = kstate.get(state, kstate.WM_OFF + S_LPAAR)
    let b: u64 = kstate.get(state, kstate.WM_OFF + S_LPAAR + 8)
    let ka: u64 = sig_nr(a)
    let kb: u64 = sig_nr(b)
    ss(state, S_LIEST, gs(state, S_LIEST) + 1)
    // Nur wenn BEIDE eine Signatur tragen, ist die Frage gestellt.
    // Steht an einer Stelle Fensterinhalt, wurde dort gerade nichts
    // uebertragen -- das ist kein Riss.
    if ka < 8 && kb < 8 && ka != kb {
        ss(state, S_RISS, gs(state, S_RISS) + 1)
        // Die ERSTE Beobachtung festhalten: welche zwei Signaturen,
        // an welchen Zeilen. Ohne sie ist "es reisst" eine Zahl ohne
        // Anhalt, und die Suche nach dem Grund faengt bei null an.
        if gs(state, S_R0) == 0 {
            ss(state, S_R0, ka + 1)
            ss(state, S_R1, kb + 1)
            // Und WO es passiert ist: die Zeilen und die Bildnummer.
            // Ohne sie bleibt "es reisst noch ein bisschen" eine Zahl
            // ohne Anhalt.
            ss(state, S_RY0, y0)
            ss(state, S_RY1, y1)
            ss(state, S_RFR, gs(state, S_FRAME))
        }
    }
    if ka >= 8 || kb >= 8 {
        ss(state, S_KEIN, gs(state, S_KEIN) + 1)
    }
}

// ---------------------------------------------------- DIE SIGNATUR

fn set_sig(state: u64, on: bool) {
    ss(state, S_SIG, 0)
    if on {
        ss(state, S_SIG, 1)
    }
}

fn sig_on(state: u64) -> bool {
    return gs(state, S_SIG) != 0
}

fn frame_no(state: u64) -> u64 {
    return gs(state, S_FRAME)
}

// Die Farbe einer Bildnummer. Acht gut unterscheidbare Volltoene --
// keine Rechnung mit kleinen Unterschieden, denn ein Foto wird
// maschinell gelesen und ein Unterschied von eins waere keiner.
fn sig_colour(n: u64) -> u64 {
    let k: u64 = n & 7
    if k == 0 {
        return 0xFF0000
    }
    if k == 1 {
        return 0x00FF00
    }
    if k == 2 {
        return 0x0000FF
    }
    if k == 3 {
        return 0xFFFF00
    }
    if k == 4 {
        return 0xFF00FF
    }
    if k == 5 {
        return 0x00FFFF
    }
    if k == 6 {
        return 0xFF8000
    }
    return 0xFFFFFF
}

// DIE ZERREISSPROBE, und warum sie so und nicht anders aussieht.
//
// Reissen ist unter QEMU nicht zu sehen: `screendump` liest die
// Bildflaeche, nachdem der Bildaufbau fertig ist, und ein halb
// uebertragenes Bild sieht dabei aus wie ein ganzes. Also wird die
// Frage umgestellt. Jedes Bild traegt eine Nummer; im Signaturbetrieb
// malt der Server einen Streifen dieser Farbe an den OBEREN und einen
// an den UNTEREN Rand jedes Fensters. Beide Streifen entstehen im
// SELBEN `compose`-Lauf und tragen deshalb dieselbe Farbe.
//
// Wird nun mitten in der Uebertragung abgelesen, steht oben noch das
// alte und unten schon das neue Bild -- ZWEI Farben in einem Fenster.
// Das ist Reissen, und ein Programm kann es zaehlen. Steht die
// Bildgrenze, MUSS jedes Foto in jedem Fenster genau eine Farbe zeigen.
fn paint_sig(state: u64, i: u64, cx0: i64, cy0: i64, cx1: i64,
    cy1: i64) {
    if gs(state, S_SIG) == 0 {
        return
    }
    let farbe: u64 = sig_colour(gs(state, S_FRAME))
    let wx: i64 = win_x(state, i)
    let wy: i64 = win_y(state, i)
    let ow: i64 = outer_w(state, i) as i64
    let oh: i64 = outer_h(state, i) as i64
    if oh < 2 * SIG_H as i64 {
        return
    }
    fill_clip(state, wx, wy, ow, SIG_H as i64, farbe, cx0, cy0, cx1, cy1)
    fill_clip(state, wx, wy + oh - SIG_H as i64, ow, SIG_H as i64, farbe,
        cx0, cy0, cx1, cy1)
}

// Eine Bildzeile des zusammengesetzten Bildes. Der Hintergrund, dann
// von unten nach oben jedes Fenster, das diese Stelle beruehrt.
fn compose(state: u64) -> u64 {
    if !ready(state) || !fb.ready(state) {
        return 0
    }
    if gs(state, S_DON) == 0 {
        return 0
    }
    let x0: u64 = gs(state, S_DX0)
    let y0: u64 = gs(state, S_DY0)
    let x1: u64 = gs(state, S_DX1)
    let y1: u64 = gs(state, S_DY1)
    ss(state, S_DON, 0)
    if x1 <= x0 || y1 <= y0 {
        return 0
    }
    // RUNDE VSYNC: DIE BILDNUMMER STEIGT HIER und nicht beim
    // Uebertragen. Alles, was in diesem Lauf gemalt wird, gehoert zu
    // EINEM Bild und traegt dieselbe Signatur.
    ss(state, S_FRAME, gs(state, S_FRAME) + 1)
    // RUNDE VEKTOR: die Uhr fuer dieses Bild.
    let t_anfang: u64 = time.tsc()
    // 1. der Hintergrund
    fb.fill(state, x0, y0, x1 - x0, y1 - y0, gs(state, S_DESK))
    // 1b. die Reiter- und Stapelzeilen des Baumes. Sie liegen UNTER den
    //     Fenstern und ueberschneiden sie nicht -- der Baum hat ihre
    //     Hoehe von der Flaeche der Kinder abgezogen.
    if gs(state, S_TILE) != 0 {
        paint_bars(state, x0, y0, x1, y1)
    }
    // 2. die Fenster, von unten nach oben
    var z: u64 = 0
    while z < gs(state, S_COUNT) {
        let i: u64 = at_z(state, z)
        // RUNDE DESKTOP: ein minimiertes Fenster wird uebergangen. Es
        // ist der einzige Unterschied zwischen "minimiert" und
        // "geschlossen", den das Zusammensetzen sieht.
        // RUNDE TILING: und ein Fenster, das hinter einem Reiter liegt,
        // ebenfalls. Zwei Gruende, nicht zu malen, ZWEI Bits -- die
        // Runde TILING hatte dafuer ein eigenes Wort, aber "minimiert"
        // und "hinter einem Reiter" muessen sich getrennt aufheben
        // lassen.
        // RUNDE ALLTAG: WAEHREND DER SPERRE WIRD NUR DER SPERRER
        // GEMALT. Eine Ebene ueber allem waere zu wenig: der Starter
        // liegt auch oben, und im ersten Anlauf stand er im Bild des
        // Sperrbildschirms. Was nicht dem Sperrer gehoert, ist waehrend
        // der Sperre nicht auf dem Schirm -- und der Inhalt eines
        // fremden Fensters ist damit auch nicht ablesbar.
        if i < MAX_WIN && (wg(state, i, W_FLAGS) & (F_HIDDEN | F_TABBED)) == 0
            && darf(state, i) {
            paint_win(state, i, x0, y0, x1, y1)
        }
        z = z + 1
    }
    // 2a. RUNDE VSYNC: die Signatur der Zerreissprobe, ueber der
    //     Fensterflaeche und unter allem, was darueber liegt. Sie wird
    //     je Fenster gemalt, damit ein Foto sie JE FENSTER vergleichen
    //     kann -- ein Streifen quer ueber den Schirm haette nicht
    //     gezeigt, welches Fenster zerrissen ist.
    if gs(state, S_SIG) != 0 {
        var zs: u64 = 0
        while zs < gs(state, S_COUNT) {
            let si: u64 = at_z(state, zs)
            if si < MAX_WIN
                && (wg(state, si, W_FLAGS) & (F_HIDDEN | F_TABBED)) == 0 {
                paint_sig(state, si, x0 as i64, y0 as i64, x1 as i64,
                    y1 as i64)
            }
            zs = zs + 1
        }
    }
    // 2b. das Vorschaurechteck beim Ziehen -- ueber den Fenstern, unter
    //     dem Zeiger.
    if gs(state, S_PVON) != 0 {
        paint_preview(state, x0, y0, x1, y1)
    }
    // 3. der Zeiger, ganz oben
    if gs(state, S_CURON) != 0 {
        paint_cursor(state, x0, y0, x1, y1)
    }
    // RUNDE VSYNC: DIE WEICHE. Mit Bildgrenze wird das Rechteck nur
    // VORGEMERKT -- `present` uebertraegt es im Takt, und zwar als
    // Ganzes. Ohne (die Gegenprobe `nopresent`) geht es den alten Weg
    // und wird sofort geschoben; dann MUSS die Zerreissprobe wieder
    // gemischte Signaturen finden.
    if gs(state, S_VSYNC) != 0 {
        pend_add(state, x0, y0, x1, y1)
        ss(state, S_SKIPPED, gs(state, S_SKIPPED) + 1)
    } else {
        fb.dirty(state, y0, y1)
        fb.flush(state)
    }
    ss(state, S_COMPOSITES, gs(state, S_COMPOSITES) + 1)
    ss(state, S_PIXELS, gs(state, S_PIXELS) + (x1 - x0) * (y1 - y0))
    // RUNDE VEKTOR: die Bildzeit. `khz` ist die Zyklenzahl je
    // Millisekunde; geteilt durch 1000 sind es die je Mikrosekunde.
    // Ist die Uhr noch nicht geeicht (khz == 0), wird nichts gezaehlt
    // -- eine Division durch null waere hier ein Absturz im Bildtakt.
    let kh: u64 = time.khz(state)
    if kh >= 1000 {
        let t_ende: u64 = time.tsc()
        // Als Subtraktion auf der Seite, die gross genug ist: der
        // Zyklenzaehler kann zwischen zwei Ablesungen nicht kleiner
        // werden, aber ein Weltwechsel in eine Gastmaschine kann ihn
        // zuruecksetzen. Dann wird dieses eine Bild nicht gezaehlt.
        if t_ende > t_anfang {
            let us: u64 = (t_ende - t_anfang) / (kh / 1000)
            ss(state, S_FRUS, gs(state, S_FRUS) + us)
            ss(state, S_FRN, gs(state, S_FRN) + 1)
            ss(state, S_FRLAST, us)
            if us > gs(state, S_FRMAX) {
                ss(state, S_FRMAX, us)
            }
            if us > 16000 {
                ss(state, S_FRUEBER, gs(state, S_FRUEBER) + 1)
            }
            // Das Fach: die Verdoppelung, in der diese Zeit liegt.
            var fach: u64 = 0
            var g: u64 = 1000
            while fach < 7 && us >= g {
                g = g * 2
                fach = fach + 1
            }
            ss(state, S_FRH + fach * 8, gs(state, S_FRH + fach * 8) + 1)
            // Und dasselbe noch einmal, aber erst ab dem elften Bild.
            if gs(state, S_FRN) > 10 {
                if us > gs(state, S_FRMAXW) {
                    ss(state, S_FRMAXW, us)
                }
                if us > 16000 {
                    ss(state, S_FRUEBERW, gs(state, S_FRUEBERW) + 1)
                }
            }
        }
    }
    return (x1 - x0) * (y1 - y0)
}

// ------------------------------------------- RUNDE VEKTOR: DIE BILDZEIT
//
// Fuenf Ableser, damit die Abnahme die Zahlen holen kann, ohne die
// Offsets zu kennen.

fn frame_us_sum(state: u64) -> u64 {
    return gs(state, S_FRUS)
}

fn frame_us_n(state: u64) -> u64 {
    return gs(state, S_FRN)
}

fn frame_us_max(state: u64) -> u64 {
    return gs(state, S_FRMAX)
}

fn frame_us_last(state: u64) -> u64 {
    return gs(state, S_FRLAST)
}

fn frame_ueber16(state: u64) -> u64 {
    return gs(state, S_FRUEBER)
}

// Ein Fach des Histogramms, 0..7.
fn frame_fach(state: u64, i: u64) -> u64 {
    if i > 7 {
        return 0
    }
    return gs(state, S_FRH + i * 8)
}

// Der Betrieb, also ohne die ersten zehn Bilder.
fn frame_us_maxw(state: u64) -> u64 {
    return gs(state, S_FRMAXW)
}

fn frame_ueber16w(state: u64) -> u64 {
    return gs(state, S_FRUEBERW)
}

// WIE VIELE TASTEN BEI DIESEM FENSTER ANGEKOMMEN SIND. Die Zahl ist die
// Gegenprobe zum Eingabefokus: mit Fokus MUSS sie beim unbeteiligten
// Fenster null sein, mit `nofocus` MUSS sie es nicht sein. Ohne diese
// zwei Zahlen waere "die Taste geht an das richtige Fenster" eine
// Behauptung ueber etwas, das man im Bild nicht sieht.
fn win_keys(state: u64, i: u64) -> u64 {
    if i >= MAX_WIN {
        return 0
    }
    return wg(state, i, W_KEYS)
}

fn downs(state: u64) -> u64 {
    return gs(state, S_DOWNS)
}

fn moves_seen(state: u64) -> u64 {
    return gs(state, S_MOVES)
}

fn hits_seen(state: u64) -> u64 {
    return gs(state, S_HITS)
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

// Ein Fenster in den schmutzigen Bereich. Rahmen, Titelleiste,
// Schliessfeld, Groessengriff -- und dann die Flaeche der Anwendung.
// RUNDE VSYNC: EIN FENSTER IN BEWEGUNG, und warum es NICHT der
// gewoehnliche Weg mit anderen Zahlen ist.
//
// Beim Oeffnen und Schliessen soll das Fenster skalieren UND
// durchscheinen. Skalieren heisst: die Fensterflaeche (`W_BUF`) wird
// beim Uebertragen abgetastet, nicht Zeile fuer Zeile kopiert.
// Durchscheinen heisst: jeder Bildpunkt wird mit dem gemischt, was
// schon dasteht. Beides zusammen geht nur, wenn man an die Flaeche VOR
// dem Uebertragen herankommt -- genau das, was DESIGN-2 in wlib
// vermisst hat und was hier, im Server, selbstverstaendlich ist.
//
// Der Rahmen wird dabei NICHT mitgemalt: ein Rahmen, der mitskaliert,
// hat an jeder Kante eine andere Strichstaerke und sieht nach Fehler
// aus. Gemalt wird die Flaeche, mittig um denselben Punkt, um den auch
// das fertige Fenster steht.
fn paint_win_anim(state: u64, i: u64, cx0: i64, cy0: i64, cx1: i64,
    cy1: i64) {
    let p: u64 = anim_mix(state, i)
    // Die Groesse laeuft von AN_SCALE0 nach 1000, die Deckung von 0
    // nach 255. Beide aus DEMSELBEN p -- zwei Kurven waeren zwei
    // Bewegungen, die nur zufaellig zusammen enden.
    let sk: u64 = AN_SCALE0 + (1000 - AN_SCALE0) * p / 1000
    let a: u64 = 255 * p / 1000
    if a == 0 {
        return
    }
    let bw: i64 = wg(state, i, W_W) as i64
    let bh: i64 = wg(state, i, W_H) as i64
    if bw <= 0 || bh <= 0 {
        return
    }
    // Die verkleinerte Flaeche, mittig zur gewachsenen.
    let nw: i64 = bw * sk as i64 / 1000
    let nh: i64 = bh * sk as i64 / 1000
    if nw <= 0 || nh <= 0 {
        return
    }
    let ix: i64 = win_x(state, i) + border(state) as i64
    let iy: i64 = win_y(state, i) + title_h(state) as i64
    let ox: i64 = ix + (bw - nw) / 2
    let oy: i64 = iy + (bh - nh) / 2
    let ax0: i64 = imax(ox, cx0)
    let ay0: i64 = imax(oy, cy0)
    let ax1: i64 = imin(ox + nw, cx1)
    let ay1: i64 = imin(oy + nh, cy1)
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    let buf: u64 = wg(state, i, W_BUF)
    let stride: u64 = wg(state, i, W_W)
    var y: i64 = ay0
    while y < ay1 {
        // Die Quellzeile: Nachbarabtastung. Ein gewichtetes Mittel
        // waere schoener und kostet bei zwoelf Zwischenbildern mehr,
        // als es zeigt -- die Bewegung dauert 120 ms.
        let sy: i64 = (y - oy) * bh / nh
        if sy >= 0 && sy < bh {
            var x: i64 = ax0
            while x < ax1 {
                let sx: i64 = (x - ox) * bw / nw
                if sx >= 0 && sx < bw {
                    let zeile: u64 = (sy as u64) *% stride *% 4
                    let q: u64 = buf +% zeile +% (sx as u64) *% 4
                    let c: u64 = __mmio_read32(q as *mut u32) as u64
                    fb.pixel_a(state, x as u64, y as u64, c & RGB24, a)
                }
                x = x + 1
            }
        }
        y = y + 1
    }
    wsv(state, i, W_PAINTS, wg(state, i, W_PAINTS) + 1)
    wsv(state, i, W_PX,
        wg(state, i, W_PX) + ((ax1 - ax0) * (ay1 - ay0)) as u64)
}

fn paint_win(state: u64, i: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let wx: i64 = win_x(state, i)
    let wy: i64 = win_y(state, i)
    let ow: i64 = outer_w(state, i) as i64
    let oh: i64 = outer_h(state, i) as i64
    let ax0: i64 = imax(wx, cx0 as i64)
    let ay0: i64 = imax(wy, cy0 as i64)
    let ax1: i64 = imin(wx + ow, cx1 as i64)
    let ay1: i64 = imin(wy + oh, cy1 as i64)
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    // RUNDE VSYNC: laeuft eine Oeffnungs- oder Schliessbewegung, wird
    // das Fenster ANDERS gemalt -- skaliert und durchscheinend -- und
    // der gewoehnliche Weg entfaellt vollstaendig.
    if wg(state, i, W_ANK) != 0 {
        paint_win_anim(state, i, cx0 as i64, cy0 as i64, cx1 as i64,
            cy1 as i64)
        return
    }
    // RUNDE MESSTAFEL: AB HIER WIRD GEMALT. Der Zaehler steht vor der
    // Verzweigung nach `deko`, weil beide Zweige malen -- ein Zaehler je
    // Zweig waere zweimal dieselbe Aussage mit doppelter Fehlerquelle.
    wsv(state, i, W_PAINTS, wg(state, i, W_PAINTS) + 1)
    wsv(state, i, W_PX,
        wg(state, i, W_PX) + ((ax1 - ax0) * (ay1 - ay0)) as u64)
    // OHNE SCHMUCK: kein Rahmen, keine Titelleiste, kein Schliessfeld.
    // Die Flaeche der Anwendung faengt am aeusseren Rechteck an, und der
    // ganze Rest dieser Funktion entfaellt. Ein Schreibtisch mit
    // Titelleiste waere keiner.
    if !deko(state, i) {
        let bx0: i64 = imax(wx, cx0 as i64)
        let by0: i64 = imax(wy, cy0 as i64)
        let bx1: i64 = imin(wx + wg(state, i, W_W) as i64, cx1 as i64)
        let by1: i64 = imin(wy + wg(state, i, W_H) as i64, cy1 as i64)
        if bx1 <= bx0 || by1 <= by0 {
            return
        }
        let bw: u64 = wg(state, i, W_W)
        let bq: u64 = wg(state, i, W_BUF)
        let bn: u64 = (bx1 - bx0) as u64
        var br: i64 = by0
        while br < by1 {
            fb_row(state, bx0 as u64, br as u64,
                bq +% (br - wy) as u64 *% bw *% 4
                +% (bx0 - wx) as u64 *% 4, bn)
            br = br + 1
        }
        ss(state, S_BLITS, gs(state, S_BLITS) + 1)
        return
    }
    let aktiv: bool = focus(state) == i
    var rahmen: u64 = deco(state, DK_FRAME)
    var titel: u64 = deco(state, DK_TITLE)
    var schrift: u64 = deco(state, DK_TEXT)
    if aktiv {
        rahmen = deco(state, DK_FRAME_ON)
        titel = deco(state, DK_TITLE_ON)
        schrift = deco(state, DK_TEXT_ON)
    }
    // RUNDE PAINT: DER SCHATTEN ZUERST. Er liegt unter dem Fenster und
    // ueber allem, was schon gemalt ist -- also genau hier, vor der
    // ersten Fuellung des Rahmens und nach allen tieferen Fenstern.
    paint_shadow(state, i, cx0 as i64, cy0 as i64, cx1 as i64, cy1 as i64)
    // Der ganze Aussenbereich in Rahmenfarbe, danach die Leiste und die
    // Flaeche darueber. Das ist ein Rechteck mehr als noetig und spart
    // vier Sonderfaelle an den Ecken.
    //
    // RUNDE PAINT: mit `radius_window` als runde Flaeche. Bei Radius 0
    // ist `fill_round` Aufruf fuer Aufruf das alte `fb.fill` auf dem
    // beschnittenen Rechteck -- `shape=classic` malt bildpunktgleich
    // weiter, und tools/look/run.sh misst das.
    fill_round(state, wx, wy, ow, oh, form(state, FM_RADIUS), rahmen,
        cx0 as i64, cy0 as i64, cx1 as i64, cy1 as i64)
    // die Titelleiste
    //
    // RUNDE SOFTUI: SIE IST NICHT MEHR EIN RECHTECK IN EINER FARBE.
    // Zwei Dinge sind dazugekommen, und beide kosten etwas, das in
    // docs/ROUNDSOFTUI.md steht: die oberen Ecken folgen dem
    // Fensterradius (sonst schneidet eine eckige Leiste die runde Ecke
    // ab, die `fill_round` gerade gemalt hat), und ueber die Hoehe
    // laeuft ein Verlauf von wenigen Helligkeitsstufen.
    paint_title(state, i, wx, wy, ow, titel, schrift, ax0, ay0, ax1, ay1)
    // ------------------------------- die Schaltflaechen rechts oben
    //
    // ZWEI FASSUNGEN, UND DIE ALTE BLEIBT WORTGLEICH STEHEN. `classic`
    // schickt FM_CAPTION = 0 und bekommt das rote Schliessfeld mit dem
    // Kreuz, das dieser Server seit Runde K10 malt -- dieselben
    // Koordinaten, dieselbe Schleife. `modern` schickt 1 und bekommt
    // die drei Windows-Schaltflaechen: Strich, Quadrat, Kreuz.
    var bx: i64 = wx + ow - border(state) as i64 - close_w(state) as i64 - 3
    if form(state, FM_CAPTION) != 0 {
        bx = wx + ow - border(state) as i64 - (CAP_N * cap_w(state)) as i64
        paint_caption(state, i, wx, wy, ow, titel, schrift,
            ax0, ay0, ax1, ay1)
    } else {
        let by: i64 = wy + 4
        if bx + close_w(state) as i64 > ax0 && bx < ax1
            && by + close_w(state) as i64 > ay0 {
            let rot: u64 = deco(state, DK_CLOSE)
            fb.fill(state, bx as u64, by as u64, close_w(state), close_w(state), rot)
            let weiss: u64 = deco(state, DK_CLOSE_MARK)
            var k: u64 = 3
            while k < close_w(state) - 3 {
                fb.pixel(state, (bx + k as i64) as u64,
                    (by + k as i64) as u64, weiss)
                fb.pixel(state, (bx + k as i64) as u64,
                    (by + (close_w(state) - 1 - k) as i64) as u64, weiss)
                k = k + 1
            }
        }
    }
    // ===================================== RUNDE NETVIEW, NACHTRAG
    //
    // DAS ZEICHEN AM FENSTER SELBST. Die Taskleiste hat es am Knopf;
    // hier steht es am Fenster, weil ein Fenster auch dann sichtbar ist,
    // wenn die Leiste verdeckt, weggeschoben oder ausgeblendet ist --
    // und weil der Satz dieser Runde lautet, dass der Mensch es SEHEN
    // koennen muss.
    //
    // `real` bekommt keines. Ein Zeichen an jedem Fenster waere ein
    // Bildschirm voller Zeichen ohne Aussage.
    var before: i64 = 0
    let sicht: u64 = netview.view_of(state, win_owner(state, i))
    if sicht != netview.V_REAL && sicht <= 3 {
        title_mark(state, sicht - 1, wx + border(state) as i64 + title_pad(state) as i64,
            wy + border(state) as i64
                + ((title_h(state) - border(state) - netmark.H) / 2) as i64,
            schrift, ax0, ay0, ax1, ay1)
        before = netmark.W as i64 + 4
    }
    // der Titel
    let f: u64 = gs(state, S_FONT_UI)
    if f < ttf.MAX_FONTS {
        title_text(state, i, f, wx + border(state) as i64 + title_pad(state) as i64 + before,
            wy + border(state) as i64 + ttf.ascent(state, f, gs(state, S_PX_UI)),
            schrift, ax0, ay0, ax1, ay1, bx)
    }
    // die Flaeche der Anwendung
    let px0: i64 = wx + border(state) as i64
    let py0: i64 = wy + title_h(state) as i64
    let sx0: i64 = imax(px0, ax0)
    let sy0: i64 = imax(py0, ay0)
    let sx1: i64 = imin(px0 + wg(state, i, W_W) as i64, ax1)
    let sy1: i64 = imin(py0 + wg(state, i, W_H) as i64, ay1)
    if sx1 <= sx0 || sy1 <= sy0 {
        return
    }
    let ww: u64 = wg(state, i, W_W)
    let quelle: u64 = wg(state, i, W_BUF)
    let n: u64 = (sx1 - sx0) as u64
    var r: i64 = sy0
    while r < sy1 {
        let zeile: u64 = (r - py0) as u64
        let spalte: u64 = (sx0 - px0) as u64
        fb_row(state, sx0 as u64, r as u64,
            quelle +% zeile *% ww *% 4 +% spalte *% 4, n)
        r = r + 1
    }
    ss(state, S_BLITS, gs(state, S_BLITS) + 1)
}

// =====================================================================
// RUNDE SOFTUI: DIE TITELLEISTE
// =====================================================================
//
// DER VERLAUF, UND WARUM ER NACH UNTEN HELLER WIRD UND NICHT NACH OBEN.
//
// Justin wollte "dezente Verlaeufe statt Volltonfarbe, nur wenige
// Farbstufen". Die erste Fassung hat den Verlauf VON DER SCHRIFT WEG
// laufen lassen, damit er den Kontrast nie senken kann. Das Bild hat
// die Regel widerlegt: im hellen Schema ist die Titelleiste #ffffff,
// von Weiss aus gibt es kein Heller, und die Leiste kam VOLLKOMMEN FLACH
// heraus -- alle neunzehn Zeilen 255,255,255, nachgemessen. Eine Regel,
// die auf der Haelfte aller Themen nichts tut, ist keine.
//
// Also die andere Richtung, und sie ist auch die richtigere: DIE
// OBERSTE ZEILE IST DIE DUNKELSTE, die unterste traegt die Farbe des
// Themas unveraendert. Das ist ein weicher Eigenschatten an der
// Oberkante, also genau das, was eine gerundete Kante mit Licht von
// oben macht. Nach unten gibt es IMMER Platz (ausser bei Schwarz), und
// wo es ihn nicht gibt, nimmt `grad_room` nur so viel, wie da ist --
// kein Kanal darf anschlagen, sonst kippt der Farbton ins Blaue.
//
// UND DER KONTRAST. Auf hellem Grund mit dunkler Schrift senkt das
// Abdunkeln den Kontrast ein wenig (17,85 auf 17,04 gemessen fuer
// #0f172a auf #ffffff), auf dunklem Grund mit heller Schrift HEBT es
// ihn. Beide Werte liegen weit ueber dem kleinsten Paar des Systems --
// die Titelleiste ist nirgends das bindende Paar --, und
// tools/softui/kontrast.py misst es aus dem Bild statt es zu glauben.
fn lum3(c: u64) -> u64 {
    return ((c >> 16) & 255) + ((c >> 8) & 255) + (c & 255)
}

// Eine Farbe um `d` Stufen je Kanal aufhellen oder abdunkeln, mit
// Anschlag. Kein Mischen mit Weiss -- das verschoebe den Farbton.
fn shade24(c: u64, d: u64, auf: bool) -> u64 {
    var r: u64 = (c >> 16) & 255
    var g: u64 = (c >> 8) & 255
    var b: u64 = c & 255
    if auf {
        r = r + d
        g = g + d
        b = b + d
        if r > 255 {
            r = 255
        }
        if g > 255 {
            g = 255
        }
        if b > 255 {
            b = 255
        }
    } else {
        if r > d {
            r = r - d
        } else {
            r = 0
        }
        if g > d {
            g = g - d
        } else {
            g = 0
        }
        if b > d {
            b = b - d
        } else {
            b = 0
        }
    }
    return (r << 16) | (g << 8) | b
}

// Zwei Farben mischen, `per` Hundertstel von `b`.
fn mix24(a: u64, b: u64, per: u64) -> u64 {
    let r: u64 = (((a >> 16) & 255) * (100 - per) + ((b >> 16) & 255) * per)
        / 100
    let g: u64 = (((a >> 8) & 255) * (100 - per) + ((b >> 8) & 255) * per)
        / 100
    let bl: u64 = ((a & 255) * (100 - per) + (b & 255) * per) / 100
    return (r << 16) | (g << 8) | bl
}

fn paint_title(state: u64, i: u64, wx: i64, wy: i64, ow: i64, titel: u64,
    schrift: u64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let x0: i64 = wx + border(state) as i64
    let y0: i64 = wy + border(state) as i64
    let tw: i64 = ow - 2 * border(state) as i64
    let th: i64 = title_h(state) as i64 - 1 - border(state) as i64
    if tw <= 0 || th <= 0 {
        return
    }
    // Der Radius der Leiste ist der des Fensters, um den Rand nach
    // innen gerueckt -- so bleibt die Kurve der Leiste zur Kurve des
    // Rahmens gleichmittig statt sie zu schneiden.
    var tr: u64 = 0
    let rw: u64 = form(state, FM_RADIUS)
    if rw > border(state) {
        tr = rw - border(state)
    }
    if tr as i64 > th {
        tr = th as u64
    }
    let grad: u64 = form(state, FM_GRAD)
    if grad == 0 {
        // Volltonfarbe: EIN Aufruf, wie vor dieser Runde -- nur mit
        // runden oberen Ecken, wenn der Radius es sagt.
        fill_round(state, x0, y0, tw, th, tr, titel, ax0, ay0, ax1, ay1)
        if tr != 0 {
            fill_clip(state, x0, y0 + tr as i64, tw, th - tr as i64,
                titel, ax0, ay0, ax1, ay1)
        }
        return
    }
    // MIT VERLAUF. Die gerundeten obersten Zeilen tragen die
    // Endfarbe des Verlaufs in EINEM `fill_round` -- so bleibt die
    // Kantenglaettung der Ecke richtig gefaerbt --, und darunter
    // laeuft je eine Zeile.
    let grund: u64 = deco_title(state, i)
    let d: u64 = grad_room(grund, grad)
    if d == 0 {
        fill_round(state, x0, y0, tw, th, tr, titel, ax0, ay0, ax1, ay1)
        if tr != 0 {
            fill_clip(state, x0, y0 + tr as i64, tw, th - tr as i64,
                titel, ax0, ay0, ax1, ay1)
        }
        return
    }
    let oben: u64 = rgb24(state, shade24(grund, d, false))
    fill_round(state, x0, y0, tw, th, tr, oben, ax0, ay0, ax1, ay1)
    var j: i64 = tr as i64
    while j < th {
        // linear von `oben` zurueck auf die Grundfarbe
        let rest: u64 = d * (th - 1 - j) as u64 / (th - 1) as u64
        let c: u64 = rgb24(state, shade24(grund, rest, false))
        fill_clip(state, x0, y0 + j, tw, 1, c, ax0, ay0, ax1, ay1)
        j = j + 1
    }
}

// Wieviel Verlauf die Farbe TRAEGT. Der kleinste Kanal setzt die
// Grenze: schlaegt einer an, waehrend die anderen noch Platz haben,
// verschiebt sich der Farbton, und ein Verlauf, der die Farbe wechselt,
// ist keiner mehr.
fn grad_room(c: u64, want: u64) -> u64 {
    var m: u64 = (c >> 16) & 255
    let g: u64 = (c >> 8) & 255
    let b: u64 = c & 255
    if g < m {
        m = g
    }
    if b < m {
        m = b
    }
    if want > m {
        return m
    }
    return want
}

// Die ROHE Titelfarbe (0xRRGGBB) des Fensters -- `shade24` rechnet in
// Kanaelen und nicht im Format des Bildschirms.
fn deco_title(state: u64, i: u64) -> u64 {
    if focus(state) == i {
        return deco_rgb(state, DK_TITLE_ON)
    }
    return deco_rgb(state, DK_TITLE)
}

// =====================================================================
// RUNDE SOFTUI: DIE DREI SCHALTFLAECHEN -- WINDOWS UND NICHT MACOS
// =====================================================================
//
// Justin hat das ausdruecklich verlangt und es ist keine
// Geschmacksfrage: rechts oben, drei Felder, und die Zeichen darin
// sind STRICHE und keine bunten Kreise. Minimieren ein waagerechter
// Strich, Maximieren ein Quadrat (im maximierten Zustand zwei
// versetzte), Schliessen ein Kreuz.
//
// DAS VERHALTEN GEHOERT DAZU. Ein Windows-Knopf hat keinen Rahmen und
// keine Flaeche, bis der Zeiger darauf steht; dann bekommt er eine
// dezente graue Flaeche, und der Schliessen-Knopf eine ROTE mit weissem
// Kreuz. Ohne den Ueberfahr-Zustand sind es drei Zeichen und keine
// Schaltflaechen -- deshalb fuehrt der Server jetzt mit, welche gerade
// unter dem Zeiger liegt (S_CAPHOV), und faerbt genau diese eine.
fn cap_x0(state: u64, i: u64) -> i64 {
    return win_x(state, i) + outer_w(state, i) as i64 - border(state) as i64
        - (CAP_N * cap_w(state)) as i64
}

// Welche Schaltflaeche liegt unter (x, y)? CAP_N = keine.
fn cap_at(state: u64, i: u64, x: i64, y: i64) -> u64 {
    if !valid(state, i) || !deko(state, i) {
        return CAP_N
    }
    if form(state, FM_CAPTION) == 0 {
        return CAP_N
    }
    let bx: i64 = cap_x0(state, i)
    let by: i64 = win_y(state, i) + border(state) as i64
    let h: i64 = title_h(state) as i64 - 1 - border(state) as i64
    if y < by || y >= by + h || x < bx || x >= bx + (CAP_N * cap_w(state)) as i64 {
        return CAP_N
    }
    return ((x - bx) / cap_w(state) as i64) as u64
}

fn paint_caption(state: u64, i: u64, wx: i64, wy: i64, ow: i64,
    titel: u64, schrift: u64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let bx: i64 = wx + ow - border(state) as i64 - (CAP_N * cap_w(state)) as i64
    let by: i64 = wy + border(state) as i64
    let h: i64 = title_h(state) as i64 - 1 - border(state) as i64
    if h <= 0 {
        return
    }
    var tr: u64 = 0
    let rw: u64 = form(state, FM_RADIUS)
    if rw > border(state) {
        tr = rw - border(state)
    }
    let hov: u64 = gs(state, S_CAPHOV)
    var n: u64 = 0
    while n < CAP_N {
        let x: i64 = bx + (n * cap_w(state)) as i64
        var mark: u64 = schrift
        if hov != 0 && hov - 1 == i * 4 + n {
            if n == CAP_CLOSE {
                // ROT MIT WEISSEM KREUZ -- die eine Stelle, an der
                // diese Oberflaeche laut werden darf.
                let rot: u64 = deco(state, DK_CLOSE)
                cap_face(state, x, by, h, tr, rot, n == CAP_CLOSE,
                    ax0, ay0, ax1, ay1)
                mark = deco(state, DK_CLOSE_MARK)
            } else {
                // Eine dezente graue Flaeche: die Titelfarbe, zwoelf
                // Hundertstel in Richtung der Schrift geschoben. Kein
                // neuer Farbsteckplatz und kein festes Grau -- auf
                // einem dunklen Thema muss sie heller werden und auf
                // einem hellen dunkler, und genau das tut das Mischen.
                let f: u64 = rgb24(state, mix24(deco_title(state, i),
                    deco_schrift(state, i), 12))
                cap_face(state, x, by, h, tr, f, false,
                    ax0, ay0, ax1, ay1)
            }
        }
        // ======================================== RUNDE MERGE-11: R1
        // DIE FESTE 10 WAR DER GRUND FUER JUSTINS "— [] /".
        //
        // Das Zeichen ist `10 * uisc` gross (cap_glyph, `let d`), hier
        // wurde aber mit der ROHEN 10 zentriert. Bei Vervielfachung 2
        // sitzt es damit 5 Bildpunkte zu weit rechts und unten -- und
        // vom Kreuz, dessen zweite Diagonale genau dort endet, bleibt
        // im Knopffeld ein Schraegstrich uebrig.
        //
        // GEMESSEN am laufenden Fenster, 3440x1440: mit der festen 10
        // meldet Justin "-- [] /", mit `zg` steht ein Kreuz da, in
        // jeder der 19 Zeilen Punkte auf BEIDEN Seiten.
        let zg: i64 = 10 * uisc(state) as i64
        cap_glyph(state, n, x + (cap_w(state) as i64 - zg) / 2,
            by + (h - zg) / 2, mark, i, ax0, ay0, ax1, ay1)
        n = n + 1
    }
}

fn deco_schrift(state: u64, i: u64) -> u64 {
    if focus(state) == i {
        return deco_rgb(state, DK_TEXT_ON)
    }
    return deco_rgb(state, DK_TEXT)
}

// Die Flaeche EINER Schaltflaeche. Nur die rechte -- das Schliessen --
// darf oben rechts der Fensterrundung folgen; die beiden anderen sind
// Rechtecke, weil sie mitten in der Leiste stehen.
fn cap_face(state: u64, x: i64, y: i64, h: i64, tr: u64, farbe: u64,
    rechts: bool, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let w: i64 = cap_w(state) as i64
    if !rechts || tr == 0 {
        fill_clip(state, x, y, w, h, farbe, ax0, ay0, ax1, ay1)
        return
    }
    let r: i64 = tr as i64
    fill_round(state, x, y, w, h, tr, farbe, ax0, ay0, ax1, ay1)
    // die drei Ecken wieder eckig machen
    fill_clip(state, x, y, w - r, r, farbe, ax0, ay0, ax1, ay1)
    fill_clip(state, x, y + r, w, h - r, farbe, ax0, ay0, ax1, ay1)
}

// DAS ZEICHEN. Zehn mal zehn Bildpunkte, einen Strich breit.
//
//   CAP_MIN    ein waagerechter Strich auf halber Hoehe
//   CAP_MAX    ein Quadrat -- und im maximierten Zustand ZWEI
//              versetzte, weil der Knopf dann "wiederherstellen"
//              heisst und nicht "maximieren"
//   CAP_CLOSE  ein Kreuz aus zwei Diagonalen
// ==================================================== RUNDE VEKTOR
//
// DIE DREI ZEICHEN, GESTRICHEN STATT GESETZT.
//
// Was hier stand, waren gesetzte Bildpunkte: `cap_px` in einer
// Schleife fuer das Kreuz, `cap_box` aus vier Linien fuer das
// Quadrat -- und alles auf FESTE ZEHN MAL ZEHN Bildpunkte.
//
// Der Fehler daran ist nicht der Geschmack, sondern die Rechnung:
// `cap_w` ist `CAP_W0 * uisc` und waechst mit der Oberflaeche
// (wm.fi:3043), die Zehn hier wuchs nicht mit. Bei Vervielfachung 2
// war die Schaltflaeche sechzig Bildpunkte breit und das Kreuz darin
// zehn -- ein Fliegendreck in einem Feld. Dazu war die Diagonale eine
// Treppe aus einzelnen Punkten, weil eine gesetzte Diagonale nichts
// anderes sein kann.
//
// Jetzt: die Groesse ist `10 * uisc`, und die Striche sind STRICHE --
// `vektor.strichen` mit Breite und runden Enden, gerastert mit
// derselben Kantenglaettung wie alles andere. Der Aufrufer uebergibt
// weiter die linke obere Ecke eines Quadrats; wie gross das ist,
// rechnet diese Funktion selbst.
// ================================================ RUNDE MERGE-11: R1
// DAS SCHLIESSKREUZ WIRD WIEDER DIREKT GEZEICHNET.
//
// Justins Foto vom 10.09. 18:39 (3440x1440): das X ist zerfranst, mit
// einem fetten schraegen Zusatzbalken. Minimieren und Maximieren sind
// sauber. Seine Worte: "so perfekte Buttons waren davor. Jetzt sind
// diese Buttons korrumpiert."
//
// DIE URSACHE, GEMESSEN (tools/design/kreuzcheck.py):
//
//   X, zwei Striche (uisc=1)   54 bedeckt    4 mehrfach
//   X, zwei Striche (uisc=2)  187 bedeckt   12 mehrfach
//   X, zwei Striche (uisc=3)  394 bedeckt   24 mehrfach
//   Gegenprobe: EIN Strich      jeweils      0 mehrfach
//
// Die Vektorfassung rief `strichen(0)` ZWEIMAL -- einmal je Diagonale
// -- und rasterte beide Umrisse zusammen mit NICHTNULL. Wo sich die
// Umrisse kreuzen, addieren sich die Umlaufzahlen, statt sich
// aufzuheben: die Kreuzungsflaeche wird doppelt gedeckt. Und es wird
// mit der Skalierung SCHLIMMER (4 -> 12 -> 24 Bildpunkte), weshalb es
// auf Justins dichtem Schirm auffaellt und im Pruefstand bei kleiner
// Skalierung durchging.
//
// WAS JETZT PASSIERT: zurueck auf die Fassung, die er "perfekt"
// genannt hat -- ein Bildpunkt nach dem anderen, jeder GENAU EINMAL
// geschrieben. Doppelte Deckung ist damit nicht unwahrscheinlich,
// sondern unmoeglich; es gibt keinen Umriss, der sich ueberlappen
// koennte.
//
// DER EINE UNTERSCHIED ZUR ALTEN FASSUNG: sie war auf 10 Bildpunkte
// festgenagelt und waere auf 3440x1440 ein Fliegendreck. Die Groesse
// laeuft jetzt ueber `uisc`, die Strichstaerke ebenso -- gezeichnet
// wird aber weiter direkt, ohne Rasterer.
//
// KEIN RETTUNGSVERSUCH AM VEKTORWEG. Der Auftrag ist eindeutig:
// lieber eine einfache Zeichnung, die sauber aussieht.
fn cap_glyph(state: u64, n: u64, x: i64, y: i64, farbe: u64, i: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let sk: i64 = uisc(state) as i64
    let d: i64 = 10 * sk
    let sb: i64 = sk
    if d <= 0 || sb <= 0 {
        return
    }
    // ================================================== RUNDE KERN-FUI
    //
    // DIESE FUNKTION MALT DIE ZEICHEN NICHT MEHR SELBST.
    //
    // Justin, 10.09.2026: "kann man die fUi-Lib nicht ohne Imports
    // machen, also dass sie im Kernel auch laufen kann?" -- sie ist es
    // bereits: `vendor/firn/lib/fui/core.fi` traegt `profile kernel` in
    // Zeile 1 und wurde genau dafuer geschrieben. Angeschlossen war sie
    // nie; `grep -rln fui kernel/*.fi` fand bis zu dieser Runde nichts.
    //
    // WARUM DAS NICHT KOSMETIK IST, SONDERN EIN GEMESSENER FEHLER.
    // Die alte Fassung hier rechnete EINE Verschiebung fuer beide
    // Achsen:
    //
    //     let off: i64 = (d - (kn + sb - 1)) / 2
    //
    // Das Kreuz belegt aber nicht gleich viel in beiden Richtungen --
    // die Breite ist `kn + sb - 1` (die Laeufe UND die Verbreiterung
    // addieren sich), die Hoehe nur `kn` (die Verbreiterung geht
    // waagerecht). `core.fi` rechnet deshalb ZWEI Verschiebungen und
    // sagt das in seinem Kopf auch woertlich ("A THIRD MISTAKE, FOUND
    // AND MEASURED IN THIS ROUND").
    //
    // GEMESSEN (tools/fui/kernvergleich.py), abweichende Bildpunkte
    // zwischen der alten wm-Fassung und fui.core:
    //
    //     d=10 sb=1     0      d=20 sb=2     0
    //     d=30 sb=3   112      d=40 sb=4   152
    //
    // Bei Vervielfachung 1 und 2 stimmten beide ueberein -- deshalb ist
    // es nie aufgefallen. Ab Vervielfachung 3 klebt das Kreuz oben und
    // laesst unten eine Zeile frei, waehrend das Quadrat daneben mittig
    // sitzt. Das ist genau die Sorte Abweichung, die entsteht, wenn
    // dieselbe Form an zwei Orten steht -- und der dritte Anlauf
    // desselben Fehlers, nach dem ausgefransten Kreuz und dem mit nur
    // einer Diagonale.
    //
    // ============================================ WIE fUi AUF DEN SCHIRM KOMMT
    //
    // NICHT direkt, und das hat zwei nachgepruefte Gruende:
    //
    //  G1 `core.fi` KENNT KEINEN BESCHNITT. Es malt in ein `Target` von
    //     (0,0) bis (w,h); der Server malt in ein SCHMUTZRECHTECK
    //     (ax0..ax1, ay0..ay1) mitten auf dem Schirm. Ein Zeichen ohne
    //     Beschnitt malte ueber fremde Fenster.
    //  G2 DAS PIXELFORMAT IST NICHT FEST. `core.put` legt BGRX ab, fest
    //     verdrahtet. `fb.fi` nimmt die Verschiebungen aus S_RSHIFT/
    //     S_GSHIFT/S_BSHIFT, die der Grafikmodus liefert -- auf einer
    //     Tafel mit anderer Reihenfolge waeren die Farben vertauscht.
    //     Dazu haelt `fb.pixel` das reservierte Band der Messtafel frei
    //     (`band_lo`), was ein roher Schreiber ueberschriebe.
    //
    // ALSO: fUi rastert in `cg_deck` -- den Zwischenpuffer, den Runde
    // VEKTOR angelegt und nie benutzt hat. Dort ist das Format egal,
    // weil nur die DECKUNG zaehlt. Danach traegt diese Funktion den
    // Puffer durch `cap_px` auf den Schirm -- mit Beschnitt, mit dem
    // Band und ueber den Farbwaehler des Servers. Die FORM kommt aus
    // fUi, der WEG auf den Schirm bleibt der des Servers.
    //
    // Damit malt der Fensterserver dieselben Bildpunkte wie jede
    // Anwendung, weil es derselbe Quelltext ist -- und
    // `tools/fui/kernvergleich.py` rechnet es nach.
    let dd: u64 = d as u64
    if dd > CG_KANTE {
        // Mehr als 40x40 passt nicht in ein Fach. Das kann bei
        // uisc <= 4 nicht vorkommen (10 * 4 = 40); steht hier trotzdem,
        // weil ein stiller Ueberlauf in einen statischen Puffer im Kern
        // das Schlimmste ist, was diese Datei tun kann.
        return
    }
    let slot: u64 = cg_slot(state, n, i)
    if !cg_bau(state, slot, n, i, dd, sb as u64) {
        return
    }
    // Der Puffer haelt DECKUNGEN, nicht Farben: != 0 heisst gesetzt.
    // `core.fi` setzt jeden Punkt genau einmal und ohne Mischung (das
    // ist der ganze Unterschied zum Rasterer, an dem das Kreuz zweimal
    // zerbrochen ist) -- ein Vergleich gegen null reicht deshalb.
    var ry: u64 = 0
    while ry < dd {
        var rx: u64 = 0
        while rx < dd {
            if cg_deck[(slot *% CG_FACH +% ry *% dd +% rx) as usize]
                != 0 as u8 {
                cap_px(state, x + rx as i64, y + ry as i64, farbe,
                    ax0, ay0, ax1, ay1)
            }
            rx = rx + 1
        }
        ry = ry + 1
    }
}

// Welches Fach des Zeichenspeichers gehoert zu dieser Schaltflaeche?
// Maximieren hat ZWEI Bilder -- ein Quadrat und zwei versetzte --, also
// braucht es zwei Faecher. Das vierte ist genau dafuer da.
fn cg_slot(state: u64, n: u64, i: u64) -> u64 {
    if n == CAP_MAX && (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0 {
        return 3
    }
    if n >= CG_N {
        return 0
    }
    return n
}

// DAS ZEICHEN IN DEN ZWISCHENPUFFER, EINMAL JE GROESSE.
//
// Liegt es schon in der richtigen Kantenlaenge da, wird nichts gemalt
// -- das ist der Speicher, den Runde VEKTOR angelegt und nie benutzt
// hat. `cg_treffer` und `cg_bauten` zaehlen beides; die zweite Zahl
// muss klein bleiben, sonst wirkt der Speicher nicht.
fn cg_bau(state: u64, slot: u64, n: u64, i: u64, dd: u64, sb: u64) -> bool {
    if slot >= CG_N || dd == 0 || dd > CG_KANTE {
        return false
    }
    if cg_gr == dd && cg_gut[slot as usize] != 0 {
        cg_treffer = cg_treffer + 1
        return true
    }
    // Die Groesse hat gewechselt: ALLE Faecher sind ungueltig, nicht
    // nur dieses. Sonst stuenden Zeichen zweier Vervielfachungen
    // nebeneinander in der Leiste.
    if cg_gr != dd {
        var k: u64 = 0
        while k < CG_N {
            cg_gut[k as usize] = 0
            k = k + 1
        }
        cg_gr = dd
    }
    // DIE FLAECHE, DIE fUi BESCHREIBT.
    //
    // `core.fi` rechnet mit VIER Oktetten je Bildpunkt (`put` schreibt
    // B, G, R, X). Ein Fach ist deshalb `CG_KANTE * CG_KANTE * 4` gross
    // und nicht `CG_KANTE * CG_KANTE` -- 6400 Oktette, viermal, macht
    // 25 600 Oktette fuer den ganzen Speicher. Das ist der ehrliche
    // Preis dafuer, dass hier dieselbe Routine laeuft wie in Ring 3;
    // ihn zu druecken hiesse, `core.fi` eine zweite Ablage
    // beizubringen, und das waere wieder die zweite Umsetzung.
    //
    // Danach wird das Fach AN ORT UND STELLE auf ein Oktett je Punkt
    // eingedampft (`cg_dampf`): Punkt k liegt bei k*4 und soll nach k,
    // und weil k <= k*4 gilt, ueberschreibt der Lauf nie etwas, das er
    // noch braucht. Das spart beim Uebertragen drei Viertel der
    // Leserei, und das Uebertragen laeuft je BILD -- das Rastern nur
    // je Groesse.
    let basis: u64 = ((&cg_deck[0]) as u64) +% slot *% CG_FACH
    var z: core.Target = core.target_new(basis, dd as usize, dd as usize,
        (dd *% 4) as usize)
    core.fill_rect(&z, 0 as usize, 0 as usize, dd as usize, dd as usize,
        0 as u32)
    cg_mal(state, &z, n, i, dd, sb)
    cg_dampf(state, slot, dd)
    cg_gut[slot as usize] = 1
    cg_bauten = cg_bauten + 1
    return true
}

// Vier Oktette je Punkt auf eines eindampfen, im selben Fach.
fn cg_dampf(state: u64, slot: u64, dd: u64) {
    let b: u64 = slot *% CG_FACH
    var k: u64 = 0
    while k < dd *% dd {
        var v: u8 = 0 as u8
        if cg_deck[(b +% k *% 4) as usize] != 0 as u8 {
            v = 255 as u8
        }
        cg_deck[(b +% k) as usize] = v
        k = k + 1
    }
}

// ============================================================ DIE FORM
//
// HIER UND NUR HIER entscheidet sich, WIE ein Fensterzeichen aussieht
// -- und es steht keine einzige Zeile Zeichenkunst darin. Jede Form
// kommt aus `fui.core`, derselben Datei, aus der die Anwendungen ueber
// `fuib.fi` ihre Knoepfe holen.
//
// Die Farbe ist 0xFFFFFF und nicht die echte: der Puffer haelt
// DECKUNGEN. Welche Farbe daraus wird, entscheidet `cap_glyph` beim
// Uebertragen -- und damit der Farbwaehler des Servers, nicht fUi.
fn cg_mal(state: u64, z: *mut core.Target, n: u64, i: u64, dd: u64,
    sb: u64) {
    let weiss: u32 = 0xFFFFFF as u32
    if n == CAP_MIN {
        core.cap_minimize(z, 0 as usize, 0 as usize, dd as usize,
            sb as usize, weiss)
        return
    }
    if n == CAP_MAX {
        if (wg(state, i, W_FLAGS) & F_MAXIMIZED) != 0 {
            core.cap_restore(z, 0 as usize, 0 as usize, dd as usize,
                sb as usize, weiss)
            return
        }
        core.cap_maximize(z, 0 as usize, 0 as usize, dd as usize,
            sb as usize, weiss)
        return
    }
    core.cap_close(z, 0 as usize, 0 as usize, dd as usize, sb as usize,
        weiss)
}

// Ein Kasten mit Strichstaerke -- die alte `cap_box` kann nur einen
// Bildpunkt breit. Auch hier gilt: jeder Bildpunkt wird gesetzt, nicht
// aufaddiert; ueberlappende Kanten an den Ecken sind deshalb harmlos.
fn cap_box_thick(state: u64, x: i64, y: i64, w: i64, h: i64, sb: i64,
    farbe: u64, ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    var t: i64 = 0
    while t < sb {
        cap_h(state, x, y + t, w, farbe, ax0, ay0, ax1, ay1)
        cap_h(state, x, y + h - 1 - t, w, farbe, ax0, ay0, ax1, ay1)
        var k: i64 = 0
        while k < h {
            cap_px(state, x + t, y + k, farbe, ax0, ay0, ax1, ay1)
            cap_px(state, x + w - 1 - t, y + k, farbe, ax0, ay0, ax1, ay1)
            k = k + 1
        }
        t = t + 1
    }
}

// Wie oft ein fertiges Zeichen benutzt und wie oft eines gerastert
// wurde. Die zweite Zahl MUSS klein bleiben -- sie ist der Beleg,
// dass der Speicher wirkt.
fn cap_glyph_treffer() -> u64 {
    return cg_treffer
}

fn cap_glyph_bauten() -> u64 {
    return cg_bauten
}

fn cap_px(state: u64, x: i64, y: i64, farbe: u64, ax0: i64, ay0: i64,
    ax1: i64, ay1: i64) {
    if x < ax0 || y < ay0 || x >= ax1 || y >= ay1 || x < 0 || y < 0 {
        return
    }
    fb.pixel(state, x as u64, y as u64, farbe)
}

fn cap_h(state: u64, x: i64, y: i64, n: i64, farbe: u64, ax0: i64,
    ay0: i64, ax1: i64, ay1: i64) {
    var k: i64 = 0
    while k < n {
        cap_px(state, x + k, y, farbe, ax0, ay0, ax1, ay1)
        k = k + 1
    }
}

fn cap_box(state: u64, x: i64, y: i64, w: i64, h: i64, farbe: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    cap_h(state, x, y, w, farbe, ax0, ay0, ax1, ay1)
    cap_h(state, x, y + h - 1, w, farbe, ax0, ay0, ax1, ay1)
    var k: i64 = 1
    while k < h - 1 {
        cap_px(state, x, y + k, farbe, ax0, ay0, ax1, ay1)
        cap_px(state, x + w - 1, y + k, farbe, ax0, ay0, ax1, ay1)
        k = k + 1
    }
}

// Der Zeiger ist gewandert: welche Schaltflaeche liegt jetzt unter ihm?
// Aendert sich die Antwort, wird die Titelleiste des betroffenen
// Fensters schmutzig -- und nur sie.
fn cap_track(state: u64, i: u64, x: i64, y: i64) {
    var nv: u64 = 0
    if i < MAX_WIN {
        let n: u64 = cap_at(state, i, x, y)
        if n < CAP_N {
            nv = i * 4 + n + 1
        }
    }
    let alt: u64 = gs(state, S_CAPHOV)
    if nv == alt {
        return
    }
    ss(state, S_CAPHOV, nv)
    if alt != 0 {
        damage_caption(state, (alt - 1) / 4)
    }
    if nv != 0 {
        damage_caption(state, (nv - 1) / 4)
    }
}

fn damage_caption(state: u64, i: u64) {
    if !valid(state, i) || !deko(state, i) {
        return
    }
    let bx: i64 = cap_x0(state, i)
    let by: i64 = win_y(state, i) + border(state) as i64
    damage(state, bx, by, bx + (CAP_N * cap_w(state)) as i64,
        by + title_h(state) as i64 - 1 - border(state) as i64)
}

// Eine Bildzeile aus einem Fensterpuffer in den Zweitpuffer des
// Bildschirms. Ueber `rep movsq`, wie alles andere in `fb.fi` -- eine
// Schleife aus Einzelzugriffen kostete dort gemessen den Faktor acht.
fn fb_row(state: u64, x: u64, y: u64, src: u64, n: u64) {
    // RUNDE BLECHDREI: DIESER WEG GEHT AN `fb.hline` VORBEI -- er
    // kopiert die Fensterflaeche wortweise direkt in den Zweitpuffer.
    // Ohne die Grenze hier waere das reservierte Band der Messtafel
    // genau von dem ueberschrieben worden, der es am haeufigsten
    // ueberschrieben hat: dem Fensterserver.
    if y < fb.band_lo(state) {
        return
    }
    let ziel: u64 = fb.draw_at(state) +% y *% fb.pitch(state) +% x *% 4
    copy_words(ziel, src, n *% 4 / 8)
    if (n & 1) != 0 {
        __mmio_write32((ziel +% (n - 1) *% 4) as *mut u32,
            __mmio_read32((src +% (n - 1) *% 4) as *mut u32))
    }
}

// Der Titel, auf die Breite bis zum Schliessfeld beschnitten.
// EIN ZEICHEN AUS `kernel/netmark.fi`, EINFARBIG. Der Fensterserver
// dieses Zweiges kennt keine Farbrollen -- die Runde THEME gibt ihm
// gerade welche (WM_DECO) --, also wird das Zeichen in der Farbe der
// TITELSCHRIFT gemalt, die es hier schon gibt. Das kostet nichts:
// UNTERSCHIEDEN WERDEN DIE DREI ZEICHEN DURCH IHRE FORM UND NICHT DURCH
// IHRE FARBE, und `tools/netview/icons.py` misst genau das (die
// Schattenrisse unterscheiden sich um mindestens ein Drittel der
// eingefaerbten Bildpunkte). Wenn THEME durch ist, wird aus `color`
// eine Rolle und sonst nichts.
fn title_mark(state: u64, m: u64, x: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    var r: u64 = 0
    while r < netmark.H {
        let py: i64 = y + r as i64
        if py >= ay0 && py < ay1 {
            let maske: u64 = netmark.mask_at(m, r)
            var c: u64 = 0
            while c < netmark.W {
                if (maske >> (netmark.W - 1 - c)) & 1 != 0 {
                    let pxx: i64 = x + c as i64
                    if pxx >= ax0 && pxx < ax1 {
                        fb.pixel(state, pxx as u64, py as u64, color)
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

static mut titel_schnitt: u64 = 0
static mut titel_max: u64 = 0
// RUNDE BLECH2: die ALTE Zaehlweise (Schnittfenster beginnt rechts vom
// Titelanfang), nur noch fuer `wm: fen` -- siehe `title_text`.
static mut titel_schnitt_alt: u64 = 0

fn title_clipped() -> u64 {
    return titel_schnitt
}

fn title_old() -> u64 {
    return titel_schnitt_alt
}

fn title_missing() -> u64 {
    return titel_max
}

fn title_text(state: u64, i: u64, f: u64, x: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64, grenze: i64) {
    // RUNDE I18N: derselbe Umbau wie in `text` -- der Titel eines
    // Fensters ist der einzige Text, den der SERVER malt, und wenn er
    // als einziger oktettweise laeuft, sieht ein Fenster namens
    // "Einstellungen" mit echtem Umlaut in der Titelleiste anders aus
    // als sein eigener Knopf.
    let px: u64 = gs(state, S_PX_UI)
    // ADDENDUM TASKBAR, DER FUND DIESES ZWEIGES, UND ER DARF BEIM
    // ZUSAMMENFUEHREN NICHT VERLORENGEHEN: `wat` TRAEGT `kstate.DSK_OFF`
    // SCHON, seit die Runde DESKTOP die Fenstertafel aus WM_OFF
    // herausgezogen hat. Diese eine Stelle hat WM_OFF noch einmal
    // daraufgerechnet und seither Nullen gelesen -- JEDER FENSTERTITEL
    // AUF DEM BILDSCHIRM WAR LEER, und drei Zusagen in
    // tools/wm/run.sh haben es gesagt ("LEER: K l i c k m i c h").
    // `set_title` zwoelfhundert Zeilen weiter oben war berichtigt
    // worden, diese Stelle nicht. Die Runde I18N hat die Schleife
    // darunter auf UTF-8 umgebaut und die falsche Basis dabei
    // uebernommen; hier stehen beide Aenderungen zusammen.
    // ============================================== RUNDE VIELKERN
    // WIRD DER TITEL LINKS ABGESCHNITTEN? DIE ZAHL DAZU.
    //
    // Justin sieht auf mehreren Fotos bei 3440x1440 `inal -- sh` statt
    // `Terminal -- sh`: die ersten vier bis fuenf Zeichen fehlen,
    // waehrend der Rahmen richtig sitzt. Der Verdacht war eine
    // Zeilenbreitenrechnung, die bei 3440 bricht. GEMESSEN und
    // WIDERLEGT (docs/RUNDE-VIELKERN.md): mit pitch 13760 bei 3424
    // Bildpunkten Breite -- genau der Fall echter Firmware -- ist das
    // Bild bildpunktgleich mit dem ungepolsterten Lauf.
    //
    // Bleibt der andere Weg, auf dem Zeichen links verschwinden
    // koennen: das SCHNITTFENSTER. `fb_glyph` laesst jeden Bildpunkt
    // mit `pxx < ax0` aus. Liegt `ax0` rechts vom Titelanfang, fehlt
    // genau der linke Teil des Textes und sonst nichts -- der Rahmen
    // wird in einem anderen Aufruf mit einem anderen Schnitt gemalt
    // und bleibt heil. Das ist keine Behauptung, sondern jetzt eine
    // ZAHL: `TK` auf Tafelzeile 7 sagt, wie oft und wie weit.
    // ====================================================== RUNDE BLECH2
    // TK ZAEHLTE DAS FALSCHE. Justins Tafel: `7 LEISTE ... TK 643`, und
    // auf demselben Foto steht `Terminal -- sh` VOLLSTAENDIG in der
    // Titelleiste. `x < ax0` heisst nur: das Schnittfenster dieses
    // Anstrichs faengt rechts vom Titelanfang an -- und das ist bei
    // JEDEM Teilanstrich so, dessen schmutziges Rechteck nicht am linken
    // Fensterrand beginnt: der Zeiger, der ueber die Fensterflaeche
    // laeuft, ein Fenster, das darueber aufgeht. Die Bildpunkte links
    // vom Schnitt stehen unveraendert im Zweitpuffer und werden mit der
    // Zeile zusammen uebertragen; es fehlt nichts. GEMESSEN in
    // tools/metal2/run.sh: alte Zaehlweise in die Hunderte, Titel im
    // Bild bildpunktgenau vollstaendig (`checkshot.py tkette`).
    //
    // Was einen Titel WIRKLICH verschwinden laesst, ist das Band der
    // Messtafel: `fb.pixel` weist jede Zeile unter `band_lo` ab, still.
    // Ein Fenster, das nach oben in das Band geschoben wird, verliert
    // seinen Titel genau dort. DAS zaehlt TK jetzt: Titelzeilen, die im
    // Band liegen. Die alte Zahl bleibt als `tka=` in `wm: fen`.
    if x < ax0 {
        titel_schnitt_alt = titel_schnitt_alt + 1
    }
    let oben: i64 = y - ttf.ascent(state, f, px)
    let band: i64 = fb.band_lo(state) as i64
    if oben < band {
        titel_schnitt = titel_schnitt + 1
        let fehlt: u64 = (band - oben) as u64
        if fehlt > titel_max {
            titel_max = fehlt
        }
    }
    let tp: u64 = state + wat(i) + W_TITLE
    var cx: i64 = x * 64
    var vorher: u64 = 0
    var k: u64 = 0
    while k < 31 {
        let v: u64 = utf8.next(tp, 31, k)
        let l: u64 = utf8.len_of(v)
        let c: u64 = utf8.cp_of(v)
        if l == 0 || c == 0 {
            k = 31
        } else {
            let gid: u64 = ttf.glyph_of(state, f, c)
            if vorher != 0 {
                cx = cx + ttf.kern26(state, f, vorher, gid, px)
            }
            let slot: u64 = ttf.glyph(state, f, c, px)
            if slot < ttf.SLOTS {
                if (cx >> 6) + ttf.g_w(state, slot) as i64 > grenze - 4 {
                    return
                }
                fb_glyph(state, slot, cx >> 6, y, color, ax0, ay0, ax1, ay1)
                cx = cx + ttf.g_adv(state, slot)
            } else {
                cx = cx + ttf.advance26(state, f, gid, px)
            }
            vorher = gid
            k = k + l
        }
    }
}

// Eine Glyphe unmittelbar in den Zweitpuffer -- fuer alles, was der
// SERVER malt (Titel), nicht die Anwendung.
fn fb_glyph(state: u64, slot: u64, x: i64, y: i64, color: u64,
    ax0: i64, ay0: i64, ax1: i64, ay1: i64) {
    let gw: u64 = ttf.g_w(state, slot)
    let gh: u64 = ttf.g_h(state, slot)
    let x0: i64 = x + ttf.g_left(state, slot)
    let y0: i64 = y - ttf.g_top(state, slot)
    var r: u64 = 0
    while r < gh {
        let py: i64 = y0 + r as i64
        if py >= ay0 && py < ay1 {
            var c: u64 = 0
            while c < gw {
                let pxx: i64 = x0 + c as i64
                if pxx >= ax0 && pxx < ax1 {
                    let a: u64 = ttf.g_pixel(state, slot, c, r)
                    if a != 0 {
                        fb.pixel(state, pxx as u64, py as u64,
                            blend(fb.get_pixel(state, pxx as u64,
                                py as u64), color, a))
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

// ==================================== RUNDE HIDPUNKTE: DIE MESSLEISTE
// ======================================= RUNDE MESSTAFEL: SIEBEN ZEILEN
//
// EINE ANZEIGE, DIE NICHT VOM FENSTERSYSTEM ABHAENGT.
//
// Der Eingabepuls stand bisher IM Terminalfenster. Auf Justins Brett
// war genau dieses Fenster zu schmal und links abgeschnitten -- die
// Diagnose war also da, wo man sie am wenigsten lesen konnte. Diese
// Zeilen werden NACH `compose` unmittelbar in den Rahmenpuffer gemalt,
// mit dem eingebauten Bitmapzeichensatz (kein TTF, kein Fenster, kein
// Puffer, keine Arena). Sie stehen deshalb auch dann da, wenn der
// Fensterserver, die Taskleiste und die Schrift allesamt versagen.
//
// RUNDE MESSTAFEL, UND DAS IST DER GRUND FUER DEN UMBAU: Justin
// fotografiert den Bildschirm mit dem Mobiltelefon AUS ZWEI METERN.
// Eine Zeile mit zwanzig Zahlen in `uisc`-Groesse ist auf so einem
// Foto nicht zu lesen. Also: sieben kurze Zeilen, ein Maszstab GROESSER
// als der der Oberflaeche, und -- das ist das eigentliche Werkzeug --
// JEDE STUFE BEKOMMT EINE FARBE. Gruen heiszt "hier kam etwas an", rot
// heiszt "hier kam nichts an". Die ERSTE ROTE ZEILE ist die Stelle, an
// der der Eingabeweg abreiszt. Das kann man aus zwei Metern erkennen,
// ohne eine einzige Ziffer zu entziffern.
// So breit ist die laengste Tafelzeile (kgui.TAFEL_SPALTEN). Hier
// noch einmal, weil `wm` `kgui` nicht einbinden darf -- der
// Modulgraph ist ein Baum und kgui haengt ueber wm.
// ================================================== RUNDE BLECHDREI
// Justins Foto zeigte "11 USB DEV 0 FUND 3 HUB 0 KBD" -- mitten im
// Wort abgeschnitten. Der Grund war eine ZWEITE Zahl: `kgui` merkt
// sich 40 Zeichen je Zeile, gemalt und uebertragen wurden aber nur
// `MESS_SPALTEN` = 30. Alles ab Zeichen 31 stand im Zweitpuffer und
// kam nie ueber den Bus. Zwei Zahlen fuer eine Sache, und die
// kleinere gewinnt still.
const MESS_SPALTEN: u64 = 48
// Wie viele Zeilen die Tafel hat. Spiegel von `kgui.TAFEL_ZEILEN` --
// `wm` darf `kgui` nicht einbinden (der Modulgraph ist ein Baum).
// ============================================== RUNDE STARTKNOPF
// ZUM DRITTEN MAL DIESELBE ZAHL AN ZWEI STELLEN.
//
// Der Kommentar in `messzeile_x` warnt seit BLECHDREI davor ("Zwei
// Zahlen fuer eine Sache, schon wieder") -- und genau das stand hier
// wieder: `kgui.TAFEL_ZEILEN` war 24, `MESS_ZEILEN` 20. Die Folge:
// `mess_projespalte` rechnete zehn Zeilen je Spalte, waehrend
// `messhoehe` fuer 24 Zeilen ein Band von 582 Bildpunkten reserviert
// hat -- die Zeilen 20..23 landeten auf 10..13, und ein Drittel des
// Bandes blieb schwarz.
// ================================================== RUNDE LEISTE
// ZUM VIERTEN MAL, UND JETZT MIT EINEM RIEGEL DAVOR.
//
// Der Absatz darueber sagt "zum dritten Mal dieselbe Zahl an zwei
// Stellen" -- und beim vierten Mal hat sie den Kern umgebracht:
//
//     *** EXCEPTION 14 #PF  err=0xb  cr2=0x622140
//       rip=0x26d0b7 (fb.fill_words+0xa7)  rsp=0x5096e0
//
// `kgui.TAFEL_ZEILEN` war 24, diese Zahl 20. `messzeile_x` rechnet aus
// ihr die Spalte; fuer die Zeilen 20..23 kam eine Spalte heraus, die
// es nicht gibt, und der Balken, der die Zeile loescht, lief aus dem
// Puffer heraus.
//
// ZWEI DINGE, NICHT EINS. Die Zahl steht jetzt auf 24 -- und weil
// dieselbe Verwechslung viermal passiert ist, gibt es zusaetzlich
// einen RIEGEL: `messzeile` und `messzeile_x` nehmen keine Zeilennummer
// mehr an, die es nicht gibt. Eine falsche Zahl malt dann nichts, und
// nichts malen ist immer besser als woanders hinmalen.
const MEASURE_LINES: u64 = 25

fn messk(state: u64) -> u64 {
    // Eine Stufe groesser als die Oberflaeche, hoechstens 4. Auf
    // 3440x1440 ist `uisc` 2, die Tafel also 3: 24 x 48 Bildpunkte je
    // Zeichen, rund elf Millimeter hoch. Das ist aus zwei Metern
    // dieselbe Winkelgroesse wie 6-mm-Text aus einem Meter.
    // ============================================ RUNDE BLECHDREI
    // AUS DER BILDBREITE, NICHT AUS `uisc`.
    //
    // Zwei Gruende. Erstens steht `uisc` erst nach `surface` fest, die
    // Tafel malt aber schon aus dem Boot-Protokoll heraus -- auf
    // Justins 3440x1440 kam damit k=2 heraus, obwohl dort k=3 gemeint
    // war. Zweitens ist die Frage hier eine andere als bei der
    // Oberflaeche: nicht "wie gross ist ein Knopf", sondern "was kann
    // ein Mensch aus einem Meter mit dem Handy noch fotografieren".
    // 3440 / 900 = 3 -> Zeichen von 24 x 48 Bildpunkten, auf einem
    // 34-Zoll-Schirm rund elf Millimeter hoch.
    var k: u64 = fb.width(state) / 900
    if k < 2 {
        k = 2
    }
    if k > 4 {
        k = 4
    }
    return k
}

fn messhoehe(state: u64, lines: u64) -> u64 {
    var z: u64 = lines
    // RUNDE BLECHDREI: bei mehreren Spalten ist die Tafel nur so hoch
    // wie EINE Spalte. `messleiste` ruft weiter mit einer Zeile.
    if z > 1 {
        z = (z + mess_kol(state) - 1) / mess_kol(state)
    }
    return font.GLYPH_H * messk(state) * z + 2 * messk(state)
}

// DER GRUND WIRD EINMAL GEFUELLT, nicht je Zeile. Sieben schwarze
// Balken ueber die volle Schirmbreite waeren auf 3440 Punkten 1,15
// Millionen Bildpunkte JE RUNDE -- der Grund hoert deshalb dort auf,
// wo die laengste Zeile aufhoert (`spalten` Zeichen).
// RUNDE TAFEL: UEBER DIE VOLLE BREITE, AB BILDPUNKT NULL.
//
// Vorher hoerte der schwarze Grund dort auf, wo die laengste Zeile
// aufhoerte -- 726 von 3440 Bildpunkten. Auf Justins Foto war davon
// nichts zu erkennen: ein schmaler dunkler Streifen links oben sieht
// aus wie ein Fensterrand. Ein Messgeraet, das man fuer Zierat haelt,
// ist keines.
//
// Jetzt: schwarzer Balken ueber die GANZE Breite, ab Bildpunkt 0,
// darunter eine helle Trennlinie. Aus zwei Metern ist das ein Balken
// und kein Fensterrand. `spalten` bleibt in der Aufrufliste, weil die
// einzeilige `messleiste` sie noch benutzt.
// ================================================== RUNDE BLECHZWEI
// Wie breit die Tafel wirklich ist. Bis zu dieser Runde ging der
// schwarze Balken ueber die GANZE Bildbreite -- gut auf einem Foto,
// aber 3440 Bildpunkte je Zeile, und die muessen alle ueber PCIe. Der
// Text ist `spalten` Zeichen breit; der Balken bekommt einen halben
// Zeichenrand dazu und hoert dann auf. Auf 3440 sind das rund 780 statt
// 3440 Bildpunkte, also ein Fuenftel der Uebertragung.
fn measure_width(state: u64, spalten: u64) -> u64 {
    let k: u64 = messk(state)
    var b: u64 = font.GLYPH_W * k * (spalten + 1) + 2 * k
    if b > fb.width(state) {
        b = fb.width(state)
    }
    return b
}

// Wo eine einzelne Tafelzeile anfaengt und wie hoch sie ist. Damit
// uebertraegt `kgui` nur die Zeilen, die sich WIRKLICH geaendert haben.
// ================================================== RUNDE BLECHDREI
// ZWEI SPALTEN NEBENEINANDER, UND WARUM.
//
// Die Tafel bekommt in dieser Runde ein FEST RESERVIERTES Band am
// oberen Rand, das niemand ueberschreibt (`fb.set_band`). Vierzehn
// Zeilen uebereinander waeren auf Justins 3440x1440 aber 14 * 48 =
// 678 Bildpunkte, also fast die halbe Bildhoehe -- ein Messgeraet,
// das den Messgegenstand verdeckt.
//
// Also sieben Zeilen in zwei Spalten: 342 Bildpunkte hoch, 2 * 1182
// breit. Passen zwei Spalten nicht nebeneinander (schmale Schirme der
// Regressionslaeufe), faellt es von selbst auf eine zurueck.
// ============================================ RUNDE BLECHFUENF
// DIE DRITTE SPALTE, UND WARUM SIE SEIN MUSS.
//
// Die Tafel hat zwei Zeilen mehr bekommen (die Tastatur und die Uhr),
// und mit zwanzig Zeilen in ZWEI Spalten wurde das Band 487 Bildpunkte
// hoch. `fb.set_band` lehnt alles ueber einem Drittel des Schirms ab --
// bei 1440 sind das 480 -- und lehnte es AB: `BAND H 0`, gemessen.
// Damit war der Schutz weg, den die Vorrunde eingezogen hat, und die
// Tafel haette wieder uebermalt werden koennen.
//
// Justins Schirm ist 3440 breit; drei Spalten zu 1178 Bildpunkten
// passen zweimal hinein. Sieben Zeilen statt zehn, Band 170 statt 487.
// Die Breite war nie das Problem, die Hoehe ist es.
fn mess_kol(state: u64) -> u64 {
    let b: u64 = measure_width(state, MESS_SPALTEN)
    if 3 * b <= fb.width(state) {
        return 3
    }
    if 2 * b <= fb.width(state) {
        return 2
    }
    return 1
}

// RUNDE LEISTE: die Zahl NACH AUSSEN, damit `kgui` sie mit seiner
// eigenen vergleichen kann. Vier Runden sind daran verlorengegangen,
// dass zwei Dateien dieselbe Zahl getrennt fuehren und niemand merkt,
// wenn sie auseinanderlaufen. `wm` darf `kgui` nicht einbinden -- aber
// `kgui` darf `wm` fragen, und genau das tut es jetzt beim Start.
fn measure_lines() -> u64 {
    return MEASURE_LINES
}

// Zeilen JE SPALTE -- aufgerundet, damit keine Zeile herausfaellt.
fn mess_projespalte(state: u64) -> u64 {
    let k: u64 = mess_kol(state)
    return (MEASURE_LINES + k - 1) / k
}

// Die volle Breite der Tafel: alle Spalten nebeneinander.
fn mess_vollbreite(state: u64) -> u64 {
    var b: u64 = mess_kol(state) * measure_width(state, MESS_SPALTEN)
    if b > fb.width(state) {
        b = fb.width(state)
    }
    return b
}

fn messzeile_x(state: u64, zeile: u64) -> u64 {
    // GEMESSEN UND KORRIGIERT: im ersten Lauf stand `MESS_ZEILEN` auf
    // 14, waehrend `kgui` schon sechzehn Zeilen schickte. Die beiden
    // letzten landeten damit in einer DRITTEN Spalte bei x=2364 --
    // ausserhalb des schwarzen Grundes, mitten auf dem Schreibtisch,
    // gruen auf blau. Zwei Zahlen fuer eine Sache, schon wieder. Die
    // Klemme hier sorgt dafuer, dass eine solche Zeile schlimmstenfalls
    // eine andere ueberschreibt, statt aus der Tafel zu fallen.
    var kol: u64 = zeile / mess_projespalte(state)
    if kol >= mess_kol(state) {
        kol = mess_kol(state) - 1
    }
    return kol * measure_width(state, MESS_SPALTEN)
}

fn messzeile_y(state: u64, zeile: u64) -> u64 {
    let k: u64 = messk(state)
    return k + (zeile % mess_projespalte(state)) * font.GLYPH_H * k
}

fn messzeile_h(state: u64) -> u64 {
    return font.GLYPH_H * messk(state)
}

fn measure_reason(state: u64, lines: u64, spalten: u64) {
    if !fb.ready(state) {
        return
    }
    let k: u64 = messk(state)
    let hoehe: u64 = messhoehe(state, lines)
    if hoehe >= fb.height(state) {
        return
    }
    let breite: u64 = mess_vollbreite(state)
    fb.fill(state, 0, 0, breite, hoehe, fb.rgb(state, 0x00, 0x00, 0x00))
    // Die Trennlinie unten -- damit die Tafel auf einem Foto eine
    // KANTE hat und nicht in den Schreibtisch ausfranst.
    let rand: u64 = fb.rgb(state, 0xFF, 0xE0, 0x00)
    fb.fill(state, 0, hoehe - k, breite, k, rand)
    fb.dirty(state, 0, hoehe)
}

// EINE ZEILE. `zeile` zaehlt ab null, `fg` ist die Farbe.
fn messzeile(state: u64, zeile: u64, p: u64, n: u64, fg: u64) {
    if !fb.ready(state) {
        return
    }
    // RUNDE LEISTE: DER RIEGEL. Eine Zeile, die es nicht gibt, wird
    // nicht gemalt -- statt an einer ausgerechneten Stelle ausserhalb
    // des Bandes zu landen. Siehe MESS_ZEILEN.
    if zeile >= MEASURE_LINES {
        return
    }
    let k: u64 = messk(state)
    let gw: u64 = font.GLYPH_W * k
    let gh: u64 = font.GLYPH_H * k
    let y0: u64 = messzeile_y(state, zeile)
    let x0: u64 = messzeile_x(state, zeile)
    if y0 + gh >= fb.height(state) || x0 >= fb.width(state) {
        return
    }
    // ============ RUNDE BLECHZWEI: DIE ZEILE ZUERST LOESCHEN.
    //
    // Justin fotografiert ein DOPPELBILD: alte und neue Zeichen an
    // derselben Stelle uebereinander. Bis zu dieser Runde loeschte nur
    // `mess_grund` den Grund, und `mess_grund` malt einen Balken ueber
    // ALLE Zeilen -- das ist teuer, und im Streifenbetrieb hat es die
    // Unterbrechung mitten hineingeschlagen (siehe `fb.flush_stripe`).
    // Wird eine Zahl kuerzer ("MAL 130" -> "MAL 61"), stehen die alten
    // Ziffern rechts daneben weiter da.
    //
    // Jetzt loescht JEDE Zeile ihr eigenes Feld, unmittelbar bevor sie
    // gemalt wird. Es kostet einen Balken je Zeile statt einen fuer
    // alle -- dieselbe Flaeche, aber lueckenlos.
    var breite: u64 = measure_width(state, MESS_SPALTEN)
    if x0 + breite > fb.width(state) {
        breite = fb.width(state) - x0
    }
    fb.fill(state, x0, y0, breite, gh, fb.rgb(state, 0x00, 0x00, 0x00))
    var i: u64 = 0
    var x: u64 = x0 + k
    while i < n && x + gw <= x0 + breite {
        let ch: u64 = kstate.get8(p + i)
        var r: u64 = 0
        while r < font.GLYPH_H {
            let bits: u64 = font.row(state + fb.FONT_OFF, ch, r)
            var c: u64 = 0
            while c < font.GLYPH_W {
                if (bits & (1 << (7 - c))) != 0 {
                    var dy: u64 = 0
                    while dy < k {
                        var dx: u64 = 0
                        while dx < k {
                            fb.pixel(state, x + c * k + dx,
                                y0 + r * k + dy, fg)
                            dx = dx + 1
                        }
                        dy = dy + 1
                    }
                }
                c = c + 1
            }
            r = r + 1
        }
        x = x + gw
        i = i + 1
    }
    fb.dirty(state, y0, y0 + gh)
}

// DIE FARBEN DER TAFEL. Gruen: hier kam etwas an. Rot: hier nicht.
fn mess_gruen(state: u64) -> u64 {
    return fb.rgb(state, 0x00, 0xFF, 0x66)
}

fn mess_rot(state: u64) -> u64 {
    return fb.rgb(state, 0xFF, 0x40, 0x40)
}

fn mess_weiss(state: u64) -> u64 {
    return fb.rgb(state, 0xFF, 0xFF, 0xFF)
}

fn mess_gelb(state: u64) -> u64 {
    return fb.rgb(state, 0xFF, 0xE0, 0x00)
}

// Gruen, wenn der Zaehler laeuft -- sonst rot.
fn mess_ampel(state: u64, v: u64) -> u64 {
    if v == 0 {
        return mess_rot(state)
    }
    return mess_gruen(state)
}

// DIE ALTE EINZEILIGE FASSUNG, unveraendert im Verhalten: sie malt
// ihren eigenen Grund und steht in Zeile null. Sie bleibt, weil die
// Runde FASSUNG mit ihr belegt hat, dass eine Zeile ueber `compose`
// hinweg stehenbleibt, und weil ein Kern ohne Tafel (Selbsttest) sie
// weiter braucht.
fn messleiste(state: u64, p: u64, n: u64) {
    measure_reason(state, 1, n + 1)
    messzeile(state, 0, p, n, mess_gruen(state))
}

fn paint_cursor(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    // ======================================== RUNDE ECHTHARDWARE-4
    // DREI LAGEN MIT DECKUNG STATT ZWEI BITMASKEN.
    //
    // Vorher: je Bildpunkt ein Bit Fuellung und ein Bit Umriss, jedes
    // Bit bei Vervielfachung 2 zu einem 2x2-Block aufgeblasen. Kein
    // Zwischenwert, also keine Kantenglaettung -- und bei doppelter
    // Vervielfachung doppelt so grobe Treppen.
    //
    // Jetzt liefert `zeiger.fi` je Bildpunkt DREI Deckungen (Kern,
    // Rand, Schatten), gerastert in Zielgroesse mit neun Proben. Sie
    // werden von hinten nach vorn ueber das fertige Bild gelegt:
    //   Schatten, schwarz und schwach -- er hebt den Zeiger ab,
    //   Rand, weiss -- damit er auf dunklem Grund sichtbar bleibt,
    //   Kern, dunkel -- damit er auf hellem Grund sichtbar bleibt.
    let form: u64 = gs(state, S_SHAPE)
    let g: u64 = cur_w(state)
    cursor.karte_bauen(form, g)
    let mx: i64 = gs(state, S_CURX) as i64 - cur_ox(state) as i64
    let my: i64 = gs(state, S_CURY) as i64 - cur_oy(state) as i64
    let dunkel: u64 = rgb24(state, CURSOR_EDGE)
    let hell: u64 = rgb24(state, CURSOR_BODY)
    let schwarz: u64 = rgb24(state, 0)
    var r: u64 = 0
    while r < g {
        let py: i64 = my + r as i64
        if py >= cy0 as i64 && py < cy1 as i64 {
            var c: u64 = 0
            while c < g {
                let pxx: i64 = mx + c as i64
                if pxx >= cx0 as i64 && pxx < cx1 as i64 && pxx >= 0 {
                    let v: u64 = cursor.deck(g, c, r)
                    if v != 0 {
                        let ak: u64 = (v >> 16) & 255
                        let ar: u64 = (v >> 8) & 255
                        let asch: u64 = v & 255
                        // Der Schatten deckt hoechstens zu einem
                        // Drittel. Mehr sieht nach Rand aus, und dann
                        // haette der Zeiger zwei davon.
                        if asch != 0 && ak == 0 && ar == 0 {
                            fb.pixel_a(state, pxx as u64, py as u64,
                                schwarz, asch * 90 / 255)
                        }
                        if ar != 0 {
                            fb.pixel_a(state, pxx as u64, py as u64,
                                hell, ar)
                        }
                        if ak != 0 {
                            fb.pixel_a(state, pxx as u64, py as u64,
                                dunkel, ak)
                        }
                    }
                }
                c = c + 1
            }
        }
        r = r + 1
    }
}

// ------------------------------------------------------- die Ereignisse

fn ev_at(state: u64, i: u64, k: u64) -> u64 {
    return state + kstate.DSK_OFF + EV_OFF + i * EV_RING
        + (k % EV_SLOTS) * EV_BYTES
}

// ================================================== RUNDE EXPLORER-2
//
// WELCHE UMSCHALTTASTEN BEIM KLICK UNTEN WAREN.
//
// Ein Klick trug bis zu dieser Runde nur die Maustasten (Bit 0..2 aus
// `ps2m`). Damit ist Strg-Klick von einem gewoehnlichen Klick nicht zu
// unterscheiden -- und Strg-Klick und Umschalt-Klick sind die beiden
// Griffe, mit denen ein Mensch in JEDEM Dateimanager mehrere Stuecke
// auswaehlt.
//
// Die Tastenmaske hat oberhalb der drei Maustasten Platz; also gehen
// die zwei Umschalttasten in Bit 3 und Bit 4 mit. Kein zweiter Weg,
// kein neues Ereignis -- ein Programm, das die neuen Bits nicht kennt,
// sieht dieselbe Maske wie vorher, weil es nur die unteren drei prueft.
const M_SHIFT: u64 = 8
const M_CTRL: u64 = 16

fn mods_of(state: u64) -> u64 {
    var m: u64 = 0
    if kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1 {
        m = m | M_SHIFT
    }
    if kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 1 {
        m = m | M_CTRL
    }
    return m
}

fn ev_push(state: u64, i: u64, typ: u64, a: u64, b: u64, c: u64) {
    if !valid(state, i) {
        return
    }
    if typ == E_KEY {
        wsv(state, i, W_KEYS, wg(state, i, W_KEYS) + 1)
    }
    // ====================================================== RUNDE BLECH2
    // EIN RING OHNE ABHOLER IST KEIN RING.
    //
    // Justins Tafel vom 05.09. 22:46: `4 RING 5226 VERL 1283` -- ein
    // Viertel aller Ereignisse aus dem Fensterring gefallen, in QEMU
    // stand dort immer 0. Der Grund ist nicht die Ringgroesse und nicht
    // ein langsamer Abholer, sondern EIN FENSTER OHNE ABHOLER: das
    // Terminalfenster legt der KERN an (`kgui`), seine Tasten gehen
    // ueber `key_tty` an die Zeilendisziplin, und aus seinem Ring holt
    // NIEMAND -- der einzige `ev_pop` sitzt im Systemaufruf WM_EVENT,
    // und dazu braucht es ein Ring-3-Programm mit einem Handle darauf.
    // Jede Bewegung ueber dem Terminal ging trotzdem in den Ring; nach
    // 32 Stueck fiel fuer jede weitere die aelteste heraus, und der
    // Zaehler VERL zaehlte einen Verlust, der keiner war. In QEMU faehrt
    // kein Laeufer die Maus ueber das Terminal -- deshalb dort 0.
    //
    // Ein Terminalfenster mit gebundenem tty (W_TTY) bekommt deshalb
    // nichts eingereiht: gezaehlt (S_EVTERM, und W_KEYS wie bisher),
    // sonst nichts. Das Terminal des Selbsttests hat kein tty und
    // verhaelt sich wie vorher.
    if wg(state, i, W_KIND) == K_TERM && wg(state, i, W_TTY) != 0 {
        ss(state, S_EVTERM, gs(state, S_EVTERM) + 1)
        return
    }
    let kopf: u64 = wg(state, i, W_EHEAD)
    let schwanz: u64 = wg(state, i, W_ETAIL)
    let daten: u64 = ((a & 0xFFFF) << 32) | ((b & 0xFFFF) << 16)
        | (c & 0xFFFF)
    // KOALESZENZ DER BEWEGUNG. Eine Maus mit 1000 Berichten je Sekunde
    // legt in die 25 ms, die die Leiste zwischen zwei Abholrunden
    // schlaeft, 25 Bewegungen -- der Ring hat 32 Plaetze, und ein
    // Anstrich dazwischen reicht fuer den Ueberlauf. Von einer Bewegung
    // interessiert eine Anwendung aber nur die LETZTE Stelle: liegt als
    // juengstes, noch nicht abgeholtes Ereignis schon ein E_MOVE, wird
    // es ueberschrieben statt eines neuen eingereiht. Tasten, Klicks,
    // Schliessen, Fokus, Groesse: jedes ein eigener Platz, nie verworfen.
    //
    // Der Abholer liest Art und Daten eines Platzes und rueckt danach
    // den Schwanz vor; wird das Datenwort waehrenddessen ueberschrieben,
    // liest er die neuere Stelle -- auch das ist die richtige.
    if typ == E_MOVE && kopf > schwanz {
        let letzt: u64 = ev_at(state, i, kopf - 1)
        if kstate.get(letzt, 0) == E_MOVE {
            kstate.set(letzt, 8, daten)
            ss(state, S_EVKOAL, gs(state, S_EVKOAL) + 1)
            return
        }
    }
    if kopf - schwanz >= EV_SLOTS {
        // ============================================ RUNDE ECHTHARDWARE-3
        // WENN DER RING VOLL IST, FLIEGT KEINE TASTE MEHR RAUS.
        //
        // Justins Tafel: `4 RING 3663 VERL 151`. Bis hierher verlor
        // ein voller Ring IMMER das aelteste Ereignis -- und weil in
        // einem vollen Ring fast nur Mausbewegungen liegen (die Maus
        // meldet tausendmal je Sekunde, ein Mensch tippt fuenfmal),
        // war das aelteste fast immer eine Bewegung. Fast immer, aber
        // eben nicht immer: stand vorn ein TASTENDRUCK, war er weg,
        // und der Mensch sieht einen verschluckten Buchstaben.
        //
        // Eine Bewegung darf man verlieren -- die naechste sagt
        // dasselbe und mehr. Eine TASTE nicht: sie kommt nie wieder.
        // Also wird der Ring von vorn nach der ersten BEWEGUNG
        // durchsucht und die geopfert; nur wenn wirklich keine drin
        // steht (32 Tasten ohne eine Abholrunde -- ein Programm, das
        // steht), faellt das aelteste Ereignis.
        var op: u64 = schwanz
        var weg: u64 = kopf // kopf = "nichts gefunden"
        while op < kopf {
            if kstate.get(ev_at(state, i, op), 0) == E_MOVE {
                weg = op
                op = kopf
            } else {
                op = op + 1
            }
        }
        if weg < kopf {
            // Die Bewegung herausnehmen und alles danach eine Stelle
            // nach vorn ruecken. Der Kopf sinkt um eins, der Schwanz
            // bleibt -- die Reihenfolge der Tasten bleibt erhalten.
            var q: u64 = weg
            while q + 1 < kopf {
                let a1: u64 = ev_at(state, i, q)
                let b1: u64 = ev_at(state, i, q + 1)
                kstate.set(a1, 0, kstate.get(b1, 0))
                kstate.set(a1, 8, kstate.get(b1, 8))
                q = q + 1
            }
            wsv(state, i, W_EHEAD, kopf - 1)
            ss(state, S_EVKOAL, gs(state, S_EVKOAL) + 1)
        } else {
            // ================================ RUNDE ECHTHARDWARE-5
            // WER VERLIERT, WIRD BEIM NAMEN GENANNT.
            //
            // Justins Tafel: `RING 917 VERL 29`. `VERL` sagt nur, DASS
            // etwas verlorenging -- nicht, WESSEN Ring ueberlief, und
            // ohne das ist der Befund nicht zu beheben. Ein Verlust
            // hier heisst: der Ring dieses Fensters ist voll UND es
            // steht keine einzige Bewegung darin, die man opfern
            // koennte. Das ist immer ein Fenster, das seine Ereignisse
            // NICHT ABHOLT -- 32 Tasten/Klicks ohne eine Abholrunde.
            //
            // Die Zeile nennt Fenster, Kennung, Art und wie viele
            // Ereignisse anstehen. Damit ist der Schuldige eine
            // Ablesung und keine Vermutung.
            // ==================================== RUNDE ECHTHARDWARE-6
            // DIESE ZEILE WIRD GEDECKELT -- SIE WAR SELBST EIN TEIL
            // DES FEHLERS, DEN SIE MELDET.
            //
            // Justins Tafel nach 42 Minuten: `RING 23320 VERL 8908
            // KOAL 57944`. Achttausendneunhundert Verluste heissen
            // achttausendneunhundert Zeilen ueber die serielle
            // Leitung -- byteweise, blockierend, und zwar AUS
            // `ev_push`, das aus dem Unterbrechungsweg der Maus
            // gerufen wird. Jede gemeldete verlorene Bewegung kostet
            // dabei so viel Zeit, dass die naechsten Bewegungen
            // ebenfalls nicht abgeholt werden. Die Meldung erzeugt
            // also genau den Zustand, den sie beschreibt.
            //
            // Dasselbe Muster wie beim Taskmanager in dieser Runde:
            // ein Messausgang, der im Normalbetrieb laeuft, misst vor
            // allem sich selbst.
            //
            // Die ersten VERL_SAGEN Verluste werden weiter voll
            // gemeldet -- damit bleibt der Schuldige eine Ablesung und
            // keine Vermutung, und genau dafuer ist die Zeile da.
            // Danach zaehlt nur noch `S_EVDROP`, und die Zahl steht
            // auf der Tafel.
            if gs(state, S_EVDROP) < VERL_SAY {
            var s_vl: [u8; 19] = "wm: RINGVERLUST i=\0"
            var s_vid: [u8; 5] = " id=\0"
            var s_vt: [u8; 6] = " typ=\0"
            var s_vk: [u8; 7] = " kind=\0"
            var s_vn: [u8; 5] = " an=\0"
            serial.puts((&s_vl[0]) as u64)
            serial.dec(i)
            serial.puts((&s_vid[0]) as u64)
            serial.dec(wg(state, i, W_ID))
            serial.puts((&s_vt[0]) as u64)
            serial.dec(typ)
            serial.puts((&s_vk[0]) as u64)
            serial.dec(wg(state, i, W_KIND))
            serial.puts((&s_vn[0]) as u64)
            serial.dec(kopf - schwanz)
            serial.nl()
            }
            wsv(state, i, W_ETAIL, schwanz + 1)
            ss(state, S_EVDROP, gs(state, S_EVDROP) + 1)
        }
    }
    let kopf2: u64 = wg(state, i, W_EHEAD)
    let p: u64 = ev_at(state, i, kopf2)
    kstate.set(p, 0, typ)
    kstate.set(p, 8, daten)
    wsv(state, i, W_EHEAD, kopf2 + 1)
    // RUNDE MESSTAFEL, Stufe 4a: hier verlaesst das Ereignis den Kern.
    ss(state, S_EVPUSH, gs(state, S_EVPUSH) + 1)
}

fn ev_waiting(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return 0
    }
    return wg(state, i, W_EHEAD) - wg(state, i, W_ETAIL)
}

// Holt ein Ereignis. `out` bekommt zwei Achtoktettworte: Art und Daten.
fn ev_pop(state: u64, i: u64, out: u64) -> bool {
    if ev_waiting(state, i) == 0 {
        return false
    }
    let schwanz: u64 = wg(state, i, W_ETAIL)
    let p: u64 = ev_at(state, i, schwanz)
    kstate.set(out, 0, kstate.get(p, 0))
    kstate.set(out, 8, kstate.get(p, 8))
    wsv(state, i, W_ETAIL, schwanz + 1)
    // RUNDE MESSTAFEL, Stufe 4b: und hier holt es ein Programm ab.
    // Diese Zeile ist der einzige Beleg dafuer, dass ueberhaupt noch
    // ein Ring-3-Prozess laeuft.
    ss(state, S_EVPOP, gs(state, S_EVPOP) + 1)
    return true
}

// ------------------------------------------------------- die Eingabe

// Welches Fenster liegt an dieser Stelle -- das OBERSTE. Gibt MAX_WIN,
// wenn dort der Hintergrund ist.
fn hit(state: u64, x: i64, y: i64) -> u64 {
    var z: u64 = gs(state, S_COUNT)
    while z > 0 {
        z = z - 1
        let i: u64 = at_z(state, z)
        // ================================== RUNDE ECHTHARDWARE-3
        // EINE BLASE NIMMT KEINEN KLICK. Sie liegt ueber allem, damit
        // man sie SIEHT -- wer dorthin klickt, meint das, was darunter
        // liegt. Ohne diese Bedingung faengt die Blase den Klick weg,
        // und der Knopf darunter tut nichts.
        if i < MAX_WIN && wg(state, i, W_LAYER) != L_TIP
            && (wg(state, i, W_FLAGS) & (F_HIDDEN | F_TABBED)) == 0 {
            let rx: i64 = win_x(state, i) + outer_w(state, i) as i64
            let ry: i64 = win_y(state, i) + outer_h(state, i) as i64
            if x >= win_x(state, i) && y >= win_y(state, i) {
                if x < rx && y < ry {
                    return i
                }
            }
        }
    }
    return MAX_WIN
}

// Der Zeiger hat sich bewegt oder eine Taste gewechselt. Wird aus der
// Unterbrechungsbehandlung heraus gerufen; alles, was hier passiert,
// muss ohne Warten auskommen.
fn on_mouse(state: u64) {
    if !ready(state) {
        return
    }
    let nx: u64 = ps2m.x(state)
    let ny: u64 = ps2m.y(state)
    let ox: u64 = gs(state, S_CURX)
    let oy: u64 = gs(state, S_CURY)
    let btn: u64 = ps2m.buttons(state)
    if nx != ox || ny != oy {
        // DIE WIEDERHERSTELLUNG DES HINTERGRUNDS. Beide Rechtecke --
        // das alte und das neue -- werden schmutzig; `compose` malt
        // dort den Hintergrund und die Fenster neu und danach den
        // Zeiger. Ein gerettetes Rechteck waere der zweite Weg dahin
        // und muesste bei jedem Fensterwechsel nachgezogen werden.
        // RUNDE ECHTHARDWARE-4: der Griffpunkt gehoert in beide
        // Rechtecke. Ohne ihn bliebe bei jeder Form ausser dem Pfeil
        // ein Streifen des alten Bildes stehen -- genau die "Spuren",
        // nach denen Justin gefragt hat.
        let gx: u64 = cur_ox(state)
        let gy: u64 = cur_oy(state)
        let gw: u64 = cur_w(state)
        damage(state, ox as i64 - gx as i64, oy as i64 - gy as i64,
            (ox + gw) as i64 - gx as i64, (oy + gw) as i64 - gy as i64)
        ss(state, S_CURX, nx)
        ss(state, S_CURY, ny)
        damage(state, nx as i64 - gx as i64, ny as i64 - gy as i64,
            (nx + gw) as i64 - gx as i64, (ny + gw) as i64 - gy as i64)
    }
    let x: i64 = nx as i64
    let y: i64 = ny as i64
    // Ziehen
    if gs(state, S_DRAG) != 0 {
        let i: u64 = gs(state, S_DRAG) - 1
        if (btn & ps2m.B_LEFT) == 0 {
            ss(state, S_DRAG, 0)
            drag_end(state, i, x, y)
        } else {
            move_win(state, i, x - gs(state, S_DRAGX) as i64,
                y - gs(state, S_DRAGY) as i64)
            drag_hover(state, i, x, y)
            return
        }
    }
    if gs(state, S_SIZING) != 0 {
        let i: u64 = gs(state, S_SIZING) - 1
        if (btn & ps2m.B_LEFT) == 0 {
            ss(state, S_SIZING, 0)
        } else {
            // RUNDE TILING: ein Fenster IM BAUM wird nicht frei
            // gezogen -- es verschiebt die Trennlinie.
            if wg(state, i, W_NODE) != 0 {
                tile_drag_resize(state, i, x, y)
                return
            }
            // RUNDE DESKTOP: der Rand kommt aus `inx`/`iny` und nicht
            // aus BORDER/TITLE_H -- ein Fenster ohne Schmuck (F_NODECO,
            // Schreibtisch und Taskleiste) hat keinen.
            // ==================================== RUNDE ECHTHARDWARE-5
            // GEGEN DEN ANKER RECHNEN, NICHT GEGEN DIE LINKE OBERE ECKE.
            //
            // Hier stand `x - win_x(...)`: die neue Breite war immer der
            // Abstand vom LINKEN Rand zum Zeiger. Fuer die rechte Kante
            // ist das richtig; fuer die linke ist es genau verkehrt
            // herum, und fuer die obere ebenso. Das ist der ganze Grund,
            // warum bei Justin nur rechts (und unten) etwas passierte.
            //
            // Jetzt: die angefasste Kante folgt dem Zeiger, die
            // GEGENUEBERLIEGENDE steht fest. Aus beiden ergibt sich die
            // Groesse -- und, wenn links oder oben gezogen wurde, ein
            // neuer Ursprung. Beides wird in EINEM Schritt gesetzt,
            // sonst zappelt das Fenster.
            let kanten: u64 = gs(state, S_SZEDGE)
            let ax: i64 = gs(state, S_SZAX) as i64
            let ay: i64 = gs(state, S_SZAY) as i64
            let ix: i64 = inx(state, i) as i64
            let iy: i64 = iny(state, i) as i64
            var nw: i64 = gs(state, S_SZAW) as i64
            var nh: i64 = gs(state, S_SZAH) as i64
            var nx: i64 = win_x(state, i)
            var ny: i64 = win_y(state, i)
            // RUNDE ECHTHARDWARE-6: der Zustand VOR dem Zug, fuer die
            // Meldung weiter unten.
            let alt_w: u64 = wg(state, i, W_W)
            let alt_h: u64 = wg(state, i, W_H)
            let alt_x: i64 = win_x(state, i)
            let alt_y: i64 = win_y(state, i)
            if (kanten & SZ_R) != 0 {
                nw = x - (win_x(state, i) + ix)
            } else if (kanten & SZ_L) != 0 {
                // Die rechte Kante steht bei `ax`; der Zeiger ist die
                // neue linke. Die Breite ist der Abstand dazwischen.
                nw = ax - x
            }
            if (kanten & SZ_B) != 0 {
                nh = y - (win_y(state, i) + iy)
            } else if (kanten & SZ_T) != 0 {
                nh = ay - y
            }
            // DIE MINDESTGROESSE, UND ZWAR VOR DEM VERSCHIEBEN.
            // Wer sie erst danach begrenzt, laesst das Fenster beim
            // Unterschreiten weiterwandern, obwohl es nicht mehr
            // schrumpft -- das ist das "Springen", das Justin
            // ausdruecklich nicht will.
            // DIESELBE UNTERGRENZE, DIE `resize_win` SELBST ZIEHT
            // (32x16 mit Schmuck, 1x1 ohne) -- hier noch einmal, weil
            // sie VOR dem Verschieben gebraucht wird und nicht erst
            // beim Ablehnen.
            var minw: i64 = 32
            var minh: i64 = 16
            if !win_deco(state, i) {
                minw = 1
                minh = 1
            }
            if nw < minw {
                nw = minw
            }
            if nh < minh {
                nh = minh
            }
            if (kanten & SZ_L) != 0 {
                nx = ax - nw - ix
            }
            if (kanten & SZ_T) != 0 {
                ny = ay - nh - iy
            }
            // ==================================== RUNDE ECHTHARDWARE-5
            // NICHT UEBER DEN LINKEN ODER OBEREN RAND HINAUS.
            //
            // GEMESSEN in dieser Runde: zieht man die linke Kante ueber
            // den Bildschirmrand, wird `nx` negativ (der Server meldete
            // `x=18446744073709551608`, also -8 als Zweierkomplement),
            // und der naechste Anstrich rechnet mit einer Adresse
            // ausserhalb des Rahmenpuffers. Ein Fenster, das man aus
            // dem Schirm herausziehen kann, ist kein Fenster mehr.
            //
            // Also: der Ursprung bleibt auf dem Schirm, und die Breite
            // wird entsprechend gekappt -- die angefasste Kante bleibt
            // damit unter dem Zeiger, bis der Rand erreicht ist, und
            // steht dann still.
            if (kanten & SZ_L) != 0 && nx < 0 {
                nw = nw + nx
                nx = 0
                if nw < minw {
                    nw = minw
                }
            }
            if (kanten & SZ_T) != 0 && ny < 0 {
                nh = nh + ny
                ny = 0
                if nh < minh {
                    nh = minh
                }
            }
            // RUNDE ECHTHARDWARE-5: die Spur des Ziehens. Ohne sie
            // ist "die Groesse aendert sich nicht" nicht von "die
            // Kante wurde nie angefasst" zu unterscheiden.
            var s_sz: [u8; 12] = "wm: zieh k=\0"
            var s_szw: [u8; 5] = " w=\0\0"
            var s_szh: [u8; 5] = " h=\0\0"
            var s_szx: [u8; 5] = " x=\0\0"
            var s_szr: [u8; 6] = " rc=\0\0"
            serial.puts((&s_sz[0]) as u64)
            serial.dec(kanten)
            serial.puts((&s_szw[0]) as u64)
            serial.dec(nw as u64)
            serial.puts((&s_szh[0]) as u64)
            serial.dec(nh as u64)
            serial.puts((&s_szx[0]) as u64)
            serial.dec(nx as u64)
            let ok: bool = resize_win(state, i, nw as u64, nh as u64)
            // ==================================== RUNDE ECHTHARDWARE-6
            // WAS DAS FENSTER VORHER WAR. Ohne diese vier Zahlen ist
            // `rc=1` nur eine Zusage: `resize_win` gibt auch dann true,
            // wenn es die Groesse auf die Untergrenze gekappt hat, und
            // von aussen sieht "gekappt" wie "nicht gewirkt" aus.
            // Justins Befund B ist genau diese Unterscheidung.
            var s_va: [u8; 8] = " vorw=\0\0"
            var s_vb: [u8; 8] = " vorh=\0\0"
            var s_vx: [u8; 8] = " vorx=\0\0"
            var s_vy: [u8; 8] = " vory=\0\0"
            serial.puts((&s_va[0]) as u64)
            serial.dec(alt_w)
            serial.puts((&s_vb[0]) as u64)
            serial.dec(alt_h)
            serial.puts((&s_vx[0]) as u64)
            serial.dec(alt_x as u64)
            serial.puts((&s_vy[0]) as u64)
            serial.dec(alt_y as u64)
            serial.puts((&s_szr[0]) as u64)
            if ok {
                serial.dec(1)
            } else {
                serial.dec(0)
            }
            serial.nl()
            if ok {
                if (kanten & SZ_L) != 0 || (kanten & SZ_T) != 0 {
                    move_win(state, i, nx, ny)
                }
            }
            return
        }
    }
    ss(state, S_MOVES, gs(state, S_MOVES) + 1)
    let i: u64 = hit(state, x, y)
    // RUNDE SOFTUI: der Ueberfahr-Zustand der drei Schaltflaechen. Er
    // steht VOR dem Ausstieg fuer "kein Fenster getroffen", denn genau
    // dann muss er zurueckgesetzt werden -- sonst bleibt der rote
    // Schliessen-Knopf rot, nachdem der Zeiger das Fenster verlassen
    // hat.
    cap_track(state, i, x, y)
    // RUNDE ECHTHARDWARE-4: die Form des Zeigers folgt dem, worueber
    // er steht. Der Aufruf steht VOR dem Ausstieg fuer "kein Fenster
    // getroffen" -- sonst bliebe der Doppelpfeil stehen, wenn man vom
    // Fensterrand auf den Schreibtisch faehrt.
    margin_cursor(state, i, x, y)
    if i >= MAX_WIN {
        return
    }
    // RUNDE ALLTAG: waehrend die Sperre steht, bekommt nur der Sperrer
    // etwas. Die Bewegung des Zeigers selbst laeuft weiter (sonst
    // klebte er fest), die EREIGNISSE gehen nicht hinaus.
    input_seen(state)
    if !darf(state, i) {
        return
    }
    ss(state, S_HITS, gs(state, S_HITS) + 1)
    let lokal_x: i64 = x - win_x(state, i) - inx(state, i) as i64
    let lokal_y: i64 = y - win_y(state, i) - iny(state, i) as i64
    let mit_schmuck: bool = deko(state, i)
    // Tastenwechsel erkennen: `ps2m` fuehrt den Zustand, hier steht der
    // zuletzt GESEHENE.
    let alt: u64 = gs(state, S_KEYS) & 7
    if btn != alt {
        ss(state, S_KEYS, (gs(state, S_KEYS) & ~7) | btn)
        if (btn & ps2m.B_LEFT) != 0 && (alt & ps2m.B_LEFT) == 0 {
            raise_win(state, i)
            // RUNDE DESKTOP: SCHREIBTISCH UND TASKLEISTE NEHMEN DIE
            // TASTATUR NICHT. Wer auf die Leiste klickt, will ein
            // Fenster wechseln und nicht in die Leiste tippen -- und
            // ein Schreibtisch, der den Fokus an sich zieht, macht
            // jeden Tastendruck danach wirkungslos.
            // RUNDE ECHTHARDWARE-1: ... ODER WENN DAS FENSTER
            // AUSDRUECKLICH DARUM GEBETEN HAT (F_KEYS).
            if wg(state, i, W_LAYER) == L_NORMAL
                || (wg(state, i, W_FLAGS) & F_KEYS) != 0 {
                set_focus(state, i)
            }
            if mit_schmuck {
                // RUNDE SOFTUI: die drei Schaltflaechen, wenn die Form
                // sie verlangt. Sie liegen VOR dem Ziehen der Leiste --
                // wer auf das Kreuz klickt, will nicht schieben.
                let cn: u64 = cap_at(state, i, x, y)
                if cn < CAP_N {
                    ss(state, S_CAPHITS, gs(state, S_CAPHITS) + 1)
                    if cn == CAP_CLOSE {
                        ev_push(state, i, E_CLOSE, 0, 0, 0)
                        destroy(state, i)
                        return
                    }
                    if cn == CAP_MIN {
                        set_hidden(state, i, true)
                        return
                    }
                    let auf: bool =
                        (wg(state, i, W_FLAGS) & F_MAXIMIZED) == 0
                    let _m: bool = maximize(state, i, auf)
                    return
                }
                // Schliessfeld?
                let bx: i64 = win_x(state, i) + outer_w(state, i) as i64
                    - border(state) as i64 - close_w(state) as i64 - 3
                let by: i64 = win_y(state, i) + 4
                let im_feld: bool = form(state, FM_CAPTION) == 0
                    && x >= bx && x < bx + close_w(state) as i64
                let im_feld2: bool = y >= by && y < by + close_w(state) as i64
                if im_feld && im_feld2 {
                    ev_push(state, i, E_CLOSE, 0, 0, 0)
                    destroy(state, i)
                    return
                }
                // ================================ RUNDE ECHTHARDWARE-5
                // ALLE VIER KANTEN UND ALLE VIER ECKEN.
                //
                // Justins Befund D, woertlich: "Ziehen funktioniert nur
                // an der rechten Kante." Hier stand `am_rechts ||
                // am_unten` -- die linke und die obere Kante wurden gar
                // nicht erst angefasst. Und sie HAETTEN auch nicht
                // funktionieren koennen: `resize_win` rechnet die neue
                // Groesse aus der linken oberen Ecke, die beim Ziehen an
                // der linken Kante ja gerade die ist, die sich bewegt.
                //
                // Also wird jetzt gemerkt, WELCHE Kanten angefasst
                // wurden (Bitmaske) und WO die gegenueberliegende Kante
                // steht (`S_SZAX`/`S_SZAY`). Die Bewegung rechnet dann
                // gegen diesen Anker: die festgehaltene Kante bleibt
                // stehen, das Fenster springt nicht, und eine Ecke
                // aendert beide Achsen zugleich, weil zwei Bits gesetzt
                // sind.
                //
                // DIESE PRUEFUNG STEHT VOR DEM ZIEHEN DER TITELLEISTE,
                // und das ist der eigentliche Fix. Stuende sie danach,
                // waere die OBERE Kante nie erreichbar: `lokal_y < 0`
                // ist die Titelleiste, und die faengt jeden Klick dort
                // ab. Ein Mensch, der ein Fenster oben groesser ziehen
                // will, greift genau dorthin.
                //
                // `lokal_y` ist relativ zur ARBEITSFLAECHE: 0 ist deren
                // Oberkante, die Titelleiste liegt bei negativem
                // `lokal_y`, und der aeussere Rahmen noch darueber. Die
                // obere Greifkante ist deshalb der schmale Streifen
                // GANZ OBEN im Schmuck -- nicht die ganze Titelleiste,
                // sonst liesse sich das Fenster nicht mehr schieben.
                let rand: i64 = grip(state) as i64
                let iw: i64 = wg(state, i, W_W) as i64
                let ih: i64 = wg(state, i, W_H) as i64
                let oben: i64 = 0 - iny(state, i) as i64
                var kanten: u64 = 0
                if lokal_x > 0 - rand && lokal_x < rand {
                    kanten = kanten | SZ_L
                }
                if lokal_x >= iw - rand && lokal_x < iw + rand {
                    kanten = kanten | SZ_R
                }
                if lokal_y >= oben && lokal_y < oben + rand {
                    kanten = kanten | SZ_T
                }
                if lokal_y >= ih - rand && lokal_y < ih + rand {
                    kanten = kanten | SZ_B
                }
                // Innerhalb des Fensters SAMT Schmuck -- weiter aussen
                // gehoert der Klick nicht mehr diesem Fenster.
                let im_rahmen: bool = lokal_x > 0 - rand
                    && lokal_y >= oben
                    && lokal_x < iw + rand && lokal_y < ih + rand
                if im_rahmen && kanten != 0 {
                    ss(state, S_SIZING, i + 1)
                    ss(state, S_SZEDGE, kanten)
                    // Die Kante, die STEHENBLEIBT, in Bildschirmmass.
                    ss(state, S_SZAX,
                        (win_x(state, i) + inx(state, i) as i64 + iw) as u64)
                    ss(state, S_SZAY,
                        (win_y(state, i) + iny(state, i) as i64 + ih) as u64)
                    ss(state, S_SZAW, iw as u64)
                    ss(state, S_SZAH, ih as u64)
                    return
                }
                if lokal_y < 0 {
                    // die Titelleiste: ziehen
                    // RUNDE TILING: wer aus dem Baum gezogen wird, muss
                    // sich merken, dass er darin war.
                    drag_begin(state, i)
                    ss(state, S_DRAG, i + 1)
                    ss(state, S_DRAGX, (x - win_x(state, i)) as u64)
                    ss(state, S_DRAGY, (y - win_y(state, i)) as u64)
                    return
                }
                // ==================================== RUNDE ECHTHARDWARE-3
                // DER GRIFF WAR EIN QUADRAT VON ZWOELF BILDPUNKTEN.
                //
                // Justins Befund: "Fenstergroesse aendern funktioniert
                // nicht". Es funktionierte -- aber nur in der EINEN
                // Ecke unten rechts, und dort auf 12x12 Bildpunkten
                // (GRIP0). Auf seinem 2560x1440-Schirm mit uiscale 2
                // sind das 24x24, also ein knapper Millimeter Ziel:
                // wer den nicht trifft, ZIEHT DAS FENSTER, weil der
                // Klick daneben ein gewoehnlicher Klick ist. Das sieht
                // aus, als ginge es nicht.
                //
                // Jetzt ist der ganze RAND ein Griff: die rechte
                // Kante, die untere Kante und die Ecke dazwischen.
                // Das ist die Bedienung, die jedes andere System hat.
            }
            ss(state, S_DOWNS, gs(state, S_DOWNS) + 1)
            // RUNDE TON: der Klickton. HIER, im Fensterserver, weil
            // hier JEDER Druck der linken Taste vorbeikommt -- kein
            // Programm muss dafuer etwas tun, und keines kann ihn
            // vergessen. Ohne das Wort `audio` ist es ein Vergleich.
            audio.click(state)
            ev_push(state, i, E_DOWN, lokal_x as u64, lokal_y as u64,
                btn | mods_of(state))
            return
        }
        if (btn & ps2m.B_LEFT) == 0 && (alt & ps2m.B_LEFT) != 0 {
            ev_push(state, i, E_UP, lokal_x as u64, lokal_y as u64, alt)
            return
        }
        // RUNDE K15: DIE RECHTE TASTE. Runde K10 sah nur die linke an --
        // sie brauchte nicht mehr, und der Rest lief still ueber die
        // Zustandsmaske. Ein Kontextmenue gibt es ohne rechte Taste
        // nicht, also kommt sie hier dazu: dieselben zwei Ereignisse,
        // dieselben Ortskoordinaten, und die Tastenmaske steht wie bei
        // der linken im dritten Wort. KEIN Heben und KEIN Fokuswechsel
        // dabei -- ein Rechtsklick soll das Fenster nicht umsortieren,
        // sondern nur fragen.
        if (btn & ps2m.B_RIGHT) != 0 && (alt & ps2m.B_RIGHT) == 0 {
            if lokal_x >= 0 && lokal_y >= 0 {
                ss(state, S_DOWNS, gs(state, S_DOWNS) + 1)
                ev_push(state, i, E_DOWN, lokal_x as u64, lokal_y as u64,
                    btn | mods_of(state))
            }
            return
        }
        if (btn & ps2m.B_RIGHT) == 0 && (alt & ps2m.B_RIGHT) != 0 {
            if lokal_x >= 0 && lokal_y >= 0 {
                ev_push(state, i, E_UP, lokal_x as u64, lokal_y as u64,
                    alt)
            }
            return
        }
    }
    if lokal_x >= 0 && lokal_y >= 0 {
        ev_push(state, i, E_MOVE, lokal_x as u64, lokal_y as u64, btn)
    }
}

// Eine Taste. Sie geht an das Fenster mit dem EINGABEFOKUS -- und mit
// `nofocus` an alle, damit die Zusage darueber etwas wert ist.
// ============================================ RUNDE ALLTAG: DIE SPERRE
//
// Sie steht hier, wo die Eingabe ihren Weg zu einem Fenster nimmt --
// das ist die einzige Stelle, an der sie WIRKT. Ein Sperrbildschirm,
// der nur ein Fenster ganz vorne ist, ist ein Vorhang: das Fenster
// darunter bekommt jede Taste weiter, und wer den Vorhang abschiesst,
// steht in der Sitzung. Hier bekommt es sie nicht.
fn sperre_an(state: u64) -> bool {
    return kstate.get(state, kstate.K11_OFF + kstate.SP_ON) != 0
}

fn sperrer(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.SP_PID)
}

// Der PLATZ des Sperrers in der Aufgabentafel -- das ist die Zahl, die
// in `W_OWNER` steht. Die Prozessnummer daneben ist die, die Ring 3
// sieht; sie sind NICHT dasselbe, und der erste Anlauf hat sie
// verwechselt: der Sperrbildschirm war danach unsichtbar, weil sein
// eigenes Fenster ihm nicht zu gehoeren schien.
fn lock_space(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.SP_SLOT)
}

// Darf dieses Fenster jetzt etwas bekommen? Ohne Sperre: jedes. Mit
// Sperre: nur, was dem Sperrer gehoert.
fn darf(state: u64, i: u64) -> bool {
    if !sperre_an(state) {
        return true
    }
    let p: u64 = lock_space(state)
    if sperrer(state) == 0 {
        return false
    }
    return wg(state, i, W_OWNER) == p
}

fn input_seen(state: u64) {
    kstate.set(state, kstate.K11_OFF + kstate.SP_LAST, time.mono_ns(state))
}

fn on_key(state: u64, c: u64) {
    if !ready(state) || c == 0 {
        return
    }
    input_seen(state)
    // RUNDE MESSTAFEL, Stufe 3 fuer die Tastatur.
    ss(state, S_KEYIN, gs(state, S_KEYIN) + 1)
    if gs(state, S_NOFOCUS) != 0 {
        var i: u64 = 0
        while i < MAX_WIN {
            if wg(state, i, W_USED) != 0 && darf(state, i) {
                ev_push(state, i, E_KEY, c, 0, 0)
            }
            i = i + 1
        }
        return
    }
    // RUNDE ALLTAG: WAEHREND DER SPERRE GEHT DIE TASTE AN DEN SPERRER,
    // ohne nach dem Fokus zu fragen.
    //
    // Sein Fenster liegt auf der obersten Ebene, und Fenster dieser
    // Ebene bekommen den Fokus mit Absicht NICHT (das ist die Regel,
    // die die Taskleiste braucht). Der erste Anlauf hat deshalb jede
    // Taste weggeworfen: der Sperrbildschirm stand da und nahm kein
    // Kennwort an. Gemessen mit `sendkey`.
    if sperre_an(state) {
        var k: u64 = 0
        while k < MAX_WIN {
            if wg(state, k, W_USED) != 0 && darf(state, k) {
                ev_push(state, k, E_KEY, c, 0, 0)
                k = MAX_WIN
            } else {
                k = k + 1
            }
        }
        return
    }
    let f: u64 = focus(state)
    if f < MAX_WIN && darf(state, f) {
        ev_push(state, f, E_KEY, c, 0, 0)
    }
}

// Wird aus der Hauptschleife gerufen: hat sich am Zeiger etwas getan?
fn poll(state: u64) -> bool {
    if !ready(state) {
        return false
    }
    // RUNDE TILING: erst die Tastenkuerzel. Sie liegen im Ring, den
    // `kbd.irq` fuellt, wenn Alt gehalten wird -- der Fensterserver
    // HOLT sie ab, statt dass die Tastatur ihn kennt.
    hotkeys(state)
    // DER RUECKFALL AUF ABFRAGE, und er steht hier mit Begruendung.
    //
    // Der Baustein meldet ueber IRQ 12, und das ist der Weg, den dieser
    // Treiber geht. Es gibt aber einen Zustand, in dem die Unterbrechung
    // AUSBLEIBT und trotzdem ein Oktett bereitliegt: das Zustandstor
    // sagt dann "Ausgabepuffer voll" (Bit 0) und "vom zweiten Anschluss"
    // (Bit 5). Wer nur auf die Unterbrechung wartet, hat dann einen
    // Zeiger, der stehenbleibt, und keinen Hinweis darauf, warum.
    //
    // Also wird hier NACHGESEHEN. Wie viele Oktette auf welchem der
    // beiden Wege kamen, steht in `irqs` und `polls` und wird gemeldet
    // -- eine Abfrage, die als Unterbrechung ausgegeben wird, waere eine
    // Luege ueber den Treiber.
    if ps2m.present(state) && ps2m.polling(state) {
        var n: u64 = 0
        while n < 64 && ps2m.poll_one(state) {
            // NACH JEDEM VOLLSTAENDIGEN PAKET, nicht am Ende des
            // Stapels: ein Druck und das Loslassen danach sind zwei
            // Pakete, und wer beide zusammen abholt und DANN nachsieht,
            // findet die Taste wieder oben und hat den Klick verloren.
            if ps2m.changed(state) {
                ps2m.take_change(state)
                on_mouse(state)
            }
            n = n + 1
        }
    }
    if !ps2m.changed(state) {
        return false
    }
    ps2m.take_change(state)
    on_mouse(state)
    return true
}

// ------------------------------------------------------ das Terminal
//
// Ein Fenster mit einem ZEICHENRASTER. Die Anwendung schickt Oktette,
// der Server fuehrt dieselbe Zustandsmaschine wie `fb.putc` (Umbruch,
// Rollen, Tabulator, Ruecktaste) und malt die Zellen mit der
// Festbreitenschrift. Damit kann eine Shell in einem Fenster laufen,
// ohne von Schriften etwas zu wissen.

fn term_setup(state: u64, i: u64) {
    let f: u64 = gs(state, S_FONT_MONO)
    var cw: u64 = 8
    var ch: u64 = 16
    if f < ttf.MAX_FONTS {
        let px: u64 = gs(state, S_PX_MONO)
        let gid: u64 = ttf.glyph_of(state, f, 0x4D) // 'M'
        cw = ((ttf.advance26(state, f, gid, px) + 63) >> 6) as u64
        ch = ttf.line_height(state, f, px)
    }
    if cw == 0 {
        cw = 8
    }
    if ch == 0 {
        ch = 16
    }
    let alt_cols: u64 = wg(state, i, W_COLS)
    let alt_rows: u64 = wg(state, i, W_ROWS)
    let alt_cy: u64 = wg(state, i, W_CY)
    let alt_cx: u64 = wg(state, i, W_CX)
    wsv(state, i, W_CELLW, cw)
    wsv(state, i, W_CELLH, ch)
    let cols: u64 = wg(state, i, W_W) / cw
    let rows: u64 = wg(state, i, W_H) / ch
    wsv(state, i, W_COLS, cols)
    wsv(state, i, W_ROWS, rows)
    let neu_gitter: bool = wg(state, i, W_GRID) == 0
    if neu_gitter {
        let g0: u64 = mem.frame_run(state, 1)
        wsv(state, i, W_GRID, g0)
    }
    let g: u64 = wg(state, i, W_GRID)
    // ================================================== RUNDE ECHT
    // DER TEXT BLEIBT STEHEN, WENN MAN DAS FENSTER ZIEHT.
    //
    // Justins Befund am echten Geraet: "Terminal auf, Ausgabe da,
    // Fenster groesser ziehen -> Inhalt weg." Er hat recht, und die
    // Ursache stand genau hier: diese Funktion hat das GANZE
    // Zeichenraster mit Leerzeichen ueberschrieben und den Cursor auf
    // 0,0 gesetzt -- bei JEDEM Aufruf. `resize_win` ruft sie bei jeder
    // Groessenaenderung. Der Text war also nicht falsch umgebrochen,
    // er war GELOESCHT.
    //
    // Ein Terminal, dessen Fenster sich aendert, behaelt seinen Inhalt
    // -- das tut jedes Terminal, seit es Terminals gibt. Die Zeilen
    // werden in das neue Raster UMKOPIERT, Zeile fuer Zeile, so weit
    // sie hineinpassen. Was nicht mehr hineinpasst (schmaleres
    // Fenster), wird rechts abgeschnitten; das ist dasselbe, was xterm
    // ohne Neuumbruch tut, und es ist ehrlicher, als den Rest zu
    // loeschen.
    //
    // NUR EIN FRISCHES GITTER WIRD GELEERT. Das ist der Fall, fuer den
    // die Leerung urspruenglich gedacht war: ein neu angelegtes
    // Terminal, dessen Rahmen noch beliebigen Speicher traegt.
    if g != 0 {
        if neu_gitter || alt_cols == 0 || alt_rows == 0 {
            var k: u64 = 0
            while k < cols * rows && k < 4096 {
                kstate.set8(g + k, 32 as u8)
                k = k + 1
            }
            wsv(state, i, W_CX, 0)
            wsv(state, i, W_CY, 0)
        } else if cols != alt_cols || rows != alt_rows {
            // UMKOPIEREN, VON UNTEN NACH OBEN ODER VON OBEN NACH
            // UNTEN -- je nachdem, wohin geschoben wird, damit sich
            // Quelle und Ziel im selben Rahmen nicht ueberholen.
            // Zielzeile r liegt bei r*cols, Quellzeile bei r*alt_cols.
            // Wird das Raster BREITER, wandert jede Zeile nach hinten:
            // dann von der letzten Zeile an arbeiten.
            var lines: u64 = alt_rows
            if rows < lines {
                lines = rows
            }
            var wide: u64 = alt_cols
            if cols < wide {
                wide = cols
            }
            if cols > alt_cols {
                var r: u64 = lines
                while r > 0 {
                    r = r - 1
                    var c: u64 = wide
                    while c > 0 {
                        c = c - 1
                        let src: u64 = r * alt_cols + c
                        let dst: u64 = r * cols + c
                        if src < 4096 && dst < 4096 {
                            kstate.set8(g + dst, kstate.get8(g + src) as u8)
                        }
                    }
                    // den Rest der Zielzeile leeren
                    var c2: u64 = wide
                    while c2 < cols {
                        let d2: u64 = r * cols + c2
                        if d2 < 4096 {
                            kstate.set8(g + d2, 32 as u8)
                        }
                        c2 = c2 + 1
                    }
                }
            } else {
                var r2: u64 = 0
                while r2 < lines {
                    var c3: u64 = 0
                    while c3 < wide {
                        let s3: u64 = r2 * alt_cols + c3
                        let d3: u64 = r2 * cols + c3
                        if s3 < 4096 && d3 < 4096 {
                            kstate.set8(g + d3, kstate.get8(g + s3) as u8)
                        }
                        c3 = c3 + 1
                    }
                    var c4: u64 = wide
                    while c4 < cols {
                        let d4: u64 = r2 * cols + c4
                        if d4 < 4096 {
                            kstate.set8(g + d4, 32 as u8)
                        }
                        c4 = c4 + 1
                    }
                    r2 = r2 + 1
                }
            }
            // die neuen Zeilen unten sind leer
            var r5: u64 = lines
            while r5 < rows {
                var c5: u64 = 0
                while c5 < cols {
                    let d5: u64 = r5 * cols + c5
                    if d5 < 4096 {
                        kstate.set8(g + d5, 32 as u8)
                    }
                    c5 = c5 + 1
                }
                r5 = r5 + 1
            }
            // DER CURSOR BLEIBT, WO ER WAR -- nur in das neue Raster
            // hineingezwungen. Sonst schriebe die naechste Ausgabe
            // mitten in den stehengebliebenen Text.
            var ncx: u64 = alt_cx
            var ncy: u64 = alt_cy
            if ncx >= cols {
                ncx = cols - 1
            }
            if ncy >= rows {
                ncy = rows - 1
            }
            wsv(state, i, W_CX, ncx)
            wsv(state, i, W_CY, ncy)
        }
    }
    fill(state, i, 0, 0, wg(state, i, W_W), wg(state, i, W_H),
        wg(state, i, W_BG))
    // UND DER TEXT WIEDER AUF DIE FLAECHE. `fill` hat gerade den
    // ganzen Puffer mit der Hintergrundfarbe ueberschrieben -- ohne
    // diese Zeile stuende der gerettete Inhalt zwar im Raster, waere
    // aber nicht zu sehen, und der Fehler saehe genauso aus wie
    // vorher. Bei einem frischen Gitter malt sie lauter Leerzeichen,
    // kostet also nichts.
    term_redraw(state, i)
}

fn cell_set(state: u64, i: u64, c: u64, r: u64, ch: u64) {
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 {
        return
    }
    let k: u64 = r * wg(state, i, W_COLS) + c
    if k >= 4096 {
        return
    }
    kstate.set8(g + k, ch as u8)
}

fn cell_get(state: u64, i: u64, c: u64, r: u64) -> u64 {
    let g: u64 = wg(state, i, W_GRID)
    if g == 0 {
        return 32
    }
    let k: u64 = r * wg(state, i, W_COLS) + c
    if k >= 4096 {
        return 32
    }
    return kstate.get8(g + k)
}

// ==================================================== RUNDE ECHTHARDWARE-5
// DEN INHALT EINES TERMINALFENSTERS AUF DIE SERIELLE LEITUNG.
//
// Der Beleg fuer Justins Befund B ist ein BILD, und ein Bild von
// Text ist mit einem Programm schlecht zu lesen -- ich habe in dieser
// Runde zweimal versucht, aus Bildpunkten Buchstaben zu raten, und
// beide Male stand am Ende ein Muster, das man so oder so lesen kann.
//
// Das Fenster weiss selbst, was in ihm steht: sein Zellenraster. Diese
// Funktion schreibt es Zeile fuer Zeile hinaus, und damit ist "im
// Terminal steht eine Eingabeaufforderung" eine ABLESUNG und keine
// Deutung eines Rasters. Leerzeilen am Ende faellt sie weg.
fn term_dump(state: u64, i: u64) {
    if !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return
    }
    var s_k: [u8; 15] = "wm: termzeile \0"
    var s_g: [u8; 4] = " [\0\0"
    var s_z: [u8; 2] = "]\0"
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    var r: u64 = 0
    while r < rows {
        // Wie weit steht in dieser Zeile ueberhaupt etwas?
        var letzte: u64 = 0
        var c0: u64 = 0
        while c0 < cols {
            if cell_get(state, i, c0, r) > 32 {
                letzte = c0 + 1
            }
            c0 = c0 + 1
        }
        if letzte != 0 {
            serial.puts((&s_k[0]) as u64)
            serial.dec(r)
            serial.puts((&s_g[0]) as u64)
            var c: u64 = 0
            while c < letzte {
                let z: u64 = cell_get(state, i, c, r)
                if z >= 32 && z < 127 {
                    serial.put(z as u8)
                } else {
                    serial.put(32 as u8)
                }
                c = c + 1
            }
            serial.puts((&s_z[0]) as u64)
            serial.nl()
        }
        r = r + 1
    }
}

fn cell_paint(state: u64, i: u64, c: u64, r: u64) {
    let cw: u64 = wg(state, i, W_CELLW)
    let ch: u64 = wg(state, i, W_CELLH)
    let f: u64 = gs(state, S_FONT_MONO)
    fill(state, i, c * cw, r * ch, cw, ch, wg(state, i, W_BG))
    let z: u64 = cell_get(state, i, c, r)
    if z <= 32 || f >= ttf.MAX_FONTS {
        return
    }
    let px: u64 = gs(state, S_PX_MONO)
    let slot: u64 = ttf.glyph(state, f, z, px)
    if slot < ttf.SLOTS {
        draw_glyph_clip(state, i, slot, (c * cw) as i64,
            (r * ch) as i64 + ttf.ascent(state, f, px), wg(state, i, W_FG),
            (c * cw) as i64, ((c + 1) * cw) as i64)
    }
}

// ==================================================== RUNDE FARBE
// DAS GANZE RASTER NOCH EINMAL MALEN.
//
// Gebraucht wird das genau einmal: wenn die Taskleiste die beiden
// Terminalfarben setzt, NACHDEM das Fenster schon steht (siehe
// `set_deco_colour`). `cell_paint` fuellt je Zelle erst den Grund in
// `W_BG` und setzt dann das Zeichen in `W_FG` -- beides sind die
// NEUEN Farben, sobald sie im Fenster stehen. Also ist "alles neu
// malen" genau "jede Zelle neu malen", und es braucht keinen zweiten
// Zeichenweg, der mit dem ersten auseinanderlaufen koennte.
fn term_redraw(state: u64, i: u64) {
    if !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return
    }
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    var r: u64 = 0
    while r < rows {
        var c: u64 = 0
        while c < cols {
            cell_paint(state, i, c, r)
            c = c + 1
        }
        r = r + 1
    }
}

fn term_scroll(state: u64, i: u64) {
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    var r: u64 = 1
    while r < rows {
        var c: u64 = 0
        while c < cols {
            cell_set(state, i, c, r - 1, cell_get(state, i, c, r))
            c = c + 1
        }
        r = r + 1
    }
    var c2: u64 = 0
    while c2 < cols {
        cell_set(state, i, c2, rows - 1, 32)
        c2 = c2 + 1
    }
    // Der Bildinhalt wandert mit -- eine Zeile nach oben, statt alle
    // Zellen neu zu malen. Das ist derselbe Griff wie in `fb.scroll`.
    let cw: u64 = wg(state, i, W_CELLW)
    let ch: u64 = wg(state, i, W_CELLH)
    let ww: u64 = wg(state, i, W_W)
    let buf: u64 = wg(state, i, W_BUF)
    // RUNDE BLECHFUENF: dieselbe Zusage wie in `fill`. Hier waere sie
    // die teuerste -- `copy_words` schreibt ZEILENWEISE ab null.
    if buf == 0 || ww == 0 || ch == 0 {
        return
    }
    var y: u64 = 0
    while y + ch < rows * ch {
        copy_words(buf +% y *% ww *% 4, buf +% (y + ch) *% ww *% 4,
            ww *% 4 / 8)
        y = y + 1
    }
    fill(state, i, 0, (rows - 1) * ch, ww, ch, wg(state, i, W_BG))
}

fn term_putc(state: u64, i: u64, ch: u64) {
    let cols: u64 = wg(state, i, W_COLS)
    let rows: u64 = wg(state, i, W_ROWS)
    if cols == 0 || rows == 0 {
        return
    }
    var cx: u64 = wg(state, i, W_CX)
    var cy: u64 = wg(state, i, W_CY)
    if ch == 13 {
        wsv(state, i, W_CX, 0)
        return
    }
    if ch == 10 {
        cx = 0
        cy = cy + 1
        if cy >= rows {
            term_scroll(state, i)
            cy = rows - 1
        }
        wsv(state, i, W_CX, cx)
        wsv(state, i, W_CY, cy)
        return
    }
    if ch == 8 {
        if cx > 0 {
            cx = cx - 1
            wsv(state, i, W_CX, cx)
            cell_set(state, i, cx, cy, 32)
            cell_paint(state, i, cx, cy)
        }
        return
    }
    if ch == 9 {
        var n: u64 = 8 - (cx & 7)
        while n > 0 {
            term_putc(state, i, 32)
            n = n - 1
        }
        return
    }
    if ch < 32 || ch > 126 {
        return
    }
    cell_set(state, i, cx, cy, ch)
    cell_paint(state, i, cx, cy)
    cx = cx + 1
    if cx >= cols {
        cx = 0
        cy = cy + 1
        if cy >= rows {
            term_scroll(state, i)
            cy = rows - 1
        }
        wsv(state, i, W_CY, cy)
    }
    wsv(state, i, W_CX, cx)
}

fn term_write(state: u64, i: u64, p: u64, n: u64) -> u64 {
    if !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return 0
    }
    var k: u64 = 0
    while k < n {
        term_putc(state, i, kstate.get8(p + k))
        k = k + 1
    }
    damage_win(state, i)
    return n
}

// ------------------------------------------------------------ Zusagen

// Ein Terminalfenster an ein Terminal binden. Von da an geht `tty.emit`
// mit SINK_WINDOW hierher.
fn bind_tty(state: u64, i: u64, t: u64) {
    if !valid(state, i) {
        return
    }
    wsv(state, i, W_TTY, t + 1)
}

fn tty_of(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return NO_TTY
    }
    let t: u64 = wg(state, i, W_TTY)
    if t == 0 {
        return NO_TTY
    }
    return t - 1
}

// An WELCHES Terminal eine Taste geht: an das des Fensters mit dem
// Eingabefokus, wenn das ein Terminalfenster ist -- sonst an gar keines.
// Das ist die eine Zeile, die aus einem Bildschirm eine BEDIENBARE
// Oberflaeche macht.
fn key_tty(state: u64) -> u64 {
    if !ready(state) {
        return NO_TTY
    }
    let f: u64 = focus(state)
    if f >= MAX_WIN || wg(state, f, W_KIND) != K_TERM {
        return NO_TTY
    }
    return tty_of(state, f)
}

// EIN Oktett in ein Terminalfenster. Der Weg von `tty.emit`.
fn term_out(state: u64, i: u64, c: u64) {
    ss(state, S_TOUT, gs(state, S_TOUT) + 1)
    if !valid(state, i) || wg(state, i, W_KIND) != K_TERM {
        return
    }
    ss(state, S_TPUT, gs(state, S_TPUT) + 1)
    term_putc(state, i, c)
    damage_win(state, i)
}

// Die zwei Zaehler nach aussen, fuer die Tafel und die Abnahme.
fn term_outs(state: u64) -> u64 {
    return gs(state, S_TOUT)
}

fn term_puts_n(state: u64) -> u64 {
    return gs(state, S_TPUT)
}

fn diag1(state: u64) -> u64 {
    return gs(state, S_DIAG1)
}
fn diag2(state: u64) -> u64 {
    return gs(state, S_DIAG2)
}
fn failbits(state: u64) -> u64 {
    return gs(state, S_FAIL)
}
fn pass_ok(state: u64, nr: u64) {
    ss(state, S_FAIL, gs(state, S_FAIL) & ~(1 << nr))
}
fn selftest(state: u64) -> u64 {
    // Siehe `fokus_still`: der Selbsttest laeuft mitten in einer Zeile,
    // die `kgui` schreibt.
    fokus_still = 1
    if !ready(state) {
        return 0
    }
    var n: u64 = 0
    ss(state, S_FAIL, 0x7FFFFFFE)
    var t1: [u8; 5] = "eins\0"
    var t2: [u8; 5] = "zwei\0"
    // 1. Ein Fenster entsteht und hat eine Flaeche.
    let a: u64 = create(state, 0, 40, 40, 200, 100, K_RAW, (&t1[0]) as u64)
    if a < MAX_WIN && win_buf(state, a) != 0 {
        n = n + 1
        pass_ok(state, 1)
    }
    // 2. Ein zweites liegt DARUEBER -- die Stapelreihenfolge waechst.
    let b: u64 = create(state, 0, 100, 70, 200, 100, K_RAW, (&t2[0]) as u64)
    if b < MAX_WIN && win_z(state, b) > win_z(state, a) {
        n = n + 1
        pass_ok(state, 2)
    }
    // 3. Der Treffer an einer Stelle, an der sich beide ueberschneiden,
    //    ist das OBERE. Das ist die ganze Stapelreihenfolge in einer
    //    Zeile.
    if hit(state, 150, 100) == b {
        n = n + 1
        pass_ok(state, 3)
    }
    // 4. ... und daneben das untere.
    if hit(state, 50, 60) == a {
        n = n + 1
        pass_ok(state, 4)
    }
    // 5. Der Hintergrund ist kein Fenster.
    if hit(state, 700, 500) == MAX_WIN {
        n = n + 1
        pass_ok(state, 5)
    }
    // 6. Heben aendert die Reihenfolge wirklich.
    raise_win(state, a)
    if hit(state, 150, 100) == a && win_z(state, a) > win_z(state, b) {
        n = n + 1
        pass_ok(state, 6)
    }
    // 7. Der Fokus liegt bei genau EINEM Fenster.
    set_focus(state, b)
    if focus(state) == b {
        n = n + 1
        pass_ok(state, 7)
    }
    // 8. Eine Taste kommt beim Fenster mit dem Fokus an -- und NUR
    //    dort. Das ist die Zusage, die `nofocus` zum Einsturz bringt.
    let va: u64 = ev_waiting(state, a)
    let vb: u64 = ev_waiting(state, b)
    on_key(state, 0x41)
    if gs(state, S_NOFOCUS) == 0 {
        if ev_waiting(state, b) == vb + 1 && ev_waiting(state, a) == va {
            n = n + 1
            pass_ok(state, 8)
        }
    } else {
        if ev_waiting(state, b) == vb + 1 && ev_waiting(state, a) == va + 1 {
            n = n + 1
            pass_ok(state, 9)
        }
    }
    // 9. Und das Ereignis traegt das Zeichen, das gedrueckt wurde.
    var aus: [u8; 16] = [0 as u8; 16]
    var gefunden: bool = false
    while ev_pop(state, b, (&aus[0]) as u64) {
        if kstate.get(((&aus[0]) as u64), 0) == E_KEY {
            if (kstate.get(((&aus[0]) as u64), 8) >> 32) == 0x41 {
                gefunden = true
            }
        }
    }
    if gefunden {
        n = n + 1
        pass_ok(state, 10)
    }
    // 10. Das Malen bleibt IM Fenster: ein Bildpunkt jenseits der Kante
    //     wird nicht geschrieben, und der letzte darin schon.
    fill(state, a, 0, 0, 200, 100, 0)
    wpixel(state, a, 199, 99, PROBE_IN)
    wpixel(state, a, 200, 99, PROBE_OUT)
    if wget(state, a, 199, 99) == PROBE_IN && wget(state, a, 0, 0) == 0 {
        n = n + 1
        pass_ok(state, 11)
    }
    // 11. Verschieben aendert die Stelle, nicht den Inhalt.
    move_win(state, a, 300, 200)
    if win_x(state, a) == 300 && wget(state, a, 199, 99) == PROBE_IN {
        n = n + 1
        pass_ok(state, 12)
    }
    // 12. Der schmutzige Bereich deckt beide Stellen -- die alte und
    //     die neue. Ohne das bliebe ein Fenstergespenst stehen.
    if gs(state, S_NODIRTY) == 0 {
        if dirty_x0(state) <= 40 && dirty_x1(state) >= 300 {
            n = n + 1
            pass_ok(state, 13)
        }
    } else {
        if dirty_x0(state) == 0 && dirty_x1(state) == gs(state, S_SW) {
            n = n + 1
            pass_ok(state, 14)
        }
    }
    // 13. Ein Terminalfenster hat ein Raster, und ein Zeichen landet in
    //     der Zelle, in der es landen soll.
    var t3: [u8; 5] = "term\0"
    // RUNDE SCHIRM: die Groesse in ZELLEN, nicht in Bildpunkten. Bei
    // doppelter Oberflaechenschrift ist eine Zelle 20x38 statt 10x19,
    // und ein starres 200x100-Fenster hatte nur noch zwei Zeilen --
    // der Test schlug fehl, obwohl das Raster stimmte.
    let t: u64 = create(state, 0, 10, 300, 200 * uisc(state),
        100 * uisc(state), K_TERM,
        (&t3[0]) as u64)
    if t < MAX_WIN && term_cols(state, t) > 4 && term_rows(state, t) > 2 {
        n = n + 1
        pass_ok(state, 15)
    }
    // 14. Zeilenvorschub und Umbruch bewegen die Schreibmarke.
    if t < MAX_WIN {
        var txt: [u8; 5] = "ab\nc\0"
        term_write(state, t, (&txt[0]) as u64, 4)
        if term_cx(state, t) == 1 && term_cy(state, t) == 1 {
            n = n + 1
            pass_ok(state, 16)
        }
    }
    // 15. Schliessen gibt den Platz frei und schliesst die Luecke in der
    //     Stapelreihenfolge.
    let vorher: u64 = count(state)
    destroy(state, b)
    if count(state) == vorher - 1 && !valid(state, b) {
        var luecke: bool = false
        var z: u64 = 0
        while z < count(state) {
            if at_z(state, z) >= MAX_WIN {
                luecke = true
            }
            z = z + 1
        }
        if !luecke {
            n = n + 1
            pass_ok(state, 17)
        }
    }
    // 16. GROESSE AENDERN. Der Puffer wurde beim Anlegen fuer die
    //     angefragte Flaeche geholt; kleiner geht immer, groesser nur
    //     bis dorthin. Ein Fenster, das ueber seinen eigenen Puffer
    //     hinauswaechst, waere ein Schreibzugriff daneben -- und der
    //     faellt erst auf, wenn er etwas Wichtiges trifft.
    if resize_win(state, a, 120, 60) && win_w(state, a) == 120 {
        if !resize_win(state, a, 4096, 4096) && win_w(state, a) == 120 {
            n = n + 1
            pass_ok(state, 18)
        }
    }
    // 17. Und ein Terminalfenster rechnet sein Raster dabei NEU.
    if t < MAX_WIN {
        let vorher_cols: u64 = term_cols(state, t)
        if resize_win(state, t, 100, 60) {
            if term_cols(state, t) < vorher_cols && term_cols(state, t) > 0 {
                n = n + 1
                pass_ok(state, 19)
            }
        }
    }
    if t < MAX_WIN {
        destroy(state, t)
    }
    // ---------------------------------------------- RUNDE DESKTOP
    // 18. Ein Fenster der Ebene L_DESK liegt UNTER einem gewoehnlichen,
    //     obwohl es SPAETER angelegt wurde. Ohne Ebenen ist das
    //     unmoeglich, und genau das stand in Logbuch K15.
    var td: [u8; 6] = "tisch\0"
    let d: u64 = create(state, 0, 0, 0, 320, 200, K_RAW, (&td[0]) as u64)
    if d < MAX_WIN {
        set_layer(state, d, L_DESK)
        if win_z(state, d) < win_z(state, a) {
            n = n + 1
            pass_ok(state, 20)
        }
        // 19. Und ein Klick darauf hebt ihn NICHT ueber das andere.
        raise_win(state, d)
        if win_z(state, d) < win_z(state, a) || gs(state, S_NOLAYER) != 0 {
            n = n + 1
            pass_ok(state, 21)
        }
        // 20. Verbergen nimmt ein Fenster aus der Trefferpruefung --
        //     und Wiederherstellen bringt es zurueck. Der Puffer bleibt
        //     dabei derselbe: minimiert ist nicht geschlossen.
        let puf: u64 = win_buf(state, a)
        let vorher: u64 = hit(state, 60, 60)
        set_hidden(state, a, true)
        let nachher: u64 = hit(state, 60, 60)
        set_hidden(state, a, false)
        if gs(state, S_NOMIN) == 0 {
            if vorher == a && nachher != a && win_buf(state, a) == puf {
                n = n + 1
                pass_ok(state, 22)
            }
        } else {
            if vorher == a && nachher == a {
                n = n + 1
                pass_ok(state, 23)
            }
        }
        // 21. Ohne Schmuck ist das aeussere Rechteck die Malflaeche --
        //     keine Titelleiste, kein Rahmen.
        set_deco(state, d, false)
        if outer_w(state, d) == win_w(state, d)
            && outer_h(state, d) == win_h(state, d) && iny(state, d) == 0 {
            n = n + 1
            pass_ok(state, 24)
        }
        destroy(state, d)
    }
    // -------------------------------- ADDENDUM TASKBAR: struts and work
    // `bar` plays the taskbar, `mw` is the window that gets maximized.
    // A WINDOW OF ITS OWN AND NOT `a`, and the reason is a measurement:
    // `a` was created 200 x 100, a window never gets a bigger buffer
    // than it was created with, and `maximize` therefore refused it --
    // correctly. Five of these nine claims failed on that, and the
    // server was right every time.
    var tb: [u8; 4] = "bar\0"
    var tm: [u8; 4] = "max\0"
    let sw2: u64 = gs(state, S_SW)
    let sh2: u64 = gs(state, S_SH)
    // THIS SECTION MEASURES THE STRUTS AND THEREFORE HAS TO SWITCH THEM
    // ON, even when the machine was started with the counter-test
    // `nostrut`. It puts the setting back afterwards -- the first
    // version did not, and left the whole system with the struts
    // enabled after a `nostrut` run, so the counter-test proved nothing
    // and looked like it passed.
    let strut_was: bool = nostrut(state)
    set_nostrut(state, false)
    // 22. WITHOUT A STRUT THE WORK AREA IS THE SCREEN. Anything else
    //     and every number after this one measures the wrong rectangle.
    if work_x(state) == 0 && work_y(state) == 0
        && work_w(state) == sw2 && work_h(state) == sh2 {
        n = n + 1
        pass_ok(state, 25)
    }
    let bar: u64 = create(state, 0, 0, (sh2 - 28) as i64, sw2, 28, K_RAW,
        (&tb[0]) as u64)
    if bar < MAX_WIN {
        set_deco(state, bar, false)
        // 23. A BOTTOM STRUT OF 28 TAKES 28 ROWS OFF THE BOTTOM -- and
        //     off the bottom only. The origin does not move.
        let s23: bool = set_strut(state, bar, EDGE_BOTTOM, 28)
        if s23 && work_x(state) == 0 && work_y(state) == 0
            && work_w(state) == sw2 && work_h(state) == sh2 - 28 {
            n = n + 1
            pass_ok(state, 26)
        }
        // 24. MAXIMIZE FILLS THE WORK AREA, NOT THE SCREEN. Compared on
        //     the OUTER rectangle, because that is what covers pixels.
        let mw: u64 = create(state, 0, 40, 40, max_w(state), max_h(state),
            K_RAW,
            (&tm[0]) as u64)
        ss(state, S_DIAG1, mw)
        ss(state, S_DIAG2, 0)
        if mw < MAX_WIN {
            if maximize(state, mw, true) {
                ss(state, S_DIAG2, 1)
            }
        }
        if mw < MAX_WIN && gs(state, S_DIAG2) == 1 {
            let ox: i64 = win_x(state, mw)
            let oy: i64 = win_y(state, mw)
            let ow: u64 = outer_w(state, mw)
            let oh: u64 = outer_h(state, mw)
            if ox == work_x(state) as i64 && oy == work_y(state) as i64
                && ow == work_w(state) && oh == work_h(state) {
                n = n + 1
                pass_ok(state, 27)
            }
            // 25. AND IT DOES NOT TOUCH THE BAR. The two rectangles are
            //     disjoint: the bottom of the window is at or above the
            //     top of the bar. This is the claim of the whole
            //     addendum, and it is one comparison.
            if oy + oh as i64 <= win_y(state, bar) {
                n = n + 1
                pass_ok(state, 28)
            }
        }
        // 26. THE BAR MOVES TO THE LEFT EDGE AND THE WINDOW FOLLOWS.
        //     Nobody calls `maximize` again -- `set_strut` refits.
        move_win(state, bar, 0, 0)
        let s26: bool = resize_win(state, bar, 44, sh2)
        let _u26: bool = s26
        if set_strut(state, bar, EDGE_LEFT, 44) {
            if work_x(state) == 44 && work_y(state) == 0
                && work_w(state) == sw2 - 44 && work_h(state) == sh2 {
                n = n + 1
                pass_ok(state, 29)
            }
            if win_x(state, mw) == 44 && outer_w(state, mw) == sw2 - 44
                && outer_h(state, mw) == sh2 {
                n = n + 1
                pass_ok(state, 30)
            }
        }
        // 27. THE COUNTER-TEST: with `nostrut` the work area is the
        //     whole screen again and the maximized window covers the
        //     bar. That is the state this addendum removes.
        set_nostrut(state, true)
        let deckt: bool = win_x(state, mw) == 0
            && outer_w(state, mw) == sw2
        set_nostrut(state, false)
        if deckt && win_x(state, mw) == 44 {
            n = n + 1
            pass_ok(state, 31)
        }
        // 28. CLEARING THE STRUT GIVES THE EDGE BACK.
        let _s28: bool = set_strut(state, bar, EDGE_LEFT, 0)
        if work_x(state) == 0 && work_w(state) == sw2 {
            n = n + 1
            pass_ok(state, 32)
        }
        // 29. AND SO DOES DYING. Set it once more, then destroy.
        let _s29: bool = set_strut(state, bar, EDGE_TOP, 30)
        let vorher: u64 = work_y(state)
        destroy(state, bar)
        if vorher == 30 && work_y(state) == 0 && work_h(state) == sh2 {
            n = n + 1
            pass_ok(state, 33)
        }
        // 30. RESTORING PUTS THE WINDOW BACK WHERE IT WAS: it was
        //     created at (40, 40) with the full screen and has been
        //     maximized to two different work areas since.
        let _m30: bool = maximize(state, mw, false)
        if win_x(state, mw) == 40 && win_y(state, mw) == 40
            && win_w(state, mw) == max_w(state)
            && win_h(state, mw) == max_h(state)
            && !is_max(state, mw) {
            n = n + 1
            pass_ok(state, 34)
        }
        if mw < MAX_WIN {
            destroy(state, mw)
        }
    }
    destroy(state, a)
    set_nostrut(state, strut_was)
    damage_all(state)
    // Und die Fokusmeldung wieder an -- sie ist der Beleg fuer Alt+Tab
    // und darf nach dem Selbsttest nicht stumm bleiben.
    fokus_still = 0
    return n
}

fn selftest_max() -> u64 {
    return 30
}

// ===================================================== RUNDE TILING
//
// DER FENSTERBAUM AM FENSTERSERVER. Die Rechnung selbst steht in
// `kernel/tile.fi` und weiss von Fenstern nichts; was hier steht, ist
// die NAHT: welches Blatt gehoert zu welchem Fenster, wie kommt ein
// Rechteck aus dem Baum in einen Fenstersatz, wer malt die Reiterzeilen,
// und was passiert, wenn man ein Fenster mit der Maus irgendwohin zieht.
//
// BEIDE WELTEN NEBENEINANDER, und das ist Absicht: ein Fenster mit
// W_NODE == 0 SCHWEBT wie vor dieser Runde, eines mit W_NODE != 0 haengt
// im Baum. Ein Dialog will schweben, eine Textkonsole will kacheln.
// `tile_float` schiebt ein Fenster von der einen Welt in die andere und
// zurueck; die schwebende Lage wird dabei in W_SAVXY/W_SAVWH aufgehoben,
// sonst steht der Dialog nach dem Zurueckholen in der Ecke.

fn tile_on(state: u64) -> bool {
    return gs(state, S_TILE) != 0
}

fn tiled(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    return wg(state, i, W_NODE) != 0
}

fn tile_node(state: u64, i: u64) -> u64 {
    if !valid(state, i) {
        return tile.NONE
    }
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return tile.NONE
    }
    return nd - 1
}

// RUNDE TILING: LIEGT DIESES FENSTER HINTER EINEM REITER. Diese
// Funktion hiess in der Runde TILING `win_hidden` -- genau wie die
// Funktion der Runde DESKTOP, die "ist minimiert" beantwortet. Zwei
// Fragen, zwei Antworten, ein Name: der Uebersetzer hat es gemeldet,
// und ein Leser haette es nicht gemerkt. Sie heisst jetzt `win_tabbed`.
fn win_tabbed(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_TABBED) != 0
}

fn hotkeys_seen(state: u64) -> u64 {
    return gs(state, S_HOTS)
}

// Der Bereich, den die letzte Baumoperation angefasst hat -- und NUR
// der. Das ist die Zahl, die `notiledirty` kaputt macht.
fn damage_tile(state: u64) {
    let x: u64 = tile.last_x(state)
    let y: u64 = tile.last_y(state)
    let w: u64 = tile.last_w(state)
    let h: u64 = tile.last_h(state)
    if w == 0 || h == 0 {
        return
    }
    damage(state, x as i64, y as i64, (x + w) as i64, (y + h) as i64)
}

fn set_tile_on(state: u64, on: bool) {
    if !ready(state) {
        return
    }
    if on {
        ss(state, S_TILE, 1)
        // ================================================ RUNDE ECHTHARDWARE-3
        // NICHT ALLES, WAS OFFEN IST, GEHOERT IN DEN BAUM.
        //
        // Justins Befund: "Tiling ein-/ausschalten zerschiesst den
        // Zustand -- danach geht fast gar nichts mehr." Hier stand
        // "Alles, was jetzt schon offen ist, kommt in den Baum", und
        // das war woertlich gemeint: der SCHREIBTISCH (L_DESK, deckt
        // den ganzen Schirm), die TASKLEISTE (L_TOP, reserviert eine
        // Kante), das Startmenue, ein Klappmenue, eine Blase -- alle
        // wurden zu Kacheln.
        //
        // Was daraus folgt, ist genau das, was er sieht: die Leiste
        // bekommt eine halbe Bildschirmflaeche zugeteilt und liegt
        // nicht mehr an ihrer Kante, der Schreibtisch wird zur Kachel
        // neben ihr, und `restore_geom` beim Ausschalten setzt beide
        // auf Masse zurueck, die inzwischen nichts mehr bedeuten --
        // die Leiste ist weg, der Schreibtisch sitzt schief, und ohne
        // Leiste gibt es keinen Knopf mehr, mit dem man es zuruecknimmt.
        //
        // GEKACHELT WIRD, WAS EIN MENSCH ALS FENSTER BENUTZT: die
        // Ebene L_NORMAL, sichtbar, und ohne reservierte Kante.
        var i: u64 = 0
        while i < MAX_WIN {
            if wg(state, i, W_USED) != 0 && wg(state, i, W_NODE) == 0
                && wg(state, i, W_LAYER) == L_NORMAL
                && wg(state, i, W_STRUT) == 0
                && (wg(state, i, W_FLAGS) & F_HIDDEN) == 0 {
                save_geom(state, i)
                tile_take(state, i)
            }
            i = i + 1
        }
    } else {
        ss(state, S_TILE, 0)
        var k: u64 = 0
        while k < MAX_WIN {
            if wg(state, k, W_USED) != 0 && wg(state, k, W_NODE) != 0 {
                tile_release(state, k)
                restore_geom(state, k)
            }
            k = k + 1
        }
    }
    damage_all(state)
}

fn save_geom(state: u64, i: u64) {
    var x: u64 = wg(state, i, W_X) & 0xFFFFFFFF
    var y: u64 = wg(state, i, W_Y) & 0xFFFFFFFF
    wsv(state, i, W_SAVXY, (x << 32) | y)
    wsv(state, i, W_SAVWH, (wg(state, i, W_W) << 32) | wg(state, i, W_H))
}

fn restore_geom(state: u64, i: u64) {
    let wh: u64 = wg(state, i, W_SAVWH)
    if wh == 0 {
        return
    }
    let xy: u64 = wg(state, i, W_SAVXY)
    wsv(state, i, W_X, xy >> 32)
    wsv(state, i, W_Y, xy & 0xFFFFFFFF)
    let w: u64 = wh >> 32
    let h: u64 = wh & 0xFFFFFFFF
    if w >= 32 && h >= 16 {
        if reframe(state, i, w, h) {
            wsv(state, i, W_W, w)
            wsv(state, i, W_H, h)
            if wg(state, i, W_KIND) == K_TERM {
                term_setup(state, i)
            } else {
                fill(state, i, 0, 0, w, h, wg(state, i, W_BG))
            }
            ev_push(state, i, E_RESIZE, w, h, 0)
        }
    }
    wsv(state, i, W_FLAGS, wg(state, i, W_FLAGS) & ~F_TABBED)
}

// EIN GROESSERER PUFFER, WENN DER BAUM MEHR PLATZ GIBT. Runde K10 hat
// den Puffer beim Anlegen geholt und `resize_win` verweigert seitdem
// jedes Wachsen darueber hinaus -- mit Recht, denn sonst waere es ein
// Schreibzugriff daneben. Beim Kacheln ist Wachsen aber der Normalfall:
// wer von vier Fenstern zwei schliesst, verdoppelt die uebrigen. Also
// wird hier ein neuer Lauf Rahmen geholt und der alte zurueckgegeben.
fn reframe(state: u64, i: u64, w: u64, h: u64) -> bool {
    let bytes: u64 = w * h * 4
    if bytes <= wg(state, i, W_BUFBYTES) {
        return true
    }
    let rahmen: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    let neu: u64 = mem.frame_run(state, rahmen)
    if neu == 0 {
        return false
    }
    let alt: u64 = wg(state, i, W_BUF)
    let altr: u64 = wg(state, i, W_BUFBYTES) / mem.FRAME_SIZE
    wsv(state, i, W_BUF, neu)
    wsv(state, i, W_BUFBYTES, rahmen * mem.FRAME_SIZE)
    if alt != 0 {
        mem.frame_free_run(state, alt, altr)
    }
    return true
}

// Ein Blatt des Baumes auf einen Fenstersatz. Der Baum fuehrt das
// AEUSSERE Rechteck (mit Rahmen und Titelleiste) -- die Malflaeche ist
// das, was davon uebrigbleibt.
fn place_win(state: u64, i: u64, n: u64) {
    let ow: u64 = tile.n_w(state, n)
    let oh: u64 = tile.n_h(state, n)
    var w: u64 = 32
    if ow > border(state) * 2 + 32 {
        w = ow - border(state) * 2
    }
    var h: u64 = 16
    if oh > title_h(state) + border(state) + 16 {
        h = oh - title_h(state) - border(state)
    }
    // RUNDE SCHIRM-ECHT: DIE DRITTE 2048 -- dieselbe vergessene Zahl,
    // die `resize_win` schon losgeworden ist. Beim Kacheln bekommt ein
    // Blatt die Flaeche des Baumes, und die ist auf einem 2560er Schirm
    // breiter als 2048; das Fenster blieb dann kleiner als sein Platz
    // und liess einen Streifen Schreibtisch stehen. Die echte Grenze
    // ist der Puffer, und um den kuemmert sich `reframe` zwei Zeilen
    // tiefer.
    if w > MAX_W_HARD {
        w = MAX_W_HARD
    }
    if h > MAX_H_HARD {
        h = MAX_H_HARD
    }
    wsv(state, i, W_X, tile.n_x(state, n))
    wsv(state, i, W_Y, tile.n_y(state, n))
    if w == wg(state, i, W_W) && h == wg(state, i, W_H) {
        return
    }
    if !reframe(state, i, w, h) {
        return
    }
    wsv(state, i, W_W, w)
    wsv(state, i, W_H, h)
    if wg(state, i, W_KIND) == K_TERM {
        term_setup(state, i)
    } else {
        fill(state, i, 0, 0, w, h, wg(state, i, W_BG))
    }
    ev_push(state, i, E_RESIZE, w, h, 0)
}

// Den ganzen Baum auf die Fenster uebertragen. Ohne `damage` -- der
// Rufer beschmutzt EINMAL den Bereich, den der Baum als geaendert
// meldet, und genau das ist der Unterschied, den diese Runde misst.
fn tile_apply(state: u64) {
    let r: u64 = tile.root(state)
    if r == tile.NONE {
        return
    }
    var n: u64 = r
    var guard: u64 = 0
    while n != tile.NONE && guard <= tile.MAX_NODES {
        guard = guard + 1
        if tile.n_kind(state, n) == tile.K_LEAF {
            let cl: u64 = tile.n_client(state, n)
            if cl != 0 && cl <= MAX_WIN {
                let i: u64 = cl - 1
                if wg(state, i, W_USED) != 0 {
                    // AUCH VERDECKTE REITER BEKOMMEN IHR RECHTECK. Sie
                    // werden nicht gemalt, aber sie muessen die richtige
                    // Groesse haben, wenn man den Reiter wechselt --
                    // sonst zuckt das Fenster beim Umschalten einmal
                    // durch, weil erst dann neu gerechnet wird.
                    place_win(state, i, n)
                    if tile.visible(state, n) {
                        wsv(state, i, W_FLAGS,
                            wg(state, i, W_FLAGS) & ~F_TABBED)
                    } else {
                        wsv(state, i, W_FLAGS,
                            wg(state, i, W_FLAGS) | F_TABBED)
                    }
                }
            }
        }
        n = tile.dfs_next(state, n, r)
    }
}

// ==================================================== RUNDE ECHTHARDWARE-3
// WER UEBERHAUPT GEKACHELT WERDEN DARF.
//
// Die Regel steht HIER und nicht bei den Rufern: `tile_take` hat vier
// davon (2444 neues Fenster, 6919 Kachelmodus an, 7119 und 7128), und
// eine Regel an vier Stellen ist vier Gelegenheiten, sie zu vergessen.
// Genau so ist die Taskleiste in den Baum geraten.
//
// Eine Kachel ist ein Fenster, das ein Mensch benutzt: normale Ebene,
// keine reservierte Bildschirmkante, nicht minimiert. Schreibtisch,
// Leiste, Startmenue, Klappmenue und Blase sind Teile der Oberflaeche
// selbst -- sie haben ihren Platz, und der Baum darf ihn nicht neu
// verteilen.
fn kachelbar(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if wg(state, i, W_LAYER) != L_NORMAL {
        return false
    }
    if wg(state, i, W_STRUT) != 0 {
        return false
    }
    // ==================================== RUNDE ECHTHARDWARE-4
    // EIN FENSTER OHNE SCHMUCK IST KEINE KACHEL.
    //
    // Justins Wort zum Kachelbetrieb war "Muell", und einer der
    // Gruende steht hier: `F_NODECO` traegt alles, was KEIN
    // gewoehnliches Fenster ist -- das Startmenue, ein Klappmenue,
    // eine Blase, ein rahmenloser Dialog. Ebene und Kantenreservierung
    // haben Schreibtisch und Leiste schon herausgehalten; das
    // Startmenue liegt aber auf der normalen Ebene und reserviert
    // nichts, also WAERE es gekachelt worden. Ein Startmenue, das
    // beim Aufgehen die Fenster daneben umsortiert, ist genau die Art
    // Automatismus, die in dieser Runde ausdruecklich nicht mehr
    // vorkommen darf.
    if (wg(state, i, W_FLAGS) & F_NODECO) != 0 {
        return false
    }
    return (wg(state, i, W_FLAGS) & F_HIDDEN) == 0
}

fn tile_take(state: u64, i: u64) -> bool {
    if !valid(state, i) || wg(state, i, W_NODE) != 0 {
        return false
    }
    if !kachelbar(state, i) {
        return false
    }
    let n: u64 = tile.insert(state, i + 1)
    if n == tile.NONE {
        return false // kein Platz im Baum -- das Fenster schwebt weiter
    }
    wsv(state, i, W_NODE, n + 1)
    tile_apply(state)
    damage_tile(state)
    return true
}

fn tile_release(state: u64, i: u64) -> bool {
    if i >= MAX_WIN {
        return false
    }
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return false
    }
    wsv(state, i, W_NODE, 0)
    wsv(state, i, W_FLAGS, wg(state, i, W_FLAGS) & ~F_TABBED)
    tile.remove(state, nd - 1)
    tile_apply(state)
    damage_tile(state)
    return true
}

fn tile_float(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if wg(state, i, W_NODE) != 0 {
        tile_release(state, i)
        restore_geom(state, i)
        raise_win(state, i)
        damage_win(state, i)
        return true
    }
    save_geom(state, i)
    return tile_take(state, i)
}

fn tile_snap(state: u64, i: u64, where: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if wg(state, i, W_NODE) == 0 {
        save_geom(state, i)
        if !tile_take(state, i) {
            return false
        }
    }
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return false
    }
    tile.snap(state, nd - 1, where)
    tile_apply(state)
    damage_tile(state)
    return true
}

// EIN WECHSEL DER BILDSCHIRMAUFLOESUNG. Der Baum wird NEU AUSGEMESSEN
// und nicht neu aufgebaut -- die Verhaeltnisse stehen als Anteile da und
// nicht als Bildpunkte, also ueberlebt jede Aufteilung den Wechsel.
fn on_screen_resize(state: u64, w: u64, h: u64) -> bool {
    if !ready(state) || w == 0 || h == 0 {
        return false
    }
    ss(state, S_SW, w)
    ss(state, S_SH, h)
    // RUNDE VOLLBILD: der Baum bekommt die ARBEITSFLAECHE. Hier stand
    // `0, 0, w, h` -- der ganze Schirm -- und damit reichte jedes
    // gekachelte Fenster unter die Leiste. `recalc_work` rechnet die
    // Flaeche aus dem neuen Schirm und den Struts; danach steht sie in
    // S_WORK_*, und der Baum folgt ihr.
    recalc_work(state)
    tile_area_work(state)
    tile_apply(state)
    damage_all(state)
    return true
}

// ================================================== RUNDE VOLLBILD
// DER KACHELBAUM FOLGT DER ARBEITSFLAECHE.
//
// An EINER Stelle, weil es zwei Anlaesse gibt, sie zu setzen: ein
// Wechsel der Aufloesung und ein Wechsel der Struts (die Leiste zieht
// an eine andere Kante, wird versteckt, kommt zurueck). Stuende die
// Rechnung an beiden, waere sie eine Gelegenheit, sie an einer zu
// vergessen -- so wie sie bis zu dieser Runde ganz fehlte.
fn tile_area_work(state: u64) {
    let _a: bool = tile.set_area(state, gs(state, S_WORK_X),
        gs(state, S_WORK_Y), gs(state, S_WORK_W), gs(state, S_WORK_H))
}

// ------------------------------------------------ die Reiterzeilen
//
// Sie werden vom SERVER gemalt, wie die Titelleiste -- eine Anwendung
// darf nicht wissen, dass sie in einem Reiter liegt, und sie kann es
// auch nicht malen: die Zeile liegt AUSSERHALB ihres Rechtecks. Der
// Baum hat ihre Hoehe von der Flaeche der Kinder schon abgezogen, also
// ueberschneidet sich hier nichts.
fn paint_bar_of(state: u64, n: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let f: u64 = gs(state, S_FONT_UI)
    let px: u64 = gs(state, S_PX_UI)
    var idx: u64 = 0
    var c: u64 = tile.n_first(state, n)
    while c != tile.NONE && idx <= tile.MAX_NODES {
        let tx: i64 = tile.tab_x(state, n, idx) as i64
        let ty: i64 = tile.tab_y(state, n, idx) as i64
        let tw: i64 = tile.tab_w(state, n, idx) as i64
        let th: i64 = tile.tab_h(state, n, idx) as i64
        let aktiv: bool = tile.n_active(state, n) == c
        // ROUND MERGE: THESE WERE FIVE RAW COLOURS. Round TILING wrote
        // the tab bar with the values that stood in the drawing code
        // BEFORE round THEME, and round THEME's whole promise is that no
        // painting routine names a colour -- tests/theme/rawcolour.py
        // measures exactly that and found eight. A tab bar that keeps
        // its own dark blue in a light theme is the same bug the
        // terminal window had, and THEME's script says so in its header.
        // The four slots are the ones the title bar already uses: a tab
        // IS a title bar, and the active tab is the focused one.
        var grund: u64 = deco(state, DK_TITLE)
        var schrift: u64 = deco(state, DK_TEXT)
        if aktiv {
            grund = deco(state, DK_TITLE_ON)
            schrift = deco(state, DK_TEXT_ON)
        }
        let ax0: i64 = imax(tx, cx0 as i64)
        let ay0: i64 = imax(ty, cy0 as i64)
        let ax1: i64 = imin(tx + tw, cx1 as i64)
        let ay1: i64 = imin(ty + th, cy1 as i64)
        if ax1 > ax0 && ay1 > ay0 {
            fb.fill(state, ax0 as u64, ay0 as u64, (ax1 - ax0) as u64,
                (ay1 - ay0) as u64, grund)
            // eine Trennlinie am rechten beziehungsweise unteren Rand
            let rand: u64 = deco(state, DK_FRAME)
            if tw > 1 && tx + tw - 1 < cx1 as i64 && tx + tw - 1 >= cx0 as i64 {
                fb.fill(state, (tx + tw - 1) as u64, ay0 as u64, 1,
                    (ay1 - ay0) as u64, rand)
            }
            if th > 1 && ty + th - 1 < cy1 as i64 && ty + th - 1 >= cy0 as i64 {
                fb.fill(state, ax0 as u64, (ty + th - 1) as u64,
                    (ax1 - ax0) as u64, 1, rand)
            }
            if f < ttf.MAX_FONTS {
                let l: u64 = tile.first_leaf(state, c)
                if l != tile.NONE {
                    let cl: u64 = tile.n_client(state, l)
                    if cl != 0 && cl <= MAX_WIN {
                        title_text(state, cl - 1, f, tx + 6,
                            ty + 3 + ttf.ascent(state, f, px), schrift,
                            ax0, ay0, ax1, ay1, tx + tw - 4)
                    }
                }
            }
        }
        idx = idx + 1
        c = tile.n_next(state, c)
    }
}

fn paint_bars(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let r: u64 = tile.root(state)
    if r == tile.NONE {
        return
    }
    var n: u64 = r
    var guard: u64 = 0
    while n != tile.NONE && guard <= tile.MAX_NODES {
        guard = guard + 1
        if tile.n_kind(state, n) == tile.K_BOX {
            if tile.n_layout(state, n) != tile.LAY_SPLIT {
                paint_bar_of(state, n, cx0, cy0, cx1, cy1)
            }
        }
        n = tile.dfs_next(state, n, r)
    }
}

// ------------------------------------------- das Vorschaurechteck
//
// Beim Ziehen zeigt ein Rahmen, WO das Fenster landen wird -- nicht
// wo der Zeiger ist. Ohne das ist ein Ablegen im Baum Raten: die
// linke Haelfte eines Fensters und sein oberes Viertel sind zwei
// verschiedene Ziele, und man sieht dem Zeiger nicht an, welches
// gemeint ist.
fn paint_preview(state: u64, cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let x: i64 = gs(state, S_PVX) as i64
    let y: i64 = gs(state, S_PVY) as i64
    let w: i64 = gs(state, S_PVW) as i64
    let h: i64 = gs(state, S_PVH) as i64
    if w <= 0 || h <= 0 {
        return
    }
    // ROUND MERGE: 0x4C9AE8 is exactly deco_fallback(DK_FRAME_ON) --
    // round TILING copied the number instead of asking for the slot, so
    // the drag preview kept the old accent in every other theme.
    let farbe: u64 = deco(state, DK_FRAME_ON)
    var k: i64 = 0
    while k < 3 {
        pv_line(state, x + k, y + k, w - 2 * k, 1, farbe, cx0, cy0, cx1, cy1)
        pv_line(state, x + k, y + h - 1 - k, w - 2 * k, 1, farbe, cx0, cy0,
            cx1, cy1)
        pv_line(state, x + k, y + k, 1, h - 2 * k, farbe, cx0, cy0, cx1, cy1)
        pv_line(state, x + w - 1 - k, y + k, 1, h - 2 * k, farbe, cx0, cy0,
            cx1, cy1)
        k = k + 1
    }
}

fn pv_line(state: u64, x: i64, y: i64, w: i64, h: i64, farbe: u64,
    cx0: u64, cy0: u64, cx1: u64, cy1: u64) {
    let ax0: i64 = imax(x, cx0 as i64)
    let ay0: i64 = imax(y, cy0 as i64)
    let ax1: i64 = imin(x + w, cx1 as i64)
    let ay1: i64 = imin(y + h, cy1 as i64)
    if ax1 <= ax0 || ay1 <= ay0 {
        return
    }
    fb.fill(state, ax0 as u64, ay0 as u64, (ax1 - ax0) as u64,
        (ay1 - ay0) as u64, farbe)
}

fn preview_damage(state: u64) {
    if gs(state, S_PVON) == 0 {
        return
    }
    let x: i64 = gs(state, S_PVX) as i64
    let y: i64 = gs(state, S_PVY) as i64
    damage(state, x, y, x + gs(state, S_PVW) as i64,
        y + gs(state, S_PVH) as i64)
}

fn set_preview(state: u64, x: u64, y: u64, w: u64, h: u64) {
    ss(state, S_PVX, x)
    ss(state, S_PVY, y)
    ss(state, S_PVW, w)
    ss(state, S_PVH, h)
    ss(state, S_PVON, 1)
}

// Welches Blatt liegt an dieser Stelle? Der Baum weiss es genauer als
// die Stapelreihenfolge -- er kennt auch die Stellen, an denen KEIN
// Fenster liegt, weil dort eine Reiterzeile ist.
fn leaf_at(state: u64, x: i64, y: i64) -> u64 {
    let r: u64 = tile.root(state)
    if r == tile.NONE {
        return tile.NONE
    }
    var n: u64 = r
    var guard: u64 = 0
    while n != tile.NONE && guard <= tile.MAX_NODES {
        guard = guard + 1
        if tile.n_kind(state, n) == tile.K_LEAF && tile.visible(state, n) {
            let nx: i64 = tile.n_x(state, n) as i64
            let ny: i64 = tile.n_y(state, n) as i64
            if x >= nx && y >= ny {
                if x < nx + tile.n_w(state, n) as i64 {
                    if y < ny + tile.n_h(state, n) as i64 {
                        return n
                    }
                }
            }
        }
        n = tile.dfs_next(state, n, r)
    }
    return tile.NONE
}

fn drag_begin(state: u64, i: u64) {
    ss(state, S_DRAGT, 0)
    ss(state, S_DROPN, 0)
    ss(state, S_DROPE, 0)
    if wg(state, i, W_NODE) == 0 {
        return
    }
    // Wer gezogen wird, ist waehrenddessen NICHT im Baum -- sonst
    // rechnet der Baum ihn bei jeder Zeigerbewegung neu an seinen alten
    // Platz. So macht es i3 auch.
    save_geom(state, i)
    tile_release(state, i)
    ss(state, S_DRAGT, 1)
}

fn drag_hover(state: u64, i: u64, x: i64, y: i64) {
    if gs(state, S_TILE) == 0 {
        return
    }
    preview_damage(state)
    ss(state, S_PVON, 0)
    ss(state, S_DROPN, 0)
    ss(state, S_DROPE, 0)
    // ================================================== RUNDE VOLLBILD
    // DIE VORSCHAU DES ANDOCKENS ZEIGT DIE ARBEITSFLAECHE, NICHT DEN
    // SCHIRM.
    //
    // Hier stand `S_SW`/`S_SH`, also der ganze Bildschirm. Ein Fenster,
    // das nach links angedockt wurde, bekam damit
    // `0,0,1720x1440` -- volle Schirmhoehe, und die unteren 80
    // Bildpunkte lagen UNTER der Taskleiste. Windows dockt an die
    // Arbeitsflaeche an; Justins Vorgabe sagt dasselbe.
    //
    // Die Vorschau und die Ablage muessen dieselbe Flaeche nennen,
    // sonst zeigt der Umriss etwas anderes an, als hinterher
    // herauskommt -- deshalb steht die Rechnung hier UND in
    // `tile_apply` auf derselben Quelle.
    let wx0: i64 = gs(state, S_WORK_X) as i64
    let wy0: i64 = gs(state, S_WORK_Y) as i64
    let sw: i64 = gs(state, S_WORK_W) as i64
    let sh: i64 = gs(state, S_WORK_H) as i64
    let rand: i64 = 16
    // 1. AM BILDSCHIRMRAND: die Windows-artige Schnellablage. Sie ist
    //    ein Sonderfall des Baumes und kein zweites System.
    if x < wx0 + rand {
        ss(state, S_DROPE, 1)
        set_preview(state, wx0 as u64, wy0 as u64, (sw / 2) as u64,
            sh as u64)
        preview_damage(state)
        return
    }
    if x >= wx0 + sw - rand {
        ss(state, S_DROPE, 2)
        set_preview(state, (wx0 + sw - sw / 2) as u64, wy0 as u64,
            (sw / 2) as u64, sh as u64)
        preview_damage(state)
        return
    }
    if y < wy0 + rand {
        ss(state, S_DROPE, 3)
        set_preview(state, wx0 as u64, wy0 as u64, sw as u64,
            (sh / 2) as u64)
        preview_damage(state)
        return
    }
    if y >= wy0 + sh - rand {
        ss(state, S_DROPE, 4)
        set_preview(state, wx0 as u64, (wy0 + sh - sh / 2) as u64,
            sw as u64, (sh / 2) as u64)
        preview_damage(state)
        return
    }
    // 2. AUF EINEM ANDEREN FENSTER: das Viertel, in dem der Zeiger
    //    steht, sagt die Seite. Die Mitte heisst REITER.
    let n: u64 = leaf_at(state, x, y)
    if n == tile.NONE {
        return
    }
    let nx: u64 = tile.n_x(state, n)
    let ny: u64 = tile.n_y(state, n)
    let w: u64 = tile.n_w(state, n)
    let h: u64 = tile.n_h(state, n)
    let fx: u64 = (x - nx as i64) as u64
    let fy: u64 = (y - ny as i64) as u64
    var page: u64 = 4
    if fx * 4 < w {
        page = tile.D_LEFT
    } else {
        if fx * 4 >= w * 3 {
            page = tile.D_RIGHT
        } else {
            if fy * 4 < h {
                page = tile.D_UP
            } else {
                if fy * 4 >= h * 3 {
                    page = tile.D_DOWN
                }
            }
        }
    }
    ss(state, S_DROPN, n + 1)
    ss(state, S_DROPS, page)
    if page == tile.D_LEFT {
        set_preview(state, nx, ny, w / 2, h)
    }
    if page == tile.D_RIGHT {
        set_preview(state, nx + w - w / 2, ny, w / 2, h)
    }
    if page == tile.D_UP {
        set_preview(state, nx, ny, w, h / 2)
    }
    if page == tile.D_DOWN {
        set_preview(state, nx, ny + h - h / 2, w, h / 2)
    }
    if page == 4 {
        set_preview(state, nx, ny, w, h)
    }
    preview_damage(state)
}

fn drag_end(state: u64, i: u64, x: i64, y: i64) {
    preview_damage(state)
    ss(state, S_PVON, 0)
    if gs(state, S_TILE) == 0 {
        ss(state, S_DRAGT, 0)
        return
    }
    let e: u64 = gs(state, S_DROPE)
    if e != 0 {
        let n: u64 = tile.insert(state, i + 1)
        if n != tile.NONE {
            wsv(state, i, W_NODE, n + 1)
            var wo: u64 = tile.SNAP_LEFT
            if e == 2 {
                wo = tile.SNAP_RIGHT
            }
            if e == 3 {
                wo = tile.SNAP_TOP
            }
            if e == 4 {
                wo = tile.SNAP_BOTTOM
            }
            tile.snap(state, n, wo)
            tile_apply(state)
            damage_all(state)
        }
        ss(state, S_DRAGT, 0)
        ss(state, S_DROPE, 0)
        return
    }
    let d: u64 = gs(state, S_DROPN)
    if d != 0 {
        let ziel: u64 = d - 1
        let page: u64 = gs(state, S_DROPS)
        var n: u64 = tile.NONE
        if page == 4 {
            n = tile.insert_at(state, ziel, tile.D_RIGHT, i + 1)
            if n != tile.NONE {
                tile.set_layout(state, n, tile.LAY_TABBED)
            }
        } else {
            n = tile.insert_at(state, ziel, page, i + 1)
        }
        if n != tile.NONE {
            wsv(state, i, W_NODE, n + 1)
            tile_apply(state)
            damage_all(state)
        }
    } else {
        if gs(state, S_DRAGT) != 0 {
            tile_take(state, i)
            damage_all(state)
        }
    }
    ss(state, S_DRAGT, 0)
    ss(state, S_DROPN, 0)
}

// Der Griff unten rechts an einem GEKACHELTEN Fenster verschiebt das
// Verhaeltnis am inneren Knoten -- nicht die Groesse des Fensters. Alles
// andere waere eine Luecke.
fn tile_drag_resize(state: u64, i: u64, x: i64, y: i64) {
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return
    }
    let n: u64 = nd - 1
    let p: u64 = tile.n_parent(state, n)
    if p == tile.NONE || tile.n_layout(state, p) != tile.LAY_SPLIT {
        return
    }
    var total: u64 = tile.n_h(state, p)
    var will: i64 = y - tile.n_y(state, n) as i64
    var ist: i64 = tile.n_h(state, n) as i64
    if tile.n_dir(state, p) == tile.DIR_H {
        total = tile.n_w(state, p)
        will = x - tile.n_x(state, n) as i64
        ist = tile.n_w(state, n) as i64
    }
    if total == 0 {
        return
    }
    let dpx: i64 = will - ist
    if dpx == 0 {
        return
    }
    let d: i64 = dpx * tile.FRAC_ONE as i64 / total as i64
    if d == 0 {
        return
    }
    if tile.resize_at(state, n, d) {
        tile_apply(state)
        damage_tile(state)
    }
}

// -------------------------------------------------- die Tastenkuerzel

fn hot_take_raw(state: u64) -> u64 {
    let kopf: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_HHEAD)
    let schwanz: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_HTAIL)
    if kopf == schwanz {
        return 0
    }
    let p: u64 = state + kstate.K11_OFF + kstate.KB_HOT + (schwanz % 16) * 2
    let c: u64 = kstate.get8(p)
    let m: u64 = kstate.get8(p + 1)
    kstate.set(state, kstate.K11_OFF + kstate.KB_HTAIL, schwanz + 1)
    return (m << 8) | c
}

fn hotkeys(state: u64) -> u64 {
    var n: u64 = 0
    var weiter: bool = true
    var guard: u64 = 0
    while weiter && guard < 16 {
        guard = guard + 1
        let v: u64 = hot_take_raw(state)
        if v == 0 {
            weiter = false
        } else {
            n = n + 1
            ss(state, S_HOTS, gs(state, S_HOTS) + 1)
            let act: u64 = tile.bind_lookup(state, v & 0xFF, (v >> 8) & 0xFF)
            // RUNDE TUERSCHLOSS: WAS DER RING HERGAB UND WAS DARAUS
            // WURDE. Drei Zahlen, und sie trennen die drei Faelle, die
            // sonst gleich aussehen: Taste kam nicht an (keine Zeile),
            // Taste kam an, aber keine Bindung (act=0), Bindung da, aber
            // die Handlung tat nichts (getan=0).
            var s_hk: [u8; 12] = "wm: hot c=\0\0"
            var s_hm: [u8; 6] = " mod=\0"
            var s_ha: [u8; 6] = " act=\0"
            serial.puts((&s_hk[0]) as u64)
            serial.dec(v & 0xFF)
            serial.puts((&s_hm[0]) as u64)
            serial.dec((v >> 8) & 0xFF)
            serial.puts((&s_ha[0]) as u64)
            serial.dec(act)
            // DIE ZEILE WIRD ZUERST FERTIG. `tile_action` ruft
            // `set_focus`, und das schreibt seit dieser Runde selbst auf
            // die Leitung -- mitten in diese Zeile hinein. Gemessen:
            //     wm: hot c=9 mod=1 act=30wm: fokus id=7 vor=15
            // Beide Angaben stimmen, aber `act=30` und die Fokuszeile
            // kleben aneinander, und ein Muster, das auf das Zeilenende
            // wartet, findet keines von beiden. Also: Zeilenumbruch vor
            // der Handlung, das Ergebnis kommt in eine eigene Zeile.
            serial.nl()
            let getan: bool = tile_action(state, act)
            var s_hr: [u8; 15] = "wm: hot getan=\0"
            serial.puts((&s_hr[0]) as u64)
            if getan {
                serial.dec(1)
            } else {
                serial.dec(0)
            }
            serial.nl()
            if getan {
                ss(state, S_ACTS, gs(state, S_ACTS) + 1)
            }
        }
    }
    return n
}

// RUNDE TUERSCHLOSS: DAS NAECHSTE FENSTER, das ein Mensch meint.
//
// WELCHE FENSTER MITZAEHLEN. Nicht jedes Fenster ist eines, zu dem man
// wechseln will: der Schreibtisch (`L_DESK`) ist der Hintergrund, die
// Taskleiste (`L_TOP`) ist Bedienung, und ein verborgenes (`F_HIDDEN`)
// steht nicht auf dem Schirm. Es bleiben die gewoehnlichen Anwendungen
// auf `L_NORMAL` -- genau die, die auch eine Titelleiste tragen.
//
// WARUM IM KREIS AB DEM FOKUS und nicht immer von vorn: sonst wechselt
// Alt+Tab bei drei Fenstern ewig zwischen den ersten beiden. Der Ring
// laeuft `von+1 .. von+MAX_WIN` und rechnet modulo -- damit kommt jedes
// Fenster genau einmal vorbei, und das eigene zuletzt.
//
// Der Rueckgabewert sagt, ob sich WIRKLICH etwas geaendert hat: bei
// einem einzigen Fenster ist Alt+Tab folgenlos, und das ist kein
// Fehler, sondern die Wahrheit.
fn wechselbar(state: u64, i: u64) -> bool {
    if !valid(state, i) {
        return false
    }
    if (wg(state, i, W_FLAGS) & F_HIDDEN) != 0 {
        return false
    }
    return wg(state, i, W_LAYER) == L_NORMAL
}

fn next_window(state: u64, von: u64) -> bool {
    var k: u64 = 1
    while k <= MAX_WIN {
        let j: u64 = (von + k) % MAX_WIN
        if wechselbar(state, j) && j != von {
            raise_win(state, j)
            set_focus(state, j)
            damage_win(state, j)
            return true
        }
        k = k + 1
    }
    return false
}

// EINE HANDLUNG AUSFUEHREN. Welche Taste welche Handlung ausloest, steht
// NICHT hier, sondern in der Tabelle, die aus
// /users/<name>/config/tiling.conf gelesen wurde. Hier steht nur, was
// eine Handlung TUT.
fn tile_action(state: u64, act: u64) -> bool {
    if act == tile.A_NONE || !ready(state) {
        return false
    }
    if act == tile.A_TILE_TOGGLE {
        set_tile_on(state, gs(state, S_TILE) == 0)
        return true
    }
    let i: u64 = focus(state)
    if i >= MAX_WIN {
        return false
    }
    if act == tile.A_CLOSE {
        ev_push(state, i, E_CLOSE, 0, 0, 0)
        destroy(state, i)
        return true
    }
    if act == tile.A_FLOAT {
        return tile_float(state, i)
    }
    if act >= tile.A_SNAP_LEFT && act <= tile.A_SNAP_BR {
        return tile_snap(state, i, act - tile.A_SNAP_LEFT)
    }
    // ================================================ RUNDE TUERSCHLOSS
    //
    // ALT+TAB. Diese Abfrage steht VOR `let nd = wg(state, i, W_NODE)`
    // und dessen `if nd == 0 { return false }` -- und das ist der ganze
    // Grund, warum sie wirkt.
    //
    // GEMESSEN (Runde DURCHKLICK, 4.3): `focus=1` stand ueber 137
    // Meldungen still. Die vorhandenen Fokushandlungen fragen alle den
    // KACHELBAUM (`dir_search`); ein schwebendes Fenster hat `W_NODE ==
    // 0` und faellt aus jeder von ihnen heraus, bevor irgendetwas
    // passiert. Auf dem Schreibtisch dieses Systems schwebt aber jedes
    // Fenster -- der Kachelmodus ist standardmaessig aus.
    //
    // Alt+Tab geht deshalb durch die FENSTERLISTE DES SERVERS und nicht
    // durch den Baum: ab dem Fenster mit dem Fokus aufwaerts, im Kreis,
    // und nimmt das erste, das ein Mensch auch anklicken koennte.
    if act == tile.A_NEXT_WIN {
        return next_window(state, i)
    }
    // ================================================== RUNDE VOLLBILD
    // F11 UMSCHALTEN. Steht aus demselben Grund hier oben wie Alt+Tab:
    // das Vollbild betrifft EIN Fenster und nicht den Kachelbaum -- ein
    // schwebendes Fenster (der Normalfall auf diesem Schreibtisch) hat
    // `W_NODE == 0` und fiele durch die Abfrage darunter heraus, bevor
    // irgendetwas passiert.
    //
    // UMSCHALTEN und nicht EINSCHALTEN: dieselbe Taste zurueck ist das,
    // was Windows und jeder Browser tun.
    if act == tile.A_FULL {
        let an: bool = (wg(state, i, W_FLAGS) & F_FULL) == 0
        let ok: bool = fullscreen(state, i, an)
        if ok {
            full_say(state, i)
        }
        return ok
    }
    // RUNDE FENSTER: die MESSTASTE. Sie veraendert nichts -- sie legt
    // die Arbeitsflaeche und die ganze Fensterliste auf die Leitung.
    // Vor dem Baum, weil sie den Baum nicht braucht.
    if act == tile.A_SAY {
        work_say(state)
        wins_say(state)
        return true
    }
    let nd: u64 = wg(state, i, W_NODE)
    if nd == 0 {
        return false
    }
    let n: u64 = nd - 1
    if act <= tile.A_FOCUS_DOWN {
        let z: u64 = tile.dir_search(state, n, act - tile.A_FOCUS_LEFT)
        if z == tile.NONE {
            return false
        }
        tile.set_focus(state, z)
        let cl: u64 = tile.n_client(state, z)
        if cl != 0 && cl <= MAX_WIN {
            raise_win(state, cl - 1)
            set_focus(state, cl - 1)
        }
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act <= tile.A_MOVE_DOWN {
        if tile.move_dir(state, n, act - tile.A_MOVE_LEFT) {
            tile_apply(state)
            damage_tile(state)
            return true
        }
        return false
    }
    if act == tile.A_SPLIT_H {
        tile.set_next_split(state, 1)
        return true
    }
    if act == tile.A_SPLIT_V {
        tile.set_next_split(state, 2)
        return true
    }
    if act >= tile.A_LAYOUT_SPLIT && act <= tile.A_LAYOUT_STACKED {
        if tile.set_layout(state, n, act - tile.A_LAYOUT_SPLIT) {
            tile_apply(state)
            damage_tile(state)
            return true
        }
        return false
    }
    if act == tile.A_ROTATE {
        tile.rotate(state, tile.root(state), 1)
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act == tile.A_MIRROR {
        tile.mirror(state, tile.root(state), 0)
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act == tile.A_BALANCE {
        tile.balance(state, tile.root(state))
        tile_apply(state)
        damage_tile(state)
        return true
    }
    if act == tile.A_GROW || act == tile.A_SHRINK {
        var d: i64 = tile.MIN_FRAC as i64
        if act == tile.A_SHRINK {
            d = 0 - d
        }
        if tile.resize_at(state, n, d) {
            tile_apply(state)
            damage_tile(state)
            return true
        }
        return false
    }
    return false
}
