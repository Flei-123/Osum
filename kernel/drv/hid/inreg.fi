profile kernel

import drv.hid.hidrep
import touchev.quirk

export { register, unregister, used, bus, vid, pid, flags, quirk_of }

static mut g_used: [u64; 8] = [0; 8]
static mut g_bus: [u64; 8] = [0; 8]
static mut g_vid: [u64; 8] = [0; 8]
static mut g_pid: [u64; 8] = [0; 8]
static mut g_flags: [u64; 8] = [0; 8]

fn register(dev: u64, bus_id: u64, vendor: u64, product: u64) -> u64 {
    if dev >= hidrep.MAX_DEV {
        return 0
    }
    let d: usize = dev as usize
    g_used[d] = 1
    g_bus[d] = bus_id
    g_vid[d] = vendor
    g_pid[d] = product
    g_flags[d] = quirk.lookup(bus_id, vendor, product)
    return g_flags[d]
}

fn unregister(dev: u64) {
    if dev >= hidrep.MAX_DEV {
        return
    }
    g_used[dev as usize] = 0
    g_flags[dev as usize] = 0
}

fn used(dev: u64) -> bool {
    if dev >= hidrep.MAX_DEV {
        return false
    }
    return g_used[dev as usize] != 0
}

fn bus(dev: u64) -> u64 {
    if dev >= hidrep.MAX_DEV { return 0 }
    return g_bus[dev as usize]
}

fn vid(dev: u64) -> u64 {
    if dev >= hidrep.MAX_DEV { return 0 }
    return g_vid[dev as usize]
}

fn pid(dev: u64) -> u64 {
    if dev >= hidrep.MAX_DEV { return 0 }
    return g_pid[dev as usize]
}

fn flags(dev: u64) -> u64 {
    if dev >= hidrep.MAX_DEV { return 0 }
    return g_flags[dev as usize]
}

fn quirk_of(dev: u64, flag: u64) -> bool {
    return (flags(dev) & flag) != 0
}
