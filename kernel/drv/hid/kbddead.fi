profile kernel

import drv.hid.kbdcomb
import drv.hid.kbdmap

export { feed, reset, pending, lookup, spacing, pack, first_of, second_of }

const BACKSPACE: u64 = 8
const SPACE: u64 = 32

static mut held: u64 = 0

fn pending() -> bool {
    return held != 0
}

fn reset() {
    held = 0
}

fn pack(a: u64, b: u64) -> u64 {
    return a | (b << 24)
}

fn first_of(out: u64) -> u64 {
    return out & 0xFFFFFF
}

fn second_of(out: u64) -> u64 {
    return out >> 24
}

fn spacing(id: u64) -> u64 {
    return (kbdcomb.SPACING[id as usize]) as u64
}

fn lookup(id: u64, base: u64) -> u64 {
    let key: u64 = (id << 21) | base
    var i: u64 = 0
    while i < kbdcomb.DEAD_N {
        let e: u64 = kbdcomb.DEAD_TAB[i as usize]
        if (e >> 21) == key {
            return e & 0x1FFFFF
        }
        i = i + 1
    }
    return 0
}

fn feed_dead(id: u64) -> u64 {
    if held == 0 {
        held = id + 1
        return 0
    }
    let prev: u64 = held - 1
    if prev == id {
        held = 0
        return spacing(id)
    }
    held = id + 1
    return spacing(prev)
}

fn feed(e: u64) -> u64 {
    if e == 0 {
        return 0
    }
    if kbdmap.is_dead(e) {
        return feed_dead(kbdmap.dead_id(e))
    }
    if held == 0 {
        return e
    }
    let prev: u64 = held - 1
    held = 0
    if e == SPACE {
        return spacing(prev)
    }
    if e == BACKSPACE {
        return 0
    }
    if e > SPACE {
        let combined: u64 = lookup(prev, e)
        if combined != 0 {
            return combined
        }
    }
    return pack(spacing(prev), e)
}
