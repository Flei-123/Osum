profile kernel

import gfx.gfx

export { DEFAULT_W, DEFAULT_H, abs_scale, scr_w, scr_h, tmap }

const DEFAULT_W: u64 = 1024
const DEFAULT_H: u64 = 768

fn abs_scale(v: u64, lo: u64, hi: u64, size: u64) -> u64 {
    if hi <= lo || size < 2 {
        return 0
    }
    var t: u64 = v
    if t < lo {
        t = lo
    }
    if t > hi {
        t = hi
    }
    return ((t - lo) * (size - 1)) / (hi - lo)
}

fn scr_w(state: u64) -> u64 {
    let w: u64 = gfx.width(state)
    if w < 2 {
        return DEFAULT_W
    }
    return w
}

fn scr_h(state: u64) -> u64 {
    let h: u64 = gfx.height(state)
    if h < 2 {
        return DEFAULT_H
    }
    return h
}

fn tmap(state: u64, x: u64, xlo: u64, xhi: u64, y: u64, ylo: u64, yhi: u64) -> u64 {
    var nx: u64 = abs_scale(x, xlo, xhi, scr_w(state))
    var ny: u64 = abs_scale(y, ylo, yhi, scr_h(state))
    let pw: u64 = gfx.panel_w(state)
    let ph: u64 = gfx.panel_h(state)
    if pw >= 2 && ph >= 2 {
        let pp: u64 = gfx.pointer_from_panel(state, abs_scale(x, xlo, xhi, pw), abs_scale(y, ylo, yhi, ph))
        nx = pp >> 32
        ny = pp & 0xFFFFFFFF
    }
    return (nx << 32) | ny
}
