// SPDX-License-Identifier: GPL-2.0-only
// kernel/kbd.fi -- round 59: the first real device.
//
// The PS/2 keyboard is the simplest device a PC has, and it is a real
// one: it interrupts (IRQ1 -> vector 33), it has a data port (0x60), and
// it delivers scan codes, not characters. Whoever can read a key can read
// a device.
//
// Scan code set 1, the one every PC still speaks after a reset. Below
// 0x80 a key was pressed, from 0x80 on it was released -- the same code
// with the top bit set. The kernel is only interested in the press.
//
// No shift, no modifiers, no repeat: the table has one entry per code,
// and what has none stays silent. A keyboard driver is a round of its
// own; this is the proof that the interrupt path works.
// Dead keys, compose and the caps lock behaviour live in kbdinput.fi, kbddead.fi,
// kbdcompose.fi and kbdmap.fi; the layouts are the generated data of kbdlay.fi.

import serial
import lib.kstate
import drv.con.tty
import gfx.gfx
import utf8
import sched.time
import ui.ax
import drv.hid.kbdmap
import keymap.kbdnames
import drv.hid.kbdinput
import ipc.tip
import pwr.blchain
import pwr.hkdiag

export {
    irq, ghosts, rescue, rescued, on_code, translate, shifted, take, waiting,
    hot_take, hot_waiting, push_hot, MAX_KEYS, HOT_SLOTS,
    code_of, layout, set_layout, switches, LAYOUTS, L_US, L_DE, L_UK, L_FR, L_ES, L_IT, L_RU,
    super_down, hotkey_seq, hotkey_key, hotkey_ns,
    locks, locks_dirty, locks_clean, locks_set,
    LK_NUM, LK_CAPS, LK_SCROLL,
    // ROUND A11Y-2 (S-008): sticky keys.
    latched, sticks
}

// How many octets fit into the buffer in the data area.
const MAX_KEYS: u64 = 64

const DATA_PORT: u16 = 0x60

const L_US: u64 = 0
const L_DE: u64 = 1
const L_UK: u64 = 2
const L_FR: u64 = 3
const L_ES: u64 = 4
const L_IT: u64 = 5
const L_RU: u64 = 6
const LAYOUTS: u64 = kbdnames.COUNT

const STATUS_PORT: u16 = 0x64
static mut ghost_n: u64 = 0

fn ghosts() -> u64 {
    return ghost_n
}

fn irq(state: u64) {
    let st: u64 = serial.in8(STATUS_PORT) as u64
    hkdiag.add(hkdiag.KBD_IRQ, 1)
    hkdiag.set(hkdiag.KBD_STATUS, st)
    hkdiag.set(hkdiag.KBD_STATUS_OR, hkdiag.get(hkdiag.KBD_STATUS_OR) | st)
    if (st & 0x21) != 0x01 {
        ghost_n = ghost_n + 1
        hkdiag.add(hkdiag.KBD_GHOST, 1)
        return
    }
    let code: u64 = serial.in8(DATA_PORT) as u64
    hkdiag.raw(code)
    on_code(state, code)
}

// W-INPUTHANG: THE KEYBOARD HALF OF THE WATCHDOG. The i8042 holds ONE byte in its output buffer and raises IRQ 1 only when a byte ENTERS
// it. If that edge is lost (a VMM that drops or coalesces the interrupt, a masked line, an EOI that never came) the byte stays, the
// controller raises nothing more, and keyboard AND mouse look dead while the guest runs fine -- the picture is a still image. The
// mouse half has had a rescue poll for a long time (ps2m.poll_one, port 0x64 bit 5); the keyboard had none. `rescue` looks at the
// status port like `irq` does (output buffer full, not the mouse's byte), reads the byte with interrupts off (so IRQ 1 cannot take
// the same byte between the look and the read) and feeds it to `on_code`. Returns true when a byte was taken.
static mut rescued_n: u64 = 0

fn rescued() -> u64 {
    return rescued_n
}

fn rescue(state: u64) -> bool {
    let flags: u64 = asm("pushfq\npop rax\ncli", out("rax"))
    var got: bool = false
    var code: u64 = 0
    if (serial.in8(STATUS_PORT) as u64 & 0x21) == 0x01 {
        code = serial.in8(DATA_PORT) as u64
        got = true
        hkdiag.raw(code)
        hkdiag.add(hkdiag.KBD_RESCUE, 1)
    }
    if (flags & 0x200) != 0 {
        asm("sti")
    }
    if got {
        rescued_n = rescued_n + 1
        if rescued_n <= 8 {
            var s_r: [u8; 31] = "kbd: irq lost, rescued byte n=\0"
            serial.puts((&s_r[0]) as u64)
            serial.dec(rescued_n)
            serial.nl()
        }
        on_code(state, code)
    }
    return got
}

const LK_NUM: u64 = 1
const LK_CAPS: u64 = 2
const LK_SCROLL: u64 = 4

// Num Lock starts ON (26.09.2026, Dell 9020): what every PC does after
// its firmware, and the lamp is set to match on the first report.
static mut lock_bits: u64 = 1
static mut lock_fresh: u64 = 1

fn locks(state: u64) -> u64 {
    return lock_bits
}

fn locks_dirty() -> u64 {
    return lock_fresh
}

fn locks_clean() {
    lock_fresh = 0
}

fn locks_set(v: u64) {
    lock_bits = v & 7
    lock_fresh = 1
}

fn lock_toggle(bit: u64) {
    lock_bits = lock_bits ^ bit
    lock_fresh = 1
}

// ==================================================================
// ROUND A11Y-2 (S-008) -- STICKY KEYS
//
// WHAT THEY SOLVE. Who cannot press Shift and a key at the same time --
// one hand, a mouth stick, a tremor -- gets no capital letter, no Ctrl+C
// and no Shift+Tab (so no way BACK through the controls). The old and
// cheap answer: a modifier pressed and released ALONE latches and holds
// for exactly the next key.
//
// WHY "ALONE". Otherwise every ordinary Shift+A would drag a second,
// unwanted capital behind it -- the Shift key is released after it too.
// `KB_SEEN` remembers whether another key came between press and release.
//
// WHERE. Here, in the keyboard, and NOT in the widget layer: it must
// work in the shell as in a window, before any program runs. Switched by
// `a11ysticky` or AX_SET(C_STICKY) (docs/A11Y.md 4.5).
fn latched(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.KB_LATCH)
}

fn sticks(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.KB_STICKS)
}

fn mod_down(state: u64) {
    kstate.set(state, kstate.K11_OFF + kstate.KB_SEEN, 0)
}

// A modifier went up. true = keep it held (it latched).
fn mod_up(state: u64, bit: u64) -> bool {
    if !ax.sticky(state) {
        return false
    }
    if kstate.get(state, kstate.K11_OFF + kstate.KB_SEEN) != 0 {
        return false
    }
    kstate.set(state, kstate.K11_OFF + kstate.KB_LATCH,
        latched(state) | bit)
    kstate.add(state, kstate.K11_OFF + kstate.KB_STICKS, 1)
    var s_l: [u8; 19] = "kbd: sticky latch=\0"
    serial.puts((&s_l[0]) as u64)
    serial.dec(latched(state))
    serial.nl()
    return true
}

// The latched modifiers fall -- after EXACTLY ONE key.
fn unlatch(state: u64) {
    let l: u64 = latched(state)
    if (l & 1) != 0 {
        kstate.set(state, kstate.K11_OFF + kstate.KB_SHIFT, 0)
    }
    if (l & 2) != 0 {
        kstate.set(state, kstate.K11_OFF + kstate.KB_CTRL, 0)
    }
    if (l & 4) != 0 {
        kstate.set(state, kstate.K11_OFF + kstate.KB_OLD, 0)
    }
    kstate.set(state, kstate.K11_OFF + kstate.KB_LATCH, 0)
    kstate.set(state, kstate.K11_OFF + kstate.KB_SEEN, 0)
}

// THE WRAPPER. `on_code_inner` has a few dozen return points; the
// latched modifiers must fall after EVERY one of them once a real key
// went through. A wrapper is the one form that cannot forget one.
fn on_code(state: u64, code: u64) {
    on_code_inner(state, code)
    if latched(state) != 0
        && kstate.get(state, kstate.K11_OFF + kstate.KB_SEEN) != 0 {
        unlatch(state)
    }
}

fn on_code_inner(state: u64, code: u64) {
    if code == 0x45 {
        lock_toggle(LK_NUM)
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        return
    }
    if code == 0x3A {
        lock_toggle(LK_CAPS)
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        return
    }
    if code == 0x46 {
        lock_toggle(LK_SCROLL)
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        return
    }
    if code == 0xC5 || code == 0xBA || code == 0xC6 {
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        return
    }
    if code == 0xE0 {
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 1)
        return
    }
    let ext: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_EXT)
    if ext == 1 && (code == 0x2A || code == 0x36 || code == 0xAA
        || code == 0xB6) {
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        return
    }
    // L-008: PRINT SCREEN (E0 37) IS A GLOBAL HOTKEY, LIKE SUPER+LETTER. It
    // produces no character; it is latched (HK_KEY = 336, no letter has that
    // value) and the taskbar starts the screenshot tool. The release (E0 B7)
    // falls into the `code >= 0x80` return below.
    if ext == 1 && code == 0x37 {
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        kstate.set(state, kstate.K11_OFF + kstate.HK_KEY, 336)
        kstate.set(state, kstate.K11_OFF + kstate.HK_NS, time.mono_ns(state))
        kstate.add(state, kstate.K11_OFF + kstate.HK_SEQ, 1)
        say_hotkey(336)
        return
    }
    if ext == 1 && code == 0x5D {
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        kbdinput.compose_key()
        return
    }
    if ext == 1 && code < 0x80 {
        if blchain.on_ext_key(state, code) {
            kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
            return
        }
    }
    if ext == 0 && code >= 0x59 && code < 0x80 {
        blchain.on_key(state, false, code)
    }
    if code == 0x2A || code == 0x36 {
        kstate.set(state, kstate.K11_OFF + kstate.KB_SHIFT, 1)
        mod_down(state)
        return
    }
    if code == 0xAA || code == 0xB6 {
        if !mod_up(state, 1) {
            kstate.set(state, kstate.K11_OFF + kstate.KB_SHIFT, 0)
        }
        return
    }
    if code == 0x1D {
        if ext == 1 {
            kbdinput.rctrl_down()
        }
        kstate.set(state, kstate.K11_OFF + kstate.KB_CTRL, 1)
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        mod_down(state)
        return
    }
    if code == 0x9D {
        if ext == 1 {
            let _armed: bool = kbdinput.rctrl_up()
        }
        if !mod_up(state, 2) {
            kstate.set(state, kstate.K11_OFF + kstate.KB_CTRL, 0)
        }
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        return
    }
    if code == 0x38 {
        if ext == 1 {
            kstate.set(state, kstate.K11_OFF + kstate.KB_ALTGR, 1)
        } else {
            kstate.set(state, kstate.K11_OFF + kstate.KB_OLD, 1)
            mod_down(state)
        }
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        return
    }
    if code == 0xB8 {
        if ext == 1 {
            kstate.set(state, kstate.K11_OFF + kstate.KB_ALTGR, 0)
        } else {
            if !mod_up(state, 4) {
                kstate.set(state, kstate.K11_OFF + kstate.KB_OLD, 0)
            }
        }
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        return
    }
    // ============================ ROUND NETVIEW, THIRD ADDENDUM
    //
    // THE SUPER KEY DID NOT ARRIVE HERE, and this is where it did not.
    // It comes as 0xE0 0x5B (left) or 0xE0 0x5C (right); the prefix set
    // KB_EXT, and the code after it fell through to `arrow`, which has
    // no entry for 0x5B and returns 0 -- so the key was DROPPED without
    // a trace. Measured before anything was written: not one line of
    // this tree mentions 0x5B, and pressing the key produced nothing on
    // the serial line.
    //
    // It is a MODIFIER and is handled exactly like Shift and Control:
    // it produces no character, so it produces no `key: ` line, and the
    // promise of round K11 -- exactly one such line per key -- holds
    // unchanged. The release codes are 0x80 above the press codes and
    // are caught HERE, before the `code >= 0x80` return further down,
    // for the same reason 0x9D is caught here.
    if code == 0x5B || code == 0x5C {
        kstate.set(state, kstate.K11_OFF + kstate.KB_SUPER, 1)
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        // ==================================== RUNDE STARTKNOPF
        // SUPER ALLEIN OEFFNET DAS STARTMENUE.
        super_rein = 1
        return
    }
    if code == 0xDB || code == 0xDC {
        kstate.set(state, kstate.K11_OFF + kstate.KB_SUPER, 0)
        kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
        if super_rein != 0 {
            super_rein = 0
            kstate.set(state, kstate.K11_OFF + kstate.HK_KEY, 0)
            kstate.set(state, kstate.K11_OFF + kstate.HK_NS,
                time.mono_ns(state))
            kstate.add(state, kstate.K11_OFF + kstate.HK_SEQ, 1)
            say_hotkey(0)
        }
        return
    }
    if code < 0x80 {
        super_rein = 0
        kbdinput.other_key()
    }
    kstate.set(state, kstate.K11_OFF + kstate.KB_EXT, 0)
    if code >= 0x80 {
        return
    }
    // ROUND A11Y-2: A REAL KEY WENT THROUGH. A modifier still held no
    // longer latches when it is released, and one already latched falls
    // once this key is done (`on_code`, the wrapper).
    kstate.set(state, kstate.K11_OFF + kstate.KB_SEEN, 1)
    // 26.09.2026 (Dell 9020): THE NUMERIC KEYPAD. Its keys arrive as the
    // plain (non-E0) codes 0x47..0x53 -- the same codes as the cursor
    // block WITH E0. Nothing here looked at the Num Lock state: the
    // digits fell into `code_of`, whose tables end at 57, and were
    // dropped; KP 8 even acted as the up arrow. With Num Lock ON they
    // are digits, with it OFF they are the cursor block (fed back in
    // with the E0 they would have had). KP / (E0 35) and KP Enter
    // (E0 1C) were dropped by `arrow` and are caught here as well.
    if ext == 1 && code == 0x35 {
        deliver(state, 47) // '/'
        say_key(47)
        return
    }
    if ext == 1 && code == 0x1C {
        deliver(state, 10)
        say_key(10)
        return
    }
    if ext == 0 && code >= 0x47 && code <= 0x53
        && kstate.get(state, kstate.K11_OFF + kstate.KB_OLD) == 0
        && kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 0 {
        let kp: u64 = keypad(state, code)
        if kp != 0 {
            deliver(state, kp)
            say_key(kp)
            return
        }
        if code != 0x4C {
            on_code(state, 0xE0)
            on_code(state, code)
        }
        return
    }
    if code == 0x26 && kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 1
        && kstate.get(state, kstate.K11_OFF + kstate.KB_OLD) == 1 {
        cycle_layout(state)
        return
    }
    if code == 0x39 && kstate.get(state, kstate.K11_OFF + kstate.KB_SUPER) == 1 {
        cycle_layout(state)
        return
    }
    if kstate.get(state, kstate.K11_OFF + kstate.KB_SUPER) == 1
        && (code == 0x4B || code == 0x4D || code == 0x48 || code == 0x50) {
        var sc: u64 = 0x81
        if code == 0x4D {
            sc = 0x82
        }
        if code == 0x48 {
            sc = 0x83
        }
        if code == 0x50 {
            sc = 0x84
        }
        var s_wa: [u8; 15] = "kbd: win+arrow\0"
        serial.puts((&s_wa[0]) as u64)
        serial.put(10 as u8)
        push_hot(state, sc, 8)
        return
    }
    // W1 (hotkeys): CTRL+SHIFT+ESC = task manager. A global latch like Super+letter (code 1000), read by the taskbar.
    if code == 0x01 && kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 1
        && kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1 {
        kstate.set(state, kstate.K11_OFF + kstate.HK_KEY, 1000)
        kstate.set(state, kstate.K11_OFF + kstate.HK_NS, time.mono_ns(state))
        kstate.add(state, kstate.K11_OFF + kstate.HK_SEQ, 1)
        say_hotkey(1000)
        return
    }
    if kstate.get(state, kstate.K11_OFF + kstate.KB_OLD) == 1 {
        var an: u64 = 0
        if code == 0x1C {
            an = 27 // ESC [ 27 ; 3 ~  -- Alt+Eingabe
        } else if code == 0x4B {
            an = 20 // Alt+Links
        } else if code == 0x4D {
            an = 21 // Alt+Rechts
        } else if code == 0x48 {
            an = 22 // Alt+Hoch
        } else if code == 0x19 {
            an = 80 // Alt+P (preview pane of the file manager), ESC [ 80 ; 3 ~
        }
        if an != 0 {
            deliver(state, 27)
            deliver(state, 91)
            num_send(state, an)
            deliver(state, 59)
            deliver(state, 51) // ';3' = Alt
            deliver(state, 126)
            kstate.add(state, kstate.K11_OFF + kstate.KB_SEQS, 1)
            say_seq(an)
            return
        }
        old_key(state, code)
        return
    }
    // ================================================ RUNDE EXPLORER-2
    if code >= 0x3B && code <= 0x44 {
        var fn_n: u64 = 11 + (code - 0x3B)
        if code >= 0x40 {
            fn_n = 17 + (code - 0x40)
        }
        deliver(state, 27)
        deliver(state, 91)
        num_send(state, fn_n)
        deliver(state, 126)
        kstate.add(state, kstate.K11_OFF + kstate.KB_SEQS, 1)
        say_seq(fn_n)
        return
    }
    if code == 0x57 {
        var s_fk: [u8; 16] = "kbd: f11 -> hot\0"
        serial.puts((&s_fk[0]) as u64)
        serial.put(10 as u8)
        push_hot(state, KEY_F11, 0)
        return
    }
    if code == 0x58 {
        var s_gk: [u8; 16] = "kbd: f12 -> hot\0"
        serial.puts((&s_gk[0]) as u64)
        serial.put(10 as u8)
        push_hot(state, KEY_F12, 0)
        return
    }
    // ============================================ RUNDE GUI-EDITOR
    if code == 72 {
        let m_up: u64 = mods_of(state)
        if m_up == 0 {
            deliver(state, 14)
            say_key(14)
            return
        }
        deliver(state, 27)
        deliver(state, 91)
        deliver(state, 49) // '1'
        deliver(state, 59) // ';'
        deliver(state, 48 + m_up)
        deliver(state, 65) // 'A'
        kstate.add(state, kstate.K11_OFF + kstate.KB_SEQS, 1)
        say_seq(65)
        return
    }
    if ext == 1 {
        let final: u64 = arrow(code)
        if final == 0 {
            return
        }
        // r839: Shift+PageUp/PageDown scrolls the terminal history instead of reaching the shell.
        if (final == 256 + 53 || final == 256 + 54) && kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1
            && kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 0 && gfx.wm_ready(state) {
            if gfx.wm_term_page(state, final == 256 + 53) {
                return
            }
        }
        deliver(state, 27)
        deliver(state, 91)
        if final > 255 {
            deliver(state, final - 256)
            let m_t: u64 = mods_of(state)
            if m_t != 0 {
                deliver(state, 59)
                deliver(state, 48 + m_t)
            }
            deliver(state, 126)
        } else {
            // ==================================== RUNDE GUI-EDITOR
            let m_a: u64 = mods_of(state)
            if m_a != 0 {
                deliver(state, 49) // '1'
                deliver(state, 59) // ';'
                deliver(state, 48 + m_a)
            }
            deliver(state, final)
        }
        kstate.add(state, kstate.K11_OFF + kstate.KB_SEQS, 1)
        say_seq(final)
        return
    }
    // 24.09.2026: SHIFT+TAB IS THE BACKWARD TAB, and it arrived as a
    // plain 9 -- the same octet as Tab, so no program could move the
    // focus backwards (found on the login screen of a Dell 9020). It goes
    // out the way xterm sends it, `ESC [ Z`; wlib.decode makes KEY_BTAB
    // of it.
    // r1014: Ctrl+Shift+Tab = previous terminal tab (before it becomes ESC [ Z)
    if code == 15 && kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1
        && kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 1 && gfx.wm_ready(state) {
        if gfx.wm_term_key(state, 9, true) {
            return
        }
    }
    if code == 15 && kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1 {
        deliver(state, 27)
        deliver(state, 91)
        deliver(state, 90)
        kstate.add(state, kstate.K11_OFF + kstate.KB_SEQS, 1)
        var s_bt: [u8; 12] = "key: ESC[Z\0\0"
        serial.puts((&s_bt[0]) as u64)
        serial.nl()
        return
    }
    let lay_now: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_LAYOUT)
    let shift_now: bool = kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1
    let altgr_now: bool = kstate.get(state, kstate.K11_OFF + kstate.KB_ALTGR) == 1
    let typing: bool = kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 0
        && kstate.get(state, kstate.K11_OFF + kstate.KB_SUPER) == 0
    let caps_now: bool = typing && (lock_bits & LK_CAPS) != 0
    var c: u64 = code_for(lay_now, code, shift_now, altgr_now, caps_now)
    if c == 0 {
        return
    }
    if typing {
        let fed: u64 = kbdinput.feed_key(lay_now, code, shift_now, altgr_now, caps_now, c)
        if fed == 0 {
            return
        }
        let tail: u64 = fed >> 24
        if tail != 0 {
            emit(state, fed & 0xFFFFFF)
            c = tail
        } else {
            c = fed
        }
    }
    if kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 1 {
        // r1014: Ctrl+Shift+C / Ctrl+Shift+V (and Ctrl+C while a terminal selection stands) belong to the terminal window
        if gfx.wm_ready(state) {
            if gfx.wm_term_key(state, c, kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1) {
                return
            }
            // r1057 guard: Ctrl+Shift+C / Ctrl+Shift+V are never an interrupt / SYN octet, whatever window has the focus
            if kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1 && ((c | 32) == 99 || (c | 32) == 118) {
                return
            }
        }
        // ============================================ RUNDE EXPLORER-2
        let low0: u64 = c | 32
        if low0 == 104 || low0 == 110 { // 'h' oder 'n'
            var cn: u64 = 30 // Strg+H
            if low0 == 110 {
                cn = 31 // Strg+N
            }
            deliver(state, 27)
            deliver(state, 91)
            num_send(state, cn)
            var cmod: u64 = 53
            if low0 == 110 && kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1 {
                cmod = 54
            }
            deliver(state, 59)
            deliver(state, cmod)
            deliver(state, 126)
            kstate.add(state, kstate.K11_OFF + kstate.KB_SEQS, 1)
            say_seq(cn)
            return
        }
        let low: u64 = c | 32
        if low >= 97 && low <= 122 {
            c = low - 96
        }
    }
    // ============================ ROUND NETVIEW, THIRD ADDENDUM
    //
    // SUPER PLUS A LETTER IS A HOTKEY AND NOT TEXT. It is LATCHED here
    // and NOT delivered, and the "not delivered" is the important half:
    // a Super+A that also typed an `a` into whatever window had the
    // focus would put a stray letter in the person's document every
    // time they opened the quick settings.
    //
    // WHY A LATCH AND NOT AN EVENT. A hotkey has no window -- that is
    // what makes it global. The window server hands a key to the
    // window WITH THE FOCUS (`wm.on_key`), and the taskbar is
    // deliberately never that window. So the press is written down
    // here, with a counter and a timestamp, and whoever cares reads it
    // (SYS_OSUM_HOTKEY). The counter is the protocol: a reader that
    // sees a number it has not seen acts once, and two readers do not
    // take the press away from each other.
    if kstate.get(state, kstate.K11_OFF + kstate.KB_SUPER) == 1 {
        if c == 108 || c == 76 {
            if kstate.get(state, kstate.K11_OFF + kstate.SP_ON) == 0 {
                kstate.set(state, kstate.K11_OFF + kstate.SP_ON, 1)
                kstate.add(state, kstate.K11_OFF + kstate.SP_LOCKS, 1)
                var sl: [u8; 20] = "sperre: an (Win+L)\0\0"
                serial.puts((&sl[0]) as u64)
                serial.put(10 as u8)
            }
            return
        }
        // EMERGENCY STOP FOR REMOTE INPUT: Win+Esc, in the kernel like
        // Win+L, so it works even when the desktop hangs. It engages
        // the stop (no permit, no injection) and drops an open permit.
        // Release: `jarvisctl input on` as root.
        if c == 27 {
            tip.lock(state)
            var se: [u8; 32] = "input: emergency stop (Win+Esc)\0"
            serial.puts((&se[0]) as u64)
            serial.put(10 as u8)
            return
        }
        kstate.set(state, kstate.K11_OFF + kstate.HK_KEY, c)
        kstate.set(state, kstate.K11_OFF + kstate.HK_NS, time.mono_ns(state))
        kstate.add(state, kstate.K11_OFF + kstate.HK_SEQ, 1)
        say_hotkey(c)
        return
    }
    emit(state, c)
}

fn emit(state: u64, cp: u64) {
    var b: [u8; 4] = [0 as u8; 4]
    let n: u64 = utf8.encode(cp, (&b[0]) as u64)
    var i: u64 = 0
    while i < n {
        deliver(state, (b[i as usize]) as u64)
        i = i + 1
    }
    say_cp(cp, (&b[0]) as u64, n)
}

static mut super_rein: u64 = 0

fn super_down(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.KB_SUPER)
}

fn hotkey_seq(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.HK_SEQ)
}

fn hotkey_key(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.HK_KEY)
}

fn hotkey_ns(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.HK_NS)
}

// Its own line and not a `key: ` line, because it is not a key that was
// typed -- and because `tools/kernel/run.sh` counts `key: ` lines.
fn say_hotkey(c: u64) {
    var label: [u8; 12] = "hk: super+\0\0"
    var allein: [u8; 18] = "hk: super allein\0\0"
    if c == 336 {
        var pr: [u8; 10] = "hk: print\0"
        serial.puts((&pr[0]) as u64)
        serial.put(10 as u8)
        return
    }
    if c == 1000 {
        var tm: [u8; 12] = "hk: taskmgr\0"
        serial.puts((&tm[0]) as u64)
        serial.put(10 as u8)
        return
    }
    if c == 0 {
        serial.puts((&allein[0]) as u64)
        serial.put(10 as u8)
        return
    }
    serial.puts((&label[0]) as u64)
    serial.put(c as u8)
    serial.put(10 as u8)
}

fn deliver(state: u64, c: u64) {
    kstate.add(state, kstate.KEYS, 1)
    let n: u64 = kstate.get(state, kstate.KEYLEN)
    if n - kstate.get(state, kstate.KEYPOS) < MAX_KEYS {
        kstate.set8(state + kstate.KEYBUF + n % MAX_KEYS, c as u8)
        kstate.set(state, kstate.KEYLEN, n + 1)
    }
    if gfx.wm_ready(state) {
        gfx.wm_on_key(state, c as u64)
        let target: u64 = gfx.wm_key_tty(state)
        if target < tty.MAX_TTY && kstate.get(state, kstate.TTY_READY) != 0 {
            tty.push(state, target, c as u64)
        }
    } else {
        if kstate.get(state, kstate.TTY_READY) != 0 {
            tty.push(state, tty.console(), c as u64)
        }
    }
}

fn mods_of(state: u64) -> u64 {
    var m: u64 = 0
    if kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1 {
        m = m + 1
    }
    if kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 1 {
        m = m + 4
    }
    if m == 0 {
        return 0
    }
    return m + 1
}

// die Form `ESC [ n ~` statt `ESC [ x`.
fn arrow(code: u64) -> u64 {
    if code == 0x50 {
        return 66
    }
    if code == 0x4B {
        return 68
    }
    if code == 0x4D {
        return 67
    }
    if code == 0x47 {
        return 72 // H, Anfang
    }
    if code == 0x4F {
        return 70 // F, Ende
    }
    if code == 0x49 {
        return 256 + 53 // 5~, Seite hoch
    }
    if code == 0x51 {
        return 256 + 54 // 6~, Seite runter
    }
    if code == 0x53 {
        return 256 + 51 // 3~, Entfernen
    }
    if code == 0x1C {
        return 0
    }
    return 0
}

// The character of a keypad key, or 0 when it is a cursor key right
// now (Num Lock off). - and + do not depend on Num Lock.
fn keypad(state: u64, code: u64) -> u64 {
    if code == 0x4A {
        return 45 // '-'
    }
    if code == 0x4E {
        return 43 // '+'
    }
    if (lock_bits & LK_NUM) == 0 {
        return 0
    }
    if code == 0x53 {
        if layout(state) == L_DE {
            return 44 // ',' -- the German keypad has a comma
        }
        return 46 // '.'
    }
    var d: [u8; 13] = "789-456+1230\0"
    let v: u64 = (d[(code - 0x47) as usize]) as u64
    if v < 48 || v > 57 {
        return 0
    }
    return v
}

// ------------------------------------------------------- die Belegung

fn layout(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.KB_LAYOUT)
}

fn switches(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.KB_SWITCH)
}

fn set_layout(state: u64, n: u64) -> bool {
    if n >= LAYOUTS {
        return false
    }
    kstate.set(state, kstate.K11_OFF + kstate.KB_LAYOUT, n)
    kstate.add(state, kstate.K11_OFF + kstate.KB_SWITCH, 1)
    kbdinput.reset()
    return true
}

fn cycle_layout(state: u64) {
    let l: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_LAYOUT)
    let _ok: bool = set_layout(state, (l + 1) % LAYOUTS)
    say_layout(kstate.get(state, kstate.K11_OFF + kstate.KB_LAYOUT))
}

// ABTASTCODE -> CODEPUNKT.
fn code_of(lay: u64, code: u64, shift: bool, altgr: bool) -> u64 {
    return code_for(lay, code, shift, altgr, false)
}

fn code_for(lay: u64, code: u64, shift: bool, altgr: bool, caps: bool) -> u64 {
    if code == 14 {
        return 8
    }
    if code == 15 {
        return 9
    }
    if code == 72 {
        return 14
    }
    if kbdmap.has_slot(code) {
        return kbdmap.char_of(lay, code, shift, altgr, caps)
    }
    if shift {
        return (shifted(code)) as u64
    }
    return (translate(code)) as u64
}

// ROUND K1: how many keys are waiting to be read.
fn waiting(state: u64) -> u64 {
    return kstate.get(state, kstate.KEYLEN) - kstate.get(state, kstate.KEYPOS)
}

// ROUND K1: the next key, or 0 when there is none. This is the consumer
// side of the ring, and it is called from a system call -- `sys.fi` turns
// the interrupt flag off around it, because the producer is an interrupt.
fn take(state: u64) -> u64 {
    let pos: u64 = kstate.get(state, kstate.KEYPOS)
    if pos >= kstate.get(state, kstate.KEYLEN) {
        return 0
    }
    kstate.set(state, kstate.KEYPOS, pos + 1)
    return kstate.get8(state + kstate.KEYBUF + pos % MAX_KEYS)
}

// Scan code -> character, 0 = nothing printable. The table covers
// 0x00..0x39; everything above that is a modifier or a function key.
//
// ROUND K1: 0x0E is the backspace. Round 59 had no line to correct and
// left it silent; a shell has one, and 8 is what the correction is
// called. Nothing else in the table changed -- the four keys of round
// 59's case still come out as `firn`.
fn num_send(state: u64, v: u64) {
    if v >= 10 {
        deliver(state, 48 + (v / 10))
    }
    deliver(state, 48 + (v % 10))
}

fn translate(code: u64) -> u8 {
    if code == 14 {
        return 8 as u8
    }
    // ROUND K6: the up arrow. It arrives as `E0 48`, and the E0 is
    // dropped above like a release code, so 0x48 is left over -- the one
    // key a line editor needs and the table below has no room for. What
    // the shell reads is 0x0E, and it means: the line before this one.
    if code == 72 {
        return 14 as u8
    }
    if code == 15 {
        return 9 as u8
    }
    // ROUND NETVIEW, THIRD ADDENDUM: THE ESCAPE KEY. Scan code 1, and
    // position 1 of the table below is a NUL -- so it, too, has never
    // arrived in this system. Found the same way round K15 found the
    // tab key: by needing it and measuring that nothing happened. The
    // quick settings close on Escape, and a panel the keyboard cannot
    // get out of is worse than none.
    //
    // WHAT THIS CHANGES FOR EVERYONE ELSE, said plainly rather than
    // left to be discovered: a program that reads keys now sees a 27
    // where it saw nothing before. `/bin/edit` reads arrow keys as
    // `ESC [ x` and will take a lone Escape for the start of one,
    // swallowing the next character -- which is what a real terminal
    // does with a lone Escape too, and is why terminals have had a
    // timeout for it since the seventies. This round is not the one
    // that builds that timeout.
    if code == 1 {
        return 27 as u8
    }
    var table: [u8; 58] = "\0\01234567890-=\0\0qwertyuiop[]\n\0asdfghjkl;'`\0\\zxcvbnm,./\0*\0 "
    if code >= 58 {
        return 0 as u8
    }
    return table[code as usize]
}

fn shifted(code: u64) -> u8 {
    if code == 14 {
        return 8 as u8
    }
    if code == 15 {
        return 9 as u8
    }
    var table: [u8; 58] = "\0\0!@#$%^&*()_+\0\0QWERTYUIOP{}\n\0ASDFGHJKL:\"~\0|ZXCVBNM<>?\0*\0 "
    if code >= 58 {
        return 0 as u8
    }
    return table[code as usize]
}

// ------------------------------------------- RUNDE TILING: die Kuerzel

const HOT_SLOTS: u64 = 16

const KEY_F11: u64 = 0x8B

const KEY_F12: u64 = 0x8C
// r402: F4, only ever sent with Alt (Alt+F4); the same number as `tile.KEY_F4`
const KEY_F4: u64 = 0x8D

fn old_key(state: u64, code: u64) {
    var c: u64 = 0
    if code == 0x4B {
        c = 0x81
    }
    if code == 0x4D {
        c = 0x82
    }
    if code == 0x48 {
        c = 0x83
    }
    if code == 0x50 {
        c = 0x84
    }
    // r402: Alt+F4 (scan code 0x3E) goes to the hot-key ring as KEY_F4 + Alt
    if code == 0x3E {
        c = KEY_F4
    }
    if c == 0 {
        c = (translate(code)) as u64
    }
    if c == 0 {
        return
    }
    var m: u64 = 1 // MOD_ALT
    if kstate.get(state, kstate.K11_OFF + kstate.KB_SHIFT) == 1 {
        m = m | 2
    }
    if kstate.get(state, kstate.K11_OFF + kstate.KB_CTRL) == 1 {
        m = m | 4
    }
    var s_ak: [u8; 12] = "kbd: alt c=\0"
    var s_am: [u8; 6] = " mod=\0"
    serial.puts((&s_ak[0]) as u64)
    serial.dec(c)
    serial.puts((&s_am[0]) as u64)
    serial.dec(m)
    serial.put(10 as u8)
    push_hot(state, c, m)
}

fn push_hot(state: u64, c: u64, m: u64) {
    var head: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_HHEAD)
    let tail: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_HTAIL)
    if head - tail >= HOT_SLOTS {
        kstate.set(state, kstate.K11_OFF + kstate.KB_HTAIL, tail + 1)
    }
    let p: u64 = state + kstate.K11_OFF + kstate.KB_HOT
        + (head % HOT_SLOTS) * 2
    kstate.set8(p, c as u8)
    kstate.set8(p + 1, m as u8)
    kstate.set(state, kstate.K11_OFF + kstate.KB_HHEAD, head + 1)
    kstate.add(state, kstate.K11_OFF + kstate.KB_HOTS, 1)
}

fn hot_waiting(state: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.KB_HHEAD)
        - kstate.get(state, kstate.K11_OFF + kstate.KB_HTAIL)
}

fn hot_take(state: u64) -> u64 {
    if hot_waiting(state) == 0 {
        return 0
    }
    let tail: u64 = kstate.get(state, kstate.K11_OFF + kstate.KB_HTAIL)
    let p: u64 = state + kstate.K11_OFF + kstate.KB_HOT
        + (tail % HOT_SLOTS) * 2
    let c: u64 = kstate.get8(p)
    let m: u64 = kstate.get8(p + 1)
    kstate.set(state, kstate.K11_OFF + kstate.KB_HTAIL, tail + 1)
    return (m << 8) | c
}

// --------------------------------------------------------- die Meldung

fn say_key(c: u64) {
    var label: [u8; 6] = "key: \0"
    serial.puts((&label[0]) as u64)
    if c == 10 {
        var word: [u8; 8] = "[enter]\0"
        serial.puts((&word[0]) as u64)
    } else if c < 32 {
        serial.put(94 as u8)
        serial.put((c + 64) as u8)
    } else {
        serial.put(c as u8)
    }
    serial.nl()
}

fn say_cp(cp: u64, b: u64, n: u64) {
    var label: [u8; 6] = "key: \0"
    serial.puts((&label[0]) as u64)
    if cp == 10 {
        var word: [u8; 8] = "[enter]\0"
        serial.puts((&word[0]) as u64)
    } else if cp < 32 {
        serial.put(94 as u8)
        serial.put((cp + 64) as u8)
    } else {
        var i: u64 = 0
        while i < n {
            serial.put(__mmio_read8((b +% i) as *mut u8))
            i = i + 1
        }
    }
    if cp >= 0x80 {
        var u: [u8; 4] = " U+\0"
        serial.puts((&u[0]) as u64)
        hex4(cp)
    }
    serial.nl()
}

fn hex4(v: u64) {
    var i: u64 = 4
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * 4)) & 15
        if d < 10 {
            serial.put((48 + d) as u8)
        } else {
            serial.put((55 + d) as u8)
        }
    }
}

fn say_layout(n: u64) {
    var label: [u8; 14] = "kbd: layout=\0\0"
    serial.puts((&label[0]) as u64)
    var i: u64 = 0
    while i < kbdnames.NAME_LEN && kbdnames.name_at(n, i) != 0 {
        serial.put(kbdnames.name_at(n, i) as u8)
        i = i + 1
    }
    serial.nl()
}

fn say_seq(final: u64) {
    var label: [u8; 6] = "key: \0"
    serial.puts((&label[0]) as u64)
    serial.put(27 as u8)
    serial.put(91 as u8)
    if final > 255 {
        serial.put((final - 256) as u8)
        serial.put(126 as u8)
    } else {
        if final >= 10 {
            serial.put((48 + (final / 10)) as u8)
        }
        serial.put((48 + (final % 10)) as u8)
        serial.put(59 as u8)  // ';'
        serial.put(53 as u8)  // '5' = Steuerung
        serial.put(126 as u8) // '~'
    }
    serial.nl()
}
