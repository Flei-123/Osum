profile kernel

import drv.hid.inputclass
import drv.hid.i2chid
import drv.hid.ps2m

export { install }

fn install(state: u64) {
    inputclass.bind_provider(inputclass.KIND_PS2, ps2m.ops as u64)
    inputclass.bind_provider(inputclass.KIND_I2C, i2chid.ops as u64)
}
