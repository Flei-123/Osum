
profile kernel

import lib.kstate
import serial
import drv.hid.hidtest

export {
    parse, reset, ok, err, errpos, fields, nrid, hasid, top_usage, kind,
    dlen, items, maxdepth,
    f_head, f_rid, f_kind, f_flags, f_bitoff, f_bitsz, f_count, f_page,
    f_usage, f_umax, f_lmin, f_lmax,
    rid_at, rid_inbits, rid_outbits, rid_featbits, in_bytes_of, feat_bytes_of,
    raw_of, RAW_MAX, MAX_DEV, MAX_FIELDS, MAX_RIDS, USB_DEV_MAX, I2C_DEV_FIRST, I2C_DEV_MAX,
    E_OK, E_TRUNC, E_NEST, E_FIELDS, E_RIDS, E_PUSH, E_SIZE, E_USAGE,
    E_LONG, E_EMPTY, E_BIG,
    KIND_IN, KIND_OUT, KIND_FEAT,
    K_KBD, K_MOUSE, K_PAD, K_CONSUMER, K_TOUCH, K_PEN,
    FL_CONST, FL_VAR, FL_REL,
    UP_DESKTOP, UP_KEYBOARD, UP_LED, UP_BUTTON, UP_CONSUMER, UP_DIGITIZER,
    US_X, US_Y, US_WHEEL, US_TIPSW, US_CONTACTID, US_CONTACTCOUNT,
    US_CONFIDENCE, US_SCANTIME, US_ACPAN,
    say, say_as, say_fields, selbsttest
}

const FLD_OFF: u64 = 0x178000
const SUM_OFF: u64 = 0x180000
const RAW_OFF: u64 = 0x182000

const MAX_DEV: u64 = 8
const USB_DEV_MAX: u64 = 3
const I2C_DEV_FIRST: u64 = 3
const I2C_DEV_MAX: u64 = 5
const MAX_FIELDS: u64 = 64
const FLD_BYTES: u64 = 64
const SUM_BYTES: u64 = 1024
const RAW_MAX: u64 = 1024
const MAX_RIDS: u64 = 16
const MAX_USAGES: u64 = 32
const MAX_DEPTH: u64 = 8
const MAX_PUSH: u64 = 8

const F_HEAD: u64 = 0
const F_BITOFF: u64 = 8
const F_BITSZ: u64 = 16
const F_COUNT: u64 = 24
const F_PAGE: u64 = 32
const F_USAGE: u64 = 40
const F_LMIN: u64 = 48
const F_LMAX: u64 = 56

const S_OK: u64 = 0x00
const S_ERR: u64 = 0x08
const S_ERRPOS: u64 = 0x10
const S_NF: u64 = 0x18
const S_NRID: u64 = 0x20
const S_HASID: u64 = 0x28
const S_TOP: u64 = 0x30
const S_KIND: u64 = 0x38
const S_LEN: u64 = 0x40
const S_ITEMS: u64 = 0x48
const S_DEPTH: u64 = 0x50
const S_RIDTAB: u64 = 0x100

const R_ID: u64 = 0
const R_IN: u64 = 8
const R_OUT: u64 = 16
const R_FEAT: u64 = 24
const R_BYTES: u64 = 32

const E_OK: u64 = 0
const E_TRUNC: u64 = 1
const E_NEST: u64 = 2
const E_FIELDS: u64 = 3
const E_RIDS: u64 = 4
const E_PUSH: u64 = 5
const E_SIZE: u64 = 6
const E_USAGE: u64 = 7
const E_LONG: u64 = 8
const E_EMPTY: u64 = 9
const E_BIG: u64 = 10

const KIND_IN: u64 = 1
const KIND_OUT: u64 = 2
const KIND_FEAT: u64 = 3

const FL_CONST: u64 = 1
const FL_VAR: u64 = 2
const FL_REL: u64 = 4

const UP_DESKTOP: u64 = 0x01
const UP_KEYBOARD: u64 = 0x07
const UP_LED: u64 = 0x08
const UP_BUTTON: u64 = 0x09
const UP_CONSUMER: u64 = 0x0C
const UP_DIGITIZER: u64 = 0x0D

const US_X: u64 = 0x30
const US_Y: u64 = 0x31
const US_WHEEL: u64 = 0x38
const US_ACPAN: u64 = 0x0238
const US_TIPSW: u64 = 0x42
const US_CONFIDENCE: u64 = 0x47
const US_CONTACTID: u64 = 0x51
const US_CONTACTCOUNT: u64 = 0x54
const US_SCANTIME: u64 = 0x56

const K_KBD: u64 = 1
const K_MOUSE: u64 = 2
const K_PAD: u64 = 4
const K_CONSUMER: u64 = 8
const K_TOUCH: u64 = 16
const K_PEN: u64 = 32

fn sum(state: u64, dev: u64) -> u64 {
    return state + SUM_OFF + dev * SUM_BYTES
}

fn sg(state: u64, dev: u64, off: u64) -> u64 {
    return kstate.get(sum(state, dev), off)
}

fn ss(state: u64, dev: u64, off: u64, v: u64) {
    kstate.set(sum(state, dev), off, v)
}

fn fld(state: u64, dev: u64, i: u64) -> u64 {
    return state + FLD_OFF + dev * 0x1000 + i * FLD_BYTES
}

fn fg(state: u64, dev: u64, i: u64, off: u64) -> u64 {
    return kstate.get(fld(state, dev, i), off)
}

fn fs(state: u64, dev: u64, i: u64, off: u64, v: u64) {
    kstate.set(fld(state, dev, i), off, v)
}

fn rid_ent(state: u64, dev: u64, i: u64) -> u64 {
    return sum(state, dev) + S_RIDTAB + i * R_BYTES
}

fn raw_of(state: u64, dev: u64) -> u64 {
    return state + RAW_OFF + dev * RAW_MAX
}

fn ok(state: u64, dev: u64) -> bool {
    if dev >= MAX_DEV {
        return false
    }
    return sg(state, dev, S_OK) == 1
}

fn err(state: u64, dev: u64) -> u64 {
    if dev >= MAX_DEV {
        return E_EMPTY
    }
    return sg(state, dev, S_ERR)
}

fn errpos(state: u64, dev: u64) -> u64 {
    return sg(state, dev, S_ERRPOS)
}

fn fields(state: u64, dev: u64) -> u64 {
    if dev >= MAX_DEV {
        return 0
    }
    return sg(state, dev, S_NF)
}

fn nrid(state: u64, dev: u64) -> u64 {
    return sg(state, dev, S_NRID)
}

fn hasid(state: u64, dev: u64) -> bool {
    return sg(state, dev, S_HASID) == 1
}

fn top_usage(state: u64, dev: u64) -> u64 {
    return sg(state, dev, S_TOP)
}

fn kind(state: u64, dev: u64) -> u64 {
    if dev >= MAX_DEV {
        return 0
    }
    return sg(state, dev, S_KIND)
}

fn dlen(state: u64, dev: u64) -> u64 {
    return sg(state, dev, S_LEN)
}

fn items(state: u64, dev: u64) -> u64 {
    return sg(state, dev, S_ITEMS)
}

fn maxdepth(state: u64, dev: u64) -> u64 {
    return sg(state, dev, S_DEPTH)
}

fn f_head(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_HEAD)
}

fn f_rid(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_HEAD) & 0xFF
}

fn f_kind(state: u64, dev: u64, i: u64) -> u64 {
    return (fg(state, dev, i, F_HEAD) >> 8) & 0xFF
}

fn f_flags(state: u64, dev: u64, i: u64) -> u64 {
    return (fg(state, dev, i, F_HEAD) >> 16) & 0xFFFF
}

fn f_bitoff(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_BITOFF)
}

fn f_bitsz(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_BITSZ)
}

fn f_count(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_COUNT)
}

fn f_page(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_PAGE)
}

fn f_usage(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_USAGE) & 0xFFFFFFFF
}

fn f_umax(state: u64, dev: u64, i: u64) -> u64 {
    return (fg(state, dev, i, F_USAGE) >> 32) & 0xFFFFFFFF
}

fn f_lmin(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_LMIN)
}

fn f_lmax(state: u64, dev: u64, i: u64) -> u64 {
    return fg(state, dev, i, F_LMAX)
}

fn rid_at(state: u64, dev: u64, i: u64) -> u64 {
    if i >= MAX_RIDS {
        return 0
    }
    return kstate.get(rid_ent(state, dev, i), R_ID)
}

fn rid_inbits(state: u64, dev: u64, i: u64) -> u64 {
    if i >= MAX_RIDS {
        return 0
    }
    return kstate.get(rid_ent(state, dev, i), R_IN)
}

fn rid_outbits(state: u64, dev: u64, i: u64) -> u64 {
    if i >= MAX_RIDS {
        return 0
    }
    return kstate.get(rid_ent(state, dev, i), R_OUT)
}

fn rid_featbits(state: u64, dev: u64, i: u64) -> u64 {
    if i >= MAX_RIDS {
        return 0
    }
    return kstate.get(rid_ent(state, dev, i), R_FEAT)
}

fn in_bytes_of(state: u64, dev: u64, rid: u64) -> u64 {
    var i: u64 = 0
    let n: u64 = sg(state, dev, S_NRID)
    while i < n {
        if kstate.get(rid_ent(state, dev, i), R_ID) == rid {
            let b: u64 = kstate.get(rid_ent(state, dev, i), R_IN)
            return (b + 7) / 8
        }
        i = i + 1
    }
    return 0
}

fn feat_bytes_of(state: u64, dev: u64, rid: u64) -> u64 {
    var i: u64 = 0
    let n: u64 = sg(state, dev, S_NRID)
    while i < n {
        if kstate.get(rid_ent(state, dev, i), R_ID) == rid {
            return (kstate.get(rid_ent(state, dev, i), R_FEAT) + 7) / 8
        }
        i = i + 1
    }
    return 0
}

fn reset(state: u64, dev: u64) {
    if dev >= MAX_DEV {
        return
    }
    var i: u64 = 0
    while i < SUM_BYTES / 8 {
        kstate.set(sum(state, dev), i * 8, 0)
        i = i + 1
    }
}

fn sx(v: u64, n: u64) -> u64 {
    if n == 1 {
        if (v & 0x80) != 0 {
            return v | 0xFFFFFFFFFFFFFF00
        }
        return v & 0xFF
    }
    if n == 2 {
        if (v & 0x8000) != 0 {
            return v | 0xFFFFFFFFFFFF0000
        }
        return v & 0xFFFF
    }
    if n == 4 {
        if (v & 0x80000000) != 0 {
            return v | 0xFFFFFFFF00000000
        }
        return v & 0xFFFFFFFF
    }
    return 0
}

fn rid_slot(state: u64, dev: u64, rid: u64) -> u64 {
    var i: u64 = 0
    let n: u64 = sg(state, dev, S_NRID)
    while i < n {
        if kstate.get(rid_ent(state, dev, i), R_ID) == rid {
            return i
        }
        i = i + 1
    }
    if n >= MAX_RIDS {
        return MAX_RIDS
    }
    kstate.set(rid_ent(state, dev, n), R_ID, rid)
    kstate.set(rid_ent(state, dev, n), R_IN, 0)
    kstate.set(rid_ent(state, dev, n), R_OUT, 0)
    kstate.set(rid_ent(state, dev, n), R_FEAT, 0)
    ss(state, dev, S_NRID, n + 1)
    return n
}

fn bitpos_get(state: u64, dev: u64, slot: u64, kd: u64) -> u64 {
    if kd == KIND_IN {
        return kstate.get(rid_ent(state, dev, slot), R_IN)
    }
    if kd == KIND_OUT {
        return kstate.get(rid_ent(state, dev, slot), R_OUT)
    }
    return kstate.get(rid_ent(state, dev, slot), R_FEAT)
}

fn bitpos_set(state: u64, dev: u64, slot: u64, kd: u64, v: u64) {
    if kd == KIND_IN {
        kstate.set(rid_ent(state, dev, slot), R_IN, v)
        return
    }
    if kd == KIND_OUT {
        kstate.set(rid_ent(state, dev, slot), R_OUT, v)
        return
    }
    kstate.set(rid_ent(state, dev, slot), R_FEAT, v)
}

fn put(state: u64, dev: u64, rid: u64, kd: u64, flags: u64, bitoff: u64,
    bitsz: u64, cnt: u64, page: u64, usage: u64, umax: u64,
    lmin: u64, lmax: u64) -> bool {
    let i: u64 = sg(state, dev, S_NF)
    if i >= MAX_FIELDS {
        return false
    }
    fs(state, dev, i, F_HEAD,
        (rid & 0xFF) | ((kd & 0xFF) << 8) | ((flags & 0xFFFF) << 16))
    fs(state, dev, i, F_BITOFF, bitoff)
    fs(state, dev, i, F_BITSZ, bitsz)
    fs(state, dev, i, F_COUNT, cnt)
    fs(state, dev, i, F_PAGE, page)
    fs(state, dev, i, F_USAGE, (usage & 0xFFFFFFFF) | ((umax & 0xFFFFFFFF) << 32))
    fs(state, dev, i, F_LMIN, lmin)
    fs(state, dev, i, F_LMAX, lmax)
    ss(state, dev, S_NF, i + 1)
    return true
}

fn kind_of(page: u64, usage: u64) -> u64 {
    if page == UP_DESKTOP {
        if usage == 0x06 {
            return K_KBD
        }
        if usage == 0x02 {
            return K_MOUSE
        }
    }
    if page == UP_DIGITIZER {
        if usage == 0x05 {
            return K_PAD
        }
        if usage == 0x04 {
            return K_TOUCH
        }
        if usage == 0x02 || usage == 0x01 {
            return K_PEN
        }
    }
    if page == UP_CONSUMER {
        if usage == 0x01 {
            return K_CONSUMER
        }
    }
    return 0
}

fn fail(state: u64, dev: u64, code: u64, pos: u64) -> u64 {
    ss(state, dev, S_OK, 0)
    ss(state, dev, S_ERR, code)
    ss(state, dev, S_ERRPOS, pos)
    return code
}

fn parse(state: u64, dev: u64, buf: u64, len: u64) -> u64 {
    if dev >= MAX_DEV {
        return E_EMPTY
    }
    reset(state, dev)
    ss(state, dev, S_LEN, len)
    if len == 0 || len > RAW_MAX {
        return fail(state, dev, E_EMPTY, 0)
    }

    var gl: [u64; 10] = [0 as u64; 10]
    var stk: [u64; 80] = [0 as u64; 80]
    var sp: u64 = 0

    var ul: [u64; 32] = [0 as u64; 32]
    var nu: u64 = 0
    var umin: u64 = 0
    var umax: u64 = 0
    var range: bool = false

    var p: u64 = 0
    var depth: u64 = 0
    var maxd: u64 = 0
    var nitems: u64 = 0
    var map: u64 = 0

    while p < len {
        let start: u64 = p
        let b0: u64 = kstate.get8(buf + p)
        p = p + 1
        if b0 == 0xFE {
            return fail(state, dev, E_LONG, start)
        }
        var bsize: u64 = b0 & 3
        if bsize == 3 {
            bsize = 4
        }
        let btype: u64 = (b0 >> 2) & 3
        let btag: u64 = (b0 >> 4) & 0xF
        if p + bsize > len {
            return fail(state, dev, E_TRUNC, start)
        }
        var data: u64 = 0
        var k: u64 = 0
        while k < bsize {
            data = data | (kstate.get8(buf + p + k) << (k * 8))
            k = k + 1
        }
        p = p + bsize
        nitems = nitems + 1

        if btype == 1 {
            if btag == 0 {
                gl[0 as usize] = data & 0xFFFF
            }
            if btag == 1 {
                gl[1 as usize] = sx(data, bsize)
            }
            if btag == 2 {
                if (gl[1 as usize] >> 63) != 0 {
                    gl[2 as usize] = sx(data, bsize)
                } else {
                    gl[2 as usize] = data
                }
            }
            if btag == 3 {
                gl[3 as usize] = sx(data, bsize)
            }
            if btag == 4 {
                gl[4 as usize] = sx(data, bsize)
            }
            if btag == 5 {
                gl[5 as usize] = data
            }
            if btag == 6 {
                gl[6 as usize] = data
            }
            if btag == 7 {
                gl[7 as usize] = data
            }
            if btag == 8 {
                if data == 0 || data > 255 {
                    return fail(state, dev, E_SIZE, start)
                }
                gl[8 as usize] = data
                ss(state, dev, S_HASID, 1)
            }
            if btag == 9 {
                gl[9 as usize] = data
            }
            if btag == 10 {
                if sp >= MAX_PUSH {
                    return fail(state, dev, E_PUSH, start)
                }
                var q: u64 = 0
                while q < 10 {
                    stk[(sp * 10 + q) as usize] = gl[q as usize]
                    q = q + 1
                }
                sp = sp + 1
            }
            if btag == 11 {
                if sp == 0 {
                    return fail(state, dev, E_PUSH, start)
                }
                sp = sp - 1
                var q2: u64 = 0
                while q2 < 10 {
                    gl[q2 as usize] = stk[(sp * 10 + q2) as usize]
                    q2 = q2 + 1
                }
            }
        }

        if btype == 2 {
            if btag == 0 {
                if nu >= MAX_USAGES {
                    return fail(state, dev, E_USAGE, start)
                }
                if bsize == 4 {
                    ul[nu as usize] = data
                } else {
                    ul[nu as usize] = (gl[0 as usize] << 16) | (data & 0xFFFF)
                }
                nu = nu + 1
            }
            if btag == 1 {
                if bsize == 4 {
                    umin = data
                } else {
                    umin = (gl[0 as usize] << 16) | (data & 0xFFFF)
                }
                range = true
            }
            if btag == 2 {
                if bsize == 4 {
                    umax = data
                } else {
                    umax = (gl[0 as usize] << 16) | (data & 0xFFFF)
                }
                range = true
            }
        }

        if btype == 0 {
            if btag == 0xA {
                depth = depth + 1
                if depth > MAX_DEPTH {
                    return fail(state, dev, E_NEST, start)
                }
                if depth > maxd {
                    maxd = depth
                }
                if depth == 1 {
                    var tu: u64 = 0
                    if nu > 0 {
                        tu = ul[0 as usize]
                    } else {
                        if range {
                            tu = umin
                        }
                    }
                    if sg(state, dev, S_TOP) == 0 {
                        ss(state, dev, S_TOP, tu)
                    }
                    map = map | kind_of((tu >> 16) & 0xFFFF, tu & 0xFFFF)
                }
            }
            if btag == 0xC {
                if depth == 0 {
                    return fail(state, dev, E_NEST, start)
                }
                depth = depth - 1
            }
            if btag == 0x8 || btag == 0x9 || btag == 0xB {
                var kd: u64 = KIND_IN
                if btag == 0x9 {
                    kd = KIND_OUT
                }
                if btag == 0xB {
                    kd = KIND_FEAT
                }
                let rsize: u64 = gl[7 as usize]
                let rcount: u64 = gl[9 as usize]
                if rsize > 32 {
                    return fail(state, dev, E_SIZE, start)
                }
                if rcount > 1024 {
                    return fail(state, dev, E_SIZE, start)
                }
                if rsize * rcount > 4096 {
                    return fail(state, dev, E_BIG, start)
                }
                let slot: u64 = rid_slot(state, dev, gl[8 as usize])
                if slot >= MAX_RIDS {
                    return fail(state, dev, E_RIDS, start)
                }
                let base: u64 = bitpos_get(state, dev, slot, kd)
                if base + rsize * rcount > 4096 {
                    return fail(state, dev, E_BIG, start)
                }
                if !emit(state, dev, gl[8 as usize], kd, data & 0xFFFF,
                    base, rsize, rcount, gl[0 as usize],
                    (&ul[0]) as u64, nu, umin, umax, range,
                    gl[1 as usize], gl[2 as usize]) {
                    return fail(state, dev, E_FIELDS, start)
                }
                bitpos_set(state, dev, slot, kd, base + rsize * rcount)
            }
            nu = 0
            umin = 0
            umax = 0
            range = false
        }
    }

    if depth != 0 {
        return fail(state, dev, E_NEST, len)
    }
    ss(state, dev, S_ITEMS, nitems)
    ss(state, dev, S_DEPTH, maxd)
    ss(state, dev, S_KIND, map)
    ss(state, dev, S_OK, 1)
    ss(state, dev, S_ERR, E_OK)
    return E_OK
}

fn emit(state: u64, dev: u64, rid: u64, kd: u64, flags: u64, base: u64,
    rsize: u64, rcount: u64, page: u64, ulp: u64, nu: u64,
    umin: u64, umax: u64, range: bool, lmin: u64, lmax: u64) -> bool {
    if rcount == 0 || rsize == 0 {
        return true
    }
    if (flags & FL_CONST) != 0 {
        return put(state, dev, rid, kd, flags, base, rsize, rcount,
            page, 0, 0, lmin, lmax)
    }
    if (flags & FL_VAR) == 0 {
        var gmin: u64 = umin
        var gmax: u64 = umax
        if !range && nu > 0 {
            gmin = kstate.get(ulp, 0)
            gmax = gmin
        }
        return put(state, dev, rid, kd, flags, base, rsize, rcount,
            page, gmin & 0xFFFF, gmax & 0xFFFF, lmin, lmax)
    }
    if range {
        return put(state, dev, rid, kd, flags, base, rsize, rcount,
            page, umin & 0xFFFF, umax & 0xFFFF, lmin, lmax)
    }
    if nu == 0 {
        return put(state, dev, rid, kd, flags, base, rsize, rcount,
            page, 0, 0, lmin, lmax)
    }
    var i: u64 = 0
    while i < rcount {
        var j: u64 = i
        if i >= nu {
            let last: u64 = kstate.get(ulp, (nu - 1) * 8)
            return put(state, dev, rid, kd, flags,
                base + i * rsize, rsize, rcount - i,
                (last >> 16) & 0xFFFF, last & 0xFFFF, 0, lmin, lmax)
        }
        let u0: u64 = kstate.get(ulp, i * 8)
        while j + 1 < rcount && j + 1 < nu {
            let ua: u64 = kstate.get(ulp, j * 8)
            let ub: u64 = kstate.get(ulp, (j + 1) * 8)
            if ub != ua + 1 {
                break
            }
            j = j + 1
        }
        let n: u64 = j - i + 1
        if !put(state, dev, rid, kd, flags, base + i * rsize, rsize, n,
            (u0 >> 16) & 0xFFFF, u0 & 0xFFFF, (u0 + n - 1) & 0xFFFF,
            lmin, lmax) {
            return false
        }
        i = j + 1
    }
    return true
}

fn say(state: u64, dev: u64) {
    say_as(state, dev, dev)
}

fn say_as(state: u64, dev: u64, label: u64) {
    var s_a: [u8; 13] = "hidrep: dev=\0"
    var s_ok: [u8; 5] = " ok=\0"
    var s_er: [u8; 6] = " err=\0"
    var s_ep: [u8; 8] = " errat=\0"
    var s_f: [u8; 9] = " felder=\0"
    var s_r: [u8; 7] = " rids=\0"
    var s_h: [u8; 8] = " hasid=\0"
    var s_t: [u8; 6] = " top=\0"
    var s_k: [u8; 6] = " art=\0"
    var s_b: [u8; 7] = " bits=\0"
    var s_i: [u8; 9] = " posten=\0"
    var s_d: [u8; 8] = " tiefe=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(label)
    serial.puts((&s_ok[0]) as u64)
    var o: u64 = 0
    if ok(state, dev) {
        o = 1
    }
    serial.dec(o)
    serial.puts((&s_er[0]) as u64)
    serial.dec(err(state, dev))
    serial.puts((&s_ep[0]) as u64)
    serial.dec(errpos(state, dev))
    serial.puts((&s_f[0]) as u64)
    serial.dec(fields(state, dev))
    serial.puts((&s_r[0]) as u64)
    serial.dec(nrid(state, dev))
    serial.puts((&s_h[0]) as u64)
    var h: u64 = 0
    if hasid(state, dev) {
        h = 1
    }
    serial.dec(h)
    serial.puts((&s_t[0]) as u64)
    serial.hex(top_usage(state, dev))
    serial.puts((&s_k[0]) as u64)
    serial.dec(kind(state, dev))
    serial.puts((&s_b[0]) as u64)
    serial.dec(rid_inbits(state, dev, 0))
    serial.puts((&s_i[0]) as u64)
    serial.dec(items(state, dev))
    serial.puts((&s_d[0]) as u64)
    serial.dec(maxdepth(state, dev))
    serial.nl()
}

fn say_fields(state: u64, dev: u64, label: u64) {
    var s_a: [u8; 7] = "hidf: \0"
    var s_r: [u8; 6] = " rid=\0"
    var s_k: [u8; 6] = " art=\0"
    var s_m: [u8; 6] = " mrk=\0"
    var s_b: [u8; 6] = " bit=\0"
    var s_g: [u8; 5] = " gr=\0"
    var s_n: [u8; 6] = " anz=\0"
    var s_s: [u8; 7] = " page=\0"
    var s_u: [u8; 6] = " geb=\0"
    var s_x: [u8; 7] = " gmax=\0"
    var s_lo: [u8; 7] = " lmin=\0"
    var s_hi: [u8; 7] = " lmax=\0"
    var s_sp: [u8; 2] = " \0"
    var i: u64 = 0
    let n: u64 = fields(state, dev)
    while i < n {
        serial.puts((&s_a[0]) as u64)
        serial.dec(label)
        serial.puts((&s_sp[0]) as u64)
        serial.dec(i)
        serial.puts((&s_r[0]) as u64)
        serial.dec(f_rid(state, dev, i))
        serial.puts((&s_k[0]) as u64)
        serial.dec(f_kind(state, dev, i))
        serial.puts((&s_m[0]) as u64)
        serial.hex(f_flags(state, dev, i))
        serial.puts((&s_b[0]) as u64)
        serial.dec(f_bitoff(state, dev, i))
        serial.puts((&s_g[0]) as u64)
        serial.dec(f_bitsz(state, dev, i))
        serial.puts((&s_n[0]) as u64)
        serial.dec(f_count(state, dev, i))
        serial.puts((&s_s[0]) as u64)
        serial.hex(f_page(state, dev, i))
        serial.puts((&s_u[0]) as u64)
        serial.hex(f_usage(state, dev, i))
        serial.puts((&s_x[0]) as u64)
        serial.hex(f_umax(state, dev, i))
        serial.puts((&s_lo[0]) as u64)
        serial.hex(f_lmin(state, dev, i))
        serial.puts((&s_hi[0]) as u64)
        serial.hex(f_lmax(state, dev, i))
        serial.nl()
        i = i + 1
    }
}

fn selbsttest(state: u64) {
    var s_e: [u8; 16] = "hidrep: ende n=\0"
    var i: u64 = 0
    let n: u64 = hidtest.count()
    while i < n {
        let len: u64 = hidtest.load(i, raw_of(state, 0))
        parse(state, 0, raw_of(state, 0), len)
        say_as(state, 0, i)
        if ok(state, 0) {
            say_fields(state, 0, i)
        }
        i = i + 1
    }
    serial.puts((&s_e[0]) as u64)
    serial.dec(n)
    serial.nl()
}
