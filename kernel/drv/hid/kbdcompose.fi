profile kernel

import drv.hid.kbdcomb

export { active, arm, cancel, feed, lookup }

const SPACE: u64 = 32

static mut stage: u64 = 0
static mut first: u64 = 0

fn active() -> bool {
    return stage != 0
}

fn arm() {
    stage = 1
    first = 0
}

fn cancel() {
    stage = 0
    first = 0
}

fn lookup(a: u64, b: u64) -> u64 {
    let key: u64 = (a << 21) | b
    var i: u64 = 0
    while i < kbdcomb.COMPOSE_N {
        let e: u64 = kbdcomb.COMPOSE_TAB[i as usize]
        if (e >> 21) == key {
            return e & 0x1FFFFF
        }
        i = i + 1
    }
    return 0
}

fn feed(cp: u64) -> u64 {
    if stage == 0 {
        return cp
    }
    if cp < SPACE {
        cancel()
        return cp
    }
    if stage == 1 {
        first = cp
        stage = 2
        return 0
    }
    let result: u64 = lookup(first, cp)
    cancel()
    return result
}
