// SPDX-License-Identifier: GPL-2.0-only
// kernel/i2chid.fi -- Runde HID: HID UEBER I2C.
//
// DAS IST DER PUNKT DIESER RUNDE. Auf einem Desktop haengt die Tastatur
// am 8042 und die Maus am USB; auf einem gewoehnlichen Laptop von 2026
// haengen TASTATUR UND TOUCHPAD AN I2C. Dort hatte Osum bis zu dieser
// Runde gar keine Eingabe -- nicht "eine schlechte", sondern keine.
//
// Der Weg dorthin hat drei Stufen, und jede kann fuer sich scheitern:
//
//   1. DEN REGLER FINDEN. Auf Intel-Brettern ist das ein
//      Designware-I2C in der LPSS, sichtbar auf dem PCI-Bus. Er wird
//      an seiner PCI-Klasse gesucht UND an seiner Kennung
//      nachgeprueft: das Register IC_COMP_TYPE liefert 0x44570140,
//      und das ist die einzige Auskunft, die wirklich aus dem Baustein
//      kommt und nicht aus einer Tabelle.
//   2. DAS GERAET FINDEN. Wo ein I2C-Geraet haengt (Sklavenadresse)
//      und unter welchem Register seine HID-Beschreibung liegt, sagt
//      die Firmware in ACPI -- in `_CRS` und `_DSM`.
//   3. DAS PROTOKOLL SPRECHEN. HID over I2C: ein Registerwort
//      hinschreiben, die Antwort lesen.
//
// ====================================================================
// DER ERSATZWEG FUER ACPI, UND WARUM ER EINER IST
//
// Stufe 2 braucht eigentlich einen AML-INTERPRETER: `_CRS` und `_DSM`
// sind METHODEN, und eine Methode muss man ausfuehren. Den baut gerade
// die Runde AML auf dem Zweig `aml`. NACHGESEHEN AM 30.08.2026: dieser
// Zweig zeigt auf denselben Commit wie `mergeline2` -- er enthaelt noch
// keine Zeile. Gegen eine gedachte Schnittstelle zu bauen waere das
// Schlechteste von beidem.
//
// ALSO DER ERSATZWEG, und er ist besser als sein Ruf: `_CRS` gibt eine
// RESSOURCENVORLAGE zurueck, und die ist im AML-Oktettstrom ein
// BUFFER mit einer Folge von Ressourcenbeschreibungen -- eine FESTE
// BINAERSTRUKTUR, kein Programm. Der grosse Ressourcentyp 0x8E
// ("Serial Bus Connection") mit Bustyp 0x01 ist eine
// I2C-Verbindung, und die Sklavenadresse steht darin an einer festen
// Stelle:
//
//     +0   0x8E              grosser Ressourcentyp
//     +1   Laenge, 2 Oktett
//     +3   Revision
//     +4   Index der Ressourcenquelle
//     +5   Bustyp            0x01 = I2C
//     +6   allgemeine Merker
//     +7   typabhaengige Merker, 2 Oktett
//     +9   typabhaengige Revision
//     +10  Laenge der Typdaten, 2 Oktett
//     +12  Verbindungsgeschwindigkeit, 4 Oktett
//     +16  SKLAVENADRESSE, 2 Oktett
//
// Diese Oktette lassen sich in DSDT und SSDT SUCHEN, ohne eine einzige
// AML-Anweisung auszufuehren. Was dabei herauskommt, ist die Liste der
// I2C-Adressen, die die Firmware ueberhaupt beschreibt -- und auf
// einem Laptop sind das eine Handvoll, von denen zwei die Tastatur und
// das Touchpad sind. Auf jede davon wird das HID-ueber-I2C-Protokoll
// PROBIERT; wer nicht antwortet oder keine gueltige HID-Beschreibung
// liefert, war es nicht.
//
// WAS DER ERSATZWEG NICHT KANN, und das gehoert dazu:
//   * Er kann `_CRS` nicht AUSWERTEN, sondern nur wiedererkennen. Steht
//     die Ressourcenvorlage nicht woertlich in der Tabelle, sondern
//     wird zur Laufzeit zusammengebaut (`Concatenate`, `Store` in einen
//     Puffer), findet er sie nicht.
//   * Er kann `_DSM` GAR NICHT. Dort steht, unter welchem Register die
//     HID-Beschreibung liegt. Statt zu raten wird DER STANDARDWERT 0x0001
//     genommen und, wenn der nichts Gueltiges liefert, 0x0020 versucht --
//     das sind die beiden Werte, die in der Praxis vorkommen. Ein
//     Geraet mit einem dritten Wert wird nicht gefunden.
//   * Er kann die Unterbrechungsleitung (GpioInt in `_CRS`) nicht dem
//     Geraet zuordnen. Deshalb wird ABGEFRAGT und nicht auf eine
//     Meldung gewartet.
//
// >>> WAS SPAETER AUF AML UMZUSTELLEN IST, an genau diesen Stellen:
// >>>   `acpi_scan`      -> `_CRS` auswerten statt Oktette suchen
// >>>   `HDESC_DEFAULT`  -> `_DSM` Funktion 1 auswerten
// >>>   `poll`           -> GpioInt aus `_CRS` statt Abfrage
// >>> Dasselbe steht in docs/REALHW.md.
//
// ====================================================================
// WAS HIER GEMESSEN IST UND WAS NICHT
//
// QEMU HAT KEINEN DESIGNWARE-I2C. `-device help` kennt `i2c-ddc` und
// `smbus-ipmi` an einem SMBus, aber keinen LPSS-Regler und kein
// I2C-HID-Geraet. Deshalb, ehrlich getrennt:
//
//   GEMESSEN (tools/hid/run.sh):
//     * Der ACPI-Sucher findet in einer GEBAUTEN Tabelle mit zwei
//       I2C-Ressourcen genau diese zwei Adressen -- und nicht mehr.
//     * Er findet in der ECHTEN DSDT, die QEMU stellt, KEINE -- was
//       richtig ist, denn dort ist keine.
//     * Der Zerleger fuer die 30 Oktett HID-ueber-I2C-Beschreibung
//       liefert aus einem echten Oktettstrom die richtigen Register.
//     * Die Suche nach dem Regler laeuft auf einer Maschine ohne einen
//       solchen durch und meldet "keiner", statt etwas zu erfinden.
//
//   NUR AUS DER SPEZIFIKATION, in QEMU NICHT pruefbar:
//     * Jeder Zugriff auf die Designware-Register (`dw_*`).
//     * Das Aufsetzen des Reglers, Taktzahlen, die Warteschlangen.
//     * Ob ein echtes Geraet auf 0x0001 antwortet.
//   Diese Stellen sind unten einzeln mit "NUR SPEZIFIKATION" markiert.

profile kernel

import lib.kstate
import serial
import bus.pci
import acpi.acpi
import acpi.aml
import acpi.amlns
import acpi.amlobj
import drv.hid.hidrep
import drv.hid.hidin
import drv.hid.hidtest
import sched.time

export {
    stage, present, slaves, slave_at, ctrl_mmio, ctrl_bdf, found,
    acpi_scan, hid_desc, poll, scan_test,
    hd_len, hd_rdlen, hd_rdreg, hd_inreg, hd_maxin, hd_cmdreg, hd_datareg,
    hd_vid, hd_pid, say, selftest, SELFTEST_MAX,
    DW_MAGIC, MAX_SLAVES, HDESC_DEFAULT, HDESC_OLD,
    poll_tick, simrun, simrun2, SIM_MM, SIM_MM2,
    nctrl, ndev, find_ctrls, dev_ctrl, dev_adr, dev_slot, render, aml_scan
}

// Zwei Seiten aus dem Rest, den `kstate.fi` nach Merge 2 ausweist.
const I2C_OFF: u64 = 0xA7000 // Zaehler, Adressliste, HID-Beschreibung
const BUF_OFF: u64 = 0xA8000 // ein Uebertragungspuffer, 4096

const MAX_SLAVES: u64 = 8

// Die Kennung eines Designware-I2C. Sie steht in IC_COMP_TYPE und ist
// das Einzige an dieser Suche, was wirklich aus dem Baustein kommt.
const DW_MAGIC: u64 = 0x44570140

// Die Designware-Register (Abstand vom Anfang der Speicherblende).
const IC_CON: u64 = 0x00
const IC_TAR: u64 = 0x04
const IC_DATA_CMD: u64 = 0x10
const IC_SS_HCNT: u64 = 0x14
const IC_SS_LCNT: u64 = 0x18
const IC_FS_HCNT: u64 = 0x1C
const IC_FS_LCNT: u64 = 0x20
const IC_INTR_MASK: u64 = 0x30
const IC_RAW_INTR: u64 = 0x34
const IC_RX_TL: u64 = 0x38
const IC_TX_TL: u64 = 0x3C
const IC_CLR_INTR: u64 = 0x40
const IC_CLR_TX_ABRT: u64 = 0x54
const IC_ENABLE: u64 = 0x6C
const IC_STATUS: u64 = 0x70
const IC_TXFLR: u64 = 0x74
const IC_RXFLR: u64 = 0x78
const IC_TX_ABRT_SRC: u64 = 0x80
const IC_ENABLE_STATUS: u64 = 0x9C
const IC_COMP_TYPE: u64 = 0xFC

// IC_CON: Herr am Bus, schnelle Betriebsart, Neustart erlaubt, kein
// Sklavenbetrieb.
const CON_MASTER: u64 = 0x01
const CON_SPEED_FAST: u64 = 0x04
const CON_RESTART_EN: u64 = 0x20
const CON_SLAVE_DIS: u64 = 0x40

// IC_DATA_CMD: Bit 8 = lesen, Bit 9 = Halt danach, Bit 10 = Neustart.
const CMD_READ: u64 = 0x100
const CMD_STOP: u64 = 0x200
const CMD_RESTART: u64 = 0x400

const STAT_TX_ABRT: u64 = 0x40 // IC_RAW_INTR_STAT Bit 6

// Das Register, unter dem die HID-Beschreibung liegt. Steht eigentlich
// in `_DSM` Funktion 1; ohne AML-Interpreter werden die beiden Werte
// probiert, die in der Praxis vorkommen.
const HDESC_DEFAULT: u64 = 0x0001
const HDESC_OLD: u64 = 0x0020

// Der Ressourcentyp einer I2C-Verbindung in einer Ressourcenvorlage.
const RES_SERIALBUS: u64 = 0x8E
const BUS_I2C: u64 = 0x01

// Die Zaehler und die Liste.
const S_FOUND: u64 = 0x00 // 1 = ein Designware-Regler ist da
const S_BDF: u64 = 0x08
const S_MMIO: u64 = 0x10
const S_NSLAVE: u64 = 0x18
const S_TABLES: u64 = 0x20 // durchsuchte ACPI-Tabellen
const S_PNP0C50: u64 = 0x28 // Treffer auf die Kennung eines I2C-HID
const S_READY: u64 = 0x30 // 1 = ein Geraet antwortet
const S_ABORTS: u64 = 0x38
const S_TIMEOUTS: u64 = 0x40
const S_REPORTS: u64 = 0x48
const S_HDREG: u64 = 0x50 // das Register, unter dem es geklappt hat
const S_SLAVES: u64 = 0x80 // MAX_SLAVES Woerter

// Die 30 Oktett der HID-ueber-I2C-Beschreibung, zerlegt.
const H_LEN: u64 = 0x100
const H_VERSION: u64 = 0x108
const H_RDLEN: u64 = 0x110
const H_RDREG: u64 = 0x118
const H_INREG: u64 = 0x120
const H_MAXIN: u64 = 0x128
const H_OUTREG: u64 = 0x130
const H_MAXOUT: u64 = 0x138
const H_CMDREG: u64 = 0x140
const H_DATAREG: u64 = 0x148
const H_VID: u64 = 0x150
const H_PID: u64 = 0x158
const H_VER: u64 = 0x160


// ======================================================================
// W-TOUCH3: TABLES FOR SEVERAL CONTROLLERS AND SEVERAL DEVICES.
//
// A laptop of 2026 has up to eight LPSS I2C controllers; the touchpad sits
// on one, the touch screen and the pen on ANOTHER. The first version knew
// exactly one controller (S_MMIO) and one device (HID_SLOT). The tables are
// `static mut` (no kstate offset), one flat array of words:
//   controller c (0..MAX_CTRL-1): words T_CTRL + c*8 + CT_*
//   device j (0..I2C_DEV_MAX-1):  words T_DEV  + j*16 + DV_*  (HID slot = I2C_DEV_FIRST + j)
// S_MMIO stays "the controller the dw_* functions talk to right now"
// (select_ctrl), so the register code below did not have to change.
static mut tb: [u64; 512] = [0 as u64; 512]
const MAX_CTRL: u64 = 8
const T_CTRL: u64 = 0
const CT_MMIO: u64 = 0
const CT_BDF: u64 = 1
const CT_IDS: u64 = 2 // vendor << 16 | device
const CT_STATE: u64 = 3 // 0 = ok, 1 = HUNG (3 timeouts), skipped from then on
const CT_TMO: u64 = 4
const CT_ABRT: u64 = 5
const CT_PROBES: u64 = 6
const T_DEV: u64 = 64
const DV_CTRL: u64 = 0
const DV_ADR: u64 = 1
const DV_HREG: u64 = 2
const DV_RDLEN: u64 = 3
const DV_MAXIN: u64 = 4
const DV_VID: u64 = 5
const DV_PID: u64 = 6
const DV_STATE: u64 = 7 // 0 = empty, 1 = ok, 2 = lost (still polled, slowly)
const DV_FAILS: u64 = 8
const DV_NEXT: u64 = 9 // next poll, ms
const DV_BACK: u64 = 10 // current backoff, ms
const DV_REPS: u64 = 11
const DV_VIA: u64 = 12 // 0 = byte search, 1 = AML
const DV_INREG: u64 = 13
const DV_CMDREG: u64 = 14
const DV_KIND: u64 = 15
const X_NCTRL: u64 = 200
const X_NDEV: u64 = 201
const X_CUR_C: u64 = 202 // controller the setup was made for (0xFF = none)
const X_CUR_A: u64 = 203 // address the setup was made for (0xFFFF = none)
const X_AML: u64 = 204 // 1 = the AML path produced candidates
const POLL_FAST_MS: u64 = 8
const POLL_BACK_MAX: u64 = 500
const LOST_FAILS: u64 = 40

fn tg(i: u64) -> u64 {
    return kstate.get((&tb[0]) as u64, i * 8)
}

fn ts(i: u64, v: u64) {
    kstate.set((&tb[0]) as u64, i * 8, v)
}

fn ctg(c: u64, f: u64) -> u64 {
    return tg(T_CTRL + c * 8 + f)
}

fn cts(c: u64, f: u64, v: u64) {
    ts(T_CTRL + c * 8 + f, v)
}

fn dvg(j: u64, f: u64) -> u64 {
    return tg(T_DEV + j * 16 + f)
}

fn dvs(j: u64, f: u64, v: u64) {
    ts(T_DEV + j * 16 + f, v)
}

fn nctrl() -> u64 {
    return tg(X_NCTRL)
}

fn ndev() -> u64 {
    return tg(X_NDEV)
}

fn dev_ctrl(j: u64) -> u64 {
    return dvg(j, DV_CTRL)
}

fn dev_adr(j: u64) -> u64 {
    return dvg(j, DV_ADR)
}

fn dev_slot(j: u64) -> u64 {
    return hidrep.I2C_DEV_FIRST + j
}

fn tables_reset() {
    var i: u64 = 0
    while i < 512 {
        ts(i, 0)
        i = i + 1
    }
    ts(X_CUR_C, 0xFF)
    ts(X_CUR_A, 0xFFFF)
}

// Make controller c the one the dw_* functions talk to. The next transfer
// must run dw_setup again (X_CUR_A invalid).
fn select_ctrl(state: u64, c: u64) {
    s(state, S_MMIO, ctg(c, CT_MMIO))
    s(state, S_BDF, ctg(c, CT_BDF))
    ts(X_CUR_C, c)
    ts(X_CUR_A, 0xFFFF)
}

fn add_ctrl(state: u64, bdf: u64, ids: u64, mm: u64) -> bool {
    let n: u64 = nctrl()
    var i: u64 = 0
    while i < n {
        if ctg(i, CT_MMIO) == mm {
            return false
        }
        i = i + 1
    }
    if n >= MAX_CTRL {
        return false
    }
    cts(n, CT_MMIO, mm)
    cts(n, CT_BDF, bdf)
    cts(n, CT_IDS, ids)
    cts(n, CT_STATE, 0)
    ts(X_NCTRL, n + 1)
    s(state, S_FOUND, 1)
    if n == 0 {
        s(state, S_BDF, bdf)
        s(state, S_MMIO, mm)
    }
    return true
}

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state + I2C_OFF, off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state + I2C_OFF, off, v)
}

fn buf(state: u64) -> u64 {
    return state + BUF_OFF
}

fn present(state: u64) -> bool {
    return g(state, S_FOUND) == 1
}

fn found(state: u64) -> bool {
    return ndev() > 0
}

fn slaves(state: u64) -> u64 {
    return g(state, S_NSLAVE)
}

fn slave_at(state: u64, i: u64) -> u64 {
    if i >= MAX_SLAVES {
        return 0
    }
    return g(state, S_SLAVES + i * 8)
}

fn ctrl_mmio(state: u64) -> u64 {
    return g(state, S_MMIO)
}

fn ctrl_bdf(state: u64) -> u64 {
    return g(state, S_BDF)
}

fn hd_len(state: u64) -> u64 {
    return g(state, H_LEN)
}

fn hd_rdlen(state: u64) -> u64 {
    return g(state, H_RDLEN)
}

fn hd_rdreg(state: u64) -> u64 {
    return g(state, H_RDREG)
}

fn hd_inreg(state: u64) -> u64 {
    return g(state, H_INREG)
}

fn hd_maxin(state: u64) -> u64 {
    return g(state, H_MAXIN)
}

fn hd_cmdreg(state: u64) -> u64 {
    return g(state, H_CMDREG)
}

fn hd_datareg(state: u64) -> u64 {
    return g(state, H_DATAREG)
}

fn hd_vid(state: u64) -> u64 {
    return g(state, H_VID)
}

fn hd_pid(state: u64) -> u64 {
    return g(state, H_PID)
}

// ======================================================================
// STUFE 1: DEN REGLER FINDEN.
//
// Zwei Wege, und der zweite prueft den ersten nach:
//   a) Auf dem PCI-Bus. Intel meldet die LPSS-I2C-Regler als Klasse
//      0x0C Unterklasse 0x80 ("serieller Bus, anderes") -- manche
//      Erzeugnisse auch als 0x11/0x80. Beide werden angesehen.
//   b) IC_COMP_TYPE lesen. Steht dort 0x44570140, ist es wirklich ein
//      Designware. Eine PCI-Klasse ist eine Behauptung der Firmware,
//      dieses Register ist eine Auskunft des Bausteins.
//
// GEMESSEN: dass das auf einer Maschine OHNE einen solchen Regler
// durchlaeuft und "keiner" meldet. NUR SPEZIFIKATION: dass es auf einer
// Maschine MIT einem den richtigen findet -- QEMU hat keinen.
// SPEC ONLY on hardware (HP-6, r1514). Intel LPSS functions (Sunrise Point / Kaby Lake-U, e.g. 8086:9d60..9d65)
// may sit in D3 and keep the DesignWare core in reset until the driver releases it (Linux intel-lpss:
// private registers at BAR0+0x200, RESETS at +0x204, value 3 = both resets released). Without this the
// IC_COMP_TYPE read below can return 0 or all-ones and the controller looks absent. Safe elsewhere: only
// Intel functions with a BAR of at least 4 KiB are touched, and the reset write is the documented value.
const LPSS_PRIV_RESETS: u64 = 0x204
const LPSS_RESETS_RELEASE: u64 = 3
const PCI_CAP_PM: u64 = 0x01

fn lpss_wake(state: u64, i: u64, mm: u64) {
    if pci.get(state, i, pci.E_VENDOR) != 0x8086 {
        return
    }
    if pci.bar_size(state, i, 0) < 0x1000 {
        return
    }
    let bdf: u64 = pci.get(state, i, pci.E_BDF)
    pci.enable_master(bdf)
    let pm: u64 = pci.cap_find(bdf, PCI_CAP_PM)
    if pm != 0 {
        let pmcsr: u64 = pci.cfg_read16(bdf, pm + 4)
        if (pmcsr & 3) != 0 {
            pci.cfg_write16(bdf, pm + 4, pmcsr & 0xFFFC) // back to D0
        }
    }
    __mmio_write32((mm + LPSS_PRIV_RESETS) as *mut u32, LPSS_RESETS_RELEASE as u32)
}

// Intel LPSS I2C functions by PCI id (Sunrise Point-LP, Union Point/Kaby Lake, Cannon Point-LP, Cannon Lake PCH-H).
fn is_lpss_id(dev: u64) -> bool {
    if dev >= 0x9d60 && dev <= 0x9d66 {
        return true
    }
    if dev >= 0xa160 && dev <= 0xa167 {
        return true
    }
    if dev >= 0x9de8 && dev <= 0x9dec {
        return true
    }
    if dev >= 0xa368 && dev <= 0xa36b {
        return true
    }
    return false
}

// ALL controllers: every PCI function of class 0C/80 or 11/80 or of an
// Intel LPSS id with a memory BAR 0 whose IC_COMP_TYPE reads DW_MAGIC.
// Word `i2cold` (counter-check) keeps only the first one, like before.
fn find_ctrls(state: u64) -> u64 {
    let n: u64 = pci.count(state)
    var i: u64 = 0
    while i < n {
        let cls: u64 = pci.get(state, i, pci.E_CLASS)
        let sub: u64 = pci.get(state, i, pci.E_SUBCLASS)
        let ven: u64 = pci.get(state, i, pci.E_VENDOR)
        let dev: u64 = pci.get(state, i, pci.E_DEVICE)
        var cand: bool = false
        if (cls == 0x0C || cls == 0x11) && sub == 0x80 {
            cand = true
        }
        if ven == 0x8086 && is_lpss_id(dev) {
            cand = true
        }
        if cand && !(kstate.mode_on(state, kstate.M_I2COLD) && nctrl() >= 1) {
            let bar: u64 = pci.bar(state, i, 0)
            if bar != 0 && !pci.bar_is_io(state, i, 0) {
                let mm: u64 = bar & 0xFFFFFFFFFFFFFFF0
                lpss_wake(state, i, mm)
                if kstate.get32(mm + IC_COMP_TYPE) == DW_MAGIC {
                    add_ctrl(state, pci.get(state, i, pci.E_BDF), (ven << 16) | dev, mm)
                }
            }
        }
        i = i + 1
    }
    return nctrl()
}

// ======================================================================
// STUFE 2: DAS GERAET FINDEN -- DER ERSATZWEG.
//
// Alle ACPI-Tabellen durchgehen und nach dem Oktettmuster einer
// I2C-Verbindung suchen. Kein AML wird ausgefuehrt; gesucht wird eine
// BINAERSTRUKTUR, die in `_CRS` woertlich im Strom steht.
//
// GEPRUEFT WIRD JEDES FELD, und das ist der Unterschied zwischen einer
// Suche und einem Zufallstreffer: das Oktett 0x8E kommt in einem
// AML-Strom staendig vor. Ein Treffer zaehlt nur, wenn die angesagte
// Laenge passt, der Bustyp 0x01 ist, die Typdatenlaenge mindestens
// sechs betraegt und die Adresse in den 7-Bit-Bereich faellt.
fn acpi_scan(state: u64) -> u64 {
    var n: u64 = 0
    let tn: u64 = acpi.table_count(state)
    var t: u64 = 0
    while t < tn {
        let p: u64 = acpi.table_at(state, t)
        if p != 0 {
            let len: u64 = kstate.get32(p + 4)
            if len > 36 && len < 0x200000 {
                n = n + scan_block(state, p + 36, len - 36, n)
            }
        }
        t = t + 1
    }
    s(state, S_TABLES, tn)
    s(state, S_NSLAVE, n)
    return n
}

// Einen Oktettblock durchsuchen. `schon` ist, wie viele Adressen
// bereits stehen -- die Liste ist begrenzt und eine Adresse kommt nur
// EINMAL hinein (dieselbe Vorlage steht in manchen Tabellen mehrfach).
fn scan_block(state: u64, p: u64, len: u64, schon: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i + 18 <= len {
        if kstate.get8(p + i) == RES_SERIALBUS {
            let rlen: u64 = kstate.get8(p + i + 1)
                | (kstate.get8(p + i + 2) << 8)
            let bus: u64 = kstate.get8(p + i + 5)
            let tdlen: u64 = kstate.get8(p + i + 10)
                | (kstate.get8(p + i + 11) << 8)
            let adr: u64 = kstate.get8(p + i + 16)
                | (kstate.get8(p + i + 17) << 8)
            if bus == BUS_I2C && rlen >= 15 && rlen + 3 <= len - i
                && tdlen >= 6 && adr > 0 && adr < 0x80 {
                if !kennt(state, schon + n, adr) && schon + n < MAX_SLAVES {
                    s(state, S_SLAVES + (schon + n) * 8, adr)
                    n = n + 1
                }
                i = i + rlen + 3
            } else {
                i = i + 1
            }
        } else {
            // Die Kennung eines HID-ueber-I2C-Geraets, in beiden
            // Schreibweisen, die in echten Tabellen vorkommen: als
            // Zeichenkette "PNP0C50" und als gepackte EISA-Kennung.
            if kstate.get32(p + i) == 0x500CD041 {
                s(state, S_PNP0C50, g(state, S_PNP0C50) + 1)
            }
            i = i + 1
        }
    }
    return n
}

fn kennt(state: u64, n: u64, adr: u64) -> bool {
    var i: u64 = 0
    while i < n && i < MAX_SLAVES {
        if g(state, S_SLAVES + i * 8) == adr {
            return true
        }
        i = i + 1
    }
    return false
}

// ======================================================================
// STUFE 3: DAS PROTOKOLL.
//
// AB HIER NUR SPEZIFIKATION -- jede dieser Zeilen greift auf Register
// zu, die QEMU nicht hat. Sie stehen so da, wie die Unterlagen zum
// DW_apb_i2c und "HID over I2C" es vorschreiben, und sie sind nicht
// gemessen. Das steht auch in docs/REALHW.md.

fn r32(state: u64, mm: u64, off: u64) -> u64 {
    if mm == SIM_MM || mm == SIM_MM2 {
        return sim_rd(state, mm, off)
    }
    return kstate.get32(mm + off)
}

fn w32(state: u64, mm: u64, off: u64, v: u64) {
    if mm == SIM_MM || mm == SIM_MM2 {
        sim_wr(state, mm, off, v)
        return
    }
    __mmio_write32((mm + off) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

// NUR SPEZIFIKATION. Den Regler auf eine Sklavenadresse einstellen.
// IC_TAR laesst sich nur bei ABGESCHALTETEM Regler aendern -- wer das
// vergisst, redet weiter mit dem vorigen Geraet.
fn dw_setup(state: u64, adr: u64) {
    let mm: u64 = g(state, S_MMIO)
    w32(state, mm, IC_ENABLE, 0)
    var i: u64 = 0
    while i < 1000 && (r32(state, mm, IC_ENABLE_STATUS) & 1) != 0 {
        i = i + 1
    }
    w32(state, mm, IC_CON, CON_MASTER | CON_SPEED_FAST | CON_RESTART_EN
        | CON_SLAVE_DIS)
    w32(state, mm, IC_TAR, adr & 0x7F)
    // Taktzahlen fuer 400 kHz an 100 MHz Eingangstakt. Auf einem echten
    // Brett stehen bessere Werte in ACPI (`SSCN`/`FMCN`); ohne
    // AML-Interpreter sind das die Rechenwerte aus den Unterlagen.
    w32(state, mm, IC_FS_HCNT, 0x3C)
    w32(state, mm, IC_FS_LCNT, 0x82)
    w32(state, mm, IC_RX_TL, 0)
    w32(state, mm, IC_TX_TL, 0)
    w32(state, mm, IC_INTR_MASK, 0)
    w32(state, mm, IC_ENABLE, 1)
    ts(X_CUR_A, adr)
}

// NUR SPEZIFIKATION. `wlen` Oktett hinschreiben, dann `rlen` lesen, mit
// einem Neustart dazwischen -- so verlangt es HID over I2C fuer jeden
// Registerzugriff. Rueckgabe: gelesene Oktette, oder 0 bei Abbruch.
fn dw_xfer(state: u64, wp: u64, wlen: u64, rp: u64, rlen: u64) -> u64 {
    let mm: u64 = g(state, S_MMIO)
    let unused: u64 = r32(state, mm, IC_CLR_INTR)
    var i: u64 = 0
    while i < wlen {
        var cmd: u64 = kstate.get8(wp + i)
        if i == 0 {
            cmd = cmd | CMD_RESTART
        }
        if rlen == 0 && i + 1 == wlen {
            cmd = cmd | CMD_STOP
        }
        if !wait_space(state, mm) {
            return 0
        }
        w32(state, mm, IC_DATA_CMD, cmd)
        i = i + 1
    }
    var got: u64 = 0
    var sent: u64 = 0
    while got < rlen {
        if sent < rlen && wait_space(state, mm) {
            var c: u64 = CMD_READ
            if sent == 0 {
                c = c | CMD_RESTART
            }
            if sent + 1 == rlen {
                c = c | CMD_STOP
            }
            w32(state, mm, IC_DATA_CMD, c)
            sent = sent + 1
        }
        if (r32(state, mm, IC_RAW_INTR) & STAT_TX_ABRT) != 0 {
            let u2: u64 = r32(state, mm, IC_CLR_TX_ABRT)
            s(state, S_ABORTS, g(state, S_ABORTS) + 1)
            let c1: u64 = tg(X_CUR_C)
            if c1 < MAX_CTRL {
                cts(c1, CT_ABRT, ctg(c1, CT_ABRT) + 1)
            }
            return 0
        }
        var w: u64 = 0
        while w < 20000 && r32(state, mm, IC_RXFLR) == 0 {
            w = w + 1
        }
        if r32(state, mm, IC_RXFLR) == 0 {
            note_timeout(state, mm)
            return 0
        }
        kstate.set8(rp + got, (r32(state, mm, IC_DATA_CMD) & 0xFF) as u8)
        got = got + 1
    }
    if (r32(state, mm, IC_RAW_INTR) & STAT_TX_ABRT) != 0 {
        let u3: u64 = r32(state, mm, IC_CLR_TX_ABRT)
        s(state, S_ABORTS, g(state, S_ABORTS) + 1)
        return 0
    }
    return got
}

// A read that never got data: count it globally and on the controller,
// switch the controller off (a hung transfer must not stay armed) and mark
// it HUNG after 3 of them. Other controllers keep running.
fn note_timeout(state: u64, mm: u64) {
    s(state, S_TIMEOUTS, g(state, S_TIMEOUTS) + 1)
    let c: u64 = tg(X_CUR_C)
    if c < MAX_CTRL {
        cts(c, CT_TMO, ctg(c, CT_TMO) + 1)
        if ctg(c, CT_TMO) >= 3 {
            cts(c, CT_STATE, 1)
        }
    }
    w32(state, mm, IC_ENABLE, 0)
    ts(X_CUR_A, 0xFFFF)
}

fn wait_space(state: u64, mm: u64) -> bool {
    var i: u64 = 0
    while i < 20000 {
        if r32(state, mm, IC_TXFLR) < 8 {
            return true
        }
        i = i + 1
    }
    return false
}

// Ein Register anfragen: zwei Oktett, KLEINSTWERTIG ZUERST. Das steht
// so in "HID over I2C" und ist die Stelle, an der eine Umsetzung mit
// vertauschten Oktetten gar keine Antwort bekommt.
fn reg_read(state: u64, reg: u64, dst: u64, n: u64) -> u64 {
    var w: [u8; 2] = [0 as u8; 2]
    w[0] = (reg & 0xFF) as u8
    w[1] = ((reg >> 8) & 0xFF) as u8
    return dw_xfer(state, (&w[0]) as u64, 2, dst, n)
}

// ------------------------------------ die 30 Oktett HID-Beschreibung
//
// DIESER TEIL IST GEMESSEN, denn er rechnet nur auf einem Oktettstrom.
// Er bekommt in `tools/hid/run.sh` einen echten und muss daraus die
// richtigen Register ziehen.
fn hid_desc(state: u64, p: u64, n: u64) -> bool {
    if n < 30 {
        return false
    }
    let len: u64 = le16(p, 0)
    if len < 30 || len > 64 {
        return false
    }
    let ver: u64 = le16(p, 2)
    if ver != 0x0100 {
        return false
    }
    let rdlen: u64 = le16(p, 4)
    if rdlen == 0 || rdlen > hidrep.RAW_MAX {
        return false
    }
    s(state, H_LEN, len)
    s(state, H_VERSION, ver)
    s(state, H_RDLEN, rdlen)
    s(state, H_RDREG, le16(p, 6))
    s(state, H_INREG, le16(p, 8))
    s(state, H_MAXIN, le16(p, 10))
    s(state, H_OUTREG, le16(p, 12))
    s(state, H_MAXOUT, le16(p, 14))
    s(state, H_CMDREG, le16(p, 16))
    s(state, H_DATAREG, le16(p, 18))
    s(state, H_VID, le16(p, 20))
    s(state, H_PID, le16(p, 22))
    s(state, H_VER, le16(p, 24))
    return true
}

fn le16(p: u64, i: u64) -> u64 {
    return kstate.get8(p + i) | (kstate.get8(p + i + 1) << 8)
}

// NUR SPEZIFIKATION. Eine Adresse durchprobieren: HID-Beschreibung
// holen, Berichtsbeschreibung holen, zerlegen.
//
// DER LETZTE PLATZ IN `hidrep` GEHOERT DIESER DATEI, und `usb.fi` haelt
// sich daran (`hid_start`: `d + 1 < hidrep.MAX_DEV`). Die Plaetze 0 bis
// 2 gehoeren den USB-Geraeten. Ohne diese Aufteilung wuerde ein viertes
// USB-Geraet die Beschreibung des Touchpads ueberschreiben.
const HID_SLOT: u64 = 3

fn versuche(state: u64, c: u64, adr: u64, reg: u64) -> bool {
    let j: u64 = ndev()
    if j >= hidrep.I2C_DEV_MAX {
        return false
    }
    let slot: u64 = hidrep.I2C_DEV_FIRST + j
    select_ctrl(state, c)
    cts(c, CT_PROBES, ctg(c, CT_PROBES) + 1)
    dw_setup(state, adr)
    let p: u64 = buf(state)
    if reg_read(state, reg, p, 30) != 30 {
        return false
    }
    if !hid_desc(state, p, 30) {
        return false
    }
    // HID over I2C: power the device on and reset it before it sends
    // reports (spec 7.3; Linux does the same). SPEC ONLY on hardware.
    power_on_reset(state)
    let rdlen: u64 = g(state, H_RDLEN)
    let dst: u64 = hidrep.raw_of(state, slot)
    if reg_read(state, g(state, H_RDREG), dst, rdlen) != rdlen {
        return false
    }
    if hidrep.parse(state, slot, dst, rdlen) != hidrep.E_OK {
        return false
    }
    dvs(j, DV_CTRL, c)
    dvs(j, DV_ADR, adr)
    dvs(j, DV_HREG, reg)
    dvs(j, DV_RDLEN, rdlen)
    dvs(j, DV_MAXIN, g(state, H_MAXIN))
    dvs(j, DV_VID, g(state, H_VID))
    dvs(j, DV_PID, g(state, H_PID))
    dvs(j, DV_INREG, g(state, H_INREG))
    dvs(j, DV_CMDREG, g(state, H_CMDREG))
    dvs(j, DV_KIND, hidrep.kind(state, slot))
    dvs(j, DV_STATE, 1)
    dvs(j, DV_FAILS, 0)
    dvs(j, DV_BACK, POLL_FAST_MS)
    dvs(j, DV_NEXT, 0)
    ts(X_NDEV, j + 1)
    s(state, S_READY, 1)
    s(state, S_HDREG, reg)
    hidrep.say(state, slot)
    return true
}

// NUR SPEZIFIKATION. Einen Eingabebericht abholen. Die ersten zwei
// Oktett sind die LAENGE des Berichts, danach kommt er -- mit
// Berichtsnummer, wenn das Geraet welche benutzt. Laenge 0 heisst "es
// gibt nichts"; das ist kein Fehler, sondern die Antwort auf eine
// Abfrage ohne Ereignis.
// One read of device j (no schedule). The fails/backoff bookkeeping lives
// here; poll_tick decides WHEN.
fn poll_dev(state: u64, j: u64) {
    let c: u64 = dvg(j, DV_CTRL)
    let adr: u64 = dvg(j, DV_ADR)
    if dvg(j, DV_STATE) == 0 || ctg(c, CT_STATE) != 0 {
        return
    }
    let max: u64 = dvg(j, DV_MAXIN)
    if max < 2 || max > 1024 {
        return
    }
    if tg(X_CUR_C) != c || tg(X_CUR_A) != adr {
        select_ctrl(state, c)
        dw_setup(state, adr)
    }
    // a device on this controller cannot hang the others: the transfer
    // below is bounded (wait loops) and note_timeout switches it off
    let p: u64 = buf(state)
    let now: u64 = time.mono_ns(state) / 1000000
    if dw_xfer(state, 0, 0, p, max) < 2 {
        ts(X_CUR_A, 0xFFFF)
        s(state, S_FAILS, g(state, S_FAILS) + 1)
        dvs(j, DV_FAILS, dvg(j, DV_FAILS) + 1)
        var b: u64 = dvg(j, DV_BACK) * 2
        if b > POLL_BACK_MAX {
            b = POLL_BACK_MAX
        }
        dvs(j, DV_BACK, b)
        dvs(j, DV_NEXT, now + b)
        if dvg(j, DV_FAILS) == LOST_FAILS {
            var s_gu: [u8; 25] = "i2chid: input lost, dev \0"
            dvs(j, DV_STATE, 2)
            serial.puts((&s_gu[0]) as u64)
            serial.dec(j)
            serial.nl()
        }
        return
    }
    dvs(j, DV_FAILS, 0)
    dvs(j, DV_STATE, 1)
    dvs(j, DV_BACK, POLL_FAST_MS)
    dvs(j, DV_NEXT, now + POLL_FAST_MS)
    s(state, S_FAILS, 0)
    let n: u64 = le16(p, 0)
    if n < 3 || n > max {
        return
    }
    s(state, S_REPORTS, g(state, S_REPORTS) + 1)
    dvs(j, DV_REPS, dvg(j, DV_REPS) + 1)
    hidin.report(state, hidrep.I2C_DEV_FIRST + j, p + 2, n - 2)
}

// Every device once, ignoring the schedule (test beds).
fn poll(state: u64) {
    var j: u64 = 0
    while j < ndev() {
        poll_dev(state, j)
        j = j + 1
    }
}

// ======================================================================
fn stage(state: u64) {
    var s_aus: [u8; 14] = "i2chid: noi2c\0"
    if !kstate.mode_on(state, kstate.M_I2CHID) {
        return
    }
    if kstate.mode_on(state, kstate.M_NOI2C) {
        serial.puts((&s_aus[0]) as u64)
        serial.nl()
        return
    }
    tables_reset()
    // ORDER IS INTENTIONAL: first the ACPI search (works everywhere), then
    // the controllers (only on a board that has them).
    acpi_scan(state)
    find_ctrls(state)
    say(state)
    if nctrl() == 0 {
        return
    }
    aml_scan(state)
    say_aml(state)
    probe_all(state)
    say_devs(state)
}

// Try every slave address the firmware names; the first one that
// answers with a valid HID description wins.
// Try every slave address the firmware names on every controller that is
// not HUNG; each hit becomes a device (own HID slot). A timeout only
// hurts the controller it happened on.
fn probe_all(state: u64) -> bool {
    if tg(X_NAML) > 0 && probe_aml(state) {
        return true
    }
    var i: u64 = 0
    let n: u64 = g(state, S_NSLAVE)
    let old: bool = kstate.mode_on(state, kstate.M_I2COLD)
    while i < n {
        let adr: u64 = g(state, S_SLAVES + i * 8)
        var c: u64 = 0
        while c < nctrl() {
            if old && (c > 0 || ndev() > 0) {
                return ndev() > 0
            }
            if ctg(c, CT_STATE) == 0 && ndev() < hidrep.I2C_DEV_MAX && !dev_known(c, adr) {
                try_dev(state, c, adr)
            }
            c = c + 1
        }
        i = i + 1
    }
    return ndev() > 0
}

fn dev_known(c: u64, adr: u64) -> bool {
    var j: u64 = 0
    while j < ndev() {
        if dvg(j, DV_CTRL) == c && dvg(j, DV_ADR) == adr {
            return true
        }
        j = j + 1
    }
    return false
}

fn try_dev(state: u64, c: u64, adr: u64) -> bool {
    let to0: u64 = g(state, S_TIMEOUTS)
    if versuche(state, c, adr, HDESC_DEFAULT) {
        return true
    }
    if g(state, S_TIMEOUTS) != to0 {
        return false
    }
    if versuche(state, c, adr, HDESC_OLD) {
        return true
    }
    return false
}

// SPEC ONLY on hardware. SET_POWER(on) then RESET, then one read of the
// 2-byte reset response (the device holds its interrupt until it is read).
// Command = 2-byte command register, then [power/report byte, opcode].
fn power_on_reset(state: u64) {
    var c: [u8; 4] = [0 as u8; 4]
    let p: u64 = buf(state)
    let cmdreg: u64 = g(state, H_CMDREG)
    c[0] = (cmdreg & 0xFF) as u8
    c[1] = ((cmdreg >> 8) & 0xFF) as u8
    c[2] = 0 as u8 // power state ON
    c[3] = 0x08 as u8 // SET_POWER
    let a: u64 = dw_xfer(state, (&c[0]) as u64, 4, 0, 0)
    c[2] = 0 as u8
    c[3] = 0x01 as u8 // RESET
    let b2: u64 = dw_xfer(state, (&c[0]) as u64, 4, 0, 0)
    let ack: u64 = dw_xfer(state, 0, 0, p, 2)
}

// Rate limit for the GUI loop: at most one input read per 8 ms.
const S_LAST: u64 = 0x58
const S_FAILS: u64 = 0x60
const POLL_GIVEUP: u64 = 400

fn poll_tick(state: u64) {
    // W-TPSET2: touchpad momentum scroll + release of the pinch Ctrl run on every GUI pass, also with a USB pad
    hidin.gest_tick(state)
    let n: u64 = ndev()
    if n == 0 {
        return
    }
    let now: u64 = time.mono_ns(state) / 1000000
    var j: u64 = 0
    while j < n {
        if dvg(j, DV_STATE) != 0 && now >= dvg(j, DV_NEXT) {
            poll_dev(state, j)
        }
        j = j + 1
    }
}

fn say(state: u64) {
    var s_a: [u8; 16] = "i2chid: regler=\0"
    var s_b: [u8; 7] = " mmio=\0"
    var s_c: [u8; 11] = " adressen=\0"
    var s_d: [u8; 11] = " tabellen=\0"
    var s_e: [u8; 10] = " pnp0c50=\0"
    var s_f: [u8; 7] = " ding=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(nctrl())
    serial.puts((&s_b[0]) as u64)
    serial.hex(g(state, S_MMIO))
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, S_NSLAVE))
    serial.puts((&s_d[0]) as u64)
    serial.dec(g(state, S_TABLES))
    serial.puts((&s_e[0]) as u64)
    serial.dec(g(state, S_PNP0C50))
    serial.puts((&s_f[0]) as u64)
    serial.dec(ndev())
    serial.nl()
    var i: u64 = 0
    while i < g(state, S_NSLAVE) {
        var s_s: [u8; 15] = "i2chid: adr=\0\0\0"
        serial.puts((&s_s[0]) as u64)
        serial.hex(g(state, S_SLAVES + i * 8))
        serial.nl()
        i = i + 1
    }
    var c: u64 = 0
    while c < nctrl() {
        var s_k: [u8; 14] = "i2chid: ctrl=\0"
        var s_m: [u8; 6] = " bdf=\0"
        var s_i: [u8; 5] = " id=\0"
        serial.puts((&s_k[0]) as u64)
        serial.dec(c)
        serial.puts((&s_m[0]) as u64)
        serial.hex(ctg(c, CT_BDF))
        serial.puts((&s_i[0]) as u64)
        serial.hex(ctg(c, CT_IDS))
        serial.puts((&s_b[0]) as u64)
        serial.hex(ctg(c, CT_MMIO))
        serial.nl()
        c = c + 1
    }
}

// One line per device found.
fn say_devs(state: u64) {
    var j: u64 = 0
    while j < ndev() {
        var s_a: [u8; 13] = "i2chid: dev=\0"
        var s_b: [u8; 7] = " ctrl=\0"
        var s_c: [u8; 6] = " adr=\0"
        var s_d: [u8; 7] = " kind=\0"
        var s_e: [u8; 7] = " slot=\0"
        serial.puts((&s_a[0]) as u64)
        serial.dec(j)
        serial.puts((&s_b[0]) as u64)
        serial.dec(dvg(j, DV_CTRL))
        serial.puts((&s_c[0]) as u64)
        serial.hex(dvg(j, DV_ADR))
        serial.puts((&s_d[0]) as u64)
        serial.dec(dvg(j, DV_KIND))
        serial.puts((&s_e[0]) as u64)
        serial.dec(hidrep.I2C_DEV_FIRST + j)
        serial.nl()
        j = j + 1
    }
}

// ======================================================================
// W-TOUCH4: THE AML PATH. The namespace (held by acpiev when the machine has a lid/battery/button) names every
// HID-over-I2C device: _HID or _CID = PNP0C50, _CRS = I2cSerialBus (slave address + the controller's path),
// the controller's _ADR = PCI device/function, _DSM(3CDFF6F7-..., 1, 1) = the HID description register.
// With candidates from here, probe_all touches ONLY these (controller, address, register) triples -- no byte search
// on any controller. Word i2cnoaml = old behaviour. No namespace / no PNP0C50 device = no candidates = old search.
const T_AML: u64 = 256
const AML_MAX: u64 = 8
const AM_CTRL: u64 = 0
const AM_ADR: u64 = 1
const AM_HREG: u64 = 2
const AM_NODE: u64 = 3
const X_NAML: u64 = 205
const HREG_NONE: u64 = 0xFFFFFFFF
const EISA_PNP0C50: u64 = 0x500CD041

fn am_get(k: u64, f: u64) -> u64 {
    return tg(T_AML + k * 4 + f)
}

fn am_set(k: u64, f: u64, v: u64) {
    ts(T_AML + k * 4 + f, v)
}

fn aml_seg4(a: u64, b: u64, c: u64, d: u64) -> u64 {
    return a | (b << 8) | (c << 16) | (d << 24)
}

// 1 when the object (an integer, a string, or a package of those) is the PNP0C50 id.
fn aml_obj_is_hidi2c(o: u64) -> bool {
    var want: [u8; 8] = "PNP0C50\0"
    let t: u64 = amlobj.otype(o)
    if t == amlobj.OT_INT {
        return amlobj.to_int(o) == EISA_PNP0C50
    }
    if t == amlobj.OT_STR {
        let sp: u64 = amlobj.ov1(o)
        var i: u64 = 0
        while i < 8 {
            if amlns.rd8(sp + i) != (want[i as usize] as u64) {
                return false
            }
            i = i + 1
        }
        return true
    }
    if t == amlobj.OT_PKG {
        let n: u64 = amlobj.ov2(o)
        var k: u64 = 0
        while k < n && k < 8 {
            let e: u64 = amlobj.pkg_at(o, k)
            let et: u64 = amlobj.otype(e)
            if et == amlobj.OT_INT || et == amlobj.OT_STR {
                if aml_obj_is_hidi2c(e) {
                    return true
                }
            }
            k = k + 1
        }
    }
    return false
}

fn aml_dev_is_hidi2c(state: u64, dev: u64) -> bool {
    var w_hid: [u8; 5] = "_HID\0"
    var w_cid: [u8; 5] = "_CID\0"
    var r: [u64; 3] = [0 as u64; 3]
    let h: u64 = amlns.child(state, dev, amlns.seg_of((&w_hid[0]) as u64))
    if h != amlns.NONE {
        if aml.eval_node(state, h, (&r[0]) as u64) {
            if aml_obj_is_hidi2c((&r[0]) as u64) {
                return true
            }
        }
    }
    let c: u64 = amlns.child(state, dev, amlns.seg_of((&w_cid[0]) as u64))
    if c != amlns.NONE {
        if aml.eval_node(state, c, (&r[0]) as u64) {
            if aml_obj_is_hidi2c((&r[0]) as u64) {
                return true
            }
        }
    }
    return false
}

// "\_SB.PCI0.I2C1" (also unpadded segments like "_SB") -> namespace node, or NONE.
fn aml_resolve(state: u64, src: u64, maxlen: u64) -> u64 {
    var cur: u64 = 0
    var i: u64 = 0
    if amlns.rd8(src) == 0x5C {
        i = 1
    }
    while i < maxlen && amlns.rd8(src + i) != 0 {
        var sg: [u8; 4] = "____"
        var k: u64 = 0
        while k < 4 && i < maxlen && amlns.rd8(src + i) != 0 && amlns.rd8(src + i) != 0x2E {
            sg[k as usize] = amlns.rd8(src + i) as u8
            k = k + 1
            i = i + 1
        }
        if k == 0 || (i < maxlen && amlns.rd8(src + i) != 0 && amlns.rd8(src + i) != 0x2E) {
            return amlns.NONE
        }
        let seg: u64 = aml_seg4(sg[0] as u64, sg[1] as u64, sg[2] as u64, sg[3] as u64)
        cur = amlns.child(state, cur, seg)
        if cur == amlns.NONE {
            return amlns.NONE
        }
        if i < maxlen && amlns.rd8(src + i) == 0x2E {
            i = i + 1
        }
    }
    return cur
}

// The controller (index in our table) whose PCI device/function equals the node's _ADR, or 0xFF.
fn aml_ctrl_of(state: u64, node: u64) -> u64 {
    var w_adr: [u8; 5] = "_ADR\0"
    let a: u64 = amlns.child(state, node, amlns.seg_of((&w_adr[0]) as u64))
    if a == amlns.NONE {
        return 0xFF
    }
    var r: [u64; 3] = [0 as u64; 3]
    if !aml.eval_node(state, a, (&r[0]) as u64) || amlobj.otype((&r[0]) as u64) != amlobj.OT_INT {
        return 0xFF
    }
    let v: u64 = amlobj.to_int((&r[0]) as u64)
    let dev: u64 = (v >> 16) & 0xFFFF
    let fnn: u64 = v & 0xFFFF
    var c: u64 = 0
    while c < nctrl() {
        if pci.bdf_dev(ctg(c, CT_BDF)) == dev && pci.bdf_fn(ctg(c, CT_BDF)) == fnn {
            return c
        }
        c = c + 1
    }
    return 0xFF
}

// _DSM(UUID 3CDFF6F7-4267-4555-AD05-B30A3D8938DE, rev 1, function 1, {}) = HID description register, or HREG_NONE.
fn aml_dsm_hreg(state: u64, dev: u64) -> u64 {
    var w_dsm: [u8; 5] = "_DSM\0"
    let n: u64 = amlns.child(state, dev, amlns.seg_of((&w_dsm[0]) as u64))
    if n == amlns.NONE {
        return HREG_NONE
    }
    let u: u64 = amlobj.obj_buf(state, 16)
    if u == 0 {
        return HREG_NONE
    }
    let up: u64 = amlobj.ov1(u)
    var uu: [u8; 16] = [0 as u8; 16]
    uu[0] = 0xF7 as u8
    uu[1] = 0xF6 as u8
    uu[2] = 0xDF as u8
    uu[3] = 0x3C as u8
    uu[4] = 0x67 as u8
    uu[5] = 0x42 as u8
    uu[6] = 0x55 as u8
    uu[7] = 0x45 as u8
    uu[8] = 0xAD as u8
    uu[9] = 0x05 as u8
    uu[10] = 0xB3 as u8
    uu[11] = 0x0A as u8
    uu[12] = 0x3D as u8
    uu[13] = 0x89 as u8
    uu[14] = 0x38 as u8
    uu[15] = 0xDE as u8
    var i: u64 = 0
    while i < 16 {
        amlns.wr8(up + i, uu[i as usize] as u64)
        i = i + 1
    }
    var a: [u64; 12] = [0 as u64; 12]
    amlobj.ocopy((&a[0]) as u64, u)
    amlobj.oint((&a[3]) as u64, 1)
    amlobj.oint((&a[6]) as u64, 1)
    amlobj.opkg((&a[9]) as u64, 0, 0)
    var r: [u64; 3] = [0 as u64; 3]
    if !aml.eval_node_args(state, n, 4, (&a[0]) as u64, (&r[0]) as u64) {
        return HREG_NONE
    }
    if amlobj.otype((&r[0]) as u64) != amlobj.OT_INT {
        return HREG_NONE
    }
    let v: u64 = amlobj.to_int((&r[0]) as u64)
    if v == 0 || v > 0xFFFF {
        return HREG_NONE
    }
    return v
}

fn aml_add_cand(c: u64, adr: u64, hreg: u64, node: u64) {
    let n: u64 = tg(X_NAML)
    var k: u64 = 0
    while k < n {
        if am_get(k, AM_CTRL) == c && am_get(k, AM_ADR) == adr {
            return
        }
        k = k + 1
    }
    if n >= AML_MAX {
        return
    }
    am_set(n, AM_CTRL, c)
    am_set(n, AM_ADR, adr)
    am_set(n, AM_HREG, hreg)
    am_set(n, AM_NODE, node)
    ts(X_NAML, n + 1)
}

// Walk the held namespace. Returns the number of candidates (also in tg(X_NAML)); 0 = use the byte search.
fn aml_scan(state: u64) -> u64 {
    var w_crs: [u8; 5] = "_CRS\0"
    ts(X_NAML, 0)
    ts(X_AML, 0)
    if kstate.mode_on(state, kstate.M_I2CNOAML) || aml.ns_arena(state) == 0 {
        return 0
    }
    let crs_seg: u64 = amlns.seg_of((&w_crs[0]) as u64)
    let nn: u64 = amlns.nodes(state)
    var i: u64 = 1
    while i < nn {
        if amlns.node_kind(state, i) == amlns.NK_DEVICE && aml_dev_is_hidi2c(state, i) {
            let cn: u64 = amlns.child(state, i, crs_seg)
            var r: [u64; 3] = [0 as u64; 3]
            if cn != amlns.NONE && aml.eval_node(state, cn, (&r[0]) as u64)
                && amlobj.otype((&r[0]) as u64) == amlobj.OT_BUF {
                let p: u64 = amlobj.ov1((&r[0]) as u64)
                let len: u64 = amlobj.ov2((&r[0]) as u64)
                var o: u64 = 0
                while o + 3 <= len {
                    let b: u64 = amlns.rd8(p + o)
                    if (b & 0x80) == 0 {
                        if (b >> 3) == 0x0F {
                            o = len
                        } else {
                            o = o + 1 + (b & 7)
                        }
                    } else {
                        let rl: u64 = amlns.rd8(p + o + 1) | (amlns.rd8(p + o + 2) << 8)
                        if b == 0x8E && rl >= 15 && o + 3 + rl <= len && amlns.rd8(p + o + 5) == 1 {
                            let tdl: u64 = amlns.rd8(p + o + 10) | (amlns.rd8(p + o + 11) << 8)
                            let adr: u64 = amlns.rd8(p + o + 16) | (amlns.rd8(p + o + 17) << 8)
                            if tdl >= 6 && adr > 0 && adr < 0x80 && 12 + tdl < 3 + rl {
                                let src: u64 = p + o + 12 + tdl
                                let cnode: u64 = aml_resolve(state, src, 3 + rl - 12 - tdl)
                                if cnode != amlns.NONE {
                                    let c: u64 = aml_ctrl_of(state, cnode)
                                    if c != 0xFF {
                                        aml_add_cand(c, adr, aml_dsm_hreg(state, i), i)
                                    }
                                }
                            }
                        }
                        o = o + 3 + rl
                    }
                }
            }
        }
        i = i + 1
    }
    if tg(X_NAML) > 0 {
        ts(X_AML, 1)
    }
    return tg(X_NAML)
}

// Probe the AML candidates (only these). Returns true when at least one device answered.
fn probe_aml(state: u64) -> bool {
    var k: u64 = 0
    while k < tg(X_NAML) {
        let c: u64 = am_get(k, AM_CTRL)
        let adr: u64 = am_get(k, AM_ADR)
        let hreg: u64 = am_get(k, AM_HREG)
        if ctg(c, CT_STATE) == 0 && ndev() < hidrep.I2C_DEV_MAX && !dev_known(c, adr) {
            var got: bool = false
            if hreg != HREG_NONE {
                got = versuche(state, c, adr, hreg)
            }
            if !got {
                got = try_dev(state, c, adr)
            }
            if got {
                dvs(ndev() - 1, DV_VIA, 1)
            }
        }
        k = k + 1
    }
    return ndev() > 0
}

fn say_aml(state: u64) {
    var s_a: [u8; 15] = "i2chid: aml n=\0"
    var s_b: [u8; 18] = "i2chid: aml cand=\0"
    var s_c: [u8; 6] = " ctrl\0"
    var s_d: [u8; 6] = " adr=\0"
    var s_e: [u8; 7] = " hreg=\0"
    serial.puts((&s_a[0]) as u64)
    serial.dec(tg(X_NAML))
    serial.nl()
    var k: u64 = 0
    while k < tg(X_NAML) {
        serial.puts((&s_b[0]) as u64)
        serial.dec(k)
        serial.puts((&s_c[0]) as u64)
        serial.put(61 as u8)
        serial.dec(am_get(k, AM_CTRL))
        serial.puts((&s_d[0]) as u64)
        serial.hex(am_get(k, AM_ADR))
        serial.puts((&s_e[0]) as u64)
        serial.hex(am_get(k, AM_HREG))
        serial.nl()
        k = k + 1
    }
}


// ======================================================================
// W-TOUCH4: /proc/inputdevs -- what the input stack found, as text.
// Head line (keys for hwinv): i2c_ctrls= i2c_devs= i2c_hung= i2c_aml= i2c_tables= hid_devs=
// then one line per controller and per device, then one line per HID slot with a kind (USB and I2C).
// A photo of `cat /proc/inputdevs` answers "why has the touch screen no events".
static mut r_at: u64 = 0
static mut r_cap: u64 = 0
static mut r_out: u64 = 0

fn r_c(c: u64) {
    if r_at + 1 < r_cap {
        kstate.set8(r_out + r_at, c as u8)
        r_at = r_at + 1
    }
}

fn r_s(p: u64) {
    var i: u64 = 0
    while kstate.get8(p + i) != 0 {
        r_c(kstate.get8(p + i))
        i = i + 1
    }
}

fn r_dec(v: u64) {
    var tmp: [u8; 20] = [0 as u8; 20]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        tmp[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        tmp[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        r_c(tmp[n as usize] as u64)
    }
}

fn r_hex(v: u64, digits: u64) {
    var i: u64 = digits
    r_c(48)
    r_c(120)
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * 4)) & 15
        if d < 10 {
            r_c(48 + d)
        } else {
            r_c(87 + d)
        }
    }
}

fn r_key(k: u64) {
    r_c(32)
    r_s(k)
}

fn render(state: u64, out: u64, cap: u64) -> u64 {
    var k_c: [u8; 11] = "i2c_ctrls=\0"
    var k_d: [u8; 10] = "i2c_devs=\0"
    var k_h: [u8; 10] = "i2c_hung=\0"
    var k_a: [u8; 9] = "i2c_aml=\0"
    var k_t: [u8; 12] = "i2c_tables=\0"
    var k_g: [u8; 10] = "hid_devs=\0"
    var k_ct: [u8; 5] = "ctrl\0"
    var k_bdf: [u8; 5] = "bdf=\0"
    var k_id: [u8; 4] = "id=\0"
    var k_mm: [u8; 6] = "mmio=\0"
    var k_st: [u8; 7] = "state=\0"
    var k_to: [u8; 9] = "timeout=\0"
    var k_ab: [u8; 7] = "abort=\0"
    var k_pr: [u8; 8] = "probes=\0"
    var k_dv: [u8; 4] = "dev\0"
    var k_cr: [u8; 6] = "ctrl=\0"
    var k_ad: [u8; 5] = "adr=\0"
    var k_kd: [u8; 6] = "kind=\0"
    var k_sl: [u8; 6] = "slot=\0"
    var k_vi: [u8; 5] = "vid=\0"
    var k_pi: [u8; 5] = "pid=\0"
    var k_vv: [u8; 5] = "via=\0"
    var k_fa: [u8; 7] = "fails=\0"
    var k_rp: [u8; 6] = "reps=\0"
    var k_hs: [u8; 4] = "hid\0"
    var v_ok: [u8; 3] = "ok\0"
    var v_hung: [u8; 5] = "hung\0"
    var v_lost: [u8; 5] = "lost\0"
    var v_none: [u8; 5] = "none\0"
    var v_scan: [u8; 7] = "search\0"
    var v_aml: [u8; 4] = "aml\0"
    r_out = out
    r_cap = cap
    r_at = 0
    var hung: u64 = 0
    var c: u64 = 0
    while c < nctrl() {
        if ctg(c, CT_STATE) != 0 {
            hung = hung + 1
        }
        c = c + 1
    }
    var hid_n: u64 = 0
    var sl: u64 = 0
    while sl < hidrep.MAX_DEV {
        if hidrep.kind(state, sl) != 0 {
            hid_n = hid_n + 1
        }
        sl = sl + 1
    }
    r_s((&k_c[0]) as u64)
    r_dec(nctrl())
    r_key((&k_d[0]) as u64)
    r_dec(ndev())
    r_key((&k_h[0]) as u64)
    r_dec(hung)
    r_key((&k_a[0]) as u64)
    r_dec(tg(X_AML))
    r_key((&k_t[0]) as u64)
    r_dec(g(state, S_TABLES))
    r_key((&k_g[0]) as u64)
    r_dec(hid_n)
    r_c(10)
    c = 0
    while c < nctrl() {
        r_s((&k_ct[0]) as u64)
        r_dec(c)
        r_key((&k_bdf[0]) as u64)
        r_hex(ctg(c, CT_BDF), 6)
        r_key((&k_id[0]) as u64)
        r_hex(ctg(c, CT_IDS), 8)
        r_key((&k_mm[0]) as u64)
        r_hex(ctg(c, CT_MMIO), 8)
        r_key((&k_st[0]) as u64)
        if ctg(c, CT_STATE) != 0 {
            r_s((&v_hung[0]) as u64)
        } else {
            r_s((&v_ok[0]) as u64)
        }
        r_key((&k_to[0]) as u64)
        r_dec(ctg(c, CT_TMO))
        r_key((&k_ab[0]) as u64)
        r_dec(ctg(c, CT_ABRT))
        r_key((&k_pr[0]) as u64)
        r_dec(ctg(c, CT_PROBES))
        r_c(10)
        c = c + 1
    }
    var j: u64 = 0
    while j < ndev() {
        r_s((&k_dv[0]) as u64)
        r_dec(j)
        r_key((&k_cr[0]) as u64)
        r_dec(dvg(j, DV_CTRL))
        r_key((&k_ad[0]) as u64)
        r_hex(dvg(j, DV_ADR), 2)
        r_key((&k_kd[0]) as u64)
        r_dec(dvg(j, DV_KIND))
        r_key((&k_sl[0]) as u64)
        r_dec(hidrep.I2C_DEV_FIRST + j)
        r_key((&k_vi[0]) as u64)
        r_hex(dvg(j, DV_VID), 4)
        r_key((&k_pi[0]) as u64)
        r_hex(dvg(j, DV_PID), 4)
        r_key((&k_st[0]) as u64)
        let ds: u64 = dvg(j, DV_STATE)
        if ds == 1 {
            r_s((&v_ok[0]) as u64)
        } else if ds == 2 {
            r_s((&v_lost[0]) as u64)
        } else {
            r_s((&v_none[0]) as u64)
        }
        r_key((&k_vv[0]) as u64)
        if dvg(j, DV_VIA) == 1 {
            r_s((&v_aml[0]) as u64)
        } else {
            r_s((&v_scan[0]) as u64)
        }
        r_key((&k_fa[0]) as u64)
        r_dec(dvg(j, DV_FAILS))
        r_key((&k_rp[0]) as u64)
        r_dec(dvg(j, DV_REPS))
        r_c(10)
        j = j + 1
    }
    sl = 0
    while sl < hidrep.MAX_DEV {
        let kd: u64 = hidrep.kind(state, sl)
        if kd != 0 {
            r_s((&k_hs[0]) as u64)
            r_dec(sl)
            r_key((&k_kd[0]) as u64)
            r_dec(kd)
            r_c(10)
        }
        sl = sl + 1
    }
    return r_at
}


// DER ERSATZWEG AN EINER TABELLE, VON DER MAN WEISS, WAS DRINSTEHT.
//
// Ohne ein Brett mit LPSS-I2C ist das die einzige Art, den Sucher zu
// messen: eine Tabelle bauen (tools/hid/descs.py, nach der
// Ressourcenbeschreibung der ACPI-Spezifikation), sie durchsuchen und
// nachsehen, ob GENAU die zwei Adressen herauskommen, die drinstehen --
// und nicht die drei Koeder, die wie eine I2C-Verbindung aussehen und
// keine sind, und nicht die Wiederholung der ersten Vorlage.
fn scan_test(state: u64) {
    var s_a: [u8; 17] = "i2ctest: laenge=\0"
    var s_b: [u8; 10] = " treffer=\0"
    var s_c: [u8; 10] = " pnp0c50=\0"
    var s_d: [u8; 8] = " prueb=\0"
    // Der Zustand muss leer sein, sonst misst die Zaehlung den vorigen
    // Lauf mit.
    var i: u64 = 0
    while i < MAX_SLAVES {
        s(state, S_SLAVES + i * 8, 0)
        i = i + 1
    }
    s(state, S_NSLAVE, 0)
    s(state, S_PNP0C50, 0)
    let p: u64 = buf(state)
    let n: u64 = hidtest.aload(p)
    let treffer: u64 = scan_block(state, p + 36, n - 36, 0)
    s(state, S_NSLAVE, treffer)
    serial.puts((&s_a[0]) as u64)
    serial.dec(n)
    serial.puts((&s_b[0]) as u64)
    serial.dec(treffer)
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, S_PNP0C50))
    serial.puts((&s_d[0]) as u64)
    serial.dec(selftest(state))
    serial.nl()
    var k: u64 = 0
    while k < treffer {
        var s_s: [u8; 17] = "i2ctest: adr=\0\0\0\0"
        serial.puts((&s_s[0]) as u64)
        serial.hex(g(state, S_SLAVES + k * 8))
        serial.nl()
        k = k + 1
    }
}

// Was sich OHNE einen Regler pruefen laesst: der Ressourcensucher auf
// einem gebauten Oktettblock und der Zerleger der HID-Beschreibung.
// `tools/hid/run.sh` faehrt beides mit Daten, die `tools/hid/descs.py`
// nach der Spezifikation baut, und rechnet nach.
const SELFTEST_MAX: u64 = 6

fn selftest(state: u64) -> u64 {
    var n: u64 = 0
    // Eine HID-ueber-I2C-Beschreibung, wie sie ein Geraet liefert.
    var d: [u8; 30] = [0 as u8; 30]
    d[0] = 30 as u8
    d[2] = 0x00 as u8
    d[3] = 0x01 as u8 // bcdVersion 0x0100
    d[4] = 0xB1 as u8
    d[5] = 0x01 as u8 // Berichtsbeschreibung 433 Oktett
    d[6] = 0x02 as u8 // ihr Register 0x0002
    d[8] = 0x03 as u8 // Eingaberegister 0x0003
    d[10] = 0x1D as u8 // hoechstens 29 Oktett
    d[12] = 0x04 as u8
    d[14] = 0x0C as u8
    d[16] = 0x05 as u8 // Befehlsregister
    d[18] = 0x06 as u8 // Datenregister
    d[20] = 0xF3 as u8
    d[21] = 0x06 as u8 // Hersteller 0x06F3
    d[22] = 0x01 as u8
    d[23] = 0x25 as u8 // Erzeugnis 0x2501
    let p: u64 = (&d[0]) as u64
    if hid_desc(state, p, 30) {
        n = n + 1
    }
    if g(state, H_RDLEN) == 433 && g(state, H_RDREG) == 2 {
        n = n + 1
    }
    if g(state, H_INREG) == 3 && g(state, H_MAXIN) == 29 {
        n = n + 1
    }
    if g(state, H_CMDREG) == 5 && g(state, H_DATAREG) == 6 {
        n = n + 1
    }
    if g(state, H_VID) == 0x06F3 && g(state, H_PID) == 0x2501 {
        n = n + 1
    }
    // Eine abgeschnittene und eine mit falscher Fassung MUESSEN
    // durchfallen -- ohne diese Gegenprobe misst die obige Zeile nur,
    // dass die Funktion `true` zurueckgibt.
    d[3] = 0x02 as u8
    if !hid_desc(state, p, 30) && !hid_desc(state, p, 12) {
        n = n + 1
    }
    return n
}

// ======================================================================
// SIMULATED DESIGNWARE I2C CONTROLLERS WITH HID DEVICES (words i2csim, touchsim).
//
// QEMU has no DW_apb_i2c, so the register-level path (dw_setup, dw_xfer,
// reg_read, versuche, poll) could never run. These models sit behind
// r32/w32 when the "controller address" is SIM_MM or SIM_MM2 (1 and 2 --
// never a real BAR). A controller behaves like the part the driver relies
// on: TAR only changes while it is disabled, a command to an address
// without a device aborts (TX_ABRT), reads pop an RX FIFO, a write phase
// followed by a RESTART read selects the register. A device is a HID
// device: HID description at its description register (1 or 0x20), report
// description at 2, input reports at 3 or by a plain read; reports only
// flow after SET_POWER(on). A device flagged HANG ACKs but never answers
// a read (the driver must time out and go on).
//
//   i2csim:   one controller, a decoy at 0x15 and the precision touchpad
//   touchsim: A = touchpad 0x2C; B = touch screen 0x10 (description at
//             0x20), pen 0x11, hanging device 0x40
//
// All state lives in the static array `sm` (2 controller pages of 0x1000,
// then 5 device pages of 0x800).
const SIM_MM: u64 = 1
const SIM_MM2: u64 = 2
const SIM_ADDR: u64 = 0x2C
const SIM_NDEV: u64 = 5
static mut sm: [u64; 2304] = [0 as u64; 2304]

const CS_EN: u64 = 0x00
const CS_TAR: u64 = 0x08
const CS_ABRT: u64 = 0x10
const CS_RXN: u64 = 0x18
const CS_WN: u64 = 0x20
const CS_SRC: u64 = 0x28
const CS_POS: u64 = 0x30
const CS_LEN: u64 = 0x38
const CS_RXH: u64 = 0x40
const CS_TARBAD: u64 = 0x48
const CS_NREAD: u64 = 0x50
const CS_RX: u64 = 0x100 // 64-byte FIFO ring
const CS_W: u64 = 0x140 // write phase bytes (8)
const CS_CUR: u64 = 0x180 // current input response (<= 64)
const CS_SCRATCH: u64 = 0xC00

const DS_BASE: u64 = 0x2000
const DS_PAGE: u64 = 0x800
const DS_ON: u64 = 0x00
const DS_ADDR: u64 = 0x08
const DS_CTRL: u64 = 0x10
const DS_KIND: u64 = 0x18 // 0 pad, 1 touch screen, 2 pen
const DS_QH: u64 = 0x20
const DS_QT: u64 = 0x28
const DS_POWER: u64 = 0x30
const DS_NPOW: u64 = 0x38
const DS_NRST: u64 = 0x40
const DS_HANG: u64 = 0x48
const DS_HDREG: u64 = 0x50
const DS_RDLEN: u64 = 0x58
const DS_HDESC: u64 = 0x80 // 30 bytes
const DS_Q: u64 = 0x100 // 8 slots x 64: [n][payload...]
const DS_RDESC: u64 = 0x300 // up to 0x500 bytes

fn sm_base() -> u64 {
    return (&sm[0]) as u64
}

fn cb(mm: u64) -> u64 {
    return sm_base() + (mm - 1) * 0x1000
}

fn db(i: u64) -> u64 {
    return sm_base() + DS_BASE + i * DS_PAGE
}

fn scg(mm: u64, off: u64) -> u64 {
    return kstate.get(cb(mm), off)
}

fn scs(mm: u64, off: u64, v: u64) {
    kstate.set(cb(mm), off, v)
}

fn sdg(i: u64, off: u64) -> u64 {
    return kstate.get(db(i), off)
}

fn sds(i: u64, off: u64, v: u64) {
    kstate.set(db(i), off, v)
}

fn em(dst: u64, at: u64, b: u64) -> u64 {
    kstate.set8(dst + at, b as u8)
    return at + 1
}

fn sim_desc_touch(dst: u64) -> u64 {
