fn sim_clear() {
    var i: u64 = 0
    while i < 2304 {
        kstate.set(sm_base(), i * 8, 0)
        i = i + 1
    }
    scs(SIM_MM, CS_TAR, 0xFFFF)
    scs(SIM_MM2, CS_TAR, 0xFFFF)
}

// Device i on controller mm at address adr. kind 0 = precision touchpad,
// 1 = touch screen, 2 = pen. hdreg = register of the HID description.
fn sim_add_dev(i: u64, mm: u64, adr: u64, kind: u64, hdreg: u64, vid: u64, pid: u64, hang: u64) {
    sds(i, DS_ON, 1)
    sds(i, DS_ADDR, adr)
    sds(i, DS_CTRL, mm)
    sds(i, DS_KIND, kind)
    sds(i, DS_HDREG, hdreg)
    sds(i, DS_HANG, hang)
    let rd: u64 = db(i) + DS_RDESC
    var rl: u64 = 0
    if kind == 0 {
        rl = hidtest.load(3, rd)
    } else if kind == 1 {
        rl = sim_desc_touch(rd)
    } else {
        rl = sim_desc_pen(rd)
    }
    sds(i, DS_RDLEN, rl)
    let hd: u64 = db(i) + DS_HDESC
    kstate.set8(hd + 0, 30 as u8)
    kstate.set8(hd + 3, 0x01 as u8) // bcdVersion 0x0100
    kstate.set8(hd + 4, (rl & 0xFF) as u8)
    kstate.set8(hd + 5, ((rl >> 8) & 0xFF) as u8)
    kstate.set8(hd + 6, 0x02 as u8) // report description register 2
    kstate.set8(hd + 8, 0x03 as u8) // input register 3
    kstate.set8(hd + 10, 31 as u8) // max input length (2 length bytes + 29)
    kstate.set8(hd + 12, 0x04 as u8)
    kstate.set8(hd + 14, 12 as u8)
    kstate.set8(hd + 16, 0x05 as u8) // command register
    kstate.set8(hd + 18, 0x06 as u8) // data register
    kstate.set8(hd + 20, (vid & 0xFF) as u8)
    kstate.set8(hd + 21, ((vid >> 8) & 0xFF) as u8)
    kstate.set8(hd + 22, (pid & 0xFF) as u8)
    kstate.set8(hd + 23, ((pid >> 8) & 0xFF) as u8)
}

fn sim_find(mm: u64, tar: u64) -> u64 {
    var i: u64 = 0
    while i < SIM_NDEV {
        if sdg(i, DS_ON) == 1 && sdg(i, DS_CTRL) == mm && sdg(i, DS_ADDR) == tar {
            return i + 1
        }
        i = i + 1
    }
    return 0
}

// Put an input report (payload without the 2 length bytes) in the queue
// of device i.
fn sim_push(i: u64, p: u64, n: u64) -> bool {
    let h: u64 = sdg(i, DS_QH)
    let t: u64 = sdg(i, DS_QT)
    if t - h >= 8 || n > 62 {
        return false
    }
    let slot: u64 = db(i) + DS_Q + (t % 8) * 64
    kstate.set8(slot, n as u8)
    var k: u64 = 0
    while k < n {
        kstate.set8(slot + 1 + k, kstate.get8(p + k) as u8)
        k = k + 1
    }
    sds(i, DS_QT, t + 1)
    return true
}

// The response of an input read: [len lo, len hi, payload...]. Empty
// queue or device asleep = length 0 (two zero bytes).
fn sim_load_input(mm: u64, d: u64) -> bool {
    let cur: u64 = cb(mm) + CS_CUR
    var k: u64 = 0
    while k < 64 {
        kstate.set8(cur + k, 0 as u8)
        k = k + 1
    }
    scs(mm, CS_SRC, 3)
    scs(mm, CS_LEN, 2)
    let h: u64 = sdg(d, DS_QH)
    if sdg(d, DS_POWER) != 1 || h == sdg(d, DS_QT) {
        return true
    }
    let slot: u64 = db(d) + DS_Q + (h % 8) * 64
    let n: u64 = kstate.get8(slot)
    kstate.set8(cur, ((n + 2) & 0xFF) as u8)
    kstate.set8(cur + 1, (((n + 2) >> 8) & 0xFF) as u8)
    k = 0
    while k < n {
        kstate.set8(cur + 2 + k, kstate.get8(slot + 1 + k) as u8)
        k = k + 1
    }
    scs(mm, CS_LEN, n + 2)
    sds(d, DS_QH, h + 1)
    return true
}

// A read phase starts: which source answers, from the write phase.
fn sim_select(mm: u64, d: u64) -> bool {
    let w: u64 = cb(mm) + CS_W
    let wn: u64 = scg(mm, CS_WN)
    if wn == 0 {
        return sim_load_input(mm, d)
    }
    if wn != 2 {
        return false
    }
    let reg: u64 = kstate.get8(w) | (kstate.get8(w + 1) << 8)
    if reg == sdg(d, DS_HDREG) {
        scs(mm, CS_SRC, 1)
        scs(mm, CS_LEN, 30)
        return true
    }
    if reg == 2 {
        scs(mm, CS_SRC, 2)
        scs(mm, CS_LEN, sdg(d, DS_RDLEN))
        return true
    }
    if reg == 3 {
        return sim_load_input(mm, d)
    }
    return false
}

fn sim_byte(mm: u64, d: u64, pos: u64) -> u64 {
    if pos >= scg(mm, CS_LEN) {
        return 0
    }
    let src: u64 = scg(mm, CS_SRC)
    if src == 1 {
        return kstate.get8(db(d) + DS_HDESC + pos)
    }
    if src == 2 {
        return kstate.get8(db(d) + DS_RDESC + pos)
    }
    if src == 3 {
        return kstate.get8(cb(mm) + CS_CUR + pos)
    }
    return 0
}

// A finished write phase = a command: register 5, then [byte0, opcode].
fn sim_command(mm: u64, d: u64) {
    let w: u64 = cb(mm) + CS_W
    if scg(mm, CS_WN) < 4 {
        return
    }
    let reg: u64 = kstate.get8(w) | (kstate.get8(w + 1) << 8)
    if reg != 5 {
        return
    }
    let b0: u64 = kstate.get8(w + 2)
    let op: u64 = kstate.get8(w + 3) & 0x0F
    if op == 8 {
        sds(d, DS_NPOW, sdg(d, DS_NPOW) + 1)
        if (b0 & 3) == 0 {
            sds(d, DS_POWER, 1)
        }
        if (b0 & 3) != 0 {
            sds(d, DS_POWER, 0)
        }
    }
    if op == 1 {
        sds(d, DS_NRST, sdg(d, DS_NRST) + 1)
        sds(d, DS_QH, 0)
        sds(d, DS_QT, 0)
    }
}

fn sim_rd(state: u64, mm: u64, off: u64) -> u64 {
    if off == IC_COMP_TYPE {
        return DW_MAGIC
    }
    if off == IC_ENABLE_STATUS {
        return scg(mm, CS_EN) & 1
    }
    if off == IC_RXFLR {
        return scg(mm, CS_RXN)
    }
    if off == IC_RAW_INTR {
        if scg(mm, CS_ABRT) != 0 {
            return STAT_TX_ABRT
        }
        return 0
    }
    if off == IC_CLR_TX_ABRT || off == IC_CLR_INTR {
        scs(mm, CS_ABRT, 0)
        return 0
    }
    if off == IC_DATA_CMD {
        let n: u64 = scg(mm, CS_RXN)
        if n == 0 {
            return 0
        }
        let h: u64 = scg(mm, CS_RXH)
        let v: u64 = kstate.get8(cb(mm) + CS_RX + h)
        scs(mm, CS_RXH, (h + 1) % 64)
        scs(mm, CS_RXN, n - 1)
        return v
    }
    return 0
}

fn sim_rx_push(mm: u64, v: u64) {
    let n: u64 = scg(mm, CS_RXN)
    if n >= 64 {
        return
    }
    let t: u64 = (scg(mm, CS_RXH) + n) % 64
    kstate.set8(cb(mm) + CS_RX + t, v as u8)
    scs(mm, CS_RXN, n + 1)
}

fn sim_wr(state: u64, mm: u64, off: u64, v: u64) {
    if off == IC_ENABLE {
        scs(mm, CS_EN, v & 1)
        if (v & 1) == 0 {
            scs(mm, CS_WN, 0)
            scs(mm, CS_SRC, 0)
            scs(mm, CS_RXN, 0)
            scs(mm, CS_RXH, 0)
        }
        return
    }
    if off == IC_TAR {
        // The real part ignores a TAR write while enabled -- the driver
        // must disable first. Count the violations.
        if scg(mm, CS_EN) == 1 {
            scs(mm, CS_TARBAD, scg(mm, CS_TARBAD) + 1)
            return
        }
        scs(mm, CS_TAR, v & 0x7F)
        return
    }
    if off != IC_DATA_CMD || scg(mm, CS_EN) == 0 {
        return
    }
    let d1: u64 = sim_find(mm, scg(mm, CS_TAR))
    if d1 == 0 {
        // NACK on the address phase: abort, TX FIFO flushed.
        scs(mm, CS_ABRT, 1)
        return
    }
    let d: u64 = d1 - 1
    if (v & CMD_READ) != 0 {
        if sdg(d, DS_HANG) != 0 {
            return // ACKed, but the device never answers
        }
        if (v & CMD_RESTART) != 0 || scg(mm, CS_SRC) == 0 {
            if !sim_select(mm, d) {
                scs(mm, CS_ABRT, 1)
                return
            }
            scs(mm, CS_POS, 0)
        }
        let pos: u64 = scg(mm, CS_POS)
        sim_rx_push(mm, sim_byte(mm, d, pos))
        scs(mm, CS_POS, pos + 1)
        scs(mm, CS_NREAD, scg(mm, CS_NREAD) + 1)
        if (v & CMD_STOP) != 0 {
            scs(mm, CS_SRC, 0)
            scs(mm, CS_WN, 0)
        }
        return
    }
    if (v & CMD_RESTART) != 0 {
        scs(mm, CS_WN, 0)
    }
    let wn: u64 = scg(mm, CS_WN)
    if wn < 8 {
        kstate.set8(cb(mm) + CS_W + wn, (v & 0xFF) as u8)
    }
    scs(mm, CS_WN, wn + 1)
    scs(mm, CS_SRC, 0)
    if (v & CMD_STOP) != 0 {
        sim_command(mm, d)
        scs(mm, CS_WN, 0)
    }
}

// The old test run (word i2csim): controller at SIM_MM with two slaves
// from "firmware" (0x15 is a decoy without a device), probe, then play the
// precision touchpad reports of hidtest through the I2C path.
fn simrun(state: u64) {
    var s_a: [u8; 15] = "i2csim: ready=\0"
    var s_b: [u8; 9] = " aborts=\0"
    var s_c: [u8; 10] = " poweron=\0"
    var s_d: [u8; 9] = " resets=\0"
    var s_e: [u8; 9] = " tarbad=\0"
    var s_f: [u8; 6] = " vid=\0"
    var s_g: [u8; 19] = "i2csim: report nr=\0"
    var s_h: [u8; 17] = "i2csim: reports=\0"
    var s_i: [u8; 11] = " timeouts=\0"
    var s_j: [u8; 8] = " reads=\0"
    hidin.stage(state)
    sim_clear()
    sim_add_dev(0, SIM_MM, SIM_ADDR, 0, 1, 0x04F3, 0x3003, 0)
    tables_reset()
    add_ctrl(state, 0, 0, SIM_MM)
    s(state, S_NSLAVE, 2)
    s(state, S_SLAVES, 0x15)
    s(state, S_SLAVES + 8, 0x2C)
    let ok: bool = probe_all(state)
    serial.puts((&s_a[0]) as u64)
    serial.dec(g(state, S_READY))
    serial.puts((&s_b[0]) as u64)
    serial.dec(g(state, S_ABORTS))
    serial.puts((&s_c[0]) as u64)
    serial.dec(sdg(0, DS_NPOW))
    serial.puts((&s_d[0]) as u64)
    serial.dec(sdg(0, DS_NRST))
    serial.puts((&s_e[0]) as u64)
    serial.dec(scg(SIM_MM, CS_TARBAD))
    serial.puts((&s_f[0]) as u64)
    serial.hex(g(state, H_VID))
    serial.nl()
    if !ok {
        return
    }
    let scratch: u64 = cb(SIM_MM) + CS_SCRATCH
    hidin.set_trace(state, true)
    var i: u64 = 0
    let n: u64 = hidtest.gbase()
    while i < n {
        if hidtest.bdesc(i) == 3 {
            let bl: u64 = hidtest.bload(i, scratch)
            sim_push(0, scratch, bl)
            poll(state)
            serial.puts((&s_g[0]) as u64)
            serial.dec(i)
            serial.nl()
        }
        i = i + 1
    }
    // An empty queue must read as "nothing" and not as an event.
    poll(state)
    hidin.set_trace(state, false)
    serial.puts((&s_h[0]) as u64)
    serial.dec(g(state, S_REPORTS))
    serial.puts((&s_i[0]) as u64)
    serial.dec(g(state, S_TIMEOUTS))
    serial.puts((&s_j[0]) as u64)
    serial.dec(scg(SIM_MM, CS_NREAD))
    serial.nl()
    hidin.say(state)
}

// ---------------------------------------------------------------------
// touchsim: report builders and one step of the virtual clock.
fn find_dev(c: u64, adr: u64) -> u64 {
    var j: u64 = 0
    while j < ndev() {
        if dvg(j, DV_CTRL) == c && dvg(j, DV_ADR) == adr {
            return j
        }
        j = j + 1
    }
    return 0xFF
}

fn sim_step(state: u64, ms: u64) {
    hidin.set_vclk(state, ms)
    poll(state)
}

// Touch screen report (rid 1): two fingers (tip, id, x, y) and the count.
fn ts_report(state: u64, d: u64, n: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    let p: u64 = cb(SIM_MM2) + CS_SCRATCH
    kstate.set8(p, 1 as u8)
    var f: u64 = 0
    while f < 2 {
        var tip: u64 = 0
        var x: u64 = 0
        var y: u64 = 0
        if f < n {
            tip = 1
            if f == 0 {
                x = x0
                y = y0
            } else {
                x = x1
                y = y1
            }
        }
        let o: u64 = p + 1 + f * 6
        kstate.set8(o, tip as u8)
        kstate.set8(o + 1, f as u8)
        kstate.set8(o + 2, (x & 0xFF) as u8)
        kstate.set8(o + 3, ((x >> 8) & 0xFF) as u8)
        kstate.set8(o + 4, (y & 0xFF) as u8)
        kstate.set8(o + 5, ((y >> 8) & 0xFF) as u8)
        f = f + 1
    }
    kstate.set8(p + 13, n as u8)
    sim_push(d, p, 14)
}

// Pen report (rid 2): bit 0 tip, bit 1 barrel, bit 2 in range; x, y.
fn pen_report(state: u64, d: u64, bits: u64, x: u64, y: u64) {
    let p: u64 = cb(SIM_MM2) + CS_SCRATCH + 0x100
    kstate.set8(p, 2 as u8)
    kstate.set8(p + 1, bits as u8)
    kstate.set8(p + 2, (x & 0xFF) as u8)
    kstate.set8(p + 3, ((x >> 8) & 0xFF) as u8)
    kstate.set8(p + 4, (y & 0xFF) as u8)
    kstate.set8(p + 5, ((y >> 8) & 0xFF) as u8)
    sim_push(d, p, 6)
}

// The touch run (word touchsim): controller A (touchpad + decoy), controller
// B (touch screen with the description at 0x20, pen, a device that hangs).
fn simrun2(state: u64) {
    var s_a: [u8; 17] = "touchsim: ctrls=\0"
    var s_b: [u8; 7] = " devs=\0"
    var s_c: [u8; 11] = " timeouts=\0"
    var s_d: [u8; 9] = " aborts=\0"
    var s_e: [u8; 10] = " b_state=\0"
    var s_f: [u8; 8] = " b_tmo=\0"
    var s_g: [u8; 18] = "touchsim: reports\0"
    var s_h: [u8; 8] = " total=\0"
    var s_i: [u8; 15] = "touchsim: end \0"
    hidin.stage(state)
    sim_clear()
    sim_add_dev(0, SIM_MM, 0x2C, 0, 1, 0x04F3, 0x3003, 0)
    sim_add_dev(1, SIM_MM2, 0x10, 1, 0x20, 0x04F3, 0x2A01, 0)
    sim_add_dev(2, SIM_MM2, 0x11, 2, 1, 0x056A, 0x5002, 0)
    sim_add_dev(3, SIM_MM2, 0x40, 0, 1, 0x1234, 0x0001, 1)
    tables_reset()
    add_ctrl(state, 0x0A00, 0x80869d60, SIM_MM)
    add_ctrl(state, 0x0A08, 0x80869d61, SIM_MM2)
    s(state, S_NSLAVE, 5)
    s(state, S_SLAVES, 0x15)
    s(state, S_SLAVES + 8, 0x2C)
    s(state, S_SLAVES + 16, 0x10)
    s(state, S_SLAVES + 24, 0x11)
    s(state, S_SLAVES + 32, 0x40)
    // test path: hold the namespace here (the real boot path gets it from acpiev.stage)
    aml.ns_hold(state)
    aml_scan(state)
    say_aml(state)
    probe_all(state)
    serial.puts((&s_a[0]) as u64)
    serial.dec(nctrl())
    serial.puts((&s_b[0]) as u64)
    serial.dec(ndev())
    serial.puts((&s_c[0]) as u64)
    serial.dec(g(state, S_TIMEOUTS))
    serial.puts((&s_d[0]) as u64)
    serial.dec(g(state, S_ABORTS))
    serial.puts((&s_e[0]) as u64)
    serial.dec(ctg(1, CT_STATE))
    serial.puts((&s_f[0]) as u64)
    serial.dec(ctg(1, CT_TMO))
    serial.nl()
    say_devs(state)
    let dscr: u64 = 1
    let dpen: u64 = 2
    // the sim device indexes 1 and 2 (touch screen, pen) as the driver sees them
    let jt: u64 = find_dev(1, 0x10)
    let jp: u64 = find_dev(1, 0x11)
    hidin.set_trace(state, true)
    // A: tap at the middle of the panel
    ts_report(state, dscr, 1, 1808, 1092, 0, 0)
    sim_step(state, 1000)
    ts_report(state, dscr, 0, 0, 0, 0, 0)
    sim_step(state, 1100)
    // B: drag from the left to the right
    ts_report(state, dscr, 1, 400, 400, 0, 0)
    sim_step(state, 2000)
    ts_report(state, dscr, 1, 1200, 400, 0, 0)
    sim_step(state, 2020)
    ts_report(state, dscr, 1, 1400, 420, 0, 0)
    sim_step(state, 2040)
    ts_report(state, dscr, 0, 0, 0, 0, 0)
    sim_step(state, 2060)
    // C: two-finger scroll, 600 units down (about 211 px = 5 notches)
    ts_report(state, dscr, 2, 1000, 800, 1200, 800)
    sim_step(state, 3000)
    ts_report(state, dscr, 2, 1000, 1000, 1200, 1000)
    sim_step(state, 3020)
    ts_report(state, dscr, 2, 1000, 1200, 1200, 1200)
    sim_step(state, 3040)
    ts_report(state, dscr, 2, 1000, 1400, 1200, 1400)
    sim_step(state, 3060)
    ts_report(state, dscr, 0, 0, 0, 0, 0)
    sim_step(state, 3080)
    // D: long press (700 ms) = right click
    ts_report(state, dscr, 1, 900, 900, 0, 0)
    sim_step(state, 5000)
    ts_report(state, dscr, 0, 0, 0, 0, 0)
    sim_step(state, 5700)
    // E: pen: hover, tip, tip + barrel, out of range
    pen_report(state, dpen, 4, 2000, 1000)
    sim_step(state, 6000)
    pen_report(state, dpen, 5, 2000, 1000)
    sim_step(state, 6020)
    pen_report(state, dpen, 7, 2400, 1200)
    sim_step(state, 6040)
    pen_report(state, dpen, 0, 2400, 1200)
    sim_step(state, 6060)
    hidin.set_trace(state, false)
    hidin.set_vclk(state, 0)
    serial.puts((&s_g[0]) as u64)
    serial.puts((&s_h[0]) as u64)
    serial.dec(g(state, S_REPORTS))
    serial.nl()
    var j: u64 = 0
    while j < ndev() {
        var s_r: [u8; 20] = "touchsim: dev reps=\0"
        serial.puts((&s_r[0]) as u64)
        serial.dec(dvg(j, DV_REPS))
        serial.nl()
        j = j + 1
    }
    hidin.touch_say(state)
    serial.puts((&s_i[0]) as u64)
    serial.dec(jt)
    serial.puts((&s_h[0]) as u64)
    serial.dec(jp)
    serial.nl()
    // W-TOUCH4: the /proc/inputdevs text, one serial line per text line (the tables are still filled here).
    var s_p: [u8; 12] = "inputdevs: \0"
    let rn: u64 = render(state, buf(state), 3000)
    var ri: u64 = 0
    var fresh: bool = true
    while ri < rn {
        if fresh {
            serial.puts((&s_p[0]) as u64)
            fresh = false
        }
        let ch: u64 = kstate.get8(buf(state) + ri)
        if ch == 10 {
            serial.nl()
            fresh = true
        } else {
            serial.put(ch as u8)
        }
        ri = ri + 1
    }
}
