
profile kernel

import lib.kstate
import drv.hid.inputclass
import serial
import bus.pci
import acpi.acpi
import acpi.aml
import acpi.amlns
import acpi.amlobj
import drv.hid.inreg
import drv.hid.hidmode
import touchev.inmode
import drv.hid.evring
