profile kernel

import lib.kstate
import drv.hid.hidrep
import drv.hid.hidbits

export {
    MAX_C, extract,
    count, tip, confident, contact_id, x, y, pressure, width, height,
    x_lo, x_hi, y_lo, y_hi, pressure_hi, width_hi, height_hi,
    reported, has_count, has_id, has_range, in_range, barrel, eraser, buttons
}

const MAX_C: u64 = 10

const SEEN_TIP: u64 = 1
const SEEN_ID: u64 = 2
const SEEN_X: u64 = 4
const SEEN_Y: u64 = 8
const SEEN_CONF: u64 = 16

const US_WIDTH: u64 = 0x48
const US_HEIGHT: u64 = 0x49
const US_PRESSURE: u64 = 0x30
const US_INRANGE: u64 = 0x32
const US_INVERT: u64 = 0x3C
const US_BARREL: u64 = 0x44
const US_ERASER: u64 = 0x45

static mut k_n: u64 = 0
static mut k_tip: [u64; 10] = [0; 10]
static mut k_conf: [u64; 10] = [1; 10]
static mut k_id: [u64; 10] = [0; 10]
static mut k_x: [u64; 10] = [0; 10]
static mut k_y: [u64; 10] = [0; 10]
static mut k_press: [u64; 10] = [0; 10]
static mut k_w: [u64; 10] = [0; 10]
static mut k_h: [u64; 10] = [0; 10]
static mut k_xlo: u64 = 0
static mut k_xhi: u64 = 0
static mut k_ylo: u64 = 0
static mut k_yhi: u64 = 0
static mut k_phi: u64 = 0
static mut k_whi: u64 = 0
static mut k_hhi: u64 = 0
static mut k_reported: u64 = 0
static mut k_has_count: bool = false
static mut k_has_id: bool = false
static mut k_has_range: bool = false
static mut k_in_range: u64 = 1
static mut k_barrel: u64 = 0
static mut k_eraser: u64 = 0
static mut k_btn: u64 = 0

fn count() -> u64 { return k_n }
fn tip(i: u64) -> u64 { return k_tip[i as usize] }
fn confident(i: u64) -> u64 { return k_conf[i as usize] }
fn contact_id(i: u64) -> u64 { return k_id[i as usize] }
fn x(i: u64) -> u64 { return k_x[i as usize] }
fn y(i: u64) -> u64 { return k_y[i as usize] }
fn pressure(i: u64) -> u64 { return k_press[i as usize] }
fn width(i: u64) -> u64 { return k_w[i as usize] }
fn height(i: u64) -> u64 { return k_h[i as usize] }
fn x_lo() -> u64 { return k_xlo }
fn x_hi() -> u64 { return k_xhi }
fn y_lo() -> u64 { return k_ylo }
fn y_hi() -> u64 { return k_yhi }
fn pressure_hi() -> u64 { return k_phi }
fn width_hi() -> u64 { return k_whi }
fn height_hi() -> u64 { return k_hhi }
fn reported() -> u64 { return k_reported }
fn has_count() -> bool { return k_has_count }
fn has_id() -> bool { return k_has_id }
fn has_range() -> bool { return k_has_range }
fn in_range() -> u64 { return k_in_range }
fn barrel() -> u64 { return k_barrel }
fn eraser() -> u64 { return k_eraser }
fn buttons() -> u64 { return k_btn }

fn clear() {
    var i: usize = 0
    while i < 10 {
        k_tip[i] = 0
        k_conf[i] = 1
        k_id[i] = 0
        k_x[i] = 0
        k_y[i] = 0
        k_press[i] = 0
        k_w[i] = 0
        k_h[i] = 0
        i = i + 1
    }
    k_n = 0
    k_xlo = 0
    k_xhi = 0
    k_ylo = 0
    k_yhi = 0
    k_phi = 0
    k_whi = 0
    k_hhi = 0
    k_reported = 0
    k_has_count = false
    k_has_id = false
    k_has_range = false
    k_in_range = 1
    k_barrel = 0
    k_eraser = 0
    k_btn = 0
}

fn open_slot(cur: u64, seen: u64, bit: u64) -> u64 {
    if (seen & bit) != 0 && cur + 1 < MAX_C {
        return cur + 1
    }
    return cur
}

fn extract(state: u64, dev: u64, rid: u64, p: u64) -> u64 {
    clear()
    var cur: u64 = 0
    var seen: u64 = 0
    var any: bool = false
    let nf: u64 = hidrep.fields(state, dev)
    var i: u64 = 0
    while i < nf {
        let head: u64 = hidrep.f_head(state, dev, i)
        if ((head >> 8) & 0xFF) == hidrep.KIND_IN
            && (head & 0xFF) == rid
            && (((head >> 16) & 0xFFFF) & hidrep.FL_CONST) == 0 {
            let page: u64 = hidrep.f_page(state, dev, i)
            let off: u64 = hidrep.f_bitoff(state, dev, i)
            let sz: u64 = hidrep.f_bitsz(state, dev, i)
            let cnt: u64 = hidrep.f_count(state, dev, i)
            let first: u64 = hidrep.f_usage(state, dev, i)
            var c: u64 = 0
            while c < cnt {
                let u: u64 = first + c
                let v: u64 = hidbits.bits(p, off + c * sz, sz)
                var bit: u64 = 0
                if page == hidrep.UP_DIGITIZER {
                    if u == hidrep.US_TIPSW {
                        bit = SEEN_TIP
                    } else if u == hidrep.US_CONTACTID {
                        bit = SEEN_ID
                        k_has_id = true
                    } else if u == hidrep.US_CONFIDENCE {
                        bit = SEEN_CONF
                    } else if u == hidrep.US_CONTACTCOUNT {
                        k_reported = v
                        k_has_count = true
                    } else if u == US_INRANGE {
                        k_in_range = v
                        k_has_range = true
                    } else if u == US_BARREL {
                        k_barrel = v
                    } else if u == US_ERASER || u == US_INVERT {
                        if v != 0 {
                            k_eraser = 1
                        }
                    } else if u == US_PRESSURE {
                        k_phi = hidrep.f_lmax(state, dev, i)
                        k_press[cur as usize] = v
                    } else if u == US_WIDTH {
                        k_whi = hidrep.f_lmax(state, dev, i)
                        k_w[cur as usize] = v
                    } else if u == US_HEIGHT {
                        k_hhi = hidrep.f_lmax(state, dev, i)
                        k_h[cur as usize] = v
                    }
                }
                if page == hidrep.UP_DESKTOP {
                    if u == hidrep.US_X {
                        bit = SEEN_X
                        k_xlo = hidrep.f_lmin(state, dev, i)
                        k_xhi = hidrep.f_lmax(state, dev, i)
                    } else if u == hidrep.US_Y {
                        bit = SEEN_Y
                        k_ylo = hidrep.f_lmin(state, dev, i)
                        k_yhi = hidrep.f_lmax(state, dev, i)
                    }
                }
                if page == hidrep.UP_BUTTON {
                    if v != 0 && u >= 1 && u <= 8 {
                        k_btn = k_btn | (1 << (u - 1))
                    }
                }
                if bit != 0 {
                    let next: u64 = open_slot(cur, seen, bit)
                    if next != cur {
                        cur = next
                        seen = 0
                    }
                    seen = seen | bit
                    any = true
                    if bit == SEEN_TIP {
                        k_tip[cur as usize] = v
                    } else if bit == SEEN_ID {
                        k_id[cur as usize] = v
                    } else if bit == SEEN_CONF {
                        k_conf[cur as usize] = v
                    } else if bit == SEEN_X {
                        k_x[cur as usize] = v
                    } else {
                        k_y[cur as usize] = v
                    }
                }
                c = c + 1
            }
        }
        i = i + 1
    }
    if !any {
        return 0
    }
    k_n = cur + 1
    return k_n
}
