// kernel/hidtest.fi -- ERZEUGT VON tools/hid/descs.py, NICHT VON HAND.
//
// Sechs ECHTE Berichtsbeschreibungen und vierzehn kaputte, gepackt zu
// je acht Oktett in ein Wort. Firn kann in einer Zeichenkette keine
// Oktette ueber 0x7F ausdruecken (dort faengt UTF-8 an), also stehen
// sie als Zahlen. Woher jede stammt und wie sie aussieht, steht in
// tools/hid/descs.py -- hier stuende es nur doppelt und waere beim
// naechsten Mal ungleich.
//
// Das Ganze kostet 1374 Oktett Nutzdaten im Abbild und wird NUR im
// Modus `hidrep` angesehen.

profile kernel

import lib.kstate

export { count, len_of, name_of, load, GUTE,
    bcount, bdesc, blen, bload, alen, aload }

const N: u64 = 20
// Die ersten GUTE Beschreibungen muessen durchgehen, die uebrigen
// muessen mit einer bestimmten Fehlernummer scheitern.
const GUTE: u64 = 6

fn count() -> u64 {
    return N
}

fn len_of(i: u64) -> u64 {
    var t: [u64; 20] = [63, 50, 66, 433, 25, 33, 41, 63, 62, 1, 22, 8, 13, 9, 14, 8, 0, 271, 113, 79]
    if i >= N {
        return 0
    }
    return t[i as usize]
}

// Der Name, acht Zeichen in EINEM Wort -- so bleibt die Meldung
// lesbar, ohne dass eine Zeichenkettentabelle noetig waere.
fn name_of(i: u64) -> u64 {
    var t: [u64; 20] = [0x20746F6F6264626B, 0x2020206573756F6D, 0x2020206C65656877, 0x2020202020707470, 0x72656D75736E6F63, 0x202020206F726B6E, 0x6E68637365676261, 0x7265656C66706F6B, 0x2020206E6566666F, 0x656E686F65646E65, 0x202066656974757A, 0x207265656C706F70, 0x2020203535327267, 0x206C6C756E646972, 0x2073736F7267757A, 0x74736F70676E616C, 0x202020207265656C, 0x646C65666C656976, 0x206469726C656976, 0x206265676C656976]
    if i >= N {
        return 0
    }
    return t[i as usize]
}

fn off_of(i: u64) -> u64 {
    var t: [u64; 20] = [0, 8, 15, 24, 79, 83, 88, 94, 102, 110, 111, 114, 115, 117, 119, 121, 122, 122, 156, 171]
    if i >= N {
        return 0
    }
    return t[i as usize]
}

// Beschreibung `i` nach `dst` legen. Rueckgabe: die Laenge.
fn load(i: u64, dst: u64) -> u64 {
    let n: u64 = len_of(i)
    var k: u64 = 0
    while k < n {
        kstate.set8(dst + k, oktett(i, k) as u8)
        k = k + 1
    }
    return n
}

fn oktett(i: u64, k: u64) -> u64 {
    let w: u64 = word(off_of(i) + k / 8)
    return (w >> ((k % 8) * 8)) & 0xFF
}

