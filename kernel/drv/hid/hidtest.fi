// ------------------------------------------------------ DIE BERICHTE
//
// Zu den Beschreibungen gehoeren Berichte, sonst ist der Zerleger eine
// Uebung ohne Gegenstand. Jeder ist von Hand gebaut, mit der Bitlage
// aus der Beschreibung daneben; was dabei herauskommen MUSS, steht in
// tools/hid/descs.py und wird von tools/hid/run.sh nachgerechnet.
const NB: u64 = 21

fn bcount() -> u64 {
    return NB
}

// Zu welcher Beschreibung dieser Bericht gehoert.
fn bdesc(i: u64) -> u64 {
    var t: [u64; 21] = [5, 5, 5, 5, 5, 5, 5, 0, 0, 0, 0, 1, 1, 3, 3, 3, 3, 3, 3, 3, 3]
    if i >= NB {
        return 0
    }
    return t[i as usize]
}

fn blen(i: u64) -> u64 {
    var t: [u64; 21] = [17, 17, 17, 17, 17, 17, 17, 8, 8, 8, 8, 3, 3, 29, 29, 29, 29, 29, 29, 29, 29]
    if i >= NB {
        return 0
    }
    return t[i as usize]
}

fn boff_of(i: u64) -> u64 {
    var t: [u64; 21] = [0, 3, 6, 9, 12, 15, 18, 21, 22, 23, 24, 25, 26, 27, 31, 35, 39, 43, 47, 51, 55]
    if i >= NB {
        return 0
    }
    return t[i as usize]
}

fn bload(i: u64, dst: u64) -> u64 {
    let n: u64 = blen(i)
    var k: u64 = 0
    while k < n {
        kstate.set8(dst + k, boktett(i, k) as u8)
        k = k + 1
    }
    return n
}

fn boktett(i: u64, k: u64) -> u64 {
    let w: u64 = bwort(boff_of(i) + k / 8)
    return (w >> ((k % 8) * 8)) & 0xFF
}

const NBW: u64 = 59

fn bwort(i: u64) -> u64 {
    var t: [u64; 59] = [
        0x000000000FF00002, 0x0000000000000000, 0x0000000000000000, 0x000000003FF00202,
        0x0000000000000000, 0x0000000000000000, 0x0000000000000002, 0x0000000000000000,
        0x0000000000000000, 0x0000000000000802, 0x0000000000000000, 0x0000000000000000,
        0x0000000000100802, 0x0000000000000000, 0x0000000000000000, 0x0000000000000802,
        0x0000000000000000, 0x0000000000000000, 0x0000000000000002, 0x0000000000000000,
        0x0000000000000000, 0x0000000000040000, 0x0000000000040002, 0x0000000000000000,
        0x0101010101010000, 0x0000000000FA0A01, 0x0000000000000000, 0x0000032003E81301,
        0x0000000000000000, 0x0000000000000000, 0x0000000000010000, 0x0000032005141301,
        0x0000000000000000, 0x0000000000000000, 0x0000000000010000, 0x000003B605141301,
        0x0000000000000000, 0x0000000000000000, 0x0000000000010000, 0x000003B605141301,
        0x0000000000000000, 0x0000000000000000, 0x0000000000810000, 0x000003B605141301,
        0x0000000000000000, 0x0000000000000000, 0x0000000000010000, 0x082303B605141301,
        0x000000000003B607, 0x0000000000000000, 0x0000000000020000, 0x0823042E05141301,
        0x0000000000042E07, 0x0000000000000000, 0x0000000000020000, 0x0000000000000001,
        0x0000000000000000, 0x0000000000000000, 0x0000000000000000
    ]
    if i >= NBW {
        return 0
    }
    return t[i as usize]
}

// ------------------------------------ EINE GEBAUTE ACPI-TABELLE
//
// Mit GENAU zwei I2C-Verbindungen (Adressen 0x2C, 0x15) und drei
// Koedern, die wie eine aussehen und keine sind. Der Ersatzweg in
// i2chid.fi muss genau die zwei finden -- die dritte Vorlage ist
// eine WIEDERHOLUNG der ersten und darf nicht doppelt zaehlen.
const AN: u64 = 161

fn alen() -> u64 {
    return AN
}

fn aload(dst: u64) -> u64 {
    var k: u64 = 0
    while k < AN {
        kstate.set8(dst + k, aoktett(k) as u8)
        k = k + 1
    }
    return AN
}

fn aoktett(k: u64) -> u64 {
    return (awort(k / 8) >> ((k % 8) * 8)) & 0xFF
}

const NAW: u64 = 21

fn awort(i: u64) -> u64 {
    var t: [u64; 21] = [
        0x000000A154445344, 0x44484D55534F7202, 0x0000000000000000, 0x0000000000000000,
        0x4430825B00000000, 0x4449485F08305645, 0xFF00008E500CD041, 0x0000010001001E8E,
        0x00061A8000060100, 0x502E42535F5C002C, 0x314332492E304943, 0x8E028E4433221100,
        0x000000010001001E, 0x1500061A80000601, 0x43502E42535F5C00, 0x00304332492E3049,
        0x0000010001001E8E, 0x00061A8000060100, 0x502E42535F5C002C, 0x314332492E304943,
        0x0000000000000000
    ]
    if i >= NAW {
        return 0
    }
    return t[i as usize]
}
