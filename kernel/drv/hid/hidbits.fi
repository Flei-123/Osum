profile kernel

import lib.kstate

export { bits, sbits }

fn bits(buf: u64, off: u64, n: u64) -> u64 {
    if n == 0 || n > 32 {
        return 0
    }
    let first: u64 = off / 8
    let shift: u64 = off % 8
    let need: u64 = (shift + n + 7) / 8
    var v: u64 = 0
    var i: u64 = 0
    while i < need {
        v = v | (kstate.get8(buf + first + i) << (i * 8))
        i = i + 1
    }
    v = v >> shift
    return v & ((1 << n) - 1)
}

fn high_mask(n: u64) -> u64 {
    if n >= 64 {
        return 0
    }
    return 0xFFFFFFFFFFFFFFFF - ((1 << n) - 1)
}

fn sbits(buf: u64, off: u64, n: u64) -> u64 {
    let v: u64 = bits(buf, off, n)
    if n == 0 || n >= 64 {
        return v
    }
    if (v >> (n - 1)) != 0 {
        return v | high_mask(n)
    }
    return v
}
