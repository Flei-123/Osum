profile kernel

import serial
import pwr.blchain
import pwr.hotkeys
import drv.hid.kbd

export {
    selftest
}

static mut dump: [u8; 1024] = [0 as u8; 1024]

fn tag(name: u64) {
    var s_h: [u8; 8] = "hksim: \0"
    serial.puts((&s_h[0]) as u64)
    serial.puts(name)
}

fn report(name: u64, state: u64) {
    var s_p: [u8; 3] = " p\0"
    tag(name)
    serial.puts((&s_p[0]) as u64)
    serial.dec(blchain.percent(state))
    serial.nl()
}

fn press_ext(state: u64, code: u64) {
    kbd.on_code(state, 0xE0)
    kbd.on_code(state, code)
    kbd.on_code(state, 0xE0)
    kbd.on_code(state, code | 0x80)
}

fn press_plain(state: u64, code: u64) {
    kbd.on_code(state, code)
    kbd.on_code(state, code | 0x80)
}

fn selftest(state: u64) {
    var n_a: [u8; 9] = "ext17 up\0"
    var n_b: [u8; 11] = "ext12 down\0"
    var n_c: [u8; 9] = "ext06 up\0"
    var n_d: [u8; 11] = "ext05 down\0"
    var n_e: [u8; 12] = "ext6c other\0"
    var n_f: [u8; 13] = "dup key+acpi\0"
    var n_g: [u8; 11] = "acpi up 86\0"
    var n_h: [u8; 13] = "acpi zero 88\0"
    var n_i: [u8; 14] = "acpi cycle 85\0"
    var n_j: [u8; 14] = "acpi other 8a\0"
    var n_k: [u8; 12] = "plain 70\0\0\0\0"
    var n_l: [u8; 14] = "ext17 release\0"
    var n_m: [u8; 12] = "ext6f up 6f\0"
    var s_d: [u8; 12] = "hksim: done\0"
    var s_x: [u8; 12] = "hksim: dump\0"
    blchain.set_percent(state, 50)
    hotkeys.forget_last()
    press_ext(state, 0x17)
    report((&n_a[0]) as u64, state)
    hotkeys.forget_last()
    press_ext(state, 0x12)
    report((&n_b[0]) as u64, state)
    hotkeys.forget_last()
    press_ext(state, 0x06)
    report((&n_c[0]) as u64, state)
    hotkeys.forget_last()
    press_ext(state, 0x05)
    report((&n_d[0]) as u64, state)
    hotkeys.forget_last()
    press_ext(state, 0x6C)
    report((&n_e[0]) as u64, state)
    hotkeys.forget_last()
    kbd.on_code(state, 0xE0)
    kbd.on_code(state, 0x97)
    report((&n_l[0]) as u64, state)
    hotkeys.forget_last()
    press_ext(state, 0x17)
    blchain.on_notify(state, 0x86)
    report((&n_f[0]) as u64, state)
    hotkeys.forget_last()
    blchain.on_notify(state, 0x86)
    report((&n_g[0]) as u64, state)
    hotkeys.forget_last()
    blchain.on_notify(state, 0x88)
    report((&n_h[0]) as u64, state)
    hotkeys.forget_last()
    blchain.on_notify(state, 0x85)
    report((&n_i[0]) as u64, state)
    hotkeys.forget_last()
    blchain.on_notify(state, 0x8A)
    report((&n_j[0]) as u64, state)
    press_plain(state, 0x70)
    report((&n_k[0]) as u64, state)
    hotkeys.forget_last()
    press_ext(state, 0x6F)
    report((&n_m[0]) as u64, state)
    serial.puts((&s_x[0]) as u64)
    serial.nl()
    var i: u64 = 0
    while i < 1024 {
        dump[i as usize] = 0 as u8
        i = i + 1
    }
    hotkeys.render(state, (&dump[0]) as u64, 1024)
    serial.puts((&dump[0]) as u64)
    serial.puts((&s_d[0]) as u64)
    serial.nl()
}
