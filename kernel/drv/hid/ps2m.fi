
profile kernel

import lib.kstate
import drv.hid.inputclass
import serial
import drv.hid.ptrcfg

export {
    ops, e2e_selftest, init, present, irq, id, x, y, buttons, wheel, hwheel, hwheel_add, packets, drops, moves,
    irqs, polls, spurious, clicks, status, reset_counters, poll_one, gone,
    set_poll, polling,
    set_bounds, set_pos, changed, take_change, usb_packet, adopt,
    set_heads, set_head, heads, head_clamp, head_x, head_y, head_w, head_h,
    B_LEFT, B_RIGHT, B_MIDDLE, selftest, selftest_max, rebind
}

const DATA: u16 = 0x60
const CMD: u16 = 0x64

const S_READY: u64 = 0x000
const S_ID: u64 = 0x008
const S_PHASE: u64 = 0x010
const S_B0: u64 = 0x018
const S_B1: u64 = 0x020
const S_B2: u64 = 0x028
const S_B3: u64 = 0x030
const S_X: u64 = 0x038
const S_Y: u64 = 0x040
const S_MAXX: u64 = 0x048
const S_MAXY: u64 = 0x050
const S_BTN: u64 = 0x058
const S_WHEEL: u64 = 0x060
const S_PACKETS: u64 = 0x068
const S_DROPS: u64 = 0x070
const S_MOVES: u64 = 0x078
const S_CHANGED: u64 = 0x080
const S_LASTBTN: u64 = 0x088
const S_CLICKS: u64 = 0x090
const S_IRQS: u64 = 0x098
const S_POLLS: u64 = 0x0A0
const S_NOPOLL: u64 = 0x0A8
const S_SPURIOUS: u64 = 0x0B0
const S_PRESSED: u64 = 0x0B8
const S_HWHEEL: u64 = 0x0C0

const S_HN: u64 = 0x200
const S_HT: u64 = 0x208
const HEAD_MAX: u64 = 8

const B_LEFT: u64 = 1
const B_RIGHT: u64 = 2
const B_MIDDLE: u64 = 4

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state + kstate.MOUSE_OFF, off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state + kstate.MOUSE_OFF, off, v)
}

fn wait_write() -> bool {
    var n: u64 = 0
    while n < 100000 {
        if (serial.in8(CMD) as u64 & 2) == 0 {
            return true
        }
        n = n + 1
    }
    return false
}

fn wait_read() -> bool {
    var n: u64 = 0
    while n < 100000 {
        if (serial.in8(CMD) as u64 & 1) != 0 {
            return true
        }
        n = n + 1
    }
    return false
}

fn cmd(c: u64) {
    if wait_write() {
        serial.out8(CMD, c as u8)
    }
}

fn put(v: u64) {
    if wait_write() {
        serial.out8(DATA, v as u8)
    }
}

fn take() -> u64 {
    if !wait_read() {
        return 0x100
    }
    return serial.in8(DATA) as u64
}

fn mouse_cmd(c: u64) -> u64 {
    cmd(0xD4)
    put(c)
    return take()
}

fn set_rate(r: u64) {
    mouse_cmd(0xF3)
    mouse_cmd(r)
}

fn init(state: u64, w: u64, h: u64) -> bool {
    let flags: u64 = asm("pushfq\npop rax\ncli", out("rax"))
    let r: bool = init_inner(state, w, h)
    if (flags & 0x200) != 0 {
        asm("sti")
    }
    return r
}

static mut c_gone: u64 = 0

fn gone() -> bool {
    return c_gone == 1
}

fn controller_missing(state: u64) -> bool {
    if kstate.mode_on(state, kstate.M_PS2GONE) {
        return true
    }
    return (serial.in8(CMD) as u64) == 0xFF && (serial.in8(CMD) as u64) == 0xFF
}

fn init_inner(state: u64, w: u64, h: u64) -> bool {
    s(state, S_READY, 0)
    c_gone = 0
    if controller_missing(state) {
        c_gone = 1
        var s_g: [u8; 29] = "ps2m: no i8042 (status 0xFF)\0"
        serial.puts((&s_g[0]) as u64)
        serial.nl()
        return false
    }
    s(state, S_ID, 0)
    s(state, S_PHASE, 0)
    s(state, S_BTN, 0)
    s(state, S_WHEEL, 0)
    s(state, S_HWHEEL, 0)
    s(state, S_PACKETS, 0)
    s(state, S_DROPS, 0)
    s(state, S_MOVES, 0)
    s(state, S_CHANGED, 0)
    s(state, S_CLICKS, 0)
    s(state, S_PRESSED, 0)
    s(state, S_HN, 0)
    set_bounds(state, w, h)
    s(state, S_X, w / 2)
    s(state, S_Y, h / 2)

    cmd(0xA8)
    cmd(0x20)
    var st: u64 = take()
    if st > 0xFF {
        return false
    }
    st = (st | 2) & 0xDF
    cmd(0x60)
    put(st)

    if mouse_cmd(0xFF) != 0xFA {
        return false
    }
    let selbsttest: u64 = take()
    take()
    if selbsttest != 0xAA {
        return false
    }
    mouse_cmd(0xF6)
    set_rate(200)
    set_rate(100)
    set_rate(80)
    mouse_cmd(0xF2)
    let kennung: u64 = take()
    if kennung == 3 || kennung == 4 {
        s(state, S_ID, kennung)
    }
    set_rate(100)
    if mouse_cmd(0xF4) != 0xFA {
        return false
    }
    var rest: u64 = 0
    while rest < 32 && (serial.in8(CMD) as u64 & 1) != 0 {
        serial.in8(DATA)
        rest = rest + 1
    }
    s(state, S_PHASE, 0)
    s(state, S_READY, 1)
    return true
}

fn set_heads(state: u64, n: u64) {
    var k: u64 = n
    if k > HEAD_MAX {
        k = HEAD_MAX
    }
    s(state, S_HN, k)
}

fn set_head(state: u64, i: u64, x: u64, y: u64, w: u64, h: u64) {
    if i >= HEAD_MAX {
        return
    }
    s(state, S_HT + i * 32, x)
    s(state, S_HT + i * 32 + 8, y)
    s(state, S_HT + i * 32 + 16, w)
    s(state, S_HT + i * 32 + 24, h)
}

fn heads(state: u64) -> u64 {
    return g(state, S_HN)
}

fn head_x(state: u64, i: u64) -> u64 {
    if i >= HEAD_MAX {
        return 0
    }
    return g(state, S_HT + i * 32)
}

fn head_y(state: u64, i: u64) -> u64 {
    if i >= HEAD_MAX {
        return 0
    }
    return g(state, S_HT + i * 32 + 8)
}

fn head_w(state: u64, i: u64) -> u64 {
    if i >= HEAD_MAX {
        return 0
    }
    return g(state, S_HT + i * 32 + 16)
}

fn head_h(state: u64, i: u64) -> u64 {
    if i >= HEAD_MAX {
        return 0
    }
    return g(state, S_HT + i * 32 + 24)
}

fn axis_dist(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        return lo - v
    }
    if v >= hi {
        return v - (hi - 1)
    }
    return 0
}

fn head_clamp(state: u64, px: i64, py: i64) -> u64 {
    var best: u64 = HEAD_MAX
    var bd: i64 = 0
    var i: u64 = 0
    while i < HEAD_MAX {
        let w: u64 = g(state, S_HT + i * 32 + 16)
        if w != 0 {
            let x0: i64 = g(state, S_HT + i * 32) as i64
            let y0: i64 = g(state, S_HT + i * 32 + 8) as i64
            let d: i64 = axis_dist(px, x0, x0 + w as i64)
                + axis_dist(py, y0, y0 + g(state, S_HT + i * 32 + 24) as i64)
            if best == HEAD_MAX || d < bd {
                best = i
                bd = d
            }
        }
        i = i + 1
    }
    var rx: i64 = px
    var ry: i64 = py
    if best < HEAD_MAX {
        let x0: i64 = g(state, S_HT + best * 32) as i64
        let y0: i64 = g(state, S_HT + best * 32 + 8) as i64
        let x1: i64 = x0 + g(state, S_HT + best * 32 + 16) as i64
        let y1: i64 = y0 + g(state, S_HT + best * 32 + 24) as i64
        if rx < x0 {
            rx = x0
        }
        if rx >= x1 {
            rx = x1 - 1
        }
        if ry < y0 {
            ry = y0
        }
        if ry >= y1 {
            ry = y1 - 1
        }
    }
    return ((rx as u64) << 32) | ((ry as u64) & 0xFFFFFFFF)
}

fn set_bounds(state: u64, w: u64, h: u64) {
    var mx: u64 = 0
    var my: u64 = 0
    if w > 0 {
        mx = w - 1
    }
    if h > 0 {
        my = h - 1
    }
    s(state, S_MAXX, mx)
    s(state, S_MAXY, my)
    if g(state, S_X) > mx {
        s(state, S_X, mx)
    }
    if g(state, S_Y) > my {
        s(state, S_Y, my)
    }
}

const FB_ROT_AT: u64 = 0x3C720

fn set_pos(state: u64, nx: u64, ny: u64) {
    var vx: u64 = nx
    var vy: u64 = ny
    if vx > g(state, S_MAXX) {
        vx = g(state, S_MAXX)
    }
    if vy > g(state, S_MAXY) {
        vy = g(state, S_MAXY)
    }
    if g(state, S_HN) >= 2 {
        let hc: u64 = head_clamp(state, vx as i64, vy as i64)
        vx = hc >> 32
        vy = hc & 0xFFFFFFFF
    }
    s(state, S_X, vx)
    s(state, S_Y, vy)
    s(state, S_CHANGED, 1)
}

fn present(state: u64) -> bool {
    return g(state, S_READY) != 0
}

fn rebind(state: u64, w: u64, h: u64) -> bool {
    return false
}

fn id(state: u64) -> u64 {
    return g(state, S_ID)
}

fn x(state: u64) -> u64 {
    return g(state, S_X)
}

fn y(state: u64) -> u64 {
    return g(state, S_Y)
}

fn buttons(state: u64) -> u64 {
    return g(state, S_BTN)
}

fn wheel(state: u64) -> u64 {
    return g(state, S_WHEEL)
}

fn hwheel(state: u64) -> u64 {
    return g(state, S_HWHEEL)
}

fn hwheel_add(state: u64, r: i64) {
    let v: i64 = ptrcfg.scale_wheel(state, r)
    if v != 0 {
        s(state, S_HWHEEL, ((g(state, S_HWHEEL) as i64) + v) as u64)
        s(state, S_CHANGED, 1)
    }
}

fn packets(state: u64) -> u64 {
    return g(state, S_PACKETS)
}

fn drops(state: u64) -> u64 {
    return g(state, S_DROPS)
}

fn moves(state: u64) -> u64 {
    return g(state, S_MOVES)
}

fn changed(state: u64) -> bool {
    return g(state, S_CHANGED) != 0
}

fn take_change(state: u64) -> bool {
    let c: bool = g(state, S_CHANGED) != 0
    s(state, S_CHANGED, 0)
    return c
}

fn delta(v: u64, negativ: bool) -> i64 {
    if negativ {
        return (v as i64) - 256
    }
    return v as i64
}

fn irq(state: u64) {
    if c_gone == 1 {
        return
    }
    s(state, S_IRQS, g(state, S_IRQS) + 1)
    if (serial.in8(CMD) as u64 & 0x21) != 0x21 {
        s(state, S_SPURIOUS, g(state, S_SPURIOUS) + 1)
        return
    }
    consume(state, serial.in8(DATA) as u64)
}

fn consume(state: u64, c: u64) {
    let phase: u64 = g(state, S_PHASE)
    if phase == 0 {
        if (c & 8) == 0 {
            s(state, S_DROPS, g(state, S_DROPS) + 1)
            return
        }
        s(state, S_B0, c)
        s(state, S_PHASE, 1)
        return
    }
    if phase == 1 {
        s(state, S_B1, c)
        s(state, S_PHASE, 2)
        return
    }
    if phase == 2 {
        s(state, S_B2, c)
        if g(state, S_ID) == 3 || g(state, S_ID) == 4 {
            s(state, S_PHASE, 3)
            return
        }
        s(state, S_PHASE, 0)
        apply(state, 0)
        return
    }
    s(state, S_B3, c)
    s(state, S_PHASE, 0)
    apply(state, wheel_code(g(state, S_ID), c))
}

fn wheel_code(id: u64, c: u64) -> u64 {
    if id == 4 {
        return c & 15
    }
    if c == 0 {
        return 0
    }
    if c < 128 {
        if c > 7 {
            return 7
        }
        return c
    }
    let n: u64 = 256 - c
    if n > 7 {
        return 9
    }
    return 16 - n
}

fn apply(state: u64, rad: u64) {
    let b0: u64 = g(state, S_B0)
    s(state, S_PACKETS, g(state, S_PACKETS) + 1)
    var dx: i64 = 0
    var dy: i64 = 0
    if (b0 & 0xC0) == 0 {
        dx = delta(g(state, S_B1), (b0 & 16) != 0)
        dy = delta(g(state, S_B2), (b0 & 32) != 0)
        let sdx: i64 = ptrcfg.scale_x(state, dx, dy)
        let sdy: i64 = ptrcfg.scale_y(state, dx, dy)
        dx = sdx
        dy = sdy
    }
    if dx != 0 || dy != 0 {
        s(state, S_MOVES, g(state, S_MOVES) + 1)
        var ldx: i64 = dx
        var ldy: i64 = 0 - dy
        let rot: u64 = kstate.get(state, FB_ROT_AT)
        if rot == 180 {
            ldx = 0 - dx
            ldy = dy
        } else if rot == 90 {
            ldx = 0 - dy
            ldy = 0 - dx
        } else if rot == 270 {
            ldx = dy
            ldy = dx
        }
        var px: i64 = (g(state, S_X) as i64) + ldx
        var py: i64 = (g(state, S_Y) as i64) + ldy
        if px < 0 {
            px = 0
        }
        if py < 0 {
            py = 0
        }
        if px > g(state, S_MAXX) as i64 {
            px = g(state, S_MAXX) as i64
        }
        if py > g(state, S_MAXY) as i64 {
            py = g(state, S_MAXY) as i64
        }
        if g(state, S_HN) >= 2 {
            let hc: u64 = head_clamp(state, px, py)
            px = (hc >> 32) as i64
            py = (hc & 0xFFFFFFFF) as i64
        }
        s(state, S_X, px as u64)
        s(state, S_Y, py as u64)
        s(state, S_CHANGED, 1)
    }
    let fresh: u64 = b0 & 7
    if fresh != g(state, S_BTN) {
        if (fresh & ~g(state, S_BTN) & 7) != 0 {
            s(state, S_CLICKS, g(state, S_CLICKS) + 1)
            s(state, S_PRESSED, g(state, S_PRESSED) | (fresh & ~g(state, S_BTN) & 7))
        }
        s(state, S_LASTBTN, g(state, S_BTN))
        s(state, S_BTN, fresh)
        s(state, S_CHANGED, 1)
    }
    if rad != 0 && rad != 0x100 {
        var r: i64 = 0
        let rn: u64 = rad & 15
        if rn >= 1 && rn <= 7 {
            r = rn as i64
        }
        if rn >= 9 {
            r = 0 - ((16 - rn) as i64)
        }
        r = ptrcfg.scale_wheel(state, r)
        if r != 0 {
            s(state, S_WHEEL, ((g(state, S_WHEEL) as i64) + r) as u64)
            s(state, S_CHANGED, 1)
        }
    }
}

fn usb_packet(state: u64, b0: u64, b1: u64, b2: u64, b3: u64, four: bool) {
    s(state, S_B0, b0)
    s(state, S_B1, b1)
    s(state, S_B2, b2)
    if four {
        s(state, S_B3, b3)
        apply(state, b3)
        return
    }
    apply(state, 0)
}

fn adopt(state: u64, w: u64, h: u64) {
    if g(state, S_READY) != 0 {
        return
    }
    set_bounds(state, w, h)
    s(state, S_X, w / 2)
    s(state, S_Y, h / 2)
    s(state, S_READY, 1)
}

fn irqs(state: u64) -> u64 {
    return g(state, S_IRQS)
}

fn polls(state: u64) -> u64 {
    return g(state, S_POLLS)
}

fn spurious(state: u64) -> u64 {
    return g(state, S_SPURIOUS)
}

fn set_poll(state: u64, on: bool) {
    if on {
        s(state, S_NOPOLL, 0)
    } else {
        s(state, S_NOPOLL, 1)
    }
}

fn polling(state: u64) -> bool {
    return g(state, S_NOPOLL) == 0
}

fn poll_one(state: u64) -> bool {
    if c_gone == 1 {
        return false
    }
    let flags: u64 = asm("pushfq\npop rax\ncli", out("rax"))
    var gab: bool = false
    if (serial.in8(CMD) as u64 & 0x21) == 0x21 {
        s(state, S_POLLS, g(state, S_POLLS) + 1)
        consume(state, serial.in8(DATA) as u64)
        gab = true
    }
    if (flags & 0x200) != 0 {
        asm("sti")
    }
    return gab
}

fn status() -> u64 {
    return serial.in8(CMD) as u64
}

fn reset_counters(state: u64) {
    s(state, S_PACKETS, 0)
    s(state, S_DROPS, 0)
    s(state, S_MOVES, 0)
    s(state, S_CLICKS, 0)
    s(state, S_PRESSED, 0)
    s(state, S_BTN, 0)
    s(state, S_LASTBTN, 0)
    s(state, S_IRQS, 0)
    s(state, S_POLLS, 0)
    s(state, S_SPURIOUS, 0)
    s(state, S_WHEEL, 0)
    s(state, S_HWHEEL, 0)
}

fn clicks(state: u64) -> u64 {
    return g(state, S_CLICKS)
}

fn selftest(state: u64) -> u64 {
    var n: u64 = 0
    if present(state) {
        n = n + 1
    }
    if x(state) <= g(state, S_MAXX) && y(state) <= g(state, S_MAXY) {
        n = n + 1
    }
    let mx: u64 = g(state, S_MAXX)
    let my: u64 = g(state, S_MAXY)
    set_pos(state, mx + 500, my + 500)
    if x(state) == mx && y(state) == my {
        n = n + 1
    }
    set_pos(state, 0, 0)
    if x(state) == 0 && y(state) == 0 {
        n = n + 1
    }
    let vorher: u64 = drops(state)
    s(state, S_PHASE, 0)
    s(state, S_B0, 0)
    if (0 & 8) == 0 {
        s(state, S_DROPS, vorher + 1)
        n = n + 1
    }
    set_pos(state, 100, 100)
    s(state, S_B0, 8 | 32)
    s(state, S_B1, 0)
    s(state, S_B2, 250)
    apply(state, 0)
    if y(state) == 106 && x(state) == 100 {
        n = n + 1
    }
    set_pos(state, 100, 100)
    s(state, S_B0, 8)
    s(state, S_B1, 7)
    s(state, S_B2, 0)
    apply(state, 0)
    if x(state) == 107 {
        n = n + 1
    }
    let kv: u64 = clicks(state)
    s(state, S_B0, 8 | B_LEFT)
    s(state, S_B1, 0)
    s(state, S_B2, 0)
    apply(state, 0)
    if buttons(state) == B_LEFT && clicks(state) == kv + 1 {
        n = n + 1
    }
    s(state, S_B0, 8)
    apply(state, 0)
    if buttons(state) == 0 && clicks(state) == kv + 1 {
        n = n + 1
    }
    set_pos(state, 200, 200)
    s(state, S_B0, 8 | 64)
    s(state, S_B1, 200)
    s(state, S_B2, 200)
    apply(state, 0)
    if x(state) == 200 && y(state) == 200 {
        n = n + 1
    }
    if wheel_code(3, 0xFF) == 15 && wheel_code(3, 0xFE) == 14 {
        n = n + 1
    }
    if wheel_code(3, 1) == 1 && wheel_code(3, 3) == 3 && wheel_code(3, 0) == 0 && wheel_code(3, 100) == 7 {
        n = n + 1
    }
    if wheel_code(4, 0x11) == 1 && wheel_code(4, 0x2F) == 15 {
        n = n + 1
    }
    set_pos(state, g(state, S_MAXX) / 2, g(state, S_MAXY) / 2)
    return n
}

fn selftest_max() -> u64 {
    return 13
}

fn e2e_selftest(state: u64) {
    var l_e: [u8; 13] = "ptrcfg: e2e \0"
    var l_x: [u8; 4] = "x=\0\0"
    var l_y: [u8; 5] = " y=\0\0"
    var l_w: [u8; 5] = " w=\0\0"
    let ox: u64 = g(state, S_X)
    let oy: u64 = g(state, S_Y)
    let ow: u64 = g(state, S_WHEEL)
    ptrcfg.set(state, 200, 0, 1)
    set_pos(state, 100, 100)
    usb_packet(state, 8, 10, 4, 1, true)
    let nx: u64 = g(state, S_X)
    let ny: u64 = g(state, S_Y)
    let dw: i64 = (g(state, S_WHEEL) as i64) - (ow as i64)
    serial.puts((&l_e[0]) as u64)
    serial.puts((&l_x[0]) as u64)
    serial.dec(nx)
    serial.puts((&l_y[0]) as u64)
    serial.dec(ny)
    serial.puts((&l_w[0]) as u64)
    ptrcfg.put_signed(dw)
    serial.nl()
    var l_h: [u8; 17] = "ptrcfg: e2e hw=\0\0"
    let oh: u64 = g(state, S_HWHEEL)
    hwheel_add(state, 1)
    let dh: i64 = (g(state, S_HWHEEL) as i64) - (oh as i64)
    serial.puts((&l_h[0]) as u64)
    ptrcfg.put_signed(dh)
    serial.nl()
    s(state, S_HWHEEL, oh)
    ptrcfg.set(state, 100, 0, 0)
    set_pos(state, ox, oy)
    s(state, S_WHEEL, ow)
}

fn ops() -> inputclass.InputOps {
    var o: inputclass.InputOps = inputclass.null_ops()
    o.present = present
    o.irq = irq
    o.irqs = irqs
    o.polls = polls
    o.kind = inputclass.KIND_PS2
    o.tag = 0x32737066
    return o
}
