profile kernel

import drv.hid.kbdmap
import drv.hid.kbddead
import drv.hid.kbdcompose

export { feed_entry, feed_key, reset, compose_key, rctrl_down, rctrl_up, other_key, composing, dead_pending }

static mut rctrl_clean: u64 = 0

fn composing() -> bool {
    return kbdcompose.active()
}

fn dead_pending() -> bool {
    return kbddead.pending()
}

fn feed_entry(e: u64) -> u64 {
    if kbdcompose.active() {
        return kbdcompose.feed(kbdmap.plain_char(e))
    }
    return kbddead.feed(e)
}

fn feed_key(lay: u64, code: u64, shift: bool, altgr: bool, caps: bool, fallback: u64) -> u64 {
    var e: u64 = kbdmap.entry(lay, code, shift, altgr, caps)
    if e == 0 {
        e = fallback
    }
    return feed_entry(e)
}

fn reset() {
    kbddead.reset()
    kbdcompose.cancel()
    rctrl_clean = 0
}

fn compose_key() {
    kbddead.reset()
    kbdcompose.arm()
}

fn rctrl_down() {
    rctrl_clean = 1
}

fn other_key() {
    rctrl_clean = 0
}

fn rctrl_up() -> bool {
    if rctrl_clean == 1 {
        rctrl_clean = 0
        compose_key()
        return true
    }
    return false
}
