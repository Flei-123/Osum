profile kernel

export {
    reset, begin, note_probe, probe, count, get, set, note_osys, osys_before, osys_after, note_sb_ini, sb_ini,
    F_NODE, F_INI, F_CRS, F_LEN, F_I2C, F_GPIO, F_IRQ, F_ADR, F_HREG, F_RES, F_CTRL, F_PIN, F_BADR, F_HID2,
    ST_NONE, ST_FAILED, ST_OK, OSYS_UNKNOWN
}

const MAX_REC: u64 = 8
const WIDTH: u64 = 16
const F_NODE: u64 = 0
const F_INI: u64 = 1
const F_CRS: u64 = 2
const F_LEN: u64 = 3
const F_I2C: u64 = 4
const F_GPIO: u64 = 5
const F_IRQ: u64 = 6
const F_ADR: u64 = 7
const F_HREG: u64 = 8
const F_RES: u64 = 9
const F_CTRL: u64 = 10
const F_PIN: u64 = 11
const F_BADR: u64 = 12
const F_HID2: u64 = 13

const ST_NONE: u64 = 0
const ST_FAILED: u64 = 1
const ST_OK: u64 = 2
const OSYS_UNKNOWN: u64 = 0xFFFFFFFF

static mut recs: [u64; 128] = [0 as u64; 128]
static mut used: u64 = 0
static mut sb_ini_state: u64 = 0
static mut osys_pre: u64 = 0xFFFFFFFF
static mut osys_post: u64 = 0xFFFFFFFF
static mut probes: [u64; 4] = [0xFFFFFFFF as u64; 4]

fn reset() {
    used = 0
    sb_ini_state = ST_NONE
    osys_pre = OSYS_UNKNOWN
    osys_post = OSYS_UNKNOWN
    var i: u64 = 0
    while i < 4 {
        probes[i as usize] = OSYS_UNKNOWN
        i = i + 1
    }
}

fn note_probe(k: u64, v: u64) {
    if k < 4 {
        probes[k as usize] = v
    }
}

fn probe(k: u64) -> u64 {
    if k >= 4 {
        return OSYS_UNKNOWN
    }
    return probes[k as usize]
}

fn begin(node: u64) -> u64 {
    if used >= MAX_REC {
        return MAX_REC
    }
    let k: u64 = used
    var f: u64 = 0
    while f < WIDTH {
        recs[(k * WIDTH + f) as usize] = 0
        f = f + 1
    }
    recs[(k * WIDTH + F_NODE) as usize] = node
    recs[(k * WIDTH + F_HREG) as usize] = OSYS_UNKNOWN
    recs[(k * WIDTH + F_CTRL) as usize] = 0xFF
    recs[(k * WIDTH + F_BADR) as usize] = OSYS_UNKNOWN
    recs[(k * WIDTH + F_HID2) as usize] = OSYS_UNKNOWN
    used = used + 1
    return k
}

fn count() -> u64 {
    return used
}

fn get(k: u64, f: u64) -> u64 {
    if k >= used || f >= WIDTH {
        return 0
    }
    return recs[(k * WIDTH + f) as usize]
}

fn set(k: u64, f: u64, v: u64) {
    if k >= used || f >= WIDTH {
        return
    }
    recs[(k * WIDTH + f) as usize] = v
}

fn note_osys(before: bool, v: u64) {
    if before {
        osys_pre = v
    } else {
        osys_post = v
    }
}

fn osys_before() -> u64 {
    return osys_pre
}

fn osys_after() -> u64 {
    return osys_post
}

fn note_sb_ini(st: u64) {
    sb_ini_state = st
}

fn sb_ini() -> u64 {
    return sb_ini_state
}
