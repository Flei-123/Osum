    ruf2(a, state, n)
}

fn set_head(state: u64, i: u64, x: u64, y: u64, w: u64, h: u64) {
    let a: u64 = op(state, modidx.P_SET_HEAD)
    if a == 0 {
        return
    }
    ruf6(a, state, i, x, y, w, h)
}

fn hwheel(state: u64) -> u64 {
    let a: u64 = op(state, modidx.P_HWHEEL)
    if a == 0 {
        return 0
    }
    return ruf1(a, state)
}

fn hwheel_add(state: u64, r: i64) {
    let a: u64 = op(state, modidx.P_HWHEEL_ADD)
    if a == 0 {
        return
    }
    ruf2(a, state, r as u64)
}

fn ops() -> inputclass.InputOps {
    var o: inputclass.InputOps = inputclass.null_ops()
    o.present = present
    o.irq = irq
    o.irqs = irqs
    o.polls = polls
    o.kind = inputclass.KIND_PS2
    o.tag = 0x32737066
    return o
}
