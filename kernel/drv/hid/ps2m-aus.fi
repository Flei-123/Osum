fn usb_packet(state: u64, b0: u64, b1: u64, b2: u64, b3: u64, four: bool) {
    let a: u64 = op(state, modidx.P_USB_PACKET)
    if a == 0 {
        return
    }
    var v: u64 = 0
    if four {
        v = 1
    }
    ruf6(a, state, b0, b1, b2, b3, v)
}

fn adopt(state: u64, w: u64, h: u64) {
    let a: u64 = op(state, modidx.P_ADOPT)
    if a == 0 {
        return
    }
    ruf3(a, state, w, h)
}

fn selftest(state: u64) -> u64 {
    let a: u64 = op(state, modidx.P_SELFTEST)
    if a == 0 {
        return 0
    }
    return ruf1(a, state)
}

fn selftest_max() -> u64 {
    let a: u64 = op(basis(), modidx.P_SELFTEST_MAX)
    if a == 0 {
        return 10
    }
    return ruf0(a)
}

fn e2e_selftest(state: u64) {
}

