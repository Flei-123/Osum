fn status() -> u64 {
    let a: u64 = op(basis(), modidx.P_STATUS)
    if a == 0 {
        return 0
    }
    return ruf0(a)
}

fn reset_counters(state: u64) {
    let a: u64 = op(state, modidx.P_RESET)
    if a == 0 {
        return
    }
    ruf1(a, state)
}

fn poll_one(state: u64) -> bool {
    let a: u64 = op(state, modidx.P_POLL_ONE)
    if a == 0 {
        return false
    }
    return ruf1(a, state) != 0
}

fn set_poll(state: u64, on: bool) {
    let a: u64 = op(state, modidx.P_SET_POLL)
    if a == 0 {
        return
    }
    var b: u64 = 0
    if on {
        b = 1
    }
    ruf2(a, state, b)
}

fn polling(state: u64) -> bool {
    let a: u64 = op(state, modidx.P_POLLING)
    if a == 0 {
        return false
    }
    return ruf1(a, state) != 0
}

fn set_bounds(state: u64, w: u64, h: u64) {
    let a: u64 = op(state, modidx.P_SET_BOUNDS)
    if a == 0 {
        return
    }
    ruf3(a, state, w, h)
}

fn set_pos(state: u64, nx: u64, ny: u64) {
    let a: u64 = op(state, modidx.P_SET_POS)
    if a == 0 {
        return
    }
    ruf3(a, state, nx, ny)
}

fn changed(state: u64) -> bool {
    let a: u64 = op(state, modidx.P_CHANGED)
