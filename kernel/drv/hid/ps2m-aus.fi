
profile kernel

import lib.kstate
import drv.hid.inputclass
import serial
import ldr.modtab
import ldr.modidx

export {
    ops, init, present, irq, id, x, y, buttons, wheel, packets, drops, moves,
    irqs, polls, spurious, clicks, status, reset_counters, poll_one,
    set_poll, polling,
    set_bounds, set_pos, changed, take_change, usb_packet, adopt, rebind,
    B_LEFT, B_RIGHT, B_MIDDLE, selftest, selftest_max, e2e_selftest,
    heads, head_x, head_y, head_w, head_h, set_heads, set_head, hwheel, hwheel_add
}

const B_LEFT: u64 = 1
const B_RIGHT: u64 = 2
const B_MIDDLE: u64 = 4

fn ruf0(adr: u64) -> u64 {
    var rc: u64 = 0
    asm("call rax", in("rax") adr, out("rax") & rc, clobber("memory"))
    done()
    return rc
}

fn ruf1(adr: u64, a: u64) -> u64 {
    var rc: u64 = 0
    asm("call rax", in("rax") adr, in("rdi") a, out("rax") & rc,
        clobber("memory"))
    done()
    return rc
}

fn ruf2(adr: u64, a: u64, b: u64) -> u64 {
    var rc: u64 = 0
    asm("call rax", in("rax") adr, in("rdi") a, in("rsi") b,
        out("rax") & rc, clobber("memory"))
    done()
    return rc
}

fn ruf3(adr: u64, a: u64, b: u64, c: u64) -> u64 {
    var rc: u64 = 0
    asm("call rax", in("rax") adr, in("rdi") a, in("rsi") b, in("rdx") c,
        out("rax") & rc, clobber("memory"))
    done()
    return rc
}

fn ruf6(adr: u64, a: u64, b: u64, c: u64, d: u64, e: u64, f: u64) -> u64 {
    var rc: u64 = 0
    asm("call rax", in("rax") adr, in("rdi") a, in("rsi") b, in("rdx") c,
        in("rcx") d, in("r8") e, in("r9") f, out("rax") & rc,
        clobber("memory"))
    done()
    return rc
}

fn op(state: u64, i: u64) -> u64 {
    return modtab.acquire(state, modidx.SLOT_MOUSE, i)
}

fn done() {
    modtab.release(basis(), modidx.SLOT_MOUSE)
}

fn basis() -> u64 {
    return asm("lea rax, [rip + kdata]", out("rax"))
}

fn init(state: u64, w: u64, h: u64) -> bool {
    let a: u64 = op(state, modidx.P_INIT)
    if a == 0 {
        return false
    }
    return ruf3(a, state, w, h) != 0
}

fn rebind(state: u64, w: u64, h: u64) -> bool {
    return init(state, w, h)
}

fn present(state: u64) -> bool {
    let a: u64 = op(state, modidx.P_PRESENT)
    if a == 0 {
        return false
    }
    return ruf1(a, state) != 0
}

fn irq(state: u64) {
    let a: u64 = op(state, modidx.P_IRQ)
    if a == 0 {
        return
    }
    ruf1(a, state)
}

fn id(state: u64) -> u64 {
    let a: u64 = op(state, modidx.P_ID)
    if a == 0 {
        return 0
    }
    return ruf1(a, state)
}

