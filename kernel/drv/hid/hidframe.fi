profile kernel

import drv.hid.hidcontact

export { MAX_F, push, count, id, x, y, tip, confident, pressure, width, drop_dev }

const MAX_DEV: u64 = 8
const MAX_F: u64 = 16

static mut f_n: [u64; 8] = [0; 8]
static mut f_left: [u64; 8] = [0; 8]
static mut f_open: [u64; 8] = [0; 8]
static mut f_id: [u64; 128] = [0; 128]
static mut f_x: [u64; 128] = [0; 128]
static mut f_y: [u64; 128] = [0; 128]
static mut f_tip: [u64; 128] = [0; 128]
static mut f_conf: [u64; 128] = [1; 128]
static mut f_press: [u64; 128] = [0; 128]
static mut f_width: [u64; 128] = [0; 128]

fn at(dev: u64, k: u64) -> usize {
    return (dev * MAX_F + k) as usize
}

fn count(dev: u64) -> u64 {
    if dev >= MAX_DEV { return 0 }
    return f_n[dev as usize]
}

fn id(dev: u64, k: u64) -> u64 { return f_id[at(dev, k)] }
fn x(dev: u64, k: u64) -> u64 { return f_x[at(dev, k)] }
fn y(dev: u64, k: u64) -> u64 { return f_y[at(dev, k)] }
fn tip(dev: u64, k: u64) -> u64 { return f_tip[at(dev, k)] }
fn confident(dev: u64, k: u64) -> u64 { return f_conf[at(dev, k)] }
fn pressure(dev: u64, k: u64) -> u64 { return f_press[at(dev, k)] }
fn width(dev: u64, k: u64) -> u64 { return f_width[at(dev, k)] }

fn drop_dev(dev: u64) {
    if dev >= MAX_DEV { return }
    f_n[dev as usize] = 0
    f_left[dev as usize] = 0
    f_open[dev as usize] = 0
}

fn append(dev: u64, from: u64, n: u64) {
    var k: u64 = 0
    while k < n {
        let d: u64 = f_n[dev as usize]
        if d >= MAX_F {
            return
        }
        let i: usize = at(dev, d)
        var cid: u64 = from + k
        if hidcontact.has_id() {
            cid = hidcontact.contact_id(from + k)
        }
        f_id[i] = cid
        f_x[i] = hidcontact.x(from + k)
        f_y[i] = hidcontact.y(from + k)
        f_tip[i] = hidcontact.tip(from + k)
        f_conf[i] = hidcontact.confident(from + k)
        f_press[i] = hidcontact.pressure(from + k)
        f_width[i] = hidcontact.width(from + k)
        f_n[dev as usize] = d + 1
        k = k + 1
    }
}

fn push(dev: u64, slots: u64) -> bool {
    if dev >= MAX_DEV { return false }
    let d: usize = dev as usize
    if !hidcontact.has_count() {
        f_n[d] = 0
        f_open[d] = 0
        append(dev, 0, slots)
        return true
    }
    let reported: u64 = hidcontact.reported()
    if f_open[d] != 0 && reported == 0 {
        var take: u64 = slots
        if take > f_left[d] {
            take = f_left[d]
        }
        append(dev, 0, take)
        f_left[d] = f_left[d] - take
        if f_left[d] == 0 {
            f_open[d] = 0
            return true
        }
        return false
    }
    f_n[d] = 0
    f_open[d] = 0
    if reported > slots {
        append(dev, 0, slots)
        f_left[d] = reported - slots
        f_open[d] = 1
        return false
    }
    append(dev, 0, reported)
    return true
}
