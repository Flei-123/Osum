fn slot_of(code: u64) -> u64 {
    if code >= 128 {
        return NO_SLOT
    }
    return (SLOT_OF[code as usize]) as u64
}

fn sym(lay: u64, slot: u64, level: u64) -> u64 {
    return (SYMS[((lay * SLOTS + slot) * LEVELS + level) as usize]) as u64
}
