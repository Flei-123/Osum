fn ru_altgr(code: u64) -> u64 {
    if code == 0x09 {
        return 0x20BD
    }
    if code == 0x56 {
        return 0x007C
    }
    return 0
}

fn altgr(lay: u64, code: u64) -> u64 {
    if lay == 2 {
        return uk_altgr(code)
    }
    if lay == 3 {
        return fr_altgr(code)
    }
    if lay == 4 {
        return es_altgr(code)
    }
    if lay == 5 {
        return it_altgr(code)
    }
    if lay == 6 {
        return ru_altgr(code)
    }
    return 0
}
