profile kernel

import bus.drvnull

export { InputOps, null_ops, KIND_NONE, KIND_PS2, KIND_I2C, KIND_COUNT }

const KIND_NONE: u64 = 0
const KIND_PS2: u64 = 1
const KIND_I2C: u64 = 2
const KIND_COUNT: u64 = 3

struct InputOps {
    present: fn(u64) -> bool,
    irq: fn(u64),
    poll: fn(u64),
    irqs: fn(u64) -> u64,
    polls: fn(u64) -> u64,
    kind: u64,
    tag: u64
}

fn null_ops() -> InputOps {
    return InputOps {
        present: drvnull.n_false,
        irq: drvnull.n_noop,
        poll: drvnull.n_noop,
        irqs: drvnull.n_zero,
        polls: drvnull.n_zero,
        kind: KIND_NONE,
        tag: 0
    }
}
