profile kernel

import drv.hid.kbdlay
import keymap.kbdnames
import drv.hid.kbdcomb

export { LEVEL_SHIFT, LEVEL_ALTGR, LEVEL_CAPS, level_of, has_slot, entry, plain_char, char_of, is_dead, dead_id }

const LEVEL_SHIFT: u64 = 1
const LEVEL_ALTGR: u64 = 2
const LEVEL_CAPS: u64 = 4

fn level_of(shift: bool, altgr: bool, caps: bool) -> u64 {
    var level: u64 = 0
    if shift {
        level = level | LEVEL_SHIFT
    }
    if altgr {
        level = level | LEVEL_ALTGR
    }
    if caps {
        level = level | LEVEL_CAPS
    }
    return level
}

fn has_slot(code: u64) -> bool {
    return kbdlay.slot_of(code) != kbdlay.NO_SLOT
}

fn entry(lay: u64, code: u64, shift: bool, altgr: bool, caps: bool) -> u64 {
    if lay >= kbdnames.COUNT {
        return 0
    }
    let slot: u64 = kbdlay.slot_of(code)
    if slot == kbdlay.NO_SLOT {
        return 0
    }
    return kbdlay.sym(lay, slot, level_of(shift, altgr, caps))
}

fn is_dead(e: u64) -> bool {
    return (e & kbdlay.DEAD_FLAG) != 0
}

fn dead_id(e: u64) -> u64 {
    return e & 0xFFFF
}

fn plain_char(e: u64) -> u64 {
    if is_dead(e) {
        return (kbdcomb.SPACING[dead_id(e) as usize]) as u64
    }
    return e
}

fn char_of(lay: u64, code: u64, shift: bool, altgr: bool, caps: bool) -> u64 {
    return plain_char(entry(lay, code, shift, altgr, caps))
}
