profile kernel

import drv.net.usbnet
import drv.net.netclass

export { ops }

fn init_ready(state: u64, u: u64, use_msix: bool, armed: bool, vec: u64) -> bool {
    return usbnet.ready_on(state, u)
}

fn ops() -> netclass.EthOps {
    var o: netclass.EthOps = netclass.null_ops()
    o.present = usbnet.present_on
    o.ready = usbnet.ready_on
    o.up = usbnet.up_on
    o.link_up = usbnet.up_on
    o.rx_frames = usbnet.rx_frames_on
    o.tx_frames = usbnet.tx_frames_on
    o.tx_drops = usbnet.tx_drops_on
    o.rx_octets = usbnet.rx_octets_on
    o.tx_octets = usbnet.tx_octets_on
    o.mac_at = usbnet.mac_at_on
    o.rx_take = usbnet.rx_take_on
    o.rx_recycle = usbnet.rx_recycle_on
    o.tx_room = usbnet.tx_room_on
    o.tx_frame = usbnet.tx_frame_on
    o.poll = usbnet.poll_on
    o.init = init_ready
    o.caps = netclass.CAP_POLL_ONLY
    o.tag = 0x74656e627375
    return o
}
