profile kernel

import serial
import wlan.iwl_le
import wlan.iwl_buf

export { check }

const CTXT_ADD: u64 = 1
const CTXT_MODIFY: u64 = 2
const PHY_LEN_V1: u64 = 36
const BAND_5: u64 = 0
const BAND_24: u64 = 1

fn fail(text: u64) -> bool {
    var tag: [u8; 16] = "fakefw: phy bad\0"
    serial.puts((&tag[0]) as u64)
    serial.put(32 as u8)
    serial.puts(text)
    serial.nl()
    return false
}

fn pass(channel: u64, band: u64, tx: u64, rx: u64) {
    var tag: [u8; 15] = "fakefw: phy ok\0"
    var s_c: [u8; 5] = " ch=\0"
    var s_b: [u8; 7] = " band=\0"
    var s_t: [u8; 5] = " tx=\0"
    var s_r: [u8; 5] = " rx=\0"
    serial.puts((&tag[0]) as u64)
    serial.put(32 as u8)
    serial.puts((&s_c[0]) as u64)
    serial.dec(channel)
    serial.puts((&s_b[0]) as u64)
    serial.dec(band)
    serial.puts((&s_t[0]) as u64)
    serial.dec(tx)
    serial.puts((&s_r[0]) as u64)
    serial.dec(rx)
    serial.nl()
}

fn channel_ok(band: u64, channel: u64) -> bool {
    if band == BAND_24 { return channel >= 1 && channel <= 14 }
    if band == BAND_5 { return channel >= 32 && channel <= 196 }
    return false
}

fn check(tb0: u64, total: u64) -> bool {
    var m_len: [u8; 11] = "bad length\0"
    var m_act: [u8; 11] = "bad action\0"
    var m_ch: [u8; 12] = "bad channel\0"
    var m_tx: [u8; 13] = "bad tx chain\0"
    var m_rx: [u8; 13] = "bad rx chain\0"
    let h: u64 = iwl_buf.HDR
    if total != h + PHY_LEN_V1 { return fail((&m_len[0]) as u64) }
    let action: u64 = iwl_le.ld32(tb0, h + 4)
    if action != CTXT_ADD && action != CTXT_MODIFY { return fail((&m_act[0]) as u64) }
    let band: u64 = iwl_le.ld8(tb0, h + 16)
    let channel: u64 = iwl_le.ld8(tb0, h + 17)
    if !channel_ok(band, channel) { return fail((&m_ch[0]) as u64) }
    let tx: u64 = iwl_le.ld32(tb0, h + 20)
    let rx: u64 = iwl_le.ld32(tb0, h + 24)
    if tx == 0 || tx > 7 { return fail((&m_tx[0]) as u64) }
    if ((rx >> 1) & 7) == 0 { return fail((&m_rx[0]) as u64) }
    pass(channel, band, tx, rx)
    return true
}
