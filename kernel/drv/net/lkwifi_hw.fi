profile kernel

import drv.net.iwl_fakeap
import drv.net.iwl_fakeap_frames
import libc.octets

export { call }

const HW_RESET: u64 = 1
const HW_TX: u64 = 2
const HW_RESP: u64 = 3
const HW_NETS: u64 = 4
const HW_BEACON: u64 = 5

fn resp(index: u64, dst: u64, room: u64) -> u64 {
    let len: u64 = iwl_fakeap.resp_len(index)
    if len > room { return 0 }
    octets.copy(dst, iwl_fakeap.resp_ptr(index), len)
    return len
}

fn call(op: u64, a: u64, b: u64, c: u64) -> u64 {
    if op == HW_RESET {
        iwl_fakeap.reset()
        return 0
    }
    if op == HW_TX { return iwl_fakeap.on_tx(a, b) }
    if op == HW_RESP { return resp(a, b, c) }
    if op == HW_NETS { return iwl_fakeap_frames.net_count() }
    if op == HW_BEACON { return iwl_fakeap_frames.beacon_build(a, b) }
    return 0
}
