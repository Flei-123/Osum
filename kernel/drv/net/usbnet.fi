// SPDX-License-Identifier: GPL-2.0-only
// kernel/drv/net/usbnet.fi -- USB CDC-ECM and RNDIS network interface (L-015, USB tethering; RNDIS = r811).
//
// WHAT THIS IS
//   The data plane of ONE CDC-ECM function behind xHCI. kernel/usb/usb.fi
//   enumerates the device, picks the ECM configuration, reads the MAC from
//   the string descriptor, selects the data alternate setting and hands the
//   slot + bulk endpoints to `attach` below. kernel/net/netdev.fi routes the
//   card calls (rx_take, tx_frame, ...) here as KIND_USBNET.
//
// DESIGN
//   ECM frames are raw Ethernet on the bulk pipes (no header).
//   RX: exactly ONE bulk-IN transfer is outstanding (ep_seq tells when it is
//       done, ep_resid how short). A finished frame is copied to a hold
//       buffer and the transfer is re-queued at once; the stack owns the hold
//       buffer until rx_recycle.
//   TX: synchronous xhci.bulk on the bulk-OUT pipe, plus a zero-length packet
//       when the frame is a multiple of the endpoint packet size.
//   The interrupt-IN (NETWORK_CONNECTION / SPEED_CHANGE) endpoint is not
//   used: the link is assumed up while the device is attached.
//
// RNDIS (r811): same pipes, but every frame sits behind a 44 byte PACKET_MSG header
//   (lib/usbnet/rndis.fi wrap_packet / packet_ok). usb.fi brings the function up on the control
//   pipe (INITIALIZE, permanent MAC, packet filter) and calls `attach_rndis`. One bulk-IN transfer may
//   carry several packets: the transfer stays "in use" (not re-queued) until the last packet is taken.
//
// NCM (r811): mode 2. Every frame travels in an NTB16 (lib/usbnet/ncm.fi): TX wraps ONE frame per NTB with the
//   divisor/remainder/alignment the device reported, RX walks the datagram list of each NTB (several per transfer
//   possible; the transfer is re-queued after the last one). usb.fi `ncm_start` does the bring-up.
//
// RNDIS control housekeeping (LW-1a): no interrupt endpoint is armed (usb.fi owns those for HID). Every
//   HOUSE_TICKS the driver sends one command on the control pipe (media-status QUERY, every third round a
//   host KEEPALIVE) and fetches the answer ~2 ticks later. A device keepalive or an indication found while
//   fetching is answered/applied (rndis.answer_keepalive / indicate_link / link_status_value). Three rounds
//   without any answer mark the function dead (link down). `link_on` 0 = unknown, 1 = up, 2 = down.
// Hot unplug (LW-1a): usb.fi `gone` calls `unplug_slot`; the card stays registered but not ready.
//
// NOT HERE: halted-endpoint recovery on the bulk pipes.

import lib.kstate
import serial
import mm.mem
import drv.usb.xhci
import usbnet.rndis
import usbnet.ncm
import usbnet.ch397

export {
    attach, attach_rndis, attach_ncm, attach_ch336, detach, unplug_slot, link_on, keepalives, exists, present_on, ready_on, up_on, mac_at_on,
    rx_take_on, rx_recycle_on, tx_room_on, tx_frame_on, poll_on,
    rx_frames_on, tx_frames_on, tx_drops_on, rx_octets_on, tx_octets_on,
    errors, MAX_UNITS, FRAME_MAX
}

const MAX_UNITS: u64 = 1
const FRAME_MAX: u64 = 1536
const RXBUF: u64 = 2048

// Pointer to the control block lives in the free tail of the netdev page
// (0x388..0x400, see kernel/net/netdev.fi).
const PTR_OFF: u64 = 0x388

// Control block cells (offsets into the frame run)
const C_SLOT: u64 = 0x00
const C_IN: u64 = 0x08
const C_OUT: u64 = 0x10
const C_MPS: u64 = 0x18
const C_MAC: u64 = 0x20
const C_READY: u64 = 0x28
const C_SEQ: u64 = 0x30
const C_HOLD: u64 = 0x38
const C_RXP: u64 = 0x40
const C_TXP: u64 = 0x48
const C_RXB: u64 = 0x50
const C_TXB: u64 = 0x58
const C_DROP: u64 = 0x60
const C_ERR: u64 = 0x68
const C_MODE: u64 = 0x70 // 0 = CDC-ECM, 1 = RNDIS, 2 = CDC-NCM, 3 = WCH CH336
const C_RXOFF: u64 = 0x78 // RNDIS: next packet inside the RX transfer
const C_RXLEN: u64 = 0x80 // RNDIS: octets of the RX transfer still being unpacked (0 = none)
const C_NDIV: u64 = 0x88 // NCM: device OUT divisor / remainder / alignment / max NTB size
const C_NREM: u64 = 0x90
const C_NALIGN: u64 = 0x98
const C_NOUTMAX: u64 = 0xA0
const C_NSEQ: u64 = 0xA8 // NCM: next NTH sequence number
const C_IFACE: u64 = 0xB0 // RNDIS: control interface number
const C_NEXT: u64 = 0xB8 // RNDIS: tick of the next housekeeping step
const C_PEND: u64 = 0xC0 // RNDIS: 0 idle, 1 query sent, 2 keepalive sent
const C_LINK: u64 = 0xC8 // 0 unknown, 1 up, 2 down
const C_KAS: u64 = 0xD0 // RNDIS: keepalive completions received
const C_KAA: u64 = 0xD8 // RNDIS: device keepalives answered
const C_MISS: u64 = 0xE0 // RNDIS: rounds without an answer
const C_CID: u64 = 0xE8 // RNDIS: request id counter
const C_ROUND: u64 = 0xF0 // RNDIS: housekeeping round counter
const CMD_OFF: u64 = 0x200
const RSP_OFF: u64 = 0x300
const HOUSE_TICKS: u64 = 300
const FETCH_TICKS: u64 = 2
const MISS_MAX: u64 = 3
const CTL_OUT: u64 = 0x21
const CTL_IN: u64 = 0xA1
const RXA_OFF: u64 = 0x800
const HOLD_OFF: u64 = 0x1000
const TX_OFF: u64 = 0x1800

fn blk(state: u64) -> u64 {
    return kstate.get(state, kstate.NETDEV_OFF + PTR_OFF)
}

fn cg(state: u64, off: u64) -> u64 {
    let b: u64 = blk(state)
    if b == 0 {
        return 0
    }
    let p: *mut u64 = (b + off) as *mut u64
    return *p
}

fn cs(state: u64, off: u64, v: u64) {
    let b: u64 = blk(state)
    if b == 0 {
        return
    }
    let p: *mut u64 = (b + off) as *mut u64
    *p = v
}

fn copy(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        let s: *mut u8 = (src + i) as *mut u8
        let d: *mut u8 = (dst + i) as *mut u8
        *d = *s
        i = i + 1
    }
}

fn exists(state: u64) -> bool {
    return blk(state) != 0 && cg(state, C_READY) != 0
}

// Called by usb.fi once the function is configured. `mac` has the six
// octets little-endian in one word (octet 0 = lowest byte).
fn attach(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64) -> bool {
    return attach_mode(state, slot, indci, outdci, mps, mac, 0)
}

// r811: the RNDIS function (already initialised by usb.fi).
fn attach_rndis(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64, iface: u64) -> bool {
    if !attach_mode(state, slot, indci, outdci, mps, mac, 1) {
        return false
    }
    cs(state, C_IFACE, iface)
    cs(state, C_NEXT, ticks(state) + 50)
    return true
}

// LW-1a: WCH CH336/CH339/CH396/CH397 vendor-class function (lib/usbnet/ch397.fi framing, unverified on silicon).
fn attach_ch336(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64) -> bool {
    return attach_mode(state, slot, indci, outdci, mps, mac, 3)
}

// r811: the NCM function (already configured by usb.fi): `div/rem/align/outmax` are the device's NTB OUT rules.
fn attach_ncm(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64,
    div: u64, rem: u64, align: u64, outmax: u64) -> bool {
    if !attach_mode(state, slot, indci, outdci, mps, mac, 2) {
        return false
    }
    cs(state, C_NDIV, div)
    cs(state, C_NREM, rem)
    cs(state, C_NALIGN, align)
    cs(state, C_NOUTMAX, outmax)
    cs(state, C_NSEQ, 0)
    return true
}

fn attach_mode(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64,
    mode: u64) -> bool {
    var b: u64 = blk(state)
    if b == 0 {
        b = mem.frame_run(state, 2)
        if b == 0 {
            return false
        }
        kstate.set(state, kstate.NETDEV_OFF + PTR_OFF, b)
    }
    cs(state, C_SLOT, slot)
    cs(state, C_IN, indci)
    cs(state, C_OUT, outdci)
    cs(state, C_MPS, mps)
    cs(state, C_MAC, mac)
    cs(state, C_HOLD, 0)
    cs(state, C_RXP, 0)
    cs(state, C_TXP, 0)
    cs(state, C_RXB, 0)
    cs(state, C_TXB, 0)
    cs(state, C_DROP, 0)
    cs(state, C_ERR, 0)
    cs(state, C_MODE, mode)
    cs(state, C_RXOFF, 0)
    cs(state, C_RXLEN, 0)
    cs(state, C_IFACE, 0)
    cs(state, C_NEXT, 0)
    cs(state, C_PEND, 0)
    cs(state, C_LINK, 0)
    cs(state, C_KAS, 0)
    cs(state, C_KAA, 0)
    cs(state, C_MISS, 0)
    cs(state, C_CID, 100)
    cs(state, C_ROUND, 0)
    let i: u64 = xhci.ep_find(state, slot, indci)
    if i >= xhci.MAX_EP {
        return false
    }
    cs(state, C_SEQ, xhci.ep_seq(state, i))
    cs(state, C_READY, 1)
    return xhci.int_queue(state, slot, indci, b + RXA_OFF, RXBUF)
}

fn detach(state: u64) {
    cs(state, C_READY, 0)
}

fn ticks(state: u64) -> u64 {
    return kstate.get(state, kstate.TICKS)
}

fn say(msg: u64) {
    serial.puts(msg)
    serial.nl()
}

// LW-1a hot unplug: usb.fi `gone` calls this for every removed device. Only the function that owns `slot` is
// switched off; counters stay readable.
fn unplug_slot(state: u64, slot: u64) {
    var s_det: [u8; 17] = "usbnet: detached\0"
    if blk(state) == 0 || cg(state, C_READY) == 0 || cg(state, C_SLOT) != slot {
        return
    }
    cs(state, C_READY, 0)
    cs(state, C_HOLD, 0)
    cs(state, C_RXLEN, 0)
    cs(state, C_PEND, 0)
    say((&s_det[0]) as u64)
}

fn link_on(state: u64, u: u64) -> u64 {
    if u != 0 {
        return 0
    }
    return cg(state, C_LINK)
}

fn keepalives(state: u64) -> u64 {
    return cg(state, C_KAS) + cg(state, C_KAA)
}

fn link_set(state: u64, v: u64) {
    var s_up: [u8; 23] = "usbnet: rndis link up\0\0"
    var s_dn: [u8; 25] = "usbnet: rndis link down\0\0"
    if v == 0 || cg(state, C_LINK) == v {
        return
    }
    cs(state, C_LINK, v)
    if v == 1 {
        say((&s_up[0]) as u64)
    } else {
        say((&s_dn[0]) as u64)
    }
}

fn ctl_send(state: u64, n: u64) -> bool {
    return xhci.control(state, cg(state, C_SLOT), CTL_OUT, 0x00, 0, cg(state, C_IFACE), n,
        blk(state) + CMD_OFF, false) >= 0
}

fn house_miss(state: u64) {
    var s_dead: [u8; 19] = "usbnet: rndis dead\0"
    let m: u64 = cg(state, C_MISS) + 1
    cs(state, C_MISS, m)
    if m == MISS_MAX {
        cs(state, C_LINK, 2)
        say((&s_dead[0]) as u64)
    }
}

fn house_msg(state: u64, p: u64, n: u64) {
    var s_ka: [u8; 28] = "usbnet: rndis keepalive ok\0\0"
    var s_kd: [u8; 31] = "usbnet: rndis keepalive answer\0"
    let t: u64 = rndis.msg_type(p, n)
    cs(state, C_MISS, 0)
    if t == rndis.MSG_QUERY_C {
        link_set(state, rndis.link_status_value(p, n))
    } else if t == rndis.MSG_KEEPALIVE_C {
        cs(state, C_KAS, cg(state, C_KAS) + 1)
        if cg(state, C_KAS) == 1 {
            say((&s_ka[0]) as u64)
        }
        if cg(state, C_LINK) == 2 {
            link_set(state, 1)
        }
    } else if t == rndis.MSG_KEEPALIVE {
        let k: u64 = rndis.answer_keepalive(p, n, blk(state) + CMD_OFF)
        if k != 0 && ctl_send(state, k) {
            cs(state, C_KAA, cg(state, C_KAA) + 1)
            say((&s_kd[0]) as u64)
        }
    } else if t == rndis.MSG_INDICATE {
        link_set(state, rndis.indicate_link(p, n))
    }
}

fn house(state: u64) {
    let now: u64 = ticks(state)
    if now < cg(state, C_NEXT) {
        return
    }
    let b: u64 = blk(state)
    if cg(state, C_PEND) == 0 {
        let id: u64 = cg(state, C_CID) + 1
        let round: u64 = cg(state, C_ROUND)
        cs(state, C_CID, id)
        cs(state, C_ROUND, round + 1)
        var n: u64 = 0
        var kind: u64 = 1
        let c: u64 = b + CMD_OFF
        var i: u64 = 0
        while i < 8 {
            let z: *mut u64 = (c + i * 8) as *mut u64
            *z = 0
            i = i + 1
        }
        if round % 3 == 2 {
            n = rndis.build_keepalive(c, id)
            kind = 2
        } else {
            n = rndis.build_query(c, id, rndis.OID_GEN_MEDIA_CONNECT_STATUS)
        }
        if !ctl_send(state, n) {
            house_miss(state)
            cs(state, C_NEXT, now + HOUSE_TICKS)
            return
        }
        cs(state, C_PEND, kind)
        cs(state, C_NEXT, now + FETCH_TICKS)
        return
    }
    cs(state, C_PEND, 0)
    cs(state, C_NEXT, now + HOUSE_TICKS)
    let r: u64 = b + RSP_OFF
    var j: u64 = 0
    while j < 16 {
        let z: *mut u64 = (r + j * 8) as *mut u64
        *z = 0
        j = j + 1
    }
    let got: i64 = xhci.control(state, cg(state, C_SLOT), CTL_IN, 0x01, 0, cg(state, C_IFACE), 128, r, true)
    if got < 12 {
        house_miss(state)
        return
    }
    house_msg(state, r, got as u64)
}

fn present_on(state: u64, u: u64) -> bool {
    return u == 0 && blk(state) != 0
}

fn ready_on(state: u64, u: u64) -> bool {
    return u == 0 && exists(state)
}

fn up_on(state: u64, u: u64) -> bool {
    return ready_on(state, u) && cg(state, C_LINK) != 2
}

fn mac_at_on(state: u64, u: u64, i: u64) -> u64 {
    if i >= 6 {
        return 0
    }
    return (cg(state, C_MAC) >> (i * 8)) & 0xFF
}

fn requeue(state: u64) {
    xhci.int_queue(state, cg(state, C_SLOT), cg(state, C_IN),
        blk(state) + RXA_OFF, RXBUF)
}

fn poll_on(state: u64, u: u64) -> bool {
    if !ready_on(state, u) {
        return false
    }
    xhci.drain(state)
    if cg(state, C_MODE) == 1 {
        house(state)
    }
    if cg(state, C_HOLD) != 0 {
        return false
    }
    if cg(state, C_RXLEN) != 0 {
        return true
    }
    let i: u64 = xhci.ep_find(state, cg(state, C_SLOT), cg(state, C_IN))
    if i >= xhci.MAX_EP {
        return false
    }
    return xhci.ep_seq(state, i) != cg(state, C_SEQ)
}

fn rx_take_on(state: u64, u: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    // The stack takes frames through here (netdev.poll_on has no caller outside the S3 resume path), so the
    // RNDIS housekeeping (media-status query, host keepalive, dead-link count) has to run from this entry too.
    if cg(state, C_MODE) == 1 {
        house(state)
    }
    if cg(state, C_HOLD) != 0 {
        return 0
    }
    if cg(state, C_RXLEN) != 0 {
        if cg(state, C_MODE) == 2 {
            return ncm_next(state, frame, slot)
        }
        if cg(state, C_MODE) == 3 {
            return ch_next(state, frame, slot)
        }
        return rndis_next(state, frame, slot)
    }
    xhci.drain(state)
    let i: u64 = xhci.ep_find(state, cg(state, C_SLOT), cg(state, C_IN))
    if i >= xhci.MAX_EP {
        return 0
    }
    let seq: u64 = xhci.ep_seq(state, i)
    if seq == cg(state, C_SEQ) {
        return 0
    }
    cs(state, C_SEQ, seq)
    let code: u64 = xhci.ep_code(state, i)
    let resid: u64 = xhci.ep_resid(state, i)
    if code != xhci.CC_SUCCESS && code != xhci.CC_SHORT {
        cs(state, C_ERR, cg(state, C_ERR) + 1)
        requeue(state)
        return 0
    }
    if resid >= RXBUF {
        requeue(state)
        return 0
    }
    let n: u64 = RXBUF - resid
    if cg(state, C_MODE) == 1 {
        cs(state, C_RXOFF, 0)
        cs(state, C_RXLEN, n)
        return rndis_next(state, frame, slot)
    }
    if cg(state, C_MODE) == 3 {
        cs(state, C_RXOFF, 0)
        cs(state, C_RXLEN, n)
        return ch_next(state, frame, slot)
    }
    if cg(state, C_MODE) == 2 {
        if !ncm.ntb_ok(blk(state) + RXA_OFF, n) {
            cs(state, C_ERR, cg(state, C_ERR) + 1)
            requeue(state)
            return 0
        }
        cs(state, C_RXOFF, 0) // datagram index inside the NTB
        cs(state, C_RXLEN, n)
        return ncm_next(state, frame, slot)
    }
    if n < 14 || n > FRAME_MAX {
        cs(state, C_ERR, cg(state, C_ERR) + 1)
        requeue(state)
        return 0
    }
    let b: u64 = blk(state)
    copy(b + HOLD_OFF, b + RXA_OFF, n)
    requeue(state)
    cs(state, C_HOLD, 1)
    cs(state, C_RXP, cg(state, C_RXP) + 1)
    cs(state, C_RXB, cg(state, C_RXB) + n)
    *frame = b + HOLD_OFF
    *slot = 0
    return n
}

// r811: take the next PACKET_MSG out of the RNDIS transfer in the RX buffer. A malformed packet drops the rest
// of the transfer. The transfer is re-queued after the last packet.
fn rndis_next(state: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    let b: u64 = blk(state)
    let off: u64 = cg(state, C_RXOFF)
    let len: u64 = cg(state, C_RXLEN)
    if off >= len {
        cs(state, C_RXLEN, 0)
        requeue(state)
        return 0
    }
    let p: u64 = b + RXA_OFF + off
    let left: u64 = len - off
    if !rndis.packet_ok(p, left) {
        cs(state, C_ERR, cg(state, C_ERR) + 1)
        cs(state, C_RXLEN, 0)
        requeue(state)
        return 0
    }
    let l: u64 = rndis.msg_len(p, left)
    let dl: u64 = rndis.packet_data_len(p, left)
    let doff: u64 = rndis.packet_data_off(p, left)
    cs(state, C_RXOFF, off + l)
    if off + l >= len {
        cs(state, C_RXLEN, 0)
        requeue(state)
    }
    if dl > FRAME_MAX {
        cs(state, C_ERR, cg(state, C_ERR) + 1)
        return 0
    }
    copy(b + HOLD_OFF, p + doff, dl)
    cs(state, C_HOLD, 1)
    cs(state, C_RXP, cg(state, C_RXP) + 1)
    cs(state, C_RXB, cg(state, C_RXB) + dl)
    *frame = b + HOLD_OFF
    *slot = 0
    return dl
}

// r811: take the next datagram out of the NTB in the RX buffer. A bad entry is skipped (counted); the transfer is
// re-queued after the last entry, and only AFTER the datagram was copied out of the RX buffer.
fn ncm_next(state: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    let b: u64 = blk(state)
    let p: u64 = b + RXA_OFF
    let len: u64 = cg(state, C_RXLEN)
    let cnt: u64 = ncm.ntb_count(p, len)
    var idx: u64 = cg(state, C_RXOFF)
    while idx < cnt {
        let off: u64 = ncm.ntb_dg_off(p, len, idx)
        let dl: u64 = ncm.ntb_dg_len(p, len, idx)
        idx = idx + 1
        if off == 0 || dl > FRAME_MAX {
            cs(state, C_ERR, cg(state, C_ERR) + 1)
        } else {
            copy(b + HOLD_OFF, p + off, dl)
            cs(state, C_RXOFF, idx)
            if idx >= cnt {
                cs(state, C_RXLEN, 0)
                requeue(state)
            }
            cs(state, C_HOLD, 1)
            cs(state, C_RXP, cg(state, C_RXP) + 1)
            cs(state, C_RXB, cg(state, C_RXB) + dl)
            *frame = b + HOLD_OFF
            *slot = 0
            return dl
        }
    }
    cs(state, C_RXLEN, 0)
    requeue(state)
    return 0
}

// LW-1a: take the next frame out of a CH336 bulk transfer ([len u32][4 octets][frame][pad to 4]...). The transfer is
// re-queued after the last frame, and only after the frame was copied out of the RX buffer.
fn ch_next(state: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    let b: u64 = blk(state)
    let p: u64 = b + RXA_OFF
    let off: u64 = cg(state, C_RXOFF)
    let len: u64 = cg(state, C_RXLEN)
    if off + 8 > len {
        cs(state, C_RXLEN, 0)
        requeue(state)
        return 0
    }
    let fl: u64 = ch397.rx_frame_len(p, len as usize, off as usize) as u64
    if fl == 0 {
        cs(state, C_ERR, cg(state, C_ERR) + 1)
        cs(state, C_RXLEN, 0)
        requeue(state)
        return 0
    }
    let fo: u64 = ch397.rx_frame_off(off as usize) as u64
    let nx: u64 = ch397.rx_next(p, len as usize, off as usize) as u64
    copy(b + HOLD_OFF, p + fo, fl)
    cs(state, C_RXOFF, nx)
    if nx == 0 || nx + 8 > len {
        cs(state, C_RXLEN, 0)
        requeue(state)
    }
    cs(state, C_HOLD, 1)
    cs(state, C_RXP, cg(state, C_RXP) + 1)
    cs(state, C_RXB, cg(state, C_RXB) + fl)
    *frame = b + HOLD_OFF
    *slot = 0
    return fl
}

fn rx_recycle_on(state: u64, u: u64, id: u64) {
    cs(state, C_HOLD, 0)
}

fn tx_room_on(state: u64, u: u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    return 1
}

fn tx_frame_on(state: u64, u: u64, src: u64, n: u64) -> bool {
    if !ready_on(state, u) || n == 0 || n > FRAME_MAX {
        return false
    }
    let b: u64 = blk(state)
    var tn: u64 = n
    if cg(state, C_MODE) == 1 {
        tn = rndis.wrap_packet(b + TX_OFF, src, n)
    } else if cg(state, C_MODE) == 3 {
        tn = ch397.tx_wrap(src, n as usize, b + TX_OFF) as u64
        if tn == 0 {
            cs(state, C_DROP, cg(state, C_DROP) + 1)
            return false
        }
    } else if cg(state, C_MODE) == 2 {
        var cap: u64 = 0x800
        if cg(state, C_NOUTMAX) < cap {
            cap = cg(state, C_NOUTMAX)
        }
        let sq: u64 = cg(state, C_NSEQ)
        cs(state, C_NSEQ, (sq + 1) & 0xFFFF)
        tn = ncm.wrap_frame(b + TX_OFF, cap, sq, src, n, cg(state, C_NDIV), cg(state, C_NREM),
            cg(state, C_NALIGN))
        if tn == 0 {
            cs(state, C_DROP, cg(state, C_DROP) + 1)
            return false
        }
    } else {
        copy(b + TX_OFF, src, n)
    }
    let slot: u64 = cg(state, C_SLOT)
    let dci: u64 = cg(state, C_OUT)
    let r: i64 = xhci.bulk(state, slot, dci, b + TX_OFF, tn)
    if r < 0 {
        cs(state, C_DROP, cg(state, C_DROP) + 1)
        return false
    }
    let mps: u64 = cg(state, C_MPS)
    if mps != 0 && (tn % mps) == 0 {
        // terminate the transfer with a zero-length packet
        xhci.bulk(state, slot, dci, b + TX_OFF, 0)
    }
    cs(state, C_TXP, cg(state, C_TXP) + 1)
    cs(state, C_TXB, cg(state, C_TXB) + n)
    return true
}

fn rx_frames_on(state: u64, u: u64) -> u64 { return cg(state, C_RXP) }
fn tx_frames_on(state: u64, u: u64) -> u64 { return cg(state, C_TXP) }
fn tx_drops_on(state: u64, u: u64) -> u64 { return cg(state, C_DROP) }
fn rx_octets_on(state: u64, u: u64) -> u64 { return cg(state, C_RXB) }
fn tx_octets_on(state: u64, u: u64) -> u64 { return cg(state, C_TXB) }
fn errors(state: u64) -> u64 { return cg(state, C_ERR) }
