// SPDX-License-Identifier: GPL-2.0-only
// kernel/drv/net/usbnet.fi -- USB CDC-ECM and RNDIS network interface (L-015, USB tethering; RNDIS = r811).
//
// WHAT THIS IS
//   The data plane of ONE CDC-ECM function behind xHCI. kernel/usb/usb.fi
//   enumerates the device, picks the ECM configuration, reads the MAC from
//   the string descriptor, selects the data alternate setting and hands the
//   slot + bulk endpoints to `attach` below. kernel/net/netdev.fi routes the
//   card calls (rx_take, tx_frame, ...) here as KIND_USBNET.
//
// DESIGN
//   ECM frames are raw Ethernet on the bulk pipes (no header).
//   RX: exactly ONE bulk-IN transfer is outstanding (ep_seq tells when it is
//       done, ep_resid how short). A finished frame is copied to a hold
//       buffer and the transfer is re-queued at once; the stack owns the hold
//       buffer until rx_recycle.
//   TX: synchronous xhci.bulk on the bulk-OUT pipe, plus a zero-length packet
//       when the frame is a multiple of the endpoint packet size.
//   The interrupt-IN (NETWORK_CONNECTION / SPEED_CHANGE) endpoint is not
//   used: the link is assumed up while the device is attached.
//
// RNDIS (r811): same pipes, but every frame sits behind a 44 byte PACKET_MSG header
//   (lib/usbnet/rndis.fi wrap_packet / packet_ok). usb.fi brings the function up on the control
//   pipe (INITIALIZE, permanent MAC, packet filter) and calls `attach_rndis`. One bulk-IN transfer may
//   carry several packets: the transfer stays "in use" (not re-queued) until the last packet is taken.
//
// NCM (r811): mode 2. Every frame travels in an NTB16 (lib/usbnet/ncm.fi): TX wraps ONE frame per NTB with the
//   divisor/remainder/alignment the device reported, RX walks the datagram list of each NTB (several per transfer
//   possible; the transfer is re-queued after the last one). usb.fi `ncm_start` does the bring-up.
//
// RNDIS control housekeeping (LW-1a): no interrupt endpoint is armed (usb.fi owns those for HID). Every
//   HOUSE_TICKS the driver sends one command on the control pipe (media-status QUERY, every third round a
//   host KEEPALIVE) and fetches the answer ~2 ticks later. A device keepalive or an indication found while
//   fetching is answered/applied (rndis.answer_keepalive / indicate_link / link_status_value). Three rounds
//   without any answer mark the function dead (link down). `link_on` 0 = unknown, 1 = up, 2 = down.
// Hot unplug (LW-1a): usb.fi `gone` calls `unplug_slot`; the card stays registered but not ready.
//
// NOT HERE: halted-endpoint recovery on the bulk pipes.

import lib.kstate
import serial
import mm.mem
import drv.usb.xhci
import usbnet.rndis
import usbnet.ncm
import usbnet.ch397
import usbnet.ax88772
import usbnet.ax88179
import usbnet.ax88179_drv
import usbnet.rtl8153
import usbnet.rtl8153_drv
import usbnet.le
import drv.net.ch336

export {
    attach, attach_rndis, attach_ncm, attach_ch336, attach_ax88772, attach_ax88179, attach_rtl8153, detach, unplug_slot, owner_slot, link_on, keepalives, exists, present_on, ready_on, up_on, mac_at_on,
    rx_take_on, rx_recycle_on, tx_room_on, tx_frame_on, poll_on,
    rx_frames_on, tx_frames_on, tx_drops_on, rx_octets_on, tx_octets_on,
    errors, err_kind, err_cc, MAX_UNITS, FRAME_MAX, ch_bringup, mode_get, tx_diag, ch_link, ch_bmsr, ch_cfg, ch_fw, ch_changes, ch_phy, ch_intr
}

const MAX_UNITS: u64 = 1
const FRAME_MAX: u64 = 1536
const RXBUF: u64 = 2048

// Pointer to the control block lives in the free tail of the netdev page
// (0x388..0x400, see kernel/net/netdev.fi).
const PTR_OFF: u64 = 0x388

// Control block cells (offsets into the frame run)
const C_SLOT: u64 = 0x00
const C_IN: u64 = 0x08
const C_OUT: u64 = 0x10
const C_MPS: u64 = 0x18
const C_MAC: u64 = 0x20
const C_READY: u64 = 0x28
const C_SEQ: u64 = 0x30
const C_HOLD: u64 = 0x38
const C_RXP: u64 = 0x40
const C_TXP: u64 = 0x48
const C_RXB: u64 = 0x50
const C_TXB: u64 = 0x58
const C_DROP: u64 = 0x60
const C_ERR: u64 = 0x68
const C_MODE: u64 = 0x70 // 0 = CDC-ECM, 1 = RNDIS, 2 = CDC-NCM, 4 = ASIX AX88772, 3 = WCH CH336
const C_RXOFF: u64 = 0x78 // RNDIS: next packet inside the RX transfer
const C_RXLEN: u64 = 0x80 // RNDIS: octets of the RX transfer still being unpacked (0 = none)
const C_NDIV: u64 = 0x88 // NCM: device OUT divisor / remainder / alignment / max NTB size
const C_NREM: u64 = 0x90
const C_NALIGN: u64 = 0x98
const C_NOUTMAX: u64 = 0xA0
const C_NSEQ: u64 = 0xA8 // NCM: next NTH sequence number
const C_IFACE: u64 = 0xB0 // RNDIS: control interface number
const C_NEXT: u64 = 0xB8 // RNDIS: tick of the next housekeeping step
const C_PEND: u64 = 0xC0 // RNDIS: 0 idle, 1 query sent, 2 keepalive sent
const C_LINK: u64 = 0xC8 // 0 unknown, 1 up, 2 down
const C_KAS: u64 = 0xD0 // RNDIS: keepalive completions received
const C_KAA: u64 = 0xD8 // RNDIS: device keepalives answered
const C_MISS: u64 = 0xE0 // RNDIS: rounds without an answer
const C_CID: u64 = 0xE8 // RNDIS: request id counter
const C_ROUND: u64 = 0xF0 // RNDIS: housekeeping round counter
const C_CARRY: u64 = 0xF8
const C_SKIP: u64 = 0x100
const C_ERRK: u64 = 0x108
const C_ERRCC: u64 = 0x110
const C_TXRC: u64 = 0x1E0
const C_TXFAIL: u64 = 0x1E8
const C_TXHALT: u64 = 0x1F0
const C_TXEPST: u64 = 0x1F8
const CH_BASE: u64 = 0x2800
const C_BIG: u64 = 0x400
const C_RXN: u64 = 0x408
const C_RXIDX: u64 = 0x410
const C_FAM: u64 = 0x418
const C_USBSPD: u64 = 0x420
const C_VLINK: u64 = 0x428
const C_VNEXT: u64 = 0x430
const RES_OFF: u64 = 0x440
const RES2_OFF: u64 = 0x480
const BIG_FRAMES: u64 = 16
const VHOUSE_FAST: u64 = 100
const VHOUSE_SLOW: u64 = 300
const MODE_AX179: u64 = 5
const MODE_RTL: u64 = 6
const CMD_OFF: u64 = 0x200
const RSP_OFF: u64 = 0x300
const HOUSE_TICKS: u64 = 300
const FETCH_TICKS: u64 = 2
const MISS_MAX: u64 = 3
const CTL_OUT: u64 = 0x21
const CTL_IN: u64 = 0xA1
const RXA_OFF: u64 = 0x800
const HOLD_OFF: u64 = 0x1000
const TX_OFF: u64 = 0x1800

fn blk(state: u64) -> u64 {
    return kstate.get(state, kstate.NETDEV_OFF + PTR_OFF)
}

fn cg(state: u64, off: u64) -> u64 {
    let b: u64 = blk(state)
    if b == 0 {
        return 0
    }
    let p: *mut u64 = (b + off) as *mut u64
    return *p
}

fn cs(state: u64, off: u64, v: u64) {
    let b: u64 = blk(state)
    if b == 0 {
        return
    }
    let p: *mut u64 = (b + off) as *mut u64
    *p = v
}

fn copy(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        let s: *mut u8 = (src + i) as *mut u8
        let d: *mut u8 = (dst + i) as *mut u8
        *d = *s
        i = i + 1
    }
}

fn exists(state: u64) -> bool {
    return blk(state) != 0 && cg(state, C_READY) != 0
}

// Called by usb.fi once the function is configured. `mac` has the six
// octets little-endian in one word (octet 0 = lowest byte).
fn attach(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64) -> bool {
    return attach_mode(state, slot, indci, outdci, mps, mac, 0)
}

// r811: the RNDIS function (already initialised by usb.fi).
fn attach_rndis(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64, iface: u64) -> bool {
    if !attach_mode(state, slot, indci, outdci, mps, mac, 1) {
        return false
    }
    cs(state, C_IFACE, iface)
    cs(state, C_NEXT, ticks(state) + 50)
    return true
}

// LW-1a: WCH CH336/CH339/CH396/CH397 vendor-class function (lib/usbnet/ch397.fi framing, unverified on silicon).
fn attach_ch336(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64) -> bool {
    if !attach_mode(state, slot, indci, outdci, mps, mac, 3) {
        return false
    }
    cs(state, C_TXRC, 0)
    cs(state, C_TXFAIL, 0)
    cs(state, C_TXHALT, 0)
    cs(state, C_TXEPST, 0)
    return true
}

fn tx_diag(state: u64, which: u64) -> u64 {
    if which == 0 { return cg(state, C_TXRC) }
    if which == 1 { return cg(state, C_TXFAIL) }
    if which == 2 { return cg(state, C_TXHALT) }
    return cg(state, C_TXEPST)
}

fn tx_recover(state: u64, slot: u64, dci: u64) -> bool {
    cs(state, C_TXEPST, xhci.ep_state(state, slot, dci))
    let i: u64 = xhci.ep_find(state, slot, dci)
    if i >= xhci.MAX_EP {
        return false
    }
    if !xhci.ep_halted(state, slot, dci) {
        return false
    }
    xhci.reset_endpoint(state, slot, dci)
    xhci.set_dequeue(state, slot, dci, i)
    cs(state, C_TXHALT, cg(state, C_TXHALT) + 1)
    return true
}

// r1607: ASIX AX88772/772B (lib/usbnet/ax88772.fi framing and ax88772_drv.fi bring-up, unverified on silicon).
fn attach_ax88772(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64) -> bool {
    return attach_mode(state, slot, indci, outdci, mps, mac, 4)
}

fn attach_ax88179(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64, speed: u64) -> bool {
    if !attach_mode(state, slot, indci, outdci, mps, mac, MODE_AX179) {
        return false
    }
    cs(state, C_USBSPD, speed)
    vlink_reset(state)
    vhouse(state)
    return true
}

fn attach_rtl8153(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64, family: u64, speed: u64) -> bool {
    if !attach_mode(state, slot, indci, outdci, mps, mac, MODE_RTL) {
        return false
    }
    cs(state, C_FAM, family)
    cs(state, C_USBSPD, speed)
    vlink_reset(state)
    vhouse(state)
    return true
}

// r811: the NCM function (already configured by usb.fi): `div/rem/align/outmax` are the device's NTB OUT rules.
fn attach_ncm(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64,
    div: u64, rem: u64, align: u64, outmax: u64) -> bool {
    if !attach_mode(state, slot, indci, outdci, mps, mac, 2) {
        return false
    }
    cs(state, C_NDIV, div)
    cs(state, C_NREM, rem)
    cs(state, C_NALIGN, align)
    cs(state, C_NOUTMAX, outmax)
    cs(state, C_NSEQ, 0)
    return true
}

fn big_alloc(state: u64) -> bool {
    if cg(state, C_BIG) != 0 {
        return true
    }
    let r: u64 = mem.frame_run(state, BIG_FRAMES)
    if r == 0 {
        return false
    }
    var base: u64 = r
    let up: u64 = (r + 0xFFFF) & 0xFFFFFFFFFFFF0000
    if up + ax88179.RX_BUF_MAX <= r + BIG_FRAMES * 4096 {
        base = up
    }
    cs(state, C_BIG, base)
    return true
}

fn say_second() {
    var s_two: [u8; 31] = "usbnet: second adapter ignored\0"
    say((&s_two[0]) as u64)
}

fn attach_mode(state: u64, slot: u64, indci: u64, outdci: u64, mps: u64, mac: u64,
    mode: u64) -> bool {
    var b: u64 = blk(state)
    if b != 0 && cg(state, C_READY) != 0 && cg(state, C_SLOT) != slot {
        say_second()
        return false
    }
    if b == 0 {
        b = mem.frame_run(state, 3)
        if b == 0 {
            return false
        }
        kstate.set(state, kstate.NETDEV_OFF + PTR_OFF, b)
    }
    cs(state, C_SLOT, slot)
    cs(state, C_IN, indci)
    cs(state, C_OUT, outdci)
    cs(state, C_MPS, mps)
    cs(state, C_MAC, mac)
    cs(state, C_HOLD, 0)
    cs(state, C_RXP, 0)
    cs(state, C_TXP, 0)
    cs(state, C_RXB, 0)
    cs(state, C_TXB, 0)
    cs(state, C_DROP, 0)
    cs(state, C_ERR, 0)
    cs(state, C_ERRK, 0)
    cs(state, C_ERRCC, 0)
    cs(state, C_MODE, mode)
    cs(state, C_RXOFF, 0)
    cs(state, C_RXLEN, 0)
    cs(state, C_IFACE, 0)
    cs(state, C_NEXT, 0)
    cs(state, C_PEND, 0)
    cs(state, C_LINK, 0)
    cs(state, C_KAS, 0)
    cs(state, C_KAA, 0)
    cs(state, C_MISS, 0)
    cs(state, C_CID, 100)
    cs(state, C_ROUND, 0)
    cs(state, C_CARRY, 0)
    cs(state, C_SKIP, 0)
    let i: u64 = xhci.ep_find(state, slot, indci)
    if i >= xhci.MAX_EP {
        return false
    }
    cs(state, C_SEQ, xhci.ep_seq(state, i))
    cs(state, C_RXN, 0)
    cs(state, C_RXIDX, 0)
    if mode >= MODE_AX179 {
        if !big_alloc(state) {
            return false
        }
        cs(state, C_RXN, big_len(mode))
    }
    cs(state, C_READY, 1)
    return xhci.int_queue(state, slot, indci, rx_base(state), rx_len(state))
}

fn big_len(mode: u64) -> u64 {
    if mode == MODE_AX179 {
        return ax88179.RX_BUF_MAX
    }
    return rtl8153.RX_BUF_MAX
}

fn rx_len(state: u64) -> u64 {
    let n: u64 = cg(state, C_RXN)
    if n == 0 {
        return RXBUF
    }
    return n
}

fn rx_base(state: u64) -> u64 {
    let m: u64 = cg(state, C_MODE)
    if m >= MODE_AX179 {
        return cg(state, C_BIG)
    }
    if m == 3 {
        return blk(state) + CH_BASE
    }
    return blk(state) + RXA_OFF
}

fn detach(state: u64) {
    cs(state, C_READY, 0)
}

fn ticks(state: u64) -> u64 {
    return kstate.get(state, kstate.TICKS)
}

fn say(msg: u64) {
    serial.puts(msg)
    serial.nl()
}

// LW-1a hot unplug: usb.fi `gone` calls this for every removed device. Only the function that owns `slot` is
// switched off; counters stay readable.
fn unplug_slot(state: u64, slot: u64) {
    var s_det: [u8; 17] = "usbnet: detached\0"
    if blk(state) == 0 || cg(state, C_READY) == 0 || cg(state, C_SLOT) != slot {
        return
    }
    cs(state, C_READY, 0)
    cs(state, C_HOLD, 0)
    cs(state, C_RXLEN, 0)
    cs(state, C_PEND, 0)
    say((&s_det[0]) as u64)
}

fn owner_slot(state: u64) -> u64 {
    if blk(state) == 0 || cg(state, C_READY) == 0 {
        return 0
    }
    return cg(state, C_SLOT)
}

fn link_on(state: u64, u: u64) -> u64 {
    if u != 0 {
        return 0
    }
    return cg(state, C_LINK)
}

fn keepalives(state: u64) -> u64 {
    return cg(state, C_KAS) + cg(state, C_KAA)
}

fn link_set(state: u64, v: u64) {
    var s_up: [u8; 23] = "usbnet: rndis link up\0\0"
    var s_dn: [u8; 25] = "usbnet: rndis link down\0\0"
    if v == 0 || cg(state, C_LINK) == v {
        return
    }
    cs(state, C_LINK, v)
    if v == 1 {
        say((&s_up[0]) as u64)
    } else {
        say((&s_dn[0]) as u64)
    }
}

fn ctl_send(state: u64, n: u64) -> bool {
    return xhci.control(state, cg(state, C_SLOT), CTL_OUT, 0x00, 0, cg(state, C_IFACE), n,
        blk(state) + CMD_OFF, false) >= 0
}

fn house_miss(state: u64) {
    var s_dead: [u8; 19] = "usbnet: rndis dead\0"
    let m: u64 = cg(state, C_MISS) + 1
    cs(state, C_MISS, m)
    if m == MISS_MAX {
        cs(state, C_LINK, 2)
        say((&s_dead[0]) as u64)
    }
}

fn house_msg(state: u64, p: u64, n: u64) {
    var s_ka: [u8; 28] = "usbnet: rndis keepalive ok\0\0"
    var s_kd: [u8; 31] = "usbnet: rndis keepalive answer\0"
    let t: u64 = rndis.msg_type(p, n)
    cs(state, C_MISS, 0)
    if t == rndis.MSG_QUERY_C {
        link_set(state, rndis.link_status_value(p, n))
    } else if t == rndis.MSG_KEEPALIVE_C {
        cs(state, C_KAS, cg(state, C_KAS) + 1)
        if cg(state, C_KAS) == 1 {
            say((&s_ka[0]) as u64)
        }
        if cg(state, C_LINK) == 2 {
            link_set(state, 1)
        }
    } else if t == rndis.MSG_KEEPALIVE {
        let k: u64 = rndis.answer_keepalive(p, n, blk(state) + CMD_OFF)
        if k != 0 && ctl_send(state, k) {
            cs(state, C_KAA, cg(state, C_KAA) + 1)
            say((&s_kd[0]) as u64)
        }
    } else if t == rndis.MSG_INDICATE {
        link_set(state, rndis.indicate_link(p, n))
    }
}

fn house(state: u64) {
    let now: u64 = ticks(state)
    if now < cg(state, C_NEXT) {
        return
    }
    let b: u64 = blk(state)
    if cg(state, C_PEND) == 0 {
        let id: u64 = cg(state, C_CID) + 1
        let round: u64 = cg(state, C_ROUND)
        cs(state, C_CID, id)
        cs(state, C_ROUND, round + 1)
        var n: u64 = 0
        var kind: u64 = 1
        let c: u64 = b + CMD_OFF
        var i: u64 = 0
        while i < 8 {
            let z: *mut u64 = (c + i * 8) as *mut u64
            *z = 0
            i = i + 1
        }
        if round % 3 == 2 {
            n = rndis.build_keepalive(c, id)
            kind = 2
        } else {
            n = rndis.build_query(c, id, rndis.OID_GEN_MEDIA_CONNECT_STATUS)
        }
        if !ctl_send(state, n) {
            house_miss(state)
            cs(state, C_NEXT, now + HOUSE_TICKS)
            return
        }
        cs(state, C_PEND, kind)
        cs(state, C_NEXT, now + FETCH_TICKS)
        return
    }
    cs(state, C_PEND, 0)
    cs(state, C_NEXT, now + HOUSE_TICKS)
    let r: u64 = b + RSP_OFF
    var j: u64 = 0
    while j < 16 {
        let z: *mut u64 = (r + j * 8) as *mut u64
        *z = 0
        j = j + 1
    }
    let got: i64 = xhci.control(state, cg(state, C_SLOT), CTL_IN, 0x01, 0, cg(state, C_IFACE), 128, r, true)
    if got < 12 {
        house_miss(state)
        return
    }
    house_msg(state, r, got as u64)
}

fn present_on(state: u64, u: u64) -> bool {
    return u == 0 && blk(state) != 0
}

fn ready_on(state: u64, u: u64) -> bool {
    return u == 0 && exists(state)
}

fn up_on(state: u64, u: u64) -> bool {
    return ready_on(state, u) && cg(state, C_LINK) != 2
}

fn mac_at_on(state: u64, u: u64, i: u64) -> u64 {
    if i >= 6 {
        return 0
    }
    return (cg(state, C_MAC) >> (i * 8)) & 0xFF
}

fn requeue(state: u64) {
    xhci.int_queue(state, cg(state, C_SLOT), cg(state, C_IN), rx_base(state), rx_len(state))
}

fn mode_get(state: u64) -> u64 { return cg(state, C_MODE) }
fn ch_link(state: u64) -> u64 { return ch336.link(blk(state)) }
fn ch_bmsr(state: u64) -> u64 { return ch336.bmsr(blk(state)) }
fn ch_cfg(state: u64) -> u64 { return ch336.cfg(blk(state)) }
fn ch_fw(state: u64) -> u64 { return ch336.fw(blk(state)) }
fn ch_changes(state: u64) -> u64 { return ch336.changes(blk(state)) }

fn ch_phy(state: u64, which: u64) -> u64 {
    if blk(state) == 0 {
        return 0
    }
    if which == 0 { return ch336.bmcr(blk(state)) }
    if which == 1 { return ch336.phyid(blk(state)) }
    if which == 2 { return ch336.aner(blk(state)) }
    if which == 3 { return ch336.anar(blk(state)) }
    if which == 4 { return ch336.lpa(blk(state)) }
    if which == 5 { return ch336.kicks(blk(state)) }
    if which == 6 { return ch336.kick_rc(blk(state)) }
    return 0
}

fn ch_intr(state: u64, which: u64) -> u64 {
    if blk(state) == 0 {
        return 0
    }
    return ch336.intr_get(blk(state), which)
}

fn ch_house(state: u64) {
    if cg(state, C_MODE) != 3 {
        return
    }
    let r: u64 = ch336.house(state, blk(state), cg(state, C_SLOT), ticks(state))
    if r != 0 {
        cs(state, C_LINK, r)
    }
}

fn ch_bringup(state: u64, fwver: u64, intinfo: u64) -> bool {
    if !ch336.bringup(state, blk(state), cg(state, C_SLOT), fwver, intinfo) {
        return false
    }
    cs(state, C_LINK, ch336.link(blk(state)))
    return true
}

fn poll_on(state: u64, u: u64) -> bool {
    if !ready_on(state, u) {
        return false
    }
    xhci.drain(state)
    if cg(state, C_MODE) == 1 {
        house(state)
    }
    ch_house(state)
    vhouse(state)
    if cg(state, C_HOLD) != 0 {
        return false
    }
    if cg(state, C_RXLEN) != 0 {
        return true
    }
    let i: u64 = xhci.ep_find(state, cg(state, C_SLOT), cg(state, C_IN))
    if i >= xhci.MAX_EP {
        return false
    }
    return xhci.ep_seq(state, i) != cg(state, C_SEQ)
}

fn rx_take_on(state: u64, u: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    // The stack takes frames through here (netdev.poll_on has no caller outside the S3 resume path), so the
    // RNDIS housekeeping (media-status query, host keepalive, dead-link count) has to run from this entry too.
    if cg(state, C_MODE) == 1 {
        house(state)
    }
    ch_house(state)
    vhouse(state)
    if cg(state, C_HOLD) != 0 {
        return 0
    }
    if cg(state, C_RXLEN) != 0 {
        if cg(state, C_MODE) == MODE_AX179 {
            return axge_next(state, frame, slot)
        }
        if cg(state, C_MODE) == MODE_RTL {
            return rtl_next(state, frame, slot)
        }
        if cg(state, C_MODE) == 2 {
            return ncm_next(state, frame, slot)
        }
        if cg(state, C_MODE) == 3 {
            return ch_next(state, frame, slot)
        }
        if cg(state, C_MODE) == 4 {
            return ax_next(state, frame, slot)
        }
        return rndis_next(state, frame, slot)
    }
    xhci.drain(state)
    let i: u64 = xhci.ep_find(state, cg(state, C_SLOT), cg(state, C_IN))
    if i >= xhci.MAX_EP {
        return 0
    }
    let seq: u64 = xhci.ep_seq(state, i)
    if seq == cg(state, C_SEQ) {
        return 0
    }
    cs(state, C_SEQ, seq)
    let code: u64 = xhci.ep_code(state, i)
    let resid: u64 = xhci.ep_resid(state, i)
    if code != xhci.CC_SUCCESS && code != xhci.CC_SHORT {
        cs(state, C_ERRCC, code)
        err_note(state, 0)
        requeue(state)
        return 0
    }
    if resid >= rx_len(state) {
        requeue(state)
        return 0
    }
    let n: u64 = rx_len(state) - resid
    if cg(state, C_MODE) == MODE_AX179 {
        cs(state, C_RXOFF, 0)
        cs(state, C_RXIDX, 0)
        cs(state, C_RXLEN, n)
        return axge_next(state, frame, slot)
    }
    if cg(state, C_MODE) == MODE_RTL {
        cs(state, C_RXOFF, 0)
        cs(state, C_RXLEN, n)
        return rtl_next(state, frame, slot)
    }
    if cg(state, C_MODE) == 1 {
        cs(state, C_RXOFF, 0)
        cs(state, C_RXLEN, n)
        return rndis_next(state, frame, slot)
    }
    if cg(state, C_MODE) == 3 {
        var skip: u64 = cg(state, C_SKIP)
        if skip >= n {
            cs(state, C_SKIP, skip - n)
            requeue(state)
            return 0
        }
        cs(state, C_SKIP, 0)
        cs(state, C_RXOFF, skip)
        cs(state, C_RXLEN, cg(state, C_CARRY) + n)
        return ch_next(state, frame, slot)
    }
    if cg(state, C_MODE) == 4 {
        cs(state, C_RXOFF, 0)
        cs(state, C_RXLEN, n)
        return ax_next(state, frame, slot)
    }
    if cg(state, C_MODE) == 2 {
        if !ncm.ntb_ok(blk(state) + RXA_OFF, n) {
            err_note(state, 1)
            requeue(state)
            return 0
        }
        cs(state, C_RXOFF, 0) // datagram index inside the NTB
        cs(state, C_RXLEN, n)
        return ncm_next(state, frame, slot)
    }
    if n < 14 || n > FRAME_MAX {
        err_note(state, 2)
        requeue(state)
        return 0
    }
    let b: u64 = blk(state)
    copy(b + HOLD_OFF, b + RXA_OFF, n)
    requeue(state)
    cs(state, C_HOLD, 1)
    cs(state, C_RXP, cg(state, C_RXP) + 1)
    cs(state, C_RXB, cg(state, C_RXB) + n)
    *frame = b + HOLD_OFF
    *slot = 0
    return n
}

// r811: take the next PACKET_MSG out of the RNDIS transfer in the RX buffer. A malformed packet drops the rest
// of the transfer. The transfer is re-queued after the last packet.
fn rndis_next(state: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    let b: u64 = blk(state)
    let off: u64 = cg(state, C_RXOFF)
    let len: u64 = cg(state, C_RXLEN)
    if off >= len {
        cs(state, C_RXLEN, 0)
        requeue(state)
        return 0
    }
    let p: u64 = b + RXA_OFF + off
    let left: u64 = len - off
    if !rndis.packet_ok(p, left) {
        err_note(state, 3)
        cs(state, C_RXLEN, 0)
        requeue(state)
        return 0
    }
    let l: u64 = rndis.msg_len(p, left)
    let dl: u64 = rndis.packet_data_len(p, left)
    let doff: u64 = rndis.packet_data_off(p, left)
    cs(state, C_RXOFF, off + l)
    if off + l >= len {
        cs(state, C_RXLEN, 0)
        requeue(state)
    }
    if dl > FRAME_MAX {
        err_note(state, 4)
        return 0
    }
    copy(b + HOLD_OFF, p + doff, dl)
    cs(state, C_HOLD, 1)
    cs(state, C_RXP, cg(state, C_RXP) + 1)
    cs(state, C_RXB, cg(state, C_RXB) + dl)
    *frame = b + HOLD_OFF
    *slot = 0
    return dl
}

// r811: take the next datagram out of the NTB in the RX buffer. A bad entry is skipped (counted); the transfer is
// re-queued after the last entry, and only AFTER the datagram was copied out of the RX buffer.
fn ncm_next(state: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    let b: u64 = blk(state)
    let p: u64 = b + RXA_OFF
    let len: u64 = cg(state, C_RXLEN)
    let cnt: u64 = ncm.ntb_count(p, len)
    var idx: u64 = cg(state, C_RXOFF)
    while idx < cnt {
        let off: u64 = ncm.ntb_dg_off(p, len, idx)
        let dl: u64 = ncm.ntb_dg_len(p, len, idx)
        idx = idx + 1
        if off == 0 || dl > FRAME_MAX {
            err_note(state, 5)
        } else {
            copy(b + HOLD_OFF, p + off, dl)
            cs(state, C_RXOFF, idx)
            if idx >= cnt {
                cs(state, C_RXLEN, 0)
                requeue(state)
            }
            cs(state, C_HOLD, 1)
            cs(state, C_RXP, cg(state, C_RXP) + 1)
            cs(state, C_RXB, cg(state, C_RXB) + dl)
            *frame = b + HOLD_OFF
            *slot = 0
            return dl
        }
    }
    cs(state, C_RXLEN, 0)
    requeue(state)
    return 0
}

// LW-1a: take the next frame out of a CH336 bulk transfer ([len u32][4 octets][frame][pad to 4]...). The transfer is
// re-queued after the last frame, and only after the frame was copied out of the RX buffer.
fn ch_next(state: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    let b: u64 = blk(state)
    let carry: u64 = cg(state, C_CARRY)
    let p: u64 = b + CH_BASE - carry
    let off: u64 = cg(state, C_RXOFF)
    let len: u64 = cg(state, C_RXLEN)
    let st: u64 = ch397.rx_status(p, len as usize, off as usize)
    if st == ch397.RX_MORE {
        let tail: u64 = len - off
        copy(b + CH_BASE - tail, p + off, tail)
        cs(state, C_CARRY, tail)
        cs(state, C_RXLEN, 0)
        requeue(state)
        return 0
    }
    if st == ch397.RX_BAD {
        err_note(state, 6)
        cs(state, C_CARRY, 0)
        cs(state, C_SKIP, 0)
        cs(state, C_RXLEN, 0)
        requeue(state)
        return 0
    }
    let fl: u64 = ch397.rx_frame_len(p, len as usize, off as usize) as u64
    let fo: u64 = ch397.rx_frame_off(off as usize) as u64
    let nx: u64 = ch397.rx_next(p, len as usize, off as usize) as u64
    copy(b + HOLD_OFF, p + fo, fl)
    cs(state, C_RXOFF, nx)
    if nx >= len {
        cs(state, C_SKIP, ch397.rx_pad_missing(nx as usize, len as usize) as u64)
        cs(state, C_CARRY, 0)
        cs(state, C_RXLEN, 0)
        requeue(state)
    }
    cs(state, C_HOLD, 1)
    cs(state, C_RXP, cg(state, C_RXP) + 1)
    cs(state, C_RXB, cg(state, C_RXB) + fl)
    *frame = b + HOLD_OFF
    *slot = 0
    return fl
}

// r1607: next frame out of an AX88772 bulk transfer ([size|~size u32][frame][pad to 16 bit]...); same re-queue rules as ch_next.
fn ax_next(state: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    let b: u64 = blk(state)
    let p: u64 = b + RXA_OFF
    let off: u64 = cg(state, C_RXOFF)
    let len: u64 = cg(state, C_RXLEN)
    if off + ax88772.HDR as u64 > len {
        cs(state, C_RXLEN, 0)
        requeue(state)
        return 0
    }
    let fl: u64 = ax88772.rx_frame_len(p, len as usize, off as usize) as u64
    if fl == 0 {
        err_note(state, 7)
        cs(state, C_RXLEN, 0)
        requeue(state)
        return 0
    }
    let fo: u64 = ax88772.rx_frame_off(off as usize) as u64
    let nx: u64 = ax88772.rx_next(p, len as usize, off as usize) as u64
    copy(b + HOLD_OFF, p + fo, fl)
    cs(state, C_RXOFF, nx)
    if nx == 0 || nx + ax88772.HDR as u64 > len {
        cs(state, C_RXLEN, 0)
        requeue(state)
    }
    cs(state, C_HOLD, 1)
    cs(state, C_RXP, cg(state, C_RXP) + 1)
    cs(state, C_RXB, cg(state, C_RXB) + fl)
    *frame = b + HOLD_OFF
    *slot = 0
    return fl
}

fn vctl(state: u64, slot: u64, bm: u64, req: u64, value: u64, index: u64, len: u64, buf: u64) -> i64 {
    return xhci.control(state, slot, bm, req, value, index, len, buf, bm >= 0x80)
}

fn vlink_reset(state: u64) {
    cs(state, C_VLINK, 0xFF)
    cs(state, C_VNEXT, 0)
    cs(state, C_LINK, 0)
}

fn vlink_note(state: u64, cls: u64) {
    var s_dn: [u8; 18] = "usbnet: link down\0"
    var s_up: [u8; 17] = "usbnet: link up \0"
    if cls == 0 {
        cs(state, C_LINK, 2)
        say((&s_dn[0]) as u64)
        return
    }
    cs(state, C_LINK, 1)
    serial.puts((&s_up[0]) as u64)
    if cls == 3 {
        serial.dec(1000)
    } else if cls == 2 {
        serial.dec(100)
    } else {
        serial.dec(10)
    }
    serial.nl()
}

fn vhouse(state: u64) {
    let mode: u64 = cg(state, C_MODE)
    if mode != MODE_AX179 && mode != MODE_RTL {
        return
    }
    let now: u64 = ticks(state)
    if now < cg(state, C_VNEXT) {
        return
    }
    let prev: u64 = cg(state, C_VLINK)
    let buf: u64 = blk(state) + CMD_OFF
    let slot: u64 = cg(state, C_SLOT)
    var cls: u64 = prev
    if mode == MODE_AX179 {
        cls = ax88179_drv.link_sync(state, slot, vctl, buf, prev)
    } else {
        cls = rtl8153_drv.link_sync(state, slot, vctl, buf, cg(state, C_FAM), cg(state, C_USBSPD), prev)
    }
    cs(state, C_VLINK, cls)
    if cls != prev {
        vlink_note(state, cls)
    }
    if cls == 0 || cls == 0xFF {
        cs(state, C_VNEXT, now + VHOUSE_FAST)
    } else {
        cs(state, C_VNEXT, now + VHOUSE_SLOW)
    }
}

fn rx_finish(state: u64) {
    cs(state, C_RXLEN, 0)
    requeue(state)
}

fn rx_deliver(state: u64, fo: u64, fl: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    let b: u64 = blk(state)
    copy(b + HOLD_OFF, cg(state, C_BIG) + fo, fl)
    cs(state, C_HOLD, 1)
    cs(state, C_RXP, cg(state, C_RXP) + 1)
    cs(state, C_RXB, cg(state, C_RXB) + fl)
    *frame = b + HOLD_OFF
    *slot = 0
    return fl
}

fn axge_next(state: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    let b: u64 = blk(state)
    let p: u64 = cg(state, C_BIG)
    let len: u64 = cg(state, C_RXLEN)
    let res: u64 = b + RES_OFF
    var off: u64 = cg(state, C_RXOFF)
    var idx: u64 = cg(state, C_RXIDX)
    var guard: u64 = 0
    while guard < 256 {
        guard = guard + 1
        let st: u64 = ax88179.rx_step(p, len, off, idx, res)
        if st == ax88179.rx_status_frame() || st == ax88179.rx_status_skip() {
            off = le.get64(res, 0)
            idx = le.get64(res, 8)
            if st == ax88179.rx_status_skip() {
                err_note(state, 7)
            } else {
                let fo: u64 = le.get64(res, 16)
                let fl: u64 = le.get64(res, 24)
                cs(state, C_RXOFF, off)
                cs(state, C_RXIDX, idx)
                let n: u64 = rx_deliver(state, fo, fl, frame, slot)
                let nx: u64 = ax88179.rx_step(p, len, off, idx, b + RES2_OFF)
                if nx == ax88179.rx_status_end() || nx == ax88179.rx_status_bad() {
                    rx_finish(state)
                }
                return n
            }
        } else {
            if st == ax88179.rx_status_bad() {
                err_note(state, 7)
            }
            rx_finish(state)
            return 0
        }
    }
    rx_finish(state)
    return 0
}

fn rtl_next(state: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    let b: u64 = blk(state)
    let p: u64 = cg(state, C_BIG)
    let len: u64 = cg(state, C_RXLEN)
    let res: u64 = b + RES_OFF
    var off: u64 = cg(state, C_RXOFF)
    var guard: u64 = 0
    while guard < 256 {
        guard = guard + 1
        let st: u64 = rtl8153.rx_step(p, len, off, res)
        if st == rtl8153.rx_status_frame() || st == rtl8153.rx_status_skip() {
            off = le.get64(res, 0)
            if st == rtl8153.rx_status_skip() {
                err_note(state, 7)
            } else {
                let fo: u64 = le.get64(res, 16)
                let fl: u64 = le.get64(res, 24)
                cs(state, C_RXOFF, off)
                let n: u64 = rx_deliver(state, fo, fl, frame, slot)
                let nx: u64 = rtl8153.rx_step(p, len, off, b + RES2_OFF)
                if nx == rtl8153.rx_status_end() || nx == rtl8153.rx_status_bad() {
                    rx_finish(state)
                }
                return n
            }
        } else {
            rx_finish(state)
            return 0
        }
    }
    rx_finish(state)
    return 0
}

fn rx_recycle_on(state: u64, u: u64, id: u64) {
    cs(state, C_HOLD, 0)
}

fn tx_room_on(state: u64, u: u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    return 1
}

fn tx_frame_on(state: u64, u: u64, src: u64, n: u64) -> bool {
    if !ready_on(state, u) || n == 0 || n > FRAME_MAX {
        return false
    }
    let b: u64 = blk(state)
    var tn: u64 = n
    if cg(state, C_MODE) == 1 {
        tn = rndis.wrap_packet(b + TX_OFF, src, n)
    } else if cg(state, C_MODE) == 3 {
        tn = ch397.tx_wrap(src, n as usize, b + TX_OFF) as u64
        if tn == 0 {
            cs(state, C_DROP, cg(state, C_DROP) + 1)
            return false
        }
    } else if cg(state, C_MODE) == 4 {
        tn = ax88772.tx_wrap(src, n as usize, b + TX_OFF) as u64
        if tn == 0 {
            cs(state, C_DROP, cg(state, C_DROP) + 1)
            return false
        }
    } else if cg(state, C_MODE) == MODE_AX179 {
        tn = ax88179.tx_wrap(src, n, cg(state, C_MPS), b + TX_OFF)
        if tn == 0 {
            cs(state, C_DROP, cg(state, C_DROP) + 1)
            return false
        }
    } else if cg(state, C_MODE) == MODE_RTL {
        tn = rtl8153.tx_wrap(src, n, b + TX_OFF)
        if tn == 0 {
            cs(state, C_DROP, cg(state, C_DROP) + 1)
            return false
        }
    } else if cg(state, C_MODE) == 2 {
        var cap: u64 = 0x800
        if cg(state, C_NOUTMAX) < cap {
            cap = cg(state, C_NOUTMAX)
        }
        let sq: u64 = cg(state, C_NSEQ)
        cs(state, C_NSEQ, (sq + 1) & 0xFFFF)
        tn = ncm.wrap_frame(b + TX_OFF, cap, sq, src, n, cg(state, C_NDIV), cg(state, C_NREM),
            cg(state, C_NALIGN))
        if tn == 0 {
            cs(state, C_DROP, cg(state, C_DROP) + 1)
            return false
        }
    } else {
        copy(b + TX_OFF, src, n)
    }
    let slot: u64 = cg(state, C_SLOT)
    let dci: u64 = cg(state, C_OUT)
    var r: i64 = xhci.bulk(state, slot, dci, b + TX_OFF, tn)
    if r < 0 {
        cs(state, C_TXRC, r as u64)
        cs(state, C_TXFAIL, cg(state, C_TXFAIL) + 1)
        if cg(state, C_MODE) == 3 && tx_recover(state, slot, dci) {
            r = xhci.bulk(state, slot, dci, b + TX_OFF, tn)
        }
    }
    if r < 0 {
        cs(state, C_DROP, cg(state, C_DROP) + 1)
        return false
    }
    let mps: u64 = cg(state, C_MPS)
    if mps != 0 && (tn % mps) == 0 {
        // terminate the transfer with a zero-length packet
        xhci.bulk(state, slot, dci, b + TX_OFF, 0)
    }
    cs(state, C_TXP, cg(state, C_TXP) + 1)
    cs(state, C_TXB, cg(state, C_TXB) + n)
    return true
}

fn rx_frames_on(state: u64, u: u64) -> u64 { return cg(state, C_RXP) }
fn tx_frames_on(state: u64, u: u64) -> u64 { return cg(state, C_TXP) }
fn tx_drops_on(state: u64, u: u64) -> u64 { return cg(state, C_DROP) }
fn rx_octets_on(state: u64, u: u64) -> u64 { return cg(state, C_RXB) }
fn tx_octets_on(state: u64, u: u64) -> u64 { return cg(state, C_TXB) }
fn errors(state: u64) -> u64 { return cg(state, C_ERR) }
fn err_kind(state: u64, kind: u64) -> u64 { return (cg(state, C_ERRK) >> (kind * 8)) & 0xFF }
fn err_cc(state: u64) -> u64 { return cg(state, C_ERRCC) }

fn err_note(state: u64, kind: u64) {
    cs(state, C_ERR, cg(state, C_ERR) + 1)
    let packed: u64 = cg(state, C_ERRK)
    if ((packed >> (kind * 8)) & 0xFF) < 255 {
        cs(state, C_ERRK, packed + (1 << (kind * 8)))
    }
}
