profile kernel

import wlan.iwl_boot
import wlan.iwl_fwcaps
import wlan.iwl_nvmmac

export { store, mac, ready }

static mut hm_mac: [u8; 6] = [0 as u8; 6]
static mut hm_ready: u64 = 0

fn mac() -> u64 { return (&hm_mac[0]) as u64 }
fn ready() -> bool { return hm_ready != 0 }

fn store(b: *mut iwl_boot.Boot, quirks: u64) {
    hm_ready = 0
    if (quirks & iwl_fwcaps.Q_OLD_MAC) != 0 { return }
    if (*b).mao_len == 0 { return }
    if iwl_nvmmac.mao_mac((*b).nvm + (*b).mao_off, (*b).mao_len, mac()) { hm_ready = 1 }
}
