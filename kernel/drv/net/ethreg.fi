profile kernel

import lib.kstate
import bus.drvclass
import drv.net.netclass
import drv.net.virtio_class
import drv.net.e1000_class
import drv.net.r8169_class
import drv.net.usbnet_class
import drv.net.wlan_class

export {
    ops_for, KIND_NONE, KIND_VIRTIO, KIND_E1000, KIND_R8169, KIND_I219, KIND_USBNET, KIND_WLAN
}

const KIND_NONE: u64 = 0
const KIND_VIRTIO: u64 = 1
const KIND_E1000: u64 = 2
const KIND_R8169: u64 = 3
const KIND_I219: u64 = 4
const KIND_USBNET: u64 = 5
const KIND_WLAN: u64 = 6

fn table_of(kind: u64) -> netclass.EthOps {
    if kind == KIND_VIRTIO {
        return virtio_class.ops()
    }
    if kind == KIND_E1000 || kind == KIND_I219 {
        return e1000_class.ops()
    }
    if kind == KIND_R8169 {
        return r8169_class.ops()
    }
    if kind == KIND_USBNET {
        return usbnet_class.ops()
    }
    if kind == KIND_WLAN {
        return wlan_class.ops()
    }
    return netclass.null_ops()
}

fn ops_for(state: u64, kind: u64) -> netclass.EthOps {
    if kstate.mode_on(state, kstate.M_NOCLASS) {
        return netclass.null_ops()
    }
    if kind == KIND_NONE {
        return netclass.null_ops()
    }
    drvclass.hit(drvclass.CLS_NET_ETH)
    var o: netclass.EthOps = table_of(kind)
    if kstate.mode_on(state, kstate.M_BADCLASS) {
        let z: netclass.EthOps = netclass.null_ops()
        o.tx_frame = z.tx_frame
    }
    return o
}
