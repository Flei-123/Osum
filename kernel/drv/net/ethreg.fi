profile kernel

import lib.kstate
import bus.drvclass
import drv.net.netclass
import drv.net.r8169_class

export { ops_for, KIND_R8169 }

const KIND_R8169: u64 = 3

fn ops_for(state: u64, kind: u64) -> netclass.EthOps {
    if kstate.mode_on(state, kstate.M_NOCLASS) {
        return netclass.null_ops()
    }
    if kind == KIND_R8169 {
        drvclass.hit(drvclass.CLS_NET_ETH)
        var o: netclass.EthOps = r8169_class.ops()
        if kstate.mode_on(state, kstate.M_BADCLASS) {
            let z: netclass.EthOps = netclass.null_ops()
            o.tx_frame = z.tx_frame
        }
        return o
    }
    return netclass.null_ops()
}
