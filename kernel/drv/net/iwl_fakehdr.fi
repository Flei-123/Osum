profile kernel

import serial
import wlan.iwl_le
import wlan.iwl_buf
import wlan.iwl_mvm_scan

export { umac, accept, base }

fn umac(cmd: u64) -> bool {
    return cmd == iwl_mvm_scan.CMD_SCAN_CFG || cmd == iwl_mvm_scan.CMD_SCAN_REQ_UMAC || cmd == iwl_mvm_scan.CMD_SCAN_ABORT_UMAC
}

fn say(text: u64, cmd: u64) {
    var tag: [u8; 14] = "fakefw: umac \0"
    var s_c: [u8; 6] = " cmd=\0"
    serial.puts((&tag[0]) as u64)
    serial.puts(text)
    serial.puts((&s_c[0]) as u64)
    serial.hex(cmd)
    serial.nl()
}

fn accept(tb0: u64, total: u64) -> bool {
    let cmd: u64 = iwl_le.ld8(tb0, 0)
    var m_short: [u8; 14] = "hdr bad short\0"
    var m_group: [u8; 14] = "hdr bad group\0"
    var m_len: [u8; 15] = "hdr bad length\0"
    var m_ok: [u8; 12] = "hdr ok wide\0"
    if iwl_buf.wide_group(tb0) == 0 {
        say((&m_short[0]) as u64, cmd)
        return false
    }
    if iwl_buf.wide_group(tb0) != iwl_buf.GROUP_LONG {
        say((&m_group[0]) as u64, cmd)
        return false
    }
    if total < iwl_buf.HDR_WIDE || iwl_le.ld16(tb0, 4) != total - iwl_buf.HDR_WIDE {
        say((&m_len[0]) as u64, cmd)
        return false
    }
    if cmd == iwl_mvm_scan.CMD_SCAN_CFG { say((&m_ok[0]) as u64, cmd) }
    return true
}

fn base(tb0: u64) -> u64 { return tb0 + iwl_buf.hdr_len(tb0) - iwl_buf.HDR }
