profile kernel

import libc.octets

export { table_write, raise_cause, enabled, ict_base, ict_index }

const S_ICT_BASE: u64 = 0x2560
const S_ICT_INDEX: u64 = 0x2568
const REG_CSR_INT: u64 = 0x008
const TABLE_ENABLE: u64 = 0x80000000
const TABLE_BASE_MASK: u64 = 0x07FFFFFF
const TABLE_BASE_SHIFT: u64 = 12
const TABLE_ENTRIES: u64 = 1024
const ENTRY_BYTES: u64 = 4
const LOW_MASK: u64 = 0xFF
const HIGH_SHIFT: u64 = 24
const HIGH_PLACE: u64 = 8

fn enabled(ctx: u64) -> bool { return octets.ld64(ctx, S_ICT_BASE) != 0 }
fn ict_base(ctx: u64) -> u64 { return octets.ld64(ctx, S_ICT_BASE) }
fn ict_index(ctx: u64) -> u64 { return octets.ld64(ctx, S_ICT_INDEX) }

fn table_write(ctx: u64, v: u64) {
    octets.st64(ctx, S_ICT_INDEX, 0)
    if (v & TABLE_ENABLE) == 0 {
        octets.st64(ctx, S_ICT_BASE, 0)
        return
    }
    octets.st64(ctx, S_ICT_BASE, (v & TABLE_BASE_MASK) << TABLE_BASE_SHIFT)
}

fn entry_of(bits: u64) -> u64 {
    return (bits & LOW_MASK) | (((bits >> HIGH_SHIFT) & LOW_MASK) << HIGH_PLACE)
}

fn raise_cause(ctx: u64, bits: u64) {
    let base: u64 = octets.ld64(ctx, S_ICT_BASE)
    if base == 0 {
        octets.st32(ctx, REG_CSR_INT, octets.ld32(ctx, REG_CSR_INT) | bits)
        return
    }
    let idx: u64 = octets.ld64(ctx, S_ICT_INDEX)
    octets.st32(base, idx * ENTRY_BYTES, octets.ld32(base, idx * ENTRY_BYTES) | entry_of(bits))
    octets.st64(ctx, S_ICT_INDEX, (idx + 1) & (TABLE_ENTRIES - 1))
}
