profile kernel

export {
    EthOps, null_ops,
    CAP_POLL_ONLY, CAP_MSIX, CAP_SPEED, CAP_HWSTAT
}

const CAP_POLL_ONLY: u64 = 1
const CAP_MSIX: u64 = 2
const CAP_SPEED: u64 = 4
const CAP_HWSTAT: u64 = 8

struct EthOps {
    present: fn(u64, u64) -> bool,
    ready: fn(u64, u64) -> bool,
    up: fn(u64, u64) -> bool,
    init: fn(u64, u64, bool, bool, u64) -> bool,
    bdf: fn(u64, u64) -> u64,
    idx: fn(u64, u64) -> u64,
    irqs: fn(u64, u64) -> u64,
    rx_frames: fn(u64, u64) -> u64,
    tx_frames: fn(u64, u64) -> u64,
    tx_drops: fn(u64, u64) -> u64,
    rx_octets: fn(u64, u64) -> u64,
    tx_octets: fn(u64, u64) -> u64,
    rx_errors: fn(u64, u64) -> u64,
    oversize: fn(u64, u64) -> u64,
    rx_overflow: fn(u64, u64) -> u64,
    features: fn(u64, u64) -> u64,
    queue_size: fn(u64, u64) -> u64,
    notified: fn(u64, u64) -> u64,
    link_speed: fn(u64, u64) -> u64,
    tx_room: fn(u64, u64) -> u64,
    msix: fn(u64, u64) -> bool,
    link_up: fn(u64, u64) -> bool,
    mac_at: fn(u64, u64, u64) -> u64,
    rx_take: fn(u64, u64, *mut u64, *mut u64) -> u64,
    rx_recycle: fn(u64, u64, u64),
    tx_frame: fn(u64, u64, u64, u64) -> bool,
    poll: fn(u64, u64) -> bool,
    irq: fn(u64, u64),
    shut_down: fn(u64, u64),
    selftest: fn(u64, u64),
    print_regs: fn(u64, u64),
    caps: u64,
    tag: u64
}

fn n_bool(state: u64, u: u64) -> bool {
    return false
}

fn n_num(state: u64, u: u64) -> u64 {
    return 0
}

fn n_init(state: u64, u: u64, use_msix: bool, armed: bool, vec: u64) -> bool {
    return false
}

fn n_mac(state: u64, u: u64, i: u64) -> u64 {
    return 0
}

#[allow_escape]
fn n_take(state: u64, u: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    return 0
}

fn n_recycle(state: u64, u: u64, id: u64) {
}

fn n_void(state: u64, u: u64) {
}

fn n_tx(state: u64, u: u64, src: u64, n: u64) -> bool {
    return false
}

fn null_ops() -> EthOps {
    return EthOps {
        present: n_bool,
        ready: n_bool,
        up: n_bool,
        init: n_init,
        bdf: n_num,
        idx: n_num,
        irqs: n_num,
        rx_frames: n_num,
        tx_frames: n_num,
        tx_drops: n_num,
        rx_octets: n_num,
        tx_octets: n_num,
        rx_errors: n_num,
        oversize: n_num,
        rx_overflow: n_num,
        features: n_num,
        queue_size: n_num,
        notified: n_num,
        link_speed: n_num,
        tx_room: n_num,
        msix: n_bool,
        link_up: n_bool,
        mac_at: n_mac,
        rx_take: n_take,
        rx_recycle: n_recycle,
        tx_frame: n_tx,
        poll: n_bool,
        irq: n_void,
        shut_down: n_void,
        selftest: n_void,
        print_regs: n_void,
        caps: 0,
        tag: 0
    }
}
