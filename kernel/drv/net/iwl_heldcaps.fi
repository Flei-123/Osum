profile kernel

import wlan.iwl_fw
import wlan.iwl_fwcaps

export { store, words, fw_words, ready }

static mut hc_words: [u64; 16] = [0 as u64; 16]
static mut hc_fw: [u64; 16] = [0 as u64; 16]
static mut hc_ready: u64 = 0

fn words() -> *mut u64 { return (&hc_words[0]) as *mut u64 }
fn fw_words() -> *mut u64 { return (&hc_fw[0]) as *mut u64 }

fn store(f: *mut iwl_fw.FwInfo, quirks: u64) {
    iwl_fwcaps.caps_fill(fw_words(), f)
    iwl_fwcaps.caps_fill(words(), f)
    iwl_fwcaps.caps_apply_quirks(words(), quirks)
    hc_ready = 1
}

fn ready() -> bool { return hc_ready != 0 }
