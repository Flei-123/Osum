// SPDX-License-Identifier: GPL-2.0-only
// kernel/e1000.fi -- round HWNET: a network card that exists as a CHIP.
//
// Round K8 wrote `virtio.fi` and said, in its own header, why it chose
// virtio over e1000: virtio is one ring shape for every device, e1000 is
// a transcript of a data sheet. That was the right choice for learning
// what a driver is. It is the wrong choice for a machine you can touch:
// virtio-net exists only under a hypervisor. On a real board there is an
// Intel or a Realtek chip on the bus and nothing else, so a kernel with
// only virtio has NO NETWORK on real hardware -- and without a network
// there is no update and no helper.
//
// So this file is the other half: the 8254x/82574 family of Intel
// gigabit controllers, the one wired Ethernet chip that is both
// documented in public (Intel 8254x Software Developer's Manual,
// document 317453) and present in QEMU (`-device e1000`, an 82540EM),
// which is what makes it measurable HERE and not only on a board.
//
// WHAT IT IS, in the same five steps as the virtio driver:
//
//   1. FIND IT. Vendor 0x8086, class 02:00, and a device number out of
//      the table in `netdev.fi`. NOT "the first Intel device": a chipset
//      is full of them.
//   2. ONE REGION. Everything is BAR0, memory mapped, 128 KiB. There is
//      no capability walk and no feature negotiation -- a real chip has
//      neither. What replaces them is a RESET and a wait, because the
//      chip comes out of the firmware in whatever state the firmware
//      left it.
//   3. THE ADDRESS. Two ways, in this order: the receive address
//      registers RAL/RAH, which the hardware fills out of its own
//      non-volatile memory at power-up (and which QEMU fills at reset),
//      and, if the valid bit there is not set, three EEPROM reads
//      through EERD. If both fail the driver REFUSES to come up rather
//      than invent an address.
//   4. TWO RINGS. A receive ring and a send ring, 32 descriptors each,
//      16 octets per descriptor, in one contiguous run of frames. Unlike
//      virtio, where the driver hands buffers over one at a time, the
//      ring here is a CIRCLE with a head the CHIP moves and a tail the
//      DRIVER moves; "the ring is full" is a comparison of two register
//      values and not a count.
//   5. THE INTERRUPT. The 82540EM has no MSI-X, so this driver takes the
//      interrupt PIN through the I/O APIC, exactly like `nicintx` does
//      for virtio. Reading ICR is what acknowledges it.
//
// WHAT THIS DRIVER DOES NOT DO, said plainly: no checksum offload (the
// stack computes every checksum itself, as it does for virtio), no
// segmentation offload, no jumbo frames (2048-octet buffers, LPE off),
// no multicast beyond broadcast (the multicast table is cleared, BAM is
// on), no VLAN, no MSI or MSI-X, no interrupt moderation, no statistics
// registers beyond the ones counted here in software, and no PHY
// programming at all -- SLU/ASDE let the chip negotiate the link by
// itself, which is what every 8254x does on its own anyway.
//
// WHAT IS NOT MEASURED HERE, and it matters for the round's own claim:
// the only e1000 this repository has ever talked to is QEMU's 82540EM.
// The register layout below is the one the 8254x manual describes and
// the one the 82574L (0x10D3, QEMU's `e1000e`) still answers, but NO
// PHYSICAL CARD HAS BEEN TESTED. Anything said about a chip on a real
// board is a statement about a data sheet and is marked as such in
// docs/REALHW.md.

import lib.kstate
import klog
import serial
import mm.mem
import bus.pci
import acpi.aml
import arch.x86_64.apic
import arch.arch

export {
    MAX_UNITS, VENDOR_INTEL,
    init_on, present_on, ready_on, up_on, mac_at_on, bdf_on, idx_on,
    rx_take_on, rx_recycle_on, tx_frame_on, tx_room_on, poll_on, irq_on,
    rx_frames_on, tx_frames_on, rx_octets_on, tx_octets_on,
    tx_drops_on, link_up_on, shut_down_on, irqs_on, queue_size_on,
    msix_on, notified_on, features_on, supports, RING_SLOTS, BUFSZ,
    supports_8254x, supports_ich, family_of, FAM_8254X, FAM_ICH,
    phy_id_on, swflag_on, link_speed_on,
    set_flags, irq_mode_on, step_on, warn_on, storm_on,
    IRQ_NONE, IRQ_INTX, IRQ_MSI
}

// ------------------------------------------------------ the data area
//
// This driver does NOT live in `pci.K2_SCALARS`. That page pair is cut
// up by nine rounds already and round NETVIEW spent a day on two of them
// landing on the same eight octets. Round HWNET takes a page of its own
// out of the region `kstate.fi` still lists as free (0x7A000) and enters
// it in `tools/kernel/memmap.py`, which is what that tool is for.
//
// `kstate.NETDEV_OFF + 0x000`  netdev.fi, the dispatch layer
// `kstate.NETDEV_OFF + 0x400`  unit 0 of this driver
// `kstate.NETDEV_OFF + 0x600`  unit 1
const UNIT_BASE: u64 = 0x400
const UNIT_SPAN: u64 = 0x200
const MAX_UNITS: u64 = 2

const S_MMIO: u64 = 0x00 // where BAR0 is reachable in the first GiB
const S_BDF: u64 = 0x08
const S_IDX: u64 = 0x10 // its place in the device table of pci.fi
const S_READY: u64 = 0x18
const S_MAC: u64 = 0x20 // six octets in one word, low first
const S_RING: u64 = 0x28 // the run of frames both rings live in
const S_RX_CUR: u64 = 0x30 // the descriptor this driver looks at next
const S_TX_CUR: u64 = 0x38 // where the next frame is written
const S_IRQS: u64 = 0x40
const S_RXP: u64 = 0x48
const S_TXP: u64 = 0x50
const S_RXB: u64 = 0x58
const S_TXB: u64 = 0x60
const S_TXDROP: u64 = 0x68
const S_LINK: u64 = 0x70
const S_DEVID: u64 = 0x78
const S_MACOK: u64 = 0x80
const S_LASTICR: u64 = 0x88
const S_CAUSES: u64 = 0x90
// RUNDE RTL: der PCH-Zweig.
const S_FAM: u64 = 0x98 // FAM_8254X oder FAM_ICH
const S_PHYID: u64 = 0xA0 // was der PHY ueber sich sagt (MII 2/3)
const S_SWFLAG: u64 = 0xA8 // 1 = die Semaphore gegen die ME gehoert uns
const S_PREMAC: u64 = 0xB0 // RAL/RAH, gelesen VOR dem Ruecksetzen
// RUNDE O-NETZUI: DIE AUSGEHANDELTE VERBINDUNGSRATE, in Megabit je
// Sekunde -- 10, 100, 1000, oder 0 fuer "unbekannt". Sie steht in
// DEMSELBEN Register, aus dem `read_link` schon das Traegerbit liest
// (STATUS, 0x0008, Bits 7:6), also kostet sie keinen zusaetzlichen
// Registerzugriff: `read_link` schreibt beide Zahlen in einem Zug.
//
// WARUM SIE UEBERHAUPT GESPEICHERT WIRD und nicht bei jeder Frage neu
// gelesen: die Einstellungen fragen einmal je Sekunde, und ein
// MMIO-Lesezugriff aus dem Ring 3 heraus waere ein Systemaufruf, der
// eine Karte anfasst, die gerade sendet. Der Wert ist ohnehin genau so
// frisch wie das Traegerbit daneben -- beide kommen aus demselben Lauf.
const S_SPEED: u64 = 0xB8 // 0 = unbekannt, sonst 10/100/1000

fn sc(u: u64, off: u64) -> u64 {
    return kstate.NETDEV_OFF + UNIT_BASE + u * UNIT_SPAN + off
}

// ------------------------------------------------------- the constants

const VENDOR_INTEL: u64 = 0x8086
const CLASS_NET: u64 = 0x02
const SUB_ETHERNET: u64 = 0x00

// The registers this driver touches, by their names in the 8254x manual.
const R_CTRL: u64 = 0x0000
const R_STATUS: u64 = 0x0008
const R_EERD: u64 = 0x0014
const R_ICR: u64 = 0x00C0
const R_ITR: u64 = 0x00C4
const R_RDTR: u64 = 0x2820
const R_RADV: u64 = 0x282C
const R_TIDV: u64 = 0x3820
const R_TADV: u64 = 0x382C
const R_IMS: u64 = 0x00D0
const R_IMC: u64 = 0x00D8
const R_RCTL: u64 = 0x0100
const R_TCTL: u64 = 0x0400
const R_TIPG: u64 = 0x0410
const R_RDBAL: u64 = 0x2800
const R_RDBAH: u64 = 0x2804
const R_RDLEN: u64 = 0x2808
const R_RDH: u64 = 0x2810
const R_RDT: u64 = 0x2818
const R_TDBAL: u64 = 0x3800
const R_TDBAH: u64 = 0x3804
const R_TDLEN: u64 = 0x3808
const R_TDH: u64 = 0x3810
const R_TDT: u64 = 0x3818
const R_MTA: u64 = 0x5200 // 128 registers of the multicast table
const R_RAL: u64 = 0x5400
const R_RAH: u64 = 0x5404

const CTRL_SLU: u64 = 64 // 1 << 6, set link up
const CTRL_ASDE: u64 = 32 // 1 << 5, auto speed detection
const CTRL_LRST: u64 = 8 // 1 << 3, link reset -- has to be OFF
const CTRL_ILOS: u64 = 128 // 1 << 7, invert loss of signal -- OFF
const CTRL_RST: u64 = 67108864 // 1 << 26
const CTRL_VME: u64 = 1073741824 // 1 << 30, VLAN mode -- OFF

const STATUS_LU: u64 = 2 // 1 << 1, the link is up

// RUNDE O-NETZUI: die zwei Bits, in denen der Chip die AUSGEHANDELTE
// Rate meldet. 8254x-Handbuch, Abschnitt 13.4.2 (Device Status
// Register): Bits 7:6 "SPEED", 00 = 10 Mb/s, 01 = 100 Mb/s,
// 10 = 1000 Mb/s, 11 = reserviert (in der Praxis ebenfalls Gigabit).
// Der Wert gilt NUR, wenn LU gesetzt ist -- ohne Traeger ist nichts
// ausgehandelt und die Bits stehen auf dem, was zuletzt galt.
const STATUS_SPEED_SHIFT: u64 = 6
const STATUS_SPEED_MASK: u64 = 3

const RCTL_EN: u64 = 2 // 1 << 1
const RCTL_UPE: u64 = 8 // 1 << 3, every unicast address
const RCTL_MPE: u64 = 16 // 1 << 4, every multicast address
const RCTL_BAM: u64 = 32768 // 1 << 15, broadcast
const RCTL_SECRC: u64 = 67108864 // 1 << 26, strip the CRC

const TCTL_EN: u64 = 2 // 1 << 1
const TCTL_PSP: u64 = 8 // 1 << 3, pad short packets

// The inter-packet gap the manual gives for copper: IPGT 10, IPGR1 8,
// IPGR2 6 -- 0x0060200A. A zero here is a chip that sends nothing.
const TIPG_DEFAULT: u64 = 6299658

const RAH_AV: u64 = 2147483648 // 1 << 31, this address is valid

// ------------------------------------------- RUNDE RTL: der PCH-Zweig
//
// Die Register, die es NUR auf der ICH8/PCH-Linie gibt (I217/I218/I219).
// Der Registerblock daneben -- CTRL, STATUS, RCTL, TCTL, RDBAL, TDBAL,
// RAL/RAH -- ist derselbe wie oben, und genau das ist der Grund, warum
// der I219 in DIESER Datei steht und nicht in einer eigenen.
const R_CTRL_EXT: u64 = 0x0018
const R_MDIC: u64 = 0x0020 // der Draht zum PHY (MDIO)
const R_FEXTNVM: u64 = 0x0028
const R_FEXTNVM7: u64 = 0x00E4
const R_EXTCNF_CTRL: u64 = 0x0F00 // hier sitzt die Semaphore

// EXTCNF_CTRL Bit 5: das Software-Flag. Der PHY eines I219 haengt NICHT
// am MAC, sondern an einem Bus, den sich der MAC mit der
// Verwaltungsfirmware (Intel ME/CSME) TEILT. Wer ohne dieses Flag ein
// MDIC-Kommando absetzt, redet dem anderen dazwischen -- und der andere
// ist eine Firmware, die man nicht anhalten kann.
const EXTCNF_SWFLAG: u64 = 32 // 1 << 5

// MDIC (0x20): Daten 0..15, Registernummer 16..20, PHY-Adresse 21..25,
// Kommando 26..27, FERTIG 28, FEHLER 30.
const MDIC_OP_WRITE: u64 = 67108864 // 1 << 26
const MDIC_OP_READ: u64 = 134217728 // 2 << 26
const MDIC_READY: u64 = 268435456 // 1 << 28
const MDIC_ERROR: u64 = 1073741824 // 1 << 30

// FEXTNVM7 Bit 5: solange das Bit steht, bleibt der Chip im
// Ultra-Low-Power-Zustand und sein PHY antwortet nicht.
const FEXTNVM7_ULP: u64 = 32 // 1 << 5

// Auf der ICH-Linie sitzt der PHY auf Adresse 1. Das ist eine Konstante
// aus dem Datenblatt und kein Fund: dieser Baum hat nie einen befragt.
const ICH_PHY_ADDR: u64 = 1

// MII-Register 1 (BMSR), Bit 2: die Verbindung steht. Das Bit RASTET --
// ein weggewesener Link bleibt bis zum naechsten Lesen als weg gemeldet,
// deshalb wird zweimal gelesen und die zweite Antwort gilt.
const BMSR_LINK: u64 = 4

const FAM_8254X: u64 = 0
const FAM_ICH: u64 = 1

const EERD_START: u64 = 1
const EERD_DONE: u64 = 16 // 1 << 4 on the 82540 and later

// Interrupt causes this driver asks for: a frame arrived (RXT0), the
// receive ring is running low (RXDMT0), the receive ring overflowed
// (RXO), and the link changed (LSC).
const IM_TXDW: u64 = 1
const IM_TXQE: u64 = 2
const IM_LSC: u64 = 4
const IM_RXDMT0: u64 = 16
const IM_RXO: u64 = 64
const IM_RXT0: u64 = 128

// A receive descriptor: address (8), length (2), checksum (2), status
// (1), errors (1), special (2).
const RD_STATUS: u64 = 12
const RD_ERRORS: u64 = 13
const RDS_DD: u64 = 1 // the chip is done with this one
const RDS_EOP: u64 = 2 // and the frame ends here

// A send descriptor: address (8), length (2), checksum offset (1),
// command (1), status (1), checksum start (1), special (2).
const TD_CMD: u64 = 11
const TD_STATUS: u64 = 12
const TDC_EOP: u64 = 1
const TDC_IFCS: u64 = 2 // the chip appends the frame check sequence
const TDC_RS: u64 = 8 // report the status back

// THE RINGS. 32 descriptors each. The manual wants the descriptor area
// to be 16-octet aligned and its length a multiple of 128; 32 * 16 = 512
// is both, and a page for each ring is simpler to reason about than a
// packing that has to be recomputed. 2048-octet buffers, which is what
// RCTL says (BSIZE 00 with BSEX 0), and every Ethernet frame fits.
const RING_SLOTS: u64 = 32
const BUFSZ: u64 = 2048

const RXD_OFF: u64 = 0x00000 // 512 octets
const TXD_OFF: u64 = 0x01000 // 512
const RXB_OFF: u64 = 0x02000 // 32 * 2048 = 0x10000
const TXB_OFF: u64 = 0x12000 // 0x10000
const RING_BYTES: u64 = 0x22000 // 139 264 octets = 34 frames

// The same rule as in `nvme.fi` and `virtio.fi`: a chip that never
// answers must not be able to stop the kernel.
const SPIN_LIMIT: u64 = 2000000

// ---------------------------------------------------- WHICH CHIPS
//
// The device numbers this driver ATTACHES to. Every one of them answers
// the 8254x register layout above. The list is short on purpose: a
// driver that attaches to a number it has never seen and then reads
// zeroes forever is worse than one that says "unknown".
//
//   0x100E  82540EM      -- QEMU's `-device e1000`. THE ONE THAT IS
//                           ACTUALLY MEASURED HERE.
//   0x100F  82545EM      -- QEMU's `-device e1000-82545em`
//   0x1015  82540EM LOM  -- the same silicon on a mainboard
//   0x1026  82545GM
//   0x1028  82546GB
//   0x10D3  82574L       -- QEMU's `-device e1000e`. Reached through the
//                           LEGACY descriptor path, which the 82574
//                           still answers; its MSI-X and its advanced
//                           descriptors are NOT used.
//
// WHAT IS DELIBERATELY NOT IN THE LIST, and why -- this is the part that
// matters for "install OrientOS on a real laptop":
//
//   I217/I218/I219 (0x153A, 0x155A, 0x15B7, 0x15B8, 0x15BB, 0x0D4E ...)
//     The PCH LAN parts. Same MAC register block, but the PHY hangs off
//     the management engine and needs a handshake (the ULP/K1 workaround
//     dance in Linux's e1000e) before the link comes up. Attaching this
//     driver to one of them would produce a card that answers registers
//     and never receives a frame. Recognised by name in `netdev.fi`,
//     refused with a reason.
//   I210/I211/I225/I226 (0x1533, 0x1539, 0x15F2, 0x125B ...)
//     igb/igc silicon: a different descriptor format (advanced only) and
//     a different queue setup. A different driver, not a table entry.
fn supports_8254x(devid: u64) -> bool {
    if devid == 0x100E {
        return true
    }
    if devid == 0x100F {
        return true
    }
    if devid == 0x1015 {
        return true
    }
    if devid == 0x1026 {
        return true
    }
    if devid == 0x1028 {
        return true
    }
    if devid == 0x10D3 {
        return true
    }
    return false
}

// RUNDE RTL: DIE PCH-LINIE. Was Runde HWNET oben als "bewusst NICHT in
// der Liste" aufgeschrieben hat, steht jetzt darin -- aber in einer
// ZWEITEN Liste und mit einem eigenen Aufsetzweg, weil der Unterschied
// echt ist: derselbe Registerblock, derselbe Deskriptor, ein voellig
// anderer Weg zum PHY.
//
//   0x153A/0x153B  I217-LM / I217-V   (Lynx Point)
//   0x155A/0x1559  I218-LM / I218-V   (Wildcat Point)
//   0x15A0..0x15A3 I218 in weiteren Ausfuehrungen
//   0x156F/0x1570  I219-LM / I219-V   (Skylake)
//   0x15B7/0x15B8  I219-LM / I219-V   (Kaby Lake) -- der haeufigste
//   0x15BB/0x15BC/0x15BD/0x15BE  I219 (Cannon/Comet Lake)
//   0x15D7/0x15D8/0x15E3          I219 (Coffee Lake)
//   0x0D4E/0x0D4F/0x0D53/0x0D55   I219 (Tiger Lake und spaeter)
//   0x1A1C..0x1A1F                I219 (Alder Lake)
fn supports_ich(devid: u64) -> bool {
    if devid == 0x153A || devid == 0x153B {
        return true
    }
    if devid == 0x155A || devid == 0x1559 {
        return true
    }
    if devid == 0x15A0 || devid == 0x15A1 {
        return true
    }
    if devid == 0x15A2 || devid == 0x15A3 {
        return true
    }
    if devid == 0x156F || devid == 0x1570 {
        return true
    }
    if devid == 0x15B7 || devid == 0x15B8 || devid == 0x15B9 {
        return true
    }
    if devid == 0x15BB || devid == 0x15BC {
        return true
    }
    if devid == 0x15BD || devid == 0x15BE {
        return true
    }
    if devid == 0x15D7 || devid == 0x15D8 || devid == 0x15E3 {
        return true
    }
    if devid == 0x0D4E || devid == 0x0D4F {
        return true
    }
    if devid == 0x0D53 || devid == 0x0D55 {
        return true
    }
    if devid == 0x1A1C || devid == 0x1A1D {
        return true
    }
    if devid == 0x1A1E || devid == 0x1A1F {
        return true
    }
    return false
}

fn supports(devid: u64) -> bool {
    if supports_8254x(devid) { return true }
    return supports_ich(devid)
}

fn family_of(devid: u64) -> u64 {
    if supports_ich(devid) { return FAM_ICH }
    return FAM_8254X
}

fn fam(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_FAM))
}

fn phy_id_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_PHYID))
}

fn swflag_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_SWFLAG))
}

// -------------------------------------------------------- small helpers

fn mmio(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_MMIO))
}

// ROUND NIC9020: "there is a supported card at this unit", independent
// of whether it came up. Before, a failed bring-up zeroed the register
// window and the stack reported "no device" for a card that was there.
fn present_on(state: u64, u: u64) -> bool {
    return kstate.get(state, sc(u, S_FOUND)) != 0
}

fn ready_on(state: u64, u: u64) -> bool {
    return kstate.get(state, sc(u, S_READY)) != 0
}

fn up_on(state: u64, u: u64) -> bool {
    return ready_on(state, u)
}

fn bdf_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_BDF))
}

fn idx_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_IDX))
}

fn irqs_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_IRQS))
}

fn rx_frames_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_RXP))
}

fn tx_frames_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_TXP))
}

fn tx_drops_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_TXDROP))
}

fn rx_octets_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_RXB))
}

fn tx_octets_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_TXB))
}

// What `netsvc.fi` prints as "features" for virtio is a negotiated
// bitmap. This chip negotiates nothing; the number that says what it IS
// is its device number, so that is what comes back here.
fn features_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_DEVID))
}

fn queue_size_on(state: u64, u: u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    return RING_SLOTS
}

// No MSI-X on this family, and the driver does not pretend otherwise.
fn msix_on(state: u64, u: u64) -> bool {
    return false
}

// There is no doorbell to ring: the tail register IS the doorbell, and
// every send writes it. So this counts the same thing virtio counts --
// how often the chip was told the ring moved.
fn notified_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_TXP)) + kstate.get(state, sc(u, S_RXP))
}

fn link_up_on(state: u64, u: u64) -> bool {
    return kstate.get(state, sc(u, S_LINK)) != 0
}

// RUNDE O-NETZUI: die ausgehandelte Rate in Megabit je Sekunde, oder 0.
//
// NULL HEISST UNBEKANNT UND NICHT NULL MEGABIT. Der Unterschied ist der
// ganze Punkt dieser Funktion: die Oberflaeche schreibt bei 0 das Wort
// "unbekannt" hin und erfindet keine Zahl. Ohne Traeger gibt es nichts
// auszuhandeln, also ist die Antwort dann ebenfalls 0.
fn link_speed_on(state: u64, u: u64) -> u64 {
    if kstate.get(state, sc(u, S_LINK)) == 0 {
        return 0
    }
    return kstate.get(state, sc(u, S_SPEED))
}

fn mac_at_on(state: u64, u: u64, i: u64) -> u64 {
    if i >= 6 {
        return 0
    }
    return (kstate.get(state, sc(u, S_MAC)) >> (i * 8)) & 0xFF
}

// ---------------------------------------------------- register access

fn rd32(b: u64, off: u64) -> u64 {
    return __mmio_read32((b + off) as *mut u32) as u64
}

fn wr32(b: u64, off: u64, v: u64) {
    __mmio_write32((b + off) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn reg(state: u64, u: u64, off: u64) -> u64 {
    return rd32(mmio(state, u), off)
}

fn setreg(state: u64, u: u64, off: u64, v: u64) {
    wr32(mmio(state, u), off, v)
}

fn ring(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_RING))
}

// The descriptors are ordinary memory that the CHIP reads and writes.
// Every access goes through the volatile intrinsics for the same reason
// it does in virtio.fi: the compiler must not move or merge them.
fn dsc_addr(t: u64, i: u64, v: u64) {
    __mmio_write64((t + i * 16) as *mut u64, v)
}

fn dsc_len(t: u64, i: u64, v: u64) {
    __mmio_write16((t + i * 16 + 8) as *mut u16, (v & 0xFFFF) as u16)
}

fn dsc_get_len(t: u64, i: u64) -> u64 {
    return __mmio_read16((t + i * 16 + 8) as *mut u16) as u64
}

fn dsc_u8(t: u64, i: u64, off: u64) -> u64 {
    return __mmio_read8((t + i * 16 + off) as *mut u8) as u64
}

fn dsc_set_u8(t: u64, i: u64, off: u64, v: u64) {
    __mmio_write8((t + i * 16 + off) as *mut u8, (v & 0xFF) as u8)
}

// --------------------------------------------------------- finding it

// THE u-TH SUPPORTED INTEL CARD ON THE BUS, in bus order -- the same
// rule `virtio.find` uses, for the same reason: two units must not take
// the same registers.
fn find(state: u64, u: u64) -> u64 {
    let n: u64 = pci.count(state)
    var i: u64 = 0
    var seen: u64 = 0
    while i < n {
        if pci.get(state, i, pci.E_VENDOR) == VENDOR_INTEL {
            if pci.get(state, i, pci.E_CLASS) == CLASS_NET {
                if pci.get(state, i, pci.E_SUBCLASS) == SUB_ETHERNET {
                    if supports(pci.get(state, i, pci.E_DEVICE)) {
                        if seen == u {
                            return i
                        }
                        seen = seen + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return pci.MAX_DEV
}

// ------------------------------------------------------------ the reset
//
// The chip comes out of the firmware in an unknown state -- on a real
// board the BIOS may have used it for PXE. A software reset puts every
// register back to its default, and the manual says to wait for the bit
// to clear and then to mask the interrupts AGAIN, because the reset
// unmasks them.
fn chip_reset(state: u64, u: u64) -> bool {
    setreg(state, u, R_IMC, 0xFFFFFFFF)
    let ctrl: u64 = reg(state, u, R_CTRL)
    setreg(state, u, R_CTRL, ctrl | CTRL_RST)
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        if (reg(state, u, R_CTRL) & CTRL_RST) == 0 {
            setreg(state, u, R_IMC, 0xFFFFFFFF)
            let icr: u64 = reg(state, u, R_ICR)
            return true
        }
        arch.pause()
        spin = spin + 1
    }
    return false
}

// ------------------------------------------------------------ the address

// One 16-bit word out of the chip's own non-volatile memory.
fn eeprom(state: u64, u: u64, word: u64) -> u64 {
    setreg(state, u, R_EERD, (word << 8) | EERD_START)
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        let v: u64 = reg(state, u, R_EERD)
        if (v & EERD_DONE) != 0 {
            return (v >> 16) & 0xFFFF
        }
        arch.pause()
        spin = spin + 1
    }
    return 0xFFFFFFFF
}

// THE ADDRESS, and the two places it can come from. RAL/RAH first: the
// hardware fills them itself at power-up, and a valid bit says whether
// it did. Only if that bit is missing does the driver go to the EEPROM.
// If neither works it refuses -- an invented address on a wire somebody
// else is listening on is a fault that looks like packet loss.
fn read_mac(state: u64, u: u64) -> bool {
    let rah: u64 = reg(state, u, R_RAH)
    if (rah & RAH_AV) != 0 {
        let ral: u64 = reg(state, u, R_RAL)
        let v: u64 = (ral & 0xFFFFFFFF) | ((rah & 0xFFFF) << 32)
        if v != 0 {
            kstate.set(state, sc(u, S_MAC), v)
            kstate.set(state, sc(u, S_MACOK), 1)
            return true
        }
    }
    // RUNDE RTL, PCH-LINIE: hier gibt es KEIN EEPROM an EERD. Die
    // nichtfluechtige Kopie liegt im SPI-Flash des Chipsatzes, hinter
    // einem ganz anderen Registerfenster, und EERD liefert dort Muell.
    // Der zweite Weg ist stattdessen der Wert, den die Firmware VOR dem
    // Ruecksetzen in RAL/RAH stehen hatte -- den hat `init_on`
    // aufgehoben, weil ein Ruecksetzen ihn auf manchen Ausfuehrungen
    // wegwirft.
    if fam(state, u) == FAM_ICH {
        let pre: u64 = kstate.get(state, sc(u, S_PREMAC))
        if pre != 0 && pre != 0xFFFFFFFFFFFF {
            kstate.set(state, sc(u, S_MAC), pre)
            kstate.set(state, sc(u, S_MACOK), 3)
            setreg(state, u, R_RAL, pre & 0xFFFFFFFF)
            setreg(state, u, R_RAH, ((pre >> 32) & 0xFFFF) | RAH_AV)
            return true
        }
        return false
    }
    let w0: u64 = eeprom(state, u, 0)
    let w1: u64 = eeprom(state, u, 1)
    let w2: u64 = eeprom(state, u, 2)
    if w0 > 0xFFFF || w1 > 0xFFFF || w2 > 0xFFFF {
        return false
    }
    // The EEPROM stores the address in three words, low octet first.
    let v: u64 = (w0 & 0xFF) | ((w0 >> 8) << 8) | ((w1 & 0xFF) << 16)
        | ((w1 >> 8) << 24) | ((w2 & 0xFF) << 32) | ((w2 >> 8) << 40)
    if v == 0 {
        return false
    }
    kstate.set(state, sc(u, S_MAC), v)
    kstate.set(state, sc(u, S_MACOK), 2)
    // And write it back into RAL/RAH, because that is the register the
    // receive filter actually uses.
    setreg(state, u, R_RAL, v & 0xFFFFFFFF)
    setreg(state, u, R_RAH, ((v >> 32) & 0xFFFF) | RAH_AV)
    return true
}

// ROUND NIC9020: the texts of the step lines. Module statics and not
// `var`s, for the reason `q_e1000` gives below.
static mut t_0: [u8; 9] = "e1000: s\0"
static mut t_1: [u8; 2] = " \0"
static mut t_2: [u8; 12] = "e1000:     \0"
static mut t_3: [u8; 30] = "nic: init failed: e1000 step \0"
static mut t_4: [u8; 5] = " -- \0"
static mut t_5: [u8; 8] = " (warn=\0"
static mut t_6: [u8; 2] = ")\0"
static mut t_7: [u8; 35] = "ulp: not used on this part, devid=\0"
static mut t_8: [u8; 27] = "ulp: me handshake, 10ms x \0"
static mut t_9: [u8; 22] = "swflag (sw semaphore)\0"
static mut t_10: [u8; 26] = "swflag: not ours, extcnf=\0"
static mut t_11: [u8; 17] = "phy id over mdic\0"
static mut t_12: [u8; 26] = "force smbus, phy id again\0"
static mut t_13: [u8; 25] = "phy reset blocked by me?\0"
static mut t_14: [u8; 16] = "lanphypc toggle\0"
static mut t_15: [u8; 8] = "phy id=\0"
static mut t_16: [u8; 19] = "gio master disable\0"
static mut t_17: [u8; 26] = "irq mask, rx/tx off, 10ms\0"
static mut t_18: [u8; 38] = "global reset, 20ms without any access\0"
static mut t_19: [u8; 17] = "reset bit clear?\0"
static mut t_20: [u8; 20] = "nvm auto-read done?\0"
static mut t_21: [u8; 23] = "phy power up / autoneg\0"
static mut t_22: [u8; 6] = "bmcr=\0"
static mut t_23: [u8; 29] = "first register read (status)\0"
static mut t_24: [u8; 48] = "registers read 0xffffffff, part does not answer\0"
static mut t_25: [u8; 8] = "status=\0"
static mut t_26: [u8; 6] = "ctrl=\0"
static mut t_27: [u8; 10] = "ctrl_ext=\0"
static mut t_28: [u8; 6] = "fwsm=\0"
static mut t_29: [u8; 8] = "extcnf=\0"
static mut t_30: [u8; 8] = "ulp off\0"
static mut t_31: [u8; 31] = "chip did not come out of reset\0"
static mut t_32: [u8; 7] = "pmcsr=\0"
static mut t_33: [u8; 47] = "interrupt: msi, else intx from _prt, else poll\0"
static mut t_34: [u8; 13] = "irq=msi vec=\0"
static mut t_35: [u8; 50] = "irq=none (polled), no msi and no _prt line, 0x3c=\0"
static mut t_36: [u8; 14] = "irq=intx gsi=\0"
static mut t_37: [u8; 35] = "pci: d0, bar0, memory + bus master\0"
static mut t_38: [u8; 27] = "bar0 missing or not memory\0"
static mut t_39: [u8; 22] = "bar0 cannot be mapped\0"
static mut t_40: [u8; 33] = "mac: link up (slu/asde), address\0"
static mut t_41: [u8; 42] = "no mac address (ral/rah empty, no eeprom)\0"
static mut t_42: [u8; 6] = "rings\0"
static mut t_43: [u8; 24] = "no memory for the rings\0"
static mut t_44: [u8; 11] = "link state\0"
static mut t_45: [u8; 15] = "e1000: up phy=\0"
static mut t_46: [u8; 7] = " link=\0"
static mut t_47: [u8; 6] = " irq=\0"
static mut t_48: [u8; 7] = " warn=\0"

// ================================================ ROUND NIC9020: THE PCH LINE
//
// I217 / I218 / I219 -- the LAN part inside the Intel chipset (PCH), and
// the one on Justin's Dell OptiPlex 9020 (00:19.0, 8086:153A, I217-LM,
// Lynx Point). Until this round the kernel HUNG on that machine right
// after `netdev: bestand 1 geraete` -- no further line, and the TICK and
// BEAT counters of the measuring board stood still, i.e. the processor
// itself was stuck and not a loop in this file.
//
// THE CAUSE, read in Linux' e1000e (ich8lan.c, e1000_reset_hw_ich8lan):
//
//     ew32(CTRL, (ctrl | E1000_CTRL_RST));
//     /* cannot issue a flush here because it hangs the hardware */
//     msleep(20);
//
// On the PCH line a register READ right after the global reset hangs the
// part (and with it the processor that waits for the completion). The old
// `chip_reset` did exactly that: write CTRL.RST, then read CTRL in a loop
// at once. On the 8254x family that is the documented way; on the PCH
// line it is the way to stop a machine. It did not hang EVERY time --
// whether the read lands inside the window is a race -- which is why one
// boot with an unrelated word on the command line got through.
//
// WHAT THIS BLOCK DOES, in the order of e1000e for pch_lpt (probe:
// e1000_init_phy_workarounds_pchlan, then e1000_reset_hw_ich8lan):
//
//   s1  PCI: power state D0, memory decode, bus master
//   s2  first register read -- 0xFFFFFFFF means the part does not answer,
//       and the driver gives up before it touches anything else
//   s3  ULP off (I218-LM/V and I219 only; e1000e skips it for I217)
//   s4  software semaphore (EXTCNF_CTRL.SWFLAG), with Linux' timeouts
//   s5  PHY accessible? (PHY ID over MDIC)
//   s6  if not: force SMBus mode, try again
//   s7  if not: is a PHY reset blocked by the ME (FWSM.RSPCIPHY)?
//   s8  if not blocked: toggle LANPHYPC (power-cycles the PHY)
//   s9  GIO master disable, wait for pending requests
//   s10 interrupts masked, receive and send off, 10 ms
//   s11 global reset -- and then 20 ms of NOTHING. No read, no flush.
//   s12 reset bit clear?
//   s13 NVM auto-read done?
//   s14 PHY powered up, auto-negotiation on
//   ...  the common path: address, rings, interrupt, link
//
// EVERY WAIT HAS A LIMIT IN TIME (not in loop turns), and every step
// prints its number BEFORE it touches a register, so that a photo of the
// screen says which step a machine stopped in. A failure prints
// `nic: init failed: e1000 step N -- <reason>` and returns; the boot goes
// on to the desktop without a network.
//
// THE INTERRUPT. The PCH parts have MSI and no MSI-X (e1000e: MSI-X only
// with FLAG_HAS_MSIX, i.e. the 82574). This block asks for MSI. The pin
// through the I/O APIC is taken only with `nicintx` or when there is no
// MSI capability -- and then only with a line from `_PRT`; the old
// fallback to config register 0x3C is a PIC number, not an I/O APIC
// input, on a board in APIC mode. With neither, the card is polled: the
// network task turns every tick anyway (`inet.netd_body`).
//
// WHAT IS STILL NOT HERE: the descriptor-ring flush of SPT and later
// (I219, `e1000_flush_desc_rings`) -- only reported (s10, `flush=1`);
// K1/LTR/EEE tuning; the PHY reset with LCD configuration from NVM.

const R_EECD: u64 = 0x0010
const EECD_AUTO_RD: u64 = 0x200
const R_FEXTNVM3: u64 = 0x003C
const FEXTNVM3_CFG_MASK: u64 = 0x0C000000
const FEXTNVM3_CFG_50MS: u64 = 0x08000000
const FEXTNVM7_DIS_SMB_PERST: u64 = 0x20
const R_KABGTXD: u64 = 0x3004
const KABGTXD_BGSQLBIAS: u64 = 0x50000
const R_H2ME: u64 = 0x5B50
const H2ME_ULP: u64 = 0x800
const H2ME_ENFORCE: u64 = 0x1000
const R_FWSM: u64 = 0x5B54
const FWSM_RSPCIPHY: u64 = 0x40
const FWSM_ULP_CFG_DONE: u64 = 0x400
const FWSM_FW_VALID: u64 = 0x8000
const CTRL_GIO_MASTER_DISABLE: u64 = 4
const STATUS_GIO_MASTER_EN: u64 = 0x80000
const CTRL_LANPHYPC_OVERRIDE: u64 = 0x10000
const CTRL_LANPHYPC_VALUE: u64 = 0x20000
const CTRL_EXT_LPCD: u64 = 4
const CTRL_EXT_FORCE_SMBUS: u64 = 0x800

// PHY registers of the HV/LV PHYs (82577 and later), as e1000e names
// them. Pages >= 768 sit at MDIO address 1, everything below at 2; a
// register above 15 needs the page written into register 31 first.
const PHY_FAIL: u64 = 0xFFFFFFFF
const PHY_PAGE_SELECT: u64 = 0x1F
const PAGE_INTC: u64 = 768
const CV_SMB_PAGE: u64 = 769
const CV_SMB_REG: u64 = 23
const CV_SMB_FORCE: u64 = 1
const HV_PM_PAGE: u64 = 770
const HV_PM_REG: u64 = 17
const HV_PM_K1: u64 = 0x4000
const ULP1_PAGE: u64 = 779
const ULP1_REG: u64 = 16
const ULP1_START: u64 = 1
const ULP1_CLEAR: u64 = 0x1D74 // IND|STICKY|INBAND|WOL|RESET_TO_SMBUS|EN_LANPHYPC|DIS_CLR|DIS_SMB_PERST
const MII_BMCR: u64 = 0
const BMCR_ANRESTART: u64 = 0x200
const BMCR_PDOWN: u64 = 0x800
const BMCR_ANENABLE: u64 = 0x1000

// Per unit, behind round O-NETZUI's S_SPEED.
const S_STEP: u64 = 0xC0 // the step the bring-up is in (or stopped in)
const S_WARN: u64 = 0xC8 // W_* bits: what did not work but was survivable
const S_IRQMODE: u64 = 0xD0 // IRQ_* below
const S_GSI: u64 = 0xD8 // the I/O APIC input, when INTx
const S_SPUR: u64 = 0xE0 // interrupts in a row that were not ours
const S_STORM: u64 = 0xE8 // 1 = the line was masked because of a storm
const S_TFLAGS: u64 = 0xF0 // unit 0 only: the test words, see set_flags
const S_FOUND: u64 = 0xF8 // 1 = a supported card sits at this unit
const S_SPURT0: u64 = 0x100 // cycle counter at the start of the storm window

const IRQ_NONE: u64 = 0 // polled by the network task
const IRQ_INTX: u64 = 1
const IRQ_MSI: u64 = 2

const W_SWHELD: u64 = 1 // semaphore held by somebody else
const W_SWFAIL: u64 = 2 // semaphore did not stick
const W_PHY: u64 = 4 // PHY not accessible
const W_BLOCKED: u64 = 8 // PHY reset blocked by the ME
const W_ULPME: u64 = 16 // ME did not finish the ULP handshake
const W_ULPPHY: u64 = 32 // ULP registers not reachable
const W_GIO: u64 = 64 // master requests still pending
const W_AUTORD: u64 = 128 // NVM auto-read did not finish
const W_FLUSH: u64 = 256 // SPT+: descriptor flush would be required
const W_STORM: u64 = 512 // interrupt storm, line masked

const TF_ICH: u64 = 1 // `nicich`: drive an 82574 through the PCH path
const TF_FAIL: u64 = 2 // `nicfail`: pretend the reset never finished
const TF_INTX: u64 = 4 // `nicintx`: the pin, not MSI

// How many interrupts in a row may find ICR empty before the line is
// called a storm and masked. A level line that nobody drives low again
// fires as fast as the processor can take it -- that is millions per
// second, and the timer below never gets its turn.
const STORM_LIMIT: u64 = 20000

fn set_flags(state: u64, force_ich: bool, fail: bool, intx: bool) {
    var f: u64 = 0
    if force_ich { f = f | TF_ICH }
    if fail { f = f | TF_FAIL }
    if intx { f = f | TF_INTX }
    kstate.set(state, sc(0, S_TFLAGS), f)
}

fn tflag(state: u64, bit: u64) -> bool {
    return (kstate.get(state, sc(0, S_TFLAGS)) & bit) != 0
}

fn warn(state: u64, u: u64, bit: u64) {
    kstate.set(state, sc(u, S_WARN), kstate.get(state, sc(u, S_WARN)) | bit)
}

fn warn_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_WARN))
}

fn step_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_STEP))
}

fn irq_mode_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_IRQMODE))
}

fn storm_on(state: u64, u: u64) -> bool {
    return kstate.get(state, sc(u, S_STORM)) != 0
}

// A pause in MICROSECONDS on the cycle counter `apic.calibrate` measured
// against the PIT -- the same clock `smp.udelay` uses, and like it, it
// needs no interrupt. Without a calibration it falls back to a count.
fn udelay(state: u64, us: u64) {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        var i: u64 = 0
        while i < us * 100 {
            arch.pause()
            i = i + 1
        }
        return
    }
    let want: u64 = hz / 1000000 * us
    let t0: u64 = apic.tsc()
    while apic.tsc() - t0 < want {
        arch.pause()
    }
}

// THE STEP LINE. It is printed BEFORE the step touches the chip -- a line
// printed afterwards would be missing exactly when it matters.
fn step(state: u64, u: u64, n: u64, what: u64) {
    kstate.set(state, sc(u, S_STEP), n)
    if fam(state, u) != FAM_ICH {
        return
    }
    serial.puts((&t_0[0]) as u64)
    serial.dec(n)
    serial.puts((&t_1[0]) as u64)
    serial.puts(what)
    serial.nl()
}

fn note(state: u64, u: u64, what: u64, v: u64) {
    if fam(state, u) != FAM_ICH {
        return
    }
    serial.puts((&t_2[0]) as u64)
    serial.puts(what)
    serial.hex(v)
    serial.nl()
}

// GIVE UP, SAY WHY, LEAVE THE CHIP QUIET. `dead` means the part does not
// answer register reads -- then nothing is written to it any more.
fn fail(state: u64, u: u64, why: u64, dead: bool) -> bool {
    serial.puts((&t_3[0]) as u64)
    serial.dec(step_on(state, u))
    serial.puts((&t_4[0]) as u64)
    serial.puts(why)
    serial.puts((&t_5[0]) as u64)
    serial.hex(warn_on(state, u))
    serial.puts((&t_6[0]) as u64)
    serial.nl()
    if !dead && mmio(state, u) != 0 {
        setreg(state, u, R_IMC, 0xFFFFFFFF)
        setreg(state, u, R_RCTL, 0)
        setreg(state, u, R_TCTL, 0)
    }
    pci.disable_master(bdf_on(state, u))
    kstate.set(state, sc(u, S_READY), 0)
    kstate.set(state, sc(u, S_MMIO), 0)
    return false
}

// ------------------------------------------------ the semaphore
//
// e1000_acquire_swflag_ich8lan: wait up to PHY_CFG_TIMEOUT (100 ms) for
// the flag to be free, set it, and wait up to SW_FLAG_TIMEOUT (1000 ms)
// for it to stick. If it does not stick, the firmware owns the bus and
// this driver keeps its hands off the PHY -- the data path may still
// work, because the firmware negotiated a link on its own.
fn swflag_take(state: u64, u: u64) -> bool {
    if kstate.get(state, sc(u, S_SWFLAG)) != 0 {
        return true
    }
    var t: u64 = 0
    var v: u64 = reg(state, u, R_EXTCNF_CTRL)
    while (v & EXTCNF_SWFLAG) != 0 && t < 100 {
        udelay(state, 1000)
        t = t + 1
        v = reg(state, u, R_EXTCNF_CTRL)
    }
    if (v & EXTCNF_SWFLAG) != 0 {
        warn(state, u, W_SWHELD)
        return false
    }
    setreg(state, u, R_EXTCNF_CTRL, v | EXTCNF_SWFLAG)
    t = 0
    while t < 1000 {
        if (reg(state, u, R_EXTCNF_CTRL) & EXTCNF_SWFLAG) != 0 {
            kstate.set(state, sc(u, S_SWFLAG), 1)
            return true
        }
        udelay(state, 1000)
        t = t + 1
    }
    setreg(state, u, R_EXTCNF_CTRL,
        reg(state, u, R_EXTCNF_CTRL) & (~EXTCNF_SWFLAG))
    warn(state, u, W_SWFAIL)
    return false
}

fn swflag_give(state: u64, u: u64) {
    if kstate.get(state, sc(u, S_SWFLAG)) == 0 {
        return
    }
    let v: u64 = reg(state, u, R_EXTCNF_CTRL)
    setreg(state, u, R_EXTCNF_CTRL, v & (~EXTCNF_SWFLAG))
    kstate.set(state, sc(u, S_SWFLAG), 0)
}

// ------------------------------------------------ the wire to the PHY
//
// One MDIC transaction, e1000e_read/write_phy_reg_mdic: at most
// 3 * E1000_GEN_POLL_TIMEOUT polls 50 us apart (96 ms), and the answer
// counts only with READY set, ERROR clear and the SAME register number
// echoed back. PHY_FAIL is not a register value -- a PHY answers 16 bits.
fn mdic_op(state: u64, u: u64, addr: u64, r: u64, op: u64, val: u64) -> u64 {
    setreg(state, u, R_MDIC, op | ((addr & 0x1F) << 21) | ((r & 0x1F) << 16)
        | (val & 0xFFFF))
    var i: u64 = 0
    while i < 1920 {
        udelay(state, 50)
        let v: u64 = reg(state, u, R_MDIC)
        if (v & MDIC_READY) != 0 {
            if (v & MDIC_ERROR) != 0 {
                return PHY_FAIL
            }
            if ((v >> 16) & 0x1F) != (r & 0x1F) {
                return PHY_FAIL
            }
            return v & 0xFFFF
        }
        i = i + 1
    }
    return PHY_FAIL
}

// e1000_read_phy_reg_hv: address 1 for the pages from 768 up, 2 below;
// the page goes into register 31 (at address 1) when the register is
// above 15. Page 0 falls back to address 1 when 2 says nothing -- that is
// where the 82574's PHY sits, and it costs a real PCH nothing.
fn phy_addr_for(page: u64) -> u64 {
    if page >= PAGE_INTC {
        return 1
    }
    return 2
}

fn phy_page(state: u64, u: u64, page: u64, r: u64) -> bool {
    if r <= 15 {
        return true
    }
    var p: u64 = page
    if p == PAGE_INTC {
        p = 0
    }
    return mdic_op(state, u, 1, PHY_PAGE_SELECT, MDIC_OP_WRITE, p << 5) != PHY_FAIL
}

fn phy_rd(state: u64, u: u64, page: u64, r: u64) -> u64 {
    if !phy_page(state, u, page, r) {
        return PHY_FAIL
    }
    let v: u64 = mdic_op(state, u, phy_addr_for(page), r, MDIC_OP_READ, 0)
    if v == PHY_FAIL && page == 0 {
        return mdic_op(state, u, 1, r, MDIC_OP_READ, 0)
    }
    return v
}

fn phy_wr(state: u64, u: u64, page: u64, r: u64, val: u64) -> bool {
    if !phy_page(state, u, page, r) {
        return false
    }
    if mdic_op(state, u, phy_addr_for(page), r, MDIC_OP_WRITE, val) != PHY_FAIL {
        return true
    }
    if page == 0 {
        return mdic_op(state, u, 1, r, MDIC_OP_WRITE, val) != PHY_FAIL
    }
    return false
}

// The old names, for `read_link` and the selftest.
fn mdic_read(state: u64, u: u64, r: u64) -> u64 {
    return phy_rd(state, u, 0, r)
}

fn mdic_write(state: u64, u: u64, r: u64, val: u64) -> bool {
    return phy_wr(state, u, 0, r, val)
}

// e1000_phy_is_accessible_pchlan: PHY ID 1 and 2, two tries. Stores the
// ID when there is one. On LPT and later, with no ME firmware active,
// SMBus mode is unforced on both sides afterwards.
fn phy_accessible(state: u64, u: u64) -> bool {
    var tries: u64 = 0
    var id: u64 = 0
    while tries < 2 && id == 0 {
        let a: u64 = phy_rd(state, u, 0, 2)
        if a != PHY_FAIL && a != 0xFFFF {
            let b: u64 = phy_rd(state, u, 0, 3)
            if b != PHY_FAIL && b != 0xFFFF {
                id = (a << 16) | (b & 0xFFF0)
            }
        }
        tries = tries + 1
    }
    if id == 0 {
        kstate.set(state, sc(u, S_PHYID), 0xFFFFFFFF)
        return false
    }
    kstate.set(state, sc(u, S_PHYID), id)
    if (reg(state, u, R_FWSM) & FWSM_FW_VALID) == 0 {
        let s: u64 = phy_rd(state, u, CV_SMB_PAGE, CV_SMB_REG)
        if s != PHY_FAIL {
            let w: bool = phy_wr(state, u, CV_SMB_PAGE, CV_SMB_REG,
                s & (~CV_SMB_FORCE))
        }
        setreg(state, u, R_CTRL_EXT,
            reg(state, u, R_CTRL_EXT) & (~CTRL_EXT_FORCE_SMBUS))
    }
    return true
}

// e1000_toggle_lanphypc_pch_lpt: PHY config counter to 50 ms, drive the
// LANPHYPC pin low for 10 us under software control, let go, then wait
// for LPCD (at most 20 x 5 ms) and 30 ms more.
fn toggle_lanphypc(state: u64, u: u64) {
    var v: u64 = reg(state, u, R_FEXTNVM3)
    v = (v & (~FEXTNVM3_CFG_MASK)) | FEXTNVM3_CFG_50MS
    setreg(state, u, R_FEXTNVM3, v)
    var c: u64 = reg(state, u, R_CTRL)
    c = (c | CTRL_LANPHYPC_OVERRIDE) & (~CTRL_LANPHYPC_VALUE)
    setreg(state, u, R_CTRL, c)
    let f1: u64 = reg(state, u, R_STATUS)
    udelay(state, 20)
    c = c & (~CTRL_LANPHYPC_OVERRIDE)
    setreg(state, u, R_CTRL, c)
    let f2: u64 = reg(state, u, R_STATUS)
    var n: u64 = 0
    while n < 20 {
        udelay(state, 5000)
        if (reg(state, u, R_CTRL_EXT) & CTRL_EXT_LPCD) != 0 {
            n = 20
        }
        n = n + 1
    }
    udelay(state, 30000)
}

// e1000_check_reset_block_ich8lan: the ME may forbid resetting the PHY;
// it says so by keeping FWSM.RSPCIPHY clear. Up to 30 x 10 ms.
fn phy_reset_blocked(state: u64, u: u64) -> bool {
    var i: u64 = 0
    while i < 30 {
        if (reg(state, u, R_FWSM) & FWSM_RSPCIPHY) != 0 {
            return false
        }
        udelay(state, 10000)
        i = i + 1
    }
    return (reg(state, u, R_FWSM) & FWSM_RSPCIPHY) == 0
}

// e1000_disable_ulp_lpt_lp with force. Not for I217-LM/V and I218-LM2/V2
// -- e1000e leaves those alone, and so does this.
fn ulp_applies(devid: u64) -> bool {
    if devid == 0x153A || devid == 0x153B {
        return false
    }
    if devid == 0x15A0 || devid == 0x15A1 {
        return false
    }
    return true
}

fn ulp_off(state: u64, u: u64) {
    if !ulp_applies(kstate.get(state, sc(u, S_DEVID))) {
        note(state, u, (&t_7[0]) as u64,
            kstate.get(state, sc(u, S_DEVID)))
        return
    }
    if (reg(state, u, R_FWSM) & FWSM_FW_VALID) != 0 {
        // The ME owns ULP: ask it, and wait up to 2.5 s for its answer.
        var h: u64 = reg(state, u, R_H2ME)
        setreg(state, u, R_H2ME, (h & (~H2ME_ULP)) | H2ME_ENFORCE)
        var i: u64 = 0
        while (reg(state, u, R_FWSM) & FWSM_ULP_CFG_DONE) != 0 && i < 250 {
            udelay(state, 10000)
            i = i + 1
        }
        if i >= 250 {
            warn(state, u, W_ULPME)
        }
        h = reg(state, u, R_H2ME)
        setreg(state, u, R_H2ME, h & (~H2ME_ENFORCE))
        note(state, u, (&t_8[0]) as u64, i)
        return
    }
    if !swflag_take(state, u) {
        return
    }
    toggle_lanphypc(state, u)
    var s: u64 = phy_rd(state, u, CV_SMB_PAGE, CV_SMB_REG)
    if s == PHY_FAIL {
        setreg(state, u, R_CTRL_EXT,
            reg(state, u, R_CTRL_EXT) | CTRL_EXT_FORCE_SMBUS)
        udelay(state, 50000)
        s = phy_rd(state, u, CV_SMB_PAGE, CV_SMB_REG)
    }
    if s == PHY_FAIL {
        warn(state, u, W_ULPPHY)
        swflag_give(state, u)
        return
    }
    let w1: bool = phy_wr(state, u, CV_SMB_PAGE, CV_SMB_REG, s & (~CV_SMB_FORCE))
    setreg(state, u, R_CTRL_EXT,
        reg(state, u, R_CTRL_EXT) & (~CTRL_EXT_FORCE_SMBUS))
    let pm: u64 = phy_rd(state, u, HV_PM_PAGE, HV_PM_REG)
    if pm != PHY_FAIL {
        let w2: bool = phy_wr(state, u, HV_PM_PAGE, HV_PM_REG, pm | HV_PM_K1)
    }
    let c: u64 = phy_rd(state, u, ULP1_PAGE, ULP1_REG)
    if c != PHY_FAIL {
        let c2: u64 = c & (~ULP1_CLEAR)
        let w3: bool = phy_wr(state, u, ULP1_PAGE, ULP1_REG, c2)
        let w4: bool = phy_wr(state, u, ULP1_PAGE, ULP1_REG, c2 | ULP1_START)
    }
    setreg(state, u, R_FEXTNVM7,
        reg(state, u, R_FEXTNVM7) & (~FEXTNVM7_DIS_SMB_PERST))
    swflag_give(state, u)
    udelay(state, 50000)
}

// e1000_init_phy_workarounds_pchlan, the pch_lpt branch.
fn phy_wake(state: u64, u: u64) {
    step(state, u, 4, (&t_9[0]) as u64)
    if !swflag_take(state, u) {
        note(state, u, (&t_10[0]) as u64,
            reg(state, u, R_EXTCNF_CTRL))
        return
    }
    step(state, u, 5, (&t_11[0]) as u64)
    if !phy_accessible(state, u) {
        step(state, u, 6, (&t_12[0]) as u64)
        setreg(state, u, R_CTRL_EXT,
            reg(state, u, R_CTRL_EXT) | CTRL_EXT_FORCE_SMBUS)
        udelay(state, 50000)
        if !phy_accessible(state, u) {
            step(state, u, 7, (&t_13[0]) as u64)
            if phy_reset_blocked(state, u) {
                warn(state, u, W_BLOCKED)
                warn(state, u, W_PHY)
            } else {
                step(state, u, 8, (&t_14[0]) as u64)
                toggle_lanphypc(state, u)
                if !phy_accessible(state, u) {
                    setreg(state, u, R_CTRL_EXT,
                        reg(state, u, R_CTRL_EXT) & (~CTRL_EXT_FORCE_SMBUS))
                    if !phy_accessible(state, u) {
                        warn(state, u, W_PHY)
                    }
                }
            }
        }
    }
    note(state, u, (&t_15[0]) as u64, kstate.get(state, sc(u, S_PHYID)))
    swflag_give(state, u)
}

// e1000_reset_hw_ich8lan without the PHY reset. The PHY reset would need
// the LCD configuration out of the NVM afterwards (sw_lcd_config), and a
// PHY that the firmware configured is better left as it is than
// half-configured by a driver that cannot read the NVM.
fn ich_reset(state: u64, u: u64) -> bool {
    step(state, u, 9, (&t_16[0]) as u64)
    setreg(state, u, R_CTRL, reg(state, u, R_CTRL) | CTRL_GIO_MASTER_DISABLE)
    var t: u64 = 0
    while (reg(state, u, R_STATUS) & STATUS_GIO_MASTER_EN) != 0 && t < 800 {
        udelay(state, 100)
        t = t + 1
    }
    if t >= 800 {
        warn(state, u, W_GIO)
    }
    step(state, u, 10, (&t_17[0]) as u64)
    // SPT and later: a ring the firmware left running needs a flush the
    // driver cannot do yet. Said, not done (PCI config 0xE4, bit 8).
    if (pci.cfg_read16(bdf_on(state, u), 0xE4) & 0x100) != 0 {
        warn(state, u, W_FLUSH)
    }
    setreg(state, u, R_IMC, 0xFFFFFFFF)
    setreg(state, u, R_RCTL, 0)
    setreg(state, u, R_TCTL, TCTL_PSP)
    let fl: u64 = reg(state, u, R_STATUS)
    udelay(state, 10000)
    let ctrl: u64 = reg(state, u, R_CTRL)
    let sw: bool = swflag_take(state, u)
    step(state, u, 11, (&t_18[0]) as u64)
    setreg(state, u, R_CTRL, ctrl | CTRL_RST)
    // NOTHING HERE. Not a read, not a flush -- see the head of this block.
    udelay(state, 20000)
    // The reset took the semaphore with it (EXTCNF_CTRL is reset).
    kstate.set(state, sc(u, S_SWFLAG), 0)
    step(state, u, 12, (&t_19[0]) as u64)
    if tflag(state, TF_FAIL) {
        return false
    }
    t = 0
    while (reg(state, u, R_CTRL) & CTRL_RST) != 0 {
        if t >= 100 {
            return false
        }
        udelay(state, 1000)
        t = t + 1
    }
    step(state, u, 13, (&t_20[0]) as u64)
    t = 0
    while (reg(state, u, R_EECD) & EECD_AUTO_RD) == 0 && t < 10 {
        udelay(state, 1000)
        t = t + 1
    }
    if t >= 10 {
        warn(state, u, W_AUTORD)
    }
    setreg(state, u, R_IMC, 0xFFFFFFFF)
    let icr: u64 = reg(state, u, R_ICR)
    setreg(state, u, R_KABGTXD, reg(state, u, R_KABGTXD) | KABGTXD_BGSQLBIAS)
    return true
}

// e1000_power_up_phy_copper plus a restart of auto-negotiation -- but
// only if the PHY was powered down or had auto-negotiation off. A link
// the firmware already brought up is not dropped for nothing.
fn phy_power_up(state: u64, u: u64) {
    step(state, u, 14, (&t_21[0]) as u64)
    if (warn_on(state, u) & W_PHY) != 0 {
        return
    }
    if !swflag_take(state, u) {
        return
    }
    let b: u64 = phy_rd(state, u, 0, MII_BMCR)
    if b != PHY_FAIL {
        note(state, u, (&t_22[0]) as u64, b)
        if (b & BMCR_PDOWN) != 0 || (b & BMCR_ANENABLE) == 0 {
            let w: bool = phy_wr(state, u, 0, MII_BMCR,
                (b & (~BMCR_PDOWN)) | BMCR_ANENABLE | BMCR_ANRESTART)
        }
    }
    swflag_give(state, u)
}

// THE PCH BRING-UP, from the first register read to the end of the reset.
// `false` = the part is not usable; `fail` has already said why.
fn ich_bringup(state: u64, u: u64) -> bool {
    step(state, u, 2, (&t_23[0]) as u64)
    let st: u64 = reg(state, u, R_STATUS)
    if st == 0xFFFFFFFF {
        return fail(state, u, (&t_24[0]) as u64, true)
    }
    note(state, u, (&t_25[0]) as u64, st)
    note(state, u, (&t_26[0]) as u64, reg(state, u, R_CTRL))
    note(state, u, (&t_27[0]) as u64, reg(state, u, R_CTRL_EXT))
    note(state, u, (&t_28[0]) as u64, reg(state, u, R_FWSM))
    note(state, u, (&t_29[0]) as u64, reg(state, u, R_EXTCNF_CTRL))
    // The address the firmware left in RAL/RAH, BEFORE the reset.
    let prah: u64 = reg(state, u, R_RAH)
    if (prah & RAH_AV) != 0 {
        kstate.set(state, sc(u, S_PREMAC),
            (reg(state, u, R_RAL) & 0xFFFFFFFF) | ((prah & 0xFFFF) << 32))
    }
    step(state, u, 3, (&t_30[0]) as u64)
    ulp_off(state, u)
    phy_wake(state, u)
    if !ich_reset(state, u) {
        return fail(state, u, (&t_31[0]) as u64, false)
    }
    phy_power_up(state, u)
    return true
}

// PCI power state D0, before the first register access. A part left in
// D3hot answers config space and nothing else.
fn pci_d0(state: u64, u: u64) {
    let d: u64 = bdf_on(state, u)
    let pm: u64 = pci.cap_find(d, 0x01)
    if pm == 0 {
        return
    }
    let csr: u64 = pci.cfg_read16(d, pm + 4)
    note(state, u, (&t_32[0]) as u64, csr)
    if (csr & 3) != 0 {
        pci.cfg_write16(d, pm + 4, csr & 0xFFFC)
        udelay(state, 10000)
    }
}

// ------------------------------------------------ the interrupt, PCH line

fn msi_arm(state: u64, u: u64, i: u64, vec: u64, armed: bool) -> bool {
    let d: u64 = pci.get(state, i, pci.E_BDF)
    let cap: u64 = pci.get(state, i, pci.E_MSI)
    if cap == 0 {
        return false
    }
    let ctrl: u64 = pci.cfg_read16(d, cap + 2)
    pci.cfg_write32(d, cap + 4,
        apic.lapic_phys(state) | ((apic.id(state) & 0xFF) << 12))
    var datoff: u64 = cap + 8
    if (ctrl & 0x80) != 0 {
        pci.cfg_write32(d, cap + 8, 0)
        datoff = cap + 12
    }
    pci.cfg_write16(d, datoff, vec & 0xFF)
    var neu: u64 = ctrl & 0xFF8E
    if armed {
        neu = neu | 1
    }
    pci.cfg_write16(d, cap + 2, neu)
    // The pin off, or the part reports twice.
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) | 0x400)
    return true
}

// MSI first, the pin only when asked for or when there is no MSI, and
// then only with a line the firmware named. Otherwise: polled.
fn ich_irq(state: u64, u: u64, i: u64, armed: bool, vec: u64) {
    step(state, u, 17, (&t_33[0]) as u64)
    kstate.set(state, sc(u, S_IRQMODE), IRQ_NONE)
    if vec == 0 {
        return
    }
    let want_pin: bool = tflag(state, TF_INTX)
    if !want_pin && pci.get(state, i, pci.E_MSI) != 0 {
        if msi_arm(state, u, i, vec, armed) {
            kstate.set(state, sc(u, S_IRQMODE), IRQ_MSI)
            note(state, u, (&t_34[0]) as u64, vec)
            return
        }
    }
    let d: u64 = pci.get(state, i, pci.E_BDF)
    let pin: u64 = pci.get(state, i, pci.E_IRQPIN)
    var gsi: u64 = 0xFFFFFFFF
    if pin >= 1 && pin <= 4 {
        gsi = aml.gsi_for(state, pci.bdf_bus(d), pci.bdf_dev(d), pin - 1)
    }
    if gsi == 0xFFFFFFFF && want_pin {
        // `nicintx` asked for the pin explicitly: the old way, 0x3C.
        gsi = pci.get(state, i, pci.E_IRQLINE)
    }
    if gsi == 0 || gsi > 23 {
        note(state, u, (&t_35[0]) as u64,
            pci.get(state, i, pci.E_IRQLINE))
        pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) | 0x400)
        return
    }
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) & 0xFBFF)
    kstate.set(state, sc(u, S_GSI), gsi)
    kstate.set(state, sc(u, S_SPUR), 0)
    apic.route(state, gsi, vec, apic.id(state), true, true)
    if !armed {
        apic.mask_gsi(state, gsi)
    }
    kstate.set(state, sc(u, S_IRQMODE), IRQ_INTX)
    note(state, u, (&t_36[0]) as u64, gsi)
}

fn read_link(state: u64, u: u64) {
    var v: u64 = 0
    if (reg(state, u, R_STATUS) & STATUS_LU) != 0 {
        v = 1
    }
    // RUNDE RTL: auf der PCH-Linie kann der MAC die Verbindung noch nicht
    // sehen, waehrend der PHY sie laengst hat -- die beiden haengen an
    // verschiedenen Takten. Also wird der PHY gefragt, wenn der MAC
    // schweigt. Zweimal, weil BMSR.LINK ein rastendes Bit ist: die erste
    // Antwort meldet, ob die Verbindung SEIT DEM LETZTEN LESEN weg war,
    // die zweite, ob sie JETZT steht.
    if v == 0 && fam(state, u) == FAM_ICH {
        if swflag_take(state, u) {
            let first: u64 = mdic_read(state, u, 1)
            let second: u64 = mdic_read(state, u, 1)
            swflag_give(state, u)
            if second != 0xFFFFFFFF {
                if (second & BMSR_LINK) != 0 {
                    v = 1
                }
            }
        }
    }
    kstate.set(state, sc(u, S_LINK), v)
    // RUNDE O-NETZUI: die Rate aus DEMSELBEN Register, aus dem die
    // Traegerfrage oben schon gelesen hat -- ohne Traeger ist sie 0.
    var mbit: u64 = 0
    if v != 0 {
        let st: u64 = reg(state, u, R_STATUS)
        let bits: u64 = (st >> STATUS_SPEED_SHIFT) & STATUS_SPEED_MASK
        if bits == 0 {
            mbit = 10
        } else if bits == 1 {
            mbit = 100
        } else {
            mbit = 1000
        }
    }
    kstate.set(state, sc(u, S_SPEED), mbit)
}

// ------------------------------------------------------------- the init

// RUNDE BLECH: `vec` ist der Meldevektor, den `netdev.fi` fuer DIESE
// KARTE vergeben hat -- nicht `45 + u` aus der eigenen Einheitennummer.
// Zwei Treiber mit je einer Karte haetten sonst beide Vektor 45, und
// `trap.fi` gibt 45 an Karte 0. `vec == 0` heisst: keine Unterbrechung,
// diese Karte wird abgefragt.
// RUNDE PROTOKOLL: die Quelle dieses Treibers im Ring. Siehe `nvme.lq`.
// Der Name liegt als `static mut` im Modul und nicht als `var` in
// dieser Funktion: eine lokale Zeichenkette stirbt mit dem Rahmen,
// und firnc faengt genau das ab ("the address of the local escapes
// through the return value"). Der Protokollring liest den Namen
// erst im Aufruf danach.
static mut q_e1000: [u8; 6] = "e1000\0"

fn lq() -> u64 {
    return (&q_e1000[0]) as u64
}

fn init_on(state: u64, u: u64, use_msix: bool, armed: bool,
    vec: u64) -> bool {
    if u >= MAX_UNITS {
        return false
    }
    var l_kein: [u8; 33] = "keine Karte an dieser Einheit, u\0"
    var l_da: [u8; 26] = "Karte gefunden, devid \0\0\0\0"
    kstate.set(state, sc(u, S_READY), 0)
    kstate.set(state, sc(u, S_FOUND), 0)
    kstate.set(state, sc(u, S_STEP), 0)
    kstate.set(state, sc(u, S_WARN), 0)
    kstate.set(state, sc(u, S_IRQMODE), IRQ_NONE)
    kstate.set(state, sc(u, S_GSI), 0)
    kstate.set(state, sc(u, S_SPUR), 0)
    kstate.set(state, sc(u, S_SPURT0), 0)
    kstate.set(state, sc(u, S_STORM), 0)
    let i: u64 = find(state, u)
    if i >= pci.MAX_DEV {
        klog.sayn(state, klog.L_DEBUG, lq(), (&l_kein[0]) as u64, u)
        return false
    }
    let d: u64 = pci.get(state, i, pci.E_BDF)
    let devid: u64 = pci.get(state, i, pci.E_DEVICE)
    kstate.set(state, sc(u, S_IDX), i)
    kstate.set(state, sc(u, S_BDF), d)
    kstate.set(state, sc(u, S_DEVID), devid)
    klog.sayh(state, klog.L_INFO, lq(), (&l_da[0]) as u64, devid)
    // RUNDE RTL: welche der beiden Familien. Alles, was danach anders
    // laeuft, haengt an dieser einen Zahl. ROUND NIC9020: `nicich` sends
    // QEMU's 82574 down the PCH path, so that path runs somewhere before
    // it runs on a board.
    var fm: u64 = family_of(devid)
    if tflag(state, TF_ICH) {
        fm = FAM_ICH
    }
    kstate.set(state, sc(u, S_FAM), fm)
    kstate.set(state, sc(u, S_PREMAC), 0)
    kstate.set(state, sc(u, S_PHYID), 0)
    kstate.set(state, sc(u, S_SWFLAG), 0)
    kstate.set(state, sc(u, S_FOUND), 1)

    // BAR0, and it has to be MEMORY. An 8254x also offers an I/O BAR;
    // this driver does not use it, and a card whose BAR0 is I/O is not
    // one of these.
    step(state, u, 1, (&t_37[0]) as u64)
    let phys: u64 = pci.bar(state, i, 0)
    if phys == 0 || pci.bar_is_io(state, i, 0) {
        return fail(state, u, (&t_38[0]) as u64, true)
    }
    if fm == FAM_ICH {
        pci_d0(state, u)
    }
    let base: u64 = apic.map_device(state, phys)
    if base == 0 {
        return fail(state, u, (&t_39[0]) as u64, true)
    }
    kstate.set(state, sc(u, S_MMIO), base)

    // Without this bit the chip may answer registers but may not fetch a
    // descriptor -- the same counter-check `nicnobm` makes for virtio.
    pci.enable_master(d)

    if fm == FAM_ICH {
        if !ich_bringup(state, u) {
            return false
        }
    } else {
        if !chip_reset(state, u) {
            return fail(state, u, (&t_31[0]) as u64, false)
        }
    }

    // The link: let the chip negotiate it. LRST and ILOS have to be off,
    // and VLAN mode too -- a tagged frame the stack does not expect is a
    // frame with four octets of rubbish in the middle.
    step(state, u, 15, (&t_40[0]) as u64)
    var ctrl: u64 = reg(state, u, R_CTRL)
    ctrl = ctrl | CTRL_SLU | CTRL_ASDE
    ctrl = ctrl & 0xFFFFFFFF
    if (ctrl & CTRL_LRST) != 0 { ctrl = ctrl - CTRL_LRST }
    if (ctrl & CTRL_ILOS) != 0 { ctrl = ctrl - CTRL_ILOS }
    if (ctrl & CTRL_VME) != 0 { ctrl = ctrl - CTRL_VME }
    setreg(state, u, R_CTRL, ctrl)

    if !read_mac(state, u) {
        return fail(state, u, (&t_41[0]) as u64, false)
    }

    // The multicast table comes out of reset with whatever was in it.
    // 128 registers of zero means: no multicast group is accepted, which
    // is the truth for this stack.
    step(state, u, 16, (&t_42[0]) as u64)
    var m: u64 = 0
    while m < 128 {
        setreg(state, u, R_MTA + m * 4, 0)
        m = m + 1
    }

    // The memory for both rings and all their buffers, in ONE run of
    // frames: a descriptor carries a PHYSICAL address and the heap gives
    // no promise about contiguity.
    let r: u64 = mem.frame_run(state, RING_BYTES / mem.FRAME_SIZE)
    if r == 0 {
        return fail(state, u, (&t_43[0]) as u64, false)
    }
    var z: u64 = 0
    while z < RING_BYTES {
        __mmio_write64((r + z) as *mut u64, 0)
        z = z + 8
    }
    kstate.set(state, sc(u, S_RING), r)

    rx_setup(state, u)
    tx_setup(state, u)

    // THE INTERRUPT IS ARMED BEFORE THE RINGS ARE ENABLED, the same
    // order virtio uses. The 8254x family takes the pin as before; the
    // PCH line asks for MSI first (see `ich_irq`).
    if fm == FAM_ICH {
        ich_irq(state, u, i, armed, vec)
    } else {
        intx_arm(state, u, i, armed, vec)
    }
    if armed {
        // EVERY delay register to zero, and the send side in the mask
        // too. Both because of a MEASUREMENT: with only the receive
        // causes armed, QEMU raised 16 interrupts for 185 frames and a
        // ping answered after up to 984 ms -- the network task went to
        // sleep and nothing woke it until the next frame happened to
        // come with an interrupt. The transmit completion is the second
        // thing that always happens when this machine is talking, so it
        // is what wakes the task.
        setreg(state, u, R_ITR, 0)
        setreg(state, u, R_RDTR, 0)
        setreg(state, u, R_RADV, 0)
        setreg(state, u, R_TIDV, 0)
        setreg(state, u, R_TADV, 0)
        setreg(state, u, R_IMS, IM_RXT0 | IM_RXDMT0 | IM_RXO | IM_LSC
            | IM_TXDW | IM_TXQE)
    } else {
        setreg(state, u, R_IMC, 0xFFFFFFFF)
    }
    let icr: u64 = reg(state, u, R_ICR)

    kstate.set(state, sc(u, S_READY), 1)
    // THE TAIL, WRITTEN ONCE MORE, and the reason is a measurement.
    // A frame that reaches the card before the ring exists is not
    // thrown away by QEMU -- it is put aside and retried ONE SECOND
    // later (`flush_queue_timer` in hw/net/e1000.c). Everything behind
    // it waits with it, so a machine that was pinged while it was still
    // booting answered the first ten requests at once, 935 ms late,
    // and everything after them in a millisecond. Writing the tail is
    // what makes QEMU look at that queue again; it costs one register
    // write and it takes the second away.
    setreg(state, u, R_RDT, RING_SLOTS - 1)
    step(state, u, 18, (&t_44[0]) as u64)
    read_link(state, u)
    if fm == FAM_ICH {
        serial.puts((&t_45[0]) as u64)
        serial.hex(kstate.get(state, sc(u, S_PHYID)))
        serial.puts((&t_46[0]) as u64)
        serial.dec(kstate.get(state, sc(u, S_LINK)))
        serial.puts((&t_47[0]) as u64)
        serial.dec(kstate.get(state, sc(u, S_IRQMODE)))
        serial.puts((&t_48[0]) as u64)
        serial.hex(warn_on(state, u))
        serial.nl()
    }
    return true
}

// ------------------------------------------------------ the receive ring

fn rx_setup(state: u64, u: u64) {
    let r: u64 = ring(state, u)
    let t: u64 = r + RXD_OFF
    var i: u64 = 0
    while i < RING_SLOTS {
        dsc_addr(t, i, r + RXB_OFF + i * BUFSZ)
        dsc_set_u8(t, i, RD_STATUS, 0)
        i = i + 1
    }
    setreg(state, u, R_RDBAL, t & 0xFFFFFFFF)
    setreg(state, u, R_RDBAH, t >> 32)
    setreg(state, u, R_RDLEN, RING_SLOTS * 16)
    setreg(state, u, R_RDH, 0)
    // The tail is the LAST descriptor the chip may write into. One short
    // of the head on purpose: head == tail means empty, and a ring that
    // cannot tell full from empty loses a frame every wrap.
    setreg(state, u, R_RDT, RING_SLOTS - 1)
    kstate.set(state, sc(u, S_RX_CUR), 0)
    setreg(state, u, R_RCTL, RCTL_EN | RCTL_BAM | RCTL_SECRC)
}

// One frame, or 0 -- the same shape `virtio.rx_take_on` has, so that
// `inet.pump` does not know which chip it is talking to. `slot` comes
// back so the caller can hand the buffer over again once it has copied
// the octets out.
fn rx_take_on(state: u64, u: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    let r: u64 = ring(state, u)
    let t: u64 = r + RXD_OFF
    let cur: u64 = kstate.get(state, sc(u, S_RX_CUR))
    let st: u64 = dsc_u8(t, cur, RD_STATUS)
    if (st & RDS_DD) == 0 {
        return 0
    }
    // The chip wrote the octets before it set DD; this side has to READ
    // them in that order.
    arch.barrier_read()
    let len: u64 = dsc_get_len(t, cur)
    let err: u64 = dsc_u8(t, cur, RD_ERRORS)
    kstate.set(state, sc(u, S_RX_CUR), (cur + 1) % RING_SLOTS)
    if (st & RDS_EOP) == 0 || err != 0 || len == 0 || len > BUFSZ {
        // Nothing usable -- but the descriptor still has to go back,
        // otherwise the ring runs dry one buffer at a time.
        rx_recycle_on(state, u, cur)
        return 0
    }
    *frame = r + RXB_OFF + cur * BUFSZ
    *slot = cur
    kstate.add(state, sc(u, S_RXP), 1)
    kstate.add(state, sc(u, S_RXB), len)
    return len
}

// The buffer is free again: clear the status the chip set and move the
// tail onto it. THAT write is the doorbell.
fn rx_recycle_on(state: u64, u: u64, id: u64) {
    if id >= RING_SLOTS {
        return
    }
    let t: u64 = ring(state, u) + RXD_OFF
    dsc_set_u8(t, id, RD_STATUS, 0)
    dsc_set_u8(t, id, RD_ERRORS, 0)
    setreg(state, u, R_RDT, id)
}

// -------------------------------------------------------- the send ring

fn tx_setup(state: u64, u: u64) {
    let r: u64 = ring(state, u)
    let t: u64 = r + TXD_OFF
    var i: u64 = 0
    while i < RING_SLOTS {
        dsc_addr(t, i, r + TXB_OFF + i * BUFSZ)
        dsc_len(t, i, 0)
        dsc_set_u8(t, i, TD_CMD, 0)
        dsc_set_u8(t, i, TD_STATUS, 0)
        i = i + 1
    }
    setreg(state, u, R_TDBAL, t & 0xFFFFFFFF)
    setreg(state, u, R_TDBAH, t >> 32)
    setreg(state, u, R_TDLEN, RING_SLOTS * 16)
    setreg(state, u, R_TDH, 0)
    setreg(state, u, R_TDT, 0)
    kstate.set(state, sc(u, S_TX_CUR), 0)
    setreg(state, u, R_TIPG, TIPG_DEFAULT)
    // CT (collision threshold) 15 and COLD (collision distance) 64, the
    // values the manual gives for full duplex.
    setreg(state, u, R_TCTL, TCTL_EN | TCTL_PSP | (15 << 4) | (64 << 12))
}

// How many descriptors are free. In flight is tail minus head, modulo
// the ring -- both are read from the chip's own registers, so a
// descriptor the chip has finished is free again without an interrupt.
fn tx_room_on(state: u64, u: u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    let head: u64 = reg(state, u, R_TDH) % RING_SLOTS
    let tail: u64 = kstate.get(state, sc(u, S_TX_CUR)) % RING_SLOTS
    var inflight: u64 = 0
    if tail >= head {
        inflight = tail - head
    } else {
        inflight = RING_SLOTS - head + tail
    }
    if inflight + 1 >= RING_SLOTS {
        return 0
    }
    return RING_SLOTS - 1 - inflight
}

// One frame out. `false` means the ring was full -- the caller decides
// whether to drop it or try again, exactly as with virtio.
fn tx_frame_on(state: u64, u: u64, src: u64, n: u64) -> bool {
    if !ready_on(state, u) || n == 0 || n > BUFSZ {
        return false
    }
    if tx_room_on(state, u) == 0 {
        kstate.add(state, sc(u, S_TXDROP), 1)
        return false
    }
    let r: u64 = ring(state, u)
    let t: u64 = r + TXD_OFF
    let id: u64 = kstate.get(state, sc(u, S_TX_CUR)) % RING_SLOTS
    let buf: u64 = r + TXB_OFF + id * BUFSZ
    var k: u64 = 0
    while k < n {
        __mmio_write8((buf + k) as *mut u8, __mmio_read8((src + k) as *mut u8))
        k = k + 1
    }
    dsc_addr(t, id, buf)
    dsc_len(t, id, n)
    dsc_set_u8(t, id, TD_STATUS, 0)
    // The descriptor is complete BEFORE the tail moves. On x86 stores
    // keep their order; the volatile intrinsics are what keep the
    // compiler from changing it.
    dsc_set_u8(t, id, TD_CMD, TDC_EOP | TDC_IFCS | TDC_RS)
    let next: u64 = (id + 1) % RING_SLOTS
    kstate.set(state, sc(u, S_TX_CUR), next)
    setreg(state, u, R_TDT, next)
    kstate.add(state, sc(u, S_TXP), 1)
    kstate.add(state, sc(u, S_TXB), n)
    return true
}

// ------------------------------------------------------- the interrupt

// Reading ICR is what ACKNOWLEDGES the interrupt on this family -- the
// register clears on read. Nothing else happens here, for the reason
// `virtio.irq_on` gives: the frames are taken out of the ring by
// `inet.pump`, in a task of its own.
fn irq_on(state: u64, u: u64) {
    if !present_on(state, u) || mmio(state, u) == 0 {
        return
    }
    kstate.add(state, sc(u, S_IRQS), 1)
    let cause: u64 = reg(state, u, R_ICR)
    kstate.set(state, sc(u, S_LASTICR), cause)
    kstate.add(state, sc(u, S_CAUSES), 1)
    if (cause & IM_LSC) != 0 {
        read_link(state, u)
    }
    // ROUND NIC9020: THE STORM GUARD, for the pin only. A level line that
    // is asserted by somebody else (or by nobody, because the polarity is
    // wrong) interrupts again the moment the EOI is written, ICR reads 0
    // every time, and the processor does nothing else any more -- the
    // Dell 9020 showed ISR MAX 575576 and a keyboard that lagged by
    // seconds. More than STORM_LIMIT empty interrupts inside 100 ms is
    // not a shared line under load, it is a storm: the input is masked
    // and the card is polled from then on (the network task turns every
    // tick anyway).
    if kstate.get(state, sc(u, S_IRQMODE)) != IRQ_INTX {
        return
    }
    if cause != 0 {
        kstate.set(state, sc(u, S_SPUR), 0)
        return
    }
    let now: u64 = apic.tsc()
    let t0: u64 = kstate.get(state, sc(u, S_SPURT0))
    var win: u64 = apic.tsc_hz(state) / 10
    if win == 0 {
        win = 300000000
    }
    if kstate.get(state, sc(u, S_SPUR)) == 0 || now - t0 > win {
        kstate.set(state, sc(u, S_SPURT0), now)
        kstate.set(state, sc(u, S_SPUR), 1)
        return
    }
    kstate.add(state, sc(u, S_SPUR), 1)
    if kstate.get(state, sc(u, S_SPUR)) >= STORM_LIMIT {
        apic.mask_gsi(state, kstate.get(state, sc(u, S_GSI)))
        kstate.set(state, sc(u, S_STORM), 1)
        kstate.set(state, sc(u, S_IRQMODE), IRQ_NONE)
        warn(state, u, W_STORM)
    }
}

// Is there anything to take? One read of ordinary memory.
fn poll_on(state: u64, u: u64) -> bool {
    if !ready_on(state, u) {
        return false
    }
    let t: u64 = ring(state, u) + RXD_OFF
    let cur: u64 = kstate.get(state, sc(u, S_RX_CUR))
    return (dsc_u8(t, cur, RD_STATUS) & RDS_DD) != 0
}

// ---------------------------------------------------- arming the vector

// The interrupt PIN through the I/O APIC. PCI lines are level triggered
// and active low -- the same six lines `virtio.intx_arm` has, and for
// the same reason they cannot simply be shared: the vector is per card.
fn intx_arm(state: u64, u: u64, i: u64, armed: bool, vec: u64) {
    let d: u64 = pci.get(state, i, pci.E_BDF)
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) & 0xFBFF)
    if vec == 0 {
        // Diese Karte hat keinen Vektor bekommen. Die Leitung wird gar
        // nicht erst geroutet -- eine Umleitung auf einen Vektor, den
        // niemand behandelt, waere schlimmer als keine.
        return
    }
    
    // RUNDE AML: DIE LEITUNG KOMMT AUS `_PRT`, NICHT AUS 0x3C.
    // `aml.gsi_or_line` fragt zuerst die Interrupt-Routing-Tabelle der
    // Firmware (das AML-Objekt `_PRT` der Wurzelbruecke, ausgewertet in
    // kernel/aml.fi) und faellt auf genau die Zeile zurueck, die hier
    // frueher stand, wenn es kein `_PRT` gibt, es nicht lesbar war oder
    // das Geraet dort nicht vorkommt. Was beide Wege sagen, steht mit
    // `aml` auf der seriellen Leitung nebeneinander.
    let gsi: u64 = aml.gsi_or_line(state, i)
    if gsi == 0 || gsi > 23 {
        return
    }
    kstate.set(state, sc(u, S_GSI), gsi)
    kstate.set(state, sc(u, S_SPUR), 0)
    apic.route(state, gsi, vec, apic.id(state), true, true)
    if !armed {
        apic.mask_gsi(state, gsi)
    }
    kstate.set(state, sc(u, S_IRQMODE), IRQ_INTX)
}

// The counter-check needs a way to take the card away from a kernel that
// is otherwise identical.
fn shut_down_on(state: u64, u: u64) {
    if !present_on(state, u) || mmio(state, u) == 0 {
        return
    }
    setreg(state, u, R_IMC, 0xFFFFFFFF)
    setreg(state, u, R_RCTL, 0)
    setreg(state, u, R_TCTL, 0)
    kstate.set(state, sc(u, S_READY), 0)
    pci.disable_master(bdf_on(state, u))
}
