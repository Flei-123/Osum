static mut t_31: [u8; 31] = "chip did not come out of reset\0"
static mut t_32: [u8; 7] = "pmcsr=\0"
static mut t_33: [u8; 47] = "interrupt: msi, else intx from _prt, else poll\0"
static mut t_34: [u8; 13] = "irq=msi vec=\0"
static mut t_35: [u8; 50] = "irq=none (polled), no msi and no _prt line, 0x3c=\0"
static mut t_36: [u8; 14] = "irq=intx gsi=\0"
static mut t_37: [u8; 35] = "pci: d0, bar0, memory + bus master\0"
static mut t_38: [u8; 27] = "bar0 missing or not memory\0"
static mut t_39: [u8; 22] = "bar0 cannot be mapped\0"
static mut t_40: [u8; 33] = "mac: link up (slu/asde), address\0"
static mut t_41: [u8; 42] = "no mac address (ral/rah empty, no eeprom)\0"
static mut t_42: [u8; 6] = "rings\0"
static mut t_43: [u8; 24] = "no memory for the rings\0"
static mut t_44: [u8; 11] = "link state\0"
static mut t_45: [u8; 15] = "e1000: up phy=\0"
static mut t_46: [u8; 7] = " link=\0"
static mut t_47: [u8; 6] = " irq=\0"
static mut t_48: [u8; 7] = " warn=\0"

const R_EECD: u64 = 0x0010
const EECD_AUTO_RD: u64 = 0x200
const R_FEXTNVM3: u64 = 0x003C
const FEXTNVM3_CFG_MASK: u64 = 0x0C000000
const FEXTNVM3_CFG_50MS: u64 = 0x08000000
const FEXTNVM7_DIS_SMB_PERST: u64 = 0x20
const R_KABGTXD: u64 = 0x3004
const KABGTXD_BGSQLBIAS: u64 = 0x50000
const R_H2ME: u64 = 0x5B50
const H2ME_ULP: u64 = 0x800
const H2ME_ENFORCE: u64 = 0x1000
const R_FWSM: u64 = 0x5B54
const FWSM_RSPCIPHY: u64 = 0x40
const FWSM_ULP_CFG_DONE: u64 = 0x400
const FWSM_FW_VALID: u64 = 0x8000
const CTRL_GIO_MASTER_DISABLE: u64 = 4
const STATUS_GIO_MASTER_EN: u64 = 0x80000
const CTRL_LANPHYPC_OVERRIDE: u64 = 0x10000
const CTRL_LANPHYPC_VALUE: u64 = 0x20000
const CTRL_EXT_LPCD: u64 = 4
const CTRL_EXT_FORCE_SMBUS: u64 = 0x800

const PHY_FAIL: u64 = 0xFFFFFFFF
const PHY_PAGE_SELECT: u64 = 0x1F
const PAGE_INTC: u64 = 768
const CV_SMB_PAGE: u64 = 769
const CV_SMB_REG: u64 = 23
const CV_SMB_FORCE: u64 = 1
const HV_PM_PAGE: u64 = 770
const HV_PM_REG: u64 = 17
const HV_PM_K1: u64 = 0x4000
const ULP1_PAGE: u64 = 779
const ULP1_REG: u64 = 16
const ULP1_START: u64 = 1
const ULP1_CLEAR: u64 = 0x1D74
const MII_BMCR: u64 = 0
const BMCR_ANRESTART: u64 = 0x200
const BMCR_PDOWN: u64 = 0x800
const BMCR_ANENABLE: u64 = 0x1000

const S_STEP: u64 = 0xC0
const S_WARN: u64 = 0xC8
const S_IRQMODE: u64 = 0xD0
const S_GSI: u64 = 0xD8
const S_SPURIOUS: u64 = 0xE0
const S_STORM: u64 = 0xE8
const S_TFLAGS: u64 = 0xF0
const S_FOUND: u64 = 0xF8
const S_SPURT0: u64 = 0x100

const IRQ_NONE: u64 = 0
const IRQ_INTX: u64 = 1
const IRQ_MSI: u64 = 2

const W_SWHELD: u64 = 1
const W_SWFAIL: u64 = 2
const W_PHY: u64 = 4
const W_BLOCKED: u64 = 8
const W_ULPME: u64 = 16
const W_ULPPHY: u64 = 32
const W_GIO: u64 = 64
const W_AUTORD: u64 = 128
const W_FLUSH: u64 = 256
const W_STORM: u64 = 512

const TF_ICH: u64 = 1
const TF_FAIL: u64 = 2
const TF_INTX: u64 = 4
const TF_FLUSH: u64 = 8

const STORM_LIMIT: u64 = 20000

fn set_flags(state: u64, force_ich: bool, fail: bool, intx: bool, flush: bool) {
    var f: u64 = 0
    if force_ich { f = f | TF_ICH }
    if fail { f = f | TF_FAIL }
    if intx { f = f | TF_INTX }
    if flush { f = f | TF_FLUSH }
    kstate.set(state, sc(0, S_TFLAGS), f)
}

fn tflag(state: u64, bit: u64) -> bool {
    return (kstate.get(state, sc(0, S_TFLAGS)) & bit) != 0
}

fn warn(state: u64, u: u64, bit: u64) {
    kstate.set(state, sc(u, S_WARN), kstate.get(state, sc(u, S_WARN)) | bit)
}

fn warn_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_WARN))
}

fn step_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_STEP))
}

fn irq_mode_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_IRQMODE))
}

fn storm_on(state: u64, u: u64) -> bool {
    return kstate.get(state, sc(u, S_STORM)) != 0
}

fn udelay(state: u64, us: u64) {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        var i: u64 = 0
        while i < us * 100 {
            arch.pause()
            i = i + 1
        }
        return
    }
    let want: u64 = hz / 1000000 * us
    let t0: u64 = apic.tsc()
    while !time.expired(t0, want) {
        arch.pause()
    }
}

fn step(state: u64, u: u64, n: u64, what: u64) {
    kstate.set(state, sc(u, S_STEP), n)
    if fam(state, u) != FAM_ICH {
        return
    }
    serial.puts((&t_0[0]) as u64)
    serial.dec(n)
    serial.puts((&t_1[0]) as u64)
    serial.puts(what)
    serial.nl()
}

fn note(state: u64, u: u64, what: u64, v: u64) {
    if fam(state, u) != FAM_ICH {
        return
    }
    serial.puts((&t_2[0]) as u64)
    serial.puts(what)
    serial.hex(v)
    serial.nl()
}

fn fail(state: u64, u: u64, why: u64, dead: bool) -> bool {
    serial.puts((&t_3[0]) as u64)
    serial.dec(step_on(state, u))
    serial.puts((&t_4[0]) as u64)
    serial.puts(why)
    serial.puts((&t_5[0]) as u64)
    serial.hex(warn_on(state, u))
    serial.puts((&t_6[0]) as u64)
    serial.nl()
    if !dead && mmio(state, u) != 0 {
        setreg(state, u, R_IMC, 0xFFFFFFFF)
        setreg(state, u, R_RCTL, 0)
        setreg(state, u, R_TCTL, 0)
    }
    pci.disable_master(bdf_on(state, u))
    kstate.set(state, sc(u, S_READY), 0)
    kstate.set(state, sc(u, S_MMIO), 0)
    return false
}

fn swflag_take(state: u64, u: u64) -> bool {
    if kstate.get(state, sc(u, S_SWFLAG)) != 0 {
        return true
    }
    var t: u64 = 0
    var v: u64 = reg(state, u, R_EXTCNF_CTRL)
    while (v & EXTCNF_SWFLAG) != 0 && t < 100 {
        udelay(state, 1000)
        t = t + 1
        v = reg(state, u, R_EXTCNF_CTRL)
    }
    if (v & EXTCNF_SWFLAG) != 0 {
        warn(state, u, W_SWHELD)
        return false
    }
    setreg(state, u, R_EXTCNF_CTRL, v | EXTCNF_SWFLAG)
    t = 0
    while t < 1000 {
        if (reg(state, u, R_EXTCNF_CTRL) & EXTCNF_SWFLAG) != 0 {
            kstate.set(state, sc(u, S_SWFLAG), 1)
            return true
        }
        udelay(state, 1000)
        t = t + 1
    }
    setreg(state, u, R_EXTCNF_CTRL,
        reg(state, u, R_EXTCNF_CTRL) & (~EXTCNF_SWFLAG))
    warn(state, u, W_SWFAIL)
    return false
}

fn swflag_give(state: u64, u: u64) {
    if kstate.get(state, sc(u, S_SWFLAG)) == 0 {
        return
    }
    let v: u64 = reg(state, u, R_EXTCNF_CTRL)
    setreg(state, u, R_EXTCNF_CTRL, v & (~EXTCNF_SWFLAG))
    kstate.set(state, sc(u, S_SWFLAG), 0)
}

fn mdic_op(state: u64, u: u64, addr: u64, r: u64, op: u64, val: u64) -> u64 {
    setreg(state, u, R_MDIC, op | ((addr & 0x1F) << 21) | ((r & 0x1F) << 16)
        | (val & 0xFFFF))
    var i: u64 = 0
    while i < 1920 {
        udelay(state, 50)
        let v: u64 = reg(state, u, R_MDIC)
        if (v & MDIC_READY) != 0 {
            if (v & MDIC_ERROR) != 0 {
                return PHY_FAIL
            }
            if ((v >> 16) & 0x1F) != (r & 0x1F) {
                return PHY_FAIL
            }
            return v & 0xFFFF
        }
        i = i + 1
    }
    return PHY_FAIL
}

fn phy_addr_for(page: u64) -> u64 {
    if page >= PAGE_INTC {
        return 1
    }
    return 2
}

fn phy_page(state: u64, u: u64, page: u64, r: u64) -> bool {
    if r <= 15 {
        return true
    }
    var p: u64 = page
    if p == PAGE_INTC {
        p = 0
    }
    return mdic_op(state, u, 1, PHY_PAGE_SELECT, MDIC_OP_WRITE, p << 5) != PHY_FAIL
}

fn phy_rd(state: u64, u: u64, page: u64, r: u64) -> u64 {
    if !phy_page(state, u, page, r) {
        return PHY_FAIL
    }
    let v: u64 = mdic_op(state, u, phy_addr_for(page), r, MDIC_OP_READ, 0)
    if v == PHY_FAIL && page == 0 {
        return mdic_op(state, u, 1, r, MDIC_OP_READ, 0)
    }
    return v
}

fn phy_wr(state: u64, u: u64, page: u64, r: u64, val: u64) -> bool {
    if !phy_page(state, u, page, r) {
        return false
    }
    if mdic_op(state, u, phy_addr_for(page), r, MDIC_OP_WRITE, val) != PHY_FAIL {
        return true
    }
    if page == 0 {
        return mdic_op(state, u, 1, r, MDIC_OP_WRITE, val) != PHY_FAIL
    }
    return false
}

fn mdic_read(state: u64, u: u64, r: u64) -> u64 {
    return phy_rd(state, u, 0, r)
}

fn mdic_write(state: u64, u: u64, r: u64, val: u64) -> bool {
    return phy_wr(state, u, 0, r, val)
}

fn phy_accessible(state: u64, u: u64) -> bool {
    var tries: u64 = 0
    var id: u64 = 0
    while tries < 2 && id == 0 {
        let a: u64 = phy_rd(state, u, 0, 2)
        if a != PHY_FAIL && a != 0xFFFF {
            let b: u64 = phy_rd(state, u, 0, 3)
            if b != PHY_FAIL && b != 0xFFFF {
                id = (a << 16) | (b & 0xFFF0)
            }
        }
        tries = tries + 1
    }
    if id == 0 {
        kstate.set(state, sc(u, S_PHYID), 0xFFFFFFFF)
        return false
    }
    kstate.set(state, sc(u, S_PHYID), id)
    if (reg(state, u, R_FWSM) & FWSM_FW_VALID) == 0 {
        let s: u64 = phy_rd(state, u, CV_SMB_PAGE, CV_SMB_REG)
        if s != PHY_FAIL {
            let w: bool = phy_wr(state, u, CV_SMB_PAGE, CV_SMB_REG,
                s & (~CV_SMB_FORCE))
        }
        setreg(state, u, R_CTRL_EXT,
            reg(state, u, R_CTRL_EXT) & (~CTRL_EXT_FORCE_SMBUS))
    }
    return true
}

fn toggle_lanphypc(state: u64, u: u64) {
    var v: u64 = reg(state, u, R_FEXTNVM3)
    v = (v & (~FEXTNVM3_CFG_MASK)) | FEXTNVM3_CFG_50MS
    setreg(state, u, R_FEXTNVM3, v)
    var c: u64 = reg(state, u, R_CTRL)
    c = (c | CTRL_LANPHYPC_OVERRIDE) & (~CTRL_LANPHYPC_VALUE)
    setreg(state, u, R_CTRL, c)
    let f1: u64 = reg(state, u, R_STATUS)
    udelay(state, 20)
    c = c & (~CTRL_LANPHYPC_OVERRIDE)
    setreg(state, u, R_CTRL, c)
    let f2: u64 = reg(state, u, R_STATUS)
    var n: u64 = 0
    while n < 20 {
        udelay(state, 5000)
        if (reg(state, u, R_CTRL_EXT) & CTRL_EXT_LPCD) != 0 {
            n = 20
        }
        n = n + 1
    }
    udelay(state, 30000)
}

fn phy_reset_blocked(state: u64, u: u64) -> bool {
    var i: u64 = 0
    while i < 30 {
        if (reg(state, u, R_FWSM) & FWSM_RSPCIPHY) != 0 {
            return false
        }
        udelay(state, 10000)
        i = i + 1
    }
    return (reg(state, u, R_FWSM) & FWSM_RSPCIPHY) == 0
}

fn ulp_applies(devid: u64) -> bool {
    if devid == 0x153A || devid == 0x153B {
        return false
    }
    if devid == 0x15A0 || devid == 0x15A1 {
        return false
    }
    return true
}

fn ulp_off(state: u64, u: u64) {
    if !ulp_applies(kstate.get(state, sc(u, S_DEVID))) {
        note(state, u, (&t_7[0]) as u64,
            kstate.get(state, sc(u, S_DEVID)))
        return
    }
    if (reg(state, u, R_FWSM) & FWSM_FW_VALID) != 0 {
        var h: u64 = reg(state, u, R_H2ME)
        setreg(state, u, R_H2ME, (h & (~H2ME_ULP)) | H2ME_ENFORCE)
        var i: u64 = 0
        while (reg(state, u, R_FWSM) & FWSM_ULP_CFG_DONE) != 0 && i < 250 {
            udelay(state, 10000)
            i = i + 1
        }
        if i >= 250 {
            warn(state, u, W_ULPME)
        }
        h = reg(state, u, R_H2ME)
        setreg(state, u, R_H2ME, h & (~H2ME_ENFORCE))
        note(state, u, (&t_8[0]) as u64, i)
        return
    }
    if !swflag_take(state, u) {
        return
    }
    toggle_lanphypc(state, u)
    var s: u64 = phy_rd(state, u, CV_SMB_PAGE, CV_SMB_REG)
    if s == PHY_FAIL {
        setreg(state, u, R_CTRL_EXT,
            reg(state, u, R_CTRL_EXT) | CTRL_EXT_FORCE_SMBUS)
        udelay(state, 50000)
        s = phy_rd(state, u, CV_SMB_PAGE, CV_SMB_REG)
    }
    if s == PHY_FAIL {
        warn(state, u, W_ULPPHY)
        swflag_give(state, u)
        return
    }
    let w1: bool = phy_wr(state, u, CV_SMB_PAGE, CV_SMB_REG, s & (~CV_SMB_FORCE))
    setreg(state, u, R_CTRL_EXT,
        reg(state, u, R_CTRL_EXT) & (~CTRL_EXT_FORCE_SMBUS))
    let pm: u64 = phy_rd(state, u, HV_PM_PAGE, HV_PM_REG)
    if pm != PHY_FAIL {
        let w2: bool = phy_wr(state, u, HV_PM_PAGE, HV_PM_REG, pm | HV_PM_K1)
    }
    let c: u64 = phy_rd(state, u, ULP1_PAGE, ULP1_REG)
    if c != PHY_FAIL {
        let c2: u64 = c & (~ULP1_CLEAR)
        let w3: bool = phy_wr(state, u, ULP1_PAGE, ULP1_REG, c2)
        let w4: bool = phy_wr(state, u, ULP1_PAGE, ULP1_REG, c2 | ULP1_START)
    }
    setreg(state, u, R_FEXTNVM7,
        reg(state, u, R_FEXTNVM7) & (~FEXTNVM7_DIS_SMB_PERST))
    swflag_give(state, u)
    udelay(state, 50000)
}

fn phy_wake(state: u64, u: u64) {
    step(state, u, 4, (&t_9[0]) as u64)
    if !swflag_take(state, u) {
        note(state, u, (&t_10[0]) as u64,
            reg(state, u, R_EXTCNF_CTRL))
        return
    }
    step(state, u, 5, (&t_11[0]) as u64)
    if !phy_accessible(state, u) {
        step(state, u, 6, (&t_12[0]) as u64)
        setreg(state, u, R_CTRL_EXT,
            reg(state, u, R_CTRL_EXT) | CTRL_EXT_FORCE_SMBUS)
        udelay(state, 50000)
        if !phy_accessible(state, u) {
            step(state, u, 7, (&t_13[0]) as u64)
            if phy_reset_blocked(state, u) {
                warn(state, u, W_BLOCKED)
                warn(state, u, W_PHY)
            } else {
                step(state, u, 8, (&t_14[0]) as u64)
                toggle_lanphypc(state, u)
                if !phy_accessible(state, u) {
                    setreg(state, u, R_CTRL_EXT,
                        reg(state, u, R_CTRL_EXT) & (~CTRL_EXT_FORCE_SMBUS))
                    if !phy_accessible(state, u) {
                        warn(state, u, W_PHY)
                    }
                }
            }
        }
    }
    note(state, u, (&t_15[0]) as u64, kstate.get(state, sc(u, S_PHYID)))
    swflag_give(state, u)
}

const R_FEXTNVM11: u64 = 0x5BBC
const FEXTNVM11_DISABLE_MULR_FIX: u64 = 0x2000
const CFG_DESC_RING_STATUS: u64 = 0xE4
const FLUSH_DESC_REQUIRED: u64 = 0x100
const R_RXDCTL0: u64 = 0x2828
const RXDCTL_THRESH_UNIT_DESC: u64 = 0x01000000
const TXD_CMD_IFCS: u64 = 2
const FLUSH_TX_SIZE: u64 = 512

static mut f_0: [u8; 28] = "flush: tx dummy, tdh/tdt = ␀"
static mut f_1: [u8; 11] = " rxdctl = ␀"
static mut f_2: [u8; 31] = "flush: required (0xe4), tdlen=␀"
static mut f_3: [u8; 24] = "flush: rx stage rctl = ␀"
static mut f_4: [u8; 28] = "flush: still required after␀"

fn spt_or_later(devid: u64) -> bool {
    if !supports_ich(devid) {
        return false
    }
    if devid == 0x153A || devid == 0x153B {
        return false
    }
    if devid == 0x155A || devid == 0x1559 {
        return false
    }
    if devid >= 0x15A0 && devid <= 0x15A3 {
        return false
    }
    return true
}

fn flush_required(state: u64, u: u64) -> bool {
    if tflag(state, TF_FLUSH) {
        return true
    }
    if !spt_or_later(kstate.get(state, sc(u, S_DEVID))) {
        return false
    }
    return (pci.cfg_read16(bdf_on(state, u), CFG_DESC_RING_STATUS) & FLUSH_DESC_REQUIRED) != 0
}

fn ring_ensure(state: u64, u: u64) -> u64 {
    var r: u64 = ring(state, u)
    if r != 0 {
        return r
    }
    r = mmframe.frame_run(state, RING_BYTES / mmframe.FRAME_SIZE)
    if r == 0 {
        return 0
    }
    var z: u64 = 0
    while z < RING_BYTES {
        __mmio_write64((r + z) as *mut u64, 0)
        z = z + 8
    }
    kstate.set(state, sc(u, S_RING), r)
    return r
}

fn flush_tx_ring(state: u64, u: u64) -> bool {
    let r: u64 = ring_ensure(state, u)
    if r == 0 {
        return false
    }
    let t: u64 = r + TXD_OFF
    if reg(state, u, R_TDBAL) != (t & 0xFFFFFFFF) || reg(state, u, R_TDBAH) != (t >> 32) {
        setreg(state, u, R_TDBAL, t & 0xFFFFFFFF)
        setreg(state, u, R_TDBAH, t >> 32)
        setreg(state, u, R_TDLEN, RING_SLOTS * 16)
        setreg(state, u, R_TDH, 0)
        setreg(state, u, R_TDT, 0)
    }
    let tctl: u64 = reg(state, u, R_TCTL)
    setreg(state, u, R_TCTL, tctl | TCTL_EN)
    let tdt: u64 = reg(state, u, R_TDT) % RING_SLOTS
    dsc_addr(t, tdt, t)
    dsc_len(t, tdt, FLUSH_TX_SIZE)
    dsc_set_u8(t, tdt, TD_CMD, TXD_CMD_IFCS)
    dsc_set_u8(t, tdt, TD_STATUS, 0)
    arch.barrier()
    setreg(state, u, R_TDT, (tdt + 1) % RING_SLOTS)
    udelay(state, 250)
    return true
}

fn flush_rx_ring(state: u64, u: u64) {
    let rctl: u64 = reg(state, u, R_RCTL)
    setreg(state, u, R_RCTL, rctl & (~RCTL_EN))
    let st: u64 = reg(state, u, R_STATUS)
    udelay(state, 150)
    var rxdctl: u64 = reg(state, u, R_RXDCTL0)
    rxdctl = (rxdctl & 0xFFFFC000) | 0x1F | (1 << 8) | RXDCTL_THRESH_UNIT_DESC
    setreg(state, u, R_RXDCTL0, rxdctl)
    setreg(state, u, R_RCTL, rctl | RCTL_EN)
    let st2: u64 = reg(state, u, R_STATUS)
    udelay(state, 150)
    setreg(state, u, R_RCTL, rctl & (~RCTL_EN))
}

fn flush_desc_rings(state: u64, u: u64) {
    if !(tflag(state, TF_FLUSH) || spt_or_later(kstate.get(state, sc(u, S_DEVID)))) {
        return
    }
    setreg(state, u, R_FEXTNVM11, reg(state, u, R_FEXTNVM11) | FEXTNVM11_DISABLE_MULR_FIX)
    if !flush_required(state, u) {
        return
    }
    warn(state, u, W_FLUSH)
    let tdlen: u64 = reg(state, u, R_TDLEN)
    if tdlen == 0 && !tflag(state, TF_FLUSH) {
        return
    }
    note(state, u, (&f_2[0]) as u64, tdlen)
    if !flush_tx_ring(state, u) {
        return
    }
    note(state, u, (&f_0[0]) as u64, (reg(state, u, R_TDH) << 16) | reg(state, u, R_TDT))
    var again: bool = (pci.cfg_read16(bdf_on(state, u), CFG_DESC_RING_STATUS) & FLUSH_DESC_REQUIRED) != 0
    if tflag(state, TF_FLUSH) {
        again = true
    }
    if again {
        flush_rx_ring(state, u)
        note(state, u, (&f_1[0]) as u64, reg(state, u, R_RXDCTL0))
        if !tflag(state, TF_FLUSH) && (pci.cfg_read16(bdf_on(state, u), CFG_DESC_RING_STATUS) & FLUSH_DESC_REQUIRED) != 0 {
            note(state, u, (&f_4[0]) as u64, 1)
        }
    }
}

fn ich_reset(state: u64, u: u64) -> bool {
    flush_desc_rings(state, u)
    step(state, u, 9, (&t_16[0]) as u64)
    setreg(state, u, R_CTRL, reg(state, u, R_CTRL) | CTRL_GIO_MASTER_DISABLE)
    var t: u64 = 0
    while (reg(state, u, R_STATUS) & STATUS_GIO_MASTER_EN) != 0 && t < 800 {
        udelay(state, 100)
        t = t + 1
    }
    if t >= 800 {
        warn(state, u, W_GIO)
    }
    step(state, u, 10, (&t_17[0]) as u64)
    setreg(state, u, R_IMC, 0xFFFFFFFF)
    setreg(state, u, R_RCTL, 0)
    setreg(state, u, R_TCTL, TCTL_PSP)
    let fl: u64 = reg(state, u, R_STATUS)
    udelay(state, 10000)
    let ctrl: u64 = reg(state, u, R_CTRL)
    let sw: bool = swflag_take(state, u)
    if u == 0 {
        pba_pre = reg(state, u, 0x1000)
    }
    if probe_var != 4 {
        setreg(state, u, 0x1000, 0x1A)
    }
    step(state, u, 11, (&t_18[0]) as u64)
    if probe_var == 6 && !phy_reset_blocked(state, u) {
        setreg(state, u, R_CTRL, ctrl | CTRL_RST | 0x80000000)
    } else {
        setreg(state, u, R_CTRL, ctrl | CTRL_RST)
    }
    udelay(state, 20000)
    kstate.set(state, sc(u, S_SWFLAG), 0)
    step(state, u, 12, (&t_19[0]) as u64)
    if tflag(state, TF_FAIL) {
        return false
    }
    t = 0
    while (reg(state, u, R_CTRL) & CTRL_RST) != 0 {
        if t >= 100 {
            return false
        }
        udelay(state, 1000)
        t = t + 1
    }
    step(state, u, 13, (&t_20[0]) as u64)
    t = 0
    while (reg(state, u, R_EECD) & EECD_AUTO_RD) == 0 && t < 10 {
        udelay(state, 1000)
        t = t + 1
    }
    if t >= 10 {
        warn(state, u, W_AUTORD)
    }
    setreg(state, u, R_IMC, 0xFFFFFFFF)
    let icr: u64 = reg(state, u, R_ICR)
    setreg(state, u, R_KABGTXD, reg(state, u, R_KABGTXD) | KABGTXD_BGSQLBIAS)
    return true
}

fn phy_power_up(state: u64, u: u64) {
    step(state, u, 14, (&t_21[0]) as u64)
    if (warn_on(state, u) & W_PHY) != 0 {
        return
    }
    if !swflag_take(state, u) {
        return
    }
    let b: u64 = phy_rd(state, u, 0, MII_BMCR)
    if b != PHY_FAIL {
        note(state, u, (&t_22[0]) as u64, b)
        if (b & BMCR_PDOWN) != 0 || (b & BMCR_ANENABLE) == 0 {
            let w: bool = phy_wr(state, u, 0, MII_BMCR,
                (b & (~BMCR_PDOWN)) | BMCR_ANENABLE | BMCR_ANRESTART)
        }
    }
    swflag_give(state, u)
}

fn ich_bringup(state: u64, u: u64) -> bool {
    step(state, u, 2, (&t_23[0]) as u64)
    let st: u64 = reg(state, u, R_STATUS)
    if st == 0xFFFFFFFF {
        return fail(state, u, (&t_24[0]) as u64, true)
    }
    note(state, u, (&t_25[0]) as u64, st)
    note(state, u, (&t_26[0]) as u64, reg(state, u, R_CTRL))
    note(state, u, (&t_27[0]) as u64, reg(state, u, R_CTRL_EXT))
    note(state, u, (&t_28[0]) as u64, reg(state, u, R_FWSM))
    note(state, u, (&t_29[0]) as u64, reg(state, u, R_EXTCNF_CTRL))
    let prah: u64 = reg(state, u, R_RAH)
    if (prah & RAH_AV) != 0 {
        kstate.set(state, sc(u, S_PREMAC),
            (reg(state, u, R_RAL) & 0xFFFFFFFF) | ((prah & 0xFFFF) << 32))
    }
    step(state, u, 3, (&t_30[0]) as u64)
    ulp_off(state, u)
    phy_wake(state, u)
    if !ich_reset(state, u) {
        return fail(state, u, (&t_31[0]) as u64, false)
    }
    phy_power_up(state, u)
    return true
}

fn pci_d0(state: u64, u: u64) {
    let d: u64 = bdf_on(state, u)
    let pm: u64 = pci.cap_find(d, 0x01)
    if pm == 0 {
        return
    }
    let csr: u64 = pci.cfg_read16(d, pm + 4)
    note(state, u, (&t_32[0]) as u64, csr)
    if (csr & 3) != 0 {
        pci.cfg_write16(d, pm + 4, csr & 0xFFFC)
        udelay(state, 10000)
    }
}

fn msi_arm(state: u64, u: u64, i: u64, vec: u64, armed: bool) -> bool {
    let d: u64 = pci.get(state, i, pci.E_BDF)
    let cap: u64 = pci.get(state, i, pci.E_MSI)
    if cap == 0 {
        return false
    }
    let ctrl: u64 = pci.cfg_read16(d, cap + 2)
    pci.cfg_write32(d, cap + 4,
        apic.lapic_phys(state) | ((apic.id(state) & 0xFF) << 12))
    var datoff: u64 = cap + 8
    if (ctrl & 0x80) != 0 {
        pci.cfg_write32(d, cap + 8, 0)
        datoff = cap + 12
    }
    pci.cfg_write16(d, datoff, vec & 0xFF)
    var fresh: u64 = ctrl & 0xFF8E
    if armed {
        fresh = fresh | 1
    }
    pci.cfg_write16(d, cap + 2, fresh)
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) | 0x400)
    return true
}

fn ich_irq(state: u64, u: u64, i: u64, armed: bool, vec: u64) {
    step(state, u, 17, (&t_33[0]) as u64)
    kstate.set(state, sc(u, S_IRQMODE), IRQ_NONE)
    if vec == 0 {
        return
    }
    let want_pin: bool = tflag(state, TF_INTX)
    if !want_pin && pci.get(state, i, pci.E_MSI) != 0 {
        if msi_arm(state, u, i, vec, armed) {
            kstate.set(state, sc(u, S_IRQMODE), IRQ_MSI)
            note(state, u, (&t_34[0]) as u64, vec)
            return
        }
    }
    let d: u64 = pci.get(state, i, pci.E_BDF)
    let pin: u64 = pci.get(state, i, pci.E_IRQPIN)
    var gsi: u64 = 0xFFFFFFFF
    if pin >= 1 && pin <= 4 {
        gsi = aml.gsi_for(state, pci.bdf_bus(d), pci.bdf_dev(d), pin - 1)
    }
    if gsi == 0xFFFFFFFF && want_pin {
        gsi = pci.get(state, i, pci.E_IRQLINE)
    }
    if gsi == 0 || gsi > 23 {
        note(state, u, (&t_35[0]) as u64,
            pci.get(state, i, pci.E_IRQLINE))
        pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) | 0x400)
        return
    }
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) & 0xFBFF)
    kstate.set(state, sc(u, S_GSI), gsi)
    kstate.set(state, sc(u, S_SPURIOUS), 0)
    apic.route(state, gsi, vec, apic.id(state), true, true)
    if !armed {
        apic.mask_gsi(state, gsi)
    }
    kstate.set(state, sc(u, S_IRQMODE), IRQ_INTX)
    note(state, u, (&t_36[0]) as u64, gsi)
}

fn read_link(state: u64, u: u64) {
    var v: u64 = 0
    if (reg(state, u, R_STATUS) & STATUS_LU) != 0 {
        v = 1
    }
    if v == 0 && fam(state, u) == FAM_ICH {
        if swflag_take(state, u) {
            let first: u64 = mdic_read(state, u, 1)
            let second: u64 = mdic_read(state, u, 1)
            swflag_give(state, u)
            if second != 0xFFFFFFFF {
                if (second & BMSR_LINK) != 0 {
                    v = 1
                }
            }
        }
    }
    kstate.set(state, sc(u, S_LINK), v)
    var mbit: u64 = 0
    if v != 0 {
        let st: u64 = reg(state, u, R_STATUS)
        let bits: u64 = (st >> STATUS_SPEED_SHIFT) & STATUS_SPEED_MASK
        if bits == 0 {
            mbit = 10
        } else if bits == 1 {
            mbit = 100
        } else {
            mbit = 1000
        }
    }
    kstate.set(state, sc(u, S_SPEED), mbit)
    if v == 0 {
        kstate.set(state, sc(u, S_LPTUP), 0)
    } else if fam(state, u) == FAM_ICH && kstate.get(state, sc(u, S_LPTUP)) == 0 {
        kstate.set(state, sc(u, S_LPTUP), 1)
        lpt_link_up(state, u, mbit)
    }
}

fn lpt_link_up(state: u64, u: u64, mbit: u64) {
    var res: u64 = 0
    setreg(state, u, R_TIPG, (reg(state, u, R_TIPG) & (~0x3FF)) | 8)
    var k1: u64 = 0xFFFF
    if swflag_take(state, u) {
        if phy_wr(state, u, 0, 0x10, 0xB20C) {
            if phy_wr(state, u, 0, 0x11, 1) {
                res = res | 4
            }
        }
        let g: u64 = phy_rd(state, u, 772, 28)
        var gnew: u64 = 0xFFFF
        if g != PHY_FAIL {
            gnew = g & (~0x7FF)
            if mbit == 1000 {
                gnew = gnew | 0xFA
            } else {
                gnew = gnew | 0x3E8
            }
            if phy_wr(state, u, 772, 28, gnew) {
                res = res | 1
            }
        }
        if mbit == 1000 {
            let pm: u64 = phy_rd(state, u, HV_PM_PAGE, HV_PM_REG)
            if pm != PHY_FAIL {
                if phy_wr(state, u, HV_PM_PAGE, HV_PM_REG, pm | 0x200) {
                    res = res | 2
                }
            }
        }
        let pm2: u64 = phy_rd(state, u, HV_PM_PAGE, HV_PM_REG)
        if pm2 != PHY_FAIL {
            res = res | ((pm2 & 0xFFFF) << 16)
        }
        setreg(state, u, 0x0034, (7 << 16) | 0x200000)
        udelay(state, 2)
        k1 = reg(state, u, 0x0034) & 0xFFFF
        if mbit == 1000 {
            setreg(state, u, 0x0034, (7 << 16) | (k1 & (~2)))
            udelay(state, 20)
            setreg(state, u, 0x0010, reg(state, u, 0x0010) | 0x100)
            let pk: u64 = phy_rd(state, u, HV_PM_PAGE, HV_PM_REG)
            if pk != PHY_FAIL {
                if phy_wr(state, u, HV_PM_PAGE, HV_PM_REG, pk & (~HV_PM_K1)) {
                    res = res | 32
                }
            }
            setreg(state, u, 0x0034, (7 << 16) | 0x200000)
            udelay(state, 2)
            k1 = reg(state, u, 0x0034) & 0xFFFF
            let pm3: u64 = phy_rd(state, u, HV_PM_PAGE, HV_PM_REG)
            if pm3 != PHY_FAIL {
                res = (res & 0xFFFF) | ((pm3 & 0xFFFF) << 16)
            }
        }
        swflag_give(state, u)
        kstate.set(state, sc(u, S_LPTK1), k1 | ((gnew & 0xFFFF) << 16))
    } else {
        res = res | 16
    }
    setreg(state, u, 0x0024, (reg(state, u, 0x0024) & (~7)) | 7)
    setreg(state, u, 0x0010, reg(state, u, 0x0010))
    if lpt_ltr(state, u, mbit) {
        res = res | 8
    }
    kstate.set(state, sc(u, S_LPTRES), res)
}

fn lpt_ltr(state: u64, u: u64, mbit: u64) -> bool {
    if mbit == 0 {
        return false
    }
    let rxa: u64 = (reg(state, u, 0x1000) & 0xFFFF) * 512
    var value: u64 = 0
    if rxa > 1522 {
        value = (rxa - 1522) * (16000 / mbit)
    }
    var scale: u64 = 0
    while value > 0x3FF {
        scale = scale + 1
        value = (value + 31) / 32
    }
    if scale > 5 {
        return false
    }
    var lat: u64 = (scale << 10) | value
    let d: u64 = bdf_on(state, u)
    let ms: u64 = pci.cfg_read16(d, 0xA8)
    let mn: u64 = pci.cfg_read16(d, 0xAA)
    var mx: u64 = ms
    if mn > mx {
        mx = mn
    }
    let lat_d: u64 = (lat & 0x3FF) << (5 * ((lat >> 10) & 7))
    let mx_d: u64 = (mx & 0x3FF) << (5 * ((mx >> 10) & 7))
    if mx != 0 && mx != 0xFFFF && lat_d > mx_d {
        lat = mx
    }
    let v: u64 = (1 << 31) | (1 << 15) | (1 << 30) | lat | (lat << 16)
    setreg(state, u, 0x00F8, v)
    return true
}

static mut q_e1000: [u8; 6] = "e1000\0"

fn lq() -> u64 {
    return (&q_e1000[0]) as u64
}

fn init_on(state: u64, u: u64, use_msix: bool, armed: bool,
    vec: u64) -> bool {
    if u >= MAX_UNITS {
        return false
    }
    var l_kein: [u8; 24] = "no card at this unit, u\0"
    var l_da: [u8; 26] = "Karte gefunden, devid \0\0\0\0"
    kstate.set(state, sc(u, S_READY), 0)
    kstate.set(state, sc(u, S_FOUND), 0)
    kstate.set(state, sc(u, S_STEP), 0)
    kstate.set(state, sc(u, S_WARN), 0)
    kstate.set(state, sc(u, S_IRQMODE), IRQ_NONE)
    kstate.set(state, sc(u, S_GSI), 0)
    kstate.set(state, sc(u, S_SPURIOUS), 0)
    kstate.set(state, sc(u, S_SPURT0), 0)
    kstate.set(state, sc(u, S_LPTUP), 0)
    kstate.set(state, sc(u, S_STORM), 0)
    var pm_msix: u64 = 0
    if use_msix { pm_msix = 1 }
    var pm_armed: u64 = 0
    if armed { pm_armed = 1 }
    kstate.set(state, sc(u, S_PRB_MSIX), pm_msix)
    kstate.set(state, sc(u, S_PRB_ARMED), pm_armed)
    kstate.set(state, sc(u, S_PRB_VEC), vec)
    let i: u64 = find(state, u)
    if i >= pci.MAX_DEV {
        klog.sayn(state, klog.L_DEBUG, lq(), (&l_kein[0]) as u64, u)
        return false
    }
    let d: u64 = pci.get(state, i, pci.E_BDF)
    let devid: u64 = pci.get(state, i, pci.E_DEVICE)
    kstate.set(state, sc(u, S_IDX), i)
    kstate.set(state, sc(u, S_BDF), d)
    kstate.set(state, sc(u, S_DEVID), devid)
    klog.sayh(state, klog.L_INFO, lq(), (&l_da[0]) as u64, devid)
    var fm: u64 = family_of(devid)
    if tflag(state, TF_ICH) {
        fm = FAM_ICH
    }
    kstate.set(state, sc(u, S_FAM), fm)
    kstate.set(state, sc(u, S_PREMAC), 0)
    kstate.set(state, sc(u, S_PHYID), 0)
    kstate.set(state, sc(u, S_SWFLAG), 0)
    kstate.set(state, sc(u, S_FOUND), 1)

    step(state, u, 1, (&t_37[0]) as u64)
    let phys: u64 = pci.bar(state, i, 0)
    if phys == 0 || pci.bar_is_io(state, i, 0) {
        return fail(state, u, (&t_38[0]) as u64, true)
    }
    if fm == FAM_ICH {
        pci_d0(state, u)
    }
    let base: u64 = apic.map_device(state, phys)
    if base == 0 {
        return fail(state, u, (&t_39[0]) as u64, true)
    }
    kstate.set(state, sc(u, S_MMIO), base)

    pci.enable_master(d)

    if fm == FAM_ICH {
        if !ich_bringup(state, u) {
            return false
        }
    } else {
        if !chip_reset(state, u) {
            return fail(state, u, (&t_31[0]) as u64, false)
        }
    }

    step(state, u, 15, (&t_40[0]) as u64)
    var ctrl: u64 = reg(state, u, R_CTRL)
    ctrl = ctrl | CTRL_SLU | CTRL_ASDE
    ctrl = ctrl & 0xFFFFFFFF
    if (ctrl & CTRL_LRST) != 0 { ctrl = ctrl - CTRL_LRST }
    if (ctrl & CTRL_ILOS) != 0 { ctrl = ctrl - CTRL_ILOS }
    if (ctrl & CTRL_VME) != 0 { ctrl = ctrl - CTRL_VME }
    setreg(state, u, R_CTRL, ctrl)

    if !read_mac(state, u) {
        return fail(state, u, (&t_41[0]) as u64, false)
    }

    step(state, u, 16, (&t_42[0]) as u64)
    var m: u64 = 0
    while m < 128 {
        setreg(state, u, R_MTA + m * 4, 0)
        m = m + 1
    }

    let r: u64 = ring_ensure(state, u)
    if r == 0 {
        return fail(state, u, (&t_43[0]) as u64, false)
    }
    var z: u64 = 0
    while z < RING_BYTES {
        __mmio_write64((r + z) as *mut u64, 0)
        z = z + 8
    }

    rx_setup(state, u)
    tx_setup(state, u)

    if fm == FAM_ICH {
        ich_irq(state, u, i, armed, vec)
    } else {
        intx_arm(state, u, i, armed, vec)
    }
    if armed {
        setreg(state, u, R_ITR, 0)
        setreg(state, u, R_RDTR, 0)
        setreg(state, u, R_RADV, 0)
        setreg(state, u, R_TIDV, 0)
        setreg(state, u, R_TADV, 0)
        setreg(state, u, R_IMS, IM_RXT0 | IM_RXDMT0 | IM_RXO | IM_LSC
            | IM_TXDW | IM_TXQE)
    } else {
        setreg(state, u, R_IMC, 0xFFFFFFFF)
    }
    let icr: u64 = reg(state, u, R_ICR)

    kstate.set(state, sc(u, S_READY), 1)
    setreg(state, u, R_RDT, RING_SLOTS - 1)
    step(state, u, 18, (&t_44[0]) as u64)
    read_link(state, u)
    if fm == FAM_ICH {
        serial.puts((&t_45[0]) as u64)
        serial.hex(kstate.get(state, sc(u, S_PHYID)))
        serial.puts((&t_46[0]) as u64)
        serial.dec(kstate.get(state, sc(u, S_LINK)))
        serial.puts((&t_47[0]) as u64)
        serial.dec(kstate.get(state, sc(u, S_IRQMODE)))
        serial.puts((&t_48[0]) as u64)
        serial.hex(warn_on(state, u))
        serial.nl()
    }
    return true
}

fn rx_setup(state: u64, u: u64) {
    let r: u64 = ring(state, u)
    let t: u64 = r + RXD_OFF
    var i: u64 = 0
    while i < RING_SLOTS {
        dsc_addr(t, i, r + RXB_OFF + i * BUFSZ)
        dsc_set_u8(t, i, RD_STATUS, 0)
        i = i + 1
    }
    setreg(state, u, R_RDBAL, t & 0xFFFFFFFF)
    setreg(state, u, R_RDBAH, t >> 32)
    setreg(state, u, R_RDLEN, RING_SLOTS * 16)
    setreg(state, u, R_RDH, 0)
    setreg(state, u, R_RDT, RING_SLOTS - 1)
    kstate.set(state, sc(u, S_RX_CUR), 0)
    setreg(state, u, R_RCTL, RCTL_EN | RCTL_BAM | RCTL_SECRC)
}

fn rx_take_on(state: u64, u: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    let r: u64 = ring(state, u)
    let t: u64 = r + RXD_OFF
    let cur: u64 = kstate.get(state, sc(u, S_RX_CUR))
    let st: u64 = dsc_u8(t, cur, RD_STATUS)
    if (st & RDS_DD) == 0 {
        return 0
    }
    arch.barrier_read()
    let len: u64 = dsc_get_len(t, cur)
    let err: u64 = dsc_u8(t, cur, RD_ERRORS)
    kstate.set(state, sc(u, S_RX_CUR), (cur + 1) % RING_SLOTS)
    if (st & RDS_EOP) == 0 || err != 0 || len == 0 || len > BUFSZ {
        rx_recycle_on(state, u, cur)
        return 0
    }
    *frame = r + RXB_OFF + cur * BUFSZ
    *slot = cur
    kstate.add(state, sc(u, S_RXP), 1)
    kstate.add(state, sc(u, S_RXB), len)
    return len
}

fn rx_recycle_on(state: u64, u: u64, id: u64) {
    if id >= RING_SLOTS {
        return
    }
    let t: u64 = ring(state, u) + RXD_OFF
    dsc_set_u8(t, id, RD_STATUS, 0)
    dsc_set_u8(t, id, RD_ERRORS, 0)
    setreg(state, u, R_RDT, id)
}

fn tx_setup(state: u64, u: u64) {
    let r: u64 = ring(state, u)
    let t: u64 = r + TXD_OFF
    var i: u64 = 0
    while i < RING_SLOTS {
        dsc_addr(t, i, r + TXB_OFF + i * BUFSZ)
        dsc_len(t, i, 0)
        dsc_set_u8(t, i, TD_CMD, 0)
        dsc_set_u8(t, i, TD_STATUS, 0)
        i = i + 1
    }
    setreg(state, u, R_TDBAL, t & 0xFFFFFFFF)
    setreg(state, u, R_TDBAH, t >> 32)
    setreg(state, u, R_TDLEN, RING_SLOTS * 16)
    setreg(state, u, R_TDH, 0)
    setreg(state, u, R_TDT, 0)
    kstate.set(state, sc(u, S_TX_CUR), 0)
    kstate.set(state, sc(u, S_TX_HEAD), 0)
    setreg(state, u, R_TIPG, TIPG_DEFAULT)
    if fam(state, u) == FAM_ICH {
        setreg(state, u, R_TIPG, (TIPG_DEFAULT & (~0x3FF)) | 8)
    }
    if fam(state, u) == FAM_ICH && probe_var == 3 {
        setreg(state, u, R_CTRL_EXT, reg(state, u, R_CTRL_EXT) | 0x10000000)
    }
    if fam(state, u) == FAM_ICH && probe_var != 3 {
        var txd: u64 = reg(state, u, 0x3828)
        txd = txd | 0x400000
        txd = (txd & (~0x3F0000)) | 0x01010000
        txd = (txd & (~0x3F)) | 0x1F
        setreg(state, u, 0x3828, txd)
        setreg(state, u, 0x3928, reg(state, u, 0x3928) | 0x400000)
        setreg(state, u, 0x3840, reg(state, u, 0x3840) | 0x0D800000)
        var tarc1: u64 = reg(state, u, 0x3940) | 0x45000000
        if (reg(state, u, R_TCTL) & 0x10000000) != 0 {
            tarc1 = tarc1 & (~0x10000000)
        } else {
            tarc1 = tarc1 | 0x10000000
        }
        setreg(state, u, 0x3940, tarc1)
        setreg(state, u, R_CTRL_EXT, reg(state, u, R_CTRL_EXT) | 0x400000)
        setreg(state, u, 0x5008, reg(state, u, 0x5008) | 0xC0)
        setreg(state, u, 0x5B00, (reg(state, u, 0x5B00) & (~0x3F)) | 0xFFFFFFC0)
        setreg(state, u, R_CTRL_EXT, reg(state, u, R_CTRL_EXT) | 0x20000 | 0x100000)
        setreg(state, u, 0x100C, reg(state, u, 0x100C) | 0x10000)
        setreg(state, u, R_CTRL, reg(state, u, R_CTRL) | 0x80000)
        setreg(state, u, R_CTRL_EXT, reg(state, u, R_CTRL_EXT) | 0x10000000)
    }
    let tctl0: u64 = reg(state, u, R_TCTL) & 0xF0000000
    setreg(state, u, R_TCTL, tctl0 | TCTL_EN | TCTL_PSP | 0x1000000 | (15 << 4) | (63 << 12))
}

fn tx_room_on(state: u64, u: u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    let tail: u64 = kstate.get(state, sc(u, S_TX_CUR)) % RING_SLOTS
    var inflight: u64 = tx_inflight(tail, kstate.get(state, sc(u, S_TX_HEAD)))
    if inflight + 1 >= RING_SLOTS {
        let head: u64 = reg(state, u, R_TDH) % RING_SLOTS
        kstate.set(state, sc(u, S_TX_HEAD), head)
        inflight = tx_inflight(tail, head)
    }
    if inflight + 1 >= RING_SLOTS {
        return 0
    }
    return RING_SLOTS - 1 - inflight
}

fn tx_inflight(tail: u64, head: u64) -> u64 {
    if tail >= head {
        return tail - head
    }
    return RING_SLOTS - head + tail
}

fn tx_frame_on(state: u64, u: u64, src: u64, n: u64) -> bool {
    if !ready_on(state, u) || n == 0 || n > BUFSZ {
        return false
    }
    if tx_room_on(state, u) == 0 {
        kstate.add(state, sc(u, S_TXDROP), 1)
        return false
    }
    let r: u64 = ring(state, u)
    let t: u64 = r + TXD_OFF
    let id: u64 = kstate.get(state, sc(u, S_TX_CUR)) % RING_SLOTS
    let buf: u64 = r + TXB_OFF + id * BUFSZ
    var k: u64 = 0
    while k < n {
        __mmio_write8((buf + k) as *mut u8, __mmio_read8((src + k) as *mut u8))
        k = k + 1
    }
    dsc_addr(t, id, buf)
    dsc_len(t, id, n)
    dsc_set_u8(t, id, TD_STATUS, 0)
    dsc_set_u8(t, id, TD_CMD, TDC_EOP | TDC_IFCS | TDC_RS)
    let next: u64 = (id + 1) % RING_SLOTS
    kstate.set(state, sc(u, S_TX_CUR), next)
    setreg(state, u, R_TDT, next)
    kstate.add(state, sc(u, S_TXP), 1)
    kstate.add(state, sc(u, S_TXB), n)
    return true
}

fn irq_on(state: u64, u: u64) {
    if !present_on(state, u) || mmio(state, u) == 0 {
        return
    }
    kstate.add(state, sc(u, S_IRQS), 1)
    let cause: u64 = reg(state, u, R_ICR)
    kstate.set(state, sc(u, S_LASTICR), cause)
    kstate.add(state, sc(u, S_CAUSES), 1)
    if (cause & IM_LSC) != 0 {
        read_link(state, u)
    }
    if kstate.get(state, sc(u, S_IRQMODE)) != IRQ_INTX {
        return
    }
    if cause != 0 {
        kstate.set(state, sc(u, S_SPURIOUS), 0)
        return
    }
    let now: u64 = apic.tsc()
    let t0: u64 = kstate.get(state, sc(u, S_SPURT0))
    var win: u64 = apic.tsc_hz(state) / 10
    if win == 0 {
        win = 300000000
    }
    if kstate.get(state, sc(u, S_SPURIOUS)) == 0 || time.expired(t0, win + 1) {
        kstate.set(state, sc(u, S_SPURT0), now)
        kstate.set(state, sc(u, S_SPURIOUS), 1)
        return
    }
    kstate.add(state, sc(u, S_SPURIOUS), 1)
    if kstate.get(state, sc(u, S_SPURIOUS)) >= STORM_LIMIT {
        apic.mask_gsi(state, kstate.get(state, sc(u, S_GSI)))
        kstate.set(state, sc(u, S_STORM), 1)
        kstate.set(state, sc(u, S_IRQMODE), IRQ_NONE)
        warn(state, u, W_STORM)
    }
}

fn poll_on(state: u64, u: u64) -> bool {
    if !ready_on(state, u) {
        return false
    }
    let t: u64 = ring(state, u) + RXD_OFF
    let cur: u64 = kstate.get(state, sc(u, S_RX_CUR))
    return (dsc_u8(t, cur, RD_STATUS) & RDS_DD) != 0
}

fn intx_arm(state: u64, u: u64, i: u64, armed: bool, vec: u64) {
    let d: u64 = pci.get(state, i, pci.E_BDF)
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) & 0xFBFF)
    if vec == 0 {
        return
    }
    
    let gsi: u64 = aml.gsi_or_line(state, i)
    if gsi == 0 || gsi > 23 {
        return
    }
    kstate.set(state, sc(u, S_GSI), gsi)
    kstate.set(state, sc(u, S_SPURIOUS), 0)
    apic.route(state, gsi, vec, apic.id(state), true, true)
    if !armed {
        apic.mask_gsi(state, gsi)
    }
    kstate.set(state, sc(u, S_IRQMODE), IRQ_INTX)
}

fn shut_down_on(state: u64, u: u64) {
    if !present_on(state, u) || mmio(state, u) == 0 {
        return
    }
    setreg(state, u, R_IMC, 0xFFFFFFFF)
    setreg(state, u, R_RCTL, 0)
    setreg(state, u, R_TCTL, 0)
    kstate.set(state, sc(u, S_READY), 0)
    pci.disable_master(bdf_on(state, u))
}

static mut probe_var: u64 = 0

fn txprobe_on(state: u64, u: u64) -> u64 {
    if u >= MAX_UNITS || !present_on(state, u) || fam(state, u) != FAM_ICH {
        return 0xFFFFFFFF
    }
    let msix: bool = kstate.get(state, sc(u, S_PRB_MSIX)) != 0
    let armed: bool = kstate.get(state, sc(u, S_PRB_ARMED)) != 0
    let vec: u64 = kstate.get(state, sc(u, S_PRB_VEC))
    var out: u64 = 0
    var v: u64 = 0
    while v < 8 {
        probe_var = v
        var nib: u64 = 0
        if init_on(state, u, msix, armed, vec) {
            var k: u64 = 0
            while k < 60 && kstate.get(state, sc(u, S_LINK)) == 0 {
                udelay(state, 100000)
                read_link(state, u)
                k = k + 1
            }
            if kstate.get(state, sc(u, S_LINK)) != 0 {
                nib = nib | 8
            }
            let g0: u64 = reg(state, u, 0x4080) + reg(state, u, 0x40D4)
            let fh: u64 = reg(state, u, 0x3418)
            var n: u64 = 60
            if v == 1 {
                n = 342
            }
            probe_send(state, u, n, v == 2)
            udelay(state, 300000)
            if (reg(state, u, R_TDH) % RING_SLOTS) != 0 {
                nib = nib | 1
            }
            if reg(state, u, 0x3418) != fh {
                nib = nib | 2
            }
            if reg(state, u, 0x4080) + reg(state, u, 0x40D4) != 0 {
                nib = nib | 4
            }
        }
        out = out | (nib << (v * 4))
        v = v + 1
    }
    probe_var = 0
    return out
}

fn probe_send(state: u64, u: u64, n: u64, in_desc_page: bool) {
    let r: u64 = ring(state, u)
    let t: u64 = r + TXD_OFF
    let id: u64 = kstate.get(state, sc(u, S_TX_CUR)) % RING_SLOTS
    var buf: u64 = r + TXB_OFF + id * BUFSZ
    if in_desc_page {
        buf = t + 0x800
    }
    var k: u64 = 0
    while k < n {
        __mmio_write8((buf + k) as *mut u8, 0 as u8)
        k = k + 1
    }
    k = 0
    while k < 6 {
        __mmio_write8((buf + k) as *mut u8, 0xFF as u8)
        k = k + 1
    }
    let mac: u64 = kstate.get(state, sc(u, S_MAC))
    k = 0
    while k < 6 {
        __mmio_write8((buf + 6 + k) as *mut u8, ((mac >> (k * 8)) & 0xFF) as u8)
        k = k + 1
    }
    __mmio_write8((buf + 12) as *mut u8, 0x88 as u8)
    __mmio_write8((buf + 13) as *mut u8, 0xB5 as u8)
    dsc_addr(t, id, buf)
    dsc_len(t, id, n)
    dsc_set_u8(t, id, TD_STATUS, 0)
    dsc_set_u8(t, id, TD_CMD, TDC_EOP | TDC_IFCS | TDC_RS)
    let next: u64 = (id + 1) % RING_SLOTS
    kstate.set(state, sc(u, S_TX_CUR), next)
    setreg(state, u, R_TDT, next)
}

fn kill_on(state: u64, u: u64) {
    if u >= MAX_UNITS || kstate.get(state, sc(u, S_READY)) == 0 {
        return
    }
    setreg(state, u, R_CTRL, reg(state, u, R_CTRL) | CTRL_RST)
}

fn resume_on(state: u64, u: u64) -> bool {
    if u >= MAX_UNITS || kstate.get(state, sc(u, S_READY)) == 0 {
        return false
    }
    return init_on(state, u, kstate.get(state, sc(u, S_PRB_MSIX)) != 0,
        kstate.get(state, sc(u, S_PRB_ARMED)) != 0, kstate.get(state, sc(u, S_PRB_VEC)))
}
