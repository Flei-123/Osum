export {
    kill_on, resume_on, MAX_UNITS, VENDOR_INTEL,
    init_on, present_on, ready_on, up_on, mac_at_on, bdf_on, idx_on,
    rx_take_on, rx_recycle_on, tx_frame_on, tx_room_on, poll_on, irq_on,
    rx_frames_on, tx_frames_on, rx_octets_on, tx_octets_on,
    tx_drops_on, link_up_on, shut_down_on, irqs_on, queue_size_on,
    msix_on, notified_on, features_on, supports, RING_SLOTS, BUFSZ,
    supports_8254x, supports_ich, family_of, FAM_8254X, FAM_ICH,
