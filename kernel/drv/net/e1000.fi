    set_flags, irq_mode_on, step_on, warn_on, storm_on,
    IRQ_NONE, IRQ_INTX, IRQ_MSI
}

const UNIT_BASE: u64 = 0x400
const UNIT_SPAN: u64 = 0x200
const MAX_UNITS: u64 = 2

const S_MMIO: u64 = 0x00
const S_BDF: u64 = 0x08
const S_IDX: u64 = 0x10
const S_READY: u64 = 0x18
const S_MAC: u64 = 0x20
const S_RING: u64 = 0x28
const S_RX_CUR: u64 = 0x30
const S_TX_CUR: u64 = 0x38
const S_IRQS: u64 = 0x40
const S_RXP: u64 = 0x48
const S_TXP: u64 = 0x50
const S_RXB: u64 = 0x58
const S_TXB: u64 = 0x60
const S_TXDROP: u64 = 0x68
const S_LINK: u64 = 0x70
const S_DEVID: u64 = 0x78
const S_MACOK: u64 = 0x80
const S_LASTICR: u64 = 0x88
const S_CAUSES: u64 = 0x90
const S_FAM: u64 = 0x98
const S_PHYID: u64 = 0xA0
const S_SWFLAG: u64 = 0xA8
const S_PREMAC: u64 = 0xB0
const S_SPEED: u64 = 0xB8
const S_LINKCHK: u64 = 0x108
const S_LPTUP: u64 = 0x110
const S_LPTRES: u64 = 0x118
const S_PRB_MSIX: u64 = 0x128
const S_PRB_ARMED: u64 = 0x130
const S_PRB_VEC: u64 = 0x138
const S_TX_HEAD: u64 = 0x140
const S_LPTK1: u64 = 0x120

fn sc(u: u64, off: u64) -> u64 {
    return kstate.NETDEV_OFF + UNIT_BASE + u * UNIT_SPAN + off
}

const VENDOR_INTEL: u64 = 0x8086
const CLASS_NET: u64 = 0x02
const SUB_ETHERNET: u64 = 0x00

const R_CTRL: u64 = 0x0000
const R_STATUS: u64 = 0x0008
const R_EERD: u64 = 0x0014
const R_ICR: u64 = 0x00C0
const R_ITR: u64 = 0x00C4
const R_RDTR: u64 = 0x2820
const R_RADV: u64 = 0x282C
const R_TIDV: u64 = 0x3820
const R_TADV: u64 = 0x382C
const R_IMS: u64 = 0x00D0
const R_IMC: u64 = 0x00D8
const R_RCTL: u64 = 0x0100
const R_TCTL: u64 = 0x0400
const R_TIPG: u64 = 0x0410
const R_RDBAL: u64 = 0x2800
const R_RDBAH: u64 = 0x2804
const R_RDLEN: u64 = 0x2808
const R_RDH: u64 = 0x2810
const R_RDT: u64 = 0x2818
const R_TDBAL: u64 = 0x3800
const R_TDBAH: u64 = 0x3804
const R_TDLEN: u64 = 0x3808
const R_TDH: u64 = 0x3810
const R_TDT: u64 = 0x3818
const R_MTA: u64 = 0x5200
const R_RAL: u64 = 0x5400
const R_RAH: u64 = 0x5404

const CTRL_SLU: u64 = 64
const CTRL_ASDE: u64 = 32
const CTRL_LRST: u64 = 8
const CTRL_ILOS: u64 = 128
const CTRL_RST: u64 = 67108864
const CTRL_VME: u64 = 1073741824

const STATUS_LU: u64 = 2

const STATUS_SPEED_SHIFT: u64 = 6
const STATUS_SPEED_MASK: u64 = 3

const RCTL_EN: u64 = 2
const RCTL_UPE: u64 = 8
const RCTL_MPE: u64 = 16
const RCTL_BAM: u64 = 32768
const RCTL_SECRC: u64 = 67108864

const TCTL_EN: u64 = 2
const TCTL_PSP: u64 = 8

const TIPG_DEFAULT: u64 = 6299658

const RAH_AV: u64 = 2147483648

const R_CTRL_EXT: u64 = 0x0018
const R_MDIC: u64 = 0x0020
const R_FEXTNVM: u64 = 0x0028
const R_FEXTNVM7: u64 = 0x00E4
const R_EXTCNF_CTRL: u64 = 0x0F00

const EXTCNF_SWFLAG: u64 = 32

const MDIC_OP_WRITE: u64 = 67108864
const MDIC_OP_READ: u64 = 134217728
const MDIC_READY: u64 = 268435456
const MDIC_ERROR: u64 = 1073741824

const FEXTNVM7_ULP: u64 = 32

const ICH_PHY_ADDR: u64 = 1

const BMSR_LINK: u64 = 4

const FAM_8254X: u64 = 0
const FAM_ICH: u64 = 1

const EERD_START: u64 = 1
const EERD_DONE: u64 = 16

const IM_TXDW: u64 = 1
const IM_TXQE: u64 = 2
const IM_LSC: u64 = 4
const IM_RXDMT0: u64 = 16
const IM_RXO: u64 = 64
const IM_RXT0: u64 = 128

const RD_STATUS: u64 = 12
const RD_ERRORS: u64 = 13
const RDS_DD: u64 = 1
const RDS_EOP: u64 = 2

const TD_CMD: u64 = 11
const TD_STATUS: u64 = 12
const TDC_EOP: u64 = 1
const TDC_IFCS: u64 = 2
const TDC_RS: u64 = 8

const RING_SLOTS: u64 = 32
const BUFSZ: u64 = 2048

const RXD_OFF: u64 = 0x00000
const TXD_OFF: u64 = 0x01000
const RXB_OFF: u64 = 0x02000
const TXB_OFF: u64 = 0x12000
const RING_BYTES: u64 = 0x22000

const SPIN_LIMIT: u64 = 2000000

fn supports_8254x(devid: u64) -> bool {
    if devid == 0x100E {
        return true
    }
    if devid == 0x100F {
        return true
    }
    if devid == 0x1015 {
        return true
    }
    if devid == 0x1026 {
        return true
    }
    if devid == 0x1028 {
        return true
    }
    if devid == 0x10D3 {
        return true
    }
    return false
}

fn supports_ich(devid: u64) -> bool {
    if devid == 0x153A || devid == 0x153B {
        return true
    }
    if devid == 0x155A || devid == 0x1559 {
        return true
    }
    if devid == 0x15A0 || devid == 0x15A1 {
        return true
    }
    if devid == 0x15A2 || devid == 0x15A3 {
        return true
    }
    if devid == 0x156F || devid == 0x1570 {
        return true
    }
    if devid == 0x15B7 || devid == 0x15B8 || devid == 0x15B9 {
        return true
    }
    if devid == 0x15BB || devid == 0x15BC {
        return true
    }
    if devid == 0x15BD || devid == 0x15BE {
        return true
    }
    if devid == 0x15D7 || devid == 0x15D8 || devid == 0x15E3 {
        return true
    }
    if devid == 0x0D4E || devid == 0x0D4F {
        return true
    }
    if devid == 0x0D53 || devid == 0x0D55 {
        return true
    }
    if devid == 0x1A1C || devid == 0x1A1D {
        return true
    }
    if devid == 0x1A1E || devid == 0x1A1F {
        return true
    }
    return false
}

fn supports(devid: u64) -> bool {
    if supports_8254x(devid) { return true }
    return supports_ich(devid)
}

fn family_of(devid: u64) -> u64 {
    if supports_ich(devid) { return FAM_ICH }
    return FAM_8254X
}

fn fam(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_FAM))
}

fn phy_id_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_PHYID))
}

fn swflag_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_SWFLAG))
}

fn mmio(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_MMIO))
}

fn present_on(state: u64, u: u64) -> bool {
    return kstate.get(state, sc(u, S_FOUND)) != 0
}

fn ready_on(state: u64, u: u64) -> bool {
    return kstate.get(state, sc(u, S_READY)) != 0
}

fn up_on(state: u64, u: u64) -> bool {
    return ready_on(state, u)
}

fn bdf_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_BDF))
}

fn idx_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_IDX))
}

fn irqs_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_IRQS))
}

fn rx_frames_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_RXP))
}

fn tx_frames_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_TXP))
}

fn tx_drops_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_TXDROP))
}

fn rx_octets_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_RXB))
}

fn tx_octets_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_TXB))
}

fn features_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_DEVID))
}

fn queue_size_on(state: u64, u: u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    return RING_SLOTS
}

fn msix_on(state: u64, u: u64) -> bool {
    return false
}

fn notified_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_TXP)) + kstate.get(state, sc(u, S_RXP))
}

fn link_up_on(state: u64, u: u64) -> bool {
    link_recheck(state, u)
    return kstate.get(state, sc(u, S_LINK)) != 0
}

fn link_recheck(state: u64, u: u64) {
    if !ready_on(state, u) || mmio(state, u) == 0 {
        return
    }
    if kstate.get(state, sc(u, S_LINK)) != 0 {
        return
    }
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return
    }
    let now: u64 = apic.tsc()
    let last: u64 = kstate.get(state, sc(u, S_LINKCHK))
    if last != 0 && now - last < hz / 2 {
        return
    }
    kstate.set(state, sc(u, S_LINKCHK), now)
    read_link(state, u)
}

fn link_speed_on(state: u64, u: u64) -> u64 {
    if kstate.get(state, sc(u, S_LINK)) == 0 {
        return 0
    }
    return kstate.get(state, sc(u, S_SPEED))
}

static mut hw_sum: [u64; 18] = [0 as u64; 18]
static mut pba_pre: u64 = 0

fn hwstat_on(state: u64, u: u64, which: u64) -> u64 {
    if u >= MAX_UNITS || !present_on(state, u) || which >= 50 {
        return 0xFFFFFFFF
    }
    if which == 18 {
        return reg(state, u, R_TDH)
    }
    if which == 19 {
        return reg(state, u, R_TDT)
    }
    if which == 20 {
        return reg(state, u, 0x3828)
    }
    if which == 21 {
        return reg(state, u, 0x3808)
    }
    if which == 22 {
        return reg(state, u, R_TDBAL)
    }
    if which == 23 {
        return reg(state, u, 0x3804)
    }
    if which == 24 {
        return reg(state, u, 0x1000)
    }
    if which == 25 {
        return pba_pre
    }
    if which == 26 {
        return reg(state, u, 0x5B00)
    }
    if which == 27 {
        return reg(state, u, 0x5B54)
    }
    if which == 28 {
        return reg(state, u, 0x3840)
    }
    if which == 29 {
        return reg(state, u, 0x0000)
    }
    if which == 30 {
        return reg(state, u, R_CTRL_EXT)
    }
    if which == 31 {
        return reg(state, u, 0x1008)
    }
    if which == 32 {
        let t: u64 = ring(state, u) + TXD_OFF
        return dsc_u8(t, 0, TD_CMD) | (dsc_u8(t, 0, TD_STATUS) << 8)
    }
    if which == 33 {
        let t2: u64 = ring(state, u) + TXD_OFF
        return __mmio_read8((t2 + 8) as *mut u8) as u64
            | ((__mmio_read8((t2 + 9) as *mut u8) as u64) << 8)
    }
    if which == 34 {
        return reg(state, u, R_TIPG)
    }
    if which == 35 {
        return kstate.get(state, sc(u, S_LASTICR))
    }
    if which == 36 {
        return reg(state, u, 0x0F00)
    }
    if which == 37 {
        return reg(state, u, 0x5820)
    }
    if which == 38 {
        return reg(state, u, 0x5B50)
    }
    if which == 39 {
        return reg(state, u, 0x3410)
    }
    if which == 40 {
        return reg(state, u, 0x3418)
    }
    if which == 41 {
        return reg(state, u, 0x3430)
    }
    if which == 42 {
        return reg(state, u, 0x4050)
    }
    if which == 43 {
        return kstate.get(state, sc(u, S_LPTRES))
    }
    if which == 44 {
        return kstate.get(state, sc(u, S_LPTK1))
    }
    if which == 45 {
        return reg(state, u, 0x0010)
    }
    if which == 46 {
        return reg(state, u, 0x00F8)
    }
    if which == 47 {
        return reg(state, u, 0x0024)
    }
    if which == 49 {
        return txprobe_on(state, u)
    }
    if which == 48 {
        return pci.cfg_read16(bdf_on(state, u), 0x06)
    }
    if which >= 18 {
        return 0xFFFFFFFF
    }
    if which == 0 {
        return reg(state, u, 0x0008)
    }
    if which == 10 {
        return reg(state, u, R_RAL)
    }
    if which == 11 {
        return reg(state, u, R_RAH)
    }
    if which == 12 {
        return reg(state, u, 0x0100)
    }
    if which == 13 {
        return reg(state, u, 0x0400)
    }
    if which == 14 {
        return reg(state, u, 0x0000)
    }
    var off: u64 = 0x4074
    if which == 2 {
        off = 0x4078
    }
    if which == 3 {
        off = 0x407C
    }
    if which == 4 {
        off = 0x4080
    }
    if which == 5 {
        off = 0x4010
    }
    if which == 6 {
        off = 0x4000
    }
    if which == 7 {
        off = 0x400C
    }
    if which == 8 {
        off = 0x40A0
    }
    if which == 9 {
        off = 0x40D4
    }
    if which == 15 {
        off = 0x40AC
    }
    if which == 16 {
        off = 0x40A8
    }
    if which == 17 {
        off = 0x40D0
    }
    if u == 0 {
        hw_sum[which as usize] = hw_sum[which as usize] + (reg(state, u, off) & 0xFFFFFFFF)
        return hw_sum[which as usize]
    }
    return reg(state, u, off)
}

fn mac_at_on(state: u64, u: u64, i: u64) -> u64 {
    if i >= 6 {
        return 0
    }
    return (kstate.get(state, sc(u, S_MAC)) >> (i * 8)) & 0xFF
}

fn reg(state: u64, u: u64, off: u64) -> u64 {
    return regio.read32_at(mmio(state, u), off)
}

fn setreg(state: u64, u: u64, off: u64, v: u64) {
    regio.write32_at(mmio(state, u), off, v)
}

fn ring(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_RING))
}

fn dsc_addr(t: u64, i: u64, v: u64) {
    __mmio_write64((t + i * 16) as *mut u64, v)
}

fn dsc_len(t: u64, i: u64, v: u64) {
    __mmio_write16((t + i * 16 + 8) as *mut u16, (v & 0xFFFF) as u16)
}

fn dsc_get_len(t: u64, i: u64) -> u64 {
    return __mmio_read16((t + i * 16 + 8) as *mut u16) as u64
}

fn dsc_u8(t: u64, i: u64, off: u64) -> u64 {
    return __mmio_read8((t + i * 16 + off) as *mut u8) as u64
}

fn dsc_set_u8(t: u64, i: u64, off: u64, v: u64) {
    __mmio_write8((t + i * 16 + off) as *mut u8, (v & 0xFF) as u8)
}

fn find(state: u64, u: u64) -> u64 {
    let n: u64 = pci.count(state)
    var i: u64 = 0
    var seen: u64 = 0
    while i < n {
        if pci.get(state, i, pci.E_VENDOR) == VENDOR_INTEL {
            if pci.get(state, i, pci.E_CLASS) == CLASS_NET {
                if pci.get(state, i, pci.E_SUBCLASS) == SUB_ETHERNET {
                    if supports(pci.get(state, i, pci.E_DEVICE)) {
                        if seen == u {
                            return i
                        }
                        seen = seen + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return pci.MAX_DEV
}

fn chip_reset(state: u64, u: u64) -> bool {
    setreg(state, u, R_IMC, 0xFFFFFFFF)
    let ctrl: u64 = reg(state, u, R_CTRL)
    setreg(state, u, R_CTRL, ctrl | CTRL_RST)
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        if (reg(state, u, R_CTRL) & CTRL_RST) == 0 {
            setreg(state, u, R_IMC, 0xFFFFFFFF)
            let icr: u64 = reg(state, u, R_ICR)
            return true
        }
        arch.pause()
        spin = spin + 1
    }
    return false
}

fn eeprom(state: u64, u: u64, word: u64) -> u64 {
    setreg(state, u, R_EERD, (word << 8) | EERD_START)
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        let v: u64 = reg(state, u, R_EERD)
        if (v & EERD_DONE) != 0 {
            return (v >> 16) & 0xFFFF
        }
        arch.pause()
        spin = spin + 1
    }
    return 0xFFFFFFFF
}

fn read_mac(state: u64, u: u64) -> bool {
    let rah: u64 = reg(state, u, R_RAH)
    if (rah & RAH_AV) != 0 {
        let ral: u64 = reg(state, u, R_RAL)
        let v: u64 = (ral & 0xFFFFFFFF) | ((rah & 0xFFFF) << 32)
        if v != 0 {
            kstate.set(state, sc(u, S_MAC), v)
            kstate.set(state, sc(u, S_MACOK), 1)
            return true
        }
    }
    if fam(state, u) == FAM_ICH {
        let pre: u64 = kstate.get(state, sc(u, S_PREMAC))
        if pre != 0 && pre != 0xFFFFFFFFFFFF {
            kstate.set(state, sc(u, S_MAC), pre)
            kstate.set(state, sc(u, S_MACOK), 3)
            setreg(state, u, R_RAL, pre & 0xFFFFFFFF)
            setreg(state, u, R_RAH, ((pre >> 32) & 0xFFFF) | RAH_AV)
            return true
        }
        return false
    }
    let w0: u64 = eeprom(state, u, 0)
    let w1: u64 = eeprom(state, u, 1)
    let w2: u64 = eeprom(state, u, 2)
    if w0 > 0xFFFF || w1 > 0xFFFF || w2 > 0xFFFF {
        return false
    }
    let v: u64 = (w0 & 0xFF) | ((w0 >> 8) << 8) | ((w1 & 0xFF) << 16)
        | ((w1 >> 8) << 24) | ((w2 & 0xFF) << 32) | ((w2 >> 8) << 40)
    if v == 0 {
        return false
    }
    kstate.set(state, sc(u, S_MAC), v)
    kstate.set(state, sc(u, S_MACOK), 2)
    setreg(state, u, R_RAL, v & 0xFFFFFFFF)
    setreg(state, u, R_RAH, ((v >> 32) & 0xFFFF) | RAH_AV)
    return true
}

