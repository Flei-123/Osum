import serial
import lib.kstate
import drv.usb.xhci
import usbnet.ch397

export { bringup, house, link, bmsr, cfg, fw, changes, mode_line, bmcr, phyid, aner, anar, lpa, kicks, kick_rc, intr_get }

const X_BMSR: u64 = 0x108
const X_CFG: u64 = 0x110
const X_FWV: u64 = 0x118
const X_NEXT: u64 = 0x120
const X_CHG: u64 = 0x128
const X_LINK: u64 = 0x130
const X_ANAR: u64 = 0x138
const X_LPA: u64 = 0x140
const X_SPEED: u64 = 0x148
const X_BMCR: u64 = 0x150
const X_PHYID: u64 = 0x158
const X_ANER: u64 = 0x160
const X_KICKS: u64 = 0x168
const X_KICKT: u64 = 0x170
const X_KICKRC: u64 = 0x178
const X_INTDCI: u64 = 0x180
const X_INTMPS: u64 = 0x188
const X_INTN: u64 = 0x190
const X_INTLAST: u64 = 0x198
const X_INTLINK: u64 = 0x1A0
const X_INTERR: u64 = 0x1A8
const X_INTARMS: u64 = 0x1B0
const X_INTSEQ: u64 = 0x1B8
const X_INTARMED: u64 = 0x1C0
const X_INTBUF: u64 = 0x1D0
const INT_BUF_LEN: u64 = 16
const INT_ERR_MAX: u64 = 8
const INT_LINK_BIT: u64 = 0x40
const KICK_TICKS: u64 = 300
const KICK_MAX: u64 = 3
const WBUF: u64 = 0x200
const RBUF: u64 = 0x300
const CTL_DELAY_US: u64 = 10000
const LINK_WAIT_STEPS: u64 = 30
const LINK_STEP_US: u64 = 100000
const HOUSE_TICKS: u64 = 100
const NO_REPLY: u64 = 0x1FFFFFFFF

fn getc(b: u64, off: u64) -> u64 {
    let p: *mut u64 = (b + off) as *mut u64
    return *p
}

fn setc(b: u64, off: u64, v: u64) {
    let p: *mut u64 = (b + off) as *mut u64
    *p = v
}

fn link(b: u64) -> u64 { return getc(b, X_LINK) }
fn bmsr(b: u64) -> u64 { return getc(b, X_BMSR) }
fn cfg(b: u64) -> u64 { return getc(b, X_CFG) }
fn fw(b: u64) -> u64 { return getc(b, X_FWV) }
fn changes(b: u64) -> u64 { return getc(b, X_CHG) }
fn bmcr(b: u64) -> u64 { return getc(b, X_BMCR) }
fn phyid(b: u64) -> u64 { return getc(b, X_PHYID) }
fn aner(b: u64) -> u64 { return getc(b, X_ANER) }
fn anar(b: u64) -> u64 { return getc(b, X_ANAR) }
fn lpa(b: u64) -> u64 { return getc(b, X_LPA) }
fn kicks(b: u64) -> u64 { return getc(b, X_KICKS) }
fn kick_rc(b: u64) -> u64 { return getc(b, X_KICKRC) }

fn intr_get(b: u64, which: u64) -> u64 {
    if which == 0 { return getc(b, X_INTDCI) }
    if which == 1 { return getc(b, X_INTN) }
    if which == 2 { return getc(b, X_INTLAST) }
    if which == 3 { return getc(b, X_INTLINK) }
    if which == 4 { return getc(b, X_INTERR) }
    if which == 5 { return getc(b, X_INTARMS) }
    return 0
}

fn hexn(v: u64, digits: u64) {
    var i: u64 = digits
    while i > 0 {
        i = i - 1
        let x: u64 = (v >> (i * 4)) & 15
        if x < 10 {
            serial.put((48 + x) as u8)
        } else {
            serial.put((87 + x) as u8)
        }
    }
}

fn ld(p: u64, i: u64) -> u64 {
    let q: *mut u8 = (p + i) as *mut u8
    let v: u8 = *q
    return v as u64
}

fn st(p: u64, i: u64, v: u64) {
    let q: *mut u8 = (p + i) as *mut u8
    *q = (v & 255) as u8
}

fn read_reg(state: u64, b: u64, slot: u64, reg: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < 8 {
        st(b + RBUF, i, 0)
        i = i + 1
    }
    let r: i64 = xhci.control(state, slot, 0xC0, ch397.REQ_READ_REG, reg & 0xFFFF, reg >> 16, n, b + RBUF, true)
    xhci.udelay(state, CTL_DELAY_US)
    if r < n as i64 {
        return NO_REPLY
    }
    var v: u64 = 0
    i = 0
    while i < n {
        v = v | (ld(b + RBUF, i) << (i * 8))
        i = i + 1
    }
    return v
}

fn write_reg(state: u64, b: u64, slot: u64, reg: u64, n: u64, val: u64) -> bool {
    var i: u64 = 0
    while i < n {
        st(b + WBUF, i, val >> (i * 8))
        i = i + 1
    }
    let r: i64 = xhci.control(state, slot, 0x40, ch397.REQ_WRITE_REG, reg & 0xFFFF, reg >> 16, n, b + WBUF, false)
    xhci.udelay(state, CTL_DELAY_US)
    return r >= 0
}

fn phy_read(state: u64, b: u64, slot: u64, reg: u64) -> u64 {
    st(b + RBUF, 0, 0)
    st(b + RBUF, 1, 0)
    let r: i64 = xhci.control(state, slot, 0xC0, ch397.REQ_PHY_READ, ch397.PHY_BASE, reg, 2, b + RBUF, true)
    xhci.udelay(state, CTL_DELAY_US)
    if r < 2 {
        return NO_REPLY
    }
    return ld(b + RBUF, 0) | (ld(b + RBUF, 1) << 8)
}

fn phy_write(state: u64, b: u64, slot: u64, reg: u64, val: u64) -> bool {
    st(b + WBUF, 0, val)
    st(b + WBUF, 1, val >> 8)
    let r: i64 = xhci.control(state, slot, 0x40, ch397.REQ_PHY_WRITE, ch397.PHY_BASE, reg, 2, b + WBUF, false)
    xhci.udelay(state, CTL_DELAY_US)
    return r >= 0
}

fn kick_enabled(state: u64) -> bool {
    return !kstate.mode_on(state, kstate.M_NOPHYKICK)
}

fn kick(state: u64, b: u64, slot: u64, stamp: u64) {
    setc(b, X_KICKS, getc(b, X_KICKS) + 1)
    var rc: u64 = 0
    if ch397.autoneg_by_request(getc(b, X_FWV)) {
        let r: i64 = xhci.control(state, slot, 0x40, ch397.REQ_AUTONEG, ch397.AUTONEG_ON, 0, 0, 0, false)
        xhci.udelay(state, CTL_DELAY_US)
        if r < 0 {
            rc = rc | 1
        }
    }
    if !phy_write(state, b, slot, ch397.MII_BMCR, ch397.BMCR_KICK) {
        rc = rc | 2
    }
    setc(b, X_KICKRC, rc)
    setc(b, X_KICKT, stamp)
}

fn refresh_bmcr(state: u64, b: u64, slot: u64) -> u64 {
    let v: u64 = phy_read(state, b, slot, ch397.MII_BMCR)
    setc(b, X_BMCR, v)
    return v
}

fn refresh_regs(state: u64, b: u64, slot: u64) -> u64 {
    let bc: u64 = refresh_bmcr(state, b, slot)
    let i1: u64 = phy_read(state, b, slot, ch397.MII_ID1)
    let i2: u64 = phy_read(state, b, slot, ch397.MII_ID2)
    setc(b, X_PHYID, ((i2 & 0xFFFF) << 16) | (i1 & 0xFFFF))
    setc(b, X_ANER, phy_read(state, b, slot, ch397.MII_ANER))
    return bc
}

fn cfg_write(state: u64, b: u64, slot: u64, v: u64) -> bool {
    if ch397.maccfg_by_request(getc(b, X_FWV)) {
        let r: i64 = xhci.control(state, slot, 0x40, ch397.REQ_WRITE_MACCFG, v & 0xFFFF, (v >> 16) & 0xFFFF, 0, 0, false)
        xhci.udelay(state, CTL_DELAY_US)
        return r >= 0
    }
    return write_reg(state, b, slot, ch397.REG_MAC_CFG, 4, v)
}

fn apply_media(state: u64, b: u64, slot: u64) -> bool {
    let anar: u64 = phy_read(state, b, slot, ch397.MII_ANAR)
    let lpa: u64 = phy_read(state, b, slot, ch397.MII_LPA)
    if anar == NO_REPLY || lpa == NO_REPLY {
        return false
    }
    setc(b, X_ANAR, anar)
    setc(b, X_LPA, lpa)
    let v: u64 = ch397.media_cfg(getc(b, X_CFG), anar, lpa)
    let w: u64 = ch397.rx_mode_cfg(v)
    setc(b, X_CFG, w)
    return cfg_write(state, b, slot, w)
}

fn intr_arm(state: u64, b: u64, slot: u64, i: u64) {
    var len: u64 = getc(b, X_INTMPS)
    if len == 0 || len > INT_BUF_LEN {
        len = INT_BUF_LEN
    }
    setc(b, X_INTSEQ, xhci.ep_seq(state, i))
    setc(b, X_INTARMED, 1)
    setc(b, X_INTARMS, getc(b, X_INTARMS) + 1)
    xhci.int_queue(state, slot, getc(b, X_INTDCI), b + X_INTBUF, len)
}

fn intr_take(state: u64, b: u64, slot: u64, i: u64) -> bool {
    setc(b, X_INTARMED, 0)
    let cc: u64 = xhci.ep_code(state, i)
    if cc != xhci.CC_SUCCESS && cc != xhci.CC_SHORT {
        setc(b, X_INTERR, getc(b, X_INTERR) + 1)
        if xhci.ep_halted(state, slot, getc(b, X_INTDCI)) {
            xhci.reset_endpoint(state, slot, getc(b, X_INTDCI))
            xhci.set_dequeue(state, slot, getc(b, X_INTDCI), i)
        }
        return false
    }
    var want: u64 = getc(b, X_INTMPS)
    if want == 0 || want > INT_BUF_LEN {
        want = INT_BUF_LEN
    }
    if xhci.ep_resid(state, i) >= want {
        return false
    }
    let v: u64 = ld(b + X_INTBUF, 0)
    setc(b, X_INTN, getc(b, X_INTN) + 1)
    setc(b, X_INTLAST, v)
    var nl: u64 = 2
    if (v & INT_LINK_BIT) != 0 {
        nl = 1
    }
    if nl == getc(b, X_INTLINK) {
        return false
    }
    setc(b, X_INTLINK, nl)
    return true
}

fn intr_poll(state: u64, b: u64, slot: u64) -> bool {
    if getc(b, X_INTDCI) == 0 {
        return false
    }
    let i: u64 = xhci.ep_find(state, slot, getc(b, X_INTDCI))
    if i >= xhci.MAX_EP {
        return false
    }
    var changed: bool = false
    if getc(b, X_INTARMED) != 0 && xhci.ep_seq(state, i) != getc(b, X_INTSEQ) {
        changed = intr_take(state, b, slot, i)
    }
    if getc(b, X_INTARMED) == 0 && getc(b, X_INTERR) < INT_ERR_MAX {
        intr_arm(state, b, slot, i)
    }
    return changed
}

fn sample_link(state: u64, b: u64, slot: u64) -> u64 {
    var bm: u64 = phy_read(state, b, slot, ch397.MII_BMSR)
    if bm != NO_REPLY && !ch397.link_up(bm) {
        bm = phy_read(state, b, slot, ch397.MII_BMSR)
    }
    return bm
}

fn mode_line(b: u64) {
    var s_h: [u8; 17] = "usb: ch336 link=\0"
    var s_u: [u8; 3] = "up\0"
    var s_d: [u8; 5] = "down\0"
    var s_b: [u8; 7] = " bmsr=\0"
    var s_a: [u8; 7] = " anar=\0"
    var s_l: [u8; 6] = " lpa=\0"
    var s_c: [u8; 6] = " cfg=\0"
    var s_f: [u8; 5] = " fw=\0"
    var s_m: [u8; 7] = " bmcr=\0"
    var s_k: [u8; 8] = " kicks=\0"
    serial.puts((&s_h[0]) as u64)
    if getc(b, X_LINK) == 1 {
        serial.puts((&s_u[0]) as u64)
    } else {
        serial.puts((&s_d[0]) as u64)
    }
    serial.puts((&s_b[0]) as u64)
    hexn(getc(b, X_BMSR), 4)
    serial.puts((&s_a[0]) as u64)
    hexn(getc(b, X_ANAR), 4)
    serial.puts((&s_l[0]) as u64)
    hexn(getc(b, X_LPA), 4)
    serial.puts((&s_c[0]) as u64)
    hexn(getc(b, X_CFG), 8)
    serial.puts((&s_f[0]) as u64)
    hexn(getc(b, X_FWV), 2)
    serial.puts((&s_m[0]) as u64)
    hexn(getc(b, X_BMCR), 4)
    serial.puts((&s_k[0]) as u64)
    hexn(getc(b, X_KICKS), 2)
    serial.nl()
}

fn bringup(state: u64, b: u64, slot: u64, fwver: u64, intinfo: u64) -> bool {
    setc(b, X_FWV, fwver)
    setc(b, X_INTDCI, intinfo & 255)
    setc(b, X_INTMPS, (intinfo >> 8) & 0xFFFF)
    setc(b, X_INTN, 0)
    setc(b, X_INTLAST, 0)
    setc(b, X_INTLINK, 0)
    setc(b, X_INTERR, 0)
    setc(b, X_INTARMS, 0)
    setc(b, X_INTSEQ, 0)
    setc(b, X_INTARMED, 0)
    setc(b, X_CHG, 0)
    setc(b, X_NEXT, 0)
    setc(b, X_LINK, 0)
    setc(b, X_BMSR, 0)
    setc(b, X_ANAR, 0)
    setc(b, X_LPA, 0)
    setc(b, X_BMCR, 0)
    setc(b, X_PHYID, 0)
    setc(b, X_ANER, 0)
    setc(b, X_KICKS, 0)
    setc(b, X_KICKT, 0)
    setc(b, X_KICKRC, 0)
    let c: u64 = read_reg(state, b, slot, ch397.REG_MAC_CFG, 4)
    if c == NO_REPLY {
        return false
    }
    setc(b, X_CFG, c)
    write_reg(state, b, slot, ch397.REG_HASH_HI, 4, 0xFFFFFFFF)
    write_reg(state, b, slot, ch397.REG_HASH_LO, 4, 0xFFFFFFFF)
    let bc0: u64 = refresh_regs(state, b, slot)
    if kick_enabled(state) && bc0 != NO_REPLY && ch397.bmcr_bad(bc0) {
        kick(state, b, slot, 0)
    }
    var steps: u64 = 0
    var bm: u64 = NO_REPLY
    while steps < LINK_WAIT_STEPS {
        bm = sample_link(state, b, slot)
        if bm != NO_REPLY && ch397.link_up(bm) {
            steps = LINK_WAIT_STEPS
        } else {
            xhci.udelay(state, LINK_STEP_US)
            steps = steps + 1
        }
    }
    if bm == NO_REPLY {
        bm = 0
    }
    if !ch397.link_up(bm) && kick_enabled(state) && getc(b, X_KICKS) == 0 {
        kick(state, b, slot, 0)
    }
    refresh_regs(state, b, slot)
    setc(b, X_BMSR, bm)
    if ch397.link_up(bm) {
        setc(b, X_LINK, 1)
        apply_media(state, b, slot)
    } else {
        setc(b, X_LINK, 2)
        let w: u64 = ch397.rx_mode_cfg(c)
        setc(b, X_CFG, w)
        cfg_write(state, b, slot, w)
    }
    mode_line(b)
    return true
}

fn house(state: u64, b: u64, slot: u64, now: u64) -> u64 {
    if intr_poll(state, b, slot) {
        setc(b, X_NEXT, 0)
    }
    if now < getc(b, X_NEXT) {
        return 0
    }
    setc(b, X_NEXT, now + HOUSE_TICKS)
    let bm: u64 = sample_link(state, b, slot)
    if bm == NO_REPLY {
        return 0
    }
    setc(b, X_BMSR, bm)
    var now_link: u64 = 2
    if ch397.link_up(bm) {
        now_link = 1
    }
    let phy_link: u64 = now_link
    if now_link == 2 {
        refresh_bmcr(state, b, slot)
        if kick_enabled(state) && getc(b, X_KICKS) < KICK_MAX {
            let t0: u64 = getc(b, X_KICKT)
            if t0 == 0 {
                setc(b, X_KICKT, now + 1)
            } else if now + 1 - t0 >= KICK_TICKS {
                kick(state, b, slot, now + 1)
                refresh_regs(state, b, slot)
                mode_line(b)
            }
        }
    }
    if phy_link == 2 && getc(b, X_INTLINK) == 1 {
        now_link = 1
    }
    if now_link == getc(b, X_LINK) {
        return 0
    }
    setc(b, X_LINK, now_link)
    setc(b, X_CHG, getc(b, X_CHG) + 1)
    if now_link == 1 {
        apply_media(state, b, slot)
    }
    mode_line(b)
    return now_link
}
