// SPDX-License-Identifier: GPL-2.0-only
profile kernel

import serial
import wlan.iwl_le
import wlan.frame
import wlan.wpa
import wlan.llc
import wlan.ccmp
import crypto.aes
import drv.net.iwl_fakeap_frames
import libc.octets

export { reset, set_drop, set_knobs, set_gateway_silent, on_tx, resp_ptr, resp_len, stat, STAT_AUTH, STAT_ASSOC, STAT_M2, STAT_BADMIC, STAT_M4, STAT_DISCOVER, STAT_REQUEST, STAT_DATA, STAT_ARP, STAT_ICMP, STAT_DNS, STAT_TCP, STAT_LOST, STAT_DUPED, STAT_REORD, STAT_RETX, STAT_AMSDU, STAT_ADDBA }

const SLOT: u64 = 1536
const SLOTS: u64 = 24
const BATCH: u64 = 3
const LOSS_PERIOD: u64 = 211
const DUP_PERIOD: u64 = 97
const REORD_PERIOD: u64 = 149
const FAULT_TAIL: u64 = 10
const LOSS_EXTRA: u64 = 8
const DUPACK_RETX: u64 = 3
const DUPACK_STUCK: u64 = 24
const BURST_MIN_LEN: u64 = 100
const BURST_COUNT: u64 = 24
const ST_IDLE: u64 = 0
const ST_AUTHED: u64 = 1
const ST_M1: u64 = 2
const ST_M3: u64 = 3
const ST_KEYED: u64 = 4
const AKM: u64 = 2

const STAT_AUTH: u64 = 0
const STAT_ASSOC: u64 = 1
const STAT_M2: u64 = 2
const STAT_BADMIC: u64 = 3
const STAT_M4: u64 = 4
const STAT_DISCOVER: u64 = 5
const STAT_REQUEST: u64 = 6
const STAT_DATA: u64 = 7
const STAT_ARP: u64 = 8
const STAT_ICMP: u64 = 9
const STAT_DNS: u64 = 10
const STAT_TCP: u64 = 11
const STAT_LOST: u64 = 12
const STAT_DUPED: u64 = 13
const STAT_REORD: u64 = 14
const STAT_RETX: u64 = 15
const STAT_AMSDU: u64 = 16
const STAT_ADDBA: u64 = 17
const TCP_ISN: u64 = 1000
const TCP_SEG: u64 = 400
const TCP_WINDOW: u64 = 6400
const TCP_BURST: u64 = 16

static mut fa_state: u64 = 0
static mut fa_drop_arm: u64 = 0
static mut fa_deaf: u64 = 0
static mut fa_msg_drop: [u8; 13] = "fakeap: drop\0"
static mut fa_pmk_ok: u64 = 0
static mut fa_resp_n: u64 = 0
static mut fa_nonce_seq: u64 = 0
static mut fa_stats: [u64; 32] = [0 as u64; 32]
static mut fa_resp_len: [u64; 32] = [0 as u64; 32]
static mut fa_resp: [u8; 36864] = [0 as u8; 36864]
static mut fa_big: [u8; 1700] = [0 as u8; 1700]
static mut fa_pmk: [u8; 32] = [0 as u8; 32]
static mut fa_ptk: [u8; 48] = [0 as u8; 48]
static mut fa_anonce: [u8; 32] = [0 as u8; 32]
static mut fa_sta: [u8; 6] = [0 as u8; 6]
static mut fa_bssid: [u8; 6] = [0 as u8; 6]
static mut fa_pn: [u8; 6] = [0 as u8; 6]
static mut fa_gpn: [u8; 6] = [0 as u8; 6]
static mut fa_gtk: [u8; 16] = [0 as u8; 16]
static mut fa_plain: [u8; 640] = [0 as u8; 640]
static mut fa_out: [u8; 640] = [0 as u8; 640]
static mut fa_kd: [u8; 48] = [0 as u8; 48]
static mut fa_mic: [u8; 16] = [0 as u8; 16]
static mut fa_msg_auth: [u8; 14] = "fakeap: auth\0\0"
static mut fa_msg_assoc: [u8; 14] = "fakeap: assoc\0"
static mut fa_msg_m2ok: [u8; 14] = "fakeap: m2 ok\0"
static mut fa_msg_bad: [u8; 18] = "fakeap: m2 badmic\0"
static mut fa_msg_m4: [u8; 14] = "fakeap: m4 ok\0"
static mut fa_msg_disc: [u8; 17] = "fakeap: discover\0"
static mut fa_msg_req: [u8; 16] = "fakeap: request\0"
static mut fa_msg_arp: [u8; 12] = "fakeap: arp\0"
static mut fa_msg_echo: [u8; 14] = "fakeap: echo\0\0"
static mut fa_msg_icmp: [u8; 13] = "fakeap: icmp\0"
static mut fa_msg_dns: [u8; 12] = "fakeap: dns\0"
static mut fa_msg_tcp: [u8; 12] = "fakeap: tcp\0"
static mut ft_on: u64 = 0
static mut ft_req: u64 = 0
static mut ft_fin: u64 = 0
static mut ft_cip: u64 = 0
static mut ft_cport: u64 = 0
static mut ft_rcv: u64 = 0
static mut ft_sent: u64 = 0
static mut ft_acked: u64 = 0
static mut ft_hold: u64 = 0
static mut ft_hw: u64 = 0
static mut ft_lastack: u64 = 0
static mut ft_dupack: u64 = 0
static mut ft_lost_end: u64 = 0
static mut ft_recover: u64 = 0
static mut ft_wnd: u64 = 0
static mut ft_mark: u64 = 0
static mut fh_on: u64 = 0
static mut fh_off: u64 = 0
static mut fh_len: u64 = 0
static mut fb_n: u64 = 0
static mut fb_off: [u64; 4] = [0 as u64; 4]
static mut fb_len: [u64; 4] = [0 as u64; 4]
static mut fk_loss: u64 = 0
static mut fk_dup: u64 = 0
static mut fk_reord: u64 = 0
static mut fk_amsdu: u64 = 0
static mut fk_noretx: u64 = 0
static mut fk_addba: u64 = 0
static mut fk_gateway_silent: u64 = 0
static mut fa_msg_lost: [u8; 14] = "fakeap: lost \0"
static mut fa_msg_duped: [u8; 14] = "fakeap: dup  \0"
static mut fa_msg_held: [u8; 14] = "fakeap: held \0"
static mut fa_msg_retx: [u8; 15] = "fakeap: retx  \0"
static mut fa_msg_addba: [u8; 20] = "fakeap: addba req  \0"
static mut fa_msg_decl: [u8; 23] = "fakeap: addba declined\0"
static mut fa_drop_mode: u64 = 0
static mut fa_discovers: u64 = 0
static mut fa_lease: u64 = 0

fn say(msg: u64) {
    serial.puts(msg)
    serial.nl()
}

fn stat(i: u64) -> u64 { return fa_stats[(i & 31) as usize] }

fn bump(i: u64) { fa_stats[(i & 31) as usize] = fa_stats[(i & 31) as usize] + 1 }

fn say_num(msg: u64, v: u64) {
    serial.puts(msg)
    serial.dec(v)
    serial.nl()
}

fn set_knobs(bulk: u64, loss: u64, dup: u64, reord: u64, amsdu: u64, noretx: u64, addba: u64) {
    iwl_fakeap_frames.set_bulk(bulk)
    fk_loss = loss
    fk_dup = dup
    fk_reord = reord
    fk_amsdu = amsdu
    fk_noretx = noretx
    fk_addba = addba
}

fn set_gateway_silent(on: u64) {
    fk_gateway_silent = on
}

fn set_drop(on: u64) {
    fa_drop_arm = on
    fa_drop_mode = on
}

fn reset() {
    fa_state = ST_IDLE
    fa_deaf = 0
    fa_resp_n = 0
    fa_nonce_seq = 0
    fa_lease = iwl_fakeap_frames.LEASE_IP
    fa_discovers = 0
    var i: u64 = 0
    while i < 32 {
        fa_stats[i as usize] = 0
        i = i + 1
    }
    octets.zero((&fa_pn[0]) as u64, 6)
    octets.zero((&fa_gpn[0]) as u64, 6)
    group_key_fill()
    iwl_fakeap_frames.bssid_set(0, (&fa_bssid[0]) as u64)
}

fn slot_ptr(k: u64) -> u64 { return (&fa_resp[0]) as u64 + k * SLOT }

fn resp_ptr(k: u64) -> u64 { return slot_ptr(k) }

fn resp_len(k: u64) -> u64 { return fa_resp_len[(k & 31) as usize] }

fn queue_begin() -> u64 {
    if fa_resp_n >= SLOTS { return 0 }
    return slot_ptr(fa_resp_n)
}

fn queue_commit(n: u64) {
    fa_resp_len[fa_resp_n as usize] = n
    fa_resp_n = fa_resp_n + 1
}

fn bssid_addr() -> u64 { return (&fa_bssid[0]) as u64 }
fn sta_addr() -> u64 { return (&fa_sta[0]) as u64 }
fn ptk_addr() -> u64 { return (&fa_ptk[0]) as u64 }

fn put_be16(a: u64, o: u64, v: u64) {
    octets.st8(a, o, v >> 8)
    octets.st8(a, o + 1, v)
}

fn ld_be16(a: u64, o: u64) -> u64 {
    return (octets.ld8(a, o) << 8) | octets.ld8(a, o + 1)
}

fn make_nonce() {
    fa_nonce_seq = fa_nonce_seq + 1
    var i: u64 = 0
    while i < 32 {
        fa_anonce[i as usize] = ((i * 7 + 3 + fa_nonce_seq * 29) & 255) as u8
        i = i + 1
    }
}

fn ensure_pmk() -> bool {
    if fa_pmk_ok != 0 { return true }
    let ok: bool = wpa.pmk_off_password(iwl_fakeap_frames.pass_ptr(), iwl_fakeap_frames.PASS_LEN as usize,
        iwl_fakeap_frames.ssid_ptr(0), iwl_fakeap_frames.net_ssid_len(0) as usize, (&fa_pmk[0]) as u64)
    if ok { fa_pmk_ok = 1 }
    return ok
}

fn key_head(f: u64) -> u64 {
    let hl: u64 = iwl_fakeap_frames.data_head_from_ds(f, sta_addr(), bssid_addr())
    return hl + llc.snap_build(f + hl, llc.ET_EAPOL) as u64
}

fn key_fixed(e: u64, key_info: u64, counter: u64, dlen: u64) {
    octets.zero(e, 99 + dlen)
    octets.st8(e, 0, 2)
    octets.st8(e, 1, 3)
    put_be16(e, 2, 95 + dlen)
    octets.st8(e, 4, 2)
    put_be16(e, 5, key_info)
    put_be16(e, 7, 16)
    octets.st8(e, 16, counter)
    var i: u64 = 0
    while i < 32 {
        octets.st8(e, 17 + i, fa_anonce[i as usize] as u64)
        i = i + 1
    }
    put_be16(e, 97, dlen)
}

fn send_m1() {
    let f: u64 = queue_begin()
    if f == 0 { return }
    make_nonce()
    let at: u64 = key_head(f)
    key_fixed(f + at, 0x008A, 1, 0)
    queue_commit(at + 99)
    fa_state = ST_M1
}

fn group_key_fill() {
    var i: u64 = 0
    while i < 16 {
        fa_gtk[i as usize] = (0xA0 + i) as u8
        i = i + 1
    }
}

fn build_keydata() {
    let k: u64 = (&fa_kd[0]) as u64
    octets.zero(k, 48)
    var at: u64 = iwl_fakeap_frames.rsn_ie(k, 0)
    octets.st8(k, at, 0xDD)
    octets.st8(k, at + 1, 0x16)
    octets.st8(k, at + 2, 0x00)
    octets.st8(k, at + 3, 0x0F)
    octets.st8(k, at + 4, 0xAC)
    octets.st8(k, at + 5, 0x01)
    octets.st8(k, at + 6, 0x01)
    octets.st8(k, at + 7, 0x00)
    octets.copy(k + at + 8, (&fa_gtk[0]) as u64, 16)
    at = at + 24
    octets.st8(k, at, 0xDD)
    octets.st8(k, at + 1, 0x00)
}

fn send_m3() {
    let f: u64 = queue_begin()
    if f == 0 { return }
    let at: u64 = key_head(f)
    let e: u64 = f + at
    key_fixed(e, 0x13CA, 2, 56)
    build_keydata()
    if !aes.key_wrap(ptk_addr() + 16, 16, (&fa_kd[0]) as u64, 48, e + 99) { return }
    if !wpa.mic_compute(ptk_addr(), 16, e, 155, AKM, (&fa_mic[0]) as u64) { return }
    octets.copy(e + 81, (&fa_mic[0]) as u64, 16)
    queue_commit(at + 155)
    fa_state = ST_M3
}

fn on_m2(e: u64, elen: u64) {
    if fa_state != ST_M1 { return }
    if !ensure_pmk() { return }
    if !wpa.ptk_ableiten((&fa_pmk[0]) as u64, 32, bssid_addr(), sta_addr(), (&fa_anonce[0]) as u64, e + 17, AKM,
        ptk_addr(), 48) { return }
    if !wpa.mic_check(ptk_addr(), 16, e, elen as usize, AKM) {
        bump(STAT_BADMIC)
        say((&fa_msg_bad[0]) as u64)
        return
    }
    bump(STAT_M2)
    say((&fa_msg_m2ok[0]) as u64)
    send_m3()
}

fn on_m4(e: u64, elen: u64) {
    if fa_state != ST_M3 { return }
    if !wpa.mic_check(ptk_addr(), 16, e, elen as usize, AKM) {
        bump(STAT_BADMIC)
        return
    }
    bump(STAT_M4)
    say((&fa_msg_m4[0]) as u64)
    octets.zero((&fa_pn[0]) as u64, 6)
    fa_state = ST_KEYED
}

fn on_eapol(e: u64, avail: u64) {
    if avail < 99 { return }
    var elen: u64 = 4 + ld_be16(e, 2)
    if elen > avail { return }
    let ki: u64 = ld_be16(e, 5)
    if (ki & 0x0100) == 0 || (ki & 0x0080) != 0 { return }
    if (ki & 0x0200) != 0 { on_m4(e, elen) } else { on_m2(e, elen) }
}

fn next_pn() { pn_step((&fa_pn[0]) as u64) }

fn pn_step(pn: u64) {
    var i: u64 = 6
    while i > 0 {
        i = i - 1
        let v: u64 = octets.ld8(pn, i) + 1
        octets.st8(pn, i, v)
        if v < 256 { return }
    }
}

fn send_protected(plain: u64, n: u64) {
    let f: u64 = queue_begin()
    if f == 0 { return }
    next_pn()
    let m: i64 = ccmp.protect(ptk_addr() + 32, (&fa_pn[0]) as u64, plain, n as usize, f, SLOT as usize)
    if m < 0 { return }
    queue_commit(m as u64)
}

fn send_group(plain: u64, n: u64) {
    let f: u64 = queue_begin()
    if f == 0 { return }
    pn_step((&fa_gpn[0]) as u64)
    let m: i64 = ccmp.protect((&fa_gtk[0]) as u64, (&fa_gpn[0]) as u64, plain, n as usize, f, SLOT as usize)
    if m < 0 { return }
    octets.st8(f, 27, 0x60)
    queue_commit(m as u64)
}

fn send_dhcp(kind: u64, xid: u64) {
    let o: u64 = (&fa_out[0]) as u64
    let hl: u64 = iwl_fakeap_frames.data_head_from_ds(o, sta_addr(), bssid_addr())
    llc.snap_build(o + hl, llc.ET_IPV4)
    let dl: u64 = iwl_fakeap_frames.dhcp_reply_build(o + 60, kind, xid, sta_addr(), fa_lease)
    llc.udp_build(o + 52, iwl_fakeap_frames.AP_IP, 0xFFFFFFFF, 67, 68, dl as usize)
    llc.ipv4_build(o + 32, iwl_fakeap_frames.AP_IP, 0xFFFFFFFF, llc.P_UDP, (8 + dl) as usize, 7)
    send_protected(o, 60 + dl)
}

fn ld_be32(a: u64, o: u64) -> u64 {
    return (ld_be16(a, o) << 16) | ld_be16(a, o + 2)
}

fn on_arp(a: u64, n: u64, broadcast: bool) {
    if n < 28 { return }
    if ld_be16(a, 6) != 1 { return }
    if ld_be32(a, 24) != iwl_fakeap_frames.AP_IP { return }
    if fk_gateway_silent != 0 { return }
    bump(STAT_ARP)
    say((&fa_msg_arp[0]) as u64)
    let o: u64 = (&fa_out[0]) as u64
    if broadcast {
        say((&fa_msg_echo[0]) as u64)
        send_group(o, iwl_fakeap_frames.broadcast_echo_build(o, sta_addr(), bssid_addr(), a, 28))
    }
    let len: u64 = iwl_fakeap_frames.arp_reply_build(o, sta_addr(), bssid_addr(), ld_be32(a, 14))
    send_protected(o, len)
    idle_check()
}

fn on_icmp(ip: *mut llc.Ipv4) {
    if (*ip).dest != iwl_fakeap_frames.AP_IP { return }
    if fk_gateway_silent != 0 { return }
    let n: u64 = (*ip).payload_len as u64
    if n < 8 || n > iwl_fakeap_frames.ICMP_MAX { return }
    if octets.ld8((*ip).payload, 0) != 8 { return }
    bump(STAT_ICMP)
    say((&fa_msg_icmp[0]) as u64)
    let o: u64 = (&fa_out[0]) as u64
    let len: u64 = iwl_fakeap_frames.icmp_reply_build(o, sta_addr(), bssid_addr(), (*ip).source, (*ip).payload, n)
    send_protected(o, len)
    if n >= BURST_MIN_LEN {
        var k: u64 = 1
        while k < BURST_COUNT {
            send_protected(o, len)
            k = k + 1
        }
    }
}

fn on_dns(ip: *mut llc.Ipv4, ud: *mut llc.Udp) {
    let n: u64 = (*ud).payload_len as u64
    if n < 17 || n > iwl_fakeap_frames.DNS_MAX { return }
    let q: u64 = (*ud).payload
    if (octets.ld8(q, 2) & 0x80) != 0 { return }
    if ld_be16(q, 4) != 1 { return }
    var at: u64 = 12
    while at < n && octets.ld8(q, at) != 0 { at = at + octets.ld8(q, at) + 1 }
    if at + 5 > n { return }
    let qtype: u64 = ld_be16(q, at + 1)
    bump(STAT_DNS)
    say((&fa_msg_dns[0]) as u64)
    let o: u64 = (&fa_out[0]) as u64
    let len: u64 = iwl_fakeap_frames.dns_reply_build(o, sta_addr(), bssid_addr(), (*ip).source, (*ud).source, q, at + 5, qtype == 1)
    send_protected(o, len)
}

fn batch_flush() {
    if fb_n == 0 { return }
    let o: u64 = (&fa_big[0]) as u64
    let hl: u64 = iwl_fakeap_frames.qos_head_from_ds(o, sta_addr(), bssid_addr())
    var at: u64 = hl
    var i: u64 = 0
    while i < fb_n {
        iwl_fakeap_frames.copy6(o, at, sta_addr(), 0)
        iwl_fakeap_frames.copy6(o, at + 6, bssid_addr(), 0)
        let m: u64 = iwl_fakeap_frames.msdu_tcp_build(o + at + 14, ft_cip, ft_cport, TCP_ISN + 1 + fb_off[i as usize], ft_rcv, 0x18, fb_off[i as usize], fb_len[i as usize])
        put_be16(o, at + 12, m)
        at = at + 14 + m
        if i + 1 < fb_n {
            while ((at - hl) & 3) != 0 {
                octets.st8(o, at, 0)
                at = at + 1
            }
        }
        i = i + 1
    }
    fb_n = 0
    bump(STAT_AMSDU)
    send_protected(o, at)
}

fn send_seg(flags: u64, seq: u64, off: u64, n: u64) {
    batch_flush()
    let o: u64 = (&fa_out[0]) as u64
    send_protected(o, iwl_fakeap_frames.tcp_segment_build(o, sta_addr(), bssid_addr(), ft_cip, ft_cport, seq, ft_rcv, flags, off, n))
}

fn emit_data(off: u64, n: u64) {
    if fk_amsdu == 0 {
        send_seg(0x18, TCP_ISN + 1 + off, off, n)
        return
    }
    fb_off[fb_n as usize] = off
    fb_len[fb_n as usize] = n
    fb_n = fb_n + 1
    if fb_n >= BATCH { batch_flush() }
}

fn fault_kind(idx: u64) -> u64 {
    if fk_loss != 0 && idx % LOSS_PERIOD == LOSS_PERIOD - 1 { return 1 }
    if fk_dup != 0 && idx % DUP_PERIOD == DUP_PERIOD - 1 { return 2 }
    if fk_reord != 0 && idx % REORD_PERIOD == REORD_PERIOD - 1 { return 3 }
    return 0
}

fn held_flush() {
    if fh_on == 0 { return }
    fh_on = 0
    emit_data(fh_off, fh_len)
}

fn send_data(off: u64, n: u64) {
    var kind: u64 = 0
    if off >= ft_hw {
        ft_hw = off + n
        if iwl_fakeap_frames.stream_total() - off > FAULT_TAIL * TCP_SEG { kind = fault_kind(off / TCP_SEG) }
    } else {
        bump(STAT_RETX)
    }
    if kind == 1 {
        bump(STAT_LOST)
        ft_lost_end = off + n
        say_num((&fa_msg_lost[0]) as u64, off)
        return
    }
    if kind == 3 && fh_on == 0 {
        bump(STAT_REORD)
        fh_on = 1
        fh_off = off
        fh_len = n
        say_num((&fa_msg_held[0]) as u64, off)
        return
    }
    emit_data(off, n)
    if kind == 2 {
        bump(STAT_DUPED)
        say_num((&fa_msg_duped[0]) as u64, off)
        emit_data(off, n)
    }
    held_flush()
}

fn window_limit() -> u64 {
    if ft_lost_end > ft_acked { return TCP_WINDOW + LOSS_EXTRA * TCP_SEG }
    return TCP_WINDOW
}

fn can_send(n: u64) -> bool {
    let out: u64 = ft_sent - ft_acked
    if out >= window_limit() { return false }
    return out + n <= ft_wnd
}

fn tcp_pump(want_ack: bool) {
    let total: u64 = iwl_fakeap_frames.stream_total()
    var sent_now: u64 = 0
    if ft_req != 0 && ft_hold == 0 {
        while ft_sent < total && sent_now < TCP_BURST {
            var n: u64 = total - ft_sent
            if n > TCP_SEG { n = TCP_SEG }
            if !can_send(n) { break }
            send_data(ft_sent, n)
            ft_sent = ft_sent + n
            sent_now = sent_now + 1
        }
        held_flush()
        batch_flush()
        if ft_sent == total && ft_acked == total && ft_fin == 0 {
            send_seg(0x11, TCP_ISN + 1 + total, 0, 0)
            ft_fin = 1
            sent_now = sent_now + 1
        }
    }
    if want_ack && sent_now == 0 {
        send_seg(0x10, TCP_ISN + 1 + ft_sent + ft_fin, 0, 0)
    }
}

fn idle_check() {
    if ft_on == 0 || ft_req == 0 || ft_hold != 0 || fk_noretx != 0 { return }
    if ft_acked >= iwl_fakeap_frames.stream_total() { return }
    if ft_acked != ft_mark {
        ft_mark = ft_acked
        return
    }
    if ft_sent > ft_acked {
        ft_recover = ft_sent
        ft_sent = ft_acked
        ft_dupack = 0
        fh_on = 0
        fb_n = 0
        say_num((&fa_msg_retx[0]) as u64, ft_acked)
    }
    tcp_pump(false)
}

fn addba_request() {
    let f: u64 = queue_begin()
    if f == 0 { return }
    queue_commit(iwl_fakeap_frames.addba_request_build(f, sta_addr(), bssid_addr(), 1))
    say_num((&fa_msg_addba[0]) as u64, 1)
}

fn on_tcp(ip: *mut llc.Ipv4) {
    if (*ip).dest != iwl_fakeap_frames.AP_IP { return }
    var t: llc.Tcp = llc.tcp_new()
    if !llc.tcp_parse(&t, (*ip).payload, (*ip).payload_len, (*ip).source, (*ip).dest) { return }
    if !t.sum_ok || t.dest != 80 { return }
    if (t.flags & 2) != 0 {
        ft_on = 1
        ft_req = 0
        ft_hold = 0
        ft_fin = 0
        ft_cip = (*ip).source
        ft_cport = t.source
        ft_rcv = (t.seq + 1) & 0xFFFFFFFF
        ft_sent = 0
        ft_acked = 0
        ft_hw = 0
        ft_dupack = 0
        ft_lost_end = 0
        ft_recover = 0
        ft_wnd = t.window
        ft_mark = 0xFFFFFFFF
        fh_on = 0
        fb_n = 0
        bump(STAT_TCP)
        say((&fa_msg_tcp[0]) as u64)
        if fk_addba != 0 && stat(STAT_ADDBA) == 0 { addba_request() }
        send_seg(0x12, TCP_ISN, 0, 0)
        return
    }
    if ft_on == 0 || t.source != ft_cport || (*ip).source != ft_cip { return }
    var need_ack: bool = false
    let acked_before: u64 = ft_acked
    let wnd_before: u64 = ft_wnd
    if (t.flags & 16) != 0 { ft_wnd = t.window }
    if (t.flags & 16) != 0 && t.ack > TCP_ISN + 1 {
        var a: u64 = t.ack - TCP_ISN - 1
        if a > ft_sent { a = ft_sent }
        if a > ft_acked { ft_acked = a }
    }
    if t.payload_len == 0 && (t.flags & 3) == 0 && ft_acked == acked_before && ft_wnd == wnd_before && ft_sent > ft_acked {
        ft_dupack = ft_dupack + 1
        if fk_noretx == 0 && ((ft_dupack >= DUPACK_RETX && ft_acked >= ft_recover) || ft_dupack >= DUPACK_STUCK) {
            ft_dupack = 0
            ft_recover = ft_sent
            ft_sent = ft_acked
            fh_on = 0
            fb_n = 0
            say_num((&fa_msg_retx[0]) as u64, ft_acked)
        }
    }
    if ft_acked != acked_before { ft_dupack = 0 }
    if t.payload_len > 0 {
        need_ack = true
        if t.seq == ft_rcv {
            ft_rcv = (ft_rcv + t.payload_len as u64) & 0xFFFFFFFF
            ft_req = 1
            if t.payload_len >= 9 && octets.ld8(t.payload, 4) == 47 && octets.ld8(t.payload, 5) == 104 && octets.ld8(t.payload, 6) == 111 && octets.ld8(t.payload, 7) == 108 && octets.ld8(t.payload, 8) == 100 { ft_hold = 1 }
        }
    }
    if (t.flags & 1) != 0 && t.seq + t.payload_len as u64 == ft_rcv {
        ft_rcv = (ft_rcv + 1) & 0xFFFFFFFF
        need_ack = true
    }
    tcp_pump(need_ack)
}

fn on_ip(p: u64, n: u64) {
    let hl: i64 = frame.header_len(p, n as usize)
    if hl < 0 { return }
    let h: u64 = hl as u64
    if n < h + 8 + 20 { return }
    let et: u64 = llc.snap_parse(p + h, (n - h) as usize)
    if et == llc.ET_ARP {
        on_arp(p + h + 8, n - h - 8, (octets.ld8(p, 16) & 1) != 0)
        return
    }
    if et != llc.ET_IPV4 { return }
    let at: u64 = h + 8
    var ip: llc.Ipv4 = llc.ipv4_new()
    if !llc.ipv4_parse(&ip, p + at, (n - at) as usize) { return }
    if ip.proto == llc.P_ICMP {
        on_icmp(&ip)
        return
    }
    if ip.proto == llc.P_TCP {
        on_tcp(&ip)
        return
    }
    if ip.proto != llc.P_UDP { return }
    var ud: llc.Udp = llc.udp_new()
    if !llc.udp_parse(&ud, ip.payload, ip.payload_len, ip.source, ip.dest) { return }
    if ud.dest == 53 && ip.dest == iwl_fakeap_frames.AP_IP {
        on_dns(&ip, &ud)
        return
    }
    if ud.dest != 67 { return }
    var dh: llc.Dhcp = llc.dhcp_new()
    if !llc.dhcp_parse(&dh, ud.payload, ud.payload_len) { return }
    if dh.art == llc.D_DISCOVER {
        fa_discovers = fa_discovers + 1
        fa_lease = iwl_fakeap_frames.LEASE_IP
        if fa_drop_mode != 0 && (fa_discovers & 1) == 0 { fa_lease = iwl_fakeap_frames.LEASE_IP_ALT }
        bump(STAT_DISCOVER)
        say((&fa_msg_disc[0]) as u64)
        send_dhcp(llc.D_OFFER, dh.xid)
    }
    if dh.art == llc.D_REQUEST {
        bump(STAT_REQUEST)
        say((&fa_msg_req[0]) as u64)
        send_dhcp(llc.D_ACK, dh.xid)
        if fa_drop_arm != 0 {
            fa_drop_arm = 0
            fa_deaf = 1
            say((&fa_msg_drop[0]) as u64)
        }
    }
}

fn on_data(p: u64, n: u64) {
    if fa_deaf != 0 { return }
    let fc1: u64 = octets.ld8(p, 1)
    if (fc1 & 3) != 1 { return }
    if !iwl_fakeap_frames.same6(p, 4, bssid_addr(), 0) { return }
    if fa_state == ST_IDLE || fa_state == ST_AUTHED { return }
    if !iwl_fakeap_frames.same6(p, 10, sta_addr(), 0) { return }
    if (fc1 & 0x40) != 0 {
        if fa_state != ST_KEYED { return }
        let m: i64 = ccmp.unprotect(ptk_addr() + 32, p, n as usize, (&fa_plain[0]) as u64, 640)
        if m < 0 { return }
        bump(STAT_DATA)
        on_ip((&fa_plain[0]) as u64, m as u64)
        return
    }
    if n < 32 + 4 { return }
    if llc.snap_parse(p + 24, (n - 24) as usize) != llc.ET_EAPOL { return }
    on_eapol(p + 32, n - 32)
}

fn on_mgmt(p: u64, n: u64) {
    if !iwl_fakeap_frames.same6(p, 4, bssid_addr(), 0) { return }
    let sub: u64 = octets.ld8(p, 0) >> 4
    if sub == 11 {
        if n < 30 { return }
        if octets.ld16(p, 24) != 0 || octets.ld16(p, 26) != 1 { return }
        iwl_fakeap_frames.copy6(sta_addr(), 0, p, 10)
        let f: u64 = queue_begin()
        if f == 0 { return }
        queue_commit(iwl_fakeap_frames.auth_reply_build(f, sta_addr(), bssid_addr()))
        fa_state = ST_AUTHED
        fa_deaf = 0
        bump(STAT_AUTH)
        say((&fa_msg_auth[0]) as u64)
    }
    if sub == 0 {
        if fa_state != ST_AUTHED { return }
        if !iwl_fakeap_frames.same6(p, 10, sta_addr(), 0) { return }
        let f: u64 = queue_begin()
        if f == 0 { return }
        queue_commit(iwl_fakeap_frames.assoc_reply_build(f, sta_addr(), bssid_addr()))
        bump(STAT_ASSOC)
        say((&fa_msg_assoc[0]) as u64)
        send_m1()
    }
    if sub == 13 {
        if n < 33 || fa_state != ST_KEYED { return }
        if octets.ld8(p, 24) == 3 && octets.ld8(p, 25) == 1 && octets.ld8(p, 26) == 1 && octets.ld16(p, 27) == 37 {
            bump(STAT_ADDBA)
            say((&fa_msg_decl[0]) as u64)
        }
    }
    if sub == 12 || sub == 10 {
        fa_state = ST_IDLE
    }
}

fn on_tx(p: u64, n: u64) -> u64 {
    fa_resp_n = 0
    if n < 24 { return 0 }
    let typ: u64 = (octets.ld8(p, 0) >> 2) & 3
    if typ == 0 { on_mgmt(p, n) }
    if typ == 2 { on_data(p, n) }
    return fa_resp_n
}
