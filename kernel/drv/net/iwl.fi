// SPDX-License-Identifier: GPL-2.0-only
// kernel/drv/net/iwl.fi -- W-AX201 milestone M1b: kernel glue for lib/wlan/iwl_probe.fi.
//
// WHAT THIS DOES: walk the PCI table `pci.scan` built, pick every function
// that `iwl_probe.family_of` knows (AX201 = 8086:a0f0), map BAR0 and READ
// CSR_HW_REV / CSR_HW_RF_ID / CSR_GP_CNTRL / CSR_HW_IF_CONFIG. One serial
// line per device:
//
//     iwl: hw_rev=0x00000351 rf_id=0x0010a110 id=8086:a0f0 mac=QuZ rf=HR bdf=00:14.3
//
// and the same facts in /proc/wlan (procfs.fi) and the `wlan` section of
// /bin/sysinfo. Without a device the answer is "iwl: no device" and
// nothing is mapped (QEMU path).
//
// WHAT THIS NEVER DOES: write a device register (the Mmio write hook is an
// empty function, `Probe.writes` stays 0) and bring the chip up. The one
// write is on the PCI side: if the firmware left Memory Space decode OFF,
// the command register gets the MEM bit, otherwise BAR0 cannot be read.
// That is logged ("iwl: memory space was off").
//
// LW-3a (after the filesystem is mounted, `fw_stage`): for every target the firmware candidates of
// lib/wlan/iwl_fwsel.fi are looked up through the VFS (/lib/firmware/intel/iwlwifi/...), the first file that exists
// is read and parsed (lib/wlan/iwl_fw.fi); serial lines `iwl: fw file=<path> size=<n>` and
// `iwl: fw rc=<n> ver=<n> lmac=<n> umac=<n> paging=<n>`. Still no device write. Only with the kernel word `iwlboot`
// the sections are copied into DMA frames, the context-info page is built and `iwl_alive.boot_fw` runs
// (`iwl: boot rc=<n>`). Kernel word `iwlfwtest` runs the same lookup + parse for a synthetic AX201 (QEMU gate).
//
// HP-9b (family 8000 = 8260/8265/4165, no context-info block): with `iwlboot` the glue powers the chip up and pushes the
// runtime image through the FH service channel (lib/wlan/iwl_fh8000.fi `fh_load`: bounce buffer of 32 frames, bus address =
// physical address): lines `iwl: fh RC <n> FAILSEC <n>` and `iwl: fh STAT chunks=<n> bytes=<n> ext=<n> cpu1=<n> cpu2=<n>`, then
// the ALIVE wait (`iwl: boot rc=<n>`). QEMU has no such device: the word `iwlfhtest` runs the SAME loader for a synthetic 8265 against a
// fake CSR window in RAM (drv/net/iwl_fake.fi) and adds the model summary (LOADSTAT, CHICK, VIOL, LOST, NONZERO, DIGEST); `iwlfhlost`
// / `iwlfhbad` break the fake on purpose (tools/iwlfh/run.sh). Silicon behaviour (HP-9c) is NOT MEASURED.
//
// NOT MEASURED on real hardware yet: this file exists so that ONE boot of
// HOLO-LAPTOP-3 returns real numbers for M2/M3 (docs/WLAN-AX201.md).

profile kernel

import serial
import lib.kstate
import bus.pci
import arch.x86_64.apic
import wlan.iwl_probe
import wlan.iwl_rfkill
import wlan.iwl_fw
import wlan.iwl_fwsel
import wlan.iwl_ctxt
import wlan.iwl_alive
import wlan.iwl_rxscan
import wlan.iwl_pwr
import wlan.iwl_fh8000
import wlan.iwl_pin
import wlan.iwl_diag
import wlan.iwl_boot
import wlan.iwl_phydb
import crypto.sha256
import drv.net.iwl_fake
import drv.net.iwl_fakeap
import drv.net.iwl_cq
import drv.net.iwl_xport
import drv.net.iwl_heldcaps
import drv.net.iwl_pcipm
import drv.net.iwl_retry
import drv.net.iwl_irqpci
import wlan.iwl_irqdiag
import wlan.iwl_irqpoll
import wlan.iwl_rxexp_tab
import wlan.iwl_pollrec
import wlan.iwl_sbtrace
import drv.net.iwl_heldmac
import wlan.iwl_fwcaps
import wlan.iwl_cmdq
import mm.mem
import fs.vfs
import fs.vfsops

export {
    boot, fw_stage, fw_load, reload_reset, diag_text, diag_more_text, diag_irq_text, bed_gp_known, bed_gp, held_cq, held_probe, held_ready, diag_active, count_targets, target_at, probe_at, ERR_NODEV, ERR_MAP,
    E_FW_NONE, E_FW_PARSE, E_FW_MEM, E_FW_IMAGE, boot_rfkill
}

const E_FW_NONE: i64 = -40 // no candidate file exists
const E_FW_PARSE: i64 = -41 // iwl_fw.fw_parse refused the file
const E_FW_MEM: i64 = -42 // no DMA frames
const E_FW_IMAGE: i64 = -43 // image lacks an lmac or umac section, or ctxt_check failed
const FW_FRAMES: u64 = 768 // 3 MiB read buffer
const HELD_CQ_OFF: u64 = 512
const DEV_8265: u64 = 0x24FD
const XB_CMD: u64 = 4096
const XB_RX: u64 = 4096
const XB_NVM: u64 = 32768
const XB_POOL: u64 = 32768
const XB_RX_OFF: u64 = 4096
const XB_NVM_OFF: u64 = 8192
const XB_POOL_OFF: u64 = 8192 + 32768
const XB_PEND_OFF: u64 = 8192 + 65536
const XB_PAGES: u64 = 2 + 1 + 16 + 1
const XB_POLLS: u64 = 16
const INIT_COMPLETE_WAIT_MS: u64 = 4000
const TEST_REV: u64 = 0x351 // synthetic AX201 (word iwlfwtest)
const TEST_RF: u64 = 0x0010A110
const TEST_DEV: u64 = 0xA0F0 // synthetic AX201 PCI id

const CFG_COMMAND: u64 = 0x04
const CMD_MEM: u64 = 0x2

// Extra error codes next to iwl_probe.E_*.
const ERR_NODEV: i64 = -20 // index is not a target function
const ERR_MAP: i64 = -21 // apic.map_device found no window

static mut held_addr: u64 = 0
static mut boot_rk: u64 = 0

fn boot_rfkill() -> u64 { return boot_rk }

static mut diag_d: iwl_diag.Diag = iwl_diag.Diag {
    phase: 0, failed_at: 0, armed: 0, init_alive: 0, rt_alive: 0, err: 0, hw_rev: 0, rf_id: 0, fw_ver: 0, fw_size: 0,
    nvm_state: 0, nvm_bytes: 0, nvm_secs: 0, calib_n: 0, calib_bytes: 0, replayed: 0, cp_seen: 0, cp_bytes: 0, cp_max: 0, cp_drops: 0, cp_bad: 0, cp_rc: 0, cp_plen: 0, cp_type: 0, cp_dlen: 0, cp_skip: 0, cp_skip_type: 0, cp_skip_len: 0, cp_hex: [0 as u8; 32], last_cmd: 0, last_notif: 0,
    cmds: 0, notifs: 0, rx_head: 0, tx_head: 0, seen: 0, t: [0; 10], fw_name: [0 as u8; 64], fw_sha: [0 as u8; 32],
    step: 0, fail_step: 0, snapped: 0, regs: [0; 8], fh_sec: 0, fh_chunks: 0, fh_bytes: 0, fh_valid: 0, fh_dst: 0, fh_phys: 0, fh_cnt: 0, snapped2: 0, regs2: [0; 8], pci_valid: 0, pci_cmd: 0, pci_bar: 0, pci_size: 0, own_valid: 0, own_hwif: 0, own_mbox: 0, own_rc: 0, alive_valid: 0, alive: [0; 16], pm_valid: 0, pm: [0; 16], tr_valid: 0, tr: [0; 192], rx_valid: 0, rx: [0; 26], x2_valid: 0, x2: [0; 136], poll_valid: 0, poll: [0; 360], irq_valid: 0, irq: [0; 48], ipoll_valid: 0, ipoll: [0; 320], miss: [0 as u8; 64]
}

static mut snap_p: u64 = 0
static mut bed_gp_val: u64 = 0
static mut bed_gp_set: u64 = 0
static mut alive_seen: u64 = 0
static mut snap_bdf: u64 = 0
static mut snap_bar: u64 = 0
static mut snap_bar_size: u64 = 0

fn now_ms(state: u64) -> u64 {
    return kstate.get(state, kstate.TICKS) * 10
}

fn alive_now(ctx: u64) -> u64 {
    return now_ms(ctx)
}

fn alive_peek(ctx: u64) -> u64 {
    if ctx == 0 { return 0 }
    if iwl_cmdq.rx_pending(ctx as *mut iwl_cmdq.Cq) { return 1 }
    return 0
}

fn wait_alive(state: u64, p: *mut iwl_probe.Probe, cq: u64) -> i64 {
    var ac: iwl_alive.AliveCtx = iwl_alive.alive_new()
    iwl_alive.alive_hooks(&ac, alive_now, state, alive_peek, cq)
    var r: i64 = 0
    if kstate.mode_on(state, kstate.M_IWLOLDALIVE) {
        r = iwl_alive.alive_wait_poll(p, &ac)
    } else {
        r = iwl_alive.alive_wait_for(p, &ac)
    }
    alive_seen = ac.seen
    return r
}

fn diag_alive_snap(p: *mut iwl_probe.Probe, img_code: u64, secs1: u64, secs2: u64) {
    var ra: [u64; 16] = [0 as u64; 16]
    iwl_pwr.snap_alive(p, (&ra[0]) as u64)
    ra[7] = alive_seen
    ra[12] = img_code
    ra[13] = secs1
    ra[14] = secs2
    iwl_diag.diag_alive(&diag_d, (&ra[0]) as u64)
}

fn diag_more_text(buf: u64, cap: u64) -> u64 {
    return iwl_diag.diag_more(&diag_d, buf, cap)
}

fn diag_irq_text(buf: u64, cap: u64) -> u64 {
    return iwl_diag.diag_irq_text(&diag_d, buf, cap)
}

fn bed_gp_known() -> bool {
    return bed_gp_set != 0
}

fn bed_gp() -> u64 {
    return bed_gp_val
}

fn diag_active() -> bool {
    return diag_d.phase != iwl_diag.PH_IDLE
}

fn diag_text(buf: u64, cap: u64) -> u64 {
    return iwl_diag.diag_render(&diag_d, buf, cap)
}

fn diag_step(state: u64, ph: u64) {
    iwl_diag.diag_phase(&diag_d, ph, now_ms(state))
}

fn diag_take_snaps() {
    if snap_p != 0 {
        var rg: [u64; 8] = [0 as u64; 8]
        iwl_pwr.snap_regs(snap_p as *mut iwl_probe.Probe, (&rg[0]) as u64)
        iwl_diag.diag_snap(&diag_d, (&rg[0]) as u64)
        var rf: [u64; 8] = [0 as u64; 8]
        iwl_pwr.snap_fh(snap_p as *mut iwl_probe.Probe, (&rf[0]) as u64)
        iwl_diag.diag_snap2(&diag_d, (&rf[0]) as u64)
        iwl_diag.diag_own(&diag_d, (*(snap_p as *mut iwl_probe.Probe)).own_hwif, (*(snap_p as *mut iwl_probe.Probe)).own_mbox, (*(snap_p as *mut iwl_probe.Probe)).own_rc)
    }
    if snap_bdf != 0 {
        iwl_diag.diag_pci(&diag_d, pci.cfg_read16(snap_bdf, CFG_COMMAND), snap_bar, snap_bar_size)
    }
}

fn diag_bad(state: u64, code: i64) {
    if diag_d.phase == iwl_diag.PH_FAILED { return }
    if diag_d.snapped == 0 { diag_take_snaps() }
    iwl_diag.diag_fail(&diag_d, code, now_ms(state))
}

fn mark(st: u64) {
    iwl_diag.diag_mark(&diag_d, st)
}

fn rd(ctx: u64, off: u64) -> u64 {
    return __mmio_read32((ctx + off) as *mut u32) as u64
}

// The probe is read-only: this hook must never be reached.
fn wr(ctx: u64, off: u64, v: u64) { }

// The real write hook: ONLY installed by the opt-in boot (`iwlboot`), never by the read-only probe.
fn wr_real(ctx: u64, off: u64, v: u64) {
    __mmio_write32((ctx + off) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

// How many PCI functions in the table are Intel gen2 WLAN we know.
fn count_targets(state: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    let c: u64 = pci.count(state)
    while i < c {
        if iwl_probe.family_of(pci.get(state, i, pci.E_VENDOR), pci.get(state, i, pci.E_DEVICE)) != iwl_probe.FAM_NONE {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// PCI table index of the k-th target function, MAX_DEV when there is none.
fn target_at(state: u64, k: u64) -> u64 {
    var seen: u64 = 0
    var i: u64 = 0
    let c: u64 = pci.count(state)
    while i < c {
        if iwl_probe.family_of(pci.get(state, i, pci.E_VENDOR), pci.get(state, i, pci.E_DEVICE)) != iwl_probe.FAM_NONE {
            if seen == k {
                return i
            }
            seen = seen + 1
        }
        i = i + 1
    }
    return pci.MAX_DEV
}

// Probe PCI table entry `i`. 0 = ok (p filled), else an iwl_probe.E_* / ERR_* code.
fn probe_at(state: u64, i: u64, p: *mut iwl_probe.Probe, log: bool) -> i64 {
    var s_off: [u8; 26] = "iwl: memory space was off\0"
    let ven: u64 = pci.get(state, i, pci.E_VENDOR)
    let dev: u64 = pci.get(state, i, pci.E_DEVICE)
    if iwl_probe.family_of(ven, dev) == iwl_probe.FAM_NONE {
        return ERR_NODEV
    }
    let bdf: u64 = pci.get(state, i, pci.E_BDF)
    let phys: u64 = pci.bar(state, i, 0)
    let size: u64 = pci.bar_size(state, i, 0)
    let io: bool = pci.bar_is_io(state, i, 0)
    // Refuse before mapping anything: probe_run checks the same, but a
    // wrong BAR must not cost a mapping window.
    if phys == 0 || io || size < iwl_probe.CSR_MIN_BAR {
        let r0: i64 = iwl_probe.probe_run(p, ven, dev, 0, io)
        if r0 == 0 {
            return iwl_probe.E_BAR
        }
        return r0
    }
    let cmd: u64 = pci.cfg_read16(bdf, CFG_COMMAND)
    if (cmd & CMD_MEM) == 0 {
        pci.cfg_write16(bdf, CFG_COMMAND, (cmd | CMD_MEM) & 0xFFFF)
        if log {
            serial.puts((&s_off[0]) as u64)
            serial.nl()
        }
    }
    let base: u64 = apic.map_device(state, phys)
    if base == 0 {
        return ERR_MAP
    }
    iwl_probe.mmio_set(p, base, rd, wr)
    let prc: i64 = iwl_probe.probe_run(p, ven, dev, size, io)
    (*p).no_own = mode_flag(state, kstate.M_IWLNOOWN)
    return prc
}

fn put_bdf(bdf: u64) {
    pci.hexn(pci.bdf_bus(bdf), 2)
    serial.put(58 as u8)
    pci.hexn(pci.bdf_dev(bdf), 2)
    serial.put(46 as u8)
    pci.hexn(pci.bdf_fn(bdf), 1)
}

fn err_print(r: i64) {
    var e_dead: [u8; 5] = "dead\0"
    var e_bar: [u8; 4] = "bar\0"
    var e_map: [u8; 4] = "map\0"
    var e_ours: [u8; 12] = "unsupported\0"
    var e_oth: [u8; 6] = "other\0"
    if r == iwl_probe.E_DEAD {
        serial.puts((&e_dead[0]) as u64)
    } else if r == iwl_probe.E_BAR {
        serial.puts((&e_bar[0]) as u64)
    } else if r == ERR_MAP {
        serial.puts((&e_map[0]) as u64)
    } else if r == iwl_probe.E_UNSUPPORTED {
        serial.puts((&e_ours[0]) as u64)
    } else {
        serial.puts((&e_oth[0]) as u64)
    }
}

// Boot stage (after `pci.scan`): one serial line per target, or "no device".
fn boot(state: u64) {
    var s_none: [u8; 15] = "iwl: no device\0"
    var s_hw: [u8; 15] = "iwl: hw_rev=0x\0"
    var s_rf: [u8; 11] = " rf_id=0x\0\0"
    var s_id: [u8; 5] = " id=\0"
    var s_mac: [u8; 6] = " mac=\0"
    var s_rfn: [u8; 5] = " rf=\0"
    var s_bdf: [u8; 6] = " bdf=\0"
    var s_gp: [u8; 5] = " gp=\0"
    var s_ifc: [u8; 5] = " if=\0"
    var s_err: [u8; 11] = "iwl: err=\0\0"
    var s_at: [u8; 6] = " at \0\0"
    var name: [u8; 24] = [0 as u8; 24]
    let n: u64 = count_targets(state)
    if n == 0 {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return
    }
    var k: u64 = 0
    while k < n {
        let i: u64 = target_at(state, k)
        let bdf: u64 = pci.get(state, i, pci.E_BDF)
        var p: iwl_probe.Probe = iwl_probe.probe_new()
        let r: i64 = probe_at(state, i, &p, true)
        if r != 0 {
            serial.puts((&s_err[0]) as u64)
            err_print(r)
            serial.puts((&s_id[0]) as u64)
            pci.hexn(pci.get(state, i, pci.E_VENDOR), 4)
            serial.put(58 as u8)
            pci.hexn(pci.get(state, i, pci.E_DEVICE), 4)
            serial.puts((&s_at[0]) as u64)
            put_bdf(bdf)
            serial.nl()
        } else {
            iwl_diag.diag_hw(&diag_d, p.hw_rev, p.rf_id)
            diag_step(state, iwl_diag.PH_PCI)
            serial.puts((&s_hw[0]) as u64)
            pci.hexn(p.hw_rev, 8)
            serial.puts((&s_rf[0]) as u64)
            pci.hexn(p.rf_id, 8)
            serial.puts((&s_id[0]) as u64)
            pci.hexn(pci.get(state, i, pci.E_VENDOR), 4)
            serial.put(58 as u8)
            pci.hexn(pci.get(state, i, pci.E_DEVICE), 4)
            serial.puts((&s_mac[0]) as u64)
            let _a: usize = iwl_probe.rev_name_get(p.hw_rev, (&name[0]) as u64)
            serial.puts((&name[0]) as u64)
            serial.puts((&s_rfn[0]) as u64)
            let _b: usize = iwl_probe.rf_name_get(p.rf_id, (&name[0]) as u64)
            serial.puts((&name[0]) as u64)
            serial.puts((&s_bdf[0]) as u64)
            put_bdf(bdf)
            serial.puts((&s_gp[0]) as u64)
            pci.hexn(p.gp_cntrl, 8)
            serial.puts((&s_ifc[0]) as u64)
            pci.hexn(p.if_config, 8)
            serial.nl()
        }
        k = k + 1
    }
}

fn zero_run(a: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        let q: *mut u64 = (a + i) as *mut u64
        *q = 0
        i = i + 8
    }
}

fn copy_bytes(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        let d: *mut u8 = (dst + i) as *mut u8
        let t: *mut u8 = (src + i) as *mut u8
        *d = *t
        i = i + 1
    }
}

fn dma_pages(state: u64, n: u64) -> u64 {
    let a: u64 = mem.frame_run(state, n)
    if a == 0 {
        return 0
    }
    zero_run(a, n * 4096)
    return a
}

// Read the first candidate firmware file that exists into `buf` (capacity `cap`). Returns its size, 0 = none.
// `path` (>= 96 octets) holds the path of the file that was read.
fn fw_load(state: u64, dev: u64, rev: u64, rf: u64, buf: u64, cap: u64, path: u64) -> u64 {
    var s_miss: [u8; 17] = "iwl: fw missing \0"
    let n: u64 = iwl_fwsel.dev_count(dev, rev, rf)
    var i: u64 = 0
    while i < n {
        let _l: usize = iwl_fwsel.dev_path(dev, rev, rf, i, path)
        let m: u64 = vfs.mount_for(state, path)
        var found: u64 = 0
        if m < vfs.MAX_MNT {
            let node: u64 = vfs.node_for(state, m, path)
            if node != 0 {
                let size: u64 = vfs.v_attr(state, m, node, vfsops.A_SIZE)
                if size > 0 && size <= cap {
                    var off: u64 = 0
                    var stop: bool = false
                    while off < size && !stop {
                        var want: u64 = size - off
                        if want > 4096 {
                            want = 4096
                        }
                        let got: u64 = vfs.v_read(state, m, node, off, buf + off, want)
                        if got == 0 {
                            stop = true
                        } else {
                            off = off + got
                        }
                    }
                    if off == size {
                        found = size
                    }
                }
            }
        }
        if found != 0 {
            return found
        }
        serial.puts((&s_miss[0]) as u64)
        serial.puts(path)
        serial.nl()
        i = i + 1
    }
    return 0
}

// Log the SHA-256 of the firmware file and whether it is one of the pinned linux-firmware files (iwl_pin.fi).
// Only a log line: Intel's boot ROM checks the signature; the pin tells which exact file a measurement used.
fn fw_pin_line(buf: u64, size: u64) {
    var s_sha: [u8; 17] = "iwl: fw sha256=\0\0"
    var s_pin: [u8; 6] = " pin=\0"
    var s_none: [u8; 5] = "none\0"
    var s_sl: [u8; 2] = "/\0"
    var dg: [u8; 32] = [0 as u8; 32]
    var hx: [u8; 65] = [0 as u8; 65]
    sha256.hash(buf, size as usize, (&dg[0]) as u64)
    iwl_pin.hex_digest((&dg[0]) as u64, (&hx[0]) as u64)
    var di: usize = 0
    while di < 32 {
        diag_d.fw_sha[di] = dg[di]
        di = di + 1
    }
    serial.puts((&s_sha[0]) as u64)
    serial.puts((&hx[0]) as u64)
    serial.puts((&s_pin[0]) as u64)
    let api: u64 = iwl_pin.pin_api((&hx[0]) as u64)
    if api == 0 {
        serial.puts((&s_none[0]) as u64)
    } else {
        serial.dec(iwl_pin.pin_family((&hx[0]) as u64))
        serial.puts((&s_sl[0]) as u64)
        serial.dec(api)
    }
    serial.nl()
}

// Load + parse for one device identity; logs both lines. Returns 0 (f filled, blob in `buf`) or E_FW_*.
fn fw_prepare(state: u64, dev: u64, rev: u64, rf: u64, buf: u64, f: *mut iwl_fw.FwInfo) -> i64 {
    var s_file: [u8; 14] = "iwl: fw file=\0"
    var s_size: [u8; 7] = " size=\0"
    var s_rc: [u8; 12] = "iwl: fw rc=\0"
    var s_ver: [u8; 6] = " ver=\0"
    var s_l: [u8; 7] = " lmac=\0"
    var s_u: [u8; 7] = " umac=\0"
    var s_p: [u8; 9] = " paging=\0"
    var path: [u8; 96] = [0 as u8; 96]
    let size: u64 = fw_load(state, dev, rev, rf, buf, FW_FRAMES * 4096, (&path[0]) as u64)
    if size == 0 {
        return E_FW_NONE
    }
    serial.puts((&s_file[0]) as u64)
    serial.puts((&path[0]) as u64)
    serial.puts((&s_size[0]) as u64)
    serial.dec(size)
    serial.nl()
    fw_pin_line(buf, size)
    let rc: i64 = iwl_fw.fw_parse(buf, size as usize, f)
    serial.puts((&s_rc[0]) as u64)
    if rc < 0 {
        serial.put(45 as u8)
        serial.dec((0 - rc) as u64)
        serial.nl()
        return E_FW_PARSE
    }
    iwl_diag.diag_fw(&diag_d, (&path[0]) as u64, (*f).ver, size, (&diag_d.fw_sha[0]) as u64)
    serial.dec(rc as u64)
    serial.puts((&s_ver[0]) as u64)
    serial.dec((*f).ver)
    serial.puts((&s_l[0]) as u64)
    serial.dec(iwl_fw.fw_kind_count(f, iwl_fw.IMG_RT, iwl_fw.KIND_LMAC))
    serial.puts((&s_u[0]) as u64)
    serial.dec(iwl_fw.fw_kind_count(f, iwl_fw.IMG_RT, iwl_fw.KIND_UMAC))
    serial.puts((&s_p[0]) as u64)
    serial.dec(iwl_fw.fw_kind_count(f, iwl_fw.IMG_RT, iwl_fw.KIND_PAGING))
    serial.nl()
    return 0
}

// Opt-in (word `iwlboot`): copy the runtime image into DMA frames, build the context-info page, power the chip up,
// kick the firmware and wait for ALIVE. Writes device registers; NOT MEASURED on silicon.
fn fw_boot(state: u64, p: *mut iwl_probe.Probe, blob: u64, f: *mut iwl_fw.FwInfo) -> i64 {
    var bus: [u64; 32] = [0 as u64; 32]
    let n: usize = iwl_fw.fw_sec_count(f, iwl_fw.IMG_RT)
    if n == 0 || n > 32 {
        return E_FW_IMAGE
    }
    var i: usize = 0
    while i < n {
        let l: u64 = iwl_fw.fw_sec_len(f, iwl_fw.IMG_RT, i)
        let pages: u64 = (l + 4095) / 4096
        let a: u64 = dma_pages(state, pages)
        if a == 0 {
            return E_FW_MEM
        }
        copy_bytes(a, blob + iwl_fw.fw_sec_off(f, iwl_fw.IMG_RT, i), l)
        bus[i] = a
        i = i + 1
    }
    let page: u64 = dma_pages(state, 1)
    let rbf: u64 = dma_pages(state, 1)
    let rbu: u64 = dma_pages(state, 1)
    let st: u64 = dma_pages(state, 1)
    let tfd: u64 = dma_pages(state, 1)
    if page == 0 || rbf == 0 || rbu == 0 || st == 0 || tfd == 0 {
        return E_FW_MEM
    }
    iwl_ctxt.ctxt_init(page, (*p).hw_rev, 8)
    var r: i64 = iwl_ctxt.ctxt_set_rbd(page, rbf, rbu, st)
    if r != 0 {
        return r
    }
    r = iwl_ctxt.ctxt_set_hcmd(page, tfd, 5)
    if r != 0 {
        return r
    }
    r = iwl_ctxt.ctxt_fill_dram(page, f, iwl_fw.IMG_RT, (&bus[0]) as u64)
    if r != 0 {
        return r
    }
    if !iwl_ctxt.ctxt_check(page, (*p).hw_rev) {
        return E_FW_IMAGE
    }
    var ac: iwl_alive.AliveCtx = iwl_alive.alive_new()
    iwl_alive.alive_hooks(&ac, alive_now, state, alive_peek, 0)
    return iwl_alive.boot_fw(p, page, &ac)
}

const FH_BOUNCE_FRAMES: u64 = 32           // 128 KiB = FH_MEM_TB_MAX_LENGTH: fewest chunks
const FH_SRAM_FRAMES: u64 = 2048           // 8 MiB fake SRAM (8 windows of 1 MiB)
const FH_TEST_DEV: u64 = 0x24FD            // synthetic Intel Wireless-AC 8265

fn put_i(v: i64) {
    if v < 0 {
        serial.put(45 as u8)
        serial.dec((0 - v) as u64)
    } else {
        serial.dec(v as u64)
    }
}

// `iwl: fh RC <n> FAILSEC <n>` + `iwl: fh STAT ...` (the same text the host gate prints and the Python reference expects).
fn fh_report(r: i64, st: *mut iwl_fh8000.FhStat) {
    var s_rc: [u8; 13] = "iwl: fh RC \0\0"
    var s_fs: [u8; 11] = " FAILSEC \0\0"
    var s_st: [u8; 22] = "iwl: fh STAT chunks=\0\0"
    var s_by: [u8; 8] = " bytes=\0"
    var s_ex: [u8; 6] = " ext=\0"
    var s_c1: [u8; 7] = " cpu1=\0"
    var s_c2: [u8; 7] = " cpu2=\0"
    serial.puts((&s_rc[0]) as u64)
    put_i(r)
    serial.puts((&s_fs[0]) as u64)
    serial.dec((*st).fail_sec)
    serial.nl()
    serial.puts((&s_st[0]) as u64)
    serial.dec((*st).chunks)
    serial.puts((&s_by[0]) as u64)
    serial.dec((*st).bytes)
    serial.puts((&s_ex[0]) as u64)
    serial.dec((*st).ext_chunks)
    serial.puts((&s_c1[0]) as u64)
    serial.dec((*st).secs[0])
    serial.puts((&s_c2[0]) as u64)
    serial.dec((*st).secs[1])
    serial.nl()
}

// HP-9c.2: the REAL family-8000 sequence. INIT image -> ALIVE -> (NVM/calibration exchange, needs the command queue: HP-9c.1,
// not built yet) -> stop the device -> RT image -> ALIVE. Every step logs `iwl: boot2 <phase> ...`; every wait is bounded
// (iwl_pwr.POLL_MAX); on any failure interrupts are disabled and the rc is returned (caller falls back to "wlan: unavailable").
fn b2_line(tag: u64, r: i64) {
    var s_b2: [u8; 12] = "iwl: boot2 \0"
    var s_rc: [u8; 6] = " rc=\0\0"
    serial.puts((&s_b2[0]) as u64)
    serial.puts(tag)
    serial.puts((&s_rc[0]) as u64)
    put_i(r)
    serial.nl()
}

fn run_experiments(state: u64, p: *mut iwl_probe.Probe, f: *mut iwl_fw.FwInfo, blob: u64, img: usize, bounce: u64, bsize: u64,
                   cq: *mut iwl_cmdq.Cq, tr: *mut iwl_sbtrace.SbTrace, first_err: i64) -> i64 {
    diag_take_snaps()
    var xt: iwl_rxexp_tab.Tab = iwl_rxexp_tab.tab_new()
    var pl: iwl_pollrec.Poll = iwl_pollrec.poll_new()
    var ip: iwl_irqpoll.IPoll = iwl_irqpoll.ipoll_new()
    var irqw: [u64; 48] = [0 as u64; 48]
    iwl_irqdiag.take_csr(p, cq, (&irqw[0]) as u64)
    iwl_irqpci.take(snap_bdf, (&irqw[0]) as u64)
    iwl_diag.diag_irq(&diag_d, (&irqw[0]) as u64)
    let r: i64 = iwl_retry.run(state, p, f, blob, img, bounce, bsize, cq, tr, snap_bdf, first_err, &xt, &pl, &ip, wait_alive)
    iwl_diag.diag_poll(&diag_d, iwl_pollrec.poll_ptr(&pl))
    iwl_diag.diag_ipoll(&diag_d, iwl_irqpoll.ipoll_ptr(&ip))
    iwl_diag.diag_x2(&diag_d, iwl_rxexp_tab.tab_ptr(&xt))
    if iwl_rxexp_tab.tab_count(&xt) != 0 {
        var s_rx: [u8; 24] = "iwl: boot2 rxexp rows=\0\0"
        var s_al: [u8; 8] = " alive=\0"
        serial.puts((&s_rx[0]) as u64)
        serial.dec(iwl_rxexp_tab.tab_count(&xt))
        serial.puts((&s_al[0]) as u64)
        serial.dec(iwl_rxexp_tab.tab_last_alive(&xt))
        serial.nl()
    }
    var words: [u64; 192] = [0 as u64; 192]
    iwl_sbtrace.trace_copy(tr, (&words[0]) as u64)
    iwl_diag.diag_trace(&diag_d, (&words[0]) as u64)
    return r
}

#[allow_escape]
fn b2_phase(state: u64, lph: u64, aph: u64, p: *mut iwl_probe.Probe, f: *mut iwl_fw.FwInfo, blob: u64, img: usize, bounce: u64, bsize: u64, tl: u64, ta: u64, cq: *mut iwl_cmdq.Cq, scratch: u64) -> i64 {
    var s_by: [u8; 8] = " bytes=\0"
    var st: iwl_fh8000.FhStat = iwl_fh8000.fhstat_new()
    var tr: iwl_sbtrace.SbTrace = iwl_sbtrace.trace_new()
    let tracing: bool = !kstate.mode_on(state, kstate.M_IWLNOTRACE)
    if tracing {
        iwl_sbtrace.trace_on(&tr)
        iwl_sbtrace.trace_hooks(&tr, now_ms, state, alive_peek, cq as u64)
        st.tr = (&tr) as u64
    }
    diag_step(state, lph)
    if lph == iwl_diag.PH_FW_LOAD_INIT { mark(iwl_diag.ST_FH_INIT) } else { mark(iwl_diag.ST_FH_RT) }
    var r: i64 = iwl_fh8000.fh_load(p, f, blob, img, bounce, bounce, bsize, &st)
    var s_rc2: [u8; 4] = "rc=\0"
    serial.puts(tl)
    serial.puts((&s_rc2[0]) as u64)
    put_i(r)
    serial.puts((&s_by[0]) as u64)
    serial.dec(st.bytes)
    serial.nl()
    if r != 0 {
        iwl_diag.diag_fhfail(&diag_d, st.fail_sec, st.chunks, st.bytes, st.last_dst, st.last_phys, st.last_cnt)
        diag_bad(state, r)
        return r
    }
    if lph == iwl_diag.PH_FW_LOAD_INIT { mark(iwl_diag.ST_ALIVE_INIT) } else { mark(iwl_diag.ST_ALIVE_RT) }
    r = wait_alive(state, p, cq as u64)
    b2_line(ta, r)
    if r != 0 {
        var img_code: u64 = 2
        if lph == iwl_diag.PH_FW_LOAD_INIT { img_code = 1 }
        diag_alive_snap(p, img_code, st.secs[0], st.secs[1])
        var rxw: [u64; 26] = [0 as u64; 26]
        iwl_rxscan.scan(cq, p, (&rxw[0]) as u64)
        iwl_diag.diag_rx(&diag_d, (&rxw[0]) as u64)
        if iwl_rxscan.alive_in_rx((&rxw[0]) as u64) && !kstate.mode_on(state, kstate.M_IWLNORAW) {
            var s_rr: [u8; 24] = "iwl: boot2 rx-raw alive\0"
            iwl_cmdq.cq_set_raw(cq, 1)
            serial.puts((&s_rr[0]) as u64)
            serial.nl()
            r = 0
        }
        if tracing && r != 0 {
            var s_ex: [u8; 21] = "iwl: boot2 exp alive\0"
            r = run_experiments(state, p, f, blob, img, bounce, bsize, cq, &tr, r)
            if r == 0 {
                serial.puts((&s_ex[0]) as u64)
                serial.nl()
            }
        }
        if r != 0 { diag_bad(state, r) }
    }
    if r == 0 {
        diag_step(state, aph)
        let sa: i64 = iwl_cq.cq_stage_alive(state, cq, p, scratch)
        if sa != 0 {
            diag_bad(state, sa)
            r = sa
        }
    }
    return r
}

#[allow_escape]
fn fh8000_phases(state: u64, p: *mut iwl_probe.Probe, f: *mut iwl_fw.FwInfo, blob: u64, bounce_in: u64, cq: *mut iwl_cmdq.Cq) -> i64 {
    var t_il: [u8; 22] = "iwl: boot2 init load \0"
    var t_ia: [u8; 11] = "init alive\0"
    var t_rl: [u8; 21] = "iwl: boot2 rt load \0\0"
    var t_ra: [u8; 9] = "rt alive\0"
    var t_st: [u8; 10] = "init stop\0"
    var t_no: [u8; 11] = "no init fw\0"
    var t_pw: [u8; 6] = "power\0"
    var t_sm: [u8; 9] = "init nvm\0"
    var t_xe: [u8; 10] = "xport err\0"
    var bounce: u64 = bounce_in
    if bounce == 0 {
        bounce = dma_pages(state, FH_BOUNCE_FRAMES)
    }
    if bounce == 0 {
        b2_line((&t_pw[0]) as u64, E_FW_MEM)
        diag_step(state, iwl_diag.PH_FW_LOAD_INIT)
        diag_bad(state, E_FW_MEM)
        return E_FW_MEM
    }
    let bsize: u64 = FH_BOUNCE_FRAMES * 4096
    let scratch: u64 = dma_pages(state, 1)
    if iwl_fw.fw_sec_count(f, iwl_fw.IMG_INIT) == 0 {
        b2_line((&t_no[0]) as u64, E_FW_IMAGE)
        diag_step(state, iwl_diag.PH_FW_LOAD_INIT)
        diag_bad(state, E_FW_IMAGE)
        return E_FW_IMAGE
    }
    snap_p = p as u64
    mark(iwl_diag.ST_POWER_INIT)
    var r: i64 = iwl_pwr.power_up(p)
    if r != 0 {
        b2_line((&t_pw[0]) as u64, r)
        diag_step(state, iwl_diag.PH_FW_LOAD_INIT)
        diag_bad(state, r)
        iwl_pwr.int_disable(p)
        return r
    }
    let _sf1: i64 = iwl_pwr.start_fw(p)
    r = iwl_pwr.nic_config(p, (*f).phy_sku)
    if r != 0 {
        b2_line((&t_pw[0]) as u64, r)
        diag_step(state, iwl_diag.PH_FW_LOAD_INIT)
        diag_bad(state, r)
        iwl_pwr.int_disable(p)
        return r
    }
    let xb: u64 = dma_pages(state, XB_PAGES)
    if xb == 0 {
        b2_line((&t_pw[0]) as u64, E_FW_MEM)
        diag_step(state, iwl_diag.PH_FW_LOAD_INIT)
        diag_bad(state, E_FW_MEM)
        return E_FW_MEM
    }
    var bt: iwl_boot.Boot = iwl_boot.boot_new(xb, XB_CMD, xb + XB_RX_OFF, XB_RX, xb + XB_NVM_OFF, XB_NVM, xb + XB_POOL_OFF, XB_POOL)
    if kstate.mode_on(state, kstate.M_IWLOLDTYPE) { iwl_phydb.phydb_set_legacy(&bt.db, 1) }
    var xc: iwl_xport.XCtx = iwl_xport.xctx_new(state, cq as u64, p as u64, xb + XB_PEND_OFF)
    bt.x = iwl_xport.xport_make(&xc)
    bt.polls = XB_POLLS
    bt.wait_ms = INIT_COMPLETE_WAIT_MS
    bt.phy_cfg = (*f).phy_sku
    bt.ev_trig = iwl_fw.fw_calib_ev(f, iwl_fw.CALIB_INIT)
    bt.fl_trig = iwl_fw.fw_calib_fl(f, iwl_fw.CALIB_INIT)
    bt.rt_ev_trig = iwl_fw.fw_calib_ev(f, iwl_fw.CALIB_REGULAR)
    bt.rt_fl_trig = iwl_fw.fw_calib_fl(f, iwl_fw.CALIB_REGULAR)
    if iwl_fw.fw_tx_ant(f) != 0 { bt.tx_ant = iwl_fw.fw_tx_ant(f) }
    if iwl_fw.fw_cmd_ver(f, 0x6A) == 3 { bt.phy_ver = 3 }
    if kstate.mode_on(state, kstate.M_IWLOLDINIT) { bt.old_init = 1 }
    let _i1: i64 = iwl_cq.cq_stage_init(state, cq, p)
    r = b2_phase(state, iwl_diag.PH_FW_LOAD_INIT, iwl_diag.PH_INIT_ALIVE, p, f, blob, iwl_fw.IMG_INIT, bounce, bsize, (&t_il[0]) as u64, (&t_ia[0]) as u64, cq, scratch)
    if r != 0 {
        iwl_pwr.int_disable(p)
        return r
    }
    mark(iwl_diag.ST_NVM)
    r = iwl_boot.init_stage(&bt, &diag_d)
    iwl_diag.diag_calib_drops(&diag_d, iwl_cmdq.cq_drops(cq))
    if r == 0 { iwl_heldmac.store(&bt, quirk_bits(state)) }
    b2_line((&t_sm[0]) as u64, r)
    if r != 0 { b2_line((&t_xe[0]) as u64, xc.last_err) }
    if r != 0 {
        iwl_pwr.int_disable(p)
        return r
    }
    iwl_pwr.int_disable(p)
    mark(iwl_diag.ST_INIT_STOP)
    r = iwl_pwr.stop_master(p)
    iwl_pwr.sw_reset(p)
    b2_line((&t_st[0]) as u64, r)
    if r != 0 {
        return r
    }
    mark(iwl_diag.ST_POWER_RT)
    r = iwl_pwr.power_up(p)
    if r != 0 {
        b2_line((&t_pw[0]) as u64, r)
        diag_step(state, iwl_diag.PH_FW_LOAD_INIT)
        diag_bad(state, r)
        iwl_pwr.int_disable(p)
        return r
    }
    let _sf2: i64 = iwl_pwr.start_fw(p)
    r = iwl_pwr.nic_config(p, (*f).phy_sku)
    if r != 0 {
        b2_line((&t_pw[0]) as u64, r)
        diag_step(state, iwl_diag.PH_FW_LOAD_INIT)
        diag_bad(state, r)
        iwl_pwr.int_disable(p)
        return r
    }
    let _i2: i64 = iwl_cq.cq_stage_init(state, cq, p)
    r = b2_phase(state, iwl_diag.PH_FW_LOAD_RT, iwl_diag.PH_RT_ALIVE, p, f, blob, iwl_fw.IMG_RT, bounce, bsize, (&t_rl[0]) as u64, (&t_ra[0]) as u64, cq, scratch)
    if r != 0 {
        iwl_pwr.int_disable(p)
    } else {
        mark(iwl_diag.ST_RT_STAGE)
        r = iwl_boot.rt_stage(&bt, &diag_d)
    }
    return r
}

// HP-9b QEMU test bed: the REAL loader against the fake CSR window (word iwlfhtest).
fn fh8000_fake(state: u64, blob: u64, f: *mut iwl_fw.FwInfo) {
    var s_bad: [u8; 21] = "iwl: fh no memory\0\0\0\0"
    var s_pw: [u8; 18] = "iwl: fh power rc=\0"
    var s_ls: [u8; 18] = "iwl: fh LOADSTAT \0"
    var s_ch: [u8; 15] = "iwl: fh CHICK \0"
    var s_vi: [u8; 15] = "iwl: fh VIOL \0\0"
    var s_lo: [u8; 7] = " LOST \0"
    var s_nz: [u8; 10] = " NONZERO \0"
    var s_dg: [u8; 9] = " DIGEST \0"
    let region: u64 = dma_pages(state, iwl_fake.FAKE_PAGES)
    let sram: u64 = dma_pages(state, FH_SRAM_FRAMES)
    let bounce: u64 = dma_pages(state, FH_BOUNCE_FRAMES)
    if region == 0 || sram == 0 || bounce == 0 {
        serial.puts((&s_bad[0]) as u64)
        serial.nl()
        return
    }
    let bsize: u64 = FH_BOUNCE_FRAMES * 4096
    var mode: u64 = iwl_fake.FAKE_NORMAL
    var win: u64 = bounce
    if kstate.mode_on(state, kstate.M_IWLFHLOST) {
        mode = iwl_fake.FAKE_LOST
    }
    if kstate.mode_on(state, kstate.M_IWLFHBAD) {
        mode = iwl_fake.FAKE_BADWIN
        win = bounce + 4096
    }
    iwl_fake.fake_init(region, sram, mode, win, bsize)
    var p: iwl_probe.Probe = iwl_probe.probe_new()
    iwl_probe.mmio_set(&p, region, iwl_fake.fake_rd, iwl_fake.fake_wr)
    p.no_own = mode_flag(state, kstate.M_IWLNOOWN)
    let pw: i64 = iwl_pwr.power_up(&p)
    if pw != 0 {
        serial.puts((&s_pw[0]) as u64)
        put_i(pw)
        serial.nl()
        return
    }
    var st: iwl_fh8000.FhStat = iwl_fh8000.fhstat_new()
    let r: i64 = iwl_fh8000.fh_load(&p, f, blob, iwl_fw.IMG_RT, bounce, bounce, bsize, &st)
    fh_report(r, &st)
    serial.puts((&s_ls[0]) as u64)
    serial.hex(iwl_fake.fake_loadstat(region))
    serial.nl()
    serial.puts((&s_ch[0]) as u64)
    serial.hex(iwl_fake.fake_chick(region))
    serial.nl()
    var sum: [u64; 2] = [0 as u64; 2]
    iwl_fake.fake_sum(region, (&sum[0]) as *mut u64)
    serial.puts((&s_vi[0]) as u64)
    serial.dec(iwl_fake.fake_viol(region))
    serial.puts((&s_lo[0]) as u64)
    serial.dec(iwl_fake.fake_lost(region))
    serial.puts((&s_nz[0]) as u64)
    serial.dec(sum[0])
    serial.puts((&s_dg[0]) as u64)
    serial.hex(sum[1])
    serial.nl()
    fh8000_fake2(state, blob, f, mode, win)
}

// HP-9c.2 against a fresh fake: INIT -> ALIVE -> stop -> RT -> ALIVE (`iwl: boot2 ...` lines + model summary).
#[allow_escape]
fn fh8000_fake2(state: u64, blob: u64, f: *mut iwl_fw.FwInfo, mode: u64, win: u64) {
    var s_sum: [u8; 19] = "iwl: boot2 SUMMARY\0"
    var s_ph: [u8; 8] = " phase \0"
    var s_b0: [u8; 7] = " init \0"
    var s_b1: [u8; 5] = " rt \0"
    var s_vi: [u8; 6] = " viol\0"
    var s_sp: [u8; 7] = " stops\0"
    let region: u64 = dma_pages(state, iwl_fake.FAKE_PAGES)
    let sram: u64 = dma_pages(state, FH_SRAM_FRAMES)
    let bnc: u64 = dma_pages(state, FH_BOUNCE_FRAMES)
    if region == 0 || sram == 0 || bnc == 0 {
        return
    }
    var w2: u64 = bnc
    if mode == iwl_fake.FAKE_BADWIN {
        w2 = bnc + 4096
    }
    iwl_heldcaps.store(f, quirk_bits(state))
    iwl_fake.fake_init(region, sram, mode, w2, FH_BOUNCE_FRAMES * 4096)
    iwl_fake.fake_set_knobs(region, mode_flag(state, kstate.M_IWLFHNONVM), mode_flag(state, kstate.M_IWLFHNOINITC), mode_flag(state, kstate.M_IWLFHNOALIVE), mode_flag(state, kstate.M_IWLFHBADNVM))
    iwl_fakeap.set_drop(mode_flag(state, kstate.M_IWLFHDROP))
    iwl_fake.fake_set_slow(region, mode_flag(state, kstate.M_IWLFHSLOW))
    iwl_fake.fake_set_rxonly(region, mode_flag(state, kstate.M_IWLFHRXONLY) | mode_flag(state, kstate.M_IWLFHRXSILENT))
    iwl_fake.fake_set_silent(region, mode_flag(state, kstate.M_IWLFHRXSILENT))
    iwl_fake.fake_set_wake(region, mode_flag(state, kstate.M_IWLFHWAKE))
    iwl_fake.fake_set_dead(region, mode_flag(state, kstate.M_IWLFHDEAD))
    iwl_fake.fake_set_expwake(region, mode_flag(state, kstate.M_IWLFHEXPWAKE))
    iwl_fake.fake_set_rfkill(region, mode_flag(state, kstate.M_IWLFHRFKILL))
    iwl_fake.fake_set_bigcal(region, mode_flag(state, kstate.M_IWLFHBIGCAL))
    var p: iwl_probe.Probe = iwl_probe.probe_new()
    iwl_probe.mmio_set(&p, region, iwl_fake.fake_rd, iwl_fake.fake_wr)
    p.no_own = mode_flag(state, kstate.M_IWLNOOWN)
    bed_gp_val = iwl_pwr.rd(&p, iwl_probe.CSR_GP_CNTRL)
    bed_gp_set = 1
    var cq: iwl_cmdq.Cq = iwl_cmdq.cq_new()
    var cqp: *mut iwl_cmdq.Cq = &cq
    let bind: bool = kstate.mode_on(state, kstate.M_IWLFHBIND)
    var hold: u64 = 0
    if bind {
        hold = dma_pages(state, 1)
        if hold != 0 {
            cqp = (hold + HELD_CQ_OFF) as *mut iwl_cmdq.Cq
            *cqp = iwl_cmdq.cq_new()
        }
    }
    var pmf: [u64; 16] = [0 as u64; 16]
    iwl_pwr.snap_warm(&p, (&pmf[9]) as u64)
    iwl_diag.diag_pm(&diag_d, (&pmf[0]) as u64)
    let r: i64 = fh8000_phases(state, &p, f, blob, bnc, cqp)
    if r == 0 && (*cqp).tx_on != 0 && hold == 0 {
        iwl_cq.cq_selftest(state, cqp, &p, region)
    }
    if r == 0 && hold != 0 {
        iwl_fake.fake_set_ap(region, 1)
        let hp: *mut iwl_probe.Probe = hold as *mut iwl_probe.Probe
        *hp = p
        held_addr = hold
    }
    var s_fw: [u8; 19] = "iwl: boot2 FAKEFW \0"
    var s_nv: [u8; 5] = "nvm=\0"
    var s_pd: [u8; 8] = " phydb=\0"
    var s_ic: [u8; 8] = " initc=\0"
    serial.puts((&s_fw[0]) as u64)
    serial.puts((&s_nv[0]) as u64)
    serial.dec(iwl_fake.fake_nvm_reads(region))
    serial.puts((&s_pd[0]) as u64)
    serial.dec(iwl_fake.fake_phydb_cmds(region))
    serial.puts((&s_ic[0]) as u64)
    serial.dec(iwl_fake.fake_init_completes(region))
    serial.nl()
    var s_fp: [u8; 21] = "iwl: boot2 FAKEPD b=\0"
    var s_fb: [u8; 6] = " bad=\0"
    serial.puts((&s_fp[0]) as u64)
    serial.dec(iwl_fake.fake_phydb_bytes(region))
    serial.puts((&s_fb[0]) as u64)
    serial.dec(iwl_fake.fake_phydb_bad(region))
    serial.nl()
    serial.puts((&s_sum[0]) as u64)
    serial.puts((&s_ph[0]) as u64)
    serial.dec(iwl_fake.fake_phase(region))
    serial.puts((&s_b0[0]) as u64)
    serial.dec(iwl_fake.fake_phase_bytes(region, 0))
    serial.puts((&s_b1[0]) as u64)
    serial.dec(iwl_fake.fake_phase_bytes(region, 1))
    serial.puts((&s_vi[0]) as u64)
    serial.put(32 as u8)
    serial.dec(iwl_fake.fake_viol(region))
    serial.puts((&s_sp[0]) as u64)
    serial.put(32 as u8)
    serial.dec(iwl_fake.fake_stops(region))
    serial.nl()
}

// Real device (word iwlboot, family 8000): power up, push the runtime image through the FH channel, wait for ALIVE.
// Writes device registers; NOT MEASURED on silicon (HP-9c).
#[allow_escape]
fn fh8000_boot(state: u64, p: *mut iwl_probe.Probe, blob: u64, f: *mut iwl_fw.FwInfo) -> i64 {
    iwl_probe.mmio_set(p, (*p).ctx, rd, wr_real)
    let h: u64 = dma_pages(state, 1)
    if h == 0 { return E_FW_MEM }
    let cqp: *mut iwl_cmdq.Cq = (h + HELD_CQ_OFF) as *mut iwl_cmdq.Cq
    *cqp = iwl_cmdq.cq_new()
    let r: i64 = fh8000_phases(state, p, f, blob, 0, cqp)
    if r != 0 {
        diag_bad(state, r)
        iwl_pwr.int_disable(p)
        return r
    }
    let hp: *mut iwl_probe.Probe = h as *mut iwl_probe.Probe
    *hp = *p
    iwl_heldcaps.store(f, quirk_bits(state))
    held_addr = h
    return 0
}

fn quirk_bits(state: u64) -> u64 {
    var q: u64 = 0
    if kstate.mode_on(state, kstate.M_IWLOLDSCAN) { q = q | iwl_fwcaps.Q_OLD_SCAN }
    if kstate.mode_on(state, kstate.M_IWLOLDSLOT) { q = q | iwl_fwcaps.Q_OLD_SLOT }
    if kstate.mode_on(state, kstate.M_IWLOLDSSID) { q = q | iwl_fwcaps.Q_OLD_SSID }
    if kstate.mode_on(state, kstate.M_IWLOLDMAC) { q = q | iwl_fwcaps.Q_OLD_MAC }
    if kstate.mode_on(state, kstate.M_IWLOLDTXQ) { q = q | iwl_fwcaps.Q_OLD_TXQ }
    if kstate.mode_on(state, kstate.M_IWLOLDLOSS) { q = q | iwl_fwcaps.Q_OLD_LOSS }
    if kstate.mode_on(state, kstate.M_IWLOLDPHY) { q = q | iwl_fwcaps.Q_OLD_PHY }
    return q
}

fn mode_flag(state: u64, m: u64) -> u64 {
    if kstate.mode_on(state, m) { return 1 }
    return 0
}

fn wants_boot(state: u64, p: *mut iwl_probe.Probe) -> bool {
    if kstate.mode_on(state, kstate.M_NOIWL) { return false }
    if kstate.mode_on(state, kstate.M_IWLBOOT) { return true }
    if kstate.mode_on(state, kstate.M_SAFE) { return false }
    return (*p).dev == DEV_8265 && !iwl_probe.has_ctxinfo((*p).fam)
}

fn held_cq() -> *mut iwl_cmdq.Cq {
    return (held_addr + HELD_CQ_OFF) as *mut iwl_cmdq.Cq
}

fn held_probe() -> *mut iwl_probe.Probe {
    return held_addr as *mut iwl_probe.Probe
}

fn held_ready() -> bool {
    return held_addr != 0
}

// After the filesystem is mounted: firmware lookup for every target (read-only), or for a synthetic AX201 with the
// word `iwlfwtest`, and the opt-in boot with the word `iwlboot`.
fn fw_stage(state: u64) {
    fw_stage_run(state)
    snap_p = 0
    snap_bdf = 0
}

#[allow_escape]
fn fw_stage_run(state: u64) {
    var s_none: [u8; 17] = "iwl: fw no file\0\0"
    var s_boot: [u8; 14] = "iwl: boot rc=\0"
    var s_test: [u8; 15] = "iwl: fw test\0\0\0"
    var s_bad: [u8; 21] = "iwl: fw load failed\0\0"
    let test: bool = kstate.mode_on(state, kstate.M_IWLFWTEST)
    let fht: bool = kstate.mode_on(state, kstate.M_IWLFHTEST)
    let n: u64 = count_targets(state)
    if n == 0 && !test && !fht {
        return
    }
    let buf: u64 = dma_pages(state, FW_FRAMES)
    if buf == 0 {
        serial.puts((&s_bad[0]) as u64)
        serial.nl()
        return
    }
    var f: iwl_fw.FwInfo = iwl_fw.fwinfo_new()
    if fht {
        let rh: i64 = fw_prepare(state, FH_TEST_DEV, 0, 0, buf, &f)
        if rh == E_FW_NONE {
            serial.puts((&s_none[0]) as u64)
            serial.nl()
        } else if rh == 0 {
            fh8000_fake(state, buf, &f)
        }
        return
    }
    if test {
        serial.puts((&s_test[0]) as u64)
        serial.nl()
        let rt: i64 = fw_prepare(state, TEST_DEV, TEST_REV, TEST_RF, buf, &f)
        if rt == E_FW_NONE {
            serial.puts((&s_none[0]) as u64)
            serial.nl()
        }
        return
    }
    var k: u64 = 0
    while k < n {
        let i: u64 = target_at(state, k)
        var p: iwl_probe.Probe = iwl_probe.probe_new()
        let r: i64 = probe_at(state, i, &p, false)
        if r == 0 {
            snap_p = (&p) as u64
            boot_rk = 0
            if iwl_rfkill.hw_set(p.gp_cntrl) { boot_rk = 1 }
            mark(iwl_diag.ST_FW_FILE)
            let rf: i64 = fw_prepare(state, p.dev, p.hw_rev, p.rf_id, buf, &f)
            let boot_on: bool = wants_boot(state, &p)
            iwl_diag.diag_armed(&diag_d, boot_on)
            if rf == E_FW_NONE {
                var mn: [u8; 64] = [0 as u8; 64]
                let _mn: usize = iwl_fwsel.dev_name(p.dev, p.hw_rev, p.rf_id, 0, (&mn[0]) as u64)
                iwl_diag.diag_fwmiss(&diag_d, (&mn[0]) as u64)
            }
            if rf == E_FW_PARSE { mark(iwl_diag.ST_FW_PARSE) }
            if rf != 0 && boot_on {
                diag_step(state, iwl_diag.PH_FW_LOAD_INIT)
                diag_bad(state, rf)
            }
            if rf == 0 && boot_on {
                let dbdf: u64 = pci.get(state, i, pci.E_BDF)
                pci.enable_master(dbdf)
                var pmv: [u64; 16] = [0 as u64; 16]
                let woke: bool = iwl_pcipm.settle(dbdf, (&pmv[0]) as *mut u64)
                if woke {
                    let t0: u64 = now_ms(state)
                    var spin: u64 = 0
                    while now_ms(state) < t0 + 12 && spin < 20000000 { spin = spin + 1 }
                }
                iwl_pwr.snap_warm(&p, (&pmv[9]) as u64)
                iwl_diag.diag_pm(&diag_d, (&pmv[0]) as u64)
                snap_bdf = dbdf
                snap_bar = pci.bar(state, i, 0)
                snap_bar_size = pci.bar_size(state, i, 0)
                iwl_diag.diag_pci(&diag_d, pci.cfg_read16(dbdf, CFG_COMMAND), snap_bar, snap_bar_size)
            }
            if rf == E_FW_NONE {
                serial.puts((&s_none[0]) as u64)
                serial.nl()
            } else if rf == 0 && boot_on && !iwl_probe.has_ctxinfo(p.fam) {
                let b8: i64 = fh8000_boot(state, &p, buf, &f)
                serial.puts((&s_boot[0]) as u64)
                put_i(b8)
                serial.nl()
            } else if rf == 0 && boot_on {
                iwl_probe.mmio_set(&p, p.ctx, rd, wr_real)
                let br: i64 = fw_boot(state, &p, buf, &f)
                serial.puts((&s_boot[0]) as u64)
                if br < 0 {
                    serial.put(45 as u8)
                    serial.dec((0 - br) as u64)
                } else {
                    serial.dec(br as u64)
                }
                serial.nl()
            }
        }
        k = k + 1
    }
}

fn reload_reset() {
    diag_d = iwl_diag.diag_new()
    alive_seen = 0
    snap_p = 0
    snap_bdf = 0
}
