profile kernel

import serial
import libc.octets

export { command, dma_bad }

const TRACE_WORDS: u64 = 4

fn command(cmd: u64, tb0: u64, total: u64) {
    var tag: [u8; 13] = "fakefw: cmd=\0"
    var len_tag: [u8; 6] = " len=\0"
    var sep: [u8; 2] = " \0"
    serial.puts((&tag[0]) as u64)
    serial.hex(cmd)
    serial.puts((&len_tag[0]) as u64)
    serial.hex(total)
    var i: u64 = 0
    while i < TRACE_WORDS {
        serial.puts((&sep[0]) as u64)
        serial.hex(octets.ld32(tb0, i * 4))
        i = i + 1
    }
    serial.nl()
}

fn dma_bad(flags: u64, src: u64, dst: u64, cnt: u64, chick: u64) {
    var tag: [u8; 15] = "fakefw: dma x \0"
    var sep: [u8; 2] = " \0"
    serial.puts((&tag[0]) as u64)
    serial.hex(flags)
    serial.puts((&sep[0]) as u64)
    serial.hex(src)
    serial.puts((&sep[0]) as u64)
    serial.hex(dst)
    serial.puts((&sep[0]) as u64)
    serial.hex(cnt)
    serial.puts((&sep[0]) as u64)
    serial.hex(chick)
    serial.nl()
}
