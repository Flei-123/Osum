profile kernel

import libc.octets

export {
    S_ACCESS, S_QTAB, CMD_ADD_STA, CMD_NVM_ACCESS, CMD_TIME_EVENT, CMD_TX, FAKE_ERR_PTR, FAKE_UMAC_PTR, REG_CBBC_Q0, REG_RBD_BASE, REG_RBD_WPTR, REG_RX_CONFIG, REG_STTS, SEQ_RX_FRAME, S_AP, S_BADNVM, S_BIGCAL, S_BTCFG, S_CLOSED, S_CMDS, S_COMPAT, S_DROPS, S_INITC, S_IRQRX, S_LASTCMD, S_LASTUID, S_NOALIVE, S_NOINITC, S_NONVM, S_NORX, S_NVMRD, S_PHASE, S_PHYBAD, S_PHYBYTES, S_PHYDB, S_PKTS, S_RTANT, S_RTSF, S_SILENT, S_TXBAD, S_TXLAG, S_TXOK, S_TXRD, ap_on, compat, viol
}

const S_COMPAT: u64 = 0x2558
const FAKE_ERR_PTR: u64 = 0x00800200
const FAKE_UMAC_PTR: u64 = 0x00800300
const S_RTSF: u64 = 0x2520
const S_RTANT: u64 = 0x2528
const S_BTCFG: u64 = 0x2530
const S_ACCESS: u64 = 0x2000
const S_QTAB: u64 = 0x2600
const S_VIOL: u64 = 0x2018
const S_TXRD: u64 = 0x2400
const S_CLOSED: u64 = 0x2408
const S_CMDS: u64 = 0x2410
const S_DROPS: u64 = 0x2418
const S_NORX: u64 = 0x2420
const S_PKTS: u64 = 0x2428
const S_LASTCMD: u64 = 0x2430
const S_LASTUID: u64 = 0x2438
const S_PENDING: u64 = 0x2440
const S_NONVM: u64 = 0x2448
const S_NOINITC: u64 = 0x2450
const S_NOALIVE: u64 = 0x2458
const S_BADNVM: u64 = 0x2460
const S_PHASE: u64 = 0x2468
const S_PHYDB: u64 = 0x2470
const S_NVMRD: u64 = 0x2478
const S_INITC: u64 = 0x2480
const S_AP: u64 = 0x2488
const S_TXOK: u64 = 0x24A8
const S_TXBAD: u64 = 0x24B0
const S_SILENT: u64 = 0x24F0
const S_TXLAG: u64 = 0x2550
const S_IRQRX: u64 = 0x2538
const S_BIGCAL: u64 = 0x2508
const S_PHYBYTES: u64 = 0x2510
const S_PHYBAD: u64 = 0x2518
const CMD_TX: u64 = 0x1C
const CMD_ADD_STA: u64 = 0x18
const CMD_TIME_EVENT: u64 = 0x29
const CMD_NVM_ACCESS: u64 = 0x88
const REG_RBD_BASE: u64 = 0x1BC4
const REG_STTS: u64 = 0x1BC0
const REG_RBD_WPTR: u64 = 0x1BC8
const REG_RX_CONFIG: u64 = 0x1C00
const REG_CBBC_Q0: u64 = 0x19D0
const REG_CSR_INT: u64 = 0x008
const SEQ_RX_FRAME: u64 = 0x8000
fn viol(ctx: u64) { octets.st64(ctx, S_VIOL, octets.ld64(ctx, S_VIOL) + 1) }
fn ap_on(ctx: u64) -> bool { return octets.ld64(ctx, S_AP) != 0 }
fn compat(ctx: u64) -> bool { return octets.ld64(ctx, S_COMPAT) != 0 }
