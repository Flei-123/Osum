profile kernel

import lib.ksym
import drv.net.wlanbed
import drv.net.testbed.bedfh
import drv.net.testbed.drvfakemmio
import drv.net.testbed.lkwifi_hw

export { wire }

fn wire() {
    wlanbed.bind_slot(wlanbed.SLOT_FH_TEST, ksym.addr_3u(bedfh.run))
    wlanbed.bind_slot(wlanbed.SLOT_MMIO_REGION, ksym.addr_1u(drvfakemmio.region))
    wlanbed.bind_slot(wlanbed.SLOT_MMIO_RD, ksym.addr_1u(drvfakemmio.rd))
    wlanbed.bind_slot(wlanbed.SLOT_MMIO_WR, ksym.addr_2u(drvfakemmio.wr))
    wlanbed.bind_slot(wlanbed.SLOT_WIFI_HW, ksym.addr_4u(lkwifi_hw.call))
}
