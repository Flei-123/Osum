profile kernel

import drv.net.wlanbed
import drv.net.testbed.bedfh
import drv.net.testbed.drvfakemmio
import drv.net.testbed.lkwifi_hw

export { wire }

fn wire() {
    wlanbed.bind_slot(wlanbed.SLOT_FH_TEST, bedfh.run as u64)
    wlanbed.bind_slot(wlanbed.SLOT_MMIO_REGION, drvfakemmio.region as u64)
    wlanbed.bind_slot(wlanbed.SLOT_MMIO_RD, drvfakemmio.rd as u64)
    wlanbed.bind_slot(wlanbed.SLOT_MMIO_WR, drvfakemmio.wr as u64)
    wlanbed.bind_slot(wlanbed.SLOT_WIFI_HW, lkwifi_hw.call as u64)
}
