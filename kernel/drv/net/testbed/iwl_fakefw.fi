profile kernel

import drv.net.testbed.iwl_fakeap
import libc.octets
import drv.net.testbed.iwl_fakeq
import drv.net.testbed.iwl_fakest

export {
    cmds, init_completes, last_cmd, last_uid, nvm_reads, phydb_bad, phydb_bytes, phydb_cmds, reset, rx_drops, rx_pkts, set_ap, set_bigcal, set_compat, set_irq_rx, set_knobs, set_norx, set_silent, set_txlag, tx_bad, tx_ok
}

fn cmds(ctx: u64) -> u64 { return octets.ld64(ctx, iwl_fakest.S_CMDS) }
fn rx_pkts(ctx: u64) -> u64 { return octets.ld64(ctx, iwl_fakest.S_PKTS) }
fn rx_drops(ctx: u64) -> u64 { return octets.ld64(ctx, iwl_fakest.S_DROPS) }
fn tx_ok(ctx: u64) -> u64 { return octets.ld64(ctx, iwl_fakest.S_TXOK) }
fn tx_bad(ctx: u64) -> u64 { return octets.ld64(ctx, iwl_fakest.S_TXBAD) }
fn last_cmd(ctx: u64) -> u64 { return octets.ld64(ctx, iwl_fakest.S_LASTCMD) }
fn last_uid(ctx: u64) -> u64 { return octets.ld64(ctx, iwl_fakest.S_LASTUID) }
fn set_norx(ctx: u64, on: u64) { octets.st64(ctx, iwl_fakest.S_NORX, on) }
fn set_bigcal(ctx: u64, on: u64) { octets.st64(ctx, iwl_fakest.S_BIGCAL, on) }
fn set_silent(ctx: u64, on: u64) { octets.st64(ctx, iwl_fakest.S_SILENT, on) }
fn set_txlag(ctx: u64, on: u64) { octets.st64(ctx, iwl_fakest.S_TXLAG, on) }
fn set_knobs(ctx: u64, nonvm: u64, noinitc: u64, noalive: u64, badnvm: u64) {
    octets.st64(ctx, iwl_fakest.S_NONVM, nonvm)
    octets.st64(ctx, iwl_fakest.S_NOINITC, noinitc)
    octets.st64(ctx, iwl_fakest.S_NOALIVE, noalive)
    octets.st64(ctx, iwl_fakest.S_BADNVM, badnvm)
}
fn set_ap(ctx: u64, on: u64) {
    octets.st64(ctx, iwl_fakest.S_AP, on)
    if on != 0 { iwl_fakeap.reset() }
}
fn set_irq_rx(ctx: u64, on: u64) { octets.st64(ctx, iwl_fakest.S_IRQRX, on) }
fn set_compat(ctx: u64, on: u64) { octets.st64(ctx, iwl_fakest.S_COMPAT, on) }
fn phydb_cmds(ctx: u64) -> u64 { return octets.ld64(ctx, iwl_fakest.S_PHYDB) }
fn phydb_bytes(ctx: u64) -> u64 { return octets.ld64(ctx, iwl_fakest.S_PHYBYTES) }
fn phydb_bad(ctx: u64) -> u64 { return octets.ld64(ctx, iwl_fakest.S_PHYBAD) }
fn nvm_reads(ctx: u64) -> u64 { return octets.ld64(ctx, iwl_fakest.S_NVMRD) }
fn init_completes(ctx: u64) -> u64 { return octets.ld64(ctx, iwl_fakest.S_INITC) }
fn reset(ctx: u64) {
    octets.st64(ctx, iwl_fakest.S_TXRD, 0)
    octets.st64(ctx, iwl_fakest.S_CLOSED, 0)
    iwl_fakeq.reset_queues(ctx)
    octets.st32(ctx, iwl_fakest.REG_STTS, 0)
    octets.st32(ctx, iwl_fakest.REG_RBD_BASE, 0)
    octets.st32(ctx, iwl_fakest.REG_RBD_WPTR, 0)
    octets.st32(ctx, iwl_fakest.REG_RX_CONFIG, 0)
    octets.st32(ctx, iwl_fakest.REG_CBBC_Q0, 0)
}
