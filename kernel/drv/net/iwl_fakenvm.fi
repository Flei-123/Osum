profile kernel

export { total, byte }

const SEC_SW: u64 = 1
const SEC_REGULATORY: u64 = 3
const SEC_HW: u64 = 10
const SEC_MAC_OVERRIDE: u64 = 11
const SEC_PHY_SKU: u64 = 12

const SW_LEN: u64 = 16
const REGULATORY_LEN: u64 = 2576
const HW_LEN: u64 = 32
const MAC_OVERRIDE_LEN: u64 = 8
const PHY_SKU_LEN: u64 = 8

const NVM_VERSION_LO: u64 = 0x3B
const NVM_VERSION_HI: u64 = 0x0E
const N_HW_ADDRS_AT: u64 = 6
const N_HW_ADDRS: u64 = 2
const RADIO_CFG_TOP: u64 = 0x33
const SKU_AT: u64 = 4
const SKU_BANDS_11N: u64 = 7

const EXT_CHANNELS: u64 = 51
const CH_2GHZ: u64 = 14
const FLAGS_ACTIVE: u64 = 0x10B
const FLAGS_RADAR: u64 = 0x111

fn total(sec: u64) -> u64 {
    if sec == SEC_SW { return SW_LEN }
    if sec == SEC_REGULATORY { return REGULATORY_LEN }
    if sec == SEC_HW { return HW_LEN }
    if sec == SEC_MAC_OVERRIDE { return MAC_OVERRIDE_LEN }
    if sec == SEC_PHY_SKU { return PHY_SKU_LEN }
    return 0
}

fn channel_number(k: u64) -> u64 {
    if k < CH_2GHZ { return k + 1 }
    if k < 22 { return 36 + 4 * (k - 14) }
    if k < 29 { return 68 + 4 * (k - 22) }
    if k < 42 { return 96 + 4 * (k - 29) }
    return 149 + 4 * (k - 42)
}

fn channel_flags(ch: u64) -> u64 {
    if ch <= 13 { return FLAGS_ACTIVE }
    if ch == 14 { return 0 }
    if ch >= 36 && ch <= 48 { return FLAGS_ACTIVE }
    if ch >= 52 && ch <= 64 { return FLAGS_RADAR }
    if ch >= 100 && ch <= 144 { return FLAGS_RADAR }
    if ch >= 149 && ch <= 165 { return FLAGS_ACTIVE }
    return 0
}

fn regulatory_byte(i: u64) -> u64 {
    let word: u64 = i / 2
    if word >= EXT_CHANNELS { return 0 }
    let flags: u64 = channel_flags(channel_number(word))
    if (i & 1) == 0 { return flags & 0xFF }
    return flags >> 8
}

fn sw_byte(i: u64) -> u64 {
    if i == 0 { return NVM_VERSION_LO }
    if i == 1 { return NVM_VERSION_HI }
    if i == N_HW_ADDRS_AT { return N_HW_ADDRS }
    return 0
}

fn mac_override_byte(i: u64) -> u64 {
    var m: [u8; 8] = [0, 0, 0x06, 0x11, 0x22, 0x33, 0x44, 0x55]
    return m[(i & 7) as usize] as u64
}

fn phy_sku_byte(i: u64) -> u64 {
    if i == 3 { return RADIO_CFG_TOP }
    if i == SKU_AT { return SKU_BANDS_11N }
    return 0
}

fn byte(sec: u64, i: u64) -> u64 {
    if sec == SEC_SW { return sw_byte(i) }
    if sec == SEC_REGULATORY { return regulatory_byte(i) }
    if sec == SEC_HW { return (i + 1) & 0xFF }
    if sec == SEC_MAC_OVERRIDE { return mac_override_byte(i) }
    if sec == SEC_PHY_SKU { return phy_sku_byte(i) }
    return 0
}
