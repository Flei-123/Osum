profile kernel

import drv.net.virtio
import drv.net.netclass

export { ops }

fn irq_mode(state: u64, u: u64) -> u64 {
    if virtio.msix_on(state, u) {
        return 3
    }
    return 1
}

fn ops() -> netclass.EthOps {
    var o: netclass.EthOps = netclass.null_ops()
    o.present = virtio.present_on
    o.ready = virtio.ready_on
    o.up = virtio.up_on
    o.init = virtio.init_on
    o.bdf = virtio.bdf_on
    o.idx = virtio.idx_on
    o.irqs = virtio.irqs_on
    o.rx_frames = virtio.rx_frames_on
    o.tx_frames = virtio.tx_frames_on
    o.tx_drops = virtio.tx_drops_on
    o.rx_octets = virtio.rx_octets_on
    o.tx_octets = virtio.tx_octets_on
    o.features = virtio.features_on
    o.queue_size = virtio.queue_size_on
    o.notified = virtio.notified_on
    o.link_speed = virtio.link_speed_on
    o.tx_room = virtio.tx_room_on
    o.msix = virtio.msix_on
    o.link_up = virtio.link_up_on
    o.mac_at = virtio.mac_at_on
    o.rx_take = virtio.rx_take_on
    o.rx_recycle = virtio.rx_recycle_on
    o.tx_frame = virtio.tx_frame_on
    o.poll = virtio.poll_on
    o.irq = virtio.irq_on
    o.shut_down = virtio.shut_down_on
    o.irq_mode = irq_mode
    o.caps = netclass.CAP_MSIX | netclass.CAP_SPEED
    o.tag = 0x6f6974726976
    return o
}
