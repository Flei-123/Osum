profile kernel

import libc.octets
import drv.net.iwl_fakest

export {
    err_fill, err_word
}

const FAKE_ERR_ID: u64 = 0x71
const FAKE_UMAC_ID: u64 = 0x7A
const UMAC_DWORDS: u64 = 16
const S_ERRTAB: u64 = 0x2820
const S_UERRTAB: u64 = 0x2870
const ERR_DWORDS: u64 = 24
fn err_slot(d: u64) -> u64 {
    if d == 0 { return 0 }
    if d == 1 { return 1 }
    if d == 4 { return 2 }
    if d == 5 { return 3 }
    if d == 7 { return 4 }
    if d == 8 { return 5 }
    if d == 23 { return 6 }
    return 7
}
fn umac_slot(d: u64) -> u64 {
    if d == 0 { return 0 }
    if d == 1 { return 1 }
    if d == 3 { return 2 }
    if d == 4 { return 3 }
    if d == 6 { return 4 }
    if d == 7 { return 5 }
    if d == 13 { return 6 }
    return 7
}
fn err_word(ctx: u64, raddr: u64) -> u64 {
    if raddr >= iwl_fakest.FAKE_UMAC_PTR && raddr < iwl_fakest.FAKE_UMAC_PTR + UMAC_DWORDS * 4 {
        let u: u64 = umac_slot((raddr - iwl_fakest.FAKE_UMAC_PTR) / 4)
        if u == 7 { return 0 }
        return octets.ld64(ctx, S_UERRTAB + u * 8)
    }
    if raddr < iwl_fakest.FAKE_ERR_PTR || raddr >= iwl_fakest.FAKE_ERR_PTR + ERR_DWORDS * 4 { return 0 }
    let k: u64 = err_slot((raddr - iwl_fakest.FAKE_ERR_PTR) / 4)
    if k == 7 { return 0 }
    return octets.ld64(ctx, S_ERRTAB + k * 8)
}
fn err_fill(ctx: u64, tb0: u64, len: u64) {
    octets.st64(ctx, S_ERRTAB, 1)
    octets.st64(ctx, S_ERRTAB + 8, FAKE_ERR_ID)
    octets.st64(ctx, S_ERRTAB + 16, 0xB10C0002)
    octets.st64(ctx, S_ERRTAB + 24, 0x11C00001)
    octets.st64(ctx, S_ERRTAB + 32, octets.ld8(tb0, 0))
    octets.st64(ctx, S_ERRTAB + 40, len)
    octets.st64(ctx, S_ERRTAB + 48, octets.ld32(tb0, 0))
    octets.st64(ctx, S_UERRTAB, 1)
    octets.st64(ctx, S_UERRTAB + 8, FAKE_UMAC_ID)
    octets.st64(ctx, S_UERRTAB + 16, 0xB10C0003)
    octets.st64(ctx, S_UERRTAB + 24, 0x11C00002)
    octets.st64(ctx, S_UERRTAB + 32, octets.ld8(tb0, 0))
    octets.st64(ctx, S_UERRTAB + 40, len)
    octets.st64(ctx, S_UERRTAB + 48, octets.ld32(tb0, 0))
}
