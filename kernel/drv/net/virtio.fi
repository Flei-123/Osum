
import lib.kstate
import mm.mmframe
import bus.pci
import acpi.aml
import arch.x86_64.apic
import arch.arch
import libc.regio

export {
    init, present, ready, up, mac_at, bdf, idx,
    rx_take, rx_recycle, tx_frame, tx_room, poll,
    irq, irqs, rx_frames, tx_frames, tx_drops, rx_octets, tx_octets,
    features, queue_size, msix, notified, link_up,
    shut_down, VEC_NET, QSIZE, BUFSZ,
    MAX_CARDS,
    init_on, present_on, ready_on, up_on, mac_at_on, bdf_on, idx_on,
    rx_take_on, rx_recycle_on, tx_frame_on, tx_room_on, poll_on, irq_on,
    rx_frames_on, tx_frames_on, rx_octets_on, tx_octets_on,
    tx_drops_on, link_up_on,
    irqs_on, features_on, queue_size_on, msix_on, notified_on,
    shut_down_on, link_speed_on
}

const S_COMMON: u64 = 0x200
const S_NOTIFY: u64 = 0x208
const S_NMULT: u64 = 0x210
const S_ISR: u64 = 0x218
const S_DEVCFG: u64 = 0x220
const S_BDF: u64 = 0x228
const S_IDX: u64 = 0x230
const S_READY: u64 = 0x238
const S_MAC: u64 = 0x240
const S_RING: u64 = 0x248
const S_RX_AVAIL: u64 = 0x250
const S_RX_USED: u64 = 0x258
const S_TX_AVAIL: u64 = 0x260
const S_TX_USED: u64 = 0x268
const S_RX_DOOR: u64 = 0x270
const S_TX_DOOR: u64 = 0x278
const S_IRQS: u64 = 0x280
const S_RXP: u64 = 0x288
const S_TXP: u64 = 0x290
const S_TXDROP: u64 = 0x298
const S_MSIX: u64 = 0x2A0
const S_QSIZE: u64 = 0x2A8
const S_FEAT: u64 = 0x2B0
const S_FEATHI: u64 = 0x2B8
const S_RXB: u64 = 0x2C0
const S_TXB: u64 = 0x2C8
const S_NOTIFIED: u64 = 0x2D0
const S_LINK: u64 = 0x2D8
const S_SPEED: u64 = 0x2E0
const S_RXPOST: u64 = 0x2E8

const CARD1: u64 = 0x1600
const MAX_CARDS: u64 = 2

const QSIZE: u64 = 64
const BUFSZ: u64 = 2048

const RXD_OFF: u64 = 0x00000
const RXA_OFF: u64 = 0x01000
const RXU_OFF: u64 = 0x02000
const TXD_OFF: u64 = 0x03000
const TXA_OFF: u64 = 0x04000
const TXU_OFF: u64 = 0x05000
const RXB_OFF: u64 = 0x06000
const TXB_OFF: u64 = 0x26000
const RING_BYTES: u64 = 0x46000

const VENDOR_VIRTIO: u64 = 0x1AF4
const CLASS_NET: u64 = 0x02
const SUB_ETHERNET: u64 = 0x00

const CAP_VENDOR: u64 = 0x09

const VC_TYPE: u64 = 3
const VC_BAR: u64 = 4
const VC_OFFSET: u64 = 8
const VC_LENGTH: u64 = 12
const VC_NOTIFY_MULT: u64 = 16

const CFG_COMMON: u64 = 1
const CFG_NOTIFY: u64 = 2
const CFG_ISR: u64 = 3
const CFG_DEVICE: u64 = 4

const C_DFSELECT: u64 = 0x00
const C_DFEATURE: u64 = 0x04
const C_GFSELECT: u64 = 0x08
const C_GFEATURE: u64 = 0x0C
const C_MSIX_CFG: u64 = 0x10
const C_NUMQ: u64 = 0x12
const C_STATUS: u64 = 0x14
const C_GENERATION: u64 = 0x15
const C_QSELECT: u64 = 0x16
const C_QSIZE: u64 = 0x18
const C_QMSIX: u64 = 0x1A
const C_QENABLE: u64 = 0x1C
const C_QNOTIFY_OFF: u64 = 0x1E
const C_QDESC: u64 = 0x20
const C_QDRIVER: u64 = 0x28
const C_QDEVICE: u64 = 0x30

const ST_ACK: u64 = 1
const ST_DRIVER: u64 = 2
const ST_DRIVER_OK: u64 = 4
const ST_FEATURES_OK: u64 = 8
const ST_NEEDS_RESET: u64 = 64
const ST_FAILED: u64 = 128

const F_NET_MAC: u64 = 5
const F_NET_STATUS: u64 = 16
const F_VERSION_1: u64 = 0
const F_NET_SPEED_DUPLEX: u64 = 31

const NO_VECTOR: u64 = 0xFFFF

const D_NEXT: u64 = 1
const D_WRITE: u64 = 2

const N_MAC: u64 = 0
const N_STATUS: u64 = 6
const NS_LINK_UP: u64 = 1
const N_SPEED: u64 = 10
const SPEED_UNKNOWN: u64 = 4294967295

const VEC_NET: u64 = 45

const SPIN_LIMIT: u64 = 2000000

fn sc(c: u64, off: u64) -> u64 {
    if c == 0 {
        return pci.K2_SCALARS + off
    }
    return pci.K2_SCALARS + CARD1 + off
}

fn common(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_COMMON))
}

fn present_on(state: u64, c: u64) -> bool {
    return common(state, c) != 0
}

fn ready_on(state: u64, c: u64) -> bool {
    return kstate.get(state, sc(c, S_READY)) != 0
}

fn up_on(state: u64, c: u64) -> bool {
    return ready_on(state, c)
}

fn bdf_on(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_BDF))
}

fn idx_on(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_IDX))
}

fn irqs_on(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_IRQS))
}

fn rx_frames_on(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_RXP))
}

fn tx_frames_on(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_TXP))
}

fn tx_drops_on(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_TXDROP))
}

fn rx_octets_on(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_RXB))
}

fn tx_octets_on(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_TXB))
}

fn features_on(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_FEAT))
        | (kstate.get(state, sc(c, S_FEATHI)) << 32)
}

fn queue_size_on(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_QSIZE))
}

fn msix_on(state: u64, c: u64) -> bool {
    return kstate.get(state, sc(c, S_MSIX)) != 0
}

fn notified_on(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_NOTIFIED))
}

fn link_up_on(state: u64, c: u64) -> bool {
    return kstate.get(state, sc(c, S_LINK)) != 0
}

fn link_speed_on(state: u64, c: u64) -> u64 {
    if kstate.get(state, sc(c, S_LINK)) == 0 {
        return 0
    }
    return kstate.get(state, sc(c, S_SPEED))
}

fn mac_at_on(state: u64, c: u64, i: u64) -> u64 {
    if i >= 6 {
        return 0
    }
    return (kstate.get(state, sc(c, S_MAC)) >> (i * 8)) & 0xFF
}

fn wr16(b: u64, off: u64, v: u64) {
    __mmio_write16((b + off) as *mut u16, (v & 0xFFFF) as u16)
}

fn ring(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_RING))
}

fn desc_set(table: u64, i: u64, addr: u64, len: u64, flags: u64, next: u64) {
    let d: u64 = table + i * 16
    regio.write64_at(d, 0, addr)
    regio.write32_at(d, 8, len)
    wr16(d, 12, flags)
    wr16(d, 14, next)
}

fn avail_put(a: u64, slot: u64, desc: u64) {
    wr16(a, 4 + slot * 2, desc)
}

fn avail_idx(a: u64) -> u64 {
    return regio.read16_at(a, 2)
}

fn avail_publish(a: u64, v: u64) {
    wr16(a, 2, v)
}

fn used_idx(u: u64) -> u64 {
    return regio.read16_at(u, 2)
}

fn used_id(u: u64, slot: u64) -> u64 {
    return regio.read32_at(u, 4 + slot * 8)
}

fn used_len(u: u64, slot: u64) -> u64 {
    return regio.read32_at(u, 4 + slot * 8 + 4)
}

fn kick(state: u64, c: u64, door: u64, queue: u64) {
    if door == 0 {
        return
    }
    wr16(door, 0, queue)
    kstate.add(state, sc(c, S_NOTIFIED), 1)
}

fn find_vcap(d: u64, want: u64) -> u64 {
    if (pci.cfg_read16(d, 0x06) & 0x10) == 0 {
        return 0
    }
    var off: u64 = pci.cfg_read8(d, 0x34) & 0xFC
    var guard: u64 = 0
    while off >= 0x40 && guard < 48 {
        if pci.cfg_read8(d, off) == CAP_VENDOR {
            if pci.cfg_read8(d, off + VC_TYPE) == want {
                return off
            }
        }
        off = pci.cfg_read8(d, off + 1) & 0xFC
        guard = guard + 1
    }
    return 0
}

fn region(state: u64, c: u64, i: u64, d: u64, cap: u64) -> u64 {
    if cap == 0 {
        return 0
    }
    let which: u64 = pci.cfg_read8(d, cap + VC_BAR)
    if which >= 6 {
        return 0
    }
    let phys: u64 = pci.bar(state, i, which)
    if phys == 0 || pci.bar_is_io(state, i, which) {
        return 0
    }
    let off: u64 = pci.cfg_read32(d, cap + VC_OFFSET)
    let size: u64 = pci.bar_size(state, i, which)
    if size != 0 {
        let len: u64 = pci.cfg_read32(d, cap + VC_LENGTH)
        if off >= size || len > size - off {
            return 0
        }
    }
    return apic.map_device(state, phys + off)
}

fn status(state: u64, c: u64) -> u64 {
    return regio.read8_at(common(state, c), C_STATUS)
}

fn status_add(state: u64, c: u64, bits: u64) {
    regio.write8_at(common(state, c), C_STATUS, status(state, c) | bits)
}

fn reset(state: u64, c: u64) -> bool {
    regio.write8_at(common(state, c), C_STATUS, 0)
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        if regio.read8_at(common(state, c), C_STATUS) == 0 {
            return true
        }
        arch.pause()
        spin = spin + 1
    }
    return false
}

fn find(state: u64, c: u64) -> u64 {
    let n: u64 = pci.count(state)
    var i: u64 = 0
    var seen: u64 = 0
    while i < n {
        if pci.get(state, i, pci.E_VENDOR) == VENDOR_VIRTIO {
            if pci.get(state, i, pci.E_CLASS) == CLASS_NET {
                if pci.get(state, i, pci.E_SUBCLASS) == SUB_ETHERNET {
                    if seen == c {
                        return i
                    }
                    seen = seen + 1
                }
            }
        }
        i = i + 1
    }
    return pci.MAX_DEV
}

fn init_on(state: u64, c: u64, use_msix: bool, armed: bool,
    vec: u64) -> bool {
    kstate.set(state, sc(c, S_READY), 0)
    let i: u64 = find(state, c)
    if i >= pci.MAX_DEV {
        return false
    }
    let d: u64 = pci.get(state, i, pci.E_BDF)
    kstate.set(state, sc(c, S_IDX), i)
    kstate.set(state, sc(c, S_BDF), d)

    let c_cap: u64 = find_vcap(d, CFG_COMMON)
    let n_cap: u64 = find_vcap(d, CFG_NOTIFY)
    let i_cap: u64 = find_vcap(d, CFG_ISR)
    let v_cap: u64 = find_vcap(d, CFG_DEVICE)
    if c_cap == 0 || n_cap == 0 {
        return false
    }
    let cbase: u64 = region(state, c, i, d, c_cap)
    if cbase == 0 {
        return false
    }
    kstate.set(state, sc(c, S_COMMON), cbase)
    kstate.set(state, sc(c, S_NOTIFY), region(state, c, i, d, n_cap))
    kstate.set(state, sc(c, S_NMULT), pci.cfg_read32(d, n_cap + VC_NOTIFY_MULT))
    kstate.set(state, sc(c, S_ISR), region(state, c, i, d, i_cap))
    kstate.set(state, sc(c, S_DEVCFG), region(state, c, i, d, v_cap))

    pci.enable_master(d)

    if !reset(state, c) {
        return false
    }
    status_add(state, c, ST_ACK)
    status_add(state, c, ST_DRIVER)

    if !negotiate(state, c) {
        regio.write8_at(cbase, C_STATUS, ST_FAILED)
        return false
    }

    let r: u64 = mmframe.frame_run(state, RING_BYTES / mmframe.FRAME_SIZE)
    if r == 0 {
        regio.write8_at(cbase, C_STATUS, ST_FAILED)
        return false
    }
    var z: u64 = 0
    while z < RING_BYTES {
        __mmio_write64((r + z) as *mut u64, 0)
        z = z + 8
    }
    kstate.set(state, sc(c, S_RING), r)
    kstate.set(state, sc(c, S_QSIZE), QSIZE)

    if vec == 0 {
        kstate.set(state, sc(c, S_MSIX), 0)
    } else if use_msix {
        if !msix_arm(state, c, i, vec, armed) {
            regio.write8_at(cbase, C_STATUS, ST_FAILED)
            return false
        }
        kstate.set(state, sc(c, S_MSIX), 1)
    } else {
        intx_arm(state, c, i, vec, armed)
        kstate.set(state, sc(c, S_MSIX), 0)
    }

    if !queue_setup(state, c, 0, r + RXD_OFF, r + RXA_OFF, r + RXU_OFF,
        S_RX_DOOR, use_msix) {
        regio.write8_at(cbase, C_STATUS, ST_FAILED)
        return false
    }
    if !queue_setup(state, c, 1, r + TXD_OFF, r + TXA_OFF, r + TXU_OFF,
        S_TX_DOOR, use_msix) {
        regio.write8_at(cbase, C_STATUS, ST_FAILED)
        return false
    }

    read_mac(state, c)
    rx_fill(state, c)

    status_add(state, c, ST_DRIVER_OK)
    if (status(state, c) & ST_DRIVER_OK) == 0 {
        return false
    }
    kstate.set(state, sc(c, S_READY), 1)
    kick(state, c, kstate.get(state, sc(c, S_RX_DOOR)), 0)
    read_link(state, c)
    return true
}

fn negotiate(state: u64, c: u64) -> bool {
    let b: u64 = common(state, c)
    regio.write32_at(b, C_DFSELECT, 0)
    let dev_lo: u64 = regio.read32_at(b, C_DFEATURE)
    regio.write32_at(b, C_DFSELECT, 1)
    let dev_hi: u64 = regio.read32_at(b, C_DFEATURE)

    if (dev_hi & (1 << F_VERSION_1)) == 0 {
        return false
    }
    var lo: u64 = 0
    if (dev_lo & (1 << F_NET_MAC)) != 0 {
        lo = lo | (1 << F_NET_MAC)
    }
    if (dev_lo & (1 << F_NET_STATUS)) != 0 {
        lo = lo | (1 << F_NET_STATUS)
    }
    var hi: u64 = 1 << F_VERSION_1
    if (dev_hi & (1 << F_NET_SPEED_DUPLEX)) != 0 {
        hi = hi | (1 << F_NET_SPEED_DUPLEX)
    }

    regio.write32_at(b, C_GFSELECT, 0)
    regio.write32_at(b, C_GFEATURE, lo)
    regio.write32_at(b, C_GFSELECT, 1)
    regio.write32_at(b, C_GFEATURE, hi)
    kstate.set(state, sc(c, S_FEAT), lo)
    kstate.set(state, sc(c, S_FEATHI), hi)

    status_add(state, c, ST_FEATURES_OK)
    if (status(state, c) & ST_FEATURES_OK) == 0 {
        return false
    }
    return true
}

fn queue_setup(state: u64, c: u64, q: u64, desc: u64, avail: u64, used: u64,
    door_slot: u64, use_msix: bool) -> bool {
    let b: u64 = common(state, c)
    wr16(b, C_QSELECT, q)
    let offered: u64 = regio.read16_at(b, C_QSIZE)
    if offered == 0 {
        return false
    }
    if offered > QSIZE {
        wr16(b, C_QSIZE, QSIZE)
    }
    if regio.read16_at(b, C_QSIZE) != QSIZE {
        return false
    }
    regio.write64_at(b, C_QDESC, desc)
    regio.write64_at(b, C_QDRIVER, avail)
    regio.write64_at(b, C_QDEVICE, used)
    if use_msix {
        wr16(b, C_QMSIX, 0)
        if regio.read16_at(b, C_QMSIX) != 0 {
            return false
        }
    } else {
        wr16(b, C_QMSIX, NO_VECTOR)
    }
    let door: u64 = kstate.get(state, sc(c, S_NOTIFY))
        + regio.read16_at(b, C_QNOTIFY_OFF) * kstate.get(state, sc(c, S_NMULT))
    kstate.set(state, sc(c, door_slot), door)
    wr16(b, C_QENABLE, 1)
    return regio.read16_at(b, C_QENABLE) == 1
}

fn read_mac(state: u64, c: u64) {
    let cfg: u64 = kstate.get(state, sc(c, S_DEVCFG))
    if cfg == 0 || (kstate.get(state, sc(c, S_FEAT)) & (1 << F_NET_MAC)) == 0 {
        return
    }
    var v: u64 = 0
    var i: u64 = 0
    while i < 6 {
        v = v | (regio.read8_at(cfg, N_MAC + i) << (i * 8))
        i = i + 1
    }
    kstate.set(state, sc(c, S_MAC), v)
}

fn read_link(state: u64, c: u64) {
    let cfg: u64 = kstate.get(state, sc(c, S_DEVCFG))
    if cfg == 0 || (kstate.get(state, sc(c, S_FEAT)) & (1 << F_NET_STATUS)) == 0 {
        kstate.set(state, sc(c, S_LINK), 1)
        read_speed(state, c)
        return
    }
    var v: u64 = 0
    if (regio.read16_at(cfg, N_STATUS) & NS_LINK_UP) != 0 {
        v = 1
    }
    kstate.set(state, sc(c, S_LINK), v)
    read_speed(state, c)
}

fn read_speed(state: u64, c: u64) {
    let cfg: u64 = kstate.get(state, sc(c, S_DEVCFG))
    if cfg == 0
        || (kstate.get(state, sc(c, S_FEATHI)) & (1 << F_NET_SPEED_DUPLEX)) == 0 {
        kstate.set(state, sc(c, S_SPEED), 0)
        return
    }
    let v: u64 = regio.read32_at(cfg, N_SPEED)
    if v == SPEED_UNKNOWN {
        kstate.set(state, sc(c, S_SPEED), 0)
        return
    }
    kstate.set(state, sc(c, S_SPEED), v)
}

fn rx_fill(state: u64, c: u64) {
    let r: u64 = ring(state, c)
    let d: u64 = r + RXD_OFF
    let a: u64 = r + RXA_OFF
    var i: u64 = 0
    while i < QSIZE {
        desc_set(d, i, r + RXB_OFF + i * BUFSZ, BUFSZ, D_WRITE, 0)
        avail_put(a, i, i)
        i = i + 1
    }
    avail_publish(a, QSIZE)
    kstate.set(state, sc(c, S_RX_AVAIL), QSIZE)
    kstate.set(state, sc(c, S_RXPOST), 0xFFFFFFFFFFFFFFFF)
    kstate.set(state, sc(c, S_RX_USED), 0)
    kstate.set(state, sc(c, S_TX_AVAIL), 0)
    kstate.set(state, sc(c, S_TX_USED), 0)
}

fn rx_take_on(state: u64, c: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    if !ready_on(state, c) {
        return 0
    }
    let r: u64 = ring(state, c)
    let u: u64 = r + RXU_OFF
    let last: u64 = kstate.get(state, sc(c, S_RX_USED))
    let now: u64 = used_idx(u)
    if last == now {
        return 0
    }
    arch.barrier_read()
    if ((now -% last) & 0xFFFF) > QSIZE {
        kstate.set(state, sc(c, S_RX_USED), now & 0xFFFF)
        return 0
    }
    let i: u64 = last % QSIZE
    let id: u64 = used_id(u, i) % QSIZE
    let len: u64 = used_len(u, i)
    kstate.set(state, sc(c, S_RX_USED), (last +% 1) & 0xFFFF)
    let posted: u64 = kstate.get(state, sc(c, S_RXPOST))
    if ((posted >> id) & 1) == 0 {
        return 0
    }
    kstate.set(state, sc(c, S_RXPOST), posted & (0xFFFFFFFFFFFFFFFF -% (1 << id)))
    if len <= 12 || len > BUFSZ {
        rx_recycle_on(state, c, id)
        return 0
    }
    *frame = r + RXB_OFF + id * BUFSZ + 12
    *slot = id
    kstate.add(state, sc(c, S_RXP), 1)
    kstate.add(state, sc(c, S_RXB), len - 12)
    return len - 12
}

fn rx_recycle_on(state: u64, c: u64, id: u64) {
    let r: u64 = ring(state, c)
    let a: u64 = r + RXA_OFF
    let idx: u64 = kstate.get(state, sc(c, S_RX_AVAIL))
    kstate.set(state, sc(c, S_RXPOST), kstate.get(state, sc(c, S_RXPOST)) | (1 << (id % QSIZE)))
    avail_put(a, idx % QSIZE, id)
    avail_publish(a, (idx +% 1) & 0xFFFF)
    kstate.set(state, sc(c, S_RX_AVAIL), (idx +% 1) & 0xFFFF)
    kick(state, c, kstate.get(state, sc(c, S_RX_DOOR)), 0)
}

fn tx_room_on(state: u64, c: u64) -> u64 {
    if !ready_on(state, c) {
        return 0
    }
    let inflight: u64 = (kstate.get(state, sc(c, S_TX_AVAIL))
        -% used_idx(ring(state, c) + TXU_OFF)) & 0xFFFF
    if inflight >= QSIZE {
        return 0
    }
    return QSIZE - inflight
}

fn tx_frame_on(state: u64, c: u64, src: u64, n: u64) -> bool {
    if !ready_on(state, c) || n == 0 || n + 12 > BUFSZ {
        return false
    }
    if tx_room_on(state, c) == 0 {
        kstate.add(state, sc(c, S_TXDROP), 1)
        return false
    }
    let r: u64 = ring(state, c)
    let idx: u64 = kstate.get(state, sc(c, S_TX_AVAIL))
    let id: u64 = idx % QSIZE
    let buf: u64 = r + TXB_OFF + id * BUFSZ
    var z: u64 = 0
    while z < 12 {
        __mmio_write32((buf + z) as *mut u32, 0)
        z = z + 4
    }
    var k: u64 = 0
    while k < n {
        __mmio_write8((buf + 12 + k) as *mut u8,
            __mmio_read8((src + k) as *mut u8))
        k = k + 1
    }
    desc_set(r + TXD_OFF, id, buf, n + 12, 0, 0)
    avail_put(r + TXA_OFF, idx % QSIZE, id)
    avail_publish(r + TXA_OFF, (idx +% 1) & 0xFFFF)
    kstate.set(state, sc(c, S_TX_AVAIL), (idx +% 1) & 0xFFFF)
    kstate.add(state, sc(c, S_TXP), 1)
    kstate.add(state, sc(c, S_TXB), n)
    kick(state, c, kstate.get(state, sc(c, S_TX_DOOR)), 1)
    return true
}

fn irq_on(state: u64, c: u64) {
    kstate.add(state, sc(c, S_IRQS), 1)
    let isr: u64 = kstate.get(state, sc(c, S_ISR))
    if isr != 0 {
        let v: u64 = regio.read8_at(isr, 0)
        if (v & 2) != 0 {
            read_link(state, c)
        }
    }
}

fn poll_on(state: u64, c: u64) -> bool {
    if !ready_on(state, c) {
        return false
    }
    return kstate.get(state, sc(c, S_RX_USED)) != used_idx(ring(state, c) + RXU_OFF)
}

fn msix_arm(state: u64, c: u64, i: u64, vector: u64, armed: bool) -> bool {
    let d: u64 = pci.get(state, i, pci.E_BDF)
    let cap: u64 = pci.get(state, i, pci.E_MSIX)
    if cap == 0 {
        return false
    }
    let table: u64 = pci.cfg_read32(d, cap + 4)
    let bir: u64 = table & 7
    let toff: u64 = table & 0xFFFFFFF8
    if pci.bar(state, i, bir) == 0 {
        return false
    }
    let tbase: u64 = apic.map_device(state, pci.bar(state, i, bir) + toff)
    if tbase == 0 {
        return false
    }
    regio.write32_at(tbase, 0, apic.lapic_phys(state) | ((apic.id(state) & 0xFF) << 12))
    regio.write32_at(tbase, 4, 0)
    regio.write32_at(tbase, 8, vector & 0xFF)
    var ctrl: u64 = 1
    if armed {
        ctrl = 0
    }
    regio.write32_at(tbase, 12, ctrl)
    let msg: u64 = pci.cfg_read16(d, cap + 2)
    pci.cfg_write16(d, cap + 2, (msg | 0x8000) & 0xBFFF)
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) | 0x400)
    return true
}

fn intx_arm(state: u64, c: u64, i: u64, vector: u64, armed: bool) {
    let d: u64 = pci.get(state, i, pci.E_BDF)
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) & 0xFBFF)
    let gsi: u64 = aml.gsi_or_line(state, i)
    if gsi == 0 || gsi > 23 {
        return
    }
    apic.route(state, gsi, vector, apic.id(state), true, true)
    if !armed {
        apic.mask_gsi(state, gsi)
    }
}

fn shut_down_on(state: u64, c: u64) {
    if common(state, c) == 0 {
        return
    }
    regio.write8_at(common(state, c), C_STATUS, 0)
    kstate.set(state, sc(c, S_READY), 0)
    pci.disable_master(bdf_on(state, c))
}

fn init(state: u64, use_msix: bool, armed: bool) -> bool {
    return init_on(state, 0, use_msix, armed, VEC_NET)
}

fn present(state: u64) -> bool { return present_on(state, 0) }
fn ready(state: u64) -> bool { return ready_on(state, 0) }
fn up(state: u64) -> bool { return up_on(state, 0) }
fn bdf(state: u64) -> u64 { return bdf_on(state, 0) }
fn idx(state: u64) -> u64 { return idx_on(state, 0) }
fn irqs(state: u64) -> u64 { return irqs_on(state, 0) }
fn rx_frames(state: u64) -> u64 { return rx_frames_on(state, 0) }
fn tx_frames(state: u64) -> u64 { return tx_frames_on(state, 0) }
fn tx_drops(state: u64) -> u64 { return tx_drops_on(state, 0) }
fn rx_octets(state: u64) -> u64 { return rx_octets_on(state, 0) }
fn tx_octets(state: u64) -> u64 { return tx_octets_on(state, 0) }
fn features(state: u64) -> u64 { return features_on(state, 0) }
fn queue_size(state: u64) -> u64 { return queue_size_on(state, 0) }
fn msix(state: u64) -> bool { return msix_on(state, 0) }
fn notified(state: u64) -> u64 { return notified_on(state, 0) }
fn link_up(state: u64) -> bool { return link_up_on(state, 0) }
fn shut_down(state: u64) { shut_down_on(state, 0) }
fn poll(state: u64) -> bool { return poll_on(state, 0) }
fn irq(state: u64) { irq_on(state, 0) }
fn tx_room(state: u64) -> u64 { return tx_room_on(state, 0) }

fn mac_at(state: u64, i: u64) -> u64 { return mac_at_on(state, 0, i) }

fn rx_take(state: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    return rx_take_on(state, 0, frame, slot)
}

fn rx_recycle(state: u64, id: u64) { rx_recycle_on(state, 0, id) }

fn tx_frame(state: u64, src: u64, n: u64) -> bool {
    return tx_frame_on(state, 0, src, n)
}
