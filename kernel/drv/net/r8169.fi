//   +0  dw0   OWN(31) EOR(30) FS(29) LS(28) ... Laenge(13..0)
//   +4  dw1   VLAN -- hier immer 0
//   +8  dw2   Pufferadresse, untere 32 Bit
//   +12 dw3   Pufferadresse, obere 32 Bit

import lib.kstate
import serial
import mm.mem
import bus.pci
import arch.x86_64.apic
import arch.arch

export {
    MAX_UNITS, VENDOR_REALTEK, supports, variant_of, needs_cplus_rev,
    is_8125,
    RING_SLOTS, BUFSZ,
    VAR_NONE, VAR_CP, VAR_8169, VAR_8125,
    init_on, present_on, ready_on, up_on, mac_at_on, bdf_on, idx_on,
    rx_take_on, rx_recycle_on, tx_frame_on, tx_room_on, poll_on, irq_on,
    rx_frames_on, tx_frames_on, rx_octets_on, tx_octets_on,
    tx_drops_on, link_up_on, shut_down_on, irqs_on, queue_size_on,
    msix_on, notified_on, features_on,
    rx_errors_on, oversize_on, rx_overflow_on, selftest_on, print_regs_on,
    link_speed_on
}

// ------------------------------------------------------ der Datenbereich
const UNIT_BASE: u64 = 0x800
const UNIT_SPAN: u64 = 0x200
const MAX_UNITS: u64 = 2

const S_MMIO: u64 = 0x00 // BAR, erreichbar im ersten Gigabyte
const S_BDF: u64 = 0x08
const S_IDX: u64 = 0x10
const S_READY: u64 = 0x18
const S_MAC: u64 = 0x20
const S_RING: u64 = 0x28
const S_RX_CUR: u64 = 0x30
const S_TX_CUR: u64 = 0x38
const S_TX_CLEAN: u64 = 0x40
const S_IRQS: u64 = 0x48
const S_RXP: u64 = 0x50
const S_TXP: u64 = 0x58
const S_RXB: u64 = 0x60
const S_TXB: u64 = 0x68
const S_TXDROP: u64 = 0x70
const S_LINK: u64 = 0x78
const S_DEVID: u64 = 0x80
const S_VAR: u64 = 0x88 // VAR_CP oder VAR_8169
const S_LASTISR: u64 = 0x90
const S_RXERR: u64 = 0x98
const S_OVERLEN: u64 = 0xA0
const S_REV: u64 = 0xA8
const S_BARN: u64 = 0xB0
const S_LINKCH: u64 = 0xB8
const S_RXOVW: u64 = 0xC0
const S_SPEED: u64 = 0xC8 // 0 = unbekannt, sonst 10/100/1000

fn sc(u: u64, off: u64) -> u64 {
    return kstate.NETDEV_OFF + UNIT_BASE + u * UNIT_SPAN + off
}

// ------------------------------------------------------- die Konstanten

const VENDOR_REALTEK: u64 = 0x10EC
const CLASS_NET: u64 = 0x02
const SUB_ETHERNET: u64 = 0x00

const VAR_NONE: u64 = 0
const VAR_CP: u64 = 1 // RTL8139C+, der in QEMU gemessene
const VAR_8169: u64 = 2
const VAR_8125: u64 = 3 // RTL8125/8126, Runde BLECH -- NICHT gemessen

const CPLUS_REV: u64 = 0x20

const R_IDR0: u64 = 0x00
const R_IDR4: u64 = 0x04
const R_MAR0: u64 = 0x08
const R_TNPDS: u64 = 0x20 // Sendering, normale Prioritaet
const R_THPDS: u64 = 0x28
const R_CR: u64 = 0x37
const R_TPPOLL69: u64 = 0x38 // nur 8169
const R_IMR: u64 = 0x3C
const R_ISR: u64 = 0x3E
const R_TCR: u64 = 0x40
const R_RCR: u64 = 0x44
const R_CR9346: u64 = 0x50
const R_CONFIG1: u64 = 0x52
const R_MSR: u64 = 0x58
const R_BMSR39: u64 = 0x64
const R_PHYAR: u64 = 0x60 // nur 8169: MDIO
const R_PHYSTAT: u64 = 0x6C // nur 8169
const R_RMS: u64 = 0xDA
const R_TPPOLL39: u64 = 0xD9 // nur 8139C+
const R_CPCMD: u64 = 0xE0
const R_RDSAR: u64 = 0xE4
const R_MTPS: u64 = 0xEC // nur 8169

const R_INTCFG0_25: u64 = 0x34 // Unterbrechungsblock einschalten
const R_IMR25: u64 = 0x38 // 32 Bit
const R_ISR25: u64 = 0x3C
const R_TPPOLL25: u64 = 0x90
const TPPOLL25_GO: u64 = 1
const R_OCPDR: u64 = 0xB0
const R_RSSCTRL25: u64 = 0x4500
const R_QNUMCTRL25: u64 = 0x4800
const INTCFG0_EN: u64 = 1
const OCP_FLAG: u64 = 2147483648 // 0x80000000, "schreiben"
const OCP_DESCOLD: u64 = 60248 // 0xEB58: Bit 0 aus = altes Deskriptorformat

// CR (0x37), acht Bit.
const CR_RST: u64 = 16 // 1 << 4
const CR_RE: u64 = 8 // 1 << 3
const CR_TE: u64 = 4 // 1 << 2

const I_ROK: u64 = 1
const I_RER: u64 = 2
const I_TOK: u64 = 4
const I_TER: u64 = 8
const I_RXOVW: u64 = 16
const I_LINKCHG: u64 = 32
const I_FOVW: u64 = 64
const I_TDU: u64 = 128
const I_SERR: u64 = 32768

const RCR_AAP: u64 = 1
const RCR_APM: u64 = 2
const RCR_AM: u64 = 4
const RCR_AB: u64 = 8
const RCR_BASE: u64 = 59146 // 0xE70A = APM | AB | (7<<8) | (7<<13)

const TCR_BASE: u64 = 50333952 // 0x03000700

const CP_TXENB: u64 = 1
const CP_RXENB: u64 = 2
const CP_RXCHKSUM: u64 = 32
const CP_RXVLAN: u64 = 64

const CR9346_UNLOCK: u64 = 192 // 0xC0
const CR9346_LOCK: u64 = 0

const MSR_LINKB: u64 = 4
const PHYS_LINKOK: u64 = 2
const PHYS_1000M: u64 = 16
const PHYS_100M: u64 = 8
const PHYS_10M: u64 = 4

const PHYAR_FLAG: u64 = 2147483648 // 1 << 31

const D_OWN: u64 = 2147483648
const D_EOR: u64 = 1073741824
const D_FS: u64 = 536870912
const D_LS: u64 = 268435456 // 1 << 28 -- letztes Stueck
const D_RES: u64 = 2097152 // 1 << 21 -- Empfangsfehler, Sammelbit
const D_LEN: u64 = 16383 // Bit 13..0

const RING_SLOTS: u64 = 128
const BUFSZ: u64 = 2048

const RXD_OFF: u64 = 0x00000 // 128 * 16 = 2048 Oktett
const TXD_OFF: u64 = 0x01000 // 2048
const RXB_OFF: u64 = 0x02000 // 128 * 2048 = 0x40000
const TXB_OFF: u64 = 0x42000 // 0x40000
const RING_BYTES: u64 = 0x82000 // 532480 Oktett = 130 Rahmen

const SPIN_LIMIT: u64 = 2000000

// ---------------------------------------------------- WELCHE CHIPS
fn supports(devid: u64) -> bool {
    if devid == 0x8139 { return true }
    if devid == 0x8169 { return true }
    if devid == 0x8168 { return true }
    if devid == 0x8161 { return true }
    if devid == 0x8167 { return true }
    if devid == 0x8136 { return true }
    if devid == 0x8125 { return true }
    if devid == 0x8126 { return true }
    if devid == 0x3000 { return true }
    return false
}

fn is_8125(devid: u64) -> bool {
    if devid == 0x8125 { return true }
    if devid == 0x8126 { return true }
    if devid == 0x3000 { return true }
    return false
}

fn variant_of(devid: u64) -> u64 {
    if devid == 0x8139 { return VAR_CP }
    if is_8125(devid) { return VAR_8125 }
    if supports(devid) { return VAR_8169 }
    return VAR_NONE
}

fn needs_cplus_rev(devid: u64) -> bool {
    return devid == 0x8139
}

// -------------------------------------------------------- kleine Helfer

fn mmio(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_MMIO))
}

fn present_on(state: u64, u: u64) -> bool {
    return mmio(state, u) != 0
}

fn ready_on(state: u64, u: u64) -> bool {
    return kstate.get(state, sc(u, S_READY)) != 0
}

fn up_on(state: u64, u: u64) -> bool {
    return ready_on(state, u)
}

fn bdf_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_BDF))
}

fn idx_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_IDX))
}

fn irqs_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_IRQS))
}

fn rx_frames_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_RXP))
}

fn tx_frames_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_TXP))
}

fn tx_drops_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_TXDROP))
}

fn rx_octets_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_RXB))
}

fn tx_octets_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_TXB))
}

fn rx_errors_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_RXERR))
}

fn oversize_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_OVERLEN))
}

fn rx_overflow_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_RXOVW))
}

fn features_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_DEVID))
}

fn queue_size_on(state: u64, u: u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    return RING_SLOTS
}

fn msix_on(state: u64, u: u64) -> bool {
    return false
}

fn notified_on(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_TXP)) + kstate.get(state, sc(u, S_RXP))
}

fn link_up_on(state: u64, u: u64) -> bool {
    return kstate.get(state, sc(u, S_LINK)) != 0
}

fn link_speed_on(state: u64, u: u64) -> u64 {
    if kstate.get(state, sc(u, S_LINK)) == 0 {
        return 0
    }
    return kstate.get(state, sc(u, S_SPEED))
}

fn mac_at_on(state: u64, u: u64, i: u64) -> u64 {
    if i >= 6 {
        return 0
    }
    return (kstate.get(state, sc(u, S_MAC)) >> (i * 8)) & 0xFF
}

// ---------------------------------------------------- Registerzugriff

fn rd8(b: u64, off: u64) -> u64 {
    return __mmio_read8((b + off) as *mut u8) as u64
}

fn wr8(b: u64, off: u64, v: u64) {
    __mmio_write8((b + off) as *mut u8, (v & 0xFF) as u8)
}

fn rd16(b: u64, off: u64) -> u64 {
    return __mmio_read16((b + off) as *mut u16) as u64
}

fn wr16(b: u64, off: u64, v: u64) {
    __mmio_write16((b + off) as *mut u16, (v & 0xFFFF) as u16)
}

fn rd32(b: u64, off: u64) -> u64 {
    return __mmio_read32((b + off) as *mut u32) as u64
}

fn wr32(b: u64, off: u64, v: u64) {
    __mmio_write32((b + off) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn r8(state: u64, u: u64, off: u64) -> u64 { return rd8(mmio(state, u), off) }
fn w8(state: u64, u: u64, off: u64, v: u64) { wr8(mmio(state, u), off, v) }
fn r16(state: u64, u: u64, off: u64) -> u64 { return rd16(mmio(state, u), off) }
fn w16(state: u64, u: u64, off: u64, v: u64) { wr16(mmio(state, u), off, v) }
fn r32(state: u64, u: u64, off: u64) -> u64 { return rd32(mmio(state, u), off) }
fn w32(state: u64, u: u64, off: u64, v: u64) { wr32(mmio(state, u), off, v) }

fn ring(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_RING))
}

fn var_of(state: u64, u: u64) -> u64 {
    return kstate.get(state, sc(u, S_VAR))
}

fn d_dw0(t: u64, i: u64) -> u64 {
    return __mmio_read32((t + i * 16) as *mut u32) as u64
}

fn d_set_dw0(t: u64, i: u64, v: u64) {
    __mmio_write32((t + i * 16) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn d_set_dw1(t: u64, i: u64, v: u64) {
    __mmio_write32((t + i * 16 + 4) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn d_set_addr(t: u64, i: u64, a: u64) {
    __mmio_write32((t + i * 16 + 8) as *mut u32, (a & 0xFFFFFFFF) as u32)
    __mmio_write32((t + i * 16 + 12) as *mut u32, ((a >> 32) & 0xFFFFFFFF) as u32)
}

// --------------------------------------------------------- das Finden

fn find(state: u64, u: u64) -> u64 {
    let n: u64 = pci.count(state)
    var i: u64 = 0
    var seen: u64 = 0
    while i < n {
        if pci.get(state, i, pci.E_VENDOR) == VENDOR_REALTEK {
            if pci.get(state, i, pci.E_CLASS) == CLASS_NET {
                if pci.get(state, i, pci.E_SUBCLASS) == SUB_ETHERNET {
                    if usable(state, i) {
                        if seen == u {
                            return i
                        }
                        seen = seen + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return pci.MAX_DEV
}

fn usable(state: u64, i: u64) -> bool {
    let dev: u64 = pci.get(state, i, pci.E_DEVICE)
    if !supports(dev) {
        return false
    }
    if needs_cplus_rev(dev) {
        let rev: u64 = pci.cfg_read8(pci.get(state, i, pci.E_BDF), 0x08)
        if rev < CPLUS_REV {
            return false
        }
    }
    return true
}

fn find_bar(state: u64, i: u64) -> u64 {
    var b: u64 = 0
    while b < 6 {
        let base: u64 = pci.bar(state, i, b)
        if base != 0 {
            if !pci.bar_is_io(state, i, b) {
                return b
            }
        }
        b = b + 1
    }
    return 6
}

// ------------------------------------------------------ das Ruecksetzen
fn chip_reset(state: u64, u: u64) -> bool {
    w8(state, u, R_CR, CR_RST)
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        if (r8(state, u, R_CR) & CR_RST) == 0 {
            return true
        }
        arch.pause()
        spin = spin + 1
    }
    return false
}

// ------------------------------------------------------------ die Adresse

fn read_mac(state: u64, u: u64) -> bool {
    let lo: u64 = r32(state, u, R_IDR0)
    let hi: u64 = r32(state, u, R_IDR4) & 0xFFFF
    let v: u64 = (lo & 0xFFFFFFFF) | (hi << 32)
    if v == 0 {
        return false
    }
    if v == 0xFFFFFFFFFFFF {
        return false
    }
    if (lo & 1) != 0 {
        return false
    }
    kstate.set(state, sc(u, S_MAC), v)
    return true
}

// ---------------------------------------------------------- der PHY
fn mdio_read(state: u64, u: u64, reg: u64) -> u64 {
    if var_of(state, u) != VAR_8169 {
        return 0xFFFFFFFF
    }
    w32(state, u, R_PHYAR, (reg & 0x1F) << 16)
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        let v: u64 = r32(state, u, R_PHYAR)
        if (v & PHYAR_FLAG) != 0 {
            return v & 0xFFFF
        }
        arch.pause()
        spin = spin + 1
    }
    return 0xFFFFFFFF
}

fn mdio_write(state: u64, u: u64, reg: u64, val: u64) -> bool {
    if var_of(state, u) != VAR_8169 {
        return false
    }
    w32(state, u, R_PHYAR, PHYAR_FLAG | ((reg & 0x1F) << 16) | (val & 0xFFFF))
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        if (r32(state, u, R_PHYAR) & PHYAR_FLAG) == 0 {
            return true
        }
        arch.pause()
        spin = spin + 1
    }
    return false
}

fn read_link(state: u64, u: u64) {
    var v: u64 = 0
    if var_of(state, u) == VAR_CP {
        if (r16(state, u, R_BMSR39) & 4) != 0 {
            if (r8(state, u, R_MSR) & MSR_LINKB) == 0 {
                v = 1
            }
        }
    } else {
        if (r8(state, u, R_PHYSTAT) & PHYS_LINKOK) != 0 {
            v = 1
        } else {
            let bmsr: u64 = mdio_read(state, u, 1)
            if bmsr != 0xFFFFFFFF {
                if (bmsr & 4) != 0 {
                    v = 1
                }
            }
        }
    }
    if kstate.get(state, sc(u, S_LINK)) != v {
        kstate.add(state, sc(u, S_LINKCH), 1)
    }
    kstate.set(state, sc(u, S_LINK), v)
    var mbit: u64 = 0
    if v != 0 && var_of(state, u) != VAR_CP {
        let ph: u64 = r8(state, u, R_PHYSTAT)
        if (ph & PHYS_1000M) != 0 {
            mbit = 1000
        } else if (ph & PHYS_100M) != 0 {
            mbit = 100
        } else if (ph & PHYS_10M) != 0 {
            mbit = 10
        }
    }
    kstate.set(state, sc(u, S_SPEED), mbit)
}

// ------------------------------------------------------------- das Aufsetzen

fn init_on(state: u64, u: u64, use_msix: bool, armed: bool,
    vec: u64) -> bool {
    if u >= MAX_UNITS {
        return false
    }
    kstate.set(state, sc(u, S_READY), 0)
    let i: u64 = find(state, u)
    if i >= pci.MAX_DEV {
        return false
    }
    let d: u64 = pci.get(state, i, pci.E_BDF)
    let dev: u64 = pci.get(state, i, pci.E_DEVICE)
    kstate.set(state, sc(u, S_IDX), i)
    kstate.set(state, sc(u, S_BDF), d)
    kstate.set(state, sc(u, S_DEVID), dev)
    kstate.set(state, sc(u, S_VAR), variant_of(dev))
    kstate.set(state, sc(u, S_REV), pci.cfg_read8(d, 0x08))

    let bn: u64 = find_bar(state, i)
    if bn >= 6 {
        return false
    }
    kstate.set(state, sc(u, S_BARN), bn)
    let phys: u64 = pci.bar(state, i, bn)
    if phys == 0 {
        return false
    }
    let base: u64 = apic.map_device(state, phys)
    if base == 0 {
        return false
    }
    kstate.set(state, sc(u, S_MMIO), base)

    pci.enable_master(d)

    if !chip_reset(state, u) {
        kstate.set(state, sc(u, S_MMIO), 0)
        return false
    }

    if !read_mac(state, u) {
        kstate.set(state, sc(u, S_MMIO), 0)
        return false
    }

    w8(state, u, R_CR9346, CR9346_UNLOCK)

    w32(state, u, R_MAR0, 0)
    w32(state, u, R_MAR0 + 4, 0)

    var cp: u64 = r16(state, u, R_CPCMD)
    cp = cp & (~CP_RXCHKSUM)
    cp = cp & (~CP_RXVLAN)
    if var_of(state, u) == VAR_CP {
        cp = cp | CP_TXENB | CP_RXENB
    }
    w16(state, u, R_CPCMD, cp & 0xFFFF)

    if var_of(state, u) == VAR_8125 {
        let eb58: u64 = ocp_read(state, u, OCP_DESCOLD)
        ocp_write(state, u, OCP_DESCOLD, eb58 & 0xFFFE)
        w32(state, u, R_RSSCTRL25, 0)
        w32(state, u, R_QNUMCTRL25, 0)
        w8(state, u, R_INTCFG0_25, INTCFG0_EN)
    }

    let r: u64 = mem.frame_run(state, RING_BYTES / mem.FRAME_SIZE)
    if r == 0 {
        kstate.set(state, sc(u, S_MMIO), 0)
        return false
    }
    var z: u64 = 0
    while z < RING_BYTES {
        __mmio_write64((r + z) as *mut u64, 0)
        z = z + 8
    }
    kstate.set(state, sc(u, S_RING), r)

    w16(state, u, R_RMS, BUFSZ)
    if var_of(state, u) != VAR_CP {
        w8(state, u, R_MTPS, 0x3B)
    }

    rx_setup(state, u)
    tx_setup(state, u)

    w32(state, u, R_THPDS, 0)
    w32(state, u, R_THPDS + 4, 0)

    intx_arm(state, u, i, armed, vec)

    w8(state, u, R_CR, CR_TE | CR_RE)
    w32(state, u, R_TCR, TCR_BASE)
    w32(state, u, R_RCR, RCR_BASE)

    w8(state, u, R_CR9346, CR9346_LOCK)

    ack_all(state, u)
    if armed {
        set_imr(state, u, I_ROK | I_RER | I_TOK | I_TER | I_RXOVW
            | I_LINKCHG | I_FOVW | I_SERR)
    } else {
        set_imr(state, u, 0)
    }

    kstate.set(state, sc(u, S_READY), 1)
    read_link(state, u)
    return true
}

// ------------------------------------------------------ der Empfangsring

fn rx_setup(state: u64, u: u64) {
    let r: u64 = ring(state, u)
    let t: u64 = r + RXD_OFF
    var i: u64 = 0
    while i < RING_SLOTS {
        d_set_addr(t, i, r + RXB_OFF + i * BUFSZ)
        d_set_dw1(t, i, 0)
        var f: u64 = D_OWN | BUFSZ
        if i == RING_SLOTS - 1 {
            f = f | D_EOR
        }
        d_set_dw0(t, i, f)
        i = i + 1
    }
    arch.barrier_write()
    w32(state, u, R_RDSAR, t & 0xFFFFFFFF)
    w32(state, u, R_RDSAR + 4, (t >> 32) & 0xFFFFFFFF)
    kstate.set(state, sc(u, S_RX_CUR), 0)
}

fn rx_take_on(state: u64, u: u64, frame: *mut u64, slot: *mut u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    let r: u64 = ring(state, u)
    let t: u64 = r + RXD_OFF
    let cur: u64 = kstate.get(state, sc(u, S_RX_CUR))
    let dw0: u64 = d_dw0(t, cur)
    if (dw0 & D_OWN) != 0 {
        return 0
    }
    arch.barrier_read()
    kstate.set(state, sc(u, S_RX_CUR), (cur + 1) % RING_SLOTS)

    let raw: u64 = dw0 & D_LEN
    if (dw0 & D_RES) != 0 || (dw0 & D_FS) == 0 || (dw0 & D_LS) == 0 {
        kstate.add(state, sc(u, S_RXERR), 1)
        rx_recycle_on(state, u, cur)
        return 0
    }
    if raw <= 4 || raw > BUFSZ {
        kstate.add(state, sc(u, S_RXERR), 1)
        rx_recycle_on(state, u, cur)
        return 0
    }
    let len: u64 = raw - 4
    *frame = r + RXB_OFF + cur * BUFSZ
    *slot = cur
    kstate.add(state, sc(u, S_RXP), 1)
    kstate.add(state, sc(u, S_RXB), len)
    return len
}

fn rx_recycle_on(state: u64, u: u64, id: u64) {
    if id >= RING_SLOTS {
        return
    }
    let r: u64 = ring(state, u)
    let t: u64 = r + RXD_OFF
    d_set_addr(t, id, r + RXB_OFF + id * BUFSZ)
    d_set_dw1(t, id, 0)
    var f: u64 = D_OWN | BUFSZ
    if id == RING_SLOTS - 1 {
        f = f | D_EOR
    }
    arch.barrier_write()
    d_set_dw0(t, id, f)
}

// -------------------------------------------------------- der Sendering

fn tx_setup(state: u64, u: u64) {
    let r: u64 = ring(state, u)
    let t: u64 = r + TXD_OFF
    var i: u64 = 0
    while i < RING_SLOTS {
        d_set_addr(t, i, r + TXB_OFF + i * BUFSZ)
        d_set_dw1(t, i, 0)
        var f: u64 = 0
        if i == RING_SLOTS - 1 {
            f = D_EOR
        }
        d_set_dw0(t, i, f)
        i = i + 1
    }
    arch.barrier_write()
    w32(state, u, R_TNPDS, t & 0xFFFFFFFF)
    w32(state, u, R_TNPDS + 4, (t >> 32) & 0xFFFFFFFF)
    kstate.set(state, sc(u, S_TX_CUR), 0)
    kstate.set(state, sc(u, S_TX_CLEAN), 0)
}

fn tx_reclaim(state: u64, u: u64) {
    let t: u64 = ring(state, u) + TXD_OFF
    var clean: u64 = kstate.get(state, sc(u, S_TX_CLEAN))
    let cur: u64 = kstate.get(state, sc(u, S_TX_CUR))
    var going: bool = clean != cur
    while going {
        if (d_dw0(t, clean) & D_OWN) != 0 {
            going = false
        } else {
            clean = (clean + 1) % RING_SLOTS
            going = clean != cur
        }
    }
    kstate.set(state, sc(u, S_TX_CLEAN), clean)
}

fn tx_room_on(state: u64, u: u64) -> u64 {
    if !ready_on(state, u) {
        return 0
    }
    tx_reclaim(state, u)
    let clean: u64 = kstate.get(state, sc(u, S_TX_CLEAN))
    let cur: u64 = kstate.get(state, sc(u, S_TX_CUR))
    var inflight: u64 = 0
    if cur >= clean {
        inflight = cur - clean
    } else {
        inflight = RING_SLOTS - clean + cur
    }
    if inflight + 1 >= RING_SLOTS {
        return 0
    }
    return RING_SLOTS - 1 - inflight
}

// ---------------------------------------- das Unterbrechungsregister
fn set_imr(state: u64, u: u64, mask: u64) {
    if var_of(state, u) == VAR_8125 {
        w32(state, u, R_IMR25, mask)
        return
    }
    w16(state, u, R_IMR, mask)
}

fn get_isr(state: u64, u: u64) -> u64 {
    if var_of(state, u) == VAR_8125 {
        return r32(state, u, R_ISR25)
    }
    return r16(state, u, R_ISR)
}

fn ack_isr(state: u64, u: u64, cause: u64) {
    if var_of(state, u) == VAR_8125 {
        w32(state, u, R_ISR25, cause)
        return
    }
    w16(state, u, R_ISR, cause)
}

fn ack_all(state: u64, u: u64) {
    if var_of(state, u) == VAR_8125 {
        w32(state, u, R_ISR25, 4294967295)
        return
    }
    w16(state, u, R_ISR, 0xFFFF)
}

fn ocp_read(state: u64, u: u64, reg: u64) -> u64 {
    w32(state, u, R_OCPDR, (reg << 15) & 0xFFFFFFFF)
    return r32(state, u, R_OCPDR) & 0xFFFF
}

fn ocp_write(state: u64, u: u64, reg: u64, val: u64) {
    w32(state, u, R_OCPDR,
        (OCP_FLAG | ((reg << 15) & 0x7FFF0000) | (val & 0xFFFF)) & 0xFFFFFFFF)
}

fn tx_kick(state: u64, u: u64) {
    let v: u64 = var_of(state, u)
    if v == VAR_CP {
        w8(state, u, R_TPPOLL39, 64) // NPQ, Bit 6
        return
    }
    if v == VAR_8125 {
        w16(state, u, R_TPPOLL25, TPPOLL25_GO)
        return
    }
    w8(state, u, R_TPPOLL69, 64)
}

fn tx_frame_on(state: u64, u: u64, src: u64, n: u64) -> bool {
    if !ready_on(state, u) || n == 0 {
        return false
    }
    if n > BUFSZ {
        kstate.add(state, sc(u, S_OVERLEN), 1)
        return false
    }
    if tx_room_on(state, u) == 0 {
        kstate.add(state, sc(u, S_TXDROP), 1)
        return false
    }
    let r: u64 = ring(state, u)
    let t: u64 = r + TXD_OFF
    let id: u64 = kstate.get(state, sc(u, S_TX_CUR)) % RING_SLOTS
    let buf: u64 = r + TXB_OFF + id * BUFSZ
    var k: u64 = 0
    while k < n {
        __mmio_write8((buf + k) as *mut u8, __mmio_read8((src + k) as *mut u8))
        k = k + 1
    }
    var pad: u64 = n
    while pad < 60 {
        __mmio_write8((buf + pad) as *mut u8, 0 as u8)
        pad = pad + 1
    }
    var len: u64 = n
    if len < 60 {
        len = 60
    }
    d_set_addr(t, id, buf)
    d_set_dw1(t, id, 0)
    var f: u64 = D_OWN | D_FS | D_LS | (len & D_LEN)
    if id == RING_SLOTS - 1 {
        f = f | D_EOR
    }
    arch.barrier_write()
    d_set_dw0(t, id, f)
    arch.barrier_write()
    kstate.set(state, sc(u, S_TX_CUR), (id + 1) % RING_SLOTS)
    tx_kick(state, u)
    kstate.add(state, sc(u, S_TXP), 1)
    kstate.add(state, sc(u, S_TXB), n)
    return true
}

// ------------------------------------------------------- die Unterbrechung

fn irq_on(state: u64, u: u64) {
    if !present_on(state, u) {
        return
    }
    kstate.add(state, sc(u, S_IRQS), 1)
    let cause: u64 = get_isr(state, u)
    kstate.set(state, sc(u, S_LASTISR), cause)
    if cause != 0 {
        ack_isr(state, u, cause)
    }
    if (cause & I_LINKCHG) != 0 {
        read_link(state, u)
    }
    if (cause & I_RXOVW) != 0 || (cause & I_FOVW) != 0 {
        kstate.add(state, sc(u, S_RXOVW), 1)
    }
}

fn poll_on(state: u64, u: u64) -> bool {
    if !ready_on(state, u) {
        return false
    }
    let t: u64 = ring(state, u) + RXD_OFF
    let cur: u64 = kstate.get(state, sc(u, S_RX_CUR))
    return (d_dw0(t, cur) & D_OWN) == 0
}

// ---------------------------------------------------- den Vektor scharfmachen

fn intx_arm(state: u64, u: u64, i: u64, armed: bool, vec: u64) {
    let d: u64 = pci.get(state, i, pci.E_BDF)
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) & 0xFBFF)
    if vec == 0 {
        return
    }
    let gsi: u64 = pci.get(state, i, pci.E_IRQLINE)
    if gsi == 0 || gsi > 23 {
        return
    }
    apic.route(state, gsi, vec, apic.id(state), true, true)
    if !armed {
        apic.mask_gsi(state, gsi)
    }
}

fn shut_down_on(state: u64, u: u64) {
    if !present_on(state, u) {
        return
    }
    set_imr(state, u, 0)
    ack_all(state, u)
    w8(state, u, R_CR, 0)
    kstate.set(state, sc(u, S_READY), 0)
    pci.disable_master(bdf_on(state, u))
}

// ==================================================== DIE SELBSTPRUEFUNG
fn selftest_on(state: u64, u: u64) {
    var s_head: [u8; 13] = "r8169: self \0"
    var s_fit: [u8; 6] = "fit=\0\0"
    var s_drop: [u8; 7] = " drop=\0"
    var s_over: [u8; 7] = " over=\0"
    var s_lnk: [u8; 7] = " link=\0"
    var s_lch: [u8; 8] = " lchg=\0\0"
    var s_rerr: [u8; 8] = " rerr=\0\0"
    var s_ovw: [u8; 7] = " ovw=\0\0"
    var s_slots: [u8; 9] = " slots=\0\0"
    var payload: [u8; 64] = [0 as u8; 64]

    if !ready_on(state, u) {
        return
    }
    var q: u64 = 0
    while q < 6 {
        payload[q as usize] = mac_at_on(state, u, q) as u8
        payload[(q + 6) as usize] = mac_at_on(state, u, q) as u8
        q = q + 1
    }
    payload[12 as usize] = 136 as u8
    payload[13 as usize] = 181 as u8

    let drop0: u64 = kstate.get(state, sc(u, S_TXDROP))
    let over0: u64 = kstate.get(state, sc(u, S_OVERLEN))

    w8(state, u, R_CR, CR_RE)
    var fit: u64 = 0
    var tries: u64 = 0
    while tries < RING_SLOTS + 8 {
        if tx_frame_on(state, u, (&payload[0]) as u64, 64) {
            fit = fit + 1
        }
        tries = tries + 1
    }
    let big: bool = tx_frame_on(state, u, (&payload[0]) as u64, BUFSZ + 1)

    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_fit[0]) as u64)
    serial.dec(fit)
    serial.puts((&s_drop[0]) as u64)
    serial.dec(kstate.get(state, sc(u, S_TXDROP)) - drop0)
    serial.puts((&s_over[0]) as u64)
    serial.dec(kstate.get(state, sc(u, S_OVERLEN)) - over0)
    serial.puts((&s_lnk[0]) as u64)
    serial.dec(kstate.get(state, sc(u, S_LINK)))
    serial.puts((&s_lch[0]) as u64)
    serial.dec(kstate.get(state, sc(u, S_LINKCH)))
    serial.puts((&s_rerr[0]) as u64)
    serial.dec(kstate.get(state, sc(u, S_RXERR)))
    serial.puts((&s_ovw[0]) as u64)
    serial.dec(kstate.get(state, sc(u, S_RXOVW)))
    serial.puts((&s_slots[0]) as u64)
    serial.dec(RING_SLOTS)
    serial.nl()

    kstate.set(state, sc(u, S_TXP), 0)
    kstate.set(state, sc(u, S_TXB), 0)
    tx_setup(state, u)
    w8(state, u, R_CR, CR_TE | CR_RE)
}

fn print_regs_on(state: u64, u: u64) {
    var s_h: [u8; 13] = "r8169: reg \0\0"
    var s_var: [u8; 5] = "var=\0"
    var s_rev: [u8; 7] = " rev=\0\0"
    var s_bar: [u8; 7] = " bar=\0\0"
    var s_cr: [u8; 6] = " cr=\0\0"
    var s_cp: [u8; 9] = " cpcmd=\0\0"
    var s_rcr: [u8; 7] = " rcr=\0\0"
    var s_isr: [u8; 7] = " isr=\0\0"
    var s_msr: [u8; 7] = " msr=\0\0"
    var s_phy: [u8; 10] = " physta=\0\0"
    if !present_on(state, u) {
        return
    }
    serial.puts((&s_h[0]) as u64)
    serial.puts((&s_var[0]) as u64)
    serial.dec(var_of(state, u))
    serial.puts((&s_rev[0]) as u64)
    serial.hex(kstate.get(state, sc(u, S_REV)))
    serial.puts((&s_bar[0]) as u64)
    serial.dec(kstate.get(state, sc(u, S_BARN)))
    serial.puts((&s_cr[0]) as u64)
    serial.hex(r8(state, u, R_CR))
    serial.puts((&s_cp[0]) as u64)
    serial.hex(r16(state, u, R_CPCMD))
    serial.puts((&s_rcr[0]) as u64)
    serial.hex(r32(state, u, R_RCR))
    serial.puts((&s_isr[0]) as u64)
    serial.hex(get_isr(state, u))
    if var_of(state, u) == VAR_CP {
        serial.puts((&s_msr[0]) as u64)
        serial.hex(r8(state, u, R_MSR))
    } else {
        serial.puts((&s_phy[0]) as u64)
        serial.hex(r8(state, u, R_PHYSTAT))
    }
    if var_of(state, u) == VAR_8125 {
        var s_ung: [u8; 38] = "  8125: from the source, NOT measured\0"
        serial.puts((&s_ung[0]) as u64)
    }
    serial.nl()
}
