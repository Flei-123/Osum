profile kernel

import net.wlan_net
import drv.net.netclass

export { ops }

fn init_ready(state: u64, u: u64, use_msix: bool, armed: bool, vec: u64) -> bool {
    return wlan_net.ready_on(state, u)
}

fn ops() -> netclass.EthOps {
    var o: netclass.EthOps = netclass.null_ops()
    o.present = wlan_net.present_on
    o.ready = wlan_net.ready_on
    o.up = wlan_net.up_on
    o.rx_frames = wlan_net.rx_frames_on
    o.tx_frames = wlan_net.tx_frames_on
    o.tx_drops = wlan_net.tx_drops_on
    o.rx_octets = wlan_net.rx_octets_on
    o.tx_octets = wlan_net.tx_octets_on
    o.mac_at = wlan_net.mac_at_on
    o.rx_take = wlan_net.rx_take_on
    o.rx_recycle = wlan_net.rx_recycle_on
    o.tx_room = wlan_net.tx_room_on
    o.tx_frame = wlan_net.tx_frame_on
    o.poll = wlan_net.poll_on
    o.init = init_ready
    o.caps = netclass.CAP_POLL_ONLY
    o.tag = 0x6e616c77
    return o
}
