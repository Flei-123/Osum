profile kernel

import lib.kstate
import wlan.iwl_probe
import wlan.iwl_cmdq
import wlan.iwl_pwr
import wlan.iwl_boot
import wlan.iwl_le
import wlan.iwl_mvm_txq
import wlan.iwl_fwcaps
import wlan.iwl_fwerr

export { XCtx, xp_last_cmd, xp_last_len, xp_last_w0, xp_last_err, xp_sent, xp_fw_dead, xp_uerr_ptr, xp_fwerr, xp_umac, xp_capture, xp_words, xctx_new, xctx_fast, xport_make, tr_submit, tr_poll, E_XP_NOCQ }

const E_XP_NOCQ: i64 = -80
const PEND_CAP: u64 = 4096
const ACCESS_TRIES: u64 = 3
const RECV_BUDGET_MS: u64 = 250
const RECV_SPIN_MAX: u64 = 400000
const FAST_BUDGET_MS: u64 = 20
const FAST_SPIN_MAX: u64 = 2000

struct XCtx {
    state: u64,
    cq: u64,
    p: u64,
    pend: u64,
    pend_len: u64,
    last_err: i64,
    last_cmd: u64,
    last_len: u64,
    last_w0: u64,
    sent: u64,
    budget_ms: u64,
    spin_max: u64,
    fe: iwl_fwerr.FwErr,
    fu: iwl_fwerr.FwErr
}

fn xctx_new(state: u64, cq: u64, p: u64, pend: u64) -> XCtx {
    var x: XCtx = XCtx { state: state, cq: cq, p: p, pend: pend, pend_len: 0, last_err: 0, last_cmd: 0, last_len: 0, last_w0: 0, sent: 0, budget_ms: RECV_BUDGET_MS, spin_max: RECV_SPIN_MAX, fe: iwl_fwerr.fwerr_new(), fu: iwl_fwerr.fwerr_new() }
    return x
}

fn xctx_fast(x: *mut XCtx) {
    (*x).budget_ms = FAST_BUDGET_MS
    (*x).spin_max = FAST_SPIN_MAX
}

fn xp_now(ctx: u64) -> u64 {
    let x: *mut XCtx = ctx as *mut XCtx
    return kstate.get((*x).state, kstate.TICKS) * 10
}

fn xp_send(ctx: u64, a: u64, n: u64) -> i64 {
    let x: *mut XCtx = ctx as *mut XCtx
    if (*x).cq == 0 { return E_XP_NOCQ }
    (*x).pend_len = 0
    (*x).sent = (*x).sent + 1
    (*x).last_cmd = iwl_le.ld8(a, 0)
    (*x).last_len = 0
    (*x).last_w0 = 0
    let cq: *mut iwl_cmdq.Cq = (*x).cq as *mut iwl_cmdq.Cq
    if iwl_le.ld8(a, 0) == iwl_cmdq.CMD_TX_DATA && iwl_cmdq.cq_dq_on(cq) {
        let d: i64 = iwl_cmdq.cq_dq_send(cq, (*x).p as *mut iwl_probe.Probe, a, n)
        if d < 0 { (*x).last_err = d }
        return d
    }
    var r: i64 = iwl_cmdq.cq_send((*x).cq as *mut iwl_cmdq.Cq, (*x).p as *mut iwl_probe.Probe, a, n, (*x).pend, PEND_CAP)
    var tries: u64 = 1
    while r == iwl_pwr.E_PWR_ACCESS && tries < ACCESS_TRIES {
        r = iwl_cmdq.cq_send((*x).cq as *mut iwl_cmdq.Cq, (*x).p as *mut iwl_probe.Probe, a, n, (*x).pend, PEND_CAP)
        tries = tries + 1
    }
    if r < 0 {
        xp_capture(x)
        (*x).last_err = r
        return r
    }
    (*x).pend_len = r as u64
    (*x).last_len = r as u64
    if r >= 8 { (*x).last_w0 = iwl_le.ld32((*x).pend, 4) }
    if iwl_le.ld8(a, 0) == iwl_fwcaps.CMD_SCD_QUEUE_CFG { scd_track(cq, a, n) }
    return 0
}

fn xp_capture(x: *mut XCtx) {
    if (*x).cq == 0 || (*x).p == 0 { return }
    let cq: *mut iwl_cmdq.Cq = (*x).cq as *mut iwl_cmdq.Cq
    if iwl_fwerr.fwerr_count(&(*x).fe) == 0 {
        let _a: bool = iwl_fwerr.fwerr_capture((*x).p as *mut iwl_probe.Probe, iwl_cmdq.cq_err_ptr(cq), &(*x).fe)
    }
    if iwl_fwerr.fwerr_count(&(*x).fu) == 0 {
        let _b: bool = iwl_fwerr.fwerr_capture_umac((*x).p as *mut iwl_probe.Probe, iwl_cmdq.cq_uerr_ptr(cq), &(*x).fu)
    }
}

fn xp_words(e: *mut iwl_fwerr.FwErr, out: u64) {
    var i: u64 = 0
    while i < 7 {
        *((out + i * 8) as *mut u64) = iwl_fwerr.fwerr_word(e, i)
        i = i + 1
    }
}

fn scd_track(cq: *mut iwl_cmdq.Cq, a: u64, n: u64) {
    if n != iwl_mvm_txq.SCD_CFG_LEN { return }
    let h: u64 = 4
    if iwl_le.ld8(a, h + 3) != iwl_mvm_txq.DATA_QUEUE { return }
    if iwl_le.ld8(a, h + 4) == iwl_mvm_txq.SCD_ACTION_ENABLE {
        iwl_cmdq.cq_dq_enable(cq, iwl_le.ld16(a, h + 8))
    } else {
        iwl_cmdq.cq_dq_disable(cq)
    }
}

fn xp_recv(ctx: u64, a: u64, n: u64) -> i64 {
    let x: *mut XCtx = ctx as *mut XCtx
    if (*x).cq == 0 { return E_XP_NOCQ }
    if (*x).pend_len != 0 {
        var m: u64 = (*x).pend_len
        if m > n { m = n }
        iwl_le.copy(a, (*x).pend, m)
        (*x).pend_len = 0
        return m as i64
    }
    let t0: u64 = xp_now(ctx)
    var spins: u64 = 0
    while spins < (*x).spin_max {
        let r: i64 = iwl_cmdq.cq_poll((*x).cq as *mut iwl_cmdq.Cq, (*x).p as *mut iwl_probe.Probe, a, n)
        if r != 0 { return r }
        if xp_now(ctx) - t0 >= (*x).budget_ms { return 0 }
        spins = spins + 1
    }
    return 0
}

fn xport_make(x: *mut XCtx) -> iwl_boot.Xport {
    var t: iwl_boot.Xport = iwl_boot.Xport { present: 1, ctx: x as u64, send: xp_send, recv: xp_recv, now: xp_now }
    return t
}

fn tr_submit(ctx: u64, a: u64, n: usize) -> i64 { return xp_send(ctx, a, n as u64) }

fn tr_poll(ctx: u64, a: u64, n: usize) -> i64 { return xp_recv(ctx, a, n as u64) }


fn xp_last_cmd(x: *mut XCtx) -> u64 { return (*x).last_cmd }
fn xp_last_len(x: *mut XCtx) -> u64 { return (*x).last_len }
fn xp_last_w0(x: *mut XCtx) -> u64 { return (*x).last_w0 }
fn xp_last_err(x: *mut XCtx) -> i64 { return (*x).last_err }
fn xp_sent(x: *mut XCtx) -> u64 { return (*x).sent }
fn xp_fw_dead(x: *mut XCtx) -> u64 {
    if (*x).cq == 0 { return 0 }
    return iwl_cmdq.cq_fw_dead((*x).cq as *mut iwl_cmdq.Cq)
}
fn xp_uerr_ptr(x: *mut XCtx) -> u64 {
    if (*x).cq == 0 { return 0 }
    return iwl_cmdq.cq_uerr_ptr((*x).cq as *mut iwl_cmdq.Cq)
}
fn xp_fwerr(x: *mut XCtx) -> *mut iwl_fwerr.FwErr { return &(*x).fe }
fn xp_umac(x: *mut XCtx) -> *mut iwl_fwerr.FwErr { return &(*x).fu }
