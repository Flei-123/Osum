profile kernel

import drv.net.e1000
import drv.net.netclass

export { ops }

fn ops() -> netclass.EthOps {
    var o: netclass.EthOps = netclass.null_ops()
    o.present = e1000.present_on
    o.ready = e1000.ready_on
    o.up = e1000.up_on
    o.init = e1000.init_on
    o.bdf = e1000.bdf_on
    o.idx = e1000.idx_on
    o.irqs = e1000.irqs_on
    o.rx_frames = e1000.rx_frames_on
    o.tx_frames = e1000.tx_frames_on
    o.tx_drops = e1000.tx_drops_on
    o.rx_octets = e1000.rx_octets_on
    o.tx_octets = e1000.tx_octets_on
    o.features = e1000.features_on
    o.queue_size = e1000.queue_size_on
    o.notified = e1000.notified_on
    o.link_speed = e1000.link_speed_on
    o.tx_room = e1000.tx_room_on
    o.msix = e1000.msix_on
    o.link_up = e1000.link_up_on
    o.mac_at = e1000.mac_at_on
    o.rx_take = e1000.rx_take_on
    o.rx_recycle = e1000.rx_recycle_on
    o.tx_frame = e1000.tx_frame_on
    o.poll = e1000.poll_on
    o.irq = e1000.irq_on
    o.shut_down = e1000.shut_down_on
    o.irq_mode = e1000.irq_mode_on
    o.hwstat = e1000.hwstat_on
    o.kill = e1000.kill_on
    o.resume = e1000.resume_on
    o.caps = netclass.CAP_MSIX | netclass.CAP_SPEED | netclass.CAP_HWSTAT | netclass.CAP_SUSPEND
    o.tag = 0x3030303165
    return o
}
