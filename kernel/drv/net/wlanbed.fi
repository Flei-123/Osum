profile kernel

export {
    bind_slot, installed, fh_test, mmio_region, mmio_rd, mmio_wr, wifi_hw,
    SLOT_FH_TEST, SLOT_MMIO_REGION, SLOT_MMIO_RD, SLOT_MMIO_WR, SLOT_WIFI_HW
}

const SLOT_FH_TEST: u64 = 0
const SLOT_MMIO_REGION: u64 = 1
const SLOT_MMIO_RD: u64 = 2
const SLOT_MMIO_WR: u64 = 3
const SLOT_WIFI_HW: u64 = 4
const SLOT_COUNT: u64 = 5
const READ_ABSENT: u64 = 0xFFFFFFFF

static mut table: [u64; 5] = [0 as u64; 5]

fn bind_slot(slot: u64, handler: u64) {
    if slot < SLOT_COUNT {
        table[slot as usize] = handler
    }
}

fn handler(slot: u64) -> u64 {
    return table[slot as usize]
}

fn installed(slot: u64) -> bool {
    return slot < SLOT_COUNT && table[slot as usize] != 0
}

fn fh_test(state: u64, blob: u64, info: u64) {
    if !installed(SLOT_FH_TEST) { return }
    let call: fn(u64, u64, u64) -> u64 = handler(SLOT_FH_TEST) as fn(u64, u64, u64) -> u64
    call(state, blob, info)
}

fn mmio_region(state: u64) -> u64 {
    if !installed(SLOT_MMIO_REGION) { return 0 }
    let call: fn(u64) -> u64 = handler(SLOT_MMIO_REGION) as fn(u64) -> u64
    return call(state)
}

fn mmio_rd(off: u64) -> u64 {
    if !installed(SLOT_MMIO_RD) { return READ_ABSENT }
    let call: fn(u64) -> u64 = handler(SLOT_MMIO_RD) as fn(u64) -> u64
    return call(off)
}

fn mmio_wr(off: u64, value: u64) -> u64 {
    if !installed(SLOT_MMIO_WR) { return 0 }
    let call: fn(u64, u64) -> u64 = handler(SLOT_MMIO_WR) as fn(u64, u64) -> u64
    return call(off, value)
}

fn wifi_hw(op: u64, a: u64, b: u64, c: u64) -> u64 {
    if !installed(SLOT_WIFI_HW) { return 0 }
    let call: fn(u64, u64, u64, u64) -> u64 = handler(SLOT_WIFI_HW) as fn(u64, u64, u64, u64) -> u64
    return call(op, a, b, c)
}
