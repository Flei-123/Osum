profile kernel

import serial
import wlan.iwl_le
import wlan.iwl_buf
import wlan.iwl_mvm_scan
import wlan.iwl_fwcaps
import drv.net.iwl_heldcaps

export { check }

const GEN_MULTIPLE_SSID: u64 = 0x40
const FLAG_SSID0: u64 = 1

fn fail(text: u64) -> bool {
    var tag: [u8; 17] = "fakefw: scan bad\0"
    serial.puts((&tag[0]) as u64)
    serial.put(32 as u8)
    serial.puts(text)
    serial.nl()
    return false
}

fn pass(ver: u64, slots: u64, nch: u64) {
    var tag: [u8; 16] = "fakefw: scan ok\0"
    var s_v: [u8; 3] = " v\0"
    var s_s: [u8; 8] = " slots=\0"
    var s_n: [u8; 8] = " nchan=\0"
    serial.puts((&tag[0]) as u64)
    serial.puts((&s_v[0]) as u64)
    serial.dec(ver)
    serial.puts((&s_s[0]) as u64)
    serial.dec(slots)
    serial.puts((&s_n[0]) as u64)
    serial.dec(nch)
    serial.nl()
}

fn check(tb0: u64, total: u64) -> bool {
    var ver: u64 = 1
    var slots: u64 = 0
    if iwl_heldcaps.ready() {
        ver = iwl_fwcaps.caps_get(iwl_heldcaps.fw_words(), iwl_fwcaps.W_SCAN_VER)
        slots = iwl_fwcaps.caps_get(iwl_heldcaps.fw_words(), iwl_fwcaps.W_SCAN_SLOTS)
    }
    let h: u64 = iwl_buf.HDR
    var nch: u64 = iwl_le.ld8(tb0, h + 33)
    if ver >= 7 { nch = iwl_le.ld8(tb0, h + 45) }
    if slots < nch { slots = nch }
    var m_len: [u8; 11] = "bad length\0"
    var m_dw: [u8; 11] = "zero dwell\0"
    var m_ss: [u8; 20] = "ssid bitmap missing\0"
    var m_sc: [u8; 13] = "bad schedule\0"
    var m_ch: [u8; 12] = "bad channel\0"
    if total != iwl_mvm_scan.scan_req_len(ver, slots) { return fail((&m_len[0]) as u64) }
    let head: u64 = iwl_mvm_scan.scan_head_len(ver)
    if ver >= 7 {
        if iwl_le.ld8(tb0, h + 16) == 0 || iwl_le.ld8(tb0, h + 17) == 0 || iwl_le.ld16(tb0, h + 22) == 0 { return fail((&m_dw[0]) as u64) }
    }
    let tail: u64 = head + slots * iwl_mvm_scan.SCAN_CHAN_LEN
    if iwl_le.ld8(tb0, tail + 2) != 1 { return fail((&m_sc[0]) as u64) }
    let ssid_len: u64 = iwl_le.ld8(tb0, tail + 28 + iwl_mvm_scan.SCAN_PROBE_BUF_LEN + 1)
    var i: u64 = 0
    while i < nch {
        let o: u64 = head + i * iwl_mvm_scan.SCAN_CHAN_LEN
        if iwl_le.ld8(tb0, o + 4) == 0 { return fail((&m_ch[0]) as u64) }
        if ver >= 7 && ssid_len != 0 && (iwl_le.ld32(tb0, o) & FLAG_SSID0) == 0 { return fail((&m_ss[0]) as u64) }
        i = i + 1
    }
    pass(ver, slots, nch)
    return true
}
