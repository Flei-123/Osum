profile kernel

import serial
import wlan.iwl_le
import wlan.iwl_buf

export { report }

const CTXT_ADD: u64 = 1
const ACTION_OFF: u64 = 4
const NODE_ADDR_OFF: u64 = 16

fn digit(v: u64) -> u8 {
    if v < 10 { return (48 + v) as u8 }
    return (87 + v) as u8
}

fn report(tb0: u64) {
    let h: u64 = iwl_buf.HDR
    if iwl_le.ld32(tb0, h + ACTION_OFF) != CTXT_ADD { return }
    var tag: [u8; 13] = "fakefw: sta \0"
    serial.puts((&tag[0]) as u64)
    var i: u64 = 0
    while i < 6 {
        let v: u64 = iwl_le.ld8(tb0, h + NODE_ADDR_OFF + i)
        serial.put(digit(v >> 4))
        serial.put(digit(v & 15))
        if i < 5 { serial.put(58 as u8) }
        i = i + 1
    }
    serial.nl()
}
