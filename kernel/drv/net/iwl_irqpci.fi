profile kernel

import bus.pci
import wlan.iwl_irqdiag
import drv.net.iwl_pcipm

export { take, status }

const CFG_STATUS: u64 = 0x06
const CAP_PCIE: u64 = 0x10
const PCIE_DEVCTL: u64 = 0x08
const PCIE_DEVSTA: u64 = 0x0A
const PCIE_LNKCTL: u64 = 0x10
const PCIE_LNKSTA: u64 = 0x12
const CFG_BRIDGE_CTL: u64 = 0x3E

fn status(bdf: u64) -> u64 {
    if bdf == 0 { return 0 }
    return pci.cfg_read16(bdf, CFG_STATUS)
}

fn pcie_word(bdf: u64, off: u64) -> u64 {
    let cap: u64 = pci.cap_find(bdf, CAP_PCIE)
    if cap == 0 { return 0 }
    return pci.cfg_read16(bdf, cap + off)
}

fn cap_ctrl(bdf: u64, id: u64) -> u64 {
    let cap: u64 = pci.cap_find(bdf, id)
    if cap == 0 { return 0 }
    return pci.cfg_read16(bdf, cap + 2)
}

fn take(bdf: u64, out: u64) {
    if bdf == 0 { return }
    iwl_irqdiag.put(out, iwl_irqdiag.W_PCI_VALID, 1)
    iwl_irqdiag.put(out, iwl_irqdiag.W_PCMD, pci.cfg_read16(bdf, 0x04))
    iwl_irqdiag.put(out, iwl_irqdiag.W_PSTS, pci.cfg_read16(bdf, CFG_STATUS))
    iwl_irqdiag.put(out, iwl_irqdiag.W_PLINE, pci.cfg_read8(bdf, 0x3C))
    iwl_irqdiag.put(out, iwl_irqdiag.W_PPIN, pci.cfg_read8(bdf, 0x3D))
    iwl_irqdiag.put(out, iwl_irqdiag.W_PMSI, cap_ctrl(bdf, pci.CAP_MSI))
    iwl_irqdiag.put(out, iwl_irqdiag.W_PMSIX, cap_ctrl(bdf, pci.CAP_MSIX))
    iwl_irqdiag.put(out, iwl_irqdiag.W_PDEVCTL, pcie_word(bdf, PCIE_DEVCTL))
    iwl_irqdiag.put(out, iwl_irqdiag.W_PDEVSTA, pcie_word(bdf, PCIE_DEVSTA))
    iwl_irqdiag.put(out, iwl_irqdiag.W_PLNKCTL, pcie_word(bdf, PCIE_LNKCTL))
    iwl_irqdiag.put(out, iwl_irqdiag.W_PLNKSTA, pcie_word(bdf, PCIE_LNKSTA))
    let rp: u64 = iwl_pcipm.find_parent(bdf)
    iwl_irqdiag.put(out, iwl_irqdiag.W_RP_BDF, rp)
    if rp != 0 {
        iwl_irqdiag.put(out, iwl_irqdiag.W_RP_CMD, pci.cfg_read16(rp, 0x04))
        iwl_irqdiag.put(out, iwl_irqdiag.W_RP_STS, pci.cfg_read16(rp, CFG_STATUS))
        iwl_irqdiag.put(out, iwl_irqdiag.W_RP_BCTL, pci.cfg_read16(rp, CFG_BRIDGE_CTL))
        iwl_irqdiag.put(out, iwl_irqdiag.W_RP_LNKCTL, pcie_word(rp, PCIE_LNKCTL))
        iwl_irqdiag.put(out, iwl_irqdiag.W_RP_DEVSTA, pcie_word(rp, PCIE_DEVSTA))
    }
}
