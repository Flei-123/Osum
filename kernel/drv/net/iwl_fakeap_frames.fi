profile kernel

import wlan.iwl_le
import wlan.llc

export {
    net_count, net_secure, net_channel, net_energy, net_ssid_len, bssid_set, beacon_build, auth_reply_build,
    assoc_reply_build, data_head_from_ds, rsn_ie, dhcp_reply_build, copy6, same6, arp_reply_build, icmp_reply_build, ICMP_MAX,
    AP_IP, LEASE_IP, LEASE_MASK, PASS_LEN, pass_ptr, ssid_ptr, RSN_IE_LEN, GTK_KDE_LEN
}

const AP_IP: u64 = 0xC0A84D01
const LEASE_IP: u64 = 0xC0A84D32
const LEASE_MASK: u64 = 0xFFFFFF00
const LEASE_SECS: u64 = 3600
const RSN_IE_LEN: u64 = 22
const GTK_KDE_LEN: u64 = 26
const PASS_LEN: u64 = 15
const NETS: u64 = 3

static mut fr_ssid0: [u8; 11] = "OrientFake\0"
static mut fr_ssid1: [u8; 9] = "CafeOpen\0"
static mut fr_ssid2: [u8; 10] = "Neighbor5\0"
static mut fr_pass: [u8; 16] = "orient-fake-pw1\0"

fn net_count() -> u64 { return NETS }

fn net_secure(i: u64) -> bool { return i != 1 }

fn net_channel(i: u64) -> u64 {
    if i == 0 { return 6 }
    if i == 1 { return 1 }
    return 11
}

fn net_energy(i: u64) -> u64 {
    if i == 0 { return 48 }
    if i == 1 { return 67 }
    return 80
}

fn net_ssid_len(i: u64) -> u64 {
    if i == 0 { return 10 }
    if i == 1 { return 8 }
    return 9
}

fn ssid_ptr(i: u64) -> u64 {
    if i == 0 { return (&fr_ssid0[0]) as u64 }
    if i == 1 { return (&fr_ssid1[0]) as u64 }
    return (&fr_ssid2[0]) as u64
}

fn pass_ptr() -> u64 { return (&fr_pass[0]) as u64 }

fn copy6(dst: u64, doff: u64, src: u64, soff: u64) {
    var i: u64 = 0
    while i < 6 {
        iwl_le.st8(dst, doff + i, iwl_le.ld8(src, soff + i))
        i = i + 1
    }
}

fn same6(a: u64, aoff: u64, b: u64, boff: u64) -> bool {
    var i: u64 = 0
    while i < 6 {
        if iwl_le.ld8(a, aoff + i) != iwl_le.ld8(b, boff + i) { return false }
        i = i + 1
    }
    return true
}

fn bssid_set(i: u64, dst: u64) {
    iwl_le.st8(dst, 0, 0x02)
    iwl_le.st8(dst, 1, 0x46)
    iwl_le.st8(dst, 2, 0x41)
    iwl_le.st8(dst, 3, 0x4B)
    iwl_le.st8(dst, 4, 0x45)
    iwl_le.st8(dst, 5, 1 + i)
}

fn rsn_ie(out: u64, at: u64) -> u64 {
    iwl_le.st8(out, at, 0x30)
    iwl_le.st8(out, at + 1, 20)
    iwl_le.st16(out, at + 2, 1)
    iwl_le.st8(out, at + 4, 0x00)
    iwl_le.st8(out, at + 5, 0x0F)
    iwl_le.st8(out, at + 6, 0xAC)
    iwl_le.st8(out, at + 7, 4)
    iwl_le.st16(out, at + 8, 1)
    iwl_le.st8(out, at + 10, 0x00)
    iwl_le.st8(out, at + 11, 0x0F)
    iwl_le.st8(out, at + 12, 0xAC)
    iwl_le.st8(out, at + 13, 4)
    iwl_le.st16(out, at + 14, 1)
    iwl_le.st8(out, at + 16, 0x00)
    iwl_le.st8(out, at + 17, 0x0F)
    iwl_le.st8(out, at + 18, 0xAC)
    iwl_le.st8(out, at + 19, 2)
    iwl_le.st16(out, at + 20, 0)
    return at + RSN_IE_LEN
}

fn rates_ie(out: u64, at: u64) -> u64 {
    iwl_le.st8(out, at, 1)
    iwl_le.st8(out, at + 1, 4)
    iwl_le.st8(out, at + 2, 0x82)
    iwl_le.st8(out, at + 3, 0x84)
    iwl_le.st8(out, at + 4, 0x8B)
    iwl_le.st8(out, at + 5, 0x96)
    return at + 6
}

fn beacon_build(i: u64, out: u64) -> u64 {
    iwl_le.zero(out, 36)
    iwl_le.st8(out, 0, 0x80)
    var k: u64 = 0
    while k < 6 {
        iwl_le.st8(out, 4 + k, 0xFF)
        k = k + 1
    }
    bssid_set(i, out + 10)
    bssid_set(i, out + 16)
    iwl_le.st16(out, 32, 100)
    var caps: u64 = 0x0001
    if net_secure(i) { caps = 0x0011 }
    iwl_le.st16(out, 34, caps)
    var at: u64 = 36
    let sl: u64 = net_ssid_len(i)
    iwl_le.st8(out, at, 0)
    iwl_le.st8(out, at + 1, sl)
    iwl_le.copy(out + at + 2, ssid_ptr(i), sl)
    at = at + 2 + sl
    at = rates_ie(out, at)
    iwl_le.st8(out, at, 3)
    iwl_le.st8(out, at + 1, 1)
    iwl_le.st8(out, at + 2, net_channel(i))
    at = at + 3
    if net_secure(i) { at = rsn_ie(out, at) }
    return at
}

fn mgmt_reply_head(out: u64, fc0: u64, sta: u64, bssid: u64) {
    iwl_le.zero(out, 24)
    iwl_le.st8(out, 0, fc0)
    copy6(out, 4, sta, 0)
    copy6(out, 10, bssid, 0)
    copy6(out, 16, bssid, 0)
}

fn auth_reply_build(out: u64, sta: u64, bssid: u64) -> u64 {
    mgmt_reply_head(out, 0xB0, sta, bssid)
    iwl_le.st16(out, 24, 0)
    iwl_le.st16(out, 26, 2)
    iwl_le.st16(out, 28, 0)
    return 30
}

fn assoc_reply_build(out: u64, sta: u64, bssid: u64) -> u64 {
    mgmt_reply_head(out, 0x10, sta, bssid)
    iwl_le.st16(out, 24, 0x0011)
    iwl_le.st16(out, 26, 0)
    iwl_le.st16(out, 28, 0xC001)
    return rates_ie(out, 30)
}

fn data_head_from_ds(out: u64, sta: u64, bssid: u64) -> u64 {
    iwl_le.zero(out, 24)
    iwl_le.st8(out, 0, 0x08)
    iwl_le.st8(out, 1, 0x02)
    copy6(out, 4, sta, 0)
    copy6(out, 10, bssid, 0)
    copy6(out, 16, bssid, 0)
    return 24
}

fn put_be32(out: u64, at: u64, v: u64) {
    iwl_le.st8(out, at, v >> 24)
    iwl_le.st8(out, at + 1, v >> 16)
    iwl_le.st8(out, at + 2, v >> 8)
    iwl_le.st8(out, at + 3, v)
}

fn put_opt4(out: u64, at: u64, code: u64, v: u64) -> u64 {
    iwl_le.st8(out, at, code)
    iwl_le.st8(out, at + 1, 4)
    put_be32(out, at + 2, v)
    return at + 6
}

fn dhcp_reply_build(out: u64, kind: u64, xid: u64, chaddr: u64) -> u64 {
    iwl_le.zero(out, 240)
    iwl_le.st8(out, 0, 2)
    iwl_le.st8(out, 1, 1)
    iwl_le.st8(out, 2, 6)
    put_be32(out, 4, xid)
    put_be32(out, 16, LEASE_IP)
    put_be32(out, 20, AP_IP)
    copy6(out, 28, chaddr, 0)
    iwl_le.st8(out, 236, 99)
    iwl_le.st8(out, 237, 130)
    iwl_le.st8(out, 238, 83)
    iwl_le.st8(out, 239, 99)
    var at: u64 = 240
    iwl_le.st8(out, at, llc.O_ART)
    iwl_le.st8(out, at + 1, 1)
    iwl_le.st8(out, at + 2, kind)
    at = at + 3
    at = put_opt4(out, at, llc.O_SERVER, AP_IP)
    at = put_opt4(out, at, llc.O_MIETE, LEASE_SECS)
    at = put_opt4(out, at, llc.O_MASKE, LEASE_MASK)
    at = put_opt4(out, at, llc.O_TOR, AP_IP)
    at = put_opt4(out, at, llc.O_DNS, AP_IP)
    iwl_le.st8(out, at, llc.O_ENDE)
    return at + 1
}

const ICMP_MAX: u64 = 400

fn put16(out: u64, at: u64, v: u64) {
    iwl_le.st8(out, at, v >> 8)
    iwl_le.st8(out, at + 1, v)
}

fn arp_reply_build(out: u64, sta: u64, bssid: u64, req_ip: u64) -> u64 {
    let hl: u64 = data_head_from_ds(out, sta, bssid)
    llc.snap_build(out + hl, llc.ET_ARP)
    let a: u64 = out + hl + 8
    put16(a, 0, 1)
    put16(a, 2, 0x0800)
    iwl_le.st8(a, 4, 6)
    iwl_le.st8(a, 5, 4)
    put16(a, 6, 2)
    copy6(a, 8, bssid, 0)
    put_be32(a, 14, AP_IP)
    copy6(a, 18, sta, 0)
    put_be32(a, 24, req_ip)
    return hl + 8 + 28
}

fn icmp_reply_build(out: u64, sta: u64, bssid: u64, dst_ip: u64, req: u64, n: u64) -> u64 {
    let hl: u64 = data_head_from_ds(out, sta, bssid)
    llc.snap_build(out + hl, llc.ET_IPV4)
    let ic: u64 = out + hl + 8 + 20
    iwl_le.copy(ic, req, n)
    iwl_le.st8(ic, 0, 0)
    put16(ic, 2, 0)
    put16(ic, 2, llc.sum16(ic, n as usize, 0))
    llc.ipv4_build(out + hl + 8, AP_IP, dst_ip, llc.P_ICMP, n as usize, 9)
    return hl + 8 + 20 + n
}
