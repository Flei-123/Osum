profile kernel

import drv.net.r8169
import drv.net.netclass

export { ops }

fn ops() -> netclass.EthOps {
    return netclass.EthOps {
        present: r8169.present_on,
        ready: r8169.ready_on,
        up: r8169.up_on,
        init: r8169.init_on,
        bdf: r8169.bdf_on,
        idx: r8169.idx_on,
        irqs: r8169.irqs_on,
        rx_frames: r8169.rx_frames_on,
        tx_frames: r8169.tx_frames_on,
        tx_drops: r8169.tx_drops_on,
        rx_octets: r8169.rx_octets_on,
        tx_octets: r8169.tx_octets_on,
        rx_errors: r8169.rx_errors_on,
        oversize: r8169.oversize_on,
        rx_overflow: r8169.rx_overflow_on,
        features: r8169.features_on,
        queue_size: r8169.queue_size_on,
        notified: r8169.notified_on,
        link_speed: r8169.link_speed_on,
        tx_room: r8169.tx_room_on,
        msix: r8169.msix_on,
        link_up: r8169.link_up_on,
        mac_at: r8169.mac_at_on,
        rx_take: r8169.rx_take_on,
        rx_recycle: r8169.rx_recycle_on,
        tx_frame: r8169.tx_frame_on,
        poll: r8169.poll_on,
        irq: r8169.irq_on,
        shut_down: r8169.shut_down_on,
        selftest: r8169.selftest_on,
        print_regs: r8169.print_regs_on,
        caps: netclass.CAP_SPEED,
        tag: 0x3936313872
    }
}
