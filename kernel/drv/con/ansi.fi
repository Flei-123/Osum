
profile kernel

import lib.kstate
import gfx.fb
import gfx.font
import arch.arch

export { echo, feed, active, seqs }

const S_TEXT: u64 = 0
const S_ESC: u64 = 1
const S_CSI: u64 = 2

const AN_PEND: u64 = 0x48

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.K11_OFF + off, v)
}

fn par(state: u64, i: u64) -> u64 {
    return kstate.get(state, kstate.K11_OFF + kstate.AN_PAR + i * 8)
}

fn set_par(state: u64, i: u64, v: u64) {
    kstate.set(state, kstate.K11_OFF + kstate.AN_PAR + i * 8, v)
}

fn par_or(state: u64, i: u64, dflt: u64) -> u64 {
    if i >= g(state, kstate.AN_NPAR) {
        return dflt
    }
    let v: u64 = par(state, i)
    if v == 0 {
        return dflt
    }
    return v
}

fn active(state: u64) -> bool {
    return g(state, kstate.AN_STATE) != S_TEXT
}

fn seqs(state: u64) -> u64 {
    return g(state, kstate.AN_SEQS)
}

fn fg(state: u64) -> u64 {
    return fb.rgb(state, 0xC8, 0xD0, 0xD8)
}

fn bg(state: u64) -> u64 {
    return 0
}

fn apply_color(state: u64) {
    if g(state, kstate.AN_REV) == 1 {
        fb.set_color(state, bg(state), fg(state))
    } else {
        fb.set_color(state, fg(state), bg(state))
    }
}

fn wipe(state: u64, c0: u64, r0: u64, c1: u64, r1: u64) {
    if c1 <= c0 || r1 <= r0 {
        return
    }
    var back: u64 = bg(state)
    if g(state, kstate.AN_REV) == 1 {
        back = fg(state)
    }
    fb.fill(state, c0 * font.GLYPH_W, r0 * font.GLYPH_H,
        (c1 - c0) * font.GLYPH_W, (r1 - r0) * font.GLYPH_H, back)
    fb.dirty_all(state)
}

fn settle(state: u64) {
    if g(state, AN_PEND) != 0 {
        s(state, AN_PEND, 0)
        fb.flush(state)
    }
}

fn run(state: u64, final: u64) {
    settle(state)
    let cols: u64 = fb.cols(state)
    let rows: u64 = fb.rows(state)
    let x: u64 = fb.cx(state)
    let y: u64 = fb.cy(state)
    kstate.add(state, kstate.K11_OFF + kstate.AN_SEQS, 1)
    if final == 72 || final == 102 {
        var r: u64 = par_or(state, 0, 1) - 1
        var c: u64 = par_or(state, 1, 1) - 1
        if r >= rows {
            r = rows - 1
        }
        if c >= cols {
            c = cols - 1
        }
        fb.goto(state, c, r)
        return
    }
    if final == 65 {
        let n: u64 = par_or(state, 0, 1)
        var r: u64 = 0
        if y > n {
            r = y - n
        }
        fb.goto(state, x, r)
        return
    }
    if final == 66 {
        var r: u64 = y + par_or(state, 0, 1)
        if r >= rows {
            r = rows - 1
        }
        fb.goto(state, x, r)
        return
    }
    if final == 67 {
        var c: u64 = x + par_or(state, 0, 1)
        if c >= cols {
            c = cols - 1
        }
        fb.goto(state, c, y)
        return
    }
    if final == 68 {
        let n: u64 = par_or(state, 0, 1)
        var c: u64 = 0
        if x > n {
            c = x - n
        }
        fb.goto(state, c, y)
        return
    }
    if final == 74 {
        let what: u64 = par_or(state, 0, 0)
        if what == 2 {
            wipe(state, 0, 0, cols, rows)
        } else if what == 1 {
            wipe(state, 0, 0, cols, y)
            wipe(state, 0, y, x + 1, y + 1)
        } else {
            wipe(state, x, y, cols, y + 1)
            wipe(state, 0, y + 1, cols, rows)
        }
        fb.goto(state, x, y)
        fb.flush(state)
        return
    }
    if final == 75 {
        let what: u64 = par_or(state, 0, 0)
        if what == 1 {
            wipe(state, 0, y, x + 1, y + 1)
        } else if what == 2 {
            wipe(state, 0, y, cols, y + 1)
        } else {
            wipe(state, x, y, cols, y + 1)
        }
        fb.goto(state, x, y)
        fb.flush(state)
        return
    }
    if final == 109 {
        var i: u64 = 0
        let n: u64 = g(state, kstate.AN_NPAR)
        if n == 0 {
            s(state, kstate.AN_REV, 0)
        }
        while i < n {
            let v: u64 = par(state, i)
            if v == 0 {
                s(state, kstate.AN_REV, 0)
            } else if v == 7 {
                s(state, kstate.AN_REV, 1)
            } else if v == 27 {
                s(state, kstate.AN_REV, 0)
            }
            i = i + 1
        }
        apply_color(state)
        return
    }
    if final == 104 || final == 108 {
        if g(state, kstate.AN_PRIV) == 1 && par_or(state, 0, 0) == 25 {
            fb.set_cursor(state, final == 104)
            fb.flush(state)
        }
        return
    }
}

fn feed(state: u64, c: u64) {
    let st: u64 = g(state, kstate.AN_STATE)
    if st == S_TEXT {
        if c == 27 {
            s(state, kstate.AN_STATE, S_ESC)
            return
        }
        fb.putc(state, c)
        s(state, AN_PEND, 1)
        return
    }
    if st == S_ESC {
        if c == 91 {
            s(state, kstate.AN_STATE, S_CSI)
            s(state, kstate.AN_NPAR, 0)
            s(state, kstate.AN_PRIV, 0)
            set_par(state, 0, 0)
            return
        }
        s(state, kstate.AN_STATE, S_TEXT)
        return
    }
    if c == 63 {
        s(state, kstate.AN_PRIV, 1)
        return
    }
    if c >= 48 && c <= 57 {
        var n: u64 = g(state, kstate.AN_NPAR)
        if n == 0 {
            n = 1
            s(state, kstate.AN_NPAR, 1)
            set_par(state, 0, 0)
        }
        if n <= kstate.AN_MAXPAR {
            set_par(state, n - 1, par(state, n - 1) * 10 + (c - 48))
        }
        return
    }
    if c == 59 {
        var n: u64 = g(state, kstate.AN_NPAR)
        if n == 0 {
            n = 1
            set_par(state, 0, 0)
        }
        if n < kstate.AN_MAXPAR {
            set_par(state, n, 0)
            n = n + 1
        }
        s(state, kstate.AN_NPAR, n)
        return
    }
    if c >= 64 && c <= 126 {
        run(state, c)
        s(state, kstate.AN_STATE, S_TEXT)
        return
    }
    if c < 32 {
        s(state, kstate.AN_STATE, S_TEXT)
        fb.putc(state, c)
    }
}

fn echo(c: u8) {
    let state: u64 = arch.kdata_base()
    if !fb.echo_on(state) {
        return
    }
    feed(state, c as u64)
}
