
import serial
import sync.atomic
import lib.kstate
import gfx.gfx
import sched.sched
import sched.signal
import lib.errno
import libc.regio

export {
    init, console, push, push_text, take, waiting, write_out, out_take,
    out_waiting, emit, alloc_pair, valid, set_pgrp, pgrp, sink, set_sink,
    lflag, set_lflag, winsize_rows, winsize_cols, set_winsize,
    cc_get, cc_set, peer_of, kind_of, info,
    do_ioctl, stats, count,
    ISIG, ICANON, ECHO, ECHOE, ECHONL, NOFLSH, TOSTOP,
    ICRNL, INLCR, IGNCR, OPOST, ONLCR,
    VINTR, VQUIT, VERASE, VKILL, VEOF, VTIME, VMIN, VSUSP,
    K_CONSOLE, K_PTY_SLAVE, K_PTY_MASTER,
    SINK_SERIAL, SINK_SCREEN, SINK_PEER, SINK_WINDOW,
    set_window, window_of,
    TCGETS, TCSETS, TIOCGPGRP, TIOCSPGRP, TIOCGWINSZ, TIOCSWINSZ,
    TIOCSCTTY, TIOCNOTTY, TIOCGSID, TIOCGPTN, TIOCSPTLCK, TIOCGPTLCK, claim,
    MAX_TTY, I_COUNT, I_LFLAG, I_PGRP, I_ROWS, I_COLS, I_QUEUED, I_SIGS,
    alloc_log,
    SINK_SVC0, SVC_N, alloc_log_svc, svc_take, svc_dropped,
    release, release_pair, TTY_FIRST_BLOCK
}

const MAX_TTY: u64 = 24
const TTY_FIRST_BLOCK: u64 = 8
const BYTES: u64 = 2048

const T_USED: u64 = 0
const T_KIND: u64 = 8
const T_PEER: u64 = 16
const T_LFLAG: u64 = 24
const T_IFLAG: u64 = 32
const T_OFLAG: u64 = 40
const T_PGRP: u64 = 48
const T_ROWS: u64 = 56
const T_COLS: u64 = 64
const T_SINK: u64 = 72
const T_WIN: u64 = 80
const T_LHEAD: u64 = 96
const T_LTAIL: u64 = 104
const T_OHEAD: u64 = 112
const T_OTAIL: u64 = 120
const T_EDIT: u64 = 128
const T_CC: u64 = 136
const T_STATS: u64 = 264
const LRING: u64 = 768
const LRING_MAX: u64 = 512
const ORING: u64 = 1280
const ORING_MAX: u64 = 512
const EDITBUF: u64 = 1792
const EDIT_MAX: u64 = 254

const K_CONSOLE: u64 = 0
const K_PTY_SLAVE: u64 = 1
const K_PTY_MASTER: u64 = 2

const SINK_SERIAL: u64 = 0
const SINK_SCREEN: u64 = 1
const SINK_PEER: u64 = 2
const SINK_WINDOW: u64 = 3

const SINK_SVC0: u64 = 4
const SVC_N: u64 = 4
const SVC_RING: u64 = 4096
static mut svc_buf: [u8; 16384] = [0; 16384]
static mut svc_head: [u64; 4] = [0; 4]
static mut svc_tail: [u64; 4] = [0; 4]
static mut svc_drop: [u64; 4] = [0; 4]
static mut svc_lk: [u64; 1] = [0; 1]

fn svc_lock() {
    while atomic.cas((&svc_lk[0]) as u64, 0, 1) != 0 {
        atomic.pause()
    }
}

fn svc_unlock() {
    atomic.store((&svc_lk[0]) as u64, 0)
}

fn svc_put(id: u64, c: u64) {
    let fl: u64 = sched.irq_save()
    svc_lock()
    let h: u64 = svc_head[id as usize]
    if h - svc_tail[id as usize] >= SVC_RING {
        svc_drop[id as usize] = svc_drop[id as usize] + 1
    } else {
        svc_buf[(id * SVC_RING + h % SVC_RING) as usize] = c as u8
        svc_head[id as usize] = h + 1
    }
    svc_unlock()
    sched.irq_restore(fl)
}

fn svc_take(id: u64, dst: u64, max: u64) -> u64 {
    if id >= SVC_N {
        return 0
    }
    let fl: u64 = sched.irq_save()
    svc_lock()
    var n: u64 = 0
    let tl: u64 = svc_tail[id as usize]
    let h: u64 = svc_head[id as usize]
    while n < max && tl + n < h {
        kstate.set8(dst + n, svc_buf[(id * SVC_RING + (tl + n) % SVC_RING) as usize])
        n = n + 1
    }
    svc_tail[id as usize] = tl + n
    svc_unlock()
    sched.irq_restore(fl)
    return n
}

fn svc_dropped(id: u64) -> u64 {
    if id >= SVC_N {
        return 0
    }
    let fl: u64 = sched.irq_save()
    svc_lock()
    let d: u64 = svc_drop[id as usize]
    svc_drop[id as usize] = 0
    svc_unlock()
    sched.irq_restore(fl)
    return d
}

const ISIG: u64 = 1
const ICANON: u64 = 2
const ECHO: u64 = 8
const ECHOE: u64 = 16
const ECHONL: u64 = 64
const NOFLSH: u64 = 128
const TOSTOP: u64 = 256
const ECHOWIN: u64 = 0x20000000

const IGNCR: u64 = 0x80
const ICRNL: u64 = 0x100
const INLCR: u64 = 0x40
const OPOST: u64 = 1
const ONLCR: u64 = 4

const VINTR: u64 = 0
const VQUIT: u64 = 1
const VERASE: u64 = 2
const VKILL: u64 = 3
const VEOF: u64 = 4
const VTIME: u64 = 5
const VMIN: u64 = 6
const VSUSP: u64 = 10

const TCGETS: u64 = 0x5401
const TCSETS: u64 = 0x5402
const TCSETSW: u64 = 0x5403
const TCSETSF: u64 = 0x5404
const TIOCGPGRP: u64 = 0x540F
const TIOCSPGRP: u64 = 0x5410
const TIOCGWINSZ: u64 = 0x5413
const TIOCSWINSZ: u64 = 0x5414
const TIOCSCTTY: u64 = 0x540E
const TIOCNOTTY: u64 = 0x5422
const TIOCGSID: u64 = 0x5429
const TIOCGPTN: u64 = 0x80045430
const TIOCSPTLCK: u64 = 0x40045431
const TIOCGPTLCK: u64 = 0x80045439

const I_COUNT: u64 = 0
const I_LFLAG: u64 = 1
const I_PGRP: u64 = 2
const I_ROWS: u64 = 3
const I_COLS: u64 = 4
const I_QUEUED: u64 = 5
const I_SIGS: u64 = 6

fn at(state: u64, t: u64) -> u64 {
    if t >= TTY_FIRST_BLOCK {
        return state + kstate.TTY2_OFF + (t - TTY_FIRST_BLOCK) * BYTES
    }
    return state + kstate.TTY_OFF + t * BYTES
}

fn g(state: u64, t: u64, f: u64) -> u64 {
    return __mmio_read64((at(state, t) + f) as *mut u64)
}

fn s(state: u64, t: u64, f: u64, v: u64) {
    __mmio_write64((at(state, t) + f) as *mut u64, v)
}

fn valid(state: u64, t: u64) -> bool {
    if t >= MAX_TTY {
        return false
    }
    return g(state, t, T_USED) != 0
}

fn console() -> u64 {
    return 0
}

fn kind_of(state: u64, t: u64) -> u64 {
    return g(state, t, T_KIND)
}

fn peer_of(state: u64, t: u64) -> u64 {
    let p: u64 = g(state, t, T_PEER)
    if p == 0 {
        return MAX_TTY
    }
    return p - 1
}

fn sink(state: u64, t: u64) -> u64 {
    return g(state, t, T_SINK)
}

fn set_window(state: u64, t: u64, w: u64) {
    s(state, t, T_WIN, w)
}

fn window_of(state: u64, t: u64) -> u64 {
    return g(state, t, T_WIN)
}

fn set_sink(state: u64, t: u64, v: u64) {
    s(state, t, T_SINK, v)
}

fn lflag(state: u64, t: u64) -> u64 {
    return g(state, t, T_LFLAG)
}

fn set_lflag(state: u64, t: u64, v: u64) {
    s(state, t, T_LFLAG, v)
}

fn pgrp(state: u64, t: u64) -> u64 {
    return g(state, t, T_PGRP)
}

fn set_pgrp(state: u64, t: u64, v: u64) {
    s(state, t, T_PGRP, v)
}

fn winsize_rows(state: u64, t: u64) -> u64 {
    return g(state, t, T_ROWS)
}

fn winsize_cols(state: u64, t: u64) -> u64 {
    return g(state, t, T_COLS)
}

fn set_winsize(state: u64, t: u64, r: u64, c: u64) {
    s(state, t, T_ROWS, r)
    s(state, t, T_COLS, c)
}

fn cc_get(state: u64, t: u64, i: u64) -> u64 {
    if i >= 16 {
        return 0
    }
    return g(state, t, T_CC + i * 8)
}

fn cc_set(state: u64, t: u64, i: u64, v: u64) {
    if i >= 16 {
        return
    }
    s(state, t, T_CC + i * 8, v)
}

fn stats(state: u64, t: u64) -> u64 {
    return g(state, t, T_STATS)
}

fn count(state: u64) -> u64 {
    var i: u64 = 0
    var n: u64 = 0
    while i < MAX_TTY {
        if g(state, i, T_USED) != 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn reset(state: u64, t: u64, kind: u64) {
    var i: u64 = 0
    while i < BYTES / 8 {
        __mmio_write64((at(state, t) + i * 8) as *mut u64, 0)
        i = i + 1
    }
    s(state, t, T_USED, 1)
    s(state, t, T_KIND, kind)
    s(state, t, T_LFLAG, ISIG | ICANON | ECHO | ECHOE)
    s(state, t, T_IFLAG, ICRNL)
    s(state, t, T_OFLAG, OPOST | ONLCR)
    s(state, t, T_ROWS, 24)
    s(state, t, T_COLS, 80)
    s(state, t, T_SINK, SINK_SERIAL)
    cc_set(state, t, VINTR, 3)
    cc_set(state, t, VQUIT, 28)
    cc_set(state, t, VERASE, 127)
    cc_set(state, t, VKILL, 21)
    cc_set(state, t, VEOF, 4)
    cc_set(state, t, VMIN, 1)
    cc_set(state, t, VTIME, 0)
    cc_set(state, t, VSUSP, 26)
}

fn init(state: u64) {
    var i: u64 = 0
    while i < MAX_TTY {
        s(state, i, T_USED, 0)
        i = i + 1
    }
    reset(state, 0, K_CONSOLE)
    s(state, 0, T_LFLAG, ISIG | ICANON | ECHOE)
    s(state, 0, T_OFLAG, 0)
    kstate.set(state, kstate.TTY_READY, 1)
}

fn alloc_pair(state: u64) -> u64 {
    var m: u64 = MAX_TTY
    var sl: u64 = MAX_TTY
    var i: u64 = 1
    while i < MAX_TTY {
        if g(state, i, T_USED) == 0 {
            if m == MAX_TTY {
                m = i
            } else {
                if sl == MAX_TTY {
                    sl = i
                }
            }
        }
        i = i + 1
    }
    if m == MAX_TTY || sl == MAX_TTY {
        return MAX_TTY
    }
    reset(state, m, K_PTY_MASTER)
    reset(state, sl, K_PTY_SLAVE)
    s(state, m, T_PEER, sl + 1)
    s(state, sl, T_PEER, m + 1)
    s(state, sl, T_SINK, SINK_PEER)
    s(state, m, T_SINK, SINK_PEER)
    s(state, m, T_LFLAG, 0)
    s(state, m, T_OFLAG, 0)
    return sl
}

fn alloc_log(state: u64) -> u64 {
    var i: u64 = MAX_TTY - 1
    while i >= 1 {
        if g(state, i, T_USED) == 0 {
            reset(state, i, K_CONSOLE)
            s(state, i, T_LFLAG, ISIG | ICANON | ECHOE)
            s(state, i, T_OFLAG, 0)
            s(state, i, T_SINK, SINK_SERIAL)
            return i
        }
        i = i - 1
    }
    return MAX_TTY
}

fn alloc_log_svc(state: u64, id: u64) -> u64 {
    if id >= SVC_N {
        return MAX_TTY
    }
    let t: u64 = alloc_log(state)
    if t < MAX_TTY {
        s(state, t, T_SINK, SINK_SVC0 + id)
    }
    return t
}

fn release(state: u64, t: u64) {
    if t == 0 || t >= MAX_TTY {
        return
    }
    if g(state, t, T_KIND) != K_CONSOLE {
        return
    }
    s(state, t, T_USED, 0)
}

fn release_pair(state: u64, t: u64) {
    if t == 0 || t >= MAX_TTY {
        return
    }
    let k: u64 = g(state, t, T_KIND)
    if k != K_PTY_SLAVE && k != K_PTY_MASTER {
        return
    }
    let p: u64 = peer_of(state, t)
    s(state, t, T_USED, 0)
    if p < MAX_TTY {
        s(state, p, T_USED, 0)
    }
}

fn lput(state: u64, t: u64, c: u64) {
    let h: u64 = g(state, t, T_LHEAD)
    if h - g(state, t, T_LTAIL) >= LRING_MAX {
        return
    }
    kstate.set8(at(state, t) + LRING + (h % LRING_MAX), c as u8)
    s(state, t, T_LHEAD, h + 1)
    sched.poll_kick(state)
}

fn oput(state: u64, t: u64, c: u64) {
    let h: u64 = g(state, t, T_OHEAD)
    if h - g(state, t, T_OTAIL) >= ORING_MAX {
        return
    }
    kstate.set8(at(state, t) + ORING + (h % ORING_MAX), c as u8)
    s(state, t, T_OHEAD, h + 1)
    sched.poll_kick(state)
}

fn waiting(state: u64, t: u64) -> u64 {
    return g(state, t, T_LHEAD) - g(state, t, T_LTAIL)
}

fn take(state: u64, t: u64) -> u64 {
    let tl: u64 = g(state, t, T_LTAIL)
    if tl >= g(state, t, T_LHEAD) {
        return 256
    }
    s(state, t, T_LTAIL, tl + 1)
    return kstate.get8(at(state, t) + LRING + (tl % LRING_MAX))
}

fn out_waiting(state: u64, t: u64) -> u64 {
    return g(state, t, T_OHEAD) - g(state, t, T_OTAIL)
}

fn out_take(state: u64, t: u64) -> u64 {
    let tl: u64 = g(state, t, T_OTAIL)
    if tl >= g(state, t, T_OHEAD) {
        return 256
    }
    s(state, t, T_OTAIL, tl + 1)
    return kstate.get8(at(state, t) + ORING + (tl % ORING_MAX))
}

fn emit(state: u64, t: u64, c: u64) {
    let k: u64 = g(state, t, T_SINK)
    if k == SINK_PEER {
        let p: u64 = peer_of(state, t)
        if p < MAX_TTY {
            if g(state, t, T_KIND) == K_PTY_SLAVE {
                oput(state, t, c)
            } else {
                push(state, p, c)
            }
        }
        return
    }
    if k >= SINK_SVC0 && k < SINK_SVC0 + SVC_N {
        serial.put(c as u8)
        svc_put(k - SINK_SVC0, c)
        return
    }
    if k == SINK_WINDOW {
        serial.put(c as u8)
        gfx.wm_term_out(state, g(state, t, T_WIN), c)
        return
    }
    serial.put(c as u8)
}

fn write_out(state: u64, t: u64, buf: u64, n: u64) -> u64 {
    if !valid(state, t) {
        return 0
    }
    let o: u64 = g(state, t, T_OFLAG)
    var i: u64 = 0
    gfx.wm_term_hold(state)
    while i < n {
        let c: u64 = kstate.get8(buf + i)
        if (o & OPOST) != 0 && (o & ONLCR) != 0 && c == 10 {
            emit(state, t, 13)
        }
        emit(state, t, c)
        i = i + 1
    }
    gfx.wm_term_release(state)
    s(state, t, T_STATS, g(state, t, T_STATS) + n)
    return n
}

fn echo(state: u64, t: u64, c: u64) {
    if (g(state, t, T_LFLAG) & ECHO) == 0 {
        return
    }
    if c == 10 {
        emit(state, t, 13)
        emit(state, t, 10)
        return
    }
    if c < 32 {
        emit(state, t, 94)
        emit(state, t, c + 64)
        return
    }
    emit(state, t, c)
}

fn wecho_on(state: u64, t: u64) -> bool {
    let lf: u64 = g(state, t, T_LFLAG)
    if (lf & ECHOWIN) == 0 || (lf & ECHO) != 0 || (lf & ICANON) == 0 {
        return false
    }
    return g(state, t, T_SINK) == SINK_WINDOW
}

fn wecho(state: u64, t: u64, c: u64) {
    if !wecho_on(state, t) {
        return
    }
    if c < 32 && c != 10 {
        return
    }
    gfx.wm_term_out(state, g(state, t, T_WIN), c)
}

fn edit_cells(state: u64, t: u64) -> u64 {
    let n: u64 = g(state, t, T_EDIT)
    var k: u64 = 0
    var i: u64 = 0
    while i < n {
        let b: u64 = kstate.get8(at(state, t) + EDITBUF + i)
        if b >= 32 && b != 127 && (b < 128 || b > 191) {
            k = k + 1
        }
        i = i + 1
    }
    return k
}

fn wback(state: u64, t: u64, k: u64) {
    if !wecho_on(state, t) {
        return
    }
    var i: u64 = 0
    while i < k {
        gfx.wm_term_out(state, g(state, t, T_WIN), 0x108)
        i = i + 1
    }
}

fn edit_push(state: u64, t: u64, c: u64) {
    let n: u64 = g(state, t, T_EDIT)
    if n >= EDIT_MAX {
        return
    }
    kstate.set8(at(state, t) + EDITBUF + n, c as u8)
    s(state, t, T_EDIT, n + 1)
}

fn edit_commit(state: u64, t: u64) {
    let n: u64 = g(state, t, T_EDIT)
    var i: u64 = 0
    while i < n {
        lput(state, t, kstate.get8(at(state, t) + EDITBUF + i))
        i = i + 1
    }
    s(state, t, T_EDIT, 0)
}

fn edit_drop(state: u64, t: u64) {
    s(state, t, T_EDIT, 0)
}

fn push(state: u64, t: u64, c0: u64) -> u64 {
    if !valid(state, t) {
        return 0
    }
    var c: u64 = c0 & 255
    kstate.add(state, kstate.TTY_CHARS, 1)
    let lf: u64 = g(state, t, T_LFLAG)
    let inf: u64 = g(state, t, T_IFLAG)
    if c == 13 && (inf & IGNCR) != 0 {
        return 0
    }
    if c == 13 && (inf & ICRNL) != 0 {
        c = 10
    }
    if c == 10 && (inf & INLCR) != 0 {
        c = 13
    }

    if (lf & ISIG) != 0 {
        var sig: u64 = 0
        if c == cc_get(state, t, VINTR) && c != 0 {
            sig = signal.SIGINT
        }
        if c == cc_get(state, t, VQUIT) && c != 0 {
            sig = signal.SIGQUIT
        }
        if c == cc_get(state, t, VSUSP) && c != 0 {
            sig = signal.SIGTSTP
        }
        if sig != 0 {
            echo(state, t, c)
            if (lf & NOFLSH) == 0 && wecho_on(state, t) {
                wecho(state, t, 94)
                wecho(state, t, c + 64)
                wecho(state, t, 10)
            }
            if (lf & NOFLSH) == 0 {
                edit_drop(state, t)
            }
            let grp: u64 = g(state, t, T_PGRP)
            if grp != 0 {
                let hit: u64 = signal.send_pgid(state, grp, sig)
                if hit != 0 {
                    kstate.add(state, kstate.TTY_SIGS, 1)
                }
            }
            return sig
        }
    }

    if (lf & ICANON) == 0 {
        lput(state, t, c)
        return 0
    }

    if c == cc_get(state, t, VERASE) || c == 8 {
        let n: u64 = g(state, t, T_EDIT)
        if n > 0 {
            let before: u64 = edit_cells(state, t)
            s(state, t, T_EDIT, n - 1)
            wback(state, t, before - edit_cells(state, t))
            if (lf & ECHO) != 0 && (lf & ECHOE) != 0 {
                emit(state, t, 8)
                emit(state, t, 32)
                emit(state, t, 8)
            }
        }
        return 0
    }
    if c == cc_get(state, t, VKILL) && c != 0 {
        let n: u64 = g(state, t, T_EDIT)
        var k: u64 = 0
        while k < n && (lf & ECHO) != 0 && (lf & ECHOE) != 0 {
            emit(state, t, 8)
            emit(state, t, 32)
            emit(state, t, 8)
            k = k + 1
        }
        wback(state, t, edit_cells(state, t))
        s(state, t, T_EDIT, 0)
        return 0
    }
    if c == cc_get(state, t, VEOF) && c != 0 {
        echo(state, t, c)
        wback(state, t, edit_cells(state, t))
        edit_commit(state, t)
        return 0
    }
    echo(state, t, c)
    if c == 10 {
        wback(state, t, edit_cells(state, t))
    } else {
        wecho(state, t, c)
    }
    edit_push(state, t, c)
    if c == 10 {
        edit_commit(state, t)
    }
    return 0
}

fn push_text(state: u64, t: u64, p: u64, n: u64) -> u64 {
    var i: u64 = 0
    var sigs: u64 = 0
    while i < n {
        if push(state, t, kstate.get8(p + i)) != 0 {
            sigs = sigs + 1
        }
        i = i + 1
    }
    return sigs
}

fn info(state: u64, t: u64, what: u64) -> u64 {
    if what == I_COUNT {
        return count(state)
    }
    if !valid(state, t) {
        return errno.neg(errno.E_NOTTY)
    }
    if what == I_LFLAG {
        return g(state, t, T_LFLAG)
    }
    if what == I_PGRP {
        return g(state, t, T_PGRP)
    }
    if what == I_ROWS {
        return g(state, t, T_ROWS)
    }
    if what == I_COLS {
        return g(state, t, T_COLS)
    }
    if what == I_QUEUED {
        return waiting(state, t)
    }
    if what == I_SIGS {
        return kstate.get(state, kstate.TTY_SIGS)
    }
    return errno.neg(errno.E_INVAL)
}

fn claim(state: u64, t: u64, pgid: u64) {
    if valid(state, t) && g(state, t, T_PGRP) == 0 {
        s(state, t, T_PGRP, pgid)
    }
}

fn do_ioctl(state: u64, t: u64, req: u64, buf: u64) -> u64 {
    if !valid(state, t) {
        return errno.neg(errno.E_NOTTY)
    }
    if req == TCGETS {
        __mmio_write32((buf + 0) as *mut u32, (g(state, t, T_IFLAG) & 0xFFFFFFFF) as u32)
        __mmio_write32((buf + 4) as *mut u32, (g(state, t, T_OFLAG) & 0xFFFFFFFF) as u32)
        __mmio_write32((buf + 8) as *mut u32, 0x00000CBD as u32)
        __mmio_write32((buf + 12) as *mut u32, (g(state, t, T_LFLAG) & 0xFFFFFFFF) as u32)
        kstate.set8(buf + 16, 0 as u8)
        var i: u64 = 0
        while i < 19 {
            var v: u64 = 0
            if i < 16 {
                v = cc_get(state, t, i)
            }
            kstate.set8(buf + 17 + i, v as u8)
            i = i + 1
        }
        return 0
    }
    if req == TCSETS || req == TCSETSW || req == TCSETSF {
        let was_canon: bool = (g(state, t, T_LFLAG) & ICANON) != 0
        s(state, t, T_IFLAG, regio.read32(buf + 0))
        s(state, t, T_OFLAG, regio.read32(buf + 4))
        s(state, t, T_LFLAG, regio.read32(buf + 12))
        if was_canon && (g(state, t, T_LFLAG) & ICANON) == 0 && req != TCSETSF {
            edit_commit(state, t)
        }
        var i: u64 = 0
        while i < 16 {
            cc_set(state, t, i, kstate.get8(buf + 17 + i))
            i = i + 1
        }
        if req == TCSETSF {
            s(state, t, T_LTAIL, g(state, t, T_LHEAD))
            s(state, t, T_EDIT, 0)
        }
        return 0
    }
    if req == TIOCGPGRP {
        __mmio_write32((buf) as *mut u32, (g(state, t, T_PGRP) & 0xFFFFFFFF) as u32)
        return 0
    }
    if req == TIOCSPGRP {
        s(state, t, T_PGRP, regio.read32(buf))
        return 0
    }
    if req == TIOCGPTN {
        if g(state, t, T_KIND) != K_PTY_MASTER {
            return errno.neg(errno.E_NOTTY)
        }
        __mmio_write32((buf) as *mut u32, (peer_of(state, t) & 0xFFFFFFFF) as u32)
        return 0
    }
    if req == TIOCSPTLCK {
        if g(state, t, T_KIND) != K_PTY_MASTER {
            return errno.neg(errno.E_NOTTY)
        }
        return 0
    }
    if req == TIOCGPTLCK {
        if g(state, t, T_KIND) != K_PTY_MASTER {
            return errno.neg(errno.E_NOTTY)
        }
        __mmio_write32((buf) as *mut u32, 0 as u32)
        return 0
    }
    var wt: u64 = t
    if g(state, t, T_KIND) == K_PTY_MASTER && peer_of(state, t) < MAX_TTY {
        wt = peer_of(state, t)
    }
    if req == TIOCGWINSZ {
        var rows: u64 = g(state, wt, T_ROWS)
        var cols: u64 = g(state, wt, T_COLS)
        if g(state, t, T_SINK) == SINK_WINDOW {
            let sz: u64 = gfx.wm_term_size(state, g(state, t, T_WIN))
            if sz != 0 {
                rows = sz >> 16
                cols = sz & 0xFFFF
            }
        }
        __mmio_write16((buf + 0) as *mut u16, (rows & 0xFFFF) as u16)
        __mmio_write16((buf + 2) as *mut u16, (cols & 0xFFFF) as u16)
        __mmio_write16((buf + 4) as *mut u16, 0 as u16)
        __mmio_write16((buf + 6) as *mut u16, 0 as u16)
        return 0
    }
    if req == TIOCSWINSZ {
        s(state, wt, T_ROWS, regio.read16(buf + 0))
        s(state, wt, T_COLS, regio.read16(buf + 2))
        let grp: u64 = g(state, wt, T_PGRP)
        if grp != 0 {
            signal.send_pgid(state, grp, signal.SIGWINCH)
        }
        return 0
    }
    return errno.neg(errno.E_INVAL)
}
