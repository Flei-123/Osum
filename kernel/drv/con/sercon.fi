
profile kernel

import serial
import lib.cmdword
import lib.kstate
import drv.con.tty
import sched.rand
import sched.time

export {
    parse, init, irq, poll, active, port_of, rx, irqs, drops, overruns,
    report
}

fn parse(state: u64, cmd: u64) {
    var tag: [u8; 9] = "console=\0"
    var tty0: [u8; 6] = "ttyS0\0"
    var tty1: [u8; 6] = "ttyS1\0"
    kstate.set(state, kstate.SER_PORT, 0)
    if cmd == 0 {
        return
    }
    var w_noirq: [u8; 9] = "noserirq\0"
    var w_poll: [u8; 8] = "serpoll\0"
    if cmdword.find(cmd, (&w_noirq[0]) as u64, 8) != 0 {
        kstate.mode_add(state, kstate.M_NOSERIRQ)
    }
    if cmdword.find(cmd, (&w_poll[0]) as u64, 7) != 0 {
        kstate.mode_add(state, kstate.M_SERPOLL)
    }
    let at: u64 = cmdword.find(cmd, (&tag[0]) as u64, 8)
    if at == 0 {
        return
    }
    let arg: u64 = at + 8
    if find_at(arg, (&tty1[0]) as u64, 5) {
        kstate.set(state, kstate.SER_PORT, serial.COM2 as u64)
        kstate.mode_add(state, kstate.M_SERCON)
        return
    }
    if find_at(arg, (&tty0[0]) as u64, 5) {
        kstate.set(state, kstate.SER_PORT, serial.COM1 as u64)
        kstate.mode_add(state, kstate.M_SERCON)
    }
}

fn find_at(p: u64, w: u64, n: u64) -> bool {
    var i: u64 = 0
    while i < n {
        if kstate.get8(p + i) != kstate.get8(w + i) {
            return false
        }
        i = i + 1
    }
    let move_to: u64 = kstate.get8(p + n)
    return move_to == 0 || move_to == 32
}

fn active(state: u64) -> bool {
    return kstate.mode_on(state, kstate.M_SERCON)
}

fn port_of(state: u64) -> u64 {
    let p: u64 = kstate.get(state, kstate.SER_PORT)
    if p == 0 {
        return serial.COM1 as u64
    }
    return p
}

fn init(state: u64) {
    if !active(state) {
        return
    }
    if !kstate.mode_on(state, kstate.M_NOSERIRQ) {
        serial.rx_on()
    }
    drain(state)
}

fn drain(state: u64) -> u64 {
    var n: u64 = 0
    var going: bool = true
    while going {
        let c: u64 = serial.rx_take()
        if c == 256 {
            going = false
        } else {
            kstate.add(state, kstate.SER_RX, 1)
            n = n + 1
            rand.stir(state, time.tsc())
            if kstate.get(state, kstate.TTY_READY) != 0 {
                tty.push(state, tty.console(), c)
            } else {
                kstate.add(state, kstate.SER_DROPS, 1)
            }
            if n >= 64 {
                going = false
            }
        }
    }
    if serial.overrun() {
        kstate.add(state, kstate.SER_OVERRUNS, 1)
    }
    return n
}

fn irq(state: u64) {
    kstate.add(state, kstate.SER_IRQS, 1)
    drain(state)
}

fn poll(state: u64) -> u64 {
    if !active(state) {
        return 0
    }
    return drain(state)
}

fn rx(state: u64) -> u64 {
    return kstate.get(state, kstate.SER_RX)
}

fn irqs(state: u64) -> u64 {
    return kstate.get(state, kstate.SER_IRQS)
}

fn drops(state: u64) -> u64 {
    return kstate.get(state, kstate.SER_DROPS)
}

fn overruns(state: u64) -> u64 {
    return kstate.get(state, kstate.SER_OVERRUNS)
}

fn report(state: u64) {
    var s_a: [u8; 14] = "sercon: port=\0"
    var s_b: [u8; 6] = "  rx=\0"
    var s_c: [u8; 8] = "  irqs=\0"
    var s_d: [u8; 9] = "  drops=\0"
    var s_e: [u8; 12] = "  overruns=\0"
    var s_off: [u8; 13] = "sercon: off\0\0"
    if !active(state) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_a[0]) as u64)
    serial.hex_width(port_of(state), 3)
    serial.puts((&s_b[0]) as u64)
    serial.dec(rx(state))
    serial.puts((&s_c[0]) as u64)
    serial.dec(irqs(state))
    serial.puts((&s_d[0]) as u64)
    serial.dec(drops(state))
    serial.puts((&s_e[0]) as u64)
    serial.dec(overruns(state))
    serial.nl()
}
