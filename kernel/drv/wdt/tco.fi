profile kernel

import arch.arch

export {
    ticks_for, seconds_of, reload, count, set_ticks, ticks, run, halt, halted, locked,
    second_timeout_seen, first_timeout_seen, sts1, sts2, clear_status, TICK_MS, TMR_MIN, TMR_MAX
}

const RLD: u64 = 0x00
const STS1: u64 = 0x04
const STS2: u64 = 0x06
const CNT1: u64 = 0x08
const TMR: u64 = 0x12
const TMR_HLT: u64 = 0x0800
const TCO_LOCK: u64 = 0x1000
const STS1_TIMEOUT: u64 = 0x0008
const STS2_SECOND_TO: u64 = 0x0002
const STS2_BOOT: u64 = 0x0004
const TMR_MASK: u64 = 0x03FF
const TICK_MS: u64 = 600
const TMR_MIN: u64 = 4
const TMR_MAX: u64 = 0x03FF
const STAGES_UNTIL_RESET: u64 = 2

fn rd16(base: u64, off: u64) -> u64 {
    return arch.dev_in16(((base + off) & 0xFFFF) as u16) as u64
}

fn wr16(base: u64, off: u64, v: u64) {
    arch.dev_out16(((base + off) & 0xFFFF) as u16, (v & 0xFFFF) as u16)
}

fn ticks_for(seconds: u64) -> u64 {
    var t: u64 = (seconds * 1000) / (TICK_MS * STAGES_UNTIL_RESET)
    if t < TMR_MIN {
        t = TMR_MIN
    }
    if t > TMR_MAX {
        t = TMR_MAX
    }
    return t
}

fn seconds_of(t: u64) -> u64 {
    return (t * TICK_MS * STAGES_UNTIL_RESET) / 1000
}

fn reload(base: u64) {
    wr16(base, RLD, 1)
}

fn count(base: u64) -> u64 {
    return rd16(base, RLD) & TMR_MASK
}

fn ticks(base: u64) -> u64 {
    return rd16(base, TMR) & TMR_MASK
}

fn set_ticks(base: u64, t: u64) -> bool {
    let v: u64 = rd16(base, TMR)
    wr16(base, TMR, (v & (~TMR_MASK) & 0xFFFF) | (t & TMR_MASK))
    return ticks(base) == (t & TMR_MASK)
}

fn halted(base: u64) -> bool {
    return (rd16(base, CNT1) & TMR_HLT) != 0
}

fn locked(base: u64) -> bool {
    return (rd16(base, CNT1) & TCO_LOCK) != 0
}

fn run(base: u64) -> bool {
    wr16(base, CNT1, rd16(base, CNT1) & (~TMR_HLT) & 0xFFFF)
    return !halted(base)
}

fn halt(base: u64) -> bool {
    wr16(base, CNT1, rd16(base, CNT1) | TMR_HLT)
    return halted(base)
}

fn second_timeout_seen(base: u64) -> bool {
    return (rd16(base, STS2) & STS2_SECOND_TO) != 0
}

fn first_timeout_seen(base: u64) -> bool {
    return (rd16(base, STS1) & STS1_TIMEOUT) != 0
}

fn sts1(base: u64) -> u64 {
    return rd16(base, STS1)
}

fn sts2(base: u64) -> u64 {
    return rd16(base, STS2)
}

fn clear_status(base: u64) {
    wr16(base, STS1, STS1_TIMEOUT)
    wr16(base, STS2, STS2_SECOND_TO)
    wr16(base, STS2, STS2_BOOT)
}
