profile kernel

import lib.kstate
import serial
import diag.cmdopt
import drv.wdt.tco
import drv.wdt.tcochip
import sync.atomic
import diag.crash
import diag.wdtmark
import diag.hangslot
import klog

export {
    stage, tick, sys_hook, on_panic, request_hang, pause, resume, starved_s,
    st, timeout_s, tmr_ticks, feeds, starved, last_feed, user_window_s, hang_requested, blind, watchdog_reset_seen, count_now, boot_report, mark_clean, mark_freeze, last_boot, last_detail, last_info,
    ST_OFF, ST_ABSENT, ST_FAILED, ST_ARMED, ST_PAUSED, ST_PANIC,
    DEFAULT_TIMEOUT_S, LB_NORMAL, LB_WATCHDOG, LB_UNCLEAN, LB_PANIC, LD_NONE, LD_TCO, LD_FREEZE, LD_PLANTED
}

const ST_OFF: u64 = 0
const ST_ABSENT: u64 = 1
const ST_FAILED: u64 = 2
const ST_ARMED: u64 = 3
const ST_PAUSED: u64 = 4
const ST_PANIC: u64 = 5

const LB_NORMAL: u64 = 0
const LB_WATCHDOG: u64 = 1
const LB_UNCLEAN: u64 = 2
const LB_PANIC: u64 = 3
const LD_NONE: u64 = 0
const LD_TCO: u64 = 1
const LD_FREEZE: u64 = 2
const LD_PLANTED: u64 = 3
const HZ: u64 = 100
const DEFAULT_TIMEOUT_S: u64 = 60
const MIN_TIMEOUT_S: u64 = 6
const MAX_TIMEOUT_S: u64 = 600
const CHECK_TICKS: u64 = 100
const BOOT_GRACE_TICKS: u64 = 30000
const MIN_USER_WINDOW_S: u64 = 5
const MAX_USER_WINDOW_S: u64 = 30

static mut w_state: u64 = 0
static mut w_timeout: u64 = 0
static mut w_tmr: u64 = 0
static mut w_feeds: u64 = 0
static mut w_starved: u64 = 0
static mut w_last_feed: u64 = 0
static mut w_last_check: u64 = 0
static mut w_last_sys: u64 = 0
static mut w_last_sw: u64 = 0
static mut w_sys_moved_at: u64 = 0
static mut w_window: u64 = 0
static mut w_blind: u64 = 0
static mut w_hang_at: u64 = 0
static mut w_spin_at: u64 = 0
static mut w_panic_at: u64 = 0
static mut w_hang_req: u64 = 0
static mut w_proc_ok: u64 = 0
static mut w_wdt_reset: u64 = 0
static mut w_said_starve: u64 = 0
static mut w_cspin_at: u64 = 0
static mut w_lock_at: u64 = 0
static mut w_last: u64 = 0
static mut w_detail: u64 = 0
static mut w_info: u64 = 0
static mut w_ev_sts1: u64 = 0
static mut w_ev_sts2: u64 = 0
static mut w_ev_prev: u64 = 255
static mut w_ignore_sts: u64 = 0
static mut w_no_mark: u64 = 0
static mut k_nosts: [u8; 10] = "wdtnosts\0\0"
static mut k_nomark: [u8; 10] = "wdtnomark\0"
static mut s_ev_src: [u8; 4] = "wdt\0"
static mut s_ev_a: [u8; 15] = "evidence prev=\0"
static mut s_ev_b: [u8; 15] = "evidence info=\0"
static mut s_ev_c: [u8; 15] = "evidence sts1=\0"
static mut s_ev_d: [u8; 15] = "evidence sts2=\0"
static mut s_ev_e: [u8; 15] = "evidence last=\0"
static mut s_ev_f: [u8; 17] = "evidence detail=\0"
static mut s_rp_r: [u8; 9] = "reason: \0"
static mut s_rp_w: [u8; 10] = "watchdog\0\0"
static mut s_rp_c: [u8; 15] = "culprit-code: \0"
static mut s_rp_s: [u8; 9] = "source: \0"
static mut s_rp_t: [u8; 4] = "tco\0"
static mut s_rp_f: [u8; 7] = "freeze\0"
static mut s_rp_p: [u8; 8] = "planted\0"
static mut s_rp_d: [u8; 26] = "snapshot: from disk slot\n\0"
static mut s_rp_n: [u8; 65] = "snapshot: none (RAM report did not survive or was never taken)\n\0\0"

static mut k_wdt: [u8; 4] = "wdt\0"
static mut k_nowdt: [u8; 6] = "nowdt\0"
static mut k_hang: [u8; 8] = "wdthang\0"
static mut k_spin: [u8; 8] = "wdtspin\0"
static mut k_panic: [u8; 9] = "wdtpanic\0"
static mut k_blind: [u8; 9] = "wdtblind\0"
static mut k_cspin: [u8; 9] = "wdtcspin\0"
static mut k_lock: [u8; 8] = "wdtlock\0"
static mut k_proc: [u8; 8] = "wdtproc\0"

static mut s_off: [u8; 18] = "wdt: off by word\n\0"
static mut s_absent: [u8; 19] = "wdt: absent, why=\0\0"
static mut s_armed: [u8; 18] = "wdt: armed chip=\0\0"
static mut s_base: [u8; 7] = " base=\0"
static mut s_tmo: [u8; 12] = " timeout_s=\0"
static mut s_tmr: [u8; 6] = " tmr=\0"
static mut s_win: [u8; 15] = " user_window=\0\0"
static mut s_last: [u8; 13] = " last_boot=\0\0"
static mut s_wd: [u8; 9] = "watchdog\0"
static mut s_norm: [u8; 7] = "normal\0"
static mut s_unc: [u8; 8] = "unclean\0"
static mut s_pan: [u8; 6] = "panic\0"
static mut s_failed: [u8; 18] = "wdt: failed step=\0"
static mut s_starve: [u8; 50] = "wdt: no progress (syscalls/switches), not feeding\0"
static mut s_hang: [u8; 37] = "wdt: planted hang (cli; hlt) on cpu0\0"
static mut s_spin: [u8; 43] = "wdt: planted spin, syscalls stop answering\0"
static mut s_panic: [u8; 26] = "wdt: planted kernel fault\0"
static mut s_cspin: [u8; 37] = "wdt: planted spin with irqs off cpu0\0"
static mut s_lock: [u8; 37] = "wdt: planted lock deadlock (stress)\0\0"
static mut s_pause: [u8; 13] = "wdt: paused\n\0"
static mut s_resume: [u8; 14] = "wdt: resumed\n\0"

fn st() -> u64 {
    return w_state
}

fn timeout_s() -> u64 {
    return w_timeout
}

fn tmr_ticks() -> u64 {
    return w_tmr
}

fn feeds() -> u64 {
    return w_feeds
}

fn starved() -> u64 {
    return w_starved
}

fn last_feed() -> u64 {
    return w_last_feed
}

fn user_window_s() -> u64 {
    return w_window
}

fn starved_s(state: u64) -> u64 {
    if w_said_starve == 0 || w_state != ST_ARMED {
        return 0
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if now < w_last_feed {
        return 0
    }
    return (now - w_last_feed) / HZ
}

fn hang_requested() -> bool {
    return w_hang_req != 0
}

fn blind() -> bool {
    return w_blind != 0
}

fn watchdog_reset_seen() -> bool {
    return w_wdt_reset != 0
}

fn count_now() -> u64 {
    if w_state != ST_ARMED && w_state != ST_PAUSED {
        return 0
    }
    return tco.count(tcochip.base())
}

fn seconds_word(state: u64, w: u64) -> u64 {
    return cmdopt.number(state, w, 0) * HZ
}

fn words(state: u64) -> bool {
    if cmdopt.has(state, (&k_nowdt[0]) as u64) {
        return false
    }
    w_timeout = DEFAULT_TIMEOUT_S
    if cmdopt.has(state, (&k_wdt[0]) as u64) {
        let v: u64 = cmdopt.number(state, (&k_wdt[0]) as u64, 0)
        if v == 0 {
            return false
        }
        w_timeout = v
    }
    if w_timeout < MIN_TIMEOUT_S {
        w_timeout = MIN_TIMEOUT_S
    }
    if w_timeout > MAX_TIMEOUT_S {
        w_timeout = MAX_TIMEOUT_S
    }
    w_window = w_timeout / 2
    if w_window < MIN_USER_WINDOW_S {
        w_window = MIN_USER_WINDOW_S
    }
    if w_window > MAX_USER_WINDOW_S {
        w_window = MAX_USER_WINDOW_S
    }
    w_hang_at = seconds_word(state, (&k_hang[0]) as u64)
    w_spin_at = seconds_word(state, (&k_spin[0]) as u64)
    w_panic_at = seconds_word(state, (&k_panic[0]) as u64)
    w_cspin_at = seconds_word(state, (&k_cspin[0]) as u64)
    w_lock_at = seconds_word(state, (&k_lock[0]) as u64)
    if cmdopt.has(state, (&k_blind[0]) as u64) {
        w_blind = 1
    }
    if cmdopt.has(state, (&k_proc[0]) as u64) {
        w_proc_ok = 1
    }
    return true
}

fn failed(step: u64) {
    w_state = ST_FAILED
    serial.puts((&s_failed[0]) as u64)
    serial.dec(step)
    serial.nl()
}

fn classify(tco_seen: bool) {
    let p: u64 = w_ev_prev
    w_last = LB_NORMAL
    w_detail = LD_NONE
    if tco_seen {
        w_last = LB_WATCHDOG
        w_detail = LD_TCO
    }
    if p == wdtmark.ST_PLANTED {
        w_last = LB_WATCHDOG
        w_detail = LD_PLANTED
    }
    if p == wdtmark.ST_FREEZE {
        w_last = LB_WATCHDOG
        w_detail = LD_FREEZE
    }
    if p == wdtmark.ST_PANIC {
        w_last = LB_PANIC
        w_detail = LD_NONE
    }
    if p == wdtmark.ST_ARMED && w_last == LB_NORMAL {
        w_last = LB_UNCLEAN
    }
    w_wdt_reset = 0
    if w_last == LB_WATCHDOG {
        w_wdt_reset = 1
    }
}

fn planted_mark() {
    if w_no_mark == 0 {
        wdtmark.mark(wdtmark.ST_PLANTED, 0)
    }
}

fn mark_clean() {
    wdtmark.mark(wdtmark.ST_CLEAN, 0)
}

fn mark_freeze(reason: u64, culprit: u64) {
    if w_no_mark == 0 {
        wdtmark.mark(wdtmark.ST_FREEZE, reason * 16 + (culprit & 15))
    }
}

fn last_boot() -> u64 {
    return w_last
}

fn last_detail() -> u64 {
    return w_detail
}

fn last_info() -> u64 {
    return w_info
}

fn stage(state: u64) {
    wdtmark.load()
    w_ev_prev = wdtmark.prev_state()
    w_info = wdtmark.prev_info()
    if cmdopt.has(state, (&k_nosts[0]) as u64) {
        w_ignore_sts = 1
    }
    if cmdopt.has(state, (&k_nomark[0]) as u64) {
        w_no_mark = 1
    }
    if !words(state) {
        classify(false)
        wdtmark.mark(wdtmark.ST_CLEAN, 0)
        w_state = ST_OFF
        serial.puts((&s_off[0]) as u64)
        return
    }
    if tcochip.probe(state) == tcochip.KIND_NONE {
        classify(false)
        wdtmark.mark(wdtmark.ST_CLEAN, 0)
        w_state = ST_ABSENT
        serial.puts((&s_absent[0]) as u64)
        serial.dec(tcochip.why())
        serial.nl()
        return
    }
    let b: u64 = tcochip.base()
    w_ev_sts1 = tco.sts1(b)
    w_ev_sts2 = tco.sts2(b)
    var seen: bool = tco.second_timeout_seen(b)
    if tco.first_timeout_seen(b) && w_ev_prev != wdtmark.ST_CLEAN {
        seen = true
    }
    if w_ignore_sts != 0 {
        seen = false
    }
    classify(seen)
    wdtmark.mark(wdtmark.ST_CLEAN, 0)
    tco.clear_status(b)
    w_tmr = tco.ticks_for(w_timeout)
    if !tco.set_ticks(b, w_tmr) {
        failed(1)
        return
    }
    tco.reload(b)
    if !tcochip.noreboot_clear() {
        failed(2)
        return
    }
    if !tco.run(b) {
        failed(3)
        return
    }
    tco.reload(b)
    let now: u64 = kstate.get(state, kstate.TICKS)
    w_last_feed = now
    w_last_check = now
    w_state = ST_ARMED
    wdtmark.mark(wdtmark.ST_ARMED, 0)
    serial.puts((&s_armed[0]) as u64)
    serial.dec(tcochip.kind())
    serial.puts((&s_base[0]) as u64)
    serial.hex(b)
    serial.puts((&s_tmo[0]) as u64)
    serial.dec(tco.seconds_of(w_tmr))
    serial.puts((&s_tmr[0]) as u64)
    serial.dec(w_tmr)
    serial.puts((&s_win[0]) as u64)
    serial.dec(w_window)
    serial.puts((&s_last[0]) as u64)
    if w_last == LB_WATCHDOG {
        serial.puts((&s_wd[0]) as u64)
    } else if w_last == LB_UNCLEAN {
        serial.puts((&s_unc[0]) as u64)
    } else if w_last == LB_PANIC {
        serial.puts((&s_pan[0]) as u64)
    } else {
        serial.puts((&s_norm[0]) as u64)
    }
    serial.nl()
}

fn planted_hang() {
    planted_mark()
    serial.puts((&s_hang[0]) as u64)
    serial.nl()
    asm("cli")
    while true {
        asm("hlt")
    }
}

fn planted_cspin() {
    planted_mark()
    serial.puts((&s_cspin[0]) as u64)
    serial.nl()
    asm("cli")
    while true {
        asm("pause")
    }
}

fn planted_lock(state: u64) {
    planted_mark()
    serial.puts((&s_lock[0]) as u64)
    serial.nl()
    asm("cli")
    atomic.lock_take(state, atomic.L_STRESS, 0)
    atomic.lock_take(state, atomic.L_STRESS, 0)
}

fn planted_fault() {
    planted_mark()
    serial.puts((&s_panic[0]) as u64)
    serial.nl()
    w_panic_at = 0
    __mmio_write64(0x00007FFFFFFF0000 as *mut u64, 1)
}

fn userspace_alive(now: u64, sys: u64) -> bool {
    if sys == 0 {
        return now < BOOT_GRACE_TICKS
    }
    return now - w_sys_moved_at <= w_window * HZ
}

fn tick(state: u64) {
    if w_state != ST_ARMED {
        return
    }
    let now: u64 = kstate.get(state, kstate.TICKS)
    if w_hang_req != 0 {
        planted_hang()
    }
    if crash.rescued() {
        w_hang_at = 0
        w_cspin_at = 0
        w_lock_at = 0
    }
    if w_hang_at != 0 && now >= w_hang_at {
        planted_hang()
    }
    if w_panic_at != 0 && now >= w_panic_at {
        planted_fault()
    }
    if w_cspin_at != 0 && now >= w_cspin_at {
        planted_cspin()
    }
    if w_lock_at != 0 && now >= w_lock_at {
        w_lock_at = 0
        planted_lock(state)
    }
    if now - w_last_check < CHECK_TICKS {
        return
    }
    w_last_check = now
    let sys: u64 = kstate.get(state, kstate.SYSCALLS)
    let sw: u64 = kstate.get(state, kstate.SWITCHES)
    let scheduler_moved: bool = sw != w_last_sw
    if sys != w_last_sys && scheduler_moved {
        w_sys_moved_at = now
    }
    w_last_sys = sys
    w_last_sw = sw
    if w_blind != 0 || (scheduler_moved && userspace_alive(now, sys)) {
        tco.reload(tcochip.base())
        w_feeds = w_feeds + 1
        w_last_feed = now
        w_said_starve = 0
        return
    }
    w_starved = w_starved + 1
    if w_said_starve == 0 {
        w_said_starve = 1
        serial.puts((&s_starve[0]) as u64)
        serial.nl()
    }
}

fn sys_hook(state: u64) {
    if w_spin_at == 0 || w_state != ST_ARMED || crash.rescued() {
        return
    }
    if kstate.get(state, kstate.TICKS) < w_spin_at {
        return
    }
    if w_spin_at != 1 {
        w_spin_at = 1
        planted_mark()
        serial.puts((&s_spin[0]) as u64)
        serial.nl()
    }
    while true {
        asm("sti")
        asm("pause")
    }
}

fn on_panic() {
    wdtmark.mark(wdtmark.ST_PANIC, 0)
    if w_state == ST_ARMED {
        w_state = ST_PANIC
    }
}

fn request_hang() -> bool {
    if w_state != ST_ARMED || w_proc_ok == 0 {
        return false
    }
    w_hang_req = 1
    return true
}

fn pause(state: u64) {
    if w_state != ST_ARMED {
        return
    }
    let _h: bool = tco.halt(tcochip.base())
    w_state = ST_PAUSED
    serial.puts((&s_pause[0]) as u64)
}

fn resume(state: u64) {
    if w_state != ST_PAUSED {
        return
    }
    let b: u64 = tcochip.base()
    tco.clear_status(b)
    let _t: bool = tco.set_ticks(b, w_tmr)
    let _n: bool = tcochip.noreboot_clear()
    tco.reload(b)
    let _r: bool = tco.run(b)
    let now: u64 = kstate.get(state, kstate.TICKS)
    w_last_check = now
    w_sys_moved_at = now
    w_last_feed = now
    w_state = ST_ARMED
    serial.puts((&s_resume[0]) as u64)
}

fn boot_report(state: u64) {
    klog.sayn(state, klog.L_INFO, (&s_ev_src[0]) as u64, (&s_ev_a[0]) as u64, w_ev_prev)
    klog.sayn(state, klog.L_INFO, (&s_ev_src[0]) as u64, (&s_ev_b[0]) as u64, w_info)
    klog.sayh(state, klog.L_INFO, (&s_ev_src[0]) as u64, (&s_ev_c[0]) as u64, w_ev_sts1)
    klog.sayh(state, klog.L_INFO, (&s_ev_src[0]) as u64, (&s_ev_d[0]) as u64, w_ev_sts2)
    klog.sayn(state, klog.L_INFO, (&s_ev_src[0]) as u64, (&s_ev_e[0]) as u64, w_last)
    klog.sayn(state, klog.L_INFO, (&s_ev_src[0]) as u64, (&s_ev_f[0]) as u64, w_detail)
    hangslot.prepare(state)
    let have: bool = hangslot.valid(state)
    if crash.rescued() || (w_last != LB_WATCHDOG && !have) {
        if have {
            hangslot.discard(state)
        }
        return
    }
    crash.hang_begin(state, crash.KIND_HANG)
    crash.p_str((&s_rp_r[0]) as u64)
    crash.p_str((&s_rp_w[0]) as u64)
    crash.p_nl()
    crash.p_str((&s_rp_s[0]) as u64)
    if w_detail == LD_FREEZE {
        crash.p_str((&s_rp_f[0]) as u64)
    } else if w_detail == LD_PLANTED {
        crash.p_str((&s_rp_p[0]) as u64)
    } else {
        crash.p_str((&s_rp_t[0]) as u64)
    }
    crash.p_nl()
    if w_detail == LD_FREEZE {
        crash.p_str((&s_rp_c[0]) as u64)
        crash.p_dec(w_info)
        crash.p_nl()
    }
    if have {
        crash.p_str((&s_rp_d[0]) as u64)
        crash.p_bytes(hangslot.data(), hangslot.take())
    } else {
        crash.p_str((&s_rp_n[0]) as u64)
    }
    let _w: bool = crash.hang_file(state)
    if have {
        hangslot.discard(state)
    }
}
