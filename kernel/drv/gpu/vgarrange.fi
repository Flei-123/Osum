profile kernel

import lib.kstate

export { arrangement_ok, STRIDE }

const STRIDE: u64 = 0x20

fn field(state: u64, base: u64, i: u64, f: u64) -> u64 {
    return kstate.get(state, base + i * STRIDE + f * 8)
}

fn overlaps(state: u64, base: u64, a: u64, b: u64) -> bool {
    let ax: u64 = field(state, base, a, 0)
    let ay: u64 = field(state, base, a, 1)
    let bx: u64 = field(state, base, b, 0)
    let by: u64 = field(state, base, b, 1)
    let ar: u64 = ax + field(state, base, a, 2)
    let ab: u64 = ay + field(state, base, a, 3)
    let br: u64 = bx + field(state, base, b, 2)
    let bb: u64 = by + field(state, base, b, 3)
    return ax < br && bx < ar && ay < bb && by < ab
}

fn span_overlap(a0: u64, a1: u64, b0: u64, b1: u64) -> bool {
    return a0 < b1 && b0 < a1
}

fn touches(state: u64, base: u64, a: u64, b: u64) -> bool {
    let ax: u64 = field(state, base, a, 0)
    let ay: u64 = field(state, base, a, 1)
    let bx: u64 = field(state, base, b, 0)
    let by: u64 = field(state, base, b, 1)
    let ar: u64 = ax + field(state, base, a, 2)
    let ab: u64 = ay + field(state, base, a, 3)
    let br: u64 = bx + field(state, base, b, 2)
    let bb: u64 = by + field(state, base, b, 3)
    if (ar == bx || br == ax) && span_overlap(ay, ab, by, bb) {
        return true
    }
    if (ab == by || bb == ay) && span_overlap(ax, ar, bx, br) {
        return true
    }
    return false
}

fn arrangement_ok(state: u64, base: u64, n: u64, bw: u64, bh: u64) -> bool {
    var used: u64 = 0
    var i: u64 = 0
    while i < n {
        if field(state, base, i, 2) != 0 {
            used = used + 1
            if field(state, base, i, 0) + field(state, base, i, 2) > bw {
                return false
            }
            if field(state, base, i, 1) + field(state, base, i, 3) > bh {
                return false
            }
        }
        i = i + 1
    }
    i = 0
    while i < n {
        if field(state, base, i, 2) != 0 {
            var j: u64 = i + 1
            while j < n {
                if field(state, base, j, 2) != 0 && overlaps(state, base, i, j) {
                    return false
                }
                j = j + 1
            }
            if used >= 2 {
                var near: bool = false
                var k: u64 = 0
                while k < n {
                    if k != i && field(state, base, k, 2) != 0 && touches(state, base, i, k) {
                        near = true
                    }
                    k = k + 1
                }
                if !near {
                    return false
                }
            }
        }
        i = i + 1
    }
    return true
}
