// ------------------------------------------------- der Datenbereich
const VGPU_OFF: u64 = 0xF2000
const VGPU_MAX: u64 = 0x1000

const S_COMMON: u64 = 0x000
const S_NOTIFY: u64 = 0x008
const S_NMULT: u64 = 0x010
const S_ISR: u64 = 0x018
const S_DEVCFG: u64 = 0x020
const S_BDF: u64 = 0x028
const S_IDX: u64 = 0x030
const S_READY: u64 = 0x038
const S_RING: u64 = 0x040
const S_DOOR: u64 = 0x048 // wo Warteschlange 0 geklopft wird
const S_AVAIL: u64 = 0x050 // eigene Kopie von avail.idx
const S_USED: u64 = 0x058 // letzter abgearbeiteter used.idx
const S_FEAT: u64 = 0x060
const S_SCANOUTS: u64 = 0x068
const S_SW: u64 = 0x070
const S_SH: u64 = 0x078
const S_RESID: u64 = 0x080
const S_BACK: u64 = 0x088
const S_BACKBYTES: u64 = 0x090
const S_TRANSFERS: u64 = 0x098 // wie oft TRANSFER_TO_HOST_2D lief
const S_FLUSHES: u64 = 0x0A0 // wie oft RESOURCE_FLUSH lief
const S_OKT: u64 = 0x0A8 // Oktette, die wirklich uebertragen wurden
const S_ERROR: u64 = 0x0B0
const S_EREIG: u64 = 0x0B8 // wie oft EVENT_DISPLAY kam
const S_NEUW: u64 = 0x0C0
const S_NEUH: u64 = 0x0C8
const S_UMGESTELLT: u64 = 0x0D0
const S_LASTERR: u64 = 0x0D8

// r808 multi-monitor, step 1: the OUTPUT TABLE. The device reports up to 16
// scanouts; the table keeps the first OUT_MAX (8, like lib/monitors/layout.fi)
// with connected flag, rect and size exactly as GET_DISPLAY_INFO said it.
// Head 0 is the primary (the one the compositor draws into); every further
// connected head is MIRRORED from the same resource (SET_SCANOUT with the
// same RES_ID) -- extend needs a per-output compositor and is a later step.
const S_HEADS: u64 = 0x180 // connected heads seen in the table
const S_MIRRORED: u64 = 0x188 // extra heads that now show the primary resource
const S_MIRERR: u64 = 0x190 // SET_SCANOUT refusals for extra heads
const S_OUTTAB: u64 = 0x200 // OUT_MAX entries of OUT_STRIDE bytes
// r815 EXTEND: with word `vgpuextend` and >= 2 connected heads the desktop is ONE wide
// resource (the fb back buffer, size = bounding box of the heads) and every head scans out
// its own RECT of it (SET_SCANOUT r.x/r.y/r.w/r.h). Zero copy: TRANSFER/FLUSH of the dirty
// rect is unchanged, the host refreshes every scanout the rect touches. Placement is
// lib/monitors/layout.fi pack_row (left to right in head order, tops at 0).
const S_EXTON: u64 = 0x198 // 1 = extend layout is active
const S_EXTPLACED: u64 = 0x1A0 // heads that now scan out their own rect
const S_EXTERR: u64 = 0x1A8 // SET_SCANOUT refusals while placing
const S_EXTCLIP: u64 = 0x1B0 // heads whose rect was cut because the fb is smaller than the layout
// r816 hotplug / r827 probe: S_HOTMASK = heads the test bed (`hdhot`) forced to look unplugged (bit n = head n);
// S_HOTS = how many times the extend layout was re-laid out; S_HOTGEN = generation counter the window server compares;
// S_UP = 1 once the device is up to and including GET_DISPLAY_INFO (probe_desktop may run before the fb exists).
const S_HOTMASK: u64 = 0x1B8
const S_HOTS: u64 = 0x1C0
const S_HOTGEN: u64 = 0x1C8
const S_RESIZES: u64 = 0x1D8 // how often the scan-out was rebuilt for a new size (host drag or mode switch)
const S_RSZERR: u64 = 0x1E0 // rebuilds that failed
const S_UP: u64 = 0x1D0
const S_MIRRORRT: u64 = 0x1E8
const S_EXTTAB: u64 = 0x500 // OUT_MAX entries of 32 bytes: x, y, w, h (0 w = head unused)
const EXT_STRIDE: u64 = 0x20
const OUT_MAX: u64 = 8
const OUT_STRIDE: u64 = 0x60
// r808 step 2: what GET_EDID said about the head (VIRTIO_GPU_F_EDID). O_EDID 1 = a valid base block was read.
const O_EDID: u64 = 0x28
const O_MMW: u64 = 0x30 // physical width in mm (EDID byte 21 is cm); 0 = unknown
const O_MMH: u64 = 0x38
const O_PW: u64 = 0x40 // preferred mode (first detailed timing)
const O_PH: u64 = 0x48
const O_MFR: u64 = 0x50 // three letters packed 'A'..'Z' as bytes (l0 | l1<<8 | l2<<16)
const O_SCALE: u64 = 0x58 // suggested UI scale in percent (same rule as lib/monitors layout.default_scale)
const O_CONN: u64 = 0x00
const O_X: u64 = 0x08
const O_Y: u64 = 0x10
const O_W: u64 = 0x18
const O_H: u64 = 0x20

const S_CDOOR: u64 = 0x0E0 // wo Warteschlange 1 geklopft wird
const S_CAVAIL: u64 = 0x0E8
const S_CUSED: u64 = 0x0F0 // letzter abgearbeiteter used.idx
const S_CRING: u64 = 0x0F8
const S_CURPIX: u64 = 0x100
const S_CURON: u64 = 0x108
const S_CURFORM: u64 = 0x110 // welche Form zuletzt hochgeladen wurde
const S_CURGR: u64 = 0x118 // in welcher Groesse
const S_CURDEF: u64 = 0x120
const S_CURMOVE: u64 = 0x128 // wie oft MOVE_CURSOR lief
const S_CURX: u64 = 0x130
const S_CURY: u64 = 0x138
const S_CURERR: u64 = 0x140

const QSIZE: u64 = 16
const DESC_OFF: u64 = 0x0000 // 16 * 16 = 256
const AVAIL_OFF: u64 = 0x1000 // 4 + 16*2 + 2 = 38
const USED_OFF: u64 = 0x2000 // 4 + 16*8 + 2 = 134
const CMD_OFF: u64 = 0x3000 // der Befehlspuffer
const RSP_OFF: u64 = 0x4000 // der Antwortpuffer
const CMD2_OFF: u64 = 0x5000
const RSP2_OFF: u64 = 0x6000
const RING_BYTES: u64 = 0x7000

const CDESC_OFF: u64 = 0x0000
const CAVAIL_OFF: u64 = 0x1000
const CUSED_OFF: u64 = 0x2000
const CCMD_OFF: u64 = 0x3000
const CRSP_OFF: u64 = 0x4000
const CRING_BYTES: u64 = 0x5000

const CMD_MAX: u64 = 512
const RSP_MAX: u64 = 512

// ----------------------------------------------------- die Konstanten

const VENDOR_VIRTIO: u64 = 0x1AF4
const CLASS_DISPLAY: u64 = 0x03
const SUB_OTHER: u64 = 0x80

const CAP_VENDOR: u64 = 0x09
const VC_TYPE: u64 = 3
const VC_BAR: u64 = 4
const VC_OFFSET: u64 = 8
const VC_LENGTH: u64 = 12
const VC_NOTIFY_MULT: u64 = 16

const CFG_COMMON: u64 = 1
const CFG_NOTIFY: u64 = 2
const CFG_ISR: u64 = 3
const CFG_DEVICE: u64 = 4

const C_DFSELECT: u64 = 0x00
const C_DFEATURE: u64 = 0x04
const C_GFSELECT: u64 = 0x08
const C_GFEATURE: u64 = 0x0C
const C_MSIX_CFG: u64 = 0x10
const C_NUMQ: u64 = 0x12
const C_STATUS: u64 = 0x14
const C_GENERATION: u64 = 0x15
const C_QSELECT: u64 = 0x16
const C_QSIZE: u64 = 0x18
const C_QMSIX: u64 = 0x1A
const C_QENABLE: u64 = 0x1C
const C_QNOTIFY_OFF: u64 = 0x1E
const C_QDESC: u64 = 0x20
const C_QDRIVER: u64 = 0x28
const C_QDEVICE: u64 = 0x30

const ST_ACK: u64 = 1
const ST_DRIVER: u64 = 2
const ST_DRIVER_OK: u64 = 4
const ST_FEATURES_OK: u64 = 8
const ST_FAILED: u64 = 128

const F_VERSION_1: u64 = 0
const F_EDID: u64 = 1 // VIRTIO_GPU_F_EDID -- die Tafelkennung

const NO_VECTOR: u64 = 0xFFFF
const D_NEXT: u64 = 1
const D_WRITE: u64 = 2

const G_EVENTS_READ: u64 = 0
const G_EVENTS_CLEAR: u64 = 4
const G_NUM_SCANOUTS: u64 = 8

const EVENT_DISPLAY: u64 = 1

const CMD_GET_DISPLAY_INFO: u64 = 0x0100
const CMD_RESOURCE_CREATE_2D: u64 = 0x0101
const CMD_SET_SCANOUT: u64 = 0x0103
const CMD_RESOURCE_FLUSH: u64 = 0x0104
const CMD_TRANSFER_TO_HOST_2D: u64 = 0x0105
const CMD_RESOURCE_ATTACH_BACKING: u64 = 0x0106
const CMD_RESOURCE_UNREF: u64 = 0x0102

const CMD_UPDATE_CURSOR: u64 = 0x0300
const CMD_MOVE_CURSOR: u64 = 0x0301

const RESP_OK_NODATA: u64 = 0x1100
const RESP_OK_DISPLAY_INFO: u64 = 0x1101
const RESP_OK_EDID: u64 = 0x1104
const CMD_GET_EDID: u64 = 0x010A

const FMT_B8G8R8X8: u64 = 2

const FMT_B8G8R8A8: u64 = 1

const RES_ID: u64 = 1

const CUR_RES_ID: u64 = 2

const CUR_W: u64 = 64
const CUR_H: u64 = 64
const CUR_BYTES: u64 = CUR_W * CUR_H * 4

const SPIN_LIMIT: u64 = 20000000

// --------------------------------------------------- kleine Helfer

fn s(off: u64) -> u64 {
    return VGPU_OFF + off
}

fn rd8(b: u64, off: u64) -> u64 {
    return __mmio_read8((b + off) as *mut u8) as u64
}

fn wr8(b: u64, off: u64, v: u64) {
    __mmio_write8((b + off) as *mut u8, v as u8)
}

fn rd16(b: u64, off: u64) -> u64 {
    return __mmio_read16((b + off) as *mut u16) as u64
}

fn wr16(b: u64, off: u64, v: u64) {
    __mmio_write16((b + off) as *mut u16, v as u16)
}

fn rd32(b: u64, off: u64) -> u64 {
    return __mmio_read32((b + off) as *mut u32) as u64
}

fn wr32(b: u64, off: u64, v: u64) {
    __mmio_write32((b + off) as *mut u32, v as u32)
}

fn wr64(b: u64, off: u64, v: u64) {
    wr32(b, off, v & 0xFFFFFFFF)
    wr32(b, off + 4, v >> 32)
}

fn common(state: u64) -> u64 {
    return kstate.get(state, s(S_COMMON))
}

fn usable(state: u64) -> bool {
    return kstate.get(state, s(S_READY)) != 0
}

fn bdf(state: u64) -> u64 { return kstate.get(state, s(S_BDF)) }
fn idx(state: u64) -> u64 { return kstate.get(state, s(S_IDX)) }
fn scanout_w(state: u64) -> u64 { return kstate.get(state, s(S_SW)) }
fn scanout_h(state: u64) -> u64 { return kstate.get(state, s(S_SH)) }
fn scanouts(state: u64) -> u64 { return kstate.get(state, s(S_SCANOUTS)) }
fn transfers(state: u64) -> u64 { return kstate.get(state, s(S_TRANSFERS)) }
fn flushes(state: u64) -> u64 { return kstate.get(state, s(S_FLUSHES)) }
fn oktette(state: u64) -> u64 { return kstate.get(state, s(S_OKT)) }
fn error_count(state: u64) -> u64 { return kstate.get(state, s(S_ERROR)) }
fn ereignisse(state: u64) -> u64 { return kstate.get(state, s(S_EREIG)) }
fn new_w(state: u64) -> u64 { return kstate.get(state, s(S_NEUW)) }
fn new_h(state: u64) -> u64 { return kstate.get(state, s(S_NEUH)) }
fn umgestellt(state: u64) -> u64 { return kstate.get(state, s(S_UMGESTELLT)) }

// ------------------------------------------------ der geteilte Ring

fn desc_set(table: u64, i: u64, addr: u64, len: u64, flags: u64, next: u64) {
    let d: u64 = table + i * 16
    wr64(d, 0, addr)
    wr32(d, 8, len)
    wr16(d, 12, flags)
    wr16(d, 14, next)
}

fn avail_put(a: u64, slot: u64, desc: u64) {
    wr16(a, 4 + slot * 2, desc)
}

fn avail_publish(a: u64, v: u64) {
    wr16(a, 2, v & 0xFFFF)
}

fn used_idx(u: u64) -> u64 {
    return rd16(u, 2)
}

fn kick(state: u64) {
    let door: u64 = kstate.get(state, s(S_DOOR))
    if door == 0 {
        return
    }
    wr16(door, 0, 0)
}

// -------------------------------------------------- die Faehigkeiten

fn find_vcap(d: u64, want: u64) -> u64 {
    if (pci.cfg_read16(d, 0x06) & 0x10) == 0 {
        return 0
    }
    var off: u64 = pci.cfg_read8(d, 0x34) & 0xFC
    var guard: u64 = 0
    while off >= 0x40 && guard < 48 {
        if pci.cfg_read8(d, off) == CAP_VENDOR {
            if pci.cfg_read8(d, off + VC_TYPE) == want {
                return off
            }
        }
        off = pci.cfg_read8(d, off + 1) & 0xFC
        guard = guard + 1
    }
    return 0
}

fn region(state: u64, i: u64, d: u64, cap: u64) -> u64 {
    if cap == 0 {
        return 0
    }
    let which: u64 = pci.cfg_read8(d, cap + VC_BAR)
    if which >= 6 {
        return 0
    }
    let phys: u64 = pci.bar(state, i, which)
    if phys == 0 || pci.bar_is_io(state, i, which) {
        return 0
    }
    let off: u64 = pci.cfg_read32(d, cap + VC_OFFSET)
    return apic.map_device(state, phys + off)
}

fn status(state: u64) -> u64 {
    return rd8(common(state), C_STATUS)
}

fn status_add(state: u64, bits: u64) {
    wr8(common(state), C_STATUS, status(state) | bits)
}

fn reset(state: u64) -> bool {
    wr8(common(state), C_STATUS, 0)
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        if rd8(common(state), C_STATUS) == 0 {
            return true
        }
        arch.pause()
        spin = spin + 1
    }
    return false
}

fn find(state: u64) -> u64 {
    let n: u64 = pci.count(state)
    var i: u64 = 0
    while i < n {
        if pci.get(state, i, pci.E_VENDOR) == VENDOR_VIRTIO {
            if pci.get(state, i, pci.E_CLASS) == CLASS_DISPLAY {
                return i
            }
        }
        i = i + 1
    }
    return pci.MAX_DEV
}

// ------------------------------------------------------ die Aushandlung

fn negotiate(state: u64) -> bool {
    let b: u64 = common(state)
    wr32(b, C_DFSELECT, 0)
    let dev_lo: u64 = rd32(b, C_DFEATURE)
    wr32(b, C_DFSELECT, 1)
    let dev_hi: u64 = rd32(b, C_DFEATURE)

    if (dev_hi & (1 << F_VERSION_1)) == 0 {
        return false
    }
    let lo: u64 = dev_lo & (1 << F_EDID)
    let hi: u64 = 1 << F_VERSION_1

    wr32(b, C_GFSELECT, 0)
    wr32(b, C_GFEATURE, lo)
    wr32(b, C_GFSELECT, 1)
    wr32(b, C_GFEATURE, hi)
    kstate.set(state, s(S_FEAT), lo)

    status_add(state, ST_FEATURES_OK)
    if (status(state) & ST_FEATURES_OK) == 0 {
        return false
    }
    return true
}

fn queue_setup(state: u64) -> bool {
    let b: u64 = common(state)
    let r: u64 = kstate.get(state, s(S_RING))
    wr16(b, C_QSELECT, 0)
    let offered: u64 = rd16(b, C_QSIZE)
    if offered == 0 {
        return false
    }
    if offered > QSIZE {
        wr16(b, C_QSIZE, QSIZE)
    }
    if rd16(b, C_QSIZE) != QSIZE {
        return false
    }
    wr64(b, C_QDESC, r + DESC_OFF)
    wr64(b, C_QDRIVER, r + AVAIL_OFF)
    wr64(b, C_QDEVICE, r + USED_OFF)
    wr16(b, C_QMSIX, NO_VECTOR)
    let door: u64 = kstate.get(state, s(S_NOTIFY))
        + rd16(b, C_QNOTIFY_OFF) * kstate.get(state, s(S_NMULT))
    kstate.set(state, s(S_DOOR), door)
    wr16(b, C_QENABLE, 1)
    return rd16(b, C_QENABLE) == 1
}

// ======================= RUNDE GPU (G-012): DIE ZWEITE WARTESCHLANGE
fn cursor_queue_setup(state: u64) -> bool {
    let b: u64 = common(state)
    if rd16(b, C_NUMQ) < 2 {
        return false
    }
    let cr: u64 = mem.frame_run(state, CRING_BYTES / mem.FRAME_SIZE)
    if cr == 0 {
        return false
    }
    var z: u64 = 0
    while z < CRING_BYTES {
        __mmio_write64((cr + z) as *mut u64, 0)
        z = z + 8
    }
    kstate.set(state, s(S_CRING), cr)
    kstate.set(state, s(S_CAVAIL), 0)
    kstate.set(state, s(S_CUSED), 0)

    wr16(b, C_QSELECT, 1)
    let offered: u64 = rd16(b, C_QSIZE)
    if offered == 0 {
        return false
    }
    if offered > QSIZE {
        wr16(b, C_QSIZE, QSIZE)
    }
    if rd16(b, C_QSIZE) != QSIZE {
        return false
    }
    wr64(b, C_QDESC, cr + CDESC_OFF)
    wr64(b, C_QDRIVER, cr + CAVAIL_OFF)
    wr64(b, C_QDEVICE, cr + CUSED_OFF)
    wr16(b, C_QMSIX, NO_VECTOR)
    let cdoor: u64 = kstate.get(state, s(S_NOTIFY))
        + rd16(b, C_QNOTIFY_OFF) * kstate.get(state, s(S_NMULT))
    kstate.set(state, s(S_CDOOR), cdoor)
    wr16(b, C_QENABLE, 1)
    return rd16(b, C_QENABLE) == 1
}

fn command(state: u64, length: u64, erwartet: u64) -> bool {
    let r: u64 = kstate.get(state, s(S_RING))
    let desc: u64 = r + DESC_OFF
    let avail: u64 = r + AVAIL_OFF
    let used: u64 = r + USED_OFF
    let cmd: u64 = r + CMD_OFF
    let rsp: u64 = r + RSP_OFF

    var z: u64 = 0
    while z < 32 {
        __mmio_write64((rsp + z) as *mut u64, 0)
        z = z + 8
    }

    desc_set(desc, 0, cmd, length, D_NEXT, 1)
    desc_set(desc, 1, rsp, RSP_MAX, D_WRITE, 0)

    let vor: u64 = used_idx(used)
    var ai: u64 = kstate.get(state, s(S_AVAIL))
    avail_put(avail, ai % QSIZE, 0)
    arch.barrier_write()
    ai = ai + 1
    avail_publish(avail, ai)
    kstate.set(state, s(S_AVAIL), ai)
    arch.barrier_write()
    kick(state)

    var spin: u64 = 0
    var da: bool = false
    while spin < SPIN_LIMIT {
        if used_idx(used) != vor {
            da = true
            spin = SPIN_LIMIT
        } else {
            arch.pause()
            spin = spin + 1
        }
    }
    if !da {
        kstate.add(state, s(S_ERROR), 1)
        return false
    }
    arch.barrier_read()
    kstate.set(state, s(S_USED), used_idx(used))

    let typ: u64 = rd32(rsp, 0)
    if typ != erwartet {
        kstate.add(state, s(S_ERROR), 1)
        kstate.set(state, s(S_LASTERR), typ)
        return false
    }
    return true
}

fn command_pair(state: u64, length1: u64, length2: u64) -> bool {
    let r: u64 = kstate.get(state, s(S_RING))
    let desc: u64 = r + DESC_OFF
    let avail: u64 = r + AVAIL_OFF
    let used: u64 = r + USED_OFF

    var z: u64 = 0
    while z < 32 {
        __mmio_write64((r + RSP_OFF + z) as *mut u64, 0)
        __mmio_write64((r + RSP2_OFF + z) as *mut u64, 0)
        z = z + 8
    }

    // Kette 1: Deskriptor 0 (Befehl) -> 1 (Antwort).
    desc_set(desc, 0, r + CMD_OFF, length1, D_NEXT, 1)
    desc_set(desc, 1, r + RSP_OFF, RSP_MAX, D_WRITE, 0)
    // Kette 2: Deskriptor 2 (Befehl) -> 3 (Antwort).
    desc_set(desc, 2, r + CMD2_OFF, length2, D_NEXT, 3)
    desc_set(desc, 3, r + RSP2_OFF, RSP_MAX, D_WRITE, 0)

    let vor: u64 = used_idx(used)
    var ai: u64 = kstate.get(state, s(S_AVAIL))
    avail_put(avail, ai % QSIZE, 0)
    avail_put(avail, (ai + 1) % QSIZE, 2)
    arch.barrier_write()
    ai = ai + 2
    avail_publish(avail, ai)
    kstate.set(state, s(S_AVAIL), ai)
    arch.barrier_write()
    kick(state)

    var spin: u64 = 0
    var fertig: bool = false
    while spin < SPIN_LIMIT {
        let now: u64 = used_idx(used)
        if ((now -% vor) & 0xFFFF) >= 2 {
            fertig = true
            spin = SPIN_LIMIT
        } else {
            arch.pause()
            spin = spin + 1
        }
    }
    if !fertig {
        kstate.add(state, s(S_ERROR), 1)
        return false
    }
    arch.barrier_read()
    kstate.set(state, s(S_USED), used_idx(used))

    let t1: u64 = rd32(r + RSP_OFF, 0)
    let t2: u64 = rd32(r + RSP2_OFF, 0)
    if t1 != RESP_OK_NODATA || t2 != RESP_OK_NODATA {
        kstate.add(state, s(S_ERROR), 1)
        var bad: u64 = t1
        if t1 == RESP_OK_NODATA {
            bad = t2
        }
        kstate.set(state, s(S_LASTERR), bad)
        return false
    }
    return true
}

fn header(cmd: u64, typ: u64) {
    var z: u64 = 0
    while z < CMD_MAX {
        __mmio_write64((cmd + z) as *mut u64, 0)
        z = z + 8
    }
    wr32(cmd, 0, typ)
}

// ------------------------------------------------ die sechs Befehle

fn display_info(state: u64) -> bool {
    let r: u64 = kstate.get(state, s(S_RING))
    let cmd: u64 = r + CMD_OFF
    let rsp: u64 = r + RSP_OFF
    header(cmd, CMD_GET_DISPLAY_INFO)
    if !command(state, 24, RESP_OK_DISPLAY_INFO) {
        return false
    }
    let n: u64 = kstate.get(state, s(S_SCANOUTS))
    var i: u64 = 0
    var found: bool = false
    var heads: u64 = 0
    let forced: bool = kstate.mode_on(state, kstate.M_VGPUHEADS)
    while i < n && i < 16 {
        let e: u64 = rsp + 24 + i * 24
        let angeschlossen: u64 = rd32(e, 16)
        let w: u64 = rd32(e, 8)
        let h: u64 = rd32(e, 12)
        // TOCTOU audit F-08: the size is the device's word; anything above 16384 is not a display (and w * 4 * h must not wrap)
        var ok: bool = angeschlossen != 0 && w != 0 && h != 0 && w <= 16384 && h <= 16384
        // Test bed word `vgpuheads`: QEMU without a GUI backend never flags head >= 1 as enabled.
        var w2: u64 = w
        var h2: u64 = h
        if !ok && i >= 1 && i < OUT_MAX && forced && found {
            w2 = kstate.get(state, s(S_SW))
            h2 = kstate.get(state, s(S_SH))
            if kstate.mode_on(state, kstate.M_VGPUSHORT) {
                h2 = h2 * 9 / 10
            }
            ok = true
        }
        // r816 test bed: a head the `hdhot` demo unplugged looks disconnected.
        if i < OUT_MAX && ((kstate.get(state, s(S_HOTMASK)) >> i) & 1) != 0 {
            ok = false
        }
        if i < OUT_MAX {
            let o: u64 = S_OUTTAB + i * OUT_STRIDE
            if ok {
                kstate.set(state, s(o + O_CONN), 1)
                kstate.set(state, s(o + O_X), rd32(e, 0))
                kstate.set(state, s(o + O_Y), rd32(e, 4))
                kstate.set(state, s(o + O_W), w2)
                kstate.set(state, s(o + O_H), h2)
                heads = heads + 1
            } else {
                kstate.set(state, s(o + O_CONN), 0)
                kstate.set(state, s(o + O_W), 0)
                kstate.set(state, s(o + O_H), 0)
            }
        }
        if ok && !found {
            kstate.set(state, s(S_SW), w)
            kstate.set(state, s(S_SH), h)
            found = true
        }
        i = i + 1
    }
    kstate.set(state, s(S_HEADS), heads)
    return found
}

// Snap a DPI-derived percent to the steps a settings page offers
// (same table as lib/monitors/layout.fi snap_scale).
fn snap_scale(pct: u64) -> u64 {
    if pct <= 112 { return 100 }
    if pct <= 137 { return 125 }
    if pct <= 162 { return 150 }
    if pct <= 187 { return 175 }
    if pct <= 225 { return 200 }
    if pct <= 275 { return 250 }
    return 300
}

// GET_EDID for one head, parse the 128-byte base block into the table.
// Reply: header (24), size u32, padding u32, edid[1024]; only the base block is read.
// Nothing here may fail the driver: a head without a usable EDID keeps O_EDID = 0.
fn read_edid(state: u64, head: u64) {
    let o: u64 = S_OUTTAB + head * OUT_STRIDE
    kstate.set(state, s(o + O_EDID), 0)
    kstate.set(state, s(o + O_SCALE), 100)
    if (kstate.get(state, s(S_FEAT)) & (1 << F_EDID)) == 0 {
        return
    }
    let r: u64 = kstate.get(state, s(S_RING))
    let cmd: u64 = r + CMD_OFF
    let rsp: u64 = r + RSP_OFF
    header(cmd, CMD_GET_EDID)
    wr32(cmd, 24, head)
    if !command(state, 32, RESP_OK_EDID) {
        return
    }
    let size: u64 = rd32(rsp, 24)
    if size < 128 {
        return
    }
    let e: u64 = rsp + 32
    // Header 00 FF FF FF FF FF FF 00 and a base block that sums to 0 (mod 256).
    if rd8(e, 0) != 0 || rd8(e, 7) != 0 {
        return
    }
    var k: u64 = 1
    while k < 7 {
        if rd8(e, k) != 255 { return }
        k = k + 1
    }
    var sum: u64 = 0
    k = 0
    while k < 128 {
        sum = sum + rd8(e, k)
        k = k + 1
    }
    if (sum % 256) != 0 {
        return
    }
    // Manufacturer id: bytes 8..9, three 5-bit letters (1 = 'A').
    let m: u64 = (rd8(e, 8) << 8) | rd8(e, 9)
    let l0: u64 = ((m >> 10) & 31) + 64
    let l1: u64 = ((m >> 5) & 31) + 64
    let l2: u64 = (m & 31) + 64
    kstate.set(state, s(o + O_MFR), l0 | (l1 << 8) | (l2 << 16))
    // Physical size in cm (bytes 21, 22); 0 = unknown (projector / variable).
    let mmw: u64 = rd8(e, 21) * 10
    let mmh: u64 = rd8(e, 22) * 10
    kstate.set(state, s(o + O_MMW), mmw)
    kstate.set(state, s(o + O_MMH), mmh)
    // Preferred mode: first detailed timing descriptor at byte 54 (pixel clock != 0).
    var pw: u64 = 0
    var ph: u64 = 0
    if (rd8(e, 54) | rd8(e, 55)) != 0 {
        pw = rd8(e, 56) | ((rd8(e, 58) & 240) << 4)
        ph = rd8(e, 59) | ((rd8(e, 61) & 240) << 4)
    }
    kstate.set(state, s(o + O_PW), pw)
    kstate.set(state, s(o + O_PH), ph)
    // Suggested scale from the head's real width in pixels.
    var sc: u64 = 100
    let wpx: u64 = kstate.get(state, s(o + O_W))
    if mmw != 0 && wpx != 0 {
        let pct: u64 = (wpx * 2540) / (mmw * 96)
        if pct >= 100 {
            sc = snap_scale(pct)
        }
    }
    kstate.set(state, s(o + O_SCALE), sc)
    kstate.set(state, s(o + O_EDID), 1)
}

fn read_all_edid(state: u64) {
    var i: u64 = 0
    while i < OUT_MAX {
        if head_connected(state, i) {
            read_edid(state, i)
        }
        i = i + 1
    }
}

fn head_edid_ok(state: u64, i: u64) -> bool {
    if i >= OUT_MAX { return false }
    return kstate.get(state, s(S_OUTTAB + i * OUT_STRIDE + O_EDID)) != 0
}
fn head_mm_w(state: u64, i: u64) -> u64 {
    if i >= OUT_MAX { return 0 }
    return kstate.get(state, s(S_OUTTAB + i * OUT_STRIDE + O_MMW))
}
fn head_scale(state: u64, i: u64) -> u64 {
    if i >= OUT_MAX { return 100 }
    return kstate.get(state, s(S_OUTTAB + i * OUT_STRIDE + O_SCALE))
}

// Output table accessors (r808). `i` >= OUT_MAX reads as "not connected".
fn head_count(state: u64) -> u64 { return kstate.get(state, s(S_HEADS)) }
fn head_mirrored(state: u64) -> u64 { return kstate.get(state, s(S_MIRRORED)) }
fn head_mirror_errors(state: u64) -> u64 { return kstate.get(state, s(S_MIRERR)) }
fn head_connected(state: u64, i: u64) -> bool {
    if i >= OUT_MAX { return false }
    return kstate.get(state, s(S_OUTTAB + i * OUT_STRIDE + O_CONN)) != 0
}
fn head_w(state: u64, i: u64) -> u64 {
    if i >= OUT_MAX { return 0 }
    return kstate.get(state, s(S_OUTTAB + i * OUT_STRIDE + O_W))
}
fn head_h(state: u64, i: u64) -> u64 {
    if i >= OUT_MAX { return 0 }
    return kstate.get(state, s(S_OUTTAB + i * OUT_STRIDE + O_H))
}

// ---------------------------------------------------------------- r815 extend
fn ext_active(state: u64) -> bool { return kstate.get(state, s(S_EXTON)) != 0 }
fn ext_placed(state: u64) -> u64 { return kstate.get(state, s(S_EXTPLACED)) }
fn ext_errors(state: u64) -> u64 { return kstate.get(state, s(S_EXTERR)) }
fn ext_clipped(state: u64) -> u64 { return kstate.get(state, s(S_EXTCLIP)) }
fn ext_x(state: u64, i: u64) -> u64 {
    if i >= OUT_MAX { return 0 }
    return kstate.get(state, s(S_EXTTAB + i * EXT_STRIDE))
}
fn ext_y(state: u64, i: u64) -> u64 {
    if i >= OUT_MAX { return 0 }
    return kstate.get(state, s(S_EXTTAB + i * EXT_STRIDE + 8))
}
fn ext_w(state: u64, i: u64) -> u64 {
    if i >= OUT_MAX { return 0 }
    return kstate.get(state, s(S_EXTTAB + i * EXT_STRIDE + 16))
}
fn ext_h(state: u64, i: u64) -> u64 {
    if i >= OUT_MAX { return 0 }
    return kstate.get(state, s(S_EXTTAB + i * EXT_STRIDE + 24))
}
// Which head shows desktop pixel (x, y)? 8 = none (outside every rect).
fn ext_head_at(state: u64, x: u64, y: u64) -> u64 {
    var i: u64 = 0
    while i < OUT_MAX {
        let w: u64 = ext_w(state, i)
        if w != 0 && x >= ext_x(state, i) && x < ext_x(state, i) + w && y >= ext_y(state, i) && y < ext_y(state, i) + ext_h(state, i) {
            return i
        }
        i = i + 1
    }
    return OUT_MAX
}

// SET_SCANOUT with an explicit rect of the (single) desktop resource.
fn set_scanout_rect(state: u64, id: u64, x: u64, y: u64, w: u64, h: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    header(cmd, CMD_SET_SCANOUT)
    wr32(cmd, 24, x)
    wr32(cmd, 28, y)
    wr32(cmd, 32, w)
    wr32(cmd, 36, h)
    wr32(cmd, 40, id)
    wr32(cmd, 44, RES_ID)
    return command(state, 48, RESP_OK_NODATA)
}

// Lay the connected heads out left to right (pack_row) inside the desktop resource of
// size bw x bh and switch every head to its rect. Heads that do not fit are cut or skipped
// (counted in S_EXTCLIP), a refusal is counted in S_EXTERR. Returns the number placed.
fn ext_place_mirror(state: u64, bw: u64, bh: u64) -> u64 {
    var placed: u64 = 0
    var mw: u64 = 0
    var mh: u64 = 0
    var hd: u64 = 0
    while hd < OUT_MAX {
        let tb: u64 = S_EXTTAB + hd * EXT_STRIDE
        kstate.set(state, s(tb + 16), 0)
        if head_connected(state, hd) {
            if mw == 0 {
                mw = head_w(state, hd)
                mh = head_h(state, hd)
                if mw > bw {
                    mw = bw
                    kstate.add(state, s(S_EXTCLIP), 1)
                }
                if mh > bh {
                    mh = bh
                    kstate.add(state, s(S_EXTCLIP), 1)
                }
                if mw != 0 && set_scanout_rect(state, hd, 0, 0, mw, mh) {
                    kstate.set(state, s(tb), 0)
                    kstate.set(state, s(tb + 8), 0)
                    kstate.set(state, s(tb + 16), mw)
                    kstate.set(state, s(tb + 24), mh)
                    placed = placed + 1
                } else {
                    kstate.add(state, s(S_EXTERR), 1)
                }
            } else if mw != 0 {
                if !set_scanout_rect(state, hd, 0, 0, mw, mh) {
                    kstate.add(state, s(S_EXTERR), 1)
                }
            }
        }
        hd = hd + 1
    }
    kstate.set(state, s(S_EXTPLACED), placed)
    return placed
}

fn mirror_active(state: u64) -> bool { return kstate.get(state, s(S_MIRRORRT)) != 0 }

fn ext_place(state: u64, bw: u64, bh: u64) -> u64 {
    if mirror_active(state) {
        return ext_place_mirror(state, bw, bh)
    }
    var x: u64 = 0
    var placed: u64 = 0
    var hd: u64 = 0
    while hd < OUT_MAX {
        let tb: u64 = S_EXTTAB + hd * EXT_STRIDE
        kstate.set(state, s(tb + 16), 0)
        if head_connected(state, hd) {
            var w: u64 = head_w(state, hd)
            var h: u64 = head_h(state, hd)
            if x < bw && w != 0 && h != 0 {
                if x + w > bw {
                    w = bw - x
                    kstate.add(state, s(S_EXTCLIP), 1)
                }
                if h > bh {
                    h = bh
                    kstate.add(state, s(S_EXTCLIP), 1)
                }
                if set_scanout_rect(state, hd, x, 0, w, h) {
                    kstate.set(state, s(tb), x)
                    kstate.set(state, s(tb + 8), 0)
                    kstate.set(state, s(tb + 16), w)
                    kstate.set(state, s(tb + 24), h)
                    placed = placed + 1
                } else {
                    kstate.add(state, s(S_EXTERR), 1)
                }
                x = x + head_w(state, hd)
            } else {
                kstate.add(state, s(S_EXTCLIP), 1)
            }
        }
        hd = hd + 1
    }
    kstate.set(state, s(S_EXTPLACED), placed)
    return placed
}

// SET_SCANOUT with resource 0 = switch the head off (virtio spec 5.7.6.8).
fn scanout_off(state: u64, id: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    header(cmd, CMD_SET_SCANOUT)
    wr32(cmd, 24, 0)
    wr32(cmd, 28, 0)
    wr32(cmd, 32, 0)
    wr32(cmd, 36, 0)
    wr32(cmd, 40, id)
    wr32(cmd, 44, 0)
    return command(state, 48, RESP_OK_NODATA)
}

// r816 HOTPLUG RE-LAYOUT (extend only). The device told us (EVENT_DISPLAY) or the test bed flipped a head:
// read the table again, switch the scanouts of heads that went away off, lay the connected ones out again
// (pack_row, inside the SAME desktop resource: the fb cannot grow at run time, a head that does not fit is
// cut or skipped and counted in extc) and push the whole picture once. Bumps the generation the window
// server compares. Returns false when nothing could be done.
fn relayout(state: u64) -> bool {
    if !usable(state) || kstate.get(state, s(S_EXTON)) == 0 {
        return false
    }
    let bw: u64 = kstate.get(state, s(S_SW))
    let bh: u64 = kstate.get(state, s(S_SH))
    if !display_info(state) {
        kstate.set(state, s(S_SW), bw)
        kstate.set(state, s(S_SH), bh)
        return false
    }
    kstate.set(state, s(S_SW), bw)
    kstate.set(state, s(S_SH), bh)
    var hd: u64 = 0
    while hd < OUT_MAX {
        if ext_w(state, hd) != 0 && !head_connected(state, hd) {
            if !scanout_off(state, hd) {
                kstate.add(state, s(S_EXTERR), 1)
            }
        }
        hd = hd + 1
    }
    kstate.set(state, s(S_EXTCLIP), 0)
    let placed: u64 = ext_place(state, bw, bh)
    kstate.add(state, s(S_HOTS), 1)
    kstate.add(state, s(S_HOTGEN), 1)
    if placed == 0 {
        return false
    }
    if !transfer(state, 0, 0, bw, bh, 0) {
        return false
    }
    return resource_flush(state, 0, 0, bw, bh)
}

fn set_mirror(state: u64, on: bool) -> bool {
    if !usable(state) || kstate.get(state, s(S_EXTON)) == 0 {
        return false
    }
    if on && kstate.get(state, s(S_HEADS)) < 2 {
        return false
    }
    var want: u64 = 0
    if on {
        want = 1
    }
    let was: u64 = kstate.get(state, s(S_MIRRORRT))
    kstate.set(state, s(S_MIRRORRT), want)
    if relayout(state) {
        return true
    }
    kstate.set(state, s(S_MIRRORRT), was)
    return false
}

// Test bed: flip "head hd looks unplugged" and re-lay out. Head 0 is never flipped (it is the primary).
fn hot_toggle(state: u64, hd: u64) -> bool {
    if hd == 0 || hd >= OUT_MAX {
        return false
    }
    let m: u64 = kstate.get(state, s(S_HOTMASK))
    kstate.set(state, s(S_HOTMASK), m ^ (1 << hd))
    return relayout(state)
}
fn hot_count(state: u64) -> u64 { return kstate.get(state, s(S_HOTS)) }
fn hot_gen(state: u64) -> u64 { return kstate.get(state, s(S_HOTGEN)) }

// Test image for the gates (word fbtest + vgpuextend): one solid box per head, a different
// colour per head, so a screendump of head N can tell its own rect from the others.
fn ext_testimage(state: u64) {
    if !ext_active(state) { return }
    var hd: u64 = 0
    while hd < OUT_MAX {
        let w: u64 = ext_w(state, hd)
        if w >= 160 && ext_h(state, hd) >= 160 {
            var r: u64 = 0xFF
            var g: u64 = 0
            var b: u64 = 0xFF
            if hd == 1 { r = 0; g = 0xFF; b = 0xFF }
            if hd == 2 { r = 0xFF; g = 0xFF; b = 0 }
            if hd >= 3 { r = 0x80; g = 0x80; b = 0xFF }
            fb.fill(state, ext_x(state, hd) + 100, 120, 160, 160, fb.rgb(state, r, g, b))
        }
        hd = hd + 1
    }
    if kstate.mode_on(state, kstate.M_VGPURTMIR) {
        let _m: bool = set_mirror(state, true)
    }
}

fn resource_create(state: u64, w: u64, h: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    header(cmd, CMD_RESOURCE_CREATE_2D)
    wr32(cmd, 24, RES_ID)
    wr32(cmd, 28, FMT_B8G8R8X8)
    wr32(cmd, 32, w)
    wr32(cmd, 36, h)
    return command(state, 40, RESP_OK_NODATA)
}

fn attach_backing(state: u64, phys: u64, bytes: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    header(cmd, CMD_RESOURCE_ATTACH_BACKING)
    wr32(cmd, 24, RES_ID)
    wr32(cmd, 28, 1)
    wr64(cmd, 32, phys)
    wr32(cmd, 40, bytes)
    wr32(cmd, 44, 0)
    return command(state, 48, RESP_OK_NODATA)
}

fn set_scanout(state: u64, w: u64, h: u64) -> bool {
    return set_scanout_id(state, 0, w, h)
}

fn set_scanout_id(state: u64, id: u64, w: u64, h: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    header(cmd, CMD_SET_SCANOUT)
    wr32(cmd, 24, 0) // r.x
    wr32(cmd, 28, 0) // r.y
    wr32(cmd, 32, w)
    wr32(cmd, 36, h)
    wr32(cmd, 40, id) // scanout_id
    wr32(cmd, 44, RES_ID)
    return command(state, 48, RESP_OK_NODATA)
}

fn transfer(state: u64, x: u64, y: u64, w: u64, h: u64, offset: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    header(cmd, CMD_TRANSFER_TO_HOST_2D)
    wr32(cmd, 24, x)
    wr32(cmd, 28, y)
    wr32(cmd, 32, w)
    wr32(cmd, 36, h)
    wr64(cmd, 40, offset)
    wr32(cmd, 48, RES_ID)
    wr32(cmd, 52, 0)
    return command(state, 56, RESP_OK_NODATA)
}

fn resource_flush(state: u64, x: u64, y: u64, w: u64, h: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    header(cmd, CMD_RESOURCE_FLUSH)
    wr32(cmd, 24, x)
    wr32(cmd, 28, y)
    wr32(cmd, 32, w)
    wr32(cmd, 36, h)
    wr32(cmd, 40, RES_ID)
    wr32(cmd, 44, 0)
    return command(state, 48, RESP_OK_NODATA)
}

fn cursor_command(state: u64, typ: u64, x: u64, y: u64, res: u64,
    hx: u64, hy: u64) -> bool {
    let cr: u64 = kstate.get(state, s(S_CRING))
    if cr == 0 {
        return false
    }
    let desc: u64 = cr + CDESC_OFF
    let avail: u64 = cr + CAVAIL_OFF
    let cmd: u64 = cr + CCMD_OFF

    var z: u64 = 0
    while z < 64 {
        __mmio_write64((cmd + z) as *mut u64, 0)
        z = z + 8
    }
    wr32(cmd, 0, typ)
    wr32(cmd, 24, 0) // scanout_id
    wr32(cmd, 28, x)
    wr32(cmd, 32, y)
    wr32(cmd, 36, 0) // Fuellung
    wr32(cmd, 40, res)
    wr32(cmd, 44, hx)
    wr32(cmd, 48, hy)
    wr32(cmd, 52, 0) // Fuellung

    var ai: u64 = kstate.get(state, s(S_CAVAIL))
    let slot: u64 = (ai % (QSIZE / 2)) * 2
    desc_set(desc, slot, cmd, 56, D_NEXT, slot + 1)
    desc_set(desc, slot + 1, cr + CRSP_OFF, RSP_MAX, D_WRITE, 0)
    avail_put(avail, ai % QSIZE, slot)
    arch.barrier_write()
    ai = ai + 1
    avail_publish(avail, ai)
    kstate.set(state, s(S_CAVAIL), ai)
    arch.barrier_write()
    let door: u64 = kstate.get(state, s(S_CDOOR))
    if door != 0 {
        wr16(door, 0, 0)
    }
    return true
}

fn cursor_fill_image(state: u64, form: u64, g: u64, rq: u64) {
    let pix: u64 = kstate.get(state, s(S_CURPIX))
    if pix == 0 {
        return
    }
    var z: u64 = 0
    while z < CUR_BYTES {
        __mmio_write64((pix + z) as *mut u64, 0)
        z = z + 8
    }
    if g == 0 || g > CUR_W {
        return
    }
    cursor.build_map(form, g)
    var r: u64 = 0
    while r < g {
        var c: u64 = 0
        while c < g {
            let v: u64 = cursor.deck_rot(g, rq, c, r)
            if v != 0 {
                let ak: u64 = (v >> 16) & 255
                let ar: u64 = (v >> 8) & 255
                let asch: u64 = v & 255
                var rr: u64 = 0
                var gg: u64 = 0
                var bb: u64 = 0
                var aa: u64 = 0
                if asch != 0 && ak == 0 && ar == 0 {
                    let a1: u64 = asch * 90 / 255
                    aa = a1
                    rr = 0
                    gg = 0
                    bb = 0
                }
                if ar != 0 {
                    // weiss darueber
                    rr = rr + (255 - rr) * ar / 255
                    gg = gg + (255 - gg) * ar / 255
                    bb = bb + (255 - bb) * ar / 255
                    aa = aa + (255 - aa) * ar / 255
                }
                if ak != 0 {
                    rr = rr - rr * ak / 255
                    gg = gg - gg * ak / 255
                    bb = bb - bb * ak / 255
                    aa = aa + (255 - aa) * ak / 255
                }
                if aa > 255 {
                    aa = 255
                }
                let o: u64 = (r * CUR_W + c) * 4
                wr8(pix, o, bb)
                wr8(pix, o + 1, gg)
                wr8(pix, o + 2, rr)
                wr8(pix, o + 3, aa)
            }
            c = c + 1
        }
        r = r + 1
    }
}

fn cursor_create_resource(state: u64) -> bool {
    let pix: u64 = mem.frame_run(state, (CUR_BYTES + mem.FRAME_SIZE - 1)
        / mem.FRAME_SIZE)
    if pix == 0 {
        return false
    }
    kstate.set(state, s(S_CURPIX), pix)
    var z: u64 = 0
    while z < CUR_BYTES {
        __mmio_write64((pix + z) as *mut u64, 0)
        z = z + 8
    }
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    header(cmd, CMD_RESOURCE_CREATE_2D)
    wr32(cmd, 24, CUR_RES_ID)
    wr32(cmd, 28, FMT_B8G8R8A8)
    wr32(cmd, 32, CUR_W)
    wr32(cmd, 36, CUR_H)
    if !command(state, 40, RESP_OK_NODATA) {
        return false
    }
    header(cmd, CMD_RESOURCE_ATTACH_BACKING)
    wr32(cmd, 24, CUR_RES_ID)
    wr32(cmd, 28, 1)
    wr64(cmd, 32, pix)
    wr32(cmd, 40, CUR_BYTES)
    wr32(cmd, 44, 0)
    return command(state, 48, RESP_OK_NODATA)
}

fn cursor_upload_image(state: u64, form: u64, g: u64) -> bool {
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    header(cmd, CMD_TRANSFER_TO_HOST_2D)
    wr32(cmd, 24, 0)
    wr32(cmd, 28, 0)
    wr32(cmd, 32, CUR_W)
    wr32(cmd, 36, CUR_H)
    wr64(cmd, 40, 0)
    wr32(cmd, 48, CUR_RES_ID)
    wr32(cmd, 52, 0)
    return command(state, 56, RESP_OK_NODATA)
}

// ------------------------------------------------ was `wm.fi` ruft
fn cursor_usable(state: u64) -> bool {
    return usable(state) && kstate.get(state, s(S_CRING)) != 0
        && kstate.get(state, s(S_CURPIX)) != 0
}

fn cursor_displayed(state: u64, form: u64, g: u64, x: u64, y: u64,
    hx0: u64, hy0: u64, rq: u64) -> bool {
    if !cursor_usable(state) {
        return false
    }
    let hx: u64 = cursor.rot_hot_x(g, rq, hx0, hy0)
    let hy: u64 = cursor.rot_hot_y(g, rq, hx0, hy0)
    let key: u64 = form + 1 + (rq << 16)
    if kstate.get(state, s(S_CURFORM)) != key
        || kstate.get(state, s(S_CURGR)) != g {
        cursor_fill_image(state, form, g, rq)
        if !cursor_upload_image(state, form, g) {
            kstate.add(state, s(S_CURERR), 1)
            return false
        }
        kstate.set(state, s(S_CURFORM), key)
        kstate.set(state, s(S_CURGR), g)
    }
    if !cursor_command(state, CMD_UPDATE_CURSOR, x, y, CUR_RES_ID, hx, hy) {
        kstate.add(state, s(S_CURERR), 1)
        return false
    }
    kstate.add(state, s(S_CURDEF), 1)
    kstate.set(state, s(S_CURON), 1)
    kstate.set(state, s(S_CURX), x)
    kstate.set(state, s(S_CURY), y)
    return true
}

fn cursor_bewegen(state: u64, x: u64, y: u64) -> bool {
    if !cursor_usable(state) || kstate.get(state, s(S_CURON)) == 0 {
        return false
    }
    if kstate.get(state, s(S_CURX)) == x
        && kstate.get(state, s(S_CURY)) == y {
        return true
    }
    if !cursor_command(state, CMD_MOVE_CURSOR, x, y, CUR_RES_ID, 0, 0) {
        kstate.add(state, s(S_CURERR), 1)
        return false
    }
    kstate.add(state, s(S_CURMOVE), 1)
    kstate.set(state, s(S_CURX), x)
    kstate.set(state, s(S_CURY), y)
    return true
}

fn cursor_aus(state: u64) -> bool {
    if !cursor_usable(state) || kstate.get(state, s(S_CURON)) == 0 {
        return false
    }
    if !cursor_command(state, CMD_UPDATE_CURSOR, 0, 0, 0, 0, 0) {
        return false
    }
    kstate.set(state, s(S_CURON), 0)
    return true
}

fn cursor_an(state: u64) -> bool {
    return kstate.get(state, s(S_CURON)) != 0
}

fn cursor_defs(state: u64) -> u64 { return kstate.get(state, s(S_CURDEF)) }
fn cursor_moves(state: u64) -> u64 { return kstate.get(state, s(S_CURMOVE)) }
fn cursor_error(state: u64) -> u64 { return kstate.get(state, s(S_CURERR)) }

fn present(state: u64) -> bool {
    if !usable(state) {
        return false
    }
    var x0: u64 = 0
    var y0: u64 = 0
    var x1: u64 = 0
    var y1: u64 = 0
    if !fb.rect_take(state, &x0, &y0, &x1, &y1) {
        return true
    }
    let sw: u64 = kstate.get(state, s(S_SW))
    let sh: u64 = kstate.get(state, s(S_SH))
    if x1 > sw {
        x1 = sw
    }
    if y1 > sh {
        y1 = sh
    }
    if x1 <= x0 || y1 <= y0 {
        return true
    }
    let w: u64 = x1 - x0
    let h: u64 = y1 - y0
    let pitch: u64 = sw *% 4
    let offset: u64 = y0 *% pitch +% x0 *% 4

    let r: u64 = kstate.get(state, s(S_RING))
    let c1: u64 = r + CMD_OFF
    let c2: u64 = r + CMD2_OFF

    header(c1, CMD_TRANSFER_TO_HOST_2D)
    wr32(c1, 24, x0)
    wr32(c1, 28, y0)
    wr32(c1, 32, w)
    wr32(c1, 36, h)
    wr64(c1, 40, offset)
    wr32(c1, 48, RES_ID)
    wr32(c1, 52, 0)

    header(c2, CMD_RESOURCE_FLUSH)
    wr32(c2, 24, x0)
    wr32(c2, 28, y0)
    wr32(c2, 32, w)
    wr32(c2, 36, h)
    wr32(c2, 40, RES_ID)
    wr32(c2, 44, 0)

    if !command_pair(state, 56, 48) {
        return false
    }
    kstate.add(state, s(S_TRANSFERS), 1)
    kstate.add(state, s(S_FLUSHES), 1)
    kstate.add(state, s(S_OKT), w *% h *% 4)
    fb.tx_add(state, w *% h *% 4)
    return true
}

fn event_force(state: u64) -> bool {
    if !usable(state) {
        return false
    }
    kstate.add(state, s(S_EREIG), 1)
    let altw: u64 = kstate.get(state, s(S_SW))
    let alth: u64 = kstate.get(state, s(S_SH))
    if !display_info(state) {
        return false
    }
    kstate.set(state, s(S_NEUW), kstate.get(state, s(S_SW)))
    kstate.set(state, s(S_NEUH), kstate.get(state, s(S_SH)))
    kstate.set(state, s(S_SW), altw)
    kstate.set(state, s(S_SH), alth)
    return true
}

fn event_check(state: u64) -> bool {
    if !usable(state) {
        return false
    }
    let cfg: u64 = kstate.get(state, s(S_DEVCFG))
    if cfg == 0 {
        return false
    }
    let ev: u64 = rd32(cfg, G_EVENTS_READ)
    if (ev & EVENT_DISPLAY) == 0 {
        return false
    }
    wr32(cfg, G_EVENTS_CLEAR, EVENT_DISPLAY)
    kstate.add(state, s(S_EREIG), 1)
    // r816: in extend the event re-lays the heads out (a head came or went) instead of comparing one size.
    if kstate.get(state, s(S_EXTON)) != 0 {
        return relayout(state)
    }
    let altw: u64 = kstate.get(state, s(S_SW))
    let alth: u64 = kstate.get(state, s(S_SH))
    if display_info(state) {
        let w: u64 = kstate.get(state, s(S_SW))
        let h: u64 = kstate.get(state, s(S_SH))
        kstate.set(state, s(S_NEUW), w)
        kstate.set(state, s(S_NEUH), h)
        if w != altw || h != alth {
            kstate.add(state, s(S_UMGESTELLT), 1)
            kstate.set(state, s(S_SW), altw)
            kstate.set(state, s(S_SH), alth)
        }
        return true
    }
    return false
}

// ===================================================================
// FOLLOWING A NEW SIZE (host window drag, or a guest mode switch)
// ===================================================================
//
// The resource, its backing and the scan-out all have the size of the back buffer. When the back buffer changes
// size (vmode.switch_to, or the host asked for another size and vmode followed it), the old resource is dropped and
// a new one of the right size is attached to the SAME back buffer and scanned out again, mirrors included.
// Not done in extend mode (the head layout owns the scan-outs there; `relayout` handles that case).
fn resizes(state: u64) -> u64 { return kstate.get(state, s(S_RESIZES)) }
fn resize_errors(state: u64) -> u64 { return kstate.get(state, s(S_RSZERR)) }

// The size the host asked for as w * 65536 + h when it differs from what is scanned out (single head only), else 0.
fn host_pending(state: u64) -> u64 {
    if !usable(state) {
        return 0
    }
    if kstate.get(state, s(S_EXTON)) != 0 {
        return 0
    }
    let w: u64 = kstate.get(state, s(S_NEUW))
    let h: u64 = kstate.get(state, s(S_NEUH))
    if w == 0 || h == 0 {
        return 0
    }
    if w == kstate.get(state, s(S_SW)) && h == kstate.get(state, s(S_SH)) {
        return 0
    }
    return w * 65536 + h
}

fn resize(state: u64, w: u64, h: u64) -> bool {
    if !usable(state) {
        return false
    }
    if kstate.get(state, s(S_EXTON)) != 0 {
        return false
    }
    if w == kstate.get(state, s(S_SW)) && h == kstate.get(state, s(S_SH)) {
        return true
    }
    let back: u64 = fb.back(state)
    let bytes: u64 = w *% h *% 4
    if back == 0 || w == 0 || h == 0 || fb.pitch(state) != w *% 4 || fb.back_bytes(state) < bytes {
        kstate.add(state, s(S_RSZERR), 1)
        return false
    }
    // present() skips while the driver is not ready: nothing runs against the half-built resource
    kstate.set(state, s(S_READY), 0)
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    header(cmd, CMD_RESOURCE_UNREF)
    wr32(cmd, 24, RES_ID)
    wr32(cmd, 28, 0)
    let _un: bool = command(state, 32, RESP_OK_NODATA)
    if !resource_create(state, w, h) || !attach_backing(state, back, bytes) || !set_scanout(state, w, h) {
        kstate.add(state, s(S_RSZERR), 1)
        return false // driver stays off: fb falls back to the firmware framebuffer copy
    }
    var hd: u64 = 1
    while hd < OUT_MAX {
        if head_connected(state, hd) {
            if set_scanout_id(state, hd, w, h) {
                kstate.add(state, s(S_MIRRORED), 1)
            } else {
                kstate.add(state, s(S_MIRERR), 1)
            }
        }
        hd = hd + 1
    }
    kstate.set(state, s(S_SW), w)
    kstate.set(state, s(S_SH), h)
    kstate.set(state, s(S_BACK), back)
    kstate.set(state, s(S_BACKBYTES), bytes)
    if !transfer(state, 0, 0, w, h, 0) || !resource_flush(state, 0, 0, w, h) {
        kstate.add(state, s(S_RSZERR), 1)
        return false
    }
    kstate.add(state, s(S_RESIZES), 1)
    kstate.set(state, s(S_READY), 1)
    return true
}

// One line for the gates (tools/vgpuhw): rebuilds, bytes carried out, device-cursor counters.
fn say_hw(state: u64) {
    var a: [u8; 14] = "vgpu: hw rsz=\0"
    var b: [u8; 10] = " rszerr=\0\0"
    var c: [u8; 7] = " okt=\0\0"
    var d: [u8; 9] = " curdef=\0"
    var e: [u8; 10] = " curmove=\0"
    var f: [u8; 9] = " curerr=\0"
    var g: [u8; 7] = " cur=\0\0"
    serial.puts((&a[0]) as u64)
    serial.dec(kstate.get(state, s(S_RESIZES)))
    serial.puts((&b[0]) as u64)
    serial.dec(kstate.get(state, s(S_RSZERR)))
    serial.puts((&c[0]) as u64)
    serial.dec(kstate.get(state, s(S_OKT)))
    serial.puts((&d[0]) as u64)
    serial.dec(kstate.get(state, s(S_CURDEF)))
    serial.puts((&e[0]) as u64)
    serial.dec(kstate.get(state, s(S_CURMOVE)))
    serial.puts((&f[0]) as u64)
    serial.dec(kstate.get(state, s(S_CURERR)))
    serial.puts((&g[0]) as u64)
    serial.dec(kstate.get(state, s(S_CURON)))
    serial.nl()
}

// ===================================================================
// DAS AUFSETZEN
// ===================================================================

// Bring the device up to and including GET_DISPLAY_INFO + EDID. Idempotent (S_UP). Needs no framebuffer.
fn bring_up(state: u64) -> bool {
    if kstate.get(state, s(S_UP)) != 0 {
        return true
    }
    let i: u64 = find(state)
    if i >= pci.MAX_DEV {
        return false
    }
    let d: u64 = pci.get(state, i, pci.E_BDF)
    kstate.set(state, s(S_IDX), i)
    kstate.set(state, s(S_BDF), d)

    let c_cap: u64 = find_vcap(d, CFG_COMMON)
    let n_cap: u64 = find_vcap(d, CFG_NOTIFY)
    let i_cap: u64 = find_vcap(d, CFG_ISR)
    let v_cap: u64 = find_vcap(d, CFG_DEVICE)
    if c_cap == 0 || n_cap == 0 || v_cap == 0 {
        return false
    }
    let cbase: u64 = region(state, i, d, c_cap)
    if cbase == 0 {
        return false
    }
    kstate.set(state, s(S_COMMON), cbase)
    kstate.set(state, s(S_NOTIFY), region(state, i, d, n_cap))
    kstate.set(state, s(S_NMULT), pci.cfg_read32(d, n_cap + VC_NOTIFY_MULT))
    kstate.set(state, s(S_ISR), region(state, i, d, i_cap))
    let dcfg: u64 = region(state, i, d, v_cap)
    kstate.set(state, s(S_DEVCFG), dcfg)
    if dcfg == 0 {
        return false
    }

    pci.enable_master(d)

    if !reset(state) {
        return false
    }
    status_add(state, ST_ACK)
    status_add(state, ST_DRIVER)
    if !negotiate(state) {
        wr8(cbase, C_STATUS, ST_FAILED)
        return false
    }

    let r: u64 = mem.frame_run(state, RING_BYTES / mem.FRAME_SIZE)
    if r == 0 {
        wr8(cbase, C_STATUS, ST_FAILED)
        return false
    }
    var z: u64 = 0
    while z < RING_BYTES {
        __mmio_write64((r + z) as *mut u64, 0)
        z = z + 8
    }
    kstate.set(state, s(S_RING), r)
    kstate.set(state, s(S_AVAIL), 0)
    kstate.set(state, s(S_USED), 0)

    if !queue_setup(state) {
        wr8(cbase, C_STATUS, ST_FAILED)
        return false
    }
    kstate.set(state, s(S_SCANOUTS), rd32(dcfg, G_NUM_SCANOUTS))

    status_add(state, ST_DRIVER_OK)
    if (status(state) & ST_DRIVER_OK) == 0 {
        return false
    }

    if !display_info(state) {
        return false
    }

    read_all_edid(state)
    kstate.set(state, s(S_UP), 1)
    return true
}

// r827: how big must the desktop be so that every connected head fits side by side (pack_row)?
// Result w << 16 | h of the bounding box, 0 when fewer than two heads are connected or the device is absent.
// Called BEFORE the framebuffer exists (kgui sizes the fb with it when `vgpuextend` is on and no `fbres=` is given).
fn probe_desktop(state: u64) -> u64 {
    if !bring_up(state) {
        return 0
    }
    var sw: u64 = 0
    var mh: u64 = 0
    var n: u64 = 0
    var hd: u64 = 0
    while hd < OUT_MAX {
        if head_connected(state, hd) {
            sw = sw + head_w(state, hd)
            if head_h(state, hd) > mh {
                mh = head_h(state, hd)
            }
            n = n + 1
        }
        hd = hd + 1
    }
    if n < 2 || sw == 0 || mh == 0 || sw > 8192 || mh > 4608 {
        return 0
    }
    return (sw << 16) | mh
}

fn init(state: u64) -> bool {
    kstate.set(state, s(S_READY), 0)
    if !bring_up(state) {
        return false
    }
    let back: u64 = fb.back(state)
    if back == 0 {
        return false
    }
    let bw: u64 = fb.width(state)
    let bh: u64 = fb.height(state)
    let bp: u64 = fb.pitch(state)
    if bw == 0 || bh == 0 || bp != bw *% 4 {
        return false
    }
    kstate.set(state, s(S_SW), bw)
    kstate.set(state, s(S_SH), bh)
    let bytes: u64 = bp *% bh
    kstate.set(state, s(S_BACK), back)
    kstate.set(state, s(S_BACKBYTES), bytes)

    if !resource_create(state, bw, bh) {
        return false
    }
    if !attach_backing(state, back, bytes) {
        return false
    }
    // r815: word `vgpuextend` + at least two heads -> every head scans out its own rect of the
    // wide desktop resource. Otherwise (or if no head could be placed) the old path below.
    var extended: bool = false
    if kstate.mode_on(state, kstate.M_VGPUEXT) && kstate.get(state, s(S_HEADS)) >= 2 {
        if ext_place(state, bw, bh) >= 1 {
            extended = true
            kstate.set(state, s(S_EXTON), 1)
        }
    }
    if !extended {
        if !set_scanout(state, bw, bh) {
            return false
        }
        // r808: every further connected head shows the same resource (mirror).
        // A refusal is counted, never fatal: head 0 already works.
        var hd: u64 = 1
        while hd < OUT_MAX {
            if head_connected(state, hd) {
                if set_scanout_id(state, hd, bw, bh) {
                    kstate.add(state, s(S_MIRRORED), 1)
                } else {
                    kstate.add(state, s(S_MIRERR), 1)
                }
            }
            hd = hd + 1
        }
    }

    if !transfer(state, 0, 0, bw, bh, 0) {
        return false
    }
    if !resource_flush(state, 0, 0, bw, bh) {
        return false
    }
    kstate.set(state, s(S_READY), 1)

    if cursor_queue_setup(state) {
        if !cursor_create_resource(state) {
            kstate.set(state, s(S_CRING), 0) // sauber zurueckfallen
        }
    } else {
        kstate.set(state, s(S_CRING), 0)
    }
    return true
}

fn shut_down(state: u64) {
    if !usable(state) {
        return
    }
    let cmd: u64 = kstate.get(state, s(S_RING)) + CMD_OFF
    header(cmd, CMD_RESOURCE_UNREF)
    wr32(cmd, 24, RES_ID)
    wr32(cmd, 28, 0)
    let _ok: bool = command(state, 32, RESP_OK_NODATA)
    kstate.set(state, s(S_READY), 0)
}

// ------------------------------------------------------- der Bericht

fn say(state: u64) {
    var s_no: [u8; 20] = "vgpu: no device\0\0\0\0\0"
    var s_a: [u8; 11] = "vgpu: bdf=\0"
    var s_b: [u8; 10] = "  schirm=\0"
    var s_x: [u8; 2] = "x\0"
    var s_c: [u8; 11] = "  scanout=\0"
    var s_d: [u8; 8] = "  res=\0\0"
    var s_e: [u8; 9] = "  back=\0\0"
    var s_f: [u8; 8] = "  err=\0\0"
    var s_g: [u8; 10] = "  ereig=\0\0"
    var s_h: [u8; 8] = "  neu=\0\0"
    var s_i: [u8; 2] = "x\0"
    var s_j: [u8; 9] = "  umst=\0\0"
    var s_k: [u8; 9] = "  heads=\0"
    var s_l: [u8; 9] = "  mirr=\0\0"
    var s_m: [u8; 9] = "  merr=\0\0"
    var s_n: [u8; 8] = "  ext=\0\0"
    var s_o: [u8; 9] = "  extp=\0\0"
    var s_p: [u8; 9] = "  exte=\0\0"
    var s_q: [u8; 9] = "  extc=\0\0"
    if !usable(state) {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_a[0]) as u64)
    serial.hex(kstate.get(state, s(S_BDF)))
    serial.puts((&s_b[0]) as u64)
    serial.dec(kstate.get(state, s(S_SW)))
    serial.puts((&s_x[0]) as u64)
    serial.dec(kstate.get(state, s(S_SH)))
    serial.puts((&s_c[0]) as u64)
    serial.dec(kstate.get(state, s(S_SCANOUTS)))
    serial.puts((&s_d[0]) as u64)
    serial.dec(RES_ID)
    serial.puts((&s_e[0]) as u64)
    serial.hex(kstate.get(state, s(S_BACK)))
    serial.puts((&s_f[0]) as u64)
    serial.dec(kstate.get(state, s(S_ERROR)))
    serial.puts((&s_g[0]) as u64)
    serial.dec(kstate.get(state, s(S_EREIG)))
    serial.puts((&s_h[0]) as u64)
    serial.dec(kstate.get(state, s(S_NEUW)))
    serial.puts((&s_i[0]) as u64)
    serial.dec(kstate.get(state, s(S_NEUH)))
    serial.puts((&s_j[0]) as u64)
    serial.dec(kstate.get(state, s(S_UMGESTELLT)))
    serial.puts((&s_k[0]) as u64)
    serial.dec(kstate.get(state, s(S_HEADS)))
    serial.puts((&s_l[0]) as u64)
    serial.dec(kstate.get(state, s(S_MIRRORED)))
    serial.puts((&s_m[0]) as u64)
    serial.dec(kstate.get(state, s(S_MIRERR)))
    serial.puts((&s_n[0]) as u64)
    serial.dec(kstate.get(state, s(S_EXTON)))
    serial.puts((&s_o[0]) as u64)
    serial.dec(kstate.get(state, s(S_EXTPLACED)))
    serial.puts((&s_p[0]) as u64)
    serial.dec(kstate.get(state, s(S_EXTERR)))
    serial.puts((&s_q[0]) as u64)
    serial.dec(kstate.get(state, s(S_EXTCLIP)))
    var s_hot: [u8; 8] = "  hot=\0\0"
    serial.puts((&s_hot[0]) as u64)
    serial.dec(kstate.get(state, s(S_HOTS)))
    serial.nl()
    var x_a: [u8; 16] = "vgpu: ext head \0"
    var x_b: [u8; 8] = " rect=\0\0"
    if kstate.get(state, s(S_EXTON)) != 0 {
        var eh: u64 = 0
        while eh < OUT_MAX {
            if ext_w(state, eh) != 0 {
                serial.puts((&x_a[0]) as u64)
                serial.dec(eh)
                serial.puts((&x_b[0]) as u64)
                serial.dec(ext_x(state, eh))
                serial.put(44)
                serial.dec(ext_y(state, eh))
                serial.put(32)
                serial.dec(ext_w(state, eh))
                serial.put(120)
                serial.dec(ext_h(state, eh))
                serial.nl()
            }
            eh = eh + 1
        }
    }
    var h_a: [u8; 12] = "vgpu: head \0"
    var h_b: [u8; 8] = " edid=\0\0"
    var h_c: [u8; 6] = " pref\0"
    var h_d: [u8; 5] = " mm=\0"
    var h_e: [u8; 8] = " scale=\0"
    var h_f: [u8; 7] = " noedid"
    var hd: u64 = 0
    while hd < OUT_MAX {
        if head_connected(state, hd) {
            let o: u64 = S_OUTTAB + hd * OUT_STRIDE
            serial.puts((&h_a[0]) as u64)
            serial.dec(hd)
            serial.put(32)
            serial.dec(head_w(state, hd))
            serial.put(120)
            serial.dec(head_h(state, hd))
            if head_edid_ok(state, hd) {
                let mf: u64 = kstate.get(state, s(o + O_MFR))
                serial.puts((&h_b[0]) as u64)
                serial.put((mf & 255) as u8)
                serial.put(((mf >> 8) & 255) as u8)
                serial.put(((mf >> 16) & 255) as u8)
                serial.puts((&h_c[0]) as u64)
                serial.put(61)
                serial.dec(kstate.get(state, s(o + O_PW)))
                serial.put(120)
                serial.dec(kstate.get(state, s(o + O_PH)))
                serial.puts((&h_d[0]) as u64)
                serial.dec(kstate.get(state, s(o + O_MMW)))
                serial.put(120)
                serial.dec(kstate.get(state, s(o + O_MMH)))
                serial.puts((&h_e[0]) as u64)
                serial.dec(kstate.get(state, s(o + O_SCALE)))
            } else {
                var i2: u64 = 0
                while i2 < 7 {
                    serial.put((h_f[i2 as usize]))
                    i2 = i2 + 1
                }
            }
            serial.nl()
        }
        hd = hd + 1
    }
}
