profile kernel

import serial
import lib.kstate
import mm.mmframe
import gfx.fb
import gpu.intel.regs
import gpu.intel.bits
import gpu.intel.ggtt
import gpu.intel.dbuf
import gpu.intel.backbuf
import drv.gpu.intel.mmio
import drv.gpu.intel.probe
import drv.gpu.intel.igalias
import drv.gpu.intel.igflush

export {
    stage, status, pages, back_phys, back_addr, back_wc, back_wc_flag, flips, rollbacks, shown_off, present, restore,
    ready, arm, copy_words, bb_mode, bb_presented, commit, draw_is_back, shown_is_back,
    S_OFF, S_NO_GGTT, S_NO_FB, S_MISMATCH, S_NO_MEM, S_SETUP, S_FLIP_FAIL, S_OK
}

const S_OFF: u64 = 0
const S_NO_GGTT: u64 = 1
const S_NO_FB: u64 = 2
const S_MISMATCH: u64 = 3
const S_NO_MEM: u64 = 4
const S_SETUP: u64 = 5
const S_FLIP_FAIL: u64 = 6
const S_OK: u64 = 7
const PAGE: u64 = 0x1000
const BACK_GGTT_OFFSET: u64 = 0x1000000
const COPY_STEP: u64 = 8
const MARK_ROWS: u64 = 48
const MARK_WORD: u64 = 0xff00ff00ff00ff00
const HOLD_STEPS: u64 = 40
const HOLD_STEP_US: u64 = 10000
const STRIDE_FIELD_MASK: u64 = 0x7ff
const SIZE_ROWS_SHIFT: u64 = 16
const SIZE_ROWS_MASK: u64 = 0xfff

static mut g_status: u64 = 0
static mut g_pages: u64 = 0
static mut g_back_phys: u64 = 0
static mut g_state: dbuf.Dbuf = dbuf.Dbuf { front_off: 0, back_off: 0, pages: 0, cur: 0, flips: 0, rollbacks: 0 }

static mut g_bb: backbuf.Backbuf = backbuf.Backbuf { mode: 0, misses: 0, presented: 0 }

static mut s_say: [u8; 17] = "intelgpuflip: ok\0"
static mut s_fail: [u8; 22] = "intelgpuflip: failed \0"

fn status() -> u64 {
    return g_status
}

fn pages() -> u64 {
    return g_pages
}

fn back_phys() -> u64 {
    return g_back_phys
}

fn back_addr() -> u64 {
    if igalias.active() {
        return igalias.virt()
    }
    return mmframe.kva(g_back_phys)
}

fn back_wc() -> bool {
    return igalias.active()
}

fn back_wc_flag() -> u64 {
    if igalias.active() {
        return 1
    }
    return 0
}

fn flips() -> u64 {
    return g_state.flips
}

fn rollbacks() -> u64 {
    return g_state.rollbacks
}

fn shown_off() -> u64 {
    return dbuf.shown(&g_state)
}

fn present() -> u64 {
    return dbuf.present(mmio.rd, mmio.wr, mmio.us, &g_state)
}

fn ready() -> bool {
    return g_status == S_OK && g_pages != 0
}

fn arm() {
    backbuf.arm(&g_bb)
}

fn bb_mode() -> u64 {
    return backbuf.mode(&g_bb)
}

fn bb_presented() -> u64 {
    return g_bb.presented
}

fn commit() -> u64 {
    return backbuf.commit(mmio.rd, mmio.wr, mmio.us, &g_state, &g_bb)
}

fn draw_is_back() -> bool {
    return backbuf.draw_is_back(&g_state, &g_bb)
}

fn shown_is_back() -> bool {
    return backbuf.shown_is_back(&g_state)
}

fn restore() -> u64 {
    return dbuf.restore_front(mmio.rd, mmio.wr, mmio.us, &g_state)
}

fn copy_words(dst: u64, src: u64, bytes: u64) {
    var i: u64 = 0
    while i < bytes {
        __mmio_write64((dst + i) as *mut u64, __mmio_read64((src + i) as *mut u64))
        i = i + COPY_STEP
    }
}

fn copy_front(ks: u64, bytes: u64) {
    copy_words(back_addr(), fb.addr(ks), bytes)
}

fn mark_back(ks: u64) {
    let dst: u64 = back_addr()
    let rows: u64 = MARK_ROWS * fb.pitch(ks)
    var i: u64 = 0
    while i < rows {
        __mmio_write64((dst + i) as *mut u64, __mmio_read64((dst + i) as *mut u64) ^ MARK_WORD)
        i = i + COPY_STEP
    }
}

fn geometry_matches(ks: u64) -> bool {
    let pitch: u64 = fb.pitch(ks)
    let stride: u64 = (mmio.rd(regs.PLANE_STRIDE_1_A) & STRIDE_FIELD_MASK) * bits.PLANE_STRIDE_UNIT
    let size: u64 = mmio.rd(regs.PLANE_SIZE_1_A)
    let rows: u64 = ((size >> SIZE_ROWS_SHIFT) & SIZE_ROWS_MASK) + 1
    return stride == pitch && rows == fb.height(ks) && fb.phys(ks) != 0
}

fn hold() {
    var n: u64 = 0
    while n < HOLD_STEPS {
        mmio.us(HOLD_STEP_US)
        n = n + 1
    }
}

fn fail(code: u64) {
    g_status = code
    serial.puts((&s_fail[0]) as u64)
    serial.dec(code)
    serial.nl()
}

fn selftest() {
    let r: u64 = present()
    if r != dbuf.D_OK {
        fail(S_FLIP_FAIL)
        restore()
        return
    }
    hold()
    if restore() != dbuf.D_OK {
        fail(S_FLIP_FAIL)
        return
    }
    g_status = S_OK
    serial.puts((&s_say[0]) as u64)
    serial.nl()
}

fn stage(ks: u64) {
    if !probe.flip_wanted(ks) || probe.result() != probe.R_OK {
        return
    }
    if !mmio.ggtt_attached() {
        fail(S_NO_GGTT)
        return
    }
    if !geometry_matches(ks) {
        fail(S_MISMATCH)
        return
    }
    let bytes: u64 = fb.pitch(ks) * fb.height(ks)
    g_pages = (bytes + PAGE - 1) / PAGE
    igflush.setup()
    if igalias.alloc(ks, bytes) {
        g_back_phys = igalias.phys()
    } else {
        g_back_phys = mmframe.frame_run(ks, g_pages)
    }
    if g_back_phys == 0 {
        fail(S_NO_MEM)
        return
    }
    copy_front(ks, bytes)
    let selftest_on: bool = kstate.mode_on(ks, kstate.M_INTELGPUFLIP)
    if selftest_on {
        mark_back(ks)
    }
    igflush.settle(back_addr(), bytes, !back_wc())
    mmio.permit_ggtt(BACK_GGTT_OFFSET, g_pages)
    mmio.permit_plane()
    if dbuf.setup(mmio.rd, mmio.rd64, mmio.wr64, &g_state, BACK_GGTT_OFFSET, g_back_phys, fb.phys(ks), g_pages) != dbuf.D_OK {
        fail(S_SETUP)
        return
    }
    if selftest_on {
        selftest()
        return
    }
    g_status = S_OK
}
