// SPDX-License-Identifier: GPL-2.0-only
// kernel/drv/gpu/vmsvga.fi -- VMware SVGA II driver ("VMSVGA", PCI 15ad:0405).
//
// WHY: VirtualBox 7 uses this device as its default graphics controller. Without guest additions the
// firmware framebuffer (Bochs VBE style) has no update rectangles, no hardware cursor and no resolution change.
// This driver gives all three, on top of the same back buffer / framebuffer code in `fb.fi`.
//
// HOW (docs/VMSVGA.md has the register tables):
//   1. probe      find 15ad:0405, enable IO + MEM, negotiate ID 0x90000002, read caps / VRAM size.
//   2. set_mode   WIDTH / HEIGHT / BPP=32 / ENABLE; BYTES_PER_LINE and FB_OFFSET come back from the device.
//   3. FIFO       BAR2: header {MIN, MAX, NEXT_CMD, STOP}, then CONFIG_DONE = 1.
//   4. present    the copy into VRAM stays `fb.flush*` (VRAM is device memory); the copy sites note the box they
//                 really wrote (`fb.vms_note`), and ONE `UPDATE {x,y,w,h}` per frame tells the host about it.
//   5. cursor     DEFINE_ALPHA_CURSOR (cap ALPHA_CURSOR) or DEFINE_CURSOR (1 bit and-mask + 32 bit xor image),
//                 position through CURSOR_X/Y/ON registers or, with FIFO cap CURSOR_BYPASS_3, through the FIFO header.
//
// Only QEMU 7.2 (`-vga vmware`) was measured. Everything about VirtualBox is from the documented device model.

import lib.kstate
import bus.pci
import serial
import gfx.fb
import gfx.cursor
import mm.mem
import arch.x86_64.apic
import arch.arch

export {
    probe, boot_mbi, init, bereit, present, panic_present, say, shut_down,
    set_mode, resize, host_pending, boot_hint, boot_handled, vmm_init, vmm_say, vmm_fake, vmm_up, resizes, resize_errors,
    cursor_bereit, cursor_zeigen, cursor_bewegen, cursor_aus, cursor_an,
    cursor_defs, cursor_moves, cursor_fehler,
    updates, update_octets, verify_bad, width, height, fifo_full,
    safety_updates, pio_count, heal_count, present_calls, present_frames, pending, pulse_say, fb_phys, vram_bytes, size_ok, pitch, resized, host_resizes,
    VMSVGA_OFF, VMSVGA_MAX
}

// ---- state page (a mirror of kstate.fi VMSVGA_OFF; memmap.py checks the real one)
const VMSVGA_OFF: u64 = 0x170000
const VMSVGA_MAX: u64 = 0x1000

const S_UP: u64 = 0x00 // 1 = probe succeeded
const S_READY: u64 = 0x08 // 1 = the driver carries the picture (fb.fi reads this word: keep the offset)
const S_BDF: u64 = 0x10
const S_IDX: u64 = 0x18
const S_IO: u64 = 0x20 // I/O port base (BAR0)
const S_FIFO: u64 = 0x28 // virtual address of the FIFO (BAR2)
const S_FIFOSZ: u64 = 0x30
const S_VRAM: u64 = 0x38 // physical address of VRAM (BAR1 / FB_START)
const S_VRAMSZ: u64 = 0x40
const S_CAPS: u64 = 0x48
const S_W: u64 = 0x50
const S_H: u64 = 0x58
const S_PITCH: u64 = 0x60
const S_UPDATES: u64 = 0x68
const S_UPOKT: u64 = 0x70 // pixels * 4 the host was told about
const S_FULL: u64 = 0x78 // FIFO waits that ran out
const S_CURON: u64 = 0x80
const S_CURFORM: u64 = 0x88
const S_CURGR: u64 = 0x90
const S_CURDEF: u64 = 0x98
const S_CURMOVE: u64 = 0xA0
const S_CURX: u64 = 0xA8
const S_CURY: u64 = 0xB0
const S_CURERR: u64 = 0xB8
const S_FCAPS: u64 = 0xC0 // FIFO capabilities word (0 without CAP_EXTENDED_FIFO)
const S_ID: u64 = 0xC8
const S_BAD: u64 = 0xD0 // verify: pixels that changed outside the sent rectangle
const S_RESIZES: u64 = 0xD8
const S_RSZERR: u64 = 0xE0
const S_MAXW: u64 = 0xE8
const S_MAXH: u64 = 0xF0
const S_WNEXT: u64 = 0xF8 // write cursor inside the FIFO while a command is built
const S_ACC_VALID: u64 = 0x100 // dirty box accumulated by fb.vms_note (fb.fi mirrors these offsets)
const S_ACC_X0: u64 = 0x108
const S_ACC_Y0: u64 = 0x110
const S_ACC_X1: u64 = 0x118
const S_ACC_Y1: u64 = 0x120
const S_PRES: u64 = 0x128 // verify: copy of what the host was told (physical = virtual address)
const S_PRESSZ: u64 = 0x130
const S_VERIFYN: u64 = 0x138 // verify: frames compared
const S_FBOFF: u64 = 0x140 // FB_OFFSET register
const S_SEEN: u64 = 0x148 // last host-requested size seen (w << 16 | h)
const S_SEENN: u64 = 0x150 // consecutive polls that saw S_SEEN
const S_HANDLED: u64 = 0x158 // host size already tried (do not retry the same one every poll)
const S_NEXTPOLL: u64 = 0x160 // earliest next host poll (ms)
const S_HOSTRSZ: u64 = 0x168 // resizes that followed a host request
const S_LASTUPD: u64 = 0x170 // ms of the last UPDATE sent
const S_SAFETY: u64 = 0x178 // safety-net full UPDATEs (writers that bypass fb.vms_note, e.g. /dev/fb)
const SAFETY_MS: u64 = 10000
const SAFETY_FULL_MS: u64 = 10000 // full-update mode: same long net as the rectangle path (host-side loss is repaired by the heal stages)
const BUSY_SPIN: u64 = 20000 // bounded wait for BUSY == 0 after a full UPDATE
const S_REDRAW: u64 = 0x180 // full-update mode: periodic whole-picture rewrites of VRAM
const S_PIO: u64 = 0x188 // port I/O operations issued by the driver (outl/inl count; idle must stay ~0)
const S_HEAL_T0: u64 = 0x190 // ms of the last mode change / ENABLE (0 = none)
const S_HEAL_STAGE: u64 = 0x198 // mode-change self-heal stages left (3 = +100 ms, 2 = +500 ms, 1 = +2000 ms, 0 = done)
const S_HEALS: u64 = 0x1A0 // self-heal whole-picture UPDATEs sent (mode-change stages + trailing)
const S_LOCK: u64 = 0x1A8 // spin lock word of the dirty box (fb.vms_note and acc_take)
const S_DROPN: u64 = 0x1B0 // notes seen (word vmsvgadrop swallows every 7th: gate negative control)
const S_TRAIL: u64 = 0x1B8 // ms at which the trailing whole-picture UPDATE is due (0 = none): set when a frame painted
const S_TRACES: u64 = 0x1C0 // TRACES register read back after the write (0 = host does not watch VRAM)
const HEAL_1_MS: u64 = 100
const HEAL_2_MS: u64 = 500
const HEAL_3_MS: u64 = 2000
const TRAIL_MS: u64 = 2000 // keep-alive: one whole-picture UPDATE this long after the last painted frame (nothing while idle)
const S_IDSET: u64 = 0x1C8 // DISPLAY_ID already selected (the idle poll then only READS the size: 2 reads, not a select + 2 reads)
const S_PCALLS: u64 = 0x1D0 // calls of present() (the desktop loop must call it every round: gate + report)
const S_PFRAMES: u64 = 0x1D8 // calls of present() that found a painted box (= frames that reached the driver)
const S_PLOCK: u64 = 0x1E0 // spin lock word of the INDEX/VALUE port pair (reg_w / reg_r run on every core)
const POLL_MS: u64 = 1000 // host display hint poll period (only with CAP_DISPLAY_TOPOLOGY)
const S_VMM_IO: u64 = 0x1E8 // VirtualBox guest device (VMMDev, PCI 80ee:cafe) I/O port base (0 = none)
const S_VMM_REQ: u64 = 0x1F0 // physical = virtual address of the request page (below 4 GiB: the port takes 32 bits)
const S_VMM_UP: u64 = 0x1F8 // 1 = the guest was announced to the host (info + capabilities), hints can be read
const S_VMM_ERR: u64 = 0x200 // requests the host answered with an error
const S_VMM_POLLS: u64 = 0x208 // display-change requests read
const S_VMM_HINT: u64 = 0x210 // last hint read (w << 16 | h)
const S_VMM_RC: u64 = 0x218 // rc of the last failed request
const S_VMM_FAKE: u64 = 0x220 // test bed: hint injected instead of the device answer (w << 16 | h), 0 = use the device
const S_VMM_FTY: u64 = 0x230 // request type of the last failed request
const S_VMM_FMASK: u64 = 0x238 // bit mask of request types (type mod 64) that ever failed
const S_VMM_BUSY: u64 = 0x250 // 1 while a core is inside vmm_hint (the request page is shared by the idle task and the desktop loop)
const S_VMM_ACK: u64 = 0x228 // requests that reported the graphics capability (bit mask of steps that worked)
const S_MBI: u64 = 0x800 // synthetic multiboot info (Weg 3), 128 bytes

// ---- PCI
const VENDOR_VMWARE: u64 = 0x15AD
const DEVICE_SVGA2: u64 = 0x0405
const ID_2: u64 = 0x90000002
const CFG_COMMAND: u64 = 4

// ---- registers
const R_ID: u64 = 0
const R_ENABLE: u64 = 1
const R_WIDTH: u64 = 2
const R_HEIGHT: u64 = 3
const R_MAX_W: u64 = 4
const R_MAX_H: u64 = 5
const R_BPP: u64 = 7
const R_BYTES_PER_LINE: u64 = 12
const R_FB_START: u64 = 13
const R_FB_OFFSET: u64 = 14
const R_VRAM_SIZE: u64 = 15
const R_FB_SIZE: u64 = 16
const R_CAPS: u64 = 17
const R_MEM_SIZE: u64 = 19
const R_CONFIG_DONE: u64 = 20
const R_SYNC: u64 = 21
const R_BUSY: u64 = 22
const R_GUEST_ID: u64 = 23
const R_CURSOR_ID: u64 = 24
const R_CURSOR_X: u64 = 25
const R_CURSOR_Y: u64 = 26
const R_CURSOR_ON: u64 = 27
const R_MEM_REGS: u64 = 30
const R_DISPLAY_ID: u64 = 35
const R_DISPLAY_W: u64 = 39
const R_DISPLAY_H: u64 = 40
const R_PITCHLOCK: u64 = 32 // VirtualBox: forces BYTES_PER_LINE (and the stride the host scans out) to this value
const R_TRACES: u64 = 45 // 0 = the host does not write-protect VRAM pages to watch the guest (vmwgfx writes 0)

// ---- capabilities
const CAP_RECT_COPY: u64 = 0x2
const CAP_CURSOR: u64 = 0x20
const CAP_CURSOR_BYPASS: u64 = 0x40
const CAP_ALPHA_CURSOR: u64 = 0x200
const CAP_EXTENDED_FIFO: u64 = 0x8000
const CAP_DISPLAY_TOPOLOGY: u64 = 0x80000

const FC_CURSOR_BYPASS_3: u64 = 0x10

// ---- FIFO header words (index in u32 words)
const F_MIN: u64 = 0
const F_MAX: u64 = 1
const F_NEXT: u64 = 2
const F_STOP: u64 = 3
const F_CAPS: u64 = 4
const F_CURSOR_ON: u64 = 9
const F_CURSOR_X: u64 = 10
const F_CURSOR_Y: u64 = 11
const F_CURSOR_COUNT: u64 = 12

const CMD_UPDATE: u64 = 1
const CMD_DEFINE_CURSOR: u64 = 19
const CMD_DEFINE_ALPHA_CURSOR: u64 = 22

const CUR_W: u64 = 64
const FIFO_CAP: u64 = 0x10000 // use at most 64 KiB of the FIFO (QEMU has exactly that)
const SPIN: u64 = 2000000

fn s(off: u64) -> u64 {
    return VMSVGA_OFF + off
}

fn rd32(b: u64, off: u64) -> u64 {
    return __mmio_read32((b + off) as *mut u32) as u64
}

fn wr32(b: u64, off: u64, v: u64) {
    __mmio_write32((b + off) as *mut u32, v as u32)
}

fn bereit(state: u64) -> bool {
    return kstate.get(state, s(S_READY)) != 0
}

fn width(state: u64) -> u64 { return kstate.get(state, s(S_W)) }
fn height(state: u64) -> u64 { return kstate.get(state, s(S_H)) }
fn updates(state: u64) -> u64 { return kstate.get(state, s(S_UPDATES)) }
fn update_octets(state: u64) -> u64 { return kstate.get(state, s(S_UPOKT)) }
fn verify_bad(state: u64) -> u64 { return kstate.get(state, s(S_BAD)) }
fn fifo_full(state: u64) -> u64 { return kstate.get(state, s(S_FULL)) }
fn resizes(state: u64) -> u64 { return kstate.get(state, s(S_RESIZES)) }
fn resize_errors(state: u64) -> u64 { return kstate.get(state, s(S_RSZERR)) }

// ------------------------------------------------------------ register access

// INDEX and VALUE are ONE register pair: two cores that interleave outl(INDEX), outl(INDEX), outl(VALUE) write the value into the wrong
// register (the desktop loop presents on one core while the idle task of another core polls the host hint). Leaf lock, interrupts
// off while it is held, so it can neither nest nor be held by an interrupted core.
fn pair_lock(state: u64) -> u64 {
    let fl: u64 = arch.irq_save()
    let lk: *mut u64 = (state + VMSVGA_OFF + S_PLOCK) as *mut u64
    var got: u64 = __atomic_swap(lk, 0, 1)
    while got != 0 {
        arch.pause()
        got = __atomic_swap(lk, 0, 1)
    }
    return fl
}

fn pair_unlock(state: u64, fl: u64) {
    let lk: *mut u64 = (state + VMSVGA_OFF + S_PLOCK) as *mut u64
    __mmio_write64(lk, 0)
    arch.irq_restore(fl)
}

fn reg_w(state: u64, idx: u64, v: u64) {
    let io: u64 = kstate.get(state, s(S_IO))
    let fl: u64 = pair_lock(state)
    kstate.add(state, s(S_PIO), 2)
    arch.dev_out32(io as u16, idx as u32)
    arch.dev_out32((io + 1) as u16, v as u32)
    pair_unlock(state, fl)
}

fn reg_r(state: u64, idx: u64) -> u64 {
    let io: u64 = kstate.get(state, s(S_IO))
    let fl: u64 = pair_lock(state)
    kstate.add(state, s(S_PIO), 2)
    arch.dev_out32(io as u16, idx as u32)
    let v: u64 = arch.dev_in32((io + 1) as u16) as u64
    pair_unlock(state, fl)
    return v
}

fn has_cap(state: u64, c: u64) -> bool {
    return (kstate.get(state, s(S_CAPS)) & c) != 0
}

// ------------------------------------------------------------ finding + probing

fn find(state: u64) -> u64 {
    let n: u64 = pci.count(state)
    var i: u64 = 0
    while i < n {
        if pci.get(state, i, pci.E_VENDOR) == VENDOR_VMWARE {
            if pci.get(state, i, pci.E_DEVICE) == DEVICE_SVGA2 {
                return i
            }
        }
        i = i + 1
    }
    return pci.MAX_DEV
}

// Find the device, switch on IO + MEM decoding, negotiate the version, read the capabilities and sizes.
// Does NOT change the mode. Safe to call twice.
fn probe(state: u64) -> bool {
    if kstate.get(state, s(S_UP)) != 0 {
        return true
    }
    if kstate.mode_on(state, kstate.M_NOVMSVGA) {
        return false
    }
    let i: u64 = find(state)
    if i >= pci.MAX_DEV {
        return false
    }
    let d: u64 = pci.get(state, i, pci.E_BDF)
    if !pci.bar_is_io(state, i, 0) || pci.bar_is_io(state, i, 1) {
        return false
    }
    let io: u64 = pci.bar(state, i, 0)
    let vram: u64 = pci.bar(state, i, 1)
    let fifo_phys: u64 = pci.bar(state, i, 2)
    if io == 0 || io > 0xFFF0 || vram == 0 || fifo_phys == 0 {
        return false
    }
    // IO space (bit 0) and memory space (bit 1)
    let cmd: u64 = pci.cfg_read16(d, CFG_COMMAND)
    pci.cfg_write16(d, CFG_COMMAND, cmd | 3)
    kstate.set(state, s(S_BDF), d)
    kstate.set(state, s(S_IDX), i)
    kstate.set(state, s(S_IO), io)

    reg_w(state, R_ID, ID_2)
    let id: u64 = reg_r(state, R_ID)
    kstate.set(state, s(S_ID), id)
    if id != ID_2 {
        return false
    }
    kstate.set(state, s(S_CAPS), reg_r(state, R_CAPS))
    kstate.set(state, s(S_VRAM), vram)
    kstate.set(state, s(S_VRAMSZ), reg_r(state, R_VRAM_SIZE))
    kstate.set(state, s(S_MAXW), reg_r(state, R_MAX_W))
    kstate.set(state, s(S_MAXH), reg_r(state, R_MAX_H))
    let fv: u64 = apic.map_device(state, fifo_phys)
    if fv == 0 {
        return false
    }
    kstate.set(state, s(S_FIFO), fv)
    var fsz: u64 = reg_r(state, R_MEM_SIZE)
    if fsz > FIFO_CAP || fsz == 0 {
        fsz = FIFO_CAP
    }
    kstate.set(state, s(S_FIFOSZ), fsz)
    kstate.set(state, s(S_UP), 1)
    return true
}

// ------------------------------------------------------------ mode

// Busy-wait `us` microseconds on the TSC without any VM exit (pause only). Port-I/O waits cost 55-130 us EACH under VirtualBox/NEM
// (W-L3 r1137: 2000 outb 0x80 per settle round lagged the guest clock by minutes -> TM catch-up, host EMT at 100 %).
fn spin_us(state: u64, us: u64) {
    var hz: u64 = apic.tsc_hz(state)
    if hz < 100000000 || hz > 10000000000 {
        hz = 4000000000
    }
    let t0: u64 = apic.tsc()
    let span: u64 = hz / 1000000 * us
    while apic.tsc() - t0 < span {
        arch.pause()
    }
}

fn settle(state: u64) {
    // QEMU applies WIDTH / HEIGHT lazily; ~2 ms (what 2000 port-0x80 writes cost on real hardware) without a single exit.
    spin_us(state, 2000)
}

// Set WxH at 32 bpp, enable, read back what the device really granted. Returns false when the device refuses.
fn set_mode(state: u64, w: u64, h: u64) -> bool {
    if kstate.get(state, s(S_UP)) == 0 || w == 0 || h == 0 {
        return false
    }
    let maxw: u64 = kstate.get(state, s(S_MAXW))
    let maxh: u64 = kstate.get(state, s(S_MAXH))
    if (maxw != 0 && w > maxw) || (maxh != 0 && h > maxh) {
        return false
    }
    let vsz: u64 = kstate.get(state, s(S_VRAMSZ))
    if vsz != 0 && w *% h *% 4 > vsz {
        return false
    }
    let pitch0: u64 = reg_r(state, R_BYTES_PER_LINE)
    let stale_emu: bool = kstate.mode_on(state, kstate.M_VMSVGASTALE)
    let old_way: bool = kstate.mode_on(state, kstate.M_VMSVGAOLD)
    // VirtualBox publishes the stride only when the mode is (re)enabled, and a live WIDTH/HEIGHT change on an enabled device leaves the host on
    // the OLD stride (1920x1200 scanned out with 4096 bytes per row: a small shifted rectangle, or a black window). Measured on VirtualBox 7.2
    // (r1197): ENABLE=0 first + PITCHLOCK=w*4 before ENABLE=1 makes the host take width*4 at once (cbLine 0x1E00 for 1920). QEMU keeps the old way.
    let vbox: bool = kstate.get(state, s(S_VMM_UP)) != 0 && !old_way
    if vbox {
        reg_w(state, R_ENABLE, 0)
    }
    reg_w(state, R_WIDTH, w)
    reg_w(state, R_HEIGHT, h)
    reg_w(state, R_BPP, 32)
    var lockv: u64 = 0
    if vbox {
        lockv = w * 4
        reg_w(state, R_PITCHLOCK, lockv)
    }
    reg_w(state, R_ENABLE, 1)
    var tries: u64 = 0
    while tries < 200 {
        if reg_r(state, R_WIDTH) == w && reg_r(state, R_HEIGHT) == h {
            break
        }
        settle(state)
        tries = tries + 1
    }
    if reg_r(state, R_WIDTH) != w || reg_r(state, R_HEIGHT) != h {
        return false
    }
    // The stride is published ASYNCHRONOUSLY by VirtualBox: right after the size reads back, BYTES_PER_LINE still holds the OLD
    // mode's value (800x600 got 4096 instead of 3200 -> every row shifted, "line garbage"). Wait (bounded) until it left the old
    // value or equals width*4; a value below width*4 can never be right.
    var pitch1: u64 = reg_r(state, R_BYTES_PER_LINE)
    if stale_emu {
        pitch1 = pitch0 // test bed: the register keeps the old stride
    }
    var pitch: u64 = pitch1
    var waited: u64 = 0
    // z10c measured on VirtualBox: the register stayed at the OLD stride (4096 for 800x600, true 3200) for 100 settle rounds. Kick the
    // host FIFO thread (SYNC + BUSY) and wait by TIME (400 ms) -- if it still shows the old value (or one below width*4), the host
    // scans out width*4 bytes per row (VirtualBox rounds the row to 4 bytes), so use that.
    let stale: bool = pitch != w * 4 && (pitch == pitch0 || pitch < w * 4) && !old_way
    if stale {
        reg_w(state, R_SYNC, 1)
        busy_wait(state)
        let hz: u64 = apic.tsc_hz(state)
        let t0: u64 = apic.tsc()
        var span: u64 = 0
        if hz > 0 {
            span = hz / 1000 * 400
        }
        while waited < 400 && pitch != w * 4 && (pitch == pitch0 || pitch < w * 4) && apic.tsc() - t0 < span {
            settle(state)
            pitch = reg_r(state, R_BYTES_PER_LINE)
            if stale_emu {
                pitch = pitch0
            }
            waited = waited + 1
        }
    }
    let pitch_reg: u64 = pitch
    if !old_way && pitch != w * 4 && (kstate.get(state, s(S_VMM_UP)) != 0 || stale_emu) && (pitch == pitch0 || pitch < w * 4) {
        pitch = w * 4
    }
    if pitch < w * 4 {
        pitch = w * 4
    }
    var s_m: [u8; 14] = "vmsvga: mode \0"
    var s_p0: [u8; 9] = " pitch0=\0"
    var s_p1: [u8; 9] = " pitch1=\0"
    var s_p2: [u8; 9] = " pitch2=\0"
    var s_wt: [u8; 7] = " wait=\0"
    var s_of: [u8; 6] = " off=\0"
    var s_pr: [u8; 7] = " preg=\0"
    var s_lk: [u8; 7] = " lock=\0"
    serial.puts((&s_m[0]) as u64)
    serial.dec(w)
    serial.put(120 as u8)
    serial.dec(h)
    serial.puts((&s_p0[0]) as u64)
    serial.dec(pitch0)
    serial.puts((&s_p1[0]) as u64)
    serial.dec(pitch1)
    serial.puts((&s_p2[0]) as u64)
    serial.dec(pitch)
    serial.puts((&s_pr[0]) as u64)
    serial.dec(pitch_reg)
    serial.puts((&s_lk[0]) as u64)
    serial.dec(lockv)
    serial.puts((&s_wt[0]) as u64)
    serial.dec(waited)
    serial.puts((&s_of[0]) as u64)
    serial.dec(reg_r(state, R_FB_OFFSET))
    serial.nl()
    kstate.set(state, s(S_W), w)
    kstate.set(state, s(S_H), h)
    kstate.set(state, s(S_PITCH), pitch)
    kstate.set(state, s(S_FBOFF), reg_r(state, R_FB_OFFSET))
    return true
}

// ------------------------------------------------------------ Weg 3: the mode without any loader framebuffer

// `-vga vmware -kernel` has no Bochs VBE and no multiboot framebuffer. Set the mode here and hand `fb.init` a synthetic
// multiboot info. Returns its address, 0 when VMSVGA cannot do it.
fn boot_mbi(state: u64, w: u64, h: u64) -> u64 {
    if !probe(state) {
        return 0
    }
    if !set_mode(state, w, h) {
        return 0
    }
    let m: u64 = state + s(S_MBI)
    var z: u64 = 0
    while z < 128 {
        __mmio_write8((m + z) as *mut u8, 0)
        z = z + 1
    }
    let ph: u64 = kstate.get(state, s(S_VRAM)) + kstate.get(state, s(S_FBOFF))
    wr32(m, 0, 0x1000)
    __mmio_write64((m + 88) as *mut u64, ph)
    wr32(m, 96, kstate.get(state, s(S_PITCH)))
    wr32(m, 100, w)
    wr32(m, 104, h)
    __mmio_write8((m + 108) as *mut u8, 32)
    __mmio_write8((m + 109) as *mut u8, 1)
    __mmio_write8((m + 110) as *mut u8, 16)
    __mmio_write8((m + 112) as *mut u8, 8)
    __mmio_write8((m + 114) as *mut u8, 0)
    return m
}

// ------------------------------------------------------------ FIFO

fn fifo(state: u64) -> u64 {
    return kstate.get(state, s(S_FIFO))
}

fn fifo_setup(state: u64) -> bool {
    let f: u64 = fifo(state)
    if f == 0 {
        return false
    }
    let sz: u64 = kstate.get(state, s(S_FIFOSZ))
    var mn: u64 = 16
    if has_cap(state, CAP_EXTENDED_FIFO) {
        let regs: u64 = reg_r(state, R_MEM_REGS)
        if regs * 4 > mn {
            mn = regs * 4
        }
    }
    if sz < mn + 0x2800 {
        return false
    }
    reg_w(state, R_CONFIG_DONE, 0) // order (vmwgfx): ENABLE, CONFIG_DONE=0, FIFO header, CONFIG_DONE=1
    wr32(f, F_MIN * 4, mn)
    wr32(f, F_MAX * 4, sz)
    wr32(f, F_NEXT * 4, mn)
    wr32(f, F_STOP * 4, mn)
    if has_cap(state, CAP_EXTENDED_FIFO) {
        kstate.set(state, s(S_FCAPS), rd32(f, F_CAPS * 4))
    } else {
        kstate.set(state, s(S_FCAPS), 0)
    }
    reg_w(state, R_GUEST_ID, 0x5010) // "Other 64-bit" guest id; informational
    reg_w(state, R_CONFIG_DONE, 1)
    traces_off(state)
    return true
}

// TRACES = 0 (like vmwgfx). VirtualBox defaults to 1 and then write-protects the WHOLE VRAM to catch guest writes (a dirty-page
// handler on every store: the host CPU load of the rectangle path); the driver tells the host explicitly with UPDATE anyway.
// Written after CONFIG_DONE and again after every mode change.
fn traces_off(state: u64) {
    reg_w(state, R_TRACES, 0)
    kstate.set(state, s(S_TRACES), reg_r(state, R_TRACES))
}

// Bounded wait for BUSY == 0 by TIME, polling every 20 us (a tight reg_r loop is two VM exits per poll: tens of thousands of exits).
fn busy_poll(state: u64, ms: u64) {
    var hz: u64 = apic.tsc_hz(state)
    if hz < 100000000 || hz > 10000000000 {
        hz = 4000000000
    }
    let t0: u64 = apic.tsc()
    let span: u64 = hz / 1000 * ms
    while reg_r(state, R_BUSY) != 0 {
        if apic.tsc() - t0 >= span {
            return
        }
        spin_us(state, 20)
    }
}

fn sync_wait(state: u64) {
    reg_w(state, R_SYNC, 1)
    busy_poll(state, 1000)
}

// After a command: wait (bounded) until the host is no longer busy, so it never falls behind with whole-picture UPDATEs.
fn busy_wait(state: u64) {
    busy_poll(state, 40)
}

// Make room for `words` u32 words and remember the write position. false = FIFO stayed full.
fn fifo_begin(state: u64, words: u64) -> bool {
    let f: u64 = fifo(state)
    let need: u64 = words * 4 + 4
    var tries: u64 = 0
    while tries < 4 {
        let mn: u64 = rd32(f, F_MIN * 4)
        let mx: u64 = rd32(f, F_MAX * 4)
        let nx: u64 = rd32(f, F_NEXT * 4)
        let st: u64 = rd32(f, F_STOP * 4)
        if nx < mn || nx >= mx || st < mn || st >= mx {
            return false
        }
        var free: u64 = 0
        if nx >= st {
            free = (mx - nx) + (st - mn)
        } else {
            free = st - nx
        }
        if free > need {
            kstate.set(state, s(S_WNEXT), nx)
            return true
        }
        sync_wait(state)
        tries = tries + 1
    }
    kstate.add(state, s(S_FULL), 1)
    return false
}

fn fifo_put(state: u64, v: u64) {
    let f: u64 = fifo(state)
    var nx: u64 = kstate.get(state, s(S_WNEXT))
    wr32(f, nx, v)
    nx = nx + 4
    if nx >= rd32(f, F_MAX * 4) {
        nx = rd32(f, F_MIN * 4)
    }
    kstate.set(state, s(S_WNEXT), nx)
}

// Publish the command: NEXT_CMD last, then wake the device.
fn fifo_commit(state: u64) {
    let f: u64 = fifo(state)
    arch.barrier_write()
    wr32(f, F_NEXT * 4, kstate.get(state, s(S_WNEXT)))
    arch.barrier_write()
    reg_w(state, R_SYNC, 1)
}

// ------------------------------------------------------------ the update

fn send_update(state: u64, x: u64, y: u64, w: u64, h: u64) -> bool {
    if !fifo_begin(state, 5) {
        return false
    }
    fifo_put(state, CMD_UPDATE)
    fifo_put(state, x)
    fifo_put(state, y)
    fifo_put(state, w)
    fifo_put(state, h)
    fifo_commit(state)
    kstate.add(state, s(S_UPDATES), 1)
    kstate.add(state, s(S_UPOKT), w *% h *% 4)
    kstate.set(state, s(S_LASTUPD), now_ms(state))
    return true
}

fn now_ms(state: u64) -> u64 {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return 0
    }
    return apic.tsc() / (hz / 1000)
}

// Take the box the copy sites noted (and clear it) with interrupts off.
fn acc_take(state: u64, x0: *mut u64, y0: *mut u64, x1: *mut u64, y1: *mut u64) -> bool {
    let fl: u64 = box_lock(state)
    let ok: bool = kstate.get(state, s(S_ACC_VALID)) != 0
    if ok {
        __mmio_write64(x0, kstate.get(state, s(S_ACC_X0)))
        __mmio_write64(y0, kstate.get(state, s(S_ACC_Y0)))
        __mmio_write64(x1, kstate.get(state, s(S_ACC_X1)))
        __mmio_write64(y1, kstate.get(state, s(S_ACC_Y1)))
        kstate.set(state, s(S_ACC_VALID), 0)
    }
    box_unlock(state, fl)
    return ok
}

// The dirty box is written by fb.vms_note on every core and taken here: interrupts off AND a spin lock (cmpxchg), because
// irq_save alone only excludes the same core (SMP lost notes).
fn box_lock(state: u64) -> u64 {
    let fl: u64 = arch.irq_save()
    let lk: *mut u64 = (state + VMSVGA_OFF + S_LOCK) as *mut u64
    var got: u64 = __atomic_swap(lk, 0, 1)
    while got != 0 {
        arch.pause()
        got = __atomic_swap(lk, 0, 1)
    }
    return fl
}

fn box_unlock(state: u64, fl: u64) {
    let lk: *mut u64 = (state + VMSVGA_OFF + S_LOCK) as *mut u64
    __mmio_write64(lk, 0)
    arch.irq_restore(fl)
}

// Forget the dirty box (under the lock).
fn box_clear(state: u64) {
    let fl: u64 = box_lock(state)
    kstate.set(state, s(S_ACC_VALID), 0)
    box_unlock(state, fl)
}

// verify (word vmsvgahw): the host may only be told what changed. Compare VRAM with the copy of what the host was told,
// everywhere OUTSIDE the box; then copy the box into the "told" copy. Counts differing pixels in `bad`.
fn verify_frame(state: u64, x0: u64, y0: u64, x1: u64, y1: u64) {
    let pres: u64 = kstate.get(state, s(S_PRES))
    let vr: u64 = fb.addr(state)
    if pres == 0 || vr == 0 {
        return
    }
    let w: u64 = kstate.get(state, s(S_W))
    let h: u64 = kstate.get(state, s(S_H))
    let pt: u64 = fb.panel_pitch(state)
    var bad: u64 = 0
    var y: u64 = 0
    while y < h {
        let row: u64 = y * pt
        var x: u64 = 0
        while x < w {
            var inside: bool = false
            if y >= y0 && y < y1 && x >= x0 && x < x1 {
                inside = true
            }
            if inside {
                x = x1 // the whole box part of this row is inside
            } else {
                if rd32(vr, row + x * 4) != rd32(pres, row + x * 4) {
                    bad = bad + 1
                }
                x = x + 1
            }
        }
        y = y + 1
    }
    // the box now counts as told
    y = y0
    while y < y1 && y < h {
        var x2: u64 = x0
        while x2 < x1 && x2 < w {
            wr32(pres, y * pt + x2 * 4, rd32(vr, y * pt + x2 * 4))
            x2 = x2 + 1
        }
        y = y + 1
    }
    kstate.add(state, s(S_BAD), bad)
    kstate.add(state, s(S_VERIFYN), 1)
}

fn present(state: u64) -> bool {
    if !bereit(state) {
        return false
    }
    kstate.add(state, s(S_PCALLS), 1)
    var x0: u64 = 0
    var y0: u64 = 0
    var x1: u64 = 0
    var y1: u64 = 0
    let rect_way: bool = kstate.mode_on(state, kstate.M_VMSVGARECT)
    if !acc_take(state, &x0, &y0, &x1, &y1) {
        // Nothing painted. The idle path costs a time read and compares and NO port I/O unless something is due.
        let nm: u64 = now_ms(state)
        if nm == 0 {
            return true
        }
        // 1. self-heal after a mode change: VirtualBox rebuilds its host framebuffer asynchronously after ENABLE/WIDTH/HEIGHT/BPP,
        //    so the whole-picture UPDATE right after it can be lost -> again at +100 / +500 / +2000 ms.
        let st: u64 = kstate.get(state, s(S_HEAL_STAGE))
        if st != 0 {
            let t0: u64 = kstate.get(state, s(S_HEAL_T0))
            var due: u64 = t0 + HEAL_3_MS
            if st == 3 {
                due = t0 + HEAL_1_MS
            }
            if st == 2 {
                due = t0 + HEAL_2_MS
            }
            if nm >= due {
                kstate.set(state, s(S_HEAL_STAGE), st - 1)
                return heal(state, rect_way)
            }
            return true
        }
        // 2. keep-alive: one whole-picture UPDATE TRAIL_MS after the last painted frame (repairs a lost UPDATE of the last frame)
        let tr: u64 = kstate.get(state, s(S_TRAIL))
        if tr != 0 && nm >= tr {
            kstate.set(state, s(S_TRAIL), 0)
            return heal(state, rect_way)
        }
        // 3. safety net: a writer that does not go through fb.vms_note (/dev/fb) would never be shown. After SAFETY_MS without any
        //    UPDATE tell the host the whole picture once (8 MB per 10 s at 1920x1080, nothing while frames flow).
        let last: u64 = kstate.get(state, s(S_LASTUPD))
        var lim: u64 = SAFETY_MS
        if !rect_way {
            lim = SAFETY_FULL_MS
        }
        if last != 0 && nm > last + lim {
            kstate.add(state, s(S_SAFETY), 1)
            if !rect_way {
                redraw_all(state)
            }
            return send_full(state)
        }
        return true
    }
    kstate.add(state, s(S_PFRAMES), 1)
    let sw: u64 = kstate.get(state, s(S_W))
    let sh: u64 = kstate.get(state, s(S_H))
    if x1 > sw {
        x1 = sw
    }
    if y1 > sh {
        y1 = sh
    }
    if x1 <= x0 || y1 <= y0 {
        return true
    }
    // something was painted: a trailing whole-picture UPDATE follows when the picture stays quiet
    let nw: u64 = now_ms(state)
    if nw != 0 {
        kstate.set(state, s(S_TRAIL), nw + TRAIL_MS)
    }
    if kstate.mode_on(state, kstate.M_VMSVGAHW) {
        verify_frame(state, x0, y0, x1, y1)
    }
    if !rect_way {
        return send_full(state)
    }
    return send_update(state, x0, y0, x1 - x0, y1 - y0)
}

// A self-heal UPDATE: the whole picture again (full-update way: VRAM rewritten from the back buffer first, because ENABLE 0 -> 1
// zeroes the VRAM). Never arms the trailing UPDATE again, so an idle screen goes silent.
fn heal(state: u64, rect_way: bool) -> bool {
    kstate.add(state, s(S_HEALS), 1)
    if !rect_way {
        redraw_all(state)
    }
    return send_full(state)
}

// Arm the three heal stages from now (after ENABLE / a mode change).
fn heal_arm(state: u64) {
    let nm: u64 = now_ms(state)
    if nm == 0 {
        return
    }
    kstate.set(state, s(S_HEAL_T0), nm)
    kstate.set(state, s(S_HEAL_STAGE), 3)
}

// Full-update way: rewrite VRAM completely from the back buffer (no diff, no shadow), then the caller sends the full UPDATE.
// The box fb.flush notes again is dropped here, so an idle screen stays idle.
fn redraw_all(state: u64) {
    kstate.add(state, s(S_REDRAW), 1)
    fb.dirty_all(state)
    fb.flush(state)
    box_clear(state)
}

// ONE UPDATE for the whole picture, then the SYNC/BUSY handshake.
fn send_full(state: u64) -> bool {
    let ok: bool = send_update(state, 0, 0, kstate.get(state, s(S_W)), kstate.get(state, s(S_H)))
    busy_wait(state)
    return ok
}

// Panic path (r967): trap.fi calls this AFTER it stopped every other core. The panic picture is already in VRAM (kgui.panikbild ends
// with fb.flush), but the only present() caller is the desktop loop, so VirtualBox (TRACES=0: it does not watch VRAM) never showed
// the picture. A stopped core may have died inside present(): open the box lock and the port-pair lock (nobody is left to release
// them), let the stop NMI land first, then send ONE whole-picture UPDATE with the SYNC/BUSY handshake. Never waits for another core.
fn panic_present(state: u64) {
    var s_p: [u8; 31] = "vmsvga: panic picture sent ok=\0"
    if !bereit(state) {
        return
    }
    var hz: u64 = apic.tsc_hz(state)
    if hz < 100000000 || hz > 10000000000 {
        hz = 4000000000
    }
    let t0: u64 = apic.tsc()
    while apic.tsc() - t0 < hz / 500 {
        arch.pause()
    }
    kstate.set(state, s(S_LOCK), 0)
    kstate.set(state, s(S_PLOCK), 0)
    let ok: bool = send_full(state)
    serial.puts((&s_p[0]) as u64)
    if ok {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.nl()
}

// ------------------------------------------------------------ cursor

fn cursor_hw(state: u64) -> bool {
    if has_cap(state, CAP_CURSOR) && has_cap(state, CAP_CURSOR_BYPASS) {
        return true
    }
    return (kstate.get(state, s(S_FCAPS)) & FC_CURSOR_BYPASS_3) != 0
        && has_cap(state, CAP_EXTENDED_FIFO)
}

fn cursor_bereit(state: u64) -> bool {
    return bereit(state) && cursor_hw(state)
}

// ARGB of one pointer pixel from the coverage word `cursor.deck` returns (same maths as vgpu.cursor_bild_fuellen).
fn cursor_argb(v: u64) -> u64 {
    if v == 0 {
        return 0
    }
    let ak: u64 = (v >> 16) & 255
    let ar: u64 = (v >> 8) & 255
    let asch: u64 = v & 255
    var rr: u64 = 0
    var aa: u64 = 0
    if asch != 0 && ak == 0 && ar == 0 {
        aa = asch * 90 / 255
    }
    if ar != 0 {
        rr = 255 * ar / 255
        aa = aa + (255 - aa) * ar / 255
    }
    if ak != 0 {
        rr = rr - rr * ak / 255
        aa = aa + (255 - aa) * ak / 255
    }
    if aa > 255 {
        aa = 255
    }
    return (aa << 24) | (rr << 16) | (rr << 8) | rr
}

fn cursor_define(state: u64, form: u64, g: u64, hx0: u64, hy0: u64, rq: u64) -> bool {
    if g == 0 || g > CUR_W {
        return false
    }
    cursor.karte_bauen(form, g)
    let hx: u64 = cursor.rot_hot_x(g, rq, hx0, hy0)
    let hy: u64 = cursor.rot_hot_y(g, rq, hx0, hy0)
    if has_cap(state, CAP_ALPHA_CURSOR) {
        if !fifo_begin(state, 6 + g * g) {
            return false
        }
        fifo_put(state, CMD_DEFINE_ALPHA_CURSOR)
        fifo_put(state, 1)
        fifo_put(state, hx)
        fifo_put(state, hy)
        fifo_put(state, g)
        fifo_put(state, g)
        var r: u64 = 0
        while r < g {
            var c: u64 = 0
            while c < g {
                fifo_put(state, cursor_argb(cursor.deck_rot(g, rq, c, r)))
                c = c + 1
            }
            r = r + 1
        }
        fifo_commit(state)
        return true
    }
    // legacy: and-mask 1 bit per pixel (1 = keep the screen), 32 bit xor image; rows padded to 32 bits
    let mw: u64 = (g + 31) / 32
    if !fifo_begin(state, 8 + mw * g + g * g) {
        return false
    }
    fifo_put(state, CMD_DEFINE_CURSOR)
    fifo_put(state, 1)
    fifo_put(state, hx)
    fifo_put(state, hy)
    fifo_put(state, g)
    fifo_put(state, g)
    fifo_put(state, 1)
    fifo_put(state, 32)
    var r2: u64 = 0
    while r2 < g {
        var wd: u64 = 0
        while wd < mw {
            var bits: u64 = 0
            var b: u64 = 0
            while b < 32 {
                let c2: u64 = wd * 32 + b
                var keep: u64 = 1
                if c2 < g {
                    if (cursor_argb(cursor.deck_rot(g, rq, c2, r2)) >> 24) >= 128 {
                        keep = 0
                    }
                }
                bits = bits | (keep << b)
                b = b + 1
            }
            fifo_put(state, bits)
            wd = wd + 1
        }
        r2 = r2 + 1
    }
    r2 = 0
    while r2 < g {
        var c3: u64 = 0
        while c3 < g {
            let p: u64 = cursor_argb(cursor.deck_rot(g, rq, c3, r2))
            if (p >> 24) >= 128 {
                fifo_put(state, p & 0xFFFFFF)
            } else {
                fifo_put(state, 0)
            }
            c3 = c3 + 1
        }
        r2 = r2 + 1
    }
    fifo_commit(state)
    return true
}

fn cursor_pos(state: u64, x: u64, y: u64, on: u64) {
    if (kstate.get(state, s(S_FCAPS)) & FC_CURSOR_BYPASS_3) != 0 && has_cap(state, CAP_EXTENDED_FIFO) {
        let f: u64 = fifo(state)
        wr32(f, F_CURSOR_ON * 4, on)
        wr32(f, F_CURSOR_X * 4, x)
        wr32(f, F_CURSOR_Y * 4, y)
        wr32(f, F_CURSOR_COUNT * 4, rd32(f, F_CURSOR_COUNT * 4) + 1)
        return
    }
    reg_w(state, R_CURSOR_ID, 1)
    reg_w(state, R_CURSOR_X, x)
    reg_w(state, R_CURSOR_Y, y)
    reg_w(state, R_CURSOR_ON, on)
}

fn cursor_zeigen(state: u64, form: u64, g: u64, x: u64, y: u64, hx: u64, hy: u64, rq: u64) -> bool {
    if !cursor_bereit(state) {
        return false
    }
    let key: u64 = form + 1 + (rq << 16)
    if kstate.get(state, s(S_CURFORM)) != key || kstate.get(state, s(S_CURGR)) != g {
        if !cursor_define(state, form, g, hx, hy, rq) {
            kstate.add(state, s(S_CURERR), 1)
            return false
        }
        kstate.set(state, s(S_CURFORM), key)
        kstate.set(state, s(S_CURGR), g)
        kstate.add(state, s(S_CURDEF), 1)
    }
    cursor_pos(state, x, y, 1)
    kstate.set(state, s(S_CURON), 1)
    kstate.set(state, s(S_CURX), x)
    kstate.set(state, s(S_CURY), y)
    return true
}

fn cursor_bewegen(state: u64, x: u64, y: u64) -> bool {
    if !cursor_bereit(state) || kstate.get(state, s(S_CURON)) == 0 {
        return false
    }
    if kstate.get(state, s(S_CURX)) == x && kstate.get(state, s(S_CURY)) == y {
        return true
    }
    cursor_pos(state, x, y, 1)
    kstate.add(state, s(S_CURMOVE), 1)
    kstate.set(state, s(S_CURX), x)
    kstate.set(state, s(S_CURY), y)
    return true
}

fn cursor_aus(state: u64) -> bool {
    if !cursor_bereit(state) || kstate.get(state, s(S_CURON)) == 0 {
        return false
    }
    cursor_pos(state, kstate.get(state, s(S_CURX)), kstate.get(state, s(S_CURY)), 0)
    kstate.set(state, s(S_CURON), 0)
    return true
}

fn cursor_an(state: u64) -> bool {
    return kstate.get(state, s(S_CURON)) != 0
}

fn cursor_defs(state: u64) -> u64 { return kstate.get(state, s(S_CURDEF)) }
fn cursor_moves(state: u64) -> u64 { return kstate.get(state, s(S_CURMOVE)) }
fn cursor_fehler(state: u64) -> u64 { return kstate.get(state, s(S_CURERR)) }

// ------------------------------------------------------------ resize

// Host-requested size. QEMU has NO host hint at all (always 0). On VirtualBox/VMware the hint would come through the display
// topology registers (CAP_DISPLAY_TOPOLOGY: select DISPLAY_ID 0, read DISPLAY_WIDTH/HEIGHT) [VBOX?, UNVERIFIED: untested on the real
// device]. Defensive: only a sane size (>= 640x480, inside the device limits) that DIFFERS from the current mode, was seen on two
// polls in a row and was not tried before counts. Polled at most every POLL_MS (1 s). Returns w << 16 | h, 0 = none.
fn host_pending(state: u64) -> u64 {
    let vmm: bool = kstate.get(state, s(S_VMM_UP)) != 0
    if !bereit(state) || (!vmm && !has_cap(state, CAP_DISPLAY_TOPOLOGY)) {
        return 0
    }
    if kstate.get(state, s(S_VMM_FAKE)) == 0 {
        let hz: u64 = apic.tsc_hz(state)
        if hz == 0 {
            return 0
        }
        let now: u64 = apic.tsc() / (hz / 1000)
        if now < kstate.get(state, s(S_NEXTPOLL)) {
            return 0
        }
        kstate.set(state, s(S_NEXTPOLL), now + POLL_MS)
    }
    var w: u64 = 0
    var h: u64 = 0
    if vmm {
        // VirtualBox: the hint comes from the guest device (VMMDev), NOT from the VMSVGA registers (they only echo the current mode)
        let hv: u64 = vmm_hint(state)
        w = hv / 65536
        h = hv % 65536
        if w == 0 || h == 0 {
            return 0 // the host never sent a hint
        }
    } else {
        if kstate.get(state, s(S_IDSET)) == 0 {
            reg_w(state, R_DISPLAY_ID, 0)
            kstate.set(state, s(S_IDSET), 1)
        }
        w = reg_r(state, R_DISPLAY_W)
        h = reg_r(state, R_DISPLAY_H)
    }
    if w == kstate.get(state, s(S_W)) && h == kstate.get(state, s(S_H)) {
        kstate.set(state, s(S_SEEN), 0)
        kstate.set(state, s(S_SEENN), 0)
        kstate.set(state, s(S_HANDLED), 0)
        return 0
    }
    // Sane sizes only. NOT checked against the device limits here: a hint beyond VRAM or the kernel map window (a 4K host screen)
    // is shrunk to fit by vmode.follow_host, which keeps the aspect ratio.
    if w < 640 || h < 480 || w > 8192 || h > 8192 {
        return 0
    }
    let v: u64 = (w << 16) | h
    if v == kstate.get(state, s(S_HANDLED)) {
        return 0
    }
    if v == kstate.get(state, s(S_SEEN)) {
        kstate.add(state, s(S_SEENN), 1)
    } else {
        kstate.set(state, s(S_SEEN), v)
        kstate.set(state, s(S_SEENN), 1)
    }
    if kstate.get(state, s(S_SEENN)) >= 2 {
        kstate.set(state, s(S_HANDLED), v)
        kstate.set(state, s(S_SEENN), 0)
        kstate.add(state, s(S_HOSTRSZ), 1)
        return v
    }
    return 0
}

// W-C3: the host hint AT BOOT, before the desktop exists. VirtualBox keeps the last hint (the VM window size) in the VMMDev across a
// guest reset, so it can be read right after the announcement. Without this the login screen stayed at the boot mode (1024x768, black
// frame) until the idle task had polled twice, ~70 s into the boot. Returns w << 16 | h, 0 = none / not VirtualBox / not sane.
fn boot_handled(state: u64, v: u64) {
    kstate.set(state, s(S_HANDLED), v)
}

fn boot_hint(state: u64) -> u64 {
    if !bereit(state) || kstate.get(state, s(S_VMM_UP)) == 0 {
        return 0
    }
    var n: u64 = 0
    while n < 3 {
        let hv: u64 = vmm_hint(state)
        let w: u64 = hv / 65536
        let h: u64 = hv % 65536
        if w >= 640 && h >= 480 && w <= 8192 && h <= 8192 {
            return hv
        }
        n = n + 1
    }
    return 0
}

// ------------------------------------------------------------ VirtualBox host hint (VMMDev, PCI 80ee:cafe)
//
// WHY: the host asks for a new size (VM window dragged / full screen / Windows scaling) through the guest device, not through the
// VMSVGA registers: VirtualBox's SVGA_REG_DISPLAY_WIDTH/HEIGHT only echo the CURRENT mode and it does not offer
// SVGA_CAP_DISPLAY_TOPOLOGY at all (reports/vmsvga-ref/vbox-DevVGA-SVGA.cpp, svgaReadPort). Display::setVideoModeHint stores the
// hint in the VMMDev (VMMDevReq_GetDisplayChangeRequest2); the VM window only sends one when the guest announced the graphics capability.
// HOW: announce (REPORT_GUEST_INFO, REPORT_GUEST_INFO2, driver + graphics facility, SET_GUEST_CAPABILITIES graphics), then read the
// last hint with event_ack = 0 once per poll (a request is: write its physical address to the I/O port, the host fills `rc`).
// Layouts: Linux drivers/virt/vboxguest/vmmdev.h and VirtualBox include/VBox/VMMDev.h (copies in data/vmmdev-ref).
const VENDOR_VBOX: u64 = 0x80EE
const DEVICE_VMMDEV: u64 = 0xCAFE
const VMM_HDR_VERSION: u64 = 0x10001
const VMM_VERSION: u64 = 0x10004
const VMMREQ_REPORT_GUEST_INFO: u64 = 50
const VMMREQ_GET_DISPLAY_CHANGE2: u64 = 54
const VMMREQ_SET_GUEST_CAPS: u64 = 56
const VMMREQ_REPORT_GUEST_INFO2: u64 = 58
const VMMREQ_REPORT_GUEST_STATUS: u64 = 59
const VMM_CAP_GRAPHICS: u64 = 4
const VMM_EVENT_DISPLAY: u64 = 4
const VMM_FAC_DRIVER: u64 = 20
const VMM_FAC_GRAPHICS: u64 = 1100
const VMM_ST_ACTIVE: u64 = 50

fn vmm_up(state: u64) -> bool {
    return kstate.get(state, s(S_VMM_UP)) != 0
}

// Test bed: answer hints from this value instead of the device (w << 16 | h; 0 = back to the device).
fn vmm_fake(state: u64, v: u64) {
    kstate.set(state, s(S_VMM_FAKE), v)
    if v != 0 {
        kstate.set(state, s(S_VMM_UP), 1)
    }
}

fn vmm_find(state: u64) -> u64 {
    let n: u64 = pci.count(state)
    var i: u64 = 0
    while i < n {
        if pci.get(state, i, pci.E_VENDOR) == VENDOR_VBOX && pci.get(state, i, pci.E_DEVICE) == DEVICE_VMMDEV {
            return i
        }
        i = i + 1
    }
    return pci.MAX_DEV
}

// One request: header (size, version, type, rc, 2 reserved words), body already written at +24. True when the host answered rc >= 0.
fn vmm_call(state: u64, ty: u64, size: u64) -> bool {
    let rq: u64 = kstate.get(state, s(S_VMM_REQ))
    let io: u64 = kstate.get(state, s(S_VMM_IO))
    if rq == 0 || io == 0 {
        return false
    }
    wr32(rq, 0, size)
    wr32(rq, 4, VMM_HDR_VERSION)
    wr32(rq, 8, ty)
    wr32(rq, 12, 0x80000000) // "not processed" marker: the host overwrites it
    wr32(rq, 16, 0)
    wr32(rq, 20, 0)
    arch.dev_out32(io as u16, rq as u32)
    let rc: u64 = rd32(rq, 12)
    if rc >= 0x80000000 {
        kstate.add(state, s(S_VMM_ERR), 1)
        kstate.set(state, s(S_VMM_RC), rc)
        kstate.set(state, s(S_VMM_FTY), ty)
        kstate.set(state, s(S_VMM_FMASK), kstate.get(state, s(S_VMM_FMASK)) | (1 << (ty % 64)))
        return false
    }
    return true
}

fn vmm_zero_body(state: u64, bytes: u64) {
    let rq: u64 = kstate.get(state, s(S_VMM_REQ))
    var k: u64 = 24
    while k < 24 + bytes {
        wr32(rq, k, 0)
        k = k + 4
    }
}

fn vmm_status(state: u64, facility: u64) -> bool {
    let rq: u64 = kstate.get(state, s(S_VMM_REQ))
    vmm_zero_body(state, 12)
    wr32(rq, 24, facility)
    wr32(rq, 28, VMM_ST_ACTIVE)
    wr32(rq, 32, 0)
    return vmm_call(state, VMMREQ_REPORT_GUEST_STATUS, 36)
}

// Find the VirtualBox guest device and announce a graphics capable guest. Safe to call twice; silent and cheap without the device
// (QEMU, VMware, real hardware).
fn vmm_init(state: u64) {
    if kstate.get(state, s(S_VMM_UP)) != 0 {
        return
    }
    let i: u64 = vmm_find(state)
    if i >= pci.MAX_DEV || !pci.bar_is_io(state, i, 0) {
        return
    }
    let io: u64 = pci.bar(state, i, 0)
    if io == 0 || io > 0xFFF0 {
        return
    }
    let d: u64 = pci.get(state, i, pci.E_BDF)
    pci.cfg_write16(d, CFG_COMMAND, pci.cfg_read16(d, CFG_COMMAND) | 3)
    let p: u64 = mem.frame_run(state, 1)
    if p == 0 || p >= 0x100000000 {
        return
    }
    kstate.set(state, s(S_VMM_IO), io)
    kstate.set(state, s(S_VMM_REQ), p)
    // 1. who we are (interface version 1.4, OS type "other, 64 bit")
    vmm_zero_body(state, 8)
    wr32(p, 24, VMM_VERSION)
    wr32(p, 28, 0x100)
    if !vmm_call(state, VMMREQ_REPORT_GUEST_INFO, 32) {
        kstate.set(state, s(S_VMM_IO), 0)
        return
    }
    // 2. additions version 7.2.20 (the host compares it with its own and complains about an older one) + name
    vmm_zero_body(state, 144)
    wr32(p, 24, (2 << 16) | 7)
    wr32(p, 28, 20)
    wr32(p, 32, 175154) // SVN revision of the 7.2.20 release (r0 made the host answer rc = -2)
    wr32(p, 36, 0)
    wr32(p, 40, 0x6569724F) // "Orie"
    wr32(p, 44, 0x534F746E) // "ntOS"
    let _i2: bool = vmm_call(state, VMMREQ_REPORT_GUEST_INFO2, 24 + 144)
    // 3. the driver is up, the graphics capability makes the VM window send resize hints
    let _s1: bool = vmm_status(state, VMM_FAC_DRIVER)
    // NO event filter mask on purpose (Z1, 17.10.2026): with the display bit in the filter the host raises the VMMDev interrupt on a
    // resize hint, we have no handler for that level-triggered line and the VM froze right after setvideomodehint. We poll instead.
    vmm_zero_body(state, 8)
    wr32(p, 24, VMM_CAP_GRAPHICS)
    wr32(p, 28, 0)
    let c: bool = vmm_call(state, VMMREQ_SET_GUEST_CAPS, 32)
    let g: bool = vmm_status(state, VMM_FAC_GRAPHICS)
    var ok: u64 = 0
    if c {
        ok = ok + 1
    }
    if g {
        ok = ok + 2
    }
    kstate.set(state, s(S_VMM_ACK), ok)
    kstate.set(state, s(S_VMM_UP), 1)
}

// The last size the host asked for (w << 16 | h), 0 = none or the request failed.
fn vmm_hint(state: u64) -> u64 {
    let fk: u64 = kstate.get(state, s(S_VMM_FAKE))
    if fk != 0 {
        kstate.set(state, s(S_VMM_HINT), fk)
        return fk
    }
    // one core at a time: the idle task and the desktop loop both poll; the loser simply skips this poll
    let bz: *mut u64 = (state + VMSVGA_OFF + S_VMM_BUSY) as *mut u64
    let was: u64 = __atomic_swap(bz, 0, 1)
    if was != 0 {
        return 0
    }
    let r: u64 = vmm_hint_locked(state)
    __mmio_write64(bz, 0)
    return r
}

fn vmm_hint_locked(state: u64) -> u64 {
    let rq: u64 = kstate.get(state, s(S_VMM_REQ))
    vmm_zero_body(state, 20)
    wr32(rq, 24, 0) // xres
    wr32(rq, 28, 0) // yres
    wr32(rq, 32, 0) // bpp
    // event_ack = VMMDEV_EVENT_DISPLAY_CHANGE_REQUEST (4): the host returns the CURRENT request and marks it as read. With 0 it answers
    // with the last request the guest "read" through an event ack (VMMDev.cpp: lastReadDisplayChangeRequest), i.e. 0x0 forever.
    wr32(rq, 36, VMM_EVENT_DISPLAY)
    wr32(rq, 40, 0) // display 0
    if !vmm_call(state, VMMREQ_GET_DISPLAY_CHANGE2, 44) {
        return 0
    }
    kstate.add(state, s(S_VMM_POLLS), 1)
    let w: u64 = rd32(rq, 24)
    let h: u64 = rd32(rq, 28)
    if w > 65535 || h > 65535 {
        return 0
    }
    let v: u64 = (w << 16) | h
    let changed: bool = v != kstate.get(state, s(S_VMM_HINT))
    kstate.set(state, s(S_VMM_HINT), v)
    if changed {
        vmm_say(state) // the hint changed: one serial line (hint=WxH)
    }
    return v
}

fn vmm_say(state: u64) {
    var s_a: [u8; 12] = "vmmdev: io=\0"
    var s_u: [u8; 5] = " up=\0"
    var s_k: [u8; 6] = " ack=\0"
    var s_p: [u8; 8] = " polls=\0"
    var s_h: [u8; 7] = " hint=\0"
    var s_x: [u8; 2] = "x\0"
    var s_e: [u8; 6] = " err=\0"
    var s_r: [u8; 5] = " rc=\0"
    var s_t: [u8; 5] = " ty=\0"
    if kstate.get(state, s(S_VMM_UP)) == 0 {
        return
    }
    serial.puts((&s_a[0]) as u64)
    serial.hex(kstate.get(state, s(S_VMM_IO)))
    serial.puts((&s_u[0]) as u64)
    serial.dec(kstate.get(state, s(S_VMM_UP)))
    serial.puts((&s_k[0]) as u64)
    serial.dec(kstate.get(state, s(S_VMM_ACK)))
    serial.puts((&s_p[0]) as u64)
    serial.dec(kstate.get(state, s(S_VMM_POLLS)))
    serial.puts((&s_h[0]) as u64)
    serial.dec(kstate.get(state, s(S_VMM_HINT)) / 65536)
    serial.puts((&s_x[0]) as u64)
    serial.dec(kstate.get(state, s(S_VMM_HINT)) % 65536)
    serial.puts((&s_e[0]) as u64)
    serial.dec(kstate.get(state, s(S_VMM_ERR)))
    serial.puts((&s_r[0]) as u64)
    serial.hex(kstate.get(state, s(S_VMM_RC)))
    serial.puts((&s_t[0]) as u64)
    serial.dec(kstate.get(state, s(S_VMM_FTY)))
    serial.nl()
}

// Does the device take this size (limits only, nothing is written)?
fn size_ok(state: u64, w: u64, h: u64) -> bool {
    if kstate.get(state, s(S_UP)) == 0 || w == 0 || h == 0 {
        return false
    }
    let maxw: u64 = kstate.get(state, s(S_MAXW))
    let maxh: u64 = kstate.get(state, s(S_MAXH))
    if (maxw != 0 && w > maxw) || (maxh != 0 && h > maxh) {
        return false
    }
    let vsz: u64 = kstate.get(state, s(S_VRAMSZ))
    if vsz != 0 && w *% h *% 4 > vsz {
        return false
    }
    return true
}

fn vram_bytes(state: u64) -> u64 { return kstate.get(state, s(S_VRAMSZ)) }
fn pitch(state: u64) -> u64 { return kstate.get(state, s(S_PITCH)) }
fn safety_updates(state: u64) -> u64 { return kstate.get(state, s(S_SAFETY)) }
fn pio_count(state: u64) -> u64 { return kstate.get(state, s(S_PIO)) }
fn heal_count(state: u64) -> u64 { return kstate.get(state, s(S_HEALS)) }
// W-E: true while painted boxes wait for the next present() (the frame boundary has not run yet)
fn pending(state: u64) -> bool { return kstate.get(state, s(S_ACC_VALID)) != 0 }
fn present_calls(state: u64) -> u64 { return kstate.get(state, s(S_PCALLS)) }
fn present_frames(state: u64) -> u64 { return kstate.get(state, s(S_PFRAMES)) }
fn host_resizes(state: u64) -> u64 { return kstate.get(state, s(S_HOSTRSZ)) }
// Physical address of the scan-out start (VRAM + FB_OFFSET)
fn fb_phys(state: u64) -> u64 { return kstate.get(state, s(S_VRAM)) + kstate.get(state, s(S_FBOFF)) }

// Change the mode on a running system. The caller (vmode) re-points `fb` afterwards.
fn resize(state: u64, w: u64, h: u64) -> bool {
    if !bereit(state) {
        return false
    }
    if !set_mode(state, w, h) {
        kstate.add(state, s(S_RSZERR), 1)
        return false
    }
    kstate.add(state, s(S_RESIZES), 1)
    return true
}

// After vmode re-pointed `fb` at the new mode: forget the old dirty box, rebuild the verify copy, tell the host the whole picture.
fn resized(state: u64) {
    if !bereit(state) {
        return
    }
    let pres: u64 = kstate.get(state, s(S_PRES))
    let psz: u64 = kstate.get(state, s(S_PRESSZ))
    if pres != 0 {
        mem.frame_free_run(state, pres, (psz + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE)
        kstate.set(state, s(S_PRES), 0)
        kstate.set(state, s(S_PRESSZ), 0)
    }
    box_clear(state)
    alloc_verify(state)
    traces_off(state)
    kstate.set(state, s(S_IDSET), 0)
    let _u: bool = send_update(state, 0, 0, kstate.get(state, s(S_W)), kstate.get(state, s(S_H)))
    heal_arm(state)
}

// ------------------------------------------------------------ bring-up

fn alloc_verify(state: u64) {
    if !kstate.mode_on(state, kstate.M_VMSVGAHW) {
        return
    }
    let bytes: u64 = kstate.get(state, s(S_H)) * fb.panel_pitch(state)
    let fr: u64 = (bytes + mem.FRAME_SIZE - 1) / mem.FRAME_SIZE
    let p: u64 = mem.frame_run(state, fr)
    if p == 0 {
        return
    }
    var z: u64 = 0
    while z < bytes {
        wr32(p, z, rd32(fb.addr(state), z))
        z = z + 4
    }
    kstate.set(state, s(S_PRES), p)
    kstate.set(state, s(S_PRESSZ), bytes)
}

// After `fb.init`: bring the device in line with the framebuffer `fb` uses and start carrying the picture.
fn init(state: u64) -> bool {
    kstate.set(state, s(S_READY), 0)
    if !fb.ready(state) || fb.back(state) == 0 {
        return false
    }
    if !probe(state) {
        return false
    }
    let w: u64 = fb.width(state)
    let h: u64 = fb.height(state)
    if kstate.get(state, s(S_W)) != w || kstate.get(state, s(S_H)) != h {
        if !set_mode(state, w, h) {
            return false
        }
    }
    // the device may publish stride and scan-out offset a moment after ENABLE: read them again before they are used
    settle(state)
    var pt0: u64 = reg_r(state, R_BYTES_PER_LINE)
    if pt0 < w * 4 {
        pt0 = w * 4
    }
    kstate.set(state, s(S_PITCH), pt0)
    kstate.set(state, s(S_FBOFF), reg_r(state, R_FB_OFFSET))
    let ph: u64 = kstate.get(state, s(S_VRAM)) + kstate.get(state, s(S_FBOFF))
    let pt: u64 = kstate.get(state, s(S_PITCH))
    // fb.fi may point at the firmware LFB: a different address or stride -> map the VRAM the device scans out
    if fb.phys(state) != ph || fb.panel_pitch(state) != pt {
        if !fb.remap(state, ph, w, h, pt, fb.uncached(state)) {
            return false
        }
    }
    if !fifo_setup(state) {
        return false
    }
    kstate.set(state, s(S_ACC_VALID), 0)
    kstate.set(state, s(S_READY), 1)
    if !kstate.mode_on(state, kstate.M_VMSVGARECT) {
        fb.nodiff_force(state) // full-update way: whole rectangles to VRAM, no shadow comparison
    }
    fb.dirty_all(state)
    fb.flush(state)
    alloc_verify(state)
    let _u: bool = send_update(state, 0, 0, w, h)
    busy_wait(state)
    box_clear(state)
    heal_arm(state)
    vmm_init(state)
    return true
}

fn shut_down(state: u64) {
    kstate.set(state, s(S_READY), 0)
}

// ------------------------------------------------------------ report

fn say(state: u64) {
    var s_a: [u8; 13] = "vmsvga: bdf=\0"
    var s_id: [u8; 5] = " id=\0"
    var s_c: [u8; 7] = " caps=\0"
    var s_f: [u8; 7] = " fifo=\0"
    var s_v: [u8; 7] = " vram=\0"
    var s_m: [u8; 7] = " mode=\0"
    var s_x: [u8; 2] = "x\0"
    var s_p: [u8; 8] = " pitch=\0"
    var s_u: [u8; 6] = " upd=\0"
    var s_o: [u8; 6] = " okt=\0"
    var s_hc: [u8; 5] = " hc=\0"
    var s_fl: [u8; 7] = " full=\0"
    var s_rz: [u8; 6] = " rsz=\0"
    var s_rh: [u8; 7] = " host=\0"
    var s_re: [u8; 6] = " err=\0"
    var s_sf: [u8; 7] = " safe=\0"
    var s_pio: [u8; 6] = " pio=\0"
    var s_hl: [u8; 7] = " heal=\0"
    var s_tr: [u8; 9] = " traces=\0"
    var s_pc: [u8; 6] = " prs=\0"
    var s_pf: [u8; 6] = " pfr=\0"
    var s_vf: [u8; 20] = "vmsvga: verify bad=\0"
    var s_vn: [u8; 9] = " frames=\0"
    if kstate.get(state, s(S_UP)) == 0 {
        return // silent without the device: other boots keep their serial output
    }
    serial.puts((&s_a[0]) as u64)
    serial.hex(kstate.get(state, s(S_BDF)))
    serial.puts((&s_id[0]) as u64)
    serial.hex(kstate.get(state, s(S_ID)))
    serial.puts((&s_c[0]) as u64)
    serial.hex(kstate.get(state, s(S_CAPS)))
    serial.puts((&s_f[0]) as u64)
    serial.dec(kstate.get(state, s(S_FIFOSZ)))
    serial.puts((&s_v[0]) as u64)
    serial.dec(kstate.get(state, s(S_VRAMSZ)))
    serial.puts((&s_m[0]) as u64)
    serial.dec(kstate.get(state, s(S_W)))
    serial.puts((&s_x[0]) as u64)
    serial.dec(kstate.get(state, s(S_H)))
    serial.puts((&s_p[0]) as u64)
    serial.dec(kstate.get(state, s(S_PITCH)))
    serial.puts((&s_u[0]) as u64)
    serial.dec(kstate.get(state, s(S_UPDATES)))
    serial.puts((&s_o[0]) as u64)
    serial.dec(kstate.get(state, s(S_UPOKT)))
    serial.puts((&s_hc[0]) as u64)
    if cursor_hw(state) {
        serial.dec(1)
    } else {
        serial.dec(0)
    }
    serial.puts((&s_fl[0]) as u64)
    serial.dec(kstate.get(state, s(S_FULL)))
    serial.puts((&s_rz[0]) as u64)
    serial.dec(kstate.get(state, s(S_RESIZES)))
    serial.puts((&s_rh[0]) as u64)
    serial.dec(kstate.get(state, s(S_HOSTRSZ)))
    serial.puts((&s_re[0]) as u64)
    serial.dec(kstate.get(state, s(S_RSZERR)))
    serial.puts((&s_sf[0]) as u64)
    serial.dec(kstate.get(state, s(S_SAFETY)))
    serial.puts((&s_pio[0]) as u64)
    serial.dec(kstate.get(state, s(S_PIO)))
    serial.puts((&s_hl[0]) as u64)
    serial.dec(kstate.get(state, s(S_HEALS)))
    serial.puts((&s_tr[0]) as u64)
    serial.dec(kstate.get(state, s(S_TRACES)))
    serial.puts((&s_pc[0]) as u64)
    serial.dec(kstate.get(state, s(S_PCALLS)))
    serial.puts((&s_pf[0]) as u64)
    serial.dec(kstate.get(state, s(S_PFRAMES)))
    serial.nl()
    vmm_say(state)
    if kstate.mode_on(state, kstate.M_VMSVGAHW) {
        serial.puts((&s_vf[0]) as u64)
        serial.dec(kstate.get(state, s(S_BAD)))
        serial.puts((&s_vn[0]) as u64)
        serial.dec(kstate.get(state, s(S_VERIFYN)))
        serial.nl()
    }
}

// One short line for the desktop pulse (every 5 s, kgui.wait_wm): how often the loop called present() (prs), how many of those
// found a painted box (pfr), and what reached the host. The line that proves the desktop loop presents. Silent without the device.
fn pulse_say(state: u64) {
    var s_a: [u8; 19] = "vmsvga: pulse prs=\0"
    var s_f: [u8; 6] = " pfr=\0"
    var s_u: [u8; 6] = " upd=\0"
    var s_o: [u8; 6] = " okt=\0"
    var s_h: [u8; 7] = " heal=\0"
    var s_sf: [u8; 7] = " safe=\0"
    var s_pio: [u8; 6] = " pio=\0"
    if kstate.get(state, s(S_UP)) == 0 || kstate.get(state, s(S_READY)) == 0 {
        return
    }
    serial.puts((&s_a[0]) as u64)
    serial.dec(kstate.get(state, s(S_PCALLS)))
    serial.puts((&s_f[0]) as u64)
    serial.dec(kstate.get(state, s(S_PFRAMES)))
    serial.puts((&s_u[0]) as u64)
    serial.dec(kstate.get(state, s(S_UPDATES)))
    serial.puts((&s_o[0]) as u64)
    serial.dec(kstate.get(state, s(S_UPOKT)))
    serial.puts((&s_h[0]) as u64)
    serial.dec(kstate.get(state, s(S_HEALS)))
    serial.puts((&s_sf[0]) as u64)
    serial.dec(kstate.get(state, s(S_SAFETY)))
    serial.puts((&s_pio[0]) as u64)
    serial.dec(kstate.get(state, s(S_PIO)))
    serial.nl()
}
