profile kernel

import drv.usb.ehci
import drv.hid.kbd

export { pump }

fn pump(state: u64) {
    var n: u64 = 0
    while n < 16 {
        let c: u64 = ehci.out_take(state)
        if c == 0 {
            return
        }
        kbd.on_code(state, c - 1)
        n = n + 1
    }
}
