// kernel/ehci.fi -- Runde BLECH: DER USB-2.0-ANSCHLUSS.
// ---------------------------------------------------- WIE EHCI GEHT
// -------------------------------------- WAS AUF ECHTEM BLECH ZAEHLT

profile kernel

import serial
import lib.kstate
import bus.pci
import arch.x86_64.apic
import drv.hid.kbd

export {
    present, init, ready, stage, poll, report, selftest,
    base_of, bdf, ports, portsc, port_speed, handed_off,
    devices, dev_class, dev_addr, dev_mps, dev_vendor, dev_product,
    keys, reports, enums, errors, ctrl_xfers, polls,
    msc_ready, msc_blocks, msc_bsize, msc_read, msc_ios, msc_errors,
    have_kbd, legacy_cap, hcs_ports, hcc, caplen,
    EHCI_OFF, EHCI_MAX, C_NONE, C_KBD, C_MOUSE, C_MSC
}

const EHCI_OFF: u64 = 0x4D000
const EHCI_MAX: u64 = 0x3000

const PF_OFF: u64 = 0x4D000
const PF_ENTRIES: u64 = 1024

// Seite 2: Skalare, Warteschlangenkoepfe, Uebertragungssaetze.
const SCAL_OFF: u64 = 0x4E000
const QH_OFF: u64 = 0x4E200
const QTD_OFF: u64 = 0x4E400
const DEV_OFF: u64 = 0x4E800

const QH_BYTES: u64 = 0x60
const MAX_QH: u64 = 4
const QH_ASYNC: u64 = 0
const QH_WORK: u64 = 1 // Steuerung und Bulk
const QH_INT: u64 = 2
const QH_BULK: u64 = 3 // die zweite Bulk-Richtung

const QTD_BYTES: u64 = 0x40
const MAX_QTD: u64 = 16

const BUF_OFF: u64 = 0x4F000
const B_SETUP: u64 = 0x4F000 // acht Oktett Anforderung
const B_DESC: u64 = 0x4F100 // Deskriptoren, 512
const B_CBW: u64 = 0x4F400
const B_CSW: u64 = 0x4F440 // die Quittung, 13
const B_DATA: u64 = 0x4F800 // ein Datenblock, 512
const B_REPORT: u64 = 0x4FA00 // ein HID-Bericht, 64

// ------------------------------------------------------- die Skalare

const S_BASE: u64 = 0x00 // die Kapazitaetsregister, abgebildet
const S_OP: u64 = 0x08 // die Betriebsregister = BASE + CAPLENGTH
const S_BDF: u64 = 0x10
const S_IDX: u64 = 0x18
const S_READY: u64 = 0x20
const S_PORTS: u64 = 0x28
const S_HCC: u64 = 0x30
const S_CAPLEN: u64 = 0x38
const S_LEGACY: u64 = 0x40
const S_HANDED: u64 = 0x48
const S_NDEV: u64 = 0x50
const S_KEYS: u64 = 0x58
const S_REPORTS: u64 = 0x60
const S_ENUMS: u64 = 0x68
const S_ERRORS: u64 = 0x70
const S_CTRL: u64 = 0x78
const S_POLLS: u64 = 0x80
const S_KBD: u64 = 0x88
const S_MSC: u64 = 0x90
const S_BLOCKS: u64 = 0x98
const S_BSIZE: u64 = 0xA0
const S_TAG: u64 = 0xA8
const S_IOS: u64 = 0xB0
const S_MSCERR: u64 = 0xB8
const S_LASTMOD: u64 = 0xC0 // die zuletzt gemeldeten Umschalttasten
const S_ADDR: u64 = 0xC8
const S_SPEED: u64 = 0xD0 // Bitmaske: Anschluss n abgegeben
const S_WHY: u64 = 0xD8
const WHY_NODEV: u64 = 1
const WHY_NOBAR: u64 = 2
const WHY_NOMAP: u64 = 3
const WHY_RESET: u64 = 4
const WHY_RUN: u64 = 5
const S_STS: u64 = 0xE0
const S_CMD: u64 = 0xE8
const S_RING: u64 = 0x100 // 16 Woerter
const RING_N: u64 = 16
const S_RINGN: u64 = 0xF0

const DEV_BYTES: u64 = 128
const MAX_DEV: u64 = 4

const D_PORT: u64 = 0x00
const D_ADDR: u64 = 0x08
const D_MPS: u64 = 0x10
const D_CLASS: u64 = 0x18
const D_EPIN: u64 = 0x20 // Endpunktnummer der IN-Richtung
const D_EPOUT: u64 = 0x28
const D_EPINT: u64 = 0x30 // der Unterbrechungsendpunkt (HID)
const D_TOGIN: u64 = 0x38 // die Umschaltbits, je Richtung eines

const D_VEN: u64 = 0x40
const D_PROD: u64 = 0x48
const D_TOGOUT: u64 = 0x50
const D_MPSIN: u64 = 0x58
const D_MPSOUT: u64 = 0x60

const C_NONE: u64 = 0
const C_KBD: u64 = 1
const C_MOUSE: u64 = 2
const C_MSC: u64 = 3

// ------------------------------------------------- die Register
//
// Kapazitaetsregister, ab BAR0.
const C_CAPLENGTH: u64 = 0x00
const C_HCSPARAMS: u64 = 0x04
const C_HCCPARAMS: u64 = 0x08

// Betriebsregister, ab BAR0 + CAPLENGTH.
const O_USBCMD: u64 = 0x00
const O_USBSTS: u64 = 0x04
const O_USBINTR: u64 = 0x08
const O_FRINDEX: u64 = 0x0C
const O_CTRLDS: u64 = 0x10
const O_PERIODIC: u64 = 0x14
const O_ASYNC: u64 = 0x18
const O_CONFIGFLAG: u64 = 0x40
const O_PORTSC: u64 = 0x44

const CMD_RS: u64 = 0x0001
const CMD_HCRESET: u64 = 0x0002
const CMD_PSE: u64 = 0x0010
const CMD_ASE: u64 = 0x0020
const CMD_IAAD: u64 = 0x0040

const STS_HALTED: u64 = 0x1000
const STS_PSS: u64 = 0x4000
const STS_ASS: u64 = 0x8000

const PSC_CCS: u64 = 0x0001
const PSC_CSC: u64 = 0x0002
const PSC_PED: u64 = 0x0004
const PSC_PEDC: u64 = 0x0008
const PSC_OCC: u64 = 0x0020
const PSC_RESET: u64 = 0x0100
const PSC_PP: u64 = 0x1000
const PSC_OWNER: u64 = 0x2000
const PSC_W1C: u64 = PSC_CSC | PSC_PEDC | PSC_OCC

// qTD-Merkmale.
const T_ACTIVE: u64 = 0x80
const T_HALTED: u64 = 0x40
const T_DBERR: u64 = 0x20
const T_BABBLE: u64 = 0x10
const T_XACT: u64 = 0x08
const T_ERRMASK: u64 = T_HALTED | T_DBERR | T_BABBLE | T_XACT

const PID_OUT: u64 = 0
const PID_IN: u64 = 1
const PID_SETUP: u64 = 2

const LINK_T: u64 = 1
const LINK_QH: u64 = 2

const SPIN: u64 = 4000000
const RESET_SPIN: u64 = 800000

// ------------------------------------------------------- Grundgriffe

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state + SCAL_OFF, off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state + SCAL_OFF, off, v)
}

fn rd32(b: u64, off: u64) -> u64 {
    return __mmio_read32((b + off) as *mut u32) as u64
}

fn wr32(b: u64, off: u64, v: u64) {
    __mmio_write32((b + off) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn m32(at: u64) -> u64 {
    return __mmio_read32(at as *mut u32) as u64
}

fn w32(at: u64, v: u64) {
    __mmio_write32(at as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn base_of(state: u64) -> u64 {
    return g(state, S_BASE)
}

fn op(state: u64) -> u64 {
    return g(state, S_OP)
}

fn bdf(state: u64) -> u64 {
    return g(state, S_BDF)
}

fn ready(state: u64) -> bool {
    return g(state, S_READY) != 0
}

fn ports(state: u64) -> u64 {
    return g(state, S_PORTS)
}

fn hcc(state: u64) -> u64 {
    return g(state, S_HCC)
}

fn caplen(state: u64) -> u64 {
    return g(state, S_CAPLEN)
}

fn legacy_cap(state: u64) -> u64 {
    return g(state, S_LEGACY)
}

fn handed_off(state: u64) -> bool {
    return g(state, S_HANDED) != 0
}

fn devices(state: u64) -> u64 {
    return g(state, S_NDEV)
}

fn keys(state: u64) -> u64 {
    return g(state, S_KEYS)
}

fn reports(state: u64) -> u64 {
    return g(state, S_REPORTS)
}

fn enums(state: u64) -> u64 {
    return g(state, S_ENUMS)
}

fn errors(state: u64) -> u64 {
    return g(state, S_ERRORS)
}

fn ctrl_xfers(state: u64) -> u64 {
    return g(state, S_CTRL)
}

fn polls(state: u64) -> u64 {
    return g(state, S_POLLS)
}

fn have_kbd(state: u64) -> bool {
    return g(state, S_KBD) != 0
}

fn msc_ready(state: u64) -> bool {
    return g(state, S_MSC) != 0
}

fn msc_blocks(state: u64) -> u64 {
    return g(state, S_BLOCKS)
}

fn msc_bsize(state: u64) -> u64 {
    return g(state, S_BSIZE)
}

fn msc_ios(state: u64) -> u64 {
    return g(state, S_IOS)
}

fn msc_errors(state: u64) -> u64 {
    return g(state, S_MSCERR)
}

fn dv(state: u64, i: u64, f: u64) -> u64 {
    return kstate.get(state + DEV_OFF, i * DEV_BYTES + f)
}

fn dvs(state: u64, i: u64, f: u64, v: u64) {
    kstate.set(state + DEV_OFF, i * DEV_BYTES + f, v)
}

fn dev_class(state: u64, i: u64) -> u64 {
    return dv(state, i, D_CLASS)
}

fn dev_addr(state: u64, i: u64) -> u64 {
    return dv(state, i, D_ADDR)
}

fn dev_mps(state: u64, i: u64) -> u64 {
    return dv(state, i, D_MPS)
}

fn dev_vendor(state: u64, i: u64) -> u64 {
    return dv(state, i, D_VEN)
}

fn dev_product(state: u64, i: u64) -> u64 {
    return dv(state, i, D_PROD)
}

fn qh_at(state: u64, i: u64) -> u64 {
    return state + QH_OFF + i * QH_BYTES
}

fn qtd_at(state: u64, i: u64) -> u64 {
    return state + QTD_OFF + i * QTD_BYTES
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        w32(p + i, 0)
        i = i + 4
    }
}

fn portsc(state: u64, n: u64) -> u64 {
    return rd32(op(state), O_PORTSC + n * 4)
}

fn portsc_set(state: u64, n: u64, v: u64) {
    wr32(op(state), O_PORTSC + n * 4, v & (0xFFFFFFFF - PSC_W1C))
}

fn portsc_ack(state: u64, n: u64, bits: u64) {
    let v: u64 = portsc(state, n)
    wr32(op(state), O_PORTSC + n * 4, (v & (0xFFFFFFFF - PSC_W1C)) | bits)
}

fn port_speed(state: u64, n: u64) -> u64 {
    let v: u64 = portsc(state, n)
    if (v & PSC_CCS) == 0 {
        return 0
    }
    if (v & PSC_OWNER) != 0 {
        return 1
    }
    if (v & PSC_PED) != 0 {
        return 2
    }
    return 1
}

fn spin(n: u64) {
    var i: u64 = 0
    while i < n {
        i = i + 1
    }
}

// ================================================== DIE UEBERGABE
fn handoff(state: u64, idx: u64) {
    let eecp: u64 = (g(state, S_HCC) >> 8) & 0xFF
    s(state, S_LEGACY, eecp)
    s(state, S_HANDED, 0)
    if eecp < 0x40 {
        return
    }
    let dev: u64 = pci.get(state, idx, pci.E_BDF)
    let cap: u64 = pci.cfg_read32(dev, eecp)
    if (cap & 0xFF) != 1 {
        return
    }
    if (cap & 0x00010000) == 0 {
        s(state, S_HANDED, 1)
        return
    }
    pci.cfg_write32(dev, eecp, cap | 0x01000000)
    var i: u64 = 0
    while i < 200000 {
        if (pci.cfg_read32(dev, eecp) & 0x00010000) == 0 {
            s(state, S_HANDED, 1)
            return
        }
        i = i + 1
    }
}

// ================================================== INITIALISIERUNG

fn present(state: u64) -> bool {
    return pci.find_class(state, 0x0C, 0x03, 0x20) < pci.MAX_DEV
}

fn init(state: u64) -> bool {
    s(state, S_WHY, 0)
    let idx: u64 = pci.find_class(state, 0x0C, 0x03, 0x20)
    if idx >= pci.MAX_DEV {
        s(state, S_WHY, WHY_NODEV)
        return false
    }
    let phys: u64 = pci.bar(state, idx, 0) & 0xFFFFFFFFFFFFFFF0
    if phys == 0 {
        s(state, S_WHY, WHY_NOBAR)
        return false
    }
    pci.enable_master(pci.get(state, idx, pci.E_BDF))
    let b: u64 = apic.map_device(state, phys)
    if b == 0 {
        s(state, S_WHY, WHY_NOMAP)
        return false
    }
    s(state, S_BASE, b)
    s(state, S_BDF, pci.get(state, idx, pci.E_BDF))
    s(state, S_IDX, idx)
    let cl: u64 = rd32(b, C_CAPLENGTH) & 0xFF
    s(state, S_CAPLEN, cl)
    s(state, S_OP, b + cl)
    let hcs: u64 = rd32(b, C_HCSPARAMS)
    s(state, S_PORTS, hcs & 0xF)
    s(state, S_HCC, rd32(b, C_HCCPARAMS))
    s(state, S_ADDR, 1)
    s(state, S_TAG, 1)

    handoff(state, idx)

    let o: u64 = b + cl
    wr32(o, O_USBCMD, rd32(o, O_USBCMD) & (0xFFFFFFFF - CMD_RS))
    var i: u64 = 0
    while i < RESET_SPIN {
        if (rd32(o, O_USBSTS) & STS_HALTED) != 0 {
            i = RESET_SPIN
        } else {
            i = i + 1
        }
    }
    wr32(o, O_USBCMD, CMD_HCRESET)
    i = 0
    var reset_ok: bool = false
    while i < RESET_SPIN {
        if (rd32(o, O_USBCMD) & CMD_HCRESET) == 0 {
            reset_ok = true
            i = RESET_SPIN
        } else {
            i = i + 1
        }
    }
    if !reset_ok {
        s(state, S_WHY, WHY_RESET)
        return false
    }

    zero(state + PF_OFF, PF_ENTRIES * 4)
    zero(state + QH_OFF, MAX_QH * QH_BYTES)
    zero(state + QTD_OFF, MAX_QTD * QTD_BYTES)
    zero(state + DEV_OFF, MAX_DEV * DEV_BYTES)

    let a: u64 = qh_at(state, QH_ASYNC)
    let w: u64 = qh_at(state, QH_WORK)
    w32(a + 0, w | LINK_QH)
    w32(a + 4, 0x00008000 | (2 << 12)) // H = 1, EPS = hoch
    w32(a + 8, 1 << 30) // Mult = 1
    w32(a + 12, 0)
    w32(a + 16, LINK_T) // naechster qTD: keiner
    w32(a + 20, LINK_T)
    w32(a + 24, 0) // nicht aktiv
    w32(w + 0, a | LINK_QH)
    w32(w + 16, LINK_T)
    w32(w + 20, LINK_T)

    let q: u64 = qh_at(state, QH_INT)
    w32(q + 0, LINK_T)
    w32(q + 16, LINK_T)
    w32(q + 20, LINK_T)
    i = 0
    while i < PF_ENTRIES {
        w32(state + PF_OFF + i * 4, q | LINK_QH)
        i = i + 1
    }

    wr32(o, O_CTRLDS, 0)
    wr32(o, O_USBINTR, 0)
    wr32(o, O_PERIODIC, state + PF_OFF)
    wr32(o, O_ASYNC, a)
    wr32(o, O_FRINDEX, 0)
    wr32(o, O_USBCMD, (8 << 16) | CMD_RS)
    i = 0
    var run_ok: bool = false
    while i < RESET_SPIN {
        if (rd32(o, O_USBSTS) & STS_HALTED) == 0 {
            run_ok = true
            i = RESET_SPIN
        } else {
            i = i + 1
        }
    }
    if !run_ok {
        s(state, S_WHY, WHY_RUN)
        s(state, S_STS, rd32(o, O_USBSTS))
        s(state, S_CMD, rd32(o, O_USBCMD))
        return false
    }
    wr32(o, O_USBCMD, rd32(o, O_USBCMD) | CMD_ASE | CMD_PSE)
    s(state, S_STS, rd32(o, O_USBSTS))
    s(state, S_CMD, rd32(o, O_USBCMD))
    wr32(o, O_CONFIGFLAG, 1)
    s(state, S_READY, 1)
    return true
}

// ================================================== DER UEBERTRAGER
fn qtd(state: u64, i: u64, next: u64, pid: u64, len: u64, toggle: u64,
    buf: u64) {
    let at: u64 = qtd_at(state, i)
    zero(at, QTD_BYTES)
    w32(at + 0, next)
    w32(at + 4, LINK_T)
    w32(at + 8, (toggle << 31) | (len << 16) | (3 << 10) | (pid << 8)
        | T_ACTIVE)
    w32(at + 12, buf)
    w32(at + 16, (buf + 0x1000) & 0xFFFFF000)
}

fn qh_set(state: u64, which: u64, addr: u64, ep: u64, mps: u64,
    head: u64, link: u64) {
    let at: u64 = qh_at(state, which)
    w32(at + 0, link)
    w32(at + 4, (mps << 16) | (head << 15) | (1 << 14) | (2 << 12)
        | (ep << 8) | addr)
    w32(at + 8, 1 << 30)
    w32(at + 12, 0)
    w32(at + 16, LINK_T)
    w32(at + 20, LINK_T)
    w32(at + 24, 0)
    w32(at + 28, 0)
    w32(at + 32, 0)
    w32(at + 36, 0)
    w32(at + 40, 0)
    w32(at + 44, 0)
}

fn async_off(state: u64) {
    let o: u64 = op(state)
    wr32(o, O_USBCMD, rd32(o, O_USBCMD) & (0xFFFFFFFF - CMD_ASE))
    var i: u64 = 0
    while i < RESET_SPIN {
        if (rd32(o, O_USBSTS) & STS_ASS) == 0 {
            i = RESET_SPIN
        } else {
            i = i + 1
        }
    }
}

fn async_on(state: u64) {
    let o: u64 = op(state)
    wr32(o, O_USBCMD, rd32(o, O_USBCMD) | CMD_ASE)
    var i: u64 = 0
    while i < RESET_SPIN {
        if (rd32(o, O_USBSTS) & STS_ASS) != 0 {
            i = RESET_SPIN
        } else {
            i = i + 1
        }
    }
}

fn await_qtd(state: u64, last: u64) -> bool {
    let at: u64 = qtd_at(state, last)
    let qh: u64 = qh_at(state, QH_WORK)
    var i: u64 = 0
    while i < SPIN {
        let tok: u64 = m32(at + 8)
        if (tok & T_ACTIVE) == 0 {
            if (tok & T_ERRMASK) != 0 {
                s(state, S_ERRORS, g(state, S_ERRORS) + 1)
                return false
            }
            return true
        }
        if (m32(qh + 24) & T_HALTED) != 0 {
            s(state, S_ERRORS, g(state, S_ERRORS) + 1)
            return false
        }
        i = i + 1
    }
    s(state, S_ERRORS, g(state, S_ERRORS) + 1)
    return false
}

// ------------------------------------------------ Steuerungsuebertragung
fn control(state: u64, addr: u64, mps: u64, rtype: u64, req: u64,
    value: u64, index: u64, len: u64, buf: u64, dir_in: bool) -> bool {
    let sp: u64 = state + B_SETUP
    kstate.set8(sp + 0, (rtype & 0xFF) as u8)
    kstate.set8(sp + 1, (req & 0xFF) as u8)
    kstate.set8(sp + 2, (value & 0xFF) as u8)
    kstate.set8(sp + 3, ((value >> 8) & 0xFF) as u8)
    kstate.set8(sp + 4, (index & 0xFF) as u8)
    kstate.set8(sp + 5, ((index >> 8) & 0xFF) as u8)
    kstate.set8(sp + 6, (len & 0xFF) as u8)
    kstate.set8(sp + 7, ((len >> 8) & 0xFF) as u8)

    async_off(state)
    var last: u64 = 0
    if len == 0 {
        // SETUP, dann Quittung IN.
        qtd(state, 1, qtd_at(state, 2) , PID_SETUP, 8, 0, sp)
        qtd(state, 2, LINK_T, PID_IN, 0, 1, 0)
        last = 2
    } else {
        var dpid: u64 = PID_OUT
        var spid: u64 = PID_IN
        if dir_in {
            dpid = PID_IN
            spid = PID_OUT
        }
        qtd(state, 1, qtd_at(state, 2), PID_SETUP, 8, 0, sp)
        qtd(state, 2, qtd_at(state, 3), dpid, len, 1, buf)
        qtd(state, 3, LINK_T, spid, 0, 1, 0)
        last = 3
    }
    qh_set(state, QH_WORK, addr, 0, mps, 0,
        qh_at(state, QH_ASYNC) | LINK_QH)
    w32(qh_at(state, QH_WORK) + 16, qtd_at(state, 1))
    async_on(state)
    s(state, S_CTRL, g(state, S_CTRL) + 1)
    return await_qtd(state, last)
}

fn toggle_after(len: u64, mps: u64, t: u64) -> u64 {
    if mps == 0 {
        return t
    }
    var pakete: u64 = (len + mps - 1) / mps
    if pakete == 0 {
        pakete = 1
    }
    return (t + pakete) % 2
}

// ------------------------------------------------------- Bulk
fn bulk(state: u64, addr: u64, ep: u64, mps: u64, len: u64, buf: u64,
    dir_in: bool, toggle: u64) -> u64 {
    var pid: u64 = PID_OUT
    if dir_in {
        pid = PID_IN
    }
    async_off(state)
    qtd(state, 5, LINK_T, pid, len, toggle, buf)
    qh_set(state, QH_WORK, addr, ep, mps, 0,
        qh_at(state, QH_ASYNC) | LINK_QH)
    w32(qh_at(state, QH_WORK) + 16, qtd_at(state, 5))
    async_on(state)
    if !await_qtd(state, 5) {
        return 0xFFFFFFFF
    }
    let rest: u64 = (m32(qtd_at(state, 5) + 8) >> 16) & 0x7FFF
    return len - rest
}

// ------------------------------------------ der Unterbrechungsendpunkt
fn periodic_off(state: u64) {
    let o: u64 = op(state)
    wr32(o, O_USBCMD, rd32(o, O_USBCMD) & (0xFFFFFFFF - CMD_PSE))
    var i: u64 = 0
    while i < RESET_SPIN {
        if (rd32(o, O_USBSTS) & STS_PSS) == 0 {
            i = RESET_SPIN
        } else {
            i = i + 1
        }
    }
}

fn periodic_on(state: u64) {
    let o: u64 = op(state)
    wr32(o, O_USBCMD, rd32(o, O_USBCMD) | CMD_PSE)
    var i: u64 = 0
    while i < RESET_SPIN {
        if (rd32(o, O_USBSTS) & STS_PSS) != 0 {
            i = RESET_SPIN
        } else {
            i = i + 1
        }
    }
}

fn int_arm(state: u64, addr: u64, ep: u64, mps: u64, len: u64,
    toggle: u64) {
    periodic_off(state)
    let at: u64 = qh_at(state, QH_INT)
    w32(at + 0, LINK_T)
    w32(at + 4, (mps << 16) | (1 << 14) | (2 << 12) | (ep << 8) | addr)
    w32(at + 8, (1 << 30) | 0x01) // Mult 1, S-Maske: Mikrorahmen 0
    w32(at + 12, 0)
    qtd(state, 8, LINK_T, PID_IN, len, toggle, state + B_REPORT)
    w32(at + 16, qtd_at(state, 8))
    w32(at + 20, LINK_T)
    w32(at + 24, 0)
    periodic_on(state)
}

// ============================================== DIE AUFZAEHLUNG
fn port_reset(state: u64, n: u64) -> bool {
    var v: u64 = portsc(state, n)
    if (v & PSC_PP) == 0 {
        portsc_set(state, n, v | PSC_PP)
        spin(RESET_SPIN)
        v = portsc(state, n)
    }
    if (v & PSC_CCS) == 0 {
        return false
    }
    portsc_ack(state, n, PSC_CSC)
    portsc_set(state, n, (portsc(state, n) | PSC_RESET)
        & (0xFFFFFFFF - PSC_PED))
    spin(RESET_SPIN * 2)
    portsc_set(state, n, portsc(state, n) & (0xFFFFFFFF - PSC_RESET))
    var i: u64 = 0
    while i < RESET_SPIN * 4 {
        if (portsc(state, n) & PSC_RESET) == 0 {
            i = RESET_SPIN * 4
        } else {
            i = i + 1
        }
    }
    spin(RESET_SPIN)
    v = portsc(state, n)
    if (v & PSC_PED) != 0 {
        return true
    }
    portsc_set(state, n, portsc(state, n) | PSC_OWNER)
    s(state, S_SPEED, g(state, S_SPEED) | (1 << n))
    return false
}

fn d8(p: u64, i: u64) -> u64 {
    return kstate.get8(p + i)
}

fn d16(p: u64, i: u64) -> u64 {
    return d8(p, i) | (d8(p, i + 1) << 8)
}

fn enumerate(state: u64, n: u64) -> bool {
    if !port_reset(state, n) {
        return false
    }
    let slot: u64 = g(state, S_NDEV)
    if slot >= MAX_DEV {
        return false
    }
    let dp: u64 = state + B_DESC
    if !control(state, 0, 64, 0x80, 6, 0x0100, 0, 8, dp, true) {
        return false
    }
    var mps: u64 = d8(dp, 7)
    if mps == 0 {
        mps = 64
    }
    let addr: u64 = g(state, S_ADDR)
    if !control(state, 0, mps, 0x00, 5, addr, 0, 0, 0, false) {
        return false
    }
    s(state, S_ADDR, addr + 1)
    spin(RESET_SPIN)
    if !control(state, addr, mps, 0x80, 6, 0x0100, 0, 18, dp, true) {
        return false
    }
    dvs(state, slot, D_PORT, n)
    dvs(state, slot, D_ADDR, addr)
    dvs(state, slot, D_MPS, mps)
    dvs(state, slot, D_VEN, d16(dp, 8))
    dvs(state, slot, D_PROD, d16(dp, 10))
    dvs(state, slot, D_CLASS, C_NONE)
    dvs(state, slot, D_TOGIN, 0)
    dvs(state, slot, D_TOGOUT, 0)

    if !control(state, addr, mps, 0x80, 6, 0x0200, 0, 9, dp, true) {
        return false
    }
    var total: u64 = d16(dp, 2)
    if total > 500 {
        total = 500
    }
    if !control(state, addr, mps, 0x80, 6, 0x0200, 0, total, dp, true) {
        return false
    }
    let cfgval: u64 = d8(dp, 5)

    var i: u64 = 0
    var iclass: u64 = 0
    var isub: u64 = 0
    var iproto: u64 = 0
    var iface: u64 = 0
    var epin: u64 = 0
    var epout: u64 = 0
    var epint: u64 = 0
    var mpsin: u64 = 64
    var mpsout: u64 = 64
    while i + 2 <= total {
        let blen: u64 = d8(dp, i)
        if blen < 2 {
            i = total
        } else {
            let btype: u64 = d8(dp, i + 1)
            if btype == 4 {
                iface = d8(dp, i + 2)
                iclass = d8(dp, i + 5)
                isub = d8(dp, i + 6)
                iproto = d8(dp, i + 7)
            } else if btype == 5 {
                let ea: u64 = d8(dp, i + 2)
                let attr: u64 = d8(dp, i + 3) & 0x03
                if attr == 3 {
                    if (ea & 0x80) != 0 {
                        epint = ea & 0x0F
                    }
                } else if attr == 2 {
                    if (ea & 0x80) != 0 {
                        epin = ea & 0x0F
                        mpsin = d16(dp, i + 4)
                    } else {
                        epout = ea & 0x0F
                        mpsout = d16(dp, i + 4)
                    }
                }
            }
            i = i + blen
        }
    }

    if !control(state, addr, mps, 0x00, 9, cfgval, 0, 0, 0, false) {
        return false
    }
    dvs(state, slot, D_EPIN, epin)
    dvs(state, slot, D_EPOUT, epout)
    dvs(state, slot, D_EPINT, epint)
    dvs(state, slot, D_MPSIN, mpsin)
    dvs(state, slot, D_MPSOUT, mpsout)
    s(state, S_NDEV, slot + 1)
    s(state, S_ENUMS, g(state, S_ENUMS) + 1)

    if iclass == 3 && isub == 1 && epint != 0 {
        control(state, addr, mps, 0x21, 0x0B, 0, iface, 0, 0, false)
        control(state, addr, mps, 0x21, 0x0A, 0, iface, 0, 0, false)
        if iproto == 1 {
            dvs(state, slot, D_CLASS, C_KBD)
            s(state, S_KBD, slot + 1)
            int_arm(state, addr, epint, 8, 8, 0)
        } else if iproto == 2 {
            dvs(state, slot, D_CLASS, C_MOUSE)
        }
        return true
    }
    if iclass == 8 && iproto == 0x50 && epin != 0 && epout != 0 {
        dvs(state, slot, D_CLASS, C_MSC)
        s(state, S_MSC, slot + 1)
        msc_setup(state, slot)
        return true
    }
    return true
}

// ============================================== DER STICK (BOT/SCSI)
fn cbw(state: u64, len: u64, dir_in: bool, cblen: u64) -> u64 {
    let p: u64 = state + B_CBW
    var i: u64 = 0
    while i < 31 {
        kstate.set8(p + i, 0 as u8)
        i = i + 1
    }
    // "USBC", kleinendig.
    kstate.set8(p + 0, 0x55 as u8)
    kstate.set8(p + 1, 0x53 as u8)
    kstate.set8(p + 2, 0x42 as u8)
    kstate.set8(p + 3, 0x43 as u8)
    let tag: u64 = g(state, S_TAG)
    s(state, S_TAG, tag + 1)
    kstate.set8(p + 4, (tag & 0xFF) as u8)
    kstate.set8(p + 5, ((tag >> 8) & 0xFF) as u8)
    kstate.set8(p + 8, (len & 0xFF) as u8)
    kstate.set8(p + 9, ((len >> 8) & 0xFF) as u8)
    kstate.set8(p + 10, ((len >> 16) & 0xFF) as u8)
    if dir_in {
        kstate.set8(p + 12, 0x80 as u8)
    }
    kstate.set8(p + 14, (cblen & 0x1F) as u8)
    return tag
}

fn cb(state: u64, i: u64, v: u64) {
    kstate.set8(state + B_CBW + 15 + i, (v & 0xFF) as u8)
}

fn scsi(state: u64, slot: u64, len: u64, dir_in: bool, cblen: u64,
    buf: u64) -> u64 {
    let addr: u64 = dv(state, slot, D_ADDR)
    let epin: u64 = dv(state, slot, D_EPIN)
    let epout: u64 = dv(state, slot, D_EPOUT)
    let mpsi: u64 = dv(state, slot, D_MPSIN)
    s(state, S_IOS, g(state, S_IOS) + 1)
    var tout: u64 = dv(state, slot, D_TOGOUT)
    var tin: u64 = dv(state, slot, D_TOGIN)
    let mpso: u64 = dv(state, slot, D_MPSOUT)
    if bulk(state, addr, epout, mpso, 31, state + B_CBW, false, tout)
        != 31 {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        return 0xFFFFFFFF
    }
    tout = toggle_after(31, mpso, tout)
    var got: u64 = 0
    if len > 0 {
        if dir_in {
            got = bulk(state, addr, epin, mpsi, len, buf, true, tin)
            tin = toggle_after(len, mpsi, tin)
            if got == 0xFFFFFFFF {
                s(state, S_MSCERR, g(state, S_MSCERR) + 1)
                dvs(state, slot, D_TOGOUT, tout)
                dvs(state, slot, D_TOGIN, tin)
                return 0xFFFFFFFF
            }
        } else {
            got = bulk(state, addr, epout, mpso, len, buf, false, tout)
            tout = toggle_after(len, mpso, tout)
        }
    }
    let csw: u64 = bulk(state, addr, epin, mpsi, 13, state + B_CSW,
        true, tin)
    tin = toggle_after(13, mpsi, tin)
    dvs(state, slot, D_TOGOUT, tout)
    dvs(state, slot, D_TOGIN, tin)
    if csw != 13 {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        return 0xFFFFFFFF
    }
    if kstate.get8(state + B_CSW + 12) != 0 {
        s(state, S_MSCERR, g(state, S_MSCERR) + 1)
        return 0xFFFFFFFF
    }
    return got
}

fn msc_setup(state: u64, slot: u64) {
    var t: u64 = 0
    while t < 2 {
        cbw(state, 0, true, 6)
        cb(state, 0, 0x00)
        scsi(state, slot, 0, true, 6, 0)
        t = t + 1
    }
    cbw(state, 8, true, 10)
    cb(state, 0, 0x25)
    let dp: u64 = state + B_DATA
    if scsi(state, slot, 8, true, 10, dp) != 8 {
        return
    }
    let last: u64 = (d8(dp, 0) << 24) | (d8(dp, 1) << 16)
        | (d8(dp, 2) << 8) | d8(dp, 3)
    let bs: u64 = (d8(dp, 4) << 24) | (d8(dp, 5) << 16)
        | (d8(dp, 6) << 8) | d8(dp, 7)
    s(state, S_BLOCKS, last + 1)
    s(state, S_BSIZE, bs)
}

fn msc_read(state: u64, lba: u64, dst: u64) -> bool {
    let slot1: u64 = g(state, S_MSC)
    if slot1 == 0 {
        return false
    }
    let slot: u64 = slot1 - 1
    cbw(state, 512, true, 10)
    cb(state, 0, 0x28)
    cb(state, 2, (lba >> 24) & 0xFF)
    cb(state, 3, (lba >> 16) & 0xFF)
    cb(state, 4, (lba >> 8) & 0xFF)
    cb(state, 5, lba & 0xFF)
    cb(state, 7, 0)
    cb(state, 8, 1)
    if scsi(state, slot, 512, true, 10, state + B_DATA) != 512 {
        return false
    }
    var i: u64 = 0
    while i < 512 {
        kstate.set8(dst + i, kstate.get8(state + B_DATA + i) as u8)
        i = i + 1
    }
    return true
}

// ============================================== DIE TASTATUR
fn usage_to_scan(u: u64) -> u64 {
    if u >= 0x04 && u <= 0x1D {
        var t: [u8; 26] = "\x1e\x30\x2e\x20\x12\x21\x22\x23\x17\x24\x25\x26\x32\x31\x18\x19\x10\x13\x1f\x14\x16\x2f\x11\x2d\x15\x2c"
        return kstate.get8((&t[0]) as u64 + (u - 0x04))
    }
    if u >= 0x1E && u <= 0x27 {
        // 1..9,0
        if u == 0x27 {
            return 0x0B
        }
        return 0x02 + (u - 0x1E)
    }
    if u == 0x28 {
        return 0x1C // Eingabe
    }
    if u == 0x29 {
        return 0x01 // Abbruch
    }
    if u == 0x2A {
        return 0x0E // Ruecktaste
    }
    if u == 0x2B {
        return 0x0F // Tabulator
    }
    if u == 0x2C {
        return 0x39 // Leertaste
    }
    if u == 0x2D {
        return 0x0C
    }
    if u == 0x2E {
        return 0x0D
    }
    if u == 0x36 {
        return 0x33 // Komma
    }
    if u == 0x37 {
        return 0x34 // Punkt
    }
    if u == 0x38 {
        return 0x35 // Schraegstrich
    }
    return 0
}

fn kbd_report(state: u64) {
    let p: u64 = state + B_REPORT
    let mods: u64 = kstate.get8(p)
    let last: u64 = g(state, S_LASTMOD)
    if (mods & 0x02) != 0 && (last & 0x02) == 0 {
        kbd.on_code(state, 0x2A)
    }
    if (mods & 0x02) == 0 && (last & 0x02) != 0 {
        kbd.on_code(state, 0xAA)
    }
    if (mods & 0x01) != 0 && (last & 0x01) == 0 {
        kbd.on_code(state, 0x1D)
    }
    if (mods & 0x01) == 0 && (last & 0x01) != 0 {
        kbd.on_code(state, 0x9D)
    }
    s(state, S_LASTMOD, mods)
    var i: u64 = 2
    while i < 8 {
        let u: u64 = kstate.get8(p + i)
        if u != 0 {
            let c: u64 = usage_to_scan(u)
            if c != 0 {
                kbd.on_code(state, c)
                kbd.on_code(state, c | 0x80)
                s(state, S_KEYS, g(state, S_KEYS) + 1)
                let rn: u64 = g(state, S_RINGN)
                s(state, S_RING + (rn % RING_N) * 8, c)
                s(state, S_RINGN, rn + 1)
            }
        }
        i = i + 1
    }
    s(state, S_REPORTS, g(state, S_REPORTS) + 1)
}

fn poll(state: u64) -> bool {
    if g(state, S_READY) == 0 {
        return false
    }
    s(state, S_POLLS, g(state, S_POLLS) + 1)
    let k1: u64 = g(state, S_KBD)
    if k1 == 0 {
        return false
    }
    let at: u64 = qtd_at(state, 8)
    // TOCTOU (docs/SECURITY-TOCTOU-KERNEL-DRIVERS.md F-03): the token is
    // written by the controller. Read it ONCE; the ACTIVE test and the
    // error test must look at the same value.
    let tok: u64 = m32(at + 8)
    if (tok & T_ACTIVE) != 0 {
        return false
    }
    if (tok & T_ERRMASK) != 0 {
        s(state, S_ERRORS, g(state, S_ERRORS) + 1)
    } else {
        kbd_report(state)
    }
    let slot: u64 = k1 - 1
    var t: u64 = dv(state, slot, D_TOGIN)
    t = 1 - t
    dvs(state, slot, D_TOGIN, t)
    int_arm(state, dv(state, slot, D_ADDR), dv(state, slot, D_EPINT),
        8, 8, t)
    return true
}

fn tag_() {
    var s0: [u8; 7] = "ehci: \0"
    serial.puts((&s0[0]) as u64)
}

fn report(state: u64) {
    var s_no: [u8; 25] = "ehci: no EHCI on the bus\0"
    var s_hd: [u8; 6] = "bdf=\0\0"
    var s_cl: [u8; 10] = "  caplen=\0"
    var s_hc: [u8; 7] = "  hcc=\0"
    var s_pt: [u8; 9] = "  ports=\0"
    var s_lg: [u8; 11] = "  legacy=\0\0"
    var s_ho: [u8; 12] = "  handoff=\0\0"
    var s_p: [u8; 7] = "port \0\0"
    var s_st: [u8; 10] = "  portsc=\0"
    var s_sp: [u8; 9] = "  speed=\0"
    var s_dv: [u8; 6] = "dev \0\0"
    var s_ad: [u8; 8] = "  addr=\0"
    var s_ka: [u8; 10] = "  klasse=\0"
    var s_vd: [u8; 4] = "  \0\0"
    var s_su: [u8; 14] = "enum=\0\0\0\0\0\0\0\0\0"
    var s_er: [u8; 12] = "  fehler=\0\0\0"
    var s_ct: [u8; 10] = "  ctrl=\0\0\0"
    var s_ky: [u8; 10] = "  tasten=\0"
    var s_rp: [u8; 12] = "  berichte=\0"
    var s_pl: [u8; 12] = "  abfragen=\0"
    var s_cd: [u8; 6] = "codes\0"
    var s_ms: [u8; 12] = "msc blocks=\0"
    var s_bs: [u8; 10] = "  bsize=\0\0"
    if g(state, S_READY) == 0 {
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return
    }
    tag_()
    serial.puts((&s_hd[0]) as u64)
    serial.hex(g(state, S_BDF))
    serial.puts((&s_cl[0]) as u64)
    serial.dec(g(state, S_CAPLEN))
    serial.puts((&s_hc[0]) as u64)
    serial.hex(g(state, S_HCC))
    serial.puts((&s_pt[0]) as u64)
    serial.dec(g(state, S_PORTS))
    serial.puts((&s_lg[0]) as u64)
    serial.hex(g(state, S_LEGACY))
    serial.puts((&s_ho[0]) as u64)
    serial.dec(g(state, S_HANDED))
    serial.nl()
    var i: u64 = 0
    while i < g(state, S_PORTS) {
        tag_()
        serial.puts((&s_p[0]) as u64)
        serial.dec(i)
        serial.puts((&s_st[0]) as u64)
        serial.hex(portsc(state, i))
        serial.puts((&s_sp[0]) as u64)
        serial.dec(port_speed(state, i))
        serial.nl()
        i = i + 1
    }
    i = 0
    while i < g(state, S_NDEV) {
        tag_()
        serial.puts((&s_dv[0]) as u64)
        serial.dec(i)
        serial.puts((&s_ad[0]) as u64)
        serial.dec(dv(state, i, D_ADDR))
        serial.puts((&s_ka[0]) as u64)
        serial.dec(dv(state, i, D_CLASS))
        serial.puts((&s_vd[0]) as u64)
        pci.hexn(dv(state, i, D_VEN), 4)
        serial.put(58 as u8)
        pci.hexn(dv(state, i, D_PROD), 4)
        serial.nl()
        i = i + 1
    }
    tag_()
    serial.puts((&s_su[0]) as u64)
    serial.dec(g(state, S_ENUMS))
    serial.puts((&s_ct[0]) as u64)
    serial.dec(g(state, S_CTRL))
    serial.puts((&s_er[0]) as u64)
    serial.dec(g(state, S_ERRORS))
    serial.puts((&s_ky[0]) as u64)
    serial.dec(g(state, S_KEYS))
    serial.puts((&s_rp[0]) as u64)
    serial.dec(g(state, S_REPORTS))
    serial.puts((&s_pl[0]) as u64)
    serial.dec(g(state, S_POLLS))
    serial.nl()
    if g(state, S_RINGN) > 0 {
        tag_()
        serial.puts((&s_cd[0]) as u64)
        var r: u64 = 0
        var rn2: u64 = g(state, S_RINGN)
        if rn2 > RING_N {
            rn2 = RING_N
        }
        while r < rn2 {
            serial.put(32 as u8)
            pci.hexn(g(state, S_RING + r * 8), 2)
            r = r + 1
        }
        serial.nl()
    }
    if g(state, S_MSC) != 0 {
        tag_()
        serial.puts((&s_ms[0]) as u64)
        serial.dec(g(state, S_BLOCKS))
        serial.puts((&s_bs[0]) as u64)
        serial.dec(g(state, S_BSIZE))
        serial.nl()
    }
}

fn selftest(state: u64, lba: u64) {
    var s_rd: [u8; 14] = "selftest lba=\0"
    var s_ok: [u8; 7] = "  ok=\0\0"
    var s_sm: [u8; 8] = "  sum=\0\0"
    var s_b0: [u8; 9] = "  first=\0"
    if g(state, S_MSC) == 0 {
        return
    }
    let dst: u64 = state + B_REPORT
    let ok: bool = msc_read(state, lba, dst)
    var sum: u64 = 0
    var i: u64 = 0
    if ok {
        while i < 512 {
            sum = sum + kstate.get8(state + B_DATA + i) * (i + 1)
            i = i + 1
        }
    }
    tag_()
    serial.puts((&s_rd[0]) as u64)
    serial.dec(lba)
    serial.puts((&s_ok[0]) as u64)
    var y: u64 = 0
    if ok {
        y = 1
    }
    serial.dec(y)
    serial.puts((&s_sm[0]) as u64)
    serial.dec(sum)
    serial.puts((&s_b0[0]) as u64)
    serial.dec(kstate.get8(state + B_DATA))
    serial.nl()
}

fn stage(state: u64) {
    var s_off: [u8; 15] = "ehci: skipped\0\0"
    var s_fail: [u8; 26] = "ehci: init failed  warum=\0"
    if !kstate.mode_on(state, kstate.M_EHCI) {
        serial.puts((&s_off[0]) as u64)
        serial.nl()
        return
    }
    if !present(state) {
        var s_nd: [u8; 25] = "ehci: no EHCI on the bus\0"
        serial.puts((&s_nd[0]) as u64)
        serial.nl()
        return
    }
    if !init(state) {
        serial.puts((&s_fail[0]) as u64)
        serial.dec(g(state, S_WHY))
        var s_st: [u8; 7] = "  bar=\0"
        serial.puts((&s_st[0]) as u64)
        serial.hex(g(state, S_BASE))
        serial.nl()
        return
    }
    var n: u64 = 0
    while n < g(state, S_PORTS) {
        enumerate(state, n)
        n = n + 1
    }
    report(state)
}
