
import serial
import lib.kstate
import block.wlock
import klog
import bus.pci
import arch.x86_64.apic
import arch.cpu
import sync.atomic

export {
    resume, kill, init, present, ide_mode, raid_mode, read_block, write_block, read_many,
    write_many, flush, blocks, block_shift, bdf, port, mode,
    ports_seen, cmds, errs, last_tfd, buffer, ident, sig, slots, why,
    dead, alive, scan_us, lock_refused, lock_nested, stop_fails,
    MODE_NONE, MODE_AHCI, MODE_IDE
}

const AHCI_OFF: u64 = 0x7B000
const AHCI_ID_OFF: u64 = 0x7C000 // was IDENTIFY DEVICE liefert
const AHCI_BUFA_OFF: u64 = 0x7D000 // Messpuffer A
const AHCI_BUFB_OFF: u64 = 0x7E000 // Messpuffer B
const AHCI_SC_OFF: u64 = 0x7F000

const CLB_AT: u64 = 0x000
const FB_AT: u64 = 0x400
const CT_AT: u64 = 0x800
const CT_PRDT: u64 = 0x80
const PRDT_MAX: u64 = 8

// Skalare, Versaetze in AHCI_SC_OFF.
const S_ABAR: u64 = 0x00
const S_BDF: u64 = 0x08
const S_IDX: u64 = 0x10
const S_PORT: u64 = 0x18
const S_READY: u64 = 0x20
const S_BLOCKS: u64 = 0x28
const S_LBASZ: u64 = 0x30
const S_MODE: u64 = 0x38
const S_PI: u64 = 0x40
const S_SEEN: u64 = 0x48
const S_SLOTS: u64 = 0x50
const S_ERRS: u64 = 0x58
const S_CMDS: u64 = 0x60
const S_TFD: u64 = 0x68
const S_S64A: u64 = 0x70
const S_SIG: u64 = 0x78
const S_WHY: u64 = 0x80
const S_QUIET: u64 = 0x88
const S_DEAD: u64 = 0x90

// --------------------------------------------------- die HBA-Register

const R_CAP: u64 = 0x00
const R_GHC: u64 = 0x04
const R_IS: u64 = 0x08
const R_PI: u64 = 0x0C
const R_VS: u64 = 0x10
const R_CAP2: u64 = 0x24
const R_BOHC: u64 = 0x28

const GHC_HR: u64 = 1 // HBA reset
const GHC_IE: u64 = 2
const GHC_AE: u64 = 0x80000000 // AHCI enable

const CAP_S64A: u64 = 0x80000000
const CAP2_BOH: u64 = 1 // BIOS/OS handoff vorhanden

const BOHC_BOS: u64 = 1
const BOHC_OOS: u64 = 2
const BOHC_BB: u64 = 0x10

const PORT_BASE: u64 = 0x100
const PORT_SIZE: u64 = 0x80

const P_CLB: u64 = 0x00
const P_CLBU: u64 = 0x04
const P_FB: u64 = 0x08
const P_FBU: u64 = 0x0C
const P_IS: u64 = 0x10
const P_IE: u64 = 0x14
const P_CMD: u64 = 0x18
const P_TFD: u64 = 0x20
const P_SIG: u64 = 0x24
const P_SSTS: u64 = 0x28
const P_SCTL: u64 = 0x2C
const P_SERR: u64 = 0x30
const P_CI: u64 = 0x38

const CMD_ST: u64 = 0x0001 // start
const CMD_SUD: u64 = 0x0002 // spin up device
const CMD_POD: u64 = 0x0004 // power on device
const CMD_FRE: u64 = 0x0010 // FIS receive enable
const CMD_FR: u64 = 0x4000 // FIS receive running
const CMD_CR: u64 = 0x8000 // command list running

const IS_TFES: u64 = 0x40000000 // task file error

const TFD_ERR: u64 = 0x01
const TFD_DRQ: u64 = 0x08
const TFD_BSY: u64 = 0x80

const DET_PRESENT: u64 = 3
const IPM_ACTIVE: u64 = 1

const SIG_ATA: u64 = 0x00000101
const SIG_ATAPI: u64 = 0xEB140101
const SIG_SEMB: u64 = 0xC33C0101
const SIG_PM: u64 = 0x96690101

const ATA_IDENTIFY: u64 = 0xEC
const ATA_READ_DMA_EXT: u64 = 0x25
const ATA_WRITE_DMA_EXT: u64 = 0x35
const ATA_FLUSH_EXT: u64 = 0xEA

const FIS_H2D: u64 = 0x27

const SECTOR: u64 = 512
const PAGE: u64 = 4096

const SPIN_LIMIT: u64 = 1000000
const RESET_LIMIT: u64 = 2000000

//   -accel kvm   ahci: cmds=197  errs=0  dead=0  alive=1
//   -accel tcg   ahci: cmds=3    errs=1  dead=1  alive=0
const CMD_US: u64 = 3000000
const RESET_US: u64 = 6000000
const PROBE_US: u64 = 300000

fn timeout(state: u64, us: u64) -> u64 {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return 0
    }
    return apic.tsc() + (hz / 1000000) * us
}

fn fristab(bis: u64) -> bool {
    if bis == 0 {
        return false
    }
    return apic.tsc() >= bis
}

// r558: has the deadline passed? With a clock ONLY the clock decides --
// a loop count is calibrated against one machine (KVM: ~1.5 us per
// register read, a real chipset: ~0.8 us) and was the reason the Dell
// gave up on its disk after 80 ms. Without a clock (`bis` == 0) the
// loop count of the caller is the only limit.
fn expired(bis: u64, spin: u64, limit: u64) -> bool {
    if bis != 0 {
        return apic.tsc() >= bis
    }
    return spin >= limit
}

fn have_clock(state: u64) -> bool {
    return apic.tsc_hz(state) >= 1000000
}

// Microseconds on the TSC clock (0 when the TSC was never calibrated).
fn usec(state: u64) -> u64 {
    let hz: u64 = apic.tsc_hz(state)
    if hz < 1000000 {
        return 0
    }
    return apic.tsc() / (hz / 1000000)
}
const PROBE_LIMIT: u64 = 100000 // old loop count, kept for the record (see `oldsata`)

// r558: the link scan is TIME based (see `find_disk`). All values in
// microseconds.
const COMRESET_US: u64 = 2000 // PxSCTL.DET = 1 held for >= 1 ms
const EMPTY_US: u64 = 1000000 // DET stays 0 this long after COMRESET: no device
const STUCK_US: u64 = 2000000 // DET = 1 (half negotiated) this long: COMRESET again
const SIGWAIT_US: u64 = 300000 // link up, no signature: COMRESET again
const SIGFINAL_US: u64 = 1000000 // ... and after the last COMRESET: give up (NOSIG)
const READY_US: u64 = 15000000 // BSY/DRQ after link-up (a spinning-up HDD)
const POLL_US: u64 = 100 // pause between two rounds over the ports
const SCTL_RESET: u64 = 0x301 // DET = 1 (COMRESET), IPM = 3 (no partial/slumber), SPD = 0
const SCTL_IDLE: u64 = 0x300 // DET = 0, IPM = 3

// Test hooks (command line words, see `diag/hw.fi`): the same bits are
// read from the K2 scalar page.
//   slowsata  the link of a present disk comes LATE: after every HBA reset
//             or COMRESET the port shows DET 0 for 0.7 s, DET 1 until 1.0 s,
//             then the real link; the signature appears at 1.0 s and BSY
//             stays until 2.5 s (a cold HDD)
//   lostsig   the signature is LOST unless a COMRESET was sent after the
//             HBA reset (the first FIS went by with FRE = 0, as on real
//             silicon)
//   oldsata   the scan behaves like the first version of this driver: no
//             COMRESET, an empty port is abandoned after 0.3 s
const HW_MODE_AT: u64 = 0x1B0
const T_SLOWSATA: u64 = 1048576
const T_OLDSATA: u64 = 2097152
const T_LOSTSIG: u64 = 4194304
const SLOW_T: u64 = 0x600 // 32 x 8: time of the last link restart
const SLOW_C: u64 = 0x700 // 32 x 8: 1 = a COMRESET release was seen
const S_JUNK: u64 = 0x98
const S_SCAN_US: u64 = 0xA0 // how long the last link scan took

const MODE_NONE: u64 = 0
const MODE_AHCI: u64 = 1
const MODE_IDE: u64 = 2

// ------------------------------------------------------ kleine Helfer

fn sc(off: u64) -> u64 {
    return AHCI_SC_OFF + off
}

fn abar(state: u64) -> u64 {
    return kstate.get(state, sc(S_ABAR))
}

fn bdf(state: u64) -> u64 {
    return kstate.get(state, sc(S_BDF))
}

fn port(state: u64) -> u64 {
    return kstate.get(state, sc(S_PORT))
}

fn mode(state: u64) -> u64 {
    return kstate.get(state, sc(S_MODE))
}

fn blocks(state: u64) -> u64 {
    return kstate.get(state, sc(S_BLOCKS))
}

fn block_shift(state: u64) -> u64 {
    return kstate.get(state, sc(S_LBASZ))
}

fn ports_seen(state: u64) -> u64 {
    return kstate.get(state, sc(S_SEEN))
}

fn slots(state: u64) -> u64 {
    return kstate.get(state, sc(S_SLOTS))
}

fn cmds(state: u64) -> u64 {
    return kstate.get(state, sc(S_CMDS))
}

fn errs(state: u64) -> u64 {
    return kstate.get(state, sc(S_ERRS))
}

fn last_tfd(state: u64) -> u64 {
    return kstate.get(state, sc(S_TFD))
}

fn dead(state: u64) -> u64 {
    return kstate.get(state, sc(S_DEAD))
}

fn alive(state: u64) -> bool {
    return ready(state)
}

fn scan_us(state: u64) -> u64 {
    return kstate.get(state, sc(S_SCAN_US))
}

fn why(state: u64) -> u64 {
    return kstate.get(state, sc(S_WHY))
}

fn sig(state: u64) -> u64 {
    return kstate.get(state, sc(S_SIG))
}

fn ready(state: u64) -> bool {
    return kstate.get(state, sc(S_READY)) != 0
}

fn ident(state: u64) -> u64 {
    return state + AHCI_ID_OFF
}

fn buffer(state: u64, which: u64) -> u64 {
    if which == 1 {
        return state + AHCI_BUFB_OFF
    }
    return state + AHCI_BUFA_OFF
}

fn rd32(b: u64, off: u64) -> u64 {
    return __mmio_read32((b + off) as *mut u32) as u64
}

fn wr32(b: u64, off: u64, v: u64) {
    __mmio_write32((b + off) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn pr(state: u64) -> u64 {
    return abar(state) + PORT_BASE + port(state) * PORT_SIZE
}

fn prd(state: u64, p: u64, off: u64) -> u64 {
    let v: u64 = rd32(abar(state) + PORT_BASE + p * PORT_SIZE, off)
    if off == P_SSTS || off == P_SIG || off == P_TFD {
        if hook_on(state) {
            return hook_view(state, p, off, v)
        }
    }
    return v
}

fn pwr(state: u64, p: u64, off: u64, v: u64) {
    wr32(abar(state) + PORT_BASE + p * PORT_SIZE, off, v)
}

// ------------------------------------------------------ test hooks

fn hwmode(state: u64) -> u64 {
    return kstate.get(state, pci.K2_SCALARS + HW_MODE_AT)
}

fn hook_on(state: u64) -> bool {
    if (hwmode(state) & (T_SLOWSATA | T_LOSTSIG)) == 0 {
        return false
    }
    return have_clock(state)
}

// The HBA reset restarts every link.
fn hook_hba_reset(state: u64) {
    if !hook_on(state) {
        return
    }
    var p: u64 = 0
    while p < 32 {
        kstate.set(state, sc(SLOW_T + p * 8), usec(state) + 1)
        kstate.set(state, sc(SLOW_C + p * 8), 0)
        p = p + 1
    }
}

// A COMRESET release restarts the link of that port, and the signature
// of the device arrives (the first FIS after FRE = 1).
fn hook_comreset(state: u64, p: u64) {
    if !hook_on(state) {
        return
    }
    kstate.set(state, sc(SLOW_T + p * 8), usec(state) + 1)
    kstate.set(state, sc(SLOW_C + p * 8), 1)
}

fn hook_view(state: u64, p: u64, off: u64, v: u64) -> u64 {
    let hm: u64 = hwmode(state)
    let real: u64 = rd32(abar(state) + PORT_BASE + p * PORT_SIZE, P_SSTS)
    if (real & 0xF) != DET_PRESENT {
        return v
    }
    if (hm & T_LOSTSIG) != 0 && kstate.get(state, sc(SLOW_C + p * 8)) == 0 {
        if off == P_SIG {
            return 0xFFFFFFFF
        }
        if off == P_TFD {
            return 0x7F
        }
    }
    if (hm & T_SLOWSATA) != 0 {
        let t0: u64 = kstate.get(state, sc(SLOW_T + p * 8))
        if t0 == 0 {
            return v
        }
        let el: u64 = usec(state) - t0
        if off == P_SSTS {
            if el < 700000 {
                return 0
            }
            if el < 1000000 {
                return 1
            }
        }
        if off == P_SIG && el < 1000000 {
            return 0xFFFFFFFF
        }
        if off == P_TFD && el < 2500000 {
            return 0x80
        }
    }
    return v
}

fn m8(p: u64, v: u64) {
    __mmio_write8(p as *mut u8, (v & 0xFF) as u8)
}

fn m32(p: u64, v: u64) {
    __mmio_write32(p as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn r8(p: u64) -> u64 {
    return __mmio_read8(p as *mut u8) as u64
}

fn zero(p: u64, n: u64) {
    var i: u64 = 0
    while i < n / 8 {
        __mmio_write64((p + i * 8) as *mut u64, 0)
        i = i + 1
    }
}

// ----------------------------------------------------- ist ueberhaupt was da

fn present(state: u64) -> bool {
    return pci.find_ahci(state) < pci.MAX_DEV
}

// SATA OPERATION = "RAID ON" (Dell OptiPlex 9020 and many other business
// PCs): an Intel controller reports class 01:04 instead of 01:06:01 but
// speaks AHCI. `present` and `init` take it (pci.find_ahci); this tells the
// caller that it happened, so the log can say so.
fn raid_mode(state: u64) -> bool {
    let i: u64 = pci.find_ahci(state)
    if i >= pci.MAX_DEV {
        return false
    }
    return pci.is_raid_class(state, i)
}

fn ide_mode(state: u64) -> bool {
    if present(state) {
        return false
    }
    return pci.find_class(state, pci.CLASS_STORAGE, pci.SUB_IDE,
        0x100) < pci.MAX_DEV
}

// ------------------------------------------------------------ Inbetriebnahme

static mut q_ahci: [u8; 5] = "ahci\0"

fn lq() -> u64 {
    return (&q_ahci[0]) as u64
}

// WHAT THE BUS SHOWS WHEN NO AHCI DISK TURNS UP (Dell OptiPlex 9020, 04.10.2026:
// "No writable disk found" and nobody could see why). One log line per
// storage controller, so `log -s ahci` on any other machine -- or the log
// view in the task manager -- tells the story: the value is
// vendor(4) device(4) class(2) subclass(2) progif(2) in hex, e.g.
// 80868c04010400 = Intel 8c04, class 01:04:00 = RAID mode.
fn log_storage(state: u64) {
    var l_ctl: [u8; 42] = "storage controller seen (hex v d c s p): \0"
    var l_none: [u8; 44] = "no storage controller at all on the PCI bus\0"
    let n: u64 = pci.count(state)
    var i: u64 = 0
    var seen: u64 = 0
    while i < n {
        if pci.get(state, i, pci.E_CLASS) == pci.CLASS_STORAGE {
            let v: u64 = (pci.get(state, i, pci.E_VENDOR) << 40) | (pci.get(state, i, pci.E_DEVICE) << 24) | (pci.get(state, i, pci.E_CLASS) << 16) | (pci.get(state, i, pci.E_SUBCLASS) << 8) | pci.get(state, i, pci.E_PROGIF)
            klog.sayh(state, klog.L_WARN, lq(), (&l_ctl[0]) as u64, v)
            seen = seen + 1
        }
        i = i + 1
    }
    if seen == 0 {
        klog.say(state, klog.L_WARN, lq(), (&l_none[0]) as u64)
    }
}

// The controller as it stands after the reset (why=8 on a real machine is
// useless without these numbers).
fn log_hba(state: u64, b: u64, pi: u64) {
    var l_hcap: [u8; 9] = "hba CAP \0"
    var l_hghc: [u8; 9] = "hba GHC \0"
    var l_hpi: [u8; 8] = "hba PI \0"
    var l_hvs: [u8; 8] = "hba VS \0"
    klog.sayh(state, klog.L_INFO, lq(), (&l_hcap[0]) as u64, rd32(b, R_CAP))
    klog.sayh(state, klog.L_INFO, lq(), (&l_hghc[0]) as u64, rd32(b, R_GHC))
    klog.sayh(state, klog.L_INFO, lq(), (&l_hpi[0]) as u64, pi)
    klog.sayh(state, klog.L_INFO, lq(), (&l_hvs[0]) as u64, rd32(b, R_VS))
}

// Intel PCH: PCS (PCI config 0x92, bits 5:0 = port enable). A port whose
// enable bit is 0 shows no link whatever is plugged in. Linux sets the
// bits of all implemented ports on every Intel AHCI controller; so do we,
// and only if one is missing (and the log says so).
const PCS_REG: u64 = 0x92
fn intel_ports_enable(state: u64, idx: u64, pi: u64) {
    var l_pcs: [u8; 43] = "PCS enable bits were missing, PCS before: \0"
    if pci.get(state, idx, pci.E_VENDOR) != pci.VENDOR_INTEL {
        return
    }
    let dev_bdf: u64 = bdf(state)
    let pcs: u64 = pci.cfg_read16(dev_bdf, PCS_REG)
    let want: u64 = pi & 0x3F
    if (pcs & want) != want {
        klog.sayh(state, klog.L_INFO, lq(), (&l_pcs[0]) as u64, pcs)
        pci.cfg_write16(dev_bdf, PCS_REG, pcs | want)
    }
}

// The public entry: the real work is `init_inner`; a failure is written to the
// log with its `why` code (1 no controller, 2 BAR5 not memory, 3 cannot map,
// 4 CAP unreadable, 5 BIOS handoff, 6 HBA reset, 7 no ports, 8 no ATA disk on
// any port, 9 port setup, 10 IDENTIFY), so a real machine that says "no disk"
// leaves a reason behind.
fn init(state: u64) -> bool {
    var l_fail: [u8; 23] = "AHCI init failed, why=\0"
    if init_inner(state) {
        return true
    }
    klog.sayn(state, klog.L_WARN, lq(), (&l_fail[0]) as u64, kstate.get(state, sc(S_WHY)))
    // A failed bring-up is NOT "AHCI mode": `blkdev` and `rootsel` treat
    // mode == MODE_AHCI as "the disk is up" and would never try again.
    kstate.set(state, sc(S_MODE), MODE_NONE)
    return false
}

fn init_inner(state: u64) -> bool {
    var l_kein: [u8; 41] = "no AHCI controller; IDE fallback checked\0"
    var l_los: [u8; 27] = "AHCI-Regler gefunden, idx \0"
    kstate.set(state, sc(S_READY), 0)
    kstate.set(state, sc(S_MODE), MODE_NONE)
    kstate.set(state, sc(S_ERRS), 0)
    kstate.set(state, sc(S_CMDS), 0)
    kstate.set(state, sc(S_SEEN), 0)
    kstate.set(state, sc(S_WHY), 0)
    kstate.set(state, sc(S_DEAD), 0)

    if pci.rst_nvme_hidden(state) {
        var l_rst: [u8; 86] = "storage: Intel RST (RAID) mode, NVMe disks may be hidden. BIOS: set SATA mode to AHCI\0"
        klog.say(state, klog.L_WARN, lq(), (&l_rst[0]) as u64)
    }
    let idx: u64 = pci.find_ahci(state)
    if idx >= pci.MAX_DEV {
        if ide_mode(state) {
            kstate.set(state, sc(S_MODE), MODE_IDE)
        }
        klog.say(state, klog.L_INFO, lq(), (&l_kein[0]) as u64)
        log_storage(state)
        kstate.set(state, sc(S_WHY), 1)
        return false
    }

    let phys: u64 = pci.bar(state, idx, 5)
    if phys == 0 || pci.bar_is_io(state, idx, 5) {
        kstate.set(state, sc(S_WHY), 2)
        return false
    }
    let b: u64 = apic.map_device(state, phys)
    if b == 0 {
        kstate.set(state, sc(S_WHY), 3)
        return false
    }
    if pci.is_raid_class(state, idx) {
        var l_raid: [u8; 63] = "AHCI controller in RAID mode (Intel, class 01:04) used as AHCI\0"
        klog.say(state, klog.L_INFO, lq(), (&l_raid[0]) as u64)
    }
    kstate.set(state, sc(S_IDX), idx)
    kstate.set(state, sc(S_ABAR), b)
    kstate.set(state, sc(S_BDF), pci.get(state, idx, pci.E_BDF))
    kstate.set(state, sc(S_MODE), MODE_AHCI)

    let cap: u64 = rd32(b, R_CAP)
    if cap == 0 || cap == 0xFFFFFFFF {
        kstate.set(state, sc(S_WHY), 4)
        return false
    }
    kstate.set(state, sc(S_SLOTS), ((cap >> 8) & 0x1F) + 1)
    kstate.set(state, sc(S_S64A), (cap & CAP_S64A) >> 31)

    pci.enable_master(bdf(state))

    if !handoff(state, b) {
        kstate.set(state, sc(S_WHY), 5)
        return false
    }

    wr32(b, R_GHC, rd32(b, R_GHC) | GHC_AE)

    // CAP and PI are write-once registers the BIOS programmed; some
    // chipsets (Intel) forget them on a HBA reset. Remember them, and put
    // them back if the reset changed them (as libata does).
    let cap_before: u64 = rd32(b, R_CAP)
    let pi_before: u64 = rd32(b, R_PI)
    if !hba_reset(state, b) {
        kstate.set(state, sc(S_WHY), 6)
        return false
    }
    if rd32(b, R_CAP) != cap_before {
        wr32(b, R_CAP, cap_before)
        var l_capb: [u8; 42] = "HBA reset changed CAP, restored; CAP now \0"
        klog.sayh(state, klog.L_INFO, lq(), (&l_capb[0]) as u64, rd32(b, R_CAP))
    }
    if pi_before != 0 && rd32(b, R_PI) != pi_before {
        var l_pib: [u8; 32] = "HBA reset changed PI (before): \0"
        klog.sayh(state, klog.L_INFO, lq(), (&l_pib[0]) as u64, pi_before)
        wr32(b, R_PI, pi_before)
    }

    let pi: u64 = rd32(b, R_PI)
    kstate.set(state, sc(S_PI), pi)
    log_hba(state, b, pi)
    if pi == 0 {
        kstate.set(state, sc(S_WHY), 7)
        return false
    }
    intel_ports_enable(state, idx, pi)

    let p: u64 = find_disk(state, pi)
    if p >= 32 {
        kstate.set(state, sc(S_WHY), 8)
        return false
    }
    kstate.set(state, sc(S_PORT), p)

    if !port_setup(state, p) {
        kstate.set(state, sc(S_WHY), 9)
        return false
    }
    if !identify(state) {
        kstate.set(state, sc(S_WHY), 10)
        return false
    }
    kstate.set(state, sc(S_READY), 1)
    return true
}

fn handoff(state: u64, b: u64) -> bool {
    let cap2: u64 = rd32(b, R_CAP2)
    if (cap2 & CAP2_BOH) == 0 {
        return true
    }
    wr32(b, R_BOHC, rd32(b, R_BOHC) | BOHC_OOS)
    let bis: u64 = timeout(state, RESET_US)
    var spin: u64 = 0
    while !expired(bis, spin, RESET_LIMIT) {
        let v: u64 = rd32(b, R_BOHC)
        if (v & BOHC_BOS) == 0 && (v & BOHC_BB) == 0 {
            return true
        }
        spin = spin + 1
    }
    return false
}

fn hba_reset(state: u64, b: u64) -> bool {
    wr32(b, R_GHC, rd32(b, R_GHC) | GHC_HR)
    let bis: u64 = timeout(state, RESET_US)
    var spin: u64 = 0
    while !expired(bis, spin, RESET_LIMIT) {
        if (rd32(b, R_GHC) & GHC_HR) == 0 {
            wr32(b, R_GHC, rd32(b, R_GHC) | GHC_AE)
            hook_hba_reset(state)
            return true
        }
        spin = spin + 1
    }
    return false
}

// WHAT WENT WRONG ON THE REAL DELL (class 01:04, SATA Operation = RAID On):
// `AHCI init failed, why=8` only 0.49 s after the controller was found,
// although a SATA disk hangs on it. Two things in the old search are
// wrong on real silicon and invisible in QEMU:
//
//   1. THE WAITS COUNTED LOOPS, NOT TIME. An empty-port probe gave up after
//      100000 register reads. Under KVM a read is a VM exit (~1.5 us), so
//      that was ~150 ms; on a real chipset a read is ~0.8 us, so six ports
//      cost 6 x 80 ms = 0.49 s -- exactly what the Dell log shows. A real
//      disk needs from tens of ms (SSD) to a second or more (HDD) after a
//      HBA reset to bring the link up. Now every deadline is TIME (TSC),
//      and the loop counters only exist for a machine without a clock.
//   2. NOBODY EVER RESET THE LINK AFTER FIS RECEIVE WAS ENABLED. PxSIG is
//      filled from the device's first D2H register FIS. After the HBA reset
//      the device sends it at once -- while PxCMD.FRE is still 0 -- and the
//      controller throws it away: PxSIG stays 0xFFFFFFFF and the port looks
//      empty forever. AHCI 1.3.1 section 10.1.2 / 10.3 and every real
//      driver (Linux libata) therefore arm the port FIRST (command list,
//      FIS area, FRE, SUD/POD) and THEN send COMRESET (PxSCTL.DET = 1 for
//      >= 1 ms, then 0). QEMU fills PxSIG at reset, which is why this
//      never failed there. (Both fixes are verified in tools/ahci/run.sh
//      sections 10..12 with the hooks `slowsata` / `lostsig`.)
//
// THE SCAN, ALL PORTS AT THE SAME TIME (a controller with six empty ports
// costs EMPTY_US once, not six times):
//   * arm every implemented port, COMRESET all of them together;
//   * poll every port with a verdict: EMPTY (DET stays 0 for EMPTY_US),
//     ATA (DET=3, IPM=active, signature 0x101, BSY/DRQ clear), OTHER (an
//     ATAPI drive, port multiplier ...: seen, never chosen), BROKEN,
//     NOSIG (link up and idle but no signature even after two more
//     COMRESETs: tried with IDENTIFY as a last resort);
//   * a port whose link is half-negotiated (DET=1) for STUCK_US gets
//     another COMRESET (at most 3);
//   * the lowest ATA port wins: the scan stops as soon as an ATA disk is
//     ready and no LOWER port is still undecided (a higher port cannot
//     change the choice, so a disk on port 0 costs no extra wait);
//   * a spinning-up HDD (BSY) is waited for up to READY_US.
// Everything the scan saw is written to the klog (`ahci: port ...`), so a
// machine that still says "no disk" leaves the register values behind.

const V_PENDING: u64 = 0
const V_EMPTY: u64 = 1
const V_ATA: u64 = 2
const V_OTHER: u64 = 3
const V_BROKEN: u64 = 4
const V_NOSIG: u64 = 5

const F_STATE: u64 = 0
const F_T0: u64 = 8 // time of the last COMRESET release
const F_TLINK: u64 = 16 // time the link was first seen up (0 = not up)
const F_RESETS: u64 = 24 // COMRESETs sent
const PS_BASE: u64 = 0x200 // 32 ports x 32 octets in the scalar page

fn pget(state: u64, p: u64, f: u64) -> u64 {
    return kstate.get(state, sc(PS_BASE + p * 32 + f))
}

fn pset(state: u64, p: u64, f: u64, v: u64) {
    kstate.set(state, sc(PS_BASE + p * 32 + f), v)
}

// Wait `us` microseconds (a MMIO read on every round so the loop cannot
// be optimised away and the bus stays honest).
fn udelay(state: u64, us: u64) {
    let b: u64 = abar(state)
    var junk: u64 = 0
    if have_clock(state) {
        let end: u64 = usec(state) + us
        while usec(state) < end {
            junk = junk + rd32(b, R_VS)
        }
    } else {
        var i: u64 = 0
        while i < us * 4 {
            junk = junk + rd32(b, R_VS)
            i = i + 1
        }
    }
    kstate.set(state, sc(S_JUNK), junk)
}

// COMRESET, first half: PxSCTL.DET = 1 (reset), IPM = 3 (no partial or
// slumber, as libata does), SPD = 0 (no speed limit).
fn comreset_assert(state: u64, p: u64) {
    pwr(state, p, P_SCTL, SCTL_RESET)
    let flush: u64 = prd(state, p, P_SCTL)
    kstate.set(state, sc(S_JUNK), flush)
}

// Second half: DET = 0; the device now has to answer with COMINIT. Old
// errors are cleared (SERR is write-one-to-clear), the clocks restart.
fn comreset_release(state: u64, p: u64, now: u64) {
    pwr(state, p, P_SCTL, SCTL_IDLE)
    pwr(state, p, P_SERR, prd(state, p, P_SERR))
    pset(state, p, F_T0, now + 1)
    pset(state, p, F_TLINK, 0)
    pset(state, p, F_RESETS, pget(state, p, F_RESETS) + 1)
    hook_comreset(state, p)
}

fn comreset_one(state: u64, p: u64, now: u64) {
    comreset_assert(state, p)
    udelay(state, COMRESET_US)
    comreset_release(state, p, now)
}

// The clock for the scan: microseconds from the TSC, or -- on a machine
// whose TSC was never calibrated -- the number of poll rounds (about one
// microsecond each, a pessimistic stand-in that still ends the scan).
fn tnow(state: u64, polls: u64) -> u64 {
    if have_clock(state) {
        return usec(state)
    }
    return polls
}

// One look at one port; changes its verdict when it is decided.
fn scan_port(state: u64, p: u64, now: u64, legacy: bool) {
    if pget(state, p, F_STATE) != V_PENDING {
        return
    }
    let ssts: u64 = prd(state, p, P_SSTS)
    let det: u64 = ssts & 0xF
    let ipm: u64 = (ssts >> 8) & 0xF
    let t0: u64 = pget(state, p, F_T0)
    var age: u64 = 0
    if now > t0 {
        age = now - t0
    }
    let resets: u64 = pget(state, p, F_RESETS)

    if det == DET_PRESENT && ipm == IPM_ACTIVE {
        var tl: u64 = pget(state, p, F_TLINK)
        if tl == 0 {
            tl = now + 1
            pset(state, p, F_TLINK, tl)
            pwr(state, p, P_SERR, prd(state, p, P_SERR))
        }
        var up: u64 = 0
        if now > tl {
            up = now - tl
        }
        let sig: u64 = prd(state, p, P_SIG)
        let tfd: u64 = prd(state, p, P_TFD)
        let busy: bool = (tfd & (TFD_BSY | TFD_DRQ)) != 0
        if sig != 0 && sig != 0xFFFFFFFF {
            if sig == SIG_ATA {
                if !busy {
                    pset(state, p, F_STATE, V_ATA)
                } else if up > READY_US {
                    pset(state, p, F_STATE, V_BROKEN)
                }
            } else {
                pset(state, p, F_STATE, V_OTHER)
            }
            return
        }
        // Link up, but no signature: the first FIS went by before FIS
        // receive was on. Ask again (twice at most), then give the
        // port to the IDENTIFY fall-back.
        if busy {
            if up > READY_US {
                pset(state, p, F_STATE, V_BROKEN)
            }
        } else if up > SIGWAIT_US && resets < 3 && !legacy {
            comreset_one(state, p, now)
        } else if up > SIGFINAL_US {
            pset(state, p, F_STATE, V_NOSIG)
        }
        return
    }

    pset(state, p, F_TLINK, 0)
    if det == 1 || det == 3 {
        // A device is there but the two ends are not talking (or the
        // link sleeps): try again, a few times.
        if age > STUCK_US && !legacy {
            if resets < 3 {
                comreset_one(state, p, now)
            } else {
                pset(state, p, F_STATE, V_BROKEN)
            }
        }
        return
    }
    // DET 0 (nothing seen), 2 (reserved), 4 (offline): no device.
    var cut: u64 = EMPTY_US
    if legacy {
        cut = PROBE_US
    }
    if age > cut {
        pset(state, p, F_STATE, V_EMPTY)
    }
}

// Packed task-file view for the log: F | SSTS(12) | TFD(16) | SCTL(12).
fn pack_port(state: u64, p: u64) -> u64 {
    return (0xF << 40) | ((prd(state, p, P_SSTS) & 0xFFF) << 28)
        | ((prd(state, p, P_TFD) & 0xFFFF) << 12)
        | (prd(state, p, P_SCTL) & 0xFFF)
}

// What the Boss reads at the Dell: `grep ahci /proc/klog`.
fn log_ports(state: u64, pi: u64, all: bool, lv: u64) {
    var l_port: [u8; 16] = "port, verdict: \0"
    var l_regs: [u8; 38] = "  regs F<ssts:3><tfd:4><sctl:3> hex: \0"
    var l_sig: [u8; 21] = "  sig (1 = marker): \0"
    var l_cmd: [u8; 21] = "  cmd (1 = marker): \0"
    var i: u64 = 0
    while i < 32 {
        if ((pi >> i) & 1) != 0 {
            let v: u64 = pget(state, i, F_STATE)
            if all || v == V_ATA || v == V_OTHER || v == V_NOSIG || v == V_BROKEN {
                klog.say2(state, lv, lq(), (&l_port[0]) as u64, i, v)
                klog.sayh(state, lv, lq(), (&l_regs[0]) as u64, pack_port(state, i))
                klog.sayh(state, lv, lq(), (&l_sig[0]) as u64, (1 << 32) | prd(state, i, P_SIG))
                klog.sayh(state, lv, lq(), (&l_cmd[0]) as u64, (1 << 32) | prd(state, i, P_CMD))
            }
        }
        i = i + 1
    }
}

fn find_disk(state: u64, pi: u64) -> u64 {
    var l_scan: [u8; 34] = "link scan done, us / ports left: \0"
    let legacy: bool = (hwmode(state) & T_OLDSATA) != 0
    let cl: u64 = state + AHCI_OFF + CLB_AT
    let fis: u64 = state + AHCI_OFF + FB_AT
    zero(cl, 1024)
    zero(fis, 256)

    // 1. Arm every implemented port so that it CAN receive the signature.
    var i: u64 = 0
    while i < 32 {
        if ((pi >> i) & 1) != 0 {
            pset(state, i, F_STATE, V_PENDING)
            pset(state, i, F_T0, 0)
            pset(state, i, F_TLINK, 0)
            pset(state, i, F_RESETS, 0)
            if !port_arm(state, i, cl, fis) {
                pset(state, i, F_STATE, V_BROKEN)
            }
        }
        i = i + 1
    }

    // 2. COMRESET them all together (one 2 ms wait, not one per port).
    let t_start: u64 = tnow(state, 0)
    if !legacy {
        i = 0
        while i < 32 {
            if ((pi >> i) & 1) != 0 && pget(state, i, F_STATE) == V_PENDING {
                comreset_assert(state, i)
            }
            i = i + 1
        }
        udelay(state, COMRESET_US)
    }
    let t_rel: u64 = tnow(state, 0)
    i = 0
    while i < 32 {
        if ((pi >> i) & 1) != 0 && pget(state, i, F_STATE) == V_PENDING {
            if legacy {
                pset(state, i, F_T0, t_rel + 1)
            } else {
                comreset_release(state, i, t_rel)
            }
        }
        i = i + 1
    }

    // 3. Poll all ports until the answer is clear.
    var total: u64 = READY_US + EMPTY_US
    if legacy {
        total = PROBE_US
    }
    var polls: u64 = 0
    var pending: u64 = 0
    var best: u64 = 32
    var done: bool = false
    while !done {
        let now: u64 = tnow(state, polls)
        pending = 0
        best = 32
        var low_pending: u64 = 32
        i = 0
        while i < 32 {
            if ((pi >> i) & 1) != 0 {
                scan_port(state, i, now, legacy)
                let v: u64 = pget(state, i, F_STATE)
                if v == V_PENDING {
                    pending = pending + 1
                    if low_pending == 32 {
                        low_pending = i
                    }
                }
                if v == V_ATA && best == 32 {
                    best = i
                }
            }
            i = i + 1
        }
        let el: u64 = now - t_start
        if pending == 0 {
            done = true
        } else if best < 32 && low_pending > best {
            done = true
        } else if el >= total {
            done = true
        }
        if !done && have_clock(state) {
            udelay(state, POLL_US)
        }
        polls = polls + 1
    }
    let elapsed: u64 = tnow(state, polls) - t_start
    kstate.set(state, sc(S_SCAN_US), elapsed)

    // 4. Count what was seen and pick the port.
    var seen: u64 = 0
    var nosig: u64 = 32
    i = 0
    while i < 32 {
        if ((pi >> i) & 1) != 0 {
            var v: u64 = pget(state, i, F_STATE)
            // Out of time with the link up and the task file idle: the
            // same as NOSIG.
            if v == V_PENDING && (prd(state, i, P_SSTS) & 0xF) == DET_PRESENT {
                if (prd(state, i, P_TFD) & (TFD_BSY | TFD_DRQ)) == 0 {
                    pset(state, i, F_STATE, V_NOSIG)
                    v = V_NOSIG
                }
            }
            if v == V_ATA || v == V_OTHER || v == V_NOSIG {
                seen = seen + 1
            }
            if v == V_NOSIG && nosig == 32 {
                nosig = i
            }
        }
        i = i + 1
    }
    kstate.set(state, sc(S_SEEN), seen)
    var found: u64 = best
    if found >= 32 && nosig < 32 {
        // No port gave a signature, but one is linked and idle: let
        // IDENTIFY decide (an ATA disk answers it, anything else aborts).
        found = nosig
    }
    if found < 32 {
        kstate.set(state, sc(S_SIG), prd(state, found, P_SIG))
    }
    var lv: u64 = klog.L_INFO
    if found >= 32 {
        lv = klog.L_WARN
    }
    klog.say2(state, lv, lq(), (&l_scan[0]) as u64, elapsed, pending)
    log_ports(state, pi, found >= 32, lv)
    return found
}

fn port_arm(state: u64, p: u64, cl: u64, fis: u64) -> bool {
    if !port_stop(state, p) {
        return false
    }
    pwr(state, p, P_CLB, cl & 0xFFFFFFFF)
    pwr(state, p, P_CLBU, cl >> 32)
    pwr(state, p, P_FB, fis & 0xFFFFFFFF)
    pwr(state, p, P_FBU, fis >> 32)
    pwr(state, p, P_SERR, prd(state, p, P_SERR))
    pwr(state, p, P_IS, prd(state, p, P_IS))
    pwr(state, p, P_IE, 0)
    pwr(state, p, P_CMD, prd(state, p, P_CMD) | CMD_SUD | CMD_POD)
    pwr(state, p, P_CMD, prd(state, p, P_CMD) | CMD_FRE)
    let bis: u64 = timeout(state, RESET_US)
    var spin: u64 = 0
    while !expired(bis, spin, RESET_LIMIT) {
        if (prd(state, p, P_CMD) & CMD_FR) != 0 {
            return true
        }
        spin = spin + 1
    }
    return false
}

fn port_setup(state: u64, p: u64) -> bool {
    let pi: u64 = kstate.get(state, sc(S_PI))
    var quiet: u64 = 0
    var i: u64 = 0
    while i < 32 {
        if i != p && ((pi >> i) & 1) != 0 {
            if port_stop(state, i) {
                quiet = quiet + 1
            }
        }
        i = i + 1
    }
    kstate.set(state, sc(S_QUIET), quiet)

    let cl: u64 = state + AHCI_OFF + CLB_AT
    let fis: u64 = state + AHCI_OFF + FB_AT
    zero(state + AHCI_OFF + CT_AT, 1024)
    if !port_arm(state, p, cl, fis) {
        return false
    }
    pwr(state, p, P_CMD, prd(state, p, P_CMD) | CMD_ST)
    return await_idle(state, p)
}

fn port_stop(state: u64, p: u64) -> bool {
    pwr(state, p, P_CMD, prd(state, p, P_CMD) & (~CMD_ST))
    let bis: u64 = timeout(state, RESET_US)
    var spin: u64 = 0
    var raus: bool = false
    while !raus && !expired(bis, spin, RESET_LIMIT) {
        if (prd(state, p, P_CMD) & CMD_CR) == 0 {
            raus = true
        } else {
            spin = spin + 1
        }
    }
    if !raus {
        return false
    }
    pwr(state, p, P_CMD, prd(state, p, P_CMD) & (~CMD_FRE))
    spin = 0
    while !expired(bis, spin, RESET_LIMIT) {
        if (prd(state, p, P_CMD) & CMD_FR) == 0 {
            return true
        }
        spin = spin + 1
    }
    return false
}

fn await_idle(state: u64, p: u64) -> bool {
    let bis: u64 = timeout(state, CMD_US)
    var spin: u64 = 0
    while !expired(bis, spin, SPIN_LIMIT) {
        let tfd: u64 = prd(state, p, P_TFD)
        if (tfd & (TFD_BSY | TFD_DRQ)) == 0 {
            return true
        }
        spin = spin + 1
    }
    kstate.set(state, sc(S_TFD), prd(state, p, P_TFD))
    return false
}

// -------------------------------------------------------- ein Befehl

fn build_fis(ct: u64, cmd: u64, lba: u64, count: u64) {
    var i: u64 = 0
    while i < 64 {
        m8(ct + i, 0)
        i = i + 1
    }
    m8(ct + 0, FIS_H2D)
    m8(ct + 1, 0x80)
    m8(ct + 2, cmd)
    m8(ct + 3, 0)
    m8(ct + 4, lba)
    m8(ct + 5, lba >> 8)
    m8(ct + 6, lba >> 16)
    m8(ct + 7, 0x40)
    m8(ct + 8, lba >> 24)
    m8(ct + 9, lba >> 32)
    m8(ct + 10, lba >> 40)
    m8(ct + 11, 0)
    m8(ct + 12, count)
    m8(ct + 13, count >> 8)
    m8(ct + 15, 0)
}

fn build_hdr(cl: u64, ct: u64, write: bool, prdtl: u64) {
    var dw0: u64 = 5 | (prdtl << 16)
    if write {
        dw0 = dw0 | 0x40
    }
    m32(cl + 0, dw0)
    m32(cl + 4, 0)
    m32(cl + 8, ct & 0xFFFFFFFF)
    m32(cl + 12, ct >> 32)
    m32(cl + 16, 0)
    m32(cl + 20, 0)
    m32(cl + 24, 0)
    m32(cl + 28, 0)
}

fn build_prdt(ct: u64, addr: u64, len: u64) -> u64 {
    var n: u64 = 0
    var a: u64 = addr
    var rest: u64 = len
    while rest > 0 && n < PRDT_MAX {
        var chunk: u64 = PAGE - (a & (PAGE - 1))
        if chunk > rest {
            chunk = rest
        }
        let e: u64 = ct + CT_PRDT + n * 16
        m32(e + 0, a & 0xFFFFFFFF)
        m32(e + 4, a >> 32)
        m32(e + 8, 0)
        m32(e + 12, chunk - 1)
        a = a + chunk
        rest = rest - chunk
        n = n + 1
    }
    if rest > 0 {
        return 0
    }
    return n
}

fn run(state: u64, cmd: u64, lba: u64, count: u64, addr: u64, len: u64,
    write: bool) -> bool {
    if write && !wlock.allowed(wlock.D_AHCI) {
        return false
    }
    if mode(state) != MODE_AHCI {
        return false
    }
    if kstate.get(state, sc(S_DEAD)) != 0 {
        return false
    }
    let p: u64 = port(state)
    let cl: u64 = state + AHCI_OFF + CLB_AT
    let ct: u64 = state + AHCI_OFF + CT_AT

    if !await_idle(state, p) {
        kstate.add(state, sc(S_ERRS), 1)
        return false
    }

    var prdtl: u64 = 0
    if len > 0 {
        prdtl = build_prdt(ct, addr, len)
        if prdtl == 0 {
            return false
        }
    }
    build_hdr(cl, ct, write, prdtl)
    build_fis(ct, cmd, lba, count)

    pwr(state, p, P_IS, prd(state, p, P_IS))
    pwr(state, p, P_SERR, prd(state, p, P_SERR))

    pwr(state, p, P_CI, 1)
    kstate.add(state, sc(S_CMDS), 1)

    let bis: u64 = timeout(state, CMD_US)
    var spin: u64 = 0
    while !expired(bis, spin, SPIN_LIMIT) {
        if (prd(state, p, P_CI) & 1) == 0 {
            let tfd: u64 = prd(state, p, P_TFD)
            kstate.set(state, sc(S_TFD), tfd)
            if (tfd & TFD_ERR) != 0 {
                kstate.add(state, sc(S_ERRS), 1)
                return false
            }
            return true
        }
        if (prd(state, p, P_IS) & IS_TFES) != 0 {
            kstate.set(state, sc(S_TFD), prd(state, p, P_TFD))
            kstate.add(state, sc(S_ERRS), 1)
            recover(state, p)
            return false
        }
        spin = spin + 1
    }
    kstate.set(state, sc(S_TFD), prd(state, p, P_TFD))
    kstate.add(state, sc(S_ERRS), 1)
    kstate.add(state, sc(S_DEAD), 1)
    kstate.set(state, sc(S_READY), 0)
    recover(state, p)
    return false
}

const DL_BYPASS: u64 = 0
const DL_TAKEN: u64 = 1
const DL_REFUSE: u64 = 2
const DL_SPINS: u64 = 40000000

static mut dl_owner: u64 = 0
static mut dl_refused: u64 = 0
static mut dl_nested: u64 = 0
static mut dl_stopfail: u64 = 0
static mut dl_said: u64 = 0
static mut s_dl_nest: [u8; 36] = "ahci: nested driver entry on cpu \0\0\0"
static mut s_dl_busy: [u8; 36] = "ahci: driver busy, refused on cpu \0\0"
static mut s_dl_stop: [u8; 44] = "ahci: port did not stop, controller reset\0\0\0"

fn lock_refused() -> u64 {
    return dl_refused
}

fn lock_nested() -> u64 {
    return dl_nested
}

fn stop_fails() -> u64 {
    return dl_stopfail
}

fn dl_say(msg: u64, me: u64) {
    if dl_said >= 8 {
        return
    }
    dl_said = dl_said + 1
    serial.puts(msg)
    serial.dec(me)
    serial.nl()
}

fn lock_in(state: u64) -> u64 {
    if kstate.mode_on(state, kstate.M_NOAHCILOCK) {
        return DL_BYPASS
    }
    let me: u64 = cpu.here(state) + 1
    if atomic.load((&dl_owner) as u64) == me {
        atomic.fetch_add((&dl_nested) as u64, 1)
        dl_say((&s_dl_nest[0]) as u64, me - 1)
        return DL_REFUSE
    }
    var spin: u64 = 0
    while spin < DL_SPINS {
        if atomic.cas((&dl_owner) as u64, 0, me) == 0 {
            return DL_TAKEN
        }
        atomic.pause()
        spin = spin + 1
    }
    atomic.fetch_add((&dl_refused) as u64, 1)
    dl_say((&s_dl_busy[0]) as u64, me - 1)
    return DL_REFUSE
}

fn lock_out(t: u64) {
    if t == DL_TAKEN {
        atomic.store((&dl_owner) as u64, 0)
    }
}

fn recover(state: u64, p: u64) {
    pwr(state, p, P_CMD, prd(state, p, P_CMD) & (~CMD_ST))
    let bis: u64 = timeout(state, RESET_US)
    var spin: u64 = 0
    while !expired(bis, spin, RESET_LIMIT) {
        if (prd(state, p, P_CMD) & CMD_CR) == 0 {
            break
        }
        spin = spin + 1
    }
    if (prd(state, p, P_CMD) & CMD_CR) != 0 && !kstate.mode_on(state, kstate.M_NOAHCILOCK) {
        dl_stopfail = dl_stopfail + 1
        dl_say((&s_dl_stop[0]) as u64, p)
        kstate.add(state, sc(S_DEAD), 1)
        kstate.set(state, sc(S_READY), 0)
        kill(state)
        return
    }
    pwr(state, p, P_SERR, prd(state, p, P_SERR))
    pwr(state, p, P_IS, prd(state, p, P_IS))
    pwr(state, p, P_CMD, prd(state, p, P_CMD) | CMD_ST)
}

// ------------------------------------------------------------ IDENTIFY

fn identify(state: u64) -> bool {
    let buf: u64 = state + AHCI_ID_OFF
    zero(buf, 512)
    if !run(state, ATA_IDENTIFY, 0, 0, buf, 512, false) {
        return false
    }
    let w83: u64 = w(buf, 83)
    var n: u64 = 0
    if (w83 & 0x400) != 0 {
        n = w(buf, 100) | (w(buf, 101) << 16) | (w(buf, 102) << 32)
            | (w(buf, 103) << 48)
    }
    if n == 0 {
        n = w(buf, 60) | (w(buf, 61) << 16)
    }
    if n == 0 {
        return false
    }
    var shift: u64 = 9
    let w106: u64 = w(buf, 106)
    if (w106 & 0x4000) != 0 && (w106 & 0x8000) == 0 && (w106 & 0x1000) != 0 {
        let words: u64 = w(buf, 117) | (w(buf, 118) << 16)
        var sz: u64 = words * 2
        var s: u64 = 0
        while sz > 1 {
            sz = sz >> 1
            s = s + 1
        }
        if s >= 9 && s <= 16 {
            shift = s
        }
    }
    kstate.set(state, sc(S_BLOCKS), n)
    kstate.set(state, sc(S_LBASZ), shift)
    return true
}

fn w(buf: u64, i: u64) -> u64 {
    return r8(buf + i * 2) | (r8(buf + i * 2 + 1) << 8)
}

// ------------------------------------------------------- die Uebertragungen

// Genau das, was `blk.fi` verlangt: Block n, 512 Oktette, sonst nichts.
//
// THROUGH OUR OWN BUFFER, NOT THE CALLER'S. The PRDT takes the caller's
// address as a physical one and splits it at page boundaries. That is
// only right where virtual and physical memory coincide and the pages
// are contiguous. The FAT writer's sector buffers are not always such
// memory: installing onto a SATA disk (QEMU q35, 27.09.2026) left
// BOOTX64.EFI and osum.mb on the ESP with the right size and hundreds
// of wrong bytes in scattered sectors -- the machine then rebooted in a
// loop. Buffer A lives in the driver's own area, page aligned, the same
// memory the command list and table already live in; one 512-octet
// copy per sector is nothing next to the command itself.
fn bounce_copy(from: u64, to: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        __mmio_write64((to + i) as *mut u64, __mmio_read64((from + i) as *mut u64))
        i = i + 8
    }
}

fn read_block(state: u64, lba: u64, dst: u64) -> bool {
    let t: u64 = lock_in(state)
    if t == DL_REFUSE {
        return false
    }
    let ok: bool = read_block_locked(state, lba, dst)
    lock_out(t)
    return ok
}

fn read_block_locked(state: u64, lba: u64, dst: u64) -> bool {
    if !ready(state) {
        return false
    }
    let b: u64 = buffer(state, 0)
    if !run(state, ATA_READ_DMA_EXT, lba, 1, b, SECTOR, false) {
        return false
    }
    bounce_copy(b, dst, SECTOR)
    return true
}

fn write_block(state: u64, lba: u64, src: u64) -> bool {
    let t: u64 = lock_in(state)
    if t == DL_REFUSE {
        return false
    }
    let ok: bool = write_block_locked(state, lba, src)
    lock_out(t)
    return ok
}

fn write_block_locked(state: u64, lba: u64, src: u64) -> bool {
    if !ready(state) {
        return false
    }
    let b: u64 = buffer(state, 0)
    bounce_copy(src, b, SECTOR)
    // w-disklag: NO flush per block. FLUSH CACHE EXT on a rotating disk
    // costs a seek/rotation (8-20 ms) and was issued after EVERY 512-byte
    // write (measured: tools/disklag, flushes == writes). Durability is
    // the caller's job at its barriers: the journal commit points
    // (`ofsj.commit`), `sync` and shutdown all call `blk.flush`, which now
    // reaches `flush` below for AHCI as well.
    if !run(state, ATA_WRITE_DMA_EXT, lba, 1, b, SECTOR, true) {
        return false
    }
    if kstate.mode_on(state, kstate.M_AHCISLOW) {
        return flush_locked(state)
    }
    return true
}

fn read_many(state: u64, lba: u64, count: u64, dst: u64) -> bool {
    let t: u64 = lock_in(state)
    if t == DL_REFUSE {
        return false
    }
    let ok: bool = read_many_locked(state, lba, count, dst)
    lock_out(t)
    return ok
}

fn read_many_locked(state: u64, lba: u64, count: u64, dst: u64) -> bool {
    if !ready(state) || count == 0 {
        return false
    }
    if count * SECTOR > PRDT_MAX * PAGE {
        return false
    }
    return run(state, ATA_READ_DMA_EXT, lba, count, dst, count * SECTOR,
        false)
}

fn write_many(state: u64, lba: u64, count: u64, src: u64) -> bool {
    let t: u64 = lock_in(state)
    if t == DL_REFUSE {
        return false
    }
    let ok: bool = write_many_locked(state, lba, count, src)
    lock_out(t)
    return ok
}

fn write_many_locked(state: u64, lba: u64, count: u64, src: u64) -> bool {
    if !ready(state) || count == 0 {
        return false
    }
    if count * SECTOR > PRDT_MAX * PAGE {
        return false
    }
    // w-disklag: no flush here either (see write_block).
    if !run(state, ATA_WRITE_DMA_EXT, lba, count, src, count * SECTOR,
        true) {
        return false
    }
    if kstate.mode_on(state, kstate.M_AHCISLOW) {
        return flush_locked(state)
    }
    return true
}

fn flush(state: u64) -> bool {
    let t: u64 = lock_in(state)
    if t == DL_REFUSE {
        return false
    }
    let ok: bool = flush_locked(state)
    lock_out(t)
    return ok
}

fn flush_locked(state: u64) -> bool {
    if mode(state) != MODE_AHCI {
        return false
    }
    return run(state, ATA_FLUSH_EXT, 0, 0, 0, 0, false)
}

// ===================================================== DD-12: AFTER S3
// `kill`: power-loss simulation (HBA reset: ports, command lists and FIS
// pointers are gone). `resume`: set the HBA up again like the first start.
fn kill(state: u64) {
    let b: u64 = kstate.get(state, sc(S_ABAR))
    if kstate.get(state, sc(S_MODE)) == MODE_AHCI && b != 0 {
        wr32(b, R_GHC, rd32(b, R_GHC) | GHC_HR)
    }
}

fn resume(state: u64) -> bool {
    if kstate.get(state, sc(S_MODE)) != MODE_AHCI {
        return false
    }
    return init(state)
}
