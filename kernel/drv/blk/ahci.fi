import lib.kstate
import drv.blk.ahci.ahci_defs
import drv.blk.ahci.ahci_init
import drv.blk.ahci.ahci_lock
import drv.blk.ahci.ahci_present
import drv.blk.ahci.ahci_recover
import drv.blk.ahci.ahci_state
import drv.blk.ahci.ahci_wait
import drv.blk.ahci.ahci_xfer

export {
    resume, kill, init, present, ide_mode, raid_mode, read_block, write_block, read_many,
    write_many, flush, irq, irq_on, blocks, block_shift, bdf, port, mode,
    ports_seen, cmds, errs, last_tfd, buffer, ident, sig, slots, why,
    dead, alive, scan_us, lock_refused, lock_nested, stop_fails,
    MODE_NONE, MODE_AHCI, MODE_IDE
}

const SIG_ATAPI: u64 = 0xEB140101

const SIG_SEMB: u64 = 0xC33C0101

const SIG_PM: u64 = 0x96690101

const PROBE_LIMIT: u64 = 100000

fn resume(state: u64) -> bool {
    if kstate.get(state, ahci_state.sc(ahci_defs.S_MODE)) != ahci_defs.MODE_AHCI {
        return false
    }
    return ahci_init.init(state)
}

fn kill(state: u64) {
    ahci_recover.kill(state)
}

fn init(state: u64) -> bool {
    return ahci_init.init(state)
}

fn present(state: u64) -> bool {
    return ahci_present.present(state)
}

fn ide_mode(state: u64) -> bool {
    return ahci_present.ide_mode(state)
}

fn raid_mode(state: u64) -> bool {
    return ahci_present.raid_mode(state)
}

fn read_block(state: u64, lba: u64, dst: u64) -> bool {
    return ahci_xfer.read_block(state, lba, dst)
}

fn write_block(state: u64, lba: u64, src: u64) -> bool {
    return ahci_xfer.write_block(state, lba, src)
}

fn read_many(state: u64, lba: u64, count: u64, dst: u64) -> bool {
    return ahci_xfer.read_many(state, lba, count, dst)
}

fn write_many(state: u64, lba: u64, count: u64, src: u64) -> bool {
    return ahci_xfer.write_many(state, lba, count, src)
}

fn flush(state: u64) -> bool {
    return ahci_xfer.flush(state)
}

fn irq(state: u64) {
    ahci_wait.irq(state)
}

fn irq_on(state: u64) -> bool {
    return ahci_wait.irq_on(state)
}

fn blocks(state: u64) -> u64 {
    return ahci_state.blocks(state)
}

fn block_shift(state: u64) -> u64 {
    return ahci_state.block_shift(state)
}

fn bdf(state: u64) -> u64 {
    return ahci_state.bdf(state)
}

fn port(state: u64) -> u64 {
    return ahci_state.port(state)
}

fn mode(state: u64) -> u64 {
    return ahci_state.mode(state)
}

fn ports_seen(state: u64) -> u64 {
    return ahci_state.ports_seen(state)
}

fn cmds(state: u64) -> u64 {
    return ahci_state.cmds(state)
}

fn errs(state: u64) -> u64 {
    return ahci_state.errs(state)
}

fn last_tfd(state: u64) -> u64 {
    return ahci_state.last_tfd(state)
}

fn buffer(state: u64, which: u64) -> u64 {
    return ahci_state.buffer(state, which)
}

fn ident(state: u64) -> u64 {
    return ahci_state.ident(state)
}

fn sig(state: u64) -> u64 {
    return ahci_state.sig(state)
}

fn slots(state: u64) -> u64 {
    return ahci_state.slots(state)
}

fn why(state: u64) -> u64 {
    return ahci_state.why(state)
}

fn dead(state: u64) -> u64 {
    return ahci_state.dead(state)
}

fn alive(state: u64) -> bool {
    return ahci_state.alive(state)
}

fn scan_us(state: u64) -> u64 {
    return ahci_state.scan_us(state)
}

fn lock_refused() -> u64 {
    return ahci_lock.lock_refused()
}

fn lock_nested() -> u64 {
    return ahci_lock.lock_nested()
}

fn stop_fails() -> u64 {
    return ahci_lock.stop_fails()
}

const MODE_NONE: u64 = ahci_init.MODE_NONE

const MODE_AHCI: u64 = ahci_defs.MODE_AHCI

const MODE_IDE: u64 = ahci_init.MODE_IDE
