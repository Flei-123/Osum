import diag.cmdopt
import lib.kstate
import libc.regio
import drv.blk.ahci.ahci_defs
import drv.blk.ahci.ahci_run
import drv.blk.ahci.ahci_state

const ATA_IDENTIFY: u64 = 0xEC
const W76_NCQ: u64 = 0x100
const W75_DEPTH_MASK: u64 = 0x1F

static mut s_no_ncq: [u8; 6] = "noncq\0"

fn identify(state: u64) -> bool {
    let buf: u64 = state + ahci_defs.AHCI_ID_OFF
    regio.zero64(buf, 512)
    if !ahci_run.run(state, ATA_IDENTIFY, 0, 0, buf, 512, false) {
        return false
    }
    let w83: u64 = w(buf, 83)
    var n: u64 = 0
    if (w83 & 0x400) != 0 {
        n = w(buf, 100) | (w(buf, 101) << 16) | (w(buf, 102) << 32)
            | (w(buf, 103) << 48)
    }
    if n == 0 {
        n = w(buf, 60) | (w(buf, 61) << 16)
    }
    if n == 0 {
        return false
    }
    var shift: u64 = 9
    let w106: u64 = w(buf, 106)
    if (w106 & 0x4000) != 0 && (w106 & 0x8000) == 0 && (w106 & 0x1000) != 0 {
        let words: u64 = w(buf, 117) | (w(buf, 118) << 16)
        var sz: u64 = words * 2
        var s: u64 = 0
        while sz > 1 {
            sz = sz >> 1
            s = s + 1
        }
        if s >= 9 && s <= 16 {
            shift = s
        }
    }
    kstate.set(state, ahci_state.sc(ahci_defs.S_NCQ), ncq_depth(state, buf))
    kstate.set(state, ahci_state.sc(ahci_defs.S_BLOCKS), n)
    kstate.set(state, ahci_state.sc(ahci_defs.S_LBASZ), shift)
    return true
}

fn w(buf: u64, i: u64) -> u64 {
    return regio.read8(buf + i * 2) | (regio.read8(buf + i * 2 + 1) << 8)
}

fn ncq_depth(state: u64, buf: u64) -> u64 {
    if cmdopt.has(state, (&s_no_ncq[0]) as u64) {
        return 0
    }
    let cap: u64 = regio.read32_at(ahci_state.abar(state), ahci_defs.R_CAP)
    if (cap & ahci_defs.CAP_SNCQ) == 0 || (w(buf, 76) & W76_NCQ) == 0 {
        return 0
    }
    var depth: u64 = (w(buf, 75) & W75_DEPTH_MASK) + 1
    if depth > ahci_defs.NCQ_SLOTS {
        depth = ahci_defs.NCQ_SLOTS
    }
    if depth > ahci_state.slots(state) {
        depth = ahci_state.slots(state)
    }
    return depth
}
