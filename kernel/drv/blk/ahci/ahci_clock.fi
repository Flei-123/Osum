import arch.x86_64.apic
import diag.devwait

const PAUSE_SPIN_LIMIT: u64 = 2000000

fn timeout(state: u64, us: u64) -> u64 {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return 0
    }
    return apic.tsc() + (hz / 1000000) * us
}

fn pause(state: u64, us: u64) {
    let deadline: u64 = timeout(state, us)
    var spin: u64 = 0
    while !expired(deadline, spin, PAUSE_SPIN_LIMIT) {
        spin = spin + 1
    }
}

fn expired(deadline: u64, spin: u64, limit: u64) -> bool {
    devwait.touch()
    if deadline != 0 {
        return apic.tsc() >= deadline
    }
    return spin >= limit
}

fn have_clock(state: u64) -> bool {
    return apic.tsc_hz(state) >= 1000000
}

fn usec(state: u64) -> u64 {
    let hz: u64 = apic.tsc_hz(state)
    if hz < 1000000 {
        return 0
    }
    return apic.tsc() / (hz / 1000000)
}

fn tnow(state: u64, polls: u64) -> u64 {
    if have_clock(state) {
        return usec(state)
    }
    return polls
}
