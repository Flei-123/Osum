import bus.drvreg
import bus.pci

fn present(state: u64) -> bool {
    return drvreg.find_either(state, drvreg.D_AHCI, drvreg.D_AHCI_RAID) < pci.MAX_DEV
}

fn raid_mode(state: u64) -> bool {
    let i: u64 = drvreg.find_either(state, drvreg.D_AHCI, drvreg.D_AHCI_RAID)
    if i >= pci.MAX_DEV {
        return false
    }
    return pci.is_raid_class(state, i)
}

fn ide_mode(state: u64) -> bool {
    if present(state) {
        return false
    }
    return drvreg.find(state, drvreg.D_IDE, 0) < pci.MAX_DEV
}
