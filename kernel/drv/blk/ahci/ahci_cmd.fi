import drv.blk.ahci.ahci_defs
import drv.blk.ahci.ahci_reg

const CT_PRDT: u64 = 0x80
const FIS_H2D: u64 = 0x27

fn build_fis(ct: u64, cmd: u64, lba: u64, count: u64) {
    var i: u64 = 0
    while i < 64 {
        ahci_reg.m8(ct + i, 0)
        i = i + 1
    }
    ahci_reg.m8(ct + 0, FIS_H2D)
    ahci_reg.m8(ct + 1, 0x80)
    ahci_reg.m8(ct + 2, cmd)
    ahci_reg.m8(ct + 3, 0)
    ahci_reg.m8(ct + 4, lba)
    ahci_reg.m8(ct + 5, lba >> 8)
    ahci_reg.m8(ct + 6, lba >> 16)
    ahci_reg.m8(ct + 7, 0x40)
    ahci_reg.m8(ct + 8, lba >> 24)
    ahci_reg.m8(ct + 9, lba >> 32)
    ahci_reg.m8(ct + 10, lba >> 40)
    ahci_reg.m8(ct + 11, 0)
    ahci_reg.m8(ct + 12, count)
    ahci_reg.m8(ct + 13, count >> 8)
    ahci_reg.m8(ct + 15, 0)
}

fn build_hdr(cl: u64, ct: u64, write: bool, prdtl: u64) {
    var dw0: u64 = 5 | (prdtl << 16)
    if write {
        dw0 = dw0 | 0x40
    }
    ahci_reg.m32(cl + 0, dw0)
    ahci_reg.m32(cl + 4, 0)
    ahci_reg.m32(cl + 8, ct & 0xFFFFFFFF)
    ahci_reg.m32(cl + 12, ct >> 32)
    ahci_reg.m32(cl + 16, 0)
    ahci_reg.m32(cl + 20, 0)
    ahci_reg.m32(cl + 24, 0)
    ahci_reg.m32(cl + 28, 0)
}

fn build_prdt(ct: u64, addr: u64, len: u64) -> u64 {
    var n: u64 = 0
    var a: u64 = addr
    var rest: u64 = len
    while rest > 0 && n < ahci_defs.PRDT_MAX {
        var chunk: u64 = rest
        if chunk > ahci_defs.PRD_MAX_BYTES {
            chunk = ahci_defs.PRD_MAX_BYTES
        }
        let e: u64 = ct + CT_PRDT + n * 16
        ahci_reg.m32(e + 0, a & 0xFFFFFFFF)
        ahci_reg.m32(e + 4, a >> 32)
        ahci_reg.m32(e + 8, 0)
        ahci_reg.m32(e + 12, chunk - 1)
        a = a + chunk
        rest = rest - chunk
        n = n + 1
    }
    if rest > 0 {
        return 0
    }
    return n
}
