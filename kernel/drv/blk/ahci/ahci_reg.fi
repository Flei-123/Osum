import libc.regio
import drv.blk.ahci.ahci_defs
import drv.blk.ahci.ahci_hook
import drv.blk.ahci.ahci_state

fn pr(state: u64) -> u64 {
    return ahci_state.abar(state) + ahci_defs.PORT_BASE + ahci_state.port(state) * ahci_defs.PORT_SIZE
}

fn prd(state: u64, p: u64, off: u64) -> u64 {
    let v: u64 = regio.read32_at(ahci_state.abar(state) + ahci_defs.PORT_BASE + p * ahci_defs.PORT_SIZE, off)
    if off == ahci_defs.P_SSTS || off == ahci_defs.P_SIG || off == ahci_defs.P_TFD {
        if ahci_hook.hook_on(state) {
            return ahci_hook.hook_view(state, p, off, v)
        }
    }
    return v
}

fn pwr(state: u64, p: u64, off: u64, v: u64) {
    regio.write32_at(ahci_state.abar(state) + ahci_defs.PORT_BASE + p * ahci_defs.PORT_SIZE, off, v)
}

fn m8(p: u64, v: u64) {
    __mmio_write8(p as *mut u8, (v & 0xFF) as u8)
}

fn m32(p: u64, v: u64) {
    __mmio_write32(p as *mut u32, (v & 0xFFFFFFFF) as u32)
}
