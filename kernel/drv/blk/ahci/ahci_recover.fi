import lib.kstate
import libc.regio
import drv.blk.ahci.ahci_clock
import drv.blk.ahci.ahci_defs
import drv.blk.ahci.ahci_lock
import drv.blk.ahci.ahci_reg
import drv.blk.ahci.ahci_state

static mut s_dl_stop: [u8; 44] = "ahci: port did not stop, controller reset\0\0\0"

fn recover(state: u64, p: u64) {
    ahci_defs.idle_known = false
    ahci_reg.pwr(state, p, ahci_defs.P_CMD, ahci_reg.prd(state, p, ahci_defs.P_CMD) & (~ahci_defs.CMD_ST))
    let bis: u64 = ahci_clock.timeout(state, ahci_defs.RESET_US)
    var spin: u64 = 0
    while !ahci_clock.expired(bis, spin, ahci_defs.RESET_LIMIT) {
        if (ahci_reg.prd(state, p, ahci_defs.P_CMD) & ahci_defs.CMD_CR) == 0 {
            break
        }
        spin = spin + 1
    }
    if (ahci_reg.prd(state, p, ahci_defs.P_CMD) & ahci_defs.CMD_CR) != 0 && !kstate.mode_on(state, kstate.M_NOAHCILOCK) {
        ahci_defs.dl_stopfail = ahci_defs.dl_stopfail + 1
        ahci_lock.dl_say((&s_dl_stop[0]) as u64, p)
        kstate.add(state, ahci_state.sc(ahci_defs.S_DEAD), 1)
        kstate.set(state, ahci_state.sc(ahci_defs.S_READY), 0)
        kill(state)
        return
    }
    ahci_reg.pwr(state, p, ahci_defs.P_SERR, ahci_reg.prd(state, p, ahci_defs.P_SERR))
    ahci_reg.pwr(state, p, ahci_defs.P_IS, ahci_reg.prd(state, p, ahci_defs.P_IS))
    ahci_reg.pwr(state, p, ahci_defs.P_CMD, ahci_reg.prd(state, p, ahci_defs.P_CMD) | ahci_defs.CMD_ST)
}

fn kill(state: u64) {
    ahci_defs.idle_known = false
    kstate.set(state, ahci_state.sc(ahci_defs.S_IRQ_ON), 0)
    let b: u64 = kstate.get(state, ahci_state.sc(ahci_defs.S_ABAR))
    if kstate.get(state, ahci_state.sc(ahci_defs.S_MODE)) == ahci_defs.MODE_AHCI && b != 0 {
        regio.write32_at(b, ahci_defs.R_GHC, regio.read32_at(b, ahci_defs.R_GHC) | ahci_defs.GHC_HR)
    }
}
