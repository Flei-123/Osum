import lib.kstate
import drv.blk.ahci.ahci_defs

fn sc(off: u64) -> u64 {
    return ahci_defs.AHCI_SC_OFF + off
}

fn abar(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_ABAR))
}

fn bdf(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_BDF))
}

fn port(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_PORT))
}

fn mode(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_MODE))
}

fn blocks(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_BLOCKS))
}

fn block_shift(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_LBASZ))
}

fn ports_seen(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_SEEN))
}

fn slots(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_SLOTS))
}

fn cmds(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_CMDS))
}

fn errs(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_ERRS))
}

fn last_tfd(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_TFD))
}

fn dead(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_DEAD))
}

fn alive(state: u64) -> bool {
    return ready(state)
}

fn scan_us(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_SCAN_US))
}

fn why(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_WHY))
}

fn sig(state: u64) -> u64 {
    return kstate.get(state, sc(ahci_defs.S_SIG))
}

fn ready(state: u64) -> bool {
    return kstate.get(state, sc(ahci_defs.S_READY)) != 0
}

fn ident(state: u64) -> u64 {
    return state + ahci_defs.AHCI_ID_OFF
}

fn buffer(state: u64, which: u64) -> u64 {
    if which == 1 {
        return state + ahci_defs.AHCI_BUFB_OFF
    }
    return state + ahci_defs.AHCI_BUFA_OFF
}

static mut q_ahci: [u8; 5] = "ahci\0"

fn lq() -> u64 {
    return (&q_ahci[0]) as u64
}
