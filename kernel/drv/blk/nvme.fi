
import serial
import lib.kstate
import block.wlock
import klog
import bus.pci
import bus.drvreg
import acpi.aml
import arch.x86_64.apic
import arch.arch
import libc.regio

export {
    resume, kill, init, present, read_block, write_block, write_many, read_many, read_run,
    irq, drain, blocks, block_shift, bdf, irqs, waits,
    arm_polling, buffer, identify_ctrl,
    ns_count, ns_id, ns_blocks, ns_shift, ns_report, read_block_ns,
    ns_verify, flush,
    MAX_NS
}

const S_BASE: u64 = 0x100
const S_BDF: u64 = 0x108
const S_READY: u64 = 0x110
const S_STRIDE: u64 = 0x118
const S_NSZE: u64 = 0x120
const S_LBADS: u64 = 0x128
const S_SQ_TAIL: u64 = 0x130
const S_CQ_HEAD: u64 = 0x138
const S_PHASE: u64 = 0x140
const S_ASQ_TAIL: u64 = 0x148
const S_ACQ_HEAD: u64 = 0x150
const S_APHASE: u64 = 0x158
const S_IRQS: u64 = 0x160
const S_CID: u64 = 0x168
const S_STATUS: u64 = 0x170
const S_DONE: u64 = 0x178
const S_POLL: u64 = 0x180
const S_WAITS: u64 = 0x188
const S_MSIX: u64 = 0x190
const S_IDX: u64 = 0x198
const S_NSN: u64 = 0x1A0
const S_NSLIST: u64 = 0x1A8
const S_WANT_CID: u64 = 0x1B0
const S_GOT: u64 = 0x1B8
const S_TIMEOUTS: u64 = 0x1C0
const NS_TAB: u64 = 0x1200
const MAX_NS: u64 = 8
const N_ID: u64 = 0
const N_BLOCKS: u64 = 8
const N_LBADS: u64 = 16

const ASQ_OFF: u64 = 0x14000
const ACQ_OFF: u64 = 0x15000
const IOSQ_OFF: u64 = 0x16000
const IOCQ_OFF: u64 = 0x17000
const ID_OFF: u64 = 0x18000
const BUF_A: u64 = 0x19000
const BUF_B: u64 = 0x1A000

const QDEPTH: u64 = 64

const R_CAP: u64 = 0x00
const R_VS: u64 = 0x08
const R_INTMS: u64 = 0x0C
const R_INTMC: u64 = 0x10
const R_CC: u64 = 0x14
const R_CSTS: u64 = 0x1C
const R_AQA: u64 = 0x24
const R_ASQ: u64 = 0x28
const R_ACQ: u64 = 0x30
const R_DOORBELL: u64 = 0x1000

const CC_ENABLE: u64 = 1
const CSTS_RDY: u64 = 1
const CSTS_CFS: u64 = 2

const A_CREATE_SQ: u64 = 0x01
const A_CREATE_CQ: u64 = 0x05
const A_IDENTIFY: u64 = 0x06
const A_SET_FEATURES: u64 = 0x09

const IO_FLUSH: u64 = 0x00
const IO_WRITE: u64 = 0x01
const IO_READ: u64 = 0x02

const VEC_NVME: u64 = 44

const PAGE: u64 = 4096
const SECTOR: u64 = 512

const SPIN_LIMIT: u64 = 4000000
const TICK_LIMIT: u64 = 300
const IO_SPIN_LIMIT: u64 = 200000000

fn sc(off: u64) -> u64 {
    return pci.K2_SCALARS + off
}

fn base(state: u64) -> u64 {
    return kstate.get(state, sc(S_BASE))
}

fn bdf(state: u64) -> u64 {
    return kstate.get(state, sc(S_BDF))
}

fn ready(state: u64) -> bool {
    return kstate.get(state, sc(S_READY)) != 0
}

fn blocks(state: u64) -> u64 {
    return kstate.get(state, sc(S_NSZE))
}

fn block_shift(state: u64) -> u64 {
    return kstate.get(state, sc(S_LBADS))
}

fn irqs(state: u64) -> u64 {
    return kstate.get(state, sc(S_IRQS))
}

fn waits(state: u64) -> u64 {
    return kstate.get(state, sc(S_WAITS))
}

fn last_status(state: u64) -> u64 {
    return kstate.get(state, sc(S_STATUS))
}

fn poll_mode(state: u64) -> bool {
    return kstate.get(state, sc(S_POLL)) != 0
}

fn buffer(state: u64, which: u64) -> u64 {
    if which == 1 {
        return state + BUF_B
    }
    return state + BUF_A
}

fn sqe(sq: u64, slot: u64, dw: u64, v: u64) {
    __mmio_write32((sq + slot * 64 + dw * 4) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn cqe(cq: u64, slot: u64, dw: u64) -> u64 {
    return __mmio_read32((cq + slot * 16 + dw * 4) as *mut u32) as u64
}

fn doorbell(state: u64, qid: u64, is_cq: u64, value: u64) {
    let stride: u64 = kstate.get(state, sc(S_STRIDE))
    regio.write32_at(base(state), R_DOORBELL + (qid * 2 + is_cq) * stride, value)
}

fn command(sq: u64, slot: u64, opcode: u64, cid: u64, nsid: u64,
    prp1: u64, prp2: u64, cdw10: u64, cdw11: u64, cdw12: u64) {
    var i: u64 = 0
    while i < 16 {
        sqe(sq, slot, i, 0)
        i = i + 1
    }
    sqe(sq, slot, 0, (opcode & 0xFF) | ((cid & 0xFFFF) << 16))
    sqe(sq, slot, 1, nsid)
    sqe(sq, slot, 6, prp1 & 0xFFFFFFFF)
    sqe(sq, slot, 7, prp1 >> 32)
    sqe(sq, slot, 8, prp2 & 0xFFFFFFFF)
    sqe(sq, slot, 9, prp2 >> 32)
    sqe(sq, slot, 10, cdw10)
    sqe(sq, slot, 11, cdw11)
    sqe(sq, slot, 12, cdw12)
}

fn prp2_of(addr: u64, len: u64) -> u64 {
    let off: u64 = addr & (PAGE - 1)
    if off + len <= PAGE {
        return 0
    }
    return (addr - off) + PAGE
}

fn admin(state: u64, opcode: u64, nsid: u64, prp1: u64,
    cdw10: u64, cdw11: u64) -> u64 {
    let sq: u64 = state + ASQ_OFF
    let cq: u64 = state + ACQ_OFF
    var tail: u64 = kstate.get(state, sc(S_ASQ_TAIL))
    let cid: u64 = next_cid(state)
    command(sq, tail, opcode, cid, nsid, prp1, 0, cdw10, cdw11, 0)
    tail = tail + 1
    if tail >= QDEPTH {
        tail = 0
    }
    kstate.set(state, sc(S_ASQ_TAIL), tail)
    doorbell(state, 0, 0, tail)

    var head: u64 = kstate.get(state, sc(S_ACQ_HEAD))
    let phase: u64 = kstate.get(state, sc(S_APHASE))
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        let d3: u64 = cqe(cq, head, 3)
        if ((d3 >> 16) & 1) == phase {
            let status: u64 = (d3 >> 17) & 0x7FF
            head = head + 1
            if head >= QDEPTH {
                head = 0
                kstate.set(state, sc(S_APHASE), 1 - phase)
            }
            kstate.set(state, sc(S_ACQ_HEAD), head)
            doorbell(state, 0, 1, head)
            kstate.set(state, sc(S_STATUS), status)
            return status
        }
        spin = spin + 1
    }
    kstate.set(state, sc(S_STATUS), 0xFFFF)
    return 0xFFFF
}

fn next_cid(state: u64) -> u64 {
    let c: u64 = (kstate.get(state, sc(S_CID)) + 1) & 0xFFFF
    kstate.set(state, sc(S_CID), c)
    return c
}

fn present(state: u64) -> bool {
    return drvreg.find(state, drvreg.D_NVME, 0) < pci.MAX_DEV
}

static mut q_nvme: [u8; 5] = "nvme\0"

fn lq() -> u64 {
    return (&q_nvme[0]) as u64
}

fn init(state: u64, use_msix: bool, armed: bool) -> bool {
    var l_kein: [u8; 33] = "no NVMe controller on this bus\0\0\0"
    var l_bar: [u8; 30] = "BAR0 unbrauchbar, phys \0\0\0\0\0\0\0"
    var l_los: [u8; 25] = "Regler gefunden, BAR0 \0\0\0"
    kstate.set(state, sc(S_READY), 0)
    let idx: u64 = drvreg.find(state, drvreg.D_NVME, 0)
    if idx >= pci.MAX_DEV {
        klog.say(state, klog.L_INFO, lq(), (&l_kein[0]) as u64)
        return false
    }
    let phys: u64 = pci.bar(state, idx, 0)
    if phys == 0 || pci.bar_is_io(state, idx, 0) {
        klog.sayh(state, klog.L_ERROR, lq(), (&l_bar[0]) as u64, phys)
        return false
    }
    klog.sayh(state, klog.L_INFO, lq(), (&l_los[0]) as u64, phys)
    let b: u64 = apic.map_device(state, phys)
    if b == 0 {
        return false
    }
    kstate.set(state, sc(S_IDX), idx)
    kstate.set(state, sc(S_BASE), b)
    kstate.set(state, sc(S_BDF), pci.get(state, idx, pci.E_BDF))

    let cap: u64 = regio.read64_at(b, R_CAP)
    if cap == 0 || cap == 0xFFFFFFFFFFFFFFFF {
        return false
    }
    let dstrd: u64 = (cap >> 32) & 0xF
    kstate.set(state, sc(S_STRIDE), 4 << dstrd)
    let mqes: u64 = (cap & 0xFFFF) + 1
    if mqes < QDEPTH {
        return false
    }

    pci.enable_master(bdf(state))

    if use_msix {
        if !msix_arm(state, idx, VEC_NVME, armed) {
            return false
        }
        kstate.set(state, sc(S_MSIX), 1)
    } else {
        intx_arm(state, idx, VEC_NVME, armed)
        kstate.set(state, sc(S_MSIX), 0)
    }

    regio.write32_at(b, R_CC, 0)
    if !await_rdy(b, 0) {
        return false
    }

    kstate.set(state, sc(S_ASQ_TAIL), 0)
    kstate.set(state, sc(S_ACQ_HEAD), 0)
    kstate.set(state, sc(S_APHASE), 1)
    kstate.set(state, sc(S_SQ_TAIL), 0)
    kstate.set(state, sc(S_CQ_HEAD), 0)
    kstate.set(state, sc(S_PHASE), 1)
    kstate.set(state, sc(S_IRQS), 0)
    kstate.set(state, sc(S_DONE), 0)
    kstate.set(state, sc(S_GOT), 0)
    kstate.set(state, sc(S_WANT_CID), 0xFFFFFFFF)
    kstate.set(state, sc(S_TIMEOUTS), 0)
    kstate.set(state, sc(S_WAITS), 0)
    kstate.set(state, sc(S_CID), 0)
    regio.zero64(state + ASQ_OFF, PAGE)
    regio.zero64(state + ACQ_OFF, PAGE)
    regio.zero64(state + IOSQ_OFF, PAGE)
    regio.zero64(state + IOCQ_OFF, PAGE)

    regio.write32_at(b, R_AQA, ((QDEPTH - 1) << 16) | (QDEPTH - 1))
    regio.write64_at(b, R_ASQ, state + ASQ_OFF)
    regio.write64_at(b, R_ACQ, state + ACQ_OFF)
    regio.write32_at(b, R_CC, CC_ENABLE | (6 << 16) | (4 << 20))
    if !await_rdy(b, 1) {
        return false
    }

    if !identify(state) {
        return false
    }
    ns_scan(state)
    if admin(state, A_SET_FEATURES, 0, 0, 0x07, 0) > 1 {
    }
    let cq_cdw11: u64 = 1 | (1 << 1) | (0 << 16)
    if admin(state, A_CREATE_CQ, 0, state + IOCQ_OFF,
        ((QDEPTH - 1) << 16) | 1, cq_cdw11) != 0 {
        return false
    }
    if admin(state, A_CREATE_SQ, 0, state + IOSQ_OFF,
        ((QDEPTH - 1) << 16) | 1, 1 | (1 << 16)) != 0 {
        return false
    }

    kstate.set(state, sc(S_READY), 1)
    return true
}

fn await_rdy(b: u64, want: u64) -> bool {
    var spin: u64 = 0
    while spin < SPIN_LIMIT {
        let csts: u64 = regio.read32_at(b, R_CSTS)
        if (csts & CSTS_CFS) != 0 {
            return false
        }
        if (csts & CSTS_RDY) == want {
            return true
        }
        spin = spin + 1
    }
    return false
}

fn identify(state: u64) -> bool {
    regio.zero64(state + ID_OFF, PAGE)
    if admin(state, A_IDENTIFY, 1, state + ID_OFF, 0, 0) != 0 {
        return false
    }
    let nsze: u64 = __mmio_read64((state + ID_OFF) as *mut u64)
    let flbas: u64 = __mmio_read8((state + ID_OFF + 26) as *mut u8) as u64
    let fmt: u64 = flbas & 0xF
    let lbads: u64 = __mmio_read8((state + ID_OFF + 128 + fmt * 4 + 2) as *mut u8) as u64
    if nsze == 0 || lbads < 9 || lbads > 16 {
        return false
    }
    kstate.set(state, sc(S_NSZE), nsze)
    kstate.set(state, sc(S_LBADS), lbads)
    return true
}

fn ns_scan(state: u64) -> u64 {
    kstate.set(state, sc(S_NSN), 0)
    kstate.set(state, sc(S_NSLIST), 0)
    regio.zero64(state + ID_OFF, PAGE)
    if admin(state, A_IDENTIFY, 0, state + ID_OFF, 2, 0) != 0 {
        return 0
    }
    var found: u64 = 0
    var i: u64 = 0
    while i < 1024 {
        let id: u64 = __mmio_read32((state + ID_OFF + i * 4) as *mut u32) as u64
        if id == 0 {
            i = 1024
        } else {
            if found < MAX_NS {
                kstate.set(state, sc(NS_TAB + found * 32 + N_ID), id)
                kstate.set(state, sc(NS_TAB + found * 32 + N_BLOCKS), 0)
                kstate.set(state, sc(NS_TAB + found * 32 + N_LBADS), 0)
            }
            found = found + 1
            i = i + 1
        }
    }
    kstate.set(state, sc(S_NSLIST), found)
    var n: u64 = found
    if n > MAX_NS {
        n = MAX_NS
    }
    var k: u64 = 0
    var ok: u64 = 0
    while k < n {
        let id: u64 = kstate.get(state, sc(NS_TAB + k * 32 + N_ID))
        regio.zero64(state + ID_OFF, PAGE)
        if admin(state, A_IDENTIFY, id, state + ID_OFF, 0, 0) == 0 {
            let nsze: u64 = __mmio_read64((state + ID_OFF) as *mut u64)
            let flbas: u64 = __mmio_read8((state + ID_OFF + 26) as *mut u8) as u64
            let fmt: u64 = flbas & 0xF
            let lbads: u64 = __mmio_read8(
                (state + ID_OFF + 128 + fmt * 4 + 2) as *mut u8) as u64
            if nsze != 0 && lbads >= 9 && lbads <= 16 {
                kstate.set(state, sc(NS_TAB + k * 32 + N_BLOCKS), nsze)
                kstate.set(state, sc(NS_TAB + k * 32 + N_LBADS), lbads)
                ok = ok + 1
            }
        }
        k = k + 1
    }
    kstate.set(state, sc(S_NSN), ok)
    return ok
}

fn ns_count(state: u64) -> u64 {
    return kstate.get(state, sc(S_NSN))
}

fn ns_id(state: u64, i: u64) -> u64 {
    if i >= MAX_NS {
        return 0
    }
    return kstate.get(state, sc(NS_TAB + i * 32 + N_ID))
}

fn ns_blocks(state: u64, i: u64) -> u64 {
    if i >= MAX_NS {
        return 0
    }
    return kstate.get(state, sc(NS_TAB + i * 32 + N_BLOCKS))
}

fn ns_shift(state: u64, i: u64) -> u64 {
    if i >= MAX_NS {
        return 0
    }
    return kstate.get(state, sc(NS_TAB + i * 32 + N_LBADS))
}

fn read_block_ns(state: u64, i: u64, lba: u64, dst: u64) -> bool {
    let id: u64 = ns_id(state, i)
    if id == 0 {
        return false
    }
    return run_io_ns(state, IO_READ, id, lba, 1, dst, SECTOR)
}

fn ns_report(state: u64) {
    var s_h: [u8; 16] = "nvme: ns count=\0"
    var s_l: [u8; 11] = "  in list=\0"
    var s_n: [u8; 9] = "nvme: ns\0"
    var s_i: [u8; 7] = " nsid=\0"
    var s_b: [u8; 10] = "  blocks=\0"
    var s_z: [u8; 9] = "  lbasz=\0"
    serial.puts((&s_h[0]) as u64)
    serial.dec(kstate.get(state, sc(S_NSN)))
    serial.puts((&s_l[0]) as u64)
    serial.dec(kstate.get(state, sc(S_NSLIST)))
    serial.nl()
    var i: u64 = 0
    while i < kstate.get(state, sc(S_NSN)) {
        serial.puts((&s_n[0]) as u64)
        serial.dec(i)
        serial.puts((&s_i[0]) as u64)
        serial.dec(ns_id(state, i))
        serial.puts((&s_b[0]) as u64)
        serial.dec(ns_blocks(state, i))
        serial.puts((&s_z[0]) as u64)
        serial.dec(1 << ns_shift(state, i))
        serial.nl()
        i = i + 1
    }
}

fn ns_verify(state: u64) {
    var s_v: [u8; 9] = "nvme: ns\0"
    var s_i: [u8; 7] = " nsid=\0"
    var s_o: [u8; 8] = "  lba0=\0"
    var s_s: [u8; 7] = "  sum=\0"
    if kstate.get(state, sc(S_NSN)) < 2 {
        return
    }
    let buf: u64 = state + BUF_A
    var i: u64 = 0
    while i < kstate.get(state, sc(S_NSN)) {
        regio.zero64(buf, SECTOR)
        let ok: bool = read_block_ns(state, i, 0, buf)
        var sum: u64 = 0
        var k: u64 = 0
        if ok {
            while k < SECTOR {
                sum = sum + (__mmio_read8((buf + k) as *mut u8) as u64) * (k + 1)
                k = k + 1
            }
        }
        serial.puts((&s_v[0]) as u64)
        serial.dec(i)
        serial.puts((&s_i[0]) as u64)
        serial.dec(ns_id(state, i))
        serial.puts((&s_o[0]) as u64)
        var y: u64 = 0
        if ok {
            y = 1
        }
        serial.dec(y)
        serial.puts((&s_s[0]) as u64)
        serial.dec(sum)
        serial.nl()
        i = i + 1
    }
}

fn identify_ctrl(state: u64, dst: u64) -> bool {
    if dst == 0 {
        return false
    }
    if !present(state) {
        return false
    }
    regio.zero64(dst, PAGE)
    if admin(state, A_IDENTIFY, 0, dst, 1, 0) != 0 {
        return false
    }
    return true
}

fn msix_arm(state: u64, idx: u64, vector: u64, armed: bool) -> bool {
    let d: u64 = pci.get(state, idx, pci.E_BDF)
    let cap: u64 = pci.get(state, idx, pci.E_MSIX)
    if cap == 0 {
        return false
    }
    let table: u64 = pci.cfg_read32(d, cap + 4)
    let bir: u64 = table & 7
    let toff: u64 = table & 0xFFFFFFF8
    if pci.bar(state, idx, bir) == 0 {
        return false
    }
    let tbase: u64 = apic.map_device(state, pci.bar(state, idx, bir) + toff)
    if tbase == 0 {
        return false
    }
    regio.write32_at(tbase, 0, apic.lapic_phys(state) | ((apic.id(state) & 0xFF) << 12))
    regio.write32_at(tbase, 4, 0)
    regio.write32_at(tbase, 8, vector & 0xFF)
    var ctrl: u64 = 1
    if armed {
        ctrl = 0
    }
    regio.write32_at(tbase, 12, ctrl)
    let msg: u64 = pci.cfg_read16(d, cap + 2)
    pci.cfg_write16(d, cap + 2, (msg | 0x8000) & 0xBFFF)
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) | 0x400)
    return true
}

fn intx_arm(state: u64, idx: u64, vector: u64, armed: bool) {
    let d: u64 = pci.get(state, idx, pci.E_BDF)
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) & 0xFBFF)
    let gsi: u64 = aml.gsi_or_line(state, idx)
    if gsi == 0 || gsi > 23 {
        return
    }
    if armed {
        apic.route(state, gsi, vector, apic.id(state), true, true)
    } else {
        apic.route(state, gsi, vector, apic.id(state), true, true)
        apic.mask_gsi(state, gsi)
    }
}

fn irq(state: u64) {
    kstate.add(state, sc(S_IRQS), 1)
    drain(state)
}

fn drain(state: u64) -> u64 {
    let cq: u64 = state + IOCQ_OFF
    var head: u64 = kstate.get(state, sc(S_CQ_HEAD))
    var phase: u64 = kstate.get(state, sc(S_PHASE))
    var got: u64 = 0
    while got < QDEPTH {
        let d3: u64 = cqe(cq, head, 3)
        if ((d3 >> 16) & 1) != phase {
            break
        }
        if (d3 & 0xFFFF) == kstate.get(state, sc(S_WANT_CID)) {
            kstate.set(state, sc(S_STATUS), (d3 >> 17) & 0x7FF)
            kstate.set(state, sc(S_GOT), 1)
        }
        head = head + 1
        if head >= QDEPTH {
            head = 0
            phase = 1 - phase
        }
        got = got + 1
    }
    if got > 0 {
        kstate.set(state, sc(S_CQ_HEAD), head)
        kstate.set(state, sc(S_PHASE), phase)
        doorbell(state, 1, 1, head)
        kstate.add(state, sc(S_DONE), got)
    }
    return got
}

fn arm_polling(state: u64) {
    kstate.set(state, sc(S_POLL), 1)
}

fn run_io(state: u64, opcode: u64, lba: u64, count: u64, addr: u64, len: u64) -> bool {
    return run_io_ns(state, opcode, 1, lba, count, addr, len)
}

fn run_io_ns(state: u64, opcode: u64, nsid: u64, lba: u64, count: u64,
    addr: u64, len: u64) -> bool {
    if opcode == IO_WRITE && !wlock.allowed(wlock.D_NVME) {
        return false
    }
    if !ready(state) {
        return false
    }
    let sq: u64 = state + IOSQ_OFF
    var tail: u64 = kstate.get(state, sc(S_SQ_TAIL))
    let cid: u64 = next_cid(state)
    kstate.set(state, sc(S_WANT_CID), cid)
    kstate.set(state, sc(S_GOT), 0)
    command(sq, tail, opcode, cid, nsid, addr, prp2_of(addr, len),
        lba & 0xFFFFFFFF, lba >> 32, (count - 1) & 0xFFFF)
    tail = tail + 1
    if tail >= QDEPTH {
        tail = 0
    }
    kstate.set(state, sc(S_SQ_TAIL), tail)
    doorbell(state, 1, 0, tail)
    return await(state)
}

static mut s_timeout: [u8; 22] = "nvme: command timeout\0"

fn timed_out(state: u64) -> bool {
    kstate.add(state, sc(S_TIMEOUTS), 1)
    serial.puts((&s_timeout[0]) as u64)
    serial.nl()
    return false
}

fn await(state: u64) -> bool {
    if poll_mode(state) || !arch.irq_are_on() {
        var spin: u64 = 0
        while spin < IO_SPIN_LIMIT {
            drain(state)
            if kstate.get(state, sc(S_GOT)) != 0 {
                return kstate.get(state, sc(S_STATUS)) == 0
            }
            spin = spin + 1
        }
        return timed_out(state)
    }
    let start: u64 = kstate.get(state, kstate.TICKS)
    while kstate.get(state, sc(S_GOT)) == 0 {
        if kstate.get(state, kstate.TICKS) - start > TICK_LIMIT {
            return timed_out(state)
        }
        kstate.add(state, sc(S_WAITS), 1)
        arch.idle()
    }
    return kstate.get(state, sc(S_STATUS)) == 0
}

fn read_block(state: u64, lba: u64, dst: u64) -> bool {
    return run_io(state, IO_READ, lba, 1, dst, SECTOR)
}

fn write_block(state: u64, lba: u64, src: u64) -> bool {
    if !run_io(state, IO_WRITE, lba, 1, src, SECTOR) {
        return false
    }
    return flush(state)
}

fn write_many(state: u64, lba: u64, count: u64, src: u64) -> bool {
    let len: u64 = count * SECTOR
    if count == 0 || len > 2 * PAGE || (src & (PAGE - 1)) + len > 2 * PAGE {
        return false
    }
    return run_io(state, IO_WRITE, lba, count, src, len)
}

fn read_many(state: u64, lba: u64, count: u64, dst: u64) -> bool {
    let len: u64 = count * SECTOR
    if len > 2 * PAGE {
        return false
    }
    return run_io(state, IO_READ, lba, count, dst, len)
}

const RUN_SECTORS: u64 = 8

fn read_run(state: u64, lba: u64, count: u64, dst: u64) -> bool {
    var done: u64 = 0
    while done < count {
        var n: u64 = count - done
        if n > RUN_SECTORS {
            n = RUN_SECTORS
        }
        if !run_io(state, IO_READ, lba + done, n, dst + done * SECTOR, n * SECTOR) {
            return false
        }
        done = done + n
    }
    return true
}

fn flush(state: u64) -> bool {
    return run_io(state, IO_FLUSH, 0, 1, 0, 0)
}

fn kill(state: u64) {
    let b: u64 = kstate.get(state, sc(S_BASE))
    if b != 0 {
        regio.write32_at(b, R_CC, 0)
    }
}

fn resume(state: u64) -> bool {
    if kstate.get(state, sc(S_BASE)) == 0 {
        return false
    }
    let m: bool = kstate.get(state, sc(S_MSIX)) != 0
    return init(state, m, true)
}
