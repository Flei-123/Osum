profile kernel

import bus.pci
import arch.x86_64.apic

export { msi_arm, VECTOR }

const VECTOR: u64 = 41
const CFG_COMMAND: u64 = 0x04
const CMD_INTX_DISABLE: u64 = 0x400
const MSI_ENABLE: u64 = 0x1
const MSI_MME_MASK: u64 = 0x70
const MSI_64BIT: u64 = 0x80
const MSI_DEST_SHIFT: u64 = 12

fn msi_arm(state: u64, bdf: u64) -> bool {
    let cap: u64 = pci.cap_find(bdf, pci.CAP_MSI)
    if cap == 0 {
        return false
    }
    let ctrl: u64 = pci.cfg_read16(bdf, cap + 2)
    pci.cfg_write32(bdf, cap + 4, apic.lapic_phys(state) | (apic.id(state) << MSI_DEST_SHIFT))
    if (ctrl & MSI_64BIT) != 0 {
        pci.cfg_write32(bdf, cap + 8, 0)
        pci.cfg_write16(bdf, cap + 12, VECTOR)
    } else {
        pci.cfg_write16(bdf, cap + 8, VECTOR)
    }
    pci.cfg_write16(bdf, cap + 2, (ctrl | MSI_ENABLE) & (0xFFFF ^ MSI_MME_MASK))
    pci.cfg_write16(bdf, CFG_COMMAND, pci.cfg_read16(bdf, CFG_COMMAND) | CMD_INTX_DISABLE)
    return true
}
