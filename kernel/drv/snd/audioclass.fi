profile kernel

import bus.drvnull

export { AudioOps, null_ops, RATE_DEFAULT }

const RATE_DEFAULT: u64 = 48000

struct AudioOps {
    init: fn(u64) -> bool,
    ready: fn(u64) -> bool,
    running: fn(u64) -> bool,
    why: fn(u64) -> u64,
    ring_base: fn(u64) -> u64,
    ring_frames: fn(u64) -> u64,
    entries: fn(u64) -> u64,
    entry_frames: fn(u64) -> u64,
    submit: fn(u64) -> bool,
    start: fn(u64) -> bool,
    stop: fn(u64),
    position_frames: fn(u64) -> u64,
    submitted_frames: fn(u64) -> u64,
    underruns: fn(u64) -> u64,
    backsteps: fn(u64) -> u64,
    rate: fn(u64) -> u64,
    set_rate: fn(u64, u64) -> bool,
    set_volume: fn(u64, u64),
    set_muted: fn(u64, bool),
    irq: fn(u64),
    arm_irq: fn(u64, bool) -> bool,
    drain_mark: fn(u64),
    reset_box: fn(u64),
    tag: u64
}

fn n_one(state: u64) -> u64 {
    return 1
}

fn n_rate(state: u64) -> u64 {
    return RATE_DEFAULT
}

fn n_set_rate(state: u64, hz: u64) -> bool {
    return false
}

fn n_volume(state: u64, pct: u64) {
}

fn n_muted(state: u64, on: bool) {
}

fn n_arm(state: u64, armed: bool) -> bool {
    return false
}

fn null_ops() -> AudioOps {
    return AudioOps {
        init: drvnull.n_false,
        ready: drvnull.n_false,
        running: drvnull.n_false,
        why: drvnull.n_zero,
        ring_base: drvnull.n_zero,
        ring_frames: drvnull.n_zero,
        entries: drvnull.n_zero,
        entry_frames: n_one,
        submit: drvnull.n_false,
        start: drvnull.n_false,
        stop: drvnull.n_noop,
        position_frames: drvnull.n_zero,
        submitted_frames: drvnull.n_zero,
        underruns: drvnull.n_zero,
        backsteps: drvnull.n_zero,
        rate: n_rate,
        set_rate: n_set_rate,
        set_volume: n_volume,
        set_muted: n_muted,
        irq: drvnull.n_noop,
        arm_irq: n_arm,
        drain_mark: drvnull.n_noop,
        reset_box: drvnull.n_noop,
        tag: 0
    }
}
