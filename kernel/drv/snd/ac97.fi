// SPDX-License-Identifier: GPL-2.0-only
// kernel/ac97.fi -- der AC97-Treiber.

profile kernel

import lib.kstate
import serial
import bus.pci
import mm.mem
import arch.arch
import arch.x86_64.apic

export {
    init, present, ready, why, bdf, nam, nabm,
    start, stop, running, submit, ring_base, ring_octets,
    entries, entry_frames, entry_octets, ring_frames,
    position_frames, position_raw, civ, picb, status, clear_status,
    set_volume, volume, muted, set_muted,
    underruns, submits, starts, stops, irqs, irq, dch_seen,
    reset_box_pub, submitted_frames, backsteps,
    codec_ready, vendor, device, master_reg, pcm_reg,
    CHANNELS, BITS, RATE, RATE_OLD,
    rate, set_rate, vra, arm_irq, irq_armed,
    W_OK, W_OFF, W_NODEV, W_NOBAR, W_NORING, W_HIGHRING, W_NOCODEC
}

// ------------------------------------------------------- die Geometrie
const CHANNELS: u64 = 2
const BITS: u64 = 16
const RATE: u64 = 48000
const RATE_OLD: u64 = 44100
const FRAME_OCTETS: u64 = 4 // 2 Kanaele * 16 Bit
const ENTRY_FRAMES: u64 = 128
const ENTRY_OCTETS: u64 = 512 // ENTRY_FRAMES * FRAME_OCTETS
const ENTRIES: u64 = 32
const RING_OCTETS: u64 = 16384 // ENTRIES * ENTRY_OCTETS
const RING_FRAMES: u64 = 4096 // ENTRIES * ENTRY_FRAMES
const RING_PAGES: u64 = 4 // RING_OCTETS / 4096

const BDL_OFF: u64 = 0x800
const BDL_ENTRIES: u64 = 32

const S_READY: u64 = 0x000
const S_BDF: u64 = 0x008
const S_NAM: u64 = 0x010
const S_NABM: u64 = 0x018
const S_RING: u64 = 0x020
const S_RUNNING: u64 = 0x028
const S_HEAD: u64 = 0x030
const S_SUBMITTED: u64 = 0x038
const S_LASTRAW: u64 = 0x040
const S_WRAPS: u64 = 0x048
const S_POS: u64 = 0x050 // zuletzt herausgegebene Position
const S_VOL: u64 = 0x058
const S_IRQS: u64 = 0x060
const S_UNDER: u64 = 0x068
const S_WHY: u64 = 0x070
const S_VENDOR: u64 = 0x078
const S_DEVICE: u64 = 0x080
const S_CODEC: u64 = 0x088
const S_STARTS: u64 = 0x090
const S_STOPS: u64 = 0x098
const S_SUBMITS: u64 = 0x0A0
const S_DCH: u64 = 0x0A8
const S_MUTE: u64 = 0x0B0
const S_MASTER: u64 = 0x0B8
const S_PCMREG: u64 = 0x0C0
const S_BACKW: u64 = 0x0C8
const S_RATE: u64 = 0x0D0 // die eingestellte Abtastrate in Hz
const S_VRA: u64 = 0x0D8
const S_IRQON: u64 = 0x0E0
const S_GUARD: u64 = 0x0E8

const W_OK: u64 = 0
const W_OFF: u64 = 1
const W_NODEV: u64 = 2
const W_NOBAR: u64 = 3 // die beiden Portbereiche fehlen
const W_NORING: u64 = 4
const W_HIGHRING: u64 = 5
const W_NOCODEC: u64 = 6

// -------------------------------------------------------- der Mischer
const NAM_RESET: u64 = 0x00
const NAM_MASTER: u64 = 0x02
const NAM_PCM_OUT: u64 = 0x18
const NAM_EXT_ID: u64 = 0x28
const NAM_EXT_CTL: u64 = 0x2A
const NAM_DAC_RATE: u64 = 0x2C
const MUTE_BIT: u64 = 0x8000

const PO_BDBAR: u64 = 0x10
const PO_CIV: u64 = 0x14 // 8 Bit: laufender Eintrag
const PO_LVI: u64 = 0x15 // 8 Bit: letzter gueltiger Eintrag
const PO_SR: u64 = 0x16 // 16 Bit: Zustand
const PO_PICB: u64 = 0x18
const PO_PIV: u64 = 0x1A
const PO_CR: u64 = 0x1B // 8 Bit: Steuerung
const GLOB_CNT: u64 = 0x2C
const GLOB_STA: u64 = 0x30

const CR_RPBM: u64 = 0x01 // laufen
const CR_RR: u64 = 0x02 // Register ruecksetzen
const CR_LVBIE: u64 = 0x04
const CR_IOCE: u64 = 0x10

const SR_DCH: u64 = 0x01 // DMA-Halbleiter angehalten
const SR_CELV: u64 = 0x02
const SR_LVBCI: u64 = 0x04
const SR_BCIS: u64 = 0x08
const SR_FIFOE: u64 = 0x10

const GC_COLD: u64 = 0x02
const GS_PCR: u64 = 0x100 // primaerer Codec bereit

const SPIN_LIMIT: u64 = 200000

// ------------------------------------------------------ kleine Helfer

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state + kstate.AUD_OFF, off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state + kstate.AUD_OFF, off, v)
}

fn nam(state: u64) -> u64 {
    return g(state, S_NAM)
}

fn nabm(state: u64) -> u64 {
    return g(state, S_NABM)
}

fn bdf(state: u64) -> u64 {
    return g(state, S_BDF)
}

fn present(state: u64) -> bool {
    return g(state, S_NABM) != 0
}

fn ready(state: u64) -> bool {
    return g(state, S_READY) != 0
}

fn why(state: u64) -> u64 {
    return g(state, S_WHY)
}

fn running(state: u64) -> bool {
    return g(state, S_RUNNING) != 0
}

fn ring_base(state: u64) -> u64 {
    return g(state, S_RING)
}

fn ring_octets(state: u64) -> u64 {
    return RING_OCTETS
}

fn ring_frames(state: u64) -> u64 {
    return RING_FRAMES
}

fn entries(state: u64) -> u64 {
    return ENTRIES
}

fn entry_frames(state: u64) -> u64 {
    return ENTRY_FRAMES
}

fn entry_octets(state: u64) -> u64 {
    return ENTRY_OCTETS
}

fn underruns(state: u64) -> u64 {
    return g(state, S_UNDER)
}

fn submits(state: u64) -> u64 {
    return g(state, S_SUBMITS)
}

fn starts(state: u64) -> u64 {
    return g(state, S_STARTS)
}

fn stops(state: u64) -> u64 {
    return g(state, S_STOPS)
}

fn irqs(state: u64) -> u64 {
    return g(state, S_IRQS)
}

fn dch_seen(state: u64) -> u64 {
    return g(state, S_DCH)
}

fn backsteps(state: u64) -> u64 {
    return g(state, S_BACKW)
}

fn submitted_frames(state: u64) -> u64 {
    return g(state, S_SUBMITTED)
}

fn reset_box_pub(state: u64) {
    if !present(state) {
        return
    }
    reset_box(state)
    zero_ring(state)
    let b: u64 = nabm(state)
    pout32(b, PO_BDBAR, bdl(state))
}

fn codec_ready(state: u64) -> bool {
    return g(state, S_CODEC) != 0
}

fn vendor(state: u64) -> u64 {
    return g(state, S_VENDOR)
}

fn device(state: u64) -> u64 {
    return g(state, S_DEVICE)
}

fn master_reg(state: u64) -> u64 {
    return g(state, S_MASTER)
}

fn pcm_reg(state: u64) -> u64 {
    return g(state, S_PCMREG)
}

fn volume(state: u64) -> u64 {
    return g(state, S_VOL)
}

fn muted(state: u64) -> bool {
    return g(state, S_MUTE) != 0
}

// ==================================================== RUNDE HDA: DIE RATE
fn rate(state: u64) -> u64 {
    let r: u64 = g(state, S_RATE)
    if r == 0 {
        return RATE
    }
    return r
}

fn vra(state: u64) -> bool {
    return g(state, S_VRA) != 0
}

fn set_rate(state: u64, hz: u64) -> bool {
    if !ready(state) {
        return false
    }
    if hz == RATE && g(state, S_VRA) == 0 {
        s(state, S_RATE, RATE)
        return true
    }
    if g(state, S_VRA) == 0 {
        return false
    }
    if hz < 8000 || hz > 48000 {
        return false
    }
    let b0: u64 = nam(state)
    pout16(b0, NAM_DAC_RATE, hz)
    let got: u64 = pin16(b0, NAM_DAC_RATE)
    if got != hz {
        s(state, S_RATE, got)
        return false
    }
    s(state, S_RATE, hz)
    return true
}

// ============================================ RUNDE HDA: DIE UNTERBRECHUNG
const VEC_AUDIO: u64 = 42

fn arm_irq(state: u64, armed: bool) -> bool {
    if !ready(state) {
        return false
    }
    let d: u64 = bdf(state)
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) & 0xFBFF)
    let idx: u64 = pci.find_bdf(state, d)
    if idx >= pci.MAX_DEV {
        return false
    }
    let gsi: u64 = pci.get(state, idx, pci.E_IRQLINE)
    if gsi == 0 || gsi > 23 {
        return false
    }
    apic.route(state, gsi, VEC_AUDIO, apic.id(state), true, true)
    if !armed {
        apic.mask_gsi(state, gsi)
        s(state, S_IRQON, 0)
        return false
    }
    let b: u64 = nabm(state)
    pout8(b, PO_CR, pin8(b, PO_CR) | CR_IOCE | CR_LVBIE)
    s(state, S_IRQON, 1)
    return true
}

fn irq_armed(state: u64) -> bool {
    return g(state, S_IRQON) != 0
}

fn pin8(base: u64, off: u64) -> u64 {
    return arch.dev_in8(((base + off) & 0xFFFF) as u16) as u64
}

fn pout8(base: u64, off: u64, v: u64) {
    arch.dev_out8(((base + off) & 0xFFFF) as u16, (v & 0xFF) as u8)
}

fn pin16(base: u64, off: u64) -> u64 {
    return arch.dev_in16(((base + off) & 0xFFFF) as u16) as u64
}

fn pout16(base: u64, off: u64, v: u64) {
    arch.dev_out16(((base + off) & 0xFFFF) as u16, (v & 0xFFFF) as u16)
}

fn pin32(base: u64, off: u64) -> u64 {
    return arch.dev_in32(((base + off) & 0xFFFF) as u16) as u64
}

fn pout32(base: u64, off: u64, v: u64) {
    arch.dev_out32(((base + off) & 0xFFFF) as u16, (v & 0xFFFFFFFF) as u32)
}

fn bdl(state: u64) -> u64 {
    return state + kstate.AUD_OFF + BDL_OFF
}

fn bdl_set(state: u64, i: u64, addr: u64, samples: u64, ctl: u64) {
    let e: u64 = bdl(state) + (i % BDL_ENTRIES) * 8
    __mmio_write32(e as *mut u32, (addr & 0xFFFFFFFF) as u32)
    __mmio_write16((e + 4) as *mut u16, (samples & 0xFFFF) as u16)
    __mmio_write16((e + 6) as *mut u16, (ctl & 0xFFFF) as u16)
}

// ================================================================ Start

fn init(state: u64) -> bool {
    var s_head: [u8; 7] = "ac97: \0"
    var s_no: [u8; 17] = "no device 04:01\0\0"
    var s_bar: [u8; 24] = "Portbereiche fehlen\0\0\0\0\0"
    var s_ring: [u8; 22] = "kein Ringpuffer frei\0\0"
    var s_high: [u8; 20] = "ring above 4 GiB\0\0\0\0"
    var s_codec: [u8; 18] = "codec not ready\0\0\0"
    var s_ok: [u8; 7] = "bereit\0"
    var s_nam: [u8; 6] = " nam=\0"
    var s_nabm: [u8; 7] = " nabm=\0"
    var s_ring2: [u8; 7] = " ring=\0"
    var s_id: [u8; 5] = " id=\0"

    s(state, S_WHY, W_OK)
    s(state, S_VOL, 100)

    let idx: u64 = pci.find_class(state, 0x04, 0x01, 0x100)
    if idx >= pci.MAX_DEV {
        s(state, S_WHY, W_NODEV)
        serial.puts((&s_head[0]) as u64)
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return false
    }
    let d: u64 = pci.get(state, idx, pci.E_BDF)
    s(state, S_BDF, d)
    s(state, S_VENDOR, pci.get(state, idx, pci.E_VENDOR))
    s(state, S_DEVICE, pci.get(state, idx, pci.E_DEVICE))

    if !pci.bar_is_io(state, idx, 0) || !pci.bar_is_io(state, idx, 1) {
        s(state, S_WHY, W_NOBAR)
        serial.puts((&s_head[0]) as u64)
        serial.puts((&s_bar[0]) as u64)
        serial.nl()
        return false
    }
    let b0: u64 = pci.bar(state, idx, 0)
    let b1: u64 = pci.bar(state, idx, 1)
    if b0 == 0 || b1 == 0 {
        s(state, S_WHY, W_NOBAR)
        return false
    }
    s(state, S_NAM, b0)
    s(state, S_NABM, b1)

    let cmd: u64 = pci.cfg_read16(d, 0x04)
    pci.cfg_write16(d, 0x04, cmd | 0x0001 | 0x0004)

    let ring: u64 = mem.frame_run(state, RING_PAGES)
    if ring == 0 {
        s(state, S_WHY, W_NORING)
        serial.puts((&s_head[0]) as u64)
        serial.puts((&s_ring[0]) as u64)
        serial.nl()
        return false
    }
    if ring + RING_OCTETS > 0x100000000 {
        s(state, S_WHY, W_HIGHRING)
        serial.puts((&s_head[0]) as u64)
        serial.puts((&s_high[0]) as u64)
        serial.nl()
        return false
    }
    s(state, S_RING, ring)
    zero_ring(state)

    pout32(b1, GLOB_CNT, GC_COLD)
    var n: u64 = 0
    var codec: bool = false
    while n < SPIN_LIMIT {
        if (pin32(b1, GLOB_STA) & GS_PCR) != 0 {
            codec = true
            n = SPIN_LIMIT
        } else {
            n = n + 1
        }
    }
    if codec {
        s(state, S_CODEC, 1)
    } else {
        s(state, S_CODEC, 0)
    }

    pout16(b0, NAM_RESET, 0)
    if !codec {
        n = 0
        while n < SPIN_LIMIT {
            if (pin32(b1, GLOB_STA) & GS_PCR) != 0 {
                codec = true
                n = SPIN_LIMIT
            } else {
                n = n + 1
            }
        }
        if codec {
            s(state, S_CODEC, 1)
        } else {
            s(state, S_WHY, W_NOCODEC)
            serial.puts((&s_head[0]) as u64)
            serial.puts((&s_codec[0]) as u64)
            serial.nl()
            return false
        }
    }

    let ext: u64 = pin16(b0, NAM_EXT_ID)
    if (ext & 1) != 0 {
        pout16(b0, NAM_EXT_CTL, pin16(b0, NAM_EXT_CTL) | 1)
        s(state, S_VRA, 1)
        pout16(b0, NAM_DAC_RATE, RATE)
    } else {
        s(state, S_VRA, 0)
    }
    s(state, S_RATE, RATE)

    apply_volume(state)

    reset_box(state)
    pout32(b1, PO_BDBAR, bdl(state))

    s(state, S_READY, 1)
    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_ok[0]) as u64)
    serial.puts((&s_id[0]) as u64)
    serial.hex(g(state, S_VENDOR))
    serial.hex(g(state, S_DEVICE))
    serial.puts((&s_nam[0]) as u64)
    serial.hex(b0)
    serial.puts((&s_nabm[0]) as u64)
    serial.hex(b1)
    serial.puts((&s_ring2[0]) as u64)
    serial.hex(ring)
    serial.nl()
    return true
}

fn zero_ring(state: u64) {
    let r: u64 = g(state, S_RING)
    if r == 0 {
        return
    }
    var i: u64 = 0
    while i < RING_OCTETS / 8 {
        kstate.set(r, i * 8, 0)
        i = i + 1
    }
}

fn reset_box(state: u64) {
    let b: u64 = nabm(state)
    pout8(b, PO_CR, CR_RR)
    var n: u64 = 0
    while n < SPIN_LIMIT {
        if (pin8(b, PO_CR) & CR_RR) == 0 {
            n = SPIN_LIMIT
        } else {
            n = n + 1
        }
    }
    pout16(b, PO_SR, SR_LVBCI | SR_BCIS | SR_FIFOE)
    s(state, S_HEAD, 0)
    s(state, S_SUBMITTED, 0)
    s(state, S_LASTRAW, 0)
    s(state, S_WRAPS, 0)
    s(state, S_POS, 0)
    s(state, S_RUNNING, 0)
    s(state, S_BACKW, 0)
}

// ============================================================ Mischer
const PCM_UNITY: u64 = 0x0000

fn set_volume(state: u64, pct: u64) {
    var v: u64 = pct
    if v > 100 {
        v = 100
    }
    s(state, S_VOL, v)
    apply_volume(state)
}

fn set_muted(state: u64, on: bool) {
    if on {
        s(state, S_MUTE, 1)
    } else {
        s(state, S_MUTE, 0)
    }
    apply_volume(state)
}

fn apply_volume(state: u64) {
    let b0: u64 = nam(state)
    if b0 == 0 {
        return
    }
    let v: u64 = g(state, S_VOL)
    // 63 Schritte Daempfung; 100 Prozent sind 0 Schritte.
    var att: u64 = (63 * (100 -% v)) / 100
    if att > 63 {
        att = 63
    }
    var m: u64 = (att << 8) | att
    if v == 0 || g(state, S_MUTE) != 0 {
        m = m | MUTE_BIT
    }
    pout16(b0, NAM_MASTER, m)
    pout16(b0, NAM_PCM_OUT, PCM_UNITY)
    s(state, S_MASTER, m)
    s(state, S_PCMREG, PCM_UNITY)
}

fn civ(state: u64) -> u64 {
    return pin8(nabm(state), PO_CIV) % ENTRIES
}

fn picb(state: u64) -> u64 {
    return pin16(nabm(state), PO_PICB)
}

fn status(state: u64) -> u64 {
    return pin16(nabm(state), PO_SR)
}

fn clear_status(state: u64) {
    pout16(nabm(state), PO_SR, SR_LVBCI | SR_BCIS | SR_FIFOE)
}

fn submit(state: u64) -> bool {
    if !ready(state) {
        return false
    }
    let b: u64 = nabm(state)
    let head: u64 = g(state, S_HEAD)
    let r: u64 = g(state, S_RING)
    bdl_set(state, head, r + head * ENTRY_OCTETS,
        ENTRY_FRAMES * CHANNELS, 0)
    s(state, S_HEAD, (head + 1) % ENTRIES)
    s(state, S_SUBMITTED, g(state, S_SUBMITTED) + ENTRY_FRAMES)
    s(state, S_SUBMITS, g(state, S_SUBMITS) + 1)
    if g(state, S_RUNNING) != 0 {
        if (pin16(b, PO_SR) & SR_DCH) != 0 {
            s(state, S_UNDER, g(state, S_UNDER) + 1)
            s(state, S_DCH, g(state, S_DCH) + 1)
            resync(state)
        }
    }
    pout8(b, PO_LVI, head)
    return true
}

fn resync(state: u64) {
    let raw: u64 = position_raw(state)
    let pos: u64 = g(state, S_POS)
    var w: u64 = 0
    if pos > raw {
        w = (pos -% raw) / RING_FRAMES
        if w * RING_FRAMES + raw < pos {
            w = w + 1
        }
    }
    s(state, S_WRAPS, w)
    s(state, S_LASTRAW, raw)
}

fn start(state: u64) -> bool {
    if !ready(state) {
        return false
    }
    if g(state, S_RUNNING) != 0 {
        return true
    }
    let b: u64 = nabm(state)
    pout32(b, PO_BDBAR, bdl(state))
    pout16(b, PO_SR, SR_LVBCI | SR_BCIS | SR_FIFOE)
    pout8(b, PO_CR, CR_RPBM)
    s(state, S_RUNNING, 1)
    s(state, S_STARTS, g(state, S_STARTS) + 1)
    return true
}

fn stop(state: u64) {
    if !present(state) {
        return
    }
    let b: u64 = nabm(state)
    pout8(b, PO_CR, 0)
    s(state, S_RUNNING, 0)
    s(state, S_STOPS, g(state, S_STOPS) + 1)
}

// ========================================================== die Uhr
fn position_raw(state: u64) -> u64 {
    let b: u64 = nabm(state)
    var c0: u64 = pin8(b, PO_CIV) % ENTRIES
    var p: u64 = pin16(b, PO_PICB)
    var c1: u64 = pin8(b, PO_CIV) % ENTRIES
    if c0 != c1 {
        c0 = c1
        p = pin16(b, PO_PICB)
    }
    var done: u64 = ENTRY_FRAMES
    let rest: u64 = p / CHANNELS
    if rest <= ENTRY_FRAMES {
        done = ENTRY_FRAMES -% rest
    }
    return c0 * ENTRY_FRAMES + done
}

fn position_frames(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    if g(state, S_RUNNING) == 0 {
        return g(state, S_POS)
    }
    if g(state, S_GUARD) != 0 {
        return g(state, S_POS)
    }
    s(state, S_GUARD, 1)
    let raw: u64 = position_raw(state)
    var w: u64 = g(state, S_WRAPS)
    if raw < g(state, S_LASTRAW) {
        w = w + 1
        s(state, S_WRAPS, w)
    }
    s(state, S_LASTRAW, raw)
    var pos: u64 = w * RING_FRAMES + raw
    let sub: u64 = g(state, S_SUBMITTED)
    if pos > sub {
        pos = sub
    }
    if pos < g(state, S_POS) {
        pos = g(state, S_POS)
        s(state, S_BACKW, g(state, S_BACKW) + 1)
    }
    s(state, S_POS, pos)
    s(state, S_GUARD, 0)
    return pos
}

fn irq(state: u64) {
    s(state, S_IRQS, g(state, S_IRQS) + 1)
    clear_status(state)
}
