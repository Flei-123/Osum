const B_NONE: u64 = 0
const B_AC97: u64 = 1
const B_HDA: u64 = 2 // Intel HD-Audio (Runde HDA)

const A_READY: u64 = 0
const A_RATE: u64 = 1
const A_CHANNELS: u64 = 2
const A_BITS: u64 = 3
const A_VOLUME: u64 = 4
const A_PLAYED: u64 = 5
const A_WRITTEN: u64 = 6
const A_UNDERRUNS: u64 = 7
const A_LATENCY: u64 = 8 // Mikrosekunden, ganzer Ring
const A_ENTRYUS: u64 = 9
const A_RINGFRAMES: u64 = 10
const A_ENTRYFRAMES: u64 = 11
const A_ENTRIES: u64 = 12
const A_RUNNING: u64 = 13
const A_OPEN: u64 = 14
const A_BACKEND: u64 = 15
const A_WHY: u64 = 16
const A_IRQS: u64 = 17
const A_SUBMITS: u64 = 18
const A_SOUNDS: u64 = 19
const A_BEEPS: u64 = 20
const A_MUTED: u64 = 21
const A_STARTS: u64 = 22
const A_DCH: u64 = 23
const A_CODEC: u64 = 24
const A_REMAIN: u64 = 25
const A_WRITES: u64 = 26
const A_MASTERREG: u64 = 27
const A_PCMREG: u64 = 28
const A_BACKSTEPS: u64 = 29
const A_BACKSTEPS_UNUSED: u64 = 29
const A_STREAMS: u64 = 30
const A_MIXED: u64 = 31 // gemischte Rahmen, gesamt
const A_CLIPS: u64 = 32 // dabei begrenzte Abtastwerte
const A_MIXUNDER: u64 = 33
const A_DISAGREE: u64 = 34
const A_IRQARMED: u64 = 35
const A_CMDPATH: u64 = 36
const A_DAC: u64 = 37
const A_PIN: u64 = 38
const A_PATHLEN: u64 = 39
const A_WIDGETS: u64 = 40
const A_CODECADDR: u64 = 41
const A_LOST: u64 = 42
const A_ZEROED: u64 = 43 // vorausgenullte Rahmen
// ---- RUNDE TON ----
const A_VOLGEN: u64 = 44 // Aenderungszaehler von Master/Stumm (Ring 3 fragt ab)
const A_CLICKS: u64 = 45 // Klickton an/aus
const A_TICKSKIP: u64 = 46
const A_LOCKSPIN: u64 = 47 // Wartedrehungen an der Tonsperre, gesamt
const A_MINFILL: u64 = 48
const A_SYSSOUNDS: u64 = 49
// ---- RUNDE TON, die Messstrecke ----
const A_GAPMAX: u64 = 50
const A_SYSUS: u64 = 51
const A_WALLUS: u64 = 52
const A_CALLS: u64 = 53
const A_CAPREADY: u64 = 54 // W-TRAY6: 1 = a microphone path exists (or can still be tried)
const A_CAPUSERS: u64 = 55 // programs that read the microphone within the last 2 s
const A_CAPMUTE: u64 = 56 // 1 = microphone muted (reads return silence)
const A_CAPKIND: u64 = 57 // default device of the chosen pin: 10 mic, 8 line-in, 0 none/other
const A_CAPFRAMES: u64 = 58 // frames captured since the stream started
const A_CAPOVER: u64 = 59 // reads that fell behind the ring
const A_CAPWHO0: u64 = 60 // task index of the 1st program reading the microphone (60..63 = up to four; 0 = none)
const A_COUNT: u64 = 64

const L_OFF: u64 = 0x400
const L_OPEN: u64 = 0x00
const L_WPOS: u64 = 0x08 // vom Programm geschriebene Rahmen, gesamt
const L_BACKEND: u64 = 0x10
const L_SOUNDS: u64 = 0x18
const L_BEEPS: u64 = 0x20
const L_WRITES: u64 = 0x28
const L_OCTETS: u64 = 0x30
const L_STARTED: u64 = 0x38
const L_RATE: u64 = 0x48
const L_ZERO: u64 = 0x50
const L_LOST: u64 = 0x58
const L_ZEROED: u64 = 0x60 // vorausgenullte Rahmen, gesamt
const L_IDLE: u64 = 0x68
const L_PHASE: u64 = 0x40
const L_LOCK: u64 = 0x70 // die Tonsperre (0 = frei, sonst Kern + 1)
const L_MASTER: u64 = 0x78 // der Master in Prozent, 0..100, LINEAR
const L_MMUTE: u64 = 0x80 // Master stumm
const L_CLICKS: u64 = 0x88
const L_VOLGEN: u64 = 0x90 // zaehlt jede Aenderung an Master/Stumm
const L_SYSSND: u64 = 0x98
const L_LASTNS: u64 = 0xC8 // Uhr beim letzten Schub
const L_GAPMAX: u64 = 0xD0 // groesste Pause dazwischen, in us
const L_SYSUS: u64 = 0xD8
const L_FIRSTNS: u64 = 0xE0 // Uhr beim ersten Schub
const L_CALLS: u64 = 0xE8
const L_TICKSKIP: u64 = 0xA0
const L_LOCKSPIN: u64 = 0xA8
const L_MINFILL: u64 = 0xB0
const L_SNDPH: u64 = 0xB8 // Phase des Systemklangs

const HEADROOM_ENTRIES: u64 = 1

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state + kstate.AUD_OFF, L_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state + kstate.AUD_OFF, L_OFF + off, v)
}

// ============================================ die Treiberdinge

fn hw_ready(state: u64) -> bool {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.ready(state)
    }
    if b == B_AC97 {
        return ac97.ready(state)
    }
    return false
}

fn hw_ring(state: u64) -> u64 {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.ring_base(state)
    }
    if b == B_AC97 {
        return ac97.ring_base(state)
    }
    return 0
}

fn hw_ring_frames(state: u64) -> u64 {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.ring_frames(state)
    }
    if b == B_AC97 {
        return ac97.ring_frames(state)
    }
    return 0
}

fn hw_entry_frames(state: u64) -> u64 {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.entry_frames(state)
    }
    if b == B_AC97 {
        return ac97.entry_frames(state)
    }
    return 1
}

fn hw_entries(state: u64) -> u64 {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.entries(state)
    }
    if b == B_AC97 {
        return ac97.entries(state)
    }
    return 0
}

fn hw_submit(state: u64) -> bool {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.submit(state)
    }
    if b == B_AC97 {
        return ac97.submit(state)
    }
    return false
}

fn hw_start(state: u64) -> bool {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.start(state)
    }
    if b == B_AC97 {
        return ac97.start(state)
    }
    return false
}

fn hw_stop(state: u64) {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        hda.stop(state)
    }
    if b == B_AC97 {
        ac97.stop(state)
    }
}

fn hw_position(state: u64) -> u64 {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.position_frames(state)
    }
    if b == B_AC97 {
        return ac97.position_frames(state)
    }
    return 0
}

fn hw_volume(state: u64, pct: u64) {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        hda.set_volume(state, pct)
    }
    if b == B_AC97 {
        ac97.set_volume(state, pct)
    }
}

fn hw_running(state: u64) -> bool {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.running(state)
    }
    if b == B_AC97 {
        return ac97.running(state)
    }
    return false
}

fn hw_drain_mark(state: u64) {
    if g(state, L_BACKEND) == B_HDA {
        hda.drain_mark(state)
    }
}

fn hw_rate(state: u64) -> u64 {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.rate(state)
    }
    if b == B_AC97 {
        return ac97.rate(state)
    }
    return ac97.RATE
}

fn hw_set_rate(state: u64, hz: u64) -> bool {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.set_rate(state, hz)
    }
    if b == B_AC97 {
        return ac97.set_rate(state, hz)
    }
    return false
}

fn init(state: u64) -> bool {
    s(state, L_BACKEND, B_NONE)
    s(state, L_SOUNDS, 1)
    s(state, L_MASTER, 100)
    s(state, L_MMUTE, 0)
    s(state, L_CLICKS, 1)
    s(state, L_LOCK, 0)
    s(state, L_VOLGEN, 0)
    s(state, L_MINFILL, 0xFFFFFFFFFFFFFFFF)
    s(state, L_RATE, ac97.RATE)
    mix.init(state)
    if !kstate.mode_on(state, kstate.M_NOHDA) {
        if hda.init(state) {
            s(state, L_BACKEND, B_HDA)
            s(state, L_RATE, hda.rate(state))
            return true
        }
    }
    if !kstate.mode_on(state, kstate.M_NOAC97) {
        if ac97.init(state) {
            s(state, L_BACKEND, B_AC97)
            s(state, L_RATE, ac97.rate(state))
            return true
        }
    }
    return false
}

fn tick(state: u64) {
    if g(state, L_BACKEND) == B_NONE {
        return
    }
    if !try_hold(state) {
        s(state, L_TICKSKIP, g(state, L_TICKSKIP) + 1)
        return
    }
    tick_locked(state)
    release(state)
}

fn tick_locked(state: u64) {
    mic.tick(state) // W-TRAY6: microphone stream (one load when idle)
    mix.reap(state)
    if !hw_running(state) {
        return
    }
    samples_played(state)
    if g(state, L_STARTED) != 0 {
        let reserve: u64 = remaining(state)
        if reserve < g(state, L_MINFILL) {
            s(state, L_MINFILL, reserve)
        }
    }
    zero_ahead(state)
    if mix.streams(state) != 0 {
        mix_pump(state)
    }
}

fn irq(state: u64) {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        hda.irq(state)
    }
    if b == B_AC97 {
        ac97.irq(state)
    }
}

fn arm_irq(state: u64, armed: bool) -> bool {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.arm_irq(state, armed)
    }
    if b == B_AC97 {
        return ac97.arm_irq(state, armed)
    }
    return false
}

fn backend(state: u64) -> u64 {
    return g(state, L_BACKEND)
}

fn ready(state: u64) -> bool {
    return hw_ready(state)
}

fn why(state: u64) -> u64 {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.why(state)
    }
    if b == B_AC97 {
        return ac97.why(state)
    }
    if hda.why(state) != hda.W_OK {
        return hda.why(state)
    }
    return ac97.why(state)
}

fn rate(state: u64) -> u64 {
    let r: u64 = g(state, L_RATE)
    if r == 0 {
        return ac97.RATE
    }
    return r
}

fn rates_ok(state: u64, hz: u64) -> bool {
    return hz == ac97.RATE || hz == ac97.RATE_OLD
}

fn set_rate(state: u64, hz: u64) -> bool {
    if !hw_ready(state) {
        return false
    }
    if !rates_ok(state, hz) {
        return false
    }
    if hz == g(state, L_RATE) {
        return true
    }
    if hw_running(state) {
        return false
    }
    if !hw_set_rate(state, hz) {
        s(state, L_RATE, hw_rate(state))
        return false
    }
    s(state, L_RATE, hz)
    return true
}

fn channels(state: u64) -> u64 {
    return ac97.CHANNELS
}

fn bits(state: u64) -> u64 {
    return ac97.BITS
}

fn frame_octets(state: u64) -> u64 {
    return channels(state) * (bits(state) / 8)
}

fn ring_frames(state: u64) -> u64 {
    return hw_ring_frames(state)
}

fn latency_us(state: u64) -> u64 {
    if rate(state) == 0 {
        return 0
    }
    return hw_ring_frames(state) * 1000000 / rate(state)
}

fn entry_us(state: u64) -> u64 {
    if rate(state) == 0 {
        return 0
    }
    return hw_entry_frames(state) * 1000000 / rate(state)
}

fn is_open(state: u64) -> bool {
    return g(state, L_OPEN) != 0
}

fn open(state: u64) -> bool {
    return open_rate(state, rate(state))
}

fn open_rate(state: u64, hz: u64) -> bool {
    if !hw_ready(state) {
        return false
    }
    if g(state, L_OPEN) != 0 {
        return false
    }
    if rates_ok(state, hz) && hz != g(state, L_RATE) {
        hw_stop(state)
        set_rate(state, hz)
    }
    reset(state)
    s(state, L_OPEN, 1)
    return true
}

fn close(state: u64) {
    if g(state, L_OPEN) == 0 {
        return
    }
    zero_all(state)
    hw_stop(state)
    s(state, L_OPEN, 0)
    s(state, L_STARTED, 0)
}

fn zero_all(state: u64) {
    let ring: u64 = hw_ring(state)
    if ring == 0 {
        return
    }
    let rf: u64 = hw_ring_frames(state)
    let fo: u64 = frame_octets(state)
    var i: u64 = 0
    while i < rf {
        __mmio_write32((ring + i * fo) as *mut u32, 0)
        i = i + 1
    }
    s(state, L_ZERO, g(state, L_WPOS) + rf)
}

fn reset(state: u64) {
    hw_stop(state)
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        hda.reset_box_pub(state)
    }
    if b == B_AC97 {
        ac97.reset_box_pub(state)
    }
    s(state, L_WPOS, 0)
    s(state, L_ZERO, 0)
    s(state, L_LOST, 0)
    s(state, L_STARTED, 0)
    s(state, L_WRITES, 0)
    s(state, L_OCTETS, 0)
    s(state, L_PHASE, 0)
}

fn frames_written(state: u64) -> u64 {
    return g(state, L_WPOS)
}

fn samples_played(state: u64) -> u64 {
    return hw_position(state)
}

fn remaining(state: u64) -> u64 {
    if g(state, L_STARTED) == 0 && !hw_running(state) {
        return 0
    }
    let w: u64 = g(state, L_WPOS)
    let p: u64 = hw_position(state)
    if p >= w {
        return 0
    }
    return w -% p
}

fn underruns(state: u64) -> u64 {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.underruns(state)
    }
    if b == B_AC97 {
        return ac97.underruns(state)
    }
    return 0
}

fn backsteps(state: u64) -> u64 {
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.backsteps(state)
    }
    if b == B_AC97 {
        return ac97.backsteps(state)
    }
    return 0
}

fn writes(state: u64) -> u64 {
    return g(state, L_WRITES)
}

fn octets_written(state: u64) -> u64 {
    return g(state, L_OCTETS)
}

fn beeps(state: u64) -> u64 {
    return g(state, L_BEEPS)
}

// ================================= RUNDE TON: DER MASTER IN SOFTWARE
fn set_volume(state: u64, pct: u64) {
    var v: u64 = pct
    if v > 100 {
        v = 100
    }
    s(state, L_MASTER, v)
    s(state, L_VOLGEN, g(state, L_VOLGEN) + 1)
}

fn volume(state: u64) -> u64 {
    return g(state, L_MASTER)
}

fn set_muted(state: u64, on: bool) {
    if on {
        s(state, L_MMUTE, 1)
    } else {
        s(state, L_MMUTE, 0)
    }
    s(state, L_VOLGEN, g(state, L_VOLGEN) + 1)
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        hda.set_muted(state, on)
        return
    }
    if b == B_AC97 {
        ac97.set_muted(state, on)
    }
}

fn muted(state: u64) -> bool {
    return g(state, L_MMUTE) != 0
}

fn volgen(state: u64) -> u64 {
    return g(state, L_VOLGEN)
}

fn set_clicks(state: u64, on: bool) {
    if on {
        s(state, L_CLICKS, 1)
    } else {
        s(state, L_CLICKS, 0)
    }
}

fn clicks_on(state: u64) -> bool {
    return g(state, L_CLICKS) != 0
}

fn master_q8(state: u64) -> u64 {
    if g(state, L_MMUTE) != 0 {
        return 0
    }
    return (g(state, L_MASTER) * 256) / 100
}

fn scale16(v: u64, f: u64) -> u64 {
    if f >= 256 {
        return v & 0xFFFF
    }
    if f == 0 {
        return 0
    }
    if (v & 0x8000) != 0 {
        let m: u64 = (65536 -% (v & 0xFFFF)) & 0xFFFF
        let r: u64 = (m * f) >> 8
        return (65536 -% r) & 0xFFFF
    }
    return ((v & 0xFFFF) * f) >> 8
}

fn copy_scaled(src: u64, dst: u64, frames: u64, f: u64) {
    var i: u64 = 0
    while i < frames {
        let w: u64 = kstate.get32(src + i * 4)
        let l: u64 = scale16(w & 0xFFFF, f)
        let r: u64 = scale16((w >> 16) & 0xFFFF, f)
        __mmio_write32((dst + i * 4) as *mut u32, (l | (r << 16)) as u32)
        i = i + 1
    }
}

fn sounds_on(state: u64) -> bool {
    return g(state, L_SOUNDS) != 0
}

fn set_sounds(state: u64, on: bool) {
    if on {
        s(state, L_SOUNDS, 1)
    } else {
        s(state, L_SOUNDS, 0)
    }
}

fn space_frames(state: u64) -> u64 {
    let ring: u64 = hw_ring_frames(state)
    if ring == 0 {
        return 0
    }
    let cap: u64 = ring -% hw_entry_frames(state) * HEADROOM_ENTRIES
    let w: u64 = g(state, L_WPOS)
    let p: u64 = hw_position(state)
    var used: u64 = 0
    if w > p {
        used = w -% p
    }
    if used >= cap {
        return 0
    }
    return cap -% used
}

fn write_kernel(state: u64, src: u64, frames: u64) -> u64 {
    if !hw_ready(state) {
        return 0
    }
    catch_up(state)
    var n: u64 = frames
    let room: u64 = space_frames(state)
    if n > room {
        n = room
    }
    if n == 0 {
        return 0
    }
    let ring: u64 = hw_ring(state)
    let rf: u64 = hw_ring_frames(state)
    let fo: u64 = frame_octets(state)
    var done: u64 = 0
    while done < n {
        let w: u64 = g(state, L_WPOS) + done
        let slot: u64 = w % rf
        var chunk: u64 = rf -% slot
        if chunk > n -% done {
            chunk = n -% done
        }
        let mq: u64 = master_q8(state)
        if mq >= 256 {
            copy_octets(src + done * fo, ring + slot * fo, chunk * fo)
        } else {
            copy_scaled(src + done * fo, ring + slot * fo, chunk, mq)
        }
        done = done + chunk
    }
    s(state, L_WPOS, g(state, L_WPOS) + n)
    s(state, L_WRITES, g(state, L_WRITES) + 1)
    s(state, L_OCTETS, g(state, L_OCTETS) + n * fo)
    zero_ahead(state)
    submit_full(state)
    return n
}

fn write(state: u64, src: u64, frames: u64) -> u64 {
    return write_kernel(state, src, frames)
}

// ================================ DEN RING VORAUS AUSNULLEN

fn catch_up(state: u64) -> u64 {
    if g(state, L_BACKEND) != B_HDA {
        return 0
    }
    if !hw_running(state) {
        return 0
    }
    let p: u64 = hw_position(state)
    let w: u64 = g(state, L_WPOS)
    if p <= w {
        return 0
    }
    let lost_count: u64 = p -% w
    s(state, L_WPOS, p)
    s(state, L_LOST, g(state, L_LOST) +% lost_count)
    zero_all(state)
    s(state, L_ZERO, p + hw_ring_frames(state))
    return lost_count
}

fn lost(state: u64) -> u64 {
    return g(state, L_LOST)
}

fn zero_ahead(state: u64) {
    if g(state, L_BACKEND) != B_HDA {
        return
    }
    let ring: u64 = hw_ring(state)
    if ring == 0 {
        return
    }
    let rf: u64 = hw_ring_frames(state)
    let ef: u64 = hw_entry_frames(state)
    let fo: u64 = frame_octets(state)
    let w: u64 = g(state, L_WPOS)
    let p: u64 = hw_position(state)
    var until: u64 = p + rf
    var begin: u64 = g(state, L_ZERO)
    if begin < w {
        begin = w
    }
    if begin >= until {
        return
    }
    var i: u64 = begin
    while i < until {
        let slot: u64 = i % rf
        __mmio_write32((ring + slot * fo) as *mut u32, 0)
        i = i + 1
    }
    s(state, L_ZERO, until)
    s(state, L_ZEROED, g(state, L_ZEROED) +% (until -% begin))
}

fn zeroed(state: u64) -> u64 {
    return g(state, L_ZEROED)
}

fn drain_mark(state: u64) {
    hw_drain_mark(state)
}

fn zero_rest(state: u64) {
    if g(state, L_BACKEND) != B_HDA {
        return
    }
    let ring: u64 = hw_ring(state)
    if ring == 0 {
        return
    }
    let rf: u64 = hw_ring_frames(state)
    let fo: u64 = frame_octets(state)
    let w: u64 = g(state, L_WPOS)
    let p: u64 = hw_position(state)
    let until: u64 = p + rf
    var i: u64 = w
    if i < g(state, L_ZERO) {
        i = g(state, L_ZERO)
    }
    while i < until {
        __mmio_write32((ring + (i % rf) * fo) as *mut u32, 0)
        i = i + 1
    }
    s(state, L_ZERO, until)
}

fn hw_ready_pub(state: u64) -> bool {
    return hw_ready(state)
}

fn copy_octets(src: u64, dst: u64, n: u64) {
    var i: u64 = 0
    while i + 8 <= n {
        kstate.set(dst, i, kstate.get(src, i))
        i = i + 8
    }
    while i < n {
        kstate.set8(dst + i, kstate.get8(src + i) as u8)
        i = i + 1
    }
}

const PREFILL_ENTRIES: u64 = 24

fn submit_full(state: u64) {
    let ef: u64 = hw_entry_frames(state)
    if ef == 0 {
        return
    }
    let want: u64 = g(state, L_WPOS) / ef
    var have: u64 = submitted_entries(state)
    while have < want {
        if !hw_submit(state) {
            have = want
        } else {
            have = have + 1
        }
    }
    if g(state, L_STARTED) == 0 && submitted_entries(state) >= PREFILL_ENTRIES {
        if hw_start(state) {
            s(state, L_STARTED, 1)
        }
    }
}

fn submitted_entries(state: u64) -> u64 {
    let ef: u64 = hw_entry_frames(state)
    if ef == 0 {
        return 0
    }
    let b: u64 = g(state, L_BACKEND)
    if b == B_HDA {
        return hda.submitted_frames(state) / ef
    }
    if b == B_AC97 {
        return ac97.submitted_frames(state) / ef
    }
    return 0
}

fn pad_and_submit(state: u64) {
    if !hw_ready(state) {
        return
    }
    let ef: u64 = hw_entry_frames(state)
    let w: u64 = g(state, L_WPOS)
    let rest: u64 = w % ef
    if rest != 0 {
        let pad: u64 = ef -% rest
        let ring: u64 = hw_ring(state)
        let rf: u64 = hw_ring_frames(state)
        let fo: u64 = frame_octets(state)
        var i: u64 = 0
        while i < pad {
            let slot: u64 = (w + i) % rf
            __mmio_write32((ring + slot * fo) as *mut u32, 0)
            i = i + 1
        }
        s(state, L_WPOS, w + pad)
    }
    zero_ahead(state)
    submit_full(state)
    if g(state, L_STARTED) == 0 && g(state, L_WPOS) > 0 {
        if hw_start(state) {
            s(state, L_STARTED, 1)
        }
    }
    hw_drain_mark(state)
    zero_rest(state)
}

fn stop(state: u64) {
    hw_stop(state)
    s(state, L_STARTED, 0)
}

// ========================================================== der Sinus
const Q28: u64 = 268435456 // 1 << 28
const PI_HALF_Q28: u64 = 421657428 // round(pi/2 * 2^28)

fn sine_q28(phase: u64) -> u64 {
    let q: u64 = (phase >> 30) & 3
    var r: u64 = phase & 0x3FFFFFFF
    if q == 1 || q == 3 {
        r = 0x40000000 -% r
    }
    // x in Q28, 0..pi/2
    let x: u64 = (r * PI_HALF_Q28) >> 30
    let x2: u64 = (x * x) >> 28
    let p3: u64 = (x * x2) >> 28
    let p5: u64 = (p3 * x2) >> 28
    let p7: u64 = (p5 * x2) >> 28
    let p9: u64 = (p7 * x2) >> 28
    var v: u64 = x + p5 / 120 + p9 / 362880
    let sub: u64 = p3 / 6 + p7 / 5040
    if sub >= v {
        return 0
    }
    v = v -% sub
    if v > Q28 {
        return Q28
    }
    return v
}

fn sine_neg(phase: u64) -> bool {
    return ((phase >> 31) & 1) != 0
}

fn tone_into(state: u64, buf: u64, frames: u64, freq: u64, amp: u64,
    phase0: u64) -> u64 {
    let r: u64 = rate(state)
    if r == 0 {
        return phase0
    }
    let step: u64 = (freq * 4294967296 + r / 2) / r
    var ph: u64 = phase0
    var i: u64 = 0
    while i < frames {
        let m: u64 = (sine_q28(ph) * amp) >> 28
        var v: u64 = m
        if sine_neg(ph) {
            v = 65536 -% m
        }
        if v > 65535 {
            v = 65535
        }
        kstate.set8(buf + i * 4, (v & 0xFF) as u8)
        kstate.set8(buf + i * 4 + 1, ((v >> 8) & 0xFF) as u8)
        kstate.set8(buf + i * 4 + 2, (v & 0xFF) as u8)
        kstate.set8(buf + i * 4 + 3, ((v >> 8) & 0xFF) as u8)
        ph = (ph +% step) & 0xFFFFFFFF
        i = i + 1
    }
    return ph
}

fn phase(state: u64) -> u64 {
    return g(state, L_PHASE)
}

fn set_phase(state: u64, v: u64) {
    s(state, L_PHASE, v)
}

fn phase_step(state: u64, freq: u64) -> u64 {
    let r: u64 = rate(state)
    if r == 0 {
        return 0
    }
    return (freq * 4294967296 + r / 2) / r
}

const SCRATCH_FRAMES: u64 = 448

fn scratch(state: u64) -> u64 {
    return state + kstate.AUD_OFF + 0x900
}

fn tone_push(state: u64, freq: u64, amp: u64, max_frames: u64) -> u64 {
    if !hw_ready(state) {
        return 0
    }
    var n: u64 = space_frames(state)
    if n > max_frames {
        n = max_frames
    }
    if n > SCRATCH_FRAMES {
        n = SCRATCH_FRAMES
    }
    if n == 0 {
        return 0
    }
    let scratch: u64 = state + kstate.AUD_OFF + 0x900
    let ph: u64 = tone_into(state, scratch, n, freq, amp, g(state, L_PHASE))
    let got: u64 = write_kernel(state, scratch, n)
    if got == n {
        s(state, L_PHASE, ph)
    } else {
        s(state, L_PHASE, g(state, L_PHASE) +% got * phase_step(state, freq))
    }
    return got
}

fn tone(state: u64, freq: u64, ms: u64, amp: u64) -> u64 {
    if !hw_ready(state) {
        return 0
    }
    let want: u64 = rate(state) * ms / 1000
    let deadline: u64 = time.mono_ns(state) +% (ms + 2000) * 1000000
    var done: u64 = 0
    var give_up: bool = false
    while done < want && !give_up {
        let got: u64 = tone_push(state, freq, amp, want -% done)
        done = done + got
        if got == 0 {
            arch.pause()
            if time.mono_ns(state) > deadline {
                give_up = true
            }
        }
    }
    return done
}

// ==================================================== die Systemklaenge
const BEEP_HZ: u64 = 880
const BEEP_MS: u64 = 90
const BEEP_AMP: u64 = 6000

fn beep(state: u64, freq: u64, ms: u64) -> bool {
    if !hw_ready(state) {
        return false
    }
    if !sounds_on(state) {
        return false
    }
    s(state, L_BEEPS, g(state, L_BEEPS) + 1)
    if g(state, L_OPEN) != 0 {
        return false // jemand spielt gerade; kein Dazwischenfunken
    }
    reset(state)
    let n: u64 = tone(state, freq, ms, BEEP_AMP)
    pad_and_submit(state)
    return n > 0
}

fn error_beep(state: u64) -> bool {
    return beep(state, BEEP_HZ, BEEP_MS)
}

const LOCK_STUCK: u64 = 60000000

fn lock_addr(state: u64) -> u64 {
    return state + kstate.AUD_OFF + L_OFF + L_LOCK
}

fn hold(state: u64) -> u64 {
    let flags: u64 = asm("pushfq\npop rax\ncli", out("rax"))
    let a: u64 = lock_addr(state)
    let me: u64 = cpu.here(state) + 1
    var spins: u64 = 0
    while atomic.cas(a, 0, me) != 0 {
        atomic.pause()
        spins = spins + 1
        if spins > LOCK_STUCK {
            var s_st: [u8; 23] = "aud: lock stuck owner=\0"
            serial.puts((&s_st[0]) as u64)
            serial.dec(atomic.load(a))
            serial.nl()
            spins = 0
        }
    }
    if spins > 0 {
        s(state, L_LOCKSPIN, g(state, L_LOCKSPIN) + spins)
    }
    return flags
}

fn drop(state: u64, flags: u64) {
    atomic.store(lock_addr(state), 0)
    if (flags & 0x200) != 0 {
        asm("sti")
    }
}

fn try_hold(state: u64) -> bool {
    return atomic.cas(lock_addr(state), 0, cpu.here(state) + 1) == 0
}

fn release(state: u64) {
    atomic.store(lock_addr(state), 0)
}

fn lock_spins(state: u64) -> u64 {
    return g(state, L_LOCKSPIN)
}

fn tick_skips(state: u64) -> u64 {
    return g(state, L_TICKSKIP)
}

fn min_fill(state: u64) -> u64 {
    return g(state, L_MINFILL)
}

const SND_CLICK: u64 = 0
const SND_NOTE: u64 = 1
const SND_ERROR: u64 = 2

fn tone_env_into(state: u64, buf: u64, frames: u64, freq: u64, amp: u64,
    phase0: u64, at: u64, total: u64) -> u64 {
    let r: u64 = rate(state)
    if r == 0 {
        return phase0
    }
    let step: u64 = (freq * 4294967296 + r / 2) / r
    let attack: u64 = r * 2 / 1000
    let decay: u64 = total / 4
    var ph: u64 = phase0
    var i: u64 = 0
    while i < frames {
        let k: u64 = at + i
        var a: u64 = amp
        if k < attack && attack > 0 {
            a = (amp * (k + 1)) / attack
        }
        if k + decay >= total && decay > 0 {
            let rest: u64 = total -% k
            let b: u64 = (amp * rest) / decay
            if b < a {
                a = b
            }
        }
        let m: u64 = (sine_q28(ph) * a) >> 28
        var v: u64 = m
        if sine_neg(ph) {
            v = 65536 -% m
        }
        if v > 65535 {
            v = 65535
        }
        __mmio_write32((buf + i * 4) as *mut u32,
            ((v & 0xFFFF) | ((v & 0xFFFF) << 16)) as u32)
        ph = (ph +% step) & 0xFFFFFFFF
        i = i + 1
    }
    return ph
}

fn sound_tone(state: u64, id: u64, freq: u64, ms: u64, amp: u64) -> u64 {
    let total: u64 = rate(state) * ms / 1000
    let buf: u64 = scratch(state)
    var done: u64 = 0
    var ph: u64 = g(state, L_SNDPH)
    var keep_going: bool = true
    while done < total && keep_going {
        var n: u64 = total -% done
        if n > SCRATCH_FRAMES {
            n = SCRATCH_FRAMES
        }
        ph = tone_env_into(state, buf, n, freq, amp, ph, done, total)
        let got: u64 = mix.write(state, id, buf, n)
        done = done + got
        if got < n {
            keep_going = false
        }
    }
    s(state, L_SNDPH, 0)
    return done
}

fn sys_sound(state: u64, kind: u64) -> bool {
    if !hw_ready(state) {
        return false
    }
    if !sounds_on(state) {
        return false
    }
    if kind == SND_CLICK && g(state, L_CLICKS) == 0 {
        return false
    }
    s(state, L_BEEPS, g(state, L_BEEPS) + 1)
    if g(state, L_OPEN) != 0 {
        return false
    }
    let id: u64 = open_stream(state, 0, rate(state))
    if id >= mix.MAX_STREAMS {
        return false
    }
    var n: u64 = 0
    if kind == SND_CLICK {
        n = sound_tone(state, id, 1200, 14, 3300)
    } else if kind == SND_NOTE {
        n = sound_tone(state, id, 660, 70, 6000)
        n = n + sound_tone(state, id, 880, 110, 6000)
    } else {
        n = sound_tone(state, id, BEEP_HZ, BEEP_MS, BEEP_AMP)
    }
    end_stream(state, id)
    s(state, L_SYSSND, g(state, L_SYSSND) + 1)
    return n > 0
}

fn click(state: u64) -> bool {
    if g(state, L_BACKEND) == B_NONE || g(state, L_CLICKS) == 0 {
        return false
    }
    let f: u64 = hold(state)
    let ok: bool = sys_sound(state, SND_CLICK)
    drop(state, f)
    return ok
}

fn sys_sounds(state: u64) -> u64 {
    return g(state, L_SYSSND)
}

fn close_pid(state: u64, pid: u64) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < mix.MAX_STREAMS {
        if mix.is_open(state, i) && mix.pid_of(state, i) == pid && pid != 0 {
            close_stream(state, i)
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// ==================================================== DER MISCHERWEG

fn open_stream(state: u64, pid: u64, hz: u64) -> u64 {
    if !hw_ready(state) {
        return mix.NONE
    }
    if g(state, L_OPEN) != 0 {
        return mix.NONE
    }
    if mix.streams(state) == 0 {
        if rates_ok(state, hz) {
            hw_stop(state)
            s(state, L_STARTED, 0)
            set_rate(state, hz)
        }
        reset(state)
    }
    let id: u64 = mix.open(state, pid, hz)
    return id
}

fn write_stream(state: u64, id: u64, src: u64, frames: u64) -> u64 {
    let n: u64 = mix.write(state, id, src, frames)
    mix_pump(state)
    return n
}

fn end_stream(state: u64, id: u64) {
    mix.mark_end(state, id)
    mix_pump(state)
    if g(state, L_STARTED) == 0 && g(state, L_WPOS) > 0 {
        if hw_start(state) {
            s(state, L_STARTED, 1)
        }
    }
    hw_drain_mark(state)
}

fn close_stream(state: u64, id: u64) {
    mix.close(state, id)
    if mix.streams(state) == 0 {
        zero_all(state)
        hw_drain_mark(state)
        hw_stop(state)
        s(state, L_STARTED, 0)
    }
}

fn mix_pump(state: u64) -> u64 {
    if !hw_ready(state) {
        return 0
    }
    mix.reap(state)
    if mix.streams(state) == 0 {
        return 0
    }
    if g(state, L_OPEN) != 0 {
        return 0
    }
    catch_up(state)
    var gesamt: u64 = 0
    var keep_going: bool = true
    while keep_going {
        let space_room: u64 = space_frames(state)
        if space_room == 0 {
            keep_going = false
        } else {
            let reserve: u64 = remaining(state)
            let emergency: bool = reserve < hw_entry_frames(state) * 8
            let n: u64 = mix.mix_into(state, space_room, rate(state), emergency)
            if n == 0 {
                keep_going = false
            } else {
                let got: u64 = write_kernel(state, mix.out_buf(state), n)
                gesamt = gesamt + got
                if got < n {
                    keep_going = false
                }
            }
        }
    }
    return gesamt
}

// ================================ RUNDE TON: DIE MESSSTRECKE
fn mark_write(state: u64) -> u64 {
    let now_ns: u64 = time.mono_ns(state)
    let before: u64 = g(state, L_LASTNS)
    if before != 0 {
        let d: u64 = (now_ns -% before) / 1000
        if d > g(state, L_GAPMAX) {
            s(state, L_GAPMAX, d)
        }
    } else {
        s(state, L_FIRSTNS, now_ns)
    }
    s(state, L_LASTNS, now_ns)
    s(state, L_CALLS, g(state, L_CALLS) + 1)
    return now_ns
}

fn mark_done(state: u64, since: u64) {
    let now_ns: u64 = time.mono_ns(state)
    s(state, L_SYSUS, g(state, L_SYSUS) +% ((now_ns -% since) / 1000))
    s(state, L_LASTNS, now_ns)
}

fn gap_max(state: u64) -> u64 {
    return g(state, L_GAPMAX)
}

fn sys_us(state: u64) -> u64 {
    return g(state, L_SYSUS)
}

fn wall_us(state: u64) -> u64 {
    let f: u64 = g(state, L_FIRSTNS)
    if f == 0 {
        return 0
    }
    return (g(state, L_LASTNS) -% f) / 1000
}

fn calls(state: u64) -> u64 {
    return g(state, L_CALLS)
}

fn metrics_reset(state: u64) {
    s(state, L_LASTNS, 0)
    s(state, L_GAPMAX, 0)
    s(state, L_SYSUS, 0)
    s(state, L_FIRSTNS, 0)
    s(state, L_CALLS, 0)
}
