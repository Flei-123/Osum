
profile kernel

import lib.kstate

export {
    cd_reset, cd_frame, cd_reject, cd_seen,
    cd_frames, cd_rejects, cd_lasterr, cd_w, cd_h, cd_profile, cd_mb
}

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state, kstate.CODEC_OFF + off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state, kstate.CODEC_OFF + off, v)
}

fn cd_reset(state: u64) {
    s(state, kstate.CD_FRAMES, 0)
    s(state, kstate.CD_REJECT, 0)
    s(state, kstate.CD_LASTERR, 0)
    s(state, kstate.CD_W, 0)
    s(state, kstate.CD_H, 0)
    s(state, kstate.CD_PROFILE, 0)
    s(state, kstate.CD_MB, 0)
}

fn cd_frame(state: u64) {
    s(state, kstate.CD_FRAMES, g(state, kstate.CD_FRAMES) + 1)
}

fn cd_reject(state: u64, reason: u64) {
    s(state, kstate.CD_REJECT, g(state, kstate.CD_REJECT) + 1)
    s(state, kstate.CD_LASTERR, reason)
}

fn cd_seen(state: u64, w: u64, h: u64, profil: u64, mb: u64) {
    s(state, kstate.CD_W, w)
    s(state, kstate.CD_H, h)
    s(state, kstate.CD_PROFILE, profil)
    s(state, kstate.CD_MB, mb)
}

fn cd_frames(state: u64) -> u64 { return g(state, kstate.CD_FRAMES) }
fn cd_rejects(state: u64) -> u64 { return g(state, kstate.CD_REJECT) }
fn cd_lasterr(state: u64) -> u64 { return g(state, kstate.CD_LASTERR) }
fn cd_w(state: u64) -> u64 { return g(state, kstate.CD_W) }
fn cd_h(state: u64) -> u64 { return g(state, kstate.CD_H) }
fn cd_profile(state: u64) -> u64 { return g(state, kstate.CD_PROFILE) }
fn cd_mb(state: u64) -> u64 { return g(state, kstate.CD_MB) }
