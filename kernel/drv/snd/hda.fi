const P_FGTYPE: u64 = 0x05
const P_WCAP: u64 = 0x09
const P_PCMSIZE: u64 = 0x0A
const P_PINCAP: u64 = 0x0C
const P_INAMP: u64 = 0x0D
const P_CONNLEN: u64 = 0x0E
const P_OUTAMP: u64 = 0x12

// Knotenarten (AWCAP Bits 20..23).
const T_AUDIO_OUT: u64 = 0
const T_AUDIO_IN: u64 = 1
const T_MIXER: u64 = 2
const T_SELECTOR: u64 = 3
const T_PIN: u64 = 4

const WCAP_STEREO: u64 = 0x001
const WCAP_INAMP: u64 = 0x002
const WCAP_OUTAMP: u64 = 0x004
const WCAP_AMPOVR: u64 = 0x008
const WCAP_FMTOVR: u64 = 0x010
const WCAP_DIGITAL: u64 = 0x200
const WCAP_CONNLIST: u64 = 0x100
const WCAP_POWER: u64 = 0x400

const PINCAP_OUT: u64 = 0x10
const PINCAP_HP: u64 = 0x08
const PINCAP_EAPD: u64 = 0x10000

const PINCTL_OUT: u64 = 0x40
const PINCTL_HP: u64 = 0x80

const SPIN_LIMIT: u64 = 500000

// ------------------------------------------------------ kleine Helfer

fn g(state: u64, off: u64) -> u64 {
    return kstate.get(state + kstate.HDA_OFF, off)
}

fn s(state: u64, off: u64, v: u64) {
    kstate.set(state + kstate.HDA_OFF, off, v)
}

fn base(state: u64) -> u64 {
    return g(state, S_BASE)
}

fn rd8(state: u64, off: u64) -> u64 {
    return __mmio_read8((base(state) + off) as *mut u8) as u64
}

fn wr8(state: u64, off: u64, v: u64) {
    __mmio_write8((base(state) + off) as *mut u8, (v & 0xFF) as u8)
}

fn rd16(state: u64, off: u64) -> u64 {
    return __mmio_read16((base(state) + off) as *mut u16) as u64
}

fn wr16(state: u64, off: u64, v: u64) {
    __mmio_write16((base(state) + off) as *mut u16, (v & 0xFFFF) as u16)
}

fn rd32(state: u64, off: u64) -> u64 {
    return __mmio_read32((base(state) + off) as *mut u32) as u64
}

fn wr32(state: u64, off: u64, v: u64) {
    __mmio_write32((base(state) + off) as *mut u32, (v & 0xFFFFFFFF) as u32)
}

fn sd(state: u64) -> u64 {
    return SD_BASE + g(state, S_OSTREAM) * SD_SPAN
}

fn sdrd8(state: u64, off: u64) -> u64 {
    return rd8(state, sd(state) + off)
}

fn sdwr8(state: u64, off: u64, v: u64) {
    wr8(state, sd(state) + off, v)
}

fn sdrd16(state: u64, off: u64) -> u64 {
    return rd16(state, sd(state) + off)
}

fn sdwr16(state: u64, off: u64, v: u64) {
    wr16(state, sd(state) + off, v)
}

fn sdrd32(state: u64, off: u64) -> u64 {
    return rd32(state, sd(state) + off)
}

fn sdwr32(state: u64, off: u64, v: u64) {
    wr32(state, sd(state) + off, v)
}

fn corb(state: u64) -> u64 {
    return state + kstate.HDAR_OFF + CORB_OFF
}

fn rirb(state: u64) -> u64 {
    return state + kstate.HDAR_OFF + RIRB_OFF
}

fn bdl(state: u64) -> u64 {
    return state + kstate.HDA_OFF + BDL_OFF
}

fn dpib_base(state: u64) -> u64 {
    return state + kstate.HDA_OFF + DPIB_OFF
}

fn dpib_addr(state: u64) -> u64 {
    return dpib_base(state) + g(state, S_OSTREAM) * 8
}

fn wtab(state: u64, nid: u64) -> u64 {
    return state + kstate.HDAB_OFF + nid * NODE_SPAN
}

fn udelay(state: u64, us: u64) {
    let until_ns: u64 = time.mono_ns(state) +% us * 1000
    while time.mono_ns(state) < until_ns {
        arch.pause()
    }
}

// ------------------------------------------------------- die Auskunft

fn present(state: u64) -> bool {
    return g(state, S_BASE) != 0
}

fn ready(state: u64) -> bool {
    return g(state, S_READY) != 0
}

fn why(state: u64) -> u64 {
    return g(state, S_WHY)
}

fn bdf(state: u64) -> u64 {
    return g(state, S_BDF)
}

fn running(state: u64) -> bool {
    return g(state, S_RUNNING) != 0
}

fn ring_base(state: u64) -> u64 {
    return g(state, S_RING)
}

fn ring_octets(state: u64) -> u64 {
    return RING_OCTETS
}

fn ring_frames(state: u64) -> u64 {
    return RING_FRAMES
}

fn entries(state: u64) -> u64 {
    return ENTRIES
}

fn entry_frames(state: u64) -> u64 {
    return ENTRY_FRAMES
}

fn entry_octets(state: u64) -> u64 {
    return ENTRY_OCTETS
}

fn channels(state: u64) -> u64 {
    return CHANNELS
}

fn bits(state: u64) -> u64 {
    return BITS
}

fn rate(state: u64) -> u64 {
    let r: u64 = g(state, S_RATE)
    if r == 0 {
        return RATE
    }
    return r
}

fn underruns(state: u64) -> u64 {
    return g(state, S_UNDER)
}

fn submits(state: u64) -> u64 {
    return g(state, S_SUBMITS)
}

fn starts(state: u64) -> u64 {
    return g(state, S_STARTS)
}

fn stops(state: u64) -> u64 {
    return g(state, S_STOPS)
}

fn irqs(state: u64) -> u64 {
    return g(state, S_IRQS)
}

fn backsteps(state: u64) -> u64 {
    return g(state, S_BACKW)
}

fn submitted_frames(state: u64) -> u64 {
    return g(state, S_SUBMITTED)
}

fn codec_ready(state: u64) -> bool {
    return g(state, S_STATESTS) != 0
}

fn codec_addr(state: u64) -> u64 {
    return g(state, S_CAD)
}

fn vendor(state: u64) -> u64 {
    return g(state, S_VENDOR)
}

fn device(state: u64) -> u64 {
    return g(state, S_DEVICE)
}

fn revision(state: u64) -> u64 {
    return g(state, S_REV)
}

fn dac_nid(state: u64) -> u64 {
    return g(state, S_DAC)
}

fn pin_nid(state: u64) -> u64 {
    return g(state, S_PIN)
}

fn path_len(state: u64) -> u64 {
    return g(state, S_PLEN)
}

fn path_at(state: u64, i: u64) -> u64 {
    if i > 3 {
        return 0
    }
    return (g(state, S_PATH) >> (i * 16)) & 0xFFFF
}

fn out_stream(state: u64) -> u64 {
    return g(state, S_OSTREAM)
}

fn stream_tag(state: u64) -> u64 {
    return g(state, S_TAG)
}

fn cmd_path(state: u64) -> u64 {
    return g(state, S_CMDPATH)
}

fn cmd_fails(state: u64) -> u64 {
    return g(state, S_CMDFAIL)
}

fn widgets(state: u64) -> u64 {
    return g(state, S_WCOUNT)
}

fn wstart(state: u64) -> u64 {
    return g(state, S_WSTART)
}

fn pos_disagree(state: u64) -> u64 {
    return g(state, S_DISAGREE)
}

fn volume(state: u64) -> u64 {
    return g(state, S_VOL)
}

fn muted(state: u64) -> bool {
    return g(state, S_MUTE) != 0
}

fn irq_armed(state: u64) -> bool {
    return g(state, S_IRQON) != 0
}

fn wslot(state: u64, nid: u64) -> u64 {
    let st: u64 = g(state, S_WSTART)
    if nid < st {
        return MAX_NODES
    }
    let i: u64 = nid -% st
    if i >= MAX_NODES || i >= g(state, S_WCOUNT) {
        return MAX_NODES
    }
    return i
}

fn node_caps(state: u64, nid: u64) -> u64 {
    let i: u64 = wslot(state, nid)
    if i >= MAX_NODES {
        return 0
    }
    return kstate.get(wtab(state, i), W_CAPS)
}

fn node_type(state: u64, nid: u64) -> u64 {
    return (node_caps(state, nid) >> 20) & 0xF
}

fn node_cfg(state: u64, nid: u64) -> u64 {
    let i: u64 = wslot(state, nid)
    if i >= MAX_NODES {
        return 0
    }
    return kstate.get(wtab(state, i), W_CFG)
}

fn node_pincap(state: u64, nid: u64) -> u64 {
    let i: u64 = wslot(state, nid)
    if i >= MAX_NODES {
        return 0
    }
    return kstate.get(wtab(state, i), W_PIN)
}

fn node_amp(state: u64, nid: u64) -> u64 {
    let i: u64 = wslot(state, nid)
    if i >= MAX_NODES {
        return 0
    }
    return kstate.get(wtab(state, i), W_AMP)
}

fn node_nconn(state: u64, nid: u64) -> u64 {
    let i: u64 = wslot(state, nid)
    if i >= MAX_NODES {
        return 0
    }
    return kstate.get(wtab(state, i), W_NCONN)
}

fn node_conn(state: u64, nid: u64, k: u64) -> u64 {
    if k >= 8 {
        return 0
    }
    let i: u64 = wslot(state, nid)
    if i >= MAX_NODES {
        return 0
    }
    let w: u64 = kstate.get(wtab(state, i), W_CONN + (k / 4) * 8)
    return (w >> ((k % 4) * 16)) & 0xFFFF
}

const NO_ANSWER: u64 = 0xFFFFFFFF

fn verb12(cad: u64, nid: u64, v: u64, payload: u64) -> u64 {
    return ((cad & 0xF) << 28) | ((nid & 0xFF) << 20)
        | ((v & 0xFFF) << 8) | (payload & 0xFF)
}

fn verb4(cad: u64, nid: u64, v: u64, payload: u64) -> u64 {
    return ((cad & 0xF) << 28) | ((nid & 0xFF) << 20)
        | ((v & 0xF) << 16) | (payload & 0xFFFF)
}

// ------------------------------------------------------- der Ringweg

fn corb_rirb(state: u64, word: u64) -> u64 {
    let b: u64 = base(state)
    var rp: u64 = g(state, S_RIRBRP)
    let wp0: u64 = rd16(state, R_RIRBWP) & 0xFF
    if wp0 != rp {
        s(state, S_LOSTRESP, g(state, S_LOSTRESP) +% 1)
        rp = wp0
        s(state, S_RIRBRP, rp)
    }

    let wp: u64 = (rd16(state, R_CORBWP) + 1) % CORB_ENTRIES
    __mmio_write32((corb(state) + wp * 4) as *mut u32,
        (word & 0xFFFFFFFF) as u32)
    arch.barrier_write()
    wr16(state, R_CORBWP, wp)

    let deadline: u64 = time.mono_ns(state) +% 100000000
    var got: bool = false
    var resp: u64 = NO_ANSWER
    while !got && time.mono_ns(state) < deadline {
        let nw: u64 = rd16(state, R_RIRBWP) & 0xFF
        if nw != rp {
            let nrp: u64 = (rp + 1) % RIRB_ENTRIES
            arch.barrier_read()
            resp = __mmio_read32((rirb(state) + nrp * 8) as *mut u32) as u64
            let ex: u64 = __mmio_read32((rirb(state) + nrp * 8 + 4)
                as *mut u32) as u64
            s(state, S_RIRBRP, nrp)
            if (ex & 0x10) == 0 {
                got = true
            } else {
                s(state, S_LOSTRESP, g(state, S_LOSTRESP) +% 1)
                rp = nrp
            }
        } else {
            arch.pause()
        }
    }
    wr8(state, R_RIRBSTS, rd8(state, R_RIRBSTS))
    if !got {
        s(state, S_CMDFAIL, g(state, S_CMDFAIL) +% 1)
        return NO_ANSWER
    }
    return resp & 0xFFFFFFFF
}

fn immediate(state: u64, word: u64) -> u64 {
    var n: u64 = 0
    var free: bool = false
    while n < SPIN_LIMIT && !free {
        if (rd16(state, R_ICIS) & ICIS_BUSY) == 0 {
            free = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    if !free {
        s(state, S_CMDFAIL, g(state, S_CMDFAIL) +% 1)
        return NO_ANSWER
    }
    wr16(state, R_ICIS, ICIS_VALID)
    wr32(state, R_ICOI, word)
    wr16(state, R_ICIS, ICIS_BUSY)
    n = 0
    var seen: bool = false
    while n < SPIN_LIMIT && !seen {
        let st: u64 = rd16(state, R_ICIS)
        if (st & (ICIS_VALID | ICIS_BUSY)) == ICIS_VALID {
            seen = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    if !seen {
        s(state, S_CMDFAIL, g(state, S_CMDFAIL) +% 1)
        return NO_ANSWER
    }
    return rd32(state, R_ICII)
}

fn cmd(state: u64, cad: u64, nid: u64, v: u64, payload: u64) -> u64 {
    if !present(state) {
        return NO_ANSWER
    }
    s(state, S_CMDS, g(state, S_CMDS) +% 1)
    var word: u64 = 0
    if v > 0xF {
        word = verb12(cad, nid, v, payload)
    } else {
        word = verb4(cad, nid, v, payload)
    }
    if g(state, S_CMDPATH) == P_IMMEDIATE {
        return immediate(state, word)
    }
    return corb_rirb(state, word)
}

fn param(state: u64, cad: u64, nid: u64, p: u64) -> u64 {
    return cmd(state, cad, nid, V_GET_PARAM, p)
}

fn controller_reset(state: u64) -> bool {
    wr32(state, R_INTCTL, 0)
    wr8(state, R_CORBCTL, 0)
    wr8(state, R_RIRBCTL, 0)

    wr32(state, R_GCTL, rd32(state, R_GCTL) & 0xFFFFFFFE)
    var n: u64 = 0
    var went_low: bool = false
    while n < SPIN_LIMIT && !went_low {
        if (rd32(state, R_GCTL) & GCTL_CRST) == 0 {
            went_low = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    if !went_low {
        return false
    }
    // Die Spezifikation verlangt mindestens 100 us Ruhe.
    udelay(state, 200)

    wr32(state, R_GCTL, rd32(state, R_GCTL) | GCTL_CRST)
    n = 0
    var went_high: bool = false
    while n < SPIN_LIMIT && !went_high {
        if (rd32(state, R_GCTL) & GCTL_CRST) != 0 {
            went_high = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    if !went_high {
        return false
    }
    udelay(state, 1000)
    return true
}

fn corb_setup(state: u64) -> bool {
    let b: u64 = corb(state)
    wr8(state, R_CORBSIZE, (rd8(state, R_CORBSIZE) & 0xFC) | SIZE_256)
    wr32(state, R_CORBLBASE, b & 0xFFFFFFFF)
    wr32(state, R_CORBUBASE, (b >> 32) & 0xFFFFFFFF)
    wr16(state, R_CORBRP, RP_RST)
    var n: u64 = 0
    var seen: bool = false
    while n < SPIN_LIMIT && !seen {
        if (rd16(state, R_CORBRP) & RP_RST) != 0 {
            seen = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    wr16(state, R_CORBRP, 0)
    n = 0
    var went_away: bool = false
    while n < SPIN_LIMIT && !went_away {
        if (rd16(state, R_CORBRP) & RP_RST) == 0 {
            went_away = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    wr16(state, R_CORBWP, 0)

    // Der Antwortring.
    let r: u64 = rirb(state)
    wr8(state, R_RIRBSIZE, (rd8(state, R_RIRBSIZE) & 0xFC) | SIZE_256)
    wr32(state, R_RIRBLBASE, r & 0xFFFFFFFF)
    wr32(state, R_RIRBUBASE, (r >> 32) & 0xFFFFFFFF)
    wr16(state, R_RIRBWP, WP_RST)
    wr16(state, R_RINTCNT, 1)
    s(state, S_RIRBRP, 0)

    wr8(state, R_CORBCTL, CORBCTL_RUN)
    wr8(state, R_RIRBCTL, RIRBCTL_RUN | RIRBCTL_INT)
    var i: u64 = 0
    while i < RIRB_ENTRIES {
        __mmio_write64((r + i * 8) as *mut u64, 0)
        i = i + 1
    }
    return went_away && seen
}

fn pick_path(state: u64, cad: u64) -> bool {
    s(state, S_CMDPATH, P_CORB)
    let v: u64 = param(state, cad, 0, P_VENDOR)
    if v != NO_ANSWER && v != 0 {
        s(state, S_VENDOR, v >> 16)
        s(state, S_DEVICE, v & 0xFFFF)
        return true
    }
    s(state, S_CMDPATH, P_IMMEDIATE)
    let v2: u64 = param(state, cad, 0, P_VENDOR)
    if v2 != NO_ANSWER && v2 != 0 {
        s(state, S_VENDOR, v2 >> 16)
        s(state, S_DEVICE, v2 & 0xFFFF)
        return true
    }
    return false
}

fn read_conns(state: u64, cad: u64, nid: u64, slot: u64) {
    let caps: u64 = kstate.get(wtab(state, slot), W_CAPS)
    if (caps & WCAP_CONNLIST) == 0 {
        kstate.set(wtab(state, slot), W_NCONN, 0)
        return
    }
    let cl: u64 = param(state, cad, nid, P_CONNLEN)
    if cl == NO_ANSWER {
        kstate.set(wtab(state, slot), W_NCONN, 0)
        return
    }
    let is_long: bool = (cl & 0x80) != 0
    let n: u64 = cl & 0x7F
    kstate.set(wtab(state, slot), W_NCONN, n)
    if n == 0 {
        return
    }
    var idx: u64 = 0
    var read_count: u64 = 0
    var previous: u64 = 0
    while read_count < n && idx < 8 {
        var value: u64 = 0
        var is_range: bool = false
        if is_long {
            let r: u64 = cmd(state, cad, nid, V_GET_CONNLIST, read_count)
            if r == NO_ANSWER {
                read_count = n
            } else {
                let sub: u64 = read_count % 2
                let e: u64 = (r >> (sub * 16)) & 0xFFFF
                value = e & 0x7FFF
                is_range = (e & 0x8000) != 0
            }
        } else {
            let r: u64 = cmd(state, cad, nid, V_GET_CONNLIST,
                (read_count / 4) * 4)
            if r == NO_ANSWER {
                read_count = n
            } else {
                let sub: u64 = read_count % 4
                let e: u64 = (r >> (sub * 8)) & 0xFF
                value = e & 0x7F
                is_range = (e & 0x80) != 0
            }
        }
        if read_count < n {
            if is_range && idx > 0 {
                var k: u64 = previous + 1
                while k <= value && idx < 8 {
                    let off: u64 = W_CONN + (idx / 4) * 8
                    let sh: u64 = (idx % 4) * 16
                    let old: u64 = kstate.get(wtab(state, slot), off)
                    kstate.set(wtab(state, slot), off,
                        (old & ~(0xFFFF << sh)) | ((k & 0xFFFF) << sh))
                    idx = idx + 1
                    k = k + 1
                }
                previous = value
            } else {
                let off: u64 = W_CONN + (idx / 4) * 8
                let sh: u64 = (idx % 4) * 16
                let old: u64 = kstate.get(wtab(state, slot), off)
                kstate.set(wtab(state, slot), off,
                    (old & ~(0xFFFF << sh)) | ((value & 0xFFFF) << sh))
                idx = idx + 1
                previous = value
            }
            read_count = read_count + 1
        }
    }
}

fn walk_widgets(state: u64, cad: u64) -> bool {
    let nc: u64 = param(state, cad, 0, P_NODECOUNT)
    if nc == NO_ANSWER {
        return false
    }
    let fg_start: u64 = (nc >> 16) & 0xFF
    let fg_count: u64 = nc & 0xFF
    var afg: u64 = 0
    var i: u64 = 0
    while i < fg_count && afg == 0 {
        let nid: u64 = fg_start + i
        let t: u64 = param(state, cad, nid, P_FGTYPE)
        if t != NO_ANSWER && (t & 0x7F) == 1 {
            afg = nid
        }
        i = i + 1
    }
    if afg == 0 {
        return false
    }
    s(state, S_AFG, afg)
    s(state, S_REV, param(state, cad, 0, P_REVISION))

    cmd(state, cad, afg, V_SET_PSTATE, 0)
    udelay(state, 1000)

    let wn: u64 = param(state, cad, afg, P_NODECOUNT)
    if wn == NO_ANSWER {
        return false
    }
    let ws: u64 = (wn >> 16) & 0xFF
    var wc: u64 = wn & 0xFF
    if wc > MAX_NODES {
        s(state, S_TOOMANY, wc -% MAX_NODES)
        wc = MAX_NODES
    }
    s(state, S_WSTART, ws)
    s(state, S_WCOUNT, wc)

    var pins: u64 = 0
    var dacs: u64 = 0
    var k: u64 = 0
    while k < wc {
        let nid: u64 = ws + k
        let caps: u64 = param(state, cad, nid, P_WCAP)
        var c: u64 = caps
        if c == NO_ANSWER {
            c = 0
        }
        kstate.set(wtab(state, k), W_CAPS, c)
        kstate.set(wtab(state, k), W_CFG, 0)
        kstate.set(wtab(state, k), W_PIN, 0)
        kstate.set(wtab(state, k), W_AMP, 0)
        kstate.set(wtab(state, k), W_NCONN, 0)
        kstate.set(wtab(state, k), W_CONN, 0)
        kstate.set(wtab(state, k), W_CONN + 8, 0)
        let t: u64 = (c >> 20) & 0xF
        if (c & WCAP_OUTAMP) != 0 {
            var a: u64 = 0
            if (c & WCAP_AMPOVR) != 0 {
                a = param(state, cad, nid, P_OUTAMP)
            } else {
                a = param(state, cad, afg, P_OUTAMP)
            }
            if a == NO_ANSWER {
                a = 0
            }
            kstate.set(wtab(state, k), W_AMP, a)
        }
        if t == T_PIN {
            var pc: u64 = param(state, cad, nid, P_PINCAP)
            if pc == NO_ANSWER {
                pc = 0
            }
            kstate.set(wtab(state, k), W_PIN, pc)
            var cf: u64 = cmd(state, cad, nid, V_GET_CFGDEF, 0)
            if cf == NO_ANSWER {
                cf = 0
            }
            kstate.set(wtab(state, k), W_CFG, cf)
            if (pc & PINCAP_OUT) != 0 && (c & WCAP_DIGITAL) == 0 {
                pins = pins + 1
            }
        }
        if t == T_AUDIO_OUT && (c & WCAP_DIGITAL) == 0 {
            dacs = dacs + 1
        }
        read_conns(state, cad, nid, k)
        k = k + 1
    }
    s(state, S_PINS, pins)
    s(state, S_DACS, dacs)
    return true
}

//   Bits 30..31  Anschluss:  0 Buchse, 1 NICHT VORHANDEN, 2 fest
//                            verdrahtet, 3 beides
//   Bits 24..27  Geraeteart: 0 Line Out, 1 Lautsprecher, 2 Kopfhoerer,
//                            3 CD, 4 SPDIF Out, 5 digital, ...
//   Bits 20..23  Steckerart
//   Bits 8..11   Zusammengehoerigkeit (Association)
//   Bits 4..7    Reihenfolge darin (Sequence)
fn pin_score(state: u64, nid: u64) -> u64 {
    let caps: u64 = node_caps(state, nid)
    if ((caps >> 20) & 0xF) != T_PIN {
        return 0
    }
    if (caps & WCAP_DIGITAL) != 0 {
        return 0
    }
    let pc: u64 = node_pincap(state, nid)
    if (pc & PINCAP_OUT) == 0 {
        return 0
    }
    let cfg: u64 = node_cfg(state, nid)
    let conn: u64 = (cfg >> 30) & 3
    if conn == 1 {
        return 0
    }
    let dev: u64 = (cfg >> 20) & 0xF
    var points: u64 = 0
    if dev == 0 {
        points = 400 // Line Out
    } else if dev == 1 {
        points = 380 // Lautsprecher
    } else if dev == 2 {
        points = 360 // Kopfhoerer
    } else {
        points = 1
    }
    if points > 1 {
        let seq: u64 = (cfg >> 4) & 0xF
        points = points -% seq
    }
    return points
}

fn seek_dac(state: u64, pin: u64) -> bool {
    let n0: u64 = node_nconn(state, pin)
    var i0: u64 = 0
    while i0 < n0 && i0 < 8 {
        let a: u64 = node_conn(state, pin, i0)
        let ta: u64 = node_type(state, a)
        if ta == T_AUDIO_OUT && (node_caps(state, a) & WCAP_DIGITAL) == 0 {
            s(state, S_PLEN, 2)
            s(state, S_PATH, (pin & 0xFFFF) | ((a & 0xFFFF) << 16))
            s(state, S_PIDX, i0 & 0xFFFF)
            s(state, S_DAC, a)
            return true
        }
        if ta == T_MIXER || ta == T_SELECTOR {
            let n1: u64 = node_nconn(state, a)
            var i1: u64 = 0
            while i1 < n1 && i1 < 8 {
                let b: u64 = node_conn(state, a, i1)
                let tb: u64 = node_type(state, b)
                if tb == T_AUDIO_OUT
                    && (node_caps(state, b) & WCAP_DIGITAL) == 0 {
                    s(state, S_PLEN, 3)
                    s(state, S_PATH, (pin & 0xFFFF) | ((a & 0xFFFF) << 16)
                        | ((b & 0xFFFF) << 32))
                    s(state, S_PIDX, (i0 & 0xFFFF) | ((i1 & 0xFFFF) << 16))
                    s(state, S_DAC, b)
                    return true
                }
                if tb == T_MIXER || tb == T_SELECTOR {
                    let n2: u64 = node_nconn(state, b)
                    var i2: u64 = 0
                    while i2 < n2 && i2 < 8 {
                        let c: u64 = node_conn(state, b, i2)
                        if node_type(state, c) == T_AUDIO_OUT
                            && (node_caps(state, c) & WCAP_DIGITAL) == 0 {
                            s(state, S_PLEN, 4)
                            s(state, S_PATH, (pin & 0xFFFF)
                                | ((a & 0xFFFF) << 16)
                                | ((b & 0xFFFF) << 32)
                                | ((c & 0xFFFF) << 48))
                            s(state, S_PIDX, (i0 & 0xFFFF)
                                | ((i1 & 0xFFFF) << 16)
                                | ((i2 & 0xFFFF) << 32))
                            s(state, S_DAC, c)
                            return true
                        }
                        i2 = i2 + 1
                    }
                }
                i1 = i1 + 1
            }
        }
        i0 = i0 + 1
    }
    return false
}

fn choose_path(state: u64) -> bool {
    let ws: u64 = g(state, S_WSTART)
    let wc: u64 = g(state, S_WCOUNT)
    var attempts: u64 = 0
    var finished: bool = false
    while !finished && attempts < wc {
        var best: u64 = 0
        var bestp: u64 = 0
        var k: u64 = 0
        while k < wc {
            let nid: u64 = ws + k
            let p: u64 = pin_score(state, nid)
            if p > bestp && !already_tried(state, nid) {
                bestp = p
                best = nid
            }
            k = k + 1
        }
        if bestp == 0 {
            return false
        }
        remember_try(state, best)
        if seek_dac(state, best) {
            s(state, S_PIN, best)
            finished = true
        }
        attempts = attempts + 1
    }
    return finished
}

const TRIED_OFF: u64 = 0x600

fn already_tried(state: u64, nid: u64) -> bool {
    let w: u64 = kstate.get(state + kstate.HDA_OFF,
        TRIED_OFF + (nid / 64) * 8)
    return (w & (1 << (nid % 64))) != 0
}

fn remember_try(state: u64, nid: u64) {
    let off: u64 = TRIED_OFF + (nid / 64) * 8
    let w: u64 = kstate.get(state + kstate.HDA_OFF, off)
    kstate.set(state + kstate.HDA_OFF, off, w | (1 << (nid % 64)))
}

fn amp_offset(cap: u64) -> u64 {
    return cap & 0x7F
}

fn amp_steps(cap: u64) -> u64 {
    return (cap >> 8) & 0x7F
}

fn set_out_amp(state: u64, cad: u64, nid: u64, gain: u64, mute: bool) {
    var p: u64 = 0xB000 | (gain & 0x7F)
    if mute {
        p = p | 0x80
    }
    cmd(state, cad, nid, V_SET_AMP, p)
}

fn set_in_amp(state: u64, cad: u64, nid: u64, idx: u64, gain: u64,
    mute: bool) {
    var p: u64 = 0x7000 | ((idx & 0xF) << 8) | (gain & 0x7F)
    if mute {
        p = p | 0x80
    }
    cmd(state, cad, nid, V_SET_AMP, p)
}

fn setup_path(state: u64) {
    let cad: u64 = g(state, S_CAD)
    let len: u64 = g(state, S_PLEN)
    let idxw: u64 = g(state, S_PIDX)
    var i: u64 = 0
    while i < len {
        let nid: u64 = path_at(state, i)
        let caps: u64 = node_caps(state, nid)
        if (caps & WCAP_POWER) != 0 {
            cmd(state, cad, nid, V_SET_PSTATE, 0)
        }
        if (caps & WCAP_OUTAMP) != 0 {
            let a: u64 = node_amp(state, nid)
            set_out_amp(state, cad, nid, amp_offset(a), false)
        }
        if i + 1 < len {
            let nxt: u64 = path_at(state, i + 1)
            let ncaps: u64 = node_caps(state, nid)
            if (ncaps & WCAP_INAMP) != 0 {
                let idx: u64 = (idxw >> (i * 16)) & 0xFFFF
                let n: u64 = node_nconn(state, nid)
                var k: u64 = 0
                while k < n && k < 8 {
                    set_in_amp(state, cad, nid, k, 0, true)
                    k = k + 1
                }
                set_in_amp(state, cad, nid, idx, 0, false)
            }
            if node_type(state, nid) == T_SELECTOR {
                let idx: u64 = (idxw >> (i * 16)) & 0xFFFF
                cmd(state, cad, nid, V_SET_CONNSEL, idx)
            }
        }
        i = i + 1
    }

    let pin: u64 = g(state, S_PIN)
    let pc: u64 = node_pincap(state, pin)
    var ctl: u64 = PINCTL_OUT
    if (pc & PINCAP_HP) != 0 {
        ctl = ctl | PINCTL_HP
    }
    cmd(state, cad, pin, V_SET_PINCTL, ctl)

    if (pc & PINCAP_EAPD) != 0 {
        cmd(state, cad, pin, V_SET_EAPD, 0x02)
        s(state, S_EAPD, 1)
    }

    let dac: u64 = g(state, S_DAC)
    let seen: u64 = node_amp(state, dac)
    s(state, S_AMPOFF, amp_offset(seen))
    s(state, S_AMPSTEPS, amp_steps(seen))
    if amp_steps(seen) == 0 {
        let pa: u64 = node_amp(state, pin)
        s(state, S_AMPOFF, amp_offset(pa))
        s(state, S_AMPSTEPS, amp_steps(pa))
    }
}

// ==================================================== DAS FORMAT
//
//     Bit 14      BASE   0 = 48 kHz, 1 = 44,1 kHz
//     Bits 11..13 MULT   Vervielfacher - 1
//     Bits 8..10  DIV    Teiler - 1
//     Bits 4..6   BITS   0=8, 1=16, 2=20, 3=24, 4=32
//     Bits 0..3   CHAN   Kanaele - 1
fn fmt_word(hz: u64) -> u64 {
    var f: u64 = 0x0011
    if hz == RATE_OLD {
        f = f | 0x4000
    }
    return f
}

fn set_rate(state: u64, hz: u64) -> bool {
    if !ready(state) {
        return false
    }
    if hz != RATE && hz != RATE_OLD {
        return false
    }
    if g(state, S_RUNNING) != 0 {
        return false
    }
    let f: u64 = fmt_word(hz)
    sdwr16(state, SD_FMT, f)
    cmd(state, g(state, S_CAD), g(state, S_DAC), V_SET_FORMAT, f)
    s(state, S_FMT, f)
    s(state, S_RATE, hz)
    return true
}

// ================================================ DIE STROMBESCHREIBUNG
const TAG: u64 = 1

fn stream_reset(state: u64) -> bool {
    sdwr8(state, SD_CTL, sdrd8(state, SD_CTL) & 0xFD)
    var n: u64 = 0
    var went_off: bool = false
    while n < SPIN_LIMIT && !went_off {
        if (sdrd8(state, SD_CTL) & SDCTL_RUN) == 0 {
            went_off = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    sdwr8(state, SD_CTL, sdrd8(state, SD_CTL) | SDCTL_SRST)
    n = 0
    var entered: bool = false
    while n < SPIN_LIMIT && !entered {
        if (sdrd8(state, SD_CTL) & SDCTL_SRST) != 0 {
            entered = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    udelay(state, 100)
    sdwr8(state, SD_CTL, sdrd8(state, SD_CTL) & 0xFE)
    n = 0
    var left_ok: bool = false
    while n < SPIN_LIMIT && !left_ok {
        if (sdrd8(state, SD_CTL) & SDCTL_SRST) == 0 {
            left_ok = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    udelay(state, 100)
    return entered && left_ok
}

fn bdl_fill(state: u64) {
    let ring: u64 = g(state, S_RING)
    let b: u64 = bdl(state)
    var i: u64 = 0
    while i < ENTRIES {
        let e: u64 = b + i * 16
        let a: u64 = ring + i * ENTRY_OCTETS
        __mmio_write32(e as *mut u32, (a & 0xFFFFFFFF) as u32)
        __mmio_write32((e + 4) as *mut u32, ((a >> 32) & 0xFFFFFFFF) as u32)
        __mmio_write32((e + 8) as *mut u32, (ENTRY_OCTETS & 0xFFFFFFFF) as u32)
        var ctl: u64 = 0
        if (i % IOC_EVERY) == (IOC_EVERY - 1) {
            ctl = 1
        }
        __mmio_write32((e + 12) as *mut u32, (ctl & 0xFFFFFFFF) as u32)
        i = i + 1
    }
    arch.barrier_write()
}

fn zero_ring(state: u64) {
    let r: u64 = g(state, S_RING)
    if r == 0 {
        return
    }
    var i: u64 = 0
    while i < RING_OCTETS / 8 {
        kstate.set(r, i * 8, 0)
        i = i + 1
    }
}

fn stream_setup(state: u64) -> bool {
    if !stream_reset(state) {
        return false
    }
    sdwr32(state, SD_CBL, RING_OCTETS)
    sdwr16(state, SD_LVI, ENTRIES - 1)
    let b: u64 = bdl(state)
    sdwr32(state, SD_BDPL, b & 0xFFFFFFFF)
    sdwr32(state, SD_BDPU, (b >> 32) & 0xFFFFFFFF)
    let f: u64 = fmt_word(rate(state))
    sdwr16(state, SD_FMT, f)
    s(state, S_FMT, f)
    wr8(state, sd(state) + 0x02, (TAG & 0xF) << 4)
    s(state, S_TAG, TAG)
    let cad: u64 = g(state, S_CAD)
    let dac: u64 = g(state, S_DAC)
    cmd(state, cad, dac, V_SET_FORMAT, f)
    cmd(state, cad, dac, V_SET_STREAM, (TAG << 4) | 0)
    sdwr8(state, SD_STS, SDSTS_BCIS | SDSTS_FIFOE | SDSTS_DESE)
    return true
}

// ============================================== LAUF AN, LAUF AUS, UHR

fn reset_box(state: u64) {
    s(state, S_SUBMITTED, 0)
    s(state, S_LASTRAW, 0)
    s(state, S_WRAPS, 0)
    s(state, S_POS, 0)
    s(state, S_POSBASE, 0)
    s(state, S_RUNNING, 0)
    s(state, S_BACKW, 0)
    s(state, S_UNDERN, 0)
    s(state, S_DRAIN, 0)
}

fn reset_box_pub(state: u64) {
    if !present(state) {
        return
    }
    stop(state)
    stream_reset(state)
    zero_ring(state)
    reset_box(state)
    stream_setup(state)
    kstate.set(dpib_addr(state), 0, 0)
}

fn start(state: u64) -> bool {
    if !ready(state) {
        return false
    }
    if g(state, S_RUNNING) != 0 {
        return true
    }
    kstate.set(dpib_addr(state), 0, 0)
    sdwr8(state, SD_STS, SDSTS_BCIS | SDSTS_FIFOE | SDSTS_DESE)
    sdwr32(state, SD_LPIB, 0)
    s(state, S_POSBASE, g(state, S_POS))
    s(state, S_WRAPS, 0)
    s(state, S_LASTRAW, 0)
    var ctl: u64 = sdrd8(state, SD_CTL) | SDCTL_RUN
    if g(state, S_IRQON) != 0 {
        ctl = ctl | SDCTL_IOCE
    }
    sdwr8(state, SD_CTL, ctl)
    var n: u64 = 0
    var is_running: bool = false
    while n < SPIN_LIMIT && !is_running {
        if (sdrd8(state, SD_CTL) & SDCTL_RUN) != 0 {
            is_running = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    if !is_running {
        return false
    }
    s(state, S_RUNNING, 1)
    s(state, S_STARTS, g(state, S_STARTS) + 1)
    return true
}

fn stop(state: u64) {
    if !present(state) {
        return
    }
    sdwr8(state, SD_CTL, sdrd8(state, SD_CTL) & 0xFC)
    var n: u64 = 0
    var went_off: bool = false
    while n < SPIN_LIMIT && !went_off {
        if (sdrd8(state, SD_CTL) & SDCTL_RUN) == 0 {
            went_off = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    s(state, S_RUNNING, 0)
    s(state, S_STOPS, g(state, S_STOPS) + 1)
}

fn submit(state: u64) -> bool {
    if !ready(state) {
        return false
    }
    s(state, S_SUBMITTED, g(state, S_SUBMITTED) + ENTRY_FRAMES)
    s(state, S_SUBMITS, g(state, S_SUBMITS) + 1)
    if g(state, S_SUBMITTED) > g(state, S_POS) {
        s(state, S_UNDERN, 0)
    }
    s(state, S_DRAIN, 0)
    return true
}

fn drain_mark(state: u64) {
    s(state, S_DRAIN, 1)
}

const LPIB_EVERY: u64 = 256

fn position_raw(state: u64) -> u64 {
    let dp: u64 = kstate.get32(dpib_addr(state)) % RING_OCTETS
    let counter: u64 = g(state, S_POSN) +% 1
    s(state, S_POSN, counter)
    if g(state, S_POSFIX) != 0 {
        return (sdrd32(state, SD_LPIB) % RING_OCTETS) / FRAME_OCTETS
    }
    if dp != 0 && (counter % LPIB_EVERY) != 0 {
        return dp / FRAME_OCTETS
    }
    let lp: u64 = sdrd32(state, SD_LPIB) % RING_OCTETS
    if g(state, S_POSFIX) == 0 {
        if dp == 0 && lp > ENTRY_OCTETS {
            s(state, S_POSFIX, 1)
        }
    }
    var d: u64 = 0
    if dp > lp {
        d = dp -% lp
    } else {
        d = lp -% dp
    }
    if d > ENTRY_OCTETS && d < RING_OCTETS -% ENTRY_OCTETS {
        s(state, S_DISAGREE, g(state, S_DISAGREE) +% 1)
    }
    return dp / FRAME_OCTETS
}

fn posfix(state: u64) -> u64 {
    return g(state, S_POSFIX)
}

fn lpib(state: u64) -> u64 {
    return sdrd32(state, SD_LPIB)
}

fn dpib(state: u64) -> u64 {
    return kstate.get32(dpib_addr(state))
}

fn position_frames(state: u64) -> u64 {
    if !ready(state) {
        return 0
    }
    if g(state, S_RUNNING) == 0 {
        return g(state, S_POS)
    }
    if g(state, S_GUARD) != 0 {
        return g(state, S_POS)
    }
    s(state, S_GUARD, 1)
    let raw: u64 = position_raw(state)
    var w: u64 = g(state, S_WRAPS)
    if raw < g(state, S_LASTRAW) {
        w = w + 1
        s(state, S_WRAPS, w)
    }
    s(state, S_LASTRAW, raw)
    var pos: u64 = g(state, S_POSBASE) + w * RING_FRAMES + raw
    let sub: u64 = g(state, S_SUBMITTED)
    if pos > sub {
        if g(state, S_DRAIN) == 0 {
            let empty: u64 = (pos -% sub) / ENTRY_FRAMES
            let counted: u64 = g(state, S_UNDERN)
            if empty > counted {
                s(state, S_UNDER, g(state, S_UNDER) +% (empty -% counted))
                s(state, S_UNDERN, empty)
            }
        }
    }
    if pos < g(state, S_POS) {
        pos = g(state, S_POS)
        s(state, S_BACKW, g(state, S_BACKW) + 1)
    }
    s(state, S_POS, pos)
    s(state, S_GUARD, 0)
    return pos
}

// ==================================================== DIE LAUTSTAERKE
fn apply_volume(state: u64) {
    if !ready(state) {
        return
    }
    let cad: u64 = g(state, S_CAD)
    let dac: u64 = g(state, S_DAC)
    let pin: u64 = g(state, S_PIN)
    let off: u64 = g(state, S_AMPOFF)
    let v: u64 = g(state, S_VOL)
    var gain: u64 = (off * v) / 100
    if gain > off {
        gain = off
    }
    let silent: bool = (v == 0) || (g(state, S_MUTE) != 0)
    if (node_caps(state, dac) & WCAP_OUTAMP) != 0
        && amp_steps(node_amp(state, dac)) != 0 {
        set_out_amp(state, cad, dac, gain, silent)
    } else if (node_caps(state, pin) & WCAP_OUTAMP) != 0 {
        set_out_amp(state, cad, pin, gain, silent)
    }
}

fn set_volume(state: u64, pct: u64) {
    var v: u64 = pct
    if v > 100 {
        v = 100
    }
    s(state, S_VOL, v)
    apply_volume(state)
}

fn set_muted(state: u64, on: bool) {
    if on {
        s(state, S_MUTE, 1)
    } else {
        s(state, S_MUTE, 0)
    }
    apply_volume(state)
}

// ================================================== DIE UNTERBRECHUNG
fn irq(state: u64) {
    if !present(state) {
        return
    }
    s(state, S_IRQS, g(state, S_IRQS) + 1)
    let sts: u64 = sdrd8(state, SD_STS)
    if sts != 0 {
        sdwr8(state, SD_STS, sts)
    }
    let gl: u64 = rd32(state, R_INTSTS)
    if (gl & 0x40000000) != 0 {
        wr8(state, R_RIRBSTS, rd8(state, R_RIRBSTS))
    }
}

fn arm_irq(state: u64, armed: bool) -> bool {
    if !ready(state) {
        return false
    }
    let d: u64 = bdf(state)
    pci.cfg_write16(d, 0x04, pci.cfg_read16(d, 0x04) & 0xFBFF)
    let idx: u64 = pci.find_bdf(state, d)
    if idx >= pci.MAX_DEV {
        return false
    }
    let gsi: u64 = pci.get(state, idx, pci.E_IRQLINE)
    if gsi == 0 || gsi > 23 {
        return false
    }
    apic.route(state, gsi, 42, apic.id(state), true, true)
    if !armed {
        apic.mask_gsi(state, gsi)
        wr32(state, R_INTCTL, 0)
        s(state, S_IRQON, 0)
        return false
    }
    wr32(state, R_INTCTL, INTCTL_GIE | (1 << g(state, S_OSTREAM)))
    sdwr8(state, SD_CTL, sdrd8(state, SD_CTL) | SDCTL_IOCE)
    s(state, S_IRQON, 1)
    return true
}

// ==================================================================
// AUFSETZEN
// ==================================================================

fn init(state: u64) -> bool {
    var s_head: [u8; 6] = "hda: \0"
    var s_no: [u8; 17] = "no device 04:03\0\0"
    var s_bar: [u8; 25] = "BAR0 missing or is port\0\0"
    var s_ring: [u8; 21] = "no ring buffer free\0\0"
    var s_rst: [u8; 27] = "controller stays in CRST\0\0\0"
    var s_cod: [u8; 24] = "no codec on link (0)\0\0\0\0"
    var s_afg: [u8; 26] = "no audio function group\0\0\0"
    var s_path: [u8; 33] = "no path converter -> jack\0\0\0\0\0\0\0\0"
    var s_str: [u8; 27] = "power does not come up\0\0\0\0\0"
    var s_ok: [u8; 6] = "ready\0"
    var s_id: [u8; 5] = " id=\0"
    var s_cad: [u8; 6] = " cad=\0"
    var s_w: [u8; 11] = " widgets=\0\0"
    var s_dac: [u8; 6] = " dac=\0"
    var s_pin: [u8; 6] = " pin=\0"
    var s_len: [u8; 7] = " len=\0\0"
    var s_str2: [u8; 6] = " sd=\0\0"
    var s_way: [u8; 8] = " path=\0\0"
    var s_ring2: [u8; 7] = " ring=\0"

    s(state, S_WHY, W_OK)
    s(state, S_VOL, 100)
    s(state, S_RATE, RATE)

    let idx: u64 = pci.find_class(state, 0x04, 0x03, 0x100)
    if idx >= pci.MAX_DEV {
        s(state, S_WHY, W_NODEV)
        serial.puts((&s_head[0]) as u64)
        serial.puts((&s_no[0]) as u64)
        serial.nl()
        return false
    }
    let d: u64 = pci.get(state, idx, pci.E_BDF)
    s(state, S_BDF, d)

    let phys: u64 = pci.bar(state, idx, 0)
    if phys == 0 || pci.bar_is_io(state, idx, 0) {
        s(state, S_WHY, W_NOBAR)
        serial.puts((&s_head[0]) as u64)
        serial.puts((&s_bar[0]) as u64)
        serial.nl()
        return false
    }
    let b: u64 = apic.map_device(state, phys)
    if b == 0 {
        s(state, S_WHY, W_NOBAR)
        return false
    }
    s(state, S_BASE, b)

    pci.enable_master(d)

    // 4. RUECKSETZEN.
    if !controller_reset(state) {
        s(state, S_WHY, W_NORESET)
        s(state, S_BASE, 0)
        serial.puts((&s_head[0]) as u64)
        serial.puts((&s_rst[0]) as u64)
        serial.nl()
        return false
    }
    let gcap: u64 = rd16(state, R_GCAP)
    s(state, S_GCAP, gcap)
    s(state, S_ISS, (gcap >> 8) & 0xF)
    s(state, S_OSS, (gcap >> 12) & 0xF)
    s(state, S_BSS, (gcap >> 3) & 0x1F)

    let st: u64 = rd16(state, R_STATESTS)
    s(state, S_STATESTS, st)
    if st == 0 {
        s(state, S_WHY, W_NOCODEC)
        s(state, S_BASE, 0)
        serial.puts((&s_head[0]) as u64)
        serial.puts((&s_cod[0]) as u64)
        serial.nl()
        return false
    }

    // 6. DIE BEFEHLSRINGE.
    corb_setup(state)

    var s_dbg: [u8; 12] = "hda: codec \0"
    var s_p: [u8; 4] = " p=\0"
    var s_w2: [u8; 4] = " w=\0"
    var s_c2: [u8; 4] = " c=\0"
    var s_ss: [u8; 14] = "hda: statests\0"
    let dbg: bool = kstate.mode_on(state, kstate.M_AUDGRAPH)
    if dbg {
        serial.puts((&s_ss[0]) as u64)
        serial.hex(st)
        serial.nl()
    }
    var cad: u64 = 0
    var finished: bool = false
    while cad < 15 && !finished {
        if (st & (1 << cad)) != 0 {
            s(state, S_CAD, cad)
            let okp: bool = pick_path(state, cad)
            var okw: bool = false
            var okc: bool = false
            if okp {
                okw = walk_widgets(state, cad)
                if okw {
                    okc = choose_path(state)
                    if okc {
                        finished = true
                    }
                }
            }
            if dbg {
                serial.puts((&s_dbg[0]) as u64)
                serial.dec(cad)
                serial.puts((&s_p[0]) as u64)
                serial.dec(yesno(okp))
                serial.puts((&s_w2[0]) as u64)
                serial.dec(yesno(okw))
                serial.puts((&s_c2[0]) as u64)
                serial.dec(yesno(okc))
                serial.nl()
                say_graph(state)
            }
        }
        if !finished {
            cad = cad + 1
        }
    }
    if !finished {
        if g(state, S_AFG) == 0 {
            s(state, S_WHY, W_NOAFG)
            serial.puts((&s_head[0]) as u64)
            serial.puts((&s_afg[0]) as u64)
        } else {
            s(state, S_WHY, W_NOPATH)
            serial.puts((&s_head[0]) as u64)
            serial.puts((&s_path[0]) as u64)
        }
        serial.nl()
        s(state, S_BASE, 0)
        return false
    }

    // r815: report the digital (HDMI/DP) pins of all codecs and what the monitors say (read only).
    hdmi_probe(state)

    let ring: u64 = mem.frame_run(state, RING_PAGES)
    if ring == 0 {
        s(state, S_WHY, W_NORING)
        s(state, S_BASE, 0)
        serial.puts((&s_head[0]) as u64)
        serial.puts((&s_ring[0]) as u64)
        serial.nl()
        return false
    }
    s(state, S_RING, ring)
    zero_ring(state)
    bdl_fill(state)

    let dp: u64 = dpib_base(state)
    var i: u64 = 0
    while i < 16 {
        kstate.set(dp, i * 8, 0)
        i = i + 1
    }
    wr32(state, R_DPUBASE, (dp >> 32) & 0xFFFFFFFF)
    wr32(state, R_DPLBASE, (dp & 0xFFFFFFFF) | DP_ENABLE)

    s(state, S_OSTREAM, g(state, S_ISS))
    reset_box(state)
    if !stream_setup(state) {
        s(state, S_WHY, W_NOSTREAM)
        s(state, S_BASE, 0)
        serial.puts((&s_head[0]) as u64)
        serial.puts((&s_str[0]) as u64)
        serial.nl()
        return false
    }

    s(state, S_READY, 1)
    setup_path(state)
    apply_volume(state)

    serial.puts((&s_head[0]) as u64)
    serial.puts((&s_ok[0]) as u64)
    serial.puts((&s_id[0]) as u64)
    serial.hex(g(state, S_VENDOR))
    serial.hex(g(state, S_DEVICE))
    serial.puts((&s_cad[0]) as u64)
    serial.dec(g(state, S_CAD))
    serial.puts((&s_w[0]) as u64)
    serial.dec(g(state, S_WCOUNT))
    serial.puts((&s_dac[0]) as u64)
    serial.dec(g(state, S_DAC))
    serial.puts((&s_pin[0]) as u64)
    serial.dec(g(state, S_PIN))
    serial.puts((&s_len[0]) as u64)
    serial.dec(g(state, S_PLEN))
    serial.puts((&s_str2[0]) as u64)
    serial.dec(g(state, S_OSTREAM))
    serial.puts((&s_way[0]) as u64)
    serial.dec(g(state, S_CMDPATH))
    serial.puts((&s_ring2[0]) as u64)
    serial.hex(ring)
    serial.nl()
    return true
}

fn yesno(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

fn say_graph(state: u64) {
    var s_h: [u8; 14] = "hda-graph: \0\0\0"
    var s_n: [u8; 7] = "  nid=\0"
    var s_t: [u8; 4] = " t=\0"
    var s_c: [u8; 7] = " caps=\0"
    var s_cf: [u8; 6] = " cfg=\0"
    var s_pc: [u8; 6] = " pin=\0"
    var s_a: [u8; 6] = " amp=\0"
    var s_k: [u8; 8] = " conn=\0\0"
    var s_p: [u8; 8] = " point=\0"
    var s_ko: [u8; 2] = ",\0"
    if !present(state) {
        return
    }
    serial.puts((&s_h[0]) as u64)
    serial.dec(g(state, S_WCOUNT))
    serial.nl()
    let ws: u64 = g(state, S_WSTART)
    var k: u64 = 0
    while k < g(state, S_WCOUNT) {
        let nid: u64 = ws + k
        serial.puts((&s_n[0]) as u64)
        serial.dec(nid)
        serial.puts((&s_t[0]) as u64)
        serial.dec(node_type(state, nid))
        serial.puts((&s_c[0]) as u64)
        serial.hex(node_caps(state, nid))
        if node_type(state, nid) == T_PIN {
            serial.puts((&s_cf[0]) as u64)
            serial.hex(node_cfg(state, nid))
            serial.puts((&s_pc[0]) as u64)
            serial.hex(node_pincap(state, nid))
            serial.puts((&s_p[0]) as u64)
            serial.dec(pin_score(state, nid))
        }
        serial.puts((&s_a[0]) as u64)
        serial.hex(node_amp(state, nid))
        serial.puts((&s_k[0]) as u64)
        let n: u64 = node_nconn(state, nid)
        var j: u64 = 0
        while j < n && j < 8 {
            if j > 0 {
                serial.puts((&s_ko[0]) as u64)
            }
            serial.dec(node_conn(state, nid, j))
            j = j + 1
        }
        serial.nl()
        k = k + 1
    }
}

// ===================================================== r815: HDMI / DISPLAYPORT PIN PROBE (read only)
//
// The sound driver above skips digital pins on purpose (pin_score = 0): it plays through the analog jacks. This
// probe only LOOKS at the digital output pins of every codec on the link and prints what the monitor behind
// each of them says, so that a real board (Dell: the HDMI codec is usually the second codec) can be judged from
// the boot log before any stream is routed there:
//   hda: hdmi cad=C nid=N pincap=0x.. sense=0x.. eld=LEN [mon=NAME dp=0|1 sad=N rate=R]
// `sense` is GET_PIN_SENSE (bit 31 = a monitor is plugged, bit 30 = its ELD is valid). `rate` is the best 2 ch
// LPCM rate bit of lib/monitors/eld.fi (4 = 48 kHz). Routing (digital converter + IEC958 + stream) is the next step,
// see docs/MONITORS.md "HDMI audio"; the decision "may sound go to this monitor" is lib/monitors layout.audio_pin.
static mut eld_buf: [u8; 128] = [0 as u8; 128]
static mut hdmi_found: u64 = 0

fn hdmi_pins() -> u64 {
    return hdmi_found
}

// ELD of pin `nid` into eld_buf. Returns the number of bytes read, 0 when the pin has none (no monitor / not valid yet).
fn read_eld(state: u64, cad: u64, nid: u64) -> u64 {
    let sz: u64 = cmd(state, cad, nid, V_GET_DIPSIZE, 0x08)
    if sz == NO_ANSWER {
        return 0
    }
    var n: u64 = sz & 0xFF
    if n > 128 {
        n = 128
    }
    var i: u64 = 0
    while i < n {
        let v: u64 = cmd(state, cad, nid, V_GET_ELDD, i)
        if v == NO_ANSWER || (v & 0x80000000) == 0 {
            return 0
        }
        eld_buf[i as usize] = (v & 0xFF) as u8
        i = i + 1
    }
    return n
}

fn probe_pin(state: u64, cad: u64, nid: u64, pc: u64) {
    var s_h: [u8; 15] = "hda: hdmi cad=\0"
    var s_n: [u8; 6] = " nid=\0"
    var s_p: [u8; 9] = " pincap=\0"
    var s_s: [u8; 8] = " sense=\0"
    var s_e: [u8; 6] = " eld=\0"
    var s_m: [u8; 6] = " mon=\0"
    var s_d: [u8; 5] = " dp=\0"
    var s_a: [u8; 6] = " sad=\0"
    var s_r: [u8; 7] = " rate=\0"
    var sense: u64 = cmd(state, cad, nid, V_GET_PINSENSE, 0)
    if sense == NO_ANSWER {
        sense = 0
    }
    var n: u64 = 0
    if (sense & 0x80000000) != 0 {
        n = read_eld(state, cad, nid)
    }
    serial.puts((&s_h[0]) as u64)
    serial.dec(cad)
    serial.puts((&s_n[0]) as u64)
    serial.dec(nid)
    serial.puts((&s_p[0]) as u64)
    serial.hex(pc)
    serial.puts((&s_s[0]) as u64)
    serial.hex(sense)
    serial.puts((&s_e[0]) as u64)
    serial.dec(n)
    let e: u64 = (&eld_buf[0]) as u64
    if n != 0 && eld.eld_valid(e, n) {
        serial.puts((&s_m[0]) as u64)
        var k: u64 = 0
        while k < eld.eld_name_len(e) {
            let ch: u64 = eld.eld_name_at(e, k)
            if ch >= 32 && ch < 127 {
                serial.put(ch as u8)
            }
            k = k + 1
        }
        serial.puts((&s_d[0]) as u64)
        if eld.eld_is_dp(e) {
            serial.dec(1)
        } else {
            serial.dec(0)
        }
        serial.puts((&s_a[0]) as u64)
        serial.dec(eld.eld_sad_count(e))
        serial.puts((&s_r[0]) as u64)
        serial.dec(eld.eld_best_pcm_rate(e, n))
    }
    serial.nl()
}

// Every codec in STATESTS: its function groups, their widgets; each digital output pin is reported. Never changes any state of the codecs
// (no SET verb) and never fails: a codec that does not answer is skipped.
fn hdmi_probe(state: u64) {
    hdmi_found = 0
    let st: u64 = g(state, S_STATESTS)
    var cad: u64 = 0
    while cad < 15 {
        if (st & (1 << cad)) != 0 {
            let nc: u64 = param(state, cad, 0, P_NODECOUNT)
            if nc != NO_ANSWER {
                let fg0: u64 = (nc >> 16) & 0xFF
                let fgn: u64 = nc & 0xFF
                var f: u64 = 0
                while f < fgn && f < 4 {
                    let fg: u64 = fg0 + f
                    let ft: u64 = param(state, cad, fg, P_FGTYPE)
                    if ft != NO_ANSWER && (ft & 0x7F) == 1 {
                        let wn: u64 = param(state, cad, fg, P_NODECOUNT)
                        if wn != NO_ANSWER {
                            let w0: u64 = (wn >> 16) & 0xFF
                            let wc: u64 = wn & 0xFF
                            var k: u64 = 0
                            while k < wc && k < 64 {
                                let nid: u64 = w0 + k
                                let caps: u64 = param(state, cad, nid, P_WCAP)
                                if caps != NO_ANSWER && ((caps >> 20) & 0xF) == T_PIN && (caps & WCAP_DIGITAL) != 0 {
                                    let pc: u64 = param(state, cad, nid, P_PINCAP)
                                    if pc != NO_ANSWER && (pc & PINCAP_OUT) != 0 && (pc & (PINCAP_HDMI | PINCAP_DP)) != 0 {
                                        hdmi_found = hdmi_found + 1
                                        probe_pin(state, cad, nid, pc)
                                    }
                                }
                                k = k + 1
                            }
                        }
                    }
                    f = f + 1
                }
            }
        }
        cad = cad + 1
    }
}

// ===================================================== DD-12: AFTER S3
// `kill`: power-loss simulation (controller reset, CORB/RIRB/streams are
// gone). `resume`: full set-up again, keeping the volume the user set.
fn kill(state: u64) {
    if g(state, S_BASE) == 0 {
        return
    }
    wr32(state, R_GCTL, rd32(state, R_GCTL) & 0xFFFFFFFE)
}

fn resume(state: u64) -> bool {
    if g(state, S_BASE) == 0 {
        return false
    }
    let vol: u64 = g(state, S_VOL)
    let was: bool = g(state, S_RUNNING) != 0
    if was {
        s(state, S_RUNNING, 0)
    }
    // the jacks the first discovery tried are remembered in a bit field that
    // `init` never clears (it did not need to run twice before): a second
    // discovery would find every jack "already tried" and no path
    var t: u64 = 0
    while t < 4 {
        kstate.set(state + kstate.HDA_OFF, TRIED_OFF + t * 8, 0)
        t = t + 1
    }
    let ok: bool = init(state)
    s(state, S_VOL, vol)
    return ok
}

// ====================================================== W-TRAY6: CAPTURE (microphone)
//
// The input side of the controller: ONE input stream (stream descriptor 0, the first of the ISS
// input descriptors), polled -- no interrupt, no IOC. The reader (`kernel/drv/snd/cap.fi`) asks
// `cap_poll` on every read and from the audio tick, so the 85 ms ring never wraps unseen.
//
// Path: ADC (audio input converter) <- [selector/mixer] <- input pin. The pin is chosen by its
// default configuration: mic-in beats line-in beats any other input pin that has a jack/fixed
// connection. Found lazily on the first `cap_open` (a machine that never records pays nothing).
// Format: 48 kHz, 16 bit, 2 channels (the format of the output side); frames are 4 octets.
// Scalars live in the HDA page at 0x200.. (free above the output scalars, below the codec table).
const CAP_FRAME_OCTETS: u64 = 4
const CAP_TAG: u64 = 2
const CAP_ENTRIES: u64 = 16
const CAP_ENTRY_OCTETS: u64 = 1024
const CAP_BDL_OFF: u64 = 0xA00
const C_STATE: u64 = 0x200 // 0 untried, 1 ready, 2 failed
const C_WHY: u64 = 0x208 // CW_*
const C_ADC: u64 = 0x210
const C_PIN: u64 = 0x218
const C_PLEN: u64 = 0x220
const C_PATH: u64 = 0x228 // four nodes, 16 bit each, ADC first
const C_PIDX: u64 = 0x230 // four connection indices, 16 bit each
const C_RING: u64 = 0x238
const C_RUN: u64 = 0x240
const C_LAST: u64 = 0x248 // last LPIB seen (octets)
const C_ABS: u64 = 0x250 // octets captured since the start (monotonic)
const C_OVER: u64 = 0x258 // reads that fell behind the ring
const C_KIND: u64 = 0x260 // default device of the pin: 0xA mic, 0x8 line-in, 0 other
const C_STARTS: u64 = 0x268
const CW_OK: u64 = 0
const CW_NOHDA: u64 = 1 // no controller / not ready
const CW_NOISS: u64 = 2 // the controller has no input stream
const CW_NOADC: u64 = 3 // no input converter with a path to an input pin
const CW_NORING: u64 = 4
const CW_NOSTREAM: u64 = 5
const PINCAP_IN: u64 = 0x20
const PINCTL_IN: u64 = 0x20

fn cg(state: u64, off: u64) -> u64 {
    return g(state, off)
}

fn cs(state: u64, off: u64, v: u64) {
    s(state, off, v)
}

fn cap_sd() -> u64 {
    return SD_BASE // input stream 0
}

fn cap_ready(state: u64) -> bool {
    return cg(state, C_STATE) == 1
}

fn cap_running(state: u64) -> bool {
    return cg(state, C_RUN) != 0
}

fn cap_why(state: u64) -> u64 {
    return cg(state, C_WHY)
}

fn cap_adc(state: u64) -> u64 {
    return cg(state, C_ADC)
}

fn cap_pin(state: u64) -> u64 {
    return cg(state, C_PIN)
}

fn cap_kind(state: u64) -> u64 {
    return cg(state, C_KIND)
}

fn cap_overruns(state: u64) -> u64 {
    return cg(state, C_OVER)
}

// how good is this node as the microphone end of a path (0 = not usable)
fn cap_pin_score(state: u64, nid: u64) -> u64 {
    if node_type(state, nid) != T_PIN {
        return 0
    }
    if (node_pincap(state, nid) & PINCAP_IN) == 0 {
        return 0
    }
    let cfg: u64 = node_cfg(state, nid)
    if ((cfg >> 30) & 3) == 1 {
        return 0 // no physical connection
    }
    let dev: u64 = (cfg >> 20) & 0xF
    if dev == 0xA {
        return 3
    }
    if dev == 0x8 {
        return 2
    }
    return 1
}

fn cap_mixsel(state: u64, nid: u64) -> bool {
    let t: u64 = node_type(state, nid)
    return t == T_MIXER || t == T_SELECTOR
}

// remember a candidate when it beats the best one so far
fn cap_offer(state: u64, score: u64, len: u64, n0: u64, n1: u64, n2: u64, n3: u64, i0: u64, i1: u64, i2: u64) {
    if score <= cg(state, 0x270) {
        return
    }
    cs(state, 0x270, score)
    cs(state, C_PLEN, len)
    cs(state, C_PATH, n0 | (n1 << 16) | (n2 << 32) | (n3 << 48))
    cs(state, C_PIDX, i0 | (i1 << 16) | (i2 << 32))
}

// depth-limited search ADC <- (mixer|selector)* <- pin, three levels at most
fn cap_find(state: u64) -> bool {
    cs(state, 0x270, 0)
    cs(state, C_PLEN, 0)
    let ws: u64 = g(state, S_WSTART)
    let wc: u64 = g(state, S_WCOUNT)
    var k: u64 = 0
    while k < wc {
        let adc: u64 = ws + k
        if node_type(state, adc) == T_AUDIO_IN && (node_caps(state, adc) & WCAP_DIGITAL) == 0 {
            let n0: u64 = node_nconn(state, adc)
            var a: u64 = 0
            while a < n0 && a < 8 {
                let x1: u64 = node_conn(state, adc, a)
                let s1: u64 = cap_pin_score(state, x1)
                if s1 > 0 {
                    cap_offer(state, s1 * 4, 2, adc, x1, 0, 0, a, 0, 0)
                } else if cap_mixsel(state, x1) {
                    let n1: u64 = node_nconn(state, x1)
                    var b: u64 = 0
                    while b < n1 && b < 8 {
                        let x2: u64 = node_conn(state, x1, b)
                        let s2: u64 = cap_pin_score(state, x2)
                        if s2 > 0 {
                            cap_offer(state, s2 * 4 - 1, 3, adc, x1, x2, 0, a, b, 0)
                        } else if cap_mixsel(state, x2) {
                            let n2: u64 = node_nconn(state, x2)
                            var c: u64 = 0
                            while c < n2 && c < 8 {
                                let x3: u64 = node_conn(state, x2, c)
                                let s3: u64 = cap_pin_score(state, x3)
                                if s3 > 0 {
                                    cap_offer(state, s3 * 4 - 2, 4, adc, x1, x2, x3, a, b, c)
                                }
                                c = c + 1
                            }
                        }
                        b = b + 1
                    }
                }
                a = a + 1
            }
        }
        k = k + 1
    }
    return cg(state, C_PLEN) != 0
}

fn cap_path_at(state: u64, i: u64) -> u64 {
    return (cg(state, C_PATH) >> (i * 16)) & 0xFFFF
}

fn cap_path_idx(state: u64, i: u64) -> u64 {
    return (cg(state, C_PIDX) >> (i * 16)) & 0xFFFF
}

// switch the found path on: power, amplifiers (0 dB, unmuted), selectors, the pin as input, the converter's stream
fn cap_wire(state: u64) {
    let cad: u64 = g(state, S_CAD)
    let len: u64 = cg(state, C_PLEN)
    var i: u64 = 0
    while i < len {
        let nid: u64 = cap_path_at(state, i)
        let caps: u64 = node_caps(state, nid)
        if (caps & WCAP_POWER) != 0 {
            cmd(state, cad, nid, V_SET_PSTATE, 0)
        }
        if i + 1 < len {
            // the converter and every mixer/selector on the way: pass the chosen input only
            let idx: u64 = cap_path_idx(state, i)
            if (caps & WCAP_INAMP) != 0 {
                let ia: u64 = param(state, cad, nid, P_INAMP)
                var gain: u64 = 0
                if ia != NO_ANSWER {
                    gain = amp_offset(ia)
                }
                let n: u64 = node_nconn(state, nid)
                var q: u64 = 0
                while q < n && q < 8 {
                    set_in_amp(state, cad, nid, q, gain, true)
                    q = q + 1
                }
                set_in_amp(state, cad, nid, idx, gain, false)
            }
            if node_type(state, nid) == T_SELECTOR || node_type(state, nid) == T_AUDIO_IN {
                cmd(state, cad, nid, V_SET_CONNSEL, idx)
            }
        }
        if (caps & WCAP_OUTAMP) != 0 && node_type(state, nid) != T_PIN {
            set_out_amp(state, cad, nid, amp_offset(node_amp(state, nid)), false)
        }
        i = i + 1
    }
    let pin: u64 = cap_path_at(state, len - 1)
    let pc: u64 = node_pincap(state, pin)
    var ctl: u64 = PINCTL_IN
    if cap_kind(state) == 0xA {
        if (pc & 0x1000) != 0 { // VREF 80 %
            ctl = ctl | 4
        } else if (pc & 0x200) != 0 { // VREF 50 %
            ctl = ctl | 1
        }
    }
    cmd(state, cad, pin, V_SET_PINCTL, ctl)
    cs(state, C_PIN, pin)
    cs(state, C_ADC, cap_path_at(state, 0))
}

fn cap_sd_reset(state: u64) -> bool {
    let o: u64 = cap_sd()
    wr8(state, o + SD_CTL, rd8(state, o + SD_CTL) & 0xFD)
    var n: u64 = 0
    var went_off: bool = false
    while n < SPIN_LIMIT && !went_off {
        if (rd8(state, o + SD_CTL) & SDCTL_RUN) == 0 {
            went_off = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    wr8(state, o + SD_CTL, rd8(state, o + SD_CTL) | SDCTL_SRST)
    n = 0
    var entered: bool = false
    while n < SPIN_LIMIT && !entered {
        if (rd8(state, o + SD_CTL) & SDCTL_SRST) != 0 {
            entered = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    udelay(state, 100)
    wr8(state, o + SD_CTL, rd8(state, o + SD_CTL) & 0xFE)
    n = 0
    var left_ok: bool = false
    while n < SPIN_LIMIT && !left_ok {
        if (rd8(state, o + SD_CTL) & SDCTL_SRST) == 0 {
            left_ok = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    udelay(state, 100)
    return entered && left_ok
}

// 0x5A everywhere: a DMA that really writes shows as bytes that are no longer 0x5A (self test, see tools/hda/cap.sh)
fn cap_prefill(state: u64) {
    let r: u64 = cg(state, C_RING)
    var i: u64 = 0
    while i < RING_OCTETS / 8 {
        kstate.set(r, i * 8, 0x5A5A5A5A5A5A5A5A)
        i = i + 1
    }
}

fn cap_bdl_fill(state: u64) {
    let ring: u64 = cg(state, C_RING)
    let b: u64 = state + kstate.HDA_OFF + CAP_BDL_OFF
    var i: u64 = 0
    while i < CAP_ENTRIES {
        let e: u64 = b + i * 16
        let a: u64 = ring + i * CAP_ENTRY_OCTETS
        __mmio_write32(e as *mut u32, (a & 0xFFFFFFFF) as u32)
        __mmio_write32((e + 4) as *mut u32, ((a >> 32) & 0xFFFFFFFF) as u32)
        __mmio_write32((e + 8) as *mut u32, CAP_ENTRY_OCTETS as u32)
        __mmio_write32((e + 12) as *mut u32, 0 as u32)
        i = i + 1
    }
    arch.barrier_write()
}

// find the path and take the ring once; the stream itself starts in cap_open
fn cap_setup(state: u64) -> bool {
    if cg(state, C_STATE) == 1 {
        return true
    }
    if !ready(state) {
        cs(state, C_WHY, CW_NOHDA)
        return false
    }
    if g(state, S_ISS) == 0 {
        cs(state, C_WHY, CW_NOISS)
        cs(state, C_STATE, 2)
        return false
    }
    if cg(state, C_STATE) == 2 {
        return false
    }
    if !cap_find(state) {
        cs(state, C_WHY, CW_NOADC)
        cs(state, C_STATE, 2)
        return false
    }
    let pin: u64 = cap_path_at(state, cg(state, C_PLEN) - 1)
    cs(state, C_KIND, (node_cfg(state, pin) >> 20) & 0xF)
    var ring: u64 = cg(state, C_RING)
    if ring == 0 {
        ring = mem.frame_run(state, RING_PAGES)
    }
    if ring == 0 {
        cs(state, C_WHY, CW_NORING)
        return false
    }
    cs(state, C_RING, ring)
    cap_prefill(state)
    cap_bdl_fill(state)
    cap_wire(state)
    cs(state, C_WHY, CW_OK)
    cs(state, C_STATE, 1)
    var say_h: [u8; 20] = "hda: capture path \0\0"
    var say_a: [u8; 6] = " adc=\0"
    var say_p: [u8; 6] = " pin=\0"
    var say_k: [u8; 7] = " kind=\0"
    var say_l: [u8; 6] = " len=\0"
    serial.puts((&say_h[0]) as u64)
    serial.puts((&say_a[0]) as u64)
    serial.dec(cap_adc(state))
    serial.puts((&say_p[0]) as u64)
    serial.dec(cap_pin(state))
    serial.puts((&say_k[0]) as u64)
    serial.dec(cap_kind(state))
    serial.puts((&say_l[0]) as u64)
    serial.dec(cg(state, C_PLEN))
    serial.nl()
    return true
}

// find the microphone path without starting the stream (the tray asks this to decide whether to show a mic row)
fn cap_probe(state: u64) -> bool {
    return cap_setup(state)
}

// start capturing (idempotent); false = no microphone path or the stream does not start
fn cap_open(state: u64) -> bool {
    if !cap_setup(state) {
        return false
    }
    if cg(state, C_RUN) != 0 {
        return true
    }
    if !cap_sd_reset(state) {
        cs(state, C_WHY, CW_NOSTREAM)
        return false
    }
    let o: u64 = cap_sd()
    let cad: u64 = g(state, S_CAD)
    let b: u64 = state + kstate.HDA_OFF + CAP_BDL_OFF
    cap_prefill(state)
    wr32(state, o + SD_CBL, CAP_ENTRIES * CAP_ENTRY_OCTETS)
    wr16(state, o + SD_LVI, CAP_ENTRIES - 1)
    wr32(state, o + SD_BDPL, b & 0xFFFFFFFF)
    wr32(state, o + SD_BDPU, (b >> 32) & 0xFFFFFFFF)
    let f: u64 = fmt_word(RATE)
    wr16(state, o + SD_FMT, f)
    wr8(state, o + 0x02, (CAP_TAG & 0xF) << 4)
    cmd(state, cad, cg(state, C_ADC), V_SET_FORMAT, f)
    cmd(state, cad, cg(state, C_ADC), V_SET_STREAM, (CAP_TAG << 4) | 0)
    wr8(state, o + SD_STS, SDSTS_BCIS | SDSTS_FIFOE | SDSTS_DESE)
    wr32(state, o + SD_LPIB, 0)
    cs(state, C_LAST, 0)
    cs(state, C_ABS, 0)
    wr8(state, o + SD_CTL, rd8(state, o + SD_CTL) | SDCTL_RUN)
    var n: u64 = 0
    var is_running: bool = false
    while n < SPIN_LIMIT && !is_running {
        if (rd8(state, o + SD_CTL) & SDCTL_RUN) != 0 {
            is_running = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    if !is_running {
        cs(state, C_WHY, CW_NOSTREAM)
        return false
    }
    cs(state, C_RUN, 1)
    cs(state, C_STARTS, cg(state, C_STARTS) + 1)
    return true
}

fn cap_close(state: u64) {
    if cg(state, C_RUN) == 0 || !present(state) {
        return
    }
    let o: u64 = cap_sd()
    wr8(state, o + SD_CTL, rd8(state, o + SD_CTL) & 0xFC)
    var n: u64 = 0
    var went_off: bool = false
    while n < SPIN_LIMIT && !went_off {
        if (rd8(state, o + SD_CTL) & SDCTL_RUN) == 0 {
            went_off = true
        } else {
            n = n + 1
            arch.pause()
        }
    }
    cs(state, C_RUN, 0)
}

// fold the stream position into the monotonic octet counter
fn cap_poll(state: u64) {
    if cg(state, C_RUN) == 0 {
        return
    }
    let lp: u64 = rd32(state, cap_sd() + SD_LPIB) % RING_OCTETS
    let last: u64 = cg(state, C_LAST)
    var d: u64 = 0
    if lp >= last {
        d = lp - last
    } else {
        d = lp + RING_OCTETS - last
    }
    cs(state, C_LAST, lp)
    cs(state, C_ABS, cg(state, C_ABS) + d)
}

// frames captured since the start
fn cap_frames(state: u64) -> u64 {
    return cg(state, C_ABS) / CAP_FRAME_OCTETS
}

// copy `frames` frames starting at the absolute frame `from` out of the ring to `dst`; the caller
// checked that they are still in the ring (cap_frames - from <= RING_FRAMES)
fn cap_read(state: u64, from: u64, dst: u64, frames: u64) {
    let r: u64 = cg(state, C_RING)
    var i: u64 = 0
    while i < frames {
        let o: u64 = ((from + i) * CAP_FRAME_OCTETS) % RING_OCTETS
        __mmio_write32((dst + i * 4) as *mut u32, __mmio_read32((r + o) as *mut u32))
        i = i + 1
    }
}

// self test helpers (kernel/drv/snd/captest.fi): count the 32 bit words of the capture ring that equal `pat`,
// and fill the whole ring with `pat`
fn cap_ring_count(state: u64, pat: u64) -> u64 {
    let r: u64 = cg(state, C_RING)
    if r == 0 {
        return 0
    }
    var n: u64 = 0
    var i: u64 = 0
    while i < RING_OCTETS / 4 {
        let w: u64 = __mmio_read32((r + i * 4) as *mut u32) as u64
        if w == (pat & 0xFFFFFFFF) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn cap_ring_fill(state: u64, pat: u64) {
    let r: u64 = cg(state, C_RING)
    if r == 0 {
        return
    }
    var i: u64 = 0
    while i < RING_OCTETS / 4 {
        __mmio_write32((r + i * 4) as *mut u32, (pat & 0xFFFFFFFF) as u32)
        i = i + 1
    }
}

// after S3 the controller lost its registers: the next open starts from scratch
fn cap_resume(state: u64) {
    cs(state, C_RUN, 0)
    if cg(state, C_STATE) == 1 {
        cs(state, C_STATE, 0)
    }
}
