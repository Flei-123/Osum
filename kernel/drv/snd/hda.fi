const V_SET_PINCTL: u64 = 0x707
const V_GET_PINSENSE: u64 = 0xF09
const V_GET_DIPSIZE: u64 = 0xF2E // HDMI: size of a data buffer (param 8 = ELD)
const V_GET_ELDD: u64 = 0xF2F // HDMI: one ELD byte (bit 31 = valid, 7:0 = data)
const PINCAP_HDMI: u64 = 0x80
const PINCAP_DP: u64 = 0x1000000
const V_SET_EAPD: u64 = 0x70C
const V_GET_CFGDEF: u64 = 0xF1C
const V_SET_FORMAT: u64 = 0x2 // Vierbitverb, 16 Bit Nutzlast
