const R_GCAP: u64 = 0x00 // 16
const R_VMIN: u64 = 0x02 // 8
const R_VMAJ: u64 = 0x03 // 8
const R_GCTL: u64 = 0x08 // 32
const R_WAKEEN: u64 = 0x0C // 16
const R_STATESTS: u64 = 0x0E // 16
const R_INTCTL: u64 = 0x20 // 32
const R_INTSTS: u64 = 0x24 // 32
const R_CORBLBASE: u64 = 0x40
const R_CORBUBASE: u64 = 0x44
const R_CORBWP: u64 = 0x48 // 16
const R_CORBRP: u64 = 0x4A // 16
const R_CORBCTL: u64 = 0x4C // 8
const R_CORBSTS: u64 = 0x4D // 8
const R_CORBSIZE: u64 = 0x4E // 8
const R_RIRBLBASE: u64 = 0x50
const R_RIRBUBASE: u64 = 0x54
const R_RIRBWP: u64 = 0x58 // 16
const R_RINTCNT: u64 = 0x5A // 16
const R_RIRBCTL: u64 = 0x5C // 8
const R_RIRBSTS: u64 = 0x5D // 8
const R_RIRBSIZE: u64 = 0x5E // 8
const R_ICOI: u64 = 0x60 // 32
const R_ICII: u64 = 0x64 // 32
const R_ICIS: u64 = 0x68 // 16
const R_DPLBASE: u64 = 0x70 // 32
const R_DPUBASE: u64 = 0x74 // 32
const SD_BASE: u64 = 0x80
const SD_SPAN: u64 = 0x20

// Die Strombeschreibung, Versaetze innerhalb ihres Blocks.
const SD_CTL: u64 = 0x00
const SD_STS: u64 = 0x03 // 8
const SD_LPIB: u64 = 0x04 // 32
const SD_CBL: u64 = 0x08 // 32
const SD_LVI: u64 = 0x0C // 16
const SD_FIFOW: u64 = 0x0E // 16
const SD_FIFOS: u64 = 0x10 // 16
const SD_FMT: u64 = 0x12 // 16
const SD_BDPL: u64 = 0x18 // 32
const SD_BDPU: u64 = 0x1C // 32

const GCTL_CRST: u64 = 0x01
const GCTL_UNSOL: u64 = 0x100
const CORBCTL_RUN: u64 = 0x02
const RIRBCTL_RUN: u64 = 0x02
const RIRBCTL_INT: u64 = 0x01
const SIZE_256: u64 = 0x02 // in CORBSIZE/RIRBSIZE: 256 Eintraege
const RP_RST: u64 = 0x8000
const WP_RST: u64 = 0x8000
const ICIS_BUSY: u64 = 0x01
const ICIS_VALID: u64 = 0x02
const SDCTL_SRST: u64 = 0x01
const SDCTL_RUN: u64 = 0x02
const SDCTL_IOCE: u64 = 0x04
const SDSTS_BCIS: u64 = 0x04
const SDSTS_FIFOE: u64 = 0x08
const SDSTS_DESE: u64 = 0x10
const INTCTL_GIE: u64 = 0x80000000
const INTCTL_CIE: u64 = 0x40000000
const DP_ENABLE: u64 = 0x01

// ------------------------------------------------------------ Verben
