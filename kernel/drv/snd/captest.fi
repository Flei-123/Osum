// SPDX-License-Identifier: GPL-2.0-only
// kernel/drv/snd/captest.fi -- MICROPHONE SELF TEST (W-TRAY6 follow-up, 13.10.2026). Run by the kernel word
// `audcap`; measured by tools/hda/cap.sh in QEMU (intel-hda + hda-micro, -audiodev none).
//
// Every claim is a serial line `aud: <name>=<number>`:
//   * the capture ring is filled with 0x5A before the stream starts (pre5a = all words), and after about a
//     second of capture no 0x5A word is left (post5a = 0): the DMA really wrote.
//   * the stream position never steps back (back = 0) and advances at about 48 kHz (frames/t_first/t_last).
//   * reader A drains the stream while it runs and never sees a 0x5A frame (a_5a = 0).
//   * the fifth reader is refused (fifth = 1), four readers are counted (users = 4) and named: the task index of
//     the first/fourth live reader (who0 = 1, who3 = 4; the tray asks them with AUDGET A_CAPWHO0 + k).
//   * after 2.2 s without a read the stream stops by itself (idle_run = 0, idle_users = 0).
//   * pattern test with the stream stopped: the ring holds 0x11112222; an unmuted reader gets exactly that
//     (b_pat = b_n), a muted reader gets only silence into a buffer pre-filled with junk (c_zero = c_n,
//     c_pat = 0, c_junk = 0), unmuting brings the pattern back (d_pat = d_n).
profile kernel

import serial
import sched.time
import arch.arch
import drv.snd.hda
import drv.snd.mic

export { run }

const PAT: u64 = 0x11112222
const CHUNK: u64 = 512 // frames per read (2048 octets)

fn p_ready(v: u64) {
    var s: [u8; 12] = "aud: ready=\0"
    serial.puts((&s[0]) as u64)
    serial.dec(v)
    serial.nl()
}

fn p_why(v: u64) {
    var s: [u8; 10] = "aud: why=\0"
    serial.puts((&s[0]) as u64)
    serial.dec(v)
    serial.nl()
}

