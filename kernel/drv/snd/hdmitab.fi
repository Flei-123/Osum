profile kernel

export {
    MAX_CTL, MAX_PINS, ELD_MAX, VLOG_MAX,
    C_BDF, C_OWNED, C_BASE, C_STATESTS, C_FAILS, C_CODECS, C_STATE,
    P_CTL, P_CAD, P_NID, P_PINCAP, P_WCAP, P_SENSE, P_ELDLEN, P_CONN, P_CONNN, P_PSTATE, P_PINCTL, P_EAPD, P_UNSOL,
    P_CONV, P_CONVDIGI, P_EVENTS, P_SYNTH, P_PLANLEN, P_LASTSENSE,
    P_CONVWCAP, P_STREAMING, P_STRFMT, P_STRRB, P_STRWHY,
    K_SCANS, K_POLLS, K_EVENTS, K_REFRESH, K_SENSECHG, K_LASTTICK, K_STREAMS, K_STOPS,
    ctl_count, ctl_new, ctl_get, ctl_set, pin_count, pin_new, pin_get, pin_set, pin_find,
    eld_ptr, eld_clear, eld_put, vlog_add, vlog_count, vlog_word, vlog_resp, ctr_get, ctr_inc, ctr_set, reset
}

const MAX_CTL: u64 = 4
const MAX_PINS: u64 = 8
const ELD_MAX: u64 = 128
const VLOG_MAX: u64 = 96
const CF: u64 = 8
const PF: u64 = 24

const C_BDF: u64 = 0
const C_OWNED: u64 = 1
const C_BASE: u64 = 2
const C_STATESTS: u64 = 3
const C_FAILS: u64 = 4
const C_CODECS: u64 = 5
const C_STATE: u64 = 6

const P_CTL: u64 = 0
const P_CAD: u64 = 1
const P_NID: u64 = 2
const P_PINCAP: u64 = 3
const P_WCAP: u64 = 4
const P_SENSE: u64 = 5
const P_ELDLEN: u64 = 6
const P_CONN: u64 = 7
const P_CONNN: u64 = 8
const P_PSTATE: u64 = 9
const P_PINCTL: u64 = 10
const P_EAPD: u64 = 11
const P_UNSOL: u64 = 12
const P_CONV: u64 = 13
const P_CONVDIGI: u64 = 14
const P_EVENTS: u64 = 15
const P_SYNTH: u64 = 16
const P_PLANLEN: u64 = 17
const P_LASTSENSE: u64 = 18
const P_CONVWCAP: u64 = 19
const P_STREAMING: u64 = 20
const P_STRFMT: u64 = 21
const P_STRRB: u64 = 22
const P_STRWHY: u64 = 23

const K_SCANS: u64 = 0
const K_POLLS: u64 = 1
const K_EVENTS: u64 = 2
const K_REFRESH: u64 = 3
const K_SENSECHG: u64 = 4
const K_LASTTICK: u64 = 5
const K_STREAMS: u64 = 6
const K_STOPS: u64 = 7

static mut c_tab: [u64; 32] = [0; 32]
static mut c_n: u64 = 0
static mut p_tab: [u64; 192] = [0; 192]
static mut p_n: u64 = 0
static mut p_eld: [u8; 1024] = [0 as u8; 1024]
static mut v_w: [u64; 96] = [0; 96]
static mut v_r: [u64; 96] = [0; 96]
static mut v_n: u64 = 0
static mut k_tab: [u64; 8] = [0; 8]

fn reset() {
    var i: usize = 0
    while i < 32 {
        c_tab[i] = 0
        i = i + 1
    }
    i = 0
    while i < 192 {
        p_tab[i] = 0
        i = i + 1
    }
    i = 0
    while i < 1024 {
        p_eld[i] = 0 as u8
        i = i + 1
    }
    c_n = 0
    p_n = 0
}

fn ctl_count() -> u64 {
    return c_n
}

fn ctl_new() -> u64 {
    if c_n >= MAX_CTL {
        return MAX_CTL
    }
    c_n = c_n + 1
    return c_n - 1
}

fn ctl_get(c: u64, f: u64) -> u64 {
    if c >= c_n || f >= CF {
        return 0
    }
    return c_tab[(c * CF + f) as usize]
}

fn ctl_set(c: u64, f: u64, v: u64) {
    if c < c_n && f < CF {
        c_tab[(c * CF + f) as usize] = v
    }
}

fn pin_count() -> u64 {
    return p_n
}

fn pin_new() -> u64 {
    if p_n >= MAX_PINS {
        return MAX_PINS
    }
    p_n = p_n + 1
    return p_n - 1
}

fn pin_get(i: u64, f: u64) -> u64 {
    if i >= p_n || f >= PF {
        return 0
    }
    return p_tab[(i * PF + f) as usize]
}

fn pin_set(i: u64, f: u64, v: u64) {
    if i < p_n && f < PF {
        p_tab[(i * PF + f) as usize] = v
    }
}

fn pin_find(c: u64, cad: u64, nid: u64) -> u64 {
    var i: u64 = 0
    while i < p_n {
        if pin_get(i, P_CTL) == c && pin_get(i, P_CAD) == cad && pin_get(i, P_NID) == nid {
            return i
        }
        i = i + 1
    }
    return MAX_PINS
}

fn eld_ptr(i: u64) -> u64 {
    return (&p_eld[0]) as u64 + i * ELD_MAX
}

fn eld_clear(i: u64) {
    var k: u64 = 0
    while k < ELD_MAX {
        p_eld[(i * ELD_MAX + k) as usize] = 0 as u8
        k = k + 1
    }
}

fn eld_put(i: u64, k: u64, b: u64) {
    if i < MAX_PINS && k < ELD_MAX {
        p_eld[(i * ELD_MAX + k) as usize] = (b & 0xFF) as u8
    }
}

fn vlog_add(word: u64, resp: u64) {
    v_w[(v_n % VLOG_MAX) as usize] = word
    v_r[(v_n % VLOG_MAX) as usize] = resp
    v_n = v_n + 1
}

fn vlog_count() -> u64 {
    if v_n > VLOG_MAX {
        return VLOG_MAX
    }
    return v_n
}

fn vlog_word(k: u64) -> u64 {
    var first: u64 = 0
    if v_n > VLOG_MAX {
        first = v_n - VLOG_MAX
    }
    return v_w[((first + k) % VLOG_MAX) as usize]
}

fn vlog_resp(k: u64) -> u64 {
    var first: u64 = 0
    if v_n > VLOG_MAX {
        first = v_n - VLOG_MAX
    }
    return v_r[((first + k) % VLOG_MAX) as usize]
}

fn ctr_get(k: u64) -> u64 {
    return k_tab[(k % 8) as usize]
}

fn ctr_inc(k: u64) {
    k_tab[(k % 8) as usize] = k_tab[(k % 8) as usize] + 1
}

fn ctr_set(k: u64, v: u64) {
    k_tab[(k % 8) as usize] = v
}
