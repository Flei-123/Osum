
profile kernel

import lib.kstate
import serial
import ldr.modtab
import bus.drvfw

export { ABI, such, count, name_at, addr_at, eq }

const ABI: u64 = 1

const N_SYM: u64 = 14

struct F_1v { f: fn(u64) }
struct F_1u { f: fn(u64) -> u64 }
struct F_2u { f: fn(u64, u64) -> u64 }
struct F_2v { f: fn(u64, u64) }
struct F_3v { f: fn(u64, u64, u64) }
struct F_4u { f: fn(u64, u64, u64, u64) -> u64 }
struct F_0u { f: fn() -> u64 }
struct F_0v { f: fn() }

fn zelle(p: u64) -> u64 {
    let d: u64 = __mmio_read64(p as *mut u64)
    if d == 0 {
        return 0
    }
    return __mmio_read64(d as *mut u64)
}

const S_PUTS: u64 = 0
const S_PUTC: u64 = 1
const S_DEC: u64 = 2
const S_HEX: u64 = 3
const S_NL: u64 = 4
const S_TEXT: u64 = 5
const S_GET: u64 = 6
const S_SET: u64 = 7
const S_GET8: u64 = 8
const S_SET8: u64 = 9
const S_BIND: u64 = 10
const S_ABI: u64 = 11
const S_KDATA: u64 = 12
const S_FWREQ: u64 = 13

fn count() -> u64 {
    return N_SYM
}

fn abi_value() -> u64 {
    return ABI
}

fn set8_u64(p: u64, v: u64) {
    kstate.set8(p, (v & 0xFF) as u8)
}

fn putc_u64(c: u64) {
    serial.put((c & 0xFF) as u8)
}

fn addr_at(i: u64) -> u64 {
    if i == S_PUTS {
        var t: F_1v = F_1v { f: serial.puts }
        return zelle((&t) as u64)
    }
    if i == S_PUTC {
        var t: F_1v = F_1v { f: putc_u64 }
        return zelle((&t) as u64)
    }
    if i == S_DEC {
        var t: F_1v = F_1v { f: serial.dec }
        return zelle((&t) as u64)
    }
    if i == S_HEX {
        var t: F_1v = F_1v { f: serial.hex }
        return zelle((&t) as u64)
    }
    if i == S_NL {
        var t: F_0v = F_0v { f: serial.nl }
        return zelle((&t) as u64)
    }
    if i == S_TEXT {
        var t: F_2v = F_2v { f: serial.text }
        return zelle((&t) as u64)
    }
    if i == S_GET {
        var t: F_2u = F_2u { f: kstate.get }
        return zelle((&t) as u64)
    }
    if i == S_SET {
        var t: F_3v = F_3v { f: kstate.set }
        return zelle((&t) as u64)
    }
    if i == S_GET8 {
        var t: F_1u = F_1u { f: kstate.get8 }
        return zelle((&t) as u64)
    }
    if i == S_SET8 {
        var t: F_2v = F_2v { f: set8_u64 }
        return zelle((&t) as u64)
    }
    if i == S_BIND {
        var t: F_4u = F_4u { f: modtab.bind }
        return zelle((&t) as u64)
    }
    if i == S_ABI {
        var t: F_0u = F_0u { f: abi_value }
        return zelle((&t) as u64)
    }
    if i == S_KDATA {
        return kstate_basis()
    }
    if i == S_FWREQ {
        var t: F_4u = F_4u { f: drvfw.request }
        return zelle((&t) as u64)
    }
    return 0
}

fn name_at(i: u64) {
    var n0: [u8; 7] = "k_puts\0"
    var n1: [u8; 7] = "k_putc\0"
    var n2: [u8; 6] = "k_dec\0"
    var n3: [u8; 6] = "k_hex\0"
    var n4: [u8; 5] = "k_nl\0"
    var n5: [u8; 7] = "k_text\0"
    var n6: [u8; 6] = "k_get\0"
    var n7: [u8; 6] = "k_set\0"
    var n8: [u8; 7] = "k_get8\0"
    var n9: [u8; 7] = "k_set8\0"
    var n10: [u8; 7] = "k_bind\0"
    var n11: [u8; 6] = "k_abi\0"
    var n13: [u8; 8] = "k_fwreq\0"
    var n12: [u8; 6] = "kdata\0"
    if i == S_KDATA { serial.puts((&n12[0]) as u64) ; return }
    if i == S_PUTS { serial.puts((&n0[0]) as u64) ; return }
    if i == S_PUTC { serial.puts((&n1[0]) as u64) ; return }
    if i == S_DEC { serial.puts((&n2[0]) as u64) ; return }
    if i == S_HEX { serial.puts((&n3[0]) as u64) ; return }
    if i == S_NL { serial.puts((&n4[0]) as u64) ; return }
    if i == S_TEXT { serial.puts((&n5[0]) as u64) ; return }
    if i == S_GET { serial.puts((&n6[0]) as u64) ; return }
    if i == S_SET { serial.puts((&n7[0]) as u64) ; return }
    if i == S_GET8 { serial.puts((&n8[0]) as u64) ; return }
    if i == S_SET8 { serial.puts((&n9[0]) as u64) ; return }
    if i == S_BIND { serial.puts((&n10[0]) as u64) ; return }
    if i == S_ABI { serial.puts((&n11[0]) as u64) ; return }
    if i == S_FWREQ { serial.puts((&n13[0]) as u64) ; return }
}

fn eq(a: u64, b: u64) -> bool {
    var i: u64 = 0
    while i < 64 {
        let x: u64 = kstate.get8(a + i)
        let y: u64 = kstate.get8(b + i)
        if x != y {
            return false
        }
        if x == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn such(name: u64) -> u64 {
    var np: [u8; 11] = "osum_panic\0"
    if eq(name, (&np[0]) as u64) {
        return panic_addr()
    }
    var i: u64 = 0
    while i < N_SYM {
        if such_ist(name, i) {
            return addr_at(i)
        }
        i = i + 1
    }
    return 0
}

fn such_ist(name: u64, i: u64) -> bool {
    var n0: [u8; 7] = "k_puts\0"
    var n1: [u8; 7] = "k_putc\0"
    var n2: [u8; 6] = "k_dec\0"
    var n3: [u8; 6] = "k_hex\0"
    var n4: [u8; 5] = "k_nl\0"
    var n5: [u8; 7] = "k_text\0"
    var n6: [u8; 6] = "k_get\0"
    var n7: [u8; 6] = "k_set\0"
    var n8: [u8; 7] = "k_get8\0"
    var n9: [u8; 7] = "k_set8\0"
    var n10: [u8; 7] = "k_bind\0"
    var n11: [u8; 6] = "k_abi\0"
    var n13: [u8; 8] = "k_fwreq\0"
    var n12: [u8; 6] = "kdata\0"
    if i == S_KDATA { return eq(name, (&n12[0]) as u64) }
    if i == S_PUTS { return eq(name, (&n0[0]) as u64) }
    if i == S_PUTC { return eq(name, (&n1[0]) as u64) }
    if i == S_DEC { return eq(name, (&n2[0]) as u64) }
    if i == S_HEX { return eq(name, (&n3[0]) as u64) }
    if i == S_NL { return eq(name, (&n4[0]) as u64) }
    if i == S_TEXT { return eq(name, (&n5[0]) as u64) }
    if i == S_GET { return eq(name, (&n6[0]) as u64) }
    if i == S_SET { return eq(name, (&n7[0]) as u64) }
    if i == S_GET8 { return eq(name, (&n8[0]) as u64) }
    if i == S_SET8 { return eq(name, (&n9[0]) as u64) }
    if i == S_BIND { return eq(name, (&n10[0]) as u64) }
    if i == S_ABI { return eq(name, (&n11[0]) as u64) }
    if i == S_FWREQ { return eq(name, (&n13[0]) as u64) }
    return false
}

const V_PANIC: u64 = 73

fn panic_addr() -> u64 {
    let v: u64 = kstate.get(kstate_basis(), kstate.VECTORS)
    if v == 0 {
        return 0
    }
    return __mmio_read64((v + V_PANIC * 8) as *mut u64)
}

fn kstate_basis() -> u64 {
    return asm("lea rax, [rip + kdata]", out("rax"))
}
