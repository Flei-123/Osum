
profile kernel

import lib.kstate
import serial
import fs.fs
import fs.vfs
import fs.vfsops
import fs.mnt
import block.part

export { ab_boot, esp_flip, LIMIT, LEN }

const LIMIT: u64 = 3
const LEN: u64 = 36

const P_ERP_LEN: u64 = 18
const AKT_LEN: u64 = 9

fn p8(p: u64, v: u64) {
    kstate.set8(p, v as u8)
}

fn ziffern(p: u64, off: u64, n: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while i < n {
        let c: u64 = kstate.get8(p + off + i)
        if c < 48 || c > 57 {
            return 0xFFFFFFFFFFFFFFFF
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

fn set(p: u64, off: u64, n: u64, v: u64) {
    var rest: u64 = v
    var i: u64 = n
    while i > 0 {
        i = i - 1
        p8(p + off + i, 48 + (rest % 10))
        rest = rest / 10
    }
}

fn build(p: u64, gen: u64, before: u64, v: u64, ok: u64) {
    var muster: [u8; 37] = "gen=00000000 vor=00000000 v=00 ok=0\n\0"
    var i: u64 = 0
    while i < LEN {
        p8(p + i, muster[i as usize] as u64)
        i = i + 1
    }
    set(p, 4, 8, gen)
    set(p, 17, 8, before)
    set(p, 28, 2, v)
    set(p, 34, 1, ok)
}

fn commit_write(state: u64, path_v: u64, buffer: u64, len: u64) -> bool {
    let ino: u64 = fs.path(state, path_v)
    if ino == 0 {
        return false
    }
    return fs.write_at(state, ino, 0, buffer, len) == len
}

fn existing_path(state: u64, fresh: u64, old: u64) -> u64 {
    if fs.path(state, fresh) != 0 {
        return fresh
    }
    return old
}

fn esp_flip(state: u64) -> u64 {
    var p_mnt: [u8; 5] = "/mnt\0"
    var p_cfg: [u8; 17] = "/mnt/limine.conf\0"
    var pat: [u8; 16] = "default_entry: \0"
    var s_none: [u8; 17] = "ab: esp: no gpt\0\0"
    var s_nomnt: [u8; 24] = "ab: esp: mount failed\0\0\0"
    var s_nocfg: [u8; 25] = "ab: esp: no limine.conf\0\0"
    var s_flip: [u8; 32] = "ab: esp: default_entry set to 1\0"
    var s_already: [u8; 29] = "ab: esp: default_entry is 1\0\0"
    var s_noline: [u8; 28] = "ab: esp: no default_entry\0\0\0"
    var s_werr: [u8; 24] = "ab: esp: write failed\0\0\0"
    var buf: [u8; 256] = [0 as u8; 256]
    let b: u64 = (&buf[0]) as u64

    if !vfs.ready(state) {
        return 0
    }
    let dev: u64 = mnt.dev(state, 0)
    let nparts: u64 = part.scan(state, dev)
    if nparts == 0 {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return 0
    }
    var pick: u64 = part.find_kind(state, dev, part.T_EFI)
    if pick >= part.MAX_PARTS {
        pick = part.find_kind(state, dev, part.T_FAT32)
    }
    if pick >= part.MAX_PARTS {
        serial.puts((&s_none[0]) as u64)
        serial.nl()
        return 0
    }
    let m: u64 = vfs.mount_at(state, vfsops.FS_FAT, dev, part.start(state, pick),
        part.blocks(state, pick), (&p_mnt[0]) as u64, 0)
    if m >= vfs.MAX_MNT {
        serial.puts((&s_nomnt[0]) as u64)
        serial.nl()
        return 2
    }
    var res: u64 = 0
    let node: u64 = vfs.node_for(state, m, (&p_cfg[0]) as u64)
    if node == 0 {
        serial.puts((&s_nocfg[0]) as u64)
        serial.nl()
    } else {
        let size: u64 = vfs.v_attr(state, m, node, vfsops.A_SIZE)
        var off: u64 = 0
        var stop: bool = false
        while off < size && !stop && res == 0 {
            let n: u64 = vfs.v_read(state, m, node, off, b, 256)
            if n == 0 {
                stop = true
            } else {
                var i: u64 = 0
                while i + 16 <= n && res == 0 {
                    var hit: bool = true
                    var k: u64 = 0
                    while k < 15 && hit {
                        if kstate.get8(b + i + k) != (pat[k as usize] as u64) {
                            hit = false
                        }
                        k = k + 1
                    }
                    if hit {
                        var bol: bool = false
                        if i == 0 && off == 0 {
                            bol = true
                        }
                        if i > 0 && kstate.get8(b + i - 1) == 10 {
                            bol = true
                        }
                        var term: bool = false
                        if i + 16 < n {
                            let t: u64 = kstate.get8(b + i + 16)
                            if t == 10 || t == 13 {
                                term = true
                            }
                        } else {
                            if off + n >= size {
                                term = true
                            }
                        }
                        if bol && term {
                            let c: u64 = kstate.get8(b + i + 15)
                            if c == 49 {
                                res = 3
                            } else {
                                if c >= 50 && c <= 57 {
                                    p8(b + i + 15, 49)
                                    let w: u64 = vfs.v_write(state, m, node,
                                        off + i + 15, b + i + 15, 1)
                                    if w == 1 {
                                        res = 1
                                        serial.puts((&s_flip[0]) as u64)
                                        serial.nl()
                                    } else {
                                        res = 2
                                    }
                                }
                            }
                        }
                    }
                    i = i + 1
                }
                if n < 256 {
                    stop = true
                } else {
                    off = off + 224
                }
            }
        }
        if res == 0 {
            serial.puts((&s_noline[0]) as u64)
            serial.nl()
        }
        if res == 3 {
            serial.puts((&s_already[0]) as u64)
            serial.nl()
        }
        if res == 2 {
            serial.puts((&s_werr[0]) as u64)
            serial.nl()
        }
    }
    vfs.umount_path(state, (&p_mnt[0]) as u64)
    return res
}

fn ab_boot(state: u64) {
    var p_trial: [u8; 14] = "/system/TRIAL\0"
    var p_trial_old: [u8; 18] = "/system/ERPROBUNG\0"
    var p_cur: [u8; 16] = "/system/CURRENT\0"
    var p_cur_old: [u8; 16] = "/system/AKTUELL\0"
    var s_notrial: [u8; 13] = "ab: no trial\0"
    var s_broken: [u8; 21] = "ab: TRIAL unreadable\0"
    var s_ok: [u8; 13] = "ab: gen=\0\0\0\0\0"
    var s_best: [u8; 11] = " confirmed\0"
    var s_ver: [u8; 10] = " attempt=\0"
    var s_von: [u8; 5] = " of \0"
    var s_zur: [u8; 27] = "ab: TRIAL failed, back to \0"
    var s_wnok: [u8; 23] = "ab: TRIAL not writable\0"

    var buf: [u8; 40] = [0 as u8; 40]
    let b: u64 = (&buf[0]) as u64

    let trial_file: u64 = existing_path(state, (&p_trial[0]) as u64, (&p_trial_old[0]) as u64)
    let current_file: u64 = existing_path(state, (&p_cur[0]) as u64, (&p_cur_old[0]) as u64)
    let ino: u64 = fs.path(state, trial_file)
    if ino == 0 {
        serial.puts((&s_notrial[0]) as u64)
        serial.nl()
        return
    }
    let n: u64 = fs.read_at(state, ino, 0, b, LEN)
    if n != LEN {
        serial.puts((&s_broken[0]) as u64)
        serial.nl()
        return
    }
    let gen: u64 = ziffern(b, 4, 8)
    let before: u64 = ziffern(b, 17, 8)
    let v: u64 = ziffern(b, 28, 2)
    let ok: u64 = ziffern(b, 34, 1)
    if gen == 0xFFFFFFFFFFFFFFFF || before == 0xFFFFFFFFFFFFFFFF
        || v == 0xFFFFFFFFFFFFFFFF || ok == 0xFFFFFFFFFFFFFFFF {
        serial.puts((&s_broken[0]) as u64)
        serial.nl()
        return
    }

    if ok != 0 {
        serial.puts((&s_ok[0]) as u64)
        serial.dec(gen)
        serial.puts((&s_best[0]) as u64)
        serial.nl()
        return
    }

    if v + 1 >= LIMIT {
        var akt: [u8; 12] = [0 as u8; 12]
        let a: u64 = (&akt[0]) as u64
        set(a, 0, 8, before)
        p8(a + 8, 10)
        if !commit_write(state, current_file, a, AKT_LEN) {
            serial.puts((&s_wnok[0]) as u64)
            serial.nl()
            return
        }
        build(b, before, before, 0, 1)
        if !commit_write(state, trial_file, b, LEN) {
            serial.puts((&s_wnok[0]) as u64)
            serial.nl()
            return
        }
        serial.puts((&s_zur[0]) as u64)
        serial.dec(before)
        serial.nl()
        let _flip: u64 = esp_flip(state)
        return
    }

    build(b, gen, before, v + 1, 0)
    if !commit_write(state, trial_file, b, LEN) {
        serial.puts((&s_wnok[0]) as u64)
        serial.nl()
        return
    }
    serial.puts((&s_ok[0]) as u64)
    serial.dec(gen)
    serial.puts((&s_ver[0]) as u64)
    serial.dec(v + 1)
    serial.puts((&s_von[0]) as u64)
    serial.dec(LIMIT)
    serial.nl()
}
