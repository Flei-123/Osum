
export {
    neg, is_error,
    E_PERM, E_NOENT, E_SRCH, E_INTR, E_IO, E_NXIO, E_2BIG, E_NOEXEC,
    E_BADF, E_CHILD, E_AGAIN, E_NOMEM, E_ACCES, E_FAULT, E_BUSY, E_EXIST,
    E_XDEV, E_NODEV, E_NOTDIR, E_ISDIR, E_INVAL, E_NFILE, E_MFILE,
    E_NOTTY, E_FBIG, E_NOSPC, E_SPIPE, E_ROFS, E_MLINK, E_PIPE,
    E_NAMETOOLONG, E_NOSYS, E_NOTEMPTY, E_OVERFLOW, E_RANGE, E_LOOP, E_NODATA,
    E_DESTADDRREQ, E_MSGSIZE, E_PROTONOSUPPORT, E_OPNOTSUPP,
    E_AFNOSUPPORT, E_ADDRINUSE, E_ADDRNOTAVAIL, E_NETUNREACH,
    E_CONNRESET, E_NOTCONN, E_TIMEDOUT, E_CONNREFUSED,
    E_STALE, E_CANCELED,
    E_HOSTUNREACH, E_ALREADY, E_INPROGRESS, E_ISCONN, E_NOLCK, E_NOPROTOOPT,
}

