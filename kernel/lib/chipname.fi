// SPDX-License-Identifier: GPL-2.0-only
// kernel/chipname.fi -- Runde BLECH: DER CHIP SAGT SEINEN NAMEN.
//
// Der Eigner hat den igc-Treiber abbestellt und stattdessen das hier
// bestellt:
//
//     "Nummern ja, Treiber nein. Beim Start soll Osum sagen
//      'Intel I226-V (8086:125C) erkannt, kein Treiber' statt zu
//      schweigen."
//
// Das ist die richtige Entscheidung, und der Grund steht in seinem
// eigenen Satz von weiter oben: lieber vier Karten, die wirklich
// laufen, als acht halbe. Ein igc-Treiber waere zu hundert Prozent
// ungemessen gewesen -- QEMU 7.2 kennt weder `igb` noch `igc`, und der
// Chip teilt mit dem gemessenen e1000 NICHTS: anderes Deskriptorformat,
// andere Warteschlangenregister, anderer Unterbrechungsblock. Acht-
// hundert ungeprueft Zeilen KERNcode sind kein Gewinn, sondern ein
// Absturzkandidat an der Stelle, an der ein Fehler das ganze System
// mitnimmt.
//
// ------------------------------------------------ WAS DAS HIER LEISTET
//
// Vor dieser Datei stand auf der Leitung:
//
//     netdev: no driver for 0x8086:0x125c
//
// Danach steht dort:
//
//     netdev: kein Treiber fuer Intel I226-V (8086:125c)
//       -- igc-Silizium, nur erweiterte Deskriptoren
//
// Der Unterschied ist keine Kosmetik. Wer vor einem fremden Brett
// steht, hat drei Fragen: WAS steckt da, WARUM laeuft es nicht, und
// KANN ICH ETWAS TUN. Die Nummer allein beantwortet keine davon -- sie
// verlangt ein zweites Geraet mit Netz, um sie nachzuschlagen, und
// genau das fehlt oft gerade dann.
//
// ================================================== WOHER DIE NAMEN SIND
//
// Jede Nummer in dieser Datei stammt aus einer der drei Quellen, und
// hinter jedem Block steht, aus welcher. Nichts hier ist aus dem
// Gedaechtnis geschrieben.
//
//   [P]  pci.ids, Fassung 2026-09-02, von pci-ids.ucw.cz. Das ist die
//        Liste, aus der `lspci` seine Klartextnamen nimmt.
//   [L]  Der Linux-Quelltext, Zweig master, ueber git.kernel.org:
//          drivers/net/ethernet/intel/igc/igc_hw.h      (I225/I226)
//          drivers/net/ethernet/intel/igb/e1000_hw.h    (I210/I211/I350)
//          drivers/net/ethernet/intel/e1000e/hw.h       (I219)
//          drivers/net/ethernet/aquantia/atlantic/aq_common.h (AQC)
//   [PL] beide, und sie stimmen ueberein.
//
// DIE GEGENPROBE IST GELAUFEN, und sie hat diese Datei verbessert.
// `tools/metal/chipnames.py` liest jede Behauptung aus DIESEM Quelltext
// und haelt sie gegen pci.ids. Beim ersten Lauf standen 40 Namen
// richtig, 14 falsch und 6 nicht in pci.ids. Die 14 waren echte Fehler,
// und sie sind hier korrigiert:
//
//   * 8086:02F0, 43F0, 4DF0, 51F0, 51F1, 7AF0, 7E40 hiessen hier
//     "AX201" bzw. "AX211". FALSCH. Das sind CNVi-Anschluesse im
//     Chipsatz, nicht das Funkmodul: welches Modul dranhaengt (AX201,
//     AX203, AX211, AX411, Wireless-AC 9560), steht erst in der
//     Subsystemnummer. Jetzt sagt die Zeile genau das.
//   * 1D6A:80B1 hiess "AQC107". Es ist ein AQC100S. [PL]
//   * 1969:E0B1 hiess "Killer E2600". Es ist ein Killer E2500. [P]
//   * 8086:125E hiess "I225/I226". Es ist ein I221-V. [L]
//   * 8086:3101 hiess "I225/I226". pci.ids nennt es Killer E3100X,
//     Linux nennt es I225-K2 -- beides stimmt, also steht beides da.
//
// Das ist der Grund, warum es die Gegenprobe gibt: eine Namenstabelle,
// die niemand nachgerechnet hat, ist schlimmer als keine. Sie schickt
// den Menschen vor dem Brett in die falsche Richtung, und er glaubt
// ihr, weil sie so bestimmt klingt.
//
// ------------------------------------------------------- DIE REGELN
//
//   1. DIE NUMMERN WERDEN IMMER GEDRUCKT, auch wenn der Name bekannt
//      ist. Der Name ist eine Beigabe; die Nummer ist der Beweis. Wenn
//      diese Tabelle irrt, sieht man es sofort.
//   2. WO DER NAME UNSICHER IST, STEHT NUR DER HERSTELLER. "Broadcom-
//      Chip (14e4:1686)" ist ehrlich und trotzdem brauchbar; ein
//      erfundener Modellname waere schlimmer als gar keiner, weil er
//      die Suche in die falsche Richtung schickt.
//   3. DIESE DATEI ENTSCHEIDET NICHTS. Sie druckt. Welcher Treiber
//      genommen wird, steht in `netdev.driver_for` und
//      `blkdev.driver_for` -- eine Namenstabelle, die anfaengt
//      mitzureden, ist ein Treiber im Versteck.

profile kernel

import serial
import bus.pci

export {
    net, storage, vendor, has_name,
    intel_igc, intel_igb, intel_i219, intel_wifi, intel_e1000,
    realtek_net,
    VEN_INTEL, VEN_REALTEK, VEN_BROADCOM, VEN_ATHEROS, VEN_QUALCOMM,
    VEN_AQUANTIA, VEN_MARVELL, VEN_MELLANOX, VEN_VIRTIO, VEN_AMD,
    VEN_NVIDIA, VEN_SAMSUNG, VEN_SANDISK, VEN_PHISON, VEN_SILMOTION,
    VEN_KIOXIA, VEN_MICRON, VEN_SKHYNIX, VEN_ASMEDIA, VEN_JMICRON,
    VEN_LSI, VEN_ADAPTEC, VEN_VMWARE, VEN_QEMU, VEN_MEDIATEK, VEN_DEC
}

const VEN_INTEL: u64 = 0x8086
const VEN_REALTEK: u64 = 0x10EC
const VEN_BROADCOM: u64 = 0x14E4
const VEN_ATHEROS: u64 = 0x168C
const VEN_QUALCOMM: u64 = 0x1969
const VEN_AQUANTIA: u64 = 0x1D6A
const VEN_MARVELL: u64 = 0x11AB
const VEN_MELLANOX: u64 = 0x15B3
const VEN_VIRTIO: u64 = 0x1AF4
const VEN_AMD: u64 = 0x1022
const VEN_NVIDIA: u64 = 0x10DE
const VEN_SAMSUNG: u64 = 0x144D
const VEN_SANDISK: u64 = 0x15B7
const VEN_PHISON: u64 = 0x1987
const VEN_SILMOTION: u64 = 0x126F
const VEN_KIOXIA: u64 = 0x1E0F
const VEN_MICRON: u64 = 0x1344
const VEN_SKHYNIX: u64 = 0x1C5C
const VEN_ASMEDIA: u64 = 0x1B21
const VEN_JMICRON: u64 = 0x197B
const VEN_LSI: u64 = 0x1000
const VEN_ADAPTEC: u64 = 0x9005
const VEN_VMWARE: u64 = 0x15AD
const VEN_QEMU: u64 = 0x1B36
const VEN_MEDIATEK: u64 = 0x14C3
const VEN_DEC: u64 = 0x1011

// ------------------------------------------------------ Hersteller
//
// Diese Liste ist die sichere: eine Herstellernummer aendert sich nie,
// und ein falscher Herstellername waere ein grober Fehler, kein
// feiner. `true` heisst "ich habe etwas gedruckt".
fn vendor(ven: u64) -> bool {
    var s_intel: [u8; 6] = "Intel\0"
    var s_rtk: [u8; 8] = "Realtek\0"
    var s_bcm: [u8; 9] = "Broadcom\0"
    var s_ath: [u8; 8] = "Atheros\0"
    var s_qca: [u8; 9] = "Qualcomm\0"
    var s_aqu: [u8; 17] = "Aquantia/Marvell\0"
    var s_mrv: [u8; 8] = "Marvell\0"
    var s_mlx: [u8; 9] = "Mellanox\0"
    var s_vir: [u8; 7] = "virtio\0"
    var s_amd: [u8; 4] = "AMD\0"
    var s_nv: [u8; 7] = "Nvidia\0"
    var s_sam: [u8; 8] = "Samsung\0"
    var s_snd: [u8; 11] = "SanDisk/WD\0"
    var s_phi: [u8; 7] = "Phison\0"
    var s_sil: [u8; 15] = "Silicon Motion\0"
    var s_kio: [u8; 7] = "Kioxia\0"
    var s_mic: [u8; 7] = "Micron\0"
    var s_hyn: [u8; 9] = "SK hynix\0"
    var s_asm: [u8; 8] = "ASMedia\0"
    var s_jm: [u8; 8] = "JMicron\0"
    var s_lsi: [u8; 13] = "LSI/Broadcom\0"
    var s_adp: [u8; 8] = "Adaptec\0"
    var s_vmw: [u8; 7] = "VMware\0"
    var s_qem: [u8; 5] = "QEMU\0"
    var s_mtk: [u8; 9] = "MediaTek\0"
    var s_dec: [u8; 4] = "DEC\0"
    if ven == VEN_INTEL {
        serial.puts((&s_intel[0]) as u64)
        return true
    }
    if ven == VEN_REALTEK {
        serial.puts((&s_rtk[0]) as u64)
        return true
    }
    if ven == VEN_BROADCOM {
        serial.puts((&s_bcm[0]) as u64)
        return true
    }
    if ven == VEN_ATHEROS {
        serial.puts((&s_ath[0]) as u64)
        return true
    }
    if ven == VEN_QUALCOMM {
        serial.puts((&s_qca[0]) as u64)
        return true
    }
    if ven == VEN_AQUANTIA {
        serial.puts((&s_aqu[0]) as u64)
        return true
    }
    if ven == VEN_MARVELL {
        serial.puts((&s_mrv[0]) as u64)
        return true
    }
    if ven == VEN_MELLANOX {
        serial.puts((&s_mlx[0]) as u64)
        return true
    }
    if ven == VEN_VIRTIO {
        serial.puts((&s_vir[0]) as u64)
        return true
    }
    if ven == VEN_AMD {
        serial.puts((&s_amd[0]) as u64)
        return true
    }
    if ven == VEN_NVIDIA {
        serial.puts((&s_nv[0]) as u64)
        return true
    }
    if ven == VEN_SAMSUNG {
        serial.puts((&s_sam[0]) as u64)
        return true
    }
    if ven == VEN_SANDISK {
        serial.puts((&s_snd[0]) as u64)
        return true
    }
    if ven == VEN_PHISON {
        serial.puts((&s_phi[0]) as u64)
        return true
    }
    if ven == VEN_SILMOTION {
        serial.puts((&s_sil[0]) as u64)
        return true
    }
    if ven == VEN_KIOXIA {
        serial.puts((&s_kio[0]) as u64)
        return true
    }
    if ven == VEN_MICRON {
        serial.puts((&s_mic[0]) as u64)
        return true
    }
    if ven == VEN_SKHYNIX {
        serial.puts((&s_hyn[0]) as u64)
        return true
    }
    if ven == VEN_ASMEDIA {
        serial.puts((&s_asm[0]) as u64)
        return true
    }
    if ven == VEN_JMICRON {
        serial.puts((&s_jm[0]) as u64)
        return true
    }
    if ven == VEN_LSI {
        serial.puts((&s_lsi[0]) as u64)
        return true
    }
    if ven == VEN_ADAPTEC {
        serial.puts((&s_adp[0]) as u64)
        return true
    }
    if ven == VEN_VMWARE {
        serial.puts((&s_vmw[0]) as u64)
        return true
    }
    if ven == VEN_QEMU {
        serial.puts((&s_qem[0]) as u64)
        return true
    }
    if ven == VEN_MEDIATEK {
        serial.puts((&s_mtk[0]) as u64)
        return true
    }
    if ven == VEN_DEC {
        serial.puts((&s_dec[0]) as u64)
        return true
    }
    return false
}

// ======================================================= I225 / I226
//
// Das igc-Silizium. VOLLSTAENDIG nach Linux `igc/igc_hw.h` -- alle
// sechzehn Nummern, die der Treiber dort auffuehrt. Sechs davon kennt
// pci.ids nicht; sie stehen trotzdem hier, weil der Linux-Quelltext
// fuer eine Geraetenummer die staerkere Quelle ist als eine Liste, die
// von Freiwilligen gepflegt wird. Die Herkunft steht an der Zeile.
//
// WARUM DIESE FAMILIE EINE EIGENE FUNKTION HAT: sie ist der Anlass der
// Entscheidung. Wer spaeter den igc-Treiber baut, findet hier die
// Nummernliste fertig und muss sie nicht noch einmal zusammensuchen --
// `netdev.driver_for` bekommt dann eine Zeile, und diese Funktion
// bleibt, wie sie ist.
fn intel_igc(dev: u64, say: bool) -> bool {
    var s_225lm: [u8; 15] = "I225-LM (2,5G)\0"
    var s_225v: [u8; 14] = "I225-V (2,5G)\0"
    var s_225i: [u8; 14] = "I225-I (2,5G)\0"
    var s_225k: [u8; 14] = "I225-K (2,5G)\0"
    var s_225k2: [u8; 31] = "I225-K2 / Killer E3100X (2,5G)\0"
    var s_225lmvp: [u8; 17] = "I225-LMvP (2,5G)\0"
    var s_225it: [u8; 15] = "I225-IT (2,5G)\0"
    var s_226lm: [u8; 15] = "I226-LM (2,5G)\0"
    var s_226v: [u8; 14] = "I226-V (2,5G)\0"
    var s_226it: [u8; 15] = "I226-IT (2,5G)\0"
    var s_226k: [u8; 14] = "I226-K (2,5G)\0"
    var s_226lmvp: [u8; 17] = "I226-LMvP (2,5G)\0"
    var s_220v: [u8; 14] = "I220-V (2,5G)\0"
    var s_221v: [u8; 14] = "I221-V (2,5G)\0"
    var s_blank: [u8; 32] = "I225/I226 (2,5G, leeres NVM)\0\0\0\0"
    if dev == 0x15F2 {
        if say {
            serial.puts((&s_225lm[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x15F3 {
        if say {
            serial.puts((&s_225v[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x15F8 {
        if say {
            serial.puts((&s_225i[0]) as u64) // [L] IGC_DEV_ID_I225_I
        }
        return true
    }
    if dev == 0x3100 {
        if say {
            serial.puts((&s_225k[0]) as u64) // [L] IGC_DEV_ID_I225_K
        }
        return true
    }
    // Dieselbe Nummer, zwei richtige Namen: Linux nennt sie I225-K2,
    // pci.ids nennt sie nach dem Aufkleber auf der Karte. Auf einem
    // Gaming-Brett steht "Killer" im Handbuch, nicht "I225" -- also
    // beides, sonst sucht der Mensch das Falsche.
    if dev == 0x3101 {
        if say {
            serial.puts((&s_225k2[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x5502 {
        if say {
            serial.puts((&s_225lmvp[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x0D9F {
        if say {
            serial.puts((&s_225it[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x125B {
        if say {
            serial.puts((&s_226lm[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x125C {
        if say {
            serial.puts((&s_226v[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x125D {
        if say {
            serial.puts((&s_226it[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x3102 {
        if say {
            serial.puts((&s_226k[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x5503 {
        if say {
            serial.puts((&s_226lmvp[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x15F7 {
        if say {
            serial.puts((&s_220v[0]) as u64) // [L] IGC_DEV_ID_I220_V
        }
        return true
    }
    // Der Fehler, den die Gegenprobe gefunden hat: 125E ist KEIN I226.
    if dev == 0x125E {
        if say {
            serial.puts((&s_221v[0]) as u64) // [L] IGC_DEV_ID_I221_V
        }
        return true
    }
    // Karten mit unbeschriebenem NVM. Sie melden sich so ab Werk, bevor
    // die Firmware die richtige Nummer einbrennt -- wer die sieht, hat
    // kein defektes Brett, sondern ein unfertiges.
    if dev == 0x15FD || dev == 0x125F {
        if say {
            serial.puts((&s_blank[0]) as u64) // [L] *_BLANK_NVM
        }
        return true
    }
    return false
}

// ================================================ I210 / I211 / I350
//
// Das igb-Silizium, nach Linux `igb/e1000_hw.h`. Die 82575/82576/82580
// gehoeren zur selben Treiberfamilie und stehen deshalb mit dabei --
// wer eine Serverkarte aus dieser Reihe einsteckt, bekommt dieselbe
// Auskunft und denselben Bauplan.
fn intel_igb(dev: u64, say: bool) -> bool {
    var s_210: [u8; 10] = "I210 (1G)\0"
    var s_210f: [u8; 21] = "I210 (1G, flashlos)\0\0"
    var s_210u: [u8; 27] = "I210 (1G, unprogrammiert)\0\0"
    var s_211: [u8; 10] = "I211 (1G)\0"
    var s_350: [u8; 10] = "I350 (1G)\0"
    var s_354: [u8; 12] = "I354 (2,5G)\0"
    var s_82575: [u8; 11] = "82575 (1G)\0"
    var s_82576: [u8; 11] = "82576 (1G)\0"
    var s_82580: [u8; 11] = "82580 (1G)\0"
    // I210: Kupfer, Faser, Rueckwand, SGMII -- vier Nummern, ein Chip.
    if dev == 0x1533 || dev == 0x1536 || dev == 0x1537 || dev == 0x1538 {
        if say {
            serial.puts((&s_210[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x157B || dev == 0x157C {
        if say {
            serial.puts((&s_210f[0]) as u64) // [L] I210_*_FLASHLESS
        }
        return true
    }
    if dev == 0x1531 {
        if say {
            serial.puts((&s_210u[0]) as u64) // [P] "I210 Gigabit Unprogrammed"
        }
        return true
    }
    if dev == 0x1539 {
        if say {
            serial.puts((&s_211[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x1521 || dev == 0x1522 || dev == 0x1523 || dev == 0x1524 {
        if say {
            serial.puts((&s_350[0]) as u64) // [PL]
        }
        return true
    }
    if dev == 0x1F40 || dev == 0x1F41 || dev == 0x1F45 {
        if say {
            serial.puts((&s_354[0]) as u64) // [L] I354_*
        }
        return true
    }
    if dev == 0x10A7 || dev == 0x10A9 || dev == 0x10D6 {
        if say {
            serial.puts((&s_82575[0]) as u64) // [L] 82575*
        }
        return true
    }
    if dev == 0x10C9 || dev == 0x10E6 || dev == 0x10E7 || dev == 0x10E8 {
        if say {
            serial.puts((&s_82576[0]) as u64) // [L] 82576*
        }
        return true
    }
    if dev == 0x1526 || dev == 0x150A || dev == 0x1518 || dev == 0x150D {
        if say {
            serial.puts((&s_82576[0]) as u64) // [L] 82576_*
        }
        return true
    }
    if dev == 0x150E || dev == 0x150F || dev == 0x1510 || dev == 0x1511 {
        if say {
            serial.puts((&s_82580[0]) as u64) // [L] 82580_*
        }
        return true
    }
    if dev == 0x1516 || dev == 0x1527 {
        if say {
            serial.puts((&s_82580[0]) as u64) // [L] 82580_*
        }
        return true
    }
    return false
}

// ============================================================== I219
//
// Der PCH-Anschluss, den `e1000.fi` in der Runde RTL gebaut hat -- und
// hier wird es interessant, weil dieser Kern einen TEIL der Familie
// treibt und den anderen nicht.
//
// Linux `e1000e/hw.h` fuehrt 53 I219-Nummern. `e1000.supports_ich`
// nennt davon 20 (dazu acht aeltere ICH8/ICH9/I218-Nummern). Die
// uebrigen 33 sind dieselbe Schaltung in einer neueren Bruecke --
// Tiger Lake, Alder Lake, Meteor Lake, Lunar Lake, Arrow Lake.
//
// WARUM SIE NICHT EINFACH DAZUKOMMEN. Genau aus dem Grund, aus dem der
// igc-Treiber gestrichen wurde. Eine Nummer in `supports_ich` ist keine
// Namenszeile, sondern eine ZUSAGE: "dieser Kern faehrt diesen Chip".
// Die neueren Bruecken brauchen in Linux eigene Handgriffe (ULP-
// Abschaltung, andere PHY-Weckfolge, K1-Zeitverhalten), und keiner
// davon ist hier gebaut oder gemessen. Die Nummer dazuzuschreiben
// waere derselbe Blindflug in klein.
//
// Was hier ABER geht, kostet nichts und hilft: den Namen kennen. Ein
// Notebook mit einem I219-V13 sagt dann
//
//     netdev: kein Treiber fuer Intel I219-V (8086:15fc)
//       -- I219, aber diese PCH-Stufe ist nicht freigegeben
//
// statt zu schweigen -- und im Bericht steht, was zu tun ist.
//
// Die LM/V-Unterscheidung ist echt und nicht kosmetisch: LM ist die
// Ausfuehrung mit Management-Engine (vPro), V die ohne. Wer eine LM vor
// sich hat, muss wissen, dass ihm die ME den PHY wegnehmen kann.
fn intel_i219(dev: u64, say: bool) -> bool {
    var s_lm: [u8; 13] = "I219-LM (1G)\0"
    var s_v: [u8; 12] = "I219-V (1G)\0"
    // --- LM, alle Bruecken. [L] E1000_DEV_ID_PCH_*_I219_LM*
    if dev == 0x156F || dev == 0x15B7 || dev == 0x15B9 || dev == 0x15D7 {
        if say {
            serial.puts((&s_lm[0]) as u64)
        }
        return true
    }
    if dev == 0x15E3 || dev == 0x15BD || dev == 0x15BB || dev == 0x15DF {
        if say {
            serial.puts((&s_lm[0]) as u64)
        }
        return true
    }
    if dev == 0x15E1 || dev == 0x0D4E || dev == 0x0D4C || dev == 0x0D53 {
        if say {
            serial.puts((&s_lm[0]) as u64)
        }
        return true
    }
    if dev == 0x15FB || dev == 0x15F9 || dev == 0x15F4 || dev == 0x0DC5 {
        if say {
            serial.puts((&s_lm[0]) as u64)
        }
        return true
    }
    if dev == 0x1A1E || dev == 0x1A1C || dev == 0x0DC7 || dev == 0x550A {
        if say {
            serial.puts((&s_lm[0]) as u64)
        }
        return true
    }
    if dev == 0x550C || dev == 0x550E || dev == 0x5510 || dev == 0x57A0 {
        if say {
            serial.puts((&s_lm[0]) as u64)
        }
        return true
    }
    if dev == 0x57B3 || dev == 0x57B7 || dev == 0x57B9 {
        if say {
            serial.puts((&s_lm[0]) as u64)
        }
        return true
    }
    // --- V, alle Bruecken. [L] E1000_DEV_ID_PCH_*_I219_V*
    //
    // EIN QUELLENKONFLIKT, und er ist geprueft: fuer 8086:550B sagt
    // pci.ids "Ethernet Connection (18) I219-LM" -- also LM --, Linux
    // sagt I219_V18. Hier gilt Linux, aus zwei Gruenden. Erstens hat
    // pci.ids fuer 550A und 550B WORTWOERTLICH denselben Text, was fuer
    // ein LM/V-Paar nicht sein kann; das sieht nach einem uebernommenen
    // Eintrag aus. Zweitens haengt an der LM/V-Unterscheidung im
    // e1000e-Treiber echtes Verhalten (Management-Engine, AMT), und
    // diese Zeilen kommen von Intel selbst. Bei allen anderen 52
    // Nummern stimmen beide Quellen ueberein.
    if dev == 0x1570 || dev == 0x15B8 || dev == 0x15D8 || dev == 0x15D6 {
        if say {
            serial.puts((&s_v[0]) as u64)
        }
        return true
    }
    if dev == 0x15BE || dev == 0x15BC || dev == 0x15E0 || dev == 0x15E2 {
        if say {
            serial.puts((&s_v[0]) as u64)
        }
        return true
    }
    if dev == 0x0D4F || dev == 0x0D4D || dev == 0x0D55 || dev == 0x15FC {
        if say {
            serial.puts((&s_v[0]) as u64)
        }
        return true
    }
    if dev == 0x15FA || dev == 0x15F5 || dev == 0x0DC6 || dev == 0x1A1F {
        if say {
            serial.puts((&s_v[0]) as u64)
        }
        return true
    }
    if dev == 0x1A1D || dev == 0x0DC8 || dev == 0x550B || dev == 0x550D {
        if say {
            serial.puts((&s_v[0]) as u64)
        }
        return true
    }
    if dev == 0x550F || dev == 0x5511 || dev == 0x57A1 || dev == 0x57B4 {
        if say {
            serial.puts((&s_v[0]) as u64)
        }
        return true
    }
    if dev == 0x57B8 || dev == 0x57BA {
        if say {
            serial.puts((&s_v[0]) as u64)
        }
        return true
    }
    return false
}

// ===================================================== Intel-WLAN
//
// KEIN Ethernet, und dieser Kern wird nie eine 802.11-Karte fahren --
// dafuer braucht es einen MAC-Aufsatz und eine Firmwaredatei, beides
// weit ausserhalb dieser Runde. Der Name steht trotzdem hier, aus einem
// praktischen Grund: In einem Laptop ist die WLAN-Karte oft das EINZIGE
// Netzgeraet. Wer dort "kein Treiber fuer 8086:2725" liest, soll nicht
// erst nachschlagen muessen, dass das die WLAN-Karte ist und der
// fehlende Ethernet-Anschluss gar nicht sein Problem.
//
// HIER STAND DER SCHLIMMSTE FEHLER DIESER DATEI. Sieben Nummern hiessen
// vorher "AX201" oder "AX211". Das ist falsch, und zwar auf die
// gefaehrliche Art: 8086:02F0 ist der CNVi-ANSCHLUSS in der Bruecke,
// nicht das Funkmodul. Am selben 02F0 kann ein AX201, ein AX203 oder
// ein Wireless-AC 9560 haengen; welches, steht erst in der
// Subsystemnummer, und die liest dieser Kern nicht. Wer nach "AX201"
// sucht, obwohl ein 9560 steckt, laedt die falsche Firmware.
fn intel_wifi(dev: u64, say: bool) -> bool {
    var s_ax200: [u8; 21] = "Wi-Fi 6 AX200 (WLAN)\0"
    var s_ax201: [u8; 21] = "Wi-Fi 6 AX201 (WLAN)\0"
    var s_ax210: [u8; 22] = "Wi-Fi 6E AX210 (WLAN)\0"
    var s_8260: [u8; 22] = "Wireless 8260 (WLAN)\0\0"
    var s_8265: [u8; 27] = "Wireless 8265/8275 (WLAN)\0\0"
    var s_7265: [u8; 21] = "Wireless 7265 (WLAN)\0"
    var s_cnvi: [u8; 45] = "CNVi-WLAN (Modul erst am Subsystem lesbar)\0\0\0"
    if dev == 0x2723 {
        if say {
            serial.puts((&s_ax200[0]) as u64) // [P]
        }
        return true
    }
    if dev == 0xA0F0 {
        if say {
            serial.puts((&s_ax201[0]) as u64) // [P] "Wi-Fi 6 AX201"
        }
        return true
    }
    if dev == 0x2725 {
        if say {
            serial.puts((&s_ax210[0]) as u64) // [P] AX210/AX1675
        }
        return true
    }
    if dev == 0x24F3 || dev == 0x24F4 {
        if say {
            serial.puts((&s_8260[0]) as u64) // [P]
        }
        return true
    }
    if dev == 0x24FD {
        if say {
            serial.puts((&s_8265[0]) as u64) // [P] "Wireless 8265 / 8275"
        }
        return true
    }
    if dev == 0x095A || dev == 0x095B {
        if say {
            serial.puts((&s_7265[0]) as u64) // [P]
        }
        return true
    }
    // Die CNVi-Anschluesse. [P] nennt sie nach der Bruecke, NICHT nach
    // dem Modul -- und genau so steht es jetzt hier.
    if dev == 0x02F0 || dev == 0x43F0 || dev == 0x4DF0 || dev == 0x51F0 {
        if say {
            serial.puts((&s_cnvi[0]) as u64)
        }
        return true
    }
    if dev == 0x51F1 || dev == 0x7AF0 || dev == 0x7E40 || dev == 0x7F70 {
        if say {
            serial.puts((&s_cnvi[0]) as u64)
        }
        return true
    }
    return false
}

// =============================================== 8254x / I217 / I218
//
// DIE CHIPS, DIE DIESER KERN WIRKLICH FAEHRT -- und deshalb gehoeren
// sie hierher. Der erste Entwurf dieser Datei kannte nur die Chips OHNE
// Treiber, und die Messung hat sofort gezeigt, wie schief das ist:
//
//     netdev: bestand 0x18 0x8086:0x100e Intel -> e1000
//
// "Intel" ist keine Auskunft. Wer eine Liste seiner Netzgeraete liest,
// will beim FUNKTIONIERENDEN Geraet genauso wissen, was da steckt --
// spaetestens beim zweiten Anschluss auf demselben Brett. [P] fuer
// alle vierzehn Nummern.
fn intel_e1000(dev: u64, say: bool) -> bool {
    var s_540: [u8; 15] = "82540EM (1G)\0\0\0"
    var s_545: [u8; 13] = "82545EM (1G)\0"
    var s_545g: [u8; 13] = "82545GM (1G)\0"
    var s_574: [u8; 12] = "82574L (1G)\0"
    var s_217lm: [u8; 13] = "I217-LM (1G)\0"
    var s_217v: [u8; 12] = "I217-V (1G)\0"
    var s_218lm: [u8; 13] = "I218-LM (1G)\0"
    var s_218v: [u8; 12] = "I218-V (1G)\0"
    if dev == 0x100E || dev == 0x1015 {
        if say {
            serial.puts((&s_540[0]) as u64) // [P] 82540EM
        }
        return true
    }
    if dev == 0x100F {
        if say {
            serial.puts((&s_545[0]) as u64) // [P] 82545EM
        }
        return true
    }
    if dev == 0x1026 || dev == 0x1028 {
        if say {
            serial.puts((&s_545g[0]) as u64) // [P] 82545GM
        }
        return true
    }
    if dev == 0x10D3 {
        if say {
            serial.puts((&s_574[0]) as u64) // [P] 82574L
        }
        return true
    }
    if dev == 0x153A {
        if say {
            serial.puts((&s_217lm[0]) as u64) // [P] I217-LM
        }
        return true
    }
    if dev == 0x153B {
        if say {
            serial.puts((&s_217v[0]) as u64) // [P] I217-V
        }
        return true
    }
    if dev == 0x155A || dev == 0x15A0 || dev == 0x15A2 {
        if say {
            serial.puts((&s_218lm[0]) as u64) // [P] I218-LM
        }
        return true
    }
    if dev == 0x1559 || dev == 0x15A1 || dev == 0x15A3 {
        if say {
            serial.puts((&s_218v[0]) as u64) // [P] I218-V
        }
        return true
    }
    return false
}

// Die vier Intel-Familien hintereinander. Reihenfolge egal -- die
// Nummernraeume ueberschneiden sich nicht.
fn intel_net(dev: u64, say: bool) -> bool {
    if intel_e1000(dev, say) {
        return true
    }
    if intel_igc(dev, say) {
        return true
    }
    if intel_igb(dev, say) {
        return true
    }
    if intel_i219(dev, say) {
        return true
    }
    if intel_wifi(dev, say) {
        return true
    }
    return false
}

// ========================================================== Realtek
//
// Der Hersteller, den der Eigner zuerst genannt hat -- und der einzige
// Block hier, in dem Zeilen stehen, die einen GEBAUTEN Treiber haben.
// Welcher das ist, entscheidet `netdev.driver_for`; hier steht nur der
// Name. [P] durchgaengig.
fn realtek_net(dev: u64, say: bool) -> bool {
    var s_8168: [u8; 19] = "RTL8111/8168/8411\0\0"
    var s_8169: [u8; 8] = "RTL8169\0"
    var s_8167: [u8; 19] = "RTL-8110SC/8169SC\0\0"
    var s_810x: [u8; 22] = "RTL810xE (100 MBit)\0\0\0"
    var s_8125: [u8; 20] = "RTL8125 (2,5 GBit)\0\0"
    var s_8126: [u8; 18] = "RTL8126 (5 GBit)\0\0"
    var s_e3000: [u8; 26] = "Killer E3000 (2,5 GBit)\0\0\0"
    var s_8139: [u8; 24] = "RTL8139 (100 MBit)\0\0\0\0\0\0"
    var s_8029: [u8; 19] = "RTL8029 (ne2000)\0\0\0"
    var s_wl: [u8; 24] = "Realtek-WLAN (802.11)\0\0\0"
    if dev == 0x8168 || dev == 0x8161 {
        if say {
            serial.puts((&s_8168[0]) as u64)
        }
        return true
    }
    if dev == 0x8169 {
        if say {
            serial.puts((&s_8169[0]) as u64)
        }
        return true
    }
    if dev == 0x8167 {
        if say {
            serial.puts((&s_8167[0]) as u64)
        }
        return true
    }
    if dev == 0x8136 {
        if say {
            serial.puts((&s_810x[0]) as u64)
        }
        return true
    }
    if dev == 0x8125 {
        if say {
            serial.puts((&s_8125[0]) as u64)
        }
        return true
    }
    if dev == 0x8126 {
        if say {
            serial.puts((&s_8126[0]) as u64)
        }
        return true
    }
    // Der Fehler aus der ersten Fassung von netdev.fi: 10EC:3000 ist
    // ein Killer E3000, NICHT E3100. Der E3100X ist 8086:3101 und ein
    // Intel. Zwei Hersteller, zwei Chips, aehnlicher Aufkleber.
    if dev == 0x3000 {
        if say {
            serial.puts((&s_e3000[0]) as u64)
        }
        return true
    }
    if dev == 0x8139 {
        if say {
            serial.puts((&s_8139[0]) as u64)
        }
        return true
    }
    if dev == 0x8029 {
        if say {
            serial.puts((&s_8029[0]) as u64)
        }
        return true
    }
    // Die WLAN-Bausteine. Modellnamen waeren hier moeglich, aber der
    // Nummernraum ist gross und die Verwechslungsgefahr auch -- also
    // die ehrliche Sammelauskunft.
    if dev == 0xC821 || dev == 0xC822 || dev == 0xB822 {
        if say {
            serial.puts((&s_wl[0]) as u64)
        }
        return true
    }
    if dev == 0xC852 || dev == 0xB852 {
        if say {
            serial.puts((&s_wl[0]) as u64)
        }
        return true
    }
    return false
}

// ================================================== die uebrigen
//
// Broadcom, Aquantia, Qualcomm/Atheros, Marvell, MediaTek. Hier ist die
// Auswahl bewusst duenn: aufgenommen ist, was in einem PC oder Notebook
// wirklich haeufig steckt, und nichts, dessen Nummer ich nicht in [P]
// oder [L] nachgeschlagen habe.
fn other_net(ven: u64, dev: u64, say: bool) -> bool {
    var s_5720: [u8; 21] = "NetXtreme BCM5720\0\0\0\0"
    var s_5719: [u8; 18] = "NetXtreme BCM5719\0"
    var s_5717: [u8; 18] = "NetXtreme BCM5717\0"
    var s_57766: [u8; 19] = "NetXtreme BCM57766\0"
    var s_57765: [u8; 19] = "NetXtreme BCM57765\0"
    var s_57781: [u8; 18] = "NetLink BCM57781\0\0"
    var s_bwl: [u8; 26] = "Broadcom-WLAN (802.11)\0\0\0\0"
    var s_aqc107: [u8; 13] = "AQC107 (10G)\0"
    var s_aqc107s: [u8; 14] = "AQC107S (10G)\0"
    var s_aqc100: [u8; 13] = "AQC100 (10G)\0"
    var s_aqc100s: [u8; 14] = "AQC100S (10G)\0"
    var s_aqc108: [u8; 12] = "AQC108 (5G)\0"
    var s_aqc108s: [u8; 13] = "AQC108S (5G)\0"
    var s_aqc113: [u8; 13] = "AQC113 (10G)\0"
    var s_aqc114: [u8; 14] = "AQC114CS (5G)\0"
    var s_aqc115: [u8; 15] = "AQC115C (2,5G)\0"
    var s_aqc116: [u8; 15] = "AQC116C (2,5G)\0"
    var s_ar8161: [u8; 12] = "AR8161 (1G)\0"
    var s_ar8162: [u8; 19] = "AR8162 (100 MBit)\0\0"
    var s_qca8171: [u8; 13] = "QCA8171 (1G)\0"
    var s_k2500: [u8; 18] = "Killer E2500 (1G)\0"
    var s_k2400: [u8; 18] = "Killer E2400 (1G)\0"
    var s_awl: [u8; 25] = "Atheros-WLAN (802.11)\0\0\0\0"
    var s_mt7921: [u8; 20] = "MT7921 (WLAN, 6)\0\0\0\0"
    var s_mt7922: [u8; 20] = "MT7922 (WLAN, 6E)\0\0\0"
    var s_88e8001: [u8; 20] = "Yukon 88E8001 (1G)\0\0"
    var s_88e8056: [u8; 20] = "Yukon 88E8056 (1G)\0\0"
    var s_vmx: [u8; 8] = "vmxnet3\0"
    var s_pcnet: [u8; 8] = "PCnet32\0"
    var s_tulip: [u8; 15] = "DECchip 21140\0\0"
    if ven == VEN_BROADCOM {
        if dev == 0x165F {
            if say {
                serial.puts((&s_5720[0]) as u64) // [P]
            }
            return true
        }
        if dev == 0x1657 {
            if say {
                serial.puts((&s_5719[0]) as u64) // [P]
            }
            return true
        }
        if dev == 0x1655 {
            if say {
                serial.puts((&s_5717[0]) as u64) // [P]
            }
            return true
        }
        if dev == 0x1686 {
            if say {
                serial.puts((&s_57766[0]) as u64) // [P]
            }
            return true
        }
        if dev == 0x16B4 {
            if say {
                serial.puts((&s_57765[0]) as u64) // [P]
            }
            return true
        }
        if dev == 0x16B1 {
            if say {
                serial.puts((&s_57781[0]) as u64) // [P]
            }
            return true
        }
        if dev == 0x43A0 || dev == 0x4331 || dev == 0x4353 || dev == 0x43B1 {
            if say {
                serial.puts((&s_bwl[0]) as u64) // [P]
            }
            return true
        }
        return false
    }
    if ven == VEN_AQUANTIA {
        if dev == 0x07B1 {
            if say {
                serial.puts((&s_aqc107[0]) as u64) // [PL]
            }
            return true
        }
        if dev == 0x87B1 {
            if say {
                serial.puts((&s_aqc107s[0]) as u64) // [PL]
            }
            return true
        }
        if dev == 0x00B1 {
            if say {
                serial.puts((&s_aqc100[0]) as u64) // [PL]
            }
            return true
        }
        // Die Gegenprobe hat hier "AQC107" widerlegt: 80B1 ist ein
        // AQC100S. [PL] sagen dasselbe, ich hatte es falsch.
        if dev == 0x80B1 {
            if say {
                serial.puts((&s_aqc100s[0]) as u64) // [PL]
            }
            return true
        }
        if dev == 0x08B1 {
            if say {
                serial.puts((&s_aqc108[0]) as u64) // [PL]
            }
            return true
        }
        if dev == 0x88B1 {
            if say {
                serial.puts((&s_aqc108s[0]) as u64) // [L] AQ_DEVICE_ID_AQC108S
            }
            return true
        }
        if dev == 0x04C0 || dev == 0x14C0 || dev == 0x94C0 {
            if say {
                serial.puts((&s_aqc113[0]) as u64) // [PL]
            }
            return true
        }
        if dev == 0x93C0 {
            if say {
                serial.puts((&s_aqc114[0]) as u64) // [PL]
            }
            return true
        }
        if dev == 0x12C0 {
            if say {
                serial.puts((&s_aqc115[0]) as u64) // [PL]
            }
            return true
        }
        if dev == 0x11C0 {
            if say {
                serial.puts((&s_aqc116[0]) as u64) // [L] AQ_DEVICE_ID_AQC116C
            }
            return true
        }
        return false
    }
    if ven == VEN_QUALCOMM {
        if dev == 0x1091 {
            if say {
                serial.puts((&s_ar8161[0]) as u64) // [P]
            }
            return true
        }
        if dev == 0x1090 {
            if say {
                serial.puts((&s_ar8162[0]) as u64) // [P]
            }
            return true
        }
        if dev == 0x10A1 {
            if say {
                serial.puts((&s_qca8171[0]) as u64) // [P]
            }
            return true
        }
        // Widerlegt: E0B1 hiess hier "Killer E2600". Es ist ein E2500.
        if dev == 0xE0B1 {
            if say {
                serial.puts((&s_k2500[0]) as u64) // [P]
            }
            return true
        }
        if dev == 0xE0A1 {
            if say {
                serial.puts((&s_k2400[0]) as u64) // [P]
            }
            return true
        }
        return false
    }
    if ven == VEN_ATHEROS {
        if say {
            serial.puts((&s_awl[0]) as u64) // 168C ist durchgaengig WLAN
        }
        return true
    }
    if ven == VEN_MEDIATEK {
        if dev == 0x7961 {
            if say {
                serial.puts((&s_mt7921[0]) as u64) // [P]
            }
            return true
        }
        if dev == 0x0616 || dev == 0x7922 {
            if say {
                serial.puts((&s_mt7922[0]) as u64) // [P]
            }
            return true
        }
        return false
    }
    if ven == VEN_MARVELL {
        if dev == 0x4320 {
            if say {
                serial.puts((&s_88e8001[0]) as u64) // [P]
            }
            return true
        }
        if dev == 0x4364 {
            if say {
                serial.puts((&s_88e8056[0]) as u64) // [P]
            }
            return true
        }
        return false
    }
    if ven == VEN_VMWARE {
        if dev == 0x07B0 {
            if say {
                serial.puts((&s_vmx[0]) as u64) // [P]
            }
            return true
        }
        return false
    }
    if ven == VEN_AMD {
        if dev == 0x2000 {
            if say {
                serial.puts((&s_pcnet[0]) as u64) // [P]
            }
            return true
        }
        return false
    }
    if ven == VEN_DEC {
        if dev == 0x0009 {
            if say {
                serial.puts((&s_tulip[0]) as u64) // [P]
            }
            return true
        }
        return false
    }
    return false
}

// DER EINE AUFRUF, den `netdev.fi` benutzt. Erst das Modell, sonst der
// Hersteller, sonst gar nichts -- und die Nummern druckt der Aufrufer
// in jedem Fall dahinter.
fn net(ven: u64, dev: u64) -> bool {
    if ven == VEN_INTEL {
        if intel_net(dev, true) {
            return true
        }
        return vendor(ven)
    }
    if ven == VEN_REALTEK {
        if realtek_net(dev, true) {
            return true
        }
        return vendor(ven)
    }
    if other_net(ven, dev, true) {
        return true
    }
    return vendor(ven)
}

// Dasselbe fuer Massenspeicher. Hier ist die Lage einfacher: die
// Controller heissen nach ihrer KLASSE (AHCI, NVMe), und die
// Modellnummer sagt weniger als der Hersteller. Deshalb steht hier fast
// nur der Hersteller -- das ist keine Luecke, sondern die richtige
// Auskunft: "Samsung-NVMe" ist alles, was man vor dem Brett braucht.
//
// Die zwei Ausnahmen sind die, die einen Start VERHINDERN: ein Intel-
// RST im RAID-Modus und ein MegaRAID. Beide sehen aus wie "keine
// Platte da", und beide sind es nicht.
fn storage(ven: u64, dev: u64) -> bool {
    var s_rst: [u8; 9] = "RST-RAID\0"
    var s_megaraid: [u8; 9] = "MegaRAID\0"
    if ven == VEN_INTEL && (dev == 0x2822 || dev == 0x282A || dev == 0x2826) {
        serial.puts((&s_rst[0]) as u64)
        return true
    }
    if ven == VEN_LSI && (dev == 0x0060 || dev == 0x0079 || dev == 0x005B) {
        serial.puts((&s_megaraid[0]) as u64)
        return true
    }
    return vendor(ven)
}

// "Wuerde `net` mehr sagen als die blosse Nummer?" -- fuer Aufrufer,
// die die Zeile anders setzen wollen, je nachdem.
// EIN FEHLER, DER HIER STAND. Diese Funktion rief `intel_net` und
// `other_net` OHNE Schalter -- und die druckten. Wer nur wissen wollte,
// OB es einen Namen gibt, bekam ihn mitten in eine fremde Zeile
// geschrieben. Genau deshalb tragen die Namensfunktionen jetzt ein
// `say`: dieselbe Nummernliste, zwei Verwendungen, keine zweite Liste,
// die veralten kann.
fn has_name(ven: u64, dev: u64) -> bool {
    if ven == VEN_INTEL {
        return intel_net(dev, false)
    }
    if ven == VEN_REALTEK {
        return realtek_net(dev, false)
    }
    return other_net(ven, dev, false)
}
