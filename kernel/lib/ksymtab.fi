
profile kernel

import lib.kstate
import serial
import libc.regio

export {
    have, n_sym, n_line,
    resolve, sym_addr, sym_name, line_of, line_file, line_nr, file_name,
    say_addr, say_addr_short, tab
}

const MAGIC: u64 = 0x314D59534F

const H_MAGIC: u64 = 0
const H_NSYM: u64 = 8
const H_NLINE: u64 = 16
const H_SADR: u64 = 24
const H_SNAM: u64 = 32
const H_STR: u64 = 40
const H_LINE: u64 = 48
const H_DVER: u64 = 56
const H_NDAT: u64 = 64
const H_DSTR: u64 = 72
const H_LO: u64 = 80
const H_HI: u64 = 88
const H_LSTR: u64 = 96
const LINE_BLK: u64 = 16

fn tab() -> u64 {
    return asm("lea rax, [rip + osym_tab]", out("rax"))
}

fn w(off: u64) -> u64 {
    return __mmio_read64((tab() + off) as *mut u64)
}

fn have() -> bool {
    return w(H_MAGIC) == MAGIC
}

fn n_sym() -> u64 {
    if !have() {
        return 0
    }
    return w(H_NSYM)
}

fn n_line() -> u64 {
    if !have() {
        return 0
    }
    return w(H_NLINE)
}

fn resolve(addr: u64) -> u64 {
    let n: u64 = n_sym()
    if n == 0 || addr < w(H_LO) || addr > w(H_HI) + 0x10000 {
        return n
    }
    let a: u64 = tab() + w(H_SADR)
    var lo: u64 = 0
    var hi: u64 = n
    while lo + 1 < hi {
        let mid: u64 = lo + (hi - lo) / 2
        if regio.read32(a + mid * 4) <= addr {
            lo = mid
        } else {
            hi = mid
        }
    }
    if regio.read32(a + lo * 4) > addr {
        return n
    }
    return lo
}

fn sym_addr(i: u64) -> u64 {
    if i >= n_sym() {
        return 0
    }
    return regio.read32(tab() + w(H_SADR) + i * 4)
}

fn sym_name(i: u64) -> u64 {
    if i >= n_sym() {
        return 0
    }
    return tab() + w(H_STR) + regio.read32(tab() + w(H_SNAM) + i * 4)
}

fn vsize(p: u64) -> u64 {
    var n: u64 = 1
    while kstate.get8(p + n - 1) >= 128 {
        n = n + 1
    }
    return n
}

fn vval(p: u64, n: u64) -> u64 {
    var v: u64 = 0
    var k: u64 = 0
    while k < n {
        v = v + ((kstate.get8(p + k) & 0x7F) << (k * 7))
        k = k + 1
    }
    return v
}

fn line_of(addr: u64) -> u64 {
    let n: u64 = n_line()
    if n == 0 {
        return 0
    }
    let idx: u64 = tab() + w(H_LINE)
    if addr < regio.read32(idx) {
        return 0
    }
    let nb: u64 = (n + LINE_BLK - 1) / LINE_BLK
    var lo: u64 = 0
    var hi: u64 = nb
    while lo + 1 < hi {
        let mid: u64 = lo + (hi - lo) / 2
        if regio.read32(idx + mid * 8) <= addr {
            lo = mid
        } else {
            hi = mid
        }
    }
    var cnt: u64 = n - lo * LINE_BLK
    if cnt > LINE_BLK {
        cnt = LINE_BLK
    }
    var p: u64 = tab() + w(H_LSTR) + regio.read32(idx + lo * 8 + 4)
    var cur: u64 = regio.read32(idx + lo * 8)
    var vn: u64 = vsize(p)
    var pk: u64 = vval(p, vn)
    p = p + vn
    var res: u64 = pk
    var k: u64 = 1
    while k < cnt {
        vn = vsize(p)
        let na: u64 = cur + vval(p, vn)
        p = p + vn
        vn = vsize(p)
        let z: u64 = vval(p, vn)
        p = p + vn
        if na > addr {
            return res
        }
        if (z & 1) != 0 {
            pk = pk - ((z + 1) >> 1)
        } else {
            pk = pk + (z >> 1)
        }
        cur = na
        res = pk
        k = k + 1
    }
    return res
}

fn line_nr(packed: u64) -> u64 {
    return packed & 0xFFFFF
}

fn line_file(packed: u64) -> u64 {
    return packed >> 20
}

fn file_name(f: u64) -> u64 {
    if !have() || f >= w(H_NDAT) {
        return 0
    }
    return tab() + w(H_DSTR) + regio.read32(tab() + w(H_DVER) + f * 4)
}

fn say_addr(addr: u64) {
    var s_plus: [u8; 2] = "+\0"
    var s_ob: [u8; 3] = " (\0"
    var s_co: [u8; 2] = ":\0"
    var s_cb: [u8; 2] = ")\0"
    let i: u64 = resolve(addr)
    if i >= n_sym() {
        serial.hex(addr)
        return
    }
    serial.puts(sym_name(i))
    serial.puts((&s_plus[0 as usize]) as u64)
    serial.hex(addr - sym_addr(i))
    let p: u64 = line_of(addr)
    if p == 0 {
        return
    }
    let f: u64 = file_name(line_file(p))
    if f == 0 {
        return
    }
    serial.puts((&s_ob[0 as usize]) as u64)
    serial.puts(f)
    serial.puts((&s_co[0 as usize]) as u64)
    serial.dec(line_nr(p))
    serial.puts((&s_cb[0 as usize]) as u64)
}

fn say_addr_short(addr: u64) {
    var s_plus: [u8; 2] = "+\0"
    let i: u64 = resolve(addr)
    if i >= n_sym() {
        serial.hex(addr)
        return
    }
    serial.puts(sym_name(i))
    serial.puts((&s_plus[0 as usize]) as u64)
    serial.hex(addr - sym_addr(i))
}
