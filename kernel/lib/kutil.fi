
profile kernel

import block.blk
import fs.fs
import sched.proc
import sched.sched
import sched.taskslot
import serial
import arch.x86_64.apic
import libc.numeric

export { root_blocks, wait_for, pnum, phex, give_up_at, gave_up }

const OSUM_BLOCKS: u64 = 4096

fn root_blocks(state: u64) -> u64 {
    let n: u64 = blk.capacity(state)
    if n == 0 {
        return OSUM_BLOCKS
    }
    return n
}

fn give_up_at(state: u64, secs: u64) -> u64 {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return 0
    }
    return apic.tsc() + hz * secs
}

fn gave_up(deadline: u64, rounds: u64, max_rounds: u64) -> bool {
    if deadline != 0 {
        return apic.tsc() > deadline
    }
    return rounds >= max_rounds
}

fn wait_for(state: u64, i: u64) -> u64 {
    if i == 0 {
        return 0xFFFFFFFFFFFFFFFF
    }
    var rounds: u64 = 0
    let dl: u64 = give_up_at(state, 20)
    while !gave_up(dl, rounds, 2000) {
        if taskslot.tget(state, i, sched.T_STATE) == sched.S_ZOMBIE {
            let code: u64 = taskslot.tget(state, i, sched.T_EXIT)
            proc.reap(state, i)
            return code
        }
        sched.sleep_ticks(state, 1)
        rounds = rounds + 1
    }
    return 0xFFFFFFFFFFFFFFFE
}

fn pnum(name: u64, v: u64) {
    var s_p: [u8; 6] = "pwr: \0"
    var s_e: [u8; 2] = "=\0"
    serial.puts((&s_p[0]) as u64)
    serial.puts(name)
    serial.puts((&s_e[0]) as u64)
    serial.dec(v)
    serial.nl()
}

fn phex(name: u64, v: u64) {
    var s_p: [u8; 6] = "pwr: \0"
    var s_e: [u8; 2] = "=\0"
    serial.puts((&s_p[0]) as u64)
    serial.puts(name)
    serial.puts((&s_e[0]) as u64)
    serial.hex(v)
    serial.nl()
}

