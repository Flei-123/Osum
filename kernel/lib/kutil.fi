// SPDX-License-Identifier: GPL-2.0-only
// kernel/kutil.fi -- RUNDE SERVERBUILD: die fuenf Kleinigkeiten, die
// sich `kmain.fi` und `kgui.fi` teilen.
//
// Als die Oberflaeche aus `kmain.fi` nach `kgui.fi` zog, blieben genau
// fuenf Helfer uebrig, die BEIDE Seiten benutzen: zwei Melder fuer die
// Energiewerte, die Groesse der Wurzelplatte, das Warten auf eine
// Aufgabe und die Umwandlung eines Wahrheitswertes in eine Ziffer.
// Sie zweimal hinzuschreiben waere zweimal dieselbe Zeile gewesen; ein
// eigenes Modul dafuer ist die billigere Antwort.
//
// `kgui.fi` kann `kmain.fi` nicht einbinden: `kmain.fi` ist das
// WURZELMODUL des Uebersetzungslaufes, und ein Wurzelmodul hat unter
// seinem eigenen Namen keinen Eintrag in der Modultafel ("module
// 'kmain' was not found"). Deshalb geht der geteilte Rest nach unten
// und nicht nach oben.

profile kernel

import block.blk
import fs.fs
import sched.proc
import sched.sched
import serial
import arch.x86_64.apic

export { root_blocks, wait_for, yes, pnum, phex, give_up_at, gave_up }

const OSUM_BLOCKS: u64 = 4096

//
// `OSUM_BLOCKS` stand seit Runde K1 als Konstante hier: 4096 Bloecke,
// zwei Megaoktett. Sie war nie eine Eigenschaft der Platte, sondern
// eine Eigenschaft dieser Zeile -- und sie war der zweite Deckel neben
// der einblockigen Karte in `fs.fi`. Ein Abbild von 32 MiB lief nach
// 2 MiB voll, und `df` sagte dazu `total=4096`, was stimmte und
// trotzdem falsch war.
//
// Jetzt fragt der Kernel die Platte (`blk.capacity`, ATA IDENTIFY).
// Antwortet sie nicht, bleibt es bei der alten Konstanten -- kein Lauf,
// der bisher funktioniert hat, faellt dadurch aus.
fn root_blocks(state: u64) -> u64 {
    let n: u64 = blk.capacity(state)
    if n == 0 {
        return OSUM_BLOCKS
    }
    return n
}

// r388 (06.10.2026): a wait of `secs` seconds is measured in TIME, not in
// rounds. A round is `sleep_ticks(1)`, and `sleep_ticks` turns into a plain
// `yield_now` while the timer watchdog (`timer_tot`) sees no tick on this core
// for a third of a second -- which is exactly what four cores do when sixteen
// children fork and exec at once (all of them spin with interrupts off for a
// while). The 20 000 rounds of `wait_long` then ran out within two seconds
// of real time: "osum: sh exit=-2" in 3 of 10 boots of tools/execsmp/run.sh,
// while the script was still running. The time stamp counter does not depend
// on the timer interrupt. Without a measured TSC the old round count stays.
// `give_up_at(state, secs)` is the stamp to stop at (0 = no TSC), `gave_up`
// asks whether it has passed.
fn give_up_at(state: u64, secs: u64) -> u64 {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return 0
    }
    return apic.tsc() + hz * secs
}

fn gave_up(deadline: u64, rounds: u64, max_rounds: u64) -> bool {
    if deadline != 0 {
        return apic.tsc() > deadline
    }
    return rounds >= max_rounds
}

fn wait_for(state: u64, i: u64) -> u64 {
    if i == 0 {
        return 0xFFFFFFFFFFFFFFFF
    }
    var rounds: u64 = 0
    let dl: u64 = give_up_at(state, 20)
    while !gave_up(dl, rounds, 2000) {
        if sched.tget(state, i, sched.T_STATE) == sched.S_ZOMBIE {
            let code: u64 = sched.tget(state, i, sched.T_EXIT)
            proc.reap(state, i)
            return code
        }
        sched.sleep_ticks(state, 1)
        rounds = rounds + 1
    }
    return 0xFFFFFFFFFFFFFFFE
}

fn yes(b: bool) -> u64 {
    if b {
        return 1
    }
    return 0
}

fn pnum(name: u64, v: u64) {
    var s_p: [u8; 6] = "pwr: \0"
    var s_e: [u8; 2] = "=\0"
    serial.puts((&s_p[0]) as u64)
    serial.puts(name)
    serial.puts((&s_e[0]) as u64)
    serial.dec(v)
    serial.nl()
}

fn phex(name: u64, v: u64) {
    var s_p: [u8; 6] = "pwr: \0"
    var s_e: [u8; 2] = "=\0"
    serial.puts((&s_p[0]) as u64)
    serial.puts(name)
    serial.puts((&s_e[0]) as u64)
    serial.hex(v)
    serial.nl()
}

