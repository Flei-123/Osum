profile kernel

import lib.kstate

export { find, find_key }

const SPACE: u64 = 32
const EQUALS: u64 = 61
const TAB: u64 = 9

fn same_at(at: u64, needle: u64, n: u64) -> bool {
    var k: u64 = 0
    while k < n {
        let c: u64 = kstate.get8(at + k)
        if c == 0 || c != kstate.get8(needle + k) {
            return false
        }
        k = k + 1
    }
    return true
}

fn starts_word(hay: u64, at: u64) -> bool {
    return at == hay || (kstate.get8(at - 1) == SPACE || kstate.get8(at - 1) == TAB)
}

fn next_is_equals(after: u64) -> bool {
    return kstate.get8(after) == EQUALS
}

fn ends_word(needle: u64, n: u64, after: u64) -> bool {
    let last: u64 = kstate.get8(needle + n - 1)
    if last == EQUALS {
        return true
    }
    let c: u64 = kstate.get8(after)
    return c == 0 || c == SPACE || c == TAB || c == EQUALS
}

fn locate(hay: u64, needle: u64, n: u64, key: bool) -> u64 {
    if hay == 0 || n == 0 {
        return 0
    }
    var at: u64 = hay
    while kstate.get8(at) != 0 {
        if same_at(at, needle, n) && starts_word(hay, at) {
            if key {
                if next_is_equals(at + n) {
                    return at
                }
            } else if ends_word(needle, n, at + n) {
                return at
            }
        }
        at = at + 1
    }
    return 0
}

fn find(hay: u64, needle: u64, n: u64) -> u64 {
    return locate(hay, needle, n, false)
}

fn find_key(hay: u64, needle: u64, n: u64) -> u64 {
    return locate(hay, needle, n, true)
}
