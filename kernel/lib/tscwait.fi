import arch.x86_64.apic

export { deadline_ms, passed }

const MIN_TSC_HZ: u64 = 1000000
const MS_PER_SEC: u64 = 1000

fn deadline_ms(state: u64, ms: u64) -> u64 {
    let hz: u64 = apic.tsc_hz(state)
    if hz < MIN_TSC_HZ {
        return 0
    }
    return apic.tsc() + (hz / MS_PER_SEC) * ms
}

fn passed(deadline: u64, spins: u64, spin_limit: u64) -> bool {
    if deadline != 0 {
        return apic.tsc() >= deadline
    }
    return spins >= spin_limit
}
