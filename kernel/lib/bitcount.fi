fn popcount64(v: u64) -> u64 {
    let a: u64 = v - ((v >> 1) & 0x5555555555555555)
    let b: u64 = (a & 0x3333333333333333) + ((a >> 2) & 0x3333333333333333)
    let c: u64 = (b + (b >> 4)) & 0x0F0F0F0F0F0F0F0F
    return (c *% 0x0101010101010101) >> 56
}
