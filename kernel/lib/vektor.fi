
profile kernel

import lib.kstate

export {
    EINS, HALB,
    NICHTNULL, GERADE_UNGERADE,
    END_BUTT, END_ROUND, END_SQUARE,
    CORNER_MITER, CORNER_ROUND, CORNER_BEVEL,
    path_new, move_to, line, quad, kubik, close_path, path_points, path_edges,
    rechteck, rundeck, kreis, ellipse, polygon_round,
    rastern, deckung, width, height, ux0, uy0,
    stroke_width, stroke_end, stroke_corner, strichen,
    clip_set, clip_off, clip_path, clip_path_off,
    gradient_linear, gradient_radial, gradient_color, gradient_off,
    cache_find, cache_ablegen, cache_treffer, cache_error, clear_cache,
    edges_total, formen_gerastert,
    MAX_POINTS, MAX_EDGES, MAX_B, KAPPA
}

const EINS: i64 = 64
const HALB: i64 = 32

const KAPPA: i64 = 35

const NICHTNULL: u64 = 0
const GERADE_UNGERADE: u64 = 1

const END_BUTT: u64 = 0
const END_ROUND: u64 = 1
const END_SQUARE: u64 = 2

const CORNER_MITER: u64 = 0
const CORNER_ROUND: u64 = 1
const CORNER_BEVEL: u64 = 2

const MAX_POINTS: u64 = 640
const MAX_EDGES: u64 = 640
const MAX_B: u64 = 256

const CURVE_TEILE: u64 = 16

static mut ptx: [i64; 640] = [0 as i64; 640]
static mut pty: [i64; 640] = [0 as i64; 640]
static mut p_start: u64 = 0
static mut p_n: u64 = 0
static mut p_hat: u64 = 0

static mut kx0: [i64; 640] = [0 as i64; 640]
static mut ky0: [i64; 640] = [0 as i64; 640]
static mut kx1: [i64; 640] = [0 as i64; 640]
static mut ky1: [i64; 640] = [0 as i64; 640]
static mut k_n: u64 = 0

static mut cover_table: [u8; 65536] = [0 as u8; 65536]
static mut d_w: u64 = 0
static mut d_h: u64 = 0
static mut d_x0: i64 = 0
static mut d_y0: i64 = 0

static mut line_cov: [i64; 256] = [0 as i64; 256]
static mut cross_x: [i64; 640] = [0 as i64; 640]
static mut cross_d: [i64; 640] = [0 as i64; 640]

static mut s_width: i64 = 64
static mut s_ende: u64 = 0
static mut s_corner: u64 = 0

static mut b_an: u64 = 0
static mut b_x0: i64 = 0
static mut b_y0: i64 = 0
static mut b_x1: i64 = 0
static mut b_y1: i64 = 0

static mut bp_an: u64 = 0
static mut bp_table: [u8; 65536] = [0 as u8; 65536]
static mut bp_w: u64 = 0
static mut bp_h: u64 = 0
static mut bp_x0: i64 = 0
static mut bp_y0: i64 = 0

static mut v_art: u64 = 0
static mut v_x0: i64 = 0
static mut v_y0: i64 = 0
static mut v_x1: i64 = 0
static mut v_y1: i64 = 0
static mut v_c0: u64 = 0
static mut v_c1: u64 = 0

const CACHE_N: u64 = 24
const CACHE_PX: u64 = 4096
static mut c_key: [u64; 24] = [0 as u64; 24]
static mut c_w: [u64; 24] = [0 as u64; 24]
static mut c_h: [u64; 24] = [0 as u64; 24]
static mut c_gut: [u64; 24] = [0 as u64; 24]
static mut c_alter: [u64; 24] = [0 as u64; 24]
static mut c_data: [u8; 98304] = [0 as u8; 98304]
static mut c_uhr: u64 = 0
static mut c_treffer: u64 = 0
static mut c_error: u64 = 0

static mut m_edges: u64 = 0
static mut m_formen: u64 = 0

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn iabs(a: i64) -> i64 {
    if a < 0 {
        return 0 - a
    }
    return a
}

fn tdiv(a: i64, b: i64) -> i64 {
    if b == 0 {
        return 0
    }
    return a / b
}

fn rdiv(a: i64, b: i64) -> i64 {
    if b == 0 {
        return 0
    }
    var za: i64 = a
    var nb: i64 = b
    if nb < 0 {
        za = 0 - za
        nb = 0 - nb
    }
    if za >= 0 {
        return (za + nb / 2) / nb
    }
    return 0 - ((0 - za) + nb / 2) / nb
}

fn root(v: i64) -> i64 {
    if v <= 0 {
        return 0
    }
    if v < 2 {
        return v
    }
    var x: i64 = v
    var y: i64 = (x + 1) / 2
    var n: u64 = 0
    while y < x && n < 40 {
        x = y
        y = (x + v / x) / 2
        n = n + 1
    }
    return x
}

fn edges_total() -> u64 {
    return m_edges
}

fn formen_gerastert() -> u64 {
    return m_formen
}

fn path_new() {
    p_n = 0
    p_start = 0
    p_hat = 0
    k_n = 0
}

fn path_points() -> u64 {
    return p_n
}

fn path_edges() -> u64 {
    return k_n
}

fn point(x: i64, y: i64) {
    if p_n >= MAX_POINTS {
        return
    }
    ptx[(p_n) as usize] = x
    pty[(p_n) as usize] = y
    p_n = p_n + 1
}

fn edge(ax: i64, ay: i64, bx: i64, by: i64) {
    if ay == by {
        return
    }
    if k_n >= MAX_EDGES {
        return
    }
    kx0[(k_n) as usize] = ax
    ky0[(k_n) as usize] = ay
    kx1[(k_n) as usize] = bx
    ky1[(k_n) as usize] = by
    k_n = k_n + 1
    m_edges = m_edges + 1
}

fn move_to(x: i64, y: i64) {
    p_start = p_n
    point(x, y)
    p_hat = 1
}

fn line(x: i64, y: i64) {
    if p_hat == 0 {
        move_to(x, y)
        return
    }
    point(x, y)
}

fn quad(cx: i64, cy: i64, x: i64, y: i64) {
    if p_hat == 0 {
        move_to(x, y)
        return
    }
    let ax: i64 = ptx[((p_n - 1)) as usize]
    let ay: i64 = pty[((p_n - 1)) as usize]
    let n: i64 = CURVE_TEILE as i64
    var i: i64 = 1
    while i <= n {
        let t: i64 = i
        let u: i64 = n - i
        let bx: i64 = rdiv(u * u * ax + 2 * u * t * cx + t * t * x, n * n)
        let by: i64 = rdiv(u * u * ay + 2 * u * t * cy + t * t * y, n * n)
        point(bx, by)
        i = i + 1
    }
}

fn kubik(c1x: i64, c1y: i64, c2x: i64, c2y: i64, x: i64, y: i64) {
    if p_hat == 0 {
        move_to(x, y)
        return
    }
    let ax: i64 = ptx[((p_n - 1)) as usize]
    let ay: i64 = pty[((p_n - 1)) as usize]
    let n: i64 = CURVE_TEILE as i64
    var i: i64 = 1
    while i <= n {
        let t: i64 = i
        let u: i64 = n - i
        let nnn: i64 = n * n * n
        let bx: i64 = rdiv(u * u * u * ax + 3 * u * u * t * c1x
            + 3 * u * t * t * c2x + t * t * t * x, nnn)
        let by: i64 = rdiv(u * u * u * ay + 3 * u * u * t * c1y
            + 3 * u * t * t * c2y + t * t * t * y, nnn)
        point(bx, by)
        i = i + 1
    }
}

fn close_path() {
    if p_n <= p_start + 1 {
        return
    }
    var i: u64 = p_start
    while i + 1 < p_n {
        edge(ptx[(i) as usize], pty[(i) as usize],
            ptx[((i + 1)) as usize], pty[((i + 1)) as usize])
        i = i + 1
    }
    edge(ptx[((p_n - 1)) as usize], pty[((p_n - 1)) as usize],
        ptx[(p_start) as usize], pty[(p_start) as usize])
    p_start = p_n
    p_hat = 0
}

fn build_edges() {
    if p_n > p_start + 1 {
        close_path()
    }
}

fn rechteck(x: i64, y: i64, w: i64, h: i64) {
    if w <= 0 || h <= 0 {
        return
    }
    move_to(x, y)
    line(x + w, y)
    line(x + w, y + h)
    line(x, y + h)
    close_path()
}

fn corner_arc(x0: i64, y0: i64, ex: i64, ey: i64, x1: i64, y1: i64) {
    let c1x: i64 = x0 + rdiv((ex - x0) * KAPPA, 64)
    let c1y: i64 = y0 + rdiv((ey - y0) * KAPPA, 64)
    let c2x: i64 = x1 + rdiv((ex - x1) * KAPPA, 64)
    let c2y: i64 = y1 + rdiv((ey - y1) * KAPPA, 64)
    kubik(c1x, c1y, c2x, c2y, x1, y1)
}

fn rundeck(x: i64, y: i64, w: i64, h: i64, r0: i64) {
    if w <= 0 || h <= 0 {
        return
    }
    var r: i64 = r0
    if r < 0 {
        r = 0
    }
    if r > w / 2 {
        r = w / 2
    }
    if r > h / 2 {
        r = h / 2
    }
    if r == 0 {
        rechteck(x, y, w, h)
        return
    }
    let x1: i64 = x + w
    let y1: i64 = y + h
    move_to(x + r, y)
    line(x1 - r, y)
    corner_arc(x1 - r, y, x1, y, x1, y + r)
    line(x1, y1 - r)
    corner_arc(x1, y1 - r, x1, y1, x1 - r, y1)
    line(x + r, y1)
    corner_arc(x + r, y1, x, y1, x, y1 - r)
    line(x, y + r)
    corner_arc(x, y + r, x, y, x + r, y)
    close_path()
}

fn ellipse(cx: i64, cy: i64, rx: i64, ry: i64) {
    if rx <= 0 || ry <= 0 {
        return
    }
    move_to(cx, cy - ry)
    corner_arc(cx, cy - ry, cx + rx, cy - ry, cx + rx, cy)
    corner_arc(cx + rx, cy, cx + rx, cy + ry, cx, cy + ry)
    corner_arc(cx, cy + ry, cx - rx, cy + ry, cx - rx, cy)
    corner_arc(cx - rx, cy, cx - rx, cy - ry, cx, cy - ry)
    close_path()
}

fn kreis(cx: i64, cy: i64, r: i64) {
    ellipse(cx, cy, r, r)
}

fn polygon_round(xs: u64, ys: u64, n: u64, r: i64) {
    if n < 3 {
        return
    }
    var i: u64 = 0
    while i < n {
        let before: u64 = (i + n - 1) % n
        let nach_i: u64 = (i + 1) % n
        let ax: i64 = kstate.get(xs, before * 8) as i64
        let ay: i64 = kstate.get(ys, before * 8) as i64
        let bx: i64 = kstate.get(xs, i * 8) as i64
        let by: i64 = kstate.get(ys, i * 8) as i64
        let cx: i64 = kstate.get(xs, nach_i * 8) as i64
        let cy: i64 = kstate.get(ys, nach_i * 8) as i64
        if r <= 0 {
            if i == 0 {
                move_to(bx, by)
            } else {
                line(bx, by)
            }
        } else {
            let d1x: i64 = ax - bx
            let d1y: i64 = ay - by
            let l1: i64 = root(d1x * d1x + d1y * d1y)
            let d2x: i64 = cx - bx
            let d2y: i64 = cy - by
            let l2: i64 = root(d2x * d2x + d2y * d2y)
            var rr: i64 = r
            if l1 > 0 && rr > l1 / 2 {
                rr = l1 / 2
            }
            if l2 > 0 && rr > l2 / 2 {
                rr = l2 / 2
            }
            if l1 == 0 || l2 == 0 {
                if i == 0 {
                    move_to(bx, by)
                } else {
                    line(bx, by)
                }
            } else {
                let p1x: i64 = bx + d1x * rr / l1
                let p1y: i64 = by + d1y * rr / l1
                let p2x: i64 = bx + d2x * rr / l2
                let p2y: i64 = by + d2y * rr / l2
                if i == 0 {
                    move_to(p1x, p1y)
                } else {
                    line(p1x, p1y)
                }
                corner_arc(p1x, p1y, bx, by, p2x, p2y)
            }
        }
        i = i + 1
    }
    close_path()
}

fn cross_add(n: u64, x: i64, d: i64) -> u64 {
    if n >= MAX_EDGES {
        return n
    }
    var j: u64 = n
    while j > 0 {
        if cross_x[((j - 1)) as usize] <= x {
            j = j
            break
        }
        cross_x[(j) as usize] = cross_x[((j - 1)) as usize]
        cross_d[(j) as usize] = cross_d[((j - 1)) as usize]
        j = j - 1
    }
    cross_x[(j) as usize] = x
    cross_d[(j) as usize] = d
    return n + 1
}

fn spanne(a: i64, b: i64, bx0: i64, w: i64) {
    var j0: i64 = (a - 8 + 15) >> 4
    var j1: i64 = (b - 8 + 15) >> 4
    if j0 < bx0 * 4 {
        j0 = bx0 * 4
    }
    if j1 > (bx0 + w) * 4 {
        j1 = (bx0 + w) * 4
    }
    var j: i64 = j0
    while j < j1 {
        let c: i64 = (j >> 2) - bx0
        if c >= 0 && c < w {
            line_cov[(c) as usize] = line_cov[(c) as usize] + 1
        }
        j = j + 1
    }
}

fn rastern(rule: u64) -> u64 {
    build_edges()
    d_w = 0
    d_h = 0
    if k_n == 0 {
        return 0
    }
    var minx: i64 = kx0[(0) as usize]
    var maxx: i64 = minx
    var miny: i64 = ky0[(0) as usize]
    var maxy: i64 = miny
    var i: u64 = 0
    while i < k_n {
        minx = imin(imin(minx, kx0[(i) as usize]), kx1[(i) as usize])
        maxx = imax(imax(maxx, kx0[(i) as usize]), kx1[(i) as usize])
        miny = imin(imin(miny, ky0[(i) as usize]), ky1[(i) as usize])
        maxy = imax(imax(maxy, ky0[(i) as usize]), ky1[(i) as usize])
        i = i + 1
    }
    let bx0: i64 = minx >> 6
    let bx1: i64 = (maxx + 63) >> 6
    let by0: i64 = miny >> 6
    let by1: i64 = (maxy + 63) >> 6
    var w: i64 = bx1 - bx0
    var h: i64 = by1 - by0
    if w <= 0 || h <= 0 {
        return 0
    }
    if w > MAX_B as i64 {
        w = MAX_B as i64
    }
    if h > MAX_B as i64 {
        h = MAX_B as i64
    }
    d_x0 = bx0
    d_y0 = by0
    d_w = w as u64
    d_h = h as u64

    var py: i64 = by0
    while py < by0 + h {
        var c: i64 = 0
        while c < w {
            line_cov[(c) as usize] = 0
            c = c + 1
        }
        var sub: i64 = 0
        while sub < 4 {
            let ys: i64 = py * 64 + 8 + sub * 16
            var n: u64 = 0
            i = 0
            while i < k_n {
                let ay: i64 = ky0[(i) as usize]
                let by: i64 = ky1[(i) as usize]
                var lo: i64 = ay
                var hi: i64 = by
                var dir: i64 = 1
                if ay > by {
                    lo = by
                    hi = ay
                    dir = 0 - 1
                }
                if ys >= lo && ys < hi {
                    let ax: i64 = kx0[(i) as usize]
                    let bx: i64 = kx1[(i) as usize]
                    n = cross_add(n, ax + rdiv((bx - ax) * (ys - ay),
                        by - ay), dir)
                }
                i = i + 1
            }
            if n > 0 {
                if rule == NICHTNULL {
                    var wind: i64 = 0
                    var start: i64 = 0
                    var j: u64 = 0
                    while j < n {
                        let xs: i64 = cross_x[(j) as usize]
                        let dz: i64 = cross_d[(j) as usize]
                        let vorher: i64 = wind
                        wind = wind + dz
                        if vorher == 0 && wind != 0 {
                            start = xs
                        }
                        if vorher != 0 && wind == 0 {
                            spanne(start, xs, bx0, w)
                        }
                        j = j + 1
                    }
                } else {
                    var j2: u64 = 0
                    while j2 + 1 < n {
                        spanne(cross_x[(j2) as usize],
                            cross_x[((j2 + 1)) as usize], bx0, w)
                        j2 = j2 + 2
                    }
                }
            }
            sub = sub + 1
        }
        let line_v: u64 = ((py - by0) * w) as u64
        c = 0
        while c < w {
            var cov: i64 = line_cov[(c) as usize]
            if cov > 16 {
                cov = 16
            }
            if cov < 0 {
                cov = 0
            }
            cover_table[((line_v + c as u64)) as usize] =
                (((cov * 255 + 8) / 16) & 0xFF) as u8
            c = c + 1
        }
        py = py + 1
    }
    m_formen = m_formen + 1
    return 1
}

fn width() -> u64 {
    return d_w
}

fn height() -> u64 {
    return d_h
}

fn ux0() -> i64 {
    return d_x0
}

fn uy0() -> i64 {
    return d_y0
}

fn deckung(x: i64, y: i64) -> u64 {
    if d_w == 0 || d_h == 0 {
        return 0
    }
    if b_an == 1 {
        if x < b_x0 || y < b_y0 || x >= b_x1 || y >= b_y1 {
            return 0
        }
    }
    let cx: i64 = x - d_x0
    let cy: i64 = y - d_y0
    if cx < 0 || cy < 0 || cx >= d_w as i64 || cy >= d_h as i64 {
        return 0
    }
    var a: u64 = cover_table[(((cy * d_w as i64 + cx)) as u64) as usize] as u64
    if bp_an == 1 {
        let px2: i64 = x - bp_x0
        let py2: i64 = y - bp_y0
        var m: u64 = 0
        if px2 >= 0 && py2 >= 0 && px2 < bp_w as i64 && py2 < bp_h as i64 {
            m = bp_table[(((py2 * bp_w as i64 + px2)) as u64) as usize] as u64
        }
        if m < a {
            a = m
        }
    }
    return a
}

fn stroke_width(b: i64) {
    if b < 0 {
        return
    }
    s_width = b
}

fn stroke_end(e: u64) {
    s_ende = e
}

fn stroke_corner(e: u64) {
    s_corner = e
}

fn strichen(geschlossen: u64) {
    let hb: i64 = s_width / 2
    if hb <= 0 || p_n < 2 {
        return
    }
    let n: u64 = p_n
    var sx: [i64; 640] = [0 as i64; 640]
    var sy: [i64; 640] = [0 as i64; 640]
    var i: u64 = 0
    while i < n {
        sx[(i) as usize] = ptx[(i) as usize]
        sy[(i) as usize] = pty[(i) as usize]
        i = i + 1
    }
    p_n = 0
    p_start = 0
    p_hat = 0

    var page: u64 = 0
    while page < 2 {
        var k: u64 = 0
        while k + 1 < n {
            var a: u64 = k
            var b: u64 = k + 1
            if page == 1 {
                a = n - 1 - k
                b = n - 2 - k
            }
            let ax: i64 = sx[(a) as usize]
            let ay: i64 = sy[(a) as usize]
            let bx: i64 = sx[(b) as usize]
            let by: i64 = sy[(b) as usize]
            let dx: i64 = bx - ax
            let dy: i64 = by - ay
            let l: i64 = root(dx * dx + dy * dy)
            if l > 0 {
                let nx: i64 = 0 - dy * hb / l
                let ny: i64 = dx * hb / l
                if k == 0 && page == 0 {
                    if s_ende == END_SQUARE {
                        move_to(ax + nx - dx * hb / l, ay + ny - dy * hb / l)
                    } else {
                        move_to(ax + nx, ay + ny)
                    }
                } else {
                    line(ax + nx, ay + ny)
                }
                line(bx + nx, by + ny)
                if s_corner == CORNER_ROUND && k + 2 < n {
                    var c: u64 = b + 1
                    if page == 1 {
                        c = b - 1
                    }
                    let cx2: i64 = sx[(c) as usize]
                    let cy2: i64 = sy[(c) as usize]
                    let ex: i64 = cx2 - bx
                    let ey: i64 = cy2 - by
                    let l2: i64 = root(ex * ex + ey * ey)
                    if l2 > 0 {
                        let mx: i64 = 0 - ey * hb / l2
                        let my: i64 = ex * hb / l2
                        corner_arc(bx + nx, by + ny, bx, by, bx + mx, by + my)
                    }
                }
            }
            k = k + 1
        }
        page = page + 1
    }
    close_path()
}

fn clip_set(x0: i64, y0: i64, x1: i64, y1: i64) {
    b_an = 1
    b_x0 = x0
    b_y0 = y0
    b_x1 = x1
    b_y1 = y1
}

fn clip_off() {
    b_an = 0
}

fn clip_path() {
    if d_w == 0 || d_h == 0 {
        return
    }
    bp_w = d_w
    bp_h = d_h
    bp_x0 = d_x0
    bp_y0 = d_y0
    var i: u64 = 0
    let n: u64 = d_w * d_h
    while i < n && i < 65536 {
        bp_table[(i) as usize] = cover_table[(i) as usize]
        i = i + 1
    }
    bp_an = 1
}

fn clip_path_off() {
    bp_an = 0
}

fn gradient_linear(x0: i64, y0: i64, x1: i64, y1: i64, c0: u64, c1: u64) {
    v_art = 1
    v_x0 = x0
    v_y0 = y0
    v_x1 = x1
    v_y1 = y1
    v_c0 = c0
    v_c1 = c1
}

fn gradient_radial(cx: i64, cy: i64, r: i64, c0: u64, c1: u64) {
    v_art = 2
    v_x0 = cx
    v_y0 = cy
    v_x1 = r
    v_y1 = 0
    v_c0 = c0
    v_c1 = c1
}

fn gradient_off() {
    v_art = 0
}

fn channel(a: u64, b: u64, sh: u64, t: u64) -> u64 {
    let av: u64 = (a >> sh) & 0xFF
    let bv: u64 = (b >> sh) & 0xFF
    return (av * (256 - t) + bv * t) / 256
}

fn gradient_color(x: i64, y: i64, reason: u64) -> u64 {
    if v_art == 0 {
        return reason
    }
    var t: i64 = 0
    if v_art == 1 {
        let dx: i64 = v_x1 - v_x0
        let dy: i64 = v_y1 - v_y0
        let ll: i64 = dx * dx + dy * dy
        if ll == 0 {
            return v_c0
        }
        t = ((x * 64 - v_x0) * dx + (y * 64 - v_y0) * dy) * 256 / ll
    } else {
        let dx2: i64 = x * 64 - v_x0
        let dy2: i64 = y * 64 - v_y0
        let d: i64 = root(dx2 * dx2 + dy2 * dy2)
        if v_x1 <= 0 {
            return v_c0
        }
        t = d * 256 / v_x1
    }
    if t < 0 {
        t = 0
    }
    if t > 256 {
        t = 256
    }
    let tu: u64 = t as u64
    return (channel(v_c0, v_c1, 16, tu) << 16)
        | (channel(v_c0, v_c1, 8, tu) << 8)
        | channel(v_c0, v_c1, 0, tu)
}

fn cache_treffer() -> u64 {
    return c_treffer
}

fn cache_error() -> u64 {
    return c_error
}

fn clear_cache() {
    var i: u64 = 0
    while i < CACHE_N {
        c_gut[(i) as usize] = 0
        i = i + 1
    }
}

fn cache_find(key: u64, w: u64, h: u64, x0: i64, y0: i64) -> u64 {
    var i: u64 = 0
    while i < CACHE_N {
        if c_gut[(i) as usize] == 1 && c_key[(i) as usize] == key
            && c_w[(i) as usize] == w && c_h[(i) as usize] == h {
            let n: u64 = w * h
            if n <= CACHE_PX {
                var j: u64 = 0
                while j < n {
                    cover_table[(j) as usize] =
                        c_data[((i * CACHE_PX + j)) as usize]
                    j = j + 1
                }
                d_w = w
                d_h = h
                d_x0 = x0
                d_y0 = y0
                c_uhr = c_uhr + 1
                c_alter[(i) as usize] = c_uhr
                c_treffer = c_treffer + 1
                return 1
            }
        }
        i = i + 1
    }
    c_error = c_error + 1
    return 0
}

fn cache_ablegen(key: u64) {
    if d_w == 0 || d_h == 0 {
        return
    }
    let n: u64 = d_w * d_h
    if n > CACHE_PX {
        return
    }
    var free: u64 = CACHE_N
    var i: u64 = 0
    while i < CACHE_N {
        if c_gut[(i) as usize] == 0 {
            free = i
            i = CACHE_N
        } else {
            i = i + 1
        }
    }
    if free == CACHE_N {
        var aelt: u64 = 0
        var alter: u64 = c_alter[(0) as usize]
        i = 1
        while i < CACHE_N {
            if c_alter[(i) as usize] < alter {
                alter = c_alter[(i) as usize]
                aelt = i
            }
            i = i + 1
        }
        free = aelt
    }
    var j: u64 = 0
    while j < n {
        c_data[((free * CACHE_PX + j)) as usize] = cover_table[(j) as usize]
        j = j + 1
    }
    c_key[(free) as usize] = key
    c_w[(free) as usize] = d_w
    c_h[(free) as usize] = d_h
    c_gut[(free) as usize] = 1
    c_uhr = c_uhr + 1
    c_alter[(free) as usize] = c_uhr
}
