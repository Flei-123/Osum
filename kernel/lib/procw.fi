profile kernel

import lib.kstate

export {
    begin, used, put_c, put_s, put_dec, put_hex, line_num, line_hex, line_text
}

static mut w_at: u64 = 0
static mut w_cap: u64 = 0
static mut w_out: u64 = 0

fn begin(out: u64, cap: u64) {
    w_out = out
    w_cap = cap
    w_at = 0
}

fn used() -> u64 {
    return w_at
}

fn put_c(c: u64) {
    if w_at + 1 < w_cap {
        kstate.set8(w_out + w_at, c as u8)
        w_at = w_at + 1
    }
}

fn put_s(s: u64) {
    var i: u64 = 0
    while kstate.get8(s + i) != 0 {
        put_c(kstate.get8(s + i))
        i = i + 1
    }
}

fn put_dec(v: u64) {
    var tmp: [u8; 20] = [0 as u8; 20]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        tmp[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        tmp[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        put_c(tmp[n as usize] as u64)
    }
}

fn put_hex(v: u64, digits: u64) {
    var i: u64 = digits
    put_c(48)
    put_c(120)
    while i > 0 {
        i = i - 1
        let d: u64 = (v >> (i * 4)) & 15
        if d < 10 {
            put_c(48 + d)
        } else {
            put_c(87 + d)
        }
    }
}

fn line_num(key: u64, v: u64) {
    put_s(key)
    put_c(32)
    put_dec(v)
    put_c(10)
}

fn line_hex(key: u64, v: u64, digits: u64) {
    put_s(key)
    put_c(32)
    put_hex(v, digits)
    put_c(10)
}

fn line_text(key: u64, text: u64) {
    put_s(key)
    put_c(32)
    put_s(text)
    put_c(10)
}
