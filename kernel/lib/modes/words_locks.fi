profile kernel

import lib.modes.kind

export { COUNT, names, docs, bits, meta, M_NOELFLOCK, M_NOEARGK, M_NOMMLOCK, M_NOSCRATCH, M_NOVMLOCK, M_NOFDLOCK, M_NOFQLOCK }

const M_NOELFLOCK: u64 = 1081
const M_NOEARGK: u64 = 1083
const M_NOMMLOCK: u64 = 1088
const M_NOSCRATCH: u64 = 1089
const M_NOVMLOCK: u64 = 1090
const M_NOFDLOCK: u64 = 1311
const M_NOFQLOCK: u64 = 1312

const COUNT: u64 = 7

static mut names: [u8; 64] = "noelflock\0noeargk\0nommlock\0noscratch\0novmlock\0nofdlock\0nofqlock\0"
static mut docs: [u8; 275] = "run the ELF loader lock as a no-op\0use the shared exec argument buffer instead of the per-CPU page\0run the memory map lock as a no-op\0run the scratch page lock as a no-op\0run the VM lock as a no-op\0run the descriptor table lock as a no-op\0run the futex queue lock as a no-op\0"
static mut bits: [u64; 7] = [M_NOELFLOCK, M_NOEARGK, M_NOMMLOCK, M_NOSCRATCH, M_NOVMLOCK, M_NOFDLOCK, M_NOFQLOCK]
static mut meta: [u64; 7] = [kind.FLAG, kind.FLAG, kind.FLAG, kind.FLAG, kind.FLAG, kind.FLAG, kind.FLAG]
