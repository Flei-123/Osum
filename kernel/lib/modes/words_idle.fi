profile kernel

import lib.modes.kind

export { COUNT, names, docs, bits, meta, M_IDLESPIN, M_NOIDLEHOUSE, M_NOKICKLOOP, M_NOHALTPOLL }

const M_IDLESPIN: u64 = 1325
const M_NOIDLEHOUSE: u64 = 1332
const M_NOKICKLOOP: u64 = 1333
const M_NOHALTPOLL: u64 = 1334

const COUNT: u64 = 4

static mut names: [u8; 43] = "idlespin\0noidlehouse\0nokickloop\0nohaltpoll\0"
static mut docs: [u8; 156] = "burn the idle loop instead of halting\0skip idle housekeeping of the network stack\0skip the USB NIC kick loop\0skip adaptive halt polling in the AP idle loop\0"
static mut bits: [u64; 4] = [M_IDLESPIN, M_NOIDLEHOUSE, M_NOKICKLOOP, M_NOHALTPOLL]
static mut meta: [u64; 4] = [kind.FLAG | kind.TEST_ONLY, kind.FLAG, kind.FLAG, kind.FLAG]
