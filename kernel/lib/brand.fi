profile kernel

import lib.kstate
import lib.version

export {
    product, product_n, core, core_n, vendor, vendor_n,
    slug, slug_n, web, web_n, feed, feed_n,
    version_text, version_n, image_text, image_n, append, MAX, MAX_URL
}

const MAX: u64 = 32
const MAX_URL: u64 = 96

static mut s_product: [u8; 32] = "???????????????????????????????\0"
static mut s_core: [u8; 32] = "???????????????????????????????\0"
static mut s_vendor: [u8; 32] = "???????????????????????????????\0"
static mut s_slug: [u8; 32] = "???????????????????????????????\0"
static mut s_web: [u8; 96] = "???????????????????????????????????????????????????????????????????????????????????????????????\0"
static mut s_feed: [u8; 96] = "???????????????????????????????????????????????????????????????????????????????????????????????\0"

fn len_from(p: u64, limit: u64) -> u64 {
    var n: u64 = 0
    while n < limit && kstate.get8(p + n) != 0 {
        n = n + 1
    }
    return n
}

fn product() -> u64 {
    return (&s_product[0]) as u64
}

fn product_n() -> u64 {
    return len_from(product(), MAX)
}

fn core() -> u64 {
    return (&s_core[0]) as u64
}

fn core_n() -> u64 {
    return len_from(core(), MAX)
}

fn vendor() -> u64 {
    return (&s_vendor[0]) as u64
}

fn vendor_n() -> u64 {
    return len_from(vendor(), MAX)
}

fn slug() -> u64 {
    return (&s_slug[0]) as u64
}

fn slug_n() -> u64 {
    return len_from(slug(), MAX)
}

fn web() -> u64 {
    return (&s_web[0]) as u64
}

fn web_n() -> u64 {
    return len_from(web(), MAX_URL)
}

fn feed() -> u64 {
    return (&s_feed[0]) as u64
}

fn feed_n() -> u64 {
    return len_from(feed(), MAX_URL)
}

fn version_text() -> u64 {
    return version.text()
}

fn version_n() -> u64 {
    return version.len()
}

fn image_text() -> u64 {
    return version.image_text()
}

fn image_n() -> u64 {
    return version.image_len()
}

fn append(dst: u64, at: u64, source: u64, limit: u64) -> u64 {
    var n: u64 = at
    var i: u64 = 0
    while n < limit && kstate.get8(source + i) != 0 {
        kstate.set8(dst + n, kstate.get8(source + i) as u8)
        n = n + 1
        i = i + 1
    }
    return n
}
