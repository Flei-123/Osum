const M_IWLBOOT: u64 = 1128 // Word 17, bit 40
// `iwlfwtest` -- LW-3a QEMU test bed: the firmware lookup + parse runs for a synthetic AX201 identity even without the device.
const M_IWLFWTEST: u64 = 1129 // Word 17, bit 41
// `iwlfhtest` -- HP-9b QEMU test bed: the family-8000 firmware loader (lib/wlan/iwl_fh8000.fi) runs for a synthetic 8265 identity against a FAKE CSR window
// in RAM (kernel/drv/net/iwl_fake.fi) and prints the register-model summary. `iwlfhlost`: the fake never raises the end-of-TFD interrupt (the loader must time out).
// `iwlfhbad`: the fake expects the bounce window elsewhere (every DMA refused, nothing lands). Default OFF.
const M_IWLFHTEST: u64 = 1132 // Word 17, bit 44
const M_IWLFHLOST: u64 = 1133 // Word 17, bit 45
const M_IWLFHBAD: u64 = 1134 // Word 17, bit 46

// W-SAFE2: `safe` = safe mode (the command line is filtered: no network / driver experiment words; USB, GFX and PS/2 stay). `safeauto` = boot state
// machine in CMOS 0x7C..0x7F: a boot that never reached "good" makes the next boot a safe one, three failed boots in a row stop the auto reset.
// `nosafefilter` = counter-proof (the filter does nothing). `safewd` = hang watchdog armed. `safefall` is set by the kernel (this boot is an
// automatic fallback). `safehold` = test bed: never mark a boot good (keeps the fallback chain going).
const M_SAFE: u64 = 1135 // Word 17, bit 47
const M_SAFEAUTO: u64 = 1136 // Word 17, bit 48
const M_NOSAFEFILTER: u64 = 1137 // Word 17, bit 49
const M_SAFEWD: u64 = 1138 // Word 17, bit 50
const M_SAFEFALL: u64 = 1139 // Word 17, bit 51
const M_SAFEHOLD: u64 = 1140 // Word 17, bit 52

// `blpch` / `blcpu` / `blbad` / `blnone` -- backlight chain test beds (tools/blchain): fake Intel PWM registers in RAM (PCH layout 0xC8250/54 or CPU layout 0x61250/54);
// `blbad` seeds an implausible period (must be refused); `blnone` disables the PWM way. Default OFF.
const M_BLPCH: u64 = 1141 // Word 17, bit 53
const M_BLCPU: u64 = 1142 // Word 17, bit 54
const M_BLBAD: u64 = 1143 // Word 17, bit 55
const M_BLNONE: u64 = 1144 // Word 17, bit 56

// `nokick` -- W-SMP2 counter-proof (tools/smpreal): the boot core does NOT send the kick IPI (timer vector) to halted application cores
// when a task is READY and core 0 is busy. Application cores then only see new work at their own 10 Hz idle tick, as before. Default OFF.
const M_NOKICK: u64 = 1148 // Word 17, bit 60

const M_APSLOW: u64 = 1151 // Word 17, bit 63

// `ps2gone` -- r1769 test bed: the i8042 status port reads as 0xFF (no controller on the board). The PS/2 mouse init must stop at once without a single wait loop.
const M_PS2GONE: u64 = 1149 // Word 17, bit 61

// `vmsvgabig` -- r1139 test bed (tools/vmsvgaresize/big.sh): with `vmsvgahints` the hint player plays a hint over the framebuffer tile limit
// (2496x1507) that must end DIRECTLY in the shrunk mode (2340x1412), without a switch + rollback in between. Default OFF.
const M_VMSVGABIG: u64 = 1118 // Word 17, bit 30

// `nobootretry` -- W-EDID counter-proof: the boot-time framebuffer init does NOT retry a smaller size when the card/window refuses the
// EDID size (the old behaviour: "kein Rahmenpuffer", black screen). `roomold` -- counter-proof: fb.run_room only counts free window tiles and
// ignores that a device tile splits the window (the behaviour before W-L2). tools/edidroom/run.sh must go red with either word.
const M_NOBOOTRETRY: u64 = 1119 // Word 17, bit 31
const M_ROOMOLD: u64 = 1120 // Word 17, bit 32

// `nobootfit` -- r1183 counter-proof: the boot does NOT jump straight to a size that fits the card's video memory (vmode.boot_fit) but climbs
// down the boot_step ladder one refused hardware attempt at a time (the behaviour before r1183). tools/edidroom/run.sh counts the attempts.
const M_NOBOOTFIT: u64 = 1121 // Word 17, bit 33

// `nokirq` -- W-INPUTHANG test bed (tools/kbdwd/run.sh): IRQ 1 (PS/2 keyboard) is NOT routed, i.e. the keyboard interrupt is lost for good (what a
// VMM that drops the i8042 interrupt looks like from the guest). `nokbdpoll` -- counter-proof: the wm watchdog does NOT look at the i8042
// output buffer for a keyboard byte (the behaviour before this round), so with `nokirq` no key may arrive. Both default OFF.
const M_NOKIRQ: u64 = 1122 // Word 17, bit 34
const M_NOKBDPOLL: u64 = 1123 // Word 17, bit 35

// `vmsvgafull` -- tools/fullhd (r1226): Full HD test bed. With `vmsvgahints` the boot fit plays 1920x1080 (as a VirtualBox VMMDev hint would) and the
// hint player cycles 1920x1200, 1366x768, 1024x768, 1920x1080. The gate judges that desktop + taskbar fill the WHOLE screen at every size
// (the old bug: a small rectangle at 1920x1080 / 1920x1200). Combine with `vmsvgastale` (VirtualBox stale-pitch emulation) for the pitch lock path.
const M_VMSVGAFULL: u64 = 1124 // Word 17, bit 36
// `acpiold` -- HP-12 counter-proof (tools/ovmfboot): scan the ACPI regions of the memory map from their start, also where they overlap the kernel image. Under OVMF this reads
// user-bit image pages in supervisor mode and ends in #PF (SMAP). Without the word the scan starts behind the kernel image.
const M_ACPIOLD: u64 = 1131 // Word 17, bit 43

// `resclear` -- W-FLICKER counter-proof (tools/tmflick): a window resize clears the window's new buffer to the background colour again
// (the old behaviour: a flat flash until the client has painted the new size) instead of keeping the old picture. Default OFF.
const M_RESCLEAR: u64 = 1150 // Word 17, bit 62
// `noiwl` -- W-WLAN9: switches the automatic firmware boot of the Intel 8265 (8086:24fd) off, also when `iwlboot` is given. Fake-firmware knobs of the
// `iwlfhtest` bed: `iwlfhnonvm` (NVM_ACCESS never answered), `iwlfhnoinitc` (no INIT_COMPLETE), `iwlfhnoalive` (no ALIVE packet), `iwlfhbadnvm` (HW section invalid).
const M_NOIWL: u64 = 1152 // Word 18, bit 0
const M_IWLFHNONVM: u64 = 1153 // Word 18, bit 1
const M_IWLFHNOINITC: u64 = 1154 // Word 18, bit 2
const M_IWLFHNOALIVE: u64 = 1155 // Word 18, bit 3
const M_IWLFHBADNVM: u64 = 1156 // Word 18, bit 4
// `iwlfhbind` -- W-WLAN12: with `iwlfhtest` the fake 8265 (incl. fake access point) stays bound as the held transport; wlan_auto scans, joins and runs DHCP against it.
const M_IWLFHBIND: u64 = 1157 // Word 18, bit 5
// `nohktab` -- W-HW6 counter-proof: the candidate scancode tables for the Fn brightness keys are empty (the behaviour before the HP table), tools/hotkeys must go red.
const M_NOHKTAB: u64 = 1158 // Word 18, bit 6

// `iwloldscan|iwloldslot|iwloldssid|iwloldmac|iwloldtxq|iwloldloss` -- W-WLAN17 counter-proofs: the driver falls back to the old behaviour (v1 scan request, channel array sized by use, no direct-SSID bits, no NVM MAC override, data frames on the command queue, no beacon-loss reconnect); the matching gate must go red.
const M_IWLOLDSCAN: u64 = 1159 // Word 18, bit 7
const M_IWLOLDSLOT: u64 = 1160 // Word 18, bit 8
const M_IWLOLDSSID: u64 = 1161 // Word 18, bit 9
const M_IWLOLDMAC: u64 = 1162 // Word 18, bit 10
const M_IWLOLDTXQ: u64 = 1163 // Word 18, bit 11
const M_IWLOLDLOSS: u64 = 1164 // Word 18, bit 12
// `iwloldpbkdf` -- W-WLAN20 counter-proof: the PMK (PBKDF2, 4096 rounds) is computed in one block without yielding; the stall gate must go red.
const M_IWLOLDPBKDF: u64 = 1165 // Word 18, bit 13
// `iwlfhdrop` -- W-WLAN20: the fake access point goes deaf after the DHCP lease (no data answers) until the station authenticates again; tests beacon-loss detection and reconnect.
const M_IWLFHDROP: u64 = 1166 // Word 18, bit 14
// `wlannoloss` -- W-WLAN21: switches the link supervision of wlan_auto off (rx timestamp, ARP probe to the gateway, reconnect on silence); it is on by default.
const M_WLANNOLOSS: u64 = 1167 // Word 18, bit 15
// `iwloldrx` -- W-WLAN21 counter-proof: the receive pump only reads the device while the network stack has a free receive slot (the old behaviour); the link supervision then sees a silent link whenever the stack does not drain frames.
const M_IWLOLDRX: u64 = 1168 // Word 18, bit 16
// `noec` -- W-HOTKEY counter-proof: the embedded controller driver stays off (no EC region, no query polling). `ecsim` -- the EC ports are served by a software model (tools/ecquery).
const M_NOEC: u64 = 1169 // Word 18, bit 17
const M_ECSIM: u64 = 1170 // Word 18, bit 18
// `iwlfhslow` -- W-WLAN23: the fake firmware raises ALIVE only after 60000 register reads (a slow real chip). `iwloldalive` -- counter-proof: the old ALIVE wait (about 25000 reads, CSR_INT bit 0 only) is used, so iwlfhslow must fail with rc=-30.
const M_IWLFHSLOW: u64 = 1171 // Word 18, bit 19
const M_IWLOLDALIVE: u64 = 1172 // Word 18, bit 20
const M_IWLFHRXONLY: u64 = 1173 // Word 18, bit 21
// `iwlnotrace` -- W-WLAN27 counter-proof: no secure-boot trace, no failure series, no experiments after an ALIVE timeout.
const M_IWLNOTRACE: u64 = 1174 // Word 18, bit 22
// `iwlfhwake` -- W-WLAN27 bed: with `iwlfhnoalive`, the fake raises ALIVE when RELEASE_CPU_RESET is written the second time after a reset.
const M_IWLFHWAKE: u64 = 1175 // Word 18, bit 23
// `iwlfhdead` -- W-WLAN27 bed: the fake never raises the ALIVE interrupt nor the ALIVE packet (the ROM hangs).
const M_IWLFHDEAD: u64 = 1176 // Word 18, bit 24
// `iwlfhrxsilent` -- W-WLAN29 bed: the fake writes RX packets into the buffers but never updates the RX status block and never raises a CSR_INT bit.
const M_IWLFHRXSILENT: u64 = 1177 // Word 18, bit 25
// `iwlnoraw` -- W-WLAN29 counter-proof: no recovery by reading the RX buffers directly after an ALIVE timeout.
const M_IWLNORAW: u64 = 1178 // Word 18, bit 26
// `iwlfhexpwake` -- W-WLAN30 bed: ALIVE only arrives when the driver writes CSR_DRAM_INT_TBL (the `dram` RX experiment).
const M_IWLFHEXPWAKE: u64 = 1179 // Word 18, bit 27
// `iwlnorxexp` -- W-WLAN30 counter-proof: the RX experiment table (fail_exp2) is not run.
const M_IWLNORXEXP: u64 = 1180 // Word 18, bit 28
// `iwlfhmsi` -- W-STICK16 bed: the fake bed has no PCI device, so the MSI experiment runs against the first PCI device that offers an MSI capability (QEMU edu).
const M_IWLFHMSI: u64 = 1181 // Word 18, bit 29
// `iwlnopoll` -- W-WLAN32 counter-proof: the 3 s register poll (fail_poll) after a failed ALIVE wait is not run.
const M_IWLNOPOLL: u64 = 1182 // Word 18, bit 30
const M_IWLNOOWN: u64 = 1183 // Word 18, bit 31
// `iwlnoipoll` -- W-WLAN37 counter-proof: the 8 s interrupt-path register poll (fail_ipoll) after a failed ALIVE wait is not run.
const M_IWLNOIPOLL: u64 = 1184 // Word 18, bit 32
// `iwlfhrfkill` -- W-WLAN37 test bed: the fake CSR window reports the hardware RF-kill switch as set (CSR_GP_CNTRL bit 27 clear).
const M_IWLFHRFKILL: u64 = 1185 // Word 18, bit 33
const M_NOSTORE: u64 = 1195 // Word 18, bit 43
// `noclass` -- net-eth class counter-proof: the class registry offers no ethernet ops table, so no NIC driver is reachable.
const M_NOCLASS: u64 = 1196 // Word 18, bit 44
// `badclass` -- net-eth class counter-proof: the table is wired with a transmit hook that drops every frame.
const M_BADCLASS: u64 = 1197 // Word 18, bit 45
// `nophykick` -- CH336 counter-proof: the USB-LAN bring-up never kicks the PHY autonegotiation.
const M_NOPHYKICK: u64 = 1198 // Word 18, bit 46
// `nochintr` -- CH336 counter-proof: the interrupt endpoint of the USB-LAN dongle is not opened, so the link comes from the PHY registers alone.
const M_NOCHINTR: u64 = 1199 // Word 18, bit 47
// `nochalt` -- CH336 counter-proof: the alternate setting scan is skipped, only alt 0 is parsed (the old behaviour).
const M_NOCHALT: u64 = 1200 // Word 18, bit 48
// `nosetif` -- CH336 counter-proof: SET_INTERFACE is not sent to the USB-LAN dongle.
const M_NOSETIF: u64 = 1201 // Word 18, bit 49
// `usbnorescan` -- counter-proof: the periodic root-port and hub-port rescan is off (boot scan only).
const M_NOUSBRESCAN: u64 = 1202 // Word 18, bit 50
// `noarpgap` -- counter-proof: ARP requests are not rate limited.
const M_NOARPGAP: u64 = 1203 // Word 18, bit 51
// `drvunload` -- driver store refcount test: after binding, try to unload every store module, release its references, unload again.
const M_DRVUNLOAD: u64 = 1204 // Word 18, bit 52
// `vgpushort` -- test bed word (needs `vgpuheads`): every forced head >= 1 is a tenth shorter than head 0.
const M_VGPUSHORT: u64 = 1205 // Word 18, bit 53
// `vgpurtmirror` -- test bed word: switch to the run-time mirror (vgpu.set_mirror) once the test image is drawn.
const M_VGPURTMIR: u64 = 1206 // Word 18, bit 54
// `drvhold` -- driver store test word: the store takes one extra reference per bound device, so `drvctl unload` must refuse.
const M_DRVHOLD: u64 = 1207 // Word 18, bit 55
// `iwlfhbigcal` -- W-WLAN bed: the fake firmware sends a real-shaped calibration sequence (large sections, many PAPD/TXP groups). `iwloldnotif` -- counter-proof: 1024-octet notification slots as before, so large calibration packets are cut and the INIT stage fails with rc=-67.
const M_IWLFHBIGCAL: u64 = 1208 // Word 18, bit 56
const M_IWLOLDNOTIF: u64 = 1209 // Word 18, bit 57
// `iwloldtype` -- counter-proof: PHY-DB section numbering as before (PAPD=3, TXP=4, everything above rejected), so the type-5 TXP group of the real 8265 firmware fails the INIT stage with rc=-71.
const M_IWLOLDTYPE: u64 = 1210 // Word 18, bit 58
const M_IWLOLDPHY: u64 = 1211 // Word 18, bit 59
// `iwloldinit` -- counter-proof: RT init as before (PHY_DB, TX_ANT, PHY_CFG; no SF_CFG, no BT_CONFIG), which the fake firmware rejects with the UMAC fatal error as the real 8265 did.
const M_IWLOLDINIT: u64 = 1212 // Word 18, bit 60
const M_IWLRT0: u64 = 1213 // Word 18, bit 61
const M_IWLRT1: u64 = 1214 // Word 18, bit 62
const M_IWLRT2: u64 = 1215 // Word 18, bit 63
const M_SLOTHOLD: u64 = 1216 // Word 19, bit 0
// `nowirelock` -- r2337 counter-proof: serial octets are written without the wire lock (the old behaviour: two writers can overwrite each other in the UART).
const M_NOWIRELOCK: u64 = 1217 // Word 19, bit 1
// `serwiden` -- r2337 test bed: a long pause between the UART ready check and the octet write, so the serline gate can see writers overlap.
const M_SERWIDEN: u64 = 1218 // Word 19, bit 2
const M_NOBLKGUARD: u64 = 1219
const M_NOAHCILOCK: u64 = 1220
const M_AHCIRACE: u64 = 1221
const M_WLTRACE: u64 = 1222 // Word 19, bit 6
const M_IWLOLDHDR: u64 = 1223
