const M_ABPANIC: u64 = 1126 // Word 17, bit 38

// `vmsvgaodd` -- tools/vmsvgaresize/odd.sh: with `vmsvgahints` the hint player plays odd sizes like a VirtualBox window with a GUI scale factor sends
