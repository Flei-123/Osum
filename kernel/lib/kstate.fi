// `nobootterm` -- the console window the kernel opens at boot starts minimized (taskbar button stays); the Start menu Terminal opens new ones.
const M_NOBOOTTERM: u64 = 1109 // Word 17, bit 21

// `nolatfix` -- W-J counter-proof: the old desktop loop (10-20 ms rounds, one compose per round, no input-latency fast path).
const M_NOLATFIX: u64 = 1110 // Word 17, bit 22

// `vmsvgastale` -- tools/vmsvgaresize/stale.sh: emulates VirtualBox's stale BYTES_PER_LINE (the register keeps the OLD mode's stride after
// a mode set) and makes the hint player cycle 1280x720, 800x600, 1024x768, 800x600. `vmsvgaold` -- counter-proof: set_mode keeps the old
// behaviour (trusts a register value >= width*4).
const M_VMSVGASTALE: u64 = 1111 // Word 17, bit 23
const M_VMSVGAOLD: u64 = 1112 // Word 17, bit 24

// `netdhot` -- W-U counter-proof: netd spins 4000 run-queue turns after every frame (the old rule; ~70 % of a core in VirtualBox)
// instead of a 1.5 ms window.
const M_NETDHOT: u64 = 1113 // Word 17, bit 25

// `noquiet` -- W-X1 counter-proof: the old desktop loop (a full round on EVERY tick even when nothing happens; QEMU 5.6-7.2 %, VBox ~25 % of a core).
const M_NOQUIET: u64 = 1114 // Word 17, bit 26

// `vmsvgaboot` -- W-C3 test bed (tools/vmsvgaboot): QEMU never has a host hint, so the boot-time fit (kgui.host_boot_fit) plays 2400x1400
// as if VirtualBox had sent it. Default OFF.
const M_VMSVGABOOT: u64 = 1115 // Word 17, bit 27

// `noserline` -- W-D1 counter-proof: `serial.put` takes no line lock (the old behaviour: lines from different cores/tasks may be interleaved).
const M_NOSERLINE: u64 = 1116 // Word 17, bit 28

// `odb=1` -- ODB debug agent on this boot (docs/ODB.md 4.1): kgui starts /bin/odbd, odbd treats the agent as enabled even without
// /etc/odb.conf. Read by user space through /proc/odb. Default OFF: no word, no conf file = no agent.
const M_ODB: u64 = 1117 // Word 17, bit 29

// `execlog` -- r1222: print the loader lines `elf: start ...` / `elf: seg ...` on the serial line for every program start. Default OFF:
// ~270 octets of synchronous UART output per exec cost ~7 ms in a VM (and ~25 ms on a real 115200 Bd line); refusals (`elf: refused`)
// are always printed. Gates that count started programs (tools/userland, tools/osum) pass the word.
const M_EXECLOG: u64 = 1125 // Word 17, bit 37

// `abpanic` -- r1242 test bed (tools/osupdate): right after ab.ab_boot the kernel stops with a fault (ud2). Only the gate puts the word on the
