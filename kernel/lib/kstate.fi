// ======================================================== ROUND NETMON
//
// MERGE: this round took 0x5A000..0x5D000 and 0x5D000..0x60000, the
// last six pages behind the old boundary. Rounds OFS3 (path buffers),
// DISPLAY (video modes) and SPEICHER (the change journal) have taken
// exactly those pages in the meantime, so both areas move up -- and
// there is not enough room left below 0x70000 either, so KDATA_SIZE
// goes from 0x70000 to 0x80000. That number stands HERE and in
// `kernel/arch/x86_64/boot.s`, and `tools/hv/run.sh` compares the two;
// both are changed.
//
// THREE PAGES, 0x6C000..0x6F000. What lives in it is the accounting
// of `kernel/netmon.fi`: six counters per task, a record per socket,
// and the seven scalars of the round. It is entered in
// `tools/kernel/memmap.py` like every other area -- that checker is the
// reason nobody has to trust this comment.
const NETMON_OFF: u64 = 0x78D000
const NETMON_MAX: u64 = 0x8000

