// SPDX-License-Identifier: GPL-2.0-only
// kernel/file.fi -- round K4: descriptors, open files and pipes.
//
// Round 62 gave a process three descriptors, and a descriptor WAS an
// inode: `T_FD + slot * 8` held the inode number, `T_FDOFF + slot * 8` the
// position, and that was the whole of it. Three things are impossible in
// that shape, and all three are things Unix programs do every day:
//
//   1. `dup2(fd, 1)` -- two descriptors that are ONE open file. With the
//      inode in the descriptor, two descriptors are two positions, and a
//      shell that points the output of a program at a file gets two
//      writers that overwrite each other.
//   2. `fork` -- parent and child SHARE the file they had open. A child
//      that reads on the inherited descriptor must move the parent's
//      position, otherwise the two read the same octets twice.
//   3. a PIPE has no inode at all.
//
// So this file introduces the layer Unix has had since 1975: the process
// holds a small array of descriptors, a descriptor points into the OPEN
// FILE TABLE of the system, and THAT entry holds the kind, the position,
// the flags and a reference count. `dup2` is then one line, `fork` is one
// loop, and a pipe is an entry whose "inode" is a ring buffer.
//
// The three console descriptors are entries 0, 1 and 2 of that table and
// belong to nobody: they carry no reference count that could reach zero,
// because a process that closes its standard output must not take the
// serial port away from every other process.
//
// Everything lives in the kernel data area (`kstate.fi`), because stage 0
// of Firn has no global mutable state -- an address is handed in, and an
// offset is what a global variable is here.

import kstate
import mnt
// RUNDE POLL: das Schliessen eines Rohrendes ist ein EREIGNIS -- es ist
// POLLHUP fuer den Leser und POLLERR fuer den Schreiber. Wer darauf
// wartet, wird von `pipe_drop` unten geweckt.
import sched
import handle

export {
    init, init_task, clear_task, close_all, inherit_task, inherit_std,
    fd_of, fd_set, fd_alloc, fd_free,
    open_alloc, open_ref, open_unref, open_kind, open_ino, open_off,
    open_set_off, open_flags, open_set_flags, open_used, open_refs,
    pipe_new, pipe_get, pipe_put, pipe_room, pipe_bytes, pipe_writers,
    pipe_readers,
    K_FREE, K_FILE, K_DIR, K_CONIN, K_CONOUT, K_PIPER, K_PIPEW, K_FB,
    K_TTY, K_SOCK, K_VFILE, K_VDIR, K_USOCK, K_SHM,
    open_mnt, open_set_mnt, open_settle,
    fd_handle, fd_rights, fd_may, fd_check, fd_set_rights, fd_pass,
    rights_of_open,
    MAX_FD, MAX_OPEN, MAX_PIPES, PIPE_CAP, CON_IN, CON_OUT, CON_ERR
}

// ------------------------------------------------------------ the shapes

const OF_BYTES: u64 = 64
const MAX_OPEN: u64 = 64 // 64 * 64 = one page

const OF_KIND: u64 = 0
const OF_INO: u64 = 8 // inode, or the number of the pipe
const OF_OFF: u64 = 16 // read/write position, or the entry of a directory
const OF_REF: u64 = 24 // how many descriptors point here
const OF_FLAGS: u64 = 32 // what `open` was asked for
// ROUNDE K14: welche EINHAENGUNG. Ein Eintrag ist 64 Oktette gross und
// war bis 40 belegt; hier stand also Platz. Fuer alles ausser K_VFILE
// und K_VDIR ist das Feld null, und null ist die Wurzel -- ein alter
// Eintrag bedeutet damit weiter genau, was er bedeutet hat.
const OF_MNT: u64 = 40

const K_FREE: u64 = 0
const K_FILE: u64 = 1
const K_DIR: u64 = 2
const K_CONIN: u64 = 3 // the console, reading
const K_CONOUT: u64 = 4 // the console, writing
const K_PIPER: u64 = 5 // the reading end of a pipe
const K_PIPEW: u64 = 6 // the writing end of a pipe
// ROUNDE K7: /dev/fb. Ein Eintrag ohne Inode -- wie die Konsole und die
// Roehre. Was ihn von der Konsole unterscheidet, ist die Position: ein
// Rahmenpuffer hat eine Groesse, also darf `lseek` darauf, und `write`
// schreibt an die Stelle, an der die Position steht.
const K_FB: u64 = 7

// ROUND K9: ein Deskriptor, der ein TERMINAL ist. `ino` ist dann die
// Nummer des Terminals aus `kernel/tty.fi` -- die Nutzerseite eines
// Pseudoterminals ebenso wie die Steuerseite. Die Konsole selbst bleibt
// K_CONIN/K_CONOUT: an ihr haengen die Messungen der Runden 62 bis K6,
// und die sollen Zeile fuer Zeile messen, was sie gemessen haben.
const K_TTY: u64 = 8

// ROUND K8: a socket. `OF_INO` holds the number of the entry in the
// socket table of `inet.fi`, exactly the way it holds the number of a
// pipe for the two above. Nothing in THIS file learns what a socket is:
// `read`, `write`, `close`, `dup2` and `fork` go on doing what they did,
// and the one place that has to know is `sys.fi`, which is where the
// kind is looked at.
//
// The reference count is what makes that safe. A socket that is `dup`ed
// or inherited over `fork` must not be torn down when one of the two
// descriptors is closed, and `open_unref` already answers that question
// for pipes -- `sys.fi` asks it before it closes the connection.
const K_SOCK: u64 = 9

// ROUNDE K14: EIN DESKRIPTOR AUF EINEM FREMDEN DATEISYSTEM. Die
// Nummern 12 und 13 sind die, die der Auftrag dieser Runde zugeteilt
// hat -- 10 und 11 gehoeren einer Runde, die gleichzeitig laeuft, und
// zwei Runden, die dieselbe Zahl nehmen, sind der Fehler, den dieses
// Projekt in `kdata` viermal gemacht hat.
//
// Was sie von K_FILE und K_DIR unterscheidet, ist EINE Zahl: der
// Eintrag traegt zusaetzlich die EINHAENGUNG (`OF_MNT`). `OF_INO`
// heisst dann nicht "Inode", sondern "Knoten", und was ein Knoten ist,
// weiss nur der Treiber. Die Referenzzaehlung, `dup2`, `fork` und
// `close` aendern dafuer keine Zeile -- genau das ist der Sinn der
// Tafel der offenen Dateien aus Runde K4.
const K_VFILE: u64 = 12
const K_VDIR: u64 = 13

// RUNDE WAYLAND: DER LOKALE SOCKET UND DAS SPEICHEROBJEKT.
//
// Warum NICHT K_SOCK mitbenutzt wird, obwohl beides "Socket" heisst:
// `OF_INO` traegt bei K_SOCK die Nummer eines Platzes in `inet.fi`,
// und die Tabellen von `inet.fi` und `unixsock.fi` sind zwei
// verschiedene Tabellen mit eigener Zaehlung. Ein `close` auf einen
// Unix-Socket wuerde sonst den INET-Platz derselben Nummer schliessen
// -- eine fremde Verbindung, die nichts damit zu tun hat. Eine eigene
// Art kostet eine Zahl und macht diesen Fehler unmoeglich.
//
// K_SHM ist ein Deskriptor OHNE Inode und ohne Datei: `OF_INO` ist die
// Nummer des Speicherobjekts in `unixsock.fi`. `mmap` darauf bildet
// dessen Rahmen ab, und zwar in JEDEN Prozess, der ihn hat -- das ist
// der Unterschied zwischen MAP_SHARED und MAP_PRIVATE und der Grund,
// warum es diese Art gibt.
const K_USOCK: u64 = 14
const K_SHM: u64 = 15

// The three that are there before the first process is.
const CON_IN: u64 = 0
const CON_OUT: u64 = 1
const CON_ERR: u64 = 2

const MAX_FD: u64 = 16 // descriptors per process

const MAX_PIPES: u64 = 8
const PIPE_CAP: u64 = 512
const PH_BYTES: u64 = 64
const PH_READ: u64 = 0
const PH_WRITE: u64 = 8
const PH_READERS: u64 = 16
const PH_WRITERS: u64 = 24
const PH_USED: u64 = 32

fn of_at(i: u64) -> u64 {
    return kstate.OFILE_OFF + i * OF_BYTES
}

fn ph_at(i: u64) -> u64 {
    return kstate.PIPEHDR_OFF + i * PH_BYTES
}

// ---------------------------------------------------------- the console

// Called once, before the first task. The data area is zeroed by `boot.s`,
// so everything else is already free; only the three console entries have
// to exist, and they exist for good.
fn init(state: u64) {
    kstate.set(state, of_at(CON_IN) + OF_KIND, K_CONIN)
    kstate.set(state, of_at(CON_IN) + OF_REF, 1)
    kstate.set(state, of_at(CON_OUT) + OF_KIND, K_CONOUT)
    kstate.set(state, of_at(CON_OUT) + OF_REF, 1)
    kstate.set(state, of_at(CON_ERR) + OF_KIND, K_CONOUT)
    kstate.set(state, of_at(CON_ERR) + OF_REF, 1)
}

// ------------------------------------------------------ the descriptors

// RUNDE HANDLE: EIN DESKRIPTOR IST AB JETZT EIN HANDLE.
//
// Bis zu dieser Runde stand in diesem Platz der Index der offenen Datei
// PLUS EINS -- eine rohe Zahl, und wer sie riet, hatte sie. Jetzt steht
// darin ein HANDLE aus `kernel/handle.fi`: Platz, Generation, Wuerfelwert
// des Prozesses, und daran haengt ein Rechte-Bitfeld. Die 0 heisst
// weiter "geschlossen", damit eine genullte Seite eine leere Tafel ist,
// und `fd_alloc` sucht weiter nach der 0 -- die Regel "der kleinste
// freie Deskriptor" gilt unveraendert.
//
// WAS SICH FUER DEN REST DES KERNELS NICHT AENDERT: `fd_of` gibt
// weiterhin den Index der offenen Datei zurueck. Jede Zeile in
// `sys.fi`, `elf.fi` und `procfs.fi`, die einen Deskriptor aufloest,
// laeuft damit ab jetzt durch die Handle-Schicht, ohne dass sie
// umgeschrieben werden musste. Das war der Sinn der Tafel der offenen
// Dateien aus Runde K4, und er traegt ein zweites Mal.
fn slot_at(task: u64, fd: u64) -> u64 {
    return kstate.FDTAB_OFF + (task * MAX_FD + fd) * 8
}

// Das Handle hinter einem Deskriptor, oder handle.HANDLE_NONE.
fn fd_handle(state: u64, task: u64, fd: u64) -> u64 {
    if fd >= MAX_FD || task >= kstate.MAX_TASKS {
        return handle.HANDLE_NONE
    }
    return kstate.get(state, slot_at(task, fd))
}

// The open file behind a descriptor, or MAX_OPEN when there is none.
fn fd_of(state: u64, task: u64, fd: u64) -> u64 {
    return fd_check(state, task, fd, 0)
}

// DER EINE AUFRUF JE SYSTEMAUFRUF: Deskriptor aufloesen UND das Recht
// pruefen. `sys.fi` ruft im Lese-, Schreib- und Suchpfad NUR DAS -- die
// erste Fassung dieser Runde hat `fd_of` und `fd_may` getrennt gerufen
// und damit die ganze Aufloesung zweimal gemacht; das waren gemessen
// 296 statt 109 Zyklen Aufschlag auf einen `lseek`.
//
// `need` = 0 heisst "nur aufloesen". Die Rechnung fuer den Platz steht
// hier ausgeschrieben und nicht in `slot_at`: ein Aufruf ueber
// Modulgrenzen kostet auf diesem Wirt gemessen 5 bis 7 Zyklen.
fn fd_check(state: u64, task: u64, fd: u64, need: u64) -> u64 {
    if fd >= MAX_FD || task >= kstate.MAX_TASKS {
        return MAX_OPEN
    }
    let h: u64 = __mmio_read64(
        (state + kstate.FDTAB_OFF + (task * MAX_FD + fd) * 8) as *mut u64)
    if h == handle.HANDLE_NONE {
        return MAX_OPEN
    }
    // MAX_OBJ und MAX_OPEN sind dieselbe Zahl -- der Aufrufer
    // vergleicht wie immer gegen MAX_OPEN und merkt nichts davon.
    return handle.resolve_num(state, task, h, need)
}

// Die Rechte des Handles hinter einem Deskriptor.
fn fd_rights(state: u64, task: u64, fd: u64) -> u64 {
    return handle.rights_of(state, task, fd_handle(state, task, fd))
}

// DIE ZWEITE HAELFTE DER TIEFENSTAFFELUNG. Die erste ist `perm.may` --
// die uid/gid-Frage aus Runde K13, die beim OEFFNEN gestellt wird. Diese
// hier wird bei JEDEM Zugriff gestellt und fragt etwas anderes: nicht
// "darf dieser Benutzer die Datei?", sondern "traegt DIESES Handle das
// Recht?". Ein Handle, das weitergegeben und dabei beschnitten wurde,
// faellt hier durch, obwohl der Benutzer die Datei duerfte -- und genau
// dafuer ist es da.
//
// Gegenprobe `norights`: die Frage wird gestellt und immer mit ja
// beantwortet. Die uid/gid-Pruefung bleibt dann trotzdem stehen, also
// zeigt der Testlauf genau den Unterschied, den diese Schicht macht.
fn fd_may(state: u64, task: u64, fd: u64, need: u64) -> bool {
    let h: u64 = fd_handle(state, task, fd)
    if h == handle.HANDLE_NONE {
        return false
    }
    return handle.may(state, task, h, need)
}

// Einen Deskriptor auf eine offene Datei legen, mit AUSDRUECKLICHEN
// Rechten. `fd_set` darunter leitet die Rechte aus den Flags ab; wer
// vererbt oder weitergibt, reicht die Rechte durch, die er selbst hatte
// -- sie koennen dabei nur kleiner werden.
fn fd_set_rights(state: u64, task: u64, fd: u64, open: u64,
    rights: u64) -> bool {
    if fd >= MAX_FD || task >= kstate.MAX_TASKS {
        return false
    }
    if open >= MAX_OPEN {
        return false
    }
    let o: u64 = handle.obj_get(state, handle.OK_FILE, open)
    if o >= handle.MAX_OBJ {
        return false
    }
    let h: u64 = handle.insert(state, task, o, rights)
    if h == handle.HANDLE_NONE {
        handle.obj_unref(state, o)
        return false
    }
    kstate.set(state, slot_at(task, fd), h)
    return true
}

// Welche Rechte ein Eintrag der offenen Dateien traegt. Fast immer sind
// das die Flags, mit denen `open` gerufen wurde -- aber nicht bei den
// drei Konsoleneintraegen: die legt `init` an, BEVOR es einen Prozess
// gibt, und sie haben nie ein `open` gesehen. Ihre Flags sind null, und
// null heisst "nur lesen". Ohne die zwei Zeilen unten haette fd 1
// kein Schreibrecht und JEDE Ausgabe dieses Kernels waere -EBADF.
//
// Was sie duerfen, sagt hier also ihre ART und nicht ihr Flag. Die
// Prueffunktionen `readable` und `writable` in `sys.fi` bleiben davon
// unberuehrt -- sie fragen weiter die Flags, und der Pfad fuer die
// Konsole kommt in `read_of`/`write_of` ohnehin vor ihnen.
fn rights_of_open(state: u64, i: u64) -> u64 {
    var r: u64 = handle.rights_for_flags(kstate.get(state, of_at(i) + OF_FLAGS))
    let kind: u64 = kstate.get(state, of_at(i) + OF_KIND)
    if kind == K_CONIN {
        r = r | handle.R_READ
    }
    if kind == K_CONOUT {
        r = r | handle.R_WRITE
    }
    return r
}

fn fd_set(state: u64, task: u64, fd: u64, open: u64) -> bool {
    if open >= MAX_OPEN {
        return false
    }
    return fd_set_rights(state, task, fd, open, rights_of_open(state, open))
}

fn fd_free(state: u64, task: u64, fd: u64) {
    if fd >= MAX_FD || task >= kstate.MAX_TASKS {
        return
    }
    let h: u64 = kstate.get(state, slot_at(task, fd))
    if h != handle.HANDLE_NONE {
        handle.drop(state, task, h)
    }
    kstate.set(state, slot_at(task, fd), 0)
}

// EIN DESKRIPTOR AUSDRUECKLICH AN EIN KIND. Das Gegenteil von "alles
// wird vererbt": genau dieser eine, an genau diesen Platz, mit hoechstens
// diesen Rechten. `handle.give` schneidet die Maske mit dem, was der
// Gebende selbst hat -- groesser werden kann dabei nichts.
//
// Liefert den Deskriptor im Kind, oder MAX_FD.
fn fd_pass(state: u64, from: u64, to: u64, fd: u64, mask: u64,
    tofd: u64) -> u64 {
    if tofd >= MAX_FD || to >= kstate.MAX_TASKS {
        return MAX_FD
    }
    let of: u64 = fd_of(state, from, fd)
    if of >= MAX_OPEN {
        return MAX_FD
    }
    if kstate.get(state, slot_at(to, tofd)) != 0 {
        return MAX_FD
    }
    let nh: u64 = handle.give(state, from, to, fd_handle(state, from, fd), mask)
    if handle.is_err(nh) {
        return MAX_FD
    }
    open_ref(state, of)
    kstate.set(state, slot_at(to, tofd), nh)
    return tofd
}

// The lowest free descriptor -- the rule every Unix program relies on when
// it closes 0 and opens a file to get 0 back. MAX_FD = none free.
fn fd_alloc(state: u64, task: u64, from: u64) -> u64 {
    var fd: u64 = from
    while fd < MAX_FD {
        if kstate.get(state, slot_at(task, fd)) == 0 {
            return fd
        }
        fd = fd + 1
    }
    return MAX_FD
}

// A new process: the three standard descriptors and nothing else.
fn init_task(state: u64, task: u64) {
    clear_task(state, task)
    fd_set(state, task, 0, CON_IN)
    fd_set(state, task, 1, CON_OUT)
    fd_set(state, task, 2, CON_ERR)
}

// RUNDE HANDLE: ein Platz, in dem noch ein Handle steht, wird
// ORDENTLICH hergegeben und nicht nur ueberschrieben. Sonst haelt ein
// Objekt einen Verweis von einem Prozess, den es nicht mehr gibt, und
// die Objekttafel laeuft in einem Lauf von Stunden voll.
fn clear_task(state: u64, task: u64) {
    if task >= kstate.MAX_TASKS {
        return
    }
    var fd: u64 = 0
    while fd < MAX_FD {
        fd_free(state, task, fd)
        fd = fd + 1
    }
}

// `fork`: the child gets the SAME open files, not copies of them. Every
// entry one more reference -- that is what makes a position shared and a
// pipe that stays open as long as one of the two still holds it.
fn inherit_task(state: u64, parent: u64, child: u64) {
    clear_task(state, child)
    var fd: u64 = 0
    while fd < MAX_FD {
        let of: u64 = fd_of(state, parent, fd)
        if of < MAX_OPEN {
            open_ref(state, of)
            // RUNDE HANDLE: das Kind bekommt die Rechte, die der
            // ELTERNTEIL hatte -- nicht die, die aus den Flags folgen
            // wuerden. Wer sein Handle beschnitten bekommen hat, gibt
            // ein beschnittenes weiter. Rechte werden ueber `fork`
            // hinweg nie groesser.
            fd_set_rights(state, child, fd, of,
                fd_rights(state, parent, fd))
        }
        fd = fd + 1
    }
}

// ROUND K6: the three STANDARD descriptors and nothing else. `fork` hands
// a child everything, because the child IS the parent and every open file
// of it goes on being open. The one-call start of round K1
// (`SYS_OSUM_EXEC`, `elf.spawn`) is not a fork: what the caller wants the
// child to have is where its output goes, and what it does NOT want to
// hand over is the descriptor the shell keeps its own console copy in.
// Without this the first `open` of every program was 6 instead of 3, and
// `tools/posix/run.sh` measures exactly that number.
// RUNDE HANDLE, DER SCHALTER `hstrict`: NICHTS WIRD GEERBT.
//
// Das Ziel ist "ein Kind bekommt nur, was ihm ausdruecklich uebergeben
// wurde", und die Handle-Schicht kann das seit dieser Runde
// (`fd_pass`). Der VOREINGESTELLTE Weg ist es trotzdem noch nicht, und
// hier steht ehrlich, was daran haengt:
//
//   1. /bin/sh und die dreiundzwanzig Werkzeuge aus Runde K6 lesen von
//      0 und schreiben nach 1, ohne je danach gefragt zu haben. Eine
//      Shell, die jedem Kind seine Deskriptoren einzeln uebergeben
//      muesste, ist eine ANDERE Shell -- und `tools/userland/run.sh`,
//      `tools/osum/run.sh` und `tools/unix/run.sh` messen Zeile fuer
//      Zeile das heutige Verhalten.
//   2. UND DIESER SCHALTER ERWISCHT NICHT ALLES, das steht hier, damit
//      niemand mehr hineinliest, als drinsteht: er stellt die VERERBUNG
//      ab, also den Weg von einem Prozess zu seinem Kind ueber
//      `elf.spawn`. Die ERSTE Shell kommt aber nicht so zustande --
//      sie startet aus dem Bootprozess, und der hat selbst keine
//      Deskriptoren, also ruft `elf.spawn` `inherit_std` fuer sie gar
//      nicht auf (siehe dort). Ihre drei bekommt sie von
//      `file.init_task` in `proc.create_bare`. Wer wirklich "nichts
//      ausser explizit uebergeben" will, muss AUCH `init_task` leeren
//      und dem Init-Prozess seine Deskriptoren ausdruecklich geben --
//      das ist eine eigene Runde und keine Zeile hier.
//
// Also: der strenge Modus ist ein SCHALTER und keine Umstellung. Mit
// `hstrict` bekommt ein Kind NICHTS, und der Testlauf misst, dass es
// dann wirklich nichts bekommt. Ohne ihn bleibt alles, wie es war --
// nur laeuft es jetzt durch Handles mit Rechten statt durch rohe Zahlen.
fn inherit_std(state: u64, parent: u64, child: u64) {
    clear_task(state, child)
    if kstate.mode_on(state, kstate.M_HSTRICT) {
        return
    }
    let logof: u64 = kstate.get(state, kstate.LOGOPEN)
    var fd: u64 = 0
    while fd < 3 {
        let of: u64 = fd_of(state, parent, fd)
        if of < MAX_OPEN {
            if fd != 0 && logof != 0 && of == logof {
                // RUNDE BLECH2: DAS PROTOKOLL WIRD NICHT VERERBT. Die
                // Schreibtischprogramme schreiben auf ein Terminal, das
                // nur auf die Leitung geht (kgui.protokoll_binden). Was
                // SIE starten -- ein `sh` aus dem Startmenue -- soll
                // aber in das Terminalfenster schreiben wie bisher: es
                // bekommt die Konsoleneintraege CON_OUT (1) und CON_ERR
                // (2), die `init` fuer die ersten Prozesse angelegt hat.
                open_ref(state, fd)
                fd_set_rights(state, child, fd, fd, rights_of_open(state, fd))
            } else {
                open_ref(state, of)
                fd_set_rights(state, child, fd, of, fd_rights(state, parent, fd))
            }
        }
        fd = fd + 1
    }
}

// The end of a process. Every descriptor it still holds is one reference
// less -- and a pipe whose last writer ends is what makes the reader at
// the other end see the end of the input instead of waiting forever.
fn close_all(state: u64, task: u64) {
    if task >= kstate.MAX_TASKS {
        return
    }
    var fd: u64 = 0
    while fd < MAX_FD {
        let of: u64 = fd_of(state, task, fd)
        if of < MAX_OPEN {
            open_unref(state, of)
        }
        // RUNDE HANDLE: erst den Verweis der offenen Datei, dann den des
        // Objekts. `fd_free` gibt beides in der richtigen Reihenfolge
        // her; ein blosses Nullsetzen wuerde den Objektverweis verlieren.
        fd_free(state, task, fd)
        fd = fd + 1
    }
}

// ------------------------------------------------------ the open files

fn open_used(state: u64, i: u64) -> bool {
    if i >= MAX_OPEN {
        return false
    }
    return kstate.get(state, of_at(i) + OF_KIND) != K_FREE
}

// A free entry, with one reference. The three console entries are never
// handed out: the search starts behind them.
fn open_alloc(state: u64, kind: u64, ino: u64, flags: u64) -> u64 {
    var i: u64 = CON_ERR + 1
    while i < MAX_OPEN {
        if kstate.get(state, of_at(i) + OF_KIND) == K_FREE {
            kstate.set(state, of_at(i) + OF_KIND, kind)
            kstate.set(state, of_at(i) + OF_INO, ino)
            kstate.set(state, of_at(i) + OF_OFF, 0)
            kstate.set(state, of_at(i) + OF_REF, 1)
            kstate.set(state, of_at(i) + OF_FLAGS, flags)
            // ROUNDE K14: ein frischer Eintrag gehoert der WURZEL,
            // bis jemand etwas anderes sagt. Ein stehengebliebener
            // Wert aus einem vorherigen Leben waere ein Deskriptor,
            // der auf einer laengst ausgehaengten Platte liest.
            kstate.set(state, of_at(i) + OF_MNT, 0)
            kstate.add(state, kstate.OPENS, 1)
            return i
        }
        i = i + 1
    }
    return MAX_OPEN
}

fn open_ref(state: u64, i: u64) {
    if i >= MAX_OPEN || i <= CON_ERR {
        return // the console has no count that could run out
    }
    kstate.add(state, of_at(i) + OF_REF, 1)
}

// One reference less. At zero the entry is free again -- and if it was one
// end of a pipe, that end is now closed for good.
fn open_unref(state: u64, i: u64) {
    if i >= MAX_OPEN || i <= CON_ERR {
        return
    }
    let r: u64 = kstate.get(state, of_at(i) + OF_REF)
    if r > 1 {
        kstate.set(state, of_at(i) + OF_REF, r - 1)
        return
    }
    kstate.set(state, of_at(i) + OF_REF, 0)
    // ================================ RUNDE HANDLE: KEIN FREE IN FLUG
    //
    // Der letzte Deskriptor ist weg -- aber laeuft auf diesem Eintrag
    // noch ein Auftrag, wird hier NICHT abgeraeumt. Der Eintrag bleibt
    // stehen, ohne dass ihn ein Handle noch erreichen kann, bis
    // `open_settle` ihn holt; das tut `sys.fi`, wenn `handle.req_end`
    // meldet, dass der letzte Auftrag gefallen ist.
    //
    // Ohne diese vier Zeilen ist ein `close` waehrend eines laufenden
    // Auftrags ein Use-after-free -- die Fehlerklasse, aus der 2023 rund
    // 60 % der eingereichten Linux-Kernel-Exploits kamen. Die Gegenprobe
    // `noflight` laesst den Mitzaehler weg und zeigt genau das.
    if handle.inflight_on(state, handle.OK_FILE, i) != 0 {
        kstate.add(state, kstate.H_DEFERRED, 1)
        return
    }
    open_teardown(state, i)
}

// Der Eintrag wird WIRKLICH abgeraeumt. Zwei Wege fuehren hierher: der
// letzte Deskriptor faellt und es laeuft nichts mehr (`open_unref`),
// oder der letzte Auftrag faellt und es gibt keinen Deskriptor mehr
// (`open_settle`). Wer zuletzt geht, macht das Licht aus.
fn open_teardown(state: u64, i: u64) {
    let kind: u64 = kstate.get(state, of_at(i) + OF_KIND)
    let p: u64 = kstate.get(state, of_at(i) + OF_INO)
    if kind == K_PIPER {
        pipe_drop(state, p, true)
    }
    if kind == K_PIPEW {
        pipe_drop(state, p, false)
    }
    // ROUNDE K14: DIE EINHAENGUNG GIBT DEN DESKRIPTOR FREI, UND ZWAR
    // HIER. Nicht in `sys.do_close`: ein Prozess, der stirbt, geht
    // durch `close_all`, und ein `dup2`, das einen Deskriptor
    // ueberschreibt, geht durch keinen von beiden. DIESE Funktion ist
    // die EINZIGE Stelle, an der die letzte Bezugnahme auf einen
    // Eintrag faellt -- also gehoert der Zaehler hierher.
    //
    // Die erste Fassung dieser Runde hat ihn in `sys.unref_of`
    // gesetzt, und damit blieb `mnt.opens` nach jedem Prozess, der
    // eine Datei auf /mnt geoeffnet hatte und ohne `close` endete, um
    // eins zu hoch stehen. `umount /mnt` haette danach fuer immer
    // -EBUSY gesagt.
    if kind == K_VFILE || kind == K_VDIR {
        mnt.open_dec(state, kstate.get(state, of_at(i) + OF_MNT))
    }
    kstate.set(state, of_at(i) + OF_KIND, K_FREE)
    kstate.set(state, of_at(i) + OF_INO, 0)
    kstate.set(state, of_at(i) + OF_OFF, 0)
    kstate.set(state, of_at(i) + OF_REF, 0)
    kstate.set(state, of_at(i) + OF_FLAGS, 0)
    kstate.set(state, of_at(i) + OF_MNT, 0)
}

// Der letzte Auftrag auf diesem Eintrag ist fertig. Steht kein
// Deskriptor mehr darauf, wird jetzt abgeraeumt -- die Freigabe, die
// `open_unref` aufgehalten hat. Steht noch einer darauf, passiert
// nichts: dann lebt der Eintrag zu Recht weiter.
fn open_settle(state: u64, i: u64) {
    if i >= MAX_OPEN || i <= CON_ERR {
        return
    }
    if kstate.get(state, of_at(i) + OF_KIND) == K_FREE {
        return
    }
    if kstate.get(state, of_at(i) + OF_REF) != 0 {
        return
    }
    if handle.inflight_on(state, handle.OK_FILE, i) != 0 {
        return
    }
    open_teardown(state, i)
}

// How many descriptors still point here. ROUND K8 needs it: a socket
// that was `dup`ed or inherited over `fork` must not have its connection
// torn down when the FIRST of the two descriptors is closed.
fn open_refs(state: u64, i: u64) -> u64 {
    if i >= MAX_OPEN {
        return 0
    }
    return kstate.get(state, of_at(i) + OF_REF)
}

fn open_kind(state: u64, i: u64) -> u64 {
    if i >= MAX_OPEN {
        return K_FREE
    }
    return kstate.get(state, of_at(i) + OF_KIND)
}

fn open_ino(state: u64, i: u64) -> u64 {
    return kstate.get(state, of_at(i) + OF_INO)
}

fn open_off(state: u64, i: u64) -> u64 {
    return kstate.get(state, of_at(i) + OF_OFF)
}

fn open_set_off(state: u64, i: u64, off: u64) {
    kstate.set(state, of_at(i) + OF_OFF, off)
}

fn open_mnt(state: u64, i: u64) -> u64 {
    return kstate.get(state, of_at(i) + OF_MNT)
}

fn open_set_mnt(state: u64, i: u64, v: u64) {
    kstate.set(state, of_at(i) + OF_MNT, v)
}

fn open_flags(state: u64, i: u64) -> u64 {
    return kstate.get(state, of_at(i) + OF_FLAGS)
}

fn open_set_flags(state: u64, i: u64, f: u64) {
    kstate.set(state, of_at(i) + OF_FLAGS, f)
}

// ------------------------------------------------------------- the pipes

// A pipe is 512 octets and two positions that only ever grow; what is in
// it is the difference between them, and that makes the empty case and the
// full case one comparison each instead of a flag nobody updates.
fn pipe_new(state: u64) -> u64 {
    var i: u64 = 0
    while i < MAX_PIPES {
        if kstate.get(state, ph_at(i) + PH_USED) == 0 {
            kstate.set(state, ph_at(i) + PH_USED, 1)
            kstate.set(state, ph_at(i) + PH_READ, 0)
            kstate.set(state, ph_at(i) + PH_WRITE, 0)
            kstate.set(state, ph_at(i) + PH_READERS, 1)
            kstate.set(state, ph_at(i) + PH_WRITERS, 1)
            kstate.add(state, kstate.PIPES, 1)
            return i
        }
        i = i + 1
    }
    return MAX_PIPES
}

// One end of it closed. When both are gone the pipe is free again.
fn pipe_drop(state: u64, i: u64, reader: bool) {
    if i >= MAX_PIPES {
        return
    }
    if reader {
        let r: u64 = kstate.get(state, ph_at(i) + PH_READERS)
        if r > 0 {
            kstate.set(state, ph_at(i) + PH_READERS, r - 1)
        }
    } else {
        let w: u64 = kstate.get(state, ph_at(i) + PH_WRITERS)
        if w > 0 {
            kstate.set(state, ph_at(i) + PH_WRITERS, w - 1)
        }
    }
    let rd: u64 = kstate.get(state, ph_at(i) + PH_READERS)
    let wr: u64 = kstate.get(state, ph_at(i) + PH_WRITERS)
    if rd == 0 && wr == 0 {
        kstate.set(state, ph_at(i) + PH_USED, 0)
    }
    // RUNDE POLL: DIE EINZIGE STELLE, an der ein Rohrende zugeht --
    // `open_unref` oben ist der einzige Weg hierher, und durch ihn
    // gehen `close`, `dup2` und der Tod eines Prozesses gleichermassen.
    sched.poll_kick(state)
}

fn pipe_bytes(state: u64, i: u64) -> u64 {
    if i >= MAX_PIPES {
        return 0
    }
    let w: u64 = kstate.get(state, ph_at(i) + PH_WRITE)
    let r: u64 = kstate.get(state, ph_at(i) + PH_READ)
    return w - r
}

fn pipe_room(state: u64, i: u64) -> u64 {
    return PIPE_CAP - pipe_bytes(state, i)
}

fn pipe_writers(state: u64, i: u64) -> u64 {
    if i >= MAX_PIPES {
        return 0
    }
    return kstate.get(state, ph_at(i) + PH_WRITERS)
}

fn pipe_readers(state: u64, i: u64) -> u64 {
    if i >= MAX_PIPES {
        return 0
    }
    return kstate.get(state, ph_at(i) + PH_READERS)
}

// One octet in, one octet out. The positions grow without end and only the
// low nine bits pick the place -- so nothing has to be moved when the ring
// wraps around.
fn pipe_put(state: u64, i: u64, v: u64) -> bool {
    if pipe_room(state, i) == 0 {
        return false
    }
    let w: u64 = kstate.get(state, ph_at(i) + PH_WRITE)
    let at: u64 = state + kstate.PIPEBUF_OFF + i * PIPE_CAP + (w % PIPE_CAP)
    kstate.set8(at, v as u8)
    kstate.set(state, ph_at(i) + PH_WRITE, w + 1)
    return true
}

// The octet, or 256 when there is none -- a value no octet has.
fn pipe_get(state: u64, i: u64) -> u64 {
    if pipe_bytes(state, i) == 0 {
        return 256
    }
    let r: u64 = kstate.get(state, ph_at(i) + PH_READ)
    let at: u64 = state + kstate.PIPEBUF_OFF + i * PIPE_CAP + (r % PIPE_CAP)
    let v: u64 = kstate.get8(at)
    kstate.set(state, ph_at(i) + PH_READ, r + 1)
    return v
}
