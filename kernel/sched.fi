// SPDX-License-Identifier: GPL-2.0-only
// kernel/sched.fi -- round 62: tasks and the scheduler.
//
// Round 59 had one thread of control: `kernel_main` ran from top to
// bottom, and the only thing that ever took the processor away from it
// was an interrupt that gave it straight back. From here on the kernel
// has TASKS, and the timer takes the processor away for good.
//
// A task is 256 octets in the data area (`kstate.TASK_OFF`) plus a
// KERNEL STACK OF ITS OWN out of the frame allocator. Everything a task
// needs in order to be interrupted in the middle and continued later
// lives on that stack; the task record only holds the stack pointer.
// That is the whole trick of a context switch, and `switch.s` does the
// six lines that a language cannot do.
//
// THE PLAN: weighted round robin. Every ready task gets a turn, in the
// order of the table, and the length of the turn is its priority in timer
// ticks. Priority 3 therefore gets three times the processor of priority
// 1 -- and nothing starves, which is what a strict priority order would
// do. The proof is in `tools/kernel/run.sh`: three workers with the
// priorities 1, 2 and 3 do the same amount of work, and the one with the
// highest priority is done first.
//
// THE COUNTER-CHECK belongs to it: with `nopreempt` on the command line
// the timer does not switch, and the same three workers run one after the
// other -- each one scheduled exactly ONCE. Interleaving that a spin loop
// produces on its own would show up here.

import serial
import kstate
import mem
import atomic
import cpu
import arch.x86_64.fpu
import msr
// RUNDE BLECHEINGABE: der Zyklenzaehler, um einen STEHENDEN Zeitgeber
// zu erkennen. `apic.fi` bindet nur serial/kstate/pci ein -- kein Kreis.
import arch.x86_64.apic

export {
    init, create, start, schedule, on_tick, yield_now, sleep_ticks,
    tote_schlaefe,
    exit_task, reap,
    kill_current, wake_pid, find_pid, current, tget, tset, task_at,
    stack_high, STACK_PAINT,
    // RUNDE LEISTE: die Waechterseite unter jedem Kernstapel.
    guard_faults, guard_last_pid, guard_last_depth, guard_broken,
    trace_push, trace_dump, dump_tasks, ready_count, alive_count,
    irq_save, irq_restore, set_kernel_stack,
    adopt, enter_task, set_idle, zombies, reap_all, cpu_of, cpu_mask,
    clear_signals,
    set_affinity, affinity, ANY_CPU, ring3_foreign,
    gs_melden, gs_ready, gs_error, ring3_kerne, gs_soll, gs_check,
    kstack_hier, kstack_again, ring3_all_set, ring3_alle_an, hier,
    gs_lie_set, gs_luege_an, r3blind_set, r3blind_an,
    ring3_bericht, syscalls_of, syscalls_sum, kerne, ring3_prozesse,
    T_STATE, T_PID, T_RSP, T_KSTACK, T_KTOP, T_PRIO, T_BUDGET, T_WORK,
    T_WAKE, T_CR3, T_PARENT, T_EXIT, T_RUNS, T_ENTRY, T_USTACK, T_KIND,
    T_WAITPID, T_TICKS, T_PDPT, T_PD, T_PT, T_DATA, T_CWD, T_ARG,
    T_END, T_FD, T_FDOFF, T_FAULTS, FD_SLOTS, T_BRK, T_MMAP,
    S_FREE, S_READY, S_RUN, S_SLEEP, S_WAIT, S_ZOMBIE, S_NEW, S_STOP,
    T_SIGPEND, T_SIGMASK, T_SIGLAST, T_PGID, T_SID, T_TTY, T_SIGDEL, T_STOPSIG,
    T_SIGRET, T_ALARM, T_TGID, T_SHARED, T_FUTEX, T_FUTEXVAL,
    T_KILLCODE, T_UID, T_GID, T_EUID, T_EGID, T_SUID,
    T_SGID, T_UMASK, K_BOOT, K_IDLE, K_WORKER, K_USER,
    K_GRIND, KSTACK_FRAMES, K_NETD, K_AIO, K_VEC, K_YIELD, T_BIG,
    T_NETV, T_NETOK, NETOK_MAX,
    S_POLL, T_POLLSEQ, poll_seq, poll_kick, poll_kick_one, poll_sleep,
    POLL_FOREVER,
    // ---- RUNDE MULTIUSER ----
    T_NGROUPS, groups_count, groups_at, groups_has, groups_set,
    groups_clear, groups_inherit, GROUPS_MAX,
    // ---- RUNDE AVX ----
    T_FPU, fpu_area, fpu_set_area, fpu_inherit, fpu_reset,
    // ---- RUNDE LAUFZEIT ----
    T_FSBASE, fsbase_apply,
}

// ------------------------------------------------------ the task record

const T_STATE: u64 = 0 // one of the S_* below
const T_PID: u64 = 8
const T_RSP: u64 = 16 // where the switch left the stack pointer
const T_KSTACK: u64 = 24 // lowest octet of the kernel stack
const T_KTOP: u64 = 32 // upper end of it
const T_PRIO: u64 = 40 // 1..3, also the length of a turn in ticks
const T_BUDGET: u64 = 48 // ticks left in this turn
const T_WORK: u64 = 56 // what the task counted up itself; in a
// process before its start: its argument
const T_WAKE: u64 = 64 // tick at which a sleeper is due
const T_CR3: u64 = 72 // its address space
const T_PARENT: u64 = 80 // index of the creator
const T_EXIT: u64 = 88 // the code it left with
const T_RUNS: u64 = 96 // how often it got the processor
const T_ENTRY: u64 = 104 // rip in ring 3
const T_USTACK: u64 = 112 // rsp in ring 3
const T_KIND: u64 = 120 // K_* below
const T_WAITPID: u64 = 128 // which child it is waiting for
const T_TICKS: u64 = 136 // timer ticks spent in this task
const T_PDPT: u64 = 144 // the four frames of its page tables
const T_PD: u64 = 152
const T_PT: u64 = 160
const T_DATA: u64 = 168 // its private data page (physical)
const T_CWD: u64 = 176 // inode of the working directory
const T_ARG: u64 = 184 // which program of uprog.fi (proc.fi)
const T_END: u64 = 192 // tick at which it ended
const T_FD: u64 = 200 // three open files: inode + 1, 0 = closed
const T_FDOFF: u64 = 224 // and the read/write position of each
const T_FAULTS: u64 = 248 // faults it caused

// ROUND K4. A record is 512 octets now (`kstate.TASK_BYTES`), and what the
// new half holds is what a POSIX process has besides its code: where its
// program break stands and how far its mmap area has grown down. The
// DESCRIPTORS moved out of the record altogether -- `kernel/file.fi`
// keeps them, because `dup2` and `fork` need two descriptors to be able to
// mean ONE open file, and an inode in the record cannot do that.
const T_BRK: u64 = 256 // `brk`, 0 = the process has never asked
const T_MMAP: u64 = 264 // the lower end of the mmap area, 0 = none yet

// ROUND K9. WAS EIN UNIX-PROZESS AUSSER SEINEM SPEICHER UND SEINEN
// DATEIEN NOCH IST. Der Satz passt in den zweiten Teil des Datensatzes,
// den Runde K4 aufgemacht und nicht ausgefuellt hat -- 272 bis 511 lagen
// leer. Nichts davon muss der Kern der Auswahl kennen; `sched.create`
// nullt den ganzen Datensatz, also faengt jede Aufgabe mit leerer
// Warteschlange, leerer Maske und ohne Prozessgruppe an.
const T_SIGPEND: u64 = 272 // wartende Signale, ein Bit je Nummer
const T_SIGMASK: u64 = 280 // blockierte Signale
const T_SIGLAST: u64 = 288 // das zuletzt zugestellte
const T_PGID: u64 = 296 // Prozessgruppe (0 = die eigene pid)
const T_SID: u64 = 304 // Sitzung
const T_TTY: u64 = 312 // beherrschendes Terminal + 1, 0 = keines
const T_SIGDEL: u64 = 320 // wie viele Signale zugestellt wurden
const T_STOPSIG: u64 = 328 // welches Signal es angehalten hat
const T_SIGRET: u64 = 336 // Adresse des Rahmens auf dem Nutzerstapel
const T_ALARM: u64 = 344 // Marke, zu der SIGALRM faellig ist, 0 = nie
const T_TGID: u64 = 352 // Fadengruppe (clone), 0 = die eigene pid
const T_SHARED: u64 = 360 // 1 = teilt den Adressraum, nicht freigeben
const T_FUTEX: u64 = 368 // Adresse, auf die dieser Faden wartet
const T_FUTEXVAL: u64 = 376 // und der Wert, auf den er sich berufen hat
// ROUND K9, UND ES IST EINE ZUSAGE AN DIE RUNDEN VORHER. Stirbt ein
// Prozess an einem Signal, ist sein Beendigungscode 128 + Signalnummer --
// so rechnet jede Shell. Stirbt er an einer AUSNAHME, war er in diesem
// Kernel seit Runde 62 128 + VEKTORNUMMER, und `tools/osum/run.sh` misst
// seit damals, dass ein Seitenfehler 142 ergibt (128 + 14). Beide Zahlen
// haben ihr Recht, und beide bleiben: `signal.fault` traegt hier die
// vektorbasierte ein, und wo sie steht, gilt sie. 0 = es gilt die
// Signalnummer.
const T_KILLCODE: u64 = 384

// ------------------------------------------------- RUNDE K13: WER ES IST
//
// Sieben Woerter, und sie liegen im AUFGABENSATZ und nicht in einem
// eigenen Bereich von `kdata`. Der Satz ist seit Runde K4 512 Oktette
// gross und war bis T_KILLCODE (384) belegt; 392 bis 511 lagen leer. Ein
// Attribut, das zu einem Prozess gehoert, gehoert in den Satz dieses
// Prozesses -- eine zweite Tabelle daneben waere eine zweite Stelle, an
// der man vergessen kann, sie mitzuloeschen (`sched.create` nullt den
// ganzen Satz, und damit ist ein frischer Prozess root, bis eine Zeile
// weiter unten die Kennungen des Elternteils darueberkommen).
//
// SECHS UND NICHT ZWEI, und der Grund ist `su`. POSIX kennt je Kennung
// drei Werte: die ECHTE (wer angemeldet ist), die WIRKSAME (nach der
// entschieden wird) und die GESICHERTE (wohin ein Programm mit setuid-Bit
// zurueckkann). Ein Programm mit nur zwei Werten kann seine Rechte
// ablegen und nicht wiederholen -- oder es kann sie nie ablegen. Beides
// ist falsch.
//
// T_UMASK ist die Maske, die `open` und `mkdir` von den Rechten einer
// NEUEN Datei abziehen. Sie wird ueber `fork` und `execve` vererbt wie
// die Kennungen; 0 heisst "nichts abziehen", und der Kernel setzt sie
// nirgends selbst -- das tut die Shell.
const T_UID: u64 = 392 // die echte Benutzerkennung
const T_GID: u64 = 400 // die echte Gruppenkennung
const T_EUID: u64 = 408 // die wirksame -- nach ihr wird entschieden
const T_EGID: u64 = 416
const T_SUID: u64 = 424 // die gesicherte (setuid-Bit, `su`)
const T_SGID: u64 = 432
const T_UMASK: u64 = 440 // was `open`/`mkdir` abziehen
// RUNDE K16: die untere Kante der GROSSEN Arena (`proc.BIG_TOP` abwaerts),
// 0 = dieser Prozess hat sie noch nie gebraucht. Sie ist das Gegenstueck
// zu T_MMAP, und sie ist getrennt davon, weil die alte Halde genau da
// bleiben soll, wo sie seit Runde K4 liegt: was `tools/posix/run.sh` an
// Adressen misst, misst es weiter.
//
// ============================================================
// 448 UND NICHT 392. EIN FEHLER, DER AELTER IST ALS DIE RUNDE,
// IN DER ER GEFUNDEN WURDE.
// ============================================================
//
// Hier stand 392, und 392 IST `T_UID` -- zwei Felder desselben
// Datensatzes auf demselben Versatz. Aufgefallen ist es nicht, weil
// beide fast immer null sind. Aufgefallen ist es an dem einen Ort, an
// dem sie es nicht sind: `do_exec` setzt `T_BIG` auf 0, wenn ein neues
// Abbild anfaengt -- und hat damit die ECHTE BENUTZERKENNUNG jedes
// Prozesses bei jedem `execve` auf 0 zurueckgesetzt.
//
// DAS IST KEINE SCHOENHEITSFRAGE. `su` fragt nur dann nach einem
// Passwort, wenn die echte Kennung nicht 0 ist (`kernel/user/su.fi`:
// "wer schon root ist, wird nicht gefragt"). Nach `su justin` stand
// dort wieder 0, also kam jedes weitere `su root` OHNE Passwort durch.
// Gemessen: `tools/k13/run.sh` sagt auf `main` (3389fbd) genau das --
// "justin: die eigene Kennung nach su: '0', erwartet '1000'" und "su
// lehnt ein falsches Passwort ab -- fehlt", zwoelf Zusagen insgesamt.
// Mit einem eigenen Arbeitsbaum an derselben Stelle nachgemessen, damit
// nicht diese Runde die Schuld bekommt.
//
// Ein Datensatz ist 512 Oktette gross (`kstate.TASK_BYTES`), das letzte
// belegte Feld ist `T_UMASK` bei 440. 448 ist frei, und es ist das
// naechste.
const T_BIG: u64 = 448

// ------------------------------------------- ROUND NETVIEW: THE NETWORK
//
// WHICH NETWORK THIS PROCESS SEES. 0 = the wire, and 0 is what
// `sched.create` leaves behind when it zeroes the record -- so every
// process that existed before this round, and every process started
// without anybody saying otherwise, goes on seeing exactly what it saw.
// The four values and what they mean are in `kernel/netview.fi`; the
// only thing the scheduler knows about them is that they are a number in
// a slot.
//
// AND THE LIST OF DESTINATIONS the `filtered` view lets through, six
// words, 0 = empty. They stand HERE and not in a table of their own for
// the reason round K13 gave for the six identity words twelve lines
// above: an attribute of a process belongs in the record of that
// process, and a second table beside the task table is a second place
// to forget to clear.
//
// The record has been 512 octets since round K4.
//
// ======================= RUNDE MERGE-2: 456 UND NICHT 448.
//
// Hier stand 448, und 448 IST `T_BIG` -- zwanzig Zeilen weiter oben,
// aus genau dem Grund dorthin gelegt, den der Kasten dort erklaert.
// Der Satz oben ("448 to 503 lay empty") war beim Schreiben schon
// falsch: T_BIG lag da bereits. Es ist derselbe Fehler wie T_BIG auf
// T_UID, eine Runde spaeter und in die andere Richtung.
//
// WAS ER ANRICHTET, und das ist keine Schoenheitsfrage:
//   * `do_exec` setzt `T_BIG` auf 0 (kernel/sys.fi) -- damit setzte
//     JEDES execve die Netzsicht des Prozesses auf 0 zurueck, und 0
//     ist `real`, also "sieht den Draht". Eine eingeschraenkte Sicht
//     ueberlebte kein einziges Programmstart.
//   * umgekehrt schreibt der erste Griff in die grosse Arena die
//     Basisadresse nach T_BIG -- und damit eine sechsstellige Zahl in
//     die Netzsicht.
//
// Belegt ist der Satz bis T_BIG (448..455). Frei ist ab 456; die
// sechs Worte von T_NETOK reichen dann von 464 bis 511 und fuellen
// den Satz genau aus.
const T_NETV: u64 = 456
const T_NETOK: u64 = 464
const NETOK_MAX: u64 = 6

// ------------------------------------------- RUNDE POLL: DAS WARTEN
//
// Der Stand der Weckfolge (`kstate.POLLSEQ`), den dieser Prozess
// gesehen hat, BEVOR er seine Deskriptoren durchgesehen hat. Er steht
// im Datensatz und nicht auf dem Stapel, weil `poll_sleep` ihn unter
// der Sperre noch einmal vergleichen muss und der Stapel dieser
// Aufgabe dabei bereits verlassen sein kann.
//
// 504 war das letzte freie Wort des 512 Oktette grossen Datensatzes;
// die Zeile darueber sagte seit Runde NETVIEW, dass es frei ist.
const T_POLLSEQ: u64 = 504

// ------------------------------------- RUNDE MULTIUSER: DIE ZUSATZGRUPPEN
//
// DAS LETZTE FREIE WORT DES SATZES, und das ist keine Redensart: der
// Satz ist 512 Oktette gross, K13 hat bis 440 belegt, K16 nahm 448,
// NETVIEW 448..503. 504 ist das einzige, was uebrig ist -- und
// sechzehn Zusatzgruppen brauchen sechzehn Woerter.
//
// Also steht hier die ANZAHL und in `kstate.MU_OFF + MU_GRP` die Liste.
// Die Anzahl ist null, wenn `create` den Satz nullt, und null heisst
// "keine Zusatzgruppen": jeder Prozess, den es vor dieser Runde gab,
// verhaelt sich genau wie vorher. Die Begruendung fuer die getrennte
// Tabelle und die zwei Stellen, die sie anfassen, stehen bei `MU_OFF`
// in `kstate.fi`.
// RUNDE MERGE-2: HIER STAND 504, UND 504 IST T_POLLSEQ.
// Die Runden POLL und MULTIUSER haben sich BEIDE das letzte
// freie Wort des Satzes genommen, und beide haben es
// ordentlich begruendet -- der Satz war 512 Oktette gross und
// bis 503 belegt, also gab es genau EINEN Platz fuer ZWEI
// Runden. Das ist kein Streit, den man entscheiden kann; das
// ist ein Satz, der voll ist.
//
// Also waechst er: TASK_BYTES 512 -> 576 (`kstate.fi`). Das
// kostet 32 * 64 = 2 KiB in kdata und schafft acht neue
// Woerter, 512 bis 568. POLL behaelt 504, MULTIUSER bekommt
// 512, und die naechsten sechs Runden muessen diese Zeile
// nicht noch einmal schreiben.
const T_NGROUPS: u64 = 512

// RUNDE AVX: der Vektorzustand dieser Aufgabe -- die Adresse EINES
// Rahmens aus `mem.frame_alloc`, in den `FXSAVE`/`XSAVE` schreibt. 0
// heisst "hat keinen"; das ist der Zustand vor `fpu.apply` und auf einer
// Maschine ohne SSE. Der Platz liegt hinter den Zusatzgruppen
// (512 + GROUPS_MAX * 8 = 640) und damit noch weit unter TASK_BYTES.
const T_FPU: u64 = 640

// RUNDE LAUFZEIT: DIE FS-BASIS DIESER AUFGABE.
//
// Jedes gegen musl (oder glibc) gelinkte Programm liest seinen
// Fadenzeiger als `%fs:0x0` und den Stapelwaechter als `%fs:0x28`. Ohne
// eine FS-Basis ist beides ein Zugriff auf die Adresse 0x0 bzw. 0x28 --
// gemessen in dieser Runde als `user fault: err=0x5 cr2=0x28` mitten in
// musls `__malloc_alloc_meta`. Das ist der EINE Grund, aus dem ein
// fremdes Programm hier nicht laeuft; die Systemaufrufnummern stimmen
// laengst.
//
// Das Programm setzt die Basis selbst, mit `arch_prctl(ARCH_SET_FS)`
// (Nummer 158). Sie gehoert der AUFGABE und nicht dem Prozessor: bei
// jedem Wechsel schreibt `switch_to` sie wieder in IA32_FS_BASE, sonst
// liest der naechste Faden den Fadenzeiger des vorigen. 0 heisst "hat
// keine gesetzt" -- der Zustand jedes Osum-eigenen Programms, das ohne
// TLS gebaut ist.
const T_FSBASE: u64 = 648
const GROUPS_MAX: u64 = 16

// The three descriptor slots of round 62. Nothing writes them any more;
// they stay named so that a reader of a task dump knows what the hole in
// the middle of the record was.
const FD_SLOTS: u64 = 3

const S_FREE: u64 = 0
const S_READY: u64 = 1
const S_RUN: u64 = 2
const S_SLEEP: u64 = 3
const S_WAIT: u64 = 4
const S_ZOMBIE: u64 = 5
// Under construction: the record exists, the stack exists, and the
// scheduler must NOT take it yet. Round 62 learned this the hard way --
// `proc.create` fills in the address space and the entry point AFTER the
// task record, and a timer interrupt in between started a process whose
// rip was still zero. A task becomes runnable when its creator says so,
// and not a moment earlier.
const S_NEW: u64 = 6
// ROUND K9. ANGEHALTEN -- was `SIGSTOP` aus einem Prozess macht und was
// `SIGCONT` rueckgaengig macht. Es ist ein eigener Zustand und nicht
// S_SLEEP: ein Schlaefer wird vom Zeitgeber geweckt, ein Angehaltener
// nicht, und ohne den Unterschied waere STRG-Z ein Schlaf von zehn
// Millisekunden. `pick` waehlt nur S_READY -- eine angehaltene Aufgabe
// faellt damit von selbst aus der Laufliste, ohne dass der Kern der
// Auswahl eine Zeile mehr braucht.
const S_STOP: u64 = 7
// RUNDE POLL. WARTET AUF EINEN DESKRIPTOR. Kein S_SLEEP, weil ein
// Schlaefer NUR von der Zeit geweckt wird -- diese Aufgabe soll von
// einem EREIGNIS geweckt werden (`poll_kick`) und von der Zeit nur
// dann, wenn der Zeitablauf des Aufrufs erreicht ist. Und kein S_WAIT,
// weil `wake_pid` mit einer 0 als Kennung alles weckt, was auf
// irgendein Kind wartet -- ein `poll` waere darunter gewesen.
const S_POLL: u64 = 8
// Ein Zeitpunkt, den der Zeitgeber nie erreicht: das ist `timeout < 0`,
// also "warte, bis wirklich etwas geschieht".
const POLL_FOREVER: u64 = 0xFFFFFFFFFFFFFFFF

const K_BOOT: u64 = 0
const K_IDLE: u64 = 1
const K_WORKER: u64 = 2
const K_USER: u64 = 3
// ROUND K5. A kernel task that does ARITHMETIC and nothing else. The
// worker of round 62 spins on `pause`, which is the right instruction for
// showing that a task is interruptible and the wrong one for measuring
// how fast four cores are: QEMU's translator leaves the emulation loop at
// every `pause`, so eight such tasks on four cores are eight tasks
// waiting on the emulator, not on the processor.
const K_GRIND: u64 = 4
// ROUND K8: the task that moves frames between the card and the TCP/IP
// stack. It is a task and not a loop inside a system call because a
// `ping` from the other side has to be answered while every process in
// this system is waiting for something else. Its body is
// `inet.netd_body`, reached through `tasks.main` like every other kernel
// task -- stage 0 of Firn has no function pointers in the kernel
// profile.
const K_NETD: u64 = 5
// RUNDE ASYNC: DER ARBEITSFADEN DER AUFTRAGSSCHICHT. Eine eigene Art und
// nicht K_WORKER, weil K_WORKER der Messfaden aus Runde 62 ist und in
// `tools/kernel/run.sh` gezaehlt wird -- vier zusaetzliche Faeden dieser
// Art haetten dort drei Zusagen umgeworfen, die mit dieser Runde nichts
// zu tun haben. Der Rumpf steht in `sys.aio_worker`, verteilt wird er
// wie jeder andere in `tasks.main`.
const K_AIO: u64 = 6
// RUNDE AVX: die Vektorprobe als KERNaufgabe. Sie wandert zwischen den
// Kernen (ANY_CPU) und geht durch denselben Kontextwechsel wie alles
// andere -- damit ist sie der Nachweis auf mehreren Prozessoren.
const K_VEC: u64 = 7
// RUNDE AVX: eine Aufgabe, die NICHTS tut als den Prozessor abgeben.
// Sie ist das Messgeraet fuer den Preis des Kontextwechsels: was zwei
// von ihnen an Zyklen verbrauchen, ist der Wechsel und sonst nichts.
const K_YIELD: u64 = 8

// ACHT frames = 32 KiB of kernel stack per task (Runde K17; davor vier).
//
// ROUND 62 had two, and two were enough for what a system call did then:
// write an octet, look up an inode, hand a page back. ROUND K1 made the
// deepest system call much deeper --
//
//   syscall_entry -> sys.entry -> do_exec -> elf.spawn -> elf.load
//                 -> elf.segment -> fs.read_at -> blk.read -> ata_read
//
// -- and it overflowed, in a way worth writing down because it is the
// kind of bug that looks like something else: the stack ran off its lower
// end into the frame below, a `ret` picked up an octet of a neighbouring
// page as a return address, and the machine died at a #GP or a #UD whose
// rip was an address in its own stack, with a register dump that pointed
// at the ATA driver. The driver was innocent. It was simply the deepest
// thing on the stack when it broke.
//
// So the number is not a guess any more. `stack_high` below paints every
// kernel stack and reads the high-water mark back off it, `kmain.osum`
// reports it, and `tools/osum/run.sh` checks BOTH bounds: the deepest
// call has to stay under 16 KiB, and it has to be OVER 8 KiB -- which is
// the counter-check, because that is exactly the number that says the two
// frames of round 62 were not enough and this line had to change.
// RUNDE K18 HAT DARAUS EINE ACHT GEMACHT, aus demselben Grund, aus dem
// Runde K1 aus der Zwei eine Vier gemacht hat: gemessen, dass es nicht
// reicht.
//
// `kmain.osum` meldet den Hoechststand, und im Lauf mit der Shell auf
// dem Rahmenpuffer (`osum gfx`) steht dort:
//
//     osum: kstack deepest=16384 of 16384
//
// Das ist nicht "knapp", das ist VOLL. `stack_high` faerbt den Stapel
// und liest den Hoechststand zurueck; meldet er die ganze Groesse, ist
// keine gefaerbte Stelle mehr uebrig -- der Stapel ist mindestens einmal
// bis zum letzten Oktett benutzt worden. Genau diesen Fall verbietet
// `tools/osum/run.sh` mit der Zusage "der tiefste Kernstapel des Laufs
// muss UNTER der Groesse bleiben".
//
// DAS STAND SCHON VOR DIESER RUNDE SO: derselbe Lauf auf `main` meldet
// dieselben 16384 von 16384. Er ueberlebt es dort, aber nur, weil hinter
// dem letzten Oktett zufaellig nichts liegt, was gebraucht wird. Ein
// Kernel mit anderer Codeanordnung faellt hinein -- mit Runde K18 endete
// derselbe Lauf in drei von acht Faellen mit
//
//     *** EXCEPTION 6 #UD  rip=0x9fc42  rsp=0x506ff8
//
// also mit einem Sprung an eine Adresse unterhalb des Kernels: eine
// Ruecksprungadresse, die nicht mehr da war, wo sie hingehoerte.
//
// Acht Rahmen statt vier sind 32 KiB je Aufgabe, bei 32 Aufgaben
// hoechstens ein Megabyte; die Messmaschine hat 128. Der Preis ist
// Speicher, den es gibt. Der Preis der Vier war ein Kernel, der je nach
// Codeanordnung faellt.
//
// RUNDE K17 HAT DIESELBE STELLE UNABHAENGIG DAVON EIN ZWEITES MAL
// GERISSEN, mit einem anderen Aufruf. Sie haengt an den tiefsten
// Aufruf, den es gibt (`read` auf eine Datei), vier weitere Schichten:
//
//   sys.dispatch -> do_read -> vfs_read -> vfs.v_read -> fat.read
//                -> blk.read_on -> usb.msc_read -> usb.bot
//                -> xhci.bulk -> xhci.wait_ep -> xhci.drain
//
// Gemessen wie in Runde K1 beschrieben: `wc` auf eine Datei eines
// USB-Sticks, und danach starb nicht der Treiber, sondern die SHELL --
// an einem Zeiger in ihrem eigenen Stapelrahmen, der einmal 0 und
// einmal eine Adresse aus der Kernhalde war. Der Kernstapel war unten
// herausgelaufen und hatte in den Rahmen darunter geschrieben. Mit acht
// Rahmen lief derselbe Lauf durch; die Hochwassermarke stand bei 16064
// von 32768.
//
// ACHT UND NICHT SECHS. Der erste Anlauf von K17 schlug sechs Rahmen
// vor (24576 Oktette). Diese Schranke war zu diesem Zeitpunkt ZWEIMAL
// zu knapp gewesen -- K18 hat 16384 von 16384 gesehen, K17 unabhaengig
// davon 16064 gemessen. Bei einer Zahl, die zweimal nicht gereicht hat,
// nimmt man nicht die knappere. Die beiden Schranken in
// `tools/osum/run.sh` bleiben unveraendert gueltig: der tiefste Aufruf
// ist weiter groesser als die 8192 von Runde 62 und kleiner als der
// Stapel.
// ================================================== RUNDE LEISTE
// SECHZEHN STATT ACHT -- UND EINE WAECHTERSEITE DARUNTER.
//
// Der Kommentar oben endet mit "acht und nicht sechs, weil eine Zahl,
// die zweimal nicht gereicht hat, nicht knapper wird". Sie hat ein
// drittes Mal nicht gereicht, und diesmal ist es GEMESSEN und nicht
// erschlossen:
//
//   user fault: pid=4  vector=14  err=0x15  cr2=0xd70  rip=0xd70
//     spur rsp=0x40079dd0  phys=0x3169dd0  kstack=0x2eca000
//         0x573068 0x573068 0x505fd0 0x505fd0 0x527000 0x3169f00 ...
//
// Der BENUTZERSTAPEL des Starters liegt physisch auf 0x3169dd0. Der
// Kernstapel der Aufgabe daneben faengt bei 0x316A000 an -- also 0x230
// Oktette darueber. Und in dem Benutzerstapel stehen KERNADRESSEN:
// 0x527000 ist `kdata`, 0x573068 liegt in der MODUSSEITE
// (kdata + MODE_OFF), 0x3169f00 zeigt auf sich selbst. Kein Programm in
// Ring 3 kann diese Zahlen kennen. Der Kernstapel ist unten
// herausgelaufen und hat in den Rahmen darunter geschrieben -- genau
// der Fall, den der Absatz oben fuer Runde K17 beschreibt, nur mit
// einem anderen Opfer.
//
// DAS IST AUCH DER "UNSICHTBARE UEBERSCHREIBER" DER RUNDE STARTKNOPF.
// Dort hatte ein zusaetzlicher `import cpu` in `kgui.fi` den ganzen
// Modusvektor auf null gelegt; der Import aendert die Bindereihenfolge
// und damit die Rahmengroessen des tiefsten Aufrufs. Es war nie ein
// Feld, das ueberlief -- es war IMMER der Kernstapel, und der Import
// hat nur entschieden, wer darunter liegt.
//
// ZWEI MASSNAHMEN, und die zweite ist die wichtigere:
//
//   1. SECHZEHN RAHMEN, also 64 KiB. Bei 32 Aufgaben sind das 2 MiB.
//   2. EINE WAECHTERSEITE UNTER JEDEM STAPEL. `frame_run` holt
//      KSTACK_FRAMES + 1 Rahmen; der UNTERSTE gehoert nicht zum
//      Stapel, wird mit einem eigenen Muster gefuellt und bei jedem
//      Zeitgeberschlag geprueft. Ein Ueberlauf ist damit kein stiller
//      Datenverlust irgendwo im Rechner mehr, sondern eine Meldung
//      mit Aufgabennummer -- und das ist der Unterschied zwischen
//      "es stuerzt manchmal ab" und "Aufgabe 5 braucht mehr Stapel".
//
// Eine echte, im Seitenverzeichnis UNGEMAPPTE Wache waere schoener.
// Sie geht hier nicht: der Kern bildet den unteren Speicher mit
// 2-MiB-Seiten ab, und eine einzelne 4-KiB-Seite daraus zu entfernen
// hiesse, die Kachel in eine Seitentabelle aufzuloesen -- fuer jeden
// Stapel, im Pfad, der die Aufgaben anlegt. Ein gepruefter Wachwert
// findet denselben Fehler und kostet zwei Lesezugriffe je Schlag.
const KSTACK_FRAMES: u64 = 16

// What an untouched octet of kernel stack looks like.
const STACK_PAINT: u64 = 0x5A5A5A5A5A5A5A5A

// Und das Muster der Waechterseite -- absichtlich ein anderes als die
// Stapelfarbe, damit ein Blick sagt, WELCHE der beiden Fragen gerade
// beantwortet wird.
const GUARD_PAINT: u64 = 0xC0DEFACEC0DEFACE

// Indices in the table out of isr.s.
const V_SWITCH: u64 = 55
const V_GUARD: u64 = 57
const V_TASK_MAIN: u64 = 62

fn vector(state: u64, i: u64) -> u64 {
    return __mmio_read64((kstate.get(state, kstate.VECTORS) + i * 8) as *mut u64)
}

// ------------------------------------------------------- the accesses

fn task_at(state: u64, i: u64) -> u64 {
    return state + kstate.TASK_OFF + i * kstate.TASK_BYTES
}

fn tget(state: u64, i: u64, field: u64) -> u64 {
    return __mmio_read64((task_at(state, i) + field) as *mut u64)
}

fn tset(state: u64, i: u64, field: u64, v: u64) {
    __mmio_write64((task_at(state, i) + field) as *mut u64, v)
}

// ----------------------------- RUNDE MULTIUSER: die Zusatzgruppen
//
// Vier Zeilen Adressrechnung und drei Fragen darauf. Die Liste liegt
// nicht im Aufgabensatz (dort ist EIN Wort frei), sondern in einer
// eigenen Seite; `groups_at` ist der einzige Weg dorthin, und
// `groups_set`, `groups_clear` und `groups_inherit` sind die einzigen
// drei, die schreiben.
fn groups_slot(state: u64, i: u64, k: u64) -> u64 {
    return state + kstate.MU_OFF + kstate.MU_GRP
        + (i * kstate.MU_GRPMAX + k) * 8
}

fn groups_count(state: u64, i: u64) -> u64 {
    let n: u64 = tget(state, i, T_NGROUPS)
    if n > GROUPS_MAX {
        return GROUPS_MAX
    }
    return n
}

fn groups_at(state: u64, i: u64, k: u64) -> u64 {
    if k >= GROUPS_MAX {
        return 0
    }
    return __mmio_read64(groups_slot(state, i, k) as *mut u64)
}

// Ist `gid` eine der Zusatzgruppen dieses Prozesses? Die Frage, wegen
// der es die Liste gibt.
fn groups_has(state: u64, i: u64, gid: u64) -> bool {
    let n: u64 = groups_count(state, i)
    var k: u64 = 0
    while k < n {
        if groups_at(state, i, k) == gid {
            return true
        }
        k = k + 1
    }
    return false
}

fn groups_clear(state: u64, i: u64) {
    tset(state, i, T_NGROUPS, 0)
    var k: u64 = 0
    while k < GROUPS_MAX {
        __mmio_write64(groups_slot(state, i, k) as *mut u64, 0)
        k = k + 1
    }
}

// `src` zeigt auf `n` Woerter IM KERNEL. Wer aus Ring 3 kommt, hat sie
// vorher dorthin kopiert -- diese Funktion sieht keine Nutzeradresse an.
fn groups_set(state: u64, i: u64, src: u64, n: u64) -> bool {
    if n > GROUPS_MAX {
        return false
    }
    groups_clear(state, i)
    var k: u64 = 0
    while k < n {
        __mmio_write64(groups_slot(state, i, k) as *mut u64,
            __mmio_read64((src + k * 8) as *mut u64))
        k = k + 1
    }
    tset(state, i, T_NGROUPS, n)
    return true
}

// Vom Elternteil auf das Kind. Steht neben den sieben Zeilen, die K13
// fuer die Kennungen geschrieben hat, und wird an derselben Stelle
// gerufen -- sonst waere die Liste des Kindes das, was zufaellig im
// wiederverwendeten Platz stand.
fn groups_inherit(state: u64, kind: u64, eltern: u64) {
    let n: u64 = groups_count(state, eltern)
    var k: u64 = 0
    while k < GROUPS_MAX {
        var v: u64 = 0
        if k < n {
            v = groups_at(state, eltern, k)
        }
        __mmio_write64(groups_slot(state, kind, k) as *mut u64, v)
        k = k + 1
    }
    tset(state, kind, T_NGROUPS, n)
}

// ROUND K5. This used to be one word for the whole machine
// (`kstate.CURRENT`). With four cores it has to be one word PER CORE --
// a scheduler that reads a single global "the running task" hands the
// same task to two processors, and then two stacks are one stack.
fn current(state: u64) -> u64 {
    return cpu.get(state, cpu.here(state), cpu.C_CUR)
}

// The second table round K5 needs: which core last ran a task, and which
// cores have ever run it. It lies beside the task table rather than in it
// because the task record is exactly full (248 + 8 = 256 = TASK_BYTES).
const TC_CPU: u64 = 0
const TC_MASK: u64 = 8
const TC_AFF: u64 = 16 // the only core that may run this task
const ANY_CPU: u64 = 99 // ... or this, when any of them may

fn tc_set(state: u64, i: u64, field: u64, v: u64) {
    __mmio_write64((state + kstate.TCPU_OFF + i * kstate.TCPU_BYTES + field)
        as *mut u64, v)
}

fn tc_get(state: u64, i: u64, field: u64) -> u64 {
    return __mmio_read64((state + kstate.TCPU_OFF + i * kstate.TCPU_BYTES
            +field) as *mut u64)
}

fn cpu_of(state: u64, i: u64) -> u64 {
    return tc_get(state, i, TC_CPU)
}

fn cpu_mask(state: u64, i: u64) -> u64 {
    return tc_get(state, i, TC_MASK)
}

// AFFINITY, and round K5 needs exactly one of it. Task 0 is
// `kernel_main` itself, and three things it does afterwards belong to the
// BOOT processor and to no other: the excursion into ring 3 (whose MSRs
// `user.setup` wrote on the boot processor alone), the word `isr.s` reads
// the kernel stack out of, and the two static save slots of `enter_user`.
// Without this, `kernel_main` migrates to whichever core happens to be
// free -- which is what a scheduler is supposed to do, and which broke
// the run in one attempt out of six until the reason was found.
fn set_affinity(state: u64, i: u64, c: u64) {
    tc_set(state, i, TC_AFF, c)
}

fn affinity(state: u64, i: u64) -> u64 {
    return tc_get(state, i, TC_AFF)
}

fn may_run(state: u64, i: u64, me: u64) -> bool {
    let a: u64 = tc_get(state, i, TC_AFF)
    return a == ANY_CPU || a == me
}

// ====================================================== RUNDE BLECHKERN
// DER RIEGEL, DER NICHT VON EINER ZAHL IM SPEICHER ABHAENGT.
//
// Die Bindung eines Prozesses an Kern 0 steht in der Nebentabelle
// (`TC_AFF`), also in Speicher, den ein Ueberlauf umschreiben kann -- und
// genau davon handelt diese Runde. Deshalb steht dieselbe Bedingung hier
// noch einmal, aus der GATTUNG der Aufgabe hergeleitet: ein Kern ungleich
// null nimmt keinen Ring-3-Prozess, was auch immer in der Tabelle steht.
// RUNDE VIELKERN: DER RIEGEL BLEIBT -- ER FRAGT NUR ETWAS ANDERES.
//
// Bis hierher hiess er "nur Kern 0 darf Ring 3". Jetzt heisst er: ein
// Kern darf Ring 3 nur nehmen, wenn seine GS-Basis wirklich auf SEINEN
// `cpu`-Satz zeigt. Ist sie das nicht, faende der naechste `syscall`
// seinen Kernstapel nicht -- und das ist genau der Fehler, den diese
// beiden Runden ausgeraeumt haben. Lieber laeuft der Prozess dann auf
// Kern 0 weiter, als dass er die Maschine mitnimmt.
//
// Die Pruefung ist ein Vergleich zweier Zahlen im Speicher; das MSR
// wird NICHT bei jeder Auswahl gelesen (das waere ein `rdmsr` je
// Zeitgeberschlag je Kern). Gesetzt wird `C_GSOK` einmal, von dem Kern
// selbst, in `smp.ap_main` bzw. `kmain`.
fn darf_ring3(state: u64, i: u64, me: u64) -> bool {
    if tget(state, i, T_KIND) != K_USER {
        return true
    }
    // ================================================= RUNDE VIELKERN 3
    // DIE GEGENPROBE ZU DIESEM RIEGEL, UND SIE GEHOERT HIERHER.
    //
    // Runde BLECHKERN ist genau daran gestorben, dass diese Bedingung
    // im Kommentar stand und NICHT im Code: ein Anwendungskern durfte
    // Ring 3 nehmen, dessen Kernstapel er nicht finden konnte. Gemerkt
    // hat es niemand -- bis Justin auf echtem Blech ein #UD fotografiert
    // hat. Ein Riegel, dessen Bruch niemand herbeifuehren kann, ist
    // nicht geprueft, sondern geglaubt.
    //
    // `r3blind` schaltet ihn ab. Zusammen mit `gsluege` (smp.fi, gibt
    // den Anwendungskernen eine FALSCHE GS-Basis) ist das der Zustand
    // vom 05.09. nachgebaut, auf Bestellung, im Pruefstand --
    // `tools/vielkern/run.sh` misst beides: mit Riegel lebt die
    // Maschine, ohne ihn nicht.
    if r3blind != 0 {
        return true
    }
    if ring3_alle == 0 {
        return me == 0
    }
    return me == 0 || gs_ready(state, me)
}

// ==================================================== RUNDE VIELKERN 3
// SCHARF GESCHALTET. Die Vorgabe ist EINS.
//
// Die Vorrunde hat sie auf null gelassen und den Grund dazugeschrieben:
// "der Unterbau ist gebaut und belegt, und er wird erst scharf
// geschaltet, wenn der Schreibtisch darauf steht." Er steht darauf --
// die Ursache war `fs.inode_get`, ein Inodepuffer fuer die ganze
// Maschine, und sie ist behoben. Gemessen mit dem VOLLEN Schreibtisch
// (vier Ring-3-Programme) unter -smp 1, 4 und 8: alle vier bekommen
// eine pid, R3W 0, abw 0, keine Ausnahme.
//
// `r3eins` auf der Kernel-Befehlszeile holt den alten Zustand zurueck --
// Ring 3 nur auf Kern 0, Oktett fuer Oktett das Verhalten der Runde
// BLECHKERN. Das ist die Rueckfallebene fuer den Fall, dass es auf
// einem Brett anders aussieht als im Pruefstand, und sie kostet einen
// Eintrag im Bootmenue statt eines neuen Kerns. `r3alle` bleibt
// bestehen und sagt jetzt ausdruecklich, was ohnehin gilt -- alle
// Laeufer und Menueeintraege, die es nennen, aendern sich nicht.
static mut ring3_alle: u64 = 1
static mut gs_luege: u64 = 0
static mut r3blind: u64 = 0

fn gs_lie_set(v: u64) {
    gs_luege = v
}

fn gs_luege_an() -> u64 {
    return gs_luege
}

fn r3blind_set(v: u64) {
    r3blind = v
}

fn r3blind_an() -> u64 {
    return r3blind
}

fn ring3_all_set(v: u64) {
    ring3_alle = v
}

fn ring3_alle_an() -> u64 {
    return ring3_alle
}

// Hat dieser Kern eine GS-Basis, die auf seinen eigenen Satz zeigt?
// EINMAL gemessen und hingeschrieben, von dem Kern, um den es geht.
static mut gs_gut: [u64; 8] = [0 as u64; 8]

fn gs_melden(state: u64, me: u64, gut: bool) {
    if me >= 8 {
        return
    }
    if gut {
        gs_gut[me as usize] = 1
    } else {
        gs_gut[me as usize] = 2
    }
}

// Die Adresse, auf die die GS-Basis DIESES Kerns zeigen muss.
// Der Kernstapel, den DIESER Kern beim naechsten Systemaufruf nimmt --
// dieselbe Zahl, die `%gs:CPU_KSTACK` in isr.s liest.
// Den Kernstapel dieses Kerns NEU eintragen -- aus der Aufgabe, die
// gerade laeuft. Gebraucht nach `smp.stage`: dort bekommt der Startkern
// unter Umstaenden eine andere Satznummer als 0, und dann steht sein
// Stapel im falschen Satz.
fn kstack_again(state: u64) {
    set_kernel_stack(state, tget(state, current(state), T_KTOP))
}

fn kstack_hier(state: u64) -> u64 {
    return cpu.get(state, cpu.here(state), cpu.C_KSTACK)
}

// Auf welchem Kern laeuft das hier gerade. Nur durchgereicht, damit
// Module, die `sched` ohnehin einbinden, nicht zusaetzlich `cpu`
// einbinden muessen -- ein Import mehr ordnet die Bindereihenfolge um,
// und was das anrichtet, steht in docs/RUNDE-STARTKNOPF.md.
fn hier(state: u64) -> u64 {
    return cpu.here(state)
}

fn gs_soll(state: u64) -> u64 {
    return cpu.record(state, cpu.here(state))
}

// Gegenprobe fuer den Startkern: er kennt seine eigene Nummer erst,
// wenn der APIC oben ist, und die MADT muss ihn nicht als ersten
// auffuehren. Also wird nach dem Hochlauf noch einmal nachgesehen.
fn gs_check(state: u64, basis: u64) -> bool {
    let me: u64 = cpu.here(state)
    let gut: bool = basis == cpu.record(state, me)
    gs_melden(state, me, gut)
    return gut
}

fn gs_ready(state: u64, me: u64) -> bool {
    if me >= 8 {
        return false
    }
    return gs_gut[me as usize] == 1
}

// Wie viele Kerne eine FALSCHE oder gar keine GS-Basis gemeldet haben.
// Muss null bleiben; die Tafel zeigt es als `R3W`.
fn gs_error(state: u64) -> u64 {
    var i: u64 = 0
    var c: u64 = 0
    while i < 8 {
        if gs_gut[i as usize] == 2 {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// Auf wie vielen Kernen Ring 3 wirklich gelaufen ist -- die Zahl, die
// diese Runde beweist. `TC_MASK` traegt je Aufgabe ein Bit je Kern.
fn ring3_kerne(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var maske: u64 = 0
    while i < n {
        if tget(state, i, T_KIND) == K_USER {
            maske = maske | tc_get(state, i, TC_MASK)
        }
        i = i + 1
    }
    var c: u64 = 0
    var b: u64 = 0
    while b < 8 {
        if ((maske >> b) & 1) != 0 {
            c = c + 1
        }
        b = b + 1
    }
    return c
}

// Wie viele Kerne die Maschine wirklich hat.
fn kerne(state: u64) -> u64 {
    return cpu.count(state)
}

// Systemaufrufe, die auf DIESEM Kern hereingekommen sind. Gezaehlt wird
// in `syscall_entry` mit einem einzigen `incq %gs:CPU_SYSCALLS` -- siehe
// den Kopf von `kernel/cpu.fi`.
fn syscalls_of(state: u64, k: u64) -> u64 {
    if k >= kstate.MAX_CPUS {
        return 0
    }
    return cpu.get(state, k, cpu.C_SYSCALLS)
}

fn syscalls_sum(state: u64) -> u64 {
    var k: u64 = 0
    var n: u64 = 0
    while k < cpu.count(state) {
        n = n + cpu.get(state, k, cpu.C_SYSCALLS)
        k = k + 1
    }
    return n
}

fn ring3_prozesse(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var c: u64 = 0
    while i < n {
        if tget(state, i, T_KIND) == K_USER
        && tget(state, i, T_STATE) != S_FREE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// ==================================================== RUNDE VIELKERN 3
// DIE MESSUNG, UM DIE ES IN DIESER RUNDE GEHT.
//
// "Ring 3 laeuft auf allen Kernen" ist eine Behauptung, solange nicht
// dasteht, WELCHER Prozess auf WELCHEM Kern war. Drei Zahlen je Prozess
// und zwei Summen, und alle fuenf kommen aus Stellen, die der
// Ablaufplaner ohnehin fuehrt:
//
//   kern    `TC_CPU`  -- der Kern, auf dem er ZULETZT lief
//   maske   `TC_MASK` -- ein Bit je Kern, auf dem er JE lief
//   n       wie viele Bits das sind
//   runs    wie oft er ueberhaupt an die Reihe kam
//
// und darunter die Systemaufrufe JE KERN. Die letzte Zahl ist die
// eigentliche: sie wird in `syscall_entry` ueber DIESELBE GS-Basis
// hochgezaehlt, aus der der Kernstapel kommt. Ein Kern mit falscher
// Basis zaehlt in einen fremden Satz -- die Summe der Zaehler weicht
// dann von `kstate.SYSCALLS` ab, und genau das misst `abw`.
fn bits_in(v: u64) -> u64 {
    var b: u64 = 0
    var c: u64 = 0
    while b < 64 {
        if ((v >> b) & 1) != 0 {
            c = c + 1
        }
        b = b + 1
    }
    return c
}

fn ring3_bericht(state: u64) {
    var s_p: [u8; 9] = "r3: pid=\0"
    var s_k: [u8; 8] = "  kern=\0"
    var s_m: [u8; 9] = "  maske=\0"
    var s_n: [u8; 5] = "  n=\0"
    var s_r: [u8; 9] = "  runs=\0\0"
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var alle: u64 = 0
    var proz: u64 = 0
    while i < n {
        if tget(state, i, T_KIND) == K_USER
        && tget(state, i, T_STATE) != S_FREE {
            let m: u64 = tc_get(state, i, TC_MASK)
            alle = alle | m
            proz = proz + 1
            let z: u64 = serial.line_at(cpu.here(state))
            serial.puts((&s_p[0]) as u64)
            serial.dec(tget(state, i, T_PID))
            serial.puts((&s_k[0]) as u64)
            serial.dec(tc_get(state, i, TC_CPU))
            serial.puts((&s_m[0]) as u64)
            serial.hex(m)
            serial.puts((&s_n[0]) as u64)
            serial.dec(bits_in(m))
            serial.puts((&s_r[0]) as u64)
            serial.dec(tget(state, i, T_RUNS))
            serial.nl()
            serial.line_clear(z)
        }
        i = i + 1
    }
    let z2: u64 = serial.line_at(cpu.here(state))
    var s_g: [u8; 15] = "r3: prozesse=\0\0"
    var s_gk: [u8; 9] = "  kerne=\0"
    var s_gn: [u8; 5] = "  n=\0"
    var s_gf: [u8; 10] = "  fremd=\0\0"
    var s_ga: [u8; 8] = "  alle=\0"
    serial.puts((&s_g[0]) as u64)
    serial.dec(proz)
    serial.puts((&s_gk[0]) as u64)
    serial.hex(alle)
    serial.puts((&s_gn[0]) as u64)
    serial.dec(bits_in(alle))
    serial.puts((&s_gf[0]) as u64)
    serial.dec(ring3_foreign(state))
    serial.puts((&s_ga[0]) as u64)
    serial.dec(ring3_alle)
    serial.nl()
    serial.line_clear(z2)
    let z3: u64 = serial.line_at(cpu.here(state))
    var s_s: [u8; 14] = "r3: syscalls \0"
    var s_c: [u8; 3] = " c\0"
    var s_e: [u8; 2] = "=\0"
    var s_su: [u8; 10] = "  summe=\0\0"
    var s_ab: [u8; 8] = "  abw=\0\0"
    serial.puts((&s_s[0]) as u64)
    var k: u64 = 0
    var sum: u64 = 0
    while k < cpu.count(state) {
        let v: u64 = cpu.get(state, k, cpu.C_SYSCALLS)
        sum = sum + v
        serial.puts((&s_c[0]) as u64)
        serial.dec(k)
        serial.puts((&s_e[0]) as u64)
        serial.dec(v)
        k = k + 1
    }
    serial.puts((&s_su[0]) as u64)
    serial.dec(sum)
    serial.puts((&s_ab[0]) as u64)
    let ks: u64 = kstate.get(state, kstate.SYSCALLS)
    if ks > sum {
        serial.dec(ks - sum)
    } else {
        serial.dec(sum - ks)
    }
    serial.nl()
    serial.line_clear(z3)
}

// Wie viele Ring-3-Prozesse zuletzt auf einem Kern ungleich null gelaufen
// sind. Muss immer 0 sein; die Tafel zeigt die Zahl, damit "es ist
// behoben" nicht geglaubt, sondern gelesen wird.
fn ring3_foreign(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var c: u64 = 0
    while i < n {
        let wo: u64 = tc_get(state, i, TC_CPU)
        if tget(state, i, T_KIND) == K_USER && wo != 0
        && wo < kstate.MAX_CPUS {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// ------------------------------------------------- the interrupt flag

// A critical section in a kernel is not a lock -- on one processor it is
// the interrupt flag. `irq_save` turns interrupts off AND says whether
// they were on; `irq_restore` puts back exactly that state. Plain
// `cli`/`sti` would switch them on in places where they have to stay off
// (inside an interrupt handler, for instance).
// ROUND K5: still true, and no longer SUFFICIENT. Turning interrupts off
// keeps the OTHER cores out of nothing at all; what it protects is this
// core against its own interrupt handler. Every place that used to make
// do with it and touches shared state now takes a lock as well -- and
// takes it with interrupts already off, because a handler that waits for
// a lock its own core holds waits for ever.
fn irq_save() -> u64 {
    return asm("pushfq\npop rax\ncli", out("rax"))
}

fn irq_restore(flags: u64) {
    if (flags & 0x200) != 0 {
        asm("sti")
    }
}

// ------------------------------------------------------------ the trace

// One octet per turn: which pid got the processor. That is the evidence
// for interleaving -- not a claim of the kernel but the list of the
// switches it really made.
fn trace_push(state: u64, v: u64) {
    let n: u64 = kstate.get(state, kstate.TRACE_LEN)
    if n < kstate.TRACE_MAX {
        // RUNDE ALLTAG, NEBENBEFUND: `v as u8` ist bei Firn eine GEPRUEFTE
        // Umwandlung -- die erste Prozessnummer ueber 255 haelt den Kern
        // mit "integer overflow casting 'u64 as u8'" an. GEMESSEN in
        // tools/init/run.sh, Abschnitt 3 (neun Dienste, einer stuerzt
        // fuenfmal, einer endet immer sauber und wird immer wieder neu
        // gestartet): die Nummern laufen ueber 255, bevor die Spur ihre
        // 4096 Plaetze voll hat, und die Maschine stand -- rc 124 statt
        // ACPI 0, und alle 29 Zusagen danach rot, auf merge6 genauso.
        // Die Spur ist ein Beleg fuer die Verzahnung, kein Verzeichnis:
        // das untere Oktett der Nummer belegt sie genauso.
        kstate.set8(state + kstate.TRACE_OFF + n, (v & 0xFF) as u8)
        kstate.set(state, kstate.TRACE_LEN, n + 1)
    }
}

fn trace_dump(state: u64, label: u64, limit: u64) {
    var n: u64 = kstate.get(state, kstate.TRACE_LEN)
    if limit != 0 && n > limit {
        n = limit
    }
    serial.puts(label)
    var i: u64 = 0
    while i < n {
        serial.dec(kstate.get8(state + kstate.TRACE_OFF + i))
        serial.put(32 as u8)
        i = i + 1
    }
    serial.nl()
}

// ------------------------------------------------------------ creating

// Task 0 is the one that is already running: `kernel_main` itself. It
// gets a record so that the switch has somewhere to put its stack
// pointer -- its stack is the one out of boot.s.
fn init(state: u64) {
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        tset(state, i, T_STATE, S_FREE)
        i = i + 1
    }
    kstate.set(state, kstate.TASKS, 1)
    kstate.set(state, kstate.NEXT_PID, 2)
    var l: u64 = 0
    while l < kstate.LOCK_COUNT {
        atomic.lock_init(state, l)
        l = l + 1
    }
    var c: u64 = 0
    while c < kstate.MAX_CPUS {
        cpu.set(state, c, cpu.C_CUR, 0)
        c = c + 1
    }
    kstate.set(state, kstate.PREEMPT, 1)
    tset(state, 0, T_STATE, S_RUN)
    tset(state, 0, T_PID, 1)
    tset(state, 0, T_PRIO, 2)
    tset(state, 0, T_BUDGET, 2)
    tset(state, 0, T_KIND, K_BOOT)
    // ROUND K9. AUCH AUFGABE 0 HAT EINE PROZESSGRUPPE, und dass sie
    // nicht null ist, entscheidet mehr als es aussieht: jeder Prozess
    // dieses Systems erbt seine Gruppe von seinem Elternteil, und die
    // Kette endet hier. Blieb hier die Null stehen, hatte die ganze
    // Maschine die Gruppe null -- und `tty.push` haelt genau die Null
    // fuer "dieses Terminal hat keinen Vordergrund" und schickt kein
    // SIGINT. STRG-C tat dann nichts, und zwar still.
    tset(state, 0, T_PGID, 1)
    tset(state, 0, T_SID, 1)
    tset(state, 0, T_TGID, 1)
    tset(state, 0, T_KTOP, vector(state, 61))
    tset(state, 0, T_CR3, kstate.get(state, kstate.KPML4))
    var t: u64 = 0
    while t < kstate.MAX_TASKS {
        tc_set(state, t, TC_AFF, ANY_CPU)
        t = t + 1
    }
    // The one task in this kernel that is not allowed to move.
    tc_set(state, 0, TC_AFF, 0)
    // RUNDE AVX: auch Aufgabe 0 braucht einen Vektorbereich. Sie ist die
    // Aufgabe, VON der der allererste Wechsel weggeht -- ohne Bereich
    // haette dieser Wechsel nichts, wohin er die Register des Kerns
    // legen koennte, und der erste Prozess faende sie noch vor. Das
    // setzt voraus, dass `fpu.apply` schon gelaufen ist; in
    // `kernel_main` steht es unmittelbar vor dieser Zeile.
    tset(state, 0, T_FPU, fpu.area_new(state))
    set_kernel_stack(state, vector(state, 61))
    trace_push(state, 1)
}

// The idle task of the BOOT processor. Kept in `kstate.IDLE` as before
// (several counters read it) and in the per-core record, because from
// round K5 on every core has one of its own.
fn set_idle(state: u64, i: u64) {
    kstate.set(state, kstate.IDLE, i)
    cpu.set(state, cpu.here(state), cpu.C_IDLE, i)
}

// A record for a context that is ALREADY running -- the way `init` gives
// task 0 to `kernel_main`, only later and for a core that has just come
// up. Its stack is not one the frame allocator handed out for a task, so
// T_KSTACK stays zero and `reap` will not give it back.
fn adopt(state: u64, kind: u64, prio: u64, ktop: u64) -> u64 {
    // RUNDE AVX: auch ein uebernommener Zusammenhang braucht einen
    // Bereich -- sonst haette der erste Wechsel VON ihm nichts, wohin er
    // sichern koennte, und die Register des Vorgaengers blieben stehen.
    let vec_area: u64 = fpu.area_new(state)
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    var i: u64 = 1
    var slot: u64 = 0
    while i < kstate.MAX_TASKS {
        if tget(state, i, T_STATE) == S_FREE {
            slot = i
            i = kstate.MAX_TASKS
        } else {
            i = i + 1
        }
    }
    if slot == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        fpu.area_free(state, vec_area)
        return 0
    }
    var j: u64 = 0
    while j < kstate.TASK_BYTES / 8 {
        __mmio_write64((task_at(state, slot) + j * 8) as *mut u64, 0)
        j = j + 1
    }
    tset(state, slot, T_PID, kstate.add(state, kstate.NEXT_PID, 1) - 1)
    tset(state, slot, T_FPU, vec_area)
    tset(state, slot, T_KTOP, ktop)
    tset(state, slot, T_PRIO, prio)
    tset(state, slot, T_BUDGET, prio)
    tset(state, slot, T_KIND, kind)
    tset(state, slot, T_CR3, kstate.get(state, kstate.KPML4))
    tset(state, slot, T_STATE, S_RUN)
    tc_set(state, slot, TC_CPU, cpu.here(state))
    tc_set(state, slot, TC_MASK, 1 << cpu.here(state))
    tc_set(state, slot, TC_AFF, cpu.here(state))
    clear_signals(state, slot)
    if slot + 1 > kstate.get(state, kstate.TASKS) {
        kstate.set(state, kstate.TASKS, slot + 1)
    }
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return slot
}

// The initial stack of a task that has never run. It is built so that it
// looks EXACTLY like a task the switch stepped out of a moment ago -- see
// the layout in switch.s. That way `context_switch` needs no special case
// for a first start.
fn frame_build(state: u64, ktop: u64, entry: u64, a0: u64, a1: u64,
    a2: u64) -> u64 {
    let base: u64 = ktop - 144
    var i: u64 = 0
    while i < 18 {
        __mmio_write64((base + i * 8) as *mut u64, 0)
        i = i + 1
    }
    // ROUND K5: IF OFF, not on. A task that has never run starts with
    // the run queue lock held -- the core that switched to it took it and
    // could not give it back, because giving it back before the switch
    // would let a third core pick up a task whose registers are not saved
    // yet. `enter_task`, the first line of every task body, gives the
    // lock back and only THEN switches interrupts on. Starting with them
    // on would let this core's own timer interrupt run into a lock this
    // core holds.
    __mmio_write64(base as *mut u64, 0x002) // rflags: IF off until enter_task
    __mmio_write64((base + 72) as *mut u64, a0) // rdi
    __mmio_write64((base + 80) as *mut u64, a1) // rsi
    __mmio_write64((base + 104) as *mut u64, a2) // rdx
    __mmio_write64((base + 128) as *mut u64, entry) // where `ret` goes
    __mmio_write64((base + 136) as *mut u64, vector(state, V_GUARD))
    return base
}

// A new task. `entry` is the address of the Firn function it starts in
// (out of the table in isr.s, because Firn cannot name the address of a
// function of its own in the kernel profile); it gets `state`, its index
// and `kind` as arguments. Returns the index, or 0 when the table is
// full -- index 0 is `kernel_main` and can never be handed out.
// ROUND K5: the stack is fetched BEFORE the run queue lock is taken, and
// that order is not cosmetic. The frame allocator has a lock of its own
// now; a core that held the run queue and then asked for a frame would be
// holding two locks in an order that another core takes the other way
// round the moment it faults in an interrupt. The rule this kernel keeps
// is the simplest one that cannot deadlock: NO LOCK IS EVER HELD WHILE
// ANOTHER IS TAKEN.
fn create(state: u64, kind: u64, prio: u64, arg: u64, entry: u64) -> u64 {
    // RUNDE LEISTE: EIN RAHMEN MEHR ALS DER STAPEL BRAUCHT. Der
    // unterste ist die Wache und wird nie beschrieben; `T_KSTACK`
    // zeigt auf den ERSTEN Rahmen des Stapels, also einen darueber.
    // `free_stack` gibt beide zusammen zurueck.
    let roh: u64 = mem.frame_run(state, KSTACK_FRAMES + 1)
    if roh == 0 {
        return 0
    }
    let stack: u64 = roh + mem.FRAME_SIZE
    guard_paint(stack)
    // RUNDE AVX: der Vektorbereich kommt aus demselben Grund VOR die
    // Sperre wie der Stapel -- der Rahmenverwalter hat eine eigene, und
    // dieser Kern haelt nie zwei Sperren gleichzeitig. `area_new`
    // antwortet 0, solange `fpu.apply` nicht gelaufen ist; dann hat die
    // Aufgabe keinen Bereich und der Wechsel laesst sie in Ruhe.
    let vec_area: u64 = fpu.area_new(state)
    if vec_area == 0 && fpu.enabled(state) {
        free_stack(state, stack)
        return 0
    }
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    var i: u64 = 1
    var slot: u64 = 0
    while i < kstate.MAX_TASKS {
        if tget(state, i, T_STATE) == S_FREE {
            slot = i
            i = kstate.MAX_TASKS
        } else {
            i = i + 1
        }
    }
    if slot == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        free_stack(state, stack)
        fpu.area_free(state, vec_area)
        return 0
    }
    let ktop: u64 = stack + KSTACK_FRAMES * mem.FRAME_SIZE
    // ROUND K1: paint it, so that afterwards it can be said how much of
    // it was ever used. `frame_build` writes over the top 136 octets of
    // this in a moment; everything below is the measurement.
    var w: u64 = stack
    while w < ktop {
        __mmio_write64(w as *mut u64, STACK_PAINT)
        w = w + 8
    }
    var real_entry: u64 = entry
    if real_entry == 0 {
        real_entry = vector(state, V_TASK_MAIN)
    }
    var j: u64 = 0
    while j < kstate.TASK_BYTES / 8 {
        __mmio_write64((task_at(state, slot) + j * 8) as *mut u64, 0)
        j = j + 1
    }
    tset(state, slot, T_PID, kstate.add(state, kstate.NEXT_PID, 1) - 1)
    tset(state, slot, T_KSTACK, stack)
    tset(state, slot, T_FPU, vec_area)
    tset(state, slot, T_KTOP, ktop)
    tset(state, slot, T_PRIO, prio)
    tset(state, slot, T_BUDGET, prio)
    tset(state, slot, T_KIND, kind)
    tset(state, slot, T_ARG, arg)
    tset(state, slot, T_PARENT, current(state))
    // RUNDE K13: DIE KENNUNGEN KOMMEN VOM ELTERNTEIL, und sie kommen
    // HIER und nicht in `proc.create_bare`, weil sonst nur PROZESSE sie
    // erben wuerden. Der Satz wurde eine Schleife weiter oben genullt --
    // ohne diese vier Zeilen waere jedes Kind root, und `fork` in einer
    // Shell, die als `justin` laeuft, gaebe einen Prozess mit allen
    // Rechten. Genau das ist die Zusage, die `tools/k13/run.sh` misst:
    // die Kennung ueberlebt fork UND exec.
    let par: u64 = current(state)
    tset(state, slot, T_UID, tget(state, par, T_UID))
    tset(state, slot, T_GID, tget(state, par, T_GID))
    tset(state, slot, T_EUID, tget(state, par, T_EUID))
    tset(state, slot, T_EGID, tget(state, par, T_EGID))
    tset(state, slot, T_SUID, tget(state, par, T_SUID))
    tset(state, slot, T_SGID, tget(state, par, T_SGID))
    tset(state, slot, T_UMASK, tget(state, par, T_UMASK))
    // RUNDE MULTIUSER: und die Zusatzgruppen dazu, aus demselben Grund.
    groups_inherit(state, slot, par)
    tset(state, slot, T_CR3, kstate.get(state, kstate.KPML4))
    tset(state, slot, T_CWD, kstate.get(state, kstate.FS_ROOT))
    tset(state, slot, T_RSP, frame_build(state, ktop, real_entry, state,
            slot, kind))
    tset(state, slot, T_STATE, S_NEW)
    if slot + 1 > kstate.get(state, kstate.TASKS) {
        kstate.set(state, kstate.TASKS, slot + 1)
    }
    tc_set(state, slot, TC_CPU, kstate.MAX_CPUS)
    tc_set(state, slot, TC_MASK, 0)
    // ================================================== RUNDE BLECHKERN
    // RING 3 BLEIBT AUF DEM STARTKERN -- UND JETZT STEHT ES AUCH IM CODE.
    //
    // `kernel/arch/x86_64/smp.fi` schreibt seit Runde K5 als ausdrueck-
    // liche Bedingung dieses Kerns hin: "Ring 3 stays on the boot
    // processor ... the application processors run kernel tasks". Der
    // Grund steht daneben: `syscall_entry` in isr.s holt den Kernstapel
    // aus EINEM festen Wort der Datenseite (`kdata + KSTACK_CUR`), und
    // `set_kernel_stack` schreibt dieses Wort nur, wenn Kern 0 es
    // schreibt.
    //
    // DIE BEDINGUNG WURDE NIE DURCHGESETZT. Diese Zeile stand auf
    // ANY_CPU -- fuer JEDE Gattung, also auch fuer K_USER. Ein
    // Anwendungskern durfte damit einen Ring-3-Prozess nehmen; dessen
    // naechster `syscall` landete auf dem Kernstapel der Aufgabe, die
    // gerade auf Kern 0 lief. Zwei Kerne auf einem Stapel, und der
    // naechste Ruecksprung geht irgendwohin.
    //
    // GEMESSEN, am ausgelieferten Abbild b2addaf7, Limine/UEFI, KVM,
    // `-cpu host`, sonst identisch, nur die Kernzahl verschieden:
    //
    //     -smp 1   791 Zeilen Protokoll, NULL Ausnahmen, Leiste laeuft
    //     -smp 4   Absturz: #DB rip=0x100453, danach #GP und #UD
    //     -smp 8   Absturz: user fault err=0xf, #DB, #DF, lock stuck
    //
    // Justins Foto vom 05.09. zeigt denselben Abbruch an derselben
    // Stelle: die letzte Zeile ist `taskbar: shape file= ...`, dann
    // `VEK 6 #UD RIP 0x80` auf KERN 2 in einer Aufgabe der Gattung 1.
    // 0x80 ist keine Adresse, sondern der Rest einer ueberschriebenen
    // Ruecksprungkette.
    //
    // Die Kernaufgaben (K_WORKER, K_GRIND, K_NETD, K_AIO, ...) bleiben
    // auf ALLEN Kernen -- sie verlassen Ring 0 nie und haben mit
    // KSTACK_CUR nichts zu tun. Verloren geht also nichts ausser der
    // Wanderung von Benutzerprozessen, und die war nie zugesagt.
    //
    // Aufgehoben wird das erst von der Runde, die KSTACK_CUR je Kern
    // fuehrt (GS-Basis oder zweiter Tabellenzugriff im Einsprung, in
    // Assembler, vor dem ersten Stapel) -- genau wie es smp.fi sagt.
    // RUNDE VIELKERN: UND JETZT DARF RING 3 WIEDER AUF JEDEN KERN.
    //
    // Runde BLECHKERN hat hier `TC_AFF = 0` fuer K_USER eingetragen,
    // weil `syscall_entry` den Kernstapel aus EINEM Wort fuer die ganze
    // Maschine holte. Dieses Wort liegt jetzt im `cpu`-Satz je Kern
    // (`set_kernel_stack` weiter oben, `%gs:CPU_KSTACK` in isr.s), und
    // ebenso die RSP0 im Aufgabenzustandssegment jedes Kerns. Die
    // Bedingung, die die Bindung noetig machte, gibt es nicht mehr.
    //
    // `sched.ring3_fremd` (Tafelzeile 12, `R3F`) misst weiter, auf wie
    // vielen Kernen Ring 3 wirklich gelaufen ist -- die Zahl ist ab
    // dieser Runde ein ERWARTETER Wert groesser null und keine Alarm-
    // zahl mehr. Was NICHT null sein darf, misst `R3W`: Kerne, die
    // Ring 3 genommen haben, OHNE eine eigene GS-Basis zu haben.
    // DEFAULT: RING 3 BLEIBT AUF KERN 0. `r3alle` schaltet es frei.
    //
    // RUNDE GLYPHE, RICHTIGSTELLUNG: DIESER ABSATZ IST VON VIELKERN 2
    // UND STIMMT SEIT VIELKERN 3 NICHT MEHR. `static mut ring3_alle`
    // steht achthundert Zeilen weiter oben auf **1** -- Ring 3 laeuft
    // seither ohne jedes Wort auf ALLEN Kernen, und `r3eins` ist die
    // Rueckfallebene. Der Absatz bleibt stehen, weil er die
    // Begruendung von damals enthaelt; wer die geltende Vorgabe sucht,
    // liest die Zeile `static mut ring3_alle: u64 = 1` und den Absatz
    // darueber.
    //
    // Es hat eine halbe Stunde gekostet: der Pruefstand dieser Runde
    // setzte `r3alle` ausdruecklich, WEIL hier stand, dass es sonst
    // nicht gilt. Es gilt ohnehin.
    //
    // Der Unterbau steht und ist belegt (Kernstapel je Kern ueber die
    // GS-Basis, RSP0 je Kern, `R3K 4` und `R3K 7` mit null Ausnahmen).
    // Mit dem VOLLEN Schreibtisch ist er es NICHT: `/bin/taskbar`
    // bekommt beim Start `pid=0`, zweimal von zwei Laeufen -- der
    // Prozess wird gar nicht erst angelegt, und die Leiste fehlt.
    // Warum, ist nicht gefunden.
    //
    // Also faehrt das Abbild, das Justin brennt, wie das der Runde
    // BLECHKERN: Ring 3 auf Kern 0. `r3alle` auf der Kernel-Befehlszeile
    // gibt alle Kerne frei -- fuer den naechsten, der die Ursache
    // sucht, und ohne einen zweiten Kernel bauen zu muessen.
    if kind == K_USER && ring3_alle == 0 {
        tc_set(state, slot, TC_AFF, 0)
    } else {
        tc_set(state, slot, TC_AFF, ANY_CPU)
    }
    clear_signals(state, slot)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return slot
}

// ROUND K9. DIE SIGNALTABELLE EINER AUFGABE, GELOESCHT.
//
// Warum das hier steht und nicht in `signal.fi`, wo es hingehoerte: die
// Tabelle muss beim ANLEGEN einer Aufgabe geloescht werden, und das
// geschieht in diesem File. `signal.fi` braucht `proc.fi` (es schreibt
// auf den Nutzerstapel), `proc.fi` braucht dieses hier -- ein `import
// signal` in `sched.fi` oder `proc.fi` waere ein Ring im Modulgraphen,
// und der Uebersetzer nimmt ihn nicht. Was hier bleibt, ist reines
// Nullen von Speicher, das keine Bedeutung kennt; die Bedeutung steht
// vollstaendig in `signal.fi`.
//
// UND ES IST KEIN SCHOENHEITSFEHLER, SONDERN DER FEHLER, DEN RUNDE K6
// SCHON EINMAL HATTE: ein Platz, den eine tote Aufgabe hinterlaesst, darf
// seiner Nachfolgerin nichts vererben. Ohne diese Zeilen erbte ein neuer
// Prozess die Behandlungsroutinen seines Vorgaengers -- Adressen in einem
// Abbild, das es nicht mehr gibt.
const SIG_SLOTS: u64 = 32
const SIG_ENTRY: u64 = 24

fn clear_signals(state: u64, i: u64) {
    if i >= kstate.MAX_TASKS {
        return
    }
    let base: u64 = state + kstate.SIG_OFF + i * (SIG_SLOTS * SIG_ENTRY)
    var k: u64 = 0
    while k < (SIG_SLOTS * SIG_ENTRY) / 8 {
        __mmio_write64((base + k * 8) as *mut u64, 0)
        k = k + 1
    }
    tset(state, i, T_SIGPEND, 0)
    tset(state, i, T_SIGMASK, 0)
    tset(state, i, T_SIGRET, 0)
    tset(state, i, T_ALARM, 0)
    tset(state, i, T_STOPSIG, 0)
    // Prozessgruppe und Sitzung sind die eigene pid, solange niemand
    // etwas anderes sagt.
    let pid: u64 = tget(state, i, T_PID)
    tset(state, i, T_PGID, pid)
    tset(state, i, T_SID, pid)
    tset(state, i, T_TGID, pid)
}

fn free_stack(state: u64, stack: u64) {
    if stack == 0 {
        return
    }
    // RUNDE LEISTE: die Wache liegt EINEN Rahmen unter `stack` und
    // wird mit zurueckgegeben. Wer sie vergaesse, verloere je
    // Aufgabenstart vier Kilobyte -- und `tools/wm/run.sh` zaehlt die
    // freien Rahmen vorher und nachher.
    var k: u64 = 0
    while k < KSTACK_FRAMES + 1 {
        mem.frame_free(state, stack - mem.FRAME_SIZE + k * mem.FRAME_SIZE)
        k = k + 1
    }
}

// ==================================================== RUNDE LEISTE
// DIE WACHE: FUELLEN, PRUEFEN, MELDEN.
//
// Gefuellt wird beim Anlegen der Aufgabe, geprueft bei jedem
// Zeitgeberschlag fuer die LAUFENDE Aufgabe. Zwei Lesezugriffe --
// das oberste und das unterste Wort der Seite. Das oberste ist das,
// was ein Ueberlauf zuerst trifft (der Stapel waechst nach unten);
// das unterste faengt einen Sprung ueber die Seite hinweg.
fn guard_paint(stack: u64) {
    let g: u64 = stack - mem.FRAME_SIZE
    var w: u64 = g
    while w < stack {
        __mmio_write64(w as *mut u64, GUARD_PAINT)
        w = w + 8
    }
}

// Wie oft eine Wache gebrochen wurde, und von wem zuletzt. Beides geht
// auf die Messtafel: Justins Brett hat keine serielle Leitung.
static mut wache_brueche: u64 = 0
static mut wache_pid: u64 = 0
static mut wache_tief: u64 = 0

fn guard_broken(state: u64, i: u64) -> bool {
    let stack: u64 = tget(state, i, T_KSTACK)
    if stack == 0 {
        return false
    }
    let g: u64 = stack - mem.FRAME_SIZE
    if __mmio_read64((stack - 8) as *mut u64) != GUARD_PAINT {
        return true
    }
    return __mmio_read64(g as *mut u64) != GUARD_PAINT
}

// Wie tief der Ueberlauf ging: das erste Wort der Wache VON OBEN, das
// nicht mehr das Muster traegt. 0 = die Wache ist unversehrt.
fn guard_depth(state: u64, i: u64) -> u64 {
    let stack: u64 = tget(state, i, T_KSTACK)
    if stack == 0 {
        return 0
    }
    let g: u64 = stack - mem.FRAME_SIZE
    var p: u64 = stack
    while p > g {
        p = p - 8
        if __mmio_read64(p as *mut u64) != GUARD_PAINT {
            return stack - p
        }
    }
    return 0
}

// Aus `on_tick` gerufen, fuer die laufende Aufgabe. Meldet EINMAL je
// Bruch auf die Leitung und faerbt die Wache danach neu -- sonst
// stuende dieselbe Zeile hundertmal je Sekunde da und der Rest der
// Ausgabe waere weg.
fn guard_check(state: u64, i: u64) {
    if !guard_broken(state, i) {
        return
    }
    var s_a: [u8; 35] = "KERNSTAPEL UEBERGELAUFEN: aufgabe \0"
    var s_p: [u8; 7] = "  pid=\0"
    var s_t: [u8; 8] = "  tief=\0"
    var s_k: [u8; 10] = "  kstack=\0"
    wache_brueche = wache_brueche + 1
    wache_pid = tget(state, i, T_PID)
    wache_tief = guard_depth(state, i)
    serial.puts((&s_a[0]) as u64)
    serial.dec(i)
    serial.puts((&s_p[0]) as u64)
    serial.dec(wache_pid)
    serial.puts((&s_t[0]) as u64)
    serial.dec(wache_tief)
    serial.puts((&s_k[0]) as u64)
    serial.hex(tget(state, i, T_KSTACK))
    serial.nl()
    guard_paint(tget(state, i, T_KSTACK))
}

fn guard_faults() -> u64 {
    return wache_brueche
}

fn guard_last_pid() -> u64 {
    return wache_pid
}

fn guard_last_depth() -> u64 {
    return wache_tief
}

// ROUND K1: the deepest this task's kernel stack has ever been, in
// octets. The paint of `create` is looked for from the LOWER end
// upwards; the first octet that is not paint any more is the deepest
// point anything ever wrote to. A task that overflowed its stack reports
// the full size -- and that is the number that has to stay below it.
fn stack_high(state: u64, i: u64) -> u64 {
    let base: u64 = tget(state, i, T_KSTACK)
    let ktop: u64 = tget(state, i, T_KTOP)
    if base == 0 || ktop <= base {
        return 0
    }
    var p: u64 = base
    while p < ktop {
        if __mmio_read64(p as *mut u64) != STACK_PAINT {
            return ktop - p
        }
        p = p + 8
    }
    return 0
}

// Now it may run. Whoever created the task decides when it is complete.
fn start(state: u64, i: u64) -> bool {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if tget(state, i, T_STATE) != S_NEW {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return false
    }
    tset(state, i, T_STATE, S_READY)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return true
}

// The kernel stack the next system call out of ring 3 has to land on.
// Two places need it: the TSS (for interrupts) and the data area (for
// `syscall`, which the processor does not switch stacks for).
// ROUND K5: only the BOOT processor writes these two. `KSTACK_CUR` is
// read by `syscall_entry` in isr.s out of ONE fixed offset in the data
// area, and the TSS the boot processor loaded is its own -- a started
// core has a TSS of its own and never leaves ring 0 in this round. A core
// that wrote its kernel task's stack into that word would send the next
// system call of a ring 3 process onto a stack somebody else is standing
// on.
// RUNDE VIELKERN: BEIDES JE KERN, UND DAMIT FAELLT DIE BINDUNG AN KERN 0.
//
// Der obige Absatz beschreibt den Zustand VOR dieser Runde und bleibt
// stehen, weil er die Begruendung enthaelt. Was sich geaendert hat:
//
//   * Der Kernstapel steht nicht mehr in EINEM Wort der Datenseite,
//     sondern im `cpu`-Satz DIESES Kerns (`C_KSTACK`). `syscall_entry`
//     erreicht ihn ueber die GS-Basis, die auf denselben Satz zeigt.
//   * Die RSP0 wird in das Aufgabenzustandssegment DIESES Kerns
//     geschrieben (`C_TSSADDR`, von `smp.tables` gesetzt). Bisher
//     bekam nur das des Startkerns eine -- eine Unterbrechung aus
//     Ring 3 auf einem Anwendungskern waere sonst auf dessen
//     Startstapel gelandet, also mitten in seine Leerlaufaufgabe.
//   * `kstate.KSTACK_CUR` wird noch mitgeschrieben, aber von niemandem
//     mehr gelesen. Es bleibt als Anzeige stehen, bis eine Runde die
//     Datenseite aufraeumt.
fn set_kernel_stack(state: u64, ktop: u64) {
    let me: u64 = cpu.here(state)
    cpu.set(state, me, cpu.C_KSTACK, ktop)
    // Ein gestarteter Kern traegt seins seit `smp.tables` ein; eine 0
    // heisst also "das ist der Startkern", und der hat das aus `idt`.
    var tss: u64 = cpu.get(state, me, cpu.C_TSSADDR)
    if tss == 0 {
        tss = kstate.get(state, kstate.TSS)
    }
    if tss != 0 {
        __mmio_write64((tss + 4) as *mut u64, ktop)
    }
    if me == 0 {
        kstate.set(state, kstate.KSTACK_CUR, ktop)
    }
}

// The first line of every task body (`tasks.main`, `proc.user_start`).
// See `frame_build`: the lock comes from the core that started this task.
fn enter_task(state: u64) {
    atomic.lock_give(state, atomic.L_SCHED)
    asm("sti")
}

// -------------------------------------------------------- the decision

fn ready_count(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if tget(state, i, T_KIND) != K_IDLE && tget(state, i, T_STATE) == S_READY {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// How many corpses of a kind are lying about. The boot processor waits on
// this while the other cores work the tasks off.
fn zombies(state: u64, kind: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if tget(state, i, T_KIND) == kind && tget(state, i, T_STATE) == S_ZOMBIE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn reap_all(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var c: u64 = 0
    while i < n {
        if reap(state, i) {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// Everything that is not free and not a corpse.
fn alive_count(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        let st: u64 = tget(state, i, T_STATE)
        if st != S_FREE && st != S_ZOMBIE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// Round robin: from the current task onwards, the first ready one. The
// idle task is skipped -- it only gets the processor when nobody else
// wants it.
// ROUND K5: two changes, both forced by the second core. EVERY idle task
// is skipped, not only the one whose index stood in `kstate.IDLE` -- each
// core has one now. And what is returned when nothing is ready is THIS
// core's idle task, not the boot processor's; two cores on one idle task
// would be two cores on one stack.
//
// Only the caller of this function under the run queue lock may act on
// the answer. A task that is S_READY here is claimed by the caller before
// the lock is given up, which is what keeps two cores from taking it.
fn pick(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    let cur: u64 = current(state)
    let me: u64 = cpu.here(state)
    let myidle: u64 = cpu.get(state, me, cpu.C_IDLE)
    var k: u64 = 1
    while k <= n {
        let i: u64 = (cur + k) % n
        if tget(state, i, T_KIND) != K_IDLE && tget(state, i, T_STATE) == S_READY
        && may_run(state, i, me) && darf_ring3(state, i, me) {
            return i
        }
        k = k + 1
    }
    if tget(state, cur, T_STATE) == S_RUN {
        return cur
    }
    return myidle
}

// The switch itself. Everything that is per task and lives outside the
// task record is put in place here: the address space, the kernel stack
// for the next entry out of ring 3 -- and only then the stack pointer.
fn switch_to(state: u64, from: u64, to: u64) {
    let me: u64 = cpu.here(state)
    cpu.set(state, me, cpu.C_CUR, to)
    cpu.add(state, me, cpu.C_SWITCHES, 1)
    if tget(state, to, T_KIND) != K_IDLE {
        cpu.add(state, me, cpu.C_PICKS, 1)
    }
    tc_set(state, to, TC_CPU, me)
    tc_set(state, to, TC_MASK, tc_get(state, to, TC_MASK) | (1 << me))
    kstate.add(state, kstate.SWITCHES, 1)
    tset(state, to, T_RUNS, tget(state, to, T_RUNS) + 1)
    trace_push(state, tget(state, to, T_PID))
    let cr3: u64 = tget(state, to, T_CR3)
    if cr3 != 0 {
        let now: u64 = asm("mov rax, cr3", out("rax"))
        if cr3 != now {
            asm("mov cr3, rax", in("rax") cr3, clobber("memory"))
        }
    }
    set_kernel_stack(state, tget(state, to, T_KTOP))
    // RUNDE AVX: DIE VEKTORREGISTER. Sie stehen ausserhalb des
    // Aufgabensatzes und ausserhalb dessen, was `context_switch`
    // anfasst -- der rettet die Allzweckregister und die Flaggen und
    // sonst nichts. Ohne diese eine Zeile faende ein Prozess nach dem
    // Wechsel die xmm/ymm/zmm eines anderen vor.
    //
    // HIER und nicht in `switch.s`: die Anweisung, die gebraucht wird
    // (FXSAVE, XSAVE oder XSAVEOPT), und die Maske dazu stehen erst zur
    // LAUFZEIT fest -- sie kommen aus `cpuid`. Eine Assemblerdatei
    // muesste sich darueber verzweigen; hier ist es eine Fallunterschei-
    // dung in derselben Sprache wie alles andere. Der Kern selbst
    // benutzt keine Vektorregister (nachgezaehlt: `objdump -d` auf dem
    // Abbild findet null xmm/ymm/zmm), also darf zwischen dem Laden und
    // dem Stapelwechsel noch Firn-Code stehen.
    fpu.switch(state, me, fpu_area(state, from), fpu_area(state, to))
    // RUNDE LAUFZEIT: DIE FS-BASIS, aus demselben Grund wie die
    // Vektorregister eine Zeile darueber -- sie steht in einem
    // Modellregister des PROZESSORS und nicht im Aufgabensatz, also
    // faende der naechste Faden sonst den Fadenzeiger des vorigen vor.
    // Kostet nur etwas, wenn eine Aufgabe wirklich eine gesetzt hat.
    fsbase_apply(state, to)
    asm("call rax", in("rax") vector(state, V_SWITCH),
        in("rdi") task_at(state, from) + T_RSP,
        in("rsi") tget(state, to, T_RSP), clobber("memory"))
}

// RUNDE LAUFZEIT: die FS-Basis dieser Aufgabe in den Prozessor legen.
//
// IA32_FS_BASE ist 0xC0000100. Geschrieben wird ueber `msr.wr`, also
// ueber den Faengerpfad aus `msr.fi`: ein Prozessor, der das Register
// nicht annimmt, gibt `false` zurueck statt die Maschine mit einem #GP
// anzuhalten.
//
// EINE AUFGABE OHNE TLS KOSTET NICHTS. Jedes Osum-eigene Programm hat
// `T_FSBASE == 0`, und dann passiert hier gar nichts -- die Basis des
// vorigen Fadens bleibt stehen, und das ist richtig so: sie ist fuer
// ein Programm, das `%fs` nie anfasst, nicht zu unterscheiden.
fn fsbase_apply(state: u64, i: u64) {
    if i >= kstate.MAX_TASKS {
        return
    }
    let b: u64 = tget(state, i, T_FSBASE)
    // RUNDE FREMDLAND: AUCH DIE NULL WIRD GESCHRIEBEN, und das ist eine
    // Korrektur an LAUFZEIT.
    //
    // Der Satz von damals -- "eine Aufgabe ohne TLS kostet nichts, die
    // Basis des vorigen Fadens bleibt stehen, sie ist fuer ein Programm,
    // das %fs nie anfasst, nicht zu unterscheiden" -- ist genau einmal
    // falsch, und der Fall ist gemessen: laeuft nach einem
    // musl-Programm ein Osum-eigenes, steht in IA32_FS_BASE weiter ein
    // Zeiger in den Adressraum des musl-Programms. Solange niemand %fs
    // liest, faellt das nicht auf; ein Programm, das es doch tut (oder
    // ein spaeterer Kernel-Zweig, der es tut), laese dann fremde Seiten
    // -- und zwar STILL, weil die Seite ja da ist.
    //
    // Ein `wrmsr` je Aufgabenwechsel ist der Preis. Er ist klein und die
    // Alternative ist ein Register, dessen Inhalt davon abhaengt, wer
    // vorher lief. Sichtbar wird der Unterschied bei `fork` und
    // `execve`: beide setzen `T_FSBASE` jetzt ausdruecklich (das Kind
    // erbt, das neue Abbild faengt bei 0 an), und ohne diese Zeile
    // haette das Setzen auf 0 keine Wirkung.
    msr.wr(state, MSR_FS_BASE, b)
}

const MSR_FS_BASE: u64 = 0xC0000100

// RUNDE AVX: der Vektorbereich einer Aufgabe. Zwei Zeilen, damit
// `proc.fi` und `trap.fi` ihn erreichen, ohne T_FPU selbst zu kennen.
fn fpu_area(state: u64, i: u64) -> u64 {
    if i >= kstate.MAX_TASKS {
        return 0
    }
    return tget(state, i, T_FPU)
}

fn fpu_set_area(state: u64, i: u64, area: u64) {
    if i < kstate.MAX_TASKS {
        tset(state, i, T_FPU, area)
    }
}

// `fork`: das Kind erbt den Vektorzustand des Elternteils. MXCSR,
// Rundungsart und die Register selbst -- POSIX verlangt genau das, und
// ein Kind, das mit anderen Rundungsbits weiterrechnet als sein
// Elternteil, waere ein Fehler, den niemand suchen wuerde.
fn fpu_inherit(state: u64, parent: u64, child: u64) {
    // ZUERST den lebenden Zustand des Elternteils in seinen Bereich --
    // `fork` laeuft IM Elternteil, also stehen seine Register im
    // Prozessor und nicht im Bereich. Ohne diese Zeile erbt das Kind den
    // Stand vom letzten Kontextwechsel des Elternteils.
    fpu.sync_here(state, fpu_area(state, parent))
    fpu.area_copy(state, fpu_area(state, child), fpu_area(state, parent))
}

// `execve`: der Prozess wird ein anderes Programm. Sein Vektorzustand
// geht auf den Anfangswert zurueck -- und zwar SAMT den Registern, sonst
// sicherte der naechste Wechsel den alten Zustand in den frischen
// Bereich zurueck.
fn fpu_reset(state: u64, i: u64) {
    let a: u64 = fpu_area(state, i)
    if a == 0 {
        return
    }
    fpu.area_init(state, a)
    fpu.adopt_now(state, a)
}

// Give the processor away. Comes back when this task is scheduled again
// -- or never, if it is a corpse by then.
//
// ROUND K5, AND THIS IS THE HEART OF IT. The run queue lock is taken here
// and is NOT given back here: it is given back by whoever the processor
// switches TO, in that task's own `schedule_locked` right after its
// `switch_to` came back, or -- for a task that has never run -- in
// `enter_task`, its first line.
//
// The reason is one race and there is no cheaper cure. If the lock were
// given back before `switch_to`, another core could pick up the task this
// core has just marked S_READY -- while this core is still executing on
// that task's stack, inside `context_switch`, with its registers not yet
// written down. Two cores, one stack. Holding the lock across the switch
// means: while any core is between "I have chosen" and "the registers are
// saved", no other core is choosing anything.
fn schedule(state: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    schedule_locked(state)
    irq_restore(flags)
}

// The run queue lock must be held. On return it is held again -- by this
// task, on whichever core resumed it.
fn schedule_locked(state: u64) {
    let cur: u64 = current(state)
    let next: u64 = pick(state)
    if next == cur {
        tset(state, cur, T_BUDGET, tget(state, cur, T_PRIO))
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    if tget(state, cur, T_STATE) == S_RUN {
        tset(state, cur, T_STATE, S_READY)
    }
    tset(state, next, T_STATE, S_RUN)
    tset(state, next, T_BUDGET, tget(state, next, T_PRIO))
    switch_to(state, cur, next)
    atomic.lock_give(state, atomic.L_SCHED)
}

fn yield_now(state: u64) {
    schedule(state)
}

// --------------------------------------------------------- the timer

// Called out of the interrupt handler, after the end-of-interrupt. Two
// jobs: wake what is due, and take the processor away when the turn is
// over.
// Called out of the interrupt handler, on EVERY core, with interrupts
// already off -- which is why the lock may be taken here at all.
fn on_tick(state: u64) {
    let me: u64 = cpu.here(state)
    cpu.add(state, me, cpu.C_TICKS, 1)
    atomic.lock_take(state, atomic.L_SCHED, me)
    let now: u64 = kstate.get(state, kstate.TICKS)
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        // RUNDE POLL: S_POLL faellt hier mit hinein. Ein `poll` mit
        // Zeitablauf traegt seine Frist in dasselbe Feld ein wie ein
        // Schlaefer, und damit misst der Zeitgeber sie ohne eine Zeile
        // mehr. Ein `poll` OHNE Zeitablauf traegt POLL_FOREVER ein und
        // kommt hier nie vorbei.
        let ts: u64 = tget(state, i, T_STATE)
        if (ts == S_SLEEP || ts == S_POLL) && tget(state, i, T_WAKE) <= now {
            tset(state, i, T_STATE, S_READY)
        }
        i = i + 1
    }
    let cur: u64 = current(state)
    tset(state, cur, T_TICKS, tget(state, cur, T_TICKS) + 1)
    // RUNDE WERKZEUGE: DERSELBE SCHLAG, EIN ZWEITES MAL GEZAEHLT --
    // aber nur, wenn ihn die Leerlaufaufgabe bekommen hat. `C_TICKS`
    // (drei Zeilen weiter oben, derselbe Kern, dieselbe Unterbrechung)
    // ist die Gesamtzeit dieses Kerns; das hier ist der Teil davon, in
    // dem er nichts zu tun hatte. Die Auslastung eines Kerns ist die
    // Differenz zweier Differenzen, und ohne diese Zeile fehlt die
    // Haelfte davon. Zwei Zeilen im Zeitgeber, kein Aufruf, keine
    // Sperre -- der Zaehler gehoert dem Kern, auf dem er hochgeht.
    if tget(state, cur, T_KIND) == K_IDLE {
        cpu.add(state, me, cpu.C_IDLETICKS, 1)
    }
    // RUNDE LEISTE: zwei Lesezugriffe je Schlag. Der Preis dafuer,
    // dass ein Kernstapel, der unten herauslaeuft, nicht mehr still
    // irgendwo im Rechner Schaden anrichtet.
    guard_check(state, cur)
    if kstate.get(state, kstate.PREEMPT) == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    let budget: u64 = tget(state, cur, T_BUDGET)
    if budget > 1 {
        tset(state, cur, T_BUDGET, budget - 1)
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    tset(state, cur, T_BUDGET, 0)
    schedule_locked(state)
}

// ---------------------------------------------------------- blocking

// ================================================ RUNDE BLECHEINGABE
// ============ EIN SCHLAEFER AN EINEM TOTEN ZEITGEBER IST EINE LEICHE.
//
// Geweckt wird ausschliesslich in `on_tick`, und `on_tick` kommt
// ausschliesslich aus dem Zeitgeberbehandler. Schlaegt der nicht mehr,
// dann schlafen `wait_wm` (die Schreibtischschleife) und die
// Taskleiste (`ulib.sleep_ms(25)`) FUER IMMER: kein Bild, keine
// Eingabe, keine Messtafel -- und die Uhr steht auf der Minute, in der
// es passiert ist.
//
// Deshalb wird hier gemessen statt vertraut. Bewegt sich die
// Markenzahl in einem am Zyklenzaehler abgelesenen Fenster nicht, wird
// NICHT geschlafen: die Aufgabe gibt den Prozessor einmal ab und
// kehrt zurueck. Das ist langsamer und dreht leer -- aber ein
// Schreibtisch, der leer dreht, ist ein Schreibtisch, und ein
// Schreibtisch, der schlaeft, ist ein Standbild.
//
// Die Zahl unten ist grosszuegig: bei 100 Hz kommt alle 10 ms eine
// Marke; 300 ms ohne eine einzige heisst, dass etwas kaputt ist und
// nicht, dass die Maschine beschaeftigt war.
// RUNDE MERGE-7: JE KERN statt drei geteilte `static mut`. Der Wachhund
// beobachtet, ob DIESER Kern noch Zeitgebermarken sieht -- das ist eine
// Frage je Kern, keine gemeinsame, und ein gemeinsamer Zustand ohne
// Sperre hiess: Kern A schreibt `tote_zeit` mit seinem TSC-Wert, Kern B
// liest ihn im selben Augenblick und zieht seinen EIGENEN, kleineren
// TSC-Wert ab -- `t - tote_zeit` unterlaeuft null. Siehe kernel/cpu.fi,
// C_TOTMARKE/C_TOTZEIT/C_TOTZAHL, fuer die Messung, die das zeigt.
fn timer_tot(state: u64) -> bool {
    let hz: u64 = apic.tsc_hz(state)
    if hz == 0 {
        return false
    }
    let k: u64 = cpu.here(state)
    let jetzt: u64 = kstate.get(state, kstate.TICKS)
    let t: u64 = apic.tsc()
    let marke: u64 = cpu.get(state, k, cpu.C_TOTMARKE)
    if jetzt != marke {
        cpu.set(state, k, cpu.C_TOTMARKE, jetzt)
        cpu.set(state, k, cpu.C_TOTZEIT, t)
        return false
    }
    let zeit: u64 = cpu.get(state, k, cpu.C_TOTZEIT)
    if zeit == 0 {
        cpu.set(state, k, cpu.C_TOTZEIT, t)
        return false
    }
    if t > zeit && t - zeit > hz / 3 {
        cpu.add(state, k, cpu.C_TOTZAHL, 1)
        return true
    }
    return false
}

// Wie oft ein Schlaf abgelehnt wurde, weil keine Marke mehr kam. Steht
// auf der Messtafel: ist die Zahl groesser als null, war der Zeitgeber
// wirklich stehen -- gemessen, nicht vermutet.
// RUNDE MERGE-7: Summe ueber alle Kerne -- C_TOTZAHL liegt jetzt je
// Kern, die Messtafel will trotzdem EINE Zahl fuer die ganze Maschine.
fn tote_schlaefe(state: u64) -> u64 {
    var summe: u64 = 0
    var k: u64 = 0
    while k < cpu.count(state) {
        summe = summe + cpu.get(state, k, cpu.C_TOTZAHL)
        k = k + 1
    }
    return summe
}

// `ticks` timer ticks, 10 ms each at 100 Hz. Zero is a yield.
fn sleep_ticks(state: u64, ticks: u64) {
    if ticks == 0 {
        yield_now(state)
        return
    }
    if timer_tot(state) {
        yield_now(state)
        return
    }
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    tset(state, cur, T_WAKE, kstate.get(state, kstate.TICKS) + ticks)
    tset(state, cur, T_STATE, S_SLEEP)
    schedule_locked(state)
    irq_restore(flags)
}

// Whoever waits for this pid becomes ready again.
fn wake_pid(state: u64, pid: u64) {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) == S_WAIT {
            let w: u64 = tget(state, i, T_WAITPID)
            if w == 0 || w == pid {
                tset(state, i, T_STATE, S_READY)
            }
        }
        i = i + 1
    }
}

// ------------------------------------------------- RUNDE POLL: WECKEN
//
// DREI FUNKTIONEN, UND ZUSAMMEN SIND SIE DIE ANTWORT AUF DIE
// WETTLAUFSITUATION, an der jede erste Fassung von `poll` scheitert:
//
//     Prozess A                        Prozess B
//     ---------                        ---------
//     sieht nach: nichts ist bereit
//                                      schreibt in das Rohr
//                                      weckt alles, was wartet (nichts)
//     legt sich schlafen                <- schlaeft bis zum Zeitablauf
//
// Die Zeile dazwischen ist der Fehler, und ein Schloss um beide Haelften
// waere die falsche Antwort: `poll` sieht Rohre, Steckdosen und
// Terminals an, und jede dieser Schichten hat eine Sperre von sich aus.
// Also eine ZAEHLERFOLGE: A merkt sich `poll_seq` VOR seiner Pruefung,
// B erhoeht sie VOR seinem Wecken -- und `poll_sleep` legt A nur dann
// schlafen, wenn die Zahl unveraendert ist. Im Ablauf oben hat B sie
// erhoeht, A schlaeft nicht ein und sieht sofort noch einmal nach.
//
// `poll_kick` nimmt die Laufsperre NICHT. Das ist dieselbe Entscheidung,
// die `wake_pid` acht Zeilen tiefer trifft und aus demselben Grund: die
// Funktion wird aus dem Netzstapel (mit der Netzsperre in der Hand) und
// aus der Zeilendisziplin (aus einer Unterbrechung heraus) gerufen. Eine
// zweite Sperre in dieser Reihenfolge waere eine Verklemmung. Was sie
// tut, ist ein einzelner Schreibzugriff je Aufgabe -- S_POLL nach
// S_READY -- und derselbe Schreibzugriff, den `wake_pid` macht.
fn poll_seq(state: u64) -> u64 {
    return kstate.get(state, kstate.POLLSEQ)
}

// Irgendwo kann etwas bereit geworden sein. ZUERST die Folge erhoehen,
// DANN wecken -- in der anderen Reihenfolge gaebe es ein Fenster, in dem
// ein Prueferblick die alte Zahl liest und trotzdem nichts sieht.
fn poll_kick(state: u64) {
    kstate.add(state, kstate.POLLSEQ, 1)
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) == S_POLL {
            tset(state, i, T_STATE, S_READY)
        }
        i = i + 1
    }
}

// Schlafen legen -- aber nur, wenn sich die Weckfolge seit `seen` nicht
// bewegt hat. Der Vergleich und das Setzen von S_POLL geschehen unter
// DERSELBEN Laufsperre, unter der `schedule_locked` die Aufgabe abgibt;
// zwischen beiden kann kein Wecker verlorengehen, denn ein Wecker, der
// vorher kam, hat die Zahl bereits veraendert.
// RUNDE ASYNC: DERSELBE WECKER, ABER AN GENAU EINE AUFGABE.
//
// `poll_kick` weckt ALLES, was wartet. Fuer ein Rohr ist das richtig --
// wer darauf wartet, kann der Kern nicht wissen. Fuer eine
// Fertigmeldung weiss er es genau: sie gehoert einer Aufgabe. Ohne
// diesen Unterschied weckt jede einzelne Meldung auch die vier
// Arbeitsfaeden, und die laufen dann los, finden nichts und legen sich
// wieder hin -- bei sechzehn Meldungen in einem Zug also vierundsechzig
// Wecker fuer nichts. GEMESSEN hat das bei sechzehn offenen Auftraegen
// 13838 gegen 13473 Zyklen je Auftrag gemacht: 2,6 %, und damit deutlich
// weniger, als die Ueberlegung versprach. Die Zahl steht trotzdem hier,
// weil eine Optimierung ohne Messung eine Behauptung ist.
//
// Die FOLGE wird trotzdem erhoeht, und zwar VOR dem Wecken: daran
// erkennt ein Wartender, der zwischen Pruefung und Schlaf steht, dass
// er nicht schlafen darf. Genau das ist die Wettlaufsituation, die
// Runde POLL geloest hat, und sie gilt hier unveraendert.
fn poll_kick_one(state: u64, task: u64) {
    kstate.add(state, kstate.POLLSEQ, 1)
    if task >= kstate.MAX_TASKS {
        return
    }
    if tget(state, task, T_STATE) == S_POLL {
        tset(state, task, T_STATE, S_READY)
    }
}

fn poll_sleep(state: u64, seen: u64, deadline: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if kstate.get(state, kstate.POLLSEQ) != seen {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return
    }
    let cur: u64 = current(state)
    tset(state, cur, T_POLLSEQ, seen)
    tset(state, cur, T_WAKE, deadline)
    tset(state, cur, T_STATE, S_POLL)
    schedule_locked(state)
    irq_restore(flags)
}

fn find_pid(state: u64, pid: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) != S_FREE && tget(state, i, T_PID) == pid {
            return i
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

// ------------------------------------------------------------ the end

// A task ends. It stays in the table as a corpse until its creator picks
// up the exit code -- otherwise `wait` would have nothing left to read.
// Its kernel stack is the one this function is standing on and is
// therefore NOT freed here; that happens in the reaper.
fn exit_task(state: u64, code: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    tset(state, cur, T_EXIT, code)
    tset(state, cur, T_END, kstate.get(state, kstate.TICKS))
    tset(state, cur, T_STATE, S_ZOMBIE)
    reparent(state, cur)
    wake_pid(state, tget(state, cur, T_PID))
    schedule_locked(state)
    irq_restore(flags)
    // The scheduler never comes back to a corpse. If it does, something
    // is broken enough that going on would be worse.
    while true {
        asm("hlt")
    }
}

// RUNDE K13: DIE WAISEN. Stirbt ein Prozess, der noch Kinder hat, so
// hatten diese Kinder bis zu dieser Runde einen Elternteil, dessen Platz
// gleich wieder vergeben wird -- ihr `T_PARENT` zeigte danach auf einen
// fremden Prozess, und beim Sterben fand sie niemand mehr: sie blieben
// als Leichen in der Tafel stehen, bis der Lauf endete. GENAU DAS ist die
// Zahl, die die Gegenprobe dieser Runde misst (`zombie` ohne init).
//
// Von hier an fallen sie an den Prozess 1, wie in jedem Unix. Der Platz
// steht in `kstate.K13_OFF + U_INITSLOT`, um eins erhoeht, damit die Null
// weiter "es gibt keinen" heisst -- ohne init aendert sich also nichts,
// und das ist der Sinn: die Gegenprobe soll ohne init zusammenbrechen.
//
// Steht unter der Laufliste-Sperre, weil der Aufrufer sie haelt. Es wird
// nur ein Wort je Kind geschrieben, kein Zustand veraendert und keine
// zweite Sperre genommen.
fn reparent(state: u64, dying: u64) {
    let slot: u64 = kstate.get(state, kstate.K13_OFF + kstate.U_INITSLOT)
    if slot == 0 {
        return
    }
    let init: u64 = slot - 1
    if init == dying {
        return
    }
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) != S_FREE {
            if tget(state, i, T_PARENT) == dying && i != dying {
                tset(state, i, T_PARENT, init)
                kstate.add(state, kstate.K13_OFF + kstate.U_ORPHANS, 1)
            }
        }
        i = i + 1
    }
}

// The corpse is cleared away: its kernel stack goes back to the frame
// allocator, its slot into the table. Whoever calls this must have picked
// up the exit code beforehand -- and must not be standing on that stack,
// which is why a task can never reap itself.
// ROUND K5: the slot is released under the run queue lock, the FRAMES
// are given back afterwards, outside it. Same rule as in `create` and for
// the same reason -- the two locks of this kernel are never nested.
fn reap(state: u64, i: u64) -> bool {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if tget(state, i, T_STATE) != S_ZOMBIE || i == current(state) {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return false
    }
    let stack: u64 = tget(state, i, T_KSTACK)
    // RUNDE AVX: derselbe Weg wie beim Stapel -- der Platz wird UNTER
    // der Sperre geleert, der Rahmen DANACH zurueckgegeben. Und vorher
    // wird jedem Kern, der diesen Bereich noch als geladen fuehrt,
    // gesagt, dass es ihn nicht mehr gibt; sonst sicherte der naechste
    // Wechsel in einen Rahmen, der schon jemand anderem gehoert.
    let vec_area: u64 = tget(state, i, T_FPU)
    tset(state, i, T_FPU, 0)
    tset(state, i, T_KSTACK, 0)
    tset(state, i, T_STATE, S_FREE)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    if stack != 0 {
        free_stack(state, stack)
    }
    if vec_area != 0 {
        fpu.drop_owner(state, vec_area)
        fpu.area_free(state, vec_area)
    }
    return true
}

// A fault in ring 3 kills the process, not the kernel. This is the point
// at which an operating system differs from the kernel of round 59: there
// the machine stopped at every exception, and rightly so -- there was
// nobody else the fault could belong to.
fn kill_current(state: u64, pid_vector: u64, err: u64, cr2: u64, rip: u64) {
    var s_kill: [u8; 13] = "user fault: \0"
    var s_pid: [u8; 6] = "pid=\0\0"
    var s_vec: [u8; 10] = "  vector=\0"
    var s_err: [u8; 7] = "  err=\0"
    var s_cr2: [u8; 7] = "  cr2=\0"
    var s_rip: [u8; 7] = "  rip=\0"
    var s_dead: [u8; 20] = "  -- process killed\0"
    let cur: u64 = current(state)
    serial.puts((&s_kill[0]) as u64)
    serial.puts((&s_pid[0]) as u64)
    serial.dec(tget(state, cur, T_PID))
    serial.puts((&s_vec[0]) as u64)
    serial.dec(pid_vector)
    serial.puts((&s_err[0]) as u64)
    serial.hex(err)
    serial.puts((&s_cr2[0]) as u64)
    serial.hex(cr2)
    serial.puts((&s_rip[0]) as u64)
    serial.hex(rip)
    serial.puts((&s_dead[0]) as u64)
    serial.nl()
    kstate.add(state, kstate.KILLED, 1)
    tset(state, cur, T_FAULTS, tget(state, cur, T_FAULTS) + 1)
    // 128 + vector, the way a system with signals would count it.
    exit_task(state, 128 + pid_vector)
}

// ------------------------------------------------------------ the view

fn dump_tasks(state: u64) {
    var s_row: [u8; 7] = "task: \0"
    var s_pid: [u8; 5] = "pid=\0"
    var s_kind: [u8; 8] = "  kind=\0"
    var s_prio: [u8; 8] = "  prio=\0"
    var s_state: [u8; 9] = "  state=\0"
    var s_runs: [u8; 8] = "  runs=\0"
    var s_ticks: [u8; 9] = "  ticks=\0"
    var s_work: [u8; 8] = "  work=\0"
    var s_end: [u8; 7] = "  end=\0"
    var s_exit: [u8; 8] = "  exit=\0"
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) != S_FREE {
            serial.puts((&s_row[0]) as u64)
            serial.puts((&s_pid[0]) as u64)
            serial.dec(tget(state, i, T_PID))
            serial.puts((&s_kind[0]) as u64)
            serial.dec(tget(state, i, T_KIND))
            serial.puts((&s_prio[0]) as u64)
            serial.dec(tget(state, i, T_PRIO))
            serial.puts((&s_state[0]) as u64)
            serial.dec(tget(state, i, T_STATE))
            serial.puts((&s_runs[0]) as u64)
            serial.dec(tget(state, i, T_RUNS))
            serial.puts((&s_ticks[0]) as u64)
            serial.dec(tget(state, i, T_TICKS))
            serial.puts((&s_work[0]) as u64)
            serial.dec(tget(state, i, T_WORK))
            serial.puts((&s_end[0]) as u64)
            serial.dec(tget(state, i, T_END))
            serial.puts((&s_exit[0]) as u64)
            serial.dec(tget(state, i, T_EXIT))
            serial.nl()
        }
        i = i + 1
    }
}
