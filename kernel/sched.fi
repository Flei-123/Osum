// kernel/sched.fi -- round 62: tasks and the scheduler.
//
// Round 59 had one thread of control: `kernel_main` ran from top to
// bottom, and the only thing that ever took the processor away from it
// was an interrupt that gave it straight back. From here on the kernel
// has TASKS, and the timer takes the processor away for good.
//
// A task is 256 octets in the data area (`kstate.TASK_OFF`) plus a
// KERNEL STACK OF ITS OWN out of the frame allocator. Everything a task
// needs in order to be interrupted in the middle and continued later
// lives on that stack; the task record only holds the stack pointer.
// That is the whole trick of a context switch, and `switch.s` does the
// six lines that a language cannot do.
//
// THE PLAN: weighted round robin. Every ready task gets a turn, in the
// order of the table, and the length of the turn is its priority in timer
// ticks. Priority 3 therefore gets three times the processor of priority
// 1 -- and nothing starves, which is what a strict priority order would
// do. The proof is in `tools/kernel/run.sh`: three workers with the
// priorities 1, 2 and 3 do the same amount of work, and the one with the
// highest priority is done first.
//
// THE COUNTER-CHECK belongs to it: with `nopreempt` on the command line
// the timer does not switch, and the same three workers run one after the
// other -- each one scheduled exactly ONCE. Interleaving that a spin loop
// produces on its own would show up here.

import serial
import kstate
import mem
import atomic
import cpu

export {
    init, create, start, schedule, on_tick, yield_now, sleep_ticks,
    exit_task, reap,
    kill_current, wake_pid, find_pid, current, tget, tset, task_at,
    stack_high, STACK_PAINT,
    trace_push, trace_dump, dump_tasks, ready_count, alive_count,
    irq_save, irq_restore, set_kernel_stack,
    adopt, enter_task, set_idle, zombies, reap_all, cpu_of, cpu_mask,
    clear_signals,
    set_affinity, affinity, ANY_CPU,
    T_STATE, T_PID, T_RSP, T_KSTACK, T_KTOP, T_PRIO, T_BUDGET, T_WORK,
    T_WAKE, T_CR3, T_PARENT, T_EXIT, T_RUNS, T_ENTRY, T_USTACK, T_KIND,
    T_WAITPID, T_TICKS, T_PDPT, T_PD, T_PT, T_DATA, T_CWD, T_ARG,
    T_END, T_FD, T_FDOFF, T_FAULTS, FD_SLOTS, T_BRK, T_MMAP,
    S_FREE, S_READY, S_RUN, S_SLEEP, S_WAIT, S_ZOMBIE, S_NEW, S_STOP,
    T_SIGPEND, T_SIGMASK, T_SIGLAST, T_PGID, T_SID, T_TTY, T_SIGDEL, T_STOPSIG,
    T_SIGRET, T_ALARM, T_TGID, T_SHARED, T_FUTEX, T_FUTEXVAL,
    T_KILLCODE, T_UID, T_GID, T_EUID, T_EGID, T_SUID,
    T_SGID, T_UMASK, K_BOOT, K_IDLE, K_WORKER, K_USER,
    K_GRIND, KSTACK_FRAMES, K_NETD, T_BIG,
}

// ------------------------------------------------------ the task record

const T_STATE: u64 = 0 // one of the S_* below
const T_PID: u64 = 8
const T_RSP: u64 = 16 // where the switch left the stack pointer
const T_KSTACK: u64 = 24 // lowest octet of the kernel stack
const T_KTOP: u64 = 32 // upper end of it
const T_PRIO: u64 = 40 // 1..3, also the length of a turn in ticks
const T_BUDGET: u64 = 48 // ticks left in this turn
const T_WORK: u64 = 56 // what the task counted up itself; in a
// process before its start: its argument
const T_WAKE: u64 = 64 // tick at which a sleeper is due
const T_CR3: u64 = 72 // its address space
const T_PARENT: u64 = 80 // index of the creator
const T_EXIT: u64 = 88 // the code it left with
const T_RUNS: u64 = 96 // how often it got the processor
const T_ENTRY: u64 = 104 // rip in ring 3
const T_USTACK: u64 = 112 // rsp in ring 3
const T_KIND: u64 = 120 // K_* below
const T_WAITPID: u64 = 128 // which child it is waiting for
const T_TICKS: u64 = 136 // timer ticks spent in this task
const T_PDPT: u64 = 144 // the four frames of its page tables
const T_PD: u64 = 152
const T_PT: u64 = 160
const T_DATA: u64 = 168 // its private data page (physical)
const T_CWD: u64 = 176 // inode of the working directory
const T_ARG: u64 = 184 // which program of uprog.fi (proc.fi)
const T_END: u64 = 192 // tick at which it ended
const T_FD: u64 = 200 // three open files: inode + 1, 0 = closed
const T_FDOFF: u64 = 224 // and the read/write position of each
const T_FAULTS: u64 = 248 // faults it caused

// ROUND K4. A record is 512 octets now (`kstate.TASK_BYTES`), and what the
// new half holds is what a POSIX process has besides its code: where its
// program break stands and how far its mmap area has grown down. The
// DESCRIPTORS moved out of the record altogether -- `kernel/file.fi`
// keeps them, because `dup2` and `fork` need two descriptors to be able to
// mean ONE open file, and an inode in the record cannot do that.
const T_BRK: u64 = 256 // `brk`, 0 = the process has never asked
const T_MMAP: u64 = 264 // the lower end of the mmap area, 0 = none yet

// ROUND K9. WAS EIN UNIX-PROZESS AUSSER SEINEM SPEICHER UND SEINEN
// DATEIEN NOCH IST. Der Satz passt in den zweiten Teil des Datensatzes,
// den Runde K4 aufgemacht und nicht ausgefuellt hat -- 272 bis 511 lagen
// leer. Nichts davon muss der Kern der Auswahl kennen; `sched.create`
// nullt den ganzen Datensatz, also faengt jede Aufgabe mit leerer
// Warteschlange, leerer Maske und ohne Prozessgruppe an.
const T_SIGPEND: u64 = 272 // wartende Signale, ein Bit je Nummer
const T_SIGMASK: u64 = 280 // blockierte Signale
const T_SIGLAST: u64 = 288 // das zuletzt zugestellte
const T_PGID: u64 = 296 // Prozessgruppe (0 = die eigene pid)
const T_SID: u64 = 304 // Sitzung
const T_TTY: u64 = 312 // beherrschendes Terminal + 1, 0 = keines
const T_SIGDEL: u64 = 320 // wie viele Signale zugestellt wurden
const T_STOPSIG: u64 = 328 // welches Signal es angehalten hat
const T_SIGRET: u64 = 336 // Adresse des Rahmens auf dem Nutzerstapel
const T_ALARM: u64 = 344 // Marke, zu der SIGALRM faellig ist, 0 = nie
const T_TGID: u64 = 352 // Fadengruppe (clone), 0 = die eigene pid
const T_SHARED: u64 = 360 // 1 = teilt den Adressraum, nicht freigeben
const T_FUTEX: u64 = 368 // Adresse, auf die dieser Faden wartet
const T_FUTEXVAL: u64 = 376 // und der Wert, auf den er sich berufen hat
// ROUND K9, UND ES IST EINE ZUSAGE AN DIE RUNDEN VORHER. Stirbt ein
// Prozess an einem Signal, ist sein Beendigungscode 128 + Signalnummer --
// so rechnet jede Shell. Stirbt er an einer AUSNAHME, war er in diesem
// Kernel seit Runde 62 128 + VEKTORNUMMER, und `tools/osum/run.sh` misst
// seit damals, dass ein Seitenfehler 142 ergibt (128 + 14). Beide Zahlen
// haben ihr Recht, und beide bleiben: `signal.fault` traegt hier die
// vektorbasierte ein, und wo sie steht, gilt sie. 0 = es gilt die
// Signalnummer.
const T_KILLCODE: u64 = 384

// ------------------------------------------------- RUNDE K13: WER ES IST
//
// Sieben Woerter, und sie liegen im AUFGABENSATZ und nicht in einem
// eigenen Bereich von `kdata`. Der Satz ist seit Runde K4 512 Oktette
// gross und war bis T_KILLCODE (384) belegt; 392 bis 511 lagen leer. Ein
// Attribut, das zu einem Prozess gehoert, gehoert in den Satz dieses
// Prozesses -- eine zweite Tabelle daneben waere eine zweite Stelle, an
// der man vergessen kann, sie mitzuloeschen (`sched.create` nullt den
// ganzen Satz, und damit ist ein frischer Prozess root, bis eine Zeile
// weiter unten die Kennungen des Elternteils darueberkommen).
//
// SECHS UND NICHT ZWEI, und der Grund ist `su`. POSIX kennt je Kennung
// drei Werte: die ECHTE (wer angemeldet ist), die WIRKSAME (nach der
// entschieden wird) und die GESICHERTE (wohin ein Programm mit setuid-Bit
// zurueckkann). Ein Programm mit nur zwei Werten kann seine Rechte
// ablegen und nicht wiederholen -- oder es kann sie nie ablegen. Beides
// ist falsch.
//
// T_UMASK ist die Maske, die `open` und `mkdir` von den Rechten einer
// NEUEN Datei abziehen. Sie wird ueber `fork` und `execve` vererbt wie
// die Kennungen; 0 heisst "nichts abziehen", und der Kernel setzt sie
// nirgends selbst -- das tut die Shell.
const T_UID: u64 = 392 // die echte Benutzerkennung
const T_GID: u64 = 400 // die echte Gruppenkennung
const T_EUID: u64 = 408 // die wirksame -- nach ihr wird entschieden
const T_EGID: u64 = 416
const T_SUID: u64 = 424 // die gesicherte (setuid-Bit, `su`)
const T_SGID: u64 = 432
const T_UMASK: u64 = 440 // was `open`/`mkdir` abziehen
// RUNDE K16: die untere Kante der GROSSEN Arena (`proc.BIG_TOP` abwaerts),
// 0 = dieser Prozess hat sie noch nie gebraucht. Sie ist das Gegenstueck
// zu T_MMAP, und sie ist getrennt davon, weil die alte Halde genau da
// bleiben soll, wo sie seit Runde K4 liegt: was `tools/posix/run.sh` an
// Adressen misst, misst es weiter.
//
// ============================================================
// 448 UND NICHT 392. EIN FEHLER, DER AELTER IST ALS DIE RUNDE,
// IN DER ER GEFUNDEN WURDE.
// ============================================================
//
// Hier stand 392, und 392 IST `T_UID` -- zwei Felder desselben
// Datensatzes auf demselben Versatz. Aufgefallen ist es nicht, weil
// beide fast immer null sind. Aufgefallen ist es an dem einen Ort, an
// dem sie es nicht sind: `do_exec` setzt `T_BIG` auf 0, wenn ein neues
// Abbild anfaengt -- und hat damit die ECHTE BENUTZERKENNUNG jedes
// Prozesses bei jedem `execve` auf 0 zurueckgesetzt.
//
// DAS IST KEINE SCHOENHEITSFRAGE. `su` fragt nur dann nach einem
// Passwort, wenn die echte Kennung nicht 0 ist (`kernel/user/su.fi`:
// "wer schon root ist, wird nicht gefragt"). Nach `su justin` stand
// dort wieder 0, also kam jedes weitere `su root` OHNE Passwort durch.
// Gemessen: `tools/k13/run.sh` sagt auf `main` (3389fbd) genau das --
// "justin: die eigene Kennung nach su: '0', erwartet '1000'" und "su
// lehnt ein falsches Passwort ab -- fehlt", zwoelf Zusagen insgesamt.
// Mit einem eigenen Arbeitsbaum an derselben Stelle nachgemessen, damit
// nicht diese Runde die Schuld bekommt.
//
// Ein Datensatz ist 512 Oktette gross (`kstate.TASK_BYTES`), das letzte
// belegte Feld ist `T_UMASK` bei 440. 448 ist frei, und es ist das
// naechste.
const T_BIG: u64 = 448

// The three descriptor slots of round 62. Nothing writes them any more;
// they stay named so that a reader of a task dump knows what the hole in
// the middle of the record was.
const FD_SLOTS: u64 = 3

const S_FREE: u64 = 0
const S_READY: u64 = 1
const S_RUN: u64 = 2
const S_SLEEP: u64 = 3
const S_WAIT: u64 = 4
const S_ZOMBIE: u64 = 5
// Under construction: the record exists, the stack exists, and the
// scheduler must NOT take it yet. Round 62 learned this the hard way --
// `proc.create` fills in the address space and the entry point AFTER the
// task record, and a timer interrupt in between started a process whose
// rip was still zero. A task becomes runnable when its creator says so,
// and not a moment earlier.
const S_NEW: u64 = 6
// ROUND K9. ANGEHALTEN -- was `SIGSTOP` aus einem Prozess macht und was
// `SIGCONT` rueckgaengig macht. Es ist ein eigener Zustand und nicht
// S_SLEEP: ein Schlaefer wird vom Zeitgeber geweckt, ein Angehaltener
// nicht, und ohne den Unterschied waere STRG-Z ein Schlaf von zehn
// Millisekunden. `pick` waehlt nur S_READY -- eine angehaltene Aufgabe
// faellt damit von selbst aus der Laufliste, ohne dass der Kern der
// Auswahl eine Zeile mehr braucht.
const S_STOP: u64 = 7

const K_BOOT: u64 = 0
const K_IDLE: u64 = 1
const K_WORKER: u64 = 2
const K_USER: u64 = 3
// ROUND K5. A kernel task that does ARITHMETIC and nothing else. The
// worker of round 62 spins on `pause`, which is the right instruction for
// showing that a task is interruptible and the wrong one for measuring
// how fast four cores are: QEMU's translator leaves the emulation loop at
// every `pause`, so eight such tasks on four cores are eight tasks
// waiting on the emulator, not on the processor.
const K_GRIND: u64 = 4
// ROUND K8: the task that moves frames between the card and the TCP/IP
// stack. It is a task and not a loop inside a system call because a
// `ping` from the other side has to be answered while every process in
// this system is waiting for something else. Its body is
// `inet.netd_body`, reached through `tasks.main` like every other kernel
// task -- stage 0 of Firn has no function pointers in the kernel
// profile.
const K_NETD: u64 = 5

// ACHT frames = 32 KiB of kernel stack per task (Runde K17; davor vier).
//
// ROUND 62 had two, and two were enough for what a system call did then:
// write an octet, look up an inode, hand a page back. ROUND K1 made the
// deepest system call much deeper --
//
//   syscall_entry -> sys.entry -> do_exec -> elf.spawn -> elf.load
//                 -> elf.segment -> fs.read_at -> blk.read -> ata_read
//
// -- and it overflowed, in a way worth writing down because it is the
// kind of bug that looks like something else: the stack ran off its lower
// end into the frame below, a `ret` picked up an octet of a neighbouring
// page as a return address, and the machine died at a #GP or a #UD whose
// rip was an address in its own stack, with a register dump that pointed
// at the ATA driver. The driver was innocent. It was simply the deepest
// thing on the stack when it broke.
//
// So the number is not a guess any more. `stack_high` below paints every
// kernel stack and reads the high-water mark back off it, `kmain.osum`
// reports it, and `tools/osum/run.sh` checks BOTH bounds: the deepest
// call has to stay under 16 KiB, and it has to be OVER 8 KiB -- which is
// the counter-check, because that is exactly the number that says the two
// frames of round 62 were not enough and this line had to change.
// RUNDE K18 HAT DARAUS EINE ACHT GEMACHT, aus demselben Grund, aus dem
// Runde K1 aus der Zwei eine Vier gemacht hat: gemessen, dass es nicht
// reicht.
//
// `kmain.osum` meldet den Hoechststand, und im Lauf mit der Shell auf
// dem Rahmenpuffer (`osum gfx`) steht dort:
//
//     osum: kstack deepest=16384 of 16384
//
// Das ist nicht "knapp", das ist VOLL. `stack_high` faerbt den Stapel
// und liest den Hoechststand zurueck; meldet er die ganze Groesse, ist
// keine gefaerbte Stelle mehr uebrig -- der Stapel ist mindestens einmal
// bis zum letzten Oktett benutzt worden. Genau diesen Fall verbietet
// `tools/osum/run.sh` mit der Zusage "der tiefste Kernstapel des Laufs
// muss UNTER der Groesse bleiben".
//
// DAS STAND SCHON VOR DIESER RUNDE SO: derselbe Lauf auf `main` meldet
// dieselben 16384 von 16384. Er ueberlebt es dort, aber nur, weil hinter
// dem letzten Oktett zufaellig nichts liegt, was gebraucht wird. Ein
// Kernel mit anderer Codeanordnung faellt hinein -- mit Runde K18 endete
// derselbe Lauf in drei von acht Faellen mit
//
//     *** EXCEPTION 6 #UD  rip=0x9fc42  rsp=0x506ff8
//
// also mit einem Sprung an eine Adresse unterhalb des Kernels: eine
// Ruecksprungadresse, die nicht mehr da war, wo sie hingehoerte.
//
// Acht Rahmen statt vier sind 32 KiB je Aufgabe, bei 32 Aufgaben
// hoechstens ein Megabyte; die Messmaschine hat 128. Der Preis ist
// Speicher, den es gibt. Der Preis der Vier war ein Kernel, der je nach
// Codeanordnung faellt.
//
// RUNDE K17 HAT DIESELBE STELLE UNABHAENGIG DAVON EIN ZWEITES MAL
// GERISSEN, mit einem anderen Aufruf. Sie haengt an den tiefsten
// Aufruf, den es gibt (`read` auf eine Datei), vier weitere Schichten:
//
//   sys.dispatch -> do_read -> vfs_read -> vfs.v_read -> fat.read
//                -> blk.read_on -> usb.msc_read -> usb.bot
//                -> xhci.bulk -> xhci.wait_ep -> xhci.drain
//
// Gemessen wie in Runde K1 beschrieben: `wc` auf eine Datei eines
// USB-Sticks, und danach starb nicht der Treiber, sondern die SHELL --
// an einem Zeiger in ihrem eigenen Stapelrahmen, der einmal 0 und
// einmal eine Adresse aus der Kernhalde war. Der Kernstapel war unten
// herausgelaufen und hatte in den Rahmen darunter geschrieben. Mit acht
// Rahmen lief derselbe Lauf durch; die Hochwassermarke stand bei 16064
// von 32768.
//
// ACHT UND NICHT SECHS. Der erste Anlauf von K17 schlug sechs Rahmen
// vor (24576 Oktette). Diese Schranke war zu diesem Zeitpunkt ZWEIMAL
// zu knapp gewesen -- K18 hat 16384 von 16384 gesehen, K17 unabhaengig
// davon 16064 gemessen. Bei einer Zahl, die zweimal nicht gereicht hat,
// nimmt man nicht die knappere. Die beiden Schranken in
// `tools/osum/run.sh` bleiben unveraendert gueltig: der tiefste Aufruf
// ist weiter groesser als die 8192 von Runde 62 und kleiner als der
// Stapel.
const KSTACK_FRAMES: u64 = 8

// What an untouched octet of kernel stack looks like.
const STACK_PAINT: u64 = 0x5A5A5A5A5A5A5A5A

// Indices in the table out of isr.s.
const V_SWITCH: u64 = 55
const V_GUARD: u64 = 57
const V_TASK_MAIN: u64 = 62

fn vector(state: u64, i: u64) -> u64 {
    return __mmio_read64((kstate.get(state, kstate.VECTORS) + i * 8) as *mut u64)
}

// ------------------------------------------------------- the accesses

fn task_at(state: u64, i: u64) -> u64 {
    return state + kstate.TASK_OFF + i * kstate.TASK_BYTES
}

fn tget(state: u64, i: u64, field: u64) -> u64 {
    return __mmio_read64((task_at(state, i) + field) as *mut u64)
}

fn tset(state: u64, i: u64, field: u64, v: u64) {
    __mmio_write64((task_at(state, i) + field) as *mut u64, v)
}

// ROUND K5. This used to be one word for the whole machine
// (`kstate.CURRENT`). With four cores it has to be one word PER CORE --
// a scheduler that reads a single global "the running task" hands the
// same task to two processors, and then two stacks are one stack.
fn current(state: u64) -> u64 {
    return cpu.get(state, cpu.here(state), cpu.C_CUR)
}

// The second table round K5 needs: which core last ran a task, and which
// cores have ever run it. It lies beside the task table rather than in it
// because the task record is exactly full (248 + 8 = 256 = TASK_BYTES).
const TC_CPU: u64 = 0
const TC_MASK: u64 = 8
const TC_AFF: u64 = 16 // the only core that may run this task
const ANY_CPU: u64 = 99 // ... or this, when any of them may

fn tc_set(state: u64, i: u64, field: u64, v: u64) {
    __mmio_write64((state + kstate.TCPU_OFF + i * kstate.TCPU_BYTES + field)
        as *mut u64, v)
}

fn tc_get(state: u64, i: u64, field: u64) -> u64 {
    return __mmio_read64((state + kstate.TCPU_OFF + i * kstate.TCPU_BYTES
            +field) as *mut u64)
}

fn cpu_of(state: u64, i: u64) -> u64 {
    return tc_get(state, i, TC_CPU)
}

fn cpu_mask(state: u64, i: u64) -> u64 {
    return tc_get(state, i, TC_MASK)
}

// AFFINITY, and round K5 needs exactly one of it. Task 0 is
// `kernel_main` itself, and three things it does afterwards belong to the
// BOOT processor and to no other: the excursion into ring 3 (whose MSRs
// `user.setup` wrote on the boot processor alone), the word `isr.s` reads
// the kernel stack out of, and the two static save slots of `enter_user`.
// Without this, `kernel_main` migrates to whichever core happens to be
// free -- which is what a scheduler is supposed to do, and which broke
// the run in one attempt out of six until the reason was found.
fn set_affinity(state: u64, i: u64, c: u64) {
    tc_set(state, i, TC_AFF, c)
}

fn affinity(state: u64, i: u64) -> u64 {
    return tc_get(state, i, TC_AFF)
}

fn may_run(state: u64, i: u64, me: u64) -> bool {
    let a: u64 = tc_get(state, i, TC_AFF)
    return a == ANY_CPU || a == me
}

// ------------------------------------------------- the interrupt flag

// A critical section in a kernel is not a lock -- on one processor it is
// the interrupt flag. `irq_save` turns interrupts off AND says whether
// they were on; `irq_restore` puts back exactly that state. Plain
// `cli`/`sti` would switch them on in places where they have to stay off
// (inside an interrupt handler, for instance).
// ROUND K5: still true, and no longer SUFFICIENT. Turning interrupts off
// keeps the OTHER cores out of nothing at all; what it protects is this
// core against its own interrupt handler. Every place that used to make
// do with it and touches shared state now takes a lock as well -- and
// takes it with interrupts already off, because a handler that waits for
// a lock its own core holds waits for ever.
fn irq_save() -> u64 {
    return asm("pushfq\npop rax\ncli", out("rax"))
}

fn irq_restore(flags: u64) {
    if (flags & 0x200) != 0 {
        asm("sti")
    }
}

// ------------------------------------------------------------ the trace

// One octet per turn: which pid got the processor. That is the evidence
// for interleaving -- not a claim of the kernel but the list of the
// switches it really made.
fn trace_push(state: u64, v: u64) {
    let n: u64 = kstate.get(state, kstate.TRACE_LEN)
    if n < kstate.TRACE_MAX {
        kstate.set8(state + kstate.TRACE_OFF + n, v as u8)
        kstate.set(state, kstate.TRACE_LEN, n + 1)
    }
}

fn trace_dump(state: u64, label: u64, limit: u64) {
    var n: u64 = kstate.get(state, kstate.TRACE_LEN)
    if limit != 0 && n > limit {
        n = limit
    }
    serial.puts(label)
    var i: u64 = 0
    while i < n {
        serial.dec(kstate.get8(state + kstate.TRACE_OFF + i))
        serial.put(32 as u8)
        i = i + 1
    }
    serial.nl()
}

// ------------------------------------------------------------ creating

// Task 0 is the one that is already running: `kernel_main` itself. It
// gets a record so that the switch has somewhere to put its stack
// pointer -- its stack is the one out of boot.s.
fn init(state: u64) {
    var i: u64 = 0
    while i < kstate.MAX_TASKS {
        tset(state, i, T_STATE, S_FREE)
        i = i + 1
    }
    kstate.set(state, kstate.TASKS, 1)
    kstate.set(state, kstate.NEXT_PID, 2)
    var l: u64 = 0
    while l < kstate.LOCK_COUNT {
        atomic.lock_init(state, l)
        l = l + 1
    }
    var c: u64 = 0
    while c < kstate.MAX_CPUS {
        cpu.set(state, c, cpu.C_CUR, 0)
        c = c + 1
    }
    kstate.set(state, kstate.PREEMPT, 1)
    tset(state, 0, T_STATE, S_RUN)
    tset(state, 0, T_PID, 1)
    tset(state, 0, T_PRIO, 2)
    tset(state, 0, T_BUDGET, 2)
    tset(state, 0, T_KIND, K_BOOT)
    // ROUND K9. AUCH AUFGABE 0 HAT EINE PROZESSGRUPPE, und dass sie
    // nicht null ist, entscheidet mehr als es aussieht: jeder Prozess
    // dieses Systems erbt seine Gruppe von seinem Elternteil, und die
    // Kette endet hier. Blieb hier die Null stehen, hatte die ganze
    // Maschine die Gruppe null -- und `tty.push` haelt genau die Null
    // fuer "dieses Terminal hat keinen Vordergrund" und schickt kein
    // SIGINT. STRG-C tat dann nichts, und zwar still.
    tset(state, 0, T_PGID, 1)
    tset(state, 0, T_SID, 1)
    tset(state, 0, T_TGID, 1)
    tset(state, 0, T_KTOP, vector(state, 61))
    tset(state, 0, T_CR3, kstate.get(state, kstate.KPML4))
    var t: u64 = 0
    while t < kstate.MAX_TASKS {
        tc_set(state, t, TC_AFF, ANY_CPU)
        t = t + 1
    }
    // The one task in this kernel that is not allowed to move.
    tc_set(state, 0, TC_AFF, 0)
    set_kernel_stack(state, vector(state, 61))
    trace_push(state, 1)
}

// The idle task of the BOOT processor. Kept in `kstate.IDLE` as before
// (several counters read it) and in the per-core record, because from
// round K5 on every core has one of its own.
fn set_idle(state: u64, i: u64) {
    kstate.set(state, kstate.IDLE, i)
    cpu.set(state, cpu.here(state), cpu.C_IDLE, i)
}

// A record for a context that is ALREADY running -- the way `init` gives
// task 0 to `kernel_main`, only later and for a core that has just come
// up. Its stack is not one the frame allocator handed out for a task, so
// T_KSTACK stays zero and `reap` will not give it back.
fn adopt(state: u64, kind: u64, prio: u64, ktop: u64) -> u64 {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    var i: u64 = 1
    var slot: u64 = 0
    while i < kstate.MAX_TASKS {
        if tget(state, i, T_STATE) == S_FREE {
            slot = i
            i = kstate.MAX_TASKS
        } else {
            i = i + 1
        }
    }
    if slot == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return 0
    }
    var j: u64 = 0
    while j < kstate.TASK_BYTES / 8 {
        __mmio_write64((task_at(state, slot) + j * 8) as *mut u64, 0)
        j = j + 1
    }
    tset(state, slot, T_PID, kstate.add(state, kstate.NEXT_PID, 1) - 1)
    tset(state, slot, T_KTOP, ktop)
    tset(state, slot, T_PRIO, prio)
    tset(state, slot, T_BUDGET, prio)
    tset(state, slot, T_KIND, kind)
    tset(state, slot, T_CR3, kstate.get(state, kstate.KPML4))
    tset(state, slot, T_STATE, S_RUN)
    tc_set(state, slot, TC_CPU, cpu.here(state))
    tc_set(state, slot, TC_MASK, 1 << cpu.here(state))
    tc_set(state, slot, TC_AFF, cpu.here(state))
    clear_signals(state, slot)
    if slot + 1 > kstate.get(state, kstate.TASKS) {
        kstate.set(state, kstate.TASKS, slot + 1)
    }
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return slot
}

// The initial stack of a task that has never run. It is built so that it
// looks EXACTLY like a task the switch stepped out of a moment ago -- see
// the layout in switch.s. That way `context_switch` needs no special case
// for a first start.
fn frame_build(state: u64, ktop: u64, entry: u64, a0: u64, a1: u64,
    a2: u64) -> u64 {
    let base: u64 = ktop - 144
    var i: u64 = 0
    while i < 18 {
        __mmio_write64((base + i * 8) as *mut u64, 0)
        i = i + 1
    }
    // ROUND K5: IF OFF, not on. A task that has never run starts with
    // the run queue lock held -- the core that switched to it took it and
    // could not give it back, because giving it back before the switch
    // would let a third core pick up a task whose registers are not saved
    // yet. `enter_task`, the first line of every task body, gives the
    // lock back and only THEN switches interrupts on. Starting with them
    // on would let this core's own timer interrupt run into a lock this
    // core holds.
    __mmio_write64(base as *mut u64, 0x002) // rflags: IF off until enter_task
    __mmio_write64((base + 72) as *mut u64, a0) // rdi
    __mmio_write64((base + 80) as *mut u64, a1) // rsi
    __mmio_write64((base + 104) as *mut u64, a2) // rdx
    __mmio_write64((base + 128) as *mut u64, entry) // where `ret` goes
    __mmio_write64((base + 136) as *mut u64, vector(state, V_GUARD))
    return base
}

// A new task. `entry` is the address of the Firn function it starts in
// (out of the table in isr.s, because Firn cannot name the address of a
// function of its own in the kernel profile); it gets `state`, its index
// and `kind` as arguments. Returns the index, or 0 when the table is
// full -- index 0 is `kernel_main` and can never be handed out.
// ROUND K5: the stack is fetched BEFORE the run queue lock is taken, and
// that order is not cosmetic. The frame allocator has a lock of its own
// now; a core that held the run queue and then asked for a frame would be
// holding two locks in an order that another core takes the other way
// round the moment it faults in an interrupt. The rule this kernel keeps
// is the simplest one that cannot deadlock: NO LOCK IS EVER HELD WHILE
// ANOTHER IS TAKEN.
fn create(state: u64, kind: u64, prio: u64, arg: u64, entry: u64) -> u64 {
    let stack: u64 = mem.frame_run(state, KSTACK_FRAMES)
    if stack == 0 {
        return 0
    }
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    var i: u64 = 1
    var slot: u64 = 0
    while i < kstate.MAX_TASKS {
        if tget(state, i, T_STATE) == S_FREE {
            slot = i
            i = kstate.MAX_TASKS
        } else {
            i = i + 1
        }
    }
    if slot == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        free_stack(state, stack)
        return 0
    }
    let ktop: u64 = stack + KSTACK_FRAMES * mem.FRAME_SIZE
    // ROUND K1: paint it, so that afterwards it can be said how much of
    // it was ever used. `frame_build` writes over the top 136 octets of
    // this in a moment; everything below is the measurement.
    var w: u64 = stack
    while w < ktop {
        __mmio_write64(w as *mut u64, STACK_PAINT)
        w = w + 8
    }
    var real_entry: u64 = entry
    if real_entry == 0 {
        real_entry = vector(state, V_TASK_MAIN)
    }
    var j: u64 = 0
    while j < kstate.TASK_BYTES / 8 {
        __mmio_write64((task_at(state, slot) + j * 8) as *mut u64, 0)
        j = j + 1
    }
    tset(state, slot, T_PID, kstate.add(state, kstate.NEXT_PID, 1) - 1)
    tset(state, slot, T_KSTACK, stack)
    tset(state, slot, T_KTOP, ktop)
    tset(state, slot, T_PRIO, prio)
    tset(state, slot, T_BUDGET, prio)
    tset(state, slot, T_KIND, kind)
    tset(state, slot, T_ARG, arg)
    tset(state, slot, T_PARENT, current(state))
    // RUNDE K13: DIE KENNUNGEN KOMMEN VOM ELTERNTEIL, und sie kommen
    // HIER und nicht in `proc.create_bare`, weil sonst nur PROZESSE sie
    // erben wuerden. Der Satz wurde eine Schleife weiter oben genullt --
    // ohne diese vier Zeilen waere jedes Kind root, und `fork` in einer
    // Shell, die als `justin` laeuft, gaebe einen Prozess mit allen
    // Rechten. Genau das ist die Zusage, die `tools/k13/run.sh` misst:
    // die Kennung ueberlebt fork UND exec.
    let par: u64 = current(state)
    tset(state, slot, T_UID, tget(state, par, T_UID))
    tset(state, slot, T_GID, tget(state, par, T_GID))
    tset(state, slot, T_EUID, tget(state, par, T_EUID))
    tset(state, slot, T_EGID, tget(state, par, T_EGID))
    tset(state, slot, T_SUID, tget(state, par, T_SUID))
    tset(state, slot, T_SGID, tget(state, par, T_SGID))
    tset(state, slot, T_UMASK, tget(state, par, T_UMASK))
    tset(state, slot, T_CR3, kstate.get(state, kstate.KPML4))
    tset(state, slot, T_CWD, kstate.get(state, kstate.FS_ROOT))
    tset(state, slot, T_RSP, frame_build(state, ktop, real_entry, state,
            slot, kind))
    tset(state, slot, T_STATE, S_NEW)
    if slot + 1 > kstate.get(state, kstate.TASKS) {
        kstate.set(state, kstate.TASKS, slot + 1)
    }
    tc_set(state, slot, TC_CPU, kstate.MAX_CPUS)
    tc_set(state, slot, TC_MASK, 0)
    tc_set(state, slot, TC_AFF, ANY_CPU)
    clear_signals(state, slot)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return slot
}

// ROUND K9. DIE SIGNALTABELLE EINER AUFGABE, GELOESCHT.
//
// Warum das hier steht und nicht in `signal.fi`, wo es hingehoerte: die
// Tabelle muss beim ANLEGEN einer Aufgabe geloescht werden, und das
// geschieht in diesem File. `signal.fi` braucht `proc.fi` (es schreibt
// auf den Nutzerstapel), `proc.fi` braucht dieses hier -- ein `import
// signal` in `sched.fi` oder `proc.fi` waere ein Ring im Modulgraphen,
// und der Uebersetzer nimmt ihn nicht. Was hier bleibt, ist reines
// Nullen von Speicher, das keine Bedeutung kennt; die Bedeutung steht
// vollstaendig in `signal.fi`.
//
// UND ES IST KEIN SCHOENHEITSFEHLER, SONDERN DER FEHLER, DEN RUNDE K6
// SCHON EINMAL HATTE: ein Platz, den eine tote Aufgabe hinterlaesst, darf
// seiner Nachfolgerin nichts vererben. Ohne diese Zeilen erbte ein neuer
// Prozess die Behandlungsroutinen seines Vorgaengers -- Adressen in einem
// Abbild, das es nicht mehr gibt.
const SIG_SLOTS: u64 = 32
const SIG_ENTRY: u64 = 24

fn clear_signals(state: u64, i: u64) {
    if i >= kstate.MAX_TASKS {
        return
    }
    let base: u64 = state + kstate.SIG_OFF + i * (SIG_SLOTS * SIG_ENTRY)
    var k: u64 = 0
    while k < (SIG_SLOTS * SIG_ENTRY) / 8 {
        __mmio_write64((base + k * 8) as *mut u64, 0)
        k = k + 1
    }
    tset(state, i, T_SIGPEND, 0)
    tset(state, i, T_SIGMASK, 0)
    tset(state, i, T_SIGRET, 0)
    tset(state, i, T_ALARM, 0)
    tset(state, i, T_STOPSIG, 0)
    // Prozessgruppe und Sitzung sind die eigene pid, solange niemand
    // etwas anderes sagt.
    let pid: u64 = tget(state, i, T_PID)
    tset(state, i, T_PGID, pid)
    tset(state, i, T_SID, pid)
    tset(state, i, T_TGID, pid)
}

fn free_stack(state: u64, stack: u64) {
    var k: u64 = 0
    while k < KSTACK_FRAMES {
        mem.frame_free(state, stack + k * mem.FRAME_SIZE)
        k = k + 1
    }
}

// ROUND K1: the deepest this task's kernel stack has ever been, in
// octets. The paint of `create` is looked for from the LOWER end
// upwards; the first octet that is not paint any more is the deepest
// point anything ever wrote to. A task that overflowed its stack reports
// the full size -- and that is the number that has to stay below it.
fn stack_high(state: u64, i: u64) -> u64 {
    let base: u64 = tget(state, i, T_KSTACK)
    let ktop: u64 = tget(state, i, T_KTOP)
    if base == 0 || ktop <= base {
        return 0
    }
    var p: u64 = base
    while p < ktop {
        if __mmio_read64(p as *mut u64) != STACK_PAINT {
            return ktop - p
        }
        p = p + 8
    }
    return 0
}

// Now it may run. Whoever created the task decides when it is complete.
fn start(state: u64, i: u64) -> bool {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if tget(state, i, T_STATE) != S_NEW {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return false
    }
    tset(state, i, T_STATE, S_READY)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    return true
}

// The kernel stack the next system call out of ring 3 has to land on.
// Two places need it: the TSS (for interrupts) and the data area (for
// `syscall`, which the processor does not switch stacks for).
// ROUND K5: only the BOOT processor writes these two. `KSTACK_CUR` is
// read by `syscall_entry` in isr.s out of ONE fixed offset in the data
// area, and the TSS the boot processor loaded is its own -- a started
// core has a TSS of its own and never leaves ring 0 in this round. A core
// that wrote its kernel task's stack into that word would send the next
// system call of a ring 3 process onto a stack somebody else is standing
// on.
fn set_kernel_stack(state: u64, ktop: u64) {
    if cpu.here(state) != 0 {
        return
    }
    kstate.set(state, kstate.KSTACK_CUR, ktop)
    let tss: u64 = kstate.get(state, kstate.TSS)
    if tss != 0 {
        __mmio_write64((tss + 4) as *mut u64, ktop)
    }
}

// The first line of every task body (`tasks.main`, `proc.user_start`).
// See `frame_build`: the lock comes from the core that started this task.
fn enter_task(state: u64) {
    atomic.lock_give(state, atomic.L_SCHED)
    asm("sti")
}

// -------------------------------------------------------- the decision

fn ready_count(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if tget(state, i, T_KIND) != K_IDLE && tget(state, i, T_STATE) == S_READY {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// How many corpses of a kind are lying about. The boot processor waits on
// this while the other cores work the tasks off.
fn zombies(state: u64, kind: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        if tget(state, i, T_KIND) == kind && tget(state, i, T_STATE) == S_ZOMBIE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

fn reap_all(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 1
    var c: u64 = 0
    while i < n {
        if reap(state, i) {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// Everything that is not free and not a corpse.
fn alive_count(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    var c: u64 = 0
    while i < n {
        let st: u64 = tget(state, i, T_STATE)
        if st != S_FREE && st != S_ZOMBIE {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// Round robin: from the current task onwards, the first ready one. The
// idle task is skipped -- it only gets the processor when nobody else
// wants it.
// ROUND K5: two changes, both forced by the second core. EVERY idle task
// is skipped, not only the one whose index stood in `kstate.IDLE` -- each
// core has one now. And what is returned when nothing is ready is THIS
// core's idle task, not the boot processor's; two cores on one idle task
// would be two cores on one stack.
//
// Only the caller of this function under the run queue lock may act on
// the answer. A task that is S_READY here is claimed by the caller before
// the lock is given up, which is what keeps two cores from taking it.
fn pick(state: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    let cur: u64 = current(state)
    let me: u64 = cpu.here(state)
    let myidle: u64 = cpu.get(state, me, cpu.C_IDLE)
    var k: u64 = 1
    while k <= n {
        let i: u64 = (cur + k) % n
        if tget(state, i, T_KIND) != K_IDLE && tget(state, i, T_STATE) == S_READY
        && may_run(state, i, me) {
            return i
        }
        k = k + 1
    }
    if tget(state, cur, T_STATE) == S_RUN {
        return cur
    }
    return myidle
}

// The switch itself. Everything that is per task and lives outside the
// task record is put in place here: the address space, the kernel stack
// for the next entry out of ring 3 -- and only then the stack pointer.
fn switch_to(state: u64, from: u64, to: u64) {
    let me: u64 = cpu.here(state)
    cpu.set(state, me, cpu.C_CUR, to)
    cpu.add(state, me, cpu.C_SWITCHES, 1)
    if tget(state, to, T_KIND) != K_IDLE {
        cpu.add(state, me, cpu.C_PICKS, 1)
    }
    tc_set(state, to, TC_CPU, me)
    tc_set(state, to, TC_MASK, tc_get(state, to, TC_MASK) | (1 << me))
    kstate.add(state, kstate.SWITCHES, 1)
    tset(state, to, T_RUNS, tget(state, to, T_RUNS) + 1)
    trace_push(state, tget(state, to, T_PID))
    let cr3: u64 = tget(state, to, T_CR3)
    if cr3 != 0 {
        let now: u64 = asm("mov rax, cr3", out("rax"))
        if cr3 != now {
            asm("mov cr3, rax", in("rax") cr3, clobber("memory"))
        }
    }
    set_kernel_stack(state, tget(state, to, T_KTOP))
    asm("call rax", in("rax") vector(state, V_SWITCH),
        in("rdi") task_at(state, from) + T_RSP,
        in("rsi") tget(state, to, T_RSP), clobber("memory"))
}

// Give the processor away. Comes back when this task is scheduled again
// -- or never, if it is a corpse by then.
//
// ROUND K5, AND THIS IS THE HEART OF IT. The run queue lock is taken here
// and is NOT given back here: it is given back by whoever the processor
// switches TO, in that task's own `schedule_locked` right after its
// `switch_to` came back, or -- for a task that has never run -- in
// `enter_task`, its first line.
//
// The reason is one race and there is no cheaper cure. If the lock were
// given back before `switch_to`, another core could pick up the task this
// core has just marked S_READY -- while this core is still executing on
// that task's stack, inside `context_switch`, with its registers not yet
// written down. Two cores, one stack. Holding the lock across the switch
// means: while any core is between "I have chosen" and "the registers are
// saved", no other core is choosing anything.
fn schedule(state: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    schedule_locked(state)
    irq_restore(flags)
}

// The run queue lock must be held. On return it is held again -- by this
// task, on whichever core resumed it.
fn schedule_locked(state: u64) {
    let cur: u64 = current(state)
    let next: u64 = pick(state)
    if next == cur {
        tset(state, cur, T_BUDGET, tget(state, cur, T_PRIO))
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    if tget(state, cur, T_STATE) == S_RUN {
        tset(state, cur, T_STATE, S_READY)
    }
    tset(state, next, T_STATE, S_RUN)
    tset(state, next, T_BUDGET, tget(state, next, T_PRIO))
    switch_to(state, cur, next)
    atomic.lock_give(state, atomic.L_SCHED)
}

fn yield_now(state: u64) {
    schedule(state)
}

// --------------------------------------------------------- the timer

// Called out of the interrupt handler, after the end-of-interrupt. Two
// jobs: wake what is due, and take the processor away when the turn is
// over.
// Called out of the interrupt handler, on EVERY core, with interrupts
// already off -- which is why the lock may be taken here at all.
fn on_tick(state: u64) {
    let me: u64 = cpu.here(state)
    cpu.add(state, me, cpu.C_TICKS, 1)
    atomic.lock_take(state, atomic.L_SCHED, me)
    let now: u64 = kstate.get(state, kstate.TICKS)
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) == S_SLEEP && tget(state, i, T_WAKE) <= now {
            tset(state, i, T_STATE, S_READY)
        }
        i = i + 1
    }
    let cur: u64 = current(state)
    tset(state, cur, T_TICKS, tget(state, cur, T_TICKS) + 1)
    if kstate.get(state, kstate.PREEMPT) == 0 {
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    let budget: u64 = tget(state, cur, T_BUDGET)
    if budget > 1 {
        tset(state, cur, T_BUDGET, budget - 1)
        atomic.lock_give(state, atomic.L_SCHED)
        return
    }
    tset(state, cur, T_BUDGET, 0)
    schedule_locked(state)
}

// ---------------------------------------------------------- blocking

// `ticks` timer ticks, 10 ms each at 100 Hz. Zero is a yield.
fn sleep_ticks(state: u64, ticks: u64) {
    if ticks == 0 {
        yield_now(state)
        return
    }
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    tset(state, cur, T_WAKE, kstate.get(state, kstate.TICKS) + ticks)
    tset(state, cur, T_STATE, S_SLEEP)
    schedule_locked(state)
    irq_restore(flags)
}

// Whoever waits for this pid becomes ready again.
fn wake_pid(state: u64, pid: u64) {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) == S_WAIT {
            let w: u64 = tget(state, i, T_WAITPID)
            if w == 0 || w == pid {
                tset(state, i, T_STATE, S_READY)
            }
        }
        i = i + 1
    }
}

fn find_pid(state: u64, pid: u64) -> u64 {
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) != S_FREE && tget(state, i, T_PID) == pid {
            return i
        }
        i = i + 1
    }
    return kstate.MAX_TASKS
}

// ------------------------------------------------------------ the end

// A task ends. It stays in the table as a corpse until its creator picks
// up the exit code -- otherwise `wait` would have nothing left to read.
// Its kernel stack is the one this function is standing on and is
// therefore NOT freed here; that happens in the reaper.
fn exit_task(state: u64, code: u64) {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    let cur: u64 = current(state)
    tset(state, cur, T_EXIT, code)
    tset(state, cur, T_END, kstate.get(state, kstate.TICKS))
    tset(state, cur, T_STATE, S_ZOMBIE)
    reparent(state, cur)
    wake_pid(state, tget(state, cur, T_PID))
    schedule_locked(state)
    irq_restore(flags)
    // The scheduler never comes back to a corpse. If it does, something
    // is broken enough that going on would be worse.
    while true {
        asm("hlt")
    }
}

// RUNDE K13: DIE WAISEN. Stirbt ein Prozess, der noch Kinder hat, so
// hatten diese Kinder bis zu dieser Runde einen Elternteil, dessen Platz
// gleich wieder vergeben wird -- ihr `T_PARENT` zeigte danach auf einen
// fremden Prozess, und beim Sterben fand sie niemand mehr: sie blieben
// als Leichen in der Tafel stehen, bis der Lauf endete. GENAU DAS ist die
// Zahl, die die Gegenprobe dieser Runde misst (`zombie` ohne init).
//
// Von hier an fallen sie an den Prozess 1, wie in jedem Unix. Der Platz
// steht in `kstate.K13_OFF + U_INITSLOT`, um eins erhoeht, damit die Null
// weiter "es gibt keinen" heisst -- ohne init aendert sich also nichts,
// und das ist der Sinn: die Gegenprobe soll ohne init zusammenbrechen.
//
// Steht unter der Laufliste-Sperre, weil der Aufrufer sie haelt. Es wird
// nur ein Wort je Kind geschrieben, kein Zustand veraendert und keine
// zweite Sperre genommen.
fn reparent(state: u64, dying: u64) {
    let slot: u64 = kstate.get(state, kstate.K13_OFF + kstate.U_INITSLOT)
    if slot == 0 {
        return
    }
    let init: u64 = slot - 1
    if init == dying {
        return
    }
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) != S_FREE {
            if tget(state, i, T_PARENT) == dying && i != dying {
                tset(state, i, T_PARENT, init)
                kstate.add(state, kstate.K13_OFF + kstate.U_ORPHANS, 1)
            }
        }
        i = i + 1
    }
}

// The corpse is cleared away: its kernel stack goes back to the frame
// allocator, its slot into the table. Whoever calls this must have picked
// up the exit code beforehand -- and must not be standing on that stack,
// which is why a task can never reap itself.
// ROUND K5: the slot is released under the run queue lock, the FRAMES
// are given back afterwards, outside it. Same rule as in `create` and for
// the same reason -- the two locks of this kernel are never nested.
fn reap(state: u64, i: u64) -> bool {
    let flags: u64 = irq_save()
    atomic.lock_take(state, atomic.L_SCHED, cpu.here(state))
    if tget(state, i, T_STATE) != S_ZOMBIE || i == current(state) {
        atomic.lock_give(state, atomic.L_SCHED)
        irq_restore(flags)
        return false
    }
    let stack: u64 = tget(state, i, T_KSTACK)
    tset(state, i, T_KSTACK, 0)
    tset(state, i, T_STATE, S_FREE)
    atomic.lock_give(state, atomic.L_SCHED)
    irq_restore(flags)
    if stack != 0 {
        free_stack(state, stack)
    }
    return true
}

// A fault in ring 3 kills the process, not the kernel. This is the point
// at which an operating system differs from the kernel of round 59: there
// the machine stopped at every exception, and rightly so -- there was
// nobody else the fault could belong to.
fn kill_current(state: u64, pid_vector: u64, err: u64, cr2: u64, rip: u64) {
    var s_kill: [u8; 13] = "user fault: \0"
    var s_pid: [u8; 6] = "pid=\0\0"
    var s_vec: [u8; 10] = "  vector=\0"
    var s_err: [u8; 7] = "  err=\0"
    var s_cr2: [u8; 7] = "  cr2=\0"
    var s_rip: [u8; 7] = "  rip=\0"
    var s_dead: [u8; 20] = "  -- process killed\0"
    let cur: u64 = current(state)
    serial.puts((&s_kill[0]) as u64)
    serial.puts((&s_pid[0]) as u64)
    serial.dec(tget(state, cur, T_PID))
    serial.puts((&s_vec[0]) as u64)
    serial.dec(pid_vector)
    serial.puts((&s_err[0]) as u64)
    serial.hex(err)
    serial.puts((&s_cr2[0]) as u64)
    serial.hex(cr2)
    serial.puts((&s_rip[0]) as u64)
    serial.hex(rip)
    serial.puts((&s_dead[0]) as u64)
    serial.nl()
    kstate.add(state, kstate.KILLED, 1)
    tset(state, cur, T_FAULTS, tget(state, cur, T_FAULTS) + 1)
    // 128 + vector, the way a system with signals would count it.
    exit_task(state, 128 + pid_vector)
}

// ------------------------------------------------------------ the view

fn dump_tasks(state: u64) {
    var s_row: [u8; 7] = "task: \0"
    var s_pid: [u8; 5] = "pid=\0"
    var s_kind: [u8; 8] = "  kind=\0"
    var s_prio: [u8; 8] = "  prio=\0"
    var s_state: [u8; 9] = "  state=\0"
    var s_runs: [u8; 8] = "  runs=\0"
    var s_ticks: [u8; 9] = "  ticks=\0"
    var s_work: [u8; 8] = "  work=\0"
    var s_end: [u8; 7] = "  end=\0"
    var s_exit: [u8; 8] = "  exit=\0"
    let n: u64 = kstate.get(state, kstate.TASKS)
    var i: u64 = 0
    while i < n {
        if tget(state, i, T_STATE) != S_FREE {
            serial.puts((&s_row[0]) as u64)
            serial.puts((&s_pid[0]) as u64)
            serial.dec(tget(state, i, T_PID))
            serial.puts((&s_kind[0]) as u64)
            serial.dec(tget(state, i, T_KIND))
            serial.puts((&s_prio[0]) as u64)
            serial.dec(tget(state, i, T_PRIO))
            serial.puts((&s_state[0]) as u64)
            serial.dec(tget(state, i, T_STATE))
            serial.puts((&s_runs[0]) as u64)
            serial.dec(tget(state, i, T_RUNS))
            serial.puts((&s_ticks[0]) as u64)
            serial.dec(tget(state, i, T_TICKS))
            serial.puts((&s_work[0]) as u64)
            serial.dec(tget(state, i, T_WORK))
            serial.puts((&s_end[0]) as u64)
            serial.dec(tget(state, i, T_END))
            serial.puts((&s_exit[0]) as u64)
            serial.dec(tget(state, i, T_EXIT))
            serial.nl()
        }
        i = i + 1
    }
}
