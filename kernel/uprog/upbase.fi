profile kernel

const SYS_WRITE: u64 = 1

const SYS_OPEN: u64 = 2

const SYS_CLOSE: u64 = 3

const SYS_GETPID: u64 = 39

const SYS_YIELD: u64 = 24

const SYS_WAIT4: u64 = 61

const SYS_EXIT: u64 = 60

// The two Osum has of its own: a program that travels in the kernel image
// has no file, so no `execve` can start it.
const SYS_SPAWN: u64 = 1000

const SYS_FORK: u64 = 57

const SYS_UMASK: u64 = 95

const SYS_MMAP: u64 = 9

const CAP_DUP: u64 = 2004

const E_BADHANDLE: u64 = 1

const E_RIGHTS: u64 = 2

const R_READ: u64 = 1

const R_WRITE: u64 = 2

// ROUNDE K7
const PROT_READ: u64 = 1

const PROT_WRITE: u64 = 2

// The private page every process has at the same address and on a frame
// of its own (proc.fi).
const USER_DATA: u64 = 0x40000000

const P_CHILD: u64 = 5

const P_FORKCHILD: u64 = 11
