// RUNDE K18: die Energieschicht (kernel/sys.fi, Vorrat 1750..1799).
const SYS_OSUM_PWRGET: u64 = 1750

const SYS_OSUM_PWRSET: u64 = 1751

const SYS_GETUID: u64 = 102

const SYS_GETGID: u64 = 104

const SYS_SETUID: u64 = 105

const SYS_SETGID: u64 = 106

const SYS_GETEUID: u64 = 107

const SYS_GETEGID: u64 = 108

const SYS_SETRESUID: u64 = 117

const SYS_GETRESUID: u64 = 118

const R_DUPLICATE: u64 = 8

const R_INSPECT: u64 = 32

const R_MANAGE: u64 = 64

const SYS_VM_CREATE: u64 = 1500

const SYS_VM_RUN: u64 = 1501

const SYS_VM_STAT: u64 = 1502

const SYS_VM_KILL: u64 = 1503

const SYS_VM_VALUE: u64 = 1504

const G_HELLO: u64 = 0

const E_WRONGTYPE: u64 = 6

const MAP_ANONYMOUS: u64 = 32

const MAP_PRIVATE: u64 = 2

// The programs. The number arrives in the upper half of the first
// argument, whatever the creator wanted to say in the lower half.
const P_HELLO: u64 = 1

const P_MEMORY: u64 = 2

const P_FAULT: u64 = 3

const P_BADPTR: u64 = 4

const P_PARENT: u64 = 6

const P_SHELL: u64 = 8

const P_STEAL: u64 = 9

const P_FORK: u64 = 10

const P_CAPS: u64 = 12

const P_FB: u64 = 13

const P_HV: u64 = 15

const P_WCLICK: u64 = 14

const P_USER: u64 = 16

const P_ZOMBIE: u64 = 17

const P_PWR: u64 = 45

const P_PWRIDLE: u64 = 46

const P_PWRLOAD: u64 = 47

const P_HBENCH: u64 = 49

const P_HANDLE: u64 = 48

const P_ASYNC: u64 = 50

const P_ABENCH: u64 = 51

const P_ASYNCFS: u64 = 52

const P_VEC: u64 = 53

const P_HOG: u64 = 66 // K-002: 64/65 sind P_SCHLAF/P_WACH

const P_HOGWRITE: u64 = 67

const P_BURN: u64 = 68

// ==================================================== RUNDE SYSTEMBUS
const P_BUSA: u64 = 60

const P_BUSB: u64 = 61

const P_BUSD: u64 = 62

const P_BUSS: u64 = 63

//     summe = summe + schritt,  schritt = schritt + 1
const P_SCHLAF: u64 = 64

const P_WACH: u64 = 65

const SYS_OSUM_BUS: u64 = 1960

const SYS_CLOCK_GETTIME: u64 = 228

const BUS_REG: u64 = 1

const BUS_FIND: u64 = 2

const BUS_SEND: u64 = 3

const BUS_RECV: u64 = 4

const BUS_SEGNEW: u64 = 7

const BUS_SEGMAP: u64 = 8

const BUS_SEGDROP: u64 = 9

const BUS_CLIPSET: u64 = 10

const BUS_CLIPGET: u64 = 11

const BT_TEXT: u64 = 1

const BA_ANY: u64 = 0

const BA_ROOT: u64 = 2

const RUNDEN: u64 = 100

const P_FUZZ: u64 = 54

fn u_enter(packed: u64) {
    let prog: u64 = packed >> 32
    let arg: u64 = packed & 0xFFFFFFFF
    if prog == P_HELLO {
        upbench.u_hello(arg)
    }
    if prog == P_FUZZ {
        upbench.u_fuzz(arg)
    }
    if prog == P_MEMORY {
        upbench.u_memory(arg)
    }
    if prog == P_SCHLAF {
        upbench.u_schlaf(arg)
    }
    if prog == P_WACH {
        upbench.u_wach(arg)
    }
    if prog == P_BURN {
        upbench.u_burn(arg)
    }
    if prog == P_FAULT {
        upbench.u_fault(arg)
    }
    if prog == P_BADPTR {
        upbench.u_badptr(arg)
    }
    if prog == upbase.P_CHILD {
        upbench.u_child(arg)
    }
    if prog == P_PARENT {
        upbench.u_parent(arg)
    }
    if prog == P_STEAL {
        upbench.u_steal(arg)
    }
    if prog == P_SHELL {
        upbench.u_shell(arg)
    }
    if prog == P_FORK {
        upbench.u_fork(arg)
    }
    if prog == upbase.P_FORKCHILD {
        upbench.u_forkchild(arg)
    }
    if prog == P_CAPS {
        upbench.u_caps(arg)
    }
    if prog == P_FB {
        upbench.u_fb(arg)
    }
    if prog == P_HV {
        u_hv(arg)
    }
    if prog == P_WCLICK {
        upbench.u_wclick(arg)
    }
    if prog == P_USER {
        u_user(arg)
    }
    if prog == P_ZOMBIE {
        u_zombie(arg)
    }
    if prog == P_PWR {
        u_pwr(arg)
    }
    if prog == P_PWRIDLE {
        u_pwridle(arg)
    }
    if prog == P_PWRLOAD {
        u_pwrload(arg)
    }
    if prog == P_HBENCH {
        upbench.u_hbench(arg)
    }
    if prog == P_HANDLE {
        upbench.u_handle(arg)
    }
    if prog == P_ASYNC {
        upbench.u_async(arg)
    }
    if prog == P_ABENCH {
        upbench.u_abench(arg)
    }
    if prog == P_ASYNCFS {
        upbench.u_asyncfs(arg)
    }
    if prog == P_VEC {
        u_vec(arg)
    }
    if prog == P_HOG {
        u_hog(arg)
    }
    if prog == P_HOGWRITE {
        u_hogwrite(arg)
    }
    if prog == P_BUSA {
        u_busa(arg)
    }
    if prog == P_BUSB {
        u_busb(arg)
    }
    if prog == P_BUSD {
        u_busd(arg)
    }
    if prog == P_BUSS {
        u_buss(arg)
    }
    upbench.u_sys(upbase.SYS_EXIT, 0, 0, 0)
    while true {
    }
}

fn u_hv(arg: u64) {
    var s_head: [u8; 22] = "hvuser: ring 3 begin\n\0"
    var s_h: [u8; 16] = "hvuser: handle=\0"
    var s_run: [u8; 13] = "hvuser: run=\0"
    var s_st: [u8; 15] = "hvuser: state=\0"
    var s_ex: [u8; 15] = "hvuser: exits=\0"
    var s_res: [u8; 16] = "hvuser: result=\0"
    var s_val: [u8; 15] = "hvuser: value=\0"
    var s_tail: [u8; 9] = "hvuser: \0"
    var s_of: [u8; 6] = " / 14\0"
    var nl: [u8; 2] = "\n\0"
    var w: [u64; 5] = [0 as u64; 5]
    var gut: u64 = 0

    upbench.u_say((&s_head[0]) as u64)

    let every: u64 = upbase.R_READ | upbase.R_WRITE | R_INSPECT | R_MANAGE | R_DUPLICATE
    let h: u64 = upbench.u_sys(SYS_VM_CREATE, G_HELLO, every, 0)
    upbench.u_say((&s_h[0]) as u64)
    upbench.u_say_num(h)
    upbench.u_say((&nl[0]) as u64)
    if upbench.hv_err(h) {
        upbench.u_say((&s_tail[0]) as u64)
        upbench.u_say_num(0)
        upbench.u_say((&s_of[0]) as u64)
        upbench.u_say((&nl[0]) as u64)
        upbench.u_sys(upbase.SYS_EXIT, 14, 0, 0)
        return
    }
    gut = gut + 1

    if upbench.u_sys(SYS_VM_STAT, h, (&w[0]) as u64, 0) == 0 {
        if w[0] == 1 && w[1] == 0 && w[3] == G_HELLO {
            gut = gut + 1
        }
    }

    let small: u64 = upbench.u_sys(upbase.CAP_DUP, h, upbase.R_READ | upbase.R_WRITE | R_INSPECT, 0)
    if !upbench.hv_err(small) {
        gut = gut + 1
    }

    let r: u64 = upbench.u_sys(SYS_VM_RUN, small, 0, 0)
    upbench.u_say((&s_run[0]) as u64)
    upbench.u_say_num(r)
    upbench.u_say((&nl[0]) as u64)
    if r == 2 {
        gut = gut + 1
    }

    // 5. bis 7. WAS DABEI HERAUSKAM.
    upbench.u_sys(SYS_VM_STAT, h, (&w[0]) as u64, 0)
    upbench.u_say((&s_st[0]) as u64)
    upbench.u_say_num(w[0])
    upbench.u_say((&nl[0]) as u64)
    upbench.u_say((&s_ex[0]) as u64)
    upbench.u_say_num(w[1])
    upbench.u_say((&nl[0]) as u64)
    upbench.u_say((&s_res[0]) as u64)
    upbench.u_say_num(w[2])
    upbench.u_say((&nl[0]) as u64)
    if w[1] > 10 {
        gut = gut + 1
    }
    if w[2] == 4660 { // 0x1234
        gut = gut + 1
    }
    let v: u64 = upbench.u_sys(SYS_VM_VALUE, h, 3, 0)
    upbench.u_say((&s_val[0]) as u64)
    upbench.u_say_num(v)
    upbench.u_say((&nl[0]) as u64)
    if v == 23130 { // 0x5A5A
        gut = gut + 1
    }

    if upbench.u_sys(SYS_VM_RUN, h + 0x100000000, 0, 0) == 0 -% upbase.E_BADHANDLE {
        gut = gut + 1
    }
    if upbench.u_sys(SYS_VM_RUN, 0, 0, 0) == 0 -% upbase.E_BADHANDLE {
        gut = gut + 1
    }
    let konsole: u64 = (arg << 32) | 1
    if upbench.u_sys(SYS_VM_RUN, konsole, 0, 0) == 0 -% E_WRONGTYPE {
        gut = gut + 1
    }
    if upbench.u_sys(SYS_VM_RUN, small, 0, 0) == 6 {
        gut = gut + 1
    }

    if upbench.u_sys(SYS_VM_KILL, small, 0, 0) == 0 -% upbase.E_RIGHTS {
        gut = gut + 1
    }
    if upbench.u_sys(SYS_VM_KILL, h, 0, 0) == 0 {
        gut = gut + 1
    }
    if upbench.u_sys(SYS_VM_RUN, h, 0, 0) == 0 -% upbase.E_BADHANDLE {
        gut = gut + 1
    }

    upbench.u_say((&s_tail[0]) as u64)
    upbench.u_say_num(gut)
    upbench.u_say((&s_of[0]) as u64)
    upbench.u_say((&nl[0]) as u64)
    upbench.u_sys(upbase.SYS_EXIT, 14 - gut, 0, 0)
}

// ==================================================== RUNDE K13, RING 3
fn u_user(arg: u64) {
    var s_uid: [u8; 12] = "k13u: uid=\0\0"
    var s_euid: [u8; 13] = "k13u: euid=\0\0"
    var s_gid: [u8; 12] = "k13u: gid=\0\0"
    var s_egid: [u8; 13] = "k13u: egid=\0\0"
    var s_um0: [u8; 15] = "k13u: umask0=\0\0"
    var s_um1: [u8; 15] = "k13u: umask1=\0\0"
    var s_dr: [u8; 15] = "k13u: dropeu=\0\0"
    var s_bk: [u8; 15] = "k13u: backeu=\0\0"
    var s_su: [u8; 15] = "k13u: setuid=\0\0"
    var s_ru: [u8; 15] = "k13u: reroot=\0\0"
    var s_ch: [u8; 15] = "k13u: childu=\0\0"
    var s_r: [u8; 11] = "k13u: r=\0\0\0"
    var s_e: [u8; 11] = "k13u: e=\0\0\0"
    var s_s: [u8; 11] = "k13u: s=\0\0\0"
    var s_done: [u8; 11] = "k13u: done\0"

    upbench.u_say_line((&s_uid[0]) as u64, upbench.u_sys(SYS_GETUID, 0, 0, 0))
    upbench.u_say_line((&s_euid[0]) as u64, upbench.u_sys(SYS_GETEUID, 0, 0, 0))
    upbench.u_say_line((&s_gid[0]) as u64, upbench.u_sys(SYS_GETGID, 0, 0, 0))
    upbench.u_say_line((&s_egid[0]) as u64, upbench.u_sys(SYS_GETEGID, 0, 0, 0))

    upbench.u_say_line((&s_um0[0]) as u64, upbench.u_sys(upbase.SYS_UMASK, 18, 0, 0))
    upbench.u_say_line((&s_um1[0]) as u64, upbench.u_sys(upbase.SYS_UMASK, 18, 0, 0))

    upbench.u_sys6(SYS_SETRESUID, 0 -% 1, 7, 0 -% 1, 0, 0, 0)
    upbench.u_say_line((&s_dr[0]) as u64, upbench.u_sys(SYS_GETEUID, 0, 0, 0))
    upbench.u_sys6(SYS_SETRESUID, 0 -% 1, 0, 0 -% 1, 0, 0, 0)
    upbench.u_say_line((&s_bk[0]) as u64, upbench.u_sys(SYS_GETEUID, 0, 0, 0))

    upbench.u_sys(SYS_SETGID, 5, 0, 0)
    upbench.u_say_line((&s_su[0]) as u64, upbench.u_sys(SYS_SETUID, 7, 0, 0))
    upbench.u_say_line((&s_uid[0]) as u64, upbench.u_sys(SYS_GETUID, 0, 0, 0))
    upbench.u_say_line((&s_gid[0]) as u64, upbench.u_sys(SYS_GETGID, 0, 0, 0))
    upbench.u_say_line((&s_ru[0]) as u64, upbench.u_sys(SYS_SETUID, 0, 0, 0))

    var three: [u64; 3] = [0 as u64; 3]
    upbench.u_sys(SYS_GETRESUID, (&three[0]) as u64, (&three[1]) as u64,
        (&three[2]) as u64)
    upbench.u_say_line((&s_r[0]) as u64, three[0 as usize] & 0xFFFFFFFF)
    upbench.u_say_line((&s_e[0]) as u64, three[1 as usize] & 0xFFFFFFFF)
    upbench.u_say_line((&s_s[0]) as u64, three[2 as usize] & 0xFFFFFFFF)

    let kid: u64 = upbench.u_sys(upbase.SYS_FORK, 0, 0, 0)
    if kid == 0 {
        upbench.u_sys(upbase.SYS_EXIT, upbench.u_sys(SYS_GETUID, 0, 0, 0), 0, 0)
    }
    var st: [u64; 1] = [0 as u64; 1]
    upbench.u_sys(upbase.SYS_WAIT4, kid, (&st[0]) as u64, 0)
    upbench.u_say_line((&s_ch[0]) as u64, (st[0 as usize] >> 8) & 255)

    upbench.u_say((&s_done[0]) as u64)
    var nl: [u8; 2] = "\n\0"
    upbench.u_say((&nl[0]) as u64)
    upbench.u_sys(upbase.SYS_EXIT, 0, 0, 0)
}

fn u_zombie(arg: u64) {
    var s_kid: [u8; 12] = "k13z: kid=\0\0"
    var s_bye: [u8; 11] = "k13z: bye\0\0"
    let kid: u64 = upbench.u_sys(upbase.SYS_FORK, 0, 0, 0)
    if kid == 0 {
        upbench.u_sleep(0, 200)
        upbench.u_sys(upbase.SYS_EXIT, 3, 0, 0)
    }
    upbench.u_say_line((&s_kid[0]) as u64, kid)
    upbench.u_say((&s_bye[0]) as u64)
    var nl: [u8; 2] = "\n\0"
    upbench.u_say((&nl[0]) as u64)
    upbench.u_sys(upbase.SYS_EXIT, 0, 0, 0)
}

// ==================================================== RUNDE K18

const PG_PROFILE: u64 = 1

const PG_CAPS: u64 = 2

const PG_RATIOS: u64 = 3

const PG_RATIOSRC: u64 = 4

const PG_PERFCTL: u64 = 5

const PG_PERFBACK: u64 = 6

const PG_HWPREQ: u64 = 7

const PG_MISC: u64 = 9

const PG_MISCBACK: u64 = 10

const PG_MISCORIG: u64 = 11

const PG_CSTATE: u64 = 12

const PG_MWAITS: u64 = 13

const PG_HLTS: u64 = 14

const PG_IDLERUNS: u64 = 15

const PG_TEMP: u64 = 16

const PG_TEMPOK: u64 = 17

const PG_THROTTLES: u64 = 19

const PG_THROTTLED: u64 = 20

const PG_APPLIES: u64 = 21

const PG_SWITCHES: u64 = 22

const PG_MWAITHINT: u64 = 23

const PG_BATPRESENT: u64 = 24

const PG_BATPERCENT: u64 = 25

const PG_BATMINUTES: u64 = 26

const PG_BATSTATE: u64 = 27

const PG_BATRATE: u64 = 28

const PG_BATREMAIN: u64 = 29

const PG_BATFULL: u64 = 30

const PG_ACOK: u64 = 33

const PG_AC: u64 = 34

const PG_BATWHY: u64 = 35

const PG_TABLES: u64 = 36

const PG_TZRAW: u64 = 37

const PS_PROFILE: u64 = 0

fn u_k18(name: u64, v: u64) {
    var head: [u8; 7] = "k18: \0\0"
    var mid: [u8; 4] = " = \0"
    upbench.u_say((&head[0]) as u64)
    upbench.u_say(name)
    upbench.u_say((&mid[0]) as u64)
    upbench.u_say_num(v)
    var nl: [u8; 2] = "\n\0"
    upbench.u_say((&nl[0]) as u64)
}

fn u_get(field: u64) -> u64 {
    return upbench.u_sys(SYS_OSUM_PWRGET, field, 0, 0)
}

fn u_pwr(arg: u64) {
    var n_caps: [u8; 5] = "caps\0"
    var n_rat: [u8; 7] = "ratios\0"
    var n_rsrc: [u8; 9] = "ratiosrc\0"
    var n_cst: [u8; 7] = "cstate\0"
    var n_orig: [u8; 9] = "miscorig\0"
    var n_tab: [u8; 7] = "tables\0"
    var n_bp: [u8; 11] = "batpresent\0"
    var n_bw: [u8; 7] = "batwhy\0"
    var n_pc: [u8; 8] = "percent\0"
    var n_mi: [u8; 8] = "minutes\0"
    var n_bs: [u8; 9] = "batstate\0"
    var n_br: [u8; 8] = "batrate\0"
    var n_bre: [u8; 10] = "batremain\0"
    var n_bf: [u8; 8] = "batfull\0"
    var n_ao: [u8; 6] = "acok\0\0"
    var n_ac: [u8; 3] = "ac\0"
    var n_tp: [u8; 5] = "temp\0"
    var n_to: [u8; 7] = "tempok\0"
    var n_tz: [u8; 6] = "tzraw\0"
    var n_th: [u8; 10] = "throttles\0"
    var n_td: [u8; 10] = "throttled\0"
    var n_ap: [u8; 8] = "applies\0"
    var n_sw: [u8; 9] = "switches\0"
    var n_end: [u8; 4] = "end\0"

    u_k18((&n_caps[0]) as u64, u_get(PG_CAPS))
    u_k18((&n_rat[0]) as u64, u_get(PG_RATIOS))
    u_k18((&n_rsrc[0]) as u64, u_get(PG_RATIOSRC))
    u_k18((&n_cst[0]) as u64, u_get(PG_CSTATE))
    u_k18((&n_orig[0]) as u64, u_get(PG_MISCORIG))
    u_k18((&n_tab[0]) as u64, u_get(PG_TABLES))

    prof_round(0)
    prof_round(1)
    prof_round(2)
    upbench.u_sys(SYS_OSUM_PWRSET, PS_PROFILE, 1, 0)

    u_k18((&n_bp[0]) as u64, u_get(PG_BATPRESENT))
    u_k18((&n_bw[0]) as u64, u_get(PG_BATWHY))
    u_k18((&n_pc[0]) as u64, u_get(PG_BATPERCENT))
    u_k18((&n_mi[0]) as u64, u_get(PG_BATMINUTES))
    u_k18((&n_bs[0]) as u64, u_get(PG_BATSTATE))
    u_k18((&n_br[0]) as u64, u_get(PG_BATRATE))
    u_k18((&n_bre[0]) as u64, u_get(PG_BATREMAIN))
    u_k18((&n_bf[0]) as u64, u_get(PG_BATFULL))
    u_k18((&n_ao[0]) as u64, u_get(PG_ACOK))
    u_k18((&n_ac[0]) as u64, u_get(PG_AC))
    u_k18((&n_tp[0]) as u64, u_get(PG_TEMP))
    u_k18((&n_to[0]) as u64, u_get(PG_TEMPOK))
    u_k18((&n_tz[0]) as u64, u_get(PG_TZRAW))
    u_k18((&n_th[0]) as u64, u_get(PG_THROTTLES))
    u_k18((&n_td[0]) as u64, u_get(PG_THROTTLED))
    u_k18((&n_ap[0]) as u64, u_get(PG_APPLIES))
    u_k18((&n_sw[0]) as u64, u_get(PG_SWITCHES))

    var n_m0: [u8; 8] = "mwaits0\0"
    var n_h0: [u8; 7] = "hlts0\0\0"
    var n_i0: [u8; 10] = "idleruns0\0"
    var n_m1: [u8; 8] = "mwaits1\0"
    var n_h1: [u8; 7] = "hlts1\0\0"
    var n_i1: [u8; 10] = "idleruns1\0"
    var n_hint: [u8; 10] = "mwaithint\0"
    u_k18((&n_m0[0]) as u64, u_get(PG_MWAITS))
    u_k18((&n_h0[0]) as u64, u_get(PG_HLTS))
    u_k18((&n_i0[0]) as u64, u_get(PG_IDLERUNS))
    upbench.u_sleep(0, 600)
    u_k18((&n_m1[0]) as u64, u_get(PG_MWAITS))
    u_k18((&n_h1[0]) as u64, u_get(PG_HLTS))
    u_k18((&n_i1[0]) as u64, u_get(PG_IDLERUNS))
    u_k18((&n_hint[0]) as u64, u_get(PG_MWAITHINT))

    u_k18((&n_end[0]) as u64, arg)
    upbench.u_sys(upbase.SYS_EXIT, 0, 0, 0)
}

fn prof_round(p: u64) {
    var n_set: [u8; 8] = "setrc$\0\0"
    var n_pr: [u8; 7] = "prof$\0\0"
    var n_pc: [u8; 10] = "perfctl$\0\0"
    var n_pb: [u8; 11] = "perfback$\0\0"
    var n_mi: [u8; 7] = "misc$\0\0"
    var n_mb: [u8; 11] = "miscback$\0\0"
    var n_hw: [u8; 9] = "hwpreq$\0\0"
    stamp((&n_set[0]) as u64, p)
    stamp((&n_pr[0]) as u64, p)
    stamp((&n_pc[0]) as u64, p)
    stamp((&n_pb[0]) as u64, p)
    stamp((&n_mi[0]) as u64, p)
    stamp((&n_mb[0]) as u64, p)
    stamp((&n_hw[0]) as u64, p)
    let rc: u64 = upbench.u_sys(SYS_OSUM_PWRSET, PS_PROFILE, p, 0)
    u_k18((&n_set[0]) as u64, rc)
    u_k18((&n_pr[0]) as u64, u_get(PG_PROFILE))
    u_k18((&n_pc[0]) as u64, u_get(PG_PERFCTL))
    u_k18((&n_pb[0]) as u64, u_get(PG_PERFBACK))
    u_k18((&n_mi[0]) as u64, u_get(PG_MISC))
    u_k18((&n_mb[0]) as u64, u_get(PG_MISCBACK))
    u_k18((&n_hw[0]) as u64, u_get(PG_HWPREQ))
}

fn stamp(p: u64, n: u64) {
    var i: u64 = 0
    while i < 16 {
        let c: u64 = (*((p + i) as *mut u8)) as u64
        if c == 0 {
            i = 16
        } else {
            if c == 36 {
                *((p + i) as *mut u8) = (48 + n) as u8
                i = 16
            } else {
                i = i + 1
            }
        }
    }
}

fn u_pwridle(arg: u64) {
    var n: [u8; 5] = "idle\0"
    upbench.u_sleep(0, arg)
    u_k18((&n[0]) as u64, arg)
    upbench.u_sys(upbase.SYS_EXIT, 0, 0, 0)
}

fn u_pwrload(arg: u64) {
    var n: [u8; 5] = "load\0"
    var acc: u64 = 1
    var i: u64 = 0
    while i < arg {
        acc = acc *% 6364136223846793005 +% 1442695040888963407
        i = i + 1
    }
    u_k18((&n[0]) as u64, acc & 0xFF)
    upbench.u_sys(upbase.SYS_EXIT, 0, 0, 0)
}

// ==================================================== RUNDE AVX

const VEC_WANT: u64 = upbase.USER_DATA

const VEC_GOT: u64 = upbase.USER_DATA + 2048

const VEC_ROUNDS: u64 = 64

fn u_cpuid_b(leaf: u64, sub: u64) -> u64 {
    return asm("push rbx\nmov eax, edi\nmov ecx, esi\ncpuid\nmov eax, ebx\npop rbx",
        in("rdi") leaf, in("rsi") sub, out("rax"),
        clobber("rcx"), clobber("rdx"))
}

fn u_cpuid_c(leaf: u64, sub: u64) -> u64 {
    return asm("push rbx\nmov eax, edi\nmov ecx, esi\ncpuid\nmov eax, ecx\npop rbx",
        in("rdi") leaf, in("rsi") sub, out("rax"),
        clobber("rcx"), clobber("rdx"))
}

fn u_xgetbv0() -> u64 {
    return asm("xor ecx, ecx\nxgetbv\nmov eax, eax\nshl rdx, 32\nor rax, rdx",
        out("rax"), clobber("rcx"), clobber("rdx"))
}

// 1 = xmm, 2 = ymm, 3 = zmm
fn u_vec_width() -> u64 {
    let f1c: u64 = u_cpuid_c(1, 0)
    if (f1c & 0x8000000) == 0 { // Bit 27: OSXSAVE
        return 1
    }
    let x: u64 = u_xgetbv0()
    if (f1c & 0x10000000) == 0 || (x & 6) != 6 { // Bit 28: AVX
        return 1
    }
    if (x & 0xE0) == 0xE0 {
        if (u_cpuid_b(7, 0) & 0x10000) != 0 { // Bit 16: AVX512F
            return 3
        }
    }
    return 2
}

fn u_vec_regs(w: u64) -> u64 {
    if w == 3 {
        return 32
    }
    return 16
}

fn u_vec_lanes(w: u64) -> u64 {
    if w == 3 {
        return 8
    }
    if w == 2 {
        return 4
    }
    return 2
}

fn u_xmm_put(p: u64) {
    asm("movdqu xmm0,[rdi]\nmovdqu xmm1,[rdi+16]\nmovdqu xmm2,[rdi+32]\nmovdqu xmm3,[rdi+48]\nmovdqu xmm4,[rdi+64]\nmovdqu xmm5,[rdi+80]\nmovdqu xmm6,[rdi+96]\nmovdqu xmm7,[rdi+112]\nmovdqu xmm8,[rdi+128]\nmovdqu xmm9,[rdi+144]\nmovdqu xmm10,[rdi+160]\nmovdqu xmm11,[rdi+176]\nmovdqu xmm12,[rdi+192]\nmovdqu xmm13,[rdi+208]\nmovdqu xmm14,[rdi+224]\nmovdqu xmm15,[rdi+240]",
        in("rdi") p, clobber("memory"))
}

fn u_xmm_take(p: u64) {
    asm("movdqu [rdi],xmm0\nmovdqu [rdi+16],xmm1\nmovdqu [rdi+32],xmm2\nmovdqu [rdi+48],xmm3\nmovdqu [rdi+64],xmm4\nmovdqu [rdi+80],xmm5\nmovdqu [rdi+96],xmm6\nmovdqu [rdi+112],xmm7\nmovdqu [rdi+128],xmm8\nmovdqu [rdi+144],xmm9\nmovdqu [rdi+160],xmm10\nmovdqu [rdi+176],xmm11\nmovdqu [rdi+192],xmm12\nmovdqu [rdi+208],xmm13\nmovdqu [rdi+224],xmm14\nmovdqu [rdi+240],xmm15",
        in("rdi") p, clobber("memory"))
}

fn u_xmm_add() {
    asm("paddq xmm0,xmm1\npaddq xmm1,xmm2\npaddq xmm2,xmm3\npaddq xmm3,xmm4\npaddq xmm4,xmm5\npaddq xmm5,xmm6\npaddq xmm6,xmm7\npaddq xmm7,xmm8\npaddq xmm8,xmm9\npaddq xmm9,xmm10\npaddq xmm10,xmm11\npaddq xmm11,xmm12\npaddq xmm12,xmm13\npaddq xmm13,xmm14\npaddq xmm14,xmm15")
}

fn u_ymm_put(p: u64) {
    asm("vmovdqu ymm0,[rdi]\nvmovdqu ymm1,[rdi+32]\nvmovdqu ymm2,[rdi+64]\nvmovdqu ymm3,[rdi+96]\nvmovdqu ymm4,[rdi+128]\nvmovdqu ymm5,[rdi+160]\nvmovdqu ymm6,[rdi+192]\nvmovdqu ymm7,[rdi+224]\nvmovdqu ymm8,[rdi+256]\nvmovdqu ymm9,[rdi+288]\nvmovdqu ymm10,[rdi+320]\nvmovdqu ymm11,[rdi+352]\nvmovdqu ymm12,[rdi+384]\nvmovdqu ymm13,[rdi+416]\nvmovdqu ymm14,[rdi+448]\nvmovdqu ymm15,[rdi+480]",
        in("rdi") p, clobber("memory"))
}

fn u_ymm_take(p: u64) {
    asm("vmovdqu [rdi],ymm0\nvmovdqu [rdi+32],ymm1\nvmovdqu [rdi+64],ymm2\nvmovdqu [rdi+96],ymm3\nvmovdqu [rdi+128],ymm4\nvmovdqu [rdi+160],ymm5\nvmovdqu [rdi+192],ymm6\nvmovdqu [rdi+224],ymm7\nvmovdqu [rdi+256],ymm8\nvmovdqu [rdi+288],ymm9\nvmovdqu [rdi+320],ymm10\nvmovdqu [rdi+352],ymm11\nvmovdqu [rdi+384],ymm12\nvmovdqu [rdi+416],ymm13\nvmovdqu [rdi+448],ymm14\nvmovdqu [rdi+480],ymm15",
        in("rdi") p, clobber("memory"))
}

fn u_ymm_add() {
    asm("vpaddq ymm0,ymm0,ymm1\nvpaddq ymm1,ymm1,ymm2\nvpaddq ymm2,ymm2,ymm3\nvpaddq ymm3,ymm3,ymm4\nvpaddq ymm4,ymm4,ymm5\nvpaddq ymm5,ymm5,ymm6\nvpaddq ymm6,ymm6,ymm7\nvpaddq ymm7,ymm7,ymm8\nvpaddq ymm8,ymm8,ymm9\nvpaddq ymm9,ymm9,ymm10\nvpaddq ymm10,ymm10,ymm11\nvpaddq ymm11,ymm11,ymm12\nvpaddq ymm12,ymm12,ymm13\nvpaddq ymm13,ymm13,ymm14\nvpaddq ymm14,ymm14,ymm15")
}

fn u_zmm_put(p: u64) {
    asm("vmovdqu64 zmm0,[rdi]\nvmovdqu64 zmm1,[rdi+64]\nvmovdqu64 zmm2,[rdi+128]\nvmovdqu64 zmm3,[rdi+192]\nvmovdqu64 zmm4,[rdi+256]\nvmovdqu64 zmm5,[rdi+320]\nvmovdqu64 zmm6,[rdi+384]\nvmovdqu64 zmm7,[rdi+448]\nvmovdqu64 zmm8,[rdi+512]\nvmovdqu64 zmm9,[rdi+576]\nvmovdqu64 zmm10,[rdi+640]\nvmovdqu64 zmm11,[rdi+704]\nvmovdqu64 zmm12,[rdi+768]\nvmovdqu64 zmm13,[rdi+832]\nvmovdqu64 zmm14,[rdi+896]\nvmovdqu64 zmm15,[rdi+960]\nvmovdqu64 zmm16,[rdi+1024]\nvmovdqu64 zmm17,[rdi+1088]\nvmovdqu64 zmm18,[rdi+1152]\nvmovdqu64 zmm19,[rdi+1216]\nvmovdqu64 zmm20,[rdi+1280]\nvmovdqu64 zmm21,[rdi+1344]\nvmovdqu64 zmm22,[rdi+1408]\nvmovdqu64 zmm23,[rdi+1472]\nvmovdqu64 zmm24,[rdi+1536]\nvmovdqu64 zmm25,[rdi+1600]\nvmovdqu64 zmm26,[rdi+1664]\nvmovdqu64 zmm27,[rdi+1728]\nvmovdqu64 zmm28,[rdi+1792]\nvmovdqu64 zmm29,[rdi+1856]\nvmovdqu64 zmm30,[rdi+1920]\nvmovdqu64 zmm31,[rdi+1984]",
        in("rdi") p, clobber("memory"))
}

fn u_zmm_take(p: u64) {
    asm("vmovdqu64 [rdi],zmm0\nvmovdqu64 [rdi+64],zmm1\nvmovdqu64 [rdi+128],zmm2\nvmovdqu64 [rdi+192],zmm3\nvmovdqu64 [rdi+256],zmm4\nvmovdqu64 [rdi+320],zmm5\nvmovdqu64 [rdi+384],zmm6\nvmovdqu64 [rdi+448],zmm7\nvmovdqu64 [rdi+512],zmm8\nvmovdqu64 [rdi+576],zmm9\nvmovdqu64 [rdi+640],zmm10\nvmovdqu64 [rdi+704],zmm11\nvmovdqu64 [rdi+768],zmm12\nvmovdqu64 [rdi+832],zmm13\nvmovdqu64 [rdi+896],zmm14\nvmovdqu64 [rdi+960],zmm15\nvmovdqu64 [rdi+1024],zmm16\nvmovdqu64 [rdi+1088],zmm17\nvmovdqu64 [rdi+1152],zmm18\nvmovdqu64 [rdi+1216],zmm19\nvmovdqu64 [rdi+1280],zmm20\nvmovdqu64 [rdi+1344],zmm21\nvmovdqu64 [rdi+1408],zmm22\nvmovdqu64 [rdi+1472],zmm23\nvmovdqu64 [rdi+1536],zmm24\nvmovdqu64 [rdi+1600],zmm25\nvmovdqu64 [rdi+1664],zmm26\nvmovdqu64 [rdi+1728],zmm27\nvmovdqu64 [rdi+1792],zmm28\nvmovdqu64 [rdi+1856],zmm29\nvmovdqu64 [rdi+1920],zmm30\nvmovdqu64 [rdi+1984],zmm31",
        in("rdi") p, clobber("memory"))
}

fn u_zmm_add() {
    asm("vpaddq zmm0,zmm0,zmm1\nvpaddq zmm1,zmm1,zmm2\nvpaddq zmm2,zmm2,zmm3\nvpaddq zmm3,zmm3,zmm4\nvpaddq zmm4,zmm4,zmm5\nvpaddq zmm5,zmm5,zmm6\nvpaddq zmm6,zmm6,zmm7\nvpaddq zmm7,zmm7,zmm8\nvpaddq zmm8,zmm8,zmm9\nvpaddq zmm9,zmm9,zmm10\nvpaddq zmm10,zmm10,zmm11\nvpaddq zmm11,zmm11,zmm12\nvpaddq zmm12,zmm12,zmm13\nvpaddq zmm13,zmm13,zmm14\nvpaddq zmm14,zmm14,zmm15\nvpaddq zmm15,zmm15,zmm16\nvpaddq zmm16,zmm16,zmm17\nvpaddq zmm17,zmm17,zmm18\nvpaddq zmm18,zmm18,zmm19\nvpaddq zmm19,zmm19,zmm20\nvpaddq zmm20,zmm20,zmm21\nvpaddq zmm21,zmm21,zmm22\nvpaddq zmm22,zmm22,zmm23\nvpaddq zmm23,zmm23,zmm24\nvpaddq zmm24,zmm24,zmm25\nvpaddq zmm25,zmm25,zmm26\nvpaddq zmm26,zmm26,zmm27\nvpaddq zmm27,zmm27,zmm28\nvpaddq zmm28,zmm28,zmm29\nvpaddq zmm29,zmm29,zmm30\nvpaddq zmm30,zmm30,zmm31")
}

fn u_vec_put(w: u64, p: u64) {
    if w == 3 {
        u_zmm_put(p)
    } else {
        if w == 2 {
            u_ymm_put(p)
        } else {
            u_xmm_put(p)
        }
    }
}

fn u_vec_take(w: u64, p: u64) {
    if w == 3 {
        u_zmm_take(p)
    } else {
        if w == 2 {
            u_ymm_take(p)
        } else {
            u_xmm_take(p)
        }
    }
}

fn u_vec_calc(w: u64) {
    if w == 3 {
        u_zmm_add()
    } else {
        if w == 2 {
            u_ymm_add()
        } else {
            u_xmm_add()
        }
    }
}

fn u_vec_calc_ref(p: u64, regs: u64, lanes: u64) {
    var n: u64 = 0
    while n + 1 < regs {
        var l: u64 = 0
        while l < lanes {
            let a: u64 = __mmio_read64((p + (n * lanes + l) * 8) as *mut u64)
            let b: u64 = __mmio_read64((p + ((n + 1) * lanes + l) * 8) as *mut u64)
            __mmio_write64((p + (n * lanes + l) * 8) as *mut u64, a +% b)
            l = l + 1
        }
        n = n + 1
    }
}

fn u_vec_seed(p: u64, words: u64, arg: u64) {
    var k: u64 = 0
    while k < words {
        __mmio_write64((p + k * 8) as *mut u64,
            (arg << 56) | (arg << 40) | (arg << 24) | (k << 8) | 0x5A)
        k = k + 1
    }
}

fn u_vec_diff(a: u64, b: u64, words: u64) -> u64 {
    var k: u64 = 0
    var bad: u64 = 0
    while k < words {
        if __mmio_read64((a + k * 8) as *mut u64)
        != __mmio_read64((b + k * 8) as *mut u64) {
            bad = bad + 1
        }
        k = k + 1
    }
    return bad
}

fn u_vec(arg: u64) {
    var s_w: [u8; 12] = "vec: width=\0"
    var s_p: [u8; 10] = "vec: pid=\0"
    var s_a: [u8; 10] = "vec: arg=\0"
    var s_b: [u8; 10] = "vec: bad=\0"
    var s_r: [u8; 13] = "vec: rounds=\0"
    var s_nv: [u8; 12] = "vec: novec\0\0"
    let novec: u64 = (arg >> 8) & 1
    if novec != 0 {
        upbench.u_say((&s_nv[0]) as u64)
        var q: u64 = 0
        while q < VEC_ROUNDS {
            upbench.u_sys(upbase.SYS_YIELD, 0, 0, 0)
            upbench.u_sys(upbase.SYS_YIELD, 0, 0, 0)
            q = q + 1
        }
        upbench.u_sys(upbase.SYS_EXIT, 0, 0, 0)
    }
    let w: u64 = u_vec_width()
    let regs: u64 = u_vec_regs(w)
    let lanes: u64 = u_vec_lanes(w)
    let words: u64 = regs * lanes
    let pid: u64 = upbench.u_sys(upbase.SYS_GETPID, 0, 0, 0)
    upbench.u_say_line((&s_p[0]) as u64, pid)
    upbench.u_say_line((&s_a[0]) as u64, arg & 0xFF)
    upbench.u_say_line((&s_w[0]) as u64, w)
    u_vec_seed(VEC_WANT, words, arg & 0xFF)
    u_vec_put(w, VEC_WANT)
    var bad: u64 = 0
    var r: u64 = 0
    while r < VEC_ROUNDS {
        upbench.u_sys(upbase.SYS_YIELD, 0, 0, 0)
        u_vec_calc(w)
        u_vec_calc_ref(VEC_WANT, regs, lanes)
        upbench.u_sys(upbase.SYS_YIELD, 0, 0, 0)
        u_vec_take(w, VEC_GOT)
        bad = bad + u_vec_diff(VEC_WANT, VEC_GOT, words)
        r = r + 1
    }
    upbench.u_say_line((&s_r[0]) as u64, VEC_ROUNDS)
    upbench.u_say_line((&s_b[0]) as u64, bad)
    if (arg & 0x200) != 0 {
        var s_f: [u8; 14] = "vec: forkbad=\0"
        var s_fp: [u8; 14] = "vec: forkpid=\0"
        u_vec_calc(w)
        u_vec_calc_ref(VEC_WANT, regs, lanes)
        let kind: u64 = upbench.u_sys(upbase.SYS_FORK, 0, 0, 0)
        u_vec_take(w, VEC_GOT)
        let fb: u64 = u_vec_diff(VEC_WANT, VEC_GOT, words)
        upbench.u_say_line((&s_fp[0]) as u64, kind)
        upbench.u_say_line((&s_f[0]) as u64, fb)
        if kind == 0 {
            upbench.u_sys(upbase.SYS_EXIT, fb, 0, 0)
        }
        let ke: u64 = upbench.u_wait(kind)
        bad = bad + fb
        if ke < 251 {
            bad = bad + ke
        }
    }
    if bad > 250 {
        bad = 250
    }
    upbench.u_sys(upbase.SYS_EXIT, bad, 0, 0)
}

// ==================================================== RUNDE SYSTEMBUS

fn u_bus(op: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    return upbench.u_sys6(SYS_OSUM_BUS, op, a1, a2, a3, a4, 0)
}

fn u_fnv(p: u64, n: u64) -> u64 {
    var h: u64 = 14695981039346656037
    var i: u64 = 0
    while i < n {
        h = h ^ ((*((p + i) as *mut u8)) as u64)
        h = h *% 1099511628211
        i = i + 1
    }
    return h
}

fn u_bustext(p: u64, runde: u64) -> u64 {
    var n: u64 = 0
    var k: u64 = 0
    while k < 6 {
        *((p + n) as *mut u8) = (99 + k) as u8 // c,d,e,f,g,h
        n = n + 1
        var v: u64 = runde + k * 7
        if v == 0 {
            *((p + n) as *mut u8) = 48 as u8
            n = n + 1
        }
        var d: u64 = 100000
        var seen: bool = false
        while d > 0 {
            let z: u64 = (v / d) % 10
            if z != 0 || seen || d == 1 {
                *((p + n) as *mut u8) = (48 + z) as u8
                n = n + 1
                seen = true
            }
            d = d / 10
        }
        k = k + 1
    }
    *((p + n) as *mut u8) = 0 as u8
    return n
}

// -------------------------------------------------------------- A: schreibt
fn u_busa(arg: u64) {
    var s_start: [u8; 13] = "busa: start\n\0"
    var s_reg: [u8; 12] = "busa: reg=\0\0"
    var s_kid: [u8; 12] = "busa: kid=\0\0"
    var s_abw: [u8; 12] = "busa: abw=\0\0"
    var s_run: [u8; 12] = "busa: run=\0\0"
    var s_ende: [u8; 12] = "busa: ende\n\0"
    var nm_a: [u8; 6] = "probe\0"
    var buf: [u8; 64] = [0 as u8; 64]
    var meta: [u8; 48] = [0 as u8; 48]
    upbench.u_say((&s_start[0]) as u64)
    let d: u64 = u_bus(BUS_REG, (&nm_a[0]) as u64, 5, BA_ANY, 0)
    upbench.u_say_line((&s_reg[0]) as u64, d)
    if (d >> 63) != 0 {
        upbench.u_sys(upbase.SYS_EXIT, 90, 0, 0)
    }
    let kid: u64 = upbench.u_sys(upbase.SYS_SPAWN, P_BUSB, 0, 0)
    upbench.u_say_line((&s_kid[0]) as u64, kid)
    var nm_b: [u8; 6] = "leser\0"
    var svc: u64 = u_bus(BUS_FIND, (&nm_b[0]) as u64, 5, 0, 0)
    var wach: u64 = 0
    while (svc >> 63) != 0 && wach < 2000000 {
        upbench.u_sys(upbase.SYS_YIELD, 0, 0, 0)
        svc = u_bus(BUS_FIND, (&nm_b[0]) as u64, 5, 0, 0)
        wach = wach + 1
    }
    if (svc >> 63) != 0 {
        upbench.u_say_line((&s_abw[0]) as u64, 999)
        upbench.u_sys(upbase.SYS_EXIT, 91, 0, 0)
    }
    var abw: u64 = 0
    var runde: u64 = 0
    while runde < RUNDEN {
        let n: u64 = u_bustext((&buf[0]) as u64, runde)
        let h: u64 = u_fnv((&buf[0]) as u64, n)
        if (u_bus(BUS_CLIPSET, BT_TEXT, (&buf[0]) as u64, n, 0) >> 63) != 0 {
            abw = abw + 1
        }
        u_bus(BUS_SEND, svc, (&buf[0]) as u64, 8, 0)
        var got: u64 = u_bus(BUS_RECV, (&buf[0]) as u64, 64,
            (&meta[0]) as u64, 0)
        var w: u64 = 0
        while (got >> 63) != 0 && w < 2000000 {
            upbench.u_sys(upbase.SYS_YIELD, 0, 0, 0)
            got = u_bus(BUS_RECV, (&buf[0]) as u64, 64, (&meta[0]) as u64, 0)
            w = w + 1
        }
        if (got >> 63) != 0 {
            abw = abw + 1
        } else {
            let back: u64 = *(((&buf[0]) as u64) as *mut u64)
            if back != h {
                abw = abw + 1
            }
        }
        runde = runde + 1
    }
    upbench.u_say_line((&s_run[0]) as u64, runde)
    upbench.u_say_line((&s_abw[0]) as u64, abw)
    upbench.u_wait(kid)
    upbench.u_say((&s_ende[0]) as u64)
    upbench.u_sys(upbase.SYS_EXIT, abw, 0, 0)
}

// -------------------------------------------------------------- B: liest
fn u_busb(arg: u64) {
    var s_reg: [u8; 12] = "busb: reg=\0\0"
    var s_n: [u8; 12] = "busb: got=\0\0"
    var s_empty: [u8; 13] = "busb: leer=\0\0"
    var nm_b: [u8; 6] = "leser\0"
    var nm_a: [u8; 6] = "probe\0"
    var buf: [u8; 64] = [0 as u8; 64]
    var meta: [u8; 48] = [0 as u8; 48]
    var hbuf: [u8; 8] = [0 as u8; 8]
    let d: u64 = u_bus(BUS_REG, (&nm_b[0]) as u64, 5, BA_ANY, 0)
    upbench.u_say_line((&s_reg[0]) as u64, d)
    if (d >> 63) != 0 {
        upbench.u_sys(upbase.SYS_EXIT, 90, 0, 0)
    }
    var back: u64 = u_bus(BUS_FIND, (&nm_a[0]) as u64, 5, 0, 0)
    var empty: u64 = 0
    var n: u64 = 0
    while n < RUNDEN {
        var got: u64 = u_bus(BUS_RECV, (&buf[0]) as u64, 64,
            (&meta[0]) as u64, 0)
        var w: u64 = 0
        while (got >> 63) != 0 && w < 4000000 {
            upbench.u_sys(upbase.SYS_YIELD, 0, 0, 0)
            got = u_bus(BUS_RECV, (&buf[0]) as u64, 64, (&meta[0]) as u64, 0)
            w = w + 1
        }
        if (got >> 63) != 0 {
            empty = empty + 1
            n = n + 1
        } else {
            let m: u64 = u_bus(BUS_CLIPGET, 0, (&buf[0]) as u64, 64,
                (&meta[0]) as u64)
            var h: u64 = 0
            if (m >> 63) == 0 {
                h = u_fnv((&buf[0]) as u64, m)
            }
            *(((&hbuf[0]) as u64) as *mut u64) = h
            u_bus(BUS_SEND, back, (&hbuf[0]) as u64, 8, 0)
            n = n + 1
        }
    }
    upbench.u_say_line((&s_n[0]) as u64, n)
    upbench.u_say_line((&s_empty[0]) as u64, empty)
    upbench.u_sys(upbase.SYS_EXIT, empty, 0, 0)
}

// ------------------------------------------------- D: der Unberechtigte
fn u_busd(arg: u64) {
    var s_reg: [u8; 12] = "busd: reg=\0\0"
    var s_uid: [u8; 12] = "busd: uid=\0\0"
    var s_ruf: [u8; 12] = "busd: ruf=\0\0"
    var s_vor: [u8; 12] = "busd: vor=\0\0"
    var nm: [u8; 7] = "geheim\0"
    var buf: [u8; 8] = [0 as u8; 8]
    let d: u64 = u_bus(BUS_REG, (&nm[0]) as u64, 6, BA_ROOT, 0)
    upbench.u_say_line((&s_reg[0]) as u64, d)
    if (d >> 63) != 0 {
        upbench.u_sys(upbase.SYS_EXIT, 90, 0, 0)
    }
    upbench.u_say_line((&s_vor[0]) as u64, u_bus(BUS_SEND, d, (&buf[0]) as u64, 8, 0))
    upbench.u_sys(SYS_SETUID, 1000, 0, 0)
    upbench.u_say_line((&s_uid[0]) as u64, upbench.u_sys(SYS_GETUID, 0, 0, 0))
    let r: u64 = u_bus(BUS_SEND, d, (&buf[0]) as u64, 8, 0)
    upbench.u_say_line((&s_ruf[0]) as u64, r)
    upbench.u_sys(upbase.SYS_EXIT, 0 -% r, 0, 0)
}

// ------------------------------------------------ S: ein Megabyte, gemessen
fn u_nsec() -> u64 {
    var ts: [u64; 2] = [0 as u64; 2]
    upbench.u_sys(SYS_CLOCK_GETTIME, 1, (&ts[0]) as u64, 0)
    return ts[0] *% 1000000000 +% ts[1]
}

fn u_buss(arg: u64) {
    var s_seg: [u8; 12] = "buss: seg=\0\0"
    var s_adr: [u8; 12] = "buss: adr=\0\0"
    var s_us: [u8; 11] = "buss: us=\0\0"
    var s_sum: [u8; 12] = "buss: sum=\0\0"
    var s_byt: [u8; 12] = "buss: byt=\0\0"
    let pages: u64 = 256
    let seg: u64 = u_bus(BUS_SEGNEW, pages, 0, 0, 0)
    upbench.u_say_line((&s_seg[0]) as u64, seg)
    if (seg >> 63) != 0 {
        upbench.u_sys(upbase.SYS_EXIT, 90, 0, 0)
    }
    let a: u64 = u_bus(BUS_SEGMAP, seg, 0, 0, 0)
    upbench.u_say_line((&s_adr[0]) as u64, a)
    if (a >> 63) != 0 {
        upbench.u_sys(upbase.SYS_EXIT, 91, 0, 0)
    }
    let n: u64 = pages * 4096
    // Fuellen -- NICHT gemessen.
    var i: u64 = 0
    while i < n / 8 {
        *((a + i * 8) as *mut u64) = i +% 7
        i = i + 1
    }
    let t0: u64 = u_nsec()
    var sum: u64 = 0
    i = 0
    while i < n / 8 {
        sum = sum +% *((a + i * 8) as *mut u64)
        i = i + 1
    }
    let t1: u64 = u_nsec()
    upbench.u_say_line((&s_byt[0]) as u64, n)
    upbench.u_say_line((&s_us[0]) as u64, (t1 -% t0) / 1000)
    upbench.u_say_line((&s_sum[0]) as u64, sum)
    u_bus(BUS_SEGDROP, seg, 0, 0, 0)
    upbench.u_sys(upbase.SYS_EXIT, 0, 0, 0)
}

// ================================================== RUNDE SPEICHERDRUCK
fn u_hog(arg: u64) {
    var s_start: [u8; 13] = "hog: start #\0"
    var s_at: [u8; 11] = "hog: kib=\0\0"
    var s_fail: [u8; 12] = "hog: fail=\0\0"
    var s_ende: [u8; 11] = "hog: ende\n\0"
    upbench.u_say_line((&s_start[0]) as u64, arg)

    let chunk: u64 = 64 * 4096
    var pages: u64 = 0
    var live: u64 = 1
    while live == 1 {
        let got: u64 = upbench.u_sys6(upbase.SYS_MMAP, 0, chunk, upbase.PROT_READ | upbase.PROT_WRITE,
            MAP_PRIVATE | MAP_ANONYMOUS, 0 -% 1, 0)
        if got == 0 || (got >> 63) != 0 {
            upbench.u_say_line((&s_fail[0]) as u64, pages * 4)
            live = 0
        }
        if live == 1 {
            var off: u64 = 0
            while off < chunk {
                __mmio_write64((got + off) as *mut u64, arg + pages)
                off = off + 4096
            }
            pages = pages + 64
            if pages % 512 == 0 {
                upbench.u_say_line((&s_at[0]) as u64, pages * 4)
            }
        }
    }
    upbench.u_say((&s_ende[0]) as u64)
    upbench.u_sys(upbase.SYS_EXIT, 0, 0, 0)
}

fn u_hogwrite(arg: u64) {
    var s_start: [u8; 18] = "hogwrite: start #\0"
    var s_wrote: [u8; 19] = "hogwrite: wrote=\0\0\0"
    var s_fail: [u8; 17] = "hogwrite: fail=\0\0"
    var name: [u8; 16] = "/oom-datei.txt\0\0"
    var payload: [u8; 65] = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\0"
    upbench.u_say_line((&s_start[0]) as u64, arg)

    // O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577
    let fd: u64 = upbench.u_sys(upbase.SYS_OPEN, (&name[0]) as u64, 577, 0x1A4)
    if (fd >> 63) == 0 {
        let n: u64 = upbench.u_sys(upbase.SYS_WRITE, fd, (&payload[0]) as u64, 64)
        upbench.u_say_line((&s_wrote[0]) as u64, n)
    }

    let chunk: u64 = 64 * 4096
    var pages: u64 = 0
    var live: u64 = 1
    while live == 1 {
        let got: u64 = upbench.u_sys6(upbase.SYS_MMAP, 0, chunk, upbase.PROT_READ | upbase.PROT_WRITE,
            MAP_PRIVATE | MAP_ANONYMOUS, 0 -% 1, 0)
        if got == 0 || (got >> 63) != 0 {
            upbench.u_say_line((&s_fail[0]) as u64, pages * 4)
            live = 0
        }
        if live == 1 {
            var off: u64 = 0
            while off < chunk {
                __mmio_write64((got + off) as *mut u64, arg + pages)
                off = off + 4096
            }
            pages = pages + 64
        }
    }
    upbench.u_sys(upbase.SYS_CLOSE, fd, 0, 0)
    upbench.u_sys(upbase.SYS_EXIT, 0, 0, 0)
}
