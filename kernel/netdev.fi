}

fn bdf_on(state: u64, c: u64) -> u64 {
    let k: u64 = kind_on(state, c)
    if k == KIND_VIRTIO {
        return virtio.bdf_on(state, unit_of(state, c))
    }
    if k == KIND_E1000 {
        return e1000.bdf_on(state, unit_of(state, c))
    }
    return 0
}

fn idx_on(state: u64, c: u64) -> u64 {
    let k: u64 = kind_on(state, c)
    if k == KIND_VIRTIO {
        return virtio.idx_on(state, unit_of(state, c))
    }
    if k == KIND_E1000 {
        return e1000.idx_on(state, unit_of(state, c))
    }
    return pci.MAX_DEV
}

fn irqs_on(state: u64, c: u64) -> u64 {
    let k: u64 = kind_on(state, c)
    if k == KIND_VIRTIO {
        return virtio.irqs_on(state, unit_of(state, c))
    }
    if k == KIND_E1000 {
        return e1000.irqs_on(state, unit_of(state, c))
    }
    return 0
}

fn rx_frames_on(state: u64, c: u64) -> u64 {
