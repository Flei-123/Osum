// SPDX-License-Identifier: GPL-2.0-only
// kernel/netdev.fi -- round HWNET: WHICH card, decided by the bus.
//
// Until this round the kernel had one network driver and every caller
// knew its name. `kernel/inet.fi` calls `virtio.tx_frame` in twenty
// places, `netsvc.fi` in sixteen, `share.fi` in sixteen, `wg.fi` in six,
// `netview.fi` in three and `trap.fi` in two. That is not a driver
// interface, it is a driver ADDRESS -- and it is why a second card type
// could not be added without touching sixty-three call sites.
//
// This file is that interface, and it is deliberately the SAME SHAPE the
// callers already use: every function `virtio.fi` exported is here, with
// the same name and the same arguments, so the change at the call sites
// is one word. What is new is what happens underneath: a card number no
// longer means "the n-th virtio device", it means "the n-th network card
// this kernel has a driver for", and which driver that is comes out of
// the PCI vendor and device number.
//
// THE TABLE, and why a table and not an `if`:
//
//   1AF4:1000/1041  virtio-net      kernel/virtio.fi   (round K8)
//   8086:100E ...   Intel 8254x     kernel/e1000.fi    (round HWNET)
//   8086:15B7 ...   Intel I219      kernel/e1000.fi    (round RTL, ICH part)
//   10EC:8168 ...   Realtek 8168/69 kernel/r8169.fi    (round RTL)
//   10EC:8139       Realtek 8139C+  kernel/r8169.fi    (round RTL, rev >= 0x20)
//
// Everything else on class 02:00 is REFUSED WITH ITS NUMBER printed, so
// that a machine which does not work says which chip it has instead of
// saying nothing. That sentence is the whole point of the round: Justin
// puts OrientOS on a real board, and the serial line has to say either
// "e1000 at 00:03.0" oder "kein Treiber fuer Intel I226-V (8086:125c)"
// -- niemals blosses Schweigen.
//
// ROUND RTL made that table a DATA TABLE. Until this round the choice was
// an `if` cascade inside `probe`, and adding a chip meant editing the
// walk over the bus. Now there is exactly one function, `driver_for`, and
// one line per chip in it; `probe` calls it and knows nothing else. A
// second function, `reason_for`, names the chips this kernel RECOGNISES
// but does not drive -- an I225 is not the same kind of "no" as a card
// nobody has ever heard of, and a serial line that says which of the two
// it is saves a day.
//
// `print_table` runs the whole table against a built-in list of numbers
// and prints the answer for each. That is what makes the choice testable
// WITHOUT the chip: this repository has no I219 and no RTL8168, but it
// can prove that 8086:15B7 lands on `i219` and 10EC:8168 on `r8169`.
//
// WHAT IS NOT HERE. No hot plug, no more than two cards, no per-card
// interrupt sharing (each card gets a vector of its own, 45 and 46, as
// round NETMON decided), and no ordering promise beyond bus order.

import lib.kstate
import serial
import pci
import lib.chipname
import virtio
import e1000
import r8169

export {
    probe, kind_on, print_kind, MAX_CARDS,
    KIND_NONE, KIND_VIRTIO, KIND_E1000, KIND_R8169, KIND_I219,
    MAX_CARDS, IRQ_CARDS, polled_on,
    driver_for, reason_for, print_table, selftest, print_inventory,
    rx_errors, oversize, rx_overflow,
    unsupported_count, unsupported_vendor, unsupported_device,
    unsupported_reason,
    init, present, ready, up, mac_at, bdf, idx,
    rx_take, rx_recycle, tx_frame, tx_room, poll,
    irq, irqs, rx_frames, tx_frames, tx_drops, rx_octets, tx_octets,
    features, queue_size, msix, notified, link_up, shut_down,
    init_on, present_on, ready_on, up_on, mac_at_on, bdf_on, idx_on,
    rx_take_on, rx_recycle_on, tx_frame_on, tx_room_on, poll_on, irq_on,
    rx_frames_on, tx_frames_on, rx_octets_on, tx_octets_on,
    tx_drops_on, link_up_on, shut_down_on, irqs_on, queue_size_on,
    msix_on, notified_on, features_on, VEC_NET, print_cards
}

// ------------------------------------------------------ the data area
//
// `kstate.NETDEV_OFF` (0x7A000), the first page of what `kstate.fi` still
// lists as free. NOT `pci.K2_SCALARS`: that page pair is cut up by nine
// rounds and round NETVIEW spent a day on two of them landing on the
// same eight octets. Entered in `tools/kernel/memmap.py`.
//
// DIE AUFTEILUNG, nachgerechnet und nicht geschaetzt. Eine Seite,
// 0x1000 Oktette, und sie ist jetzt bis auf 120 Oktette voll:
//
//   0x000..0x200   diese Datei, 0x40 je Karte -- MAX_CARDS 8
//   0x200..0x388   die abgelehnten Karten, 24 Oktett je Eintrag -- 16
//   0x388..0x400   frei
//   0x400..0x800   `e1000.fi`, 0x200 je Einheit -- 2
//   0x800..0xC00   `r8169.fi`, 0x200 je Einheit -- 2
//   0xC00..0x1000  `igc.fi`,   0x200 je Einheit -- 2
//
// ================================================== RUNDE BLECH: ACHT
//
// MAX_CARDS stand auf ZWEI, und das war fuer den Zweck dieses Projekts
// zu wenig: ein gewoehnliches Brett hat einen Chipsatz-Anschluss und
// eine Steckkarte, ein Server hat zwei Ports auf einem Chip, und wer
// einen USB-Netzadapter einsteckt, hat drei. Eine dritte Karte fiel
// bisher stillschweigend heraus -- `probe` hoerte nach der zweiten auf
// zu zaehlen.
//
// ACHT UND NICHT VIERZEHN, obwohl die Treiber zusammen so viele
// Einheiten haetten (virtio 2 + e1000 2 + r8169 2 + igc 2 = 8, und
// virtio wohnt ausserhalb dieser Seite): acht Karten sind 0x200
// Oktette, und der naechste Bereich faengt bei 0x200 an. Mehr ginge
// nur, wenn die abgelehnten Karten umziehen -- und die stehen
// absichtlich VOR den Treibern, weil ein Rechner ohne Treiber genau
// diese Liste braucht.
//
// WAS NICHT MITWAECHST, und das ist die ehrliche Halbe an dieser
// Aenderung: DIE MELDEVEKTOREN. `isr.s` hat zwei Stuempfe, 45 und 46,
// und diese Runde faesst `isr.s` nicht an. Karte 0 und 1 bekommen
// deshalb eine Unterbrechung, Karte 2 bis 7 NICHT -- sie werden
// abgefragt (`netd` fragt den Ring ohnehin ab, nur langsamer). Der
// Kern sagt das in `print_cards`, statt es zu verschweigen.
const MAX_CARDS: u64 = 8
const CARD_SPAN: u64 = 0x40

// Wieviele Karten eine eigene Unterbrechung bekommen koennen. Das ist
// eine Eigenschaft von `kernel/arch/x86_64/isr.s` und keine von diesem
// Modul -- deshalb steht die Zahl hier mit ihrer Begruendung und nicht
// als eine 2 mitten im Quelltext.
const IRQ_CARDS: u64 = 2

const S_KIND: u64 = 0x00 // which driver, or KIND_NONE
const S_UNIT: u64 = 0x08 // the card number INSIDE that driver
const S_PCI: u64 = 0x10 // its place in the device table of pci.fi
const S_PROBED: u64 = 0x18
const S_POLLED: u64 = 0x20 // 1 = diese Karte hat keinen Meldevektor

// Die abgelehnten Karten, damit die Maschine sagen kann, was sie hat.
// Hersteller, Geraet, Grund -- 24 Oktette je Eintrag.
//
// SECHZEHN UND NICHT ACHT: ein Laptop mit Chipsatz-Ethernet, WLAN,
// Bluetooth-ueber-PCIe und einem Dock kommt auf mehr als acht Geraete,
// fuer die dieser Kern keinen Treiber hat -- und eine Liste, die
// ueberlaeuft, verschweigt genau die Karte, wegen der jemand nachsieht.
const S_UNSUP_N: u64 = 0x200
const S_UNSUP: u64 = 0x208 // n * 24: Hersteller, Geraet, Grund
const MAX_UNSUP: u64 = 16

const KIND_NONE: u64 = 0
const KIND_VIRTIO: u64 = 1
const KIND_E1000: u64 = 2
const KIND_R8169: u64 = 3 // Runde RTL: kernel/r8169.fi
const KIND_I219: u64 = 4 // Runde RTL: kernel/e1000.fi, PCH-Zweig

// WARUM eine Karte keinen Treiber bekommt. Ein Chip, den dieser Kern
// KENNT und trotzdem nicht bedient, ist ein anderes "nein" als einer, den
// noch nie jemand gesehen hat -- und auf einem Brett, das nicht ins Netz
// kommt, ist genau dieser Unterschied die Auskunft, die weiterhilft.
const WHY_UNKNOWN: u64 = 0
const WHY_IGC: u64 = 1 // I225/I226: igc-Silizium, nur erweiterte Deskriptoren
const WHY_IGB: u64 = 2 // I210/I211: igb-Silizium, andere Warteschlangen
const WHY_WIFI: u64 = 3 // WLAN: 802.11-MAC und Firmware, kein Ethernet
const WHY_OLD8139: u64 = 4 // RTL8139 vor Revision 0x20: kein C+-Modus
const WHY_OTHERVENDOR: u64 = 5 // Broadcom, Atheros, Aquantia, Marvell
// RUNDE BLECH: der I219, den dieser Kern NICHT faehrt. `e1000.supports_ich`
// nennt 20 der 53 I219-Nummern aus Linux' e1000e; die uebrigen 33 sitzen in
// neueren Bruecken (Tiger Lake bis Arrow Lake) und brauchen dort eigene
// Handgriffe, die hier weder gebaut noch gemessen sind. Das ist ein ANDERES
// "nein" als bei einem igc -- der Treiber ist da, nur diese Stufe nicht
// freigegeben -- und wer davorsteht, soll den Unterschied lesen koennen.
const WHY_I219GEN: u64 = 6

// Card 0 keeps vector 45 and card 1 takes 46 -- unchanged from round
// NETMON, because `isr.s` has those two stubs and no others.
const VEC_NET: u64 = 45

const VENDOR_VIRTIO: u64 = 0x1AF4
const CLASS_NET: u64 = 0x02
const SUB_ETHERNET: u64 = 0x00

fn sc(c: u64, off: u64) -> u64 {
    return kstate.NETDEV_OFF + c * CARD_SPAN + off
}

fn kind_on(state: u64, c: u64) -> u64 {
    if c >= MAX_CARDS {
        return KIND_NONE
    }
    if kstate.get(state, kstate.NETDEV_OFF + S_PROBED) == 0 {
        probe(state)
    }
    return kstate.get(state, sc(c, S_KIND))
}

fn unit_of(state: u64, c: u64) -> u64 {
    return kstate.get(state, sc(c, S_UNIT))
}

// The name of a driver, ON THE SERIAL LINE. Not a pointer that comes
// back: a local array dies with its frame, and this compiler says so
// (`the address of the local escapes through the return value`). So the
// only caller that needs the text is the one that prints it.
fn print_kind(k: u64) {
    var s_virtio: [u8; 11] = "virtio-net\0"
    var s_e1000: [u8; 6] = "e1000\0"
    var s_r8169: [u8; 6] = "r8169\0"
    var s_i219: [u8; 5] = "i219\0"
    var s_none: [u8; 5] = "none\0"
    if k == KIND_VIRTIO {
        serial.puts((&s_virtio[0]) as u64)
        return
    }
    if k == KIND_E1000 {
        serial.puts((&s_e1000[0]) as u64)
        return
    }
    if k == KIND_R8169 {
        serial.puts((&s_r8169[0]) as u64)
        return
    }
    if k == KIND_I219 {
        serial.puts((&s_i219[0]) as u64)
        return
    }
    serial.puts((&s_none[0]) as u64)
}

// -------------------------------------------------------------- probe
//
// Walks the device table `pci.scan` built and decides, for every device
// on class 02:00, which driver is going to own it. Runs once; the answer
// does not change while the machine is on, because this kernel has no
// hot plug.
//
// THE ORDER IS BUS ORDER, which is the order QEMU was given its
// `-device` arguments in and the order a mainboard numbers its slots.
// That is what makes "card 1" mean the same card on every boot -- round
// NETMON's `share=1` depends on it.
fn probe(state: u64) {
    kstate.set(state, kstate.NETDEV_OFF + S_PROBED, 1)
    kstate.set(state, kstate.NETDEV_OFF + S_UNSUP_N, 0)
    var c: u64 = 0
    while c < MAX_CARDS {
        kstate.set(state, sc(c, S_KIND), KIND_NONE)
        kstate.set(state, sc(c, S_UNIT), 0)
        kstate.set(state, sc(c, S_PCI), pci.MAX_DEV)
        c = c + 1
    }
    let n: u64 = pci.count(state)
    var i: u64 = 0
    var cards: u64 = 0
    // EINE Einheitenzaehlung JE TREIBERDATEI und nicht je Kennzeichnung:
    // `KIND_E1000` und `KIND_I219` sind zwei Namen fuer dieselbe Datei
    // `e1000.fi`, und deren Einheit 0 gibt es nur einmal.
    var virtio_units: u64 = 0
    var e1000_units: u64 = 0
    var r8169_units: u64 = 0
    while i < n {
        if pci.get(state, i, pci.E_CLASS) == CLASS_NET {
            if pci.get(state, i, pci.E_SUBCLASS) == SUB_ETHERNET {
                let ven: u64 = pci.get(state, i, pci.E_VENDOR)
                let dev: u64 = pci.get(state, i, pci.E_DEVICE)
                let rev: u64 = pci.cfg_read8(pci.get(state, i, pci.E_BDF), 0x08)
                let k: u64 = driver_for(ven, dev, rev)
                var unit: u64 = 0
                if k == KIND_VIRTIO {
                    unit = virtio_units
                }
                if k == KIND_E1000 || k == KIND_I219 {
                    unit = e1000_units
                }
                if k == KIND_R8169 {
                    unit = r8169_units
                }
                if k == KIND_NONE {
                    note_unsupported(state, ven, dev, reason_for(ven, dev, rev))
                } else {
                    if cards < MAX_CARDS {
                        // Ein Treiber hat nur so viele eigene Einheiten.
                        var room: bool = true
                        if k == KIND_VIRTIO && unit >= virtio.MAX_CARDS {
                            room = false
                        }
                        if (k == KIND_E1000 || k == KIND_I219)
                            && unit >= e1000.MAX_UNITS {
                            room = false
                        }
                        if k == KIND_R8169 && unit >= r8169.MAX_UNITS {
                            room = false
                        }
                        if room {
                            kstate.set(state, sc(cards, S_KIND), k)
                            kstate.set(state, sc(cards, S_UNIT), unit)
                            kstate.set(state, sc(cards, S_PCI), i)
                            cards = cards + 1
                            if k == KIND_VIRTIO {
                                virtio_units = virtio_units + 1
                            }
                            if k == KIND_E1000 || k == KIND_I219 {
                                e1000_units = e1000_units + 1
                            }
                            if k == KIND_R8169 {
                                r8169_units = r8169_units + 1
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
}

// ==================================================== DIE TREIBERTABELLE
//
// EINE Stelle im ganzen Kern, an der steht, welcher Chip welchen Treiber
// bekommt. Wer eine Karte ergaenzen will, schreibt hier EINE Zeile -- er
// muss weder den Lauf ueber den Bus noch den Verteiler darunter anfassen.
//
// `rev` ist die PCI-Revision und wird fuer genau einen Chip gebraucht:
// der RTL8139 hat seine Deskriptorringe erst ab Revision 0x20 (der
// C+-Modus). Ein RTL8139B davor sieht auf dem Bus gleich aus und kann
// nichts davon -- ihn anzunehmen hiesse, eine Karte zu behaupten, die
// nie einen Rahmen abgibt.
fn driver_for(ven: u64, dev: u64, rev: u64) -> u64 {
    // ---- 1AF4 Red Hat/virtio -- gibt es nur unter einem Hypervisor
    if ven == VENDOR_VIRTIO {
        // uebergangsweise (0.9.5 + 1.0) bzw. modern
        if dev == 0x1000 || dev == 0x1041 {
            return KIND_VIRTIO
        }
        return KIND_NONE
    }
    // ---- 10EC Realtek -- kernel/r8169.fi
    if ven == r8169.VENDOR_REALTEK {
        if r8169.supports(dev) {
            if r8169.needs_cplus_rev(dev) && rev < 0x20 {
                return KIND_NONE // 8139A/B: keine Ringe, kein Treiber
            }
            return KIND_R8169
        }
        return KIND_NONE
    }
    // ---- 8086 Intel -- kernel/e1000.fi, zwei Familien in einer Datei
    if ven == e1000.VENDOR_INTEL {
        if e1000.supports_8254x(dev) {
            return KIND_E1000
        }
        if e1000.supports_ich(dev) {
            return KIND_I219
        }
        return KIND_NONE
    }
    return KIND_NONE
}

// WARUM NICHT, fuer die Chips, die dieser Kern immerhin ERKENNT. Das ist
// keine Hoeflichkeit: "I225 -- igc-Silizium, anderer Deskriptor" sagt
// einem Menschen vor einem Brett, dass er einen Treiber schreiben muss,
// waehrend "unbekannt" ihn zuerst zweifeln laesst, ob die Karte ueberhaupt
// steckt.
fn reason_for(ven: u64, dev: u64, rev: u64) -> u64 {
    // RUNDE BLECH: DIE LISTEN STEHEN NICHT MEHR HIER.
    //
    // Vorher standen in dieser Funktion vier Intel-Nummern als
    // Stichprobe -- 15F2, 15F3, 125B, 125C -- und ein I226-IT (125D)
    // fiel durch als "unbekannt". Das ist genau der Fall, den der
    // Eigner abgestellt haben wollte: ein Rechner, der schweigt, obwohl
    // der Chip bekannt ist.
    //
    // Jetzt fragt diese Funktion `chipname.fi`, und zwar mit `say =
    // false` -- dieselbe Nummernliste, die auch den Klarnamen druckt,
    // nur ohne zu drucken. Damit gibt es die Liste EINMAL. Eine zweite
    // Liste hier waere binnen einer Runde veraltet, und niemand haette
    // es gemerkt, weil beide fuer sich plausibel ausgesehen haetten.
    if ven == r8169.VENDOR_REALTEK {
        if dev == 0x8139 {
            return WHY_OLD8139
        }
        // Realtek baut auch WLAN. Wer im Laptop nur einen 8852BE hat,
        // soll nicht "unbekannt" lesen -- Ethernet fehlt dort schlicht.
        if dev == 0xC821 || dev == 0xC822 || dev == 0xB822 {
            return WHY_WIFI
        }
        if dev == 0xC852 || dev == 0xB852 {
            return WHY_WIFI
        }
        return WHY_OTHERVENDOR
    }
    if ven == e1000.VENDOR_INTEL {
        // Alle 16 igc-Nummern aus Linux' igc_hw.h.
        if chipname.intel_igc(dev, false) {
            return WHY_IGC
        }
        // Alle 32 igb-Nummern aus Linux' igb/e1000_hw.h.
        if chipname.intel_igb(dev, false) {
            return WHY_IGB
        }
        // Ein I219 kommt hier nur an, wenn `driver_for` ihn NICHT
        // genommen hat -- also genau die 33 Nummern, deren Bruecke
        // nicht freigegeben ist.
        if chipname.intel_i219(dev, false) {
            return WHY_I219GEN
        }
        if chipname.intel_wifi(dev, false) {
            return WHY_WIFI
        }
        return WHY_UNKNOWN
    }
    // Reine WLAN-Hersteller: Atheros/Qualcomm-Funk (168C) und MediaTek
    // (14C3). Dort ist "kein Ethernet" die richtige Auskunft.
    if ven == chipname.VEN_ATHEROS || ven == chipname.VEN_MEDIATEK {
        return WHY_WIFI
    }
    // Broadcom (14E4), Qualcomm-Ethernet/Killer (1969), Aquantia (1D6A),
    // Marvell (11AB), Nvidia (10DE), AMD/pcnet (1022), DEC/tulip (1011),
    // VMware (15AD).
    if ven == chipname.VEN_BROADCOM || ven == chipname.VEN_QUALCOMM {
        return WHY_OTHERVENDOR
    }
    if ven == chipname.VEN_AQUANTIA || ven == chipname.VEN_MARVELL {
        return WHY_OTHERVENDOR
    }
    if ven == chipname.VEN_AMD || ven == chipname.VEN_NVIDIA {
        return WHY_OTHERVENDOR
    }
    if ven == chipname.VEN_DEC || ven == chipname.VEN_VMWARE {
        return WHY_OTHERVENDOR
    }
    return WHY_UNKNOWN
}

fn print_reason(why: u64) {
    // DER ANFANG DIESER FUENF ZEICHENKETTEN IST FESTGENAGELT.
    // `tools/rtl/run.sh` prueft sechs von ihnen als Teilzeichenkette
    // direkt hinter "-> none  " ("igc silicon", "igb silicon", "wifi",
    // "other vendor", "rtl8139 rev < 0x20, no C+ mode"). Der Zusatz
    // dahinter darf wachsen; der Anfang nicht. Wer hier das erste Wort
    // aendert, macht sechs gruene Zusagen rot, ohne dass sich am
    // Verhalten irgendetwas geaendert haette.
    var s_igc: [u8; 79] = "igc silicon, advanced descriptors -- eigener Treiber noetig, e1000 passt NICHT\0"
    var s_igb: [u8; 74] = "igb silicon, other queue set -- eigener Treiber noetig, e1000 passt NICHT\0"
    var s_wifi: [u8; 58] = "wifi, needs 802.11 + fw -- 802.11-MAC und Firmware fehlen\0"
    var s_old: [u8; 52] = "rtl8139 rev < 0x20, no C+ mode -- nur der alte Ring\0"
    var s_oth: [u8; 55] = "other vendor, no driver -- kein Treiber in diesem Kern\0"
    if why == WHY_IGC {
        serial.puts((&s_igc[0]) as u64)
        return
    }
    if why == WHY_IGB {
        serial.puts((&s_igb[0]) as u64)
        return
    }
    if why == WHY_WIFI {
        serial.puts((&s_wifi[0]) as u64)
        return
    }
    if why == WHY_OLD8139 {
        serial.puts((&s_old[0]) as u64)
        return
    }
    if why == WHY_OTHERVENDOR {
        serial.puts((&s_oth[0]) as u64)
        return
    }
}

// ================================================= DIE TABELLE, GEPRUEFT
//
// Dieses Verzeichnis hat keinen RTL8168 und keinen I219, und es wird auch
// keinen bekommen. Was es aber pruefen KANN, ist die Wahl selbst: fuer
// jede Nummer aus der Liste unten steht hinterher auf der seriellen
// Leitung, welcher Treiber sie bekaeme. Das ist der Unterschied zwischen
// einer Tabelle, die jemand gelesen hat, und einer, die jemand ausgefuehrt
// hat.
//
//   netdev: tab 0x8086:0x15b7 rev=0x0 -> i219
//   netdev: tab 0x10ec:0x8168 rev=0x0 -> r8169
//   netdev: tab 0x8086:0x125b rev=0x0 -> none  igc silicon, ...
fn tab_line(ven: u64, dev: u64, rev: u64) {
    var s_t: [u8; 13] = "netdev: tab \0"
    var s_c: [u8; 2] = ":\0"
    var s_r: [u8; 7] = " rev=\0\0"
    var s_a: [u8; 5] = " -> \0"
    var s_s: [u8; 3] = "  \0"
    serial.puts((&s_t[0]) as u64)
    serial.hex(ven)
    serial.puts((&s_c[0]) as u64)
    serial.hex(dev)
    serial.puts((&s_r[0]) as u64)
    serial.hex(rev)
    serial.puts((&s_a[0]) as u64)
    let k: u64 = driver_for(ven, dev, rev)
    print_kind(k)
    // RUNDE BLECH: BEI REALTEK AUCH DIE SPIELART. "r8169" allein sagt
    // nicht, ob dieser Chip der in QEMU gemessene 8139C+ ist, der aus
    // dem Datenblatt gebaute 8168 oder der 8125, von dem hier niemand
    // je einen gesehen hat. Auf einem fremden Brett ist genau das die
    // Auskunft, die zaehlt.
    if k == KIND_R8169 {
        var s_v1: [u8; 20] = " (8139C+, gemessen)\0"
        var s_v2: [u8; 25] = " (8169/8168, Datenblatt)\0"
        var s_v3: [u8; 37] = " (8125/8126, Quelle, NICHT gemessen)\0"
        let v: u64 = r8169.variant_of(dev)
        if v == r8169.VAR_CP {
            serial.puts((&s_v1[0]) as u64)
        } else if v == r8169.VAR_8125 {
            serial.puts((&s_v3[0]) as u64)
        } else {
            serial.puts((&s_v2[0]) as u64)
        }
    }
    // Der Grund NUR, wenn es einen gibt. Zwei Leerzeichen hinter "none"
    // und dahinter nichts waeren eine Andeutung, die nichts sagt -- und
    // eine Zeile, deren Ende davon abhaengt, ob jemand den Chip kennt,
    // ist eine Zeile, auf die sich kein Test verlassen kann.
    if k == KIND_NONE {
        let why: u64 = reason_for(ven, dev, rev)
        if why != WHY_UNKNOWN {
            serial.puts((&s_s[0]) as u64)
            print_reason(why)
        }
    }
    // RUNDE BLECH, NACHTRAG: DER KLARNAME, UND ZWAR GANZ HINTEN.
    //
    // Er steht am ZEILENENDE und nicht in der Mitte, und das ist kein
    // Geschmack: `tools/rtl/run.sh` prueft dreizehn dieser Zeilen auf
    // ihren Anfang ("-> none  igc silicon"). Ein Name zwischen "none"
    // und dem Grund haette alle dreizehn rot gemacht -- fuer nichts.
    // Anhaengen kostet keine einzige bestehende Zusage.
    var s_kl: [u8; 3] = "  \0"
    var s_z1: [u8; 2] = "[\0"
    var s_z2: [u8; 2] = "]\0"
    var s_unk: [u8; 23] = "unbekannter Hersteller\0"
    // NACHTRAG: WER KEINEN NAMEN HAT, BEKOMMT AUCH KEINE KLAMMER.
    // Vorher stand hinter einer erfundenen Nummer "[unbekannter
    // Hersteller]" -- und damit HINTER "-> none" wieder Text, den die
    // Pruefung der RTL-Runde ausdruecklich verbietet: fuer eine Nummer,
    // die dieser Kern nicht kennt, darf er WEDER einen Grund NOCH einen
    // Namen behaupten. Schweigen ist hier die richtige Auskunft.
    if !chipname.has_name(ven, dev) {
        serial.nl()
        return
    }
    serial.puts((&s_kl[0]) as u64)
    serial.puts((&s_z1[0]) as u64)
    chipname.net(ven, dev)
    serial.puts((&s_z2[0]) as u64)
    serial.nl()
}

fn print_table(state: u64) {
    // Je EINE bekannte Nummer aus jeder Klasse, in der Reihenfolge der
    // Tabelle. Wer eine Zeile in `driver_for` ergaenzt, ergaenzt hier eine.
    tab_line(0x1AF4, 0x1000, 0x00) // virtio-net, uebergangsweise
    tab_line(0x1AF4, 0x1041, 0x01) // virtio-net, modern
    tab_line(0x8086, 0x100E, 0x03) // 82540EM -- QEMUs -device e1000
    tab_line(0x8086, 0x10D3, 0x00) // 82574L  -- QEMUs -device e1000e
    tab_line(0x8086, 0x15B7, 0x00) // I219-LM
    tab_line(0x8086, 0x15B8, 0x00) // I219-V
    tab_line(0x8086, 0x0D4E, 0x00) // I219-LM, Tiger Lake
    tab_line(0x10EC, 0x8139, 0x20) // RTL8139C+ -- mit C+-Modus
    tab_line(0x10EC, 0x8139, 0x10) // RTL8139B  -- OHNE C+-Modus
    tab_line(0x10EC, 0x8168, 0x00) // RTL8168/8111
    tab_line(0x10EC, 0x8169, 0x00) // RTL8169
    tab_line(0x10EC, 0x8136, 0x00) // RTL8101E/8102E
    tab_line(0x10EC, 0x8125, 0x00) // RTL8125  -- 2,5 Gbit, Runde BLECH
    tab_line(0x10EC, 0x8126, 0x00) // RTL8126  -- 5 Gbit
    tab_line(0x10EC, 0x3000, 0x00) // Killer E3100 -- ein 8125
    // --- RUNDE BLECH: die Familien, die der Eigner benannt hat. Kein
    //     Treiber (das war seine Entscheidung, und sie war richtig),
    //     aber ein Name und ein Grund.
    tab_line(0x8086, 0x15F3, 0x00) // I225-V
    tab_line(0x8086, 0x15F2, 0x00) // I225-LM
    tab_line(0x8086, 0x125C, 0x00) // I226-V
    tab_line(0x8086, 0x125B, 0x00) // I226-LM
    tab_line(0x8086, 0x1533, 0x00) // I210
    tab_line(0x8086, 0x1539, 0x00) // I211
    tab_line(0x8086, 0x1521, 0x00) // I350
    tab_line(0x8086, 0x2723, 0x00) // Wi-Fi 6 AX200
    tab_line(0x8086, 0x2725, 0x00) // Wi-Fi 6E AX210
    tab_line(0x8086, 0xA0F0, 0x00) // Wi-Fi 6 AX201
    tab_line(0x14E4, 0x165F, 0x00) // Broadcom BCM5720
    tab_line(0x1D6A, 0x07B1, 0x00) // Aquantia AQC107 10G
    tab_line(0x1D6A, 0x14C0, 0x00) // Aquantia AQC113 10G
    tab_line(0x1969, 0xE0B1, 0x00) // Killer E2600
    tab_line(0x10EC, 0x8029, 0x00) // ne2000 -- gleicher Hersteller, kein Treiber
    tab_line(0x14E4, 0x1686, 0x00) // Broadcom NetXtreme
    tab_line(0x1234, 0x5678, 0x00) // es gibt sie nicht: der unbekannte Fall
}

// Die Selbstpruefung der Treiber, so weit ein Treiber sie ohne Gegenstelle
// machen kann: voller Sendering und zu grosser Rahmen.
fn selftest(state: u64) {
    var c: u64 = 0
    while c < MAX_CARDS {
        let k: u64 = kind_on(state, c)
        if k == KIND_R8169 {
            r8169.print_regs_on(state, unit_of(state, c))
            r8169.selftest_on(state, unit_of(state, c))
        }
        c = c + 1
    }
}

fn note_unsupported(state: u64, ven: u64, dev: u64, why: u64) {
    let n: u64 = kstate.get(state, kstate.NETDEV_OFF + S_UNSUP_N)
    if n >= MAX_UNSUP {
        return
    }
    kstate.set(state, kstate.NETDEV_OFF + S_UNSUP + n * 24, ven)
    kstate.set(state, kstate.NETDEV_OFF + S_UNSUP + n * 24 + 8, dev)
    kstate.set(state, kstate.NETDEV_OFF + S_UNSUP + n * 24 + 16, why)
    kstate.set(state, kstate.NETDEV_OFF + S_UNSUP_N, n + 1)
}

fn unsupported_count(state: u64) -> u64 {
    if kstate.get(state, kstate.NETDEV_OFF + S_PROBED) == 0 {
        probe(state)
    }
    return kstate.get(state, kstate.NETDEV_OFF + S_UNSUP_N)
}

fn unsupported_vendor(state: u64, i: u64) -> u64 {
    return kstate.get(state, kstate.NETDEV_OFF + S_UNSUP + i * 24)
}

fn unsupported_device(state: u64, i: u64) -> u64 {
    return kstate.get(state, kstate.NETDEV_OFF + S_UNSUP + i * 24 + 8)
}

fn unsupported_reason(state: u64, i: u64) -> u64 {
    return kstate.get(state, kstate.NETDEV_OFF + S_UNSUP + i * 24 + 16)
}

// WHAT THE MACHINE SAYS ABOUT ITS OWN NETWORK. One line per card that
// has a driver, one line per card that does not -- WITH ITS NUMBERS, so
// that a board which does not work names the chip instead of going
// quiet. This is what will be read off a serial cable on real hardware.
fn print_cards(state: u64) {
    var s_have: [u8; 12] = "netdev: c\0\0\0"
    var s_eq: [u8; 2] = "=\0"
    var s_at: [u8; 6] = " bdf=\0"
    // ================================================================
    // DIESE ZEICHENKETTE IST EIN VERTRAG. NICHT UEBERSETZEN.
    // ================================================================
    // Drei Testdateien pruefen sie woertlich:
    //     tools/rtl/run.sh   Zeile 268   "netdev: no driver for 0x10ec:0x8029"
    //     tools/hwnet/run.sh Zeile 202   dieselbe Zeichenkette
    //     tools/usbimg/run.sh Zeile 277  "netdev: no driver for"
    //
    // Sie ist in dieser Runde ZWEIMAL nach "netdev: kein Treiber fuer"
    // eingedeutscht worden -- huebscher, und jedes Mal neun gruene
    // Zusagen rot, ohne dass sich am Verhalten das Geringste geaendert
    // haette. Das ist kein Fortschritt, das ist Umbenennen.
    //
    // WER DIE DEUTSCHE, MENSCHENLESBARE LISTE WILL, HAT SIE:
    // `print_inventory` weiter unten druckt genau das, mit Klarnamen,
    // ueber die GANZE PCI-Klasse 02, und ohne dass eine einzige
    // bestehende Zusage daran haengt. Dafuer ist sie gebaut.
    //
    // Regel fuer diese Zeile: der Anfang bleibt Wort fuer Wort der von
    // Runde HWNET, alles Neue haengt HINTEN dran.
    var s_no: [u8; 22] = "netdev: no driver for\0"
    var s_col: [u8; 2] = ":\0"
    var s_sp: [u8; 2] = " \0"
    if kstate.get(state, kstate.NETDEV_OFF + S_PROBED) == 0 {
        probe(state)
    }
    var s_vec: [u8; 7] = "  vec=\0"
    var s_poll: [u8; 31] = "  abgefragt (kein Vektor frei)\0"
    var s_ob: [u8; 2] = "[\0"
    var s_cb: [u8; 2] = "]\0"
    var c: u64 = 0
    while c < MAX_CARDS {
        let k: u64 = kstate.get(state, sc(c, S_KIND))
        if k != KIND_NONE {
            serial.puts((&s_have[0]) as u64)
            serial.dec(c)
            serial.puts((&s_eq[0]) as u64)
            print_kind(k)
            serial.puts((&s_at[0]) as u64)
            // OUT OF THE PCI TABLE and not out of the driver: this line
            // is printed BEFORE `init`, and a driver that has not run
            // has no address of its own yet.
            serial.hex(pci.get(state, kstate.get(state, sc(c, S_PCI)),
                pci.E_BDF))
            // RUNDE BLECH: UND WIE SIE SICH MELDET. Eine Karte ohne
            // Vektor laeuft -- nur langsamer, weil `netd` ihren Ring
            // abfragen muss. Das ist eine Auskunft, die auf einem
            // fremden Brett zaehlt: "die dritte Karte ist langsam" ist
            // ein Befund, "die dritte Karte ist kaputt" waere ein
            // Irrtum.
            let v: u64 = vector_for(c)
            if v == 0 {
                serial.puts((&s_poll[0]) as u64)
            } else {
                serial.puts((&s_vec[0]) as u64)
                serial.dec(v)
            }
            serial.nl()
        }
        c = c + 1
    }
    let m: u64 = kstate.get(state, kstate.NETDEV_OFF + S_UNSUP_N)
    var j: u64 = 0
    while j < m {
        let uven: u64 = unsupported_vendor(state, j)
        let udev: u64 = unsupported_device(state, j)
        serial.puts((&s_no[0]) as u64)
        serial.puts((&s_sp[0]) as u64)
        // Die Nummern in der Schreibweise, die seit Runde HWNET auf der
        // Leitung steht: `serial.hex` mit fuehrendem 0x und ohne
        // Auffuellen. NICHT `pci.hexn` -- das druckt "10ec" statt
        // "0x10ec", und genau darauf pruefen die drei Testdateien.
        serial.hex(uven)
        serial.puts((&s_col[0]) as u64)
        serial.hex(udev)
        // ROUND RTL: und WARUM nicht, wenn dieser Kern den Chip kennt.
        let why: u64 = unsupported_reason(state, j)
        if why != WHY_UNKNOWN {
            serial.puts((&s_sp[0]) as u64)
            serial.puts((&s_sp[0]) as u64)
            print_reason(why)
        }
        // Und der Klarname, hinten. Der Anfang der Zeile bleibt damit
        // Wort fuer Wort der von Runde HWNET; alles Neue haengt hinten
        // dran. Das ist die ganze Regel, nach der diese Runde Zeilen
        // erweitert.
        // Dieselbe Regel wie in `tab_line`: keine Klammer ohne Namen.
        // Eine leere Auskunft in eckigen Klammern sieht aus wie eine
        // Auskunft und ist keine.
        if chipname.has_name(uven, udev) {
            serial.puts((&s_sp[0]) as u64)
            serial.puts((&s_sp[0]) as u64)
            serial.puts((&s_ob[0]) as u64)
            chipname.net(uven, udev)
            serial.puts((&s_cb[0]) as u64)
        }
        serial.nl()
        j = j + 1
    }
}

// ================================================ DER EHRLICHE BESTAND
//
// Der Eigner hat es so formuliert: "Ein Rechner, auf dem Osum startet,
// soll dem Nutzer eine ehrliche Liste zeigen koennen: was ist verbaut,
// was davon laeuft, was nicht."
//
// `print_cards` kann das NICHT, und der Grund ist eine Luecke, die
// diese Runde erst beim Schreiben dieser Funktion gefunden hat:
// `probe` laeuft nur ueber Klasse 02 UNTERKLASSE 00 (Ethernet). Eine
// WLAN-Karte ist Klasse 02 Unterklasse 80 -- sie kommt in `probe` gar
// nicht vor, landet also auch nicht in der Liste der nicht
// unterstuetzten Geraete und wird schlicht VERSCHWIEGEN. In einem
// Notebook ist sie haeufig das einzige Netzgeraet. Der Rechner haette
// also gesagt: gar nichts.
//
// Diese Funktion laeuft deshalb ueber die GANZE Klasse 02 und fasst
// nichts an: sie liest die PCI-Liste und druckt. `probe` bleibt, wie
// es ist -- eine Suche, die ploetzlich WLAN-Karten beansprucht, waere
// eine Regression in 54 gruenen Abschnitten, und ein 802.11-Treiber
// steht hier nicht zur Debatte.
//
//   netdev: bestand 00:03.0 8086:100e Intel 82540EM -> e1000
//   netdev: bestand 00:04.0 8086:125c Intel I226-V (2,5G) -> kein Treiber
//   netdev: bestand 00:05.0 8086:2725 Intel Wi-Fi 6E AX210 (WLAN) -> kein Treiber
//   netdev: bestand 3 geraete, 1 mit treiber, 2 ohne
//
// Das Wort "bestand" statt "c0=" ist Absicht: `tools/rtl/run.sh` prueft
// mit `hasnot "$R" "netdev: c0="`, dass kein Treiber eine Karte
// beansprucht, die er nicht fahren kann. Eine neue Zeile mit "c0="
// darin haette diese Zusage falsch rot gemacht.
fn print_inventory(state: u64) {
    var s_b: [u8; 17] = "netdev: bestand \0"
    var s_c: [u8; 2] = ":\0"
    var s_sp: [u8; 2] = " \0"
    var s_ar: [u8; 5] = " -> \0"
    var s_dot: [u8; 2] = ".\0"
    var s_kt: [u8; 13] = "kein Treiber\0"
    var s_ko: [u8; 3] = ": \0"
    var s_wl: [u8; 22] = " (kein Ethernet-Port)\0"
    var s_ge: [u8; 11] = " geraete, \0"
    var s_mt: [u8; 15] = " mit treiber, \0"
    var s_oh: [u8; 6] = " ohne\0"
    if kstate.get(state, kstate.NETDEV_OFF + S_PROBED) == 0 {
        probe(state)
    }
    let n: u64 = pci.count(state)
    var i: u64 = 0
    var total: u64 = 0
    var driven: u64 = 0
    while i < n {
        if pci.get(state, i, pci.E_CLASS) == CLASS_NET {
            let ven: u64 = pci.get(state, i, pci.E_VENDOR)
            let dev: u64 = pci.get(state, i, pci.E_DEVICE)
            let sub: u64 = pci.get(state, i, pci.E_SUBCLASS)
            let bdf: u64 = pci.get(state, i, pci.E_BDF)
            total = total + 1
            serial.puts((&s_b[0]) as u64)
            // DIESELBE SCHREIBWEISE WIE `pci:` WEITER OBEN -- 00:03.0
            // und nicht 0x18. Wer die Bestandsliste neben die
            // PCI-Liste haelt, soll dieselbe Adresse zweimal lesen und
            // nicht zwei Zahlen vergleichen muessen, die dasselbe
            // meinen. `print_cards` behaelt sein `bdf=0x18`: darauf
            // pruefen bestehende Zusagen.
            pci.hexn(pci.bdf_bus(bdf), 2)
            serial.puts((&s_c[0]) as u64)
            pci.hexn(pci.bdf_dev(bdf), 2)
            serial.puts((&s_dot[0]) as u64)
            pci.hexn(pci.bdf_fn(bdf), 1)
            serial.puts((&s_sp[0]) as u64)
            pci.hexn(ven, 4)
            serial.puts((&s_c[0]) as u64)
            pci.hexn(dev, 4)
            serial.puts((&s_sp[0]) as u64)
            chipname.net(ven, dev)
            serial.puts((&s_ar[0]) as u64)
            // NUR Ethernet wird ueberhaupt einem Treiber angeboten.
            // Eine WLAN-Karte durch `driver_for` zu schicken waere
            // sinnlos und im schlimmsten Fall gefaehrlich: die
            // Nummernraeume sind je Hersteller getrennt, aber darauf
            // will sich hier niemand verlassen.
            if sub == SUB_ETHERNET {
                let rev: u64 = pci.cfg_read8(bdf, 0x08)
                let k: u64 = driver_for(ven, dev, rev)
                if k == KIND_NONE {
                    serial.puts((&s_kt[0]) as u64)
                    let why: u64 = reason_for(ven, dev, rev)
                    if why != WHY_UNKNOWN {
                        serial.puts((&s_ko[0]) as u64)
                        print_reason(why)
                    }
                } else {
                    driven = driven + 1
                    print_kind(k)
                }
            } else {
                serial.puts((&s_kt[0]) as u64)
                serial.puts((&s_wl[0]) as u64)
            }
            serial.nl()
        }
        i = i + 1
    }
    serial.puts((&s_b[0]) as u64)
    serial.dec(total)
    serial.puts((&s_ge[0]) as u64)
    serial.dec(driven)
    serial.puts((&s_mt[0]) as u64)
    serial.dec(total - driven)
    serial.puts((&s_oh[0]) as u64)
    serial.nl()
}

// ==================================================== THE DISPATCH
//
// Below this line every function is the same three lines: ask which
// driver owns the card, call it with ITS unit number. Nothing else may
// live here -- a dispatch layer that starts having opinions is a third
// driver.

// DER MELDEVEKTOR EINER KARTE, und diese Funktion ist der ganze Grund,
// warum `init_on` unten eine Zahl mehr weitergibt.
//
// `trap.fi` hat zwei Einsprungpunkte: Vektor 45 ruft `netdev.irq`
// (Karte 0) und Vektor 46 ruft `netdev.irq_on(state, 1)` (Karte 1).
// Mehr Stuempfe hat `isr.s` nicht, und diese Runde faesst `isr.s` nicht
// an. Also: Karte 0 und 1 bekommen einen Vektor, Karte 2 bis 7 die
// Null -- und die Null heisst in jedem Treiber "keine Unterbrechung
// scharfmachen".
//
// WARUM DAS UEBERHAUPT EINE FUNKTION IST. Vorher rechnete jeder Treiber
// `45 + u` aus SEINER Einheitennummer. Bei einem Brett mit einem
// Intel-Anschluss UND einer Realtek-Karte -- dem haeufigsten Fall
// ueberhaupt -- ist e1000-Einheit 0 die Karte 0 und r8169-Einheit 0 die
// Karte 1: beide haetten 45 gerechnet, und Karte 1 haette ihre
// Meldungen an Karte 0 geschickt.
fn vector_for(c: u64) -> u64 {
    if c < IRQ_CARDS {
        return VEC_NET + c
    }
    return 0
}

fn polled_on(state: u64, c: u64) -> bool {
    if c >= MAX_CARDS {
        return false
    }
    return kind_on(state, c) != KIND_NONE && c >= IRQ_CARDS
}

fn init_on(state: u64, c: u64, use_msix: bool, armed: bool) -> bool {
    let k: u64 = kind_on(state, c)
    let vec: u64 = vector_for(c)
    if vec == 0 {
        kstate.set(state, sc(c, S_POLLED), 1)
    } else {
        kstate.set(state, sc(c, S_POLLED), 0)
    }
    if k == KIND_VIRTIO {
        return virtio.init_on(state, unit_of(state, c), use_msix, armed, vec)
    }
    if k == KIND_E1000 || k == KIND_I219 {
        return e1000.init_on(state, unit_of(state, c), use_msix, armed, vec)
    }
    if k == KIND_R8169 {
        return r8169.init_on(state, unit_of(state, c), use_msix, armed, vec)
    }
    return false
}

fn present_on(state: u64, c: u64) -> bool {
    let k: u64 = kind_on(state, c)
    if k == KIND_VIRTIO {
        return virtio.present_on(state, unit_of(state, c))
    }
    if k == KIND_E1000 || k == KIND_I219 {
        return e1000.present_on(state, unit_of(state, c))
    }
    if k == KIND_R8169 {
        return r8169.present_on(state, unit_of(state, c))
    }
    return false
}

fn ready_on(state: u64, c: u64) -> bool {
    let k: u64 = kind_on(state, c)
    if k == KIND_VIRTIO {
        return virtio.ready_on(state, unit_of(state, c))
    }
    if k == KIND_E1000 || k == KIND_I219 {
        return e1000.ready_on(state, unit_of(state, c))
    }
    if k == KIND_R8169 {
        return r8169.ready_on(state, unit_of(state, c))
    }
    return false
}

fn up_on(state: u64, c: u64) -> bool {
    let k: u64 = kind_on(state, c)
    if k == KIND_VIRTIO {
        return virtio.up_on(state, unit_of(state, c))
    }
    if k == KIND_E1000 || k == KIND_I219 {
        return e1000.up_on(state, unit_of(state, c))
    }
    if k == KIND_R8169 {
        return r8169.up_on(state, unit_of(state, c))
    }
    return false
}

fn bdf_on(state: u64, c: u64) -> u64 {
    let k: u64 = kind_on(state, c)
    if k == KIND_VIRTIO {
        return virtio.bdf_on(state, unit_of(state, c))
    }
    if k == KIND_E1000 || k == KIND_I219 {
        return e1000.bdf_on(state, unit_of(state, c))
    }
    if k == KIND_R8169 {
        return r8169.bdf_on(state, unit_of(state, c))
    }
    return 0
}

fn idx_on(state: u64, c: u64) -> u64 {
    let k: u64 = kind_on(state, c)
    if k == KIND_VIRTIO {
        return virtio.idx_on(state, unit_of(state, c))
    }
    if k == KIND_E1000 || k == KIND_I219 {
        return e1000.idx_on(state, unit_of(state, c))
    }
    if k == KIND_R8169 {
        return r8169.idx_on(state, unit_of(state, c))
    }
    return pci.MAX_DEV
}

fn irqs_on(state: u64, c: u64) -> u64 {
    let k: u64 = kind_on(state, c)
    if k == KIND_VIRTIO {
        return virtio.irqs_on(state, unit_of(state, c))
    }
    if k == KIND_E1000 || k == KIND_I219 {
        return e1000.irqs_on(state, unit_of(state, c))
    }
    if k == KIND_R8169 {
        return r8169.irqs_on(state, unit_of(state, c))
    }
    return 0
}

fn rx_frames_on(state: u64, c: u64) -> u64 {
    let k: u64 = kind_on(state, c)
    if k == KIND_VIRTIO {
        return virtio.rx_frames_on(state, unit_of(state, c))
    }
    if k == KIND_E1000 || k == KIND_I219 {
        return e1000.rx_frames_on(state, unit_of(state, c))
    }
    if k == KIND_R8169 {
        return r8169.rx_frames_on(state, unit_of(state, c))
    }
    return 0
}

fn tx_frames_on(state: u64, c: u64) -> u64 {
    let k: u64 = kind_on(state, c)
    if k == KIND_VIRTIO {
        return virtio.tx_frames_on(state, unit_of(state, c))
    }
    if k == KIND_E1000 || k == KIND_I219 {
        return e1000.tx_frames_on(state, unit_of(state, c))
    }
    if k == KIND_R8169 {
        return r8169.tx_frames_on(state, unit_of(state, c))
    }
    return 0
}

