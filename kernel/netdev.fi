        return virtio.present_on(state, unit_of(state, c))
    }
    if k == KIND_E1000 || k == KIND_I219 {
        return e1000.present_on(state, unit_of(state, c))
    }
    if k == KIND_R8169 {
        return r8169.present_on(state, unit_of(state, c))
