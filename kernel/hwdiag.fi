// SPDX-License-Identifier: GPL-2.0-only
// kernel/hwdiag.fi -- RUNDE USBIMG: WAS IN DIESEM RECHNER STECKT.
//
// Dieses Modul beantwortet EINE Frage, und zwar auf einem Rechner, den
// niemand von uns je gesehen hat: welche Treiber braucht diese Maschine?
// Es tut das, indem es NUR liest -- kein Register wird gesetzt, kein
// Geraet angefasst, keine Zuteilung vorgenommen. Ein Diagnoselauf, der
// die Maschine veraendert, misst nicht mehr die Maschine.
//
// DIE AUSGABE GEHT AUF DIE SERIELLE SCHNITTSTELLE UND AUF DEN
// BILDSCHIRM, und zwar ohne dass hier zweimal gedruckt wuerde: seit
// Runde K7 spiegelt `fb.set_echo` jedes Oktett, das durch `serial.put`
// laeuft, in den Rahmenpuffer (`kmain.graphics`, ganz unten). Wer diesen
// Bericht auf dem Schirm sehen will, schreibt `gfx` auf die
// Kommandozeile; wer ihn im Kabel haben will, braucht gar nichts zu tun.
// Zwei Ausgabewege, EIN Aufruf -- die Alternative waere ein zweiter
// Satz Druckbefehle, der beim naechsten Zusatz auseinanderlaeuft.
//
// WAS BERICHTET WIRD, und warum genau das:
//
//   1. FIRMWARE (UEFI oder BIOS). Multiboot 1 sagt es NICHT -- es gibt
//      kein Feld dafuer, und `kernel/hwid.fi` haelt in seinem Kommentar
//      ausdruecklich fest, dass ein EFI-Systemtisch auf diesem Weg nie
//      ankommt. Also wird es GEMESSEN, an drei Spuren, die eine
//      UEFI-Firmware ohne CSM nicht hinterlaesst:
//        * die Signatur 0xAA55 am Anfang des VGA-ROMs bei 0xC0000,
//        * ein SMBIOS-Anker ("_SM_"/"_SM3_") im F-Segment,
//        * der ACPI-Zeiger "RSD PTR " in der EBDA oder im F-Segment.
//      DER BEFUND WIRD ALS BEFUND GEMELDET, nicht als Gewissheit: alle
//      drei Rohwerte stehen in der Zeile, und die Entscheidung darueber
//      steht daneben. Wer eine CSM-Firmware hat, sieht das an den
//      Rohwerten selbst.
//   2. CPU. Herstellerkennung aus `cpuid` Blatt 0, Familie/Modell/
//      Schrittzahl aus Blatt 1 -- MIT den erweiterten Feldern, denn ohne
//      sie ist jede moderne AMD-CPU "Familie 15" und jede Intel
//      "Familie 6". Dazu der Markenname aus 0x80000002..4, wenn die CPU
//      ihn hat.
//   3. SPEICHER. Was die Speicherkarte des Laders als benutzbar gemeldet
//      hat, und die hoechste Adresse darin.
//   4. RAHMENPUFFER. Aufloesung, Farbtiefe, Zeilenlaenge, Herkunft und
//      Adresse. Ohne diese Zeile weiss niemand, ob die Oberflaeche auf
//      dieser Maschine ueberhaupt etwas zum Zeichnen hat.
//   5. JEDES PCI-GERAET mit Hersteller:Geraet und Klasse/Unterklasse/
//      Schnittstelle. Das ist die Liste, aus der die Treiberarbeit
//      danach abgeleitet wird.
//   6. DER PLATTENCONTROLLER. NVMe, AHCI, IDE -- oder keiner. Ein
//      Rechner ohne erkannten Controller ist kein Absturz, sondern ein
//      Befund, und er wird als solcher gedruckt.
//   7. DIE NETZKARTE und WELCHER TREIBER SIE NIMMT. Das macht
//      `netdev.print_cards` seit Runde HWNET selbst, samt der Zeile
//      "netdev: no driver for <hersteller>:<geraet>" fuer jede Karte,
//      die dieser Kernel nicht bedienen kann. Hier wird sie GERUFEN und
//      nicht nachgebaut.
//
// UND ES HAENGT NICHT. Punkt 5 der Runde: findet der Kern keine Platte
// und keine Netzkarte, muss er das BENENNEN und weiterlaufen. Deshalb
// steht dieser Bericht in `kernel_main` VOR allen Stufen, die ein Geraet
// wirklich hochziehen (`netsvc.stage`, `hw.disk`, `usb_stage`), und
// deshalb ruft er nur lesende Funktionen. Was hier gedruckt ist, steht
// auf dem Schirm, bevor irgendetwas haengen kann.

import serial
// RUNDE MARKE: der Produktname kommt aus EINER Quelle.
import marke
import kstate
import pci
import netdev
import rootsel
import xhci
import gfx

export {
    stage, park_if_asked, park_after_usb, park_after_shell, report, wanted, park,
    firmware_bios, vga_rom_at, smbios_at, rsdp_at,
    cpu_vendor_ebx, cpu_is_amd, cpu_is_intel,
    cpu_family, cpu_model, cpu_stepping,
    storage_kind, S_NONE, S_NVME, S_AHCI, S_IDE, S_OTHER
}

// ------------------------------------------------------- die Suchraeume

const VGA_ROM: u64 = 0x000C0000
const BIOS_LOW: u64 = 0x000E0000
const BIOS_F: u64 = 0x000F0000
const BIOS_HIGH: u64 = 0x00100000
const EBDA_PTR: u64 = 0x0000040E

const S_NONE: u64 = 0
const S_NVME: u64 = 1
const S_AHCI: u64 = 2
const S_IDE: u64 = 3
const S_OTHER: u64 = 4

// ------------------------------------------------------- Zeichenketten

// Kommt `n` Oktette von `nadel` in der Zeichenkette `heu` vor? Eigene
// Fassung aus demselben Grund wie in `fb.fi`: dieses Modul darf
// `kmain.fi` nicht einbinden.
fn find(heu: u64, nadel: u64, n: u64) -> u64 {
    if heu == 0 || n == 0 {
        return 0
    }
    var i: u64 = 0
    while true {
        let c: u64 = kstate.get8(heu + i)
        if c == 0 {
            return 0
        }
        var k: u64 = 0
        var gleich: bool = true
        while k < n {
            let a: u64 = kstate.get8(heu + i + k)
            if a == 0 || a != kstate.get8(nadel + k) {
                gleich = false
                k = n
            } else {
                k = k + 1
            }
        }
        if gleich {
            return heu + i
        }
        i = i + 1
    }
    return 0
}

// Einen Anker suchen, der auf einer Sechzehnergrenze liegt. Sowohl der
// SMBIOS-Einstiegspunkt als auch der RSDP sind so ausgerichtet -- das
// steht in beiden Spezifikationen, und es macht aus einem Suchlauf ueber
// 64 KiB einen ueber 4096 Stellen.
fn scan16(from: u64, to: u64, want: u64, n: u64) -> u64 {
    var p: u64 = from
    while p + n <= to {
        var k: u64 = 0
        var gleich: bool = true
        while k < n {
            if kstate.get8(p + k) != kstate.get8(want + k) {
                gleich = false
                k = n
            } else {
                k = k + 1
            }
        }
        if gleich {
            return p
        }
        p = p + 16
    }
    return 0
}

// ------------------------------------------------------------ Firmware

// Die Signatur 0xAA55 am Anfang des VGA-Options-ROMs. Eine
// UEFI-Firmware ohne CSM legt dort nichts ab.
fn vga_rom_at() -> u64 {
    if kstate.get16(VGA_ROM) == 0xAA55 {
        return VGA_ROM
    }
    return 0
}

// Der SMBIOS-Einstiegspunkt im F-Segment. `kernel/hwid.fi` sucht ihn
// ebenfalls, aber es sucht ihn erst spaeter und es meldet ihn anders;
// hier wird die ROHE ADRESSE gebraucht, weil sie die halbe Begruendung
// des Firmware-Befunds ist.
fn smbios_at() -> u64 {
    var a3: [u8; 6] = "_SM3_\0"
    var a2: [u8; 5] = "_SM_\0"
    let h3: u64 = scan16(BIOS_F, BIOS_HIGH, (&a3[0]) as u64, 5)
    if h3 != 0 {
        return h3
    }
    return scan16(BIOS_F, BIOS_HIGH, (&a2[0]) as u64, 4)
}

// "RSD PTR " -- erst in der EBDA, dann im F-Segment. Dieselbe Reihenfolge
// wie in `kernel/acpi.fi`; sie ist die aus der ACPI-Spezifikation.
fn rsdp_at() -> u64 {
    var w: [u8; 9] = "RSD PTR \0"
    let p: u64 = (&w[0]) as u64
    let seg: u64 = kstate.get16(EBDA_PTR)
    if seg != 0 {
        let base: u64 = seg * 16
        let hit: u64 = scan16(base, base + 1024, p, 8)
        if hit != 0 {
            return hit
        }
    }
    return scan16(BIOS_LOW, BIOS_HIGH, p, 8)
}

// DER BEFUND, und er ist ein Befund und kein Beweis. Zwei der drei
// Spuren muessen fehlen, damit hier "UEFI" herauskommt -- eine einzelne
// fehlende Spur waere zu wenig, denn eine Maschine darf auch unter BIOS
// ohne VGA-ROM auskommen.
fn firmware_bios() -> bool {
    var n: u64 = 0
    if vga_rom_at() != 0 {
        n = n + 1
    }
    if smbios_at() != 0 {
        n = n + 1
    }
    if rsdp_at() != 0 {
        n = n + 1
    }
    return n >= 2
}

// ----------------------------------------------------------- CPUID
//
// `cpuid` schreibt ebx, und ebx ist das eine Register, das diese Sprache
// nicht herausgibt -- es traegt den Rahmen. Retten und zurueckholen ist
// der Weg, den `kernel/rand.fi` seit Runde K9 und `kernel/pwr.fi` seit
// Runde K18 gehen; hier steht er ein drittes Mal, weil beide Module ihn
// privat halten und ein Export dafuer eine Abhaengigkeit waere, die
// dieses Modul nicht haben soll.
//
// `xor ecx, ecx` VOR dem `cpuid`: die Blaetter, die hier gefragt werden,
// haben keine Unterblaetter, aber ein zufaelliges ecx aus dem Aufrufer
// waere trotzdem eine Wette.

fn cpuid_eax(leaf: u64) -> u64 {
    var v: u64 = 0
    asm("push rbx\nxor ecx, ecx\ncpuid\nmov rax, rax\npop rbx",
        in("rax") leaf, out("rax") & v, clobber("rcx"), clobber("rdx"))
    return v & 0xFFFFFFFF
}

fn cpuid_ebx(leaf: u64) -> u64 {
    var v: u64 = 0
    asm("push rbx\nxor ecx, ecx\ncpuid\nmov rax, rbx\npop rbx",
        in("rax") leaf, out("rax") & v, clobber("rcx"), clobber("rdx"))
    return v & 0xFFFFFFFF
}

fn cpuid_ecx(leaf: u64) -> u64 {
    var v: u64 = 0
    asm("push rbx\nxor ecx, ecx\ncpuid\nmov rax, rcx\npop rbx",
        in("rax") leaf, out("rax") & v, clobber("rcx"), clobber("rdx"))
    return v & 0xFFFFFFFF
}

fn cpuid_edx(leaf: u64) -> u64 {
    var v: u64 = 0
    asm("push rbx\nxor ecx, ecx\ncpuid\nmov rax, rdx\npop rbx",
        in("rax") leaf, out("rax") & v, clobber("rcx"), clobber("rdx"))
    return v & 0xFFFFFFFF
}

fn cpu_vendor_ebx() -> u64 {
    return cpuid_ebx(0)
}

// "Auth" und "Genu", die ersten vier Oktette der beiden Kennungen. Die
// Zahlen stehen hier als Zahlen und nicht als Zeichenketten, weil ein
// Vergleich auf ein Wort billiger ist als eine Schleife -- und weil
// genau diese beiden Werte in jedem Handbuch stehen.
fn cpu_is_amd() -> bool {
    return cpu_vendor_ebx() == 0x68747541
}

fn cpu_is_intel() -> bool {
    return cpu_vendor_ebx() == 0x756E6547
}

// DIE ERWEITERTEN FELDER SIND NICHT OPTIONAL. Ohne sie ist jeder Ryzen
// "Familie 15" und jeder Core "Familie 6, Modell 5" -- Zahlen, mit denen
// niemand einen Treiber auswaehlen kann.
fn cpu_family() -> u64 {
    let a: u64 = cpuid_eax(1)
    var f: u64 = (a >> 8) & 0xF
    if f == 0xF {
        f = f + ((a >> 20) & 0xFF)
    }
    return f
}

fn cpu_model() -> u64 {
    let a: u64 = cpuid_eax(1)
    let f: u64 = (a >> 8) & 0xF
    var m: u64 = (a >> 4) & 0xF
    if f == 0x6 || f == 0xF {
        m = m + (((a >> 16) & 0xF) << 4)
    }
    return m
}

fn cpu_stepping() -> u64 {
    return cpuid_eax(1) & 0xF
}

// Vier Oktette eines Registers, in der Reihenfolge, in der `cpuid` sie
// meint: das niedrigste zuerst.
fn store4(p: u64, v: u64) {
    kstate.set8(p, (v & 0xFF) as u8)
    kstate.set8(p + 1, ((v >> 8) & 0xFF) as u8)
    kstate.set8(p + 2, ((v >> 16) & 0xFF) as u8)
    kstate.set8(p + 3, ((v >> 24) & 0xFF) as u8)
}

// -------------------------------------------------------- Plattenklasse

// Was fuer ein Controller steht auf Eintrag `i` der Bustabelle? Die
// Zuordnung ist die aus der PCI-Klassenliste und dieselbe, die
// `pci.fi` in seiner Namensfunktion benutzt.
fn storage_kind(state: u64, i: u64) -> u64 {
    if pci.get(state, i, pci.E_CLASS) != pci.CLASS_STORAGE {
        return S_NONE
    }
    let sub: u64 = pci.get(state, i, pci.E_SUBCLASS)
    let pif: u64 = pci.get(state, i, pci.E_PROGIF)
    if sub == pci.SUB_NVM && pif == pci.PROGIF_NVME {
        return S_NVME
    }
    if sub == pci.SUB_SATA && pif == pci.PROGIF_AHCI {
        return S_AHCI
    }
    if sub == pci.SUB_IDE {
        return S_IDE
    }
    return S_OTHER
}

// ------------------------------------------------------- die Ausgabe

fn tag() {
    var s: [u8; 9] = "hwdiag: \0"
    serial.puts((&s[0]) as u64)
}

fn line(p: u64) {
    tag()
    serial.puts(p)
    serial.nl()
}

fn firmware_line() {
    var s_fw: [u8; 10] = "firmware=\0"
    var s_bios: [u8; 5] = "BIOS\0"
    var s_uefi: [u8; 5] = "UEFI\0"
    var s_vga: [u8; 10] = "  vgarom=\0"
    var s_sm: [u8; 10] = "  smbios=\0"
    var s_rs: [u8; 8] = "  rsdp=\0"
    var s_no: [u8; 5] = "nein\0"
    tag()
    serial.puts((&s_fw[0]) as u64)
    if firmware_bios() {
        serial.puts((&s_bios[0]) as u64)
    } else {
        serial.puts((&s_uefi[0]) as u64)
    }
    serial.puts((&s_vga[0]) as u64)
    let v: u64 = vga_rom_at()
    if v == 0 {
        serial.puts((&s_no[0]) as u64)
    } else {
        serial.hex(v)
    }
    serial.puts((&s_sm[0]) as u64)
    let s: u64 = smbios_at()
    if s == 0 {
        serial.puts((&s_no[0]) as u64)
    } else {
        serial.hex(s)
    }
    serial.puts((&s_rs[0]) as u64)
    let r: u64 = rsdp_at()
    if r == 0 {
        serial.puts((&s_no[0]) as u64)
    } else {
        serial.hex(r)
    }
    serial.nl()
}

fn cpu_lines() {
    var buf: [u8; 64] = [0 as u8; 64]
    var s_ven: [u8; 12] = "cpu vendor=\0"
    var s_mk: [u8; 14] = "  hersteller=\0"
    var s_amd: [u8; 4] = "AMD\0"
    var s_intel: [u8; 6] = "Intel\0"
    var s_unk: [u8; 10] = "unbekannt\0"
    var s_fam: [u8; 12] = "cpu family=\0"
    var s_mod: [u8; 9] = "  model=\0"
    var s_st: [u8; 12] = "  stepping=\0"
    var s_leaf: [u8; 11] = "  maxleaf=\0"
    var s_br: [u8; 11] = "cpu brand=\0"
    var s_nobr: [u8; 33] = "cpu brand=(die CPU nennt keinen)\0"

    let p: u64 = (&buf[0]) as u64
    store4(p, cpuid_ebx(0))
    store4(p + 4, cpuid_edx(0))
    store4(p + 8, cpuid_ecx(0))
    tag()
    serial.puts((&s_ven[0]) as u64)
    serial.text(p, 12)
    serial.puts((&s_mk[0]) as u64)
    if cpu_is_amd() {
        serial.puts((&s_amd[0]) as u64)
    } else {
        if cpu_is_intel() {
            serial.puts((&s_intel[0]) as u64)
        } else {
            serial.puts((&s_unk[0]) as u64)
        }
    }
    serial.nl()

    tag()
    serial.puts((&s_fam[0]) as u64)
    serial.dec(cpu_family())
    serial.puts((&s_mod[0]) as u64)
    serial.dec(cpu_model())
    serial.puts((&s_st[0]) as u64)
    serial.dec(cpu_stepping())
    serial.puts((&s_leaf[0]) as u64)
    serial.hex(cpuid_eax(0))
    serial.nl()

    // Der Markenname, 48 Oktette aus drei Blaettern. Eine CPU, die das
    // hoechste erweiterte Blatt nicht bis 0x80000004 fuehrt, hat keinen
    // -- und das ist eine Meldung und kein Fehler.
    if cpuid_eax(0x80000000) >= 0x80000004 {
        var l: u64 = 0x80000002
        var off: u64 = 0
        while l <= 0x80000004 {
            store4(p + off, cpuid_eax(l))
            store4(p + off + 4, cpuid_ebx(l))
            store4(p + off + 8, cpuid_ecx(l))
            store4(p + off + 12, cpuid_edx(l))
            off = off + 16
            l = l + 1
        }
        kstate.set8(p + 48, 0 as u8)
        tag()
        serial.puts((&s_br[0]) as u64)
        serial.puts(p)
        serial.nl()
    } else {
        line((&s_nobr[0]) as u64)
    }
}

fn mem_line(state: u64) {
    var s_a: [u8; 12] = "mem usable=\0"
    var s_b: [u8; 11] = " KiB  top=\0"
    var s_c: [u8; 10] = "  frames=\0"
    tag()
    serial.puts((&s_a[0]) as u64)
    serial.dec(kstate.get(state, kstate.MEM_USABLE) / 1024)
    serial.puts((&s_b[0]) as u64)
    serial.hex(kstate.get(state, kstate.MEM_TOP))
    serial.puts((&s_c[0]) as u64)
    serial.dec(kstate.get(state, kstate.BITMAP_FRAMES))
    serial.nl()
}

fn fb_line(state: u64) {
    var s_no: [u8; 52] = "fb=KEINER -- diese Maschine hat keinen Rahmenpuffer\0"
    var s_a: [u8; 4] = "fb \0"
    var s_x: [u8; 2] = "x\0"
    var s_bpp: [u8; 7] = "  bpp=\0"
    var s_p: [u8; 9] = "  pitch=\0"
    var s_s: [u8; 7] = "  src=\0"
    var s_mb: [u8; 10] = "multiboot\0"
    var s_vbe: [u8; 4] = "vbe\0"
    var s_ph: [u8; 8] = "  phys=\0"
    var s_cr: [u8; 13] = "  cols/rows=\0"
    var s_sl: [u8; 2] = "/\0"
    if !gfx.ready(state) {
        line((&s_no[0]) as u64)
        return
    }
    tag()
    serial.puts((&s_a[0]) as u64)
    serial.dec(gfx.width(state))
    serial.puts((&s_x[0]) as u64)
    serial.dec(gfx.height(state))
    serial.puts((&s_bpp[0]) as u64)
    serial.dec(gfx.fb_bpp(state))
    serial.puts((&s_p[0]) as u64)
    serial.dec(gfx.fb_pitch(state))
    serial.puts((&s_s[0]) as u64)
    if gfx.fb_from_multiboot(state) {
        serial.puts((&s_mb[0]) as u64)
    } else {
        serial.puts((&s_vbe[0]) as u64)
    }
    serial.puts((&s_ph[0]) as u64)
    serial.hex(gfx.fb_phys(state))
    serial.puts((&s_cr[0]) as u64)
    serial.dec(gfx.fb_cols(state))
    serial.puts((&s_sl[0]) as u64)
    serial.dec(gfx.fb_rows(state))
    serial.nl()
}

fn pci_lines(state: u64) {
    var s_n: [u8; 13] = "pci devices=\0"
    var s_d: [u8; 5] = "pci \0"
    var s_c: [u8; 9] = "  class=\0"
    var s_s: [u8; 6] = " sub=\0"
    var s_p: [u8; 7] = " prog=\0"
    var s_none: [u8; 43] = "pci=KEIN GERÄT -- der Bus antwortet nicht\0"
    let n: u64 = pci.count(state)
    tag()
    serial.puts((&s_n[0]) as u64)
    serial.dec(n)
    serial.nl()
    if n == 0 {
        line((&s_none[0]) as u64)
        return
    }
    var i: u64 = 0
    while i < n {
        let bdf: u64 = pci.get(state, i, pci.E_BDF)
        tag()
        serial.puts((&s_d[0]) as u64)
        pci.hexn(pci.bdf_bus(bdf), 2)
        serial.put(58 as u8)
        pci.hexn(pci.bdf_dev(bdf), 2)
        serial.put(46 as u8)
        pci.hexn(pci.bdf_fn(bdf), 1)
        serial.put(32 as u8)
        pci.hexn(pci.get(state, i, pci.E_VENDOR), 4)
        serial.put(58 as u8)
        pci.hexn(pci.get(state, i, pci.E_DEVICE), 4)
        serial.puts((&s_c[0]) as u64)
        pci.hexn(pci.get(state, i, pci.E_CLASS), 2)
        serial.puts((&s_s[0]) as u64)
        pci.hexn(pci.get(state, i, pci.E_SUBCLASS), 2)
        serial.puts((&s_p[0]) as u64)
        pci.hexn(pci.get(state, i, pci.E_PROGIF), 2)
        serial.nl()
        i = i + 1
    }
}

fn disk_lines(state: u64) {
    var s_nv: [u8; 17] = "disk NVMe   bdf=\0"
    var s_ah: [u8; 17] = "disk AHCI   bdf=\0"
    var s_id: [u8; 17] = "disk IDE    bdf=\0"
    var s_ot: [u8; 17] = "disk andere bdf=\0"
    var s_no: [u8; 50] = "disk=KEINER -- kein Plattencontroller auf dem Bus\0"
    let n: u64 = pci.count(state)
    var i: u64 = 0
    var gefunden: u64 = 0
    while i < n {
        let k: u64 = storage_kind(state, i)
        if k != S_NONE {
            gefunden = gefunden + 1
            tag()
            if k == S_NVME {
                serial.puts((&s_nv[0]) as u64)
            }
            if k == S_AHCI {
                serial.puts((&s_ah[0]) as u64)
            }
            if k == S_IDE {
                serial.puts((&s_id[0]) as u64)
            }
            if k == S_OTHER {
                serial.puts((&s_ot[0]) as u64)
            }
            serial.hex(pci.get(state, i, pci.E_BDF))
            serial.put(32 as u8)
            pci.hexn(pci.get(state, i, pci.E_VENDOR), 4)
            serial.put(58 as u8)
            pci.hexn(pci.get(state, i, pci.E_DEVICE), 4)
            serial.nl()
        }
        i = i + 1
    }
    if gefunden == 0 {
        // KEIN ABBRUCH. Punkt 5 der Runde: der Kern benennt es und laeuft
        // weiter, damit der Rest des Berichts lesbar bleibt.
        line((&s_no[0]) as u64)
    }
}

fn net_lines(state: u64) {
    var s_no: [u8; 45] = "net=KEINE KARTE -- kein Ethernet auf dem Bus\0"
    var s_hd: [u8; 32] = "net -- was netdev daraus macht:\0"
    // `probe` liest nur die Bustabelle, die `hw.stage` schon gefuellt
    // hat: kein Register wird angefasst, keine Karte hochgezogen. Es ist
    // dieselbe Entscheidung, die `netsvc.stage` spaeter noch einmal
    // trifft -- und weil sie beide Male aus derselben Tabelle kommt,
    // faellt sie beide Male gleich aus.
    netdev.probe(state)
    line((&s_hd[0]) as u64)
    netdev.print_cards(state)
    netdev.print_inventory(state)
    var i: u64 = 0
    var karten: u64 = 0
    let n: u64 = pci.count(state)
    while i < n {
        if pci.get(state, i, pci.E_CLASS) == 0x02 {
            karten = karten + 1
        }
        i = i + 1
    }
    if karten == 0 {
        line((&s_no[0]) as u64)
    }
}

// ------------------------------------------------------- der Bericht

fn report(state: u64) {
    // RUNDE MARKE: die Ueberschrift, die Justin auf dem ersten
    // Diagnosebild liest. Sie war fest getippt und auf 64 Spalten
    // ausgerichtet; ein Name anderer Laenge haette die Ausrichtung
    // ohnehin zerrissen. Jetzt wird sie zusammengesetzt -- feste
    // Balken links und rechts, der Name dazwischen.
    var s_top: [u8; 80] = [0 as u8; 80]
    var s_bal: [u8; 22] = "==================== \0"
    var s_bal2: [u8; 21] = "====================\0"
    var s_hd: [u8; 20] = " HARDWARE-DIAGNOSE \0"
    var tn: u64 = marke.anhaengen((&s_top[0]) as u64, 0,
        (&s_bal[0]) as u64, 79)
    tn = marke.anhaengen((&s_top[0]) as u64, tn, marke.produkt(), 79)
    tn = marke.anhaengen((&s_top[0]) as u64, tn, (&s_hd[0]) as u64, 79)
    tn = marke.anhaengen((&s_top[0]) as u64, tn, (&s_bal2[0]) as u64, 79)
    kstate.set8((&s_top[0]) as u64 + tn, 0)
    var s_end: [u8; 64] = "==================== ENDE DER DIAGNOSE ========================\0"
    line((&s_top[0]) as u64)
    firmware_line()
    cpu_lines()
    mem_line(state)
    fb_line(state)
    pci_lines(state)
    disk_lines(state)
    // RUNDE BLECH: WELCHES GERAET DIE WURZEL TRAGEN SOLL, und warum ein
    // gefundener Controller trotzdem nicht in Frage kommt. `disk_lines`
    // darueber sagt, WAS auf dem Bus steht; diese Zeile sagt, was der
    // Kern damit VORHAT -- und beim haeufigsten Startproblem eines
    // Notebooks (SATA im RAID-Modus) sagt sie, welche Einstellung im
    // BIOS zu aendern ist. Sie fasst nichts an: `rootsel.report` liest
    // dieselbe Bustabelle wie alles andere hier.
    rootsel.report(state)
    net_lines(state)
    usb_lines(state)
    line((&s_end[0]) as u64)
}

// =================================================== RUNDE BLECH-HID
//
// 8. USB, SO WIE DIE FIRMWARE ES HINTERLASSEN HAT.
//
// Der erste Blech-Lauf (03.09.2026) hat gezeigt, dass dieser Bericht
// eine Luecke hatte, die genau an der Stelle sass, an der es klemmte:
// er nannte die xHCI-Regler in der PCI-Liste und in `rootsel` -- und
// sagte kein Wort darueber, WEM sie gehoeren und ob an ihren
// Anschluessen Strom steht. Justins Tastatur ging im Startmenue des
// Laders und war tot, sobald Osum lief; die Maus leuchtete nicht
// einmal. Beide Saetze sind aus dieser Zeile ablesbar und aus keiner
// anderen.
//
// UND ES BLEIBT LESEND. `xhci.uebersicht` bildet den Registerbereich ab
// und liest ihn; kein Bit wird geschrieben, keine Uebernahme versucht.
// Die Uebernahme steht in `usb.stage` und wird dort berichtet -- was
// hier steht, ist der Zustand VORHER, und den kann nur ein Bericht
// liefern, der nichts anfasst.
fn usb_lines(state: u64) {
    xhci.uebersicht(state)
}

// Steht `hwdiag` auf der Kommandozeile?
fn wanted(cmd: u64) -> bool {
    var w: [u8; 7] = "hwdiag\0"
    if cmd == 0 {
        return false
    }
    return find(cmd, (&w[0]) as u64, 6) != 0
}

// DAS ANHALTEN. Punkt: ein Rechner, an dem KEIN serielles Kabel haengt,
// muss den Bericht LESBAR stehen lassen. Ohne das hier laeuft der Kern
// weiter bis `power.shutdown`, und was auf dem Schirm stand, ist weg,
// bevor jemand ein Foto machen konnte.
//
// `hlt` bei ausgeschalteten Unterbrechungen haelt den Prozessor
// endgueltig an -- an dieser Stelle in `kernel_main` ist das erste `sti`
// noch nicht gelaufen. Das ist ABSICHT und kein Aufhaengen: der
// Bildschirm bleibt stehen, bis jemand den Rechner ausschaltet, und
// genau das ist der Zweck. Die Zeile darueber sagt es auch.
fn park() {
    var m1: [u8; 45] = "ANGEHALTEN. Der Bildschirm bleibt so stehen.\0"
    var m2: [u8; 47] = "Rechner ausschalten, wenn alles abgelesen ist.\0"
    line((&m1[0]) as u64)
    line((&m2[0]) as u64)
    while true {
        asm("hlt")
    }
}

// Der Einstieg aus `kernel_main`. Ohne das Wort ist das hier ein
// Vergleich und sonst nichts -- jede Messung der Runden 59 bis HWNET
// sieht denselben Kern wie vorher.
fn stage(state: u64, cmd: u64) {
    if !wanted(cmd) {
        return
    }
    report(state)
}

// RUNDE MERGE-5: DAS ANHALTEN IST VOM BERICHT GETRENNT, UND ZWAR AUS
// EINEM GEMESSENEN GRUND.
//
// Bis hierher stand `park()` am Ende von `stage`, und `stage` steht in
// `kernel_main` VOR `fpu.apply` und `fpu.report` -- also hielt der
// Eintrag "Hardware-Diagnose (bleibt stehen)" auf dem Stick an, BEVOR
// die einzigen zwei Zeilen gedruckt waren, an denen sich die
// Vektoreinheit auf echtem Blech ablesen laesst:
//
//     fpu: mode=3  cr4=0x...  xcr0=0xe7  size=2696  lazy=0
//     fpu: f1c=...  f1d=...  f7b=...  sup=0xe7  need=2696
//
// Genau die verlangt `docs/AUFSETZEN.md`, Abschnitt 5, vom Eigner --
// und auf einem Rechner OHNE serielles Kabel waren sie nicht zu
// bekommen. Deshalb druckt `stage` jetzt nur noch, und angehalten wird
// mit `park_if_asked`, das `kernel_main` HINTER `fpu.report` und hinter
// der Vektorprobe aufruft.
//
// WAS DAZWISCHEN LIEGT UND WAS NICHT: zwischen den beiden Stellen
// stehen `fpu.apply`, `sched.init`, `user.setup`, `guard.apply` und die
// zwei Berichte -- alles Arbeit im Prozessor selbst. KEIN Treiber,
// KEINE Geraetesuche: `netsvc.stage` und `hw.disk` kommen erst weit
// danach. Der Grund, aus dem der Bericht frueh gedruckt wird (er soll
// auch dann dastehen, wenn die Maschine an einer fremden Karte haengt),
// bleibt damit unangetastet -- gedruckt wird weiterhin an derselben
// Stelle.
fn park_if_asked(state: u64, cmd: u64) {
    var w_stop: [u8; 11] = "hwdiagstop\0"
    if !wanted(cmd) {
        return
    }
    if find(cmd, (&w_stop[0]) as u64, 10) != 0 {
        park()
    }
}

// RUNDE BLECH-HID: DIE ZWEITE HALTESTELLE, HINTER DEM USB-BAUM.
//
// `hwdiagstop` haelt an, bevor irgendein Geraet hochgezogen wird -- das
// ist der Sinn dieses Eintrags und bleibt so. Was dabei fehlte, ist ein
// Weg, den USB-BERICHT stehen zu lassen: der entsteht in `usb.stage`,
// und das laeuft zweihundert Zeilen SPAETER als `park_if_asked`. Mit
// `usbstop` haelt der Kern dort an, wo die Antwort auf Justins Frage
// steht -- und weil das die letzte Ausgabe des Laufs ist, steht sie
// unten auf dem Schirm und nicht im weggescrollten Teil.
fn park_after_usb(state: u64) {
    if !kstate.mode_on(state, kstate.M_USBSTOP) {
        return
    }
    park()
}

// RUNDE BLECH-HID: dasselbe hinter dem Selbstlauf. Ein Rechner, dessen
// Tastatur nicht geht, kann nichts abfragen -- also muss das Ergebnis
// STEHEN BLEIBEN, bis jemand es fotografiert hat.
fn park_after_shell(state: u64) {
    if !kstate.mode_on(state, kstate.M_NETLAUF) {
        return
    }
    park()
}
