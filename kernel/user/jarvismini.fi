// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/jarvismini.fi -- JARVIS MINI (W-S5, stage S5 of docs/APP-WINDOW-OPTS.md): a small chat box in the corner of the work area.
//
//   jarvismini [--hidden] [--as-app]     the box (fUi, ring 3, profile app)
//   jarvismini serve [ticks]             headless test target of the hotkey gate (tools/hotkey/run.sh): only the bus action
//
// What the window is (all of it comes from the stages before):
//   - frameless, takes keys, translucent: ONE call `fuiscene.open_float` (WO_FRAMELESS | WO_KEYS | WO_OPAC, then the layer L_FLOAT --
//     needs the right `window.float`; without it the call is refused (E_RIGHTS) and the box falls back to an ordinary window on L_NORMAL)
//   - bottom right of the work area (WI_WORKX/Y/W/H), 12 px from the edges, and the height FOLLOWS THE CONTENT: the window is created at
//     its largest height, then text -> WM_SIZE -> WM_MOVE (pattern kernel/user/barpop.fi)
//   - the text colour follows the background: every 250 ms `wlibc.win_backlum` (the brightness BEHIND the window) goes through
//     `backlum.tc_update` (switch point, hysteresis, hold time); the tint behind the text is the opposite colour and its strength is
//     `backlum.scrim_alpha` of the worst sample (window opacity 150..235)
//   - ONE loop: fuiscene.pump + the chat connection (poll(2) without waiting, plain TCP, lines) + the bus (a.jarvismini, non-blocking)
//   - the action `jarvismini.toggle` (etc/actions.d/jarvismini.actions, key Ctrl+Alt+J through /bin/hotkeyd) hides / shows the box
//
// The chat source is "<ipv4> <port>" in /etc/jarvismini.conf (tools/jarvismini/stub.py in the gate). Lines typed in the box go out as
// text lines, every received line is shown as a reply (wrapped at 40 characters, the newest 64 lines are kept, 10 are visible).
// Every state change is one serial line `jarvismini: ...` (the gate reads them).
//
// `--as-app` (gate only): the process gives itself the label app:jarvismini and drops to uid 1000, so the right `window.float` is
// really checked (without the label and the uid the root rule applies and root may use any layer).

profile app

import ulib
import wlib
import wlibc
import fuiapp
import fuiscene
import actwire
import libc.kcall
import fui.backlum
import std.rt
import std.net

export { u_start }

// ------------------------------------------------------------------ layout (points)
const WPT: u64 = 320 // window width
const CVW: u64 = 308 // chat canvas and input width (window minus 2 * pad)
const LHP: u64 = 18 // one text line
const PADC: u64 = 6 // canvas padding top and bottom
const VIS_MAX: u64 = 10 // visible lines
const FRAME_PT: u64 = 52 // 6 pad + 4 gap + 36 entry + 6 pad
const HMAX_PT: u64 = 244 // FRAME_PT + VIS_MAX * LHP + 2 * PADC
const MARGIN: u64 = 12 // pixels from the work area edge (times the scale)
const WRAPC: u64 = 40 // characters per shown line
const MAXL: u64 = 64 // lines kept
const LW: u64 = 72 // bytes per kept line
const K_CHAT: u64 = 700
const K_IN: u64 = 701
const OP_MIN: u64 = 150
const OP_MAX: u64 = 235
const SYS_SETUID: u64 = 105

// ------------------------------------------------------------------ state
static mut L_TXT: [u8; 4608] = [0 as u8; 4608] // MAXL * LW
static mut L_WHO: [u8; 64] = [0 as u8; 64] // 0 = typed here, 1 = received, 2 = system
static mut L_N: u64 = 0
static mut IN_BUF: [u8; 128] = [0 as u8; 128]
static mut EMPTY: [u8; 2] = [0 as u8; 2]
static mut cv_hp: u64 = 0 // chat canvas height in points
static mut cur_hp: u64 = 0 // window height in points
static mut shown: u64 = 1
static mut app_mode: bool = false
static mut float_ok: bool = false
static mut tc: [u64; 4] = [0 as u64; 4]
static mut tc_ready: bool = false
static mut txt_col: u64 = 1 // backlum.TXT_WHITE / TXT_BLACK
static mut cur_opac: u64 = 200
static mut next_tick: u64 = 0
static mut next_beat: u64 = 0
static mut last_lum: u64 = 0

// chat connection
static mut conf_ip: u32 = 0
static mut conf_port: u64 = 0
static mut sock: i64 = -1
static mut next_try: u64 = 0
static mut RX: [u8; 600] = [0 as u8; 600]
static mut rx_n: u64 = 0

// bus
static mut state: u64 = 0 // the toggle state (serve mode: flips 0/1; box mode: 1 = shown)
static mut svc_bus: u64 = 0xFFFFFFFF
static mut bus_reg_ok: bool = false
static mut bus_hello: bool = false
static mut FR: [u8; 64] = [0 as u8; 64]
static mut META: [u64; 6] = [0 as u64; 6]

// one serial line, written with ONE write so that other writers tear it as little as possible
static mut LB: [u8; 200] = [0 as u8; 200]
static mut lb_n: u64 = 0

fn lb_str(s: str) {
    var i: u64 = 0
    while i < (s.n as u64) && lb_n < 190 {
        LB[lb_n as usize] = rt.ld8(s.p as u64, i as usize)
        lb_n = lb_n + 1
        i = i + 1
    }
}

fn lb_num(v: u64) {
    var d: [u8; 20] = [0 as u8; 20]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        d[0 as usize] = 48 as u8
        n = 1
    }
    while x > 0 && n < 20 {
        d[n as usize] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 && lb_n < 190 {
        n = n - 1
        LB[lb_n as usize] = d[n as usize]
        lb_n = lb_n + 1
    }
}

fn lb_begin() {
    lb_n = 0
    lb_str("jarvismini: ")
}

fn lb_end() {
    LB[lb_n as usize] = 10 as u8
    lb_n = lb_n + 1
    rt.write_everything(1, (&LB[0 as usize]) as u64, lb_n as usize)
    lb_n = 0
}

fn sk() -> u64 {
    return wlibc.ui_scale()
}

// ------------------------------------------------------------------ the lines
fn line_ptr(i: u64) -> u64 {
    return (&L_TXT[(i * LW) as usize]) as u64
}

fn push_line(who: u64, p: u64, n: u64) {
    if L_N >= MAXL {
        // the oldest line falls out: everything moves up by one
        var i: u64 = 1
        while i < MAXL {
            var k: u64 = 0
            while k < LW {
                L_TXT[((i - 1) * LW + k) as usize] = L_TXT[(i * LW + k) as usize]
                k = k + 1
            }
            L_WHO[(i - 1) as usize] = L_WHO[i as usize]
            i = i + 1
        }
        L_N = MAXL - 1
    }
    var m: u64 = n
    if m > LW - 1 {
        m = LW - 1
    }
    let dst: u64 = line_ptr(L_N)
    var j: u64 = 0
    while j < m {
        rt.st8(dst, j as usize, rt.ld8(p, j as usize))
        j = j + 1
    }
    rt.st8(dst, m as usize, 0 as u8)
    L_WHO[L_N as usize] = who as u8
    L_N = L_N + 1
}

// text (C string) -> lines of at most WRAPC characters, broken at a space where there is one
fn add_text(who: u64, p: u64) {
    let total: u64 = ulib.length(p)
    var pos: u64 = 0
    while pos < total {
        while pos < total && rt.ld8(p, pos as usize) == 32 as u8 {
            pos = pos + 1
        }
        if pos >= total {
            return
        }
        var end: u64 = pos + WRAPC
        if end >= total {
            end = total
        } else {
            var cut: u64 = end
            while cut > pos && rt.ld8(p, cut as usize) != 32 as u8 {
                cut = cut - 1
            }
            if cut > pos {
                end = cut
            }
        }
        push_line(who, p + pos, end - pos)
        pos = end
    }
}

fn vis_count() -> u64 {
    if L_N == 0 {
        return 1
    }
    if L_N > VIS_MAX {
        return VIS_MAX
    }
    return L_N
}

// ------------------------------------------------------------------ the picture
fn draw_chat(x: u64, y: u64, w: u64, h: u64) {
    let k: u64 = sk()
    var tint: u64 = 0x14181C
    var fg: u64 = 0xFFFFFF
    if txt_col == backlum.TXT_BLACK {
        tint = 0xF2F4F6
        fg = 0x000000
    }
    fuiscene.cv_rgb(x, y, w, h, tint)
    let n: u64 = vis_count()
    var start: u64 = 0
    if L_N > VIS_MAX {
        start = L_N - VIS_MAX
    }
    let px: u64 = wlibc.px_ui()
    let asc: u64 = wlibc.ascent_of(wlibc.F_UI, px)
    var r: u64 = 0
    while r < n && L_N > 0 {
        let li: u64 = start + r
        let ry: u64 = y + (PADC + r * LHP) * k
        if L_WHO[li as usize] == 0 as u8 {
            // what was typed here: a faint plate in the text colour (the scrim of the line)
            fuiscene.cv_round_a(x + 4 * k, ry, w - 8 * k, LHP * k, 4 * k, fg, 34)
        }
        let base: u64 = ry + (LHP * k + asc) / 2
        fuiscene.cv_text_rgb(x + 10 * k, base, w - 20 * k, line_ptr(li), px, false, fg)
        r = r + 1
    }
    if L_N == 0 {
        let base: u64 = y + (PADC * k) + (LHP * k + asc) / 2
        fuiscene.cv_text_rgb(x + 10 * k, base, w - 20 * k, (&HINT[0 as usize]) as u64, px, false, fg)
    }
    if L_N > VIS_MAX {
        // thin bar at the right edge: where the visible part lies in the kept lines
        let th: u64 = h - 2 * PADC * k
        let bh: u64 = th * VIS_MAX / L_N
        let by: u64 = y + PADC * k + (th - bh)
        fuiscene.cv_round_a(x + w - 4 * k, by, 2 * k, bh, k, fg, 90)
    }
}

static mut HINT: [u8; 30] = "JARVIS Mini - ask me anything\0"
static mut T_APP: [u8; 12] = "JARVIS Mini\0"

fn build() {
    let root: usize = fuiscene.root()
    fuiscene.set_pad(root, 6)
    fuiscene.set_gap(root, 4)
    let _c: usize = fuiscene.canvas(root, K_CHAT, CVW, cv_hp, draw_chat)
    let _e: usize = fuiscene.entry(root, K_IN, CVW, (&IN_BUF[0 as usize]) as u64)
}

// ------------------------------------------------------------------ geometry
fn place() {
    let h: u64 = fuiscene.handle()
    let k: u64 = sk()
    let wx: u64 = wlibc.win_info(h, wlibc.WI_WORKX)
    let wy: u64 = wlibc.win_info(h, wlibc.WI_WORKY)
    let ww: u64 = wlibc.win_info(h, wlibc.WI_WORKW)
    let wh: u64 = wlibc.win_info(h, wlibc.WI_WORKH)
    let bw: u64 = WPT * k
    let bh: u64 = cur_hp * k
    var x: u64 = wx
    var y: u64 = wy
    if ww > bw + MARGIN * k {
        x = wx + ww - bw - MARGIN * k
    }
    if wh > bh + MARGIN * k {
        y = wy + wh - bh - MARGIN * k
    }
    let _m: u64 = wlibc.win_move(h, x, y)
}

fn trace_geom() {
    let h: u64 = fuiscene.handle()
    lb_begin()
    lb_str("geom x=")
    lb_num(wlibc.win_info(h, wlibc.WI_X))
    lb_str(" y=")
    lb_num(wlibc.win_info(h, wlibc.WI_Y))
    lb_str(" w=")
    lb_num(wlibc.win_info(h, wlibc.WI_W))
    lb_str(" h=")
    lb_num(wlibc.win_info(h, wlibc.WI_H))
    lb_str(" layer=")
    lb_num(wlibc.win_info(h, wlibc.WI_LAYER))
    lb_str(" hidden=")
    lb_num(wlibc.win_info(h, wlibc.WI_HIDDEN))
    lb_str(" opac=")
    lb_num(wlibc.win_info(h, wlibc.WI_OPAC))
    lb_str(" lines=")
    lb_num(L_N)
    lb_str(" vis=")
    lb_num(vis_count())
    lb_str(" work=")
    lb_num(wlibc.win_info(h, wlibc.WI_WORKX))
    lb_str(",")
    lb_num(wlibc.win_info(h, wlibc.WI_WORKY))
    lb_str(",")
    lb_num(wlibc.win_info(h, wlibc.WI_WORKW))
    lb_str(",")
    lb_num(wlibc.win_info(h, wlibc.WI_WORKH))
    lb_end()
}

// The height follows the content: canvas height -> window height -> WM_SIZE -> new tree -> WM_MOVE (the corner stays).
fn relayout(force: bool) {
    let hp: u64 = vis_count() * LHP + 2 * PADC + FRAME_PT
    cv_hp = vis_count() * LHP + 2 * PADC
    if hp == cur_hp && !force {
        return
    }
    cur_hp = hp
    let k: u64 = sk()
    let _ok: bool = fuiscene.win_size(WPT * k, hp * k)
    fuiscene.refresh()
    place()
    trace_geom()
}

fn set_shown(on: u64) {
    let h: u64 = fuiscene.handle()
    var v: u64 = 1
    if on != 0 {
        v = 0
    }
    let _s: u64 = wlibc.win_state(h, wlibc.WS_HIDDEN, v)
}

// ------------------------------------------------------------------ the text colour that follows the background
fn adapt(now: u64) {
    if shown == 0 {
        return
    }
    let h: u64 = fuiscene.handle()
    let lum: u64 = wlibc.win_backlum(h, wlibc.WI_BACKLUM)
    if ulib.bad(lum) {
        return
    }
    last_lum = lum
    let tcp: u64 = (&tc[0 as usize]) as u64
    var col: u64 = txt_col
    if !tc_ready {
        backlum.tc_init(tcp, now, lum)
        tc_ready = true
        col = backlum.tc_color(tcp)
    } else {
        col = backlum.tc_update(tcp, now, lum)
    }
    let hi: u64 = wlibc.win_backlum(h, wlibc.WI_BACKLUM_HI)
    let lo: u64 = wlibc.win_backlum(h, wlibc.WI_BACKLUM_LO)
    var a: u64 = 0
    if !ulib.bad(hi) && !ulib.bad(lo) {
        a = backlum.scrim_alpha(lo, hi, col)
    }
    var op: u64 = a
    if op < OP_MIN {
        op = OP_MIN
    }
    if op > OP_MAX {
        op = OP_MAX
    }
    var changed: bool = false
    if col != txt_col {
        txt_col = col
        changed = true
    }
    var dop: u64 = op - cur_opac
    if cur_opac > op {
        dop = cur_opac - op
    }
    if dop >= 6 || changed {
        cur_opac = op
        let _o: u64 = wlibc.win_set_opac(h, op)
        changed = true
    }
    if changed {
        fuiscene.refresh()
        trace_text(now)
    }
}

fn trace_text(now: u64) {
    lb_begin()
    lb_str("text=")
    if txt_col == backlum.TXT_WHITE {
        lb_str("white")
    } else {
        lb_str("black")
    }
    lb_str(" lum=")
    lb_num(last_lum)
    lb_str(" flips=")
    lb_num(backlum.tc_flips((&tc[0 as usize]) as u64))
    lb_str(" opac=")
    lb_num(cur_opac)
    lb_end()
}

// ------------------------------------------------------------------ the chat connection
fn parse_conf() {
    conf_ip = 0 as u32
    conf_port = 0
    var b: rt.Buf = rt.buf_new()
    var path: [u8; 21] = "/etc/jarvismini.conf\0"
    if !rt.read_file((&path[0]) as u64, &b) {
        rt.buf_free(&b)
        return
    }
    var parts: [u32; 4] = [0 as u32; 4]
    var k: usize = 0
    var v: u64 = 0
    var i: u64 = 0
    var phase: u64 = 0
    var port: u64 = 0
    let n: u64 = b.len as u64
    while i < n && i < 60 {
        let c: u8 = rt.ld8(b.ptr, i as usize)
        if c == 10 as u8 || c == 0 as u8 {
            break
        }
        if phase == 0 {
            if c == 46 as u8 {
                if k < 3 {
                    parts[k] = v as u32
                }
                k = k + 1
                v = 0
            } else if c == 32 as u8 {
                if k == 3 {
                    parts[3 as usize] = v as u32
                }
                phase = 1
            } else if c >= 48 as u8 && c <= 57 as u8 {
                v = v * 10 + (c - 48 as u8) as u64
            }
        } else if c >= 48 as u8 && c <= 57 as u8 {
            port = port * 10 + (c - 48 as u8) as u64
        }
        i = i + 1
    }
    if k == 3 && port > 0 && phase == 1 {
        conf_ip = net.ipv4(parts[0 as usize] as u8, parts[1 as usize] as u8, parts[2 as usize] as u8, parts[3 as usize] as u8)
        conf_port = port
    }
    rt.buf_free(&b)
}

fn tcp_fail(bad: *mut bool) -> net.Conn {
    *bad = true
    return net.Conn { fd: -1, err: 0, peer: 0 as u32, peer_port: 0 as u16 }
}

fn sock_close() {
    if sock >= 0 {
        syscall(3, sock, 0, 0, 0, 0, 0)
    }
    sock = -1
    rx_n = 0
}

fn try_connect(now: u64) {
    if sock >= 0 || conf_port == 0 || now < next_try {
        return
    }
    next_try = now + 2000
    var bad: bool = false
    let c: net.Conn = net.connect_tcp_timeout(conf_ip, conf_port as u16, 600)
    catch | e | tcp_fail(&bad)
    if bad {
        return
    }
    sock = c.fd as i64
    rx_n = 0
    lb_begin()
    lb_str("net up")
    lb_end()
}

fn sock_ready() -> bool {
    var pfd: [u32; 2] = [0 as u32; 2]
    pfd[0 as usize] = sock as u32
    pfd[1 as usize] = 1 as u32 // events = POLLIN, revents = 0
    let r: i64 = syscall(7, (&pfd[0 as usize]) as i64, 1, 0, 0, 0, 0)
    return r > 0
}

// every complete line in RX becomes a reply
fn rx_lines() {
    var start: u64 = 0
    var i: u64 = 0
    while i < rx_n {
        if RX[i as usize] == 10 as u8 {
            RX[i as usize] = 0 as u8
            if i > start {
                add_text(1, (&RX[start as usize]) as u64)
            }
            start = i + 1
        }
        i = i + 1
    }
    if start > 0 {
        var k: u64 = 0
        while start + k < rx_n {
            RX[k as usize] = RX[(start + k) as usize]
            k = k + 1
        }
        rx_n = k
    }
    if rx_n >= 500 {
        RX[499 as usize] = 0 as u8
        add_text(1, (&RX[0 as usize]) as u64)
        rx_n = 0
    }
}

// returns true when something new arrived
fn net_poll(now: u64) -> bool {
    if sock < 0 {
        try_connect(now)
        return false
    }
    var got: bool = false
    var rounds: u64 = 0
    while rounds < 4 && sock >= 0 && sock_ready() {
        let room: u64 = 500 - rx_n
        let r: i64 = syscall(45, sock, ((&RX[0 as usize]) as u64 + rx_n) as i64, room as i64, 0, 0, 0)
        if r <= 0 {
            sock_close()
            lb_begin()
            lb_str("net down")
            lb_end()
            return got
        }
        rx_n = rx_n + (r as u64)
        rx_lines()
        got = true
        rounds = rounds + 1
    }
    return got
}

fn net_send(p: u64) {
    if sock < 0 {
        add_text(2, (&OFFLINE[0 as usize]) as u64)
        return
    }
    let n: u64 = ulib.length(p)
    let w: i64 = syscall(44, sock, p as i64, n as i64, 16384, 0, 0)
    var nl: [u8; 2] = [10 as u8, 0 as u8]
    let w2: i64 = syscall(44, sock, (&nl[0 as usize]) as i64, 1, 16384, 0, 0)
    if w < 0 || w2 < 0 {
        sock_close()
    }
}

static mut OFFLINE: [u8; 18] = "(no connection)\0\0\0"

// ------------------------------------------------------------------ the bus (a.jarvismini, never blocks in box mode)
fn handle(msg: u64) {
    var verb: [u8; 16] = [0 as u8; 16]
    var name: [u8; 40] = [0 as u8; 40]
    var k_ping: [u8; 5] = "ping\0"
    var a_tog: [u8; 18] = "jarvismini.toggle\0"
    var e_unk: [u8; 19] = "err unknown_action\0"
    var s_ok: [u8; 10] = "ok\nstate=\0"
    let vp: u64 = (&verb[0 as usize]) as u64
    let np: u64 = (&name[0 as usize]) as u64
    let nx: u64 = actwire.word_copy(msg, 0, vp, 16)
    actwire.word_copy(msg, nx, np, 40)
    actwire.ob_reset()
    if actwire.str_eq(vp, (&k_ping[0 as usize]) as u64) {
        actwire.ob_str((&k_ping[0 as usize]) as u64)
        return
    }
    if !actwire.str_eq(np, (&a_tog[0 as usize]) as u64) {
        actwire.ob_str((&e_unk[0 as usize]) as u64)
        actwire.ob_ch(10)
        return
    }
    state = 1 - state
    if app_mode {
        shown = state
        set_shown(state)
    }
    lb_begin()
    lb_str("toggle=")
    lb_num(state)
    lb_end()
    actwire.ob_str((&s_ok[0 as usize]) as u64)
    actwire.ob_num(state)
    actwire.ob_ch(10)
}

fn bus_open() {
    var n_me: [u8; 13] = "a.jarvismini\0"
    let me: u64 = actwire.bus_reg((&n_me[0 as usize]) as u64, actwire.A_ROOT)
    bus_reg_ok = !ulib.bad(me)
}

// one step: look for the broker (until it is there), then answer at most a few waiting messages. wait_ms = 0 never waits.
fn bus_step(wait_ms: u64) {
    var n_bus: [u8; 11] = "orient.bus\0"
    var s_hello: [u8; 17] = "hello jarvismini\n"
    if !bus_reg_ok {
        return
    }
    if ulib.bad(svc_bus) {
        svc_bus = actwire.bus_find((&n_bus[0 as usize]) as u64)
        if ulib.bad(svc_bus) {
            return
        }
    }
    if !bus_hello {
        bus_hello = true
        actwire.send_msg(svc_bus, actwire.K_REQ, actwire.rnd() & 0xFFFFFFFF, (&s_hello[0 as usize]) as u64, 16)
        lb_begin()
        lb_str("serving a.jarvismini")
        lb_end()
    }
    let fpp: u64 = (&FR[0 as usize]) as u64
    let mp: u64 = (&META[0 as usize]) as u64
    var rounds: u64 = 0
    while rounds < 4 {
        let n: u64 = actwire.bus_wait(fpp, mp, wait_ms)
        if ulib.bad(n) || n == 0 {
            return
        }
        let s: u64 = actwire.asm_feed(fpp, mp)
        if s != actwire.NONE {
            if actwire.asm_kind(s) == actwire.K_REQ {
                let id: u64 = actwire.asm_id(s)
                handle(actwire.asm_buf(s))
                actwire.send_msg(svc_bus, actwire.K_REP, id, actwire.ob_ptr(), actwire.ob_len())
            }
            actwire.asm_free(s)
        }
        rounds = rounds + 1
    }
}

// serve mode (the hotkey gate's test target): only the bus, blocks in the kernel while idle
fn serve(limit: u64) -> u64 {
    var n_me: [u8; 13] = "a.jarvismini\0"
    var n_bus: [u8; 11] = "orient.bus\0"
    var s_hello: [u8; 17] = "hello jarvismini\n"
    let me: u64 = actwire.bus_reg((&n_me[0 as usize]) as u64, actwire.A_ROOT)
    if ulib.bad(me) {
        return 1
    }
    let t0: u64 = actwire.ticks()
    svc_bus = actwire.bus_find((&n_bus[0 as usize]) as u64)
    while ulib.bad(svc_bus) && actwire.ticks() - t0 < 500 {
        actwire.yield_now()
        svc_bus = actwire.bus_find((&n_bus[0 as usize]) as u64)
    }
    if ulib.bad(svc_bus) {
        return 1
    }
    actwire.send_msg(svc_bus, actwire.K_REQ, actwire.rnd() & 0xFFFFFFFF, (&s_hello[0 as usize]) as u64, 16)
    lb_begin()
    lb_str("serving a.jarvismini")
    lb_end()
    let fpp: u64 = (&FR[0 as usize]) as u64
    let mp: u64 = (&META[0 as usize]) as u64
    let t1: u64 = actwire.ticks()
    while limit == 0 || actwire.ticks() - t1 < limit {
        let n: u64 = actwire.bus_wait(fpp, mp, 100)
        if !ulib.bad(n) && n > 0 {
            let s: u64 = actwire.asm_feed(fpp, mp)
            if s != actwire.NONE {
                if actwire.asm_kind(s) == actwire.K_REQ {
                    let id: u64 = actwire.asm_id(s)
                    handle(actwire.asm_buf(s))
                    actwire.send_msg(svc_bus, actwire.K_REP, id, actwire.ob_ptr(), actwire.ob_len())
                }
                actwire.asm_free(s)
            }
        }
    }
    return 0
}

// ------------------------------------------------------------------ the box
// gate only: label the process app:jarvismini and drop to uid 1000, so that the right window.float is checked for real
fn drop_to_app() -> bool {
    var lab: [u8; 32] = [0 as u8; 32]
    var nm: [u8; 12] = "jarvismini\0\0"
    lab[0 as usize] = 97 as u8
    lab[1 as usize] = 112 as u8
    lab[2 as usize] = 112 as u8
    lab[3 as usize] = 58 as u8
    let n: u64 = ulib.length((&nm[0 as usize]) as u64)
    ulib.copy((&lab[4 as usize]) as u64, (&nm[0 as usize]) as u64, n)
    if ulib.failed(ulib.sys(kcall.SYS_OSUM_ORIGIN, 1, (&lab[0 as usize]) as u64, n + 4)) {
        return false
    }
    return !ulib.bad(ulib.sys(SYS_SETUID, 1000, 0, 0))
}

fn run_box(hidden: bool, as_app: bool) -> u64 {
    app_mode = true
    if as_app {
        if !drop_to_app() {
            lb_begin()
            lb_str("label failed")
            lb_end()
            return 3
        }
    }
    parse_conf()
    bus_open()
    state = 1
    if hidden {
        state = 0
    }
    shown = state
    let k: u64 = sk()
    cv_hp = LHP + 2 * PADC
    cur_hp = 0
    // created at the LARGEST height (a window can shrink below its creation size for free, growing past it leaks the buffer)
    let bw: u64 = WPT * k
    let bh: u64 = HMAX_PT * k
    var x: u64 = 0
    var y: u64 = 0
    if wlibc.screen_w() > bw + MARGIN * k {
        x = wlibc.screen_w() - bw - MARGIN * k
    }
    if wlibc.screen_h() > bh + 40 * k {
        y = wlibc.screen_h() - bh - 40 * k
    }
    float_ok = fuiscene.open_float(x, y, bw, bh, (&T_APP[0 as usize]) as u64, 200, build)
    if !float_ok {
        lb_begin()
        lb_str("float refused: ordinary window")
        lb_end()
        // no right (E_RIGHTS): an ordinary window with a frame, so the person still has the box
        if !fuiscene.open(x / k, y / k, WPT, HMAX_PT, (&T_APP[0 as usize]) as u64, build) {
            return 2
        }
    }
    fuiscene.set_app((&T_APP[0 as usize]) as u64)
    fuiscene.focus(K_IN)
    // the first picture at the creation size, then the real height
    let _p: u64 = fuiscene.pump()
    if float_ok {
        relayout(true)
    } else {
        cur_hp = HMAX_PT
        trace_geom()
    }
    set_shown(state)
    if conf_port == 0 {
        add_text(2, (&OFFLINE[0 as usize]) as u64)
    }
    lb_begin()
    lb_str("up float=")
    lb_num(float_ok as u64)
    lb_str(" bus=")
    lb_num(bus_reg_ok as u64)
    lb_str(" net=")
    lb_num(conf_port)
    lb_end()
    var seen_lines: u64 = L_N
    while fuiscene.alive() {
        let key: u64 = fuiscene.pump()
        let now: u64 = fuiapp.now_ms()
        var dirty: bool = false
        if key == K_IN {
            let t: u64 = fuiscene.entry_text(K_IN)
            if t != 0 && ulib.length(t) > 0 {
                add_text(0, t)
                net_send(t)
                lb_begin()
                lb_str("sent len=")
                lb_num(ulib.length(t))
                lb_end()
                fuiscene.entry_set(K_IN, (&EMPTY[0 as usize]) as u64)
                dirty = true
            }
        }
        bus_step(0)
        if net_poll(now) {
            dirty = true
        }
        if L_N != seen_lines {
            seen_lines = L_N
            dirty = true
        }
        if dirty && float_ok {
            relayout(false)
            fuiscene.refresh()
            lb_begin()
            lb_str("lines=")
            lb_num(L_N)
            lb_str(" h=")
            lb_num(cur_hp)
            lb_end()
        } else if dirty {
            fuiscene.refresh()
        }
        if now >= next_tick {
            next_tick = now + 250
            if float_ok {
                adapt(now)
            }
        }
        if now >= next_beat {
            next_beat = now + 3000
            trace_geom()
            trace_text(now)
        }
    }
    sock_close()
    return 0
}

fn u_start(args: u64) -> u64 {
    var c_serve: [u8; 6] = "serve\0"
    var c_hidden: [u8; 9] = "--hidden\0"
    var c_asapp: [u8; 9] = "--as-app\0"
    if ulib.arg_count(args) >= 2 && actwire.str_eq(ulib.arg_at(args, 1), (&c_serve[0 as usize]) as u64) {
        var lim: u64 = 0
        if ulib.arg_count(args) >= 3 {
            lim = ulib.to_num(ulib.arg_at(args, 2))
        }
        return serve(lim)
    }
    var hidden: bool = false
    var as_app: bool = false
    var i: u64 = 1
    while i < ulib.arg_count(args) {
        if actwire.str_eq(ulib.arg_at(args, i), (&c_hidden[0 as usize]) as u64) {
            hidden = true
        }
        if actwire.str_eq(ulib.arg_at(args, i), (&c_asapp[0 as usize]) as u64) {
            as_app = true
        }
        i = i + 1
    }
    return run_box(hidden, as_app)
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
