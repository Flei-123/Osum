// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/burn.fi -- round POWERMON: the program that does nothing,
// for as long as it is told to, without ever giving the processor back.
//
//     burn N       count to N million and leave
//
// WHY A PROGRAM LIKE THIS IS NEEDED FOR A MEASUREMENT. The claim of
// round POWERMON is that a busy program's share of the measured draw
// rises and that the shares still add up to a hundred. Proving it needs
// a program whose processor time is KNOWN TO BE LARGE and known to be
// nothing else: `ls` spends most of its life waiting on a disk, so it is
// asleep, so it collects almost no timer ticks -- which is the correct
// answer for `ls` and useless as a test.
//
// So this one holds the processor and does arithmetic. No system call
// inside the loop (a call could block and hand the processor away), no
// memory it did not get at the start, nothing on the screen until it is
// done. What the accounting sees is a task that is runnable on every
// single timer tick, which is the top of the range, and the run measures
// what its share does.
//
// THE RESULT IS NOT THROWN AWAY. A loop whose result nobody looks at is
// a loop a compiler is entitled to delete, and a benchmark that measured
// a deleted loop has measured nothing. The sum is printed.

profile kernel

import ulib

export { u_start }

fn u_start(args: u64) -> u64 {
    var s_sum: [u8; 13] = "burn: sum=\0\0\0"
    var s_n: [u8; 8] = " loops=\0"
    let argc: u64 = ulib.arg_count(args)
    var millions: u64 = 4
    if argc > 1 {
        let v: u64 = ulib.to_num(ulib.arg_at(args, 1))
        if v != 0 {
            millions = v
        }
    }
    let n: u64 = millions * 1000000
    // Something with a carried dependency, so that no amount of
    // reordering turns it into a constant.
    var acc: u64 = 1
    var i: u64 = 0
    while i < n {
        acc = acc +% (i ^ (acc >> 3)) +% 1
        i = i + 1
    }
    ulib.say((&s_sum[0 as usize]) as u64)
    ulib.sayu(acc)
    ulib.say((&s_n[0 as usize]) as u64)
    ulib.sayu(n)
    ulib.nl()
    return 0
}
