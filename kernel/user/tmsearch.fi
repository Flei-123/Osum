// SPDX-License-Identifier: GPL-2.0-only
profile kernel

export { contains_ci, pid_text, matches }

static mut dec: [u8; 24] = [0 as u8; 24]

fn rd8(p: u64) -> u64 {
    let c: u8 = __mmio_read8((p) as *mut u8)
    return c as u64
}

fn lower(c: u64) -> u64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

fn contains_ci(hay: u64, needle: u64) -> bool {
    if rd8(needle) == 0 {
        return true
    }
    var i: u64 = 0
    while rd8(hay + i) != 0 {
        var j: u64 = 0
        while rd8(needle + j) != 0 && rd8(hay + i + j) != 0 && lower(rd8(hay + i + j)) == lower(rd8(needle + j)) {
            j = j + 1
        }
        if rd8(needle + j) == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn pid_text(pid: u64) -> u64 {
    dec[(23) as usize] = 0 as u8
    if pid == 0 {
        dec[(22) as usize] = 48 as u8
        return (&dec[(22) as usize]) as u64
    }
    var at: u64 = 22
    var v: u64 = pid
    while v > 0 && at > 0 {
        dec[(at) as usize] = (48 + v % 10) as u8
        v = v / 10
        at = at - 1
    }
    return (&dec[(at + 1) as usize]) as u64
}

fn matches(name: u64, pid: u64, needle: u64) -> bool {
    if rd8(needle) == 0 {
        return true
    }
    if contains_ci(name, needle) {
        return true
    }
    return contains_ci(pid_text(pid), needle)
}
