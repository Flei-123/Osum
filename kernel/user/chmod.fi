// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/chmod.fi -- Runde K13: die Rechtebits einer Datei setzen.
//
//     chmod 644 datei ...
//     chmod 4755 /bin/passwd        (das setuid-Bit)
//     chmod u+x,go-w datei          (die Buchstabenform)
//
// Die OKTALE Form setzt alles, die BUCHSTABENFORM aendert nur, was
// dasteht -- das ist der Unterschied, an dem man sich verrechnet, wenn
// man nur eine von beiden hat. `chmod 755` auf eine Datei mit setuid-Bit
// nimmt das Bit weg (es steht nicht in der Zahl), `chmod u+x` laesst es
// stehen. Beides ist so gewollt und so gemessen.

profile kernel

import ulib
import tools

export { u_start }

const SYS_CHMOD: u64 = 90
const SYS_STAT: u64 = 4

fn mode_of(path: u64) -> u64 {
    var st: [u8; 144] = [0 as u8; 144]
    let r: u64 = ulib.sys(SYS_STAT, path, (&st[0]) as u64, 0)
    if ulib.bad(r) {
        return ulib.EOF
    }
    return ((*((&st[24]) as *mut u32)) as u64) & 4095
}

// Eine oktale Zahl, oder EOF wenn es keine ist.
fn octal(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    if *((p) as *mut u8) == 0 as u8 {
        return ulib.EOF
    }
    while *((p + i) as *mut u8) != 0 as u8 {
        let c: u64 = (*((p + i) as *mut u8)) as u64
        if c < 48 || c > 55 {
            return ulib.EOF
        }
        v = v * 8 + (c - 48)
        i = i + 1
    }
    if i > 5 {
        return ulib.EOF
    }
    return v & 4095
}

// Die Buchstabenform: [ugoa][+-=][rwxst], durch Komma getrennt.
fn symbolic(spec: u64, old: u64) -> u64 {
    var mode: u64 = old
    var at: u64 = 0
    var going: bool = true
    while going {
        var who: u64 = 0
        while *((spec + at) as *mut u8) == 117 as u8
            || *((spec + at) as *mut u8) == 103 as u8
            || *((spec + at) as *mut u8) == 111 as u8
            || *((spec + at) as *mut u8) == 97 as u8 {
            let c: u64 = (*((spec + at) as *mut u8)) as u64
            if c == 117 {
                who = who | 4
            }
            if c == 103 {
                who = who | 2
            }
            if c == 111 {
                who = who | 1
            }
            if c == 97 {
                who = who | 7
            }
            at = at + 1
        }
        if who == 0 {
            who = 7
        }
        let op: u64 = (*((spec + at) as *mut u8)) as u64
        if op != 43 && op != 45 && op != 61 {
            return ulib.EOF
        }
        at = at + 1
        var bits: u64 = 0
        var special: u64 = 0
        while *((spec + at) as *mut u8) != 0 as u8
            && *((spec + at) as *mut u8) != 44 as u8 {
            let c: u64 = (*((spec + at) as *mut u8)) as u64
            if c == 114 {
                bits = bits | 4
            } else {
                if c == 119 {
                    bits = bits | 2
                } else {
                    if c == 120 {
                        bits = bits | 1
                    } else {
                        if c == 115 {
                            special = special | 3072 // setuid + setgid
                        } else {
                            if c == 116 {
                                special = special | 512
                            } else {
                                return ulib.EOF
                            }
                        }
                    }
                }
            }
            at = at + 1
        }
        var mask: u64 = 0
        if (who & 4) != 0 {
            mask = mask | (bits << 6)
        }
        if (who & 2) != 0 {
            mask = mask | (bits << 3)
        }
        if (who & 1) != 0 {
            mask = mask | bits
        }
        if op == 43 {
            mode = mode | mask | special
        }
        if op == 45 {
            mode = mode & (~(mask | special))
        }
        if op == 61 {
            var keep: u64 = 0
            if (who & 4) == 0 {
                keep = keep | (mode & 448)
            }
            if (who & 2) == 0 {
                keep = keep | (mode & 56)
            }
            if (who & 1) == 0 {
                keep = keep | (mode & 7)
            }
            mode = keep | mask | special
        }
        if *((spec + at) as *mut u8) == 44 as u8 {
            at = at + 1
        } else {
            going = false
        }
    }
    return mode & 4095
}

fn u_start(args: u64) -> u64 {
    var e_use: [u8; 29] = "chmod: chmod RECHTE DATEI...\0"
    var e_bad: [u8; 22] = "chmod: bad mode: \0\0\0\0\0"
    var e_fail: [u8; 9] = "chmod: \0\0"
    let n: u64 = ulib.arg_count(args)
    if n < 3 {
        ulib.esay_line((&e_use[0]) as u64, 0)
        return 2
    }
    let spec: u64 = ulib.arg_at(args, 1)
    let oct: u64 = octal(spec)
    var rc: u64 = 0
    var i: u64 = 2
    while i < n {
        let path: u64 = ulib.arg_at(args, i)
        var mode: u64 = oct
        if oct == ulib.EOF {
            let old: u64 = mode_of(path)
            if old == ulib.EOF {
                ulib.esay_line((&e_fail[0]) as u64, path)
                rc = 1
                mode = ulib.EOF
            } else {
                mode = symbolic(spec, old)
                if mode == ulib.EOF {
                    ulib.esay_line((&e_bad[0]) as u64, spec)
                    return 2
                }
            }
        }
        if mode != ulib.EOF {
            if ulib.bad(ulib.sys(SYS_CHMOD, path, mode, 0)) {
                ulib.esay_line((&e_fail[0]) as u64, path)
                rc = 1
            }
        }
        i = i + 1
    }
    return rc
}
