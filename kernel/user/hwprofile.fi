profile kernel

import ulib
import hwprof.hwp_out
import hwprof.hwp_plan
import hwprof.hwp_report
import hwprof.hwp_stage

export { u_start }

const EXIT_OK: u64 = 0
const EXIT_FAIL: u64 = 1
const EXIT_USAGE: u64 = 2

fn flag(args: u64, argc: u64, word: u64) -> bool {
    var i: u64 = 1
    while i < argc {
        if ulib.streq(ulib.arg_at(args, i), word) {
            return true
        }
        i = i + 1
    }
    return false
}

fn option_value(args: u64, argc: u64, word: u64) -> u64 {
    var i: u64 = 1
    while i + 1 < argc {
        if ulib.streq(ulib.arg_at(args, i), word) {
            return ulib.arg_at(args, i + 1)
        }
        i = i + 1
    }
    return 0
}

fn show() {
    ulib.put(hwp_out.text_ptr(), hwp_out.text_len())
}

fn u_start(args: u64) -> u64 {
    var w_scan: [u8; 5] = "scan\0"
    var w_unknown: [u8; 8] = "unknown\0"
    var w_stage: [u8; 6] = "stage\0"
    var w_prune: [u8; 8] = "--prune\0"
    var w_pool: [u8; 7] = "--pool\0"
    var m_usage: [u8; 65] = "usage: hwprofile [scan | unknown | stage [--pool DIR] [--prune]]\0"
    var m_fail: [u8; 29] = "hwprofile: cannot write file\0"
    var m_staged: [u8; 19] = "hwprofile: staged \0"
    var m_failed: [u8; 9] = " failed \0"
    let argc: u64 = ulib.arg_count(args)
    let pool: u64 = option_value(args, argc, (&w_pool[0 as usize]) as u64)
    if pool != 0 {
        hwp_plan.set_pool(pool)
    }
    var cmd: u64 = (&w_scan[0 as usize]) as u64
    if argc >= 2 {
        cmd = ulib.arg_at(args, 1)
    }
    if ulib.streq(cmd, (&w_scan[0 as usize]) as u64) {
        hwp_plan.build()
        hwp_report.profile_text()
        show()
        return EXIT_OK
    }
    if ulib.streq(cmd, (&w_unknown[0 as usize]) as u64) {
        hwp_plan.build()
        hwp_report.unknown_text()
        show()
        return EXIT_OK
    }
    if ulib.streq(cmd, (&w_stage[0 as usize]) as u64) {
        let good: bool = hwp_stage.run(flag(args, argc, (&w_prune[0 as usize]) as u64))
        ulib.say((&m_staged[0 as usize]) as u64)
        ulib.sayu(hwp_stage.n_staged())
        ulib.say((&m_failed[0 as usize]) as u64)
        ulib.sayu(hwp_stage.n_failed())
        ulib.nl()
        if !good {
            ulib.esay_line((&m_fail[0 as usize]) as u64, 0)
            return EXIT_FAIL
        }
        return EXIT_OK
    }
    ulib.esay_line((&m_usage[0 as usize]) as u64, 0)
    return EXIT_USAGE
}

fn main() -> i32 {
    return u_start(ulib.ARGS_BASE) as i32
}
