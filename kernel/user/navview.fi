// SPDX-License-Identifier: GPL-2.0-only
import fuiscene
import msg
import nav.reg
import nav.crumbs
import nav.route

export {
    ACT_NONE, ACT_BACK, ACT_FORWARD, ACT_UP, ACT_CRUMB, ACT_RELATED, set_keys, set_related_key, set_related_short_ok, related_rows,
    related_uri, related_uri_len, toolbar, crumbs_row, shown_count,
    action_of, crumb_target_len,
}

const ACT_NONE: u64 = 0
const ACT_BACK: u64 = 1
const ACT_FORWARD: u64 = 2
const ACT_UP: u64 = 3
const ACT_CRUMB: u64 = 4
const ACT_RELATED: u64 = 5
const REL_MAX: u64 = 4
const SHOW_MAX: u64 = 5
const SEG_W: u64 = 64

static mut k_back: u64 = 0
static mut k_fwd: u64 = 0
static mut k_up: u64 = 0
static mut k_crumb: u64 = 0
static mut k_rel: u64 = 0
static mut rel_id: u64 = 4294967295
static mut rel_n: u64 = 0
static mut k_nav_related: [u8; 12] = "nav.related\0"
static mut n_shown: u64 = 0
static mut shown_idx: [u64; 8] = [0 as u64; 8]
static mut seg_buf: [u8; 512] = [0 as u8; 512]
static mut sep_txt: [u8; 4] = ">\0\0\0"
static mut k_nav_back: [u8; 9] = "nav.back\0"
static mut k_nav_fwd: [u8; 12] = "nav.forward\0"
static mut k_nav_up: [u8; 7] = "nav.up\0"

fn set_keys(back: u64, fwd: u64, up: u64, crumb0: u64) {
    k_back = back
    k_fwd = fwd
    k_up = up
    k_crumb = crumb0
}

fn set_related_key(k: u64) {
    k_rel = k
}

// SET-6: a short window (< 640 pt) still shows the related links when the page is small enough
// (the caller passes 1 for a page with at most 8 controls); the long pages keep them hidden.
static mut rel_short_ok: u64 = 0

fn set_related_short_ok(v: u64) {
    rel_short_ok = v
}

fn related_rows(parent: usize, u: u64, n: u64) -> u64 {
    rel_n = 0
    rel_id = reg.resolve(u, n)
    if rel_id == reg.NONE {
        return 0
    }
    var cnt: u64 = reg.related_count(rel_id)
    if cnt > REL_MAX {
        cnt = REL_MAX
    }
    if cnt == 0 {
        return 0
    }
    if fuiscene.height() < 640 && rel_short_ok == 0 {
        // short window (800x600 gate screen): no related links -- the Display page (the longest one)
        // would end 64 points past the window and its last controls could not be clicked
        // (desktop gate section 8, r1533). Back / Up / the crumbs stay.
        return 0
    }
    let _h: usize = fuiscene.label_muted(parent, msg.get((&k_nav_related[0 as usize]) as u64))
    var i: u64 = 0
    while i < cnt {
        let b: usize = fuiscene.button(parent, msg.get(reg.related_key(rel_id, i)), k_rel + i)
        fuiscene.set_size(b, 0, 36)
        i = i + 1
    }
    rel_n = cnt
    return cnt
}

fn related_uri(key: u64) -> u64 {
    return reg.related_to(rel_id, key - k_rel)
}

fn related_uri_len(key: u64) -> u64 {
    let p: u64 = related_uri(key)
    var n: u64 = 0
    while route.rd(p, n) != 0 {
        n = n + 1
    }
    return n
}

fn toolbar(parent: usize) -> usize {
    let r: usize = fuiscene.row(parent)
    fuiscene.set_gap(r, 4)
    let b: usize = fuiscene.button(r, msg.get((&k_nav_back[0 as usize]) as u64), k_back)
    fuiscene.set_size(b, 76, 36)
    let f: usize = fuiscene.button(r, msg.get((&k_nav_fwd[0 as usize]) as u64), k_fwd)
    fuiscene.set_size(f, 84, 36)
    let u: usize = fuiscene.button(r, msg.get((&k_nav_up[0 as usize]) as u64), k_up)
    fuiscene.set_size(u, 76, 36)
    return r
}

static mut src_u: u64 = 0

fn crumb_text(i: u64) -> u64 {
    if crumbs.crumb_dynamic(i) {
        let slot: u64 = (i % 8) * SEG_W
        let off: u64 = crumbs.crumb_seg_off(i)
        var len: u64 = crumbs.crumb_seg_len(i)
        if len > SEG_W - 2 {
            len = SEG_W - 2
        }
        var k: u64 = 0
        while k < len {
            seg_buf[(slot + k) as usize] = route.rd(src_u, off + k) as u8
            k = k + 1
        }
        seg_buf[(slot + len) as usize] = 0 as u8
        return ((&seg_buf[0 as usize]) as u64) + slot
    }
    return msg.get(reg.title_key(crumbs.crumb_route(i)))
}

fn crumbs_row(parent: usize, u: u64, n: u64) -> u64 {
    src_u = u
    let total: u64 = crumbs.build(u, n)
    n_shown = 0
    var first: u64 = 0
    if total > SHOW_MAX {
        first = total - SHOW_MAX
    }
    let r: usize = fuiscene.row(parent)
    fuiscene.set_gap(r, 2)
    var i: u64 = first
    while i < total {
        if i > first {
            let _s: usize = fuiscene.label_muted(r, (&sep_txt[0 as usize]) as u64)
        }
        let txt: u64 = crumb_text(i)
        if i + 1 == total {
            let _l: usize = fuiscene.label(r, txt)
        } else {
            let _b: usize = fuiscene.button(r, txt, k_crumb + n_shown)
            shown_idx[(n_shown) as usize] = i
            n_shown = n_shown + 1
        }
        i = i + 1
    }
    return total
}

fn shown_count() -> u64 {
    return n_shown
}

fn action_of(key: u64) -> u64 {
    if key == k_back {
        return ACT_BACK
    }
    if key == k_fwd {
        return ACT_FORWARD
    }
    if key == k_up {
        return ACT_UP
    }
    if key >= k_crumb && key < k_crumb + n_shown {
        return ACT_CRUMB
    }
    if rel_n > 0 && key >= k_rel && key < k_rel + rel_n {
        return ACT_RELATED
    }
    return ACT_NONE
}

fn crumb_target_len(key: u64) -> u64 {
    return crumbs.crumb_len(shown_idx[(key - k_crumb) as usize])
}
