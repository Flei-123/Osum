// ===================================================== DIE KOPFDATEI
//     Passphrase --scrypt--> pass_key --opens--> penvelope --> MK
//     Code       --base32-->  rkey    --opens--> renvelope --> MK
// ================================================================ EHRLICH

profile kernel

import ulib
import libc.text
import libc.io
import libc.errno
import libc.mem
import crypto.scrypt
import sync.chain
import libc.octets
import libc.hexdigit

export {
    kb_new, kb_open, kb_open_code, kb_da, kb_bund, kb_key,
    kb_target, kb_provider, kb_close, kb_n, kb_r, kb_salt,
    kb_code_letzt, kb_kopfpfad,
    hex_out, hex_in, path2, num_out, num_in,
    A_OWN, A_JARVIS, A_XOFFI, PFADMAX
}

const PFADMAX: u64 = 256
const SYS_GETRANDOM: u64 = 318

const A_OWN: u64 = 0
const A_JARVIS: u64 = 1
const A_XOFFI: u64 = 2

static mut bund: [u8; 160] = [0 as u8; 160]
static mut opened: bool = false
static mut c_salt: [u8; 16] = [0 as u8; 16]
static mut c_check: [u8; 32] = [0 as u8; 32]
static mut c_pnonce: [u8; 24] = [0 as u8; 24]
static mut c_penvelope: [u8; 48] = [0 as u8; 48]
static mut c_rnonce: [u8; 24] = [0 as u8; 24]
static mut c_renvelope: [u8; 48] = [0 as u8; 48]
static mut c_n: u64 = 4096
static mut c_r: u64 = 8
static mut c_provider: u64 = 0
static mut c_target: [u8; 256] = [0 as u8; 256]
static mut c_code: [u8; 80] = [0 as u8; 80] // der zuletzt erzeugte Code
static mut kpfad: [u8; 256] = [0 as u8; 256]
static mut line: [u8; 512] = [0 as u8; 512]
static mut rdc: [u8; 528] = [0 as u8; 528]
static mut p2: [u8; 256] = [0 as u8; 256]

fn path2(verz: u64, name: u64) -> u64 {
    var sl: [u8; 2] = "/\0"
    ulib.strncpy((&p2[0]) as u64, verz, PFADMAX)
    ulib.strcat((&p2[0]) as u64, (&sl[0]) as u64)
    ulib.strcat((&p2[0]) as u64, name)
    return (&p2[0]) as u64
}

fn unhex(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return 16
}

fn hex_out(src: u64, n: u64, out: u64) {
    var i: u64 = 0
    while i < n {
        let c: u64 = octets.ld8(src, i)
        octets.st8(out, i * 2, hexdigit.char_of((c >> 4) & 15))
        octets.st8(out, i * 2 + 1, hexdigit.char_of(c & 15))
        i = i + 1
    }
    octets.st8(out, n * 2, 0)
}

fn hex_in(src: u64, n: u64, out: u64) -> bool {
    var i: u64 = 0
    while i < n {
        let a: u64 = unhex(octets.ld8(src, i * 2))
        let b: u64 = unhex(octets.ld8(src, i * 2 + 1))
        if a > 15 || b > 15 {
            return false
        }
        octets.st8(out, i, (a << 4) | b)
        i = i + 1
    }
    return true
}

fn num_out(p: u64, v: u64) -> u64 {
    var d: [u8; 24] = [0 as u8; 24]
    var n: u64 = 0
    var x: u64 = v
    if x == 0 {
        octets.st8(p, 0, 48)
        return 1
    }
    while x > 0 {
        d[n as usize] = ((x % 10) + 48) as u8
        x = x / 10
        n = n + 1
    }
    var k: u64 = 0
    while n > 0 {
        n = n - 1
        octets.st8(p, k, d[n as usize] as u64)
        k = k + 1
    }
    return k
}

fn num_in(p: u64) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while octets.ld8(p, i) >= 48 && octets.ld8(p, i) <= 57 {
        v = v * 10 + (octets.ld8(p, i) - 48)
        i = i + 1
    }
    return v
}

fn zufall(out: u64, n: u64) -> bool {
    return !ulib.bad(ulib.sys(SYS_GETRANDOM, out, n, 0))
}

fn ableiten(pw: u64, plen: u64, salt: u64, n: u64, r: u64, out32: u64) -> bool {
    let need: u64 = scrypt.scrypt_need(n, r, 1)
    let mp: u64 = mem.map_pages(need)
    if ulib.bad(mp) {
        return false
    }
    let ok: bool = scrypt.scrypt(pw, plen, salt, chain.SALTLEN, n, r, 1,
        out32, chain.KEYLEN, mp, need)
    mem.unmap_pages(mp, need)
    return ok
}

fn kb_kopfpfad(verz: u64) -> u64 {
    var n: [u8; 5] = "KOPF\0"
    ulib.strncpy((&kpfad[0]) as u64, path2(verz, (&n[0]) as u64), PFADMAX)
    return (&kpfad[0]) as u64
}

// --------------------------------------------------------- schreiben

fn line_hex(fd: u64, name: u64, src: u64, n: u64) -> bool {
    var out: [u8; 256] = [0 as u8; 256]
    let op: u64 = (&out[0]) as u64
    ulib.strcpy(op, name)
    var l: u64 = text.length(op)
    octets.st8(op, l, 32)
    hex_out(src, n, op + l + 1)
    l = text.length(op)
    octets.st8(op, l, 10)
    return !ulib.bad(io.write_all(fd, op, l + 1))
}

fn line_text(fd: u64, name: u64, value: u64) -> bool {
    var out: [u8; 512] = [0 as u8; 512]
    let op: u64 = (&out[0]) as u64
    ulib.strcpy(op, name)
    var sl: [u8; 2] = " \0"
    ulib.strcat(op, (&sl[0]) as u64)
    ulib.strcat(op, value)
    let l: u64 = text.length(op)
    octets.st8(op, l, 10)
    return !ulib.bad(io.write_all(fd, op, l + 1))
}

fn header_write(verz: u64) -> bool {
    let fd: u64 = io.create(kb_kopfpfad(verz))
    if ulib.bad(fd) {
        return false
    }
    var header: [u8; 12] = "osumkonto1\n\0"
    var l_kdf: [u8; 64] = [0 as u8; 64]
    var t_kdf: [u8; 14] = "kdf scrypt \0\0\0"
    ulib.strcpy((&l_kdf[0]) as u64, (&t_kdf[0]) as u64)
    var at: u64 = text.length((&l_kdf[0]) as u64)
    at = at + num_out((&l_kdf[0]) as u64 + at, c_n)
    octets.st8((&l_kdf[0]) as u64, at, 32)
    at = at + 1
    at = at + num_out((&l_kdf[0]) as u64 + at, c_r)
    octets.st8((&l_kdf[0]) as u64, at, 32)
    at = at + 1
    at = at + num_out((&l_kdf[0]) as u64 + at, 1)
    octets.st8((&l_kdf[0]) as u64, at, 10)
    at = at + 1
    var ok: bool = true
    if ulib.bad(io.write_all(fd, (&header[0]) as u64, 11)) {
        ok = false
    }
    if ok && ulib.bad(io.write_all(fd, (&l_kdf[0]) as u64, at)) {
        ok = false
    }
    var n_salt: [u8; 5] = "salt\0"
    var n_pr: [u8; 6] = "check\0"
    var n_pn: [u8; 7] = "pnonce\0"
    var n_ph: [u8; 10] = "penvelope\0"
    var n_rn: [u8; 7] = "rnonce\0"
    var n_rh: [u8; 10] = "renvelope\0"
    var n_an: [u8; 9] = "provider\0"
    var n_zi: [u8; 7] = "target\0"
    if ok { ok = line_hex(fd, (&n_salt[0]) as u64, (&c_salt[0]) as u64, 16) }
    if ok { ok = line_hex(fd, (&n_pr[0]) as u64, (&c_check[0]) as u64, 32) }
    if ok { ok = line_hex(fd, (&n_pn[0]) as u64, (&c_pnonce[0]) as u64, 24) }
    if ok { ok = line_hex(fd, (&n_ph[0]) as u64, (&c_penvelope[0]) as u64, 48) }
    if ok { ok = line_hex(fd, (&n_rn[0]) as u64, (&c_rnonce[0]) as u64, 24) }
    if ok { ok = line_hex(fd, (&n_rh[0]) as u64, (&c_renvelope[0]) as u64, 48) }
    var a_e: [u8; 4] = "own\0"
    var a_j: [u8; 7] = "jarvis\0"
    var a_x: [u8; 6] = "xoffi\0"
    var ap: u64 = (&a_e[0]) as u64
    if c_provider == A_JARVIS { ap = (&a_j[0]) as u64 }
    if c_provider == A_XOFFI { ap = (&a_x[0]) as u64 }
    if ok { ok = line_text(fd, (&n_an[0]) as u64, ap) }
    if ok { ok = line_text(fd, (&n_zi[0]) as u64, (&c_target[0]) as u64) }
    io.fsync(fd)
    io.close(fd)
    return ok
}

fn kb_new(verz: u64, pw: u64, plen: u64, n: u64, r: u64,
    provider: u64, target: u64, code_out: u64) -> bool {
    c_n = n
    c_r = r
    c_provider = provider
    ulib.strncpy((&c_target[0]) as u64, target, PFADMAX)
    if !zufall((&c_salt[0]) as u64, 16) {
        return false
    }
    if !zufall((&c_pnonce[0]) as u64, 24) {
        return false
    }
    if !zufall((&c_rnonce[0]) as u64, 24) {
        return false
    }
    var mk: [u8; 32] = [0 as u8; 32]
    var rkey: [u8; 32] = [0 as u8; 32]
    var pkey: [u8; 32] = [0 as u8; 32]
    let mkp: u64 = (&mk[0]) as u64
    let rkp: u64 = (&rkey[0]) as u64
    let pkp: u64 = (&pkey[0]) as u64
    if !zufall(mkp, 32) {
        return false
    }
    if !zufall(rkp, 32) {
        return false
    }
    if !ableiten(pw, plen, (&c_salt[0]) as u64, n, r, pkp) {
        return false
    }
    chain.envelope_write(pkp, (&c_pnonce[0]) as u64, mkp,
        (&c_penvelope[0]) as u64)
    chain.envelope_write(rkp, (&c_rnonce[0]) as u64, mkp,
        (&c_renvelope[0]) as u64)
    if !chain.bundle_off_main((&bund[0]) as u64, mkp, (&c_salt[0]) as u64) {
        return false
    }
    var i: u64 = 0
    while i < 32 {
        octets.st8((&c_check[0]) as u64, i,
            octets.ld8(chain.bund_key((&bund[0]) as u64, chain.K_CHECK), i))
        i = i + 1
    }
    let cl: u64 = chain.code_write(rkp, (&c_code[0]) as u64)
    octets.st8((&c_code[0]) as u64, cl, 0)
    ulib.strcpy(code_out, (&c_code[0]) as u64)
    i = 0
    while i < 32 {
        octets.st8(mkp, i, 0)
        octets.st8(rkp, i, 0)
        octets.st8(pkp, i, 0)
        i = i + 1
    }
    opened = true
    return header_write(verz)
}

// ------------------------------------------------------------ lesen

fn word_is(p: u64, w: u64) -> bool {
    var i: u64 = 0
    while octets.ld8(w, i) != 0 {
        if octets.ld8(p, i) != octets.ld8(w, i) {
            return false
        }
        i = i + 1
    }
    return octets.ld8(p, i) == 32 || octets.ld8(p, i) == 0
}

fn after_word(p: u64) -> u64 {
    var i: u64 = 0
    while octets.ld8(p, i) != 32 && octets.ld8(p, i) != 0 {
        i = i + 1
    }
    while octets.ld8(p, i) == 32 {
        i = i + 1
    }
    return p + i
}

fn kb_da(verz: u64) -> bool {
    let fd: u64 = io.open(kb_kopfpfad(verz), 0)
    if ulib.bad(fd) {
        return false
    }
    var n_kdf: [u8; 4] = "kdf\0"
    var n_salt: [u8; 5] = "salt\0"
    var n_salz_old: [u8; 5] = "salz\0"
    var n_pr: [u8; 6] = "check\0"
    var n_pr_old: [u8; 6] = "pruef\0"
    var n_pn: [u8; 7] = "pnonce\0"
    var n_ph: [u8; 10] = "penvelope\0"
    var n_ph_old: [u8; 8] = "phuelle\0"
    var n_rn: [u8; 7] = "rnonce\0"
    var n_rh: [u8; 10] = "renvelope\0"
    var n_rh_old: [u8; 8] = "rhuelle\0"
    var n_an: [u8; 9] = "provider\0"
    var n_an_old: [u8; 9] = "anbieter\0"
    var n_zi: [u8; 7] = "target\0"
    var n_zi_old: [u8; 5] = "ziel\0"
    var a_j: [u8; 7] = "jarvis\0"
    var a_x: [u8; 6] = "xoffi\0"
    ulib.rd_init((&rdc[0]) as u64)
    var gut: bool = true
    var next: bool = true
    while next {
        let m: u64 = ulib.rd_line(fd, (&rdc[0]) as u64, (&line[0]) as u64, 500)
        if m == ulib.EOF {
            next = false
            continue
        }
        let zp: u64 = (&line[0]) as u64
        if word_is(zp, (&n_kdf[0]) as u64) {
            // kdf scrypt N r p
            let a: u64 = after_word(zp)
            let b: u64 = after_word(a)
            c_n = num_in(b)
            c_r = num_in(after_word(b))
        } else if (word_is(zp, (&n_salt[0]) as u64) || word_is(zp, (&n_salz_old[0]) as u64)) {
            if !hex_in(after_word(zp), 16, (&c_salt[0]) as u64) { gut = false }
        } else if (word_is(zp, (&n_pr[0]) as u64) || word_is(zp, (&n_pr_old[0]) as u64)) {
            if !hex_in(after_word(zp), 32, (&c_check[0]) as u64) { gut = false }
        } else if word_is(zp, (&n_pn[0]) as u64) {
            if !hex_in(after_word(zp), 24, (&c_pnonce[0]) as u64) { gut = false }
        } else if (word_is(zp, (&n_ph[0]) as u64) || word_is(zp, (&n_ph_old[0]) as u64)) {
            if !hex_in(after_word(zp), 48, (&c_penvelope[0]) as u64) { gut = false }
        } else if word_is(zp, (&n_rn[0]) as u64) {
            if !hex_in(after_word(zp), 24, (&c_rnonce[0]) as u64) { gut = false }
        } else if (word_is(zp, (&n_rh[0]) as u64) || word_is(zp, (&n_rh_old[0]) as u64)) {
            if !hex_in(after_word(zp), 48, (&c_renvelope[0]) as u64) { gut = false }
        } else if (word_is(zp, (&n_an[0]) as u64) || word_is(zp, (&n_an_old[0]) as u64)) {
            let v: u64 = after_word(zp)
            c_provider = A_OWN
            if ulib.streq(v, (&a_j[0]) as u64) { c_provider = A_JARVIS }
            if ulib.streq(v, (&a_x[0]) as u64) { c_provider = A_XOFFI }
        } else if (word_is(zp, (&n_zi[0]) as u64) || word_is(zp, (&n_zi_old[0]) as u64)) {
            ulib.strncpy((&c_target[0]) as u64, after_word(zp), PFADMAX)
        }
    }
    io.close(fd)
    return gut
}

fn bundle_check() -> bool {
    return chain.bundle_eq(chain.bund_key((&bund[0]) as u64, chain.K_CHECK),
        (&c_check[0]) as u64, 32)
}

fn off_envelope(einpack: u64, nonce: u64, envelope: u64) -> bool {
    var mk: [u8; 32] = [0 as u8; 32]
    let mkp: u64 = (&mk[0]) as u64
    if !chain.envelope_read(einpack, nonce, envelope, mkp) {
        return false
    }
    let ok: bool = chain.bundle_off_main((&bund[0]) as u64, mkp,
        (&c_salt[0]) as u64)
    var i: u64 = 0
    while i < 32 {
        octets.st8(mkp, i, 0)
        i = i + 1
    }
    if !ok {
        return false
    }
    if !bundle_check() {
        chain.bundle_delete((&bund[0]) as u64)
        return false
    }
    opened = true
    return true
}

fn kb_open(verz: u64, pw: u64, plen: u64) -> bool {
    if !kb_da(verz) {
        return false
    }
    var pkey: [u8; 32] = [0 as u8; 32]
    let pkp: u64 = (&pkey[0]) as u64
    if !ableiten(pw, plen, (&c_salt[0]) as u64, c_n, c_r, pkp) {
        return false
    }
    let ok: bool = off_envelope(pkp, (&c_pnonce[0]) as u64, (&c_penvelope[0]) as u64)
    var i: u64 = 0
    while i < 32 {
        octets.st8(pkp, i, 0)
        i = i + 1
    }
    return ok
}

fn kb_open_code(verz: u64, code: u64) -> bool {
    if !kb_da(verz) {
        return false
    }
    var rkey: [u8; 32] = [0 as u8; 32]
    let rkp: u64 = (&rkey[0]) as u64
    if !chain.code_read(code, text.length(code), rkp) {
        return false
    }
    let ok: bool = off_envelope(rkp, (&c_rnonce[0]) as u64, (&c_renvelope[0]) as u64)
    var i: u64 = 0
    while i < 32 {
        octets.st8(rkp, i, 0)
        i = i + 1
    }
    return ok
}

fn kb_bund() -> u64 {
    return (&bund[0]) as u64
}

fn kb_key(which: u64) -> u64 {
    return chain.bund_key((&bund[0]) as u64, which)
}

fn kb_target() -> u64 {
    return (&c_target[0]) as u64
}

fn kb_provider() -> u64 {
    return c_provider
}

fn kb_n() -> u64 {
    return c_n
}

fn kb_r() -> u64 {
    return c_r
}

fn kb_salt() -> u64 {
    return (&c_salt[0]) as u64
}

fn kb_code_letzt() -> u64 {
    return (&c_code[0]) as u64
}

fn kb_close() {
    chain.bundle_delete((&bund[0]) as u64)
    opened = false
}
