static mut s18: [u8; 10] = "mem.tasks\0"
static mut s19: [u8; 13] = "mem.user_kib\0"
static mut s20: [u8; 10] = "irq.traps\0"
static mut s21: [u8; 15] = "idle.window_ms\0"
static mut s22: [u8; 23] = "idle.cpu_busy_permille\0"
static mut s23: [u8; 9] = "permille\0"
