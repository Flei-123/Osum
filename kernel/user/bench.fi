// SPDX-License-Identifier: GPL-2.0-only
// kernel/user/bench.fi -- the in-OS benchmark tool (ROUND BENCH-A).
//
//   bench                table of every group
//   bench --json         one line `BENCHJSON {...}` (schema 1, flat keys `group.name`), for the host runner (tools/bench)
//   bench <group>        one group: boot mem idle size syscall fs memcpy cpu   (alias: all)
//   bench --json <group>
//
// Every number is measured here, in ring 3, with rdtsc (cycles per ms come from /proc/bench `tsc.khz`, which the kernel
// calibrated at boot) and the system calls the other tools use. The kernel side is /proc/bench (boot milestones from
// kmain.fi, kernel heap, trap count). Integer only, no heap; the one float loop carries #[allow_fp].
//
// Not here on purpose: latency key -> pixel and FPS (host side, tools/fps, tools/latency) and port I/O per second
// (counted from the QEMU trace by tools/portio; the kernel has no single in/out choke point to count at).

profile kernel

import ulib

export { u_start }

const SYS_POLL: u64 = 7
const SYS_PIPE: u64 = 22
const SYS_WAIT4: u64 = 61
const NONE: u64 = 0xFFFFFFFFFFFFFFFF

const G_BOOT: u64 = 1
const G_MEM: u64 = 2
const G_IDLE: u64 = 4
const G_SIZE: u64 = 8
const G_SYSCALL: u64 = 16
const G_FS: u64 = 32
const G_MEMCPY: u64 = 64
const G_CPU: u64 = 128

// string constants (Firn has no string literal expressions in this profile)
static mut s0: [u8; 12] = "/proc/bench\0"
static mut s1: [u8; 6] = "boot.\0"
static mut s2: [u8; 4] = "_ms\0"
static mut s3: [u8; 3] = "ms\0"
