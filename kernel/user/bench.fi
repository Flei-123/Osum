static mut s26: [u8; 17] = "idle.ctxsw_per_s\0"
static mut s27: [u8; 20] = "idle.syscalls_per_s\0"
static mut s28: [u8; 10] = "size.bin_\0"
static mut s29: [u8; 3] = "_b\0"
static mut s30: [u8; 2] = "B\0"
static mut s31: [u8; 11] = "kernel.end\0"
static mut s32: [u8; 20] = "size.kernel_end_kib\0"
static mut s33: [u8; 6] = "/bin/\0"
static mut s34: [u8; 6] = "bench\0"
static mut s35: [u8; 3] = "sh\0"
static mut s36: [u8; 3] = "ls\0"
static mut s37: [u8; 3] = "ps\0"
static mut s38: [u8; 9] = "explorer\0"
static mut s39: [u8; 9] = "settings\0"
static mut s40: [u8; 5] = "term\0"
static mut s41: [u8; 7] = "/sbin/\0"
static mut s42: [u8; 5] = "init\0"
static mut s43: [u8; 17] = "size.bin_total_b\0"
static mut s44: [u8; 17] = "size.fs_used_kib\0"
static mut s45: [u8; 18] = "size.fs_total_kib\0"
static mut s46: [u8; 18] = "syscall.getpid_ns\0"
static mut s47: [u8; 3] = "ns\0"
static mut s48: [u8; 17] = "syscall.yield_ns\0"
static mut s49: [u8; 25] = "syscall.pipe_rtt_poll_ns\0"
static mut s50: [u8; 26] = "syscall.pipe_rtt_block_ns\0"
static mut s51: [u8; 26] = "syscall.fork_exit_wait_us\0"
static mut s52: [u8; 3] = "us\0"
static mut s53: [u8; 10] = "/bin/true\0"
static mut s54: [u8; 26] = "syscall.exec_exit_wait_us\0"
static mut s54a: [u8; 21] = "syscall.exec_call_us\0"
static mut s54b: [u8; 21] = "syscall.exec_wait_us\0"
