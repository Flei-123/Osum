static mut s8: [u8; 14] = "boot.total_ms\0"
static mut s9: [u8; 14] = "mem.total_kib\0"
static mut s10: [u8; 4] = "KiB\0"
static mut s11: [u8; 13] = "mem.free_kib\0"
