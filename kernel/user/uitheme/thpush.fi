profile kernel

import fuiapp.hostwinp
import uitheme.thbase
import uitheme.thquery
import ulib
import wlibc.wcbase
import wlibc.wcgfx
import wlibc.wcpaint

const WF_RADIUS: u64 = 0

const WF_SHADOW: u64 = 1

const WF_SHADOW_R: u64 = 2

const WF_SHADOW_C: u64 = 3

const WF_SHADOW2: u64 = 4

const WF_SHADOW_R2: u64 = 5

const WF_GRAD: u64 = 6

const WF_CAPTION: u64 = 7

const WF_LIFT: u64 = 9

const WF_TILT: u64 = 10

const WF_SWING: u64 = 11

const WF_BLUR: u64 = 12

const WF_BLURTINT: u64 = 13

const WF_BLURNOISE: u64 = 14

const WF_TB_ALPHA: u64 = 15

const WF_WIN_ALPHA: u64 = 16

const WF_GLASS_KEY: u64 = 17

const WF_TITLE_BAR: u64 = 18

const WF_CAP_W: u64 = 19

const WF_FRAME: u64 = 20

const WF_BLURRIM: u64 = 21

const WF_TERM_PAD: u64 = 22

fn set_shadow_on(on: bool) {
    if on {
        wcbase.set_shadow = wcbase.SHDW_AN
    } else {
        wcbase.set_shadow = wcbase.SHDW_OFF
    }
    let _n: u64 = form_push()
}

fn deco_one(slot: u64, colour: u64) -> u64 {
    if ulib.bad(wcpaint.sys3w(hostwinp.WM_DECO, slot, colour, 0)) {
        return 0
    }
    return 1
}

fn form_one(slot: u64, value: u64) -> u64 {
    if ulib.bad(wcpaint.sys3w(hostwinp.WM_FORM, slot, value, 0)) {
        return 0
    }
    return 1
}

fn form_push() -> u64 {
    var n: u64 = 0
    n = n + form_one(WF_RADIUS, wcbase.met[(wcbase.M_RADIUS_WINDOW) as usize])
    n = n + form_one(WF_SHADOW, wcpaint.shadow_value(wcbase.met[(wcbase.M_SHADOW) as usize]))
    n = n + form_one(WF_SHADOW_R, wcbase.met[(wcbase.M_SHADOW_R) as usize])

    n = n + form_one(WF_SHADOW_C, thquery.theme_live(wcbase.C_SHADOW))

    n = n + form_one(WF_SHADOW2, wcpaint.shadow_value(wcbase.met[(wcbase.M_SHADOW2) as usize]))
    n = n + form_one(WF_SHADOW_R2, wcbase.met[(wcbase.M_SHADOW_R2) as usize])
    n = n + form_one(WF_GRAD, wcbase.met[(wcbase.M_GRAD) as usize])
    n = n + form_one(WF_CAPTION, wcbase.met[(wcbase.M_CAPTION) as usize])
    n = n + form_one(WF_TITLE_BAR, wcbase.met[(wcbase.M_TITLE_BAR) as usize])
    n = n + form_one(WF_CAP_W, wcbase.met[(wcbase.M_CAP_W) as usize])
    n = n + form_one(WF_FRAME, wcbase.met[(wcbase.M_FRAME) as usize])
    n = n + form_one(WF_TERM_PAD, wcbase.met[(wcbase.M_TERM_PAD) as usize])
    n = n + form_one(WF_LIFT, wcpaint.drag_value(wcbase.ovr_lift, wcbase.M_LIFT))
    n = n + form_one(WF_TILT, wcpaint.drag_value(wcbase.ovr_tilt, wcbase.M_TILT))
    n = n + form_one(WF_SWING, wcpaint.drag_value(wcbase.ovr_swing, wcbase.M_SWING))
    n = n + form_one(WF_BLUR, wcgfx.fx_blur(wcpaint.drag_value(wcbase.ovr_blur, wcbase.M_BLUR)))
    n = n + form_one(WF_BLURTINT, wcgfx.fx_tint(wcpaint.drag_value(wcbase.ovr_btint, wcbase.M_BLURTINT)))
    n = n + form_one(WF_BLURNOISE, wcgfx.fx_noise(wcpaint.drag_value(wcbase.ovr_bnoise, wcbase.M_BLURNOISE)))
    n = n + form_one(WF_BLURRIM, wcgfx.fx_rim())
    n = n + form_one(WF_TB_ALPHA, wcgfx.fx_alpha(wcbase.met[(wcbase.M_TB_ALPHA) as usize], thbase.FX_SUBTLE_TB))
    n = n + form_one(WF_WIN_ALPHA, wcgfx.fx_alpha(wcbase.met[(wcbase.M_WIN_ALPHA) as usize], wcbase.FX_SUBTLE_WIN))
    n = n + form_one(WF_GLASS_KEY, thquery.theme_live(wcbase.C_PANEL_BG))
    return n
}

fn ansi_push() -> u64 {
    var n: u64 = 0
    n = n + deco_one(11, thquery.theme_live(wcbase.C_INPUT_BG))
    n = n + deco_one(12, thquery.theme_semantic(wcbase.S_DANGER))
    n = n + deco_one(13, thquery.theme_semantic(wcbase.S_SUCCESS))
    n = n + deco_one(14, thquery.theme_semantic(wcbase.S_WARNING))
    n = n + deco_one(15, thquery.theme_semantic(wcbase.S_BORDER_FOCUS))
    n = n + deco_one(16, thquery.theme_live(wcbase.C_WINDOW_TEXT))
    n = n + deco_one(17, thquery.theme_live(wcbase.C_TEXT_MUTED))
    n = n + deco_one(18, thquery.theme_live(wcbase.C_WINDOW_TEXT))
    return n
}

fn deco_push() -> u64 {
    var n: u64 = ansi_push()
    if wcbase.met[(wcbase.M_TONE) as usize] < 50 {

        n = n + deco_one(0, thquery.theme_live(wcbase.C_BORDER))
        n = n + deco_one(1, thquery.theme_live(wcbase.C_WINDOW_BG))
        n = n + deco_one(2, thquery.theme_live(wcbase.C_TEXT_MUTED))
        n = n + deco_one(3, thquery.theme_live(wcbase.C_BORDER))
        n = n + deco_one(4, thquery.theme_live(wcbase.C_PANEL_BG))
        n = n + deco_one(5, thquery.theme_live(wcbase.C_WINDOW_TEXT))
        n = n + deco_one(6, thquery.theme_live(wcbase.C_DANGER))
        n = n + deco_one(7, thquery.theme_on(thquery.theme_live(wcbase.C_DANGER)))
        n = n + deco_one(8, thquery.theme_live(wcbase.C_DESKTOP_BOTTOM))
        n = n + deco_one(9, thquery.theme_live(wcbase.C_WINDOW_TEXT))
        n = n + deco_one(10, thquery.theme_live(wcbase.C_INPUT_BG))
        return n
    }
    n = n + deco_one(0, thquery.theme_live(wcbase.C_WINDOW_FRAME))
    n = n + deco_one(1, thquery.theme_live(wcbase.C_TITLEBAR_OFF_BG))
    n = n + deco_one(2, thquery.theme_live(wcbase.C_TITLEBAR_OFF_TEXT))
    n = n + deco_one(3, thquery.theme_live(wcbase.C_ACCENT))
    n = n + deco_one(4, thquery.theme_live(wcbase.C_TITLEBAR_BG))
    n = n + deco_one(5, thquery.theme_live(wcbase.C_TITLEBAR_TEXT))
    n = n + deco_one(6, thquery.theme_live(wcbase.C_DANGER))
    n = n + deco_one(7, thquery.theme_on(thquery.theme_live(wcbase.C_DANGER)))
    n = n + deco_one(8, thquery.theme_live(wcbase.C_DESKTOP_BOTTOM))
    n = n + deco_one(9, thquery.theme_live(wcbase.C_WINDOW_TEXT))
    n = n + deco_one(10, thquery.theme_live(wcbase.C_INPUT_BG))
    return n
}
