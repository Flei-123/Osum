profile kernel

import libc.io
import uitheme.thbase
import uitheme.thquery
import ulib
import uitheme.thtokens
import uitheme.thengine

fn kv_read(path: u64, which: u64) -> u64 {
    var buf: [u8; 4096] = [0 as u8; 4096]
    let fd: u64 = io.open(path, 0)
    if ulib.bad(fd) {
        return 0
    }
    let b: u64 = (&buf[0 as usize]) as u64
    var taken: u64 = 0
    var rest: u64 = 0
    var onward: bool = true
    while onward {
        let n: u64 = io.read(fd, b + rest, 4095 - rest)
        if ulib.bad(n) || n == 0 {
            onward = false
        } else {
            let have: u64 = rest + n
            var cut: u64 = have
            while cut > 0 && *((b + cut - 1) as *mut u8) != 10 as u8 {
                cut = cut - 1
            }
            if cut == 0 {
                taken = taken + kv_scan(b, have, which)
                rest = 0
            } else {
                taken = taken + kv_scan(b, cut, which)
                var k: u64 = 0
                while cut + k < have {
                    *((b + k) as *mut u8) =
                        *((b + cut + k) as *mut u8)
                    k = k + 1
                }
                rest = have - cut
            }
        }
    }
    io.close(fd)
    if rest > 0 {
        taken = taken + kv_scan(b, rest, which)
    }
    return taken
}

fn kv_scan(b: u64, n: u64, which: u64) -> u64 {
    var taken: u64 = 0
    var i: u64 = 0
    while i < n {
        var e: u64 = i
        while e < n && *((b + e) as *mut u8) != 10 as u8 {
            e = e + 1
        }
        var end: u64 = e
        if end > i {
            if *((b + end - 1) as *mut u8) == 13 as u8 {
                end = end - 1
            }
        }
        if end > i {
            if *((b + i) as *mut u8) != 35 as u8 {
                var g: u64 = i
                while g < end && *((b + g) as *mut u8) != 61 as u8 {
                    g = g + 1
                }
                if g < end {
                    var ve: u64 = g + 1
                    while ve < end && *((b + ve) as *mut u8) != 35 as u8 {
                        ve = ve + 1
                    }
                    while ve > g + 1
                        && *((b + ve - 1) as *mut u8) == 32 as u8 {
                        ve = ve - 1
                    }
                    var ok: bool = false
                    if which == 0 {
                        ok = thengine.scheme_key(b + i, g - i, b + g + 1,
                            ve - g - 1)
                    } else if which == 1 {
                        ok = thengine.conf_key(b + i, g - i, b + g + 1, ve - g - 1)
                    } else if which == 4 {
                        ok = thengine.shape_key(b + i, g - i, b + g + 1,
                            ve - g - 1)
                    } else if which == 3 {
                        var k_off: [u8; 7] = "offset\0"
                        var k_rule: [u8; 5] = "rule\0"
                        var k_zone: [u8; 5] = "zone\0"
                        var v_eu: [u8; 3] = "eu\0"
                        var v_none: [u8; 5] = "none\0"
                        if thengine.name_eq(b + i, g - i,
                            (&k_off[0 as usize]) as u64) {

                            var west: u64 = 0
                            if ve > g + 1 && *((b + g + 1) as *mut u8) == 45 as u8 {
                                west = 1
                            }
                            let v: u64 = thengine.parse_dec(b + g + 1 + west, ve - g - 1 - west)
                            if v != thtokens.DEC_BAD && v <= 1440 {
                                if west == 0 {
                                    thtokens.tz_offset = v
                                }
                                ok = true
                            }
                        } else if thengine.name_eq(b + i, g - i,
                            (&k_rule[0 as usize]) as u64) {

                            var v_us: [u8; 3] = "us\0"
                            var v_au: [u8; 3] = "au\0"
                            var v_nz: [u8; 3] = "nz\0"
                            if thengine.name_eq(b + g + 1, ve - g - 1,
                                (&v_eu[0 as usize]) as u64)
                                || thengine.name_eq(b + g + 1, ve - g - 1,
                                (&v_none[0 as usize]) as u64)
                                || thengine.name_eq(b + g + 1, ve - g - 1, (&v_us[0 as usize]) as u64)
                                || thengine.name_eq(b + g + 1, ve - g - 1, (&v_au[0 as usize]) as u64)
                                || thengine.name_eq(b + g + 1, ve - g - 1, (&v_nz[0 as usize]) as u64) {
                                ok = true
                            }
                        } else if thengine.name_eq(b + i, g - i, (&k_zone[0 as usize]) as u64) {

                            ok = true
                        }
                    } else {
                        let idx: u64 = thquery.theme_named(b + i, g - i)
                        let v: u64 = thengine.parse_hex(b + g + 1, ve - g - 1)
                        if idx < thtokens.C_COUNT && v != thtokens.RGB_BAD {
                            thtokens.ovr_val[(idx) as usize] = v
                            thtokens.ovr_on[(idx) as usize] = 1
                            thbase.ovr_n = thbase.ovr_n + 1
                            ok = true
                        }
                    }
                    if ok {
                        taken = taken + 1
                    } else {
                        thbase.kv_bad = thbase.kv_bad + 1
                    }
                } else {
                    thbase.kv_bad = thbase.kv_bad + 1
                }
            }
        }
        i = e + 1
    }
    return taken
}

fn timezone_read() {
    var p_new: [u8; 15] = "/etc/time.conf\0"
    var p_old: [u8; 15] = "/etc/zeit.conf\0"

    if kv_read((&p_new[0 as usize]) as u64, 3) > 0 {
        return
    }

    let _o: u64 = kv_read((&p_old[0 as usize]) as u64, 3)
}
