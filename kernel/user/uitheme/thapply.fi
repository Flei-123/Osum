profile kernel

import uitheme.thbase
import uitheme.thtokens
import uitheme.thengine
import uitheme.thcolor

fn theme_auto_dark() -> bool {
    return thengine.auto_is_dark()
}

fn theme_apply() {
    let dark: bool = thengine.effective_dark()
    thbase.cur_dark = 0
    if dark {
        thbase.cur_dark = 1
    }
    var acc: u64 = thtokens.sch_accent
    if thtokens.set_accent != 0 {
        acc = thtokens.set_accent
        if thtokens.set_accent == thtokens.ACCENT_BLACK {
            acc = 0
        }
    }
    thcolor.ramp_build(thtokens.R_ACCENT, acc)
    thcolor.ramp_build(thtokens.R_DANGER, thtokens.sch_danger)
    thcolor.ramp_build(thtokens.R_WARNING, thtokens.sch_warning)
    thcolor.ramp_build(thtokens.R_SUCCESS, thtokens.sch_success)
    thengine.bind_neutrals(dark)
    thengine.bind_accent(dark)
    thengine.publish()
}

const BLUR_MAX: u64 = 16

fn set_aa_old(on: bool) {
    thtokens.aa_old_rim = on
}

fn set_radius(r: u64) {
    thtokens.usr_radius = thengine.cap(r, thtokens.RADIUS_MAX)
    thengine.glas_metrics()
    theme_apply()
}

fn set_tb_alpha(a: u64) {
    thtokens.usr_tba = thengine.clamp_alpha(a)
    thengine.glas_metrics()
    theme_apply()
}

fn set_win_alpha(a: u64) {
    thtokens.usr_wa = thengine.clamp_alpha(a)
    thengine.glas_metrics()
    theme_apply()
}

fn set_transparency(m: u64) {
    if m > thtokens.TRANS_STRONG {
        return
    }
    thtokens.fx_mode = m
    theme_apply()
}

fn set_tb_blur(b: u64) {
    thtokens.ovr_blur = thengine.cap(b, BLUR_MAX) + 1
    thengine.glas_metrics()
    theme_apply()
}

fn theme_sum() -> u64 {
    var h: u64 = 1469598103934665603
    var i: u64 = 0
    while i < thtokens.C_COUNT {
        h = (h ^ thtokens.tok[((thtokens.live * thtokens.C_COUNT + i)) as usize]) *% 1099511628211
        i = i + 1
    }
    h = (h ^ thtokens.met[(thtokens.M_RADIUS_WINDOW) as usize]) *% 1099511628211
    h = (h ^ thtokens.met[(thtokens.M_TB_ALPHA) as usize]) *% 1099511628211
    h = (h ^ thtokens.met[(thtokens.M_WIN_ALPHA) as usize]) *% 1099511628211
    h = (h ^ thtokens.met[(thtokens.M_BLUR) as usize]) *% 1099511628211
    h = (h ^ thtokens.fx_mode) *% 1099511628211
    return h
}

fn theme_set_mode(m: u64) {
    if m <= thtokens.MODE_AUTO {
        thtokens.set_mode = m
        theme_apply()
    }
}

fn theme_set_accent(rgb: u64) {
    thtokens.set_accent = rgb & thtokens.RGB24
    if thtokens.set_accent == 0 {
        thtokens.set_accent = thtokens.ACCENT_BLACK
    }
    theme_apply()
}

fn theme_clear_accent() {
    thtokens.set_accent = 0
    theme_apply()
}

fn theme_set(i: u64, v: u64) {
    if i < thtokens.C_COUNT {
        thtokens.ovr_val[(i) as usize] = v
        thtokens.ovr_on[(i) as usize] = 1
        theme_apply()
    }
}
