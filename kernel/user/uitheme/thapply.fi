profile kernel

import uitheme.thbase
import wlibc.wcbase
import wlibc.wcgfx
import wlibc.wcpaint

fn theme_auto_dark() -> bool {
    return wcgfx.auto_is_dark()
}

fn theme_apply() {
    let dark: bool = wcgfx.effective_dark()
    thbase.cur_dark = 0
    if dark {
        thbase.cur_dark = 1
    }
    var acc: u64 = wcbase.sch_accent
    if wcbase.set_accent != 0 {
        acc = wcbase.set_accent
        if wcbase.set_accent == wcbase.ACCENT_BLACK {
            acc = 0
        }
    }
    wcpaint.ramp_build(wcbase.R_ACCENT, acc)
    wcpaint.ramp_build(wcbase.R_DANGER, wcbase.sch_danger)
    wcpaint.ramp_build(wcbase.R_WARNING, wcbase.sch_warning)
    wcpaint.ramp_build(wcbase.R_SUCCESS, wcbase.sch_success)
    wcgfx.bind_neutrals(dark)
    wcgfx.bind_accent(dark)
    wcgfx.publish()
}

const BLUR_MAX: u64 = 16

fn set_aa_old(on: bool) {
    wcbase.aa_old_rim = on
}

fn set_radius(r: u64) {
    wcbase.usr_radius = wcgfx.cap(r, wcbase.RADIUS_MAX)
    wcgfx.glas_metrics()
    theme_apply()
}

fn set_tb_alpha(a: u64) {
    wcbase.usr_tba = wcgfx.clamp_alpha(a)
    wcgfx.glas_metrics()
    theme_apply()
}

fn set_win_alpha(a: u64) {
    wcbase.usr_wa = wcgfx.clamp_alpha(a)
    wcgfx.glas_metrics()
    theme_apply()
}

fn set_transparency(m: u64) {
    if m > wcbase.TRANS_STRONG {
        return
    }
    wcbase.fx_mode = m
    theme_apply()
}

fn set_tb_blur(b: u64) {
    wcbase.ovr_blur = wcgfx.cap(b, BLUR_MAX) + 1
    wcgfx.glas_metrics()
    theme_apply()
}

fn theme_sum() -> u64 {
    var h: u64 = 1469598103934665603
    var i: u64 = 0
    while i < wcbase.C_COUNT {
        h = (h ^ wcbase.tok[((wcbase.live * wcbase.C_COUNT + i)) as usize]) *% 1099511628211
        i = i + 1
    }
    h = (h ^ wcbase.met[(wcbase.M_RADIUS_WINDOW) as usize]) *% 1099511628211
    h = (h ^ wcbase.met[(wcbase.M_TB_ALPHA) as usize]) *% 1099511628211
    h = (h ^ wcbase.met[(wcbase.M_WIN_ALPHA) as usize]) *% 1099511628211
    h = (h ^ wcbase.met[(wcbase.M_BLUR) as usize]) *% 1099511628211
    h = (h ^ wcbase.fx_mode) *% 1099511628211
    return h
}

fn theme_set_mode(m: u64) {
    if m <= wcbase.MODE_AUTO {
        wcbase.set_mode = m
        theme_apply()
    }
}

fn theme_set_accent(rgb: u64) {
    wcbase.set_accent = rgb & wcbase.RGB24
    if wcbase.set_accent == 0 {
        wcbase.set_accent = wcbase.ACCENT_BLACK
    }
    theme_apply()
}

fn theme_clear_accent() {
    wcbase.set_accent = 0
    theme_apply()
}

fn theme_set(i: u64, v: u64) {
    if i < wcbase.C_COUNT {
        wcbase.ovr_val[(i) as usize] = v
        wcbase.ovr_on[(i) as usize] = 1
        theme_apply()
    }
}
