profile kernel

import fuiapp.hostwinp
import wlibc.wcpaint

fn work_x(h: u64) -> u64 {
    return wcpaint.sys3w(hostwinp.WM_INFO, h, hostwinp.WI_WORKX, 0)
}

fn work_y(h: u64) -> u64 {
    return wcpaint.sys3w(hostwinp.WM_INFO, h, hostwinp.WI_WORKY, 0)
}

fn work_w(h: u64) -> u64 {
    return wcpaint.sys3w(hostwinp.WM_INFO, h, hostwinp.WI_WORKW, 0)
}

fn work_h(h: u64) -> u64 {
    return wcpaint.sys3w(hostwinp.WM_INFO, h, hostwinp.WI_WORKH, 0)
}

static mut e_names: [u8; 23] = "bottom\0top\0left\0right\0\0"

fn edge_name(e: u64) -> u64 {
    let b: u64 = (&e_names[0 as usize]) as u64
    var i: u64 = 0
    var k: u64 = 0
    while k < e && i < 24 {
        if __mmio_read8((b + i) as *mut u8) == 0 as u8 {
            k = k + 1
        }
        i = i + 1
    }
    return b + i
}

fn edge_by_name(p: u64) -> u64 {
    var e: u64 = 0
    while e < 4 {
        let q: u64 = edge_name(e)
        var i: u64 = 0
        var equal: bool = true
        while __mmio_read8((q + i) as *mut u8) != 0 as u8 {
            if __mmio_read8((p + i) as *mut u8)
                != __mmio_read8((q + i) as *mut u8) {
                equal = false
            }
            i = i + 1
        }
        if equal && __mmio_read8((p + i) as *mut u8) == 0 as u8 {
            return e
        }
        e = e + 1
    }
    return 4
}
