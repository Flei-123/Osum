fn bind_neutrals(dark: bool) {
    if !dark {
        if thtokens.sch_high != 0 {
            thtokens.sem[(thtokens.S_SURFACE) as usize] = thtokens.neutral[(thtokens.N_0) as usize]
            thtokens.sem[(thtokens.S_SURFACE_RAISED) as usize] = thtokens.neutral[(thtokens.N_0) as usize]
            thtokens.sem[(thtokens.S_SURFACE_SUNKEN) as usize] = thtokens.neutral[(thtokens.N_0) as usize]
            thtokens.sem[(thtokens.S_SURFACE_HOVER) as usize] = thtokens.neutral[(N_100) as usize]
            thtokens.sem[(thtokens.S_SURFACE_PRESSED) as usize] = thtokens.neutral[(N_200) as usize]
            thtokens.sem[(thtokens.S_CONTROL) as usize] = thtokens.neutral[(N_100) as usize]
            thtokens.sem[(thtokens.S_CONTROL_HOVER) as usize] = thtokens.neutral[(N_200) as usize]
            thtokens.sem[(thtokens.S_CONTROL_PRESSED) as usize] = thtokens.neutral[(N_300) as usize]
            thtokens.sem[(thtokens.S_FIELD) as usize] = thtokens.neutral[(N_100) as usize]
            thtokens.sem[(thtokens.S_TEXT_PRIMARY) as usize] = thtokens.neutral[(thtokens.N_1000) as usize]
            thtokens.sem[(thtokens.S_TEXT_SECONDARY) as usize] = thtokens.neutral[(thtokens.N_1000) as usize]
            thtokens.sem[(S_TEXT_DISABLED) as usize] = thtokens.neutral[(N_500) as usize]
            thtokens.sem[(S_BORDER) as usize] = thtokens.neutral[(thtokens.N_1000) as usize]
            thtokens.sem[(S_BORDER_STRONG) as usize] = thtokens.neutral[(thtokens.N_1000) as usize]
            thtokens.sem[(S_SHADOW) as usize] = thtokens.neutral[(thtokens.N_1000) as usize]
        } else {
            thtokens.sem[(thtokens.S_SURFACE) as usize] = thtokens.neutral[(N_50) as usize]
            thtokens.sem[(thtokens.S_SURFACE_RAISED) as usize] = thtokens.neutral[(thtokens.N_0) as usize]
            thtokens.sem[(thtokens.S_SURFACE_SUNKEN) as usize] = thtokens.neutral[(N_200) as usize]
            thtokens.sem[(thtokens.S_SURFACE_HOVER) as usize] = thtokens.neutral[(N_100) as usize]
            thtokens.sem[(thtokens.S_SURFACE_PRESSED) as usize] = thtokens.neutral[(N_200) as usize]

            thtokens.sem[(thtokens.S_CONTROL) as usize] = thtokens.neutral[(N_200) as usize]

            thtokens.sem[(thtokens.S_CONTROL_HOVER) as usize] = thcolor.mix(thtokens.neutral[(N_200) as usize], thtokens.neutral[(thtokens.N_900) as usize], HOVER_PCT_LIGHT)
            thtokens.sem[(thtokens.S_CONTROL_PRESSED) as usize] = thtokens.neutral[(N_400) as usize]
            thtokens.sem[(thtokens.S_FIELD) as usize] = thtokens.neutral[(N_100) as usize]
            thtokens.sem[(thtokens.S_TEXT_PRIMARY) as usize] = thtokens.neutral[(thtokens.N_900) as usize]

            thtokens.sem[(thtokens.S_TEXT_SECONDARY) as usize] = thtokens.neutral[(N_600) as usize]
            thtokens.sem[(S_TEXT_DISABLED) as usize] = thtokens.neutral[(N_400) as usize]

            thtokens.sem[(S_BORDER) as usize] = thtokens.neutral[(N_300) as usize]

            thtokens.sem[(S_BORDER_STRONG) as usize] = thtokens.neutral[(N_500) as usize]
            thtokens.sem[(S_SHADOW) as usize] = thtokens.neutral[(N_950) as usize]
        }
    } else {
        if thtokens.sch_high != 0 {
            thtokens.sem[(thtokens.S_SURFACE) as usize] = thtokens.neutral[(thtokens.N_1000) as usize]
            thtokens.sem[(thtokens.S_SURFACE_RAISED) as usize] = thtokens.neutral[(thtokens.N_1000) as usize]
            thtokens.sem[(thtokens.S_SURFACE_SUNKEN) as usize] = thtokens.neutral[(thtokens.N_1000) as usize]
            thtokens.sem[(thtokens.S_SURFACE_HOVER) as usize] = thtokens.neutral[(N_800) as usize]
            thtokens.sem[(thtokens.S_SURFACE_PRESSED) as usize] = thtokens.neutral[(N_700) as usize]
            thtokens.sem[(thtokens.S_CONTROL) as usize] = thtokens.neutral[(N_800) as usize]
            thtokens.sem[(thtokens.S_CONTROL_HOVER) as usize] = thtokens.neutral[(N_700) as usize]
            thtokens.sem[(thtokens.S_CONTROL_PRESSED) as usize] = thtokens.neutral[(N_600) as usize]
            thtokens.sem[(thtokens.S_FIELD) as usize] = thtokens.neutral[(N_800) as usize]
            thtokens.sem[(thtokens.S_TEXT_PRIMARY) as usize] = thtokens.neutral[(thtokens.N_0) as usize]
            thtokens.sem[(thtokens.S_TEXT_SECONDARY) as usize] = thtokens.neutral[(thtokens.N_0) as usize]
            thtokens.sem[(S_TEXT_DISABLED) as usize] = thtokens.neutral[(N_400) as usize]
            thtokens.sem[(S_BORDER) as usize] = thtokens.neutral[(thtokens.N_0) as usize]
            thtokens.sem[(S_BORDER_STRONG) as usize] = thtokens.neutral[(thtokens.N_0) as usize]
            thtokens.sem[(S_SHADOW) as usize] = thtokens.neutral[(thtokens.N_1000) as usize]
        } else {
            thtokens.sem[(thtokens.S_SURFACE) as usize] = thtokens.neutral[(thtokens.N_900) as usize]
            thtokens.sem[(thtokens.S_SURFACE_RAISED) as usize] = thtokens.neutral[(N_800) as usize]
            thtokens.sem[(thtokens.S_SURFACE_SUNKEN) as usize] = thtokens.neutral[(thtokens.N_1000) as usize]

            thtokens.sem[(thtokens.S_SURFACE_HOVER) as usize] = thcolor.mix(thtokens.neutral[(N_800) as usize], thtokens.neutral[(thtokens.N_0) as usize], HOVER_PCT_DARK)
            thtokens.sem[(thtokens.S_SURFACE_PRESSED) as usize] = thtokens.neutral[(N_600) as usize]

            thtokens.sem[(thtokens.S_CONTROL) as usize] = thtokens.neutral[(N_700) as usize]
            thtokens.sem[(thtokens.S_CONTROL_HOVER) as usize] = thcolor.mix(thtokens.neutral[(N_700) as usize], thtokens.neutral[(thtokens.N_0) as usize], HOVER_PCT_DARK)
            thtokens.sem[(thtokens.S_CONTROL_PRESSED) as usize] = thtokens.neutral[(N_500) as usize]
            thtokens.sem[(thtokens.S_FIELD) as usize] = thtokens.neutral[(N_950) as usize]
            thtokens.sem[(thtokens.S_TEXT_PRIMARY) as usize] = thtokens.neutral[(N_50) as usize]

            thtokens.sem[(thtokens.S_TEXT_SECONDARY) as usize] = thtokens.neutral[(N_300) as usize]
            thtokens.sem[(S_TEXT_DISABLED) as usize] = thtokens.neutral[(N_600) as usize]
            thtokens.sem[(S_BORDER) as usize] = thtokens.neutral[(N_700) as usize]
            thtokens.sem[(S_BORDER_STRONG) as usize] = thtokens.neutral[(N_500) as usize]
            thtokens.sem[(S_SHADOW) as usize] = thtokens.neutral[(thtokens.N_1000) as usize]
        }
    }
    if dark && thdark.active() {
        thdark.bind_surfaces()
    }
}

fn bind_accent(dark: bool) {
    var need_text: u64 = 450
    var need_ui: u64 = 300
    if thtokens.sch_high != 0 {
        need_text = 700
        need_ui = 450
    }
    var start: u64 = A_600
    var up: bool = true
    if dark {
        start = A_400
        up = false
    }
    let bg: u64 = thtokens.sem[(thtokens.S_SURFACE) as usize]
    var idx: u64 = start
    var found: bool = false
    var d: u64 = 0
    while d < thtokens.RAMP_STEPS && !found {
        var k: u64 = 0
        while k < 2 && !found {
            let i: u64 = thcolor.cand_step(start, up, d, k == 1)
            if i < thtokens.RAMP_STEPS {
                let a: u64 = thcolor.ramp_at(thtokens.R_ACCENT, i)
                thcolor.states_of(a)
                if thcolor.contrast(thtokens.st_on, a) >= need_text
                    && thcolor.contrast(a, bg) >= need_ui {
                    idx = i
                    found = true
                }
            }
            k = k + 1
        }
        d = d + 1
    }
    if !found {

        var bestscore: u64 = 0
        var i3: u64 = 0
        while i3 < thtokens.RAMP_STEPS {
            let a3: u64 = thcolor.ramp_at(thtokens.R_ACCENT, i3)
            thcolor.states_of(a3)
            var t: u64 = (thcolor.contrast(thtokens.st_on, a3) * 100) / need_text
            var u: u64 = (thcolor.contrast(a3, bg) * 100) / need_ui
            if t > 100 {
                t = 100
            }
            if u > 100 {
                u = 100
            }
            if t + u > bestscore {
                bestscore = t + u
                idx = i3
            }
            i3 = i3 + 1
        }
    }
    thtokens.acc_ok = 0
    if found {
        thtokens.acc_ok = 1
    }
    thtokens.acc_exact = 0
    if idx == start {
        thtokens.acc_exact = 1
    }
    if idx > start {
        thtokens.acc_moved = idx - start
    } else {
        thtokens.acc_moved = start - idx
    }
    let accent: u64 = thcolor.ramp_at(thtokens.R_ACCENT, idx)
    thcolor.states_of(accent)
    thtokens.acc_r_text = thcolor.contrast(thtokens.st_on, accent)
    thtokens.acc_r_ui = thcolor.contrast(accent, bg)

    var fbest: u64 = thcolor.ramp_at(thtokens.R_ACCENT, 0)
    var fr: u64 = thcolor.contrast(fbest, bg)
    var i4: u64 = 1
    while i4 < thtokens.RAMP_STEPS {
        let r4: u64 = thcolor.contrast(thcolor.ramp_at(thtokens.R_ACCENT, i4), bg)
        if r4 > fr {
            fr = r4
            fbest = thcolor.ramp_at(thtokens.R_ACCENT, i4)
        }
        i4 = i4 + 1
    }

    thtokens.sem[(thtokens.S_ACCENT) as usize] = accent
    thtokens.sem[(thtokens.S_ACCENT_HOVER) as usize] = thtokens.st_hover
    thtokens.sem[(thtokens.S_ACCENT_PRESSED) as usize] = thtokens.st_pressed
    thtokens.sem[(S_ACCENT_DISABLED) as usize] = thcolor.mix(accent, bg, 65)
    thtokens.sem[(thtokens.S_ON_ACCENT) as usize] = thtokens.st_on
    thtokens.sem[(S_BORDER_FOCUS) as usize] = fbest
    thtokens.sem[(thtokens.S_SELECTION) as usize] = accent
    thtokens.sem[(thtokens.S_ON_SELECTION) as usize] = thtokens.st_on

    if thtokens.sch_high == 0 {
        thtokens.sem[(thtokens.S_SELECTION) as usize] = thcolor.mix(thtokens.sem[(thtokens.S_SURFACE_RAISED) as usize], accent, 22)
        thtokens.sem[(thtokens.S_ON_SELECTION) as usize] = thtokens.sem[(thtokens.S_TEXT_PRIMARY) as usize]
    }
    thtokens.sem[(thtokens.S_OVERLAY) as usize] = thtokens.sem[(thtokens.S_SURFACE_RAISED) as usize]
    thtokens.sem[(thtokens.S_DANGER) as usize] = thcolor.fit_status(thtokens.R_DANGER, start, up, need_text)
    thtokens.sem[(thtokens.S_WARNING) as usize] = thcolor.fit_status(thtokens.R_WARNING, start, up, need_text)
    thtokens.sem[(thtokens.S_SUCCESS) as usize] = thcolor.fit_status(thtokens.R_SUCCESS, start, up, need_text)
    if dark && thdark.active() {
        if thtokens.set_accent == 0 {
            thdark.bind_accent()
        }
        thdark.bind_status()
    }
}

fn comp_map_init() {
    thtokens.comp_role[(thtokens.C_WINDOW_BG) as usize] = thtokens.S_SURFACE
    thtokens.comp_role[(thtokens.C_WINDOW_TEXT) as usize] = thtokens.S_TEXT_PRIMARY
    thtokens.comp_role[(thtokens.C_TEXT_MUTED) as usize] = thtokens.S_TEXT_SECONDARY
    thtokens.comp_role[(thtokens.C_PANEL_BG) as usize] = thtokens.S_SURFACE_RAISED
    thtokens.comp_role[(C_BUTTON_FACE) as usize] = thtokens.S_CONTROL
    thtokens.comp_role[(C_BUTTON_HOVER) as usize] = thtokens.S_CONTROL_HOVER
    thtokens.comp_role[(C_BUTTON_PRESSED) as usize] = thtokens.S_CONTROL_PRESSED
    thtokens.comp_role[(thtokens.C_BORDER) as usize] = S_BORDER
    thtokens.comp_role[(C_SELECT_BG) as usize] = thtokens.S_SELECTION
    thtokens.comp_role[(C_SELECT_TEXT) as usize] = thtokens.S_ON_SELECTION
    thtokens.comp_role[(C_FOCUS_RING) as usize] = S_BORDER_FOCUS
    thtokens.comp_role[(thtokens.C_INPUT_BG) as usize] = thtokens.S_FIELD
    thtokens.comp_role[(C_HEADER_BG) as usize] = thtokens.S_SURFACE_HOVER
    thtokens.comp_role[(C_SCROLL_TRACK) as usize] = thtokens.S_SURFACE_SUNKEN
    thtokens.comp_role[(C_SCROLL_THUMB) as usize] = S_BORDER_STRONG
    thtokens.comp_role[(thtokens.C_ACCENT) as usize] = thtokens.S_ACCENT
    thtokens.comp_role[(C_DIALOG_BG) as usize] = thtokens.S_OVERLAY
    thtokens.comp_role[(C_MENU_BG) as usize] = thtokens.S_OVERLAY
    thtokens.comp_role[(thtokens.C_TITLEBAR_BG) as usize] = thtokens.S_ACCENT
    thtokens.comp_role[(thtokens.C_TITLEBAR_TEXT) as usize] = thtokens.S_ON_ACCENT
    thtokens.comp_role[(thtokens.C_TITLEBAR_OFF_BG) as usize] = thtokens.S_SURFACE_RAISED
    thtokens.comp_role[(thtokens.C_TITLEBAR_OFF_TEXT) as usize] = thtokens.S_TEXT_SECONDARY
    thtokens.comp_role[(thtokens.C_WINDOW_FRAME) as usize] = S_BORDER_STRONG
    thtokens.comp_role[(C_TASKBAR_BG) as usize] = thtokens.S_SURFACE_RAISED
    thtokens.comp_role[(C_TASKBAR_TEXT) as usize] = thtokens.S_TEXT_PRIMARY
    thtokens.comp_role[(C_TASKBAR_ACTIVE) as usize] = thtokens.S_ACCENT
    thtokens.comp_role[(C_DESKTOP_TOP) as usize] = thtokens.S_SURFACE_SUNKEN
    thtokens.comp_role[(thtokens.C_DESKTOP_BOTTOM) as usize] = thtokens.S_SURFACE
    thtokens.comp_role[(C_BUTTON_TEXT) as usize] = thtokens.S_TEXT_PRIMARY
    thtokens.comp_role[(C_BUTTON_DISABLED_TEXT) as usize] = S_TEXT_DISABLED
    thtokens.comp_role[(C_INPUT_TEXT) as usize] = thtokens.S_TEXT_PRIMARY
    thtokens.comp_role[(C_INPUT_BORDER) as usize] = S_BORDER_STRONG
    thtokens.comp_role[(C_LIST_BG) as usize] = thtokens.S_FIELD
    thtokens.comp_role[(C_MENU_TEXT) as usize] = thtokens.S_TEXT_PRIMARY
    thtokens.comp_role[(thtokens.C_SHADOW) as usize] = S_SHADOW
    thtokens.comp_role[(thtokens.C_DANGER) as usize] = thtokens.S_DANGER
    thtokens.comp_role[(C_WARNING) as usize] = thtokens.S_WARNING
    thtokens.comp_role[(C_SUCCESS) as usize] = thtokens.S_SUCCESS
    thtokens.comp_role[(C_ON_ACCENT) as usize] = thtokens.S_ON_ACCENT
    thtokens.comp_role[(C_ACCENT_HOVER) as usize] = thtokens.S_ACCENT_HOVER
    thtokens.comp_role[(C_ACCENT_PRESSED) as usize] = thtokens.S_ACCENT_PRESSED
}

fn publish() {
    var shadow: u64 = 1
    if thtokens.live == 1 {
        shadow = 0
    }
    let at: u64 = shadow * thtokens.C_COUNT
    var i: u64 = 0
    while i < thtokens.C_COUNT {
        var v: u64 = thtokens.sem[(thtokens.comp_role[(i) as usize]) as usize]
        if thtokens.ovr_on[(i) as usize] != 0 {
            v = thtokens.ovr_val[(i) as usize]
        }
        thtokens.tok[((at + i)) as usize] = v
        i = i + 1
    }
    thtokens.live = shadow
    thtokens.generation = thtokens.generation + 1

    if thtokens.frame_open == 0 {
        thtokens.paint_base = thtokens.live * thtokens.C_COUNT
    }
}

static mut comp_blob: [u8; 474] = "window-bg\0window-text\0text-muted\0panel-bg\0button-face\0button-hover\0button-pressed\0border\0select-bg\0select-text\0focus-ring\0input-bg\0header-bg\0scroll-track\0scroll-thumb\0accent\0dialog-bg\0menu-bg\0titlebar-bg\0titlebar-text\0titlebar-off-bg\0titlebar-off-text\0window-frame\0taskbar-bg\0taskbar-text\0taskbar-active\0desktop-top\0desktop-bottom\0button-text\0button-disabled-text\0input-text\0input-border\0list-bg\0menu-text\0shadow\0danger\0warning\0success\0on-accent\0accent-hover\0accent-pressed\0"

static mut sem_blob: [u8; 310] = "surface\0surface-raised\0surface-sunken\0surface-hover\0surface-pressed\0text-primary\0text-secondary\0text-disabled\0border\0border-strong\0border-focus\0accent\0accent-hover\0accent-pressed\0accent-disabled\0on-accent\0selection\0on-selection\0overlay\0danger\0warning\0success\0shadow\0control\0control-hover\0control-pressed\0field\0"

static mut legacy_blob: [u8; 93] = "bg\0fg\0dim\0panel\0btn\0btnhi\0btndn\0line\0sel\0selfg\0focus\0entry\0head\0scroll\0thumb\0accent\0dlg\0menu\0"

static mut names_ok: u64 = 0

fn blob_index(blob: u64, out: u64, n: u64) {
    var p: u64 = blob
    var i: u64 = 0
    while i < n {
        __mmio_write64((out + i * 8) as *mut u64, p)
        while *((p) as *mut u8) != 0 as u8 {
            p = p + 1
        }
        p = p + 1
        i = i + 1
    }
}

fn names_init() {
    if names_ok != 0 {
        return
    }
    blob_index((&comp_blob[0 as usize]) as u64,
        (&thtokens.comp_at[0 as usize]) as u64, thtokens.C_COUNT)
    blob_index((&sem_blob[0 as usize]) as u64,
        (&thtokens.sem_at[0 as usize]) as u64, thtokens.S_COUNT)
    blob_index((&legacy_blob[0 as usize]) as u64,
        (&thtokens.legacy_at[0 as usize]) as u64, thtokens.T_COUNT)
    names_ok = 1
}

fn name_eq(p: u64, n: u64, q: u64) -> bool {
    var k: u64 = 0
    while k < n {
        let a: u64 = (*((p + k) as *mut u8)) as u64
        let b: u64 = (*((q + k) as *mut u8)) as u64
        if b == 0 || a != b {
            return false
        }
        k = k + 1
    }
    return (*((q + n) as *mut u8)) as u64 == 0
}

fn hex4(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return 16
}

fn parse_hex(p: u64, n: u64) -> u64 {
    var v: u64 = 0
    var digits: u64 = 0
    var k: u64 = 0
    while k < n {
        let d: u64 = hex4((*((p + k) as *mut u8)) as u64)
        if d >= 16 {
            return thtokens.RGB_BAD
        }
        v = (v << 4) | d
        digits = digits + 1
        k = k + 1
    }
    if digits != 6 {
        return thtokens.RGB_BAD
    }
    return v
}

fn parse_dec(p: u64, n: u64) -> u64 {
    var v: u64 = 0
    var digits: u64 = 0
    var k: u64 = 0
    while k < n {
        let c: u64 = (*((p + k) as *mut u8)) as u64
        if c < 48 || c > 57 {
            return thtokens.DEC_BAD
        }
        v = v * 10 + (c - 48)
        digits = digits + 1
        k = k + 1
    }
    if digits == 0 {
        return thtokens.DEC_BAD
    }
    return v
}

fn parse_clock(p: u64, n: u64) -> u64 {
    var h: u64 = 0
    var m: u64 = 0
    var seen: u64 = 0
    var at: u64 = 0
    var k: u64 = 0
    while k < n {
        let c: u64 = (*((p + k) as *mut u8)) as u64
        if c == 58 {
            if at == 1 {
                return thtokens.DEC_BAD
            }
            at = 1
            seen = 0
        } else if c >= 48 && c <= 57 {
            if at == 0 {
                h = h * 10 + (c - 48)
            } else {
                m = m * 10 + (c - 48)
            }
            seen = seen + 1
        } else {
            return thtokens.DEC_BAD
        }
        k = k + 1
    }
    if at != 1 || seen == 0 || h > 23 || m > 59 {
        return thtokens.DEC_BAD
    }
    return h * 60 + m
}

fn neutral_index(step: u64) -> u64 {
    if step == 0 {
        return thtokens.N_0
    }
    if step == 50 {
        return N_50
    }
    if step == 100 {
        return N_100
    }
    if step == 200 {
        return N_200
    }
    if step == 300 {
        return N_300
    }
    if step == 400 {
        return N_400
    }
    if step == 500 {
        return N_500
    }
    if step == 600 {
        return N_600
    }
    if step == 700 {
        return N_700
    }
    if step == 800 {
        return N_800
    }
    if step == 900 {
        return thtokens.N_900
    }
    if step == 950 {
        return N_950
    }
    if step == 1000 {
        return thtokens.N_1000
    }
    return thtokens.NEUTRAL_STEPS
}

fn copy_bounded(dst: u64, src: u64, n: u64, max: u64) {
    var k: u64 = 0
    while k < n && k + 1 < max {
        __mmio_write8((dst + k) as *mut u8, *((src + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((dst + k) as *mut u8, 0 as u8)
}

fn scheme_key(kp: u64, kn: u64, vp: u64, vn: u64) -> bool {
    var k_name: [u8; 5] = "name\0"
    var k_mode: [u8; 5] = "mode\0"
    var k_shadow: [u8; 7] = "shadow\0"
    var k_contrast: [u8; 9] = "contrast\0"
    var k_palette: [u8; 8] = "palette\0"
    var k_accent: [u8; 7] = "accent\0"
    var k_danger: [u8; 7] = "danger\0"
    var k_warning: [u8; 8] = "warning\0"
    var k_success: [u8; 8] = "success\0"
    var k_neutral: [u8; 8] = "neutral\0"
    var v_dark: [u8; 5] = "dark\0"
    var v_high: [u8; 5] = "high\0"
    var v_own: [u8; 4] = "own\0"

    if name_eq(kp, kn, (&k_name[0 as usize]) as u64) {
        copy_bounded((&thtokens.sch_name[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    if name_eq(kp, kn, (&k_shadow[0 as usize]) as u64) {
        var v_on: [u8; 3] = "on\0"
        var v_eins: [u8; 2] = "1\0"
        thtokens.set_shadow = thtokens.SHDW_OFF
        if name_eq(vp, vn, (&v_on[0 as usize]) as u64)
            || name_eq(vp, vn, (&v_eins[0 as usize]) as u64) {
            thtokens.set_shadow = thtokens.SHDW_AN
        }
        return true
    }
    if name_eq(kp, kn, (&k_mode[0 as usize]) as u64) {
        thtokens.sch_mode = MODE_LIGHT
        if name_eq(vp, vn, (&v_dark[0 as usize]) as u64) {
            thtokens.sch_mode = MODE_DARK
        }
        return true
    }
    if name_eq(kp, kn, (&k_palette[0 as usize]) as u64) {
        thtokens.sch_pal = 1
        if name_eq(vp, vn, (&v_own[0 as usize]) as u64) {
            thtokens.sch_pal = 0
        }
        return true
    }
    if name_eq(kp, kn, (&k_contrast[0 as usize]) as u64) {
        thtokens.sch_high = 0
        if name_eq(vp, vn, (&v_high[0 as usize]) as u64) {
            thtokens.sch_high = 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_accent[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == thtokens.RGB_BAD {
            return false
        }
        thtokens.sch_accent = v
        return true
    }
    if name_eq(kp, kn, (&k_danger[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == thtokens.RGB_BAD {
            return false
        }
        thtokens.sch_danger = v
        return true
    }
    if name_eq(kp, kn, (&k_warning[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == thtokens.RGB_BAD {
            return false
        }
        thtokens.sch_warning = v
        return true
    }
    if name_eq(kp, kn, (&k_success[0 as usize]) as u64) {
        let v: u64 = parse_hex(vp, vn)
        if v == thtokens.RGB_BAD {
            return false
        }
        thtokens.sch_success = v
        return true
    }

    if kn > 7 {
        if name_eq(kp, 7, (&k_neutral[0 as usize]) as u64) {
            let step: u64 = parse_dec(kp + 7, kn - 7)
            if step == thtokens.DEC_BAD {
                return false
            }
            let idx: u64 = neutral_index(step)
            if idx >= thtokens.NEUTRAL_STEPS {
                return false
            }
            let v: u64 = parse_hex(vp, vn)
            if v == thtokens.RGB_BAD {
                return false
            }
            thtokens.neutral[(idx) as usize] = v
            return true
        }
    }
    return false
}

fn conf_key(kp: u64, kn: u64, vp: u64, vn: u64) -> bool {
    var k_scheme: [u8; 7] = "scheme\0"
    var k_dscheme: [u8; 12] = "dark_scheme\0"
    var k_shape: [u8; 6] = "shape\0"
    var k_mode: [u8; 5] = "mode\0"
    var k_accent: [u8; 7] = "accent\0"
    var k_ls: [u8; 12] = "light_start\0"
    var k_ds: [u8; 11] = "dark_start\0"

    var k_shd: [u8; 7] = "shadow\0"
    if name_eq(kp, kn, (&k_shd[0 as usize]) as u64) {
        var v_on2: [u8; 3] = "on\0"
        var v_eins2: [u8; 2] = "1\0"
        thtokens.set_shadow = thtokens.SHDW_OFF
        if name_eq(vp, vn, (&v_on2[0 as usize]) as u64)
            || name_eq(vp, vn, (&v_eins2[0 as usize]) as u64) {
            thtokens.set_shadow = thtokens.SHDW_AN
        }
        return true
    }
    var k_lift: [u8; 5] = "lift\0"
    var k_tilt: [u8; 5] = "tilt\0"
    var k_swing: [u8; 6] = "swing\0"
    var k_blur: [u8; 5] = "blur\0"
    var k_trans: [u8; 13] = "transparency\0"
    var v_toff: [u8; 4] = "off\0"
    var v_tsub: [u8; 7] = "subtle\0"
    var v_tstr: [u8; 7] = "strong\0"
    var k_btint: [u8; 10] = "blur_tint\0"
    var k_bnoise: [u8; 11] = "blur_noise\0"
    var k_rad: [u8; 7] = "radius\0"
    var k_tba: [u8; 14] = "taskbar_alpha\0"
    var k_wa: [u8; 13] = "window_alpha\0"
    var k_aaold: [u8; 7] = "aa_old\0"
    var v_dark: [u8; 5] = "dark\0"
    var v_light: [u8; 6] = "light\0"

    if name_eq(kp, kn, (&k_scheme[0 as usize]) as u64) {
        copy_bounded((&thtokens.sch_file[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    if name_eq(kp, kn, (&k_dscheme[0 as usize]) as u64) {
        copy_bounded((&thtokens.sch_dark_file[0 as usize]) as u64, vp, vn, 32)
        return true
    }

    if name_eq(kp, kn, (&k_shape[0 as usize]) as u64) {
        copy_bounded((&thtokens.shp_file[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    if name_eq(kp, kn, (&k_mode[0 as usize]) as u64) {
        thtokens.set_mode = thtokens.MODE_AUTO
        if name_eq(vp, vn, (&v_dark[0 as usize]) as u64) {
            thtokens.set_mode = MODE_DARK
        }
        if name_eq(vp, vn, (&v_light[0 as usize]) as u64) {
            thtokens.set_mode = MODE_LIGHT
        }
        return true
    }
    if name_eq(kp, kn, (&k_lift[0 as usize]) as u64) {
        let v: u64 = parse_dec(vp, vn)
        if v != thtokens.DEC_BAD && v <= 120 {
            thtokens.ovr_lift = v + 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_tilt[0 as usize]) as u64) {
        let v: u64 = parse_dec(vp, vn)
        if v != thtokens.DEC_BAD && v <= 100 {
            thtokens.ovr_tilt = v + 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_swing[0 as usize]) as u64) {
        let v: u64 = parse_dec(vp, vn)
        if v != thtokens.DEC_BAD && v <= 100 {
            thtokens.ovr_swing = v + 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_trans[0 as usize]) as u64) {
        if name_eq(vp, vn, (&v_toff[0 as usize]) as u64) {
            thtokens.fx_mode = TRANS_OFF
        } else if name_eq(vp, vn, (&v_tsub[0 as usize]) as u64) {
            thtokens.fx_mode = thtokens.TRANS_SUBTLE
        } else if name_eq(vp, vn, (&v_tstr[0 as usize]) as u64) {
            thtokens.fx_mode = thtokens.TRANS_STRONG
        }
        return true
    }
    if name_eq(kp, kn, (&k_blur[0 as usize]) as u64) {
        let v: u64 = parse_dec(vp, vn)
        if v != thtokens.DEC_BAD && v <= 16 {
            thtokens.ovr_blur = v + 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_btint[0 as usize]) as u64) {
        let v: u64 = parse_dec(vp, vn)
        if v != thtokens.DEC_BAD && v <= 100 {
            thtokens.ovr_btint = v + 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_bnoise[0 as usize]) as u64) {
        let v: u64 = parse_dec(vp, vn)
        if v != thtokens.DEC_BAD && v <= 16 {
            thtokens.ovr_bnoise = v + 1
        }
        return true
    }
    if name_eq(kp, kn, (&k_accent[0 as usize]) as u64) {
        if vn == 0 {
            thtokens.set_accent = 0
            return true
        }
        let v: u64 = parse_hex(vp, vn)
        if v == thtokens.RGB_BAD {
            return false
        }
        thtokens.set_accent = v
        if v == 0 {
            thtokens.set_accent = thtokens.ACCENT_BLACK
        }
        return true
    }
    if name_eq(kp, kn, (&k_ls[0 as usize]) as u64) {
        let v: u64 = parse_clock(vp, vn)
        if v == thtokens.DEC_BAD {
            return false
        }
        thtokens.set_light_min = v
        return true
    }
    if name_eq(kp, kn, (&k_ds[0 as usize]) as u64) {
        let v: u64 = parse_clock(vp, vn)
        if v == thtokens.DEC_BAD {
            return false
        }
        thtokens.set_dark_min = v
        return true
    }
    if name_eq(kp, kn, (&k_rad[0 as usize]) as u64) {
        let r: u64 = parse_dec(vp, vn)
        if r == thtokens.DEC_BAD {
            return false
        }
        thtokens.usr_radius = cap(r, thtokens.RADIUS_MAX)
        glas_metrics()
        return true
    }
    if name_eq(kp, kn, (&k_tba[0 as usize]) as u64) {
        let a: u64 = parse_dec(vp, vn)
        if a == thtokens.DEC_BAD {
            return false
        }
        thtokens.usr_tba = clamp_alpha(a)
        glas_metrics()
        return true
    }
    if name_eq(kp, kn, (&k_wa[0 as usize]) as u64) {
        let a2: u64 = parse_dec(vp, vn)
        if a2 == thtokens.DEC_BAD {
            return false
        }
        thtokens.usr_wa = clamp_alpha(a2)
        glas_metrics()
        return true
    }

    if name_eq(kp, kn, (&k_aaold[0 as usize]) as u64) {
        let ao: u64 = parse_dec(vp, vn)
        if ao == thtokens.DEC_BAD {
            return false
        }
        thtokens.aa_old_rim = ao != 0
        return true
    }
    return false
}

fn local_minutes() -> u64 {
    let h: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_HOUR, 0, 0)
    let m: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_MIN, 0, 0)
    if ulib.bad(h) || ulib.bad(m) {
        return 1441
    }
    return ((h * 60 + m) + thtokens.tz_offset) % 1440
}

fn auto_is_dark() -> bool {
    let t: u64 = local_minutes()
    if t > 1440 {
        return thtokens.sch_mode == MODE_DARK
    }
    if thtokens.set_dark_min > thtokens.set_light_min {
        return t >= thtokens.set_dark_min || t < thtokens.set_light_min
    }
    return t >= thtokens.set_dark_min && t < thtokens.set_light_min
}

fn effective_dark() -> bool {
    if thtokens.set_mode == MODE_LIGHT {
        return false
    }
    if thtokens.set_mode == MODE_DARK {
        return true
    }
    return auto_is_dark()
}

fn primitives_builtin() {
    thdark.primitives_builtin()
    thtokens.sch_mode = MODE_DARK
    thtokens.sch_high = 0
    thtokens.sch_pal = 1
}

fn path_join(dir: u64, name: u64, out: u64, max: u64) {
    var at: u64 = 0
    var k: u64 = 0
    while *((dir + k) as *mut u8) != 0 as u8 && at + 1 < max {
        __mmio_write8((out + at) as *mut u8, *((dir + k) as *mut u8))
        at = at + 1
        k = k + 1
    }
    k = 0
    while *((name + k) as *mut u8) != 0 as u8 && at + 1 < max {
        __mmio_write8((out + at) as *mut u8, *((name + k) as *mut u8))
        at = at + 1
        k = k + 1
    }
    __mmio_write8((out + at) as *mut u8, 0 as u8)
}

fn metrics_classic() {
    thtokens.met[(thtokens.M_RADIUS_WINDOW) as usize] = 0
    thtokens.met[(M_RADIUS_PANEL) as usize] = 0
    thtokens.met[(thtokens.M_RADIUS_BUTTON) as usize] = 0
    thtokens.met[(M_RADIUS_INPUT) as usize] = 0
    thtokens.met[(M_BORDER) as usize] = 1
    thtokens.met[(M_PAD_X) as usize] = 12
    thtokens.met[(M_PAD_Y) as usize] = 4
    thtokens.met[(M_GAP) as usize] = 8
    thtokens.met[(M_ROW) as usize] = 20
    thtokens.met[(M_CTRL_H) as usize] = 26
    thtokens.met[(thtokens.M_SHADOW) as usize] = 0
    thtokens.met[(thtokens.M_SHADOW_R) as usize] = 0
    thtokens.met[(thtokens.M_DIVIDER) as usize] = 100
    thtokens.met[(M_FOCUS) as usize] = 1

    thtokens.met[(M_SP_XS) as usize] = 2
    thtokens.met[(M_SP_S) as usize] = 6
    thtokens.met[(M_SP_M) as usize] = 10
    thtokens.met[(M_SP_L) as usize] = 12
    thtokens.met[(thtokens.M_GRAD) as usize] = 0
    thtokens.met[(thtokens.M_TONE) as usize] = 100
    thtokens.met[(thtokens.M_SHADOW2) as usize] = 0
    thtokens.met[(thtokens.M_SHADOW_R2) as usize] = 0
    thtokens.met[(thtokens.M_CAPTION) as usize] = 0
    thtokens.met[(thtokens.M_TITLE_BAR) as usize] = 0
    thtokens.met[(thtokens.M_CAP_W) as usize] = 0
    thtokens.met[(thtokens.M_FRAME) as usize] = 0
    thtokens.met[(thtokens.M_TERM_PAD) as usize] = 0
    thtokens.met[(M_FONT) as usize] = uiscale.PX_UI0
    thtokens.met[(M_MOTION) as usize] = 0
    thtokens.met[(thtokens.M_LIFT) as usize] = 0
    thtokens.met[(thtokens.M_TILT) as usize] = 0
    thtokens.met[(thtokens.M_SWING) as usize] = 0
    thtokens.met[(thtokens.M_BLUR) as usize] = 0
    thtokens.met[(thtokens.M_BLURTINT) as usize] = 0
    thtokens.met[(thtokens.M_BLURNOISE) as usize] = 0
    thtokens.met[(thtokens.M_TB_ALPHA) as usize] = 100
    thtokens.met[(thtokens.M_WIN_ALPHA) as usize] = 100
    thtokens.shp_id = SHAPE_CLASSIC
}

const ALPHA_MIN: u64 = 20

fn clamp_alpha(v: u64) -> u64 {
    if v > 100 {
        return 100
    }
    if v < ALPHA_MIN {
        return ALPHA_MIN
    }
    return v
}

fn glas_metrics() {
    if thtokens.usr_radius != thtokens.RAD_NONE {
        let r: u64 = cap(thtokens.usr_radius, thtokens.RADIUS_MAX)
        thtokens.met[(thtokens.M_RADIUS_WINDOW) as usize] = r
        thtokens.met[(M_RADIUS_PANEL) as usize] = r
        thtokens.met[(thtokens.M_RADIUS_BUTTON) as usize] = r
        thtokens.met[(M_RADIUS_INPUT) as usize] = r
    }
    thtokens.met[(thtokens.M_TB_ALPHA) as usize] = clamp_alpha(thtokens.usr_tba)
    thtokens.met[(thtokens.M_WIN_ALPHA) as usize] = clamp_alpha(thtokens.usr_wa)
}

fn radius() -> u64 {
    return cap(thtokens.met[(thtokens.M_RADIUS_WINDOW) as usize], thtokens.RADIUS_MAX)
}

fn aa_old() -> bool {
    return thtokens.aa_old_rim
}

fn win_round(w: u64, h: u64) -> u64 {
    var r: u64 = radius()
    if r * 2 > w {
        r = w / 2
    }
    if r * 2 > h {
        r = h / 2
    }
    return r
}

fn win_alpha() -> u64 {
    return thtokens.met[(thtokens.M_WIN_ALPHA) as usize]
}

const TRANS_OFF: u64 = 0

const FX_SUBTLE_BLUR: u64 = 12

const FX_SUBTLE_TINT: u64 = 58

const FX_SUBTLE_RIM: u64 = 28

fn transparency() -> u64 {
    return thtokens.fx_mode
}

fn fx_rim() -> u64 {
    if thtokens.fx_mode == thtokens.TRANS_SUBTLE {
        return FX_SUBTLE_RIM
    }
    return 0
}

fn win_alpha_fx() -> u64 {
    return fx_alpha(thtokens.met[(thtokens.M_WIN_ALPHA) as usize], thtokens.FX_SUBTLE_WIN)
}

fn fx_blur(raw: u64) -> u64 {
    if thtokens.fx_mode == TRANS_OFF {
        return 0
    }
    if thtokens.fx_mode == thtokens.TRANS_SUBTLE {
        return FX_SUBTLE_BLUR
    }
    return raw
}

fn fx_tint(raw: u64) -> u64 {
    if thtokens.fx_mode == TRANS_OFF {
        return 0
    }
    if thtokens.fx_mode == thtokens.TRANS_SUBTLE {
        return FX_SUBTLE_TINT
    }
    return raw
}

fn fx_noise(raw: u64) -> u64 {
    if thtokens.fx_mode == thtokens.TRANS_STRONG {
        return raw
    }
    return 0
}

fn fx_alpha(raw: u64, subtle: u64) -> u64 {
    if thtokens.fx_mode == TRANS_OFF {
        return 100
    }
    if thtokens.fx_mode == thtokens.TRANS_SUBTLE {
        return subtle
    }
    return raw
}

fn type_base() -> u64 {
    let v: u64 = thtokens.met[(M_FONT) as usize]
    if v == 0 {
        return uiscale.PX_UI0 * uiscale.ui_scale()
    }
    return v * uiscale.ui_scale()
}

fn type_px(rolle: u64) -> u64 {
    let b: u64 = type_base()
    let k: u64 = uiscale.ui_scale()
    if rolle == TY_CAPTION {
        if b <= 13 * k {
            return b
        }
        return b - 3 * k
    }
    if rolle == TY_TITLE {
        return b + 3 * k
    }
    if rolle == TY_DISPLAY {
        return b + 9 * k
    }
    return b
}

fn type_lh(rolle: u64) -> u64 {
    let px: u64 = type_px(rolle)
    return snap_up(px * 4 / 3)
}

fn elev_strength(level: u64) -> u64 {
    let s: u64 = thtokens.met[(thtokens.M_SHADOW) as usize]
    if s == 0 || level == EL_FLAT {
        return 0
    }
    if level == EL_RAISED {
        return s / 2
    }
    if level == EL_OVERLAY {
        return s * 3 / 4
    }
    return s
}

fn elev_reach(level: u64) -> u64 {
    let r: u64 = metric(thtokens.M_SHADOW_R)
    if r == 0 || level == EL_FLAT {
        return 0
    }
    if level == EL_RAISED {
        var h: u64 = r / 2
        if h == 0 {
            h = 1
        }
        return h
    }
    if level == EL_OVERLAY {
        var q: u64 = r * 3 / 4
        if q == 0 {
            q = 1
        }
        return q
    }
    return r
}

fn elev_radius(level: u64) -> u64 {
    if level == EL_WINDOW {
        return metric(thtokens.M_RADIUS_WINDOW)
    }
    if level == EL_MODAL {
        return metric(M_RADIUS_PANEL)
    }
    if level == EL_OVERLAY {
        return metric(M_RADIUS_PANEL)
    }
    if level == EL_RAISED {
        return metric(M_RADIUS_PANEL)
    }
    return 0
}

fn grid() -> u64 {
    return GRID * uiscale.ui_scale()
}

fn snap(v: u64) -> u64 {
    let g: u64 = grid()
    if g == 0 {
        return v
    }
    return (v + g / 2) / g * g
}

fn snap_up(v: u64) -> u64 {
    let g: u64 = grid()
    if g == 0 {
        return v
    }
    return (v + g - 1) / g * g
}

fn hit_min() -> u64 {
    return HIT_MIN * uiscale.ui_scale()
}

fn motion(level: u64) -> u64 {
    let m: u64 = thtokens.met[(M_MOTION) as usize]
    if m == 0 {
        return 0
    }
    if level == MO_FAST {
        return m * 3 / 4
    }
    if level == MO_SLOW {
        return m * 5 / 4
    }
    return m
}

fn metric_is_len(i: u64) -> bool {
    if i == thtokens.M_SHADOW || i == thtokens.M_SHADOW2 || i == thtokens.M_DIVIDER {
        return false
    }
    if i == thtokens.M_TONE || i == thtokens.M_GRAD {
        return false
    }
    if i == thtokens.M_TB_ALPHA || i == thtokens.M_WIN_ALPHA || i == thtokens.M_BLUR {
        return false
    }
    return true
}

fn metric(i: u64) -> u64 {
    if i >= thtokens.M_COUNT {
        return 0
    }
    let v: u64 = thtokens.met[(i) as usize]
    if v != 0 && metric_is_len(i) {
        return v * uiscale.ui_scale()
    }
    return v
}

fn shape_name() -> u64 {
    return (&thtokens.shp_name[0 as usize]) as u64
}

fn shape_file() -> u64 {
    return (&thtokens.shp_file[0 as usize]) as u64
}

fn shape_keys() -> u64 {
    return thtokens.shp_keys
}

fn shape_id() -> u64 {
    return thtokens.shp_id
}

fn shape_key(kp: u64, kn: u64, vp: u64, vn: u64) -> bool {
    var k_name: [u8; 5] = "name␀"
    var k_rw: [u8; 14] = "radius_window␀"
    var k_rp: [u8; 13] = "radius_panel␀"
    var k_rb: [u8; 14] = "radius_button␀"
    var k_ri: [u8; 13] = "radius_input␀"
    var k_bo: [u8; 7] = "border␀"
    var k_px: [u8; 6] = "pad_x␀"
    var k_py: [u8; 6] = "pad_y␀"
    var k_ga: [u8; 4] = "gap␀"
    var k_ro: [u8; 4] = "row␀"
    var k_ch: [u8; 7] = "ctrl_h␀"
    var k_sh: [u8; 7] = "shadow␀"
    var k_sr: [u8; 9] = "shadow_r␀"
    var k_dv: [u8; 8] = "divider␀"
    var k_fo: [u8; 6] = "focus␀"
    var k_xs: [u8; 11] = "spacing_xs␀"
    var k_ss: [u8; 10] = "spacing_s␀"
    var k_sm: [u8; 10] = "spacing_m␀"
    var k_sl: [u8; 10] = "spacing_l␀"
    var k_gr: [u8; 5] = "grad␀"
    var k_to: [u8; 5] = "tone␀"
    var k_s2: [u8; 11] = "shadow_off␀"
    var k_r2: [u8; 13] = "shadow_off_r␀"
    var k_cp: [u8; 8] = "caption␀"
    var k_tb: [u8; 10] = "title_bar\0"
    var k_cw: [u8; 6] = "cap_w\0"
    var k_fr: [u8; 6] = "frame\0"
    var k_tp: [u8; 9] = "term_pad\0"
    var k_ft: [u8; 5] = "font␀"
    var k_mo: [u8; 7] = "motion␀"
    var k_li: [u8; 5] = "lift␀"
    var k_ti: [u8; 5] = "tilt␀"
    var k_sw: [u8; 6] = "swing␀"
    var k_bl: [u8; 5] = "blur␀"
    var k_bt: [u8; 10] = "blur_tint␀"
    var k_bn: [u8; 11] = "blur_noise␀"
    if name_eq(kp, kn, (&k_name[0 as usize]) as u64) {
        copy_bounded((&thtokens.shp_name[0 as usize]) as u64, vp, vn, 32)
        return true
    }
    let v: u64 = parse_dec(vp, vn)
    if v == thtokens.DEC_BAD {
        return false
    }
    if name_eq(kp, kn, (&k_rw[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_RADIUS_WINDOW) as usize] = cap(v, thtokens.RADIUS_MAX)
        return true
    }
    if name_eq(kp, kn, (&k_rp[0 as usize]) as u64) {
        thtokens.met[(M_RADIUS_PANEL) as usize] = cap(v, thtokens.RADIUS_MAX)
        return true
    }
    if name_eq(kp, kn, (&k_rb[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_RADIUS_BUTTON) as usize] = cap(v, thtokens.RADIUS_MAX)
        return true
    }
    if name_eq(kp, kn, (&k_ri[0 as usize]) as u64) {
        thtokens.met[(M_RADIUS_INPUT) as usize] = cap(v, thtokens.RADIUS_MAX)
        return true
    }
    if name_eq(kp, kn, (&k_bo[0 as usize]) as u64) {
        thtokens.met[(M_BORDER) as usize] = cap(v, 4)
        return true
    }
    if name_eq(kp, kn, (&k_px[0 as usize]) as u64) {
        thtokens.met[(M_PAD_X) as usize] = cap(v, 32)
        return true
    }
    if name_eq(kp, kn, (&k_py[0 as usize]) as u64) {
        thtokens.met[(M_PAD_Y) as usize] = cap(v, 32)
        return true
    }
    if name_eq(kp, kn, (&k_ga[0 as usize]) as u64) {
        thtokens.met[(M_GAP) as usize] = cap(v, 32)
        return true
    }
    if name_eq(kp, kn, (&k_ro[0 as usize]) as u64) {
        thtokens.met[(M_ROW) as usize] = cap(v, 48)
        return true
    }
    if name_eq(kp, kn, (&k_ch[0 as usize]) as u64) {
        thtokens.met[(M_CTRL_H) as usize] = cap(v, 48)
        return true
    }
    if name_eq(kp, kn, (&k_sh[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_SHADOW) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_sr[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_SHADOW_R) as usize] = cap(v, 16)
        return true
    }
    if name_eq(kp, kn, (&k_dv[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_DIVIDER) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_fo[0 as usize]) as u64) {
        thtokens.met[(M_FOCUS) as usize] = cap(v, 4)
        return true
    }
    if name_eq(kp, kn, (&k_xs[0 as usize]) as u64) {
        thtokens.met[(M_SP_XS) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_ss[0 as usize]) as u64) {
        thtokens.met[(M_SP_S) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_sm[0 as usize]) as u64) {
        thtokens.met[(M_SP_M) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_sl[0 as usize]) as u64) {
        thtokens.met[(M_SP_L) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_gr[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_GRAD) as usize] = cap(v, 24)
        return true
    }
    if name_eq(kp, kn, (&k_to[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_TONE) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_s2[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_SHADOW2) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_r2[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_SHADOW_R2) as usize] = cap(v, 16)
        return true
    }
    if name_eq(kp, kn, (&k_cp[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_CAPTION) as usize] = cap(v, 1)
        return true
    }

    if name_eq(kp, kn, (&k_tb[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_TITLE_BAR) as usize] = cap(v, 64)
        return true
    }
    if name_eq(kp, kn, (&k_cw[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_CAP_W) as usize] = cap(v, 120)
        return true
    }
    if name_eq(kp, kn, (&k_fr[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_FRAME) as usize] = cap(v, 4)
        return true
    }
    if name_eq(kp, kn, (&k_tp[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_TERM_PAD) as usize] = cap(v, 24)
        return true
    }
    if name_eq(kp, kn, (&k_ft[0 as usize]) as u64) {
        var f: u64 = cap(v, 32)
        if f < 10 {
            f = 10
        }
        thtokens.met[(M_FONT) as usize] = f
        return true
    }
    if name_eq(kp, kn, (&k_mo[0 as usize]) as u64) {
        thtokens.met[(M_MOTION) as usize] = cap(v, 400)
        return true
    }
    if name_eq(kp, kn, (&k_li[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_LIFT) as usize] = cap(v, 120)
        return true
    }
    if name_eq(kp, kn, (&k_ti[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_TILT) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_sw[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_SWING) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_bl[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_BLUR) as usize] = cap(v, 16)
        return true
    }
    if name_eq(kp, kn, (&k_bt[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_BLURTINT) as usize] = cap(v, 100)
        return true
    }
    if name_eq(kp, kn, (&k_bn[0 as usize]) as u64) {
        thtokens.met[(thtokens.M_BLURNOISE) as usize] = cap(v, 16)
        return true
    }
    return false
}

fn space(i: u64) -> u64 {
    if i > 3 {
        return 0
    }
    return metric(M_SP_XS + i)
}

fn shade(c: u64, d: u64) -> u64 {
    var r: u64 = (c >> 16) & 255
    var g: u64 = (c >> 8) & 255
    var b: u64 = c & 255
    if r > d {
        r = r - d
    } else {
        r = 0
    }
    if g > d {
        g = g - d
    } else {
        g = 0
    }
    if b > d {
        b = b - d
    } else {
        b = 0
    }
    return (r << 16) | (g << 8) | b
}

fn grad_room(c: u64, want: u64) -> u64 {
    var m: u64 = (c >> 16) & 255
    let g: u64 = (c >> 8) & 255
    let b: u64 = c & 255
    if g < m {
        m = g
    }
    if b < m {
        m = b
    }
    if want > m {
        return m
    }
    return want
}

fn cap(v: u64, hi: u64) -> u64 {
    if v > hi {
        return hi
    }
    return v
}

static mut flaky_left: u64 = 0

static mut flaky_seen: u64 = 0

fn conf_flaky() -> bool {
    if flaky_seen == 0 {
        flaky_seen = 1
        var p_fl: [u8; 16] = "/etc/themeflaky\0"
        var b_fl: [u8; 4] = [0 as u8; 4]
        let fd_fl: u64 = io.open((&p_fl[0 as usize]) as u64, 0)
        if !ulib.bad(fd_fl) {
            let r_fl: u64 = io.read(fd_fl, (&b_fl[0 as usize]) as u64, 1)
            io.close(fd_fl)
            if !ulib.bad(r_fl) && r_fl == 1 && b_fl[0] >= 48 && b_fl[0] <= 57 {
                flaky_left = (b_fl[0] as u64) - 48
            }
        }
    }
    if flaky_left > 0 {
        flaky_left = flaky_left - 1
        return true
    }
    return false
}

fn conf_read_into(dst: u64) -> u64 {
    if conf_flaky() {
        return 0
    }
    var p_conf: [u8; 16] = "/etc/theme.conf\0"
    let fd: u64 = io.open((&p_conf[0 as usize]) as u64, 0)
    if ulib.bad(fd) {
        return 0
    }
    var n: u64 = 0
    var more: bool = true
    while more && n < 4095 {
        let r: u64 = io.read(fd, dst + n, 4095 - n)
        if ulib.bad(r) || r == 0 {
            more = false
        } else {
            n = n + r
        }
    }
    io.close(fd)
    return n
}

fn conf_fetch() -> u64 {
    var n: u64 = 0
    var tries: u64 = 0
    while tries < 3 {
        n = conf_read_into((&thtokens.conf_copy[0 as usize]) as u64)
        if n > 0 {
            tries = 3
        } else {
            tries = tries + 1
        }
    }
    thtokens.conf_len = n
    return n
}

fn conf_changed() -> bool {
    var buf: [u8; 4096] = [0 as u8; 4096]
    let n: u64 = conf_read_into((&buf[0 as usize]) as u64)
    var same: bool = n == thtokens.conf_len
    if same {
        var k: u64 = 0
        while k < n {
            if buf[(k) as usize] != thtokens.conf_copy[(k) as usize] {
                same = false
                k = n
            } else {
                k = k + 1
            }
        }
    }
    if same {
        return false
    }
    var k2: u64 = 0
    while k2 < n {
        thtokens.conf_copy[(k2) as usize] = buf[(k2) as usize]
        k2 = k2 + 1
    }
    thtokens.conf_len = n
    return true
}

const CONF_POLL_TICKS: u64 = 50

static mut conf_poll_at: u64 = 0xFFFFFFFFFFFF

fn conf_due() -> bool {
    let now: u64 = ulib.sys(ulib.SYS_SYSINFO, ulib.I_TICKS, 0, 0)
    if ulib.bad(now) {
        return true
    }
    if conf_poll_at != 0xFFFFFFFFFFFF && now >= conf_poll_at && now - conf_poll_at < CONF_POLL_TICKS {
        return false
    }
    conf_poll_at = now
    return true
}

