profile kernel

import uitheme
import uitheme.thbase
import wlibc.wcbase
import wlibc.wcgfx
import uitheme.thcolor

const R_COUNT: u64 = 4

const T_SEL: u64 = uitheme.T_SEL

const T_SELFG: u64 = uitheme.T_SELFG

static mut paint_gen: u64 = 0

fn theme(i: u64) -> u64 {
    return uitheme.theme(i)
}

fn theme_selfg() -> u64 {
    let bg: u64 = theme(T_SEL)
    let fg: u64 = theme(T_SELFG)
    if thcolor.contrast(fg, bg) >= 450 {
        return fg
    }
    let w: u64 = wcbase.RGB_WHITE
    let b: u64 = wcbase.RGB_BLACK
    if thcolor.contrast(w, bg) >= thcolor.contrast(b, bg) {
        return w
    }
    return b
}

fn theme_selfg_contrast() -> u64 {
    return thcolor.contrast(theme_selfg(), theme(T_SEL))
}

fn theme_live(i: u64) -> u64 {
    if i >= wcbase.C_COUNT {
        return 0
    }
    return wcbase.tok[((wcbase.live * wcbase.C_COUNT + i)) as usize]
}

fn theme_semantic(i: u64) -> u64 {
    if i >= wcbase.S_COUNT {
        return 0
    }
    return wcbase.sem[(i) as usize]
}

fn theme_neutral(i: u64) -> u64 {
    if i >= wcbase.NEUTRAL_STEPS {
        return 0
    }
    return wcbase.neutral[(i) as usize]
}

fn theme_ramp(slot: u64, step: u64) -> u64 {
    if slot >= R_COUNT || step >= wcbase.RAMP_STEPS {
        return 0
    }
    return thcolor.ramp_at(slot, step)
}

fn theme_role_of(i: u64) -> u64 {
    if i >= wcbase.C_COUNT {
        return wcbase.S_COUNT
    }
    return wcbase.comp_role[(i) as usize]
}

fn theme_gen() -> u64 {
    return wcbase.generation
}

fn theme_frame_begin() -> u64 {
    wcbase.frame_open = 1
    wcbase.paint_base = wcbase.live * wcbase.C_COUNT
    paint_gen = wcbase.generation
    return paint_gen
}

fn theme_frame_end() -> bool {
    wcbase.frame_open = 0
    let stale: bool = paint_gen != wcbase.generation
    wcbase.paint_base = wcbase.live * wcbase.C_COUNT
    return stale
}

fn theme_frame_stale() -> bool {
    return paint_gen != wcbase.generation
}

fn theme_dark() -> bool {
    return thbase.cur_dark != 0
}

fn theme_mode() -> u64 {
    return wcbase.set_mode
}

fn theme_scheme_mode() -> u64 {
    return wcbase.sch_mode
}

fn theme_high() -> bool {
    return wcbase.sch_high != 0
}

fn theme_accent_ok() -> bool {
    return wcbase.acc_ok != 0
}

fn theme_accent_exact() -> bool {
    return wcbase.acc_exact != 0
}

fn theme_accent_moved() -> u64 {
    return wcbase.acc_moved
}

fn theme_accent_ratio_text() -> u64 {
    return wcbase.acc_r_text
}

fn theme_accent_ratio_ui() -> u64 {
    return wcbase.acc_r_ui
}

fn theme_accent_own() -> u64 {
    if wcbase.set_accent == wcbase.ACCENT_BLACK {
        return wcbase.ACCENT_BLACK
    }
    return wcbase.set_accent
}

fn theme_accent_wanted() -> u64 {
    if wcbase.set_accent != 0 {
        if wcbase.set_accent == wcbase.ACCENT_BLACK {
            return 0
        }
        return wcbase.set_accent
    }
    return wcbase.sch_accent
}

fn theme_scheme_name() -> u64 {
    return (&wcbase.sch_name[0 as usize]) as u64
}

fn theme_scheme_file() -> u64 {
    return (&wcbase.sch_file[0 as usize]) as u64
}

fn theme_contrast(a: u64, b: u64) -> u64 {
    return thcolor.contrast(a, b)
}

fn theme_luminance(c: u64) -> u64 {
    return thcolor.luminance(c)
}

fn theme_linear(c: u64) -> u64 {
    if c > 255 {
        return 0
    }
    return thcolor.lin_of(c)
}

fn theme_on(bg: u64) -> u64 {
    return thcolor.pick_on(bg)
}

fn theme_light_start() -> u64 {
    return wcbase.set_light_min
}

fn theme_dark_start() -> u64 {
    return wcbase.set_dark_min
}

fn theme_tz_offset() -> u64 {
    return wcbase.tz_offset
}

fn theme_name_at(i: u64) -> u64 {
    wcgfx.names_init()
    if i >= wcbase.C_COUNT {
        return 0
    }
    return wcbase.comp_at[(i) as usize]
}

fn theme_semantic_name_at(i: u64) -> u64 {
    wcgfx.names_init()
    if i >= wcbase.S_COUNT {
        return 0
    }
    return wcbase.sem_at[(i) as usize]
}

fn theme_named(p: u64, n: u64) -> u64 {
    wcgfx.names_init()
    var i: u64 = 0
    while i < wcbase.C_COUNT {
        if wcgfx.name_eq(p, n, wcbase.comp_at[(i) as usize]) {
            return i
        }
        i = i + 1
    }
    var j: u64 = 0
    while j < wcbase.T_COUNT {
        if wcgfx.name_eq(p, n, wcbase.legacy_at[(j) as usize]) {
            return j
        }
        j = j + 1
    }
    return wcbase.C_COUNT
}

fn tb_alpha() -> u64 {
    return wcbase.met[(wcbase.M_TB_ALPHA) as usize]
}

fn tb_blur() -> u64 {
    return blur_staerke()
}

fn tb_alpha_fx() -> u64 {
    return wcgfx.fx_alpha(wcbase.met[(wcbase.M_TB_ALPHA) as usize], thbase.FX_SUBTLE_TB)
}

fn zieh_lift() -> u64 {
    return thcolor.drag_value(wcbase.ovr_lift, wcbase.M_LIFT)
}

fn zieh_tilt() -> u64 {
    return thcolor.drag_value(wcbase.ovr_tilt, wcbase.M_TILT)
}

fn zieh_swing() -> u64 {
    return thcolor.drag_value(wcbase.ovr_swing, wcbase.M_SWING)
}

fn blur_staerke() -> u64 {
    return thcolor.drag_value(wcbase.ovr_blur, wcbase.M_BLUR)
}

fn blur_tint() -> u64 {
    return thcolor.drag_value(wcbase.ovr_btint, wcbase.M_BLURTINT)
}

fn blur_noise() -> u64 {
    return thcolor.drag_value(wcbase.ovr_bnoise, wcbase.M_BLURNOISE)
}
