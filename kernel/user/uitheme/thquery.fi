profile kernel

import uitheme
import uitheme.thbase
import uitheme.thtokens
import uitheme.thengine
import uitheme.thcolor

const R_COUNT: u64 = 4

const T_SEL: u64 = uitheme.T_SEL

const T_SELFG: u64 = uitheme.T_SELFG

static mut paint_gen: u64 = 0

fn theme(i: u64) -> u64 {
    return uitheme.theme(i)
}

fn theme_selfg() -> u64 {
    let bg: u64 = theme(T_SEL)
    let fg: u64 = theme(T_SELFG)
    if thcolor.contrast(fg, bg) >= 450 {
        return fg
    }
    let w: u64 = thtokens.RGB_WHITE
    let b: u64 = thtokens.RGB_BLACK
    if thcolor.contrast(w, bg) >= thcolor.contrast(b, bg) {
        return w
    }
    return b
}

fn theme_selfg_contrast() -> u64 {
    return thcolor.contrast(theme_selfg(), theme(T_SEL))
}

fn theme_live(i: u64) -> u64 {
    if i >= thtokens.C_COUNT {
        return 0
    }
    return thtokens.tok[((thtokens.live * thtokens.C_COUNT + i)) as usize]
}

fn theme_semantic(i: u64) -> u64 {
    if i >= thtokens.S_COUNT {
        return 0
    }
    return thtokens.sem[(i) as usize]
}

fn theme_neutral(i: u64) -> u64 {
    if i >= thtokens.NEUTRAL_STEPS {
        return 0
    }
    return thtokens.neutral[(i) as usize]
}

fn theme_ramp(slot: u64, step: u64) -> u64 {
    if slot >= R_COUNT || step >= thtokens.RAMP_STEPS {
        return 0
    }
    return thcolor.ramp_at(slot, step)
}

fn theme_role_of(i: u64) -> u64 {
    if i >= thtokens.C_COUNT {
        return thtokens.S_COUNT
    }
    return thtokens.comp_role[(i) as usize]
}

fn theme_gen() -> u64 {
    return thtokens.generation
}

fn theme_frame_begin() -> u64 {
    thtokens.frame_open = 1
    thtokens.paint_base = thtokens.live * thtokens.C_COUNT
    paint_gen = thtokens.generation
    return paint_gen
}

fn theme_frame_end() -> bool {
    thtokens.frame_open = 0
    let stale: bool = paint_gen != thtokens.generation
    thtokens.paint_base = thtokens.live * thtokens.C_COUNT
    return stale
}

fn theme_frame_stale() -> bool {
    return paint_gen != thtokens.generation
}

fn theme_dark() -> bool {
    return thbase.cur_dark != 0
}

fn theme_mode() -> u64 {
    return thtokens.set_mode
}

fn theme_scheme_mode() -> u64 {
    return thtokens.sch_mode
}

fn theme_high() -> bool {
    return thtokens.sch_high != 0
}

fn theme_accent_ok() -> bool {
    return thtokens.acc_ok != 0
}

fn theme_accent_exact() -> bool {
    return thtokens.acc_exact != 0
}

fn theme_accent_moved() -> u64 {
    return thtokens.acc_moved
}

fn theme_accent_ratio_text() -> u64 {
    return thtokens.acc_r_text
}

fn theme_accent_ratio_ui() -> u64 {
    return thtokens.acc_r_ui
}

fn theme_accent_own() -> u64 {
    if thtokens.set_accent == thtokens.ACCENT_BLACK {
        return thtokens.ACCENT_BLACK
    }
    return thtokens.set_accent
}

fn theme_accent_wanted() -> u64 {
    if thtokens.set_accent != 0 {
        if thtokens.set_accent == thtokens.ACCENT_BLACK {
            return 0
        }
        return thtokens.set_accent
    }
    return thtokens.sch_accent
}

fn theme_scheme_name() -> u64 {
    return (&thtokens.sch_name[0 as usize]) as u64
}

fn theme_scheme_file() -> u64 {
    return (&thtokens.sch_file[0 as usize]) as u64
}

fn theme_contrast(a: u64, b: u64) -> u64 {
    return thcolor.contrast(a, b)
}

fn theme_luminance(c: u64) -> u64 {
    return thcolor.luminance(c)
}

fn theme_linear(c: u64) -> u64 {
    if c > 255 {
        return 0
    }
    return thcolor.lin_of(c)
}

fn theme_on(bg: u64) -> u64 {
    return thcolor.pick_on(bg)
}

fn theme_light_start() -> u64 {
    return thtokens.set_light_min
}

fn theme_dark_start() -> u64 {
    return thtokens.set_dark_min
}

fn theme_tz_offset() -> u64 {
    return thtokens.tz_offset
}

fn theme_name_at(i: u64) -> u64 {
    thengine.names_init()
    if i >= thtokens.C_COUNT {
        return 0
    }
    return thtokens.comp_at[(i) as usize]
}

fn theme_semantic_name_at(i: u64) -> u64 {
    thengine.names_init()
    if i >= thtokens.S_COUNT {
        return 0
    }
    return thtokens.sem_at[(i) as usize]
}

fn theme_named(p: u64, n: u64) -> u64 {
    thengine.names_init()
    var i: u64 = 0
    while i < thtokens.C_COUNT {
        if thengine.name_eq(p, n, thtokens.comp_at[(i) as usize]) {
            return i
        }
        i = i + 1
    }
    var j: u64 = 0
    while j < thtokens.T_COUNT {
        if thengine.name_eq(p, n, thtokens.legacy_at[(j) as usize]) {
            return j
        }
        j = j + 1
    }
    return thtokens.C_COUNT
}

fn tb_alpha() -> u64 {
    return thtokens.met[(thtokens.M_TB_ALPHA) as usize]
}

fn tb_blur() -> u64 {
    return blur_staerke()
}

fn tb_alpha_fx() -> u64 {
    return thengine.fx_alpha(thtokens.met[(thtokens.M_TB_ALPHA) as usize], thbase.FX_SUBTLE_TB)
}

fn zieh_lift() -> u64 {
    return thcolor.drag_value(thtokens.ovr_lift, thtokens.M_LIFT)
}

fn zieh_tilt() -> u64 {
    return thcolor.drag_value(thtokens.ovr_tilt, thtokens.M_TILT)
}

fn zieh_swing() -> u64 {
    return thcolor.drag_value(thtokens.ovr_swing, thtokens.M_SWING)
}

fn blur_staerke() -> u64 {
    return thcolor.drag_value(thtokens.ovr_blur, thtokens.M_BLUR)
}

fn blur_tint() -> u64 {
    return thcolor.drag_value(thtokens.ovr_btint, thtokens.M_BLURTINT)
}

fn blur_noise() -> u64 {
    return thcolor.drag_value(thtokens.ovr_bnoise, thtokens.M_BLURNOISE)
}
