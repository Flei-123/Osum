profile kernel

import corner
import fuiapp.hostax
import uitheme.thapply
import uitheme.thbase
import uitheme.thfile
import wlibc.wcbase
import wlibc.wcgfx

static mut booted: u64 = 0

static mut hc_seen: u64 = 0

static mut sch_keys: u64 = 0

fn reload_inner(aus_kopie: bool) -> u64 {
    var p_conf: [u8; 16] = "/etc/theme.conf\0"
    var p_dir: [u8; 14] = "/etc/schemas/\0"
    var p_shapes: [u8; 13] = "/etc/shapes/\0"
    var p_theme: [u8; 11] = "/etc/theme\0"
    var path: [u8; 64] = [0 as u8; 64]
    thbase.kv_bad = 0
    thbase.ovr_n = 0
    var z: u64 = 0
    while z < wcbase.C_COUNT {
        wcbase.ovr_on[(z) as usize] = 0
        z = z + 1
    }
    wcgfx.primitives_builtin()
    wcgfx.comp_map_init()
    wcgfx.metrics_classic()
    __mmio_write8(((&wcbase.shp_file[0 as usize]) as u64) as *mut u8, 0 as u8)
    __mmio_write8(((&wcbase.shp_name[0 as usize]) as u64) as *mut u8, 0 as u8)
    corner.aa_reset()
    wcbase.set_mode = wcbase.MODE_AUTO
    wcbase.set_accent = 0
    wcbase.usr_radius = wcbase.RAD_NONE
    wcbase.usr_tba = 100
    wcbase.usr_wa = 100
    wcbase.fx_mode = wcbase.TRANS_SUBTLE
    __mmio_write8(((&wcbase.sch_file[0 as usize]) as u64) as *mut u8, 0 as u8)
    __mmio_write8(((&wcbase.sch_dark_file[0 as usize]) as u64) as *mut u8, 0 as u8)
    __mmio_write8(((&wcbase.sch_name[0 as usize]) as u64) as *mut u8, 0 as u8)
    var nc: u64 = 0
    if aus_kopie && wcbase.conf_len > 0 {
        nc = thfile.kv_scan((&wcbase.conf_copy[0 as usize]) as u64, wcbase.conf_len, 1)
    } else {

        if wcgfx.conf_fetch() > 0 {
            nc = thfile.kv_scan((&wcbase.conf_copy[0 as usize]) as u64, wcbase.conf_len, 1)
        }
    }
    let _nc: u64 = nc

    hc_seen = hostax.ax_high()
    if hc_seen != 0 {
        var p_hc: [u8; 9] = "contrast\0"
        wcgfx.copy_bounded((&wcbase.sch_file[0 as usize]) as u64,
            (&p_hc[0 as usize]) as u64, 8, 32)
        __mmio_write8(((&wcbase.sch_dark_file[0 as usize]) as u64) as *mut u8,
            0 as u8)
    }
    if nc == 0 {
        wcbase.set_mode = wcbase.sch_mode
    }
    thfile.timezone_read()
    var pick: u64 = (&wcbase.sch_file[0 as usize]) as u64
    if *(((&wcbase.sch_dark_file[0 as usize]) as u64) as *mut u8) != 0 as u8
        && wcgfx.effective_dark() {
        pick = (&wcbase.sch_dark_file[0 as usize]) as u64
    }
    if *((pick) as *mut u8) != 0 as u8 {
        wcgfx.path_join((&p_dir[0 as usize]) as u64, pick,
            (&path[0 as usize]) as u64, 64)
        sch_keys = thfile.kv_read((&path[0 as usize]) as u64, 0)
    } else {
        sch_keys = 0
    }

    if *(((&wcbase.shp_file[0 as usize]) as u64) as *mut u8) != 0 as u8 {
        wcgfx.path_join((&p_shapes[0 as usize]) as u64,
            (&wcbase.shp_file[0 as usize]) as u64,
            (&path[0 as usize]) as u64, 64)
        wcbase.shp_keys = thfile.kv_read((&path[0 as usize]) as u64, 4)
        if wcbase.shp_keys == 0 {
            wcgfx.metrics_classic()
        } else if wcbase.met[(wcbase.M_RADIUS_BUTTON) as usize] != 0
            || wcbase.met[(wcbase.M_SHADOW) as usize] != 0 {
            wcbase.shp_id = thbase.SHAPE_MODERN
        }
    } else {
        wcbase.shp_keys = 0
    }
    wcgfx.glas_metrics()

    if hc_seen == 0 {
        let _no: u64 = thfile.kv_read((&p_theme[0 as usize]) as u64, 2)
    }
    thapply.theme_apply()
    booted = 1
    return wcbase.generation
}

fn theme_reload() -> u64 {
    return reload_inner(false)
}

fn theme_poll() -> bool {

    if hostax.ax_high() != hc_seen {
        let before_hc: u64 = thapply.theme_sum()
        let _gh: u64 = reload_inner(true)
        return thapply.theme_sum() != before_hc
    }
    if wcgfx.conf_due() && wcgfx.conf_changed() {
        let before: u64 = thapply.theme_sum()
        let _g: u64 = reload_inner(true)
        return thapply.theme_sum() != before
    }
    if wcbase.set_mode == wcbase.MODE_AUTO {
        var want: u64 = 0
        if wcgfx.auto_is_dark() {
            want = 1
        }
        if want != thbase.cur_dark {
            let before: u64 = thapply.theme_sum()
            thapply.theme_apply()
            return thapply.theme_sum() != before
        }
    }
    return false
}

fn theme_bad_keys() -> u64 {
    return thbase.kv_bad
}

fn theme_scheme_keys() -> u64 {
    return sch_keys
}

fn theme_count() -> u64 {
    return thbase.ovr_n
}

fn theme_token_count() -> u64 {
    return wcbase.C_COUNT
}

fn theme_semantic_count() -> u64 {
    return wcbase.S_COUNT
}

fn theme_override_count() -> u64 {
    return thbase.ovr_n
}

fn theme_load(path: u64) -> u64 {
    if booted == 0 {
        let _g: u64 = theme_reload()
    }
    thbase.ovr_n = 0
    var z: u64 = 0
    while z < wcbase.C_COUNT {
        wcbase.ovr_on[(z) as usize] = 0
        z = z + 1
    }

    if hc_seen != 0 {
        thapply.theme_apply()
        return 0
    }
    let n: u64 = thfile.kv_read(path, 2)
    thapply.theme_apply()
    return n
}
