profile kernel

import uitheme.thapply
import uitheme.thbase
import uitheme.thfile
import uitheme.thload
import uitheme.thtokens
import uitheme.thengine
import uitheme.thcolor

static mut prb_comp: [u64; 41] = [0 as u64; 41]

static mut prb_met: [u64; 37] = [0 as u64; 37]

static mut prb_pair: [u64; 21] = [0 as u64; 21]

static mut prb_txt: u64 = 0

static mut prb_min: u64 = 0

static mut prb_worst: u64 = 0

static mut prb_ok: u64 = 1

static mut prb_moved: u64 = 0

static mut prb_high: u64 = 0

const PAIR_COUNT: u64 = 21

fn theme_probe(scheme: u64, mode: u64, shape: u64, accent: u64) -> u64 {
    var p_dir: [u8; 14] = "/etc/schemas/\0"
    var p_shapes: [u8; 13] = "/etc/shapes/\0"
    var path: [u8; 64] = [0 as u8; 64]
    thcolor.pairs_init()
    thengine.comp_map_init()
    thbase.kv_bad = 0
    thengine.primitives_builtin()
    thengine.metrics_classic()
    var n: u64 = 0
    while *((scheme + n) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    thengine.copy_bounded((&thtokens.sch_file[0 as usize]) as u64, scheme, n, 32)
    thengine.path_join((&p_dir[0 as usize]) as u64, (&thtokens.sch_file[0 as usize]) as u64,
        (&path[0 as usize]) as u64, 64)
    let keys: u64 = thfile.kv_read((&path[0 as usize]) as u64, 0)

    var m: u64 = 0
    while *((shape + m) as *mut u8) != 0 as u8 {
        m = m + 1
    }
    if m > 0 {
        thengine.copy_bounded((&thtokens.shp_file[0 as usize]) as u64, shape, m, 32)
        thengine.path_join((&p_shapes[0 as usize]) as u64,
            (&thtokens.shp_file[0 as usize]) as u64,
            (&path[0 as usize]) as u64, 64)
        let sk: u64 = thfile.kv_read((&path[0 as usize]) as u64, 4)
        if sk == 0 {
            thengine.metrics_classic()
        } else if thtokens.met[(thtokens.M_RADIUS_BUTTON) as usize] != 0
            || thtokens.met[(thtokens.M_SHADOW) as usize] != 0 {
            thtokens.shp_id = thbase.SHAPE_MODERN
        }
    }
    thengine.glas_metrics()
    thtokens.set_mode = mode
    thtokens.set_accent = accent
    if accent != 0 && (accent & thtokens.RGB24) == 0 {
        thtokens.set_accent = thtokens.ACCENT_BLACK
    }

    thapply.theme_apply()
    var i: u64 = 0
    while i < thtokens.C_COUNT {
        prb_comp[(i) as usize] = thtokens.sem[(thtokens.comp_role[(i) as usize]) as usize]
        i = i + 1
    }
    var j: u64 = 0
    while j < thtokens.M_COUNT {
        prb_met[(j) as usize] = thtokens.met[(j) as usize]
        j = j + 1
    }
    prb_high = thtokens.sch_high
    prb_ok = 0
    if thtokens.acc_ok != 0 {
        prb_ok = 1
    }
    prb_moved = thtokens.acc_moved
    prb_txt = thcolor.contrast(thtokens.sem[(thtokens.S_TEXT_PRIMARY) as usize],
        thtokens.sem[(thtokens.S_SURFACE) as usize])
    var k: u64 = 0
    var least: u64 = 0xFFFFFFFFFFFFFFFF
    var wat: u64 = 0
    while k < PAIR_COUNT {
        let r: u64 = thcolor.contrast(thtokens.sem[(thtokens.pair_fg[(k) as usize]) as usize],
            thtokens.sem[(thtokens.pair_bg[(k) as usize]) as usize])
        prb_pair[(k) as usize] = r
        if r < least {
            least = r
            wat = k
        }
        k = k + 1
    }
    prb_min = least
    prb_worst = wat

    let _g: u64 = thload.reload_inner(false)
    return keys
}

fn theme_probe_comp(i: u64) -> u64 {
    if i >= thtokens.C_COUNT {
        return 0
    }
    return prb_comp[(i) as usize]
}

fn theme_probe_metric(i: u64) -> u64 {
    if i >= thtokens.M_COUNT {
        return 0
    }
    return prb_met[(i) as usize]
}

fn theme_probe_txt() -> u64 {
    return prb_txt
}

fn theme_probe_min() -> u64 {
    return prb_min
}

fn theme_probe_worst() -> u64 {
    return prb_worst
}

fn theme_probe_ok() -> bool {
    return prb_ok != 0
}

fn theme_probe_moved() -> u64 {
    return prb_moved
}

fn theme_probe_high() -> bool {
    return prb_high != 0
}

fn theme_probe_pairs() -> u64 {
    return PAIR_COUNT
}

fn theme_probe_pair(i: u64) -> u64 {
    if i >= PAIR_COUNT {
        return 0
    }
    return prb_pair[(i) as usize]
}

fn theme_probe_pair_fg(i: u64) -> u64 {
    thcolor.pairs_init()
    if i >= PAIR_COUNT {
        return 0
    }
    return thtokens.pair_fg[(i) as usize]
}

fn theme_probe_pair_bg(i: u64) -> u64 {
    thcolor.pairs_init()
    if i >= PAIR_COUNT {
        return 0
    }
    return thtokens.pair_bg[(i) as usize]
}
