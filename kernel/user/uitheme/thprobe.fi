profile kernel

import uitheme.thapply
import uitheme.thbase
import uitheme.thfile
import uitheme.thload
import wlibc.wcbase
import wlibc.wcgfx
import wlibc.wcpaint

static mut prb_comp: [u64; 41] = [0 as u64; 41]

static mut prb_met: [u64; 37] = [0 as u64; 37]

static mut prb_pair: [u64; 21] = [0 as u64; 21]

static mut prb_txt: u64 = 0

static mut prb_min: u64 = 0

static mut prb_worst: u64 = 0

static mut prb_ok: u64 = 1

static mut prb_moved: u64 = 0

static mut prb_high: u64 = 0

const PAIR_COUNT: u64 = 21

fn theme_probe(scheme: u64, mode: u64, shape: u64, accent: u64) -> u64 {
    var p_dir: [u8; 14] = "/etc/schemas/\0"
    var p_shapes: [u8; 13] = "/etc/shapes/\0"
    var path: [u8; 64] = [0 as u8; 64]
    wcpaint.pairs_init()
    wcgfx.comp_map_init()
    thbase.kv_bad = 0
    wcgfx.primitives_builtin()
    wcgfx.metrics_classic()
    var n: u64 = 0
    while *((scheme + n) as *mut u8) != 0 as u8 {
        n = n + 1
    }
    wcgfx.copy_bounded((&wcbase.sch_file[0 as usize]) as u64, scheme, n, 32)
    wcgfx.path_join((&p_dir[0 as usize]) as u64, (&wcbase.sch_file[0 as usize]) as u64,
        (&path[0 as usize]) as u64, 64)
    let keys: u64 = thfile.kv_read((&path[0 as usize]) as u64, 0)

    var m: u64 = 0
    while *((shape + m) as *mut u8) != 0 as u8 {
        m = m + 1
    }
    if m > 0 {
        wcgfx.copy_bounded((&wcbase.shp_file[0 as usize]) as u64, shape, m, 32)
        wcgfx.path_join((&p_shapes[0 as usize]) as u64,
            (&wcbase.shp_file[0 as usize]) as u64,
            (&path[0 as usize]) as u64, 64)
        let sk: u64 = thfile.kv_read((&path[0 as usize]) as u64, 4)
        if sk == 0 {
            wcgfx.metrics_classic()
        } else if wcbase.met[(wcbase.M_RADIUS_BUTTON) as usize] != 0
            || wcbase.met[(wcbase.M_SHADOW) as usize] != 0 {
            wcbase.shp_id = thbase.SHAPE_MODERN
        }
    }
    wcgfx.glas_metrics()
    wcbase.set_mode = mode
    wcbase.set_accent = accent
    if accent != 0 && (accent & wcbase.RGB24) == 0 {
        wcbase.set_accent = wcbase.ACCENT_BLACK
    }

    thapply.theme_apply()
    var i: u64 = 0
    while i < wcbase.C_COUNT {
        prb_comp[(i) as usize] = wcbase.sem[(wcbase.comp_role[(i) as usize]) as usize]
        i = i + 1
    }
    var j: u64 = 0
    while j < wcbase.M_COUNT {
        prb_met[(j) as usize] = wcbase.met[(j) as usize]
        j = j + 1
    }
    prb_high = wcbase.sch_high
    prb_ok = 0
    if wcbase.acc_ok != 0 {
        prb_ok = 1
    }
    prb_moved = wcbase.acc_moved
    prb_txt = wcpaint.contrast(wcbase.sem[(wcbase.S_TEXT_PRIMARY) as usize],
        wcbase.sem[(wcbase.S_SURFACE) as usize])
    var k: u64 = 0
    var least: u64 = 0xFFFFFFFFFFFFFFFF
    var wat: u64 = 0
    while k < PAIR_COUNT {
        let r: u64 = wcpaint.contrast(wcbase.sem[(wcbase.pair_fg[(k) as usize]) as usize],
            wcbase.sem[(wcbase.pair_bg[(k) as usize]) as usize])
        prb_pair[(k) as usize] = r
        if r < least {
            least = r
            wat = k
        }
        k = k + 1
    }
    prb_min = least
    prb_worst = wat

    let _g: u64 = thload.reload_inner(false)
    return keys
}

fn theme_probe_comp(i: u64) -> u64 {
    if i >= wcbase.C_COUNT {
        return 0
    }
    return prb_comp[(i) as usize]
}

fn theme_probe_metric(i: u64) -> u64 {
    if i >= wcbase.M_COUNT {
        return 0
    }
    return prb_met[(i) as usize]
}

fn theme_probe_txt() -> u64 {
    return prb_txt
}

fn theme_probe_min() -> u64 {
    return prb_min
}

fn theme_probe_worst() -> u64 {
    return prb_worst
}

fn theme_probe_ok() -> bool {
    return prb_ok != 0
}

fn theme_probe_moved() -> u64 {
    return prb_moved
}

fn theme_probe_high() -> bool {
    return prb_high != 0
}

fn theme_probe_pairs() -> u64 {
    return PAIR_COUNT
}

fn theme_probe_pair(i: u64) -> u64 {
    if i >= PAIR_COUNT {
        return 0
    }
    return prb_pair[(i) as usize]
}

fn theme_probe_pair_fg(i: u64) -> u64 {
    wcpaint.pairs_init()
    if i >= PAIR_COUNT {
        return 0
    }
    return wcbase.pair_fg[(i) as usize]
}

fn theme_probe_pair_bg(i: u64) -> u64 {
    wcpaint.pairs_init()
    if i >= PAIR_COUNT {
        return 0
    }
    return wcbase.pair_bg[(i) as usize]
}
