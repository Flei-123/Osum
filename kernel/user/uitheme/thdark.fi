profile kernel

import uitheme.thtokens

const DARK_BASE: u64 = 0x00202124

const DARK_SURFACE: u64 = 0x001A1B1E

const DARK_SURFACE_RAISED: u64 = 0x002A2B2F

const DARK_BUTTON: u64 = 0x002F3034

const DARK_BUTTON_HOVER: u64 = 0x002D2E32

const DARK_BUTTON_ACTIVE: u64 = 0x00383B3F

const DARK_FIELD: u64 = 0x002F3034

const DARK_FIELD_FOCUS: u64 = 0x0035363B

const DARK_BORDER: u64 = 0x003A3B40

const DARK_SEPARATOR: u64 = 0x002E2F33

const DARK_TEXT: u64 = 0x00E8EAED

const DARK_TEXT_MUTED: u64 = 0x00A1A7AD

const DARK_TEXT_DISABLED: u64 = 0x00A1A7AD

const DARK_TEXT_ON_ACCENT: u64 = 0x00FFFFFF

const DARK_ACCENT: u64 = 0x002563EB

const DARK_ACCENT_HOVER: u64 = 0x001D4ED8

const DARK_RING: u64 = 0x0060A5FA

const DARK_SELECTION: u64 = 0x00383B3F

const DARK_SELECTION_TEXT: u64 = 0x00E8EAED

const DARK_ERROR: u64 = 0x00FCA5A5

const DARK_WARNING: u64 = 0x00FBBF24

const DARK_SUCCESS: u64 = 0x0034D399

fn active() -> bool {
    if thtokens.sch_high != 0 {
        return false
    }
    return thtokens.sch_pal != 0
}

fn bind_surfaces() {
    thtokens.sem[(thtokens.S_SURFACE) as usize] = DARK_SURFACE
    thtokens.sem[(thtokens.S_SURFACE_RAISED) as usize] = DARK_SURFACE_RAISED
    thtokens.sem[(thtokens.S_SURFACE_SUNKEN) as usize] = DARK_BASE
    thtokens.sem[(thtokens.S_SURFACE_HOVER) as usize] = DARK_BUTTON_HOVER
    thtokens.sem[(thtokens.S_SURFACE_PRESSED) as usize] = DARK_BUTTON_ACTIVE
    thtokens.sem[(thtokens.S_CONTROL) as usize] = DARK_BUTTON
    thtokens.sem[(thtokens.S_CONTROL_HOVER) as usize] = DARK_BUTTON_HOVER
    thtokens.sem[(thtokens.S_CONTROL_PRESSED) as usize] = DARK_BUTTON_ACTIVE
    thtokens.sem[(thtokens.S_FIELD) as usize] = DARK_FIELD
    thtokens.sem[(thtokens.S_TEXT_PRIMARY) as usize] = DARK_TEXT
    thtokens.sem[(thtokens.S_TEXT_SECONDARY) as usize] = DARK_TEXT_MUTED
    thtokens.sem[(thtokens.S_TEXT_DISABLED) as usize] = DARK_TEXT_DISABLED
    thtokens.sem[(thtokens.S_BORDER) as usize] = DARK_BORDER
    thtokens.sem[(thtokens.S_BORDER_STRONG) as usize] = DARK_BORDER
}

fn bind_accent() {
    thtokens.sem[(thtokens.S_ACCENT) as usize] = DARK_ACCENT
    thtokens.sem[(thtokens.S_ACCENT_HOVER) as usize] = DARK_ACCENT_HOVER
    thtokens.sem[(thtokens.S_ACCENT_PRESSED) as usize] = DARK_ACCENT_HOVER
    thtokens.sem[(thtokens.S_ON_ACCENT) as usize] = DARK_TEXT_ON_ACCENT
    thtokens.sem[(thtokens.S_BORDER_FOCUS) as usize] = DARK_RING
    thtokens.sem[(thtokens.S_SELECTION) as usize] = DARK_SELECTION
    thtokens.sem[(thtokens.S_ON_SELECTION) as usize] = DARK_SELECTION_TEXT
}

fn bind_status() {
    thtokens.sem[(thtokens.S_DANGER) as usize] = DARK_ERROR
    thtokens.sem[(thtokens.S_WARNING) as usize] = DARK_WARNING
    thtokens.sem[(thtokens.S_SUCCESS) as usize] = DARK_SUCCESS
}

fn primitives_builtin() {
    thtokens.neutral[(0) as usize] = 0x00FFFFFF
    thtokens.neutral[(1) as usize] = 0x00F8FAFC
    thtokens.neutral[(2) as usize] = 0x00F1F5F9
    thtokens.neutral[(3) as usize] = 0x00E2E8F0
    thtokens.neutral[(4) as usize] = 0x00CBD5E1
    thtokens.neutral[(5) as usize] = 0x0094A3B8
    thtokens.neutral[(6) as usize] = 0x0064748B
    thtokens.neutral[(7) as usize] = 0x00475569
    thtokens.neutral[(8) as usize] = 0x00334155
    thtokens.neutral[(9) as usize] = 0x001E293B
    thtokens.neutral[(10) as usize] = 0x000F172A
    thtokens.neutral[(11) as usize] = 0x00020617
    thtokens.neutral[(12) as usize] = 0x00000000
    thtokens.sch_accent = 0x002563EB
    thtokens.sch_danger = 0x00DC2626
    thtokens.sch_warning = 0x00B45309
    thtokens.sch_success = 0x0015803D
}
