profile kernel

import ulib

export { u_start }

const SYS_PRCTL: u64 = 157
const PR_WATCH: u64 = 0x4F535701

fn u_start(args: u64) -> u64 {
    var s_use: [u8; 49] = "svcprobe: usage svcprobe <secs> stuck|alive|exit\0"
    var m_stuck: [u8; 6] = "stuck\0"
    var m_alive: [u8; 6] = "alive\0"
    var s_go: [u8; 18] = "svcprobe: watched\0"
    if ulib.arg_count(args) < 3 {
        ulib.esay_line((&s_use[0 as usize]) as u64, 0)
        return 1
    }
    let secs: u64 = ulib.to_num(ulib.arg_at(args, 1))
    let mode: u64 = ulib.arg_at(args, 2)
    let child: u64 = ulib.sys(ulib.SYS_FORK, 0, 0, 0)
    if ulib.bad(child) {
        return 1
    }
    if child != 0 {
        return 0
    }
    ulib.sys(SYS_PRCTL, PR_WATCH, secs, 0)
    ulib.say((&s_go[0 as usize]) as u64)
    ulib.nl()
    if ulib.streq(mode, (&m_stuck[0 as usize]) as u64) {
        while true {
            ulib.sleep_ms(30000)
        }
    }
    if ulib.streq(mode, (&m_alive[0 as usize]) as u64) {
        while true {
            ulib.sleep_ms(1000)
        }
    }
    return 0
}
