profile app

import ulib
import libc.io
import libc.errno

export { exec, ready }

const O_RDONLY: u64 = 0
const O_WRONLY: u64 = 1

static mut p_dev: [u8; 10] = "/dev/tpm0\0"

fn ready() -> bool {
    let fd: u64 = io.open((&p_dev[0 as usize]) as u64, O_RDONLY)
    if ulib.bad(fd) {
        return false
    }
    io.close(fd)
    return true
}

fn exec(cmd: u64, clen: u64, rsp: u64, rcap: u64) -> u64 {
    let wfd: u64 = io.open((&p_dev[0 as usize]) as u64, O_WRONLY)
    if ulib.bad(wfd) {
        return 0
    }
    let sent: u64 = io.write_all(wfd, cmd, clen)
    io.close(wfd)
    if sent != clen {
        return 0
    }
    let rfd: u64 = io.open((&p_dev[0 as usize]) as u64, O_RDONLY)
    if ulib.bad(rfd) {
        return 0
    }
    let got: u64 = io.read_full(rfd, rsp, rcap)
    io.close(rfd)
    if errno.failed(got) {
        return 0
    }
    return got
}
