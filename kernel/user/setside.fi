import libc.io
import ulib
import setroute

export { tree_on, root_of, child_shown }

static mut flat_flag: u64 = 2
static mut p_flat: [u8; 13] = "/etc/setflat\0"

fn tree_on() -> bool {
    if flat_flag == 2 {
        flat_flag = 0
        let fd: u64 = io.open((&p_flat[0 as usize]) as u64, 0)
        if !ulib.bad(fd) {
            io.close(fd)
            flat_flag = 1
        }
    }
    return flat_flag == 0
}

fn head_of(fi: u64) -> u64 {
    var r: u64 = fi
    while r > 0 && setroute.flat_depth(r) > 0 {
        r = r - 1
    }
    return r
}

fn root_of(page: u64) -> u64 {
    if page == setroute.NONE {
        return setroute.NONE
    }
    var i: u64 = 0
    while i < setroute.flat_count() {
        if setroute.flat_page(i) == page {
            return head_of(i)
        }
        i = i + 1
    }
    return setroute.NONE
}

fn child_shown(fi: u64, root: u64) -> bool {
    if !tree_on() || setroute.flat_depth(fi) == 0 {
        return true
    }
    return head_of(fi) == root
}
