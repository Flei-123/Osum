profile kernel

import ulib
import libc.io
//   error: module 'mem' has no element 'heap_alloc'
//          --> paint/canvas.fi:121
import libc.kcall
import msg
import fileop
import appdir
import expmodell
import image
import jpeg
import pw
import libc.text

fn map_pages_hier(len: u64) -> u64 {
    let prot: u64 = kcall.PROT_READ | kcall.PROT_WRITE
    let flags: u64 = kcall.MAP_PRIVATE | kcall.MAP_ANONYMOUS
    return kcall.map_anon(len, prot, flags)
}

export {
    own_make, own_ptr, own_lines, own_size, own_chunks,
    openwith_make, openwith_num, openwith_ptr,
    openwith_exec, openwith_name, openwith_start,
    new_file, mini_ready, mini_load, mini_width, mini_height,
    mini_data, mini_slot_load, mini_slot_data, mini_slot_width,
    mini_slot_height, mini_slots, mini_edge, report
}

const MAXAPP: u64 = 24

const PIXCAP: u64 = 4210688
const DATCAP: u64 = 786432
const MINIW: u64 = 64        // Kantenlaenge einer Miniatur
const MINSLOT: u64 = 16      // so viele Miniaturen haelt die Symbolansicht

const ST_UID: u64 = 28

static mut txt: [u8; 2048] = [0 as u8; 2048]
static mut tp: u64 = 0
static mut lines: u64 = 0
static mut gr_sum: u64 = 0
static mut st_num: u64 = 0
static mut st: [u8; 144] = [0 as u8; 144]
static mut zbuf: [u8; 24] = [0 as u8; 24]
static mut tbuf: [u8; 24] = [0 as u8; 24]
static mut obuf: [u8; 64] = [0 as u8; 64]

static mut a_blob: [u8; 1024] = [0 as u8; 1024]
static mut a_exec: [u8; 3072] = [0 as u8; 3072]  // MAXAPP * 128
static mut a_name: [u8; 1536] = [0 as u8; 1536]  // MAXAPP * 64
static mut n_app: u64 = 0
static mut ow_arg: [u8; 256] = [0 as u8; 256]
static mut ow_argv: [u64; 2] = [0 as u64; 2]

static mut m_da: u64 = 0
static mut m_w: u64 = 0
static mut m_h: u64 = 0
static mut m_data: u64 = 0
static mut m_pix: u64 = 0
static mut m_dat: u64 = 0
static mut m_cache: u64 = 0
static mut m_kein: u64 = 0
static mut bw: u64 = 0
static mut bh: u64 = 0
static mut s_w: [u64; 16] = [0 as u64; 16]
static mut s_h: [u64; 16] = [0 as u64; 16]

static mut k_name: [u8; 19] = "explorer.prop.name\0"
static mut k_typ: [u8; 19] = "explorer.prop.type\0"
static mut k_size: [u8; 19] = "explorer.prop.size\0"
static mut k_inhalt: [u8; 23] = "explorer.prop.contains\0"
static mut k_mtime: [u8; 22] = "explorer.prop.changed\0"
static mut k_ctime: [u8; 22] = "explorer.prop.created\0"
static mut k_atime: [u8; 19] = "explorer.prop.read\0"
static mut k_mode: [u8; 21] = "explorer.prop.rights\0"
static mut k_owner: [u8; 20] = "explorer.prop.owner\0"
static mut k_tdir: [u8; 21] = "explorer.type.folder\0"
static mut k_tfile: [u8; 19] = "explorer.type.file\0"
static mut k_tprog: [u8; 22] = "explorer.type.program\0"
static mut k_timg: [u8; 20] = "explorer.type.image\0"
static mut k_ttext: [u8; 19] = "explorer.type.text\0"
static mut t_appdir: [u8; 6] = "/apps\0"
static mut s_own: [u8; 24] = "explorer: props lines=\0\0"
static mut s_gr: [u8; 7] = "bytes=\0"
static mut s_st: [u8; 8] = "stueck=\0"
static mut s_app: [u8; 22] = "explorer: openwith n=\0"
static mut s_start: [u8; 26] = "explorer: openwith start=\0"
static mut s_pid: [u8; 6] = "pid=\0\0"
static mut s_mini: [u8; 18] = "explorer: mini w=\0"
static mut s_mh: [u8; 3] = "h=\0"
static mut s_ms: [u8; 6] = "slot=\0"
static mut s_lz: [u8; 2] = " \0"

static mut e_png: [u8; 4] = "png\0"
static mut e_bmp: [u8; 4] = "bmp\0"
static mut e_jpg: [u8; 4] = "jpg\0"
static mut e_jpeg: [u8; 5] = "jpeg\0"
static mut e_txt: [u8; 4] = "txt\0"
static mut e_md: [u8; 3] = "md\0"
static mut e_conf: [u8; 5] = "conf\0"
static mut e_log: [u8; 4] = "log\0"

fn put(c: u64) {
    if tp < 2040 {
        txt[(tp) as usize] = c as u8
        tp = tp + 1
    }
}

fn puts(p: u64) {
    var k: u64 = 0
    while (__mmio_read8((p + k) as *mut u8)) != 0 as u8 {
        put((__mmio_read8((p + k) as *mut u8)) as u64)
        k = k + 1
    }
}

fn putn(v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    let n: u64 = text.digits(v, (&d[(0) as usize]) as u64, true)
    var k: u64 = 0
    while k < n {
        put((d[(k) as usize]) as u64)
        k = k + 1
    }
}

fn line_txt(key: u64, value: u64) {
    puts(msg.get(key))
    put(32)
    puts(value)
    put(10)
    lines = lines + 1
}

fn line_num(key: u64, value: u64) {
    puts(msg.get(key))
    put(32)
    putn(value)
    put(10)
    lines = lines + 1
}

fn line_time(key: u64, sec: u64, als_ort: u64) {
    if als_ort != 0 {
        let _p: u64 = expmodell.time_text(sec, (&tbuf[(0) as usize]) as u64)
        line_txt(key, (&tbuf[(0) as usize]) as u64)
    } else {
        line_num(key, sec)
    }
}

fn ends_with(name: u64, endung: u64) -> bool {
    let n: u64 = text.length(name)
    let e: u64 = text.length(endung)
    if n < e + 1 {
        return false
    }
    if (__mmio_read8((name + n - e - 1) as *mut u8)) != 46 as u8 {
        return false
    }
    var i: u64 = 0
    while i < e {
        let a: u64 = text.lower((__mmio_read8((name + n - e + i)
            as *mut u8)) as u64)
        let b: u64 = text.lower((__mmio_read8((endung + i)
            as *mut u8)) as u64)
        if a != b {
            return false
        }
        i = i + 1
    }
    return true
}

fn ist_bildname(name: u64) -> bool {
    if ends_with(name, (&e_png[(0) as usize]) as u64) {
        return true
    }
    if ends_with(name, (&e_bmp[(0) as usize]) as u64) {
        return true
    }
    if ends_with(name, (&e_jpg[(0) as usize]) as u64) {
        return true
    }
    if ends_with(name, (&e_jpeg[(0) as usize]) as u64) {
        return true
    }
    return false
}

fn ist_textname(name: u64) -> bool {
    if ends_with(name, (&e_txt[(0) as usize]) as u64) {
        return true
    }
    if ends_with(name, (&e_md[(0) as usize]) as u64) {
        return true
    }
    if ends_with(name, (&e_conf[(0) as usize]) as u64) {
        return true
    }
    if ends_with(name, (&e_log[(0) as usize]) as u64) {
        return true
    }
    return false
}

fn artschluessel(dir: bool, m: u64, name: u64) -> u64 {
    if dir {
        return (&k_tdir[(0) as usize]) as u64
    }
    if ist_bildname(name) {
        return (&k_timg[(0) as usize]) as u64
    }
    if ist_textname(name) {
        return (&k_ttext[(0) as usize]) as u64
    }
    if (m & 73) != 0 {
        return (&k_tprog[(0) as usize]) as u64
    }
    return (&k_tfile[(0) as usize]) as u64
}

fn modetext(m: u64, dir: bool, out: u64) {
    var at: u64 = 0
    if dir {
        __mmio_write8((out) as *mut u8, 100 as u8)
    } else {
        __mmio_write8((out) as *mut u8, 45 as u8)
    }
    at = 1
    var bit: u64 = 256
    var i: u64 = 0
    while i < 9 {
        var z: u64 = 45
        if (m & bit) != 0 {
            if i % 3 == 0 {
                z = 114
            } else if i % 3 == 1 {
                z = 119
            } else {
                z = 120
            }
        }
        __mmio_write8((out + at) as *mut u8, z as u8)
        at = at + 1
        bit = bit / 2
        i = i + 1
    }
    __mmio_write8((out + at) as *mut u8, 0 as u8)
}

fn eigner_text(sb: u64, out: u64) {
    let uid: u64 = (__mmio_read32((sb + ST_UID) as *mut u32)) as u64
    if pw.name_of_uid(uid, out, 60) {
        if (__mmio_read8((out) as *mut u8)) != 0 as u8 {
            return
        }
    }
    let n: u64 = text.digits(uid, out, true)
    __mmio_write8((out + n) as *mut u8, 0 as u8)
}

fn own_make(file_path: u64, name: u64, time_place: u64) -> u64 {
    tp = 0
    lines = 0
    gr_sum = 0
    st_num = 0
    line_txt((&k_name[(0) as usize]) as u64, name)
    let sr: u64 = io.stat_into(file_path, (&st[(0) as usize]) as u64)
    var dir: bool = false
    var m: u64 = 0
    if !ulib.bad(sr) {
        let sb: u64 = (&st[(0) as usize]) as u64
        m = io.stat_mode_of(sb)
        dir = io.is_dir_mode(m)
        line_txt((&k_typ[(0) as usize]) as u64,
            msg.get(artschluessel(dir, m, name)))
        if dir {
            gr_sum = fileop.size_recursive(file_path, 0)
            st_num = fileop.count_recursive(file_path, 0)
            line_num((&k_size[(0) as usize]) as u64, gr_sum)
            line_num((&k_inhalt[(0) as usize]) as u64, st_num)
        } else {
            gr_sum = io.stat_size(sb)
            st_num = 1
            line_num((&k_size[(0) as usize]) as u64, gr_sum)
        }
        line_time((&k_ctime[(0) as usize]) as u64, io.stat_ctime(sb),
            time_place)
        line_time((&k_mtime[(0) as usize]) as u64, io.stat_mtime(sb),
            time_place)
        line_time((&k_atime[(0) as usize]) as u64, io.stat_atime(sb),
            time_place)
        modetext(m, dir, (&zbuf[(0) as usize]) as u64)
        line_txt((&k_mode[(0) as usize]) as u64,
            (&zbuf[(0) as usize]) as u64)
        eigner_text(sb, (&obuf[(0) as usize]) as u64)
        line_txt((&k_owner[(0) as usize]) as u64,
            (&obuf[(0) as usize]) as u64)
    }
    put(0)
    ulib.say((&s_own[(0) as usize]) as u64)
    ulib.sayn(lines)
    ulib.say((&s_lz[(0) as usize]) as u64)
    ulib.say((&s_gr[(0) as usize]) as u64)
    ulib.sayn(gr_sum)
    ulib.say((&s_lz[(0) as usize]) as u64)
    ulib.say((&s_st[(0) as usize]) as u64)
    ulib.sayn(st_num)
    ulib.nl()
    return lines
}

fn own_ptr() -> u64 {
    return (&txt[(0) as usize]) as u64
}

fn own_lines() -> u64 {
    return lines
}

fn own_size() -> u64 {
    return gr_sum
}

fn own_chunks() -> u64 {
    return st_num
}

// ----------------------------------------------------- oeffnen mit

fn openwith_name(i: u64) -> u64 {
    return (&a_name[(0) as usize]) as u64 + i * 64
}

fn openwith_exec(i: u64) -> u64 {
    return (&a_exec[(0) as usize]) as u64 + i * 128
}

fn openwith_num() -> u64 {
    return n_app
}

fn openwith_ptr() -> u64 {
    return (&a_blob[(0) as usize]) as u64
}

fn openwith_make() -> u64 {
    n_app = 0
    var bp: u64 = 0
    let na: u64 = appdir.load((&t_appdir[(0) as usize]) as u64, false)
    var i: u64 = 0
    while i < na && n_app < MAXAPP {
        let nm: u64 = appdir.name_of(i)
        let ex: u64 = appdir.exec_of(i)
        if nm != 0 && ex != 0 {
            ulib.strncpy(openwith_name(n_app), nm, 62)
            ulib.strncpy(openwith_exec(n_app), ex, 126)
            var k: u64 = 0
            while (__mmio_read8((nm + k) as *mut u8)) != 0 as u8
                && bp < 1000 {
                a_blob[(bp) as usize] = __mmio_read8((nm + k) as *mut u8)
                bp = bp + 1
                k = k + 1
            }
            a_blob[(bp) as usize] = 10 as u8
            bp = bp + 1
            n_app = n_app + 1
        }
        i = i + 1
    }
    if bp > 0 {
        bp = bp - 1
    }
    a_blob[(bp) as usize] = 0 as u8
    ulib.say((&s_app[(0) as usize]) as u64)
    ulib.sayn(n_app)
    ulib.nl()
    return n_app
}

fn openwith_start(i: u64, file: u64) -> u64 {
    if i >= n_app {
        return 0 -% 22
    }
    ulib.strncpy((&ow_arg[(0) as usize]) as u64, file, 250)
    ow_argv[(0) as usize] = openwith_exec(i)
    ow_argv[(1) as usize] = (&ow_arg[(0) as usize]) as u64
    let pid: u64 = ulib.sys(ulib.SYS_EXEC, openwith_exec(i),
        (&ow_argv[(0) as usize]) as u64, 2)
    ulib.say((&s_start[(0) as usize]) as u64)
    ulib.sayn(i)
    ulib.say((&s_lz[(0) as usize]) as u64)
    ulib.say((&s_pid[(0) as usize]) as u64)
    ulib.sayn(pid)
    ulib.nl()
    return pid
}

// ----------------------------------------------------- neue Datei

fn new_file(file_path: u64, inhalt: u64) -> u64 {
    let fd: u64 = io.create(file_path)
    if ulib.bad(fd) {
        return fd
    }
    var rc: u64 = 0
    if inhalt != 0 {
        let n: u64 = text.length(inhalt)
        if n > 0 {
            rc = io.write_all(fd, inhalt, n)
        }
    }
    io.close(fd)
    if ulib.bad(rc) {
        return rc
    }
    return 0
}

// ------------------------------------------------------- Miniaturen

fn buffer_present() -> bool {
    if m_kein != 0 {
        return false
    }
    if m_pix != 0 && m_dat != 0 && m_cache != 0 {
        return true
    }
    if m_pix == 0 {
        let p: u64 = map_pages_hier(PIXCAP)
        if ulib.bad(p) || p == 0 {
            m_kein = 1
            return false
        }
        m_pix = p
    }
    if m_dat == 0 {
        let d: u64 = map_pages_hier(DATCAP)
        if ulib.bad(d) || d == 0 {
            m_kein = 1
            return false
        }
        m_dat = d
    }
    if m_cache == 0 {
        let c: u64 = map_pages_hier(MINSLOT * MINIW * MINIW * 4)
        if ulib.bad(c) || c == 0 {
            m_kein = 1
            return false
        }
        m_cache = c
    }
    return true
}

fn file_read(file_path: u64) -> u64 {
    let fd: u64 = io.open(file_path, 0)
    if ulib.bad(fd) {
        return 0
    }
    var n: u64 = 0
    var next: bool = true
    while next {
        let g: u64 = io.read(fd, m_dat + n, DATCAP - n)
        if ulib.bad(g) || g == 0 {
            next = false
        } else {
            n = n + g
            if n >= DATCAP {
                next = false
            }
        }
    }
    io.close(fd)
    return n
}

fn image_get(file_path: u64) -> bool {
    bw = 0
    bh = 0
    let n: u64 = file_read(file_path)
    if n == 0 {
        return false
    }
    if image.ist_png(m_dat, n) {
        if !image.png_read(m_dat, n, m_pix, PIXCAP) {
            return false
        }
        bw = image.width()
        bh = image.height()
        return bw != 0 && bh != 0
    }
    if image.ist_bmp(m_dat, n) {
        if !image.bmp_read(m_dat, n, m_pix, PIXCAP) {
            return false
        }
        bw = image.width()
        bh = image.height()
        return bw != 0 && bh != 0
    }
    if jpeg.ist_jpeg(m_dat, n) {
        if !jpeg.jpeg_read(m_dat, n, m_pix, PIXCAP) {
            return false
        }
        bw = jpeg.width()
        bh = jpeg.height()
        return bw != 0 && bh != 0
    }
    return false
}

fn verkleinern(target: u64) -> u64 {
    var i: u64 = 0
    while i < MINIW * MINIW {
        __mmio_write32((target + i * 4) as *mut u32, 0 as u32)
        i = i + 1
    }
    var lang: u64 = bw
    if bh > lang {
        lang = bh
    }
    if lang == 0 {
        return 0
    }
    var zw: u64 = bw * MINIW / lang
    var zh: u64 = bh * MINIW / lang
    if zw == 0 {
        zw = 1
    }
    if zh == 0 {
        zh = 1
    }
    var y: u64 = 0
    while y < zh {
        var x: u64 = 0
        while x < zw {
            let sx: u64 = x * bw / zw
            let sy: u64 = y * bh / zh
            if sx < bw && sy < bh {
                let c: u64 = (__mmio_read32((m_pix + (sy * bw + sx) * 4)
                    as *mut u32)) as u64
                __mmio_write32((target + (y * zw + x) * 4) as *mut u32,
                    c as u32)
            }
            x = x + 1
        }
        y = y + 1
    }
    m_w = zw
    m_h = zh
    return zw
}

fn mini_ready() -> bool {
    return m_da != 0
}

fn mini_edge() -> u64 {
    return MINIW
}

fn mini_slots() -> u64 {
    return MINSLOT
}

fn slot_ptr(s: u64) -> u64 {
    if m_cache == 0 || s >= MINSLOT {
        return 0
    }
    return m_cache + s * MINIW * MINIW * 4
}

fn mini_load(file_path: u64) -> u64 {
    m_da = 0
    m_w = 0
    m_h = 0
    m_data = 0
    if buffer_present() {
        if image_get(file_path) {
            let z: u64 = slot_ptr(0)
            if z != 0 {
                if verkleinern(z) != 0 {
                    m_data = z
                    m_da = 1
                    s_w[(0) as usize] = m_w
                    s_h[(0) as usize] = m_h
                }
            }
        }
    }
    ulib.say((&s_mini[(0) as usize]) as u64)
    ulib.sayn(m_w)
    ulib.say((&s_lz[(0) as usize]) as u64)
    ulib.say((&s_mh[(0) as usize]) as u64)
    ulib.sayn(m_h)
    ulib.nl()
    return m_w
}

fn mini_slot_load(file_path: u64, slot: u64) -> u64 {
    if slot >= MINSLOT {
        return 0
    }
    s_w[(slot) as usize] = 0
    s_h[(slot) as usize] = 0
    var b: u64 = 0
    if buffer_present() {
        if image_get(file_path) {
            let z: u64 = slot_ptr(slot)
            if z != 0 {
                b = verkleinern(z)
                s_w[(slot) as usize] = m_w
                s_h[(slot) as usize] = m_h
                if b != 0 {
                    m_da = 1
                    m_data = z
                }
            }
        }
    }
    ulib.say((&s_mini[(0) as usize]) as u64)
    ulib.sayn(b)
    ulib.say((&s_lz[(0) as usize]) as u64)
    ulib.say((&s_ms[(0) as usize]) as u64)
    ulib.sayn(slot)
    ulib.nl()
    return b
}

fn mini_slot_data(slot: u64) -> u64 {
    if slot >= MINSLOT || s_w[(slot) as usize] == 0 {
        return 0
    }
    return slot_ptr(slot)
}

fn mini_slot_width(slot: u64) -> u64 {
    if slot >= MINSLOT {
        return 0
    }
    return s_w[(slot) as usize]
}

fn mini_slot_height(slot: u64) -> u64 {
    if slot >= MINSLOT {
        return 0
    }
    return s_h[(slot) as usize]
}

fn mini_width() -> u64 {
    return m_w
}

fn mini_height() -> u64 {
    return m_h
}

fn mini_data() -> u64 {
    return m_data
}

fn report() {
    ulib.say((&s_app[(0) as usize]) as u64)
    ulib.sayn(n_app)
    ulib.nl()
    ulib.say((&s_mini[(0) as usize]) as u64)
    ulib.sayn(m_w)
    ulib.say((&s_lz[(0) as usize]) as u64)
    ulib.say((&s_mh[(0) as usize]) as u64)
    ulib.sayn(m_h)
    ulib.nl()
}
