        // gesetzt wird, macht das Fenster in jedem Durchlauf schmutzig
        // und den Fensterserver zum Dauerlaeufer.
        if reiter == R_SCHIRM {
            let rest: u64 = (dget(DG_REMAIN) + 999) / 1000
            if rest != frist_vor {
                frist_vor = rest
                let _fl: bool = frist_lesen()
                wlib.set_text(_sf, (&d_frist[0 as usize]) as u64)
