// kernel/user/einstellungen.fi -- Runde DESKTOP: /bin/einstellungen.
//
// ROADMAP-PUNKT 2.7 in orientos/ROADMAP.md: "Einstellungen, Themen,
// Hintergrundbilder -- Farbschema als Datei, Bild laden, ein Programm
// dafuer." Bis zum 27.08.2026 stand dort "offen", und es gab im ganzen
// Baum kein Programm dieses Namens.
//
// FUENF REITER, und jeder von ihnen SCHREIBT WIRKLICH ETWAS:
//
//   Darstellung  RUNDE THEME: der Reiter schreibt `/etc/theme.conf`
//                -- Schema, Modus (hell / dunkel / automatisch) und
//                Akzentfarbe. Er kopiert NICHTS mehr nach `/etc/theme`:
//                ein Schema unter `/etc/schemas/` traegt rohe Rampen,
//                und was daraus wird, rechnet `wlibc.theme_reload()`
//                aus. Schreibtisch, Taskleiste und jedes Fenster sehen
//                nach und wechseln OHNE Neustart.
//                UND ER PRUEFT DEN KONTRAST. Wer eine Akzentfarbe
//                eintraegt, bekommt die gemessenen Verhaeltnisse zu
//                sehen (WCAG 2.1: 4,5:1 fuer Text, 3:1 fuer ein
//                Bedienelement) und die Meldung, um wie viele Stufen
//                die Farbe verschoben werden musste. Eine Oberflaeche,
//                die eine unlesbare Farbe stumm annimmt, hat den
//                Benutzer belogen.
//                Dazu: ein Hintergrundbild aus einer Datei nach
//                `/etc/wallpaper` kopieren.
//   Bildschirm   schreibt `/etc/schirm.conf`. EHRLICH: dieser Kernel
//                setzt den Bildmodus beim Start (`fbbig`, kernel/fb.fi)
//                und kann ihn im Betrieb NICHT wechseln. Das steht so
//                im Fenster und nicht im Kleingedruckten.
//   Zeit         zeigt Datum und Uhrzeit aus `sysinfo` und setzt den
//                ZEITZONENVERSATZ in `/etc/zeit.conf`. EHRLICH: die
//                Hardware-Uhr laesst sich hier nicht stellen -- dieser
//                Kernel hat kein `clock_settime`, nur `SYS_TIME` zum
//                Lesen. Der Versatz ist das, was ein Programm in Ring 3
//                wirklich tun kann, und die Taskleiste zeigt danach
//                Ortszeit statt UTC.
//   Netz         zeigt Adresse, Maske, Gateway und Hardwareadresse aus
//                `osum_netget` und setzt sie ueber `osum_netset` --
//                oder startet `/bin/dhcp`. Geschrieben wird
//                `/etc/netz.conf`.
//   Benutzer     setzt ein Kennwort ueber dieselbe Rechnung wie
//                `/bin/passwd` (`kernel/user/pw.fi`, PBKDF2-HMAC-SHA256,
//                2048 Runden) und schreibt eine Zeile in `/etc/shadow`.
//
// WIE DIE REITER GEMACHT SIND. Alle Widgets aller Reiter liegen in
// EINEM senkrechten Kasten; beim Wechsel werden die des alten Reiters
// aus der Anordnung genommen (`wlib.show`) und die des neuen
// hineingegeben, danach wird neu angeordnet. Die Anordnung ueberspringt
// verborgene Widgets seit Runde K15 -- es gab bis heute nur keinen Weg,
// sie von aussen zu verbergen.

profile kernel

import ulib
import libc.io
import wlibc
import wlib
import pw

export { u_start }

const SYS_NETGET: u64 = 1300
const SYS_NETSET: u64 = 1301
const NG_READY: u64 = 0
const NG_IP: u64 = 1
const NG_MASK: u64 = 2
const NG_GW: u64 = 3
const NG_MAC0: u64 = 4
const NG_MAC1: u64 = 5

const R_DARST: u64 = 0
const R_SCHIRM: u64 = 1
const R_ZEIT: u64 = 2
const R_NETZ: u64 = 3
const R_BENUT: u64 = 4
const R_ANZ: u64 = 5

static mut w: u64 = 0
static mut ids: [u64; 64] = [0 as u64; 64]
static mut rtr: [u64; 64] = [0 as u64; 64] // zu welchem Reiter gehoert es
static mut nid: u64 = 0
static mut reiter: u64 = 0

// die Puffer der Oberflaeche
static mut schemas: [u8; 512] = [0 as u8; 512]
static mut snamen: [u8; 512] = [0 as u8; 512]
static mut nschema: u64 = 0
static mut e_bild: [u8; 96] = [0 as u8; 96]
static mut l_schirm: [u8; 64] = [0 as u8; 64]
static mut l_datum: [u8; 64] = [0 as u8; 64]
static mut l_ip: [u8; 64] = [0 as u8; 64]
static mut l_maske: [u8; 64] = [0 as u8; 64]
static mut l_gw: [u8; 64] = [0 as u8; 64]
static mut l_mac: [u8; 64] = [0 as u8; 64]
static mut l_wer: [u8; 64] = [0 as u8; 64]
static mut l_stat: [u8; 96] = [0 as u8; 96]
static mut e_ip: [u8; 24] = [0 as u8; 24]
static mut e_maske: [u8; 24] = [0 as u8; 24]
static mut e_gw: [u8; 24] = [0 as u8; 24]
static mut e_pw1: [u8; 64] = [0 as u8; 64]
static mut e_pw2: [u8; 64] = [0 as u8; 64]
static mut puffer: [u8; 2048] = [0 as u8; 2048]
static mut e_akzent: [u8; 16] = [0 as u8; 16]
static mut l_kon: [u8; 96] = [0 as u8; 96]
static mut l_warn: [u8; 96] = [0 as u8; 96]
static mut name: [u8; 64] = [0 as u8; 64]
static mut geschrieben: u64 = 0

// DIE ZEICHENKETTEN DER OBERFLAECHE STEHEN HIER UND NICHT IM RAHMEN
// VON `u_start`. Die Widget-Bibliothek BEHAELT den Zeiger auf den Text
// eines Widgets -- sie kopiert ihn nicht --, und firnc rechnet das nach:
// ein Text aus dem Rahmen einer Funktion, die zurueckkehrt, ist ein
// Zeiger auf nichts. Sechzehn Uebersetzungsfehler haben genau das
// gesagt, und sie hatten recht.
static mut t_titel: [u8; 14] = "Einstellungen\0"
static mut t_tabs: [u8; 42] = "Darstellung\nBildschirm\nZeit\nNetz\nBenutzer\0"
static mut l_far: [u8; 31] = "Farbschema (aus /etc/schemas):\0"
static mut l_bil: [u8; 38] = "Hintergrundbild -- Quelldatei (OSYM):\0"
static mut b_uber: [u8; 12] = "Uebernehmen\0"
static mut l_mod: [u8; 7] = "Modus:\0"
static mut c_mod: [u8; 36] = "Hell\nDunkel\nAutomatisch (Tageszeit)\0"
static mut l_akz: [u8; 45] = "Akzentfarbe RRGGBB (leer = die des Schemas):\0"
static mut l_aufl: [u8; 33] = "Aufloesung beim naechsten Start:\0"
static mut c_aufl: [u8; 29] = "800 x 600\n1024 x 768 (fbbig)\0"
static mut l_ehr1: [u8; 50] = "Der Bildmodus wird beim Start gesetzt; im Betrieb\0"
static mut l_ehr2: [u8; 39] = "kann dieser Kernel ihn nicht wechseln.\0"
static mut l_zone: [u8; 27] = "Zeitzone fuer die Anzeige:\0"
static mut c_zone: [u8; 31] = "UTC+0\nUTC+1 (MEZ)\nUTC+2 (MESZ)\0"
static mut l_ehr3: [u8; 51] = "Die Hardware-Uhr laesst sich hier nicht stellen --\0"
static mut l_ehr4: [u8; 42] = "dieser Kernel hat nur SYS_TIME zum Lesen.\0"
static mut l_bez: [u8; 18] = "Adresse beziehen:\0"
static mut c_bez: [u8; 25] = "ueber DHCP\nfeste Adresse\0"
static mut l_ip2: [u8; 27] = "Adresse / Maske / Gateway:\0"
static mut l_kw1: [u8; 16] = "Neues Kennwort:\0"
static mut l_kw2: [u8; 13] = "Noch einmal:\0"
static mut b_kw: [u8; 16] = "Kennwort setzen\0"

fn say(p: u64) {
    ulib.say(p)
}

fn merke(i: u64, r: u64) -> u64 {
    if nid < 64 {
        ids[(nid) as usize] = i
        rtr[(nid) as usize] = r
        nid = nid + 1
    }
    return i
}

fn text_an(p: u64, at: u64, q: u64) -> u64 {
    var k: u64 = 0
    while __mmio_read8((q + k) as *mut u8) != 0 as u8 {
        __mmio_write8((p + at + k) as *mut u8,
            __mmio_read8((q + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((p + at + k) as *mut u8, 0 as u8)
    return at + k
}

fn zahl_an(p: u64, at: u64, v: u64) -> u64 {
    if v == 0 {
        __mmio_write8((p + at) as *mut u8, 48 as u8)
        __mmio_write8((p + at + 1) as *mut u8, 0 as u8)
        return at + 1
    }
    var stellen: u64 = 0
    var t: u64 = v
    while t > 0 {
        stellen = stellen + 1
        t = t / 10
    }
    var k: u64 = stellen
    t = v
    while k > 0 {
        k = k - 1
        __mmio_write8((p + at + k) as *mut u8, (48 + (t % 10)) as u8)
        t = t / 10
    }
    __mmio_write8((p + at + stellen) as *mut u8, 0 as u8)
    return at + stellen
}

fn zwei_an(p: u64, at: u64, v: u64) -> u64 {
    __mmio_write8((p + at) as *mut u8, (48 + ((v / 10) % 10)) as u8)
    __mmio_write8((p + at + 1) as *mut u8, (48 + (v % 10)) as u8)
    __mmio_write8((p + at + 2) as *mut u8, 0 as u8)
    return at + 2
}

// Eine Adresse als vier Zahlen. `punkt` ist der Trenner, damit die
// Zeichenkette nur an einer Stelle gebaut wird.
fn ip_an(p: u64, at: u64, v: u64) -> u64 {
    var pt: [u8; 2] = ".\0"
    var a: u64 = zahl_an(p, at, (v >> 24) & 255)
    a = text_an(p, a, (&pt[0 as usize]) as u64)
    a = zahl_an(p, a, (v >> 16) & 255)
    a = text_an(p, a, (&pt[0 as usize]) as u64)
    a = zahl_an(p, a, (v >> 8) & 255)
    a = text_an(p, a, (&pt[0 as usize]) as u64)
    return zahl_an(p, a, v & 255)
}

// "10.0.2.15" -> 0x0A00020F. Gibt 0, wenn es keine Adresse ist -- und
// zwar auch bei "10.0.2" und bei "10.0.2.300".
fn ip_lesen(p: u64) -> u64 {
    var v: u64 = 0
    var teil: u64 = 0
    var ziffern: u64 = 0
    var n: u64 = 0
    var k: u64 = 0
    var gut: bool = true
    while gut {
        let c: u64 = __mmio_read8((p + k) as *mut u8) as u64
        if c >= 48 && c <= 57 {
            teil = teil * 10 + (c - 48)
            ziffern = ziffern + 1
            if teil > 255 || ziffern > 3 {
                return 0
            }
        } else if c == 46 || c == 0 {
            if ziffern == 0 {
                return 0
            }
            v = (v << 8) | teil
            n = n + 1
            teil = 0
            ziffern = 0
            if c == 0 {
                gut = false
            }
        } else {
            return 0
        }
        k = k + 1
        if k > 20 {
            return 0
        }
    }
    if n != 4 {
        return 0
    }
    return v
}

// ---------------------------------------------------------- Dateien

fn datei_lesen(pfad: u64, ziel: u64, max: u64) -> u64 {
    let fd: u64 = io.open(pfad, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = io.read_full(fd, ziel, max - 1)
    io.close(fd)
    if ulib.bad(n) {
        return 0
    }
    __mmio_write8((ziel + n) as *mut u8, 0 as u8)
    return n
}

fn datei_schreiben(pfad: u64, quelle: u64, n: u64) -> bool {
    let fd: u64 = io.create(pfad)
    if ulib.bad(fd) {
        return false
    }
    let g: u64 = io.write_all(fd, quelle, n)
    io.close(fd)
    if ulib.bad(g) || g < n {
        return false
    }
    geschrieben = geschrieben + 1
    return true
}

// EINE DATEI KOPIEREN, in Stuecken von 2048 Oktetten. Ein
// Hintergrundbild ist 170 Kilooktett und passt in keinen Puffer, den
// dieses Programm halten koennte.
fn datei_kopieren(von: u64, nach: u64) -> u64 {
    let a: u64 = io.open(von, 0)
    if ulib.bad(a) {
        return 0
    }
    let b: u64 = io.create(nach)
    if ulib.bad(b) {
        io.close(a)
        return 0
    }
    var ganz: u64 = 0
    var weiter: bool = true
    while weiter {
        let n: u64 = io.read(a, (&puffer[0 as usize]) as u64, 2048)
        if ulib.bad(n) || n == 0 {
            weiter = false
        } else {
            let g: u64 = io.write_all(b, (&puffer[0 as usize]) as u64, n)
            if ulib.bad(g) || g < n {
                weiter = false
            } else {
                ganz = ganz + n
            }
        }
    }
    io.close(a)
    io.close(b)
    if ganz > 0 {
        geschrieben = geschrieben + 1
    }
    return ganz
}

// Die Schemata aus `/etc/schemas` einlesen: die Namen als ein Textblock
// fuer die Liste, und daneben dieselben Namen einzeln, damit der Pfad
// gebaut werden kann.
fn schemas_lesen(dir: u64) -> u64 {
    var recs: [u8; 1024] = [0 as u8; 1024]
    let fd: u64 = io.dir_open(dir)
    if ulib.bad(fd) {
        return 0
    }
    var bp: u64 = 0
    var np: u64 = 0
    var n: u64 = 0
    var weiter: bool = true
    while weiter {
        let got: u64 = io.dir_read(fd, (&recs[0 as usize]) as u64, 1024)
        if ulib.bad(got) || got == 0 {
            weiter = false
        } else {
            var at: u64 = 0
            while at < got {
                let rec: u64 = (&recs[0 as usize]) as u64 + at
                let nm: u64 = io.dir_name(rec)
                let erste: u64 = __mmio_read8((nm) as *mut u8) as u64
                if erste != 46 && n < 12 {
                    var k: u64 = 0
                    while __mmio_read8((nm + k) as *mut u8) != 0 as u8
                        && k < 30 {
                        schemas[((bp + k)) as usize] =
                            __mmio_read8((nm + k) as *mut u8)
                        snamen[((np + k)) as usize] =
                            __mmio_read8((nm + k) as *mut u8)
                        k = k + 1
                    }
                    bp = bp + k
                    schemas[(bp) as usize] = 10 as u8
                    bp = bp + 1
                    snamen[((np + k)) as usize] = 0 as u8
                    np = np + 32
                    n = n + 1
                }
                let rl: u64 = io.dir_reclen(rec)
                if rl == 0 {
                    at = got
                } else {
                    at = at + rl
                }
            }
        }
    }
    io.close(fd)
    if bp > 0 {
        schemas[((bp - 1)) as usize] = 0 as u8
    }
    schemas[(bp) as usize] = 0 as u8
    nschema = n
    return n
}

fn schema_pfad(i: u64, ziel: u64) -> bool {
    var s_dir: [u8; 14] = "/etc/schemas/\0"
    if i >= nschema {
        return false
    }
    let a: u64 = text_an(ziel, 0, (&s_dir[0 as usize]) as u64)
    let _b: u64 = text_an(ziel, a,
        (&snamen[0 as usize]) as u64 + i * 32)
    return true
}

// EIN KONTRASTVERHAELTNIS ALS TEXT. `theme_contrast` liefert es mit
// hundert malgenommen -- 493 heisst 4,93 zu 1 --, und ein Benutzer,
// dem man 493 hinschreibt, liest keine Zahl, sondern einen Fehler.
fn quote_an(p: u64, at: u64, v: u64) -> u64 {
    var a: u64 = zahl_an(p, at, v / 100)
    __mmio_write8((p + a) as *mut u8, 44 as u8)
    a = a + 1
    __mmio_write8((p + a) as *mut u8, (48 + ((v / 10) % 10)) as u8)
    a = a + 1
    __mmio_write8((p + a) as *mut u8, (48 + (v % 10)) as u8)
    a = a + 1
    __mmio_write8((p + a) as *mut u8, 0 as u8)
    return a
}

// WAS DER KONTRAST WIRKLICH IST, in zwei Zeilen unter der Farbe.
// Beide Zahlen kommen aus `wlibc` und werden hier nur gesetzt -- die
// Oberflaeche rechnet nichts nach, sonst gaebe es zwei Rechnungen und
// eines Tages zwei Ergebnisse.
fn kontrast_zeigen() {
    var m_t: [u8; 16] = "Text/Akzent \0   "
    var m_f: [u8; 18] = "  Akzent/Flaeche \0"
    var m_ok: [u8; 19] = "  -- WCAG erfuellt\0"
    var m_no: [u8; 21] = "  -- WCAG NICHT ganz\0"
    var m_v: [u8; 25] = "Akzentfarbe verschoben: \0"
    var m_st: [u8; 32] = " Stufe(n) auf der eigenen Rampe\0"
    var m_ex: [u8; 37] = "Akzentfarbe unveraendert uebernommen\0"
    var m_bad: [u8; 46] = "Keine Stufe erfuellt beides -- beste genommen\0"
    let k: u64 = (&l_kon[0 as usize]) as u64
    var a: u64 = text_an(k, 0, (&m_t[0 as usize]) as u64)
    a = quote_an(k, a, wlibc.theme_accent_ratio_text())
    a = text_an(k, a, (&m_f[0 as usize]) as u64)
    a = quote_an(k, a, wlibc.theme_accent_ratio_ui())
    if wlibc.theme_accent_ok() {
        let _a2: u64 = text_an(k, a, (&m_ok[0 as usize]) as u64)
    } else {
        let _a3: u64 = text_an(k, a, (&m_no[0 as usize]) as u64)
    }
    var m_bk: [u8; 48] = "Nicht verstandene Zeilen in den Einstellungen: \0"
    let w: u64 = (&l_warn[0 as usize]) as u64
    if wlibc.theme_bad_keys() > 0 {
        // EINE FALSCH GETIPPTE ZEILE WIRD NICHT VERSCHLUCKT. Wer
        // "2563e" statt "2563eb" eintraegt, bekommt sonst stumm die
        // Farbe des Schemas und sucht den Fehler bei sich.
        let c: u64 = text_an(w, 0, (&m_bk[0 as usize]) as u64)
        let _c2: u64 = zahl_an(w, c, wlibc.theme_bad_keys())
    } else if !wlibc.theme_accent_ok() {
        let _b0: u64 = text_an(w, 0, (&m_bad[0 as usize]) as u64)
    } else if wlibc.theme_accent_exact() {
        let _b1: u64 = text_an(w, 0, (&m_ex[0 as usize]) as u64)
    } else {
        var b: u64 = text_an(w, 0, (&m_v[0 as usize]) as u64)
        b = zahl_an(w, b, wlibc.theme_accent_moved())
        let _b2: u64 = text_an(w, b, (&m_st[0 as usize]) as u64)
    }
}

// /etc/theme.conf schreiben. DAS ist der Knopf: nicht eine Datei
// kopieren, sondern die vier Angaben hinlegen, aus denen der Satz
// gerechnet wird.
fn theme_conf_schreiben(schema: u64, modus: u64, akzent: u64) -> bool {
    var k_s: [u8; 8] = "scheme=\0"
    var k_m: [u8; 7] = "\nmode=\0"
    var k_a: [u8; 9] = "\naccent=\0"
    var k_l: [u8; 14] = "\nlight_start=\0"
    var k_d: [u8; 13] = "\ndark_start=\0"
    var k_nl: [u8; 2] = "\n\0"
    var v_l: [u8; 6] = "light\0"
    var v_d: [u8; 5] = "dark\0"
    var v_a: [u8; 5] = "auto\0"
    var t_conf: [u8; 16] = "/etc/theme.conf\0"
    let b: u64 = (&puffer[0 as usize]) as u64
    var at: u64 = text_an(b, 0, (&k_s[0 as usize]) as u64)
    at = text_an(b, at, schema)
    at = text_an(b, at, (&k_m[0 as usize]) as u64)
    if modus == 0 {
        at = text_an(b, at, (&v_l[0 as usize]) as u64)
    } else if modus == 1 {
        at = text_an(b, at, (&v_d[0 as usize]) as u64)
    } else {
        at = text_an(b, at, (&v_a[0 as usize]) as u64)
    }
    at = text_an(b, at, (&k_a[0 as usize]) as u64)
    at = text_an(b, at, akzent)
    at = text_an(b, at, (&k_l[0 as usize]) as u64)
    at = uhr_an(b, at, wlibc.theme_light_start())
    at = text_an(b, at, (&k_d[0 as usize]) as u64)
    at = uhr_an(b, at, wlibc.theme_dark_start())
    at = text_an(b, at, (&k_nl[0 as usize]) as u64)
    return datei_schreiben((&t_conf[0 as usize]) as u64, b, at)
}

// 450 -> "07:30". Die Datei traegt die Uhrzeit und nicht die Minuten,
// weil ein Mensch sie liest.
fn uhr_an(p: u64, at: u64, min: u64) -> u64 {
    let h: u64 = min / 60
    let m: u64 = min % 60
    __mmio_write8((p + at) as *mut u8, (48 + (h / 10)) as u8)
    __mmio_write8((p + at + 1) as *mut u8, (48 + (h % 10)) as u8)
    __mmio_write8((p + at + 2) as *mut u8, 58 as u8)
    __mmio_write8((p + at + 3) as *mut u8, (48 + (m / 10)) as u8)
    __mmio_write8((p + at + 4) as *mut u8, (48 + (m % 10)) as u8)
    __mmio_write8((p + at + 5) as *mut u8, 0 as u8)
    return at + 5
}

// ------------------------------------------------------ die Anzeigen

fn stand_lesen() {
    var t_akt: [u8; 13] = "Aufloesung: \0"
    var t_mal: [u8; 4] = " x \0"
    var t_dat: [u8; 12] = "Uhr (UTC): \0"
    var t_pkt: [u8; 2] = ".\0"
    var t_dp: [u8; 2] = ":\0"
    var t_ip: [u8; 10] = "Adresse: \0"
    var t_mk: [u8; 8] = "Maske: \0"
    var t_gw: [u8; 10] = "Gateway: \0"
    var t_mac: [u8; 11] = "Hardware: \0"
    var t_kn: [u8; 10] = "kein Netz\0"
    var t_wer: [u8; 16] = "Angemeldet als \0"
    var t_uid: [u8; 7] = ", uid \0"
    var t_dd: [u8; 2] = "-\0"
    var a: u64 = text_an((&l_schirm[0 as usize]) as u64, 0,
        (&t_akt[0 as usize]) as u64)
    a = zahl_an((&l_schirm[0 as usize]) as u64, a, wlibc.screen_w())
    a = text_an((&l_schirm[0 as usize]) as u64, a,
        (&t_mal[0 as usize]) as u64)
    a = zahl_an((&l_schirm[0 as usize]) as u64, a, wlibc.screen_h())
    // Datum und Uhrzeit
    let d: u64 = (&l_datum[0 as usize]) as u64
    a = text_an(d, 0, (&t_dat[0 as usize]) as u64)
    a = zahl_an(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_YEAR, 0, 0))
    a = text_an(d, a, (&t_dd[0 as usize]) as u64)
    a = zwei_an(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_MONTH, 0, 0))
    a = text_an(d, a, (&t_dd[0 as usize]) as u64)
    a = zwei_an(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_DAY, 0, 0))
    a = text_an(d, a, (&t_mal[0 as usize]) as u64)
    a = zwei_an(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_HOUR, 0, 0))
    a = text_an(d, a, (&t_dp[0 as usize]) as u64)
    a = zwei_an(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_MIN, 0, 0))
    // das Netz
    let rd: u64 = ulib.sys(SYS_NETGET, NG_READY, 0, 0)
    let ip: u64 = (&l_ip[0 as usize]) as u64
    let mk: u64 = (&l_maske[0 as usize]) as u64
    let gw: u64 = (&l_gw[0 as usize]) as u64
    let mc: u64 = (&l_mac[0 as usize]) as u64
    if ulib.bad(rd) || rd == 0 {
        a = text_an(ip, 0, (&t_ip[0 as usize]) as u64)
        let _z: u64 = text_an(ip, a, (&t_kn[0 as usize]) as u64)
        a = text_an(mk, 0, (&t_mk[0 as usize]) as u64)
        let _y: u64 = text_an(mk, a, (&t_kn[0 as usize]) as u64)
        a = text_an(gw, 0, (&t_gw[0 as usize]) as u64)
        let _x: u64 = text_an(gw, a, (&t_kn[0 as usize]) as u64)
        a = text_an(mc, 0, (&t_mac[0 as usize]) as u64)
        let _w2: u64 = text_an(mc, a, (&t_kn[0 as usize]) as u64)
    } else {
        let v: u64 = ulib.sys(SYS_NETGET, NG_IP, 0, 0)
        let m: u64 = ulib.sys(SYS_NETGET, NG_MASK, 0, 0)
        let g: u64 = ulib.sys(SYS_NETGET, NG_GW, 0, 0)
        a = text_an(ip, 0, (&t_ip[0 as usize]) as u64)
        let _z: u64 = ip_an(ip, a, v)
        a = text_an(mk, 0, (&t_mk[0 as usize]) as u64)
        let _y: u64 = ip_an(mk, a, m)
        a = text_an(gw, 0, (&t_gw[0 as usize]) as u64)
        let _x: u64 = ip_an(gw, a, g)
        let m0: u64 = ulib.sys(SYS_NETGET, NG_MAC0, 0, 0)
        let m1: u64 = ulib.sys(SYS_NETGET, NG_MAC1, 0, 0)
        a = text_an(mc, 0, (&t_mac[0 as usize]) as u64)
        a = zahl_an(mc, a, (m0 >> 24) & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = zahl_an(mc, a, (m0 >> 16) & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = zahl_an(mc, a, (m0 >> 8) & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = zahl_an(mc, a, m0 & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = zahl_an(mc, a, (m1 >> 8) & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = zahl_an(mc, a, m1 & 255)
        let _e1: u64 = ip_an((&e_ip[0 as usize]) as u64, 0, v)
        let _e2: u64 = ip_an((&e_maske[0 as usize]) as u64, 0, m)
        let _e3: u64 = ip_an((&e_gw[0 as usize]) as u64, 0, g)
    }
    // wer davorsteht
    let uid: u64 = ulib.sys(102, 0, 0, 0)
    if !pw.name_of_uid(uid, (&name[0 as usize]) as u64, 64) {
        name[(0) as usize] = 63 as u8
        name[(1) as usize] = 0 as u8
    }
    a = text_an((&l_wer[0 as usize]) as u64, 0, (&t_wer[0 as usize]) as u64)
    a = text_an((&l_wer[0 as usize]) as u64, a, (&name[0 as usize]) as u64)
    a = text_an((&l_wer[0 as usize]) as u64, a, (&t_uid[0 as usize]) as u64)
    let _u: u64 = zahl_an((&l_wer[0 as usize]) as u64, a, uid)
}

fn melde_stand() {
    var s_m: [u8; 29] = "einstellungen: stand reiter=\0"
    var s_g: [u8; 14] = " geschrieben=\0"
    var s_s: [u8; 10] = " schemas=\0"
    var s_t: [u8; 10] = " status=[\0"
    var s_z: [u8; 2] = "]\0"
    say((&s_m[0 as usize]) as u64)
    ulib.sayn(reiter)
    say((&s_s[0 as usize]) as u64)
    ulib.sayn(nschema)
    say((&s_g[0 as usize]) as u64)
    ulib.sayn(geschrieben)
    say((&s_t[0 as usize]) as u64)
    say((&l_stat[0 as usize]) as u64)
    say((&s_z[0 as usize]) as u64)
    ulib.nl()
}

fn zeige_reiter(r: u64) {
    var k: u64 = 0
    while k < nid {
        wlib.show(ids[(k) as usize],
            rtr[(k) as usize] == R_ANZ || rtr[(k) as usize] == r)
        k = k + 1
    }
    reiter = r
    wlib.neu_setzen()
}

fn u_start(args: u64) -> u64 {
    var s_bad: [u8; 29] = "einstellungen: keine Flaeche\0"
    var s_rd: [u8; 24] = "einstellungen: ready w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var t_theme: [u8; 11] = "/etc/theme\0"
    var t_schemas: [u8; 13] = "/etc/schemas\0"
    var t_hint: [u8; 15] = "/etc/wallpaper\0"
    var t_schirm: [u8; 17] = "/etc/schirm.conf\0"
    var t_zeit: [u8; 15] = "/etc/zeit.conf\0"
    var t_netz: [u8; 15] = "/etc/netz.conf\0"
    var t_dhcp: [u8; 10] = "/bin/dhcp\0"
    var m_ok: [u8; 7] = "bereit\0"
    var m_schema: [u8; 25] = "Farbschema uebernommen: \0"
    var m_schemano: [u8; 37] = "Farbschema liess sich nicht kopieren\0"
    var m_bild: [u8; 35] = "Hintergrundbild kopiert, Oktette: \0"
    var m_bildno: [u8; 31] = "Hintergrundbild nicht gefunden\0"
    var m_schirm: [u8; 55] = "In /etc/schirm.conf geschrieben -- wirkt beim Neustart\0"
    var m_zeit: [u8; 39] = "Zeitzone gespeichert in /etc/zeit.conf\0"
    var m_netz: [u8; 47] = "Adresse gesetzt und /etc/netz.conf geschrieben\0"
    var m_netzno: [u8; 23] = "Keine gueltige Adresse\0"
    var m_netzr: [u8; 39] = "Adresse abgelehnt -- nicht die Wurzel?\0"
    var m_dhcp: [u8; 28] = "DHCP-Klient gestartet, pid \0"
    var m_kwok: [u8; 23] = "Kennwort gesetzt fuer \0"
    var m_kwne: [u8; 34] = "Die beiden Eingaben sind ungleich\0"
    var m_kwku: [u8; 24] = "Mindestens vier Zeichen\0"
    var m_kwno: [u8; 39] = "/etc/shadow liess sich nicht schreiben\0"
    var k_modus: [u8; 7] = "modus=\0"
    var k_800: [u8; 9] = "800x600\n\0"
    var k_1024: [u8; 10] = "1024x768\n\0"
    var k_off: [u8; 8] = "offset=\0"
    var k_nl: [u8; 2] = "\n\0"
    var k_dh: [u8; 12] = "modus=dhcp\n\0"
    var k_fe: [u8; 15] = "modus=fest\nip=\0"
    var k_mk: [u8; 8] = "\nmaske=\0"
    var k_gw: [u8; 10] = "\ngateway=\0"
    var s_pfad: [u8; 41] = "                                        \0"

    if !wlib.begin(false, false) {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    let _t: u64 = wlibc.theme_reload()
    let _n: u64 = schemas_lesen((&t_schemas[0 as usize]) as u64)
    kontrast_zeigen()
    let _h: u64 = text_an((&e_bild[0 as usize]) as u64, 0,
        (&t_hint[0 as usize]) as u64)
    let _s: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
        (&m_ok[0 as usize]) as u64)
    stand_lesen()

    let bw: u64 = 560
    let bh: u64 = 470
    w = wlib.window(140, 60, bw, bh, (&t_titel[0 as usize]) as u64)
    if w >= wlib.MAXWN {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    say((&s_rd[0 as usize]) as u64)
    ulib.sayn(bw)
    say((&s_hh[0 as usize]) as u64)
    ulib.sayn(bh)
    ulib.nl()

    wlib.box_v(w, 0, 0, bw, bh, 10, 6)
    let tb: u64 = merke(wlib.tabs((&t_tabs[0 as usize]) as u64), R_ANZ)
    // ---- Darstellung
    let _d1: u64 = merke(wlib.label((&l_far[0 as usize]) as u64), R_DARST)
    wlib.size(0, 92)
    let ls: u64 = merke(wlib.list((&schemas[0 as usize]) as u64, 4), R_DARST)
    // RUNDE THEME: Modus und Akzentfarbe. Beide gehen in dieselbe
    // Datei wie das Schema, weil beide dasselbe sind -- eine
    // EINSTELLUNG, und kein Inhalt.
    let _d3: u64 = merke(wlib.label((&l_mod[0 as usize]) as u64), R_DARST)
    let cm: u64 = merke(wlib.choice((&c_mod[0 as usize]) as u64, 2), R_DARST)
    let _d4: u64 = merke(wlib.label((&l_akz[0 as usize]) as u64), R_DARST)
    let ea: u64 = merke(wlib.entry((&e_akzent[0 as usize]) as u64, 12),
        R_DARST)
    let lk: u64 = merke(wlib.label((&l_kon[0 as usize]) as u64), R_DARST)
    let lw: u64 = merke(wlib.label((&l_warn[0 as usize]) as u64), R_DARST)
    let _d2: u64 = merke(wlib.label((&l_bil[0 as usize]) as u64), R_DARST)
    let eb: u64 = merke(wlib.entry((&e_bild[0 as usize]) as u64, 90),
        R_DARST)
    wlib.size(140, 26)
    let b1: u64 = merke(wlib.button((&b_uber[0 as usize]) as u64), R_DARST)
    // ---- Bildschirm
    let _s1: u64 = merke(wlib.label((&l_schirm[0 as usize]) as u64),
        R_SCHIRM)
    let _s2: u64 = merke(wlib.label((&l_aufl[0 as usize]) as u64), R_SCHIRM)
    let cs: u64 = merke(wlib.choice((&c_aufl[0 as usize]) as u64, 0),
        R_SCHIRM)
    let _s3: u64 = merke(wlib.label((&l_ehr1[0 as usize]) as u64), R_SCHIRM)
    let _s4: u64 = merke(wlib.label((&l_ehr2[0 as usize]) as u64), R_SCHIRM)
    wlib.size(140, 26)
    let b2: u64 = merke(wlib.button((&b_uber[0 as usize]) as u64), R_SCHIRM)
    // ---- Zeit
    let lz: u64 = merke(wlib.label((&l_datum[0 as usize]) as u64), R_ZEIT)
    let _z2: u64 = merke(wlib.label((&l_zone[0 as usize]) as u64), R_ZEIT)
    let cz: u64 = merke(wlib.choice((&c_zone[0 as usize]) as u64, 2), R_ZEIT)
    let _z3: u64 = merke(wlib.label((&l_ehr3[0 as usize]) as u64), R_ZEIT)
    let _z4: u64 = merke(wlib.label((&l_ehr4[0 as usize]) as u64), R_ZEIT)
    wlib.size(140, 26)
    let b3: u64 = merke(wlib.button((&b_uber[0 as usize]) as u64), R_ZEIT)
    // ---- Netz
    let _n1: u64 = merke(wlib.label((&l_ip[0 as usize]) as u64), R_NETZ)
    let _n2: u64 = merke(wlib.label((&l_maske[0 as usize]) as u64), R_NETZ)
    let _n3: u64 = merke(wlib.label((&l_gw[0 as usize]) as u64), R_NETZ)
    let _n4: u64 = merke(wlib.label((&l_mac[0 as usize]) as u64), R_NETZ)
    let _n5: u64 = merke(wlib.label((&l_bez[0 as usize]) as u64), R_NETZ)
    let cn: u64 = merke(wlib.choice((&c_bez[0 as usize]) as u64, 1), R_NETZ)
    let _n6: u64 = merke(wlib.label((&l_ip2[0 as usize]) as u64), R_NETZ)
    let en1: u64 = merke(wlib.entry((&e_ip[0 as usize]) as u64, 20), R_NETZ)
    let en2: u64 = merke(wlib.entry((&e_maske[0 as usize]) as u64, 20),
        R_NETZ)
    let en3: u64 = merke(wlib.entry((&e_gw[0 as usize]) as u64, 20), R_NETZ)
    wlib.size(140, 26)
    let b4: u64 = merke(wlib.button((&b_uber[0 as usize]) as u64), R_NETZ)
    // ---- Benutzer
    let _u1: u64 = merke(wlib.label((&l_wer[0 as usize]) as u64), R_BENUT)
    let _u2: u64 = merke(wlib.label((&l_kw1[0 as usize]) as u64), R_BENUT)
    let ep1: u64 = merke(wlib.entry((&e_pw1[0 as usize]) as u64, 60),
        R_BENUT)
    let _u3: u64 = merke(wlib.label((&l_kw2[0 as usize]) as u64), R_BENUT)
    let ep2: u64 = merke(wlib.entry((&e_pw2[0 as usize]) as u64, 60),
        R_BENUT)
    wlib.size(160, 26)
    let b5: u64 = merke(wlib.button((&b_kw[0 as usize]) as u64), R_BENUT)
    // ---- immer sichtbar
    let st: u64 = merke(wlib.label((&l_stat[0 as usize]) as u64), R_ANZ)
    wlib.box_end()
    let _tb2: u64 = tb
    let _e0: u64 = eb
    zeige_reiter(R_DARST)
    wlib.draw_all()
    melde_stand()

    var runden: u64 = 0
    while wlib.alive() && runden < 4000000 {
        runden = runden + 1
        let id: u64 = wlib.step()
        if id < wlib.MAXWD {
            let kind: u64 = wlib.fired_kind()
            if kind == wlib.K_TABS {
                zeige_reiter(wlib.fired_index())
                melde_stand()
            } else if kind == wlib.K_BUTTON {
                if id == b1 {
                    // RUNDE THEME: nicht mehr eine Datei kopieren,
                    // sondern /etc/theme.conf schreiben und den Satz
                    // neu aufloesen. Danach stehen die gemessenen
                    // Kontraste im Fenster -- vor dem naechsten Klick
                    // und nicht in einem Protokoll.
                    if wlib.value(ls) < nschema {
                        if theme_conf_schreiben(
                            (&snamen[0 as usize]) as u64
                                + wlib.value(ls) * 32,
                            wlib.value(cm),
                            (&e_akzent[0 as usize]) as u64) {
                            let _r: u64 = wlibc.theme_reload()
                            kontrast_zeigen()
                            wlib.set_text(lk, (&l_kon[0 as usize]) as u64)
                            wlib.set_text(lw, (&l_warn[0 as usize]) as u64)
                            let a: u64 = text_an((&l_stat[0 as usize]) as u64,
                                0, (&m_schema[0 as usize]) as u64)
                            let _b: u64 = text_an((&l_stat[0 as usize])
                                as u64, a, (&snamen[0 as usize]) as u64
                                + wlib.value(ls) * 32)
                        } else {
                            let _c: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, (&m_schemano[0 as usize]) as u64)
                        }
                    }
                    // das Bild -- nur, wenn die Quelle nicht schon das
                    // Ziel ist. Eine Datei auf sich selbst zu kopieren
                    // heisst hier: sie erst leeren und dann lesen.
                    if !ulib.streq((&e_bild[0 as usize]) as u64,
                        (&t_hint[0 as usize]) as u64) {
                        let n2: u64 = datei_kopieren(
                            (&e_bild[0 as usize]) as u64,
                            (&t_hint[0 as usize]) as u64)
                        if n2 > 0 {
                            let a2: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, (&m_bild[0 as usize]) as u64)
                            let _d2b: u64 = zahl_an((&l_stat[0 as usize])
                                as u64, a2, n2)
                        } else {
                            let _e2b: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, (&m_bildno[0 as usize]) as u64)
                        }
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b2 {
                    var buf: [u8; 32] = [0 as u8; 32]
                    var a3: u64 = text_an((&buf[0 as usize]) as u64, 0,
                        (&k_modus[0 as usize]) as u64)
                    if wlib.value(cs) == 0 {
                        a3 = text_an((&buf[0 as usize]) as u64, a3,
                            (&k_800[0 as usize]) as u64)
                    } else {
                        a3 = text_an((&buf[0 as usize]) as u64, a3,
                            (&k_1024[0 as usize]) as u64)
                    }
                    let _w3: bool = datei_schreiben(
                        (&t_schirm[0 as usize]) as u64,
                        (&buf[0 as usize]) as u64, a3)
                    let _s5: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                        (&m_schirm[0 as usize]) as u64)
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b3 {
                    var buf2: [u8; 32] = [0 as u8; 32]
                    var a4: u64 = text_an((&buf2[0 as usize]) as u64, 0,
                        (&k_off[0 as usize]) as u64)
                    a4 = zahl_an((&buf2[0 as usize]) as u64, a4,
                        wlib.value(cz) * 60)
                    a4 = text_an((&buf2[0 as usize]) as u64, a4,
                        (&k_nl[0 as usize]) as u64)
                    let _w4: bool = datei_schreiben(
                        (&t_zeit[0 as usize]) as u64,
                        (&buf2[0 as usize]) as u64, a4)
                    let _s6: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                        (&m_zeit[0 as usize]) as u64)
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b4 {
                    if wlib.value(cn) == 0 {
                        var buf3: [u8; 24] = [0 as u8; 24]
                        let a5: u64 = text_an((&buf3[0 as usize]) as u64, 0,
                            (&k_dh[0 as usize]) as u64)
                        let _w5: bool = datei_schreiben(
                            (&t_netz[0 as usize]) as u64,
                            (&buf3[0 as usize]) as u64, a5)
                        let pid: u64 = ulib.sys(ulib.SYS_SPAWN,
                            (&t_dhcp[0 as usize]) as u64, 0, 0)
                        let a6: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, (&m_dhcp[0 as usize]) as u64)
                        let _z7: u64 = zahl_an((&l_stat[0 as usize]) as u64,
                            a6, pid)
                    } else {
                        let vip: u64 = ip_lesen((&e_ip[0 as usize]) as u64)
                        let vmk: u64 = ip_lesen((&e_maske[0 as usize])
                            as u64)
                        let vgw: u64 = ip_lesen((&e_gw[0 as usize]) as u64)
                        if vip == 0 || vmk == 0 {
                            let _s8: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, (&m_netzno[0 as usize]) as u64)
                        } else {
                            let rc: u64 = ulib.sys(SYS_NETSET, vip, vmk, vgw)
                            if ulib.bad(rc) {
                                let _s9: u64 = text_an((&l_stat[0 as usize])
                                    as u64, 0, (&m_netzr[0 as usize]) as u64)
                            } else {
                                var buf4: [u8; 96] = [0 as u8; 96]
                                var a7: u64 = text_an((&buf4[0 as usize])
                                    as u64, 0, (&k_fe[0 as usize]) as u64)
                                a7 = ip_an((&buf4[0 as usize]) as u64, a7,
                                    vip)
                                a7 = text_an((&buf4[0 as usize]) as u64, a7,
                                    (&k_mk[0 as usize]) as u64)
                                a7 = ip_an((&buf4[0 as usize]) as u64, a7,
                                    vmk)
                                a7 = text_an((&buf4[0 as usize]) as u64, a7,
                                    (&k_gw[0 as usize]) as u64)
                                a7 = ip_an((&buf4[0 as usize]) as u64, a7,
                                    vgw)
                                a7 = text_an((&buf4[0 as usize]) as u64, a7,
                                    (&k_nl[0 as usize]) as u64)
                                let _wa: bool = datei_schreiben(
                                    (&t_netz[0 as usize]) as u64,
                                    (&buf4[0 as usize]) as u64, a7)
                                let _sa: u64 = text_an((&l_stat[0 as usize])
                                    as u64, 0, (&m_netz[0 as usize]) as u64)
                            }
                        }
                    }
                    stand_lesen()
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b5 {
                    if !ulib.streq((&e_pw1[0 as usize]) as u64,
                        (&e_pw2[0 as usize]) as u64) {
                        let _sb: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, (&m_kwne[0 as usize]) as u64)
                    } else if ulib.length((&e_pw1[0 as usize]) as u64) < 4 {
                        let _sc: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, (&m_kwku[0 as usize]) as u64)
                    } else {
                        var rec: [u8; 160] = [0 as u8; 160]
                        var gut: bool = pw.make_hash(
                            (&e_pw1[0 as usize]) as u64,
                            (&rec[0 as usize]) as u64)
                        if gut {
                            gut = pw.set_shadow((&name[0 as usize]) as u64,
                                (&rec[0 as usize]) as u64)
                        }
                        if gut {
                            geschrieben = geschrieben + 1
                            let ad: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, (&m_kwok[0 as usize]) as u64)
                            let _sd: u64 = text_an((&l_stat[0 as usize])
                                as u64, ad, (&name[0 as usize]) as u64)
                        } else {
                            let _se: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, (&m_kwno[0 as usize]) as u64)
                        }
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                }
            }
        }
    }
    let _q1: u64 = lz
    let _q2: u64 = en1
    let _q3: u64 = en2
    let _q4: u64 = en3
    let _q5: u64 = ep1
    let _q6: u64 = ep2
    let _q7: u64 = (&s_pfad[0 as usize]) as u64
    return 0
}
