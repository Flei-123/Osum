// RUNDE DISPLAY. Die Liste der Modi ist KEINE Zeichenkette im Quelltext
// -- sie wird bei jedem Oeffnen aus dem Kernel gebaut. Genau das ist der
// Unterschied zu der Auswahl, die hier vorher stand.
static mut d_modi: [u8; 512] = [0 as u8; 512]
static mut d_karte: [u8; 128] = [0 as u8; 128]
static mut d_tiefe: [u8; 128] = [0 as u8; 128]
static mut d_frist: [u8; 96] = [0 as u8; 96]
