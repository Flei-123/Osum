                        let _z7: u64 = zahl_an((&l_stat[0 as usize]) as u64,
                            a6, pid)
                    } else {
                        let vip: u64 = ip_lesen((&e_ip[0 as usize]) as u64)
                        let vmk: u64 = ip_lesen((&e_maske[0 as usize])
                            as u64)
                        let vgw: u64 = ip_lesen((&e_gw[0 as usize]) as u64)
                        if vip == 0 || vmk == 0 {
