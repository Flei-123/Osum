                        let _sb: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_kwne[0 as usize]) as u64))
                    } else if ulib.length((&e_pw1[0 as usize]) as u64) < 4 {
                        let _sc: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_kwku[0 as usize]) as u64))
                    } else {
                        var rec: [u8; 160] = [0 as u8; 160]
                        var gut: bool = pw.make_hash(
                            (&e_pw1[0 as usize]) as u64,
                            (&rec[0 as usize]) as u64)
                        if gut {
                            gut = pw.set_shadow((&name[0 as usize]) as u64,
                                (&rec[0 as usize]) as u64)
                        }
                        if gut {
                            geschrieben = geschrieben + 1
                            let ad: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, msg.get((&k_m_kwok[0 as usize]) as u64))
                            let _sd: u64 = text_an((&l_stat[0 as usize])
                                as u64, ad, (&name[0 as usize]) as u64)
                        } else {
                            let _se: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, msg.get((&k_m_kwno[0 as usize]) as u64))
                        }
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b6 {
                    // ==================================== ROUND NETVIEW
                    //
                    // Die Sicht eines LAUFENDEN Prozesses aendern. Der
                    // Kern entscheidet, ob das erlaubt ist
                    // (`netview.may_set`): enger machen darf jeder sich
                    // selbst, alles andere darf nur die Wurzel. Diese
                    // Seite fragt und schoent die Antwort nicht -- ein
                    // -EPERM steht als Satz in der Statuszeile und nicht
                    // als stilles Nichts.
                    let z: u64 = wlib.value(lv)
                    if z < nv_n {
                        let want: u64 = wlib.value(cv)
                        let r: u64 = nv.view_set(nv_pids[(z) as usize],
                            want)
                        if ulib.bad(r) {
                            let _f1: u64 = text_an(
                                (&l_stat[0 as usize]) as u64, 0,
                                msg.get((&k_m_nvno[0 as usize]) as u64))
                        } else {
                            let a6: u64 = text_an(
                                (&l_stat[0 as usize]) as u64, 0,
                                msg.get((&k_m_nvok[0 as usize]) as u64))
                            let _f2: u64 = zahl_an(
                                (&l_stat[0 as usize]) as u64, a6,
                                nv_pids[(z) as usize])
                        }
                        nv_lesen()
                        wlib.set_text(lv, (&nv_liste[0 as usize]) as u64)
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.dirty_all(w)
                    melde_stand()
                } else if id == b7 {
                    // ============ ZWEITER NACHTRAG: die Voreinstellung
                    //
                    // Sie setzt KEINEN laufenden Prozess um, und die
                    // Seite behauptet das auch nicht: die Liste
                    // darueber wird danach neu gelesen und zeigt
                    // dieselben Sichten wie vorher. Wer sehen will, dass
                    // es wirkt, startet ein Programm.
                    let f: u64 = wlib.value(cf)
                    if ulib.bad(nv.fallback_set(f)) {
                        let _g1: u64 = text_an(
                            (&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_fbno[0 as usize]) as u64))
                    } else {
                        var fw: [u8; 14] = [0 as u8; 14]
                        let a7: u64 = text_an(
                            (&l_stat[0 as usize]) as u64, 0,
                            msg.get((&k_m_fbok[0 as usize]) as u64))
                        let _n7: u64 = nv.fb_name(f, (&fw[0 as usize]) as u64)
                        let _g2: u64 = text_an(
                            (&l_stat[0 as usize]) as u64, a7,
                            (&fw[0 as usize]) as u64)
                        // UND IN DIE DATEI. Ohne das waere die
                        // Einstellung beim naechsten Start weg, und
                        // eine Einstellung, die sich selbst vergisst,
                        // ist schlimmer als keine.
                        let _fw: bool = nv.fallback_save(f)
                    }
                    nv_lesen()
                    wlib.set_text(lv, (&nv_liste[0 as usize]) as u64)
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.dirty_all(w)
                    melde_stand()
                } else if id == b8 {
                    // ================ RUNDE I18N, von Runde LOOK zurueck
                    //
                    // DIE SPRACHE UMSTELLEN, ZUR LAUFZEIT UND OHNE
                    // NEUSTART. Drei Schritte, und der dritte ist der,
                    // den man leicht vergisst:
                    //
                    //   1. Die Wahl SCHREIBEN, nach
                    //      /users/<name>/config/locale. Sie gehoert dem
                    //      BENUTZER -- deshalb nicht nach /etc/. Die
                    //      Vorgabe unter /etc/locale.conf, die Runde
                    //      LOOK eingefuehrt hat, wird hier NICHT
                    //      angefasst: eine Wahl schlaegt eine Vorgabe,
                    //      und ein Programm, das die Vorgabe der
                    //      Maschine ueberschreibt, weil ein Benutzer
                    //      etwas gewaehlt hat, hat die beiden
                    //      verwechselt.
                    //   2. Den Katalog UMSTELLEN. `msg.set_lang` fuellt
                    //      die festen Plaetze neu; die Zeiger, die jedes
                    //      Bedienelement dieses Fensters haelt, bleiben
                    //      dieselben Adressen. Genau dafuer sind die
                    //      Plaetze fest.
                    //   3. Die zusammengesetzten Beschriftungen NEU
                    //      BAUEN. "Adresse: 10.0.2.15" ist kein
                    //      Katalogtext, sondern ein Katalogtext PLUS
                    //      eine Zahl; das tut `stand_lesen`.
                    var code: u64 = (&c_en[0 as usize]) as u64
                    if wlib.value(cl) == 1 {
                        code = (&c_de[0 as usize]) as u64
                    }
                    let _kb: u64 = ulib.sys(SYS_KBD, KB_SET,
                        wlib.value(ck2), 0)
                    if msg.save_lang(code) {
                        let _sl: bool = msg.set_lang(code)
                        stand_lesen()
                        let al: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_langok[0 as usize]) as u64))
                        let _sm: u64 = text_an((&l_stat[0 as usize]) as u64,
                            al, code)
                    } else {
                        let _sn: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, msg.get((&k_m_langno[0 as usize]) as u64))
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    // Jedes Bedienelement zeigt auf denselben Platz wie
                    // vorher -- nur steht dort jetzt ein anderer Text.
                    // Also reicht Neuzeichnen.
                    wlib.draw_all()
                    melde_stand()
                }
            }
        }
    }
    let _q1: u64 = lz
    let _q2: u64 = en1
    let _q3: u64 = en2
    let _q4: u64 = en3
    let _q5: u64 = ep1
    let _q6: u64 = ep2
    let _q7: u64 = (&s_pfad[0 as usize]) as u64
    return 0
}

// ====================================================== ROUND NETVIEW
//
// EINE ZEILE JE LAUFENDEM PROZESS: "<pid> <sicht>". Die Zahlen kommen
// aus der AUFGABENTAFEL (SYS_PSTAT) und die Sicht aus dem Kern
// (SYS_NETVGET) -- diese Seite fuehrt keine eigene Liste, weil eine
// zweite Liste eine zweite Gelegenheit waere, etwas anderes anzuzeigen
// als der Fall ist. Und genau das ist der Grundsatz der Runde: getaeuscht
// wird das Programm, nie der Mensch davor.
// DRITTER NACHTRAG: die Zeile wird nicht mehr hier geschrieben.
// `nv.fallback_save` tut es, fuer diese Seite, fuer `/bin/netview` und
// fuer die Schnelleinstellungen -- die FORM der Zeile stand vorher in
// zwei Dateien, und das war in `docs/NETVIEW.md` als Naht benannt.
// Diese Runde macht daraus eine Stelle statt drei.

fn nv_lesen() {
    var sp: [u8; 2] = " \0"
    var nl: [u8; 2] = "\n\0"
    var nm: [u8; 16] = [0 as u8; 16]
    var at: u64 = 0
    nv_n = 0
    var i: u64 = 0
    while i < 32 && at < 900 {
        let zu: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_STATE, 0)
        if !ulib.bad(zu) && zu != 0 {
            if ulib.sys(ulib.SYS_PSTAT, i, ulib.P_KIND, 0) == 3 {
                let pid: u64 = ulib.sys(ulib.SYS_PSTAT, i, ulib.P_PID, 0)
                nv_pids[(nv_n) as usize] = pid
                at = zahl_an((&nv_liste[0 as usize]) as u64, at, pid)
                at = text_an((&nv_liste[0 as usize]) as u64, at,
                    (&sp[0 as usize]) as u64)
                let _n: u64 = nv.view_name(nv.view_of(pid),
                    (&nm[0 as usize]) as u64)
                at = text_an((&nv_liste[0 as usize]) as u64, at,
                    (&nm[0 as usize]) as u64)
                at = text_an((&nv_liste[0 as usize]) as u64, at,
                    (&nl[0 as usize]) as u64)
                nv_n = nv_n + 1
            }
        }
        i = i + 1
    }
}
