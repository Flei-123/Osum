fn say(p: u64) {
    ulib.say(p)
}

fn merke(i: u64, r: u64) -> u64 {
    if nid < 64 {
        ids[(nid) as usize] = i
        rtr[(nid) as usize] = r
        nid = nid + 1
    }
    return i
}

fn text_an(p: u64, at: u64, q: u64) -> u64 {
    var k: u64 = 0
    while __mmio_read8((q + k) as *mut u8) != 0 as u8 {
        __mmio_write8((p + at + k) as *mut u8,
            __mmio_read8((q + k) as *mut u8))
        k = k + 1
    }
    __mmio_write8((p + at + k) as *mut u8, 0 as u8)
    return at + k
}

fn zahl_an(p: u64, at: u64, v: u64) -> u64 {
    if v == 0 {
        __mmio_write8((p + at) as *mut u8, 48 as u8)
        __mmio_write8((p + at + 1) as *mut u8, 0 as u8)
        return at + 1
    }
    var stellen: u64 = 0
    var t: u64 = v
    while t > 0 {
        stellen = stellen + 1
        t = t / 10
    }
    var k: u64 = stellen
    t = v
    while k > 0 {
        k = k - 1
        __mmio_write8((p + at + k) as *mut u8, (48 + (t % 10)) as u8)
        t = t / 10
    }
    __mmio_write8((p + at + stellen) as *mut u8, 0 as u8)
    return at + stellen
}

fn zwei_an(p: u64, at: u64, v: u64) -> u64 {
    __mmio_write8((p + at) as *mut u8, (48 + ((v / 10) % 10)) as u8)
    __mmio_write8((p + at + 1) as *mut u8, (48 + (v % 10)) as u8)
    __mmio_write8((p + at + 2) as *mut u8, 0 as u8)
    return at + 2
}

// Eine Adresse als vier Zahlen. `punkt` ist der Trenner, damit die
// Zeichenkette nur an einer Stelle gebaut wird.
fn ip_an(p: u64, at: u64, v: u64) -> u64 {
    var pt: [u8; 2] = ".\0"
    var a: u64 = zahl_an(p, at, (v >> 24) & 255)
    a = text_an(p, a, (&pt[0 as usize]) as u64)
    a = zahl_an(p, a, (v >> 16) & 255)
    a = text_an(p, a, (&pt[0 as usize]) as u64)
    a = zahl_an(p, a, (v >> 8) & 255)
    a = text_an(p, a, (&pt[0 as usize]) as u64)
    return zahl_an(p, a, v & 255)
}

// "10.0.2.15" -> 0x0A00020F. Gibt 0, wenn es keine Adresse ist -- und
// zwar auch bei "10.0.2" und bei "10.0.2.300".
fn ip_lesen(p: u64) -> u64 {
    var v: u64 = 0
    var teil: u64 = 0
    var ziffern: u64 = 0
    var n: u64 = 0
    var k: u64 = 0
    var gut: bool = true
    while gut {
        let c: u64 = __mmio_read8((p + k) as *mut u8) as u64
        if c >= 48 && c <= 57 {
            teil = teil * 10 + (c - 48)
            ziffern = ziffern + 1
            if teil > 255 || ziffern > 3 {
                return 0
            }
        } else if c == 46 || c == 0 {
            if ziffern == 0 {
                return 0
            }
            v = (v << 8) | teil
            n = n + 1
            teil = 0
            ziffern = 0
            if c == 0 {
                gut = false
            }
        } else {
            return 0
        }
        k = k + 1
        if k > 20 {
            return 0
        }
    }
    if n != 4 {
        return 0
    }
    return v
}

// ---------------------------------------------------------- Dateien

fn datei_lesen(pfad: u64, ziel: u64, max: u64) -> u64 {
    let fd: u64 = io.open(pfad, 0)
    if ulib.bad(fd) {
        return 0
    }
    let n: u64 = io.read_full(fd, ziel, max - 1)
    io.close(fd)
    if ulib.bad(n) {
        return 0
    }
    __mmio_write8((ziel + n) as *mut u8, 0 as u8)
    return n
}

fn datei_schreiben(pfad: u64, quelle: u64, n: u64) -> bool {
    let fd: u64 = io.create(pfad)
    if ulib.bad(fd) {
        return false
    }
    let g: u64 = io.write_all(fd, quelle, n)
    io.close(fd)
    if ulib.bad(g) || g < n {
        return false
    }
    geschrieben = geschrieben + 1
    return true
}

// EINE DATEI KOPIEREN, in Stuecken von 2048 Oktetten. Ein
// Hintergrundbild ist 170 Kilooktett und passt in keinen Puffer, den
// dieses Programm halten koennte.
fn datei_kopieren(von: u64, nach: u64) -> u64 {
    let a: u64 = io.open(von, 0)
    if ulib.bad(a) {
        return 0
    }
    let b: u64 = io.create(nach)
    if ulib.bad(b) {
        io.close(a)
        return 0
    }
    var ganz: u64 = 0
    var weiter: bool = true
    while weiter {
        let n: u64 = io.read(a, (&puffer[0 as usize]) as u64, 2048)
        if ulib.bad(n) || n == 0 {
            weiter = false
        } else {
            let g: u64 = io.write_all(b, (&puffer[0 as usize]) as u64, n)
            if ulib.bad(g) || g < n {
                weiter = false
            } else {
                ganz = ganz + n
            }
        }
    }
    io.close(a)
    io.close(b)
    if ganz > 0 {
        geschrieben = geschrieben + 1
    }
    return ganz
}

// Die Schemata aus `/etc/schemas` einlesen: die Namen als ein Textblock
// fuer die Liste, und daneben dieselben Namen einzeln, damit der Pfad
// gebaut werden kann.
fn schemas_lesen(dir: u64) -> u64 {
    var recs: [u8; 1024] = [0 as u8; 1024]
    let fd: u64 = io.dir_open(dir)
    if ulib.bad(fd) {
        return 0
    }
    var bp: u64 = 0
    var np: u64 = 0
    var n: u64 = 0
    var weiter: bool = true
    while weiter {
        let got: u64 = io.dir_read(fd, (&recs[0 as usize]) as u64, 1024)
        if ulib.bad(got) || got == 0 {
            weiter = false
        } else {
            var at: u64 = 0
            while at < got {
                let rec: u64 = (&recs[0 as usize]) as u64 + at
                let nm: u64 = io.dir_name(rec)
                let erste: u64 = __mmio_read8((nm) as *mut u8) as u64
                if erste != 46 && n < 12 {
                    var k: u64 = 0
                    while __mmio_read8((nm + k) as *mut u8) != 0 as u8
                        && k < 30 {
                        schemas[((bp + k)) as usize] =
                            __mmio_read8((nm + k) as *mut u8)
                        snamen[((np + k)) as usize] =
                            __mmio_read8((nm + k) as *mut u8)
                        k = k + 1
                    }
                    bp = bp + k
                    schemas[(bp) as usize] = 10 as u8
                    bp = bp + 1
                    snamen[((np + k)) as usize] = 0 as u8
                    np = np + 32
                    n = n + 1
                }
                let rl: u64 = io.dir_reclen(rec)
                if rl == 0 {
                    at = got
                } else {
                    at = at + rl
                }
            }
        }
    }
    io.close(fd)
    if bp > 0 {
        schemas[((bp - 1)) as usize] = 0 as u8
    }
    schemas[(bp) as usize] = 0 as u8
    nschema = n
    return n
}

fn schema_pfad(i: u64, ziel: u64) -> bool {
    var s_dir: [u8; 14] = "/etc/schemas/\0"
    if i >= nschema {
        return false
    }
    let a: u64 = text_an(ziel, 0, (&s_dir[0 as usize]) as u64)
    let _b: u64 = text_an(ziel, a,
        (&snamen[0 as usize]) as u64 + i * 32)
    return true
}

// ------------------------------------------------------ die Anzeigen

// ==================================================== RUNDE DISPLAY

fn dget(feld: u64) -> u64 {
    return ulib.sys(SYS_DISPGET, feld, 0, 0)
}

fn dset(feld: u64, wert: u64) -> u64 {
    return ulib.sys(SYS_DISPSET, feld, wert, 0)
}

// Die Stufen der vier Regler. Die Widget-Bibliothek hat keinen
// Schieberegler; sie hat eine Auswahl, die weiterschaltet. Sechs
// Stufen sind, was ein Bedienfeld ohne Schieber hergibt, und sie decken
// den Bereich ab, den die Tabelle ueberhaupt darstellen kann.
fn stufe_hell(i: u64) -> u64 {
    if i == 0 {
        return 40
    }
    if i == 1 {
        return 70
    }
    if i == 2 {
        return 100
    }
    if i == 3 {
        return 130
    }
    if i == 4 {
        return 160
    }
    return 200
}

fn stufe_gam(i: u64) -> u64 {
    if i == 0 {
        return 45
    }
    if i == 1 {
        return 70
    }
    if i == 2 {
        return 100
    }
    if i == 3 {
        return 140
    }
    if i == 4 {
        return 180
    }
    return 220
}

fn stufe_sat(i: u64) -> u64 {
    if i == 0 {
        return 0
    }
    if i == 1 {
        return 50
    }
    if i == 2 {
        return 100
    }
    if i == 3 {
        return 150
    }
    return 200
}

// Die naechstliegende Stufe zu einem Wert, damit die Auswahl beim
// Oeffnen das ANZEIGT, was wirklich eingestellt ist, und nicht die
// Mitte behauptet.
fn stufe_von(v: u64, art: u64) -> u64 {
    var best: u64 = 0
    var bd: u64 = 100000
    var i: u64 = 0
    let n: u64 = 6
    while i < n {
        var w: u64 = 0
        if art == 0 {
            w = stufe_hell(i)
        } else if art == 1 {
            w = stufe_gam(i)
        } else {
            if i > 4 {
                w = 200
            } else {
                w = stufe_sat(i)
            }
        }
        var d: u64 = 0
        if w >= v {
            d = w - v
        } else {
            d = v - w
        }
        if d < bd {
            bd = d
            best = i
        }
        i = i + 1
    }
    return best
}

// DIE MODUSLISTE KOMMT AUS DEM KERNEL, EINE ZEILE JE MODUS. Sie steht
// nicht im Quelltext dieses Programms, und das ist der ganze Punkt: auf
// einer Maschine mit weniger Bildspeicher oder mit einer Karte, die
// weniger annimmt, ist sie kuerzer, und niemand muss dafuer etwas
// uebersetzen.
fn modi_lesen() {
    var t_x: [u8; 4] = " x \0"
    var t_n: [u8; 2] = "\n\0"
    var t_leer: [u8; 25] = "(keine Karte gefunden)\0\0\0"
    d_n = 0
    if ulib.bad(dget(DG_READY)) || dget(DG_READY) == 0 {
        let _e: u64 = text_an((&d_modi[0 as usize]) as u64, 0,
            (&t_leer[0 as usize]) as u64)
        return
    }
    let n: u64 = dget(DG_COUNT)
    var a: u64 = 0
    var i: u64 = 0
    while i < n && i < 40 {
        let m: u64 = dget(DG_MODE + i)
        if !ulib.bad(m) {
            a = zahl_an((&d_modi[0 as usize]) as u64, a, (m >> 32) & 0xFFFF)
            a = text_an((&d_modi[0 as usize]) as u64, a,
                (&t_x[0 as usize]) as u64)
            a = zahl_an((&d_modi[0 as usize]) as u64, a, (m >> 16) & 0xFFFF)
            a = text_an((&d_modi[0 as usize]) as u64, a,
                (&t_n[0 as usize]) as u64)
            d_n = d_n + 1
        }
        i = i + 1
    }
    if a > 0 {
        d_modi[(a - 1) as usize] = 0 as u8
    }
}

// Was die Karte ueber sich sagt, und was der Monitor ueber sich sagt.
fn karte_lesen() {
    var t_v: [u8; 8] = "Karte: \0"
    var t_k: [u8; 5] = " KiB\0"
    var t_e: [u8; 9] = ", nativ \0"
    var t_x: [u8; 4] = " x \0"
    var t_ne: [u8; 14] = ", kein EDID\0\0\0"
    var t_t: [u8; 14] = "Farbtiefe: 32\0"
    var t_t2: [u8; 26] = " Bit. Die Karte kann auch\0"
    var t_t3: [u8; 43] = "8/15/16/24; dieser Kernel zeichnet nur 32.\0"
    var t_t4: [u8; 34] = "Farbtiefe: die Karte sagt nichts.\0"
    let a0: u64 = text_an((&d_karte[0 as usize]) as u64, 0,
        (&t_v[0 as usize]) as u64)
    if ulib.bad(dget(DG_READY)) || dget(DG_READY) == 0 {
        var t_no: [u8; 24] = "nicht erkundet (`disp`)\0"
        let _q: u64 = text_an((&d_karte[0 as usize]) as u64, a0,
            (&t_no[0 as usize]) as u64)
        let _r: u64 = text_an((&d_tiefe[0 as usize]) as u64, 0,
            (&t_t4[0 as usize]) as u64)
        return
    }
    var a: u64 = zahl_an((&d_karte[0 as usize]) as u64, a0,
        dget(DG_VRAM) / 1024)
    a = text_an((&d_karte[0 as usize]) as u64, a, (&t_k[0 as usize]) as u64)
    if dget(DG_EDIDOK) == 1 {
        a = text_an((&d_karte[0 as usize]) as u64, a,
            (&t_e[0 as usize]) as u64)
        a = zahl_an((&d_karte[0 as usize]) as u64, a, dget(DG_NATW))
        a = text_an((&d_karte[0 as usize]) as u64, a,
            (&t_x[0 as usize]) as u64)
        a = zahl_an((&d_karte[0 as usize]) as u64, a, dget(DG_NATH))
    } else {
        a = text_an((&d_karte[0 as usize]) as u64, a,
            (&t_ne[0 as usize]) as u64)
    }
    let b: u64 = text_an((&d_tiefe[0 as usize]) as u64, 0,
        (&t_t[0 as usize]) as u64)
    let _c: u64 = text_an((&d_tiefe[0 as usize]) as u64, b,
        (&t_t3[0 as usize]) as u64)
}

// Die Zeile, die herunterzaehlt. Sie steht nur da, solange der Kernel
// wirklich eine Frist fuehrt.
fn frist_lesen() -> bool {
    var t_f: [u8; 20] = "Behalten? Zurueck i\0"
    var t_g: [u8; 3] = "n \0"
    var t_s: [u8; 10] = " Sekunden\0"
    var t_leer: [u8; 2] = " \0"
    if dget(DG_PENDING) != 1 {
        let _z: u64 = text_an((&d_frist[0 as usize]) as u64, 0,
            (&t_leer[0 as usize]) as u64)
        return false
    }
    var a: u64 = text_an((&d_frist[0 as usize]) as u64, 0,
        (&t_f[0 as usize]) as u64)
    a = text_an((&d_frist[0 as usize]) as u64, a, (&t_g[0 as usize]) as u64)
    a = zahl_an((&d_frist[0 as usize]) as u64, a,
        (dget(DG_REMAIN) + 999) / 1000)
    let _e: u64 = text_an((&d_frist[0 as usize]) as u64, a,
        (&t_s[0 as usize]) as u64)
    return true
}

fn stand_lesen() {
    var t_akt: [u8; 13] = "Aufloesung: \0"
    var t_mal: [u8; 4] = " x \0"
    var t_dat: [u8; 12] = "Uhr (UTC): \0"
    var t_pkt: [u8; 2] = ".\0"
    var t_dp: [u8; 2] = ":\0"
    var t_ip: [u8; 10] = "Adresse: \0"
    var t_mk: [u8; 8] = "Maske: \0"
    var t_gw: [u8; 10] = "Gateway: \0"
    var t_mac: [u8; 11] = "Hardware: \0"
    var t_kn: [u8; 10] = "kein Netz\0"
    var t_wer: [u8; 16] = "Angemeldet als \0"
    var t_uid: [u8; 7] = ", uid \0"
    var t_dd: [u8; 2] = "-\0"
    var a: u64 = text_an((&l_schirm[0 as usize]) as u64, 0,
        (&t_akt[0 as usize]) as u64)
    a = zahl_an((&l_schirm[0 as usize]) as u64, a, wlibc.screen_w())
    a = text_an((&l_schirm[0 as usize]) as u64, a,
        (&t_mal[0 as usize]) as u64)
    a = zahl_an((&l_schirm[0 as usize]) as u64, a, wlibc.screen_h())
    modi_lesen()
    karte_lesen()
    let _f: bool = frist_lesen()
    // Datum und Uhrzeit
    let d: u64 = (&l_datum[0 as usize]) as u64
    a = text_an(d, 0, (&t_dat[0 as usize]) as u64)
    a = zahl_an(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_YEAR, 0, 0))
    a = text_an(d, a, (&t_dd[0 as usize]) as u64)
    a = zwei_an(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_MONTH, 0, 0))
    a = text_an(d, a, (&t_dd[0 as usize]) as u64)
    a = zwei_an(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_DAY, 0, 0))
    a = text_an(d, a, (&t_mal[0 as usize]) as u64)
    a = zwei_an(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_HOUR, 0, 0))
    a = text_an(d, a, (&t_dp[0 as usize]) as u64)
    a = zwei_an(d, a, ulib.sys(ulib.SYS_SYSINFO, ulib.I_MIN, 0, 0))
    // das Netz
    let rd: u64 = ulib.sys(SYS_NETGET, NG_READY, 0, 0)
    let ip: u64 = (&l_ip[0 as usize]) as u64
    let mk: u64 = (&l_maske[0 as usize]) as u64
    let gw: u64 = (&l_gw[0 as usize]) as u64
    let mc: u64 = (&l_mac[0 as usize]) as u64
    if ulib.bad(rd) || rd == 0 {
        a = text_an(ip, 0, (&t_ip[0 as usize]) as u64)
        let _z: u64 = text_an(ip, a, (&t_kn[0 as usize]) as u64)
        a = text_an(mk, 0, (&t_mk[0 as usize]) as u64)
        let _y: u64 = text_an(mk, a, (&t_kn[0 as usize]) as u64)
        a = text_an(gw, 0, (&t_gw[0 as usize]) as u64)
        let _x: u64 = text_an(gw, a, (&t_kn[0 as usize]) as u64)
        a = text_an(mc, 0, (&t_mac[0 as usize]) as u64)
        let _w2: u64 = text_an(mc, a, (&t_kn[0 as usize]) as u64)
    } else {
        let v: u64 = ulib.sys(SYS_NETGET, NG_IP, 0, 0)
        let m: u64 = ulib.sys(SYS_NETGET, NG_MASK, 0, 0)
        let g: u64 = ulib.sys(SYS_NETGET, NG_GW, 0, 0)
        a = text_an(ip, 0, (&t_ip[0 as usize]) as u64)
        let _z: u64 = ip_an(ip, a, v)
        a = text_an(mk, 0, (&t_mk[0 as usize]) as u64)
        let _y: u64 = ip_an(mk, a, m)
        a = text_an(gw, 0, (&t_gw[0 as usize]) as u64)
        let _x: u64 = ip_an(gw, a, g)
        let m0: u64 = ulib.sys(SYS_NETGET, NG_MAC0, 0, 0)
        let m1: u64 = ulib.sys(SYS_NETGET, NG_MAC1, 0, 0)
        a = text_an(mc, 0, (&t_mac[0 as usize]) as u64)
        a = zahl_an(mc, a, (m0 >> 24) & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = zahl_an(mc, a, (m0 >> 16) & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = zahl_an(mc, a, (m0 >> 8) & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = zahl_an(mc, a, m0 & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = zahl_an(mc, a, (m1 >> 8) & 255)
        a = text_an(mc, a, (&t_dd[0 as usize]) as u64)
        a = zahl_an(mc, a, m1 & 255)
        let _e1: u64 = ip_an((&e_ip[0 as usize]) as u64, 0, v)
        let _e2: u64 = ip_an((&e_maske[0 as usize]) as u64, 0, m)
        let _e3: u64 = ip_an((&e_gw[0 as usize]) as u64, 0, g)
    }
    // wer davorsteht
    let uid: u64 = ulib.sys(102, 0, 0, 0)
    if !pw.name_of_uid(uid, (&name[0 as usize]) as u64, 64) {
        name[(0) as usize] = 63 as u8
        name[(1) as usize] = 0 as u8
    }
    a = text_an((&l_wer[0 as usize]) as u64, 0, (&t_wer[0 as usize]) as u64)
    a = text_an((&l_wer[0 as usize]) as u64, a, (&name[0 as usize]) as u64)
    a = text_an((&l_wer[0 as usize]) as u64, a, (&t_uid[0 as usize]) as u64)
    let _u: u64 = zahl_an((&l_wer[0 as usize]) as u64, a, uid)
}

fn melde_stand() {
    var s_m: [u8; 29] = "einstellungen: stand reiter=\0"
    var s_g: [u8; 14] = " geschrieben=\0"
    var s_s: [u8; 10] = " schemas=\0"
    var s_t: [u8; 10] = " status=[\0"
    var s_z: [u8; 2] = "]\0"
    say((&s_m[0 as usize]) as u64)
    ulib.sayn(reiter)
    say((&s_s[0 as usize]) as u64)
    ulib.sayn(nschema)
    say((&s_g[0 as usize]) as u64)
    ulib.sayn(geschrieben)
    say((&s_t[0 as usize]) as u64)
    say((&l_stat[0 as usize]) as u64)
    say((&s_z[0 as usize]) as u64)
    ulib.nl()
}

fn zeige_reiter(r: u64) {
    var k: u64 = 0
    while k < nid {
        wlib.show(ids[(k) as usize],
            rtr[(k) as usize] == R_ANZ || rtr[(k) as usize] == r)
        k = k + 1
    }
    reiter = r
    wlib.neu_setzen()
}

fn u_start(args: u64) -> u64 {
    var s_bad: [u8; 29] = "einstellungen: keine Flaeche\0"
    var s_rd: [u8; 24] = "einstellungen: ready w=\0"
    var s_hh: [u8; 4] = " h=\0"
    var t_theme: [u8; 11] = "/etc/theme\0"
    var t_schemas: [u8; 13] = "/etc/schemas\0"
    var t_hint: [u8; 17] = "/etc/hintergrund\0"
    var t_schirm: [u8; 17] = "/etc/schirm.conf\0"
    var t_zeit: [u8; 15] = "/etc/zeit.conf\0"
    var t_netz: [u8; 15] = "/etc/netz.conf\0"
    var t_dhcp: [u8; 10] = "/bin/dhcp\0"
    var m_ok: [u8; 7] = "bereit\0"
    var m_schema: [u8; 25] = "Farbschema uebernommen: \0"
    var m_schemano: [u8; 37] = "Farbschema liess sich nicht kopieren\0"
    var m_bild: [u8; 35] = "Hintergrundbild kopiert, Oktette: \0"
    var m_bildno: [u8; 31] = "Hintergrundbild nicht gefunden\0"
    var m_modeok: [u8; 22] = "Modus gesetzt, Tafel \0"
    var m_mal: [u8; 4] = " x \0"
    var m_modeno: [u8; 42] = "Modus abgelehnt -- nicht die Wurzel? oder\0"
    var m_behalt: [u8; 30] = "Behalten -- Frist abgelaeutet\0"
    var m_zurueck: [u8; 29] = "Zurueck auf den alten Modus.\0"
    var m_zeit: [u8; 39] = "Zeitzone gespeichert in /etc/zeit.conf\0"
    var m_netz: [u8; 47] = "Adresse gesetzt und /etc/netz.conf geschrieben\0"
    var m_netzno: [u8; 23] = "Keine gueltige Adresse\0"
    var m_netzr: [u8; 39] = "Adresse abgelehnt -- nicht die Wurzel?\0"
    var m_dhcp: [u8; 28] = "DHCP-Klient gestartet, pid \0"
    var m_kwok: [u8; 23] = "Kennwort gesetzt fuer \0"
    var m_kwne: [u8; 34] = "Die beiden Eingaben sind ungleich\0"
    var m_kwku: [u8; 24] = "Mindestens vier Zeichen\0"
    var m_kwno: [u8; 39] = "/etc/shadow liess sich nicht schreiben\0"
    var k_modus: [u8; 7] = "modus=\0"
    var k_800: [u8; 9] = "800x600\n\0"
    var k_1024: [u8; 10] = "1024x768\n\0"
    var k_off: [u8; 8] = "offset=\0"
    var k_nl: [u8; 2] = "\n\0"
    var k_dh: [u8; 12] = "modus=dhcp\n\0"
    var k_fe: [u8; 15] = "modus=fest\nip=\0"
    var k_mk: [u8; 8] = "\nmaske=\0"
    var k_gw: [u8; 10] = "\ngateway=\0"
    var s_pfad: [u8; 41] = "                                        \0"

    if !wlib.begin(false, false) {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    let _t: u64 = wlibc.theme_load((&t_theme[0 as usize]) as u64)
    let _n: u64 = schemas_lesen((&t_schemas[0 as usize]) as u64)
    let _h: u64 = text_an((&e_bild[0 as usize]) as u64, 0,
        (&t_hint[0 as usize]) as u64)
    let _s: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
        (&m_ok[0 as usize]) as u64)
    stand_lesen()

    let bw: u64 = 520
    let bh: u64 = 400
    w = wlib.window(140, 60, bw, bh, (&t_titel[0 as usize]) as u64)
    if w >= wlib.MAXWN {
        say((&s_bad[0 as usize]) as u64)
        ulib.nl()
        return 1
    }
    say((&s_rd[0 as usize]) as u64)
    ulib.sayn(bw)
    say((&s_hh[0 as usize]) as u64)
    ulib.sayn(bh)
    ulib.nl()

    wlib.box_v(w, 0, 0, bw, bh, 10, 6)
    let tb: u64 = merke(wlib.tabs((&t_tabs[0 as usize]) as u64), R_ANZ)
    // ---- Darstellung
    let _d1: u64 = merke(wlib.label((&l_far[0 as usize]) as u64), R_DARST)
    wlib.size(0, 110)
    let ls: u64 = merke(wlib.list((&schemas[0 as usize]) as u64, 5), R_DARST)
    let _d2: u64 = merke(wlib.label((&l_bil[0 as usize]) as u64), R_DARST)
    let eb: u64 = merke(wlib.entry((&e_bild[0 as usize]) as u64, 90),
        R_DARST)
    wlib.size(140, 26)
    let b1: u64 = merke(wlib.button((&b_uber[0 as usize]) as u64), R_DARST)
    // ---- Bildschirm (RUNDE DISPLAY)
    let _s1: u64 = merke(wlib.label((&l_schirm[0 as usize]) as u64),
        R_SCHIRM)
    let _sk: u64 = merke(wlib.label((&d_karte[0 as usize]) as u64), R_SCHIRM)
    let _s2: u64 = merke(wlib.label((&l_aufl[0 as usize]) as u64), R_SCHIRM)
    let _s2b: u64 = merke(wlib.label((&l_aufl2[0 as usize]) as u64), R_SCHIRM)
    wlib.size(0, 110)
    let cs: u64 = merke(wlib.list((&d_modi[0 as usize]) as u64, 5), R_SCHIRM)
    let _s5: u64 = merke(wlib.label((&l_skal[0 as usize]) as u64), R_SCHIRM)
    let ck: u64 = merke(wlib.choice((&c_skal[0 as usize]) as u64, 0),
        R_SCHIRM)
    let _s6: u64 = merke(wlib.label((&l_dreh[0 as usize]) as u64), R_SCHIRM)
    let cd: u64 = merke(wlib.choice((&c_dreh[0 as usize]) as u64, 0),
        R_SCHIRM)
    let _s7: u64 = merke(wlib.label((&l_hell[0 as usize]) as u64), R_SCHIRM)
    let ch: u64 = merke(wlib.choice((&c_hell[0 as usize]) as u64, 2),
        R_SCHIRM)
    let cc: u64 = merke(wlib.choice((&c_hell[0 as usize]) as u64, 2),
        R_SCHIRM)
    let _s8: u64 = merke(wlib.label((&l_gam[0 as usize]) as u64), R_SCHIRM)
    let cg: u64 = merke(wlib.choice((&c_gam[0 as usize]) as u64, 2),
        R_SCHIRM)
    let cq: u64 = merke(wlib.choice((&c_sat[0 as usize]) as u64, 2),
        R_SCHIRM)
    let _st2: u64 = merke(wlib.label((&d_tiefe[0 as usize]) as u64), R_SCHIRM)
    let _s3: u64 = merke(wlib.label((&l_ehr1[0 as usize]) as u64), R_SCHIRM)
    let _s4: u64 = merke(wlib.label((&l_ehr2[0 as usize]) as u64), R_SCHIRM)
    wlib.size(140, 26)
    let b2: u64 = merke(wlib.button((&b_uber[0 as usize]) as u64), R_SCHIRM)
    // DIE BESTAETIGUNGSFRAGE. Zwei Knoepfe und eine Zeile, die
    // herunterzaehlt -- und sie stehen nur da, solange wirklich eine
    // Frist laeuft. Was sie WIRKLICH sicher macht, steht aber nicht
    // hier: der Kernel bringt den alten Modus auch dann zurueck, wenn
    // dieses Programm gar nicht mehr antwortet (`vmode.poll`). Ein
    // Sicherheitsnetz, das von dem Programm abhaengt, dessen Bildschirm
    // gerade schwarz ist, waere keines.
    let _sf: u64 = merke(wlib.label((&d_frist[0 as usize]) as u64), R_SCHIRM)
    wlib.size(120, 26)
    let b2a: u64 = merke(wlib.button((&b_halt[0 as usize]) as u64), R_SCHIRM)
    wlib.size(120, 26)
    let b2b: u64 = merke(wlib.button((&b_zur[0 as usize]) as u64), R_SCHIRM)
    // ---- Zeit
    let lz: u64 = merke(wlib.label((&l_datum[0 as usize]) as u64), R_ZEIT)
    let _z2: u64 = merke(wlib.label((&l_zone[0 as usize]) as u64), R_ZEIT)
    let cz: u64 = merke(wlib.choice((&c_zone[0 as usize]) as u64, 2), R_ZEIT)
    let _z3: u64 = merke(wlib.label((&l_ehr3[0 as usize]) as u64), R_ZEIT)
    let _z4: u64 = merke(wlib.label((&l_ehr4[0 as usize]) as u64), R_ZEIT)
    wlib.size(140, 26)
    let b3: u64 = merke(wlib.button((&b_uber[0 as usize]) as u64), R_ZEIT)
    // ---- Netz
    let _n1: u64 = merke(wlib.label((&l_ip[0 as usize]) as u64), R_NETZ)
    let _n2: u64 = merke(wlib.label((&l_maske[0 as usize]) as u64), R_NETZ)
    let _n3: u64 = merke(wlib.label((&l_gw[0 as usize]) as u64), R_NETZ)
    let _n4: u64 = merke(wlib.label((&l_mac[0 as usize]) as u64), R_NETZ)
    let _n5: u64 = merke(wlib.label((&l_bez[0 as usize]) as u64), R_NETZ)
    let cn: u64 = merke(wlib.choice((&c_bez[0 as usize]) as u64, 1), R_NETZ)
    let _n6: u64 = merke(wlib.label((&l_ip2[0 as usize]) as u64), R_NETZ)
    let en1: u64 = merke(wlib.entry((&e_ip[0 as usize]) as u64, 20), R_NETZ)
    let en2: u64 = merke(wlib.entry((&e_maske[0 as usize]) as u64, 20),
        R_NETZ)
    let en3: u64 = merke(wlib.entry((&e_gw[0 as usize]) as u64, 20), R_NETZ)
    wlib.size(140, 26)
    let b4: u64 = merke(wlib.button((&b_uber[0 as usize]) as u64), R_NETZ)
    // ---- Benutzer
    let _u1: u64 = merke(wlib.label((&l_wer[0 as usize]) as u64), R_BENUT)
    let _u2: u64 = merke(wlib.label((&l_kw1[0 as usize]) as u64), R_BENUT)
    let ep1: u64 = merke(wlib.entry((&e_pw1[0 as usize]) as u64, 60),
        R_BENUT)
    let _u3: u64 = merke(wlib.label((&l_kw2[0 as usize]) as u64), R_BENUT)
    let ep2: u64 = merke(wlib.entry((&e_pw2[0 as usize]) as u64, 60),
        R_BENUT)
    wlib.size(160, 26)
    let b5: u64 = merke(wlib.button((&b_kw[0 as usize]) as u64), R_BENUT)
    // ---- immer sichtbar
    let st: u64 = merke(wlib.label((&l_stat[0 as usize]) as u64), R_ANZ)
    wlib.box_end()
    let _tb2: u64 = tb
    let _e0: u64 = eb
    // RUNDE DISPLAY: die Auswahlen zeigen, WAS EINGESTELLT IST, und
    // nicht die Mitte. Ein Bedienfeld, das beim Oeffnen luegt, ist
    // schlimmer als eins ohne Anzeige.
    if dget(DG_READY) == 1 {
        wlib.set_value(cs, dget(DG_CUR))
        wlib.set_value(ck, dget(DG_SCALE))
        wlib.set_value(cd, dget(DG_ROT) / 90)
        wlib.set_value(ch, stufe_von(dget(DG_BRIGHT), 0))
        wlib.set_value(cc, stufe_von(dget(DG_CONTRAST), 0))
        wlib.set_value(cg, stufe_von(dget(DG_GAMMA), 1))
        wlib.set_value(cq, stufe_von(dget(DG_SAT), 2))
    }
    zeige_reiter(R_DARST)
    wlib.draw_all()
    melde_stand()

    var runden: u64 = 0
    var frist_vor: u64 = 0
    while wlib.alive() && runden < 4000000 {
        runden = runden + 1
        // Die Frist herunterzaehlen -- aber nur, wenn sich die SEKUNDE
        // geaendert hat. Ein Text, der in jedem Schleifendurchlauf neu
        // gesetzt wird, macht das Fenster in jedem Durchlauf schmutzig
        // und den Fensterserver zum Dauerlaeufer.
        if reiter == R_SCHIRM {
            let rest: u64 = (dget(DG_REMAIN) + 999) / 1000
            if rest != frist_vor {
                frist_vor = rest
                let _fl: bool = frist_lesen()
                wlib.set_text(_sf, (&d_frist[0 as usize]) as u64)
                if rest == 0 {
                    stand_lesen()
                    wlib.set_text(_sk, (&d_karte[0 as usize]) as u64)
                }
            }
        }
        let id: u64 = wlib.step()
        if id < wlib.MAXWD {
            let kind: u64 = wlib.fired_kind()
            if kind == wlib.K_TABS {
                zeige_reiter(wlib.fired_index())
                melde_stand()
            } else if kind == wlib.K_BUTTON {
                if id == b1 {
                    // Farbschema und Hintergrundbild
                    var pf: [u8; 96] = [0 as u8; 96]
                    if schema_pfad(wlib.value(ls), (&pf[0 as usize]) as u64) {
                        if datei_kopieren((&pf[0 as usize]) as u64,
                            (&t_theme[0 as usize]) as u64) > 0 {
                            let a: u64 = text_an((&l_stat[0 as usize]) as u64,
                                0, (&m_schema[0 as usize]) as u64)
                            let _b: u64 = text_an((&l_stat[0 as usize])
                                as u64, a, (&snamen[0 as usize]) as u64
                                + wlib.value(ls) * 32)
                            let _r: u64 = wlibc.theme_load(
                                (&t_theme[0 as usize]) as u64)
                        } else {
                            let _c: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, (&m_schemano[0 as usize]) as u64)
                        }
                    }
                    // das Bild -- nur, wenn die Quelle nicht schon das
                    // Ziel ist. Eine Datei auf sich selbst zu kopieren
                    // heisst hier: sie erst leeren und dann lesen.
                    if !ulib.streq((&e_bild[0 as usize]) as u64,
                        (&t_hint[0 as usize]) as u64) {
                        let n2: u64 = datei_kopieren(
                            (&e_bild[0 as usize]) as u64,
                            (&t_hint[0 as usize]) as u64)
                        if n2 > 0 {
                            let a2: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, (&m_bild[0 as usize]) as u64)
                            let _d2b: u64 = zahl_an((&l_stat[0 as usize])
                                as u64, a2, n2)
                        } else {
                            let _e2b: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, (&m_bildno[0 as usize]) as u64)
                        }
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b2 {
                    // RUNDE DISPLAY: UEBERNEHMEN HEISST JETZT
                    // UEBERNEHMEN. Vorher wurde eine Zeile in
                    // /etc/schirm.conf geschrieben und auf den naechsten
                    // Start vertroestet.
                    //
                    // Die Reihenfolge ist nicht beliebig: erst das
                    // Bild (Helligkeit, Kontrast, Gamma, Saettigung),
                    // dann die Drehung und die Skalierung, und ZULETZT
                    // die Aufloesung. Ein Moduswechsel raeumt den
                    // Zweitpuffer um; alles, was davor eingestellt
                    // wurde, gilt danach weiter, alles was danach kaeme,
                    // muesste ein zweites Mal gesetzt werden.
                    let _p1: u64 = dset(DS_BRIGHT,
                        stufe_hell(wlib.value(ch)))
                    let _p2: u64 = dset(DS_CONTRAST,
                        stufe_hell(wlib.value(cc)))
                    let _p3: u64 = dset(DS_GAMMA, stufe_gam(wlib.value(cg)))
                    let _p4: u64 = dset(DS_SAT, stufe_sat(wlib.value(cq)))
                    let _p5: u64 = dset(DS_SCALE, wlib.value(ck))
                    let _p6: u64 = dset(DS_ROT, wlib.value(cd) * 90)
                    var a3: u64 = 0
                    let z: u64 = wlib.value(cs)
                    if z < d_n {
                        let m: u64 = dget(DG_MODE + z)
                        var rc: u64 = 0
                        if !ulib.bad(m) {
                            rc = dset(DS_MODE, (((m >> 32) & 0xFFFF) << 16)
                                | ((m >> 16) & 0xFFFF))
                        }
                        if ulib.bad(rc) {
                            a3 = text_an((&l_stat[0 as usize]) as u64, 0,
                                (&m_modeno[0 as usize]) as u64)
                        } else {
                            a3 = text_an((&l_stat[0 as usize]) as u64, 0,
                                (&m_modeok[0 as usize]) as u64)
                            a3 = zahl_an((&l_stat[0 as usize]) as u64, a3,
                                dget(DG_PANELW))
                            a3 = text_an((&l_stat[0 as usize]) as u64, a3,
                                (&m_mal[0 as usize]) as u64)
                            a3 = zahl_an((&l_stat[0 as usize]) as u64, a3,
                                dget(DG_PANELH))
                        }
                    } else {
                        a3 = text_an((&l_stat[0 as usize]) as u64, 0,
                            (&m_modeno[0 as usize]) as u64)
                    }
                    let _a3b: u64 = a3
                    stand_lesen()
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.set_text(_sk, (&d_karte[0 as usize]) as u64)
                    wlib.set_text(_sf, (&d_frist[0 as usize]) as u64)
                    wlib.neu_setzen()
                    melde_stand()
                } else if id == b2a {
                    let _k1: u64 = dset(DS_CONFIRM, 0)
                    let _k2: bool = frist_lesen()
                    wlib.set_text(_sf, (&d_frist[0 as usize]) as u64)
                    let _k3: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                        (&m_behalt[0 as usize]) as u64)
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b2b {
                    let _r1: u64 = dset(DS_REVERT, 0)
                    stand_lesen()
                    wlib.set_text(_sf, (&d_frist[0 as usize]) as u64)
                    wlib.set_text(_sk, (&d_karte[0 as usize]) as u64)
                    let _r3: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                        (&m_zurueck[0 as usize]) as u64)
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    wlib.neu_setzen()
                    melde_stand()
                } else if id == b3 {
                    var buf2: [u8; 32] = [0 as u8; 32]
                    var a4: u64 = text_an((&buf2[0 as usize]) as u64, 0,
                        (&k_off[0 as usize]) as u64)
                    a4 = zahl_an((&buf2[0 as usize]) as u64, a4,
                        wlib.value(cz) * 60)
                    a4 = text_an((&buf2[0 as usize]) as u64, a4,
                        (&k_nl[0 as usize]) as u64)
                    let _w4: bool = datei_schreiben(
                        (&t_zeit[0 as usize]) as u64,
                        (&buf2[0 as usize]) as u64, a4)
                    let _s6: u64 = text_an((&l_stat[0 as usize]) as u64, 0,
                        (&m_zeit[0 as usize]) as u64)
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b4 {
                    if wlib.value(cn) == 0 {
                        var buf3: [u8; 24] = [0 as u8; 24]
                        let a5: u64 = text_an((&buf3[0 as usize]) as u64, 0,
                            (&k_dh[0 as usize]) as u64)
                        let _w5: bool = datei_schreiben(
                            (&t_netz[0 as usize]) as u64,
                            (&buf3[0 as usize]) as u64, a5)
                        let pid: u64 = ulib.sys(ulib.SYS_SPAWN,
                            (&t_dhcp[0 as usize]) as u64, 0, 0)
                        let a6: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, (&m_dhcp[0 as usize]) as u64)
                        let _z7: u64 = zahl_an((&l_stat[0 as usize]) as u64,
                            a6, pid)
                    } else {
                        let vip: u64 = ip_lesen((&e_ip[0 as usize]) as u64)
                        let vmk: u64 = ip_lesen((&e_maske[0 as usize])
                            as u64)
                        let vgw: u64 = ip_lesen((&e_gw[0 as usize]) as u64)
                        if vip == 0 || vmk == 0 {
                            let _s8: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, (&m_netzno[0 as usize]) as u64)
                        } else {
                            let rc: u64 = ulib.sys(SYS_NETSET, vip, vmk, vgw)
                            if ulib.bad(rc) {
                                let _s9: u64 = text_an((&l_stat[0 as usize])
                                    as u64, 0, (&m_netzr[0 as usize]) as u64)
                            } else {
                                var buf4: [u8; 96] = [0 as u8; 96]
                                var a7: u64 = text_an((&buf4[0 as usize])
                                    as u64, 0, (&k_fe[0 as usize]) as u64)
                                a7 = ip_an((&buf4[0 as usize]) as u64, a7,
                                    vip)
                                a7 = text_an((&buf4[0 as usize]) as u64, a7,
                                    (&k_mk[0 as usize]) as u64)
                                a7 = ip_an((&buf4[0 as usize]) as u64, a7,
                                    vmk)
                                a7 = text_an((&buf4[0 as usize]) as u64, a7,
                                    (&k_gw[0 as usize]) as u64)
                                a7 = ip_an((&buf4[0 as usize]) as u64, a7,
                                    vgw)
                                a7 = text_an((&buf4[0 as usize]) as u64, a7,
                                    (&k_nl[0 as usize]) as u64)
                                let _wa: bool = datei_schreiben(
                                    (&t_netz[0 as usize]) as u64,
                                    (&buf4[0 as usize]) as u64, a7)
                                let _sa: u64 = text_an((&l_stat[0 as usize])
                                    as u64, 0, (&m_netz[0 as usize]) as u64)
                            }
                        }
                    }
                    stand_lesen()
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                } else if id == b5 {
                    if !ulib.streq((&e_pw1[0 as usize]) as u64,
                        (&e_pw2[0 as usize]) as u64) {
                        let _sb: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, (&m_kwne[0 as usize]) as u64)
                    } else if ulib.length((&e_pw1[0 as usize]) as u64) < 4 {
                        let _sc: u64 = text_an((&l_stat[0 as usize]) as u64,
                            0, (&m_kwku[0 as usize]) as u64)
                    } else {
                        var rec: [u8; 160] = [0 as u8; 160]
                        var gut: bool = pw.make_hash(
                            (&e_pw1[0 as usize]) as u64,
                            (&rec[0 as usize]) as u64)
                        if gut {
                            gut = pw.set_shadow((&name[0 as usize]) as u64,
                                (&rec[0 as usize]) as u64)
                        }
                        if gut {
                            geschrieben = geschrieben + 1
                            let ad: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, (&m_kwok[0 as usize]) as u64)
                            let _sd: u64 = text_an((&l_stat[0 as usize])
                                as u64, ad, (&name[0 as usize]) as u64)
                        } else {
                            let _se: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, (&m_kwno[0 as usize]) as u64)
                        }
                    }
                    wlib.set_text(st, (&l_stat[0 as usize]) as u64)
                    melde_stand()
                }
            }
        }
    }
    let _q1: u64 = lz
    let _q2: u64 = en1
    let _q3: u64 = en2
    let _q4: u64 = en3
    let _q5: u64 = ep1
    let _q6: u64 = ep2
    let _q7: u64 = (&s_pfad[0 as usize]) as u64
    return 0
}
