            if kind == wlib.K_TABS {
                zeige_reiter(wlib.fired_index())
                melde_stand()
            } else if kind == wlib.K_CHOICE {
                // A CHOICE THAT CANNOT BE CHANGED IS A PICTURE OF A
                // CHOICE. Round DESKTOP put four of them into this
                // program -- resolution, time zone, DHCP -- and none of
                // them ever opened: `wlib` fires K_CHOICE with the index
                // 0x1000 and leaves it to the application to open the
                // menu, and this application did not. It does now, and
                // the same four lines serve the taskbar edge.
                if wlib.fired_index() == 0x1000 {
                    var items: u64 = msg.get((&k_c_aufl[0 as usize]) as u64)
                    var cnt: u64 = 2
                    if id == cz {
                        items = msg.get((&k_c_zone[0 as usize]) as u64)
                        cnt = 3
                    } else if id == cn {
                        items = msg.get((&k_c_bez[0 as usize]) as u64)
                        cnt = 2
                    } else if id == ce {
                        items = msg.get((&k_c_tb[0 as usize]) as u64)
                        cnt = 4
                    } else if id == cv {
                        items = msg.get((&k_c_view[0 as usize]) as u64)
                        cnt = 4
                    }
                    let mx: u64 = wlib.win_x(w) + 2 + wlib.rect_x(id)
                    let my: u64 = wlib.win_y(w) + 22 + wlib.rect_y(id)
                        + wlib.rect_h(id)
                    let _mo: u64 = wlib.menu_open(id, mx, my, items, cnt)
                    menu_say(id, mx, my, cnt)
                }
            } else if kind == wlib.K_MENUBAR {
                // The library re-fires the chosen row at the widget that
                // opened the menu. That is the answer to the choice.
                if id == cs || id == cz || id == cn || id == ce
                    || id == cv {
                    wlib.set_value(id, wlib.fired_index())
                    if id == ce {
                        tb_edge = wlib.fired_index()
                        tb_show_size()
                        wlib.set_text(et, (&e_tbs[0 as usize]) as u64)
                    }
                    wlib.dirty_all(w)
                    menu_done(id, wlib.fired_index())
                }
            } else if kind == wlib.K_BUTTON {
                if id == b1 {
                    // RUNDE THEME: nicht mehr eine Datei kopieren,
                    // sondern /etc/theme.conf schreiben und den Satz
                    // neu aufloesen. Danach stehen die gemessenen
                    // Kontraste im Fenster -- vor dem naechsten Klick
                    // und nicht in einem Protokoll.
                    if wlib.value(ls) < nschema {
                        if theme_conf_schreiben(
                            (&snamen[0 as usize]) as u64
                                + wlib.value(ls) * 32,
                            wlib.value(cm),
                            (&e_akzent[0 as usize]) as u64) {
                            let _r: u64 = wlibc.theme_reload()
                            kontrast_zeigen()
                            wlib.set_text(lk, (&l_kon[0 as usize]) as u64)
                            wlib.set_text(lw, (&l_warn[0 as usize]) as u64)
                            let a: u64 = text_an((&l_stat[0 as usize]) as u64,
                                0, msg.get((&k_m_schema[0 as usize]) as u64))
                            let _b: u64 = text_an((&l_stat[0 as usize])
                                as u64, a, (&snamen[0 as usize]) as u64
                                + wlib.value(ls) * 32)
                        } else {
                            let _c: u64 = text_an((&l_stat[0 as usize])
                                as u64, 0, msg.get((&k_m_schemano[0 as usize]) as u64))
                        }
                    }
                    // das Bild -- nur, wenn die Quelle nicht schon das
                    // Ziel ist. Eine Datei auf sich selbst zu kopieren
                    // heisst hier: sie erst leeren und dann lesen.
                    if !ulib.streq((&e_bild[0 as usize]) as u64,
                        (&t_wall[0 as usize]) as u64) {
