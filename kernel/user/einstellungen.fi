static mut c_gam: [u8; 30] = "0,45\n0,70\n1,00\n1,40\n1,80\n2,20\0"
static mut c_sat: [u8; 29] = "0% (grau)\n50%\n100%\n150%\n200%\0"
static mut b_halt: [u8; 9] = "Behalten\0"
static mut b_zur: [u8; 9] = "Zurueck\0\0"
static mut l_zone: [u8; 27] = "Zeitzone fuer die Anzeige:\0"
static mut c_zone: [u8; 31] = "UTC+0\nUTC+1 (MEZ)\nUTC+2 (MESZ)\0"
static mut l_ehr3: [u8; 51] = "Die Hardware-Uhr laesst sich hier nicht stellen --\0"
static mut l_ehr4: [u8; 42] = "dieser Kernel hat nur SYS_TIME zum Lesen.\0"
