// ==================================================== RUNDE DISPLAY
//
// Die Aufrufe 1800..1802 aus `kernel/sys.fi`. Bis zu dieser Runde stand
// auf dem Reiter "Bildschirm" eine Auswahl aus ZWEI Aufloesungen, die
// erst beim naechsten Start gewirkt haette, und darunter der ehrliche
// Satz ueber den Moduswechsel, den es nicht gab,. Der Satz
// stimmt nicht mehr; die Auswahl kommt jetzt aus der Karte, und sie
// wirkt sofort.
const SYS_DISPGET: u64 = 1810
