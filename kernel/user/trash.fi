
profile kernel

import libc.memcopy
import ulib
import libc.text
import libc.io
import tools
import libc.pathname

export {
    hinein, back, entfernen, clear, load, count, id_von,
    name_von, path_from, time_from, size_from, sum, limit,
    trash_from, delete_recursive, time_text, MAXK
}

const MAXK: u64 = 128
const NAMEC: u64 = 128

static mut k_id: [u64; 128] = [0; 128]
static mut k_time: [u64; 128] = [0; 128]
static mut k_gr: [u64; 128] = [0; 128]
static mut k_path: [u8; 16384] = [0 as u8; 16384]
static mut nk: u64 = 0
static mut ksumme: u64 = 0
static mut kwurzel: [u8; 128] = [0 as u8; 128]
static mut korbp: [u8; 160] = [0 as u8; 160]
static mut tmp1: [u8; 512] = [0 as u8; 512]
static mut tmp2: [u8; 512] = [0 as u8; 512]
static mut ibuf: [u8; 512] = [0 as u8; 512]
static mut zbuf: [u8; 32] = [0 as u8; 32]

fn pf_at(i: u64) -> u64 {
    return (&k_path[(0) as usize]) as u64 + i * NAMEC
}

fn count() -> u64 {
    return nk
}

fn id_von(i: u64) -> u64 {
    return k_id[(i) as usize]
}

fn time_from(i: u64) -> u64 {
    return k_time[(i) as usize]
}

fn size_from(i: u64) -> u64 {
    return k_gr[(i) as usize]
}

fn path_from(i: u64) -> u64 {
    return pf_at(i)
}

fn name_von(i: u64) -> u64 {
    return pathname.base_name(pf_at(i))
}

fn sum() -> u64 {
    return ksumme
}

fn root_from(path: u64, out: u64) {
    var root: [u8; 2] = "/\0"
    ulib.strcpy(out, (&root[(0) as usize]) as u64)
    let n: u64 = ulib.sys(ulib.SYS_MNTSTAT, 0, ulib.MS_COUNT, 0)
    if ulib.bad(n) || n == 0 {
        return
    }
    var best: u64 = 1
    var i: u64 = 0
    while i < n {
        if ulib.sys(ulib.SYS_MNTSTAT, i, ulib.MS_USED, 0) == 1 {
            let plen: u64 = ulib.sys(ulib.SYS_MNTSTAT, i, ulib.MS_PATHLEN, 0)
            if plen > best && plen < 120 {
                var p: [u8; 128] = [0 as u8; 128]
                var k: u64 = 0
                while k < plen {
                    p[(k) as usize] = ulib.sys(ulib.SYS_MNTSTAT, i,
                        ulib.MS_PATHCH + k, 0) as u8
                    k = k + 1
                }
                p[(k) as usize] = 0 as u8
                if ulib.strneq(path, (&p[(0) as usize]) as u64, plen) {
                    let c: u64 = (*((path + plen) as *mut u8)) as u64
                    if c == 47 || c == 0 {
                        ulib.strcpy(out, (&p[(0) as usize]) as u64)
                        best = plen
                    }
                }
            }
        }
        i = i + 1
    }
}

fn trash_from(path: u64) -> u64 {
    var part: [u8; 12] = ".papierkorb\0"
    var slash: [u8; 2] = "/\0"
    let w: u64 = (&kwurzel[(0) as usize]) as u64
    let k: u64 = (&korbp[(0) as usize]) as u64
    root_from(path, w)
    ulib.strncpy(k, w, 120)
    if text.length(k) > 0
        && *((k + text.length(k) - 1) as *mut u8) != 47 as u8 {
        ulib.strcat(k, (&slash[(0) as usize]) as u64)
    }
    ulib.strcat(k, (&part[(0) as usize]) as u64)
    return k
}

fn together(out: u64, trash: u64, id: u64, info: bool) {
    var slash: [u8; 2] = "/\0"
    var suffix: [u8; 6] = ".info\0"
    var z: [u8; 24] = [0 as u8; 24]
    let n: u64 = text.digits(id, (&z[(0) as usize]) as u64, true)
    z[(n) as usize] = 0 as u8
    ulib.strcpy(out, trash)
    ulib.strcat(out, (&slash[(0) as usize]) as u64)
    ulib.strcat(out, (&z[(0) as usize]) as u64)
    if info {
        ulib.strcat(out, (&suffix[(0) as usize]) as u64)
    }
}

fn gibt_es(path: u64) -> bool {
    let fd: u64 = io.open(path, 0)
    if ulib.bad(fd) {
        return ulib.is_dir(path)
    }
    io.close(fd)
    return true
}

fn info_write(path_info: u64, orig: u64, time: u64, gr: u64) -> bool {
    var k_p: [u8; 6] = "path=\0"
    var k_z: [u8; 7] = "\ntime=\0"
    var k_g: [u8; 7] = "\nsize=\0"
    var k_e: [u8; 2] = "\n\0"
    let b: u64 = (&ibuf[(0) as usize]) as u64
    var z: [u8; 24] = [0 as u8; 24]
    ulib.strcpy(b, (&k_p[(0) as usize]) as u64)
    ulib.strcat(b, orig)
    ulib.strcat(b, (&k_z[(0) as usize]) as u64)
    var n: u64 = text.digits(time, (&z[(0) as usize]) as u64, true)
    z[(n) as usize] = 0 as u8
    ulib.strcat(b, (&z[(0) as usize]) as u64)
    ulib.strcat(b, (&k_g[(0) as usize]) as u64)
    n = text.digits(gr, (&z[(0) as usize]) as u64, true)
    z[(n) as usize] = 0 as u8
    ulib.strcat(b, (&z[(0) as usize]) as u64)
    ulib.strcat(b, (&k_e[(0) as usize]) as u64)
    let fd: u64 = tools.openw(path_info)
    if ulib.bad(fd) {
        return false
    }
    let len: u64 = text.length(b)
    let g: u64 = io.write_all(fd, b, len)
    io.close(fd)
    return !ulib.bad(g) && g >= len
}

fn value_from(text: u64, key: u64, out: u64, max: u64) -> bool {
    let at: u64 = ulib.find(text, key)
    if at == 0xFFFFFFFFFFFFFFFF {
        return false
    }
    var p: u64 = text + at + text.length(key)
    var n: u64 = 0
    while *((p) as *mut u8) != 0 as u8 && *((p) as *mut u8) != 10 as u8
        && n + 1 < max {
        __mmio_write8((out + n) as *mut u8, *((p) as *mut u8))
        n = n + 1
        p = p + 1
    }
    __mmio_write8((out + n) as *mut u8, 0 as u8)
    return true
}

fn info_read(path_info: u64, i: u64) -> bool {
    var k_p: [u8; 6] = "path=\0"
    var k_po: [u8; 6] = "pfad=\0"
    var k_z: [u8; 6] = "time=\0"
    var k_zo: [u8; 6] = "zeit=\0"
    var k_g: [u8; 6] = "size=\0"
    var k_go: [u8; 9] = "groesse=\0"
    let fd: u64 = io.open(path_info, 0)
    if ulib.bad(fd) {
        return false
    }
    let b: u64 = (&ibuf[(0) as usize]) as u64
    let n: u64 = io.read(fd, b, 500)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return false
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    var z: [u8; 32] = [0 as u8; 32]
    if !value_from(b, (&k_p[(0) as usize]) as u64, pf_at(i), NAMEC)
        && !value_from(b, (&k_po[(0) as usize]) as u64, pf_at(i), NAMEC) {
        return false
    }
    if value_from(b, (&k_z[(0) as usize]) as u64, (&z[(0) as usize]) as u64,
        30) || value_from(b, (&k_zo[(0) as usize]) as u64, (&z[(0) as usize]) as u64,
        30) {
        k_time[(i) as usize] = ulib.to_num((&z[(0) as usize]) as u64)
    }
    if value_from(b, (&k_g[(0) as usize]) as u64, (&z[(0) as usize]) as u64,
        30) || value_from(b, (&k_go[(0) as usize]) as u64, (&z[(0) as usize]) as u64,
        30) {
        k_gr[(i) as usize] = ulib.to_num((&z[(0) as usize]) as u64)
    }
    return true
}

fn ends_with_info(name: u64) -> u64 {
    let n: u64 = text.length(name)
    if n < 6 {
        return 0
    }
    if *((name + n - 5) as *mut u8) != 46 as u8 {
        return 0
    }
    if *((name + n - 4) as *mut u8) != 105 as u8 {
        return 0
    }
    if *((name + n - 3) as *mut u8) != 110 as u8 {
        return 0
    }
    if *((name + n - 2) as *mut u8) != 102 as u8 {
        return 0
    }
    if *((name + n - 1) as *mut u8) != 111 as u8 {
        return 0
    }
    return n - 5
}

fn load(bei: u64) -> u64 {
    nk = 0
    ksumme = 0
    let trash: u64 = trash_from(bei)
    let fd: u64 = io.dir_open(trash)
    if ulib.bad(fd) {
        return 0
    }
    var buf: [u8; 1024] = [0 as u8; 1024]
    var next: bool = true
    while next {
        let n: u64 = io.dir_read(fd, (&buf[(0) as usize]) as u64, 1024)
        if ulib.bad(n) || n == 0 {
            next = false
        } else {
            var at: u64 = 0
            while at < n {
                let rec: u64 = (&buf[(0) as usize]) as u64 + at
                let nm: u64 = io.dir_name(rec)
                let short: u64 = ends_with_info(nm)
                if short > 0 && nk < MAXK {
                    var idt: [u8; 24] = [0 as u8; 24]
                    var m: u64 = short
                    if m > 20 {
                        m = 20
                    }
                    memcopy.copy((&idt[(0) as usize]) as u64, nm, m)
                    idt[(m) as usize] = 0 as u8
                    let id: u64 = ulib.to_num((&idt[(0) as usize]) as u64)
                    k_id[(nk) as usize] = id
                    k_time[(nk) as usize] = 0
                    k_gr[(nk) as usize] = 0
                    together((&tmp1[(0) as usize]) as u64, trash, id, true)
                    if info_read((&tmp1[(0) as usize]) as u64, nk) {
                        ksumme = ksumme + k_gr[(nk) as usize]
                        nk = nk + 1
                    }
                }
                at = at + io.dir_reclen(rec)
            }
        }
    }
    io.close(fd)
    return nk
}

fn copy(von: u64, move_to: u64) -> bool {
    var buffer: [u8; 4096] = [0 as u8; 4096]
    let q: u64 = io.open(von, 0)
    if ulib.bad(q) {
        return false
    }
    let z: u64 = io.create(move_to)
    if ulib.bad(z) {
        io.close(q)
        return false
    }
    var gut: bool = true
    var next: bool = true
    while next {
        let n: u64 = io.read(q, (&buffer[(0) as usize]) as u64, 4096)
        if ulib.bad(n) || n == 0 {
            next = false
        } else {
            let g: u64 = io.write_all(z, (&buffer[(0) as usize]) as u64, n)
            if ulib.bad(g) || g < n {
                gut = false
                next = false
            }
        }
    }
    io.close(q)
    io.close(z)
    return gut
}

fn next_id(trash: u64) -> u64 {
    var id: u64 = 1
    while id < 100000 {
        together((&tmp1[(0) as usize]) as u64, trash, id, true)
        if !gibt_es((&tmp1[(0) as usize]) as u64) {
            together((&tmp1[(0) as usize]) as u64, trash, id, false)
            if !gibt_es((&tmp1[(0) as usize]) as u64) {
                return id
            }
        }
        id = id + 1
    }
    return 0
}

fn limit_from(path: u64, key: u64) -> u64 {
    let fd: u64 = io.open(path, 0)
    if ulib.bad(fd) {
        return 0
    }
    let b: u64 = (&ibuf[(0) as usize]) as u64
    let n: u64 = io.read(fd, b, 500)
    io.close(fd)
    if ulib.bad(n) || n == 0 {
        return 0
    }
    __mmio_write8((b + n) as *mut u8, 0 as u8)
    var z: [u8; 32] = [0 as u8; 32]
    if !value_from(b, key, (&z[(0) as usize]) as u64, 30) {
        return 0
    }
    let v: u64 = ulib.to_num((&z[(0) as usize]) as u64)
    if v > 0 && v < 1000000 {
        return v
    }
    return 0
}

fn limit() -> u64 {
    var path: [u8; 16] = "/etc/trash.conf\0"
    var key: [u8; 7] = "limit=\0"
    var old_path: [u8; 21] = "/etc/papierkorb.conf\0"
    var old_key: [u8; 8] = "grenze=\0"
    var mib: u64 = limit_from((&path[(0) as usize]) as u64, (&key[(0) as usize]) as u64)
    if mib == 0 {
        mib = limit_from((&old_path[(0) as usize]) as u64, (&old_key[(0) as usize]) as u64)
    }
    if mib == 0 {
        mib = 64
    }
    return mib * 1048576
}

fn aufraeumen(bei: u64) {
    var s_gone: [u8; 39] = "trash: limit exceeded, gone for good: \0"
    let g: u64 = limit()
    var runden: u64 = 0
    while runden < MAXK {
        runden = runden + 1
        let n: u64 = load(bei)
        if n == 0 || ksumme <= g {
            runden = MAXK
        } else {
            var aeltest: u64 = 0
            var i: u64 = 1
            while i < n {
                if k_time[(i) as usize] < k_time[(aeltest) as usize] {
                    aeltest = i
                }
                i = i + 1
            }
            ulib.say((&s_gone[(0) as usize]) as u64)
            ulib.say(pf_at(aeltest))
            ulib.nl()
            let _r: bool = entfernen(bei, k_id[(aeltest) as usize])
        }
    }
}

fn hinein(path: u64) -> u64 {
    var slash: [u8; 2] = "/\0"
    var cwd: [u8; 256] = [0 as u8; 256]
    let abs: u64 = (&tmp2[(0) as usize]) as u64
    if *((path) as *mut u8) == 47 as u8 {
        ulib.strncpy(abs, path, 400)
    } else {
        let r: u64 = io.cwd((&cwd[(0) as usize]) as u64, 250)
        if ulib.bad(r) {
            ulib.strcpy(abs, (&slash[(0) as usize]) as u64)
        } else {
            ulib.strncpy(abs, (&cwd[(0) as usize]) as u64, 250)
        }
        if text.length(abs) > 0
            && *((abs + text.length(abs) - 1) as *mut u8) != 47 as u8 {
            ulib.strcat(abs, (&slash[(0) as usize]) as u64)
        }
        ulib.strcat(abs, path)
    }
    let trash: u64 = trash_from(abs)
    let _m: u64 = io.make_dir(trash)
    let id: u64 = next_id(trash)
    if id == 0 {
        return 0
    }
    let gr: u64 = io.size_of(abs)
    var target: [u8; 256] = [0 as u8; 256]
    together((&target[(0) as usize]) as u64, trash, id, false)
    var g: u64 = ulib.sys(ulib.SYS_RENAME, abs, (&target[(0) as usize]) as u64,
        0)
    if ulib.bad(g) {
        if ulib.is_dir(abs) {
            return 0
        }
        if !copy(abs, (&target[(0) as usize]) as u64) {
            return 0
        }
        let u: u64 = io.unlink(abs)
        if ulib.bad(u) {
            let _x: u64 = io.unlink((&target[(0) as usize]) as u64)
            return 0
        }
    }
    var info: [u8; 256] = [0 as u8; 256]
    together((&info[(0) as usize]) as u64, trash, id, true)
    var time: u64 = io.now_sec()
    if ulib.bad(time) {
        time = 0
    }
    if !info_write((&info[(0) as usize]) as u64, abs, time, gr) {
        let _z: u64 = ulib.sys(ulib.SYS_RENAME,
            (&target[(0) as usize]) as u64, abs, 0)
        return 0
    }
    aufraeumen(abs)
    return id
}

fn back(bei: u64, id: u64) -> u64 {
    let trash: u64 = trash_from(bei)
    var info: [u8; 256] = [0 as u8; 256]
    var source: [u8; 256] = [0 as u8; 256]
    together((&info[(0) as usize]) as u64, trash, id, true)
    together((&source[(0) as usize]) as u64, trash, id, false)
    nk = 0
    if !info_read((&info[(0) as usize]) as u64, 0) {
        return 1
    }
    let target: u64 = pf_at(0)
    if gibt_es(target) {
        return 2
    }
    let g: u64 = ulib.sys(ulib.SYS_RENAME, (&source[(0) as usize]) as u64,
        target, 0)
    if ulib.bad(g) {
        if !copy((&source[(0) as usize]) as u64, target) {
            return 3
        }
        let _u: u64 = io.unlink((&source[(0) as usize]) as u64)
    }
    let _i: u64 = io.unlink((&info[(0) as usize]) as u64)
    return 0
}

fn delete_recursive(path: u64, tiefe: u64) -> bool {
    if tiefe > 10 {
        return false
    }
    if !ulib.is_dir(path) {
        return !ulib.bad(io.unlink(path))
    }
    var runden: u64 = 0
    var gut: bool = true
    var empty: bool = false
    while !empty && runden < 4096 {
        runden = runden + 1
        var kind: [u8; 512] = [0 as u8; 512]
        var buf: [u8; 1024] = [0 as u8; 1024]
        var gefunden: bool = false
        let fd: u64 = io.dir_open(path)
        if ulib.bad(fd) {
            return false
        }
        var next: bool = true
        while next && !gefunden {
            let n: u64 = io.dir_read(fd, (&buf[(0) as usize]) as u64, 1024)
            if ulib.bad(n) || n == 0 {
                next = false
            } else {
                var at: u64 = 0
                while at < n && !gefunden {
                    let rec: u64 = (&buf[(0) as usize]) as u64 + at
                    let nm: u64 = io.dir_name(rec)
                    var is_point: bool = *((nm) as *mut u8) == 46 as u8
                        && (*((nm + 1) as *mut u8) == 0 as u8
                            || (*((nm + 1) as *mut u8) == 46 as u8
                                && *((nm + 2) as *mut u8) == 0 as u8))
                    if !is_point {
                        tools.join((&kind[(0) as usize]) as u64, path, nm)
                        gefunden = true
                    }
                    at = at + io.dir_reclen(rec)
                }
            }
        }
        io.close(fd)
        if !gefunden {
            empty = true
        } else if !delete_recursive((&kind[(0) as usize]) as u64,
            tiefe + 1) {
            gut = false
            empty = true
        }
    }
    if !ulib.bad(io.remove_dir(path)) {
        return gut
    }
    return false
}

fn entfernen(bei: u64, id: u64) -> bool {
    let trash: u64 = trash_from(bei)
    var info: [u8; 256] = [0 as u8; 256]
    var file: [u8; 256] = [0 as u8; 256]
    together((&info[(0) as usize]) as u64, trash, id, true)
    together((&file[(0) as usize]) as u64, trash, id, false)
    let a: bool = delete_recursive((&file[(0) as usize]) as u64, 0)
    let b: u64 = io.unlink((&info[(0) as usize]) as u64)
    return a && !ulib.bad(b)
}

fn clear(bei: u64) -> u64 {
    let n: u64 = load(bei)
    var gone: u64 = 0
    var i: u64 = 0
    while i < n {
        if entfernen(bei, k_id[(i) as usize]) {
            gone = gone + 1
        }
        i = i + 1
    }
    nk = 0
    ksumme = 0
    return gone
}

fn two(out: u64, at: u64, v: u64) -> u64 {
    __mmio_write8((out + at) as *mut u8, (48 + (v / 10) % 10) as u8)
    __mmio_write8((out + at + 1) as *mut u8, (48 + v % 10) as u8)
    return at + 2
}

fn time_text(sec: u64) -> u64 {
    let out: u64 = (&zbuf[(0) as usize]) as u64
    let days: u64 = sec / 86400
    let rest: u64 = sec % 86400
    let z: u64 = days + 719468
    let era: u64 = z / 146097
    let doe: u64 = z % 146097
    let yoe: u64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y: u64 = yoe + era * 400
    let doy: u64 = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp: u64 = (5 * doy + 2) / 153
    let d: u64 = doy - (153 * mp + 2) / 5 + 1
    var m: u64 = mp + 3
    var jahr: u64 = y
    if mp >= 10 {
        m = mp - 9
        jahr = y + 1
    }
    var at: u64 = 0
    __mmio_write8((out + 0) as *mut u8, (48 + (jahr / 1000) % 10) as u8)
    __mmio_write8((out + 1) as *mut u8, (48 + (jahr / 100) % 10) as u8)
    __mmio_write8((out + 2) as *mut u8, (48 + (jahr / 10) % 10) as u8)
    __mmio_write8((out + 3) as *mut u8, (48 + jahr % 10) as u8)
    at = 4
    __mmio_write8((out + at) as *mut u8, 45 as u8)
    at = two(out, at + 1, m)
    __mmio_write8((out + at) as *mut u8, 45 as u8)
    at = two(out, at + 1, d)
    __mmio_write8((out + at) as *mut u8, 32 as u8)
    at = two(out, at + 1, rest / 3600)
    __mmio_write8((out + at) as *mut u8, 58 as u8)
    at = two(out, at + 1, (rest / 60) % 60)
    __mmio_write8((out + at) as *mut u8, 0 as u8)
    return out
}
