profile kernel

import fuiscene

export { NRES, RES_GPU, KEY0, GRID_LINES, is_key, res_of_key, bind, set_state, name_of, tile_cb, paint_grid }

const NRES: u64 = 5
const RES_GPU: u64 = 4
const KEY0: u64 = 40
const GRID_LINES: u64 = 3
const NONE: u64 = 4294967295

static mut r_name: [u64; 5] = [0 as u64; 5]
static mut r_big: [u64; 5] = [0 as u64; 5]
static mut r_sub: [u64; 5] = [0 as u64; 5]
static mut r_hist: [u64; 5] = [0 as u64; 5]
static mut r_role: [u64; 5] = [0 as u64; 5]
static mut hist_n: u64 = 0
static mut chosen: u64 = 0

fn is_key(k: u64) -> bool {
    return k >= KEY0 && k < KEY0 + NRES
}

fn res_of_key(k: u64) -> u64 {
    if !is_key(k) {
        return NONE
    }
    return k - KEY0
}

fn bind(i: u64, name: u64, big: u64, sub: u64, hist: u64, role: u64) {
    if i >= NRES {
        return
    }
    r_name[(i) as usize] = name
    r_big[(i) as usize] = big
    r_sub[(i) as usize] = sub
    r_hist[(i) as usize] = hist
    r_role[(i) as usize] = role
}

fn name_of(i: u64) -> u64 {
    if i >= NRES {
        return 0
    }
    return r_name[(i) as usize]
}

fn set_state(n: u64, sel: u64) {
    hist_n = n
    chosen = sel
}

fn tile_cb(ud: u64, x: u64, y: u64, w: u64, h: u64, st: u64) {
    if ud >= NRES || w < 120 || h < 40 {
        return
    }
    let gw: u64 = 64
    let tw: u64 = w - gw - 36
    var soft: u64 = fuiscene.R_MUTED
    var strong: u64 = fuiscene.R_TEXT
    if (st & fuiscene.TS_ON) != 0 {
        soft = fuiscene.R_ONFILL
        strong = fuiscene.R_ONFILL
    }
    fuiscene.text_role(x + 14, y + 20, tw, r_name[(ud) as usize], 13, false, soft)
    fuiscene.text_role(x + 14, y + 42, tw, r_big[(ud) as usize], 17, true, strong)
    fuiscene.text_role(x + 14, y + h - 8, tw, r_sub[(ud) as usize], 11, false, soft)
    let gx: u64 = x + w - gw - 12
    let gy: u64 = y + 10
    let gh: u64 = h - 20
    fuiscene.cv_round(gx, gy, gw, gh, 4, fuiscene.R_FIELD)
    if r_hist[(ud) as usize] != 0 {
        fuiscene.cv_graph(gx, gy, gw, gh, r_hist[(ud) as usize], hist_n, r_role[(ud) as usize])
    }
    fuiscene.cv_ring(gx, gy, gw, gh, 4, fuiscene.R_BORDER)
}

fn paint_grid(gx: u64, gy: u64, gw: u64, gh: u64, range_label: u64, top_label: u64) {
    var i: u64 = 1
    while i <= GRID_LINES {
        fuiscene.cv_rect(gx + 1, gy + gh * i / (GRID_LINES + 1), gw - 2, 1, fuiscene.R_BORDER)
        i = i + 1
    }
    var v: u64 = 1
    while v < 6 {
        fuiscene.cv_rect(gx + gw * v / 6, gy + 1, 1, gh - 2, fuiscene.R_BORDER)
        v = v + 1
    }
    if top_label != 0 {
        fuiscene.text_role(gx + gw - 124, gy + 46, 112, top_label, 11, false, fuiscene.R_MUTED)
    }
    fuiscene.text_role(gx + 14, gy + gh - 8, 160, range_label, 11, false, fuiscene.R_MUTED)
}
