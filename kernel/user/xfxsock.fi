profile kernel

import ulib

export { listening }

const SYS_SOCKET: u64 = 41
const SYS_CONNECT: u64 = 42
const AF_UNIX: u64 = 1
const SOCK_STREAM: u64 = 1
const SUN_PATH_MAX: u64 = 100
const SUN_HEADER: u64 = 2

fn listening(path: u64) -> bool {
    var sa: [u8; 112] = [0 as u8; 112]
    sa[0 as usize] = AF_UNIX as u8
    var n: u64 = 0
    while n < SUN_PATH_MAX && *((path + n) as *mut u8) != 0 as u8 {
        sa[(SUN_HEADER + n) as usize] = *((path + n) as *mut u8)
        n = n + 1
    }
    let fd: u64 = ulib.sys(SYS_SOCKET, AF_UNIX, SOCK_STREAM, 0)
    if ulib.bad(fd) {
        return false
    }
    let r: u64 = ulib.sys(SYS_CONNECT, fd, (&sa[0 as usize]) as u64, SUN_HEADER + n + 1)
    ulib.sys(ulib.SYS_CLOSE, fd, 0, 0)
    return !ulib.bad(r)
}
